---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

// ⚠️ ดรอปนี้ (mtime 2026-10-09) มีสไลด์ที่ "ใช้ได้" แค่สองใบ และรอบนี้เปิดรูปอ่าน
// ป้ายบนภาพจริงซ้ำอีกครั้งแล้ว ห้ามเชื่อเลขไฟล์หรือคอมเมนต์ของรอบก่อน:
//   slide2.png — ป้ายโค้งเขียว "คืนยอดเสีย 0.3%" (ชายหนุ่มผมขาวเงิน โลโก้ซ้ายบน)
//   slide1.png — ป้ายโค้งเขียว "แนะนำเพื่อน โบนัส 0.8%" (หญิงสาวผมขาวเงิน)
//   slide3.png / slide4.png — โปสเตอร์ของ LOTTOPLUS (เว็บหวย) คนละแบรนด์กันเลย
//     ห้าม import กลับมาเด็ดขาด และห้ามลบไฟล์ทิ้งเพราะเป็นอินเวนทอรีของรอบถัดไป
// ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้วและ verify-build จะแดง
// (banner2 / banner3 ใน src/assets เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import ส่วน
// banner1 / banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักชื่อไว้เอง
// — ห้ามอ้างจากหน้านี้)
// ชื่อตัวแปรตั้งตามข้อความบนภาพ ไม่ใช่ตามเลขไฟล์ เพื่อไม่ให้รอบหน้าสลับผิดอีก
import promoCashback from "../assets/slide2.png";
import promoReferral from "../assets/slide1.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้น ๆ "หนึ่งย่อหน้า ประมาณสี่บรรทัด" คือ
// โควตาตัวหนังสือทั้งหมดของหน้านี้, กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อย
// และห้ามเพิ่มย่อหน้า เพราะตัวโปสเตอร์ระบุเปอร์เซ็นต์โบนัสไว้ด้วยตัวอักษรขนาดใหญ่
// อยู่แล้ว การพิมพ์ซ้ำด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ เป้าหมาย h1x1 h2x0 h3x0
//
// สไลด์รอบนี้เป็น **600x600 ทั้งคู่** (วัดจากไฟล์จริงรอบนี้ด้วย sharp ไม่ใช่ลอกค่า
// ข้ามรอบ — คอมเมนต์ของรอบก่อนเขียนไว้ว่า 600x533 ซึ่งเป็นขนาดของดรอปก่อนหน้า)
// วางเป็นกริดสองคอลัมน์ คุมความกว้างรวมที่ max-w-4xl (896px) ทำให้ช่องละ ~436px
// ไม่ต้องอัปสเกลเกินขนาดไฟล์ต้นทาง widths หยุดที่ 600 ตามความกว้างจริงของไฟล์
// และคุมภาพต่อใบไว้ที่ max-w-[600px] สองใบพอดีหนึ่งแถว
// เรียง คืนยอดเสีย 0.3% ก่อน แนะนำเพื่อน 0.8% ตามลำดับของบรีฟ (docx H3 #4 แล้ว #5)
// ซึ่งรอบนี้แปลว่า slide2 มาก่อน slide1
// sizes คิดจากความกว้างที่ถูกวาดจริง: px-4 ของ section (16px/ข้าง) + p-8 ของการ์ด
// (32px/ข้าง, เป็น p-10 = 40px ที่ md ขึ้นไป) + gap-6 (24px) ระหว่างสองคอลัมน์
// LCP คือ hero ใน MainLayout ไม่ใช่สองรูปนี้ จึง loading="lazy" fetchpriority="low"
//
// Announcement รอบนี้หมุนมาเป็น AnnouncementPremium ทั้งเว็บ (แบรนด์ก่อน แตกดี168
// ใช้ Announcement3) — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ
// แบรนด์นี้แล้ว และทุกหน้าก็เรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop message
// มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกันระหว่างหน้า
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **มรกตเข้ม x ทอง บนเขียวเกือบดำ** —
// bg.json เป็น {"mode":"color","color":"#061801"} ทองแบรนด์ #cc920a ถือขอบ ออรา
// และเงา · ทองสว่าง #f7d14e เป็นไฮไลต์ <strong> และปลายสว่างของไล่เฉด · ทองซีด
// #fde9a6 เป็นปลายสว่างสุด · ทองเข้ม #8a6204 เป็นปลายเข้มและเส้นคั่น · เขียวมรกต
// #0a6b32 กับเขียวสว่าง #2fbf6a เป็นฮิวที่สองจริง (โลโก้เป็นคู่ทอง-มรกต) ·
// หมึกบนพื้นสว่าง #07170c เท่านั้น (11.8:1 บน #f7d14e) · เนื้อความ #e8f2e6 มาจาก
// BRAND_TEXT ที่ <html> และการ์ด ContentBox ตั้งให้แล้ว จึงไม่ระบุสีที่ย่อหน้า
// ⚠️ ห้ามพลิกปุ่มพื้นทองให้เป็นหมึกขาว (เหลือ ~1.3:1 อ่านไม่ออก)
// ชุดฟ้าสด-เหลืองมะนาวของ แตกดี168 ออกครบแล้ว ทั้งคลาส Tailwind raw hex และ
// rgba() (ค่าเดิมอยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีแบรนด์
// เก่าเจอ false positive) ห้ามนำกลับมา
//
// แบรนด์นี้เป็น **เว็บพนันฐานเล่นหลักที่รวมช่องทางเข้าเล่นออนไลน์ไว้ในระบบเดียว**
// ไม่ใช่เว็บสล็อตเฉพาะทาง ไม่ใช่เว็บหวย และไม่ใช่คาสิโนรวมหมวด — คำขายของของ
// แบรนด์ก่อนและศัพท์หมวดอื่นที่บรีฟไม่ได้เอ่ยห้ามหลงเหลือ (รายการเต็มอยู่ใน
// brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep เจอ false positive)
// ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% / 0.8% / 24 ชั่วโมง / 3 ขั้นตอน / 100%
// ห้ามแต่งยอดฝากขั้นต่ำ ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP เลขใบอนุญาต หรือวันหมดเขต
// และต้องคงคำกำกับของบรีฟไว้ว่า "ไม่ใช่ทุกการเดิมพันจะได้รับโบนัสโดยอัตโนมัติ"
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) หน้านี้ยาว 156 อักขระ
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `รวมภาพโปรโมชั่นของ ${BRAND_NAME} ทั้งคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% คำนวณจากยอดที่เข้าเกณฑ์ ควรเข้าสู่ระบบตรวจรอบตัดยอดและเงื่อนไขของแต่ละรายการก่อนรับสิทธิ์`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่น ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});

// ความกว้างที่ถูกวาดจริงของแต่ละช่องในกริดสองคอลัมน์ (ดูคอมเมนต์ sizes ด้านบน)
const promoSizes = "(max-width: 639px) calc(100vw - 96px), (max-width: 767px) calc((100vw - 120px) / 2), (max-width: 1007px) calc((100vw - 136px) / 2), 436px";
const promoClass =
  "mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#cc920a]/35 object-contain shadow-[0_0_28px_rgba(204,146,10,0.30)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#cc920a]/80 hover:shadow-[0_0_40px_rgba(247,209,78,0.45)]";
---

<MainLayout title={`โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% สำหรับยอดที่เข้าเกณฑ์`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`โปรโมชั่น ${BRAND_NAME} ทั้งหมด`} as="h1">
    <div class="flex flex-col gap-10">
      <p class="text-left text-base leading-relaxed">
        หน้านี้รวมภาพโปรโมชั่นที่ <strong class="text-[#f7d14e]">{BRAND_NAME}</strong> เปิดให้สมาชิกตรวจสอบสิทธิ์ตามรายการที่เปิดให้บริการในแต่ละช่วง ทั้งคืนยอดเสียและแนะนำเพื่อน โดยรายละเอียดของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว
        ระบบจะนำยอดที่เข้าเกณฑ์มาคำนวณตามรอบก่อนแสดงจำนวนโบนัสที่รับได้ <strong class="text-[#f7d14e]">
          ไม่ใช่ทุกการเดิมพันจะได้รับโบนัสโดยอัตโนมัติ เพราะแต่ละโปรโมชั่นมีเงื่อนไข รอบตัดยอด และประเภทเกมที่ร่วมรายการแตกต่างกัน
        </strong> จึงควรเข้าสู่ระบบอ่านเงื่อนไขก่อนกดรับสิทธิ์ทุกครั้ง
      </p>

      <div class="mx-auto grid w-full max-w-4xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt={`ภาพโปรโมชั่นของ ${BRAND_NAME} พื้นหลังม่านเขียวมรกตเข้มมีเสาทองและริบบิ้นทองพลิ้วเป็นเส้นโค้ง มุมซ้ายบนเป็นโลโก้ ${BRAND_NAME} ตัวอักษร KOON สีเงินโครเมียมคู่กับเลข 234 สีทองในวงแหวนเขียว-ทอง กลางภาพเป็นชายหนุ่มผมสั้นสีขาวเงินยื่นฝ่ามือขวาออกมาทางผู้ชม สวมสูทขาวทับเชิ้ตเขียวมรกตติดเข็มกลัดทอง ด้านล่างเป็นคำว่า โปรโมชั่น ตัวอักษรสามมิติสีทอง และป้ายโค้งเขียวเข้มคาดข้อความ คืนยอดเสีย 0.3%`}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoReferral}
          alt={`ภาพโปรโมชั่นของ ${BRAND_NAME} ฉากม่านเขียวมรกตเข้มชุดเดียวกัน มีริบบิ้นทองพลิ้วและแสงประกายทอง มุมซ้ายบนเป็นโลโก้ ${BRAND_NAME} ในวงแหวนเขียว-ทอง กลางภาพเป็นหญิงสาวผมสั้นสีขาวเงินเท้าคางบนมือ สวมสูทขาวทับชุดเขียวมรกตปักทอง ใส่สร้อยคอและต่างหูพลอยเขียว ด้านล่างเป็นคำว่า โปรโมชั่น ตัวอักษรสามมิติสีทอง และป้ายโค้งเขียวเข้มคาดข้อความ แนะนำเพื่อน โบนัส 0.8%`}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#8a6204] bg-gradient-to-b from-[#fde9a6] via-[#f7d14e] via-55% to-[#cc920a] px-10 py-3.5 text-lg font-black text-[#07170c] shadow-[0_0_14px_rgba(204,146,10,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
