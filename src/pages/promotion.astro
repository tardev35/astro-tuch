---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";

import { Picture } from "astro:assets";

// Only slide1/slide2 belong to DARK168 (drop 2026-08-14), and they are exactly
// the two promotions this page shows: slide1 is the "แนะนำเพื่อน รับโบนัส 0.8%"
// poster, slide2 is the "คืนยอดเสีย รับโบนัส 0.3%" poster.
// slide3/slide4 are still on disk but belong to a previous client (PIGAUTO,
// red/gold lottery art) — they may not be imported here, now or on any future
// rebrand.
import promoCashback from "../assets/slide2.png";
import promoReferral from "../assets/slide1.png";
import { pageGraph } from "../lib/schema";

// This is an IMAGE page: the ContentBox title, ONE short intro paragraph, the
// poster grid, one CTA. No section headings, no extra prose — the posters
// already state every offer in large type.
//
// 150–160 CHARACTERS (not bytes — a byte count reads ~3x too long for Thai).
const pageDescription =
  "รวมโปรโมชั่น DARK168 เว็บดาร์คสล็อตเจ้าของเกมแท้ ทั้งแนะนำเพื่อนรับโบนัส 0.8% และคืนยอดเสียทุกวัน 0.3% ตรวจเงื่อนไขแต่ละรายการก่อนกดรับสิทธิ์ ฝากถอนอัตโนมัติ";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น DARK168 แนะนำเพื่อน 0.8% คืนยอดเสียทุกวัน 0.3%",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});
---

<MainLayout title="โปรโมชั่น DARK168 เว็บดาร์คสล็อต แนะนำเพื่อน 0.8% คืนยอดเสีย 0.3%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น DARK168" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#ece3d1]">
        หน้านี้รวมโปรโมชั่นที่ DARK168 เว็บดาร์คสล็อตเจ้าของเกมแท้ เปิดรับอยู่ในขณะนี้ ทั้งแนะนำเพื่อนรับโบนัส 0.8% และคืนยอดเสียทุกวัน 0.3%
        อัตราโบนัส ยอดที่นำมาคำนวณ และรอบเวลาการรับสิทธิ์ระบุไว้บนภาพโปรโมชั่นแต่ละใบ และเงื่อนไขของแต่ละรายการไม่เหมือนกัน
        สมาชิกตรวจสอบยอดสะสมและกดรับสิทธิ์ได้จากบัญชีสมาชิก หรือสอบถามแอดมินที่ดูแลตลอด 24 ชั่วโมง
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่นพื้นหลังสีดำ มุมซ้ายบนเป็นโลโก้ DARK168 ตัวอักษร DARK สีทองและเลข 168 สีเงิน ถัดลงมาเป็นข้อความสีทอง โปรโมชั่น คืนยอดเสีย รับโบนัส พร้อมตัวเลข 0.3% ขนาดใหญ่ ด้านขวาเป็นหญิงสาวสวมชุดราตรีสีเงินตัดทอง ฉากหลังมีลำแสงเรขาคณิตสีทองพาดทแยง"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#8a6320]/55 object-contain shadow-[0_10px_30px_rgba(230,183,78,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f6dfa4]/70 hover:shadow-[0_15px_40px_rgba(200,207,216,0.28)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่นพื้นหลังสีดำ มุมซ้ายบนเป็นโลโก้ DARK168 ตัวอักษร DARK สีทองและเลข 168 สีเงิน ถัดลงมาเป็นข้อความสีทอง โปรโมชั่น แนะนำเพื่อน รับโบนัส พร้อมตัวเลข 0.8% ขนาดใหญ่ ด้านขวาเป็นหญิงสาวสวมชุดราตรีสีทองตัดเงิน รอบตัวมีลูกเต๋าและเหรียญทอง แถบด้านล่างเขียนว่า ชวนเพื่อนเลย รับโบนัสไม่อั้น พร้อมสามไอคอน มั่นคง ปลอดภัย เชื่อถือได้ 100% ชวนง่าย ได้จริง รับโบนัสทันที และ ไม่จำกัดยอดเพื่อน ยิ่งชวน ยิ่งได้"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#8a6320]/55 object-contain shadow-[0_10px_30px_rgba(230,183,78,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f6dfa4]/70 hover:shadow-[0_15px_40px_rgba(200,207,216,0.28)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#f6dfa4]/70 bg-gradient-to-r from-[#f6dfa4] via-[#e6b74e] to-[#8a6320] px-10 py-3.5 text-lg font-black text-[#050505] shadow-[0_0_15px_rgba(230,183,78,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก DARK168
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
