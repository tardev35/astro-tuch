---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";

import { Picture } from "astro:assets";

// ดรอปรอบนี้ (2026-10-22, .claude/brand-spec-ngernthong168.md §1) มีสไลด์ที่ใช้ได้
// **สองใบ** และชื่อตัวแปรตั้งตามข้อความที่พิมพ์อยู่บนภาพจริง (เปิดบิตแมปอ่านเอง
// แล้วรอบนี้) ไม่ใช่ตามเลขไฟล์ — ถ้ารอบหน้าเจอความขัดแย้ง **ให้เชื่อข้อความบนรูป**:
//   slide2.png (mtime 10-22) — โปสเตอร์ "โปรโมชั่น / คืนยอดเสีย 0.3%"
//   slide1.png (mtime 10-22) — โปสเตอร์ "โปรโมชั่น / แนะนำเพื่อน 0.8%"
//   slide3.png / slide4.png (mtime 2026-09-29) — โปสเตอร์ของแบรนด์คนละราย
//     **ห้าม import** (ถอดออกไปหลายรอบแล้ว อย่าดึงกลับ)
// ⚠️ การจับคู่พลิกไปมาระหว่างดรอป เพราะ uploader เขียนทับ slide1/slide2 ทุกครั้ง
// เลขไฟล์จึงไม่มีความหมายข้ามแบรนด์ ต้องเปิดบิตแมปดูทุกรอบ
// ⚠️ eager import = emit ลง dist/ ต่อให้ไม่ได้ render และ verify-build จะแดง
// การ import ไฟล์เก่าคือการส่งรูปของลูกค้ารายอื่นขึ้นเว็บนี้
// **ห้ามลบไฟล์เก่าทิ้ง** — เป็นอินเวนทอรีของรอบถัดไป แค่ห้าม import
// (banner2 mtime 10-08 / banner3 mtime 09-27 ก็เช่นกัน ส่วน banner1 /
// banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักชื่อไว้เอง —
// ห้ามอ้างจากหน้านี้) รอบนี้จึงไม่มี article illustration
import promoCashback from "../assets/slide2.png";
import promoReferral from "../assets/slide1.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้นๆ ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมด
// ของหน้านี้, กริดภาพโปรโมชั่น, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อยและห้ามเพิ่มย่อหน้า
// เพราะโปสเตอร์ระบุเปอร์เซ็นต์ของตัวเองด้วยตัวอักษรขนาดใหญ่อยู่แล้ว การพิมพ์ซ้ำ
// ด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ บรีฟรอบนี้ (src/assets/content.txt)
// ไม่มีส่วน SUB-PAGES เลย ย่อหน้าทุกย่อหน้าที่เคยอยู่บนหน้านี้จึงเป็นของที่รีแบรนด์
// รอบก่อนๆ แต่งขึ้นเอง — รอบนี้คงไว้เพียงย่อหน้าเกริ่นเดียว และเขียนขึ้นใหม่จากบรีฟ
// (content.txt บรรทัด 7-12) ไม่ใช่ find-and-replace ทับประโยคของรอบก่อน
//
// ลำดับในกริดตามลำดับของบรีฟ: คืนยอดเสีย 0.3% (บรรทัด 9-10) มาก่อน
// แนะนำเพื่อน 0.8% (บรรทัด 11-12) → promoCashback (slide2) อยู่ช่องแรก
// ⚠️⚠️ **บิตแมปจริงของดรอปนี้คือ 600x480 แนวนอน** — วัดจากเฮดเดอร์ PNG เอง
// (brand-spec §1 เขียนไว้ว่า 540x600 แนวตั้ง ซึ่ง **ไม่ตรงกับไฟล์จริง** รายงาน
// ให้ orchestrator แล้ว) ความกว้างสูงสุดคือ 600 widths จึงหยุดที่ 600 และคุมที่
// max-w-[600px] **ให้วัดใหม่ทุกรอบจากไฟล์จริง อย่าเชื่อสัดส่วนของรอบก่อนและ
// อย่าเชื่อสเปกถ้ามันขัดกับบิตแมป**
// sizes คิดจากความกว้างที่ถูกวาดจริง: section px-4 (16px/ข้าง) + การ์ด p-8
// (32px/ข้าง, เป็น p-10 = 40px ที่ md ขึ้นไป) + gap-6 ระหว่างคอลัมน์ (24px)
//   ใต้ 640px = คอลัมน์เดียว → 100vw-96px
//   640-767px = สองคอลัมน์ p-8 → 50vw-60px
//   768-1335px = สองคอลัมน์ p-10 → 50vw-68px
//   ตั้งแต่ 1336px ขึ้นไปชนเพดาน 600px (การ์ดเองกว้างสุด 1400px จึงยังไม่ชน
//   เพดานของการ์ดก่อน)
// LCP คือ hero ใน MainLayout ไม่ใช่รูปพวกนี้ จึง loading="lazy" fetchpriority="low"
// decoding="async" และ quality ตัวเดียวทั้ง avif/webp — ห้ามจูนแยกฟอร์แมต
// (tools/avif-quality-service.mjs ย่อฝั่ง avif ให้เองที่ x0.65)
//
// quality={64} ไม่ใช่ 80 ตามปกติ: สไลด์ทั้งสองเป็นฉากห้องนิรภัยที่มีรายละเอียดจัด
// (ทองคำแท่งซ้อนชั้น กองเหรียญทอง ปึกธนบัตร ประตูเซฟวงกลมทองเหลืองมีไฮไลต์วาว
// โคมระย้าทอง ผ้าซาตินและเครื่องประดับทองที่สะท้อนแสง และตัวอักษรสามมิติที่มีขอบ
// มันเงา) ซึ่งเป็นเคสที่ AVIF ทำได้แย่ที่สุด ที่ quality=80 ไฟล์ AVIF มีโอกาสออกมา
// **ใหญ่กว่า** WebP ที่เป็น fallback ของตัวเอง เบราว์เซอร์ที่รองรับ AVIF จะหยิบไฟล์
// ที่หนักกว่าไปใช้ และ verify-build.mjs ทำให้ build แดงด้วยเหตุนี้ตรงๆ ·
// ทางแก้คือ quality ที่ **ต่ำลง** ไม่ใช่สูงขึ้น · ค่าเดียวกันนี้ต้องใช้ที่
// index.astro กับสไลด์คู่เดียวกัน
//
// Announcement รอบนี้หมุนมาเป็น Announcement2 ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ AnnouncementPremium จึงหมุนออก) orchestrator ตั้ง default
// message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว และทุกหน้าเรียกแบบ bare
// เหมือนกัน จึงห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกันระหว่างหน้า
//
// 🚨 พาเลตรอบนี้ (brand-spec-ngernthong168.md §2) ยังเป็นธีมมืดเหมือนรอบก่อน
// **แต่คนละค่า** bg.json ของดรอปนี้คือ {"mode":"color","color":"#29210f"}
// = น้ำตาลโอลีฟเข้ม **ห้าม "แก้" กลับไปเป็นพื้นสว่าง**
// ลำดับผิว: ผิวการ์ด #3d3016 (ContentBox) / ชั้นกลาง #332810 / อินเซ็ต #201906 /
// พื้นเพจ #29210f
// หมึกครีมอุ่น #ecd5c4 = เนื้อความ (= BRAND_TEXT ที่ <html> และการ์ด ContentBox
// ตั้งให้แล้ว ย่อหน้าจึงไม่ประกาศสีของตัวเอง 9.9:1 บนผิวการ์ด) ·
// ทองสว่าง #fcee52 = สีของ <strong> ในเนื้อความ (10.7:1) และของหัวข้อ
// ทองลึก #b37c0b = ขอบรูป · ทองแกน #f5ba14 = ขอบ hover / ออรา
// ⚠️⚠️ **#b37c0b ห้ามถือตัวอักษรบนพื้นมืด** (2.0:1) เป็นพื้นถม/ขอบ/ออราเท่านั้น
// ปุ่ม CTA ของหน้านี้เป็น **PRIMARY = ไล่เฉดทอง** #fcee52 → #f5ba14 → #b37c0b
// บนหมึกเข้ม **#201906** (14.5 / 9.9 / 4.8:1 — หมึกเข้มบนพื้นถมทอง)
// **ห้ามสลับเป็นตัวอักษรขาวบนพื้นทอง** ตรงกับปุ่มสมัครสมาชิกที่ /contact-us
// /ทางเข้า /register
// rgba() ที่อนุญาตรอบนี้: rgba(245,186,20,α) · rgba(252,238,82,α) ·
// rgba(236,213,196,α) · rgba(32,25,6,α) · rgba(0,0,0,α)
// ⚠️⚠️ **วัสดุที่สองของรอบนี้คือครีมอุ่น #ecd5c4 ไม่ใช่เทาเงิน** — แรมป์เทาเงิน
// เป็นของแบรนด์ขาออก ห้ามใส่กลับเข้ามาในไฟล์นี้
// · <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ
// ถ้าเปิด/ปิดกลางคำ บรรทัดจะตัดกลางคำ และ <strong> สองตัวห้ามติดกัน
// ⚠️ กับดักรอบนี้คือ **ทองนำสองรอบติดกัน** การเจอ "ทอง" ในไฟล์นี้จึงไม่พิสูจน์
// อะไรเลย ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน brand-spec §2
// (ค่าของแบรนด์เก่าไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive
// ในคอมเมนต์ของไฟล์นี้เอง) รอบนี้ **ไม่มีฟ้า ไม่มีน้ำเงิน ไม่มีแดง ไม่มีเขียว
// ไม่มีชมพู ไม่มีม่วง ไม่มีส้ม ไม่มีโรสโกลด์ และไม่มีแรมป์เทาเงิน**
//
// ⚠️ แกนของแบรนด์รอบนี้คือ **เว็บสล็อตออนไลน์ สล็อตเงินดี อัตราจ่ายสูง ค่ายเกม
// ลิขสิทธิ์แท้100%** **ไม่ใช่แกนของรอบก่อน และไม่ใช่เว็บลอตเตอรี**
// รายการคำที่ห้ามใช้อยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่
// สองหน้าหมวดลอตเตอรี **ยังปิดอยู่รอบนี้** (อยู่ใน src/pages-disabled/)
// ห้ามลิงก์ไปสองเส้นทางนั้นจากหน้านี้ — route ไม่มีอยู่จริง build จะแดง
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 1,000 เกม · 0.3% · 0.8% · 24ชม. ·
// 3 ขั้นตอน · 100% ห้ามแต่งยอดฝากขั้นต่ำ ชื่อธนาคาร ชื่อค่ายเกม ค่า RTP
// เลขใบอนุญาต ปีก่อตั้ง หรือจำนวนสมาชิก และต้องคงประโยคกำกับของบรีฟไว้ว่า
// **ก่อนเข้าร่วมควรอ่านประกาศล่าสุดให้ครบถ้วน**
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) หน้านี้ยาว 157 อักขระด้วยชื่อแบรนด์ 10 ตัวของรอบนี้
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `โปรโมชั่น ${BRAND_NAME} รวมภาพประกาศสิทธิ์สมาชิกไว้ในหน้าเดียว คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% แต่ละรายการมีเงื่อนไขต่างกัน ควรอ่านประกาศล่าสุดก่อนรับสิทธิ์`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่น ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});

// ความกว้างที่ถูกวาดจริงของแต่ละคอลัมน์ในกริดสองคอลัมน์ (ดูคอมเมนต์ sizes ด้านบน)
const promoSizes = "(max-width: 639px) calc(100vw - 96px), (max-width: 767px) calc(50vw - 60px), (max-width: 1335px) calc(50vw - 68px), 600px";

const promoClass =
  "mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#b37c0b] object-contain shadow-[0_0_28px_rgba(245,186,20,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f5ba14] hover:shadow-[0_0_40px_rgba(245,186,20,0.32)]";

// alt ทั้งสองเขียนจากบิตแมปของดรอปนี้ที่เปิดอ่านเองแล้ว (**600x480 แนวนอน** ทั้งคู่) —
// ฉากห้องนิรภัยทองคำ ประตูเซฟวงกลมทองเหลือง ชั้นวางทองคำแท่ง โคมระย้าทอง
// รูปปั้นเสือดำฝั่งขวา ผู้หญิงสูงวัยผมหยิกสีขาว สวมแว่นกันแดดดำ ลิปสติกแดง
// ในชุดสูทซาตินสีงาช้าง สวมเครื่องประดับทองเต็มตัว บนโซฟาหนังสีเข้ม
// และตัวอักษรสามมิติสีทองว่า โปรโมชั่น ใต้มงกุฎทองในกรอบช่อใบลอเรล
// ⚠️ องค์ประกอบของอาร์ตเวิร์กแบรนด์ก่อนๆ ที่ต้องไม่หลงเหลือใน alt อยู่ครบใน
// brand-spec §1 (ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive)
// ⚠️ alt คือ "ข้อความที่พิมพ์อยู่บนโปสเตอร์" เป็นหลัก — ตัวเลขท้าย alt ต้องตรงกับรูป
// ⚠️ ห้ามเรียกรูปคู่นี้ว่าภาพแนวตั้งหรือภาพสี่เหลี่ยมจัตุรัส รอบนี้เป็น **แนวนอน**
// ⚠️ สีของวัตถุในรูป (ลิปสติกแดง ผ้าซาตินสีงาช้าง ขนเสือดำสีดำ สีผิวและสีผม
// นักแสดง) เป็นวัตถุในภาพ ไม่ใช่สีของแบรนด์ และไม่เข้ามาใน UI
const altCashback = `โปสเตอร์โปรโมชั่นแนวนอน ฉากห้องนิรภัยทองคำ มุมขวาบนเป็นโลโก้ตราชั่งทองของ ${BRAND_NAME} ฉากหลังเป็นประตูเซฟวงกลมทองเหลือง ชั้นวางทองคำแท่งและกองเหรียญทอง มีรูปปั้นเสือดำอยู่ริมขวา ฝั่งซ้ายเป็นผู้หญิงสูงวัยผมหยิกสีขาว สวมแว่นกันแดดดำและลิปสติกแดง ในชุดสูทซาตินสีงาช้างทับเสื้อลูกไม้ดำ สวมสร้อยคอทอง ต่างหูทอง นาฬิกาและกำไลทองหลายวง นั่งเอนบนโซฟาหนังสีเข้มพร้อมคลี่ปึกธนบัตรไว้ในมือ ครึ่งขวาล่างเป็นตัวอักษรไทยสามมิติสีทองอ่านว่า โปรโมชั่น มีมงกุฎทองวางด้านบนและช่อใบลอเรลขนาบข้าง ใต้ลงมาเป็นป้ายดำขอบทองเขียนว่า คืนยอดเสีย ต่อด้วยตัวเลข 0.3% ตัวโต`;

const altReferral = `โปสเตอร์โปรโมชั่นแนวนอน ฉากห้องนิรภัยทองคำ มุมขวาบนเป็นโลโก้ตราชั่งทองของ ${BRAND_NAME} ฉากหลังเป็นประตูเซฟวงกลมทองเหลือง ชั้นวางทองคำแท่ง โคมระย้าทองและปึกธนบัตรวางซ้อนกัน มีรูปปั้นเสือดำอยู่ริมขวา ฝั่งซ้ายเป็นผู้หญิงสูงวัยผมหยิกสีขาว สวมแว่นกันแดดดำและลิปสติกแดง ในชุดสูทซาตินสีงาช้างทับเสื้อสีทอง สวมสร้อยคอทอง ต่างหูทอง กำไลและแหวนทองหลายวง ยืนเอียงตัวพร้อมยกแก้วแชมเปญไว้ในมือซ้าย ครึ่งขวาล่างเป็นตัวอักษรไทยสามมิติสีทองอ่านว่า โปรโมชั่น มีมงกุฎทองวางด้านบนและช่อใบลอเรลขนาบข้าง ใต้ลงมาเป็นป้ายดำขอบทองเขียนว่า แนะนำเพื่อน ต่อด้วยตัวเลข 0.8% ตัวโต`;
---

<MainLayout title={`โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน โบนัส 0.8%`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`รวมโปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} as="h1">
    <div class="flex flex-col gap-10">
      <p>
        หน้านี้รวมภาพประกาศโปรโมชั่นสำหรับสมาชิกของ {BRAND_NAME} ไว้ในที่เดียว ทั้ง
        <strong class="text-[#fcee52]">รายการคืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน และโบนัสแนะนำเพื่อน 0.8% กดรับได้ไม่จำกัด</strong>
        โดยอัตราและชื่อรายการระบุไว้บนภาพด้านล่างแล้ว แต่ละรายการอาจมีเงื่อนไขเรื่องประเภทเกมที่เข้าร่วม ยอดที่นำมาคำนวณ และรอบเวลารับเครดิตแตกต่างกัน
        <strong class="text-[#fcee52]">ก่อนเข้าร่วมควรอ่านประกาศล่าสุดให้ครบถ้วน รวมถึงตรวจสอบจำนวนครั้งที่รับสิทธิ์ได้จริงและเงื่อนไขการถอนเงิน</strong>
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt={altCashback}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />

        <Picture
          src={promoReferral}
          alt={altReferral}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="relative isolate flex items-center justify-center overflow-hidden rounded-lg border border-[#b37c0b] bg-gradient-to-b from-[#fcee52] via-[#f5ba14] to-[#b37c0b] px-10 py-3.5 text-lg font-black text-[#201906] shadow-[0_0_14px_rgba(245,186,20,0.4)] transition-transform hover:scale-105">
          <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#fcee52]/70 to-transparent"></span>
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
