---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

// ดรอปอาร์ตเวิร์กของ 1SS365 คือ 2026-10-03 และมีโปสเตอร์ที่ใช้ได้แค่สองใบ
// (brand-spec §Images in this drop) — เปิดไฟล์จริงดูแล้วทั้งคู่ และป้ายบนภาพ "สลับข้าง"
// กับรอบก่อน (ห้ามเดาจากชื่อไฟล์ และห้ามเชื่อคอมเมนต์ของรอบก่อน ต้องเปิดดูทุกครั้ง):
//   slide1.png — 600x400 ป้ายดำใต้คำว่า โปรโมชั่น อ่านว่า "แนะนำเพื่อน โบนัส 0.8%"
//   slide2.png — 600x400 ป้ายดำใต้คำว่า โปรโมชั่น อ่านว่า "คืนยอดเสีย โบนัส 0.3%"
//   slide3.png / slide4.png — โปสเตอร์ของแบรนด์ก่อน (29 ก.ย. เก่ากว่าดรอปนี้)
//     ห้าม import กลับมาเด็ดขาด และห้ามลบไฟล์ทิ้งเพราะเป็นอินเวนทอรีของรอบถัดไป
// ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้วและ verify-build จะแดง
// (banner2/banner3 ใน src/assets ก็เก่ากว่าดรอปนี้ = อาร์ตเวิร์กแบรนด์ก่อน ห้าม import)
// ส่วน banner1 / banner1-mobile / og.png เป็นของ MainLayout ห้าม import จากหน้านี้
// ชื่อตัวแปรตั้งตามข้อความบนภาพ ไม่ใช่ตามเลขไฟล์ เพื่อไม่ให้รอบหน้าสลับผิดอีก
import promoCashback from "../assets/slide2.png";
import promoReferral from "../assets/slide1.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้น ๆ "หนึ่งย่อหน้า ประมาณสี่บรรทัด" คือ
// โควตาตัวหนังสือทั้งหมดของหน้านี้, กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อย
// และห้ามเพิ่มย่อหน้า เพราะตัวโปสเตอร์ระบุชื่อโปรและเปอร์เซ็นต์ไว้ด้วยตัวอักษรขนาดใหญ่
// อยู่แล้ว การพิมพ์ซ้ำด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ เป้าหมาย h1x1 h2x0 h3x0
//
// สไลด์รอบนี้เป็น 600x400 จึงวางเป็นกริดสองคอลัมน์คุมความกว้างรวมที่ max-w-4xl
// (896px) ทำให้ช่องละ ~436px ไม่ต้องอัปสเกลเกินขนาดไฟล์ต้นทาง widths หยุดที่ 600 ตาม
// ความกว้างจริงของไฟล์ และคุมภาพต่อใบไว้ที่ max-w-[600px] สองใบพอดีหนึ่งแถว กริดจึง
// จัดกลางสมมาตรโดยไม่ต้องมีใบที่ span สองคอลัมน์ · เรียงคืนยอดเสีย 0.3% ก่อนแนะนำเพื่อน
// 0.8% ตามลำดับของบรีฟ (docx H3 #4 แล้วค่อย #5)
//
// Announcement หมุนมาเป็น AnnouncementPremium ทั้งเว็บรอบนี้ (รอบก่อน หวย365 ใช้
// AnnouncementHuay) — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ
// 1SS365 แล้ว และทุกหน้าก็เรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop message มิฉะนั้น
// ตัววิ่งจะพูดคนละเรื่องกันระหว่างหน้าแรกกับหน้านี้
//
// พาเลตต์ 1SS365 (brand-spec §New palette) ทอง-เงินโครเมียม-ดำ: ทองแบรนด์ #edbb23
// (สีตัวตน ขอบ จุดเน้น) · ทองสว่าง #f7d458 (hover กลางไล่เฉด) · ทองอ่อน #ffeeb4
// (ต้นไล่เฉด หมึกเน้นใน strong) · ทองลึก #a87708 (ขอบจาง ปลายไล่เฉด) · เงินโครเมียม
// #c8cbce (ฮิวที่สองจากตัวอักษร 1SS บนโลโก้) · พื้นลึก #050505 · พื้นการ์ด #121010 ·
// พื้นอุ่น #1a1710 · เนื้อความ #f0e6d2 (BRAND_TEXT มาจาก <html> และการ์ด ContentBox
// ตั้งให้แล้ว จึงไม่ต้องระบุสีที่ย่อหน้า)
// กฎคอนทราสต์: ไล่เฉดปุ่มทองจบที่ #a87708 เท่านั้น และหมึกบนพื้นทองเป็นดำ #050505
// ชุดแดง-ทองของ หวย365 (#dc0203 #f5282a #8c0402 #ffc93c #ffeab0 #c08a07 #240406
// #3a0a0c #1a0303 #f6e7e0 rgba(255,201,60,*) rgba(8,1,1,*)) ถูกแทนครบทุกจุดแล้ว
// ทั้งคลาส Tailwind raw hex และ rgba()
//
// 1SS365 เป็นเว็บ "สล็อตออนไลน์ เว็บตรงต่างประเทศ" ไม่ใช่หวยและไม่ใช่กีฬา — คำว่า
// หวย แทงหวย ส่งโพย โพย เลือกเลข 2 ตัว 3 ตัว อัตราจ่าย งวด รัฐบาลไทย ฮานอย ลาวพัฒนา
// หวยหุ้น ตรวจหวย แนวทาง ห้ามปรากฏบนหน้านี้ และห้ามลิงก์ไป /ตรวจหวย หรือ /แนวทาง
// เพราะรอบนี้สองหน้านั้นถูกย้ายไป src/pages-disabled/ แล้ว (เราต์ตายและ build แดง)
// ตัวเลขที่บรีฟระบุและใช้ได้มีแค่ คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · 3 ขั้นตอน ·
// 24 ชั่วโมง · 100% ห้ามเพิ่มใบอนุญาต ชื่อผู้ให้บริการ ชื่อธนาคาร ยอดฝากขั้นต่ำ
// จำนวนสมาชิก ปีที่ก่อตั้ง หรือค่า RTP และต้องคงคำกำกับของบรีฟไว้ว่าแต่ละรายการอาจ
// กำหนดรอบคำนวณ ค่ายเกม ยอดที่เข้าเกณฑ์ และระยะเวลารับโบนัสแตกต่างกัน
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 153
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `รวมภาพโปรโมชั่นสล็อตของ ${BRAND_NAME} ทั้งคืนยอดเสีย โบนัส 0.3% และแนะนำเพื่อน โบนัส 0.8% พร้อมจุดที่ควรตรวจสอบรอบคำนวณและยอดที่เข้าเกณฑ์จากบัญชีสมาชิกก่อนกดรับ`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่นสล็อต ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});
---

<MainLayout title={`โปรโมชั่นสล็อต ${BRAND_NAME} คืนยอดเสีย โบนัส 0.3% และแนะนำเพื่อน โบนัส 0.8%`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`โปรโมชั่นสล็อต ${BRAND_NAME}`} as="h1">
    <div class="flex flex-col gap-10">
      <p class="text-left text-base leading-relaxed">
        หน้านี้รวมภาพโปรโมชั่นที่ <strong class="text-[#ffeeb4]">{BRAND_NAME}</strong> เปิดให้สมาชิกตรวจสอบในแต่ละช่วงของเดือน ทั้งโบนัสคืนยอดเสียและกิจกรรมแนะนำเพื่อน โดยรายละเอียดของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว
        <strong class="text-[#ffeeb4]">แต่ละรายการอาจกำหนดรอบคำนวณ ค่ายเกม ยอดที่เข้าเกณฑ์ และระยะเวลารับโบนัสแตกต่างกัน</strong> จึงควรอ่านรายละเอียดล่าสุดจากบัญชีสมาชิกก่อนกดรับทุกครั้ง
      </p>

      <div class="mx-auto grid w-full max-w-4xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่นของ 1SS365 ฉากหลังเป็นผ้าซาตินสีขาวสลับทองพลิ้วเป็นริ้ว ด้านซ้ายเป็นหญิงสาวผมยาวยิ้มน้อย ๆ สวมชุดสีขาวปักทองพร้อมเครื่องประดับทองทั้งต่างหู สร้อย และกำไล มือขวาแบหงายยื่นมาข้างหน้า รอบตัวมีเหรียญทอง ลูกเต๋าทอง และกล่องของขวัญกระจายอยู่ มุมบนขวาเป็นเวิร์ดมาร์ก 1SS365 ตรงกลางเป็นคำไทยสีทองขนาดใหญ่ว่า โปรโมชั่น มีมงกุฎทองอยู่ด้านบน ใต้ลงมาเป็นป้ายสีดำขอบทองคาดข้อความ คืนยอดเสีย โบนัส 0.3%"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), (max-width: 1007px) calc((100vw - 136px) / 2), 436px"
          class="mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#a87708]/60 object-contain shadow-[0_10px_30px_rgba(5,5,5,0.85)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#edbb23]/85 hover:shadow-[0_15px_40px_rgba(237,187,35,0.40)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่นของ 1SS365 ชุดเดียวกัน ฉากหลังผ้าซาตินสีขาวสลับทองพลิ้วเป็นริ้ว ด้านซ้ายเป็นหญิงสาวผมยาวสวมชุดสีขาวปักทองประดับเครื่องทองที่หู คอ และข้อมือ มือซ้ายชี้ขึ้นไปทางข้อความ มือขวาแบหงายยื่นมาข้างหน้า รอบตัวมีเหรียญทองและริบบิ้นทองปลิวอยู่ มุมบนขวาเป็นเวิร์ดมาร์ก 1SS365 ตรงกลางเป็นคำไทยสีทองขนาดใหญ่ว่า โปรโมชั่น มีมงกุฎทองอยู่ด้านบน ใต้ลงมาเป็นป้ายสีดำขอบทองคาดข้อความ แนะนำเพื่อน โบนัส 0.8%"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), (max-width: 1007px) calc((100vw - 136px) / 2), 436px"
          class="mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#a87708]/60 object-contain shadow-[0_10px_30px_rgba(5,5,5,0.85)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#edbb23]/85 hover:shadow-[0_15px_40px_rgba(237,187,35,0.40)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#a87708] bg-gradient-to-r from-[#ffeeb4] via-[#edbb23] to-[#a87708] px-10 py-3.5 text-lg font-black text-[#050505] shadow-[0_0_15px_rgba(237,187,35,0.40)] transition-transform hover:scale-105">
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
