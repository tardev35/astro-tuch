---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

// เฉพาะ slide1/slide2 (ลงวันที่ 2026-09-16) เท่านั้นที่เป็นอาร์ตเวิร์กของ OCZPLUS —
// ตรวจจากตัวภาพจริงแล้ว: slide1 คือโปสเตอร์ "แนะนำเพื่อน 0.8%" ส่วน slide2 คือ
// "คืนยอดเสีย 0.3%" — สลับกับลำดับของแบรนด์ก่อนหน้า อย่าคัดลอกลำดับ import เดิม
// slide3/slide4 (2026-08-13) กับ banner2/banner3 ยังค้างอยู่บนดิสก์แต่เป็นอาร์ตเวิร์ก
// ของลูกค้าเจ้าอื่น — ห้าม import ที่นี่ทั้งรอบนี้และรอบถัดไป
// (ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้ว)
import promoReferral from "../assets/slide1.png";
import promoCashback from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็น IMAGE page: ContentBox title, ย่อหน้าเกริ่นสั้น ๆ หนึ่งย่อหน้า, กริดโปสเตอร์,
// ปุ่ม CTA หนึ่งปุ่ม — ไม่มีหัวข้อย่อยและไม่มีย่อหน้าเพิ่ม เพราะตัวโปสเตอร์ระบุเงื่อนไข
// ของแต่ละโปรโมชั่นไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว เป้าหมาย h1×1, h2×0, h3×0
// ลำดับในกริดตามบรีฟ: แนะนำเพื่อน 0.8% มาก่อน คืนยอดเสีย 0.3%
//
// Announcement รอบนี้หมุนมาใช้ Announcement3 ทั้งเว็บ — default message ของไฟล์นั้น
// เป็นข้อความของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ได้
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 152
const pageDescription =
  "รวมโปรโมชั่นของ OCZPLUS ทั้งแนะนำเพื่อนรับ 0.8% และคืนยอดเสีย 0.3% แจกทุกยูสเซอร์ไม่มีล็อค ดูเปอร์เซ็นต์และเงื่อนไขการรับสิทธิ์ได้จากภาพโปรโมชั่นแต่ละใบ";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น OCZPLUS",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoReferral.src,
});
---

<MainLayout title="โปรโมชั่น OCZPLUS แนะนำเพื่อนรับ 0.8% และคืนยอดเสียรับ 0.3%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น OCZPLUS" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#ccd6e6]">
        หน้านี้รวมโปรโมชั่นที่ OCZPLUS แจกให้ทุกยูสเซอร์แบบไม่มีการล็อคยูส ทั้งแนะนำเพื่อนรับ
        <strong class="text-[#f2dc9a]">0.8%</strong> และคืนยอดเสีย <strong class="text-[#f2dc9a]">0.3%</strong>
        โดยเปอร์เซ็นต์ ยอดที่นำมาคำนวณ และวิธีกดรับสิทธิ์ระบุไว้บนภาพโปรโมชั่นแต่ละใบ
        <strong class="text-[#dd3a3f]">แต่ละรายการมีเงื่อนไขต่างกัน จึงควรอ่านรอบการคำนวณและเงื่อนไขล่าสุดก่อนกดรับทุกครั้ง</strong>
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อน 0.8% พื้นหลังสีน้ำเงินกรมท่าเป็นลายเส้นเชื่อมโยงไอคอนผู้คนเป็นเครือข่าย มุมซ้ายบนเป็นโลโก้ OCZPLUS ตัวอักษรสีเงินคั่นกลางด้วยเครื่องหมายบวกสีแดง ด้านซ้ายเป็นหญิงสาวชุดสีทองดำถือแท็บเล็ตที่แสดงผังเครือข่ายสมาชิก ยืนคู่กับชายหนุ่มในสูทสีกรมท่าที่ชี้นิ้วขึ้นไปทางข้อความ ด้านขวาเป็นคำว่า โปรโมชั่น แนะนำเพื่อน สีขาว วางเหนือตัวเลข 0.8% ขนาดใหญ่สีทองขอบแดง และบรรทัดล่างสุดเขียนว่า ง่ายๆ เพียงส่งต่อลิงก์"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#8a6b2c]/70 object-contain shadow-[0_10px_30px_rgba(2,16,31,0.75)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#d9b45e]/75 hover:shadow-[0_15px_40px_rgba(217,180,94,0.35)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่นคืนยอดเสีย 0.3% พื้นหลังสีดำอมกรมท่ามีลายโค้ดโปรแกรมและประกายแสงสีทอง มุมซ้ายบนเป็นโลโก้ OCZPLUS ตัวอักษรสีเงินคั่นกลางด้วยเครื่องหมายบวกสีแดง ด้านซ้ายเป็นคำว่า โปรโมชั่น คืนยอดเสีย สีขาว วางเหนือตัวเลข 0.3% ขนาดใหญ่สีทอง ด้านขวาเป็นหญิงสาวชุดราตรีสีแดงเลือดหมูกางมือเชิญ ยืนคู่กับชายหนุ่มในสูทสีเทาที่ถือแท็บเล็ตแสดงกราฟและตัวเลข 0.3%"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#8a6b2c]/70 object-contain shadow-[0_10px_30px_rgba(2,16,31,0.75)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#d9b45e]/75 hover:shadow-[0_15px_40px_rgba(217,180,94,0.35)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก OCZPLUS"
          class="flex items-center justify-center rounded-lg border border-[#f2dc9a]/70 bg-gradient-to-r from-[#f2dc9a] via-[#d9b45e] to-[#8a6b2c] px-10 py-3.5 text-lg font-black text-[#03101f] shadow-[0_0_15px_rgba(217,180,94,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก OCZPLUS
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
