---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

// ดรอปนี้ (2026-10-12) มีสไลด์ที่ใช้ได้แค่สองใบ และรอบนี้เปิดอ่านป้ายบนภาพจริงซ้ำแล้ว
// ห้ามเชื่อเลขไฟล์หรือคอมเมนต์ของรอบก่อน (การจับคู่สลับข้างแทบทุกรอบ — ตารางใน
// brand-spec §4 ตรงกับสิ่งที่พิมพ์อยู่บนรูปจริงของรอบนี้):
//   slide1.png — เหรียญตรามังกรทองมุมขวาบน ใต้เหรียญเป็นตัวอักษร TND168
//                หนุ่มสาวผมขาวเงินชุดสูทดำขลิบทองกางแขน หลังเป็นวงล้อรูเล็ต
//                ใต้คำว่า "โปรโมชั่น" เขียน "คืนยอดเสีย 0.3%" บนแผ่นป้ายดำขอบทอง
//   slide2.png — เหรียญตรามังกรทองมุมซ้ายบน ไพ่เอซขอบทองซ้าย ลูกเต๋าทองขวา
//                กองเหรียญทองตลอดขอบล่าง ใต้คำว่า "โปรโมชั่น" เขียน
//                "แนะนำเพื่อน โบนัส 0.8%"
//   slide3.png / slide4.png — อาร์ตเวิร์กของแบรนด์ก่อนหน้า (mtime 09-29)
//     ห้าม import กลับมาเด็ดขาด และห้ามลบไฟล์ทิ้งเพราะเป็นอินเวนทอรีของรอบถัดไป
// ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้ว และ verify-build จะแดง
// (banner2 / banner3 ใน src/assets เป็นอาร์ตเวิร์กของแบรนด์ก่อนๆ ห้าม import ส่วน
// banner1 / banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักชื่อไว้เอง
// — ห้ามอ้างจากหน้านี้)
// ชื่อตัวแปรตั้งตามข้อความบนภาพ ไม่ใช่ตามเลขไฟล์ เพื่อไม่ให้รอบหน้าสลับผิดอีก
import promoCashback from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้นๆ ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมด
// ของหน้านี้, กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อยและห้ามเพิ่มย่อหน้า
// เพราะตัวโปสเตอร์ระบุเปอร์เซ็นต์โบนัสไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว การพิมพ์ซ้ำ
// ด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ บรีฟรอบนี้ (src/assets/content.txt)
// ไม่มีส่วน SUB-PAGES เลย ย่อหน้าทุกย่อหน้าที่เคยอยู่บนหน้านี้จึงเป็นของที่รีแบรนด์
// รอบก่อนๆ แต่งขึ้นเอง — รอบนี้คงไว้เพียงย่อหน้าเกริ่นเดียว
//
// สไลด์รอบนี้เป็น **600x600 ทั้งคู่** วางเป็นกริดสองคอลัมน์ คุมความกว้างรวมที่
// max-w-4xl (896px) ทำให้ช่องละ ~436px ไม่ต้องอัปสเกลเกินขนาดไฟล์ต้นทาง widths
// หยุดที่ 600 ตามความกว้างจริงของไฟล์ และคุมภาพต่อใบไว้ที่ max-w-[600px]
// เรียง คืนยอดเสีย 0.3% ก่อน แนะนำเพื่อน 0.8% ตามลำดับของบรีฟ (docx H3 #4 แล้ว #5)
// ซึ่งรอบนี้แปลว่า **slide1 มาก่อน slide2** ตามข้อความที่พิมพ์อยู่บนรูป
// sizes คิดจากความกว้างที่ถูกวาดจริง: px-4 ของ section (16px/ข้าง) + p-8 ของการ์ด
// (32px/ข้าง, เป็น p-10 = 40px ที่ md ขึ้นไป) + gap-6 (24px) ระหว่างสองคอลัมน์
// LCP คือ hero ใน MainLayout ไม่ใช่สองรูปนี้ จึง loading="lazy" fetchpriority="low"
//
// Announcement รอบนี้หมุนมาเป็น AnnouncementPremium ทั้งเว็บ (brand-spec §3)
// orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว และ
// ทุกหน้าก็เรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูด
// คนละเรื่องกันระหว่างหน้า
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ทองมังกรบนดำสนิท ฮิวเดียวล้วน** ไม่มีสีที่สอง
// เลย bg.json ของดรอปนี้เป็น {"mode":"color","color":"#000000"} = ดำสนิท แผ่นที่จม
// ที่สุดจึงเป็น #070502 ไม่ใช่ดำ ลำดับผิว: #1b1307 ยก (การ์ด ContentBox) / #120c04
// กลาง / #070502 จม / #000000 พื้นเพจ
// ทองหลัก #dfa310 ถือขอบรูปและออรา · ทองสว่าง #ffe4a3 เป็นสีตอน hover · ทองไฮไลต์
// #ffc93d สงวนไว้ให้ <strong> ในเนื้อความอย่างเดียว · หมึกบนพื้นถมทองเป็น #140d02
// · เนื้อความ #f0e9dc มาจาก BRAND_TEXT ที่ <html> และการ์ด ContentBox ตั้งให้แล้ว
// ย่อหน้าจึงไม่ประกาศสีของตัวเอง
// · <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ
// ถ้าเปิด/ปิดกลางคำ บรรทัดจะตัดกลางคำ
// ⚠️ ไล่เฉดปุ่มพื้นทองต้องหยุดที่ #dfa310 ห้ามไล่ลงไปเข้มกว่านั้นใต้ตัวอักษร
// · #8a5c09 #43240b เป็นเส้น ขอบ และออราเท่านั้น ห้ามถือตัวอักษรทุกขนาด
// · ออราใช้ rgba(223,163,16,α) และ rgba(255,201,61,α) เท่านั้น
// ⚠️ กับดักของรอบนี้: ทองมาแล้วเก้าในสิบเอ็ดรอบหลังสุด "เจอทอง" ไม่ได้แปลว่าเป็นของ
// รอบนี้ ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน brand-spec §2 (ค่าของแบรนด์ก่อนไม่พิมพ์
// ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive) และรอบนี้ **ไม่มีชมพู
// ไม่มีม่วง ไม่มีเงิน/เทา ไม่มีเขียว ไม่มีน้ำเงิน ไม่มีแดง**
//
// แบรนด์นี้เป็น **แบรนด์คาสิโนรวมทุกหมวด** (บาคาร่า สล็อต รูเล็ต ไฮโล แทงบอล และ
// คาสิโนไลฟ์สด) ไม่ใช่เว็บสล็อตล้วนแบบแบรนด์ก่อน ไม่ใช่เว็บกีฬาล้วน และไม่ใช่เว็บของ
// หมวดลอตเตอรี (สองหน้าของหมวดนั้นจอดอยู่ใน src/pages-disabled/ ไม่มี route — ลิงก์
// ค้างจะเป็น href ตายที่ทำให้บิลด์แดง) คำขายของของแบรนด์ก่อนและศัพท์หมวดอื่นที่บรีฟ
// ไม่ได้เอ่ยห้ามหลงเหลือ (รายการเต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้
// grep เจอ false positive) ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% / 0.8% / 3 ขั้นตอน /
// 24 ชั่วโมง — ห้ามแต่งยอดฝากขั้นต่ำ ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP เลขใบอนุญาต
// จำนวนสมาชิก ปีก่อตั้ง หรือปี พ.ศ./ค.ศ. ใดๆ (บรีฟรอบนี้ไม่ได้เอ่ยปีไว้เลย) และต้อง
// คงคำกำกับของบรีฟ (บรรทัด 9 ของ content.txt) ไว้ว่า **ควรตรวจสอบว่าโปรโมชั่น
// ครอบคลุมบาคาร่า สล็อต รูเล็ต ไฮโล หรือแทงบอลประเภทใดบ้าง เพราะแต่ละกิจกรรมอาจมี
// ข้อกำหนดแตกต่างกัน**
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) หน้านี้ยาว 154 อักขระ
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `รวมภาพโปรโมชั่น ${BRAND_NAME} แบรนด์คาสิโนเซิร์ฟไทย ทั้งคืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อน โบนัส 0.8% แต่ละกิจกรรมมีรอบรับสิทธิ์และเงื่อนไขไม่เหมือนกัน`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่น ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});

// ความกว้างที่ถูกวาดจริงของแต่ละช่องในกริดสองคอลัมน์ (ดูคอมเมนต์ sizes ด้านบน)
const promoSizes = "(max-width: 639px) calc(100vw - 96px), (max-width: 767px) calc((100vw - 120px) / 2), (max-width: 1007px) calc((100vw - 136px) / 2), 436px";
const promoClass =
  "mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#dfa310]/40 object-contain shadow-[0_0_28px_rgba(223,163,16,0.28)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ffe4a3]/85 hover:shadow-[0_0_40px_rgba(255,201,61,0.38)]";
---

<MainLayout title={`โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน โบนัส 0.8%`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`โปรโมชั่น ${BRAND_NAME} ทั้งหมด`} as="h1">
    <div class="flex flex-col gap-10">
      <p>
        หน้านี้รวมภาพโปรโมชั่นที่ <strong class="text-[#ffc93d]">{BRAND_NAME}</strong> เปิดให้สมาชิกตรวจสอบสิทธิ์ตามกิจกรรมที่เว็บไซต์กำหนด โดยมีทั้งโบนัสคืนยอดเสียและกิจกรรมแนะนำเพื่อน รายละเอียดของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว
        สมาชิกตรวจสอบยอดที่เข้าเกณฑ์ รอบคำนวณ และสถานะการรับสิทธิ์ได้จากบัญชีสมาชิกตามระบบที่เปิดให้บริการ <strong class="text-[#ffc93d]">
          ควรตรวจสอบว่าโปรโมชั่นครอบคลุมบาคาร่า สล็อต รูเล็ต ไฮโล หรือแทงบอลประเภทใดบ้าง เพราะแต่ละกิจกรรมอาจมีข้อกำหนดแตกต่างกัน
        </strong>
      </p>

      <div class="mx-auto grid w-full max-w-4xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt={`ภาพโปรโมชั่นของ ${BRAND_NAME} เป็นฉากคาสิโนสีดำ-ทอง มุมขวาบนเป็นเหรียญตรามังกรจีนทองขัดเงา ใต้เหรียญเป็นตัวอักษร ${BRAND_NAME} แบบทองสามมิติ กลางภาพค่อนไปทางซ้ายเป็นชายหนุ่มและหญิงสาวผมสีขาวเงินในชุดสูทดำขลิบทอง กางแขนยื่นมือมาทางผู้ชม ด้านหลังเป็นวงล้อรูเล็ต เหรียญทองกระจาย ชิปคาสิโนดำขอบทอง และไพ่เอซขอบทองที่มุมล่างซ้าย กลางภาพเป็นคำว่า โปรโมชั่น ตัวอักษรทองสามมิติขนาดใหญ่ใต้มงกุฎทองดวงเล็ก ใต้ลงมาบนแผ่นป้ายดำขอบทองเขียนว่า คืนยอดเสีย คู่กับตัวเลข 0.3% ตัวโต`}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoReferral}
          alt={`ภาพโปรโมชั่นของ ${BRAND_NAME} ชุดเดียวกัน พื้นดำทองล้วน มุมซ้ายบนเป็นเหรียญตรามังกรจีนทองขัดเงา ใต้เหรียญเป็นตัวอักษร ${BRAND_NAME} แบบทองสามมิติ กลางภาพค่อนไปทางขวาเป็นชายหนุ่มและหญิงสาวผมสีขาวเงินในชุดสูทดำขลิบทอง ยื่นมือออกมาทางผู้ชมทั้งคู่ ด้านซ้ายเป็นไพ่เอซขอบทองกับชิปคาสิโนดำขอบทอง ด้านขวาเป็นลูกเต๋าทอง และมีกองเหรียญทองเรียงตลอดขอบล่าง กลางภาพเป็นคำว่า โปรโมชั่น ตัวอักษรทองสามมิติขนาดใหญ่ใต้มงกุฎทอง ใต้ลงมาบนแผ่นป้ายดำขอบทองเขียนว่า แนะนำเพื่อน โบนัส คู่กับตัวเลข 0.8% ตัวโต`}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#8a5c09] bg-gradient-to-b from-[#ffc93d] to-[#dfa310] px-10 py-3.5 text-lg font-black text-[#140d02] shadow-[0_0_14px_rgba(223,163,16,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
