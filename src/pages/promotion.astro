---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

// ⚠️ ดรอปนี้ (mtime 2026-10-09 15:26) มีสไลด์ที่ "ใช้ได้" แค่สองใบ และรอบนี้อ่านป้าย
// บนภาพจริงใหม่แล้ว ห้ามเชื่อเลขไฟล์หรือคอมเมนต์ของรอบก่อน (เคยสลับกันมาแล้ว):
//   slide1.png — ป้าย "โปรโมชั่น" ทองสามมิติ ใต้ป้ายเขียน "คืนยอดเสีย 0.3%"
//   slide2.png — ป้าย "โปรโมชั่น" ทองสามมิติ ใต้ป้ายเขียน "แนะนำเพื่อน โบนัส 0.8%"
//   slide3.png / slide4.png — โปสเตอร์ลอตเตอรีของแบรนด์อื่นคนละเจ้า ห้าม import กลับมา
//     เด็ดขาด และห้ามลบไฟล์ทิ้งเพราะเป็นอินเวนทอรีของรอบถัดไป
// ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้ว และ verify-build จะแดง
// (banner2 / banner3 ใน src/assets เป็นอาร์ตเวิร์กของแบรนด์ก่อนๆ ห้าม import ส่วน
// banner1 / banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักชื่อไว้เอง
// — ห้ามอ้างจากหน้านี้)
// ชื่อตัวแปรตั้งตามข้อความบนภาพ ไม่ใช่ตามเลขไฟล์ เพื่อไม่ให้รอบหน้าสลับผิดอีก
import promoCashback from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้นๆ "หนึ่งย่อหน้า ประมาณสี่บรรทัด" คือ
// โควตาตัวหนังสือทั้งหมดของหน้านี้, กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อย
// และห้ามเพิ่มย่อหน้า เพราะตัวโปสเตอร์ระบุเปอร์เซ็นต์โบนัสไว้ด้วยตัวอักษรขนาดใหญ่
// อยู่แล้ว การพิมพ์ซ้ำด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ เป้าหมาย h1x1 h2x0 h3x0
//
// สไลด์รอบนี้เป็น **600x600 ทั้งคู่** วางเป็นกริดสองคอลัมน์ คุมความกว้างรวมที่
// max-w-4xl (896px) ทำให้ช่องละ ~436px ไม่ต้องอัปสเกลเกินขนาดไฟล์ต้นทาง widths
// หยุดที่ 600 ตามความกว้างจริงของไฟล์ และคุมภาพต่อใบไว้ที่ max-w-[600px]
// เรียง คืนยอดเสีย 0.3% ก่อน แนะนำเพื่อน 0.8% ตามลำดับของบรีฟ (docx H3 #4 แล้ว #5)
// ซึ่งรอบนี้แปลว่า slide1 มาก่อน slide2
// sizes คิดจากความกว้างที่ถูกวาดจริง: px-4 ของ section (16px/ข้าง) + p-8 ของการ์ด
// (32px/ข้าง, เป็น p-10 = 40px ที่ md ขึ้นไป) + gap-6 (24px) ระหว่างสองคอลัมน์
// LCP คือ hero ใน MainLayout ไม่ใช่สองรูปนี้ จึง loading="lazy" fetchpriority="low"
//
// Announcement รอบนี้หมุนมาเป็น Announcement5 ทั้งเว็บ (รอบก่อนใช้ AnnouncementCyber)
// orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว และทุกหน้า
// ก็เรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกัน
// ระหว่างหน้า
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ม่วงนีออน x ทองอาร์เขต บนครามเกือบดำ**
// bg.json เป็นสีเดียว #0c0024 · ม่วงสด #a435f0 ถือขอบ รางเส้น และออรา ไม่เคยถือ
// ตัวอักษรปกติ · ม่วงอ่อน #d2a6ff เป็นตัวอักษรรองบนผิวการ์ด (7.4:1) · ทองสว่าง
// #fbe455 สงวนไว้ให้ <strong> ในเนื้อความ (และใช้เป็น "แสง" ในเงาได้) · ทองอุ่น
// #ffd23d กับทองเข้ม #c98a05 เป็นพื้นถมของปุ่มหลัก · หมึกบนพื้นทองเป็นม่วงเกือบดำ
// #190633 เท่านั้น (11.0:1 บน #ffd23d) · เนื้อความ #ece2ff มาจาก BRAND_TEXT ที่
// <html> และการ์ด ContentBox ตั้งให้แล้ว ย่อหน้าจึงไม่ประกาศสีของตัวเองเลย
// ⚠️ ห้ามพลิกปุ่มพื้นทองให้เป็นหมึกสว่าง (เหลือ ~1.3:1 อ่านไม่ออก) และห้ามวาง
// ตัวอักษรสว่างบนม่วงสด #a435f0 (3.1:1 — brand-spec §2 ระบุว่าห้ามโดยตรง)
// ชุดสีของแบรนด์ก่อนๆ ออกครบแล้ว ทั้งคลาส Tailwind raw hex และ rgba() (ค่าเดิม
// อยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ
// false positive) ห้ามนำกลับมา
//
// แบรนด์นี้เป็น **เว็บเล่นสล็อตออโต้ รวมเกมจากค่ายหลักไว้ในแพลตฟอร์มเดียว** ไม่ใช่
// เว็บรวมทุกหมวด และรอบนี้ไม่มีหมวดลอตเตอรีเลย คำขายของของแบรนด์ก่อนและศัพท์หมวดอื่นที่
// บรีฟไม่ได้เอ่ยห้ามหลงเหลือ (รายการเต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep เจอ false positive) ตัวเลขที่บรีฟให้และอ้างได้มีแค่
// 1 บาท / 0.3% / 0.8% / 24 ชั่วโมง ห้ามแต่งยอดฝากขั้นต่ำ ชื่อค่ายเกม ชื่อธนาคาร
// ค่า RTP เลขใบอนุญาต หรือวันหมดเขต และต้องคงคำกำกับของบรีฟไว้ว่าแต่ละโปรโมชั่น
// มีเงื่อนไขต่างกัน ควรอ่านก่อนรับสิทธิ์
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) หน้านี้ยาว 155 อักขระ
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `รวมภาพโปรโมชั่นของ ${BRAND_NAME} ทั้งคืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อน 0.8% จากยอดที่เข้าเกณฑ์ ควรอ่านรอบคำนวณและเงื่อนไขของแต่ละรายการก่อนรับสิทธิ์`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่น ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});

// ความกว้างที่ถูกวาดจริงของแต่ละช่องในกริดสองคอลัมน์ (ดูคอมเมนต์ sizes ด้านบน)
const promoSizes = "(max-width: 639px) calc(100vw - 96px), (max-width: 767px) calc((100vw - 120px) / 2), (max-width: 1007px) calc((100vw - 136px) / 2), 436px";
const promoClass =
  "mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#a435f0]/40 object-contain shadow-[0_0_28px_rgba(164,53,240,0.30)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#a435f0]/85 hover:shadow-[0_0_40px_rgba(251,228,85,0.40)]";
---

<MainLayout title={`โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% สำหรับยอดที่เข้าเกณฑ์`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`โปรโมชั่น ${BRAND_NAME} ทั้งหมด`} as="h1">
    <div class="flex flex-col gap-10">
      <p class="text-left text-base leading-relaxed">
        หน้านี้รวมภาพโปรโมชั่นที่ <strong>{BRAND_NAME}</strong> เปิดให้สมาชิกตรวจสอบสิทธิ์ตามแคมเปญที่เปิดให้บริการในแต่ละช่วง โดยเน้นกิจกรรมคืนยอดเสียและแนะนำเพื่อน รายละเอียดของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว
        ระบบจะนำยอดที่เข้าเกณฑ์มาคำนวณตามรอบก่อนแสดงจำนวนโบนัส <strong>
          แต่ละรายการอาจกำหนดค่ายเกม ระยะเวลา และข้อกำหนดแตกต่างกัน
        </strong> จึงควรเข้าสู่ระบบอ่านรายละเอียดและรอบคำนวณก่อนรับสิทธิ์ทุกครั้ง
      </p>

      <div class="mx-auto grid w-full max-w-4xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt={`ภาพโปรโมชั่นของ ${BRAND_NAME} มุมซ้ายบนเป็นโลโก้ ${BRAND_NAME} รูปเครื่องเกมพกพาสีม่วง กลางภาพเป็นหญิงสาวผมสั้นสีขาวเงินกำลังขยิบตาและแบมือข้างหนึ่งออกมาทางผู้ชม ด้านซ้ายเป็นกล่องของขวัญสีทอง ด้านขวาเป็นเสือการ์ตูนสวมแว่นกันแดดและตู้สล็อตขึ้นเลข 777 มีเหรียญทองกระจายอยู่ทั่วภาพ ด้านล่างเป็นคำว่า โปรโมชั่น ตัวอักษรสามมิติสีทองขนาดใหญ่ และใต้ลงมาเขียนว่า คืนยอดเสีย คู่กับตัวเลข 0.3% สีทองตัวโต`}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoReferral}
          alt={`ภาพโปรโมชั่นของ ${BRAND_NAME} มุมซ้ายบนเป็นโลโก้ ${BRAND_NAME} รูปเครื่องเกมพกพาสีม่วง กลางภาพเป็นหญิงสาวผมยาวสีทองกำลังยกนิ้วโป้ง โดยมีหญิงสาวผมสีขาวเงินยืนอยู่ด้านหลังไหล่ซ้าย ด้านล่างซ้ายเป็นเพนกวินการ์ตูนสีฟ้า ด้านขวาเป็นเสือการ์ตูนสวมแว่นกันแดด รอบตัวมีเชอร์รีสีแดง ดาวสีทอง วงล้อสล็อตสีม่วงทองขึ้นเลข 777 และเหรียญทอง ด้านล่างเป็นคำว่า โปรโมชั่น ตัวอักษรสามมิติสีทอง และใต้ลงมาเขียนว่า แนะนำเพื่อน โบนัส คู่กับตัวเลข 0.8% สีทองตัวโต`}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#c98a05] bg-gradient-to-b from-[#ffd23d] to-[#c98a05] px-10 py-3.5 text-lg font-black text-[#190633] shadow-[0_0_14px_rgba(251,228,85,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
