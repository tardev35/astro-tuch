---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

// ดรอปนี้ (2026-10-28, brand-spec §6) มีสไลด์ที่เป็นของแบรนด์นี้ **สองใบ**
// และชื่อตัวแปรตั้งตามข้อความที่พิมพ์อยู่บนภาพจริง (เปิดบิตแมปอ่านเองแล้วรอบนี้)
// ไม่ใช่ตามเลขไฟล์ — ถ้ารอบหน้าเจอความขัดแย้ง **ให้เชื่อข้อความบนรูป**:
//   slide1.png (mtime 2026-10-28, ดรอปนี้) — โปสเตอร์ "โปรโมชั่น / คืนยอดเสีย / 0.3%"
//   slide2.png (mtime 2026-10-28, ดรอปนี้) — โปสเตอร์ "โปรโมชั่น / แนะนำเพื่อน / 0.8%"
// 🚨 **รอบก่อนจับคู่กลับด้านกับรอบนี้** (รอบก่อน slide1 = แนะนำเพื่อน) — uploader
// เขียนทับไฟล์เดิมทุกครั้ง **เลขไฟล์จึงไม่มีความหมายข้ามแบรนด์** ต้องเปิดบิตแมป
// ดูทุกรอบ ห้ามสืบทอดการจับคู่ของรอบก่อน และห้ามเชื่อคอมเมนต์เก่า
//   สไลด์ใบที่สามและสี่ (mtime 2026-09-29 = คนละดรอป คนละแบรนด์) — **ห้าม import**
//   แบนเนอร์ใบที่สองและสาม (mtime 2026-10-23 = อาร์ตเวิร์กของอีกแบรนด์) —
//     **ห้าม import** รอบนี้ไม่มี "รูปประกอบบทความ" เลย
//   (ชื่อไฟล์เต็มของทั้งสี่อยู่ใน brand-spec §6 — ไม่พิมพ์ที่นี่ เพื่อให้ grep หา
//    การ import ที่หลงเหลือได้คำตอบว่างจริงๆ)
// ⚠️ eager import = emit ลง dist/ ต่อให้ไม่ได้ render และ verify-build จะแดง
// การ import ไฟล์เก่าคือการส่งรูปของลูกค้ารายอื่นขึ้นเว็บนี้
// **ห้ามลบไฟล์เก่าทิ้ง** — เป็นอินเวนทอรีของรอบถัดไป แค่ห้าม import
// (banner1 / banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักชื่อไว้เอง —
// ห้ามอ้างจากหน้านี้) รอบนี้หน้านี้จึงมีเฉพาะสไลด์สองใบ กริดจึงเป็นสองช่อง
import promoCashback from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้นๆ ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมด
// ของหน้านี้, กริดภาพโปรโมชั่น, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อยและห้ามเพิ่มย่อหน้า
// เพราะโปสเตอร์ระบุชื่อรายการและเปอร์เซ็นต์ของตัวเองด้วยตัวอักษรขนาดใหญ่อยู่แล้ว
// การพิมพ์ซ้ำด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่
// บรีฟรอบนี้ (src/assets/content.txt, 29 บรรทัด) **ไม่มีส่วน SUB-PAGES เลย**
// ทุกย่อหน้าที่เคยอยู่บนหน้านี้คือของที่รีแบรนด์รอบก่อนๆ แต่งขึ้นเอง
//
// 0.3% / 0.8% เป็นเนื้อหาของบรีฟจริง (content.txt บรรทัด 7-12) จึงอ้างได้ตามปกติ
// แต่ **หน้านี้ยังเป็นหน้าภาพ** โควตาตัวหนังสือจึงเป็นย่อหน้าเกริ่นเดียวเท่านั้น
// และ intro ต้องคงประโยคกำกับของบรีฟ (เงื่อนไขต่างกัน ควรตรวจประกาศล่าสุด) ไว้
//
// ลำดับในกริด: slide1 (คืนยอดเสีย) ก่อน slide2 (แนะนำเพื่อน) ตามลำดับเลขไฟล์ของดรอป
// ⚠️⚠️ **บิตแมปจริงของดรอปนี้คือ 375x600 แนวตั้ง** (วัดจาก IHDR ของไฟล์เองรอบนี้)
// ความกว้างสูงสุดคือ 375 widths จึงหยุดที่ 375 และคุมที่ max-w ที่ 375px
// **ให้วัดใหม่ทุกรอบจากไฟล์จริง อย่าเชื่อสัดส่วนของรอบก่อน และห้ามขยายเกินต้นฉบับ**
// sizes คิดจากความกว้างที่ถูกวาดจริง: section px-4 (16px/ข้าง) + การ์ด p-8
// (32px/ข้าง, เป็น p-10 = 40px ที่ md ขึ้นไป) + gap-6 ระหว่างคอลัมน์ (24px)
//   ใต้ 640px = คอลัมน์เดียว → 100vw-96px
//   640-767px = สองคอลัมน์ p-8 → 50vw-60px
//   768-885px = สองคอลัมน์ p-10 → 50vw-68px
//   ตั้งแต่ 886px ขึ้นไปชนเพดาน 375px
// LCP คือ hero ใน MainLayout ไม่ใช่รูปพวกนี้ จึง loading="lazy" fetchpriority="low"
// decoding="async" และ quality ตัวเดียวทั้ง avif/webp — ห้ามจูนแยกฟอร์แมต
// (tools/avif-quality-service.mjs ย่อฝั่ง avif ให้เองที่ x0.65)
//
// quality={64} ไม่ใช่ 80 ตามปกติ: สไลด์ทั้งสองเป็นภาพถ่ายคนในฉากอิ่มสี บวก
// ตัวอักษรไทยสามมิติผิวมันเงาตัดขอบคมที่มีไฮไลต์ทับอยู่ด้านบน ซึ่งเป็นเคสที่
// AVIF ทำได้แย่ที่สุด ที่ quality=80 ไฟล์ AVIF มีโอกาสออกมา **ใหญ่กว่า** WebP ที่เป็น
// fallback ของตัวเอง เบราว์เซอร์ที่รองรับ AVIF จะหยิบไฟล์ที่หนักกว่าไปใช้ และ
// verify-build.mjs ทำให้ build แดงด้วยเหตุนี้ตรงๆ · ทางแก้คือ quality ที่ **ต่ำลง**
// ไม่ใช่สูงขึ้น · ค่าเดียวกันนี้ต้องใช้ที่ index.astro กับสไลด์ใบเดียวกัน
//
// Announcement รอบนี้หมุนมาเป็นตัวท้ายชื่อเลขสาม ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ตัวท้ายชื่อ Premium จึงหมุนออก · เขียนชื่อไฟล์แบบไม่มีเครื่องหมายคำพูดโดยตั้งใจ
// เพราะ tools/gen-tw-sources.mjs นับ literal ที่มีเครื่องหมายคำพูดว่าเป็นการ import
// จริง คอมเมนต์จึงทำให้ variant เก่าหลุดเข้า Tailwind scan แล้วสีของแบรนด์ก่อนขึ้น
// stylesheet) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้
// ไว้แล้ว และทุกหน้าเรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop message
//
// ───────────────────────────────────────────────────────────────────────────
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) **กลับทิศ 180° จากรอบก่อน: รอบนี้มืดทั้งเว็บ**
// bg.json ของดรอปนี้คือ {"mode":"color","color":"#002908"} = **เขียวป่าจมเกือบดำ**
// (รอบก่อนเป็นขาวอมมิ้นต์จาง ซึ่งอยู่คนละปลายของสเกล — อ่านจากไฟล์ทุกรอบ ห้ามเดา)
// **ห้าม "แก้" การ์ดกลับไปเป็นพื้นขาว** การ์ดขาวบนหมึก eef7f0 = ตัวอักษรหายไปเลย
// ลำดับผิว: พื้นเพจ #002908 / โครม #031b09 / การ์ด ContentBox #073c1a /
// ชั้นยก #0e5424 · เส้นบาง #1e7033 · ขอบตกแต่ง #35a043 (**ทั้งคู่ห้ามถือตัวอักษร**)
// หมึก #eef7f0 = เนื้อความ (= BRAND_TEXT ที่ <html> และการ์ด ContentBox ตั้งให้แล้ว
// 12.0:1 บนการ์ด) · หมึกรอง #9dc2a5 (6.3:1)
// เขียวมรกต #3ddc4a = สีของ <strong> ในเนื้อความ (6.9:1 บนการ์ด) และสีหัวข้อ
// เงินโครเมียม #dfe6e3 (9.9:1) · ทองอำพัน #e8c86a (8.0:1) ถือตัวอักษรได้ทั้งคู่
// 🚨🚨 **#35a043 บนการ์ดได้แค่ 3.8:1 และ #1e7033 ได้ 2.1:1 ห้ามเป็นสีตัวอักษร**
// ปุ่ม CTA ของหน้านี้เป็น **PRIMARY = ไล่เฉดเขียว** #0e5424 → #1e7033 → #23823a
// บนหมึก **ขาว #ffffff** (8.4 / 6.1 / 4.9:1 ต่อ stop — ผ่าน AA ทุก stop)
// ⚠️⚠️ **ห้ามลากปลายเฉดขึ้นไปถึง #35a043 หรือ #3ddc4a** (ตกต่ำกว่า 4.5:1 กับขาว)
// แผ่นไฮไลต์ด้านบนปุ่มจำกัดที่ white/10
// rgba() ที่อนุญาตรอบนี้: rgba(61,220,74,α) · rgba(1,13,4,α) · rgba(232,200,106,α) ·
// rgba(223,230,227,α)
// ⚠️⚠️ **รอบนี้ไม่มีม่วง/ฟ้า/ไซแอน/แมเจนต้า/ส้มเพลิง/แดงเป็นสี UI เลยสักเฉด**
// ⚠️⚠️ กับดักที่แหลมที่สุดรอบนี้คือ **เขียวของแบรนด์อื่น** ซึ่งเป็นตระกูลเดียวกับ
// รอบนี้เป๊ะ — **รวมถึงแบรนด์รอบก่อนทันทีที่ก็เป็นเขียว/เงิน/ทองเหมือนกัน
// ต่างแค่กลับทิศสว่าง-มืด** ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน brand-spec §2
// ห้ามตัดสินด้วยสายตา
// · กิโมโนลายดอกไม้เขียว-ขาว ชิปคาสิโนเขียว มงกุฎทอง กอไผ่ ฉากห้องสว่าง และสีผิว
// นักแสดงในอาร์ตเวิร์กเป็น **วัตถุในภาพ ไม่ใช่สี UI** · และ **เวิร์ดมาร์กโครเมียมเงิน
// -เขียวมรกตก็เป็นอาร์ตเวิร์ก ไม่ใช่สี UI** · พื้นเพจมาจาก bg.json เท่านั้น
// · <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ
// ถ้าเปิด/ปิดกลางคำ บรรทัดจะตัดกลางคำ
//
// ⚠️ แกนของแบรนด์รอบนี้คือ **เว็บเกมคาสิโน/เดิมพันออนไลน์** (บาคาร่า สล็อต หวย
// บอล ไฮโล) คำนิยามตัวเองของแบรนด์ก่อนๆ ห้ามเหลือ โดยเฉพาะศัพท์หมวดธุรกิจทั้งชุด
// ของแบรนด์ขาออก (brand-spec §5 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep เจอ false positive)
// 🚨 **บรีฟรอบนี้ไม่พูดถึงธนาคาร วอลเลท หรือการฝากถอนเลยแม้แต่คำเดียว**
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 3 ขั้นตอน · 24ชม.
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -c บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงนี้ยาว 158 ด้วยชื่อแบรนด์ 7 อักขระของรอบนี้
// (**ต้องนับใหม่ทุกรอบ** ห้ามสืบทอดความยาว)
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `รวมภาพโปรโมชั่น ${BRAND_NAME} ทั้งคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% อัปเดตใหม่ตลอดสัปดาห์ แต่ละรายการมีเงื่อนไขต่างกัน ควรตรวจสอบประกาศล่าสุดก่อนรับสิทธิ์ทุกครั้ง`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่น ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});

// ความกว้างที่ถูกวาดจริงของแต่ละคอลัมน์ในกริดสองคอลัมน์ (ดูคอมเมนต์ sizes ด้านบน)
const promoSizes = "(max-width: 639px) calc(100vw - 96px), (max-width: 767px) calc(50vw - 60px), (max-width: 885px) calc(50vw - 68px), 375px";

const promoClass =
  "mx-auto h-auto w-full max-w-[375px] rounded-xl border border-[#1e7033] object-contain shadow-[0_8px_28px_rgba(1,13,4,0.5)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#35a043] hover:shadow-[0_12px_40px_rgba(61,220,74,0.28)]";

// alt ทั้งสองเขียนจากบิตแมปของดรอปนี้ที่เปิดอ่านเองแล้ว (**375x600 แนวตั้ง** ทั้งคู่) —
// ฉากห้องสไตล์ญี่ปุ่นที่มีกอไผ่และดอกไม้ขาว หญิงสาวผมยาวสีน้ำตาลเข้มเกล้ามวยประดับ
// ดอกไม้ขาว สวมกิโมโนลายดอกไม้สีเขียว-ขาวคาดโอบิ · ตัวอักษรไทยสามมิติผิวเขียวมรกต
// เคลือบเงาตัดขอบทองว่า โปรโมชั่น · ชื่อรายการตัวขาวบนแถบดำขอบทอง · ตัวเลข
// เปอร์เซ็นต์ตัวโตเขียวตัดขอบทอง · แคปซูลสีดำขอบทองท้ายภาพเขียนว่า สมัครสมาชิก
// พร้อมไอคอนคนและลูกศรคู่
// ⚠️ alt คือ "ข้อความที่พิมพ์อยู่บนโปสเตอร์" เป็นหลัก — ตัวเลขท้าย alt ต้องตรงกับรูป
// ⚠️ ห้ามเรียกรูปคู่นี้ว่าภาพแนวนอนหรือภาพสี่เหลี่ยมจัตุรัส รอบนี้เป็น **แนวตั้ง**
// ⚠️ จุดที่ **ต่างกันจริงระหว่างสองใบ** และต้องเขียนให้ตรง (ตรวจจากบิตแมปรอบนี้):
//   slide1 (คืนยอดเสีย 0.3%) โลโก้อยู่ **มุมบนขวา** · นั่งตัวตรง ไม่มีมงกุฎ ไม่มีชิป
//   slide2 (แนะนำเพื่อน 0.8%) โลโก้อยู่ **มุมบนซ้าย** · เท้าแขนวางมือใต้คาง ·
//     **มงกุฎทองดวงเล็กอยู่เหนือคำว่า โปรโมชั่น** · มีชิปคาสิโนเขียว-ขาวประดับมงกุฎทอง
//   **มงกุฎมีใบเดียวรอบนี้** — กลับด้านจากรอบก่อนที่มีทั้งสองใบ ห้ามลอกของรอบก่อน
// ⚠️ ห้ามระบุว่าใช้มือซ้ายหรือมือขวา — รอบก่อนๆ เขียนไว้แล้วผิดหลายรอบติด
// ⚠️ สีของวัตถุในรูป (กิโมโนเขียว ชิปเขียว มงกุฎทอง) เป็นวัตถุในภาพ ไม่ใช่สีของแบรนด์
// ⚠️ องค์ประกอบของอาร์ตเวิร์กแบรนด์ก่อนๆ ที่ต้องไม่หลงเหลือใน alt อยู่ครบใน
// brand-spec §6 (ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive)
const altCashback = `โปสเตอร์โปรโมชั่นแนวตั้ง มุมบนขวาเป็นโลโก้ ${BRAND_NAME} แบบเวิร์ดมาร์กสามมิติ ครึ่งแรกเป็นตัวอักษรละตินผิวโครเมียมเงินขัดเงา ต่อด้วยตัวเลขผิวเขียวมรกตเคลือบเงา ตัดขอบดำหนา วางทับวงพู่กันหมึกสีดำ ฝั่งซ้ายเป็นหญิงสาวผมยาวสีน้ำตาลเข้มเกล้ามวยประดับดอกไม้ขาว สวมกิโมโนลายดอกไม้สีเขียว-ขาวคาดโอบิ นั่งอยู่หน้าฉากกอไผ่ ครึ่งขวาเป็นตัวอักษรไทยสามมิติผิวเขียวมรกตเคลือบเงาตัดขอบทองอ่านว่า โปรโมชั่น ใต้ลงมาเป็นคำว่า คืนยอดเสีย ตัวขาวบนแถบสีดำขอบทอง แล้วตัวเลข 0.3% ตัวโตสีเขียวมรกตตัดขอบทอง ปิดท้ายด้วยแคปซูลสีดำขอบทองเขียนว่า สมัครสมาชิก พร้อมไอคอนรูปคนและลูกศรคู่`;

const altReferral = `โปสเตอร์โปรโมชั่นแนวตั้ง มุมบนซ้ายเป็นโลโก้ ${BRAND_NAME} แบบเวิร์ดมาร์กสามมิติ ครึ่งแรกเป็นตัวอักษรละตินผิวโครเมียมเงินขัดเงา ต่อด้วยตัวเลขผิวเขียวมรกตเคลือบเงา ตัดขอบดำหนา วางทับวงพู่กันหมึกสีดำ กลางภาพเป็นหญิงสาวผมยาวสีน้ำตาลเข้มเกล้ามวยประดับดอกไม้ขาว สวมกิโมโนลายดอกไม้สีเขียว-ขาว นั่งเท้าแขนและวางมือไว้ใต้คาง ครึ่งล่างเป็นตัวอักษรไทยสามมิติผิวเขียวมรกตเคลือบเงาตัดขอบทองอ่านว่า โปรโมชั่น มีมงกุฎทองดวงเล็กอยู่เหนือตัวอักษร ใต้ลงมาเป็นคำว่า แนะนำเพื่อน ตัวขาวบนแถบสีดำขอบทอง แล้วตัวเลข 0.8% ตัวโตสีเขียวมรกตตัดขอบทอง ขนาบด้วยชิปคาสิโนสีเขียวสลับขาวที่ประดับมงกุฎทอง ปิดท้ายด้วยแคปซูลสีดำขอบทองเขียนว่า สมัครสมาชิก พร้อมไอคอนรูปคนและลูกศรคู่`;
---

<MainLayout title={`รวมภาพโปรโมชั่น ${BRAND_NAME} อัปเดตใหม่ตลอดสัปดาห์`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`รวมภาพโปรโมชั่น ${BRAND_NAME}`} as="h1">
    <div class="flex flex-col gap-10">
      <p>
        หน้านี้รวมภาพรายการโปรโมชั่นของ {BRAND_NAME} ที่อัปเดตใหม่ตลอดสัปดาห์ไว้ในที่เดียว โดยชื่อรายการและเปอร์เซ็นต์ของแต่ละรายการพิมพ์อยู่บนภาพแล้ว ทั้งนี้
        <strong class="text-[#3ddc4a]">โปรโมชั่นแต่ละรายการอาจกำหนดประเภทเกม ยอดที่นำมาคำนวณ และข้อจำกัดการถอนเงินแตกต่างกัน จึงควรตรวจสอบประกาศล่าสุดจากเว็บไซต์ทางการก่อนเข้าร่วมทุกครั้ง</strong>
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt={altCashback}
          loading="lazy"
          fetchpriority="low"
          widths={[250, 375]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />

        <Picture
          src={promoReferral}
          alt={altReferral}
          loading="lazy"
          fetchpriority="low"
          widths={[250, 375]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="relative isolate flex items-center justify-center overflow-hidden rounded-lg border border-[#35a043] bg-gradient-to-b from-[#0e5424] via-[#1e7033] to-[#23823a] px-10 py-3.5 text-lg font-black text-white shadow-[0_8px_22px_rgba(1,13,4,0.5)] transition-transform hover:scale-105">
          <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-white/10 to-transparent"></span>
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
