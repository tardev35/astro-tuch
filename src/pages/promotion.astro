---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";

import { Picture } from "astro:assets";

// Only slide1/slide2 are this brand's assets — slide3/slide4 are stale
// leftovers from the previous brand (older mtime, not part of this drop) and
// must not be imported or rendered. See BRAND_SPEC_JOJO789.md "Assets" section.
import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "โปรโมชั่น JOJO789 คาสิโนออนไลน์บนมือถือ ตรวจ 5 จุดก่อนกดรับสิทธิ์ทุกครั้ง ทั้งยอดฝากขั้นต่ำ เปอร์เซ็นต์โบนัส เงื่อนไขเทิร์น เกมที่ร่วมรายการ และยอดถอนสูงสุด";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น JOJO789 เงื่อนไขที่ต้องอ่านก่อนกดรับสิทธิ์",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});
---

<MainLayout title="โปรโมชั่น JOJO789 แนะนำเพื่อนรับ 0.8% คืนยอดเสียรับ 0.3% และเงื่อนไขที่ต้องอ่านก่อนกดรับ" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น JOJO789" as="h1">
    <div>
      <h2 class="mb-4 text-2xl leading-normal font-bold text-[#fced0b]">โปรโมชั่น JOJO789 ต้องดู 5 จุดไหนก่อนกดรับสิทธิ์</h2>

      <p class="mb-5 text-left text-base leading-relaxed text-[#f4ecc9]">
        <strong class="text-[#fff6b0]">JOJO789</strong> เป็นบริการคาสิโนออนไลน์บนมือถือ ครอบคลุมคาสิโนสด บาคาร่า และสล็อตในบัญชีเดียว สิทธิ์ที่หน้าเว็บเปิดให้กดรับจึงผูกอยู่กับยอดฝากและกิจกรรมที่ร่วมรายการ ไม่ได้ลอยอยู่เดี่ยว ๆ ในหน้าโปร ตัวเลขใหญ่บนแบนเนอร์บอกได้แค่ว่ามีอะไรให้ ส่วนบรรทัดเล็กใต้ตัวเลขคือคนที่ตัดสินว่าเราได้จริงเท่าไร ก่อนกดรับจึงควรไล่ให้ครบทั้ง 5 จุด คือยอดฝากขั้นต่ำ เปอร์เซ็นต์โบนัส จำนวนเทิร์น กิจกรรมที่ร่วมรายการ และยอดถอนสูงสุด เพราะโปรแต่ละแบบกำหนดเงื่อนไขถอนไม่เหมือนกัน การเลือกจากเปอร์เซ็นต์สูงที่สุดเพียงอย่างเดียวจึงไม่ใช่วิธีที่ปลอดภัยที่สุด
      </p>

      <p class="mb-5 text-left text-base leading-relaxed text-[#f4ecc9]">
        ตอนนี้ JOJO789 เปิดให้สิทธิ์หลัก 2 รายการ คือโบนัสแนะนำเพื่อน 0.8% จากยอดเดิมพันของเพื่อนที่สมัครผ่านลิงก์แนะนำ และโบนัสคืนยอดเสียทุกวัน 0.3% สำหรับสมาชิกที่เดิมพันต่อเนื่อง ตัวเลขเหล่านี้ควรใช้เป็นข้อมูลร่างแล้วตรวจจากหน้าโปรจริงอีกครั้งก่อนกด เพราะช่วงเวลาของสิทธิ์ เกมที่ยกเว้น และการรับซ้อนกับรายการอื่นเป็นรายละเอียดที่เปลี่ยนได้ตามรอบ ถ้าแผนของเราคือหมุนตามงบแล้วปิดจบ การไม่รับสิทธิ์เลยก็เป็นทางเลือกที่สมเหตุสมผล เพราะโบนัสที่ติดเทิร์นไม่ได้แปลว่าเงินอยู่ในมือแล้ว
      </p>

      <h2 class="mt-10 mb-4 text-2xl leading-normal font-bold text-[#fced0b]">คืนยอดเสีย 0.3% คิดจากฐานไหน และตรวจเทิร์นอย่างไร</h2>

      <p class="mb-5 text-left text-base leading-relaxed text-[#f4ecc9]">
        คำว่าคืนยอดเสีย 0.3% ต้องแยกให้ชัดก่อนว่าคำนวณจากยอดเดิมพันรวม ยอดเสียสุทธิ หรือเฉพาะเกมที่ร่วมรายการ เพราะฐานคำนวณต่างกันแล้วผลลัพธ์ก็ไม่เท่ากัน แม้เปอร์เซ็นต์จะเขียนเหมือนเดิมทุกตัวอักษร หลังกดรับสิทธิ์ควรเปิดหน้าประวัติรายการดูว่ายอดเข้าครบ เทิร์นเดินถูกเกม และยอดคงเหลือตรงกับที่ระบบแสดง เพราะบางรายการนับยอดเฉพาะสล็อตบางค่าย และอาจไม่นับยอดจากโต๊ะคาสิโนสดเลย อีกจุดที่คนอ่านข้ามบ่อยคือเดิมพันเริ่มต้นราว 1–10 บาทต่อรอบ ซึ่งเป็นยอดของเกมที่รองรับ ไม่ใช่ขั้นต่ำของการฝากหรือการถอน ทั้งสามส่วนใช้ตัวเลขคนละชุด จึงควรดูยอดบนหน้าฝากและหน้าเกมแยกกัน
      </p>

      <p class="mb-8 text-left text-base leading-relaxed text-[#f4ecc9]">
        ด้านการเงิน ระบบฝากถอนออโต้ของ JOJO789 เปิดทำรายการผ่านหน้าเว็บได้ตลอด 24 ชั่วโมงตามสถานะระบบในช่วงนั้น สมาชิกทำรายการได้ด้วยตัวเองไม่ต้องรอแอดมิน เวลาร่างอยู่ที่ราว 10–30 วินาทีสำหรับฝาก และ 1–3 นาทีสำหรับถอน ก่อนทำรายการควรตรวจชื่อบัญชี ยอดเงิน และประวัติรายการให้ครบ หากยอดยังไม่เปลี่ยนไม่ควรกดซ้ำทันที เพราะนิ้วที่กดสองรอบไม่ได้ทำให้ธนาคารขยันขึ้น และควรกรอกข้อมูลเฉพาะบนโดเมนที่ตรวจแล้วและเชื่อมต่อแบบ HTTPS เท่านั้น ไม่ใช่ลิงก์ที่ส่งต่อกันมาในแชตพร้อมคำโฆษณา
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={pro1}
          alt="แบนเนอร์ JOJO789 โบนัสแนะนำเพื่อน รับ 0.8% จากยอดเดิมพันของเพื่อนที่สมัครผ่านลิงก์แนะนำ พร้อมระบบฝากถอนออโต้ 24 ชม. และตรวจสอบสิทธิ์ได้เองผ่านระบบ"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600, 800]}
          sizes="(max-width: 768px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#fced0b]/25 object-contain shadow-[0_10px_30px_rgba(252,237,11,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fced0b]/50 hover:shadow-[0_15px_40px_rgba(252,237,11,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro2}
          alt="แบนเนอร์ JOJO789 โบนัสคืนยอดเสียทุกวัน รับ 0.3% สำหรับสมาชิกที่เดิมพันต่อเนื่อง พร้อมข้อความ เล่นทุกวัน รับคืนทุกวัน และระบบฝากถอนออโต้ 24 ชม."
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600, 800]}
          sizes="(max-width: 768px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#fced0b]/25 object-contain shadow-[0_10px_30px_rgba(252,237,11,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fced0b]/50 hover:shadow-[0_15px_40px_rgba(252,237,11,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#fced0b]/60 bg-gradient-to-r from-[#fff6b0] via-[#fced0b] to-[#b38f00] px-10 py-3.5 text-lg font-black text-[#201800] shadow-[0_10px_30px_rgba(252,237,11,0.18)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(179,143,0,0.30)]">
          สมัครสมาชิก JOJO789
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
