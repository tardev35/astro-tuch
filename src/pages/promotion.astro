---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

// Only slide1/slide2 are this brand's assets — slide3/slide4 are stale
// leftovers from an earlier brand's drop (dated 2026-08-04, before this
// ZORO365 upload) and must not be imported or rendered. See
// .claude/.rebrand-scratch-ZORO365.md "Images" section.
// slide1 = คืนยอดเสียทุกวัน 0.3% art, slide2 = แนะนำเพื่อน 0.8% art.
import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "โปรโมชั่น ZORO365 คาสิโนออนไลน์ระบบออโต้ คืนยอดเสียทุกวัน 0.3% และแนะนำเพื่อนรับโบนัส 0.8% ตรวจสอบเงื่อนไขให้ครบก่อนกดรับสิทธิ์ทุกครั้ง เพื่อความคุ้มค่าสูงสุด";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น ZORO365 คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8%",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});
---

<MainLayout title="โปรโมชั่น ZORO365 คืนยอดเสียรับ 0.3% แนะนำเพื่อนรับ 0.8%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น ZORO365" as="h1">
    <div>
      <h2 class="mb-4 text-2xl leading-normal font-bold text-[#fbbf24]">คืนยอดเสียทุกวัน รับโบนัส 0.3%</h2>

      <p class="mb-8 text-left text-base leading-relaxed text-[#e9f7e6]">
        สมาชิกที่มียอดเล่นเสียตรงตามเงื่อนไขสามารถรับยอดคืน 0.3% ได้ทุกวัน โดยเข้าสู่บัญชีสมาชิกและกดรับสิทธิ์ผ่านหน้าเว็บไซต์
      </p>

      <h2 class="mb-4 text-2xl leading-normal font-bold text-[#fbbf24]">แนะนำเพื่อน รับโบนัส 0.8%</h2>

      <p class="mb-8 text-left text-base leading-relaxed text-[#e9f7e6]">
        แชร์ลิงก์แนะนำให้เพื่อนสมัครสมาชิกกับ ZORO365 รับโบนัส 0.8% จากยอดเล่นของเพื่อนตามเงื่อนไข พร้อมตรวจสอบยอดโบนัสผ่านบัญชีสมาชิกได้ทุกวัน
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={pro1}
          alt="แบนเนอร์ ZORO365 โบนัสคืนยอดเสียทุกวัน 0.3% ธีมป่าลึกยามค่ำคืน มีไอคอนคืนเงินและหีบสมบัติทอง พร้อมแถบข้อมูลรับโบนัส 0.3% ทุกวัน มั่นคงปลอดภัย 100% ฝาก-ถอนรวดเร็ว และบริการ 24 ชม."
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600, 800]}
          sizes="(max-width: 768px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#fbbf24]/25 object-contain shadow-[0_10px_30px_rgba(251,191,36,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fbbf24]/50 hover:shadow-[0_15px_40px_rgba(180,83,9,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro2}
          alt="แบนเนอร์ ZORO365 โบนัสแนะนำเพื่อน 0.8% ธีมป่าลึกยามค่ำคืน มีสัญลักษณ์สล็อต 777 เหรียญทอง และชิปคาสิโนตราสัญลักษณ์ ZORO365"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600, 800]}
          sizes="(max-width: 768px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#fbbf24]/25 object-contain shadow-[0_10px_30px_rgba(251,191,36,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fbbf24]/50 hover:shadow-[0_15px_40px_rgba(180,83,9,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#fbbf24]/60 bg-gradient-to-r from-[#fde68a] to-[#fbbf24] px-10 py-3.5 text-lg font-black text-[#04120a] shadow-[0_10px_30px_rgba(251,191,36,0.18)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(180,83,9,0.30)]">
          สมัครสมาชิก ZORO365
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
