---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

// Only slide1/slide2 belong to JUMBOBET (drop 2026-08-13) and they are literally
// the two promotions this page shows: slide1 is the "คืนยอดเสีย รับโบนัส 0.3%"
// poster, slide2 is the "แนะนำเพื่อน รับโบนัส 0.8%" poster. slide3/slide4 are
// still on disk but belong to a previous client (2026-08-04) — they may not be
// imported here, now or on any future rebrand.
import promoCashback from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";

// This is an IMAGE page: the ContentBox title, ONE short intro paragraph, the
// poster grid, one CTA. No section headings, no extra prose — the posters
// already state every offer in large type.
//
// 150–160 CHARACTERS (not bytes — a byte count reads ~3x too long for Thai).
const pageDescription = "รวมโปรโมชั่น JUMBOBET ทั้งคืนยอดเสียรับโบนัส 0.3% และแนะนำเพื่อนรับโบนัส 0.8% ดูรายละเอียดและตรวจสอบเงื่อนไขการรับสิทธิ์ในบัญชีสมาชิกก่อนกดรับทุกครั้ง";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น JUMBOBET คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8%",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});
---

<MainLayout title="โปรโมชั่น JUMBOBET คืนยอดเสียรับ 0.3% แนะนำเพื่อนรับ 0.8%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น JUMBOBET" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#d5e8d0]">
        หน้านี้รวมโปรโมชั่นที่ JUMBOBET เปิดรับอยู่ในขณะนี้ ทั้งคืนยอดเสียรับโบนัส 0.3% และแนะนำเพื่อนรับโบนัส 0.8% อัตราโบนัส ยอดที่นำมาคำนวณ
        และรอบเวลาการรับสิทธิ์ระบุไว้บนภาพโปรโมชั่นแต่ละใบ และเงื่อนไขของแต่ละรายการไม่เหมือนกัน สมาชิกตรวจสอบยอดสะสมและกดรับสิทธิ์ได้จากบัญชีสมาชิก
        หรือสอบถามแอดมินที่ดูแลตลอด 24 ชั่วโมง
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่นพื้นหลังสีดำลายวงจรไฟฟ้าเรืองแสงสีเขียว ด้านบนเป็นโลโก้ JUMBOBET ตัวอักษรโครมเงินสลับเขียว ถัดลงมาเป็นป้ายข้อความ โปรโมชั่น คืนยอดเสีย รับโบนัส พร้อมตัวเลข 0.3% สีเขียวขนาดใหญ่ หญิงสาวผมยาวมัดหางม้าสวมชุดสีแดงดำยืนแบมืออยู่ด้านขวา มีชิปคาสิโนสีเขียวลอยข้างมือ ด้านล่างซ้ายมีไพ่เอซโพดำกับเอซดอกจิกและกองชิปคาสิโน และแถบไอคอนสามช่องเขียนว่า คืนยอดเสียทุกวัน มั่นคง ปลอดภัย เชื่อถือได้ และบริการตลอด 24 ชั่วโมง"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#0b7a06]/55 object-contain shadow-[0_10px_30px_rgba(37,203,14,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#6ef25a]/70 hover:shadow-[0_15px_40px_rgba(240,247,238,0.28)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่นพื้นหลังสีดำลายวงจรไฟฟ้าเรืองแสงสีเขียว ด้านบนเป็นโลโก้ JUMBOBET ตัวอักษรโครมเงินสลับเขียว ถัดลงมาเป็นป้ายข้อความ โปรโมชั่น แนะนำเพื่อน รับโบนัส พร้อมตัวเลข 0.8% สีขาวขนาดใหญ่ หญิงสาวผมยาวสวมเสื้อครอปสีแดงดำยืนชี้นิ้วอยู่ด้านขวา มีชิปคาสิโนลอยอยู่มุมบนซ้าย ด้านล่างซ้ายมีกองชิปคาสิโนสีแดงขาวดำและไพ่เอซสี่ใบวางเรียงกัน"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#0b7a06]/55 object-contain shadow-[0_10px_30px_rgba(37,203,14,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#6ef25a]/70 hover:shadow-[0_15px_40px_rgba(240,247,238,0.28)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg bg-gradient-to-r from-[#25cb0e] via-[#0b7a06] to-[#063f04] px-10 py-3.5 text-lg font-black text-[#f0f7ee] shadow-[0_0_15px_rgba(37,203,14,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก JUMBOBET
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
