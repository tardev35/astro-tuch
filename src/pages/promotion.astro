---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

// ⚠️ สองสไลด์ของดรอปนี้ **สลับบทบาทกับรอบก่อน** — รอบที่แล้ว slide1 คือเลข 2 ตัว
// ดรอปนี้กลับด้าน ยืนยันด้วยการเปิดภาพอ่านป้ายจริง ไม่ใช่เชื่อชื่อไฟล์หรือคอมเมนต์
// ของรอบก่อน:
//   slide1.png — ป้ายขอบทอง "3ตัว จ่าย1,000บาท" (นางแบบอยู่ขวา ลูกบอล 3/7/9 ซ้ายล่าง)
//   slide2.png — ป้ายขอบทอง "2ตัว จ่าย100บาท" (นางแบบอยู่ซ้าย ถือลูกบอลเลข 8)
//   slide3.png / slide4.png — โปสเตอร์ของแบรนด์ก่อน (29 ก.ย. เก่ากว่าดรอปนี้)
//     ห้าม import กลับมาเด็ดขาด และห้ามลบไฟล์ทิ้งเพราะเป็นอินเวนทอรีของรอบถัดไป
// ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้วและ verify-build จะแดง
// (banner2/banner3 ใน src/assets ก็เก่ากว่าดรอปนี้ = อาร์ตเวิร์กแบรนด์ก่อน ห้าม import)
// ส่วน banner1 / banner1-mobile / og.png เป็นของ MainLayout ห้าม import จากหน้านี้
// ชื่อตัวแปรตั้งตามข้อความบนภาพ ไม่ใช่ตามเลขไฟล์ เพื่อไม่ให้รอบหน้าสลับผิดอีก
import promoThreeDigit from "../assets/slide1.png";
import promoTwoDigit from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้น ๆ "หนึ่งย่อหน้า ประมาณสี่บรรทัด" คือ
// โควตาตัวหนังสือทั้งหมดของหน้านี้, กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อย
// และห้ามเพิ่มย่อหน้า เพราะตัวโปสเตอร์ระบุอัตราจ่ายไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว
// การพิมพ์ซ้ำด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ เป้าหมาย h1x1 h2x0 h3x0
//
// สไลด์รอบนี้เป็นแนวนอน 600x300 ทั้งคู่ (วัดจาก PNG header) จึงวางเป็นกริดสองคอลัมน์
// คุมความกว้างรวมที่ max-w-4xl (896px) ทำให้ช่องละ ~436px ไม่ต้องอัปสเกลเกินขนาดไฟล์
// ต้นทาง widths หยุดที่ 600 ตามความกว้างจริงของไฟล์ และคุมภาพต่อใบไว้ที่
// max-w-[600px] สองใบพอดีหนึ่งแถว กริดจึงจัดกลางสมมาตรโดยไม่ต้องมีใบที่ span สอง
// คอลัมน์ · เรียง 2 ตัวจ่าย 100 บาท ก่อน 3 ตัวจ่าย 1,000 บาท ตามลำดับของบรีฟ
// (docx H3 #4 แล้วค่อย #5) ซึ่งรอบนี้แปลว่า slide2 มาก่อน slide1 · LCP คือ hero ใน
// MainLayout ไม่ใช่สองรูปนี้ จึง loading="lazy" fetchpriority="low" ทั้งคู่
//
// Announcement รอบนี้หมุนมาเป็น Announcement5 ทั้งเว็บ (แบรนด์ก่อนใช้
// Announcement3) — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ
// หวยดีใจ แล้ว และทุกหน้าก็เรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop message มิฉะนั้น
// ตัววิ่งจะพูดคนละเรื่องกันระหว่างหน้า
//
// พาเลตต์ หวยดีใจ (brand-spec §2) **แดงแบรนด์ + เงินโครเมียม ทองเป็นสีรอง** —
// กลับทิศจากรอบก่อนที่คู่หลักเป็นแดง/ทอง: แดงแบรนด์ #dc0409 · แดงสว่าง #f5363d
// (hover/glow) · แดงเข้ม #8e0206 · แดงดำ #4b0205 (ขอบปุ่ม) · เงินสว่าง #eef0f4 ·
// เงินกลาง #c3c7d1 (ขอบรูป) · ทอง accent #f3c54e (หมึก strong เท่านั้น ตาม
// brand-spec: ไฮไลต์ strong ใช้สีเดียวทั้งเว็บ) · พื้นผิวลึก #0d0407 (เงารูป) ·
// ผิวการ์ด #17080c · ผิวการ์ดยก #211016 · เนื้อความ #edeaf0 (BRAND_TEXT มาจาก
// <html> และการ์ด ContentBox ตั้งให้แล้ว จึงไม่ต้องระบุสีที่ย่อหน้า)
// ปุ่มสมัครถมแดงแบรนด์เต็มใบบนตัวอักษร **ขาว** — แดงที่สว่างที่สุดที่ยังผ่าน AA
// บนตัวอักษรขาวคือ #e8161c จึงห้ามใช้ #f5363d เป็นพื้นปุ่มที่มีข้อความ
// ชุดแดง+ทองของแบรนด์ก่อน (#d20a0a #f5c33b #ffd45e #a9761a #f7e2d6 #170707
// #0a0303 #230d0d #1a0303 rgba(210,10,10,*) rgba(245,195,59,*)) ออกครบแล้ว
//
// หวยดีใจ เป็น **เว็บแทงหวยล้วน** ไม่ใช่คาสิโน — คำหมวดสล็อต/คาสิโน (สล็อต บาคาร่า
// คาสิโนสด ค่ายเกม RTP คืนยอดเสีย % แนะนำเพื่อน %) ห้ามหลงเหลือ
// ตลาดหวยที่บรีฟระบุไว้เองและอ้างได้มีห้าตัว: รัฐบาลไทย · หวยลาว · หวยฮานอย ·
// หวยออมสิน · หวย ธ.ก.ส.
// ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 100 / 1,000 / 2 ตัว / 3 ตัว / 3 ขั้นตอน / 24 ชั่วโมง
// ห้ามแต่งเวลาเปิด-ปิดรับ ชื่อธนาคาร เลขใบอนุญาต ยอดฝากขั้นต่ำ หรือจำนวนสมาชิก
// และต้องคงคำกำกับของบรีฟไว้ว่าอัตราจ่ายอาจต่างตามประเภทหวย รูปแบบการแทง และรอบ
// จึงให้ยึดอัตราล่าสุดบนหน้าส่งโพยก่อนยืนยัน
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 155
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `รวมภาพอัตราจ่ายของ ${BRAND_NAME} ทั้งเลข 3 ตัวจ่าย 1,000 บาท และเลข 2 ตัวจ่าย 100 บาท สำหรับรายการที่เข้าเงื่อนไข ควรอ่านอัตราจ่ายและวงเงินบนหน้าส่งโพยก่อนยืนยัน`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่นอัตราจ่าย ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoTwoDigit.src,
});
---

<MainLayout title={`โปรโมชั่นอัตราจ่าย ${BRAND_NAME} 2ตัว จ่าย100บาท และ 3ตัว จ่าย1,000บาท`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`โปรโมชั่นอัตราจ่าย ${BRAND_NAME}`} as="h1">
    <div class="flex flex-col gap-10">
      <p class="text-left text-base leading-relaxed">
        หน้านี้รวมภาพอัตราการจ่ายที่ <strong class="text-[#f3c54e]">{BRAND_NAME}</strong> เปิดรับสำหรับรายการที่เข้าเงื่อนไข ทั้งเลข 2 ตัวและเลข 3 ตัว ไม่ว่าจะเป็นรัฐบาลไทย หวยลาว หวยฮานอย หวยออมสิน หรือหวย
        ธ.ก.ส. โดยรายละเอียดของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว
        <strong class="text-[#f3c54e]">อัตราจ่ายอาจแตกต่างตามประเภทหวย รูปแบบการแทง หรือรอบที่เลือก</strong> จึงควร Login อ่านอัตราล่าสุดและวงเงินรับแทงบนหน้าส่งโพยก่อนยืนยันรายการทุกครั้ง
      </p>

      <div class="mx-auto grid w-full max-w-4xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoTwoDigit}
          alt="ภาพอัตราการจ่ายของ หวยดีใจ พื้นหลังสีขาวสลับแดงประดับเหรียญทอง ด้านซ้ายเป็นหญิงสาวผมยาวสีเข้มสวมเสื้อสูทสีเงินวาว ถือลูกบอลหวยเลข 8 ไว้ข้างแก้มและยื่นมืออีกข้างแบออกมา รอบตัวมีลูกบอลหวยเลข 6 9 3 7 ลอยกระจายบนกองเหรียญทอง บนสุดเป็นโลโก้คำว่า หวยดีใจ สวมมงกุฎทอง ถัดลงมาเป็นตัวอักษรไทยสีแดงขอบทองขนาดใหญ่ว่า อัตราการจ่าย และป้ายขอบทองข้อความ 2ตัว จ่าย100บาท"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), (max-width: 1007px) calc((100vw - 136px) / 2), 436px"
          class="mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#c3c7d1]/50 object-contain shadow-[0_10px_30px_rgba(13,4,7,0.85)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#eef0f4]/80 hover:shadow-[0_15px_40px_rgba(220,4,9,0.40)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoThreeDigit}
          alt="ภาพอัตราการจ่ายของ หวยดีใจ พื้นหลังสีขาวสลับแดงพร้อมริบบิ้นแดงและเหรียญทองกองอยู่ด้านล่าง ด้านขวาเป็นหญิงสาวผมยาวสวมชุดเดรสสีเงินวาว ยื่นมือทั้งสองข้างแบออกมา ด้านซ้ายล่างมีลูกบอลหวยเลข 3 7 9 วางบนกองเหรียญคู่กับใบสลาก บนสุดเป็นโลโก้คำว่า หวยดีใจ สวมมงกุฎทอง ถัดลงมาเป็นตัวอักษรไทยสีแดงขอบทองขนาดใหญ่ว่า อัตราการจ่าย และป้ายขอบทองข้อความ 3ตัว จ่าย1,000บาท"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), (max-width: 1007px) calc((100vw - 136px) / 2), 436px"
          class="mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#c3c7d1]/50 object-contain shadow-[0_10px_30px_rgba(13,4,7,0.85)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#eef0f4]/80 hover:shadow-[0_15px_40px_rgba(220,4,9,0.40)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#4b0205] bg-gradient-to-r from-[#e8161c] via-[#dc0409] to-[#8e0206] px-10 py-3.5 text-lg font-black text-white shadow-[0_0_15px_rgba(220,4,9,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
