---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

// Only slide1/slide2 belong to JADTEM88 (drop 2026-08-15), and they are
// exactly the two promotions this page shows: slide1 is the "แนะนำเพื่อน 0.8%"
// poster, slide2 is the "คืนยอดเสีย 0.3%" poster.
// slide3/slide4 are still on disk but belong to previous clients (PIGAUTO911) —
// they may not be imported here, now or on any future rebrand (an unrendered
// import is still emitted into dist/).
import promoReferral from "../assets/slide1.png";
import promoCashback from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";

// This is an IMAGE page: the ContentBox title, ONE short intro paragraph, the
// poster grid, one CTA. No section headings, no extra prose — the posters
// already state every offer in large type.
//
// 150–160 CHARACTERS (not bytes — a byte count reads ~3x too long for Thai).
const pageDescription =
  "รวมโปรโมชั่น JADTEM88 สล็อตเครือยักษ์ใหญ่ ทั้งโบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตรวจสอบรายละเอียดและเงื่อนไขของแต่ละรายการจากภาพโปรโมชั่นก่อนกดรับสิทธิ์";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น JADTEM88 แนะนำเพื่อน 0.8% คืนยอดเสีย 0.3%",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoReferral.src,
});
---

<MainLayout title="โปรโมชั่น JADTEM88 สล็อตเครือยักษ์ใหญ่ แนะนำเพื่อน 0.8% คืนยอดเสีย 0.3%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น JADTEM88" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#cbd5e1]">
        หน้านี้รวมโปรโมชั่นที่ JADTEM88 เปิดให้สมาชิกกดรับอยู่ในขณะนี้ ทั้งโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3%
        อัตราโบนัส ยอดที่นำมาคำนวณ และรอบเวลาการรับสิทธิ์ระบุไว้บนภาพโปรโมชั่นแต่ละใบ และเงื่อนไขของแต่ละรายการไม่เหมือนกัน
        สมาชิกตรวจสอบสิทธิ์และกดรับโบนัสได้จากบัญชีของตนเอง หรือสอบถามแอดมินผ่าน LINE Official ก่อนตัดสินใจเข้าร่วม
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่นโทนน้ำเงินกรมท่า ฉากหลังเป็นลูกโลกและดวงดาว กลางภาพเขียนว่า โปรโมชั่น แนะนำเพื่อน พร้อมตัวเลข 0.8% ขนาดใหญ่สีน้ำเงินโครเมียม ด้านข้างเป็นหญิงสาวผมบลอนด์สวมชุดกี่เพ้าสีกรมท่าขลิบเงินยกมือชี้ไปที่ข้อความ มีกองชิปคาสิโนสีน้ำเงินและดำ ไพ่ และชิปเลข 777 วางอยู่"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#1d4ed8]/60 object-contain shadow-[0_10px_30px_rgba(59,130,246,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#60a5fa]/70 hover:shadow-[0_15px_40px_rgba(203,213,225,0.28)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่นโทนน้ำเงินกรมท่า ฉากหลังเป็นดวงดาว กลางภาพเขียนว่า โปรโมชั่น คืนยอดเสีย พร้อมตัวเลข 0.3% ขนาดใหญ่สีน้ำเงินโครเมียม ด้านข้างเป็นหญิงสาวผมบลอนด์สวมชุดราตรีสีกรมท่าคาดสายสะพายสีเงิน มีตู้สล็อตโครเมียมขึ้นเลข 777 และชิปคาสิโนสีน้ำเงินกระจายอยู่"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#1d4ed8]/60 object-contain shadow-[0_10px_30px_rgba(59,130,246,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#60a5fa]/70 hover:shadow-[0_15px_40px_rgba(203,213,225,0.28)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#60a5fa]/70 bg-gradient-to-r from-[#e2e8f0] via-[#93c5fd] to-[#60a5fa] px-10 py-3.5 text-lg font-black text-[#03060f] shadow-[0_0_15px_rgba(59,130,246,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก JADTEM88
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
