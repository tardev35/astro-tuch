---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

// ดรอปอาร์ตเวิร์กของ PKG44 คือ 2026-09-27 และมีสไลด์ที่ใช้ได้สองใบเท่านั้น:
//   slide1.png — โปสเตอร์ "โปรโมชั่น แนะนำเพื่อน โบนัส 0.8%"
//   slide2.png — โปสเตอร์ "โปรโมชั่น คืนยอดเสีย โบนัส 0.3%"
// บทบาทของสองไฟล์นี้ "สลับกัน" ระหว่างแบรนด์มาแล้ว และเคยผูกกลับด้านมาก่อน
// อย่าเชื่อชื่อตัวแปรที่ตกทอดมาและอย่าคัดลอก import จากประวัติ git — รอบนี้เปิด
// ไฟล์ดูจริงแล้ว ตรงกับคำอธิบายอาร์ตเวิร์กใน brand-spec §6 ทั้งสองใบ
//
// ไฟล์สไลด์ลำดับที่สามและสี่ใน src/assets เก่ากว่าดรอปรอบนี้ (2026-09-18 และ
// 2026-08-13) เป็นอาร์ตเวิร์กของลูกค้าเจ้าก่อน — ห้าม import กลับมา และห้ามลบทิ้ง
// เพราะเป็นอินเวนทอรี (ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้ว
// และ verify-build จะแดง) ถ้ามีสไลด์ใหม่เข้ามาให้เช็ก mtime เทียบดรอปก่อนเพิ่ม
// กริดรอบนี้จึงมีสองช่องเท่านั้น ห้ามเติมให้เต็มด้วยของเก่า
import promoReferral from "../assets/slide1.png";
import promoCashback from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";
//
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ: ContentBox title, ย่อหน้าเกริ่นสั้น ๆ หนึ่งย่อหน้า
// (ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมดของหน้านี้), กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม
// — ไม่มีหัวข้อย่อยและไม่มีย่อหน้าเพิ่ม เพราะตัวโปสเตอร์ระบุชื่อโปรและเปอร์เซ็นต์โบนัส
// ไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว เป้าหมาย h1x1, h2x0, h3x0
//
// สไลด์เป็นแบนเนอร์แนวนอน 600x334 จึงวางเป็นกริดสองคอลัมน์คุมความกว้างรวมที่ max-w-5xl
// (1024px) ทำให้ช่องละ ~488px ไม่ต้องอัปสเกลเกินขนาดไฟล์ต้นทาง widths หยุดที่ 600
// ตามความกว้างจริงของไฟล์ (candidate ที่ใหญ่กว่านั้นไม่มีของให้ครอป)
//
// Announcement หมุนจาก Announcement2 มาเป็น AnnouncementPremium ทั้งเว็บรอบนี้ —
// default message ของไฟล์นั้นถูกตั้งเป็นคอปปี้ของ PKG44 แล้ว และ index ก็เรียกแบบ
// bare เหมือนกัน จึงห้ามส่ง prop message มิฉะนั้นตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ PKG44 (ทองเมทัลลิก + เงินโครเมียม บนพื้นดำ ตามโลโก้ที่ P G 44 เป็นทอง
// และ K เป็นเงินโครเมียม):
// พื้นเพจ #080602 · ผิวการ์ด #12100a · ผิวยก #2a2110 · ขอบลึก #4a3a12 ·
// ทองแบรนด์ #fdd32a · ทองสว่าง #ffe27a · ทองอ่อนสุด #ffeeb8 · ทองลึก #c8920a ·
// ทองเข้มสุด (ตัวอักษรบนพื้นทอง) #15110a · เงินโครเมียมกลาง #c2c8d0 ·
// เงินโครเมียมสว่าง #f2f4f7 · เงินโครเมียมเข้ม #8a9099 ·
// เนื้อความ #efe6d2 (BRAND_TEXT) · เน้นใน strong #fff8e1
// การ์ดโปสเตอร์ใบซ้ายได้ขอบทอง ใบขวาได้ขอบเงินโครเมียม เพื่อให้กริดอ่านเป็นทอง+โครเมียม
// ตัวอักษรบนพื้นทองต้องเป็น #15110a ห้ามใช้ขาว เขียวมรกตของ BRAZIL999 รอบก่อน
// (#22c55e #7cf25c #b6ff9c #0a6b18 #04380c #0a1a0c #123a18 #1c5a26 #040a05)
// ถูกแทนครบทุกจุดแล้ว แบรนด์นี้ไม่มีเขียวเลย
//
// PKG44 เป็นเว็บสล็อต บรีฟระบุแค่ "ติดต่อเจ้าหน้าที่" ไม่ได้ระบุช่องทางไลน์ในเนื้อความ
// และไม่ได้ระบุชื่อค่ายเกม ชื่อเกม ประเภทเกมโต๊ะ/คาสิโนสด หรือช่องทางฝากถอน
// จึงห้ามเขียนเพิ่มในหน้านี้
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 158
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "รวมโปรโมชั่น PKG44 ทั้งโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% ดูรายละเอียดยอดที่เข้าเกณฑ์ รอบรับสิทธิ์ และเงื่อนไขของแต่ละรายการก่อนกดรับสิทธิ์ทุกครั้ง";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น PKG44",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoReferral.src,
});
---

<MainLayout title="โปรโมชั่น PKG44 แนะนำเพื่อน โบนัส 0.8% และคืนยอดเสีย โบนัส 0.3%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น PKG44" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#efe6d2]">
        หน้านี้รวมภาพโปรโมชั่นที่ <strong class="text-[#fff8e1]">PKG44</strong> เปิดให้สมาชิกกดรับตามรายการและช่วงเวลาที่เว็บไซต์อัปเดตไว้ ทั้งโบนัสแนะนำเพื่อนและโบนัสคืนยอดเสีย โดยรายละเอียดของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว
        <strong class="text-[#fff8e1]">ยอดที่เข้าเกณฑ์ รอบรับสิทธิ์ และเงื่อนไขของแต่ละรายการแตกต่างกัน</strong> จึงควรตรวจสอบรายละเอียดล่าสุดจากหน้าเว็บไซต์อีกครั้งก่อนกดรับสิทธิ์ทุกครั้ง
      </p>

      <div class="mx-auto grid w-full max-w-5xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่นพื้นดำสลับทอง ด้านขวาบนเป็นโลโก้ PKG44 ตัวอักษรทองขลิบเงินโครเมียม ใต้โลโก้เป็นข้อความไทยตัวใหญ่สีทองว่า โปรโมชั่น ถัดลงมาเป็นแผ่นป้ายทองข้อความว่า แนะนำเพื่อน แล้วเป็นตัวเลขขนาดใหญ่ว่า โบนัส 0.8% ด้านซ้ายเป็นหญิงสาวผมยาวสีเข้มสวมชุดสูทขาว ชี้นิ้วชี้ทั้งสองข้างมาที่ข้อความ รอบภาพมีเหรียญทองและชิปคาสิโนสีดำขอบทองกระจายอยู่ พร้อมกล่องของขวัญผูกโบว์ทองที่มุมซ้าย"
          loading="lazy"
          fetchpriority="low"
          widths={[340, 480, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), 488px"
          class="mx-auto h-auto w-full rounded-xl border border-[#fdd32a]/55 object-contain shadow-[0_10px_30px_rgba(8,6,2,0.80)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ffe27a]/75 hover:shadow-[0_15px_40px_rgba(253,211,42,0.40)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่นชุดเดียวกัน พื้นดำสลับทอง ด้านซ้ายเป็นหญิงสาวผมยาวสีเข้มสวมชุดสูทขาว ยกมือชี้นิ้วไปทางข้อความ ด้านขวาบนเป็นโลโก้ PKG44 ตัวอักษรทองขลิบเงินโครเมียม ถัดลงมาเป็นข้อความไทยว่า โปรโมชั่น และแผ่นป้ายทองข้อความว่า คืนยอดเสีย แล้วเป็นตัวเลขขนาดใหญ่ว่า โบนัส 0.3% รอบภาพมีเหรียญทอง ชิปคาสิโนสีดำขอบทอง และกล่องของขวัญผูกโบว์ทองกระจายอยู่"
          loading="lazy"
          fetchpriority="low"
          widths={[340, 480, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), 488px"
          class="mx-auto h-auto w-full rounded-xl border border-[#c2c8d0]/45 object-contain shadow-[0_10px_30px_rgba(8,6,2,0.80)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f2f4f7]/70 hover:shadow-[0_15px_40px_rgba(194,200,208,0.28)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก PKG44"
          class="flex items-center justify-center rounded-lg border border-[#ffe27a]/60 bg-gradient-to-r from-[#ffeeb8] via-[#fdd32a] to-[#c8920a] px-10 py-3.5 text-lg font-black text-[#15110a] shadow-[0_0_15px_rgba(253,211,42,0.50)] transition-transform hover:scale-105">
          สมัครสมาชิก PKG44
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
