---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

// ดรอปรอบนี้ (2026-10-20, brand-spec §5) มีสไลด์ที่ใช้ได้ **สองใบ** และชื่อตัวแปร
// ตั้งตามข้อความที่พิมพ์อยู่บนภาพจริง (เปิดบิตแมปอ่านเองแล้วรอบนี้) ไม่ใช่ตามเลขไฟล์ —
// ถ้ารอบหน้าเจอความขัดแย้ง **ให้เชื่อข้อความบนรูป**:
//   slide2.png — โปสเตอร์ "โปรโมชั่น / คืนยอดเสีย 0.3%"
//   slide1.png — โปสเตอร์ "โปรโมชั่น / แนะนำเพื่อน 0.8%"
//   slide3.png / slide4.png (mtime 2026-09-29) — โปสเตอร์ของ LOTTOPLUS ซึ่งเป็น
//     แบรนด์คนละรายโดยสิ้นเชิง **ห้าม import**
// ⚠️ การจับคู่พลิกไปมาระหว่างดรอป (รอบ รวยแทร่168 เคยเป็น slide1 = คืนยอดเสีย)
// จึงห้ามเชื่อการจับคู่ของรอบก่อน ต้องเปิดบิตแมปดูทุกรอบ
// ⚠️ eager import = emit ลง dist/ ต่อให้ไม่ได้ render และ verify-build จะแดง
// การ import ไฟล์เก่าคือการส่งรูปของลูกค้ารายอื่นขึ้นเว็บนี้
// **ห้ามลบไฟล์เก่าทิ้ง** — เป็นอินเวนทอรีของรอบถัดไป แค่ห้าม import
// (banner2 / banner3 ก็เช่นกัน ส่วน banner1 / banner1-mobile / og.png เป็นของ glob
// ที่ MainLayout ปักชื่อไว้เอง — ห้ามอ้างจากหน้านี้) รอบนี้จึงไม่มี article illustration
import promoCashback from "../assets/slide2.png";
import promoReferral from "../assets/slide1.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้นๆ ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมด
// ของหน้านี้, กริดภาพโปรโมชั่น, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อยและห้ามเพิ่มย่อหน้า
// เพราะโปสเตอร์ระบุเปอร์เซ็นต์ของตัวเองด้วยตัวอักษรขนาดใหญ่อยู่แล้ว การพิมพ์ซ้ำ
// ด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ บรีฟรอบนี้ (src/assets/content.txt)
// ไม่มีส่วน SUB-PAGES เลย ย่อหน้าทุกย่อหน้าที่เคยอยู่บนหน้านี้จึงเป็นของที่รีแบรนด์
// รอบก่อนๆ แต่งขึ้นเอง — รอบนี้คงไว้เพียงย่อหน้าเกริ่นเดียว และเขียนขึ้นใหม่จากบรีฟ
// (content.txt บรรทัด 7-12) ไม่ใช่ find-and-replace ทับประโยคของรอบก่อน
//
// ลำดับในกริดตามลำดับของบรีฟ: คืนยอดเสีย 0.3% (บรรทัด 9-10) มาก่อน แนะนำเพื่อน 0.8%
// (บรรทัด 11-12) · บิตแมปจริง 600x200 ทั้งคู่ → widths หยุดที่ 600 และคุมที่ max-w-[600px]
// sizes คิดจากความกว้างที่ถูกวาดจริง: section px-4 (16px/ข้าง) + การ์ด p-8
// (32px/ข้าง, เป็น p-10 = 40px ที่ md ขึ้นไป) + gap-6 ระหว่างคอลัมน์ (24px)
//   ใต้ 640px = คอลัมน์เดียว → 100vw-96px
//   640-767px = สองคอลัมน์ p-8 → 50vw-60px
//   768-1335px = สองคอลัมน์ p-10 → 50vw-68px
//   ตั้งแต่ 1336px ขึ้นไปชนเพดาน 600px
// LCP คือ hero ใน MainLayout ไม่ใช่รูปพวกนี้ จึง loading="lazy" fetchpriority="low"
// decoding="async" และ quality ตัวเดียวทั้ง avif/webp — ห้ามจูนแยกฟอร์แมต
// (tools/avif-quality-service.mjs ย่อฝั่ง avif ให้เองที่ x0.65)
//
// quality={64} ไม่ใช่ 80 ตามปกติ และเป็นค่าที่ "วัดมา" ไม่ใช่ค่าที่ชอบ: สไลด์ทั้งสองเป็น
// อาร์ตที่มีเกรนละเอียดเยอะ (เหรียญทองร่วง ประกายดาว ชิปกลม แสงวูบวาบ) ซึ่งเป็นเคสที่
// AVIF ทำได้แย่ที่สุด ที่ quality=80 ไฟล์ AVIF ออกมา **ใหญ่กว่า** WebP ที่เป็น fallback
// ของตัวเองทุกความกว้างของทั้งสองรูป เบราว์เซอร์ที่รองรับ AVIF จะหยิบไฟล์ที่หนักกว่าไปใช้
// และ verify-build.mjs ทำให้ build แดงด้วยเหตุนี้ตรงๆ · ทางแก้คือ quality ที่
// **ต่ำลง** ไม่ใช่สูงขึ้น ค่าเดียวกันนี้ใช้ที่ index.astro กับสไลด์คู่เดียวกัน
//
// Announcement รอบนี้หมุนมาเป็น AnnouncementPremium ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ Announcement5 จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็น
// คอปปี้ของแบรนด์นี้ไว้แล้ว และทุกหน้าเรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop message
// มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกันระหว่างหน้า
//
// พาเลตต์รอบนี้ (brand-spec §2) = **ทองจักรพรรดินำ · แดงชาดรอง · บนพื้นดำสนิท**
// bg.json ของดรอปนี้คือ {"mode":"color","color":"#000000"}
// ลำดับผิว: #3b1b0e ยก (การ์ด ContentBox) / #260d04 กลาง / #0d0501 จม / #000000 พื้นเพจ
// ทองน้ำผึ้ง #f0bb4e เป็นฮิวนำ ถือขอบรูป ออรา พื้นถมปุ่ม และเป็นสีเดียวที่ <strong>
// ในเนื้อความใช้ได้ (สงวนไว้งานเดียวนี้) · ครีมทอง #ffeccb เป็นต้นสว่างของเกรเดียนต์
// และสี hover ของขอบ · **แดงชาด #e4021b ได้แค่ 3.2:1 บนผิวการ์ด = ตก AA ทุกพื้น**
// จึงเป็น **สีขอบ/พื้นถม/ไอคอนเท่านั้น ห้ามถือตัวอักษร** · ทองแดง #d9701a เป็นขอบ
// และเส้น (4.7:1 = งานตกแต่ง ไม่ใช่เนื้อความ) · หมึกบนพื้นถมทองคือ #2b1400 (9.9:1)
// เนื้อความ #fff8ec มาจาก BRAND_TEXT ที่ <html> และการ์ด ContentBox ตั้งให้แล้ว
// ย่อหน้าจึงไม่ประกาศสีของตัวเอง และไม่ใส่ mx-auto / max-w-* กับย่อหน้า
// · <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ
// ถ้าเปิด/ปิดกลางคำ บรรทัดจะตัดกลางคำ และ <strong> สองตัวห้ามติดกัน
// ⚠️ #5c2a06 และ #2b1400 ห้ามถือตัวอักษรบนพื้นเข้มทุกขนาด ใช้ได้เฉพาะเส้น ขอบ ออรา
// และพื้นถม · ออราในไฟล์นี้ใช้ rgba(240,187,78,α) · rgba(228,2,27,α) เท่านั้น
// ⚠️ กับดักรอบนี้คือ **ทอง** และ **แดง** พร้อมกัน เพราะ **ทองเคยนำมาแล้วเกือบทุกแบรนด์**
// และ **แดงเคยนำมาแล้วสี่แบรนด์** การเจอ "ทอง" หรือ "แดง" ในไฟล์นี้จึงไม่พิสูจน์อะไรเลย
// ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน brand-spec §2 (ค่าของแบรนด์เก่าไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive) และรอบนี้ **ไม่มีฟ้า/น้ำเงิน
// ไม่มีม่วง ไม่มีเขียว ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์ ไม่มีเหลืองมะนาว และไม่มี
// ชมพู/ฟูเชีย** ส้มตัวเดียวที่อนุญาตคือทองแดง #d9701a ซึ่งเป็นเฉดเงาของทอง
//
// ⚠️ บรีฟรอบนี้ระบุหมวดเกมไว้สี่หมวด (สล็อต · ยิงปลา · ไฮโล · หวยออนไลน์/แทงหวย)
// แกนของแบรนด์คือ **เกมสล็อต** และ **ไม่ใช่เว็บหวย** — /ตรวจหวย กับ /แนวทาง จอดอยู่
// ใน src/pages-disabled/ ไม่มี route ลิงก์ค้างจะเป็น href ตายที่ทำให้บิลด์แดง
// คำขายของแบรนด์ก่อนและศัพท์หมวดที่บรีฟไม่ได้เอ่ยห้ามหลงเหลือ (รายการเต็มอยู่ใน
// brand-spec §6 ไม่พิมพ์ซ้ำที่นี่เพื่อไม่ให้ grep เจอ false positive)
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกมแม้แต่ค่ายเดียว** จึงห้ามเขียนชื่อค่ายใดๆ
// ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% / 0.8% / 24ชม. / 3 ขั้นตอน — ห้ามแต่งยอดฝาก
// ขั้นต่ำ ชื่อธนาคาร ค่า RTP เลขใบอนุญาต จำนวนสมาชิก หรือปีก่อตั้ง และต้องคงประโยค
// กำกับของบรีฟไว้ว่า **ควรอ่านรายละเอียดจากประกาศล่าสุดก่อนเข้าร่วม**
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) หน้านี้ยาว 157 อักขระ
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `รวมภาพโปรโมชั่นของ ${BRAND_NAME} ไว้ในหน้าเดียว ทั้งคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% แต่ละรายการมีเงื่อนไขต่างกัน ควรอ่านรายละเอียดจากประกาศล่าสุดก่อนเข้าร่วม`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่น ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});

// ความกว้างที่ถูกวาดจริงของแต่ละคอลัมน์ในกริดสองคอลัมน์ (ดูคอมเมนต์ sizes ด้านบน)
const promoSizes = "(max-width: 639px) calc(100vw - 96px), (max-width: 767px) calc(50vw - 60px), (max-width: 1335px) calc(50vw - 68px), 600px";

const promoClass =
  "mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#f0bb4e]/55 object-contain shadow-[0_0_28px_rgba(240,187,78,0.3)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#e4021b]/85 hover:shadow-[0_0_40px_rgba(228,2,27,0.45)]";

// alt ทั้งสองเขียนจากบิตแมปของดรอปนี้ที่เปิดอ่านเองแล้ว (600x200 ทั้งคู่) — ฉากพื้นดำ
// มาสคอตเทพเจ้าแห่งโชคลาภจีน เหรียญทอง ชิปกลมแดง-ขาว และหญิงสาวผมบลอนด์เงินชุด
// แดง-ขาว ⚠️ **ไม่ใช่** ฉากพื้นขาว-ชมพูอ่อน หน้ายิ้มเหลืองทอง หรือชุดลูกไม้ขาว
// ซึ่งเป็นของแบรนด์รอบก่อน
const altCashback = `โปสเตอร์โปรโมชั่นพื้นดำ มุมบนซ้ายเป็นโลโก้ ${BRAND_NAME} คำว่า รวย ตัวอักษรไทยหนาสามมิติสีทอง ต่อด้วย เทพ สีขาวมุก และ 168 สีแดงชาดผิวมันวาว ข้างกันเป็นเทพเจ้าแห่งโชคลาภจีนหัวเราะสวมหมวกปีกทองแต่งแดง กลางภาพเป็นคำว่า โปรโมชั่น ตัวอักษรทองสามมิติตัดขอบแดง มีมงกุฎทองวางอยู่ด้านบน ถัดลงมาเป็นแถบโค้งสีแดงเข้มเขียนว่า คืนยอดเสีย ตัวอักษรขาว ต่อด้วยตัวเลข 0.3% สีทองตัวโต ด้านขวาเป็นหญิงสาวผมบลอนด์เงินปักปิ่นทอง สวมชุดแดง-ขาวประดับทองและสร้อยคอสีแดง ยื่นมือมาทางผู้ชม ริมขวาเป็นตู้สล็อตที่ขึ้นเลข 7 รอบภาพมีเหรียญทองร่วง หัวใจแดง และชิปกลมแดง-ขาวลอยอยู่`;

const altReferral = `โปสเตอร์โปรโมชั่นพื้นดำ มุมบนซ้ายเป็นโลโก้ ${BRAND_NAME} คำว่า รวย ตัวอักษรไทยหนาสามมิติสีทอง ต่อด้วย เทพ สีขาวมุก และ 168 สีแดงชาดผิวมันวาว ข้างกันเป็นเทพเจ้าแห่งโชคลาภจีนหัวเราะสวมหมวกปีกทองแต่งแดง กลางภาพเป็นคำว่า โปรโมชั่น ตัวอักษรทองสามมิติตัดขอบแดง มีมงกุฎทองวางอยู่ด้านบน ถัดลงมาเป็นแถบโค้งสีแดงเข้มที่มีโทรโข่งแดง-ทองอยู่ด้านซ้าย เขียนว่า แนะนำเพื่อน ตัวอักษรขาว ต่อด้วยตัวเลข 0.8% สีทองตัวโต ด้านขวาเป็นหญิงสาวผมบลอนด์เงินปักปิ่นทอง สวมชุดแดง-ขาวประดับทอง ขยิบตาและชี้นิ้วมาทางผู้ชม มุมขวาบนเป็นไพ่เอซโพแดง ถัดลงมาเป็นตู้สล็อต รอบภาพมีเหรียญทองร่วง หัวใจแดง และชิปกลมแดง-ขาวลอยอยู่`;
---

<MainLayout title={`โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน โบนัส 0.8%`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`รวมโปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} as="h1">
    <div class="flex flex-col gap-10">
      <p>
        หน้านี้รวมภาพประกาศโปรโมชั่นของ {BRAND_NAME} ไว้ในที่เดียว ทั้ง
        <strong class="text-[#f0bb4e]">รายการคืนยอดเสีย 0.3% เข้ายูสทุกวัน และโบนัสแนะนำเพื่อน 0.8% ไม่จำกัด</strong>
        โดยอัตราและรูปแบบการรับสิทธิ์ระบุไว้บนภาพด้านล่างแล้ว แต่ละรายการอาจมีเงื่อนไขเกี่ยวกับประเภทเกม ยอดที่ใช้คำนวณโบนัส รอบเวลารับเครดิต และข้อจำกัดในการใช้งานแตกต่างกัน
        <strong class="text-[#f0bb4e]">ควรอ่านรายละเอียดจากประกาศล่าสุดและตรวจสอบว่าโปรโมชั่นใดรับร่วมกันได้ก่อนเข้าร่วม</strong>
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt={altCashback}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />

        <Picture
          src={promoReferral}
          alt={altReferral}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#d9701a] bg-gradient-to-b from-[#ffeccb] to-[#f0bb4e] px-10 py-3.5 text-lg font-black text-[#2b1400] shadow-[0_0_14px_rgba(240,187,78,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
