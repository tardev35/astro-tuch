---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

// Only slide1/slide2 belong to BETPLAY369, and they are exactly the two
// promotions this page shows: slide1 is the "แนะนำเพื่อน 0.8%" poster, slide2
// is the "คืนยอดเสีย 0.3%" poster (checked against the artwork, not the
// filename). slide3/slide4 are still on disk but belong to previous clients —
// they may not be imported here, now or on any future rebrand (an unrendered
// import is still emitted into dist/).
import promoReferral from "../assets/slide1.png";
import promoCashback from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";

// This is an IMAGE page: the ContentBox title, ONE short intro paragraph, the
// poster grid, one CTA. No section headings, no extra prose — the posters
// already state every offer in large type.
//
// 150–160 CHARACTERS (not bytes — a byte count reads ~3x too long for Thai).
const pageDescription =
  "รวมโปรโมชั่น BETPLAY369 คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ดูเปอร์เซ็นต์โบนัส ยอดที่ใช้คำนวณ และเงื่อนไขการรับสิทธิ์ของแต่ละรายการได้จากภาพโปรโมชั่นในหน้านี้";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น BETPLAY369 คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8%",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoReferral.src,
});
---

<MainLayout title="โปรโมชั่น BETPLAY369 คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น BETPLAY369" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#dfd0ee]">
        หน้านี้รวมโปรโมชั่นที่ BETPLAY369 เปิดให้สมาชิกกดรับอยู่ในขณะนี้ ทั้งโบนัสคืนยอดเสีย <strong class="text-[#ffd54a]">0.3%</strong>
        และโบนัสแนะนำเพื่อน <strong class="text-[#ffd54a]">0.8%</strong> เปอร์เซ็นต์โบนัส ยอดที่นำมาคำนวณ และรอบเวลาการรับสิทธิ์ระบุไว้บนภาพโปรโมชั่นแต่ละใบ
        และเงื่อนไขของแต่ละรายการไม่เหมือนกัน สมาชิกตรวจสอบสิทธิ์และกดรับโบนัสได้จากบัญชีของตนเอง หรือสอบถามแอดมินผ่าน LINE Official ก่อนตัดสินใจเข้าร่วม
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่นนีออนพื้นหลังคาสิโนสีดำ มุมบนกลางเป็นโลโก้ BETPLAY369 มีป้ายมงกุฎทองคำคำว่า CASINO วงล้อรูเล็ตและกองชิปที่มุมล่างซ้าย ไพ่กระจายอยู่ด้านหน้า และนางแบบยิ้มในชุดสีดำตัดนีออนอยู่ด้านขวา กลางภาพเขียนว่า โปรโมชั่น แนะนำเพื่อน 0.8% โดยตัวเลข 0.8% เป็นนีออนสีทอง"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#6d1750]/70 object-contain shadow-[0_10px_30px_rgba(229,57,159,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ff35b4]/70 hover:shadow-[0_15px_40px_rgba(229,57,159,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่นนีออนพื้นหลังคาสิโนสีดำ มุมบนกลางเป็นโลโก้ BETPLAY369 มีไพ่เอซสองใบที่มุมบนซ้าย วงล้อรูเล็ตและชิปนีออนที่มุมล่างซ้าย สัญลักษณ์โพดำ และนางแบบในชุดสีดำตัดนีออนอยู่ด้านขวา กลางภาพเขียนว่า โปรโมชั่น คืนยอดเสีย 0.3% โดยตัวเลข 0.3% เป็นนีออนสีทอง"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#6d1750]/70 object-contain shadow-[0_10px_30px_rgba(229,57,159,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ff35b4]/70 hover:shadow-[0_15px_40px_rgba(229,57,159,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#ff35b4]/70 bg-gradient-to-r from-[#ff35b4] via-[#e5399f] to-[#6d1750] px-10 py-3.5 text-lg font-black text-[#f4ebff] shadow-[0_0_15px_rgba(229,57,159,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก BETPLAY369
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
