---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

// ดรอปอาร์ตเวิร์กของ หวยเฮง24 คือ 2026-10-01 01:57 และมีโปสเตอร์ที่ใช้ได้แค่สองใบ
// (brand-spec §5) — เปิดไฟล์จริงดูแล้วทั้งคู่:
//   slide1.png — 600x400 พื้นผ้าซาตินแดง ป้ายใต้หัวเรื่องอ่านว่า "2ตัวจ่าย100บาท"
//                หญิงสาวชุดไทยขาว-ทอง แบมือขวา ลูกหวยขาวเลข 5 และ 9 ริมซ้าย
//   slide2.png — 600x400 ชุดเดียวกัน ป้ายอ่านว่า "3ตัวจ่าย1,000บาท"
//                หญิงสาวชุดไทยขาว-ทอง ถือลูกหวยแดงเลข 3
//   slide3.png / slide4.png — โปสเตอร์ของแบรนด์ก่อน (29 ก.ย. เก่ากว่าดรอปนี้)
//     ห้าม import กลับมาเด็ดขาด และห้ามลบไฟล์ทิ้งเพราะเป็นอินเวนทอรีของรอบถัดไป
// ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้วและ verify-build จะแดง
// (banner2/banner3 ใน src/assets ก็เก่ากว่าดรอปนี้ = อาร์ตเวิร์กแบรนด์ก่อน ห้าม import)
import promoTwoDigit from "../assets/slide1.png";
import promoThreeDigit from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";
//
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ: ContentBox title, ย่อหน้าเกริ่นสั้น ๆ หนึ่งย่อหน้า
// (ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมดของหน้านี้), กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม
// — ไม่มีหัวข้อย่อยและไม่มีย่อหน้าเพิ่ม เพราะตัวโปสเตอร์ระบุอัตราจ่ายไว้ด้วยตัวอักษร
// ขนาดใหญ่อยู่แล้ว เป้าหมาย h1x1, h2x0, h3x0
//
// สไลด์รอบนี้เป็นแนวนอน 600x400 จึงวางเป็นกริดสองคอลัมน์คุมความกว้างรวมที่ max-w-4xl
// (896px) ทำให้ช่องละ ~436px ไม่ต้องอัปสเกลเกินขนาดไฟล์ต้นทาง widths หยุดที่ 600 ตาม
// ความกว้างจริงของไฟล์ และคุมภาพต่อใบไว้ที่ max-w-[600px] สองใบพอดีหนึ่งแถว กริดจึง
// จัดกลางสมมาตรโดยไม่ต้องมีใบที่ span สองคอลัมน์ · เรียง 2 ตัว ก่อน 3 ตัว ตามบรีฟ
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ (รอบก่อน หวยเต็ง ใช้ Announcement3)
// — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ หวยเฮง24 แล้ว และ index
// ก็เรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop message มิฉะนั้นตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ หวยเฮง24 (แดงเข้ม + ทอง ตามโลโก้ที่คำว่า "หวย" เป็นแดงเลือดนกเงาวาวขอบทอง
// และ "เฮง24" เป็นทองไล่เฉด บนแบนเนอร์ฉากผ้าซาตินแดงที่มีเงาปราสาททอง เหรียญทอง
// และลูกหวยแดง-ขาว): พื้นเพจ #1a0505 · การ์ด #2e0707 · ผิวยก #3d0808 ·
// แดงเข้ม #5a0202 · แดงกลาง #720202 · แดงแบรนด์ #8b0302 · แดงสว่าง #c01616 ·
// ทองเข้ม #7a4a02 · ทองมืด #a46304 · ทองกลาง #bd7c13 · ทองแบรนด์ #e0a52a ·
// ทองสว่าง #fbdc64 · ทองอ่อน #fdea83 · เนื้อความ #f6e6cf (BRAND_TEXT) ·
// หมึกบนพื้นทอง #2a0606
// เรืองแสง: ทอง rgba(224,165,42,0.40) · แดง rgba(192,22,22,0.35) · เงา rgba(20,3,3,0.85)
// การ์ดโปสเตอร์ได้ขอบทองทั้งสองใบเพราะตัวเลขอัตราจ่ายบนภาพทั้งคู่เป็นตัวอักษรทอง
// ปุ่ม CTA เป็นไล่เฉดทอง #fdea83 → #fbdc64 → #bd7c13 และใช้หมึกเข้ม #2a0606
// (ครีมบนพื้นทอง #e0a52a ตก AA จึงต้องใช้หมึกเข้ม)
// ชุดเขียวป่า-ทองของ หวยเต็ง (#03150a #062a12 #0b3d18 #024a0f #026314 #0bb42f
// #e5c04f #fae474 #bd8d2d #d8ead9 #0a1a0c rgba(229,192,79,*) rgba(2,99,20,*))
// ถูกแทนครบทุกจุดแล้ว ทั้งคลาส Tailwind raw hex และ rgba()
//
// หวยเฮง24 เป็นเว็บ "เล่นหวยออนไลน์" ไม่ใช่สล็อต ไม่ใช่บอล และไม่ใช่คาสิโน — คำว่า
// สล็อต ฟรีสปิน ตัวคูณ ค่ายเกม RTP แตกง่าย เว็บตรง บอล ค่าน้ำ อัตราต่อรอง ลีก
// บิลสเต็ป แฮนดิแคป คาสิโน บาคาร่า ห้ามปรากฏบนหน้านี้ ตัวเลขที่บรีฟระบุและใช้ได้
// มีแค่ 2 ตัว จ่าย 100 บาท · 3 ตัว จ่าย 1,000 บาท · 3 ขั้นตอน · 24 ชั่วโมง
// ห้ามเพิ่มชื่อผู้ให้บริการ ชื่อธนาคาร ยอดฝากขั้นต่ำ เลขใบอนุญาต จำนวนสมาชิก หรือ
// ปีที่ก่อตั้ง และต้องคง hedge ของบรีฟไว้ว่าอัตราจ่ายขึ้นอยู่กับประเภทหวยและรูปแบบ
// การแทงที่เข้าเงื่อนไข จึงควรตรวจสอบอัตราที่แสดงในหน้าส่งโพยก่อนยืนยัน
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 159
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "รวมภาพอัตราจ่ายของ หวยเฮง24 ทั้งแบบ 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท อัตราขึ้นอยู่กับประเภทหวยและรูปแบบการแทง ควรตรวจสอบตัวเลขในหน้าส่งโพยก่อนยืนยัน";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่นอัตราจ่ายหวย หวยเฮง24",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoTwoDigit.src,
});
---

<MainLayout title="โปรโมชั่นอัตราจ่ายหวย หวยเฮง24 2 ตัว จ่าย 100 บาท 3 ตัว จ่าย 1,000 บาท" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่นอัตราจ่ายหวย หวยเฮง24" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#f6e6cf]">
        หน้านี้รวมภาพอัตราจ่ายที่ <strong class="text-[#fdea83]">หวยเฮง24</strong> เปิดให้สมาชิกดูรายละเอียดก่อนเลือกรายการและส่งโพย โดยตัวเลขของแต่ละแบบระบุไว้บนภาพด้านล่างแล้ว
        <strong class="text-[#fdea83]">อัตราจ่ายขึ้นอยู่กับประเภทหวยและรูปแบบการแทงที่เข้าเงื่อนไข</strong> จึงควรตรวจสอบอัตราที่แสดงในหน้าส่งโพยของแต่ละรอบก่อนยืนยันทุกครั้ง
      </p>

      <div class="mx-auto grid w-full max-w-4xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoTwoDigit}
          alt="โปสเตอร์อัตราจ่ายหวยของ หวยเฮง24 พื้นผ้าซาตินสีแดงเข้มมีลายไทยสีทองและริ้วแสงทองพาดทั่วภาพ ด้านซ้ายเป็นหญิงสาวผมเกล้าสวมชุดไทยสีขาวประดับทอง สวมสร้อยและกำไลทอง ยิ้มพร้อมแบมือขวาออกมาเชิญชวน มีลูกหวยสีขาวหมายเลข 5 และ 9 ลอยอยู่ริมซ้าย ด้านขวาบนเป็นโลโก้ หวยเฮง24 ตัวอักษรแดงคู่ทอง ถัดลงมาเป็นตัวอักษรไทยสีทองขนาดใหญ่ว่า อัตราจ่ายหวย ในกรอบแดงขอบทอง ใต้ลงไปเป็นป้ายขอบทองคาดข้อความ 2ตัวจ่าย100บาท และมุมขวาล่างมีลูกหวยทองหมายเลข 24 กับ 6 วางอยู่บนกองเหรียญทอง"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), (max-width: 1007px) calc((100vw - 136px) / 2), 436px"
          class="mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#e0a52a]/60 object-contain shadow-[0_10px_30px_rgba(20,3,3,0.85)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fdea83]/85 hover:shadow-[0_15px_40px_rgba(224,165,42,0.40)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoThreeDigit}
          alt="โปสเตอร์อัตราจ่ายหวยของ หวยเฮง24 ชุดเดียวกัน พื้นผ้าซาตินสีแดงเข้มมีริ้วแสงทอง กองเหรียญทองและสลากกินแบ่งวางเรียงอยู่ด้านล่าง ด้านซ้ายเป็นหญิงสาวผมยาวสวมชุดไทยสีขาวประดับทอง ถือลูกหวยสีแดงหมายเลข 3 ไว้ในมือซ้ายและยื่นมือขวาออกมาข้างหน้า มีลูกหวยสีแดงหมายเลข 6 และ 9 อยู่ด้านบน ด้านขวาบนเป็นโลโก้ หวยเฮง24 ตัวอักษรแดงคู่ทอง ถัดลงมาเป็นตัวอักษรไทยสีทองขนาดใหญ่ว่า อัตราจ่ายหวย ในกรอบแดงขอบทอง ใต้ลงไปเป็นป้ายขอบทองคาดข้อความ 3ตัวจ่าย1,000บาท และมุมขวาล่างเป็นลูกหวยสีแดงหมายเลข 5"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), (max-width: 1007px) calc((100vw - 136px) / 2), 436px"
          class="mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#e0a52a]/60 object-contain shadow-[0_10px_30px_rgba(20,3,3,0.85)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fdea83]/85 hover:shadow-[0_15px_40px_rgba(224,165,42,0.40)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก หวยเฮง24"
          class="flex items-center justify-center rounded-lg border border-[#e0a52a]/70 bg-gradient-to-r from-[#fdea83] via-[#fbdc64] to-[#bd7c13] px-10 py-3.5 text-lg font-black text-[#2a0606] shadow-[0_0_15px_rgba(224,165,42,0.40)] transition-transform hover:scale-105">
          สมัครสมาชิก หวยเฮง24
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
