---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";

import { Picture } from "astro:assets";

// ดรอปรอบนี้ (รวย168 2026-10-23, brand-spec §1) มีสไลด์ที่ใช้ได้ **สองใบ** และชื่อ
// ตัวแปรตั้งตามข้อความที่พิมพ์อยู่บนภาพจริง (เปิดบิตแมปอ่านเองแล้วรอบนี้) ไม่ใช่ตาม
// เลขไฟล์ — ถ้ารอบหน้าเจอความขัดแย้ง **ให้เชื่อข้อความบนรูป**:
//   slide2.png (mtime 2026-10-23, ดรอปนี้) — โปสเตอร์ "โปรโมชั่น / คืนยอดเสีย 0.3%"
//   slide1.png (mtime 2026-10-23, ดรอปนี้) — โปสเตอร์ "โปรโมชั่น / แนะนำเพื่อน 0.8%"
//   slide3.png / slide4.png (mtime 2026-09-29 = คนละดรอป) — โปสเตอร์ของแบรนด์
//     คนละราย **ห้าม import** (ถอดออกไปหลายรอบแล้ว อย่าดึงกลับ)
// ⚠️ การจับคู่พลิกไปมาระหว่างดรอป เพราะ uploader เขียนทับ slide1/slide2 ทุกครั้ง
// เลขไฟล์จึงไม่มีความหมายข้ามแบรนด์ ต้องเปิดบิตแมปดูทุกรอบ
// ⚠️ eager import = emit ลง dist/ ต่อให้ไม่ได้ render และ verify-build จะแดง
// การ import ไฟล์เก่าคือการส่งรูปของลูกค้ารายอื่นขึ้นเว็บนี้
// **ห้ามลบไฟล์เก่าทิ้ง** — เป็นอินเวนทอรีของรอบถัดไป แค่ห้าม import
// (banner2 / banner3 ของรอบนี้เป็นรูปประกอบบทความของ index.astro ส่วน banner1 /
// banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักชื่อไว้เอง —
// ห้ามอ้างจากหน้านี้) รอบนี้หน้านี้จึงมีเฉพาะสไลด์สองใบ
import promoCashback from "../assets/slide2.png";
import promoReferral from "../assets/slide1.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้นๆ ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมด
// ของหน้านี้, กริดภาพโปรโมชั่น, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อยและห้ามเพิ่มย่อหน้า
// เพราะโปสเตอร์ระบุเปอร์เซ็นต์ของตัวเองด้วยตัวอักษรขนาดใหญ่อยู่แล้ว การพิมพ์ซ้ำ
// ด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ บรีฟรอบนี้ (src/assets/content.txt)
// ไม่มีส่วน SUB-PAGES เลย (จบที่บรรทัด 27) ย่อหน้าทุกย่อหน้าที่เคยอยู่บนหน้านี้จึงเป็น
// ของที่รีแบรนด์รอบก่อนๆ แต่งขึ้นเอง — รอบนี้คงไว้เพียงย่อหน้าเกริ่นเดียว และเขียนขึ้น
// ใหม่จากบรีฟ (content.txt บรรทัด 11-16) ไม่ใช่ find-and-replace ทับประโยคของรอบก่อน
//
// ลำดับในกริดตามลำดับของบรีฟ: คืนยอดเสีย 0.3% (บรรทัด 13-14) มาก่อน
// แนะนำเพื่อน 0.8% (บรรทัด 15-16) → promoCashback (slide2) อยู่ช่องแรก
// ⚠️⚠️ **บิตแมปจริงของดรอปนี้คือ 375x600 แนวตั้ง** (วัดจาก IHDR ของไฟล์เองรอบนี้)
// ความกว้างสูงสุดคือ 375 widths จึงหยุดที่ 375 และคุมที่ max-w-[375px]
// **ให้วัดใหม่ทุกรอบจากไฟล์จริง อย่าเชื่อสัดส่วนของรอบก่อน**
// sizes คิดจากความกว้างที่ถูกวาดจริง: section px-4 (16px/ข้าง) + การ์ด p-8
// (32px/ข้าง, เป็น p-10 = 40px ที่ md ขึ้นไป) + gap-6 ระหว่างคอลัมน์ (24px)
//   ใต้ 640px = คอลัมน์เดียว → 100vw-96px
//   640-767px = สองคอลัมน์ p-8 → 50vw-60px
//   768-885px = สองคอลัมน์ p-10 → 50vw-68px
//   ตั้งแต่ 886px ขึ้นไปชนเพดาน 375px (การ์ดเองกว้างสุด 1400px จึงยังไม่ชน
//   เพดานของการ์ดก่อน)
// LCP คือ hero ใน MainLayout ไม่ใช่รูปพวกนี้ จึง loading="lazy" fetchpriority="low"
// decoding="async" และ quality ตัวเดียวทั้ง avif/webp — ห้ามจูนแยกฟอร์แมต
// (tools/avif-quality-service.mjs ย่อฝั่ง avif ให้เองที่ x0.65)
//
// quality={64} ไม่ใช่ 80 ตามปกติ: สไลด์ทั้งสองเป็นภาพถ่ายคนในสตูดิโอพื้นดำสนิท มีแผง
// โลหะแนวตั้งสะท้อนแสงเป็นฉากหลัง บวกตัวอักษรไทยสามมิติผิวมันเงาทอง-โครเมียมที่มี
// ไฮไลต์และขอบคมทับอยู่ด้านบน ซึ่งเป็นเคสที่ AVIF ทำได้แย่ที่สุด ที่ quality=80
// ไฟล์ AVIF มีโอกาสออกมา **ใหญ่กว่า** WebP ที่เป็น fallback ของตัวเอง เบราว์เซอร์ที่
// รองรับ AVIF จะหยิบไฟล์ที่หนักกว่าไปใช้ และ verify-build.mjs ทำให้ build แดงด้วย
// เหตุนี้ตรงๆ · ทางแก้คือ quality ที่ **ต่ำลง** ไม่ใช่สูงขึ้น · ค่าเดียวกันนี้ต้องใช้ที่
// index.astro กับสไลด์คู่เดียวกัน
//
// Announcement รอบนี้หมุนมาเป็น AnnouncementHuay ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ AnnouncementPremium จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้น
// เป็นคอปปี้ของแบรนด์นี้ไว้แล้ว และทุกหน้าเรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop
// message มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกันระหว่างหน้า
//
// ───────────────────────────────────────────────────────────────────────────
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) **ยังเป็นธีมมืดเหมือนรอบก่อน แต่คนละฮิวสิ้นเชิง**
// bg.json ของดรอปนี้คือ {"mode":"color","color":"#000000"} = **ดำสนิท**
// (รอบก่อนเป็น 00091f = น้ำเงินเที่ยงคืน ไม่ใช่ดำสนิท — อ่านจากไฟล์ทุกรอบ ห้ามเดา)
// **ห้าม "แก้" กลับไปเป็นการ์ดพื้นสว่าง**
// ลำดับผิว: พื้นเพจ #000000 / ผิวจม #070707 / ผิวการ์ด #121110 (ContentBox) /
// ผิวยก #1c1a16 · เส้นขอบ #3d3425 (**ห้ามถือตัวอักษร**)
// หมึก #f3ece0 = เนื้อความ (= BRAND_TEXT ที่ <html> และการ์ด ContentBox ตั้งให้แล้ว
// ย่อหน้าจึงไม่ประกาศสีของตัวเอง 16.0:1 บนผิวการ์ด) · หมึกรอง #bfb8aa ·
// แพลทินัม #dde1e7
// ทอง #ffd94a = สีของ <strong> ในเนื้อความ (13.8:1 บนการ์ด) และขอบ hover ของรูป
// ⚠️⚠️ **#e3a712 #b07d08 #9d6f06 #3d3425 #b4b9c2 #6b7079 ห้ามถือตัวอักษร**
// เป็นพื้นถม/ขอบ/ออราเท่านั้น · ที่ถือตัวอักษรได้บนผิวมืดชุดนี้คือ #ffd94a (13.8:1) ·
// #f3ece0 (16.0:1) · #bfb8aa (9.6:1) · #dde1e7 (13.5:1) · #e8eaee (16.0:1)
// ปุ่ม CTA ของหน้านี้เป็น **PRIMARY = ไล่เฉดทอง** #ffd94a → #e3a712 → #b07d08 บน
// หมึก **ดำ #0a0a0a** (14.6 / 9.2 / 5.4:1) ตรงกับปุ่มสมัครสมาชิกที่ /contact-us
// /ทางเข้า /register
// 🚨🚨 **ขาวบนทองได้แค่ ~1.2–2.2:1 — ห้ามวางหมึกขาวบนพื้นทองเด็ดขาด** และ
// **ห้ามจบไล่เฉดที่ #9d6f06** (4.5:1 กับหมึกดำ) ค่านั้นสงวนไว้ให้ขอบ/ออราเท่านั้น
// rgba() ที่อนุญาตรอบนี้: rgba(255,217,74,α) · rgba(227,167,18,α) ·
// rgba(176,125,8,α) · rgba(232,234,238,α) · rgba(221,225,231,α) · rgba(0,0,0,α)
// ⚠️⚠️ **รอบนี้ไม่มีแดง ไม่มีชมพู ไม่มีน้ำเงิน/ฟ้า ไม่มีม่วง ไม่มีส้ม ไม่มีเขียว
// (ยกเว้น LINE green ที่หน้าอื่น) ไม่มีครีม ไม่มีพีช ไม่มีน้ำตาลกาแฟ**
// แดงคือฮิวนำของแบรนด์ขาออก (ชื่ออยู่ใน brand-spec §0) การปล่อยแดงไว้ = ทั้งผิดพาเลตและหลงเหลือ
// ข้ามแบรนด์พร้อมกัน · ลิปสติกแดง ผมขาวเงิน สูทดำ และสีผิวนักแสดงในอาร์ตเวิร์กเป็น
// **วัตถุในภาพ ไม่ใช่สี UI**
// · <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ
// ถ้าเปิด/ปิดกลางคำ บรรทัดจะตัดกลางคำ และ <strong> สองตัวห้ามติดกัน
// ⚠️ กับดักรอบนี้คือ **ทอง/เหลืองเคยนำมาแล้วเกือบทุกแบรนด์ในรีโปนี้** การเจอ "ทอง"
// ในไฟล์นี้จึงไม่พิสูจน์อะไรเลย ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน brand-spec §2
// (ค่าของแบรนด์เก่าไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive)
//
// ⚠️ แกนของแบรนด์รอบนี้คือ **เว็บหวยออนไลน์** (รัฐบาลไทย ลาว ฮานอย ออมสิน) ไม่ใช่
// หมวดของรอบก่อน — คำนิยามตัวเองของรอบก่อนทุกคำห้ามเหลือ (brand-spec §5)
// รายการคำที่ห้ามใช้อยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่
// สองหน้าหมวดลอตเตอรี (/ตรวจหวย และ /แนวทาง) **เปิดอยู่รอบนี้** แต่หน้านี้ไม่มีเหตุ
// ต้องลิงก์ไป โควตาปุ่มของหน้านี้คือปุ่มเดียว
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ บาทละ 1,000 · 2 ตัว 100 · 3 ตัว 1,000 ·
// 0.3% · 0.8% · 24ชม. **ไม่มีจำนวนขั้นตอน ไม่มีจำนวนงวด ไม่มีเปอร์เซ็นต์อื่น**
// ห้ามแต่งตัวเลขการเงิน ชื่อธนาคาร เลขใบอนุญาต ปีก่อตั้ง หรือจำนวนสมาชิก
// และต้องคงประโยคกำกับของบรีฟไว้ว่า **แต่ละรายการอาจกำหนดประเภทหวยที่เข้าร่วม
// ยอดที่นำมาคำนวณ และรอบเวลารับเครดิตแตกต่างกัน จึงควรตรวจสอบเงื่อนไขก่อนรับสิทธิ์**
// (content.txt บรรทัด 12)
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) หน้านี้ยาว 158 อักขระด้วยชื่อแบรนด์ 6 ตัวของรอบนี้
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `โปรโมชั่น ${BRAND_NAME} รวมภาพสิทธิพิเศษสมาชิกแทงหวยไว้ที่เดียว ทั้งคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% แต่ละรายการมีเงื่อนไขต่างกัน ควรอ่านประกาศล่าสุดก่อนรับเครดิต`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่น ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});

// ความกว้างที่ถูกวาดจริงของแต่ละคอลัมน์ในกริดสองคอลัมน์ (ดูคอมเมนต์ sizes ด้านบน)
const promoSizes = "(max-width: 639px) calc(100vw - 96px), (max-width: 767px) calc(50vw - 60px), (max-width: 885px) calc(50vw - 68px), 375px";

const promoClass =
  "mx-auto h-auto w-full max-w-[375px] rounded-xl border border-[#3d3425] object-contain shadow-[0_8px_28px_rgba(0,0,0,0.7)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ffd94a] hover:shadow-[0_12px_40px_rgba(227,167,18,0.3)]";

// alt ทั้งสองเขียนจากบิตแมปของดรอปนี้ที่เปิดอ่านเองแล้ว (**375x600 แนวตั้ง** ทั้งคู่) —
// ฉากสตูดิโอพื้นดำสนิท มีแผงโลหะแนวตั้งสะท้อนแสงเป็นฉากหลัง ผู้หญิงผมสั้นดัดลอน
// สีขาวเงิน ทาลิปสติกแดง ทาเล็บแดง สวมสูทสีดำทับเสื้อรัดรูปสีดำ · โลโก้มุมบนซ้าย
// (ทั้งสองใบ) · ตัวอักษรไทยสามมิติทอง-โครเมียมว่า โปรโมชั่น · แคปซูลทองระบุชื่อ
// รายการ · ตัวเลขเปอร์เซ็นต์ตัวโตสีทอง
// ⚠️ alt คือ "ข้อความที่พิมพ์อยู่บนโปสเตอร์" เป็นหลัก — ตัวเลขท้าย alt ต้องตรงกับรูป
// ⚠️ ห้ามเรียกรูปคู่นี้ว่าภาพแนวนอนหรือภาพสี่เหลี่ยมจัตุรัส รอบนี้เป็น **แนวตั้ง**
// ⚠️ จุดที่ **ต่างกันจริงระหว่างสองใบ** และต้องเขียนให้ตรง: slide2 (คืนยอดเสีย)
// นักแสดงก้มมองมือถือที่ถือด้วยมือขวา ไม่ได้มองกล้อง · slide1 (แนะนำเพื่อน)
// นักแสดงยิ้มมองกล้อง ยกมือถือที่มีโลโก้อยู่บนจอด้วยมือซ้าย แล้วชี้ไปที่จอด้วย
// นิ้วชี้มือขวา
// ⚠️ **โลโก้อยู่มุมบนซ้ายทั้งสองใบ** — รอบก่อนคอมเมนต์ไว้ว่าใบหนึ่งอยู่มุมขวา
// ซึ่งเป็นของอาร์ตเวิร์กคนละดรอป เปิดดูเองทุกรอบ
// ⚠️ สีของวัตถุในรูป (ผมขาวเงิน ลิปสติกแดง เล็บแดง สูทดำ) เป็นวัตถุในภาพ ไม่ใช่สีของ
// แบรนด์ และไม่เข้ามาใน UI
// ⚠️ องค์ประกอบของอาร์ตเวิร์กแบรนด์ก่อนๆ ที่ต้องไม่หลงเหลือใน alt อยู่ครบใน
// brand-spec §1 (ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive)
const altCashback = `โปสเตอร์โปรโมชั่นแนวตั้ง ฉากสตูดิโอพื้นดำสนิทมีแผงโลหะแนวตั้งสะท้อนแสงอยู่ด้านหลัง มุมซ้ายบนเป็นโลโก้ของ ${BRAND_NAME} กลางภาพเป็นผู้หญิงผมสั้นดัดลอนสีขาวเงิน ทาลิปสติกแดงและเล็บแดง สวมสูทสีดำทับเสื้อรัดรูปสีดำคาดเข็มขัด กำลังก้มมองมือถือที่ถือด้วยมือขวา ครึ่งล่างเป็นตัวอักษรไทยสามมิติตัวโตผิวทองตัดขอบโครเมียมอ่านว่า โปรโมชั่น ใต้ลงมาเป็นแคปซูลมนสีทองเขียนว่า คืนยอดเสีย ต่อท้ายด้วยตัวเลข 0.3% ตัวโตสีทอง`;

const altReferral = `โปสเตอร์โปรโมชั่นแนวตั้ง ฉากสตูดิโอพื้นดำสนิทมีแผงโลหะแนวตั้งสะท้อนแสงอยู่ด้านหลัง มุมซ้ายบนเป็นโลโก้ของ ${BRAND_NAME} กลางภาพเป็นผู้หญิงผมสั้นดัดลอนสีขาวเงิน ยิ้มมองกล้อง ทาลิปสติกแดงและเล็บแดง สวมสูทสีดำทับเสื้อรัดรูปสีดำ ยกมือถือที่มีโลโก้อยู่บนจอด้วยมือซ้ายแล้วชี้ไปที่จอด้วยนิ้วชี้มือขวา ครึ่งล่างเป็นตัวอักษรไทยสามมิติตัวโตผิวทองตัดขอบโครเมียมอ่านว่า โปรโมชั่น ใต้ลงมาเป็นแคปซูลมนสีทองเขียนว่า แนะนำเพื่อน ต่อท้ายด้วยตัวเลข 0.8% ตัวโตสีทอง`;
---

<MainLayout title={`โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน โบนัส 0.8%`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`รวมโปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} as="h1">
    <div class="flex flex-col gap-10">
      <p>
        หน้านี้รวมภาพโปรโมชั่นสำหรับสมาชิกแทงหวยของ {BRAND_NAME} ไว้ในที่เดียว ทั้ง
        <strong class="text-[#ffd94a]">รายการคืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน และโบนัสแนะนำเพื่อน 0.8%</strong>
        โดยอัตราและชื่อรายการระบุไว้บนภาพด้านล่างแล้ว
        <strong class="text-[#ffd94a]">แต่ละรายการอาจกำหนดประเภทหวยที่เข้าร่วม ยอดที่นำมาคำนวณ และรอบเวลารับเครดิตแตกต่างกัน จึงควรตรวจสอบเงื่อนไขจากประกาศล่าสุดก่อนรับสิทธิ์ทุกครั้ง</strong>
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt={altCashback}
          loading="lazy"
          fetchpriority="low"
          widths={[250, 375]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />

        <Picture
          src={promoReferral}
          alt={altReferral}
          loading="lazy"
          fetchpriority="low"
          widths={[250, 375]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="relative isolate flex items-center justify-center overflow-hidden rounded-lg border border-[#9d6f06] bg-gradient-to-b from-[#ffd94a] via-[#e3a712] to-[#b07d08] px-10 py-3.5 text-lg font-black text-[#0a0a0a] shadow-[0_8px_22px_rgba(227,167,18,0.4)] transition-transform hover:scale-105">
          <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#dde1e7]/25 to-transparent"></span>
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
