---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

// ดรอปอาร์ตเวิร์กของ DM899 คือ 2026-10-03 และมีโปสเตอร์ที่ใช้ได้แค่สองใบ
// (brand-spec §5 Image roles) — เปิดไฟล์จริงดูแล้วทั้งคู่ ขนาด 600x600 ทั้งคู่
// (ห้ามเดาจากชื่อไฟล์ และห้ามเชื่อคอมเมนต์ของรอบก่อน ต้องเปิดดูทุกครั้ง):
//   slide1.png — ป้ายดำขอบทองใต้คำว่า โปรโมชั่น อ่านว่า "แนะนำเพื่อน โบนัส 0.8%"
//   slide2.png — ใต้คำว่า โปรโมชั่น อ่านว่า "คืนยอดเสีย โบนัส" แล้วเลข 0.3% ตัวแดง
//   slide3.png / slide4.png — โปสเตอร์ของแบรนด์ก่อน (29 ก.ย. เก่ากว่าดรอปนี้)
//     ห้าม import กลับมาเด็ดขาด และห้ามลบไฟล์ทิ้งเพราะเป็นอินเวนทอรีของรอบถัดไป
// ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้วและ verify-build จะแดง
// (banner2/banner3 ใน src/assets ก็เก่ากว่าดรอปนี้ = อาร์ตเวิร์กแบรนด์ก่อน ห้าม import)
// ส่วน banner1 / banner1-mobile / og.png เป็นของ MainLayout ห้าม import จากหน้านี้
// ชื่อตัวแปรตั้งตามข้อความบนภาพ ไม่ใช่ตามเลขไฟล์ เพื่อไม่ให้รอบหน้าสลับผิดอีก
import promoCashback from "../assets/slide2.png";
import promoReferral from "../assets/slide1.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้น ๆ "หนึ่งย่อหน้า ประมาณสี่บรรทัด" คือ
// โควตาตัวหนังสือทั้งหมดของหน้านี้, กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อย
// และห้ามเพิ่มย่อหน้า เพราะตัวโปสเตอร์ระบุชื่อโปรและเปอร์เซ็นต์ไว้ด้วยตัวอักษรขนาดใหญ่
// อยู่แล้ว การพิมพ์ซ้ำด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ เป้าหมาย h1x1 h2x0 h3x0
//
// สไลด์รอบนี้เป็น 600x600 จึงวางเป็นกริดสองคอลัมน์คุมความกว้างรวมที่ max-w-4xl
// (896px) ทำให้ช่องละ ~436px ไม่ต้องอัปสเกลเกินขนาดไฟล์ต้นทาง widths หยุดที่ 600 ตาม
// ความกว้างจริงของไฟล์ และคุมภาพต่อใบไว้ที่ max-w-[600px] สองใบพอดีหนึ่งแถว กริดจึง
// จัดกลางสมมาตรโดยไม่ต้องมีใบที่ span สองคอลัมน์ · เรียงคืนยอดเสีย 0.3% ก่อนแนะนำเพื่อน
// 0.8% ตามลำดับของบรีฟ (docx H3 #4 แล้วค่อย #5)
//
// Announcement หมุนมาเป็น Announcement3 ทั้งเว็บรอบนี้ (รอบก่อน 1SS365 ใช้
// AnnouncementPremium) — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ
// DM899 แล้ว และทุกหน้าก็เรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop message มิฉะนั้น
// ตัววิ่งจะพูดคนละเรื่องกันระหว่างหน้าแรกกับหน้านี้
//
// พาเลตต์ DM899 (brand-spec §2) เขียวมรกตนำ แดงสดรอง ทองเสริม บนดำอมเขียว — มาจาก
// logo.webp ที่เป็นตัว D เขียว (#01841b) ซ้อนตัว M แดง (#fb252b) และเลข 899 เงิน:
// เขียวแบรนด์ #01a326 (ขอบ ออรา) · เขียวสว่าง #12c23a · เขียวอ่อน #4ade6b ·
// เขียวแกน #01841b · แดงแบรนด์ #fb252b · แดงอ่อน #ff6b6e · ทองอ่อน #ffe9a8 (strong) ·
// ทองแบรนด์ #f2b422 · ทองลึก #a8780f · พื้นลึกสุด #030a05 · พื้นการ์ด #0a1a0e ·
// พื้นยกระดับ #102a16 · เนื้อความ #e4f2e4 (BRAND_TEXT มาจาก <html> และการ์ด ContentBox
// ตั้งให้แล้ว จึงไม่ต้องระบุสีที่ย่อหน้า) · หมึกบนพื้นสว่าง #06140a
// กฎคอนทราสต์: ปุ่มสมัคร = ไล่เฉดเขียว #4ade6b → #01a326 → #01841b หมึกดำอมเขียว
// #06140a (>=7:1 ทุกสต็อป) · ออราใช้คู่ตรงข้ามเขียว rgba(1,163,38,α) กับแดง
// rgba(251,37,43,α) ตามลายเซ็นของโลโก้
// ชุดทอง-เงินโครเมียมของ 1SS365 (#edbb23 #ffeeb4 #a87708 #c8cbce #f1f2f3 #121010
// #f0e6d2 #050505 #2a2115 #f7d458 #1a1710 rgba(237,187,35,*) rgba(5,5,5,*))
// ถูกแทนครบทุกจุดแล้ว ทั้งคลาส Tailwind raw hex และ rgba()
//
// DM899 เป็นเว็บ "สล็อตคาสิโนออนไลน์ เว็บตรงต่างประเทศ" ไม่ใช่หวยและไม่ใช่กีฬา — คำว่า
// หวย แทงหวย ส่งโพย โพย เลือกเลข 2 ตัว 3 ตัว อัตราจ่าย งวด รัฐบาลไทย ฮานอย ลาวพัฒนา
// หวยหุ้น ตรวจหวย แนวทาง ห้ามปรากฏบนหน้านี้ และห้ามลิงก์ไป /ตรวจหวย หรือ /แนวทาง
// เพราะรอบนี้สองหน้านั้นอยู่ใน src/pages-disabled/ (เราต์ตายและ build แดง)
// ตัวเลขที่บรีฟระบุและใช้ได้มีแค่ คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · 3 ขั้นตอน ·
// 24 ชั่วโมง · 100% ห้ามเพิ่มใบอนุญาต ชื่อค่ายเกม ชื่อธนาคาร ยอดฝากขั้นต่ำ
// จำนวนสมาชิก ปีที่ก่อตั้ง หรือค่า RTP และต้องคงคำกำกับของบรีฟไว้ว่าแต่ละรายการอาจ
// กำหนดรอบคำนวณ เกมที่ร่วมรายการ ยอดที่เข้าเกณฑ์ และระยะเวลารับสิทธิ์แตกต่างกัน
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 156
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `รวมภาพโปรโมชั่นสล็อตและคาสิโนสดของ ${BRAND_NAME} ทั้งโบนัสคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8% ควรตรวจสอบรอบคำนวณและยอดที่เข้าเกณฑ์จากบัญชีสมาชิกก่อนกดรับสิทธิ์`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่นสล็อต ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});
---

<MainLayout title={`โปรโมชั่นสล็อต ${BRAND_NAME} คืนยอดเสีย โบนัส 0.3% และแนะนำเพื่อน โบนัส 0.8%`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`โปรโมชั่นสล็อต ${BRAND_NAME}`} as="h1">
    <div class="flex flex-col gap-10">
      <p class="text-left text-base leading-relaxed">
        หน้านี้รวมภาพโปรโมชั่นที่ <strong class="text-[#ffe9a8]">{BRAND_NAME}</strong> เปิดให้สมาชิกตรวจสอบตามแคมเปญของแต่ละเดือน ทั้งโบนัสคืนยอดเสียและกิจกรรมแนะนำเพื่อน โดยรายละเอียดของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว
        <strong class="text-[#ffe9a8]">แต่ละโปรโมชั่นอาจกำหนดรอบคำนวณ เกมที่ร่วมรายการ ยอดที่เข้าเกณฑ์ และระยะเวลารับสิทธิ์แตกต่างกัน</strong> จึงควรอ่านเงื่อนไขล่าสุดจากบัญชีสมาชิกก่อนกดรับทุกครั้ง
      </p>

      <div class="mx-auto grid w-full max-w-4xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่นของ DM899 ด้านซ้ายเป็นหญิงสาวผมยาวสยายสวมชุดสีขาวประดับเพชร ยื่นมือออกมาข้างหน้า ฉากหลังเป็นวงแหวนเรืองแสงสีเขียวสลับแดงเหนือโต๊ะคาสิโนที่มีชิปคาสิโน ลูกเต๋าสีแดง ไพ่เอซสองใบ และวงล้อรูเล็ตวางอยู่ มุมบนขวาเป็นโลโก้ DM899 ตัว D สีเขียว ตัว M สีแดง และเลข 899 สีเงิน ถัดลงมาเป็นคำไทยสีทองขนาดใหญ่ว่า โปรโมชั่น มีมงกุฎทองอยู่ด้านบน ใต้ลงมาเป็นข้อความ คืนยอดเสีย โบนัส แล้วตามด้วยเลข 0.3% ตัวแดงสามมิติขนาดใหญ่"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), (max-width: 1007px) calc((100vw - 136px) / 2), 436px"
          class="mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#01a326]/60 object-contain shadow-[0_10px_30px_rgba(3,10,5,0.85)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#12c23a]/85 hover:shadow-[0_15px_40px_rgba(1,163,38,0.40)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่นของ DM899 ด้านซ้ายเป็นหญิงสาวผมยาวผูกโบว์สีขาว สวมชุดสีขาวปักทอง ชี้นิ้วขึ้นไปทางข้อความและยื่นมืออีกข้างออกมาข้างหน้า ฉากหลังเป็นม่านสีขาวสลับเขียวและแดง มีเหรียญทองปลิว ชิปคาสิโน ไพ่เอซ และกล่องของขวัญวางอยู่ มุมบนขวาเป็นโลโก้ DM899 ตัว D สีเขียว ตัว M สีแดง และเลข 899 สีเงิน ถัดลงมาเป็นคำไทยสีทองขนาดใหญ่ว่า โปรโมชั่น ใต้ลงมาเป็นป้ายสีดำขอบทองมีมงกุฎทองอยู่ด้านบน คาดข้อความ แนะนำเพื่อน โบนัส 0.8%"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), (max-width: 1007px) calc((100vw - 136px) / 2), 436px"
          class="mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#01a326]/60 object-contain shadow-[0_10px_30px_rgba(3,10,5,0.85)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#12c23a]/85 hover:shadow-[0_15px_40px_rgba(1,163,38,0.40)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#01841b] bg-gradient-to-r from-[#4ade6b] via-[#01a326] to-[#01841b] px-10 py-3.5 text-lg font-black text-[#06140a] shadow-[0_0_15px_rgba(1,163,38,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
