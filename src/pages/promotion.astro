---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

// ดรอปอาร์ตเวิร์กของ WIN999 คือ 2026-09-29 และมีสไลด์ที่ใช้ได้สองใบเท่านั้น:
//   slide1.png — โปสเตอร์ "คืนยอดเสีย โบนัส 0.3%"
//   slide2.png — โปสเตอร์ "แนะนำเพื่อน โบนัส 0.8%"
// บทบาทของสองไฟล์นี้ "สลับกัน" ระหว่างแบรนด์มาแล้ว และแบรนด์ก่อนหน้าผูกกลับด้าน
// กับรอบนี้พอดี อย่าเชื่อชื่อตัวแปรที่ตกทอดมาและอย่าคัดลอก import จากประวัติ git —
// รอบนี้ยึดตามคำอธิบายอาร์ตเวิร์กใน brand-spec §4 ซึ่งตรงกับภาพจริงที่เปิดดูแล้ว
//
// ไฟล์สไลด์ลำดับที่สามและสี่ใน src/assets เก่ากว่าดรอปรอบนี้ (2026-09-18 และ
// 2026-08-13) เป็นอาร์ตเวิร์กของลูกค้าเจ้าก่อน — ห้าม import กลับมา และห้ามลบทิ้ง
// เพราะเป็นอินเวนทอรี (ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้ว
// และ verify-build จะแดง) ถ้ามีสไลด์ใหม่เข้ามาให้เช็ก mtime เทียบดรอปก่อนเพิ่ม
// กริดรอบนี้จึงมีสองช่องเท่านั้น ห้ามเติมให้เต็มด้วยของเก่า
import promoCashback from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";
//
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ: ContentBox title, ย่อหน้าเกริ่นสั้น ๆ หนึ่งย่อหน้า
// (ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมดของหน้านี้), กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม
// — ไม่มีหัวข้อย่อยและไม่มีย่อหน้าเพิ่ม เพราะตัวโปสเตอร์ระบุชื่อโปรและเปอร์เซ็นต์โบนัส
// ไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว เป้าหมาย h1x1, h2x0, h3x0
//
// สไลด์เป็นแบนเนอร์สี่เหลี่ยมจัตุรัส 600x600 จึงวางเป็นกริดสองคอลัมน์คุมความกว้างรวมที่
// max-w-5xl (1024px) ทำให้ช่องละ ~488px ไม่ต้องอัปสเกลเกินขนาดไฟล์ต้นทาง widths หยุด
// ที่ 600 ตามความกว้างจริงของไฟล์ (candidate ที่ใหญ่กว่านั้นไม่มีของให้ครอป)
//
// Announcement หมุนจาก AnnouncementHuay มาเป็น AnnouncementPremium ทั้งเว็บรอบนี้ —
// orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ WIN999 แล้ว และ index
// ก็เรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop message มิฉะนั้นตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ WIN999 (ทองล้วนบนพื้นดำ ตามโลโก้ที่ WIN เป็นทองสด #fcc403 และ 999 เป็นขาว
// กับโปสเตอร์พื้นดำที่มีริ้วแสงทอง ชิปขอบทอง มงกุฎทอง และไพ่เอซ):
// พื้นเพจ #050505 · ผิวการ์ด #101010 · ผิวการ์ดอุ่น/ยก #191712 · ทองสว่าง #fdda04 ·
// ทองแบรนด์ #fcc403 · ทองกลาง #e0a800 · ทองลึก #8a6502 · ทองเข้มสุด #4a3402 ·
// เนื้อความ #e9e4d6 (BRAND_TEXT) · เน้นใน strong #fffbea · หมึกบนพื้นทอง #120d02
// การ์ดโปสเตอร์ใบซ้ายได้ขอบทองแบรนด์ ใบขวาได้ขอบทองกลาง เพื่อให้กริดยังอ่านเป็นสองใบ
// แยกกันแม้จะอยู่ในตระกูลสีเดียว ปุ่ม CTA เป็นไล่เฉดทอง #fdda04 → #fcc403 → #e0a800
// และใช้หมึกเข้ม #120d02 เพราะตัวอักษรบนพื้นทองห้ามเป็นสีขาว — ทองลึก #8a6502 จงใจ
// ใช้เฉพาะเส้นขอบและหัวข้อ ไม่เอามาอยู่ใต้ตัวหนังสือ เพราะหมึกเข้มบนทองลึกเหลือ
// คอนทราสต์แค่ ~3.3:1 ส่วนบนทองแบรนด์ได้ ~10:1
// ชุดแดง+ทองของแบรนด์ก่อนหน้า (#dc2626 #fc2b2c #b40102 #fde68a #fbbf24 #a16207
// #2a0405 #7f1d1d #f6e2e2 rgba(220,38,38,*) rgba(251,191,36,*)) ถูกแทนครบทุกจุดแล้ว
//
// WIN999 เป็นเว็บคาสิโนออนไลน์ ไม่ใช่เว็บสลากออนไลน์ บรีฟระบุแค่โบนัสคืนยอดเสีย
// 0.3% โบนัสแนะนำเพื่อน 0.8% รอบตัดยอด ประเภทเกม ยอดที่เข้าเกณฑ์ และข้อกำหนดการรับ
// ที่ต่างกันในแต่ละรายการ — ไม่ได้ระบุชื่อค่ายเกม ชื่อธนาคาร เลขใบอนุญาต เครดิตฟรี
// หรือเปอร์เซ็นต์อื่น จึงห้ามเขียนเพิ่มในหน้านี้ และคำศัพท์ตระกูลสลาก/ลอตเตอรีของ
// แบรนด์ก่อน (เลข 2 ตัว/3 ตัว อัตราจ่าย บิล/โพย ม้า เอเย่นต์) ห้ามหลงเหลือ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 154
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "รวมโปรโมชั่น WIN999 ทั้งโบนัสคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8% ดูยอดที่เข้าเกณฑ์ รอบคำนวณ และขั้นตอนรับสิทธิ์ของแต่ละรายการผ่านบัญชีสมาชิกก่อนกดรับ";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น WIN999",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});
---

<MainLayout title="โปรโมชั่น WIN999 คืนยอดเสีย โบนัส 0.3% และแนะนำเพื่อน โบนัส 0.8%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น WIN999" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#e9e4d6]">
        หน้านี้รวมภาพโปรโมชั่นที่ <strong class="text-[#fffbea]">WIN999</strong> เปิดให้สมาชิกกดรับจากบัญชีของตนเองตามรายการและช่วงเวลาที่เว็บไซต์อัปเดตไว้ ทั้งโบนัสคืนยอดเสียและโบนัสแนะนำเพื่อน โดยรายละเอียดของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว
        <strong class="text-[#fffbea]">รอบตัดยอด ประเภทเกม ยอดที่เข้าเกณฑ์ และข้อกำหนดการรับของแต่ละรายการแตกต่างกัน</strong> จึงควรตรวจสอบรายละเอียดล่าสุดผ่านบัญชีสมาชิกอีกครั้งก่อนกดรับโบนัสทุกครั้ง
      </p>

      <div class="mx-auto grid w-full max-w-5xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt="โปสเตอร์สี่เหลี่ยมจัตุรัสพื้นดำ ประดับด้วยทอง ด้านขวาเป็นหญิงสาวผมยาวสีเข้มสวมชุดสีขาวคาดทอง ยกมือขวารองรับข้อความ ด้านบนเป็นโลโก้ WIN999 ที่คำว่า WIN เป็นสีทองและเลข 999 เป็นสีขาว ถัดลงมาเป็นตัวอักษรไทยสีทองว่า คืนยอดเสีย ต่อด้วยคำว่า โบนัส และตัวเลขขนาดใหญ่ 0.3% สีทองเงาวาว รอบภาพมีไพ่โพดำ มงกุฎทอง และกองชิปคาสิโนสีดำขอบทอง"
          loading="lazy"
          fetchpriority="low"
          widths={[340, 480, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), 488px"
          class="mx-auto h-auto w-full rounded-xl border border-[#fcc403]/60 object-contain shadow-[0_10px_30px_rgba(3,2,0,0.85)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fdda04]/85 hover:shadow-[0_15px_40px_rgba(252,196,3,0.40)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoReferral}
          alt="โปสเตอร์ชุดเดียวกันพื้นดำประดับทอง ด้านขวาเป็นหญิงสาวผมยาวสีเข้มสวมชุดสีขาวคาดทอง ยกมือรองรับข้อความ ด้านบนเป็นโลโก้ WIN999 ที่คำว่า WIN เป็นสีทองและเลข 999 เป็นสีขาว ถัดลงมาเป็นตัวอักษรไทยสีขาวว่า แนะนำเพื่อน ต่อด้วยคำว่า โบนัส สีทอง และตัวเลขขนาดใหญ่ 0.8% สีทองเงาวาว มุมล่างมีชิปคาสิโนสีดำสลักคำว่า WIN และไพ่เอซวางเรียงอยู่"
          loading="lazy"
          fetchpriority="low"
          widths={[340, 480, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), 488px"
          class="mx-auto h-auto w-full rounded-xl border border-[#e0a800]/70 object-contain shadow-[0_10px_30px_rgba(3,2,0,0.85)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fcc403]/85 hover:shadow-[0_15px_40px_rgba(224,168,0,0.40)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก WIN999"
          class="flex items-center justify-center rounded-lg border border-[#fdda04]/70 bg-gradient-to-r from-[#fdda04] via-[#fcc403] to-[#e0a800] px-10 py-3.5 text-lg font-black text-[#120d02] shadow-[0_0_15px_rgba(252,196,3,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก WIN999
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
