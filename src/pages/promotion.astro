---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement4.astro";

import { Picture } from "astro:assets";

// ดรอปรอบนี้ (2026-10-21, brand-spec §5) มีสไลด์ที่ใช้ได้ **สองใบ** และชื่อตัวแปร
// ตั้งตามข้อความที่พิมพ์อยู่บนภาพจริง (เปิดบิตแมปอ่านเองแล้วรอบนี้) ไม่ใช่ตามเลขไฟล์ —
// ถ้ารอบหน้าเจอความขัดแย้ง **ให้เชื่อข้อความบนรูป**:
//   slide2.png — โปสเตอร์ "โปรโมชั่น / คืนยอดเสีย 0.3%"
//   slide1.png — โปสเตอร์ "โปรโมชั่น / แนะนำเพื่อน 0.8%"
//   slide3.png / slide4.png (mtime 2026-09-29) — โปสเตอร์หวยของ LOTTOPLUS ซึ่งเป็น
//     แบรนด์คนละรายโดยสิ้นเชิง **ห้าม import** (ถอดออกไปหลายรอบแล้ว อย่าดึงกลับ)
// ⚠️ การจับคู่พลิกไปมาระหว่างดรอป (รอบ รวยแทร่168 เคยเป็น slide1 = คืนยอดเสีย)
// จึงห้ามเชื่อการจับคู่ของรอบก่อน ต้องเปิดบิตแมปดูทุกรอบ
// ⚠️ eager import = emit ลง dist/ ต่อให้ไม่ได้ render และ verify-build จะแดง
// การ import ไฟล์เก่าคือการส่งรูปของลูกค้ารายอื่นขึ้นเว็บนี้
// **ห้ามลบไฟล์เก่าทิ้ง** — เป็นอินเวนทอรีของรอบถัดไป แค่ห้าม import
// (banner2 / banner3 ก็เช่นกัน ส่วน banner1 / banner1-mobile / og.png เป็นของ glob
// ที่ MainLayout ปักชื่อไว้เอง — ห้ามอ้างจากหน้านี้) รอบนี้จึงไม่มี article illustration
import promoCashback from "../assets/slide2.png";
import promoReferral from "../assets/slide1.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้นๆ ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมด
// ของหน้านี้, กริดภาพโปรโมชั่น, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อยและห้ามเพิ่มย่อหน้า
// เพราะโปสเตอร์ระบุเปอร์เซ็นต์ของตัวเองด้วยตัวอักษรขนาดใหญ่อยู่แล้ว การพิมพ์ซ้ำ
// ด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ บรีฟรอบนี้ (src/assets/content.txt)
// ไม่มีส่วน SUB-PAGES เลย ย่อหน้าทุกย่อหน้าที่เคยอยู่บนหน้านี้จึงเป็นของที่รีแบรนด์
// รอบก่อนๆ แต่งขึ้นเอง — รอบนี้คงไว้เพียงย่อหน้าเกริ่นเดียว และเขียนขึ้นใหม่จากบรีฟ
// (content.txt บรรทัด 7-12) ไม่ใช่ find-and-replace ทับประโยคของรอบก่อน
//
// ลำดับในกริดตามลำดับของบรีฟ: คืนยอดเสีย 0.3% (บรรทัด 9-10) มาก่อน แนะนำเพื่อน 0.8%
// (บรรทัด 11-12)
// ⚠️ บิตแมปจริงของดรอปนี้คือ **600x334** (แนวนอนราว 16:9 ไม่ใช่จัตุรัส) ความกว้าง
// สูงสุดคือ 600 widths จึงหยุดที่ 600 และคุมที่ max-w-[600px] ตามสเปก
// **ให้วัดใหม่ทุกรอบ อย่าเชื่อสัดส่วนของรอบก่อน**
// sizes คิดจากความกว้างที่ถูกวาดจริง: section px-4 (16px/ข้าง) + การ์ด p-8
// (32px/ข้าง, เป็น p-10 = 40px ที่ md ขึ้นไป) + gap-6 ระหว่างคอลัมน์ (24px)
//   ใต้ 640px = คอลัมน์เดียว → 100vw-96px
//   640-767px = สองคอลัมน์ p-8 → 50vw-60px
//   768-1335px = สองคอลัมน์ p-10 → 50vw-68px
//   ตั้งแต่ 1336px ขึ้นไปชนเพดาน 600px
// LCP คือ hero ใน MainLayout ไม่ใช่รูปพวกนี้ จึง loading="lazy" fetchpriority="low"
// decoding="async" และ quality ตัวเดียวทั้ง avif/webp — ห้ามจูนแยกฟอร์แมต
// (tools/avif-quality-service.mjs ย่อฝั่ง avif ให้เองที่ x0.65)
//
// quality={64} ไม่ใช่ 80 ตามปกติ และเป็นค่าที่ "วัดมา" ไม่ใช่ค่าที่ชอบ: สไลด์ทั้งสองเป็น
// อาร์ตเกรนละเอียด (ผิวคน ผมสีเงิน เหรียญชมพูปลิว ตัวอักษรไล่เฉดสามมิติ ประกายโบเก้)
// ซึ่งเป็นเคสที่ AVIF ทำได้แย่ที่สุด ที่ quality=80 ไฟล์ AVIF ออกมา **ใหญ่กว่า** WebP
// ที่เป็น fallback ของตัวเอง เบราว์เซอร์ที่รองรับ AVIF จะหยิบไฟล์ที่หนักกว่าไปใช้ และ
// verify-build.mjs ทำให้ build แดงด้วยเหตุนี้ตรงๆ · ทางแก้คือ quality ที่ **ต่ำลง**
// ไม่ใช่สูงขึ้น ค่าเดียวกันนี้ใช้ที่ index.astro กับสไลด์คู่เดียวกัน
//
// Announcement รอบนี้หมุนมาเป็น Announcement4 ทั้งเว็บ (brand-spec §3) orchestrator
// ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว และทุกหน้าเรียกแบบ
// bare เหมือนกัน จึงห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกันระหว่างหน้า
//
// 🚨 พาเลตรอบนี้ (brand-spec §2) เป็น **ธีมสว่างแบรนด์แรกของรีโปนี้ — กลับทิศจาก
// ทุกรอบก่อนหน้า** bg.json ของดรอปนี้คือ {"mode":"color","color":"#f0ccf5"} =
// ชมพูอมม่วงสว่าง ไม่ใช่ดำ **ห้าม "แก้" กลับไปเป็นพื้นเข้มเพราะรอบก่อนๆ เป็นแบบนั้น**
// ลำดับผิว: ผิวการ์ด #ffffff (ContentBox) / ชั้นกลาง-อินเซ็ต #f7dcf6 / พื้นเพจ #f0ccf5
// หมึกพลัม #4a0d35 = เนื้อความ (= BRAND_TEXT ที่ <html> และการ์ด ContentBox ตั้งให้
// แล้ว ย่อหน้าจึงไม่ประกาศสีของตัวเอง 14.9:1 บนผิวการ์ด) ·
// โรสเข้ม #a4186b = หัวข้อ และเป็น **สีเดียว** ที่ <strong> ในเนื้อความใช้ได้ (7.2:1)
// ⚠️⚠️ **ชมพูบานเย็น #dd1b74 ได้แค่ 4.67:1 บนผิวการ์ดขาว** จึงสงวนไว้เป็น
// **ขอบ / ออรา / พื้นถม** เท่านั้น ห้ามเป็นสีไฮไลต์ <strong> ในเนื้อความ
// ปุ่มในไฟล์นี้จึงถมไล่เฉด #dd1b74 → #a4186b แล้ววาง #ffffff ทับ (4.67:1 และ 7.2:1)
// rgba() ที่อนุญาตรอบนี้: rgba(221,27,116,α) · rgba(164,24,107,α) · rgba(74,13,53,α)
// · <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ
// ถ้าเปิด/ปิดกลางคำ บรรทัดจะตัดกลางคำ และ <strong> สองตัวห้ามติดกัน
// ⚠️ กับดักรอบนี้คือ **ชมพูเคยนำมาแล้วสามแบรนด์** (ถอนชัวร์168 · มีโชค168 · มีเฮ168)
// การเจอ "ชมพู" ในไฟล์นี้จึงไม่พิสูจน์อะไรเลย ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน
// brand-spec §2 (ค่าของแบรนด์เก่าไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไป
// เจอ false positive ในคอมเมนต์ของไฟล์นี้เอง)
// และรอบนี้ **ไม่มีทอง/เหลือง ไม่มีแดงชาด ไม่มีบรอนซ์ ไม่มีฟ้า/น้ำเงิน/ไซยาน
// ไม่มีเขียว ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์ และไม่มีส้ม**
//
// ⚠️ แกนของแบรนด์รอบนี้คือ **ระบบดูแลการเงิน — ช่องทางฝากถอนผ่านธนาคารและวอลเลท
// พร้อมข้อมูลเกมหลายประเภท** (สล็อต ไฮโล ยิงปลา หวย บอล — ห้าหมวด ไม่ใช่หก)
// **ไม่ใช่เว็บหวย และไม่ใช่เว็บบอล** ศัพท์หมวดของรอบก่อนทุกคำจึงเป็นของค้างที่
// ต้องไม่เหลือแม้แต่คำเดียว และบรีฟรอบนี้มีเกม **ห้าหมวดเท่านั้น ไม่ใช่หก
// ห้ามเติมหมวดที่หกเข้ามาเอง** สองหน้าหมวดลอตเตอรีจอดอยู่ใน src/pages-disabled/
// ไม่มี route ลิงก์ค้างจะเป็น href ตายที่ทำให้บิลด์แดง (รายการคำเต็มอยู่ใน
// brand-spec §6 ไม่พิมพ์ซ้ำที่นี่)
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% / 0.8% / 24ชม. — ห้ามแต่งยอดฝากขั้นต่ำ
// ชื่อธนาคาร ชื่อค่ายเกม ค่า RTP เลขใบอนุญาต จำนวนสมาชิก หรือปีก่อตั้ง และต้องคง
// ประโยคกำกับของบรีฟไว้ว่า **ก่อนเข้าร่วมควรอ่านข้อกำหนดล่าสุดให้ครบถ้วน**
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) หน้านี้ยาว 157 อักขระด้วยชื่อแบรนด์ 11 ตัวของรอบนี้
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `รวมภาพโปรโมชั่นของ ${BRAND_NAME} ไว้ในหน้าเดียว ทั้งคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% แต่ละรายการมีเงื่อนไขรับสิทธิ์ต่างกัน ควรอ่านข้อกำหนดล่าสุดก่อนเข้าร่วม`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่น ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});

// ความกว้างที่ถูกวาดจริงของแต่ละคอลัมน์ในกริดสองคอลัมน์ (ดูคอมเมนต์ sizes ด้านบน)
const promoSizes = "(max-width: 639px) calc(100vw - 96px), (max-width: 767px) calc(50vw - 60px), (max-width: 1335px) calc(50vw - 68px), 600px";

const promoClass =
  "mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#dd1b74]/55 object-contain shadow-[0_0_28px_rgba(221,27,116,0.22)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#a4186b]/85 hover:shadow-[0_0_40px_rgba(164,24,107,0.35)]";

// alt ทั้งสองเขียนจากบิตแมปของดรอปนี้ที่เปิดอ่านเองแล้ว (600x334 ทั้งคู่) — ฉากพื้น
// สตูดิโอสีขาวสว่าง ชายหนุ่มผมสั้นสีเงินเสื้อกล้ามขาวฝั่งซ้าย หญิงสาวผมสั้นสีเงิน
// สปอร์ตบราชมพูฝั่งขวา หมูการ์ตูนสวมหน้ากากโจรสีดำตรงกลาง กล่องของขวัญขาว-ชมพู
// เหรียญชมพูปลิว และลูกฟุตบอลขาว-ชมพู
// ⚠️ องค์ประกอบของอาร์ตเวิร์กแบรนด์ก่อนๆ ที่ต้องไม่หลงเหลือใน alt อยู่ครบใน
// brand-spec §5 (ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive)
// ⚠️ alt คือ "ข้อความที่พิมพ์อยู่บนโปสเตอร์" เป็นหลัก — ตัวเลขท้าย alt ต้องตรงกับรูป
const altCashback = `โปสเตอร์โปรโมชั่นแนวนอน ฉากพื้นสตูดิโอสีขาวสว่าง ด้านบนเป็นโลโก้ ${BRAND_NAME} รูปหัวหมูการ์ตูนสีชมพูอ่อนสวมหน้ากากโจรสีดำ เคียงกับชื่อแบรนด์ตัวอักษรไทยสามมิติไล่เฉดชมพูขอบขาวและเลขสามมิติผิวเงิน ฝั่งซ้ายเป็นชายหนุ่มผมสั้นสีเงินสวมเสื้อกล้ามขาวและกางเกงขาสั้นขาว ฝั่งขวาเป็นหญิงสาวผมสั้นสีเงินสวมสปอร์ตบราสีชมพูและกางเกงขาสั้นสีชมพู ตรงกลางเป็นหมูการ์ตูนสวมหน้ากากโจรสีดำ รอบตัวมีกล่องของขวัญสีขาว-ชมพูผูกโบว์ เหรียญสีชมพูปลิว และลูกฟุตบอลขาว-ชมพู กลางภาพเป็นคำว่า โปรโมชั่น ตัวอักษรไทยสามมิติสีชมพูตัวโต ใต้ลงมาเป็นแถบสีขาวเขียนว่า คืนยอดเสีย ต่อด้วยตัวเลข 0.3% สีชมพูตัวโต`;

const altReferral = `โปสเตอร์โปรโมชั่นแนวนอน ฉากพื้นสตูดิโอสีขาวสว่าง ด้านบนเป็นโลโก้ ${BRAND_NAME} รูปหัวหมูการ์ตูนสีชมพูอ่อนสวมหน้ากากโจรสีดำ เคียงกับชื่อแบรนด์ตัวอักษรไทยสามมิติไล่เฉดชมพูขอบขาวและเลขสามมิติผิวเงิน ฝั่งซ้ายเป็นชายหนุ่มผมสั้นสีเงินสวมเสื้อกล้ามขาวนั่งเท้าคาง ฝั่งขวาเป็นหญิงสาวผมสั้นสีเงินสวมสปอร์ตบราสีชมพูและกางเกงขาสั้นสีชมพู ตรงกลางเป็นหมูการ์ตูนสวมหน้ากากโจรสีดำขยิบตา รอบตัวมีกล่องของขวัญสีขาว-ชมพูผูกโบว์ เหรียญสีชมพูปลิว และลูกฟุตบอลขาว-ชมพู กลางภาพเป็นคำว่า โปรโมชั่น ตัวอักษรไทยสามมิติสีชมพูตัวโต ใต้ลงมาเป็นแถบสีขาวเขียนว่า แนะนำเพื่อน ต่อด้วยตัวเลข 0.8% สีชมพูตัวโต`;
---

<MainLayout title={`โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน โบนัส 0.8%`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`รวมโปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} as="h1">
    <div class="flex flex-col gap-10">
      <p>
        หน้านี้รวมภาพประกาศโปรโมชั่นของ {BRAND_NAME} ไว้ในที่เดียว ทั้ง
        <strong class="text-[#a4186b]">รายการคืนยอดเสีย 0.3% เข้ายูสทุกวัน และโบนัสแนะนำเพื่อน 0.8% ไม่จำกัด</strong>
        โดยอัตราและรูปแบบการรับสิทธิ์ระบุไว้บนภาพด้านล่างแล้ว แต่ละโปรโมชั่นอาจมีเงื่อนไขเกี่ยวกับประเภทเกม ยอดที่นำมาคำนวณ และรอบเวลารับเครดิตแตกต่างกัน
        <strong class="text-[#a4186b]">ก่อนเข้าร่วมควรอ่านข้อกำหนดล่าสุดให้ครบถ้วน รวมถึงตรวจสอบจำนวนบัญชีที่มีสิทธิ์รับโปรโมชั่นและเงื่อนไขการใช้โบนัส</strong>
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt={altCashback}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />

        <Picture
          src={promoReferral}
          alt={altReferral}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#a4186b] bg-gradient-to-b from-[#dd1b74] to-[#a4186b] px-10 py-3.5 text-lg font-black text-white shadow-[0_0_14px_rgba(221,27,116,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
