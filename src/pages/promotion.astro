---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

// ดรอปนี้ (2026-10-13) มีสไลด์ที่ใช้ได้แค่สองใบ และรอบนี้เปิดอ่านป้ายบนภาพจริงซ้ำแล้ว
// ⚠️ การจับคู่ของรอบนี้ **สลับข้างจากรอบก่อน** ห้ามเชื่อเลขไฟล์หรือคอมเมนต์เก่า:
//   slide1.png — โลโก้ KMD88 (ตัวอักษร KMD ม่วง เลข 88 ทอง ในวงแหวนทอง) อยู่บนสุด
//                ใต้คำว่า "โปรโมชั่น" เขียน "แนะนำเพื่อน โบนัส 0.8%" บนแผ่นป้ายดำขอบทอง
//   slide2.png — องค์ประกอบชุดเดียวกัน ใต้คำว่า "โปรโมชั่น" เขียน "คืนยอดเสีย 0.3%"
//   slide3.png / slide4.png — โปสเตอร์ของแบรนด์หมวดลอตเตอรีรอบก่อน (mtime 09-29)
//     ห้าม import กลับมาเด็ดขาด และห้ามลบไฟล์ทิ้งเพราะเป็นอินเวนทอรีของรอบถัดไป
// ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้ว และ verify-build จะแดง
// (banner2 / banner3 ใน src/assets เป็นอาร์ตเวิร์กของแบรนด์ก่อนๆ ห้าม import ส่วน
// banner1 / banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักชื่อไว้เอง
// — ห้ามอ้างจากหน้านี้)
// ชื่อตัวแปรตั้งตามข้อความบนภาพ ไม่ใช่ตามเลขไฟล์ เพื่อไม่ให้รอบหน้าสลับผิดอีก
import promoCashback from "../assets/slide2.png";
import promoReferral from "../assets/slide1.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้นๆ ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมด
// ของหน้านี้, กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อยและห้ามเพิ่มย่อหน้า
// เพราะตัวโปสเตอร์ระบุเปอร์เซ็นต์โบนัสไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว การพิมพ์ซ้ำ
// ด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ บรีฟรอบนี้ (src/assets/content.txt)
// ไม่มีส่วน SUB-PAGES เลย ย่อหน้าทุกย่อหน้าที่เคยอยู่บนหน้านี้จึงเป็นของที่รีแบรนด์
// รอบก่อนๆ แต่งขึ้นเอง — รอบนี้คงไว้เพียงย่อหน้าเกริ่นเดียว
//
// สไลด์รอบนี้เป็น **600x600 ทั้งคู่** วางเป็นกริดสองคอลัมน์ คุมความกว้างรวมที่
// max-w-4xl (896px) ทำให้ช่องละ ~436px ไม่ต้องอัปสเกลเกินขนาดไฟล์ต้นทาง widths
// หยุดที่ 600 ตามความกว้างจริงของไฟล์ และคุมภาพต่อใบไว้ที่ max-w-[600px]
// เรียง คืนยอดเสีย 0.3% ก่อน แนะนำเพื่อน 0.8% ตามลำดับของบรีฟ (docx H3 #4 แล้ว #5)
// ซึ่งรอบนี้แปลว่า **slide2 มาก่อน slide1** ตามข้อความที่พิมพ์อยู่บนรูป
// sizes คิดจากความกว้างที่ถูกวาดจริง: px-4 ของ section (16px/ข้าง) + p-8 ของการ์ด
// (32px/ข้าง, เป็น p-10 = 40px ที่ md ขึ้นไป) + gap-6 (24px) ระหว่างสองคอลัมน์
// LCP คือ hero ใน MainLayout ไม่ใช่สองรูปนี้ จึง loading="lazy" fetchpriority="low"
//
// Announcement รอบนี้หมุนมาเป็น Announcement5 ทั้งเว็บ (brand-spec §3)
// orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว และ
// ทุกหน้าก็เรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูด
// คนละเรื่องกันระหว่างหน้า
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ม่วงนำ ทองรอง บนดำสนิท — สองฮิวจริง**
// bg.json ของดรอปนี้เป็น {"mode":"color","color":"#000000"} = ดำสนิท แผ่นที่จม
// ที่สุดจึงเป็น #0a0213 ไม่ใช่ดำ ลำดับผิว: #1d0832 ยก (การ์ด ContentBox) /
// #140522 กลาง / #0a0213 จม / #000000 พื้นเพจ
// ม่วงแบรนด์ #7505cc ถือขอบรูปและออรา · ทองแบรนด์ #e2b33f เป็นฮิวที่สอง ใช้เป็น
// ขอบตอน hover และเป็นพื้นถมของปุ่ม · ทองสว่าง #ffdf8c เป็นปลายสว่างของพื้นถม ·
// ทองไฮไลต์ #ffd45e สงวนไว้ให้ <strong> ในเนื้อความอย่างเดียว · หมึกบนพื้นถมทอง
// เป็น #1a0526 · เนื้อความ #ece2f8 มาจาก BRAND_TEXT ที่ <html> และการ์ด ContentBox
// ตั้งให้แล้ว ย่อหน้าจึงไม่ประกาศสีของตัวเอง
// · <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ
// ถ้าเปิด/ปิดกลางคำ บรรทัดจะตัดกลางคำ
// ⚠️ #7505cc #b453ff #3a0565 #2c0349 #7a5a0a ห้ามถือตัวอักษรทุกขนาด ใช้ได้เฉพาะ
// เส้น ขอบ และออรา · ออราใช้ rgba(117,5,204,α) และ rgba(226,179,63,α) เท่านั้น
// ⚠️ กับดักของรอบนี้คือ **ทั้งสองฮิว**: ทองมาแล้วเก้าในสิบสองรอบหลังสุด และม่วงก็
// เพิ่งมาสองรอบ "เจอทองหรือเจอม่วง" จึงไม่ได้แปลว่าเป็นของรอบนี้ ให้เทียบเป็น "ค่า"
// ทีละตัวกับตารางใน brand-spec §2 (ค่าของแบรนด์ก่อนไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้
// grep หาสีแบรนด์เก่าเจอ false positive) และรอบนี้ **ไม่มีชมพู ไม่มีเงิน/เทา
// ไม่มีเขียว ไม่มีน้ำเงิน ไม่มีส้ม ไม่มีแดง** มีแค่ม่วงกับทอง
//
// แบรนด์นี้เป็น **คาสิโนรวมเกม** (บาคาร่า สล็อต บอลออนไลน์) ไม่ใช่เว็บสล็อตล้วน
// ไม่ใช่เว็บกีฬาล้วน และไม่ใช่เว็บหมวดลอตเตอรี (สองหน้าของหมวดนั้นจอดอยู่ใน
// src/pages-disabled/ ไม่มี route — ลิงก์ค้างจะเป็น href ตายที่ทำให้บิลด์แดง)
// คำขายของของแบรนด์ก่อนและศัพท์หมวดอื่นที่บรีฟไม่ได้เอ่ยห้ามหลงเหลือ (รายการเต็ม
// อยู่ใน brand-spec §1 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep เจอ false positive)
// ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% / 0.8% / 24 ชั่วโมง — ห้ามแต่งยอดฝากขั้นต่ำ
// ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP เลขใบอนุญาต จำนวนสมาชิก หรือปีก่อตั้ง และต้องคง
// คำกำกับของบรีฟ (บรรทัด 9 ของ content.txt) ไว้ว่า **ควรตรวจสอบว่าโปรโมชั่น
// ครอบคลุมบาคาร่า สล็อต หรือบอลออนไลน์ประเภทใดบ้าง เพราะแต่ละกิจกรรมอาจมี
// ข้อกำหนดแตกต่างกัน**
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) หน้านี้ยาว 151 อักขระ
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `รวมภาพโปรโมชั่น ${BRAND_NAME} ทั้งคืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อน โบนัส 0.8% ตรวจสอบยอดที่เข้าเกณฑ์ รอบคำนวณ และสถานะการรับสิทธิ์ได้จากบัญชีสมาชิก`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่น ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});

// ความกว้างที่ถูกวาดจริงของแต่ละช่องในกริดสองคอลัมน์ (ดูคอมเมนต์ sizes ด้านบน)
const promoSizes = "(max-width: 639px) calc(100vw - 96px), (max-width: 767px) calc((100vw - 120px) / 2), (max-width: 1007px) calc((100vw - 136px) / 2), 436px";
const promoClass =
  "mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#7505cc]/50 object-contain shadow-[0_0_28px_rgba(117,5,204,0.3)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#e2b33f]/85 hover:shadow-[0_0_40px_rgba(226,179,63,0.38)]";
---

<MainLayout title={`โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน โบนัส 0.8%`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`โปรโมชั่น ${BRAND_NAME} ทั้งหมด`} as="h1">
    <div class="flex flex-col gap-10">
      <p>
        หน้านี้รวมภาพโปรโมชั่นที่ <strong class="text-[#ffd45e]">{BRAND_NAME}</strong> เปิดให้สมาชิกตรวจสอบสิทธิ์ตามกิจกรรมที่เว็บไซต์กำหนด โดยเน้นโบนัสคืนยอดเสียและกิจกรรมแนะนำเพื่อน รายละเอียดของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว
        สมาชิกตรวจสอบยอดที่เข้าเกณฑ์ รอบคำนวณ และสถานะการรับสิทธิ์ได้ผ่านบัญชีตามระบบที่เปิดให้บริการ <strong class="text-[#ffd45e]">
          ควรตรวจสอบว่าโปรโมชั่นครอบคลุมบาคาร่า สล็อต หรือบอลออนไลน์ประเภทใดบ้าง เพราะแต่ละกิจกรรมอาจมีข้อกำหนดแตกต่างกัน
        </strong>
      </p>

      <div class="mx-auto grid w-full max-w-4xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt={`ภาพโปรโมชั่นของ ${BRAND_NAME} เป็นฉากคาสิโนพื้นดำ ด้านบนเป็นโลโก้ตัวอักษร KMD สีม่วงสามมิติต่อด้วยเลข 88 สีทองในวงแหวนทอง ใต้โลโก้เป็นชายหนุ่มและหญิงสาวผมสีขาวเงินในชุดดำขลิบทอง รอบตัวทั้งสองมีไพ่เอซขอบทอง มงกุฎทอง ชิปคาสิโนสีม่วงสลับทอง และลูกเต๋าทอง พร้อมริบบิ้นแสงสีม่วงพาดฉากหลัง กลางภาพเป็นคำว่า โปรโมชั่น ตัวอักษรทองสามมิติขนาดใหญ่ ใต้ลงมาบนแผ่นป้ายดำขอบทองเขียนว่า คืนยอดเสีย คู่กับตัวเลข 0.3% ตัวโต`}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoReferral}
          alt={`ภาพโปรโมชั่นของ ${BRAND_NAME} ชุดเดียวกัน พื้นดำม่วงทอง ด้านบนเป็นโลโก้ตัวอักษร KMD สีม่วงสามมิติต่อด้วยเลข 88 สีทองในวงแหวนทอง ใต้โลโก้เป็นชายหนุ่มและหญิงสาวผมสีขาวเงินในชุดดำขลิบทอง ด้านหลังเป็นไพ่เอซขอบทอง มงกุฎทอง กองชิปคาสิโนสีม่วงสลับทอง และลูกเต๋าทองทางขวา กลางภาพเป็นคำว่า โปรโมชั่น ตัวอักษรทองสามมิติขนาดใหญ่ ใต้ลงมาบนแผ่นป้ายดำขอบทองเขียนว่า แนะนำเพื่อน โบนัส คู่กับตัวเลข 0.8% ตัวโต`}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#7a5a0a] bg-gradient-to-b from-[#ffdf8c] to-[#e2b33f] px-10 py-3.5 text-lg font-black text-[#1a0526] shadow-[0_0_14px_rgba(226,179,63,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
