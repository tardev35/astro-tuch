---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

// Only slide1/slide2 belong to BPLAY639 (drop 2026-08-15), and they are
// exactly the two promotions this page shows: slide1 is the "แนะนำเพื่อน 0.8%"
// poster, slide2 is the "คืนยอดเสีย 0.3%" poster.
// slide3/slide4 are still on disk but belong to previous clients — they may not
// be imported here, now or on any future rebrand (an unrendered import is still
// emitted into dist/).
import promoReferral from "../assets/slide1.png";
import promoCashback from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";

// This is an IMAGE page: the ContentBox title, ONE short intro paragraph, the
// poster grid, one CTA. No section headings, no extra prose — the posters
// already state every offer in large type.
//
// 150–160 CHARACTERS (not bytes — a byte count reads ~3x too long for Thai).
const pageDescription =
  "รวมโปรโมชั่น BPLAY639 คาสิโนลิขสิทธิ์แท้อเมริกา ทั้งโบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ดูรายละเอียดและเงื่อนไขของแต่ละรายการจากภาพโปรโมชั่นก่อนกดรับสิทธิ์";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น BPLAY639 แนะนำเพื่อน 0.8% คืนยอดเสีย 0.3%",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoReferral.src,
});
---

<MainLayout title="โปรโมชั่น BPLAY639 คาสิโนลิขสิทธิ์แท้อเมริกา แนะนำเพื่อน 0.8% คืนยอดเสีย 0.3%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น BPLAY639" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#f2e3f7]">
        หน้านี้รวมโปรโมชั่นที่ BPLAY639 เปิดให้สมาชิกกดรับอยู่ในขณะนี้ ทั้งโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสียสูงถึง 0.3% ต่อวัน
        อัตราโบนัส ยอดที่นำมาคำนวณ และรอบเวลาการรับสิทธิ์ระบุไว้บนภาพโปรโมชั่นแต่ละใบ และเงื่อนไขของแต่ละรายการไม่เหมือนกัน
        สมาชิกตรวจสอบสิทธิ์และกดรับโบนัสได้จากบัญชีของตนเอง หรือสอบถามแอดมินทาง LINE Official ที่ดูแลตลอด 24 ชั่วโมง
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่นโทนพาสเทลชมพูม่วง มีก้อนเมฆและดวงดาวเป็นฉากหลัง ด้านบนซ้ายเป็นโลโก้ BPLAY639 กลางภาพเขียนว่า โปรโมชั่น แนะนำเพื่อน 0.8% ตัวใหญ่ ด้านขวาเป็นหญิงสาวสวมชุดพาสเทลยืนแบมือไปทางข้อความ มีโล่ AMERICAN LICENSED ชิปโป๊กเกอร์ และไพ่กระจายอยู่รอบภาพ"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#7e22ce]/60 object-contain shadow-[0_10px_30px_rgba(244,114,182,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f9a8d4]/70 hover:shadow-[0_15px_40px_rgba(252,211,77,0.28)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่นโทนพาสเทลชมพูม่วง ด้านบนซ้ายเป็นโลโก้ BPLAY639 กลางภาพเขียนว่า โปรโมชั่น คืนยอดเสีย 0.3% ตัวใหญ่ ด้านขวาเป็นหญิงสาวสวมชุดสีชมพูยืนอยู่บนแท่นโพเดียม มีโล่ AMERICAN LICENSED ชิปโป๊กเกอร์ และไพ่วางอยู่ด้านหน้า"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#7e22ce]/60 object-contain shadow-[0_10px_30px_rgba(244,114,182,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f9a8d4]/70 hover:shadow-[0_15px_40px_rgba(252,211,77,0.28)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#f9a8d4]/70 bg-gradient-to-r from-[#ec4899] via-[#f472b6] to-[#4c1d6b] px-10 py-3.5 text-lg font-black text-[#150724] shadow-[0_0_15px_rgba(244,114,182,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก BPLAY639
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
