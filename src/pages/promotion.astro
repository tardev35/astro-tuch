---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

// ดรอปอาร์ตเวิร์กของ SAGAME66 คือ 2026-09-23 และมีสไลด์ที่ใช้ได้สองใบ (600x333):
//   slide1.png — "โปรโมชั่น แนะนำเพื่อน 0.8%"
//   slide2.png — "โปรโมชั่น คืนยอดเสีย 0.3%"
// บทบาทของสองไฟล์นี้เคย "สลับกัน" ระหว่างแบรนด์มาแล้ว จึงต้องเปิดดูภาพจริงทุกครั้ง
// อย่าเชื่อชื่อตัวแปรที่ตกทอดมา (รอบนี้เปิดดูแล้ว ตรงตามชื่อตัวแปรเดิม)
// กริดเรียงตามลำดับ docx (แนะนำเพื่อนก่อน คืนยอดเสียทีหลัง)
//
// slide3.png (2026-09-18) และ slide4.png (2026-08-13) เก่ากว่าดรอปรอบนี้ เป็น
// อาร์ตเวิร์กของลูกค้าเจ้าก่อน — ห้าม import กลับมา และห้ามลบไฟล์ทิ้งเพราะเป็น
// อินเวนทอรี (ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้ว และ
// verify-build จะแดง) ถ้ามีสไลด์ใหม่เข้ามาให้เช็ก mtime เทียบดรอปก่อนเพิ่ม
import promoReferral from "../assets/slide1.png";
import promoCashback from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";
//
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ: ContentBox title, ย่อหน้าเกริ่นสั้น ๆ หนึ่งย่อหน้า,
// กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม — ไม่มีหัวข้อย่อยและไม่มีย่อหน้าเพิ่ม เพราะตัวโปสเตอร์
// ระบุชื่อโปรและเปอร์เซ็นต์โบนัสไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว เป้าหมาย h1×1, h2×0, h3×0
//
// สไลด์เป็นแบนเนอร์แนวนอน 600px จึงวางเป็นกริดสองคอลัมน์คุมความกว้างรวมที่ max-w-5xl
// (1024px) ทำให้ช่องละ ~488px ไม่ต้องอัปสเกลเกินขนาดไฟล์ต้นทาง widths หยุดที่ 600
// ตามความกว้างจริงของไฟล์ (candidate ที่ใหญ่กว่านั้นไม่มีของให้ครอป)
//
// Announcement รอบนี้หมุนมาใช้ Announcement5 ทั้งเว็บ — default message ของไฟล์นั้น
// ถูกตั้งเป็นคอปปี้ของ SAGAME66 แล้ว และ index ก็เรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop
//
// พาเลตต์ SAGAME66 (ทอง + เงินโครเมียม บนน้ำตาลเกือบดำ แทนแดงคริมสัน-เงินของรอบก่อน):
// พื้น #0d0903 · ผิวการ์ด #171006 · ผิวยก #2a1d0b · ทองหลัก #e8b93f ·
// ทองสว่าง #ffe9a3 · ทองลึก #96671a · เงินโครเมียม #eef3f8 · เงินกลาง #b6c1cd ·
// เนื้อความ #e3d8c0 (BRAND_TEXT) · เงาลึก rgba(13,9,3,α) · ออร่าทอง rgba(232,185,63,α)
// ตัวเลขโบนัส (0.8% / 0.3%) ใช้ทองสว่าง #ffe9a3 ส่วนข้อความเน้นทั่วไปใช้เงินโครเมียม #eef3f8
// — โทนแดงคริมสันและเงินเย็นของแบรนด์รอบก่อนถูกถอดออกหมดแล้ว ห้ามนำกลับมา
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 153
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "รวมภาพโปรโมชั่นของ SAGAME66 เว็บบาคาร่า รูเล็ต คาสิโน ทั้งโบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% พร้อมตรวจสอบเงื่อนไขของแต่ละสิทธิ์จากหน้าเว็บก่อนกดรับ";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น SAGAME66",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoReferral.src,
});
---

<MainLayout title="โปรโมชั่น SAGAME66 แนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตรวจเงื่อนไขก่อนกดรับ" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น SAGAME66" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#e3d8c0]">
        หน้านี้รวมภาพโปรโมชั่นที่ <strong class="text-[#eef3f8]">SAGAME66</strong> เปิดรับในรอบปัจจุบัน ทั้งโบนัสแนะนำเพื่อน
        <strong class="text-[#ffe9a3]">0.8%</strong> และโบนัสคืนยอดเสีย <strong class="text-[#ffe9a3]">0.3%</strong>
        โดยรายละเอียดของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว ทั้งชื่อโปรโมชั่นและเปอร์เซ็นต์โบนัสที่ได้รับ
        <strong class="text-[#eef3f8]">แต่ละรายการมีเงื่อนไข รอบคำนวณ และยอดที่เข้าเกณฑ์ต่างกัน จึงควรเปิดดูรายละเอียดของโปรโมชั่นนั้นจากหน้าเว็บไซต์ก่อนกดรับสิทธิ์ทุกครั้ง</strong>
      </p>

      <div class="mx-auto grid w-full max-w-5xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoReferral}
          alt="แบนเนอร์โปรโมชั่นพื้นทองมีเหรียญทองร่วงเต็มภาพ ด้านซ้ายเป็นหญิงสาวผมยาวสีเข้มสวมชุดขาวคาดทองที่มีคำว่า SAGAME66 กำลังชี้นิ้วเข้าหาข้อความ ด้านขวาเป็นชายหนุ่มผมสั้นสวมเสื้อกีฬาขาว-ทองคำว่า SAGAME66 กอดอก ด้านบนเป็นโลโก้ SAGAME66 ตัวอักษร SA สีทองสามมิติ GAME สีเงินโครเมียม และ 66 สีทอง ถัดลงมาเป็นข้อความไทยว่า โปรโมชั่น และ แนะนำเพื่อน ล่างสุดเป็นตัวเลขขนาดใหญ่ว่า 0.8% มุมซ้ายมีไพ่โพดำเอซ มุมขวามีลูกฟุตบอลสีทอง"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), 488px"
          class="mx-auto h-auto w-full rounded-xl border border-[#e8b93f]/55 object-contain shadow-[0_10px_30px_rgba(13,9,3,0.75)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#eef3f8]/75 hover:shadow-[0_15px_40px_rgba(232,185,63,0.45)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoCashback}
          alt="แบนเนอร์โปรโมชั่นพื้นทองมีเหรียญทองและกองชิปคาสิโนวางอยู่มุมซ้ายล่าง ด้านซ้ายเป็นหญิงสาวผมยาวสีเข้มสวมชุดขาวคาดทองที่มีคำว่า SAGAME66 กำลังชี้นิ้วเข้าหาข้อความ ด้านขวาเป็นชายหนุ่มผมสั้นสวมเสื้อกีฬาขาว-ทองคำว่า SAGAME66 กอดอกข้างลูกฟุตบอลสีทอง ด้านบนเป็นโลโก้ SAGAME66 ตัวอักษร SA สีทองสามมิติ GAME สีเงินโครเมียม และ 66 สีทอง ถัดลงมาเป็นข้อความไทยว่า โปรโมชั่น และ คืนยอดเสีย ล่างสุดเป็นตัวเลขขนาดใหญ่ว่า 0.3%"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), 488px"
          class="mx-auto h-auto w-full rounded-xl border border-[#e8b93f]/55 object-contain shadow-[0_10px_30px_rgba(13,9,3,0.75)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#eef3f8]/75 hover:shadow-[0_15px_40px_rgba(232,185,63,0.45)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก SAGAME66"
          class="flex items-center justify-center rounded-lg border border-[#ffe9a3]/60 bg-gradient-to-r from-[#ffe9a3] via-[#e8b93f] to-[#96671a] px-10 py-3.5 text-lg font-black text-[#0d0903] shadow-[0_0_15px_rgba(232,185,63,0.50)] transition-transform hover:scale-105">
          สมัครสมาชิก SAGAME66
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
