---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

// อาร์ตเวิร์กของ MHEEPOOH168 รอบนี้มีสองใบ (ลงวันที่ 2026-09-21):
// slide1 = "โปรโมชั่น คืนยอดเสีย 0.3%" · slide2 = "โปรโมชั่น แนะนำเพื่อน 0.8%"
// กริดของหน้านี้คือสองใบนี้เท่านั้น
//
// ไฟล์ slide ใบอื่นที่ยังค้างอยู่ใน src/assets (ลงวันที่เก่ากว่า 2026-09-21)
// เป็นอาร์ตเวิร์กของลูกค้าเจ้าก่อน ๆ และ "พิมพ์ชื่อแบรนด์ของเจ้าของเดิมไว้เป็น
// ตัวอักษรขนาดใหญ่กลางรูป" — ห้าม import ที่นี่เด็ดขาด และห้ามลบไฟล์ทิ้งด้วย
// เพราะเป็นอินเวนทอรีของแบรนด์เจ้าของเดิม ก่อนเพิ่ม slide ใบใหม่ให้เช็กวันที่ไฟล์
// เทียบกับ drop ปัจจุบันเสมอ
// (ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้ว และ verify-build จะแดง)
import promoCashback from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็น IMAGE page: ContentBox title, ย่อหน้าเกริ่นสั้น ๆ หนึ่งย่อหน้า, กริดโปสเตอร์,
// ปุ่ม CTA หนึ่งปุ่ม — ไม่มีหัวข้อย่อยและไม่มีย่อหน้าเพิ่ม เพราะตัวโปสเตอร์ระบุเงื่อนไข
// ของแต่ละโปรโมชั่นไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว เป้าหมาย h1×1, h2×0, h3×0
//
// Announcement รอบนี้หมุนมาใช้ AnnouncementPremium ทั้งเว็บ — default message ของ
// ไฟล์นั้นเป็นข้อความของ MHEEPOOH168 อยู่แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message
//
// พาเลตต์ MHEEPOOH168: ทองสว่าง #fced74 เป็นสี <strong> และสต็อปบนของเกรเดียนต์ ·
// ทองกลาง #f5b70a เป็นขอบและออร่า · ทองเข้ม #8a5a06 เป็นสต็อปล่าง · แดงสด #c4161c
// กับแดงเลือดหมู #8f0505 เป็นผิวแอคเซนต์ · แดงเข้ม #2b0101 เป็นตัวอักษรบนปุ่มทอง ·
// เนื้อความครีม #f1dccd — แบรนด์นี้เป็นทองบนแดง ไม่ใช่ทองบนดำแบบแบรนด์ก่อน
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 154
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "รวมโปรโมชั่นสล็อต MHEEPOOH168 ทั้งโบนัสคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8% พร้อมรอบคำนวณ ยอดที่เข้าเกณฑ์ และขั้นตอนรับสิทธิ์ของแต่ละรายการในหน้าเดียว";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น MHEEPOOH168",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});
---

<MainLayout title="โปรโมชั่น MHEEPOOH168 คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ใช้ได้ทุกเกม" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น MHEEPOOH168" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#f1dccd]">
        โปรโมชั่นสล็อตของ MHEEPOOH168 ใช้ได้ทุกเกม ไม่จำกัด โดยรอบนี้มีสองรายการหลักคือ
        <strong class="text-[#fced74]">โบนัสคืนยอดเสีย 0.3%</strong> และ<strong class="text-[#fced74]">โบนัสแนะนำเพื่อน 0.8%</strong>
        เปอร์เซ็นต์ ยอดที่เข้าเกณฑ์ และขั้นตอนรับสิทธิ์ของแต่ละรายการระบุไว้บนภาพด้านล่าง
        <strong class="text-[#fced74]">แต่ละโปรโมชั่นมีเงื่อนไขและรอบคำนวณต่างกัน จึงควรตรวจสอบสิทธิ์จากบัญชีสมาชิกก่อนกดรับทุกครั้ง</strong>
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่นคืนยอดเสีย 0.3% พื้นหลังสีแดงเข้มประดับเหรียญทอง กล่องของขวัญ และลูกบอลตัวเลขหวย ด้านบนเป็นโลโก้ตัวอักษรทองสองบรรทัดว่า MHEEPOOH 168 ถัดลงมาเป็นข้อความทองว่า โปรโมชั่น คืนยอดเสีย และตัวเลขทองขนาดใหญ่มาก 0.3% ด้านซ้ายเป็นหญิงสาวผมยาวในชุดสีแดงสลับขาวที่มีคำว่า MHEEPOOH168 ปักอยู่"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#f5b70a]/45 object-contain shadow-[0_10px_30px_rgba(0,0,0,0.75)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fced74]/75 hover:shadow-[0_15px_40px_rgba(245,183,10,0.35)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อน 0.8% พื้นหลังสีแดงเข้มประดับเหรียญทอง กล่องของขวัญ และโทรโข่งสีแดงขาว มุมซ้ายบนเป็นป้ายทองคำว่า GOOD FRIENDS BIG BONUS ด้านบนเป็นโลโก้ตัวอักษรทองสองบรรทัดว่า MHEEPOOH 168 ถัดลงมาเป็นข้อความทองว่า โปรโมชั่นแนะนำเพื่อน ตัวเลขทองขนาดใหญ่มาก 0.8% และป้ายกลมว่า ชวนเพื่อน รับโบนัส ไม่จำกัด ด้านซ้ายเป็นหญิงสาวผมยาวในชุดสีแดงสลับขาวที่มีคำว่า MHEEPOOH168 ปักอยู่"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#f5b70a]/45 object-contain shadow-[0_10px_30px_rgba(0,0,0,0.75)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fced74]/75 hover:shadow-[0_15px_40px_rgba(245,183,10,0.35)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก MHEEPOOH168"
          class="flex items-center justify-center rounded-lg border border-[#fced74]/60 bg-gradient-to-r from-[#fced74] via-[#f5b70a] to-[#8a5a06] px-10 py-3.5 text-lg font-black text-[#2b0101] shadow-[0_0_15px_rgba(245,183,10,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก MHEEPOOH168
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
