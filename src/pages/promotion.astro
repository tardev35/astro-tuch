---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

// เฉพาะ slide1/slide2 (ลงวันที่ 2026-08-23) เท่านั้นที่เป็นอาร์ตเวิร์กของ หวยกินดี365
// slide1 คือโปสเตอร์ "แนะนำเพื่อน 0.8%" ส่วน slide2 คือ "คืนยอดเสีย 0.3%" (อ่านจากตัวภาพ)
// บทบาทสลับกันได้ในแต่ละแบรนด์ — อย่าเชื่อชื่อตัวแปรเดิม ให้เปิดรูปดูทุกครั้งที่เปลี่ยนแบรนด์
// slide3/slide4 ยังค้างอยู่บนดิสก์แต่เป็นอาร์ตเวิร์กของลูกค้าก่อนหน้า — ห้าม import ที่นี่
// ทั้งรอบนี้และรอบถัดไป (ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้ว)
import promoReferral from "../assets/slide1.png";
import promoCashback from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็น IMAGE page: ContentBox title, ย่อหน้าเกริ่นสั้น ๆ หนึ่งย่อหน้า, กริดโปสเตอร์,
// ปุ่ม CTA หนึ่งปุ่ม — ไม่มีหัวข้อย่อยและไม่มีย่อหน้าเพิ่ม เพราะตัวโปสเตอร์ระบุเงื่อนไข
// ของแต่ละโปรโมชั่นไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 158
const pageDescription =
  "รวมโปรโมชั่น หวยกินดี365 ทั้งแนะนำเพื่อนรับ 0.8% และคืนยอดเสีย 0.3% ดูเปอร์เซ็นต์ ยอดคำนวณ และเงื่อนไขของแต่ละรายการได้จากภาพโปรโมชั่นในหน้านี้ก่อนกดรับสิทธิ์";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น หวยกินดี365 แนะนำเพื่อน 0.8% คืนยอดเสีย 0.3%",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoReferral.src,
});
---

<MainLayout title="โปรโมชั่น หวยกินดี365 แนะนำเพื่อนรับ 0.8% และคืนยอดเสียรับ 0.3%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น หวยกินดี365" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#dce7fb]">
        หน้านี้รวมโปรโมชั่นที่ หวยกินดี365 เปิดให้สมาชิกตรวจสอบสิทธิ์และกดรับผ่านบัญชีของตนเอง ทั้งกิจกรรมแนะนำเพื่อนรับ <strong class="text-[#fbe473]">0.8%</strong>
        และคืนยอดเสีย <strong class="text-[#fbe473]">0.3%</strong> โดยเปอร์เซ็นต์ ยอดที่นำมาคำนวณ และรอบเวลารับสิทธิ์ระบุไว้บนภาพโปรโมชั่นแต่ละใบ
        แต่ละรายการมีวิธีคำนวณและเงื่อนไขต่างกัน จึงควรอ่านรายละเอียดล่าสุดหรือสอบถามเจ้าหน้าที่ก่อนกดรับทุกครั้ง
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อนของ หวยกินดี365 พื้นหลังน้ำเงินเข้มประกายทอง โลโก้ หวยกินดี365 สีทองอยู่มุมขวาบน ข้อความ โปรโมชั่น แนะนำเพื่อน และตัวเลขทองขนาดใหญ่ 0.8% ด้านซ้ายเป็นผู้หญิงผมยาวสีเงินในชุดไทยสีน้ำเงินขาวทองกำลังแบมือเชิญ รอบตัวมีลูกบอลหวยหมายเลข 5 3 8 สลากกินแบ่งรัฐบาลไทย และเหรียญทอง"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#c9a23a]/70 object-contain shadow-[0_10px_30px_rgba(3,21,59,0.65)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f6db6b]/70 hover:shadow-[0_15px_40px_rgba(246,219,107,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่นคืนยอดเสียของ หวยกินดี365 พื้นหลังน้ำเงินเข้มประกายทอง โลโก้ หวยกินดี365 สีทองอยู่ด้านบน ข้อความ โปรโมชั่น คืนยอดเสีย และตัวเลขทองขนาดใหญ่ 0.3% ในกรอบทอง ด้านซ้ายเป็นผู้หญิงผมยาวสีเงินในชุดไทยสีน้ำเงินขาวทองชี้นิ้วมาที่ตัวเลข มุมทั้งสี่มีลูกบอลหวยหมายเลข 8 3 5 9 พร้อมสลากกินแบ่งรัฐบาลไทยและเหรียญทองกองอยู่"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#c9a23a]/70 object-contain shadow-[0_10px_30px_rgba(3,21,59,0.65)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f6db6b]/70 hover:shadow-[0_15px_40px_rgba(246,219,107,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก หวยกินดี365"
          class="flex items-center justify-center rounded-lg border border-[#f6db6b]/70 bg-gradient-to-r from-[#fbe473] via-[#f6db6b] to-[#c9a23a] px-10 py-3.5 text-lg font-black text-[#03153b] shadow-[0_0_15px_rgba(246,219,107,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก หวยกินดี365
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
