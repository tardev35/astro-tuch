---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

// ⚠️ ดรอปนี้ (mtime 2026-10-08) มีสไลด์ที่ "ใช้ได้" แค่สองใบ และรอบนี้ตรวจป้ายบน
// ภาพจริงซ้ำอีกครั้งแล้ว — คู่สลับด้านกับที่คอมเมนต์ของรอบก่อนเขียนไว้ ห้ามเชื่อ
// เลขไฟล์หรือคอมเมนต์เก่า ให้เปิดรูปอ่านป้ายทุกรอบ:
//   slide1.png — ป้ายฟ้า "แนะนำเพื่อน" + "โบนัส 0.8%" (นางแบบอยู่ขวา โลโก้ซ้ายบน)
//   slide2.png — ป้ายฟ้า "คืนยอดเสีย 0.3%" (นางแบบอยู่ซ้าย โลโก้บนกลาง)
//   slide3.png / slide4.png — โปสเตอร์ของแบรนด์ก่อน (29 ก.ย. เก่ากว่าดรอปนี้)
//     ห้าม import กลับมาเด็ดขาด และห้ามลบไฟล์ทิ้งเพราะเป็นอินเวนทอรีของรอบถัดไป
// ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้วและ verify-build จะแดง
// (banner3 ใน src/assets ก็เก่ากว่าดรอปนี้ = อาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// ส่วน banner1 / banner1-mobile / og.png เป็นของ MainLayout และ banner2 เป็นของ
// index.astro — ห้ามอ้างจากหน้านี้)
// ชื่อตัวแปรตั้งตามข้อความบนภาพ ไม่ใช่ตามเลขไฟล์ เพื่อไม่ให้รอบหน้าสลับผิดอีก
import promoCashback from "../assets/slide2.png";
import promoReferral from "../assets/slide1.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้น ๆ "หนึ่งย่อหน้า ประมาณสี่บรรทัด" คือ
// โควตาตัวหนังสือทั้งหมดของหน้านี้, กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อย
// และห้ามเพิ่มย่อหน้า เพราะตัวโปสเตอร์ระบุเปอร์เซ็นต์โบนัสไว้ด้วยตัวอักษรขนาดใหญ่
// อยู่แล้ว การพิมพ์ซ้ำด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ เป้าหมาย h1x1 h2x0 h3x0
//
// สไลด์รอบนี้เป็น **600x533 ทั้งคู่** (วัดจากไฟล์จริง ไม่ใช่ลอกค่าข้ามรอบ)
// วางเป็นกริดสองคอลัมน์ คุมความกว้างรวมที่ max-w-4xl (896px) ทำให้ช่องละ ~436px
// ไม่ต้องอัปสเกลเกินขนาดไฟล์ต้นทาง widths หยุดที่ 600 ตามความกว้างจริงของไฟล์
// และคุมภาพต่อใบไว้ที่ max-w-[600px] สองใบพอดีหนึ่งแถว
// เรียง คืนยอดเสีย 0.3% ก่อน แนะนำเพื่อน 0.8% ตามลำดับของบรีฟ (docx H3 #4 แล้ว #5)
// ซึ่งรอบนี้แปลว่า slide2 มาก่อน slide1
// sizes คิดจากความกว้างที่ถูกวาดจริง: px-4 ของ section (16px/ข้าง) + p-8 ของการ์ด
// (32px/ข้าง, เป็น p-10 = 40px ที่ md ขึ้นไป) + gap-6 (24px) ระหว่างสองคอลัมน์
// LCP คือ hero ใน MainLayout ไม่ใช่สองรูปนี้ จึง loading="lazy" fetchpriority="low"
//
// Announcement รอบนี้หมุนมาเป็น Announcement3 ทั้งเว็บ (แบรนด์ก่อน 789BETTING ใช้
// Announcement5) — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์
// นี้แล้ว และทุกหน้าก็เรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop message มิฉะนั้นตัววิ่ง
// จะพูดคนละเรื่องกัน
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็นแบรนด์ **คู่สีสดบนพื้นกรมท่าเกือบดำ**
// ฟ้าแบรนด์ #0193fb (ขอบ ออรา เงา) · ฟ้าอ่อน #7bcffb (ปลายสว่าง, เงา hover) ·
// เหลืองมะนาว #fce604 เป็นฮิวที่สองจริง (ไฮไลต์ <strong>, ปุ่มถม) ·
// เหลืองอ่อน #fff48a กับเหลืองเข้ม #c9a703 เป็นสองปลายของไล่เฉดปุ่ม ·
// หมึกบนพื้นสว่าง #031018 เท่านั้น (15.0:1 บน #fce604 / 8.7:1 บน #c9a703) ·
// เนื้อความ #dbeafe มาจาก BRAND_TEXT ที่ <html> และการ์ด ContentBox ตั้งให้แล้ว
// จึงไม่ระบุสีที่ย่อหน้า ⚠️ ห้ามพลิกปุ่มพื้นสว่างให้เป็นหมึกสว่าง (เหลือ ~1.2:1)
// ชุดทองเมทัลลิกฮิวเดียวของ 789BETTING ออกครบแล้ว ทั้งคลาส Tailwind raw hex และ
// rgba() (ค่าเดิมอยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีแบรนด์
// เก่าเจอ false positive) ห้ามนำกลับมา
//
// แบรนด์นี้เป็น **เว็บสล็อตออนไลน์ล้วน** ไม่ใช่คาสิโนรวมหมวดและไม่ใช่เว็บหวย —
// คำขายของของแบรนด์ก่อนและศัพท์หมวดอื่นที่บรีฟไม่ได้เอ่ยห้ามหลงเหลือ (รายการเต็ม
// อยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep เจอ false positive)
// ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% / 0.8% / 24 ชั่วโมง ห้ามแต่งยอดฝากขั้นต่ำ
// ชื่อค่ายเกม ชื่อผู้ให้บริการ ชื่อธนาคาร ค่า RTP เลขใบอนุญาต หรือวันหมดเขตแคมเปญ
// และต้องคงคำกำกับของบรีฟไว้ว่าโบนัสที่ได้รับจริงควรยึดรายละเอียดล่าสุดจากระบบ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) หน้านี้ยาว 158 อักขระ
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `รวมภาพโปรโมชั่นของ ${BRAND_NAME} ทั้งคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% คำนวณจากยอดที่เข้าเกณฑ์ ควร Login ตรวจสอบรอบตัดยอด เกมที่เข้าร่วม และเงื่อนไขก่อนรับสิทธิ์`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่น ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});

// ความกว้างที่ถูกวาดจริงของแต่ละช่องในกริดสองคอลัมน์ (ดูคอมเมนต์ sizes ด้านบน)
const promoSizes = "(max-width: 639px) calc(100vw - 96px), (max-width: 767px) calc((100vw - 120px) / 2), (max-width: 1007px) calc((100vw - 136px) / 2), 436px";
const promoClass =
  "mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#0193fb]/35 object-contain shadow-[0_0_28px_rgba(1,147,251,0.30)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#0193fb]/80 hover:shadow-[0_0_40px_rgba(123,207,251,0.45)]";
---

<MainLayout title={`โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% สำหรับยอดที่เข้าเกณฑ์`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`โปรโมชั่น ${BRAND_NAME} ทั้งหมด`} as="h1">
    <div class="flex flex-col gap-10">
      <p class="text-left text-base leading-relaxed">
        หน้านี้รวมภาพโปรโมชั่นที่ <strong class="text-[#fce604]">{BRAND_NAME}</strong> เปิดให้สมาชิกตรวจสอบสิทธิ์ตามช่วงเวลาที่เว็บไซต์กำหนด ทั้งคืนยอดเสียและแนะนำเพื่อน โดยรายละเอียดของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว
        ระบบจะนำยอดที่เข้าเกณฑ์มาคำนวณก่อนแสดงจำนวนโบนัสที่รับได้ <strong class="text-[#fce604]">แต่ละรายการมีรอบตัดยอด เกมที่เข้าร่วม และรอบการรับสิทธิ์ไม่เหมือนกัน และโบนัสที่ได้รับจริงควรยึดรายละเอียดล่าสุดจากระบบเป็นหลัก</strong> จึงควร Login อ่านเงื่อนไขก่อนกดรับสิทธิ์ทุกครั้ง
      </p>

      <div class="mx-auto grid w-full max-w-4xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt={`ภาพโปรโมชั่นของ ${BRAND_NAME} พื้นหลังท้องฟ้าสีฟ้าสดมีเมฆขาว หัวใจสีเหลือง และเหรียญทองลอยอยู่ ด้านซ้ายเป็นหญิงสาวผมสั้นสีขาวเงินขยิบตาและเท้าคางบนมือ สวมชุดเปิดไหล่สีขาว-ฟ้าประดับหัวใจเหลือง ด้านบนกลางเป็นโลโก้ ${BRAND_NAME} ด้านขวาเป็นคำว่า โปรโมชั่น ตัวอักษรสามมิติสีเหลืองใต้มงกุฎเล็ก ถัดลงมาเป็นป้ายโค้งสีฟ้าข้อความ คืนยอดเสีย 0.3% ด้านหลังขวามีตู้สล็อตขึ้นเลข 777 ด้านล่างเป็นกองเหรียญทองและกล่องของขวัญสีขาวผูกโบว์ฟ้า`}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoReferral}
          alt={`ภาพโปรโมชั่นของ ${BRAND_NAME} ฉากท้องฟ้าสีฟ้าสดชุดเดียวกัน มีเมฆขาว ดาว หัวใจ และเหรียญทองเรียงเป็นเสี้ยวโค้ง มุมบนซ้ายเป็นโลโก้ ${BRAND_NAME} กลางซ้ายเป็นคำว่า โปรโมชั่น ตัวอักษรสามมิติสีเหลือง ใต้ลงมาเป็นป้ายโค้งสีฟ้าข้อความ แนะนำเพื่อน และข้อความ โบนัส 0.8% ตัวอักษรสามมิติสีขาว-เหลือง ด้านขวาเป็นหญิงสาวผมสั้นสีขาวเงินขยิบตาและชูนิ้วโป้งสองมือ สวมชุดระบายสีขาว-ฟ้าพร้อมสร้อยคอหัวใจทอง ด้านล่างเป็นเหรียญทอง เหรียญหน้ายิ้ม และกล่องของขวัญผูกโบว์ฟ้า`}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#c9a703] bg-gradient-to-b from-[#fff48a] via-[#fce604] via-55% to-[#c9a703] px-10 py-3.5 text-lg font-black text-[#031018] shadow-[0_0_14px_rgba(252,230,4,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
