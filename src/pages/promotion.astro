---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";

import { Picture } from "astro:assets";

// ดรอปอาร์ตเวิร์กของ หวยเฮง789 คือ 2026-10-01 02:30 และมีโปสเตอร์ที่ใช้ได้แค่สองใบ
// (brand-spec §5) — เปิดไฟล์จริงดูแล้วทั้งคู่ และป้ายบนภาพ "สลับข้าง" กับเลขไฟล์:
//   slide1.png — 600x400 ป้ายใต้หัวเรื่องอ่านว่า "3ตัวจ่าย1,000บาท" (ไม่ใช่ 2 ตัว)
//                หญิงสาวชุดไทยขาว-ทอง ถือลูกหวยขาวเลข 3 และชี้มือมาข้างหน้า
//   slide2.png — 600x400 ป้ายอ่านว่า "2ตัวจ่าย100บาท"
//                หญิงสาวชุดไทยขาว-ทอง ถือลูกหวยแดงเลข 2 คู่กับลูกขาวเลข 5
//   slide3.png / slide4.png — โปสเตอร์ของแบรนด์ก่อน (29 ก.ย. เก่ากว่าดรอปนี้)
//     ห้าม import กลับมาเด็ดขาด และห้ามลบไฟล์ทิ้งเพราะเป็นอินเวนทอรีของรอบถัดไป
// ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้วและ verify-build จะแดง
// (banner2/banner3 ใน src/assets ก็เก่ากว่าดรอปนี้ = อาร์ตเวิร์กแบรนด์ก่อน ห้าม import)
// ชื่อตัวแปรตั้งตามข้อความบนภาพ ไม่ใช่ตามเลขไฟล์ เพื่อไม่ให้รอบหน้าสลับผิดอีก
import promoTwoDigit from "../assets/slide2.png";
import promoThreeDigit from "../assets/slide1.png";
import { pageGraph } from "../lib/schema";
//
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ: ContentBox title, ย่อหน้าเกริ่นสั้น ๆ หนึ่งย่อหน้า
// (ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมดของหน้านี้), กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม
// — ไม่มีหัวข้อย่อยและไม่มีย่อหน้าเพิ่ม เพราะตัวโปสเตอร์ระบุอัตราจ่ายไว้ด้วยตัวอักษร
// ขนาดใหญ่อยู่แล้ว เป้าหมาย h1x1, h2x0, h3x0
//
// สไลด์รอบนี้เป็นแนวนอน 600x400 จึงวางเป็นกริดสองคอลัมน์คุมความกว้างรวมที่ max-w-4xl
// (896px) ทำให้ช่องละ ~436px ไม่ต้องอัปสเกลเกินขนาดไฟล์ต้นทาง widths หยุดที่ 600 ตาม
// ความกว้างจริงของไฟล์ และคุมภาพต่อใบไว้ที่ max-w-[600px] สองใบพอดีหนึ่งแถว กริดจึง
// จัดกลางสมมาตรโดยไม่ต้องมีใบที่ span สองคอลัมน์ · เรียง 2 ตัว ก่อน 3 ตัว ตามบรีฟ
//
// Announcement หมุนมาเป็น Announcement2 ทั้งเว็บรอบนี้ (รอบก่อน หวยเฮง24 ใช้ Announcement5)
// — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ หวยเฮง789 แล้ว และ index
// ก็เรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop message มิฉะนั้นตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ หวยเฮง789 รอบนี้กลับขั้วจากรอบก่อน: "แดงนำ ทองรอง" (รอบก่อน หวยเฮง24 เป็น
// ทองนำ) ตามโลโก้ที่ vivid เด่นเป็นแดงเลือดนก ส่วนทองอยู่ที่ตัวอักษรและเหรียญ:
// พื้นเพจ #000000 · ผิวฐาน #1c0606 · ผิวการ์ด #2b0909 · ผิวลึกสุด #0b0202 ·
// แดงสว่าง #e43434 · แดงแบรนด์ #dc2224 · แดงลึก #ab0204 · แดงมืดสุด/ขอบ #5c0a0a ·
// ทองอ่อน #ffefc2 · ทองรอง #f4bc5d · ทองเข้ม #d99a10 · ทองมืดสุด #a8690c ·
// เนื้อความ #fbe3d4 (BRAND_TEXT) · หมึกบนพื้นทอง #1c0606
// เรืองแสง: ทอง rgba(244,188,93,0.40) · แดง rgba(220,34,36,0.35) · เงา rgba(11,2,2,0.85)
// การ์ดโปสเตอร์ได้ขอบทอง #a8690c ทั้งสองใบ (ทองมืดสุดใช้ได้เฉพาะขอบ/เส้นคั่น ห้ามเป็น
// พื้นหลังของตัวอักษร) เพราะตัวเลขอัตราจ่ายบนภาพทั้งคู่เป็นตัวอักษรทอง
// ปุ่ม CTA เป็นไล่เฉดทอง #ffefc2 → #f4bc5d → #d99a10 และใช้หมึกเข้ม #1c0606
// (ไล่เฉดใต้หมึกเข้มห้ามจบเข้มกว่า #d99a10 ซึ่งวัดได้ 7.0:1 และห้ามใช้หมึกเข้มบนแดง
// แบรนด์ #dc2224 เพราะได้แค่ 3.4:1)
// ชุดทองนำของ หวยเฮง24 (#e0a52a #fdea83 #fbdc64 #bd7c13 #2a0606 #1a0505 #f6e6cf
// #e6c98f #8b0302 #c01616 #5a0202 #3d0808 #2e0707 rgba(224,165,42,*)
// rgba(251,220,100,*) rgba(253,234,131,*) rgba(192,22,22,*) rgba(20,3,3,*))
// ถูกแทนครบทุกจุดแล้ว ทั้งคลาส Tailwind raw hex และ rgba()
//
// หวยเฮง789 เป็นเว็บ "แทงหวยออนไลน์" ไม่ใช่สล็อต ไม่ใช่บอล และไม่ใช่คาสิโน — คำว่า
// สล็อต ฟรีสปิน ตัวคูณ ค่ายเกม RTP แตกง่าย เว็บตรง บอล ค่าน้ำ อัตราต่อรอง ลีก
// บิลสเต็ป แฮนดิแคป คาสิโน บาคาร่า ไพ่ เกมยิงปลา ห้ามปรากฏบนหน้านี้ ตัวเลขที่บรีฟ
// ระบุและใช้ได้มีแค่ 2 ตัว จ่าย 100 บาท · 3 ตัว จ่าย 1,000 บาท · 3 ขั้นตอน · 24 ชั่วโมง
// ห้ามเพิ่มชื่อผู้ให้บริการ ชื่อธนาคาร ยอดฝากขั้นต่ำ เลขใบอนุญาต จำนวนสมาชิก หรือ
// ปีที่ก่อตั้ง และต้องคง hedge ของบรีฟไว้ว่าอัตราจ่ายอาจแตกต่างกันตามประเภทหวยและ
// รูปแบบการเดิมพัน จึงควรตรวจสอบอัตราที่แสดงในหน้าส่งโพยของแต่ละรอบก่อนยืนยัน
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 159
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "รวมภาพอัตราจ่ายของ หวยเฮง789 แบบ 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท อัตราขึ้นอยู่กับประเภทหวยและรูปแบบการเดิมพัน ควรตรวจสอบอัตราในหน้าส่งโพยก่อนยืนยัน";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่นอัตราจ่ายหวย หวยเฮง789",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoTwoDigit.src,
});
---

<MainLayout title="โปรโมชั่นอัตราจ่ายหวย หวยเฮง789 2 ตัว จ่าย 100 บาท 3 ตัว จ่าย 1,000 บาท" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่นอัตราจ่ายหวย หวยเฮง789" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#fbe3d4]">
        หน้านี้รวมภาพอัตราจ่ายที่ <strong class="text-[#ffefc2]">หวยเฮง789</strong> เปิดให้สมาชิกดูรายละเอียดก่อนเลือกรายการและส่งโพย โดยตัวเลขของแต่ละแบบระบุไว้บนภาพด้านล่างแล้ว
        <strong class="text-[#ffefc2]">อัตราจ่ายอาจแตกต่างกันตามประเภทหวยและรูปแบบการเดิมพัน</strong> จึงควรตรวจสอบอัตรา 2 ตัวและ 3 ตัวที่แสดงในหน้าส่งโพยของแต่ละรอบก่อนยืนยันทุกครั้ง
      </p>

      <div class="mx-auto grid w-full max-w-4xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoTwoDigit}
          alt="โปสเตอร์อัตราจ่ายหวยของ หวยเฮง789 พื้นผ้าซาตินสีแดงเข้มมีริ้วแสงทองพาดทั่วภาพ ด้านซ้ายเป็นหญิงสาวผมยาวประดับดอกไม้ขาว สวมชุดไทยสีขาวประดับทองพร้อมสร้อยและกำไลทอง มือซ้ายถือลูกหวยสีแดงหมายเลข 2 คู่กับลูกหวยสีขาวหมายเลข 5 และยื่นมือขวาออกมาข้างหน้า มุมขวาบนมีลูกหวยหมายเลข 8 มุมขวาล่างมีลูกหวยหมายเลข 9 ด้านล่างเป็นกองเหรียญทองและสลากกินแบ่ง ด้านขวาบนเป็นโลโก้ หวยเฮง789 ตัวอักษรแดงคู่ทอง ถัดลงมาเป็นตัวอักษรไทยสีทองขนาดใหญ่ว่า อัตราจ่ายหวย และใต้ลงไปเป็นป้ายขอบทองคาดข้อความ 2ตัวจ่าย100บาท"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), (max-width: 1007px) calc((100vw - 136px) / 2), 436px"
          class="mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#a8690c]/70 object-contain shadow-[0_10px_30px_rgba(11,2,2,0.85)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f4bc5d]/85 hover:shadow-[0_15px_40px_rgba(244,188,93,0.40)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoThreeDigit}
          alt="โปสเตอร์อัตราจ่ายหวยของ หวยเฮง789 ชุดเดียวกัน พื้นผ้าซาตินสีแดงเข้มมีริ้วแสงทองและสลากกินแบ่งเรียงอยู่ริมภาพ ด้านซ้ายเป็นหญิงสาวผมยาวสวมชุดไทยสีขาวประดับทอง มือซ้ายชูลูกหวยสีขาวหมายเลข 3 และยื่นมือขวาชี้มาข้างหน้า มุมขวาล่างมีลูกหวยสีแดงหมายเลข 5 และลูกหวยสีแดงหมายเลข 8 วางอยู่บนกองเหรียญทอง ด้านขวาบนเป็นโลโก้ หวยเฮง789 ตัวอักษรแดงคู่ทอง ถัดลงมาเป็นตัวอักษรไทยสีทองขนาดใหญ่ว่า อัตราจ่ายหวย และใต้ลงไปเป็นป้ายขอบทองคาดข้อความ 3ตัวจ่าย1,000บาท"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), (max-width: 1007px) calc((100vw - 136px) / 2), 436px"
          class="mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#a8690c]/70 object-contain shadow-[0_10px_30px_rgba(11,2,2,0.85)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f4bc5d]/85 hover:shadow-[0_15px_40px_rgba(244,188,93,0.40)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก หวยเฮง789"
          class="flex items-center justify-center rounded-lg border border-[#a8690c]/70 bg-gradient-to-r from-[#ffefc2] via-[#f4bc5d] to-[#d99a10] px-10 py-3.5 text-lg font-black text-[#1c0606] shadow-[0_0_15px_rgba(244,188,93,0.40)] transition-transform hover:scale-105">
          สมัครสมาชิก หวยเฮง789
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
