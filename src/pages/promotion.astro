---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

// อาร์ตเวิร์กของ NEXT55 รอบนี้มีแค่ slide1/slide2 (ลงวันที่ 2026-09-17) — ตรวจจากตัวภาพจริง:
// slide1 คือโปสเตอร์ "แนะนำเพื่อน 0.8%" ส่วน slide2 คือ "คืนยอดเสีย 0.3%"
// (สลับกับลำดับของแบรนด์ก่อนหน้า อย่าคัดลอกลำดับ import เดิม)
// slide3/slide4 (2026-08-13) กับ banner2/banner3 ยังค้างอยู่บนดิสก์แต่เป็นอาร์ตเวิร์ก
// ของลูกค้าเจ้าอื่น — ห้าม import ที่นี่ทั้งรอบนี้และรอบถัดไป
// (ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้ว และ verify-build จะแดง)
import promoReferral from "../assets/slide1.png";
import promoCashback from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็น IMAGE page: ContentBox title, ย่อหน้าเกริ่นสั้น ๆ หนึ่งย่อหน้า, กริดโปสเตอร์,
// ปุ่ม CTA หนึ่งปุ่ม — ไม่มีหัวข้อย่อยและไม่มีย่อหน้าเพิ่ม เพราะตัวโปสเตอร์ระบุเงื่อนไข
// ของแต่ละโปรโมชั่นไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว เป้าหมาย h1×1, h2×0, h3×0
// ลำดับในกริดตามบรีฟ: แนะนำเพื่อน 0.8% มาก่อน คืนยอดเสีย 0.3%
//
// Announcement รอบนี้หมุนมาใช้ Announcement3 ทั้งเว็บ — default message ของไฟล์นั้น
// เป็นข้อความของ NEXT55 อยู่แล้ว จึงเรียกแบบ bare ได้ ห้ามส่ง prop message
//
// พาเลตต์ NEXT55: แดงโลโก้ #cd1437 นำ (ขอบ/เงา) แดงสว่าง #f0435f สำหรับ hover
// ชมพูอ่อน #ffb3bf สำหรับ <strong> พื้นการ์ดกราไฟต์ #17181c เนื้อความ #d5dae2
// ไม่มีสีน้ำเงิน/ฟ้า/ทองในแบรนด์นี้
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 152
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "หน้ารวมโปรโมชั่นของ NEXT55 ทั้งแนะนำเพื่อนรับ 0.8% และคืนยอดเสีย 0.3% แจกให้ทุกยูสเซอร์ทุกวัน ดูเงื่อนไขและวิธีรับสิทธิ์ทั้งหมดได้จากภาพโปรโมชั่นแต่ละใบ";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น NEXT55",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoReferral.src,
});
---

<MainLayout title="โปรโมชั่น NEXT55 แนะนำเพื่อนรับ 0.8% และคืนยอดเสียรับ 0.3%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น NEXT55" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#d5dae2]">
        หน้านี้รวมโปรโมชั่นที่ NEXT55 แจกให้ทุกยูสเซอร์ทุกวัน ทั้งสมาชิกใหม่และสมาชิกเก่า ทั้งแนะนำเพื่อนรับ
        <strong class="text-[#ffb3bf]">0.8%</strong> และคืนยอดเสีย <strong class="text-[#ffb3bf]">0.3%</strong>
        โดยเปอร์เซ็นต์ ยอดที่นำมาคำนวณ และวิธีกดรับสิทธิ์ระบุไว้บนภาพโปรโมชั่นแต่ละใบ
        <strong class="text-[#f0435f]">แต่ละรายการมีเงื่อนไขต่างกัน จึงควรอ่านรอบการคำนวณและเงื่อนไขล่าสุดก่อนกดรับทุกครั้ง</strong>
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อน 0.8% พื้นหลังสีเทาอ่อนมีลายเส้นวงจรและจุดเชื่อมสีแดงเข้ม พร้อมเครื่องหมาย X สีแดงจางเป็นฉากหลัง มุมซ้ายบนเป็นโลโก้ NEXT55 ตรงกลางเป็นข้อความ โปรโมชั่น แนะนำเพื่อน และตัวเลข 0.8% ขนาดใหญ่สีแดงเข้ม บรรทัดล่างเขียนว่า เพื่อรับสิทธิพิเศษวันนี้! ด้านขวาเป็นหญิงสาวในสูทสีเทาถือโทรศัพท์และชี้มือไปที่ตัวเลข"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#7a0a20]/70 object-contain shadow-[0_10px_30px_rgba(12,13,16,0.75)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#cd1437]/75 hover:shadow-[0_15px_40px_rgba(205,20,55,0.35)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่นคืนยอดเสีย 0.3% พื้นหลังสีเทาถ่านเข้มมีลายเส้นเทคโนโลยีสีอ่อนและเหรียญทองกระจายอยู่ด้านซ้าย มุมซ้ายบนเป็นโลโก้ NEXT55 สีขาว ตรงกลางเป็นข้อความสีขาวว่า โปรโมชั่น และบรรทัดถัดมาว่า คืนยอดเสีย 0.3% ด้านขวาเป็นหญิงสาวในสูทสีเทาสวมเสื้อสีแดงชี้มือขึ้นไปทางข้อความ"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#7a0a20]/70 object-contain shadow-[0_10px_30px_rgba(12,13,16,0.75)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#cd1437]/75 hover:shadow-[0_15px_40px_rgba(205,20,55,0.35)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก NEXT55"
          class="flex items-center justify-center rounded-lg border border-[#cd1437]/70 bg-gradient-to-r from-[#f0435f] via-[#cd1437] to-[#7a0a20] px-10 py-3.5 text-lg font-black text-[#e7eaef] shadow-[0_0_15px_rgba(205,20,55,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก NEXT55
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
