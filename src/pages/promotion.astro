---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";

import { Picture } from "astro:assets";

// ดรอปอาร์ตเวิร์กของ BRAZIL999 คือ 2026-09-25 และมีสไลด์ที่ใช้ได้สองใบเท่านั้น:
//   slide1.png — โปสเตอร์ "โปรโมชั่น แนะนำเพื่อน โบนัส 0.8%"
//   slide2.png — โปสเตอร์ "โปรโมชั่น คืนยอดเสีย โบนัส 0.3%"
// บทบาทของสองไฟล์นี้ "สลับกัน" ระหว่างแบรนด์มาแล้ว และรอบก่อนผูกกลับด้าน
// กับรอบนี้ อย่าเชื่อชื่อตัวแปรที่ตกทอดมาและอย่าคัดลอก import จากประวัติ git —
// รอบนี้เปิดไฟล์ดูจริงแล้ว ตรงกับคำอธิบายอาร์ตเวิร์กใน brand-spec §5 ทั้งสองใบ
//
// ไฟล์สไลด์ลำดับที่สามและสี่ใน src/assets เก่ากว่าดรอปรอบนี้ (2026-09-18 และ
// 2026-08-13) เป็นอาร์ตเวิร์กของลูกค้าเจ้าก่อน — ห้าม import กลับมา และห้ามลบทิ้ง
// เพราะเป็นอินเวนทอรี (ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้ว
// และ verify-build จะแดง) ถ้ามีสไลด์ใหม่เข้ามาให้เช็ก mtime เทียบดรอปก่อนเพิ่ม
// กริดรอบนี้จึงมีสองช่องเท่านั้น ห้ามเติมให้เต็มด้วยของเก่า
import promoReferral from "../assets/slide1.png";
import promoCashback from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";
//
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ: ContentBox title, ย่อหน้าเกริ่นสั้น ๆ หนึ่งย่อหน้า
// (ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมดของหน้านี้), กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม
// — ไม่มีหัวข้อย่อยและไม่มีย่อหน้าเพิ่ม เพราะตัวโปสเตอร์ระบุชื่อโปรและเปอร์เซ็นต์โบนัส
// ไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว เป้าหมาย h1x1, h2x0, h3x0
//
// สไลด์เป็นแบนเนอร์แนวนอน 600x400 จึงวางเป็นกริดสองคอลัมน์คุมความกว้างรวมที่ max-w-5xl
// (1024px) ทำให้ช่องละ ~488px ไม่ต้องอัปสเกลเกินขนาดไฟล์ต้นทาง widths หยุดที่ 600
// ตามความกว้างจริงของไฟล์ (candidate ที่ใหญ่กว่านั้นไม่มีของให้ครอป)
//
// Announcement หมุนมาเป็น Announcement2 ทั้งเว็บรอบนี้ — default message ของไฟล์
// นั้นถูกตั้งเป็นคอปปี้ของ BRAZIL999 แล้ว และ index ก็เรียกแบบ bare เหมือนกัน
// จึงห้ามส่ง prop
//
// พาเลตต์ BRAZIL999 (เขียว + เงินโครเมียมบนดำ ตามโลโก้ที่ BRAZIL เป็นโครเมียมเงิน
// และ 999 เป็นเขียวสด ทองเป็นแอ็กเซนต์ที่สามใช้เฉพาะจุดเล็ก ๆ ห้ามนำหน้า):
// พื้นเพจ #040a05 · ผิวการ์ด #0a1a0c · ผิวยก #123a18 · ขอบลึก #1c5a26 ·
// เขียวแบรนด์ #22c55e · เขียวลึก #0a6b18 · เขียวเข้มสุด #04380c ·
// เขียวสว่าง #7cf25c · เขียวอ่อนสุด #b6ff9c · เงินโครเมียมกลาง #aab4bf ·
// เงินโครเมียมสว่าง #f1f5f9 · เงินโครเมียมเข้ม #6b7580 · ทองแอ็กเซนต์ #e8c65a ·
// เนื้อความ #dfeadd (BRAND_TEXT) · เน้นใน strong #f4fbf2
// การ์ดโปสเตอร์ใบซ้ายได้ขอบเขียว ใบขวาได้ขอบเงินโครเมียม เพื่อให้กริดอ่านเป็นเขียว+โครเมียม
// ตัวอักษรบนพื้นเขียวต้องเป็นเขียวเข้มสุด #04380c ห้ามใช้ขาว
//
// BRAZIL999 เป็นแบรนด์คาสิโน — ศัพท์ของบรีฟคือ "ช่องทางไลน์" ไม่ใช่ "ไลน์แอด"
// (คำของแบรนด์ก่อนหน้า) และบรีฟไม่ได้ระบุชื่อค่ายเกม ประเภทเกมเจาะจง หรือช่องทางฝากถอน
// จึงห้ามเขียนเพิ่มในหน้านี้
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 158
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "รวมโปรโมชั่น BRAZIL999 ทั้งโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% ดูรายละเอียดยอดที่เข้าเกณฑ์ รอบคำนวณ และเงื่อนไขของแต่ละรายการก่อนกดรับสิทธิ์ทุกครั้ง";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น BRAZIL999",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoReferral.src,
});
---

<MainLayout title="โปรโมชั่น BRAZIL999 แนะนำเพื่อน โบนัส 0.8% และคืนยอดเสีย โบนัส 0.3%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น BRAZIL999" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#dfeadd]">
        หน้านี้รวมภาพโปรโมชั่นที่ <strong class="text-[#f4fbf2]">BRAZIL999</strong> เปิดให้สมาชิกกดรับตามรายการและช่วงเวลาที่กำหนด ทั้งโบนัสแนะนำเพื่อนและโบนัสคืนยอดเสีย โดยรายละเอียดของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว
        <strong class="text-[#f4fbf2]">ยอดที่เข้าเกณฑ์ รอบคำนวณ และเงื่อนไขของแต่ละรายการแตกต่างกัน</strong> จึงควรตรวจสอบรายละเอียดล่าสุดจากหน้าเว็บไซต์อีกครั้งก่อนกดรับสิทธิ์ทุกครั้ง
      </p>

      <div class="mx-auto grid w-full max-w-5xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่นพื้นดำไล่เขียว ด้านบนเป็นโลโก้ BRAZIL999 ที่คำว่า BRAZIL เป็นตัวอักษรเงินโครเมียมและเลข 999 เป็นสีเขียวสด ใต้โลโก้มีมงกุฎทองดวงเล็ก ถัดลงมาเป็นข้อความไทยตัวใหญ่ว่า โปรโมชั่น สีขาวและ แนะนำเพื่อน สีเขียว แล้วเป็นแผ่นป้ายเขียวข้อความว่า โบนัส 0.8% ด้านขวาเป็นหญิงสาวผมยาวสีเข้มในชุดสูทขาวยิ้มและชี้นิ้วชี้ทั้งสองข้างมาที่ข้อความ รอบภาพมีชิปคาสิโนสีเขียวสลับดำและไพ่เอซโพดำกระจายอยู่"
          loading="lazy"
          fetchpriority="low"
          widths={[340, 480, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), 488px"
          class="mx-auto h-auto w-full rounded-xl border border-[#22c55e]/55 object-contain shadow-[0_10px_30px_rgba(4,10,5,0.80)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#7cf25c]/75 hover:shadow-[0_15px_40px_rgba(34,197,94,0.40)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่นชุดเดียวกันแต่สลับข้าง พื้นดำไล่เขียว ด้านซ้ายเป็นหญิงสาวผมยาวสีเข้มในชุดสูทขาวยิ้มและถือไพ่เอซคลี่เป็นพัดไว้ในมือ ด้านขวาบนเป็นโลโก้ BRAZIL999 ที่คำว่า BRAZIL เป็นตัวอักษรเงินโครเมียมและเลข 999 เป็นสีเขียวสด ถัดลงมาเป็นข้อความไทยว่า โปรโมชั่น และ คืนยอดเสีย แล้วเป็นแผ่นป้ายเขียวขลิบทองข้อความว่า โบนัส 0.3% ขอบล่างของภาพมีเหรียญทองกองอยู่และมงกุฎทองหนึ่งดวง"
          loading="lazy"
          fetchpriority="low"
          widths={[340, 480, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), 488px"
          class="mx-auto h-auto w-full rounded-xl border border-[#aab4bf]/45 object-contain shadow-[0_10px_30px_rgba(4,10,5,0.80)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f1f5f9]/70 hover:shadow-[0_15px_40px_rgba(170,180,191,0.28)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก BRAZIL999"
          class="flex items-center justify-center rounded-lg border border-[#7cf25c]/60 bg-gradient-to-r from-[#b6ff9c] via-[#22c55e] to-[#0a6b18] px-10 py-3.5 text-lg font-black text-[#04380c] shadow-[0_0_15px_rgba(34,197,94,0.50)] transition-transform hover:scale-105">
          สมัครสมาชิก BRAZIL999
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
