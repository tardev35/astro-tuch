---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

// ดรอปอาร์ตเวิร์กของ UP555 คือ 2026-10-03 และมีโปสเตอร์ที่ใช้ได้แค่สองใบ
// (brand-spec §6) — ทั้งคู่ขนาด 600x600 (ห้ามเดาจากชื่อไฟล์ และห้ามเชื่อคอมเมนต์
// ของรอบก่อน ต้องยึดสเปกของรอบนี้):
//   slide2.png — มงกุฎทองใต้คำว่า โปรโมชั่น แล้วป้ายคาด "คืนยอดเสีย โบนัส" + 0.3%
//   slide1.png — ป้ายดำขอบทองใต้คำว่า โปรโมชั่น อ่านว่า "แนะนำเพื่อน โบนัส 0.8%"
//   slide3.png / slide4.png — โปสเตอร์ของแบรนด์ก่อน (29 ก.ย. เก่ากว่าดรอปนี้)
//     ห้าม import กลับมาเด็ดขาด และห้ามลบไฟล์ทิ้งเพราะเป็นอินเวนทอรีของรอบถัดไป
// ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้วและ verify-build จะแดง
// (banner2/banner3 ใน src/assets ก็เก่ากว่าดรอปนี้ = อาร์ตเวิร์กแบรนด์ก่อน ห้าม import)
// ส่วน banner1 / banner1-mobile / og.png เป็นของ MainLayout ห้าม import จากหน้านี้
// ชื่อตัวแปรตั้งตามข้อความบนภาพ ไม่ใช่ตามเลขไฟล์ เพื่อไม่ให้รอบหน้าสลับผิดอีก
import promoCashback from "../assets/slide2.png";
import promoReferral from "../assets/slide1.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้น ๆ "หนึ่งย่อหน้า ประมาณสี่บรรทัด" คือ
// โควตาตัวหนังสือทั้งหมดของหน้านี้, กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อย
// และห้ามเพิ่มย่อหน้า เพราะตัวโปสเตอร์ระบุชื่อโปรและเปอร์เซ็นต์ไว้ด้วยตัวอักษรขนาดใหญ่
// อยู่แล้ว การพิมพ์ซ้ำด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ เป้าหมาย h1x1 h2x0 h3x0
//
// สไลด์รอบนี้เป็น 600x600 จึงวางเป็นกริดสองคอลัมน์คุมความกว้างรวมที่ max-w-4xl
// (896px) ทำให้ช่องละ ~436px ไม่ต้องอัปสเกลเกินขนาดไฟล์ต้นทาง widths หยุดที่ 600 ตาม
// ความกว้างจริงของไฟล์ และคุมภาพต่อใบไว้ที่ max-w-[600px] สองใบพอดีหนึ่งแถว กริดจึง
// จัดกลางสมมาตรโดยไม่ต้องมีใบที่ span สองคอลัมน์ · เรียงคืนยอดเสีย 0.3% ก่อนแนะนำเพื่อน
// 0.8% ตามลำดับของบรีฟ (docx H3 #4 แล้วค่อย #5) · LCP คือ hero ใน MainLayout ไม่ใช่
// สองรูปนี้ จึง loading="lazy" fetchpriority="low" ทั้งคู่
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ (รอบก่อน DM899 ใช้
// Announcement3) — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ UP555
// แล้ว และทุกหน้าก็เรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop message มิฉะนั้นตัววิ่ง
// จะพูดคนละเรื่องกันระหว่างหน้าแรกกับหน้านี้
//
// พาเลตต์ UP555 (brand-spec §2) ทองนำ เงินโครเมียมรอง บนดำอมน้ำตาล — มาจาก logo.webp
// ที่เป็นตัว U/UP สีเงินโครเมียม (#d5d4d3 #f3f3f2) คู่กับลูกศร วงรี และเลข 555 สีทอง
// (#ebbb54 #fce675 #ab6d24): ทองแบรนด์ #ebbb54 (ขอบรูป ปุ่มรอง) · ทองสว่าง #fce675
// (หมึก strong, hover ขอบ, ต้นไล่เฉดปุ่มหลัก) · ทองเข้ม #ab6d24 (ปลายไล่เฉด, ขอบ) ·
// พื้นลึกสุด #0c0502 (เงารูป) · พื้นการ์ด #130b03 · พื้นชิป/ป้าย #241705 ·
// หมึกบนพื้นทอง #160d02 · เนื้อความ #f8eed9 (BRAND_TEXT มาจาก <html> และการ์ด
// ContentBox ตั้งให้แล้ว จึงไม่ต้องระบุสีที่ย่อหน้า)
// กฎคอนทราสต์: ปุ่มสมัคร = ไล่เฉดทอง #fce675 → #ebbb54 → #ab6d24 หมึกดำอมน้ำตาล
// #160d02 (>=7:1 ทุกสต็อป) · ออราและเงาใช้ rgba(235,187,84,α) กับ rgba(12,5,2,α)
// ชุดเขียวมรกต-แดง-ทองของ DM899 (#01a326 #4ade6b #12c23a #01841b #fb252b #ff6b6e
// #ffe9a8 #f2b422 #a8780f #030a05 #0a1a0e #102a16 #06140a #e4f2e4 rgba(1,163,38,*)
// rgba(3,10,5,*) rgba(251,37,43,*)) ถูกแทนครบทุกจุดแล้ว ทั้งคลาส Tailwind raw hex
// และ rgba()
//
// UP555 เป็น "คาสิโนอัปเดตล่าสุด" ที่มีหวยเป็นหนึ่งในหมวดเกม — ไม่ใช่เว็บหวย และ
// ไม่ใช่ "เว็บตรงต่างประเทศ / บัญชีบริษัทแท้ 100% / ไม่ผ่านเอเย่นต์" (ของ DM899 และ
// 1SS365 รอบก่อน) ชุดคำนั้นห้ามหลงเหลือ · ถึงหวยจะเป็นหมวดเกมจริง ก็ห้ามลิงก์ไป
// /ตรวจหวย หรือ /แนวทาง เพราะสองหน้านั้นอยู่ใน src/pages-disabled/ (เราต์ตายและ
// build แดง) · ตัวเลขที่บรีฟระบุและใช้ได้มีแค่ คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% ·
// 3 ขั้นตอน · 24 ชั่วโมง ห้ามเพิ่มใบอนุญาต ชื่อหน่วยงานกำกับ ชื่อค่ายเกม ชื่อธนาคาร
// ยอดฝากขั้นต่ำ จำนวนสมาชิก ปีที่ก่อตั้ง หรือค่า RTP · และต้องคงคำกำกับของบรีฟไว้ว่า
// แต่ละรายการอาจกำหนดประเภทเกม ยอดที่ใช้คำนวณ รอบตัดยอด และระยะเวลารับโบนัสต่างกัน
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 156
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `รวมภาพโปรโมชั่นคาสิโน ${BRAND_NAME} ทั้งโบนัสคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8% ควรตรวจสอบเกมที่ร่วมรายการ รอบตัดยอด และยอดที่เข้าเกณฑ์จากบัญชีก่อนกดรับสิทธิ์`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่นคาสิโน ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});
---

<MainLayout title={`โปรโมชั่นคาสิโน ${BRAND_NAME} คืนยอดเสีย โบนัส 0.3% และแนะนำเพื่อน โบนัส 0.8%`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`โปรโมชั่นคาสิโน ${BRAND_NAME}`} as="h1">
    <div class="flex flex-col gap-10">
      <p class="text-left text-base leading-relaxed">
        หน้านี้รวมภาพโปรโมชั่นที่ <strong class="text-[#fce675]">{BRAND_NAME}</strong> เปิดให้สมาชิกตรวจสอบตามแคมเปญของแต่ละช่วง ทั้งโปรโมชั่นคืนยอดเสียและกิจกรรมแนะนำเพื่อน โดยรายละเอียดของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว
        <strong class="text-[#fce675]">แต่ละรายการอาจกำหนดประเภทเกม ยอดที่ใช้คำนวณ รอบตัดยอด และระยะเวลารับโบนัสแตกต่างกัน</strong> จึงควร Login อ่านเงื่อนไขล่าสุดจากบัญชีสมาชิกก่อนเลือกรับทุกครั้ง
      </p>

      <div class="mx-auto grid w-full max-w-4xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt="ภาพโปรโมชั่นของ UP555 พื้นหลังสีดำอมทอง มีประกายทองและเหรียญทองลอยกระจาย ด้านซ้ายเป็นหญิงสาวผมยาวสีน้ำตาล สวมชุดสีขาวประดับทองและสร้อยคอ ชี้นิ้วมือขวาขึ้นและยื่นมือซ้ายแบออกมาข้างหน้า ด้านล่างมีกองเหรียญทองและไพ่ มุมบนเป็นโลโก้ UP555 ตัว U สีเงินโครเมียมมีลูกศรทองล้อมด้วยวงรีทอง ตามด้วย UP สีเงินและ 555 สีทอง ถัดลงมาเป็นมงกุฎทองและตัวอักษรไทยสีทองขนาดใหญ่ว่า โปรโมชั่น ใต้ลงมาเป็นป้ายคาดข้อความ คืนยอดเสีย โบนัส กับตัวเลข 0.3% ขนาดใหญ่"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), (max-width: 1007px) calc((100vw - 136px) / 2), 436px"
          class="mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#ebbb54]/60 object-contain shadow-[0_10px_30px_rgba(12,5,2,0.85)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fce675]/85 hover:shadow-[0_15px_40px_rgba(235,187,84,0.40)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoReferral}
          alt="ภาพโปรโมชั่นของ UP555 พื้นหลังสีดำอมทอง มีประกายทองและเหรียญทองลอยกระจาย ด้านขวาเป็นหญิงสาวผมยาวสีน้ำตาล สวมชุดสีขาวประดับทอง ยกมือทั้งสองข้างแบออกมาข้างหน้า ด้านซ้ายล่างมีกองชิปคาสิโนสีดำขอบทองและไพ่เอซ มุมบนเป็นโลโก้ UP555 ตัว U สีเงินโครเมียมมีลูกศรทองล้อมด้วยวงรีทอง ตามด้วย UP สีเงินและ 555 สีทอง ถัดลงมาเป็นตัวอักษรไทยสีทองขนาดใหญ่ว่า โปรโมชั่น และป้ายพื้นดำขอบทองคาดข้อความ แนะนำเพื่อน โบนัส 0.8%"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), (max-width: 1007px) calc((100vw - 136px) / 2), 436px"
          class="mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#ebbb54]/60 object-contain shadow-[0_10px_30px_rgba(12,5,2,0.85)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fce675]/85 hover:shadow-[0_15px_40px_rgba(235,187,84,0.40)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#ab6d24] bg-gradient-to-r from-[#fce675] via-[#ebbb54] to-[#ab6d24] px-10 py-3.5 text-lg font-black text-[#160d02] shadow-[0_0_15px_rgba(235,187,84,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
