---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

// ดรอปรอบนี้ (2026-10-24, brand-spec §6) มีสไลด์ที่ใช้ได้ **สองใบ** และชื่อ
// ตัวแปรตั้งตามข้อความที่พิมพ์อยู่บนภาพจริง (เปิดบิตแมปอ่านเองแล้วรอบนี้) ไม่ใช่ตาม
// เลขไฟล์ — ถ้ารอบหน้าเจอความขัดแย้ง **ให้เชื่อข้อความบนรูป**:
//   slide1.png (mtime 2026-10-24, ดรอปนี้) — โปสเตอร์ "โปรโมชั่น / คืนยอดเสีย / 0.3%"
//   slide2.png (mtime 2026-10-24, ดรอปนี้) — โปสเตอร์ "โปรโมชั่น / แนะนำเพื่อน / 0.8%"
//   slide3.png / slide4.png (mtime 2026-09-29 = คนละดรอป คนละแบรนด์) — **ห้าม import**
//   banner2.png / banner3.png (mtime 2026-10-23 = อาร์ตเวิร์กของอีกแบรนด์) —
//     **ห้าม import** รอบนี้ไม่มี "รูปประกอบบทความ" เลย
// ⚠️ การจับคู่พลิกไปมาระหว่างดรอป เพราะ uploader เขียนทับ slide1/slide2 ทุกครั้ง
// เลขไฟล์จึงไม่มีความหมายข้ามแบรนด์ ต้องเปิดบิตแมปดูทุกรอบ — ดรอปนี้ตรวจจากภาพแล้วว่า
// **คืนยอดเสียอยู่บน slide1 และแนะนำเพื่อนอยู่บน slide2**
// ⚠️ eager import = emit ลง dist/ ต่อให้ไม่ได้ render และ verify-build จะแดง
// การ import ไฟล์เก่าคือการส่งรูปของลูกค้ารายอื่นขึ้นเว็บนี้
// **ห้ามลบไฟล์เก่าทิ้ง** — เป็นอินเวนทอรีของรอบถัดไป แค่ห้าม import
// (banner1 / banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักชื่อไว้เอง —
// ห้ามอ้างจากหน้านี้) รอบนี้หน้านี้จึงมีเฉพาะสไลด์สองใบ
import promoCashback from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้นๆ ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมด
// ของหน้านี้, กริดภาพโปรโมชั่น, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อยและห้ามเพิ่มย่อหน้า
// เพราะโปสเตอร์ระบุชื่อรายการและเปอร์เซ็นต์ของตัวเองด้วยตัวอักษรขนาดใหญ่อยู่แล้ว
// การพิมพ์ซ้ำด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ บรีฟรอบนี้
// (src/assets/content.txt) ไม่มีส่วน SUB-PAGES เลย ย่อหน้าทุกย่อหน้าที่เคยอยู่บนหน้านี้
// จึงเป็นของที่รีแบรนด์รอบก่อนๆ แต่งขึ้นเอง — รอบนี้คงไว้เพียงย่อหน้าเกริ่นเดียว
// และเขียนขึ้นใหม่จากบรีฟ (content.txt บรรทัด 16, 18 และ 20)
//
// ลำดับในกริดตามลำดับของบรีฟ: คืนยอดเสีย 0.3% (หัวข้อ H3 บรรทัด 17 เนื้อ 18) มาก่อน
// แนะนำเพื่อน 0.8% (หัวข้อ H3 บรรทัด 19 เนื้อ 20) → promoCashback (slide1) อยู่ช่องแรก
// ⚠️⚠️ **บิตแมปจริงของดรอปนี้คือ 375x600 แนวตั้ง** (วัดจาก IHDR ของไฟล์เองรอบนี้)
// ความกว้างสูงสุดคือ 375 widths จึงหยุดที่ 375 และคุมที่ max-w-[375px]
// **ให้วัดใหม่ทุกรอบจากไฟล์จริง อย่าเชื่อสัดส่วนของรอบก่อน และห้ามขยายเกินต้นฉบับ**
// sizes คิดจากความกว้างที่ถูกวาดจริง: section px-4 (16px/ข้าง) + การ์ด p-8
// (32px/ข้าง, เป็น p-10 = 40px ที่ md ขึ้นไป) + gap-6 ระหว่างคอลัมน์ (24px)
//   ใต้ 640px = คอลัมน์เดียว → 100vw-96px
//   640-767px = สองคอลัมน์ p-8 → 50vw-60px
//   768-885px = สองคอลัมน์ p-10 → 50vw-68px
//   ตั้งแต่ 886px ขึ้นไปชนเพดาน 375px (การ์ดเองกว้างสุด 1400px จึงยังไม่ชน
//   เพดานของการ์ดก่อน)
// LCP คือ hero ใน MainLayout ไม่ใช่รูปพวกนี้ จึง loading="lazy" fetchpriority="low"
// decoding="async" และ quality ตัวเดียวทั้ง avif/webp — ห้ามจูนแยกฟอร์แมต
// (tools/avif-quality-service.mjs ย่อฝั่ง avif ให้เองที่ x0.65)
//
// quality={64} ไม่ใช่ 80 ตามปกติ: สไลด์ทั้งสองเป็นภาพถ่ายคนในสตูดิโอ บวกตัวอักษรไทย
// สามมิติผิวเจลมันเงาที่มีไฮไลต์และขอบคมทับอยู่ด้านบน ซึ่งเป็นเคสที่ AVIF ทำได้แย่ที่สุด
// ที่ quality=80 ไฟล์ AVIF มีโอกาสออกมา **ใหญ่กว่า** WebP ที่เป็น fallback ของตัวเอง
// เบราว์เซอร์ที่รองรับ AVIF จะหยิบไฟล์ที่หนักกว่าไปใช้ และ verify-build.mjs ทำให้
// build แดงด้วยเหตุนี้ตรงๆ · ทางแก้คือ quality ที่ **ต่ำลง** ไม่ใช่สูงขึ้น ·
// ค่าเดียวกันนี้ต้องใช้ที่ index.astro กับสไลด์คู่เดียวกัน
//
// Announcement รอบนี้หมุนมาเป็น Announcement3 ทั้งเว็บ (brand-spec §3 — รอบก่อนใช้
// ตัวฐาน Announcement.astro จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้น
// เป็นคอปปี้ของแบรนด์นี้ไว้แล้ว และทุกหน้าเรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop
// message มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกันระหว่างหน้า
//
// ───────────────────────────────────────────────────────────────────────────
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) **ยังเป็นธีมสว่างเหมือนรอบก่อน แต่คนละฮิวสิ้นเชิง**
// bg.json ของดรอปนี้คือ {"mode":"color","color":"#ffd6fa"} = **ชมพูบับเบิลกัมพาสเทล**
// (รอบก่อนเป็นฟ้าสกายอิ่มตัว — อ่านจากไฟล์ทุกรอบ ห้ามเดา)
// **ห้าม "แก้" การ์ดกลับไปเป็นพื้นมืด** การ์ดมืดบนหมึก #6a0f3c = ตัวอักษรหายไปเลย
// ลำดับผิว: พื้นเพจ #ffd6fa / การ์ด #ffffff (ContentBox) / ผิวยก #fff4fb /
// wash #ffe3f5 · เส้น #f9b2d9 · เส้นเข้ม #f479b9 (**ทั้งคู่ห้ามถือตัวอักษร**)
// หมึก #6a0f3c = เนื้อความ (= BRAND_TEXT ที่ <html> และการ์ด ContentBox ตั้งให้แล้ว
// 12.1:1 บนการ์ดขาว) · หมึกรอง #95486b (6.2:1)
// ชมพูลึก #9c0f55 = สีของ <strong> ในเนื้อความ (8.1:1 บนการ์ดขาว) และหัวข้อ
// 🚨🚨 **#fb439b บนพื้นขาวได้แค่ 3.3:1 ห้ามเป็นสีตัวอักษร** และ **ห้ามถมพื้น #fb439b
// แล้ววางหมึกขาว** (3.3:1 เหมือนกัน) — พื้นชมพูที่รับหมึกขาวได้ต้องเป็น #d91a73
// (4.8:1) ลงไป
// ปุ่ม CTA ของหน้านี้เป็น **PRIMARY = ไล่เฉดชมพูเข้ม** #d91a73 → #b01160 → #85094a
// บนหมึก **ขาว #ffffff** (4.8 / 6.8 / 9.8:1 ต่อ stop) ตรงกับปุ่มสมัครสมาชิก
// ที่ /contact-us /ทางเข้า /register
// แผ่นไฮไลต์ด้านบนปุ่มจำกัดที่ white/10 (ผสมแล้ว stop บนเหลือ ~4.5:1 ยังผ่าน AA
// สำหรับตัวอักษรขนาดใหญ่ของปุ่มนี้)
// rgba() ที่อนุญาตรอบนี้: rgba(251,67,155,α) · rgba(255,194,226,α) ·
// rgba(156,15,85,α) · rgba(106,15,60,α) · rgba(249,178,217,α)
// ⚠️⚠️ **รอบนี้ไม่มีฟ้าไม่มีไซแอนไม่มีน้ำเงินเลยสักเฉด ไม่มีทอง ไม่มีเหลือง ไม่มีส้ม
// ไม่มีแดง ไม่มีม่วง ไม่มีครีม ไม่มีเบจ ไม่มีเทาเงิน ไม่มีเขียว (ยกเว้น LINE green
// ที่หน้าอื่น)** และ **ฟ้า/น้ำเงินของแบรนด์ขาออกห้ามเหลือสักค่า** (ชื่อและค่าอยู่ใน
// brand-spec §2)
// ⚠️⚠️ กับดักที่แหลมที่สุดรอบนี้คือ **ชมพู/แมเจนต้าของแบรนด์อื่น** ซึ่งเป็นตระกูล
// เดียวกับรอบนี้ (แบรนด์เมื่อสองรอบก่อนเป็นชมพูเหมือนกัน) ให้เทียบเป็น "ค่า"
// ทีละหลักกับตารางใน brand-spec §2 ห้ามตัดสินด้วยสายตา
// · หมูการ์ตูนชมพู เหรียญทอง ดาวเหลือง กล่องของขวัญ ฉากสตูดิโอขาว และสีผิวนักแสดงใน
// อาร์ตเวิร์กเป็น **วัตถุในภาพ ไม่ใช่สี UI** · <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง"
// ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดกลางคำ บรรทัดจะตัดกลางคำ
//
// ⚠️ แกนของแบรนด์รอบนี้คือ **เว็บสล็อตเงินดี ทางเข้าเล่นง่าย ยูสใหม่แตกไว**
// คำนิยามตัวเองของแบรนด์ก่อนๆ ห้ามเหลือ โดยเฉพาะศัพท์หมวดลอตเตอรีทั้งชุด
// (brand-spec §5 ไม่พิมพ์ซ้ำที่นี่) สองหน้าของหมวดนั้น **ปิดอยู่รอบนี้** (อยู่ใน
// src/pages-disabled/) หน้านี้จึงไม่มีอะไรให้ลิงก์ไป และโควตาปุ่มของหน้านี้คือ
// ปุ่มเดียวอยู่แล้ว
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 3 ขั้นตอน · 24ชม.
// **ไม่มีอัตราคืนรางวัลเป็นตัวเลข ไม่มีจำนวนเกม/ค่าย ไม่มียอดขั้นต่ำเป็นตัวเลข
// ไม่มีอัตราจ่าย ไม่มีเปอร์เซ็นต์เต็มจำนวน และไม่มียอดเดิมพันต่อรอบเป็นตัวเลข
// (สองตัวหลังเป็นของรอบก่อน — ค่าเต็มอยู่ใน brand-spec §5)**
// ห้ามแต่งตัวเลขการเงิน ชื่อธนาคาร เลขใบอนุญาต ปีก่อตั้ง หรือจำนวนสมาชิก
// และต้องคงประโยคกำกับของบรีฟไว้ว่า **แต่ละรายการอาจมีเงื่อนไขแตกต่างกัน จึงควร
// ติดตามประกาศโปรโมชั่นล่าสุดและตรวจสอบข้อกำหนดให้ครบถ้วนก่อนรับสิทธิ์**
// (content.txt บรรทัด 16)
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงนี้ยาว 151 ด้วยชื่อแบรนด์ 7 อักขระของรอบนี้
// (รอบก่อนชื่อยาว 10 → ต้องนับใหม่ทุกรอบ ห้ามสืบทอดความยาวข้ามแบรนด์)
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `รวมโปรโมชั่น ${BRAND_NAME} ไว้ในหน้าเดียว ทั้งคืนยอดเสีย 0.3% และแนะนำเพื่อนรับโบนัส 0.8% แต่ละรายการมีเงื่อนไขต่างกัน จึงควรตรวจสอบประกาศล่าสุดก่อนรับสิทธิ์`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่น ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});

// ความกว้างที่ถูกวาดจริงของแต่ละคอลัมน์ในกริดสองคอลัมน์ (ดูคอมเมนต์ sizes ด้านบน)
const promoSizes = "(max-width: 639px) calc(100vw - 96px), (max-width: 767px) calc(50vw - 60px), (max-width: 885px) calc(50vw - 68px), 375px";

const promoClass =
  "mx-auto h-auto w-full max-w-[375px] rounded-xl border border-[#f9b2d9] object-contain shadow-[0_8px_28px_rgba(156,15,85,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fb439b] hover:shadow-[0_12px_40px_rgba(251,67,155,0.3)]";

// alt ทั้งสองเขียนจากบิตแมปของดรอปนี้ที่เปิดอ่านเองแล้ว (**375x600 แนวตั้ง** ทั้งคู่) —
// ฉากพื้นขาวอมชมพู ผู้หญิงผมยาวสีน้ำตาลเข้ม ผูกโบว์ชมพูที่ผม ยกโทรศัพท์เคสชมพูขึ้น
// กลางภาพ · หมูการ์ตูนชมพูมีปีกกอดหัวใจอยู่ริมซ้าย · ตัวอักษรไทยสามมิติทรงเจลลี่ชมพู
// ตัดขอบขาวว่า โปรโมชั่น พร้อมไอคอนโทรโข่งชมพู · แคปซูลขาวใส่ชื่อรายการ ·
// ตัวเลขเปอร์เซ็นต์ตัวโต · แคปซูลขอบชมพูท้ายภาพเขียนว่า แจกโบนัสทั้งวัน ·
// หัวใจชมพู เหรียญทอง และกล่องของขวัญชมพูลอยรอบตัวอักษร · โลโก้มุมบนซ้ายทั้งสองใบ
// ⚠️ alt คือ "ข้อความที่พิมพ์อยู่บนโปสเตอร์" เป็นหลัก — ตัวเลขท้าย alt ต้องตรงกับรูป
// ⚠️ ห้ามเรียกรูปคู่นี้ว่าภาพแนวนอนหรือภาพสี่เหลี่ยมจัตุรัส รอบนี้เป็น **แนวตั้ง**
// ⚠️ จุดที่ **ต่างกันจริงระหว่างสองใบ** และต้องเขียนให้ตรง (ตรวจจากบิตแมปรอบนี้):
//   slide1 (คืนยอดเสีย 0.3%) ผู้หญิง **ขยิบตาและกำหมัดชูขึ้น สวมเสื้อลูกไม้สีขาว** ·
//     มี **ตู้สล็อตเลข 777 สีชมพูอยู่ริมขวาของตัวเลข** · เหรียญทองกระจายทั่วครึ่งล่าง
//   slide2 (แนะนำเพื่อน 0.8%) ผู้หญิง **ยิ้มตาหยี สวมเสื้อไหมพรมถักสีชมพูเปิดไหล่
//     ทับสายเสื้อขาว** และมี **หัวใจชมพูลอยขึ้นจากหน้าจอโทรศัพท์** ·
//     **ไม่มีตู้สล็อต** · เหรียญทองกองเป็นตั้งอยู่ทั้งริมซ้ายและริมขวาของตัวเลข
// ⚠️ ห้ามระบุว่าถือด้วยมือซ้ายหรือมือขวา — รอบก่อนๆ เขียนไว้แล้วผิดหลายรอบติด
// ⚠️ สีของวัตถุในรูป (ผมสีน้ำตาลเข้ม เหรียญทอง หมูชมพู กล่องของขวัญ) เป็นวัตถุ
// ในภาพ ไม่ใช่สีของแบรนด์ และไม่เข้ามาใน UI
// ⚠️ องค์ประกอบของอาร์ตเวิร์กแบรนด์ก่อนๆ ที่ต้องไม่หลงเหลือใน alt อยู่ครบใน
// brand-spec §6 (ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive)
const altCashback = `โปสเตอร์โปรโมชั่นแนวตั้ง พื้นขาวอมชมพู มุมบนซ้ายเป็นโลโก้ ${BRAND_NAME} ตัวอักษรเจลลี่สามมิติสีชมพูตัดขอบขาว โดยตัวแรกเป็นหน้าการ์ตูนกลมสีชมพูขยิบตาและมือสวมถุงมือขาวชูสองนิ้ว ริมซ้ายเป็นหมูการ์ตูนชมพูมีปีกกอดหัวใจ กลางภาพเป็นผู้หญิงผมยาวสีน้ำตาลเข้มผูกโบว์ชมพู ขยิบตา สวมเสื้อลูกไม้สีขาว ยกโทรศัพท์เคสชมพูขึ้นและกำหมัดชูขึ้นอีกข้าง ครึ่งล่างเป็นตัวอักษรไทยเจลลี่สามมิติตัวโตสีชมพูอ่านว่า โปรโมชั่น พร้อมไอคอนโทรโข่ง ใต้ลงมาเป็นแคปซูลขาวเขียนว่า คืนยอดเสีย และตัวเลข 0.3% ตัวโต มีตู้สล็อตเลข 777 สีชมพูริมขวาของตัวเลข เหรียญทอง หัวใจชมพู และกล่องของขวัญชมพูกระจายอยู่รอบ ปิดท้ายด้วยแคปซูลขอบชมพูเขียนว่า แจกโบนัสทั้งวัน`;

const altReferral = `โปสเตอร์โปรโมชั่นแนวตั้ง พื้นขาวอมชมพู มุมบนซ้ายเป็นโลโก้ ${BRAND_NAME} ตัวอักษรเจลลี่สามมิติสีชมพูตัดขอบขาว โดยตัวแรกเป็นหน้าการ์ตูนกลมสีชมพูขยิบตาและมือสวมถุงมือขาวชูสองนิ้ว ริมซ้ายเป็นหมูการ์ตูนชมพูมีปีกกอดหัวใจ กลางภาพเป็นผู้หญิงผมยาวสีน้ำตาลเข้มผูกโบว์ชมพู ยิ้มตาหยี สวมเสื้อไหมพรมถักสีชมพูเปิดไหล่ทับสายเสื้อขาว ยกโทรศัพท์ที่มีหัวใจชมพูลอยขึ้นจากหน้าจอ ครึ่งล่างเป็นตัวอักษรไทยเจลลี่สามมิติตัวโตสีชมพูอ่านว่า โปรโมชั่น พร้อมไอคอนโทรโข่ง ใต้ลงมาเป็นแคปซูลขาวเขียนว่า แนะนำเพื่อน และตัวเลข 0.8% ตัวโต มีเหรียญทองกองเป็นตั้งอยู่ทั้งริมซ้ายและริมขวาของตัวเลข พร้อมกล่องของขวัญชมพูที่มุมล่างทั้งสองข้าง ปิดท้ายด้วยแคปซูลขอบชมพูเขียนว่า แจกโบนัสทั้งวัน`;
---

<MainLayout title={`โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`รวมโปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} as="h1">
    <div class="flex flex-col gap-10">
      <p class="text-left text-base leading-relaxed">
        หน้านี้รวมภาพโปรโมชั่นของ {BRAND_NAME} ไว้ในที่เดียว ทั้ง
        <strong class="text-[#9c0f55]">คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%</strong>
        โดยชื่อรายการและอัตราระบุอยู่บนภาพแล้ว
        <strong class="text-[#9c0f55]">แต่ละรายการมีเงื่อนไขต่างกัน จึงควรตรวจสอบจากประกาศล่าสุดก่อนรับสิทธิ์</strong>
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt={altCashback}
          loading="lazy"
          fetchpriority="low"
          widths={[250, 375]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />

        <Picture
          src={promoReferral}
          alt={altReferral}
          loading="lazy"
          fetchpriority="low"
          widths={[250, 375]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="relative isolate flex items-center justify-center overflow-hidden rounded-lg border border-[#85094a] bg-gradient-to-b from-[#d91a73] via-[#b01160] to-[#85094a] px-10 py-3.5 text-lg font-black text-white shadow-[0_8px_22px_rgba(156,15,85,0.35)] transition-transform hover:scale-105">
          <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-white/10 to-transparent"></span>
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
