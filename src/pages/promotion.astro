---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";

import { Picture } from "astro:assets";

// ดรอปนี้ (2026-10-11) มีสไลด์ที่ใช้ได้แค่สองใบ และรอบนี้เปิดอ่านป้ายบนภาพจริงซ้ำแล้ว
// ห้ามเชื่อเลขไฟล์หรือคอมเมนต์ของรอบก่อน (การจับคู่สลับข้างแทบทุกรอบ — ตารางใน
// brand-spec §4 ตรงกับสิ่งที่พิมพ์อยู่บนรูปจริง และรอบนี้ **สลับข้างจากรอบก่อน**):
//   slide1.png — คู่ชาย-หญิงชุดบอลดำ-ทอง ใต้คำว่า "โปรโมชั่น" เขียน "แนะนำเพื่อน"
//                และ "โบนัส 0.8%" บนแผ่นป้ายดำขอบทอง มีมงกุฎทองเหนือตัวอักษร
//   slide2.png — ชุดเดียวกัน ใต้คำว่า "โปรโมชั่น" เขียน "คืนยอดเสีย 0.3%"
//                ยืนบนเวทีวงแหวนทอง ไม่มีมงกุฎ
//   slide3.png / slide4.png — โปสเตอร์ของแบรนด์รอบก่อน (mtime 09-29)
//     ห้าม import กลับมาเด็ดขาด และห้ามลบไฟล์ทิ้งเพราะเป็นอินเวนทอรีของรอบถัดไป
// ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้ว และ verify-build จะแดง
// (banner2 / banner3 ใน src/assets เป็นอาร์ตเวิร์กของแบรนด์ก่อนๆ ห้าม import ส่วน
// banner1 / banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักชื่อไว้เอง
// — ห้ามอ้างจากหน้านี้)
// ชื่อตัวแปรตั้งตามข้อความบนภาพ ไม่ใช่ตามเลขไฟล์ เพื่อไม่ให้รอบหน้าสลับผิดอีก
import promoCashback from "../assets/slide2.png";
import promoReferral from "../assets/slide1.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้นๆ ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมด
// ของหน้านี้, กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อยและห้ามเพิ่มย่อหน้า
// เพราะตัวโปสเตอร์ระบุเปอร์เซ็นต์โบนัสไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว การพิมพ์ซ้ำ
// ด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ ส่วน SUB-PAGES ของบรีฟให้มาแค่ Title
// กับ Meta ไม่เคยให้ body มา ย่อหน้าทุกย่อหน้าที่เคยอยู่บนหน้านี้จึงเป็นของที่
// รีแบรนด์รอบก่อนๆ แต่งขึ้นเอง เป้าหมาย h1x1 h2x0 h3x0
//
// สไลด์รอบนี้เป็น **600x600 ทั้งคู่** วางเป็นกริดสองคอลัมน์ คุมความกว้างรวมที่
// max-w-4xl (896px) ทำให้ช่องละ ~436px ไม่ต้องอัปสเกลเกินขนาดไฟล์ต้นทาง widths
// หยุดที่ 600 ตามความกว้างจริงของไฟล์ และคุมภาพต่อใบไว้ที่ max-w-[600px]
// เรียง คืนยอดเสีย 0.3% ก่อน แนะนำเพื่อน 0.8% ตามลำดับของบรีฟ (docx H3 #4 แล้ว #5)
// ซึ่งรอบนี้แปลว่า **slide2 มาก่อน slide1** ตามข้อความที่พิมพ์อยู่บนรูป
// sizes คิดจากความกว้างที่ถูกวาดจริง: px-4 ของ section (16px/ข้าง) + p-8 ของการ์ด
// (32px/ข้าง, เป็น p-10 = 40px ที่ md ขึ้นไป) + gap-6 (24px) ระหว่างสองคอลัมน์
// LCP คือ hero ใน MainLayout ไม่ใช่สองรูปนี้ จึง loading="lazy" fetchpriority="low"
//
// Announcement รอบนี้หมุนมาเป็น Announcement2 ทั้งเว็บ (รอบก่อนใช้ Announcement4 —
// brand-spec §3 หมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ
// แบรนด์นี้ไว้แล้ว และทุกหน้าก็เรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop message
// มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกันระหว่างหน้า
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ทองแชมเปี้ยน นำ เงินโครเมียม รอง บนพื้นดำสนิท**
// พลิกทิศจากรอบก่อนที่เป็นคู่ชมพูบานเย็น-ทองบนพื้นม่วงพลัม รอบนี้ bg.json เป็น
// {"mode":"color","color":"#000000"} จึง **ไม่มีชั้นที่ลึกกว่าพื้นเพจได้เลย**
// ทุกผิวต้องสว่างขึ้นจาก #000000 เท่านั้น
// ฮิวนำคือ **ทอง** #e5a81b (ถ้วยแชมป์ ลูกฟุตบอลทอง ตัวอักษร UFA บนโลโก้) ถือขอบรูป
// ออรา และช่วงกลางของไล่เฉดปุ่มหลัก · #ffe08a เป็นต้นสว่าง · #bb8410 เป็นปลายเข้ม
// · **เงินโครเมียม** #b9c2cc (เลข 324 บนโลโก้) เป็นฮิวที่สอง ใช้เป็นขอบปุ่มรอง
// · หมึกบนพื้นถมทองเป็น #140d01 เท่านั้น · เนื้อความ #f0e8d4 มาจาก BRAND_TEXT ที่
// <html> และการ์ด ContentBox ตั้งให้แล้ว ย่อหน้าจึงไม่ประกาศสีของตัวเอง
// · ไฮไลต์ใน <strong> ใช้ #ffcf5e ตัวเดียว และครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง
// เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดกลางคำ บรรทัดจะตัดกลางคำ
// ⚠️ ไล่เฉดปุ่มพื้นทองต้องหยุดที่ #bb8410 ห้ามไล่ลงไปถึง #7d5a07 ใต้ตัวอักษร
// (#140d01 บน #7d5a07 = 3.3:1 ตก AA) · #7d5a07 #43300a #464f5a เป็นเส้น ขอบ และออรา
// เท่านั้น ห้ามถือตัวอักษรทุกขนาด
// ⚠️ กับดักของรอบนี้: เจ็ดในสิบแบรนด์หลังสุดมีทอง "เจอทองที่ไหน" ห้ามเหมาว่าเป็นของ
// รอบนี้ ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน brand-spec §2 (ทองของรอบนี้ต่างจากทอง
// ของแบรนด์ก่อนแค่ไม่กี่ตัวอักษรทุกคู่ ห้ามกะด้วยตา — และค่าเดิมไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive)
//
// แบรนด์นี้เป็น **เว็บเล่นเกมกีฬาออนไลน์** — ฟุตบอล มวย และเกมคาสิโน (เกมไพ่ เกมโต๊ะ
// สล็อต) ไม่ใช่เว็บสล็อตล้วนแบบแบรนด์ก่อน และไม่ใช่เว็บของหมวดลอตเตอรี (สองหน้าของหมวดนั้นจอดอยู่
// ใน src/pages-disabled/ ไม่มี route — ลิงก์ค้างจะเป็น href ตายที่ทำให้บิลด์แดง)
// คำขายของของแบรนด์ก่อนและศัพท์หมวดอื่นที่บรีฟไม่ได้เอ่ยห้ามหลงเหลือ (รายการเต็มอยู่ใน
// brand-spec §7 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep เจอ false positive) ตัวเลขที่บรีฟ
// ให้และอ้างได้มีแค่ 0.3% / 0.8% / 24 ชั่วโมง — ห้ามแต่งยอดฝากขั้นต่ำ ชื่อค่ายเกม
// ชื่อธนาคาร ค่า RTP เลขใบอนุญาต จำนวนสมาชิก ปีก่อตั้ง ชื่อลีก/ทีม/นักมวย หรือวันหมดเขต
// และต้องคงคำกำกับของบรีฟไว้ว่า **ควรตรวจสอบว่าโปรโมชั่นครอบคลุมเฉพาะเกมสล็อตหรือรวม
// การเดิมพันกีฬาและคาสิโนประเภทอื่นด้วย** เพราะแต่ละกิจกรรมอาจกำหนดเงื่อนไขไม่เหมือนกัน
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) หน้านี้ยาว 156 อักขระ
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `รวมภาพโปรโมชั่น ${BRAND_NAME} เว็บเล่นเกมกีฬาออนไลน์ ทั้งคืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อน โบนัส 0.8% จากยอดที่เข้าเกณฑ์ โดยแต่ละรายการมีเงื่อนไขต่างกัน`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่น ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});

// ความกว้างที่ถูกวาดจริงของแต่ละช่องในกริดสองคอลัมน์ (ดูคอมเมนต์ sizes ด้านบน)
const promoSizes = "(max-width: 639px) calc(100vw - 96px), (max-width: 767px) calc((100vw - 120px) / 2), (max-width: 1007px) calc((100vw - 136px) / 2), 436px";
const promoClass =
  "mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#e5a81b]/40 object-contain shadow-[0_0_28px_rgba(229,168,27,0.28)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#e5a81b]/85 hover:shadow-[0_0_40px_rgba(255,224,138,0.38)]";
---

<MainLayout title={`โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน โบนัส 0.8% จากยอดที่เข้าเกณฑ์`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`โปรโมชั่น ${BRAND_NAME} ทั้งหมด`} as="h1">
    <div class="flex flex-col gap-10">
      <p>
        หน้านี้รวมภาพโปรโมชั่นที่ <strong class="text-[#ffcf5e]">{BRAND_NAME}</strong> เปิดให้สมาชิกตรวจสอบสิทธิ์ตามกิจกรรมที่เว็บไซต์กำหนด โดยมีทั้งรายการคืนยอดเสียและโบนัสแนะนำเพื่อน รายละเอียดของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว
        สมาชิกตรวจสอบยอดที่เข้าเกณฑ์ รอบคำนวณ และเงื่อนไขการรับสิทธิ์ได้จากระบบสมาชิกโดยตรง <strong class="text-[#ffcf5e]">
          ทั้งนี้ควรตรวจสอบว่าโปรโมชั่นครอบคลุมเฉพาะเกมสล็อตหรือรวมการเดิมพันกีฬาและคาสิโนประเภทอื่นด้วย
        </strong> เพราะแต่ละกิจกรรมอาจกำหนดเงื่อนไขไม่เหมือนกัน
      </p>

      <div class="mx-auto grid w-full max-w-4xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt={`ภาพโปรโมชั่นของ ${BRAND_NAME} โทนดำ-ทอง ด้านซ้ายเป็นชายหนุ่มผมสั้นสีเงินขาวใส่เสื้อบอลแขนสั้นสีดำแถบทองสกรีนคำว่า ${BRAND_NAME} ชี้นิ้วมาทางผู้ชม ด้านขวาเป็นหญิงสาวผมบ๊อบสีเงินขาวใส่ชุดกีฬาครอปสีดำ-ทอง ถือลูกฟุตบอลลายดำ-ทองไว้ในมือ ทั้งคู่ยืนอยู่บนเวทีวงแหวนทองเรืองแสง บนสุดเป็นโลโก้เหรียญตราลูกฟุตบอลทองบนถ้วยรางวัลทองพร้อมตัวอักษร ${BRAND_NAME} กลางภาพเป็นคำว่า โปรโมชั่น ตัวอักษรทองสามมิติขนาดใหญ่ และใต้ลงมาเขียนว่า คืนยอดเสีย คู่กับตัวเลข 0.3% ตัวโต`}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoReferral}
          alt={`ภาพโปรโมชั่นของ ${BRAND_NAME} โทนดำ-ทองชุดเดียวกัน ด้านซ้ายเป็นชายหนุ่มผมสีเงินขาวใส่เสื้อบอลสีดำแถบทองสกรีนคำว่า ${BRAND_NAME} ด้านขวาเป็นหญิงสาวผมบ๊อบสีเงินขาวใส่ชุดกีฬาครอปสีดำ-ทองสกรีนคำว่า ${BRAND_NAME} ทั้งคู่ยิ้มและยื่นมือออกมาทางผู้ชม มีลูกฟุตบอลลายดำ-ทองวางอยู่ที่มุมล่างสองข้าง บนสุดเป็นโลโก้เหรียญตราลูกฟุตบอลทองบนถ้วยรางวัลทองพร้อมตัวอักษร ${BRAND_NAME} กลางภาพมีมงกุฎทองอยู่เหนือคำว่า โปรโมชั่น ตัวอักษรทองสามมิติ และใต้ลงมาบนแผ่นป้ายดำขอบทองเขียนว่า แนะนำเพื่อน คู่กับคำว่า โบนัส 0.8%`}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#7d5a07] bg-gradient-to-b from-[#ffe08a] via-[#e5a81b] to-[#bb8410] px-10 py-3.5 text-lg font-black text-[#140d01] shadow-[0_0_14px_rgba(229,168,27,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
