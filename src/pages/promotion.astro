---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

// ดรอปนี้ (2026-10-17, สมหวัง168) มี **สไลด์ที่ใช้ได้ใบเดียว** ค่าข้างล่างนี้มาจาก
// การเปิดดูรูปจริงด้วยตา ไม่ใช่จากเลขไฟล์ และตรงกับตาราง brand-spec §4 แล้ว
// ถ้ารอบหน้าเจอความขัดแย้งอีก **ให้เชื่อข้อความที่พิมพ์อยู่บนรูป**:
//   slide1.png (mtime 10-17) — จัตุรัส 600x600 ที่พิมพ์ **ทั้งสองโปรโมชั่นไว้ในรูป
//                เดียว** แบ่งเป็นสองแผงซ้าย-ขวา แผงซ้าย "โปรโมชั่น / คืนยอดเสีย
//                0.3%" แผงขวา "โปรโมชั่น / แนะนำเพื่อน / โบนัส 0.8%" ทั้งคู่มีโลโก้
//                สมหวัง168 อยู่เหนือหัว — รูปเดียวจึงครอบคลุมทั้งหน้าอยู่แล้ว
//   slide2.png (mtime 10-13) — **อาร์ตเวิร์กของแบรนด์ก่อน มีเวิร์ดมาร์กของแบรนด์นั้น
//                พิมพ์อยู่บนรูป** ถ้าหลุดคือโชว์โลโก้คู่แข่งบนเว็บลูกค้า **ห้าม import**
//   slide3.png / slide4.png (mtime 09-29) — โปสเตอร์ของแบรนด์เก่ากว่านั้น ห้าม import
// ⚠️ ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้ว และ verify-build จะแดง
// **ห้ามลบไฟล์ทั้งสามทิ้ง** — เป็นอินเวนทอรีของรอบถัดไป แค่ห้าม import
// (banner2 / banner3 ใน src/assets เป็นอาร์ตเวิร์กของแบรนด์ก่อนๆ ห้าม import ส่วน
// banner1 / banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักชื่อไว้เอง
// — ห้ามอ้างจากหน้านี้) รอบนี้จึง **ไม่มี article illustration** เลย
// ชื่อตัวแปรตั้งตามสิ่งที่พิมพ์อยู่บนภาพ ไม่ใช่ตามเลขไฟล์ เพื่อไม่ให้รอบหน้าสลับผิด
import promoPoster from "../assets/slide1.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้นๆ ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมด
// ของหน้านี้, กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อยและห้ามเพิ่มย่อหน้า
// เพราะตัวโปสเตอร์ระบุเปอร์เซ็นต์โบนัสไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว การพิมพ์ซ้ำ
// ด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ บรีฟรอบนี้ (src/assets/content.txt)
// ไม่มีส่วน SUB-PAGES เลย ย่อหน้าทุกย่อหน้าที่เคยอยู่บนหน้านี้จึงเป็นของที่รีแบรนด์
// รอบก่อนๆ แต่งขึ้นเอง — รอบนี้คงไว้เพียงย่อหน้าเกริ่นเดียว
//
// ⚠️ รอบนี้มีรูปใบเดียว กริดจึงยุบจากสองคอลัมน์เหลือ **คอลัมน์เดียวจัดกลาง**
// (grid-cols-1 sm:grid-cols-2 ของรอบก่อนจะทิ้งช่องว่างครึ่งแถวถ้าเหลือรูปเดียว)
// บิตแมปจริงกว้าง 600px → widths หยุดที่ 600 และคุมภาพที่ max-w-[600px]
// sizes คิดจากความกว้างที่ถูกวาดจริง: section px-4 (16px/ข้าง) + การ์ด p-8
// (32px/ข้าง, เป็น p-10 = 40px ที่ md ขึ้นไป) → ใต้ 696px กว้าง 100vw-96px
// ตั้งแต่ 696px ขึ้นไปชนเพดาน 600px พอดี
// LCP คือ hero ใน MainLayout ไม่ใช่รูปนี้ จึง loading="lazy" fetchpriority="low"
// decoding="async" และ quality={80} ตัวเดียวทั้ง avif/webp — ห้ามจูนแยกฟอร์แมต
// (tools/avif-quality-service.mjs ลดให้เป็น avif:52 เอง)
//
// Announcement รอบนี้หมุนมาเป็น Announcement3 ทั้งเว็บ (แบรนด์ก่อนใช้
// Announcement5 บนหน้าแรกและ Announcement2 บนหน้าย่อย — brand-spec §3 หมุนออก
// ทั้งคู่) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว
// และทุกหน้าก็เรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูด
// คนละเรื่องกันระหว่างหน้า
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **แดงมังกรนำ ทองไทยรอง บนพื้นดำอมแดง**
// bg.json ของดรอปนี้เป็น {"mode":"color","color":"#290f0f"} ลำดับผิว:
// #2c1413 ยก (การ์ด ContentBox) / #1f0d0c กลาง / #140706 จม / #290f0f พื้นเพจ
// แดงแบรนด์ #fa0513 ถือขอบรูปและออรา · ทองไทย #e3b23c เป็นขอบตอน hover ·
// แดงอ่อน #ffadaf เป็นต้นสว่างสุดของพื้นถมปุ่ม และเป็นสีไฮไลต์ของ <strong>
// ในเนื้อความ (สงวนไว้งานเดียวนี้ ไม่ใช้สีอื่นเลย) ·
// หมึกบนพื้นถมแดงเป็น #170504 (4.8:1 บน #fa0513 และสูงกว่านั้นบน #ffadaf) ·
// เนื้อความ #f4ecea มาจาก BRAND_TEXT ที่ <html> และการ์ด ContentBox ตั้งให้แล้ว
// ย่อหน้าจึงไม่ประกาศสีของตัวเอง
// · <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ
// ถ้าเปิด/ปิดกลางคำ บรรทัดจะตัดกลางคำ
// ⚠️ #fa0513 #b90203 #8c0204 #3c0303 #8a6210 ห้ามถือตัวอักษรทุกขนาด ใช้ได้เฉพาะ
// เส้น ขอบ ออรา และพื้นถม · ออราในไฟล์นี้ใช้ rgba(250,5,19,α) และ
// rgba(227,178,60,α) เท่านั้น
// ⚠️ กับดักของรอบนี้คือ **แดง**: สองแบรนด์ก่อนหน้าก็เป็นแดงเหมือนกันทั้งคู่
// และแดงของทั้งสองต่างจากรอบนี้แค่หนึ่งหลัก "เจอแดง" จึงไม่ได้แปลว่า
// เป็นของรอบนี้ ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน brand-spec §2 (ค่าของแบรนด์เก่า
// ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive) สิ่งที่ทำให้
// รอบนี้ต่างจริงคือ **ทองไทยกับพื้นดำอมแดง** และรอบนี้ **ไม่มีโครเมียมขาว/เงิน
// เป็นสีระบบ ไม่มีม่วง ไม่มีชมพู ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว ไม่มีส้ม**
//
// ⚠️ แบรนด์นี้เป็น **เว็บเกมสล็อตล้วน** ไม่ใช่คาสิโน ไม่มีหมวดกีฬา ไม่มีหมวด
// ลอตเตอรี (สองหน้าของหมวดนั้นจอดอยู่ใน src/pages-disabled/ ไม่มี route — ลิงก์ค้าง
// จะเป็น href ตายที่ทำให้บิลด์แดง) คำขายของของสองแบรนด์ก่อนและศัพท์หมวดอื่นที่บรีฟ
// ไม่ได้เอ่ยห้ามหลงเหลือ (รายการเต็มอยู่ใน brand-spec §7 ไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep เจอ false positive)
// ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% / 0.8% / 24 ชั่วโมง — ห้ามแต่งยอดฝากขั้นต่ำ
// ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP เลขใบอนุญาต จำนวนสมาชิก หรือปีก่อตั้ง และต้องคง
// คำกำกับของบรีฟ (บรรทัด 9 ของ content.txt) ไว้ว่า **ควรอ่านเงื่อนไขให้ครบก่อน
// เข้าร่วม เพราะโปรโมชั่นแต่ละประเภทอาจมีข้อกำหนดเกี่ยวกับเกมที่ร่วมรายการและ
// การใช้โบนัสแตกต่างกัน**
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) หน้านี้ยาว 155 อักขระ
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `รวมภาพโปรโมชั่น ${BRAND_NAME} ทั้งคืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อน โบนัส 0.8% ตรวจสอบยอดที่เข้าเกณฑ์ รอบคำนวณ และสถานะการรับสิทธิ์ได้จากบัญชีสมาชิก`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่น ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoPoster.src,
});

// ความกว้างที่ถูกวาดจริงของรูปเดียวที่จัดกลาง (ดูคอมเมนต์ sizes ด้านบน)
const promoSizes = "(max-width: 695px) calc(100vw - 96px), 600px";
---

<MainLayout title={`โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน โบนัส 0.8%`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`โปรโมชั่น ${BRAND_NAME} ทั้งหมด`} as="h1">
    <div class="flex flex-col gap-10">
      <p>
        หน้านี้รวมภาพโปรโมชั่นที่ <strong class="text-[#ffadaf]">{BRAND_NAME}</strong> เปิดให้สมาชิกตรวจสอบสิทธิ์ตามกิจกรรมที่เว็บไซต์กำหนด ทั้งโบนัสคืนยอดเสียและโบนัสแนะนำเพื่อน โดยรายละเอียดของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว
        สมาชิกตรวจสอบยอดที่เข้าเกณฑ์ รอบคำนวณ และวิธีรับสิทธิ์ได้ผ่านช่องทางบริการที่เว็บไซต์แจ้งไว้ <strong class="text-[#ffadaf]">
          ควรอ่านเงื่อนไขให้ครบก่อนเข้าร่วม เพราะโปรโมชั่นแต่ละประเภทอาจมีข้อกำหนดเกี่ยวกับเกมที่ร่วมรายการและการใช้โบนัสแตกต่างกัน
        </strong>
      </p>

      <div class="mx-auto w-full max-w-[600px]">
        <Picture
          src={promoPoster}
          alt={`ภาพโปรโมชั่นของ ${BRAND_NAME} เป็นภาพจัตุรัสที่แบ่งเป็นสองแผงซ้ายขวา ทั้งสองแผงมีพื้นดำ ผ้าซาตินแดงพลิ้ว ลายกนกทองไทยและยอดเจดีย์ทองเป็นฉากหลัง เหนือหัวของแต่ละแผงเป็นโลโก้ ${BRAND_NAME} ที่เป็นตัวอักษรโครเมียมขาวขอบแดงต่อด้วยเลข 168 สีแดงสดและเปลวไฟแดง ในแต่ละแผงมีชายหนุ่มผมดำในชุดไทยคอจีนสีดำปักทองยืนเคียงหญิงสาวผมยาวดำในชุดแดงทองที่ประดับเครื่องประดับทอง แผงซ้ายเป็นคำว่า โปรโมชั่น ตัวอักษรทองสามมิติขนาดใหญ่ ใต้ลงมาเป็นแถบป้ายดำเขียนว่า คืนยอดเสีย คู่กับตัวเลข 0.3% ตัวโตสีแดงสด ส่วนแผงขวาเป็นคำว่า โปรโมชั่น ตัวอักษรทองเช่นกัน ใต้ลงมาเป็นแถบป้ายดำเขียนว่า แนะนำเพื่อน และ โบนัส คู่กับตัวเลข 0.8% สีแดงสด ขอบล่างของทั้งสองแผงเป็นกองชิปคาสิโนสีทองแดงดำ ไพ่ และกล่องของขวัญสีทอง`}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes={promoSizes}
          class="mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#fa0513]/50 object-contain shadow-[0_0_28px_rgba(250,5,19,0.3)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#e3b23c]/85 hover:shadow-[0_0_40px_rgba(227,178,60,0.4)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#b90203] bg-gradient-to-b from-[#ffadaf] to-[#fa0513] px-10 py-3.5 text-lg font-black text-[#170504] shadow-[0_0_14px_rgba(250,5,19,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
