---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

// slide1/slide2 เท่านั้นที่เป็นอาร์ตเวิร์กของ TIGER88 และเป็นโปรโมชั่นสองรายการที่หน้านี้แสดง
// slide1 คือโปสเตอร์ "คืนยอดเสีย 0.3%" ส่วน slide2 คือ "แนะนำเพื่อน 0.8%" (อ่านจากตัวภาพ)
// สลับบทบาทจากแบรนด์ก่อนหน้า — อย่าเชื่อชื่อตัวแปรเดิม ให้เปิดรูปดูทุกครั้งที่เปลี่ยนแบรนด์
// slide3/slide4 ยังค้างอยู่บนดิสก์แต่เป็นอาร์ตเวิร์กของลูกค้าก่อนหน้า — ห้าม import ที่นี่
// ทั้งรอบนี้และรอบถัดไป (ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้ว)
import promoCashback from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็น IMAGE page: ContentBox title, ย่อหน้าเกริ่นสั้น ๆ หนึ่งย่อหน้า, กริดโปสเตอร์,
// ปุ่ม CTA หนึ่งปุ่ม — ไม่มีหัวข้อย่อยและไม่มีย่อหน้าเพิ่ม เพราะตัวโปสเตอร์ระบุเงื่อนไข
// ของแต่ละโปรโมชั่นไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 159
const pageDescription =
  "รวมโปรโมชั่น TIGER88 ทั้งกิจกรรมแนะนำเพื่อนรับโบนัส 0.8% และคืนยอดเสีย 0.3% ดูเปอร์เซ็นต์โบนัส ยอดที่นำมาคำนวณ และรอบรับสิทธิ์ได้จากภาพโปรโมชั่นในหน้านี้โดยตรง";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น TIGER88 คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8%",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});
---

<MainLayout title="โปรโมชั่น TIGER88 คืนยอดเสียรับ 0.3% และแนะนำเพื่อนรับ 0.8%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น TIGER88" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#f2e3c9]">
        หน้านี้รวมโปรโมชั่นที่ TIGER88 เปิดให้สมาชิกตรวจสอบสิทธิ์และกดรับผ่านบัญชีของตนเอง ทั้งโปรโมชั่นคืนยอดเสีย <strong class="text-[#fdd121]">0.3%</strong>
        และกิจกรรมแนะนำเพื่อนรับ <strong class="text-[#fdd121]">0.8%</strong> โดยเปอร์เซ็นต์โบนัส ยอดที่นำมาคำนวณ และรอบเวลารับสิทธิ์ระบุไว้บนภาพโปรโมชั่นแต่ละใบ
        แต่ละรายการมีวิธีคำนวณและเงื่อนไขต่างกัน จึงควรอ่านรายละเอียดล่าสุดหรือสอบถามแอดมินก่อนกดรับทุกครั้ง
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่นคืนยอดเสียของ TIGER88 พื้นหลังสีดำมีประกายสีแดงและทอง ด้านซ้ายเป็นหัวเสือกำลังคำราม ตรงกลางเป็นโลโก้ตัวอักษร TIGER88 เหนือข้อความสีขาวว่า โปรโมชั่น และคำว่า คืนยอดเสีย สีทอง ใต้ลงมาเป็นตัวเลขสีขาวขนาดใหญ่ 0.3% ในกรอบสีแดง ด้านขวาเป็นนางแบบผมสีเงินในชุดหนังสีดำแดงติดโลโก้ TIGER88 กำลังชี้นิ้วมาที่ตัวเลข มุมขวามีตู้สล็อตคำว่า JACKPOT และเลข 777 ส่วนมุมซ้ายล่างมีเลข 777 สีทองกับชิปคาสิโนสีแดง"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#5e0505]/70 object-contain shadow-[0_10px_30px_rgba(7,2,2,0.6)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fdd121]/70 hover:shadow-[0_15px_40px_rgba(239,22,34,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อนของ TIGER88 พื้นหลังสีดำมีเหรียญทองและชิปคาสิโนกระจายอยู่ ด้านซ้ายเป็นนางแบบผมสีเงินในชุดรัดรูปสีดำแดงติดโลโก้ TIGER88 ด้านขวาเป็นโลโก้ตัวอักษร TIGER88 เหนือข้อความสีขาวว่า โปรโมชั่น และแถบสีทองคำว่า แนะนำเพื่อน คู่กับตัวเลขขนาดใหญ่ 0.8% ฉากหลังมีตู้สล็อตคำว่า JACKPOT เลข 777 และวงล้อรูเล็ต"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#5e0505]/70 object-contain shadow-[0_10px_30px_rgba(7,2,2,0.6)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fdd121]/70 hover:shadow-[0_15px_40px_rgba(239,22,34,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก TIGER88"
          class="flex items-center justify-center rounded-lg border border-[#fdd121]/70 bg-gradient-to-r from-[#ff2a36] via-[#ef1622] to-[#5e0505] px-10 py-3.5 text-lg font-black text-[#f2e3c9] shadow-[0_0_15px_rgba(239,22,34,0.5)] transition-transform hover:scale-105">
          สมัครสมาชิก TIGER88
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
