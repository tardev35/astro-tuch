---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

// ดรอปรอบนี้ (2026-10-18, brand-spec §4) มีสไลด์ที่ใช้ได้ **สองใบ** และชื่อตัวแปร
// ตั้งตามข้อความที่พิมพ์อยู่บนภาพจริง (เปิดบิตแมปอ่านเองแล้ว) ไม่ใช่ตามเลขไฟล์ —
// ถ้ารอบหน้าเจอความขัดแย้ง **ให้เชื่อข้อความบนรูป**:
//   slide1.png — โปสเตอร์ "โปรโมชั่น / คืนยอดเสีย / 0.3%"
//   slide2.png — โปสเตอร์ "โปรโมชั่น / แนะนำเพื่อน / 0.8%"
// ⚠️ **รอบนี้สลับข้างกับรอบที่แล้ว** รอบก่อน slide2 = คืนยอดเสีย และ slide1 =
// แนะนำเพื่อน ใครก๊อป import เดิมมาใช้จะได้รูปที่ขัดกับหัวข้อของตัวเอง
//   slide3.png / slide4.png (mtime 2026-09-29) — อาร์ตเวิร์กของแบรนด์ก่อน **ห้าม import**
// ⚠️ eager import = emit ลง dist/ ต่อให้ไม่ได้ render และ verify-build จะแดง
// การ import ไฟล์เก่าคือการส่งรูปของลูกค้ารายอื่นขึ้นเว็บนี้
// **ห้ามลบไฟล์เก่าทิ้ง** — เป็นอินเวนทอรีของรอบถัดไป แค่ห้าม import
// (banner2 / banner3 ก็เช่นกัน ส่วน banner1 / banner1-mobile / og.png เป็นของ glob
// ที่ MainLayout ปักชื่อไว้เอง — ห้ามอ้างจากหน้านี้) รอบนี้จึงไม่มี article illustration
import promoCashback from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้นๆ ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมด
// ของหน้านี้, กริดภาพโปรโมชั่น, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อยและห้ามเพิ่มย่อหน้า
// เพราะโปสเตอร์ระบุเปอร์เซ็นต์ของตัวเองด้วยตัวอักษรขนาดใหญ่อยู่แล้ว การพิมพ์ซ้ำ
// ด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ บรีฟรอบนี้ (src/assets/content.txt)
// ไม่มีส่วน SUB-PAGES เลย ย่อหน้าทุกย่อหน้าที่เคยอยู่บนหน้านี้จึงเป็นของที่รีแบรนด์
// รอบก่อนๆ แต่งขึ้นเอง — รอบนี้คงไว้เพียงย่อหน้าเกริ่นเดียว และเขียนขึ้นใหม่จากบรีฟ
// (content.txt บรรทัด 8) ไม่ใช่ find-and-replace ทับประโยคของรอบก่อน
//
// ลำดับในกริดตามลำดับของบรีฟ: คืนยอดเสีย 0.3% (บรรทัด 9-10) มาก่อน แนะนำเพื่อน 0.8%
// (บรรทัด 11-12) · บิตแมปจริง 600x600 ทั้งคู่ → widths หยุดที่ 600 และคุมที่ max-w-[600px]
// sizes คิดจากความกว้างที่ถูกวาดจริง: section px-4 (16px/ข้าง) + การ์ด p-8
// (32px/ข้าง, เป็น p-10 = 40px ที่ md ขึ้นไป) + gap-6 ระหว่างคอลัมน์ (24px)
//   ใต้ 640px = คอลัมน์เดียว → 100vw-96px
//   640-767px = สองคอลัมน์ p-8 → 50vw-60px
//   768-1335px = สองคอลัมน์ p-10 → 50vw-68px
//   ตั้งแต่ 1336px ขึ้นไปชนเพดาน 600px
// LCP คือ hero ใน MainLayout ไม่ใช่รูปพวกนี้ จึง loading="lazy" fetchpriority="low"
// decoding="async" และ quality ตัวเดียวทั้ง avif/webp — ห้ามจูนแยกฟอร์แมต
// (tools/avif-quality-service.mjs ย่อฝั่ง avif ให้เองที่ x0.65)
//
// quality={64} ไม่ใช่ 80 ตามปกติ และเป็นค่าที่ "วัดมา" ไม่ใช่ค่าที่ชอบ: สไลด์ทั้งสองเป็น
// อาร์ตพื้นดำที่มีเกรนละเอียดเยอะ (เหรียญร่วง ผ้าซาติน กลีบซากุระ) ซึ่งเป็นเคสที่ AVIF
// ทำได้แย่ที่สุด ที่ quality=80 ไฟล์ AVIF ออกมา **ใหญ่กว่า** WebP ที่เป็น fallback ของ
// ตัวเองทุกความกว้างของทั้งสองรูป (+2%..+10%) เบราว์เซอร์ที่รองรับ AVIF จะหยิบไฟล์ที่
// หนักกว่าไปใช้ และ verify-build.mjs ทำให้ build แดงด้วยเหตุนี้ตรงๆ · 64 คือค่าสูงสุดที่
// ชนะทุกความกว้างของทั้งสองรูป (-2%..-14%) ทางแก้คือ quality ที่ **ต่ำลง** ไม่ใช่สูงขึ้น
// ค่าเดียวกันนี้ใช้ที่ index.astro กับสไลด์คู่เดียวกัน
//
// Announcement รอบนี้หมุนมาเป็น Announcement3 ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ Announcement5 จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็น
// คอปปี้ของแบรนด์นี้ไว้แล้ว และทุกหน้าเรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop message
// มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกันระหว่างหน้า
//
// พาเลตต์รอบนี้ (brand-spec §2) = **ทองนำ · ชมพูบานเย็นเป็นฮิวที่สองจริง · พลัมเข้ม
// เป็นเงา บนดำสนิท** bg.json ของดรอปนี้คือ {"mode":"color","color":"#000000"}
// ลำดับผิว: #24101c ยก (การ์ด ContentBox) / #160a12 กลาง / #0b0509 จม / #000000 พื้นเพจ
// ทองแบรนด์ #fcd434 ถือขอบรูปและออรา · ทองสว่าง #ffeaa0 เป็นต้นสว่างของพื้นถมปุ่ม
// และเป็นสีไฮไลต์ของ <strong> ในเนื้อความ (สงวนไว้งานเดียวนี้) ·
// **ชมพูบานเย็น #f5469f เป็นขอบและออราตอน hover ของรูป** — ฮิวที่สองของรอบนี้ต้อง
// เห็นจริงบนหน้า ไม่ใช่แค่เขียนไว้ในสเปก · ทองลึก #7a5508 เป็นขอบปุ่มถมทอง ·
// หมึกบนพื้นถมทองเป็น #1a0612 (13.5:1 บน #fcd434) ·
// เนื้อความ #f6e4ee มาจาก BRAND_TEXT ที่ <html> และการ์ด ContentBox ตั้งให้แล้ว
// ย่อหน้าจึงไม่ประกาศสีของตัวเอง และไม่ใส่ mx-auto / max-w-* กับย่อหน้า
// · <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ
// ถ้าเปิด/ปิดกลางคำ บรรทัดจะตัดกลางคำ และ <strong> สองตัวห้ามติดกัน
// ⚠️ #8c0f52 และ #7a5508 ห้ามถือตัวอักษรทุกขนาด ใช้ได้เฉพาะเส้น ขอบ ออรา
// และพื้นถม · ออราในไฟล์นี้ใช้ rgba(252,212,52,α) และ rgba(245,70,159,α) เท่านั้น
// ⚠️ กับดักของรอบนี้คือ **ทอง**: แทบทุกแบรนด์ที่ผ่านไฟล์นี้มีทอง "เจอทอง" จึงไม่ได้
// แปลว่าเป็นของรอบนี้ ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน brand-spec §2 (ค่าของ
// แบรนด์เก่าไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive)
// สิ่งที่ทำให้รอบนี้ต่างจริงคือ **ชมพูบานเย็นเป็นฮิวที่สอง** และรอบนี้ **ไม่มีน้ำเงิน
// ไม่มีฟ้า ไม่มีม่วง ไม่มีเขียว ไม่มีส้ม ไม่มีเงินอมฟ้า ไม่มีโรสโกลด์ ไม่มีแดงชาด**
//
// ⚠️ แบรนด์นี้เป็น **เว็บสล็อตล้วน ลิขสิทธิ์แท้ นำเข้าตรงจากสิงคโปร์ สามค่ายหลัก**
// (สองหน้าของหมวดลอตเตอรีจอดอยู่ใน src/pages-disabled/ ไม่มี route — ลิงก์ค้าง
// จะเป็น href ตายที่ทำให้บิลด์แดง) คำขายของของแบรนด์ก่อนและศัพท์หมวดอื่นที่บรีฟ
// ไม่ได้เอ่ยห้ามหลงเหลือ (รายการเต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep เจอ false positive)
// ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% / 0.8% / 24 ชั่วโมง / 100% / 3 ขั้นตอน /
// 3 ค่าย — ห้ามแต่งยอดฝากขั้นต่ำ ชื่อธนาคาร ค่า RTP เลขใบอนุญาต จำนวนสมาชิก
// ปีก่อตั้ง หรือชื่อค่ายเกมอื่นนอกจาก PG SOFT / JOKER / JILI และต้องคงประโยคกำกับ
// ของบรีฟ (บรรทัด 8) ไว้ว่า **ก่อนเข้าร่วมควรตรวจสอบระยะเวลาของแคมเปญ เงื่อนไข
// ยอดเดิมพัน และวิธีรับเครดิตให้ชัดเจน**
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) หน้านี้ยาว 159 อักขระ
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `รวมภาพโปรโมชั่นของ ${BRAND_NAME} ฐานหลักเว็บสล็อตลิขสิทธิ์แท้ ทั้งคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% รายละเอียดอยู่บนภาพ สอบถามเงื่อนไขกับเจ้าหน้าที่ได้ 24 ชั่วโมง`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่น ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});

// ความกว้างที่ถูกวาดจริงของแต่ละคอลัมน์ในกริดสองคอลัมน์ (ดูคอมเมนต์ sizes ด้านบน)
const promoSizes = "(max-width: 639px) calc(100vw - 96px), (max-width: 767px) calc(50vw - 60px), (max-width: 1335px) calc(50vw - 68px), 600px";

const promoClass =
  "mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#fcd434]/50 object-contain shadow-[0_0_28px_rgba(252,212,52,0.3)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f5469f]/85 hover:shadow-[0_0_40px_rgba(245,70,159,0.45)]";
---

<MainLayout title={`โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน โบนัส 0.8%`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`โปรโมชั่น ${BRAND_NAME} ทั้งหมด`} as="h1">
    <div class="flex flex-col gap-10">
      <p>
        หน้านี้รวมภาพประกาศโปรโมชั่นของ <strong class="text-[#ffeaa0]">{BRAND_NAME} ฐานหลักเว็บสล็อตลิขสิทธิ์แท้ นำเข้าตรงจากสิงคโปร์</strong> ไว้ในที่เดียว ทั้งรายการคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8% โดยอัตราและรูปแบบการรับสิทธิ์ของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว
        <strong class="text-[#ffeaa0]">ก่อนเข้าร่วมควรตรวจสอบระยะเวลาของแคมเปญ เงื่อนไขยอดเดิมพัน และวิธีรับเครดิตให้ชัดเจน</strong> หรือสอบถามรอบการคำนวณยอดและประเภทเกมที่ร่วมรายการกับเจ้าหน้าที่ผ่าน LINE Official ได้ตลอด 24 ชั่วโมง
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt={`โปสเตอร์โปรโมชั่นพื้นดำ มุมบนซ้ายเป็นโลโก้ ${BRAND_NAME} รูปแมวกวักนำโชคสีขาวส้มนั่งอยู่เหนือตัวอักษรไทยสามมิติที่ไล่เฉดชมพูบานเย็นไปหาทอง กลางภาพเป็นคำว่า โปรโมชั่น ตัวอักษรชมพูสามมิติมีมงกุฎทองอยู่เหนือ ถัดลงมาเป็นป้ายดำขอบทองเขียนว่า คืนยอดเสีย คู่กับตัวเลข 0.3% สีชมพูตัวโตเต็มป้าย ด้านขวาเป็นหญิงสาวผมสีเงินประดับดอกซากุระชมพู สวมชุดจีนสีชมพูปักทองพร้อมสร้อยคอดอกไม้ ขยิบตาและชูเหรียญจีนทองรูสี่เหลี่ยม รอบตัวมีเหรียญทองปลิวกระจาย ริบบิ้นซาตินชมพู หัวใจชมพู และกลีบซากุระ`}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />

        <Picture
          src={promoReferral}
          alt={`โปสเตอร์โปรโมชั่นพื้นดำ มุมบนซ้ายเป็นโลโก้ ${BRAND_NAME} รูปแมวกวักนำโชคสีขาวส้มเหนือตัวอักษรไทยสามมิติที่ไล่เฉดชมพูบานเย็นไปหาทอง กลางภาพด้านซ้ายเป็นแมวกวักตัวใหญ่สีขาวส้มใส่ปลอกคอกระดิ่งทองยกอุ้งเท้าขึ้น ล้อมด้วยหัวใจชมพู ถัดลงมาเป็นคำว่า โปรโมชั่น ตัวอักษรสามมิติ แล้วเป็นคำว่า แนะนำเพื่อน ขนาบด้วยดอกซากุระ กับตัวเลข 0.8% สีชมพูตัวโต ด้านขวาเป็นหญิงสาวผมสีเงินประดับซากุระและพู่ทอง สวมชุดจีนสีชมพูปักทองพร้อมกำไลทอง กำลังขยิบตา รอบภาพมีเหรียญจีนทองรูสี่เหลี่ยมกองสูงและปลิวกระจาย กับริบบิ้นซาตินชมพู`}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#7a5508] bg-gradient-to-b from-[#ffeaa0] to-[#fcd434] px-10 py-3.5 text-lg font-black text-[#1a0612] shadow-[0_0_14px_rgba(252,212,52,0.45)] transition-transform hover:scale-105">
