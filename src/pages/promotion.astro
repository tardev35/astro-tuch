---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";

import { Picture } from "astro:assets";

// ดรอปอาร์ตเวิร์กของ THE88 คือ 2026-09-23 และมีสไลด์ที่ใช้ได้สองใบ (600x333):
//   slide2.png — "โปรโมชั่น แนะนำเพื่อน 0.8%"
//   slide1.png — "โปรโมชั่น คืนยอดเสีย 0.3%"
// ทั้งคู่เป็นโปสเตอร์แดง-ทองของแบรนด์นี้ กริดรอบนี้จึงมีสองใบ เรียงตามลำดับของ docx
// (แนะนำเพื่อนก่อน คืนยอดเสียทีหลัง) — บทบาทของ slide1/slide2 สลับกับแบรนด์รอบก่อน
// จึงต้องดูจากภาพจริงทุกครั้ง อย่าเชื่อชื่อตัวแปรเดิม
//
// slide3.png (2026-09-18) และ slide4.png (2026-08-13) เก่ากว่าดรอปรอบนี้ เป็น
// อาร์ตเวิร์กของลูกค้าเจ้าก่อน — ห้าม import กลับมา และห้ามลบไฟล์ทิ้งเพราะเป็น
// อินเวนทอรี (ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้ว และ
// verify-build จะแดง) ถ้ามีสไลด์ใหม่เข้ามาให้เช็ก mtime เทียบดรอปก่อนเพิ่ม
import promoReferral from "../assets/slide2.png";
import promoCashback from "../assets/slide1.png";
import { pageGraph } from "../lib/schema";
//
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ: ContentBox title, ย่อหน้าเกริ่นสั้น ๆ หนึ่งย่อหน้า,
// กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม — ไม่มีหัวข้อย่อยและไม่มีย่อหน้าเพิ่ม เพราะตัวโปสเตอร์
// ระบุชื่อโปรและเปอร์เซ็นต์โบนัสไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว เป้าหมาย h1×1, h2×0, h3×0
//
// สไลด์เป็นแบนเนอร์แนวนอน 600px จึงวางเป็นกริดสองคอลัมน์คุมความกว้างรวมที่ max-w-5xl
// (1024px) ทำให้ช่องละ ~488px ไม่ต้องอัปสเกลเกินขนาดไฟล์ต้นทาง widths หยุดที่ 600
// ตามความกว้างจริงของไฟล์ (candidate ที่ใหญ่กว่านั้นไม่มีของให้ครอป)
//
// Announcement รอบนี้หมุนมาใช้ Announcement2 ทั้งเว็บ — default message ของไฟล์นั้น
// เป็นคอปปี้ของ THE88 อยู่แล้วและ index ก็เรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop
//
// พาเลตต์ THE88 (แดงจีน-ทองหรู บนแดงเกือบดำ แทนชมพูมาเจนตา-ทองของรอบก่อน):
// พื้น #1c0504 · ผิวการ์ด #2d0908 · แดงหลัก #a40201 · แดงสว่าง #dd0503 ·
// แดงลึก #6b0302 · ทองหลัก #f2c14e · ทองสว่าง #ffe7a6 · ทองเข้ม #8a6524 ·
// เนื้อความ #f7e3dd · เงาลึก rgba(28,5,4,α) · ออร่าแดง rgba(164,2,1,α) ·
// ออร่าทอง rgba(242,193,78,α) — ปุ่ม CTA รับสีทองของเลข 88 บนโลโก้
// ตัวอักษรเน้นใช้ทอง ไม่ใช้แดง เพราะแดงบนพื้นแดงเข้มคอนทราสต์ต่ำเกินอ่าน
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 157
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "รวมโปรโมชั่นของ THE88 ผู้ให้บริการระบบพนันออนไลน์ ทั้งโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% ดูภาพรายการที่เปิดรับ พร้อมตรวจสอบเงื่อนไขก่อนกดรับสิทธิ์";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น THE88",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoReferral.src,
});
---

<MainLayout title="โปรโมชั่น THE88 แนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตรวจเงื่อนไขก่อนกดรับ" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น THE88" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#f7e3dd]">
        หน้านี้รวมภาพโปรโมชั่นที่ <strong class="text-[#ffe7a6]">THE88</strong> เปิดรับในรอบปัจจุบัน ทั้งโบนัสแนะนำเพื่อนและโบนัสคืนยอดเสีย
        โดยรายละเอียดของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว ทั้งชื่อโปรโมชั่นและเปอร์เซ็นต์โบนัสที่ได้รับ
        <strong class="text-[#f2c14e]">แต่ละรายการมีเงื่อนไข รอบคำนวณ และยอดที่เข้าเกณฑ์ต่างกัน จึงควรเปิดดูรายละเอียดของโปรโมชั่นนั้นจากหน้าเว็บไซต์ก่อนกดรับสิทธิ์ทุกครั้ง</strong>
      </p>

      <div class="mx-auto grid w-full max-w-5xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoReferral}
          alt="แบนเนอร์โปรโมชั่นพื้นแดง ด้านซ้ายเป็นผู้หญิงผมยาวสีเข้มสวมชุดสีแดงสลับขาวที่มีคำว่า THE88 อยู่บนชุด กำมือชูขึ้น ด้านขวาเป็นโลโก้ THE88 ตัวอักษร THE สีแดงขอบทองและเลข 88 สีครีมขอบทอง ถัดลงมาเป็นข้อความสีขาวขอบทองว่า โปรโมชั่น และข้อความว่า แนะนำเพื่อน ล่างสุดเป็นตัวเลขสีทองขนาดใหญ่ว่า 0.8% รอบภาพมีเหรียญทอง กล่องของขวัญผูกโบว์แดง และชิปคาสิโนลายมงกุฎแดงสลับทองลอยอยู่"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), 488px"
          class="mx-auto h-auto w-full rounded-xl border border-[#a40201]/55 object-contain shadow-[0_10px_30px_rgba(28,5,4,0.75)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f2c14e]/75 hover:shadow-[0_15px_40px_rgba(164,2,1,0.45)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoCashback}
          alt="แบนเนอร์โปรโมชั่นพื้นแดง ด้านซ้ายเป็นผู้หญิงผมยาวสีเข้มสวมชุดสีแดงสลับขาวที่มีคำว่า THE88 อยู่บนชุด ยกมือขึ้นแบมือ ด้านขวาเป็นโลโก้ THE88 ตัวอักษร THE สีแดงขอบทองและเลข 88 สีครีมขอบทอง ถัดลงมาเป็นข้อความสีขาวขอบทองว่า โปรโมชั่น และข้อความว่า คืนยอดเสีย ล่างสุดเป็นตัวเลขสีทองขนาดใหญ่ว่า 0.3% รอบภาพมีเหรียญทอง ไพ่ และชิปคาสิโนลายมงกุฎแดงสลับทองลอยอยู่"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), 488px"
          class="mx-auto h-auto w-full rounded-xl border border-[#a40201]/55 object-contain shadow-[0_10px_30px_rgba(28,5,4,0.75)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f2c14e]/75 hover:shadow-[0_15px_40px_rgba(164,2,1,0.45)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก THE88"
          class="flex items-center justify-center rounded-lg border border-[#ffe7a6]/60 bg-gradient-to-r from-[#ffe7a6] via-[#f2c14e] to-[#8a6524] px-10 py-3.5 text-lg font-black text-[#1c0504] shadow-[0_0_15px_rgba(242,193,78,0.50)] transition-transform hover:scale-105">
          สมัครสมาชิก THE88
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
