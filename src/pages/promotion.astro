---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

// Only slide1/slide2 belong to AKA99 (drop 2026-08-15), and they are exactly
// the two promotions this page shows: slide1 is the "คืนยอดเสีย รับโบนัส 0.3%"
// poster, slide2 is the "แนะนำเพื่อน รับโบนัส 0.8%" poster.
// slide3/slide4 are still on disk but belong to previous clients — they may not
// be imported here, now or on any future rebrand.
import promoCashback from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";

// This is an IMAGE page: the ContentBox title, ONE short intro paragraph, the
// poster grid, one CTA. No section headings, no extra prose — the posters
// already state every offer in large type.
//
// 150–160 CHARACTERS (not bytes — a byte count reads ~3x too long for Thai).
const pageDescription =
  "รวมโปรโมชั่น AKA99 สล็อตเว็บตรงค่ายใหญ่ เซิร์ฟนอก ทั้งคืนยอดเสียรับโบนัส 0.3% และแนะนำเพื่อนรับโบนัส 0.8% ดูรายละเอียดจากภาพและตรวจเงื่อนไขก่อนกดรับสิทธิ์";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น AKA99 คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8%",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});
---

<MainLayout title="โปรโมชั่น AKA99 สล็อตเว็บตรงค่ายใหญ่ คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น AKA99" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#cfdcea]">
        หน้านี้รวมโปรโมชั่นที่ AKA99 สล็อตเว็บตรงค่ายใหญ่ เซิร์ฟนอก เปิดให้สมาชิกกดรับอยู่ในขณะนี้ ทั้งโบนัสคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8%
        อัตราโบนัส ยอดที่นำมาคำนวณ และรอบเวลาการรับสิทธิ์ระบุไว้บนภาพโปรโมชั่นแต่ละใบ และเงื่อนไขของแต่ละรายการไม่เหมือนกัน
        สมาชิกตรวจสอบสิทธิ์และกดรับโบนัสได้จากบัญชีสมาชิก หรือสอบถามแอดมินทาง LINE Official ที่ดูแลตลอด 24 ชั่วโมง
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่นพื้นน้ำเงินเข้มลายเทคโนโลยี ด้านบนซ้ายเป็นโลโก้ AKA99 ถัดลงมาเป็นป้ายคำว่า โปรโมชั่น แล้วตามด้วยคำว่า คืนยอดเสีย และ รับโบนัส 0.3% ตัวใหญ่ ด้านขวาเป็นหญิงสาวชุดครอปสีเงินเมทัลลิกชี้นิ้วไปทางข้อความ แถวล่างมีไอคอนสามช่อง คืนยอดเสียทุกวันไม่ต้องทำเทิร์น รับโบนัสไวภายใน 24 ชม. และสิทธิพิเศษสำหรับสมาชิกทุกระดับ"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#1e4b9e]/60 object-contain shadow-[0_10px_30px_rgba(11,108,240,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#9dd2fa]/70 hover:shadow-[0_15px_40px_rgba(195,206,217,0.28)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่นพื้นน้ำเงินเข้มลายเรขาคณิต ด้านบนซ้ายเป็นโลโก้ AKA99 ถัดลงมาเป็นคำว่า โปรโมชั่น ตัวใหญ่ และป้ายข้อความ แนะนำเพื่อน รับโบนัส 0.8% ด้านขวาเป็นหญิงสาวชุดรัดรูปสีเงินเมทัลลิกมีโลโก้ AKA99 ที่หน้าอก แบฝ่ามือไปทางข้อความ"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#1e4b9e]/60 object-contain shadow-[0_10px_30px_rgba(11,108,240,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#9dd2fa]/70 hover:shadow-[0_15px_40px_rgba(195,206,217,0.28)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#9dd2fa]/70 bg-gradient-to-r from-[#4aa3ff] via-[#0b6cf0] to-[#0a2a6b] px-10 py-3.5 text-lg font-black text-[#03081c] shadow-[0_0_15px_rgba(11,108,240,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก AKA99
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
