---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

// ⚠️ บทบาทของสไลด์รอบนี้ "สลับด้าน" กับที่ brand-spec §7 เขียนไว้ — เปิดไฟล์จริงดูแล้ว
// ทั้งสองใบ (ดรอป 2026-09-30 01:57) ห้ามเชื่อทั้งชื่อตัวแปรที่ตกทอดมาและตารางในสเปก:
//   slide1.png — 600x600 โปสเตอร์ BRAVO168 ป้ายน้ำเงิน-ทอง "แนะนำเพื่อน โบนัส" + เลขทอง 0.8%
//   slide2.png — 600x600 โปสเตอร์ชุดเดียวกัน ป้าย "คืนยอดเสีย โบนัส" + เลขทอง 0.3%
//   slide3.png / slide4.png — โปสเตอร์ของแบรนด์ก่อน (29 ก.ย. 22:07 เก่ากว่าดรอปนี้)
//     ห้าม import กลับมาเด็ดขาด และห้ามลบไฟล์ทิ้งเพราะเป็นอินเวนทอรีของรอบถัดไป
// ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้วและ verify-build จะแดง
// (banner2/banner3 ใน src/assets ก็เก่ากว่าดรอปนี้ = อาร์ตเวิร์กแบรนด์ก่อน ห้าม import)
import promoReferral from "../assets/slide1.png";
import promoCashback from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";
//
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ: ContentBox title, ย่อหน้าเกริ่นสั้น ๆ หนึ่งย่อหน้า
// (ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมดของหน้านี้), กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม
// — ไม่มีหัวข้อย่อยและไม่มีย่อหน้าเพิ่ม เพราะตัวโปสเตอร์ระบุชื่อโปรและตัวเลขโบนัส
// ไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว เป้าหมาย h1x1, h2x0, h3x0
//
// สไลด์รอบนี้เป็นจัตุรัส 600x600 จึงวางเป็นกริดสองคอลัมน์คุมความกว้างรวมที่ max-w-4xl
// (896px) ทำให้ช่องละ ~436px ไม่ต้องอัปสเกลเกินขนาดไฟล์ต้นทาง widths หยุดที่ 600 ตาม
// ความกว้างจริงของไฟล์ สองใบพอดีหนึ่งแถว กริดจึงจัดกลางสมมาตรโดยไม่ต้องมีใบที่ span
// สองคอลัมน์ · เรียงคืนยอดเสีย 0.3% ก่อนแนะนำเพื่อน 0.8% ตามลำดับที่บรีฟไล่ไว้
//
// Announcement หมุนมาเป็น AnnouncementPremium ทั้งเว็บรอบนี้ (รอบก่อนเป็น Announcement5)
// — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ BRAVO168 แล้ว และ index
// ก็เรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop message มิฉะนั้นตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ BRAVO168 (น้ำเงินรอยัล + ทอง บนพื้นกรมท่าสนามกลางคืน ตามโลโก้ BRAVO โครเมียม
// น้ำเงินคู่เลข 168 ทอง และแบนเนอร์สนามกลางคืนที่มีริ้วแสงทอง เหรียญทอง ลูกบอลทอง-กรมท่า):
// พื้นเพจ #02081a · การ์ด #04142f · ผิวยก #072247 · เส้น/ขอบ #0e3f8f ·
// น้ำเงินรอยัล #1558c4 · น้ำเงินสว่าง #2f86f0 · ทองหลัก #f4cb69 · ทองอ่อน #ffe39a ·
// ทองเข้ม #c9922e · เนื้อความ #dbe5f5 (BRAND_TEXT) · หมึกบนพื้นทอง #0a1020
// เรืองแสง: ทอง rgba(244,203,105,0.30) · น้ำเงิน rgba(21,88,196,0.35)
// การ์ดโปสเตอร์ได้ขอบทองทั้งสองใบเพราะเลขโบนัสบนภาพทั้งคู่เป็นตัวอักษรทอง
// ปุ่ม CTA เป็นไล่เฉดทอง #ffe39a → #f4cb69 → #c9922e และใช้หมึกเข้ม #0a1020
// (ขาวบนทอง #f4cb69 ได้แค่ ~1.8:1 ตก AA จึงต้องใช้หมึกเข้ม)
// ชุดเขียวนีออนของ CK268 (#8bfc13 #c9ff8f #1a7a08 #12a008 #e8f0e6 #d5e6cd #eaffd6
// #030703 #071007 #0f1b0e rgba(139,252,19,*) rgba(1,4,1,*)) ถูกแทนครบทุกจุดแล้ว
// ทั้งคลาส Tailwind raw hex และ rgba() ที่ใช้ทำแสงเรือง
//
// BRAVO168 เป็นเว็บ "แทงบอลออนไลน์" ไม่ใช่สล็อตและไม่ใช่หวย — คำว่า สล็อต วงล้อ
// ฟรีสปิน ตัวคูณ ค่ายเกม RTP เกมแตก หวย เลขเด็ด ตรวจหวย แนวทาง ยี่กี บาคาร่า
// ห้ามปรากฏบนหน้านี้ ตัวเลขที่บรีฟระบุและใช้ได้มีแค่ คืนยอดเสีย 0.3% · แนะนำเพื่อน
// 0.8% · 3 ขั้นตอน · 24 ชั่วโมง · และ 168 ในชื่อแบรนด์ ห้ามเพิ่มชื่อผู้ให้บริการ
// ชื่อธนาคาร ยอดฝากขั้นต่ำ เลขใบอนุญาต จำนวนสมาชิก หรือปีที่ก่อตั้ง และต้องคง hedge
// ของบรีฟไว้ว่าแต่ละโปรโมชั่นอาจกำหนดประเภทการเดิมพัน ลีก ยอดที่เข้าเกณฑ์ และรอบ
// คำนวณต่างกัน จึงควรอ่านเงื่อนไขล่าสุดให้ครบก่อนกดรับโบนัส
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 151
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "รวมภาพโปรโมชั่นแทงบอล BRAVO168 ทั้งโบนัสคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ตรวจสอบประเภทบิล ลีกที่ร่วมรายการ รอบคำนวณ และเงื่อนไขล่าสุดก่อนกดรับสิทธิ์";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่นแทงบอล BRAVO168",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});
---

<MainLayout title="โปรโมชั่นแทงบอล BRAVO168 คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่นแทงบอล BRAVO168" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#dbe5f5]">
        หน้านี้รวมภาพโปรโมชั่นที่ <strong class="text-[#ffe39a]">BRAVO168</strong> เปิดให้สมาชิก Login เข้าไปตรวจสอบสิทธิ์จากบัญชีของตนเอง ทั้งโบนัสคืนยอดเสียและกิจกรรมแนะนำเพื่อน โดยรายละเอียดของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว
        <strong class="text-[#ffe39a]">แต่ละโปรโมชั่นอาจกำหนดประเภทการเดิมพัน ลีก ยอดที่เข้าเกณฑ์ และรอบคำนวณแตกต่างกัน</strong> จึงควรอ่านเงื่อนไขล่าสุดจากหน้าเว็บไซต์ให้ครบก่อนกดรับโบนัสทุกครั้ง
      </p>

      <div class="mx-auto grid w-full max-w-4xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่น BRAVO168 พื้นสนามกลางคืนสีน้ำเงินกรมท่า มีริ้วแสงทองพาดโค้ง ลูกฟุตบอลลายน้ำเงิน-ทอง เหรียญทองกองซ้อน กล่องของขวัญน้ำเงิน-ทอง และถ้วยรางวัลทองที่มุมขวาล่าง ด้านซ้ายเป็นหญิงสาวผมยาวสีเข้มสวมชุดขาวแต่งทองยื่นมือออกมา ด้านบนเป็นโลโก้ตัวอักษร BRAVO โครเมียมน้ำเงินคู่กับเลข 168 สีทอง ถัดลงมาเป็นตัวอักษรไทยสีทองขนาดใหญ่ว่า โปรโมชั่น ใต้ลงไปเป็นป้ายน้ำเงิน-ทองคำว่า คืนยอดเสีย โบนัส คร่อมตัวเลขทองขนาดใหญ่ 0.3%"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), (max-width: 1007px) calc((100vw - 136px) / 2), 436px"
          class="mx-auto h-auto w-full rounded-xl border border-[#f4cb69]/60 object-contain shadow-[0_10px_30px_rgba(2,8,26,0.85)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ffe39a]/85 hover:shadow-[0_15px_40px_rgba(244,203,105,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่น BRAVO168 ชุดเดียวกัน พื้นสนามกลางคืนสีน้ำเงินกรมท่า มีริ้วแสงทอง ลูกฟุตบอลน้ำเงิน-ทอง เหรียญทอง กล่องของขวัญน้ำเงิน-ทอง และถ้วยรางวัลทอง ด้านซ้ายเป็นหญิงสาวผมยาวสีเข้มสวมชุดขาวแต่งทองยกนิ้วชี้ขึ้น ด้านบนเป็นโลโก้ตัวอักษร BRAVO โครเมียมน้ำเงินคู่กับเลข 168 สีทอง ถัดลงมาเป็นตัวอักษรไทยสีทองขนาดใหญ่ว่า โปรโมชั่น ใต้ลงไปเป็นป้ายน้ำเงิน-ทองคำว่า แนะนำเพื่อน โบนัส คร่อมตัวเลขทองขนาดใหญ่ 0.8%"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), (max-width: 1007px) calc((100vw - 136px) / 2), 436px"
          class="mx-auto h-auto w-full rounded-xl border border-[#f4cb69]/60 object-contain shadow-[0_10px_30px_rgba(2,8,26,0.85)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ffe39a]/85 hover:shadow-[0_15px_40px_rgba(244,203,105,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก BRAVO168"
          class="flex items-center justify-center rounded-lg border border-[#f4cb69]/70 bg-gradient-to-r from-[#ffe39a] via-[#f4cb69] to-[#c9922e] px-10 py-3.5 text-lg font-black text-[#0a1020] shadow-[0_0_15px_rgba(244,203,105,0.30)] transition-transform hover:scale-105">
          สมัครสมาชิก BRAVO168
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
