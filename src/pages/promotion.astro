---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

// ดรอปนี้ (2026-10-29, brand-spec §6) มีสไลด์ของแบรนด์นี้ **สองใบ** และชื่อตัวแปร
// ตั้งตาม **ข้อความที่พิมพ์อยู่บนภาพจริง** (เปิดบิตแมปอ่านเองรอบนี้ ไม่ได้เชื่อ
// คอมเมนต์เก่า) ไม่ใช่ตามเลขไฟล์ — ถ้ารอบหน้าเจอความขัดแย้ง **ให้เชื่อข้อความบนรูป**:
//   slide1.png (375x600, mtime 2026-10-29) — โปสเตอร์ "โปรโมชั่น คืนยอดเสีย 0.3%"
//   slide2.png (375x600, mtime 2026-10-29) — โปสเตอร์ "โปรโมชั่น แนะนำเพื่อน โบนัส 0.8%"
// 🚨 รอบนี้เลขท้ายชื่อไฟล์บังเอิญเรียงตรงกับลำดับของบรีฟ **แต่ห้ามถือเป็นกฎข้ามรอบ**
// uploader เขียนทับไฟล์ชื่อเดิมทุกดรอป เลขไฟล์จึงไม่มีความหมายข้ามแบรนด์
// ต้องเปิดบิตแมปดูใหม่ทุกรอบ (รอบก่อนเลขไฟล์กับตัวเลขบนภาพสลับกัน)
//   สไลด์ใบที่สามและสี่ (mtime 2026-09-29 = คนละดรอป คนละแบรนด์) — **ห้าม import**
//   แบนเนอร์ใบที่สองและสาม (mtime 2026-10-23 = อาร์ตเวิร์กของอีกแบรนด์) —
//     **ห้าม import** รอบนี้ไม่มี "รูปประกอบบทความ" เลย
//   (ชื่อไฟล์เต็มของทั้งสี่อยู่ใน brand-spec §6 — ไม่พิมพ์ที่นี่ เพื่อให้ grep หา
//    การ import ที่หลงเหลือได้คำตอบว่างจริงๆ)
// ⚠️ eager import = emit ลง dist/ ต่อให้ไม่ได้ render และ verify-build จะแดง
// การ import ไฟล์เก่าคือการส่งรูปของลูกค้ารายอื่นขึ้นเว็บนี้
// **ห้ามลบไฟล์เก่าทิ้ง** — เป็นอินเวนทอรีของรอบถัดไป แค่ห้าม import
// (banner1 / banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักชื่อไว้เอง —
// ห้ามอ้างจากหน้านี้) รอบนี้หน้านี้จึงมีเฉพาะสไลด์สองใบ กริดจึงเป็นสองช่อง
import promoCashback from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5 · brand-spec §4):
// ContentBox title หนึ่งอัน (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้นๆ ประมาณสี่บรรทัด
// คือโควตาตัวหนังสือทั้งหมดของหน้านี้, กริดภาพสองใบ, ปุ่ม CTA หนึ่งปุ่ม —
// **ห้ามมีหัวข้อย่อยและห้ามเพิ่มย่อหน้า** เพราะโปสเตอร์พิมพ์ชื่อโปรและเปอร์เซ็นต์
// ของตัวเองด้วยตัวอักษรขนาดใหญ่อยู่แล้ว การพิมพ์ซ้ำด้านล่างด้วยตัวเล็กกว่าไม่ได้
// ให้ข้อมูลใหม่ · บรีฟรอบนี้ (src/assets/content.txt, 29 บรรทัด) **ไม่มีส่วน
// SUB-PAGES เลย** ทุกย่อหน้าที่เคยอยู่บนหน้านี้คือของที่รีแบรนด์รอบก่อนๆ แต่งขึ้นเอง
//
// 🚨🚨 รอบนี้เป็น **เว็บคาสิโนออนไลน์** (บาคาร่า · สล็อตออนไลน์ · รูเล็ต · ไฮโล ·
// คาสิโนสด) **ไม่ใช่เว็บหวย** — รอบก่อนเป็นเว็บหวย หน้านี้จึงเคยเป็น "หน้ารวมภาพ
// อัตราจ่าย" ไม่ใช่หน้าโปรโมชั่น **รอบนี้กลับมาเป็นหน้าโปรโมชั่นจริงๆ** เพราะบรีฟ
// รอบนี้มีหมวดโปรโมชั่นของตัวเอง (content.txt บรรทัด 7-12) คือ คืนยอดเสีย 0.3%
// และแนะนำเพื่อน 0.8%
// ตัวเลขที่อยู่บนหน้านี้ได้มีแค่ของบรีฟเอง: 0.3% · 0.8% (และ 1 บาท · 24 ชั่วโมง ·
// 3 ขั้นตอน ซึ่งไม่มีที่ยืนบนหน้านี้) **ไม่มี 100% ไม่มียอดฝากขั้นต่ำเป็นตัวเลข**
// ⚠️ ประโยคกำกับของบรีฟ **ต้อง ship ครบใน intro** ห้ามตัดเพราะฟังดูลบ:
//   · แม้เว็บไซต์จะใช้ข้อความว่าโบนัสไม่อั้น แต่ควรตรวจสอบว่ามีวงเงินสูงสุดหรือ
//     ข้อกำหนดเพิ่มเติมหรือไม่ (บรรทัด 8)
//   · โปรโมชั่นคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือ
//     เพิ่มโอกาสชนะในครั้งถัดไป (บรรทัด 10)
//
// ลำดับในกริด: **คืนยอดเสีย 0.3% ก่อน แนะนำเพื่อน 0.8%** ตามลำดับของบรีฟ
// (content.txt บรรทัด 9 แล้ว 11) = slide1 ก่อน slide2 **ยึดบรีฟ ไม่ใช่เลขไฟล์**
// ⚠️⚠️ **บิตแมปจริงของดรอปนี้คือ 375x600 แนวตั้ง** ทั้งสองใบ (วัดจาก IHDR รอบนี้)
// ความกว้างสูงสุดคือ 375 widths จึงหยุดที่ 375 และคุมที่ max-w ที่ 375px
// **ให้วัดใหม่ทุกรอบจากไฟล์จริง อย่าเชื่อสัดส่วนของรอบก่อน และห้ามขยายเกินต้นฉบับ**
// sizes คิดจากความกว้างที่ถูกวาดจริง: section px-4 (16px/ข้าง) + การ์ด p-8
// (32px/ข้าง, เป็น p-10 = 40px ที่ md ขึ้นไป) + gap-6 ระหว่างคอลัมน์ (24px)
//   ใต้ 640px = คอลัมน์เดียว → 100vw-96px
//   640-767px = สองคอลัมน์ p-8 → 50vw-60px
//   768-885px = สองคอลัมน์ p-10 → 50vw-68px
//   ตั้งแต่ 886px ขึ้นไปชนเพดาน 375px
// LCP คือ hero ใน MainLayout ไม่ใช่รูปพวกนี้ จึง loading="lazy" fetchpriority="low"
// decoding="async" และ quality ตัวเดียวทั้ง avif/webp — ห้ามจูนแยกฟอร์แมต
// (tools/avif-quality-service.mjs ย่อฝั่ง avif ให้เองที่ x0.65)
//
// quality={64} ไม่ใช่ 80 ตามปกติ: สไลด์ทั้งสองเป็นภาพถ่ายคนในฉากอิ่มสี บวก
// ตัวอักษรไทยสามมิติผิวมันเงาตัดขอบคมที่มีไฮไลต์ทับอยู่ด้านบน ซึ่งเป็นเคสที่
// AVIF ทำได้แย่ที่สุด ที่ quality=80 ไฟล์ AVIF มีโอกาสออกมา **ใหญ่กว่า** WebP ที่เป็น
// fallback ของตัวเอง เบราว์เซอร์ที่รองรับ AVIF จะหยิบไฟล์ที่หนักกว่าไปใช้ และ
// verify-build.mjs ทำให้ build แดงด้วยเหตุนี้ตรงๆ · ทางแก้คือ quality ที่ **ต่ำลง**
// ไม่ใช่สูงขึ้น · ค่าเดียวกันนี้ต้องใช้ที่ index.astro กับสไลด์ใบเดียวกัน
//
// Announcement รอบนี้หมุนมาเป็นตัวเลขห้า ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ตัวท้ายชื่อหวยจึงหมุนออก · เขียนชื่อ variant แบบไม่มีเครื่องหมายคำพูด
// โดยตั้งใจ เพราะ tools/gen-tw-sources.mjs นับ literal ที่มีเครื่องหมายคำพูดว่าเป็น
// การ import จริง คอมเมนต์จึงทำให้ variant เก่าหลุดเข้า Tailwind scan แล้วสีของ
// แบรนด์ก่อนขึ้น stylesheet) orchestrator ตั้ง default message ของไฟล์นั้นเป็น
// คอปปี้ของแบรนด์นี้ไว้แล้ว และทุกหน้าเรียกแบบ bare เหมือนกัน จึง **ห้ามส่ง prop message**
//
// ───────────────────────────────────────────────────────────────────────────
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) — **ทิศความสว่างเหมือนรอบก่อน (เนื้อหาสว่าง
// โครมเข้ม) แต่คนละตระกูลสีทั้งชุด** bg.json ของดรอปนี้คือ
// {"mode":"color","color":"#f8b9f0"} = **ชมพูพาสเทลอิ่มตัว**
// (รอบก่อน LOTTOPLUS เป็น e1fef3 เขียวมินต์จาง — **ห้ามสืบทอดค่า อ่าน bg.json ทุกรอบ**)
// ⚠️⚠️ **พื้นเพจรอบนี้อิ่มตัวกว่ารอบก่อนมาก** → **ตัวอักษรขาวบนพื้นเพจได้ 1.6:1
// = ห้ามเด็ดขาด** · **ห้าม "แก้" การ์ดกลับไปเป็นผิวเข้ม** — ผิวเข้มบนหมึก #3d0a2c
// = ตัวอักษรหายไปเลย
// ลำดับผิว: พื้นเพจ #f8b9f0 / การ์ด ContentBox #ffffff / การ์ดสำรอง #fff5fb /
// พื้นถมอ่อน #fcd9ee / เส้นบาง #f3a7d3 · ขอบตกแต่ง/ออรา #e0509f · ออราสว่าง #ff7ac2
// (**สี่ค่าหลังห้ามถือตัวอักษรทุกกรณี** — #e0509f ได้แค่ 3.6:1 บนการ์ดขาว)
// หมึก #3d0a2c = เนื้อความ (= BRAND_TEXT ที่ <html> และการ์ด ContentBox ตั้งให้แล้ว
// 16.4:1 บนการ์ด) · หมึกรอง #7a4263 (7.5:1) · ทองเข้ม #6e4705 (8.2:1)
// ชมพูบานเย็น #a30d63 = สีของ <strong> ในเนื้อความ หัวข้อ และลิงก์ (7.5:1 บนการ์ด)
// 🚨🚨 **#f2c14e (ทองอำพัน) ได้แค่ 1.7:1 บนการ์ดขาว — บนหน้านี้เป็นพื้น/ขอบเท่านั้น**
// ปุ่ม CTA ของหน้านี้เป็น **PRIMARY = ไล่เฉดชมพูบานเย็น** #d11a7e → #a30d63 → #7a0449
// บนหมึก **ขาว #ffffff** (5.0 / 7.5 / 10.8:1 ต่อ stop — ผ่าน AA ทุก stop)
// ⚠️⚠️ **ห้ามลากปลายอ่อนกว่า #d11a7e** (ขาวบน #e0509f เหลือ 3.6:1) และ
// **ห้ามใช้หมึกเข้ม #3d0a2c บนปุ่มนี้** (บน #7a0449 ได้ 1.5:1)
// rgba() ที่อนุญาตรอบนี้: rgba(163,13,99,α) · rgba(224,80,159,α) ·
// rgba(255,122,194,α) · rgba(209,26,126,α) · rgba(61,10,44,α) · rgba(68,13,49,α) ·
// rgba(43,6,32,α) · rgba(242,193,78,α)
// ⚠️⚠️ **เงาบนการ์ดสว่างต้องเบา** — รอบนี้ใช้ rgba(61,10,44,0.10) และ hover
// rgba(163,13,99,0.18) **ห้ามลอก alpha ของรอบก่อนมา**
// ⚠️⚠️ กับดักที่แหลมที่สุดรอบนี้คือ **ชมพูของแบรนด์อื่น** ซึ่งเป็นตระกูลเดียวกับ
// รอบนี้เป๊ะ (okkub88 ชมพูบานเย็น · ถอนชัวร์168 ชมพูบับเบิลกัม · 123BET แดงชาด-ชมพูบลัช)
// ที่ห้ามคือ **ค่าเฮกซ์ของแบรนด์เก่าแบบตรงหกหลัก** ไม่ใช่ "สีชมพู" ในฐานะตระกูลสี
// ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน brand-spec §2 ห้ามตัดสินด้วยสายตา
// (ค่าของ LOTTOPLUS รอบก่อนทันทีที่ต้องไม่หลงเหลือ เขียนแบบไม่มี # โดยตั้งใจ:
//  e1fef3 f0fdf7 d2f3e4 a3ddc3 19a97c 2fd49b 0d3326 3f6f5c 046c4e 0c7c58 03543c
//  8a6508 e2b32a c8d4d0 รวมถึงรูปแบบ rgba ของค่าเหล่านั้นด้วย)
// · ผ้าซาตินชมพู ชุดลูกไม้ของนางแบบ ลูกหมูการ์ตูน ไพ่เอซ ลูกเต๋า ชิปคาสิโน และ
//   วงล้อรูเล็ตขอบทองในอาร์ตเวิร์กเป็น **วัตถุในภาพ ไม่ใช่สี UI**
// · พื้นเพจมาจาก bg.json เท่านั้น **ห้ามอนุมานจากรูป**
// · <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ
// ถ้าเปิด/ปิดกลางคำ บรรทัดจะตัดกลางคำ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -c บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงนี้ยาว 158 ด้วยชื่อแบรนด์ 5 อักขระของรอบนี้
// (**ต้องนับใหม่ทุกรอบ** ห้ามสืบทอดความยาว — รอบก่อนชื่อยาว 9)
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `รวมภาพโปรโมชั่น ${BRAND_NAME} ทั้งคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ไว้ในหน้าเดียว ควรตรวจสอบประเภทเกมที่เข้าร่วมและเงื่อนไขการรับสิทธิ์จากประกาศล่าสุดก่อนใช้สิทธิ์`;

const graph = pageGraph(Astro, {
  name: `รวมภาพโปรโมชั่น ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});

// ความกว้างที่ถูกวาดจริงของแต่ละคอลัมน์ในกริดสองคอลัมน์ (ดูคอมเมนต์ sizes ด้านบน)
const promoSizes = "(max-width: 639px) calc(100vw - 96px), (max-width: 767px) calc(50vw - 60px), (max-width: 885px) calc(50vw - 68px), 375px";

const promoClass =
  "mx-auto h-auto w-full max-w-[375px] rounded-xl border border-[#f3a7d3] object-contain shadow-[0_8px_28px_rgba(61,10,44,0.10)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#e0509f] hover:shadow-[0_12px_40px_rgba(163,13,99,0.18)]";

// alt ทั้งสองเขียนจากบิตแมปของดรอปนี้ที่เปิดอ่านเองแล้ว (**375x600 แนวตั้ง** ทั้งคู่) —
// ฉากโทนชมพูพาสเทล ผ้าซาตินชมพูนวลพลิ้ว ดอกไม้ชมพูจาง และกล่องของขวัญผูกโบว์
// หญิงสาวผมยาวสีน้ำตาลผูกโบว์ริบบิ้นซาตินชมพู ชุดลูกไม้ระบายสีชมพูอ่อน ต่างหู
// รูปหัวใจ ท้าวคางมองมาทางผู้ชม · มุมบนขวาเป็นมาสคอตลูกหมูการ์ตูนในจานวงกลม
// ชมพูขอบขาว เหนือเวิร์ดมาร์กละตินสามมิติตัวอ้วนมน ผิวไล่ขาวนวลลงชมพูอ่อน
// ตัดขอบชมพูเข้มหนาสองชั้น ตัวอักษรตัวแรกมีหัวใจชมพูดวงเล็กซ้อนอยู่ในช่องกลาง ·
// ตัวอักษรไทยสามมิติว่า โปรโมชั่น · ตัวเลขเปอร์เซ็นต์ตัวโตสามมิติผิวทองอ่อน ·
// แคปซูลพื้นชมพูเข้มขอบขาวท้ายภาพเขียนว่า สมัครสมาชิก พร้อมไอคอนรูปคนกับ
// เครื่องหมายบวกและลูกศรคู่
// ⚠️ alt คือ "ข้อความที่พิมพ์อยู่บนโปสเตอร์" เป็นหลัก — ตัวเลขท้าย alt ต้องตรงกับรูป
// ⚠️ ห้ามเรียกรูปคู่นี้ว่าภาพแนวนอนหรือภาพสี่เหลี่ยมจัตุรัส รอบนี้เป็น **แนวตั้ง**
// ⚠️ จุดที่ **ต่างกันจริงระหว่างสองใบ** และต้องเขียนให้ตรง (ตรวจจากบิตแมปรอบนี้):
//   slide1 (คืนยอดเสีย 0.3%) — ขอบล่างมี **ไพ่เอซกับกองชิปคาสิโนชมพู-ขาว**
//     และ **ไม่มีโทรโข่ง**
//   slide2 (แนะนำเพื่อน 0.8%) — มี **โทรโข่งสีชมพู-ขาว** อยู่เหนือตัวเลข และ
//     ขอบล่างเป็น **กองกล่องของขวัญชมพูผูกโบว์** ไม่มีไพ่และชิป
//   **ห้ามเขียนว่ามีทั้งโทรโข่งและไพ่ในใบเดียวกัน** และห้ามลอก alt ของรอบก่อน
//     (รอบก่อนเป็นฉากชุดไทยเขียวมรกตกับยอดปรางค์ทองและลูกบอลหวย คนละอาร์ตเวิร์ก
//      กันคนละเรื่อง — องค์ประกอบของแบรนด์ก่อนๆ ที่ต้องไม่หลงเหลืออยู่ครบใน
//      brand-spec §6)
// ⚠️ ห้ามระบุว่าใช้มือซ้ายหรือมือขวา — รอบก่อนๆ เขียนไว้แล้วผิดหลายรอบติด
// ⚠️ **ลูกหมูรอบนี้ไม่มีปีก** (ต่างจากหมูบิน168) และ **ไม่ได้ชูสองนิ้ว**
// (ต่างจากหน้าการ์ตูนกลมชมพูของ okkub88) — บรรยายตามที่เห็นจริง
// ⚠️ สีของวัตถุในรูป (ผ้าซาติน ชุดลูกไม้ ชิป ไพ่) เป็นวัตถุในภาพ ไม่ใช่สีของแบรนด์
// 🚨 **ห้ามพิมพ์ตัวอักษรของชื่อแบรนด์ลงใน alt** ให้บรรยาย "รูปร่าง" ของเวิร์ดมาร์ก
// แล้วเรียกชื่อแบรนด์ผ่าน BRAND_NAME เท่านั้น (brand-spec §6)
const altCashback = `โปสเตอร์โปรโมชั่นแนวตั้ง มุมบนขวาเป็นโลโก้ ${BRAND_NAME} แบบเวิร์ดมาร์กละตินสามมิติตัวอ้วนมน ผิวไล่จากขาวนวลลงชมพูอ่อน ตัดขอบชมพูเข้มหนาสองชั้น โดยตัวอักษรตัวแรกมีหัวใจชมพูดวงเล็กซ้อนอยู่ในช่องกลาง เหนือขึ้นไปเป็นมาสคอตลูกหมูการ์ตูนหน้ากลมสีชมพู หูตก แก้มแดงระเรื่อ ขยิบตาข้างหนึ่ง สองขาหน้าเกาะขอบจานวงกลมชมพูขอบขาว ฝั่งซ้ายเป็นหญิงสาวผมยาวสีน้ำตาลเกล้าผมผูกโบว์ริบบิ้นซาตินชมพู สวมชุดลูกไม้ระบายสีชมพูอ่อนและต่างหูรูปหัวใจ ท้าวคางมองมาทางผู้ชม ฉากหลังเป็นผ้าซาตินชมพูนวลพลิ้ว ดอกไม้ชมพูจาง และหัวใจชมพูสามมิติผิวมันเงาลอยกระจาย ครึ่งขวาเป็นตัวอักษรไทยสามมิติอ่านว่า โปรโมชั่น ใต้ลงมาเป็นคำว่า คืนยอดเสีย แล้วตัวเลข 0.3% ตัวโตสามมิติผิวทองอ่อนตัดขอบชมพูเข้ม ขอบล่างมีไพ่เอซกับกองชิปคาสิโนชมพู-ขาว ปิดท้ายด้วยแคปซูลพื้นชมพูเข้มขอบขาวเขียนว่า สมัครสมาชิก พร้อมไอคอนรูปคนกับเครื่องหมายบวกและลูกศรคู่`;

const altReferral = `โปสเตอร์โปรโมชั่นแนวตั้ง มุมบนขวาเป็นโลโก้ ${BRAND_NAME} แบบเวิร์ดมาร์กละตินสามมิติตัวอ้วนมน ผิวไล่จากขาวนวลลงชมพูอ่อน ตัดขอบชมพูเข้มหนาสองชั้น โดยตัวอักษรตัวแรกมีหัวใจชมพูดวงเล็กซ้อนอยู่ในช่องกลาง เหนือขึ้นไปเป็นมาสคอตลูกหมูการ์ตูนหน้ากลมสีชมพู หูตก แก้มแดงระเรื่อ ขยิบตาข้างหนึ่ง สองขาหน้าเกาะขอบจานวงกลมชมพูขอบขาว ฝั่งซ้ายเป็นหญิงสาวผมยาวสีน้ำตาลผูกโบว์ริบบิ้นซาตินชมพูสองช่อ สวมชุดลูกไม้ระบายสีชมพูอ่อนและต่างหูรูปหัวใจ ท้าวคางมองมาทางผู้ชม ฉากหลังเป็นผ้าซาตินชมพูนวลพลิ้ว ดอกไม้ชมพูจาง และหัวใจชมพูสามมิติผิวมันเงาลอยกระจาย ครึ่งขวาเป็นตัวอักษรไทยสามมิติอ่านว่า โปรโมชั่น ใต้ลงมาเป็นคำว่า แนะนำเพื่อน แล้วคำว่า โบนัส คู่กับโทรโข่งสีชมพู-ขาว แล้วตัวเลข 0.8% ตัวโตสามมิติผิวทองอ่อนตัดขอบชมพูเข้ม ขอบล่างเป็นกองกล่องของขวัญสีชมพูผูกโบว์ ปิดท้ายด้วยแคปซูลพื้นชมพูเข้มขอบขาวเขียนว่า สมัครสมาชิก พร้อมไอคอนรูปคนกับเครื่องหมายบวกและลูกศรคู่`;
---

<MainLayout title={`รวมภาพโปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`รวมภาพโปรโมชั่น ${BRAND_NAME}`} as="h1">
    <div class="flex flex-col gap-10">
      <p>
        หน้านี้รวมภาพโปรโมชั่นที่ {BRAND_NAME} ระบุไว้สำหรับสมาชิก ทั้งคืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน และแนะนำเพื่อน โบนัส 0.8% ไม่จำกัด โดยรายละเอียดของแต่ละรายการพิมพ์อยู่บนภาพแล้ว ทั้งนี้
        <strong class="text-[#a30d63]">
          ควรตรวจสอบประเภทเกมที่เข้าร่วม รอบเวลาคำนวณเครดิต เงื่อนไขการถอนเงิน และวงเงินสูงสุดของรายการที่ระบุว่าโบนัสไม่อั้น จากประกาศล่าสุดก่อนรับสิทธิ์ เพราะโปรโมชั่นคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งถัดไป
        </strong>
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt={altCashback}
          loading="lazy"
          fetchpriority="low"
          widths={[250, 375]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />

        <Picture
          src={promoReferral}
          alt={altReferral}
          loading="lazy"
          fetchpriority="low"
          widths={[250, 375]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="relative isolate flex items-center justify-center overflow-hidden rounded-lg border border-[#e0509f] bg-gradient-to-b from-[#d11a7e] via-[#a30d63] to-[#7a0449] px-10 py-3.5 text-lg font-black text-[#ffffff] shadow-[0_8px_22px_rgba(163,13,99,0.30)] transition-transform hover:scale-105">
          <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-white/10 to-transparent"></span>
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
