---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

// ดรอปอาร์ตเวิร์กของ GOT777 คือ 2026-09-29 และมีโปสเตอร์โปรโมชั่นแค่ "สองใบ"
// เปิดดูไฟล์จริงทุกไฟล์แล้วก่อนผูก อย่าเชื่อชื่อตัวแปรที่ตกทอดมาและอย่าคัดลอก
// import จากประวัติ git เพราะบทบาทของไฟล์ชุดนี้สลับกันมาแล้วหลายแบรนด์:
//   slide1.png — 600x600 โปสเตอร์ GOT777 ป้ายแดง "แนะนำเพื่อน โบนัส" + เลขทอง 0.8%
//   slide2.png — 600x600 โปสเตอร์ชุดเดียวกัน ป้ายแดง "คืนยอดเสีย โบนัส" + เลขทอง 0.3%
//   slide3.png / slide4.png — โปสเตอร์หวยของ LOTTOPLUS (แบรนด์ก่อน) ห้าม import
//     กลับมาเด็ดขาด เพราะจะเอาโปสเตอร์ของแบรนด์คู่แข่งคนละสินค้าขึ้นหน้านี้
//     และห้ามลบไฟล์ทิ้งเพราะเป็นอินเวนทอรีของรอบถัดไป
// ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้วและ verify-build จะแดง
// ถ้ามีสไลด์ใหม่เข้ามาให้เช็ก mtime เทียบดรอปก่อนเพิ่ม (banner2/banner3 ใน
// src/assets เก่ากว่าดรอปนี้ = อาร์ตเวิร์กแบรนด์ก่อน ห้าม import กลับมา)
import promoReferral from "../assets/slide1.png";
import promoCashback from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";
//
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ: ContentBox title, ย่อหน้าเกริ่นสั้น ๆ หนึ่งย่อหน้า
// (ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมดของหน้านี้), กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม
// — ไม่มีหัวข้อย่อยและไม่มีย่อหน้าเพิ่ม เพราะตัวโปสเตอร์ระบุชื่อโปรและตัวเลขโบนัส
// ไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว เป้าหมาย h1x1, h2x0, h3x0
//
// สไลด์รอบนี้เป็นจัตุรัส 600x600 (วัดจากไฟล์จริง ไม่ใช่ 600x334 แบบแบนเนอร์รอบก่อน)
// จึงวางเป็นกริดสองคอลัมน์คุมความกว้างรวมที่ max-w-4xl (896px) ทำให้ช่องละ ~436px
// ไม่ต้องอัปสเกลเกินขนาดไฟล์ต้นทาง widths หยุดที่ 600 ตามความกว้างจริงของไฟล์
// สองใบพอดีหนึ่งแถว กริดจึงจัดกลางสมมาตรโดยไม่ต้องมีใบที่ span สองคอลัมน์
//
// Announcement หมุนมาเป็น Announcement3 ทั้งเว็บรอบนี้ — orchestrator ตั้ง default
// message ของไฟล์นั้นเป็นคอปปี้ของ GOT777 แล้ว และ index ก็เรียกแบบ bare เหมือนกัน
// จึงห้ามส่ง prop message มิฉะนั้นตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ GOT777 (ทองนำ แดงเลือดหมูรอง บนพื้นเกือบดำ ตามโลโก้ตัวอักษร GOT ทอง +
// เลข 777 แดง และแบนเนอร์ที่มีชิปคาสิโนดำแดงกับเหรียญทอง):
// พื้นเพจ #0a0503 · ผิวยก #160b06 · ผิวยก 2 #241108 ·
// ทองหลัก #f5c518 · ทองอ่อน #ffe9a8 · ทองลึก #96690f ·
// แดงรอง #d21622 · แดงลึก #7b0304 · แดงมืดสุด #4c0301 ·
// เนื้อความ #ece0cb (BRAND_TEXT) · เนื้อความรอง #bdae92 · เน้นใน strong #fff6dd ·
// หมึกบนพื้นทอง #0a0503
// การ์ดโปสเตอร์ได้ขอบทองหลักทั้งสองใบเพราะเลขโบนัสบนภาพทั้งคู่เป็นตัวอักษรทอง
// ปุ่ม CTA เป็นไล่เฉดทอง #ffe9a8 → #f5c518 → #96690f และใช้หมึกเข้ม #0a0503
// (หมึกเข้มบนทอง #f5c518 = 12.3:1 ผ่านสบาย ส่วนขาวบนทองตก)
// ชุดแดงของ LOTTOPLUS (#dc020e #ff2d38 #6b0207 #f3c623 #fde79a #8a6a0a #f0e2e2
// #fff4f4 #120b0c #1f0a0c #2a0d0f #1a0203 rgba(220,2,14,*) rgba(243,198,35,*))
// ถูกแทนครบทุกจุดแล้ว
//
// GOT777 เป็นเว็บ "เกมสล็อตออนไลน์" ไม่ใช่เว็บหวย — คำว่า หวย โพย แทงหวย ตรวจหวย
// รัฐบาลไทย ลาวพัฒนา ฮานอย หวยหุ้น อัตราจ่าย 2 ตัว/3 ตัว รอบออกรางวัล ส่งโพย งวด
// เลขเด็ด ห้ามปรากฏบนหน้านี้ ตัวเลขที่บรีฟระบุและใช้ได้มีแค่ คืนยอดเสีย 0.3% ·
// แนะนำเพื่อน 0.8% · 24 ชั่วโมง · และ 777 ในชื่อแบรนด์ ห้ามเพิ่มชื่อค่ายเกม
// ชื่อธนาคาร ยอดฝากขั้นต่ำ เลขใบอนุญาต หรือตัวเลข RTP และต้องคง hedge ของบรีฟไว้ว่า
// เงื่อนไขของแต่ละโปรโมชั่นต่างกัน ควรอ่านรายละเอียดล่าสุดจากหน้าเว็บไซต์ก่อนกดรับ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 156
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "รวมภาพโปรโมชั่นเกมสล็อต GOT777 ทั้งโบนัสคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ตรวจสอบเกมที่ร่วมรายการ รอบคำนวณ และเงื่อนไขล่าสุดจากหน้าเว็บไซต์ก่อนกดรับสิทธิ์";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่นเกมสล็อต GOT777",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoReferral.src,
});
---

<MainLayout title="โปรโมชั่น GOT777 เกมสล็อต คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่นเกมสล็อต GOT777" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#ece0cb]">
        หน้านี้รวมภาพโปรโมชั่นที่ <strong class="text-[#fff6dd]">GOT777</strong> เปิดให้สมาชิก Login เข้าไปตรวจสอบสิทธิ์จากบัญชีของตนเอง ทั้งโบนัสคืนยอดเสียและกิจกรรมแนะนำเพื่อน โดยรายละเอียดของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว
        <strong class="text-[#fff6dd]">โปรโมชั่นแต่ละรายการอาจกำหนดประเภทเกมสล็อต รอบคำนวณ ยอดที่เข้าเกณฑ์ และช่วงเวลารับสิทธิ์ต่างกัน</strong> จึงควรอ่านรายละเอียดล่าสุดจากหน้าเว็บไซต์ให้ครบก่อนกดรับทุกครั้ง
      </p>

      <div class="mx-auto grid w-full max-w-4xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่น GOT777 พื้นดำทองมีเหรียญทอง ชิปคาสิโน และกล่องของขวัญสีแดงกองอยู่ ด้านซ้ายเป็นหญิงสาวผมยาวในชุดขาวดำ ด้านขวาเป็นชายหนุ่มในเชิ้ตขาวชี้นิ้วมาข้างหน้า ด้านบนเป็นโลโก้ GOT777 ถัดลงมาเป็นตัวอักษรไทยสีทองขนาดใหญ่ว่า โปรโมชั่น ใต้ลงไปเป็นป้ายสีแดงคำว่า แนะนำเพื่อน โบนัส คร่อมตัวเลขทองขนาดใหญ่ 0.8% มุมขวาล่างเป็นเครื่องสล็อตเลข 777"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), (max-width: 1007px) calc((100vw - 136px) / 2), 436px"
          class="mx-auto h-auto w-full rounded-xl border border-[#f5c518]/60 object-contain shadow-[0_10px_30px_rgba(5,2,0,0.85)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ffe9a8]/85 hover:shadow-[0_15px_40px_rgba(245,197,24,0.40)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่น GOT777 ชุดเดียวกัน พื้นดำทองมีเหรียญทอง ชิปคาสิโนสีแดงดำ และกล่องของขวัญสีแดง ด้านซ้ายเป็นหญิงสาวผมยาวในชุดขาวดำ ด้านขวาเป็นชายหนุ่มในเชิ้ตขาวชี้นิ้วมาข้างหน้า ด้านบนเป็นโลโก้ GOT777 ถัดลงมาเป็นตัวอักษรไทยสีทองขนาดใหญ่ว่า โปรโมชั่น ใต้ลงไปเป็นป้ายสีแดงคำว่า คืนยอดเสีย โบนัส คร่อมตัวเลขทองขนาดใหญ่ 0.3% มุมขวาล่างเป็นเครื่องสล็อตเลข 777"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), (max-width: 1007px) calc((100vw - 136px) / 2), 436px"
          class="mx-auto h-auto w-full rounded-xl border border-[#f5c518]/60 object-contain shadow-[0_10px_30px_rgba(5,2,0,0.85)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ffe9a8]/85 hover:shadow-[0_15px_40px_rgba(245,197,24,0.40)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก GOT777"
          class="flex items-center justify-center rounded-lg border border-[#f5c518]/70 bg-gradient-to-r from-[#ffe9a8] via-[#f5c518] to-[#96690f] px-10 py-3.5 text-lg font-black text-[#0a0503] shadow-[0_0_15px_rgba(245,197,24,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก GOT777
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
