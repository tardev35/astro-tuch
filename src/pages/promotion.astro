---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

// เฉพาะ slide1/slide2 (ลงวันที่ 2026-09-04) เท่านั้นที่เป็นอาร์ตเวิร์กของ UVO88 —
// ตรวจจากตัวภาพจริงแล้ว: slide1 คือโปสเตอร์ "แนะนำเพื่อน 0.8%" ส่วน slide2 คือ
// "คืนยอดเสีย 0.3%"
// slide3/slide4 (2026-08-13) กับ banner2/banner3 ยังค้างอยู่บนดิสก์แต่เป็นอาร์ตเวิร์กของ
// ลูกค้าเจ้าอื่น (PIGAUTO — โปสเตอร์หวยตรุษจีนแดงทองพร้อมโลโก้หมูสีชมพู) —
// ห้าม import ที่นี่ทั้งรอบนี้และรอบถัดไป
// (ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้ว)
import promoReferral from "../assets/slide1.png";
import promoCashback from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็น IMAGE page: ContentBox title, ย่อหน้าเกริ่นสั้น ๆ หนึ่งย่อหน้า, กริดโปสเตอร์,
// ปุ่ม CTA หนึ่งปุ่ม — ไม่มีหัวข้อย่อยและไม่มีย่อหน้าเพิ่ม เพราะตัวโปสเตอร์ระบุเงื่อนไข
// ของแต่ละโปรโมชั่นไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว
//
// Announcement รอบนี้หมุนมาใช้ AnnouncementPremium ทั้งเว็บ — default message ของไฟล์นั้น
// เป็นข้อความของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ได้
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 157
const pageDescription =
  "รวมโปรโมชั่นของ UVO88 ทั้งแนะนำเพื่อนรับโบนัส 0.8% และคืนยอดเสีย 0.3% ดูเปอร์เซ็นต์ ยอดที่นำมาคำนวณ และรอบรับสิทธิ์ได้จากภาพโปรโมชั่นแต่ละใบก่อนกดรับทุกครั้ง";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น UVO88",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoReferral.src,
});
---

<MainLayout title="โปรโมชั่น UVO88 แนะนำเพื่อนรับ 0.8% และคืนยอดเสียรับ 0.3%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น UVO88" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#c8e3d0]">
        หน้านี้รวมโปรโมชั่นที่ UVO88 เปิดให้สมาชิกตรวจสอบสิทธิ์และกดรับผ่านบัญชีของตนเอง ทั้งแนะนำเพื่อนรับ
        <strong class="text-[#f3fbf5]">0.8%</strong> และคืนยอดเสีย <strong class="text-[#f3fbf5]">0.3%</strong>
        โดยเปอร์เซ็นต์ ยอดที่นำมาคำนวณ และรอบเวลารับสิทธิ์ระบุไว้บนภาพโปรโมชั่นแต่ละใบ
        <strong class="text-[#ffd76a]">แต่ละรายการมีเงื่อนไขต่างกัน จึงควรอ่านรอบการคำนวณ ประเภทเกมที่ร่วมรายการ และเงื่อนไขล่าสุดก่อนกดรับทุกครั้ง</strong>
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อน 0.8% พื้นหลังเขียวมรกตเข้ม มีเหรียญทองและชิปคาสิโนกระจาย มุมซ้ายบนเป็นโลโก้ UVO88 ตัวอักษร UVO สีทองบนชิปเขียวคู่กับเลข 88 สีทอง ถัดมาเป็นป้ายเขียนว่า โปรโมชั่น ตามด้วยข้อความ แนะนำเพื่อน สีขาว วางเหนือตัวเลข 0.8% ขนาดใหญ่สีทอง ด้านขวาเป็นผู้หญิงผมบลอนด์ในชุดเขียวทองชี้มาที่ตัวเลข ฉากหลังมีวงล้อรูเล็ตและไพ่ ด้านล่างเป็นป้ายสามอันพร้อมไอคอน เขียนว่า แนะนำเพื่อน รับโบนัสไม่อั้น กับ เพื่อนสมัคร รับโบนัสไปเลย และ รับโบนัสสูงสุด ไม่จำกัด"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#116330]/70 object-contain shadow-[0_10px_30px_rgba(3,17,10,0.72)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#0f9d47]/70 hover:shadow-[0_15px_40px_rgba(15,157,71,0.35)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่นคืนยอดเสีย 0.3% พื้นหลังเขียวมรกตเข้ม มีเหรียญทองและชิปคาสิโนกระจาย มุมซ้ายบนเป็นโลโก้ UVO88 ตัวอักษร UVO สีทองบนชิปเขียวคู่กับเลข 88 สีทอง ถัดมาเป็นป้ายเขียนว่า โปรโมชั่น ตามด้วยข้อความ คืนยอดเสีย สีขาว วางเหนือตัวเลข 0.3% ขนาดใหญ่สีทอง ด้านขวาเป็นผู้หญิงผมบลอนด์ในชุดเขียวทองชี้มาที่ตัวเลข ฉากหลังมีวงล้อรูเล็ตและไพ่ ด้านล่างเป็นป้ายสามอันพร้อมไอคอน เขียนว่า คืนยอดเสีย ทุกวัน กับ มั่นคง ปลอดภัย มาตรฐานระดับสากล และ ระบบออโต้ รวดเร็ว ทันใจ"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#116330]/70 object-contain shadow-[0_10px_30px_rgba(3,17,10,0.72)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#0f9d47]/70 hover:shadow-[0_15px_40px_rgba(15,157,71,0.35)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก UVO88"
          class="flex items-center justify-center rounded-lg border border-[#116330]/70 bg-gradient-to-r from-[#57dd8f] via-[#0f9d47] to-[#116330] px-10 py-3.5 text-lg font-black text-[#03110a] shadow-[0_0_15px_rgba(15,157,71,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก UVO88
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
