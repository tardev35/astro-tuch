---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

// ดรอปอาร์ตเวิร์กของ UWIN33 คือ 2026-09-24 และมีสไลด์ที่ใช้ได้สองใบเท่านั้น:
//   slide1.png — โปสเตอร์ "โปรโมชั่น แนะนำเพื่อน โบนัส 0.8%"
//   slide2.png — โปสเตอร์ "โปรโมชั่น คืนยอดเสีย โบนัส 0.3%"
// บทบาทของสองไฟล์นี้เคย "สลับกัน" ระหว่างแบรนด์มาแล้ว อย่าเชื่อชื่อตัวแปรที่ตกทอดมา
// รอบนี้เปิดไฟล์ดูจริงแล้วและยึดตามคำอธิบายอาร์ตเวิร์กใน brand-spec §5
//
// slide3.png (2026-09-18) และ slide4.png (2026-08-13) เก่ากว่าดรอปรอบนี้ เป็น
// อาร์ตเวิร์กของลูกค้าเจ้าก่อน — ห้าม import กลับมา และห้ามลบไฟล์ทิ้งเพราะเป็น
// อินเวนทอรี (ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้ว และ
// verify-build จะแดง) ถ้ามีสไลด์ใหม่เข้ามาให้เช็ก mtime เทียบดรอปก่อนเพิ่ม
// กริดรอบนี้จึงมีสองช่องเท่านั้น ห้ามเติมให้เต็มด้วยของเก่า
import promoReferral from "../assets/slide1.png";
import promoCashback from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";
//
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ: ContentBox title, ย่อหน้าเกริ่นสั้น ๆ หนึ่งย่อหน้า
// (ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมดของหน้านี้), กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม
// — ไม่มีหัวข้อย่อยและไม่มีย่อหน้าเพิ่ม เพราะตัวโปสเตอร์ระบุชื่อโปรและเปอร์เซ็นต์โบนัส
// ไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว เป้าหมาย h1x1, h2x0, h3x0
//
// สไลด์เป็นแบนเนอร์แนวนอน 600px จึงวางเป็นกริดสองคอลัมน์คุมความกว้างรวมที่ max-w-5xl
// (1024px) ทำให้ช่องละ ~488px ไม่ต้องอัปสเกลเกินขนาดไฟล์ต้นทาง widths หยุดที่ 600
// ตามความกว้างจริงของไฟล์ (candidate ที่ใหญ่กว่านั้นไม่มีของให้ครอป)
//
// Announcement รอบนี้หมุนมาใช้ AnnouncementPremium ทั้งเว็บ — default message ของ
// ไฟล์นั้นถูกตั้งเป็นคอปปี้ของ UWIN33 แล้ว และ index ก็เรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop
//
// พาเลตต์ UWIN33 (ทอง + โครเมียม + ดำ ตามโลโก้ที่ U กับ 33 เป็นทองสามมิติ ส่วน WIN
// เป็นเงินโครเมียม): พื้นเพจ #080602 · ผิวการ์ด #161106 · ผิวยก #26200e ·
// ทองแบรนด์ #e0b429 · ทองสว่าง #fbd564 · บรอนซ์ลึก #7a5407 · เงินโครเมียม #dfe4ec ·
// เนื้อความ #ece6d8 (BRAND_TEXT) · เน้นใน strong #fff8e6 — พาเลตต์แดง-เงินของ
// MAHAGAME66 (#de161d #ff4d52 #7a0a0e #e2e8ef #16090a #26100f #e8e3e1 #fff6f5
// #080506) ถูกแทนครบทุกจุดแล้ว ตัวอักษรบนพื้นทองต้องเป็นดำ #161106 ห้ามใช้ขาว
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 155
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "รวมโปรโมชั่น UWIN33 ทั้งโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% ดูรายละเอียดยอดที่เข้าเกณฑ์ รอบคำนวณ และเงื่อนไขของแต่ละรายการก่อนกดรับสิทธิ์ทุกครั้ง";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น UWIN33",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoReferral.src,
});
---

<MainLayout title="โปรโมชั่น UWIN33 แนะนำเพื่อน โบนัส 0.8% และคืนยอดเสีย โบนัส 0.3%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น UWIN33" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#ece6d8]">
        หน้านี้รวมภาพโปรโมชั่นที่ <strong class="text-[#fff8e6]">UWIN33</strong> เปิดให้สมาชิกกดรับตามรายการและช่วงเวลาที่กำหนด ทั้งโบนัสแนะนำเพื่อนและโบนัสคืนยอดเสีย โดยรายละเอียดของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว
        <strong class="text-[#fff8e6]">ยอดที่เข้าเกณฑ์ รอบคำนวณ และเงื่อนไขของแต่ละรายการแตกต่างกัน</strong> จึงควรตรวจสอบรายละเอียดล่าสุดจากหน้าเว็บไซต์อีกครั้งก่อนกดรับสิทธิ์ทุกครั้ง
      </p>

      <div class="mx-auto grid w-full max-w-5xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่นพื้นดำตกแต่งด้วยทอง มีชิปคาสิโนสีทองสลับดำวางซ้อนกันด้านล่างและไพ่โพดำเอซอยู่ริมซ้าย ด้านบนขวาเป็นโลโก้ UWIN33 ตัวอักษร U และ 33 สีทอง คำว่า WIN สีเงินโครเมียม ด้านซ้ายเป็นหญิงสาวในเสื้อสูทสีขาวคาดปกสีดำยืนกอดอก กลางภาพเป็นข้อความไทยสีทองว่า โปรโมชั่น แนะนำเพื่อน มีมงกุฎทองอยู่เหนือข้อความ และใต้ลงมาเป็นแผ่นป้ายทองข้อความว่า โบนัส 0.8%"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), 488px"
          class="mx-auto h-auto w-full rounded-xl border border-[#e0b429]/55 object-contain shadow-[0_10px_30px_rgba(8,6,2,0.80)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fbd564]/75 hover:shadow-[0_15px_40px_rgba(224,180,41,0.45)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่นพื้นดำตกแต่งด้วยทอง ชุดเดียวกับภาพแรก มีไพ่และชิปคาสิโนสีทองสลับดำวางซ้อนกันที่มุมล่างทั้งสองข้าง ด้านบนกลางภาพเป็นโลโก้ UWIN33 ตัวอักษร U และ 33 สีทอง คำว่า WIN สีเงินโครเมียม ด้านซ้ายเป็นหญิงสาวในชุดขาวสลับดำและด้านขวาเป็นชายหนุ่มสูทดำผูกเนกไท ทั้งคู่ชี้นิ้วเข้าหาข้อความกลางภาพซึ่งเป็นข้อความไทยสีทองว่า โปรโมชั่น คืนยอดเสีย และใต้ลงมาเป็นแผ่นป้ายทองข้อความว่า โบนัส 0.3%"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), 488px"
          class="mx-auto h-auto w-full rounded-xl border border-[#e0b429]/55 object-contain shadow-[0_10px_30px_rgba(8,6,2,0.80)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fbd564]/75 hover:shadow-[0_15px_40px_rgba(224,180,41,0.45)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก UWIN33"
          class="flex items-center justify-center rounded-lg border border-[#fbd564]/60 bg-gradient-to-r from-[#dfe4ec] via-[#fbd564] to-[#e0b429] px-10 py-3.5 text-lg font-black text-[#161106] shadow-[0_0_15px_rgba(224,180,41,0.50)] transition-transform hover:scale-105">
          สมัครสมาชิก UWIN33
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
