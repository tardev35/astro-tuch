---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

// ดรอปรอบนี้ (2026-10-24, brand-spec §6) มีสไลด์ที่ใช้ได้ **สองใบ** และชื่อ
// ตัวแปรตั้งตามข้อความที่พิมพ์อยู่บนภาพจริง (เปิดบิตแมปอ่านเองแล้วรอบนี้) ไม่ใช่ตาม
// เลขไฟล์ — ถ้ารอบหน้าเจอความขัดแย้ง **ให้เชื่อข้อความบนรูป**:
//   slide2.png (mtime 2026-10-24, ดรอปนี้) — โปสเตอร์ "โปรโมชั่น / คืนยอดเสีย / 0.3%"
//   slide1.png (mtime 2026-10-24, ดรอปนี้) — โปสเตอร์ "โปรโมชั่น / แนะนำเพื่อน / 0.8%"
//   slide3.png / slide4.png (mtime 2026-09-29 = คนละดรอป คนละแบรนด์) — **ห้าม import**
//   banner2.png / banner3.png (mtime 2026-10-23 = อาร์ตเวิร์กของอีกแบรนด์) —
//     **ห้าม import** รอบนี้ไม่มี "รูปประกอบบทความ" เลย
// ⚠️⚠️ **การจับคู่พลิกจากรอบก่อนแล้ว** — รอบก่อนคืนยอดเสียอยู่บน slide1 รอบนี้อยู่บน
// slide2 เพราะ uploader เขียนทับ slide1/slide2 ทุกครั้ง เลขไฟล์จึงไม่มีความหมาย
// ข้ามแบรนด์ **ต้องเปิดบิตแมปดูทุกรอบ ห้ามสืบทอดการจับคู่ของรอบก่อน**
// ⚠️ eager import = emit ลง dist/ ต่อให้ไม่ได้ render และ verify-build จะแดง
// การ import ไฟล์เก่าคือการส่งรูปของลูกค้ารายอื่นขึ้นเว็บนี้
// **ห้ามลบไฟล์เก่าทิ้ง** — เป็นอินเวนทอรีของรอบถัดไป แค่ห้าม import
// (banner1 / banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักชื่อไว้เอง —
// ห้ามอ้างจากหน้านี้) รอบนี้หน้านี้จึงมีเฉพาะสไลด์สองใบ
import promoCashback from "../assets/slide2.png";
import promoReferral from "../assets/slide1.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้นๆ ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมด
// ของหน้านี้, กริดภาพโปรโมชั่น, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อยและห้ามเพิ่มย่อหน้า
// เพราะโปสเตอร์ระบุชื่อรายการและเปอร์เซ็นต์ของตัวเองด้วยตัวอักษรขนาดใหญ่อยู่แล้ว
// การพิมพ์ซ้ำด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ บรีฟรอบนี้
// (src/assets/content.txt) ไม่มีส่วน SUB-PAGES เลย ย่อหน้าทุกย่อหน้าที่เคยอยู่บนหน้านี้
// จึงเป็นของที่รีแบรนด์รอบก่อนๆ แต่งขึ้นเอง — รอบนี้คงไว้เพียงย่อหน้าเกริ่นเดียว
// และเขียนขึ้นใหม่จากบรีฟ (content.txt บรรทัด 8)
//
// ลำดับในกริดตามลำดับของบรีฟ: คืนยอดเสีย 0.3% (หัวข้อ H3 บรรทัด 9 เนื้อ 10) มาก่อน
// แนะนำเพื่อน 0.8% (หัวข้อ H3 บรรทัด 11 เนื้อ 12) → promoCashback (slide2) อยู่ช่องแรก
// ⚠️⚠️ **บิตแมปจริงของดรอปนี้คือ 375x600 แนวตั้ง** (วัดจาก IHDR ของไฟล์เองรอบนี้)
// ความกว้างสูงสุดคือ 375 widths จึงหยุดที่ 375 และคุมที่ max-w-[375px]
// **ให้วัดใหม่ทุกรอบจากไฟล์จริง อย่าเชื่อสัดส่วนของรอบก่อน และห้ามขยายเกินต้นฉบับ**
// sizes คิดจากความกว้างที่ถูกวาดจริง: section px-4 (16px/ข้าง) + การ์ด p-8
// (32px/ข้าง, เป็น p-10 = 40px ที่ md ขึ้นไป) + gap-6 ระหว่างคอลัมน์ (24px)
//   ใต้ 640px = คอลัมน์เดียว → 100vw-96px
//   640-767px = สองคอลัมน์ p-8 → 50vw-60px
//   768-885px = สองคอลัมน์ p-10 → 50vw-68px
//   ตั้งแต่ 886px ขึ้นไปชนเพดาน 375px (การ์ดเองกว้างสุด 1400px จึงยังไม่ชน
//   เพดานของการ์ดก่อน)
// LCP คือ hero ใน MainLayout ไม่ใช่รูปพวกนี้ จึง loading="lazy" fetchpriority="low"
// decoding="async" และ quality ตัวเดียวทั้ง avif/webp — ห้ามจูนแยกฟอร์แมต
// (tools/avif-quality-service.mjs ย่อฝั่ง avif ให้เองที่ x0.65)
//
// quality={64} ไม่ใช่ 80 ตามปกติ: สไลด์ทั้งสองเป็นภาพถ่ายคนในฉากอิ่มสี บวกตัวอักษรไทย
// สามมิติผิวมันเงาที่มีไฮไลต์และขอบคมทับอยู่ด้านบน ซึ่งเป็นเคสที่ AVIF ทำได้แย่ที่สุด
// ที่ quality=80 ไฟล์ AVIF มีโอกาสออกมา **ใหญ่กว่า** WebP ที่เป็น fallback ของตัวเอง
// เบราว์เซอร์ที่รองรับ AVIF จะหยิบไฟล์ที่หนักกว่าไปใช้ และ verify-build.mjs ทำให้
// build แดงด้วยเหตุนี้ตรงๆ · ทางแก้คือ quality ที่ **ต่ำลง** ไม่ใช่สูงขึ้น ·
// ค่าเดียวกันนี้ต้องใช้ที่ index.astro กับสไลด์คู่เดียวกัน
//
// Announcement รอบนี้หมุนมาเป็น Announcement5 ทั้งเว็บ (brand-spec §3 — รอบก่อนใช้
// Announcement3 จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้น
// เป็นคอปปี้ของแบรนด์นี้ไว้แล้ว และทุกหน้าเรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop
// message มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกันระหว่างหน้า
//
// ───────────────────────────────────────────────────────────────────────────
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) **เนื้อหายังเป็นผิวสว่าง แต่โครมกลับทิศเป็นผิวเข้ม
// และฮิวคนละตระกูลสิ้นเชิงจากรอบก่อน**
// bg.json ของดรอปนี้คือ {"mode":"color","color":"#fef6fb"} = **ขาวอมชมพูจาง**
// (รอบก่อนเป็นชมพูบับเบิลกัมที่อิ่มกว่ามาก — อ่านจากไฟล์ทุกรอบ ห้ามเดา)
// **ห้าม "แก้" การ์ดกลับไปเป็นพื้นมืด** การ์ดมืดบนหมึก #3f130d = ตัวอักษรหายไปเลย
// ลำดับผิว: พื้นเพจ #fef6fb / การ์ด #ffffff (ContentBox) / ผิวยก #fff3ea /
// wash #fde4d3 · เส้น #f6c4a4 · เส้นเข้ม #e2855c (**ทั้งคู่ห้ามถือตัวอักษร**)
// หมึก #3f130d = เนื้อความ (= BRAND_TEXT ที่ <html> และการ์ด ContentBox ตั้งให้แล้ว
// 14.9:1 บนการ์ดขาว) · หมึกรอง #80453a (6.6:1)
// แดงลึก #a81410 = สีของ <strong> ในเนื้อความ (7.6:1 บนการ์ดขาว) และหัวข้อ
// 🚨🚨 **#de2b1e บนพื้นขาวได้แค่ 4.0:1 ห้ามเป็นสีตัวอักษร** และ **ขาวบน #de2b1e
// ได้ 4.7:1 ซึ่งเฉียดเกินไป** — พื้นแดงที่รับหมึกขาวได้ต้องเป็น #c81e12 (5.7:1) ลงไป
// ปุ่ม CTA ของหน้านี้เป็น **PRIMARY = ไล่เฉดแดงเม็กซิกันเข้ม** #c81e12 → #9d140c →
// #6f0e08 บนหมึก **ขาว #ffffff** (5.7 / 8.3 / 11.4:1 ต่อ stop) ตรงกับปุ่มสมัครสมาชิก
// ที่ /contact-us /ทางเข้า /register
// แผ่นไฮไลต์ด้านบนปุ่มจำกัดที่ white/10 (ผสมแล้ว stop บนยังผ่าน AA สำหรับตัวอักษร
// ขนาดใหญ่ของปุ่มนี้)
// rgba() ที่อนุญาตรอบนี้: rgba(222,43,30,α) · rgba(242,160,51,α) ·
// rgba(168,20,16,α) · rgba(63,19,13,α) · rgba(246,196,164,α) · rgba(254,215,181,α)
// ⚠️⚠️ **รอบนี้ไม่มีชมพู/แมเจนต้าเลยสักเฉด (เป็นฮิวของแบรนด์ขาออกทันที) ไม่มีฟ้า
// ไม่มีไซแอน ไม่มีน้ำเงิน ไม่มีม่วง ไม่มีเทาเงิน** (ชื่อและค่าอยู่ใน brand-spec §2)
// ⚠️⚠️ กับดักที่แหลมที่สุดรอบนี้คือ **แดงของแบรนด์อื่น** ซึ่งเป็นตระกูลเดียวกับรอบนี้
// (แบรนด์เก่าอย่างน้อยหกเจ้าเป็นแดง) ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน
// brand-spec §2 ห้ามตัดสินด้วยสายตา
// · ซอมเบรโรฟาง ปอนโชลายทอ กีตาร์ มาราคัส กระบองเพชร เหรียญทอง และสีผิวนักแสดงใน
// อาร์ตเวิร์กเป็น **วัตถุในภาพ ไม่ใช่สี UI** · และ **"SLOT" สีน้ำเงินไล่ฟ้าใน
// เวิร์ดมาร์กก็เป็นอาร์ตเวิร์ก ไม่ใช่สี UI** — ฟ้าคือฮิวของแบรนด์เมื่อสองรอบก่อน
// · <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ
// ถ้าเปิด/ปิดกลางคำ บรรทัดจะตัดกลางคำ
//
// ⚠️ แกนของแบรนด์รอบนี้คือ **สล็อตเมกซิกัน เดิมพันออนไลน์ เว็บแท้ที่นี่ที่เดียว**
// คำนิยามตัวเองของแบรนด์ก่อนๆ ห้ามเหลือ โดยเฉพาะศัพท์หมวดลอตเตอรีทั้งชุด
// (brand-spec §5 ไม่พิมพ์ซ้ำที่นี่) สองหน้าของหมวดนั้น **ปิดอยู่รอบนี้** (อยู่ใน
// src/pages-disabled/) หน้านี้จึงไม่มีอะไรให้ลิงก์ไป และโควตาปุ่มของหน้านี้คือ
// ปุ่มเดียวอยู่แล้ว
// 🚨 **บรีฟรอบนี้ไม่พูดถึงธนาคาร วอลเลท หรือการฝากถอนเลยแม้แต่คำเดียว** —
// ห้ามเขียนถึงที่นี่ (ค่าเต็มของคำต้องห้ามอยู่ใน brand-spec §5)
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 3 ขั้นตอน · 24ชม.
// **ไม่มีอัตราคืนรางวัลเป็นตัวเลข ไม่มีจำนวนเกม/ค่าย ไม่มียอดขั้นต่ำเป็นตัวเลข
// ไม่มีอัตราจ่าย ไม่มีเปอร์เซ็นต์เต็มจำนวน** ห้ามแต่งตัวเลขการเงิน ชื่อธนาคาร
// เลขใบอนุญาต ปีก่อตั้ง หรือจำนวนสมาชิก และต้องคงประโยคกำกับของบรีฟไว้ว่า
// **แต่ละรายการอาจกำหนดประเภทเกม ยอดที่นำมาคำนวณ และเงื่อนไขการถอนเงินแตกต่างกัน
// จึงควรตรวจสอบประกาศล่าสุดก่อนเข้าร่วมทุกครั้ง** (content.txt บรรทัด 8)
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงนี้ยาว 154 ด้วยชื่อแบรนด์ 12 อักขระของรอบนี้
// (รอบก่อนชื่อยาว 7 → ต้องนับใหม่ทุกรอบ ห้ามสืบทอดความยาวข้ามแบรนด์)
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `รวมภาพโปรโมชั่น ${BRAND_NAME} ไว้ในหน้าเดียว ทั้งคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% แต่ละรายการมีเงื่อนไขต่างกัน จึงควรตรวจสอบจากประกาศล่าสุดก่อนรับสิทธิ์`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่น ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});

// ความกว้างที่ถูกวาดจริงของแต่ละคอลัมน์ในกริดสองคอลัมน์ (ดูคอมเมนต์ sizes ด้านบน)
const promoSizes = "(max-width: 639px) calc(100vw - 96px), (max-width: 767px) calc(50vw - 60px), (max-width: 885px) calc(50vw - 68px), 375px";

const promoClass =
  "mx-auto h-auto w-full max-w-[375px] rounded-xl border border-[#f6c4a4] object-contain shadow-[0_8px_28px_rgba(168,20,16,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#de2b1e] hover:shadow-[0_12px_40px_rgba(222,43,30,0.3)]";

// alt ทั้งสองเขียนจากบิตแมปของดรอปนี้ที่เปิดอ่านเองแล้ว (**375x600 แนวตั้ง** ทั้งคู่) —
// ฉากเม็กซิกัน กระบองเพชรเขียว ผ้าซาราเป้ลายทางแดง-เขียว · ตัวอักษรไทยสามมิติ
// เขียว-แดงว่า โปรโมชั่น พร้อมซอมเบรโรจิ๋ว · ชื่อรายการตัวแดงตัดขอบขาว ·
// ตัวเลขเปอร์เซ็นต์ตัวโตสีแดงเข้ม · แคปซูลแดงขอบทองท้ายภาพเขียนว่า แจกโบนัสทั้งวัน ·
// เหรียญทองโปรยรอบตัวอักษร
// ⚠️ alt คือ "ข้อความที่พิมพ์อยู่บนโปสเตอร์" เป็นหลัก — ตัวเลขท้าย alt ต้องตรงกับรูป
// ⚠️ ห้ามเรียกรูปคู่นี้ว่าภาพแนวนอนหรือภาพสี่เหลี่ยมจัตุรัส รอบนี้เป็น **แนวตั้ง**
// ⚠️ จุดที่ **ต่างกันจริงระหว่างสองใบ** และต้องเขียนให้ตรง (ตรวจจากบิตแมปรอบนี้):
//   slide2 (คืนยอดเสีย 0.3%) **ผู้หญิง** สวมซอมเบรโรฟางขอบปักลาย ติดดอกไม้แดงที่หู
//     ใส่เสื้อคอกว้างปักลายดอกไม้ · **โลโก้อยู่มุมบนซ้าย** · ฉากหลังเป็นกระบองเพชร
//     และผ้าซาราเป้ · ท้ายแคปซูลขนาบด้วย **ซอมเบรโรเล็ก**
//   slide1 (แนะนำเพื่อน 0.8%) **ผู้ชายไว้หนวด** สวมซอมเบรโรฟางขอบลายปักแดง-เขียว
//     และ **ปอนโชลายทอแดง-ขาว-เขียว** แก้มทาธงชาติ · **โลโก้อยู่มุมบนขวา** ·
//     ฉากหลังเป็นกำแพงอะโดบีครีมและธงชาติเม็กซิโก · มี **มาราคัส** ประดับ ·
//     ท้ายแคปซูลขนาบด้วย **พริกแดง**
// ⚠️ ห้ามระบุว่าถือด้วยมือซ้ายหรือมือขวา — รอบก่อนๆ เขียนไว้แล้วผิดหลายรอบติด
// ⚠️ สีของวัตถุในรูป (เหรียญทอง ซอมเบรโรฟาง ปอนโช กระบองเพชร) เป็นวัตถุในภาพ
// ไม่ใช่สีของแบรนด์ และไม่เข้ามาใน UI
// ⚠️ องค์ประกอบของอาร์ตเวิร์กแบรนด์ก่อนๆ ที่ต้องไม่หลงเหลือใน alt อยู่ครบใน
// brand-spec §6 (ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive)
const altCashback = `โปสเตอร์โปรโมชั่นแนวตั้ง มุมบนซ้ายเป็นโลโก้ ${BRAND_NAME} รูปชายการ์ตูนไว้หนวดสวมซอมเบรโรยกนิ้วโป้งคู่กับเวิร์ดมาร์กสามมิติตัดขอบขาว ฉากหลังเป็นกระบองเพชรเขียวและผ้าซาราเป้ลายทางแดง-เขียว กลางภาพเป็นผู้หญิงผมยาวสลวย สวมซอมเบรโรฟางขอบปักลาย ติดดอกไม้แดงที่หู ใส่เสื้อคอกว้างปักลายดอกไม้ ยิ้มกว้างพร้อมยกโทรศัพท์ขึ้นดูและกำหมัดดีใจ ครึ่งล่างเป็นตัวอักษรไทยสามมิติเขียว-แดงอ่านว่า โปรโมชั่น มีซอมเบรโรจิ๋วเกาะอยู่ ใต้ลงมาเป็นคำว่า คืนยอดเสีย ตัวแดงตัดขอบขาว และตัวเลข 0.3% ตัวโตสีแดงเข้ม ปิดท้ายด้วยแคปซูลแดงขอบทองเขียนว่า แจกโบนัสทั้งวัน ขนาบด้วยซอมเบรโรเล็ก มีเหรียญทองโปรยอยู่รอบตัวอักษร`;

const altReferral = `โปสเตอร์โปรโมชั่นแนวตั้ง มุมบนขวาเป็นโลโก้ ${BRAND_NAME} รูปชายการ์ตูนไว้หนวดสวมซอมเบรโรยกนิ้วโป้งคู่กับเวิร์ดมาร์กสามมิติตัดขอบขาว ฉากหลังเป็นกำแพงอะโดบีครีม กระบองเพชรเขียว และธงชาติเม็กซิโก กลางภาพเป็นผู้ชายไว้หนวด สวมซอมเบรโรฟางขอบลายปักแดง-เขียว และปอนโชลายทอแดง-ขาว-เขียว แก้มทาธงชาติ หัวเราะพร้อมยกโทรศัพท์ขึ้นดูและกำหมัดชูขึ้น ครึ่งล่างเป็นตัวอักษรไทยสามมิติเขียว-แดงอ่านว่า โปรโมชั่น มีซอมเบรโรจิ๋วเกาะอยู่ ใต้ลงมาเป็นคำว่า แนะนำเพื่อน ตัวแดงตัดขอบขาว และตัวเลข 0.8% ตัวโตสีแดงเข้ม ปิดท้ายด้วยแคปซูลแดงขอบทองเขียนว่า แจกโบนัสทั้งวัน ขนาบด้วยพริกแดง มีมาราคัสและเหรียญทองประดับอยู่สองข้าง`;
---

<MainLayout title={`โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`รวมโปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} as="h1">
    <div class="flex flex-col gap-10">
      <p>
        หน้านี้รวมภาพโปรโมชั่นของ {BRAND_NAME} ไว้ในที่เดียว ทั้ง
        <strong class="text-[#a81410]">คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%</strong>
        โดยชื่อรายการและอัตราระบุอยู่บนภาพแล้ว
        <strong class="text-[#a81410]">แต่ละรายการอาจกำหนดประเภทเกม ยอดที่นำมาคำนวณ และเงื่อนไขการถอนเงินแตกต่างกัน จึงควรตรวจสอบประกาศล่าสุดก่อนเข้าร่วมทุกครั้ง</strong>
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt={altCashback}
          loading="lazy"
          fetchpriority="low"
          widths={[250, 375]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />

        <Picture
          src={promoReferral}
          alt={altReferral}
          loading="lazy"
          fetchpriority="low"
          widths={[250, 375]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="relative isolate flex items-center justify-center overflow-hidden rounded-lg border border-[#6f0e08] bg-gradient-to-b from-[#c81e12] via-[#9d140c] to-[#6f0e08] px-10 py-3.5 text-lg font-black text-white shadow-[0_8px_22px_rgba(168,20,16,0.35)] transition-transform hover:scale-105">
          <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-white/10 to-transparent"></span>
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
