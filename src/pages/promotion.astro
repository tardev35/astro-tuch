---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

// เฉพาะ slide1/slide2 (ลงวันที่ 2026-09-01) เท่านั้นที่เป็นอาร์ตเวิร์กของ SUPERMAX168
// รอบนี้ slide1 คือโปสเตอร์ "แนะนำเพื่อน 0.8%" ส่วน slide2 คือ "คืนยอดเสีย 0.3%"
// (อ่านจากตัวภาพจริง ไม่ใช่จากชื่อไฟล์ — อย่าเชื่อชื่อตัวแปรที่รอบก่อนตั้งไว้
// ให้เปิดรูปดูทุกครั้งที่เปลี่ยนแบรนด์)
// slide3/slide4 ยังค้างอยู่บนดิสก์แต่เป็นอาร์ตเวิร์กหวยของลูกค้าเจ้าก่อนหน้า — ห้าม import ที่นี่
// ทั้งรอบนี้และรอบถัดไป (ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้ว)
import promoReferral from "../assets/slide1.png";
import promoCashback from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็น IMAGE page: ContentBox title, ย่อหน้าเกริ่นสั้น ๆ หนึ่งย่อหน้า, กริดโปสเตอร์,
// ปุ่ม CTA หนึ่งปุ่ม — ไม่มีหัวข้อย่อยและไม่มีย่อหน้าเพิ่ม เพราะตัวโปสเตอร์ระบุเงื่อนไข
// ของแต่ละโปรโมชั่นไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 152
const pageDescription =
  "รวมโปรโมชั่นของ SUPERMAX168 ทั้งแนะนำเพื่อนรับ 0.8% และคืนยอดเสีย 0.3% ดูเปอร์เซ็นต์ ยอดที่นำมาคำนวณ และรอบรับสิทธิ์ได้จากภาพโปรโมชั่นในหน้านี้ก่อนกดรับ";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น SUPERMAX168 แนะนำเพื่อน 0.8% คืนยอดเสีย 0.3%",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoReferral.src,
});
---

<MainLayout title="โปรโมชั่น SUPERMAX168 แนะนำเพื่อนรับ 0.8% และคืนยอดเสียรับ 0.3%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น SUPERMAX168" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#f3e6c8]">
        หน้านี้รวมโปรโมชั่นที่ SUPERMAX168 เปิดให้สมาชิกตรวจสอบสิทธิ์และกดรับผ่านบัญชีของตนเอง ทั้งแนะนำเพื่อนรับ
        <strong class="text-[#ecc964]">0.8%</strong> และคืนยอดเสีย <strong class="text-[#ecc964]">0.3%</strong>
        โดยเปอร์เซ็นต์ ยอดที่นำมาคำนวณ และรอบเวลารับสิทธิ์ระบุไว้บนภาพโปรโมชั่นแต่ละใบ
        แต่ละรายการมีเงื่อนไขต่างกัน จึงควรอ่านรายละเอียดล่าสุดหรือสอบถามแอดมินก่อนกดรับทุกครั้ง
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อนของ SUPERMAX168 พื้นหลังคาสิโนโทนดำทอง ด้านบนกลางภาพเป็นโลโก้ SUPERMAX168 คำว่า SUPER สีทองและ MAX สีเงิน ใต้ลงมาเป็นชิปคาสิโนสีทองมีโพดำและเลข 168 ถัดลงมาเป็นป้ายสีดำเขียนว่า โปรโมชั่น ตามด้วยข้อความ แนะนำเพื่อน สีทอง วางเหนือตัวเลข 0.8% ขนาดใหญ่สีขาวขอบทอง ด้านซ้ายเป็นไพ่เอซสามใบ กล่องของขวัญผูกโบว์ทอง และกองเหรียญทอง ด้านขวาเป็นผู้หญิงผมรวบสวมชุดดำคาดทองยกมือชี้มาที่ตัวเลข ถัดไปเป็นวงล้อรูเล็ตและตู้สล็อตแสดงเลข 777 ด้านล่างเป็นป้ายสามอันเขียนว่า ชวนเพื่อนง่าย รับโบนัสทันที รับโบนัสจากยอดเพื่อนเล่น และ มั่นคง ปลอดภัย เชื่อถือได้ 100%"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#ba8219]/70 object-contain shadow-[0_10px_30px_rgba(3,2,1,0.72)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ecc964]/70 hover:shadow-[0_15px_40px_rgba(236,201,100,0.35)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่นคืนยอดเสียของ SUPERMAX168 พื้นหลังคาสิโนโทนดำทอง ด้านบนกลางภาพเป็นโลโก้ SUPERMAX168 คำว่า SUPER สีทองและ MAX สีเงิน ใต้ลงมาเป็นชิปคาสิโนสีทองมีโพดำและเลข 168 ถัดลงมาเป็นป้ายสีดำเขียนว่า โปรโมชั่น ตามด้วยข้อความ คืนยอดเสีย สีทอง วางเหนือตัวเลข 0.3% ขนาดใหญ่สีขาวขอบทอง ด้านซ้ายเป็นไพ่เอซ กล่องของขวัญผูกโบว์ทอง และกองเหรียญทองพร้อมชิปคาสิโน ด้านขวาเป็นผู้หญิงผมรวบสวมชุดดำคาดทองยกมือชี้มาที่ตัวเลข ถัดไปเป็นวงล้อรูเล็ตและตู้สล็อตแสดงเลข 777 ด้านล่างเป็นป้ายสามอันเขียนว่า คืนยอดเสียทุกวัน กดรับได้เอง มั่นคง ปลอดภัย เชื่อถือได้ 100% และ รองรับวอลเลททุกธนาคาร"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#ba8219]/70 object-contain shadow-[0_10px_30px_rgba(3,2,1,0.72)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ecc964]/70 hover:shadow-[0_15px_40px_rgba(236,201,100,0.35)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก SUPERMAX168"
          class="flex items-center justify-center rounded-lg border border-[#ba8219]/70 bg-gradient-to-r from-[#f9e38b] via-[#ecc964] to-[#ba8219] px-10 py-3.5 text-lg font-black text-[#030201] shadow-[0_0_15px_rgba(236,201,100,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก SUPERMAX168
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
