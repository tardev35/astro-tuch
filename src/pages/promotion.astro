---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

// ดรอปอาร์ตเวิร์กของ หวยเต็ง คือ 2026-10-01 00:33 และมีโปสเตอร์ที่ใช้ได้แค่สองใบ
// (brand-spec §4) — เปิดไฟล์จริงดูแล้วทั้งคู่:
//   slide1.png — 600x600 พื้นเขียวป่า ป้ายใต้หัวเรื่องอ่านว่า "2ตัวจ่าย100บาท"
//                หญิงสาวถือลูกหวยเขียวเลข 6
//   slide2.png — 600x600 ชุดเดียวกัน ป้ายอ่านว่า "3ตัวจ่าย1,000บาท"
//                หญิงสาวถือลูกหวยเขียวเลข 3
//   slide3.png / slide4.png — โปสเตอร์ของแบรนด์ก่อน (29 ก.ย. เก่ากว่าดรอปนี้)
//     ห้าม import กลับมาเด็ดขาด และห้ามลบไฟล์ทิ้งเพราะเป็นอินเวนทอรีของรอบถัดไป
// ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้วและ verify-build จะแดง
// (banner2/banner3 ใน src/assets ก็เก่ากว่าดรอปนี้ = อาร์ตเวิร์กแบรนด์ก่อน ห้าม import)
import promoTwoDigit from "../assets/slide1.png";
import promoThreeDigit from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";
//
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ: ContentBox title, ย่อหน้าเกริ่นสั้น ๆ หนึ่งย่อหน้า
// (ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมดของหน้านี้), กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม
// — ไม่มีหัวข้อย่อยและไม่มีย่อหน้าเพิ่ม เพราะตัวโปสเตอร์ระบุอัตราจ่ายไว้ด้วยตัวอักษร
// ขนาดใหญ่อยู่แล้ว เป้าหมาย h1x1, h2x0, h3x0
//
// สไลด์รอบนี้เป็นจัตุรัส 600x600 จึงวางเป็นกริดสองคอลัมน์คุมความกว้างรวมที่ max-w-4xl
// (896px) ทำให้ช่องละ ~436px ไม่ต้องอัปสเกลเกินขนาดไฟล์ต้นทาง widths หยุดที่ 600 ตาม
// ความกว้างจริงของไฟล์ และคุมภาพต่อใบไว้ที่ max-w-[600px] สองใบพอดีหนึ่งแถว กริดจึง
// จัดกลางสมมาตรโดยไม่ต้องมีใบที่ span สองคอลัมน์ · เรียง 2 ตัว ก่อน 3 ตัว ตามบรีฟ
//
// Announcement หมุนมาเป็น Announcement3 ทั้งเว็บรอบนี้ (รอบก่อนเป็น AnnouncementPremium)
// — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ หวยเต็ง แล้ว และ index
// ก็เรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop message มิฉะนั้นตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ หวยเต็ง (เขียวป่า + ทอง ตามโลโก้ที่คำว่า "หวย" เป็นเขียวมรกตขอบทอง และ
// "เต็ง" เป็นทองตัน บนแบนเนอร์ฉากคืนสีเขียวป่าที่มีริ้วแสงทอง เหรียญทอง ลูกหวยทอง
// และเงาวัดสีทอง): พื้นเพจ #03150a · การ์ด #062a12 · ผิวยก #0b3d18 ·
// เส้น/ขอบ #024a0f · เขียวแบรนด์ #026314 · เขียวสว่าง #0bb42f · ทองหลัก #e5c04f ·
// ทองอ่อน #fae474 · ทองเข้ม #bd8d2d · เนื้อความ #d8ead9 (BRAND_TEXT) ·
// หมึกบนพื้นทอง #0a1a0c
// เรืองแสง: ทอง rgba(229,192,79,0.30) · เขียว rgba(2,99,20,0.35)
// การ์ดโปสเตอร์ได้ขอบทองทั้งสองใบเพราะตัวเลขอัตราจ่ายบนภาพทั้งคู่เป็นตัวอักษรทอง
// ปุ่ม CTA เป็นไล่เฉดทอง #fae474 → #e5c04f → #bd8d2d และใช้หมึกเข้ม #0a1a0c
// (ขาวบนทอง #e5c04f ได้แค่ ~1.8:1 ตก AA จึงต้องใช้หมึกเข้ม)
// ชุดน้ำเงินรอยัล-ทองของ BRAVO168 (#02081a #04142f #072247 #0e3f8f #1558c4 #2f86f0
// #f4cb69 #ffe39a #c9922e #dbe5f5 #0a1020 rgba(244,203,105,*) rgba(21,88,196,*)
// rgba(2,8,26,*)) ถูกแทนครบทุกจุดแล้ว ทั้งคลาส Tailwind raw hex และ rgba()
//
// หวยเต็ง เป็นเว็บ "แทงหวยออนไลน์" ไม่ใช่บอลและไม่ใช่สล็อต — คำว่า บอล ฟุตบอล
// บอลเดี่ยว บอลสเต็ป บอลสด ค่าน้ำ อัตราต่อรอง ลีก คู่แข่งขัน แมตช์ บิล แฮนดิแคป
// สล็อต ฟรีสปิน แจ็กพอต บาคาร่า รูเล็ต คาสิโน ห้ามปรากฏบนหน้านี้ ตัวเลขที่บรีฟระบุ
// และใช้ได้มีแค่ 2 ตัว จ่าย 100 บาท · 3 ตัว จ่าย 1,000 บาท · 3 ขั้นตอน · 24 ชั่วโมง
// ห้ามเพิ่มชื่อผู้ให้บริการ ชื่อธนาคาร ยอดฝากขั้นต่ำ เลขใบอนุญาต จำนวนสมาชิก หรือ
// ปีที่ก่อตั้ง และต้องคง hedge ของบรีฟไว้ว่าอัตราจ่ายขึ้นอยู่กับประเภทหวยและรูปแบบ
// การเดิมพันที่ร่วมเงื่อนไข จึงควรตรวจสอบอัตราที่แสดงในหน้าส่งโพยก่อนยืนยัน
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 156
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "รวมภาพอัตราจ่ายหวยของ หวยเต็ง ทั้งแบบ 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท ควรตรวจสอบประเภทหวย รูปแบบการเดิมพัน และอัตราที่แสดงในหน้าส่งโพยก่อนยืนยัน";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่นอัตราจ่ายหวย หวยเต็ง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoTwoDigit.src,
});
---

<MainLayout title="โปรโมชั่นอัตราจ่ายหวย หวยเต็ง 2 ตัว จ่าย 100 บาท 3 ตัว จ่าย 1,000 บาท" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่นอัตราจ่ายหวย หวยเต็ง" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#d8ead9]">
        หน้านี้รวมภาพอัตราจ่ายที่ <strong class="text-[#fae474]">หวยเต็ง</strong> เปิดให้สมาชิกดูรายละเอียดก่อนเลือกรายการและส่งโพย โดยตัวเลขของแต่ละแบบระบุไว้บนภาพด้านล่างแล้ว
        <strong class="text-[#fae474]">อัตราจ่ายขึ้นอยู่กับประเภทหวยและรูปแบบการเดิมพันที่ร่วมเงื่อนไข</strong> จึงควรตรวจสอบอัตราที่แสดงในหน้าส่งโพยของแต่ละรอบก่อนยืนยันทุกครั้ง
      </p>

      <div class="mx-auto grid w-full max-w-4xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoTwoDigit}
          alt="โปสเตอร์อัตราจ่ายหวยของ หวยเต็ง พื้นสีเขียวป่า มีเหรียญทองกองซ้อน ลูกหวยสีทองและสีขาว และสลากหวยไทยกระจายอยู่รอบภาพ ด้านซ้ายเป็นหญิงสาวผมยาวสวมชุดสีขาวถือลูกหวยสีเขียวหมายเลข 6 ด้านบนเป็นโลโก้ตัวอักษรไทยคำว่า หวย สีเขียวมรกตคู่กับคำว่า เต็ง สีทอง ถัดลงมาเป็นตัวอักษรไทยสีทองขนาดใหญ่ว่า อัตราจ่ายหวย ใต้ลงไปเป็นป้ายเขียว-ทองข้อความว่า 2ตัวจ่าย100บาท"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), (max-width: 1007px) calc((100vw - 136px) / 2), 436px"
          class="mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#e5c04f]/60 object-contain shadow-[0_10px_30px_rgba(3,21,10,0.85)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fae474]/85 hover:shadow-[0_15px_40px_rgba(229,192,79,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoThreeDigit}
          alt="โปสเตอร์อัตราจ่ายหวยของ หวยเต็ง ชุดเดียวกัน พื้นสีเขียวป่า มีเหรียญทอง ลูกหวยสีทองและสีขาว และสลากหวยไทยวางซ้อนกัน ด้านซ้ายเป็นหญิงสาวผมยาวสวมชุดสีขาวถือลูกหวยสีเขียวหมายเลข 3 ด้านบนเป็นโลโก้ตัวอักษรไทยคำว่า หวย สีเขียวมรกตคู่กับคำว่า เต็ง สีทอง ถัดลงมาเป็นตัวอักษรไทยสีทองขนาดใหญ่ว่า อัตราจ่ายหวย ใต้ลงไปเป็นป้ายเขียว-ทองข้อความว่า 3ตัวจ่าย1,000บาท"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), (max-width: 1007px) calc((100vw - 136px) / 2), 436px"
          class="mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#e5c04f]/60 object-contain shadow-[0_10px_30px_rgba(3,21,10,0.85)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fae474]/85 hover:shadow-[0_15px_40px_rgba(229,192,79,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก หวยเต็ง"
          class="flex items-center justify-center rounded-lg border border-[#e5c04f]/70 bg-gradient-to-r from-[#fae474] via-[#e5c04f] to-[#bd8d2d] px-10 py-3.5 text-lg font-black text-[#0a1a0c] shadow-[0_0_15px_rgba(229,192,79,0.30)] transition-transform hover:scale-105">
          สมัครสมาชิก หวยเต็ง
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
