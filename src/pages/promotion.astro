---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

// เฉพาะ slide1/slide2 (ลงวันที่ 2026-08-26) เท่านั้นที่เป็นอาร์ตเวิร์กของ OSAKA198
// slide1 คือโปสเตอร์ "แนะนำเพื่อน 0.8%" ส่วน slide2 คือ "คืนยอดเสีย 0.3%" (อ่านจากตัวภาพ)
// บทบาทของแต่ละสไลด์สลับได้ในแต่ละแบรนด์ อย่าเชื่อชื่อตัวแปรเดิม
// ให้เปิดรูปดูทุกครั้งที่เปลี่ยนแบรนด์ — รอบนี้สลับจากรอบก่อนจริง
// slide3/slide4 ยังค้างอยู่บนดิสก์แต่เป็นอาร์ตเวิร์กของลูกค้าก่อนหน้า — ห้าม import ที่นี่
// ทั้งรอบนี้และรอบถัดไป (ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้ว)
import promoReferral from "../assets/slide1.png";
import promoCashback from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็น IMAGE page: ContentBox title, ย่อหน้าเกริ่นสั้น ๆ หนึ่งย่อหน้า, กริดโปสเตอร์,
// ปุ่ม CTA หนึ่งปุ่ม — ไม่มีหัวข้อย่อยและไม่มีย่อหน้าเพิ่ม เพราะตัวโปสเตอร์ระบุเงื่อนไข
// ของแต่ละโปรโมชั่นไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 157
const pageDescription =
  "รวมโปรโมชั่นของ OSAKA198 ทั้งแนะนำเพื่อนรับ 0.8% และคืนยอดเสีย 0.3% ดูเปอร์เซ็นต์ ยอดที่นำมาคำนวณ และรอบรับสิทธิ์ได้จากภาพโปรโมชั่นในหน้านี้ก่อนกดรับทุกครั้ง";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น OSAKA198 แนะนำเพื่อน 0.8% คืนยอดเสีย 0.3%",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoReferral.src,
});
---

<MainLayout title="โปรโมชั่น OSAKA198 แนะนำเพื่อนรับ 0.8% และคืนยอดเสียรับ 0.3%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น OSAKA198" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#e8ddc8]">
        หน้านี้รวมโปรโมชั่นที่ OSAKA198 เปิดให้สมาชิกตรวจสอบสิทธิ์และกดรับผ่านบัญชีของตนเอง ทั้งแนะนำเพื่อนรับ
        <strong class="text-[#e4cc95]">0.8%</strong> และคืนยอดเสีย <strong class="text-[#e4cc95]">0.3%</strong>
        โดยเปอร์เซ็นต์ ยอดที่นำมาคำนวณ และรอบเวลารับสิทธิ์ระบุไว้บนภาพโปรโมชั่นแต่ละใบ
        แต่ละรายการมีเงื่อนไขต่างกัน จึงควรอ่านรายละเอียดล่าสุดหรือสอบถามแอดมินก่อนกดรับทุกครั้ง
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อนของ OSAKA198 พื้นหลังสีดำเงาลายทองมีเหรียญทองปลิวอยู่รอบภาพ โลโก้ OSAKA198 อยู่กลางด้านบน ถัดลงมาเป็นป้ายทองคำว่า โปรโมชั่น เหนือคำว่า แนะนำเพื่อน และตัวเลข 0.8% สีทองเมทัลลิกขนาดใหญ่ ผู้หญิงในชุดราตรีสีทองยืนชี้นิ้วมาที่ตัวเลข ด้านซ้ายมีกล่องของขวัญผูกโบว์และกองเหรียญทอง ด้านขวามีวงล้อรูเล็ต ด้านล่างเรียงป้ายทรงแคปซูลสามป้ายว่า ชวนเพื่อนง่าย รับโบนัสทันที รับโบนัส จากยอดเพื่อนเล่น และ มั่นคง ปลอดภัย เชื่อถือได้ 100%"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#a37c4b]/70 object-contain shadow-[0_10px_30px_rgba(11,9,6,0.72)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#c7b895]/70 hover:shadow-[0_15px_40px_rgba(199,184,149,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่นคืนยอดเสียของ OSAKA198 พื้นหลังสีดำเงาลายทองมีเหรียญทองปลิวอยู่รอบภาพ โลโก้ OSAKA198 อยู่กลางด้านบน ถัดลงมาเป็นป้ายทองคำว่า โปรโมชั่น เหนือคำว่า คืนยอดเสีย และตัวเลข 0.3% สีทองเมทัลลิกขนาดใหญ่ ผู้หญิงในชุดราตรีสีทองยืนชี้นิ้วมาที่ตัวเลข ด้านซ้ายมีกล่องของขวัญผูกโบว์และกองเหรียญทอง ด้านขวามีตู้สล็อตที่หน้าจอขึ้นเลข 777 ด้านล่างเรียงป้ายทรงแคปซูลสามป้ายว่า คืนยอดเสียทุกวัน กดรับได้เอง มั่นคง ปลอดภัย เชื่อถือได้ 100% และ สิทธิพิเศษมากมาย สำหรับสมาชิก"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#a37c4b]/70 object-contain shadow-[0_10px_30px_rgba(11,9,6,0.72)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#c7b895]/70 hover:shadow-[0_15px_40px_rgba(199,184,149,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก OSAKA198"
          class="flex items-center justify-center rounded-lg border border-[#c7b895]/70 bg-gradient-to-r from-[#f7f1e4] via-[#c7b895] to-[#9a8a68] px-10 py-3.5 text-lg font-black text-[#0b0906] shadow-[0_0_15px_rgba(199,184,149,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก OSAKA198
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
