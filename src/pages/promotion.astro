---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

// Only slide1/slide2 belong to ขวัญใจ168, and they are exactly the two
// promotions this page shows: slide1 is the "คืนยอดเสีย 0.3%" poster, slide2
// is the "แนะนำเพื่อน 0.8%" poster (checked against the artwork, not the
// filename — the pairing is inverted from the previous brand's). slide3/slide4
// are still on disk but belong to previous clients — they may not be imported
// here, now or on any future rebrand (an unrendered import is still emitted
// into dist/).
import promoCashback from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";

// This is an IMAGE page: the ContentBox title, ONE short intro paragraph, the
// poster grid, one CTA. No section headings, no extra prose — the posters
// already state every offer in large type.
//
// 150–160 CHARACTERS (not bytes — a byte count reads ~3x too long for Thai).
const pageDescription =
  "รวมโปรโมชั่น ขวัญใจ168 ทางเข้าสำรอง ทั้งคืนยอดเสีย 0.3% ทุกวัน และแนะนำเพื่อนรับคอมมิชชั่น 0.8% ดูเปอร์เซ็นต์ ยอดที่คำนวณ และเงื่อนไขการรับสิทธิ์ได้จากหน้านี้";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น ขวัญใจ168 คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8%",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});
---

<MainLayout title="โปรโมชั่น ขวัญใจ168 คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น ขวัญใจ168" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#cfe7f2]">
        หน้านี้รวมโปรโมชั่นที่ ขวัญใจ168 เปิดให้สมาชิกตรวจสอบสิทธิ์ผ่านบัญชีผู้ใช้งาน ทั้งโบนัสคืนยอดเสีย <strong class="text-[#ffd76a]">0.3%</strong>
        ตามรอบประจำวัน และคอมมิชชั่นแนะนำเพื่อน <strong class="text-[#ffd76a]">0.8%</strong> ตามเงื่อนไข เปอร์เซ็นต์โบนัส ยอดที่นำมาคำนวณ
        และรอบเวลาการรับสิทธิ์ระบุไว้บนภาพโปรโมชั่นแต่ละใบ แต่ละรายการมีวิธีคำนวณและข้อกำหนดการถอนต่างกัน จึงควรอ่านรายละเอียดล่าสุดหรือสอบถามแอดมินผ่าน LINE Official ก่อนกดรับทุกครั้ง
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt="โปสเตอร์จัตุรัสพื้นหลังคาสิโนใต้น้ำแสงนีออนฟ้า มุมบนซ้ายเป็นโลโก้ ขวัญใจ168 มุมบนขวาเป็นตู้สล็อตติดป้าย JACKPOT 168,000,000 กลางภาพเขียนว่า โปรโมชั่น คืนยอดเสีย 0.3% ด้วยตัวเลขใหญ่สีขาวฟ้า ด้านขวาเป็นผู้หญิงชุดว่ายน้ำลายฟ้าขาวยืนแบมือ ด้านล่างเป็นการ์ตูนครอบครัวชายทะเล ปู กุ้ง หอย ลูกเต๋า ไพ่เอซ ชิป 168 และแถบไอคอนสี่ช่อง มั่นคงปลอดภัย 100% จ่ายจริงไม่อั้นสูงสุด ระบบออโต้รวดเร็วทันใจ และบริการดีตลอด 24 ชม."
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#0e4f7a]/70 object-contain shadow-[0_10px_30px_rgba(22,135,201,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#4bdbee]/70 hover:shadow-[0_15px_40px_rgba(75,219,238,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoReferral}
          alt="โปสเตอร์จัตุรัสพื้นหลังรีสอร์ทริมทะเลกลางคืนแสงนีออนฟ้า มุมบนซ้ายเป็นโลโก้ ขวัญใจ168 กลางภาพเขียนว่า โปรโมชั่น แนะนำเพื่อน 0.8% ด้วยตัวเลขใหญ่สีขาวฟ้า ด้านขวาเป็นผู้หญิงห่มผ้าลายฟ้าขาวยืนแบมือ ด้านล่างเป็นการ์ตูนครอบครัวชายทะเล ปู หอย ลูกเต๋า ไพ่เอซ และแถบเขียนว่า สล็อต ครบจบในที่เดียว พร้อมไอคอน มั่นคง ฝาก-ถอนรวดเร็ว และโบนัสจัดเต็ม"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#0e4f7a]/70 object-contain shadow-[0_10px_30px_rgba(22,135,201,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#4bdbee]/70 hover:shadow-[0_15px_40px_rgba(75,219,238,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#4bdbee]/70 bg-gradient-to-r from-[#4bdbee] via-[#22b8e8] to-[#0e4f7a] px-10 py-3.5 text-lg font-black text-[#01050b] shadow-[0_0_15px_rgba(75,219,238,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก ขวัญใจ168
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
