---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement.astro";

import { Picture } from "astro:assets";

// ดรอปรอบนี้ (2026-10-24, brand-spec §6) มีสไลด์ที่ใช้ได้ **สองใบ** และชื่อ
// ตัวแปรตั้งตามข้อความที่พิมพ์อยู่บนภาพจริง (เปิดบิตแมปอ่านเองแล้วรอบนี้) ไม่ใช่ตาม
// เลขไฟล์ — ถ้ารอบหน้าเจอความขัดแย้ง **ให้เชื่อข้อความบนรูป**:
//   slide1.png (mtime 2026-10-24, ดรอปนี้) — โปสเตอร์ "โปรโมชั่น / คืนยอดเสีย / 0.3%"
//   slide2.png (mtime 2026-10-24, ดรอปนี้) — โปสเตอร์ "โปรโมชั่น / แนะนำเพื่อน / 0.8%"
//   slide3.png / slide4.png (mtime 2026-09-29 = คนละดรอป คนละแบรนด์) — **ห้าม import**
//   banner2.png / banner3.png (mtime 2026-10-23 = อาร์ตเวิร์กของอีกแบรนด์) —
//     **ห้าม import** รอบนี้ไม่มี "รูปประกอบบทความ" เลย
// ⚠️ การจับคู่พลิกไปมาระหว่างดรอป เพราะ uploader เขียนทับ slide1/slide2 ทุกครั้ง
// เลขไฟล์จึงไม่มีความหมายข้ามแบรนด์ ต้องเปิดบิตแมปดูทุกรอบ — ดรอปนี้ตรวจจากภาพแล้วว่า
// **คืนยอดเสียอยู่บน slide1 และแนะนำเพื่อนอยู่บน slide2**
// ⚠️ eager import = emit ลง dist/ ต่อให้ไม่ได้ render และ verify-build จะแดง
// การ import ไฟล์เก่าคือการส่งรูปของลูกค้ารายอื่นขึ้นเว็บนี้
// **ห้ามลบไฟล์เก่าทิ้ง** — เป็นอินเวนทอรีของรอบถัดไป แค่ห้าม import
// (banner1 / banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักชื่อไว้เอง —
// ห้ามอ้างจากหน้านี้) รอบนี้หน้านี้จึงมีเฉพาะสไลด์สองใบ
import promoCashback from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้นๆ ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมด
// ของหน้านี้, กริดภาพโปรโมชั่น, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อยและห้ามเพิ่มย่อหน้า
// เพราะโปสเตอร์ระบุชื่อรายการและเปอร์เซ็นต์ของตัวเองด้วยตัวอักษรขนาดใหญ่อยู่แล้ว
// การพิมพ์ซ้ำด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ บรีฟรอบนี้
// (src/assets/content.txt) ไม่มีส่วน SUB-PAGES เลย ย่อหน้าทุกย่อหน้าที่เคยอยู่บนหน้านี้
// จึงเป็นของที่รีแบรนด์รอบก่อนๆ แต่งขึ้นเอง — รอบนี้คงไว้เพียงย่อหน้าเกริ่นเดียว
// และเขียนขึ้นใหม่จากบรีฟ (content.txt บรรทัด 8-12)
//
// ลำดับในกริดตามลำดับของบรีฟ: คืนยอดเสีย 0.3% (content.txt บรรทัด 9-10) มาก่อน
// แนะนำเพื่อน 0.8% (บรรทัด 11-12) → promoCashback (slide1) อยู่ช่องแรก
// ⚠️⚠️ **บิตแมปจริงของดรอปนี้คือ 375x600 แนวตั้ง** (วัดจาก IHDR ของไฟล์เองรอบนี้)
// ความกว้างสูงสุดคือ 375 widths จึงหยุดที่ 375 และคุมที่ max-w-[375px]
// **ให้วัดใหม่ทุกรอบจากไฟล์จริง อย่าเชื่อสัดส่วนของรอบก่อน และห้ามขยายเกินต้นฉบับ**
// sizes คิดจากความกว้างที่ถูกวาดจริง: section px-4 (16px/ข้าง) + การ์ด p-8
// (32px/ข้าง, เป็น p-10 = 40px ที่ md ขึ้นไป) + gap-6 ระหว่างคอลัมน์ (24px)
//   ใต้ 640px = คอลัมน์เดียว → 100vw-96px
//   640-767px = สองคอลัมน์ p-8 → 50vw-60px
//   768-885px = สองคอลัมน์ p-10 → 50vw-68px
//   ตั้งแต่ 886px ขึ้นไปชนเพดาน 375px (การ์ดเองกว้างสุด 1400px จึงยังไม่ชน
//   เพดานของการ์ดก่อน)
// LCP คือ hero ใน MainLayout ไม่ใช่รูปพวกนี้ จึง loading="lazy" fetchpriority="low"
// decoding="async" และ quality ตัวเดียวทั้ง avif/webp — ห้ามจูนแยกฟอร์แมต
// (tools/avif-quality-service.mjs ย่อฝั่ง avif ให้เองที่ x0.65)
//
// quality={64} ไม่ใช่ 80 ตามปกติ: สไลด์ทั้งสองเป็นภาพถ่ายคนในสตูดิโอ บวกตัวอักษรไทย
// สามมิติผิวเจลมันเงาที่มีไฮไลต์และขอบคมทับอยู่ด้านบน ซึ่งเป็นเคสที่ AVIF ทำได้แย่ที่สุด
// ที่ quality=80 ไฟล์ AVIF มีโอกาสออกมา **ใหญ่กว่า** WebP ที่เป็น fallback ของตัวเอง
// เบราว์เซอร์ที่รองรับ AVIF จะหยิบไฟล์ที่หนักกว่าไปใช้ และ verify-build.mjs ทำให้
// build แดงด้วยเหตุนี้ตรงๆ · ทางแก้คือ quality ที่ **ต่ำลง** ไม่ใช่สูงขึ้น ·
// ค่าเดียวกันนี้ต้องใช้ที่ index.astro กับสไลด์คู่เดียวกัน
//
// Announcement รอบนี้หมุนมาเป็น Announcement (ตัวฐาน) ทั้งเว็บ (brand-spec §3 —
// รอบก่อนใช้ Announcement4 จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้น
// เป็นคอปปี้ของแบรนด์นี้ไว้แล้ว และทุกหน้าเรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop
// message มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกันระหว่างหน้า
//
// ───────────────────────────────────────────────────────────────────────────
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) **ยังเป็นธีมสว่างเหมือนรอบก่อน แต่คนละฮิวสิ้นเชิง**
// bg.json ของดรอปนี้คือ {"mode":"color","color":"#00bfff"} = **ฟ้าสกายอิ่มตัว**
// (รอบก่อนเป็น ffe5ff = ชมพูพาสเทล — อ่านจากไฟล์ทุกรอบ ห้ามเดา)
// **ห้าม "แก้" การ์ดกลับไปเป็นพื้นมืด** การ์ดมืดบนหมึก #06283f = ตัวอักษรหายไปเลย
// ลำดับผิว: พื้นเพจ #00bfff / การ์ด #ffffff (ContentBox) / ผิวยก #f0faff /
// wash #e4f6fb · เส้น #7fcbe8 · เส้นเข้ม #4fb8ea (**ทั้งคู่ห้ามถือตัวอักษร**)
// หมึก #06283f = เนื้อความ (= BRAND_TEXT ที่ <html> และการ์ด ContentBox ตั้งให้แล้ว
// 15.2:1 บนการ์ดขาว) · หมึกรอง #355f7d (6.8:1)
// ฟ้าลึก #0f5684 = สีของ <strong> ในเนื้อความ (7.8:1 บนการ์ดขาว) และหัวข้อ
// 🚨🚨 **#12b4ef บนพื้นขาวได้แค่ 2.4:1 ห้ามเป็นสีตัวอักษร** และ **ห้ามถมพื้น #12b4ef
// แล้ววางหมึกขาว** (2.4:1 เหมือนกัน) — พื้นฟ้าที่รับหมึกขาวได้ต้องเป็น #1a6ea8
// (5.5:1) ลงไป ส่วนพื้น #12b4ef รับได้เฉพาะหมึกน้ำเงินเข้ม #06283f (6.4:1)
// ปุ่ม CTA ของหน้านี้เป็น **PRIMARY = ไล่เฉดน้ำเงินมหาสมุทร** #1a6ea8 → #0f5684 →
// #06283f บนหมึก **ขาว #ffffff** (5.5 / 7.8 / 15.2:1 ต่อ stop) ตรงกับปุ่มสมัครสมาชิก
// ที่ /contact-us /ทางเข้า /register
// แผ่นไฮไลต์ด้านบนปุ่มจำกัดที่ white/10 (ผสมแล้ว stop บนเหลือ ~5.0:1 ยังผ่าน AA)
// rgba() ที่อนุญาตรอบนี้: rgba(18,180,239,α) · rgba(182,227,240,α) ·
// rgba(15,86,132,α) · rgba(6,40,63,α) · rgba(127,203,232,α)
// ⚠️⚠️ **รอบนี้ไม่มีทองไม่มีเหลืองเลยสักเฉด ไม่มีเงินเย็น ไม่มีชมพู/แมเจนต้า/พลัม
// ไม่มีแดง ไม่มีม่วง ไม่มีส้ม ไม่มีครีม ไม่มีเบจ ไม่มีเขียว (ยกเว้น LINE green
// ที่หน้าอื่น)** และ **ชมพู/พลัมของแบรนด์ขาออกห้ามเหลือสักค่า** (ชื่อและค่าอยู่ใน
// brand-spec §2)
// ⚠️⚠️ กับดักที่แหลมที่สุดรอบนี้คือ **ฟ้า/น้ำเงินของแบรนด์อื่น** ซึ่งเป็นตระกูลเดียวกับ
// รอบนี้ ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน brand-spec §2 ห้ามตัดสินด้วยสายตา
// · เสื้อคลุมถักฟ้าอ่อน พื้นสตูดิโอขาว ดาวเหลือง เหรียญทอง และสีผิวนักแสดงใน
// อาร์ตเวิร์กเป็น **วัตถุในภาพ ไม่ใช่สี UI** · <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง"
// ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดกลางคำ บรรทัดจะตัดกลางคำ
//
// ⚠️ แกนของแบรนด์รอบนี้คือ **เว็บสล็อต** (เกมสล็อตสนุกสุดมันส์ เว็บตรงแตกง่าย)
// คำนิยามตัวเองของแบรนด์ก่อนๆ ห้ามเหลือ โดยเฉพาะศัพท์หมวดลอตเตอรีทั้งชุด
// (brand-spec §5 ไม่พิมพ์ซ้ำที่นี่) สองหน้าของหมวดนั้น **ปิดอยู่รอบนี้** (อยู่ใน
// src/pages-disabled/) หน้านี้จึงไม่มีอะไรให้ลิงก์ไป และโควตาปุ่มของหน้านี้คือ
// ปุ่มเดียวอยู่แล้ว
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 1 บาท · 24ชม.
// **ไม่มี RTP เป็นตัวเลข ไม่มีจำนวนเกม/ค่าย ไม่มียอดขั้นต่ำเป็นตัวเลขอื่น
// ไม่มีอัตราจ่าย ไม่มี 100% และไม่มีจำนวนขั้นตอนการสมัครเป็นตัวเลข**
// ห้ามแต่งตัวเลขการเงิน ชื่อธนาคาร เลขใบอนุญาต ปีก่อตั้ง หรือจำนวนสมาชิก
// และต้องคงประโยคกำกับของบรีฟไว้ว่า **แต่ละรายการอาจมีเงื่อนไขแตกต่างกัน จึงควร
// อ่านข้อกำหนดล่าสุดให้ครบถ้วน** (content.txt บรรทัด 8)
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงนี้ยาว 154 ด้วยชื่อแบรนด์ 10 อักขระของรอบนี้
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `รวมโปรโมชั่น ${BRAND_NAME} ไว้ในหน้าเดียว ทั้งคืนยอดเสีย 0.3% และแนะนำเพื่อนรับโบนัส 0.8% แต่ละรายการมีเงื่อนไขต่างกัน จึงควรตรวจสอบประกาศล่าสุดก่อนรับสิทธิ์`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่น ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});

// ความกว้างที่ถูกวาดจริงของแต่ละคอลัมน์ในกริดสองคอลัมน์ (ดูคอมเมนต์ sizes ด้านบน)
const promoSizes = "(max-width: 639px) calc(100vw - 96px), (max-width: 767px) calc(50vw - 60px), (max-width: 885px) calc(50vw - 68px), 375px";

const promoClass =
  "mx-auto h-auto w-full max-w-[375px] rounded-xl border border-[#7fcbe8] object-contain shadow-[0_8px_28px_rgba(15,86,132,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#12b4ef] hover:shadow-[0_12px_40px_rgba(18,180,239,0.3)]";

// alt ทั้งสองเขียนจากบิตแมปของดรอปนี้ที่เปิดอ่านเองแล้ว (**375x600 แนวตั้ง** ทั้งคู่) —
// ฉากพื้นขาวอมฟ้า ผู้หญิงผมยาวสีน้ำตาลเข้มขยิบตา ผูกโบว์ฟ้าที่ผม สวมเสื้อคลุมถักสีฟ้าอ่อน
// ยกโทรศัพท์ที่จอแสดงตารางเกมสล็อตหกช่องขึ้นทางซ้ายของภาพ แล้วชี้นิ้วไปที่จอ ·
// ตัวอักษรไทยสามมิติทรงบับเบิลฟ้าตัดขอบขาวว่า โปรโมชั่น · ชื่อรายการ · ตัวเลขเปอร์เซ็นต์
// ตัวโต · หัวใจฟ้าและเมฆการ์ตูนลอยรอบตัวอักษร · หัวการ์ตูนผู้หญิงหน้าตกใจผูกโบว์ขาว
// ที่ริมซ้ายของตัวเลข · แคปซูลขาวท้ายภาพเขียนว่า เว็บตรงแตกง่าย เบทต่ำ ไม่ทำเทิร์น
// ⚠️ alt คือ "ข้อความที่พิมพ์อยู่บนโปสเตอร์" เป็นหลัก — ตัวเลขท้าย alt ต้องตรงกับรูป
// ⚠️ ห้ามเรียกรูปคู่นี้ว่าภาพแนวนอนหรือภาพสี่เหลี่ยมจัตุรัส รอบนี้เป็น **แนวตั้ง**
// ⚠️ จุดที่ **ต่างกันจริงระหว่างสองใบ** และต้องเขียนให้ตรง (ตรวจจากบิตแมปรอบนี้):
//   slide1 (คืนยอดเสีย 0.3%) ชื่อรายการเป็น **ตัวอักษรบับเบิลฟ้าเปล่าๆ** ไม่มีแคปซูล ·
//     มีมงกุฎเส้นขอบเข้มคร่อมคำว่า โปรโมชั่น · เหรียญทองและดาวเหลืองกองอยู่ **มุมล่างซ้าย**
//   slide2 (แนะนำเพื่อน 0.8%) ชื่อรายการอยู่ใน **แคปซูลขอบฟ้าพร้อมไอคอนเครื่องบินกระดาษ** ·
//     เหรียญทองอยู่ริมขวาของตัวเลข และมี **ตู้สล็อต 777 สีฟ้าที่มุมล่างขวา**
//   (โลโก้อยู่มุมบนซ้ายทั้งสองใบ — ตรวจแล้วรอบนี้)
// ⚠️ ห้ามระบุว่าถือด้วยมือซ้ายหรือมือขวา — รอบก่อนๆ เขียนไว้แล้วผิดหลายรอบติด
// ⚠️ สีของวัตถุในรูป (ผมสีน้ำตาลเข้ม เสื้อคลุมถักฟ้าอ่อน ดาวเหลือง เหรียญทอง) เป็นวัตถุ
// ในภาพ ไม่ใช่สีของแบรนด์ และไม่เข้ามาใน UI
// ⚠️ องค์ประกอบของอาร์ตเวิร์กแบรนด์ก่อนๆ ที่ต้องไม่หลงเหลือใน alt อยู่ครบใน
// brand-spec §6 (ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive)
const altCashback = `โปสเตอร์โปรโมชั่นแนวตั้ง พื้นขาวอมฟ้า มุมบนซ้ายเป็นโลโก้ ${BRAND_NAME} ตัวอักษรบับเบิลสามมิติสีฟ้าคู่กับหัวการ์ตูนผู้หญิงหน้าตกใจ กลางภาพเป็นผู้หญิงผมยาวสีน้ำตาลเข้มผูกโบว์ฟ้า ขยิบตา สวมเสื้อคลุมถักสีฟ้าอ่อน ยกโทรศัพท์ขึ้นทางซ้ายของภาพซึ่งจอแสดงตารางเกมสล็อตหกช่อง แล้วชี้นิ้วไปที่จอ ครึ่งล่างเป็นตัวอักษรไทยสามมิติตัวโตสีฟ้าตัดขอบขาวอ่านว่า โปรโมชั่น มีมงกุฎเส้นขอบสีเข้มคร่อมอยู่ ใต้ลงมาเป็นคำว่า คืนยอดเสีย และตัวเลข 0.3% ตัวโต มีหัวใจฟ้าลอยรอบตัวอักษร เหรียญทองกับดาวเหลืองที่มุมล่างซ้าย และแคปซูลมนสีขาวท้ายภาพเขียนว่า เว็บตรงแตกง่าย เบทต่ำ ไม่ทำเทิร์น`;

const altReferral = `โปสเตอร์โปรโมชั่นแนวตั้ง พื้นขาวอมฟ้า มุมบนซ้ายเป็นโลโก้ ${BRAND_NAME} ตัวอักษรบับเบิลสามมิติสีฟ้าคู่กับหัวการ์ตูนผู้หญิงหน้าตกใจ กลางภาพเป็นผู้หญิงผมยาวสีน้ำตาลเข้มผูกโบว์ฟ้า ขยิบตา สวมเสื้อคลุมถักสีฟ้าอ่อน ยกโทรศัพท์ขึ้นทางซ้ายของภาพซึ่งจอแสดงตารางเกมสล็อตหกช่อง แล้วชี้นิ้วไปที่จอ ครึ่งล่างเป็นตัวอักษรไทยสามมิติตัวโตสีฟ้าตัดขอบขาวอ่านว่า โปรโมชั่น ใต้ลงมาเป็นแคปซูลขอบฟ้าพร้อมไอคอนเครื่องบินกระดาษเขียนว่า แนะนำเพื่อน และตัวเลข 0.8% ตัวโต มีเหรียญทองริมขวาของตัวเลข ตู้สล็อต 777 สีฟ้าที่มุมล่างขวา และแคปซูลมนสีขาวท้ายภาพเขียนว่า เว็บตรงแตกง่าย เบทต่ำ ไม่ทำเทิร์น`;
---

<MainLayout title={`โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`รวมโปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} as="h1">
    <div class="flex flex-col gap-10">
      <p class="text-left text-base leading-relaxed">
        หน้านี้รวมภาพโปรโมชั่นสำหรับสมาชิกของ {BRAND_NAME} ไว้ในที่เดียว ทั้ง
        <strong class="text-[#0f5684]">รายการคืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน และโบนัสแนะนำเพื่อน 0.8% ไม่จำกัด</strong>
        โดยชื่อรายการและอัตราระบุไว้บนภาพด้านล่างแล้ว
        <strong class="text-[#0f5684]">แต่ละรายการอาจมีเงื่อนไขเกี่ยวกับประเภทเกม ยอดที่นำมาคำนวณ รอบเวลารับเครดิต และการถอนเงินแตกต่างกัน จึงควรอ่านข้อกำหนดล่าสุดให้ครบถ้วนก่อนรับสิทธิ์</strong>
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt={altCashback}
          loading="lazy"
          fetchpriority="low"
          widths={[250, 375]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />

        <Picture
          src={promoReferral}
          alt={altReferral}
          loading="lazy"
          fetchpriority="low"
          widths={[250, 375]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="relative isolate flex items-center justify-center overflow-hidden rounded-lg border border-[#06283f] bg-gradient-to-b from-[#1a6ea8] via-[#0f5684] to-[#06283f] px-10 py-3.5 text-lg font-black text-white shadow-[0_8px_22px_rgba(15,86,132,0.35)] transition-transform hover:scale-105">
          <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-white/10 to-transparent"></span>
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
