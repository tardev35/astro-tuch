---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

// ดรอปนี้ (2026-10-10) มีสไลด์ที่ "ใช้ได้" แค่สองใบ และรอบนี้เปิดอ่านป้ายบนภาพจริง
// ใหม่แล้ว ห้ามเชื่อเลขไฟล์หรือคอมเมนต์ของรอบก่อน (เคยสลับกันมาแล้ว และรอบนี้ก็
// สลับอีก — ตารางใน brand-spec §4 จับคู่ไฟล์กับหัวข้อ "สลับข้าง" กับสิ่งที่พิมพ์
// อยู่บนรูปจริง ส่วนบุลเล็ต alt ใน §4 เองเขียนตรงกับรูป ยึดตามรูปจริง):
//   slide1.png — ป้าย "โปรโมชั่น" ทองขอบแดงสามมิติ ใต้ป้ายเขียน "แนะนำเพื่อน โบนัส 0.8%"
//   slide2.png — ป้าย "โปรโมชั่น" ทองขอบแดงสามมิติ ใต้ป้ายเขียน "คืนยอดเสีย 0.3%"
//   slide3.png / slide4.png — อาร์ตเวิร์กของแบรนด์ก่อน (mtime 09-29)
//     ห้าม import กลับมาเด็ดขาด และห้ามลบไฟล์ทิ้งเพราะเป็นอินเวนทอรีของรอบถัดไป
// ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้ว และ verify-build จะแดง
// (banner2 / banner3 ใน src/assets เป็นอาร์ตเวิร์กของแบรนด์ก่อนๆ ห้าม import ส่วน
// banner1 / banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักชื่อไว้เอง
// — ห้ามอ้างจากหน้านี้)
// ชื่อตัวแปรตั้งตามข้อความบนภาพ ไม่ใช่ตามเลขไฟล์ เพื่อไม่ให้รอบหน้าสลับผิดอีก
import promoCashback from "../assets/slide2.png";
import promoReferral from "../assets/slide1.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้นๆ "หนึ่งย่อหน้า ประมาณสี่บรรทัด" คือ
// โควตาตัวหนังสือทั้งหมดของหน้านี้, กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อย
// และห้ามเพิ่มย่อหน้า เพราะตัวโปสเตอร์ระบุเปอร์เซ็นต์โบนัสไว้ด้วยตัวอักษรขนาดใหญ่
// อยู่แล้ว การพิมพ์ซ้ำด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ เป้าหมาย h1x1 h2x0 h3x0
//
// สไลด์รอบนี้เป็น **600x600 ทั้งคู่** วางเป็นกริดสองคอลัมน์ คุมความกว้างรวมที่
// max-w-4xl (896px) ทำให้ช่องละ ~436px ไม่ต้องอัปสเกลเกินขนาดไฟล์ต้นทาง widths
// หยุดที่ 600 ตามความกว้างจริงของไฟล์ และคุมภาพต่อใบไว้ที่ max-w-[600px]
// เรียง คืนยอดเสีย 0.3% ก่อน แนะนำเพื่อน 0.8% ตามลำดับของบรีฟ (docx H3 #4 แล้ว #5)
// ซึ่งรอบนี้แปลว่า **slide2 มาก่อน slide1** ตามข้อความที่พิมพ์อยู่บนรูป
// sizes คิดจากความกว้างที่ถูกวาดจริง: px-4 ของ section (16px/ข้าง) + p-8 ของการ์ด
// (32px/ข้าง, เป็น p-10 = 40px ที่ md ขึ้นไป) + gap-6 (24px) ระหว่างสองคอลัมน์
// LCP คือ hero ใน MainLayout ไม่ใช่สองรูปนี้ จึง loading="lazy" fetchpriority="low"
//
// Announcement รอบนี้หมุนมาเป็น Announcement5 ทั้งเว็บ (รอบก่อนใช้ Announcement2)
// orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว และทุกหน้า
// ก็เรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกัน
// ระหว่างหน้า
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ทองสายฟ้า บนแดงเลือดนก** พลิกทิศจากรอบก่อน
// ที่แดงนำบนพื้นน้ำตาลถ่านเกือบดำ รอบนี้ bg.json เป็นสีเดียว #5c0000 = แดงเลือดนกเข้ม
// ฮิวนำคือ **ทอง** #f5c518 (สายฟ้าผ่ากลางเหรียญ + คำว่า FLASH บนโลโก้) ถือขอบ ออรา
// และพื้นถมของปุ่มหลัก · ทองสว่าง #ffdd73 เป็นต้นไล่เฉดและ hover · ทองเข้ม #b8860f
// เป็นขอบและปลายเข้มของพื้นถมทอง (หมึก #2a0300 บนมันได้ 5.8:1 = ผ่าน) · แดงสายฟ้า
// #ff3b14 (เลข 877 บนโลโก้) เป็นฮิวที่สอง ใช้ได้เฉพาะออราและเงา · หมึกบนพื้นถมทอง
// เป็นน้ำตาลเกือบดำ #2a0300 เท่านั้น · เนื้อความ #fdf0e2 มาจาก BRAND_TEXT ที่ <html>
// และการ์ด ContentBox ตั้งให้แล้ว ย่อหน้าจึงไม่ประกาศสีของตัวเอง
// ⚠️ ห้ามพลิกปุ่มพื้นทองให้เป็นหมึกสว่าง และห้ามวางตัวอักษรเนื้อความบนแดง #ff3b14
// (3.6:1 บนผิวการ์ด) ชุดสีของแบรนด์ก่อนๆ ออกครบแล้ว ทั้งคลาส Tailwind raw hex และ
// rgba() (ค่าเดิมอยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีแบรนด์
// เก่าเจอ false positive) ห้ามนำกลับมา
// ⚠️ สองกับดักของรอบนี้: (1) แบรนด์รอบก่อนก็ "แดง-ทอง" เหมือนกัน เจอแดงหรือทองที่ไหน
// ห้ามเหมาว่าเป็นของรอบนี้ ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน brand-spec §2
// (2) ทองของรอบก่อนๆ เป็นคนละค่ากับ #f5c518 และแดงของรอบก่อนๆ ก็คนละค่ากับ #ff3b14
//
// แบรนด์นี้เป็น **เว็บตรงฐานสล็อตหลัก ไม่ผ่านเอเย่นต์ อัปเดตระบบเข้าเล่นใหม่ 2026**
// เป็นเว็บสล็อตล้วน ไม่ใช่เว็บหวยและไม่ใช่เว็บรวมทุกหมวด คำขายของของแบรนด์ก่อนและ
// ศัพท์หมวดอื่นที่บรีฟไม่ได้เอ่ยห้ามหลงเหลือ (รายการเต็มอยู่ใน brand-spec §6 ไม่พิมพ์
// ซ้ำที่นี่ เพื่อไม่ให้ grep เจอ false positive) ตัวเลขที่บรีฟให้และอ้างได้มีแค่
// 0.3% / 0.8% / 24 ชั่วโมง / 100% / 2026 — ห้ามแต่งยอดฝากขั้นต่ำ ชื่อค่ายเกม
// ชื่อธนาคาร ค่า RTP เลขใบอนุญาต จำนวนสมาชิก ปีก่อตั้ง หรือวันหมดเขต
// และต้องคงคำกำกับของบรีฟไว้ว่าเกมที่ร่วมรายการและข้อกำหนดของแต่ละกิจกรรม
// อาจแตกต่างกัน ควรอ่านก่อนกดรับสิทธิ์
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) หน้านี้ยาว 156 อักขระ
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ดูภาพโปรโมชั่นของ ${BRAND_NAME} ทั้งคืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อนรับโบนัสแชร์ลิงก์ 0.8% จากยอดที่เข้าเกณฑ์ พร้อมรอบคำนวณและเงื่อนไขของแต่ละกิจกรรม`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่น ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});

// ความกว้างที่ถูกวาดจริงของแต่ละช่องในกริดสองคอลัมน์ (ดูคอมเมนต์ sizes ด้านบน)
const promoSizes = "(max-width: 639px) calc(100vw - 96px), (max-width: 767px) calc((100vw - 120px) / 2), (max-width: 1007px) calc((100vw - 136px) / 2), 436px";
const promoClass =
  "mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#f5c518]/40 object-contain shadow-[0_0_28px_rgba(245,197,24,0.28)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f5c518]/85 hover:shadow-[0_0_40px_rgba(255,59,20,0.38)]";
---

<MainLayout title={`โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% จากยอดที่เข้าเกณฑ์`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`โปรโมชั่น ${BRAND_NAME} ทั้งหมด`} as="h1">
    <div class="flex flex-col gap-10">
      <p>
        หน้านี้รวมภาพโปรโมชั่นที่ <strong>{BRAND_NAME}</strong> เปิดให้สมาชิกตรวจสอบสิทธิ์ตามกิจกรรมที่เปิดให้รับในแต่ละช่วง โดยเน้นโบนัสคืนยอดเสียและกิจกรรมแนะนำเพื่อน รายละเอียดของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว
        สมาชิกเข้าสู่ระบบเพื่อตรวจสอบยอดที่เข้าเกณฑ์ รอบคำนวณ และสถานะการรับโบนัสผ่านบัญชีได้โดยตรง <strong>
          เกมที่ร่วมรายการและข้อกำหนดของแต่ละกิจกรรมอาจแตกต่างกัน
        </strong> จึงควรอ่านรอบตัดยอดและเงื่อนไขการใช้โบนัสก่อนกดรับสิทธิ์ทุกครั้ง
      </p>

      <div class="mx-auto grid w-full max-w-4xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt={`ภาพโปรโมชั่นของ ${BRAND_NAME} เป็นฉากคาสิโนโทนแดง-ทอง ฉากหลังเป็นม่านกำมะหยี่แดงกับโคมไฟคริสตัลระย้า มุมซ้ายบนเป็นโลโก้ ${BRAND_NAME} สายฟ้าทองบนเหรียญกลมขอบทอง ด้านซ้ายเป็นเทพเจ้าแห่งโชคลาภการ์ตูนถือก้อนทอง กลางภาพเป็นหญิงสาวผมบลอนด์ในชุดแดงประดับเลื่อม ชี้มือมาทางผู้ชมและอีกมือยกเหรียญทองขึ้น ด้านขวาเป็นเสือการ์ตูนใส่แว่นกันแดดสีดำ รอบตัวมีเหรียญทองร่วงกระจายและกองชิปคาสิโนอยู่ด้านล่าง ล่างสุดเป็นคำว่า โปรโมชั่น ตัวอักษรสามมิติทองขอบแดงขนาดใหญ่ และใต้ลงมาเขียนว่า คืนยอดเสีย คู่กับตัวเลข 0.3% ตัวโต`}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoReferral}
          alt={`ภาพโปรโมชั่นของ ${BRAND_NAME} ฉากคาสิโนแดง-ทองชุดเดียวกัน มุมซ้ายบนเป็นโลโก้ ${BRAND_NAME} สายฟ้าทองบนเหรียญกลมขอบทอง ด้านซ้ายเป็นเทพเจ้าแห่งโชคลาภการ์ตูนถือก้อนทองยืนข้างตู้สล็อต กลางภาพเป็นหญิงสาวผมบลอนด์ชุดแดงประดับเลื่อม ชี้มือมาทางผู้ชมและอีกมือยกกล่องของขวัญสีแดงคาดริบบิ้นทองที่มีโลโก้ ${BRAND_NAME} อยู่บนกล่อง ด้านขวาเป็นแพนด้าการ์ตูนใส่แว่นกันแดดสีดำ ด้านล่างมีไพ่ กองชิปคาสิโน และเหรียญทองร่วงกระจาย ล่างสุดเป็นคำว่า โปรโมชั่น ตัวอักษรสามมิติทองขอบแดงขนาดใหญ่ และใต้ลงมาเขียนว่า แนะนำเพื่อน โบนัส คู่กับตัวเลข 0.8% ตัวโต`}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#b8860f] bg-gradient-to-b from-[#ffdd73] via-[#f5c518] to-[#b8860f] px-10 py-3.5 text-lg font-black text-[#2a0300] shadow-[0_0_14px_rgba(245,197,24,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
