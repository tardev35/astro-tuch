---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

// Only slide1/slide2 belong to CREEKBET (drop 2026-08-14), and they are exactly
// the two promotions this page shows: slide1 is the "แนะนำเพื่อน รับโบนัส 0.8%"
// poster, slide2 is the "คืนยอดเสีย รับโบนัส 0.3%" poster.
// slide3/slide4 are still on disk but belong to previous clients — they may not
// be imported here, now or on any future rebrand.
import promoCashback from "../assets/slide2.png";
import promoReferral from "../assets/slide1.png";
import { pageGraph } from "../lib/schema";

// This is an IMAGE page: the ContentBox title, ONE short intro paragraph, the
// poster grid, one CTA. No section headings, no extra prose — the posters
// already state every offer in large type.
//
// 150–160 CHARACTERS (not bytes — a byte count reads ~3x too long for Thai).
const pageDescription =
  "รวมโปรโมชั่น CREEKBET เกมคาสิโนเว็บแท้ ทั้งโปรแนะนำเพื่อนรับโบนัส 0.8% และคืนยอดเสียทุกวัน 0.3% ดูรายละเอียดจากภาพโปรโมชั่นและตรวจเงื่อนไขก่อนกดรับสิทธิ์";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น CREEKBET แนะนำเพื่อน 0.8% คืนยอดเสียทุกวัน 0.3%",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});
---

<MainLayout title="โปรโมชั่น CREEKBET เกมคาสิโนเว็บแท้ แนะนำเพื่อน 0.8% คืนยอดเสียทุกวัน 0.3%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น CREEKBET" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#dfe4ea]">
        หน้านี้รวมโปรโมชั่นที่ CREEKBET เกมคาสิโนเว็บแท้ เปิดให้สมาชิกกดรับอยู่ในขณะนี้ ทั้งโบนัสแนะนำเพื่อน 0.8% และคืนยอดเสียทุกวัน 0.3%
        อัตราโบนัส ยอดที่นำมาคำนวณ และรอบเวลาการรับสิทธิ์ระบุไว้บนภาพโปรโมชั่นแต่ละใบ และเงื่อนไขของแต่ละรายการไม่เหมือนกัน
        สมาชิกตรวจสอบสิทธิ์และกดรับโบนัสได้จากบัญชีสมาชิก หรือสอบถามแอดมินที่ดูแลตลอด 24 ชั่วโมง
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่นพื้นหลังสีเทาเงินมีลูกเต๋าและชิปคาสิโนสีขาว มุมซ้ายบนเป็นคำว่า CREEKBET ตัวอักษรโครเมียมสามมิติ ถัดลงมาเป็นคำว่า โปรโมชั่น คืนยอดเสีย และ รับโบนัส คู่กับตัวเลข 0.3% ขนาดใหญ่สีเงิน ด้านขวาเป็นหญิงสาวผมบลอนด์เกล้ามวยสวมชุดคอจีนสีเทาสลับแดงเลือดหมู แบฝ่ามือเปิดไปทางข้อความ"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#5b636b]/60 object-contain shadow-[0_10px_30px_rgba(207,212,218,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#cfd4da]/70 hover:shadow-[0_15px_40px_rgba(192,36,52,0.28)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่นพื้นหลังสีเทาเงินมีลูกเต๋าและชิปคาสิโน มุมซ้ายบนเป็นคำว่า CREEKBET ตัวอักษรโครเมียมสามมิติ ถัดลงมาเป็นคำว่า โปรโมชั่น บนป้ายสีเข้ม ตามด้วย แนะนำเพื่อน และ รับโบนัส คู่กับตัวเลข 0.8% ขนาดใหญ่สีเงิน ด้านขวาเป็นหญิงสาวผมบลอนด์เกล้ามวยสวมเสื้อสายเดี่ยวสีเทาสลับแดงเลือดหมูที่มีคำว่า CREEKBET กำลังชี้นิ้วมาที่ข้อความ"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#5b636b]/60 object-contain shadow-[0_10px_30px_rgba(207,212,218,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#cfd4da]/70 hover:shadow-[0_15px_40px_rgba(192,36,52,0.28)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#f4f6f8]/70 bg-gradient-to-r from-[#f4f6f8] via-[#cfd4da] to-[#9aa2ab] px-10 py-3.5 text-lg font-black text-[#0a0b0d] shadow-[0_0_15px_rgba(207,212,218,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก CREEKBET
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
