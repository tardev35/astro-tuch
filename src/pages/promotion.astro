---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement4.astro";

import { Picture } from "astro:assets";

// ดรอปนี้ (2026-10-11) มีสไลด์ที่ใช้ได้แค่สองใบ และรอบนี้เปิดอ่านป้ายบนภาพจริงซ้ำแล้ว
// ห้ามเชื่อเลขไฟล์หรือคอมเมนต์ของรอบก่อน (การจับคู่สลับข้างแทบทุกรอบ — ตารางใน
// brand-spec §4 ตรงกับสิ่งที่พิมพ์อยู่บนรูปจริง):
//   slide1.png — ป้าย "โปรโมชั่น" ชมพูสามมิติใต้มงกุฎทอง ใต้ป้ายเขียน "คืนยอดเสีย 0.3%"
//   slide2.png — ป้าย "โปรโมชั่น" ชุดเดียวกัน ใต้ป้ายเขียน "แนะนำเพื่อน โบนัส 0.8%"
//   slide3.png / slide4.png — โปสเตอร์ของแบรนด์รอบก่อน (mtime 09-29)
//     ห้าม import กลับมาเด็ดขาด และห้ามลบไฟล์ทิ้งเพราะเป็นอินเวนทอรีของรอบถัดไป
// ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้ว และ verify-build จะแดง
// (banner2 / banner3 ใน src/assets เป็นอาร์ตเวิร์กของแบรนด์ก่อนๆ ห้าม import ส่วน
// banner1 / banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักชื่อไว้เอง
// — ห้ามอ้างจากหน้านี้)
// ชื่อตัวแปรตั้งตามข้อความบนภาพ ไม่ใช่ตามเลขไฟล์ เพื่อไม่ให้รอบหน้าสลับผิดอีก
import promoCashback from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้นๆ ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมด
// ของหน้านี้, กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อยและห้ามเพิ่มย่อหน้า
// เพราะตัวโปสเตอร์ระบุเปอร์เซ็นต์โบนัสไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว การพิมพ์ซ้ำ
// ด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ เป้าหมาย h1x1 h2x0 h3x0
//
// สไลด์รอบนี้เป็น **600x600 ทั้งคู่** วางเป็นกริดสองคอลัมน์ คุมความกว้างรวมที่
// max-w-4xl (896px) ทำให้ช่องละ ~436px ไม่ต้องอัปสเกลเกินขนาดไฟล์ต้นทาง widths
// หยุดที่ 600 ตามความกว้างจริงของไฟล์ และคุมภาพต่อใบไว้ที่ max-w-[600px]
// เรียง คืนยอดเสีย 0.3% ก่อน แนะนำเพื่อน 0.8% ตามลำดับของบรีฟ (docx H3 #4 แล้ว #5)
// ซึ่งรอบนี้แปลว่า **slide1 มาก่อน slide2** ตามข้อความที่พิมพ์อยู่บนรูป
// sizes คิดจากความกว้างที่ถูกวาดจริง: px-4 ของ section (16px/ข้าง) + p-8 ของการ์ด
// (32px/ข้าง, เป็น p-10 = 40px ที่ md ขึ้นไป) + gap-6 (24px) ระหว่างสองคอลัมน์
// LCP คือ hero ใน MainLayout ไม่ใช่สองรูปนี้ จึง loading="lazy" fetchpriority="low"
//
// Announcement รอบนี้หมุนมาเป็น Announcement4 ทั้งเว็บ (รอบก่อนใช้ Announcement6 —
// brand-spec §3 หมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ
// แบรนด์นี้ไว้แล้ว และทุกหน้าก็เรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop message
// มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกันระหว่างหน้า
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ชมพูบานเย็น นำ ทอง รอง บนพื้นพลัมเกือบดำ**
// พลิกทิศจากรอบก่อนที่เป็นคู่ทอง-ส้มอำพันบนพื้นดำสนิท รอบนี้ bg.json เป็น
// {"mode":"color","color":"#2e002c"} จึงมีชั้นที่ลึกกว่าพื้นเพจได้
// ฮิวนำคือ **ชมพู** #ff3fa4 (ตัวอักษรโลโก้ หูกระต่าย หัวใจ ชิป) ถือขอบรูป ออรา และ
// พื้นถมของปุ่มหลัก · #ffd1ea เป็นต้นสว่างของไล่เฉด · #ff6cbb เป็นช่วงกลาง
// · **ทอง** #f5c53d (เหรียญ มงกุฎ ตู้ 777) เป็นฮิวที่สอง ใช้เป็นออราตอน hover
// · หมึกบนพื้นถมชมพูเป็น #2b0019 เท่านั้น · เนื้อความ #fde8f3 มาจาก BRAND_TEXT ที่
// <html> และการ์ด ContentBox ตั้งให้แล้ว ย่อหน้าจึงไม่ประกาศสีของตัวเอง
// ⚠️ ไล่เฉดชมพูที่รองหมึกเข้มต้องจบไม่เข้มกว่า #ff3fa4 — #b3006a / #7a0046 / #4d002b
// เป็นเส้น ขอบ และออราเท่านั้น ห้ามถือตัวอักษรทุกขนาด
// ⚠️ กับดักของรอบนี้: มีแบรนด์ก่อนหน้าที่เป็นแบรนด์ชมพูเหมือนกัน และเจ็ดในแปด
// แบรนด์หลังสุดก็มีทอง "เจอชมพูหรือทองที่ไหน" ห้ามเหมาว่าเป็นของรอบนี้ ให้เทียบเป็น
// "ค่า" ทีละตัวกับตารางใน brand-spec §2 (ค่าทองของแบรนด์ก่อนหนึ่งเจ้าต่างจากทองของ
// รอบนี้แค่สองตัวอักษร ห้ามกะด้วยตา — และค่าเดิมไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep
// หาสีแบรนด์เก่าเจอ false positive)
//
// แบรนด์นี้เป็น **ฟาสล็อตเว็บตรง** เป็นเว็บสล็อตล้วน ไม่ใช่เว็บของหมวดอื่น คำขายของ
// ของแบรนด์ก่อนและศัพท์หมวดอื่นที่บรีฟไม่ได้เอ่ยห้ามหลงเหลือ (รายการเต็มอยู่ใน
// brand-spec §7 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep เจอ false positive) ตัวเลขที่บรีฟ
// ให้และอ้างได้มีแค่ 0.3% / 0.8% / 3 ขั้นตอน / 24 ชั่วโมง — ห้ามแต่งยอดฝากขั้นต่ำ
// ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP เลขใบอนุญาต จำนวนสมาชิก ปีก่อตั้ง หรือวันหมดเขต
// และต้องคงคำกำกับของบรีฟไว้ว่าแต่ละโปรโมชั่นอาจมีเงื่อนไขเกี่ยวกับประเภทเกม
// รอบรับสิทธิ์ และการใช้โบนัสแตกต่างกัน จึงควรอ่านรายละเอียดก่อนกดรับทุกครั้ง
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) หน้านี้ยาว 158 อักขระ
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `รวมภาพโปรโมชั่น ${BRAND_NAME} ฟาสล็อตเว็บตรง ทั้งคืนยอดเสีย 0.3% เข้ายูสตามรอบประจำวัน และแนะนำเพื่อนรับโบนัส 0.8% จากยอดที่เข้าเกณฑ์ โดยแต่ละรายการมีเงื่อนไขต่างกัน`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่น ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});

// ความกว้างที่ถูกวาดจริงของแต่ละช่องในกริดสองคอลัมน์ (ดูคอมเมนต์ sizes ด้านบน)
const promoSizes = "(max-width: 639px) calc(100vw - 96px), (max-width: 767px) calc((100vw - 120px) / 2), (max-width: 1007px) calc((100vw - 136px) / 2), 436px";
const promoClass =
  "mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#ff3fa4]/40 object-contain shadow-[0_0_28px_rgba(255,63,164,0.28)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ff3fa4]/85 hover:shadow-[0_0_40px_rgba(245,197,61,0.38)]";
---

<MainLayout title={`โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% จากยอดที่เข้าเกณฑ์`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`โปรโมชั่น ${BRAND_NAME} ทั้งหมด`} as="h1">
    <div class="flex flex-col gap-10">
      <p>
        หน้านี้รวมภาพโปรโมชั่นที่ <strong>{BRAND_NAME}</strong> เปิดให้สมาชิกตรวจสอบสิทธิ์ตามกิจกรรมที่เว็บไซต์เปิดให้บริการ โดยเน้นโบนัสคืนยอดเสียและกิจกรรมแนะนำเพื่อน รายละเอียดของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว
        สมาชิก Login เพื่อตรวจสอบยอดที่เข้าเกณฑ์ รอบคำนวณ และสถานะโบนัสผ่านบัญชีได้โดยตรง <strong>แต่ละโปรโมชั่นอาจมีเงื่อนไขเกี่ยวกับประเภทเกม รอบรับสิทธิ์ และการใช้โบนัสแตกต่างกัน</strong> จึงควรอ่านรายละเอียดก่อนกดรับทุกครั้ง
      </p>

      <div class="mx-auto grid w-full max-w-4xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt={`ภาพโปรโมชั่นของ ${BRAND_NAME} โทนชมพูบานเย็น-ดำ ด้านซ้ายเป็นหญิงสาวผมสั้นสีขาวเงินสวมที่คาดผมหูกระต่ายชมพู ชุดชมพู-ขาวผูกโบว์ ต่างหูรูปหัวใจ ขยิบตาและยื่นมือออกมาทางซ้าย มุมขวาบนเป็นเหรียญตราโลโก้ ${BRAND_NAME} รูปหญิงสาวผมน้ำตาลหูกระต่ายชมพู คู่กับไพ่เอซและวงล้อเลข 777 รอบภาพมีเหรียญทอง ชิปเดิมพันทรงกลมชมพู-ขาวติดมงกุฎทอง ไพ่ และหัวใจชมพูเรืองแสงลอยกระจาย ด้านล่างเป็นแท่นทอง กลางภาพเป็นคำว่า โปรโมชั่น ตัวอักษรสามมิติสีชมพูขนาดใหญ่ใต้มงกุฎทอง และใต้ลงมาบนแผ่นป้ายสีเข้มเขียนว่า คืนยอดเสีย คู่กับตัวเลข 0.3% ตัวโต`}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoReferral}
          alt={`ภาพโปรโมชั่นของ ${BRAND_NAME} โทนชมพูบานเย็น-ดำชุดเดียวกัน ด้านซ้ายเป็นหญิงสาวผมสั้นสีขาวเงินสวมที่คาดผมหูกระต่ายชมพูและชุดชมพู-ขาว ยื่นแขนออกมาโดยมีริบบิ้นชมพูพลิ้วอยู่ด้านหลัง มุมขวาบนเป็นเหรียญตราโลโก้ ${BRAND_NAME} รูปหญิงสาวผมน้ำตาลหูกระต่ายชมพูคู่กับวงล้อเลข 777 ด้านขวาเป็นไพ่เอซโพดำกับเอซโพแดง มุมขวาล่างเป็นชิปเดิมพันทรงกลมชมพูติดมงกุฎทอง รอบภาพมีเหรียญทองลอยกระจาย กลางภาพเป็นคำว่า โปรโมชั่น ตัวอักษรสามมิติสีชมพูใต้มงกุฎทอง และใต้ลงมาบนแผ่นป้ายสีเข้มเขียนว่า แนะนำเพื่อน และ โบนัส คู่กับตัวเลข 0.8% ตัวโต`}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#b3006a] bg-gradient-to-b from-[#ffd1ea] via-[#ff6cbb] to-[#ff3fa4] px-10 py-3.5 text-lg font-black text-[#2b0019] shadow-[0_0_14px_rgba(255,63,164,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
