---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

// ⚠️ ดรอปนี้ (mtime 2026-10-08) มีสไลด์ที่ "ใช้ได้" แค่สองใบ ยืนยันจาก brand-spec §7
// ซึ่งอ่านป้ายบนภาพจริง ไม่ใช่เชื่อชื่อไฟล์หรือคอมเมนต์ของรอบก่อน:
//   slide1.png — ป้ายแดงข้อความ "คืนยอดเสีย 0.3%" (นางแบบอยู่ขวา โลโก้ซ้ายบน)
//   slide2.png — ป้ายแดงข้อความ "แนะนำเพื่อน 0.8%" (นางแบบอยู่ซ้าย โลโก้ขวาบน)
//   slide3.png / slide4.png — โปสเตอร์ของแบรนด์ก่อน (29 ก.ย. เก่ากว่าดรอปนี้)
//     ห้าม import กลับมาเด็ดขาด และห้ามลบไฟล์ทิ้งเพราะเป็นอินเวนทอรีของรอบถัดไป
// ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้วและ verify-build จะแดง
// (banner2/banner3 ใน src/assets ก็เก่ากว่าดรอปนี้ = อาร์ตเวิร์กแบรนด์ก่อน ห้าม import)
// ส่วน banner1 / banner1-mobile / og.png เป็นของ MainLayout ห้าม import จากหน้านี้
// ชื่อตัวแปรตั้งตามข้อความบนภาพ ไม่ใช่ตามเลขไฟล์ เพื่อไม่ให้รอบหน้าสลับผิดอีก
import promoCashback from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้น ๆ "หนึ่งย่อหน้า ประมาณสี่บรรทัด" คือ
// โควตาตัวหนังสือทั้งหมดของหน้านี้, กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อย
// และห้ามเพิ่มย่อหน้า เพราะตัวโปสเตอร์ระบุเปอร์เซ็นต์โบนัสไว้ด้วยตัวอักษรขนาดใหญ่
// อยู่แล้ว การพิมพ์ซ้ำด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ เป้าหมาย h1x1 h2x0 h3x0
//
// สไลด์รอบนี้เป็น **แนวนอน 600x250 ทั้งคู่** (วัดจาก PNG header — รอบก่อนเป็นจัตุรัส
// 600x600 จึงอย่าลอก widths/sizes ข้ามรอบ) วางเป็นกริดสองคอลัมน์ คุมความกว้างรวม
// ที่ max-w-4xl (896px) ทำให้ช่องละ ~436px ไม่ต้องอัปสเกลเกินขนาดไฟล์ต้นทาง
// widths หยุดที่ 600 ตามความกว้างจริงของไฟล์ และคุมภาพต่อใบไว้ที่ max-w-[600px]
// สองใบพอดีหนึ่งแถว เรียง คืนยอดเสีย 0.3% ก่อน แนะนำเพื่อน 0.8% ตามลำดับของบรีฟ
// (docx H3 #4 แล้วค่อย #5) ซึ่งรอบนี้แปลว่า slide1 มาก่อน slide2
// sizes คิดจากความกว้างที่ถูกวาดจริง: px-4 ของ section (16px/ข้าง) + p-8 ของการ์ด
// (32px/ข้าง, เป็น p-10 = 40px ที่ md ขึ้นไป) + gap-6 (24px) ระหว่างสองคอลัมน์
// LCP คือ hero ใน MainLayout ไม่ใช่สองรูปนี้ จึง loading="lazy" fetchpriority="low"
//
// Announcement รอบนี้หมุนมาเป็น Announcement3 ทั้งเว็บ (แบรนด์ก่อนใช้ตัว *Premium)
// — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และทุกหน้า
// ก็เรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกัน
//
// พาเลตต์รอบนี้ (brand-spec §3) เป็นแบรนด์ **สามสี: แดงนำ / เขียวมรกตรอง / ทองคั่น**
// บนพื้นเกือบดำอมแดง — แดงแบรนด์ #c41115 (พื้นปุ่มหลัก ออรา) · แดงสว่าง #e0201f
// (ปลายสว่างของไล่เฉด ห้ามสว่างกว่านี้เพราะตัวอักษรขาวเหลือ 4.8:1 พอดี AA) ·
// แดงลึก #7a0505 (ปลายมืด) · ทองแบรนด์ #d9a521 (ขอบ เส้นคั่น ออราทอง) ·
// ทองอ่อน #ffdf91 (<strong> ไฮไลต์) · ทองลึก #8c6410 (ขอบปุ่มทอง) ·
// เนื้อความ #f6e3cf (มาจาก BRAND_TEXT ที่ <html> และการ์ด ContentBox ตั้งให้แล้ว
// จึงไม่ระบุสีที่ย่อหน้า) ปุ่มสมัครเป็น PRIMARY จึงถมไล่เฉดแดงตามบทบาทในสเปก
// พร้อมขอบทองลึกเป็นเส้นโลหะ และเงาของรูปเป็นเงาทอง rgba(217,165,33,*)
// ชุดทอง-เงินโครเมียมบนน้ำตาลเกือบดำของแบรนด์ก่อนออกครบแล้ว ทั้งคลาส Tailwind
// raw hex และ rgba() (ค่าเดิมอยู่ใน brand-spec §3 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep
// หาสีแบรนด์เก่าเจอ false positive) ห้ามนำกลับมา
//
// แบรนด์นี้เป็น **เว็บคาสิโนไลฟ์ 24 ชม. + สล็อต + บอล** ไม่ใช่เว็บหวย — ศัพท์หมวด
// ลอตเตอรีทั้งชุดและคำขายของของแบรนด์ก่อนห้ามหลงเหลือ (รายการเต็มอยู่ใน
// brand-spec §2 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำต้องห้ามเจอ false positive)
// ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% / 0.8% / 24 ชั่วโมง /
// 3 ขั้นตอน ห้ามแต่งยอดฝากขั้นต่ำ ชื่อผู้ให้บริการ ชื่อธนาคาร ค่า RTP เลขใบอนุญาต
// หรือวันหมดเขตแคมเปญ และต้องคงคำกำกับของบรีฟไว้ว่าโบนัสของแต่ละเกมกำหนดวิธี
// คำนวณและเงื่อนไขไม่เหมือนกัน จึงควรอ่านรายละเอียดก่อนรับสิทธิ์
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 155
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `รวมภาพโปรโมชั่นของ ${BRAND_NAME} ทั้งคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ที่คำนวณจากยอดเข้าเกณฑ์ ควร Login ตรวจสอบประเภทเกม รอบตัดยอด และเงื่อนไขก่อนกดรับสิทธิ์`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่น ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});

// ความกว้างที่ถูกวาดจริงของแต่ละช่องในกริดสองคอลัมน์ (ดูคอมเมนต์ sizes ด้านบน)
const promoSizes = "(max-width: 639px) calc(100vw - 96px), (max-width: 767px) calc((100vw - 120px) / 2), (max-width: 1007px) calc((100vw - 136px) / 2), 436px";
const promoClass =
  "mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#d9a521]/35 object-contain shadow-[0_0_28px_rgba(217,165,33,0.30)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#d9a521]/80 hover:shadow-[0_0_40px_rgba(255,223,145,0.45)]";
---

<MainLayout title={`โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% สำหรับยอดที่เข้าเกณฑ์`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`โปรโมชั่น ${BRAND_NAME} ทั้งหมด`} as="h1">
    <div class="flex flex-col gap-10">
      <p class="text-left text-base leading-relaxed">
        หน้านี้รวมภาพโปรโมชั่นที่ <strong class="text-[#ffdf91]">{BRAND_NAME}</strong> เปิดให้สมาชิกตรวจสอบสิทธิ์ตามแคมเปญของแต่ละช่วง ทั้งคืนยอดเสียและแนะนำเพื่อน โดยรายละเอียดของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว
        ระบบจะนำยอดที่เข้าเกณฑ์มาคำนวณก่อนแสดงจำนวนโบนัสที่รับได้ <strong class="text-[#ffdf91]">โบนัสของแต่ละเกมอาจกำหนดวิธีคำนวณ ประเภทเกมที่ร่วมรายการ และรอบตัดยอดไม่เหมือนกัน</strong> จึงควร Login อ่านรายละเอียดและเงื่อนไขล่าสุดก่อนกดรับสิทธิ์ทุกครั้ง
      </p>

      <div class="mx-auto grid w-full max-w-4xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt={`ภาพโปรโมชั่นแนวนอนของ ${BRAND_NAME} พื้นฉากจีนสีแดงสลับเขียวมรกต มีกล่องของขวัญสีแดงผูกโบว์และเหรียญทองจีนกองอยู่ มุมบนซ้ายเป็นโลโก้ ${BRAND_NAME} คู่กับเทพเจ้าโชคลาภ กลางภาพเป็นคำว่า โปรโมชั่น ตัวหนาสีขาวตัดขอบแดงใต้มงกุฎทองดวงเล็ก ถัดลงมาเป็นป้ายแดงคาดข้อความ คืนยอดเสีย 0.3% ด้านขวาเป็นหญิงสาวผมยาวสีขาวเงินสวมสูทแดงติดกระดุมทอง เอียงศีรษะพิงมือ`}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoReferral}
          alt={`ภาพโปรโมชั่นแนวนอนของ ${BRAND_NAME} ชุดเดียวกัน ฉากซุ้มประตูจีนสีแดงสลับเขียวมรกตมีเหรียญทองจีนปลิวอยู่ ด้านซ้ายเป็นหญิงสาวผมยาวสีขาวเงินสวมชุดแดงติดกระดุมทอง ถือไพ่สองใบและชี้มือมาทางผู้ชม กลางภาพเป็นคำว่า โปรโมชั่น ตัวหนาสีขาวตัดขอบแดงใต้มงกุฎทอง ถัดลงมาเป็นป้ายแดงคาดข้อความ แนะนำเพื่อน 0.8% มุมบนขวาเป็นโลโก้ ${BRAND_NAME} คู่กับเทพเจ้าโชคลาภ`}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#8c6410] bg-gradient-to-b from-[#e0201f] via-[#c41115] via-55% to-[#7a0505] px-10 py-3.5 text-lg font-black text-white shadow-[0_0_14px_rgba(196,17,21,0.55)] transition-transform hover:scale-105">
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
