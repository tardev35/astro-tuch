---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";

import { Picture } from "astro:assets";

// ดรอปอาร์ตเวิร์กของ PGW44 คือ 2026-09-27 และมีสไลด์ที่ใช้ได้สองใบเท่านั้น:
//   slide1.png — โปสเตอร์ "โปรโมชั่น แนะนำเพื่อน โบนัส 0.8%"
//   slide2.png — โปสเตอร์ "โปรโมชั่น คืนยอดเสีย โบนัส 0.3%"
// บทบาทของสองไฟล์นี้ "สลับกัน" ระหว่างแบรนด์มาแล้ว และเคยผูกกลับด้านมาก่อน
// อย่าเชื่อชื่อตัวแปรที่ตกทอดมาและอย่าคัดลอก import จากประวัติ git — รอบนี้ยึดตาม
// คำอธิบายอาร์ตเวิร์กใน brand-spec §6 ซึ่งระบุบทบาทของทั้งสองใบไว้ตรงกัน
//
// ไฟล์สไลด์ลำดับที่สามและสี่ใน src/assets เก่ากว่าดรอปรอบนี้ (2026-09-18 และ
// 2026-08-13) เป็นอาร์ตเวิร์กของลูกค้าเจ้าก่อน — ห้าม import กลับมา และห้ามลบทิ้ง
// เพราะเป็นอินเวนทอรี (ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้ว
// และ verify-build จะแดง) ถ้ามีสไลด์ใหม่เข้ามาให้เช็ก mtime เทียบดรอปก่อนเพิ่ม
// กริดรอบนี้จึงมีสองช่องเท่านั้น ห้ามเติมให้เต็มด้วยของเก่า
import promoReferral from "../assets/slide1.png";
import promoCashback from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";
//
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ: ContentBox title, ย่อหน้าเกริ่นสั้น ๆ หนึ่งย่อหน้า
// (ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมดของหน้านี้), กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม
// — ไม่มีหัวข้อย่อยและไม่มีย่อหน้าเพิ่ม เพราะตัวโปสเตอร์ระบุชื่อโปรและเปอร์เซ็นต์โบนัส
// ไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว เป้าหมาย h1x1, h2x0, h3x0
//
// สไลด์เป็นแบนเนอร์แนวนอน 600x400 จึงวางเป็นกริดสองคอลัมน์คุมความกว้างรวมที่ max-w-5xl
// (1024px) ทำให้ช่องละ ~488px ไม่ต้องอัปสเกลเกินขนาดไฟล์ต้นทาง widths หยุดที่ 600
// ตามความกว้างจริงของไฟล์ (candidate ที่ใหญ่กว่านั้นไม่มีของให้ครอป)
//
// Announcement หมุนจาก AnnouncementPremium มาเป็น Announcement2 ทั้งเว็บรอบนี้ —
// default message ของไฟล์นั้นถูกตั้งเป็นคอปปี้ของ PGW44 แล้ว และ index ก็เรียกแบบ
// bare เหมือนกัน จึงห้ามส่ง prop message มิฉะนั้นตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ PGW44 (ทองเหลืองสด + เขียวจัด บนพื้นเกือบดำ ตามโลโก้ที่ P เป็นดำขลิบทอง
// G เป็นทองไล่เฉด W เป็นเขียว และ 44 ไล่จากทองไปเขียว — คู่สีจริงสองเฉด
// ทองนำ เขียวตาม ไม่ใช่ทอง+โครเมียมแบบแบรนด์ก่อนหน้า):
// พื้นเพจ #050803 · ผิวการ์ด #0b1408 · ผิวยก #101a0b · ขอบเขียวลึก #1f5a16 ·
// ทองแบรนด์ #fde90e · ทองสว่าง #fff89a · ทองกลาง #f5c518 · ทองลึก #a86f02 ·
// หมึกเข้มบนพื้นทอง #10160a · เขียวสว่าง #5df53a · เขียวแบรนด์ #35d413 ·
// เขียวลึก #0c6d10 · เนื้อความ #e9f0dd (BRAND_TEXT) · เน้นใน strong #fbffe8
// ไล่เฉดประจำแบรนด์คือ from-[#fde90e] via-[#f5c518] to-[#35d413] ทองไหลไปเขียว
// ตามลำดับตัวอักษรในโลโก้ การ์ดโปสเตอร์ใบซ้ายได้ขอบทอง ใบขวาได้ขอบเขียว เพื่อให้
// กริดอ่านเป็นคู่สีทอง+เขียว ตัวอักษรบนพื้นทองต้องเป็น #10160a ห้ามใช้ขาว
// ชุดทอง+โครเมียมของแบรนด์ก่อนหน้า (#fdd32a #ffe27a #ffeeb8 #c8920a #15110a
// #c2c8d0 #f2f4f7 #8a9099 #12100a #2a2110 #4a3a12 #080602 #efe6d2 #fff8e1
// rgba(253,211,42,*) rgba(194,200,208,*)) ถูกแทนครบทุกจุดแล้ว
//
// PGW44 เป็นเว็บสล็อตล้วน บรีฟระบุแค่ค่ายสล็อตย่อย เมนูหมวดหมู่ โบนัสแนะนำเพื่อน
// 0.8% โบนัสคืนยอดเสีย 0.3% และช่องทางไลน์ 24 ชั่วโมง — ไม่ได้ระบุชื่อค่ายเกม
// ชื่อเกม ค่า RTP ใบอนุญาต ชื่อธนาคาร ฝากถอนออโต้ เครดิตฟรี บาคาร่า/คาสิโนสด
// หรือหวย จึงห้ามเขียนเพิ่มในหน้านี้
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 158
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "รวมโปรโมชั่น PGW44 ทั้งโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% ตรวจสอบยอดที่เข้าเกณฑ์ รอบคำนวณ และขั้นตอนรับสิทธิ์ของแต่ละรายการผ่านบัญชีสมาชิกก่อนกดรับ";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น PGW44",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoReferral.src,
});
---

<MainLayout title="โปรโมชั่น PGW44 แนะนำเพื่อน โบนัส 0.8% และคืนยอดเสีย โบนัส 0.3%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น PGW44" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#e9f0dd]">
        หน้านี้รวมภาพโปรโมชั่นที่ <strong class="text-[#fbffe8]">PGW44</strong> เปิดให้สมาชิกกดรับตามรายการและช่วงเวลาที่เว็บไซต์อัปเดตไว้ ทั้งโบนัสแนะนำเพื่อนและโบนัสคืนยอดเสีย โดยรายละเอียดของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว
        <strong class="text-[#fbffe8]">ยอดที่เข้าเกณฑ์ รอบคำนวณ และขั้นตอนรับสิทธิ์ของแต่ละรายการแตกต่างกัน</strong> จึงควรตรวจสอบรายละเอียดล่าสุดผ่านบัญชีสมาชิกอีกครั้งก่อนกดรับสิทธิ์ทุกครั้ง
      </p>

      <div class="mx-auto grid w-full max-w-5xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่นพื้นดำโทนเขียวสลับทอง ด้านซ้ายเป็นหญิงสาวผมยาวสีเข้มสวมชุดสูทขาว ชี้นิ้วชี้ทั้งสองข้างมาที่ข้อความ ด้านขวาเป็นโลโก้ PGW44 ใต้โลโก้เป็นข้อความไทยสีขาวขลิบทองว่า โปรโมชั่น ถัดลงมาเป็นแผ่นป้ายสีเขียวข้อความว่า แนะนำเพื่อน แล้วเป็นตัวอักษรทองขนาดใหญ่ว่า โบนัส 0.8% ตามขอบภาพมีเหรียญทองและชิปคาสิโนเขียวสลับทองกองซ้อนกันอยู่"
          loading="lazy"
          fetchpriority="low"
          widths={[340, 480, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), 488px"
          class="mx-auto h-auto w-full rounded-xl border border-[#fde90e]/55 object-contain shadow-[0_10px_30px_rgba(3,6,2,0.80)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fff89a]/75 hover:shadow-[0_15px_40px_rgba(253,233,14,0.40)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่นชุดเดียวกัน พื้นดำโทนเขียวสลับทอง ด้านซ้ายเป็นหญิงสาวผมยาวสีเข้มสวมชุดสูทขาว ยกมือข้างหนึ่งชี้ไปทางข้อความ ด้านขวาเป็นโลโก้ PGW44 ถัดลงมาเป็นข้อความไทยสีขาวขลิบทองว่า โปรโมชั่น แผ่นป้ายสีเขียวข้อความว่า คืนยอดเสีย แล้วเป็นตัวอักษรทองขนาดใหญ่ว่า โบนัส 0.3% ขอบซ้ายมีแท่งทองประทับรูปมงกุฎ ด้านล่างมีเหรียญทองและชิปคาสิโนสีเข้มวางกระจายอยู่"
          loading="lazy"
          fetchpriority="low"
          widths={[340, 480, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), 488px"
          class="mx-auto h-auto w-full rounded-xl border border-[#35d413]/55 object-contain shadow-[0_10px_30px_rgba(3,6,2,0.80)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#5df53a]/75 hover:shadow-[0_15px_40px_rgba(53,212,19,0.35)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก PGW44"
          class="flex items-center justify-center rounded-lg border border-[#fff89a]/60 bg-gradient-to-r from-[#fde90e] via-[#f5c518] to-[#35d413] px-10 py-3.5 text-lg font-black text-[#10160a] shadow-[0_0_15px_rgba(253,233,14,0.50)] transition-transform hover:scale-105">
          สมัครสมาชิก PGW44
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
