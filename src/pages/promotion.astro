---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

// ดรอปนี้ (2026-10-18, brand-spec §4) มี **สไลด์ที่ใช้ได้ใบเดียว** ค่าข้างล่างนี้มาจาก
// การเปิดดูรูปจริงด้วยตา ไม่ใช่จากเลขไฟล์ ถ้ารอบหน้าเจอความขัดแย้งอีก
// **ให้เชื่อข้อความที่พิมพ์อยู่บนรูป**:
//   slide1.png — จัตุรัส 600x600 ที่พิมพ์ **ทั้งสองโปรโมชั่นไว้ในรูปเดียว** แบ่งเป็น
//                สองแผงซ้าย-ขวา แผงซ้าย "โปรโมชั่น / คืนยอดเสีย 0.3%" แผงขวา
//                "โปรโมชั่น / แนะนำเพื่อน / โบนัส 0.8%" ทั้งคู่มีโลโก้ของแบรนด์นี้อยู่
//                เหนือหัว — รูปเดียวจึงครอบคลุมทั้งหน้าอยู่แล้ว
//   slide2.png — **อาร์ตเวิร์กของแบรนด์ก่อน มีเวิร์ดมาร์กของแบรนด์นั้นพิมพ์อยู่บนรูป**
//                ถ้าหลุดคือโชว์โลโก้คู่แข่งบนเว็บลูกค้า **ห้าม import**
//   slide3.png / slide4.png — โปสเตอร์ของแบรนด์เก่ากว่านั้น ห้าม import
// ⚠️ ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้ว และ verify-build จะแดง
// **ห้ามลบไฟล์ทั้งสามทิ้ง** — เป็นอินเวนทอรีของรอบถัดไป แค่ห้าม import
// (banner2 / banner3 ใน src/assets เป็นอาร์ตเวิร์กของแบรนด์ก่อนๆ ห้าม import ส่วน
// banner1 / banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักชื่อไว้เอง
// — ห้ามอ้างจากหน้านี้) รอบนี้จึง **ไม่มี article illustration** เลย
// ชื่อตัวแปรตั้งตามสิ่งที่พิมพ์อยู่บนภาพ ไม่ใช่ตามเลขไฟล์ เพื่อไม่ให้รอบหน้าสลับผิด
import promoPoster from "../assets/slide1.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้นๆ ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมด
// ของหน้านี้, ภาพโปรโมชั่น, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อยและห้ามเพิ่มย่อหน้า
// เพราะตัวโปสเตอร์ระบุเปอร์เซ็นต์โบนัสไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว การพิมพ์ซ้ำ
// ด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ บรีฟรอบนี้ (src/assets/content.txt)
// ไม่มีส่วน SUB-PAGES เลย ย่อหน้าทุกย่อหน้าที่เคยอยู่บนหน้านี้จึงเป็นของที่รีแบรนด์
// รอบก่อนๆ แต่งขึ้นเอง — รอบนี้คงไว้เพียงย่อหน้าเกริ่นเดียว และเขียนขึ้นใหม่จากบรีฟ
// ไม่ใช่แก้ทับประโยคของแบรนด์ก่อน
//
// ⚠️ รอบนี้มีรูปใบเดียว จึงเป็น **คอลัมน์เดียวจัดกลาง** ไม่ใช่กริดสองคอลัมน์
// บิตแมปจริงกว้าง 600px → widths หยุดที่ 600 และคุมภาพที่ max-w-[600px]
// sizes คิดจากความกว้างที่ถูกวาดจริง: section px-4 (16px/ข้าง) + การ์ด p-8
// (32px/ข้าง, เป็น p-10 = 40px ที่ md ขึ้นไป) → ใต้ 696px กว้าง 100vw-96px
// ตั้งแต่ 696px ขึ้นไปชนเพดาน 600px พอดี
// LCP คือ hero ใน MainLayout ไม่ใช่รูปนี้ จึง loading="lazy" fetchpriority="low"
// decoding="async" และ quality={80} ตัวเดียวทั้ง avif/webp — ห้ามจูนแยกฟอร์แมต
// (tools/avif-quality-service.mjs ลดให้เป็น avif ที่เหมาะสมเอง)
//
// Announcement รอบนี้หมุนมาเป็น AnnouncementPremium ทั้งเว็บ (brand-spec §3)
// orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว และทุกหน้า
// ก็เรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกัน
// ระหว่างหน้า
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ทองไทยนำ แดงมังกรรอง บนพื้นดำอมแดง**
// bg.json ของดรอปนี้เป็น {"mode":"color","color":"#1a0505"} ลำดับผิว:
// #2b100f ยก (การ์ด ContentBox) / #200a09 กลาง / #140505 จม / #1a0505 พื้นเพจ
// ทองแบรนด์ #f0b429 ถือขอบรูปและออรา · ทองสว่าง #ffdc8c เป็นต้นสว่างของพื้นถมปุ่ม
// และเป็นสีไฮไลต์ของ <strong> ในเนื้อความ (สงวนไว้งานเดียวนี้ ไม่ใช้สีอื่นเลย) ·
// แดงสว่าง #ff6b6e เป็นขอบตอน hover · ทองลึก #9a6c0c เป็นขอบปุ่มถมทอง ·
// หมึกบนพื้นถมทองเป็น #1a0505 (9.7:1 บน #f0b429 และ 13:1 บน #ffdc8c) ·
// เนื้อความ #f5ece0 มาจาก BRAND_TEXT ที่ <html> และการ์ด ContentBox ตั้งให้แล้ว
// ย่อหน้าจึงไม่ประกาศสีของตัวเอง
// · <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ
// ถ้าเปิด/ปิดกลางคำ บรรทัดจะตัดกลางคำ
// ⚠️ #d30304 #a00203 #4a0202 #9a6c0c ห้ามถือตัวอักษรทุกขนาด ใช้ได้เฉพาะเส้น ขอบ
// ออรา และพื้นถม · ออราในไฟล์นี้ใช้ rgba(240,180,41,α) และ rgba(211,3,4,α) เท่านั้น
// ⚠️ กับดักของรอบนี้คือ **แดง**: สามแบรนด์ก่อนหน้าเป็นแดงทั้งหมด "เจอแดง" จึงไม่ได้
// แปลว่าเป็นของรอบนี้ ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน brand-spec §2 (ค่าของ
// แบรนด์เก่าไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive)
// สิ่งที่ทำให้รอบนี้ต่างจริงคือ **ทองนำแดงรอง** และรอบนี้ **ไม่มีม่วง ไม่มีชมพู
// ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว ไม่มีส้ม** (เงินอมฟ้า #cfd9e6 เป็นสีตัวอักษรรอง
// เท่านั้น ไม่ใช่สีระบบ และหน้านี้ไม่ได้ใช้)
//
// ⚠️ แบรนด์นี้เป็น **เว็บเกมสล็อตล้วน** ไม่ใช่หมวดอื่นใดทั้งสิ้น (สองหน้าของหมวด
// ที่แบรนด์ก่อนๆ เคยเปิดจอดอยู่ใน src/pages-disabled/ ไม่มี route — ลิงก์ค้าง
// จะเป็น href ตายที่ทำให้บิลด์แดง) คำขายของของแบรนด์ก่อนและศัพท์หมวดอื่นที่บรีฟ
// ไม่ได้เอ่ยห้ามหลงเหลือ (รายการเต็มอยู่ใน brand-spec §7 ไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep เจอ false positive)
// ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% / 0.8% / 24 ชั่วโมง — ห้ามแต่งยอดฝากขั้นต่ำ
// ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP เลขใบอนุญาต จำนวนสมาชิก หรือปีก่อตั้ง และต้องคง
// ประโยคกำกับของบรีฟ (content.txt บรรทัด 8) ไว้ว่า **สิทธิ์ที่ได้รับอาจขึ้นอยู่กับ
// ประเภทบัญชี ยอดเดิมพัน ระยะเวลาของแคมเปญ และข้อกำหนดของแต่ละโปรโมชั่น**
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) หน้านี้ยาว 158 อักขระ
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `รวมภาพโปรโมชั่นของ ${BRAND_NAME} ทั้งคืนยอดเสีย 0.3% และแนะนำเพื่อน โบนัส 0.8% สอบถามอัตราที่ได้รับ วิธีรับสิทธิ์ และเงื่อนไขการใช้งานจากเจ้าหน้าที่ได้ 24 ชั่วโมง`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่น ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoPoster.src,
});

// ความกว้างที่ถูกวาดจริงของรูปเดียวที่จัดกลาง (ดูคอมเมนต์ sizes ด้านบน)
const promoSizes = "(max-width: 695px) calc(100vw - 96px), 600px";
---

<MainLayout title={`โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน โบนัส 0.8%`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`โปรโมชั่น ${BRAND_NAME} ทั้งหมด`} as="h1">
    <div class="flex flex-col gap-10">
      <p>
        หน้านี้รวมภาพประกาศโปรโมชั่นของ <strong class="text-[#ffdc8c]">{BRAND_NAME} ที่เปิดให้ผู้ใช้งานตรวจสอบรายละเอียดบริการได้ในที่เดียว</strong> ทั้งรายการคืนยอดเสียและโบนัสจากการแนะนำเพื่อน โดยรายละเอียดของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว
        สิทธิ์ที่ได้รับอาจขึ้นอยู่กับประเภทบัญชี ยอดเดิมพัน ระยะเวลาของแคมเปญ และข้อกำหนดของแต่ละโปรโมชั่น <strong class="text-[#ffdc8c]">
          ก่อนเข้าร่วมควรตรวจสอบอัตราที่ได้รับ วิธีรับสิทธิ์ และเงื่อนไขการใช้งานจากช่องทางทางการให้ครบถ้วน
        </strong> รวมถึงอ่านเงื่อนไขก่อนดำเนินการทุกครั้ง เพื่อหลีกเลี่ยงความเข้าใจคลาดเคลื่อนเกี่ยวกับยอดโบนัสหรือการถอนเงิน
      </p>

      <div class="mx-auto w-full max-w-[600px]">
        <Picture
          src={promoPoster}
          alt={`ภาพโปรโมชั่นของ ${BRAND_NAME} เป็นภาพจัตุรัสที่แบ่งเป็นสองแผงซ้ายขวา ทั้งสองแผงมีพื้นดำ มีเหรียญทองจีนทรงกลมเจาะรูสี่เหลี่ยมปลิวกระจายเต็มภาพ ผ้าซาตินแดงพลิ้ว ไพ่โพดำและโพแดง และกองชิปสีทองดำแดงเรียงอยู่ขอบล่าง เหนือหัวของแต่ละแผงเป็นโลโก้ ${BRAND_NAME} ตัวอักษรสามมิติผิวโครเมียมเงินอมฟ้าขอบแดง ต่อด้วยเลข 168 สีแดงสด บนริบบิ้นแดงและกองเหรียญทอง แผงซ้ายเป็นชายหนุ่มผมดำในเสื้อเชิ้ตดำยืนเคียงหญิงสาวผมยาวดำในชุดดำ ใต้ลงมาเป็นคำว่า โปรโมชั่น ตัวอักษรทองสามมิติขนาดใหญ่ และแถบป้ายดำขอบลายทองเขียนว่า คืนยอดเสีย คู่กับตัวเลข 0.3% ตัวโตเต็มป้าย ส่วนแผงขวาเป็นหญิงสาวผมยาวดำในชุดแดงยืนเคียงชายหนุ่มในเสื้อดำ ใต้ลงมาเป็นคำว่า โปรโมชั่น ตัวอักษรทองเช่นกัน และแถบป้ายดำเขียนว่า แนะนำเพื่อน กับ โบนัส คู่กับตัวเลข 0.8% ตัวโตเต็มป้าย`}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes={promoSizes}
          class="mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#f0b429]/50 object-contain shadow-[0_0_28px_rgba(240,180,41,0.3)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ff6b6e]/85 hover:shadow-[0_0_40px_rgba(211,3,4,0.4)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#9a6c0c] bg-gradient-to-b from-[#ffdc8c] to-[#f0b429] px-10 py-3.5 text-lg font-black text-[#1a0505] shadow-[0_0_14px_rgba(240,180,41,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
