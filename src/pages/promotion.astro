---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

// ดรอปรอบนี้ (สล็อต168 2026-10-23, brand-spec §1) มีสไลด์ที่ใช้ได้ **สองใบ** และชื่อ
// ตัวแปรตั้งตามข้อความที่พิมพ์อยู่บนภาพจริง (เปิดบิตแมปอ่านเองแล้วรอบนี้) ไม่ใช่ตาม
// เลขไฟล์ — ถ้ารอบหน้าเจอความขัดแย้ง **ให้เชื่อข้อความบนรูป**:
//   slide1.png (mtime 2026-10-23 22:44, ดรอปนี้) — โปสเตอร์ "โปรโมชั่น / คืนยอดเสีย 0.3%"
//   slide2.png (mtime 2026-10-23 22:44, ดรอปนี้) — โปสเตอร์ "โปรโมชั่น / แนะนำเพื่อน 0.8%"
//   slide3.png / slide4.png (mtime 2026-09-29 = คนละดรอป) — โปสเตอร์ของแบรนด์
//     คนละราย **ห้าม import** (ถอดออกไปหลายรอบแล้ว อย่าดึงกลับ)
//   banner2.png / banner3.png (mtime 2026-10-23 18:43 = ของรอบก่อน) — **ห้าม import**
//     รอบนี้ไม่มี "รูปประกอบบทความ" เลย (brand-spec §1)
// ⚠️ การจับคู่พลิกไปมาระหว่างดรอป เพราะ uploader เขียนทับ slide1/slide2 ทุกครั้ง
// เลขไฟล์จึงไม่มีความหมายข้ามแบรนด์ ต้องเปิดบิตแมปดูทุกรอบ — **รอบก่อนจับคู่กลับทาง
// (promoCashback = slide2) และรอบนี้ตรวจจากภาพแล้วว่าเป็น slide1**
// ⚠️ eager import = emit ลง dist/ ต่อให้ไม่ได้ render และ verify-build จะแดง
// การ import ไฟล์เก่าคือการส่งรูปของลูกค้ารายอื่นขึ้นเว็บนี้
// **ห้ามลบไฟล์เก่าทิ้ง** — เป็นอินเวนทอรีของรอบถัดไป แค่ห้าม import
// (banner1 / banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักชื่อไว้เอง —
// ห้ามอ้างจากหน้านี้) รอบนี้หน้านี้จึงมีเฉพาะสไลด์สองใบ
import promoCashback from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้นๆ ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมด
// ของหน้านี้, กริดภาพโปรโมชั่น, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อยและห้ามเพิ่มย่อหน้า
// เพราะโปสเตอร์ระบุชื่อรายการและเปอร์เซ็นต์ของตัวเองด้วยตัวอักษรขนาดใหญ่อยู่แล้ว
// การพิมพ์ซ้ำด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ บรีฟรอบนี้
// (src/assets/content.txt) ไม่มีส่วน SUB-PAGES เลย (จบที่บรรทัด 23) ย่อหน้าทุกย่อหน้า
// ที่เคยอยู่บนหน้านี้จึงเป็นของที่รีแบรนด์รอบก่อนๆ แต่งขึ้นเอง — รอบนี้คงไว้เพียงย่อหน้า
// เกริ่นเดียว และเขียนขึ้นใหม่จากบรีฟ (content.txt บรรทัด 7-12) ไม่ใช่ find-and-replace
// ทับประโยคของรอบก่อน
//
// ลำดับในกริดตามลำดับของบรีฟ: คืนยอดเสีย 0.3% (content.txt บรรทัด 9-10) มาก่อน
// แนะนำเพื่อน 0.8% (บรรทัด 11-12) → promoCashback (slide1) อยู่ช่องแรก
// ⚠️⚠️ **บิตแมปจริงของดรอปนี้คือ 375x600 แนวตั้ง** (วัดจาก IHDR ของไฟล์เองรอบนี้)
// ความกว้างสูงสุดคือ 375 widths จึงหยุดที่ 375 และคุมที่ max-w-[375px]
// **ให้วัดใหม่ทุกรอบจากไฟล์จริง อย่าเชื่อสัดส่วนของรอบก่อน**
// sizes คิดจากความกว้างที่ถูกวาดจริง: section px-4 (16px/ข้าง) + การ์ด p-8
// (32px/ข้าง, เป็น p-10 = 40px ที่ md ขึ้นไป) + gap-6 ระหว่างคอลัมน์ (24px)
//   ใต้ 640px = คอลัมน์เดียว → 100vw-96px
//   640-767px = สองคอลัมน์ p-8 → 50vw-60px
//   768-885px = สองคอลัมน์ p-10 → 50vw-68px
//   ตั้งแต่ 886px ขึ้นไปชนเพดาน 375px (การ์ดเองกว้างสุด 1400px จึงยังไม่ชน
//   เพดานของการ์ดก่อน)
// LCP คือ hero ใน MainLayout ไม่ใช่รูปพวกนี้ จึง loading="lazy" fetchpriority="low"
// decoding="async" และ quality ตัวเดียวทั้ง avif/webp — ห้ามจูนแยกฟอร์แมต
// (tools/avif-quality-service.mjs ย่อฝั่ง avif ให้เองที่ x0.65)
//
// quality={64} ไม่ใช่ 80 ตามปกติ: สไลด์ทั้งสองเป็นภาพถ่ายคนในสตูดิโอพื้นดำสนิท บวก
// ตัวอักษรไทยสามมิติผิวมันเงาที่มีไฮไลต์และขอบคมทับอยู่ด้านบน ซึ่งเป็นเคสที่ AVIF
// ทำได้แย่ที่สุด ที่ quality=80 ไฟล์ AVIF มีโอกาสออกมา **ใหญ่กว่า** WebP ที่เป็น
// fallback ของตัวเอง เบราว์เซอร์ที่รองรับ AVIF จะหยิบไฟล์ที่หนักกว่าไปใช้ และ
// verify-build.mjs ทำให้ build แดงด้วยเหตุนี้ตรงๆ · ทางแก้คือ quality ที่ **ต่ำลง**
// ไม่ใช่สูงขึ้น · ค่าเดียวกันนี้ต้องใช้ที่ index.astro กับสไลด์คู่เดียวกัน
//
// Announcement รอบนี้หมุนมาเป็น Announcement5 ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ AnnouncementHuay จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้น
// เป็นคอปปี้ของแบรนด์นี้ไว้แล้ว และทุกหน้าเรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop
// message มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกันระหว่างหน้า
//
// ───────────────────────────────────────────────────────────────────────────
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) **ยังเป็นธีมมืดเหมือนรอบก่อน แต่คนละฮิวสิ้นเชิง**
// bg.json ของดรอปนี้คือ {"mode":"color","color":"#140000"} = **ดำอมแดงเข้มมาก**
// (รอบก่อนเป็น 000000 = ดำสนิท — อ่านจากไฟล์ทุกรอบ ห้ามเดา)
// **ห้าม "แก้" กลับไปเป็นการ์ดพื้นสว่าง**
// ลำดับผิว: พื้นเพจ #140000 / ผิวจม #0b0000 / ผิวการ์ด #1c0607 (ContentBox) /
// ผิวยก #2a0c0d · เส้นขอบ #551c1e (**ห้ามถือตัวอักษร**)
// หมึก #f0e6e4 = เนื้อความ (= BRAND_TEXT ที่ <html> และการ์ด ContentBox ตั้งให้แล้ว
// ย่อหน้าจึงไม่ประกาศสีของตัวเอง 16.0:1 บนผิวการ์ด) · หมึกรอง #c9b9b7 ·
// มุก #e3d6d4
// แดงสด #fb2e33 = สีของ <strong> ในเนื้อความ (5.1:1 บนการ์ด) และขอบ hover ของรูป
// ⚠️⚠️ **#cb0b0d #8a0608 #551c1e #7d6f6e ห้ามถือตัวอักษร** เป็นพื้นถม/ขอบ/ออรา
// เท่านั้น · ที่ถือตัวอักษรได้บนผิวมืดชุดนี้คือ #fb2e33 (5.1:1) · #f0e6e4 (16.0:1) ·
// #c9b9b7 (10.3:1) · #e3d6d4 (14.1:1)
// ปุ่ม CTA ของหน้านี้เป็น **PRIMARY = ไล่เฉดแดงลึก** #d81115 → #b00d11 → #8a0608
// บนหมึก **ขาว #ffffff** (5.2 / 7.2 / 10.0:1 ต่อ stop) ตรงกับปุ่มสมัครสมาชิกที่
// /contact-us /ทางเข้า /register
// 🚨🚨 **ห้ามใช้ #fb2e33 เป็น stop บนของปุ่ม** — ขาวบน #fb2e33 ได้แค่ 3.8:1 ตกเกณฑ์
// แผ่นไฮไลต์ด้านบนปุ่มจึงจำกัดที่ /12 (ผสมแล้วเหลือ ~4.8:1 ยังผ่าน AA)
// rgba() ที่อนุญาตรอบนี้: rgba(251,46,51,α) · rgba(203,11,13,α) · rgba(138,6,8,α) ·
// rgba(240,230,228,α) · rgba(227,214,212,α) · rgba(0,0,0,α)
// ⚠️⚠️ **รอบนี้ไม่มีทองไม่มีเหลืองเลยสักเฉด ไม่มีเงินเย็น ไม่มีน้ำเงิน/ฟ้า
// ไม่มีม่วง ไม่มีส้ม ไม่มีเขียว (ยกเว้น LINE green ที่หน้าอื่น) ไม่มีครีม ไม่มีเบจ**
// ทองคือฮิวนำของแบรนด์ขาออก (ชื่ออยู่ใน brand-spec §1) การปล่อยทองไว้ = ทั้งผิด
// พาเลตและหลงเหลือข้ามแบรนด์พร้อมกัน · มงกุฎเล็กในโลโก้เป็นรายละเอียด ~2% ของ
// อาร์ตเวิร์ก **ไม่ใช่สีแบรนด์** · วัสดุที่สองของรอบนี้คือ **มุกอุ่น (R>G>B)** ไม่ใช่เงินเย็น
// · สีผม เสื้อผ้า และสีผิวนักแสดงในอาร์ตเวิร์กเป็น **วัตถุในภาพ ไม่ใช่สี UI**
// · <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ
// ถ้าเปิด/ปิดกลางคำ บรรทัดจะตัดกลางคำ และ <strong> สองตัวห้ามติดกัน
// ⚠️ กับดักรอบนี้คือ **รอบนี้เป็นแบรนด์แดงจริง** การเจอ "แดง" ในไฟล์นี้จึงไม่พิสูจน์
// อะไรเลย ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน brand-spec §2 (ค่าของแบรนด์เก่าไม่
// พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive)
//
// ⚠️ แกนของแบรนด์รอบนี้คือ **เว็บสล็อต** (ระบบสล็อตเว็บนอก ค่ายแท้ถูกลิขสิทธิ์)
// **กลับทิศจากรอบก่อนซึ่งเป็นเว็บลอตเตอรี** — คำนิยามตัวเองของรอบก่อนทุกคำห้าม
// เหลือ โดยเฉพาะศัพท์หมวดนั้นทั้งชุด (brand-spec §5 ไม่พิมพ์ซ้ำที่นี่) หน้านี้รอบก่อน
// เขียนวลี "ประเภท<คำของหมวดเดิม>ที่เข้าร่วม" ซึ่งเป็นของค้างตรงตัว รอบนี้ใช้
// "ประเภทเกม" ตามบรีฟบรรทัด 8 · สองหน้าของหมวดเดิม **ปิดอยู่รอบนี้** (ย้ายไป
// src/pages-disabled/ แล้ว) หน้านี้จึงไม่มีอะไรให้ลิงก์ไป และโควตาปุ่มของหน้านี้
// คือปุ่มเดียวอยู่แล้ว
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 100% (เฉพาะในวลี
// "ไม่ผ่านเอเย่นต์100%") · 24ชม. **ไม่มี RTP ไม่มีจำนวนเกม/ค่าย ไม่มีจำนวนขั้นตอน
// ไม่มียอดขั้นต่ำเป็นตัวเลข ไม่มีอัตราจ่ายเป็นตัวเลข** ห้ามแต่งตัวเลขการเงิน
// ชื่อธนาคาร เลขใบอนุญาต ปีก่อตั้ง หรือจำนวนสมาชิก
// และต้องคงประโยคกำกับของบรีฟไว้ว่า **แต่ละรายการอาจมีข้อกำหนดเกี่ยวกับประเภทเกม
// ยอดที่นำมาคำนวณ รอบเวลารับเครดิต และเงื่อนไขการถอนเงินแตกต่างกัน ผู้ใช้งานควร
// ตรวจสอบประกาศล่าสุดก่อนเข้าร่วม** (content.txt บรรทัด 8)
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) ส่วนที่ไม่ใช่ชื่อแบรนด์ยาว 146 อักขระ จึงรับชื่อแบรนด์ได้
// ตั้งแต่ 4 ถึง 14 ตัวอักษร รอบนี้ชื่อยาว 8 ตัวอักษร รวมเป็น 154
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `โปรโมชั่น ${BRAND_NAME} รวมภาพสิทธิพิเศษสมาชิกไว้ที่เดียว ทั้งคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% แต่ละรายการมีเงื่อนไขต่างกัน ควรอ่านประกาศล่าสุดก่อนรับเครดิต`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่น ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});

// ความกว้างที่ถูกวาดจริงของแต่ละคอลัมน์ในกริดสองคอลัมน์ (ดูคอมเมนต์ sizes ด้านบน)
const promoSizes = "(max-width: 639px) calc(100vw - 96px), (max-width: 767px) calc(50vw - 60px), (max-width: 885px) calc(50vw - 68px), 375px";

const promoClass =
  "mx-auto h-auto w-full max-w-[375px] rounded-xl border border-[#551c1e] object-contain shadow-[0_8px_28px_rgba(0,0,0,0.7)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fb2e33] hover:shadow-[0_12px_40px_rgba(203,11,13,0.35)]";

// alt ทั้งสองเขียนจากบิตแมปของดรอปนี้ที่เปิดอ่านเองแล้ว (**375x600 แนวตั้ง** ทั้งคู่) —
// ฉากสตูดิโอพื้นดำสนิท ผู้หญิงผมยาวสีน้ำตาลเข้มขยิบตา สวมเสื้อกล้ามสีดำ ถือโทรศัพท์
// และชี้นิ้วไปที่จอ · ตัวอักษรไทยสามมิติสีขาวตัดขอบแดงว่า โปรโมชั่น · แคปซูลดำขอบแดง
// ระบุชื่อรายการเป็นสีขาว · ตัวเลขเปอร์เซ็นต์ตัวโตสีแดง
// ⚠️ alt คือ "ข้อความที่พิมพ์อยู่บนโปสเตอร์" เป็นหลัก — ตัวเลขท้าย alt ต้องตรงกับรูป
// ⚠️ ห้ามเรียกรูปคู่นี้ว่าภาพแนวนอนหรือภาพสี่เหลี่ยมจัตุรัส รอบนี้เป็น **แนวตั้ง**
// ⚠️ จุดที่ **ต่างกันจริงระหว่างสองใบ** และต้องเขียนให้ตรง:
//   slide1 (คืนยอดเสีย 0.3%) โลโก้อยู่ **มุมบนซ้าย** · จอโทรศัพท์แสดง **ตารางเกม
//     สล็อตหกช่อง** · นักแสดงใส่กางเกงยีนสีเข้ม
//   slide2 (แนะนำเพื่อน 0.8%) โลโก้อยู่ **มุมบนขวา** · จอโทรศัพท์แสดง **โลโก้ของ
//     แบรนด์** ไม่ใช่ตารางเกม
// ⚠️ ห้ามระบุว่าถือด้วยมือซ้ายหรือมือขวา — รอบก่อนเขียนไว้แล้วผิดสองรอบติด
// ⚠️ สีของวัตถุในรูป (ผมสีน้ำตาลเข้ม เสื้อกล้ามดำ กางเกงยีน) เป็นวัตถุในภาพ ไม่ใช่
// สีของแบรนด์ และไม่เข้ามาใน UI
// ⚠️ องค์ประกอบของอาร์ตเวิร์กแบรนด์ก่อนๆ ที่ต้องไม่หลงเหลือใน alt อยู่ครบใน
// brand-spec §1/§5 (ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive)
const altCashback = `โปสเตอร์โปรโมชั่นแนวตั้ง พื้นสตูดิโอสีดำสนิท มุมบนซ้ายเป็นโลโก้ ${BRAND_NAME} ตัวอักษรเจลสีแดงมันวาว กลางภาพเป็นผู้หญิงผมยาวสีน้ำตาลเข้มขยิบตา สวมเสื้อกล้ามสีดำกับกางเกงยีนสีเข้ม ถือโทรศัพท์ที่จอแสดงตารางเกมสล็อตหกช่องและชี้นิ้วไปที่จอ ครึ่งล่างเป็นตัวอักษรไทยสามมิติตัวโตสีขาวตัดขอบแดงอ่านว่า โปรโมชั่น ใต้ลงมาเป็นแคปซูลมนสีดำขอบแดงเขียนว่า คืนยอดเสีย เป็นตัวอักษรสีขาว ต่อท้ายด้วยตัวเลข 0.3% ตัวโตสีแดง`;

const altReferral = `โปสเตอร์โปรโมชั่นแนวตั้ง พื้นสตูดิโอสีดำสนิท มุมบนขวาเป็นโลโก้ ${BRAND_NAME} ตัวอักษรเจลสีแดงมันวาว กลางภาพเป็นผู้หญิงผมยาวสีน้ำตาลเข้มขยิบตา สวมเสื้อกล้ามสีดำ ยกโทรศัพท์ที่จอแสดงโลโก้ของแบรนด์ขึ้นมาแล้วชี้นิ้วไปที่จอ ครึ่งล่างเป็นตัวอักษรไทยสามมิติตัวโตสีขาวตัดขอบแดงอ่านว่า โปรโมชั่น ใต้ลงมาเป็นแคปซูลมนสีดำขอบแดงเขียนว่า แนะนำเพื่อน เป็นตัวอักษรสีขาว ต่อท้ายด้วยตัวเลข 0.8% ตัวโตสีแดง`;
---

<MainLayout title={`โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน โบนัส 0.8%`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`รวมโปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} as="h1">
    <div class="flex flex-col gap-10">
      <p>
        หน้านี้รวมภาพโปรโมชั่นสำหรับสมาชิกของ {BRAND_NAME} ไว้ในที่เดียว ทั้ง
        <strong class="text-[#fb2e33]">รายการคืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน และโบนัสแนะนำเพื่อน 0.8% ไม่จำกัด</strong>
        โดยชื่อรายการและอัตราระบุไว้บนภาพด้านล่างแล้ว
        <strong class="text-[#fb2e33]">แต่ละรายการอาจมีข้อกำหนดเกี่ยวกับประเภทเกม ยอดที่นำมาคำนวณ รอบเวลารับเครดิต และเงื่อนไขการถอนเงินแตกต่างกัน จึงควรตรวจสอบประกาศล่าสุดก่อนเข้าร่วมทุกครั้ง</strong>
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt={altCashback}
          loading="lazy"
          fetchpriority="low"
          widths={[250, 375]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />

        <Picture
          src={promoReferral}
          alt={altReferral}
          loading="lazy"
          fetchpriority="low"
          widths={[250, 375]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="relative isolate flex items-center justify-center overflow-hidden rounded-lg border border-[#8a0608] bg-gradient-to-b from-[#d81115] via-[#b00d11] to-[#8a0608] px-10 py-3.5 text-lg font-black text-white shadow-[0_8px_22px_rgba(203,11,13,0.45)] transition-transform hover:scale-105">
          <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#f0e6e4]/12 to-transparent"></span>
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
