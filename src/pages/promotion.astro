---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

// ดรอปอาร์ตเวิร์กของ 888PARUAY คือ 2026-09-24 และมีสไลด์ที่ใช้ได้สองใบเท่านั้น:
//   slide1.png — ป้ายแดง "อัตราจ่ายหวย" + แผ่นป้ายทอง "2 ตัวจ่าย 100"
//   slide2.png — ป้ายแดง "อัตราจ่ายหวย" + แผ่นป้ายทอง "3 ตัวจ่าย 1,000"
// บทบาทของสองไฟล์นี้เคย "สลับกัน" ระหว่างแบรนด์มาแล้ว อย่าเชื่อชื่อตัวแปรที่ตกทอดมา
// รอบนี้ยึดตามคำอธิบายอาร์ตเวิร์กในสเปกแบรนด์ §4 และตั้งชื่อตัวแปรให้ตรงกับภาพจริง
//
// slide3.png (2026-09-18) และ slide4.png (2026-08-13) เก่ากว่าดรอปรอบนี้ เป็น
// อาร์ตเวิร์กของลูกค้าเจ้าก่อน — ห้าม import กลับมา และห้ามลบไฟล์ทิ้งเพราะเป็น
// อินเวนทอรี (ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้ว และ
// verify-build จะแดง) ถ้ามีสไลด์ใหม่เข้ามาให้เช็ก mtime เทียบดรอปก่อนเพิ่ม
import promoTwoDigit from "../assets/slide1.png";
import promoThreeDigit from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";
//
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ: ContentBox title, ย่อหน้าเกริ่นสั้น ๆ หนึ่งย่อหน้า
// (ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมดของหน้านี้), กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม
// — ไม่มีหัวข้อย่อยและไม่มีย่อหน้าเพิ่ม เพราะตัวโปสเตอร์ระบุอัตราจ่ายไว้ด้วยตัวอักษร
// ขนาดใหญ่อยู่แล้ว เป้าหมาย h1x1, h2x0, h3x0
//
// สไลด์เป็นแบนเนอร์แนวนอน 600px จึงวางเป็นกริดสองคอลัมน์คุมความกว้างรวมที่ max-w-5xl
// (1024px) ทำให้ช่องละ ~488px ไม่ต้องอัปสเกลเกินขนาดไฟล์ต้นทาง widths หยุดที่ 600
// ตามความกว้างจริงของไฟล์ (candidate ที่ใหญ่กว่านั้นไม่มีของให้ครอป)
//
// Announcement รอบนี้หมุนมาใช้ Announcement3 ทั้งเว็บ — default message ของไฟล์นั้น
// ถูกตั้งเป็นคอปปี้ของ 888PARUAY แล้ว และ index ก็เรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop
//
// พาเลตต์ 888PARUAY (ทอง + เขียวเข้ม + แดง ตามโลโก้ที่เลข 888 เป็นเขียวสด คำว่า
// PARUAY เป็นแดง อยู่ในวงแหวนทอง): พื้น #07130a · ผิวการ์ด #0d2312 · ผิวยก #143a1c ·
// ทองหลัก #fcdc2b · ทองสว่าง #fff6ae · ทองลึก #a87d0c · เขียวสด #1fae1c ·
// เขียวลึก #0c4402 · แดงสด #cf1111 · แดงลึก #8a0303 · เนื้อความ #e8e4c6 (BRAND_TEXT)
// — พาเลตต์แดง-ทอง-เงินของแบรนด์รอบก่อนถูกถอดออกครบแล้ว ห้ามนำกลับมา
//
// ย่อหน้าในการ์ดไม่ระบุสีเอง ให้สืบทอดสีเนื้อความจาก ContentBox (ไฟล์กลางที่ orchestrator
// รีธีมรอบนี้) — มีแค่ปุ่มกับกรอบรูปเท่านั้นที่ถือสีของพาเลตต์
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 159
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "รวมภาพโปรโมชั่นและอัตราจ่ายหวยของ 888PARUAY ทั้งเลข 2 ตัวจ่าย 100 และเลข 3 ตัวจ่าย 1,000 พร้อมรายละเอียดของแต่ละรายการให้ตรวจสอบเงื่อนไขจากหน้าเว็บก่อนทำรายการ";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น 888PARUAY",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoTwoDigit.src,
});
---

<MainLayout title="โปรโมชั่น 888PARUAY อัตราจ่ายหวย 2 ตัวจ่าย 100 และ 3 ตัวจ่าย 1,000" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น 888PARUAY" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed">
        หน้านี้รวมภาพอัตราจ่ายหวยที่ <strong>888PARUAY</strong> เปิดรับในรอบปัจจุบัน ทั้งเลข 2 ตัวและเลข 3 ตัว โดยรายละเอียดของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว
        <strong>รอบเปิดรับและเงื่อนไขของหวยแต่ละประเภทแตกต่างกัน</strong> จึงควรตรวจสอบรายการล่าสุดจากหน้าเว็บไซต์อีกครั้งก่อนยืนยันรายการทุกครั้ง
      </p>

      <div class="mx-auto grid w-full max-w-5xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoTwoDigit}
          alt="แบนเนอร์อัตราจ่ายหวยพื้นเขียวเข้มประกายทอง มีเหรียญทองและลูกบอลหวยสีแดง เขียว ขาว กระจายรอบภาพ ด้านบนกลางภาพเป็นโลโก้ 888PARUAY ในวงแหวนทอง เลข 888 สีเขียวกับคำว่า PARUAY สีแดง ด้านซ้ายเป็นหญิงสาวชุดแดงกำลังชี้นิ้วเข้าหาข้อความ ด้านขวาเป็นชายหนุ่มเสื้อแจ็กเก็ตขาวผูกโบว์แดง กลางภาพเป็นป้ายแดงข้อความไทยว่า อัตราจ่ายหวย และใต้ป้ายเป็นแผ่นป้ายขอบทองข้อความว่า 2 ตัวจ่าย 100"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), 488px"
          class="mx-auto h-auto w-full rounded-xl border border-[#fcdc2b]/55 object-contain shadow-[0_10px_30px_rgba(7,19,10,0.75)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#1fae1c]/75 hover:shadow-[0_15px_40px_rgba(252,220,43,0.45)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoThreeDigit}
          alt="แบนเนอร์อัตราจ่ายหวยพื้นเขียวเข้มประกายทอง มีเหรียญทองและลูกบอลหวยสีแดง เขียว ขาว กระจายรอบภาพ ด้านบนกลางภาพเป็นโลโก้ 888PARUAY ในวงแหวนทอง เลข 888 สีเขียวกับคำว่า PARUAY สีแดง ด้านซ้ายเป็นหญิงสาวชุดแดงกำลังชี้นิ้วเข้าหาข้อความ ด้านขวาเป็นชายหนุ่มเสื้อแจ็กเก็ตขาวผูกโบว์แดง กลางภาพเป็นป้ายแดงข้อความไทยว่า อัตราจ่ายหวย และใต้ป้ายเป็นแผ่นป้ายขอบทองข้อความว่า 3 ตัวจ่าย 1,000"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), 488px"
          class="mx-auto h-auto w-full rounded-xl border border-[#fcdc2b]/55 object-contain shadow-[0_10px_30px_rgba(7,19,10,0.75)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#1fae1c]/75 hover:shadow-[0_15px_40px_rgba(252,220,43,0.45)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก 888PARUAY"
          class="flex items-center justify-center rounded-lg border border-[#fff6ae]/60 bg-gradient-to-r from-[#fff6ae] via-[#fcdc2b] to-[#a87d0c] px-10 py-3.5 text-lg font-black text-[#07130a] shadow-[0_0_15px_rgba(252,220,43,0.50)] transition-transform hover:scale-105">
          สมัครสมาชิก 888PARUAY
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
