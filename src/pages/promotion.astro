---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";

import { Picture } from "astro:assets";

// Only slide1/slide2 are this brand's assets (dropped 2026-08-09 alongside
// the rest of the WE168 artwork) — slide3/slide4 on disk predate this
// drop (2026-08-04) and are a stale leftover from an earlier brand; they
// must not be imported or rendered here.
// slide1 = แนะนำเพื่อน 0.8% bonus art, slide2 = คืนยอดเสีย 0.3% bonus art
// (checked against the rendered artwork itself, not inherited from a stale
// comment — the two are not interchangeable).
import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "โปรโมชั่น WE168 คาสิโนออนไลน์ระบบออโต้ แนะนำเพื่อนรับโบนัส 0.8% และคืนยอดเสียทุกวัน 0.3% ตรวจสอบเงื่อนไขให้ครบก่อนกดรับสิทธิ์ทุกครั้ง เพื่อความคุ้มค่าสูงสุด";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น WE168 แนะนำเพื่อน 0.8% คืนยอดเสีย 0.3%",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});
---

<MainLayout title="โปรโมชั่น WE168 แนะนำเพื่อนรับ 0.8% คืนยอดเสียรับ 0.3%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น WE168" as="h1">
    <div>
      <h2 class="mb-4 text-2xl leading-normal font-bold text-[#4ade80]">แนะนำเพื่อน รับโบนัส 0.8%</h2>

      <p class="mb-8 text-left text-base leading-relaxed text-[#e8f5ee]">
        แชร์ลิงก์แนะนำให้เพื่อนสมัครสมาชิกกับ WE168 รับโบนัส 0.8% จากยอดเล่นของเพื่อนตามเงื่อนไข พร้อมตรวจสอบยอดโบนัสผ่านบัญชีสมาชิกได้ทุกวัน
      </p>

      <h2 class="mb-4 text-2xl leading-normal font-bold text-[#4ade80]">คืนยอดเสียทุกวัน รับโบนัส 0.3%</h2>

      <p class="mb-8 text-left text-base leading-relaxed text-[#e8f5ee]">
        สมาชิกที่มียอดเล่นเสียตรงตามเงื่อนไขสามารถรับยอดคืน 0.3% ได้ทุกวัน โดยเข้าสู่บัญชีสมาชิกและกดรับสิทธิ์ผ่านหน้าเว็บไซต์
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={pro1}
          alt="แบนเนอร์ WE168 โปรโมชั่นแนะนำเพื่อน รับโบนัส 0.8% ธีมนีออนเขียว-ชมพู พร้อมสาวสวยยิ้มดีใจถือโทรศัพท์มือถือแสดงแอป WE168 ชิปคาสิโน ไพ่ เหรียญทอง และกล่องของขวัญเป็นฉากหลัง"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600, 800]}
          sizes="(max-width: 768px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#22c55e]/25 object-contain shadow-[0_10px_30px_rgba(34,197,94,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ec4899]/50 hover:shadow-[0_15px_40px_rgba(236,72,153,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro2}
          alt="แบนเนอร์ WE168 โปรโมชั่นคืนยอดเสีย รับโบนัส 0.3% ธีมนีออนเขียว-ชมพู พร้อมสาวสวยยิ้มถือโทรศัพท์มือถือแสดงเกมบาคาร่า วงล้อรูเล็ต ชิปคาสิโน ไพ่ และเหรียญทองเป็นฉากหลัง"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600, 800]}
          sizes="(max-width: 768px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#22c55e]/25 object-contain shadow-[0_10px_30px_rgba(34,197,94,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ec4899]/50 hover:shadow-[0_15px_40px_rgba(236,72,153,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg bg-gradient-to-r from-[#f9a8d4] to-[#db2777] px-10 py-3.5 text-lg font-black text-[#4a0a29] shadow-[0_0_15px_rgba(236,72,153,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก WE168
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
