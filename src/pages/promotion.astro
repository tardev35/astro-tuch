---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

// เฉพาะ slide1/slide2 (ลงวันที่ 2026-09-01) เท่านั้นที่เป็นอาร์ตเวิร์กของ WIN8S
// รอบนี้บทบาทสลับกับรอบก่อน: slide1 คือโปสเตอร์ "แนะนำเพื่อน 0.8%"
// ส่วน slide2 คือ "คืนยอดเสีย 0.3%" (อ่านจากตัวภาพจริง ไม่ใช่จากชื่อไฟล์)
// อย่าเชื่อชื่อตัวแปรที่รอบก่อนตั้งไว้ — ให้เปิดรูปดูทุกครั้งที่เปลี่ยนแบรนด์
// slide3/slide4 ยังค้างอยู่บนดิสก์แต่เป็นอาร์ตเวิร์กของลูกค้าก่อนหน้า — ห้าม import ที่นี่
// ทั้งรอบนี้และรอบถัดไป (ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้ว)
import promoReferral from "../assets/slide1.png";
import promoCashback from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็น IMAGE page: ContentBox title, ย่อหน้าเกริ่นสั้น ๆ หนึ่งย่อหน้า, กริดโปสเตอร์,
// ปุ่ม CTA หนึ่งปุ่ม — ไม่มีหัวข้อย่อยและไม่มีย่อหน้าเพิ่ม เพราะตัวโปสเตอร์ระบุเงื่อนไข
// ของแต่ละโปรโมชั่นไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 154
const pageDescription =
  "รวมโปรโมชั่นของ WIN8S ทั้งแนะนำเพื่อนรับ 0.8% และคืนยอดเสีย 0.3% ดูเปอร์เซ็นต์ ยอดที่นำมาคำนวณ และรอบรับสิทธิ์ได้จากภาพโปรโมชั่นในหน้านี้ก่อนกดรับทุกครั้ง";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น WIN8S แนะนำเพื่อน 0.8% คืนยอดเสีย 0.3%",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoReferral.src,
});
---

<MainLayout title="โปรโมชั่น WIN8S แนะนำเพื่อนรับ 0.8% และคืนยอดเสียรับ 0.3%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น WIN8S" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#f6e4d6]">
        หน้านี้รวมโปรโมชั่นที่ WIN8S เปิดให้สมาชิกตรวจสอบสิทธิ์และกดรับผ่านบัญชีของตนเอง ทั้งแนะนำเพื่อนรับ
        <strong class="text-[#fd9a1e]">0.8%</strong> และคืนยอดเสีย <strong class="text-[#fd9a1e]">0.3%</strong>
        โดยเปอร์เซ็นต์ ยอดที่นำมาคำนวณ และรอบเวลารับสิทธิ์ระบุไว้บนภาพโปรโมชั่นแต่ละใบ
        แต่ละรายการมีเงื่อนไขต่างกัน จึงควรอ่านรายละเอียดล่าสุดหรือสอบถามแอดมินก่อนกดรับทุกครั้ง
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อนของ WIN8S พื้นหลังคาสิโนโทนดำส้ม ด้านบนกลางภาพเป็นโลโก้ WIN8S ตัวอักษร WIN สีส้มและเลข 8S สีเงินโครเมียม มีวงล้อสล็อต 777 คั่น ถัดลงมาเป็นป้ายคำว่า โปรโมชั่น ตามด้วยข้อความ แนะนำเพื่อน วางเหนือตัวเลข 0.8% ขนาดใหญ่สีขาวขอบส้ม ด้านซ้ายเป็นมือถือแสดงหน้าเกมสล็อต MEGA WIN 12,450.00 ด้านขวาเป็นผู้หญิงผมรวบสวมชุดสีดำคาดส้มยกมือชี้มาที่ตัวเลข ฉากหลังมีป้าย JACKPOT 168,888.00 วงล้อสล็อต 777 BAR เหรียญทองปลิว และกล่องของขวัญ ด้านล่างเป็นป้ายสามอันเขียนว่า แนะนำเพื่อน รับโบนัสทันที เพื่อนสมัคร รับโบนัสได้เลย และ รับโบนัสสูงสุด ไม่จำกัด"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#8a3103]/70 object-contain shadow-[0_10px_30px_rgba(5,2,1,0.72)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fc8d13]/70 hover:shadow-[0_15px_40px_rgba(252,141,19,0.35)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่นคืนยอดเสียของ WIN8S พื้นหลังคาสิโนโทนดำส้ม ด้านบนกลางภาพเป็นโลโก้ WIN8S ตัวอักษร WIN สีส้มและเลข 8S สีเงินโครเมียม มีวงล้อสล็อต 777 คั่น ถัดลงมาเป็นป้ายคำว่า โปรโมชั่น ตามด้วยข้อความ คืนยอดเสีย วางเหนือตัวเลข 0.3% ขนาดใหญ่สีส้มไล่เฉด ด้านขวาเป็นผู้หญิงผมรวบสวมชุดสีดำคาดส้มยกมือชี้มาที่ตัวเลข ด้านซ้ายเป็นวงล้อสล็อต 777 และเหรียญชิปสีส้มดำ ฉากหลังมีตู้สล็อตเรืองแสงส้ม เหรียญทองปลิว และกล่องของขวัญ"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#8a3103]/70 object-contain shadow-[0_10px_30px_rgba(5,2,1,0.72)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fc8d13]/70 hover:shadow-[0_15px_40px_rgba(252,141,19,0.35)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก WIN8S"
          class="flex items-center justify-center rounded-lg border border-[#f36403]/70 bg-gradient-to-r from-[#fff2e6] via-[#fd9a1e] to-[#8a3103] px-10 py-3.5 text-lg font-black text-[#050201] shadow-[0_0_15px_rgba(243,100,3,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก WIN8S
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
