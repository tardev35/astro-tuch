---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";

import { Picture } from "astro:assets";

// ⚠️ ดรอปนี้มีสไลด์ที่ "ใช้ได้" แค่สองใบ และบทบาทไม่เหมือนรอบก่อน ยืนยันด้วยการ
// เปิดภาพอ่านป้ายจริง ไม่ใช่เชื่อชื่อไฟล์หรือคอมเมนต์ของรอบก่อน:
//   slide1.png — ป้ายฟ้าขอบทอง "คืนยอดเสีย 0.3%" (นางแบบอยู่ขวา โลโก้ซ้ายบน)
//   slide2.png — ริบบิ้นฟ้า "แนะนำเพื่อน" + เลขทอง "0.8%" (นางแบบอยู่ซ้าย)
//   slide3.png / slide4.png — โปสเตอร์ของแบรนด์ก่อน (29 ก.ย. เก่ากว่าดรอปนี้)
//     ห้าม import กลับมาเด็ดขาด และห้ามลบไฟล์ทิ้งเพราะเป็นอินเวนทอรีของรอบถัดไป
// ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้วและ verify-build จะแดง
// (banner2/banner3 ใน src/assets ก็เก่ากว่าดรอปนี้ = อาร์ตเวิร์กแบรนด์ก่อน ห้าม import)
// ส่วน banner1 / banner1-mobile / og.png เป็นของ MainLayout ห้าม import จากหน้านี้
// ชื่อตัวแปรตั้งตามข้อความบนภาพ ไม่ใช่ตามเลขไฟล์ เพื่อไม่ให้รอบหน้าสลับผิดอีก
import promoCashback from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้น ๆ "หนึ่งย่อหน้า ประมาณสี่บรรทัด" คือ
// โควตาตัวหนังสือทั้งหมดของหน้านี้, กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อย
// และห้ามเพิ่มย่อหน้า เพราะตัวโปสเตอร์ระบุเปอร์เซ็นต์โบนัสไว้ด้วยตัวอักษรขนาดใหญ่
// อยู่แล้ว การพิมพ์ซ้ำด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ เป้าหมาย h1x1 h2x0 h3x0
//
// สไลด์รอบนี้เป็น **จัตุรัส 600x600 ทั้งคู่** (วัดจาก PNG header) ต่างจากรอบก่อนที่
// เป็นแนวนอน 600x300 จึงวางเป็นกริดสองคอลัมน์ คุมความกว้างรวมที่ max-w-4xl
// (896px) ทำให้ช่องละ ~436px ไม่ต้องอัปสเกลเกินขนาดไฟล์ต้นทาง widths หยุดที่ 600
// ตามความกว้างจริงของไฟล์ และคุมภาพต่อใบไว้ที่ max-w-[600px] สองใบพอดีหนึ่งแถว
// เรียง คืนยอดเสีย 0.3% ก่อน แนะนำเพื่อน 0.8% ตามลำดับของบรีฟ (docx H3 #4 แล้ว
// ค่อย #5) ซึ่งรอบนี้แปลว่า slide1 มาก่อน slide2 · LCP คือ hero ใน MainLayout
// ไม่ใช่สองรูปนี้ จึง loading="lazy" fetchpriority="low" ทั้งคู่
//
// Announcement รอบนี้หมุนมาเป็น Announcement2 ทั้งเว็บ (แบรนด์ก่อนใช้
// Announcement5) — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ
// HI59 แล้ว และทุกหน้าก็เรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop message มิฉะนั้น
// ตัววิ่งจะพูดคนละเรื่องกันระหว่างหน้า
//
// พาเลตต์ HI59 (brand-spec §2) **ฟ้าสว่าง + ทอง VIP บนการ์ดสว่าง** — รอบนี้พลิก
// ขั้วจากแบรนด์ก่อนที่เป็นแดง/เงินบนผิวเกือบดำ: ฟ้าแบรนด์ #0a84e0 · ฟ้าลิงก์/ป้าย
// บนการ์ดสว่าง #065a9c (หมึก strong — ฟ้า #0a84e0 บนพื้นขาวได้แค่ 4.0:1) · ฟ้าลึก
// #044b80 / #033f70 · หมึกบนพื้นฟ้า #eaf5ff · ทองอ่อน #ffe27a · ทองแบรนด์
// #fdbc04 · ทองเข้ม #c88a02 · หมึกบนพื้นทอง #04203f · ขอบการ์ด #9ecbf2 ·
// เนื้อความ #0d2744 (BRAND_TEXT มาจาก <html> และการ์ด ContentBox ตั้งให้แล้ว
// จึงไม่ต้องระบุสีที่ย่อหน้า)
// ปุ่มสมัครเป็น PRIMARY จึงถม **ทอง** เต็มใบบนหมึกกรมท่า #04203f ตามกฎคอนทราสต์
// ของสเปก (ห้ามขาว/ครีมบนทอง) ตรงกับคู่ปุ่มของ NavbarStyle6 ที่ orchestrator
// รีธีมไว้ และเงาของรูปเป็นเงาฟ้าอ่อน ไม่ใช่เงาดำทึบ เพราะทั้งหน้าเป็นพื้นสว่าง
// ชุดแดง+เงินของ หวยดีใจ (#dc0409 #f5363d #8e0206 #4b0205 #e8161c #eef0f4
// #c3c7d1 #f3c54e #edeaf0 #0d0407 rgba(220,4,9,*) rgba(13,4,7,*)) ออกครบแล้ว
//
// HI59 เป็น **เว็บสล็อต** ไม่ใช่เว็บหวย — คำหมวดหวย (หวย ส่งโพย โพย เลข 2 ตัว
// เลข 3 ตัว แนวทาง อัตราจ่าย งวด ผลรางวัล หวยลาว หวยฮานอย ธ.ก.ส.) ห้ามหลงเหลือ
// ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% / 0.8% / 100% / 24 ชั่วโมง ห้ามแต่งยอดฝาก
// ขั้นต่ำ ชื่อค่ายเกม ชื่อธนาคาร เลขใบอนุญาต หรือวันหมดเขตของแคมเปญ และต้องคง
// คำกำกับของบรีฟไว้ว่าต้องตรวจค่ายเกม รอบตัดยอด และเงื่อนไขก่อนกดรับสิทธิ์ทุกครั้ง
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 153
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `รวมภาพโปรโมชั่นของ ${BRAND_NAME} ทั้งคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ซึ่งคำนวณจากยอดที่เข้าเกณฑ์ ควร Login ตรวจสอบค่ายเกม รอบตัดยอด และเงื่อนไขก่อนกดรับสิทธิ์`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่น ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});
---

<MainLayout title={`โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% สำหรับยอดที่เข้าเกณฑ์`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`โปรโมชั่น ${BRAND_NAME}`} as="h1">
    <div class="flex flex-col gap-10">
      <p class="text-left text-base leading-relaxed">
        หน้านี้รวมภาพโปรโมชั่นที่ <strong class="text-[#065a9c]">{BRAND_NAME}</strong> เปิดให้สมาชิกตรวจสอบสิทธิ์ตามแคมเปญของแต่ละช่วง ทั้งคืนยอดเสียและแนะนำเพื่อน โดยรายละเอียดของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว
        ระบบจะนำยอดที่เข้าเกณฑ์มาคำนวณก่อนแสดงจำนวนโบนัสที่รับได้ <strong class="text-[#065a9c]">เงื่อนไข ค่ายเกมที่ร่วมรายการ และรอบคำนวณของแต่ละโปรโมชั่นอาจแตกต่างกัน</strong> จึงควร Login ตรวจสอบรอบตัดยอดและเงื่อนไขล่าสุดก่อนกดรับสิทธิ์ทุกครั้ง
      </p>

      <div class="mx-auto grid w-full max-w-4xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt={`ภาพโปรโมชั่นของ ${BRAND_NAME} พื้นหลังเป็นท้องฟ้าสีฟ้าสดใสมีเมฆขาว ดาวเคราะห์ และวงแหวนทองลอยอยู่ ซ้ายบนเป็นโลโก้ HI สีฟ้ากับเลข 59 สีทองในวงแหวนทอง ถัดลงมาเป็นคำว่า โปรโมชั่น สีขาวประดับมงกุฎทอง และป้ายฟ้าขอบทองข้อความ คืนยอดเสีย 0.3% ด้านขวาเป็นหญิงสาวผมบลอนด์ยาวหยักศกสวมสูทขาวกระดุมทอง ติดปิ่นปักผมรูปดาวสีทอง เท้าแก้มด้วยมือและยิ้ม ด้านล่างเป็นสะพานทองทอดผ่านเมืองในหมู่เมฆ`}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), (max-width: 1007px) calc((100vw - 136px) / 2), 436px"
          class="mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#9ecbf2]/70 object-contain shadow-[0_10px_30px_rgba(6,53,95,0.20)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#0a84e0]/80 hover:shadow-[0_15px_40px_rgba(10,132,224,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoReferral}
          alt={`ภาพโปรโมชั่นของ ${BRAND_NAME} ฉากท้องฟ้าสีฟ้าชุดเดียวกัน มีดาวเคราะห์วงแหวนและเมฆขาวเป็นฉากหลัง ด้านซ้ายเป็นหญิงสาวผมบลอนด์ยาวสวมชุดขาวขลิบทอง ยื่นมือขวาแบออกมาหาผู้ชมและยิ้ม ขวาบนเป็นโลโก้ HI สีฟ้ากับเลข 59 สีทอง ถัดลงมาเป็นคำว่า โปรโมชั่น สีขาว ริบบิ้นสีฟ้าข้อความ แนะนำเพื่อน และตัวเลขทองขนาดใหญ่ 0.8% มุมขวาล่างเป็นกล่องของขวัญสีขาวผูกโบว์ทองวางบนกองเหรียญทอง`}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), (max-width: 1007px) calc((100vw - 136px) / 2), 436px"
          class="mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#9ecbf2]/70 object-contain shadow-[0_10px_30px_rgba(6,53,95,0.20)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#0a84e0]/80 hover:shadow-[0_15px_40px_rgba(10,132,224,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#c88a02] bg-gradient-to-r from-[#ffe27a] via-[#fdbc04] to-[#c88a02] px-10 py-3.5 text-lg font-black text-[#04203f] shadow-[0_0_15px_rgba(253,188,4,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
