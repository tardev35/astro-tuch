---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

// Only slide1/slide2 are this brand's assets — slide3/slide4 are stale
// leftovers from an earlier brand's drop and must not be imported or
// rendered. See .claude/.rebrand-scratch-FUN24.md "Images already staged
// by uploader" section.
// slide1 = โปรเล่นสล็อต คืนยอดเสีย 0.3% art, slide2 = โปรแนะนำเพื่อน 0.8% art.
import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "โปรโมชั่น FUN24 คาสิโนออนไลน์ระบบออโต้ คืนยอดเสียทุกวัน 0.3% และแนะนำเพื่อนรับโบนัส 0.8% ตรวจสอบเงื่อนไขให้ครบก่อนกดรับสิทธิ์ทุกครั้ง เพื่อความคุ้มค่าสูงสุด";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น FUN24 คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8%",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});
---

<MainLayout title="โปรโมชั่น FUN24 คืนยอดเสียรับ 0.3% แนะนำเพื่อนรับ 0.8%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น FUN24" as="h1">
    <div>
      <h2 class="mb-4 text-2xl leading-normal font-bold text-[#fbbf24]">คืนยอดเสียทุกวัน รับโบนัส 0.3%</h2>

      <p class="mb-8 text-left text-base leading-relaxed text-[#fbe6d8]">
        สมาชิกที่มียอดเล่นเสียตรงตามเงื่อนไขสามารถรับยอดคืน 0.3% ได้ทุกวัน โดยเข้าสู่บัญชีสมาชิกและกดรับสิทธิ์ผ่านหน้าเว็บไซต์
      </p>

      <h2 class="mb-4 text-2xl leading-normal font-bold text-[#fbbf24]">แนะนำเพื่อน รับโบนัส 0.8%</h2>

      <p class="mb-8 text-left text-base leading-relaxed text-[#fbe6d8]">
        แชร์ลิงก์แนะนำให้เพื่อนสมัครสมาชิกกับ FUN24 รับโบนัส 0.8% จากยอดเล่นของเพื่อนตามเงื่อนไข พร้อมตรวจสอบยอดโบนัสผ่านบัญชีสมาชิกได้ทุกวัน
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={pro1}
          alt="แบนเนอร์ FUN24 โปรเล่นสล็อต คืนยอดเสีย รับโบนัส 0.3% ธีมคาร์นิวัลสีส้ม-ดำ พร้อมสาวสวยยิ้มดีใจถือโทรศัพท์มือถือ วงล้อรูเล็ต ไพ่ป๊อก ลูกเต๋า ชิปคาสิโนโลโก้ FUN24 เครื่องสล็อตหน้าปัด 777 และเงารถชิงช้าสวรรค์เป็นฉากหลัง"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600, 800]}
          sizes="(max-width: 768px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#fbbf24]/25 object-contain shadow-[0_10px_30px_rgba(251,191,36,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fbbf24]/50 hover:shadow-[0_15px_40px_rgba(180,83,9,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro2}
          alt="แบนเนอร์ FUN24 โปรแนะนำเพื่อน รับโบนัส 0.8% ธีมคาร์นิวัลสีส้ม-ดำ พร้อมสาวสวยยิ้มดีใจถือโทรศัพท์มือถือ เครื่องสล็อตหน้าปัด 777 วงล้อรูเล็ต ไพ่ป๊อก ชิปคาสิโนโลโก้ FUN24 และเงาหอคอยคาร์นิวัลเป็นฉากหลัง"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600, 800]}
          sizes="(max-width: 768px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#fbbf24]/25 object-contain shadow-[0_10px_30px_rgba(251,191,36,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fbbf24]/50 hover:shadow-[0_15px_40px_rgba(180,83,9,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#fbbf24]/60 bg-gradient-to-r from-[#fde68a] to-[#fbbf24] px-10 py-3.5 text-lg font-black text-[#170a03] shadow-[0_10px_30px_rgba(251,191,36,0.18)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(180,83,9,0.30)]">
          สมัครสมาชิก FUN24
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
