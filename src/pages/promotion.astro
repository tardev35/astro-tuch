---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";

import { Picture } from "astro:assets";

// ดรอปรอบนี้ (2026-10-21, brand-spec §5) มีสไลด์ที่ใช้ได้ **สองใบ** และชื่อตัวแปร
// ตั้งตามข้อความที่พิมพ์อยู่บนภาพจริง (เปิดบิตแมปอ่านเองแล้วรอบนี้) ไม่ใช่ตามเลขไฟล์ —
// ถ้ารอบหน้าเจอความขัดแย้ง **ให้เชื่อข้อความบนรูป**:
//   slide2.png — โปสเตอร์ "โปรโมชั่น / คืนยอดเสีย 0.3%"
//   slide1.png — โปสเตอร์ "โปรโมชั่น / แนะนำเพื่อน 0.8%"
//   slide3.png / slide4.png (mtime 2026-09-29) — โปสเตอร์หวยของแบรนด์คนละราย
//     **ห้าม import** (ถอดออกไปหลายรอบแล้ว อย่าดึงกลับ)
// ⚠️ การจับคู่พลิกไปมาระหว่างดรอป จึงห้ามเชื่อการจับคู่ของรอบก่อน ต้องเปิดบิตแมปดูทุกรอบ
// ⚠️ eager import = emit ลง dist/ ต่อให้ไม่ได้ render และ verify-build จะแดง
// การ import ไฟล์เก่าคือการส่งรูปของลูกค้ารายอื่นขึ้นเว็บนี้
// **ห้ามลบไฟล์เก่าทิ้ง** — เป็นอินเวนทอรีของรอบถัดไป แค่ห้าม import
// (banner2 / banner3 ก็เช่นกัน ส่วน banner1 / banner1-mobile / og.png เป็นของ glob
// ที่ MainLayout ปักชื่อไว้เอง — ห้ามอ้างจากหน้านี้) รอบนี้จึงไม่มี article illustration
import promoCashback from "../assets/slide2.png";
import promoReferral from "../assets/slide1.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้นๆ ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมด
// ของหน้านี้, กริดภาพโปรโมชั่น, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อยและห้ามเพิ่มย่อหน้า
// เพราะโปสเตอร์ระบุเปอร์เซ็นต์ของตัวเองด้วยตัวอักษรขนาดใหญ่อยู่แล้ว การพิมพ์ซ้ำ
// ด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ บรีฟรอบนี้ (src/assets/content.txt)
// ไม่มีส่วน SUB-PAGES เลย ย่อหน้าทุกย่อหน้าที่เคยอยู่บนหน้านี้จึงเป็นของที่รีแบรนด์
// รอบก่อนๆ แต่งขึ้นเอง — รอบนี้คงไว้เพียงย่อหน้าเกริ่นเดียว และเขียนขึ้นใหม่จากบรีฟ
// (content.txt บรรทัด 7-12) ไม่ใช่ find-and-replace ทับประโยคของรอบก่อน
//
// ลำดับในกริดตามลำดับของบรีฟ: คืนยอดเสีย 0.3% (บรรทัด 9-10) มาก่อน แนะนำเพื่อน 0.8%
// (บรรทัด 11-12)
// ⚠️ บิตแมปจริงของดรอปนี้คือ **540x600 แนวตั้ง** (ไม่ใช่จัตุรัสและไม่ใช่แนวนอน)
// ความกว้างสูงสุดคือ 540 widths จึงหยุดที่ 540 และคุมที่ max-w-[540px] ตามสเปก
// **ให้วัดใหม่ทุกรอบ อย่าเชื่อสัดส่วนของรอบก่อน**
// sizes คิดจากความกว้างที่ถูกวาดจริง: section px-4 (16px/ข้าง) + การ์ด p-8
// (32px/ข้าง, เป็น p-10 = 40px ที่ md ขึ้นไป) + gap-6 ระหว่างคอลัมน์ (24px)
//   ใต้ 640px = คอลัมน์เดียว → 100vw-96px
//   640-767px = สองคอลัมน์ p-8 → 50vw-60px
//   768-1215px = สองคอลัมน์ p-10 → 50vw-68px
//   ตั้งแต่ 1216px ขึ้นไปชนเพดาน 540px
// LCP คือ hero ใน MainLayout ไม่ใช่รูปพวกนี้ จึง loading="lazy" fetchpriority="low"
// decoding="async" และ quality ตัวเดียวทั้ง avif/webp — ห้ามจูนแยกฟอร์แมต
// (tools/avif-quality-service.mjs ย่อฝั่ง avif ให้เองที่ x0.65)
//
// quality={64} ไม่ใช่ 80 ตามปกติ และเป็นค่าที่ "วัดมา" ไม่ใช่ค่าที่ชอบ: สไลด์ทั้งสองเป็น
// อาร์ตเกรนละเอียด (ลายปักทองบนชุดไทย ใบบัว เกล็ดแสง ยอดเจดีย์ทอง) ซึ่งเป็นเคสที่
// AVIF ทำได้แย่ที่สุด ที่ quality=80 ไฟล์ AVIF ออกมา **ใหญ่กว่า** WebP ที่เป็น
// fallback ของตัวเอง เบราว์เซอร์ที่รองรับ AVIF จะหยิบไฟล์ที่หนักกว่าไปใช้ และ
// verify-build.mjs ทำให้ build แดงด้วยเหตุนี้ตรงๆ · ทางแก้คือ quality ที่ **ต่ำลง**
// ไม่ใช่สูงขึ้น ค่าเดียวกันนี้ใช้ที่ index.astro กับสไลด์คู่เดียวกัน
//
// Announcement รอบนี้หมุนมาเป็น AnnouncementHuay ทั้งเว็บ (brand-spec §3 — รอบก่อนใช้
// Announcement4 จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้
// ของแบรนด์นี้ไว้แล้ว และทุกหน้าเรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop message
// มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกันระหว่างหน้า
//
// 🚨 พาเลตรอบนี้ (brand-spec §2) เป็น **ธีมสว่างรอบที่สองของรีโปนี้**
// bg.json ของดรอปนี้คือ {"mode":"color","color":"#d8ffc7"} = เขียวมิ้นต์สว่าง
// **ห้าม "แก้" กลับไปเป็นพื้นเข้มเพราะรอบก่อนๆ เป็นแบบนั้น**
// ลำดับผิว: ผิวการ์ด #ffffff (ContentBox) / ชั้นกลาง-อินเซ็ต #e9fbdd / พื้นเพจ #d8ffc7
// หมึกเขียวป่า #0c3a16 = เนื้อความ (= BRAND_TEXT ที่ <html> และการ์ด ContentBox ตั้งให้
// แล้ว ย่อหน้าจึงไม่ประกาศสีของตัวเอง 12.9:1 บนผิวการ์ด) ·
// เขียวเข้ม #0a5f1c = หัวข้อ และเป็น **สีเดียว** ที่ <strong> ในเนื้อความใช้ได้ (7.9:1)
// เขียวมรกต #0b7d28 = ขอบ / ออรา / **พื้นถมปุ่ม** (5.3:1 กับตัวอักษรขาว ผ่าน AA)
// ปุ่มในไฟล์นี้จึงถมไล่เฉด #0b7d28 → #0a5f1c แล้ววาง #ffffff ทับ (5.3:1 และ 7.9:1)
// ⚠️⚠️ **เขียวใบตอง #0f9b35 ห้ามถือตัวอักษรและห้ามเป็นพื้นของตัวอักษร** (3.7:1)
// เป็น stop ของไล่เฉด/ออราเท่านั้น
// ⚠️⚠️ **ทองสัมฤทธิ์ #c9cb63 #aeb04a #9ba03c ห้ามใช้ในไฟล์นี้** — บนผิวการ์ดขาว
// ได้แค่ 1.7-2.8:1 ทองเป็นสีของโครม (navbar/footer/ticker) เท่านั้น
// rgba() ที่อนุญาตรอบนี้: rgba(11,125,40,α) · rgba(10,95,28,α) · rgba(12,58,22,α)
// · <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ
// ถ้าเปิด/ปิดกลางคำ บรรทัดจะตัดกลางคำ และ <strong> สองตัวห้ามติดกัน
// ⚠️ กับดักรอบนี้คือ **ทอง/เหลืองเคยนำมาแล้วเกือบทุกแบรนด์** การเจอ "ทอง" ในไฟล์นี้
// จึงไม่พิสูจน์อะไรเลย ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน brand-spec §2 (ค่าของ
// แบรนด์เก่าไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive ใน
// คอมเมนต์ของไฟล์นี้เอง) ส่วนเขียวทั้งสี่ค่าของรอบนี้ไม่มีแบรนด์ไหนเคยใช้เลยสักเฉด
// และรอบนี้ **ไม่มีชมพู ไม่มีแดงชาด ไม่มีบรอนซ์ส้ม ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง
// ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์ และไม่มีทองส้มสด**
//
// ⚠️ แกนของแบรนด์รอบนี้คือ **เว็บหวยออนไลน์ล้วน** — หวยรัฐบาลไทย หวยฮานอย หวยลาว
// และหวยหุ้นต่างประเทศ **ไม่ใช่เว็บสล็อต ไม่ใช่คาสิโน และไม่ใช่เว็บบอล**
// ศัพท์หมวดของรอบก่อน (สล็อต ไฮโล ยิงปลา บอล บาคาร่า ระบบดูแลการเงิน บัญชีม้า)
// จึงเป็นของค้างที่ต้องไม่เหลือแม้แต่คำเดียว รายการคำเต็มอยู่ใน brand-spec §6
// ไม่พิมพ์ซ้ำที่นี่ · สองหน้าหมวดหวย (/ตรวจหวย /แนวทาง) เปิดอยู่รอบนี้
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% / 0.8% / 24ชม. / 100% — ห้ามแต่งยอดฝาก
// ขั้นต่ำ ชื่อธนาคาร ชื่อค่ายเกม ค่า RTP เลขใบอนุญาต จำนวนสมาชิก หรือปีก่อตั้ง และต้อง
// คงประโยคกำกับของบรีฟไว้ว่า **ควรอ่านประกาศล่าสุดและตรวจสอบเงื่อนไขก่อนรับสิทธิ์**
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) หน้านี้ยาว 156 อักขระด้วยชื่อแบรนด์ 7 ตัวของรอบนี้
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `รวมภาพโปรโมชั่นของ ${BRAND_NAME} เว็บหวยออนไลน์ไว้ในหน้าเดียว ทั้งคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% แต่ละรายการมีเงื่อนไขต่างกัน ควรอ่านประกาศล่าสุดก่อนเข้าร่วม`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่น ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});

// ความกว้างที่ถูกวาดจริงของแต่ละคอลัมน์ในกริดสองคอลัมน์ (ดูคอมเมนต์ sizes ด้านบน)
const promoSizes = "(max-width: 639px) calc(100vw - 96px), (max-width: 767px) calc(50vw - 60px), (max-width: 1215px) calc(50vw - 68px), 540px";

const promoClass =
  "mx-auto h-auto w-full max-w-[540px] rounded-xl border border-[#0b7d28]/55 object-contain shadow-[0_0_28px_rgba(11,125,40,0.22)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#0a5f1c]/85 hover:shadow-[0_0_40px_rgba(10,95,28,0.35)]";

// alt ทั้งสองเขียนจากบิตแมปของดรอปนี้ที่เปิดอ่านเองแล้ว (540x600 **แนวตั้ง** ทั้งคู่) —
// ฉากวัดไทยกลางแจ้งแดดจัด เจดีย์และยอดปราสาททอง คู่ชาย-หญิงชุดไทยลายปักทองถือ
// สลากกินแบ่งรัฐบาล ดอกบัวขาว ใบบัว เหรียญทอง และลูกบอลหวยด้านล่าง
// ⚠️ องค์ประกอบของอาร์ตเวิร์กแบรนด์ก่อนๆ ที่ต้องไม่หลงเหลือใน alt อยู่ครบใน
// brand-spec §5 (ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive)
// ⚠️ alt คือ "ข้อความที่พิมพ์อยู่บนโปสเตอร์" เป็นหลัก — ตัวเลขท้าย alt ต้องตรงกับรูป
// ⚠️ ห้ามเรียกรูปคู่นี้ว่าภาพแนวนอนหรือภาพสี่เหลี่ยมจัตุรัส รอบนี้เป็นแนวตั้ง
const altCashback = `โปสเตอร์โปรโมชั่นแนวตั้ง ฉากวัดไทยกลางแจ้งแดดจัด มีเจดีย์และยอดปราสาททองเรียงรายเป็นฉากหลัง ด้านบนเป็นโลโก้ ${BRAND_NAME} ตัวอักษรไทยสามมิติเขียวมรกตต่อด้วยเลขสามมิติผิวทอง ฝั่งซ้ายเป็นชายหนุ่มผมสั้นสีดำสวมชุดไทยสีเขียวลายปักทองและสร้อยทอง ยื่นมือออกมาด้านหน้า ฝั่งขวาเป็นหญิงสาวผมสั้นสีดำทัดดอกไม้ขาว สวมชุดไทยสไบลายทองพร้อมสร้อยและต่างหูทอง มือถือสลากกินแบ่งรัฐบาลคลี่เป็นพัด ด้านล่างมีดอกบัวขาว ใบบัว เหรียญทอง สลากกินแบ่ง และลูกบอลหวยพิมพ์เลข 6 กับ 9 กลางภาพเป็นคำว่า โปรโมชั่น ตัวอักษรไทยสามมิติสีทองตัวโต ใต้ลงมาเป็นแผ่นป้ายพื้นดำขอบทองเขียนว่า คืนยอดเสีย ต่อด้วยตัวเลข 0.3% สีทองตัวโต`;

const altReferral = `โปสเตอร์โปรโมชั่นแนวตั้ง ฉากวัดไทยกลางแจ้งแดดจัด มีเจดีย์และยอดปราสาททองเรียงรายเป็นฉากหลัง ด้านบนเป็นโลโก้ ${BRAND_NAME} ตัวอักษรไทยสามมิติเขียวมรกตต่อด้วยเลขสามมิติผิวทอง ฝั่งซ้ายเป็นชายหนุ่มผมสั้นสีดำสวมชุดไทยลายปักทองพร้อมสร้อยและกำไลทอง มือหนึ่งถือสลากกินแบ่งรัฐบาลคลี่เป็นพัด อีกมือยื่นออกมาด้านหน้า ฝั่งขวาเป็นหญิงสาวผมสั้นสีดำทัดดอกไม้ขาว สวมชุดไทยสไบลายทองพร้อมสร้อยและต่างหูทอง มือถือสลากกินแบ่งรัฐบาลคลี่เป็นพัดเช่นกัน ด้านล่างมีดอกบัวขาว ใบบัว เหรียญทอง และลูกบอลหวยพิมพ์เลข 6 8 และ 9 กลางภาพเป็นคำว่า โปรโมชั่น ตัวอักษรไทยสามมิติสีทองตัวโต ใต้ลงมาเป็นแผ่นป้ายพื้นดำขอบทองเขียนว่า แนะนำเพื่อน ต่อด้วยตัวเลข 0.8% สีทองตัวโต`;
---

<MainLayout title={`โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน โบนัส 0.8%`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`รวมโปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} as="h1">
    <div class="flex flex-col gap-10">
      <p>
        หน้านี้รวมภาพประกาศโปรโมชั่นของ {BRAND_NAME} ไว้ในที่เดียว ทั้ง
        <strong class="text-[#0a5f1c]">รายการคืนยอดเสีย 0.3% เข้ายูสทุกวัน และโบนัสแนะนำเพื่อน 0.8% ไม่จำกัดยูส</strong>
        โดยอัตราและรูปแบบการรับสิทธิ์ระบุไว้บนภาพด้านล่างแล้ว แต่ละโปรโมชั่นอาจมีเงื่อนไขเกี่ยวกับประเภทหวย ยอดที่นำมาคำนวณ และรอบเวลารับเครดิตแตกต่างกัน
        <strong class="text-[#0a5f1c]">ก่อนรับสิทธิ์ควรอ่านประกาศล่าสุดให้ครบถ้วน และตรวจสอบว่าโปรโมชั่นสามารถใช้ร่วมกันได้หรือไม่</strong>
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt={altCashback}
          loading="lazy"
          fetchpriority="low"
          widths={[270, 405, 540]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />

        <Picture
          src={promoReferral}
          alt={altReferral}
          loading="lazy"
          fetchpriority="low"
          widths={[270, 405, 540]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#0a5f1c] bg-gradient-to-b from-[#0b7d28] to-[#0a5f1c] px-10 py-3.5 text-lg font-black text-[#ffffff] shadow-[0_0_14px_rgba(11,125,40,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
