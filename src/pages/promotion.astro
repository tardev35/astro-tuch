---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

// Only slide1/slide2 belong to this brand (SUPERWIN9 drop, 2026-08-12) and both
// are literally the two promotions this page shows: slide1 is the
// "คืนยอดเสีย รับโบนัส 0.3%" poster, slide2 is the "แนะนำเพื่อน รับโบนัส 0.8%"
// poster. slide3/slide4 still on disk are a previous client's artwork
// (WINSIAM88) — they may not be imported here, now or on any future rebrand.
import promoCashback from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS (not bytes — a byte count reads ~3x too long for Thai).
const pageDescription = "รวมโปรโมชั่น SUPERWIN9 คืนยอดเสียรับโบนัส 0.3% และแนะนำเพื่อนรับโบนัส 0.8% ดูรายละเอียดแต่ละรายการและตรวจสอบเงื่อนไขการรับสิทธิ์ผ่านบัญชีสมาชิกก่อนกดรับ";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น SUPERWIN9 คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8%",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});
---

<MainLayout title="โปรโมชั่น SUPERWIN9 คืนยอดเสียรับ 0.3% แนะนำเพื่อนรับ 0.8%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น SUPERWIN9" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#efe3d2]">
        หน้านี้รวมโปรโมชั่นที่ SUPERWIN9 เปิดรับอยู่ในขณะนี้ ทั้งคืนยอดเสียรับโบนัส 0.3% และแนะนำเพื่อนรับโบนัส 0.8% รายละเอียดของโบนัส ยอดที่นำมาคำนวณ
        และรอบเวลาการรับสิทธิ์ระบุไว้บนภาพโปรโมชั่นแต่ละใบ และเงื่อนไขของแต่ละรายการไม่เหมือนกัน สมาชิกตรวจสอบยอดสะสมและกดรับสิทธิ์ได้จากบัญชีสมาชิก
        หรือสอบถามแอดมินที่ดูแลตลอด 24 ชั่วโมง
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่น SUPERWIN9 พื้นหลังดำแดงประกายทอง โลโก้ SUPERWIN9 ตัวอักษรแดงทองสามมิติ ข้อความ โปรโมชั่น คืนยอดเสีย รับโบนัส พร้อมตัวเลข 0.3% ขนาดใหญ่สีทอง หญิงสาวผมยาวสวมชุดราตรีแดงดำยืนชี้นิ้ว ข้างกายมีวงล้อรูเล็ต ไพ่โพดำคู่เอซ ชิปคาสิโนสีแดง กองเหรียญทอง และกล่องของขวัญ แถบล่างเขียนว่า รับโบนัสสูงสุดทุกวัน ออโต้เข้ากระเป๋าไว มั่นคงปลอดภัย 100% และบริการตลอด 24 ชม."
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#7a0d10]/45 object-contain shadow-[0_10px_30px_rgba(200,17,24,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ebbb4a]/70 hover:shadow-[0_15px_40px_rgba(235,187,74,0.28)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่น SUPERWIN9 พื้นหลังดำแดงประกายทอง โลโก้ SUPERWIN9 ตัวอักษรแดงทองสามมิติ ข้อความ โปรโมชั่น แนะนำเพื่อน รับโบนัส พร้อมตัวเลข 0.8% ขนาดใหญ่สีทอง หญิงสาวผมยาวสวมชุดราตรีแดงดำยืนชี้นิ้ว ข้างกายมีวงล้อรูเล็ต ไพ่เอซสามใบ ชิปคาสิโน กองเหรียญทอง และกล่องของขวัญสีดำคาดโบว์ทอง แถบล่างเขียนว่า แนะนำเพื่อนง่ายๆ เพียงแค่แชร์ลิงก์ให้เพื่อน และเพื่อนเล่นคุณรับโบนัสทันที"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#7a0d10]/45 object-contain shadow-[0_10px_30px_rgba(200,17,24,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ebbb4a]/70 hover:shadow-[0_15px_40px_rgba(235,187,74,0.28)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg bg-gradient-to-r from-[#fbe289] via-[#ebbb4a] to-[#d4a02a] px-10 py-3.5 text-lg font-black text-[#2a0a02] shadow-[0_0_15px_rgba(235,187,74,0.4)] transition-transform hover:scale-105">
          สมัครสมาชิก SUPERWIN9
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
