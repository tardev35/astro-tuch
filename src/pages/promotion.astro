---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

// อาร์ตเวิร์กของ ENTER55 รอบนี้คือ slide1/slide2/slide3 (ลงวันที่ 2026-09-18) ทั้งสามใบ
// slide1 = "โปรโมชั่น คืนยอดเสีย 0.3%" · slide2 = "โปรโมชั่น แนะนำเพื่อน 0.8%" ·
// slide3 = "แทงหวย 2ตัว จ่าย 100บาท / แทงหวย 3ตัว จ่าย 1,000บาท"
// slide4.png (2026-08-13) กับ banner2/banner3 ยังอยู่บนดิสก์แต่เป็นอาร์ตเวิร์กของลูกค้า
// เจ้าอื่น — ห้าม import ที่นี่เด็ดขาด ห้ามลบไฟล์ทิ้งด้วย
// (ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้ว และ verify-build จะแดง)
import promoCashback from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";
import promoLotto from "../assets/slide3.png";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็น IMAGE page: ContentBox title, ย่อหน้าเกริ่นสั้น ๆ หนึ่งย่อหน้า, กริดโปสเตอร์,
// ปุ่ม CTA หนึ่งปุ่ม — ไม่มีหัวข้อย่อยและไม่มีย่อหน้าเพิ่ม เพราะตัวโปสเตอร์ระบุเงื่อนไข
// ของแต่ละโปรโมชั่นไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว เป้าหมาย h1×1, h2×0, h3×0
//
// Announcement รอบนี้หมุนมาใช้ Announcement3 ทั้งเว็บ — default message ของไฟล์นั้น
// เป็นข้อความของ ENTER55 อยู่แล้ว จึงเรียกแบบ bare ได้ ห้ามส่ง prop message
//
// พาเลตต์ ENTER55: ทองหลัก #c4a255 เป็นขอบและออร่า ทองประกาย #ebd484 เป็นสต็อปบน
// ของเกรเดียนต์และสี <strong> ทองกลาง #d2b262 เป็นสต็อปกลาง ทองเข้ม #8a6d2c เป็น
// สต็อปล่าง ตัวอักษรบนปุ่มทองเป็นดำหน้าเว็บ #000000 เนื้อความ #ded8cb — แบรนด์นี้มี
// สีเดียวคือทอง แยกชิ้นส่วนด้วยความสว่าง ไม่ใช่ด้วยสีที่สอง
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 157
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "รวมโปรโมชั่น ENTER55 ทั้งแนะนำเพื่อนรับคอมมิชชั่น 0.8% จากทุกยอดการเล่นของเพื่อน คืนยอดเสีย 0.3% ทุกรอบบิล และอัตราจ่ายหวย 2 ตัวบาทละ 100 3 ตัวตรงบาทละ 1,000";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น ENTER55",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});
---

<MainLayout title="โปรโมชั่น ENTER55 คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% และอัตราจ่ายหวย" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น ENTER55" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#ded8cb]">
        หน้านี้รวมโปรโมชั่นที่ ENTER55 แจกให้สมาชิกทุกคน ทั้งคืนยอดเสีย
        <strong class="text-[#ebd484]">0.3%</strong> ทุกรอบบิล แนะนำเพื่อนรับค่าคอมมิชชั่นสูงถึง
        <strong class="text-[#ebd484]">0.8%</strong> จากทุกยอดการเล่นของเพื่อน และอัตราจ่ายหวยออนไลน์ 2 ตัวบาทละ 100 กับ 3 ตัวตรงบาทละ 1,000 โดยเปอร์เซ็นต์ ยอดที่นำมาคำนวณ และวิธีกดรับสิทธิ์ระบุไว้บนภาพแต่ละใบ
        <strong class="text-[#ebd484]">แต่ละรายการมีเงื่อนไขต่างกัน จึงควรอ่านรอบการคำนวณและเงื่อนไขล่าสุดก่อนกดรับทุกครั้ง</strong>
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่นคืนยอดเสีย 0.3% พื้นหลังสีดำสนิทตัดกับลวดลายเส้นทอง ด้านบนเป็นโลโก้ตัวอักษรทองเมทัลลิกว่า ENTER55 ถัดลงมาเป็นข้อความสีทองว่า โปรโมชั่น เหนือคำว่า คืนยอดเสีย และตัวเลขทองขนาดใหญ่มาก 0.3% ด้านข้างเป็นหญิงสาวผมยาวในชุดราตรีสีดำ"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#c4a255]/45 object-contain shadow-[0_10px_30px_rgba(0,0,0,0.75)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ebd484]/75 hover:shadow-[0_15px_40px_rgba(196,162,85,0.35)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อน 0.8% พื้นหลังสีดำมีลายเส้นวงจรสีทอง ด้านบนเป็นโลโก้ตัวอักษรทองเมทัลลิกว่า ENTER55 ถัดลงมาเป็นข้อความสีทองว่า โปรโมชั่น เหนือคำว่า แนะนำเพื่อน และตัวเลขทองขนาดใหญ่มาก 0.8% ด้านข้างเป็นหญิงสาวในชุดราตรีสีดำปักลายทอง"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#c4a255]/45 object-contain shadow-[0_10px_30px_rgba(0,0,0,0.75)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ebd484]/75 hover:shadow-[0_15px_40px_rgba(196,162,85,0.35)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoLotto}
          alt="โปสเตอร์อัตราจ่ายหวยออนไลน์ พื้นหลังสีดำกับเส้นทอง ด้านบนเป็นโลโก้ตัวอักษรทองเมทัลลิกว่า ENTER55 ใต้โลโก้เป็นข้อความสองบรรทัดว่า แทงหวย 2ตัว จ่าย 100บาท และ แทงหวย 3ตัว จ่าย 1,000บาท รอบข้างเป็นลูกบอลตัวเลขหวยและหญิงสาวในชุดราตรีสีทอง"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#c4a255]/45 object-contain shadow-[0_10px_30px_rgba(0,0,0,0.75)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ebd484]/75 hover:shadow-[0_15px_40px_rgba(196,162,85,0.35)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก ENTER55"
          class="flex items-center justify-center rounded-lg border border-[#ebd484]/60 bg-gradient-to-r from-[#ebd484] via-[#c4a255] to-[#8a6d2c] px-10 py-3.5 text-lg font-black text-[#000000] shadow-[0_0_15px_rgba(196,162,85,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก ENTER55
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
