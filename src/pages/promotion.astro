---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxCyberCut.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

// Only slide1/slide2 belong to UFAFOX, and they are exactly the two promotions
// this page shows: slide1 is the "แนะนำเพื่อน 0.8%" poster and slide2 is the
// "คืนยอดเสีย 0.3%" poster (read off the artwork itself).
// slide3/slide4 are still on disk but belong to previous clients — they may not
// be imported here, now or on any future rebrand (an unrendered import is still
// emitted into dist/).
import promoReferral from "../assets/slide1.png";
import promoCashback from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";

// This is an IMAGE page: the ContentBox title, ONE short intro paragraph, the
// poster grid, one CTA. No section headings, no extra prose — the posters
// already state every offer in large type.
//
// 150–160 CHARACTERS (not bytes — a byte count reads ~3x too long for Thai).
// This one is 153.
const pageDescription =
  "รวมโปรโมชั่น UFAFOX เว็บสล็อต PG ค่ายหลัก ทั้งแนะนำเพื่อนรับ 0.8% และคืนยอดเสีย 0.3% ดูเปอร์เซ็นต์โบนัส ยอดที่นำมาคำนวณ และรอบรับสิทธิ์ได้จากภาพในหน้านี้";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น UFAFOX แนะนำเพื่อน 0.8% คืนยอดเสีย 0.3%",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoReferral.src,
});
---

<MainLayout title="โปรโมชั่น UFAFOX สล็อต PG แนะนำเพื่อน 0.8% คืนยอดเสีย 0.3%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น UFAFOX" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#ded4cb]">
        หน้านี้รวมโปรโมชั่นที่ UFAFOX เปิดให้สมาชิกตรวจสอบสิทธิ์และกดรับผ่านบัญชีของตนเอง ทั้งกิจกรรมแนะนำเพื่อนรับ <strong class="text-[#ffb266]">0.8%</strong>
        และโปรโมชั่นคืนยอดเสีย <strong class="text-[#ffb266]">0.3%</strong> โดยเปอร์เซ็นต์โบนัส ยอดที่นำมาคำนวณ และรอบเวลารับสิทธิ์ระบุไว้บนภาพโปรโมชั่นแต่ละใบ
        แต่ละรายการมีวิธีคำนวณและเงื่อนไขต่างกัน จึงควรอ่านรายละเอียดล่าสุดหรือสอบถามแอดมินก่อนกดรับทุกครั้ง
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อนของ UFAFOX พื้นหลังสีดำมีประกายไฟสีส้ม ด้านบนเป็นโลโก้หัวจิ้งจอกสีส้มคู่กับตัวอักษรโครเมียมคำว่า UFAFOX กลางภาพเป็นข้อความสีขาวว่า โปรโมชั่น แนะนำเพื่อน พร้อมตัวเลขสีเงินขนาดใหญ่ 0.8% ด้านซ้ายมีแผ่นสัญลักษณ์ SCATTER มังกรทอง แผ่น WILD ลูกเต๋าสีส้ม มงกุฎ และเหรียญทองลอยอยู่ ด้านขวาเป็นผู้หญิงผมสีเงินในชุดสีส้มดำชี้นิ้วขึ้น ถัดไปเป็นวงล้อสล็อตเลข 777 และป้าย PG"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#4a2409]/70 object-contain shadow-[0_10px_30px_rgba(7,4,3,0.55)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f26a02]/70 hover:shadow-[0_15px_40px_rgba(242,106,2,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่นคืนยอดเสียของ UFAFOX พื้นหลังสีดำมีประกายไฟและเหรียญทอง ด้านบนเป็นโลโก้หัวจิ้งจอกสีส้มคู่กับตัวอักษรโครเมียมคำว่า UFAFOX กลางภาพเป็นข้อความสีขาวว่า โปรโมชั่น คืนยอดเสีย พร้อมตัวเลขสีส้มขนาดใหญ่ 0.3% ด้านซ้ายเป็นผู้หญิงผมสีเงินในชุดสีส้มดำแบมือ ฉากหลังเป็นป้าย JACKPOT ด้านขวาเป็นตู้สล็อตเลข 777 และสัญลักษณ์ BAR ด้านล่างมีสามป้ายเขียนว่า เสียเท่าไหร่ก็ได้คืน มั่นคง ปลอดภัย เชื่อถือได้ และ ระบบออโต้ รับคืนไว"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#4a2409]/70 object-contain shadow-[0_10px_30px_rgba(7,4,3,0.55)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f26a02]/70 hover:shadow-[0_15px_40px_rgba(242,106,2,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#f26a02]/70 bg-gradient-to-r from-[#ffb266] via-[#f26a02] to-[#8c3a01] px-10 py-3.5 text-lg font-black text-[#070403] shadow-[0_0_15px_rgba(242,106,2,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก UFAFOX
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
