---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

// ดรอปรอบนี้ (2026-10-22, .claude/brand-spec-ufabet168.md §5) มีสไลด์ที่ใช้ได้
// **สองใบ** และชื่อตัวแปรตั้งตามข้อความที่พิมพ์อยู่บนภาพจริง (เปิดบิตแมปอ่านเอง
// แล้วรอบนี้) ไม่ใช่ตามเลขไฟล์ — ถ้ารอบหน้าเจอความขัดแย้ง **ให้เชื่อข้อความบนรูป**:
//   slide2.png (mtime 10-22) — โปสเตอร์ "โปรโมชั่น / คืนยอดเสีย 0.3%"
//   slide1.png (mtime 10-22) — โปสเตอร์ "โปรโมชั่น / แนะนำเพื่อน 0.8%"
//   slide3.png / slide4.png (mtime 2026-09-29) — โปสเตอร์ของแบรนด์คนละราย
//     **ห้าม import** (ถอดออกไปหลายรอบแล้ว อย่าดึงกลับ)
// ⚠️ การจับคู่พลิกไปมาระหว่างดรอป เพราะ uploader เขียนทับ slide1/slide2 ทุกครั้ง
// เลขไฟล์จึงไม่มีความหมายข้ามแบรนด์ ต้องเปิดบิตแมปดูทุกรอบ (รอบนี้สลับกับรอบก่อน:
// รอบก่อน slide1 เป็นคืนยอดเสีย รอบนี้ slide1 เป็นแนะนำเพื่อน)
// ⚠️ eager import = emit ลง dist/ ต่อให้ไม่ได้ render และ verify-build จะแดง
// การ import ไฟล์เก่าคือการส่งรูปของลูกค้ารายอื่นขึ้นเว็บนี้
// **ห้ามลบไฟล์เก่าทิ้ง** — เป็นอินเวนทอรีของรอบถัดไป แค่ห้าม import
// (banner2 mtime 10-08 / banner3 mtime 09-27 ก็เช่นกัน ส่วน banner1 /
// banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักชื่อไว้เอง —
// ห้ามอ้างจากหน้านี้) รอบนี้จึงไม่มี article illustration
import promoCashback from "../assets/slide2.png";
import promoReferral from "../assets/slide1.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้นๆ ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมด
// ของหน้านี้, กริดภาพโปรโมชั่น, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อยและห้ามเพิ่มย่อหน้า
// เพราะโปสเตอร์ระบุเปอร์เซ็นต์ของตัวเองด้วยตัวอักษรขนาดใหญ่อยู่แล้ว การพิมพ์ซ้ำ
// ด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ บรีฟรอบนี้ (src/assets/content.txt)
// ไม่มีส่วน SUB-PAGES เลย ย่อหน้าทุกย่อหน้าที่เคยอยู่บนหน้านี้จึงเป็นของที่รีแบรนด์
// รอบก่อนๆ แต่งขึ้นเอง — รอบนี้คงไว้เพียงย่อหน้าเกริ่นเดียว และเขียนขึ้นใหม่จากบรีฟ
// (content.txt บรรทัด 7-12) ไม่ใช่ find-and-replace ทับประโยคของรอบก่อน
//
// ลำดับในกริดตามลำดับของบรีฟ: คืนยอดเสีย 0.3% (บรรทัด 9-10) มาก่อน
// แนะนำเพื่อน 0.8% (บรรทัด 11-12) → promoCashback (slide2) อยู่ช่องแรก
// ⚠️ บิตแมปจริงของดรอปนี้คือ **540x600 แนวตั้ง** (ไม่ใช่จัตุรัสและไม่ใช่แนวนอน)
// ความกว้างสูงสุดคือ 540 widths จึงหยุดที่ 540 และคุมที่ max-w-[540px] ตามสเปก
// **ให้วัดใหม่ทุกรอบ อย่าเชื่อสัดส่วนของรอบก่อน**
// sizes คิดจากความกว้างที่ถูกวาดจริง: section px-4 (16px/ข้าง) + การ์ด p-8
// (32px/ข้าง, เป็น p-10 = 40px ที่ md ขึ้นไป) + gap-6 ระหว่างคอลัมน์ (24px)
//   ใต้ 640px = คอลัมน์เดียว → 100vw-96px
//   640-767px = สองคอลัมน์ p-8 → 50vw-60px
//   768-1215px = สองคอลัมน์ p-10 → 50vw-68px
//   ตั้งแต่ 1216px ขึ้นไปชนเพดาน 540px
// LCP คือ hero ใน MainLayout ไม่ใช่รูปพวกนี้ จึง loading="lazy" fetchpriority="low"
// decoding="async" และ quality ตัวเดียวทั้ง avif/webp — ห้ามจูนแยกฟอร์แมต
// (tools/avif-quality-service.mjs ย่อฝั่ง avif ให้เองที่ x0.65)
//
// quality={64} ไม่ใช่ 80 ตามปกติ: สไลด์ทั้งสองเป็นอาร์ตมืดเกรนละเอียด (ไฟสปอตไลต์
// ในสนามกลางคืน กองเหรียญทองซ้อนกัน ผิว/ผม และตัวอักษรสามมิติที่มีไฮไลต์)
// ซึ่งเป็นเคสที่ AVIF ทำได้แย่ที่สุด ที่ quality=80 ไฟล์ AVIF มีโอกาสออกมา
// **ใหญ่กว่า** WebP ที่เป็น fallback ของตัวเอง เบราว์เซอร์ที่รองรับ AVIF จะหยิบ
// ไฟล์ที่หนักกว่าไปใช้ และ verify-build.mjs ทำให้ build แดงด้วยเหตุนี้ตรงๆ ·
// ทางแก้คือ quality ที่ **ต่ำลง** ไม่ใช่สูงขึ้น · ค่าเดียวกันนี้ต้องใช้ที่
// index.astro กับสไลด์คู่เดียวกัน
//
// Announcement รอบนี้หมุนมาเป็น Announcement3 ทั้งเว็บ (brand-spec §3 —
// รอบก่อนใช้ AnnouncementPremium จึงหมุนออก) orchestrator ตั้ง default
// message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว และทุกหน้าเรียกแบบ bare
// เหมือนกัน จึงห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกันระหว่างหน้า
//
// 🚨 พาเลตรอบนี้ (brand-spec-ufabet168.md §2) **กลับมาเป็นธีมมืด** หลังสามรอบติด
// ที่เป็นธีมสว่าง bg.json ของดรอปนี้คือ {"mode":"color","color":"#000000"} = ดำสนิท
// **ห้าม "แก้" กลับไปเป็นพื้นสว่างเพราะรอบก่อนๆ เป็นแบบนั้น**
// ลำดับผิว: ผิวการ์ด #15130f (ContentBox) / อินเซ็ต #0a0908 / อินเซ็ตอุ่น #1e1a13 /
// พื้นเพจ #000000
// หมึกครีม #eae3d4 = เนื้อความ (= BRAND_TEXT ที่ <html> และการ์ด ContentBox
// ตั้งให้แล้ว ย่อหน้าจึงไม่ประกาศสีของตัวเอง 14.6:1 บนผิวการ์ด) ·
// ทองคานารี #fee45d = **สีเดียว** ที่ <strong> ในเนื้อความใช้ได้ (14.8:1)
// ทองกลาง #e6a416 = ขอบรูป / ออรา / stop กลางของปุ่ม (8.7:1)
// ทองลึก #b8780d = stop ปลายของปุ่ม + ขอบหนัก (5.2:1)
// ⚠️⚠️ **ทองมืด (7a4e05) และโครเมียมมืด (5a6472) ห้ามถือตัวอักษร** เป็นขอบ/ออรา
// เท่านั้น
// ปุ่ม CTA ของหน้านี้เป็น **PRIMARY = ไล่เฉดทอง** #fee45d → #e6a416 → #b8780d
// บนหมึกเข้ม **#140e02** (15.1 / 8.7 / 5.3:1 ผ่านทุก stop) — **ห้ามสลับเป็น
// ตัวอักษรขาวบนพื้นทอง** ตรงกับปุ่มสมัครสมาชิกที่ /contact-us /ทางเข้า /register
// rgba() ที่อนุญาตรอบนี้: rgba(254,228,93,α) · rgba(230,164,22,α) ·
// rgba(168,178,191,α) · rgba(0,0,0,α)
// · <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ
// ถ้าเปิด/ปิดกลางคำ บรรทัดจะตัดกลางคำ และ <strong> สองตัวห้ามติดกัน
// ⚠️ กับดักรอบนี้คือ **ทองถูกใช้มาแล้วเกือบทุกแบรนด์ในรีโปนี้** การเจอ "ทอง" ในไฟล์นี้
// จึงไม่พิสูจน์อะไรเลย ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน brand-spec §2 (ค่าของ
// แบรนด์เก่าไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive ใน
// คอมเมนต์ของไฟล์นี้เอง) แบรนด์ก่อนหน้าทันที (โปรดี168) เป็นแดงเชอร์รี่ + ทองแดงไหม้
// บนธีมสว่างชมพู ซึ่งกวาดออกครบแล้วจากไฟล์นี้ และรอบนี้ **ไม่มีแดง ไม่มีเขียว
// ไม่มีชมพู ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง ไม่มีโรสโกลด์ และไม่มีทองแดงไหม้**
// สีที่สองของรอบนี้คือ **โครเมียมเงิน** (#e8ecf1 / #a8b2bf / #78828f) ซึ่งมาจาก
// เลข "168" ในโลโก้จริง
//
// ⚠️ แกนของแบรนด์รอบนี้คือ **เว็บพนันออนไลน์ครบวงจร — แทงบอล + สล็อต + บาคาร่า**
// เว็บตรง100% ไม่ผ่านม้า **ไม่ใช่เว็บสล็อตล้วนแบบรอบก่อน และไม่ใช่เว็บลอตเตอรี**
// รายการคำที่ห้ามใช้อยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่
// สองหน้าหมวดลอตเตอรี **ยังปิดอยู่รอบนี้** (อยู่ใน src/pages-disabled/)
// ห้ามลิงก์ไปสองเส้นทางนั้นจากหน้านี้ — route ไม่มีอยู่จริง build จะแดง
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 100% · 24ชม. · 3 ขั้นตอน
// ห้ามแต่งยอดฝากขั้นต่ำ ชื่อธนาคาร ชื่อค่ายเกม ค่า RTP เลขใบอนุญาต ปีก่อตั้ง
// หรือจำนวนสมาชิก และต้องคงประโยคกำกับของบรีฟไว้ว่า
// **ก่อนเข้าร่วมควรอ่านประกาศล่าสุดให้ครบถ้วน**
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) หน้านี้ยาว 158 อักขระด้วยชื่อแบรนด์ 8 ตัวของรอบนี้
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `โปรโมชั่น ${BRAND_NAME} รวมภาพประกาศสิทธิ์สมาชิกไว้ในหน้าเดียว ทั้งคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% แต่ละรายการมีเงื่อนไขต่างกัน ควรอ่านประกาศล่าสุดก่อนเข้าร่วม`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่น ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});

// ความกว้างที่ถูกวาดจริงของแต่ละคอลัมน์ในกริดสองคอลัมน์ (ดูคอมเมนต์ sizes ด้านบน)
const promoSizes = "(max-width: 639px) calc(100vw - 96px), (max-width: 767px) calc(50vw - 60px), (max-width: 1215px) calc(50vw - 68px), 540px";

const promoClass =
  "mx-auto h-auto w-full max-w-[540px] rounded-xl border border-[#e6a416]/55 object-contain shadow-[0_0_28px_rgba(254,228,93,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fee45d]/85 hover:shadow-[0_0_40px_rgba(254,228,93,0.32)]";

// alt ทั้งสองเขียนจากบิตแมปของดรอปนี้ที่เปิดอ่านเองแล้ว (540x600 **แนวตั้ง** ทั้งคู่) —
// ฉากอัฒจันทร์สนามฟุตบอลกลางคืน ไฟสปอตไลต์ คู่ชาย-หญิงผมบลอนด์ชุดบอลดำ-ทอง
// ลูกฟุตบอล ป้ายสามมิติทองคำว่า โปรโมชั่น และกองเหรียญทอง
// ⚠️ องค์ประกอบของอาร์ตเวิร์กแบรนด์ก่อนๆ ที่ต้องไม่หลงเหลือใน alt อยู่ครบใน
// brand-spec §1 (ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive)
// ⚠️ alt คือ "ข้อความที่พิมพ์อยู่บนโปสเตอร์" เป็นหลัก — ตัวเลขท้าย alt ต้องตรงกับรูป
// ⚠️ ห้ามเรียกรูปคู่นี้ว่าภาพแนวนอนหรือภาพสี่เหลี่ยมจัตุรัส รอบนี้เป็นแนวตั้ง
// ⚠️ สีของวัตถุในรูป (ขาว-ดำของลูกฟุตบอล ฟ้าของจอหลัง สีผิวและสีผมนักแสดง)
// เป็นวัตถุในภาพ ไม่ใช่สีของแบรนด์ และไม่เข้ามาใน UI
const altCashback = `โปสเตอร์โปรโมชั่นแนวตั้ง ฉากอัฒจันทร์สนามฟุตบอลกลางคืน มีไฟสปอตไลต์ส่องจากด้านหลังบนพื้นหลังเกือบดำ มุมซ้ายบนเป็นโลโก้ ${BRAND_NAME} ลูกฟุตบอลขาวดำลายทองพร้อมหางวงโคจรทอง ฝั่งซ้ายเป็นผู้หญิงผมบลอนด์ สวมชุดกีฬาดำ-ทองที่พิมพ์ชื่อแบรนด์ไว้ที่อก ยกลูกฟุตบอลลายดำ-ทองไว้ข้างไหล่ ฝั่งขวาเป็นผู้ชายผมบลอนด์ สวมเสื้อบอลดำ-ทองพิมพ์ชื่อแบรนด์ กลางภาพเป็นป้ายสามมิติสีทองอร่ามอ่านว่า โปรโมชั่น มีมงกุฎทองเล็กอยู่ริมซ้ายของป้าย ใต้ป้ายเป็นแถบดำขอบทองเขียนว่า คืนยอดเสีย ต่อด้วยตัวเลข 0.3% สีทองตัวโต รอบภาพเป็นลูกฟุตบอลดำ-ทองและกองเหรียญทองซ้อนกันเต็มขอบล่าง`;

const altReferral = `โปสเตอร์โปรโมชั่นแนวตั้ง ฉากอัฒจันทร์สนามฟุตบอลกลางคืน มีไฟสปอตไลต์ส่องจากด้านหลังบนพื้นหลังเกือบดำ มุมซ้ายบนเป็นโลโก้ ${BRAND_NAME} ลูกฟุตบอลขาวดำลายทองพร้อมหางวงโคจรทอง ฝั่งซ้ายเป็นผู้หญิงผมบลอนด์ สวมชุดกีฬาดำ-ทองที่พิมพ์ชื่อแบรนด์ไว้ที่อก ยกลูกฟุตบอลขาว-ดำไว้ข้างศีรษะ ฝั่งขวาเป็นผู้ชายผมบลอนด์ สวมเสื้อบอลดำ-ทองพิมพ์ชื่อแบรนด์ กำหมัดชูขึ้น กลางภาพเป็นป้ายสามมิติสีทองอร่ามอ่านว่า โปรโมชั่น มีมงกุฎทองวางอยู่ด้านบนของป้าย ใต้ป้ายเป็นแถบดำขอบทองเขียนว่า แนะนำเพื่อน ต่อด้วยตัวเลข 0.8% สีทองตัวโต รอบภาพเป็นลูกฟุตบอลดำ-ทองและกองเหรียญทองซ้อนกันเต็มขอบล่าง`;
---

<MainLayout title={`โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน โบนัส 0.8%`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`รวมโปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} as="h1">
    <div class="flex flex-col gap-10">
      <p>
        หน้านี้รวมภาพประกาศโปรโมชั่นของ {BRAND_NAME} ไว้ในที่เดียว ทั้ง
        <strong class="text-[#fee45d]">รายการคืนยอดเสีย 0.3% เข้ายูสทุกวัน และโบนัสแนะนำเพื่อน 0.8% ไม่จำกัด</strong>
        โดยอัตราและชื่อรายการระบุไว้บนภาพด้านล่างแล้ว แต่ละรายการอาจมีเงื่อนไขเรื่องประเภทเกม ยอดที่นำมาคำนวณ และรอบเวลารับเครดิตแตกต่างกัน
        <strong class="text-[#fee45d]">ก่อนเข้าร่วมควรอ่านประกาศล่าสุดให้ครบถ้วน รวมถึงตรวจสอบข้อจำกัดจำนวนบัญชีและการใช้โปรโมชั่นร่วมกัน</strong>
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt={altCashback}
          loading="lazy"
          fetchpriority="low"
          widths={[270, 405, 540]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />

        <Picture
          src={promoReferral}
          alt={altReferral}
          loading="lazy"
          fetchpriority="low"
          widths={[270, 405, 540]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="relative isolate flex items-center justify-center overflow-hidden rounded-lg border border-[#b8780d] bg-gradient-to-b from-[#fee45d] via-[#e6a416] to-[#b8780d] px-10 py-3.5 text-lg font-black text-[#140e02] shadow-[0_0_14px_rgba(254,228,93,0.4)] transition-transform hover:scale-105">
          <span aria-hidden="true" class="absolute inset-x-0 bottom-0 -z-10 h-1/2 bg-gradient-to-t from-[#b8780d]/60 to-transparent"></span>
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
