---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";

import { Picture } from "astro:assets";

// ดรอปนี้ (2026-10-09) มีสไลด์ที่ "ใช้ได้" แค่สองใบ และรอบนี้เปิดอ่านป้ายบนภาพจริง
// ใหม่แล้ว ห้ามเชื่อเลขไฟล์หรือคอมเมนต์ของรอบก่อน (เคยสลับกันมาแล้ว):
//   slide1.png — ป้าย "โปรโมชั่น" แดง-ทองสามมิติ ใต้ป้ายเขียน "คืนยอดเสีย 0.3%"
//   slide2.png — ป้าย "โปรโมชั่น" แดง-ทองสามมิติ ใต้ป้ายเขียน "แนะนำเพื่อน โบนัส 0.8%"
//   slide3.png / slide4.png — โปสเตอร์ลอตเตอรีของแบรนด์อื่นคนละเจ้า (mtime 09-29)
//     ห้าม import กลับมาเด็ดขาด และห้ามลบไฟล์ทิ้งเพราะเป็นอินเวนทอรีของรอบถัดไป
// ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้ว และ verify-build จะแดง
// (banner2 / banner3 ใน src/assets เป็นอาร์ตเวิร์กของแบรนด์ก่อนๆ ห้าม import ส่วน
// banner1 / banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักชื่อไว้เอง
// — ห้ามอ้างจากหน้านี้)
// ชื่อตัวแปรตั้งตามข้อความบนภาพ ไม่ใช่ตามเลขไฟล์ เพื่อไม่ให้รอบหน้าสลับผิดอีก
import promoCashback from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้นๆ "หนึ่งย่อหน้า ประมาณสี่บรรทัด" คือ
// โควตาตัวหนังสือทั้งหมดของหน้านี้, กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อย
// และห้ามเพิ่มย่อหน้า เพราะตัวโปสเตอร์ระบุเปอร์เซ็นต์โบนัสไว้ด้วยตัวอักษรขนาดใหญ่
// อยู่แล้ว การพิมพ์ซ้ำด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ เป้าหมาย h1x1 h2x0 h3x0
//
// สไลด์รอบนี้เป็น **600x600 ทั้งคู่** วางเป็นกริดสองคอลัมน์ คุมความกว้างรวมที่
// max-w-4xl (896px) ทำให้ช่องละ ~436px ไม่ต้องอัปสเกลเกินขนาดไฟล์ต้นทาง widths
// หยุดที่ 600 ตามความกว้างจริงของไฟล์ และคุมภาพต่อใบไว้ที่ max-w-[600px]
// เรียง คืนยอดเสีย 0.3% ก่อน แนะนำเพื่อน 0.8% ตามลำดับของบรีฟ (docx H3 #4 แล้ว #5)
// ซึ่งรอบนี้แปลว่า slide1 มาก่อน slide2
// sizes คิดจากความกว้างที่ถูกวาดจริง: px-4 ของ section (16px/ข้าง) + p-8 ของการ์ด
// (32px/ข้าง, เป็น p-10 = 40px ที่ md ขึ้นไป) + gap-6 (24px) ระหว่างสองคอลัมน์
// LCP คือ hero ใน MainLayout ไม่ใช่สองรูปนี้ จึง loading="lazy" fetchpriority="low"
//
// Announcement รอบนี้หมุนมาเป็น Announcement2 ทั้งเว็บ (รอบก่อนใช้ Announcement3)
// orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว และทุกหน้า
// ก็เรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกัน
// ระหว่างหน้า
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **แดงเสือโคร่ง x ทองถ่านไฟ บนน้ำตาลถ่านเกือบดำ**
// bg.json เป็นสีเดียว #241000 · แดงเสือโคร่ง #e8232a ถือขอบ รางเส้น ออรา และปลาย
// ไล่เฉด ไม่เคยถือตัวอักษร (3.5:1 บนผิวการ์ด) · แดงเรืองไฟ #ff5a46 ได้เฉพาะตัวโต/
// ตัวหนา · ทองถ่านไฟ #f2b705 เป็นสีไฮไลต์ของเนื้อความ · ทองอ่อน #ffd666 เป็นปลาย
// สว่างของไล่เฉดและ hover · ครีมอุ่น #f5cbb0 เป็นตัวอักษรรองบนผิวการ์ด · ทองเข้ม
// #a8730a เป็นขอบเท่านั้น (หมึก #2b0a00 บนมันได้ 4.48:1 = ตก) ปลายเข้มของไล่เฉด
// ปุ่มทองจึงเป็น #c08a0b (6.0:1) · หมึกบนพื้นทองเป็นน้ำตาลเกือบดำ #2b0a00 เท่านั้น ·
// เนื้อความ #fbe8d5 มาจาก BRAND_TEXT ที่ <html> และการ์ด ContentBox ตั้งให้แล้ว
// ย่อหน้าจึงไม่ประกาศสีของตัวเอง
// ⚠️ ห้ามพลิกปุ่มพื้นทองให้เป็นหมึกสว่าง และห้ามวางตัวอักษรบนแดงสด #e8232a
// ชุดสีของแบรนด์ก่อนๆ ออกครบแล้ว ทั้งคลาส Tailwind raw hex และ rgba() (ค่าเดิม
// อยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ
// false positive) ห้ามนำกลับมา
// ⚠️ สองกับดักของรอบนี้: (1) ทองไม่ใช่ตัวบอกว่าถูกแบรนด์ — ทองของรอบก่อนๆ เป็น
// คนละค่ากับ #f2b705 (2) ฮิวของแบรนด์รอบนี้เป็น "สีแดง" และสี่แบรนด์ก่อนก็แดง
// เจอแดงที่ไหนห้ามเหมาว่าเป็นของรอบนี้ ให้เทียบค่าเป็นตัวๆ
//
// แบรนด์นี้เป็น **คลับคนเล่นสล็อตซุปเปอร์ กลุ่มลับคนดังวงการสล็อตออนไลน์** ธีมป่า
// กับเสือโคร่ง ไม่ใช่เว็บลอตเตอรีและไม่ใช่เว็บรวมทุกหมวด คำขายของของแบรนด์ก่อนและ
// ศัพท์หมวดอื่นที่บรีฟไม่ได้เอ่ยห้ามหลงเหลือ (รายการเต็มอยู่ใน brand-spec §6 ไม่พิมพ์
// ซ้ำที่นี่ เพื่อไม่ให้ grep เจอ false positive) ตัวเลขที่บรีฟให้และอ้างได้มีแค่
// 0.3% / 0.8% / 24 ชั่วโมง — เลขพาดหัวของแบรนด์ก่อน (ยอดเดิมพันเริ่มต้นหน่วยบาท)
// ไม่มีอยู่ในบรีฟรอบนี้เลย ห้ามยกมา ค่าเดิมอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่
// ห้ามแต่งยอดฝากขั้นต่ำ ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP เลขใบอนุญาต หรือวันหมดเขต
// และต้องคงคำกำกับของบรีฟไว้ว่าเกมที่ร่วมรายการและวิธีคำนวณโบนัสอาจแตกต่างกัน
// ควรอ่านก่อนกดรับสิทธิ์
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) หน้านี้ยาว 158 อักขระ
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `รวมภาพโปรโมชั่นของ ${BRAND_NAME} คลับคนเล่นสล็อตซุปเปอร์ ทั้งคืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อน รับโบนัสแชร์ลิงก์ 0.8% จากยอดที่เข้าเกณฑ์ตามรอบคำนวณ`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่น ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});

// ความกว้างที่ถูกวาดจริงของแต่ละช่องในกริดสองคอลัมน์ (ดูคอมเมนต์ sizes ด้านบน)
const promoSizes = "(max-width: 639px) calc(100vw - 96px), (max-width: 767px) calc((100vw - 120px) / 2), (max-width: 1007px) calc((100vw - 136px) / 2), 436px";
const promoClass =
  "mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#e8232a]/40 object-contain shadow-[0_0_28px_rgba(232,35,42,0.30)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#e8232a]/85 hover:shadow-[0_0_40px_rgba(242,183,5,0.40)]";
---

<MainLayout title={`โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% จากยอดที่เข้าเกณฑ์`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`โปรโมชั่น ${BRAND_NAME} ทั้งหมด`} as="h1">
    <div class="flex flex-col gap-10">
      <p>
        หน้านี้รวมภาพโปรโมชั่นที่ <strong>{BRAND_NAME}</strong> เปิดให้สมาชิกตรวจสอบสิทธิ์ตามแคมเปญที่เว็บไซต์เปิดให้บริการในแต่ละช่วง โดยเน้นโบนัสคืนยอดเสียและกิจกรรมแนะนำเพื่อน รายละเอียดของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว
        ระบบจะคำนวณจากยอดที่เข้าเกณฑ์ตามรอบก่อนแสดงจำนวนโบนัส <strong>
          เกมที่ร่วมรายการและวิธีคำนวณโบนัสของแต่ละรายการอาจแตกต่างกัน
        </strong> จึงควรเข้าสู่ระบบอ่านรอบคำนวณและข้อกำหนดก่อนกดรับสิทธิ์ทุกครั้ง
      </p>

      <div class="mx-auto grid w-full max-w-4xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt={`ภาพโปรโมชั่นของ ${BRAND_NAME} เป็นฉากป่าโทนแดงกับทอง ฉากหลังเป็นน้ำตกและวิหารหินหลังพุ่มไม้เขียวทึบ มุมซ้ายบนเป็นโลโก้ ${BRAND_NAME} หัวเสือโคร่งเหนือป้ายโล่สีแดง ด้านซ้ายเป็นลูกเสือการ์ตูนคล้องปลอกคอแดงกับเหรียญทองลายรอยเท้ากำลังยกอุ้งเท้า กลางภาพเป็นหญิงสาวผมบลอนด์ในชุดใบไม้สีแดงดำสวมสร้อยเล็บเสือยื่นมือออกมาทางผู้ชม รอบตัวมีเหรียญทองปั๊มลายรอยเท้าร่วงลงมา ด้านล่างเป็นคำว่า โปรโมชั่น ตัวอักษรสามมิติแดง-ทองขนาดใหญ่ และใต้ลงมาเขียนว่า คืนยอดเสีย คู่กับตัวเลข 0.3% ตัวโต`}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoReferral}
          alt={`ภาพโปรโมชั่นของ ${BRAND_NAME} ฉากป่าชุดเดียวกัน มุมซ้ายบนเป็นโลโก้ ${BRAND_NAME} หัวเสือโคร่งเหนือป้ายโล่สีแดง ด้านซ้ายเป็นลูกเสือการ์ตูนยกอุ้งเท้า กลางภาพเป็นหญิงสาวผมบลอนด์ชูกล่องของขวัญสีแดงผูกริบบิ้นทองลายเสือโคร่ง มุมล่างทั้งสองข้างมีกล่องของขวัญแดง-ทองและเหรียญทองลายรอยเท้าวางซ้อนกันอยู่ ด้านล่างเป็นคำว่า โปรโมชั่น ตัวอักษรสามมิติแดง-ทอง และใต้ลงมาเขียนว่า แนะนำเพื่อน โบนัส คู่กับตัวเลข 0.8% ตัวโต`}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#a8730a] bg-gradient-to-b from-[#ffd666] via-[#f2b705] to-[#c08a0b] px-10 py-3.5 text-lg font-black text-[#2b0a00] shadow-[0_0_14px_rgba(242,183,5,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
