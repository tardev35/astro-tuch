---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

// Only slide1/slide2 belong to PLUSPSG, and they are exactly the two promotions
// this page shows: slide1 is the "แนะนำเพื่อน 0.8%" poster, slide2 is the
// "คืนยอดเสีย 0.3%" poster (checked against the artwork, not the filename).
// slide3/slide4 are still on disk but belong to previous clients — they may not
// be imported here, now or on any future rebrand (an unrendered import is still
// emitted into dist/).
import promoReferral from "../assets/slide1.png";
import promoCashback from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";

// This is an IMAGE page: the ContentBox title, ONE short intro paragraph, the
// poster grid, one CTA. No section headings, no extra prose — the posters
// already state every offer in large type.
//
// 150–160 CHARACTERS (not bytes — a byte count reads ~3x too long for Thai).
const pageDescription =
  "รวมโปรโมชั่น PLUSPSG สล็อตแตกโคตรเก่ง ทั้งแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ดูเปอร์เซ็นต์โบนัส ยอดที่ใช้คำนวณ และเงื่อนไขของแต่ละรายการได้จากภาพโปรโมชั่น";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น PLUSPSG แนะนำเพื่อน 0.8% คืนยอดเสีย 0.3%",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoReferral.src,
});
---

<MainLayout title="โปรโมชั่น PLUSPSG สล็อตโบนัสแรง แนะนำเพื่อน 0.8% คืนยอดเสีย 0.3%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น PLUSPSG" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#e9d6ac]">
        หน้านี้รวมโปรโมชั่นที่ PLUSPSG เปิดให้สมาชิกกดรับอยู่ในขณะนี้ ทั้งโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3%
        เปอร์เซ็นต์โบนัส ยอดที่นำมาคำนวณ และรอบเวลาการรับสิทธิ์ระบุไว้บนภาพโปรโมชั่นแต่ละใบ และเงื่อนไขของแต่ละรายการไม่เหมือนกัน
        สมาชิกตรวจสอบสิทธิ์และกดรับโบนัสได้จากบัญชีของตนเอง หรือสอบถามแอดมินผ่าน LINE Official ก่อนตัดสินใจเข้าร่วม
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่นทรงสี่เหลี่ยม พื้นหลังดำแดงประกายทอง มุมบนซ้ายเป็นโลโก้ PLUSPSG กลางภาพเขียนว่า โปรโมชั่นแนะนำเพื่อน 0.8% ด้านขวาเป็นเทพเจ้าแห่งโชคลาภถือทองคู่กับเสือน้อยและตู้สล็อตเลข 777 ป้าย JACKPOT"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#7a0304]/70 object-contain shadow-[0_10px_30px_rgba(226,6,10,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ff4b18]/70 hover:shadow-[0_15px_40px_rgba(226,6,10,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่นทรงสี่เหลี่ยม พื้นหลังดำแดงประกายทอง มุมบนซ้ายเป็นโลโก้ PLUSPSG กลางภาพเขียนว่า โปรโมชั่นคืนยอดเสีย 0.3% ด้านซ้ายเป็นเทพเจ้าแห่งโชคลาภและตู้สล็อตเลข 777 ด้านขวาเป็นเสือน้อยและทับทิมสีแดง"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#7a0304]/70 object-contain shadow-[0_10px_30px_rgba(226,6,10,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ff4b18]/70 hover:shadow-[0_15px_40px_rgba(226,6,10,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#ff4b18]/70 bg-gradient-to-r from-[#ff4b18] via-[#e2060a] to-[#7a0304] px-10 py-3.5 text-lg font-black text-[#fff6e0] shadow-[0_0_15px_rgba(226,6,10,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก PLUSPSG
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
