---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";

import { Picture } from "astro:assets";

// ดรอปนี้ (2026-10-28, brand-spec §6) มีสไลด์ของแบรนด์นี้ **สองใบ** และชื่อตัวแปร
// ตั้งตาม **ข้อความที่พิมพ์อยู่บนภาพจริง** (เปิดบิตแมปอ่านเองรอบนี้ ไม่ได้เชื่อ
// คอมเมนต์เก่า) ไม่ใช่ตามเลขไฟล์ — ถ้ารอบหน้าเจอความขัดแย้ง **ให้เชื่อข้อความบนรูป**:
//   slide1.png (375x600, mtime 2026-10-28) — โปสเตอร์ "อัตราจ่าย 3 ตัว จ่าย 1,000 บาท"
//   slide2.png (375x600, mtime 2026-10-28) — โปสเตอร์ "อัตราจ่าย 2 ตัว จ่าย 100 บาท"
// 🚨 **เลขท้ายชื่อไฟล์กับตัวเลขบนภาพสลับกันโดยตั้งใจรอบนี้** (slide1 = 3 ตัว,
// slide2 = 2 ตัว) uploader เขียนทับไฟล์ชื่อเดิมทุกดรอป **เลขไฟล์จึงไม่มีความหมาย
// ข้ามแบรนด์** ต้องเปิดบิตแมปดูใหม่ทุกรอบ
//   สไลด์ใบที่สามและสี่ (mtime 2026-09-29 = คนละดรอป คนละแบรนด์) — **ห้าม import**
//   แบนเนอร์ใบที่สองและสาม (mtime 2026-10-23 = อาร์ตเวิร์กของอีกแบรนด์) —
//     **ห้าม import** รอบนี้ไม่มี "รูปประกอบบทความ" เลย
//   (ชื่อไฟล์เต็มของทั้งสี่อยู่ใน brand-spec §6 — ไม่พิมพ์ที่นี่ เพื่อให้ grep หา
//    การ import ที่หลงเหลือได้คำตอบว่างจริงๆ)
// ⚠️ eager import = emit ลง dist/ ต่อให้ไม่ได้ render และ verify-build จะแดง
// การ import ไฟล์เก่าคือการส่งรูปของลูกค้ารายอื่นขึ้นเว็บนี้
// **ห้ามลบไฟล์เก่าทิ้ง** — เป็นอินเวนทอรีของรอบถัดไป แค่ห้าม import
// (banner1 / banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักชื่อไว้เอง —
// ห้ามอ้างจากหน้านี้) รอบนี้หน้านี้จึงมีเฉพาะสไลด์สองใบ กริดจึงเป็นสองช่อง
import promoThreeDigit from "../assets/slide1.png";
import promoTwoDigit from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5 · brand-spec §7):
// ContentBox title หนึ่งอัน (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้นๆ ประมาณสี่บรรทัด
// คือโควตาตัวหนังสือทั้งหมดของหน้านี้, กริดภาพสองใบ, ปุ่ม CTA หนึ่งปุ่ม —
// **ห้ามมีหัวข้อย่อยและห้ามเพิ่มย่อหน้า** เพราะโปสเตอร์พิมพ์ตัวเลขอัตราจ่ายของตัวเอง
// ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว การพิมพ์ซ้ำด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่
// บรีฟรอบนี้ (src/assets/content.txt, 29 บรรทัด) **ไม่มีส่วน SUB-PAGES เลย**
// ทุกย่อหน้าที่เคยอยู่บนหน้านี้คือของที่รีแบรนด์รอบก่อนๆ แต่งขึ้นเอง
//
// 🚨🚨 รอบนี้เป็น **เว็บหวย** ไม่ใช่คาสิโน บรีฟไม่มีหมวดโปรโมชั่น/โบนัส/คืนยอดเสีย/
// แนะนำเพื่อนเลยสักคำ → หน้านี้จึงเป็น "หน้ารวมภาพอัตราจ่าย" ไม่ใช่หน้าโปรโมชั่น
// ในความหมายของแบรนด์ก่อน คำว่า "โปรโมชั่น" เหลืออยู่ได้เฉพาะในฐานะ **ชื่อเมนูและ
// ชื่อ breadcrumb ของ route /promotion** เท่านั้น ไม่ใช่คำบรรยายเนื้อหา
// ตัวเลขที่อยู่บนหน้านี้ได้มีแค่ของบรีฟเอง: 100 · 1,000 · 2 ตัว · 3 ตัว
// ⚠️ ประโยคกำกับของบรีฟ (ควรตรวจสอบฐานเงินเดิมพันที่ใช้คำนวณอัตราจ่าย วงเงินจ่าย
// สูงสุด และตารางอัตราจ่ายล่าสุดก่อนยืนยันบิล) **ต้อง ship ครบใน intro** ห้ามตัด
//
// ลำดับในกริด: **2 ตัว ก่อน 3 ตัว** ตามลำดับของบรีฟ (content.txt บรรทัด 9 แล้ว 11)
// = slide2 ก่อน slide1 **ยึดบรีฟ ไม่ใช่เลขไฟล์**
// ⚠️⚠️ **บิตแมปจริงของดรอปนี้คือ 375x600 แนวตั้ง** ทั้งสองใบ (วัดจาก IHDR รอบนี้)
// ความกว้างสูงสุดคือ 375 widths จึงหยุดที่ 375 และคุมที่ max-w ที่ 375px
// **ให้วัดใหม่ทุกรอบจากไฟล์จริง อย่าเชื่อสัดส่วนของรอบก่อน และห้ามขยายเกินต้นฉบับ**
// sizes คิดจากความกว้างที่ถูกวาดจริง: section px-4 (16px/ข้าง) + การ์ด p-8
// (32px/ข้าง, เป็น p-10 = 40px ที่ md ขึ้นไป) + gap-6 ระหว่างคอลัมน์ (24px)
//   ใต้ 640px = คอลัมน์เดียว → 100vw-96px
//   640-767px = สองคอลัมน์ p-8 → 50vw-60px
//   768-885px = สองคอลัมน์ p-10 → 50vw-68px
//   ตั้งแต่ 886px ขึ้นไปชนเพดาน 375px
// LCP คือ hero ใน MainLayout ไม่ใช่รูปพวกนี้ จึง loading="lazy" fetchpriority="low"
// decoding="async" และ quality ตัวเดียวทั้ง avif/webp — ห้ามจูนแยกฟอร์แมต
// (tools/avif-quality-service.mjs ย่อฝั่ง avif ให้เองที่ x0.65)
//
// quality={64} ไม่ใช่ 80 ตามปกติ: สไลด์ทั้งสองเป็นภาพถ่ายคนในฉากอิ่มสี บวก
// ตัวอักษรไทยสามมิติผิวมันเงาตัดขอบคมที่มีไฮไลต์ทับอยู่ด้านบน ซึ่งเป็นเคสที่
// AVIF ทำได้แย่ที่สุด ที่ quality=80 ไฟล์ AVIF มีโอกาสออกมา **ใหญ่กว่า** WebP ที่เป็น
// fallback ของตัวเอง เบราว์เซอร์ที่รองรับ AVIF จะหยิบไฟล์ที่หนักกว่าไปใช้ และ
// verify-build.mjs ทำให้ build แดงด้วยเหตุนี้ตรงๆ · ทางแก้คือ quality ที่ **ต่ำลง**
// ไม่ใช่สูงขึ้น · ค่าเดียวกันนี้ต้องใช้ที่ index.astro กับสไลด์ใบเดียวกัน
//
// Announcement รอบนี้หมุนมาเป็นตัวท้ายชื่อหวย ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ตัวท้ายชื่อพรีเมียมจึงหมุนออก · เขียนชื่อ variant แบบไม่มีเครื่องหมายคำพูด
// โดยตั้งใจ เพราะ tools/gen-tw-sources.mjs นับ literal ที่มีเครื่องหมายคำพูดว่าเป็น
// การ import จริง คอมเมนต์จึงทำให้ variant เก่าหลุดเข้า Tailwind scan แล้วสีของ
// แบรนด์ก่อนขึ้น stylesheet) orchestrator ตั้ง default message ของไฟล์นั้นเป็น
// คอปปี้ของแบรนด์นี้ไว้แล้ว และทุกหน้าเรียกแบบ bare เหมือนกัน จึง **ห้ามส่ง prop message**
//
// ───────────────────────────────────────────────────────────────────────────
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) **กลับทิศ 180° จากรอบก่อน: รอบนี้สว่างทั้งเว็บ**
// bg.json ของดรอปนี้คือ {"mode":"color","color":"#e1fef3"} = **เขียวมินต์จางเกือบขาว**
// (รอบก่อน WIN8S เป็นดำอมเลือดหมู ซึ่งอยู่คนละปลายของสเกล — อ่านจากไฟล์ทุกรอบ ห้ามเดา)
// **ห้าม "แก้" การ์ดกลับไปเป็นผิวเข้ม** — ผิวเข้มบนหมึก #0d3326 = ตัวอักษรหายไปเลย
// ลำดับผิว: พื้นเพจ #e1fef3 / การ์ด ContentBox #ffffff / การ์ดสำรอง #f0fdf7 /
// พื้นถมอ่อน #d2f3e4 / เส้นบาง #a3ddc3 · ขอบตกแต่ง/ออรา #19a97c · ออราสว่าง #2fd49b
// (**สี่ค่าหลังห้ามถือตัวอักษรทุกกรณี**)
// หมึก #0d3326 = เนื้อความ (= BRAND_TEXT ที่ <html> และการ์ด ContentBox ตั้งให้แล้ว
// 13.8:1 บนการ์ด) · หมึกรอง #3f6f5c (6.0:1) · ทองเข้ม #8a6508 (5.4:1)
// เขียวมรกต #046c4e = สีของ <strong> ในเนื้อความ หัวข้อ และลิงก์ (6.7:1 บนการ์ด)
// 🚨🚨 **#e2b32a (ทองอำพัน) ได้แค่ 2.0:1 บนการ์ดขาว — บนหน้านี้เป็นพื้น/ขอบเท่านั้น**
// ปุ่ม CTA ของหน้านี้เป็น **PRIMARY = ไล่เฉดเขียวมรกต** #0c7c58 → #046c4e → #03543c
// บนหมึก **ขาว #ffffff** (5.2 / 6.7 / 9.2:1 ต่อ stop — ผ่าน AA ทุก stop)
// ⚠️⚠️ **ห้ามดันปลายอ่อนขึ้นไปถึง #19a97c** (ขาวบนค่านั้นเหลือ 3.0:1) และ
// **ห้ามใช้หมึกเข้ม #0d3326 บนปุ่มนี้** (ตกทุก stop)
// rgba() ที่อนุญาตรอบนี้: rgba(4,108,78,α) · rgba(25,169,124,α) ·
// rgba(47,212,155,α) · rgba(226,179,42,α) · rgba(13,51,38,α) · rgba(5,46,34,α)
// ⚠️⚠️ **เงาบนการ์ดสว่างต้องเบา** — ค่า alpha ของรอบก่อนถูกสำหรับการ์ดเข้ม แต่บน
// ผิวขาวจะกลายเป็นคราบเทาหนา รอบนี้ใช้ rgba(13,51,38,0.10) และ hover
// rgba(4,108,78,0.18) **ห้ามลอก alpha ของรอบก่อนมา**
// ⚠️⚠️ กับดักที่แหลมที่สุดรอบนี้คือ **เขียว/ทองของแบรนด์อื่น** ซึ่งเป็นตระกูลเดียวกับ
// รอบนี้เป๊ะ (ตระกูล Huay แดง-ทอง · LOTTO189 แบรนด์หวยเหมือนกัน · TEVA69 · ZORO365)
// ที่ห้ามคือ **ค่าเฮกซ์ของแบรนด์เก่าแบบตรงหกหลัก** ไม่ใช่ "สีเขียว" ในฐานะตระกูลสี
// ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน brand-spec §2 ห้ามตัดสินด้วยสายตา
// (ค่าของ WIN8S รอบก่อนทันทีที่ต้องไม่หลงเหลือ เขียนแบบไม่มี # โดยตั้งใจ:
//  1e0101 2a0a04 3b130b 5a2410 8a3a12 250604 140302 f27a1a e8620e f0a21e e5a92b
//  c9d2dc fdf0e6 e0bda4 รวมถึงรูปแบบ rgba ของค่าเหล่านั้นด้วย)
// · ชุดไทยทอง-เขียวมรกต เครื่องประดับทองฝังพลอยเขียว ยอดปรางค์ทอง ดอกลีลาวดีขาว
// และสีผิวนางแบบในอาร์ตเวิร์กเป็น **วัตถุในภาพ ไม่ใช่สี UI**
// · พื้นเพจมาจาก bg.json เท่านั้น **ห้ามอนุมานจากรูป**
// · <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ
// ถ้าเปิด/ปิดกลางคำ บรรทัดจะตัดกลางคำ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -c บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงนี้ยาว 155 ด้วยชื่อแบรนด์ 9 อักขระของรอบนี้
// (**ต้องนับใหม่ทุกรอบ** ห้ามสืบทอดความยาว — รอบก่อนชื่อยาว 5)
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `รวมภาพอัตราจ่ายหวย ${BRAND_NAME} ทั้ง 2 ตัว จ่าย 100 และ 3 ตัว จ่าย 1,000 ไว้ในหน้าเดียว ควรตรวจสอบฐานเงินเดิมพันและวงเงินจ่ายสูงสุดจากตารางล่าสุดก่อนยืนยันบิล`;

const graph = pageGraph(Astro, {
  name: `รวมภาพอัตราจ่ายหวย ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoTwoDigit.src,
});

// ความกว้างที่ถูกวาดจริงของแต่ละคอลัมน์ในกริดสองคอลัมน์ (ดูคอมเมนต์ sizes ด้านบน)
const promoSizes = "(max-width: 639px) calc(100vw - 96px), (max-width: 767px) calc(50vw - 60px), (max-width: 885px) calc(50vw - 68px), 375px";

const promoClass =
  "mx-auto h-auto w-full max-w-[375px] rounded-xl border border-[#a3ddc3] object-contain shadow-[0_8px_28px_rgba(13,51,38,0.10)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#19a97c] hover:shadow-[0_12px_40px_rgba(4,108,78,0.18)]";

// alt ทั้งสองเขียนจากบิตแมปของดรอปนี้ที่เปิดอ่านเองแล้ว (**375x600 แนวตั้ง** ทั้งคู่) —
// ฉากโทนขาวครีม มียอดปรางค์ทองแบบไทยและดอกลีลาวดีขาวกลางเหลืองเป็นฉากหลัง หญิงสาว
// ผมยาวสีเข้มในชุดไทยผ้าทอทอง-ครีมปักลาย สวมสร้อย กำไล และเครื่องประดับผมทองฝัง
// พลอยเขียว · เวิร์ดมาร์กสามมิติสองบรรทัดอยู่มุมบนขวาทั้งสองใบ บรรทัดบนผิวโครเมียมเงิน
// โดยตัว O ตัวที่สองถูกแทนด้วยใบโคลเวอร์สี่แฉกสีเขียวมรกต บรรทัดล่างผิวเขียวมรกต ·
// ตัวอักษรไทยสามมิติผิวเขียวมรกตตัดขอบทองว่า อัตราจ่าย · ตัวเลขตัวโตสามมิติผิวทอง
// ตัดขอบเข้ม · แคปซูลพื้นเข้มขอบทองท้ายภาพเขียนว่า สมัครสมาชิก พร้อมไอคอนรูปคนกับ
// เครื่องหมายบวกและลูกศรคู่ · ลูกบอลหวยสีเขียว-ขาวพิมพ์ตัวเลขที่ขอบล่าง
// ⚠️ alt คือ "ข้อความที่พิมพ์อยู่บนโปสเตอร์" เป็นหลัก — ตัวเลขท้าย alt ต้องตรงกับรูป
// ⚠️ ห้ามเรียกรูปคู่นี้ว่าภาพแนวนอนหรือภาพสี่เหลี่ยมจัตุรัส รอบนี้เป็น **แนวตั้ง**
// ⚠️ จุดที่ **ต่างกันจริงระหว่างสองใบ** และต้องเขียนให้ตรง (ตรวจจากบิตแมปรอบนี้):
//   slide1 (3 ตัว 1,000) — นางแบบ **พนมมือไหว้** มีดอกไม้ขาวประดับผม **ไม่มีพัด**
//     และมี **มงกุฎทองวางอยู่เหนือคำว่า อัตราจ่าย**
//   slide2 (2 ตัว 100) — นางแบบ **ถือพัดพับสีทอง** ขึ้นมาข้างใบหน้า **ไม่มีมงกุฎ**
//     เหนือคำว่า อัตราจ่าย
//   **ห้ามเขียนว่ามีทั้งพัดและการพนมมือในใบเดียวกัน** และห้ามลอก alt ของรอบก่อน
//     (รอบก่อนเป็นฉากห้องญี่ปุ่นกับกิโมโนและร่มซากุระ คนละอาร์ตเวิร์กกันคนละเรื่อง —
//      องค์ประกอบของแบรนด์ก่อนๆ ที่ต้องไม่หลงเหลืออยู่ครบใน brand-spec §6)
// ⚠️ ห้ามระบุว่าใช้มือซ้ายหรือมือขวา — รอบก่อนๆ เขียนไว้แล้วผิดหลายรอบติด
// ⚠️ สีของวัตถุในรูป (ชุดไทยทอง-ครีม พลอยเขียว ยอดปรางค์ทอง) เป็นวัตถุในภาพ
// ไม่ใช่สีของแบรนด์
// 🚨 **ห้ามพิมพ์ตัวอักษรของชื่อแบรนด์ลงใน alt** ให้บรรยาย "รูปร่าง" ของเวิร์ดมาร์ก
// แล้วเรียกชื่อแบรนด์ผ่าน BRAND_NAME เท่านั้น (brand-spec §6)
const altTwoDigit = `โปสเตอร์อัตราจ่ายแนวตั้ง มุมบนขวาเป็นโลโก้ ${BRAND_NAME} แบบเวิร์ดมาร์กสามมิติสองบรรทัด บรรทัดบนเป็นผิวโครเมียมเงินขัดเงาโดยตัว O ตัวที่สองถูกแทนด้วยใบโคลเวอร์สี่แฉกสีเขียวมรกต บรรทัดล่างเป็นผิวเขียวมรกตไล่เงา ฝั่งซ้ายเป็นหญิงสาวผมยาวสีเข้มในชุดไทยผ้าทอสีทองครีมปักลาย สวมสร้อย กำไล และเครื่องประดับผมทองฝังพลอยเขียว ถือพัดพับสีทองขึ้นมาข้างใบหน้า ฉากหลังเป็นยอดปรางค์ทองแบบไทยและดอกลีลาวดีขาวกลางเหลือง ครึ่งขวาเป็นตัวอักษรไทยสามมิติผิวเขียวมรกตตัดขอบทองอ่านว่า อัตราจ่าย ใต้ลงมาเป็นคำว่า 2 ตัว จ่าย ตัวขาว แล้วตัวเลข 100 ตัวโตสามมิติผิวทองตัดขอบเข้ม ต่อท้ายด้วยคำว่า บาท ปิดท้ายด้วยแคปซูลพื้นเข้มขอบทองเขียนว่า สมัครสมาชิก พร้อมไอคอนรูปคนกับเครื่องหมายบวกและลูกศรคู่ ขอบล่างมีลูกบอลหวยสีเขียว-ขาวพิมพ์ตัวเลข`;

const altThreeDigit = `โปสเตอร์อัตราจ่ายแนวตั้ง มุมบนขวาเป็นโลโก้ ${BRAND_NAME} แบบเวิร์ดมาร์กสามมิติสองบรรทัด บรรทัดบนเป็นผิวโครเมียมเงินขัดเงาโดยตัว O ตัวที่สองถูกแทนด้วยใบโคลเวอร์สี่แฉกสีเขียวมรกต บรรทัดล่างเป็นผิวเขียวมรกตไล่เงา ฝั่งซ้ายเป็นหญิงสาวผมยาวสีเข้มในชุดไทยผ้าทอสีทองครีมปักลาย สวมเครื่องประดับทองฝังพลอยเขียวและมีดอกไม้ขาวประดับผม ยกมือขึ้นพนมไหว้ ฉากหลังเป็นยอดปรางค์ทองแบบไทยและดอกลีลาวดีขาวกลางเหลือง ครึ่งขวาเป็นตัวอักษรไทยสามมิติผิวเขียวมรกตตัดขอบทองอ่านว่า อัตราจ่าย โดยมีมงกุฎทองวางอยู่ด้านบน ใต้ลงมาเป็นคำว่า 3 ตัว จ่าย ตัวขาว แล้วตัวเลข 1,000 ตัวโตสามมิติผิวทองตัดขอบเข้ม ต่อท้ายด้วยคำว่า บาท ปิดท้ายด้วยแคปซูลพื้นเข้มขอบทองเขียนว่า สมัครสมาชิก พร้อมไอคอนรูปคนกับเครื่องหมายบวกและลูกศรคู่ ขอบล่างมีลูกบอลหวยสีเขียว-ขาวพิมพ์ตัวเลข`;
---

<MainLayout title={`รวมภาพอัตราจ่ายหวย ${BRAND_NAME} 2 ตัว จ่าย 100 และ 3 ตัว จ่าย 1,000`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`รวมภาพอัตราจ่ายหวย ${BRAND_NAME}`} as="h1">
    <div class="flex flex-col gap-10">
      <p>
        หน้านี้รวมภาพอัตราจ่ายที่ {BRAND_NAME} ระบุไว้สำหรับหวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยหุ้น ไว้ในที่เดียว โดยตัวเลขอัตราจ่ายของแต่ละรายการพิมพ์อยู่บนภาพแล้ว ทั้งนี้
        <strong class="text-[#046c4e]">
          ควรตรวจสอบฐานเงินเดิมพันที่ใช้คำนวณอัตราจ่าย ประเภทหวยที่เข้าร่วม เลขอั้น รอบปิดรับ และวงเงินจ่ายสูงสุด จากตารางอัตราจ่ายล่าสุดของเว็บไซต์ทางการก่อนยืนยันบิลทุกครั้ง
        </strong>
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoTwoDigit}
          alt={altTwoDigit}
          loading="lazy"
          fetchpriority="low"
          widths={[250, 375]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />

        <Picture
          src={promoThreeDigit}
          alt={altThreeDigit}
          loading="lazy"
          fetchpriority="low"
          widths={[250, 375]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="relative isolate flex items-center justify-center overflow-hidden rounded-lg border border-[#19a97c] bg-gradient-to-b from-[#0c7c58] via-[#046c4e] to-[#03543c] px-10 py-3.5 text-lg font-black text-[#ffffff] shadow-[0_8px_22px_rgba(4,108,78,0.30)] transition-transform hover:scale-105">
          <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-white/10 to-transparent"></span>
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
