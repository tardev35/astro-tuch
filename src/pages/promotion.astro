---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

// ดรอปรอบนี้ (2026-10-20, brand-spec §5) มีสไลด์ที่ใช้ได้ **สองใบ** และชื่อตัวแปร
// ตั้งตามข้อความที่พิมพ์อยู่บนภาพจริง (เปิดบิตแมปอ่านเองแล้วรอบนี้) ไม่ใช่ตามเลขไฟล์ —
// ถ้ารอบหน้าเจอความขัดแย้ง **ให้เชื่อข้อความบนรูป**:
//   slide2.png — โปสเตอร์ "โปรโมชั่น / คืนยอดเสีย 0.3%"
//   slide1.png — โปสเตอร์ "โปรโมชั่น / แนะนำเพื่อน 0.8%"
//   slide3.png / slide4.png (mtime 2026-09-29) — โปสเตอร์ของ LOTTOPLUS ซึ่งเป็น
//     แบรนด์คนละรายโดยสิ้นเชิง **ห้าม import** (รอบก่อนถอดออกไปแล้ว อย่าดึงกลับ)
// ⚠️ การจับคู่พลิกไปมาระหว่างดรอป (รอบ รวยแทร่168 เคยเป็น slide1 = คืนยอดเสีย)
// จึงห้ามเชื่อการจับคู่ของรอบก่อน ต้องเปิดบิตแมปดูทุกรอบ
// ⚠️ eager import = emit ลง dist/ ต่อให้ไม่ได้ render และ verify-build จะแดง
// การ import ไฟล์เก่าคือการส่งรูปของลูกค้ารายอื่นขึ้นเว็บนี้
// **ห้ามลบไฟล์เก่าทิ้ง** — เป็นอินเวนทอรีของรอบถัดไป แค่ห้าม import
// (banner2 / banner3 ก็เช่นกัน ส่วน banner1 / banner1-mobile / og.png เป็นของ glob
// ที่ MainLayout ปักชื่อไว้เอง — ห้ามอ้างจากหน้านี้) รอบนี้จึงไม่มี article illustration
import promoCashback from "../assets/slide2.png";
import promoReferral from "../assets/slide1.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้นๆ ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมด
// ของหน้านี้, กริดภาพโปรโมชั่น, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อยและห้ามเพิ่มย่อหน้า
// เพราะโปสเตอร์ระบุเปอร์เซ็นต์ของตัวเองด้วยตัวอักษรขนาดใหญ่อยู่แล้ว การพิมพ์ซ้ำ
// ด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ บรีฟรอบนี้ (src/assets/content.txt)
// ไม่มีส่วน SUB-PAGES เลย ย่อหน้าทุกย่อหน้าที่เคยอยู่บนหน้านี้จึงเป็นของที่รีแบรนด์
// รอบก่อนๆ แต่งขึ้นเอง — รอบนี้คงไว้เพียงย่อหน้าเกริ่นเดียว และเขียนขึ้นใหม่จากบรีฟ
// (content.txt บรรทัด 7-12) ไม่ใช่ find-and-replace ทับประโยคของรอบก่อน
//
// ลำดับในกริดตามลำดับของบรีฟ: คืนยอดเสีย 0.3% (บรรทัด 9-10) มาก่อน แนะนำเพื่อน 0.8%
// (บรรทัด 11-12) · บิตแมปจริง 600x600 ทั้งคู่ (จัตุรัส — ดรอปก่อนเป็นแถบ 600x200
// วัดใหม่ทุกรอบ) → widths หยุดที่ 600 และคุมที่ max-w-[600px]
// sizes คิดจากความกว้างที่ถูกวาดจริง: section px-4 (16px/ข้าง) + การ์ด p-8
// (32px/ข้าง, เป็น p-10 = 40px ที่ md ขึ้นไป) + gap-6 ระหว่างคอลัมน์ (24px)
//   ใต้ 640px = คอลัมน์เดียว → 100vw-96px
//   640-767px = สองคอลัมน์ p-8 → 50vw-60px
//   768-1335px = สองคอลัมน์ p-10 → 50vw-68px
//   ตั้งแต่ 1336px ขึ้นไปชนเพดาน 600px
// LCP คือ hero ใน MainLayout ไม่ใช่รูปพวกนี้ จึง loading="lazy" fetchpriority="low"
// decoding="async" และ quality ตัวเดียวทั้ง avif/webp — ห้ามจูนแยกฟอร์แมต
// (tools/avif-quality-service.mjs ย่อฝั่ง avif ให้เองที่ x0.65)
//
// quality={64} ไม่ใช่ 80 ตามปกติ และเป็นค่าที่ "วัดมา" ไม่ใช่ค่าที่ชอบ: สไลด์ทั้งสองเป็น
// อาร์ตทองบนพื้นดำที่มีเกรนละเอียดเยอะ (เหรียญทองร่วง ประกายดาว ริ้วแสงวูบวาบ) ซึ่งเป็น
// เคสที่ AVIF ทำได้แย่ที่สุด ที่ quality=80 ไฟล์ AVIF ออกมา **ใหญ่กว่า** WebP ที่เป็น
// fallback ของตัวเองทุกความกว้างของทั้งสองรูป เบราว์เซอร์ที่รองรับ AVIF จะหยิบไฟล์ที่
// หนักกว่าไปใช้ และ verify-build.mjs ทำให้ build แดงด้วยเหตุนี้ตรงๆ · ทางแก้คือ quality
// ที่ **ต่ำลง** ไม่ใช่สูงขึ้น ค่าเดียวกันนี้ใช้ที่ index.astro กับสไลด์คู่เดียวกัน
//
// Announcement รอบนี้หมุนมาเป็น Announcement3 ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ AnnouncementPremium จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้น
// เป็นคอปปี้ของแบรนด์นี้ไว้แล้ว และทุกหน้าเรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop
// message มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกันระหว่างหน้า
//
// พาเลตต์รอบนี้ (brand-spec §2) = **ทองสองเฉด + บรอนซ์ บนพื้นดำสนิท ไม่มีสีที่สอง
// ที่เป็นคนละวงศ์** bg.json ของดรอปนี้คือ {"mode":"color","color":"#000000"}
// ลำดับผิว: #33200a ยก (การ์ด ContentBox) / #1f1304 กลาง / #0a0601 จม / #000000 พื้นเพจ
// ทองอำพันน้ำผึ้ง #d4922c เป็นฮิวนำ ถือขอบรูป ออรา พื้นถมปุ่ม และเป็นสีเดียวที่
// <strong> ในเนื้อความใช้ได้ (สงวนไว้งานเดียวนี้) · ทองเลมอน #fdfc71 เป็นต้นสว่าง
// ของเกรเดียนต์และสี hover ของขอบ · **บรอนซ์ #a25b24 ได้แค่ 3.0:1 บนผิวการ์ด =
// ตก AA ทุกพื้น** จึงเป็น **สีขอบ/พื้นถม/ไอคอนเท่านั้น ห้ามถือตัวอักษร** ·
// ครีมทอง #f6e3b4 เป็นตัวอักษรรอง · หมึกบนพื้นถมทอง/เลมอนคือ #1a1000 (7.1:1 / 17.3:1)
// เนื้อความ #fbf6e3 มาจาก BRAND_TEXT ที่ <html> และการ์ด ContentBox ตั้งให้แล้ว
// ย่อหน้าจึงไม่ประกาศสีของตัวเอง และไม่ใส่ mx-auto / max-w-* กับย่อหน้า
// · <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ
// ถ้าเปิด/ปิดกลางคำ บรรทัดจะตัดกลางคำ และ <strong> สองตัวห้ามติดกัน
// ⚠️ #5a3310 และ #1a1000 ห้ามถือตัวอักษรบนพื้นเข้มทุกขนาด ใช้ได้เฉพาะเส้น ขอบ ออรา
// และพื้นถม · ออราในไฟล์นี้ใช้ rgba(212,146,44,α) · rgba(253,252,113,α) เท่านั้น
// ⚠️ กับดักรอบนี้คือ **ทอง** เพราะ **ทองเคยนำมาแล้วเกือบทุกแบรนด์** การเจอ "ทอง"
// ในไฟล์นี้จึงไม่พิสูจน์อะไรเลย ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน brand-spec §2
// (ค่าของแบรนด์เก่าไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive)
// และรอบนี้ **ไม่มีแดง ไม่มีฟ้า/น้ำเงิน ไม่มีม่วง ไม่มีเขียว ไม่มีเงิน/โครเมียม
// ไม่มีโรสโกลด์ ไม่มีชมพู/ฟูเชีย และไม่มีส้มสด** — บรอนซ์ #a25b24 เป็นเฉดเงาของทอง
// ไม่ใช่ส้ม
//
// ⚠️ แกนของแบรนด์รอบนี้คือ **แฟนเพจเว็บบอลยูฟ่า = เว็บกีฬา/ฟุตบอลล้วน** รอบก่อน
// เป็นแบรนด์คนละหมวดโดยสิ้นเชิง ศัพท์หมวดของรอบก่อนทุกคำจึงเป็นของค้างที่ต้องไม่
// เหลือแม้แต่คำเดียว สองหน้าหมวดลอตเตอรีจอดอยู่ใน src/pages-disabled/ ไม่มี route
// ลิงก์ค้างจะเป็น href ตายที่ทำให้บิลด์แดง (รายการคำเต็มอยู่ใน brand-spec §6
// ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์นี้เอง)
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% / 0.8% / 24ชม. / 3 ขั้นตอน — ห้ามแต่งยอดฝาก
// ขั้นต่ำ ชื่อธนาคาร ค่า RTP เลขใบอนุญาต จำนวนสมาชิก หรือปีก่อตั้ง และต้องคงประโยค
// กำกับของบรีฟไว้ว่า **ควรอ่านรายละเอียดจากประกาศล่าสุดก่อนเข้าร่วม**
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) หน้านี้ยาว 158 อักขระ
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `รวมภาพโปรโมชั่นของ ${BRAND_NAME} ไว้ในหน้าเดียว ทั้งคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% แต่ละรายการมีเงื่อนไขต่างกัน ควรอ่านรายละเอียดจากประกาศล่าสุดก่อนเข้าร่วม`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่น ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});

// ความกว้างที่ถูกวาดจริงของแต่ละคอลัมน์ในกริดสองคอลัมน์ (ดูคอมเมนต์ sizes ด้านบน)
const promoSizes = "(max-width: 639px) calc(100vw - 96px), (max-width: 767px) calc(50vw - 60px), (max-width: 1335px) calc(50vw - 68px), 600px";

const promoClass =
  "mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#d4922c]/55 object-contain shadow-[0_0_28px_rgba(212,146,44,0.3)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fdfc71]/85 hover:shadow-[0_0_40px_rgba(253,252,113,0.45)]";

// alt ทั้งสองเขียนจากบิตแมปของดรอปนี้ที่เปิดอ่านเองแล้ว (600x600 ทั้งคู่) — ฉากพื้นดำ
// อัฒจันทร์กลางคืน โลโก้หัวสิงโตสวมมงกุฎ หญิงสาวผมสั้นบลอนด์เงินชุดดำ-ทอง ลูกฟุตบอล
// ดำ-ทอง มงกุฎทอง และเหรียญทอง ⚠️ องค์ประกอบของอาร์ตเวิร์กแบรนด์ก่อนๆ ที่ต้องไม่
// หลงเหลือใน alt อยู่ครบใน brand-spec §5 (ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของ
// รอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง)
// ⚠️ จอมือถือในภาพเปิดหน้าเว็บเดิมพันของผู้ให้บริการรายอื่น — alt บรรยายว่าเป็น
// "หน้าเว็บเดิมพันฟุตบอล" ไม่พิมพ์ชื่อนั้นลงหน้าเว็บ เพราะบรีฟไม่ได้เอ่ยถึง
const altCashback = `โปสเตอร์โปรโมชั่นจัตุรัสพื้นดำ มุมบนซ้ายเป็นโลโก้ ${BRAND_NAME} รูปหัวสิงโตทองสวมมงกุฎอยู่เหนือตัวอักษรทองสามมิติ กลางขวาเป็นหญิงสาวผมสั้นสีบลอนด์เงิน สวมชุดดำ-ทองเงาวาวและโช้กเกอร์ทองจี้สิงโต ยกแขนขึ้นเหนือศีรษะ ด้านซ้ายเป็นมงกุฎทอง ลูกฟุตบอลลายดำ-ทอง และกองเหรียญทอง ฉากหลังเป็นอัฒจันทร์กลางคืนกับริ้วแสงทอง ด้านล่างเป็นคำว่า โปรโมชั่น ตัวอักษรไทยสามมิติสีทองตัวโตมีมงกุฎเล็กวางอยู่ด้านบน ใต้ลงมาเป็นแถบโค้งเขียนว่า คืนยอดเสีย ตัวอักษรสีขาว ต่อด้วยตัวเลข 0.3% สีทองตัวโต`;

const altReferral = `โปสเตอร์โปรโมชั่นจัตุรัสพื้นดำ มุมบนซ้ายเป็นโลโก้ ${BRAND_NAME} รูปหัวสิงโตทองสวมมงกุฎอยู่เหนือตัวอักษรทองสามมิติ กลางขวาเป็นหญิงสาวผมสั้นสีบลอนด์เงิน สวมชุดดำ-ทองเงาวาวและโช้กเกอร์ทองจี้สิงโต ยกแขนขึ้นเหนือศีรษะ ด้านหลังมีมือถือที่เปิดหน้าเว็บเดิมพันฟุตบอล และกล่องของขวัญสีดำผูกโบว์ทอง ด้านซ้ายเป็นมงกุฎทอง ลูกฟุตบอลลายดำ-ทอง และกองเหรียญทอง ด้านล่างเป็นคำว่า โปรโมชั่น ตัวอักษรไทยสามมิติสีทองตัวโตมีมงกุฎเล็กวางอยู่ด้านบน ใต้ลงมาเป็นแถบโค้งเขียนว่า แนะนำเพื่อน ตัวอักษรสีขาว ต่อด้วยตัวเลข 0.8% สีทองตัวโต`;
---

<MainLayout title={`โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน โบนัส 0.8%`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`รวมโปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} as="h1">
    <div class="flex flex-col gap-10">
      <p>
        หน้านี้รวมภาพประกาศโปรโมชั่นของ {BRAND_NAME} ไว้ในที่เดียว ทั้ง
        <strong class="text-[#d4922c]">รายการคืนยอดเสีย 0.3% เข้ายูสทุกวัน และโบนัสแนะนำเพื่อน 0.8% ไม่จำกัด</strong>
        โดยอัตราและรูปแบบการรับสิทธิ์ระบุไว้บนภาพด้านล่างแล้ว แต่ละรายการอาจมีเงื่อนไขเกี่ยวกับประเภทการเดิมพัน ยอดที่ใช้คำนวณ และรอบเวลารับเครดิตแตกต่างกัน
        <strong class="text-[#d4922c]">ควรอ่านรายละเอียดจากประกาศล่าสุดและตรวจสอบว่าบัญชีใดมีสิทธิ์รับโปรโมชั่นก่อนเข้าร่วม</strong>
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt={altCashback}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />

        <Picture
          src={promoReferral}
          alt={altReferral}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#a25b24] bg-gradient-to-b from-[#fdfc71] to-[#d4922c] px-10 py-3.5 text-lg font-black text-[#1a1000] shadow-[0_0_14px_rgba(212,146,44,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
