---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

// Only slide1/slide2 belong to FAH999, and they are exactly the two promotions
// this page shows: slide1 is the "คืนยอดเสีย 0.3%" poster, slide2 is the
// "แนะนำเพื่อน 0.8%" poster (checked against the artwork, not the filename).
// slide3/slide4 are still on disk but belong to previous clients — they may not
// be imported here, now or on any future rebrand (an unrendered import is still
// emitted into dist/).
import promoCashback from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";

// This is an IMAGE page: the ContentBox title, ONE short intro paragraph, the
// poster grid, one CTA. No section headings, no extra prose — the posters
// already state every offer in large type.
//
// 150–160 CHARACTERS (not bytes — a byte count reads ~3x too long for Thai).
const pageDescription =
  "รวมโปรโมชั่น FAH999 ทั้งคืนยอดเสีย 0.3% และแนะนำเพื่อนรับคอมมิชชั่น 0.8% ดูเปอร์เซ็นต์โบนัส ยอดที่นำมาคำนวณ และเงื่อนไขการรับสิทธิ์ได้จากภาพโปรโมชั่นในหน้านี้";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น FAH999 คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8%",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});
---

<MainLayout title="โปรโมชั่น FAH999 คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น FAH999" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#e6cfe9]">
        หน้านี้รวมโปรโมชั่นที่ FAH999 เปิดให้สมาชิกตรวจสอบสิทธิ์ผ่านบัญชีผู้ใช้งาน ทั้งโบนัสคืนยอดเสีย <strong class="text-[#c98cff]">0.3%</strong> ตามรอบประจำวัน
        และคอมมิชชั่นแนะนำเพื่อน <strong class="text-[#c98cff]">0.8%</strong> ตามเงื่อนไข เปอร์เซ็นต์โบนัส ยอดที่นำมาคำนวณ และรอบเวลาการรับสิทธิ์ระบุไว้บนภาพโปรโมชั่นแต่ละใบ
        แต่ละรายการมีวิธีคำนวณและข้อกำหนดการถอนต่างกัน จึงควรอ่านรายละเอียดล่าสุดหรือสอบถามแอดมินผ่าน LINE Official ก่อนกดรับทุกครั้ง
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่นพื้นหลังคาสิโนแสงนีออนสีชมพูม่วง ด้านบนเป็นโลโก้โพดำ FAH999 กลางภาพเป็นกรอบนีออนเขียนว่า โปรโมชั่น คืนยอดเสีย 0.3% ด้วยตัวเลขใหญ่สีขาว ด้านขวาเป็นผู้หญิงผมบลอนด์ในชุดซาตินสีชมพูยืนแบมือ ด้านซ้ายเป็นหีบสมบัติเหรียญทอง กองชิปคาสิโน อัญมณีสีชมพู ไพ่เอซโพดำสองใบ และวงล้อสล็อตเลข 777 ส่วนมุมขวาบนเป็นป้ายนีออนคำว่า BIG WIN และมงกุฎ"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#6b1fa8]/70 object-contain shadow-[0_10px_30px_rgba(194,36,155,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fb44b3]/70 hover:shadow-[0_15px_40px_rgba(251,68,179,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่นพื้นหลังคาสิโนแสงนีออนสีชมพูม่วง ด้านบนเป็นโลโก้โพดำ FAH999 กลางภาพเขียนว่า โปรโมชั่น แนะนำเพื่อน 0.8% ด้วยตัวอักษรและตัวเลขใหญ่สีขาว ด้านขวาเป็นผู้หญิงผมบลอนด์ในชุดซาตินสีชมพูสองชิ้นยืนแบมือ ด้านล่างซ้ายเป็นกล่องของขวัญสีชมพูผูกโบว์ เหรียญทอง อัญมณีสีชมพู และกองชิปคาสิโน ฉากหลังเป็นวงล้อสล็อตเลข 777 กับป้ายนีออนคำว่า BIG WIN"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#6b1fa8]/70 object-contain shadow-[0_10px_30px_rgba(194,36,155,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fb44b3]/70 hover:shadow-[0_15px_40px_rgba(251,68,179,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#fb44b3]/70 bg-gradient-to-r from-[#fb44b3] via-[#e0359f] to-[#6b1fa8] px-10 py-3.5 text-lg font-black text-[#0d0114] shadow-[0_0_15px_rgba(251,68,179,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก FAH999
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
