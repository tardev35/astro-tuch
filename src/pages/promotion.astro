---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";

import { Picture } from "astro:assets";

// ดรอปนี้ (2026-10-13, GT66B) มีสไลด์ที่ใช้ได้แค่สองใบ ค่าข้างล่างนี้มาจากการเปิดดู
// รูปจริงด้วยตา ไม่ใช่จากเลขไฟล์ และตรงกับตาราง brand-spec §4 แล้ว ถ้ารอบหน้าเจอ
// ความขัดแย้งอีก **ให้เชื่อข้อความที่พิมพ์อยู่บนรูป**:
//   slide2.png — มุมบนขวาเป็นโลโก้มังกร 龍 GT66B ใต้ลงมาเป็นคำว่า "โปรโมชั่น"
//                ตัวสามมิติขาวเงิน แล้วเป็นแถบป้ายดำขอบแดงเขียนว่า "คืนยอดเสีย"
//                คู่กับเลข "0.3%" ตัวโตสีแดงสด ฉากหลังมีตรามังกรแดงเป็นวงกลม
//   slide1.png — องค์ประกอบชุดเดียวกัน แต่ใต้คำว่า "โปรโมชั่น" (มีมงกุฎทองเล็ก
//                อยู่เหนือตัวอักษร) เป็นแถบป้ายดำขอบแดงที่มีไอคอนคนสองคนกับ
//                เครื่องหมายบวก เขียนว่า "แนะนำเพื่อน" และ "โบนัส 0.8%"
//   slide3.png / slide4.png — โปสเตอร์ของแบรนด์ก่อน (mtime 09-29) ห้าม import
//     กลับมาเด็ดขาด และห้ามลบไฟล์ทิ้งเพราะเป็นอินเวนทอรีของรอบถัดไป
// ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้ว และ verify-build จะแดง
// (banner2 / banner3 ใน src/assets เป็นอาร์ตเวิร์กของแบรนด์ก่อนๆ ห้าม import ส่วน
// banner1 / banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักชื่อไว้เอง
// — ห้ามอ้างจากหน้านี้)
// ชื่อตัวแปรตั้งตามข้อความบนภาพ ไม่ใช่ตามเลขไฟล์ เพื่อไม่ให้รอบหน้าสลับผิดอีก
import promoCashback from "../assets/slide2.png";
import promoReferral from "../assets/slide1.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้นๆ ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมด
// ของหน้านี้, กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อยและห้ามเพิ่มย่อหน้า
// เพราะตัวโปสเตอร์ระบุเปอร์เซ็นต์โบนัสไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว การพิมพ์ซ้ำ
// ด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ บรีฟรอบนี้ (src/assets/content.txt)
// ไม่มีส่วน SUB-PAGES เลย ย่อหน้าทุกย่อหน้าที่เคยอยู่บนหน้านี้จึงเป็นของที่รีแบรนด์
// รอบก่อนๆ แต่งขึ้นเอง — รอบนี้คงไว้เพียงย่อหน้าเกริ่นเดียว
//
// สไลด์รอบนี้เป็น **600x600 ทั้งคู่** วางเป็นกริดสองคอลัมน์ คุมความกว้างรวมที่
// max-w-4xl (896px) ทำให้ช่องละ ~436px ไม่ต้องอัปสเกลเกินขนาดไฟล์ต้นทาง widths
// หยุดที่ 600 ตามความกว้างจริงของไฟล์ และคุมภาพต่อใบไว้ที่ max-w-[600px]
// เรียง คืนยอดเสีย 0.3% ก่อน แนะนำเพื่อน 0.8% ตามลำดับของบรีฟ (docx H3 #4 แล้ว #5)
// ซึ่งรอบนี้แปลว่า **slide2 มาก่อน slide1** ตามข้อความที่พิมพ์อยู่บนรูป ไม่ใช่ตามเลขไฟล์
// sizes คิดจากความกว้างที่ถูกวาดจริง: px-4 ของ section (16px/ข้าง) + p-8 ของการ์ด
// (32px/ข้าง, เป็น p-10 = 40px ที่ md ขึ้นไป) + gap-6 (24px) ระหว่างสองคอลัมน์
// LCP คือ hero ใน MainLayout ไม่ใช่สองรูปนี้ จึง loading="lazy" fetchpriority="low"
//
// Announcement รอบนี้หมุนมาเป็น Announcement2 ทั้งเว็บ (รอบก่อน TKB55 ใช้
// Announcement5 — brand-spec §3 หมุนออก) orchestrator ตั้ง default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว และทุกหน้าก็เรียกแบบ bare เหมือนกัน
// จึงห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกันระหว่างหน้า
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **แดงมังกรนำ โครเมียมขาวรอง บนพื้นดำสนิท**
// bg.json ของดรอปนี้เป็น {"mode":"color","color":"#000000"} ลำดับผิว:
// #1c0c0b ยก (การ์ด ContentBox) / #130c0c กลาง / #0b0303 จม / #000000 พื้นเพจ
// แดงแบรนด์ #fb141b ถือขอบรูปและออรา · แดงสว่าง #ff5f63 เป็นขอบตอน hover และเป็น
// ปลายสว่างของพื้นถมปุ่มหลัก · แดงอ่อน #ffa0a2 เป็นต้นสว่างสุดของพื้นถมปุ่ม และเป็น
// สีไฮไลต์ของ <strong> ในเนื้อความ (สงวนไว้งานเดียวนี้ ไม่ใช้สีอื่นเลย) ·
// หมึกบนพื้นถมแดงเป็น #190505 (5.0:1 บน #fb141b และสูงกว่านั้นบน #ffa0a2) ·
// เนื้อความ #eceaea มาจาก BRAND_TEXT ที่ <html> และการ์ด ContentBox ตั้งให้แล้ว
// ย่อหน้าจึงไม่ประกาศสีของตัวเอง
// · <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ
// ถ้าเปิด/ปิดกลางคำ บรรทัดจะตัดกลางคำ
// ⚠️ #fb141b #db040b #8a0609 #3b0405 ห้ามถือตัวอักษรทุกขนาด ใช้ได้เฉพาะเส้น ขอบ
// ออรา และพื้นถม · ออราใช้ rgba(251,20,27,α) rgba(219,4,11,α) rgba(255,160,162,α)
// rgba(253,252,253,α) เท่านั้น
// ⚠️ กับดักของรอบนี้คือ **แดง**: แบรนด์ก่อนหน้าทันที (TKB55) ก็เป็นแดง-โลหะ-ดำ
// เหมือนกัน และแดงของมันต่างจากรอบนี้แค่หนึ่งหลัก "เจอแดง" จึงไม่ได้แปลว่าเป็นของ
// รอบนี้ ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน brand-spec §2 (ค่าของแบรนด์เก่าไม่
// พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive) และรอบนี้
// **ไม่มีทอง ไม่มีม่วง ไม่มีชมพู ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว ไม่มีส้ม**
// มีแค่แดงกับโครเมียมขาว
//
// แบรนด์นี้เป็น **คาสิโนล้วน** (บาคาร่า ไฮโล สล็อต) ไม่มีหมวดกีฬา ไม่มีหมวด
// ลอตเตอรี (สองหน้าของหมวดนั้นจอดอยู่ใน src/pages-disabled/ ไม่มี route — ลิงก์ค้าง
// จะเป็น href ตายที่ทำให้บิลด์แดง) คำขายของของแบรนด์ก่อนและศัพท์หมวดอื่นที่บรีฟ
// ไม่ได้เอ่ยห้ามหลงเหลือ (รายการเต็มอยู่ใน brand-spec §7 ไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep เจอ false positive)
// ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% / 0.8% / 24 ชั่วโมง — ห้ามแต่งยอดฝากขั้นต่ำ
// ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP เลขใบอนุญาต จำนวนสมาชิก หรือปีก่อตั้ง และต้องคง
// คำกำกับของบรีฟ (บรรทัด 9 ของ content.txt) ไว้ว่า **ควรตรวจสอบว่าโปรโมชั่น
// ครอบคลุมบาคาร่า ไฮโล หรือสล็อตประเภทใดบ้าง เพราะแต่ละกิจกรรมอาจกำหนด
// เงื่อนไขแตกต่างกัน**
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) หน้านี้ยาว 151 อักขระ
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `รวมภาพโปรโมชั่น ${BRAND_NAME} ทั้งคืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อน โบนัส 0.8% ตรวจสอบยอดที่เข้าเกณฑ์ รอบคำนวณ และสถานะการรับสิทธิ์ได้จากบัญชีสมาชิก`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่น ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});

// ความกว้างที่ถูกวาดจริงของแต่ละช่องในกริดสองคอลัมน์ (ดูคอมเมนต์ sizes ด้านบน)
const promoSizes = "(max-width: 639px) calc(100vw - 96px), (max-width: 767px) calc((100vw - 120px) / 2), (max-width: 1007px) calc((100vw - 136px) / 2), 436px";
const promoClass =
  "mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#fb141b]/50 object-contain shadow-[0_0_28px_rgba(251,20,27,0.3)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ff5f63]/85 hover:shadow-[0_0_40px_rgba(255,160,162,0.4)]";
---

<MainLayout title={`โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน โบนัส 0.8%`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`โปรโมชั่น ${BRAND_NAME} ทั้งหมด`} as="h1">
    <div class="flex flex-col gap-10">
      <p>
        หน้านี้รวมภาพโปรโมชั่นที่ <strong class="text-[#ffa0a2]">{BRAND_NAME}</strong> เปิดให้สมาชิกตรวจสอบสิทธิ์ตามกิจกรรมที่เว็บไซต์กำหนด โดยเน้นโบนัสคืนยอดเสียและกิจกรรมแนะนำเพื่อน รายละเอียดของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว
        สมาชิกตรวจสอบยอดที่เข้าเกณฑ์ รอบคำนวณ และสถานะการรับสิทธิ์ได้ผ่านบัญชีสมาชิกตามระบบที่เปิดให้บริการ <strong class="text-[#ffa0a2]">
          ควรตรวจสอบว่าโปรโมชั่นครอบคลุมบาคาร่า ไฮโล หรือสล็อตประเภทใดบ้าง เพราะแต่ละกิจกรรมอาจกำหนดเงื่อนไขแตกต่างกัน
        </strong>
      </p>

      <div class="mx-auto grid w-full max-w-4xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt={`ภาพโปรโมชั่นของ ${BRAND_NAME} เป็นภาพจัตุรัสพื้นดำสนิท ฉากหลังเป็นตรามังกรจีนสีแดงในกรอบวงกลม มุมบนขวาเป็นโลโก้ ${BRAND_NAME} ที่มีอักขระมังกร 龍 สีแดงนำหน้าตัวอักษรโครเมียมขาวสลับแดง ใต้โลโก้เป็นคำว่า โปรโมชั่น ตัวอักษรสามมิติขาวเงินขนาดใหญ่ แล้วเป็นแถบป้ายดำขอบแดงเขียนว่า คืนยอดเสีย คู่กับตัวเลข 0.3% สีแดงสด ฝั่งซ้ายเป็นชายหนุ่มผมขาวเงินในสูทดำปักลาย เคียงหญิงสาวผมขาวเงินในชุดดำคลุมขนเฟอร์ดำ ขอบล่างเป็นโต๊ะคาสิโนที่มีไพ่เอซโพดำสองใบ กองชิปแดงดำขาว และลูกเต๋าแดง`}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoReferral}
          alt={`ภาพโปรโมชั่นของ ${BRAND_NAME} ชุดเดียวกัน พื้นดำสนิทตัดกับลายมังกรแดงจางที่ฉากหลัง มุมบนขวาเป็นโลโก้ ${BRAND_NAME} ที่มีอักขระมังกร 龍 สีแดงนำหน้าตัวอักษรโครเมียมขาวสลับแดง ฝั่งซ้ายเป็นชายหนุ่มผมขาวเงินในเสื้อเชิ้ตดำถือชิปแดง เคียงหญิงสาวผมขาวเงินในชุดเลื่อมดำ กลางภาพเป็นคำว่า โปรโมชั่น ตัวอักษรสามมิติขาวเงินที่มีมงกุฎทองเล็กอยู่เหนือตัวอักษร ใต้ลงมาเป็นแถบป้ายดำขอบแดงที่มีไอคอนคนสองคนกับเครื่องหมายบวก เขียนว่า แนะนำเพื่อน และ โบนัส 0.8% ขอบล่างซ้ายเป็นไพ่เอซสองใบและกองชิปแดงดำที่มีโลโก้มังกรอยู่บนหน้าชิป`}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#db040b] bg-gradient-to-b from-[#ffa0a2] to-[#fb141b] px-10 py-3.5 text-lg font-black text-[#190505] shadow-[0_0_14px_rgba(251,20,27,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
