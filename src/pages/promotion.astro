---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

// เฉพาะ slide1/slide2 (ลงวันที่ 2026-08-26) เท่านั้นที่เป็นอาร์ตเวิร์กของ MEPAY77
// รอบนี้บทบาทสลับกับรอบก่อน: slide1 คือโปสเตอร์ "คืนยอดเสีย 0.3%"
// ส่วน slide2 คือ "แนะนำเพื่อน 0.8%" (อ่านจากตัวภาพจริง ไม่ใช่จากชื่อไฟล์)
// อย่าเชื่อชื่อตัวแปรที่รอบก่อนตั้งไว้ — ให้เปิดรูปดูทุกครั้งที่เปลี่ยนแบรนด์
// slide3/slide4 ยังค้างอยู่บนดิสก์แต่เป็นอาร์ตเวิร์กของลูกค้าก่อนหน้า — ห้าม import ที่นี่
// ทั้งรอบนี้และรอบถัดไป (ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้ว)
import promoCashback from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็น IMAGE page: ContentBox title, ย่อหน้าเกริ่นสั้น ๆ หนึ่งย่อหน้า, กริดโปสเตอร์,
// ปุ่ม CTA หนึ่งปุ่ม — ไม่มีหัวข้อย่อยและไม่มีย่อหน้าเพิ่ม เพราะตัวโปสเตอร์ระบุเงื่อนไข
// ของแต่ละโปรโมชั่นไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 156
const pageDescription =
  "รวมโปรโมชั่นของ MEPAY77 ทั้งแนะนำเพื่อนรับ 0.8% และคืนยอดเสีย 0.3% ดูเปอร์เซ็นต์ ยอดที่นำมาคำนวณ และรอบรับสิทธิ์ได้จากภาพโปรโมชั่นในหน้านี้ก่อนกดรับทุกครั้ง";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น MEPAY77 แนะนำเพื่อน 0.8% คืนยอดเสีย 0.3%",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoReferral.src,
});
---

<MainLayout title="โปรโมชั่น MEPAY77 แนะนำเพื่อนรับ 0.8% และคืนยอดเสียรับ 0.3%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น MEPAY77" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#f1e5cd]">
        หน้านี้รวมโปรโมชั่นที่ MEPAY77 เปิดให้สมาชิกตรวจสอบสิทธิ์และกดรับผ่านบัญชีของตนเอง ทั้งแนะนำเพื่อนรับ
        <strong class="text-[#fdcc5c]">0.8%</strong> และคืนยอดเสีย <strong class="text-[#fdcc5c]">0.3%</strong>
        โดยเปอร์เซ็นต์ ยอดที่นำมาคำนวณ และรอบเวลารับสิทธิ์ระบุไว้บนภาพโปรโมชั่นแต่ละใบ
        แต่ละรายการมีเงื่อนไขต่างกัน จึงควรอ่านรายละเอียดล่าสุดหรือสอบถามแอดมินก่อนกดรับทุกครั้ง
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อนของ MEPAY77 พื้นหลังคาสิโนสีดำน้ำตาลมีลายทองพลิ้วและเหรียญทองปลิวอยู่รอบภาพ โลโก้ MEPAY77 อยู่กลางด้านบน ถัดลงมาเป็นป้ายทองคำว่า โปรโมชั่น เหนือคำว่า แนะนำเพื่อน และตัวเลข 0.8% ขนาดใหญ่ ผู้หญิงในชุดสีทองยืนกอดอกและชี้นิ้วมาที่ตัวเลขทางขวาของภาพ ด้านซ้ายมีกล่องของขวัญผูกโบว์ กองเหรียญทอง และไพ่ ด้านล่างเรียงป้ายทรงแคปซูลสามป้ายว่า ชวนเพื่อนง่าย รับโบนัสทันที รับโบนัส จากยอดเพื่อนเล่น และ มั่นคง ปลอดภัย เชื่อถือได้ 100%"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#a3701c]/70 object-contain shadow-[0_10px_30px_rgba(19,12,1,0.72)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fdcc5c]/70 hover:shadow-[0_15px_40px_rgba(253,204,92,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่นคืนยอดเสียของ MEPAY77 พื้นหลังคาสิโนสีดำน้ำตาลมีลายทองพลิ้วและเหรียญทองปลิวอยู่รอบภาพ โลโก้ MEPAY77 อยู่กลางด้านบน ถัดลงมาเป็นป้ายทองคำว่า โปรโมชั่น เหนือคำว่า คืนยอดเสีย และตัวเลข 0.3% ขนาดใหญ่ ผู้หญิงในชุดสีขาวทองยืนชี้นิ้วมาที่ตัวเลขทางขวาของภาพ ด้านซ้ายมีไพ่เอซสามใบ กล่องของขวัญผูกโบว์ และกองเหรียญทอง ด้านขวามีวงล้อสล็อตที่ขึ้นเลข 777 และ BAR ด้านล่างเรียงป้ายทรงแคปซูลสามป้ายว่า คืนยอดเสียทุกวัน กดรับได้เอง มั่นคง ปลอดภัย เชื่อถือได้ 100% และ รองรับ วอลเลท ทุกธนาคาร"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#a3701c]/70 object-contain shadow-[0_10px_30px_rgba(19,12,1,0.72)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fdcc5c]/70 hover:shadow-[0_15px_40px_rgba(253,204,92,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก MEPAY77"
          class="flex items-center justify-center rounded-lg border border-[#f2ae35]/70 bg-gradient-to-r from-[#fff6e0] via-[#fdcc5c] to-[#a3701c] px-10 py-3.5 text-lg font-black text-[#130c01] shadow-[0_0_15px_rgba(242,174,53,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก MEPAY77
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
