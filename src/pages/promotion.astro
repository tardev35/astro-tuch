---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

// ดรอปรอบนี้ (2026-10-23, brand-spec §1) มีสไลด์ที่ใช้ได้ **สองใบ** และชื่อตัวแปร
// ตั้งตามข้อความที่พิมพ์อยู่บนภาพจริง (เปิดบิตแมปอ่านเองแล้วรอบนี้) ไม่ใช่ตามเลขไฟล์
// — ถ้ารอบหน้าเจอความขัดแย้ง **ให้เชื่อข้อความบนรูป**:
//   slide2.png (mtime 2026-10-23, ดรอปนี้) — โปสเตอร์ "โปรโมชั่น / คืนยอดเสีย 0.3%"
//   slide1.png (mtime 2026-10-23, ดรอปนี้) — โปสเตอร์ "โปรโมชั่น / แนะนำเพื่อน 0.8%"
//   slide3.png / slide4.png (mtime 2026-09-29, **600x334 แนวนอน** = คนละดรอป
//     ชัดเจนแม้แต่ในสัดส่วน) — โปสเตอร์ของแบรนด์คนละราย **ห้าม import**
//     (ถอดออกไปหลายรอบแล้ว อย่าดึงกลับ)
// ⚠️ การจับคู่พลิกไปมาระหว่างดรอป เพราะ uploader เขียนทับ slide1/slide2 ทุกครั้ง
// เลขไฟล์จึงไม่มีความหมายข้ามแบรนด์ ต้องเปิดบิตแมปดูทุกรอบ
// ⚠️ eager import = emit ลง dist/ ต่อให้ไม่ได้ render และ verify-build จะแดง
// การ import ไฟล์เก่าคือการส่งรูปของลูกค้ารายอื่นขึ้นเว็บนี้
// **ห้ามลบไฟล์เก่าทิ้ง** — เป็นอินเวนทอรีของรอบถัดไป แค่ห้าม import
// (banner2 mtime 10-08 / banner3 mtime 09-27 ก็เช่นกัน ส่วน banner1 /
// banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักชื่อไว้เอง —
// ห้ามอ้างจากหน้านี้) รอบนี้จึงไม่มี article illustration
import promoCashback from "../assets/slide2.png";
import promoReferral from "../assets/slide1.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้นๆ ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมด
// ของหน้านี้, กริดภาพโปรโมชั่น, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อยและห้ามเพิ่มย่อหน้า
// เพราะโปสเตอร์ระบุเปอร์เซ็นต์ของตัวเองด้วยตัวอักษรขนาดใหญ่อยู่แล้ว การพิมพ์ซ้ำ
// ด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ บรีฟรอบนี้ (src/assets/content.txt)
// ไม่มีส่วน SUB-PAGES เลย (จบที่บรรทัด 23) ย่อหน้าทุกย่อหน้าที่เคยอยู่บนหน้านี้จึงเป็น
// ของที่รีแบรนด์รอบก่อนๆ แต่งขึ้นเอง — รอบนี้คงไว้เพียงย่อหน้าเกริ่นเดียว และเขียนขึ้น
// ใหม่จากบรีฟ (content.txt บรรทัด 7-12) ไม่ใช่ find-and-replace ทับประโยคของรอบก่อน
//
// ลำดับในกริดตามลำดับของบรีฟ: คืนยอดเสีย 0.3% (บรรทัด 9-10) มาก่อน
// แนะนำเพื่อน 0.8% (บรรทัด 11-12) → promoCashback (slide2) อยู่ช่องแรก
// ⚠️⚠️ **บิตแมปจริงของดรอปนี้คือ 375x600 แนวตั้ง** (วัดจาก IHDR ของไฟล์เองรอบนี้)
// ความกว้างสูงสุดคือ 375 widths จึงหยุดที่ 375 และคุมที่ max-w-[375px]
// **ให้วัดใหม่ทุกรอบจากไฟล์จริง อย่าเชื่อสัดส่วนของรอบก่อน**
// sizes คิดจากความกว้างที่ถูกวาดจริง: section px-4 (16px/ข้าง) + การ์ด p-8
// (32px/ข้าง, เป็น p-10 = 40px ที่ md ขึ้นไป) + gap-6 ระหว่างคอลัมน์ (24px)
//   ใต้ 640px = คอลัมน์เดียว → 100vw-96px
//   640-767px = สองคอลัมน์ p-8 → 50vw-60px
//   768-885px = สองคอลัมน์ p-10 → 50vw-68px
//   ตั้งแต่ 886px ขึ้นไปชนเพดาน 375px (การ์ดเองกว้างสุด 1400px จึงยังไม่ชน
//   เพดานของการ์ดก่อน)
// LCP คือ hero ใน MainLayout ไม่ใช่รูปพวกนี้ จึง loading="lazy" fetchpriority="low"
// decoding="async" และ quality ตัวเดียวทั้ง avif/webp — ห้ามจูนแยกฟอร์แมต
// (tools/avif-quality-service.mjs ย่อฝั่ง avif ให้เองที่ x0.65)
//
// quality={64} ไม่ใช่ 80 ตามปกติ: สไลด์ทั้งสองเป็นภาพถ่ายคนในฉากโถงห้างสรรพสินค้า
// หรูที่ desaturate ทั้งเฟรม มีไล่เฉดนุ่มบนพื้นหินขัดสะท้อนเงาและกระจกหน้าร้านเต็ม
// พื้นหลัง บวกตัวอักษรไทยสามมิติผิวมันเงาที่มีไฮไลต์และขอบคมทับอยู่ด้านบน ซึ่งเป็น
// เคสที่ AVIF ทำได้แย่ที่สุด ที่ quality=80 ไฟล์ AVIF มีโอกาสออกมา **ใหญ่กว่า**
// WebP ที่เป็น fallback ของตัวเอง เบราว์เซอร์ที่รองรับ AVIF จะหยิบไฟล์ที่หนักกว่า
// ไปใช้ และ verify-build.mjs ทำให้ build แดงด้วยเหตุนี้ตรงๆ · ทางแก้คือ quality ที่
// **ต่ำลง** ไม่ใช่สูงขึ้น · ค่าเดียวกันนี้ต้องใช้ที่ index.astro กับสไลด์คู่เดียวกัน
//
// Announcement รอบนี้หมุนมาเป็น AnnouncementPremium ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ AnnouncementCyber จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็น
// คอปปี้ของแบรนด์นี้ไว้แล้ว และทุกหน้าเรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop
// message มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกันระหว่างหน้า
//
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) **ยังเป็นธีมมืดเหมือนรอบก่อน แต่คนละฮิวสิ้นเชิง**
// bg.json ของดรอปนี้คือ {"mode":"color","color":"#00091f"} = น้ำเงินเที่ยงคืนเกือบดำ
// (รอบก่อนเป็น 0d1017 = ถ่านอมน้ำเงินที่เทากว่านี้มาก — อ่านจากไฟล์ทุกรอบ ห้ามเดา)
// **ห้าม "แก้" กลับไปเป็นการ์ดพื้นสว่าง**
// ลำดับผิว: พื้นเพจ #00091f / ผิวจม #050e26 / ผิวการ์ด #0b1733 (ContentBox) /
// ผิวยก #16234a · เส้นขอบ #2a3c70 (**ห้ามถือตัวอักษร**)
// หมึก #f4eef1 = เนื้อความ (= BRAND_TEXT ที่ <html> และการ์ด ContentBox ตั้งให้แล้ว
// ย่อหน้าจึงไม่ประกาศสีของตัวเอง 15.7:1 บนผิวการ์ด) · หมึกรอง #b3bdd6
// แดงคริมสัน #ff2e52 = สีของ <strong> ในเนื้อความ (4.9:1 บนการ์ด) และขอบ hover
// ⚠️⚠️ **น้ำเงินอะซัวร์ #1177e8 / #0e68cc / #0a4ea8 และแดงลึก #c9102f ห้ามถือ
// ตัวอักษร** เป็นพื้นถม/ขอบ/ออราเท่านั้น และ **เส้น #2a3c70 ห้ามถือตัวอักษร**
// ปุ่ม CTA ของหน้านี้เป็น **PRIMARY = ไล่เฉดแดงคริมสัน** #ff2e52 → #e01238 →
// #c9102f บนหมึก **ขาว #ffffff** ตรงกับปุ่มสมัครสมาชิกที่ /contact-us /ทางเข้า
// /register — 🚨 **ห้ามหยุดไล่เฉดที่ #ff2e52 ล้วนแล้ววางหมึกขาว** (3.6:1)
// rgba() ที่อนุญาตรอบนี้: rgba(255,46,82,α) · rgba(224,18,56,α) ·
// rgba(201,16,47,α) · rgba(17,119,232,α) · rgba(14,104,204,α) ·
// rgba(10,78,168,α) · rgba(217,223,233,α) · rgba(0,9,31,α) · rgba(0,0,0,α)
// ⚠️⚠️ **รอบนี้ไม่มีทอง/เหลือง/ส้ม/ครีม/เบจ/น้ำตาล/ม่วง/เขียว/แรมป์เทาเงิน
// เป็นสี UI เลยสักเฉด** ผมสีขาวเงิน สูทขาวครีม สูทดำ โซฟาหนัง พื้นหินขัด และ
// สีผิวนักแสดงในอาร์ตเวิร์กเป็น **วัตถุในภาพ** ไม่ใช่สีของแบรนด์
// · <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ
// ถ้าเปิด/ปิดกลางคำ บรรทัดจะตัดกลางคำ และ <strong> สองตัวห้ามติดกัน
// ⚠️ กับดักรอบนี้คือ **ฟ้าเคยนำมาแล้วเจ็ดแบรนด์ในรีโปนี้ รวมถึงรอบก่อนทันที**
// การเจอ "ฟ้า" ในไฟล์นี้จึงไม่พิสูจน์อะไรเลย ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน
// brand-spec §2 (ค่าของแบรนด์เก่าไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ
// false positive ในคอมเมนต์ของไฟล์นี้เอง) **แดงก็ผ่านรีโปนี้มาหลายเจ้าเช่นกัน**
// แดงรอบนี้คือ #ff2e52 / #e01238 / #c9102f เท่านั้น
//
// ⚠️ แกนของแบรนด์รอบนี้คือ **เว็บเกมสล็อตออนไลน์ + โปรโมชั่นรายวัน + ฝากถอนทุก
// ธนาคาร/ทรูมันนี่** ไม่ใช่แกนของรอบก่อน และไม่ใช่เว็บลอตเตอรี
// รายการคำที่ห้ามใช้อยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่
// สองหน้าหมวดลอตเตอรี **ยังปิดอยู่รอบนี้** (อยู่ใน src/pages-disabled/)
// ห้ามลิงก์ไปสองเส้นทางนั้นจากหน้านี้ — route ไม่มีอยู่จริง build จะแดง
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 24ชม.
// **ไม่มีวลีจำนวนขั้นตอน ไม่มีจำนวนเกม ไม่มีเปอร์เซ็นต์เต็ม และไม่มีอัตราคืนเป็นตัวเลข**
// ห้ามแต่งตัวเลขการเงิน ชื่อธนาคาร ชื่อค่ายเกม เลขใบอนุญาต ปีก่อตั้ง หรือจำนวนสมาชิก
// และต้องคงประโยคกำกับของบรีฟไว้ว่า **แต่ละรายการอาจมีข้อกำหนดเกี่ยวกับยอดที่นำมา
// คำนวณ ประเภทเกมที่เข้าร่วม รอบรับเครดิต และการใช้โบนัสแตกต่างกัน จึงควรตรวจสอบ
// ประกาศล่าสุดทุกครั้ง** (content.txt บรรทัด 8)
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) หน้านี้ยาว 159 อักขระด้วยชื่อแบรนด์ 8 ตัวของรอบนี้
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `โปรโมชั่น ${BRAND_NAME} รวมภาพสิทธิพิเศษสมาชิกไว้ในหน้าเดียว ทั้งคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% แต่ละรายการมีเงื่อนไขต่างกัน ควรอ่านประกาศล่าสุดก่อนกดรับเครดิต`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่น ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});

// ความกว้างที่ถูกวาดจริงของแต่ละคอลัมน์ในกริดสองคอลัมน์ (ดูคอมเมนต์ sizes ด้านบน)
const promoSizes = "(max-width: 639px) calc(100vw - 96px), (max-width: 767px) calc(50vw - 60px), (max-width: 885px) calc(50vw - 68px), 375px";

const promoClass =
  "mx-auto h-auto w-full max-w-[375px] rounded-xl border border-[#2a3c70] object-contain shadow-[0_8px_28px_rgba(0,9,31,0.7)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ff2e52] hover:shadow-[0_12px_40px_rgba(255,46,82,0.3)]";

// alt ทั้งสองเขียนจากบิตแมปของดรอปนี้ที่เปิดอ่านเองแล้ว (**375x600 แนวตั้ง** ทั้งคู่) —
// ฉากโถงห้างสรรพสินค้าหรูที่ desaturate เป็นขาว-ดำทั้งเฟรม หน้าร้านแบรนด์เนมเรียง
// สองฝั่ง พื้นหินขัดมันสะท้อนเงา ผู้หญิงวัยกลางคนผมสั้นดัดลอนสีขาวเงิน ยิ้มกว้าง
// ทาลิปสติกแดง นั่งเท้าคาง · โลโก้มุมบน · ตัวอักษรไทยสามมิติสีฟ้าอมน้ำเงินว่า
// โปรโมชั่น · แคปซูลระบุชื่อรายการ · ตัวเลขเปอร์เซ็นต์ตัวโตสีแดงสด
// ⚠️ องค์ประกอบของอาร์ตเวิร์กแบรนด์ก่อนๆ ที่ต้องไม่หลงเหลือใน alt อยู่ครบใน
// brand-spec §1 (ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive)
// ⚠️ alt คือ "ข้อความที่พิมพ์อยู่บนโปสเตอร์" เป็นหลัก — ตัวเลขท้าย alt ต้องตรงกับรูป
// ⚠️ ห้ามเรียกรูปคู่นี้ว่าภาพแนวนอนหรือภาพสี่เหลี่ยมจัตุรัส รอบนี้เป็น **แนวตั้ง**
// ⚠️ จุดที่ **ต่างกันจริงระหว่างสองใบ** และต้องเขียนให้ตรง: slide2 โลโก้อยู่มุมบนซ้าย
// นักแสดงใส่สูทสีดำ · slide1 โลโก้อยู่มุมบนขวา นักแสดงใส่สูทสีขาวครีม
// ⚠️ สีของวัตถุในรูป (ผมสีขาวเงิน สูทขาวครีม สูทดำ โซฟาหนังดำ และสีผิวนักแสดง)
// เป็นวัตถุในภาพ ไม่ใช่สีของแบรนด์ และไม่เข้ามาใน UI
const altCashback = `โปสเตอร์โปรโมชั่นแนวตั้ง ฉากโถงห้างสรรพสินค้าหรูโทนขาว-ดำ มีหน้าร้านแบรนด์เนมและพื้นหินขัดมันสะท้อนเงาอยู่ด้านหลัง มุมซ้ายบนเป็นโลโก้ของ ${BRAND_NAME} กลางภาพเป็นผู้หญิงวัยกลางคนผมสั้นดัดลอนสีขาวเงิน ยิ้มกว้าง ทาลิปสติกแดง สวมสูทสีดำ นั่งบนโซฟาหนังสีดำและเท้าคางด้วยมือขวา ครึ่งล่างเป็นตัวอักษรไทยสามมิติตัวโตสีฟ้าอมน้ำเงินอ่านว่า โปรโมชั่น ใต้ลงมาเป็นแคปซูลมนเขียนว่า คืนยอดเสีย ต่อท้ายด้วยตัวเลข 0.3% ตัวโตสีแดงสด`;

const altReferral = `โปสเตอร์โปรโมชั่นแนวตั้ง ฉากโถงห้างสรรพสินค้าหรูโทนขาว-ดำ มีหน้าร้านแบรนด์เนมและถุงช้อปปิ้งวางอยู่บนพื้นหินขัดมันด้านหลัง มุมขวาบนเป็นโลโก้ของ ${BRAND_NAME} กลางภาพเป็นผู้หญิงวัยกลางคนผมสั้นดัดลอนสีขาวเงิน ยิ้มกว้าง ทาลิปสติกแดง สวมสูทสีขาวครีม นั่งเท้าคางด้วยมือขวา ครึ่งล่างเป็นตัวอักษรไทยสามมิติตัวโตสีฟ้าอมน้ำเงินอ่านว่า โปรโมชั่น ใต้ลงมาเป็นแคปซูลมนเขียนว่า แนะนำเพื่อน ต่อท้ายด้วยตัวเลข 0.8% ตัวโตสีแดงสด`;
---

<MainLayout title={`โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน โบนัส 0.8%`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`รวมโปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} as="h1">
    <div class="flex flex-col gap-10">
      <p>
        หน้านี้รวมภาพโปรโมชั่นสำหรับสมาชิกของ {BRAND_NAME} ไว้ในที่เดียว ทั้ง
        <strong class="text-[#ff2e52]">รายการคืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน และโบนัสแนะนำเพื่อน 0.8%</strong>
        โดยอัตราและชื่อรายการระบุไว้บนภาพด้านล่างแล้ว
        <strong class="text-[#ff2e52]">แต่ละรายการอาจมีข้อกำหนดเกี่ยวกับยอดที่นำมาคำนวณ ประเภทเกมที่เข้าร่วม รอบรับเครดิต และการใช้โบนัสแตกต่างกัน จึงควรตรวจสอบประกาศล่าสุดทุกครั้ง</strong>
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt={altCashback}
          loading="lazy"
          fetchpriority="low"
          widths={[250, 375]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />

        <Picture
          src={promoReferral}
          alt={altReferral}
          loading="lazy"
          fetchpriority="low"
          widths={[250, 375]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="relative isolate flex items-center justify-center overflow-hidden rounded-lg border border-[#c9102f] bg-gradient-to-b from-[#ff2e52] via-[#e01238] to-[#c9102f] px-10 py-3.5 text-lg font-black text-[#ffffff] shadow-[0_8px_22px_rgba(224,18,56,0.4)] transition-transform hover:scale-105">
          <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#d9dfe9]/25 to-transparent"></span>
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
