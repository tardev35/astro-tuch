---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

// Only slide1/slide2 belong to 12PLAY (drop 2026-08-12) and they are literally
// the two promotions this page shows: slide1 is the "คืนยอดเสีย รับโบนัส 0.3%"
// poster, slide2 is the "แนะนำเพื่อน รับโบนัส 0.8%" poster. slide3/slide4 are
// still on disk but belong to a previous client (2026-08-04) — they may not be
// imported here, now or on any future rebrand.
import promoCashback from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";

// This is an IMAGE page: the ContentBox title, ONE short intro paragraph, the
// poster grid, one CTA. No section headings, no extra prose — the posters
// already state every offer in large type.
//
// 150–160 CHARACTERS (not bytes — a byte count reads ~3x too long for Thai).
const pageDescription = "รวมโปรโมชั่น 12PLAY ทั้งคืนยอดเสียรับโบนัส 0.3% และแนะนำเพื่อนแชร์ลิงก์รับโบนัส 0.8% ดูรายละเอียดและตรวจสอบเงื่อนไขการรับสิทธิ์ในบัญชีสมาชิกก่อนกดรับทุกครั้ง";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น 12PLAY คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8%",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});
---

<MainLayout title="โปรโมชั่น 12PLAY คืนยอดเสียรับ 0.3% แนะนำเพื่อนรับ 0.8%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น 12PLAY" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#e0d7d8]">
        หน้านี้รวมโปรโมชั่นที่ 12PLAY เปิดรับอยู่ในขณะนี้ ทั้งคืนยอดเสียรับโบนัส 0.3% และแนะนำเพื่อนแชร์ลิงก์รับโบนัส 0.8% อัตราโบนัส ยอดที่นำมาคำนวณ
        และรอบเวลาการรับสิทธิ์ระบุไว้บนภาพโปรโมชั่นแต่ละใบ และเงื่อนไขของแต่ละรายการไม่เหมือนกัน สมาชิกตรวจสอบยอดสะสมและกดรับสิทธิ์ได้จากบัญชีสมาชิก
        หรือสอบถามแอดมินที่ดูแลตลอด 24 ชั่วโมง
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่น 12PLAY พื้นหลังสีดำแดงลายวงจรไฟฟ้า โลโก้ 12PLAY สีโครมเงินแดงอยู่ด้านบน ถัดลงมาเป็นป้ายข้อความ โปรโมชั่น คืนยอดเสีย รับโบนัส พร้อมตัวเลข 0.3% สีแดงขนาดใหญ่ หญิงสาวสวมชุดสีแดงดำยืนแบมืออยู่ด้านขวา ด้านซ้ายมีไพ่โพดำ A กับ K และชิปคาสิโนสีแดงขาวสลักเลข 12 แถบไอคอนด้านล่างเขียนว่า มั่นคง ปลอดภัย เชื่อถือได้ 100% ฝาก-ถอน ออโต้ รวดเร็ว ทันใจ บริการดูแล 24 ชม. พร้อมดูแลคุณ และขนาดมาตรฐานระบบสากล"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#8a0710]/55 object-contain shadow-[0_10px_30px_rgba(224,16,32,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ff5a63]/70 hover:shadow-[0_15px_40px_rgba(244,239,240,0.28)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่น 12PLAY พื้นหลังสีดำแดงลายวงจรไฟฟ้า โลโก้ 12PLAY สีโครมเงินแดงอยู่มุมบนซ้าย ถัดลงมาเป็นป้ายข้อความ โปรโมชั่น แนะนำเพื่อน รับโบนัส พร้อมตัวเลข 0.8% สีขาวแดงขนาดใหญ่ หญิงสาวสวมชุดสีแดงดำติดโลโก้ 12PLAY ยืนแบมืออยู่ด้านขวา รอบตัวมีชิปคาสิโนสีแดงขาวลอยอยู่และไพ่โพแดง A"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#8a0710]/55 object-contain shadow-[0_10px_30px_rgba(224,16,32,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ff5a63]/70 hover:shadow-[0_15px_40px_rgba(244,239,240,0.28)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg bg-gradient-to-r from-[#ff5a63] via-[#e01020] to-[#8a0710] px-10 py-3.5 text-lg font-black text-[#f4eff0] shadow-[0_0_15px_rgba(224,16,32,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก 12PLAY
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
