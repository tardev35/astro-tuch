---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

// เฉพาะ slide1/slide2 (ลงวันที่ 2026-08-26) เท่านั้นที่เป็นอาร์ตเวิร์กของ LION991
// slide1 คือโปสเตอร์ "คืนยอดเสีย 0.3%" ส่วน slide2 คือ "แนะนำเพื่อน 0.8%" (อ่านจากตัวภาพ)
// บทบาทของแต่ละสไลด์สลับได้ในแต่ละแบรนด์ อย่าเชื่อชื่อตัวแปรเดิม
// ให้เปิดรูปดูทุกครั้งที่เปลี่ยนแบรนด์
// slide3/slide4 ยังค้างอยู่บนดิสก์แต่เป็นอาร์ตเวิร์กของลูกค้าก่อนหน้า — ห้าม import ที่นี่
// ทั้งรอบนี้และรอบถัดไป (ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้ว)
import promoCashback from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็น IMAGE page: ContentBox title, ย่อหน้าเกริ่นสั้น ๆ หนึ่งย่อหน้า, กริดโปสเตอร์,
// ปุ่ม CTA หนึ่งปุ่ม — ไม่มีหัวข้อย่อยและไม่มีย่อหน้าเพิ่ม เพราะตัวโปสเตอร์ระบุเงื่อนไข
// ของแต่ละโปรโมชั่นไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 153
const pageDescription =
  "รวมโปรโมชั่นของ LION991 ทั้งคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ดูเปอร์เซ็นต์ ยอดที่นำมาคำนวณ และรอบรับสิทธิ์ได้จากภาพโปรโมชั่นในหน้านี้ก่อนกดรับทุกครั้ง";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น LION991 คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8%",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});
---

<MainLayout title="โปรโมชั่น LION991 คืนยอดเสียรับ 0.3% และแนะนำเพื่อนรับโบนัส 0.8%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น LION991" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#d6e2f5]">
        หน้านี้รวมโปรโมชั่นที่ LION991 เปิดให้สมาชิกตรวจสอบสิทธิ์และกดรับผ่านบัญชีของตนเอง ทั้งคืนยอดเสีย
        <strong class="text-[#b7c6dd]">0.3%</strong> และแนะนำเพื่อนรับ <strong class="text-[#b7c6dd]">0.8%</strong>
        โดยเปอร์เซ็นต์ ยอดที่นำมาคำนวณ และรอบเวลารับสิทธิ์ระบุไว้บนภาพโปรโมชั่นแต่ละใบ
        แต่ละรายการมีเงื่อนไขต่างกัน จึงควรอ่านรายละเอียดล่าสุดหรือสอบถามเจ้าหน้าที่ก่อนกดรับทุกครั้ง
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่นคืนยอดเสียของ LION991 พื้นหลังเป็นห้องคาสิโนสดสีน้ำเงินเข้ม โลโก้ LION991 อยู่กลางด้านบน ถัดลงมาเป็นตัวอักษรสีขาวขนาดใหญ่ว่า โปรโมชั่น เหนือคำว่า คืนยอดเสีย และตัวเลข 0.3% สีฟ้าขนาดใหญ่ ผู้หญิงในชุดสีกรมท่าแบมือไปทางตัวเลข ด้านล่างเรียงป้ายทรงแคปซูลสีน้ำเงินว่า มั่นคง ปลอดภัย บริการระดับพรีเมียม และ คืนยอดเสียทุกวัน ปิดท้ายด้วยแถวไอคอน คาสิโนออนไลน์ คาสิโนสด สล็อต และ โปรโมชั่นพิเศษมากมาย"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#1046e0]/70 object-contain shadow-[0_10px_30px_rgba(1,4,28,0.72)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#b7c6dd]/70 hover:shadow-[0_15px_40px_rgba(183,198,221,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อนของ LION991 พื้นหลังสีน้ำเงินเข้มมีเงาหัวสิงโตอยู่มุมบนซ้าย โลโก้ LION991 อยู่กลางด้านบน ถัดลงมาเป็นตัวอักษรสีขาวขนาดใหญ่ว่า โปรโมชั่น เหนือคำว่า แนะนำเพื่อน และตัวเลข 0.8% ขนาดใหญ่ ผู้หญิงในชุดสีกรมท่าชี้นิ้วมาที่ตัวเลข รอบตัวมีชิปคาสิโนและไพ่โพดำ ด้านล่างเรียงป้ายสีน้ำเงินสามป้ายว่า ชวนเพื่อนง่าย รับโบนัสทันที รับโบนัส จากยอดเพื่อนเล่น และ ปลอดภัย มั่นคง เชื่อถือได้ 100%"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#1046e0]/70 object-contain shadow-[0_10px_30px_rgba(1,4,28,0.72)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#b7c6dd]/70 hover:shadow-[0_15px_40px_rgba(183,198,221,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก LION991"
          class="flex items-center justify-center rounded-lg border border-[#b7c6dd]/70 bg-gradient-to-r from-[#e6ecf7] via-[#b7c6dd] to-[#7d90ad] px-10 py-3.5 text-lg font-black text-[#01041c] shadow-[0_0_15px_rgba(183,198,221,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก LION991
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
