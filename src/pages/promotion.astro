---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

// ดรอปอาร์ตเวิร์กของ NAZA99 คือ 2026-10-02 18:03 และมีโปสเตอร์ที่ใช้ได้แค่สองใบ
// (brand-spec §4) — เปิดไฟล์จริงดูแล้วทั้งคู่ และรอบนี้ป้ายบนภาพ "ตรงกับ" เลขไฟล์
// (รอบก่อนๆ เคยสลับข้างกัน จึงต้องเปิดดูทุกครั้ง ห้ามเดาจากชื่อไฟล์):
//   slide1.png — 600x400 ป้ายใต้หัวเรื่องอ่านว่า "คืนยอดเสีย โบนัส 0.3%"
//                หญิงสาวชุดขาว-ทอง แบมือขวาหงายขึ้น มุมล่างขวามีวงล้อสล็อต 777
//   slide2.png — 600x400 ป้ายอ่านว่า "แนะนำเพื่อน โบนัส 0.8%"
//                หญิงสาวชุดขาว-ทองประดับดอกไม้ที่ผม ชี้นิ้วมือขวามาข้างหน้า
//   slide3.png / slide4.png — โปสเตอร์ของแบรนด์ก่อน (29 ก.ย. เก่ากว่าดรอปนี้)
//     ห้าม import กลับมาเด็ดขาด และห้ามลบไฟล์ทิ้งเพราะเป็นอินเวนทอรีของรอบถัดไป
// ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้วและ verify-build จะแดง
// (banner2/banner3 ใน src/assets ก็เก่ากว่าดรอปนี้ = อาร์ตเวิร์กแบรนด์ก่อน ห้าม import)
// ส่วน banner1 / banner1-mobile / og.png เป็นของ MainLayout ห้าม import จากหน้านี้
// ชื่อตัวแปรตั้งตามข้อความบนภาพ ไม่ใช่ตามเลขไฟล์ เพื่อไม่ให้รอบหน้าสลับผิดอีก
import promoCashback from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้น ๆ "หนึ่งย่อหน้า ประมาณสี่บรรทัด" คือ
// โควตาตัวหนังสือทั้งหมดของหน้านี้, กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อย
// และห้ามเพิ่มย่อหน้า เพราะตัวโปสเตอร์ระบุเงื่อนไขไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว
// การพิมพ์ซ้ำด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ เป้าหมาย h1x1, h2x0, h3x0
// (รอบนี้รับมาเป็นย่อหน้าเดียวอยู่แล้วและคงรูปเดิมไว้)
//
// สไลด์รอบนี้เป็นแนวนอน 600x400 จึงวางเป็นกริดสองคอลัมน์คุมความกว้างรวมที่ max-w-4xl
// (896px) ทำให้ช่องละ ~436px ไม่ต้องอัปสเกลเกินขนาดไฟล์ต้นทาง widths หยุดที่ 600 ตาม
// ความกว้างจริงของไฟล์ และคุมภาพต่อใบไว้ที่ max-w-[600px] สองใบพอดีหนึ่งแถว กริดจึง
// จัดกลางสมมาตรโดยไม่ต้องมีใบที่ span สองคอลัมน์ · เรียงคืนยอดเสีย ก่อนแนะนำเพื่อน
// ตามลำดับของบรีฟ
//
// Announcement หมุนมาเป็น AnnouncementPremium ทั้งเว็บรอบนี้ (รอบก่อน หวย365 ใช้
// AnnouncementCyber) — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ
// NAZA99 แล้ว และ index ก็เรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop message มิฉะนั้น
// ตัววิ่งจะพูดคนละเรื่องกันระหว่างหน้าแรกกับหน้านี้
//
// พาเลตต์ NAZA99 (brand-spec §2) ทอง-ดำ สีเดียวไม่มีฮิวที่สอง: ทองอ่อน #fdf2ac ·
// ทองแบรนด์ #e4b34d · ทองเข้ม #c08f2b · ทองลึก #8a5f12 · ผิวการ์ด #140c02 ·
// ผิวยกระดับ #241404 · ดำสนิท #0a0501 · หมึกบนพื้นทอง #1a1000 ·
// เนื้อความ #f3e8cf (BRAND_TEXT มาจาก <html> อยู่แล้ว จึงไม่ต้องระบุสีที่ย่อหน้า)
// เรืองแสง: ทอง rgba(228,179,77,α) · ทองอ่อน rgba(253,242,172,α) · เงา rgba(10,5,1,α)
// การ์ดโปสเตอร์ได้ขอบทองแบรนด์ #e4b34d และยกเป็นทองอ่อน #fdf2ac ตอน hover เพราะ
// ตัวอักษรบนภาพทั้งคู่เป็นทองเมทัลลิก · ปุ่ม CTA ไล่เฉดทอง #fdf2ac → #e4b34d →
// #c08f2b ใช้หมึกเข้ม #1a1000 (ปลายไล่เฉดห้ามเข้มกว่า #c08f2b ซึ่งวัดได้ 7.0:1)
// ห้ามวางตัวอักษรสีอ่อนบนพื้นทอง (ขาวบน #e4b34d ได้แค่ 1.9:1)
// ชุดของ หวย365 (#dc0203 #f5282a #9c0201 #ffc93c #ffeab0 #c08a07 #240406 #180303
// #f6e7e0 #1a0303 rgba(255,201,60,*) rgba(220,2,3,*) rgba(8,1,1,*)) ถูกแทนครบทุกจุด
// แล้ว ทั้งคลาส Tailwind raw hex และ rgba()
//
// NAZA99 เป็นเว็บ "สล็อตออนไลน์" ไม่ใช่หวย ไม่ใช่บอล และไม่ใช่คาสิโนสด — คำว่า
// หวย โพย งวด เลขเด็ด อัตราจ่าย ฮานอย บอล ค่าน้ำ ลีก คาสิโนสด บาคาร่า ยิงปลา
// ห้ามปรากฏบนหน้านี้ ตัวเลขที่บรีฟระบุและใช้ได้มีแค่ 0.3% · 0.8% · 3 เกม ·
// 3 ขั้นตอน · 24 ชั่วโมง ห้ามเพิ่มชื่อผู้ให้บริการ ชื่อธนาคาร ยอดฝากขั้นต่ำ
// เลขใบอนุญาต จำนวนสมาชิก หรือปีที่ก่อตั้ง และต้องคง hedge ของบรีฟไว้ว่าแต่ละรายการ
// อาจกำหนดค่ายเกมและเงื่อนไขแตกต่างกัน จึงควรอ่านรายละเอียดก่อนกดรับ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 151
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `รวมโปรโมชั่นสล็อต ${BRAND_NAME} ทั้งคืนยอดเสีย โบนัส 0.3% และแนะนำเพื่อน โบนัส 0.8% แต่ละรายการอาจกำหนดค่ายเกมและเงื่อนไขแตกต่างกัน ควรอ่านรายละเอียดก่อนกดรับ`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่นสล็อต ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});
---

<MainLayout title={`โปรโมชั่นสล็อต ${BRAND_NAME} คืนยอดเสีย โบนัส 0.3% แนะนำเพื่อน โบนัส 0.8%`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`โปรโมชั่นสล็อต ${BRAND_NAME}`} as="h1">
    <div class="flex flex-col gap-10">
      <p class="text-left text-base leading-relaxed">
        หน้านี้รวมภาพโปรโมชั่นที่ <strong class="text-[#fdf2ac]">{BRAND_NAME}</strong> เปิดให้สมาชิกตรวจสอบก่อนเลือกรับสิทธิ์ โดยรายละเอียดของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว ทั้งโบนัสคืนยอดเสียและกิจกรรมแนะนำเพื่อน
        สามารถ Login เพื่อตรวจสอบยอดที่เข้าเกณฑ์ รอบคำนวณ และจำนวนโบนัสจากบัญชีสมาชิกได้โดยตรง <strong class="text-[#fdf2ac]">แต่ละรายการอาจกำหนดค่ายเกมและเงื่อนไขแตกต่างกัน</strong> จึงควรอ่านรายละเอียดก่อนกดรับทุกครั้ง
      </p>

      <div class="mx-auto grid w-full max-w-4xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่นของ NAZA99 พื้นดำอมน้ำตาลมีเหรียญทองลอยเต็มภาพและริ้วแสงทองพาดเป็นฉากหลัง ด้านซ้ายเป็นหญิงสาวผมยาวสวมชุดสีขาว-ทองและต่างหูทองยาว แบมือขวาหงายขึ้นมาข้างหน้า มุมบนขวาเป็นโลโก้ NAZA99 สีทองพร้อมสัญลักษณ์ตัว N ในวงกลม ถัดลงมาเป็นตัวอักษรไทยสีทองขนาดใหญ่มีเงาว่า โปรโมชั่น และใต้ลงมาเป็นป้ายสีดำขอบทองคาดข้อความ คืนยอดเสีย โบนัส 0.3% มุมล่างขวาเป็นวงล้อสล็อตเลข 777 กับกองเหรียญทองและชิป"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), (max-width: 1007px) calc((100vw - 136px) / 2), 436px"
          class="mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#e4b34d]/60 object-contain shadow-[0_10px_30px_rgba(10,5,1,0.85)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fdf2ac]/85 hover:shadow-[0_15px_40px_rgba(228,179,77,0.40)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่นของ NAZA99 ชุดเดียวกัน พื้นดำอมน้ำตาลมีเหรียญทองลอยเต็มภาพ ด้านซ้ายเป็นหญิงสาวสวมชุดสีขาว-ทองประดับดอกไม้ที่ผม ชี้นิ้วมือขวามาข้างหน้า มุมบนขวาเป็นโลโก้ NAZA99 สีทองพร้อมสัญลักษณ์ตัว N ในวงกลม ถัดลงมาเป็นตัวอักษรไทยสีทองขนาดใหญ่ว่า โปรโมชั่น และใต้ลงมาเป็นป้ายสีดำขอบทองคาดข้อความ แนะนำเพื่อน โบนัส 0.8%"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), (max-width: 1007px) calc((100vw - 136px) / 2), 436px"
          class="mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#e4b34d]/60 object-contain shadow-[0_10px_30px_rgba(10,5,1,0.85)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fdf2ac]/85 hover:shadow-[0_15px_40px_rgba(228,179,77,0.40)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#8a5f12] bg-gradient-to-r from-[#fdf2ac] via-[#e4b34d] to-[#c08f2b] px-10 py-3.5 text-lg font-black text-[#1a1000] shadow-[0_0_15px_rgba(228,179,77,0.40)] transition-transform hover:scale-105">
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
