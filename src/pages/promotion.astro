---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

// เฉพาะ slide1/slide2 (ลงวันที่ 2026-08-22) เท่านั้นที่เป็นอาร์ตเวิร์กของ PREMSUK365
// slide1 คือโปสเตอร์ "แนะนำเพื่อน 0.8%" ส่วน slide2 คือ "คืนยอดเสีย 0.3%" (อ่านจากตัวภาพ)
// บทบาทสลับกันได้ในแต่ละแบรนด์ — อย่าเชื่อชื่อตัวแปรเดิม ให้เปิดรูปดูทุกครั้งที่เปลี่ยนแบรนด์
// slide3/slide4 ยังค้างอยู่บนดิสก์แต่เป็นอาร์ตเวิร์กของลูกค้าก่อนหน้า — ห้าม import ที่นี่
// ทั้งรอบนี้และรอบถัดไป (ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้ว)
import promoReferral from "../assets/slide1.png";
import promoCashback from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็น IMAGE page: ContentBox title, ย่อหน้าเกริ่นสั้น ๆ หนึ่งย่อหน้า, กริดโปสเตอร์,
// ปุ่ม CTA หนึ่งปุ่ม — ไม่มีหัวข้อย่อยและไม่มีย่อหน้าเพิ่ม เพราะตัวโปสเตอร์ระบุเงื่อนไข
// ของแต่ละโปรโมชั่นไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 159
const pageDescription =
  "รวมโปรโมชั่น PREMSUK365 ทั้งแนะนำเพื่อนรับ 0.8% และคืนยอดเสีย 0.3% ดูเปอร์เซ็นต์โบนัสและเงื่อนไขของแต่ละรายการได้จากภาพโปรโมชั่นในหน้านี้โดยตรง ก่อนกดรับสิทธิ์";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น PREMSUK365 แนะนำเพื่อน 0.8% คืนยอดเสีย 0.3%",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoReferral.src,
});
---

<MainLayout title="โปรโมชั่น PREMSUK365 แนะนำเพื่อนรับ 0.8% และคืนยอดเสียรับ 0.3%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น PREMSUK365" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#e4e7d8]">
        หน้านี้รวมโปรโมชั่นที่ PREMSUK365 เปิดให้สมาชิกตรวจสอบสิทธิ์และกดรับผ่านบัญชีของตนเอง ทั้งกิจกรรมแนะนำเพื่อนรับ <strong class="text-[#f7e8b4]">0.8%</strong>
        และโปรโมชั่นคืนยอดเสีย <strong class="text-[#f7e8b4]">0.3%</strong> โดยเปอร์เซ็นต์โบนัส ยอดที่นำมาคำนวณ และรอบเวลารับสิทธิ์ระบุไว้บนภาพโปรโมชั่นแต่ละใบ
        แต่ละรายการมีวิธีคำนวณและเงื่อนไขต่างกัน จึงควรอ่านรายละเอียดล่าสุดหรือสอบถามแอดมินก่อนกดรับทุกครั้ง
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อนของ PREMSUK365 พื้นหลังเขียวเข้มไล่สีทอง ข้อความ โปรโมชั่น แนะนำเพื่อน และตัวเลขทองขนาดใหญ่ 0.8% ด้านซ้ายมีกล่องของขวัญเขียวทอง ลูกบอลหวย และสลากกินแบ่งรัฐบาลไทย ด้านขวาเป็นผู้หญิงในชุดขาวทอง แถบล่างเขียนว่า การันตีจ่ายจริง รับเลขดัง เลขอั้น ไม่ลบบิล ไม่เบี้ยวโพย"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#8a6a26]/70 object-contain shadow-[0_10px_30px_rgba(2,12,6,0.6)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#e3c56a]/70 hover:shadow-[0_15px_40px_rgba(227,197,106,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่นคืนยอดเสียของ PREMSUK365 พื้นหลังเขียวเข้มไล่สีทอง ข้อความ โปรโมชั่น คืนยอดเสีย และตัวเลขทองขนาดใหญ่ 0.3% ด้านซ้ายมีสลากกินแบ่งรัฐบาลไทยแสดงเลข 987653 ลูกบอลหวย และเหรียญทอง ด้านขวาเป็นผู้หญิงในชุดขาวทอง แถบล่างเขียนว่า การันตีจ่ายจริง รับเลขดัง เลขอั้น ไม่ลบบิล ไม่เบี้ยวโพย"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#8a6a26]/70 object-contain shadow-[0_10px_30px_rgba(2,12,6,0.6)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#e3c56a]/70 hover:shadow-[0_15px_40px_rgba(227,197,106,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก PREMSUK365"
          class="flex items-center justify-center rounded-lg border border-[#e3c56a]/70 bg-gradient-to-r from-[#f7e8b4] via-[#e3c56a] to-[#8a6a26] px-10 py-3.5 text-lg font-black text-[#020c06] shadow-[0_0_15px_rgba(227,197,106,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก PREMSUK365
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
