---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";

import { Picture } from "astro:assets";

// ดรอปอาร์ตเวิร์กของ LOTTOPLUS คือ 2026-09-29 มีสไลด์สี่ไฟล์ แต่ "โปร" ที่ต่างกันจริง
// มีสามใบ — เปิดดูทุกไฟล์แล้วก่อนผูก อย่าเชื่อชื่อตัวแปรที่ตกทอดมาและอย่าคัดลอก
// import จากประวัติ git เพราะบทบาทของไฟล์ชุดนี้สลับกันมาแล้วหลายแบรนด์:
//   slide1.png — ป้ายแคปซูล "อัตราจ่าย หวย" + เลขใหญ่ 2ตัว100
//   slide2.png — โปสเตอร์ชุดเดียวกัน + เลขใหญ่ 3ตัว1,000
//   slide3.png — ภาพเดียวกับ slide2 ทุกพิกเซล (ออฟเฟอร์ซ้ำ) จึงไม่ import
//                ขึ้นมาแสดงซ้ำในกริดเดียวกัน และห้ามลบไฟล์ทิ้งเพราะเป็นอินเวนทอรี
//   slide4.png — ป้ายแคปซูล "แนะนำเพื่อน โบนัส" + เลขใหญ่สีทอง 0.8%
// ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้วและ verify-build จะแดง
// ถ้ามีสไลด์ใหม่เข้ามาให้เช็ก mtime เทียบดรอปก่อนเพิ่ม (banner2/banner3 ใน
// src/assets เก่ากว่าดรอปนี้ = อาร์ตเวิร์กแบรนด์ก่อน ห้าม import กลับมา)
import promoTwoDigit from "../assets/slide1.png";
import promoThreeDigit from "../assets/slide2.png";
import promoReferral from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";
//
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ: ContentBox title, ย่อหน้าเกริ่นสั้น ๆ หนึ่งย่อหน้า
// (ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมดของหน้านี้), กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม
// — ไม่มีหัวข้อย่อยและไม่มีย่อหน้าเพิ่ม เพราะตัวโปสเตอร์ระบุชื่อโปรและตัวเลขอัตราจ่าย
// ไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว เป้าหมาย h1x1, h2x0, h3x0
//
// สไลด์เป็นแบนเนอร์ 600x334 (แนวนอน ไม่ใช่จัตุรัส — วัดจากไฟล์จริง) จึงวางเป็นกริด
// สองคอลัมน์คุมความกว้างรวมที่ max-w-5xl (1024px) ทำให้ช่องละ ~500px ไม่ต้องอัปสเกล
// เกินขนาดไฟล์ต้นทาง widths หยุดที่ 600 ตามความกว้างจริงของไฟล์ ใบที่สามเป็นจำนวนคี่
// จึงให้ span สองคอลัมน์แล้วคุมความกว้างเท่าเดิม ให้กริดยังอ่านเป็นแถวที่จัดกลางสมมาตร
//
// Announcement หมุนมาเป็น AnnouncementHuay ทั้งเว็บรอบนี้ — orchestrator ตั้ง default
// message ของไฟล์นั้นเป็นคอปปี้ของ LOTTOPLUS แล้ว และ index ก็เรียกแบบ bare เหมือนกัน
// จึงห้ามส่ง prop message มิฉะนั้นตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ LOTTOPLUS (แดงนำ ทองรอง บนพื้นเกือบดำ ตามโลโก้ตัวอักษรขาวบนบล็อกแดง
// #dc020e และแบนเนอร์พื้นดำที่มีแดงลึก เหรียญทอง มงกุฎทอง และลูกหวยแดง-ขาว):
// พื้นเพจ #050505 · ผิวการ์ด #120b0c · ผิวการ์ดอุ่น #1f0a0c · ผิวปุ่มรอง #2a0d0f ·
// แดงสว่าง #ff2d38 · แดงแบรนด์ #dc020e · แดงกลาง #a80710 · แดงลึก #6b0207 ·
// ทองอ่อน #fde79a · ทองรอง #f3c623 · ทองลึก #8a6a0a · เนื้อความ #f0e2e2 (BRAND_TEXT) ·
// เน้นใน strong #fff4f4 · หมึกบนพื้นทอง #1a0203
// การ์ดโปสเตอร์ได้ขอบแดงแบรนด์ ใบโปรแนะนำเพื่อนได้ขอบทองรองเพราะเลข 0.8% บนภาพเป็นทอง
// ปุ่ม CTA เป็นไล่เฉดแดง #ff2d38 → #dc020e → #6b0207 และใช้ตัวอักษร "ขาว" ตามกฎ
// คอนทราสต์ของ brand-spec §2 (ขาวบนแดงแบรนด์ = 5.17:1 ผ่าน / หมึกเข้มบนแดง = 3.85:1 ตก)
// ชุดทอง-ดำของ WIN999 (#fcc403 #fdda04 #e0a800 #8a6502 #fff0a8 #e9e4d6 #fffbea
// #101010 #191712 rgba(252,196,3,*) rgba(3,2,0,*)) และชุดแดงของ LOTTO24
// (#dc2626 #fc2b2c #b40102 #fbbf24 #fde68a rgba(220,38,38,*)) ถูกแทนครบทุกจุดแล้ว
//
// LOTTOPLUS เป็นเว็บหวยออนไลน์ ไม่ใช่คาสิโน — คำว่า คาสิโน บาคาร่า สล็อต เกมไพ่
// ค่ายเกม RTP กีฬา/บอล ห้ามปรากฏ ตัวเลขที่บรีฟระบุและใช้ได้มีแค่ 2 ตัว 100 ·
// 3 ตัว 1,000 · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · 24 ชั่วโมง ห้ามเพิ่มชื่อธนาคาร
// ยอดฝากขั้นต่ำ เลขใบอนุญาต หรือชื่อผู้ให้บริการ และต้องคง hedge ของบรีฟไว้ว่า
// อัตราจ่ายจริงขึ้นกับประเภทหวย รูปแบบการแทง และรอบที่เปิดรับ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 152
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "รวมภาพโปรโมชั่นและอัตราจ่ายหวย LOTTOPLUS ทั้งเลข 2 ตัว 100 เลข 3 ตัว 1,000 คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ตรวจสอบเงื่อนไขและรอบที่เปิดรับก่อนส่งโพย";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่นและอัตราจ่าย หวย LOTTOPLUS",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoTwoDigit.src,
});
---

<MainLayout title="โปรโมชั่น LOTTOPLUS อัตราจ่ายหวย 2 ตัว 100 และ 3 ตัว 1,000 พร้อมโบนัสสมาชิก" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่นและอัตราจ่าย หวย LOTTOPLUS" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#f0e2e2]">
        หน้านี้รวมภาพโปรโมชั่นและอัตราจ่ายหวยที่ <strong class="text-[#fff4f4]">LOTTOPLUS</strong> เปิดให้สมาชิกตรวจสอบจากบัญชีของตนเอง ทั้งอัตราจ่ายเลข 2 ตัว เลข 3 ตัว โบนัสคืนยอดเสีย และกิจกรรมแนะนำเพื่อน โดยรายละเอียดของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว
        <strong class="text-[#fff4f4]">อัตราจ่ายจริงอาจขึ้นอยู่กับประเภทหวย รูปแบบการแทง และรอบที่เปิดรับ</strong> จึงควรยึดตัวเลขที่ระบบแสดงก่อนยืนยันโพยเป็นหลัก
      </p>

      <div class="mx-auto grid w-full max-w-5xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoTwoDigit}
          alt="โปสเตอร์โปรโมชั่นพื้นขาวเทา มีริ้วผ้าสีแดงและสีทองพาดอยู่ ด้านซ้ายเป็นหญิงสาวผมยาวสีเข้มในชุดสีขาวคาดดำถือแผงสลากหวย ด้านขวาเป็นชายหนุ่มในสูทสีดำสวมเสื้อเชิ้ตขาว ชี้มือมาข้างหน้าและถือแผงสลากหวยเช่นกัน ด้านบนกลางภาพเป็นโลโก้ LOTTOPLUS ตัวอักษรขาวบนบล็อกสีแดง ถัดลงมาเป็นตัวอักษรไทยสีแดงตัดขอบขาวว่า โปรโมชั่น และอัตราจ่าย ใต้ลงมาเป็นป้ายแคปซูลสีแดงว่า อัตราจ่าย หวย กับตัวเลขขนาดใหญ่สีดำและแดงว่า 2 ตัว 100 รอบภาพมีลูกหวยสีแดงสลับขาวหมายเลข 9 6 3 และ 7 กับกองเหรียญทอง"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 500, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), (max-width: 1151px) calc((100vw - 136px) / 2), 500px"
          class="mx-auto h-auto w-full rounded-xl border border-[#dc020e]/60 object-contain shadow-[0_10px_30px_rgba(5,1,2,0.85)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ff2d38]/85 hover:shadow-[0_15px_40px_rgba(220,2,14,0.40)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoThreeDigit}
          alt="โปสเตอร์ชุดเดียวกันพื้นขาวเทาประดับริ้วผ้าสีแดงและสีทอง ด้านซ้ายเป็นหญิงสาวผมยาวสีเข้มในชุดขาวคาดดำถือแผงสลากหวย ด้านขวาเป็นชายหนุ่มในสูทสีดำชี้มือมาข้างหน้า ด้านบนกลางภาพเป็นโลโก้ LOTTOPLUS ตัวอักษรขาวบนบล็อกสีแดง ถัดลงมาเป็นตัวอักษรไทยสีแดงตัดขอบขาวว่า โปรโมชั่น และอัตราจ่าย ใต้ลงมาเป็นป้ายแคปซูลสีแดงว่า อัตราจ่าย หวย กับตัวเลขขนาดใหญ่สีดำและแดงว่า 3 ตัว 1,000 รอบภาพมีลูกหวยสีแดงสลับขาวหมายเลข 9 6 3 และ 7 กับกองเหรียญทอง"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 500, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), (max-width: 1151px) calc((100vw - 136px) / 2), 500px"
          class="mx-auto h-auto w-full rounded-xl border border-[#dc020e]/60 object-contain shadow-[0_10px_30px_rgba(5,1,2,0.85)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ff2d38]/85 hover:shadow-[0_15px_40px_rgba(220,2,14,0.40)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoReferral}
          alt="โปสเตอร์ชุดเดียวกันพื้นขาวเทาประดับริ้วผ้าสีแดงและสีทอง ด้านซ้ายเป็นหญิงสาวผมยาวสีเข้มในชุดขาวคาดดำถือสลากหวยและชี้มือลง ด้านขวาเป็นชายหนุ่มในสูทสีดำชี้มือมาข้างหน้า ด้านบนกลางภาพเป็นโลโก้ LOTTOPLUS ตัวอักษรขาวบนบล็อกสีแดง ถัดลงมาเป็นตัวอักษรไทยสีแดงตัดขอบขาวว่า โปรโมชั่น และอัตราจ่าย ใต้ลงมาเป็นป้ายแคปซูลสีแดงว่า แนะนำเพื่อน โบนัส กับตัวเลขขนาดใหญ่สีทองว่า 0.8% รอบภาพมีลูกหวยสีแดงสลับขาวหมายเลข 6 9 3 และ 7 กับกองเหรียญทอง"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 500, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), 500px"
          class="mx-auto h-auto w-full rounded-xl border border-[#f3c623]/60 object-contain shadow-[0_10px_30px_rgba(5,1,2,0.85)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fde79a]/85 hover:shadow-[0_15px_40px_rgba(243,198,35,0.40)] sm:col-span-2 sm:max-w-[500px]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก LOTTOPLUS"
          class="flex items-center justify-center rounded-lg border border-[#ff2d38]/70 bg-gradient-to-r from-[#ff2d38] via-[#dc020e] to-[#6b0207] px-10 py-3.5 text-lg font-black text-white shadow-[0_0_15px_rgba(220,2,14,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก LOTTOPLUS
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
