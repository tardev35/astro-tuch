---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

// ⚠️ สองสไลด์ของดรอปนี้ **สลับบทบาทกับรอบก่อน** — รอบที่แล้วแมป slide2 เป็นเลข 2 ตัว
// ซึ่งผิดสำหรับอาร์ตเวิร์กชุดนี้ ยืนยันด้วยการเปิดภาพอ่านป้ายจริง ไม่ใช่เชื่อชื่อไฟล์
// หรือคอมเมนต์ของรอบก่อน:
//   slide1.png — ป้ายพื้นดำขอบทอง "2ตัว จ่าย100บาท" (นางแบบอยู่ซ้าย ถือลูกบอลเลข 2)
//   slide2.png — ป้ายพื้นดำขอบทอง "3ตัว จ่าย1,000บาท" (นางแบบอยู่ขวา แบมือ ม่านแดง)
//   slide3.png / slide4.png — โปสเตอร์ของแบรนด์ก่อน (29 ก.ย. เก่ากว่าดรอปนี้)
//     ห้าม import กลับมาเด็ดขาด และห้ามลบไฟล์ทิ้งเพราะเป็นอินเวนทอรีของรอบถัดไป
// ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้วและ verify-build จะแดง
// (banner2/banner3 ใน src/assets ก็เก่ากว่าดรอปนี้ = อาร์ตเวิร์กแบรนด์ก่อน ห้าม import)
// ส่วน banner1 / banner1-mobile / og.png เป็นของ MainLayout ห้าม import จากหน้านี้
// ชื่อตัวแปรตั้งตามข้อความบนภาพ ไม่ใช่ตามเลขไฟล์ เพื่อไม่ให้รอบหน้าสลับผิดอีก
import promoTwoDigit from "../assets/slide1.png";
import promoThreeDigit from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้น ๆ "หนึ่งย่อหน้า ประมาณสี่บรรทัด" คือ
// โควตาตัวหนังสือทั้งหมดของหน้านี้, กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อย
// และห้ามเพิ่มย่อหน้า เพราะตัวโปสเตอร์ระบุอัตราจ่ายไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว
// การพิมพ์ซ้ำด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ เป้าหมาย h1x1 h2x0 h3x0
//
// สไลด์รอบนี้เป็นแนวนอน 600x334 / 600x333 (ไม่ใช่จัตุรัส — brand-spec §5 เขียนว่า
// 600x600 แต่ไฟล์จริงเป็นแนวนอน วัดจาก PNG header) จึงวางเป็นกริดสองคอลัมน์คุม
// ความกว้างรวมที่ max-w-4xl (896px) ทำให้ช่องละ ~436px ไม่ต้องอัปสเกลเกินขนาดไฟล์
// ต้นทาง widths หยุดที่ 600 ตามความกว้างจริงของไฟล์ และคุมภาพต่อใบไว้ที่
// max-w-[600px] สองใบพอดีหนึ่งแถว กริดจึงจัดกลางสมมาตรโดยไม่ต้องมีใบที่ span สอง
// คอลัมน์ · เรียง 2 ตัวจ่าย 100 บาท ก่อน 3 ตัวจ่าย 1,000 บาท ตามลำดับของบรีฟ
// (docx H3 #4 แล้วค่อย #5) · LCP คือ hero ใน MainLayout ไม่ใช่สองรูปนี้ จึง
// loading="lazy" fetchpriority="low" ทั้งคู่
//
// Announcement รอบนี้หมุนมาเป็น Announcement3 ทั้งเว็บ (แบรนด์ก่อน หวยคิง ใช้
// AnnouncementHuay) — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ
// หวย24 แล้ว และทุกหน้าก็เรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop message มิฉะนั้น
// ตัววิ่งจะพูดคนละเรื่องกันระหว่างหน้า
//
// พาเลตต์ หวย24 (brand-spec §2) **แดงแบรนด์เป็นสีหลัก ทองเป็นสีรอง** — กลับทิศจาก
// รอบ หวยคิง ที่ทองเป็นสีหลัก: แดงแบรนด์ #d20a0a · แดงสว่าง #ff3b3b (hover/glow) ·
// แดงลึก #7a0505 · แดงเข้มสุด #2a0606 (ผิวปุ่มรอง) · ทองแบรนด์ #f5c33b (ขอบรูป) ·
// ทองสว่าง #ffd45e (หมึก strong, hover ขอบ, ต้นไล่เฉดปุ่ม) · ทองลึก #a9761a
// (ปลายไล่เฉด, ขอบปุ่ม) · พื้นเพจ #0a0303 (เงารูป) · ผิวการ์ด #170707 · ผิวการ์ดยก
// #230d0d · หมึกบนพื้นทอง #1a0303 (ตามที่ NavbarStyle10/FooterStyle3 ใช้) ·
// เนื้อความ #f7e2d6 (BRAND_TEXT มาจาก <html> และการ์ด ContentBox ตั้งให้แล้ว จึงไม่
// ต้องระบุสีที่ย่อหน้า) · glow เป็น rgba(245,195,59,α) / rgba(210,10,10,α)
// ชุดทองโลหะ-ครีมอมพีชของ หวยคิง (#cd9a2c #fdeb7c #ab7314 #f5e7c8 #fcd4c3 #fce2d4
// #1c140b #0c0b0a #120a02 rgba(205,154,44,*) rgba(12,11,10,*)) ออกครบแล้ว
//
// หวย24 เป็น **เว็บแทงหวยล้วน** ไม่ใช่คาสิโน — คำหมวดสล็อต/คาสิโน (สล็อต บาคาร่า
// คาสิโนสด ค่ายเกม RTP คืนยอดเสีย % แนะนำเพื่อน %) ห้ามหลงเหลือ
// ตลาดหวยที่บรีฟระบุไว้เองและอ้างได้มีสามตัว: หวยลาว · หวยฮานอย · รัฐบาลไทย
// ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 100 / 1,000 / 2 ตัว / 3 ตัว / 3 ขั้นตอน / 24 ชั่วโมง
// ห้ามแต่งเวลาเปิด-ปิดรับ ชื่อธนาคาร เลขใบอนุญาต ยอดฝากขั้นต่ำ หรือจำนวนสมาชิก
// และต้องคงคำกำกับของบรีฟไว้ว่าอัตราจ่ายอาจต่างตามประเภทหวย รูปแบบการแทง และรอบ
// จึงให้ยึดอัตราล่าสุดบนหน้าส่งโพยก่อนยืนยัน
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 159
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `รวมภาพอัตราจ่ายของ ${BRAND_NAME} ทั้งเลข 2 ตัวจ่าย 100 บาท และเลข 3 ตัวจ่าย 1,000 บาท สำหรับรายการที่เข้าเงื่อนไข ควรอ่านอัตราจ่ายและวงเงินรับแทงบนหน้าส่งโพยก่อนยืนยัน`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่นอัตราจ่าย ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoTwoDigit.src,
});
---

<MainLayout title={`โปรโมชั่นอัตราจ่าย ${BRAND_NAME} 2ตัว จ่าย100บาท และ 3ตัว จ่าย1,000บาท`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`โปรโมชั่นอัตราจ่าย ${BRAND_NAME}`} as="h1">
    <div class="flex flex-col gap-10">
      <p class="text-left text-base leading-relaxed">
        หน้านี้รวมภาพอัตราการจ่ายที่ <strong class="text-[#ffd45e]">{BRAND_NAME}</strong> เปิดรับสำหรับรายการที่เข้าเงื่อนไข ทั้งเลข 2 ตัวและเลข 3 ตัว ไม่ว่าจะเป็นหวยลาว หวยฮานอย หรือรัฐบาลไทย โดยรายละเอียดของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว
        <strong class="text-[#ffd45e]">อัตราจ่ายอาจแตกต่างตามประเภทหวย รูปแบบการแทง หรือรอบที่เลือก</strong> จึงควร Login อ่านอัตราล่าสุดและวงเงินรับแทงบนหน้าส่งโพยก่อนยืนยันรายการทุกครั้ง
      </p>

      <div class="mx-auto grid w-full max-w-4xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoTwoDigit}
          alt="ภาพอัตราการจ่ายของ หวย24 พื้นหลังสีดำประดับเหรียญทองและลูกบอลหวยเลข 6 8 9 ลอยกระจาย ด้านซ้ายเป็นหญิงสาวผมยาวสีเข้ม สวมชุดสีดำประดับลายทอง ถือลูกบอลหวยเลข 2 ไว้ในมือและยื่นมืออีกข้างแบออกมา ด้านขวาล่างมีใบสลากกินแบ่ง บนสุดเป็นโลโก้วงกลมสีแดงเลข 24 คู่กับคำว่า หวย24 ถัดลงมาเป็นตัวอักษรไทยสีทองขนาดใหญ่ว่า อัตราการจ่าย และป้ายพื้นดำขอบทองข้อความ 2ตัว จ่าย100บาท"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), (max-width: 1007px) calc((100vw - 136px) / 2), 436px"
          class="mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#f5c33b]/60 object-contain shadow-[0_10px_30px_rgba(10,3,3,0.85)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ffd45e]/85 hover:shadow-[0_15px_40px_rgba(210,10,10,0.40)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoThreeDigit}
          alt="ภาพอัตราการจ่ายของ หวย24 ฉากหลังเป็นม่านผ้าสีแดงประดับเหรียญทอง ด้านซ้ายล่างมีลูกบอลหวยเลข 7 3 9 วางซ้อนกับกองเหรียญ ด้านขวาเป็นหญิงสาวผมเกล้าปักปิ่นดอกไม้ทอง สวมชุดกี่เพ้าสีดำปักลายทอง ยื่นมือแบออกมา บนสุดเป็นโลโก้วงกลมสีแดงเลข 24 คู่กับคำว่า หวย24 ถัดลงมาเป็นตัวอักษรไทยสีทองขนาดใหญ่ว่า อัตราการจ่าย และป้ายพื้นดำขอบทองข้อความ 3ตัว จ่าย1,000บาท"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), (max-width: 1007px) calc((100vw - 136px) / 2), 436px"
          class="mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#f5c33b]/60 object-contain shadow-[0_10px_30px_rgba(10,3,3,0.85)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ffd45e]/85 hover:shadow-[0_15px_40px_rgba(210,10,10,0.40)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#a9761a] bg-gradient-to-r from-[#ffd45e] via-[#f5c33b] to-[#a9761a] px-10 py-3.5 text-lg font-black text-[#1a0303] shadow-[0_0_15px_rgba(245,195,59,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
