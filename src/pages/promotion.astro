---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

// Only slide1/slide2 belong to JUDTEM168, and they are exactly the two
// promotions this page shows: slide1 is the "แนะนำเพื่อน 0.8%" poster and
// slide2 is the "คืนยอดเสีย 0.3%" poster (read off the artwork itself — the
// previous brand's comment here had the two the wrong way round).
// slide3/slide4 are still on disk but belong to previous clients — they may not
// be imported here, now or on any future rebrand (an unrendered import is still
// emitted into dist/).
import promoReferral from "../assets/slide1.png";
import promoCashback from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";

// This is an IMAGE page: the ContentBox title, ONE short intro paragraph, the
// poster grid, one CTA. No section headings, no extra prose — the posters
// already state every offer in large type.
//
// 150–160 CHARACTERS (not bytes — a byte count reads ~3x too long for Thai).
// This one is 156.
const pageDescription =
  "รวมโปรโมชั่น JUDTEM168 ทั้งแนะนำเพื่อนรับโบนัส 0.8% และคืนยอดเสีย 0.3% ดูเปอร์เซ็นต์โบนัส ยอดที่นำมาคำนวณ และเงื่อนไขการรับสิทธิ์ได้จากภาพโปรโมชั่นในหน้านี้";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น JUDTEM168 แนะนำเพื่อน 0.8% คืนยอดเสีย 0.3%",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoReferral.src,
});
---

<MainLayout title="โปรโมชั่น JUDTEM168 แนะนำเพื่อน 0.8% คืนยอดเสีย 0.3%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น JUDTEM168" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#f0e2bd]">
        หน้านี้รวมโปรโมชั่นที่ JUDTEM168 เปิดให้สมาชิกตรวจสอบสิทธิ์และกดรับผ่านบัญชีผู้ใช้งาน ทั้งกิจกรรมแนะนำเพื่อนรับโบนัส <strong class="text-[#f5d98a]">0.8%</strong>
        และโปรโมชั่นคืนยอดเสีย <strong class="text-[#f5d98a]">0.3%</strong> เปอร์เซ็นต์โบนัส ยอดที่นำมาคำนวณ และรอบเวลาการรับสิทธิ์ระบุไว้บนภาพโปรโมชั่นแต่ละใบ
        แต่ละรายการมีวิธีคำนวณและข้อกำหนดการถอนต่างกัน จึงควรอ่านเงื่อนไขล่าสุดหรือสอบถามแอดมินผ่าน LINE Official ก่อนกดรับทุกครั้ง
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่นพื้นหลังคาสิโนสีดำทอง ด้านบนเป็นโลโก้โพดำ JUDTEM168 กลางภาพเป็นกรอบทองเขียนว่า โปรโมชั่น แนะนำเพื่อน พร้อมตัวเลขทองขนาดใหญ่ 0.8% ด้านขวาเป็นผู้หญิงผมบลอนด์ในชุดสีทองยืนแบมือ ด้านล่างซ้ายมีกล่องของขวัญสีดำทอง ไพ่เอซ ลูกเต๋า เหรียญทอง และวงล้อสล็อตเลข 777 ส่วนแถบล่างเขียนว่า ชวนเพื่อนรับค่าคอมสูง รับโบนัสทุกยอดแนะนำ ปลอดภัยมั่นคง 100% และฝากถอนออโต้ 24 ชั่วโมง"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#6a5115]/70 object-contain shadow-[0_10px_30px_rgba(204,156,45,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#e8bf4e]/70 hover:shadow-[0_15px_40px_rgba(232,191,78,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่นพื้นหลังคาสิโนสีดำทอง ด้านบนเป็นโลโก้โพดำ JUDTEM168 กลางภาพเป็นกรอบทองเขียนว่า โปรโมชั่น คืนยอดเสีย พร้อมตัวเลขทองขนาดใหญ่ 0.3% ด้านขวาเป็นผู้หญิงผมบลอนด์ในชุดสีทองดำยืนแบมือ ด้านล่างซ้ายมีหีบสมบัติเหรียญทอง วงล้อสล็อตเลข 777 ไพ่เอซ ลูกเต๋าทอง และเหรียญทองกระจายอยู่รอบภาพ"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#6a5115]/70 object-contain shadow-[0_10px_30px_rgba(204,156,45,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#e8bf4e]/70 hover:shadow-[0_15px_40px_rgba(232,191,78,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#e8bf4e]/70 bg-gradient-to-r from-[#fae27c] via-[#d8ae3a] to-[#6a5115] px-10 py-3.5 text-lg font-black text-[#050301] shadow-[0_0_15px_rgba(232,191,78,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก JUDTEM168
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
