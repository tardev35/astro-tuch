---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";

import { Picture } from "astro:assets";

// ดรอปอาร์ตเวิร์กของ LOTTO24 คือ 2026-09-28 และมีสไลด์ที่ใช้ได้สองใบเท่านั้น:
//   slide1.png — โปสเตอร์ "แนะนำเพื่อน โบนัส 0.8%"
//   slide2.png — โปสเตอร์ "คืนยอดเสีย โบนัส 0.3%"
// บทบาทของสองไฟล์นี้ "สลับกัน" ระหว่างแบรนด์มาแล้ว และเคยผูกกลับด้านมาก่อน
// อย่าเชื่อชื่อตัวแปรที่ตกทอดมาและอย่าคัดลอก import จากประวัติ git — รอบนี้ยึดตาม
// คำอธิบายอาร์ตเวิร์กใน brand-spec §6 ซึ่งระบุบทบาทของทั้งสองใบไว้ตรงกัน
//
// ไฟล์สไลด์ลำดับที่สามและสี่ใน src/assets เก่ากว่าดรอปรอบนี้ (2026-09-18 และ
// 2026-08-13) เป็นอาร์ตเวิร์กของลูกค้าเจ้าก่อน — ห้าม import กลับมา และห้ามลบทิ้ง
// เพราะเป็นอินเวนทอรี (ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้ว
// และ verify-build จะแดง) ถ้ามีสไลด์ใหม่เข้ามาให้เช็ก mtime เทียบดรอปก่อนเพิ่ม
// กริดรอบนี้จึงมีสองช่องเท่านั้น ห้ามเติมให้เต็มด้วยของเก่า
import promoReferral from "../assets/slide1.png";
import promoCashback from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";
//
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ: ContentBox title, ย่อหน้าเกริ่นสั้น ๆ หนึ่งย่อหน้า
// (ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมดของหน้านี้), กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม
// — ไม่มีหัวข้อย่อยและไม่มีย่อหน้าเพิ่ม เพราะตัวโปสเตอร์ระบุชื่อโปรและเปอร์เซ็นต์โบนัส
// ไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว เป้าหมาย h1x1, h2x0, h3x0
//
// สไลด์เป็นแบนเนอร์สี่เหลี่ยมจัตุรัส 600x600 จึงวางเป็นกริดสองคอลัมน์คุมความกว้างรวมที่
// max-w-5xl (1024px) ทำให้ช่องละ ~488px ไม่ต้องอัปสเกลเกินขนาดไฟล์ต้นทาง widths หยุด
// ที่ 600 ตามความกว้างจริงของไฟล์ (candidate ที่ใหญ่กว่านั้นไม่มีของให้ครอป)
//
// Announcement หมุนจาก Announcement5 มาเป็น AnnouncementHuay ทั้งเว็บรอบนี้ —
// orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ LOTTO24 แล้ว และ index
// ก็เรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop message มิฉะนั้นตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ LOTTO24 (แดงนำ + ทองตาม บนพื้นดำ ตามโลโก้ที่ LOTTO เป็นขาวเงาและ 24 เป็น
// แดง พร้อมเหรียญทองกับลูกบอลหวยแดง-ขาวในอาร์ตเวิร์ก — คู่สีจริงคือแดงกับทอง):
// พื้นเพจ #000000 · ผิวการ์ด #2a0405 · ผิวยก/hover #7f1d1d · ขอบแดงลึก #b40102 ·
// แดงแบรนด์ #dc2626 · แดงสว่าง #fc2b2c · ทองแบรนด์ #fbbf24 · ทองอ่อน #fde68a ·
// ทองลึก #a16207 · เนื้อความ #f6e2e2 (BRAND_TEXT) · เน้นใน strong #fde68a
// การ์ดโปสเตอร์ใบซ้ายได้ขอบแดง ใบขวาได้ขอบทอง เพื่อให้กริดอ่านเป็นคู่สีแดง+ทอง
// ปุ่ม CTA เป็นไล่เฉดทอง #fbbf24 → #fde68a และใช้หมึกเข้ม #2a0405 เพราะตัวอักษร
// บนพื้นทองห้ามเป็นสีขาว — ทองลึก #a16207 จงใจใช้เฉพาะเส้นขอบ ไม่เอามาอยู่ใต้
// ตัวหนังสือ เพราะหมึกเข้มบนทองลึกเหลือคอนทราสต์แค่ ~3.3:1 ส่วนบนทองแบรนด์ได้ ~10:1
// ชุดชมพู+ม่วงของ SEXYGAME666 รอบก่อน (#fa42b5 #ffb3e2 #ec3fae #8b3df3 #c9a4ff
// #0f0518 #140722 #070109 #12041c #f2dcee #fff2fb rgba(250,66,181,*)
// rgba(139,61,243,*) rgba(4,1,8,*)) ถูกแทนครบทุกจุดแล้ว
//
// LOTTO24 เป็นเว็บแทงหวยออนไลน์ บรีฟระบุแค่อัตราจ่ายเลข 3 ตัวสูงสุด 1,000 และเลข
// 2 ตัว 100 ตามเงื่อนไขของแต่ละรายการ ยอดเข้าบัญชีบริษัทโดยตรงไม่ผ่านม้า วอลเลท
// โบนัสแนะนำเพื่อน 0.8% โบนัสคืนยอดเสีย 0.3% สมัครเอง 3 ขั้นตอน และติดต่อไลน์
// 24 ชั่วโมง — ไม่ได้ระบุชื่อประเภทหวยเจาะจง ชื่อธนาคาร เลขใบอนุญาต เครดิตฟรี
// สล็อต ค่ายเกม บาคาร่า หรือไลฟ์สด จึงห้ามเขียนเพิ่มในหน้านี้
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 156
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "รวมโปรโมชั่นแทงหวย LOTTO24 ทั้งโบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ดูยอดที่เข้าเกณฑ์ รอบคำนวณ และขั้นตอนรับสิทธิ์ของแต่ละรายการผ่านบัญชีสมาชิกก่อนกดรับ";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น LOTTO24",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoReferral.src,
});
---

<MainLayout title="โปรโมชั่น LOTTO24 แนะนำเพื่อน โบนัส 0.8% และคืนยอดเสีย โบนัส 0.3%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น LOTTO24" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#f6e2e2]">
        หน้านี้รวมภาพโปรโมชั่นที่ <strong class="text-[#fde68a]">LOTTO24</strong> เปิดให้สมาชิกกดรับตามรายการและช่วงเวลาที่เว็บไซต์อัปเดตไว้ ทั้งโบนัสแนะนำเพื่อนและโบนัสคืนยอดเสีย โดยรายละเอียดของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว
        <strong class="text-[#fde68a]">ยอดที่เข้าเกณฑ์ รอบคำนวณ และขั้นตอนรับสิทธิ์ของแต่ละรายการแตกต่างกัน</strong> จึงควรตรวจสอบรายละเอียดล่าสุดผ่านบัญชีสมาชิกอีกครั้งก่อนกดรับสิทธิ์ทุกครั้ง
      </p>

      <div class="mx-auto grid w-full max-w-5xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่นพื้นดำแดง ด้านบนเป็นโลโก้ LOTTO24 ที่คำว่า LOTTO เป็นสีขาวเงาและเลข 24 เป็นสีแดง ถัดลงมาเป็นตัวอักษรไทยว่า แนะนำเพื่อน ต่อด้วยคำว่า โบนัส และตัวเลขขนาดใหญ่ขอบทองว่า 0.8% พร้อมไอคอนคนกับลูกศรชี้ขึ้น ด้านซ้ายเป็นหญิงสาวผมยาวสีเข้มสวมสูทสีขาวชี้นิ้วทั้งสองข้างมาที่ข้อความ มุมล่างมีลูกบอลหวยสีแดงขาวเลข 24 และ 6 กับกองเหรียญทอง"
          loading="lazy"
          fetchpriority="low"
          widths={[340, 480, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), 488px"
          class="mx-auto h-auto w-full rounded-xl border border-[#dc2626]/60 object-contain shadow-[0_10px_30px_rgba(0,0,0,0.80)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fc2b2c]/80 hover:shadow-[0_15px_40px_rgba(220,38,38,0.40)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่นชุดเดียวกันพื้นดำแดง ด้านบนเป็นโลโก้ LOTTO24 ถัดลงมาเป็นตัวอักษรไทยว่า คืนยอดเสีย ต่อด้วยคำว่า โบนัส และตัวเลขขนาดใหญ่ขอบทองว่า 0.3% พร้อมลูกศรทองโค้งขึ้น ด้านซ้ายเป็นหญิงสาวผมยาวสีเข้มสวมสูทสีขาวชี้นิ้วมาที่ข้อความ ฉากหลังเป็นใบสลากกินแบ่ง มุมล่างมีลูกบอลหวยสีแดงขาวเลข 24, 6 และ 8 กับกองเหรียญทอง"
          loading="lazy"
          fetchpriority="low"
          widths={[340, 480, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), 488px"
          class="mx-auto h-auto w-full rounded-xl border border-[#fbbf24]/60 object-contain shadow-[0_10px_30px_rgba(0,0,0,0.80)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fde68a]/80 hover:shadow-[0_15px_40px_rgba(251,191,36,0.35)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก LOTTO24"
          class="flex items-center justify-center rounded-lg border border-[#fde68a]/70 bg-gradient-to-r from-[#fbbf24] to-[#fde68a] px-10 py-3.5 text-lg font-black text-[#2a0405] shadow-[0_0_15px_rgba(251,191,36,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก LOTTO24
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
