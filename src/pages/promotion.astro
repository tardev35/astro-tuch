---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

// Only slide1/slide2 belong to LEKDED, and they are exactly the two promotions
// this page shows: slide1 is the "แนะนำเพื่อน 0.8%" poster and slide2 is the
// "คืนยอดเสีย 0.3%" poster (read off the artwork itself).
// slide3/slide4 are still on disk but belong to previous clients — they may not
// be imported here, now or on any future rebrand (an unrendered import is still
// emitted into dist/).
import promoReferral from "../assets/slide1.png";
import promoCashback from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";

// This is an IMAGE page: the ContentBox title, ONE short intro paragraph, the
// poster grid, one CTA. No section headings, no extra prose — the posters
// already state every offer in large type.
//
// 150–160 CHARACTERS (not bytes — a byte count reads ~3x too long for Thai).
// This one is 156.
const pageDescription =
  "รวมโปรโมชั่น LEKDED เว็บซื้อหวยออนไลน์ ทั้งแนะนำเพื่อนรับค่าคอม 0.8% และคืนยอดเสีย 0.3% ดูเปอร์เซ็นต์โบนัส ยอดที่นำมาคำนวณ และรอบรับสิทธิ์ได้จากภาพในหน้านี้";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น LEKDED แนะนำเพื่อน 0.8% คืนยอดเสีย 0.3%",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoReferral.src,
});
---

<MainLayout title="โปรโมชั่น LEKDED แนะนำเพื่อน 0.8% คืนยอดเสีย 0.3% เว็บหวยออนไลน์" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น LEKDED" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#ecdfb4]">
        หน้านี้รวมโปรโมชั่นที่ LEKDED เปิดให้สมาชิกตรวจสอบสิทธิ์และกดรับผ่านบัญชีของตนเอง ทั้งกิจกรรมแนะนำเพื่อนรับค่าคอม <strong class="text-[#efd591]">0.8%</strong>
        และโปรโมชั่นคืนยอดเสีย <strong class="text-[#efd591]">0.3%</strong> โดยเปอร์เซ็นต์โบนัส ยอดที่นำมาคำนวณ และรอบเวลารับสิทธิ์ระบุไว้บนภาพโปรโมชั่นแต่ละใบ
        แต่ละรายการมีวิธีคำนวณและเงื่อนไขต่างกัน จึงควรอ่านรายละเอียดล่าสุดหรือสอบถามแอดมินก่อนกดรับทุกครั้ง
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่นพื้นหลังสีดำทองเขียว ด้านบนเป็นโลโก้ LEKDED รูปลูกบอลเลข 8 สวมมงกุฎ กลางภาพเป็นกรอบสีดำขอบทองเขียนว่า โปรโมชั่น แนะนำเพื่อน พร้อมตัวเลขทองขนาดใหญ่ 0.8% ด้านขวาเป็นผู้หญิงผมสีเงินยาวในชุดสีทองเขียวยืนแบมือ ด้านล่างมีสลากลอตเตอรี่สองใบ เหรียญทอง และลูกบอลเลข 8 กับเลข 9 พร้อมแถบข้อความ แนะนำเพื่อนรับค่าคอมมิชชั่น รับค่าคอมสูงสุด 0.8% และระบบออโต้รวดเร็วทันใจ ส่วนแถบล่างเขียนว่า มั่นคง ปลอดภัย 100% ฝาก-ถอน ออโต้ บริการตลอด 24 ชม."
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#7a5d2c]/70 object-contain shadow-[0_10px_30px_rgba(181,129,30,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#e2c466]/70 hover:shadow-[0_15px_40px_rgba(226,196,102,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่นพื้นหลังสีดำทองเขียว ด้านบนเป็นโลโก้ LEKDED รูปลูกบอลเลข 8 สวมมงกุฎ กลางภาพเป็นกรอบสีดำขอบทองเขียนว่า โปรโมชั่น คืนยอดเสีย พร้อมตัวเลขทองขนาดใหญ่ 0.3% ด้านขวาเป็นผู้หญิงผมสีเงินยาวในชุดสีทองเขียวยืนแบมือ ด้านล่างมีตารางโพยหวยสามใบเขียนว่า รัฐบาลไทย ฮานอย และลาว พร้อมเหรียญทองและลูกบอลเลข 3 กับเลข 8 มีแถบข้อความ กดรับได้ทุกวัน มั่นคงปลอดภัยเชื่อถือได้ 100% และบริการตลอด 24 ชม. ส่วนแถบล่างเขียนว่า ซื้อหวยง่าย จ่ายจริง จ่ายเต็มทุกบิล"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#7a5d2c]/70 object-contain shadow-[0_10px_30px_rgba(181,129,30,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#e2c466]/70 hover:shadow-[0_15px_40px_rgba(226,196,102,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#e2c466]/70 bg-gradient-to-r from-[#fbe479] via-[#e2c466] to-[#b5811e] px-10 py-3.5 text-lg font-black text-[#030803] shadow-[0_0_15px_rgba(226,196,102,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก LEKDED
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
