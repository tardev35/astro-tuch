---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

// ดรอปอาร์ตเวิร์กของ CK268 คือ 2026-09-30 01:01 และมีโปสเตอร์โปรโมชั่นแค่ "สองใบ"
// เปิดดูไฟล์จริงทุกไฟล์แล้วก่อนผูก อย่าเชื่อชื่อตัวแปรที่ตกทอดมาและอย่าคัดลอก
// import จากประวัติ git เพราะบทบาทของไฟล์ชุดนี้สลับกันมาแล้วหลายแบรนด์ — รอบ GOT777
// slide1 คือ 0.8% และ slide2 คือ 0.3% ซึ่งกลับด้านกับรอบนี้พอดี:
//   slide1.png — 600x600 โปสเตอร์ CK268 ป้ายดำ "คืนยอดเสีย โบนัส" + เลขเขียวนีออน 0.3%
//   slide2.png — 600x600 โปสเตอร์ชุดเดียวกัน ป้ายดำ "แนะนำเพื่อน โบนัส" + เลขเขียว 0.8%
//   slide3.png / slide4.png — โปสเตอร์หวย "3ตัว1,000" ของ LOTTOPLUS (แบรนด์ก่อน
//     ลงวันที่ 29 ก.ย. 22:07 เก่ากว่าดรอปนี้) ห้าม import กลับมาเด็ดขาด เพราะจะเอา
//     โปสเตอร์ของแบรนด์คู่แข่งคนละสินค้าขึ้นหน้านี้ และห้ามลบไฟล์ทิ้งเพราะเป็น
//     อินเวนทอรีของรอบถัดไป
// ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้วและ verify-build จะแดง
// ถ้ามีสไลด์ใหม่เข้ามาให้เช็ก mtime เทียบดรอปก่อนเพิ่ม (banner2/banner3 ใน
// src/assets เก่ากว่าดรอปนี้ = อาร์ตเวิร์กแบรนด์ก่อน ห้าม import กลับมา)
import promoCashback from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";
//
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ: ContentBox title, ย่อหน้าเกริ่นสั้น ๆ หนึ่งย่อหน้า
// (ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมดของหน้านี้), กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม
// — ไม่มีหัวข้อย่อยและไม่มีย่อหน้าเพิ่ม เพราะตัวโปสเตอร์ระบุชื่อโปรและตัวเลขโบนัส
// ไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว เป้าหมาย h1x1, h2x0, h3x0
//
// สไลด์รอบนี้เป็นจัตุรัส 600x600 (วัดจากไฟล์จริง) จึงวางเป็นกริดสองคอลัมน์คุมความ
// กว้างรวมที่ max-w-4xl (896px) ทำให้ช่องละ ~436px ไม่ต้องอัปสเกลเกินขนาดไฟล์ต้นทาง
// widths หยุดที่ 600 ตามความกว้างจริงของไฟล์ สองใบพอดีหนึ่งแถว กริดจึงจัดกลาง
// สมมาตรโดยไม่ต้องมีใบที่ span สองคอลัมน์
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ (รอบก่อนเป็น Announcement3)
// — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ CK268 แล้ว และ index
// ก็เรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop message มิฉะนั้นตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ CK268 (เขียวนีออนนำ โครเมียมขาว-เงินรอง บนพื้นดำ ตามโลโก้ตัวอักษรโครเมียม
// สลับเขียวนีออน และแบนเนอร์พื้นดำสนิทที่มีริ้วแสงเขียวนีออนพาดโค้ง ชิปคาสิโนเขียว-ดำ):
// พื้นเพจ #030703 · ผิวยก #071007 · ผิวยก 2 #0f1b0e ·
// เขียวนีออนหลัก #8bfc13 · เขียวอ่อน #c9ff8f · เขียวลึก #1a7a08 ·
// เขียวเข้มรอง #12a008 · เขียวมืดสุด #052e16 · โครเมียมขาว #e8f0e6 ·
// เนื้อความ #d5e6cd (BRAND_TEXT) · เนื้อความรอง #b9c9b4 · เน้นใน strong #eaffd6 ·
// หมึกบนพื้นเขียว #071007
// การ์ดโปสเตอร์ได้ขอบเขียวนีออนทั้งสองใบเพราะเลขโบนัสบนภาพทั้งคู่เป็นตัวอักษรเขียวนีออน
// ปุ่ม CTA เป็นไล่เฉดเขียว #c9ff8f → #8bfc13 → #1a7a08 และใช้หมึกเข้ม #071007
// (หมึกเข้มบนเขียวนีออน #8bfc13 ผ่านสบาย ส่วนขาวบนเขียวนีออนได้แค่ ~1.5:1 ตก AA)
// ชุดทอง-แดงของ GOT777 (#f5c518 #ffe9a8 #96690f #fff6dd #ece0cb #bdae92 #d21622
// #7b0304 #4c0301 #0a0503 #160b06 #241108 rgba(245,197,24,*) rgba(5,2,0,*))
// ถูกแทนครบทุกจุดแล้ว และทองห้ามกลับมาเป็นสีหลัก เพราะแบรนด์ก่อนเป็นทอง+แดง
//
// CK268 เป็นเว็บ "เกมสล็อตออนไลน์" ไม่ใช่เว็บหวย — คำว่า หวย โพย แทงหวย ตรวจหวย
// รัฐบาลไทย ลาวพัฒนา ฮานอย หวยหุ้น อัตราจ่าย 2 ตัว/3 ตัว รอบออกรางวัล ส่งโพย งวด
// เลขเด็ด ห้ามปรากฏบนหน้านี้ ตัวเลขที่บรีฟระบุและใช้ได้มีแค่ คืนยอดเสีย 0.3% ·
// แนะนำเพื่อน 0.8% · 1 บาท · 3 ขั้นตอน · 24 ชั่วโมง · และ 268 ในชื่อแบรนด์ ห้ามเพิ่ม
// ชื่อค่ายเกม ชื่อธนาคาร ยอดฝากขั้นต่ำ เลขใบอนุญาต หรือตัวเลข RTP และต้องคง hedge
// ของบรีฟไว้ว่าแต่ละโปรโมชั่นอาจกำหนดรอบคำนวณ ยอดที่เข้าเกณฑ์ ประเภทเกมสล็อต และ
// ระยะเวลารับสิทธิ์ต่างกัน จึงควรตรวจสอบรายละเอียดล่าสุดก่อนกดรับโบนัส
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 155
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "รวมภาพโปรโมชั่นเกมสล็อต CK268 ทั้งโบนัสคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ตรวจสอบเกมที่ร่วมรายการ รอบคำนวณ และเงื่อนไขล่าสุดจากหน้าเว็บไซต์ก่อนกดรับสิทธิ์";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่นเกมสล็อต CK268",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});
---

<MainLayout title="โปรโมชั่น CK268 เกมสล็อต คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่นเกมสล็อต CK268" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#d5e6cd]">
        หน้านี้รวมภาพโปรโมชั่นที่ <strong class="text-[#eaffd6]">CK268</strong> เปิดให้สมาชิก Login เข้าไปตรวจสอบสิทธิ์จากบัญชีของตนเอง ทั้งโบนัสคืนยอดเสียและกิจกรรมแนะนำเพื่อน โดยรายละเอียดของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว
        <strong class="text-[#eaffd6]">แต่ละโปรโมชั่นอาจกำหนดรอบคำนวณ ยอดที่เข้าเกณฑ์ ประเภทเกมสล็อต และระยะเวลารับสิทธิ์แตกต่างกัน</strong> จึงควรตรวจสอบรายละเอียดล่าสุดจากหน้าเว็บไซต์ให้ครบก่อนกดรับโบนัสทุกครั้ง
      </p>

      <div class="mx-auto grid w-full max-w-4xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่น CK268 พื้นดำมีชิปคาสิโนเขียว-ดำและเหรียญทองกระจายอยู่ ด้านซ้ายเป็นหญิงสาวผมยาวสวมชุดขาวยื่นมือออกมา ด้านบนเป็นโลโก้ CK268 ถัดลงมาเป็นตัวอักษรไทยโครเมียมขนาดใหญ่ว่า โปรโมชั่น ใต้ลงไปเป็นป้ายดำคำว่า คืนยอดเสีย โบนัส คร่อมตัวเลขเขียวนีออนขนาดใหญ่ 0.3% มุมขวาล่างเป็นเครื่องสล็อตเลข 777 และมีกล่องของขวัญสีเขียวอยู่มุมซ้ายล่าง"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), (max-width: 1007px) calc((100vw - 136px) / 2), 436px"
          class="mx-auto h-auto w-full rounded-xl border border-[#8bfc13]/60 object-contain shadow-[0_10px_30px_rgba(1,4,1,0.85)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#c9ff8f]/85 hover:shadow-[0_15px_40px_rgba(139,252,19,0.40)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่น CK268 ชุดเดียวกัน พื้นดำมีชิปคาสิโนเขียว-ดำและเหรียญทอง ด้านซ้ายเป็นหญิงสาวผมยาวสวมชุดขาวยกนิ้วชี้ขึ้น ด้านบนเป็นโลโก้ CK268 ถัดลงมาเป็นตัวอักษรไทยโครเมียมขนาดใหญ่ว่า โปรโมชั่น ใต้ลงไปเป็นป้ายดำคำว่า แนะนำเพื่อน โบนัส คร่อมตัวเลขเขียวนีออนขนาดใหญ่ 0.8% ล้อมด้วยกล่องของขวัญสีเขียว"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), (max-width: 1007px) calc((100vw - 136px) / 2), 436px"
          class="mx-auto h-auto w-full rounded-xl border border-[#8bfc13]/60 object-contain shadow-[0_10px_30px_rgba(1,4,1,0.85)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#c9ff8f]/85 hover:shadow-[0_15px_40px_rgba(139,252,19,0.40)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก CK268"
          class="flex items-center justify-center rounded-lg border border-[#8bfc13]/70 bg-gradient-to-r from-[#c9ff8f] via-[#8bfc13] to-[#1a7a08] px-10 py-3.5 text-lg font-black text-[#071007] shadow-[0_0_15px_rgba(139,252,19,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก CK268
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
