---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

// ดรอปอาร์ตเวิร์กของ MIRACLE55 คือ 2026-09-25 และมีสไลด์ที่ใช้ได้สองใบเท่านั้น:
//   slide1.png — โปสเตอร์ "โปรโมชั่น คืนยอดเสีย โบนัส 0.3%"
//   slide2.png — โปสเตอร์ "โปรโมชั่น แนะนำเพื่อน โบนัส 0.8%"
// บทบาทของสองไฟล์นี้ "สลับกัน" ระหว่างแบรนด์มาแล้ว และรอบก่อนผูกชื่อตัวแปรไว้กลับ
// ด้านกับไฟล์จริง อย่าเชื่อชื่อตัวแปรที่ตกทอดมา — รอบนี้เปิดไฟล์ดูจริงแล้วและตรงกับ
// คำอธิบายอาร์ตเวิร์กใน brand-spec §4 ทั้งสองใบ
//
// ไฟล์สไลด์ลำดับที่สามและสี่ใน src/assets เก่ากว่าดรอปรอบนี้ (2026-09-18 และ
// 2026-08-13) เป็นอาร์ตเวิร์กของลูกค้าเจ้าก่อน — ห้าม import กลับมา และห้ามลบทิ้งเพราะเป็น
// อินเวนทอรี (ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้ว และ
// verify-build จะแดง) ถ้ามีสไลด์ใหม่เข้ามาให้เช็ก mtime เทียบดรอปก่อนเพิ่ม
// กริดรอบนี้จึงมีสองช่องเท่านั้น ห้ามเติมให้เต็มด้วยของเก่า
import promoCashback from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";
//
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ: ContentBox title, ย่อหน้าเกริ่นสั้น ๆ หนึ่งย่อหน้า
// (ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมดของหน้านี้), กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม
// — ไม่มีหัวข้อย่อยและไม่มีย่อหน้าเพิ่ม เพราะตัวโปสเตอร์ระบุชื่อโปรและเปอร์เซ็นต์โบนัส
// ไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว เป้าหมาย h1x1, h2x0, h3x0
//
// สไลด์เป็นแบนเนอร์แนวนอน 600px จึงวางเป็นกริดสองคอลัมน์คุมความกว้างรวมที่ max-w-5xl
// (1024px) ทำให้ช่องละ ~488px ไม่ต้องอัปสเกลเกินขนาดไฟล์ต้นทาง widths หยุดที่ 600
// ตามความกว้างจริงของไฟล์ (candidate ที่ใหญ่กว่านั้นไม่มีของให้ครอป)
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ — default message ของไฟล์
// นั้นถูกตั้งเป็นคอปปี้ของ MIRACLE55 แล้ว และ index ก็เรียกแบบ bare เหมือนกัน
// จึงห้ามส่ง prop
//
// พาเลตต์ MIRACLE55 (ทอง + เงินโครเมียมบนดำ ตามโลโก้ที่ MI เป็นทอง RACLE เป็นเงิน
// ขัดเงา และ 55 เป็นทอง — เฉดที่สองรอบนี้เป็นโครเมียมเย็น ไม่ใช่ครีมอุ่น):
// พื้นเพจ #050403 · ผิวการ์ด #14100a · ผิวยก #1b140b · ทองแบรนด์ #fcda65 ·
// ทองสว่าง #fee47b · ทองทึบ/เส้นขอบ #d9a62b · ทองลึก #8c5f14 ·
// เงินโครเมียม #d2d3d4 · เงินสว่าง #eaeaea · เนื้อความ #e8e6e1 (BRAND_TEXT) ·
// เน้นใน strong #fcfcfc — ชุดทองล้วนของรอบก่อนถูกแทนครบทุกจุดแล้ว
// การ์ดโปสเตอร์ใบซ้ายได้ขอบทอง ใบขวาได้ขอบเงินโครเมียม เพื่อให้กริดอ่านเป็นสองโลหะ
// ตัวอักษรบนพื้นทองต้องเป็นดำ #14100a ห้ามใช้ขาว
//
// MIRACLE55 เป็นแบรนด์คาสิโน — คำศัพท์เฉพาะหมวดของแบรนด์ก่อนหน้าห้ามหลงเหลือในหน้านี้
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 158
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "รวมโปรโมชั่น MIRACLE55 ทั้งโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% ดูรายละเอียดยอดที่เข้าเกณฑ์ รอบคำนวณ และเงื่อนไขของแต่ละรายการก่อนกดรับสิทธิ์ทุกครั้ง";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น MIRACLE55",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoReferral.src,
});
---

<MainLayout title="โปรโมชั่น MIRACLE55 แนะนำเพื่อน โบนัส 0.8% และคืนยอดเสีย โบนัส 0.3%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น MIRACLE55" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#e8e6e1]">
        หน้านี้รวมภาพโปรโมชั่นที่ <strong class="text-[#fcfcfc]">MIRACLE55</strong> เปิดให้สมาชิกกดรับตามรายการและช่วงเวลาที่กำหนด ทั้งโบนัสแนะนำเพื่อนและโบนัสคืนยอดเสีย โดยรายละเอียดของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว
        <strong class="text-[#fcfcfc]">ยอดที่เข้าเกณฑ์ รอบคำนวณ และเงื่อนไขของแต่ละรายการแตกต่างกัน</strong> จึงควรตรวจสอบรายละเอียดล่าสุดจากหน้าเว็บไซต์อีกครั้งก่อนกดรับสิทธิ์ทุกครั้ง
      </p>

      <div class="mx-auto grid w-full max-w-5xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่นพื้นดำประดับลายทอง ด้านซ้ายบนเป็นโลโก้ MIRACLE55 ที่ตัวอักษร MI กับเลข 55 เป็นสีทองและคำว่า RACLE เป็นสีเงินโครเมียม ถัดลงมาเป็นข้อความไทยตัวอักษรทองว่า โปรโมชั่น แนะนำเพื่อน และแผ่นป้ายขอบทองข้อความว่า โบนัส 0.8% ด้านขวาเป็นหญิงสาวผมยาวสีเข้มในเสื้อสูทขาวยิ้มและแบมือทั้งสองข้างนำเสนอโปรโมชั่น มุมซ้ายล่างเป็นกองชิปคาสิโนสีดำขลิบทอง มุมขวาบนเป็นไพ่เอซพิมพ์ลายทอง"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), 488px"
          class="mx-auto h-auto w-full rounded-xl border border-[#d9a62b]/55 object-contain shadow-[0_10px_30px_rgba(5,4,3,0.80)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fee47b]/75 hover:shadow-[0_15px_40px_rgba(252,218,101,0.40)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่นชุดเดียวกัน พื้นดำประดับลายทอง ด้านบนกลางภาพเป็นโลโก้ MIRACLE55 ตัวอักษรทองสลับเงินโครเมียมพร้อมมงกุฎทองดวงเล็ก ถัดลงมาเป็นข้อความไทยตัวอักษรทองว่า โปรโมชั่น คืนยอดเสีย และตัวเลขทองขนาดใหญ่ว่า โบนัส 0.3% ด้านซ้ายเป็นหญิงสาวในเสื้อสูทขาวยิ้มและชี้นิ้วขึ้นไปที่ข้อความ รอบภาพมีชิปคาสิโนสีดำขลิบทอง เหรียญทอง และไพ่เอซโพดำกระจายอยู่"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), 488px"
          class="mx-auto h-auto w-full rounded-xl border border-[#d2d3d4]/45 object-contain shadow-[0_10px_30px_rgba(5,4,3,0.80)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#eaeaea]/70 hover:shadow-[0_15px_40px_rgba(210,211,212,0.28)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก MIRACLE55"
          class="flex items-center justify-center rounded-lg border border-[#fee47b]/60 bg-gradient-to-r from-[#fee47b] via-[#fcda65] to-[#d9a62b] px-10 py-3.5 text-lg font-black text-[#14100a] shadow-[0_0_15px_rgba(252,218,101,0.50)] transition-transform hover:scale-105">
          สมัครสมาชิก MIRACLE55
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
