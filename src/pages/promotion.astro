---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

// Only slide1/slide2 belong to this brand (HSOD drop, 2026-08-11) and both
// are literally the two promotions this page shows: slide1 is the
// "คืนยอดเสีย รับโบนัส 0.3%" poster, slide2 is the "แนะนำเพื่อน รับโบนัส 0.8%"
// poster. slide3/slide4 still on disk are a previous client's artwork — they
// may not be imported here, now or on any future rebrand.
import promoCashback from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";

const pageDescription = "รวมโปรโมชั่น HSOD คืนยอดเสียรับโบนัส 0.3% และแนะนำเพื่อนรับโบนัส 0.8% ดูรายละเอียดโปรแต่ละรายการและตรวจสอบเงื่อนไขการรับสิทธิ์ผ่านระบบสมาชิกก่อนกดรับทุกครั้ง";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น HSOD คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8%",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});
---

<MainLayout title="โปรโมชั่น HSOD คืนยอดเสียรับ 0.3% แนะนำเพื่อนรับ 0.8%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น HSOD" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#dfe3ea]">
        หน้านี้รวมโปรโมชั่นที่ HSOD เปิดรับอยู่ในขณะนี้ ทั้งคืนยอดเสียรับโบนัส 0.3% และแนะนำเพื่อนรับโบนัส 0.8% รายละเอียดของโบนัส ยอดที่นำมาคำนวณ และรอบเวลาการรับสิทธิ์ระบุไว้บนภาพโปรโมชั่นแต่ละใบ
        และเงื่อนไขของแต่ละรายการไม่เหมือนกัน สมาชิกตรวจสอบยอดสะสมและกดรับสิทธิ์ได้จากบัญชีสมาชิก หรือสอบถามแอดมินที่ดูแลตลอด 24 ชั่วโมง
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่น HSOD พื้นดำลายวงจรสีแดง โลโก้ HSOD ตัวอักษรโครเมียมเงินขอบแดง ข้อความ โปรโมชั่น คืนยอดเสีย รับโบนัส 0.3% หญิงสาวผมยาวสีเงินสวมชุดหนังแดงดำติดโลโก้ HSOD มือถือแสดงหน้าแทงหวยรัฐบาลบาทละ 900 ลูกบอลหวยเลข 8 3 9 เหรียญทองและสลากกินแบ่งรัฐบาล"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#7c0207]/45 object-contain shadow-[0_10px_30px_rgba(232,18,29,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#e8121d]/70 hover:shadow-[0_15px_40px_rgba(232,18,29,0.28)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่น HSOD พื้นดำลายวงจรสีแดง โลโก้ HSOD ตัวอักษรโครเมียมเงินขอบแดง ข้อความ โปรโมชั่น แนะนำเพื่อน รับโบนัส 0.8% และ ชวนง่าย รับจริง ไม่อั้น หญิงสาวผมยาวสีเงินสวมชุดแดงดำ มือถือแสดงเมนู แทงง่าย จ่ายจริง ครบทุกหวย ลูกบอลหวยเลข 9 3 8 และเหรียญทอง"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#7c0207]/45 object-contain shadow-[0_10px_30px_rgba(232,18,29,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#e8121d]/70 hover:shadow-[0_15px_40px_rgba(232,18,29,0.28)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg bg-gradient-to-r from-[#ff4d55] via-[#e8121d] to-[#7c0207] px-10 py-3.5 text-lg font-black text-[#1a0204] shadow-[0_0_15px_rgba(232,18,29,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก HSOD
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
