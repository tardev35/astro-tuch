---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

// slide1/slide2 เท่านั้นที่เป็นของ UFA168 และเป็นโปรโมชั่นสองรายการที่หน้านี้แสดง
// slide1 คือโปสเตอร์ "แนะนำเพื่อน 0.8%" ส่วน slide2 คือ "คืนยอดเสีย 0.3%" (อ่านจากตัวภาพ)
// slide3/slide4 ยังค้างอยู่บนดิสก์แต่เป็นของลูกค้าก่อนหน้า — ห้าม import ที่นี่
// ทั้งรอบนี้และรอบถัดไป (ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้ว)
import promoReferral from "../assets/slide1.png";
import promoCashback from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็น IMAGE page: ContentBox title, ย่อหน้าเกริ่นสั้น ๆ หนึ่งย่อหน้า, กริดโปสเตอร์,
// ปุ่ม CTA หนึ่งปุ่ม — ไม่มีหัวข้อย่อยและไม่มีย่อหน้าเพิ่ม เพราะตัวโปสเตอร์ระบุเงื่อนไข
// ของแต่ละโปรโมชั่นไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 158
const pageDescription =
  "รวมโปรโมชั่น UFA168 ทั้งกิจกรรมแนะนำเพื่อนรับโบนัส 0.8% และคืนยอดเสีย 0.3% ดูเปอร์เซ็นต์โบนัส ยอดที่นำมาคำนวณ และรอบรับสิทธิ์ได้จากภาพโปรโมชั่นในหน้านี้โดยตรง";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น UFA168 แนะนำเพื่อน 0.8% คืนยอดเสีย 0.3%",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoReferral.src,
});
---

<MainLayout title="โปรโมชั่น UFA168 แนะนำเพื่อนรับ 0.8% และคืนยอดเสีย 0.3%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น UFA168" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#e6dcc2]">
        หน้านี้รวมโปรโมชั่นที่ UFA168 เปิดให้สมาชิกตรวจสอบสิทธิ์และกดรับผ่านบัญชีของตนเอง ทั้งกิจกรรมแนะนำเพื่อนรับ <strong class="text-[#f3db5b]">0.8%</strong>
        และโปรโมชั่นคืนยอดเสีย <strong class="text-[#f3db5b]">0.3%</strong> โดยเปอร์เซ็นต์โบนัส ยอดที่นำมาคำนวณ และรอบเวลารับสิทธิ์ระบุไว้บนภาพโปรโมชั่นแต่ละใบ
        แต่ละรายการมีวิธีคำนวณและเงื่อนไขต่างกัน จึงควรอ่านรายละเอียดล่าสุดหรือสอบถามแอดมินก่อนกดรับทุกครั้ง
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อนของ UFA168 พื้นหลังสีดำมีประกายทองและเหรียญทอง ด้านบนเป็นตัวอักษรโลหะคำว่า UFA168 กลางภาพเป็นข้อความสีขาวว่า โปรโมชั่น แนะนำเพื่อน พร้อมตัวเลขสีทองขนาดใหญ่ 0.8% ในกรอบสีทอง รอบภาพมีชิปคาสิโน ลูกเต๋า กล่องของขวัญ ไพ่โพดำ และวงล้อรูเล็ต ด้านขวาเป็นผู้หญิงผมบลอนด์ในชุดทองเงินชี้นิ้วมาที่ตัวเลข ด้านล่างมีสี่ไอคอนเขียนว่า แชร์ง่ายรับโบนัสทันที รับโบนัสจากยอดเพื่อน ระบบปลอดภัยมั่นคง 100% และ บริการตลอด 24 ชั่วโมง"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#6b5316]/70 object-contain shadow-[0_10px_30px_rgba(5,4,3,0.55)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f3db5b]/70 hover:shadow-[0_15px_40px_rgba(243,219,91,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่นคืนยอดเสียของ UFA168 พื้นหลังสีดำมีประกายทองและเหรียญทองกระจาย ด้านบนเป็นตัวอักษรโลหะคำว่า UFA168 ถัดลงมาเป็นข้อความสีขาวว่า โปรโมชั่น และคำว่า คืนยอดเสีย สีเงินบนแถบสีดำ พร้อมตัวเลขสีทองขนาดใหญ่ 0.3% ด้านขวาเป็นผู้หญิงผมบลอนด์ในชุดทองเงินชี้นิ้วมาที่ตัวเลข ฉากหลังมีวงล้อรูเล็ต ด้านล่างซ้ายมีไพ่เอซโพดำและเหรียญทอง พร้อมสามไอคอนเขียนว่า ระบบมั่นคงปลอดภัย 100% ฝาก-ถอนออโต้รวดเร็ว และ บริการตลอด 24 ชั่วโมง"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#6b5316]/70 object-contain shadow-[0_10px_30px_rgba(5,4,3,0.55)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f3db5b]/70 hover:shadow-[0_15px_40px_rgba(243,219,91,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#f3db5b]/70 bg-gradient-to-r from-[#fff3bf] via-[#f3db5b] to-[#a37c14] px-10 py-3.5 text-lg font-black text-[#050403] shadow-[0_0_15px_rgba(243,219,91,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก UFA168
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
