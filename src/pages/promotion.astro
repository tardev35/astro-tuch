---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";

import { Picture } from "astro:assets";

// ดรอปอาร์ตเวิร์กของ หวยคิง คือ 2026-10-04 และมีโปสเตอร์ที่ใช้ได้แค่สองใบ
// (brand-spec §5) — ทั้งคู่ขนาด 600x600 ห้ามเดาจากชื่อไฟล์ และห้ามเชื่อคอมเมนต์
// ของรอบก่อน ต้องยึดสเปกของรอบนี้:
//   slide2.png — "อัตราการจ่าย" + ป้ายพื้นดำขอบทอง "2ตัว จ่าย100บาท"
//   slide1.png — "อัตราการจ่าย" + ป้ายพื้นดำขอบทอง "3ตัว จ่าย1,000บาท"
//   slide3.png / slide4.png — โปสเตอร์ของแบรนด์ก่อน (29 ก.ย. เก่ากว่าดรอปนี้)
//     ห้าม import กลับมาเด็ดขาด และห้ามลบไฟล์ทิ้งเพราะเป็นอินเวนทอรีของรอบถัดไป
// ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้วและ verify-build จะแดง
// (banner2/banner3 ใน src/assets ก็เก่ากว่าดรอปนี้ = อาร์ตเวิร์กแบรนด์ก่อน ห้าม import)
// ส่วน banner1 / banner1-mobile / og.png เป็นของ MainLayout ห้าม import จากหน้านี้
// ชื่อตัวแปรตั้งตามข้อความบนภาพ ไม่ใช่ตามเลขไฟล์ เพื่อไม่ให้รอบหน้าสลับผิดอีก
import promoTwoDigit from "../assets/slide2.png";
import promoThreeDigit from "../assets/slide1.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้น ๆ "หนึ่งย่อหน้า ประมาณสี่บรรทัด" คือ
// โควตาตัวหนังสือทั้งหมดของหน้านี้, กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อย
// และห้ามเพิ่มย่อหน้า เพราะตัวโปสเตอร์ระบุอัตราจ่ายไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว
// การพิมพ์ซ้ำด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ เป้าหมาย h1x1 h2x0 h3x0
//
// สไลด์รอบนี้เป็น 600x600 จึงวางเป็นกริดสองคอลัมน์คุมความกว้างรวมที่ max-w-4xl
// (896px) ทำให้ช่องละ ~436px ไม่ต้องอัปสเกลเกินขนาดไฟล์ต้นทาง widths หยุดที่ 600 ตาม
// ความกว้างจริงของไฟล์ และคุมภาพต่อใบไว้ที่ max-w-[600px] สองใบพอดีหนึ่งแถว กริดจึง
// จัดกลางสมมาตรโดยไม่ต้องมีใบที่ span สองคอลัมน์ · เรียง 2 ตัวจ่าย 100 บาท ก่อน
// 3 ตัวจ่าย 1,000 บาท ตามลำดับของบรีฟ (docx H3 #4 แล้วค่อย #5) · LCP คือ hero ใน
// MainLayout ไม่ใช่สองรูปนี้ จึง loading="lazy" fetchpriority="low" ทั้งคู่
//
// Announcement รอบนี้เป็น AnnouncementHuay ทั้งเว็บ (รอบก่อน UP555 ใช้ Announcement5)
// — default message ของไฟล์นั้นเป็นคอปปี้ของ หวยคิง แล้ว และทุกหน้าก็เรียกแบบ bare
// เหมือนกัน จึงห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกันระหว่างหน้า
//
// พาเลตต์ หวยคิง (brand-spec §2) ทองโลหะบนดำอมน้ำตาล คู่สีรองเป็นครีมอมพีช (ชุดขาว
// ของนางแบบใน slide1/slide2) ไม่ใช่เงินโครเมียมแบบ UP555: ทองแบรนด์ #cd9a2c
// (ขอบรูป) · ทองสว่าง #fdeb7c (หมึก strong, hover ขอบ, ต้นไล่เฉดปุ่ม) · ทองลึก
// #ab7314 (ปลายไล่เฉด, ขอบปุ่ม) · ครีมอมพีช #fcd4c3 / #fce2d4 (สีรอง) ·
// พื้นลึกสุด #0c0b0a (เงารูป) · ผิวการ์ดยก #1c140b · หมึกบนปุ่มทอง #120a02 ·
// เนื้อความ #f5e7c8 (BRAND_TEXT มาจาก <html> และการ์ด ContentBox ตั้งให้แล้ว จึงไม่
// ต้องระบุสีที่ย่อหน้า) · glow เป็น rgba(205,154,44,α)
// ชุดทอง + เงินโครเมียมของ UP555 (#ebbb54 #fce675 #ab6d24 #d5d4d3 #f3f3f2 #130b03
// #241705 #0c0502 #160d02 #f8eed9 rgba(235,187,84,*) rgba(12,5,2,*)) ออกครบแล้ว
//
// หวยคิง เป็น **เว็บหวยล้วน** ไม่ใช่คาสิโน — คำของแบรนด์ก่อน (สล็อต บาคาร่า บอล
// เดิมพันฟุตบอล ค่ายเกม คาสิโนสด หมวดเกม RTP ความผันผวน ทางเข้าเล่นใหม่ ระบบอัปเกรด
// คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% เว็บตรงต่างประเทศ บัญชีบริษัทแท้ 100%) ห้ามหลงเหลือ
// ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 100 / 1,000 / 2 ตัว / 3 ตัว / 3 ขั้นตอน / 24 ชั่วโมง
// ห้ามแต่งชื่อตลาดหวย เวลาเปิด-ปิดรับ ชื่อธนาคาร เลขใบอนุญาต หรือยอดฝากขั้นต่ำ
// และต้องคงคำกำกับของบรีฟไว้ว่าอัตราจ่ายอาจต่างตามประเภทหวยและรอบ จึงให้ยึดอัตรา
// ล่าสุดบนหน้าส่งโพยก่อนยืนยัน
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 155
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `รวมภาพโปรโมชั่นอัตราจ่ายของ ${BRAND_NAME} ทั้งเลข 2 ตัวจ่าย 100 บาท และเลข 3 ตัวจ่าย 1,000 บาท ควรตรวจอัตราจ่ายและวงเงินรับแทงบนหน้าส่งโพยก่อนยืนยันรายการทุกครั้ง`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่นอัตราจ่าย ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoTwoDigit.src,
});
---

<MainLayout title={`โปรโมชั่นอัตราจ่าย ${BRAND_NAME} 2ตัว จ่าย100บาท และ 3ตัว จ่าย1,000บาท`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`โปรโมชั่นอัตราจ่าย ${BRAND_NAME}`} as="h1">
    <div class="flex flex-col gap-10">
      <p class="text-left text-base leading-relaxed">
        หน้านี้รวมภาพอัตราการจ่ายที่ <strong class="text-[#fdeb7c]">{BRAND_NAME}</strong> เปิดรับสำหรับรายการที่เข้าเงื่อนไข ทั้งเลข 2 ตัวและเลข 3 ตัว โดยรายละเอียดของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว
        <strong class="text-[#fdeb7c]">อัตราจ่ายอาจแตกต่างตามประเภทหวย รูปแบบการแทง หรือเงื่อนไขของแต่ละรอบ</strong> จึงควร Login อ่านอัตราล่าสุดและวงเงินรับแทงบนหน้าส่งโพยก่อนยืนยันรายการทุกครั้ง
      </p>

      <div class="mx-auto grid w-full max-w-4xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoTwoDigit}
          alt="ภาพอัตราการจ่ายของ หวยคิง พื้นหลังสีดำอมทอง มีเหรียญทองและลูกบอลหวยเลข 8 3 6 ลอยกระจาย ด้านซ้ายเป็นหญิงสาวผมยาวสีน้ำตาลติดโบว์สีขาว สวมชุดสีขาวประดับทอง ถือลูกบอลหวยเลข 9 ไว้ในมือและยื่นมืออีกข้างแบออกมา ด้านขวาล่างมีใบสลากกินแบ่ง บนสุดเป็นโลโก้มงกุฎทองกับคำว่า หวยคิง ถัดลงมาเป็นตัวอักษรไทยสีทองขนาดใหญ่ว่า อัตราการจ่าย และป้ายพื้นดำขอบทองข้อความ 2ตัว จ่าย100บาท"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), (max-width: 1007px) calc((100vw - 136px) / 2), 436px"
          class="mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#cd9a2c]/60 object-contain shadow-[0_10px_30px_rgba(12,11,10,0.85)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fdeb7c]/85 hover:shadow-[0_15px_40px_rgba(205,154,44,0.40)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoThreeDigit}
          alt="ภาพอัตราการจ่ายของ หวยคิง พื้นหลังสีดำอมทอง มีเหรียญทองลอยกระจาย ด้านซ้ายเป็นหญิงสาวผมยาวสีน้ำตาลติดโบว์สีขาว สวมชุดสีขาวประดับทอง ถือลูกบอลหวยเลข 3 ไว้ในมือ ด้านขวาล่างมีใบสลากกินแบ่งและลูกบอลหวยเลข 9 5 7 บนสุดเป็นโลโก้มงกุฎทองกับคำว่า หวยคิง ถัดลงมาเป็นตัวอักษรไทยสีทองขนาดใหญ่ว่า อัตราการจ่าย และป้ายพื้นดำขอบทองข้อความ 3ตัว จ่าย1,000บาท"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), (max-width: 1007px) calc((100vw - 136px) / 2), 436px"
          class="mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#cd9a2c]/60 object-contain shadow-[0_10px_30px_rgba(12,11,10,0.85)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fdeb7c]/85 hover:shadow-[0_15px_40px_rgba(205,154,44,0.40)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#ab7314] bg-gradient-to-r from-[#fdeb7c] via-[#cd9a2c] to-[#ab7314] px-10 py-3.5 text-lg font-black text-[#120a02] shadow-[0_0_15px_rgba(205,154,44,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
