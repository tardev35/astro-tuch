---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";

import { Picture } from "astro:assets";

// ดรอปอาร์ตเวิร์กของ หวย365 คือ 2026-10-02 16:11 และมีโปสเตอร์ที่ใช้ได้แค่สองใบ
// (brand-spec §4) — เปิดไฟล์จริงดูแล้วทั้งคู่ และรอบนี้ป้ายบนภาพ "ตรงกับ" เลขไฟล์
// (รอบที่แล้วสลับข้างกัน จึงต้องเปิดดูทุกครั้ง ห้ามเดาจากชื่อไฟล์):
//   slide1.png — 600x400 ป้ายใต้หัวเรื่องอ่านว่า "2ตัวจ่าย100บาท"
//                หญิงสาวชุดไทยขาว-ทอง ชูลูกหวยขาวเลข 2 ในวงแหวนแดงข้างใบหน้า
//   slide2.png — 600x400 ป้ายอ่านว่า "3ตัว จ่าย1,000บาท"
//                หญิงสาวชุดเดียวกัน ชูลูกหวยขาวเลข 3 ในวงแหวนแดง
//   slide3.png / slide4.png — โปสเตอร์ของแบรนด์ก่อน (29 ก.ย. เก่ากว่าดรอปนี้)
//     ห้าม import กลับมาเด็ดขาด และห้ามลบไฟล์ทิ้งเพราะเป็นอินเวนทอรีของรอบถัดไป
// ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้วและ verify-build จะแดง
// (banner2/banner3 ใน src/assets ก็เก่ากว่าดรอปนี้ = อาร์ตเวิร์กแบรนด์ก่อน ห้าม import)
// ชื่อตัวแปรตั้งตามข้อความบนภาพ ไม่ใช่ตามเลขไฟล์ เพื่อไม่ให้รอบหน้าสลับผิดอีก
import promoTwoDigit from "../assets/slide1.png";
import promoThreeDigit from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";
//
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (brand-spec §9): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้น ๆ "หนึ่งย่อหน้า ประมาณสี่บรรทัด" คือ
// โควตาตัวหนังสือทั้งหมดของหน้านี้, กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อย
// และห้ามเพิ่มย่อหน้า เพราะตัวโปสเตอร์ระบุอัตราจ่ายไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว
// การพิมพ์ซ้ำด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ เป้าหมาย h1x1, h2x0, h3x0
// (รอบก่อนหน้านี้หน้านี้เคยบวมเป็นหลายหัวข้อหลายย่อหน้ามาแล้วหลายครั้ง)
//
// สไลด์รอบนี้เป็นแนวนอน 600x400 จึงวางเป็นกริดสองคอลัมน์คุมความกว้างรวมที่ max-w-4xl
// (896px) ทำให้ช่องละ ~436px ไม่ต้องอัปสเกลเกินขนาดไฟล์ต้นทาง widths หยุดที่ 600 ตาม
// ความกว้างจริงของไฟล์ และคุมภาพต่อใบไว้ที่ max-w-[600px] สองใบพอดีหนึ่งแถว กริดจึง
// จัดกลางสมมาตรโดยไม่ต้องมีใบที่ span สองคอลัมน์ · เรียง 2 ตัว ก่อน 3 ตัว ตามบรีฟ
//
// Announcement หมุนมาเป็น AnnouncementCyber ทั้งเว็บรอบนี้ (รอบก่อน หวยเฮง789 ใช้
// Announcement2) — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ หวย365
// แล้ว และ index ก็เรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop message มิฉะนั้นตัววิ่ง
// จะพูดคนละเรื่องกันระหว่างหน้าแรกกับหน้านี้
//
// พาเลตต์ หวย365 (brand-spec §2) แดงสดนำ ทองรอง: แดงแบรนด์ #dc0203 · แดงสว่าง
// #f5282a · แดงลึก #9c0201 · ทอง #ffc93c · ทองอ่อน #ffeab0 · ทองลึก #c08a07 ·
// การ์ด #240406 · แถบบาร์ #180303 · เนื้อความ #f6e7e0 (BRAND_TEXT) ·
// หมึกบนพื้นทอง #1a0303 · พื้นเพจ #000000
// เรืองแสง: ทอง rgba(255,201,60,α) · แดง rgba(220,2,3,α) · เงา rgba(8,1,1,α)
// การ์ดโปสเตอร์ได้ขอบทองลึก #c08a07 ทั้งสองใบ (ทองลึกใช้ได้กับขอบ/เส้นคั่นและเป็น
// ปลายไล่เฉดใต้หมึกเข้มได้ที่ 6.4:1 แต่ห้ามเป็นพื้นของตัวอักษรขาว) เพราะตัวเลข
// อัตราจ่ายบนภาพทั้งคู่เป็นตัวอักษรทอง · ปุ่ม CTA ไล่เฉดทอง #ffeab0 → #ffc93c →
// #c08a07 ใช้หมึกเข้ม #1a0303 · ห้ามวางหมึกเข้มบนแดงแบรนด์ และห้ามวางขาวบนทอง
// ชุดของ หวยเฮง789 (#dc2224 #f4bc5d #ffefc2 #fbe3d4 #2b0909 #1c0606 #e43434
// #a8690c #d99a10 #0b0202 rgba(244,188,93,*) rgba(220,34,36,*) rgba(11,2,2,*))
// ถูกแทนครบทุกจุดแล้ว ทั้งคลาส Tailwind raw hex และ rgba()
//
// หวย365 เป็นเว็บ "แทงหวยออนไลน์" ไม่ใช่สล็อต ไม่ใช่บอล และไม่ใช่คาสิโน — คำว่า
// สล็อต ฟรีสปิน RTP คาสิโน บาคาร่า บอล ค่าน้ำ อัตราต่อรอง ลีก รวมถึงแง่มุมของแบรนด์
// ก่อน (เลขเด็ด เลขดัง ไม่จำกัด แทงได้ไม่อั้น ฮานอยปกติ/พิเศษ/วีไอพี ฝากถอนวอลเลท)
// ห้ามปรากฏบนหน้านี้ ตัวเลขที่บรีฟระบุและใช้ได้มีแค่ 2 ตัว จ่าย 100 บาท ·
// 3 ตัว จ่าย 1,000 บาท · 3 ขั้นตอน · 24 ชั่วโมง ห้ามเพิ่มชื่อผู้ให้บริการ ชื่อธนาคาร
// ยอดฝากขั้นต่ำ เลขใบอนุญาต จำนวนสมาชิก หรือปีที่ก่อตั้ง และต้องคง hedge ของบรีฟไว้ว่า
// อัตราจ่ายและวงเงินต่างกันตามประเภทหวยและเงื่อนไขของแต่ละรอบ จึงให้ยึดรายละเอียด
// ล่าสุดในหน้าส่งโพยก่อนยืนยัน
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 158
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "รวมภาพอัตราจ่ายของ หวย365 แบบ 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท อัตราจ่ายขึ้นอยู่กับประเภทหวยและเงื่อนไขของแต่ละรอบ ควรตรวจสอบในหน้าส่งโพยก่อนยืนยัน";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่นอัตราจ่ายหวย หวย365",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoTwoDigit.src,
});
---

<MainLayout title="โปรโมชั่นอัตราจ่ายหวย หวย365 2 ตัว จ่าย 100 บาท 3 ตัว จ่าย 1,000 บาท" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่นอัตราจ่ายหวย หวย365" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#f6e7e0]">
        หน้านี้รวมภาพอัตราจ่ายที่ <strong class="text-[#ffeab0]">หวย365</strong> เปิดให้ดูก่อนเลือกรายการและส่งโพย โดยตัวเลขของแต่ละแบบระบุไว้บนภาพด้านล่างแล้ว
        <strong class="text-[#ffeab0]">อัตราจ่ายและวงเงินอาจแตกต่างกันตามประเภทหวยและเงื่อนไขของแต่ละรอบ</strong> จึงควรยึดรายละเอียดล่าสุดที่แสดงในหน้าส่งโพยของรอบนั้นก่อนยืนยันทุกครั้ง
      </p>

      <div class="mx-auto grid w-full max-w-4xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoTwoDigit}
          alt="โปสเตอร์อัตราจ่ายหวยของ หวย365 ฉากผ้าซาตินสีแดงเข้มและธงชาติไทยพาดอยู่ด้านหลัง ด้านซ้ายเป็นหญิงสาวผมยาวประดับดอกไม้ขาวและปิ่นทอง สวมชุดไทยสีขาวประดับทองพร้อมสร้อยและกำไลฝังพลอยแดง มือหนึ่งชูลูกหวยสีขาวหมายเลข 2 ในวงแหวนแดงขึ้นข้างใบหน้า อีกมือยื่นออกมาข้างหน้า รอบภาพมีลูกหวยแดงสลับขาวหมายเลข 6 9 8 และ 5 ด้านล่างเป็นกองเหรียญทองและสลากกินแบ่งเรียงซ้อนกัน มุมขวาบนเป็นโลโก้ หวย365 ตัวอักษรแดงคู่ดำ ถัดลงมาเป็นตัวอักษรไทยสีทองขนาดใหญ่ว่า อัตราจ่ายหวย และใต้ลงไปเป็นป้ายสีดำขอบทองคาดข้อความ 2ตัวจ่าย100บาท"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), (max-width: 1007px) calc((100vw - 136px) / 2), 436px"
          class="mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#c08a07]/70 object-contain shadow-[0_10px_30px_rgba(8,1,1,0.85)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ffc93c]/85 hover:shadow-[0_15px_40px_rgba(255,201,60,0.40)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoThreeDigit}
          alt="โปสเตอร์อัตราจ่ายหวยของ หวย365 ชุดเดียวกัน ฉากผ้าซาตินสีแดงเข้มและธงชาติไทยอยู่ด้านหลัง ด้านซ้ายเป็นหญิงสาวผมยาวสวมชุดไทยสีขาวประดับทอง เครื่องประดับฝังพลอยแดง มือหนึ่งชูลูกหวยสีขาวหมายเลข 3 ในวงแหวนแดงขึ้นข้างใบหน้า อีกมือยื่นออกมาข้างหน้า รอบภาพมีลูกหวยแดงสลับขาวหมายเลข 6 8 9 และ 5 ด้านล่างเป็นกองเหรียญทองและสลากกินแบ่งวางเรียงกัน มุมขวาบนเป็นโลโก้ หวย365 ตัวอักษรแดงคู่ดำ ถัดลงมาเป็นตัวอักษรไทยสีทองขนาดใหญ่ว่า อัตราจ่ายหวย และใต้ลงไปเป็นป้ายสีดำขอบทองคาดข้อความ 3ตัว จ่าย1,000บาท"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), (max-width: 1007px) calc((100vw - 136px) / 2), 436px"
          class="mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#c08a07]/70 object-contain shadow-[0_10px_30px_rgba(8,1,1,0.85)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ffc93c]/85 hover:shadow-[0_15px_40px_rgba(255,201,60,0.40)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก หวย365"
          class="flex items-center justify-center rounded-lg border border-[#c08a07] bg-gradient-to-r from-[#ffeab0] via-[#ffc93c] to-[#c08a07] px-10 py-3.5 text-lg font-black text-[#1a0303] shadow-[0_0_15px_rgba(255,201,60,0.40)] transition-transform hover:scale-105">
          สมัครสมาชิก หวย365
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
