---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";

import { Picture } from "astro:assets";

// Only slide1/slide2 belong to JAIDEE928 (drop 2026-08-13) and they are literally
// the two promotions this page shows: slide1 is the "คืนยอดเสีย รับโบนัส 0.3%"
// poster, slide2 is the "แนะนำเพื่อน รับโบนัส 0.8%" poster. slide3/slide4 are
// still on disk but belong to a previous client (PIGAUTO911, red/gold lottery
// art) — they may not be imported here, now or on any future rebrand.
import promoReferral from "../assets/slide2.png";
import promoCashback from "../assets/slide1.png";
import { pageGraph } from "../lib/schema";

// This is an IMAGE page: the ContentBox title, ONE short intro paragraph, the
// poster grid, one CTA. No section headings, no extra prose — the posters
// already state every offer in large type.
//
// 150–160 CHARACTERS (not bytes — a byte count reads ~3x too long for Thai).
const pageDescription =
  "รวมโปรโมชั่น JAIDEE928 ทั้งคืนยอดเสียรับโบนัสสูงสุด 0.3% และแนะนำเพื่อนรับโบนัสสูงสุด 0.8% ตรวจสอบเปอร์เซ็นต์ ยอดที่ใช้คำนวณ และเงื่อนไขการรับสิทธิ์ก่อนกดรับ";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น JAIDEE928 คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8%",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});
---

<MainLayout title="โปรโมชั่น JAIDEE928 คืนยอดเสียรับ 0.3% แนะนำเพื่อนรับ 0.8%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น JAIDEE928" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#e4d9f5]">
        หน้านี้รวมโปรโมชั่นที่ JAIDEE928 เปิดรับอยู่ในขณะนี้ ทั้งคืนยอดเสียรับโบนัสสูงสุด 0.3% และแนะนำเพื่อนรับโบนัสสูงสุด 0.8% อัตราโบนัส ยอดที่นำมาคำนวณ
        และรอบเวลาการรับสิทธิ์ระบุไว้บนภาพโปรโมชั่นแต่ละใบ และเงื่อนไขของแต่ละรายการไม่เหมือนกัน สมาชิกตรวจสอบยอดสะสมและกดรับสิทธิ์ได้จากบัญชีสมาชิก
        หรือสอบถามแอดมินที่ดูแลตลอด 24 ชั่วโมง
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่นพื้นหลังสีม่วงเข้ม ด้านบนเป็นโลโก้ JAIDEE928 ตัวอักษรโครเมียมเงินสลับม่วง ถัดลงมาเป็นข้อความ โปรโมชั่น คืนยอดเสีย รับโบนัส พร้อมตัวเลข 0.3% ขนาดใหญ่ หญิงสาวสวมชุดสีม่วงดำแบมือทางขวาของภาพ รอบตัวมีชิปคาสิโนสีม่วง ไพ่เอซ และวงล้อสล็อตขึ้นเลข 777 แถบด้านล่างเขียนว่า คืนยอดเสียทุกวัน รับโบนัสสูงสุด 0.3% และ ทำเทิร์นโอเวอร์น้อย ถอนได้ไว"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#4c1095]/55 object-contain shadow-[0_10px_30px_rgba(168,85,247,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#d8a7ff]/70 hover:shadow-[0_15px_40px_rgba(230,232,236,0.28)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่นพื้นหลังสีม่วงเข้ม ด้านบนเป็นโลโก้ JAIDEE928 ตัวอักษรโครเมียมเงินสลับม่วง ถัดลงมาเป็นข้อความ โปรโมชั่น แนะนำเพื่อน รับโบนัส พร้อมตัวเลข 0.8% ขนาดใหญ่ หญิงสาวสวมชุดสีม่วงยกมือทางขวาของภาพ ข้างกันเป็นตู้สล็อตขึ้นคำว่า JACKPOT มุมซ้ายมีไพ่เอซและชิปคาสิโนสลักเลข 928 แถบด้านล่างเขียนว่า แนะนำเพื่อนได้เงิน รับโบนัสสูงสุด 0.8% ถอนได้จริงไม่อั้น และ ปลอดภัย มั่นใจ 100%"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#4c1095]/55 object-contain shadow-[0_10px_30px_rgba(168,85,247,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#d8a7ff]/70 hover:shadow-[0_15px_40px_rgba(230,232,236,0.28)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#d8a7ff]/70 bg-gradient-to-r from-[#d8a7ff] via-[#a855f7] to-[#4c1095] px-10 py-3.5 text-lg font-black text-[#060210] shadow-[0_0_15px_rgba(168,85,247,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก JAIDEE928
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
