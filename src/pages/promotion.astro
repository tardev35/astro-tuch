---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

// ดรอปนี้ (2026-10-28, brand-spec §6) มีสไลด์ที่เป็นของแบรนด์นี้ **สองใบ**
// และชื่อตัวแปรตั้งตามข้อความที่พิมพ์อยู่บนภาพจริง (เปิดบิตแมปอ่านเองแล้วรอบนี้)
// ไม่ใช่ตามเลขไฟล์ — ถ้ารอบหน้าเจอความขัดแย้ง **ให้เชื่อข้อความบนรูป**:
//   slide1.png (mtime 2026-10-28, ดรอปนี้) — โปสเตอร์ "โปรโมชั่น / แนะนำเพื่อน / 0.8%"
//   slide2.png (mtime 2026-10-28, ดรอปนี้) — โปสเตอร์ "โปรโมชั่น / คืนยอดเสีย / 0.3%"
// 🚨 **รอบก่อนจับคู่กลับด้านกับรอบนี้** (รอบก่อน slide1 = คืนยอดเสีย) — uploader
// เขียนทับไฟล์เดิมทุกครั้ง **เลขไฟล์จึงไม่มีความหมายข้ามแบรนด์** ต้องเปิดบิตแมป
// ดูทุกรอบ ห้ามสืบทอดการจับคู่ของรอบก่อน และห้ามเชื่อคอมเมนต์เก่า
//   สไลด์ใบที่สามและสี่ (mtime 2026-09-29 = คนละดรอป คนละแบรนด์) — **ห้าม import**
//   แบนเนอร์ใบที่สองและสาม (mtime 2026-10-23 = อาร์ตเวิร์กของอีกแบรนด์) —
//     **ห้าม import** รอบนี้ไม่มี "รูปประกอบบทความ" เลย
//   (ชื่อไฟล์เต็มของทั้งสี่อยู่ใน brand-spec §6 — ไม่พิมพ์ที่นี่ เพื่อให้ grep หา
//    การ import ที่หลงเหลือได้คำตอบว่างจริงๆ)
// ⚠️ eager import = emit ลง dist/ ต่อให้ไม่ได้ render และ verify-build จะแดง
// การ import ไฟล์เก่าคือการส่งรูปของลูกค้ารายอื่นขึ้นเว็บนี้
// **ห้ามลบไฟล์เก่าทิ้ง** — เป็นอินเวนทอรีของรอบถัดไป แค่ห้าม import
// (banner1 / banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักชื่อไว้เอง —
// ห้ามอ้างจากหน้านี้) รอบนี้หน้านี้จึงมีเฉพาะสไลด์สองใบ กริดจึงเป็นสองช่อง
import promoCashback from "../assets/slide2.png";
import promoReferral from "../assets/slide1.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้นๆ ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมด
// ของหน้านี้, กริดภาพโปรโมชั่น, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อยและห้ามเพิ่มย่อหน้า
// เพราะโปสเตอร์ระบุชื่อรายการและเปอร์เซ็นต์ของตัวเองด้วยตัวอักษรขนาดใหญ่อยู่แล้ว
// การพิมพ์ซ้ำด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่
// บรีฟรอบนี้ (src/assets/content.txt, 29 บรรทัด) **ไม่มีส่วน SUB-PAGES เลย**
// ทุกย่อหน้าที่เคยอยู่บนหน้านี้คือของที่รีแบรนด์รอบก่อนๆ แต่งขึ้นเอง
//
// 0.3% / 0.8% เป็นเนื้อหาของบรีฟจริง (content.txt บรรทัด 7-12) จึงอ้างได้ตามปกติ
// แต่ **หน้านี้ยังเป็นหน้าภาพ** โควตาตัวหนังสือจึงเป็นย่อหน้าเกริ่นเดียวเท่านั้น
// และ intro ต้องคงประโยคกำกับของบรีฟ (เงื่อนไขต่างกัน ควรตรวจประกาศล่าสุด) ไว้
//
// ลำดับในกริด: คืนยอดเสีย 0.3% ก่อน แนะนำเพื่อน 0.8% — ตามลำดับของบรีฟ
// (content.txt บรรทัด 9 แล้วบรรทัด 11) **ไม่ใช่ตามเลขไฟล์** เพราะเลขไฟล์สลับกับ
// เนื้อหาในดรอปนี้ และหน้าแรกก็เรียงตามบรีฟเหมือนกัน
// ⚠️⚠️ **บิตแมปจริงของดรอปนี้คือ 375x600 แนวตั้ง** (วัดจาก IHDR ของไฟล์เองรอบนี้)
// ความกว้างสูงสุดคือ 375 widths จึงหยุดที่ 375 และคุมที่ max-w ที่ 375px
// **ให้วัดใหม่ทุกรอบจากไฟล์จริง อย่าเชื่อสัดส่วนของรอบก่อน และห้ามขยายเกินต้นฉบับ**
// sizes คิดจากความกว้างที่ถูกวาดจริง: section px-4 (16px/ข้าง) + การ์ด p-8
// (32px/ข้าง, เป็น p-10 = 40px ที่ md ขึ้นไป) + gap-6 ระหว่างคอลัมน์ (24px)
//   ใต้ 640px = คอลัมน์เดียว → 100vw-96px
//   640-767px = สองคอลัมน์ p-8 → 50vw-60px
//   768-885px = สองคอลัมน์ p-10 → 50vw-68px
//   ตั้งแต่ 886px ขึ้นไปชนเพดาน 375px
// LCP คือ hero ใน MainLayout ไม่ใช่รูปพวกนี้ จึง loading="lazy" fetchpriority="low"
// decoding="async" และ quality ตัวเดียวทั้ง avif/webp — ห้ามจูนแยกฟอร์แมต
// (tools/avif-quality-service.mjs ย่อฝั่ง avif ให้เองที่ x0.65)
//
// quality={64} ไม่ใช่ 80 ตามปกติ: สไลด์ทั้งสองเป็นภาพถ่ายคนในฉากอิ่มสี บวก
// ตัวอักษรไทยสามมิติผิวมันเงาตัดขอบคมที่มีไฮไลต์ทับอยู่ด้านบน ซึ่งเป็นเคสที่
// AVIF ทำได้แย่ที่สุด ที่ quality=80 ไฟล์ AVIF มีโอกาสออกมา **ใหญ่กว่า** WebP ที่เป็น
// fallback ของตัวเอง เบราว์เซอร์ที่รองรับ AVIF จะหยิบไฟล์ที่หนักกว่าไปใช้ และ
// verify-build.mjs ทำให้ build แดงด้วยเหตุนี้ตรงๆ · ทางแก้คือ quality ที่ **ต่ำลง**
// ไม่ใช่สูงขึ้น · ค่าเดียวกันนี้ต้องใช้ที่ index.astro กับสไลด์ใบเดียวกัน
//
// Announcement รอบนี้หมุนมาเป็นตัวท้ายชื่อเลขห้า ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ตัวท้ายชื่อเลขสามจึงหมุนออก · เขียนชื่อไฟล์แบบไม่มีเครื่องหมายคำพูดโดยตั้งใจ
// เพราะ tools/gen-tw-sources.mjs นับ literal ที่มีเครื่องหมายคำพูดว่าเป็นการ import
// จริง คอมเมนต์จึงทำให้ variant เก่าหลุดเข้า Tailwind scan แล้วสีของแบรนด์ก่อนขึ้น
// stylesheet) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้
// ไว้แล้ว และทุกหน้าเรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop message
//
// ───────────────────────────────────────────────────────────────────────────
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) **กลับทิศ 180° จากรอบก่อน: รอบนี้เนื้อหาสว่าง
// + โครมเข้มแดงเลือดหมู** (รอบก่อนมืดทั้งเว็บ)
// bg.json ของดรอปนี้คือ {"mode":"color","color":"#f7e4e9"} = **ชมพูบลัชจาง**
// (รอบก่อนเป็นเขียวป่าจมเกือบดำ ซึ่งอยู่คนละปลายของสเกล — อ่านจากไฟล์ทุกรอบ ห้ามเดา)
// **ห้าม "แก้" การ์ดกลับไปเป็นผิวเข้ม** — การ์ดเข้มบนหมึก #36080f = ตัวอักษรหายไปเลย
// ลำดับผิว: พื้นเพจ #f7e4e9 / การ์ด ContentBox #fdf5f6 / ชั้นยก #f7dfe4 /
// เส้นบาง #eec3cc · ขอบตกแต่ง/ออรา #d98fa0 (**สองค่าหลังห้ามถือตัวอักษร**)
// หมึก #36080f = เนื้อความ (= BRAND_TEXT ที่ <html> และการ์ด ContentBox ตั้งให้แล้ว
// 16.3:1 บนการ์ด) · หมึกรอง #6b2b33 (9.7:1)
// แดงชาด #a30d1a = สีของ <strong> ในเนื้อความ (7.4:1 บนการ์ด) และสีหัวข้อ
// ทองเข้ม #7a4a0c (7.0:1) ถือตัวอักษรบนการ์ดได้เช่นกัน
// 🚨🚨 **#eec3cc (1.5:1) #d98fa0 (2.3:1) #ef4a5e ห้ามเป็นสีตัวอักษรทุกบริบท**
// ปุ่ม CTA ของหน้านี้เป็น **PRIMARY = ไล่เฉดแดง** #8a1420 → #a30d1a → #c21325
// บนหมึก **ขาว #ffffff** (9.5 / 8.0 / 6.2:1 ต่อ stop — ผ่าน AA ทุก stop)
// ⚠️⚠️ **ห้ามลากปลายเฉดสว่างกว่า #c21325** (เกินกว่านั้นขาวตกต่ำกว่า 4.5:1)
// แผ่นไฮไลต์ด้านบนปุ่มจำกัดที่ white/10
// rgba() ที่อนุญาตรอบนี้: rgba(163,13,26,α) · rgba(220,165,58,α) ·
// rgba(217,143,160,α) · rgba(54,8,15,α)
// ⚠️⚠️ **รอบนี้ไม่มีเขียว/ม่วง/ฟ้า/ไซแอน/แมเจนต้าเป็นสี UI เลยสักเฉด** (ยกเว้น
// เขียว LINE ซึ่งเป็นสีเชิงความหมาย และไม่มีอยู่ในหน้านี้)
// ⚠️⚠️ กับดักที่แหลมที่สุดรอบนี้คือ **แดงของแบรนด์อื่น** ซึ่งเป็นตระกูลเดียวกับ
// รอบนี้เป๊ะ — spec ของสามรอบก่อนเขียนไว้ทุกไฟล์ว่า "รอบนี้ไม่มีแดงเป็นสี UI"
// **คอมเมนต์พวกนั้นเป็นของรอบก่อน ไม่ใช่ของรอบนี้** ที่ห้ามคือ **ค่าเฮกซ์ของ
// แบรนด์เก่าแบบตรงหกหลัก** ไม่ใช่ "สีแดง" ในฐานะตระกูลสี ให้เทียบเป็น "ค่า"
// ทีละหลักกับตารางใน brand-spec §2 ห้ามตัดสินด้วยสายตา
// (ค่าของแบรนด์เก่าที่ใกล้ที่สุดและต้องสงสัยก่อนเสมอ เขียนแบบไม่มี # โดยตั้งใจ:
//  a81410 c1071b b00718 ↔ a30d1a · 7e1221 8a0412 ↔ 8a1420 · c20305 c9102f ↔ c21325
//  3d0d16 25090f 24060c ↔ 36080f · ffe4e6 ffd4d7 f5b9bd f0bcbc ↔ f7e4e9/f7dfe4)
// · มงกุฎทอง ชิปคาสิโนแดง-ขาว ผนังหินอ่อนงาช้าง และสีผิวนักแสดงในอาร์ตเวิร์กเป็น
// **วัตถุในภาพ ไม่ใช่สี UI** · และ **เวิร์ดมาร์กแดงชาด-โครเมียมเงินก็เป็นอาร์ตเวิร์ก
// ไม่ใช่สี UI** · พื้นเพจมาจาก bg.json เท่านั้น
// · <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ
// ถ้าเปิด/ปิดกลางคำ บรรทัดจะตัดกลางคำ
//
// ⚠️ แกนของแบรนด์รอบนี้คือ **เว็บเกมคาสิโน/เดิมพันออนไลน์** (บาคาร่า สล็อต ไฮโล
// รูเล็ต ยิงปลา บอล หวย) คำนิยามตัวเองของแบรนด์ก่อนๆ ห้ามเหลือ โดยเฉพาะศัพท์หมวด
// ธุรกิจทั้งชุดของแบรนด์ขาออก (brand-spec §5 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep
// เจอ false positive)
// 🚨 **บรีฟรอบนี้ไม่พูดถึงธนาคาร วอลเลท หรือการฝากถอนเลยแม้แต่คำเดียว**
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 3 ขั้นตอน · 24ชม.
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -c บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงนี้ยาว 157 ด้วยชื่อแบรนด์ 6 อักขระของรอบนี้
// (**ต้องนับใหม่ทุกรอบ** ห้ามสืบทอดความยาว — รอบก่อนชื่อยาว 7)
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `รวมภาพโปรโมชั่น ${BRAND_NAME} ทั้งแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% อัปเดตใหม่ตลอดสัปดาห์ แต่ละรายการมีเงื่อนไขต่างกัน ควรตรวจสอบประกาศล่าสุดก่อนรับสิทธิ์ทุกครั้ง`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่น ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});

// ความกว้างที่ถูกวาดจริงของแต่ละคอลัมน์ในกริดสองคอลัมน์ (ดูคอมเมนต์ sizes ด้านบน)
const promoSizes = "(max-width: 639px) calc(100vw - 96px), (max-width: 767px) calc(50vw - 60px), (max-width: 885px) calc(50vw - 68px), 375px";

const promoClass =
  "mx-auto h-auto w-full max-w-[375px] rounded-xl border border-[#eec3cc] object-contain shadow-[0_8px_28px_rgba(54,8,15,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#d98fa0] hover:shadow-[0_12px_40px_rgba(163,13,26,0.22)]";

// alt ทั้งสองเขียนจากบิตแมปของดรอปนี้ที่เปิดอ่านเองแล้ว (**375x600 แนวตั้ง** ทั้งคู่) —
// ฉากโถงวังหินอ่อนสีงาช้างที่มีเสาและซุ้มโค้ง หญิงสาวผมยาวสีน้ำตาลเป็นลอน สวมมงกุฎ
// ทองประดับอัญมณีแดง ชุดราตรีแดง-ขาวปักทองแต่งลูกไม้ขาว และผ้าคลุมกำมะหยี่แดง ·
// โลโก้เวิร์ดมาร์กสามมิติอยู่มุมบนขวาทั้งสองใบ · ตัวอักษรไทยสามมิติผิวแดงเคลือบเงา
// ตัดขอบทองว่า โปรโมชั่น พร้อมมงกุฎทองดวงเล็กอยู่เหนือตัวอักษร · ชื่อรายการตัวขาว
// บนแถบดำขอบทอง · ตัวเลขเปอร์เซ็นต์ตัวโตแดงเคลือบเงาตัดขอบทอง · แคปซูลสีดำขอบทอง
// ท้ายภาพเขียนว่า สมัครสมาชิก พร้อมไอคอนรูปคนกับเครื่องหมายบวก และลูกศรคู่
// ⚠️ alt คือ "ข้อความที่พิมพ์อยู่บนโปสเตอร์" เป็นหลัก — ตัวเลขท้าย alt ต้องตรงกับรูป
// ⚠️ ห้ามเรียกรูปคู่นี้ว่าภาพแนวนอนหรือภาพสี่เหลี่ยมจัตุรัส รอบนี้เป็น **แนวตั้ง**
// ⚠️ จุดที่ **ต่างกันจริงระหว่างสองใบ** และต้องเขียนให้ตรง (ตรวจจากบิตแมปรอบนี้):
//   slide2 (คืนยอดเสีย 0.3%) นางแบบ **นั่ง** สวมถุงน่องขาว · มุมล่างขวามี
//     **กองชิปคาสิโนแดง-ขาวและมงกุฎทองดวงเล็ก**
//   slide1 (แนะนำเพื่อน 0.8%) นางแบบ **ยืน** ยกแขนขึ้นแตะผม มีผ้าคลุมกำมะหยี่แดง
//     ทิ้งตัวลงด้านหลัง · **ไม่มีชิปคาสิโนในภาพ**
//   **มงกุฎทองดวงเล็กเหนือคำว่า โปรโมชั่น มีทั้งสองใบรอบนี้** — กลับด้านจากรอบก่อน
//     ที่มีใบเดียว ห้ามลอกของรอบก่อน
// ⚠️ ห้ามระบุว่าใช้มือซ้ายหรือมือขวา — รอบก่อนๆ เขียนไว้แล้วผิดหลายรอบติด
// ⚠️ สีของวัตถุในรูป (ชุดแดง-ขาว ชิปแดง-ขาว มงกุฎทอง) เป็นวัตถุในภาพ ไม่ใช่สีของแบรนด์
// ⚠️ องค์ประกอบของอาร์ตเวิร์กแบรนด์ก่อนๆ ที่ต้องไม่หลงเหลือใน alt อยู่ครบใน
// brand-spec §6 (ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive)
const altCashback = `โปสเตอร์โปรโมชั่นแนวตั้ง มุมบนขวาเป็นโลโก้ ${BRAND_NAME} แบบเวิร์ดมาร์กสามมิติ ครึ่งแรกเป็นตัวเลขผิวแดงชาดเคลือบเงาตัดขอบทอง ครึ่งหลังเป็นตัวอักษรละตินผิวโครเมียมเงินขัดเงา เหนือขึ้นไปเป็นมงกุฎเงินประดับกำมะหยี่แดงและอัญมณีแดง ฝั่งซ้ายเป็นหญิงสาวผมยาวสีน้ำตาลเป็นลอน สวมมงกุฎทองประดับอัญมณีแดงและชุดราตรีแดง-ขาวปักทองแต่งลูกไม้ขาว นั่งอยู่ในโถงวังหินอ่อนสีงาช้างที่มีเสาและซุ้มโค้ง ครึ่งขวาเป็นตัวอักษรไทยสามมิติผิวแดงเคลือบเงาตัดขอบทองอ่านว่า โปรโมชั่น มีมงกุฎทองดวงเล็กอยู่เหนือตัวอักษร ใต้ลงมาเป็นคำว่า คืนยอดเสีย ตัวขาวบนแถบสีดำขอบทอง แล้วตัวเลข 0.3% ตัวโตสีแดงเคลือบเงาตัดขอบทอง มุมล่างขวาเป็นกองชิปคาสิโนสีแดงสลับขาว ปิดท้ายด้วยแคปซูลสีดำขอบทองเขียนว่า สมัครสมาชิก พร้อมไอคอนรูปคนกับเครื่องหมายบวกและลูกศรคู่`;

const altReferral = `โปสเตอร์โปรโมชั่นแนวตั้ง มุมบนขวาเป็นโลโก้ ${BRAND_NAME} แบบเวิร์ดมาร์กสามมิติ ครึ่งแรกเป็นตัวเลขผิวแดงชาดเคลือบเงาตัดขอบทอง ครึ่งหลังเป็นตัวอักษรละตินผิวโครเมียมเงินขัดเงา เหนือขึ้นไปเป็นมงกุฎเงินประดับกำมะหยี่แดงและอัญมณีแดง ฝั่งซ้ายเป็นหญิงสาวผมยาวสีน้ำตาลเป็นลอน สวมมงกุฎทองประดับอัญมณีแดงและชุดราตรีแดง-ขาวปักทองแต่งลูกไม้ขาว ยืนยกแขนขึ้นแตะผมโดยมีผ้าคลุมกำมะหยี่แดงทิ้งตัวอยู่ด้านหลัง ฉากเป็นโถงวังหินอ่อนสีงาช้างที่มีเสาและซุ้มโค้ง ครึ่งขวาเป็นตัวอักษรไทยสามมิติผิวแดงเคลือบเงาตัดขอบทองอ่านว่า โปรโมชั่น มีมงกุฎทองดวงเล็กอยู่เหนือตัวอักษร ใต้ลงมาเป็นคำว่า แนะนำเพื่อน ตัวขาวบนแถบสีดำขอบทอง แล้วตัวเลข 0.8% ตัวโตสีแดงเคลือบเงาตัดขอบทอง ปิดท้ายด้วยแคปซูลสีดำขอบทองเขียนว่า สมัครสมาชิก พร้อมไอคอนรูปคนกับเครื่องหมายบวกและลูกศรคู่`;
---

<MainLayout title={`รวมภาพโปรโมชั่น ${BRAND_NAME} อัปเดตใหม่ตลอดสัปดาห์`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`รวมภาพโปรโมชั่น ${BRAND_NAME}`} as="h1">
    <div class="flex flex-col gap-10">
      <p>
        หน้านี้รวมภาพรายการโปรโมชั่นของ {BRAND_NAME} ที่อัปเดตใหม่ตลอดสัปดาห์ไว้ในที่เดียว โดยชื่อรายการและเปอร์เซ็นต์ของแต่ละรายการพิมพ์อยู่บนภาพแล้ว ทั้งนี้
        <strong class="text-[#a30d1a]">โปรโมชั่นแต่ละรายการอาจกำหนดประเภทเกม ยอดที่นำมาคำนวณ และข้อจำกัดการถอนเงินแตกต่างกัน จึงควรตรวจสอบประกาศล่าสุดจากเว็บไซต์ทางการก่อนเข้าร่วมทุกครั้ง</strong>
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt={altCashback}
          loading="lazy"
          fetchpriority="low"
          widths={[250, 375]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />

        <Picture
          src={promoReferral}
          alt={altReferral}
          loading="lazy"
          fetchpriority="low"
          widths={[250, 375]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="relative isolate flex items-center justify-center overflow-hidden rounded-lg border border-[#8a1420] bg-gradient-to-b from-[#8a1420] via-[#a30d1a] to-[#c21325] px-10 py-3.5 text-lg font-black text-white shadow-[0_8px_22px_rgba(163,13,26,0.35)] transition-transform hover:scale-105">
          <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-white/10 to-transparent"></span>
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
