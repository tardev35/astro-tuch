---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

// ดรอปรอบนี้ (2026-10-19, brand-spec §5) มีสไลด์ที่ใช้ได้ **สองใบ** และชื่อตัวแปร
// ตั้งตามข้อความที่พิมพ์อยู่บนภาพจริง (เปิดบิตแมปอ่านเองแล้วรอบนี้) ไม่ใช่ตามเลขไฟล์ —
// ถ้ารอบหน้าเจอความขัดแย้ง **ให้เชื่อข้อความบนรูป**:
//   slide2.png — โปสเตอร์ "โปรโมชั่น / คืนยอดเสีย / 0.3%"
//   slide1.png — โปสเตอร์ "โปรโมชั่น / แนะนำเพื่อน / 0.8%"
//   slide3.png / slide4.png (mtime 2026-09-29) — อาร์ตเวิร์กของแบรนด์ก่อน **ห้าม import**
// ⚠️ eager import = emit ลง dist/ ต่อให้ไม่ได้ render และ verify-build จะแดง
// การ import ไฟล์เก่าคือการส่งรูปของลูกค้ารายอื่นขึ้นเว็บนี้
// **ห้ามลบไฟล์เก่าทิ้ง** — เป็นอินเวนทอรีของรอบถัดไป แค่ห้าม import
// (banner2 / banner3 ก็เช่นกัน ส่วน banner1 / banner1-mobile / og.png เป็นของ glob
// ที่ MainLayout ปักชื่อไว้เอง — ห้ามอ้างจากหน้านี้) รอบนี้จึงไม่มี article illustration
import promoCashback from "../assets/slide2.png";
import promoReferral from "../assets/slide1.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้นๆ ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมด
// ของหน้านี้, กริดภาพโปรโมชั่น, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อยและห้ามเพิ่มย่อหน้า
// เพราะโปสเตอร์ระบุเปอร์เซ็นต์ของตัวเองด้วยตัวอักษรขนาดใหญ่อยู่แล้ว การพิมพ์ซ้ำ
// ด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ บรีฟรอบนี้ (src/assets/content.txt)
// ไม่มีส่วน SUB-PAGES เลย ย่อหน้าทุกย่อหน้าที่เคยอยู่บนหน้านี้จึงเป็นของที่รีแบรนด์
// รอบก่อนๆ แต่งขึ้นเอง — รอบนี้คงไว้เพียงย่อหน้าเกริ่นเดียว และเขียนขึ้นใหม่จากบรีฟ
// (content.txt บรรทัด 8-12) ไม่ใช่ find-and-replace ทับประโยคของรอบก่อน
//
// ลำดับในกริดตามลำดับของบรีฟ: คืนยอดเสีย 0.3% (บรรทัด 9-10) มาก่อน แนะนำเพื่อน 0.8%
// (บรรทัด 11-12) · บิตแมปจริง 600x600 ทั้งคู่ → widths หยุดที่ 600 และคุมที่ max-w-[600px]
// sizes คิดจากความกว้างที่ถูกวาดจริง: section px-4 (16px/ข้าง) + การ์ด p-8
// (32px/ข้าง, เป็น p-10 = 40px ที่ md ขึ้นไป) + gap-6 ระหว่างคอลัมน์ (24px)
//   ใต้ 640px = คอลัมน์เดียว → 100vw-96px
//   640-767px = สองคอลัมน์ p-8 → 50vw-60px
//   768-1335px = สองคอลัมน์ p-10 → 50vw-68px
//   ตั้งแต่ 1336px ขึ้นไปชนเพดาน 600px
// LCP คือ hero ใน MainLayout ไม่ใช่รูปพวกนี้ จึง loading="lazy" fetchpriority="low"
// decoding="async" และ quality ตัวเดียวทั้ง avif/webp — ห้ามจูนแยกฟอร์แมต
// (tools/avif-quality-service.mjs ย่อฝั่ง avif ให้เองที่ x0.65)
//
// quality={64} ไม่ใช่ 80 ตามปกติ และเป็นค่าที่ "วัดมา" ไม่ใช่ค่าที่ชอบ: สไลด์ทั้งสองเป็น
// อาร์ตที่มีเกรนละเอียดเยอะ (กองเหรียญ ริบบิ้นซาติน ประกายดาว ลายลูกไม้) ซึ่งเป็นเคสที่
// AVIF ทำได้แย่ที่สุด ที่ quality=80 ไฟล์ AVIF ออกมา **ใหญ่กว่า** WebP ที่เป็น fallback
// ของตัวเองทุกความกว้างของทั้งสองรูป เบราว์เซอร์ที่รองรับ AVIF จะหยิบไฟล์ที่หนักกว่าไปใช้
// และ verify-build.mjs ทำให้ build แดงด้วยเหตุนี้ตรงๆ · ทางแก้คือ quality ที่
// **ต่ำลง** ไม่ใช่สูงขึ้น ค่าเดียวกันนี้ใช้ที่ index.astro กับสไลด์คู่เดียวกัน
//
// Announcement รอบนี้หมุนมาเป็น Announcement5 ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ Announcement2 จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็น
// คอปปี้ของแบรนด์นี้ไว้แล้ว และทุกหน้าเรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop message
// มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกันระหว่างหน้า
//
// พาเลตต์รอบนี้ (brand-spec §2) = **ฟ้าไซยานนำ · เหลืองมะนาวรอง · บนพื้นดำสนิท**
// bg.json ของดรอปนี้คือ {"mode":"color","color":"#000000"}
// ลำดับผิว: #0c2a3d ยก (การ์ด ContentBox) / #071a28 กลาง / #030e16 จม / #000000 พื้นเพจ
// ฟ้าแบรนด์ #32bcfb ถือขอบรูปและออรา · ฟ้าน้ำแข็ง #a9e9ff เป็นต้นสว่างของพื้นถมปุ่ม ·
// **เหลืองมะนาว #fef54b เป็นฮิวที่สอง** ใช้กับขอบรูปตอน hover และเป็นสีเดียวที่
// <strong> ในเนื้อความใช้ได้ (สงวนไว้งานเดียวนี้) · น้ำเงินลึก #07335f เป็นขอบปุ่มถมฟ้า ·
// หมึกบนพื้นถมฟ้าเป็น #041019 (8.9:1 บน #32bcfb · 13.2:1 บน #a9e9ff) ·
// เนื้อความ #dceefc มาจาก BRAND_TEXT ที่ <html> และการ์ด ContentBox ตั้งให้แล้ว
// ย่อหน้าจึงไม่ประกาศสีของตัวเอง และไม่ใส่ mx-auto / max-w-* กับย่อหน้า
// · <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ
// ถ้าเปิด/ปิดกลางคำ บรรทัดจะตัดกลางคำ และ <strong> สองตัวห้ามติดกัน
// ⚠️ #07335f และ #6b5c10 ห้ามถือตัวอักษรทุกขนาด ใช้ได้เฉพาะเส้น ขอบ ออรา
// และพื้นถม · ออราในไฟล์นี้ใช้ rgba(50,188,251,α) และ rgba(254,245,75,α) เท่านั้น
// ⚠️ กับดักรอบนี้คือ **ฟ้า** และ **เหลือง/ทอง** เพราะรอบที่แล้ว (สบายเบท168) ก็เป็น
// ฟ้านำ+ทองรองเหมือนกัน การเจอ "ฟ้า" หรือ "ทอง" ในไฟล์นี้จึงไม่พิสูจน์อะไรเลย
// ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน brand-spec §2 (ค่าของแบรนด์เก่าไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive) และรอบนี้ **ไม่มีชมพู ไม่มีแดง
// ไม่มีม่วง ไม่มีเขียว ไม่มีส้ม ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์**
//
// ⚠️ แบรนด์นี้เป็น **เว็บสล็อตล้วน** ที่บรีฟพูดถึงแค่สองโปรโมชั่น (แนะนำเพื่อน 0.8%
// และคืนยอดเสีย 0.3%) ระบบฝากถอนผ่านธนาคารและวอลเลท และช่องทาง LINE Official
// สองหน้าของหมวดลอตเตอรีจอดอยู่ใน src/pages-disabled/ ไม่มี route — ลิงก์ค้างจะเป็น
// href ตายที่ทำให้บิลด์แดง คำขายของของแบรนด์ก่อนและศัพท์หมวดอื่นที่บรีฟไม่ได้เอ่ย
// ห้ามหลงเหลือ (รายการเต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep
// เจอ false positive)
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกมแม้แต่ค่ายเดียว** จึงห้ามเขียนชื่อค่ายใดๆ
// ให้ใช้คำกลางว่า "ค่ายเกม" ตามบรีฟ
// ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% / 0.8% / 24ชม. — ห้ามแต่งยอดฝากขั้นต่ำ
// ชื่อธนาคาร ค่า RTP เลขใบอนุญาต จำนวนสมาชิก หรือปีก่อตั้ง และต้องคงประโยคกำกับ
// ของบรีฟไว้ว่า **ผู้ใช้งานควรอ่านรายละเอียดก่อนเข้าร่วม และสอบถามเจ้าหน้าที่
// หากมีข้อสงสัย**
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) หน้านี้ยาว 153 อักขระ
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `หน้ารวมภาพโปรโมชั่นของ ${BRAND_NAME} ทั้งคืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อน รับโบนัส 0.8% แต่ละรายการมีเงื่อนไขต่างกัน ควรอ่านรายละเอียดก่อนเข้าร่วม`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่น ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});

// ความกว้างที่ถูกวาดจริงของแต่ละคอลัมน์ในกริดสองคอลัมน์ (ดูคอมเมนต์ sizes ด้านบน)
const promoSizes = "(max-width: 639px) calc(100vw - 96px), (max-width: 767px) calc(50vw - 60px), (max-width: 1335px) calc(50vw - 68px), 600px";

const promoClass =
  "mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#32bcfb]/50 object-contain shadow-[0_0_28px_rgba(50,188,251,0.3)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fef54b]/85 hover:shadow-[0_0_40px_rgba(254,245,75,0.45)]";
---

<MainLayout title={`โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน โบนัส 0.8%`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`รวมโปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} as="h1">
    <div class="flex flex-col gap-10">
      <p>
        หน้านี้รวมภาพประกาศโปรโมชั่นของ <strong class="text-[#fef54b]">{BRAND_NAME}</strong> ไว้ในที่เดียว ทั้งรายการคืนยอดเสีย 0.3% เข้ายูสทุกวัน และโบนัสแนะนำเพื่อน 0.8% โดยอัตราและรูปแบบการรับสิทธิ์ระบุไว้บนภาพด้านล่างแล้ว แต่ละรายการอาจมีเงื่อนไขเกี่ยวกับประเภทเกม ยอดที่นำมาคำนวณ รอบรับเครดิต และข้อกำหนดการใช้งานแตกต่างกัน
        <strong class="text-[#fef54b]">ผู้ใช้งานควรอ่านรายละเอียดก่อนเข้าร่วม และสอบถามเจ้าหน้าที่หากมีข้อสงสัย</strong> เพื่อให้เข้าใจสิทธิ์ที่ได้รับตามเงื่อนไขจริง
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt={`โปสเตอร์โปรโมชั่นพื้นขาว-ฟ้าน้ำแข็ง มุมบนซ้ายเป็นโลโก้ ${BRAND_NAME} นินจาการ์ตูนชุดดำผูกผ้าคาดหัวฟ้ามีดาว คู่กับตัวอักษรไทยสามมิติสีเหลืองทองและเลข 168 สีฟ้าบับเบิล ถัดลงมาเป็นนินจาตัวเดียวกันตัวโต สวมหน้ากากดำ ผ้าพันคอฟ้าปลิว ขยิบตาและถือดาวกระจายสีฟ้า ข้างกันเป็นมือถือจอฟ้าที่ขึ้นไอคอนคนพร้อมเครื่องหมายบวก กลางภาพเป็นคำว่า โปรโมชั่น ตัวอักษรเหลืองทองสามมิติตัดขอบฟ้า มีมงกุฎทองวางอยู่ด้านบน ต่อด้วยป้ายคำว่า คืนยอดเสีย สีฟ้าบับเบิล แล้วเป็นตัวเลข 0.3% สีเหลืองทองตัวโต ด้านขวาเป็นหญิงสาวผมบลอนด์เงินผูกโบว์ฟ้า ขยิบตาและชี้นิ้วมาทางผู้ชม สวมชุดลูกไม้ขาว-ฟ้า มุมล่างซ้ายเป็นกองเหรียญทองสูงคู่กับกล่องของขวัญขาวผูกโบว์ฟ้า และมีหัวใจสีฟ้ากับดาวเหลืองลอยอยู่ทั่วภาพ`}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />

        <Picture
          src={promoReferral}
