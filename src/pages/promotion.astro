---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";

import { Picture } from "astro:assets";

// ⚠️ ดรอปนี้ (mtime 2026-10-07 21:16) มีสไลด์ที่ "ใช้ได้" แค่สองใบ ยืนยันด้วยการเปิด
// ภาพอ่านป้ายจริง ไม่ใช่เชื่อชื่อไฟล์หรือคอมเมนต์ของรอบก่อน:
//   slide1.png — ป้ายเข้มตัวเลขทอง "คืนยอดเสีย 0.3%" (นางแบบอยู่ขวา โลโก้ซ้ายบน)
//   slide2.png — ป้ายเข้มตัวเลขทอง "แนะนำเพื่อน 0.8%" (นางแบบอยู่ซ้าย โลโก้ขวาบน)
//   slide3.png / slide4.png — โปสเตอร์ของแบรนด์ก่อน (29 ก.ย. เก่ากว่าดรอปนี้)
//     ห้าม import กลับมาเด็ดขาด และห้ามลบไฟล์ทิ้งเพราะเป็นอินเวนทอรีของรอบถัดไป
// ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้วและ verify-build จะแดง
// (banner2/banner3 ใน src/assets ก็เก่ากว่าดรอปนี้ = อาร์ตเวิร์กแบรนด์ก่อน ห้าม import)
// ส่วน banner1 / banner1-mobile / og.png เป็นของ MainLayout ห้าม import จากหน้านี้
// ชื่อตัวแปรตั้งตามข้อความบนภาพ ไม่ใช่ตามเลขไฟล์ เพื่อไม่ให้รอบหน้าสลับผิดอีก
import promoCashback from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้น ๆ "หนึ่งย่อหน้า ประมาณสี่บรรทัด" คือ
// โควตาตัวหนังสือทั้งหมดของหน้านี้, กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อย
// และห้ามเพิ่มย่อหน้า เพราะตัวโปสเตอร์ระบุเปอร์เซ็นต์โบนัสไว้ด้วยตัวอักษรขนาดใหญ่
// อยู่แล้ว การพิมพ์ซ้ำด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ เป้าหมาย h1x1 h2x0 h3x0
//
// สไลด์รอบนี้เป็น **จัตุรัส 600x600 ทั้งคู่** (วัดจาก PNG header) จึงวางเป็นกริดสอง
// คอลัมน์ คุมความกว้างรวมที่ max-w-4xl (896px) ทำให้ช่องละ ~436px ไม่ต้องอัปสเกลเกิน
// ขนาดไฟล์ต้นทาง widths หยุดที่ 600 ตามความกว้างจริงของไฟล์ และคุมภาพต่อใบไว้ที่
// max-w-[600px] สองใบพอดีหนึ่งแถว เรียง คืนยอดเสีย 0.3% ก่อน แนะนำเพื่อน 0.8%
// ตามลำดับของบรีฟ (docx H3 #4 แล้วค่อย #5) ซึ่งรอบนี้แปลว่า slide1 มาก่อน slide2
// LCP คือ hero ใน MainLayout ไม่ใช่สองรูปนี้ จึง loading="lazy" fetchpriority="low"
//
// Announcement รอบนี้หมุนมาเป็น AnnouncementCyber ทั้งเว็บ (แบรนด์ก่อนใช้
// Announcement2) — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ
// BOOM369 แล้ว และทุกหน้าก็เรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop message
// มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกันระหว่างหน้า
//
// พาเลตต์ BOOM369 (brand-spec §2) **นีออนเขียวบนพื้นดำ** — รอบนี้พลิกขั้วจาก HI59
// ที่เป็นฟ้าสว่าง+ทองบนการ์ดสว่าง: เขียวนีออน #42fb5a (ไฮไลต์ ขอบ เรืองแสง) ·
// เขียวแบรนด์ #04ab3a (สต็อปกลางของปุ่ม) · เขียวลึก #036b26 (สต็อปปลาย/ขอบ) ·
// หมึกบนพื้นเขียวนีออน #03150a (สีเดียวที่ใช้ได้บนพื้น #42fb5a) · เนื้อความ #cfe9d7
// (มาจาก BRAND_TEXT ที่ <html> และการ์ด ContentBox ตั้งให้แล้ว จึงไม่ระบุสีที่ย่อหน้า)
// ปุ่มสมัครเป็น PRIMARY จึงถมไล่เฉดเขียวนีออน → เขียวแบรนด์ → เขียวลึก ตามสูตรปุ่ม
// ของสเปก และเงาของรูปเป็นเงาเรืองแสงเขียว rgba(66,251,90,*) ไม่ใช่เงาฟ้า
// ชุดฟ้า+ทองของ HI59 (#0a84e0 #065a9c #06355f #044b80 #033f70 #5ec2ff #18a0f0
// #9ecbf2 #f6fbff #e7f2fd #d3e7fa #eaf5ff #0d2744 #04203f #02162c #073059
// #fdbc04 #ffe27a #c88a02 #8a6102 rgba(6,53,95,*) rgba(10,132,224,*)
// rgba(253,188,4,*) rgba(3,63,112,*) rgba(94,194,255,*)) ออกครบแล้ว ห้ามนำกลับมา
//
// BOOM369 เป็น **เว็บสล็อต** ไม่ใช่เว็บหวย — คำหมวดหวย (หวย ส่งโพย โพย เลขเด็ด
// แนวทาง อัตราจ่าย งวด ผลรางวัล) ห้ามหลงเหลือ และคำของแบรนด์ก่อน (ไฮคลาส VIP
// ส่งตรงจากเว็บแม่ ค่ายเกมพรีเมียม ไม่ผ่านบัญชีม้า) ก็ห้ามหลงเหลือเช่นกัน
// ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% / 0.8% / 100% / 24 ชั่วโมง / 3 ขั้นตอน
// ห้ามแต่งยอดฝากขั้นต่ำ ชื่อค่ายเกม ชื่อธนาคาร เลขใบอนุญาต หรือวันหมดเขตแคมเปญ
// และต้องคงคำกำกับของบรีฟไว้ว่าต้องตรวจค่ายเกม รอบตัดยอด และเงื่อนไขก่อนกดรับสิทธิ์
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 156
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `รวมภาพโปรโมชั่นของ ${BRAND_NAME} ทั้งคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ซึ่งคำนวณจากยอดที่เข้าเกณฑ์ ควร Login ตรวจสอบค่ายเกม รอบตัดยอด และเงื่อนไขก่อนกดรับสิทธิ์`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่น ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});
---

<MainLayout title={`โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% สำหรับยอดที่เข้าเกณฑ์`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`โปรโมชั่น ${BRAND_NAME}`} as="h1">
    <div class="flex flex-col gap-10">
      <p class="text-left text-base leading-relaxed">
        หน้านี้รวมภาพโปรโมชั่นที่ <strong class="text-[#42fb5a]">{BRAND_NAME}</strong> เปิดให้สมาชิกตรวจสอบสิทธิ์ตามแคมเปญของแต่ละช่วง ทั้งคืนยอดเสียและแนะนำเพื่อน โดยรายละเอียดของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว
        ระบบจะนำยอดที่เข้าเกณฑ์มาคำนวณก่อนแสดงจำนวนโบนัสที่รับได้ <strong class="text-[#42fb5a]">เงื่อนไข ค่ายเกมที่ร่วมรายการ และรอบคำนวณของแต่ละโปรโมชั่นอาจแตกต่างกัน</strong> จึงควร Login ตรวจสอบรอบตัดยอดและเงื่อนไขล่าสุดก่อนกดรับสิทธิ์ทุกครั้ง
      </p>

      <div class="mx-auto grid w-full max-w-4xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt={`ภาพโปรโมชั่นของ ${BRAND_NAME} ฉากโถงสีเกือบดำที่สว่างด้วยไฟนีออนสีเขียว ซ้ายบนเป็นโลโก้ ${BRAND_NAME} ในวงแหวนเขียว กลางซ้ายเป็นคำว่า โปรโมชั่น สีเขียวนีออนตัดขอบขาวมีมงกุฎทองอยู่ด้านบน ใต้ลงมาเป็นป้ายสีเข้มข้อความ คืนยอดเสีย 0.3% โดยตัวเลขเป็นสีทอง ด้านขวาเป็นหญิงสาวผมยาวสีขาวเงินสวมชุดเกาะอกสีขาวสลับเขียวประดับเครื่องประดับมรกต แบฝ่ามือออกมาหาผู้ชม มุมซ้ายล่างเป็นกล่องของขวัญสีดำผูกริบบิ้นเขียวทองวางบนกองชิปสีเขียวและทอง`}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), (max-width: 1007px) calc((100vw - 136px) / 2), 436px"
          class="mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#42fb5a]/30 object-contain shadow-[0_0_28px_rgba(66,251,90,0.35)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#42fb5a]/70 hover:shadow-[0_0_40px_rgba(66,251,90,0.55)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoReferral}
          alt={`ภาพโปรโมชั่นของ ${BRAND_NAME} ฉากโถงนีออนสีเขียวชุดเดียวกันแต่สลับข้าง ขวาบนเป็นโลโก้ ${BRAND_NAME} ในวงแหวนเขียว กลางขวาเป็นคำว่า โปรโมชั่น สีเขียวนีออนประดับมงกุฎทอง ใต้ลงมาเป็นป้ายสีเข้มข้อความ แนะนำเพื่อน 0.8% โดยตัวเลขเป็นสีทอง ด้านซ้ายเป็นหญิงสาวผมสีขาวเงินสวมสูทขาวสลับเขียวกระดุมทองและต่างหูมรกต ยื่นมือขวาแบออกมาหาผู้ชม มุมขวาล่างเป็นกล่องของขวัญสีเข้มผูกโบว์ทองวางข้างกองชิปสีเขียวกับทองและไพ่`}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), (max-width: 1007px) calc((100vw - 136px) / 2), 436px"
          class="mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#42fb5a]/30 object-contain shadow-[0_0_28px_rgba(66,251,90,0.35)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#42fb5a]/70 hover:shadow-[0_0_40px_rgba(66,251,90,0.55)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#036b26] bg-gradient-to-b from-[#42fb5a] via-[#04ab3a] via-55% to-[#036b26] px-10 py-3.5 text-lg font-black text-[#03150a] shadow-[0_0_14px_rgba(66,251,90,0.55)] transition-transform hover:scale-105">
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
