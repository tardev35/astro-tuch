---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

// ดรอปนี้ (2026-10-28, brand-spec §6) มีสไลด์ของแบรนด์นี้ **สองใบ** และชื่อตัวแปร
// ตั้งตามข้อความที่พิมพ์อยู่บนภาพจริง (เปิดบิตแมปอ่านเองรอบนี้ ไม่ได้เชื่อคอมเมนต์เก่า)
// ไม่ใช่ตามเลขไฟล์ — ถ้ารอบหน้าเจอความขัดแย้ง **ให้เชื่อข้อความบนรูป**:
//   slide1.png (375x600, mtime 2026-10-28) — โปสเตอร์ "โปรโมชั่น / คืนยอดเสีย / 0.3%"
//   slide2.png (375x600, mtime 2026-10-28) — โปสเตอร์ "โปรโมชั่น / แนะนำเพื่อน / 0.8%"
// 🚨 **รอบก่อนจับคู่กลับด้านกับรอบนี้** (รอบก่อน slide1 = แนะนำเพื่อน และคอมเมนต์
// ของไฟล์นี้ก็เขียนไว้แบบนั้น) — uploader เขียนทับไฟล์เดิมทุกครั้ง **เลขไฟล์จึงไม่มี
// ความหมายข้ามแบรนด์** ต้องเปิดบิตแมปดูทุกรอบ
//   สไลด์ใบที่สามและสี่ (mtime 2026-09-29 = คนละดรอป คนละแบรนด์) — **ห้าม import**
//   แบนเนอร์ใบที่สองและสาม (mtime 2026-10-23 = อาร์ตเวิร์กของอีกแบรนด์) —
//     **ห้าม import** รอบนี้ไม่มี "รูปประกอบบทความ" เลย
//   (ชื่อไฟล์เต็มของทั้งสี่อยู่ใน brand-spec §6 — ไม่พิมพ์ที่นี่ เพื่อให้ grep หา
//    การ import ที่หลงเหลือได้คำตอบว่างจริงๆ)
// ⚠️ eager import = emit ลง dist/ ต่อให้ไม่ได้ render และ verify-build จะแดง
// การ import ไฟล์เก่าคือการส่งรูปของลูกค้ารายอื่นขึ้นเว็บนี้
// **ห้ามลบไฟล์เก่าทิ้ง** — เป็นอินเวนทอรีของรอบถัดไป แค่ห้าม import
// (banner1 / banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักชื่อไว้เอง —
// ห้ามอ้างจากหน้านี้) รอบนี้หน้านี้จึงมีเฉพาะสไลด์สองใบ กริดจึงเป็นสองช่อง
import promoCashback from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้นๆ ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมด
// ของหน้านี้, กริดภาพโปรโมชั่น, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อยและห้ามเพิ่มย่อหน้า
// เพราะโปสเตอร์ระบุชื่อรายการและเปอร์เซ็นต์ของตัวเองด้วยตัวอักษรขนาดใหญ่อยู่แล้ว
// การพิมพ์ซ้ำด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่
// บรีฟรอบนี้ (src/assets/content.txt, 29 บรรทัด) **ไม่มีส่วน SUB-PAGES เลย**
// ทุกย่อหน้าที่เคยอยู่บนหน้านี้คือของที่รีแบรนด์รอบก่อนๆ แต่งขึ้นเอง
//
// 0.3% / 0.8% เป็นเนื้อหาของบรีฟจริง (content.txt บรรทัด 7-12) จึงอ้างได้ตามปกติ
// แต่ **หน้านี้ยังเป็นหน้าภาพ** โควตาตัวหนังสือจึงเป็นย่อหน้าเกริ่นเดียวเท่านั้น
// และ intro ต้องคงประโยคกำกับของบรีฟ (เงื่อนไขต่างกัน ควรตรวจประกาศล่าสุด) ไว้
//
// ลำดับในกริด: คืนยอดเสีย 0.3% ก่อน แนะนำเพื่อน 0.8% — ตามลำดับของบรีฟ
// (content.txt บรรทัด 9 แล้วบรรทัด 11) รอบนี้ลำดับบรีฟบังเอิญตรงกับเลขไฟล์
// **แต่ที่ยึดคือบรีฟ ไม่ใช่เลขไฟล์** รอบหน้าอาจสลับอีก
// ⚠️⚠️ **บิตแมปจริงของดรอปนี้คือ 375x600 แนวตั้ง** (วัดจาก IHDR ของไฟล์เองรอบนี้)
// ความกว้างสูงสุดคือ 375 widths จึงหยุดที่ 375 และคุมที่ max-w ที่ 375px
// **ให้วัดใหม่ทุกรอบจากไฟล์จริง อย่าเชื่อสัดส่วนของรอบก่อน และห้ามขยายเกินต้นฉบับ**
// sizes คิดจากความกว้างที่ถูกวาดจริง: section px-4 (16px/ข้าง) + การ์ด p-8
// (32px/ข้าง, เป็น p-10 = 40px ที่ md ขึ้นไป) + gap-6 ระหว่างคอลัมน์ (24px)
//   ใต้ 640px = คอลัมน์เดียว → 100vw-96px
//   640-767px = สองคอลัมน์ p-8 → 50vw-60px
//   768-885px = สองคอลัมน์ p-10 → 50vw-68px
//   ตั้งแต่ 886px ขึ้นไปชนเพดาน 375px
// LCP คือ hero ใน MainLayout ไม่ใช่รูปพวกนี้ จึง loading="lazy" fetchpriority="low"
// decoding="async" และ quality ตัวเดียวทั้ง avif/webp — ห้ามจูนแยกฟอร์แมต
// (tools/avif-quality-service.mjs ย่อฝั่ง avif ให้เองที่ x0.65)
//
// quality={64} ไม่ใช่ 80 ตามปกติ: สไลด์ทั้งสองเป็นภาพถ่ายคนในฉากอิ่มสี บวก
// ตัวอักษรไทยสามมิติผิวมันเงาตัดขอบคมที่มีไฮไลต์ทับอยู่ด้านบน ซึ่งเป็นเคสที่
// AVIF ทำได้แย่ที่สุด ที่ quality=80 ไฟล์ AVIF มีโอกาสออกมา **ใหญ่กว่า** WebP ที่เป็น
// fallback ของตัวเอง เบราว์เซอร์ที่รองรับ AVIF จะหยิบไฟล์ที่หนักกว่าไปใช้ และ
// verify-build.mjs ทำให้ build แดงด้วยเหตุนี้ตรงๆ · ทางแก้คือ quality ที่ **ต่ำลง**
// ไม่ใช่สูงขึ้น · ค่าเดียวกันนี้ต้องใช้ที่ index.astro กับสไลด์ใบเดียวกัน
//
// Announcement รอบนี้หมุนมาเป็นตัวท้ายชื่อ Premium ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ตัวท้ายชื่อเลขห้าจึงหมุนออก · เขียนชื่อไฟล์แบบไม่มีเครื่องหมายคำพูดโดยตั้งใจ
// เพราะ tools/gen-tw-sources.mjs นับ literal ที่มีเครื่องหมายคำพูดว่าเป็นการ import
// จริง คอมเมนต์จึงทำให้ variant เก่าหลุดเข้า Tailwind scan แล้วสีของแบรนด์ก่อนขึ้น
// stylesheet) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้
// ไว้แล้ว และทุกหน้าเรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop message
//
// ───────────────────────────────────────────────────────────────────────────
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) **กลับทิศ 180° จากรอบก่อน: รอบนี้มืดทั้งเว็บ**
// bg.json ของดรอปนี้คือ {"mode":"color","color":"#1e0101"} = **ดำอมเลือดหมู**
// (รอบก่อน 123BET เป็นชมพูบลัชจาง ซึ่งอยู่คนละปลายของสเกล — อ่านจากไฟล์ทุกรอบ ห้ามเดา)
// **ห้าม "แก้" การ์ดกลับไปเป็นผิวสว่าง** — ผิวสว่างบนหมึก #fdf0e6 = ตัวอักษรหายไปเลย
// ลำดับผิว: พื้นเพจ #1e0101 / การ์ด ContentBox #2a0a04 / ชั้นยก #3b130b /
// เส้นบาง #5a2410 · ขอบตกแต่ง/ออรา #8a3a12 (**สองค่าหลังห้ามถือตัวอักษร**)
// หมึก #fdf0e6 = เนื้อความ (= BRAND_TEXT ที่ <html> และการ์ด ContentBox ตั้งให้แล้ว
// 16.4:1 บนการ์ด) · หมึกรอง #e0bda4 (10.5:1)
// ส้มเพลิง #f27a1a = สีของ <strong> ในเนื้อความ (6.6:1 บนการ์ด) และสีหัวข้อ
// ทองอำพัน #e5a92b (8.8:1) และเงินโครเมียม #c9d2dc (12.0:1) ถือตัวอักษรบนการ์ดได้
// 🚨🚨 **#5a2410 #8a3a12 ห้ามเป็นสีตัวอักษรทุกบริบท** เป็นเส้น/ขอบ/ออรา/พื้นถมเท่านั้น
// ปุ่ม CTA ของหน้านี้เป็น **PRIMARY = ไล่เฉดส้ม-ทอง** #f0a21e → #f27a1a → #e8620e
// บนหมึก **ดำ #1e0101** (9.3 / 7.1 / 5.8:1 ต่อ stop — ผ่าน AA ทุก stop)
// ⚠️⚠️ **ห้ามใช้หมึกขาวบนไล่เฉดนี้** (2.8:1) และ **ห้ามลากปลายเฉดเข้มกว่า #e8620e**
// (เกินกว่านั้นหมึกดำตกต่ำกว่า 4.5:1) แผ่นไฮไลต์ด้านบนปุ่มจำกัดที่ white/10
// rgba() ที่อนุญาตรอบนี้: rgba(242,122,26,α) · rgba(229,169,43,α) ·
// rgba(138,58,18,α) · rgba(30,1,1,α) · rgba(20,3,2,α)
// ⚠️⚠️ กับดักที่แหลมที่สุดรอบนี้คือ **ส้ม/ทองของแบรนด์อื่น** ซึ่งเป็นตระกูลเดียวกับ
// รอบนี้เป๊ะ (ZNOVA168 น้ำตาล-อำพัน · MEXICANOSLOT แดง-ทอง · TEVA69 ทอง)
// ที่ห้ามคือ **ค่าเฮกซ์ของแบรนด์เก่าแบบตรงหกหลัก** ไม่ใช่ "สีส้ม" ในฐานะตระกูลสี
// ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน brand-spec §2 ห้ามตัดสินด้วยสายตา
// (ค่าของ 123BET รอบก่อนทันทีที่ต้องไม่หลงเหลือ เขียนแบบไม่มี # โดยตั้งใจ:
//  a30d1a c21325 8a1420 ef4a5e dca53a 7a4a0c d2d7dd 36080f 6b2b33 330710 1c050b
//  4d0c18 fdf5f6 f7e4e9 f7dfe4 eec3cc d98fa0 รวมถึงรูปแบบ rgba ของสองค่าแรกด้วย)
// · กิโมโนแดง-ดำ ปิ่นซากุระแดง-ขาว ผนังห้องสีขาวงาช้าง และสีผิวนางแบบในอาร์ตเวิร์ก
// เป็น **วัตถุในภาพ ไม่ใช่สี UI** · พื้นเพจมาจาก bg.json เท่านั้น
// · <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ
// ถ้าเปิด/ปิดกลางคำ บรรทัดจะตัดกลางคำ
//
// ⚠️ แกนของแบรนด์รอบนี้คือ **คาสิโนเล่นบาคาร่า** และบรีฟระบุหมวดเกมไว้ **สามหมวด
// เท่านั้น: บาคาร่าออนไลน์ · คาสิโนสด · สล็อต** (brand-spec §5)
// 🚨 **รอบก่อนมีเจ็ดหมวด — ห้ามสืบทอดจำนวนหมวดข้ามแบรนด์** คำนิยามตัวเองทั้งชุดของ
// แบรนด์ขาออกห้ามเหลือ (ลิสต์เต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้
// sweep ของรอบถัดไปเจอ false positive)
// 🚨 **บรีฟรอบนี้ไม่พูดถึงธนาคาร วอลเลท หรือหมวดฝากถอนเลยแม้แต่คำเดียว** แต่
// **ประโยคกำกับของบรีฟเองที่มีคำว่า "ถอนเงิน" ต้อง ship ตามที่บรีฟเขียน ห้ามเลี่ยงคำ**
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 100% · 3 ขั้นตอน · 24ชม.
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -c บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงนี้ยาว 159 ด้วยชื่อแบรนด์ 5 อักขระของรอบนี้
// (**ต้องนับใหม่ทุกรอบ** ห้ามสืบทอดความยาว — รอบก่อนชื่อยาว 6)
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `รวมภาพโปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ไว้ในหน้าเดียว แต่ละรายการกำหนดประเภทเกมและยอดที่นำมาคำนวณต่างกัน ควรตรวจสอบประกาศล่าสุดก่อนรับสิทธิ์`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่น ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});

// ความกว้างที่ถูกวาดจริงของแต่ละคอลัมน์ในกริดสองคอลัมน์ (ดูคอมเมนต์ sizes ด้านบน)
const promoSizes = "(max-width: 639px) calc(100vw - 96px), (max-width: 767px) calc(50vw - 60px), (max-width: 885px) calc(50vw - 68px), 375px";

const promoClass =
  "mx-auto h-auto w-full max-w-[375px] rounded-xl border border-[#5a2410] object-contain shadow-[0_8px_28px_rgba(20,3,2,0.55)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#8a3a12] hover:shadow-[0_12px_40px_rgba(242,122,26,0.22)]";

// alt ทั้งสองเขียนจากบิตแมปของดรอปนี้ที่เปิดอ่านเองแล้ว (**375x600 แนวตั้ง** ทั้งคู่) —
// ฉากห้องญี่ปุ่นโทนขาวงาช้าง มีกิ่งซากุระชมพู-ขาวและฉากบานเลื่อนโปร่ง หญิงสาวผมยาว
// สีเข้ม สวมปิ่นปักผมซากุระแดง-ขาวพร้อมพู่ทอง ในกิโมโนลายดอกไม้แดง-ดำปักทอง ·
// เวิร์ดมาร์กสามมิติอยู่มุมบนขวาทั้งสองใบ วางบนตราโล่พื้นเข้มที่มีมงกุฎทอง เสาโทริอิ
// และมังกร · ตัวอักษรไทยสามมิติสีทองตัดขอบแดงน้ำตาลว่า โปรโมชั่น · ชื่อรายการตัวขาว
// บนแคปซูลดำขอบลายทอง · ตัวเลขเปอร์เซ็นต์ตัวโตสามมิติผิวส้ม-ทองตัดขอบดำ · แคปซูลดำ
// ขอบทองท้ายภาพเขียนว่า สมัครสมาชิก พร้อมไอคอนรูปคนกับเครื่องหมายบวก และลูกศรคู่
// ⚠️ alt คือ "ข้อความที่พิมพ์อยู่บนโปสเตอร์" เป็นหลัก — ตัวเลขท้าย alt ต้องตรงกับรูป
// ⚠️ ห้ามเรียกรูปคู่นี้ว่าภาพแนวนอนหรือภาพสี่เหลี่ยมจัตุรัส รอบนี้เป็น **แนวตั้ง**
// ⚠️ จุดที่ **ต่างกันจริงระหว่างสองใบ** และต้องเขียนให้ตรง (ตรวจจากบิตแมปรอบนี้):
//   slide1 (คืนยอดเสีย 0.3%) ถือ **ร่มญี่ปุ่นลายซากุระแดง-ขาว** พาดไหล่ **ไม่มีพัด**
//   slide2 (แนะนำเพื่อน 0.8%) ถือ **พัดพับแดง-ขาว** ขึ้นมาข้างใบหน้า **ไม่มีร่ม**
//     และมีแถบสีทองสาดเป็นรอยพู่กันอยู่หลังเวิร์ดมาร์ก
//   **ห้ามเขียนว่ามีทั้งร่มและพัดอยู่ในใบเดียวกัน** และห้ามลอก alt ของรอบก่อน
//     (รอบก่อนเป็นฉากโถงวังหินอ่อนกับชุดราตรี คนละอาร์ตเวิร์กกันคนละเรื่อง —
//      องค์ประกอบของแบรนด์ก่อนๆ ที่ต้องไม่หลงเหลืออยู่ครบใน brand-spec §6)
// ⚠️ ห้ามระบุว่าใช้มือซ้ายหรือมือขวา — รอบก่อนๆ เขียนไว้แล้วผิดหลายรอบติด
// ⚠️ สีของวัตถุในรูป (กิโมโนแดง-ดำ ปิ่นซากุระแดง-ขาว มงกุฎทองบนตรา) เป็นวัตถุในภาพ
// ไม่ใช่สีของแบรนด์
// 🚨 **ห้ามพิมพ์ตัวอักษรของชื่อแบรนด์ลงใน alt** ให้บรรยาย "รูปร่าง" ของเวิร์ดมาร์ก
// แล้วเรียกชื่อแบรนด์ผ่าน BRAND_NAME เท่านั้น (brand-spec §6)
const altCashback = `โปสเตอร์โปรโมชั่นแนวตั้ง มุมบนขวาเป็นโลโก้ ${BRAND_NAME} แบบเวิร์ดมาร์กสามมิติ ส่วนหน้าเป็นผิวส้มเพลิงไล่ทองตัดขอบดำมีไฮไลต์ขาววาบ ส่วนท้ายเป็นผิวโครเมียมเงินขัดเงา วางบนตราโล่พื้นเข้มที่มีมงกุฎทอง เสาโทริอิ และมังกร ฝั่งซ้ายเป็นหญิงสาวผมยาวสีเข้ม สวมปิ่นปักผมซากุระแดง-ขาวพร้อมพู่ทอง ในกิโมโนลายดอกไม้แดง-ดำปักทอง ถือร่มญี่ปุ่นลายซากุระแดง-ขาวพาดไหล่ ฉากหลังเป็นห้องญี่ปุ่นโทนขาวงาช้างที่มีกิ่งซากุระชมพู-ขาวและฉากบานเลื่อนโปร่ง ครึ่งล่างเป็นตัวอักษรไทยสามมิติสีทองตัดขอบแดงน้ำตาลอ่านว่า โปรโมชั่น ใต้ลงมาเป็นคำว่า คืนยอดเสีย ตัวขาวบนแคปซูลสีดำขอบลายทอง แล้วตัวเลข 0.3% ตัวโตสามมิติผิวส้ม-ทองตัดขอบดำ ปิดท้ายด้วยแคปซูลสีดำขอบทองเขียนว่า สมัครสมาชิก พร้อมไอคอนรูปคนกับเครื่องหมายบวกและลูกศรคู่`;

const altReferral = `โปสเตอร์โปรโมชั่นแนวตั้ง มุมบนขวาเป็นโลโก้ ${BRAND_NAME} แบบเวิร์ดมาร์กสามมิติ ส่วนหน้าเป็นผิวส้มเพลิงไล่ทองตัดขอบดำมีไฮไลต์ขาววาบ ส่วนท้ายเป็นผิวโครเมียมเงินขัดเงา วางบนตราโล่พื้นเข้มที่มีมงกุฎทอง เสาโทริอิ และมังกร โดยมีแถบสีทองสาดเป็นรอยพู่กันอยู่ด้านหลัง ฝั่งซ้ายเป็นหญิงสาวผมยาวสีเข้ม สวมปิ่นปักผมซากุระแดง-ขาวพร้อมพู่ทอง ในกิโมโนลายดอกไม้แดง-ดำปักทอง ถือพัดพับแดง-ขาวขึ้นมาข้างใบหน้า ฉากหลังเป็นห้องญี่ปุ่นโทนขาวงาช้างที่มีกิ่งซากุระชมพู-ขาว ครึ่งล่างเป็นตัวอักษรไทยสามมิติสีทองตัดขอบแดงน้ำตาลอ่านว่า โปรโมชั่น ใต้ลงมาเป็นคำว่า แนะนำเพื่อน ตัวขาวบนแคปซูลสีดำขอบลายทอง แล้วตัวเลข 0.8% ตัวโตสามมิติผิวส้ม-ทองตัดขอบดำ ปิดท้ายด้วยแคปซูลสีดำขอบทองเขียนว่า สมัครสมาชิก พร้อมไอคอนรูปคนกับเครื่องหมายบวกและลูกศรคู่`;
---

<MainLayout title={`รวมภาพโปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`รวมภาพโปรโมชั่น ${BRAND_NAME}`} as="h1">
    <div class="flex flex-col gap-10">
      <p>
        หน้านี้รวมภาพรายการโปรโมชั่นที่ {BRAND_NAME} ระบุไว้สำหรับสมาชิกไว้ในที่เดียว โดยชื่อรายการและเปอร์เซ็นต์ของแต่ละรายการพิมพ์อยู่บนภาพแล้ว ทั้งนี้
        <strong class="text-[#f27a1a]">
          โปรโมชั่นแต่ละรายการอาจกำหนดประเภทเกมที่เข้าร่วม ยอดที่นำมาคำนวณ รอบเวลารับเครดิต และข้อกำหนดการถอนเงินแตกต่างกัน จึงควรตรวจสอบรายละเอียดจากประกาศล่าสุดของเว็บไซต์ทางการก่อนรับสิทธิ์ทุกครั้ง
        </strong>
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt={altCashback}
          loading="lazy"
          fetchpriority="low"
          widths={[250, 375]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />

        <Picture
          src={promoReferral}
          alt={altReferral}
          loading="lazy"
          fetchpriority="low"
          widths={[250, 375]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="relative isolate flex items-center justify-center overflow-hidden rounded-lg border border-[#8a3a12] bg-gradient-to-b from-[#f0a21e] via-[#f27a1a] to-[#e8620e] px-10 py-3.5 text-lg font-black text-[#1e0101] shadow-[0_8px_22px_rgba(242,122,26,0.35)] transition-transform hover:scale-105">
          <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-white/10 to-transparent"></span>
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
