---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";

import { Picture } from "astro:assets";

// Only slide1/slide2 belong to this brand (7LOTTO drop, 2026-08-11) and both
// are literally the two promotions this page describes: slide1 is the
// "คืนยอดเสีย รับโบนัส 0.3%" poster, slide2 is the "แนะนำเพื่อน รับโบนัส 0.8%"
// poster. slide3/slide4 still on disk are a previous client's artwork — they
// may not be imported here, now or on any future rebrand.
import promoCashback from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";

const pageDescription = "รวมโปรโมชั่นแทงหวย 7LOTTO ทั้งคืนยอดเสียรับโบนัส 0.3% และแนะนำเพื่อนรับโบนัส 0.8% ตรวจสอบยอดสะสมและเงื่อนไขการรับสิทธิ์ผ่านระบบสมาชิกให้ครบก่อนกดรับทุกครั้ง";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น 7LOTTO คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8%",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});
---

<MainLayout title="โปรโมชั่น 7LOTTO คืนยอดเสียรับ 0.3% แนะนำเพื่อนรับ 0.8%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น 7LOTTO" as="h1">
    <div>
      <h2 class="mb-4 text-2xl leading-normal font-bold text-[#ff2a30]">คืนยอดเสียทุกวัน รับโบนัส 0.3%</h2>

      <div class="mb-10 grid w-full grid-cols-1 items-center gap-6 md:grid-cols-2">
        <p class="text-left text-base leading-relaxed text-[#d8dae0]">
          สมาชิกที่ส่งโพยแล้วมียอดเสียตามเงื่อนไข สามารถรับโบนัสคืนยอดเสีย 0.3% ได้โดยตรวจสอบยอดและกดรับสิทธิ์ตามรอบเวลาที่ระบบกำหนด นับรวมยอดจากหวยรัฐบาลไทย หวยออมสิน หวย ธ.ก.ส. หวยลาว หวยฮานอย
          และหวยหุ้น ไว้ในบัญชีเดียว ทั้งนี้ยอดที่นำมาคำนวณและการรับโบนัสเป็นไปตามข้อกำหนดของโปรโมชั่น
        </p>

        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่น 7LOTTO พื้นดำลายวงจรสีแดง ข้อความ โปรโมชั่น คืนยอดเสีย รับโบนัส 0.3% หญิงสาวผมสั้นสีเงินชุดหนังแดง มือถือแสดงผลรางวัลหวย ลูกบอลหวยเลข 7 กับ 3 และกองเหรียญทอง"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 768px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#a3060c]/45 object-contain shadow-[0_10px_30px_rgba(255,42,48,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ff2a30]/70 hover:shadow-[0_15px_40px_rgba(255,42,48,0.28)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <h2 class="mb-4 text-2xl leading-normal font-bold text-[#ff2a30]">แนะนำเพื่อน รับโบนัส 0.8%</h2>

      <div class="mb-8 grid w-full grid-cols-1 items-center gap-6 md:grid-cols-2">
        <p class="text-left text-base leading-relaxed text-[#d8dae0]">
          สมาชิกสามารถแชร์ลิงก์แนะนำของตนเองให้เพื่อนสมัครเข้ามาแทงหวย และรับโบนัสแนะนำเพื่อน 0.8% ตามยอดและเงื่อนไขที่กำหนด สามารถตรวจสอบข้อมูลการแนะนำและสิทธิ์ที่ได้รับผ่านระบบสมาชิก
          หากมีข้อสงสัยสามารถสอบถามเจ้าหน้าที่ 7LOTTO ได้ตลอด 24 ชั่วโมง
        </p>

        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่น 7LOTTO พื้นดำลายวงจรสีแดง ข้อความ โปรโมชั่น แนะนำเพื่อน รับโบนัส 0.8% หญิงสาวชุดแดง มือถือแสดงเมนูแทงหวย แทงง่าย จ่ายจริง อัตราจ่ายสูงสุด บาทละ 900 และลูกบอลหวยเลข 7 9 3"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 768px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#a3060c]/45 object-contain shadow-[0_10px_30px_rgba(255,42,48,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ff2a30]/70 hover:shadow-[0_15px_40px_rgba(255,42,48,0.28)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg bg-gradient-to-r from-[#ff6b70] via-[#ff2a30] to-[#a3060c] px-10 py-3.5 text-lg font-black text-[#1a0405] shadow-[0_0_15px_rgba(255,42,48,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก 7LOTTO
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
