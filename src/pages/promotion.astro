---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";

import { Picture } from "astro:assets";

// ดรอปนี้ (2026-10-10) มีสไลด์ที่ "ใช้ได้" แค่สองใบ และรอบนี้เปิดอ่านป้ายบนภาพจริง
// ใหม่แล้ว ห้ามเชื่อเลขไฟล์หรือคอมเมนต์ของรอบก่อน (การจับคู่สลับข้างแทบทุกรอบ —
// ตารางใน brand-spec §4 ตรงกับสิ่งที่พิมพ์อยู่บนรูปจริง และเปิดรูปยืนยันซ้ำแล้ว):
//   slide1.png — ป้าย "โปรโมชั่น" ทองสามมิติ ใต้ป้ายเขียน "คืนยอดเสีย 0.3%"
//   slide2.png — ป้าย "โปรโมชั่น" ทองสามมิติ ใต้ป้ายเขียน "แนะนำเพื่อน โบนัส 0.8%"
//   slide3.png / slide4.png — โปสเตอร์ของแบรนด์รอบก่อน (mtime 09-29)
//     ห้าม import กลับมาเด็ดขาด และห้ามลบไฟล์ทิ้งเพราะเป็นอินเวนทอรีของรอบถัดไป
// ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้ว และ verify-build จะแดง
// (banner2 / banner3 ใน src/assets เป็นอาร์ตเวิร์กของแบรนด์ก่อนๆ ห้าม import ส่วน
// banner1 / banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักชื่อไว้เอง
// — ห้ามอ้างจากหน้านี้)
// ชื่อตัวแปรตั้งตามข้อความบนภาพ ไม่ใช่ตามเลขไฟล์ เพื่อไม่ให้รอบหน้าสลับผิดอีก
import promoCashback from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้นๆ "หนึ่งย่อหน้า ประมาณสี่บรรทัด" คือ
// โควตาตัวหนังสือทั้งหมดของหน้านี้, กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อย
// และห้ามเพิ่มย่อหน้า เพราะตัวโปสเตอร์ระบุเปอร์เซ็นต์โบนัสไว้ด้วยตัวอักษรขนาดใหญ่
// อยู่แล้ว การพิมพ์ซ้ำด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ เป้าหมาย h1x1 h2x0 h3x0
//
// สไลด์รอบนี้เป็น **600x600 ทั้งคู่** วางเป็นกริดสองคอลัมน์ คุมความกว้างรวมที่
// max-w-4xl (896px) ทำให้ช่องละ ~436px ไม่ต้องอัปสเกลเกินขนาดไฟล์ต้นทาง widths
// หยุดที่ 600 ตามความกว้างจริงของไฟล์ และคุมภาพต่อใบไว้ที่ max-w-[600px]
// เรียง คืนยอดเสีย 0.3% ก่อน แนะนำเพื่อน 0.8% ตามลำดับของบรีฟ (docx H3 #4 แล้ว #5)
// ซึ่งรอบนี้แปลว่า **slide1 มาก่อน slide2** ตามข้อความที่พิมพ์อยู่บนรูป
// sizes คิดจากความกว้างที่ถูกวาดจริง: px-4 ของ section (16px/ข้าง) + p-8 ของการ์ด
// (32px/ข้าง, เป็น p-10 = 40px ที่ md ขึ้นไป) + gap-6 (24px) ระหว่างสองคอลัมน์
// LCP คือ hero ใน MainLayout ไม่ใช่สองรูปนี้ จึง loading="lazy" fetchpriority="low"
//
// Announcement รอบนี้หมุนมาเป็น Announcement6 ทั้งเว็บ (รอบก่อนใช้ AnnouncementPremium
// — brand-spec §3 หมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ
// แบรนด์นี้ไว้แล้ว และทุกหน้าก็เรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop message
// มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกันระหว่างหน้า
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ทองเป็ด นำ ส้มอำพัน รอง บนพื้นดำสนิท**
// พลิกทิศจากรอบก่อนที่เป็นคู่ทอง-เงินโครเมียมบนพื้นน้ำตาลไหม้ รอบนี้ bg.json เป็น
// {"mode":"color","color":"#000000"} = ดำสนิท ทุกผิวการ์ดจึงต้องสว่างกว่าพื้นเสมอ
// และ **ไม่มีสีแดงและไม่มีเงินโครเมียมเป็นฮิวเลย**
// ฮิวนำคือ **ทองเป็ด** #f3bb34 (vivid ของ logo.webp และคำว่า DUCK บนโลโก้) ถือขอบรูป
// ออรา และพื้นถมของปุ่มหลัก · ทองสว่าง #fde464 เป็นต้นไล่เฉด · ทองกลาง #c8901a
// เป็นขอบและปลายเข้มที่สุดที่ยอมให้รองหมึกได้ (หมึก #1a1203 บนมันได้ 6.4:1 = ผ่าน)
// · **ส้มอำพัน** #f58b2a (ปากของเป็ดในโลโก้และของมาสคอตในแบนเนอร์) เป็นฮิวที่สอง
// ใช้เป็นออราตอน hover · หมึกบนพื้นถมทองเป็นน้ำตาลเกือบดำ #1a1203 เท่านั้น
// · เนื้อความ #f6ecd9 มาจาก BRAND_TEXT ที่ <html> และการ์ด ContentBox ตั้งให้แล้ว
// ย่อหน้าจึงไม่ประกาศสีของตัวเอง
// ⚠️ ห้ามพลิกปุ่มพื้นทองให้เป็นหมึกสว่าง และห้ามให้ไล่เฉดทองที่รองหมึกจบเข้มกว่า
// #c8901a (#8a5f08 / #5c3f04 / #a3510c เป็นเส้นและออราเท่านั้น ห้ามถือตัวอักษร)
// ชุดสีของแบรนด์ก่อนๆ ออกครบแล้ว ทั้งคลาส Tailwind raw hex และ rgba() (ค่าเดิมอยู่ใน
// brand-spec §2 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive)
// ⚠️ กับดักของรอบนี้: เจ็ดในแปดแบรนด์หลังสุดก็ "ทอง" เหมือนกัน เจอทองที่ไหนห้ามเหมา
// ว่าเป็นของรอบนี้ ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน brand-spec §2
//
// แบรนด์นี้เป็น **สล็อตพีจีเว็บเป็ด** เป็นเว็บสล็อต PG ล้วน ไม่ใช่เว็บของหมวดอื่น
// (รายการหมวดที่ห้ามเอ่ยอยู่ใน brand-spec §7) คำขายของของแบรนด์ก่อนและศัพท์หมวดอื่นที่บรีฟ
// ไม่ได้เอ่ยห้ามหลงเหลือ (รายการเต็มอยู่ใน brand-spec §7 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้
// grep เจอ false positive) ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% / 0.8% / 3 ขั้นตอน /
// 24 ชั่วโมง — ห้ามแต่งยอดฝากขั้นต่ำ ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP เลขใบอนุญาต
// จำนวนสมาชิก ปีก่อตั้ง หรือวันหมดเขต
// และต้องคงคำกำกับของบรีฟไว้ว่าแต่ละโปรโมชั่นอาจมีเงื่อนไขเกี่ยวกับประเภทเกม
// ระยะเวลา และการใช้โบนัสแตกต่างกัน จึงควรอ่านรายละเอียดก่อนกดรับสิทธิ์
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) หน้านี้ยาว 158 อักขระ
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `โปรโมชั่น ${BRAND_NAME} สล็อตพีจีเว็บเป็ด รวมภาพกิจกรรมคืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อนรับโบนัสแชร์ลิงก์ 0.8% จากยอดที่เข้าเกณฑ์ ตามเงื่อนไขแต่ละรายการ`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่น ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});

// ความกว้างที่ถูกวาดจริงของแต่ละช่องในกริดสองคอลัมน์ (ดูคอมเมนต์ sizes ด้านบน)
const promoSizes = "(max-width: 639px) calc(100vw - 96px), (max-width: 767px) calc((100vw - 120px) / 2), (max-width: 1007px) calc((100vw - 136px) / 2), 436px";
const promoClass =
  "mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#f3bb34]/40 object-contain shadow-[0_0_28px_rgba(243,187,52,0.28)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f3bb34]/85 hover:shadow-[0_0_40px_rgba(245,139,42,0.38)]";
---

<MainLayout title={`โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% จากยอดที่เข้าเกณฑ์`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`โปรโมชั่น ${BRAND_NAME} ทั้งหมด`} as="h1">
    <div class="flex flex-col gap-10">
      <p>
        หน้านี้รวมภาพโปรโมชั่นที่ <strong>{BRAND_NAME}</strong> เปิดให้สมาชิกตรวจสอบสิทธิ์ตามกิจกรรมที่เว็บไซต์เปิดให้บริการ โดยเน้นโบนัสคืนยอดเสียและกิจกรรมแนะนำเพื่อน รายละเอียดของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว
        สมาชิกเข้าสู่ระบบเพื่อตรวจสอบยอดที่เข้าเกณฑ์ รอบคำนวณ และสถานะการรับโบนัสผ่านบัญชีได้โดยตรง <strong>แต่ละโปรโมชั่นอาจมีเงื่อนไขเกี่ยวกับประเภทเกม ระยะเวลา และการใช้โบนัสแตกต่างกัน</strong> จึงควรอ่านรายละเอียดก่อนกดรับสิทธิ์ทุกครั้ง
      </p>

      <div class="mx-auto grid w-full max-w-4xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt={`ภาพโปรโมชั่นของ ${BRAND_NAME} เป็นฉากอวกาศโทนทอง-ดำ มุมขวาบนเป็นโลโก้เป็ดการ์ตูนสีเหลืองสวมมงกุฎทองขยิบตา คู่กับคำว่า ${BRAND_NAME} โดยมีดาวเคราะห์และดวงจันทร์อยู่ด้านหลัง ด้านซ้ายเป็นหญิงสาวผมสั้นสีเงินในชุดดำ-ทองประดับมงกุฎเล็ก ยิ้มและชี้นิ้วขึ้นไปที่ข้อความ มุมขวาล่างเป็นมาสคอตเป็ดสวมมงกุฎในเสื้อคลุมแดง-ทองยืนข้างตู้สล็อตสีทองที่ขึ้นเลข 777 มีเหรียญทองลอยกระจายอยู่ทั่วภาพ กลางภาพเป็นคำว่า โปรโมชั่น ตัวอักษรสามมิติสีทองขนาดใหญ่ และใต้ลงมาบนแผ่นป้ายสีเข้มเขียนว่า คืนยอดเสีย คู่กับตัวเลข 0.3% ตัวโต`}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoReferral}
          alt={`ภาพโปรโมชั่นของ ${BRAND_NAME} ฉากอวกาศโทนทอง-ดำชุดเดียวกัน ด้านบนค่อนไปทางขวาเป็นโลโก้เป็ดการ์ตูนสีเหลืองสวมมงกุฎทองคู่กับคำว่า ${BRAND_NAME} มุมซ้ายบนเป็นดวงจันทร์เสี้ยวและดาวเคราะห์ ด้านซ้ายเป็นหญิงสาวผมสั้นสีเงินสวมมงกุฎทองในชุดดำ-ทองผูกโบว์ ชี้มือทั้งสองข้างไปที่ข้อความ มุมขวาล่างเป็นมาสคอตเป็ดในชุดดำ-ทองยืนข้างตู้สล็อตสีทองที่ขึ้นเลข 7 และวงล้อ BAR รอบตัวมีเหรียญทองกองอยู่จำนวนมาก กลางภาพเป็นคำว่า โปรโมชั่น ตัวอักษรสามมิติสีทอง และใต้ลงมาบนแผ่นป้ายสีเข้มเขียนว่า แนะนำเพื่อน และ โบนัส คู่กับตัวเลข 0.8% ตัวโต`}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#c8901a] bg-gradient-to-b from-[#fde464] via-[#f3bb34] to-[#c8901a] px-10 py-3.5 text-lg font-black text-[#1a1203] shadow-[0_0_14px_rgba(243,187,52,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
