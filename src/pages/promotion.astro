---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

// Only slide1/slide2 are this brand's assets — slide3/slide4 are stale
// leftovers from a previous brand (older mtime, not part of this drop) and
// must not be imported or rendered. See .rebrand-brand-spec-BETFLIX6789.md "Images" section.
import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "โปรโมชั่น BETFLIX6789 คาสิโนออนไลน์ระบบออโต้ คืนยอดเสีย 0.3% และแนะนำเพื่อนรับโบนัส 0.8% ตรวจสอบเงื่อนไขให้ครบก่อนกดรับสิทธิ์ทุกครั้ง เพื่อความคุ้มค่าสูงสุด";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น BETFLIX6789 คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8%",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});
---

<MainLayout title="โปรโมชั่น BETFLIX6789 แนะนำเพื่อนรับ 0.8% คืนยอดเสียรับ 0.3%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น BETFLIX6789" as="h1">
    <div>
      <h2 class="mb-4 text-2xl leading-normal font-bold text-[#c8102e]">โปรโมชั่นคืนยอดเสีย 0.3%</h2>

      <p class="mb-8 text-left text-base leading-relaxed text-[#f4e3c8]">
        สมาชิก BETFLIX6789 สามารถตรวจสอบสิทธิ์รับคืนยอดเสีย 0.3% ได้ตามเงื่อนไขของเว็บไซต์ โดยระบบจะอัปเดตรายละเอียดการรับสิทธิ์และช่วงเวลาที่สามารถกดรับได้อย่างชัดเจน
      </p>

      <h2 class="mb-4 text-2xl leading-normal font-bold text-[#c8102e]">โปรโมชั่นแนะนำเพื่อน 0.8%</h2>

      <p class="mb-8 text-left text-base leading-relaxed text-[#f4e3c8]">
        สมาชิกสามารถร่วมกิจกรรมแนะนำเพื่อนของ BETFLIX6789 และรับโบนัส 0.8% ตามเงื่อนไขที่เว็บไซต์กำหนด พร้อมตรวจสอบข้อมูลการแนะนำและโบนัสที่ได้รับผ่านระบบสมาชิกได้อย่างสะดวก
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={pro1}
          alt="แบนเนอร์ BETFLIX6789 โบนัสคืนยอดเสียทุกวัน รับ 0.3% ธีมแดงทองสไตล์คาสิโน สำหรับสมาชิกที่เดิมพันต่อเนื่อง พร้อมระบบฝากถอนออโต้ 24 ชม."
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600, 800]}
          sizes="(max-width: 768px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#c8102e]/25 object-contain shadow-[0_10px_30px_rgba(200,16,46,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#c8102e]/50 hover:shadow-[0_15px_40px_rgba(200,16,46,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro2}
          alt="แบนเนอร์ BETFLIX6789 โบนัสแนะนำเพื่อน รับ 0.8% ธีมแดงทองสไตล์คาสิโน จากยอดเดิมพันของเพื่อนที่สมัครผ่านลิงก์แนะนำ และตรวจสอบสิทธิ์ได้เองผ่านระบบ"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600, 800]}
          sizes="(max-width: 768px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#c8102e]/25 object-contain shadow-[0_10px_30px_rgba(200,16,46,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#c8102e]/50 hover:shadow-[0_15px_40px_rgba(200,16,46,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#c8102e]/60 bg-gradient-to-r from-[#f6d78a] to-[#c8102e] px-10 py-3.5 text-lg font-black text-white shadow-[0_10px_30px_rgba(200,16,46,0.18)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(138,20,32,0.30)]">
          สมัครสมาชิก BETFLIX6789
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
