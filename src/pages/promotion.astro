---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxCyberCut.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

// เฉพาะ slide1/slide2 (ลงวันที่ 2026-09-03) เท่านั้นที่เป็นอาร์ตเวิร์กของ TTN69
// slide1 คือโปสเตอร์ "คืนยอดเสีย 0.3%" ส่วน slide2 คือ "แนะนำเพื่อน 0.8%"
// — อ่านจากตัวภาพจริง ไม่ใช่จากชื่อตัวแปรที่รอบก่อนตั้งไว้
// slide3/slide4 (2026-08-13) กับ banner2/banner3 ยังค้างอยู่บนดิสก์แต่เป็นอาร์ตเวิร์กของ
// ลูกค้าเจ้าก่อนหน้า — ห้าม import ที่นี่ทั้งรอบนี้และรอบถัดไป
// (ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้ว)
import promoReferral from "../assets/slide2.png";
import promoCashback from "../assets/slide1.png";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็น IMAGE page: ContentBox title, ย่อหน้าเกริ่นสั้น ๆ หนึ่งย่อหน้า, กริดโปสเตอร์,
// ปุ่ม CTA หนึ่งปุ่ม — ไม่มีหัวข้อย่อยและไม่มีย่อหน้าเพิ่ม เพราะตัวโปสเตอร์ระบุเงื่อนไข
// ของแต่ละโปรโมชั่นไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 151
const pageDescription =
  "รวมโปรโมชั่นของ TTN69 สล็อตออโต้เกม ทั้งแนะนำเพื่อนรับ 0.8% และคืนยอดเสีย 0.3% ดูเปอร์เซ็นต์ ยอดที่นำมาคำนวณ และรอบรับสิทธิ์ได้จากภาพโปรโมชั่นก่อนกดรับ";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น TTN69",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoReferral.src,
});
---

<MainLayout title="โปรโมชั่น TTN69 แนะนำเพื่อนรับ 0.8% และคืนยอดเสียรับ 0.3%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น TTN69" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#d5e6da]">
        หน้านี้รวมโปรโมชั่นที่ TTN69 เปิดให้สมาชิกตรวจสอบสิทธิ์และกดรับผ่านบัญชีของตนเอง ทั้งแนะนำเพื่อนรับ
        <strong class="text-[#f1faf4]">0.8%</strong> และคืนยอดเสีย <strong class="text-[#f1faf4]">0.3%</strong>
        โดยเปอร์เซ็นต์ ยอดที่นำมาคำนวณ และรอบเวลารับสิทธิ์ระบุไว้บนภาพโปรโมชั่นแต่ละใบ
        <strong class="text-[#f5b93c]">แต่ละรายการมีเงื่อนไขต่างกัน จึงควรอ่านรอบการคำนวณ ประเภทเกมที่ร่วมรายการ และเงื่อนไขล่าสุดก่อนกดรับทุกครั้ง</strong>
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อน 0.8% ของ TTN69 พื้นหลังโทนดำเขียวมรกต มีชิปคาสิโนและเหรียญทองลอยกระจาย ด้านบนกลางภาพเป็นโลโก้ TTN69 รูปทิวเขาสีขาวเหนือตัวอักษร TTN และเลข 69 บนแถบเขียว ถัดลงมาเป็นป้ายหกเหลี่ยมขอบเขียวเรืองแสงเขียนว่า โปรโมชั่น ตามด้วยข้อความ แนะนำเพื่อน สีขาว วางเหนือตัวเลข 0.8% ขนาดใหญ่สีเขียวมรกตมันวาว ด้านขวาเป็นผู้หญิงผมบลอนด์สวมชุดสีขาวสลับเขียวยกมือชี้มาที่ตัวเลข ฉากหลังเป็นตู้สล็อตขึ้นเลข 777 สีเขียว ด้านล่างเป็นป้ายสามอันพร้อมไอคอน เขียนว่า แนะนำเพื่อน รับโบนัสทันที กับ เพื่อนสมัคร รับโบนัสไปเลย และ รับโบนัสสูงสุด ไม่จำกัด ปิดท้ายด้วยแถบล่างเขียนว่า สล็อตออโต้เกม รวมแบรนด์ดัง แตกหนัก ขั้นต่ำ 1 บาท"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#046b3a]/70 object-contain shadow-[0_10px_30px_rgba(2,8,5,0.72)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#02b961]/70 hover:shadow-[0_15px_40px_rgba(2,185,97,0.35)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่นคืนยอดเสีย 0.3% ของ TTN69 พื้นหลังโทนดำเขียวมรกต มีชิปคาสิโนและเหรียญทองลอยกระจาย ด้านบนกลางภาพเป็นโลโก้ TTN69 รูปทิวเขาสีขาวเหนือตัวอักษร TTN และเลข 69 บนแถบเขียว ถัดลงมาเป็นป้ายหกเหลี่ยมขอบเขียวเรืองแสงเขียนว่า โปรโมชั่น ตามด้วยข้อความ คืนยอดเสีย สีขาว วางเหนือตัวเลข 0.3% ขนาดใหญ่สีเขียวมรกตมันวาว ด้านซ้ายเป็นตู้สล็อตขึ้นสัญลักษณ์ BAR และเลข 7 ด้านขวาเป็นผู้หญิงผมบลอนด์สวมชุดสีขาวสลับเขียวยกมือชี้มาที่ตัวเลข ด้านล่างเป็นป้ายสามอันพร้อมไอคอน เขียนว่า คืนยอดเสียทุกวัน 0.3% กับ มั่นคง ปลอดภัย เชื่อถือได้ 100% และ ระบบออโต้ รวดเร็ว ทันใจ ปิดท้ายด้วยแถบล่างเขียนว่า สล็อตออโต้เกม รวมแบรนด์ดัง แตกหนัก ขั้นต่ำ 1 บาท"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#046b3a]/70 object-contain shadow-[0_10px_30px_rgba(2,8,5,0.72)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#02b961]/70 hover:shadow-[0_15px_40px_rgba(2,185,97,0.35)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก TTN69"
          class="flex items-center justify-center rounded-lg border border-[#046b3a]/70 bg-gradient-to-r from-[#4ce68f] via-[#02b961] to-[#046b3a] px-10 py-3.5 text-lg font-black text-[#020805] shadow-[0_0_15px_rgba(2,185,97,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก TTN69
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
