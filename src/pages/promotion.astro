---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

// ดรอปอาร์ตเวิร์กของ NATO168 คือ 2026-10-02 21:20 และมีโปสเตอร์ที่ใช้ได้แค่สองใบ
// (brand-spec §4) — เปิดไฟล์จริงดูแล้วทั้งคู่ และรอบนี้ป้ายบนภาพ "สลับข้าง" กับรอบก่อน
// (ห้ามเดาจากชื่อไฟล์ และห้ามเชื่อคอมเมนต์ของรอบก่อน ต้องเปิดดูทุกครั้ง):
//   slide1.png — 600x600 ป้ายใต้หัวเรื่องอ่านว่า "แนะนำเพื่อน โบนัส 0.8%"
//                หญิงสาวชุดขาว-ทอง แบมือซ้าย มุมล่างขวามีชิป ลูกเต๋า ไพ่ กล่องของขวัญ
//   slide2.png — 600x600 ป้ายอ่านว่า "คืนยอดเสีย โบนัส 0.3%"
//                หญิงสาวชุดขาวคาดทอง แบมือขวา มุมล่างขวาเป็นชิปดำขอบทองมีตัว N
//   slide3.png / slide4.png — โปสเตอร์ของแบรนด์ก่อน (LOTTOPLUS, 29 ก.ย. เก่ากว่าดรอปนี้)
//     ห้าม import กลับมาเด็ดขาด และห้ามลบไฟล์ทิ้งเพราะเป็นอินเวนทอรีของรอบถัดไป
// ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้วและ verify-build จะแดง
// (banner2/banner3 ใน src/assets ก็เก่ากว่าดรอปนี้ = อาร์ตเวิร์กแบรนด์ก่อน ห้าม import)
// ส่วน banner1 / banner1-mobile / og.png เป็นของ MainLayout ห้าม import จากหน้านี้
// ชื่อตัวแปรตั้งตามข้อความบนภาพ ไม่ใช่ตามเลขไฟล์ เพื่อไม่ให้รอบหน้าสลับผิดอีก
import promoCashback from "../assets/slide2.png";
import promoReferral from "../assets/slide1.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้น ๆ "หนึ่งย่อหน้า ประมาณสี่บรรทัด" คือ
// โควตาตัวหนังสือทั้งหมดของหน้านี้, กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อย
// และห้ามเพิ่มย่อหน้า เพราะตัวโปสเตอร์ระบุเงื่อนไขไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว
// การพิมพ์ซ้ำด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ เป้าหมาย h1x1, h2x0, h3x0
//
// สไลด์รอบนี้เป็นจัตุรัส 600x600 จึงวางเป็นกริดสองคอลัมน์คุมความกว้างรวมที่ max-w-4xl
// (896px) ทำให้ช่องละ ~436px ไม่ต้องอัปสเกลเกินขนาดไฟล์ต้นทาง widths หยุดที่ 600 ตาม
// ความกว้างจริงของไฟล์ และคุมภาพต่อใบไว้ที่ max-w-[600px] สองใบพอดีหนึ่งแถว กริดจึง
// จัดกลางสมมาตรโดยไม่ต้องมีใบที่ span สองคอลัมน์ · เรียงคืนยอดเสีย ก่อนแนะนำเพื่อน
// ตามลำดับของบรีฟ (docx #4 แล้วค่อย #5)
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ (รอบก่อน NAZA99 ใช้
// AnnouncementPremium) — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ
// NATO168 แล้ว และ index ก็เรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop message มิฉะนั้น
// ตัววิ่งจะพูดคนละเรื่องกันระหว่างหน้าแรกกับหน้านี้
//
// พาเลตต์ NATO168 (brand-spec §2) ทอง-เงิน-ดำ สองโทนจริง ไม่ใช่ทองล้วน: ทองอ่อน
// #fde8a8 · ทองแบรนด์ #edb543 · ทองลึก #a9761f · เงิน #e6e6e6 (แอ็กเซนต์รอง) ·
// ผิวการ์ด #101010 · ผิวอุ่น #17120a · ดำพื้น #070707 · หมึกบนพื้นทอง #1a1203 ·
// เนื้อความ #f4ead3 (BRAND_TEXT มาจาก <html> อยู่แล้ว จึงไม่ต้องระบุสีที่ย่อหน้า)
// เรืองแสง: ทอง rgba(237,181,67,α) · เงิน rgba(230,230,230,α) · เงา rgba(4,3,0,α)
// การ์ดโปสเตอร์ได้ขอบทองแบรนด์ #edb543 และยกเป็นเงิน #e6e6e6 ตอน hover เพราะ
// เวิร์ดมาร์กบนภาพเป็นเงินคู่ทอง การยกเป็นทองซ้ำจะทำให้ไม่เห็นฮิวที่สองเลย ·
// ปุ่ม CTA ไล่เฉดทอง #fde8a8 → #edb543 → #a9761f ใช้หมึกเข้ม #1a1203
// ห้ามวางตัวอักษรสีอ่อนบนพื้นทอง
// ชุดทองล้วนของ NAZA99 (#fdf2ac #e4b34d #c08f2b #8a5f12 #140c02 #241404 #0a0501
// #1a1000 #f3e8cf rgba(228,179,77,*) rgba(253,242,172,*) rgba(10,5,1,*)) ถูกแทนครบ
// ทุกจุดแล้ว ทั้งคลาส Tailwind raw hex และ rgba()
//
// NATO168 เป็นเว็บ "สล็อตออนไลน์ / พีจีเว็บตรง" ไม่ใช่หวย ไม่ใช่บอล และไม่ใช่
// คาสิโนสด — คำว่า หวย โพย งวด เลขเด็ด อัตราจ่าย ฮานอย บอล ค่าน้ำ ลีก คาสิโนสด
// บาคาร่า ห้ามปรากฏบนหน้านี้ ตัวเลขที่บรีฟระบุและใช้ได้มีแค่ 0.3% · 0.8% ·
// 3 ขั้นตอน · 24 ชั่วโมง ห้ามเพิ่มชื่อผู้ให้บริการ ชื่อธนาคาร ยอดฝากขั้นต่ำ
// เลขใบอนุญาต จำนวนสมาชิก หรือปีที่ก่อตั้ง และต้องคง hedge ของบรีฟไว้ว่าแต่ละรายการ
// อาจมีเงื่อนไขเรื่องค่ายเกม รอบคำนวณ หรือยอดที่นำมาคิดโบนัสต่างกัน
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 152
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `รวมโปรโมชั่นสล็อต ${BRAND_NAME} ทั้งคืนยอดเสีย โบนัส 0.3% และแนะนำเพื่อน โบนัส 0.8% แต่ละรายการอาจกำหนดค่ายเกมและเงื่อนไขแตกต่างกัน ควรอ่านรายละเอียดก่อนกดรับ`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่นสล็อต ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});
---

<MainLayout title={`โปรโมชั่นสล็อต ${BRAND_NAME} คืนยอดเสีย โบนัส 0.3% แนะนำเพื่อน โบนัส 0.8%`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`โปรโมชั่นสล็อต ${BRAND_NAME}`} as="h1">
    <div class="flex flex-col gap-10">
      <p class="text-left text-base leading-relaxed">
        หน้านี้รวมภาพโปรโมชั่นที่ <strong class="text-[#fde8a8]">{BRAND_NAME}</strong> เปิดให้สมาชิกตรวจสอบก่อนเลือกรับสิทธิ์ โดยรายละเอียดของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว ทั้งโบนัสคืนยอดเสียและโบนัสแนะนำเพื่อน
        สามารถ Login เพื่อตรวจสอบยอดที่เข้าเกณฑ์ รอบคำนวณ และจำนวนโบนัสที่มีสิทธิ์รับจากบัญชีสมาชิกได้โดยตรง <strong class="text-[#fde8a8]">แต่ละรายการอาจมีเงื่อนไขเรื่องค่ายเกม รอบคำนวณ หรือยอดที่นำมาคิดโบนัสต่างกัน</strong> จึงควรตรวจสอบรายละเอียดก่อนกดรับทุกครั้ง
      </p>

      <div class="mx-auto grid w-full max-w-4xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่นของ NATO168 พื้นดำมีผ้าซาตินทองและเหรียญทองลอยเป็นฉากหลัง ด้านซ้ายเป็นหญิงสาวผมยาวสวมชุดสีขาวคาดแถบทอง แบมือขวาหงายขึ้นมาข้างหน้า ด้านบนขวาเป็นโลโก้ตัวอักษร NATO สีเงินคู่กับเลข 168 สีทองและสัญลักษณ์ตัว N ในวงกลม ถัดลงมาเป็นตัวอักษรไทยสีทองขนาดใหญ่มีเงาว่า โปรโมชั่น ใต้ลงมาเป็นป้ายสีดำขอบทองคาดข้อความ คืนยอดเสีย โบนัส และตัวเลขทองสามมิติขนาดใหญ่ 0.3% มุมล่างขวาเป็นชิปสีดำขอบทองที่มีตัว N อยู่กลางชิป"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), (max-width: 1007px) calc((100vw - 136px) / 2), 436px"
          class="mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#edb543]/60 object-contain shadow-[0_10px_30px_rgba(4,3,0,0.85)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#e6e6e6]/85 hover:shadow-[0_15px_40px_rgba(237,181,67,0.40)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่นของ NATO168 ชุดเดียวกัน พื้นดำมีผ้าซาตินทองและเหรียญทองลอยเต็มภาพ ด้านซ้ายเป็นหญิงสาวผมยาวสวมชุดสีขาว-ทองและต่างหูทองยาว แบมือซ้ายหงายขึ้นมาข้างหน้า ด้านบนเป็นโลโก้ตัวอักษร NATO สีเงินคู่กับเลข 168 สีทอง ถัดลงมาเป็นตัวอักษรไทยสีทองขนาดใหญ่ว่า โปรโมชั่น ใต้ลงมาเป็นข้อความ แนะนำเพื่อน โบนัส และตัวเลขทองสามมิติขนาดใหญ่ 0.8% มุมล่างขวาเป็นกองชิปคาสิโน ลูกเต๋า ไพ่ และกล่องของขวัญ"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), (max-width: 1007px) calc((100vw - 136px) / 2), 436px"
          class="mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#edb543]/60 object-contain shadow-[0_10px_30px_rgba(4,3,0,0.85)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#e6e6e6]/85 hover:shadow-[0_15px_40px_rgba(237,181,67,0.40)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#a9761f] bg-gradient-to-r from-[#fde8a8] via-[#edb543] to-[#a9761f] px-10 py-3.5 text-lg font-black text-[#1a1203] shadow-[0_0_15px_rgba(237,181,67,0.40)] transition-transform hover:scale-105">
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
