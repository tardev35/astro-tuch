---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";

import { Picture } from "astro:assets";

// ดรอปนี้ (2026-10-27, brand-spec §6) มีสไลด์ที่เป็นของแบรนด์นี้ **สองใบ**
// และชื่อตัวแปรตั้งตามข้อความที่พิมพ์อยู่บนภาพจริง (เปิดบิตแมปอ่านเองแล้วรอบนี้)
// ไม่ใช่ตามเลขไฟล์ — ถ้ารอบหน้าเจอความขัดแย้ง **ให้เชื่อข้อความบนรูป**:
//   slide1.png (mtime 2026-10-27, ดรอปนี้) — โปสเตอร์ "โปรโมชั่น / คืนยอดเสีย / 0.3%"
//   slide2.png (mtime 2026-10-27, ดรอปนี้) — โปสเตอร์ "โปรโมชั่น / แนะนำเพื่อน / 0.8%"
//   สไลด์ใบที่สามและสี่ (mtime 2026-09-29 = คนละดรอป คนละแบรนด์) — **ห้าม import**
//   แบนเนอร์ใบที่สองและสาม (mtime 2026-10-23 = อาร์ตเวิร์กของอีกแบรนด์) —
//     **ห้าม import** รอบนี้ไม่มี "รูปประกอบบทความ" เลย
//   (ชื่อไฟล์เต็มของทั้งสี่อยู่ใน brand-spec §6 — ไม่พิมพ์ที่นี่ เพื่อให้ grep หา
//    การ import ที่หลงเหลือได้คำตอบว่างจริงๆ)
// ⚠️⚠️ uploader เขียนทับ slide1/slide2 ทุกครั้ง **เลขไฟล์จึงไม่มีความหมายข้ามแบรนด์**
// ต้องเปิดบิตแมปดูทุกรอบ ห้ามสืบทอดการจับคู่ของรอบก่อน และห้ามเชื่อคอมเมนต์เก่า
// ⚠️ eager import = emit ลง dist/ ต่อให้ไม่ได้ render และ verify-build จะแดง
// การ import ไฟล์เก่าคือการส่งรูปของลูกค้ารายอื่นขึ้นเว็บนี้
// **ห้ามลบไฟล์เก่าทิ้ง** — เป็นอินเวนทอรีของรอบถัดไป แค่ห้าม import
// (banner1 / banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักชื่อไว้เอง —
// ห้ามอ้างจากหน้านี้) รอบนี้หน้านี้จึงมีเฉพาะสไลด์สองใบ กริดจึงเป็นสองช่อง
import promoCashback from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้นๆ ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมด
// ของหน้านี้, กริดภาพโปรโมชั่น, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อยและห้ามเพิ่มย่อหน้า
// เพราะโปสเตอร์ระบุชื่อรายการและเปอร์เซ็นต์ของตัวเองด้วยตัวอักษรขนาดใหญ่อยู่แล้ว
// การพิมพ์ซ้ำด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่
//
// 🚨🚨 **บรีฟรอบนี้ (src/assets/content.txt) ไม่มีหมวดโปรโมชั่นเลยสักบรรทัด** —
// เป็นเว็บหวย ไม่ใช่เว็บสล็อตแบบรอบก่อน หัวข้อย่อยกับย่อหน้าชุด "คืนยอดเสีย/
// แนะนำเพื่อน" ที่เคยอยู่บนหน้านี้เป็นคอปปี้ที่รีแบรนด์รอบก่อน (ZNOVA168) แต่งเอง
// **ถูกลบทิ้งทั้งหมดรอบนี้** เหลือย่อหน้าเกริ่นเดียวที่พูดกว้างๆ ว่าหน้านี้รวมอะไร
// 🚨🚨 **0.3% / 0.8% พิมพ์อยู่บนอาร์ตเวิร์กจริง จึงเขียนได้เฉพาะใน alt เท่านั้น**
// ห้ามอยู่ใน title / description / intro / หัวข้อ (brand-spec §5)
// และ intro ห้ามระบุตัวเลขและห้ามให้คำมั่นใดๆ
//
// ลำดับในกริด: slide1 (คืนยอดเสีย) ก่อน slide2 (แนะนำเพื่อน) ตามลำดับเลขไฟล์ของดรอป
// ⚠️⚠️ **บิตแมปจริงของดรอปนี้คือ 375x600 แนวตั้ง** (วัดจาก IHDR ของไฟล์เองรอบนี้)
// ความกว้างสูงสุดคือ 375 widths จึงหยุดที่ 375 และคุมที่ max-w-[375px]
// **ให้วัดใหม่ทุกรอบจากไฟล์จริง อย่าเชื่อสัดส่วนของรอบก่อน และห้ามขยายเกินต้นฉบับ**
// sizes คิดจากความกว้างที่ถูกวาดจริง: section px-4 (16px/ข้าง) + การ์ด p-8
// (32px/ข้าง, เป็น p-10 = 40px ที่ md ขึ้นไป) + gap-6 ระหว่างคอลัมน์ (24px)
//   ใต้ 640px = คอลัมน์เดียว → 100vw-96px
//   640-767px = สองคอลัมน์ p-8 → 50vw-60px
//   768-885px = สองคอลัมน์ p-10 → 50vw-68px
//   ตั้งแต่ 886px ขึ้นไปชนเพดาน 375px
// LCP คือ hero ใน MainLayout ไม่ใช่รูปพวกนี้ จึง loading="lazy" fetchpriority="low"
// decoding="async" และ quality ตัวเดียวทั้ง avif/webp — ห้ามจูนแยกฟอร์แมต
// (tools/avif-quality-service.mjs ย่อฝั่ง avif ให้เองที่ x0.65)
//
// quality={64} ไม่ใช่ 80 ตามปกติ: สไลด์ทั้งสองเป็นภาพถ่ายคนในฉากห้องสว่างอิ่มสี บวก
// ตัวอักษรไทยสามมิติผิวมันเงาตัดขอบทองที่มีไฮไลต์และขอบคมทับอยู่ด้านบน ซึ่งเป็นเคสที่
// AVIF ทำได้แย่ที่สุด ที่ quality=80 ไฟล์ AVIF มีโอกาสออกมา **ใหญ่กว่า** WebP ที่เป็น
// fallback ของตัวเอง เบราว์เซอร์ที่รองรับ AVIF จะหยิบไฟล์ที่หนักกว่าไปใช้ และ
// verify-build.mjs ทำให้ build แดงด้วยเหตุนี้ตรงๆ · ทางแก้คือ quality ที่ **ต่ำลง**
// ไม่ใช่สูงขึ้น · ค่าเดียวกันนี้ต้องใช้ที่ index.astro กับสไลด์ใบเดียวกัน
//
// Announcement รอบนี้หมุนมาเป็น AnnouncementHuay ทั้งเว็บ (brand-spec §3 — รอบก่อนใช้
// Announcement2 จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้น
// เป็นคอปปี้ของแบรนด์นี้ไว้แล้ว และทุกหน้าเรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop
// message มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกันระหว่างหน้า
//
// ───────────────────────────────────────────────────────────────────────────
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) **เนื้อหาเป็นผิวสว่าง โครมเป็นผิวเข้ม**
// bg.json ของดรอปนี้คือ {"mode":"color","color":"#fff0f0"} = **ขาวอมชมพูจาง**
// (รอบก่อนเป็นครีมอมงาช้างอุ่น คนละค่า — อ่านจากไฟล์ทุกรอบ ห้ามเดา)
// **ห้าม "แก้" การ์ดกลับไปเป็นพื้นมืด** การ์ดมืดบนหมึก #25090f = ตัวอักษรหายไปเลย
// ลำดับผิว: พื้นเพจ #fff0f0 / การ์ด #ffffff (ContentBox) / ผิวยก #ffe4e6 /
// wash #ffd4d7 · เส้นอ่อน #f5b9bd · เส้นเข้ม #a8333f (**ทั้งคู่ห้ามถือตัวอักษร**)
// หมึก #25090f = เนื้อความ (= BRAND_TEXT ที่ <html> และการ์ด ContentBox ตั้งให้แล้ว
// 18.7:1 บนการ์ดขาว) · หมึกรอง #6e3b44 (8.8:1)
// แดงเลือดนก #b00718 = สีของ <strong> ในเนื้อความ (7.3:1 บนการ์ดขาว) และหัวข้อ
// 🚨🚨 **#ff2436 บนพื้นขาวได้แค่ 3.9:1 และ #e9b53c ได้ 2.0:1 ห้ามเป็นสีตัวอักษร**
// สองค่านั้นเป็นไฮไลต์ของ **โครมเข้ม** เท่านั้น
// ปุ่ม CTA ของหน้านี้เป็น **PRIMARY = ไล่เฉดแดง** #8a0412 → #b00718 → #d61023
// บนหมึก **ขาว #ffffff** (10.4 / 7.3 / 5.3:1 ต่อ stop) ตรงกับปุ่มสมัครสมาชิก
// ที่ /contact-us /ทางเข้า /register
// แผ่นไฮไลต์ด้านบนปุ่มจำกัดที่ white/10
// rgba() ที่อนุญาตรอบนี้: rgba(138,4,18,α) · rgba(176,7,24,α) · rgba(193,7,27,α) ·
// rgba(214,16,35,α) · rgba(37,9,15,α) · rgba(245,185,189,α)
// ⚠️⚠️ **รอบนี้ไม่มีม่วง/ฟ้า/ไซแอน/แมเจนต้า/ส้มเพลิง/เขียวแบรนด์เลยสักเฉด**
// ⚠️⚠️ กับดักที่แหลมที่สุดรอบนี้คือ **แดง/ทอง/ครีมของแบรนด์อื่น** ซึ่งเป็นตระกูล
// เดียวกับรอบนี้เป๊ะ (MEXICANOSLOT สามรอบก่อน · ZNOVA168 รอบก่อน)
// ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน brand-spec §2 ห้ามตัดสินด้วยสายตา
// · สูทขาว เก้าอี้อาร์มแชร์ขอบทอง ลูกบอลหวย และสีผิวนักแสดงในอาร์ตเวิร์กเป็น
// **วัตถุในภาพ ไม่ใช่สี UI** · และ **เวิร์ดมาร์กโครเมียมเงินตัดขอบแดงก็เป็น
// อาร์ตเวิร์ก ไม่ใช่สี UI**
// · <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ
// ถ้าเปิด/ปิดกลางคำ บรรทัดจะตัดกลางคำ
//
// ⚠️ แกนของแบรนด์รอบนี้คือ **เว็บหวยลอตโต้ แทงหวยออนไลน์ทุกประเภท**
// คำนิยามตัวเองของแบรนด์ก่อนๆ ห้ามเหลือ โดยเฉพาะศัพท์หมวดสล็อตทั้งชุด
// (brand-spec §5 ไม่พิมพ์ซ้ำที่นี่)
// 🚨 **บรีฟรอบนี้ไม่พูดถึงธนาคาร วอลเลท หรือการฝากถอนเลยแม้แต่คำเดียว**
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 2 ตัว 100 · 3 ตัว 1,000 · 3 ขั้นตอน · 24ชม.
// **และหน้านี้ไม่หยิบมาใช้เลยสักตัว** เพราะ intro ต้องพูดกว้างๆ ไม่ระบุตัวเลข
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -c บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงนี้ยาว 153 ด้วยชื่อแบรนด์ 8 อักขระของรอบนี้
// (รอบก่อนชื่อยาว 8 เท่ากันพอดี แต่ **ต้องนับใหม่ทุกรอบ** ห้ามสืบทอดความยาว)
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `รวมภาพโปรโมชั่น ${BRAND_NAME} เว็บหวยลอตโต้ หวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยหุ้นต่างประเทศ แต่ละรายการมีเงื่อนไขต่างกัน ควรตรวจสอบประกาศล่าสุดก่อนรับสิทธิ์`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่น ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});

// ความกว้างที่ถูกวาดจริงของแต่ละคอลัมน์ในกริดสองคอลัมน์ (ดูคอมเมนต์ sizes ด้านบน)
const promoSizes = "(max-width: 639px) calc(100vw - 96px), (max-width: 767px) calc(50vw - 60px), (max-width: 885px) calc(50vw - 68px), 375px";

const promoClass =
  "mx-auto h-auto w-full max-w-[375px] rounded-xl border border-[#f5b9bd] object-contain shadow-[0_8px_28px_rgba(138,4,18,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#a8333f] hover:shadow-[0_12px_40px_rgba(176,7,24,0.3)]";

// alt ทั้งสองเขียนจากบิตแมปของดรอปนี้ที่เปิดอ่านเองแล้ว (**375x600 แนวตั้ง** ทั้งคู่) —
// ฉากห้องสีขาวครีม หญิงสาวผมยาวสีน้ำตาลเข้มสวมสูทขาว โต๊ะที่มีโพยหวยกองอยู่
// ลูกบอลหวยสีขาวพิมพ์ตัวเลข · ตัวอักษรไทยสามมิติแดงตัดขอบทองว่า โปรโมชั่น ·
// ชื่อรายการตัวขาวบนแถบแดง · ตัวเลขเปอร์เซ็นต์ตัวโตแดงตัดขอบขาว ·
// แคปซูลแดงเข้มขอบทองท้ายภาพเขียนว่า สมัครสมาชิก พร้อมไอคอนคนและลูกศรคู่
// ⚠️ alt คือ "ข้อความที่พิมพ์อยู่บนโปสเตอร์" เป็นหลัก — ตัวเลขท้าย alt ต้องตรงกับรูป
// และนี่คือ **ที่เดียวของหน้านี้ที่ 0.3% / 0.8% เขียนได้**
// ⚠️ ห้ามเรียกรูปคู่นี้ว่าภาพแนวนอนหรือภาพสี่เหลี่ยมจัตุรัส รอบนี้เป็น **แนวตั้ง**
// ⚠️ จุดที่ **ต่างกันจริงระหว่างสองใบ** และต้องเขียนให้ตรง (ตรวจจากบิตแมปรอบนี้):
//   slide1 (คืนยอดเสีย 0.3%) ผู้หญิงนั่งเอนพิงพนัก **ยกมือขึ้นแตะข้างศีรษะ** ·
//     ลูกบอลหวยพิมพ์เลข **9 6 8 1** · มี **มงกุฎทองเล็ก** อยู่เหนือคำว่า โปรโมชั่น
//   slide2 (แนะนำเพื่อน 0.8%) ผู้หญิง **วางแขนบนโต๊ะที่มีโพยหวยกางอยู่** ·
//     ลูกบอลหวยพิมพ์เลข **6 8 9** · ไม่มีมงกุฎเหนือตัวอักษร
// ⚠️ ห้ามระบุว่าใช้มือซ้ายหรือมือขวา — รอบก่อนๆ เขียนไว้แล้วผิดหลายรอบติด
// ⚠️ สีของวัตถุในรูป (สูทขาว เก้าอี้ขอบทอง ลูกบอลหวย) เป็นวัตถุในภาพ ไม่ใช่สีของแบรนด์
// ⚠️ องค์ประกอบของอาร์ตเวิร์กแบรนด์ก่อนๆ ที่ต้องไม่หลงเหลือใน alt อยู่ครบใน
// brand-spec §5 (ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive)
const altCashback = `โปสเตอร์โปรโมชั่นแนวตั้ง มุมบนซ้ายเป็นโลโก้ ${BRAND_NAME} แบบเวิร์ดมาร์กสามมิติ ครึ่งแรกเป็นตัวอักษรละตินผิวโครเมียมเงินขัดเงาตัดขอบแดง ต่อด้วยตัวเลขผิวแดงเลือดนกเคลือบเงา กลางภาพเป็นหญิงสาวผมยาวสีน้ำตาลเข้ม สวมสูทขาว นั่งเอนบนเก้าอี้อาร์มแชร์สีขาวขอบทอง หน้าโต๊ะที่มีโพยหวยกองอยู่ ขนาบด้วยลูกบอลหวยสีขาวพิมพ์เลข 9 6 8 และ 1 ครึ่งล่างเป็นตัวอักษรไทยสามมิติสีแดงตัดขอบทองอ่านว่า โปรโมชั่น มีมงกุฎทองเล็กอยู่เหนือตัวอักษร ใต้ลงมาเป็นคำว่า คืนยอดเสีย ตัวขาวบนแถบแดง แล้วตัวเลข 0.3% ตัวโตสีแดงตัดขอบขาว ปิดท้ายด้วยแคปซูลสีแดงเข้มขอบทองเขียนว่า สมัครสมาชิก พร้อมไอคอนรูปคนและลูกศรคู่`;

const altReferral = `โปสเตอร์โปรโมชั่นแนวตั้ง มุมบนซ้ายเป็นโลโก้ ${BRAND_NAME} แบบเวิร์ดมาร์กสามมิติ ครึ่งแรกเป็นตัวอักษรละตินผิวโครเมียมเงินขัดเงาตัดขอบแดง ต่อด้วยตัวเลขผิวแดงเลือดนกเคลือบเงา กลางภาพเป็นหญิงสาวผมยาวสีน้ำตาลเข้ม สวมสูทขาว นั่งบนเก้าอี้อาร์มแชร์สีขาวขอบทองและวางแขนบนโต๊ะที่มีโพยหวยกางอยู่ ขนาบด้วยลูกบอลหวยสีขาวพิมพ์เลข 6 8 และ 9 ครึ่งล่างเป็นตัวอักษรไทยสามมิติสีแดงตัดขอบทองอ่านว่า โปรโมชั่น ใต้ลงมาเป็นคำว่า แนะนำเพื่อน ตัวขาวบนแถบแดง แล้วตัวเลข 0.8% ตัวโตสีแดงตัดขอบขาว ปิดท้ายด้วยแคปซูลสีแดงเข้มขอบทองเขียนว่า สมัครสมาชิก พร้อมไอคอนรูปคนและลูกศรคู่`;
---

<MainLayout title={`รวมภาพโปรโมชั่น ${BRAND_NAME} เว็บหวยลอตโต้ แทงหวยออนไลน์ทุกประเภท`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`รวมภาพโปรโมชั่น ${BRAND_NAME} เว็บหวยลอตโต้`} as="h1">
    <div class="flex flex-col gap-10">
      <p>
        หน้านี้รวมภาพรายการโปรโมชั่นของ {BRAND_NAME} ไว้ในที่เดียว โดยชื่อรายการและรายละเอียดของแต่ละรายการพิมพ์อยู่บนภาพแล้ว ทั้งนี้
        <strong class="text-[#b00718]">แต่ละรายการมีเงื่อนไขการเข้าร่วมและรอบรับสิทธิ์แตกต่างกัน จึงควรตรวจสอบประกาศล่าสุดจากเว็บไซต์ทางการให้ครบถ้วนก่อนรับสิทธิ์ทุกครั้ง</strong>
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt={altCashback}
          loading="lazy"
          fetchpriority="low"
          widths={[250, 375]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />

        <Picture
          src={promoReferral}
          alt={altReferral}
          loading="lazy"
          fetchpriority="low"
          widths={[250, 375]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="relative isolate flex items-center justify-center overflow-hidden rounded-lg border border-[#8a0412] bg-gradient-to-b from-[#8a0412] via-[#b00718] to-[#d61023] px-10 py-3.5 text-lg font-black text-white shadow-[0_8px_22px_rgba(138,4,18,0.35)] transition-transform hover:scale-105">
          <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-white/10 to-transparent"></span>
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
