---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

// เฉพาะ slide1/slide2 (ลงวันที่ 2026-09-17) เท่านั้นที่เป็นอาร์ตเวิร์กของ PAOTUNG —
// ตรวจจากตัวภาพจริงแล้ว: slide1 คือโปสเตอร์ "คืนยอดเสีย 0.3%" ส่วน slide2 คือ
// "แนะนำเพื่อน 0.8%" — สลับกับลำดับของแบรนด์ก่อนหน้า อย่าคัดลอกลำดับ import เดิม
// slide3/slide4 (2026-08-13) กับ banner2/banner3 ยังค้างอยู่บนดิสก์แต่เป็นอาร์ตเวิร์ก
// ของลูกค้าเจ้าอื่น — ห้าม import ที่นี่ทั้งรอบนี้และรอบถัดไป
// (ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้ว)
import promoReferral from "../assets/slide2.png";
import promoCashback from "../assets/slide1.png";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็น IMAGE page: ContentBox title, ย่อหน้าเกริ่นสั้น ๆ หนึ่งย่อหน้า, กริดโปสเตอร์,
// ปุ่ม CTA หนึ่งปุ่ม — ไม่มีหัวข้อย่อยและไม่มีย่อหน้าเพิ่ม เพราะตัวโปสเตอร์ระบุเงื่อนไข
// ของแต่ละโปรโมชั่นไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว เป้าหมาย h1×1, h2×0, h3×0
// ลำดับในกริดตามบรีฟ: แนะนำเพื่อน 0.8% มาก่อน คืนยอดเสีย 0.3%
//
// Announcement รอบนี้หมุนมาใช้ Announcement5 ทั้งเว็บ — default message ของไฟล์นั้น
// เป็นข้อความของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ได้
//
// พาเลตต์ PAOTUNG: น้ำเงินโลโก้ #226ca9 นำ (ขอบ/เงา) ทองเมทัลลิค #e0bd72 เป็นสีรอง
// ใช้กับปุ่มสมัครและไฮไลต์ในเนื้อความ ไม่มีสีแดงในแบรนด์นี้
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 156
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "รวมโปรโมชั่นของ PAOTUNG ทั้งแนะนำเพื่อนรับ 0.8% และคืนยอดเสีย 0.3% แจกทุกยูสเซอร์ด้วยระบบอัตโนมัติ ไม่มีล็อคยูส ดูเงื่อนไขและวิธีรับสิทธิ์ได้จากภาพโปรโมชั่น";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น PAOTUNG",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoReferral.src,
});
---

<MainLayout title="โปรโมชั่น PAOTUNG แนะนำเพื่อนรับ 0.8% และคืนยอดเสียรับ 0.3%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น PAOTUNG" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#cfdeed]">
        หน้านี้รวมโปรโมชั่นที่ PAOTUNG แจกให้ทุกยูสเซอร์ผ่านระบบอัตโนมัติ 100% แบบไม่มีการล็อคยูส ทั้งแนะนำเพื่อนรับ
        <strong class="text-[#f5e3b3]">0.8%</strong> และคืนยอดเสีย <strong class="text-[#f5e3b3]">0.3%</strong>
        โดยเปอร์เซ็นต์ ยอดที่นำมาคำนวณ และวิธีกดรับสิทธิ์ระบุไว้บนภาพโปรโมชั่นแต่ละใบ
        <strong class="text-[#7fc4f0]">แต่ละรายการมีเงื่อนไขต่างกัน จึงควรอ่านรอบการคำนวณและเงื่อนไขล่าสุดก่อนกดรับทุกครั้ง</strong>
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อน 0.8% พื้นหลังสีขาวตัดกับแถบลูกศรสีน้ำเงินสด ด้านบนเป็นโลโก้ถุงเงินที่มีเครื่องหมายดอลลาร์และลูกศรชี้ขึ้น ใต้โลโก้เขียนว่า PAOTUNG DIGITAL WALLET ตรงกลางเป็นข้อความ โปรโมชั่น แนะนำเพื่อน สีน้ำเงินกรมท่า ต่อด้วยตัวเลข 0.8% พร้อมไอคอนคนสองคนและลูกศรส่งต่อคั่นอยู่ มีเหรียญทองดอลลาร์ลอยกระจายรอบข้อความ ด้านขวาเป็นหญิงสาวในสูทสีกรมท่ากางมือทั้งสองข้างเชิญไปทางข้อความ"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#054e83]/70 object-contain shadow-[0_10px_30px_rgba(2,15,30,0.75)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#226ca9]/75 hover:shadow-[0_15px_40px_rgba(34,108,169,0.35)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่นคืนยอดเสีย 0.3% พื้นหลังสีฟ้าอ่อนมีลายกระเป๋าเงินโปร่งแสง วงแหวนกราฟิกและคำว่า BLOCKCHAIN มุมซ้ายบนเป็นโลโก้ถุงเงินที่มีเครื่องหมายดอลลาร์และลูกศรชี้ขึ้น ใต้โลโก้เขียนว่า PAOTUNG DIGITAL WALLET ด้านซ้ายเป็นข้อความ โปรโมชั่นพิเศษ! คืนยอดเสีย 0.3% ตัวอักษรสีขาว และบรรทัดล่างเขียนว่า สำหรับทุกยอดการใช้งาน มีเหรียญดอลลาร์สีฟ้าลอยอยู่รอบข้อความ ด้านขวาเป็นหญิงสาวในเบลเซอร์สีกรมท่ายื่นมือขวาแบไปทางข้อความ"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#054e83]/70 object-contain shadow-[0_10px_30px_rgba(2,15,30,0.75)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#226ca9]/75 hover:shadow-[0_15px_40px_rgba(34,108,169,0.35)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก PAOTUNG"
          class="flex items-center justify-center rounded-lg border border-[#e0bd72]/70 bg-gradient-to-r from-[#f5e3b3] via-[#e0bd72] to-[#a5813a] px-10 py-3.5 text-lg font-black text-[#020f1e] shadow-[0_0_15px_rgba(224,189,114,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก PAOTUNG
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
