---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

// ดรอปรอบนี้ (2026-10-20, brand-spec §5) มีสไลด์ที่ใช้ได้ **สองใบ** และชื่อตัวแปร
// ตั้งตามข้อความที่พิมพ์อยู่บนภาพจริง (เปิดบิตแมปอ่านเองแล้วรอบนี้) ไม่ใช่ตามเลขไฟล์ —
// ถ้ารอบหน้าเจอความขัดแย้ง **ให้เชื่อข้อความบนรูป**:
//   slide2.png — โปสเตอร์ "โปรโมชั่น / คืนยอดเสีย 0.3%"
//   slide1.png — โปสเตอร์ "โปรโมชั่น / แนะนำเพื่อน 0.8%"
//   slide3.png / slide4.png (mtime 2026-09-29) — โปสเตอร์หวยของ LOTTOPLUS ซึ่งเป็น
//     แบรนด์คนละรายโดยสิ้นเชิง **ห้าม import** (ถอดออกไปหลายรอบแล้ว อย่าดึงกลับ)
// ⚠️ การจับคู่พลิกไปมาระหว่างดรอป (รอบ รวยแทร่168 เคยเป็น slide1 = คืนยอดเสีย)
// จึงห้ามเชื่อการจับคู่ของรอบก่อน ต้องเปิดบิตแมปดูทุกรอบ
// ⚠️ eager import = emit ลง dist/ ต่อให้ไม่ได้ render และ verify-build จะแดง
// การ import ไฟล์เก่าคือการส่งรูปของลูกค้ารายอื่นขึ้นเว็บนี้
// **ห้ามลบไฟล์เก่าทิ้ง** — เป็นอินเวนทอรีของรอบถัดไป แค่ห้าม import
// (banner2 / banner3 ก็เช่นกัน ส่วน banner1 / banner1-mobile / og.png เป็นของ glob
// ที่ MainLayout ปักชื่อไว้เอง — ห้ามอ้างจากหน้านี้) รอบนี้จึงไม่มี article illustration
import promoCashback from "../assets/slide2.png";
import promoReferral from "../assets/slide1.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้นๆ ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมด
// ของหน้านี้, กริดภาพโปรโมชั่น, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อยและห้ามเพิ่มย่อหน้า
// เพราะโปสเตอร์ระบุเปอร์เซ็นต์ของตัวเองด้วยตัวอักษรขนาดใหญ่อยู่แล้ว การพิมพ์ซ้ำ
// ด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ บรีฟรอบนี้ (src/assets/content.txt)
// ไม่มีส่วน SUB-PAGES เลย (จบที่บรรทัด 29) ย่อหน้าทุกย่อหน้าที่เคยอยู่บนหน้านี้จึงเป็น
// ของที่รีแบรนด์รอบก่อนๆ แต่งขึ้นเอง — รอบนี้คงไว้เพียงย่อหน้าเกริ่นเดียว และเขียนขึ้นใหม่
// จากบรีฟ (content.txt บรรทัด 7-12) ไม่ใช่ find-and-replace ทับประโยคของรอบก่อน
//
// ลำดับในกริดตามลำดับของบรีฟ: คืนยอดเสีย 0.3% (บรรทัด 9-10) มาก่อน แนะนำเพื่อน 0.8%
// (บรรทัด 11-12)
// ⚠️ บิตแมปจริงของดรอปนี้วัดได้ **600x334** ไม่ใช่ 600x600 อย่างที่ brand-spec §5
// เขียนไว้ (วัดด้วย header ของ PNG เอง) — ความกว้างสูงสุดยังเป็น 600 เท่าเดิม
// widths จึงหยุดที่ 600 และคุมที่ max-w-[600px] ตามสเปก แต่สัดส่วนเป็นแนวนอน
// ไม่ใช่จัตุรัส **ให้วัดใหม่ทุกรอบ อย่าเชื่อสัดส่วนของรอบก่อน**
// sizes คิดจากความกว้างที่ถูกวาดจริง: section px-4 (16px/ข้าง) + การ์ด p-8
// (32px/ข้าง, เป็น p-10 = 40px ที่ md ขึ้นไป) + gap-6 ระหว่างคอลัมน์ (24px)
//   ใต้ 640px = คอลัมน์เดียว → 100vw-96px
//   640-767px = สองคอลัมน์ p-8 → 50vw-60px
//   768-1335px = สองคอลัมน์ p-10 → 50vw-68px
//   ตั้งแต่ 1336px ขึ้นไปชนเพดาน 600px
// LCP คือ hero ใน MainLayout ไม่ใช่รูปพวกนี้ จึง loading="lazy" fetchpriority="low"
// decoding="async" และ quality ตัวเดียวทั้ง avif/webp — ห้ามจูนแยกฟอร์แมต
// (tools/avif-quality-service.mjs ย่อฝั่ง avif ให้เองที่ x0.65)
//
// quality={64} ไม่ใช่ 80 ตามปกติ และเป็นค่าที่ "วัดมา" ไม่ใช่ค่าที่ชอบ: สไลด์ทั้งสองเป็น
// อาร์ตเกรนละเอียด (เหรียญทองกองโต ประกาย ผ้าซาติน ผิวคน ตัวอักษรไล่เฉดสามมิติ)
// ซึ่งเป็นเคสที่ AVIF ทำได้แย่ที่สุด ที่ quality=80 ไฟล์ AVIF ออกมา **ใหญ่กว่า** WebP
// ที่เป็น fallback ของตัวเอง เบราว์เซอร์ที่รองรับ AVIF จะหยิบไฟล์ที่หนักกว่าไปใช้ และ
// verify-build.mjs ทำให้ build แดงด้วยเหตุนี้ตรงๆ · ทางแก้คือ quality ที่ **ต่ำลง**
// ไม่ใช่สูงขึ้น ค่าเดียวกันนี้ใช้ที่ index.astro กับสไลด์คู่เดียวกัน
//
// Announcement รอบนี้หมุนมาเป็น Announcement5 ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ Announcement3 จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้น
// เป็นคอปปี้ของแบรนด์นี้ไว้แล้ว และทุกหน้าเรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop
// message มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกันระหว่างหน้า
//
// พาเลตต์รอบนี้ (brand-spec §2) = **ทองน้ำผึ้งนำ + แดงชาดจีนรอง บนพื้นดำสนิท**
// bg.json ของดรอปนี้คือ {"mode":"color","color":"#000000"}
// ลำดับผิว: #4e2120 ยก (การ์ด ContentBox) / #300605 กลาง / #150303 จม / #000000 พื้นเพจ
// ทองน้ำผึ้ง #f0c878 (8.47:1 บนผิวการ์ด) ถือหัวข้อ ขอบรูป ออรา และเป็นสีเดียวที่
// <strong> ในเนื้อความใช้ได้ · งาช้าง #fff8d8 = เนื้อความ (= BRAND_TEXT ที่ <html>
// และการ์ด ContentBox ตั้งให้แล้ว ย่อหน้าจึงไม่ประกาศสีของตัวเอง) ·
// หมึก #2a0608 = ตัวอักษรบนพื้นถมทอง/งาช้างเท่านั้น (11.7:1 บนทองน้ำผึ้ง)
// ⚠️⚠️ **แดงชาด #d9212a (2.69:1 บนผิวการ์ด · 4.20:1 บนพื้นเพจ) และแดงเลือดหมู
// #8e1a16 ห้ามถือตัวอักษรทุกขนาด** ทั้งคู่เป็น **ขอบ / ออรา / พื้นถม** เท่านั้น
// ปุ่มในไฟล์นี้จึงถมทอง-งาช้างแล้ววางหมึกเข้มทับ ไม่ได้ถมแดง
// ถ้าอยากได้ปุ่มพื้นแดงจริงๆ ต้องถม #d9212a แล้ววาง #fff8d8 ทับ (4.68:1)
// rgba() ที่อนุญาตรอบนี้: rgba(217,33,42,α) · rgba(240,200,120,α) · rgba(142,26,22,α)
// · <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ
// ถ้าเปิด/ปิดกลางคำ บรรทัดจะตัดกลางคำ และ <strong> สองตัวห้ามติดกัน
// ⚠️ กับดักรอบนี้คือ **ทองเคยนำมาแล้วเกือบทุกแบรนด์ และแดงเคยนำมาแล้วหลายแบรนด์**
// การเจอ "ทอง" หรือ "แดง" ในไฟล์นี้จึงไม่พิสูจน์อะไรเลย ให้เทียบเป็น "ค่า" ทีละตัว
// กับตารางใน brand-spec §2 (ค่าของแบรนด์เก่าไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep
// ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง)
// และรอบนี้ **ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง ไม่มีเขียว ไม่มีเงิน/โครเมียม
// ไม่มีโรสโกลด์ ไม่มีชมพู/ฟูเชีย ไม่มีส้มสด และไม่มีบรอนซ์** (บรอนซ์เป็นสีที่สาม
// ของรอบก่อน) — แดงรอบนี้เป็นแดงชาดจีน ไม่ใช่ส้มและไม่ใช่โรสโกลด์
//
// ⚠️ แกนของแบรนด์รอบนี้คือ **เว็บสอนเล่นเกมเดิมพันออนไลน์หลายประเภท** (สล็อต
// บาคาร่า ยิงปลา ไฮโล บอล หวย) **ไม่ใช่เว็บหวย และไม่ใช่เว็บบอล** รอบก่อนเป็นเว็บ
// กีฬา/ฟุตบอลล้วน ศัพท์หมวดของรอบก่อนทุกคำจึงเป็นของค้างที่ต้องไม่เหลือแม้แต่คำเดียว
// สองหน้าหมวดลอตเตอรีจอดอยู่ใน src/pages-disabled/ ไม่มี route ลิงก์ค้างจะเป็น
// href ตายที่ทำให้บิลด์แดง (รายการคำเต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่)
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% / 0.8% / 24ชม. / 3 ขั้นตอน — ห้ามแต่งยอดฝาก
// ขั้นต่ำ ชื่อธนาคาร ชื่อค่ายเกม ค่า RTP เลขใบอนุญาต จำนวนสมาชิก หรือปีก่อตั้ง และ
// ต้องคงประโยคกำกับของบรีฟไว้ว่า **ควรอ่านรายละเอียดจากประกาศล่าสุดก่อนเข้าร่วม**
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) หน้านี้ยาว 156 อักขระด้วยชื่อแบรนด์ 12 ตัวของรอบนี้
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `รวมภาพโปรโมชั่นของ ${BRAND_NAME} ไว้ในหน้าเดียว ทั้งคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% แต่ละรายการมีเงื่อนไขรับสิทธิ์ต่างกัน ควรอ่านประกาศล่าสุดก่อนเข้าร่วม`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่น ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});

// ความกว้างที่ถูกวาดจริงของแต่ละคอลัมน์ในกริดสองคอลัมน์ (ดูคอมเมนต์ sizes ด้านบน)
const promoSizes = "(max-width: 639px) calc(100vw - 96px), (max-width: 767px) calc(50vw - 60px), (max-width: 1335px) calc(50vw - 68px), 600px";

const promoClass =
  "mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#f0c878]/55 object-contain shadow-[0_0_28px_rgba(240,200,120,0.28)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#d9212a]/85 hover:shadow-[0_0_40px_rgba(217,33,42,0.45)]";

// alt ทั้งสองเขียนจากบิตแมปของดรอปนี้ที่เปิดอ่านเองแล้ว (600x334 ทั้งคู่) — ฉากห้องโถง
// หรูโทนขาว-งาช้าง ชายหนุ่มผมสั้นสีเงินชุดสูทขาวฝั่งซ้าย หญิงสาวผมยาวสีเงินฝั่งขวา
// มงกุฎทอง กองเหรียญทอง กล่องของขวัญขาวผูกโบว์ทอง ด้านบนเป็นโลโก้หัวไฉ่ซิงเอี๊ย
// ⚠️ องค์ประกอบของอาร์ตเวิร์กแบรนด์ก่อนๆ ที่ต้องไม่หลงเหลือใน alt อยู่ครบใน
// brand-spec §5 (ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive)
// ⚠️ alt คือ "ข้อความที่พิมพ์อยู่บนโปสเตอร์" เป็นหลัก — ตัวเลขท้าย alt ต้องตรงกับรูป
const altCashback = `โปสเตอร์โปรโมชั่นแนวนอน ฉากห้องโถงหรูโทนขาว-งาช้าง ด้านบนเป็นโลโก้ ${BRAND_NAME} รูปหัวไฉ่ซิงเอี๊ยยิ้มหัวเราะสวมหมวกทรงจีนสีแดงขลิบทอง เคียงกับชื่อแบรนด์ตัวอักษรไทยสามมิติผิวทองและเลขสามมิติสีแดงขลิบทอง ฝั่งซ้ายเป็นชายหนุ่มผมสั้นสีเงินในชุดสูทขาว ฝั่งขวาเป็นหญิงสาวผมยาวสีเงินในชุดลายทองสวมสร้อยและต่างหูทอง รอบตัวมีมงกุฎทอง เหรียญทองกองโต และกล่องของขวัญสีขาวผูกโบว์ทอง กลางภาพเป็นคำว่า โปรโมชั่น ตัวอักษรไทยสามมิติสีทองตัวโตมีมงกุฎเล็กวางอยู่ด้านบน ใต้ลงมาเป็นแถบโค้งสีดำขลิบทองเขียนว่า คืนยอดเสีย ต่อด้วยตัวเลข 0.3% สีทองตัวโต`;

const altReferral = `โปสเตอร์โปรโมชั่นแนวนอน ฉากห้องโถงหรูโทนขาว-งาช้าง ด้านบนเป็นโลโก้ ${BRAND_NAME} รูปหัวไฉ่ซิงเอี๊ยยิ้มหัวเราะสวมหมวกทรงจีนสีแดงขลิบทอง เคียงกับชื่อแบรนด์ตัวอักษรไทยสามมิติผิวทองและเลขสามมิติสีแดงขลิบทอง ฝั่งซ้ายเป็นชายหนุ่มผมสั้นสีเงินในชุดสูทขาวยืนเท้าคาง ฝั่งขวาเป็นหญิงสาวผมยาวสีเงินในชุดขาว-ทองสวมสร้อยและกำไลทอง รอบตัวมีมงกุฎทอง เหรียญทองกองโต และกล่องของขวัญสีขาวผูกโบว์ทอง กลางภาพเป็นคำว่า โปรโมชั่น ตัวอักษรไทยสามมิติสีทองตัวโตมีมงกุฎเล็กวางอยู่ด้านบน ใต้ลงมาเป็นแถบโค้งสีดำขลิบทองเขียนว่า แนะนำเพื่อน ต่อด้วยตัวเลข 0.8% สีทองตัวโต`;
---

<MainLayout title={`โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน โบนัส 0.8%`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`รวมโปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} as="h1">
    <div class="flex flex-col gap-10">
      <p>
        หน้านี้รวมภาพประกาศโปรโมชั่นของ {BRAND_NAME} ไว้ในที่เดียว ทั้ง
        <strong class="text-[#f0c878]">รายการคืนยอดเสีย 0.3% เข้ายูสทุกวัน และโบนัสแนะนำเพื่อน 0.8% ไม่จำกัด</strong>
        โดยอัตราและรูปแบบการรับสิทธิ์ระบุไว้บนภาพด้านล่างแล้ว แต่ละรายการอาจกำหนดเงื่อนไขเกี่ยวกับประเภทเกม ยอดที่ใช้คำนวณเครดิต และช่วงเวลารับสิทธิ์แตกต่างกัน
        <strong class="text-[#f0c878]">ก่อนเข้าร่วมควรอ่านรายละเอียดจากประกาศล่าสุด รวมถึงตรวจสอบข้อจำกัดจำนวนบัญชีและการใช้โปรโมชั่นร่วมกัน</strong>
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt={altCashback}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />

        <Picture
          src={promoReferral}
          alt={altReferral}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#8e1a16] bg-gradient-to-b from-[#fff8d8] to-[#f0c878] px-10 py-3.5 text-lg font-black text-[#2a0608] shadow-[0_0_14px_rgba(240,200,120,0.5)] transition-transform hover:scale-105">
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
