---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";

import { Picture } from "astro:assets";

// ดรอปอาร์ตเวิร์กของ หวย365 คือ 2026-10-03 และมีโปสเตอร์ที่ใช้ได้แค่สองใบ
// (brand-spec §4) — เปิดไฟล์จริงดูแล้วทั้งคู่ และป้ายบนภาพ "สลับข้าง" กับรอบก่อน
// (ห้ามเดาจากชื่อไฟล์ และห้ามเชื่อคอมเมนต์ของรอบก่อน ต้องเปิดดูทุกครั้ง):
//   slide1.png — 600x400 ป้ายใต้หัวเรื่อง "อัตราจ่ายหวย" อ่านว่า "3ตัว จ่าย 1,000 บาท"
//                ป้ายแดงขอบทอง หญิงสาวชุดไทยขาว-ทอง ถือลูกบอลหวยสีขาวเลข 3
//   slide2.png — 600x400 ป้ายขาวขอบทองอ่านว่า "2ตัวจ่าย 100 บาท"
//                ชุดเดียวกัน ถือลูกบอลหวยสีขาวเลข 2
//   slide3.png / slide4.png — โปสเตอร์ของแบรนด์ก่อน (29 ก.ย. เก่ากว่าดรอปนี้)
//     ห้าม import กลับมาเด็ดขาด และห้ามลบไฟล์ทิ้งเพราะเป็นอินเวนทอรีของรอบถัดไป
// ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้วและ verify-build จะแดง
// (banner2/banner3 ใน src/assets ก็เก่ากว่าดรอปนี้ = อาร์ตเวิร์กแบรนด์ก่อน ห้าม import)
// ส่วน banner1 / banner1-mobile / og.png เป็นของ MainLayout ห้าม import จากหน้านี้
// ชื่อตัวแปรตั้งตามข้อความบนภาพ ไม่ใช่ตามเลขไฟล์ เพื่อไม่ให้รอบหน้าสลับผิดอีก
import promoTwoDigit from "../assets/slide2.png";
import promoThreeDigit from "../assets/slide1.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้น ๆ "หนึ่งย่อหน้า ประมาณสี่บรรทัด" คือ
// โควตาตัวหนังสือทั้งหมดของหน้านี้, กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อย
// และห้ามเพิ่มย่อหน้า เพราะตัวโปสเตอร์ระบุอัตราจ่ายไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว
// การพิมพ์ซ้ำด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ เป้าหมาย h1x1, h2x0, h3x0
//
// สไลด์รอบนี้เป็น 600x400 จึงวางเป็นกริดสองคอลัมน์คุมความกว้างรวมที่ max-w-4xl
// (896px) ทำให้ช่องละ ~436px ไม่ต้องอัปสเกลเกินขนาดไฟล์ต้นทาง widths หยุดที่ 600 ตาม
// ความกว้างจริงของไฟล์ และคุมภาพต่อใบไว้ที่ max-w-[600px] สองใบพอดีหนึ่งแถว กริดจึง
// จัดกลางสมมาตรโดยไม่ต้องมีใบที่ span สองคอลัมน์ · เรียง 2 ตัว ก่อน 3 ตัว ตามลำดับ
// ของบรีฟ (docx #4 แล้วค่อย #5)
//
// Announcement หมุนมาเป็น AnnouncementHuay ทั้งเว็บรอบนี้ (รอบก่อน NATO168 ใช้
// Announcement5) — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ
// หวย365 แล้ว และทุกหน้าก็เรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop message มิฉะนั้น
// ตัววิ่งจะพูดคนละเรื่องกันระหว่างหน้าแรกกับหน้านี้
//
// พาเลตต์ หวย365 (brand-spec §2) แดงสด-ทอง-ดำ: แดงแบรนด์ #dc0203 (สีตัวตน ขอบ) ·
// แดงสว่าง #f5282a (active/hover) · แดงลึก #8c0402 (เงา ปลายไล่เฉด) · ทองแบรนด์
// #ffc93c (จุดเน้น hover) · ทองอ่อน #ffeab0 (ต้นไล่เฉด) · ทองลึก #c08a07 (เส้น ขอบ
// ปลายไล่เฉด) · พื้นลึก #140203 · พื้นการ์ด #240406 · พื้นยกระดับ #3a0a0c ·
// หมึกบนพื้นทอง #1a0303 · เนื้อความ #f6e7e0 (BRAND_TEXT มาจาก <html> และการ์ด
// ContentBox ตั้งให้แล้ว จึงไม่ต้องระบุสีที่ย่อหน้า)
// กฎคอนทราสต์: ไล่เฉดปุ่มทองจบที่ #c08a07 เท่านั้น (หมึก #1a0303 ได้ 6.4:1) ·
// ห้ามวางหมึกทองอ่อนบนพื้นแดง · การ์ดโปสเตอร์ได้ขอบทองลึกแล้วยกเป็นแดงสว่างตอน hover
// เพราะเวิร์ดมาร์กบนภาพเป็นแดงคู่ทอง การยกเป็นทองซ้ำจะไม่เห็นฮิวที่สอง
// ชุดทอง-เงินของ NATO168 (#edb543 #fde8a8 #a9761f #e6e6e6 #101010 #17120a #070707
// #1a1203 #f4ead3 rgba(237,181,67,*) rgba(230,230,230,*) rgba(4,3,0,*)) ถูกแทนครบ
// ทุกจุดแล้ว ทั้งคลาส Tailwind raw hex และ rgba()
//
// หวย365 เป็นเว็บ "แทงหวยออนไลน์" ไม่ใช่สล็อต ไม่ใช่คาสิโน และไม่ใช่กีฬา — คำว่า
// สล็อต พีจี ค่ายเกม ฟรีสปิน ตัวคูณ วงล้อ ปั่น โบนัสไทม์ คืนยอดเสีย แนะนำเพื่อน RTP
// คาสิโนสด บาคาร่า บอล ห้ามปรากฏบนหน้านี้ ตัวเลขที่บรีฟระบุและใช้ได้มีแค่
// 2 ตัว จ่าย 100 บาท · 3 ตัว จ่าย 1,000 บาท · 3 ขั้นตอน · 24 ชั่วโมง ห้ามเพิ่มชื่อ
// ผู้ให้บริการ ชื่อธนาคาร ยอดฝากขั้นต่ำ เลขใบอนุญาต จำนวนสมาชิก หรือปีที่ก่อตั้ง
// และต้องคงคำกำกับของบรีฟไว้ว่าอัตราจ่ายอาจต่างกันตามประเภทหวยและรอบ จึงควรยึด
// รายละเอียดล่าสุดในหน้าส่งโพยก่อนยืนยันรายการ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 155
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `รวมภาพโปรโมชั่นอัตราจ่ายหวยของ ${BRAND_NAME} ทั้งแบบ 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท พร้อมจุดที่ควรตรวจสอบจากหน้าส่งโพยก่อนยืนยันรายการเดิมพันทุกครั้ง`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่นอัตราจ่ายหวย ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoTwoDigit.src,
});
---

<MainLayout title={`โปรโมชั่นอัตราจ่ายหวย ${BRAND_NAME} 2 ตัว จ่าย 100 บาท 3 ตัว จ่าย 1,000 บาท`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`โปรโมชั่นอัตราจ่ายหวย ${BRAND_NAME}`} as="h1">
    <div class="flex flex-col gap-10">
      <p class="text-left text-base leading-relaxed">
        หน้านี้รวมภาพอัตราจ่ายที่ <strong class="text-[#ffc93c]">{BRAND_NAME}</strong> เปิดให้สมาชิกตรวจสอบก่อนเลือกแทง โดยรายละเอียดของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว ทั้งแบบ 2 ตัว และแบบ 3 ตัว
        สามารถ Login เพื่อดูรายการหวยที่เปิดรับ เวลาปิดรับ และอัตราจ่ายของแต่ละรอบจากบัญชีสมาชิกได้โดยตรง <strong class="text-[#ffc93c]">อัตราจ่ายอาจแตกต่างกันตามประเภทหวยและรูปแบบการเดิมพันของแต่ละรอบ</strong> จึงควรยึดรายละเอียดล่าสุดในหน้าส่งโพยก่อนยืนยันรายการทุกครั้ง
      </p>

      <div class="mx-auto grid w-full max-w-4xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoTwoDigit}
          alt="โปสเตอร์อัตราจ่ายหวยของ หวย365 ฉากหลังเป็นผ้าซาตินสีแดงสด ด้านซ้ายเป็นหญิงสาวผมยาวสวมชุดไทยสีขาวปักทองและเครื่องประดับทองฝังพลอยแดง มือซ้ายถือลูกบอลหวยสีขาวเลข 2 มือขวาแบหงายขึ้น รอบตัวมีลูกบอลหวยเลข 6 เลข 9 เลข 8 และเลข 5 กับกองเหรียญทองและใบหวยกระจายอยู่ มุมบนเป็นโลโก้ หวย365 คำว่า หวย สีแดงคู่กับเลข 365 สีดำ ตรงกลางเป็นตัวอักษรไทยสีทองขอบแดงขนาดใหญ่ว่า อัตราจ่ายหวย ใต้ลงมาเป็นป้ายสีขาวขอบทองคาดข้อความ 2ตัวจ่าย 100 บาท"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), (max-width: 1007px) calc((100vw - 136px) / 2), 436px"
          class="mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#c08a07]/60 object-contain shadow-[0_10px_30px_rgba(8,1,1,0.85)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f5282a]/85 hover:shadow-[0_15px_40px_rgba(255,201,60,0.40)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoThreeDigit}
          alt="โปสเตอร์อัตราจ่ายหวยของ หวย365 ชุดเดียวกัน ฉากหลังผ้าซาตินสีแดงสด ด้านซ้ายเป็นหญิงสาวผมยาวสวมชุดไทยสีขาวปักทองประดับเครื่องทองฝังพลอยแดง มือซ้ายถือลูกบอลหวยสีขาวเลข 3 มือขวาแบหงายขึ้นมาข้างหน้า รอบตัวมีลูกบอลหวยเลข 6 เลข 8 เลข 9 และเลข 5 กับกองเหรียญทองและใบหวย มุมบนเป็นโลโก้ หวย365 คำว่า หวย สีแดงคู่กับเลข 365 สีดำ ตรงกลางเป็นตัวอักษรไทยสีทองขอบแดงขนาดใหญ่ว่า อัตราจ่ายหวย ใต้ลงมาเป็นป้ายสีแดงขอบทองคาดข้อความ 3ตัว จ่าย 1,000 บาท"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), (max-width: 1007px) calc((100vw - 136px) / 2), 436px"
          class="mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#c08a07]/60 object-contain shadow-[0_10px_30px_rgba(8,1,1,0.85)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f5282a]/85 hover:shadow-[0_15px_40px_rgba(255,201,60,0.40)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#c08a07] bg-gradient-to-r from-[#ffeab0] via-[#ffc93c] to-[#c08a07] px-10 py-3.5 text-lg font-black text-[#1a0303] shadow-[0_0_15px_rgba(255,201,60,0.40)] transition-transform hover:scale-105">
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
