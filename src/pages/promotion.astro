---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

// ดรอปรอบนี้ (2026-10-23, .claude/brand-spec-ruaythear168club.md §1) มีสไลด์ที่ใช้ได้
// **สองใบ** และชื่อตัวแปรตั้งตามข้อความที่พิมพ์อยู่บนภาพจริง (เปิดบิตแมปอ่านเอง
// แล้วรอบนี้) ไม่ใช่ตามเลขไฟล์ — ถ้ารอบหน้าเจอความขัดแย้ง **ให้เชื่อข้อความบนรูป**:
//   slide2.png (mtime 10-23) — โปสเตอร์ "โปรโมชั่น / คืนยอดเสีย 0.3%"
//   slide1.png (mtime 10-23) — โปสเตอร์ "โปรโมชั่น / แนะนำเพื่อน 0.8%"
//   slide3.png / slide4.png (mtime 2026-09-29) — โปสเตอร์ของแบรนด์คนละราย
//     **ห้าม import** (ถอดออกไปหลายรอบแล้ว อย่าดึงกลับ)
// ⚠️ การจับคู่พลิกไปมาระหว่างดรอป เพราะ uploader เขียนทับ slide1/slide2 ทุกครั้ง
// เลขไฟล์จึงไม่มีความหมายข้ามแบรนด์ ต้องเปิดบิตแมปดูทุกรอบ
// ⚠️ eager import = emit ลง dist/ ต่อให้ไม่ได้ render และ verify-build จะแดง
// การ import ไฟล์เก่าคือการส่งรูปของลูกค้ารายอื่นขึ้นเว็บนี้
// **ห้ามลบไฟล์เก่าทิ้ง** — เป็นอินเวนทอรีของรอบถัดไป แค่ห้าม import
// (banner2 mtime 10-08 / banner3 mtime 09-27 ก็เช่นกัน ส่วน banner1 /
// banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักชื่อไว้เอง —
// ห้ามอ้างจากหน้านี้) รอบนี้จึงไม่มี article illustration
import promoCashback from "../assets/slide2.png";
import promoReferral from "../assets/slide1.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้นๆ ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมด
// ของหน้านี้, กริดภาพโปรโมชั่น, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อยและห้ามเพิ่มย่อหน้า
// เพราะโปสเตอร์ระบุเปอร์เซ็นต์ของตัวเองด้วยตัวอักษรขนาดใหญ่อยู่แล้ว การพิมพ์ซ้ำ
// ด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ บรีฟรอบนี้ (src/assets/content.txt)
// ไม่มีส่วน SUB-PAGES เลย ย่อหน้าทุกย่อหน้าที่เคยอยู่บนหน้านี้จึงเป็นของที่รีแบรนด์
// รอบก่อนๆ แต่งขึ้นเอง — รอบนี้คงไว้เพียงย่อหน้าเกริ่นเดียว และเขียนขึ้นใหม่จากบรีฟ
// (content.txt บรรทัด 7-12) ไม่ใช่ find-and-replace ทับประโยคของรอบก่อน
//
// ลำดับในกริดตามลำดับของบรีฟ: คืนยอดเสีย 0.3% (บรรทัด 9-10) มาก่อน
// แนะนำเพื่อน 0.8% (บรรทัด 11-12) → promoCashback (slide2) อยู่ช่องแรก
// ⚠️⚠️ **บิตแมปจริงของดรอปนี้คือ 600x480 แนวนอน** — ตรงกับที่ brand-spec §1 ระบุ
// ความกว้างสูงสุดคือ 600 widths จึงหยุดที่ 600 และคุมที่ max-w-[600px]
// **ให้วัดใหม่ทุกรอบจากไฟล์จริง อย่าเชื่อสัดส่วนของรอบก่อน**
// sizes คิดจากความกว้างที่ถูกวาดจริง: section px-4 (16px/ข้าง) + การ์ด p-8
// (32px/ข้าง, เป็น p-10 = 40px ที่ md ขึ้นไป) + gap-6 ระหว่างคอลัมน์ (24px)
//   ใต้ 640px = คอลัมน์เดียว → 100vw-96px
//   640-767px = สองคอลัมน์ p-8 → 50vw-60px
//   768-1335px = สองคอลัมน์ p-10 → 50vw-68px
//   ตั้งแต่ 1336px ขึ้นไปชนเพดาน 600px (การ์ดเองกว้างสุด 1400px จึงยังไม่ชน
//   เพดานของการ์ดก่อน)
// LCP คือ hero ใน MainLayout ไม่ใช่รูปพวกนี้ จึง loading="lazy" fetchpriority="low"
// decoding="async" และ quality ตัวเดียวทั้ง avif/webp — ห้ามจูนแยกฟอร์แมต
// (tools/avif-quality-service.mjs ย่อฝั่ง avif ให้เองที่ x0.65)
//
// quality={64} ไม่ใช่ 80 ตามปกติ: สไลด์ทั้งสองเป็นภาพถ่ายคนในฉากห้องนั่งเล่น
// โทนครีม-งาช้างที่มีไล่เฉดนุ่มเต็มเฟรม บวกตัวอักษรสามมิติผิวมันเงาที่มีไฮไลต์
// และขอบคมทับอยู่ด้านบน ซึ่งเป็นเคสที่ AVIF ทำได้แย่ที่สุด ที่ quality=80 ไฟล์
// AVIF มีโอกาสออกมา **ใหญ่กว่า** WebP ที่เป็น fallback ของตัวเอง เบราว์เซอร์ที่
// รองรับ AVIF จะหยิบไฟล์ที่หนักกว่าไปใช้ และ verify-build.mjs ทำให้ build แดงด้วย
// เหตุนี้ตรงๆ · ทางแก้คือ quality ที่ **ต่ำลง** ไม่ใช่สูงขึ้น · ค่าเดียวกันนี้ต้องใช้ที่
// index.astro กับสไลด์คู่เดียวกัน
//
// Announcement รอบนี้หมุนมาเป็น Announcement5 ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ Announcement2 จึงหมุนออก) orchestrator ตั้ง default
// message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว และทุกหน้าเรียกแบบ bare
// เหมือนกัน จึงห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกันระหว่างหน้า
//
// 🚨🚨 พาเลตรอบนี้ (brand-spec-ruaythear168club.md §2) เป็น **ธีมสว่าง กลับทิศจาก
// รอบก่อน 180 องศา** bg.json ของดรอปนี้คือ {"mode":"color","color":"#dbe6ff"}
// = ฟ้าเพอริวิงเคิลอ่อน **ห้าม "แก้" กลับไปเป็นการ์ดพื้นเข้มเพราะรอบก่อนทำแบบนั้น**
// ลำดับผิว: ผิวการ์ด #ffffff (ContentBox) / ชั้นกลาง #eef4ff / อินเซ็ต #dce9fb /
// พื้นเพจ #dbe6ff · ผิวครีม #f4e4d3 เป็นวัสดุที่สอง (พื้น/ออราเท่านั้น)
// หมึก #16294a = เนื้อความ (= BRAND_TEXT ที่ <html> และการ์ด ContentBox
// ตั้งให้แล้ว ย่อหน้าจึงไม่ประกาศสีของตัวเอง 13.9:1 บนผิวการ์ด) ·
// ฟ้าเข้ม #0d6b9b = สีของ <strong> ในเนื้อความ (5.6:1) และของหัวข้อ
// ฟ้าอ่อน #a9d7f2 = ขอบรูป · ฟ้าไซยาน #18a5e2 = ขอบ hover / ออรา
// ⚠️⚠️ **#18a5e2 ห้ามถือตัวอักษรบนพื้นสว่าง** (2.6:1) และ **#a9d7f2 ห้ามถือ
// ตัวอักษร** ทั้งคู่เป็นพื้นถม/ขอบ/ออราเท่านั้น
// ปุ่ม CTA ของหน้านี้เป็น **PRIMARY = ไล่เฉดฟ้า** #0d6b9b → #0a5176 บนหมึก
// **ขาว #ffffff** (5.6 / 8.0:1) ตรงกับปุ่มสมัครสมาชิกที่ /contact-us /ทางเข้า
// /about-us /register — **ห้ามสลับเป็นพื้นถม #18a5e2 แล้ววางตัวอักษรขาว**
// rgba() ที่อนุญาตรอบนี้: rgba(24,165,226,α) · rgba(13,107,155,α) ·
// rgba(244,228,211,α) · rgba(22,41,74,α) · rgba(0,0,0,α) · rgba(255,255,255,α)
// ⚠️⚠️ **รอบนี้ไม่มีทอง/เหลืองเป็นสี UI เลยสักเฉด** ทองที่เห็นในอาร์ตเวิร์ก
// (ตะกร้าเหรียญ นาฬิกา เข็มขัด) เป็น **วัตถุในภาพ** ไม่ใช่สีของแบรนด์
// · <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ
// ถ้าเปิด/ปิดกลางคำ บรรทัดจะตัดกลางคำ และ <strong> สองตัวห้ามติดกัน
// ⚠️ กับดักรอบนี้คือ **ฟ้าเคยนำมาแล้วห้าแบรนด์ในรีโปนี้** การเจอ "ฟ้า" ในไฟล์นี้
// จึงไม่พิสูจน์อะไรเลย ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน brand-spec §2
// (ค่าของแบรนด์เก่าไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive
// ในคอมเมนต์ของไฟล์นี้เอง) รอบนี้ **ไม่มีทอง ไม่มีน้ำตาล ไม่มีแดง ไม่มีเขียว
// ไม่มีชมพู ไม่มีม่วง ไม่มีส้ม ไม่มีโรสโกลด์ และไม่มีแรมป์เทาเงิน**
//
// ⚠️ แกนของแบรนด์รอบนี้คือ **เว็บสล็อตออนไลน์ เกมสล็อตจ่ายแพง ปรับเรทแตกหนัก**
// **ไม่ใช่แกนของรอบก่อน และไม่ใช่เว็บลอตเตอรี**
// รายการคำที่ห้ามใช้อยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่
// สองหน้าหมวดลอตเตอรี **ยังปิดอยู่รอบนี้** (อยู่ใน src/pages-disabled/)
// ห้ามลิงก์ไปสองเส้นทางนั้นจากหน้านี้ — route ไม่มีอยู่จริง build จะแดง
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 3 ขั้นตอน · 24ชม.
// ห้ามแต่งยอดฝากขั้นต่ำ ชื่อธนาคาร ชื่อค่ายเกม ค่า RTP เลขใบอนุญาต ปีก่อตั้ง
// หรือจำนวนสมาชิก และต้องคงประโยคกำกับของบรีฟไว้ว่า
// **ก่อนเข้าร่วมควรอ่านประกาศล่าสุดให้ครบถ้วน**
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) หน้านี้ยาว 156 อักขระด้วยชื่อแบรนด์ 9 ตัวของรอบนี้
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `โปรโมชั่น ${BRAND_NAME} รวมภาพประกาศสิทธิ์สมาชิกไว้ในหน้าเดียว คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% แต่ละรายการมีเงื่อนไขต่างกัน ควรอ่านประกาศล่าสุดก่อนรับสิทธิ์`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่น ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});

// ความกว้างที่ถูกวาดจริงของแต่ละคอลัมน์ในกริดสองคอลัมน์ (ดูคอมเมนต์ sizes ด้านบน)
const promoSizes = "(max-width: 639px) calc(100vw - 96px), (max-width: 767px) calc(50vw - 60px), (max-width: 1335px) calc(50vw - 68px), 600px";

const promoClass =
  "mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#a9d7f2] object-contain shadow-[0_8px_28px_rgba(22,41,74,0.14)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#18a5e2] hover:shadow-[0_12px_40px_rgba(24,165,226,0.3)]";

// alt ทั้งสองเขียนจากบิตแมปของดรอปนี้ที่เปิดอ่านเองแล้ว (**600x480 แนวนอน** ทั้งคู่) —
// ฉากห้องนั่งเล่นหรูโทนครีม-งาช้าง ผู้หญิงสูงวัยผมสั้นดัดลอนสีขาวเงิน สวมแว่น
// กันแดดเลนส์ดำ ลิปสติกแดง ชุดสูทซาตินสีงาช้าง เครื่องประดับทองและไข่มุก
// นั่งบนโซฟาผ้าสีครีม โลโก้ตะกร้าสานทองคำใส่เหรียญอยู่มุมบน และตัวอักษรไทย
// สามมิติสีฟ้าไซยานว่า โปรโมชั่น พร้อมแคปซูลฟ้าน้ำเงินที่ระบุชื่อรายการกับตัวเลข
// ⚠️ องค์ประกอบของอาร์ตเวิร์กแบรนด์ก่อนๆ ที่ต้องไม่หลงเหลือใน alt อยู่ครบใน
// brand-spec §1 (ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive)
// ⚠️ alt คือ "ข้อความที่พิมพ์อยู่บนโปสเตอร์" เป็นหลัก — ตัวเลขท้าย alt ต้องตรงกับรูป
// ⚠️ ห้ามเรียกรูปคู่นี้ว่าภาพแนวตั้งหรือภาพสี่เหลี่ยมจัตุรัส รอบนี้เป็น **แนวนอน**
// ⚠️ สีของวัตถุในรูป (ลิปสติกแดง ผ้าซาตินสีงาช้าง ทองของเครื่องประดับ สีผิวและ
// สีผมนักแสดง) เป็นวัตถุในภาพ ไม่ใช่สีของแบรนด์ และไม่เข้ามาใน UI
const altCashback = `โปสเตอร์โปรโมชั่นแนวนอน ฉากห้องนั่งเล่นโทนครีมงาช้างที่มีแสงนุ่มจากหน้าต่าง มุมขวาบนเป็นโลโก้ตะกร้าสานทองคำใส่เหรียญทองของ ${BRAND_NAME} ฝั่งซ้ายเป็นผู้หญิงสูงวัยผมสั้นดัดลอนสีขาวเงิน ทาลิปสติกแดง สวมแว่นกันแดดเลนส์ดำและยกมือขวาขึ้นจับขอบแว่น ใส่สูทซาตินสีงาช้างทับชุดสีครีม สวมต่างหูไข่มุก แหวน และนาฬิกาข้อมือทอง นั่งเอนอยู่บนโซฟาผ้าสีครีม ครึ่งขวาเป็นตัวอักษรไทยสามมิติตัวโตสีฟ้าไซยานอ่านว่า โปรโมชั่น ใต้ลงมาเป็นแคปซูลมนสีฟ้าน้ำเงินขอบขาวเขียนว่า คืนยอดเสีย ต่อท้ายด้วยตัวเลข 0.3% ตัวโต`;

const altReferral = `โปสเตอร์โปรโมชั่นแนวนอน ฉากห้องนั่งเล่นโทนครีมงาช้างที่มีแสงนุ่มจากหน้าต่าง มุมขวาบนเป็นโลโก้ตะกร้าสานทองคำใส่เหรียญทองของ ${BRAND_NAME} ฝั่งซ้ายเป็นผู้หญิงสูงวัยผมสั้นดัดลอนสีขาวเงิน ทาลิปสติกแดง สวมแว่นกันแดดเลนส์ดำ ยิ้มกว้างและชี้นิ้วมาทางผู้ชมด้วยมือทั้งสองข้าง ใส่สูทซาตินสีงาช้างกับกางเกงสีครีม คาดเข็มขัดหัวทอง สวมต่างหูไข่มุก แหวนและนาฬิกาข้อมือทอง นั่งอยู่บนโซฟาผ้าสีครีม ครึ่งขวาเป็นตัวอักษรไทยสามมิติตัวโตสีฟ้าไซยานอ่านว่า โปรโมชั่น มีขีดประกายสองข้าง ใต้ลงมาเป็นแคปซูลมนสีฟ้าน้ำเงินขอบขาวเขียนว่า แนะนำเพื่อน ต่อท้ายด้วยตัวเลข 0.8% ตัวโต`;
---

<MainLayout title={`โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน โบนัส 0.8%`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`รวมโปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} as="h1">
    <div class="flex flex-col gap-10">
      <p>
        หน้านี้รวมภาพประกาศโปรโมชั่นสำหรับสมาชิกของ {BRAND_NAME} ไว้ในที่เดียว ทั้ง
        <strong class="text-[#0d6b9b]">รายการคืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน และโบนัสแนะนำเพื่อน 0.8% กดรับได้ไม่จำกัด</strong>
        โดยอัตราและชื่อรายการระบุไว้บนภาพด้านล่างแล้ว แต่ละรายการอาจกำหนดประเภทเกมที่เข้าร่วม ยอดที่นำมาคำนวณ และรอบเวลารับเครดิตแตกต่างกัน
        <strong class="text-[#0d6b9b]">ก่อนเข้าร่วมควรอ่านประกาศล่าสุดให้ครบถ้วน รวมถึงตรวจสอบจำนวนครั้งที่รับสิทธิ์ได้จริงและเงื่อนไขการถอนเงิน</strong>
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt={altCashback}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />

        <Picture
          src={promoReferral}
          alt={altReferral}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="relative isolate flex items-center justify-center overflow-hidden rounded-lg border border-[#0a5176] bg-gradient-to-b from-[#0d6b9b] to-[#0a5176] px-10 py-3.5 text-lg font-black text-[#ffffff] shadow-[0_8px_22px_rgba(13,107,155,0.35)] transition-transform hover:scale-105">
          <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-white/20 to-transparent"></span>
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
