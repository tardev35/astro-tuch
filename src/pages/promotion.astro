---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

// ดรอปรอบนี้ (2026-10-18, brand-spec §4) มีสไลด์ที่ใช้ได้ **สองใบ** และชื่อตัวแปร
// ตั้งตามข้อความที่พิมพ์อยู่บนภาพจริง (เปิดดูบิตแมปแล้ว) ไม่ใช่ตามเลขไฟล์ —
// ถ้ารอบหน้าเจอความขัดแย้ง **ให้เชื่อข้อความบนรูป**:
//   slide2.png — โปสเตอร์ "โปรโมชั่น / คืนยอดเสีย 0.3%" มีโลโก้แบรนด์นี้มุมบนซ้าย
//   slide1.png — โปสเตอร์ "โปรโมชั่น / แนะนำเพื่อน 0.8%" มีโลโก้แบรนด์นี้มุมบนซ้าย
//   slide3.png / slide4.png (mtime 2026-09-29) — อาร์ตเวิร์กของแบรนด์ก่อน **ห้าม import**
// ⚠️ eager import = emit ลง dist/ ต่อให้ไม่ได้ render และ verify-build จะแดง
// การ import ไฟล์เก่าคือการส่งรูปของลูกค้ารายอื่นขึ้นเว็บนี้
// **ห้ามลบไฟล์ทั้งสองทิ้ง** — เป็นอินเวนทอรีของรอบถัดไป แค่ห้าม import
// (banner2 / banner3 ก็เช่นกัน ส่วน banner1 / banner1-mobile / og.png เป็นของ glob
// ที่ MainLayout ปักชื่อไว้เอง — ห้ามอ้างจากหน้านี้) รอบนี้จึงไม่มี article illustration
import promoCashback from "../assets/slide2.png";
import promoReferral from "../assets/slide1.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้นๆ ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมด
// ของหน้านี้, กริดภาพโปรโมชั่น, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อยและห้ามเพิ่มย่อหน้า
// เพราะโปสเตอร์ระบุเปอร์เซ็นต์ของตัวเองด้วยตัวอักษรขนาดใหญ่อยู่แล้ว การพิมพ์ซ้ำ
// ด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ บรีฟรอบนี้ (src/assets/content.txt)
// ไม่มีส่วน SUB-PAGES เลย ย่อหน้าทุกย่อหน้าที่เคยอยู่บนหน้านี้จึงเป็นของที่รีแบรนด์
// รอบก่อนๆ แต่งขึ้นเอง — รอบนี้คงไว้เพียงย่อหน้าเกริ่นเดียว และเขียนขึ้นใหม่จากบรีฟ
//
// ลำดับในกริดตามลำดับของบรีฟ: คืนยอดเสีย 0.3% (บรรทัด 11) มาก่อน แนะนำเพื่อน 0.8%
// (บรรทัด 13) · บิตแมปจริง 600x600 ทั้งคู่ → widths หยุดที่ 600 และคุมที่ max-w-[600px]
// sizes คิดจากความกว้างที่ถูกวาดจริง: section px-4 (16px/ข้าง) + การ์ด p-8
// (32px/ข้าง, เป็น p-10 = 40px ที่ md ขึ้นไป) + gap-6 ระหว่างคอลัมน์ (24px)
//   ใต้ 640px = คอลัมน์เดียว → 100vw-96px
//   640-767px = สองคอลัมน์ p-8 → 50vw-60px
//   768-1335px = สองคอลัมน์ p-10 → 50vw-68px
//   ตั้งแต่ 1336px ขึ้นไปชนเพดาน 600px
// LCP คือ hero ใน MainLayout ไม่ใช่รูปพวกนี้ จึง loading="lazy" fetchpriority="low"
// decoding="async" และ quality={80} ตัวเดียวทั้ง avif/webp — ห้ามจูนแยกฟอร์แมต
//
// Announcement รอบนี้หมุนมาเป็น Announcement5 ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ AnnouncementPremium) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้
// ของแบรนด์นี้ไว้แล้ว และทุกหน้าเรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop message
// มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกันระหว่างหน้า
//
// พาเลตต์รอบนี้ (brand-spec §2) = **ทองนำ · โรสโกลด์เป็นฮิวที่สอง · แดงชาดเป็น
// สำเนียงลึกที่ไม่เคยนำ บนดำสนิท** bg.json ของดรอปนี้คือ {"mode":"color","color":"#000000"}
// ลำดับผิว: #241509 ยก (การ์ด ContentBox) / #160d06 กลาง / #0b0603 จม / #000000 พื้นเพจ
// ทองแบรนด์ #f7c92b ถือขอบรูปและออรา · ทองสว่าง #ffe6a3 เป็นต้นสว่างของพื้นถมปุ่ม
// และเป็นสีไฮไลต์ของ <strong> ในเนื้อความ (สงวนไว้งานเดียวนี้) ·
// **โรสโกลด์ #f2bba5 เป็นขอบและออราตอน hover ของรูป** — ฮิวที่สองของรอบนี้ต้อง
// เห็นจริงบนหน้า ไม่ใช่แค่เขียนไว้ในสเปก · ทองลึก #8a5f12 เป็นขอบปุ่มถมทอง ·
// หมึกบนพื้นถมทองเป็น #140c06 (7.9:1 บน #f7c92b และ 15.6:1 บน #ffe6a3) ·
// เนื้อความ #eadfce มาจาก BRAND_TEXT ที่ <html> และการ์ด ContentBox ตั้งให้แล้ว
// ย่อหน้าจึงไม่ประกาศสีของตัวเอง
// · <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ
// ถ้าเปิด/ปิดกลางคำ บรรทัดจะตัดกลางคำ
// ⚠️ #b3121b #5a0a0e #8a5f12 ห้ามถือตัวอักษรทุกขนาด ใช้ได้เฉพาะเส้น ขอบ ออรา
// และพื้นถม · ออราในไฟล์นี้ใช้ rgba(247,201,43,α) และ rgba(242,187,165,α) เท่านั้น
// ⚠️ กับดักของรอบนี้คือ **ทอง**: แทบทุกแบรนด์ที่ผ่านไฟล์นี้มีทอง "เจอทอง" จึงไม่ได้
// แปลว่าเป็นของรอบนี้ ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน brand-spec §2 (ค่าของ
// แบรนด์เก่าไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive)
// สิ่งที่ทำให้รอบนี้ต่างจริงคือ **โรสโกลด์เป็นฮิวที่สอง** และรอบนี้ **ไม่มีน้ำเงิน
// ไม่มีฟ้า ไม่มีม่วง ไม่มีชมพูบานเย็น ไม่มีเขียว ไม่มีส้ม ไม่มีเงินอมฟ้า**
//
// ⚠️ แบรนด์นี้เป็น **เว็บเกมสล็อตล้วน** ไม่ใช่หมวดอื่นใดทั้งสิ้น (สองหน้าของหมวด
// ที่แบรนด์ก่อนๆ เคยเปิดจอดอยู่ใน src/pages-disabled/ ไม่มี route — ลิงก์ค้าง
// จะเป็น href ตายที่ทำให้บิลด์แดง) คำขายของของแบรนด์ก่อนและศัพท์หมวดอื่นที่บรีฟ
// ไม่ได้เอ่ยห้ามหลงเหลือ (รายการเต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep เจอ false positive)
// ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% / 0.8% / 24 ชั่วโมง / 100% / 3 ขั้นตอน —
// ห้ามแต่งยอดฝากขั้นต่ำ ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP เลขใบอนุญาต จำนวนสมาชิก
// หรือปีก่อตั้ง และต้องคงประโยคกำกับของบรีฟ (content.txt บรรทัด 10) ไว้ว่า
// **ควรอ่านรายละเอียดเกี่ยวกับยอดที่นำมาคำนวณ ระยะเวลารับสิทธิ์ และเงื่อนไขการใช้
// โบนัสก่อนเข้าร่วม**
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) หน้านี้ยาว 158 อักขระ
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `รวมภาพโปรโมชั่นของ ${BRAND_NAME} ทั้งคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% รายละเอียดอยู่บนภาพ สอบถามวิธีรับสิทธิ์และเงื่อนไขการใช้โบนัสกับเจ้าหน้าที่ได้ 24 ชั่วโมง`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่น ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});

// ความกว้างที่ถูกวาดจริงของแต่ละคอลัมน์ในกริดสองคอลัมน์ (ดูคอมเมนต์ sizes ด้านบน)
const promoSizes = "(max-width: 639px) calc(100vw - 96px), (max-width: 767px) calc(50vw - 60px), (max-width: 1335px) calc(50vw - 68px), 600px";

const promoClass =
  "mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#f7c92b]/50 object-contain shadow-[0_0_28px_rgba(247,201,43,0.3)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f2bba5]/85 hover:shadow-[0_0_40px_rgba(242,187,165,0.4)]";
---

<MainLayout title={`โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน โบนัส 0.8%`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`โปรโมชั่น ${BRAND_NAME} ทั้งหมด`} as="h1">
    <div class="flex flex-col gap-10">
      <p>
        หน้านี้รวมภาพประกาศโปรโมชั่นของ <strong class="text-[#ffe6a3]">{BRAND_NAME} ที่เปิดให้สมาชิกตรวจสอบรายละเอียดสิทธิพิเศษได้ในที่เดียว</strong> ทั้งรายการคืนยอดเสีย 0.3% และโบนัสจากการแนะนำเพื่อน 0.8% โดยอัตราและรูปแบบการรับสิทธิ์ของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว
        <strong class="text-[#ffe6a3]">ก่อนเข้าร่วมควรอ่านรายละเอียดเกี่ยวกับยอดที่นำมาคำนวณ ระยะเวลารับสิทธิ์ และเงื่อนไขการใช้โบนัสให้ครบถ้วน</strong> หรือสอบถามรอบเวลาคำนวณยอดและประเภทเกมที่ร่วมรายการกับเจ้าหน้าที่ผ่าน LINE Official ได้ตลอด 24 ชั่วโมง
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt={`โปสเตอร์โปรโมชั่นพื้นดำ มุมบนซ้ายเป็นโลโก้ ${BRAND_NAME} ตัวอักษรทองบนโบว์ริบบิ้นทอง กลางภาพเป็นหญิงสาวผมยาวสีดำประดับปิ่นทองห้อยระย้าและดอกไม้สีขาว สวมชุดแดงปักทองพร้อมสร้อยคอและต่างหูทอง ขยิบตาและทำมือเป็นรูปหัวใจคู่กับหัวใจสีแดง รอบตัวมีเหรียญจีนทองรูสี่เหลี่ยมปลิวกระจายและผ้าซาตินแดงพลิ้ว ด้านล่างเป็นคำว่า โปรโมชั่น ตัวอักษรทองสามมิติมีมงกุฎทองอยู่เหนือ และป้ายดำขอบทองเขียนว่า คืนยอดเสีย คู่กับตัวเลข 0.3% สีแดงตัวโตเต็มป้าย`}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoReferral}
          alt={`โปสเตอร์โปรโมชั่นพื้นดำ มุมบนซ้ายเป็นโลโก้ ${BRAND_NAME} ตัวอักษรทองบนโบว์ริบบิ้นทอง กลางภาพเป็นหญิงสาวผมยาวสีดำเกล้ามวยประดับปิ่นทองและดอกไม้สีขาว สวมชุดแดงปักทองพร้อมมงกุฎทองเล็กและเครื่องประดับทอง ขยิบตาและทำมือเป็นรูปหัวใจคู่กับหัวใจสีแดง รอบตัวมีเหรียญจีนทองรูสี่เหลี่ยมกองสูงและปลิวทั่วภาพ กับผ้าซาตินแดงพลิ้ว ด้านล่างเป็นคำว่า โปรโมชั่น ตัวอักษรทองสามมิติ และป้ายดำขอบทองเขียนว่า แนะนำเพื่อน คู่กับตัวเลข 0.8% สีแดงตัวโตเต็มป้าย`}
          loading="lazy"
          fetchpriority="low"
          widths={[300, 440, 600]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#8a5f12] bg-gradient-to-b from-[#ffe6a3] to-[#f7c92b] px-10 py-3.5 text-lg font-black text-[#140c06] shadow-[0_0_14px_rgba(247,201,43,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
