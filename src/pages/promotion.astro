---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";

import { Picture } from "astro:assets";

// Only slide1/slide2 are this brand's assets — slide3/slide4 are stale
// leftovers from an earlier brand (WINSIAM88, green/gold art, older mtime,
// not part of this drop) and must not be imported or rendered. See
// .rebrand-scratch-JEDI66.md "docx heading checklist" section.
// slide1 = referral 0.8% art, slide2 = cashback 0.3% art.
import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "โปรโมชั่น JEDI66 คาสิโนออนไลน์ระบบออโต้ แนะนำเพื่อนรับโบนัส 0.8% และคืนยอดเสีย 0.3% ตรวจสอบเงื่อนไขให้ครบก่อนกดรับสิทธิ์ทุกครั้ง เพื่อความคุ้มค่าสูงสุด";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น JEDI66 แนะนำเพื่อน 0.8% คืนยอดเสีย 0.3%",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});
---

<MainLayout title="โปรโมชั่น JEDI66 แนะนำเพื่อนรับ 0.8% คืนยอดเสียรับ 0.3%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น JEDI66" as="h1">
    <div>
      <h2 class="mb-4 text-2xl leading-normal font-bold text-[#94a3b8]">โปรโมชั่นแนะนำเพื่อน 0.8%</h2>

      <p class="mb-8 text-left text-base leading-relaxed text-[#e0f2fe]">
        สมาชิกสามารถร่วมกิจกรรมแนะนำเพื่อนของ JEDI66 และรับโบนัส 0.8% ตามเงื่อนไขที่เว็บไซต์กำหนด พร้อมตรวจสอบข้อมูลการแนะนำและโบนัสที่ได้รับผ่านระบบสมาชิกได้อย่างสะดวก
      </p>

      <h2 class="mb-4 text-2xl leading-normal font-bold text-[#94a3b8]">โปรโมชั่นคืนยอดเสีย 0.3%</h2>

      <p class="mb-8 text-left text-base leading-relaxed text-[#e0f2fe]">
        สมาชิก JEDI66 สามารถตรวจสอบสิทธิ์รับคืนยอดเสีย 0.3% ได้ตามเงื่อนไขของเว็บไซต์ โดยระบบจะอัปเดตรายละเอียดการรับสิทธิ์และช่วงเวลาที่สามารถกดรับได้อย่างชัดเจน
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={pro1}
          alt="แบนเนอร์ JEDI66 โบนัสแนะนำเพื่อน รับ 0.8% ธีมงานเทศกาลพลุและเจ้าสัวมาสคอต จากยอดเดิมพันของเพื่อนที่สมัครผ่านลิงก์แนะนำ และตรวจสอบสิทธิ์ได้เองผ่านระบบ"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600, 800]}
          sizes="(max-width: 768px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#94a3b8]/25 object-contain shadow-[0_10px_30px_rgba(148,163,184,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#94a3b8]/50 hover:shadow-[0_15px_40px_rgba(148,163,184,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro2}
          alt="แบนเนอร์ JEDI66 โบนัสคืนยอดเสียทุกวัน รับ 0.3% ธีมงานเทศกาลพลุและเจ้าสัวมาสคอต สำหรับสมาชิกที่เดิมพันต่อเนื่อง พร้อมระบบฝากถอนออโต้ 24 ชม."
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600, 800]}
          sizes="(max-width: 768px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#94a3b8]/25 object-contain shadow-[0_10px_30px_rgba(148,163,184,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#94a3b8]/50 hover:shadow-[0_15px_40px_rgba(148,163,184,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#94a3b8]/60 bg-gradient-to-r from-[#e2e8f0] to-[#94a3b8] px-10 py-3.5 text-lg font-black text-[#0a1220] shadow-[0_10px_30px_rgba(148,163,184,0.18)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(71,85,105,0.30)]">
          สมัครสมาชิก JEDI66
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
