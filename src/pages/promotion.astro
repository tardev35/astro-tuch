---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

// ดรอปรอบนี้ (2026-10-21, brand-spec-prodeee168.md §2) มีสไลด์ที่ใช้ได้ **สองใบ**
// และชื่อตัวแปรตั้งตามข้อความที่พิมพ์อยู่บนภาพจริง (เปิดบิตแมปอ่านเองแล้วรอบนี้)
// ไม่ใช่ตามเลขไฟล์ — ถ้ารอบหน้าเจอความขัดแย้ง **ให้เชื่อข้อความบนรูป**:
//   slide1.png (mtime 10-21) — โปสเตอร์ "โปรโมชั่น / คืนยอดเสีย 0.3%"
//   slide2.png (mtime 10-21) — โปสเตอร์ "โปรโมชั่น / แนะนำเพื่อน 0.8%"
//   slide3.png / slide4.png (mtime 2026-09-29) — โปสเตอร์ของแบรนด์คนละราย
//     **ห้าม import** (ถอดออกไปหลายรอบแล้ว อย่าดึงกลับ)
// ⚠️ การจับคู่พลิกไปมาระหว่างดรอป เพราะ uploader เขียนทับ slide1/slide2 ทุกครั้ง
// เลขไฟล์จึงไม่มีความหมายข้ามแบรนด์ ต้องเปิดบิตแมปดูทุกรอบ (รอบก่อนสลับกับรอบนี้)
// ⚠️ eager import = emit ลง dist/ ต่อให้ไม่ได้ render และ verify-build จะแดง
// การ import ไฟล์เก่าคือการส่งรูปของลูกค้ารายอื่นขึ้นเว็บนี้
// **ห้ามลบไฟล์เก่าทิ้ง** — เป็นอินเวนทอรีของรอบถัดไป แค่ห้าม import
// (banner2 mtime 10-08 / banner3 mtime 09-27 ก็เช่นกัน ส่วน banner1 /
// banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักชื่อไว้เอง —
// ห้ามอ้างจากหน้านี้) รอบนี้จึงไม่มี article illustration
import promoCashback from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ (SKILL.md Phase 4.5): ContentBox title หนึ่งอัน
// (เป็น h1 เดียวของหน้า), ย่อหน้าเกริ่นสั้นๆ ประมาณสี่บรรทัด คือโควตาตัวหนังสือทั้งหมด
// ของหน้านี้, กริดภาพโปรโมชั่น, ปุ่ม CTA หนึ่งปุ่ม — ห้ามมีหัวข้อย่อยและห้ามเพิ่มย่อหน้า
// เพราะโปสเตอร์ระบุเปอร์เซ็นต์ของตัวเองด้วยตัวอักษรขนาดใหญ่อยู่แล้ว การพิมพ์ซ้ำ
// ด้านล่างด้วยตัวเล็กกว่าไม่ได้ให้ข้อมูลใหม่ บรีฟรอบนี้ (src/assets/content.txt)
// ไม่มีส่วน SUB-PAGES เลย ย่อหน้าทุกย่อหน้าที่เคยอยู่บนหน้านี้จึงเป็นของที่รีแบรนด์
// รอบก่อนๆ แต่งขึ้นเอง — รอบนี้คงไว้เพียงย่อหน้าเกริ่นเดียว และเขียนขึ้นใหม่จากบรีฟ
// (content.txt บรรทัด 7-12) ไม่ใช่ find-and-replace ทับประโยคของรอบก่อน
//
// ลำดับในกริดตามลำดับของบรีฟ: คืนยอดเสีย 0.3% (บรรทัด 9-10) มาก่อน
// แนะนำเพื่อน 0.8% (บรรทัด 11-12)
// ⚠️ บิตแมปจริงของดรอปนี้คือ **540x600 แนวตั้ง** (ไม่ใช่จัตุรัสและไม่ใช่แนวนอน)
// ความกว้างสูงสุดคือ 540 widths จึงหยุดที่ 540 และคุมที่ max-w-[540px] ตามสเปก
// **ให้วัดใหม่ทุกรอบ อย่าเชื่อสัดส่วนของรอบก่อน** (วัดรอบนี้แล้วด้วย sharp)
// sizes คิดจากความกว้างที่ถูกวาดจริง: section px-4 (16px/ข้าง) + การ์ด p-8
// (32px/ข้าง, เป็น p-10 = 40px ที่ md ขึ้นไป) + gap-6 ระหว่างคอลัมน์ (24px)
//   ใต้ 640px = คอลัมน์เดียว → 100vw-96px
//   640-767px = สองคอลัมน์ p-8 → 50vw-60px
//   768-1215px = สองคอลัมน์ p-10 → 50vw-68px
//   ตั้งแต่ 1216px ขึ้นไปชนเพดาน 540px
// LCP คือ hero ใน MainLayout ไม่ใช่รูปพวกนี้ จึง loading="lazy" fetchpriority="low"
// decoding="async" และ quality ตัวเดียวทั้ง avif/webp — ห้ามจูนแยกฟอร์แมต
// (tools/avif-quality-service.mjs ย่อฝั่ง avif ให้เองที่ x0.65)
//
// quality={64} ไม่ใช่ 80 ตามปกติ: สไลด์ทั้งสองเป็นอาร์ตเกรนละเอียด (ฟางในทุ่ง
// ขนสัตว์ กองเหรียญทอง ลายไม้ของป้าย และตัวอักษรไล่เฉดสามมิติ) ซึ่งเป็นเคสที่ AVIF
// ทำได้แย่ที่สุด ที่ quality=80 ไฟล์ AVIF มีโอกาสออกมา **ใหญ่กว่า** WebP ที่เป็น
// fallback ของตัวเอง เบราว์เซอร์ที่รองรับ AVIF จะหยิบไฟล์ที่หนักกว่าไปใช้ และ
// verify-build.mjs ทำให้ build แดงด้วยเหตุนี้ตรงๆ · ทางแก้คือ quality ที่ **ต่ำลง**
// ไม่ใช่สูงขึ้น · ค่าเดียวกันนี้ต้องใช้ที่ index.astro กับสไลด์คู่เดียวกัน
//
// Announcement รอบนี้หมุนมาเป็น AnnouncementPremium ทั้งเว็บ (brand-spec §3 —
// รอบก่อนใช้ ticker คนละตัว จึงหมุนออก) orchestrator ตั้ง default
// message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว และทุกหน้าเรียกแบบ bare
// เหมือนกัน จึงห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกันระหว่างหน้า
//
// 🚨 พาเลตรอบนี้ (brand-spec-prodeee168.md §2) เป็น **ธีมสว่างรอบที่สี่ของรีโปนี้**
// bg.json ของดรอปนี้คือ {"mode":"color","color":"#ffd1d1"} = ชมพูพาสเทลสว่าง
// **ห้าม "แก้" กลับไปเป็นพื้นเข้มเพราะรอบก่อนๆ เป็นแบบนั้น**
// ลำดับผิว: ผิวการ์ด #ffffff (ContentBox) / ชั้นกลาง-อินเซ็ต #fff4ea / พื้นเพจ #ffd1d1
// หมึกน้ำตาลแดง #401107 = เนื้อความ (= BRAND_TEXT ที่ <html> และการ์ด ContentBox
// ตั้งให้แล้ว ย่อหน้าจึงไม่ประกาศสีของตัวเอง 16.1:1 บนผิวการ์ด) ·
// แดงเข้ม #9b0a0c = **สีเดียว** ที่ <strong> ในเนื้อความใช้ได้ (8.6:1)
// แดงเชอร์รี่ #eb0305 = ขอบรูป / ออรา / ต้นเฉดของปุ่ม (4.6:1 กับตัวอักษรขาว ผ่าน AA)
// ⚠️⚠️ **แดงสด (ff4446) ห้ามถือตัวอักษรและห้ามเป็นพื้นของตัวอักษร** (3.1:1) เป็น
// stop ของไล่เฉด/ออราเท่านั้น
// ปุ่ม CTA ของหน้านี้เป็น **PRIMARY = ไล่เฉดแดง** #eb0305 → #c20305 → #9b0a0c
// บนตัวอักษร **ขาว** (4.6 / 6.4 / 8.6:1 ผ่านทุก stop) — ตรงกับปุ่มสมัครสมาชิกที่
// /contact-us /ทางเข้า /register
// ⚠️⚠️ **ทองสาลี่ (f0b46a เขียนโดยไม่มี # เพื่อกัน sweep) ห้ามปรากฏในไฟล์นี้** — บนผิวการ์ดขาวได้ 1.8:1
// เป็นสีของโซนโครมเท่านั้น (ทองแดงไหม้ #b44c06 / #7a2f03 ใช้ได้ แต่รอบนี้หน้านี้
// ไม่มีปุ่มรอง จึงไม่ได้ใช้)
// rgba() ที่อนุญาตรอบนี้: rgba(235,3,5,α) · rgba(155,10,12,α) · rgba(64,17,7,α) ·
// rgba(180,76,6,α)
// · <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ
// ถ้าเปิด/ปิดกลางคำ บรรทัดจะตัดกลางคำ และ <strong> สองตัวห้ามติดกัน
// ⚠️ กับดักรอบนี้คือ **แดงนำมาแล้วมากกว่าฮิวอื่นใดในรีโปนี้ และรอบก่อนก็เป็นแดง+ทอง
// +ธีมสว่างชมพูเหมือนกัน** การเจอ "แดง" ในไฟล์นี้จึงไม่พิสูจน์อะไรเลย ให้เทียบเป็น
// "ค่า" ทีละตัวกับตารางใน brand-spec §2 (ค่าของแบรนด์เก่าไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้
// sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง) แบรนด์ก่อนหน้า
// ทันทีเป็นแดง+ทองบนธีมสว่างเช่นกัน ซึ่งกวาดออกครบแล้วจากไฟล์นี้ และรอบนี้
// **ไม่มีเขียว ไม่มีชมพูบานเย็น ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง ไม่มีเงิน/โครเมียม
// และไม่มีโรสโกลด์**
//
// ⚠️ แกนของแบรนด์รอบนี้คือ **เว็บสล็อตออนไลน์ล้วน** — เกมสล็อตลิขสิทธิ์แท้
// ค่ายตรงมาแรง **ไม่ใช่เว็บหมวดอื่นที่เคยอยู่บนเทมเพลตนี้**
// รายการคำที่ห้ามใช้อยู่ใน brand-spec §1 ไม่พิมพ์ซ้ำที่นี่
// สองหน้าหมวดลอตเตอรีของรอบก่อน **ถูกปิดรอบนี้** (ย้ายไป src/pages-disabled/)
// ห้ามลิงก์ไปสองเส้นทางนั้นจากหน้านี้ — route ไม่มีอยู่จริงแล้ว build จะแดง
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 24ชม. · ปี 2026
// ห้ามแต่งยอดฝากขั้นต่ำ ชื่อธนาคาร ชื่อค่ายเกม ค่า RTP เลขใบอนุญาต หรือจำนวนสมาชิก
// และต้องคงประโยคกำกับของบรีฟไว้ว่า
// **ควรตรวจสอบรายละเอียดจากประกาศล่าสุดก่อนเข้าร่วม**
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) หน้านี้ยาว 159 อักขระด้วยชื่อแบรนด์ 8 ตัวของรอบนี้
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `รวมภาพโปรโมชั่นของ ${BRAND_NAME} เว็บสล็อตออนไลน์ไว้ในหน้าเดียว ทั้งคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% แต่ละรายการมีเงื่อนไขต่างกัน ควรอ่านประกาศล่าสุดก่อนเข้าร่วม`;

const graph = pageGraph(Astro, {
  name: `โปรโมชั่น ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});

// ความกว้างที่ถูกวาดจริงของแต่ละคอลัมน์ในกริดสองคอลัมน์ (ดูคอมเมนต์ sizes ด้านบน)
const promoSizes = "(max-width: 639px) calc(100vw - 96px), (max-width: 767px) calc(50vw - 60px), (max-width: 1215px) calc(50vw - 68px), 540px";

const promoClass =
  "mx-auto h-auto w-full max-w-[540px] rounded-xl border border-[#eb0305]/55 object-contain shadow-[0_0_28px_rgba(235,3,5,0.22)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#9b0a0c]/85 hover:shadow-[0_0_40px_rgba(155,10,12,0.35)]";

// alt ทั้งสองเขียนจากบิตแมปของดรอปนี้ที่เปิดอ่านเองแล้ว (540x600 **แนวตั้ง** ทั้งคู่) —
// ฉากฟาร์มกลางแจ้งแดดจัด กังหันลมไม้ ยุ้งแดง รั้วไม้ เด็กชาย-เด็กหญิงชุดลายสก๊อตแดง
// กระต่ายขาวผูกผ้าพันคอแดง วัว หมูชมพู แครอท และกองเหรียญทอง
// ⚠️ องค์ประกอบของอาร์ตเวิร์กแบรนด์ก่อนๆ ที่ต้องไม่หลงเหลือใน alt อยู่ครบใน
// brand-spec §2 (ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive)
// ⚠️ alt คือ "ข้อความที่พิมพ์อยู่บนโปสเตอร์" เป็นหลัก — ตัวเลขท้าย alt ต้องตรงกับรูป
// ⚠️ ห้ามเรียกรูปคู่นี้ว่าภาพแนวนอนหรือภาพสี่เหลี่ยมจัตุรัส รอบนี้เป็นแนวตั้ง
// ⚠️ สีของวัตถุในรูป (ฟ้าของท้องฟ้า เขียวของทุ่ง ขาวของกระต่าย ชมพูของหมู
// น้ำเงินของเอี๊ยมยีนส์) เป็นฉาก ไม่ใช่สีของแบรนด์ และไม่เข้ามาใน UI
const altCashback = `โปสเตอร์โปรโมชั่นแนวตั้ง ฉากฟาร์มกลางแจ้งแดดจัด มีกังหันลมไม้ ยุ้งไม้สีแดง รั้วไม้ และท้องฟ้าสีฟ้ามีเมฆขาวเป็นฉากหลัง ด้านบนเป็นโลโก้ ${BRAND_NAME} กระต่ายการ์ตูนขนขาวผูกผ้าพันคอแดงอยู่ข้างตัวอักษรไทยสามมิติผิวมันวาวสีแดงเชอร์รี่ขอบขาว ฝั่งซ้ายเป็นเด็กชายผมดำสวมหมวกฟาง เสื้อลายสก๊อตแดงกับเอี๊ยมยีนส์ ยกนิ้วโป้ง ฝั่งขวาเป็นเด็กหญิงผมดำติดโบว์แดงผืนใหญ่ สวมชุดขาวสลับแดง ขยิบตาและยกนิ้วโป้ง กลางภาพเป็นกระต่ายขาวผูกผ้าพันคอแดงกอดแครอท ข้างซ้ายเป็นวัวลายขาวดำ ข้างขวาเป็นหมูชมพู ใต้ลงมาเป็นป้ายไม้แผ่นใหญ่เขียนคำว่า โปรโมชั่น ด้วยตัวอักษรไทยสามมิติสีทองตัวโต ต่อด้วยแถบ คืนยอดเสีย และตัวเลข 0.3% ตัวโต ด้านล่างเป็นกองเหรียญทอง แครอท ดอกเดซี่ขาว และถังไม้`;

const altReferral = `โปสเตอร์โปรโมชั่นแนวตั้ง ฉากฟาร์มกลางแจ้งแดดจัด มีกังหันลมไม้ ยุ้งไม้สีแดง รั้วไม้ และท้องฟ้าสีฟ้ามีเมฆขาวเป็นฉากหลัง ด้านบนเป็นโลโก้ ${BRAND_NAME} กระต่ายการ์ตูนขนขาวผูกผ้าพันคอแดงอยู่ข้างตัวอักษรไทยสามมิติผิวมันวาวสีแดงเชอร์รี่ขอบขาว ฝั่งซ้ายเป็นเด็กชายผมดำสวมหมวกฟาง เสื้อลายสก๊อตแดงกับเอี๊ยมยีนส์ ยกนิ้วโป้ง ฝั่งขวาเป็นเด็กหญิงผมดำติดโบว์แดงผืนใหญ่ สวมชุดลายสก๊อตแดง ยกนิ้วโป้งเช่นกัน กลางภาพเป็นกระต่ายขาวผูกผ้าพันคอแดงยกนิ้วโป้งอยู่ในรางไม้ ข้างซ้ายเป็นวัวลายขาวดำกับลูกเจี๊ยบสีเหลือง ข้างขวาเป็นหมูชมพู ใต้ลงมาเป็นป้ายไม้แผ่นใหญ่เขียนคำว่า โปรโมชั่น ด้วยตัวอักษรไทยสามมิติสีทองตัวโต ต่อด้วยแถบ แนะนำเพื่อน และตัวเลข 0.8% ตัวโต ด้านล่างเป็นกองเหรียญทอง แอปเปิลแดง แครอท และถังไม้`;
---

<MainLayout title={`โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน โบนัส 0.8%`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`รวมโปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} as="h1">
    <div class="flex flex-col gap-10">
      <p>
        หน้านี้รวมภาพประกาศโปรโมชั่นของ {BRAND_NAME} ไว้ในที่เดียว ทั้ง
        <strong class="text-[#9b0a0c]">รายการคืนยอดเสีย 0.3% เข้ายูสทุกวัน และโบนัสแนะนำเพื่อน 0.8% ไม่จำกัด</strong>
        โดยอัตราและวิธีรับสิทธิ์ระบุไว้บนภาพด้านล่างแล้ว แต่ละรายการอาจมีข้อกำหนดเรื่องยอดเดิมพันที่นำมาคำนวณ รอบสรุปเครดิต และวิธีกดรับแตกต่างกัน
        <strong class="text-[#9b0a0c]">ก่อนเข้าร่วมควรตรวจสอบรายละเอียดจากประกาศล่าสุดให้ครบถ้วน รวมถึงข้อจำกัดในการรับโปรโมชั่นร่วมกัน</strong>
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt={altCashback}
          loading="lazy"
          fetchpriority="low"
          widths={[270, 405, 540]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />

        <Picture
          src={promoReferral}
          alt={altReferral}
          loading="lazy"
          fetchpriority="low"
          widths={[270, 405, 540]}
          sizes={promoSizes}
          class={promoClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={64}
        />
      </div>

      <div class="flex justify-center pb-2">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="relative isolate flex items-center justify-center overflow-hidden rounded-lg border border-[#9b0a0c] bg-gradient-to-b from-[#eb0305] via-[#c20305] to-[#9b0a0c] px-10 py-3.5 text-lg font-black text-[#ffffff] shadow-[0_0_14px_rgba(235,3,5,0.45)] transition-transform hover:scale-105">
          <span aria-hidden="true" class="absolute inset-x-0 bottom-0 -z-10 h-1/2 bg-gradient-to-t from-[#9b0a0c]/60 to-transparent"></span>
          สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
