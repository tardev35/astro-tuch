---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

// ดรอปอาร์ตเวิร์กของ UFAGOOL คือ 2026-09-23 และมีสไลด์ที่ใช้ได้สองใบ (600x333):
//   slide1.png — "โปรโมชั่น แนะนำเพื่อน 0.8%"
//   slide2.png — "โปรโมชั่น คืนยอดเสีย 0.3%"
// บทบาทของสองไฟล์นี้ "สลับกัน" กับแบรนด์รอบก่อน (รอบนั้น slide2 คือ 0.8%)
// จึงต้องเปิดดูภาพจริงทุกครั้ง อย่าเชื่อชื่อตัวแปรที่ตกทอดมา กริดเรียงตามลำดับ docx
// (แนะนำเพื่อนก่อน คืนยอดเสียทีหลัง)
//
// slide3.png (2026-09-18) และ slide4.png (2026-08-13) เก่ากว่าดรอปรอบนี้ เป็น
// อาร์ตเวิร์กของลูกค้าเจ้าก่อน — ห้าม import กลับมา และห้ามลบไฟล์ทิ้งเพราะเป็น
// อินเวนทอรี (ลำพังการ import ที่ไม่ได้ render ก็ถูก emit ลง dist/ แล้ว และ
// verify-build จะแดง) ถ้ามีสไลด์ใหม่เข้ามาให้เช็ก mtime เทียบดรอปก่อนเพิ่ม
import promoReferral from "../assets/slide1.png";
import promoCashback from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";
//
// หน้านี้เป็น IMAGE page ไม่ใช่บทความ: ContentBox title, ย่อหน้าเกริ่นสั้น ๆ หนึ่งย่อหน้า,
// กริดโปสเตอร์, ปุ่ม CTA หนึ่งปุ่ม — ไม่มีหัวข้อย่อยและไม่มีย่อหน้าเพิ่ม เพราะตัวโปสเตอร์
// ระบุชื่อโปรและเปอร์เซ็นต์โบนัสไว้ด้วยตัวอักษรขนาดใหญ่อยู่แล้ว เป้าหมาย h1×1, h2×0, h3×0
//
// สไลด์เป็นแบนเนอร์แนวนอน 600px จึงวางเป็นกริดสองคอลัมน์คุมความกว้างรวมที่ max-w-5xl
// (1024px) ทำให้ช่องละ ~488px ไม่ต้องอัปสเกลเกินขนาดไฟล์ต้นทาง widths หยุดที่ 600
// ตามความกว้างจริงของไฟล์ (candidate ที่ใหญ่กว่านั้นไม่มีของให้ครอป)
//
// Announcement รอบนี้หมุนมาใช้ Announcement3 ทั้งเว็บ — default message ของไฟล์นั้น
// ถูกตั้งเป็นคอปปี้ของ UFAGOOL แล้ว และ index ก็เรียกแบบ bare เหมือนกัน จึงห้ามส่ง prop
//
// พาเลตต์ UFAGOOL (แดงคริมสัน-เงินโครเมียม บนเกือบดำ แทนแดง-ทองบนแดงเกือบดำของแบรนด์รอบก่อน):
// พื้น #0a0708 · ผิวการ์ด #16100f · ผิวยก #241a1a · แดงหลัก #c50d12 · แดงสว่าง #ef1f25 ·
// แดงลึก #7a0103 · ขอบแดงเข้ม #5e0507 · เงินขาว #f4f7fa · เงินกลาง #b8c3cf ·
// เงินเข้ม #5c6672 · เนื้อความ #cdd5dd · เงาลึก rgba(10,7,8,α) · ออร่าแดง rgba(197,13,18,α) ·
// ออร่าเงิน rgba(184,195,207,α) — โทนทองของแบรนด์รอบก่อนหายไปทั้งหมด
// ตัวเลขโบนัส (0.8% / 0.3%) ใช้สีเน้น #ff5a5f ส่วนข้อความเน้นทั่วไปใช้เงินขาว #f4f7fa
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 157
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "รวมภาพโปรโมชั่นของ UFAGOOL กีฬาคาสิโนเว็บตรง ทั้งโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% ดูรายการที่เปิดรับ พร้อมตรวจสอบเงื่อนไขของแต่ละสิทธิ์ก่อนกดรับ";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น UFAGOOL",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoReferral.src,
});
---

<MainLayout title="โปรโมชั่น UFAGOOL แนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตรวจเงื่อนไขก่อนกดรับ" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น UFAGOOL" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#cdd5dd]">
        หน้านี้รวมภาพโปรโมชั่นที่ <strong class="text-[#f4f7fa]">UFAGOOL</strong> เปิดรับในรอบปัจจุบัน ทั้งโบนัสแนะนำเพื่อน
        <strong class="text-[#ff5a5f]">0.8%</strong> และโบนัสคืนยอดเสีย <strong class="text-[#ff5a5f]">0.3%</strong>
        โดยรายละเอียดของแต่ละรายการระบุไว้บนภาพด้านล่างแล้ว ทั้งชื่อโปรโมชั่นและเปอร์เซ็นต์โบนัสที่ได้รับ
        <strong class="text-[#f4f7fa]">แต่ละรายการมีเงื่อนไข รอบคำนวณ และยอดที่เข้าเกณฑ์ต่างกัน จึงควรเปิดดูรายละเอียดของโปรโมชั่นนั้นจากหน้าเว็บไซต์ก่อนกดรับสิทธิ์ทุกครั้ง</strong>
      </p>

      <div class="mx-auto grid w-full max-w-5xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={promoReferral}
          alt="แบนเนอร์โปรโมชั่นพื้นแดงเข้มมีลูกฟุตบอลและเส้นแสง ด้านซ้ายเป็นนักกีฬาชายผมสีเข้มสวมเสื้อแดงที่มีคำว่า UFAGOOL กอดอก ด้านบนเป็นโลโก้ UFAGOOL ตัวอักษร UFA สีแดงเงาและ GOOL สีเงินโครเมียม ถัดลงมาเป็นข้อความสีขาวว่า โปรโมชั่น และป้ายสีแดงเขียนว่า แนะนำเพื่อน ล่างสุดเป็นตัวเลขสีขาวขนาดใหญ่ว่า 0.8% รอบภาพมีเหรียญทองและกล่องของขวัญสีแดงลอยอยู่"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), 488px"
          class="mx-auto h-auto w-full rounded-xl border border-[#c50d12]/55 object-contain shadow-[0_10px_30px_rgba(10,7,8,0.75)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#b8c3cf]/75 hover:shadow-[0_15px_40px_rgba(197,13,18,0.45)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoCashback}
          alt="แบนเนอร์โปรโมชั่นพื้นแดงเข้มมีลูกฟุตบอลและเส้นแสง ด้านซ้ายเป็นผู้หญิงผมยาวสีเข้มสวมชุดเชียร์สีแดงขาวที่มีคำว่า UFAGOOL ด้านขวาเป็นนักกีฬาชายสวมเสื้อแดงคำว่า UFAGOOL ด้านบนเป็นโลโก้ UFAGOOL ตัวอักษร UFA สีแดงเงาและ GOOL สีเงินโครเมียม ถัดลงมาเป็นข้อความสีขาวว่า โปรโมชั่น และป้ายสีแดงเขียนว่า คืนยอดเสีย ล่างสุดเป็นตัวเลขสีขาวขนาดใหญ่ว่า 0.3%"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 600]}
          sizes="(max-width: 639px) calc(100vw - 96px), 488px"
          class="mx-auto h-auto w-full rounded-xl border border-[#c50d12]/55 object-contain shadow-[0_10px_30px_rgba(10,7,8,0.75)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#b8c3cf]/75 hover:shadow-[0_15px_40px_rgba(197,13,18,0.45)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก UFAGOOL"
          class="flex items-center justify-center rounded-lg border border-[#ef1f25]/60 bg-gradient-to-r from-[#ef1f25] via-[#c50d12] to-[#7a0103] px-10 py-3.5 text-lg font-black text-[#f4f7fa] shadow-[0_0_15px_rgba(197,13,18,0.50)] transition-transform hover:scale-105">
          สมัครสมาชิก UFAGOOL
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
