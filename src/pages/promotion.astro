---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

// Only slide1/slide2 belong to this brand (UFASLOT drop, 2026-08-11) and both
// are literally the two promotions this page describes: slide1 is the
// "แนะนำเพื่อน รับโบนัส 0.8%" poster, slide2 is the "คืนยอดเสีย รับโบนัส 0.3%"
// poster. slide3/slide4 on disk are a previous client's artwork and banner2 is
// stale — none of them may be imported here, now or on any future rebrand.
import promoCashback from "../assets/slide2.png";
import promoReferral from "../assets/slide1.png";
import { pageGraph } from "../lib/schema";

const pageDescription = "รวมโปรโมชั่น UFASLOT ทั้งคืนยอดเสียรับโบนัส 0.3% ทุกวัน และแนะนำเพื่อนรับโบนัส 0.8% ตรวจสอบยอดสะสมและเงื่อนไขการรับสิทธิ์ผ่านระบบสมาชิกให้ครบก่อนกดรับทุกครั้ง";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น UFASLOT คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8%",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});
---

<MainLayout title="โปรโมชั่น UFASLOT คืนยอดเสียรับ 0.3% แนะนำเพื่อนรับ 0.8%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น UFASLOT" as="h1">
    <div>
      <h2 class="mb-4 text-2xl leading-normal font-bold text-[#f5c518]">คืนยอดเสียทุกวัน รับโบนัส 0.3%</h2>

      <div class="mb-10 grid w-full grid-cols-1 items-center gap-6 md:grid-cols-2">
        <p class="text-left text-base leading-relaxed text-[#f2e6cd]">
          สมาชิกที่มียอดเสียตามเงื่อนไขสามารถรับโบนัสคืนยอดเสีย 0.3% โดยตรวจสอบยอดและกดรับสิทธิ์ตามรอบเวลาที่เว็บไซต์กำหนด ช่วยเพิ่มสิทธิประโยชน์ให้กับสมาชิกที่เข้าเล่นสล็อตอย่างต่อเนื่อง ทั้งนี้
          ยอดที่นำมาคำนวณและการรับโบนัสเป็นไปตามข้อกำหนดของโปรโมชั่น
        </p>

        <Picture
          src={promoCashback}
          alt="โปสเตอร์โปรโมชั่น UFASLOT พื้นดำ ข้อความคืนยอดเสีย รับโบนัส 0.3% ตัวเลขทองขนาดใหญ่ หญิงสาวชุดเดรสดำ-ทอง พร้อมกองชิปและเหรียญทอง"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 768px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#b6821d]/45 object-contain shadow-[0_10px_30px_rgba(245,197,24,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f5c518]/70 hover:shadow-[0_15px_40px_rgba(245,197,24,0.28)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <h2 class="mb-4 text-2xl leading-normal font-bold text-[#f5c518]">แนะนำเพื่อน รับโบนัส 0.8%</h2>

      <div class="mb-8 grid w-full grid-cols-1 items-center gap-6 md:grid-cols-2">
        <p class="text-left text-base leading-relaxed text-[#f2e6cd]">
          สมาชิกสามารถแชร์ลิงก์แนะนำของตนเองให้เพื่อนสมัครใช้งาน และรับโบนัสแนะนำเพื่อน 0.8% ตามยอดและเงื่อนไขที่กำหนด สามารถตรวจสอบข้อมูลการแนะนำและสิทธิ์ที่ได้รับผ่านระบบสมาชิก
          หากมีข้อสงสัยสามารถสอบถามแอดมิน UFASLOT ได้ตลอด 24 ชั่วโมง
        </p>

        <Picture
          src={promoReferral}
          alt="โปสเตอร์โปรโมชั่น UFASLOT พื้นดำ ข้อความแนะนำเพื่อน รับโบนัส 0.8% ตัวเลขทองขนาดใหญ่ หญิงสาวชุดดำ-ทอง พร้อมกองเหรียญและชิปคาสิโน"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 300, 400, 600]}
          sizes="(max-width: 768px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#b6821d]/45 object-contain shadow-[0_10px_30px_rgba(245,197,24,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f5c518]/70 hover:shadow-[0_15px_40px_rgba(245,197,24,0.28)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg bg-gradient-to-r from-[#fff2c3] via-[#f5c518] to-[#b6821d] px-10 py-3.5 text-lg font-black text-[#1a1204] shadow-[0_0_15px_rgba(245,197,24,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก UFASLOT
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
