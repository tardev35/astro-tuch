---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBox3ThreeNeumorphism from "../components/ContentBox3ThreeNeumorphism.astro";
import LatestWinners from "../components/LatestWinners3.astro";
import Faq from "../components/Faq4.astro";
import Navfoot from "../components/Navfoot.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้ว่าด้วย "การตรวจผลรางวัลของรายการที่เปิดรับ และการเปิดประวัติรายการโพยของ
// ตัวเองขึ้นมาเทียบ" — ไม่มีตัวเลขของรอบใด ไม่มีตารางผล ไม่มีวันที่ ไม่มีสถิติ และ
// ไม่มีการทำนายใด ๆ เว็บไซต์ไม่ใช่ผู้ประกาศผล ผลหวยให้อ้างอิงประกาศอย่างเป็นทางการ
// ของหวยแต่ละรายการเป็นหลัก
//
// ข้อเท็จจริงทั้งหมดยึดตาม src/assets/content.txt ของรอบนี้เท่านั้น: รวมรายการหวย
// ยอดนิยมและแนวทางไว้ให้ติดตามก่อนหวยออก — รัฐบาลไทย หวยลาว หวยฮานอย หวยออมสิน
// และหวย ธ.ก.ส. (บรรทัด 4, 6) · เลือกเลข ตรวจสอบรอบ อัตราจ่าย และส่งโพยผ่านมือถือ
// จากบัญชีเดียว (บรรทัด 4) · ตรวจสอบเวลาเปิดรับ เวลาปิดรับ เลข และยอดเดิมพันก่อน
// ส่งโพย (บรรทัด 6) · โพยที่ยืนยันแล้วควรมีประวัติรายการให้กลับมาตรวจสอบได้
// (บรรทัด 9) · อัตราของรายการที่เข้าเงื่อนไขคือ 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย
// 1,000 บาท ซึ่งอาจต่างตามประเภทหวยและรูปแบบการเดิมพัน (บรรทัด 9, 27) · เลขเด็ด
// หรือเลขที่มีผู้เลือกจำนวนมากควรเช็กวงเงินที่ระบบเปิดรับก่อนยืนยัน (บรรทัด 7) ·
// สมัคร 3 ขั้นตอน (บรรทัด 16) · แอดมิน 24 ชั่วโมง (บรรทัด 19) · PIN/OTP (บรรทัด 20)
//
// ⚠️ บรีฟรอบนี้ระบุรายการหวยไว้ห้าชื่อเท่านั้น (รัฐบาลไทย · ลาว · ฮานอย · ออมสิน ·
// ธ.ก.ส.) ห้ามเติมตลาดอื่น (หวยหุ้น ยี่กี ลาวพัฒนา) และห้ามเติมสิ่งที่บรีฟไม่ได้
// ให้ไว้: ใบอนุญาต · หน่วยงานกำกับ · ชื่อธนาคาร · เวลาออกรางวัลเป็นตัวเลข · ตาราง
// ผลย้อนหลัง · ตัวเลขความแม่นยำ · ยอดฝากขั้นต่ำ · จำนวนสมาชิก · ปีก่อตั้ง
// ตัวเลขที่อ้างได้มีแค่ 2 ตัว / 3 ตัว / 100 / 1,000 / 3 ขั้นตอน / 24 ชั่วโมง
//
// คำเตือนของบรีฟเป็นเนื้อหาของหน้า ไม่ใช่ของตัดทิ้ง: แนวทางและสถิติย้อนหลังเป็น
// ข้อมูลประกอบเท่านั้น ไม่การันตีเลขเข้าทุกงวดและไม่รับประกันผลล่วงหน้า · "ไม่อั้นจ่าย"
// ไม่ได้แปลว่าทุกเลขทุกรอบไม่มีวงเงินสูงสุด · "ไม่มีลบโพย" หมายถึงโพยที่ระบบรับและ
// ยืนยันอย่างสมบูรณ์ตามเงื่อนไขที่ประกาศไว้
//
// CHROME: Announcement5 · Faq4 · LatestWinners3 ตรงกับทั้งเว็บรอบนี้ (เรียก
// <Announcement /> แบบ bare ให้ตกไปใช้ default message ของแบรนด์ปัจจุบัน)
//
// ธีม: หน้าหวยสองหน้านี้คงโทน "หวย" แดง-ทองของตัวเองไว้ตามข้อยกเว้น แต่เฉดเป็นของ
// แบรนด์นี้ทั้งหมด (brand-spec §2) — แดงแบรนด์ #dc0409 · แดงสว่าง #f5363d · แดงลึก
// #8e0206 · แดงดำ #4b0205 · ทอง accent #f3c54e · ทองเข้ม #9a6d16 · เงินโครเมียม
// #eef0f4 / #c3c7d1 · พื้นผิว #0d0407 / #17080c / #211016 · เนื้อความ #edeaf0
//
// ย่อหน้าในกล่องไม่ถือคลาสสีของตัวเอง — ContentBox / ContentBoxNeumorphism ตั้ง
// `text-left text-base leading-relaxed text-[#edeaf0]` ไว้บนการ์ดแล้ว ทุกอย่างข้างใน
// สืบทอดลงมา สีที่เขียนเองมีแค่ accent บน <strong> (= #f3c54e สีเดียวทั้งเว็บ)
//
// การ์ดขั้นตอนเป็น chrome ไม่ใช่หัวข้อบทความ ป้ายจึงเป็น <span> และชื่อของชุดการ์ด
// ไปอยู่บน aria-label ของ <ul> ป้ายสามคอลัมน์ของ ContentBox3ThreeNeumorphism ก็เป็น
// คำบรรยายที่หน้านี้ตั้งเอง ไม่ใช่หัวข้อย่อยของบรีฟ จึงส่ง heading={false} ให้เป็น <p>
const steps = [
  {
    icon: "🔐",
    label: "Login เข้าบัญชีสมาชิก",
    detail:
      "เข้าสู่ระบบด้วยบัญชีเดียวกับที่ใช้ส่งโพย ผ่านเบราว์เซอร์บนมือถือหรือคอมพิวเตอร์ บัญชีเดียวติดตามได้ทั้งรัฐบาลไทย หวยลาว หวยฮานอย หวยออมสิน หวย ธ.ก.ส. รวมถึงแนวทาง ผลรางวัล และประวัติรายการ",
  },
  {
    icon: "🎯",
    label: "เลือกรายการหวยและรอบให้ตรงกับโพย",
    detail: "ประวัติรายการแสดงชื่อหวยและรอบที่ส่งไว้คู่กันเสมอ ให้เลือกบรรทัดที่ตรงกับโพยที่ต้องการตรวจก่อน เพราะเลขชุดเดียวกันอาจถูกส่งไว้มากกว่าหนึ่งรอบและมากกว่าหนึ่งรายการ",
  },
  {
    icon: "🧾",
    label: "เทียบเลขกับผลรางวัลของรอบนั้น",
    detail: "ระบบบันทึกเลขที่เลือก ยอดเดิมพัน และอัตราจ่ายไว้ตั้งแต่ตอนกดยืนยัน จึงนำเลขในโพยไปเทียบกับประกาศผลรางวัลของรายการและรอบเดียวกันได้ครบจากหน้าเดียวโดยไม่ต้องจดไว้เอง",
  },
];

const faqs = [
  {
    q: `ตรวจผลรางวัลและประวัติรายการกับ ${BRAND_NAME} ได้จากที่ไหน?`,
    a: "Login เข้าบัญชีสมาชิกแล้วเปิดประวัติรายการ ระบบจะแสดงชื่อหวยและรอบที่ส่ง เลขที่เลือก ยอดเดิมพัน อัตราจ่าย และสถานะไว้ในที่เดียว บัญชีเดียวจึงใช้ติดตามทั้งผลรางวัลและประวัติรายการของรัฐบาลไทย หวยลาว หวยฮานอย หวยออมสิน และหวย ธ.ก.ส. ได้เอง",
  },
  {
    q: `${BRAND_NAME} เป็นผู้ประกาศผลรางวัลเองหรือไม่?`,
    a: "ไม่ใช่ เว็บไซต์รวบรวมรายการที่เปิดรับ อัตราจ่าย และผลรางวัลไว้ให้ติดตาม พร้อมบันทึกรายละเอียดของโพยที่สมาชิกส่งเข้ามา ผลหวยในแต่ละรอบให้อ้างอิงประกาศอย่างเป็นทางการของหวยรายการนั้นเป็นหลัก แล้วจึงนำมาเทียบกับเลขและรอบที่อยู่ในโพย",
  },
  {
    q: "อัตราจ่ายในโพยไม่ตรงกับข้อความประชาสัมพันธ์ ต้องยึดอันไหน?",
    a: "ให้ยึดอัตราที่ระบบแสดงบนหน้าส่งโพยตอนกดยืนยัน เพราะเป็นอัตราที่ถูกบันทึกลงในโพยรายการนั้นจริง อัตรา 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท ใช้กับรายการที่เข้าเงื่อนไขเท่านั้น หวยแต่ละประเภทและรูปแบบการเดิมพันอาจมีเรทแตกต่างกัน",
  },
  {
    q: "ทำไมเลขที่เลือกไว้ถึงส่งได้ไม่เท่ากับที่ตั้งใจ?",
    a: "เลขเด็ดหรือเลขที่มีผู้เลือกจำนวนมากอาจมีวงเงินที่ระบบเปิดรับต่างจากเลขทั่วไป ยอดที่ส่งได้จึงเป็นยอดสูงสุดที่ระบบเปิดรับของเลขนั้นในรอบนั้น คำว่าไม่อั้นจ่ายไม่ได้หมายความว่าทุกเลขหรือทุกรอบจะไม่มีวงเงินสูงสุด ควรดูวงเงินที่ระบบแสดงก่อนกดยืนยันทุกครั้ง",
  },
  {
    q: `ตรวจผลหรือเปิดประวัติรายการไม่ได้ ติดต่อ ${BRAND_NAME} อย่างไร?`,
    a: `เปิดประวัติรายการในบัญชีดูก่อนเป็นอันดับแรก หากยังพบความผิดปกติ ติดต่อแอดมิน ${BRAND_NAME} ผ่านช่องทางบริการที่เว็บไซต์กำหนดได้ตลอด 24 ชั่วโมง พร้อมแจ้งชื่อหวย รอบเวลา เลขที่เลือก และข้อมูลรายการ โดยไม่ควรส่งรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น`,
  },
];

// 150–160 CHARACTERS (นับตัวอักษร ไม่ใช่ไบต์ — ห้ามใช้ wc -c) ปัจจุบัน 156 ตัวอักษร
const pageDescription = `ตรวจหวย ${BRAND_NAME} รวมวิธีตรวจผลรางวัลรัฐบาลไทย หวยลาว หวยฮานอย หวยออมสิน และหวย ธ.ก.ส. พร้อมเปิดประวัติรายการในบัญชีเพื่อเทียบเลข ยอดเดิมพัน และอัตราจ่ายในโพย`;

const pageHeading = `ตรวจหวย ${BRAND_NAME} ตรวจผลรางวัลและประวัติรายการ รัฐบาลไทย ลาว ฮานอย ออมสิน ธ.ก.ส.`;

const graph = pageGraph(Astro, {
  name: pageHeading,
  description: pageDescription,
  faqs,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ตรวจหวย", path: "/ตรวจหวย" },
  ],
});
---

<MainLayout title={`ตรวจหวย ${BRAND_NAME} ตรวจผลรางวัลและประวัติรายการโพย`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#f3c54e]">{BRAND_NAME}</strong> รวบรวมรายการหวยยอดนิยมและแนวทางตัวเลขไว้ให้ติดตามก่อนหวยออก ทั้งรัฐบาลไทยตามกำหนดออกรางวัล หวยลาว หวยฮานอย หวยออมสิน และหวย ธ.ก.ส. ตามรายการที่เปิดให้บริการ
        พร้อมข้อมูลเวลาเปิดรับ เวลาปิดรับ อัตราจ่าย และผลรางวัล หน้านี้รวมวิธีใช้ข้อมูลเหล่านั้นตรวจรายการของตัวเอง ตั้งแต่ Login เข้าบัญชีสมาชิก เปิดประวัติรายการ เลือกรายการหวยและรอบให้ตรงกับโพยที่ส่งไว้
        ไปจนถึงการเทียบเลขกับผลรางวัลของรอบนั้น
      </p>

      <p>
        <strong class="text-[#f3c54e]">หน้านี้ไม่มีตัวเลขของรอบใด ไม่ประกาศผลรางวัลเอง และไม่ทำนายเลข</strong> สิ่งที่ระบบบันทึกไว้คือรายละเอียดของโพยที่สมาชิกส่งเข้ามา ได้แก่ ชื่อหวย รอบ เลขที่เลือก ยอดเดิมพัน
        และอัตราจ่ายที่แสดงตอนกดยืนยัน ส่วนการอ่านผลหวยให้อ้างอิงประกาศอย่างเป็นทางการของหวยรายการนั้นเป็นหลัก แล้วจึงนำมาเทียบกับเลขและรอบที่อยู่ในโพยของตัวเอง
      </p>

      <p>
        บัญชีเดียวใช้ติดตามรัฐบาลไทย หวยลาว หวยฮานอย หวยออมสิน หวย ธ.ก.ส. รวมถึงแนวทาง ผลรางวัล และประวัติรายการได้ทั้งหมด ส่วนแนวทางและสถิติย้อนหลังที่แสดงไว้เป็นข้อมูลประกอบเท่านั้น
        <strong class="text-[#f3c54e]">ไม่สามารถการันตีว่าเลขจะเข้าทุกงวดหรือรับประกันผลรางวัลล่วงหน้าได้</strong> และเวลารับแทงของแต่ละรอบยังขึ้นอยู่กับเวลาเปิดรับและเวลาปิดรับที่ระบบแสดง จึงควรตรวจสอบก่อนส่งโพยทุกครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBoxNeumorphism as="h2" title="ขั้นตอนตรวจผลรางวัลและเทียบเลขในโพยของตัวเอง">
    <div class="flex flex-col gap-6">
      <p>ลำดับด้านล่างเป็นลำดับเดียวกับที่ระบบเก็บข้อมูลไว้ คือเข้าบัญชี เลือกรายการและรอบ แล้วจึงอ่านรายละเอียดของโพย ทำตามลำดับนี้จะตัดปัญหาการอ่านข้ามรายการหรือข้ามรอบออกไปได้เกือบทั้งหมด</p>

      <ul class="grid grid-cols-1 gap-4 md:grid-cols-3" aria-label="ขั้นตอนตรวจผลรางวัลและเปิดประวัติรายการด้วยตัวเอง">
        {
          steps.map((step, i) => (
            <li class="flex flex-col gap-2 rounded-2xl border border-[#dc0409]/45 bg-[#0d0407]/70 p-5 transition-colors hover:border-[#f3c54e]/60">
              <div class="flex items-center gap-3">
                <span aria-hidden="true" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gradient-to-b from-[#f3c54e] to-[#9a6d16] text-sm font-black text-[#0d0407]">
                  {i + 1}
                </span>
                <span aria-hidden="true" class="text-xl">
                  {step.icon}
                </span>
                <span class="text-base font-black tracking-wide text-[#f3c54e]">{step.label}</span>
              </div>
              <p>{step.detail}</p>
            </li>
          ))
        }
      </ul>

      <div class="flex flex-col gap-4 sm:flex-row sm:justify-center">
        <a
          href="/login"
          class="flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#9a6d16] via-[#f3c54e] to-[#9a6d16] px-8 py-4 font-black text-[#0d0407] shadow-[0_5px_15px_rgba(243,197,78,0.4)] transition-transform hover:scale-105">
          <span aria-hidden="true">🔒</span> เข้าสู่ระบบเพื่อตรวจโพย
        </a>
        <a
          href="/register"
          class="flex items-center justify-center gap-2 rounded-xl border border-[#dc0409]/60 bg-[#0d0407] px-8 py-4 font-bold text-[#f3c54e] shadow-[0_5px_15px_rgba(0,0,0,0.6)] transition-colors hover:bg-[#211016]">
          <span aria-hidden="true">⚡</span> สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBoxNeumorphism>

  <ContentBox3ThreeNeumorphism
    as="h2"
    title="รายการหวยที่ติดตามผลได้ รัฐบาลไทย หวยลาว หวยฮานอย หวยออมสิน และหวย ธ.ก.ส."
    heading={false}
    titleleft="หวยรัฐบาลไทย"
    titlecenter="หวยลาว และหวยฮานอย"
    titleright="หวยออมสิน และหวย ธ.ก.ส.">
    <p slot="left">หวยรัฐบาลไทยเปิดรับตามกำหนดออกรางวัลของรายการนั้น เลข 2 ตัวและเลข 3 ตัวใช้ตัดสินคนละรูปแบบกัน จึงควรดูรูปแบบการเดิมพันที่บันทึกไว้ในโพยประกอบด้วย ไม่ใช่ดูเฉพาะตัวเลข</p>
    <p slot="center">
      หวยลาวและหวยฮานอยเปิดรับตามรายการและรอบที่ระบบกำหนด ก่อนส่งโพยให้เลือกรอบให้ตรงกับที่ตั้งใจ แล้วเทียบเลขในโพยกับผลรางวัลของรอบเดียวกันเมื่อมีประกาศผล
      เพราะเลขชุดเดียวกันอาจถูกส่งไว้มากกว่าหนึ่งรอบ
    </p>
    <p slot="right">
      หวยออมสินและหวย ธ.ก.ส. เปิดรับตามรายการที่เปิดให้บริการ ประวัติรายการเก็บชื่อหวยไว้คู่กับรอบและเลขเสมอ จึงควรอ่านชื่อรายการในบรรทัดนั้นให้ตรงก่อน แล้วค่อยเทียบกับผลรางวัลของรายการเดียวกัน
    </p>
  </ContentBox3ThreeNeumorphism>

  <ContentBox as="h2" title="อัตราจ่ายที่บันทึกไว้ในโพย 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท">
    <div class="flex flex-col gap-6">
      <p>
        {BRAND_NAME} แสดงอัตราจ่ายของแต่ละรูปแบบไว้บนหน้าส่งโพยให้ตรวจสอบก่อนยืนยัน อัตราสำหรับรายการที่เข้าเงื่อนไขคือ
        <strong class="text-[#f3c54e]">2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท</strong> แต่
        <strong class="text-[#f3c54e]">หวยแต่ละประเภทและรูปแบบการเดิมพันอาจมีเรทแตกต่างกัน</strong>
        โดยเฉพาะเลข 3 ตัวที่มีได้หลายรูปแบบ จึงควรยึดอัตราล่าสุดบนหน้าส่งโพยเป็นหลัก หากข้อมูลบนหน้าส่งโพยต่างจากข้อความประชาสัมพันธ์ ให้ยึดอัตราที่ระบบแสดงก่อนกดยืนยันรายการ
      </p>

      <p>
        อัตราที่เห็นตอนกดยืนยันจะถูกบันทึกลงในโพยพร้อมกับชื่อหวย รอบ เลขที่เลือก และยอดเดิมพัน จึงเปิดย้อนดูได้เสมอว่ารายการนั้นคิดจากอัตราเท่าไร และนำไปเทียบกับผลรางวัลของรอบเดียวกันได้โดยตรง
        สำหรับเลขเด็ดหรือเลขที่มีผู้เลือกจำนวนมาก ควรตรวจสอบ <strong class="text-[#f3c54e]">วงเงินที่ระบบเปิดรับ</strong> ก่อนยืนยัน เพราะคำว่าไม่อั้นจ่ายไม่ได้หมายความว่าทุกเลขหรือทุกรอบจะไม่มีวงเงินสูงสุด
        เงื่อนไขจริงให้ยึดข้อมูลที่แสดงบนหน้าส่งโพยเป็นหลัก
      </p>

      <p>
        คำว่า <strong class="text-[#f3c54e]">ไม่มีลบโพย</strong> หมายถึงโพยที่ระบบรับและยืนยันอย่างสมบูรณ์ตามเงื่อนไขแล้ว ส่วนกรณีรายการผิดพลาด เป็นโมฆะ หรือเหตุอื่น ให้เป็นไปตามข้อกำหนดที่เว็บไซต์ประกาศไว้
        ผู้ที่ยังไม่มีบัญชีสมัครเองได้ผ่านมือถือใน 3 ขั้นตอน คือ เปิดหน้าสมัครและกรอกข้อมูลตามที่ระบบกำหนด ยืนยันข้อมูลและ Login เข้าบัญชีสมาชิก แล้วเลือกประเภทหวย รอบ และเลขที่ต้องการ พร้อมตรวจสอบอัตราจ่ายก่อนส่งโพย
        ประวัติรายการจะเก็บทุกโพยที่ส่งไว้ในบัญชีนั้นให้ย้อนกลับมาตรวจผลได้
      </p>
    </div>
  </ContentBox>

