---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ContentBoxHuay from "../components/ContentBoxHuay.astro";
import LatestWinnersHuay from "../components/LatestWinnersHuay.astro";
import FaqHuay from "../components/FaqHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้ว่าด้วย "วิธีตรวจผลรางวัลและตรวจสถานะโพยของตัวเอง" — ไม่มีผลรางวัลจริง
// ไม่มีวันที่งวด ไม่มีเลขเด็ด และไม่มีการทำนายใด ๆ อยู่บนหน้านี้ เว็บไม่ได้เป็น
// ผู้ประกาศผล ให้ยึดผลอย่างเป็นทางการของหวยแต่ละประเภทเป็นหลัก และถ้ารายการนั้น
// มีหลายรอบต่อวัน ต้องเทียบชื่อรายการกับเวลาของรอบให้ตรงก่อนคำนวณผลรางวัล
// (src/assets/content.txt L8)
//
// ข้อเท็จจริงทั้งหมดยึดตาม src/assets/content.txt ของรอบนี้เท่านั้น: รวมรายการ
// หวยยอดนิยมไว้ในบัญชีเดียว — รัฐบาลไทย ลาวพัฒนา ฮานอยปกติ/พิเศษ/วีไอพี และ
// หวยหุ้นต่างประเทศ · เลือกเลข ส่งโพย ตรวจสอบรายการ ดูอัตราจ่าย และผลหวยตามรอบ
// ที่เปิดให้บริการได้จากระบบเดียว · รองรับการใช้งานผ่านมือถือ · อัตราจ่ายของ
// รายการที่ร่วมเงื่อนไขคือ 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท ซึ่ง
// ขึ้นกับประเภทหวยและรูปแบบการเดิมพัน จึงต้องยึดตัวเลขที่ระบบแสดงในหน้าส่งโพย
// ก่อนยืนยัน · สมัคร 3 ขั้นตอน · แอดมินติดต่อได้ 24 ชั่วโมง
// ห้ามเติมผลรางวัล วันที่งวด สถิติย้อนหลัง เวลาออกรางวัลรายรายการ ใบอนุญาต ชื่อ
// ธนาคาร ยอดฝาก-ถอนขั้นต่ำ หรือตัวเลขอื่นนอกชุด 2 ตัว 100 / 3 ตัว 1,000 /
// 3 ขั้นตอน / 24 ชั่วโมง และห้ามใช้คำนอกหมวดหวยทุกคำ
//
// หน้านี้ใช้ข้อยกเว้น "หมวดหวยคงธีม Huay" ของ SKILL.md Phase 4.5 ข้อ 5: ธีม
// แดง-ทอง-ดำ ของ /ตรวจหวย กับ /แนวทาง เป็นของหมวดหวยโดยตั้งใจ และ "ไม่" ถูกดึง
// ไปพาเลตต์เขียว-ทองของแบรนด์รอบนี้ ยกเว้นเฉพาะสีเท่านั้น — ชื่อแบรนด์และคำศัพท์
// ต้องเป็นของรอบปัจจุบันทั้งหมด ชื่อแบรนด์จึงมาจาก BRAND_NAME ไม่พิมพ์ทับ
//
// การ์ดขั้นตอนด้านล่างเป็น chrome ไม่ใช่หัวข้อบทความ ป้ายจึงเป็น <span> และชื่อ
// ของชุดการ์ดไปอยู่บน aria-label ของ <ul> (บทบาท list รับชื่อได้จริง ต่างจาก
// <div> เปล่าที่ aria-label ไม่ถูกประกาศ)
const steps = [
  {
    icon: "🔐",
    label: "Login แล้วเปิดประวัติโพย",
    detail: "เข้าสู่ระบบบัญชีสมาชิกผ่านเบราว์เซอร์บนมือถือหรือคอมพิวเตอร์ แล้วเปิดประวัติรายการในหมวดหวยที่ต้องการตรวจ โดยใช้บัญชีเดียวกับที่ส่งโพยไว้",
  },
  {
    icon: "🎯",
    label: "เลือกรายการและรอบให้ตรงกับโพย",
    detail: "เลือกหวยที่แทงไว้ ทั้งรัฐบาลไทย ลาวพัฒนา ฮานอย หรือหวยหุ้นต่างประเทศ แล้วเทียบชื่อรายการและเวลาของรอบให้ตรงกับโพยที่ส่งไว้ก่อนอ่านผล",
  },
  {
    icon: "🧾",
    label: "อ่านเลข ยอด และสถานะในโพย",
    detail: "ระบบแสดงเลขที่เลือก ยอดเดิมพัน และอัตราจ่ายที่บันทึกไว้ตอนยืนยันโพย พร้อมสถานะของรายการที่อัปเดตหลังการตรวจสอบเสร็จสิ้น",
  },
];

const faqs = [
  {
    q: `ตรวจผลหวยกับ ${BRAND_NAME} ดูได้จากรายการไหนบ้าง?`,
    a: "ในบัญชีเดียวมีทั้งหวยรัฐบาลไทย ลาวพัฒนา ฮานอยปกติ ฮานอยพิเศษ ฮานอยวีไอพี และหวยหุ้นต่างประเทศ โดยรายการที่เปิดรับและรอบของแต่ละวันอาจต่างกัน จึงควรเปิดดูรายการล่าสุดที่ระบบแสดงก่อน แล้วค่อยเทียบผลอย่างเป็นทางการของหวยประเภทนั้นกับเลขในโพยของรอบเดียวกัน",
  },
  {
    q: "อัตรา 2 ตัวจ่าย 100 และ 3 ตัวจ่าย 1,000 ใช้กับทุกรายการหรือไม่?",
    a: "ไม่ควรถือว่าเป็นอัตราเดียวกันทุกประเภท อัตราจ่ายขึ้นอยู่กับประเภทหวยและรูปแบบการเดิมพันที่ร่วมเงื่อนไข สมาชิกจึงควรยึดอัตราที่แสดงในหน้าส่งโพยของรอบนั้นก่อนยืนยันรายการเป็นหลัก",
  },
  {
    q: "เปิดดูโพยย้อนหลังของตัวเองได้ที่ไหน?",
    a: "เข้าสู่ระบบแล้วเปิดประวัติรายการในบัญชีสมาชิกได้ด้วยตัวเอง ระบบจะแสดงรายการและรอบที่ส่ง เลขที่เลือก ยอดเดิมพัน และอัตราจ่ายที่บันทึกไว้ตอนกดยืนยัน ทำให้เทียบกับสถานะที่อัปเดตหลังตรวจสอบเสร็จได้ทันที",
  },
  {
    q: "สถานะโพยไม่ตรงกับที่ส่งไว้ ต้องทำอย่างไร?",
    a: `ตรวจสอบประวัติโพยและประวัติเครดิตในบัญชีก่อนเป็นอันดับแรก หากยังพบความผิดปกติ ติดต่อแอดมิน ${BRAND_NAME} ผ่านช่องทางบริการที่เว็บไซต์กำหนดได้ตลอด 24 ชั่วโมง พร้อมแจ้งชื่อรายการ รอบเวลา เลขที่เลือก และข้อมูลรายการที่เกี่ยวข้อง โดยไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น`,
  },
];

// 150–160 CHARACTERS (นับตัวอักษร ไม่ใช่ไบต์ — ห้ามใช้ wc -c) ปัจจุบัน 155 ตัวอักษร
const pageDescription = `ตรวจหวย ${BRAND_NAME} รวมวิธีเช็กผลรางวัลและสถานะโพยของรัฐบาลไทย ลาวพัฒนา ฮานอย และหวยหุ้นต่างประเทศ พร้อมขั้นตอนเปิดประวัติรายการย้อนหลังในบัญชีสมาชิกด้วยตัวเอง`;

const graph = pageGraph(Astro, {
  name: `ตรวจหวย ${BRAND_NAME} เช็กผลรางวัลและสถานะโพยด้วยตัวเอง`,
  description: pageDescription,
  faqs,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ตรวจหวย", path: "/ตรวจหวย" },
  ],
});
---

<MainLayout title={`ตรวจหวย ${BRAND_NAME} เช็กผลรัฐบาลไทย ลาวพัฒนา ฮานอย หวยหุ้น และสถานะโพย`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxHuay title={`ตรวจหวย ${BRAND_NAME} เช็กผลรางวัลและสถานะโพยด้วยตัวเอง`} as="h1">
    <div class="flex flex-col gap-6">
      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        หน้านี้รวมวิธีตรวจผลรางวัลและตรวจสถานะโพยของตัวเองกับ <strong class="text-[#fff4f4]">{BRAND_NAME}</strong> ตั้งแต่เปิดประวัติรายการในบัญชีสมาชิก ดูเลขที่เลือกและยอดเดิมพันที่ส่งไว้ ไปจนถึงการอ่านสถานะของรายการหลังระบบตรวจสอบเสร็จ
        โดยระบบรวมรายการหวยยอดนิยมไว้ในบัญชีเดียว ทั้งหวยรัฐบาลไทย ลาวพัฒนา ฮานอยปกติ ฮานอยพิเศษ ฮานอยวีไอพี และหวยหุ้นต่างประเทศ จึงเลือกดูรายการที่ต้องการได้จากหน้าเว็บไซต์บนเบราว์เซอร์มือถือโดยไม่ต้องสลับหลายเว็บไซต์
      </p>

      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        หน้านี้ไม่มีเลขเด็ด ไม่มีการทำนายผล และไม่ได้ประกาศผลรางวัลของงวดใดเอง
        <strong class="text-[#fff4f4]">การตรวจผลควรอ้างอิงผลอย่างเป็นทางการของหวยแต่ละประเภท</strong> และหากรายการนั้นมีหลายรอบต่อวัน ควรตรวจสอบชื่อรายการและเวลาของรอบให้ตรงกันก่อนคำนวณผลรางวัล ส่วนรอบที่เปิดรับ
        เวลาปิดรับ และอัตราจ่าย ให้ยึดตัวเลขที่ระบบแสดงในหน้าส่งโพยของรอบนั้นเป็นหลัก
      </p>

      <ul class="grid grid-cols-1 gap-4 md:grid-cols-3" aria-label="ขั้นตอนตรวจผลหวยและสถานะโพยด้วยตัวเอง">
        {
          steps.map((step, i) => (
            <li class="flex flex-col gap-2 rounded-2xl border border-[#2a0d0f] bg-[#120b0c]/75 p-5 transition-colors hover:border-[#f3c623]/55">
              <div class="flex items-center gap-3">
                <span aria-hidden="true" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gradient-to-b from-[#fde79a] to-[#8a6a0a] text-sm font-black text-[#1a0203]">
                  {i + 1}
                </span>
                <span aria-hidden="true" class="text-xl">
                  {step.icon}
                </span>
                <span class="text-base font-black tracking-wide text-[#f3c623]">{step.label}</span>
              </div>
              <p class="text-left text-base leading-relaxed text-[#f0e2e2]">{step.detail}</p>
            </li>
          ))
        }
      </ul>

      <div class="flex flex-col gap-4 sm:flex-row sm:justify-center">
        <a
          href="/login"
          class="flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#8a6a0a] via-[#f3c623] to-[#8a6a0a] px-8 py-4 font-black text-[#1a0203] shadow-[0_5px_15px_rgba(243,198,35,0.4)] transition-transform hover:scale-105">
          <span aria-hidden="true">🔒</span> เข้าสู่ระบบเพื่อตรวจโพย
        </a>
        <a
          href="/register"
          class="flex items-center justify-center gap-2 rounded-xl border border-[#8a6a0a]/60 bg-[#2a0d0f] px-8 py-4 font-bold text-[#f3c623] shadow-[0_5px_15px_rgba(5,1,2,0.6)] transition-colors hover:bg-[#1f0a0c]">
          <span aria-hidden="true">⚡</span> สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBoxHuay>

  <ContentBoxHuay title="ตรวจผลหวยให้ตรงประเภทและตรงรอบก่อนคำนวณผลรางวัล" as="h2">
    <div class="flex flex-col gap-6">
      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        เมื่อรอบที่คุณส่งโพยไว้ประกาศผลแล้ว ให้เทียบเลขในโพยกับ <strong class="text-[#fff4f4]">ผลอย่างเป็นทางการของหวยประเภทเดียวกันและรอบเดียวกับที่แทงจริง</strong>
        เพราะหวยรัฐบาลไทย ลาวพัฒนา ฮานอย และหวยหุ้นต่างประเทศ ต่างมีตารางเวลาและการประกาศผลเป็นของตัวเอง ฮานอยยังแยกเป็นรอบปกติ รอบพิเศษ และรอบวีไอพี ส่วนเลขชุดเดียวกันก็ใช้ตัดสินคนละรูปแบบการเดิมพันกัน
        ทั้งเลข 2 ตัวและเลข 3 ตัว การอ่านข้ามรายการหรือข้ามรอบจึงเป็นสาเหตุที่พบบ่อยที่สุดของการเข้าใจว่าโพยไม่ถูกรางวัล
      </p>

      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        สมาชิกเปิดดูโพยย้อนหลังได้เองจากบัญชี ระบบบันทึกทั้งชื่อรายการและรอบที่ส่ง เลขที่เลือก ยอดเดิมพัน และอัตราจ่ายที่แสดงไว้ตอนยืนยัน จึงย้อนกลับไปตรวจได้ว่ารายการที่ส่งไป ตรงกับที่ตั้งใจหรือไม่
        และเมื่อระบบตรวจสอบเสร็จ สถานะของโพยจะอัปเดตพร้อมยอดที่เข้าบัญชีสมาชิก หากพบว่าเลขหรือรอบไม่ตรงกับที่ต้องการ ให้เก็บรายละเอียดของโพยนั้นไว้แล้วแจ้งแอดมินตรวจสอบ
        แทนการคำนวณผลด้วยตัวเองจากรอบอื่น
      </p>
    </div>
  </ContentBoxHuay>

  <ContentBoxHuay title="อัตราจ่ายที่บันทึกไว้ในโพย 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท" as="h2">
    <div class="flex flex-col gap-6">
      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        {BRAND_NAME} แสดงอัตราจ่ายของแต่ละรูปแบบให้ตรวจสอบได้จากหน้าส่งโพยก่อนยืนยันการเดิมพัน โดยอัตราของรายการที่ร่วมเงื่อนไขคือ
        <strong class="text-[#fff4f4]">2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท</strong> แต่ <strong class="text-[#fff4f4]">อัตราจ่ายจริงขึ้นอยู่กับประเภทหวยและรูปแบบการเดิมพันที่ระบบกำหนด</strong>
        จึงควรยึดตัวเลขที่ระบบแสดงก่อนยืนยันโพยเป็นหลัก ไม่ใช่ตัวเลขที่จำมาจากรอบก่อนหน้า
      </p>

      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        ก่อนกดยืนยันทุกครั้งจึงควรไล่อ่านให้ครบทั้ง <strong class="text-[#fff4f4]">รายการหวยที่เลือก รอบที่เปิดรับ รูปแบบการเดิมพัน อัตราจ่าย และเวลาปิดรับ</strong> ที่ระบบแสดงของรอบนั้น โดยเฉพาะเลข 3 ตัวและรูปแบบอื่นที่อาจมีหลักเกณฑ์คำนวณเงินรางวัลแตกต่างกัน
        เมื่อทุกอย่างตรงกับที่ตั้งใจแล้วค่อยยืนยัน ขั้นตอนนี้ใช้เวลาไม่นาน แต่ตัดปัญหาการส่งผิดรอบหรือผิดรูปแบบออกไปได้เกือบทั้งหมด และทำให้การตรวจผลหลังรอบจบเหลือแค่การเทียบเลขกับผลที่ประกาศ
      </p>

      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
