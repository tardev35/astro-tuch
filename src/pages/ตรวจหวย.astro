---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ContentBoxHuay from "../components/ContentBoxHuay.astro";
import LatestWinnersHuay from "../components/LatestWinnersHuay.astro";
import FaqHuay from "../components/FaqHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้ว่าด้วย "วิธีเช็คผลรางวัลและตรวจสถานะโพยของตัวเอง" — ไม่มีผลรางวัลจริง
// ไม่มีวันที่งวด ไม่มีเลขเด็ดของงวดใด และไม่มีการทำนายใด ๆ อยู่บนหน้านี้ เว็บไม่ได้
// เป็นผู้ประกาศผล ให้ยึดผลอย่างเป็นทางการของหวยแต่ละประเภทเป็นหลัก และถ้ารายการนั้น
// มีหลายรอบต่อวัน ต้องเทียบชื่อรายการกับเวลาของรอบให้ตรงก่อนคำนวณผลรางวัล
//
// ข้อเท็จจริงทั้งหมดยึดตาม src/assets/content.txt ของรอบนี้เท่านั้น: เปิดรับแทงหวย
// ออนไลน์ เลขเด็ด เลขดัง ผ่านบัญชีเดียว ครบทั้งหวยรัฐบาลไทย หวยฮานอย หวยลาว และ
// หวยหุ้นต่างประเทศ (ลำดับตามบรีฟ) · เลือกเลข ส่งโพย ตรวจสอบรายการ และเช็คผลได้
// จากหน้าเว็บไซต์ · รองรับการใช้งานผ่านมือถือ · อัตราจ่ายของรายการที่เข้าเงื่อนไข
// คือ 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท ซึ่งอาจแตกต่างกันตามประเภทหวย
// และรูปแบบการเดิมพัน จึงต้องยึดตัวเลขที่ระบบแสดงในหน้าส่งโพยก่อนยืนยัน · สมัคร
// 3 ขั้นตอน · แอดมินติดต่อได้ 24 ชั่วโมง
//
// คำว่า "ไม่จำกัด" และ "แทงได้ไม่อั้น" ต้องมาพร้อมเฮดจ์ของบรีฟเสมอ คืออ้างอิงวงเงิน
// ที่ระบบเปิดรับจริงของแต่ละประเภทหวย แต่ละเลข และแต่ละรอบ (content.txt L5)
//
// รายการย่อยและมุมของบรีฟรอบก่อน (ลาวพัฒนา · ฮานอยปกติ/พิเศษ/วีไอพี ·
// "ฝากถอนวอลเลทและธนาคาร" · "เช็คผลทันที") ไม่ได้อยู่ในบรีฟรอบนี้ จึงไม่ปรากฏบน
// หน้านี้ ห้ามเติมผลรางวัล วันที่งวด สถิติย้อนหลัง เวลาออกรางวัลรายรายการ ใบอนุญาต
// ชื่อธนาคาร ยอดฝาก-ถอนขั้นต่ำ หรือตัวเลขอื่นนอกชุด 2 ตัว 100 / 3 ตัว 1,000 /
// 3 ขั้นตอน / 24 ชั่วโมง และห้ามใช้คำนอกหมวดหวยทุกคำ
//
// หน้านี้ใช้ข้อยกเว้น "หมวดหวยคงธีม Huay" ของ SKILL.md Phase 4.5 ข้อ 5: รูปทรง
// แดง-ทอง-ดำ ของ /ตรวจหวย กับ /แนวทาง เป็นของหมวดหวยโดยตั้งใจ และยังใช้
// AnnouncementHuay ต่อ ไม่สลับไป Announcement2 เหมือนหน้าอื่น — ข้อยกเว้นครอบเฉพาะ
// ธีมเท่านั้น ชื่อแบรนด์และเนื้อหาต้องเป็นของรอบปัจจุบันทั้งหมด ชื่อแบรนด์จึงมาจาก
// BRAND_NAME ไม่พิมพ์ทับ และค่าสีถูกขยับมาใช้เลขจริงของ brand-spec §2 รอบนี้
// (#2b0909 / #1c0606 / #5c0a0a / #a8690c / #d99a10 / #f4bc5d / #ffefc2 /
// #dc2224 / #e43434 / #fbe3d4) แทนค่าใกล้เคียงของแบรนด์ก่อนหน้า
//
// การ์ดขั้นตอนด้านล่างเป็น chrome ไม่ใช่หัวข้อบทความ ป้ายจึงเป็น <span> และชื่อ
// ของชุดการ์ดไปอยู่บน aria-label ของ <ul> (บทบาท list รับชื่อได้จริง ต่างจาก
// <div> เปล่าที่ aria-label ไม่ถูกประกาศ)
const steps = [
  {
    icon: "🔐",
    label: "Login แล้วเปิดประวัติโพย",
    detail: "เข้าสู่ระบบบัญชีสมาชิกผ่านเบราว์เซอร์บนมือถือหรือคอมพิวเตอร์ แล้วเปิดประวัติรายการในหมวดหวยที่ต้องการตรวจ โดยใช้บัญชีเดียวกับที่ส่งโพยไว้",
  },
  {
    icon: "🎯",
    label: "เลือกรายการและรอบให้ตรงกับโพย",
    detail: "เลือกหวยที่แทงไว้ ทั้งหวยรัฐบาลไทย หวยฮานอย หวยลาว หรือหวยหุ้นต่างประเทศ แล้วเทียบชื่อรายการและเวลาของรอบให้ตรงกับโพยที่ส่งไว้ก่อนอ่านผล",
  },
  {
    icon: "🧾",
    label: "อ่านเลข ยอด และสถานะในโพย",
    detail: "ระบบแสดงเลขที่เลือก ยอดเดิมพัน และอัตราจ่ายที่บันทึกไว้ตอนยืนยันโพย พร้อมสถานะของรายการที่อัปเดตหลังการตรวจสอบเสร็จสิ้น",
  },
];

const faqs = [
  {
    q: `เช็คผลหวยกับ ${BRAND_NAME} ดูได้จากรายการไหนบ้าง?`,
    a: "ในบัญชีเดียวมีทั้งหวยรัฐบาลไทย หวยฮานอย หวยลาว และหวยหุ้นต่างประเทศ โดยรายการที่เปิดรับและรอบของแต่ละวันอาจต่างกัน จึงควรเปิดดูรายการล่าสุดที่ระบบแสดงก่อน แล้วค่อยเทียบผลอย่างเป็นทางการของหวยประเภทนั้นกับเลขในโพยของรอบเดียวกัน",
  },
  {
    q: "อัตรา 2 ตัวจ่าย 100 และ 3 ตัวจ่าย 1,000 ใช้กับทุกรายการหรือไม่?",
    a: "ไม่ควรถือว่าเป็นอัตราเดียวกันทุกประเภท อัตราจ่ายอาจแตกต่างกันตามประเภทหวยและรูปแบบการเดิมพัน สมาชิกจึงควรยึดอัตรา 2 ตัวและ 3 ตัวที่แสดงในหน้าส่งโพยของรอบนั้นก่อนยืนยันรายการเป็นหลัก",
  },
  {
    q: "เลขเด็ด เลขดัง ที่เลือกไว้ส่งได้ไม่จำกัดจริงหรือไม่?",
    a: "เลือกเลขที่ต้องการได้ตามรายการที่ระบบเปิดรับ แต่จำนวนเงินสูงสุดอาจขึ้นอยู่กับประเภทหวย รอบ และวงเงินของเลขนั้น จึงควรตรวจสอบยอดที่ระบบอนุญาตก่อนยืนยันโพย โดยเฉพาะเลขที่มีผู้เลือกจำนวนมาก",
  },
  {
    q: "เปิดดูโพยย้อนหลังของตัวเองได้ที่ไหน?",
    a: "เข้าสู่ระบบแล้วเปิดประวัติรายการในบัญชีสมาชิกได้ด้วยตัวเอง ระบบจะแสดงรายการและรอบที่ส่ง เลขที่เลือก ยอดเดิมพัน และอัตราจ่ายที่บันทึกไว้ตอนกดยืนยัน ทำให้เทียบกับสถานะที่อัปเดตหลังตรวจสอบเสร็จได้จากหน้าเดียว",
  },
  {
    q: "สถานะโพยไม่ตรงกับที่ส่งไว้ ต้องทำอย่างไร?",
    a: `ตรวจสอบประวัติรายการในบัญชีก่อนเป็นอันดับแรก หากยังพบความผิดปกติ ติดต่อแอดมิน ${BRAND_NAME} ผ่านช่องทางบริการที่เว็บไซต์กำหนดได้ตลอด 24 ชั่วโมง พร้อมแจ้งชื่อรายการ รอบเวลา เลขที่เลือก และข้อมูลรายการที่เกี่ยวข้อง โดยไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น`,
  },
];

// 150–160 CHARACTERS (นับตัวอักษร ไม่ใช่ไบต์ — ห้ามใช้ wc -c) ปัจจุบัน 151 ตัวอักษร
const pageDescription = `ตรวจหวย ${BRAND_NAME} รวมวิธีเช็คผลและตรวจสถานะโพยของหวยรัฐบาลไทย ฮานอย ลาว และหุ้นต่างประเทศ พร้อมขั้นตอนเปิดประวัติรายการในบัญชีสมาชิกเทียบกับผลที่ประกาศ`;

const graph = pageGraph(Astro, {
  name: `ตรวจหวย ${BRAND_NAME} เช็คผลรางวัลและสถานะโพยด้วยตัวเอง`,
  description: pageDescription,
  faqs,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ตรวจหวย", path: "/ตรวจหวย" },
  ],
});
---

<MainLayout title={`ตรวจหวย ${BRAND_NAME} เช็คผลหวยรัฐบาลไทย ฮานอย ลาว หุ้นต่างประเทศ และสถานะโพย`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxHuay title={`ตรวจหวย ${BRAND_NAME} เช็คผลรางวัลและสถานะโพยด้วยตัวเอง`} as="h1">
    <div class="flex flex-col gap-6">
      <p class="text-left text-base leading-relaxed text-[#fbe3d4]">
        หน้านี้รวมวิธีเช็คผลรางวัลและตรวจสถานะโพยของตัวเองกับ <strong class="text-[#ffefc2]">{BRAND_NAME}</strong> ตั้งแต่เปิดประวัติรายการในบัญชีสมาชิก ดูเลขที่เลือกและยอดเดิมพันที่ส่งไว้ ไปจนถึงการอ่านสถานะของรายการหลังระบบตรวจสอบเสร็จ
        โดยบัญชีเดียวรวมรายการหวยไว้ครบทั้งหวยรัฐบาลไทย หวยฮานอย หวยลาว และหวยหุ้นต่างประเทศ จึงเลือกดูรายการที่ต้องการได้จากหน้าเว็บไซต์บนเบราว์เซอร์มือถือโดยไม่ต้องสลับใช้งานหลายบัญชี
      </p>

      <p class="text-left text-base leading-relaxed text-[#fbe3d4]">
        หน้านี้ไม่มีเลขเด็ดของงวดใด ไม่มีการทำนายผล และไม่ได้ประกาศผลรางวัลของงวดใดเอง
        <strong class="text-[#ffefc2]">การเช็คผลควรอ้างอิงการประกาศผลอย่างเป็นทางการของหวยแต่ละประเภท</strong> และหากรายการนั้นมีหลายรอบต่อวัน ควรตรวจสอบชื่อรายการและเวลาของรอบให้ตรงกันก่อนคำนวณผลรางวัล ส่วนเวลาปิดรับ
        อัตราจ่าย และวงเงินที่รับได้ ให้ยึดตัวเลขที่ระบบแสดงในหน้าส่งโพยของรอบนั้นเป็นหลัก
      </p>

      <ul class="grid grid-cols-1 gap-4 md:grid-cols-3" aria-label="ขั้นตอนเช็คผลหวยและสถานะโพยด้วยตัวเอง">
        {
          steps.map((step, i) => (
            <li class="flex flex-col gap-2 rounded-2xl border border-[#5c0a0a] bg-[#1c0606]/75 p-5 transition-colors hover:border-[#f4bc5d]/55">
              <div class="flex items-center gap-3">
                <span aria-hidden="true" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gradient-to-b from-[#ffefc2] to-[#d99a10] text-sm font-black text-[#1c0606]">
                  {i + 1}
                </span>
                <span aria-hidden="true" class="text-xl">
                  {step.icon}
                </span>
                <span class="text-base font-black tracking-wide text-[#f4bc5d]">{step.label}</span>
              </div>
              <p class="text-left text-base leading-relaxed text-[#fbe3d4]">{step.detail}</p>
            </li>
          ))
        }
      </ul>

      <div class="flex flex-col gap-4 sm:flex-row sm:justify-center">
        <a
          href="/login"
          class="flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#d99a10] via-[#ffefc2] to-[#d99a10] px-8 py-4 font-black text-[#1c0606] shadow-[0_5px_15px_rgba(244,188,93,0.4)] transition-transform hover:scale-105">
          <span aria-hidden="true">🔒</span> เข้าสู่ระบบเพื่อตรวจโพย
        </a>
        <a
          href="/register"
          class="flex items-center justify-center gap-2 rounded-xl border border-[#a8690c]/60 bg-[#5c0a0a] px-8 py-4 font-bold text-[#f4bc5d] shadow-[0_5px_15px_rgba(11,2,2,0.6)] transition-colors hover:bg-[#1c0606]">
          <span aria-hidden="true">⚡</span> สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBoxHuay>

  <ContentBoxHuay title="เช็คผลหวยให้ตรงประเภทและตรงรอบก่อนคำนวณผลรางวัล" as="h2">
    <div class="flex flex-col gap-6">
      <p class="text-left text-base leading-relaxed text-[#fbe3d4]">
        เมื่อรอบที่คุณส่งโพยไว้ประกาศผลแล้ว ให้เทียบเลขในโพยกับ <strong class="text-[#ffefc2]">การประกาศผลอย่างเป็นทางการของหวยประเภทเดียวกันและรอบเดียวกับที่แทงจริง</strong>
        เพราะหวยรัฐบาลไทย หวยฮานอย หวยลาว และหวยหุ้นต่างประเทศ ต่างมีกำหนดเวลาและการประกาศผลเป็นของตัวเอง บางรายการยังมีหลายรอบต่อวัน ส่วนเลขชุดเดียวกันก็ใช้ตัดสินคนละรูปแบบการเดิมพันกัน
        ทั้งเลข 2 ตัวและเลข 3 ตัว การอ่านข้ามรายการหรือข้ามรอบจึงเป็นสาเหตุที่พบบ่อยที่สุดของการเข้าใจว่าโพยไม่ถูกรางวัล
      </p>

      <p class="text-left text-base leading-relaxed text-[#fbe3d4]">
        สมาชิกเปิดดูโพยย้อนหลังได้เองจากบัญชี ระบบบันทึกทั้งชื่อรายการและรอบที่ส่ง เลขที่เลือก ยอดเดิมพัน และอัตราจ่ายที่แสดงไว้ตอนยืนยัน จึงย้อนกลับไปตรวจได้ว่ารายการที่ส่งไปตรงกับที่ตั้งใจหรือไม่
        และเมื่อระบบตรวจสอบเสร็จ สถานะของโพยจะอัปเดตในประวัติรายการของบัญชีสมาชิก หากพบว่าเลขหรือรอบไม่ตรงกับที่ต้องการ ให้เก็บรายละเอียดของโพยนั้นไว้แล้วแจ้งแอดมินตรวจสอบ
        แทนการคำนวณผลด้วยตัวเองจากรอบอื่น
      </p>
    </div>
  </ContentBoxHuay>

  <ContentBoxHuay title="อัตราจ่ายที่บันทึกไว้ในโพย 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท" as="h2">
    <div class="flex flex-col gap-6">
      <p class="text-left text-base leading-relaxed text-[#fbe3d4]">
        {BRAND_NAME} แสดงอัตราจ่ายของแต่ละรูปแบบให้ตรวจสอบได้จากหน้าส่งโพยก่อนยืนยันการเดิมพัน โดยอัตราของรายการที่เข้าเงื่อนไขคือ
        <strong class="text-[#ffefc2]">2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท</strong> แต่ <strong class="text-[#ffefc2]">อัตราจ่ายอาจแตกต่างกันตามประเภทหวยและรูปแบบการเดิมพัน</strong>
        จึงไม่ควรถือว่าใช้กับทุกรายการเหมือนกัน ให้ยึดตัวเลขที่ระบบแสดงก่อนยืนยันโพยเป็นหลัก ไม่ใช่ตัวเลขที่จำมาจากรอบก่อนหน้า
      </p>

      <p class="text-left text-base leading-relaxed text-[#fbe3d4]">
        ก่อนกดยืนยันทุกครั้งจึงควรไล่อ่านให้ครบทั้ง <strong class="text-[#ffefc2]">รายการหวยที่เลือก รอบที่เปิดรับ รูปแบบการเดิมพัน อัตราจ่าย เวลาปิดรับ และวงเงินที่ระบบเปิดรับของเลขนั้น</strong> ที่ระบบแสดงของรอบนั้น โดยเฉพาะเลข 3 ตัวและรูปแบบอื่นที่อาจมีหลักเกณฑ์คำนวณเงินรางวัลแตกต่างกัน
        เมื่อทุกอย่างตรงกับที่ตั้งใจแล้วค่อยยืนยัน ขั้นตอนนี้ใช้เวลาไม่นาน แต่ตัดปัญหาการส่งผิดรอบหรือผิดรูปแบบออกไปได้เกือบทั้งหมด และทำให้การเช็คผลหลังรอบจบเหลือแค่การเทียบเลขกับผลที่ประกาศ
      </p>

      <p class="text-left text-base leading-relaxed text-[#fbe3d4]">
        อัตราที่ใช้ตอนกดยืนยันจะถูกบันทึกลงในโพยพร้อมกับรอบที่ส่ง เลขที่เลือก และยอดเดิมพัน จึงเปิดดูย้อนหลังได้เสมอว่ารายการนั้นคิดจากอัตราเท่าไร และเทียบกับสถานะที่อัปเดตหลังตรวจสอบเสร็จได้โดยตรง
        สำหรับผู้ที่ยังไม่มีบัญชี การสมัครทำได้ผ่านมือถือด้วย 3 ขั้นตอน คือ กรอกข้อมูลตามที่ระบบกำหนด ยืนยันข้อมูลและ Login เข้าบัญชีสมาชิก แล้วเลือกประเภทหวย รอบ และตัวเลขที่ต้องการก่อนส่งโพย
        ประวัติของทุกโพยที่ส่งจะถูกเก็บไว้ในบัญชีนั้นตั้งแต่รายการแรก ทำให้ย้อนกลับมาตรวจได้ตลอดโดยไม่ต้องจดไว้เอง
      </p>
