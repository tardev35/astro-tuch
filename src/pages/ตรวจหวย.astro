---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ContentBoxHuay from "../components/ContentBoxHuay.astro";
import LatestWinnersHuay from "../components/LatestWinnersHuay.astro";
import FaqHuay from "../components/FaqHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import { pageGraph } from "../lib/schema";

// หน้านี้ว่าด้วย "วิธีตรวจผลและตรวจสถานะรายการของตัวเอง" ไม่มีผลรางวัลจริง ไม่มี
// วันที่ ไม่มีเลขเด็ด และไม่มีการทำนายใด ๆ อยู่บนหน้านี้ — เว็บไซต์ไม่ได้เป็น
// ผู้ประกาศผล ให้ยึดผลที่หน่วยงานผู้จัดออกรางวัลของแต่ละตลาดประกาศเป็นหลัก
//
// ข้อเท็จจริงทั้งหมดยึดตาม src/assets/content.txt เท่านั้น: 888PARUAY รวมบริการ
// แทงหวยและตรวจหวยออนไลน์ไว้ในระบบเดียว รองรับรัฐบาลไทย ฮานอย ลาวพัฒนา และ
// หุ้นต่างประเทศ ได้ 24 ชั่วโมง · แสดงรอบเปิดรับและข้อมูลผลหวยให้ตรวจสอบได้ ·
// จัดหมวดหมู่ชัดเจนและรองรับการใช้งานผ่านมือถือ · แสดงอัตราจ่ายก่อนยืนยันรายการ
// เลข 2 ตัวจ่าย 100 และเลข 3 ตัวจ่าย 1,000 ตามเงื่อนไขของแต่ละรายการ · สมัครเอง
// ได้บนมือถือใน 3 ขั้นตอน · แอดมินออนไลน์ 24 ชั่วโมง
// ห้ามเติมสถิติ ผลย้อนหลัง เวลาออกรางวัลรายตลาด ยอดฝาก-ถอนขั้นต่ำ หรือเลขที่
// ใบอนุญาต เพราะบรีฟรอบนี้ไม่ได้ระบุไว้
//
// ข้อยกเว้น "หน้าหวยคงธีม Huay" ของ Phase 4.5 มีผลกับหน้านี้: หน้านี้กับ /แนวทาง
// คงชุด AnnouncementHuay / ContentBoxHuay / LatestWinnersHuay / FaqHuay และธีม
// แดง-ทองของมันไว้ ไม่ถูกบังคับไปใช้พื้นเขียวของหน้าอื่น — แต่ "ชื่อแบรนด์ไม่ได้
// รับการยกเว้น" และค่าสีทุกค่าถูกสร้างใหม่จากพาเลตต์ 888PARUAY (ทอง #fcdc2b /
// #fff6ae / #a87d0c · แดง #cf1111 · พื้น #240808 / #140404 / #3a0f0f ·
// เนื้อความ #e8e4c6 · เนื้อความรอง #c3b98f) ชื่อ "หวยพยัคฆ์" ของแบรนด์เก่าและ
// ชุดกรมท่า #030b1c / #08152f / #0f2149 / #1c3566 / #dbe4f7 / #9fb0d0 /
// #e8eef8 / #fadb6c / #fdf5a4 / #ab6d13 ออกครบแล้ว
//
// การ์ดสามใบด้านล่างเป็น chrome ไม่ใช่หัวข้อบทความ ป้ายจึงเป็น <span> และชื่อ
// ของ grid ย้ายไปอยู่บน aria-label ของ container แทน
const steps = [
  {
    icon: "🔐",
    label: "เข้าสู่ระบบ",
    detail: "เปิดบัญชีสมาชิกจากมือถือหรือคอมพิวเตอร์ แล้วเข้าหน้าประวัติรายการในหมวดหวยที่ต้องการตรวจ",
  },
  {
    icon: "🎯",
    label: "เลือกรายการและรอบที่ส่งไว้",
    detail: "เลือกรายการที่แทงไว้ ทั้งรัฐบาลไทย ฮานอย ลาวพัฒนา หรือหุ้นต่างประเทศ ให้ตรงกับรอบที่ส่งโพย",
  },
  {
    icon: "🧾",
    label: "อ่านสถานะของรายการ",
    detail: "ระบบแสดงเลขที่เลือก ยอดแทง และอัตราจ่ายที่บันทึกไว้ตอนยืนยัน พร้อมสถานะหลังตรวจสอบเสร็จ",
  },
];

const faqs = [
  {
    q: "ตรวจผลหวยกับ 888PARUAY ดูได้จากรายการไหนบ้าง",
    a: "ภายในระบบมีทั้งรัฐบาลไทย หวยฮานอย ลาวพัฒนา และหุ้นต่างประเทศ โดยรายการที่เปิดรับและช่วงเวลาของแต่ละรอบอาจแตกต่างกัน จึงควรเปิดดูข้อมูลล่าสุดจากหน้ารวมหวยก่อน แล้วค่อยเทียบผลที่ประกาศกับเลขในบิลของรอบนั้นให้ตรงรายการ",
  },
  {
    q: "เลข 2 ตัวและเลข 3 ตัวของ 888PARUAY จ่ายเท่าไร",
    a: "ตามข้อมูลที่กำหนด เลข 2 ตัวมีอัตราจ่าย 100 และเลข 3 ตัวมีอัตราจ่าย 1,000 ตามเงื่อนไขของแต่ละรายการ โดยอัตราที่ใช้จริงจะแสดงอยู่บนหน้ายืนยันรายการของรอบนั้น ควรตรวจสอบเงื่อนไขและรายละเอียดของแต่ละรอบอีกครั้งก่อนทำรายการ",
  },
  {
    q: "เปิดดูโพยย้อนหลังของตัวเองได้ที่ไหน",
    a: "เข้าสู่ระบบแล้วเปิดประวัติรายการในบัญชีสมาชิกได้ด้วยตัวเอง ระบบจะแสดงรายการและรอบที่ส่ง เลขที่เลือก ยอดแทง และอัตราจ่ายที่บันทึกไว้ตอนกดยืนยัน ทำให้เทียบกับสถานะที่อัปเดตหลังตรวจสอบเสร็จได้ทันที",
  },
  {
    q: "สถานะรายการไม่ตรงกับที่ส่งไว้ ต้องทำอย่างไร",
    a: "ตรวจสอบประวัติโพยและประวัติรายการเครดิตในบัญชีก่อนเป็นอันดับแรก หากยังพบความผิดปกติ ติดต่อแอดมินเว็บ 888PARUAY ได้ตลอด 24 ชั่วโมง พร้อมแจ้งรายการที่แทง รอบ เวลา จำนวนเงิน และประเภทเลข เพื่อให้ตรวจสอบต่อได้ตรงจุด",
  },
];

// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). ปัจจุบัน 156 ตัวอักษร
const pageDescription = "ตรวจหวย 888PARUAY รวมวิธีเช็กผลรัฐบาลไทย ฮานอย ลาวพัฒนา และหุ้นต่างประเทศ พร้อมขั้นตอนเปิดโพยย้อนหลังจากบัญชีสมาชิก และจุดที่ควรตรวจก่อนยืนยันรายการทุกครั้ง";

const graph = pageGraph(Astro, {
  name: "ตรวจหวย 888PARUAY เช็กผลและสถานะรายการด้วยตัวเอง",
  description: pageDescription,
  faqs,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ตรวจหวย", path: "/ตรวจหวย" },
  ],
});
---

<MainLayout title="ตรวจหวย 888PARUAY เช็กผลรัฐบาลไทย ฮานอย ลาวพัฒนา และสถานะโพย" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <section class="mx-auto my-8 w-full max-w-5xl px-4">
    <div class="relative isolate overflow-hidden rounded-3xl border border-[#a87d0c]/50 bg-[#240808]/90 p-8 shadow-[0_15px_40px_rgba(20,4,4,0.6)] backdrop-blur-xl md:p-12">
      <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-64 w-64 rounded-full bg-[#fcdc2b]/20 blur-[60px]"></div>
      <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-64 w-64 rounded-full bg-[#cf1111]/18 blur-[60px]"></div>

      <div class="flex w-full flex-col items-center">
        <span aria-hidden="true" class="mb-4 text-5xl drop-shadow-[0_0_15px_rgba(252,220,43,0.8)]">🧾</span>
        <h1 class="mb-3 bg-gradient-to-r from-[#fff6ae] via-[#fcdc2b] to-[#cf1111] bg-clip-text text-center text-4xl font-black tracking-widest text-transparent uppercase">
          ตรวจหวย 888PARUAY เช็กผลและสถานะรายการ
        </h1>
        <p class="w-full text-left text-base leading-relaxed text-[#e8e4c6]">
          หน้านี้อธิบายวิธีตรวจผลและตรวจสถานะรายการของคุณเองกับ 888PARUAY ตั้งแต่เปิดประวัติโพย ดูเลขและยอดที่ส่งไว้ ไปจนถึงการอ่านสถานะและยอดที่เข้าบัญชีสมาชิก
          ระบบรวมบริการแทงหวยและตรวจหวยออนไลน์ไว้ในระบบเดียว รองรับรายการยอดนิยมทั้งรัฐบาลไทย ฮานอย ลาวพัฒนา และหุ้นต่างประเทศ พร้อมแสดงรอบเปิดรับและข้อมูลผลหวยให้ตรวจสอบได้สะดวก
          จัดหมวดหมู่ชัดเจนและรองรับการใช้งานผ่านมือถือ จึงเลือกดูรายการที่ต้องการได้จากหน้าเดียวโดยไม่ต้องสลับหลายเว็บไซต์ เว็บไซต์ไม่ได้เป็นผู้ประกาศผลรางวัลเองและไม่ทำนายเลขใด ๆ
          ให้ยึดผลที่หน่วยงานผู้จัดออกรางวัลของแต่ละรายการประกาศเป็นหลัก ส่วนรอบที่เปิดรับ เวลาปิดรับ และอัตราจ่าย ให้ยึดตัวเลขที่ระบบแสดงบนหน้ายืนยันรายการของรอบนั้น
        </p>
      </div>

      <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-3" aria-label="ขั้นตอนตรวจผลและสถานะรายการด้วยตัวเองสามขั้นตอน">
        {
          steps.map((step, i) => (
            <div class="flex flex-col gap-2 rounded-2xl border border-[#3a0f0f] bg-[#140404]/70 p-5 transition-colors hover:border-[#fcdc2b]/55">
              <div class="flex items-center gap-3">
                <span aria-hidden="true" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gradient-to-b from-[#fff6ae] to-[#a87d0c] text-sm font-black text-[#140404]">
                  {i + 1}
                </span>
                <span aria-hidden="true" class="text-xl">
                  {step.icon}
                </span>
                <span class="text-base font-black tracking-wide text-[#fcdc2b]">{step.label}</span>
              </div>
              <p class="text-left text-base leading-relaxed text-[#c3b98f]">{step.detail}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:justify-center">
        <a
          href="/login"
          class="flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#a87d0c] via-[#fcdc2b] to-[#a87d0c] px-8 py-4 font-black text-[#140404] shadow-[0_5px_15px_rgba(252,220,43,0.4)] transition-transform hover:scale-105">
          <span aria-hidden="true">🔒</span> เข้าสู่ระบบเพื่อตรวจรายการ
        </a>
        <a
          href="/register"
          class="flex items-center justify-center gap-2 rounded-xl border border-[#a87d0c]/60 bg-[#3a0f0f] px-8 py-4 font-bold text-[#fcdc2b] shadow-[0_5px_15px_rgba(20,4,4,0.55)] transition-colors hover:bg-[#240808]">
          <span aria-hidden="true">⚡</span> สมัครสมาชิก 888PARUAY
        </a>
      </div>
    </div>
  </section>

  <ContentBoxHuay title="ตรวจผลหวย 888PARUAY ให้ตรงรายการและตรงประเภทเลขที่แทงไว้" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed text-[#e8e4c6]">
        เมื่อผลของรอบที่คุณส่งโพยไว้ถูกประกาศแล้ว ให้เทียบเลขในบิลกับผลของ <strong class="text-[#fcdc2b]">รายการเดียวกันและประเภทเดียวกับที่แทงจริง</strong> เพราะรัฐบาลไทย ฮานอย ลาวพัฒนา
        และหุ้นต่างประเทศ ต่างก็มีรอบและการประกาศผลเป็นของตัวเอง และเลขชุดเดียวกันยังใช้ตัดสินคนละประเภทกัน ทั้งเลข 2 ตัวบน 2 ตัวล่าง 3 ตัวตรง หรือ 3 ตัวโต๊ด
        การอ่านข้ามรายการหรือข้ามประเภทคือสาเหตุที่พบบ่อยที่สุดของการเข้าใจว่าโพยไม่ถูกรางวัล สมาชิก 888PARUAY เปิดดูบิลย้อนหลังได้เองจากบัญชี ระบบบันทึกทั้งรายการและรอบที่ส่ง เลขที่เลือก
        ยอดแทง และอัตราจ่ายที่แสดงไว้ตอนยืนยัน จึงตรวจย้อนกลับได้ว่ารายการที่ส่งไปตรงกับที่ตั้งใจหรือไม่ และเมื่อระบบตรวจสอบเสร็จ สถานะของบิลจะอัปเดตพร้อมยอดที่ปล่อยเข้าบัญชีสมาชิก
      </p>
    </div>
  </ContentBoxHuay>

  <ContentBoxHuay title="อัตราจ่ายที่บันทึกในบิล เลข 2 ตัวจ่าย 100 และเลข 3 ตัวจ่าย 1,000" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed text-[#e8e4c6]">
        888PARUAY แสดงอัตราจ่ายของเลขแต่ละประเภทให้ตรวจสอบก่อนยืนยันรายการ โดยข้อมูลที่กำหนดไว้คือ <strong class="text-[#fcdc2b]">เลข 2 ตัวจ่าย 100 และเลข 3 ตัวจ่าย 1,000</strong>
        ตามเงื่อนไขของแต่ละรายการ ยอดที่คำนวณให้จึงคิดจากอัตราที่ระบบแสดงบนหน้ายืนยันของประเภทและรอบที่คุณเลือก ณ ตอนที่กดส่ง ไม่ใช่จากตัวเลขที่จำมาจากรอบก่อน
        อัตราที่ใช้จะถูกบันทึกลงในบิลพร้อมกับรอบที่ส่ง เลขที่เลือก และยอดแทง จึงเปิดดูย้อนหลังได้เสมอว่ารายการนั้นคิดจากเรทเท่าไร และเทียบกับยอดที่เข้าบัญชีหลังตรวจสอบเสร็จได้โดยตรง
      </p>

      <p class="mt-6 text-left text-base leading-relaxed text-[#e8e4c6]">
        ก่อนกดยืนยันทุกครั้งจึงควรไล่อ่านให้ครบทั้ง <strong class="text-[#fcdc2b]">รายการหวยที่เลือก รอบที่เปิดรับ ประเภทบิล อัตราจ่าย และเวลาปิดรับ</strong> ที่ระบบแสดงของรอบนั้น
        เพราะรายการที่เปิดรับและช่วงเวลาของแต่ละรอบอาจแตกต่างกัน หน้ารวมหวยจึงเป็นจุดแรกที่ควรเปิดดูก่อนทำรายการ เมื่อทุกอย่างตรงกับที่ตั้งใจแล้วค่อยยืนยัน
        ขั้นตอนนี้ใช้เวลาไม่นานแต่ตัดปัญหาการส่งผิดรอบหรือผิดประเภทออกไปได้เกือบทั้งหมด และทำให้การตรวจผลหลังรอบจบเหลือแค่การเทียบเลขกับผลที่ประกาศ
      </p>

      <p class="mt-6 text-left text-base leading-relaxed text-[#e8e4c6]">
        สำหรับผู้ที่ยังไม่มีบัญชี การสมัครแทงหวย 888PARUAY ทำผ่านมือถือได้ด้วยตัวเองใน 3 ขั้นตอน คือเปิดหน้าสมัครแล้วกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน ตรวจสอบข้อมูลส่วนตัวและรายละเอียดบัญชี
        ให้ถูกต้องก่อนกดยืนยัน แล้วยืนยันการสมัครและเข้าสู่ระบบ จากนั้นจึงเลือกรัฐบาลไทย ฮานอย ลาวพัฒนา หรือหุ้นต่างประเทศที่ต้องการได้ทันที ประวัติของทุกรายการที่ส่งจะถูกเก็บไว้ในบัญชีนั้น
        ตั้งแต่บิลแรก ทำให้ย้อนกลับมาตรวจได้ตลอดโดยไม่ต้องจดไว้เอง
      </p>
    </div>
  </ContentBoxHuay>

  <LatestWinnersHuay />

  <ContentBoxHuay title="แอดมินเว็บ 888PARUAY ออนไลน์ตลอด 24 ชั่วโมง ช่วยตรวจสอบรายการที่สงสัย" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed text-[#e8e4c6]">
