---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ContentBoxHuay from "../components/ContentBoxHuay.astro";
import LatestWinnersHuay from "../components/LatestWinnersHuay.astro";
import FaqHuay from "../components/FaqHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import { pageGraph } from "../lib/schema";

// หน้านี้ว่าด้วย "วิธีตรวจผลและตรวจสถานะรายการของตัวเอง" ไม่มีผลรางวัลจริง ไม่มี
// วันที่ ไม่มีเลขเด็ด และไม่มีการทำนายใด ๆ อยู่บนหน้านี้ — เว็บไซต์ไม่ได้เป็น
// ผู้ประกาศผล ให้ยึดผลที่หน่วยงานผู้จัดออกรางวัลของแต่ละตลาดประกาศเป็นหลัก
//
// ข้อเท็จจริงทั้งหมดยึดตาม src/assets/content.txt เท่านั้น: รวมรายการแทงหวย
// หลายประเภทไว้ในระบบเดียว ทั้งรัฐบาลไทย ฮานอย ลาวพัฒนา และหวยหุ้นต่างประเทศ ·
// เลือกดูรอบที่เปิดรับและจัดการรายการได้จากหน้าเดียว · แสดงอัตราจ่ายของแต่ละ
// ประเภทเลขก่อนยืนยันรายการ เลข 2 ตัวจ่าย 100 และเลข 3 ตัวจ่าย 1,000 ตามเงื่อนไข
// ของแต่ละรายการ · สมัครเองได้ผ่านหน้าเว็บไซต์ใน 3 ขั้นตอน · แอดมิน 24 ชั่วโมง
// ห้ามเติมสถิติ ผลย้อนหลัง เวลาออกรางวัลรายตลาด ยอดฝาก-ถอนขั้นต่ำ หรือเลขที่
// ใบอนุญาต เพราะบรีฟรอบนี้ไม่ได้ระบุไว้
//
// ข้อยกเว้น "หน้าหวยคงธีมแดง" ใน Phase 4.5 ไม่มีผลกับรอบนี้ — ทั้งเว็บคือเว็บหวย
// พาเลตต์กรมท่า-ทอง (§2 ของ brand spec) จึงเป็นสีของหน้าหวยเองอยู่แล้ว
//
// การ์ดสามใบด้านล่างเป็น chrome ไม่ใช่หัวข้อบทความ ป้ายจึงเป็น <span> และชื่อ
// ของ grid ย้ายไปอยู่บน aria-label ของ container แทน
const steps = [
  {
    icon: "🔐",
    label: "เข้าสู่ระบบ",
    detail: "เปิดบัญชีสมาชิกจากมือถือหรือคอมพิวเตอร์ แล้วเข้าหน้าประวัติรายการในหมวดหวยที่ต้องการตรวจ",
  },
  {
    icon: "🎯",
    label: "เลือกตลาดและรอบที่ส่งไว้",
    detail: "เลือกรายการที่แทงไว้ ทั้งรัฐบาลไทย ฮานอย ลาวพัฒนา หรือหวยหุ้นต่างประเทศ ให้ตรงกับรอบที่ส่งโพย",
  },
  {
    icon: "🧾",
    label: "อ่านสถานะของรายการ",
    detail: "ระบบแสดงเลขที่เลือก ยอดแทง และอัตราจ่ายที่บันทึกไว้ตอนยืนยัน พร้อมสถานะหลังตรวจสอบเสร็จ",
  },
];

const faqs = [
  {
    q: "ตรวจผลหวยพยัคฆ์ ดูได้จากรายการไหนบ้าง",
    a: "ภายในระบบมีทั้งรัฐบาลไทย หวยฮานอย ลาวพัฒนา และหวยหุ้นต่างประเทศ โดยรายการที่เปิดรับอาจแตกต่างกันตามวันและช่วงเวลา จึงควรเปิดดูรอบล่าสุดจากหน้ารวมหวยก่อน แล้วค่อยเทียบผลที่ประกาศกับเลขในบิลของรอบนั้นให้ตรงรายการ",
  },
  {
    q: "เลข 2 ตัวและเลข 3 ตัวของหวยพยัคฆ์จ่ายเท่าไร",
    a: "ตามข้อมูลที่กำหนด เลข 2 ตัวมีอัตราจ่าย 100 และเลข 3 ตัวมีอัตราจ่าย 1,000 ตามเงื่อนไขของแต่ละรายการ โดยอัตราที่ใช้จริงจะแสดงอยู่บนหน้ายืนยันรายการของรอบนั้น ควรตรวจสอบเงื่อนไขและรายละเอียดของแต่ละรอบก่อนยืนยันทุกครั้ง",
  },
  {
    q: "เปิดดูโพยย้อนหลังของตัวเองได้ที่ไหน",
    a: "เข้าสู่ระบบแล้วเปิดประวัติรายการในบัญชีสมาชิกได้ด้วยตัวเอง ระบบจะแสดงรายการและรอบที่ส่ง เลขที่เลือก ยอดแทง และอัตราจ่ายที่บันทึกไว้ตอนกดยืนยัน ทำให้เทียบกับสถานะที่อัปเดตหลังตรวจสอบเสร็จได้ทันที",
  },
  {
    q: "สถานะรายการไม่ตรงกับที่ส่งไว้ ต้องทำอย่างไร",
    a: "ตรวจสอบประวัติโพยและประวัติรายการเครดิตในบัญชีก่อนเป็นอันดับแรก หากยังพบความผิดปกติ ติดต่อแอดมินหวยพยัคฆ์ได้ตลอด 24 ชั่วโมง พร้อมแจ้งรายการที่แทง รอบ เวลา จำนวนเงิน และประเภทเลข เพื่อให้ตรวจสอบต่อได้ตรงจุด",
  },
];

// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). ปัจจุบัน 159 ตัวอักษร
const pageDescription = "ตรวจหวย หวยพยัคฆ์ รวมวิธีเช็กผลรัฐบาลไทย ฮานอย ลาวพัฒนา และหวยหุ้นต่างประเทศ พร้อมขั้นตอนเปิดโพยย้อนหลังจากบัญชีสมาชิก และจุดที่ควรตรวจก่อนยืนยันรายการทุกครั้ง";

const graph = pageGraph(Astro, {
  name: "ตรวจหวย หวยพยัคฆ์ เช็กผลและสถานะรายการด้วยตัวเอง",
  description: pageDescription,
  faqs,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ตรวจหวย", path: "/ตรวจหวย" },
  ],
});
---

<MainLayout title="ตรวจหวย หวยพยัคฆ์ เช็กผลรัฐบาลไทย ฮานอย ลาวพัฒนา และสถานะโพย" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <section class="mx-auto my-8 w-full max-w-5xl px-4">
    <div class="relative isolate overflow-hidden rounded-3xl border border-[#ab6d13]/50 bg-[#08152f]/90 p-8 shadow-[0_15px_40px_rgba(3,11,28,0.6)] backdrop-blur-xl md:p-12">
      <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-64 w-64 rounded-full bg-[#fadb6c]/20 blur-[60px]"></div>
      <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-64 w-64 rounded-full bg-[#e8eef8]/10 blur-[60px]"></div>

      <div class="flex w-full flex-col items-center">
        <span aria-hidden="true" class="mb-4 text-5xl drop-shadow-[0_0_15px_rgba(250,219,108,0.8)]">🧾</span>
        <h1 class="mb-3 bg-gradient-to-r from-[#e8eef8] via-[#fadb6c] to-[#ab6d13] bg-clip-text text-center text-4xl font-black tracking-widest text-transparent uppercase">
          ตรวจหวย หวยพยัคฆ์ เช็กผลและสถานะรายการ
        </h1>
        <p class="w-full text-left text-base leading-relaxed text-[#dbe4f7]">
          หน้านี้อธิบายวิธีตรวจผลและตรวจสถานะรายการของคุณเองกับ หวยพยัคฆ์ ตั้งแต่เปิดประวัติโพย ดูเลขและยอดที่ส่งไว้ ไปจนถึงการอ่านสถานะและยอดที่เข้าบัญชีสมาชิก
          ระบบรวมรายการแทงหวยหลายประเภทไว้ในที่เดียว ทั้งรัฐบาลไทย ฮานอย ลาวพัฒนา และหวยหุ้นต่างประเทศ จึงเลือกดูรอบที่เปิดรับและจัดการรายการได้จากหน้าเดียวโดยไม่ต้องสลับหลายเว็บไซต์
          เว็บไซต์ไม่ได้เป็นผู้ประกาศผลรางวัลเองและไม่ทำนายเลขใด ๆ ให้ยึดผลที่หน่วยงานผู้จัดออกรางวัลของแต่ละรายการประกาศเป็นหลัก ส่วนรอบที่เปิดรับ เวลาปิดรับ และอัตราจ่าย
          ให้ยึดตัวเลขที่ระบบแสดงบนหน้ายืนยันรายการของรอบนั้น
        </p>
      </div>

      <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-3" aria-label="ขั้นตอนตรวจผลและสถานะรายการด้วยตัวเองสามขั้นตอน">
        {
          steps.map((step, i) => (
            <div class="flex flex-col gap-2 rounded-2xl border border-[#1c3566] bg-[#0f2149]/70 p-5 transition-colors hover:border-[#fadb6c]/55">
              <div class="flex items-center gap-3">
                <span aria-hidden="true" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gradient-to-b from-[#fdf5a4] to-[#ab6d13] text-sm font-black text-[#030b1c]">
                  {i + 1}
                </span>
                <span aria-hidden="true" class="text-xl">
                  {step.icon}
                </span>
                <span class="text-base font-black tracking-wide text-[#fadb6c]">{step.label}</span>
              </div>
              <p class="text-left text-base leading-relaxed text-[#9fb0d0]">{step.detail}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:justify-center">
        <a
          href="/login"
          class="flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#ab6d13] via-[#fadb6c] to-[#ab6d13] px-8 py-4 font-black text-[#030b1c] shadow-[0_5px_15px_rgba(250,219,108,0.4)] transition-transform hover:scale-105">
          <span aria-hidden="true">🔒</span> เข้าสู่ระบบเพื่อตรวจรายการ
        </a>
        <a
          href="/register"
          class="flex items-center justify-center gap-2 rounded-xl border border-[#ab6d13]/60 bg-[#0f2149] px-8 py-4 font-bold text-[#fadb6c] shadow-[0_5px_15px_rgba(3,11,28,0.55)] transition-colors hover:bg-[#1c3566]">
          <span aria-hidden="true">⚡</span> สมัครสมาชิก หวยพยัคฆ์
        </a>
      </div>
    </div>
  </section>

  <ContentBoxHuay title="ตรวจผลหวยพยัคฆ์ ให้ตรงรายการและตรงประเภทเลขที่แทงไว้" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed text-[#dbe4f7]">
        เมื่อผลของรอบที่คุณส่งโพยไว้ถูกประกาศแล้ว ให้เทียบเลขในบิลกับผลของ <strong class="text-[#fadb6c]">รายการเดียวกันและประเภทเดียวกับที่แทงจริง</strong> เพราะรัฐบาลไทย ฮานอย ลาวพัฒนา
        และหวยหุ้นต่างประเทศ ต่างก็มีรอบและการประกาศผลเป็นของตัวเอง และเลขชุดเดียวกันยังใช้ตัดสินคนละประเภทกัน ทั้งเลข 2 ตัวบน 2 ตัวล่าง 3 ตัวตรง หรือ 3 ตัวโต๊ด
        การอ่านข้ามรายการหรือข้ามประเภทคือสาเหตุที่พบบ่อยที่สุดของการเข้าใจว่าโพยไม่ถูกรางวัล สมาชิกหวยพยัคฆ์เปิดดูบิลย้อนหลังได้เองจากบัญชี ระบบบันทึกทั้งรายการและรอบที่ส่ง เลขที่เลือก
        ยอดแทง และอัตราจ่ายที่แสดงไว้ตอนยืนยัน จึงตรวจย้อนกลับได้ว่ารายการที่ส่งไปตรงกับที่ตั้งใจหรือไม่ และเมื่อระบบตรวจสอบเสร็จ สถานะของบิลจะอัปเดตพร้อมยอดที่ปล่อยเข้าบัญชีสมาชิก
      </p>
    </div>
  </ContentBoxHuay>

  <ContentBoxHuay title="อัตราจ่ายที่บันทึกในบิล เลข 2 ตัวจ่าย 100 และเลข 3 ตัวจ่าย 1,000" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed text-[#dbe4f7]">
        หวยพยัคฆ์ แสดงอัตราจ่ายของแต่ละประเภทเลขไว้อย่างชัดเจนก่อนยืนยันรายการ โดยข้อมูลที่กำหนดไว้คือ <strong class="text-[#fadb6c]">เลข 2 ตัวจ่าย 100 และเลข 3 ตัวจ่าย 1,000</strong>
        ตามเงื่อนไขของแต่ละรายการ ยอดที่คำนวณให้จึงคิดจากอัตราที่ระบบแสดงบนหน้ายืนยันของประเภทและรอบที่คุณเลือก ณ ตอนที่กดส่ง ไม่ใช่จากตัวเลขที่จำมาจากรอบก่อน
        อัตราที่ใช้จะถูกบันทึกลงในบิลพร้อมกับรอบที่ส่ง เลขที่เลือก และยอดแทง จึงเปิดดูย้อนหลังได้เสมอว่ารายการนั้นคิดจากเรทเท่าไร และเทียบกับยอดที่เข้าบัญชีหลังตรวจสอบเสร็จได้โดยตรง
      </p>

      <p class="mt-6 text-left text-base leading-relaxed text-[#dbe4f7]">
        ก่อนกดยืนยันทุกครั้งจึงควรไล่อ่านให้ครบทั้ง <strong class="text-[#fadb6c]">รายการหวยที่เลือก รอบที่เปิดรับ ประเภทบิล อัตราจ่าย และเวลาปิดรับ</strong> ที่ระบบแสดงของรอบนั้น
        เพราะรายการที่เปิดรับอาจแตกต่างกันตามวันและช่วงเวลา หน้ารวมหวยจึงเป็นจุดแรกที่ควรเปิดดูก่อนทำรายการ เมื่อทุกอย่างตรงกับที่ตั้งใจแล้วค่อยยืนยัน
        ขั้นตอนนี้ใช้เวลาไม่นานแต่ตัดปัญหาการส่งผิดรอบหรือผิดประเภทออกไปได้เกือบทั้งหมด และทำให้การตรวจผลหลังรอบจบเหลือแค่การเทียบเลขกับผลที่ประกาศ
      </p>

      <p class="mt-6 text-left text-base leading-relaxed text-[#dbe4f7]">
        สำหรับผู้ที่ยังไม่มีบัญชี การสมัครหวยพยัคฆ์ทำเองได้ผ่านหน้าเว็บไซต์ใน 3 ขั้นตอน คือกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน ตรวจสอบข้อมูลส่วนตัวและรายละเอียดบัญชีให้ถูกต้องก่อนกดยืนยัน
        แล้วยืนยันการสมัครและเข้าสู่ระบบ จากนั้นจึงเลือกรัฐบาลไทย ฮานอย ลาวพัฒนา หรือรายการอื่นที่ต้องการได้ทันที ประวัติของทุกรายการที่ส่งจะถูกเก็บไว้ในบัญชีนั้นตั้งแต่บิลแรก
        ทำให้ย้อนกลับมาตรวจได้ตลอดโดยไม่ต้องจดไว้เอง
      </p>
    </div>
  </ContentBoxHuay>

  <LatestWinnersHuay />

  <ContentBoxHuay title="แอดมิน หวยพยัคฆ์ ออนไลน์ 24 ชั่วโมง ช่วยตรวจสอบรายการที่สงสัย" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed text-[#dbe4f7]">
        หากส่งโพยไม่สำเร็จ เลขที่ต้องการแทงไม่แสดง เครดิตไม่เข้า รายการค้างอยู่ เข้าสู่ระบบไม่ได้ หรือพบยอดในบิลไม่ตรงกับรายการ ให้ตรวจสอบประวัติโพยและประวัติรายการเครดิตในบัญชีก่อนเป็นอันดับแรก
        เพราะรายการส่วนใหญ่อธิบายได้จากข้อมูลที่ระบบบันทึกไว้แล้ว หากยังพบความผิดปกติ ติดต่อแอดมินหวยพยัคฆ์ได้ตลอด 24 ชั่วโมง พร้อมแจ้งรายการหวยที่แทง รอบ เวลา จำนวนเงิน และประเภทเลข
        เพื่อให้ตรวจสอบได้ตรงจุด ทีมงานพร้อมให้ข้อมูลทั้งเรื่องการสมัคร รอบหวย อัตราจ่าย วิธีเลือกเลข และการใช้งานเมนูภายในเว็บไซต์ ทั้งสมาชิกใหม่และสมาชิกเดิม
        ระหว่างรอตรวจสอบควรเก็บข้อมูลบิลไว้จนกว่ารายการจะเสร็จสมบูรณ์ และไม่ควรเปิดเผยรหัสผ่านหรือ OTP แก่บุคคลอื่นไม่ว่ากรณีใด
      </p>
    </div>
