---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBox3ThreeNeumorphism from "../components/ContentBox3ThreeNeumorphism.astro";
import LatestWinners from "../components/LatestWinnersHuay.astro";
import Faq from "../components/FaqHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้ว่าด้วย "การตรวจผลรางวัลของแต่ละประเภทหวย และการตรวจบิลของตัวเอง"
// ไม่มีตัวเลขของงวดใด ไม่มีตารางผล ไม่มีวันที่ และไม่มีการทำนายผลใด ๆ
// เว็บไซต์ไม่ใช่ผู้ประกาศผล — ผลรางวัลให้อ้างอิงแหล่งประกาศผลของประเภทนั้น
//
// หัวข้อของหน้านี้มาจาก **เนื้อหาของหน้าเอง** ไม่ใช่จาก docx ของ index —
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES
//
// ข้อเท็จจริงทั้งหมดยึดตาม `src/assets/content.txt` ของรอบนี้เท่านั้น:
// ประเภทหวยมีสี่ชื่อ — **หวยรัฐบาลไทย · หวยลาว · หวยฮานอย · หวยหุ้นต่างประเทศ**
// (บรรทัด 4, 6) · แต่ละรายการมีวันประกาศผลและรูปแบบการเดิมพันแตกต่างกัน
// (บรรทัด 6) · รับทุกเลข ไม่มีเลขอั้น จ่ายเต็มตามอัตราที่กำหนด (บรรทัด 6) ·
// อัตราจ่าย 2 ตัว 100 ต้องตรวจว่าเป็นสองตัวบนหรือสองตัวล่าง และคำนวณจากเงิน
// เดิมพันเท่าใด (บรรทัด 8, 10) · 3 ตัว 1,000 ต้องตรวจว่าเป็นสามตัวตรงหรือ
// สามตัวโต๊ด พร้อมฐานเงินเดิมพันและวงเงินจ่ายสูงสุด (บรรทัด 12) ·
// ยืนยันบิล · รอบปิดรับ (บรรทัด 20) · แอดมิน 24ชม. เก็บหมายเลขรายการและหลักฐาน
// ไม่เปิดเผยรหัสผ่านหรือรหัส OTP ตรวจช่องทางติดต่อจากเว็บไซต์ทางการเพื่อหลีกเลี่ยง
// บัญชีแอบอ้าง และตรวจเวลาการให้บริการจริงจากประกาศล่าสุด (บรรทัด 22)
//
// ⚠️⚠️ **"หวยออมสิน" / "หวยลาวพัฒนา" / "บาทละ 1,000" ไม่มีในบรีฟรอบนี้** — เป็น
// คำของแบรนด์หวยเจ้าก่อน ๆ ที่เคยเป็นเจ้าของไฟล์นี้ ถอดออกครบแล้ว บรีฟรอบนี้ระบุ
// สี่ประเภทข้างบนเท่านั้น ห้ามเติมประเภทอื่น (ธ.ก.ส. · ยี่กี · ออมสิน) และห้ามเติม
// สิ่งที่บรีฟไม่ได้ให้: ใบอนุญาต · หน่วยงานกำกับ · นิติบุคคล · ชื่อธนาคาร ·
// เวลาประกาศผลเป็นตัวเลข · ตารางผลย้อนหลัง · ยอดขั้นต่ำเป็นตัวเลข · จำนวนสมาชิก ·
// ปีก่อตั้ง
// ⚠️⚠️ **บรีฟรอบนี้ไม่มีหมวดโปรโมชั่น และไม่มีหมวดฝากถอน/ธนาคาร/วอลเลทเลย** →
// เปอร์เซ็นต์คืนยอดเสีย/แนะนำเพื่อนที่เคยอยู่ในไฟล์นี้เป็นคอปปี้ของ **แบรนด์ขาออก
// รอบก่อน** และพิมพ์อยู่บนอาร์ตเวิร์กสไลด์เท่านั้น **ห้ามปรากฏในหน้านี้เลย**
// ตัวเลขที่ขึ้นหน้าได้รอบนี้มีแค่ **2 ตัว 100 · 3 ตัว 1,000 · 3 ขั้นตอน · 24ชม.**
// ⚠️ ห้ามใช้คำของแบรนด์ขาออกและแบรนด์เก่ากว่า (ศัพท์สล็อต/วอลเลท/โปรไม่อั้น ฯลฯ)
// — **ลิสต์คำต้องห้ามทั้งหมดอยู่ที่ `.claude/brand-spec-lottoplus.md` §5 ที่เดียว**
//
// ⚖️ YMYL: คำกำกับของบรีฟเป็นเนื้อหาของหน้า ไม่ใช่ของตัดทิ้ง — ควรตรวจสอบความ
// ถูกต้องของข้อมูลและข้อกำหนดก่อนทำรายการ เนื่องจาก **ผลการออกรางวัลมีความ
// ไม่แน่นอนและไม่สามารถคาดการณ์ได้อย่างแม่นยำ** (บรรทัด 4) และ **ผลการออกรางวัล
// ไม่สามารถรับประกันได้จากสถิติหรือเลขย้อนหลัง** (บรรทัด 12) · ยังไม่สามารถยืนยัน
// ได้ว่าใช้อัตราเดียวกันกับหวยทุกประเภท (บรรทัด 8)
//
// CHROME: AnnouncementHuay · FaqHuay · LatestWinnersHuay — รอบนี้แบรนด์เองเป็น
// เว็บหวย ชุด *Huay จึงเป็นธีมหลักของทั้งเว็บ ไม่ใช่ซับธีมของสองหน้านี้อีกต่อไป
// (เรียก <Announcement /> **แบบ bare** ให้ตกไปใช้ default message ของแบรนด์
// ปัจจุบัน **ห้ามส่ง message prop** · FaqHuay มี default faqs = [] จึงต้องส่ง prop
// faqs ทุกครั้ง)
//
// ธีม: หน้านี้ใช้พาเลตของ .claude/brand-spec-lottoplus.md §2 เต็มรูปแบบ
// **เนื้อหาเป็นผิวสว่าง** (พื้นเพจ #e1fef3 จาก bg.json)
//   ผิวการ์ด #ffffff (ตั้งโดย ContentBox) · ชั้นยก/พื้นถมอ่อน #d2f3e4
//   เส้นบาง #a3ddc3 · ขอบตกแต่ง/ออรา #19a97c (เส้น/ขอบ/ออราเท่านั้น)
//   เนื้อความ #0d3326 (13.82:1 บนการ์ดขาว) · หมึกรอง #3f6f5c (5.98:1)
//   หัวข้อ/ไฮไลต์ <strong>/ป้าย เขียวมรกต #046c4e (6.70:1) · เขียวลึก #03543c (9.23:1)
//   ปุ่มหลัก ไล่เฉด #0c7c58 -> #046c4e -> #03543c + **หมึกขาว #ffffff**
//   (คอนทราสต์ต่อ stop 5.20:1 / 6.70:1 / 9.23:1 — ผ่าน AA ทุก stop)
//   ปุ่มรอง ผิว #ffffff + หมึก #046c4e + ขอบ #19a97c
// ⚠️⚠️ **#19a97c · #2fd49b · #a3ddc3 · #d2f3e4 ห้ามถือตัวอักษรทุกกรณี** และ
// **ห้ามดันปลายอ่อนของปุ่มหลักขึ้นไปถึง #19a97c** (ขาวบนค่านั้นได้แค่ 3.0:1 ตกเกณฑ์)
// ⚠️⚠️ **รอบก่อนของไฟล์นี้เป็นชุดแดง/ทองของตระกูล *Huay** ถอดออกครบแล้ว รวมถึง
// rgba ของแดงเก่า — ปล่อยไว้ = ผิดพาเลตและหลงเหลือข้ามแบรนด์พร้อมกัน
// **ลิสต์เฮกซ์ต้องห้ามทั้งหมดอยู่ที่ `.claude/brand-spec-lottoplus.md` §2 ที่เดียว
// ห้ามคัดลอกมาไว้ในคอมเมนต์ของไฟล์นี้** (sweep จะสะดุดที่ตัวเอง)
// rgba() ที่อนุญาตรอบนี้: rgba(4,108,78,α) · rgba(25,169,124,α) ·
// rgba(47,212,155,α) · rgba(226,179,42,α) · rgba(13,51,38,α) · rgba(5,46,34,α) ·
// rgba(3,32,26,α)
//
// ย่อหน้าในกล่องไม่ถือคลาสสีของตัวเอง — ContentBox / ContentBoxNeumorphism ตั้ง
// `text-left text-base leading-relaxed` + สีหมึกไว้บนการ์ดแล้ว ทุกอย่างข้างใน
// สืบทอดลงมา สีที่เขียนเองมีแค่ไฮไลต์บน <strong> (= #046c4e)
// **ห้าม mx-auto / max-w-* บน <p>**
//
// การ์ดขั้นตอนเป็น chrome ไม่ใช่หัวข้อบทความ ป้ายจึงเป็น <span> และชื่อของชุดการ์ด
// ไปอยู่บน aria-label ของ <ul> ป้ายสามคอลัมน์ของ ContentBox3ThreeNeumorphism ก็เป็น
// คำบรรยายที่หน้านี้ตั้งเอง ไม่ใช่หัวข้อย่อยของบรีฟ จึงส่ง heading={false} ให้เป็น <p>
const steps = [
  {
    icon: "🔐",
    label: "เข้าสู่ระบบบัญชีสมาชิก",
    detail: "เข้าสู่ระบบด้วยบัญชีที่ใช้ทำรายการ ผ่านเบราว์เซอร์บนมือถือหรือคอมพิวเตอร์ บัญชีเดียวใช้เปิดเมนูตรวจบิลของหวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยหุ้นต่างประเทศได้ทั้งหมด",
  },
  {
    icon: "🎯",
    label: "เลือกประเภทหวยและงวดที่ต้องการตรวจ",
    detail: "เมนูตรวจบิลแสดงประเภทหวยไว้คู่กับงวดของรายการเสมอ ให้เลือกบรรทัดที่ตรงกับบิลที่ต้องการตรวจก่อน เพราะแต่ละรายการมีวันประกาศผลและรูปแบบการเดิมพันแตกต่างกัน",
  },
  {
    icon: "🧾",
    label: "เทียบบิลหวยกับแหล่งประกาศผลของประเภทนั้น",
    detail: "บิลหวยบันทึกประเภทหวย งวด หมายเลขที่เลือก และอัตราจ่ายไว้ตั้งแต่ตอนยืนยันบิล จึงนำไปเทียบกับผลที่ประกาศของประเภทและงวดเดียวกันได้ครบจากหน้าเดียว",
  },
];

const faqs = [
  {
    q: `ตรวจผลรางวัลและตรวจบิลกับ ${BRAND_NAME} ได้จากที่ไหน?`,
    a: "เข้าสู่ระบบบัญชีสมาชิกแล้วเปิดเมนูตรวจบิล ระบบจะแสดงประเภทหวย งวดของรายการ หมายเลขที่เลือก อัตราจ่าย และสถานะไว้ในที่เดียว บัญชีเดียวจึงใช้ตรวจบิลของหวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยหุ้นต่างประเทศได้เอง",
  },
  {
    q: `${BRAND_NAME} เป็นผู้ประกาศผลรางวัลเองหรือไม่?`,
    a: "ไม่ใช่ เว็บไซต์นำเสนอข้อมูลประเภทหวยที่เปิดให้บริการ รอบปิดรับ อัตราจ่าย และรายละเอียดของบิลที่สมาชิกทำไว้ ส่วนผลรางวัลของแต่ละงวดให้อ้างอิงแหล่งประกาศผลของประเภทนั้นเป็นหลัก หวยรัฐบาลไทยจึงอ้างอิงผลสลากกินแบ่งรัฐบาล และหวยหุ้นต่างประเทศอ้างอิงผลของตลาดที่รายการนั้นระบุไว้",
  },
  {
    q: "หวยแต่ละประเภทประกาศผลคนละวันกันหรือไม่?",
    a: "แต่ละรายการมีวันประกาศผลและรูปแบบการเดิมพันแตกต่างกัน จึงควรอ่านรอบปิดรับและวันประกาศผลที่ระบบแสดงบนรายการนั้นให้ชัดเจนก่อนทำรายการ และตรวจสอบจากประกาศล่าสุดของเว็บไซต์ทางการอีกครั้ง เพราะงวดของแต่ละประเภทไม่ได้ตรงกัน",
  },
  {
    q: "อัตราจ่าย 2 ตัว 100 และ 3 ตัว 1,000 ใช้ได้กับหวยทุกประเภทหรือไม่?",
    a: "ควรตรวจสอบก่อนทุกครั้งว่าอัตราดังกล่าวใช้กับหวยประเภทใด คำนวณจากเงินเดิมพันจำนวนเท่าใด และใช้กับสองตัวบนหรือสองตัวล่าง สามตัวตรงหรือสามตัวโต๊ด เพราะหวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยหุ้นอาจมีข้อกำหนดแตกต่างกัน รวมถึงวงเงินจ่ายสูงสุดและเงื่อนไขการรับรางวัล",
  },
  {
    q: `ตรวจบิลไม่ได้ ติดต่อ ${BRAND_NAME} อย่างไร?`,
    a: "ตรวจสอบสถานะรายการในบัญชีก่อนเป็นอันดับแรก หากยังพบความผิดปกติ ติดต่อเจ้าหน้าที่ผ่านช่องทางที่ระบุไว้บนเว็บไซต์ทางการได้ตลอด 24ชม. พร้อมแจ้งประเภทหวย งวดของรายการ และหมายเลขรายการ โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น",
  },
];

// 150–160 CHARACTERS (นับตัวอักษร ไม่ใช่ไบต์ — ห้ามใช้ wc -c เพราะไทย 1 ตัว = 3 ไบต์)
// ปัจจุบัน 158 ตัวอักษร · นับด้วย node -e "console.log([...'…'].length)"
const pageDescription = `ตรวจหวย ${BRAND_NAME} รวมวิธีตรวจผลรางวัลหวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยหุ้นต่างประเทศ พร้อมวิธีดูบิลหวยและเก็บหมายเลขรายการไว้เทียบกับแหล่งประกาศผลของแต่ละงวด`;

const pageHeading = `ตรวจหวย ${BRAND_NAME} ตรวจผลรางวัลและตรวจบิล รัฐบาลไทย ลาว ฮานอย หุ้นต่างประเทศ`;

const graph = pageGraph(Astro, {
  name: pageHeading,
  description: pageDescription,
  faqs,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ตรวจหวย", path: "/ตรวจหวย" },
  ],
});
---

<MainLayout title={`ตรวจหวย ${BRAND_NAME} ตรวจผลรางวัลและตรวจบิลหวยทุกประเภท`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#046c4e]">{BRAND_NAME}</strong> นำเสนอข้อมูลหวยออนไลน์หลายประเภทไว้ในช่องทางเดียว ทั้งหวยรัฐบาลไทยที่อ้างอิงผลสลากกินแบ่งรัฐบาล หวยลาว หวยฮานอย และหวยหุ้นต่างประเทศ โดยแต่ละรายการมีวันประกาศผลและรูปแบบการเดิมพันแตกต่างกัน
        หน้านี้รวมวิธีใช้เมนูตรวจบิลของบัญชีตัวเอง ตั้งแต่การเลือกประเภทหวย การอ่านงวดและวันประกาศผล ไปจนถึงการเทียบหมายเลขในบิลกับแหล่งประกาศผลของประเภทนั้น
      </p>

      <p>
        <strong class="text-[#046c4e]">หน้านี้ไม่ได้ประกาศผลรางวัลเอง และไม่ได้ชี้นำผลของงวดใด</strong> สิ่งที่ตรวจสอบได้จริงคือประเภทหวยที่เปิดให้บริการ รอบปิดรับ วันประกาศผล อัตราจ่าย และรายละเอียดของบิลที่ระบบบันทึกไว้ตอนยืนยันบิล
        ส่วนผลรางวัลของแต่ละงวดให้อ้างอิงแหล่งประกาศผลของประเภทนั้นเป็นหลัก แล้วจึงนำมาเทียบกับหมายเลขรายการและตัวเลขที่อยู่ในบิล ควรตรวจสอบความถูกต้องของข้อมูลและข้อกำหนดก่อนทำรายการทุกครั้ง เนื่องจากผลการออกรางวัลมีความไม่แน่นอนและไม่สามารถคาดการณ์ได้อย่างแม่นยำ
      </p>

      <p>
        เว็บไซต์ระบุว่ารับทุกเลข ไม่มีเลขอั้น และจ่ายเต็มตามอัตราที่กำหนด อย่างไรก็ตาม ก่อนยืนยันบิลควรตรวจสอบข้อจำกัดการรับหมายเลข วงเงินเดิมพันสูงสุด และเงื่อนไขการจ่ายรางวัลของแต่ละ ประเภทให้ชัดเจน
        รวมถึงตรวจว่า <strong class="text-[#046c4e]">2 ตัว 100</strong> ใช้กับสองตัวบนหรือสองตัวล่าง และ <strong class="text-[#046c4e]">3 ตัว 1,000</strong>
        ใช้กับสามตัวตรง สามตัวโต๊ด หรือรูปแบบใด เพราะอัตราจ่ายที่ถูกบันทึกลงบิลคือค่าที่ระบบแสดงอยู่ตอนยืนยัน
      </p>
    </div>
  </ContentBox>

  <ContentBoxNeumorphism as="h2" title="ขั้นตอนตรวจผลรางวัลและตรวจบิลของตัวเอง">
    <div class="flex flex-col gap-6">
      <p>ลำดับด้านล่างเป็นลำดับเดียวกับที่ระบบเก็บข้อมูลไว้ คือเข้าบัญชี เลือกประเภทหวยและงวด แล้วจึงอ่านรายละเอียดของบิล ทำตามลำดับนี้จะตัดปัญหาการอ่านข้ามประเภทหรือข้ามงวดออกไปได้เกือบทั้งหมด</p>

      <ul class="grid grid-cols-1 gap-4 md:grid-cols-3" aria-label="ขั้นตอนตรวจผลรางวัลและตรวจบิลด้วยตัวเอง">
        {
          steps.map((step, i) => (
            <li class="flex flex-col gap-2 rounded-2xl border border-[#a3ddc3] bg-[#ffffff] p-5 transition-colors hover:border-[#046c4e]">
              <div class="flex items-center gap-3">
                <span aria-hidden="true" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#046c4e] text-sm font-black text-[#ffffff]">
                  {i + 1}
                </span>
                <span aria-hidden="true" class="text-xl">
                  {step.icon}
                </span>
                <span class="text-base font-black tracking-wide text-[#046c4e]">{step.label}</span>
              </div>
              <p>{step.detail}</p>
            </li>
          ))
        }
      </ul>

      <div class="flex flex-col gap-4 sm:flex-row sm:justify-center">
        <a
          href="/login"
          class="flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#0c7c58] via-[#046c4e] to-[#03543c] px-8 py-4 font-black text-[#ffffff] shadow-[0_6px_18px_rgba(4,108,78,0.3)] transition-transform hover:scale-105">
          <span aria-hidden="true">🔒</span> เข้าสู่ระบบเพื่อตรวจบิล
        </a>
        <a
          href="/register"
          class="flex items-center justify-center gap-2 rounded-xl border border-[#19a97c] bg-[#ffffff] px-8 py-4 font-bold text-[#046c4e] shadow-[0_6px_18px_rgba(4,108,78,0.15)] transition-colors hover:bg-[#d2f3e4]">
          <span aria-hidden="true">⚡</span> สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBoxNeumorphism>

  <ContentBox3ThreeNeumorphism
    as="h2"
    title="ประเภทหวยที่เปิดให้บริการและแหล่งประกาศผลของแต่ละประเภท"
    heading={false}
    titleleft="หวยรัฐบาลไทย"
    titlecenter="หวยลาว และหวยฮานอย"
    titleright="หวยหุ้นต่างประเทศ">
    <p slot="left">หวยรัฐบาลไทยอ้างอิงผลสลากกินแบ่งรัฐบาล จึงควรอ่านรอบปิดรับที่ระบบแสดงให้ตรงกับงวดของสลากกินแบ่งรัฐบาลก่อนยืนยันบิล แล้วจึงนำหมายเลขในบิลไปเทียบกับผลของงวดเดียวกัน</p>
    <p slot="center">
      หวยลาวและหวยฮานอยมีวันประกาศผลและรูปแบบการเดิมพันของตัวเอง ก่อนทำรายการให้เลือกประเภทและงวดให้ตรงกับที่ต้องการ แล้วเทียบบิลกับแหล่งประกาศผลของงวดเดียวกันเมื่อมีประกาศผล
      เพราะหมายเลขชุดเดียวกันอาจอยู่ในหลายรายการ
    </p>
    <p slot="right">หวยหุ้นต่างประเทศอ้างอิงผลของตลาดที่รายการนั้นระบุไว้ จึงควรตรวจสอบแหล่งอ้างอิงผลที่ระบุบนรายการให้ชัดเจนก่อนยืนยันบิล และอ่านรอบปิดรับกับวันประกาศผลของรายการนั้นอีกครั้ง</p>
  </ContentBox3ThreeNeumorphism>

  <ContentBox as="h2" title="ตรวจบิลและหมายเลขรายการ ก่อนและหลังยืนยันบิล">
    <div class="flex flex-col gap-6">
      <p>
        {BRAND_NAME} แสดงอัตราจ่ายและเงื่อนไขของแต่ละรายการไว้บนหน้ารายการให้ตรวจสอบก่อนยืนยัน และเมื่อยืนยันแล้วระบบจะบันทึกประเภทหวย งวด หมายเลขที่เลือก และอัตราจ่ายนั้นลงใน
        <strong class="text-[#046c4e]">บิลหวยพร้อมหมายเลขรายการ</strong> ที่ใช้อ้างอิงได้ จึงเปิดย้อนดูได้เสมอว่ารายการนั้นอยู่ในประเภทและงวดไหน หากข้อมูลบนหน้ารายการต่างจากที่เข้าใจไว้ ให้ยึดค่าที่ระบบแสดงก่อนยืนยันบิล
      </p>

      <p>
        หลังยืนยันบิล ให้ตรวจสอบสถานะรายการในบัญชีอีกครั้ง และเก็บหมายเลขรายการกับหลักฐานที่เกี่ยวข้องไว้จนกว่าจะตรวจสอบเรียบร้อย เพราะเป็นข้อมูลชุดเดียวที่ใช้ยืนยันได้ว่ารายการนั้นถูกบันทึกไว้แล้ว
        ทั้งนี้ <strong class="text-[#046c4e]">ผลการออกรางวัลไม่สามารถรับประกันได้จากสถิติหรือเลขย้อนหลัง</strong> สิ่งที่หน้านี้ช่วยได้จึงเป็นการทำให้บิลของคุณตรวจสอบย้อนหลังได้ ไม่ใช่การคาดการณ์ผลของงวดถัดไป
      </p>

      <p>
        อัตราจ่ายเป็นค่าที่ควรอ่านจากตารางอัตราจ่ายล่าสุดของรายการนั้นเสมอ ไม่ใช่จากความเคยชินของงวดก่อน เพราะฐานเงินเดิมพัน วงเงินจ่ายสูงสุด และข้อจำกัดการรับหมายเลขของแต่ละประเภท อาจไม่เท่ากัน
        เมื่อประเภทหวย งวด รูปแบบการเดิมพัน และอัตราจ่ายบนหน้ารายการตรงกับที่ตั้งใจไว้แล้วค่อยยืนยันบิล
      </p>
    </div>
  </ContentBox>

  <LatestWinners />

  <ContentBoxNeumorphism as="h2" title={`ติดต่อแอดมิน ${BRAND_NAME} ได้ตลอด 24ชม. เมื่อตรวจบิลไม่ได้`}>
    <div class="flex flex-col gap-6">
      <p>
        หากพบปัญหาเกี่ยวกับประเภทหวย รอบปิดรับ อัตราจ่าย หรือการตรวจบิล ให้ตรวจสอบสถานะรายการในบัญชีก่อนเป็นอันดับแรก เพราะรายการส่วนใหญ่อธิบายได้จากข้อมูลที่ระบบบันทึกไว้แล้ว หากยังพบความผิดปกติ <strong
          class="text-[#046c4e]">
          ติดต่อเจ้าหน้าที่ผ่านช่องทางที่ระบุไว้บนเว็บไซต์ทางการได้ตลอด 24ชม.
        </strong> พร้อมแจ้งรายละเอียดของรายการเพื่อช่วยให้เจ้าหน้าที่ตรวจสอบได้ตรงจุด
      </p>

      <p>
        ควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความทุกครั้ง เพื่อหลีกเลี่ยงบัญชีแอบอ้าง กรณีที่เกี่ยวกับบิลหวย ให้เตรียมประเภทหวย งวดของรายการ และหมายเลขรายการไปพร้อมกัน
        พร้อมแจ้งรายละเอียดให้ชัดเจน โดย <strong class="text-[#046c4e]">ไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น</strong> ระหว่างการติดต่อ และควรตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุดอีกครั้ง
      </p>
    </div>
  </ContentBoxNeumorphism>

