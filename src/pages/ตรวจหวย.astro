---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBox3ThreeNeumorphism from "../components/ContentBox3ThreeNeumorphism.astro";
import LatestWinners from "../components/LatestWinnersHuay.astro";
import Faq from "../components/FaqHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้ว่าด้วย "การตรวจผลรางวัลของแต่ละประเภทหวย และการตรวจสอบรายการของตัวเอง"
// ไม่มีตัวเลขของรอบใด ไม่มีตารางผล ไม่มีวันที่ ไม่มีสถิติ และไม่มีการทำนายผลใด ๆ
// เว็บไซต์ไม่ใช่ผู้ประกาศผล — ผลรางวัลให้อ้างอิงแหล่งอ้างอิงผลรางวัลของประเภทนั้น
//
// ข้อเท็จจริงทั้งหมดยึดตาม src/assets/content.txt ของรอบนี้เท่านั้น: รวมข้อมูลหวย
// หลายประเภทไว้ในเว็บไซต์เดียว — หวยรัฐบาลไทยที่อ้างอิงผลสลากกินแบ่งรัฐบาล
// หวยลาวพัฒนาและหวยฮานอยที่มีรอบประกาศผลแตกต่างกัน และหวยหุ้นต่างประเทศ
// (บรรทัด 4, 6) · รอบเปิดรับ รอบปิดรับ รอบประกาศผล และเงื่อนไขของแต่ละรายการ
// (บรรทัด 4, 6) · ควรตรวจสอบวันเวลาเปิดรับ อัตราจ่าย แหล่งอ้างอิงผลรางวัล และ
// ข้อกำหนดของแต่ละประเภทก่อนทำรายการ (บรรทัด 6) · เก็บหมายเลขรายการและหลักฐาน
// ที่เกี่ยวข้องไว้สำหรับตรวจสอบ ไม่เปิดเผยรหัสผ่านหรือรหัส OTP (บรรทัด 22) ·
// ตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการเพื่อหลีกเลี่ยงบัญชีแอบอ้าง (บรรทัด 22) ·
// แอดมิน 24ชม. (บรรทัด 21, 22) · ตรวจสอบสถานะรายการแล้วติดต่อเจ้าหน้าที่ (บรรทัด 29)
//
// ⚠️ บรีฟรอบนี้ระบุประเภทหวยไว้สี่ชื่อเท่านั้น (รัฐบาลไทย · ลาวพัฒนา · ฮานอย ·
// หุ้นต่างประเทศ) ห้ามเติมประเภทอื่น (ออมสิน ธ.ก.ส. ยี่กี) และห้ามเติมสิ่งที่บรีฟ
// ไม่ได้ให้ไว้: ใบอนุญาต · หน่วยงานกำกับ · นิติบุคคล · ชื่อธนาคาร · ชื่อค่ายเกม ·
// เวลาประกาศผลเป็นตัวเลข · ตารางผลย้อนหลัง · ยอดขั้นต่ำเป็นตัวเลข · จำนวนสมาชิก ·
// ปีก่อตั้ง — ตัวเลขที่ขึ้นหน้าได้มีแค่ 2 ตัว 100 · 3 ตัว 1,000 · 0.3% · 0.8% · 24ชม.
// ⚠️ ห้ามเขียนเลขเด็ด เลขแนะนำ สถิติย้อนหลัง สูตร เทคนิค หรือการทำนายผล และห้ามใช้
// คำที่บรีฟไม่มี (สล็อต · บาคาร่า · ยิงปลา · ไฮโล · บอล · คาสิโนสด · RTP · ค่ายเกม ·
// เว็บตรง · ไม่ผ่านเอเย่นต์ · มงกุฎ · หวยคิง)
//
// คำกำกับความเสี่ยงของบรีฟเป็นเนื้อหาของหน้า ไม่ใช่ของตัดทิ้ง: ควรตรวจสอบวันเวลา
// เปิดรับ อัตราจ่าย และแหล่งอ้างอิงผลรางวัลก่อนทำรายการ (บรรทัด 6) · ผลรางวัล
// ไม่สามารถคาดการณ์หรือรับประกันได้ (บรรทัด 12) · ข้อมูลเกี่ยวกับบริษัทแม่และ
// ประวัติการให้บริการควรตรวจสอบจากหลักฐานที่เชื่อถือได้ (บรรทัด 4)
//
// CHROME: AnnouncementHuay · FaqHuay · LatestWinnersHuay — รอบนี้ทั้งเว็บย้ายไป
// Announcement5 / Faq3 / LatestWinnersPremium แล้ว สองหน้าหวย (หน้านี้กับ
// /แนวทาง) เก็บชุด *Huay + *Neumorphism ไว้เป็นซับธีมตามข้อยกเว้น Phase 4.5
// ของ playbook โดยตั้งใจ (เรียก <Announcement /> แบบ bare ให้ตกไปใช้ default
// message ของแบรนด์ปัจจุบัน ห้ามส่ง message prop · FaqHuay มี default faqs = []
// จึงต้องส่ง prop faqs ทุกครั้ง)
//
// ธีม: ⚠️ ข้อยกเว้น Phase 4.5 คุ้มครอง **ชุดคอมโพเนนต์** เท่านั้น ไม่ได้คุ้มครอง
// พาเลตเก่าหรือชื่อแบรนด์เก่า — หน้านี้ใช้พาเลตของ brand-spec §2 เต็มรูปแบบ
// (ธีมสว่าง: พื้นเพจ #ffdbdb จาก bg.json)
//   ผิวการ์ด #ffffff · อินเซ็ต #fff1ef · เนื้อความ #4a0f0f (15.4:1)
//   หัวข้อ/ขอบ/ออรา/พื้นถมปุ่ม #c30303 (6.3:1 · ขาวบนพื้นนี้ 6.3:1)
//   ไฮไลต์บน <strong> #8f0505 (9.6:1) — สงวนไว้ให้งานนั้นงานเดียว
// ⚠️ ทองโบราณ #dcb95f #b8862b #96681f เป็นสีของโครมเท่านั้น (บนการ์ดขาวได้แค่
// 1.9–3.5:1) หน้านี้จึงไม่มีทองเลย และไม่มีแดงสแกเลต #e81313 ถือตัวอักษรหรือเป็น
// พื้นของตัวอักษร
//
// ย่อหน้าในกล่องไม่ถือคลาสสีของตัวเอง — ContentBox / ContentBoxNeumorphism ตั้ง
// `text-left text-base leading-relaxed` + สีหมึกไว้บนการ์ดแล้ว ทุกอย่างข้างใน
// สืบทอดลงมา สีที่เขียนเองมีแค่ไฮไลต์บน <strong> (= #8f0505)
//
// การ์ดขั้นตอนเป็น chrome ไม่ใช่หัวข้อบทความ ป้ายจึงเป็น <span> และชื่อของชุดการ์ด
// ไปอยู่บน aria-label ของ <ul> ป้ายสามคอลัมน์ของ ContentBox3ThreeNeumorphism ก็เป็น
// คำบรรยายที่หน้านี้ตั้งเอง ไม่ใช่หัวข้อย่อยของบรีฟ จึงส่ง heading={false} ให้เป็น <p>
const steps = [
  {
    icon: "🔐",
    label: "เข้าสู่ระบบบัญชีสมาชิก",
    detail:
      "เข้าสู่ระบบด้วยบัญชีที่ใช้ทำรายการ ผ่านเบราว์เซอร์บนมือถือหรือคอมพิวเตอร์ บัญชีเดียวใช้เปิดเมนูตรวจสอบรายการของหวยรัฐบาลไทย หวยลาวพัฒนา หวยฮานอย และหวยหุ้นต่างประเทศได้ทั้งหมด",
  },
  {
    icon: "🎯",
    label: "เลือกประเภทหวยและรอบประกาศผล",
    detail:
      "เมนูตรวจสอบรายการแสดงประเภทหวยไว้คู่กับรอบของรายการเสมอ ให้เลือกบรรทัดที่ตรงกับรายการที่ต้องการตรวจก่อน เพราะหวยแต่ละประเภทมีรอบปิดรับและรอบประกาศผลต่างกัน",
  },
  {
    icon: "🧾",
    label: "เทียบบิลหวยกับแหล่งอ้างอิงผลรางวัล",
    detail:
      "บิลหวยบันทึกประเภทหวย รอบ ตัวเลขที่เลือก และอัตราจ่ายไว้ตั้งแต่ตอนยืนยันรายการ จึงนำไปเทียบกับแหล่งอ้างอิงผลรางวัลของประเภทและรอบเดียวกันได้ครบจากหน้าเดียว",
  },
];

const faqs = [
  {
    q: `ตรวจผลรางวัลและตรวจสอบรายการกับ ${BRAND_NAME} ได้จากที่ไหน?`,
    a: "เข้าสู่ระบบบัญชีสมาชิกแล้วเปิดเมนูตรวจสอบรายการ ระบบจะแสดงประเภทหวย รอบของรายการ ตัวเลขที่เลือก อัตราจ่าย และสถานะไว้ในที่เดียว บัญชีเดียวจึงใช้ตรวจสอบรายการของหวยรัฐบาลไทย หวยลาวพัฒนา หวยฮานอย และหวยหุ้นต่างประเทศได้เอง",
  },
  {
    q: `${BRAND_NAME} เป็นผู้ประกาศผลรางวัลเองหรือไม่?`,
    a: "ไม่ใช่ เว็บไซต์รวบรวมข้อมูลประเภทหวยที่เปิดให้บริการ รอบปิดรับ อัตราจ่าย และรายละเอียดของรายการที่สมาชิกทำไว้ ส่วนผลรางวัลของแต่ละรอบให้อ้างอิงแหล่งอ้างอิงผลรางวัลของประเภทนั้นเป็นหลัก หวยรัฐบาลไทยอ้างอิงผลสลากกินแบ่งรัฐบาล ส่วนหวยหุ้นต่างประเทศมีรอบประกาศผลของตัวเอง",
  },
  {
    q: "แต่ละประเภทหวยประกาศผลคนละรอบกันหรือไม่?",
    a: "หวยแต่ละประเภทมีรอบประกาศผลตามประเภทของตัวเอง จึงควรอ่านรอบปิดรับและรอบประกาศผลที่ระบบแสดงบนรายการนั้นให้ชัดเจนก่อนทำรายการ และตรวจสอบจากประกาศล่าสุดของเว็บไซต์ทางการอีกครั้ง เพราะรอบของแต่ละประเภทไม่ได้ตรงกัน",
  },
  {
    q: "อัตราจ่ายในบิลหวยไม่ตรงกับที่เข้าใจไว้ ต้องยึดอะไร?",
    a: "ให้ยึดอัตราจ่ายที่ระบบแสดงบนรายการตอนยืนยัน เพราะเป็นค่าที่ถูกบันทึกลงในบิลหวยของรายการนั้นจริง อัตราจ่ายและเงื่อนไขอาจต่างกันตามประเภทหวย รูปแบบการเดิมพัน และข้อจำกัดยอดรับของแต่ละรอบ จึงควรตรวจสอบตารางอัตราจ่ายล่าสุดก่อนทำรายการทุกครั้ง",
  },
  {
    q: `ตรวจสอบรายการไม่ได้ ติดต่อ ${BRAND_NAME} อย่างไร?`,
    a: `ตรวจสอบสถานะรายการในบัญชีก่อนเป็นอันดับแรก หากยังพบความผิดปกติ ติดต่อเจ้าหน้าที่ผ่านช่องทางที่ระบุไว้บนเว็บไซต์ทางการได้ตลอด 24ชม. พร้อมแจ้งประเภทหวย รอบของรายการ และหมายเลขรายการ โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น`,
  },
];

// 150–160 CHARACTERS (นับตัวอักษร ไม่ใช่ไบต์ — ห้ามใช้ wc -c) ปัจจุบัน 159 ตัวอักษร
const pageDescription = `ตรวจหวย ${BRAND_NAME} รวมวิธีตรวจผลรางวัลหวยรัฐบาลไทย ลาวพัฒนา ฮานอย และหวยหุ้นต่างประเทศ พร้อมวิธีตรวจสอบบิลหวยและหมายเลขรายการจากแหล่งอ้างอิงผลรางวัลที่ยืนยันได้`;

const pageHeading = `ตรวจหวย ${BRAND_NAME} ตรวจผลรางวัลและตรวจสอบรายการ รัฐบาลไทย ลาวพัฒนา ฮานอย หุ้นต่างประเทศ`;

const graph = pageGraph(Astro, {
  name: pageHeading,
  description: pageDescription,
  faqs,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ตรวจหวย", path: "/ตรวจหวย" },
  ],
});
---

<MainLayout title={`ตรวจหวย ${BRAND_NAME} ตรวจผลรางวัลและตรวจสอบบิลหวยทุกประเภท`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#8f0505]">{BRAND_NAME}</strong> รวบรวมข้อมูลหวยหลายประเภทไว้ในเว็บไซต์เดียว ทั้งหวยรัฐบาลไทยที่อ้างอิงผลสลากกินแบ่งรัฐบาล หวยลาวพัฒนาและหวยฮานอยที่มีรอบประกาศผลตามประเภท
        รวมถึงหวยหุ้นต่างประเทศที่มีรอบประกาศผลของตัวเอง หน้านี้รวมวิธีใช้เมนูตรวจสอบรายการของบัญชีตัวเอง ตั้งแต่การเลือกประเภทหวย การอ่านรอบประกาศผล
        ไปจนถึงการเทียบตัวเลขในบิลหวยกับแหล่งอ้างอิงผลรางวัลของประเภทนั้น
      </p>

      <p>
        <strong class="text-[#8f0505]">หน้านี้ไม่ได้ประกาศผลรางวัลเอง และไม่ได้ชี้นำผลของรอบใด</strong> สิ่งที่ตรวจสอบได้จริงคือประเภทหวยที่เปิดให้บริการ รอบเปิดรับ รอบปิดรับ รอบประกาศผล อัตราจ่าย
        และรายละเอียดของบิลหวยที่ระบบบันทึกไว้ตอนยืนยันรายการ ส่วนผลรางวัลของแต่ละรอบให้อ้างอิงแหล่งอ้างอิงผลรางวัลของประเภทนั้นเป็นหลัก แล้วจึงนำมาเทียบกับหมายเลขรายการและตัวเลขที่อยู่ในบิลหวย
      </p>

      <p>
        ก่อนทำรายการทุกครั้งควรตรวจสอบวันเวลาเปิดรับ อัตราจ่าย และแหล่งอ้างอิงผลรางวัลให้ชัดเจน เพราะหวยแต่ละประเภทมีรอบปิดรับและรอบประกาศผลไม่ตรงกัน
        ส่วนรายละเอียดการฝากถอนและเงื่อนไขของแต่ละรายการให้อ่านจากประกาศล่าสุดของเว็บไซต์ทางการ ส่วนข้อมูลเกี่ยวกับบริษัทแม่และประวัติการให้บริการ
        ควรตรวจสอบจากหลักฐานที่เชื่อถือได้
      </p>
    </div>
  </ContentBox>

  <ContentBoxNeumorphism as="h2" title="ขั้นตอนตรวจผลรางวัลและตรวจสอบรายการของตัวเอง">
    <div class="flex flex-col gap-6">
      <p>
        ลำดับด้านล่างเป็นลำดับเดียวกับที่ระบบเก็บข้อมูลไว้ คือเข้าบัญชี เลือกประเภทหวยและรอบ แล้วจึงอ่านรายละเอียดของบิลหวย ทำตามลำดับนี้จะตัดปัญหาการอ่านข้ามประเภทหรือข้ามรอบออกไปได้เกือบทั้งหมด
      </p>

      <ul class="grid grid-cols-1 gap-4 md:grid-cols-3" aria-label="ขั้นตอนตรวจผลรางวัลและตรวจสอบรายการด้วยตัวเอง">
        {
          steps.map((step, i) => (
            <li class="flex flex-col gap-2 rounded-2xl border border-[#c30303]/30 bg-[#fff1ef] p-5 transition-colors hover:border-[#c30303]/70">
              <div class="flex items-center gap-3">
                <span aria-hidden="true" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#c30303] text-sm font-black text-white">
                  {i + 1}
                </span>
                <span aria-hidden="true" class="text-xl">
                  {step.icon}
                </span>
                <span class="text-base font-black tracking-wide text-[#c30303]">{step.label}</span>
              </div>
              <p>{step.detail}</p>
            </li>
          ))
        }
      </ul>

      <div class="flex flex-col gap-4 sm:flex-row sm:justify-center">
        <a
