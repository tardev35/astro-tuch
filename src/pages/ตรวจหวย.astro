---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ContentBoxHuay from "../components/ContentBoxHuay.astro";
import LatestWinnersHuay from "../components/LatestWinnersHuay.astro";
import FaqHuay from "../components/FaqHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้ว่าด้วย "วิธีที่สมาชิกเปิดประวัติโพยของตัวเองขึ้นมาตรวจ" เท่านั้น —
// ไม่มีผลรางวัล ไม่มีตัวเลขของรอบใด ไม่มีวันที่ ไม่มีสถิติ และไม่มีการทำนายใด ๆ
// เว็บไซต์ไม่ได้เป็นผู้ประกาศผล ให้ยึดผลอย่างเป็นทางการของหวยแต่ละประเภทเป็นหลัก
//
// ข้อเท็จจริงทั้งหมดยึดตาม src/assets/content.txt ของรอบนี้เท่านั้น: เลือกเลขและ
// ส่งโพยผ่านระบบบนมือถือ · มีเลข 2 ตัว เลข 3 ตัว และรายการหวยตามรอบที่เว็บไซต์
// เปิดให้บริการ · ตรวจสอบเลข ยอดแทง อัตราจ่าย และสถานะโพยได้ก่อนยืนยัน ·
// อัตราของรายการที่เข้าเงื่อนไขคือ 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท
// ซึ่งอาจแตกต่างตามประเภทหวยและรูปแบบการเดิมพัน · เลขที่มีผู้เลือกจำนวนมากระบบ
// อาจกำหนดวงเงินรับแทงตามแต่ละรอบ · สมัคร 3 ขั้นตอน · แอดมิน 24 ชั่วโมง ·
// ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP
//
// ⚠️ บรีฟรอบนี้ "ไม่ได้ระบุชื่อตลาดหวยแม้แต่ชื่อเดียว" — หวยรัฐบาลไทย หวยฮานอย
// หวยลาวพัฒนา หวยหุ้นต่างประเทศ ยี่กี เคยอยู่บนหน้านี้จากบรีฟของแบรนด์ก่อน และ
// ถูกถอดออกครบแล้ว ห้ามเติมกลับ เช่นเดียวกับ สถิติหวยย้อนหลัง · กลุ่มหวย ·
// แนวทางหวย ในฐานะฟีเจอร์ของเว็บ (บรีฟไม่ได้ให้ไว้) · เวลาเปิด-ปิดรับ ·
// ชื่อธนาคาร · เลขใบอนุญาต · ยอดฝากขั้นต่ำ · จำนวนสมาชิก · ปีก่อตั้ง
// ตัวเลขที่ใช้ได้มีแค่ 2 ตัว / 3 ตัว / 100 / 1,000 / บาทละ 1,000 / 3 ขั้นตอน /
// 24 ชั่วโมง
//
// หน้านี้คงตระกูล Huay + AnnouncementHuay ตาม brand-spec §3 — รอบนี้แบรนด์เป็น
// เว็บหวยจริง ธีมนี้จึงเป็นธีมของแบรนด์เอง ไม่ใช่ข้อยกเว้นเฉพาะหมวดอีกต่อไป และ
// AnnouncementHuay คือ ticker ของทุกหน้าในไซต์ (เรียกแบบ bare ให้ตกไปใช้ default
// message ของแบรนด์ปัจจุบัน) ชื่อแบรนด์มาจาก BRAND_NAME ไม่พิมพ์ทับ
//
// ค่าสีทุกจุดเป็นเลขจริงของ brand-spec §2 รอบนี้: ทองสว่าง #fdeb7c · ทองแบรนด์
// #cd9a2c · ทองลึก #ab7314 · ครีมอมพีช #fcd4c3 · เนื้อความ #f5e7c8 · ผิวการ์ดยก
// #1c140b · พื้นลึกสุด #0c0b0a · หมึกบนปุ่มทอง #120a02 · ขอบจาง #5c3f12 ·
// glow rgba(205,154,44,α) · เงาดำกลาง rgba(0,0,0,α)
// ชุดแดง-ทองของรอบก่อน (#dc0203 #f5282a #8c0402 #ffc93c #ffeab0 #c08a07 #f6e7e0
// #140203 #240406 #3a0a0c #1a0303 rgba(255,201,60,*) rgba(8,1,1,*)) ออกครบแล้ว
//
// ย่อหน้าในกล่องไม่ถือคลาสสีของตัวเอง — ContentBoxHuay ตั้ง
// `text-left text-base leading-relaxed text-[#f5e7c8]` ไว้บนการ์ดแล้ว ทุกอย่าง
// ข้างในสืบทอดลงมา สีที่เขียนเองมีแค่ accent บน <strong> เท่านั้น
//
// การ์ดขั้นตอนด้านล่างเป็น chrome ไม่ใช่หัวข้อบทความ ป้ายจึงเป็น <span> และชื่อ
// ของชุดการ์ดไปอยู่บน aria-label ของ <ul> (บทบาท list รับชื่อได้จริง ต่างจาก
// <div> เปล่าที่ aria-label ไม่ถูกประกาศ)
const steps = [
  {
    icon: "🔐",
    label: "Login เข้าบัญชีสมาชิก",
    detail: "เข้าสู่ระบบด้วยบัญชีเดียวกับที่ใช้ส่งโพย ผ่านเบราว์เซอร์บนมือถือหรือคอมพิวเตอร์ แล้วเปิดเมนูประวัติโพยในบัญชีของตัวเอง",
  },
  {
    icon: "🎯",
    label: "เทียบรายการหวยและรอบให้ตรงกับโพย",
    detail: "ประวัติโพยแสดงทั้งรายการหวยและรอบที่ส่งไว้ ให้เลือกบรรทัดที่ตรงกับโพยที่ต้องการตรวจก่อน เพราะเลขชุดเดียวกันอาจถูกส่งไว้มากกว่าหนึ่งรอบ",
  },
  {
    icon: "🧾",
    label: "อ่านเลข ยอดแทง อัตราจ่าย และสถานะ",
    detail: "ระบบบันทึกเลขที่เลือก ยอดแทง และอัตราจ่ายไว้ตั้งแต่ตอนกดยืนยัน พร้อมสถานะของรายการนั้น จึงอ่านครบได้จากหน้าเดียวโดยไม่ต้องจดไว้เอง",
  },
];

const faqs = [
  {
    q: `ตรวจโพยของตัวเองกับ ${BRAND_NAME} ได้จากที่ไหน?`,
    a: "Login เข้าบัญชีสมาชิกแล้วเปิดประวัติโพย ระบบจะแสดงรายการหวยและรอบที่ส่ง เลขที่เลือก ยอดแทง อัตราจ่าย และสถานะของรายการนั้นไว้ในที่เดียว จึงเปิดย้อนดูได้เองทุกเมื่อโดยไม่ต้องสอบถามแอดมินก่อน",
  },
  {
    q: `${BRAND_NAME} เป็นผู้ประกาศผลเองหรือไม่?`,
    a: "ไม่ใช่ เว็บไซต์ทำหน้าที่รับโพยและบันทึกรายละเอียดของรายการที่สมาชิกส่งเข้ามาเท่านั้น การอ่านผลให้ยึดการประกาศผลอย่างเป็นทางการของหวยประเภทนั้นเป็นหลัก แล้วจึงนำมาเทียบกับเลขและรอบที่บันทึกไว้ในโพย",
  },
  {
    q: "อัตราจ่ายในโพยไม่ตรงกับข้อความประชาสัมพันธ์ ต้องยึดอันไหน?",
    a: "ให้ยึดอัตราที่ระบบแสดงบนหน้าส่งโพยตอนกดยืนยัน เพราะเป็นอัตราที่ถูกบันทึกลงในโพยรายการนั้นจริง อัตราจ่ายอาจแตกต่างตามประเภทหวย รูปแบบการแทง หรือเงื่อนไขของแต่ละรอบ จึงไม่ควรถือว่าทุกรายการใช้อัตราเดียวกัน",
  },
  {
    q: "ทำไมเลขที่เลือกไว้ถึงถูกจำกัดยอด?",
    a: "เลขที่มีผู้เลือกจำนวนมากระบบอาจกำหนดวงเงินรับแทงตามแต่ละรอบ ยอดที่ส่งได้จึงเป็นยอดสูงสุดที่ระบบเปิดรับของเลขนั้นในรอบนั้น ควรกรอกเลขแล้วดูวงเงินที่ระบบแสดงก่อนกดยืนยันทุกครั้ง",
  },
  {
    q: "สถานะโพยไม่ตรงกับที่ส่งไว้ ต้องทำอย่างไร?",
    a: `เปิดประวัติโพยในบัญชีดูก่อนเป็นอันดับแรก หากยังพบความผิดปกติ ติดต่อแอดมิน ${BRAND_NAME} ผ่านช่องทางบริการที่เว็บไซต์กำหนดได้ตลอด 24 ชั่วโมง พร้อมแจ้งชื่อรายการ รอบ เลขที่เลือก และข้อมูลโพย โดยไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น`,
  },
];

// 150–160 CHARACTERS (นับตัวอักษร ไม่ใช่ไบต์ — ห้ามใช้ wc -c) ปัจจุบัน 153 ตัวอักษร
const pageDescription = `ตรวจหวย ${BRAND_NAME} เปิดประวัติโพยในบัญชีสมาชิกเพื่อเทียบรายการหวยและรอบที่ส่ง พร้อมอ่านเลข ยอดแทง อัตราจ่าย และสถานะที่ระบบบันทึกไว้ตอนยืนยันโพยได้ด้วยตัวเอง`;

const graph = pageGraph(Astro, {
  name: `ตรวจหวย ${BRAND_NAME} เปิดประวัติโพยตรวจเลข ยอดแทง และสถานะด้วยตัวเอง`,
  description: pageDescription,
  faqs,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ตรวจหวย", path: "/ตรวจหวย" },
  ],
});
---

<MainLayout title={`ตรวจหวย ${BRAND_NAME} ตรวจเลข ยอดแทง อัตราจ่าย และสถานะโพยจากบัญชีสมาชิก`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxHuay title={`ตรวจหวย ${BRAND_NAME} เปิดประวัติโพยตรวจเลข ยอดแทง และสถานะด้วยตัวเอง`} as="h1">
    <div class="flex flex-col gap-6">
      <p>
        หน้านี้รวมวิธีที่สมาชิก <strong class="text-[#fdeb7c]">{BRAND_NAME}</strong> เปิดโพยของตัวเองขึ้นมาตรวจ ตั้งแต่ Login เข้าบัญชี เปิดประวัติโพย เลือกรายการหวยและรอบให้ตรงกับโพยที่ส่งไว้
        ไปจนถึงการอ่านเลข ยอดแทง อัตราจ่าย และสถานะที่ระบบบันทึกไว้ตอนกดยืนยัน ทั้งหมดอยู่ในบัญชีเดียวและเปิดดูได้จากเบราว์เซอร์บนมือถือ โดยไม่ต้องจดรายละเอียดของโพยไว้เอง
      </p>

      <p>
        <strong class="text-[#fdeb7c]">หน้านี้ไม่มีตัวเลขของรอบใด ไม่ประกาศผลรางวัล และไม่ทำนายเลข</strong> สิ่งที่เว็บไซต์บันทึกไว้คือรายละเอียดของโพยที่สมาชิกส่งเข้ามาเท่านั้น
        ส่วนผลให้อ้างอิงการประกาศผลอย่างเป็นทางการของหวยประเภทนั้นเป็นหลัก แล้วจึงนำมาเทียบกับเลขและรอบที่อยู่ในโพยของตัวเอง
      </p>

      <ul class="grid grid-cols-1 gap-4 md:grid-cols-3" aria-label="ขั้นตอนเปิดประวัติโพยเพื่อตรวจรายการด้วยตัวเอง">
        {
          steps.map((step, i) => (
            <li class="flex flex-col gap-2 rounded-2xl border border-[#cd9a2c]/45 bg-[#0c0b0a]/70 p-5 transition-colors hover:border-[#fdeb7c]/60">
              <div class="flex items-center gap-3">
                <span aria-hidden="true" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gradient-to-b from-[#fdeb7c] to-[#ab7314] text-sm font-black text-[#120a02]">
                  {i + 1}
                </span>
                <span aria-hidden="true" class="text-xl">
                  {step.icon}
                </span>
                <span class="text-base font-black tracking-wide text-[#fdeb7c]">{step.label}</span>
              </div>
              <p>{step.detail}</p>
            </li>
          ))
        }
      </ul>

      <div class="flex flex-col gap-4 sm:flex-row sm:justify-center">
        <a
          href="/login"
          class="flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#ab7314] via-[#fdeb7c] to-[#ab7314] px-8 py-4 font-black text-[#120a02] shadow-[0_5px_15px_rgba(205,154,44,0.4)] transition-transform hover:scale-105">
          <span aria-hidden="true">🔒</span> เข้าสู่ระบบเพื่อตรวจโพย
        </a>
        <a
          href="/register"
          class="flex items-center justify-center gap-2 rounded-xl border border-[#cd9a2c]/60 bg-[#0c0b0a] px-8 py-4 font-bold text-[#fdeb7c] shadow-[0_5px_15px_rgba(0,0,0,0.6)] transition-colors hover:bg-[#1c140b]">
          <span aria-hidden="true">⚡</span> สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBoxHuay>

  <ContentBoxHuay title="เว็บไซต์ไม่ได้ประกาศผลเอง ให้ยึดผลอย่างเป็นทางการของหวยแต่ละประเภท" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        สิ่งที่ {BRAND_NAME} เก็บไว้ให้คือโพยของสมาชิกเอง ไม่ใช่ผลของรอบใด เมื่อรอบที่ส่งโพยไว้มีการประกาศผลแล้ว ให้นำ
        <strong class="text-[#fdeb7c]">เลขที่บันทึกอยู่ในโพยไปเทียบกับการประกาศผลอย่างเป็นทางการของหวยประเภทเดียวกันและรอบเดียวกับที่ส่งจริง</strong>
        การอ่านข้ามประเภทหรือข้ามรอบคือสาเหตุที่พบบ่อยที่สุดของการเข้าใจผิดว่าโพยไม่ถูกรางวัล
      </p>

      <p>
        ในประวัติโพยจะเห็นรายการหวยและรอบที่ส่งอยู่คู่กันเสมอ จึงควรเลือกบรรทัดที่ตรงกับโพยที่ต้องการตรวจก่อนอ่านรายละเอียดอื่น เพราะเลขชุดเดียวกันอาจถูกส่งไว้มากกว่าหนึ่งรอบ
        และเลขชุดเดียวกันก็ยังใช้ตัดสินคนละรูปแบบกันได้ ทั้งเลข 2 ตัวและเลข 3 ตัว
      </p>

      <p>
        หากรายละเอียดในโพยไม่ตรงกับที่ตั้งใจ ให้เก็บข้อมูลของโพยรายการนั้นไว้แล้วแจ้งแอดมินตรวจสอบ แทนการสรุปผลด้วยตัวเองจากรอบอื่น
        สถานะของแต่ละรายการจะอัปเดตอยู่ในประวัติโพยของบัญชีสมาชิกให้เปิดดูย้อนหลังได้ตลอด
      </p>
    </div>
  </ContentBoxHuay>

  <ContentBoxHuay title={`อัตราจ่ายที่บันทึกไว้ในโพย 2 ตัวจ่าย 100 บาท และ 3 ตัวจ่าย 1,000 บาท`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        {BRAND_NAME} แสดงอัตราจ่ายของแต่ละรูปแบบไว้บนหน้าส่งโพยให้ตรวจสอบก่อนยืนยัน อัตราของรายการที่เข้าเงื่อนไขคือ
        <strong class="text-[#fdeb7c]">2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท</strong> แต่
        <strong class="text-[#fdeb7c]">อัตราจ่ายอาจแตกต่างตามประเภทหวย รูปแบบการแทง หรือเงื่อนไขของแต่ละรอบ</strong>
        จึงไม่ควรถือว่าทุกรายการใช้อัตราเดียวกัน หากข้อมูลบนหน้าส่งโพยต่างจากข้อความประชาสัมพันธ์ ให้ยึดอัตราล่าสุดที่ระบบแสดงก่อนยืนยันรายการ
      </p>

      <p>
        อัตราที่เห็นตอนกดยืนยันจะถูกบันทึกลงในโพยพร้อมกับรายการหวย รอบ เลขที่เลือก และยอดแทง จึงเปิดย้อนดูได้เสมอว่ารายการนั้นคิดจากอัตราเท่าไร และนำไปเทียบกับสถานะที่ระบบอัปเดตไว้ได้โดยตรง
        สำหรับเลขที่มีผู้เลือกจำนวนมาก ระบบอาจกำหนด <strong class="text-[#fdeb7c]">วงเงินรับแทง</strong> ตามแต่ละรอบ ยอดที่ส่งได้จึงเป็นยอดสูงสุดที่ระบบเปิดรับของเลขนั้นในรอบนั้น
      </p>

      <p>
        ผู้ที่ยังไม่มีบัญชีสมัครเองได้ผ่านมือถือด้วย 3 ขั้นตอน คือ เปิดหน้าสมัครและกรอกข้อมูลตามที่ระบบกำหนด ยืนยันข้อมูลเพื่อสร้างบัญชีและ Login เข้าสู่ระบบ แล้วเลือกรายการหวย กรอกตัวเลขและยอดที่ต้องการ
        พร้อมตรวจสอบอัตราจ่ายก่อนส่งโพย ประวัติโพยจะเก็บทุกรายการที่ส่งไว้ในบัญชีนั้นตั้งแต่รายการแรก ทำให้ย้อนกลับมาตรวจได้ตลอด
      </p>
