---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBox3ThreeNeumorphism from "../components/ContentBox3ThreeNeumorphism.astro";
import LatestWinners from "../components/LatestWinnersPremium.astro";
import Faq from "../components/Faq3.astro";
import Navfoot from "../components/Navfoot.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้ว่าด้วย "การตรวจผลรางวัลของรายการที่เปิดรับ และการเปิดประวัติโพยของตัวเอง
// ขึ้นมาเทียบ" — ไม่มีตัวเลขของรอบใด ไม่มีตารางผล ไม่มีวันที่ ไม่มีสถิติ และไม่มี
// การทำนายใด ๆ เว็บไซต์ไม่ใช่ผู้ประกาศผล ให้ยึดการประกาศผลอย่างเป็นทางการของหวย
// แต่ละรายการเป็นหลัก
//
// ข้อเท็จจริงทั้งหมดยึดตาม src/assets/content.txt ของรอบนี้เท่านั้น: รวมรายการและ
// แนวทางหวยให้ติดตามผ่านมือถือ ทั้งหวยลาว หวยฮานอย และรัฐบาลไทย (บรรทัด 4, 6) ·
// มีข้อมูลรอบเปิดรับ อัตราจ่าย และผลรางวัล (บรรทัด 4) · บัญชีเดียวติดตามผลรางวัล
// และประวัติโพยได้ (บรรทัด 17) · อัตราของรายการที่เข้าเงื่อนไขคือ 2 ตัว จ่าย 100
// บาท และ 3 ตัว จ่าย 1,000 บาท ซึ่งอาจต่างตามประเภทหวย รูปแบบการแทง และรอบ
// (บรรทัด 9, 27) · เลขที่มียอดเดิมพันสูงอาจมีวงเงินรับต่างจากเลขทั่วไป (บรรทัด 7,
// 25) · สมัคร 3 ขั้นตอน (บรรทัด 16) · แอดมิน 24 ชั่วโมง (บรรทัด 19) · ระบบเข้าใช้
// งานได้ 24 ชั่วโมง แต่เวลารับแทงขึ้นกับกำหนดเปิด-ปิดของหวยแต่ละรอบ (บรรทัด 4, 23)
//
// ⚠️ บรีฟรอบนี้ระบุรายการหวยไว้สามชื่อเท่านั้น (ลาว · ฮานอย · รัฐบาลไทย) ห้ามเติม
// ตลาดอื่น (หวยลาวพัฒนา หวยหุ้น ยี่กี) และห้ามเติมสิ่งที่บรีฟไม่ได้ให้ไว้: เวลา
// ออกรางวัล · เวลาเปิด-ปิดรับของรอบ · ตารางผลย้อนหลัง · สถิติ · ความแม่นยำ ·
// ชื่อธนาคาร · เลขใบอนุญาต · ยอดฝากขั้นต่ำ · จำนวนสมาชิก · ปีก่อตั้ง
// ตัวเลขที่อ้างได้มีแค่ 2 ตัว / 3 ตัว / 100 / 1,000 / 3 ขั้นตอน / 24 ชั่วโมง
//
// CHROME ROTATION (brand-spec §3): รอบนี้หน้านี้ย้ายออกจากตระกูล *Huay ทั้งหมด —
// แบรนด์ก่อน (หวยคิง) ก็เป็นเว็บหวยและใช้ *Huay ทุกจุด ถ้าใช้ซ้ำสองไคลเอนต์ที่ไม่
// เกี่ยวกันจะออกมาหน้าตาเดียวกัน จึงใช้ Announcement3 (เรียกแบบ bare ให้ตกไปใช้
// default message ของแบรนด์ปัจจุบัน) · Faq3 · LatestWinnersPremium · ContentBox +
// ContentBoxNeumorphism + ContentBox3ThreeNeumorphism และธีมเป็นพาเลตต์หลักของ
// หวย24 ไม่ใช่ธีมแดง-ทอง "Huay" แยกหมวด ไฟล์ *Huay ยังอยู่บนดิสก์ครบ ไม่แตะ
//
// ค่าสีทุกจุดเป็นเลขจริงของ brand-spec §2 รอบนี้: แดงแบรนด์ #d20a0a · แดงสว่าง
// #ff5c5c · แดงลึก #7a0505 · ทองแบรนด์ #f5c33b · ทองสว่าง #ffd45e · ทองลึก
// #a9761a · พื้นลึกสุด #0a0303 · ผิวการ์ดอุ่น #230d0d · แดงเข้มสุด #2a0606 เป็น
// หมึกบนปุ่มทอง · glow rgba(210,10,10,α) / rgba(245,195,59,α)
// ชุดทองโลหะ + ครีมอมพีชของแบรนด์ก่อน (#cd9a2c #fdeb7c #ab7314 #fcd4c3 #f5e7c8
// #1c140b #0c0b0a #120a02 #5c3f12 rgba(205,154,44,*)) ออกครบแล้ว
//
// ย่อหน้าในกล่องไม่ถือคลาสสีของตัวเอง — ContentBox / ContentBoxNeumorphism ตั้ง
// `text-left text-base leading-relaxed text-[#f7e2d6]` ไว้บนการ์ดแล้ว ทุกอย่าง
// ข้างในสืบทอดลงมา สีที่เขียนเองมีแค่ accent บน <strong> เท่านั้น
//
// การ์ดขั้นตอนเป็น chrome ไม่ใช่หัวข้อบทความ ป้ายจึงเป็น <span> และชื่อของชุดการ์ด
// ไปอยู่บน aria-label ของ <ul> (บทบาท list รับชื่อได้จริง ต่างจาก <div> เปล่า)
// ป้ายสามคอลัมน์ของ ContentBox3ThreeNeumorphism ก็เป็นคำบรรยายที่หน้านี้ตั้งเอง
// ไม่ใช่หัวข้อย่อยของบรีฟ จึงส่ง heading={false} ให้ render เป็น <p>
const steps = [
  {
    icon: "🔐",
    label: "Login เข้าบัญชีสมาชิก",
    detail: "เข้าสู่ระบบด้วยบัญชีเดียวกับที่ใช้ส่งโพย ผ่านเบราว์เซอร์บนมือถือหรือคอมพิวเตอร์ บัญชีเดียวติดตามได้ทั้งหวยลาว หวยฮานอย รัฐบาลไทย แนวทางหวย ผลรางวัล และประวัติโพย",
  },
  {
    icon: "🎯",
    label: "เลือกรายการหวยและรอบให้ตรงกับโพย",
    detail: "ประวัติโพยแสดงรายการหวยและรอบที่ส่งไว้คู่กันเสมอ ให้เลือกบรรทัดที่ตรงกับโพยที่ต้องการตรวจก่อน เพราะเลขชุดเดียวกันอาจถูกส่งไว้มากกว่าหนึ่งรอบและมากกว่าหนึ่งรายการ",
  },
  {
    icon: "🧾",
    label: "เทียบเลขกับผลรางวัลของรอบนั้น",
    detail: "ระบบบันทึกเลขที่เลือก ยอดเดิมพัน และอัตราจ่ายไว้ตั้งแต่ตอนกดยืนยัน จึงนำเลขในโพยไปเทียบกับผลรางวัลของรายการและรอบเดียวกันได้ครบจากหน้าเดียวโดยไม่ต้องจดไว้เอง",
  },
];

const faqs = [
  {
    q: `ตรวจผลรางวัลและประวัติโพยกับ ${BRAND_NAME} ได้จากที่ไหน?`,
    a: "Login เข้าบัญชีสมาชิกแล้วเปิดประวัติโพย ระบบจะแสดงรายการหวยและรอบที่ส่ง เลขที่เลือก ยอดเดิมพัน อัตราจ่าย และสถานะไว้ในที่เดียว บัญชีเดียวจึงใช้ติดตามทั้งผลรางวัลและประวัติโพยของหวยลาว หวยฮานอย และรัฐบาลไทยได้เอง",
  },
  {
    q: `${BRAND_NAME} เป็นผู้ประกาศผลรางวัลเองหรือไม่?`,
    a: "ไม่ใช่ เว็บไซต์รวบรวมรายการที่เปิดรับ อัตราจ่าย และผลรางวัลไว้ให้ติดตาม พร้อมบันทึกรายละเอียดของโพยที่สมาชิกส่งเข้ามา การอ่านผลให้ยึดการประกาศผลอย่างเป็นทางการของหวยรายการนั้นเป็นหลัก แล้วจึงนำมาเทียบกับเลขและรอบในโพย",
  },
  {
    q: "อัตราจ่ายในโพยไม่ตรงกับข้อความประชาสัมพันธ์ ต้องยึดอันไหน?",
    a: "ให้ยึดอัตราที่ระบบแสดงบนหน้าส่งโพยตอนกดยืนยัน เพราะเป็นอัตราที่ถูกบันทึกลงในโพยรายการนั้นจริง อัตรา 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท ใช้กับรายการที่เข้าเงื่อนไขเท่านั้น และอาจต่างกันตามประเภทหวย รูปแบบการแทง และรอบที่เลือก",
  },
  {
    q: "ทำไมเลขที่เลือกไว้ถึงส่งได้ไม่เท่ากับที่ตั้งใจ?",
    a: "เลขที่มียอดเดิมพันสูงอาจมีวงเงินรับแทงต่างจากเลขทั่วไป ยอดที่ส่งได้จึงเป็นยอดสูงสุดที่ระบบเปิดรับของเลขนั้นในรอบนั้น ควรกรอกเลขแล้วดูวงเงินที่ระบบแสดงก่อนกดยืนยันทุกครั้ง",
  },
  {
    q: `ตรวจผลหรือเปิดประวัติโพยไม่ได้ ติดต่อ ${BRAND_NAME} อย่างไร?`,
    a: `เปิดประวัติโพยในบัญชีดูก่อนเป็นอันดับแรก หากยังพบความผิดปกติ ติดต่อแอดมิน ${BRAND_NAME} ผ่านช่องทางบริการที่เว็บไซต์กำหนดได้ตลอด 24 ชั่วโมง พร้อมแจ้งชื่อหวย รอบเวลา เลขที่เลือก และข้อมูลรายการ โดยไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น`,
  },
];

// 150–160 CHARACTERS (นับตัวอักษร ไม่ใช่ไบต์ — ห้ามใช้ wc -c) ปัจจุบัน 156 ตัวอักษร
const pageDescription = `ตรวจหวย ${BRAND_NAME} รวมวิธีตรวจผลรางวัลหวยลาว หวยฮานอย และรัฐบาลไทย พร้อมเปิดประวัติโพยในบัญชีสมาชิกเพื่อเทียบเลข ยอดเดิมพัน และอัตราจ่ายที่ระบบบันทึกไว้ตอนส่งโพย`;

const pageHeading = `ตรวจหวย ${BRAND_NAME} ตรวจผลรางวัลและเปิดประวัติโพย ลาว ฮานอย รัฐบาลไทย`;

const graph = pageGraph(Astro, {
  name: pageHeading,
  description: pageDescription,
  faqs,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ตรวจหวย", path: "/ตรวจหวย" },
  ],
});
---

<MainLayout title={`ตรวจหวย ${BRAND_NAME} ตรวจผลรางวัลและประวัติโพย ลาว ฮานอย รัฐบาลไทย`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#ffd45e]">{BRAND_NAME}</strong> รวบรวมรายการหวยและแนวทางหวยไว้ให้ติดตามผ่านมือถือ ทั้งหวยลาวตามรอบที่เปิดรับ หวยฮานอยหลายช่วงเวลา และรัฐบาลไทยตามกำหนดออกรางวัล พร้อมข้อมูลรอบเปิดรับ
        อัตราจ่าย และผลรางวัล หน้านี้รวมวิธีใช้ข้อมูลเหล่านั้นตรวจรายการของตัวเอง ตั้งแต่ Login เข้าบัญชี เปิดประวัติโพย เลือกรายการหวยและรอบให้ตรงกับโพยที่ส่งไว้ ไปจนถึงการเทียบเลขกับผลรางวัลของรอบนั้น
      </p>

      <p>
        <strong class="text-[#ffd45e]">หน้านี้ไม่มีตัวเลขของรอบใด ไม่ประกาศผลรางวัลเอง และไม่ทำนายเลข</strong> สิ่งที่ระบบบันทึกไว้คือรายละเอียดของโพยที่สมาชิกส่งเข้ามา ได้แก่ รายการหวย รอบ เลขที่เลือก
        ยอดเดิมพัน และอัตราจ่ายที่แสดงตอนกดยืนยัน ส่วนการอ่านผลให้ยึดการประกาศผลอย่างเป็นทางการของหวยรายการนั้นเป็นหลัก แล้วจึงนำมาเทียบกับเลขและรอบที่อยู่ในโพยของตัวเอง
      </p>

      <p>
        บัญชีเดียวใช้ติดตามหวยลาว หวยฮานอย รัฐบาลไทย แนวทางหวย ผลรางวัล และประวัติโพยได้ทั้งหมด แม้ระบบเว็บไซต์จะเข้าใช้งานได้ 24 ชั่วโมง แต่
        <strong class="text-[#ffd45e]">เวลารับแทงจริงยังขึ้นอยู่กับกำหนดเปิดและปิดของหวยแต่ละรอบ</strong> จึงควรตรวจสอบเวลาที่ระบบแสดงก่อนส่งโพยทุกครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBoxNeumorphism as="h2" title="ขั้นตอนตรวจผลรางวัลและเทียบเลขในโพยของตัวเอง">
    <div class="flex flex-col gap-6">
      <p>ลำดับด้านล่างเป็นลำดับเดียวกับที่ระบบเก็บข้อมูลไว้ คือเข้าบัญชี เลือกรายการและรอบ แล้วจึงอ่านรายละเอียดของโพย ทำตามลำดับนี้จะตัดปัญหาการอ่านข้ามรายการหรือข้ามรอบออกไปได้เกือบทั้งหมด</p>

      <ul class="grid grid-cols-1 gap-4 md:grid-cols-3" aria-label="ขั้นตอนตรวจผลรางวัลและเปิดประวัติโพยด้วยตัวเอง">
        {
          steps.map((step, i) => (
            <li class="flex flex-col gap-2 rounded-2xl border border-[#d20a0a]/45 bg-[#0a0303]/70 p-5 transition-colors hover:border-[#f5c33b]/60">
              <div class="flex items-center gap-3">
                <span aria-hidden="true" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gradient-to-b from-[#ffd45e] to-[#a9761a] text-sm font-black text-[#2a0606]">
                  {i + 1}
                </span>
                <span aria-hidden="true" class="text-xl">
                  {step.icon}
                </span>
                <span class="text-base font-black tracking-wide text-[#ffd45e]">{step.label}</span>
              </div>
              <p>{step.detail}</p>
            </li>
          ))
        }
      </ul>

      <div class="flex flex-col gap-4 sm:flex-row sm:justify-center">
        <a
          href="/login"
          class="flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#a9761a] via-[#ffd45e] to-[#a9761a] px-8 py-4 font-black text-[#2a0606] shadow-[0_5px_15px_rgba(245,195,59,0.4)] transition-transform hover:scale-105">
          <span aria-hidden="true">🔒</span> เข้าสู่ระบบเพื่อตรวจโพย
        </a>
        <a
          href="/register"
          class="flex items-center justify-center gap-2 rounded-xl border border-[#d20a0a]/60 bg-[#0a0303] px-8 py-4 font-bold text-[#ffd45e] shadow-[0_5px_15px_rgba(0,0,0,0.6)] transition-colors hover:bg-[#230d0d]">
          <span aria-hidden="true">⚡</span> สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBoxNeumorphism>

  <ContentBox3ThreeNeumorphism as="h2" title="รายการหวยที่ติดตามผลได้ หวยลาว หวยฮานอย และรัฐบาลไทย" heading={false} titleleft="หวยลาว" titlecenter="หวยฮานอย" titleright="หวยรัฐบาลไทย">
    <p slot="left">
      หวยลาวเปิดรับตามรอบที่ระบบกำหนด ก่อนส่งโพยให้เลือกรอบให้ตรงกับที่ตั้งใจ แล้วเทียบเลขในโพยกับผลรางวัลของรอบเดียวกันเมื่อมีการประกาศผล เพราะเลขชุดเดียวกันอาจถูกส่งไว้มากกว่าหนึ่งรอบ
    </p>
    <p slot="center">
