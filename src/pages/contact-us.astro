---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement4.astro";

import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS } from "../lib/brandProfile";

// One string, used three times: MainLayout's <meta name="description">, the
// WebPage node's description, and nothing else. Keeping it in a const is what
// stops the meta tag and the structured data from drifting apart — they used to
// be two hand-typed variants of the same sentence, and the JSON-LD copy was the
// one nobody reread. 150–160 CHARACTERS (Thai is 3 bytes/char, so a byte count
// reads ~3x too long and will send you rewriting a description that was fine).
const pageDescription =
  "ช่องทางติดต่อทีมงาน FIN8888 ผ่าน LINE Official สำหรับปัญหาสมัครสมาชิก เข้าสู่ระบบ โปรโมชั่น และสถานะฝากถอนออโต้ พร้อมที่อยู่สำหรับติดต่อเป็นลายลักษณ์อักษร";

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: "ติดต่อทีมงาน FIN8888 ผ่าน LINE Official",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    alternateName: "FIN8888 แบรนด์เกมสล็อตออนไลน์ ธีมเทศกาล รองรับทุกเครือข่าย",
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: "ติดต่อแอดมินผ่าน LINE Official",
      },
    ],
  },
});
---

<MainLayout
  title="ติดต่อเรา FIN8888 แจ้งปัญหาสมัครสมาชิก โปรโมชั่น และฝากถอนออโต้ ผ่าน LINE Official"
  description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน FIN8888" as="h1">
    <a
      href="/line"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="ติดต่อทีมงานผ่าน Line Official"
      class="mx-auto flex w-full max-w-[400px] items-center justify-center gap-2 rounded-xl border border-green-300 bg-gradient-to-r from-[#00B900] to-[#009900] py-4 text-lg font-bold text-white shadow-[0_10px_30px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
      <span aria-hidden="true" class="text-2xl">💬</span> ติดต่อผ่าน Line Official
    </a>
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address
          aria-label={BRAND_ADDRESS.label}
          class="mt-8 mb-8 border-l-4 border-[#0891b2] pl-6 text-left text-base leading-relaxed text-[#dbeafe] not-italic">
          <p class="mb-1 font-bold text-[#dbeafe]">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">✉️</span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold text-[#dbeafe] underline decoration-current/40 underline-offset-4">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก"
        class="flex items-center justify-center rounded-lg border border-[#0891b2]/60 bg-gradient-to-b from-[#22d3ee] to-[#0891b2] px-8 py-3 font-bold text-white shadow-[0_10px_30px_rgba(8,145,178,0.18)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(21,94,117,0.30)]">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ"
        class="flex items-center justify-center rounded-lg border border-[#0891b2]/60 bg-[#050b16] px-8 py-3 font-extrabold text-[#dbeafe] shadow-[0_4px_14px_rgba(8,145,178,0.18)] transition-transform hover:scale-105 hover:bg-[#0a1628]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
