---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
import lineImage from "../assets/contact-line.webp";

// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, the LINE image, the address block, the buttons.
// ห้ามเติมหัวข้อย่อยหรือย่อหน้าอธิบายกลับมา — ไม่มีรายการ "ควรเตรียมข้อมูลอะไร
// ก่อนแจ้ง" ไม่มีประโยคเตือนเรื่องรหัสผ่าน/OTP ไม่ว่าคอปปี้นั้นจะเขียนดีแค่ไหน
// ทุกย่อหน้าที่เคยอยู่บนหน้านี้คือของที่รีแบรนด์รอบก่อนๆ คิดขึ้นเอง ไม่ใช่ของบรีฟ
// (รอบนี้ src/assets/content.txt ไม่มีส่วน SUB-PAGES เลย — จบที่บรรทัด 23)
//
// The h1 names what the page IS ("ติดต่อทีมงาน <brand>"), not what an article
// on it would have argued. A title that previews a body is the line that tempts
// the next rebrand into writing the body back.
//
// BRAND_ADDRESS สร้างตัวเองจาก BRAND_NAME (ตารางจังหวัดใน src/lib/thaiProvinces.ts)
// และอีเมลมาจาก site: — ห้ามพิมพ์บรรทัดที่อยู่หรืออีเมลเอง ห้ามเพิ่มบรรทัดถนนหรือ
// ลิงก์แผนที่ และห้ามส่งที่อยู่/อีเมลเข้า structured data (address/PostalAddress/
// email ใน JSON-LD ทำให้เกทของ verify-build แดง)
// ⚠️ โดเมนรอบนี้เป็น **ASCII ล้วน ไม่ต้องแปลง punycode** (กลับทิศจากรอบก่อนที่เป็น
// IDN ภาษาไทย) อีเมลที่ render ออกมาจึงเป็น <mailbox>@<host ของ site:> ตรงๆ
// verify-build เทียบโฮสต์ของอีเมลกับ site: — **ห้ามแก้สตริงนี้ด้วยมือ และห้าม
// พิมพ์โดเมนลงในไฟล์นี้**
// · กล่องจดหมายนี้ตั้งใจไม่ route ไปไหน เป็นการตัดสินใจของเจ้าของ
// ห้ามยกขึ้นมาถามทุกรอบ ห้ามตั้ง mail routing และห้ามลบบรรทัดนี้ออก
//
// Announcement หมุนมาเป็น AnnouncementPremium ทั้งเว็บรอบนี้ (brand-spec §3 —
// รอบก่อนใช้ AnnouncementCyber จึงหมุนออก) orchestrator ตั้ง default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์ปัจจุบันไว้แล้ว ทุกหน้าเรียกแบบ bare จึงห้ามส่ง prop
// message จากหน้านี้ ไม่งั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตต์รอบนี้อยู่ใน brand-spec §2
// 🚨🚨 **รอบนี้ยังเป็นธีมมืด แต่คนละฮิวกับรอบก่อนสิ้นเชิง — การ์ดผิวเข้ม หมึกสว่าง**
// bg.json = {"mode":"color","color":"#00091f"} = **น้ำเงินเที่ยงคืนเกือบดำ**
// การ์ด ContentBox จึงเป็นผิว #0b1733 บนหมึก #f4eef1 (= BRAND_TEXT)
// **ห้าม "แก้" การ์ดกลับไปเป็นผิวสว่างเพราะรอบก่อนเป็นแบบนั้น**
//
// บทบาทสีในไฟล์นี้:
//   แดงคริมสัน #ff2e52 → #e01238 → #c9102f = **พื้นไล่เฉดของปุ่ม PRIMARY**
//     บนหมึก **ขาว #ffffff** (ขาวบน #e01238 = 4.9:1 · บน #c9102f = 6.6:1)
//     ⚠️⚠️ **ห้ามถมพื้น #ff2e52 ล้วนแล้ววางหมึกขาว** (3.6:1) ต้องเป็นไล่เฉดชุดนี้
//     #ff2e52 ถือตัวอักษรได้เฉพาะเมื่ออยู่ "บนผิวมืด" (4.9:1 บนการ์ด) เช่นเส้นขอบ
//     ของบล็อกที่อยู่ ไม่ใช่เมื่อเป็นพื้นถม
//   ปุ่ม SECONDARY = ไล่เฉดอะซัวร์ #0e68cc → #0a4ea8 บนหมึกขาว (5.5 / 7.8:1)
//     ⚠️⚠️ **อะซัวร์ทุกค่าห้ามถือตัวอักษรเด็ดขาด** (#1177e8 ได้แค่ 4.5:1 บนพื้นเพจ
//     และต่ำกว่านั้นบนการ์ด) เป็นพื้นถม/ขอบ/ออราเท่านั้น
//   หมึกเนื้อความ #f4eef1 มาจากการ์ด — ป้ายที่อยู่จึงไม่ประกาศสีตัวอักษรเอง
//     ⚠️ บล็อก <address> **ห้ามมีสีแบรนด์เลยสักค่า** (brand-spec §6) เส้นขอบซ้าย
//     จึงเป็น border-white/20 ซึ่งลงตัวบนการ์ดผิวมืดของทุกแบรนด์ในไลบรารี —
//     รอบก่อนใส่เฮกซ์ของแบรนด์ไว้ตรงนี้ ซึ่งเป็นช่องรั่วที่ทำให้สีเก่าค้างข้ามรอบ
// ขั้วของปุ่มตรงกับ /ทางเข้า /login /register /promotion ซึ่งวางปุ่มคู่นี้บนการ์ด
// ผิวมืดเหมือนกัน: สมัครสมาชิก = PRIMARY ไล่เฉดแดงคริมสัน · เข้าสู่ระบบ = SECONDARY
// ไล่เฉดอะซัวร์
// ⚠️ **เส้น #2a3c70 ห้ามถือตัวอักษร** · ผิวจม #050e26 · ผิวยก #16234a
// ออราในไฟล์นี้ใช้ rgba(255,46,82,α) · rgba(224,18,56,α) · rgba(201,16,47,α) ·
// rgba(17,119,232,α) · rgba(14,104,204,α) · rgba(10,78,168,α) ·
// rgba(217,223,233,α) · rgba(0,9,31,α) · rgba(0,0,0,α) เท่านั้น
// นอกจากสีเขียวของ LINE — #00B900 เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ คงไว้เดิม
// **ห้ามเปลี่ยนเป็นสีของแบรนด์**
//
// ⚠️ กับดักรอบนี้คือ **ฟ้า/น้ำเงินเคยนำมาแล้วเจ็ดแบรนด์ในรีโปนี้ และรอบก่อนทันที
// ก็ฟ้านำ** การเจอฟ้าในไฟล์จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้ ต้องเทียบเป็น "ค่า"
// ทีละหลักกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของ
// แบรนด์เก่าเจอ false positive
// รอบนี้ **ไม่มีทอง/เหลือง ไม่มีน้ำตาล ไม่มีครีม ไม่มีเขียว (ยกเว้น LINE green)
// ไม่มีชมพู/บานเย็น ไม่มีม่วง ไม่มีส้ม ไม่มีโรสโกลด์ และไม่มีแรมป์เทาเงิน**
// ⚠️⚠️ **ฮิวนำรอบนี้คือแดงคริมสัน ส่วนอะซัวร์เป็นวัสดุที่สองซึ่งเป็นพื้น/ขอบ/ออรา
// เท่านั้น** ผมขาวเงิน สูทขาวครีม และสีผิวนักแสดงในอาร์ตเวิร์กเป็นวัตถุในภาพ
// ไม่ใช่สี UI — **ห้ามดึงเข้ามาเป็นสีแบรนด์**
//
// contact-line.webp (mtime 2026-08-04) เป็นอาร์ตสต็อกกลางของเทมเพลต ไม่ใช่
// อาร์ตเวิร์กของแบรนด์นี้ และไม่มีชื่อแบรนด์ใดพิมพ์อยู่บนรูป — alt จึงบรรยายรูปจริง
// ตามที่เห็น ห้ามเอ่ยชื่อแบรนด์ในคำบรรยายรูปใบนี้ และห้าม "แก้" คำบรรยายให้เข้ากับ
// ธีม นั่นคือ alt ที่โกหกรูป (ชุดเลื่อมในภาพเป็นสีชมพู ซึ่งไม่เกี่ยวกับพาเลตรอบนี้เลย
// แต่มันเป็นเนื้อหาของรูป จึงต้องเขียนตามนั้น)
//
// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. Keeping it in a const is what stops the meta tag
// and the structured data from drifting apart. 150–160 CODE POINTS, counted
// with [...s].length exactly like verify-build.mjs — do NOT use `wc -m` on this
// box: git-bash has no UTF-8 locale here, so it counts BYTES and reads ~3x too
// long. This one is 151 with this round's 8-character brand name.
//
// คอปปี้ของหน้านี้อนุมานจากบรีฟบรรทัด 15-16 ซึ่งระบุเรื่องที่ติดต่อได้ไว้แค่:
// การสมัครสมาชิก การเข้าสู่ระบบ รายการฝากถอน และรายละเอียดโปรโมชั่น กับเจ้าหน้าที่
// ตลอด 24ชม. ผ่านเว็บไซต์ทางการ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง —
// ห้ามเขียนเกินนี้ และคำศัพท์ต้องอยู่ใน brand-spec §5 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้
// grep หาคำของแบรนด์เก่าเจอ false positive
// ⚠️ แกนของบรีฟรอบนี้คือ **เว็บเกมสล็อตออนไลน์ โปรโมชั่นรายวัน และฝากถอนทุกธนาคาร/
// ทรูมันนี่** ไม่ใช่แกนของรอบก่อน และไม่ใช่เว็บลอตเตอรี ศัพท์ของหมวดอื่นที่บรีฟ
// ไม่มีทุกคำจึงเป็นของค้างที่ต้องไม่เหลือ — รายการเต็มอยู่ใน brand-spec §5
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกม ชื่อธนาคาร ชื่อวอลเล็ต หรือใบอนุญาต
// แม้แต่รายเดียว** (พูดถึง "ธนาคารและทรูมันนี่" แบบรวมๆ เท่านั้น)
// ⚠️ ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 0.3% · 0.8% · 24ชม.
// **ไม่มีวลีจำนวนขั้นตอนรอบนี้** ห้ามแต่งเลขใบอนุญาต หน่วยงานกำกับ ตัวเลขอัตราคืน
// ตัวเลขการเงิน หรือจำนวนสมาชิก หน้านี้มีโควตาเป็นรูป ที่อยู่ และปุ่ม
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ติดต่อแอดมิน ${BRAND_NAME} ผ่าน LINE Official ได้ตลอด 24ชม. สอบถามการเข้าสู่ระบบ รายการฝากถอน และรายละเอียดโปรโมชั่น จากช่องทางทางการเพื่อเลี่ยงบัญชีแอบอ้าง`;

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: `ติดต่อทีมงาน ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    // `alternateName` is only for a genuine alternate NAME — an earlier brand
    // filled it with its own Thai spelling. The brief gives this brand no second
    // registered name, so the field stays out rather than being invented here:
    // this page's Organization node must not disagree with the one every other
    // page emits, and it is not a slot for marketing copy.
    //
    // BRAND_ADDRESS is rendered in the body but never enters the graph —
    // address/PostalAddress/email in JSON-LD fails the build gate.
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: `ติดต่อแอดมิน ${BRAND_NAME} ผ่าน LINE Official ได้ตลอด 24ชม.`,
      },
    ],
  },
});
---

<MainLayout title={`ติดต่อทีมงาน ${BRAND_NAME} แอดมินเปิดบริการตลอด 24ชม.`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ติดต่อทีมงาน ${BRAND_NAME}`} as="h1">
    <Picture
      src={lineImage}
      alt="พริตตี้ผมยาวสีน้ำตาลในชุดเลื่อมสีชมพูยืนกอดอกและยิ้ม ฉากหลังเป็นวงกลมสีชมพูเรืองแสง ด้านล่างเป็นป้ายไอคอน LINE สีเขียวพร้อมข้อความว่า LINE Support"
      loading="lazy"
      fetchpriority="low"
      widths={[300, 400, 700]}
      sizes="(max-width: 420px) 100vw, 400px"
      class="mx-auto block h-auto w-full max-w-[400px]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 border-l-4 border-white/20 pl-6 text-left text-base leading-relaxed not-italic">
          <p class="mb-1 font-bold opacity-90">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="/register"
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="relative isolate flex items-center justify-center overflow-hidden rounded-lg border border-[#c9102f] bg-gradient-to-b from-[#ff2e52] via-[#e01238] to-[#c9102f] px-8 py-3 font-black text-[#ffffff] shadow-[0_8px_22px_rgba(255,46,82,0.4)] transition-transform hover:scale-105">
        <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#d9dfe9]/20 to-transparent"></span>
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="flex items-center justify-center rounded-lg border border-[#0a4ea8] bg-gradient-to-b from-[#0e68cc] to-[#0a4ea8] px-8 py-3 font-bold text-[#ffffff] shadow-[0_4px_14px_rgba(0,9,31,0.6)] transition-all hover:scale-105 hover:shadow-[0_8px_22px_rgba(17,119,232,0.35)]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`ติดต่อทีมงาน ${BRAND_NAME} ผ่าน Line Official`}
        class="flex items-center justify-center gap-2 rounded-lg border border-[#00B900] bg-[#00B900] px-8 py-3 font-bold text-white shadow-[0_10px_30px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
        <span aria-hidden="true" class="text-2xl">💬</span>
        <span>ติดต่อผ่าน Line Official</span>
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
