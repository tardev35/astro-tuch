---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS } from "../lib/brandProfile";
import lineImage from "../assets/contact-line.webp";

// One string, used three times: MainLayout's <meta name="description">, the
// WebPage node's description, and nothing else. Keeping it in a const is what
// stops the meta tag and the structured data from drifting apart — they used to
// be two hand-typed variants of the same sentence, and the JSON-LD copy was the
// one nobody reread. 150–160 CHARACTERS (Thai is 3 bytes/char, so a byte count
// reads ~3x too long and will send you rewriting a description that was fine).
const pageDescription =
  "ช่องทางติดต่อทีมงาน HSOD ผ่าน LINE Official แจ้งปัญหาสมัครสมาชิก เข้าสู่ระบบ ฝากถอนอัตโนมัติ และการปล่อยยอดหวยที่แทงถูก พร้อมที่อยู่ติดต่อ ดูแลตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: "ติดต่อทีมงาน HSOD ผ่าน LINE Official",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    alternateName: "HSOD เว็บแทงหวยออนไลน์ รับหวยเลขอั้น 2 ตัว 3 ตัว เรทจ่ายสูงสุด 1,000",
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: "ติดต่อแอดมินผ่าน LINE Official",
      },
    ],
  },
});
---

<MainLayout title="ติดต่อทีมงาน HSOD แจ้งปัญหาสมัครสมาชิก ฝากถอน และการปล่อยยอด ผ่าน LINE Official" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน HSOD" as="h1">
    <Picture
      src={lineImage}
      alt="พริตตี้ผมยาวในชุดเลื่อมสีชมพูยืนกอดอก ด้านล่างเป็นป้ายไอคอน LINE สีเขียวพร้อมคำว่า LINE Support"
      loading="lazy"
      fetchpriority="low"
      widths={[300, 400, 700]}
      sizes="(max-width: 420px) 100vw, 400px"
      class="mx-auto block h-auto w-full max-w-[400px]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address
          aria-label={BRAND_ADDRESS.label}
          class="mt-8 mb-8 border-l-4 border-[#e8121d] pl-6 text-left text-base leading-relaxed text-[#dfe3ea] not-italic">
          <p class="mb-1 font-bold text-[#ff4d55]">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">✉️</span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold text-[#e8121d] underline decoration-current/40 underline-offset-4">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก HSOD"
        class="flex items-center justify-center rounded-lg bg-gradient-to-r from-[#ff4d55] via-[#e8121d] to-[#7c0207] px-8 py-3 font-black text-white shadow-[0_0_15px_rgba(232,18,29,0.45)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ HSOD"
        class="flex items-center justify-center rounded-lg border border-[#c2c9d4]/70 bg-transparent px-8 py-3 font-bold text-[#dfe3ea] transition-all hover:scale-105 hover:border-[#e8121d] hover:bg-[#2a0508]/70">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อทีมงาน HSOD ผ่าน Line Official"
        class="flex items-center justify-center gap-2 rounded-lg border border-[#00B900]/70 bg-gradient-to-r from-[#00B900] to-[#009900] px-8 py-3 font-bold text-white shadow-[0_10px_30px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
        <span aria-hidden="true" class="text-2xl">💬</span>
        ติดต่อผ่าน Line Official
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
