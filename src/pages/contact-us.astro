---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS } from "../lib/brandProfile";
import lineImage from "../assets/contact-line.webp";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, the LINE image, the address block, the buttons.
// Do not re-add section headings or explanatory prose here — no "เตรียมข้อมูล
// อะไรก่อนแจ้ง" list, no PIN/OTP notice, however well it reads. Every one of
// those was invented by an earlier rebrand, not by the brief. h1×1, h2×0, h3×0
//
// BRAND_ADDRESS derives itself from BRAND_NAME — never retype the lines or the
// email, and never pass either into the structured data.
//
// Announcement รอบนี้หมุนจาก AnnouncementHuay มาเป็น Announcement3 ทั้งเว็บ
// (ยกเว้นสองหน้าหวยที่คงธีม Huay ไว้ตามข้อยกเว้น) — default message ของ
// Announcement3 เป็นคอปปี้ของ 888PARUAY แล้ว และ index ก็เรียกแบบ bare จึงห้ามส่ง prop
//
// พาเลตต์ 888PARUAY เป็น "ทอง + เขียวเข้ม + แดง" ตามโลโก้ที่เลข 888 เป็นเขียวสด
// ทับคำว่า PARUAY สีแดง ในวงแหวนทอง: เนื้อความ #e8e4c6 · ทองหลัก #fcdc2b ·
// ทองอ่อน #fff6ae · ทองลึก #a87d0c · เขียวสด #1fae1c · เขียวลึก #0c4402 ·
// แดงสด #cf1111 · ผิวการ์ด #0d2312 · ผิวยก #143a1c · พื้นเพจ #07130a
// ปุ่มหลัก (สมัครสมาชิก) รับไล่สีทองของวงแหวนโลโก้และใช้ตัวอักษรสีพื้น #07130a
// ปุ่มรอง (เข้าสู่ระบบ) เป็นขอบทองบนผิวการ์ดเขียว — ชุดแดง-ทองของ 365LOTTO
// (#fadc64 #ffe9a3 #9c6a12 #e01f26 #f0ddc4 #1a0709 #33100f #120406 #f3f6fa
// #d5dae2) ถูกแทนครบทุกจุดแล้ว
// ส่วน #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ตามเดิม
//
// ข้อความและลิงก์ใน ContentBox ไม่ระบุสีของเนื้อความเอง — การ์ดเป็นตัวกำหนดสี
// ตัวอักษร ป้ายที่อยู่จึงใช้ opacity ไม่ใช่คลาสสี ส่วนสีทองมีเฉพาะบนเส้นขอบและ
// ลิงก์อีเมล ซึ่งเป็น accent ไม่ใช่ body copy
//
// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. Keeping it in a const is what stops the meta tag
// and the structured data from drifting apart — they used to be two hand-typed
// variants of the same sentence, and the JSON-LD copy was the one nobody
// reread. 150–160 CHARACTERS (Thai is 3 bytes/char, so a byte count reads ~3x
// too long and will send you rewriting a description that was fine).
// This one is 158.
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "ช่องทางติดต่อแอดมิน 888PARUAY ผ่าน Line Official ตลอด 24 ชั่วโมง สอบถามเรื่องการสมัครสมาชิก รอบหวยที่เปิดรับ อัตราจ่าย หรือแจ้งปัญหาการใช้งานบัญชีสมาชิกทุกวัน";

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: "ติดต่อทีมงาน 888PARUAY",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    // `alternateName` is only for a genuine alternate NAME — a previous brand
    // filled it with its own Thai spelling. The brief gives 888PARUAY no second
    // registered name, so the field stays out rather than being invented
    // here: this page's Organization node must not disagree with the one
    // every other page emits, and it is not a slot for marketing copy.
    //
    // BRAND_ADDRESS is rendered in the body but never enters the graph —
    // address/PostalAddress/email in JSON-LD fails the build gate.
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: "ติดต่อเจ้าหน้าที่ผ่าน LINE Official",
      },
    ],
  },
});
---

<MainLayout title="ติดต่อแอดมิน 888PARUAY ผ่าน Line Official พร้อมให้บริการ 24 ชั่วโมง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน 888PARUAY" as="h1">
    <Picture
      src={lineImage}
      alt="พริตตี้ผมยาวสีน้ำตาลในชุดเลื่อมสีชมพูยืนกอดอกและยิ้ม ด้านล่างเป็นป้ายไอคอน LINE สีเขียวพร้อมคำว่า LINE Support ช่องทางติดต่อทีมงาน 888PARUAY"
      loading="lazy"
      fetchpriority="low"
      widths={[300, 400, 700]}
      sizes="(max-width: 420px) 100vw, 400px"
      class="mx-auto block h-auto w-full max-w-[400px]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 border-l-4 border-[#fcdc2b] pl-6 text-left text-base leading-relaxed not-italic">
          <p class="mb-1 font-bold opacity-90">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold text-[#fcdc2b] underline decoration-current/40 underline-offset-4 transition-colors hover:text-[#fff6ae]">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก 888PARUAY"
        class="flex items-center justify-center rounded-lg border border-[#fff6ae] bg-gradient-to-r from-[#fff6ae] via-[#fcdc2b] to-[#a87d0c] px-8 py-3 font-black text-[#07130a] shadow-[0_0_15px_rgba(252,220,43,0.50)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ 888PARUAY"
        class="flex items-center justify-center rounded-lg border border-[#fcdc2b] bg-[#0d2312] px-8 py-3 font-bold text-[#e8e4c6] shadow-[0_0_15px_rgba(7,19,10,0.7)] transition-all hover:scale-105 hover:border-[#fff6ae] hover:bg-[#143a1c] hover:text-[#fffdf0]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อทีมงาน 888PARUAY ผ่าน Line Official"
        class="flex items-center justify-center gap-2 rounded-lg border border-[#00B900]/70 bg-gradient-to-r from-[#00B900] to-[#009900] px-8 py-3 font-bold text-white shadow-[0_10px_30px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
        <span aria-hidden="true" class="text-2xl">💬</span>
        <span>ติดต่อผ่าน Line Official</span>
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
