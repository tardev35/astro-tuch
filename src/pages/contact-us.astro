---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS } from "../lib/brandProfile";
import lineImage from "../assets/contact-line.webp";

// Button page, not an article: the docx gives this route no body. One heading
// from the ContentBox title, the LINE image, the address block, the buttons.
// Do not re-add section headings or explanatory prose here.
//
// BRAND_ADDRESS derives itself from BRAND_NAME — never retype the lines or the
// email, and never pass either into the structured data.
//
// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. Keeping it in a const is what stops the meta tag
// and the structured data from drifting apart — they used to be two hand-typed
// variants of the same sentence, and the JSON-LD copy was the one nobody
// reread. 150–160 CHARACTERS (Thai is 3 bytes/char, so a byte count reads ~3x
// too long and will send you rewriting a description that was fine).
// This one is 156.
const pageDescription =
  "ติดต่อทีมงาน MGM9 ผ่าน LINE Official เพื่อแจ้งปัญหาสมัครสมาชิก เข้าสู่ระบบ ฝากถอน หรือสอบถามโปรโมชั่นและวิธีเข้าเล่นบาคาร่า สล็อต บอล หวย ได้ตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: "ติดต่อทีมงาน MGM9 ผ่าน LINE Official",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    alternateName:
      "MGM9 คาสิโนเกมครบวงจร รวมบาคาร่าออนไลน์ เกมคาสิโนสด สล็อตออนไลน์ เดิมพันฟุตบอล และหวยออนไลน์ไว้ในบัญชีเดียว ไม่อั้นจ่าย ไม่มีขั้นต่ำ ฝากถอนรองรับทั้งวอลเลทและบัญชีธนาคารตามช่องทางที่เปิดให้บริการ พร้อมแอดมินดูแลตลอด 24 ชั่วโมง",
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: "ติดต่อแอดมินผ่าน LINE Official",
      },
    ],
  },
});
---

<MainLayout title="ติดต่อทีมงาน MGM9 แจ้งปัญหาสมัครสมาชิก เข้าเกม และฝากถอนผ่าน LINE Official" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน MGM9" as="h1">
    <Picture
      src={lineImage}
      alt="พริตตี้ผมยาวสีน้ำตาลในชุดเลื่อมสีชมพูยืนกอดอกและยิ้ม ด้านล่างเป็นป้ายไอคอน LINE สีเขียวพร้อมคำว่า LINE Support"
      loading="lazy"
      fetchpriority="low"
      widths={[300, 400, 700]}
      sizes="(max-width: 420px) 100vw, 400px"
      class="mx-auto block h-auto w-full max-w-[400px]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address
          aria-label={BRAND_ADDRESS.label}
          class="mt-8 mb-8 border-l-4 border-[#4aa4f4] pl-6 text-left text-base leading-relaxed text-[#d3e6ff] not-italic">
          <p class="mb-1 font-bold text-[#9ad4ff]">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">✉️</span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold text-[#4aa4f4] underline decoration-current/40 underline-offset-4">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก MGM9"
        class="flex items-center justify-center rounded-lg border border-[#9ad4ff]/50 bg-gradient-to-r from-[#9ad4ff] via-[#4aa4f4] to-[#1f74d6] px-8 py-3 font-black text-[#01102e] shadow-[0_0_15px_rgba(74,164,244,0.45)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ MGM9"
        class="flex items-center justify-center rounded-lg border border-[#0b4ea8] bg-[#062a72]/70 px-8 py-3 font-bold text-[#9ad4ff] transition-all hover:scale-105 hover:border-[#5ee7ff] hover:bg-[#062a72]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อทีมงาน MGM9 ผ่าน Line Official"
        class="flex items-center justify-center gap-2 rounded-lg border border-[#00B900]/70 bg-gradient-to-r from-[#00B900] to-[#009900] px-8 py-3 font-bold text-white shadow-[0_10px_30px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
        <span aria-hidden="true" class="text-2xl">💬</span>
        <span>ติดต่อผ่าน Line Official</span>
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
