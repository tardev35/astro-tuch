---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS } from "../lib/brandProfile";
import lineImage from "../assets/contact-line.webp";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, the LINE image, the address block, the buttons.
// Do not re-add section headings or explanatory prose here.
//
// BRAND_ADDRESS derives itself from BRAND_NAME — never retype the lines or the
// email, and never pass either into the structured data.
//
// Announcement รอบนี้หมุนมาใช้ Announcement5 ทั้งเว็บ — default message ของไฟล์นั้น
// เป็นคอปปี้ของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ไม่ต้องส่ง prop
//
// พาเลตต์ VAK88: พื้นกรมท่าเกือบดำ #060913 / #0b1020 / #121a2e · ทอง #e6b23c
// (อ่อน #ffd873 เข้ม #8a5f14) · แดงหงส์ #cf2027 (สว่าง #ee3a34 เข้ม #6b0d11) ·
// หัวข้อ #fff4dd · เนื้อความ #ded8ca — ส่วน #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE
// ไม่ใช่สีของเว็บ จึงคงไว้ตามเดิม
//
// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. Keeping it in a const is what stops the meta tag
// and the structured data from drifting apart — they used to be two hand-typed
// variants of the same sentence, and the JSON-LD copy was the one nobody
// reread. 150–160 CHARACTERS (Thai is 3 bytes/char, so a byte count reads ~3x
// too long and will send you rewriting a description that was fine).
// This one is 159.
const pageDescription =
  "ติดต่อทีมงาน VAK88 ผ่าน LINE Official ตลอด 24 ชั่วโมง เพื่อแจ้งปัญหาสมัครสมาชิก เข้าสู่ระบบ ฝากถอนเครดิตอัตโนมัติ หรือสอบถามโปรโมชั่นและการเข้าเล่นสล็อตเว็บตรง";

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: "ติดต่อทีมงาน VAK88",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    alternateName:
      "VAK88 เกมสล็อตเว็บตรงเจ้าแรก ให้บริการผ่านช่องทางเข้าเล่นหลักอย่างเป็นทางการ โดยไม่ต้องผ่านตัวแทนหรือเอเย่นต์ ทุกค่ายได้รับการตรวจสอบและอนุญาตจากลิขสิทธิ์แท้ 100% (Certified API) พร้อมอัตราการชนะ (RTP) ตามมาตรฐานสากล ระบบฝาก-ถอนอัตโนมัติประมวลผลภายใน 3-5 วินาที โดยไม่กำหนดขั้นต่ำในการทำรายการ เข้าเล่นได้ทั้งคอมพิวเตอร์ แท็บเล็ต และสมาร์ตโฟนผ่านเว็บเบราว์เซอร์โดยไม่ต้องดาวน์โหลดแอปพลิเคชัน พร้อมโปรโมชั่นแนะนำเพื่อน 0.8% คืนยอดเสีย 0.3% และแอดมินรับเรื่องผ่าน Line Official ตลอด 24 ชั่วโมง",
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: "ติดต่อเจ้าหน้าที่ผ่าน LINE Official",
      },
    ],
  },
});
---

<MainLayout title="ติดต่อทีมงาน VAK88 แจ้งปัญหาสมัครสมาชิก เข้าสู่ระบบ และฝากถอนผ่าน LINE" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน VAK88" as="h1">
    <Picture
      src={lineImage}
      alt="ผู้หญิงผมยาวสีน้ำตาลในชุดเลื่อมสีชมพูยืนกอดอกและยิ้ม ด้านล่างเป็นป้ายไอคอน LINE พร้อมคำว่า LINE Support"
      loading="lazy"
      fetchpriority="low"
      widths={[300, 400, 700]}
      sizes="(max-width: 420px) 100vw, 400px"
      class="mx-auto block h-auto w-full max-w-[400px]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address
          aria-label={BRAND_ADDRESS.label}
          class="mt-8 mb-8 border-l-4 border-[#e6b23c] pl-6 text-left text-base leading-relaxed text-[#ded8ca] not-italic">
          <p class="mb-1 font-bold text-[#ffd873]">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">✉️</span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold text-[#ffd873] underline decoration-current/40 underline-offset-4">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก VAK88"
        class="flex items-center justify-center rounded-lg border border-[#e6b23c]/60 bg-gradient-to-r from-[#ee3a34] via-[#cf2027] to-[#6b0d11] px-8 py-3 font-black text-[#fff4dd] shadow-[0_0_15px_rgba(207,32,39,0.45)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ VAK88"
        class="flex items-center justify-center rounded-lg border border-[#e6b23c]/60 bg-[#121a2e]/70 px-8 py-3 font-bold text-[#e6b23c] shadow-[0_0_15px_rgba(230,178,60,0.28)] transition-all hover:scale-105 hover:border-[#ffd873] hover:bg-[#121a2e]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อทีมงาน VAK88 ผ่าน Line Official"
        class="flex items-center justify-center gap-2 rounded-lg border border-[#00B900]/70 bg-gradient-to-r from-[#00B900] to-[#009900] px-8 py-3 font-bold text-white shadow-[0_10px_30px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
        <span aria-hidden="true" class="text-2xl">💬</span>
        <span>ติดต่อผ่าน Line Official</span>
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
