---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS } from "../lib/brandProfile";
import lineImage from "../assets/contact-line.webp";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, the LINE image, the address block, the buttons.
// Do not re-add section headings or explanatory prose here — no "เตรียมข้อมูล
// อะไรก่อนแจ้ง" list, no PIN/OTP notice, however well it reads. Every one of
// those was invented by an earlier rebrand, not by the brief.
//
// BRAND_ADDRESS derives itself from BRAND_NAME — never retype the lines or the
// email, and never pass either into the structured data.
//
// Announcement รอบนี้หมุนมาใช้ AnnouncementPremium ทั้งเว็บ — default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ไม่ต้องส่ง prop
//
// พาเลตต์ JOKERSLOTZ: แดงเลือดหมูนำ #a51515 (สว่าง #c81e1e เข้ม #6d0d0d) คู่กับ
// ทองหมวกตัวตลก #d9b45e (อ่อน #f2dc9a) บนพื้นดำอมเลือดหมู #1c0202 / #2b0204
// เนื้อความ #ecdfd0 — ส่วน #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE
// ไม่ใช่สีของเว็บ จึงคงไว้ตามเดิม
//
// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. Keeping it in a const is what stops the meta tag
// and the structured data from drifting apart — they used to be two hand-typed
// variants of the same sentence, and the JSON-LD copy was the one nobody
// reread. 150–160 CHARACTERS (Thai is 3 bytes/char, so a byte count reads ~3x
// too long and will send you rewriting a description that was fine).
// This one is 155.
const pageDescription = "ติดต่อแอดมิน JOKERSLOTZ ผ่าน Line Official ตลอด 24 ชั่วโมง แจ้งปัญหาเข้าลิ้งก์ทางเข้าสำรอง สมัครสมาชิก เข้าสู่ระบบ ฝาก-ถอนเครดิต หรือสอบถามวิธีรับโปรโมชั่น";

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: "ติดต่อทีมงาน JOKERSLOTZ",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    // `alternateName` is only for a genuine alternate NAME — a previous brand
    // filled it with its own Thai spelling. The brief gives JOKERSLOTZ no
    // second registered name, so the field stays out rather than being
    // invented here: this page's Organization node must not disagree with the
    // one every other page emits, and it is not a slot for marketing copy.
    //
    // BRAND_ADDRESS is rendered in the body but never enters the graph —
    // address/PostalAddress/email in JSON-LD fails the build gate.
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: "ติดต่อเจ้าหน้าที่ผ่าน LINE Official",
      },
    ],
  },
});
---

<MainLayout title="ติดต่อทีมงาน JOKERSLOTZ แจ้งปัญหาสมัครสมาชิก เข้าสู่ระบบ และฝากถอนผ่าน LINE" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน JOKERSLOTZ" as="h1">
    <Picture
      src={lineImage}
      alt="พริตตี้ผมยาวสีน้ำตาลในชุดเลื่อมสีชมพูยืนกอดอกและยิ้ม ด้านล่างเป็นป้ายไอคอน LINE สีเขียวพร้อมคำว่า LINE Support ช่องทางติดต่อทีมงาน JOKERSLOTZ"
      loading="lazy"
      fetchpriority="low"
      widths={[300, 400, 700]}
      sizes="(max-width: 420px) 100vw, 400px"
      class="mx-auto block h-auto w-full max-w-[400px]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 border-l-4 border-[#a51515] pl-6 text-left text-base leading-relaxed text-[#ecdfd0] not-italic">
          <p class="mb-1 font-bold text-[#f2dc9a]">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold text-[#d9b45e] underline decoration-current/40 underline-offset-4 transition-colors hover:text-[#f2dc9a]">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก JOKERSLOTZ"
        class="flex items-center justify-center rounded-lg border border-[#6d0d0d]/70 bg-gradient-to-r from-[#c81e1e] via-[#a51515] to-[#6d0d0d] px-8 py-3 font-black text-[#f2dc9a] shadow-[0_0_15px_rgba(165,21,21,0.45)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ JOKERSLOTZ"
        class="flex items-center justify-center rounded-lg border border-[#d9b45e]/50 bg-[#2b0204]/75 px-8 py-3 font-bold text-[#d9b45e] shadow-[0_0_15px_rgba(217,180,94,0.24)] transition-all hover:scale-105 hover:border-[#f2dc9a] hover:bg-[#1c0202] hover:text-[#f2dc9a]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อทีมงาน JOKERSLOTZ ผ่าน Line Official"
        class="flex items-center justify-center gap-2 rounded-lg border border-[#00B900]/70 bg-gradient-to-r from-[#00B900] to-[#009900] px-8 py-3 font-bold text-white shadow-[0_10px_30px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
        <span aria-hidden="true" class="text-2xl">💬</span>
        <span>ติดต่อผ่าน Line Official</span>
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
