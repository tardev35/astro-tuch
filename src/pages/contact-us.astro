---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
import lineImage from "../assets/contact-line.webp";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, the LINE image, the address block, the buttons.
// Do not re-add section headings or explanatory prose here — no "เตรียมข้อมูล
// อะไรก่อนแจ้ง" list, no PIN/OTP notice, however well it reads. Every one of
// those was invented by an earlier rebrand, not by the brief. h1×1, h2×0, h3×0
//
// The <h1> names what the page IS ("ติดต่อทีมงาน <brand>"), not what an article
// on it would have argued. A title that previews a body is the line that tempts
// the next rebrand into writing the body back.
//
// BRAND_ADDRESS derives itself from BRAND_NAME — never retype the lines or the
// email, and never pass either into the structured data.
//
// Announcement หมุนมาเป็น AnnouncementCyber ทั้งเว็บรอบนี้ (รอบก่อน หวยเฮง789 ใช้
// Announcement2) ยกเว้น /ตรวจหวย กับ /แนวทาง ที่ใช้ AnnouncementHuay ของตัวเอง —
// orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ หวย365 แล้ว และ index
// ก็เรียกแบบ bare จึงห้ามส่ง prop message จากหน้านี้ ไม่งั้นสองหน้าจะพูดไม่ตรงกัน
//
// พาเลตต์ หวย365 (brand-spec §2 แดงสด-ทอง): เนื้อความ #f6e7e0 (BRAND_TEXT) ·
// ทองอ่อน #ffeab0 · ทอง #ffc93c · ทองลึก #c08a07 (ขอบ/ปลายไล่เฉดเท่านั้น) ·
// แดงแบรนด์ #dc0203 · แดงสว่าง #f5282a · แดงลึก #9c0201 · ผิวการ์ด #240406 ·
// ผิวบาร์ #180303 · หมึกบนพื้นทอง #1a0303 · เงา rgba(8,1,1,α)
// ปุ่มหลัก (สมัครสมาชิก) รับไล่เฉดทองเต็มใบ #ffeab0 → #ffc93c → #c08a07 ตัวอักษร
// เป็นหมึกเข้ม #1a0303 — ปลายไล่เฉดห้ามเข้มกว่า #c08a07 ซึ่งวัดได้ 6.4:1
// ปุ่มรอง (เข้าสู่ระบบ) เป็นแบบ outline — กรอบแดงลึก #9c0201 บนผิวการ์ด #240406
// ตัวอักษรทอง #ffc93c ไม่ใช่ถมทองอีกใบ เพราะสองปุ่มถมทองเหมือนกันจะอ่านเป็นก้อนเดียว
// ลำดับความสำคัญรอบนี้จึงสื่อด้วย "ถมทอง vs กรอบแดง"
// ห้ามตัวอักษรขาวบนพื้นทอง และห้ามหมึกเข้มบนพื้นแดง (brand-spec §2)
// ส่วน #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ตามเดิม
// ชุดของ หวยเฮง789 (#dc2224 #f4bc5d #ffefc2 #fbe3d4 #1c0606 #2b0909 #ab0204
// #e43434 #d99a10 #a8690c #5c0a0a rgba(244,188,93,*) rgba(220,34,36,*)
// rgba(11,2,2,*)) ถูกแทนครบทุกจุดแล้ว
//
// ป้ายที่อยู่ใช้ opacity ไม่ใช่คลาสสี ให้สืบทอดสีตัวอักษรจากการ์ด ส่วนสีแบรนด์มีเฉพาะ
// บนเส้นขอบและลิงก์อีเมล ซึ่งเป็น accent ไม่ใช่ body copy
//
// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. Keeping it in a const is what stops the meta tag
// and the structured data from drifting apart — they used to be two hand-typed
// variants of the same sentence, and the JSON-LD copy was the one nobody
// reread. 150–160 CHARACTERS (Thai is 3 bytes/char, so a byte count reads ~3x
// too long and will send you rewriting a description that was fine).
// This one is 156.
//
// หวย365 เป็นเว็บแทงหวยออนไลน์ ไม่ใช่บอลและไม่ใช่สล็อต บรีฟยกหัวข้อไว้ว่า
// "ติดต่อแอดมินเว็บแทง หวย365 ได้ ตลอด 24 ชั่วโมง" และระบุเรื่องที่ทีมงานช่วยได้ไว้แค่
// สมัคร/Login ไม่ได้ ส่งโพยไม่สำเร็จ รายการไม่แสดง ผลหวยยังไม่อัปเดต และข้อสงสัยเรื่อง
// อัตราจ่าย — ห้ามเขียนเกินนี้ ห้ามเอ่ยชื่อธนาคาร เลขใบอนุญาต ยอดฝากขั้นต่ำ หรือ
// ชื่อผู้ให้บริการจริง และคำศัพท์ของแบรนด์ก่อนหน้า (เลขเด็ด เลขดัง ไม่จำกัด
// แทงได้ไม่อั้น ฮานอยปกติ/พิเศษ/วีไอพี ฝากถอนวอลเลท สล็อต ฟรีสปิน RTP บอล ค่าน้ำ
// อัตราต่อรอง ลีก คาสิโน บาคาร่า) ห้ามหลงเหลือ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ติดต่อทีมงาน ${BRAND_NAME} ได้ตลอด 24 ชั่วโมง สอบถามเรื่องสมัครสมาชิก เข้าสู่ระบบไม่ได้ ส่งโพยไม่สำเร็จ รายการไม่แสดง ผลหวยยังไม่อัปเดต หรือข้อสงสัยเรื่องอัตราจ่าย`;

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: `ติดต่อทีมงาน ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    // `alternateName` is only for a genuine alternate NAME — an earlier brand
    // filled it with its own Thai spelling. The brief gives this brand no second
    // registered name, so the field stays out rather than being invented here:
    // this page's Organization node must not disagree with the one every other
    // page emits, and it is not a slot for marketing copy.
    //
    // BRAND_ADDRESS is rendered in the body but never enters the graph —
    // address/PostalAddress/email in JSON-LD fails the build gate.
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: `ติดต่อแอดมิน ${BRAND_NAME} ผ่านช่องทางไลน์ได้ตลอด 24 ชั่วโมง`,
      },
    ],
  },
});
---

<MainLayout title={`ติดต่อทีมงาน ${BRAND_NAME} แอดมินเว็บแทงหวยดูแลผ่านไลน์ตลอด 24 ชั่วโมง`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ติดต่อทีมงาน ${BRAND_NAME}`} as="h1">
    <Picture
      src={lineImage}
      alt="พริตตี้ผมยาวสีน้ำตาลในชุดเลื่อมสีชมพูยืนกอดอกและยิ้ม ฉากหลังเป็นวงกลมสีชมพูเรืองแสง ด้านล่างเป็นป้ายไอคอน LINE สีเขียวพร้อมข้อความว่า LINE Support"
      loading="lazy"
      fetchpriority="low"
      widths={[300, 400, 700]}
      sizes="(max-width: 420px) 100vw, 400px"
      class="mx-auto block h-auto w-full max-w-[400px]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 border-l-4 border-[#dc0203] pl-6 text-left text-base leading-relaxed not-italic">
          <p class="mb-1 font-bold opacity-90">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold text-[#ffc93c] underline decoration-current/40 underline-offset-4 transition-colors hover:text-[#ffeab0]">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="/register"
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="flex items-center justify-center rounded-lg border border-[#c08a07]/70 bg-gradient-to-r from-[#ffeab0] via-[#ffc93c] to-[#c08a07] px-8 py-3 font-black text-[#1a0303] shadow-[0_0_15px_rgba(255,201,60,0.45)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="flex items-center justify-center rounded-lg border border-[#9c0201] bg-[#240406] px-8 py-3 font-bold text-[#ffc93c] shadow-[0_0_15px_rgba(8,1,1,0.85)] transition-all hover:scale-105 hover:border-[#f5282a] hover:bg-[#9c0201] hover:text-[#ffeab0] hover:shadow-[0_0_18px_rgba(220,2,3,0.35)]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`ติดต่อทีมงาน ${BRAND_NAME} ผ่าน Line Official`}
        class="flex items-center justify-center gap-2 rounded-lg border border-[#00B900]/70 bg-gradient-to-r from-[#00B900] to-[#009900] px-8 py-3 font-bold text-white shadow-[0_10px_30px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
        <span aria-hidden="true" class="text-2xl">💬</span>
        <span>ติดต่อผ่าน Line Official</span>
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
