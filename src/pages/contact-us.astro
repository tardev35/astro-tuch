---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS } from "../lib/brandProfile";
import lineImage from "../assets/contact-line.webp";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, the LINE image, the address block, the buttons.
// Do not re-add section headings or explanatory prose here — no "เตรียมข้อมูล
// อะไรก่อนแจ้ง" list, no PIN/OTP notice, however well it reads. Every one of
// those was invented by an earlier rebrand, not by the brief. h1×1, h2×0, h3×0
//
// BRAND_ADDRESS derives itself from BRAND_NAME — never retype the lines or the
// email, and never pass either into the structured data.
//
// Announcement หมุนจาก AnnouncementHuay มาเป็น AnnouncementPremium ทั้งเว็บรอบนี้ —
// orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ WIN999 แล้ว และ index
// ก็เรียกแบบ bare จึงห้ามส่ง prop message จากหน้านี้ ไม่งั้นสองหน้าจะพูดไม่ตรงกัน
//
// พาเลตต์ WIN999 เป็น "ทองล้วนบนพื้นดำ" ตามโลโก้ที่ WIN เป็นทองสด #fcc403 และ 999
// เป็นขาว กับอาร์ตเวิร์กพื้นดำที่มีริ้วแสงทองและชิปขอบทอง:
// เนื้อความ #e9e4d6 (BRAND_TEXT) · ทองสว่าง #fdda04 · ทองแบรนด์ #fcc403 ·
// ทองกลาง #e0a800 · ทองลึก #8a6502 · ทองเข้มสุด #4a3402 · ผิวการ์ด #101010 ·
// ผิวการ์ดอุ่น/ยก #191712 · พื้นเพจ #050505 · เน้นใน strong #fffbea ·
// หมึกบนพื้นทอง #120d02
// ปุ่มหลัก (สมัครสมาชิก) รับไล่เฉดทองเต็มใบ #fdda04 → #fcc403 → #e0a800 และใช้หมึก
// เข้ม #120d02 เพราะตัวอักษรบนพื้นทองสว่างห้ามเป็นสีขาว — ทองลึก #8a6502 จงใจไม่อยู่
// ในไล่เฉดนี้ เพราะหมึกเข้มบนทองลึกเหลือคอนทราสต์แค่ ~3.3:1 ส่วนบนทองแบรนด์ได้ ~10:1
// ปุ่มรอง (เข้าสู่ระบบ) เป็นแบบ outline — กรอบทอง #fcc403 บนผิวการ์ดอุ่น #191712
// ไม่ใช่ไล่เฉดทองอีกใบ เพราะสองปุ่มถมทองเหมือนกันจะอ่านเป็นก้อนเดียว ลำดับความสำคัญ
// รอบนี้สื่อด้วย "ถมทอง vs กรอบทอง" แทนคู่สีแดง-ทองของแบรนด์ก่อน
// ส่วน #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ตามเดิม
// ชุดแดง+ทองของแบรนด์ก่อนหน้า (#dc2626 #fc2b2c #b40102 #fde68a #fbbf24 #a16207
// #2a0405 #7f1d1d #f6e2e2 rgba(220,38,38,*) rgba(251,191,36,*)) ถูกแทนครบทุกจุดแล้ว
//
// ป้ายที่อยู่ใช้ opacity ไม่ใช่คลาสสี ให้สืบทอดสีตัวอักษรจากการ์ด ส่วนสีทองมีเฉพาะ
// บนเส้นขอบและลิงก์อีเมล ซึ่งเป็น accent ไม่ใช่ body copy
//
// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. Keeping it in a const is what stops the meta tag
// and the structured data from drifting apart — they used to be two hand-typed
// variants of the same sentence, and the JSON-LD copy was the one nobody
// reread. 150–160 CHARACTERS (Thai is 3 bytes/char, so a byte count reads ~3x
// too long and will send you rewriting a description that was fine).
// This one is 152.
//
// WIN999 เป็นเว็บคาสิโนออนไลน์ บรีฟยกหัวข้อไว้ว่า "มีปัญหาในการเล่น ติดต่อแอดมิน
// WIN999 ให้บริการตอบแชท 24 ชั่วโมง" และระบุเรื่องที่ทีมงานช่วยได้ไว้แค่ Login ไม่ได้
// เข้าเกมไม่ได้ เครดิตไม่เข้า รายการถอนอยู่ระหว่างตรวจสอบ และโปรโมชั่นไม่แสดง —
// ห้ามเขียนเกินนี้ ห้ามเอ่ยชื่อค่ายเกมเจาะจง ชื่อธนาคาร เลขใบอนุญาต หรือเครดิตฟรี
// และคำศัพท์ตระกูลสลาก/ลอตเตอรีของแบรนด์ก่อน (เลข 2 ตัว/3 ตัว อัตราจ่าย บิล/โพย
// ม้า เอเย่นต์) ห้ามหลงเหลือ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "ช่องทางติดต่อแอดมิน WIN999 ผ่านไลน์ได้ตลอด 24 ชั่วโมง สอบถามเรื่องเครดิต โปรโมชั่น ทางเข้า หรือแจ้งปัญหาการฝากถอนออโต้ให้ทีมงานช่วยตรวจสอบได้ทุกช่วงเวลา";

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: "ติดต่อทีมงาน WIN999",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    // `alternateName` is only for a genuine alternate NAME — an earlier brand
    // filled it with its own Thai spelling. The brief gives WIN999 no second
    // registered name, so the field stays out rather than being invented here:
    // this page's Organization node must not disagree with the one every other
    // page emits, and it is not a slot for marketing copy.
    //
    // BRAND_ADDRESS is rendered in the body but never enters the graph —
    // address/PostalAddress/email in JSON-LD fails the build gate.
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: "ติดต่อแอดมิน WIN999 ผ่านช่องทางไลน์ได้ตลอด 24 ชั่วโมง",
      },
    ],
  },
});
---

<MainLayout title="ติดต่อทีมงาน WIN999 แอดมินดูแลสมาชิกผ่านไลน์ตลอด 24 ชั่วโมง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน WIN999" as="h1">
    <Picture
      src={lineImage}
      alt="พริตตี้ผมยาวสีน้ำตาลในชุดเลื่อมสีชมพูยืนกอดอกและยิ้ม ฉากหลังเป็นวงกลมสีชมพูเรืองแสง ด้านล่างเป็นป้ายไอคอน LINE สีเขียวพร้อมข้อความว่า LINE Support"
      loading="lazy"
      fetchpriority="low"
      widths={[300, 400, 700]}
      sizes="(max-width: 420px) 100vw, 400px"
      class="mx-auto block h-auto w-full max-w-[400px]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 border-l-4 border-[#fcc403] pl-6 text-left text-base leading-relaxed not-italic">
          <p class="mb-1 font-bold opacity-90">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold text-[#fcc403] underline decoration-current/40 underline-offset-4 transition-colors hover:text-[#fdda04]">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก WIN999"
        class="flex items-center justify-center rounded-lg border border-[#fdda04]/70 bg-gradient-to-r from-[#fdda04] via-[#fcc403] to-[#e0a800] px-8 py-3 font-black text-[#120d02] shadow-[0_0_15px_rgba(252,196,3,0.45)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ WIN999"
        class="flex items-center justify-center rounded-lg border border-[#fcc403]/80 bg-[#191712] px-8 py-3 font-bold text-[#e9e4d6] shadow-[0_0_15px_rgba(3,2,0,0.75)] transition-all hover:scale-105 hover:border-[#fdda04] hover:bg-[#241f14] hover:text-[#fffbea] hover:shadow-[0_0_18px_rgba(252,196,3,0.35)]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อทีมงาน WIN999 ผ่าน Line Official"
        class="flex items-center justify-center gap-2 rounded-lg border border-[#00B900]/70 bg-gradient-to-r from-[#00B900] to-[#009900] px-8 py-3 font-bold text-white shadow-[0_10px_30px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
        <span aria-hidden="true" class="text-2xl">💬</span>
        <span>ติดต่อผ่าน Line Official</span>
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
