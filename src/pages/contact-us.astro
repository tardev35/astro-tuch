---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
import lineImage from "../assets/contact-line.webp";

// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, the LINE image, the address block, the buttons.
// ห้ามเติมหัวข้อย่อยหรือย่อหน้าอธิบายกลับมา — ไม่มีรายการ "ควรเตรียมข้อมูลอะไร
// ก่อนแจ้ง" ไม่มีประโยคเตือนเรื่องรหัสผ่าน/OTP ไม่ว่าคอปปี้นั้นจะเขียนดีแค่ไหน
// ทุกย่อหน้าที่เคยอยู่บนหน้านี้คือของที่รีแบรนด์รอบก่อนๆ คิดขึ้นเอง ไม่ใช่ของบรีฟ
// (รอบนี้ src/assets/content.txt ไม่มีส่วน SUB-PAGES เลย — จบที่บรรทัด 29
// ประโยคกำกับเรื่องรหัสผ่าน/OTP ของบรีฟอยู่บน index.astro และ /about-us
// ซึ่งเป็นบทความจริง)
//
// The h1 names what the page IS ("ติดต่อทีมงาน <brand>"), not what an article
// on it would have argued. A title that previews a body is the line that tempts
// the next rebrand into writing the body back.
//
// BRAND_ADDRESS สร้างตัวเองจาก BRAND_NAME (ตารางจังหวัดใน src/lib/thaiProvinces.ts)
// และอีเมลมาจาก site: — ห้ามพิมพ์บรรทัดที่อยู่หรืออีเมลเอง ห้ามเพิ่มบรรทัดถนนหรือ
// ลิงก์แผนที่ และห้ามส่งที่อยู่/อีเมลเข้า structured data (address/PostalAddress/
// email ใน JSON-LD ทำให้เกทของ verify-build แดง)
// verify-build เทียบโฮสต์ของอีเมลกับ site: — **ห้ามแก้สตริงนี้ด้วยมือ และห้าม
// พิมพ์โดเมนลงในไฟล์นี้**
// · กล่องจดหมายนี้ตั้งใจไม่ route ไปไหน เป็นการตัดสินใจของเจ้าของ
// ห้ามยกขึ้นมาถามทุกรอบ ห้ามตั้ง mail routing และห้ามลบบรรทัดนี้ออก
//
// Announcement รอบนี้หมุนมาเป็นตัวที่ลงท้ายด้วยคำว่าหวย ทั้งเว็บ
// (brand-spec §3 — รอบก่อนใช้ตัวท้ายชื่อพรีเมียมจึงหมุนออก · เขียนชื่อ variant แบบ
// ไม่มีเครื่องหมายคำพูดโดยตั้งใจ เพราะ tools/gen-tw-sources.mjs นับ literal
// ที่มีเครื่องหมายคำพูดว่าเป็นการ import จริง) orchestrator ตั้ง default message
// ของไฟล์นั้นเป็นคอปปี้ของแบรนด์ปัจจุบันไว้แล้ว ทุกหน้าเรียกแบบ bare จึงห้ามส่ง
// prop message จากหน้านี้ ไม่งั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตต์รอบนี้อยู่ใน .claude/brand-spec-lottoplus.md §2
// 🚨🚨 **กลับทิศ 180° จากรอบก่อนอีกครั้ง: รอบนี้ "เนื้อหาสว่าง โครมเข้ม"**
// (รอบก่อน WIN8S มืดทั้งเว็บ — คนละปลายของสเกล)
// bg.json = {"mode":"color","color":"#e1fef3"} = **เขียวมินต์จางเกือบขาว**
// การ์ด ContentBox จึงเป็นผิวขาว #ffffff บนหมึกเข้ม #0d3326 (= BRAND_TEXT, 13.8:1)
// **ห้าม "แก้" การ์ดกลับไปเป็นผิวเข้มตามรอบก่อน** — ผิวเข้มบนหมึกนี้ = ตัวอักษรหายไปเลย
//
// บทบาทสีในไฟล์นี้:
//   ปุ่ม PRIMARY (สมัครสมาชิก) = ไล่เฉดเขียวมรกต #0c7c58 -> #046c4e -> #03543c
//     บนหมึก **ขาว #ffffff** (5.2 / 6.7 / 9.2:1 — ผ่าน AA ทุก stop)
//     🚨🚨 **หมึกเข้ม #0d3326 บนเฉดนี้ตกทุก stop — ห้ามใช้เด็ดขาด** (รอบก่อนปุ่มหลัก
//     เป็นส้ม-ทองจึงรองหมึกดำได้ รอบนี้กลับทิศ)
//     ⚠️⚠️ **ห้ามดันปลายอ่อนขึ้นไปถึง #19a97c** — ขาวบนค่านั้นเหลือ 3.0:1
//   ปุ่ม SECONDARY (เข้าสู่ระบบ) = ผิวพื้นถมอ่อน #d2f3e4 บนหมึก #046c4e (5.4:1)
//     ขอบ #19a97c เป็นตัวแยกปุ่มออกจากผิวการ์ดขาว — ห้ามถอดขอบออก
//   หมึกเนื้อความ #0d3326 มาจากการ์ด — ป้ายที่อยู่จึงไม่ประกาศสีตัวอักษรเอง
//     ⚠️ บล็อก address **ห้ามมีสีแบรนด์เป็นสีตัวอักษรเลยสักค่า** เส้นขอบซ้าย
//     ใช้ #19a97c ซึ่งเป็น "ขอบตกแต่ง" ของพาเลตรอบนี้ — รอบก่อนใช้ 8a3a12
//     (เขียนไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep หาสีแบรนด์เก่าสะดุดที่คอมเมนต์
//     ของไฟล์นี้เอง) ซึ่งรอบนี้หายไปทั้งค่า
// ขั้วของปุ่มตรงกับ /ทางเข้า /login /register /promotion ซึ่งวางปุ่มคู่นี้บนการ์ด
// ผิวขาวเหมือนกัน: สมัครสมาชิก = PRIMARY ไล่เฉดเขียวมรกต · เข้าสู่ระบบ = SECONDARY
// ผิวพื้นถมอ่อนคู่กับขอบเขียวสดและหมึกเขียวมรกต
// ออราในไฟล์นี้ใช้ rgba(4,108,78,α) · rgba(25,169,124,α) · rgba(47,212,155,α) ·
// rgba(226,179,42,α) · rgba(13,51,38,α) · rgba(5,46,34,α) เท่านั้น
// ⚠️⚠️ **#ffffff #f0fdf7 #d2f3e4 #a3ddc3 #19a97c #2fd49b #e1fef3 เป็นผิว/เส้น
// ห้ามถือตัวอักษรในไฟล์นี้** ที่ถือตัวอักษรได้บนการ์ดขาวคือ #0d3326 · #3f6f5c ·
// #046c4e · #8a6508
// 🚨 **#e2b32a (ทองอำพัน) ได้แค่ 2.0:1 บนการ์ดขาว — ห้ามถือตัวอักษรบนหน้านี้**
// นอกจากสีเขียวของ LINE — #00B900 เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ คงไว้เดิม
// **ห้ามเปลี่ยนเป็นสีของแบรนด์ และห้ามเอามาใช้เป็นสีแบรนด์** (รอบนี้แบรนด์ก็เป็นเขียว
// จึงสับสนง่ายที่สุด) ต้องเป็นพื้นถม bg ของค่านั้น + หมึกขาว ไม่ใช่ตัวอักษรสีเขียว
// บนพื้นโปร่ง
//
// 🚨🚨 กับดักรอบนี้: **ตระกูล Huay (เจ้าของเดิมของ NavbarHuay/AnnouncementHuay)
// เป็นแบรนด์หวย แดง/ทอง** และ **LOTTO189 ก็เป็นแบรนด์หวยเหมือนกัน** →
// **"เจอคำว่าหวย ไม่ได้แปลว่าเป็นของรอบนี้"** และ **"เจอเขียวหรือทอง ก็ไม่ได้แปลว่า
// เป็นของรอบนี้"** (สาธุ168 / TEVA69 / ZORO365 เป็นเขียวทั้งหมด) ต้องเทียบ
// **ค่าเฮกซ์ให้ตรงหกหลัก** กับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive (คู่ที่ต้องสงสัยก่อนเสมอ
// เขียนแบบไม่มี #: e5a92b e3a712 ffd94a e9b53c e0b03a d4922c ↔ e2b32a/8a6508 ·
// 0b7d28 0a5f1c 0f9b35 ↔ 046c4e/0c7c58 · c9d2dc dde1e7 cfd6e3 ↔ c8d4d0 ·
// fdf0e6 e0bda4 ↔ **ไม่มีคู่ หมึกรอบนี้เป็นสีเข้ม** · 8a0412 b00718 c1071b a30d1a
// f27a1a e8620e ↔ **ไม่มีคู่ แดงกับส้มออกจากพาเลตแล้วทั้งสองตระกูล**)
// ชุดส้มเพลิง-ทองอำพันบนดำของแบรนด์ขาออกรอบก่อนทันที (ทั้งคลาสสีและค่าใน rgba
// ของเงา/ออรา) ถูกกวาดออกจากไฟล์นี้ครบทุกจุดแล้ว — **ลิสต์ค่าเต็มอยู่ที่
// brand-spec §2 ไม่พิมพ์ซ้ำที่นี่** ลิสต์เดียวที่อัปเดตที่เดียวย่อมไม่หลุดกันเอง
// รอบนี้ **ไม่มีแดง/ส้ม/ม่วง/ฟ้า/แมเจนต้า/ชมพูเป็นสี UI เลยสักเฉด** (ยกเว้น
// เขียว LINE ซึ่งเป็นสีเชิงความหมาย)
// ⚠️⚠️ **ชุดไทยทอง-เขียวมรกต เครื่องประดับทองฝังพลอยเขียว ยอดปรางค์ทอง
// ดอกลีลาวดีขาว ลูกบอลหวยเขียว-ขาว และสีผิวนักแสดงในอาร์ตเวิร์กเป็นวัตถุในภาพ
// ไม่ใช่สี UI** — พื้นเพจมาจาก bg.json เท่านั้น **ห้ามอนุมานจากรูป**
// 🚨 **เวิร์ดมาร์กโครเมียมเงิน-เขียวมรกตกับใบโคลเวอร์ก็เป็นอาร์ตเวิร์ก ไม่ใช่สี UI**
//
// contact-line.webp เป็นอาร์ตสต็อกกลางของเทมเพลต ไม่ใช่อาร์ตเวิร์กของแบรนด์นี้
// และไม่มีชื่อแบรนด์ใดพิมพ์อยู่บนรูป — alt จึงบรรยายรูปจริงตามที่เห็น ห้ามเอ่ย
// ชื่อแบรนด์ในคำบรรยายรูปใบนี้ และห้าม "แก้" คำบรรยายให้เข้ากับธีม นั่นคือ alt ที่
// โกหกรูป (ชุดเลื่อมในภาพเป็น **สีชมพู** จริง ซึ่งรอบนี้ไม่มีในพาเลตเลย — แต่นั่น
// ไม่ใช่เหตุผลให้แก้บรรทัดนี้ มันคือ "เนื้อหาของรูป" ไม่ใช่สีของ UI)
//
// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. Keeping it in a const is what stops the meta tag
// and the structured data from drifting apart. 150–160 CODE POINTS, counted
// with [...s].length exactly like verify-build.mjs — do NOT use `wc -c` on this
// box: git-bash has no UTF-8 locale here, so it counts BYTES and reads ~3x too
// long. This one is 152 with this round's 9-code-point brand name, so the
// non-brand part is 143 → it accepts a 7–17 character brand name (recount it
// every rebrand, never inherit the length — last round's name was 5).
//
// คอปปี้ของหน้านี้อนุมานจากบรีฟบรรทัด 21-22 ซึ่งระบุเรื่องที่ติดต่อได้ไว้แค่:
// การสมัครสมาชิก การเข้าสู่ระบบ ประเภทหวย รอบปิดรับ อัตราจ่าย และการตรวจสอบรายการ
// ฝากถอน กับเจ้าหน้าที่ตลอด 24ชม. ผ่านเว็บไซต์ทางการ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง —
// ห้ามเขียนเกินนี้ และคำศัพท์ต้องอยู่ใน brand-spec §5 ซึ่งไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาคำของแบรนด์เก่าเจอ false positive
// ⚠️ แกนของบรีฟรอบนี้คือ **เว็บหวยออนไลน์** และมี **สี่ประเภทเท่านั้น**
// (หวยรัฐบาลไทย · หวยลาว · หวยฮานอย · หวยหุ้น)
// 🚨 **รอบก่อนเป็นคาสิโน/บาคาร่า — ห้ามสืบทอดลิสต์ข้ามรอบเด็ดขาด**
// ศัพท์หมวดธุรกิจของแบรนด์ขาออกทุกคำจึงเป็นของค้างที่ต้องไม่เหลือ
// รายการเต็มอยู่ใน brand-spec §5
// ⚠️ ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 100 · 1,000 · 2 ตัว · 3 ตัว · 3 ขั้นตอน · 24ชม.
// ห้ามแต่งเลขใบอนุญาต หน่วยงานกำกับ ตัวเลขการเงิน หรือจำนวนสมาชิก
// 🚨 และตัวเลขอัตราจ่าย แม้รอบนี้จะเขียนได้บนหน้าอื่น **ก็ไม่มีที่ยืนในตัวหน้านี้**
// หน้านี้มีโควตาเป็นรูป ที่อยู่ และปุ่ม (description อ้างได้เพราะเป็นเรื่องที่
// ติดต่อสอบถามได้ ตามบรีฟบรรทัด 22 ไม่ใช่การประกาศอัตราจ่าย)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ติดต่อทีมงาน ${BRAND_NAME} ผ่าน LINE Official ตลอด 24ชม. สอบถามการสมัครสมาชิก การเข้าสู่ระบบ ประเภทหวย และอัตราจ่าย ผ่านช่องทางทางการเพื่อเลี่ยงบัญชีแอบอ้าง`;

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: `ติดต่อทีมงาน ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    // `alternateName` is only for a genuine alternate NAME — an earlier brand
    // filled it with its own Thai spelling. The brief gives this brand no second
    // registered name, so the field stays out rather than being invented here:
    // this page's Organization node must not disagree with the one every other
    // page emits, and it is not a slot for marketing copy.
    //
    // BRAND_ADDRESS is rendered in the body but never enters the graph —
    // address/PostalAddress/email in JSON-LD fails the build gate.
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: `ติดต่อแอดมิน ${BRAND_NAME} ผ่าน LINE Official ได้ตลอด 24ชม.`,
      },
    ],
  },
});
---

<MainLayout title={`ติดต่อทีมงาน ${BRAND_NAME} แอดมินแทงหวยออนไลน์ตลอด 24ชม.`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ติดต่อทีมงาน ${BRAND_NAME}`} as="h1">
    <Picture
      src={lineImage}
      alt="พริตตี้ผมยาวสีน้ำตาลในชุดเลื่อมสีชมพูยืนกอดอกและยิ้ม ฉากหลังเป็นวงกลมสีชมพูเรืองแสง ด้านล่างเป็นป้ายไอคอน LINE สีเขียวพร้อมข้อความว่า LINE Support"
      loading="lazy"
      fetchpriority="low"
      widths={[300, 400, 700]}
      sizes="(max-width: 420px) 100vw, 400px"
      class="mx-auto block h-auto w-full max-w-[400px]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 border-l-4 border-[#19a97c] pl-6 text-left text-base leading-relaxed not-italic">
          <p class="mb-1 flex items-center gap-2 font-bold opacity-90">
            <span aria-hidden="true">📍</span>
            {BRAND_ADDRESS.label}
          </p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="/register"
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
