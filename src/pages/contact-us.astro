---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
import lineImage from "../assets/contact-line.webp";

// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, the LINE image, the address block, the buttons.
// ห้ามเติมหัวข้อย่อยหรือย่อหน้าอธิบายกลับมา — ไม่มีรายการ "ควรเตรียมข้อมูลอะไร
// ก่อนแจ้ง" ไม่มีประโยคเตือนเรื่องรหัสผ่าน/OTP ไม่ว่าคอปปี้นั้นจะเขียนดีแค่ไหน
// ทุกย่อหน้าที่เคยอยู่บนหน้านี้คือของที่รีแบรนด์รอบก่อนๆ คิดขึ้นเอง ไม่ใช่ของบรีฟ
// (รอบนี้ src/assets/content.txt ไม่มีส่วน SUB-PAGES เลย — จบที่บรรทัด 27
// ประโยคเตือนเรื่องรหัสผ่าน/OTP ของบรีฟอยู่บน index.astro ซึ่งเป็นบทความจริง)
//
// The h1 names what the page IS ("ติดต่อทีมงาน <brand>"), not what an article
// on it would have argued. A title that previews a body is the line that tempts
// the next rebrand into writing the body back.
//
// BRAND_ADDRESS สร้างตัวเองจาก BRAND_NAME (ตารางจังหวัดใน src/lib/thaiProvinces.ts)
// และอีเมลมาจาก site: — ห้ามพิมพ์บรรทัดที่อยู่หรืออีเมลเอง ห้ามเพิ่มบรรทัดถนนหรือ
// ลิงก์แผนที่ และห้ามส่งที่อยู่/อีเมลเข้า structured data (address/PostalAddress/
// email ใน JSON-LD ทำให้เกทของ verify-build แดง)
// ⚠️ โดเมนรอบนี้เป็น **ASCII ล้วน ไม่ต้องแปลง punycode** และ TLD เป็น .games
// ไม่ใช่ .com — อีเมลที่ render ออกมาจึงเป็น <mailbox>@<host ของ site:> ตรงๆ
// verify-build เทียบโฮสต์ของอีเมลกับ site: — **ห้ามแก้สตริงนี้ด้วยมือ และห้าม
// พิมพ์โดเมนลงในไฟล์นี้**
// · กล่องจดหมายนี้ตั้งใจไม่ route ไปไหน เป็นการตัดสินใจของเจ้าของ
// ห้ามยกขึ้นมาถามทุกรอบ ห้ามตั้ง mail routing และห้ามลบบรรทัดนี้ออก
//
// Announcement หมุนมาเป็น AnnouncementHuay ทั้งเว็บรอบนี้ (brand-spec §3 —
// รอบก่อนใช้ AnnouncementPremium จึงหมุนออก) orchestrator ตั้ง default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์ปัจจุบันไว้แล้ว ทุกหน้าเรียกแบบ bare จึงห้ามส่ง prop
// message จากหน้านี้ ไม่งั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตต์รอบนี้อยู่ใน brand-spec §2
// 🚨🚨 **รอบนี้ยังเป็นธีมมืด แต่คนละฮิวกับรอบก่อนสิ้นเชิง — การ์ดผิวเข้ม หมึกสว่าง**
// bg.json = {"mode":"color","color":"#000000"} = **ดำสนิท**
// การ์ด ContentBox จึงเป็นผิว #121110 บนหมึก #f3ece0 (= BRAND_TEXT)
// **ห้าม "แก้" การ์ดกลับไปเป็นผิวสว่างเพราะรอบก่อนเป็นแบบนั้น**
//
// บทบาทสีในไฟล์นี้:
//   ทอง #ffd94a → #e3a712 → #b07d08 = **พื้นไล่เฉดของปุ่ม PRIMARY**
//     บนหมึก **ดำ #0a0a0a** (14.6 / 9.2 / 5.4:1 — ผ่านทุกสต็อป)
//     ⚠️⚠️ **ขาวบนทองได้แค่ ~1.2–2.2:1 — ห้ามวางหมึกขาวบนพื้นทองเด็ดขาด**
//     ⚠️⚠️ **ห้ามจบไล่เฉดที่ #9d6f06** (4.5:1 กับหมึกดำ) ค่านั้นใช้ได้เฉพาะ
//     ขอบ/ออรา/พื้นถมที่ไม่มีตัวอักษร
//     #ffd94a ถือตัวอักษรได้เฉพาะเมื่ออยู่ "บนผิวมืด" (13.8:1 บนการ์ด) ไม่ใช่เมื่อ
//     เป็นพื้นถมรองรับหมึกสว่าง
//   ปุ่ม SECONDARY = ไล่เฉดโครเมียมเงิน #e8eaee → #b4b9c2 บนหมึกดำ #0a0a0a
//     (16.6 / 10.5:1) ⚠️ **#b4b9c2 และ #6b7079 ห้ามถือตัวอักษร** เป็นพื้นถม/ขอบ
//     เท่านั้น ส่วน #e8eaee ถือตัวอักษรได้เมื่ออยู่บนผิวมืด
//   หมึกเนื้อความ #f3ece0 มาจากการ์ด — ป้ายที่อยู่จึงไม่ประกาศสีตัวอักษรเอง
//     ⚠️ บล็อก <address> **ห้ามมีสีแบรนด์เลยสักค่า** (brand-spec §6) เส้นขอบซ้าย
//     จึงเป็น border-white/20 ซึ่งลงตัวบนการ์ดผิวมืดของทุกแบรนด์ในไลบรารี —
//     รอบก่อนๆ เคยใส่เฮกซ์ของแบรนด์ไว้ตรงนี้ ซึ่งเป็นช่องรั่วที่ทำให้สีเก่าค้างข้ามรอบ
// ขั้วของปุ่มตรงกับ /ทางเข้า /login /register /promotion ซึ่งวางปุ่มคู่นี้บนการ์ด
// ผิวมืดเหมือนกัน: สมัครสมาชิก = PRIMARY ไล่เฉดทอง · เข้าสู่ระบบ = SECONDARY
// ไล่เฉดโครเมียมเงิน
// ⚠️ **เส้น #3d3425 ห้ามถือตัวอักษร** · ผิวจม #070707 · ผิวยก #1c1a16
// ออราในไฟล์นี้ใช้ rgba(255,217,74,α) · rgba(227,167,18,α) · rgba(176,125,8,α) ·
// rgba(232,234,238,α) · rgba(221,225,231,α) · rgba(0,0,0,α) เท่านั้น
// นอกจากสีเขียวของ LINE — #00B900 เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ คงไว้เดิม
// **ห้ามเปลี่ยนเป็นสีของแบรนด์**
//
// ⚠️ กับดักรอบนี้คือ **ทอง/เหลืองเคยนำมาแล้วเกือบทุกแบรนด์ในรีโปนี้** การเจอทอง
// ในไฟล์จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้ ต้องเทียบเป็น "ค่า" ทีละหลักกับตารางใน
// brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ
// false positive
// รอบนี้ **ไม่มีแดง ไม่มีน้ำเงิน/ฟ้า ไม่มีน้ำตาล ไม่มีครีม ไม่มีเขียว (ยกเว้น
// LINE green) ไม่มีชมพู/บานเย็น ไม่มีม่วง ไม่มีส้ม และไม่มีโรสโกลด์**
// ⚠️⚠️ **แดงคือฮิวนำของแบรนด์ขาออก (ชื่ออยู่ใน brand-spec §0)** การปล่อยแดงไว้ = ทั้งผิดพาเลต
// และหลงเหลือข้ามแบรนด์พร้อมกัน
// ⚠️⚠️ **ฮิวนำรอบนี้คือทอง ส่วนโครเมียมเงินเป็นวัสดุที่สองซึ่ง "ถือตัวอักษรได้"
// เมื่ออยู่บนผิวมืด** ต่างจากวัสดุที่สองของรอบก่อน ลิปสติกแดง ผมขาวเงิน และสีผิว
// นักแสดงในอาร์ตเวิร์กเป็นวัตถุในภาพ ไม่ใช่สี UI — **ห้ามดึงเข้ามาเป็นสีแบรนด์**
//
// contact-line.webp (mtime 2026-08-04) เป็นอาร์ตสต็อกกลางของเทมเพลต ไม่ใช่
// อาร์ตเวิร์กของแบรนด์นี้ และไม่มีชื่อแบรนด์ใดพิมพ์อยู่บนรูป — alt จึงบรรยายรูปจริง
// ตามที่เห็น ห้ามเอ่ยชื่อแบรนด์ในคำบรรยายรูปใบนี้ และห้าม "แก้" คำบรรยายให้เข้ากับ
// ธีม นั่นคือ alt ที่โกหกรูป (ชุดเลื่อมในภาพเป็นสีชมพู ซึ่งไม่เกี่ยวกับพาเลตรอบนี้เลย
// แต่มันเป็นเนื้อหาของรูป จึงต้องเขียนตามนั้น)
//
// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. Keeping it in a const is what stops the meta tag
// and the structured data from drifting apart. 150–160 CODE POINTS, counted
// with [...s].length exactly like verify-build.mjs — do NOT use `wc -m` on this
// box: git-bash has no UTF-8 locale here, so it counts BYTES and reads ~3x too
// long. This one is 157 with this round's 6-character brand name.
//
// คอปปี้ของหน้านี้อนุมานจากบรีฟบรรทัด 19-20 ซึ่งระบุเรื่องที่ติดต่อได้ไว้แค่:
// ประเภทหวย รอบปิดรับ อัตราจ่าย การตรวจสอบบิล รายการฝากถอน และรายละเอียด
// โปรโมชั่น กับเจ้าหน้าที่ตลอด 24ชม. ผ่านเว็บไซต์ทางการ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง —
// ห้ามเขียนเกินนี้ และคำศัพท์ต้องอยู่ใน brand-spec §5 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้
// grep หาคำของแบรนด์เก่าเจอ false positive
// ⚠️ แกนของบรีฟรอบนี้คือ **เว็บหวยออนไลน์** (รัฐบาลไทย ลาว ฮานอย ออมสิน)
// ไม่ใช่หมวดของรอบก่อน ศัพท์ของหมวดอื่นที่บรีฟไม่มีทุกคำจึงเป็นของค้างที่ต้อง
// ไม่เหลือ — รายการเต็มอยู่ใน brand-spec §5
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อธนาคาร ชื่อวอลเล็ต หรือใบอนุญาตแม้แต่รายเดียว**
// (พูดถึง "ธนาคารและทรูมันนี่" แบบรวมๆ เท่านั้น)
// ⚠️ ตัวเลขที่บรีฟให้และใช้ได้มีแค่ บาทละ 1,000 · 2 ตัว 100 · 3 ตัว 1,000 ·
// 0.3% · 0.8% · 24ชม. **ไม่มีวลีจำนวนขั้นตอนรอบนี้** ห้ามแต่งเลขใบอนุญาต
// หน่วยงานกำกับ ตัวเลขการเงิน หรือจำนวนสมาชิก หน้านี้มีโควตาเป็นรูป ที่อยู่ และปุ่ม
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ติดต่อแอดมิน ${BRAND_NAME} ผ่าน LINE Official ได้ตลอด 24ชม. สอบถามรอบปิดรับ อัตราจ่าย การตรวจบิล และรายการฝากถอน ได้จากช่องทางทางการเท่านั้น เพื่อเลี่ยงบัญชีแอบอ้าง`;

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: `ติดต่อทีมงาน ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    // `alternateName` is only for a genuine alternate NAME — an earlier brand
    // filled it with its own Thai spelling. The brief gives this brand no second
    // registered name, so the field stays out rather than being invented here:
    // this page's Organization node must not disagree with the one every other
    // page emits, and it is not a slot for marketing copy.
    //
    // BRAND_ADDRESS is rendered in the body but never enters the graph —
    // address/PostalAddress/email in JSON-LD fails the build gate.
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: `ติดต่อแอดมิน ${BRAND_NAME} ผ่าน LINE Official ได้ตลอด 24ชม.`,
      },
    ],
  },
});
---

<MainLayout title={`ติดต่อทีมงาน ${BRAND_NAME} แอดมินแทงหวยเปิดบริการตลอด 24ชม.`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ติดต่อทีมงาน ${BRAND_NAME}`} as="h1">
    <Picture
      src={lineImage}
      alt="พริตตี้ผมยาวสีน้ำตาลในชุดเลื่อมสีชมพูยืนกอดอกและยิ้ม ฉากหลังเป็นวงกลมสีชมพูเรืองแสง ด้านล่างเป็นป้ายไอคอน LINE สีเขียวพร้อมข้อความว่า LINE Support"
      loading="lazy"
      fetchpriority="low"
      widths={[300, 400, 700]}
      sizes="(max-width: 420px) 100vw, 400px"
      class="mx-auto block h-auto w-full max-w-[400px]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 border-l-4 border-white/20 pl-6 text-left text-base leading-relaxed not-italic">
          <p class="mb-1 font-bold opacity-90">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="/register"
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="relative isolate flex items-center justify-center overflow-hidden rounded-lg border border-[#9d6f06] bg-gradient-to-b from-[#ffd94a] via-[#e3a712] to-[#b07d08] px-8 py-3 font-black text-[#0a0a0a] shadow-[0_8px_22px_rgba(227,167,18,0.4)] transition-transform hover:scale-105">
        <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#dde1e7]/25 to-transparent"></span>
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="flex items-center justify-center rounded-lg border border-[#6b7079] bg-gradient-to-b from-[#e8eaee] to-[#b4b9c2] px-8 py-3 font-bold text-[#0a0a0a] shadow-[0_4px_14px_rgba(0,0,0,0.6)] transition-all hover:scale-105 hover:shadow-[0_8px_22px_rgba(232,234,238,0.35)]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`ติดต่อทีมงาน ${BRAND_NAME} ผ่าน Line Official`}
        class="flex items-center justify-center gap-2 rounded-lg border border-[#00B900] bg-[#00B900] px-8 py-3 font-bold text-white shadow-[0_10px_30px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
        <span aria-hidden="true" class="text-2xl">💬</span>
        <span>ติดต่อผ่าน Line Official</span>
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
