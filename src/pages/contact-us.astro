---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
import lineImage from "../assets/contact-line.webp";

// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, the LINE image, the address block, the buttons.
// ห้ามเติมหัวข้อย่อยหรือย่อหน้าอธิบายกลับมา — ไม่มีรายการ "ควรเตรียมข้อมูลอะไร
// ก่อนแจ้ง" ไม่มีประโยคเตือนเรื่องรหัสผ่าน/OTP ไม่ว่าคอปปี้นั้นจะเขียนดีแค่ไหน
// ทุกย่อหน้าที่เคยอยู่บนหน้านี้คือของที่รีแบรนด์รอบก่อนๆ คิดขึ้นเอง ไม่ใช่ของบรีฟ
// (รอบนี้ src/assets/content.txt ไม่มีส่วน SUB-PAGES เลย — จบที่บรรทัด 29
// ประโยคกำกับเรื่องรหัสผ่าน/OTP ของบรีฟอยู่บน index.astro และ /about-us
// ซึ่งเป็นบทความจริง)
//
// The h1 names what the page IS ("ติดต่อทีมงาน <brand>"), not what an article
// on it would have argued. A title that previews a body is the line that tempts
// the next rebrand into writing the body back.
//
// BRAND_ADDRESS สร้างตัวเองจาก BRAND_NAME (ตารางจังหวัดใน src/lib/thaiProvinces.ts)
// และอีเมลมาจาก site: — ห้ามพิมพ์บรรทัดที่อยู่หรืออีเมลเอง ห้ามเพิ่มบรรทัดถนนหรือ
// ลิงก์แผนที่ และห้ามส่งที่อยู่/อีเมลเข้า structured data (address/PostalAddress/
// email ใน JSON-LD ทำให้เกทของ verify-build แดง)
// verify-build เทียบโฮสต์ของอีเมลกับ site: — **ห้ามแก้สตริงนี้ด้วยมือ และห้าม
// พิมพ์โดเมนลงในไฟล์นี้**
// · กล่องจดหมายนี้ตั้งใจไม่ route ไปไหน เป็นการตัดสินใจของเจ้าของ
// ห้ามยกขึ้นมาถามทุกรอบ ห้ามตั้ง mail routing และห้ามลบบรรทัดนี้ออก
//
// Announcement รอบนี้หมุนมาเป็นตัวท้ายชื่อเลขห้า ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ตัวท้ายชื่อเลขสามจึงหมุนออก · เขียนชื่อไฟล์แบบไม่มีเครื่องหมายคำพูดโดยตั้งใจ
// เพราะ tools/gen-tw-sources.mjs นับ literal ที่มีเครื่องหมายคำพูดว่าเป็นการ import
// จริง) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์ปัจจุบัน
// ไว้แล้ว ทุกหน้าเรียกแบบ bare จึงห้ามส่ง prop message จากหน้านี้ ไม่งั้นตัววิ่ง
// จะพูดคนละเรื่องกับหน้าอื่น
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตต์รอบนี้อยู่ใน .claude/brand-spec-123bet.md §2
// 🚨🚨 **กลับทิศ 180° จากรอบก่อน: รอบนี้เนื้อหาเป็นผิวสว่าง ส่วนโครมเป็นผิวเข้ม
// แดงเลือดหมู** (รอบก่อนมืดทั้งเว็บ)
// bg.json = {"mode":"color","color":"#f7e4e9"} = **ชมพูบลัชจาง**
// (รอบก่อนเป็นเขียวป่าจมเกือบดำ — ค่ามาจากไฟล์ ห้ามเดาว่าเท่าเดิม)
// การ์ด ContentBox จึงเป็นผิว #fdf5f6 บนหมึก #36080f (= BRAND_TEXT, 16.3:1)
// **ห้าม "แก้" การ์ดให้เป็นผิวเข้มตามรอบก่อน** — การ์ดเข้มบนหมึกนี้ = ตัวอักษรหายไปเลย
//
// บทบาทสีในไฟล์นี้:
//   ปุ่ม PRIMARY (สมัครสมาชิก) = ไล่เฉดแดง #8a1420 -> #a30d1a -> #c21325
//     บนหมึก **ขาว #ffffff** (9.5 / 8.0 / 6.2:1 — ผ่าน AA ทุก stop)
//     ⚠️⚠️ **ห้ามลากสต็อปสว่างกว่า #c21325** (ขาวบนค่าที่สว่างกว่านั้นตก AA)
//   ปุ่ม SECONDARY (เข้าสู่ระบบ) = ไล่เฉด #fdf5f6 -> #f7dfe4 บนหมึก #a30d1a
//     ขอบ #d98fa0 เป็นตัวแยกปุ่มออกจากผิวการ์ด — ห้ามถอดขอบออก
//   หมึกเนื้อความ #36080f มาจากการ์ด — ป้ายที่อยู่จึงไม่ประกาศสีตัวอักษรเอง
//     ⚠️ บล็อก <address> **ห้ามมีสีแบรนด์เป็นสีตัวอักษรเลยสักค่า** เส้นขอบซ้าย
//     ใช้ #d98fa0 ซึ่งเป็น "ขอบตกแต่ง" ของพาเลตรอบนี้ — รอบก่อนใช้ 35a043
//     (เขียนไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep หาสีแบรนด์เก่าสะดุดที่คอมเมนต์
//     ของไฟล์นี้เอง) ซึ่งรอบนี้หายไปทั้งค่า
// ขั้วของปุ่มตรงกับ /ทางเข้า /login /register /promotion ซึ่งวางปุ่มคู่นี้บนการ์ด
// ผิวสว่างเหมือนกัน: สมัครสมาชิก = PRIMARY ไล่เฉดแดง · เข้าสู่ระบบ = SECONDARY
// ผิวสว่างคู่กับขอบชมพูเข้มและหมึกแดงชาด
// ออราในไฟล์นี้ใช้ rgba(163,13,26,α) · rgba(220,165,58,α) · rgba(217,143,160,α) ·
// rgba(54,8,15,α) เท่านั้น
// ⚠️⚠️ **#f7e4e9 #fdf5f6 #f7dfe4 #eec3cc #d98fa0 #330710 #1c050b เป็นผิว/เส้น
// ห้ามถือตัวอักษรในไฟล์นี้** ที่ถือตัวอักษรได้บนการ์ดสว่างคือ #36080f · #6b2b33 ·
// #a30d1a · #7a4a0c
// นอกจากสีเขียวของ LINE — #00B900 เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ คงไว้เดิม
// **ห้ามเปลี่ยนเป็นสีของแบรนด์** และต้องเป็นพื้นถม bg ของค่านั้น + หมึกขาว
// ไม่ใช่ตัวอักษรสีเขียวบนพื้นโปร่ง
//
// 🚨🚨 กับดักรอบนี้กลับทิศจากทุกรอบที่ผ่านมา: spec ของสามรอบก่อนเขียนไว้ทุกไฟล์ว่า
// "รอบนี้ไม่มีแดงเป็นสี UI เลยสักเฉด" — **รอบนี้แดงชาดคือฮิวนำของแบรนด์**
// คอมเมนต์เก่าในไฟล์ inventory ที่ห้ามแดงไว้เป็นของรอบก่อน ไม่ใช่ของรอบนี้
// → ที่ห้ามคือ **ค่าเฮกซ์ของแบรนด์เก่าแบบตรงหกหลัก** ไม่ใช่ "สีแดง" ในฐานะตระกูลสี
// และเพราะรอบนี้เป็นแบรนด์ แดง/ทอง/ขาวชมพู **LOTTO189 จึงเป็นแบรนด์ที่ใกล้ตัว
// ที่สุด (ตระกูลสีเดียวกันเป๊ะ)** รองลงมาคือ MEXICANOSLOT (แดง/ทอง/ครีม)
// การเจอแดงในไฟล์จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้ ต้องเทียบเป็น "ค่า" ทีละหลัก
// กับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่า
// เจอ false positive (คู่ที่ต้องสงสัยก่อนเสมอ เขียนแบบไม่มี #: a81410 c1071b
// b00718 ↔ a30d1a · 7e1221 8a0412 ↔ 8a1420 · c20305 c9102f ↔ c21325 ·
// ffe4e6 ffd4d7 f5b9bd f0bcbc ↔ f7e4e9/f7dfe4)
// รอบนี้ **ไม่มีเขียว/ม่วง/ฟ้า/ไซแอน/แมเจนต้าเป็นสี UI เลยสักเฉด** (ยกเว้นเขียว
// LINE ซึ่งเป็นสีเชิงความหมาย)
// ⚠️⚠️ **มงกุฎทอง ชิปคาสิโนแดง-ขาว ไพ่เอซ ผนังหินอ่อนงาช้าง และสีผิวนักแสดงใน
// อาร์ตเวิร์กเป็นวัตถุในภาพ ไม่ใช่สี UI** — พื้นเพจมาจาก bg.json เท่านั้น
// 🚨 **เวิร์ดมาร์กแดงชาด-โครเมียมเงินก็เป็นอาร์ตเวิร์ก ไม่ใช่สี UI**
//
// contact-line.webp เป็นอาร์ตสต็อกกลางของเทมเพลต ไม่ใช่อาร์ตเวิร์กของแบรนด์นี้
// และไม่มีชื่อแบรนด์ใดพิมพ์อยู่บนรูป — alt จึงบรรยายรูปจริงตามที่เห็น ห้ามเอ่ย
// ชื่อแบรนด์ในคำบรรยายรูปใบนี้ และห้าม "แก้" คำบรรยายให้เข้ากับธีม นั่นคือ alt ที่
// โกหกรูป (ชุดเลื่อมในภาพเป็น **สีชมพู** จริง — บังเอิญใกล้กับพาเลตรอบนี้ แต่นั่น
// ไม่ใช่เหตุผลให้แก้บรรทัดนี้ทั้งสองทาง มันคือ "เนื้อหาของรูป")
//
// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. Keeping it in a const is what stops the meta tag
// and the structured data from drifting apart. 150–160 CODE POINTS, counted
// with [...s].length exactly like verify-build.mjs — do NOT use `wc -c` on this
// box: git-bash has no UTF-8 locale here, so it counts BYTES and reads ~3x too
// long. This one is 155 with this round's 6-code-point brand name (recount it
// every rebrand, never inherit the length — last round's name was 7).
//
// คอปปี้ของหน้านี้อนุมานจากบรีฟบรรทัด 21-22 ซึ่งระบุเรื่องที่ติดต่อได้ไว้แค่:
// การสมัครสมาชิก การเข้าสู่ระบบ รายชื่อเกมเดิมพัน โปรโมชั่น และปัญหาการใช้งานบัญชี
// กับเจ้าหน้าที่ตลอด 24ชม. ผ่านเว็บไซต์ทางการ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง —
// ห้ามเขียนเกินนี้ และคำศัพท์ต้องอยู่ใน brand-spec §5 ซึ่งไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาคำของแบรนด์เก่าเจอ false positive
// ⚠️ แกนของบรีฟรอบนี้คือ **เว็บเกมคาสิโนออนไลน์ เจ้าของบาคาร่าสล็อต เว็บตรง
// ถูกลิขสิทธิ์ เซิร์ฟแท้ ปลอดภัยในไทย เจ็ดหมวดเกม** ศัพท์หมวดธุรกิจของแบรนด์
// ขาออกทุกคำจึงเป็นของค้างที่ต้องไม่เหลือ — รายการเต็มอยู่ใน brand-spec §5
// 🚨🚨 **บรีฟรอบนี้ไม่พูดถึงธนาคาร วอลเลท หรือการฝากถอนเลยแม้แต่คำเดียว** —
// หน้านี้จึงไม่เอ่ยถึงรายการฝากถอนหรือชื่อวอลเล็ตใดๆ ทั้งสิ้น
// ⚠️ ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 0.3% · 0.8% · 3 ขั้นตอน · 24ชม.
// ห้ามแต่งเลขใบอนุญาต หน่วยงานกำกับ ตัวเลขการเงิน หรือจำนวนสมาชิก
// 🚨 และ 0.3% / 0.8% แม้รอบนี้จะเขียนได้บนหน้าอื่น **ก็ไม่มีที่ยืนบนหน้านี้**
// หน้านี้มีโควตาเป็นรูป ที่อยู่ และปุ่ม
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ติดต่อทีมงาน ${BRAND_NAME} ผ่าน LINE Official ตลอด 24ชม. สอบถามการสมัครสมาชิก การเข้าสู่ระบบ รายชื่อเกม โปรโมชั่น และปัญหาการใช้งานบัญชี ผ่านช่องทางทางการเท่านั้น`;

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: `ติดต่อทีมงาน ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    // `alternateName` is only for a genuine alternate NAME — an earlier brand
    // filled it with its own Thai spelling. The brief gives this brand no second
    // registered name, so the field stays out rather than being invented here:
    // this page's Organization node must not disagree with the one every other
    // page emits, and it is not a slot for marketing copy.
    //
    // BRAND_ADDRESS is rendered in the body but never enters the graph —
    // address/PostalAddress/email in JSON-LD fails the build gate.
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: `ติดต่อแอดมิน ${BRAND_NAME} ผ่าน LINE Official ได้ตลอด 24ชม.`,
      },
    ],
  },
});
---

<MainLayout title={`ติดต่อทีมงาน ${BRAND_NAME} แอดมินออนไลน์ดูแลสมาชิกตลอด 24ชม.`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ติดต่อทีมงาน ${BRAND_NAME}`} as="h1">
    <Picture
      src={lineImage}
      alt="พริตตี้ผมยาวสีน้ำตาลในชุดเลื่อมสีชมพูยืนกอดอกและยิ้ม ฉากหลังเป็นวงกลมสีชมพูเรืองแสง ด้านล่างเป็นป้ายไอคอน LINE สีเขียวพร้อมข้อความว่า LINE Support"
      loading="lazy"
      fetchpriority="low"
      widths={[300, 400, 700]}
      sizes="(max-width: 420px) 100vw, 400px"
      class="mx-auto block h-auto w-full max-w-[400px]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 border-l-4 border-[#d98fa0] pl-6 text-left text-base leading-relaxed not-italic">
          <p class="mb-1 flex items-center gap-2 font-bold opacity-90">
            <span aria-hidden="true">📍</span>
            {BRAND_ADDRESS.label}
          </p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="/register"
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="relative isolate flex items-center justify-center overflow-hidden rounded-lg border border-[#8a1420] bg-gradient-to-b from-[#8a1420] via-[#a30d1a] to-[#c21325] px-8 py-3 font-black text-white shadow-[0_8px_22px_rgba(163,13,26,0.35)] transition-transform hover:scale-105">
        <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-white/10 to-transparent"></span>
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="flex items-center justify-center rounded-lg border-2 border-[#d98fa0] bg-gradient-to-b from-[#fdf5f6] to-[#f7dfe4] px-8 py-3 font-bold text-[#a30d1a] shadow-[0_4px_14px_rgba(54,8,15,0.12)] transition-all hover:scale-105 hover:border-[#a30d1a] hover:shadow-[0_8px_22px_rgba(163,13,26,0.22)]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`ติดต่อทีมงาน ${BRAND_NAME} ผ่าน Line Official`}
        class="flex items-center justify-center gap-2 rounded-lg border border-[#00B900] bg-[#00B900] px-8 py-3 font-bold text-white shadow-[0_10px_30px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
