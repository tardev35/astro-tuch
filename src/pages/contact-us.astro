---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
import lineImage from "../assets/contact-line.webp";

// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, the LINE image, the address block, the buttons.
// ห้ามเติมหัวข้อย่อยหรือย่อหน้าอธิบายกลับมา — ไม่มีรายการ "ควรเตรียมข้อมูลอะไร
// ก่อนแจ้ง" ไม่มีประโยคเตือนเรื่องรหัสผ่าน/OTP ไม่ว่าคอปปี้นั้นจะเขียนดีแค่ไหน
// ทุกย่อหน้าที่เคยอยู่บนหน้านี้คือของที่รีแบรนด์รอบก่อนๆ คิดขึ้นเอง ไม่ใช่ของบรีฟ
// (รอบนี้ src/assets/content.txt ไม่มีส่วน SUB-PAGES เลย — จบที่บรรทัด 29
// ประโยคกำกับเรื่องรหัสผ่าน/OTP ของบรีฟอยู่บน index.astro และ /about-us
// ซึ่งเป็นบทความจริง)
//
// The h1 names what the page IS ("ติดต่อทีมงาน <brand>"), not what an article
// on it would have argued. A title that previews a body is the line that tempts
// the next rebrand into writing the body back.
//
// BRAND_ADDRESS สร้างตัวเองจาก BRAND_NAME (ตารางจังหวัดใน src/lib/thaiProvinces.ts)
// และอีเมลมาจาก site: — ห้ามพิมพ์บรรทัดที่อยู่หรืออีเมลเอง ห้ามเพิ่มบรรทัดถนนหรือ
// ลิงก์แผนที่ และห้ามส่งที่อยู่/อีเมลเข้า structured data (address/PostalAddress/
// email ใน JSON-LD ทำให้เกทของ verify-build แดง)
// verify-build เทียบโฮสต์ของอีเมลกับ site: — **ห้ามแก้สตริงนี้ด้วยมือ และห้าม
// พิมพ์โดเมนลงในไฟล์นี้** 🚨 รอบนี้ operator ไม่ได้ให้ URL มา site: จึงยังเป็นค่า
// ของรอบก่อน และอีเมลที่ออกมาก็โฮสต์ตามนั้น — **ถูกต้องแล้ว ห้าม "แก้" ให้ตรงชื่อแบรนด์**
// · กล่องจดหมายนี้ตั้งใจไม่ route ไปไหน เป็นการตัดสินใจของเจ้าของ
// ห้ามยกขึ้นมาถามทุกรอบ ห้ามตั้ง mail routing และห้ามลบบรรทัดนี้ออก
//
// Announcement รอบนี้หมุนมาเป็นตัวเลขห้า ทั้งเว็บ (brand-spec §3 — รอบก่อนใช้
// ตัวท้ายชื่อหวยจึงหมุนออก · เขียนชื่อ variant แบบไม่มีเครื่องหมายคำพูดโดยตั้งใจ
// เพราะ tools/gen-tw-sources.mjs นับ literal ที่มีเครื่องหมายคำพูดว่าเป็นการ
// import จริง) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์
// ปัจจุบันไว้แล้ว ทุกหน้าเรียกแบบ bare จึงห้ามส่ง prop message จากหน้านี้
// ไม่งั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตรอบนี้อยู่ใน .claude/brand-spec-abm96.md §2
// **ทิศความสว่างเหมือนรอบก่อน (เนื้อหาสว่าง โครมเข้ม) แต่คนละตระกูลสีทั้งชุด**
// bg.json = {"mode":"color","color":"#f8b9f0"} = **ชมพูพาสเทลอิ่มตัว**
// (รอบก่อน LOTTOPLUS เป็น e1fef3 เขียวมินต์จาง — เปิด bg.json อ่านทุกรอบ ห้ามสืบทอด)
// การ์ด ContentBox จึงเป็นผิวขาว #ffffff บนหมึกเข้ม #3d0a2c (= BRAND_TEXT, 16.4:1)
// **ห้าม "แก้" การ์ดกลับไปเป็นผิวเข้ม** — ผิวเข้มบนหมึกนี้ = ตัวอักษรหายไปเลย
//
// บทบาทสีในไฟล์นี้:
//   ปุ่ม PRIMARY (สมัครสมาชิก) = ไล่เฉดชมพูบานเย็น #d11a7e -> #a30d63 -> #7a0449
//     บนหมึก **ขาว #ffffff** (5.0 / 7.5 / 10.8:1 — ผ่าน AA ทุก stop)
//     🚨🚨 **หมึกเข้ม #3d0a2c บนเฉดนี้ตก — ห้ามใช้เด็ดขาด** (บน #7a0449 ได้ 1.5:1)
//     ⚠️⚠️ **ห้ามลากปลายอ่อนกว่า #d11a7e** — ขาวบน #e0509f เหลือ 3.6:1
//   ปุ่ม SECONDARY (เข้าสู่ระบบ) = ผิว #ffffff บนหมึก #a30d63 (7.5:1)
//     ขอบ #e0509f เป็นตัวแยกปุ่มออกจากผิวการ์ดขาว — **ห้ามถอดขอบออก** เพราะ
//     ปุ่มนี้มีผิวเดียวกับการ์ด ขอบคือสิ่งเดียวที่ทำให้มันเป็นปุ่ม
//   หมึกเนื้อความ #3d0a2c มาจากการ์ด — ป้ายที่อยู่จึงไม่ประกาศสีตัวอักษรเอง
//     ⚠️ บล็อก address **ห้ามมีสีแบรนด์เป็นสีตัวอักษรเลยสักค่า** เส้นขอบซ้าย
//     ใช้ #e0509f ซึ่งเป็น "ขอบตกแต่ง" ของพาเลตรอบนี้ — รอบก่อนใช้ 19a97c
//     (เขียนไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep หาสีแบรนด์เก่าสะดุดที่คอมเมนต์
//     ของไฟล์นี้เอง) ซึ่งรอบนี้หายไปทั้งค่า
// ขั้วของปุ่มตรงกับ /ทางเข้า /login /register /promotion ซึ่งวางปุ่มคู่นี้บนการ์ด
// ผิวขาวเหมือนกัน: สมัครสมาชิก = PRIMARY ไล่เฉดชมพูบานเย็น · เข้าสู่ระบบ =
// SECONDARY ผิวขาวคู่กับขอบชมพูและหมึกชมพูบานเย็น
// ออราในไฟล์นี้ใช้ rgba(163,13,99,α) · rgba(224,80,159,α) · rgba(255,122,194,α) ·
// rgba(209,26,126,α) · rgba(61,10,44,α) · rgba(68,13,49,α) เท่านั้น
// ⚠️⚠️ **#ffffff #fff5fb #fcd9ee #f3a7d3 #e0509f #ff7ac2 #f8b9f0 เป็นผิว/เส้น
// ห้ามถือตัวอักษรในไฟล์นี้** ที่ถือตัวอักษรได้บนการ์ดขาวคือ #3d0a2c · #7a4263 ·
// #a30d63 · #6e4705
// 🚨 **#f2c14e (ทองอำพัน) ได้แค่ 1.7:1 บนการ์ดขาว — ห้ามถือตัวอักษรบนหน้านี้**
// นอกจากสีเขียวของ LINE — #00B900 เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ คงไว้เดิม
// **ห้ามเปลี่ยนเป็นสีของแบรนด์ และห้ามเอามาใช้เป็นสีแบรนด์** ต้องเป็นพื้นถม bg
// ของค่านั้น + หมึกขาว ไม่ใช่ตัวอักษรสีเขียวบนพื้นโปร่ง
//
// 🚨🚨 กับดักรอบนี้: **okkub88 เป็นแบรนด์ชมพูบานเย็นเหมือนกันเป๊ะ** และไฟล์ที่
// หมุนเข้ามารอบนี้ก็เฉียดชมพูทั้งคู่ (NavbarStyle6 เคยเป็นไวโอเลต-แมเจนต้าของ
// ZANE96 · Announcement5 เคยเป็นแดงชาด-ชมพูบลัชของ 123BET) →
// **"เจอชมพู ไม่ได้แปลว่าเป็นของรอบนี้"** ต้องเทียบ **ค่าเฮกซ์ให้ตรงหกหลัก**
// กับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์
// เก่าเจอ false positive (คู่ที่ต้องสงสัยก่อนเสมอ เขียนแบบไม่มี #:
// d91a73 ↔ d11a7e · 9c0f55 b01160 a30d1a c2178b ↔ a30d63 · fb439b fc4da1 fa63b9
// ↔ e0509f · f9b2d9 ffb3de ↔ f3a7d3 · 6a0f3c 6d0b3f ↔ 440d31/3d0a2c ·
// ffd84d dca53a e2b32a ↔ f2c14e · 046c4e 0d3326 3f6f5c 19a97c a3ddc3 d2f3e4
// ↔ **ไม่มีคู่ เขียวออกจากพาเลตทั้งตระกูลแล้ว**)
// รอบนี้ **ไม่มีเขียว/ส้ม/แดงชาด/ม่วง/ฟ้า/ไซแอนเป็นสี UI เลยสักเฉด** (ยกเว้น
// เขียว LINE ซึ่งเป็นสีเชิงความหมาย)
// ⚠️⚠️ **ผ้าซาตินชมพู ชุดลูกไม้ของนางแบบ ลูกหมูการ์ตูน ไพ่เอซ ลูกเต๋าชมพู
// ชิปคาสิโน วงล้อรูเล็ตขอบทอง และสีผิวนักแสดงในอาร์ตเวิร์กเป็นวัตถุในภาพ
// ไม่ใช่สี UI** — พื้นเพจมาจาก bg.json เท่านั้น **ห้ามอนุมานจากรูป**
//
// contact-line.webp เป็นอาร์ตสต็อกกลางของเทมเพลต ไม่ใช่อาร์ตเวิร์กของแบรนด์นี้
// และไม่มีชื่อแบรนด์ใดพิมพ์อยู่บนรูป — alt จึงบรรยายรูปจริงตามที่เห็น ห้ามเอ่ย
// ชื่อแบรนด์ในคำบรรยายรูปใบนี้ และห้าม "แก้" คำบรรยายให้เข้ากับธีม นั่นคือ alt ที่
// โกหกรูป (ชุดเลื่อมในภาพเป็นสีชมพูจริง ซึ่งรอบนี้บังเอิญใกล้พาเลต — **แต่นั่น
// ไม่ใช่เหตุผลให้แก้บรรทัดนี้เช่นกัน** มันคือ "เนื้อหาของรูป" ไม่ใช่สีของ UI)
//
// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. Keeping it in a const is what stops the meta tag
// and the structured data from drifting apart. 150–160 CODE POINTS, counted
// with [...s].length exactly like verify-build.mjs — do NOT use `wc -c` on this
// box: git-bash has no UTF-8 locale here, so it counts BYTES and reads ~3x too
// long. This one is 152 with this round's 5-code-point brand name, so the
// non-brand part is 147 → recount it every rebrand, never inherit the length
// (last round's name was 9).
//
// คอปปี้ของหน้านี้อนุมานจากบรีฟบรรทัด 21-22 ซึ่งระบุเรื่องที่ติดต่อได้ไว้แค่:
// การสมัครสมาชิก การเข้าสู่ระบบ เกมคาสิโน โปรโมชั่น และปัญหาการใช้งานบัญชี
// กับเจ้าหน้าที่ตลอด 24ชม. ผ่านเว็บไซต์ทางการ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง —
// ห้ามเขียนเกินนี้ และคำศัพท์ต้องอยู่ใน brand-spec §5 ซึ่งไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาคำของแบรนด์เก่าเจอ false positive
// ⚠️ แกนของบรีฟรอบนี้คือ **คาสิโนออนไลน์** และมี **ห้าหมวดเท่านั้น**
// (บาคาร่า · สล็อตออนไลน์ · รูเล็ต · ไฮโล · คาสิโนสด)
// 🚨 **รอบก่อนเป็นเว็บหวย — ห้ามสืบทอดลิสต์ข้ามรอบเด็ดขาด** ศัพท์หมวดธุรกิจของ
// แบรนด์ขาออกทุกคำจึงเป็นของค้างที่ต้องไม่เหลือ รายการเต็มอยู่ใน brand-spec §5
// ⚠️ ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 1 บาท · 0.3% · 0.8% · 3 ขั้นตอน · 24ชม.
// ห้ามแต่งเลขใบอนุญาต หน่วยงานกำกับ ตัวเลขการเงิน หรือจำนวนสมาชิก
// 🚨 และตัวเลขโปรโมชั่น แม้รอบนี้จะเขียนได้บนหน้าอื่น **ก็ไม่มีที่ยืนในตัวหน้านี้**
// หน้านี้มีโควตาเป็นรูป ที่อยู่ และปุ่ม
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ติดต่อทีมงาน ${BRAND_NAME} ผ่าน LINE Official ตลอด 24ชม. สอบถามการสมัครสมาชิก การเข้าสู่ระบบ เกมคาสิโน และโปรโมชั่น ผ่านช่องทางทางการเพื่อหลีกเลี่ยงบัญชีแอบอ้าง`;

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: `ติดต่อทีมงาน ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    // `alternateName` is only for a genuine alternate NAME — an earlier brand
    // filled it with its own Thai spelling. The brief's Thai phrase for this
    // round is content copy, not a second registered name, so the field stays
    // out rather than being invented here: this page's Organization node must
    // not disagree with the one every other page emits, and it is not a slot
    // for marketing copy.
    //
    // BRAND_ADDRESS is rendered in the body but never enters the graph —
    // address/PostalAddress/email in JSON-LD fails the build gate.
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: `ติดต่อแอดมิน ${BRAND_NAME} ผ่าน LINE Official ได้ตลอด 24ชม.`,
      },
    ],
  },
});
---

<MainLayout title={`ติดต่อทีมงาน ${BRAND_NAME} แอดมินคาสิโนออนไลน์ตลอด 24ชม.`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ติดต่อทีมงาน ${BRAND_NAME}`} as="h1">
    <Picture
      src={lineImage}
      alt="พริตตี้ผมยาวสีน้ำตาลในชุดเลื่อมสีชมพูยืนกอดอกและยิ้ม ฉากหลังเป็นวงกลมสีชมพูเรืองแสง ด้านล่างเป็นป้ายไอคอน LINE สีเขียวพร้อมข้อความว่า LINE Support"
      loading="lazy"
      fetchpriority="low"
      widths={[300, 400, 700]}
      sizes="(max-width: 420px) 100vw, 400px"
      class="mx-auto block h-auto w-full max-w-[400px]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 border-l-4 border-[#e0509f] pl-6 text-left text-base leading-relaxed not-italic">
          <p class="mb-1 flex items-center gap-2 font-bold opacity-90">
            <span aria-hidden="true">📍</span>
            {BRAND_ADDRESS.label}
          </p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="/register"
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="relative isolate flex items-center justify-center overflow-hidden rounded-lg border border-[#e0509f] bg-gradient-to-b from-[#d11a7e] via-[#a30d63] to-[#7a0449] px-8 py-3 font-black text-[#ffffff] shadow-[0_8px_22px_rgba(163,13,99,0.30)] transition-transform hover:scale-105">
        <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-white/10 to-transparent"></span>
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="flex items-center justify-center rounded-lg border-2 border-[#e0509f] bg-[#ffffff] px-8 py-3 font-bold text-[#a30d63] shadow-[0_4px_14px_rgba(61,10,44,0.10)] transition-all hover:scale-105 hover:bg-[#fff5fb] hover:shadow-[0_8px_22px_rgba(163,13,99,0.18)]">
        เข้าสู่ระบบ
