---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
import lineImage from "../assets/contact-line.webp";

// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, the LINE image, the address block, the buttons.
// Do not re-add section headings or explanatory prose here — no "เตรียมข้อมูล
// อะไรก่อนแจ้ง" list, no password/OTP notice, however well it reads. Every one
// of those was invented by an earlier rebrand, not by the brief: the docx
// SUB-PAGES section gives this route a Title and a Meta and never a body
// (รอบนี้บรีฟไม่มีส่วน SUB-PAGES เลย — content.txt จบที่บรรทัด 29)
//
// The <h1> names what the page IS ("ติดต่อทีมงาน <brand>"), not what an article
// on it would have argued. A title that previews a body is the line that tempts
// the next rebrand into writing the body back.
//
// BRAND_ADDRESS derives itself from BRAND_NAME (ตารางจังหวัดจริงใน
// src/lib/thaiProvinces.ts) และอีเมลมาจาก site: — ตั้งชื่อแบรนด์แล้วได้ทั้งคู่
// ห้ามพิมพ์บรรทัดที่อยู่หรืออีเมลเอง ห้ามเพิ่มบรรทัดถนนหรือลิงก์แผนที่ และห้ามส่ง
// ที่อยู่/อีเมลเข้า structured data (address/PostalAddress/email ใน JSON-LD
// ทำให้เกทของ verify-build แดง)
//
// Announcement หมุนมาเป็น Announcement3 ทั้งเว็บรอบนี้ (brand-spec §3 —
// รอบก่อนใช้ Announcement5 จึงหมุนออก) orchestrator ตั้ง default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์ปัจจุบันไว้แล้ว และทุกหน้าเรียกแบบ bare จึงห้ามส่ง
// prop message จากหน้านี้ ไม่งั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// แบรนด์รอบนี้ (รวยแทร่168, รอบ **ฟ้าอะซัวร์นำ · ทองอำพันรอง · บนพื้นดำสนิท**
// 2026-10-19, brand-spec §2): โลโก้คือคำว่า **"รวย"** ตัวอักษรไทยหนาสามมิติ
// **สีทองอำพันตัดขอบขาว** ต่อด้วย **"แทร่168" สีฟ้าอะซัวร์บับเบิลผิวมันวาว**
// ข้างๆ เป็น **ถุงเงินสีฟ้าสลักเครื่องหมายดอลลาร์ ปึกธนบัตร และกองเหรียญทอง**
// ล้อมด้วย **หัวใจสีฟ้า** กับ **ประกายดาวฟ้า-ทอง** บนพื้นขาว แบนเนอร์เป็นฉาก
// **พื้นขาว-ฟ้าน้ำแข็ง** มีหญิงสาวผมบลอนด์เงินชุดลูกไม้ขาว-ฟ้าผูกโบว์ซาตินฟ้า
// ชี้นิ้วมาทางผู้ชม มือถือจอฟ้า ตู้สล็อตขึ้นเลข 777 กล่องของขวัญ และเหรียญทองร่วง
// — **ฮิวนำของรอบนี้คือฟ้าอะซัวร์ ไม่ใช่ทอง**
// พื้นเพจจาก bg.json รอบนี้เป็น {"mode":"color","color":"#000000"} = ดำสนิท
// ชั้นผิว: ยก #0b2d52 (= การ์ด ContentBox) / กลาง #071e38 / จม #030f1d / พื้น #000000
// ฟ้าอะซัวร์ #039cfa (ฮิวนำ 4.6:1 บนผิวการ์ด) ·
// ฟ้าน้ำแข็ง #c3ebfc (ต้นสว่างของเกรเดียนต์ 10.8:1) ·
// ทองอำพัน #f9a826 (ฮิวที่สอง ขอบและตัวอักษรของปุ่มรอง 6.9:1) ·
// น้ำเงินลึก #04366b และบรอนซ์ลึก #704504 (เส้น/กรอบ/ออรา/พื้นถมเท่านั้น
// **ห้ามถือตัวอักษรทุกขนาด**) ·
// เนื้อความ #e3f2fc (= BRAND_TEXT ที่การ์ด ContentBox ตั้งให้แล้ว) ·
// หมึกบนพื้นถมฟ้า #031320 (6.2:1 บน #039cfa — ตัวเดียวที่ใช้ได้ที่นั่น)
//
// ขั้วของปุ่ม (พื้นสว่าง = หมึกเข้ม · พื้นเข้ม = หมึกสว่าง) ตรงกับคู่ปุ่มของ Navfoot:
// สมัครสมาชิก = PRIMARY ถม **ฟ้า** ไล่เฉด #c3ebfc → #039cfa ขอบ #04366b
// บนหมึก #031320 ·
// เข้าสู่ระบบ = SECONDARY จมลงจากการ์ดด้วยชั้น #071e38 → #030f1d ขอบ
// **ทองอำพัน** #f9a826/55 บนตัวอักษร **ทองอำพัน** #f9a826
// ⚠️ ห้ามกลับด้าน: พื้นถมฟ้าต้องใช้หมึก #031320 เสมอ ห้ามขาวหรือครีม
// ⚠️ #04366b #704504 ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่เส้นขอบ ออรา พื้นถม และเงา —
// ออราในไฟล์นี้ใช้ rgba(3,156,250,α) และ rgba(249,168,38,α) เท่านั้น นอกจากเงาดำ
// ล้วนและสีเขียวของ LINE
// ส่วน #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ตามเดิม
//
// ⚠️ กับดักรอบนี้คือ **ฟ้า** และ **ทอง** พร้อมกัน เพราะ **สองรอบติดกันก่อนหน้านี้**
// (นินจา168 ฟ้าไซยาน+เหลืองมะนาว · สบายเบท168 ฟ้าท้องฟ้า+ทองอำพัน) ก็เป็นฟ้านำ
// + ทอง/เหลืองรองเหมือนกัน และแบรนด์เกือบทุกรายที่ผ่านรีโปนี้มีทอง การเจอ
// "ฟ้าอยู่แล้ว" หรือ "ทองอยู่แล้ว" จึงไม่พิสูจน์อะไรเลย ฟ้ารอบนี้คือ #039cfa
// (3,156,250) และทองรอบนี้คือ #f9a826 (249,168,38) ให้เทียบเป็น "ค่า" ทีละหลัก
// กับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ
// false positive — ไม่เทียบด้วยตา และไม่เทียบด้วยตระกูลสี
// รอบนี้ **ไม่มีชมพู ไม่มีแดง ไม่มีม่วง ไม่มีเขียว (นอกจาก LINE) ไม่มีส้ม
// ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์ ไม่มีเหลืองมะนาว**
//
// contact-line.webp (mtime 2026-08-04) เป็นอาร์ตสต็อกกลางของเทมเพลต ไม่ใช่อาร์ตเวิร์ก
// ของแบรนด์นี้ และไม่มีชื่อแบรนด์ใดพิมพ์อยู่บนรูป — alt จึงบรรยายรูปจริงตามที่เห็น
// (เปิดบิตแมปอ่านซ้ำแล้วรอบนี้ ยังตรงทุกองค์ประกอบ · ชุดเลื่อมสีชมพูในภาพเป็น
// "เนื้อหาของรูป" ไม่ใช่สีของพาเลตต์รอบนี้ ซึ่งไม่มีชมพูเลย — ห้าม "แก้" คำบรรยาย
// ให้เป็นฟ้าเพื่อให้เข้ากับธีม นั่นคือ alt ที่โกหกรูป)
// ห้ามเอ่ยชื่อแบรนด์ในคำบรรยายรูปใบนี้
//
// ป้ายที่อยู่ไม่ประกาศสีตัวอักษรเลย ให้สืบทอดจากการ์ด สีแบรนด์มีเฉพาะบนเส้นขอบซ้าย
// ซึ่งเป็นเส้นตกแต่ง ไม่ใช่ body copy
//
// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. Keeping it in a const is what stops the meta tag
// and the structured data from drifting apart. 150–160 CODE POINTS, counted
// with [...s].length exactly like verify-build.mjs — do NOT use `wc -m` on this
// box: git-bash has no UTF-8 locale here, so it counts BYTES and reads ~3x too
// long. This one is 156.
//
// รอบนี้บรีฟ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES เลย คอปปี้ของหน้านี้จึง
// อนุมานจากบรรทัด 21-22 ซึ่งระบุเรื่องที่ติดต่อได้ไว้แค่: การสมัครสมาชิก การเข้าสู่ระบบ
// รายการฝากถอน และรายละเอียดโปรโมชั่น กับเจ้าหน้าที่ตลอด 24ชม. — ห้ามเขียนเกินนี้
// และคำศัพท์ต้องอยู่ใน brand-spec §6 ซึ่งไม่พิมพ์ซ้ำที่นี่
//
// ⚠️ แบรนด์นี้เป็น **เว็บสล็อตล้วน** ที่บรีฟมีแกนเป็น **โปรโมชั่นคืนยอดเสีย 0.3%
// และแนะนำเพื่อน 0.8%** — ไม่ใช่คาสิโน ไม่มีกีฬา และไม่ใช่เว็บหวย สองหน้าของหมวด
// ลอตเตอรียัง park อยู่ใน src/pages-disabled/ จึงไม่มี route ให้ลิงก์ไป
// รายการคำต้องห้ามเต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำ
// ของแบรนด์เก่าเจอ false positive — รอบก่อนขายตัวเองด้วยวลีที่บรีฟรอบนี้ไม่เอ่ย
// สักคำ คอปปี้ในไฟล์นี้จึงเขียนใหม่จากบรีฟ ไม่ใช่ find-and-replace ทับประโยคเก่า
// บรีฟยังกำกับว่าไม่ควรเปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น ซึ่งไม่ต้องเขียนซ้ำ
// เป็น prose บนหน้านี้ — หน้านี้มีโควตาเป็นรูป ที่อยู่ และปุ่มเท่านั้น
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกมแม้แต่ค่ายเดียว** จึงห้ามเขียนชื่อค่ายใดๆ
// ⚠️ ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 0.3% / 0.8% / 24ชม. ห้ามแต่งชื่อธนาคาร
// เลขใบอนุญาต หน่วยงานกำกับ ค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีใดๆ
// (บรีฟรอบนี้ไม่ได้เอ่ยปีไว้เลย)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ติดต่อทีมงาน ${BRAND_NAME} ผ่าน LINE Official ได้ตลอด 24 ชั่วโมง สอบถามการสมัครสมาชิก การเข้าสู่ระบบ รายการฝากถอน และรายละเอียดโปรโมชั่นกับเจ้าหน้าที่ได้โดยตรง`;

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: `ติดต่อทีมงาน ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    // `alternateName` is only for a genuine alternate NAME — an earlier brand
    // filled it with its own Thai spelling. The brief gives this brand no second
    // registered name, so the field stays out rather than being invented here:
    // this page's Organization node must not disagree with the one every other
    // page emits, and it is not a slot for marketing copy.
    //
    // BRAND_ADDRESS is rendered in the body but never enters the graph —
    // address/PostalAddress/email in JSON-LD fails the build gate.
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: `ติดต่อแอดมิน ${BRAND_NAME} ผ่าน LINE Official ได้ตลอด 24 ชั่วโมง`,
      },
    ],
  },
});
---

<MainLayout title={`ติดต่อทีมงาน ${BRAND_NAME} แอดมินเปิดบริการ 24 ชั่วโมง`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ติดต่อทีมงาน ${BRAND_NAME}`} as="h1">
    <Picture
      src={lineImage}
      alt="พริตตี้ผมยาวสีน้ำตาลในชุดเลื่อมสีชมพูยืนกอดอกและยิ้ม ฉากหลังเป็นวงกลมสีชมพูเรืองแสง ด้านล่างเป็นป้ายไอคอน LINE สีเขียวพร้อมข้อความว่า LINE Support"
      loading="lazy"
      fetchpriority="low"
      widths={[300, 400, 700]}
      sizes="(max-width: 420px) 100vw, 400px"
      class="mx-auto block h-auto w-full max-w-[400px]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 border-l-4 border-[#039cfa] pl-6 text-left text-base leading-relaxed not-italic">
          <p class="mb-1 font-bold opacity-90">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="/register"
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="flex items-center justify-center rounded-lg border border-[#04366b] bg-gradient-to-b from-[#c3ebfc] to-[#039cfa] px-8 py-3 font-black text-[#031320] shadow-[0_0_14px_rgba(3,156,250,0.45)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="flex items-center justify-center rounded-lg border border-[#f9a826]/55 bg-gradient-to-b from-[#071e38] to-[#030f1d] px-8 py-3 font-bold text-[#f9a826] shadow-[0_0_12px_rgba(249,168,38,0.22)] transition-all hover:scale-105 hover:border-[#f9a826] hover:shadow-[0_0_18px_rgba(249,168,38,0.45)]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`ติดต่อทีมงาน ${BRAND_NAME} ผ่าน Line Official`}
        class="flex items-center justify-center gap-2 rounded-lg border border-[#00B900] bg-[#00B900] px-8 py-3 font-bold text-white shadow-[0_10px_30px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
        <span aria-hidden="true" class="text-2xl">💬</span>
        <span>ติดต่อผ่าน Line Official</span>
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
