---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
import lineImage from "../assets/contact-line.webp";

// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, the LINE image, the address block, the buttons.
// ห้ามเติมหัวข้อย่อยหรือย่อหน้าอธิบายกลับมา — ไม่มีรายการ "ควรเตรียมข้อมูลอะไร
// ก่อนแจ้ง" ไม่มีประโยคเตือนเรื่องรหัสผ่าน/OTP ไม่ว่าคอปปี้นั้นจะเขียนดีแค่ไหน
// ทุกย่อหน้าที่เคยอยู่บนหน้านี้คือของที่รีแบรนด์รอบก่อนๆ คิดขึ้นเอง ไม่ใช่ของบรีฟ
// (รอบนี้ src/assets/content.txt ไม่มีส่วน SUB-PAGES เลย — จบที่บรรทัด 29)
//
// The <h1> names what the page IS ("ติดต่อทีมงาน <brand>"), not what an article
// on it would have argued. A title that previews a body is the line that tempts
// the next rebrand into writing the body back.
//
// BRAND_ADDRESS สร้างตัวเองจาก BRAND_NAME (ตารางจังหวัดใน src/lib/thaiProvinces.ts)
// และอีเมลมาจาก site: — ห้ามพิมพ์บรรทัดที่อยู่หรืออีเมลเอง ห้ามเพิ่มบรรทัดถนนหรือ
// ลิงก์แผนที่ และห้ามส่งที่อยู่/อีเมลเข้า structured data (address/PostalAddress/
// email ใน JSON-LD ทำให้เกทของ verify-build แดง)
// ⚠️ โดเมนรอบนี้เป็น **ASCII ล้วน** ไม่ต้องแปลง punycode (ต่างจากรอบก่อนที่เป็น IDN
// ภาษาไทย) อีเมลจึง render ออกมาเป็น <mailbox>@ufalion168.page ตรงๆ และ TLD คือ
// **.page ไม่ใช่ .com** verify-build เทียบโฮสต์ของอีเมลกับ site: ห้าม "แก้ให้สวย"
// กล่องจดหมายนี้ตั้งใจไม่ route ไปไหน เป็นการตัดสินใจของเจ้าของ — ห้ามยกขึ้นมาถาม
// ทุกรอบ ห้ามตั้ง mail routing และห้ามลบบรรทัดนี้ออก
//
// Announcement หมุนมาเป็น Announcement3 ทั้งเว็บรอบนี้ (brand-spec §3 — รอบก่อนใช้
// AnnouncementPremium จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็น
// คอปปี้ของแบรนด์ปัจจุบันไว้แล้ว ทุกหน้าเรียกแบบ bare จึงห้ามส่ง prop message
// จากหน้านี้ ไม่งั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// พาเลตต์รอบนี้อยู่ใน .claude/brand-spec-ufalion168.md §2 — **ทองสองเฉด + บรอนซ์
// บนพื้นดำสนิท ไม่มีสีที่สองที่เป็นคนละวงศ์** (bg.json =
// {"mode":"color","color":"#000000"})
// ทองอำพัน #d4922c (5.9:1 บนผิวการ์ด) · ทองเลมอน #fdfc71 (14.3:1) ·
// ครีมทอง #f6e3b4 (12.3:1) · บรอนซ์ #a25b24 (3.0:1 — เส้น/ขอบ/พื้นถม/ไอคอน
// เท่านั้น ไม่ใช่เนื้อความ) · เนื้อความ #fbf6e3 (= BRAND_TEXT ที่การ์ด ContentBox
// ตั้งให้แล้ว) · หมึกบนพื้นถมทอง/ครีม #1a1000 (7.1:1 บน #d4922c · 14.8:1 บน #f6e3b4)
// ชั้นผิว: ยก #33200a (= การ์ด ContentBox) / กลาง #1f1304 / จม #0a0601 / พื้น #000000
// ⚠️ **บรอนซ์ #a25b24 ตกเกณฑ์ AA ทุกพื้น (3.0–4.1:1) จึงเป็นสีพื้นถม/ขอบ/ไอคอน
// เท่านั้น ห้ามถือตัวอักษรบนพื้นเข้ม** ถ้าต้องมีตัวอักษรบนบรอนซ์ ให้ถมบรอนซ์แล้ววาง
// #fbf6e3 ทับ (4.8:1) — ในไฟล์นี้บรอนซ์ทำงานเป็น **ขอบ** เท่านั้น
//
// ขั้วของปุ่มตรงกับคู่ปุ่มของ Navfoot ที่ขึ้นทุกหน้าบนมือถือ จึงอ่านเป็นปุ่มเดียวกัน
// ทั้งเว็บ:
// สมัครสมาชิก = PRIMARY ถม **ทอง** ไล่เฉด #f6e3b4 → #d4922c ขอบ #a25b24
// บนหมึก #1a1000
// เข้าสู่ระบบ = SECONDARY จมลงจากการ์ดด้วยชั้น #1f1304 → #0a0601 ขอบ **บรอนซ์**
// #a25b24 บนตัวอักษร **ครีมทอง** #f6e3b4
// ⚠️ ห้ามกลับด้าน: พื้นถมทอง/ครีมต้องใช้หมึก #1a1000 เสมอ ห้ามขาวหรือครีม
// ⚠️ ห้ามใช้ผิวยก #33200a เป็นพื้นปุ่ม มันเป็นสีเดียวกับการ์ดที่ปุ่มวางอยู่ ปุ่มรอง
// จึงเริ่มที่ชั้นกลาง #1f1304
// ออราในไฟล์นี้ใช้ rgba(212,146,44,α) และ rgba(162,91,36,α) เท่านั้น นอกจากเงาดำ
// ล้วนและสีเขียวของ LINE — #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สี
// ของเว็บ จึงคงไว้ตามเดิม
//
// ⚠️ กับดักรอบนี้คือ **ทองเคยนำมาแล้วเกือบทุกแบรนด์** การเจอ "ทองอยู่แล้ว" ในไฟล์นี้
// จึงไม่พิสูจน์อะไรเลย ต้องเทียบเป็น "ค่า" ทีละหลักกับตารางใน brand-spec §2
// ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive
// (ทองของ TND168 ใกล้ทองรอบนี้ที่สุด ตัวตัดสินคือ G146 vs G163 และ B44 vs B16 —
// ตาแยกไม่ออก) และ **รอบนี้ไม่มีแดงเลย** ต่างจากรอบก่อนที่แดงเป็นฮิวที่สอง
// รอบนี้ **ไม่มีแดง ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง ไม่มีเขียว (นอกจาก LINE)
// ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์ ไม่มีชมพู/ฟูเชีย ไม่มีส้มสด** — บรอนซ์ #a25b24
// เป็นฮิวที่สามที่อ่านจาก logo.webp จริง ไม่ใช่ส้มอิสระ
//
// contact-line.webp (mtime 2026-08-04) เป็นอาร์ตสต็อกกลางของเทมเพลต ไม่ใช่
// อาร์ตเวิร์กของแบรนด์นี้ และไม่มีชื่อแบรนด์ใดพิมพ์อยู่บนรูป — alt จึงบรรยายรูปจริง
// ตามที่เห็น (ชุดเลื่อมสีชมพูในภาพเป็น "เนื้อหาของรูป" ไม่ใช่ค่าใดในพาเลตต์รอบนี้
// ซึ่งไม่มีชมพูเลย — ห้าม "แก้" คำบรรยายให้เข้ากับธีม นั่นคือ alt ที่โกหกรูป)
// ห้ามเอ่ยชื่อแบรนด์ในคำบรรยายรูปใบนี้
//
// ป้ายที่อยู่ไม่ประกาศสีตัวอักษรเลย ให้สืบทอดจากการ์ด สีแบรนด์มีเฉพาะบนเส้นขอบซ้าย
// ซึ่งเป็นเส้นตกแต่ง ไม่ใช่ body copy
//
// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. Keeping it in a const is what stops the meta tag
// and the structured data from drifting apart. 150–160 CODE POINTS, counted
// with [...s].length exactly like verify-build.mjs — do NOT use `wc -m` on this
// box: git-bash has no UTF-8 locale here, so it counts BYTES and reads ~3x too
// long. This one is 158 with this round's 10-character brand name.
//
// คอปปี้ของหน้านี้อนุมานจากบรีฟบรรทัด 21-22 ซึ่งระบุเรื่องที่ติดต่อได้ไว้แค่:
// การสมัครสมาชิก การเข้าสู่ระบบ ข้อมูลราคาบอล รายการฝากถอน และรายละเอียดโปรโมชั่น
// กับเจ้าหน้าที่ตลอด 24ชม. ผ่านช่องทางทางการ — ห้ามเขียนเกินนี้ และคำศัพท์ต้องอยู่ใน
// brand-spec §6 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำของแบรนด์เก่าเจอ
// false positive — รอบก่อนขายตัวเองด้วยวลีที่บรีฟรอบนี้ไม่เอ่ยสักคำ คอปปี้ในไฟล์นี้
// จึงเขียนใหม่จากบรีฟ ไม่ใช่ find-and-replace ทับประโยคเก่า
// ⚠️ บรีฟรอบนี้เป็น **แฟนเพจเว็บบอลยูฟ่า = เว็บกีฬา/ฟุตบอล** ไม่ใช่สล็อตและไม่ใช่
// หวย คำหมวดเกมสล็อต/ยิงปลา/ไฮโล/หวยออนไลน์ทุกคำเป็น **ของค้างจากแบรนด์ก่อน**
// หน้าหมวดลอตเตอรีสองหน้ายัง park อยู่ใน src/pages-disabled/ จึงไม่มี route ให้ลิงก์ไป
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกมหรือชื่อลีกแม้แต่ชื่อเดียว** จึงห้ามเขียนลงหน้า
// ⚠️ ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 0.3% / 0.8% / 24ชม. / 3 ขั้นตอน ห้ามแต่งชื่อ
// ธนาคาร เลขใบอนุญาต หน่วยงานกำกับ ค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีใดๆ
// (บรีฟรอบนี้ไม่ได้เอ่ยปีไว้เลย) — หน้านี้มีโควตาเป็นรูป ที่อยู่ และปุ่มเท่านั้น
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ติดต่อทีมงาน ${BRAND_NAME} ผ่าน LINE Official ได้ตลอด 24ชม. สอบถามการสมัครสมาชิก การเข้าสู่ระบบ ข้อมูลราคาบอล รายการฝากถอน และรายละเอียดโปรโมชั่นจากช่องทางทางการ`;

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: `ติดต่อทีมงาน ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    // `alternateName` is only for a genuine alternate NAME — an earlier brand
    // filled it with its own Thai spelling. The brief gives this brand no second
    // registered name, so the field stays out rather than being invented here:
    // this page's Organization node must not disagree with the one every other
    // page emits, and it is not a slot for marketing copy.
    //
    // BRAND_ADDRESS is rendered in the body but never enters the graph —
    // address/PostalAddress/email in JSON-LD fails the build gate.
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: `ติดต่อแอดมิน ${BRAND_NAME} ผ่าน LINE Official ได้ตลอด 24ชม.`,
      },
    ],
  },
});
---

<MainLayout title={`ติดต่อทีมงาน ${BRAND_NAME} แอดมินเปิดบริการตลอด 24ชม.`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ติดต่อทีมงาน ${BRAND_NAME}`} as="h1">
    <Picture
      src={lineImage}
      alt="พริตตี้ผมยาวสีน้ำตาลในชุดเลื่อมสีชมพูยืนกอดอกและยิ้ม ฉากหลังเป็นวงกลมสีชมพูเรืองแสง ด้านล่างเป็นป้ายไอคอน LINE สีเขียวพร้อมข้อความว่า LINE Support"
      loading="lazy"
      fetchpriority="low"
      widths={[300, 400, 700]}
      sizes="(max-width: 420px) 100vw, 400px"
      class="mx-auto block h-auto w-full max-w-[400px]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 border-l-4 border-[#a25b24] pl-6 text-left text-base leading-relaxed not-italic">
          <p class="mb-1 font-bold opacity-90">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="/register"
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="flex items-center justify-center rounded-lg border border-[#a25b24] bg-gradient-to-b from-[#f6e3b4] to-[#d4922c] px-8 py-3 font-black text-[#1a1000] shadow-[0_0_14px_rgba(212,146,44,0.45)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="flex items-center justify-center rounded-lg border border-[#a25b24] bg-gradient-to-b from-[#1f1304] to-[#0a0601] px-8 py-3 font-bold text-[#f6e3b4] shadow-[0_0_12px_rgba(162,91,36,0.4)] transition-all hover:scale-105 hover:border-[#d4922c] hover:shadow-[0_0_18px_rgba(212,146,44,0.45)]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`ติดต่อทีมงาน ${BRAND_NAME} ผ่าน Line Official`}
        class="flex items-center justify-center gap-2 rounded-lg border border-[#00B900] bg-[#00B900] px-8 py-3 font-bold text-white shadow-[0_10px_30px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
        <span aria-hidden="true" class="text-2xl">💬</span>
        <span>ติดต่อผ่าน Line Official</span>
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
