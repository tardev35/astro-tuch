---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement4.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
import lineImage from "../assets/contact-line.webp";

// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, the LINE image, the address block, the buttons.
// ห้ามเติมหัวข้อย่อยหรือย่อหน้าอธิบายกลับมา — ไม่มีรายการ "ควรเตรียมข้อมูลอะไร
// ก่อนแจ้ง" ไม่มีประโยคเตือนเรื่องรหัสผ่าน/OTP ไม่ว่าคอปปี้นั้นจะเขียนดีแค่ไหน
// ทุกย่อหน้าที่เคยอยู่บนหน้านี้คือของที่รีแบรนด์รอบก่อนๆ คิดขึ้นเอง ไม่ใช่ของบรีฟ
// (รอบนี้ src/assets/content.txt ไม่มีส่วน SUB-PAGES เลย — จบที่บรรทัด 29
// ประโยคกำกับเรื่องรหัสผ่าน/OTP ของบรีฟอยู่บน index.astro ซึ่งเป็นบทความจริง)
//
// The h1 names what the page IS ("ติดต่อทีมงาน <brand>"), not what an article
// on it would have argued. A title that previews a body is the line that tempts
// the next rebrand into writing the body back.
//
// BRAND_ADDRESS สร้างตัวเองจาก BRAND_NAME (ตารางจังหวัดใน src/lib/thaiProvinces.ts)
// และอีเมลมาจาก site: — ห้ามพิมพ์บรรทัดที่อยู่หรืออีเมลเอง ห้ามเพิ่มบรรทัดถนนหรือ
// ลิงก์แผนที่ และห้ามส่งที่อยู่/อีเมลเข้า structured data (address/PostalAddress/
// email ใน JSON-LD ทำให้เกทของ verify-build แดง)
// verify-build เทียบโฮสต์ของอีเมลกับ site: — **ห้ามแก้สตริงนี้ด้วยมือ และห้าม
// พิมพ์โดเมนลงในไฟล์นี้**
// · กล่องจดหมายนี้ตั้งใจไม่ route ไปไหน เป็นการตัดสินใจของเจ้าของ
// ห้ามยกขึ้นมาถามทุกรอบ ห้ามตั้ง mail routing และห้ามลบบรรทัดนี้ออก
//
// Announcement หมุนมาเป็น Announcement4 ทั้งเว็บรอบนี้ (brand-spec §3 — รอบก่อน
// ใช้ Announcement5 จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็น
// คอปปี้ของแบรนด์ปัจจุบันไว้แล้ว ทุกหน้าเรียกแบบ bare จึงห้ามส่ง prop message
// จากหน้านี้ ไม่งั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตต์รอบนี้อยู่ใน brand-spec ของรอบนี้ (.claude/brand-spec-*.md) §2
// 🚨🚨 **รอบนี้กลับทิศจากรอบก่อนทั้งเว็บ: จากธีมมืด เป็นธีมสว่าง — การ์ดผิวขาว
// หมึกเข้ม** bg.json = {"mode":"color","color":"#ffe5ff"} = **ชมพูพาสเทลสว่างมาก**
// การ์ด ContentBox จึงเป็นผิว #ffffff บนหมึก #3b0b26 (= BRAND_TEXT)
// **ห้าม "แก้" การ์ดกลับไปเป็นผิวมืดเพราะรอบก่อนเป็นแบบนั้น** การ์ดมืดบนหมึก
// #3b0b26 = ตัวอักษรหายไปเลย ไม่ใช่แค่จางลง
//
// บทบาทสีในไฟล์นี้:
//   ชมพูเข้ม #c2185b → #8e0f41 = **พื้นไล่เฉดของปุ่ม PRIMARY**
//     บนหมึก **ขาว #ffffff** (5.9 / 9.2:1 — ผ่านทั้งสองสต็อป)
//     ⚠️⚠️ **ห้ามใช้ #fa539c เป็นพื้นถมที่มีหมึกขาวทับ** ขาวบน #fa539c ได้แค่ 3.2:1
//     #fa539c รับได้เฉพาะหมึกพลัมเข้ม #3b0b26 (5.3:1)
//   ปุ่ม SECONDARY = ไล่เฉดชมพูสด #fb8cc0 → #fa539c บนหมึกพลัมเข้ม #3b0b26
//     (7.4 / 5.3:1) ⚠️ **#fb8cc0 #fa539c #ef8dbd #f7bcd9 ห้ามเป็นสีตัวอักษร**
//     เป็นพื้นถม/ขอบเท่านั้น
//   หมึกเนื้อความ #3b0b26 มาจากการ์ด — ป้ายที่อยู่จึงไม่ประกาศสีตัวอักษรเอง
//     ⚠️ บล็อก <address> **ห้ามมีสีแบรนด์เป็นสีตัวอักษรเลยสักค่า** เส้นขอบซ้าย
//     ใช้ #ef8dbd ซึ่งเป็น "เส้นเข้ม" ของพาเลตรอบนี้ — รอบก่อนใช้ border-white/20
//     ซึ่งลงตัวบนการ์ดมืดแต่ **หายไปสนิทบนการ์ดขาวของรอบนี้** จึงต้องเปลี่ยน
//     (รอบหน้าถ้าธีมกลับไปมืดอีก ให้กลับไปใช้ border-white/20)
// ขั้วของปุ่มตรงกับ /ทางเข้า /login /register /promotion ซึ่งวางปุ่มคู่นี้บนการ์ด
// ผิวขาวเหมือนกัน: สมัครสมาชิก = PRIMARY ไล่เฉดชมพูเข้ม · เข้าสู่ระบบ = SECONDARY
// ไล่เฉดชมพูสด
// ออราในไฟล์นี้ใช้ rgba(250,83,156,α) · rgba(251,140,192,α) · rgba(194,24,91,α) ·
// rgba(59,11,38,α) · rgba(253,198,195,α) เท่านั้น
// นอกจากสีเขียวของ LINE — #00B900 เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ คงไว้เดิม
// **ห้ามเปลี่ยนเป็นสีของแบรนด์**
//
// ⚠️⚠️ กับดักรอบนี้คือ **รอบนี้เป็นแบรนด์ชมพูจริง** การเจอชมพูในไฟล์จึงไม่พิสูจน์ว่า
// เป็นค่าของรอบนี้ ต้องเทียบเป็น "ค่า" ทีละหลักกับตารางใน brand-spec §2 ซึ่งไม่
// พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive
// รอบนี้ **ไม่มีทอง ไม่มีเหลือง ไม่มีน้ำเงิน/ฟ้า ไม่มีน้ำตาล ไม่มีครีม ไม่มีเขียว
// (ยกเว้น LINE green) ไม่มีม่วง ไม่มีส้ม ไม่มีแดงเจล และไม่มีโครเมียมเงินเย็น**
// ⚠️⚠️ **แดงเจลคือฮิวนำของแบรนด์ขาออก** การปล่อยแดงไว้ = ทั้งผิดพาเลตและหลงเหลือ
// ข้ามแบรนด์พร้อมกัน
// ⚠️⚠️ **ฮิวนำรอบนี้คือชมพูแคนดี้บนพื้นสว่าง** คาร์ดิแกนชมพู เสื้อกล้ามขาว และ
// สีผิวนักแสดงในอาร์ตเวิร์กเป็นวัตถุในภาพ ไม่ใช่สี UI — **ห้ามดึงเข้ามาเป็นสีแบรนด์**
//
// contact-line.webp เป็นอาร์ตสต็อกกลางของเทมเพลต ไม่ใช่อาร์ตเวิร์กของแบรนด์นี้
// และไม่มีชื่อแบรนด์ใดพิมพ์อยู่บนรูป — alt จึงบรรยายรูปจริงตามที่เห็น ห้ามเอ่ย
// ชื่อแบรนด์ในคำบรรยายรูปใบนี้ และห้าม "แก้" คำบรรยายให้เข้ากับธีม นั่นคือ alt ที่
// โกหกรูป (ชุดเลื่อมในภาพเป็นสีชมพูจริงตามที่เขียนไว้ ซึ่งบังเอิญใกล้พาเลตรอบนี้
// แต่เป็นเนื้อหาของรูป ไม่ใช่สี UI)
//
// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. Keeping it in a const is what stops the meta tag
// and the structured data from drifting apart. 150–160 CODE POINTS, counted
// with [...s].length exactly like verify-build.mjs — do NOT use `wc -m` on this
// box: git-bash has no UTF-8 locale here, so it counts BYTES and reads ~3x too
// long. This one is 159 with this round's 9-code-point brand name.
//
// คอปปี้ของหน้านี้อนุมานจากบรีฟบรรทัด 21-22 ซึ่งระบุเรื่องที่ติดต่อได้ไว้แค่:
// การสมัครสมาชิก การเข้าสู่ระบบ รายการฝากถอน และรายละเอียดโปรโมชั่น กับเจ้าหน้าที่
// ตลอด 24ชม. ผ่านเว็บไซต์ทางการ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง — ห้ามเขียนเกินนี้
// และคำศัพท์ต้องอยู่ใน brand-spec §5 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำของ
// แบรนด์เก่าเจอ false positive
// ⚠️ แกนของบรีฟรอบนี้คือ **เว็บสล็อต** (เกมสล็อตแท้ เว็บตรงถูกลิขสิทธิ์) ศัพท์ของ
// หมวดอื่นที่บรีฟไม่มีทุกคำจึงเป็นของค้างที่ต้องไม่เหลือ — รายการเต็มอยู่ใน
// brand-spec §5
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อธนาคาร ชื่อวอลเล็ต ชื่อค่ายเกม หรือใบอนุญาตแม้แต่
// รายเดียว** (พูดถึง "ธนาคารและทรูมันนี่" แบบรวมๆ เท่านั้น)
// ⚠️ ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 0.3% · 0.8% · 3 ขั้นตอน · 24ชม. ห้ามแต่งเลข
// ใบอนุญาต หน่วยงานกำกับ ตัวเลขการเงิน จำนวนเกม/ค่าย หรือจำนวนสมาชิก
// หน้านี้มีโควตาเป็นรูป ที่อยู่ และปุ่ม
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ติดต่อทีมงาน ${BRAND_NAME} ผ่าน LINE Official ได้ตลอด 24ชม. สอบถามการสมัครสมาชิก เข้าสู่ระบบ รายการฝากถอน และเงื่อนไขโปรโมชั่น ผ่านช่องทางทางการ เลี่ยงบัญชีแอบอ้าง`;

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: `ติดต่อทีมงาน ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    // `alternateName` is only for a genuine alternate NAME — an earlier brand
    // filled it with its own Thai spelling. The brief gives this brand no second
    // registered name, so the field stays out rather than being invented here:
    // this page's Organization node must not disagree with the one every other
    // page emits, and it is not a slot for marketing copy.
    //
    // BRAND_ADDRESS is rendered in the body but never enters the graph —
    // address/PostalAddress/email in JSON-LD fails the build gate.
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: `ติดต่อแอดมิน ${BRAND_NAME} ผ่าน LINE Official ได้ตลอด 24ชม.`,
      },
    ],
  },
});
---

<MainLayout title={`ติดต่อทีมงาน ${BRAND_NAME} แอดมินดูแลสมาชิกตลอด 24ชม.`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ติดต่อทีมงาน ${BRAND_NAME}`} as="h1">
    <Picture
      src={lineImage}
      alt="พริตตี้ผมยาวสีน้ำตาลในชุดเลื่อมสีชมพูยืนกอดอกและยิ้ม ฉากหลังเป็นวงกลมสีชมพูเรืองแสง ด้านล่างเป็นป้ายไอคอน LINE สีเขียวพร้อมข้อความว่า LINE Support"
      loading="lazy"
      fetchpriority="low"
      widths={[300, 400, 700]}
      sizes="(max-width: 420px) 100vw, 400px"
      class="mx-auto block h-auto w-full max-w-[400px]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 border-l-4 border-[#ef8dbd] pl-6 text-left text-base leading-relaxed not-italic">
          <p class="mb-1 font-bold opacity-90">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="/register"
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="relative isolate flex items-center justify-center overflow-hidden rounded-lg border border-[#8e0f41] bg-gradient-to-b from-[#c2185b] to-[#8e0f41] px-8 py-3 font-black text-white shadow-[0_8px_22px_rgba(194,24,91,0.35)] transition-transform hover:scale-105">
        <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-white/10 to-transparent"></span>
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="flex items-center justify-center rounded-lg border border-[#ef8dbd] bg-gradient-to-b from-[#fb8cc0] to-[#fa539c] px-8 py-3 font-bold text-[#3b0b26] shadow-[0_4px_14px_rgba(194,24,91,0.2)] transition-all hover:scale-105 hover:shadow-[0_8px_22px_rgba(250,83,156,0.35)]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`ติดต่อทีมงาน ${BRAND_NAME} ผ่าน Line Official`}
        class="flex items-center justify-center gap-2 rounded-lg border border-[#00B900] bg-[#00B900] px-8 py-3 font-bold text-white shadow-[0_10px_30px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
        <span aria-hidden="true" class="text-2xl">💬</span>
        <span>ติดต่อผ่าน Line Official</span>
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
