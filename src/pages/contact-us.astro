---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
import lineImage from "../assets/contact-line.webp";

// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, the LINE image, the address block, the buttons.
// ห้ามเติมหัวข้อย่อยหรือย่อหน้าอธิบายกลับมา — ไม่มีรายการ "ควรเตรียมข้อมูลอะไร
// ก่อนแจ้ง" ไม่มีประโยคเตือนเรื่องรหัสผ่าน/OTP ไม่ว่าคอปปี้นั้นจะเขียนดีแค่ไหน
// ทุกย่อหน้าที่เคยอยู่บนหน้านี้คือของที่รีแบรนด์รอบก่อนๆ คิดขึ้นเอง ไม่ใช่ของบรีฟ
// (รอบนี้ src/assets/content.txt ไม่มีส่วน SUB-PAGES เลย — จบที่บรรทัด 23
// ประโยคกำกับเรื่องรหัสผ่าน/OTP ของบรีฟอยู่บน index.astro ซึ่งเป็นบทความจริง)
//
// The h1 names what the page IS ("ติดต่อทีมงาน <brand>"), not what an article
// on it would have argued. A title that previews a body is the line that tempts
// the next rebrand into writing the body back.
//
// BRAND_ADDRESS สร้างตัวเองจาก BRAND_NAME (ตารางจังหวัดใน src/lib/thaiProvinces.ts)
// และอีเมลมาจาก site: — ห้ามพิมพ์บรรทัดที่อยู่หรืออีเมลเอง ห้ามเพิ่มบรรทัดถนนหรือ
// ลิงก์แผนที่ และห้ามส่งที่อยู่/อีเมลเข้า structured data (address/PostalAddress/
// email ใน JSON-LD ทำให้เกทของ verify-build แดง)
// verify-build เทียบโฮสต์ของอีเมลกับ site: — **ห้ามแก้สตริงนี้ด้วยมือ และห้าม
// พิมพ์โดเมนลงในไฟล์นี้**
// · กล่องจดหมายนี้ตั้งใจไม่ route ไปไหน เป็นการตัดสินใจของเจ้าของ
// ห้ามยกขึ้นมาถามทุกรอบ ห้ามตั้ง mail routing และห้ามลบบรรทัดนี้ออก
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ (brand-spec §3)
// orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์ปัจจุบันไว้แล้ว
// ทุกหน้าเรียกแบบ bare จึงห้ามส่ง prop message จากหน้านี้ ไม่งั้นตัววิ่งจะพูด
// คนละเรื่องกับหน้าอื่น
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตต์รอบนี้อยู่ใน .claude/brand-spec-slot168.md §2
// 🚨🚨 **รอบนี้ยังเป็นธีมมืด แต่คนละฮิวกับรอบก่อนสิ้นเชิง — การ์ดผิวเข้ม หมึกสว่าง**
// bg.json = {"mode":"color","color":"#140000"} = **ดำอมแดงเข้มมาก**
// การ์ด ContentBox จึงเป็นผิว #1c0607 บนหมึก #f0e6e4 (= BRAND_TEXT)
// **ห้าม "แก้" การ์ดกลับไปเป็นผิวสว่างเพราะรอบก่อนเป็นแบบนั้น**
//
// บทบาทสีในไฟล์นี้:
//   แดง #d81115 → #b00d11 → #8a0608 = **พื้นไล่เฉดของปุ่ม PRIMARY**
//     บนหมึก **ขาว #ffffff** (5.2 / 7.2 / 10.0:1 — ผ่านทุกสต็อป)
//     ⚠️⚠️ **ห้ามใช้ #fb2e33 เป็น stop บนของปุ่มนี้** ขาวบน #fb2e33 ได้แค่ 3.8:1
//     #fb2e33 ถือตัวอักษรได้เฉพาะเมื่ออยู่ "บนผิวมืด" (5.1:1 บนการ์ด) ไม่ใช่เมื่อ
//     เป็นพื้นถม
//   ปุ่ม SECONDARY = ไล่เฉดมุกอุ่น #f0e6e4 → #c9b9b7 บนหมึกดำ #0a0a0a
//     (16.2 / 10.5:1) ⚠️ **#c9b9b7 ถือตัวอักษรได้เฉพาะบนผิวมืด ส่วน #7d6f6e
//     ห้ามถือตัวอักษรเลย** เป็นพื้นถม/ขอบเท่านั้น
//   หมึกเนื้อความ #f0e6e4 มาจากการ์ด — ป้ายที่อยู่จึงไม่ประกาศสีตัวอักษรเอง
//     ⚠️ บล็อก <address> **ห้ามมีสีแบรนด์เลยสักค่า** เส้นขอบซ้ายจึงเป็น
//     border-white/20 ซึ่งลงตัวบนการ์ดผิวมืดของทุกแบรนด์ในไลบรารี —
//     รอบก่อนๆ เคยใส่เฮกซ์ของแบรนด์ไว้ตรงนี้ ซึ่งเป็นช่องรั่วที่ทำให้สีเก่าค้างข้ามรอบ
// ขั้วของปุ่มตรงกับ /ทางเข้า /login /register /promotion ซึ่งวางปุ่มคู่นี้บนการ์ด
// ผิวมืดเหมือนกัน: สมัครสมาชิก = PRIMARY ไล่เฉดแดง · เข้าสู่ระบบ = SECONDARY
// ไล่เฉดมุกอุ่น
// ⚠️ **เส้น #551c1e ห้ามถือตัวอักษร** · ผิวจม #0b0000 · ผิวยก #2a0c0d
// ออราในไฟล์นี้ใช้ rgba(251,46,51,α) · rgba(203,11,13,α) · rgba(138,6,8,α) ·
// rgba(240,230,228,α) · rgba(227,214,212,α) · rgba(0,0,0,α) เท่านั้น
// นอกจากสีเขียวของ LINE — #00B900 เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ คงไว้เดิม
// **ห้ามเปลี่ยนเป็นสีของแบรนด์**
//
// ⚠️ กับดักรอบนี้คือ **รอบนี้เป็นแบรนด์แดงจริง** การเจอแดงในไฟล์จึงไม่พิสูจน์ว่า
// เป็นค่าของรอบนี้ ต้องเทียบเป็น "ค่า" ทีละหลักกับตารางใน brand-spec §2 ซึ่งไม่
// พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive
// รอบนี้ **ไม่มีทอง ไม่มีเหลือง ไม่มีน้ำเงิน/ฟ้า ไม่มีน้ำตาล ไม่มีครีม ไม่มีเขียว
// (ยกเว้น LINE green) ไม่มีชมพู/บานเย็น ไม่มีม่วง ไม่มีส้ม และไม่มีโครเมียมเงินเย็น**
// ⚠️⚠️ **ทองคือฮิวนำของแบรนด์ขาออก** การปล่อยทองไว้ = ทั้งผิดพาเลตและหลงเหลือ
// ข้ามแบรนด์พร้อมกัน · มงกุฎทองในโลโก้เป็นรายละเอียด ~2% ของอาร์ตเวิร์ก ไม่ใช่สีแบรนด์
// ⚠️⚠️ **ฮิวนำรอบนี้คือแดงเจล วัสดุที่สองคือมุกอุ่น (R>G>B) ซึ่ง "ถือตัวอักษรได้"
// เมื่ออยู่บนผิวมืด** คาร์ดิแกนแดง เสื้อกล้ามขาว และสีผิวนักแสดงในอาร์ตเวิร์ก
// เป็นวัตถุในภาพ ไม่ใช่สี UI — **ห้ามดึงเข้ามาเป็นสีแบรนด์**
//
// contact-line.webp เป็นอาร์ตสต็อกกลางของเทมเพลต ไม่ใช่อาร์ตเวิร์กของแบรนด์นี้
// และไม่มีชื่อแบรนด์ใดพิมพ์อยู่บนรูป — alt จึงบรรยายรูปจริงตามที่เห็น ห้ามเอ่ย
// ชื่อแบรนด์ในคำบรรยายรูปใบนี้ และห้าม "แก้" คำบรรยายให้เข้ากับธีม นั่นคือ alt ที่
// โกหกรูป (ชุดเลื่อมในภาพเป็นสีชมพู ซึ่งไม่เกี่ยวกับพาเลตรอบนี้เลย แต่มันเป็น
// เนื้อหาของรูป จึงต้องเขียนตามนั้น)
//
// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. Keeping it in a const is what stops the meta tag
// and the structured data from drifting apart. 150–160 CODE POINTS, counted
// with [...s].length exactly like verify-build.mjs — do NOT use `wc -m` on this
// box: git-bash has no UTF-8 locale here, so it counts BYTES and reads ~3x too
// long. This one is 153 with this round's 8-code-point brand name.
//
// คอปปี้ของหน้านี้อนุมานจากบรีฟบรรทัด 15-16 ซึ่งระบุเรื่องที่ติดต่อได้ไว้แค่:
// การเข้าสู่ระบบ รายชื่อค่ายเกม รายการฝากถอน และรายละเอียดโปรโมชั่น กับเจ้าหน้าที่
// ตลอด 24ชม. ผ่านเว็บไซต์ทางการ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง — ห้ามเขียนเกินนี้
// และคำศัพท์ต้องอยู่ใน brand-spec §5 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำของ
// แบรนด์เก่าเจอ false positive
// ⚠️ แกนของบรีฟรอบนี้คือ **เว็บสล็อต** ไม่ใช่หมวดของรอบก่อน ศัพท์ของหมวดอื่นที่
// บรีฟไม่มีทุกคำจึงเป็นของค้างที่ต้องไม่เหลือ — รายการเต็มอยู่ใน brand-spec §5
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อธนาคาร ชื่อวอลเล็ต ชื่อค่ายเกม หรือใบอนุญาตแม้แต่
// รายเดียว** (พูดถึง "ธนาคารและทรูมันนี่" แบบรวมๆ เท่านั้น)
// ⚠️ ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 0.3% · 0.8% · 100% (เฉพาะในวลี
// "ไม่ผ่านเอเย่นต์100%") · 24ชม. ห้ามแต่งเลขใบอนุญาต หน่วยงานกำกับ ตัวเลขการเงิน
// จำนวนเกม/ค่าย หรือจำนวนสมาชิก หน้านี้มีโควตาเป็นรูป ที่อยู่ และปุ่ม
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ติดต่อแอดมิน ${BRAND_NAME} ผ่าน LINE Official ได้ตลอด 24ชม. สอบถามรายชื่อค่ายเกม รายการฝากถอน และรายละเอียดโปรโมชั่น ผ่านช่องทางทางการ เพื่อเลี่ยงบัญชีแอบอ้าง`;

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: `ติดต่อทีมงาน ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    // `alternateName` is only for a genuine alternate NAME — an earlier brand
    // filled it with its own Thai spelling. The brief gives this brand no second
    // registered name, so the field stays out rather than being invented here:
    // this page's Organization node must not disagree with the one every other
    // page emits, and it is not a slot for marketing copy.
    //
    // BRAND_ADDRESS is rendered in the body but never enters the graph —
    // address/PostalAddress/email in JSON-LD fails the build gate.
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: `ติดต่อแอดมิน ${BRAND_NAME} ผ่าน LINE Official ได้ตลอด 24ชม.`,
      },
    ],
  },
});
---

<MainLayout title={`ติดต่อทีมงาน ${BRAND_NAME} แอดมินดูแลสมาชิกตลอด 24ชม.`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ติดต่อทีมงาน ${BRAND_NAME}`} as="h1">
    <Picture
      src={lineImage}
      alt="พริตตี้ผมยาวสีน้ำตาลในชุดเลื่อมสีชมพูยืนกอดอกและยิ้ม ฉากหลังเป็นวงกลมสีชมพูเรืองแสง ด้านล่างเป็นป้ายไอคอน LINE สีเขียวพร้อมข้อความว่า LINE Support"
      loading="lazy"
      fetchpriority="low"
      widths={[300, 400, 700]}
      sizes="(max-width: 420px) 100vw, 400px"
      class="mx-auto block h-auto w-full max-w-[400px]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 border-l-4 border-white/20 pl-6 text-left text-base leading-relaxed not-italic">
          <p class="mb-1 font-bold opacity-90">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="/register"
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="relative isolate flex items-center justify-center overflow-hidden rounded-lg border border-[#8a0608] bg-gradient-to-b from-[#d81115] via-[#b00d11] to-[#8a0608] px-8 py-3 font-black text-white shadow-[0_8px_22px_rgba(203,11,13,0.4)] transition-transform hover:scale-105">
        <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#f0e6e4]/25 to-transparent"></span>
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="flex items-center justify-center rounded-lg border border-[#7d6f6e] bg-gradient-to-b from-[#f0e6e4] to-[#c9b9b7] px-8 py-3 font-bold text-[#0a0a0a] shadow-[0_4px_14px_rgba(0,0,0,0.6)] transition-all hover:scale-105 hover:shadow-[0_8px_22px_rgba(240,230,228,0.35)]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`ติดต่อทีมงาน ${BRAND_NAME} ผ่าน Line Official`}
        class="flex items-center justify-center gap-2 rounded-lg border border-[#00B900] bg-[#00B900] px-8 py-3 font-bold text-white shadow-[0_10px_30px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
        <span aria-hidden="true" class="text-2xl">💬</span>
        <span>ติดต่อผ่าน Line Official</span>
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
