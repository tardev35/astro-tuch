---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
import lineImage from "../assets/contact-line.webp";

// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, the LINE image, the address block, the buttons.
// ห้ามเติมหัวข้อย่อยหรือย่อหน้าอธิบายกลับมา — ไม่มีรายการ "ควรเตรียมข้อมูลอะไร
// ก่อนแจ้ง" ไม่มีประโยคเตือนเรื่องรหัสผ่าน/OTP ไม่ว่าคอปปี้นั้นจะเขียนดีแค่ไหน
// ทุกย่อหน้าที่เคยอยู่บนหน้านี้คือของที่รีแบรนด์รอบก่อนๆ คิดขึ้นเอง ไม่ใช่ของบรีฟ
// (รอบนี้ src/assets/content.txt ไม่มีส่วน SUB-PAGES เลย — จบที่บรรทัด 31
// ประโยคกำกับเรื่องรหัสผ่าน/OTP ของบรีฟอยู่บน index.astro ซึ่งเป็นบทความจริง)
//
// The h1 names what the page IS ("ติดต่อทีมงาน <brand>"), not what an article
// on it would have argued. A title that previews a body is the line that tempts
// the next rebrand into writing the body back.
//
// BRAND_ADDRESS สร้างตัวเองจาก BRAND_NAME (ตารางจังหวัดใน src/lib/thaiProvinces.ts)
// และอีเมลมาจาก site: — ห้ามพิมพ์บรรทัดที่อยู่หรืออีเมลเอง ห้ามเพิ่มบรรทัดถนนหรือ
// ลิงก์แผนที่ และห้ามส่งที่อยู่/อีเมลเข้า structured data (address/PostalAddress/
// email ใน JSON-LD ทำให้เกทของ verify-build แดง)
// verify-build เทียบโฮสต์ของอีเมลกับ site: — **ห้ามแก้สตริงนี้ด้วยมือ และห้าม
// พิมพ์โดเมนลงในไฟล์นี้**
// · กล่องจดหมายนี้ตั้งใจไม่ route ไปไหน เป็นการตัดสินใจของเจ้าของ
// ห้ามยกขึ้นมาถามทุกรอบ ห้ามตั้ง mail routing และห้ามลบบรรทัดนี้ออก
//
// Announcement หมุนมาเป็น `Announcement3.astro` ทั้งเว็บรอบนี้
// (brand-spec §3 — รอบก่อนใช้ตัวฐาน `Announcement.astro` จึงหมุนออก) orchestrator
// ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์ปัจจุบันไว้แล้ว ทุกหน้าเรียก
// แบบ bare จึงห้ามส่ง prop message จากหน้านี้ ไม่งั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตต์รอบนี้อยู่ใน .claude/brand-spec-okkub88.md §2
// 🚨 **รอบนี้ยังเป็นธีมสว่างเหมือนรอบก่อน แต่คนละฮิวสิ้นเชิง**
// bg.json = {"mode":"color","color":"#ffd6fa"} = **ชมพูบับเบิลกัมพาสเทล**
// (รอบก่อนเป็นฟ้าสกายอิ่มตัว — ค่ามาจากไฟล์ ห้ามเดาว่าเท่าเดิม)
// การ์ด ContentBox จึงเป็นผิว #ffffff บนหมึก #6a0f3c (= BRAND_TEXT)
// **ห้าม "แก้" การ์ดกลับไปเป็นผิวมืด** — การ์ดมืดบนหมึกนี้ = ตัวอักษรหายไปเลย
//
// บทบาทสีในไฟล์นี้:
//   ปุ่ม PRIMARY (สมัครสมาชิก) = ไล่เฉดชมพูเข้ม #d91a73 -> #b01160 -> #85094a
//     บนหมึก **ขาว #ffffff** (4.8 / 6.8 / 9.8:1 — ผ่านทุก stop)
//     ⚠️⚠️ **ห้ามใช้ #fb439b หรือ #ffd6fa เป็น stop ของปุ่มที่ถือหมึกขาว**
//     (3.3:1 / 1.2:1 — ตกเกณฑ์ทั้งคู่)
//   ปุ่ม SECONDARY (เข้าสู่ระบบ) = ไล่เฉดขาว #ffffff -> #ffe3f5 บนหมึก #6a0f3c
//     (12.1 / 11.0:1) ขอบ #f479b9 เป็นตัวแยกปุ่มออกจากผิวการ์ดขาว
//   หมึกเนื้อความ #6a0f3c มาจากการ์ด — ป้ายที่อยู่จึงไม่ประกาศสีตัวอักษรเอง
//     ⚠️ บล็อก <address> **ห้ามมีสีแบรนด์เป็นสีตัวอักษรเลยสักค่า** เส้นขอบซ้าย
//     ใช้ #f479b9 ซึ่งเป็น "เส้นเข้ม" ของพาเลตรอบนี้ — รอบก่อนใช้ 4fb8ea
//     (ฟ้า เขียนไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep หาสีแบรนด์เก่าสะดุดที่
//     คอมเมนต์ของไฟล์นี้เอง) ซึ่งรอบนี้หายไปทั้งค่า
// ขั้วของปุ่มตรงกับ /ทางเข้า /login /register /promotion ซึ่งวางปุ่มคู่นี้บนการ์ด
// ผิวขาวเหมือนกัน: สมัครสมาชิก = PRIMARY ไล่เฉดชมพูเข้ม · เข้าสู่ระบบ =
// SECONDARY ไล่เฉดขาว-ชมพูอ่อน
// ออราในไฟล์นี้ใช้ rgba(156,15,85,α) · rgba(251,67,155,α) · rgba(106,15,60,α) ·
// rgba(255,194,226,α) · rgba(249,178,217,α) เท่านั้น
// นอกจากสีเขียวของ LINE — #00B900 เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ คงไว้เดิม
// **ห้ามเปลี่ยนเป็นสีของแบรนด์** และบนผิวขาวต้องเป็นพื้นถม bg-[#00B900] + หมึกขาว
// ไม่ใช่ตัวอักษรสีเขียวบนพื้นขาว
//
// ⚠️⚠️ กับดักรอบนี้คือ **รอบนี้เป็นแบรนด์ชมพูจริง และชมพูก็เป็นฮิวของแบรนด์เมื่อ
// สองรอบก่อนด้วย** การเจอชมพูในไฟล์จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้ ต้องเทียบเป็น
// "ค่า" ทีละหลักกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep
// หาสีของแบรนด์เก่าเจอ false positive
// รอบนี้ **ไม่มีฟ้า/ไซแอน/น้ำเงิน (ฮิวของแบรนด์ขาออกทันที) ไม่มีทอง ไม่มีเหลือง
// ไม่มีแดง ไม่มีม่วง ไม่มีส้ม ไม่มีครีม/เบจ ไม่มีเทาเงิน และไม่มีเขียว
// (ยกเว้น LINE green)**
// ⚠️⚠️ **ฟ้าสกายคือฮิวนำของแบรนด์ขาออก** การปล่อยฟ้าไว้ = ทั้งผิดพาเลตและหลงเหลือ
// ข้ามแบรนด์พร้อมกัน
// ⚠️⚠️ **หมูการ์ตูนชมพู เหรียญทอง กล่องของขวัญ ฉากสตูดิโอขาว และสีผิวนักแสดงใน
// อาร์ตเวิร์กเป็นวัตถุในภาพ ไม่ใช่สี UI** — พื้นเพจมาจาก bg.json เท่านั้น
//
// contact-line.webp เป็นอาร์ตสต็อกกลางของเทมเพลต ไม่ใช่อาร์ตเวิร์กของแบรนด์นี้
// และไม่มีชื่อแบรนด์ใดพิมพ์อยู่บนรูป — alt จึงบรรยายรูปจริงตามที่เห็น ห้ามเอ่ย
// ชื่อแบรนด์ในคำบรรยายรูปใบนี้ และห้าม "แก้" คำบรรยายให้เข้ากับธีม นั่นคือ alt ที่
// โกหกรูป (ตรวจรูปจริงรอบนี้แล้ว ชุดเลื่อมในภาพเป็น **สีชมพู** จริง — บังเอิญตรง
// ตระกูลกับพาเลตรอบนี้ แต่ที่มาคนละทาง: มันคือ "เนื้อหาของรูป" ไม่ใช่สีแบรนด์
// รอบหน้าที่ไม่ใช่แบรนด์ชมพู **ห้ามแก้บรรทัดนี้ให้เป็นสีของแบรนด์นั้น**)
//
// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. Keeping it in a const is what stops the meta tag
// and the structured data from drifting apart. 150–160 CODE POINTS, counted
// with [...s].length exactly like verify-build.mjs — do NOT use `wc -m` on this
// box: git-bash has no UTF-8 locale here, so it counts BYTES and reads ~3x too
// long. This one is 156 with this round's 7-code-point brand name (last round's
// was 10, so the length must be recounted every rebrand, never inherited).
//
// คอปปี้ของหน้านี้อนุมานจากบรีฟบรรทัด 23-24 ซึ่งระบุเรื่องที่ติดต่อได้ไว้แค่:
// การสมัครสมาชิก การเข้าสู่ระบบ โปรโมชั่นสมาชิกใหม่ และรายการฝากถอน กับ
// เจ้าหน้าที่ตลอด 24ชม. ผ่านเว็บไซต์ทางการ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง —
// ห้ามเขียนเกินนี้ และคำศัพท์ต้องอยู่ใน brand-spec §5 ซึ่งไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาคำของแบรนด์เก่าเจอ false positive
// ⚠️ แกนของบรีฟรอบนี้คือ **เว็บสล็อตเงินดี ทางเข้าเล่นง่าย ยูสใหม่แตกไว
// โบนัสแจกทั้งวันไม่จำกัด** ศัพท์ของแบรนด์ก่อนทุกคำจึงเป็นของค้างที่ต้องไม่เหลือ —
// รายการเต็มอยู่ใน brand-spec §5
// 🚨 **ช่องทางวอลเล็ตของบรีฟรอบนี้คือ "ทรูวอลเลท" เท่านั้น** (content.txt บรรทัด
// 21-22, 30-31) คำของรอบก่อนเป็นคนละคำและเป็นจุดที่พลาดง่ายที่สุดของรอบนี้ —
// หน้านี้ไม่เอ่ยถึงช่องทางฝากถอนเลย จึงไม่มีช่องให้พลาด
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อธนาคาร ชื่อวอลเล็ต ชื่อค่ายเกม หรือใบอนุญาตแม้แต่
// รายเดียว** (พูดถึง "ทุกธนาคารและทรูวอลเลท" แบบรวมๆ เท่านั้น)
// ⚠️ ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 0.3% · 0.8% · 3 ขั้นตอน · 24ชม. ห้ามแต่งเลข
// ใบอนุญาต หน่วยงานกำกับ ตัวเลขการเงิน ค่าอัตราคืนรางวัล จำนวนเกม/ค่าย หรือจำนวน
// สมาชิก — ตัวเลขที่ห้ามทั้งชุดอยู่ใน brand-spec §5
// หน้านี้มีโควตาเป็นรูป ที่อยู่ และปุ่ม
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ติดต่อทีมงาน ${BRAND_NAME} ผ่าน LINE Official ได้ตลอด 24ชม. สอบถามการสมัครสมาชิก เข้าสู่ระบบ รายการฝากถอน และเงื่อนไขโปรโมชั่นผ่านช่องทางทางการ เลี่ยงบัญชีแอบอ้าง`;

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: `ติดต่อทีมงาน ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    // `alternateName` is only for a genuine alternate NAME — an earlier brand
    // filled it with its own Thai spelling. The brief gives this brand no second
    // registered name, so the field stays out rather than being invented here:
    // this page's Organization node must not disagree with the one every other
    // page emits, and it is not a slot for marketing copy.
    //
    // BRAND_ADDRESS is rendered in the body but never enters the graph —
    // address/PostalAddress/email in JSON-LD fails the build gate.
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: `ติดต่อแอดมิน ${BRAND_NAME} ผ่าน LINE Official ได้ตลอด 24ชม.`,
      },
    ],
  },
});
---

<MainLayout title={`ติดต่อทีมงาน ${BRAND_NAME} แอดมินดูแลสมาชิกตลอด 24ชม.`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ติดต่อทีมงาน ${BRAND_NAME}`} as="h1">
    <Picture
      src={lineImage}
      alt="พริตตี้ผมยาวสีน้ำตาลในชุดเลื่อมสีชมพูยืนกอดอกและยิ้ม ฉากหลังเป็นวงกลมสีชมพูเรืองแสง ด้านล่างเป็นป้ายไอคอน LINE สีเขียวพร้อมข้อความว่า LINE Support"
      loading="lazy"
      fetchpriority="low"
      widths={[300, 400, 700]}
      sizes="(max-width: 420px) 100vw, 400px"
      class="mx-auto block h-auto w-full max-w-[400px]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 border-l-4 border-[#f479b9] pl-6 text-left text-base leading-relaxed not-italic">
          <p class="mb-1 flex items-center gap-2 font-bold opacity-90">
            <span aria-hidden="true">📍</span>
            {BRAND_ADDRESS.label}
          </p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="/register"
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="relative isolate flex items-center justify-center overflow-hidden rounded-lg border border-[#85094a] bg-gradient-to-b from-[#d91a73] via-[#b01160] to-[#85094a] px-8 py-3 font-black text-white shadow-[0_8px_22px_rgba(156,15,85,0.35)] transition-transform hover:scale-105">
        <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-white/10 to-transparent"></span>
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="flex items-center justify-center rounded-lg border-2 border-[#f479b9] bg-gradient-to-b from-[#ffffff] to-[#ffe3f5] px-8 py-3 font-bold text-[#6a0f3c] shadow-[0_4px_14px_rgba(156,15,85,0.18)] transition-all hover:scale-105 hover:border-[#fb439b] hover:shadow-[0_8px_22px_rgba(251,67,155,0.3)]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`ติดต่อทีมงาน ${BRAND_NAME} ผ่าน Line Official`}
        class="flex items-center justify-center gap-2 rounded-lg border border-[#00B900] bg-[#00B900] px-8 py-3 font-bold text-white shadow-[0_10px_30px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
        <span aria-hidden="true" class="text-2xl">💬</span>
        <span>ติดต่อผ่าน Line Official</span>
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
