---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
import lineImage from "../assets/contact-line.webp";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, the LINE image, the address block, the buttons.
// Do not re-add section headings or explanatory prose here — no "เตรียมข้อมูล
// อะไรก่อนแจ้ง" list, no PIN/OTP notice, however well it reads. Every one of
// those was invented by an earlier rebrand, not by the brief. h1×1, h2×0, h3×0
//
// The <h1> names what the page IS ("ติดต่อทีมงาน <brand>"), not what an article
// on it would have argued. A title that previews a body is the line that tempts
// the next rebrand into writing the body back.
//
// BRAND_ADDRESS derives itself from BRAND_NAME — never retype the lines or the
// email, and never pass either into the structured data.
//
// Announcement หมุนมาเป็น AnnouncementPremium ทั้งเว็บรอบนี้ (รอบก่อนเป็น
// Announcement3) — default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์ปัจจุบันแล้ว
// และทุกหน้าเรียกแบบ bare จึงห้ามส่ง prop message จากหน้านี้ ไม่งั้นตัววิ่งจะไม่ตรงกัน
//
// KOON234 (รอบมรกตเข้ม-ทองบนเขียวเกือบดำ 2026-10-09, brand-spec §2):
// รอบนี้พลิกจากคู่ฟ้าสด-เหลืองมะนาวของแบรนด์ก่อนหน้า มาเป็นคู่ **มรกต-ทอง** —
// โลโก้เป็นคำว่า KOON เงินโครเมียมขอบเขียวเข้ม กับเลข 234 ทองไล่เงาวาว คร่อม
// วงแหวนเขียว-ทอง งานศิลป์เป็นห้องรับรองโทนเขียวมรกตเข้ม ริบบิ้นทองพลิ้ว และ
// bg.json เป็น {"mode":"color","color":"#061801"} = เขียวเกือบดำ
// ทองแบรนด์ #cc920a · ทองสว่าง #f7d14e · ทองซีด #fde9a6 · ทองเข้ม #8a6204 ·
// เขียวสว่าง #2fbf6a · เขียวมรกต #0a6b32 · เขียวเข้ม #043d1c ·
// ผิวการ์ดยก #0d2414 · ผิวกลาง #09190d · ผิวลึก #051007 · หมึกบนพื้นสว่าง #07170c
// เนื้อความ #e8f2e6 (= BRAND_TEXT ที่การ์ด ContentBox ตั้งให้แล้ว จึงไม่ประกาศสี
// ที่ย่อหน้าหรือที่บล็อกที่อยู่)
//
// ลำดับปุ่มใช้สองฮิวแยกกันจริง: สมัครสมาชิกเป็น PRIMARY ถมทองไล่เฉด
// #fde9a6 → #f7d14e → #cc920a ขอบทองเข้ม #8a6204 บนหมึกเข้ม #07170c
// (#07170c บน #f7d14e ≈ 11.8:1) · เข้าสู่ระบบเป็น SECONDARY ผิวเขียวเข้ม
// #09190d → #051007 ขอบทอง #cc920a/55 บนตัวอักษรทองสว่าง #f7d14e
// ⚠️ **ห้ามกลับด้าน** (สเปก §2): พื้นถมทองต้องใช้หมึกเข้มเสมอ ห้ามขาวหรือครีม
// เพราะขาวบนทองลงไปอยู่ราว 1.3:1 อ่านไม่ออก
// ชุดฟ้า-เหลืองของแบรนด์ก่อนออกครบแล้ว ทั้งคลาส Tailwind raw hex และ rgba()
// (ค่าเดิมอยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ
// false positive)
// ส่วน #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ตามเดิม
//
// ป้ายที่อยู่ไม่ประกาศสีตัวอักษรเลย ให้สืบทอดจากการ์ด สีแบรนด์มีเฉพาะบนเส้นขอบ
// ซึ่งเป็นเส้นตกแต่ง ไม่ใช่ body copy
//
// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. Keeping it in a const is what stops the meta tag
// and the structured data from drifting apart. 150–160 CODE POINTS, counted
// with [...s].length exactly like verify-build.mjs — do NOT use `wc -m` on this
// box: git-bash has no UTF-8 locale here, so it counts BYTES and reads ~3x too
// long. This one is 158.
//
// แบรนด์นี้เป็น **เว็บพนันออนไลน์รวมช่องทางเข้าเล่น** ไม่ใช่เว็บหวยและไม่ใช่เว็บ
// เกมค่ายเดียว คำหมวดเกมและคำหมวดลอตเตอรีของแบรนด์ก่อนๆ ห้ามหลงเหลือ — รายการ
// คำต้องห้ามเต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำของแบรนด์
// เก่าเจอ false positive ในคอมเมนต์
// บรีฟบรรทัด 18–19 ระบุเรื่องที่แอดมินช่วยได้ไว้แค่: การสมัครสมาชิก การเข้าสู่ระบบ
// โปรโมชั่น และปัญหาการใช้งาน (โบนัสไม่แสดง รายการไม่อัปเดต เข้าสู่ระบบไม่ได้)
// — ห้ามเขียนเกินนี้ ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 0.3% / 0.8% / 3 ขั้นตอน /
// 24 ชั่วโมง / 100%
// ห้ามแต่งชื่อธนาคาร เลขใบอนุญาต หน่วยงานกำกับ ชื่อค่ายเกม ค่า RTP ยอดฝากขั้นต่ำ
// จำนวนสมาชิก หรือปีก่อตั้ง
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ติดต่อแอดมิน ${BRAND_NAME} ได้ตลอด 24 ชั่วโมง สอบถามการสมัครสมาชิก การเข้าสู่ระบบ โปรโมชั่น และปัญหาการใช้งาน แจ้งรายละเอียดรายการที่ต้องการให้เจ้าหน้าที่ตรวจสอบได้`;

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: `ติดต่อทีมงาน ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    // `alternateName` is only for a genuine alternate NAME — an earlier brand
    // filled it with its own Thai spelling. The brief gives this brand no second
    // registered name, so the field stays out rather than being invented here:
    // this page's Organization node must not disagree with the one every other
    // page emits, and it is not a slot for marketing copy.
    //
    // BRAND_ADDRESS is rendered in the body but never enters the graph —
    // address/PostalAddress/email in JSON-LD fails the build gate.
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: `ติดต่อแอดมิน ${BRAND_NAME} ผ่านช่องทางไลน์ได้ตลอด 24 ชั่วโมง`,
      },
    ],
  },
});
---

<MainLayout title={`ติดต่อทีมงาน ${BRAND_NAME} แอดมินดูแลสมาชิกผ่านไลน์ตลอด 24 ชั่วโมง`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ติดต่อทีมงาน ${BRAND_NAME}`} as="h1">
    <Picture
      src={lineImage}
      alt="พริตตี้ผมยาวสีน้ำตาลในชุดเลื่อมสีชมพูยืนกอดอกและยิ้ม ฉากหลังเป็นวงกลมสีชมพูเรืองแสง ด้านล่างเป็นป้ายไอคอน LINE สีเขียวพร้อมข้อความว่า LINE Support"
      loading="lazy"
      fetchpriority="low"
      widths={[300, 400, 700]}
      sizes="(max-width: 420px) 100vw, 400px"
      class="mx-auto block h-auto w-full max-w-[400px]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 border-l-4 border-[#cc920a] pl-6 text-left text-base leading-relaxed not-italic">
          <p class="mb-1 font-bold opacity-90">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="/register"
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="flex items-center justify-center rounded-lg border border-[#8a6204] bg-gradient-to-b from-[#fde9a6] via-[#f7d14e] to-[#cc920a] px-8 py-3 font-black text-[#07170c] shadow-[0_0_14px_rgba(204,146,10,0.45)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="flex items-center justify-center rounded-lg border border-[#cc920a]/55 bg-gradient-to-b from-[#09190d] to-[#051007] px-8 py-3 font-bold text-[#f7d14e] shadow-[0_0_12px_rgba(204,146,10,0.22)] transition-all hover:scale-105 hover:border-[#f7d14e] hover:shadow-[0_0_18px_rgba(247,209,78,0.38)]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`ติดต่อทีมงาน ${BRAND_NAME} ผ่าน Line Official`}
        class="flex items-center justify-center gap-2 rounded-lg border border-[#00B900] bg-[#00B900] px-8 py-3 font-bold text-white shadow-[0_10px_30px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
        <span aria-hidden="true" class="text-2xl">💬</span>
        <span>ติดต่อผ่าน Line Official</span>
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
