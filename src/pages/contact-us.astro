---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS } from "../lib/brandProfile";
import lineImage from "../assets/contact-line.webp";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, the LINE image, the address block, the buttons.
// Do not re-add section headings or explanatory prose here — no "เตรียมข้อมูล
// อะไรก่อนแจ้ง" list, no PIN/OTP notice, however well it reads. Every one of
// those was invented by an earlier rebrand, not by the brief. h1×1, h2×0, h3×0
//
// BRAND_ADDRESS derives itself from BRAND_NAME — never retype the lines or the
// email, and never pass either into the structured data.
//
// Announcement หมุนมาเป็น Announcement3 ทั้งเว็บรอบนี้ — orchestrator ตั้ง default
// message ของไฟล์นั้นเป็นคอปปี้ของ GOT777 แล้ว และ index ก็เรียกแบบ bare จึงห้ามส่ง
// prop message จากหน้านี้ ไม่งั้นสองหน้าจะพูดไม่ตรงกัน
//
// พาเลตต์ GOT777 เป็น "ทองนำ แดงเลือดหมูรอง บนพื้นเกือบดำ" ตามโลโก้ตัวอักษร GOT ทอง
// กับเลข 777 แดง และแบนเนอร์พื้นดำ-ทองที่มีชิปคาสิโนแดงดำกับเหรียญทอง:
// เนื้อความ #ece0cb (BRAND_TEXT) · ทองนำ #f5c518 · ทองอ่อน #ffe9a8 · ทองลึก #96690f ·
// แดงรอง #d21622 · แดงลึก #7b0304 · แดงเข้มสุด #4c0301 · พื้นเพจ #0a0503 ·
// ผิวการ์ด #160b06 · ผิวการ์ดยก #241108 · เน้นใน strong #fff6dd
// ปุ่มหลัก (สมัครสมาชิก) รับไล่เฉดทองเต็มใบ #ffe9a8 → #f5c518 → #96690f และตัวอักษร
// ต้องเป็นหมึกเข้ม #0a0503 — ทองเป็นสีสว่าง ตัวอักษรขาวบนทองตกคอนทราสต์ทันที
// ปุ่มรอง (เข้าสู่ระบบ) เป็นแบบ outline — กรอบแดงรอง #d21622 บนผิว #241108 ตัวอักษร
// ทองอ่อน #ffe9a8 ไม่ใช่ถมทองอีกใบ เพราะสองปุ่มถมทองเหมือนกันจะอ่านเป็นก้อนเดียว
// ลำดับความสำคัญรอบนี้จึงสื่อด้วย "ถมทอง vs กรอบแดง" ซึ่งใช้ทั้งสองสีของแบรนด์พอดี
// ส่วน #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ตามเดิม
// ชุดแดง-ทองของ LOTTOPLUS (#dc020e #ff2d38 #6b0207 #a80710 #f3c623 #fde79a #8a6a0a
// #f0e2e2 #fff4f4 #120b0c #1f0a0c #2a0d0f #3a1114 rgba(220,2,14,*) rgba(243,198,35,*)
// rgba(5,1,2,*)) ถูกแทนครบทุกจุดแล้ว
//
// ป้ายที่อยู่ใช้ opacity ไม่ใช่คลาสสี ให้สืบทอดสีตัวอักษรจากการ์ด ส่วนสีแบรนด์มีเฉพาะ
// บนเส้นขอบและลิงก์อีเมล ซึ่งเป็น accent ไม่ใช่ body copy
//
// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. Keeping it in a const is what stops the meta tag
// and the structured data from drifting apart — they used to be two hand-typed
// variants of the same sentence, and the JSON-LD copy was the one nobody
// reread. 150–160 CHARACTERS (Thai is 3 bytes/char, so a byte count reads ~3x
// too long and will send you rewriting a description that was fine).
// This one is 159.
//
// GOT777 เป็นเว็บเกมสล็อตออนไลน์ ไม่ใช่เว็บหวย บรีฟยกหัวข้อไว้ว่า "ติดต่อสอบถามแอดมิน
// GOT777 ผู้ให้บริการได้ 24 ชั่วโมง" และระบุเรื่องที่ทีมงานช่วยได้ไว้แค่ สมัคร/Login
// ไม่ได้ เข้าเกมสล็อตไม่ได้ เครดิตไม่เข้า รายการถอนอยู่ระหว่างตรวจสอบ และโปรโมชั่น
// ไม่แสดง — ห้ามเขียนเกินนี้ ห้ามเอ่ยชื่อธนาคาร เลขใบอนุญาต ยอดฝากขั้นต่ำ RTP หรือ
// ชื่อค่ายเกม และคำศัพท์ตระกูลหวยของแบรนด์ก่อน (หวย โพย แทงหวย ส่งโพย งวด อัตราจ่าย
// 2 ตัว 3 ตัว รัฐบาลไทย ลาวพัฒนา ฮานอย หวยหุ้น เลขเด็ด) ห้ามหลงเหลือ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "ช่องทางติดต่อแอดมิน GOT777 ผ่านไลน์ได้ตลอด 24 ชั่วโมง สอบถามเรื่องการสมัคร เข้าเกมสล็อตไม่ได้ เครดิตไม่เข้า รายการถอน หรือโปรโมชั่นไม่แสดง ให้ทีมงานช่วยตรวจสอบ";

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: "ติดต่อทีมงาน GOT777",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    // `alternateName` is only for a genuine alternate NAME — an earlier brand
    // filled it with its own Thai spelling. The brief gives GOT777 no second
    // registered name, so the field stays out rather than being invented here:
    // this page's Organization node must not disagree with the one every other
    // page emits, and it is not a slot for marketing copy.
    //
    // BRAND_ADDRESS is rendered in the body but never enters the graph —
    // address/PostalAddress/email in JSON-LD fails the build gate.
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: "ติดต่อแอดมิน GOT777 ผ่านช่องทางไลน์ได้ตลอด 24 ชั่วโมง",
      },
    ],
  },
});
---

<MainLayout title="ติดต่อทีมงาน GOT777 แอดมินเว็บเกมสล็อตดูแลผ่านไลน์ตลอด 24 ชั่วโมง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน GOT777" as="h1">
    <Picture
      src={lineImage}
      alt="พริตตี้ผมยาวสีน้ำตาลในชุดเลื่อมสีชมพูยืนกอดอกและยิ้ม ฉากหลังเป็นวงกลมสีชมพูเรืองแสง ด้านล่างเป็นป้ายไอคอน LINE สีเขียวพร้อมข้อความว่า LINE Support"
      loading="lazy"
      fetchpriority="low"
      widths={[300, 400, 700]}
      sizes="(max-width: 420px) 100vw, 400px"
      class="mx-auto block h-auto w-full max-w-[400px]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 border-l-4 border-[#f5c518] pl-6 text-left text-base leading-relaxed not-italic">
          <p class="mb-1 font-bold opacity-90">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold text-[#f5c518] underline decoration-current/40 underline-offset-4 transition-colors hover:text-[#ffe9a8]">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก GOT777"
        class="flex items-center justify-center rounded-lg border border-[#ffe9a8]/70 bg-gradient-to-r from-[#ffe9a8] via-[#f5c518] to-[#96690f] px-8 py-3 font-black text-[#0a0503] shadow-[0_0_15px_rgba(245,197,24,0.45)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ GOT777"
        class="flex items-center justify-center rounded-lg border border-[#d21622] bg-[#241108] px-8 py-3 font-bold text-[#ffe9a8] shadow-[0_0_15px_rgba(10,5,3,0.75)] transition-all hover:scale-105 hover:border-[#f5c518] hover:bg-[#4c0301] hover:text-[#fff6dd] hover:shadow-[0_0_18px_rgba(210,22,34,0.40)]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อทีมงาน GOT777 ผ่าน Line Official"
        class="flex items-center justify-center gap-2 rounded-lg border border-[#00B900]/70 bg-gradient-to-r from-[#00B900] to-[#009900] px-8 py-3 font-bold text-white shadow-[0_10px_30px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
        <span aria-hidden="true" class="text-2xl">💬</span>
        <span>ติดต่อผ่าน Line Official</span>
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
