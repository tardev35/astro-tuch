---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS } from "../lib/brandProfile";
import lineImage from "../assets/contact-line.webp";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, the LINE image, the address block, the buttons.
// Do not re-add section headings or explanatory prose here — no "เตรียมข้อมูล
// อะไรก่อนแจ้ง" list, no PIN/OTP notice, however well it reads. Every one of
// those was invented by an earlier rebrand, not by the brief. h1×1, h2×0, h3×0
//
// BRAND_ADDRESS derives itself from BRAND_NAME — never retype the lines or the
// email, and never pass either into the structured data.
//
// Announcement หมุนมาเป็น Announcement2 ทั้งเว็บรอบนี้ (รอบก่อน หวยเฮง24 ใช้
// Announcement5) — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ
// หวยเฮง789 แล้ว และ index ก็เรียกแบบ bare จึงห้ามส่ง prop message จากหน้านี้
// ไม่งั้นสองหน้าจะพูดไม่ตรงกัน
//
// พาเลตต์ หวยเฮง789 รอบนี้เป็น "แดงนำ ทองรอง" กลับขั้วกับรอบก่อน (หวยเฮง24 ทองนำ)
// ตามโลโก้ที่ vivid เด่นเป็นแดงเลือดนก ส่วนทองอยู่ที่ตัวอักษรและเหรียญ:
// เนื้อความ #fbe3d4 (BRAND_TEXT) · ทองอ่อน #ffefc2 · ทองรอง #f4bc5d ·
// ทองเข้ม #d99a10 · ทองมืดสุด #a8690c (ขอบ/เส้นคั่นเท่านั้น) · แดงสว่าง #e43434 ·
// แดงแบรนด์ #dc2224 · แดงลึก #ab0204 · แดงมืดสุด #5c0a0a · ผิวการ์ด #2b0909 ·
// ผิวฐาน #1c0606 · ผิวลึกสุด #0b0202 · หมึกบนพื้นทอง #1c0606
// ปุ่มหลัก (สมัครสมาชิก) รับไล่เฉดทองเต็มใบ #ffefc2 → #f4bc5d → #d99a10 และตัวอักษร
// ต้องเป็นหมึกเข้ม #1c0606 — ไล่เฉดใต้หมึกเข้มห้ามจบเข้มกว่า #d99a10 (7.0:1)
// ปุ่มรอง (เข้าสู่ระบบ) เป็นแบบ outline — กรอบแดงลึก #ab0204 บนผิวการ์ด #2b0909
// ตัวอักษรทอง #f4bc5d ไม่ใช่ถมทองอีกใบ เพราะสองปุ่มถมทองเหมือนกันจะอ่านเป็นก้อนเดียว
// ลำดับความสำคัญรอบนี้จึงสื่อด้วย "ถมทอง vs กรอบแดง"
// ห้ามใช้หมึกเข้มบนแดงแบรนด์ #dc2224 (3.4:1) พื้นแดงรับตัวอักษรขาวเท่านั้น
// ส่วน #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ตามเดิม
// ชุดทองนำของ หวยเฮง24 (#e0a52a #fdea83 #fbdc64 #bd7c13 #2a0606 #1a0505 #f6e6cf
// #e6c98f #8b0302 #c01616 #5a0202 #3d0808 #2e0707 rgba(224,165,42,*)
// rgba(251,220,100,*) rgba(253,234,131,*) rgba(192,22,22,*) rgba(20,3,3,*))
// ถูกแทนครบทุกจุดแล้ว
//
// ป้ายที่อยู่ใช้ opacity ไม่ใช่คลาสสี ให้สืบทอดสีตัวอักษรจากการ์ด ส่วนสีแบรนด์มีเฉพาะ
// บนเส้นขอบและลิงก์อีเมล ซึ่งเป็น accent ไม่ใช่ body copy
//
// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. Keeping it in a const is what stops the meta tag
// and the structured data from drifting apart — they used to be two hand-typed
// variants of the same sentence, and the JSON-LD copy was the one nobody
// reread. 150–160 CHARACTERS (Thai is 3 bytes/char, so a byte count reads ~3x
// too long and will send you rewriting a description that was fine).
// This one is 157.
//
// หวยเฮง789 เป็นเว็บแทงหวยออนไลน์ ไม่ใช่บอลและไม่ใช่สล็อต บรีฟยกหัวข้อไว้ว่า
// "ติดต่อแอดมินเว็บ หวยเฮง789 ได้ ตลอด 24 ชั่วโมง" และระบุเรื่องที่ทีมงานช่วยได้ไว้แค่
// สมัคร/Login ไม่ได้ ส่งโพยไม่สำเร็จ รายการไม่แสดง และข้อสงสัยเรื่องรอบหวย อัตราจ่าย
// กับวงเงิน — ห้ามเขียนเกินนี้ ห้ามเอ่ยชื่อธนาคาร เลขใบอนุญาต ยอดฝากขั้นต่ำ หรือ
// ชื่อผู้ให้บริการจริง และคำศัพท์ของแบรนด์ก่อนหน้า (สล็อต ฟรีสปิน ตัวคูณ ค่ายเกม RTP
// แตกง่าย เว็บตรง บอล ค่าน้ำ อัตราต่อรอง ลีก บิลสเต็ป แฮนดิแคป คาสิโน บาคาร่า ไพ่
// เกมยิงปลา) ห้ามหลงเหลือ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "ช่องทางติดต่อแอดมิน หวยเฮง789 ได้ตลอด 24 ชั่วโมง สอบถามเรื่องสมัครสมาชิก เข้าสู่ระบบไม่ได้ ส่งโพยไม่สำเร็จ รายการไม่แสดง รอบหวย อัตราจ่าย และวงเงินที่เปิดรับ";

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: "ติดต่อทีมงาน หวยเฮง789",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    // `alternateName` is only for a genuine alternate NAME — an earlier brand
    // filled it with its own Thai spelling. The brief gives หวยเฮง789 no second
    // registered name, so the field stays out rather than being invented here:
    // this page's Organization node must not disagree with the one every other
    // page emits, and it is not a slot for marketing copy.
    //
    // BRAND_ADDRESS is rendered in the body but never enters the graph —
    // address/PostalAddress/email in JSON-LD fails the build gate.
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: "ติดต่อแอดมิน หวยเฮง789 ผ่านช่องทางไลน์ได้ตลอด 24 ชั่วโมง",
      },
    ],
  },
});
---

<MainLayout title="ติดต่อทีมงาน หวยเฮง789 แอดมินเว็บแทงหวยดูแลผ่านไลน์ตลอด 24 ชั่วโมง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน หวยเฮง789" as="h1">
    <Picture
      src={lineImage}
      alt="พริตตี้ผมยาวสีน้ำตาลในชุดเลื่อมสีชมพูยืนกอดอกและยิ้ม ฉากหลังเป็นวงกลมสีชมพูเรืองแสง ด้านล่างเป็นป้ายไอคอน LINE สีเขียวพร้อมข้อความว่า LINE Support"
      loading="lazy"
      fetchpriority="low"
      widths={[300, 400, 700]}
      sizes="(max-width: 420px) 100vw, 400px"
      class="mx-auto block h-auto w-full max-w-[400px]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 border-l-4 border-[#dc2224] pl-6 text-left text-base leading-relaxed not-italic">
          <p class="mb-1 font-bold opacity-90">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold text-[#f4bc5d] underline decoration-current/40 underline-offset-4 transition-colors hover:text-[#ffefc2]">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก หวยเฮง789"
        class="flex items-center justify-center rounded-lg border border-[#a8690c]/70 bg-gradient-to-r from-[#ffefc2] via-[#f4bc5d] to-[#d99a10] px-8 py-3 font-black text-[#1c0606] shadow-[0_0_15px_rgba(244,188,93,0.45)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ หวยเฮง789"
        class="flex items-center justify-center rounded-lg border border-[#ab0204] bg-[#2b0909] px-8 py-3 font-bold text-[#f4bc5d] shadow-[0_0_15px_rgba(11,2,2,0.85)] transition-all hover:scale-105 hover:border-[#e43434] hover:bg-[#5c0a0a] hover:text-[#ffefc2] hover:shadow-[0_0_18px_rgba(220,34,36,0.35)]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อทีมงาน หวยเฮง789 ผ่าน Line Official"
        class="flex items-center justify-center gap-2 rounded-lg border border-[#00B900]/70 bg-gradient-to-r from-[#00B900] to-[#009900] px-8 py-3 font-bold text-white shadow-[0_10px_30px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
        <span aria-hidden="true" class="text-2xl">💬</span>
        <span>ติดต่อผ่าน Line Official</span>
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
