---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
import lineImage from "../assets/contact-line.webp";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, the LINE image, the address block, the buttons.
// Do not re-add section headings or explanatory prose here — no "เตรียมข้อมูล
// อะไรก่อนแจ้ง" list, no PIN/OTP notice, however well it reads. Every one of
// those was invented by an earlier rebrand, not by the brief. h1×1, h2×0, h3×0
//
// The <h1> names what the page IS ("ติดต่อทีมงาน <brand>"), not what an article
// on it would have argued. A title that previews a body is the line that tempts
// the next rebrand into writing the body back.
//
// BRAND_ADDRESS derives itself from BRAND_NAME — never retype the lines or the
// email, and never pass either into the structured data.
//
// Announcement หมุนมาเป็น Announcement3 ทั้งเว็บรอบนี้ — default message ของไฟล์
// นั้นเป็นคอปปี้ของแบรนด์ปัจจุบันแล้ว และ index ก็เรียกแบบ bare จึงห้ามส่ง prop
// message จากหน้านี้ ไม่งั้นสองหน้าจะพูดไม่ตรงกัน
//
// พาเลตต์รอบนี้ (brand-spec §3) เป็นชุดตรุษจีน **สามสี: แดงนำ เขียวมรกตรอง
// ทองเป็นโลหะคั่น** บนผิวเกือบดำอมแดง — โลโก้เป็นเทพเจ้าโชคลาภสวมหมวกเขียว-แดง
// กับตัวอักษร GUCCI ขาวเงินขอบเขียวทับเลข 168 แดงขอบทอง แบนเนอร์เป็นซุ้มจีนเขียว
// โคมแดง เหรียญทอง และชิปแดง-ขาว ส่วน bg.json เป็นไล่เฉดแดงเลือดหมู → ทองเข้ม
// แดงแบรนด์ #c41115 · แดงสว่าง #e0201f · แดงลึก #7a0505 · เขียวมรกต #0b7a33 ·
// เขียวสว่าง #2bbf63 · เขียวลึก #063f1c · ทองแบรนด์ #d9a521 · ทองอ่อน #ffdf91 ·
// เนื้อความ #f6e3cf (= BRAND_TEXT การ์ด ContentBox ตั้งให้แล้ว จึงไม่ต้องระบุสีที่
// ย่อหน้าหรือที่บล็อกที่อยู่)
// คู่ปุ่มสื่อลำดับด้วย "ฮิวที่ต่างกัน" ไม่ใช่ความสว่างของสีเดียว: สมัครสมาชิกเป็น PRIMARY
// ถมไล่เฉดแดง #e0201f → #c41115 → #7a0505 ขอบทอง #d9a521 · เข้าสู่ระบบเป็น
// SECONDARY ถมเขียวมรกต #0b7a33 → #063f1c ขอบเขียวสว่าง #2bbf63 — ทั้งสองใบใช้
// ตัวอักษรขาว ซึ่งสเปกตรวจแล้วว่าผ่าน AA ทั้งคู่ (ขาวบน #c41115 = 6.1:1 · ขาวบน
// #0b7a33 = 5.5:1) · ห้ามเอาขาวไปวางบน #2bbf63 (2.3:1) หรือบนพื้นถมทอง
// ชุดทองเมทัลลิก-เงินโครเมียมของแบรนด์ก่อนออกครบแล้ว ทั้งคลาส Tailwind raw hex
// และ rgba() (ค่าเดิมอยู่ใน brand-spec §3 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีแบรนด์
// เก่าเจอ false positive)
// ส่วน #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ตามเดิม
//
// ป้ายที่อยู่ไม่ประกาศสีตัวอักษรเลย ให้สืบทอดจากการ์ด สีแบรนด์มีเฉพาะบนเส้นขอบ
// ซึ่งเป็นเส้นตกแต่ง ไม่ใช่ body copy
//
// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. Keeping it in a const is what stops the meta tag
// and the structured data from drifting apart. 150–160 CHARACTERS (Thai is 3
// bytes/char, so a byte count reads ~3x too long). This one is 155.
//
// แบรนด์นี้เป็น **เว็บคาสิโนไลฟ์ 24 ชม. + สล็อต + บอล** ไม่ใช่เว็บหวย — คำหมวดหวย
// (หวย โพย เลขเด็ด แนวทาง งวด อัตราจ่าย ตรวจหวย) ห้ามหลงเหลือ และคำของแบรนด์ก่อน
// (ไฮคลาส VIP เบทต่ำ ทุนน้อย ค่ายตรง ถูกลิขสิทธิ์ ส่งตรงจากเว็บแม่ ไม่ผ่านบัญชีม้า)
// ก็ห้ามเช่นกัน
// บรีฟบรรทัด 18–19 ระบุเรื่องที่ทีมงานช่วยได้ไว้แค่: การสมัคร Login เข้าโต๊ะคาสิโน
// ไม่ได้ เกมไม่แสดง โปรโมชั่นมีปัญหา และรายการฝากถอนที่อยู่ระหว่างตรวจสอบ — ห้าม
// เขียนเกินนี้ ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 0.3% / 0.8% / 24 ชั่วโมง / 3 ขั้นตอน
// ห้ามแต่งชื่อธนาคาร เลขใบอนุญาต หน่วยงานกำกับ ชื่อค่ายเกม ค่า RTP ยอดฝากขั้นต่ำ
// จำนวนสมาชิก หรือปีก่อตั้ง
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ติดต่อแอดมิน ${BRAND_NAME} ได้ตลอด 24 ชั่วโมง แจ้งปัญหาการสมัคร Login เข้าโต๊ะคาสิโนไลฟ์ไม่ได้ เกมไม่แสดง โปรโมชั่นมีปัญหา หรือรายการฝากถอนที่อยู่ระหว่างตรวจสอบ`;

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: `ติดต่อทีมงาน ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    // `alternateName` is only for a genuine alternate NAME — an earlier brand
    // filled it with its own Thai spelling. The brief gives this brand no second
    // registered name, so the field stays out rather than being invented here:
    // this page's Organization node must not disagree with the one every other
    // page emits, and it is not a slot for marketing copy.
    //
    // BRAND_ADDRESS is rendered in the body but never enters the graph —
    // address/PostalAddress/email in JSON-LD fails the build gate.
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: `ติดต่อแอดมิน ${BRAND_NAME} ผ่านช่องทางไลน์ได้ตลอด 24 ชั่วโมง`,
      },
    ],
  },
});
---

<MainLayout title={`ติดต่อทีมงาน ${BRAND_NAME} แอดมินดูแลสมาชิกผ่านไลน์ตลอด 24 ชั่วโมง`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ติดต่อทีมงาน ${BRAND_NAME}`} as="h1">
    <Picture
      src={lineImage}
      alt="พริตตี้ผมยาวสีน้ำตาลในชุดเลื่อมสีชมพูยืนกอดอกและยิ้ม ฉากหลังเป็นวงกลมสีชมพูเรืองแสง ด้านล่างเป็นป้ายไอคอน LINE สีเขียวพร้อมข้อความว่า LINE Support"
      loading="lazy"
      fetchpriority="low"
      widths={[300, 400, 700]}
      sizes="(max-width: 420px) 100vw, 400px"
      class="mx-auto block h-auto w-full max-w-[400px]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 border-l-4 border-[#d9a521] pl-6 text-left text-base leading-relaxed not-italic">
          <p class="mb-1 font-bold opacity-90">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="/register"
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="flex items-center justify-center rounded-lg border border-[#d9a521] bg-gradient-to-b from-[#e0201f] via-[#c41115] to-[#7a0505] px-8 py-3 font-black text-white shadow-[0_0_14px_rgba(196,17,21,0.55)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="flex items-center justify-center rounded-lg border border-[#2bbf63]/60 bg-gradient-to-b from-[#0b7a33] to-[#063f1c] px-8 py-3 font-bold text-white shadow-[0_0_12px_rgba(11,122,51,0.35)] transition-all hover:scale-105 hover:border-[#2bbf63] hover:shadow-[0_0_18px_rgba(43,191,99,0.40)]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`ติดต่อทีมงาน ${BRAND_NAME} ผ่าน Line Official`}
        class="flex items-center justify-center gap-2 rounded-lg border border-[#00B900] bg-[#00B900] px-8 py-3 font-bold text-white shadow-[0_10px_30px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
        <span aria-hidden="true" class="text-2xl">💬</span>
        <span>ติดต่อผ่าน Line Official</span>
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
