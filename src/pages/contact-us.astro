---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
import lineImage from "../assets/contact-line.webp";

// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, the LINE image, the address block, the buttons.
// ห้ามเติมหัวข้อย่อยหรือย่อหน้าอธิบายกลับมา — ไม่มีรายการ "ควรเตรียมข้อมูลอะไร
// ก่อนแจ้ง" ไม่มีประโยคเตือนเรื่องรหัสผ่าน/OTP ไม่ว่าคอปปี้นั้นจะเขียนดีแค่ไหน
// ทุกย่อหน้าที่เคยอยู่บนหน้านี้คือของที่รีแบรนด์รอบก่อนๆ คิดขึ้นเอง ไม่ใช่ของบรีฟ
// (รอบนี้ src/assets/content.txt ไม่มีส่วน SUB-PAGES เลย — จบที่บรรทัด 29)
//
// The <h1> names what the page IS ("ติดต่อทีมงาน <brand>"), not what an article
// on it would have argued. A title that previews a body is the line that tempts
// the next rebrand into writing the body back.
//
// BRAND_ADDRESS สร้างตัวเองจาก BRAND_NAME (ตารางจังหวัดใน src/lib/thaiProvinces.ts)
// และอีเมลมาจาก site: — ห้ามพิมพ์บรรทัดที่อยู่หรืออีเมลเอง ห้ามเพิ่มบรรทัดถนนหรือ
// ลิงก์แผนที่ และห้ามส่งที่อยู่/อีเมลเข้า structured data (address/PostalAddress/
// email ใน JSON-LD ทำให้เกทของ verify-build แดง)
// ⚠️ โดเมนรอบนี้เป็น **ASCII ล้วน** ไม่ต้องแปลง punycode อีเมลจึง render ออกมาเป็น
// <mailbox>@<host ของ site:> ตรงๆ verify-build เทียบโฮสต์ของอีเมลกับ site:
// ห้าม "แก้ให้สวย" · กล่องจดหมายนี้ตั้งใจไม่ route ไปไหน เป็นการตัดสินใจของเจ้าของ
// ห้ามยกขึ้นมาถามทุกรอบ ห้ามตั้ง mail routing และห้ามลบบรรทัดนี้ออก
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ (brand-spec §3 — รอบก่อนใช้
// AnnouncementHuay จึงหมุนออก เหลือไว้เฉพาะสองหน้าหมวดหวย) orchestrator ตั้ง
// default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์ปัจจุบันไว้แล้ว ทุกหน้าเรียกแบบ bare
// จึงห้ามส่ง prop message จากหน้านี้ ไม่งั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตต์รอบนี้อยู่ใน .claude/brand-spec-ruaythear168vip.md §2
// ⚠️⚠️ **รอบนี้เป็นแบรนด์ "ธีมสว่าง" รอบที่สามของรีโปนี้ — การ์ดสว่าง หมึกเข้ม**
// bg.json = {"mode":"color","color":"#ffdbdb"} = ชมพูกุหลาบ **สว่าง** ไม่ใช่ดำ
// การ์ด ContentBox จึงเป็นผิว **ขาว** #ffffff บนหมึกแดงเลือดหมู #4a0f0f
// (= BRAND_TEXT) → คลาสสีของแบรนด์ก่อน (เขียวมรกต/บรอนซ์มะกอก) กวาดออกครบแล้ว
//
// บทบาทสีในไฟล์นี้:
//   ทองโบราณ #dcb95f → #c99a3f → #b8862b = **พื้นถมปุ่มหลักเท่านั้น** บนหมึก #280b0b
//   แดงสด #c30303 = พื้นถมปุ่มรอง และขอบซ้ายของป้ายที่อยู่
//   แดงเข้ม #8f0505 = ปลายเข้มของไล่เฉดปุ่มรอง และขอบปุ่มรอง
//   หมึกเนื้อความ #4a0f0f มาจากการ์ด — ป้ายที่อยู่จึงไม่ประกาศสีตัวอักษรเอง
// ขั้วของปุ่มตรงกับ /ทางเข้า /login /register ซึ่งวางปุ่มคู่นี้บนการ์ดสว่างเหมือนกัน:
// สมัครสมาชิก = PRIMARY ถมทอง #dcb95f → #c99a3f → #b8862b บนหมึก **#280b0b**
// (9.8 / 7.2 / 5.7:1 ผ่านทุก stop) · เข้าสู่ระบบ = SECONDARY ถมแดง #c30303 → #8f0505
// บนตัวอักษร **ขาว** (6.3:1 และ 9.6:1)
// ⚠️ **ห้ามกลับด้านปุ่มทองเป็นตัวอักษรขาวบนพื้นทอง** และห้ามลากปลายเข้มเลย #b8862b
// ⚠️ นอกจากพื้นถมปุ่มหลักแล้ว **ทองโบราณห้ามถือตัวอักษรบนผิวการ์ดขาว** (1.9-3.5:1)
// ⚠️ ปุ่มของ Navfoot เป็น **โครม** (พื้นมารูนเข้ม/ทอง) คนละโซนกับปุ่มบนการ์ดนี้
// **ห้ามลอกคลาสของ Navfoot มาวางบนการ์ดสว่าง**
// ⚠️⚠️ **แดงชาด #e81313 ห้ามถือตัวอักษรและห้ามเป็นพื้นของตัวอักษร** เป็น stop ของ
// ไล่เฉด/ออราเท่านั้น
// ออราในไฟล์นี้ใช้ rgba(195,3,3,α) · rgba(143,5,5,α) · rgba(74,15,15,α) ·
// rgba(184,134,43,α) เท่านั้น
// นอกจากสีเขียวของ LINE — #00B900 เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ คงไว้เดิม
// **ห้ามเปลี่ยนเป็นแดงของแบรนด์** ต่อให้รอบนี้ทั้งเว็บเป็นแดง
//
// ⚠️ กับดักรอบนี้คือ **แดงนำมาแล้วมากกว่าฮิวอื่นใดในรีโปนี้** การเจอแดงในไฟล์จึงไม่
// พิสูจน์ว่าเป็นค่าของรอบนี้ ต้องเทียบเป็น "ค่า" ทีละหลักกับตารางใน brand-spec §2
// ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive
// รอบนี้ **ไม่มีเขียว (ยกเว้น LINE green) ไม่มีชมพูบานเย็น ไม่มีฟ้า/น้ำเงิน/ไซยาน
// ไม่มีม่วง ไม่มีเงิน/โครเมียม และไม่มีโรสโกลด์**
//
// contact-line.webp (mtime 2026-08-04) เป็นอาร์ตสต็อกกลางของเทมเพลต ไม่ใช่
// อาร์ตเวิร์กของแบรนด์นี้ และไม่มีชื่อแบรนด์ใดพิมพ์อยู่บนรูป — alt จึงบรรยายรูปจริง
// ตามที่เห็น ห้ามเอ่ยชื่อแบรนด์ในคำบรรยายรูปใบนี้ และห้าม "แก้" คำบรรยายให้เข้ากับ
// ธีม นั่นคือ alt ที่โกหกรูป (ชุดเลื่อมในภาพเป็นสีชมพู ซึ่งไม่เกี่ยวกับพาเลตรอบนี้เลย
// แต่มันเป็นเนื้อหาของรูป จึงต้องเขียนตามนั้น)
//
// ป้ายที่อยู่ไม่ประกาศสีตัวอักษรเลย ให้สืบทอดจากการ์ด สีแบรนด์มีเฉพาะบนเส้นขอบซ้าย
// ซึ่งเป็นเส้นตกแต่ง ไม่ใช่ body copy
//
// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. Keeping it in a const is what stops the meta tag
// and the structured data from drifting apart. 150–160 CODE POINTS, counted
// with [...s].length exactly like verify-build.mjs — do NOT use `wc -m` on this
// box: git-bash has no UTF-8 locale here, so it counts BYTES and reads ~3x too
// long. This one is 158 with this round's 9-character brand name.
//
// คอปปี้ของหน้านี้อนุมานจากบรีฟบรรทัด 21-22 ซึ่งระบุเรื่องที่ติดต่อได้ไว้แค่:
// รอบหวย อัตราจ่าย การตรวจสอบบิล โปรโมชั่น และรายการฝากถอน กับเจ้าหน้าที่
// ตลอด 24ชม. ผ่านช่องทางทางการ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง —
// ห้ามเขียนเกินนี้ และคำศัพท์ต้องอยู่ใน brand-spec §6 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้
// grep หาคำของแบรนด์เก่าเจอ false positive
// ⚠️ แกนของบรีฟรอบนี้คือ **เว็บหวยออนไลน์ล้วน** (รัฐบาลไทย ลาวพัฒนา ฮานอย
// หุ้นต่างประเทศ) ศัพท์หมวดสล็อต/คาสิโน/บอลทุกคำจึงเป็นของค้างที่ต้องไม่เหลือ —
// รายการเต็มอยู่ใน brand-spec §6
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกม ชื่อธนาคาร หรือใบอนุญาตแม้แต่รายเดียว**
// ⚠️ ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 2 ตัว 100 · 3 ตัว 1,000 · 0.3% · 0.8% · 24ชม.
// ห้ามแต่งเลขใบอนุญาต หน่วยงานกำกับ ค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีใดๆ
// (บรีฟไม่เอ่ยปีไว้เลย) และห้ามมีวลี "N ขั้นตอน" — รอบนี้บรีฟไม่มี
// หน้านี้มีโควตาเป็นรูป ที่อยู่ และปุ่ม
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ติดต่อแอดมิน ${BRAND_NAME} ผ่าน LINE Official ได้ตลอด 24ชม. สอบถามประเภทหวย รอบปิดรับ อัตราจ่าย ตรวจสอบบิล และรายการฝากถอน จากช่องทางทางการเพื่อเลี่ยงบัญชีแอบอ้าง`;

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: `ติดต่อทีมงาน ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    // `alternateName` is only for a genuine alternate NAME — an earlier brand
    // filled it with its own Thai spelling. The brief gives this brand no second
    // registered name, so the field stays out rather than being invented here:
    // this page's Organization node must not disagree with the one every other
    // page emits, and it is not a slot for marketing copy.
    //
    // BRAND_ADDRESS is rendered in the body but never enters the graph —
    // address/PostalAddress/email in JSON-LD fails the build gate.
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: `ติดต่อแอดมิน ${BRAND_NAME} ผ่าน LINE Official ได้ตลอด 24ชม.`,
      },
    ],
  },
});
---

<MainLayout title={`ติดต่อทีมงาน ${BRAND_NAME} แอดมินเปิดบริการตลอด 24ชม.`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ติดต่อทีมงาน ${BRAND_NAME}`} as="h1">
    <Picture
      src={lineImage}
      alt="พริตตี้ผมยาวสีน้ำตาลในชุดเลื่อมสีชมพูยืนกอดอกและยิ้ม ฉากหลังเป็นวงกลมสีชมพูเรืองแสง ด้านล่างเป็นป้ายไอคอน LINE สีเขียวพร้อมข้อความว่า LINE Support"
      loading="lazy"
      fetchpriority="low"
      widths={[300, 400, 700]}
      sizes="(max-width: 420px) 100vw, 400px"
      class="mx-auto block h-auto w-full max-w-[400px]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 border-l-4 border-[#c30303] pl-6 text-left text-base leading-relaxed not-italic">
          <p class="mb-1 font-bold opacity-90">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="/register"
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="relative isolate flex items-center justify-center overflow-hidden rounded-lg border border-[#b8862b] bg-gradient-to-b from-[#dcb95f] via-[#c99a3f] to-[#b8862b] px-8 py-3 font-black text-[#280b0b] shadow-[0_0_14px_rgba(184,134,43,0.45)] transition-transform hover:scale-105">
        <span aria-hidden="true" class="absolute inset-x-0 bottom-0 -z-10 h-1/2 bg-gradient-to-t from-[#b8862b]/60 to-transparent"></span>
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="relative isolate flex items-center justify-center overflow-hidden rounded-lg border-2 border-[#8f0505] bg-gradient-to-b from-[#c30303] to-[#8f0505] px-8 py-3 font-bold text-[#ffffff] shadow-[0_0_12px_rgba(195,3,3,0.35)] transition-all hover:scale-105 hover:border-[#4a0f0f] hover:shadow-[0_0_18px_rgba(143,5,5,0.5)]">
        <span aria-hidden="true" class="absolute inset-x-0 bottom-0 -z-10 h-1/2 bg-gradient-to-t from-[#8f0505]/60 to-transparent"></span>
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`ติดต่อทีมงาน ${BRAND_NAME} ผ่าน Line Official`}
        class="flex items-center justify-center gap-2 rounded-lg border border-[#00B900] bg-[#00B900] px-8 py-3 font-bold text-white shadow-[0_10px_30px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
        <span aria-hidden="true" class="text-2xl">💬</span>
        <span>ติดต่อผ่าน Line Official</span>
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
