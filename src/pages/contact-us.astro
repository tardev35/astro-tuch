---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
import lineImage from "../assets/contact-line.webp";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, the LINE image, the address block, the buttons.
// Do not re-add section headings or explanatory prose here — no "เตรียมข้อมูล
// อะไรก่อนแจ้ง" list, no PIN/OTP notice, however well it reads. Every one of
// those was invented by an earlier rebrand, not by the brief. h1×1, h2×0, h3×0
//
// The <h1> names what the page IS ("ติดต่อทีมงาน <brand>"), not what an article
// on it would have argued. A title that previews a body is the line that tempts
// the next rebrand into writing the body back.
//
// BRAND_ADDRESS derives itself from BRAND_NAME — never retype the lines or the
// email, and never pass either into the structured data.
//
// Announcement หมุนมาเป็น AnnouncementHuay ทั้งเว็บรอบนี้ (แบรนด์ก่อนหน้าใช้
// Announcement5) — default message ของไฟล์นั้นเป็นคอปปี้ของ หวยคิง แล้ว และ
// index ก็เรียกแบบ bare จึงห้ามส่ง prop message จากหน้านี้ ไม่งั้นสองหน้าจะพูดไม่ตรงกัน
//
// พาเลตต์ หวยคิง (brand-spec §2 ทองโลหะบนดำอมน้ำตาล สีรองครีมอมพีช):
// เนื้อความ #f5e7c8 (BRAND_TEXT) · ทองสว่าง #fdeb7c · ทองแบรนด์ #cd9a2c ·
// ทองลึก #ab7314 · ครีมอมพีช #fcd4c3 / อ่อน #fce2d4 · ผิวการ์ดยก #1c140b ·
// พื้นลึกสุด #0c0b0a · หมึกบนปุ่มทอง #120a02 · ขอบจาง #5c3f12 ·
// glow rgba(205,154,44,α) · เงาดำกลาง rgba(0,0,0,α)
// ปุ่มหลัก (สมัครสมาชิก) รับไล่เฉด **ทอง** เต็มใบ #fdeb7c → #cd9a2c → #ab7314
// ขอบทองลึก #ab7314 ตัวอักษร **ดำอมน้ำตาล #120a02** — กฎคอนทราสต์: หมึกขาวบนทอง
// #fdeb7c ตก จึงต้องเป็นหมึกเข้มทุกสต็อป (#120a02 บน #fdeb7c ≈ 15:1)
// ปุ่มรอง (เข้าสู่ระบบ) เป็นแบบ outline **ครีมอมพีช** — กรอบ #fcd4c3/60 ตัวอักษร
// #fce2d4 บนพื้นลึกสุด #0c0b0a ไม่ใช่ถมทองอีกใบ เพราะสองปุ่มถมสีเดียวกันจะอ่านเป็น
// ก้อนเดียว และคู่ "ทองถม / ครีมกรอบ" คือสองโทนที่อยู่บนงานศิลป์จริงของรอบนี้
// ส่วน #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ตามเดิม
// ชุดทอง-เงินโครเมียมของแบรนด์ก่อน (#ebbb54 #fce675 #ab6d24 #d5d4d3 #f3f3f2 #241705
// #0c0502 #160d02 #f8eed9 rgba(235,187,84,*) rgba(12,5,2,*) rgba(213,212,211,*))
// ออกครบแล้ว ห้ามนำกลับมา
//
// ป้ายที่อยู่ใช้ opacity ไม่ใช่คลาสสี ให้สืบทอดสีตัวอักษรจากการ์ด ส่วนสีแบรนด์มีเฉพาะ
// บนเส้นขอบและลิงก์อีเมล ซึ่งเป็น accent ไม่ใช่ body copy
//
// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. Keeping it in a const is what stops the meta tag
// and the structured data from drifting apart. 150–160 CHARACTERS (Thai is 3
// bytes/char, so a byte count reads ~3x too long). This one is 150.
//
// หวยคิง เป็นเว็บรับแทงหวยล้วน บรีฟบรรทัด 20–21 ระบุเรื่องที่ทีมงานช่วยได้ไว้แค่
// การสมัคร เข้าบัญชีไม่ได้ ส่งโพยไม่สำเร็จ เลขที่ต้องการมีข้อจำกัด อัตราจ่ายไม่ตรง
// และรายการฝากถอนที่อยู่ระหว่างตรวจสอบ — ห้ามเขียนเกินนี้ ห้ามเอ่ยชื่อตลาดหวย
// เวลาเปิด-ปิดรับ ชื่อธนาคาร เลขใบอนุญาต หรือยอดฝากขั้นต่ำ และตัวเลขที่ใช้ได้มีแค่
// 2 ตัว / 3 ตัว / 100 / 1,000 / 3 ขั้นตอน / 24 ชั่วโมง
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ติดต่อแอดมิน ${BRAND_NAME} ผ่านไลน์ได้ตลอด 24 ชั่วโมง แจ้งปัญหาการสมัคร เข้าบัญชีไม่ได้ ส่งโพยไม่สำเร็จ อัตราจ่ายไม่ตรง หรือรายการฝากถอนที่อยู่ระหว่างตรวจสอบ`;

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: `ติดต่อทีมงาน ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    // `alternateName` is only for a genuine alternate NAME — an earlier brand
    // filled it with its own Thai spelling. The brief gives this brand no second
    // registered name, so the field stays out rather than being invented here:
    // this page's Organization node must not disagree with the one every other
    // page emits, and it is not a slot for marketing copy.
    //
    // BRAND_ADDRESS is rendered in the body but never enters the graph —
    // address/PostalAddress/email in JSON-LD fails the build gate.
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: `ติดต่อแอดมิน ${BRAND_NAME} ผ่านช่องทางไลน์ได้ตลอด 24 ชั่วโมง`,
      },
    ],
  },
});
---

<MainLayout title={`ติดต่อทีมงาน ${BRAND_NAME} แอดมินดูแลสมาชิกผ่านไลน์ตลอด 24 ชั่วโมง`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ติดต่อทีมงาน ${BRAND_NAME}`} as="h1">
    <Picture
      src={lineImage}
      alt="พริตตี้ผมยาวสีน้ำตาลในชุดเลื่อมสีชมพูยืนกอดอกและยิ้ม ฉากหลังเป็นวงกลมสีชมพูเรืองแสง ด้านล่างเป็นป้ายไอคอน LINE สีเขียวพร้อมข้อความว่า LINE Support"
      loading="lazy"
      fetchpriority="low"
      widths={[300, 400, 700]}
      sizes="(max-width: 420px) 100vw, 400px"
      class="mx-auto block h-auto w-full max-w-[400px]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 border-l-4 border-[#cd9a2c] pl-6 text-left text-base leading-relaxed not-italic">
          <p class="mb-1 font-bold opacity-90">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold text-[#fdeb7c] underline decoration-current/40 underline-offset-4 transition-colors hover:text-[#fce2d4]">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="/register"
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="flex items-center justify-center rounded-lg border border-[#ab7314] bg-gradient-to-r from-[#fdeb7c] via-[#cd9a2c] to-[#ab7314] px-8 py-3 font-black text-[#120a02] shadow-[0_0_15px_rgba(205,154,44,0.45)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="flex items-center justify-center rounded-lg border border-[#fcd4c3]/60 bg-[#0c0b0a] px-8 py-3 font-bold text-[#fce2d4] shadow-[0_0_15px_rgba(0,0,0,0.75)] transition-all hover:scale-105 hover:border-[#fce2d4] hover:bg-[#1c140b] hover:shadow-[0_0_18px_rgba(252,212,195,0.3)]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`ติดต่อทีมงาน ${BRAND_NAME} ผ่าน Line Official`}
        class="flex items-center justify-center gap-2 rounded-lg border border-[#00B900] bg-[#00B900] px-8 py-3 font-bold text-white shadow-[0_10px_30px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
        <span aria-hidden="true" class="text-2xl">💬</span>
        <span>ติดต่อผ่าน Line Official</span>
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
