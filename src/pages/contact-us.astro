---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
import lineImage from "../assets/contact-line.webp";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, the LINE image, the address block, the buttons.
// Do not re-add section headings or explanatory prose here — no "เตรียมข้อมูล
// อะไรก่อนแจ้ง" list, no PIN/OTP notice, however well it reads. Every one of
// those was invented by an earlier rebrand, not by the brief. h1×1, h2×0, h3×0
//
// The <h1> names what the page IS ("ติดต่อทีมงาน <brand>"), not what an article
// on it would have argued. A title that previews a body is the line that tempts
// the next rebrand into writing the body back.
//
// BRAND_ADDRESS derives itself from BRAND_NAME — never retype the lines or the
// email, and never pass either into the structured data.
//
// Announcement หมุนมาเป็น Announcement3 ทั้งเว็บรอบนี้ (รอบก่อน 1SS365 ใช้
// AnnouncementPremium) — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ
// DM899 แล้ว และ index ก็เรียกแบบ bare จึงห้ามส่ง prop message จากหน้านี้
// ไม่งั้นสองหน้าจะพูดไม่ตรงกัน
//
// พาเลตต์ DM899 (brand-spec §2 เขียวมรกตนำ แดงสดรอง ทองเสริม บนดำอมเขียว — มาจาก
// logo.webp ที่เป็นตัว D เขียว #01841b ซ้อนตัว M แดง #fb252b และเลข 899 เงิน):
// เนื้อความ #e4f2e4 (BRAND_TEXT) · เขียวอ่อน #4ade6b · เขียวสว่าง #12c23a ·
// เขียวแบรนด์ #01a326 (ขอบ/ออรา) · เขียวแกน #01841b · แดงแบรนด์ #fb252b ·
// ทองอ่อน #ffe9a8 · ทองแบรนด์ #f2b422 · ทองลึก #a8780f · พื้นลึกสุด #030a05 ·
// พื้นการ์ด #0a1a0e · พื้นยกระดับ #102a16 · พื้นปลายไล่เฉด #061008 · เงา rgba(3,10,5,α)
// ปุ่มหลัก (สมัครสมาชิก) รับไล่เฉด **เขียว** เต็มใบ #4ade6b → #01a326 → #01841b
// ขอบเขียวแกน #01841b ตัวอักษร **ดำอมเขียว #06140a** — กฎคอนทราสต์: หมึกขาวบนเขียว
// #4ade6b ตก จึงต้องเป็นหมึกเข้มทุกสต็อป (#06140a บน #4ade6b ≈ 11:1)
// ปุ่มรอง (เข้าสู่ระบบ) เป็นแบบ outline — กรอบทองแบรนด์ #f2b422/60 ตัวอักษรทองอ่อน
// #ffe9a8 บนพื้นยกระดับ #102a16 ไม่ใช่ถมเขียวอีกใบ เพราะสองปุ่มถมสีเดียวกันจะอ่าน
// เป็นก้อนเดียว ส่วน #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึง
// คงไว้ตามเดิม แต่รอบนี้แบรนด์เป็นเขียวด้วย จึงถมสีเรียบ #00B900 ตรงๆ ไม่ไล่เฉด
// เพื่อให้ต่างจากปุ่มสมัครที่เป็นไล่เฉดเขียวอย่างชัดเจน
// ชุดทอง-เงินโครเมียมของ 1SS365 (#edbb23 #ffeeb4 #a87708 #c8cbce #f1f2f3 #121010
// #f0e6d2 #050505 #2a2115 #f7d458 #1a1710 #c9930f rgba(237,187,35,*) rgba(5,5,5,*))
// ถูกแทนครบแล้ว
//
// ป้ายที่อยู่ใช้ opacity ไม่ใช่คลาสสี ให้สืบทอดสีตัวอักษรจากการ์ด ส่วนสีแบรนด์มีเฉพาะ
// บนเส้นขอบและลิงก์อีเมล ซึ่งเป็น accent ไม่ใช่ body copy
//
// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. Keeping it in a const is what stops the meta tag
// and the structured data from drifting apart — they used to be two hand-typed
// variants of the same sentence, and the JSON-LD copy was the one nobody
// reread. 150–160 CHARACTERS (Thai is 3 bytes/char, so a byte count reads ~3x
// too long and will send you rewriting a description that was fine).
// This one is 152.
//
// DM899 เป็นสล็อตคาสิโนออนไลน์เว็บตรงต่างประเทศ — ไม่ใช่เว็บหวยและไม่ใช่บอล
// บรีฟบรรทัด 18–19 ระบุเรื่องที่ทีมงานช่วยได้ไว้แค่ สมัคร/Login เข้าเกมไม่ได้
// เครดิตไม่แสดง รายการฝากถอนอยู่ระหว่างตรวจสอบ และโปรโมชั่นไม่ถูกคำนวณ — ห้ามเขียน
// เกินนี้ ห้ามเอ่ยชื่อธนาคาร เลขใบอนุญาต ยอดฝากขั้นต่ำ ชื่อค่ายเกม หรือชื่อผู้ให้บริการจริง
// และตัวเลขที่ใช้ได้มีแค่ 0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง · 100%
// คำศัพท์หวยของแบรนด์ก่อนหน้า (หวย แทงหวย ส่งโพย โพย เลือกเลข 2 ตัว 3 ตัว อัตราจ่าย
// งวด รัฐบาลไทย ฮานอย ลาวพัฒนา หวยหุ้น ตรวจหวย แนวทางหวย) ห้ามหลงเหลือ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ติดต่อทีมงาน ${BRAND_NAME} ผ่านไลน์ได้ตลอด 24 ชั่วโมง สอบถามปัญหาเรื่องสมัครสมาชิก Login เข้าเกมไม่ได้ เครดิตไม่แสดง รายการฝากถอน หรือโปรโมชั่นที่ยังไม่ถูกคำนวณ`;

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: `ติดต่อทีมงาน ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    // `alternateName` is only for a genuine alternate NAME — an earlier brand
    // filled it with its own Thai spelling. The brief gives this brand no second
    // registered name, so the field stays out rather than being invented here:
    // this page's Organization node must not disagree with the one every other
    // page emits, and it is not a slot for marketing copy.
    //
    // BRAND_ADDRESS is rendered in the body but never enters the graph —
    // address/PostalAddress/email in JSON-LD fails the build gate.
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: `ติดต่อแอดมิน ${BRAND_NAME} ผ่านช่องทางไลน์ได้ตลอด 24 ชั่วโมง`,
      },
    ],
  },
});
---

<MainLayout title={`ติดต่อทีมงาน ${BRAND_NAME} แอดมินเว็บหลักดูแลผ่านไลน์ตลอด 24 ชั่วโมง`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ติดต่อทีมงาน ${BRAND_NAME}`} as="h1">
    <Picture
      src={lineImage}
      alt="พริตตี้ผมยาวสีน้ำตาลในชุดเลื่อมสีชมพูยืนกอดอกและยิ้ม ฉากหลังเป็นวงกลมสีชมพูเรืองแสง ด้านล่างเป็นป้ายไอคอน LINE สีเขียวพร้อมข้อความว่า LINE Support"
      loading="lazy"
      fetchpriority="low"
      widths={[300, 400, 700]}
      sizes="(max-width: 420px) 100vw, 400px"
      class="mx-auto block h-auto w-full max-w-[400px]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 border-l-4 border-[#01a326] pl-6 text-left text-base leading-relaxed not-italic">
          <p class="mb-1 font-bold opacity-90">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold text-[#f2b422] underline decoration-current/40 underline-offset-4 transition-colors hover:text-[#ffe9a8]">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="/register"
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="flex items-center justify-center rounded-lg border border-[#01841b] bg-gradient-to-r from-[#4ade6b] via-[#01a326] to-[#01841b] px-8 py-3 font-black text-[#06140a] shadow-[0_0_15px_rgba(1,163,38,0.45)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="flex items-center justify-center rounded-lg border border-[#f2b422]/60 bg-[#102a16] px-8 py-3 font-bold text-[#ffe9a8] shadow-[0_0_15px_rgba(3,10,5,0.75)] transition-all hover:scale-105 hover:border-[#f2b422] hover:bg-[#061008] hover:shadow-[0_0_18px_rgba(242,180,34,0.32)]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`ติดต่อทีมงาน ${BRAND_NAME} ผ่าน Line Official`}
        class="flex items-center justify-center gap-2 rounded-lg border border-[#00B900] bg-[#00B900] px-8 py-3 font-bold text-white shadow-[0_10px_30px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
        <span aria-hidden="true" class="text-2xl">💬</span>
        <span>ติดต่อผ่าน Line Official</span>
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
