---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS } from "../lib/brandProfile";
import lineImage from "../assets/contact-line.webp";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, the LINE image, the address block, the buttons.
// Do not re-add section headings or explanatory prose here — no "เตรียมข้อมูล
// อะไรก่อนแจ้ง" list, no PIN/OTP notice, however well it reads. Every one of
// those was invented by an earlier rebrand, not by the brief. h1×1, h2×0, h3×0
//
// BRAND_ADDRESS derives itself from BRAND_NAME — never retype the lines or the
// email, and never pass either into the structured data.
//
// Announcement หมุนมาเป็น Announcement3 ทั้งเว็บรอบนี้ (รอบก่อน BRAVO168 ใช้
// AnnouncementPremium) — default message ของไฟล์นั้นเป็นคอปปี้ของ หวยเต็ง แล้ว และ
// index ก็เรียกแบบ bare จึงห้ามส่ง prop message จากหน้านี้ ไม่งั้นสองหน้าจะพูดไม่ตรงกัน
//
// พาเลตต์ หวยเต็ง เป็น "เขียวป่า + ทอง" ตามโลโก้ที่คำว่า "หวย" เป็นเขียวมรกตขอบทอง
// และ "เต็ง" เป็นทองตัน กับแบนเนอร์ฉากคืนสีเขียวป่าที่มีริ้วแสงทอง เหรียญทอง ลูกหวย
// และเงาวัดสีทอง: เนื้อความ #d8ead9 (BRAND_TEXT) · ทองนำ #e5c04f · ทองอ่อน #fae474 ·
// ทองลึก #bd8d2d · เขียวแบรนด์ #026314 · เขียวสว่าง #0bb42f · เส้นเขียว #024a0f ·
// พื้นเพจ #03150a · ผิวการ์ด #062a12 · ผิวยก #0b3d18 · หมึกบนพื้นทอง #0a1a0c
// ปุ่มหลัก (สมัครสมาชิก) รับไล่เฉดทองเต็มใบ #fae474 → #e5c04f → #bd8d2d และตัวอักษร
// ต้องเป็นหมึกเข้ม #0a1a0c — ทองเป็นสีสว่าง ขาวบน #e5c04f ตก AA ทันที
// ปุ่มรอง (เข้าสู่ระบบ) เป็นแบบ outline — กรอบเขียวแบรนด์ #026314 บนผิว #0b3d18
// ตัวอักษรทอง #e5c04f ไม่ใช่ถมทองอีกใบ เพราะสองปุ่มถมทองเหมือนกันจะอ่านเป็นก้อนเดียว
// ลำดับความสำคัญรอบนี้จึงสื่อด้วย "ถมทอง vs กรอบเขียว"
// ส่วน #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ตามเดิม
// ชุดน้ำเงินรอยัล-ทองของ BRAVO168 (#02081a #04142f #072247 #0e3f8f #1558c4 #2f86f0
// #f4cb69 #ffe39a #c9922e #dbe5f5 #0a1020 rgba(244,203,105,*) rgba(21,88,196,*)
// rgba(2,8,26,*)) ถูกแทนครบทุกจุดแล้ว
//
// ป้ายที่อยู่ใช้ opacity ไม่ใช่คลาสสี ให้สืบทอดสีตัวอักษรจากการ์ด ส่วนสีแบรนด์มีเฉพาะ
// บนเส้นขอบและลิงก์อีเมล ซึ่งเป็น accent ไม่ใช่ body copy
//
// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. Keeping it in a const is what stops the meta tag
// and the structured data from drifting apart — they used to be two hand-typed
// variants of the same sentence, and the JSON-LD copy was the one nobody
// reread. 150–160 CHARACTERS (Thai is 3 bytes/char, so a byte count reads ~3x
// too long and will send you rewriting a description that was fine).
// This one is 152.
//
// หวยเต็ง เป็นเว็บแทงหวยออนไลน์ ไม่ใช่บอลและไม่ใช่สล็อต บรีฟยกหัวข้อไว้ว่า
// "ติดต่อแอดมินเว็บ หวยเต็ง ผู้ให้บริการเกี่ยวกับการแทงหวย 24 ชั่วโมง" และระบุเรื่องที่
// ทีมงานช่วยได้ไว้แค่ สมัคร/Login ไม่ได้ ส่งโพยไม่สำเร็จ เครดิตไม่แสดง ตรวจผลไม่ได้
// และข้อสงสัยเรื่องอัตราจ่าย — ห้ามเขียนเกินนี้ ห้ามเอ่ยชื่อธนาคาร เลขใบอนุญาต
// ยอดฝากขั้นต่ำ หรือชื่อผู้ให้บริการจริง และคำศัพท์ของสองแบรนด์ก่อน (บอล ฟุตบอล
// บอลเดี่ยว บอลสเต็ป บอลสด ค่าน้ำ อัตราต่อรอง ลีก คู่แข่งขัน แมตช์ บิล แฮนดิแคป
// สล็อต ฟรีสปิน แจ็กพอต บาคาร่า รูเล็ต คาสิโน) ห้ามหลงเหลือ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "ช่องทางติดต่อแอดมิน หวยเต็ง ผ่านไลน์ได้ตลอด 24 ชั่วโมง สอบถามเรื่องสมัครสมาชิก เข้าสู่ระบบไม่ได้ ส่งโพยไม่สำเร็จ เครดิตไม่แสดง ตรวจผลไม่ได้ และอัตราจ่าย";

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: "ติดต่อทีมงาน หวยเต็ง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    // `alternateName` is only for a genuine alternate NAME — an earlier brand
    // filled it with its own Thai spelling. The brief gives หวยเต็ง no second
    // registered name, so the field stays out rather than being invented here:
    // this page's Organization node must not disagree with the one every other
    // page emits, and it is not a slot for marketing copy.
    //
    // BRAND_ADDRESS is rendered in the body but never enters the graph —
    // address/PostalAddress/email in JSON-LD fails the build gate.
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: "ติดต่อแอดมิน หวยเต็ง ผ่านช่องทางไลน์ได้ตลอด 24 ชั่วโมง",
      },
    ],
  },
});
---

<MainLayout title="ติดต่อทีมงาน หวยเต็ง แอดมินเว็บแทงหวยดูแลผ่านไลน์ตลอด 24 ชั่วโมง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน หวยเต็ง" as="h1">
    <Picture
      src={lineImage}
      alt="พริตตี้ผมยาวสีน้ำตาลในชุดเลื่อมสีชมพูยืนกอดอกและยิ้ม ฉากหลังเป็นวงกลมสีชมพูเรืองแสง ด้านล่างเป็นป้ายไอคอน LINE สีเขียวพร้อมข้อความว่า LINE Support"
      loading="lazy"
      fetchpriority="low"
      widths={[300, 400, 700]}
      sizes="(max-width: 420px) 100vw, 400px"
      class="mx-auto block h-auto w-full max-w-[400px]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 border-l-4 border-[#e5c04f] pl-6 text-left text-base leading-relaxed not-italic">
          <p class="mb-1 font-bold opacity-90">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold text-[#e5c04f] underline decoration-current/40 underline-offset-4 transition-colors hover:text-[#fae474]">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก หวยเต็ง"
        class="flex items-center justify-center rounded-lg border border-[#fae474]/70 bg-gradient-to-r from-[#fae474] via-[#e5c04f] to-[#bd8d2d] px-8 py-3 font-black text-[#0a1a0c] shadow-[0_0_15px_rgba(229,192,79,0.45)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ หวยเต็ง"
        class="flex items-center justify-center rounded-lg border border-[#026314] bg-[#0b3d18] px-8 py-3 font-bold text-[#e5c04f] shadow-[0_0_15px_rgba(3,21,10,0.75)] transition-all hover:scale-105 hover:border-[#0bb42f] hover:bg-[#024a0f] hover:text-[#fae474] hover:shadow-[0_0_18px_rgba(2,99,20,0.40)]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อทีมงาน หวยเต็ง ผ่าน Line Official"
        class="flex items-center justify-center gap-2 rounded-lg border border-[#00B900]/70 bg-gradient-to-r from-[#00B900] to-[#009900] px-8 py-3 font-bold text-white shadow-[0_10px_30px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
        <span aria-hidden="true" class="text-2xl">💬</span>
        <span>ติดต่อผ่าน Line Official</span>
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
