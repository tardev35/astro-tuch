---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS } from "../lib/brandProfile";
import lineImage from "../assets/contact-line.webp";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, the LINE image, the address block, the buttons.
// Do not re-add section headings or explanatory prose here — no "เตรียมข้อมูล
// อะไรก่อนแจ้ง" list, no PIN/OTP notice, however well it reads. Every one of
// those was invented by an earlier rebrand, not by the brief. h1×1, h2×0, h3×0
//
// BRAND_ADDRESS derives itself from BRAND_NAME — never retype the lines or the
// email, and never pass either into the structured data.
//
// Announcement หมุนมาเป็น AnnouncementHuay ทั้งเว็บรอบนี้ — orchestrator ตั้ง default
// message ของไฟล์นั้นเป็นคอปปี้ของ LOTTOPLUS แล้ว และ index ก็เรียกแบบ bare จึงห้ามส่ง
// prop message จากหน้านี้ ไม่งั้นสองหน้าจะพูดไม่ตรงกัน
//
// พาเลตต์ LOTTOPLUS เป็น "แดงนำ ทองรอง บนพื้นเกือบดำ" ตามโลโก้ที่เป็นตัวอักษรขาวบน
// บล็อกแดง #dc020e กับแบนเนอร์พื้นดำที่มีแดงลึก เหรียญทอง และลูกหวยแดง-ขาว:
// เนื้อความ #f0e2e2 (BRAND_TEXT) · แดงสว่าง #ff2d38 · แดงแบรนด์ #dc020e ·
// แดงกลาง #a80710 · แดงลึก #6b0207 · ทองอ่อน #fde79a · ทองรอง #f3c623 ·
// ทองลึก #8a6a0a · ผิวการ์ด #120b0c · ผิวการ์ดอุ่น #1f0a0c · ผิวปุ่มรอง #2a0d0f ·
// พื้นเพจ #050505 · เน้นใน strong #fff4f4 · หมึกบนพื้นทอง #1a0203
// ปุ่มหลัก (สมัครสมาชิก) รับไล่เฉดแดงเต็มใบ #ff2d38 → #dc020e → #6b0207 และตัวอักษร
// ต้องเป็น "ขาว" ตามกฎคอนทราสต์ของ brand-spec §2 — ขาวบนแดงแบรนด์ได้ 5.17:1 ผ่าน
// ส่วนหมึกเข้ม #1a0203 บนแดงเหลือ 3.85:1 ตก จึงห้ามใช้หมึกเข้มบนพื้นแดงเด็ดขาด
// ปุ่มรอง (เข้าสู่ระบบ) เป็นแบบ outline — กรอบทองรอง #f3c623 บนผิวปุ่มรอง #2a0d0f
// ตัวอักษรทองรอง ไม่ใช่ไล่เฉดแดงอีกใบ เพราะสองปุ่มถมแดงเหมือนกันจะอ่านเป็นก้อนเดียว
// ลำดับความสำคัญรอบนี้จึงสื่อด้วย "ถมแดง vs กรอบทอง" ซึ่งใช้ทั้งสองสีของแบรนด์พอดี
// ส่วน #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ตามเดิม
// ชุดทอง-ดำของ WIN999 (#fcc403 #fdda04 #e0a800 #8a6502 #fff0a8 #e9e4d6 #fffbea
// #101010 #191712 #241f14 rgba(252,196,3,*) rgba(3,2,0,*)) และชุดแดงของ LOTTO24
// (#dc2626 #fc2b2c #b40102 #fbbf24 #fde68a rgba(220,38,38,*)) ถูกแทนครบทุกจุดแล้ว
//
// ป้ายที่อยู่ใช้ opacity ไม่ใช่คลาสสี ให้สืบทอดสีตัวอักษรจากการ์ด ส่วนสีแบรนด์มีเฉพาะ
// บนเส้นขอบและลิงก์อีเมล ซึ่งเป็น accent ไม่ใช่ body copy
//
// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. Keeping it in a const is what stops the meta tag
// and the structured data from drifting apart — they used to be two hand-typed
// variants of the same sentence, and the JSON-LD copy was the one nobody
// reread. 150–160 CHARACTERS (Thai is 3 bytes/char, so a byte count reads ~3x
// too long and will send you rewriting a description that was fine).
// This one is 158.
//
// LOTTOPLUS เป็นเว็บหวยออนไลน์ ไม่ใช่คาสิโน บรีฟยกหัวข้อไว้ว่า "ติดต่อสอบถามแอดมิน
// ผู้ให้บริการ LOTTOPLUS ได้ 24 ชั่วโมง" และระบุเรื่องที่ทีมงานช่วยได้ไว้แค่ สมัคร/Login
// ไม่ได้ ส่งโพยไม่สำเร็จ เครดิตไม่เข้า รายการถอนอยู่ระหว่างตรวจสอบ และสอบถามอัตราจ่าย
// กับโปรโมชั่น — ห้ามเขียนเกินนี้ ห้ามเอ่ยชื่อธนาคาร เลขใบอนุญาต ยอดฝากขั้นต่ำ หรือ
// ชื่อผู้ให้บริการ และคำศัพท์ตระกูลคาสิโนของแบรนด์ก่อน (คาสิโน บาคาร่า สล็อต เกมไพ่
// ค่ายเกม RTP กีฬา/บอล) ห้ามหลงเหลือ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "ช่องทางติดต่อแอดมิน LOTTOPLUS ผ่านไลน์ได้ตลอด 24 ชั่วโมง สอบถามเรื่องการสมัคร ส่งโพย อัตราจ่าย โปรโมชั่น หรือแจ้งปัญหาฝากถอนให้ทีมงานช่วยตรวจสอบได้ทุกช่วงเวลา";

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: "ติดต่อทีมงาน LOTTOPLUS",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    // `alternateName` is only for a genuine alternate NAME — an earlier brand
    // filled it with its own Thai spelling. The brief gives LOTTOPLUS no second
    // registered name, so the field stays out rather than being invented here:
    // this page's Organization node must not disagree with the one every other
    // page emits, and it is not a slot for marketing copy.
    //
    // BRAND_ADDRESS is rendered in the body but never enters the graph —
    // address/PostalAddress/email in JSON-LD fails the build gate.
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: "ติดต่อแอดมิน LOTTOPLUS ผ่านช่องทางไลน์ได้ตลอด 24 ชั่วโมง",
      },
    ],
  },
});
---

<MainLayout title="ติดต่อทีมงาน LOTTOPLUS แอดมินหวยออนไลน์ดูแลผ่านไลน์ตลอด 24 ชั่วโมง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน LOTTOPLUS" as="h1">
    <Picture
      src={lineImage}
      alt="พริตตี้ผมยาวสีน้ำตาลในชุดเลื่อมสีชมพูยืนกอดอกและยิ้ม ฉากหลังเป็นวงกลมสีชมพูเรืองแสง ด้านล่างเป็นป้ายไอคอน LINE สีเขียวพร้อมข้อความว่า LINE Support"
      loading="lazy"
      fetchpriority="low"
      widths={[300, 400, 700]}
      sizes="(max-width: 420px) 100vw, 400px"
      class="mx-auto block h-auto w-full max-w-[400px]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 border-l-4 border-[#dc020e] pl-6 text-left text-base leading-relaxed not-italic">
          <p class="mb-1 font-bold opacity-90">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold text-[#f3c623] underline decoration-current/40 underline-offset-4 transition-colors hover:text-[#fde79a]">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก LOTTOPLUS"
        class="flex items-center justify-center rounded-lg border border-[#ff2d38]/70 bg-gradient-to-r from-[#ff2d38] via-[#dc020e] to-[#6b0207] px-8 py-3 font-black text-white shadow-[0_0_15px_rgba(220,2,14,0.45)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ LOTTOPLUS"
        class="flex items-center justify-center rounded-lg border border-[#f3c623]/80 bg-[#2a0d0f] px-8 py-3 font-bold text-[#f3c623] shadow-[0_0_15px_rgba(5,1,2,0.75)] transition-all hover:scale-105 hover:border-[#fde79a] hover:bg-[#3a1114] hover:text-[#fff4f4] hover:shadow-[0_0_18px_rgba(243,198,35,0.35)]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อทีมงาน LOTTOPLUS ผ่าน Line Official"
        class="flex items-center justify-center gap-2 rounded-lg border border-[#00B900]/70 bg-gradient-to-r from-[#00B900] to-[#009900] px-8 py-3 font-bold text-white shadow-[0_10px_30px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
        <span aria-hidden="true" class="text-2xl">💬</span>
        <span>ติดต่อผ่าน Line Official</span>
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
