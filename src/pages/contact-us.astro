---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
import lineImage from "../assets/contact-line.webp";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, the LINE image, the address block, the buttons.
// Do not re-add section headings or explanatory prose here — no "เตรียมข้อมูล
// อะไรก่อนแจ้ง" list, no PIN/OTP notice, however well it reads. Every one of
// those was invented by an earlier rebrand, not by the brief. h1×1, h2×0, h3×0
//
// The <h1> names what the page IS ("ติดต่อทีมงาน <brand>"), not what an article
// on it would have argued. A title that previews a body is the line that tempts
// the next rebrand into writing the body back.
//
// BRAND_ADDRESS derives itself from BRAND_NAME — never retype the lines or the
// email, and never pass either into the structured data.
//
// Announcement หมุนมาเป็น AnnouncementHuay ทั้งเว็บรอบนี้ (รอบก่อน NATO168 ใช้
// Announcement5) — แบรนด์รอบนี้เป็นเว็บแทงหวยล้วน ธีม Huay แดง-ทองจึงเป็นธีมของ
// แบรนด์เอง orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ หวย365 แล้ว
// และ index ก็เรียกแบบ bare จึงห้ามส่ง prop message จากหน้านี้ ไม่งั้นสองหน้าจะพูดไม่ตรงกัน
//
// พาเลตต์ หวย365 (brand-spec §2 แดงสด-ทอง-ดำ — แดงคือสีตัวตน ทองคือสีเน้น ดำคือพื้น
// มาจาก logo.webp ที่ vivid เป็นแดงล้วน #dc0203 ส่วน dominant เป็นดำ):
// เนื้อความ #f6e7e0 (BRAND_TEXT) · ทองอ่อน #ffeab0 · ทองแบรนด์ #ffc93c ·
// ทองลึก #c08a07 (เส้น/ขอบ/ปลายไล่เฉด) · แดงแบรนด์ #dc0203 · แดงสว่าง #f5282a ·
// แดงลึก #8c0402 · พื้นการ์ด #240406 · พื้นยกระดับ #3a0a0c · เงา rgba(8,1,1,α)
// ปุ่มหลัก (สมัครสมาชิก) รับไล่เฉด **แดง** เต็มใบ #f5282a → #dc0203 → #8c0402 ขอบทองลึก
// #c08a07 ตัวอักษร **ขาว** — กฎคอนทราสต์ brand-spec §2: หมึกเข้มบนพื้นแดงได้แค่ 2.8:1
// จึงต้องเป็นขาว (ขาวบน #dc0203 ≈ 5.1:1)
// ปุ่มรอง (เข้าสู่ระบบ) เป็นแบบ outline **ทอง** — กรอบ #c08a07 ตัวอักษร #ffc93c บนพื้น
// ยกระดับ #3a0a0c (≈11:1) ไม่ใช่ถมแดงอีกใบ เพราะสองปุ่มถมสีเหมือนกันจะอ่านเป็นก้อนเดียว
// และทองคือฮิวที่สองจริงของแบรนด์นี้ (ตัวอักษรบนแบนเนอร์/สไลด์เป็นทองทั้งชุด)
// ส่วน #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ตามเดิม
// ชุดทอง-เงินของ NATO168 (#edb543 #fde8a8 #a9761f #b8832a #e6e6e6 #101010 #070707
// #f4ead3 #1a1203 #241a09 #17120a rgba(237,181,67,*) rgba(230,230,230,*)
// rgba(4,3,0,*)) ถูกแทนครบแล้ว
//
// ป้ายที่อยู่ใช้ opacity ไม่ใช่คลาสสี ให้สืบทอดสีตัวอักษรจากการ์ด ส่วนสีแบรนด์มีเฉพาะ
// บนเส้นขอบและลิงก์อีเมล ซึ่งเป็น accent ไม่ใช่ body copy
//
// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. Keeping it in a const is what stops the meta tag
// and the structured data from drifting apart — they used to be two hand-typed
// variants of the same sentence, and the JSON-LD copy was the one nobody
// reread. 150–160 CHARACTERS (Thai is 3 bytes/char, so a byte count reads ~3x
// too long and will send you rewriting a description that was fine).
// This one is 159.
//
// หวย365 เป็นเว็บแทงหวยออนไลน์ ไม่ใช่สล็อตและไม่ใช่บอล บรีฟบรรทัด 18–19 ระบุเรื่องที่
// ทีมงานช่วยได้ไว้แค่ สมัคร/Login ไม่ได้ ส่งโพยไม่สำเร็จ รายการไม่แสดง ผลหวยยังไม่อัปเดต
// และข้อสงสัยเรื่องอัตราจ่าย — ห้ามเขียนเกินนี้ ห้ามเอ่ยชื่อธนาคาร เลขใบอนุญาต
// ยอดฝากขั้นต่ำ หรือชื่อผู้ให้บริการจริง และตัวเลขที่ใช้ได้มีแค่ 2 ตัว จ่าย 100 บาท ·
// 3 ตัว จ่าย 1,000 บาท · 3 ขั้นตอน · 24 ชั่วโมง
// คำศัพท์ของแบรนด์ก่อนหน้า (สล็อต พีจี PG ค่ายเกม ฟรีสปิน ตัวคูณ วงล้อ ปั่น โบนัสไทม์
// โบนัสทุกยูส ไม่มีล็อคยูส คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% RTP คาสิโนสด บาคาร่า บอล
// ค่าน้ำ ลีก) ห้ามหลงเหลือ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ติดต่อทีมงาน ${BRAND_NAME} ผ่านไลน์ได้ตลอด 24 ชั่วโมง สอบถามเรื่องสมัครสมาชิก Login ไม่ได้ ส่งโพยไม่สำเร็จ รายการไม่แสดง ผลหวยยังไม่อัปเดต หรือข้อสงสัยเรื่องอัตราจ่าย`;

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: `ติดต่อทีมงาน ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    // `alternateName` is only for a genuine alternate NAME — an earlier brand
    // filled it with its own Thai spelling. The brief gives this brand no second
    // registered name, so the field stays out rather than being invented here:
    // this page's Organization node must not disagree with the one every other
    // page emits, and it is not a slot for marketing copy.
    //
    // BRAND_ADDRESS is rendered in the body but never enters the graph —
    // address/PostalAddress/email in JSON-LD fails the build gate.
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: `ติดต่อแอดมิน ${BRAND_NAME} ผ่านช่องทางไลน์ได้ตลอด 24 ชั่วโมง`,
      },
    ],
  },
});
---

<MainLayout title={`ติดต่อทีมงาน ${BRAND_NAME} แอดมินเว็บแทงหวยดูแลผ่านไลน์ตลอด 24 ชั่วโมง`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ติดต่อทีมงาน ${BRAND_NAME}`} as="h1">
    <Picture
      src={lineImage}
      alt="พริตตี้ผมยาวสีน้ำตาลในชุดเลื่อมสีชมพูยืนกอดอกและยิ้ม ฉากหลังเป็นวงกลมสีชมพูเรืองแสง ด้านล่างเป็นป้ายไอคอน LINE สีเขียวพร้อมข้อความว่า LINE Support"
      loading="lazy"
      fetchpriority="low"
      widths={[300, 400, 700]}
      sizes="(max-width: 420px) 100vw, 400px"
      class="mx-auto block h-auto w-full max-w-[400px]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 border-l-4 border-[#c08a07] pl-6 text-left text-base leading-relaxed not-italic">
          <p class="mb-1 font-bold opacity-90">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold text-[#ffc93c] underline decoration-current/40 underline-offset-4 transition-colors hover:text-[#ffeab0]">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="/register"
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="flex items-center justify-center rounded-lg border border-[#c08a07] bg-gradient-to-r from-[#f5282a] via-[#dc0203] to-[#8c0402] px-8 py-3 font-black text-white shadow-[0_0_15px_rgba(220,2,3,0.45)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="flex items-center justify-center rounded-lg border border-[#c08a07]/70 bg-[#3a0a0c] px-8 py-3 font-bold text-[#ffc93c] shadow-[0_0_15px_rgba(8,1,1,0.75)] transition-all hover:scale-105 hover:border-[#ffc93c] hover:bg-[#240406] hover:text-[#ffeab0] hover:shadow-[0_0_18px_rgba(255,201,60,0.30)]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`ติดต่อทีมงาน ${BRAND_NAME} ผ่าน Line Official`}
        class="flex items-center justify-center gap-2 rounded-lg border border-[#00B900]/70 bg-gradient-to-r from-[#00B900] to-[#009900] px-8 py-3 font-bold text-white shadow-[0_10px_30px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
        <span aria-hidden="true" class="text-2xl">💬</span>
        <span>ติดต่อผ่าน Line Official</span>
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
