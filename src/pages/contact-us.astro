---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
import lineImage from "../assets/contact-line.webp";

// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, the LINE image, the address block, the buttons.
// ห้ามเติมหัวข้อย่อยหรือย่อหน้าอธิบายกลับมา — ไม่มีรายการ "ควรเตรียมข้อมูลอะไร
// ก่อนแจ้ง" ไม่มีประโยคเตือนเรื่องรหัสผ่าน/OTP ไม่ว่าคอปปี้นั้นจะเขียนดีแค่ไหน
// ทุกย่อหน้าที่เคยอยู่บนหน้านี้คือของที่รีแบรนด์รอบก่อนๆ คิดขึ้นเอง ไม่ใช่ของบรีฟ
// (รอบนี้ src/assets/content.txt ไม่มีส่วน SUB-PAGES เลย — จบที่บรรทัด 29
// ประโยคกำกับเรื่องรหัสผ่าน/OTP ของบรีฟอยู่บน index.astro ซึ่งเป็นบทความจริง)
//
// The h1 names what the page IS ("ติดต่อทีมงาน <brand>"), not what an article
// on it would have argued. A title that previews a body is the line that tempts
// the next rebrand into writing the body back.
//
// BRAND_ADDRESS สร้างตัวเองจาก BRAND_NAME (ตารางจังหวัดใน src/lib/thaiProvinces.ts)
// และอีเมลมาจาก site: — ห้ามพิมพ์บรรทัดที่อยู่หรืออีเมลเอง ห้ามเพิ่มบรรทัดถนนหรือ
// ลิงก์แผนที่ และห้ามส่งที่อยู่/อีเมลเข้า structured data (address/PostalAddress/
// email ใน JSON-LD ทำให้เกทของ verify-build แดง)
// verify-build เทียบโฮสต์ของอีเมลกับ site: — **ห้ามแก้สตริงนี้ด้วยมือ และห้าม
// พิมพ์โดเมนลงในไฟล์นี้**
// · กล่องจดหมายนี้ตั้งใจไม่ route ไปไหน เป็นการตัดสินใจของเจ้าของ
// ห้ามยกขึ้นมาถามทุกรอบ ห้ามตั้ง mail routing และห้ามลบบรรทัดนี้ออก
//
// Announcement หมุนมาเป็น `Announcement5.astro` ทั้งเว็บรอบนี้
// (brand-spec §3 — รอบก่อนใช้ ticker ตัวเลข 3 ของตระกูล (เขียนชื่อไฟล์แบบไม่มี .astro ใน backtick โดยตั้งใจ — tools/gen-tw-sources.mjs นับ literal ที่มีเครื่องหมายคำพูดว่าเป็นการ import จริง คอมเมนต์จึงทำให้ variant เก่าหลุดเข้า Tailwind scan แล้วสีของแบรนด์ก่อนขึ้น stylesheet) จึงหมุนออก) orchestrator
// ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์ปัจจุบันไว้แล้ว ทุกหน้าเรียก
// แบบ bare จึงห้ามส่ง prop message จากหน้านี้ ไม่งั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตต์รอบนี้อยู่ใน .claude/brand-spec-mexicanoslot.md §2
// 🚨 **รอบนี้กลับทิศครึ่งหนึ่ง: เนื้อหายังเป็นการ์ดสว่าง แต่โครมเป็นผิวเข้ม**
// bg.json = {"mode":"color","color":"#fef6fb"} = **ขาวอมชมพูจาง**
// (รอบก่อนเป็น ffd6fa ชมพูบับเบิลกัมที่อิ่มกว่ามาก — ค่ามาจากไฟล์ ห้ามเดาว่าเท่าเดิม)
// การ์ด ContentBox จึงเป็นผิว #ffffff บนหมึก #3f130d (= BRAND_TEXT)
// **ห้าม "แก้" การ์ดให้เป็นผิวมืดตามโครม** — การ์ดมืดบนหมึกนี้ = ตัวอักษรหายไปเลย
//
// บทบาทสีในไฟล์นี้:
//   ปุ่ม PRIMARY (สมัครสมาชิก) = ไล่เฉดแดง #c81e12 -> #9d140c -> #6f0e08
//     บนหมึก **ขาว #ffffff** (5.7 / 8.3 / 11.4:1 — ผ่านทุก stop)
//     ⚠️⚠️ **ห้ามใช้ #de2b1e หรือ #f2a033 เป็น stop ของปุ่มที่ถือหมึกขาว**
//     (4.7:1 เฉียดเกินไป / ทองยิ่งไม่ผ่าน) สองค่านั้นเป็นขอบ/ออรา/พื้นถมเท่านั้น
//   ปุ่ม SECONDARY (เข้าสู่ระบบ) = ไล่เฉดขาว #ffffff -> #fde4d3 บนหมึก #3f130d
//     (14.9 / 12.1:1) ขอบ #e2855c เป็นตัวแยกปุ่มออกจากผิวการ์ดขาว
//   หมึกเนื้อความ #3f130d มาจากการ์ด — ป้ายที่อยู่จึงไม่ประกาศสีตัวอักษรเอง
//     ⚠️ บล็อก <address> **ห้ามมีสีแบรนด์เป็นสีตัวอักษรเลยสักค่า** เส้นขอบซ้าย
//     ใช้ #e2855c ซึ่งเป็น "เส้นเข้ม" ของพาเลตรอบนี้ — รอบก่อนใช้ f479b9
//     (ชมพู เขียนไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep หาสีแบรนด์เก่าสะดุดที่
//     คอมเมนต์ของไฟล์นี้เอง) ซึ่งรอบนี้หายไปทั้งค่า
// ขั้วของปุ่มตรงกับ /ทางเข้า /login /register /promotion ซึ่งวางปุ่มคู่นี้บนการ์ด
// ผิวขาวเหมือนกัน: สมัครสมาชิก = PRIMARY ไล่เฉดแดงเข้ม · เข้าสู่ระบบ =
// SECONDARY ไล่เฉดขาว-พีชอ่อน
// ออราในไฟล์นี้ใช้ rgba(168,20,16,α) · rgba(222,43,30,α) · rgba(246,196,164,α) ·
// rgba(254,215,181,α) เท่านั้น
// ⚠️⚠️ **#f2543f และ #2bb061 เป็นสีของผิวโครมเข้มเท่านั้น ห้ามหลุดเข้ามาในไฟล์นี้**
// (บนการ์ดขาวได้ 3.5:1 และ 2.9:1)
// นอกจากสีเขียวของ LINE — #00B900 เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ คงไว้เดิม
// **ห้ามเปลี่ยนเป็นสีของแบรนด์** และบนผิวขาวต้องเป็นพื้นถม bg-[#00B900] + หมึกขาว
// ไม่ใช่ตัวอักษรสีเขียวบนพื้นขาว
//
// ⚠️⚠️ กับดักรอบนี้คือ **แดง** — แบรนด์แดงผ่านรีโปนี้มาแล้วอย่างน้อยหกเจ้า
// (สล็อต168 · มาดาม168 · รวยแท้168 · ดวงเศรษฐี168 · GT66B · FLASH877) การเจอแดง
// ในไฟล์จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้ ต้องเทียบเป็น "ค่า" ทีละหลักกับตารางใน
// brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ
// false positive (fb2e33 ของสล็อต168 ห่างจาก #de2b1e แค่ R/B · d9212a ของ
// ดวงเศรษฐี168 ใกล้กว่านั้นอีก — เจอค่าพวกนั้นแปลว่าพิมพ์ผิด)
// รอบนี้ **ไม่มีชมพู/แมเจนต้า (ฮิวนำของแบรนด์ขาออกทันที) ไม่มีฟ้า/ไซแอน/น้ำเงิน
// ไม่มีม่วง และไม่มีเทาเงิน** — ชมพูที่เหลือไว้ = ทั้งผิดพาเลตและหลงเหลือข้ามแบรนด์
// พร้อมกัน ส่วนทอง #f2a033 กับเขียว #117a41 รอบนี้ **มีจริง** เพราะมาจากอาร์ตเวิร์ก
// (เหรียญทอง/ขอบแคปซูล และกระบองเพชร/แถบธงชาติ)
// ⚠️⚠️ **ซอมเบรโรฟาง ปอนโช กีตาร์ เหรียญทอง มาราคัส ฉากสตูดิโอขาว และสีผิว
// นักแสดงในอาร์ตเวิร์กเป็นวัตถุในภาพ ไม่ใช่สี UI** — พื้นเพจมาจาก bg.json เท่านั้น
// 🚨 **"SLOT" สีน้ำเงินไล่ฟ้าในเวิร์ดมาร์กก็เป็นอาร์ตเวิร์ก ไม่ใช่สี UI**
//
// contact-line.webp เป็นอาร์ตสต็อกกลางของเทมเพลต ไม่ใช่อาร์ตเวิร์กของแบรนด์นี้
// และไม่มีชื่อแบรนด์ใดพิมพ์อยู่บนรูป — alt จึงบรรยายรูปจริงตามที่เห็น ห้ามเอ่ย
// ชื่อแบรนด์ในคำบรรยายรูปใบนี้ และห้าม "แก้" คำบรรยายให้เข้ากับธีม นั่นคือ alt ที่
// โกหกรูป (เปิดรูปจริงรอบนี้แล้ว ชุดเลื่อมในภาพเป็น **สีชมพู** จริง — ซึ่งรอบนี้
// ไม่ใช่สีของแบรนด์เลย **และนั่นไม่ใช่เหตุผลให้แก้บรรทัดนี้** มันคือ "เนื้อหาของรูป")
//
// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. Keeping it in a const is what stops the meta tag
// and the structured data from drifting apart. 150–160 CODE POINTS, counted
// with [...s].length exactly like verify-build.mjs — do NOT use `wc -m` on this
// box: git-bash has no UTF-8 locale here, so it counts BYTES and reads ~3x too
// long. This one is 158 with this round's 12-code-point brand name (last round's
// was 7, so the length must be recounted every rebrand, never inherited).
//
// คอปปี้ของหน้านี้อนุมานจากบรีฟบรรทัด 21-22 ซึ่งระบุเรื่องที่ติดต่อได้ไว้แค่:
// การสมัครสมาชิก การเข้าสู่ระบบ รายชื่อเกมสล็อต และรายละเอียดโปรโมชั่น กับ
// เจ้าหน้าที่ตลอด 24ชม. ผ่านเว็บไซต์ทางการ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง —
// ห้ามเขียนเกินนี้ และคำศัพท์ต้องอยู่ใน brand-spec §5 ซึ่งไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาคำของแบรนด์เก่าเจอ false positive
// ⚠️ แกนของบรีฟรอบนี้คือ **สล็อตเมกซิกัน เดิมพันออนไลน์ สดส่งตรงจากเมกซิกัน
// การันตีเว็บตรง ยอดเข้าบริษัทไม่ผ่านเอเย่นต์** ศัพท์ของแบรนด์ก่อนทุกคำจึงเป็น
// ของค้างที่ต้องไม่เหลือ — รายการเต็มอยู่ใน brand-spec §5
// 🚨🚨 **บรีฟรอบนี้ไม่พูดถึงธนาคาร วอลเลท หรือการฝากถอนเลยแม้แต่คำเดียว** —
// หน้านี้จึงไม่เอ่ยถึงรายการฝากถอนหรือชื่อวอลเล็ตใดๆ ทั้งสิ้น และคำวอลเล็ตของ
// แบรนด์ขาออกคือจุดที่พลาดง่ายที่สุดของรอบนี้ (ไม่พิมพ์ซ้ำที่นี่ — brand-spec §5)
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกม ชื่อผู้ให้บริการ หรือใบอนุญาตแม้แต่รายเดียว**
// ⚠️ ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 0.3% · 0.8% · 3 ขั้นตอน · 24ชม. ห้ามแต่งเลข
// ใบอนุญาต หน่วยงานกำกับ ตัวเลขการเงิน ค่าอัตราคืนรางวัล จำนวนเกม/ค่าย หรือจำนวน
// สมาชิก — ตัวเลขที่ห้ามทั้งชุดอยู่ใน brand-spec §5
// หน้านี้มีโควตาเป็นรูป ที่อยู่ และปุ่ม
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ติดต่อทีมงาน ${BRAND_NAME} ผ่าน LINE Official ได้ตลอด 24ชม. สอบถามการสมัครสมาชิก การเข้าสู่ระบบ รายชื่อเกมสล็อต และรายละเอียดโปรโมชั่นผ่านช่องทางทางการเท่านั้น`;

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: `ติดต่อทีมงาน ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    // `alternateName` is only for a genuine alternate NAME — an earlier brand
    // filled it with its own Thai spelling. The brief gives this brand no second
    // registered name, so the field stays out rather than being invented here:
    // this page's Organization node must not disagree with the one every other
    // page emits, and it is not a slot for marketing copy.
    //
    // BRAND_ADDRESS is rendered in the body but never enters the graph —
    // address/PostalAddress/email in JSON-LD fails the build gate.
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: `ติดต่อแอดมิน ${BRAND_NAME} ผ่าน LINE Official ได้ตลอด 24ชม.`,
      },
    ],
  },
});
---

<MainLayout title={`ติดต่อทีมงาน ${BRAND_NAME} แอดมินออนไลน์ดูแลสมาชิกตลอด 24ชม.`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ติดต่อทีมงาน ${BRAND_NAME}`} as="h1">
    <Picture
      src={lineImage}
      alt="พริตตี้ผมยาวสีน้ำตาลในชุดเลื่อมสีชมพูยืนกอดอกและยิ้ม ฉากหลังเป็นวงกลมสีชมพูเรืองแสง ด้านล่างเป็นป้ายไอคอน LINE สีเขียวพร้อมข้อความว่า LINE Support"
      loading="lazy"
      fetchpriority="low"
      widths={[300, 400, 700]}
      sizes="(max-width: 420px) 100vw, 400px"
      class="mx-auto block h-auto w-full max-w-[400px]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 border-l-4 border-[#e2855c] pl-6 text-left text-base leading-relaxed not-italic">
          <p class="mb-1 flex items-center gap-2 font-bold opacity-90">
            <span aria-hidden="true">📍</span>
            {BRAND_ADDRESS.label}
          </p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="/register"
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="relative isolate flex items-center justify-center overflow-hidden rounded-lg border border-[#6f0e08] bg-gradient-to-b from-[#c81e12] via-[#9d140c] to-[#6f0e08] px-8 py-3 font-black text-white shadow-[0_8px_22px_rgba(168,20,16,0.35)] transition-transform hover:scale-105">
        <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-white/10 to-transparent"></span>
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="flex items-center justify-center rounded-lg border-2 border-[#e2855c] bg-gradient-to-b from-[#ffffff] to-[#fde4d3] px-8 py-3 font-bold text-[#3f130d] shadow-[0_4px_14px_rgba(168,20,16,0.18)] transition-all hover:scale-105 hover:border-[#de2b1e] hover:shadow-[0_8px_22px_rgba(222,43,30,0.3)]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`ติดต่อทีมงาน ${BRAND_NAME} ผ่าน Line Official`}
