---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS } from "../lib/brandProfile";
import lineImage from "../assets/contact-line.webp";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, the LINE image, the address block, the buttons.
// Do not re-add section headings or explanatory prose here — no "เตรียมข้อมูล
// อะไรก่อนแจ้ง" list, no PIN/OTP notice, however well it reads. Every one of
// those was invented by an earlier rebrand, not by the brief. h1×1, h2×0, h3×0
//
// BRAND_ADDRESS derives itself from BRAND_NAME — never retype the lines or the
// email, and never pass either into the structured data.
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ — default message ของไฟล์
// นั้นเป็นคอปปี้ของ MIRACLE55 แล้ว และ index ก็เรียกแบบ bare จึงห้ามส่ง prop
// message จากหน้านี้
//
// พาเลตต์ MIRACLE55 เป็น "ทอง + เงินโครเมียมบนดำ" ตามโลโก้ที่ MI เป็นทอง RACLE เป็น
// เงินขัดเงา และ 55 เป็นทอง เฉดที่สองรอบนี้จึงเป็นโครเมียมเย็น ไม่ใช่ครีมอุ่น:
// เนื้อความ #e8e6e1 (BRAND_TEXT) · ทองแบรนด์ #fcda65 · ทองสว่าง #fee47b ·
// ทองทึบ/เส้นขอบ #d9a62b · ทองลึก #8c5f14 · เงินโครเมียม #d2d3d4 ·
// เงินสว่าง #eaeaea · ผิวการ์ด #14100a · ผิวยก #1b140b · พื้นเพจ #050403 ·
// เน้นใน strong #fcfcfc
// ปุ่มหลัก (สมัครสมาชิก) รับไล่สีทองของโลโก้ #fee47b → #fcda65 → #d9a62b และใช้
// ตัวอักษรดำ #14100a เพราะตัวอักษรบนพื้นทองห้ามเป็นสีขาว
// ปุ่มรอง (เข้าสู่ระบบ) เป็นฝั่ง "RACLE" ของโลโก้ — ขอบเงินโครเมียม #d2d3d4 บนผิว
// การ์ดเกือบดำ ไม่ใช่ทองอีกใบ เพราะหน้าที่ปุ่มทุกใบเป็นทองคือหน้าที่อ่านเป็นแบรนด์
// ก่อนหน้าเปลี่ยนชื่อ — ชุดทองล้วนของรอบก่อนถูกแทนครบทุกจุดแล้ว
// ส่วน #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ตามเดิม
//
// ป้ายที่อยู่ใช้ opacity ไม่ใช่คลาสสี ให้สืบทอดสีตัวอักษรจากการ์ด ส่วนสีทองมีเฉพาะ
// บนเส้นขอบและลิงก์อีเมล ซึ่งเป็น accent ไม่ใช่ body copy
//
// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. Keeping it in a const is what stops the meta tag
// and the structured data from drifting apart — they used to be two hand-typed
// variants of the same sentence, and the JSON-LD copy was the one nobody
// reread. 150–160 CHARACTERS (Thai is 3 bytes/char, so a byte count reads ~3x
// too long and will send you rewriting a description that was fine).
// This one is 157.
//
// คำศัพท์ตาม brief รอบนี้คือ "ไลน์แอด" ในเนื้อความและใน structured data —
// ป้ายบนปุ่มยังคงคำว่า Line Official ตามมาร์กอัปเดิมได้
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "ช่องทางติดต่อเจ้าหน้าที่ MIRACLE55 ผ่านไลน์แอดตลอด 24 ชั่วโมง สอบถามเรื่องการสมัครสมาชิก ทางเข้าเกมคาสิโน โปรโมชั่น หรือแจ้งปัญหาการใช้งานบัญชีได้ทุกช่วงเวลา";

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: "ติดต่อทีมงาน MIRACLE55",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    // `alternateName` is only for a genuine alternate NAME — an earlier brand
    // filled it with its own Thai spelling. The brief gives MIRACLE55 no second
    // registered name, so the field stays out rather than being invented
    // here: this page's Organization node must not disagree with the one
    // every other page emits, and it is not a slot for marketing copy.
    //
    // BRAND_ADDRESS is rendered in the body but never enters the graph —
    // address/PostalAddress/email in JSON-LD fails the build gate.
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: "ติดต่อเจ้าหน้าที่ผ่านไลน์แอด",
      },
    ],
  },
});
---

<MainLayout title="ติดต่อแอดมิน MIRACLE55 ผ่านไลน์แอด พร้อมให้บริการ 24 ชั่วโมง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน MIRACLE55" as="h1">
    <Picture
      src={lineImage}
      alt="พริตตี้ผมยาวสีน้ำตาลในชุดเลื่อมสีชมพูยืนกอดอกและยิ้ม ด้านล่างเป็นป้ายไอคอน LINE สีเขียวพร้อมคำว่า LINE Support ช่องทางติดต่อทีมงาน MIRACLE55"
      loading="lazy"
      fetchpriority="low"
      widths={[300, 400, 700]}
      sizes="(max-width: 420px) 100vw, 400px"
      class="mx-auto block h-auto w-full max-w-[400px]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 border-l-4 border-[#d9a62b] pl-6 text-left text-base leading-relaxed not-italic">
          <p class="mb-1 font-bold opacity-90">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold text-[#fcda65] underline decoration-current/40 underline-offset-4 transition-colors hover:text-[#d2d3d4]">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก MIRACLE55"
        class="flex items-center justify-center rounded-lg border border-[#fee47b]/60 bg-gradient-to-r from-[#fee47b] via-[#fcda65] to-[#d9a62b] px-8 py-3 font-black text-[#14100a] shadow-[0_0_15px_rgba(252,218,101,0.50)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ MIRACLE55"
        class="flex items-center justify-center rounded-lg border border-[#d2d3d4]/70 bg-[#14100a] px-8 py-3 font-bold text-[#e8e6e1] shadow-[0_0_15px_rgba(5,4,3,0.75)] transition-all hover:scale-105 hover:border-[#eaeaea] hover:bg-[#1b140b] hover:text-[#fcfcfc] hover:shadow-[0_0_18px_rgba(210,211,212,0.28)]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อทีมงาน MIRACLE55 ผ่าน Line Official"
        class="flex items-center justify-center gap-2 rounded-lg border border-[#00B900]/70 bg-gradient-to-r from-[#00B900] to-[#009900] px-8 py-3 font-bold text-white shadow-[0_10px_30px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
        <span aria-hidden="true" class="text-2xl">💬</span>
        <span>ติดต่อผ่าน Line Official</span>
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
