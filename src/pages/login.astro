---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
//
// KINGDOM66 (รอบทองราชวงศ์บนดำ 2026-09-25): ปุ่มนี้เป็นตัว SECONDARY ของคู่ —
// ผิวการ์ดยก #241c13 ในกรอบทองแบรนด์ #e6bf4e บนเนื้อความ #ebe3d3 แล้วยกเป็นทองลึก
// #5c4113 กับขอบแพลตินัมครีม #efe6cf ตอน hover ส่วน /register สวมไล่เฉดทองเต็มใบ
// ลำดับความสำคัญถูกสื่อด้วย "สีไหนถมเต็มปุ่ม" ไม่ใช่ความสว่าง ตามโลโก้ที่คำว่า
// KINGDOM เป็นทองสลักและเลข 66 เป็นทองสว่าง รอบนี้ไม่มีเฉดโครเมียมเย็น
// ชุดทอง-โครเมียมของ UWIN33 (#e0b429 #fbd564 #7a5407 #dfe4ec #161106 #26200e
// #ece6d8 #fff8e6 #080602) ออกครบแล้ว ห้ามนำกลับมา
//
// Announcement รอบนี้หมุนจาก AnnouncementPremium มาเป็น AnnouncementCyber ทั้งเว็บ —
// default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ index ก็เรียกแบบ bare
// จึงห้ามส่ง prop
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 158
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = "หน้าเข้าสู่ระบบ KINGDOM66 กดปุ่มเดียวเข้าบัญชีสมาชิกเพื่อเลือกเล่นบาคาร่า ไพ่ สล็อต หวย บอล และคาสิโนไลฟ์สด พร้อมตรวจสอบโปรโมชั่นที่เปิดให้รับสิทธิ์ในแต่ละวัน";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ KINGDOM66",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="เข้าสู่ระบบ KINGDOM66 ล็อกอินเข้าบัญชีสมาชิก เลือกเกมที่ต้องการได้ทันที" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ KINGDOM66" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ KINGDOM66"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#e6bf4e] bg-[#241c13] px-6 py-4 text-lg font-black text-[#ebe3d3] shadow-[0_10px_30px_rgba(5,4,3,0.85)] transition-all duration-300 hover:scale-105 hover:border-[#efe6cf] hover:bg-[#5c4113] hover:text-[#fdf6e0] hover:shadow-[0_15px_40px_rgba(230,191,78,0.45)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
