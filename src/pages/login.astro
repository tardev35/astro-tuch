---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// The button wears the metallic gold of the VAK88 wordmark on the navy-black
// surface; /register carries the crimson phoenix gradient, so the pair reads as
// primary + secondary.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 152.
const pageDescription =
  "หน้าเข้าสู่ระบบ VAK88 กดปุ่มเดียวเข้าบัญชีสมาชิกเพื่อเล่นสล็อตเว็บตรงลิขสิทธิ์แท้ พร้อมตรวจสอบเครดิตคงเหลือ โปรโมชั่น และรายการฝาก-ถอนอัตโนมัติของตัวเอง";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ VAK88",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="เข้าสู่ระบบ VAK88 ล็อกอินเข้าบัญชีสมาชิก เริ่มเล่นสล็อตเว็บตรงได้ทันที" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ VAK88" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ VAK88"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#e6b23c]/60 bg-[#121a2e] px-6 py-4 text-lg font-black text-[#e6b23c] shadow-[0_10px_30px_rgba(230,178,60,0.22)] transition-all duration-300 hover:scale-105 hover:border-[#ffd873] hover:bg-[#0b1020] hover:text-[#ffd873] hover:shadow-[0_15px_40px_rgba(230,178,60,0.40)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
