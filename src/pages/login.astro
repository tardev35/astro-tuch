---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — this page is indexed and must not
// describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// The button is the SECONDARY of the pair on the 365LOTTO palette: card surface
// (#1a0709) inside a brand-gold outline (#fadc64) over body ink (#f0ddc4),
// lifting to chrome white (#f3f6fa) on the raised surface (#33100f) on hover,
// while /register wears the full gold-gradient fill of the logo's "365".
// The tier is carried by which of the two brand hues fills the button, not by
// brightness.
//
// Announcement รอบนี้หมุนมาใช้ AnnouncementHuay ทั้งเว็บ — default message ของไฟล์นั้น
// ถูกตั้งเป็นคอปปี้ของแบรนด์นี้แล้ว และ index ก็เรียกแบบ bare จึงห้ามส่ง prop
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 157
const pageDescription = "หน้าเข้าสู่ระบบ 365LOTTO กดปุ่มเดียวเข้าบัญชีสมาชิกเพื่อเลือกหวยรัฐบาลไทย ฮานอย ลาวพัฒนา บาคาร่า ไพ่ และสล็อต พร้อมตรวจสอบอัตราจ่ายและโปรโมชั่นของรอบปัจจุบัน";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ 365LOTTO",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="เข้าสู่ระบบ 365LOTTO ล็อกอินเข้าบัญชีสมาชิก เลือกหวยและเกมที่ต้องการ" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ 365LOTTO" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ 365LOTTO"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fadc64] bg-[#1a0709] px-6 py-4 text-lg font-black text-[#f0ddc4] shadow-[0_10px_30px_rgba(18,4,6,0.7)] transition-all duration-300 hover:scale-105 hover:border-[#ffe9a3] hover:bg-[#33100f] hover:text-[#f3f6fa] hover:shadow-[0_15px_40px_rgba(250,220,100,0.45)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
