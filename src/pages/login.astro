---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1×1, h2×0, h3×0. Never write an article here and never add an <h2>.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change.
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens. It is an indexed page now, which
// means verify-build holds its description to the same 150–160 character window
// as every other page.
//
// NAZA168 (รอบทองอวกาศ-เงินโครเมียม 2026-10-10, brand-spec §2):
// ทองแบรนด์ #fbc134 (ฮิวหลัก) · ทองสว่าง #ffe87a · ทองกลางเข้ม #cf9a18 ·
// เงินโครเมียม #cfd6e3 (ฮิวที่สอง) · เนื้อความ #fdf3df · หมึกบนพื้นถมทอง #231500 ·
// ชั้นผิว ยก #4e3406 / กลาง #432b03 / ลึก #382400 / ลึกสุด #241700
// (พื้นเพจจาก bg.json = #382400 น้ำตาลไหม้เข้ม)
// ปุ่มนี้เป็นคู่ SECONDARY เดียวกับ /ทางเข้า: จมลงจากการ์ด ContentBox (ผิวยก
// #4e3406) ด้วยชั้นลึก #382400 → #241700 ขอบเงินโครเมียม #cfd6e3/55 บนเนื้อความ
// #fdf3df (13.5:1 / 16.0:1) hover ยกขอบเป็นเงินเต็ม #cfd6e3
// — ส่วน /register เป็น PRIMARY ถมทอง จึงไม่ซ้ำกัน
// ⚠️ ห้ามใช้ผิวยก #4e3406 เป็นพื้นปุ่ม มันเป็นสีเดียวกับการ์ดที่ปุ่มวางอยู่
// ⚠️ #96690a #6b4a05 #3f4859 ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่เส้นขอบ ออรา และเงา
// — ออราใช้ rgba(207,214,227,α) เท่านั้นในไฟล์นี้ นอกจากเงาดำล้วน
// ⚠️ แบรนด์รอบก่อน (FLASH877) ก็เป็นแบรนด์ "ทอง" เหมือนกัน เจอทองที่ไหนห้ามเหมาว่า
// เป็นของรอบนี้ ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน brand-spec §2 — ชุด
// #f5c518 #ffdd73 #b8860f #ff3b14 #5c0000 #430000 #fdf0e2 #2a0300
// rgba(245,197,24,α) rgba(255,59,20,α) ออกครบแล้ว และรอบนี้ไม่มีสีแดงเป็นฮิวเลย
//
// Announcement หมุนมาเป็น AnnouncementPremium ทั้งเว็บรอบนี้ และเรียกแบบ bare
// ทุกหน้า — ห้ามส่ง prop message จากหน้านี้
//
// แบรนด์นี้เป็นเว็บสล็อตนาซ่าล้วนๆ ไม่ใช่เว็บหวย — รายการคำต้องห้ามเต็มอยู่ใน
// brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep เจอ false positive
// ⚠️ ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 0.3% / 0.8% / 24 ชั่วโมง / 100%
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) หน้านี้ยาว 158
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าเข้าสู่ระบบ ${BRAND_NAME} เว็บสล็อตนาซ่า กดปุ่มเดียวไปยังช่องทางหลัก เข้าใช้งานเพื่อค้นหาเกม ตรวจสอบเครดิต ติดตามโปรโมชั่น และตรวจสอบยอดเดิมพันจากแพลตฟอร์มเดียว`;

const graph = pageGraph(Astro, {
  name: `เข้าสู่ระบบ ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`เข้าสู่ระบบ ${BRAND_NAME} เว็บสล็อตนาซ่า เข้าใช้งานจากช่องทางหลัก`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`เข้าสู่ระบบ ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#cfd6e3]/55 bg-gradient-to-b from-[#382400] to-[#241700] px-6 py-4 text-2xl font-bold tracking-wide text-[#fdf3df] shadow-[0_10px_30px_rgba(0,0,0,0.55)] transition-all duration-300 hover:scale-105 hover:border-[#cfd6e3] hover:shadow-[0_15px_40px_rgba(207,214,227,0.4)]">
        <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#cfd6e3]/25 to-transparent"></div>
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
