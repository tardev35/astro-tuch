---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — this page is indexed and must not
// describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// The button is the SECONDARY of the pair on the SAGAME66 palette: card surface
// (#171006) inside a brand-gold outline (#e8b93f) over body ink (#e3d8c0),
// lifting to chrome silver (#eef3f8) on the raised surface (#2a1d0b) on hover,
// while /register wears the full gold-gradient fill of the logo's "SA".
// The tier is carried by which of the two brand hues fills the button, not by
// brightness.
//
// Announcement รอบนี้หมุนมาใช้ Announcement5 ทั้งเว็บ — default message ของไฟล์นั้น
// ถูกตั้งเป็นคอปปี้ของแบรนด์นี้แล้ว และ index ก็เรียกแบบ bare จึงห้ามส่ง prop
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 154
const pageDescription = "หน้าเข้าสู่ระบบ SAGAME66 กดปุ่มเดียวเข้าบัญชีสมาชิกเพื่อเลือกบาคาร่า รูเล็ต คาสิโนสด และเกมโต๊ะจากค่ายที่เปิดให้บริการ พร้อมตรวจสอบโปรโมชั่นของรอบปัจจุบัน";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ SAGAME66",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="เข้าสู่ระบบ SAGAME66 ล็อกอินเข้าบัญชีสมาชิก เลือกเกมที่ต้องการ" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ SAGAME66" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ SAGAME66"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#e8b93f] bg-[#171006] px-6 py-4 text-lg font-black text-[#e3d8c0] shadow-[0_10px_30px_rgba(13,9,3,0.7)] transition-all duration-300 hover:scale-105 hover:border-[#ffe9a3] hover:bg-[#2a1d0b] hover:text-[#eef3f8] hover:shadow-[0_15px_40px_rgba(232,185,63,0.45)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
