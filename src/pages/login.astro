---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// The button is the SECONDARY of the pair: near-black card surface (#140a0c)
// with a logo-red outline (#c21e22), while /register wears the solid red
// gradient.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 158.
const pageDescription = "หน้าเข้าสู่ระบบ LOTTOKA กดปุ่มเดียวเข้าบัญชีสมาชิกเพื่อแทงหวยรัฐบาลไทย ลาวพัฒนา ออมสิน ฮานอย และหวยหุ้น พร้อมฝาก-ถอนออโต้เข้าบัญชีบริษัทโดยตรง ตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ LOTTOKA",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="เข้าสู่ระบบ LOTTOKA ล็อกอินเข้าบัญชีสมาชิก เริ่มแทงหวยได้ทันที" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ LOTTOKA" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ LOTTOKA"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#c21e22]/60 bg-[#140a0c] px-6 py-4 text-lg font-black text-[#ff9a9d] shadow-[0_10px_30px_rgba(194,30,34,0.22)] transition-all duration-300 hover:scale-105 hover:border-[#e2353a] hover:bg-[#1c0d0f] hover:text-[#ffe9ea] hover:shadow-[0_15px_40px_rgba(194,30,34,0.40)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
