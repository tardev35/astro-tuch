---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — this page is indexed and must not
// describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// The button is the SECONDARY of the pair on the ABM96 palette: dark card
// surface (#1d0611) inside a primary-pink outline (#fd6494) over body ink
// (#fbe3ee), lifting to light pink (#ffc9dc) on a lighter surface (#2a0a1a) on
// hover, while /register wears the full pink-gradient fill. The tier is carried
// by the brightness of the fill, not by a second hue.
//
// Announcement รอบนี้หมุนมาใช้ Announcement3 ทั้งเว็บ — default message ของไฟล์นั้น
// เป็นคอปปี้ของแบรนด์นี้อยู่แล้วและ index ก็เรียกแบบ bare จึงห้ามส่ง prop
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 155
const pageDescription = "หน้าเข้าสู่ระบบ ABM96 กดปุ่มเดียวเข้าบัญชีสมาชิกเพื่อเลือกหมวดเกมที่ต้องการ ทั้งบาคาร่า สล็อต หวย ไฮโล และบอล พร้อมตรวจสอบโปรโมชั่นและยอดที่เข้าเกณฑ์ของรอบ";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ ABM96",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="เข้าสู่ระบบ ABM96 ล็อกอินเข้าบัญชีสมาชิก เลือกหมวดเกมที่ต้องการ" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ ABM96" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ ABM96"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fd6494] bg-[#1d0611] px-6 py-4 text-lg font-black text-[#fbe3ee] shadow-[0_10px_30px_rgba(18,3,10,0.7)] transition-all duration-300 hover:scale-105 hover:border-[#ffc9dc] hover:bg-[#2a0a1a] hover:text-[#ffc9dc] hover:shadow-[0_15px_40px_rgba(253,100,148,0.36)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
