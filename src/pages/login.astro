---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — this page is indexed and must not
// describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// The button is the SECONDARY of the pair on the 888PARUAY palette: card
// surface (#0d2312) inside a brand-gold outline (#fcdc2b) over body ink
// (#e8e4c6), lifting to #fffdf0 on the raised surface (#143a1c) on hover,
// while /register wears the full gold-gradient fill of the logo's ring.
// The tier is carried by which of the two brand hues fills the button, not by
// brightness. ชุดแดง-ทองของ 365LOTTO (#fadc64 #ffe9a3 #9c6a12 #f0ddc4 #1a0709
// #33100f #120406 #f3f6fa) ออกครบแล้ว
//
// Announcement รอบนี้หมุนจาก AnnouncementHuay มาเป็น Announcement3 ทั้งเว็บ —
// default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ index ก็เรียกแบบ bare
// จึงห้ามส่ง prop
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 158
const pageDescription = "หน้าเข้าสู่ระบบ 888PARUAY กดปุ่มเดียวเข้าบัญชีสมาชิกเพื่อเลือกแทงหวยรัฐบาลไทย ฮานอย ลาวพัฒนา และหุ้นต่างประเทศ พร้อมตรวจสอบรอบที่เปิดรับและอัตราจ่ายของรอบนั้น";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ 888PARUAY",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="เข้าสู่ระบบ 888PARUAY ล็อกอินเข้าบัญชีสมาชิก เลือกรอบหวยที่ต้องการ" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ 888PARUAY" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ 888PARUAY"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fcdc2b] bg-[#0d2312] px-6 py-4 text-lg font-black text-[#e8e4c6] shadow-[0_10px_30px_rgba(7,19,10,0.75)] transition-all duration-300 hover:scale-105 hover:border-[#fff6ae] hover:bg-[#143a1c] hover:text-[#fffdf0] hover:shadow-[0_15px_40px_rgba(252,220,43,0.45)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
