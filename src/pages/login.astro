---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change (CtaRedirect.astro
// itself belongs to the orchestrator — ห้ามแก้ไฟล์นั้นจากหน้านี้)
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page, which means verify-build holds its
// description to the same 150–160 character window as every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) **ไม่มีส่วน SUB-PAGES** → title/description
// ของหน้านี้เขียนเอง และพูดได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 6: ควรตรวจสอบเงื่อนไข
// ของแต่ละโปรโมชั่นก่อนรับโบนัส · บรรทัด 22: ควรตรวจสอบรายชื่อธนาคารที่รองรับและ
// ข้อกำหนดการถอนเงิน · บรรทัด 24: ควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการ)
// ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า — หน้านี้มีโควตาเป็น **ปุ่มเดียว**
//
// ⚠️ น้ำเสียงของบรีฟรอบนี้คือ "ข้อมูล + เตือนให้ตรวจสอบ" ไม่ใช่โฆษณาการันตี
// คลังคำที่ใช้ได้รอบนี้อยู่ใน .claude/brand-spec-okkub88.md §5 (ไม่พิมพ์ซ้ำที่นี่
// และ **ไม่พิมพ์คำของแบรนด์เก่าซ้ำที่นี่** เพื่อไม่ให้ sweep ของรอบถัดไปเจอ
// false positive ในคอมเมนต์ของไฟล์นี้เอง)
// ตัวเลขที่อ้างได้รอบนี้มีแค่ 0.3% · 0.8% · 3 ขั้นตอน · 24ชม. — ห้ามแต่งใบอนุญาต
// จำนวนเกม จำนวนค่าย ค่า RTP ยอดขั้นต่ำเป็นตัวเลข หรือค่าร้อยละเต็มจำนวน
// ⚠️ บรีฟรอบนี้เขียน **ทรูวอลเลท** (ไม่ใช่คำของรอบก่อน) — ห้ามสลับคำ
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตรอบนี้อยู่ใน .claude/brand-spec-okkub88.md §2 — ธีมสว่าง "บับเบิลกัม"
// bg.json = {"mode":"color","color":"#ffd6fa"} = **ชมพูบับเบิลกัมพาสเทล**
// (รอบก่อนเป็นฟ้าสกาย — ค่ามาจากไฟล์ ห้ามเดาว่าเท่าเดิม และห้าม "แก้" การ์ดให้มืด)
// การ์ด ContentBox จึงเป็นผิว #ffffff บนหมึก #6a0f3c (= BRAND_TEXT, 12.1:1)
// ปุ่มนี้เป็นคู่ **รอง (secondary)** ของพาเลต: ไล่เฉดขาว #ffffff -> #ffe3f5
// บนหมึกเบอร์รีเข้ม #6a0f3c (12.1 / 11.0:1 — ผ่านทั้งสอง stop)
// ส่วน /register เป็น **หลัก (primary)** ไล่เฉด #d91a73 -> #b01160 -> #85094a
// บนหมึกขาว จึงไม่ซ้ำกัน
// 🚨🚨 **ขาวบน #fb439b ได้แค่ 3.3:1 และบน #ffd6fa ได้ 1.2:1** พื้นถมสว่างต้องคู่กับ
// หมึกเข้มเสมอ และพื้นชมพูที่ถือหมึกขาวได้ต้องเข้มถึง #d91a73 (4.8:1) ลงไป
// ห้ามกลับด้านทั้งสองกรณี
// 🚨🚨 **#ffd6fa / #fb439b / #fc74b5 / #ffc2e2 / #f9b2d9 / #f479b9 / #f4a7cf
// ห้ามถือตัวอักษรบนผิวสว่าง** เป็นพื้นถม/ขอบ/ออราเท่านั้น · ที่ถือตัวอักษรได้บน
// ผิวสว่างชุดนี้คือ #6a0f3c (12.1:1) · #9c0f55 (8.1:1) · #95486b (6.2:1) ·
// #d91a73 (คู่กับขาว 4.8:1)
// ⚠️ ปุ่มนี้ผิวขาวบนการ์ดขาว — **ขอบ #f479b9 คือสิ่งเดียวที่แยกปุ่มออกจากการ์ด
// ห้ามถอดออก** และห้ามเปลี่ยนเป็นขอบจางกว่านี้
// ⚠️⚠️ **วัสดุของรอบนี้คือเจลลี่ชมพูบับเบิลกัมตัดขอบขาวหนา** อ่านจากอาร์ตเวิร์ก
// ตรงๆ: โลโก้เป็นเวิร์ดมาร์กละตินทรงเจลลี่สามมิติ ตัวแรกเป็นหน้าการ์ตูนกลมชมพู
// ขยิบตา มือสวมถุงมือขาวชูสองนิ้ว มีหัวใจชมพูประดับ
// ⚠️⚠️ **หมูการ์ตูนชมพู เหรียญทอง กล่องของขวัญ ฉากสตูดิโอขาว และสีผิวนักแสดง
// เป็นวัตถุในภาพ ไม่ใช่สี UI** — พื้นเพจมาจาก bg.json เท่านั้น
// ⚠️ ปุ่มของ Navfoot อยู่บนแถบโครมคนละโซนกับปุ่มบนการ์ดนี้
// **ห้ามลอกคลาสของ Navfoot มาวางบนการ์ด**
// ออราในไฟล์นี้ใช้ rgba(156,15,85,α) · rgba(251,67,155,α) เท่านั้น
//
// ⚠️⚠️ กับดักรอบนี้คือ **ชมพู** — รีโปนี้เคยมีแบรนด์ชมพู/แมเจนต้ามาแล้วหลายเจ้า
// (ตัวที่ใกล้ที่สุดคือสองรอบก่อน) "มีชมพูอยู่แล้ว" จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้
// ให้เทียบเป็น **"ค่า" ทีละหลัก** กับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive
// **ชมพูของรอบนี้คือ #ffd6fa / #fff4fb / #ffe3f5 / #ffc2e2 / #f9b2d9 / #f479b9 /
// #fc74b5 / #fb439b / #d91a73 / #b01160 / #9c0f55 / #85094a / #95486b / #6a0f3c
// เท่านั้น**
// รอบนี้ **ไม่มีฟ้า/ไซแอน/น้ำเงิน (ฮิวของแบรนด์ขาออกทันที) ไม่มีทอง ไม่มีเหลือง
// ไม่มีส้ม ไม่มีเขียว (ยกเว้น LINE green ที่หน้าอื่น) ไม่มีม่วง ไม่มีน้ำตาล
// ไม่มีครีม และไม่มีเทาเงิน** การปล่อยฟ้าไว้ = ทั้งผิดพาเลตและหลงเหลือข้ามแบรนด์
// พร้อมกัน
//
// Announcement หมุนมาเป็น `Announcement3.astro` ทั้งเว็บรอบนี้ (brand-spec §3 —
// รอบก่อนใช้ตัวฐานจึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็น
// คอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare — **ห้ามส่ง prop message**
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) สตริงนี้ยาว 153
// ด้วยชื่อแบรนด์ 7 อักขระของรอบนี้ ส่วนที่ไม่ใช่ชื่อแบรนด์ยาว 146 → รับชื่อแบรนด์
// ได้ 4–14 อักขระ ถ้ารอบหน้าชื่อยาวกว่านั้นต้องตัดข้อความ ไม่ใช่ปล่อยผ่าน
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าเข้าสู่ระบบ ${BRAND_NAME} เว็บสล็อตเงินดี ทางเข้าเล่นง่าย กดปุ่มเดียวเพื่อเข้าบัญชีสมาชิก ควรตรวจสอบเงื่อนไขโบนัสและรายการฝากถอนจากประกาศล่าสุดก่อนทำรายการ`;

const graph = pageGraph(Astro, {
  name: `เข้าสู่ระบบ ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/hx8w";
---

<MainLayout title={`เข้าสู่ระบบ ${BRAND_NAME} ทางเข้าเล่นง่าย กดปุ่มเดียวเข้าบัญชีสมาชิก`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`เข้าสู่ระบบ ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="group mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 rounded-xl border-2 border-[#f479b9] bg-gradient-to-b from-[#ffffff] to-[#ffe3f5] px-6 py-4 text-2xl font-bold tracking-wide text-[#6a0f3c] shadow-[0_10px_30px_rgba(156,15,85,0.18)] transition-all duration-300 hover:scale-105 hover:border-[#fb439b] hover:shadow-[0_15px_40px_rgba(251,67,155,0.32)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
