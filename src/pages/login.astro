---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
//
// MIRACLE55 (รอบทอง + เงินโครเมียมบนดำ 2026-09-25): ปุ่มนี้เป็นตัว SECONDARY ของคู่
// และรับฝั่ง "RACLE" ของโลโก้ที่เป็นเงินขัดเงา — ผิวการ์ดยก #1b140b ในกรอบเงิน
// โครเมียม #d2d3d4 บนเนื้อความ #e8e6e1 แล้วยกเป็นผิว #2c241c กับขอบเงินสว่าง
// #eaeaea ตัวอักษรเน้น #fcfcfc ตอน hover ส่วน /register สวมไล่เฉดทองเต็มใบ
// ลำดับความสำคัญถูกสื่อด้วย "โลหะไหนถมเต็มปุ่ม" ตามโลโก้ที่ MI กับ 55 เป็นทองและ
// RACLE เป็นเงิน — สองโลหะ ไม่ใช่ทองสองใบ ซึ่งจะอ่านเป็นแบรนด์ก่อนหน้าเปลี่ยนชื่อ
// ชุดทองล้วนของรอบก่อนออกครบแล้ว ห้ามนำกลับมา
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ — default message ของไฟล์
// นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ index ก็เรียกแบบ bare จึงห้ามส่ง prop
//
// MIRACLE55 เป็นแบรนด์คาสิโน — คำศัพท์เฉพาะหมวดของแบรนด์ก่อนหน้าห้ามหลงเหลือในหน้านี้
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 155
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = "หน้าเข้าสู่ระบบ MIRACLE55 กดปุ่มเดียวเข้าบัญชีสมาชิกเพื่อเลือกเล่นเกมคาสิโนสดและเกมโต๊ะจากหลายค่าย พร้อมตรวจสอบรายการโปรโมชั่นที่เปิดให้รับสิทธิ์ในแต่ละวัน";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ MIRACLE55",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="เข้าสู่ระบบ MIRACLE55 ล็อกอินเข้าบัญชีสมาชิก เลือกเกมที่ต้องการได้ทันที" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ MIRACLE55" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ MIRACLE55"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#d2d3d4] bg-[#1b140b] px-6 py-4 text-lg font-black text-[#e8e6e1] shadow-[0_10px_30px_rgba(5,4,3,0.85)] transition-all duration-300 hover:scale-105 hover:border-[#eaeaea] hover:bg-[#2c241c] hover:text-[#fcfcfc] hover:shadow-[0_15px_40px_rgba(210,211,212,0.28)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
