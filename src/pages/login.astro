---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 159.
const pageDescription =
  "หน้าเข้าสู่ระบบ LION991 กดปุ่มเดียวเข้าบัญชีสมาชิกเพื่อเข้าเล่นคาสิโนสดต่อได้ทันที พร้อมตรวจสอบเครดิตคงเหลือ โปรโมชั่นที่รับได้ และประวัติรายการฝากถอนของตัวเอง";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ LION991 ล็อกอินเข้าบัญชีสมาชิก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="เข้าสู่ระบบ LION991 ล็อกอินเข้าบัญชีสมาชิก เข้าเล่นคาสิโนสดได้ทันที" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ LION991" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ LION991"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#1046e0] bg-[#01041c] px-6 py-4 text-lg font-black text-[#8fc2ff] shadow-[0_10px_30px_rgba(16,70,224,0.20)] transition-all duration-300 hover:scale-105 hover:border-[#b7c6dd] hover:bg-[#0a3390] hover:shadow-[0_15px_40px_rgba(183,198,221,0.40)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
