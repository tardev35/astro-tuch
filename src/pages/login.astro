---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1×1, h2×0, h3×0. Never write an article here and never add an <h2>.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change.
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page, which means verify-build holds its
// description to the same 150–160 character window as every other page.
//
// ⚠️ TIGERWIN369 เป็น **เกมคาสิโนรวม** (บาคาร่า · สล็อต · บอลออนไลน์ · ไฮโล ·
// ยิงปลา) ไม่ใช่เว็บเกมกีฬาแบบแบรนด์ก่อน และไม่ใช่เว็บลอตเตอรี คอปปี้ของหน้านี้จึง
// พูดถึง "ทางเข้าหลัก" และ "หมวดเกม" ไม่ใช่กรอบเล่าเรื่องแบบเว็บกีฬา — รายการคำที่
// ห้ามหลุดกลับมาอยู่ใน brand-spec §7 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำต้องห้าม
// เจอ false positive
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% / 0.8% / 3 ขั้นตอน / 24 ชั่วโมง — ห้าม
// แต่งใบอนุญาต หน่วยงานกำกับ ชื่อค่ายเกม ชื่อธนาคาร ชื่อลีก/ทีม หรือยอดขั้นต่ำเป็นตัวเลข
//
// TIGERWIN369 (รอบทองอำพันเสือบนดำสนิท 2026-10-11, brand-spec §2):
// ทองอำพัน #d98324 (ฮิวหลัก) · ทองสว่าง #f7b733 (ฮิวที่สอง) · ทองซีด #ffd98a
// (ไฮไลต์ในเนื้อความเท่านั้น) · อำพันลึก #8a5214 และ #4a2a08 (เส้น/ขอบ/ออราเท่านั้น) ·
// เนื้อความ #f7e4c0 (= BRAND_TEXT) · หมึกบนพื้นทอง #1a0d02
// ชั้นผิว: ยก #2d1c0a (= การ์ด ContentBox) / กลาง #1c1206 / จม #0f0903 /
// พื้นเพจ #000000 — รอบนี้ bg.json เป็นดำสนิท จึง **ไม่มีชั้นที่ลึกกว่าพื้นเพจ**
// ได้อีก (ค่าของรอบก่อนอยู่ใน §2 ไม่พิมพ์ซ้ำที่นี่)
// ปุ่มนี้เป็นคู่ SECONDARY: จมลงจากการ์ดด้วยชั้น #1c1206 → #0f0903 ขอบทองอำพัน
// #d98324/50 บนเนื้อความ #f7e4c0 (13.3:1 บน #1c1206) — hover ยกขอบเป็นทองเต็ม
// ส่วน /register เป็น PRIMARY ถมพื้นทอง จึงไม่ซ้ำกัน
// ⚠️ ห้ามใช้ผิวยก #2d1c0a เป็นพื้นปุ่ม มันเป็นสีเดียวกับการ์ดที่ปุ่มวางอยู่
// ⚠️ #8a5214 #4a2a08 ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่เส้นขอบ ออรา และเงา
// — ออราในไฟล์นี้ใช้ rgba(217,131,36,α) เท่านั้น นอกจากเงาดำล้วน
// ⚠️ รอบนี้เป็นทองรอบที่แปดในสิบรอบ "เจอทอง" ไม่ได้แปลว่าถูกค่า ให้เทียบเป็นตัวๆ กับ
// ตารางแบนใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่า
// เจอ false positive — ชุดทองแชมเปี้ยน-เงินโครเมียมของรอบก่อนออกครบทุกจุดในไฟล์นี้แล้ว
// และรอบนี้ **ไม่มีเงิน ไม่มีเทา ไม่มีฮิวเย็นเลย**
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ (ตัวที่แบรนด์ก่อนใช้ถูกหมุน
// ออกตาม brand-spec §3) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้
// ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare — ห้ามส่ง prop message จากหน้านี้
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) หน้านี้ยาว 155
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าเข้าสู่ระบบ ${BRAND_NAME} เกมคาสิโนรวม กดปุ่มเดียวไปยังทางเข้าหลักของเว็บ เพื่อเลือกหมวดเกมบาคาร่า สล็อต บอลออนไลน์ ไฮโล ยิงปลา และจัดการบัญชีสมาชิกของตน`;

const graph = pageGraph(Astro, {
  name: `เข้าสู่ระบบ ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`เข้าสู่ระบบ ${BRAND_NAME} เกมคาสิโนรวม เข้าจากทางเข้าหลัก`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`เข้าสู่ระบบ ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#d98324]/50 bg-gradient-to-b from-[#1c1206] to-[#0f0903] px-6 py-4 text-2xl font-bold tracking-wide text-[#f7e4c0] shadow-[0_10px_30px_rgba(0,0,0,0.55)] transition-all duration-300 hover:scale-105 hover:border-[#d98324] hover:shadow-[0_15px_40px_rgba(217,131,36,0.4)]">
        <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#d98324]/25 to-transparent"></div>
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
