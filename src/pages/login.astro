---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// WIN999 (รอบทอง-ดำ 2026-09-29): ปุ่มนี้เป็นตัว SECONDARY ของคู่ จึงเป็นแบบ OUTLINE
// — ผิวการ์ดอุ่น #191712 ในกรอบทองแบรนด์ #fcc403 บนตัวอักษรทองสว่าง #fdda04 แล้ว
// ยกผิวขึ้นเป็น #241f14 ตอน hover ส่วน /register สวมไล่เฉดทองเต็มใบ
// (#fdda04 → #fcc403 → #e0a800) ลำดับความสำคัญรอบนี้สื่อด้วย "ถมทอง vs กรอบทอง"
// เพราะพาเลตต์เหลือสีเดียว จะใช้วิธีคู่สีแบบแดง-ทองของรอบก่อนไม่ได้ — สองปุ่มที่
// ถมทองเหมือนกันจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม
// ชุดแดง+ทองของแบรนด์ก่อนหน้า (#dc2626 #fc2b2c #b40102 #fde68a #fbbf24 #a16207
// #2a0405 #7f1d1d #f6e2e2 #fff7e0 rgba(220,38,38,*) rgba(251,191,36,*)) ออกครบแล้ว
// ห้ามนำกลับมา
//
// Announcement หมุนจาก AnnouncementHuay มาเป็น AnnouncementPremium ทั้งเว็บรอบนี้ —
// default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ index ก็เรียกแบบ bare
//
// WIN999 เป็นเว็บคาสิโนออนไลน์ — บรีฟพูดถึงบาคาร่า สล็อต เกมไพ่ ค่ายเกม เครดิต
// ประวัติรายการ ฝากถอนออโต้ บัญชีบริษัท โบนัสคืนยอดเสีย 0.3% โบนัสแนะนำเพื่อน 0.8%
// และแอดมิน 24 ชม. เท่านั้น คำศัพท์ตระกูลสลาก/ลอตเตอรีของแบรนด์ก่อน
// (เลข 2 ตัว/3 ตัว อัตราจ่าย 1,000 บิล/โพย ม้า เอเย่นต์) ห้ามหลงเหลือ
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 159
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = "หน้าเข้าสู่ระบบ WIN999 กดปุ่มเดียวเข้าบัญชีสมาชิกเพื่อเลือกบาคาร่า สล็อต และเกมไพ่ พร้อมตรวจสอบเครดิต โปรโมชั่น และรายการฝากถอนออโต้ได้จากบัญชีเดียวทุกช่วงเวลา";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ WIN999",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="เข้าสู่ระบบ WIN999 ล็อกอินเข้าบัญชีสมาชิก เลือกเกมคาสิโนได้ทันที" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ WIN999" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ WIN999"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fcc403] bg-[#191712] px-6 py-4 text-lg font-black text-[#fdda04] shadow-[0_10px_30px_rgba(3,2,0,0.85)] transition-all duration-300 hover:scale-105 hover:border-[#fdda04] hover:bg-[#241f14] hover:text-[#fffbea] hover:shadow-[0_15px_40px_rgba(252,196,3,0.30)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
