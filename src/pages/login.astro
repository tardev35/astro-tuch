---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char).
const pageDescription =
  "หน้าเข้าสู่ระบบ PLUSPSG สล็อตแตกโคตรเก่ง กดปุ่มเดียวเพื่อเข้าบัญชีสมาชิก เลือกเกมสล็อตทุกค่าย ฝากถอนเครดิต ตรวจสอบโบนัสและยอดคืนยอดเสียได้ในบัญชีเดียว";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ PLUSPSG ล็อกอินเข้าบัญชีสมาชิก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="เข้าสู่ระบบ PLUSPSG สล็อตแตกโคตรเก่ง ล็อกอินเข้าบัญชีสมาชิกเพื่อปั่นสล็อต" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ PLUSPSG" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ PLUSPSG"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#c2a878]/70 bg-[#0b0402] px-6 py-4 text-lg font-black text-[#fff6e0] shadow-[0_10px_30px_rgba(226,6,10,0.18)] transition-all duration-300 hover:scale-105 hover:border-[#fbbf14] hover:bg-[#240803] hover:shadow-[0_15px_40px_rgba(250,226,30,0.30)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
