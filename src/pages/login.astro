---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change (CtaRedirect.astro
// itself belongs to the orchestrator — ห้ามแก้ไฟล์นั้นจากหน้านี้)
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page, which means verify-build holds its
// description to the same 150–160 character window as every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES — คอปปี้ของหน้านี้จึงพูด
// ได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 4: ภายในเว็บไซต์มีเมนูสำหรับศึกษากติกาเกม
// ตรวจสอบเงื่อนไขการเดิมพัน และเลือกดูข้อมูลค่ายเกมที่สนใจ · บรรทัด 8: ควรตรวจสอบ
// ประกาศล่าสุดก่อนเข้าร่วมโปรโมชั่น · บรรทัด 16: ควรตรวจสอบช่องทางติดต่อจาก
// เว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง)
// ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า หน้านี้มีโควตาเป็นปุ่มเดียว
//
// ⚠️ แกนของบรีฟรอบนี้คือ **เว็บสล็อต** (ระบบสล็อตเว็บนอก · ค่ายแท้ถูกลิขสิทธิ์ ·
// สล็อตคลาสสิก · รอบโบนัส · สัญลักษณ์พิเศษ) **ไม่ใช่เว็บหวยแบบรอบก่อน** —
// เป็นการกลับทิศ ไม่ใช่สถานะที่สืบทอดมา คำนิยามตัวเองของรอบก่อนห้ามเหลือ
// (brand-spec §5) ศัพท์หมวดหวยที่บรีฟไม่มีทุกคำจึงเป็นของค้างที่ห้ามหลุดกลับมา
// รายการคำเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไป
// เจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// คำที่ใช้ได้รอบนี้: สล็อต168 · ระบบสล็อตเว็บนอก · ทางเข้าเล่นฐานเกมหลัก ·
// ไม่ผ่านเอเย่นต์100% · ค่ายแท้ถูกลิขสิทธิ์ · ฝากถอนยอดเข้าบริษัทแม่โดยตรง ·
// สล็อตคลาสสิก · รอบโบนัส · สัญลักษณ์พิเศษ · ค่ายผู้พัฒนาเกม · กติกาเกม ·
// เงื่อนไขการเดิมพัน · จ่ายสูง โบนัสเพียบ · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% ·
// ไม่จำกัด · เครดิต · ยอดเสีย · ระบบฝากถอน · ธนาคารและทรูมันนี่ · ยอดขั้นต่ำ ·
// ชื่อบัญชีปลายทาง · บัญชีแอบอ้าง · ธุรกรรม · หมายเลขรายการ · หลักฐาน ·
// สมัครสมาชิก · เข้าสู่ระบบ · แอดมิน 24ชม. · เว็บไซต์ทางการ · ประกาศล่าสุด ·
// รหัสผ่าน · รหัส OTP
// ⚠️⚠️ **คำคู่ของแบรนด์เก่าที่ต่อท้ายชื่อ route /ทดลองเล่น ด้วย ฟรี / โหมด~
// ไม่ใช่คำของบรีฟรอบนี้** (คำเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่)
// ⚠️ **สองหน้าหมวดหวยถูกปิดรอบนี้** (/ตรวจหวย และ /แนวทาง ย้ายไป
// src/pages-disabled/ เพราะรอบนี้เป็นเว็บสล็อต) และหน้านี้มีโควตาเป็นปุ่มเดียว
// จึงไม่ลิงก์ไปที่อื่นเพิ่มอยู่แล้ว
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกม ชื่อธนาคาร ชื่อวอลเล็ต หน่วยงานกำกับ
// หรือใบอนุญาต แม้แต่รายเดียว** (พูดถึง "ธนาคารและทรูมันนี่" แบบรวมๆ เท่านั้น)
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 100% (เฉพาะในวลี
// ไม่ผ่านเอเย่นต์100%) · 24ชม. **ไม่มีค่า RTP ไม่มีจำนวนเกม ไม่มีจำนวนค่าย
// ไม่มีวลีจำนวนขั้นตอน ไม่มียอดฝากขั้นต่ำเป็นตัวเลข และไม่มีอัตราจ่ายเป็นตัวเลข**
// ห้ามแต่งใบอนุญาต ตัวเลขการเงิน หรือจำนวนสมาชิก · หัวข้อช่องทางติดต่อแอดมินของ
// บรีฟเป็นของ index.astro ไม่ใช่ของหน้านี้
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตต์รอบนี้อยู่ใน brand-spec §2
// ⚠️⚠️ **รอบนี้ยังเป็นธีมมืดเหมือนรอบก่อน แต่คนละฮิวสิ้นเชิง**
// bg.json = {"mode":"color","color":"#140000"} = **ดำอมแดงเข้มมาก**
// (รอบก่อนเป็น 000000 = ดำสนิท — ค่ามาจากไฟล์ ห้ามเดาว่าเท่าเดิม และห้าม "แก้"
// การ์ดให้สว่าง)
// การ์ด ContentBox จึงเป็นผิว #1c0607 บนหมึกสว่าง #f0e6e4 (= BRAND_TEXT)
// ปุ่มนี้เป็นคู่ **รอง (secondary)** ของพาเลต: ไล่เฉดมุกอุ่น #f0e6e4 -> #c9b9b7
// บนหมึก **ดำ #0a0a0a** (16.2 / 10.5:1 — ผ่านทั้งสอง stop)
// ส่วน /register เป็น **หลัก (primary)** ไล่เฉดแดง #d81115 -> #b00d11 ->
// #8a0608 บนหมึกขาว จึงไม่ซ้ำกัน
// 🚨🚨 **ขาวบนแดงสด #fb2e33 ได้แค่ 3.8:1 และขาวบนมุก #f0e6e4 แทบมองไม่เห็น**
// พื้นถมสว่างต้องคู่กับหมึกดำเสมอ และพื้นแดงที่ถือหมึกขาวได้ต้องเป็น #d81115 ลงไป
// ห้ามกลับด้านทั้งสองกรณี
// 🚨🚨 **#cb0b0d / #8a0608 / #551c1e / #7d6f6e / #c9b9b7 ห้ามถือตัวอักษรเอง**
// เป็นพื้นถม/ขอบ/ออราเท่านั้น · ที่ถือตัวอักษรได้บนผิวมืดชุดนี้คือ #fb2e33 (5.1:1)
// · #f0e6e4 (16.0:1) · #e3d6d4 (14.1:1)  — และ #c9b9b7 ถือได้เฉพาะเป็นหมึกรองบน
// ผิวการ์ด (10.3:1) ไม่ใช่บนพื้นถมสว่าง
// ⚠️⚠️ **วัสดุของรอบนี้คือแดงเจลนำ + มุกอุ่นรอง (R>G>B)** อ่านจากอาร์ตเวิร์กตรงๆ:
// โลโก้เป็นคำว่า "สล็อต168" ตัวอักษรเจลสามมิติแดงมันวาว ไฮไลต์ขาวสเปกคูลาร์
// มีมงกุฎทองเล็กประดับหัวใจแดงบนตัวอักษรตัวแรก
// ⚠️⚠️ **มงกุฎทองเป็นรายละเอียด ~2% ของอาร์ตเวิร์ก ไม่ใช่สีแบรนด์** และทองคือฮิวนำ
// ของแบรนด์ขาออกทันที — **รอบนี้ไม่มีทองเลยสักเฉด**
// ⚠️⚠️ **คาร์ดิแกนแดง เสื้อกล้ามขาว พื้นสตูดิโอขาว และสีผิวนักแสดงเป็นวัตถุในภาพ
// ไม่ใช่สี UI** — รอบนี้ไม่มีครีม ไม่มีเบจ และไม่มีเงินเย็น
// ⚠️ ปุ่มของ Navfoot อยู่บนแถบโครมคนละโซนกับปุ่มบนการ์ดนี้
// **ห้ามลอกคลาสของ Navfoot มาวางบนการ์ด**
// ออราในไฟล์นี้ใช้ rgba(240,230,228,α) · rgba(227,214,212,α) · rgba(0,0,0,α)
// เท่านั้น
//
// ⚠️⚠️ กับดักรอบนี้คือ **แดง** — รีโปนี้มีแบรนด์แดงมาแล้วหลายเจ้า "มีแดงอยู่แล้ว"
// จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้ ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน
// brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ
// false positive · **แดงของรอบนี้คือ #fb2e33 / #cb0b0d / #d81115 / #b00d11 /
// #8a0608 เท่านั้น** (fb141b ของ GT66B ห่างจาก #fb2e33 แค่ G/B และ 8a0609
// ห่างจาก #8a0608 แค่ B1 — เจอที่ไหนแปลว่าพิมพ์ผิด)
// รอบนี้ **ไม่มีทอง ไม่มีเหลือง ไม่มีน้ำเงิน/ฟ้า ไม่มีส้ม ไม่มีเขียว (ยกเว้น
// LINE green ที่หน้าอื่น) ไม่มีชมพู ไม่มีม่วง ไม่มีน้ำตาล ไม่มีครีม และไม่มี
// โครเมียมเงินเย็น** ทองกับโครเมียมเงินคือวัสดุคู่ของแบรนด์ขาออก (ชื่ออยู่ใน
// brand-spec §1) การปล่อยไว้ = ทั้งผิดพาเลตและหลงเหลือข้ามแบรนด์พร้อมกัน
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ (brand-spec §3 — รอบก่อนใช้
// AnnouncementHuay จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็น
// คอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare — ห้ามส่ง prop message
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) ส่วนที่ไม่ใช่ชื่อแบรนด์
// ยาว 149 อักขระ จึงรับชื่อแบรนด์ได้ตั้งแต่ 1 ถึง 11 อักขระ — นอกช่วงนั้นต้องแก้
// ข้อความ ไม่ใช่ปล่อยผ่าน รอบนี้ชื่อยาว 8 อักขระ รวมเป็น 157
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าเข้าสู่ระบบ ${BRAND_NAME} กดปุ่มเดียวเพื่อเข้าบัญชีสมาชิกเว็บหลัก สำหรับดูข้อมูลค่ายเกมสล็อต เงื่อนไขโปรโมชั่น และรายการฝากถอนจากประกาศล่าสุดของเว็บไซต์ทางการ`;

const graph = pageGraph(Astro, {
  name: `เข้าสู่ระบบ ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`เข้าสู่ระบบ ${BRAND_NAME} กดปุ่มเดียวเข้าบัญชีสมาชิกเว็บหลัก`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`เข้าสู่ระบบ ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#7d6f6e] bg-gradient-to-b from-[#f0e6e4] to-[#c9b9b7] px-6 py-4 text-2xl font-bold tracking-wide text-[#0a0a0a] shadow-[0_10px_30px_rgba(0,0,0,0.55)] transition-all duration-300 hover:scale-105 hover:border-[#fb2e33] hover:shadow-[0_15px_40px_rgba(240,230,228,0.4)]">
        <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#e3d6d4]/25 to-transparent"></span>
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
