---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 155.
const pageDescription =
  "หน้าเข้าสู่ระบบ PREMSUK365 กดปุ่มเดียวเข้าบัญชีสมาชิกเพื่อส่งโพยหวยต่อได้ทันที พร้อมตรวจสอบเครดิต อัตราจ่าย เลขที่เปิดรับ และเช็กบิลย้อนหลังของตัวเองได้เอง";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ PREMSUK365 ล็อกอินเข้าบัญชีสมาชิก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="เข้าสู่ระบบ PREMSUK365 ล็อกอินเข้าบัญชีสมาชิก ส่งโพยหวยต่อได้ทันที" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ PREMSUK365" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ PREMSUK365"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#1c6b3f] bg-[#03130a] px-6 py-4 text-lg font-black text-[#e3c56a] shadow-[0_10px_30px_rgba(42,157,92,0.20)] transition-all duration-300 hover:scale-105 hover:border-[#2a9d5c] hover:bg-[#0d3a22] hover:shadow-[0_15px_40px_rgba(42,157,92,0.40)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
