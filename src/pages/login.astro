---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
//
// PKG44 (รอบทองเมทัลลิก + เงินโครเมียมบนดำ 2026-09-27): ปุ่มนี้เป็นตัว SECONDARY
// ของคู่ และรับฝั่ง "K" ของโลโก้ที่เป็นเงินขัดเงา — ผิวยก #2a2110 ในกรอบเงิน
// โครเมียม #c2c8d0 บนเนื้อความ #efe6d2 แล้วยกเป็นผิว #4a3a12 กับขอบเงินสว่าง
// #f2f4f7 ตัวอักษรเน้น #fff8e1 ตอน hover ส่วน /register สวมไล่เฉดทองเต็มใบ
// ลำดับความสำคัญถูกสื่อด้วย "สีไหนถมเต็มปุ่ม" ตามโลโก้ที่ P G 44 เป็นทองและ K
// เป็นเงิน — ทองคู่เงิน ไม่ใช่ทองสองใบ ซึ่งจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม
// ชุดเขียวมรกตของ BRAZIL999 รอบก่อน (#22c55e #7cf25c #b6ff9c #0a6b18 #04380c บน
// พื้น #0a1a0c #123a18 #1c5a26 #040a05) ออกครบแล้ว ห้ามนำกลับมา
//
// Announcement หมุนมาเป็น AnnouncementPremium ทั้งเว็บรอบนี้ — default message
// ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ index ก็เรียกแบบ bare จึงห้ามส่ง prop
//
// PKG44 เป็นแบรนด์สล็อต — บรีฟพูดถึงเกมปั่นสล็อตหลายค่ายเท่านั้น คำศัพท์เฉพาะหมวด
// ของแบรนด์ก่อนหน้า (คาสิโนสด เกมโต๊ะ บาคาร่า หวย) ห้ามหลงเหลือในหน้านี้
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 158
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = "หน้าเข้าสู่ระบบ PKG44 กดปุ่มเดียวเข้าบัญชีสมาชิกเพื่อเลือกเกมปั่นสล็อตจากหลายค่ายในบัญชีเดียว พร้อมตรวจสอบโปรโมชั่นและข้อมูลการใช้งานจากช่องทางอย่างเป็นทางการ";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ PKG44",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="เข้าสู่ระบบ PKG44 ล็อกอินเข้าบัญชีสมาชิก เลือกเกมสล็อตได้ทันที" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ PKG44" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ PKG44"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#c2c8d0] bg-[#2a2110] px-6 py-4 text-lg font-black text-[#efe6d2] shadow-[0_10px_30px_rgba(8,6,2,0.85)] transition-all duration-300 hover:scale-105 hover:border-[#f2f4f7] hover:bg-[#4a3a12] hover:text-[#fff8e1] hover:shadow-[0_15px_40px_rgba(194,200,208,0.28)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
