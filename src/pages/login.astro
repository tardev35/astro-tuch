---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect. The title and
// description below are written for exactly that reason.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// GUCCI168 (รอบตรุษจีน 2026-10-08, brand-spec §2 — ชุด **สามสี: แดงนำ
// เขียวมรกตรอง ทองเป็นโลหะคั่น** บนผิวเกือบดำ · โลโก้เป็นเทพเจ้าโชคลาภสวมหมวก
// เขียวคาดแดง ตัวอักษร GUCCI ขาวเงินขอบเขียวมรกตทับเลข 168 แดงขอบทอง ส่วน
// bg.json เป็นไล่เฉดแดงเลือดหมู → ทองเข้ม จึงมีฮิวที่สองจริงมาแยกลำดับปุ่มได้):
// ปุ่มนี้เป็นตัว SECONDARY ของคู่ จึงถม **ผิวเกือบดำอมเขียว** #0b231b → #041109
// ขอบเขียวมรกตสว่าง #2bbf63/55 บนหมึกทองอ่อน #ffdf91 แล้ว hover ยกขอบเป็นเขียว
// เต็ม ส่วน /register ถม **แดงแบรนด์** เต็มใบ (#e0201f → #c41115 55% → #7a0505)
// ขอบทองแบรนด์ #d9a521 บนหมึกขาว ลำดับความสำคัญรอบนี้จึงสื่อสองชั้นพร้อมกัน:
// "แดงถม vs ผิวเข้มขอบเขียว" ไม่ใช่ถมสีเดียวกันสองใบซึ่งจะอ่านเป็นปุ่มซ้ำกัน
// และเข้าชุดกับคู่ปุ่มของ /ทางเข้า ที่ให้ เข้าสู่ระบบ = เขียว, สมัครสมาชิก = แดง
// กฎคอนทราสต์: หมึก #ffdf91 บนผิว #0b231b ได้ ~12.8:1 ผ่าน AA สบาย ส่วนพื้น
// **ทอง/แชมเปญถมเต็มใบต้องใช้หมึกเข้ม #1d0b08 เสมอ ห้ามครีมหรือขาว** จึงไม่เอา
// ทองมาถมเป็นพื้นของปุ่มนี้ และใช้ #2bbf63 เป็นสีขอบ/แสงเรืองเท่านั้น ไม่ถมพื้น
// ชุดทองเมทัลลิก-เงินโครเมียมของ UOK365 ถูกแทนครบแล้ว ทั้งคลาส Tailwind, raw hex
// และ rgba() glow (ค่าเดิมอยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep
// หาสีแบรนด์เก่าเจอ false positive)
//
// Announcement หมุนมาเป็น Announcement3 ทั้งเว็บรอบนี้ — default message ของไฟล์
// นั้นเป็นคอปปี้ของแบรนด์ปัจจุบันแล้ว และ index ก็เรียกแบบ bare จึงห้ามส่ง prop
// message จากหน้านี้
//
// แบรนด์นี้เป็น **เว็บคาสิโนไลฟ์ 24 ชม. + สล็อต + บอล** ไม่ใช่เว็บสล็อตเบทต่ำและ
// ไม่ใช่เว็บหวย — คำของแบรนด์ก่อน (เบทต่ำ ทุนน้อย ค่ายตรง ถูกลิขสิทธิ์ ไฮคลาส VIP
// ส่งตรงจากเว็บแม่) และคำหมวดหวย (หวย โพย เลขเด็ด แนวทาง งวด อัตราจ่าย ตรวจหวย)
// ห้ามหลงเหลือ
// บรีฟบรรทัด 15 ระบุว่าหลัง Login สมาชิกเลือกบาคาร่า รูเล็ต ไฮโล สล็อต หรือบอล
// แล้วเลือกหมวดเกม ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการผ่านบัญชีเดียวได้
// ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 0.3% / 0.8% / 24 ชั่วโมง / 3 ขั้นตอน
// ห้ามแต่งชื่อค่ายเกม ชื่อธนาคาร เลขใบอนุญาต หน่วยงานกำกับ ค่า RTP ยอดฝากขั้นต่ำ
// จำนวนสมาชิก หรือปีก่อตั้ง — หน้านี้มีโควตาเป็นปุ่มเดียวเท่านั้น
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 157
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าเข้าสู่ระบบ ${BRAND_NAME} กดปุ่มเดียวเข้าบัญชีสมาชิก เลือกโต๊ะสดคาสิโนไลฟ์ บาคาร่า รูเล็ต ไฮโล สล็อต บอล พร้อมดูเครดิต โปรโมชั่น และประวัติรายการจากบัญชีเดียว`;

const graph = pageGraph(Astro, {
  name: `เข้าสู่ระบบ ${BRAND_NAME} คาสิโนไลฟ์`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`เข้าสู่ระบบ ${BRAND_NAME} ล็อกอินเข้าบัญชีสมาชิก เลือกโต๊ะสดคาสิโนไลฟ์ได้ทันที`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`เข้าสู่ระบบ ${BRAND_NAME} คาสิโนไลฟ์`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#2bbf63]/55 bg-gradient-to-b from-[#0b231b] to-[#041109] px-6 py-4 text-lg font-black text-[#ffdf91] shadow-[0_0_12px_rgba(11,122,51,0.30)] transition-all duration-300 hover:scale-105 hover:border-[#2bbf63] hover:shadow-[0_0_28px_rgba(43,191,99,0.45)]">
        <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#d9a521]/25 to-transparent"></div>
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
