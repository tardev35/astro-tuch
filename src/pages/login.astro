---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change.
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page, which means verify-build holds its
// description to the same 150–160 character window as every other page.
//
// ⚠️ แบรนด์รอบนี้เป็น **เว็บสล็อตล้วน ลิขสิทธิ์แท้ นำเข้าตรงจากสิงคโปร์ สามค่ายหลัก
// PG SOFT / JOKER / JILI** ตามบรีฟ — ไม่ใช่หมวดอื่นใดทั้งสิ้น
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES เลย คอปปี้ของหน้านี้จึง
// อนุมานจากบรรทัด 4 6 และ 20 ซึ่งพูดถึงการเข้าใช้งานเพื่อศึกษารายละเอียดเกมของ
// สามค่าย และโปรโมชั่นที่เปิดให้เข้าร่วม เท่านั้น
// — คำที่ห้ามหลุดกลับมาอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep
// หาคำต้องห้ามเจอ false positive · แบรนด์ก่อนขายตัวเองด้วยวลีที่บรีฟรอบนี้
// ไม่มีเลยสักคำ จึงต้องเขียนใหม่จากบรีฟ ไม่ใช่ find-and-replace ทับของเดิม
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 24 ชั่วโมง · 100% · 3 ขั้นตอน ·
// 3 ค่าย ห้ามแต่งใบอนุญาต หน่วยงานกำกับ ชื่อค่ายเกมอื่น ชื่อธนาคาร ค่า RTP
// ยอดขั้นต่ำ จำนวนสมาชิก หรือปีใดๆ (บรีฟรอบนี้ไม่ได้เอ่ยปีไว้เลย)
//
// แบรนด์รอบนี้ (มีโชค168, รอบ **ทองนำ ชมพูบานเย็นเป็นฮิวที่สอง พลัมเข้มเป็นเงา
// บนดำสนิท** 2026-10-18, brand-spec §2): โลโก้คือ **แมวกวักนำโชค** ตัวขาว-ส้มทอง
// นั่งอยู่เหนือคำว่า "มีโชค" ที่เป็นตัวอักษรไทยหนาสามมิติ **ไล่เฉดชมพูบานเย็นไปหา
// ทอง** ต่อด้วยเลข "168" ทองสามมิติ — **ชมพูบานเย็น #f5469f คือฮิวที่สองจริงของ
// รอบนี้ ส่วนโรสโกลด์ของรอบก่อนออกไปหมดแล้ว**
// ทองลึก #7a5508 · พลัมเข้ม #8c0f52 (สองตัวนี้ห้ามถือตัวอักษร) ·
// ตัวที่ถือตัวอักษรได้: ทองสว่าง #ffeaa0 (15.2:1) · ชมพูอ่อน #ff8dc6 (9.9:1) ·
// ทองแบรนด์ #fcd434 (11.7:1) · ชมพูบานเย็น #f5469f (6.2:1) ·
// เนื้อความ #f6e4ee (= BRAND_TEXT) · หมึกบนพื้นถมทอง #1a0612
// ชั้นผิว: ยก #24101c (= การ์ด ContentBox) / กลาง #160a12 / จม #0b0509 /
// พื้นเพจ #000000 — bg.json รอบนี้เป็นดำสนิท
// ปุ่มนี้เป็นคู่ SECONDARY: จมลงจากการ์ดด้วยชั้น #160a12 → #0b0509 ขอบ
// **ชมพูบานเย็น** #f5469f/55 บนตัวอักษร **ชมพูอ่อน** #ff8dc6 — hover ยกขอบเป็น
// #ff8dc6 ส่วน /register เป็น PRIMARY ถมพื้น **ทอง** จึงไม่ซ้ำกัน
// ⚠️ ห้ามใช้ผิวยก #24101c เป็นพื้นปุ่ม มันเป็นสีเดียวกับการ์ดที่ปุ่มวางอยู่
// ⚠️ #7a5508 #8c0f52 ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่เส้นขอบ ออรา พื้นถม และเงา —
// ออราในไฟล์นี้ใช้ rgba(245,70,159,α) เท่านั้น นอกจากเงาดำล้วน
// ⚠️ กับดักรอบนี้คือ **ทอง** เพราะแทบทุกแบรนด์ที่ผ่านไฟล์นี้มีทองอยู่ด้วย
// "มีทองอยู่แล้ว" จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้ ทองรอบนี้คือ #fcd434
// (252,212,52) ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำ
// ที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive (ชมพูก็เช่นกัน —
// มีแบรนด์เก่าที่เป็นชมพูฮอตพิงก์มาแล้ว แต่คนละค่าทั้งชุด)
// และรอบนี้ **ไม่มีม่วง ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว ไม่มีส้ม ไม่มีเงินอมฟ้า
// ไม่มีโรสโกลด์ ไม่มีแดงชาด**
//
// Announcement หมุนมาเป็น Announcement3 ทั้งเว็บรอบนี้ (brand-spec §3 —
// รอบก่อนใช้ Announcement5 จึงหมุนออก) orchestrator ตั้ง default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare — ห้ามส่ง prop message
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) หน้านี้ยาว 158
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าเข้าสู่ระบบ ${BRAND_NAME} กดปุ่มเดียวไปยังทางเข้าหลักของเว็บสล็อตลิขสิทธิ์แท้ เพื่อเข้าเล่นเกมจาก PG SOFT JOKER JILI และดูรายละเอียดโปรโมชั่นที่เปิดให้เข้าร่วม`;

const graph = pageGraph(Astro, {
  name: `เข้าสู่ระบบ ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/2u19";
---

<MainLayout title={`เข้าสู่ระบบ ${BRAND_NAME} ฐานหลักเว็บสล็อตลิขสิทธิ์แท้`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`เข้าสู่ระบบ ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f5469f]/55 bg-gradient-to-b from-[#160a12] to-[#0b0509] px-6 py-4 text-2xl font-bold tracking-wide text-[#ff8dc6] shadow-[0_10px_30px_rgba(0,0,0,0.55)] transition-all duration-300 hover:scale-105 hover:border-[#ff8dc6] hover:shadow-[0_15px_40px_rgba(245,70,159,0.45)]">
        <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#f5469f]/20 to-transparent"></div>
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
