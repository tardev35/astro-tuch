---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — this page is indexed and must not
// describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// The button is the SECONDARY of the pair: page-ink surface (#1c0202) with an
// antique-gold outline (#d9b45e) and gold text, while /register wears the solid
// crimson gradient (#c81e1e → #a51515 → #6d0d0d).
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 153.
const pageDescription = "หน้าเข้าสู่ระบบ JOKERSLOTZ กดปุ่มเดียวล็อกอินเข้าบัญชีสมาชิกผ่านลิ้งก์ทางเข้าสำรองล่าสุด หมุนสล็อตค่าย Joker Gaming พร้อมระบบฝาก-ถอนออโต้ ตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ JOKERSLOTZ",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="เข้าสู่ระบบ JOKERSLOTZ ล็อกอินเข้าบัญชีสมาชิก เริ่มหมุนสล็อตได้ทันที" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ JOKERSLOTZ" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ JOKERSLOTZ"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#d9b45e]/55 bg-[#1c0202] px-6 py-4 text-lg font-black text-[#d9b45e] shadow-[0_10px_30px_rgba(217,180,94,0.22)] transition-all duration-300 hover:scale-105 hover:border-[#f2dc9a] hover:bg-[#2b0204] hover:text-[#f2dc9a] hover:shadow-[0_15px_40px_rgba(217,180,94,0.40)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
