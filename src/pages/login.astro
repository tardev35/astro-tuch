---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change.
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page, which means verify-build holds its
// description to the same 150–160 character window as every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES — คอปปี้ของหน้านี้จึงพูด
// ได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 4: ภายในเว็บไซต์มีข้อมูลการสมัครสมาชิก การเข้าสู่ระบบ
// โปรโมชั่น และช่องทางติดต่อเจ้าหน้าที่ · บรรทัด 20: หลังลงทะเบียนเรียบร้อย สามารถ
// ตรวจสอบกติกา ช่วงเดิมพันขั้นต่ำ และรายละเอียดโปรโมชั่นก่อนใช้งาน)
// ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า หน้านี้มีโควตาเป็นปุ่มเดียว
//
// ⚠️ แบรนด์รอบนี้ (มีเฮ168) เป็น **เว็บสล็อตล้วน** ที่บรีฟพูดถึงโปรโมชั่นเพียง
// สองรายการคือ **คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%** — ไม่มีหมวดคาสิโน
// ไม่มีกีฬา และไม่ใช่เว็บหวย
// คำที่ห้ามหลุดกลับมาอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำ
// ต้องห้ามเจอ false positive · แบรนด์ก่อนหน้าขายตัวเองด้วยวลีที่บรีฟรอบนี้
// ไม่มีเลยสักคำ จึงต้องเขียนใหม่จากบรีฟ ไม่ใช่ find-and-replace ทับของเดิม
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกมแม้แต่ค่ายเดียว** จึงห้ามเขียนชื่อค่ายใดๆ
// ให้ใช้คำกลางว่า "ค่ายเกม" ตามบรีฟ
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 24ชม. ห้ามแต่งใบอนุญาต
// หน่วยงานกำกับ ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีใดๆ
// (บรีฟรอบนี้ไม่ได้เอ่ยปีไว้เลย) — หัวข้อขั้นตอนสมัครกับช่องทางติดต่อแอดมินของบรีฟ
// (บรรทัด 13-22) เป็นของ index.astro ไม่ใช่ของหน้านี้ ห้ามยกมาเขียนซ้ำที่นี่
//
// พาเลตต์รอบนี้อยู่ใน .claude/brand-spec-meehay168.md §2 — **แดงชาดนำ
// ทองเนยเป็นฮิวที่สอง แดงลึก/บรอนซ์ลึกไม่เคยถือตัวอักษร บนพื้นดำสนิท** (bg.json =
// {"mode":"color","color":"#000000"}) โลโก้คือคำว่า **"มี"** ตัวอักษรไทยหนา
// สามมิติ **สีขาวมุกตัดขอบเทา** ต่อด้วย **"เฮ168" สีแดงชาดบับเบิลผิวมันวาว**
// ทางซ้ายเป็นหน้ายิ้มหัวเราะสีเหลืองทองแก้มชมพู นั่งบนกองเหรียญทอง
// แดงชาด #fb1b32 · ชมพูบลัช #ff8f9c (8.5:1 บนผิวการ์ด) · ทองเนย #fcd45c (12.9:1) ·
// ครีมชมพู #ffe3e6 · เนื้อความ #fdeaec (= BRAND_TEXT) · หมึกบนพื้นถมสว่าง #1b0308
// ชั้นผิว: ยก #2b0711 (= การ์ด ContentBox) / กลาง #1a040a / จม #0c0205
// ปุ่มนี้เป็นคู่ SECONDARY: จมลงจากการ์ดด้วยชั้น #1a040a → #0c0205 ขอบ **ทองเนย**
// #fcd45c/55 บนตัวอักษร **ทองเนย** #fcd45c — hover ยกขอบเป็น #fcd45c เต็ม
// (ขั้วเดียวกับปุ่ม เข้าสู่ระบบ ของ Navfoot ที่ขึ้นทุกหน้าบนมือถือ จึงอ่านเป็นปุ่ม
// เดียวกันทั้งเว็บ) ส่วน /register เป็น PRIMARY ถมพื้น **แดง** บนหมึกเข้ม จึงไม่ซ้ำกัน
// ⚠️ ห้ามใช้ผิวยก #2b0711 เป็นพื้นปุ่ม มันเป็นสีเดียวกับการ์ดที่ปุ่มวางอยู่
// ⚠️ #5c0410 (แดงลึก) และ #6b4a08 (บรอนซ์ลึก) ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่
// เส้นขอบ ออรา พื้นถม และเงา — ออราในไฟล์นี้ใช้ rgba(252,212,92,α) เท่านั้น
// นอกจากเงาดำล้วน · แดงแบรนด์ #fb1b32 อยู่ที่ 4.7:1 จึงถือหัวข้อ/ไอคอนได้
// แต่ไม่ถือเนื้อความยาว
// ⚠️ กับดักรอบนี้คือ **ทั้งแดงและทอง** เพราะสามแบรนด์ก่อนหน้า (สมหวัง168 แดงนำ+
// ทองรอง · รับตัง168 ทองนำ+แดงสด · ขวัญใจ168 ทองนำ+แดงชาด) ก็มีทั้งคู่
// "มีแดงอยู่แล้ว" หรือ "มีทองอยู่แล้ว" จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้
// แดงรอบนี้คือ #fb1b32 (251,27,50) และทองรอบนี้คือ #fcd45c (252,212,92)
// ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive (แดงของสมหวัง168 ห่างจาก
// ค่ารอบนี้แค่หลักหน่วยของ G กับ B — ตาแยกไม่ออก)
// และรอบนี้ **ไม่มีฟ้า/น้ำเงิน ไม่มีม่วง ไม่มีเขียว ไม่มีส้ม ไม่มีเงิน/โครเมียม
// ไม่มีโรสโกลด์ ไม่มีเหลืองมะนาว ไม่มีชมพูฟูเชีย** — ชมพูตัวเดียวที่อนุญาตคือ
// บลัช #ff8f9c ซึ่งเป็นแดงจาง
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ (brand-spec §3 —
// รอบก่อนใช้ Announcement3 จึงหมุนออก) orchestrator ตั้ง default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare — ห้ามส่ง prop message
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) หน้านี้ยาว 152
// ด้วยชื่อแบรนด์ 7 ตัวอักษรของรอบนี้
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าเข้าสู่ระบบ ${BRAND_NAME} กดปุ่มเดียวเข้าสู่บัญชีสมาชิก เพื่อตรวจสอบโปรโมชั่นแนะนำเพื่อน 0.8% เครดิตคืนยอดเสีย 0.3% และรายการฝากถอนตามเงื่อนไขที่ประกาศไว้`;

const graph = pageGraph(Astro, {
  name: `เข้าสู่ระบบ ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`เข้าสู่ระบบ ${BRAND_NAME} เข้าบัญชีสมาชิกเพื่อตรวจสอบโปรโมชั่นและรายการฝากถอน`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`เข้าสู่ระบบ ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fcd45c]/55 bg-gradient-to-b from-[#1a040a] to-[#0c0205] px-6 py-4 text-2xl font-bold tracking-wide text-[#fcd45c] shadow-[0_10px_30px_rgba(0,0,0,0.55)] transition-all duration-300 hover:scale-105 hover:border-[#fcd45c] hover:shadow-[0_15px_40px_rgba(252,212,92,0.45)]">
        <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#fcd45c]/20 to-transparent"></div>
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
