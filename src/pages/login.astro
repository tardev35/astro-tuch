---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// LOTTOPLUS (รอบแดง-ทอง-ดำ 2026-09-29): ปุ่มนี้เป็นตัว SECONDARY ของคู่ จึงเป็นแบบ
// OUTLINE — ผิวปุ่มรอง #2a0d0f ในกรอบทองรอง #f3c623 บนตัวอักษรทองรอง แล้วยกผิวขึ้น
// เป็น #3a1114 ตอน hover ส่วน /register สวมไล่เฉดแดงเต็มใบ
// (#ff2d38 → #dc020e → #6b0207) ลำดับความสำคัญรอบนี้สื่อด้วย "ถมแดง vs กรอบทอง"
// ซึ่งใช้ทั้งสองสีของแบรนด์พอดี — สองปุ่มที่ถมแดงเหมือนกันจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม
// กฎคอนทราสต์ brand-spec §2: พื้นแดง = ตัวอักษรขาว (5.17:1) · พื้นทอง = หมึกเข้ม
// #1a0203 (12.4:1) · ห้ามหมึกเข้มบนแดง (3.85:1 ตก)
// ชุดทอง-ดำของ WIN999 (#fcc403 #fdda04 #e0a800 #8a6502 #fff0a8 #e9e4d6 #fffbea
// #101010 #191712 #241f14 rgba(252,196,3,*) rgba(3,2,0,*)) และชุดแดงของ LOTTO24
// (#dc2626 #fc2b2c #b40102 #fbbf24 #fde68a rgba(220,38,38,*)) ออกครบแล้ว ห้ามนำกลับมา
//
// Announcement หมุนมาเป็น AnnouncementHuay ทั้งเว็บรอบนี้ — default message ของไฟล์
// นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ index ก็เรียกแบบ bare
//
// LOTTOPLUS เป็นเว็บหวยออนไลน์ ไม่ใช่คาสิโน — บรีฟพูดถึงหวยรัฐบาลไทย ลาวพัฒนา ฮานอย
// หวยหุ้น เลือกเลข ส่งโพย ตรวจสอบรายการ ตรวจผลหวย เครดิต ประวัติโพย อัตราจ่าย
// โบนัสคืนยอดเสีย 0.3% โบนัสแนะนำเพื่อน 0.8% และแอดมิน 24 ชม. เท่านั้น
// คำศัพท์ตระกูลคาสิโนของแบรนด์ก่อน (คาสิโน บาคาร่า สล็อต เกมไพ่ ค่ายเกม RTP
// กีฬา/บอล) ห้ามหลงเหลือ
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 154
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = "หน้าเข้าสู่ระบบ LOTTOPLUS กดปุ่มเดียวเข้าบัญชีสมาชิกเพื่อเลือกรอบหวย ส่งโพย ตรวจผลหวย และตรวจสอบเครดิตกับประวัติโพยของตนเองผ่านเบราว์เซอร์บนมือถือได้ทันที";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ LOTTOPLUS",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="เข้าสู่ระบบ LOTTOPLUS ล็อกอินเข้าบัญชีสมาชิก เลือกรอบหวยและส่งโพย" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ LOTTOPLUS" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ LOTTOPLUS"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f3c623] bg-[#2a0d0f] px-6 py-4 text-lg font-black text-[#f3c623] shadow-[0_10px_30px_rgba(5,1,2,0.85)] transition-all duration-300 hover:scale-105 hover:border-[#fde79a] hover:bg-[#3a1114] hover:text-[#fff4f4] hover:shadow-[0_15px_40px_rgba(243,198,35,0.30)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
