---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect. The title and
// description below are written for exactly that reason.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// 1SS365 (รอบทอง-ดำ 2026-10-03, brand-spec §"New palette" — ทองคือสีตัวตน
// เงินโครมคือฮิวที่สอง ดำคือพื้น มาจาก logo.webp ที่ vivid เป็นทอง #edbb23):
// ปุ่มนี้เป็นตัว SECONDARY ของคู่ จึงเป็นแบบ outline — พื้นยกระดับ #1a1710 ในกรอบ
// ทองลึก #a87708 บนตัวอักษรทองแบรนด์ #edbb23 (≈9:1) แล้วยกเป็นทองอ่อน #ffeeb4
// ตอน hover ส่วน /register สวมไล่เฉดทองเต็มใบ (#f7d458 → #edbb23 → #c9930f)
// บนตัวอักษรดำ #050505
// ลำดับความสำคัญรอบนี้จึงสื่อด้วย "ทองถม vs ทองกรอบ" ไม่ใช่ถมทองสองใบซึ่งจะอ่านเป็น
// ปุ่มซ้ำกันสองปุ่ม
// กฎคอนทราสต์: พื้นทอง = หมึก **ดำ #050505** เสมอ (หมึกขาวบน #edbb23 ได้แค่
// 1.9:1 ตก) · พื้นเข้ม #121010/#1a1710 = ตัวอักษรทอง #edbb23 หรือเนื้อความ #f0e6d2
// ชุดแดง-ทองของ หวย365 (#dc0203 #f5282a #8c0402 #ffc93c #ffeab0 #c08a07 #240406
// #3a0a0c #f6e7e0 rgba(220,2,3,*) rgba(255,201,60,*) rgba(8,1,1,*)) ออกครบแล้ว
// ห้ามนำกลับมา
//
// Announcement หมุนมาเป็น AnnouncementPremium ทั้งเว็บรอบนี้ (รอบก่อนเป็น
// AnnouncementHuay) — default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ
// index ก็เรียกแบบ bare จึงห้ามส่ง prop message
//
// 1SS365 เป็นสล็อตออนไลน์เว็บตรงต่างประเทศ ไม่ผ่านเอเย่นต์ — ไม่ใช่เว็บหวยและไม่ใช่บอล
// บรีฟระบุว่าหลัง Login ใช้บัญชีเดียวค้นหาเกมสล็อต ตรวจสอบค่ายเกม เครดิต โปรโมชั่น
// และประวัติรายการได้ และควรตรวจช่วงเดิมพันขั้นต่ำ/สูงสุดของเกมนั้นก่อนเริ่มเล่น
// ตัวเลขที่ใช้ได้มีแค่ 0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง · 100%
// ห้ามแต่งตัวเลขอื่นขึ้นมาเอง
// คำศัพท์หวยของแบรนด์ก่อนหน้า (หวย แทงหวย ส่งโพย โพย เลือกเลข 2 ตัว 3 ตัว อัตราจ่าย
// งวด รัฐบาลไทย ฮานอย ลาวพัฒนา หวยหุ้น สถิติหวย ผลหวย แนวทางหวย) ห้ามหลงเหลือ
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 154
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าเข้าสู่ระบบ ${BRAND_NAME} กดปุ่มเดียวเพื่อเข้าบัญชีสมาชิก สำหรับเลือกค่ายและเกมสล็อตเว็บตรงต่างประเทศ ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการได้จากระบบเดียว`;

const graph = pageGraph(Astro, {
  name: `เข้าสู่ระบบ ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`เข้าสู่ระบบ ${BRAND_NAME} ล็อกอินเข้าบัญชีสมาชิก เลือกเกมสล็อตได้ทันที`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`เข้าสู่ระบบ ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#a87708]/80 bg-[#1a1710] px-6 py-4 text-lg font-black text-[#edbb23] shadow-[0_10px_30px_rgba(5,5,5,0.75)] transition-all duration-300 hover:scale-105 hover:border-[#edbb23] hover:text-[#ffeeb4] hover:shadow-[0_15px_40px_rgba(237,187,35,0.30)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
