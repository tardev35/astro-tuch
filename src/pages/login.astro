---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — this page is indexed and must not
// describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// The button is the SECONDARY of the pair: raised near-black surface (#161208)
// with a deep-gold outline (#9a7f3f) over body-text ink, brightening to sheen
// gold (#f6e7b8) on hover, while /register wears the solid gold gradient.
//
// Announcement รอบนี้หมุนมาใช้ Announcement5 ทั้งเว็บ — default message ของไฟล์นั้น
// เป็นคอปปี้ของ GODBET88 อยู่แล้ว จึงเรียกแบบ bare ไม่ต้องส่ง prop
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 159.
const pageDescription = "หน้าเข้าสู่ระบบ GODBET88 กดปุ่มเดียวล็อกอินเข้าบัญชีสมาชิก ปั่นสล็อตไม่ติดเทิร์น ถอนได้ทุกยอดไม่จำกัดรอบบิลต่อวัน ฝาก-ถอนไม่มีขั้นต่ำ แอดมินดูแลตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ GODBET88",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="เข้าสู่ระบบ GODBET88 ล็อกอินเข้าบัญชีสมาชิก ปั่นสล็อตไม่ติดเทิร์นได้ทันที" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ GODBET88" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ GODBET88"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#9a7f3f] bg-[#161208] px-6 py-4 text-lg font-black text-[#ece1cc] shadow-[0_10px_30px_rgba(194,165,92,0.22)] transition-all duration-300 hover:scale-105 hover:border-[#c2a55c] hover:bg-[#0a0806] hover:text-[#f6e7b8] hover:shadow-[0_15px_40px_rgba(246,231,184,0.36)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
