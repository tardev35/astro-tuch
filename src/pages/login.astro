---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char).
const pageDescription =
  "หน้าเข้าสู่ระบบ ขวัญใจ168 กดปุ่มเดียวเข้าบัญชีสมาชิกเพื่อเล่นสล็อตต่อผ่านทางเข้าสำรอง พร้อมตรวจสอบเครดิต โปรโมชั่น และรายการฝากถอนออโต้ทั้งหมดได้ในบัญชีเดียว";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ ขวัญใจ168 ล็อกอินเข้าบัญชีสมาชิก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="เข้าสู่ระบบ ขวัญใจ168 ล็อกอินเข้าบัญชีสมาชิก เล่นสล็อตผ่านทางเข้าสำรอง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ ขวัญใจ168" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ ขวัญใจ168"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#8fb6cc]/70 bg-[#01050b] px-6 py-4 text-lg font-black text-[#eafcff] shadow-[0_10px_30px_rgba(22,135,201,0.18)] transition-all duration-300 hover:scale-105 hover:border-[#4bdbee] hover:bg-[#083b5c] hover:shadow-[0_15px_40px_rgba(75,219,238,0.30)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
