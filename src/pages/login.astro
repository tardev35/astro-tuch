---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change (CtaRedirect.astro
// itself belongs to the orchestrator — ห้ามแก้ไฟล์นั้นจากหน้านี้)
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page, which means verify-build holds its
// description to the same 150–160 character window as every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES — คอปปี้ของหน้านี้จึงพูด
// ได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 4: รวมเมนูสมัครสมาชิก เข้าสู่ระบบ ฝากถอน และ
// ตรวจสอบโปรโมชั่นไว้ในเว็บไซต์เดียว · บรรทัด 20: หลังลงทะเบียนเรียบร้อย สามารถ
// ตรวจสอบเมนูเกมสล็อต ยิงปลา ไฮโล และหวยออนไลน์ รวมถึงกติกา อัตราเดิมพัน และ
// รายละเอียดโปรโมชั่นก่อนใช้งาน)
// ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า หน้านี้มีโควตาเป็นปุ่มเดียว
//
// ⚠️ แบรนด์รอบนี้เป็น **เว็บเกมสล็อตเป็นแกน** ที่บรีฟระบุหมวดเกมอื่นไว้ด้วยจริง
// (ยิงปลา · ไฮโล · หวยออนไลน์/แทงหวย — สามคำนี้ **ใช้ได้รอบนี้** ไม่ใช่คำค้าง)
// พร้อมโปรโมชั่นสองรายการคือ **คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%** — ไม่มีหมวด
// คาสิโน ไม่มีกีฬา และ **ไม่ใช่เว็บหวย**
// คำที่ห้ามหลุดกลับมาอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำ
// ต้องห้ามเจอ false positive · แบรนด์ก่อนหน้าขายตัวเองด้วยวลีที่บรีฟรอบนี้
// ไม่มีเลยสักคำ จึงต้องเขียนใหม่จากบรีฟ ไม่ใช่ find-and-replace ทับของเดิม
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกมแม้แต่ค่ายเดียว** จึงห้ามเขียนชื่อค่ายใดๆ
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 24ชม. · 3 ขั้นตอน ห้ามแต่ง
// ใบอนุญาต หน่วยงานกำกับ ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก
// หรือปีใดๆ (บรีฟรอบนี้ไม่ได้เอ่ยปีไว้เลย) — หัวข้อขั้นตอนสมัครกับช่องทางติดต่อ
// แอดมินของบรีฟ (บรรทัด 13-22) เป็นของ index.astro ไม่ใช่ของหน้านี้
//
// พาเลตต์รอบนี้อยู่ใน .claude/brand-spec-ruaythep168.md §2 — **ทองจักรพรรดินำ
// แดงชาดเป็นฮิวที่สอง ทองแดงเป็นฮิวที่สาม บนพื้นดำสนิท** (bg.json =
// {"mode":"color","color":"#000000"})
// ทอง #f0bb4e (8.8:1 บนผิวการ์ด) · ครีมทอง #ffeccb (13.4:1) ·
// เนื้อความ #fff8ec (= BRAND_TEXT) · หมึกบนพื้นถมทอง/ครีม #2b1400
// ชั้นผิว: ยก #3b1b0e (= การ์ด ContentBox) / กลาง #260d04 / จม #0d0501
// ปุ่มนี้เป็นคู่ SECONDARY: จมลงจากการ์ดด้วยชั้น #260d04 → #0d0501 ขอบ **แดงชาด**
// #e4021b/70 บนตัวอักษร **ครีมทอง** #ffeccb — hover ยกขอบเป็น #e4021b เต็ม
// (ขั้วเดียวกับปุ่ม เข้าสู่ระบบ ของ Navfoot ที่ขึ้นทุกหน้าบนมือถือ จึงอ่านเป็นปุ่ม
// เดียวกันทั้งเว็บ) ส่วน /register เป็น PRIMARY ถมพื้น **ทอง** บนหมึกเข้ม จึงไม่ซ้ำกัน
// ⚠️ ห้ามใช้ผิวยก #3b1b0e เป็นพื้นปุ่ม มันเป็นสีเดียวกับการ์ดที่ปุ่มวางอยู่
// ⚠️ **แดงชาด #e4021b ตกเกณฑ์ AA ทุกพื้น (3.2–4.3:1) จึงเป็นขอบ/พื้นถม/ไอคอน
// เท่านั้น ห้ามถือตัวอักษร** ถ้าต้องมีตัวอักษรบนแดงให้ถมแดงแล้ววาง #fff8ec ทับ
// (4.6:1) · ทองแดง #d9701a (4.7:1) เป็นเส้น/ขอบ/ตกแต่ง ไม่ใช่เนื้อความ
// ออราในไฟล์นี้ใช้ rgba(240,187,78,α) และ rgba(228,2,27,α) เท่านั้น นอกจากเงาดำล้วน
// ⚠️ กับดักรอบนี้คือ **ทองและแดงพร้อมกัน** เพราะทองเคยนำมาแล้วเกือบทุกแบรนด์
// และแดงเคยนำมาแล้วสามแบรนด์ "มีทองอยู่แล้ว" หรือ "มีแดงอยู่แล้ว" จึงไม่พิสูจน์
// ว่าเป็นค่าของรอบนี้ ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน brand-spec §2 ซึ่งไม่
// พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive (ทองของ
// รับตัง168 มี R เท่ากับรอบนี้เป๊ะ ตัวตัดสินอยู่ที่ B — ตาแยกไม่ออก)
// รอบนี้ **ไม่มีฟ้า/น้ำเงิน ไม่มีม่วง ไม่มีเขียว ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์
// ไม่มีเหลืองมะนาว ไม่มีชมพู/ฟูเชีย** — ส้ม/ทองแดงเป็นข้อยกเว้นของรอบนี้เท่านั้น
//
// Announcement หมุนมาเป็น AnnouncementPremium ทั้งเว็บรอบนี้ (brand-spec §3 —
// รอบก่อนใช้ Announcement5 จึงหมุนออก) orchestrator ตั้ง default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare — ห้ามส่ง prop message
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) หน้านี้ยาว 155
// ด้วยชื่อแบรนด์ 9 ตัวอักษรของรอบนี้
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าเข้าสู่ระบบ ${BRAND_NAME} กดปุ่มเดียวเข้าสู่บัญชีสมาชิก เพื่อตรวจสอบเมนูเกมสล็อต ยิงปลา ไฮโล หวยออนไลน์ กติกา อัตราเดิมพัน และรายละเอียดโปรโมชั่นก่อนใช้งาน`;

const graph = pageGraph(Astro, {
  name: `เข้าสู่ระบบ ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`เข้าสู่ระบบ ${BRAND_NAME} เข้าบัญชีสมาชิกเพื่อตรวจสอบเมนูเกมและโปรโมชั่น`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`เข้าสู่ระบบ ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#e4021b]/70 bg-gradient-to-b from-[#260d04] to-[#0d0501] px-6 py-4 text-2xl font-bold tracking-wide text-[#ffeccb] shadow-[0_10px_30px_rgba(0,0,0,0.55)] transition-all duration-300 hover:scale-105 hover:border-[#e4021b] hover:shadow-[0_15px_40px_rgba(228,2,27,0.45)]">
        <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#f0bb4e]/20 to-transparent"></div>
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
