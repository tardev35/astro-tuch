---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 150.
const pageDescription =
  "หน้าเข้าสู่ระบบ LEKDED กดปุ่มเดียวเข้าบัญชีสมาชิกเพื่อซื้อหวยออนไลน์ต่อได้ทันที ตรวจสอบเครดิต สถานะโพย รายการฝากถอน และสิทธิ์โปรโมชั่นได้จากบัญชีเดียว";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ LEKDED ล็อกอินเข้าบัญชีสมาชิก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="เข้าสู่ระบบ LEKDED ล็อกอินเข้าบัญชีสมาชิก ซื้อหวยออนไลน์ได้ตลอดทั้งวัน" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ LEKDED" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ LEKDED"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#7a5d2c]/80 bg-[#030803] px-6 py-4 text-lg font-black text-[#fff4cd] shadow-[0_10px_30px_rgba(181,129,30,0.20)] transition-all duration-300 hover:scale-105 hover:border-[#e2c466] hover:bg-[#123209] hover:shadow-[0_15px_40px_rgba(226,196,102,0.32)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
