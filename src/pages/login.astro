---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect. The title and
// description below are written for exactly that reason.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// NAZA99 (รอบทอง-ดำ 2026-10-02, brand-spec §2 — แบรนด์นี้เป็นทองล้วน ไม่มีฮิวที่สอง
// ความต่างทั้งหมดสร้างจากระดับความสว่างของทอง):
// ปุ่มนี้เป็นตัว SECONDARY ของคู่ จึงเป็นแบบ OUTLINE — ผิวยกระดับ #241404 ในกรอบ
// ทองลึก #8a5f12 บนตัวอักษรทองอ่อน #fdf2ac แล้วยกขอบเป็นทองแบรนด์ #e4b34d ตอน hover
// ส่วน /register สวมไล่เฉดทองเต็มใบ (#fdf2ac → #e4b34d → #c08f2b)
// ลำดับความสำคัญรอบนี้สื่อด้วย "ถมทอง vs กรอบทองบนพื้นดำ" — สองปุ่มที่ถมทองเหมือนกัน
// จะอ่านเป็นปุ่มซ้ำกันสองปุ่ม
// กฎคอนทราสต์ brand-spec §2: พื้นทอง = หมึกเข้ม #1a1000 (ไล่เฉดห้ามจบเข้มกว่า
// #c08f2b = 7.0:1) · พื้นเข้ม #140c02/#241404 = ตัวอักษรทอง #fdf2ac (15.3:1) ·
// ห้ามตัวอักษรสีอ่อนบนพื้นทอง (ขาวบน #e4b34d ได้แค่ 1.9:1)
// ชุดของ หวย365 (#dc0203 #f5282a #9c0201 #ffc93c #ffeab0 #c08a07 #240406 #180303
// #f6e7e0 #1a0303 rgba(255,201,60,*) rgba(220,2,3,*) rgba(8,1,1,*)) ออกครบแล้ว
// ห้ามนำกลับมา
//
// Announcement หมุนมาเป็น AnnouncementPremium ทั้งเว็บรอบนี้ (รอบก่อนเป็น
// AnnouncementCyber) — default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ
// index ก็เรียกแบบ bare
//
// NAZA99 เป็นเว็บสล็อตออนไลน์ ไม่ใช่หวยและไม่ใช่บอล — บรีฟรอบนี้พูดถึงการรวมเกมสล็อต
// หลายสไตล์จากค่ายยอดนิยมไว้ในระบบเดียว และหลังเปิดบัญชีแล้วสมาชิกค้นหาเกมใหม่
// ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการผ่านบัญชีเดียวได้
// ชื่อเกมที่เอ่ยได้มีแค่สามชื่อของบรีฟ (Mahjong Ways 2, Fortune Tiger, Sweet Bonanza)
// ตัวเลขที่ใช้ได้มีแค่ 0.3% · 0.8% · 3 เกม · 3 ขั้นตอน · 24 ชั่วโมง
// คำศัพท์ของแบรนด์ก่อนหน้า (หวย โพย ส่งโพย งวด เลขเด็ด อัตราจ่าย ฮานอย ลาว หุ้น
// บอล ค่าน้ำ อัตราต่อรอง ลีก คาสิโนสด บาคาร่า ยิงปลา) ห้ามหลงเหลือ
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 150
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าเข้าสู่ระบบ ${BRAND_NAME} กดปุ่มเดียวเข้าบัญชีสมาชิก เพื่อเลือกเกมสล็อตจากค่ายที่ระบบรองรับ ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการจากบัญชีเดียวได้สะดวก`;

const graph = pageGraph(Astro, {
  name: `เข้าสู่ระบบ ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`เข้าสู่ระบบ ${BRAND_NAME} ล็อกอินเข้าบัญชีสมาชิก เลือกเกมสล็อตได้ทันที`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`เข้าสู่ระบบ ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#8a5f12] bg-[#241404] px-6 py-4 text-lg font-black text-[#fdf2ac] shadow-[0_10px_30px_rgba(10,5,1,0.85)] transition-all duration-300 hover:scale-105 hover:border-[#e4b34d] hover:text-[#fef1a5] hover:shadow-[0_15px_40px_rgba(228,179,77,0.35)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
