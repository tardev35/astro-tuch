---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect. The title and
// description below were rewritten this round for exactly that reason.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// หวยเต็ง (รอบเขียวป่า-ทอง 2026-10-01): ปุ่มนี้เป็นตัว SECONDARY ของคู่
// จึงเป็นแบบ OUTLINE — ผิวยก #0b3d18 ในกรอบเขียวแบรนด์ #026314 บนตัวอักษรทอง
// #e5c04f แล้วยกผิวขึ้นเป็นเขียวเส้น #024a0f ตอน hover ส่วน /register สวมไล่เฉด
// ทองเต็มใบ (#fae474 → #e5c04f → #bd8d2d) ลำดับความสำคัญรอบนี้สื่อด้วย
// "ถมทอง vs กรอบเขียว" — สองปุ่มที่ถมทองเหมือนกันจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม
// กฎคอนทราสต์ brand-spec §2: พื้นทอง = หมึกเข้ม #0a1a0c · พื้นเข้ม = ตัวอักษรทอง
// #e5c04f · ห้ามตัวอักษรขาวบนพื้นทอง (ขาวบน #e5c04f ตก AA)
// ชุดน้ำเงินรอยัล-ทองของ BRAVO168 (#02081a #04142f #072247 #0e3f8f #1558c4 #2f86f0
// #f4cb69 #ffe39a #c9922e #dbe5f5 #0a1020 rgba(244,203,105,*) rgba(21,88,196,*)
// rgba(2,8,26,*)) ออกครบแล้ว ห้ามนำกลับมา
//
// Announcement หมุนมาเป็น Announcement3 ทั้งเว็บรอบนี้ (รอบก่อนเป็น
// AnnouncementPremium) — default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ
// index ก็เรียกแบบ bare
//
// หวยเต็ง เป็นเว็บแทงหวยออนไลน์ ไม่ใช่บอลและไม่ใช่สล็อต — บรีฟพูดถึงการเลือกเลข
// ส่งโพย ตรวจสอบรายการ อัตราจ่าย เวลาปิดรับ และผลรางวัลตามรอบ ของหวยรัฐบาลไทย
// ลาวพัฒนา ฮานอยปกติ ฮานอยพิเศษ ฮานอยวีไอพี และหวยหุ้นต่างประเทศ จากบัญชีเดียว
// ตัวเลขที่ใช้ได้มีแค่ 2 ตัว จ่าย 100 บาท · 3 ตัว จ่าย 1,000 บาท · 3 ขั้นตอน ·
// 24 ชั่วโมง
// คำศัพท์ของสองแบรนด์ก่อน (บอล ฟุตบอล บอลเดี่ยว บอลสเต็ป บอลสด ค่าน้ำ อัตราต่อรอง
// ลีก คู่แข่งขัน แมตช์ บิล แฮนดิแคป สล็อต ฟรีสปิน แจ็กพอต บาคาร่า รูเล็ต คาสิโน)
// ห้ามหลงเหลือ
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 156
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = "หน้าเข้าสู่ระบบ หวยเต็ง กดปุ่มเดียวเข้าบัญชีสมาชิกเพื่อเลือกรายการหวย ส่งโพย ตรวจสอบอัตราจ่ายและเวลาปิดรับของแต่ละรอบ พร้อมดูผลรางวัลผ่านเบราว์เซอร์บนมือถือ";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ หวยเต็ง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="เข้าสู่ระบบ หวยเต็ง ล็อกอินเข้าบัญชีสมาชิก ส่งโพยและตรวจผลได้ทันที" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ หวยเต็ง" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ หวยเต็ง"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#026314] bg-[#0b3d18] px-6 py-4 text-lg font-black text-[#e5c04f] shadow-[0_10px_30px_rgba(3,21,10,0.85)] transition-all duration-300 hover:scale-105 hover:border-[#0bb42f] hover:bg-[#024a0f] hover:text-[#fae474] hover:shadow-[0_15px_40px_rgba(2,99,20,0.35)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
