---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect. The title and
// description below are written for exactly that reason.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// หวยดีใจ (รอบแดงแบรนด์ + เงินโครเมียม บนดำอมแดง 2026-10-04, brand-spec §2 —
// แดง #dc0409 มาจาก vivid ของ logo.webp ที่คำว่า "ดีใจ" เป็นแดงเมทัลลิก ส่วนเงิน
// โครเมียม #eef0f4 / #c3c7d1 มาจากคำว่า "หวย" ในโลโก้เดียวกัน และทอง #f3c54e
// เหลือเป็น accent รองจากมงกุฎเหนือโลโก้เท่านั้น รอบก่อนคู่หลักเป็นแดง/ทอง
// รอบนี้จึงเปลี่ยนแกนที่สองจากทองเป็นเงิน ห้ามใช้ทองเป็นพื้นปุ่มอีก):
// ปุ่มนี้เป็นตัว SECONDARY ของคู่ จึงถม **ผิวการ์ดยก #211016 ในกรอบเงินโครเมียม
// #c3c7d1/50** บนตัวอักษรเนื้อความ #edeaf0 แล้ว hover ยกกรอบเป็นเงินสว่าง
// #eef0f4/80 กับผิวการ์ด #17080c ส่วน /register ถมแดงแบรนด์เต็มใบ
// (#e8161c → #dc0409 → #8e0206) บนตัวอักษรขาว
// ลำดับความสำคัญรอบนี้จึงสื่อด้วย "แดงถม vs เงินขอบ" ไม่ใช่ถมสีเดียวกันสองใบซึ่งจะ
// อ่านเป็นปุ่มซ้ำกันสองปุ่ม — และคู่แดง/เงินนี้คือสองโทนที่อยู่บนโลโก้จริง
// กฎคอนทราสต์: พื้นแดง = หมึก **ขาว** เสมอ และแดงที่สว่างที่สุดที่ยังผ่าน AA บน
// หมึกขาวคือ #e8161c จึงห้ามใช้แดงสว่าง #f5363d เป็นพื้นปุ่มที่มีข้อความ ·
// พื้นเข้ม #211016 / #17080c = ตัวอักษรเนื้อความ #edeaf0
// ชุดแดง+ทองของแบรนด์ก่อน (#d20a0a #f5c33b #ffd45e #a9761a #f7e2d6 #170707
// #0a0303 #230d0d #1a0303 rgba(210,10,10,*) rgba(245,195,59,*)) ออกครบแล้ว
// ห้ามนำกลับมา
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ (รอบก่อนเป็น
// Announcement3) — default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ
// index ก็เรียกแบบ bare จึงห้ามส่ง prop message
//
// หวยดีใจ เป็น **เว็บรับแทงหวยล้วน** ไม่ใช่คาสิโน บรีฟระบุว่าหลัง Login สมาชิกเลือก
// หวย รอบ และเลขที่ต้องการ แล้วตรวจสอบยอดเดิมพันกับอัตราจ่ายก่อนยืนยันรายการ
// พร้อมดูผลรางวัลและประวัติรายการจากบัญชีเดียว
// ตลาดหวยที่บรีฟระบุและอ้างได้มีห้าตัว: รัฐบาลไทย · หวยลาว · หวยฮานอย ·
// หวยออมสิน · หวย ธ.ก.ส.
// ตัวเลขที่ใช้ได้มีแค่ 100 / 1,000 / 2 ตัว / 3 ตัว / 3 ขั้นตอน / 24 ชั่วโมง
// ห้ามแต่งตัวเลขอื่นขึ้นมาเอง และห้ามเอ่ยเวลาเปิด-ปิดรับของหวยรอบใดรอบหนึ่ง
// ชื่อธนาคาร ยอดฝากขั้นต่ำ หรือเลขใบอนุญาต ที่บรีฟไม่ได้ระบุ
// คำหมวดคาสิโน (สล็อต บาคาร่า คาสิโนสด ค่ายเกม RTP คืนยอดเสีย % แนะนำเพื่อน %)
// ห้ามหลงเหลือ
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 154
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าเข้าสู่ระบบ ${BRAND_NAME} กดปุ่มเดียวเข้าบัญชีสมาชิก เพื่อเลือกรัฐบาลไทย หวยลาว หวยฮานอย ออมสิน ธ.ก.ส. กรอกเลข ตรวจอัตราจ่ายและวงเงิน ก่อนยืนยันส่งโพยทุกรอบ`;

const graph = pageGraph(Astro, {
  name: `เข้าสู่ระบบ ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`เข้าสู่ระบบ ${BRAND_NAME} ล็อกอินเข้าบัญชีสมาชิก เลือกหวยและส่งโพยได้ทันที`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`เข้าสู่ระบบ ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#c3c7d1]/50 bg-[#211016] px-6 py-4 text-lg font-black text-[#edeaf0] shadow-[0_10px_30px_rgba(13,4,7,0.75)] transition-all duration-300 hover:scale-105 hover:border-[#eef0f4]/80 hover:bg-[#17080c] hover:shadow-[0_15px_40px_rgba(195,199,209,0.3)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
