---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect. The title and
// description below were rewritten this round for exactly that reason.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// หวยเฮง24 (รอบแดงเข้ม-ทอง 2026-10-01): ปุ่มนี้เป็นตัว SECONDARY ของคู่
// จึงเป็นแบบ OUTLINE — ผิวยก #3d0808 ในกรอบแดงแบรนด์ #8b0302 บนตัวอักษรทอง
// #e0a52a แล้วยกผิวขึ้นเป็นแดงลึก #5a0202 ตอน hover ส่วน /register สวมไล่เฉด
// ทองเต็มใบ (#fdea83 → #fbdc64 → #bd7c13) ลำดับความสำคัญรอบนี้สื่อด้วย
// "ถมทอง vs กรอบแดง" — สองปุ่มที่ถมทองเหมือนกันจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม
// กฎคอนทราสต์ brand-spec §2: พื้นทอง = หมึกเข้ม #2a0606 · พื้นเข้ม = ตัวอักษรทอง
// #e0a52a · ห้ามตัวอักษรขาวบนพื้นทอง (ขาวบน #e0a52a ตก AA)
// ชุดเขียวป่า-ทองของ หวยเต็ง (#03150a #062a12 #0b3d18 #026314 #024a0f #0bb42f
// #e5c04f #fae474 #bd8d2d #d8ead9 #0a1a0c rgba(229,192,79,*) rgba(2,99,20,*)
// rgba(3,21,10,*)) ออกครบแล้ว ห้ามนำกลับมา
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ (รอบก่อนเป็น Announcement3)
// — default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ index ก็เรียกแบบ bare
//
// หวยเฮง24 เป็นเว็บเล่นหวยออนไลน์ ไม่ใช่บอลและไม่ใช่สล็อต — บรีฟพูดถึงการเลือกเลข
// ส่งโพย ตรวจสอบรายการ อัตราจ่าย เวลาเปิดรับ เวลาปิดรับ และการเช็คผลหลังประกาศผล
// ของหวยลาว หวยฮานอย หวยรัฐบาลไทย และหวยหุ้น จากบัญชีเดียว
// ตัวเลขที่ใช้ได้มีแค่ 2 ตัว จ่าย 100 บาท · 3 ตัว จ่าย 1,000 บาท · 3 ขั้นตอน ·
// 24 ชั่วโมง
// คำศัพท์ของแบรนด์ก่อนหน้า (สล็อต ฟรีสปิน ตัวคูณ ค่ายเกม RTP แตกง่าย เว็บตรง บอล
// ค่าน้ำ อัตราต่อรอง ลีก บิลสเต็ป แฮนดิแคป คาสิโน บาคาร่า) ห้ามหลงเหลือ
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 153
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = "หน้าเข้าสู่ระบบ หวยเฮง24 กดปุ่มเดียวเข้าบัญชีสมาชิกเพื่อเลือกรายการหวย ส่งโพย ตรวจสอบอัตราจ่ายและเวลาปิดรับของแต่ละรอบ พร้อมเช็คผลผ่านเบราว์เซอร์บนมือถือ";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ หวยเฮง24",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="เข้าสู่ระบบ หวยเฮง24 ล็อกอินเข้าบัญชีสมาชิก ส่งโพยและเช็คผลได้ทันที" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ หวยเฮง24" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ หวยเฮง24"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#8b0302] bg-[#3d0808] px-6 py-4 text-lg font-black text-[#e0a52a] shadow-[0_10px_30px_rgba(20,3,3,0.85)] transition-all duration-300 hover:scale-105 hover:border-[#c01616] hover:bg-[#5a0202] hover:text-[#fbdc64] hover:shadow-[0_15px_40px_rgba(192,22,22,0.35)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
