---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change (CtaRedirect.astro
// itself belongs to the orchestrator — ห้ามแก้ไฟล์นั้นจากหน้านี้)
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page, which means verify-build holds its
// description to the same 150–160 character window as every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES — คอปปี้ของหน้านี้จึงพูด
// ได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 6: สล็อตคลาสสิก เกมแนวผจญภัย ฟีเจอร์โบนัส
// สัญลักษณ์พิเศษ ตารางจ่ายรางวัล และค่า RTP · บรรทัด 20: หลังลงทะเบียนสามารถศึกษา
// รายชื่อเกมสล็อต กติกาการเล่น อัตราจ่าย และรายละเอียดโปรโมชั่นที่เปิดให้บริการ ·
// บรรทัด 22: ควรตรวจสอบช่องทางจากเว็บไซต์ทางการ)
// ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า หน้านี้มีโควตาเป็นปุ่มเดียว
//
// ⚠️ แกนของบรีฟรอบนี้คือ **เว็บสล็อตออนไลน์ "สล็อตเงินดี อัตราจ่ายสูง
// ค่ายเกมลิขสิทธิ์แท้100%"** ไม่ใช่แกนของรอบก่อน และไม่ใช่เว็บลอตเตอรีแบบรอบ
// ก่อนหน้านั้น ศัพท์ของหมวดอื่นที่บรีฟไม่มีทุกคำจึงเป็นของค้างที่ห้ามหลุดกลับมา
// รายการคำเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไป
// เจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// คำที่ใช้ได้รอบนี้: สล็อต · สล็อตออนไลน์ · เกมสล็อต · เงินดี · อัตราจ่ายสูง ·
// อัตราจ่าย · ค่ายเกม · ค่ายมาตรฐานสากล · ค่ายผู้พัฒนา · ลิขสิทธิ์แท้100% ·
// สถานะลิขสิทธิ์ · มากกว่า 1,000 เกม · สล็อตคลาสสิก · เกมแนวผจญภัย ·
// ฟีเจอร์โบนัส · สัญลักษณ์พิเศษ · ตารางจ่ายรางวัล · ค่า RTP · ผลรางวัล · กติกา ·
// เงื่อนไขการเดิมพัน · โปรโมชั่น · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% ·
// กดรับได้ไม่จำกัด · เครดิต · สมัครสมาชิก · เข้าสู่ระบบ · ยืนยันบัญชี ·
// รหัสผ่าน · รหัส OTP · แอดมิน · เจ้าหน้าที่ · 24ชม. · เว็บไซต์ทางการ ·
// ประกาศล่าสุด · บัญชีแอบอ้าง · ฝากถอน
// ⚠️⚠️ **คำคู่ของแบรนด์ขาออก (พักยก168) ที่ต่อท้ายชื่อ route นี้ด้วย ฟรี / โหมด~
// ไม่ใช่คำของบรีฟรอบนี้** (คำเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่)
// — "ทดลองเล่น" เหลือรอดได้ที่เดียวคือชื่อ route /ทดลองเล่น
// ⚠️ **สองหน้าหมวดลอตเตอรีอยู่ใน src/pages-disabled/ รอบนี้**
// ห้ามลิงก์ไปสองเส้นทางนั้น route ไม่มีอยู่จริง build จะแดง
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกม ชื่อธนาคาร ชื่อวอลเล็ต หน่วยงานกำกับ หรือ
// ใบอนุญาตแม้แต่รายเดียว** — พูดแค่ "ค่ายมาตรฐานสากล" แล้วจบ
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 1,000 เกม · 0.3% · 0.8% · 24ชม. ·
// 3 ขั้นตอน · 100% ห้ามแต่งใบอนุญาต ค่า RTP ที่เป็นตัวเลข ยอดฝากขั้นต่ำ หรือ
// จำนวนสมาชิก · บรีฟรอบนี้มี "ขั้นตอน 1-3" ของการสมัคร แต่นั่นเป็นของ index.astro
// (FeatureHighlights) ไม่ใช่ของหน้านี้ หัวข้อช่องทางติดต่อแอดมินของบรีฟก็เป็นของ
// index.astro เช่นกัน
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตต์รอบนี้อยู่ใน .claude/brand-spec-ngernthong168.md §2
// ⚠️⚠️ **รอบนี้ยังเป็น "ธีมมืด" เหมือนรอบก่อน แต่คนละค่า — การ์ดผิวน้ำตาลเข้ม
// หมึกครีมอุ่น** bg.json = {"mode":"color","color":"#29210f"} = **น้ำตาลโอลีฟเข้ม**
// (รอบก่อนเป็น 291d0f ต่างกันที่เขียว 4 หน่วย — ค่ามาจากไฟล์ ห้ามเดาว่าเท่าเดิม)
// การ์ด ContentBox จึงเป็นผิว #3d3016 บนหมึกครีม #ecd5c4 (= BRAND_TEXT)
// ปุ่มนี้เป็นคู่ SECONDARY ของพาเลต: **ปุ่มขอบ** ขอบ #f5ba14 ตัวอักษร #fcee52
// บนพื้นโครมกลาง #2e2512 ส่วน /register เป็น PRIMARY ถมไล่เฉดทองบนหมึกเข้ม
// จึงไม่ซ้ำกัน
// ⚠️⚠️ **วัสดุที่สองของรอบนี้คือครีมอุ่น #ecd5c4 ไม่ใช่เทาโครเมียม** — แรมป์เทาเงิน
// (e0e0df c0c0bf a1a09e) เป็นของพักยก168 รอบก่อนทันที **ห้ามยกกลับเข้ามาเป็นสี UI
// หรือพื้นปุ่มเพื่อให้ปุ่มคู่นี้ "ถมทั้งคู่"** นี่คือหนึ่งในสองตัวที่แยกรอบนี้
// ออกจากรอบก่อน (อีกตัวคือค่าทองเอง)
// ⚠️ ปุ่มของ Navfoot อยู่บนแถบโครมคนละโซนกับปุ่มบนการ์ดนี้
// **ห้ามลอกคลาสของ Navfoot มาวางบนการ์ด**
// ⚠️⚠️ **ห้ามสลับเป็นพื้นถมทองแล้วใส่ตัวอักษรขาว** ขั้วคือพื้นถมทอง-หมึกเข้ม #201906
// ⚠️⚠️ **#b37c0b ห้ามถือตัวอักษรบนพื้นมืด** (2.0:1) เป็นสีพื้นถม/ขอบ/ออราเท่านั้น
// ออราในไฟล์นี้ใช้ rgba(245,186,20,α) เท่านั้น
//
// ⚠️ กับดักรอบนี้คือ **ทองเคยผ่านรีโปนี้มาแล้วเกือบทุกเจ้า และรอบนี้เป็นทองนำ
// สองรอบติดกัน** "มีทองอยู่แล้ว" จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้
// ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive
// รอบนี้ **ไม่มีฟ้า/น้ำเงิน ไม่มีแดง ไม่มีเขียว (ยกเว้น LINE green ที่หน้าอื่น)
// ไม่มีชมพู ไม่มีม่วง ไม่มีส้ม ไม่มีโรสโกลด์ และไม่มีแรมป์เทาเงิน**
//
// Announcement หมุนมาเป็น Announcement2 ทั้งเว็บรอบนี้ (brand-spec §3 — รอบก่อนใช้
// AnnouncementPremium จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์
// นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare — ห้ามส่ง prop message
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) หน้านี้ยาว 153
// ด้วยชื่อแบรนด์ 10 ตัวอักษรของรอบนี้
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าเข้าสู่ระบบ ${BRAND_NAME} กดปุ่มเดียวเพื่อเข้าบัญชีสมาชิก สำหรับดูรายชื่อเกมสล็อต ตารางจ่ายรางวัล และรายละเอียดโปรโมชั่นจากประกาศล่าสุดของเว็บไซต์ทางการ`;

const graph = pageGraph(Astro, {
  name: `เข้าสู่ระบบ ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`เข้าสู่ระบบ ${BRAND_NAME} เข้าบัญชีสมาชิกเพื่อดูรายละเอียดเกมสล็อตและโปรโมชั่น`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`เข้าสู่ระบบ ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border-2 border-[#f5ba14] bg-[#2e2512] px-6 py-4 text-2xl font-bold tracking-wide text-[#fcee52] shadow-[0_10px_30px_rgba(245,186,20,0.25)] transition-all duration-300 hover:scale-105 hover:border-[#fcee52] hover:shadow-[0_15px_40px_rgba(245,186,20,0.45)]">
        <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#f5ba14]/20 to-transparent"></span>
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
