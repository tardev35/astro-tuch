---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char).
const pageDescription =
  "หน้าเข้าสู่ระบบ BETPLAY369 กดปุ่มเดียวเพื่อเข้าบัญชีสมาชิก เลือกเล่นบาคาร่า คาสิโนสด สล็อต หวย มวย และบอล พร้อมตรวจสอบโปรโมชั่นและรายการฝากถอนได้ในบัญชีเดียว";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ BETPLAY369 ล็อกอินเข้าบัญชีสมาชิก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="เข้าสู่ระบบ BETPLAY369 ล็อกอินเข้าบัญชีสมาชิก เว็บเกมคาสิโนครบวงจร" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ BETPLAY369" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ BETPLAY369"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#a48fc4]/70 bg-[#08030f] px-6 py-4 text-lg font-black text-[#f4ebff] shadow-[0_10px_30px_rgba(229,57,159,0.18)] transition-all duration-300 hover:scale-105 hover:border-[#22c6f0] hover:bg-[#1a0730] hover:shadow-[0_15px_40px_rgba(34,198,240,0.30)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
