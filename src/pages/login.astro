---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. The page carries exactly ONE heading, and it is the
// level-one heading that ContentBox renders from its own `as` prop; there is no
// level-two and no level-three heading anywhere on it. Never write an article
// here and never add a second heading — verify-build fails the build the moment
// a second top-level heading appears on an indexable page.
// (The heading token is deliberately not spelled out in this comment: a source
// grep for it used to match the prose here as well as the real prop below, and
// every round someone had to re-derive which of the two matches was real.)
//
// ⚠️ This page is NOT one of the "full custom HTML + own <style> block"
// standalone pages SKILL.md Phase 4.5 warns about — it renders through
// MainLayout + ContentBox like every other sub-page, so it has no .brand-identity
// string and no raw-hex <style> block of its own. The only brand colours here
// are the Tailwind arbitrary values on the button below. Do not "restore" a
// <style> block; the font link and <html> colour come from MainLayout.
// ⚠️ **ห้ามใช้ define:vars บนหน้านี้** — เดิมหน้านี้เป็น interstitial แบบ noindex
// จึงเคยได้รับการยกเว้น แต่ตอนนี้มันเป็นหน้าที่ index ได้ ข้อยกเว้นนั้นหมดไปแล้ว
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change.
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page (no `robots` prop = indexable), which means
// verify-build holds its description to the same 150–160 character window as
// every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) **ไม่มีส่วน SUB-PAGES** → title/description
// ของหน้านี้เขียนเอง และพูดได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 1-2 และ 5-6:
// คาสิโนเล่นบาคาร่า · ทางเข้าเล่น · เกมเดิมพันสด · ลิขสิทธิ์แท้จากเมกา ·
// ไม่หักเปอร์เซ็นต์ · เซิร์ฟนอก · ปลอดภัย100% · บรรทัด 16: ตรวจสอบที่อยู่เว็บไซต์
// ให้ถูกต้อง · บรรทัด 18 และ 22: ไม่เปิดเผยรหัสผ่านและรหัส OTP ให้ใครทราบ)
// ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า — หน้านี้มีโควตาเป็น **ปุ่มเดียว**
//
// 🚨 แกนของแบรนด์รอบนี้คือ **เว็บคาสิโนออนไลน์เน้นบาคาร่า** บรีฟระบุ
// **สามหมวดเกมเท่านั้น** (บาคาร่าออนไลน์ · เกมคาสิโนสด · เกมสล็อต)
// 🚨🚨 **รอบก่อนมีเจ็ดหมวด — ห้ามสืบทอดลิสต์ข้ามรอบเด็ดขาด** และ **บรีฟรอบนี้
// ไม่มีคำว่าหวยเลยสักคำ** ห้ามเขียนเนื้อหาเฉพาะทางหวย
// ⚠️ น้ำเสียงของบรีฟรอบนี้คือ "โฆษณาและกำกับในประโยคเดียวกัน" ไม่ใช่การันตี
// คลังคำที่ใช้ได้รอบนี้อยู่ใน .claude/brand-spec-win8s.md §5 (ไม่พิมพ์ซ้ำที่นี่
// และ **ไม่พิมพ์คำของแบรนด์เก่าซ้ำที่นี่** เพื่อไม่ให้ sweep ของรอบถัดไปเจอ
// false positive ในคอมเมนต์ของไฟล์นี้เอง)
// 🚨 สามคำที่ **กลับทิศจากรอบก่อน** และเป็นถ้อยคำของบรีฟรอบนี้เอง:
// **เซิร์ฟนอก · ปลอดภัย100% · ลิขสิทธิ์แท้จากเมกา** — ห้ามลบออกเพราะอ่าน
// คอมเมนต์เก่าในไฟล์ inventory แล้วเข้าใจผิดว่าเป็นคำของแบรนด์เก่า
// ⚠️ และสังเกตว่าคำของแบรนด์ขาออกต่างจากคำของรอบนี้แค่คำท้าย — ต้องอ่านให้ครบคำ
// ก่อนตัดสินว่าเป็นของค้าง
// ตัวเลขที่อ้างได้รอบนี้มีแค่ 0.3% · 0.8% · 100% · 3 ขั้นตอน · 24ชม. — ห้ามแต่ง
// ใบอนุญาต จำนวนสมาชิก ปีก่อตั้ง จำนวนค่าย/เกม หรือค่าร้อยละอื่นใด
// 🚨🚨 **บรีฟรอบนี้ไม่มีหมวดธุรกรรมการเงิน/สถาบันการเงิน/กระเป๋าเงินอิเล็กทรอนิกส์เลยสักคำ** —
// ห้ามเขียนถึงรายการเหล่านั้น ชื่อผู้ให้บริการกระเป๋าเงิน หรือชื่อค่ายเกมบนหน้านี้
// (ค่าร้อยละสองค่าของโปรโมชั่นเป็นเนื้อหาของ index กับ /promotion ไม่ใช่ของหน้านี้)
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตรอบนี้อยู่ใน .claude/brand-spec-win8s.md §2
// 🚨🚨 **กลับทิศ 180° จากรอบก่อน: รอบนี้ "มืดทั้งเว็บ"** ทั้งเนื้อหาและโครม
// bg.json = {"mode":"color","color":"#1e0101"} = ดำอมเลือดหมูเกือบสนิท
// การ์ด ContentBox จึงเป็น **ผิวเข้ม 2a0a04 บนหมึกสว่าง fdf0e6** (= BRAND_TEXT,
// 16.4:1) — **ห้ามคืนการ์ดผิวสว่างของรอบก่อนกลับมาแม้แต่ใบเดียว**
// ปุ่มนี้อยู่ในชุด **CTA หลัก** ของพาเลต (ส้มเพลิง-ทองอำพัน) แต่ใช้ **สองสต็อป**
// from f27a1a → to e8620e บนหมึก **ดำอมเลือดหมู 1e0101** (7.1 / 5.8:1 ผ่าน AA
// ทั้งสอง stop) ส่วน /register ใช้ **สามสต็อปเต็ม** จึงไม่ซ้ำกัน
// 🚨🚨 **หมึกขาวบนเฉดนี้ตก 2.8:1 — ห้ามใช้ขาวบนปุ่มนี้เด็ดขาด** (รอบก่อนปุ่มหลัก
// เป็นแดงเข้มจึงรองขาวได้ รอบนี้กลับทิศเต็มๆ)
// 🚨🚨 **ห้ามลากปลายเฉดเข้มกว่า e8620e** — เข้มกว่านั้นหมึกเข้มตกต่ำกว่า 4.5:1
// 🚨🚨 **5a2410 · 8a3a12 · 3b130b · 250604 · 140302 ห้ามถือตัวอักษรทุกบริบท** —
// เป็นเส้น/ขอบ/ออรา/พื้นถมเท่านั้น (ขอบของปุ่มนี้คือ 8a3a12 ซึ่งเป็น "ขอบ" จึงใช้ได้)
// ⚠️ ปุ่มนี้อยู่บนการ์ด **ผิวเข้ม** และตัวปุ่มสว่างกว่าการ์ดชัดเจน ขอบกับเงาเป็น
// ตัวช่วยแยกชั้น ห้ามถอดออก
// ⚠️⚠️ **ภาษาภาพของรอบนี้คือห้องญี่ปุ่นโทนขาวงาช้าง/กิ่งซากุระชมพู-ขาว/
// กิโมโนแดง-ดำปักทอง/ชิปคาสิโนดำ-ทอง/ไพ่เอซ/ตราโล่เข้มที่มีมงกุฎทอง เสาโทริอิ
// และมังกร** โลโก้เป็นเวิร์ดมาร์กสามมิติ สี่ตัวแรกผิวส้มเพลิงไล่ทองตัดขอบดำ
// ตัวสุดท้ายผิวโครเมียมเงินขัดเงา — **ผนังห้องสีขาวงาช้างและสีผิวนางแบบเป็นวัตถุ
// ในภาพ ไม่ใช่สี UI** พื้นเพจมาจาก bg.json เท่านั้น **ห้ามอนุมานสีจากรูป**
// (รอบนี้รูปสว่างแต่เว็บมืด)
// ออราในไฟล์นี้ใช้ rgba(20,3,2,α) · rgba(242,122,26,α) เท่านั้น
//
// ⚠️⚠️ กับดักรอบนี้: **ZNOVA168 (เจ้าของเดิมของ NavbarStyle9 ที่หมุนเข้ามารอบนี้)
// เป็นแบรนด์ น้ำตาลเข้ม/อำพัน = ตระกูลสีเดียวกับรอบนี้เป๊ะ** รองลงมาคือ
// MEXICANOSLOT (แดง/ทอง/ครีม) และ TEVA69 (ทอง) → **"เจอส้ม/ทองอยู่แล้ว" จึงไม่
// พิสูจน์ว่าเป็นค่าของรอบนี้** ต้องเทียบ **ทีละหลัก** กับตารางใน brand-spec §2
// ซึ่งไม่พิมพ์ซ้ำที่นี่เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive
// **ผิว/หมึกของรอบนี้คือ 1e0101 / 2a0a04 / 3b130b / 250604 / 140302 / 5a2410 /
// 8a3a12 / fdf0e6 / e0bda4 / f27a1a / f0a21e / e8620e / e5a92b / c9d2dc เท่านั้น**
// รอบนี้ **ไม่มีม่วง ไม่มีฟ้า/ไซแอน ไม่มีแมเจนต้า/ชมพู และไม่มีเขียวเป็นสี UI**
// เลยสักเฉด · ปุ่ม LINE (00B900) อยู่บน /about-us กับ /contact-us ไม่ใช่หน้านี้
// (เขียนเฮกซ์แบบถอด # และถอดวงเล็บโดยตั้งใจ — tools/gen-tw-sources.mjs สแกนไฟล์นี้
// แบบ plain text รวมคอมเมนต์ คลาสสีเต็มรูปในคอมเมนต์จะถูก generate ลง stylesheet จริง)
//
// Announcement รอบนี้หมุนมาเป็นตัวที่ลงท้ายด้วยคำว่าพรีเมียม ทั้งเว็บ
// (brand-spec §3 — รอบก่อนใช้ตัวท้ายชื่อเลข 5 ของตระกูลจึงหมุนออก · เขียนชื่อไฟล์
// แบบไม่มีเครื่องหมายคำพูดโดยตั้งใจ เพราะ tools/gen-tw-sources.mjs นับ literal
// ที่มีเครื่องหมายคำพูดว่าเป็นการ import จริง คอมเมนต์จึงทำให้ variant เก่าหลุดเข้า
// Tailwind scan แล้วสีของแบรนด์ก่อนขึ้น stylesheet) orchestrator เป็นเจ้าของ
// default message ของไฟล์นั้น จึงเรียกแบบ bare — **ห้ามส่ง prop message**
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) สตริงนี้ยาว 155
// ด้วยชื่อแบรนด์ 5 อักขระของรอบนี้ ส่วนที่ไม่ใช่ชื่อแบรนด์ยาว 150 → รับชื่อแบรนด์
// ได้ 1–10 อักขระ ถ้ารอบหน้าชื่อยาวกว่านั้นต้องแก้ข้อความ ไม่ใช่ปล่อยผ่าน
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าเข้าสู่ระบบ ${BRAND_NAME} คาสิโนเล่นบาคาร่า เซิร์ฟนอก กดปุ่มเดียวไปยังหน้าเข้าบัญชีสมาชิก ควรตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง และไม่เปิดเผยรหัสผ่านหรือรหัส OTP`;

const graph = pageGraph(Astro, {
  name: `เข้าสู่ระบบ ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/hx8w";
---

<MainLayout title={`เข้าสู่ระบบ ${BRAND_NAME} คาสิโนเล่นบาคาร่า กดปุ่มเดียวเข้าบัญชีสมาชิก`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`เข้าสู่ระบบ ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="group mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 rounded-xl border-2 border-[#8a3a12] bg-gradient-to-b from-[#f27a1a] to-[#e8620e] px-6 py-4 text-2xl font-bold tracking-wide text-[#1e0101] shadow-[0_10px_30px_rgba(20,3,2,0.45)] transition-all duration-300 hover:scale-105 hover:border-[#e5a92b] hover:shadow-[0_15px_40px_rgba(242,122,26,0.32)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
