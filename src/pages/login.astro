---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect. The title and
// description below are written for exactly that reason.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// DM899 (รอบเขียวมรกต-แดงสด-ทอง บนดำอมเขียว 2026-10-03, brand-spec §2 — มาจาก
// logo.webp ที่เป็นตัว D เขียว #01841b ซ้อนตัว M แดง #fb252b และเลข 899 เงินโครเมียม):
// ปุ่มนี้เป็นตัว SECONDARY ของคู่ จึงเป็นแบบ outline — พื้นยกระดับ #102a16 ในกรอบ
// ทองแบรนด์ #f2b422/60 บนตัวอักษรทองอ่อน #ffe9a8 แล้วยกกรอบเป็นทองเต็ม #f2b422
// ตอน hover ส่วน /register สวมไล่เฉดเขียวเต็มใบ (#4ade6b → #01a326 → #01841b)
// บนตัวอักษรดำอมเขียว #06140a
// ลำดับความสำคัญรอบนี้จึงสื่อด้วย "เขียวถม vs ทองกรอบ" ไม่ใช่ถมเขียวสองใบซึ่งจะอ่าน
// เป็นปุ่มซ้ำกันสองปุ่ม
// กฎคอนทราสต์: พื้นเขียวสว่าง = หมึก **ดำอมเขียว #06140a** เสมอ (หมึกขาวบน #4ade6b
// ตก) · พื้นเข้ม #102a16/#061008 = ตัวอักษรทองอ่อน #ffe9a8 หรือเนื้อความ #e4f2e4
// ชุดทอง-เงินโครเมียมของ 1SS365 (#edbb23 #ffeeb4 #a87708 #c8cbce #f1f2f3 #121010
// #f0e6d2 #050505 #2a2115 #f7d458 #1a1710 #c9930f rgba(237,187,35,*) rgba(5,5,5,*))
// ออกครบแล้ว ห้ามนำกลับมา
//
// Announcement หมุนมาเป็น Announcement3 ทั้งเว็บรอบนี้ (รอบก่อนเป็น
// AnnouncementPremium) — default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ
// index ก็เรียกแบบ bare จึงห้ามส่ง prop message
//
// DM899 เป็นสล็อตคาสิโนออนไลน์เว็บตรงต่างประเทศ — ไม่ใช่เว็บหวยและไม่ใช่บอล
// บรีฟระบุว่าหลัง Login ใช้บัญชีเดียวสลับหมวดเกม ทั้งเกมสล็อตและเกมคาสิโนสด พร้อม
// ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการได้จากระบบเดียว
// ตัวเลขที่ใช้ได้มีแค่ 0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง · 100%
// ห้ามแต่งตัวเลขอื่นขึ้นมาเอง และห้ามเอ่ยชื่อค่ายเกม ชื่อธนาคาร หรือเลขใบอนุญาต
// คำศัพท์หวยของแบรนด์ก่อนหน้า (หวย แทงหวย ส่งโพย โพย เลือกเลข 2 ตัว 3 ตัว อัตราจ่าย
// งวด รัฐบาลไทย ฮานอย ลาวพัฒนา หวยหุ้น สถิติหวย ผลหวย แนวทางหวย) ห้ามหลงเหลือ
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 157
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าเข้าสู่ระบบ ${BRAND_NAME} กดปุ่มเดียวเพื่อเข้าบัญชีสมาชิก สำหรับเลือกเกมสล็อตและคาสิโนสดเว็บตรงต่างประเทศ ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการได้จากระบบเดียว`;

const graph = pageGraph(Astro, {
  name: `เข้าสู่ระบบ ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`เข้าสู่ระบบ ${BRAND_NAME} ล็อกอินเข้าบัญชีสมาชิก เลือกเกมสล็อตได้ทันที`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`เข้าสู่ระบบ ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f2b422]/60 bg-[#102a16] px-6 py-4 text-lg font-black text-[#ffe9a8] shadow-[0_10px_30px_rgba(3,10,5,0.75)] transition-all duration-300 hover:scale-105 hover:border-[#f2b422] hover:bg-[#061008] hover:shadow-[0_15px_40px_rgba(242,180,34,0.32)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
