---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char).
const pageDescription =
  "หน้าเข้าสู่ระบบ CAMPING289 สำหรับสมาชิกที่ต้องการล็อกอินเข้าบัญชีของตนเอง เพื่อเข้าตรวจสอบเครดิต โปรโมชั่น และสิทธิพิเศษที่เปิดรับในแต่ละวัน ใช้งานได้ทุกวัน";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ CAMPING289 ล็อกอินเข้าบัญชีสมาชิก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="เข้าสู่ระบบ CAMPING289 สล็อตเว็บตรงเจ้าของแท้ ล็อกอินเข้าบัญชีสมาชิก ตรวจสอบสิทธิพิเศษได้ทุกวัน" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ CAMPING289" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าระบบเกม CAMPING289"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#2f7a2a]/80 bg-[#04120a] px-6 py-4 text-lg font-black text-[#eefae4] shadow-[0_10px_30px_rgba(105,181,34,0.18)] transition-all duration-300 hover:scale-105 hover:border-[#b6e87a] hover:bg-[#072a13] hover:shadow-[0_15px_40px_rgba(105,181,34,0.30)]">
        เข้าระบบเกม
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
