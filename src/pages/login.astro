---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
//
// BRAZIL999 (รอบเขียวมรกต + เงินโครเมียมบนดำ 2026-09-25): ปุ่มนี้เป็นตัว SECONDARY
// ของคู่ และรับฝั่ง "BRAZIL" ของโลโก้ที่เป็นเงินขัดเงา — ผิวยก #123a18 ในกรอบเงิน
// โครเมียม #aab4bf บนเนื้อความ #dfeadd แล้วยกเป็นผิว #1c5a26 กับขอบเงินสว่าง
// #f1f5f9 ตัวอักษรเน้น #f4fbf2 ตอน hover ส่วน /register สวมไล่เฉดเขียวเต็มใบ
// ลำดับความสำคัญถูกสื่อด้วย "สีไหนถมเต็มปุ่ม" ตามโลโก้ที่ BRAZIL เป็นเงินและ 999
// เป็นเขียว — เขียวคู่เงิน ไม่ใช่เขียวสองใบ ซึ่งจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม
// ชุดทอง/เงินอุ่นของรอบก่อนออกครบแล้ว ห้ามนำกลับมา ทองเป็นแอ็กเซนต์ที่สามของแบรนด์นี้
// เท่านั้น และไม่ใช้บนปุ่ม
//
// Announcement หมุนมาเป็น Announcement2 ทั้งเว็บรอบนี้ — default message ของไฟล์
// นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ index ก็เรียกแบบ bare จึงห้ามส่ง prop
//
// BRAZIL999 เป็นแบรนด์คาสิโน — คำศัพท์เฉพาะหมวดของแบรนด์ก่อนหน้า (เกมสด เกมโต๊ะ
// ค่ายเกม) ห้ามหลงเหลือในหน้านี้ บรีฟรอบนี้ไม่ได้ระบุไว้สักคำ
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 156
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = "หน้าเข้าสู่ระบบ BRAZIL999 กดปุ่มเดียวเข้าบัญชีสมาชิกเพื่อเลือกเกมหลายประเภทจากบัญชีเดียว พร้อมตรวจสอบโปรโมชั่นและข้อมูลการใช้งานจากช่องทางอย่างเป็นทางการ";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ BRAZIL999",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="เข้าสู่ระบบ BRAZIL999 ล็อกอินเข้าบัญชีสมาชิก เลือกเกมที่ต้องการได้ทันที" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ BRAZIL999" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ BRAZIL999"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#aab4bf] bg-[#123a18] px-6 py-4 text-lg font-black text-[#dfeadd] shadow-[0_10px_30px_rgba(4,10,5,0.85)] transition-all duration-300 hover:scale-105 hover:border-[#f1f5f9] hover:bg-[#1c5a26] hover:text-[#f4fbf2] hover:shadow-[0_15px_40px_rgba(170,180,191,0.28)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
