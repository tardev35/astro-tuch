---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// The button is the SECONDARY of the pair: graphite card surface (#17181c) with
// a logo-crimson outline (#cd1437), while /register wears the solid crimson
// gradient.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 153.
const pageDescription = "หน้าเข้าสู่ระบบ NEXT55 กดปุ่มเดียวเข้าบัญชีสมาชิกเพื่อเล่นบาคาร่า สล็อต ยิงปลา หวย และแทงบอล พร้อมฝาก-ถอนออโต้ภายใน 5 วินาที ไม่มีขั้นต่ำ ตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ NEXT55",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="เข้าสู่ระบบ NEXT55 ล็อกอินเข้าบัญชีสมาชิก เริ่มเดิมพันได้ทันที" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ NEXT55" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ NEXT55"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#cd1437]/60 bg-[#17181c] px-6 py-4 text-lg font-black text-[#ffb3bf] shadow-[0_10px_30px_rgba(205,20,55,0.22)] transition-all duration-300 hover:scale-105 hover:border-[#f0435f] hover:bg-[#22242a] hover:text-[#e7eaef] hover:shadow-[0_15px_40px_rgba(205,20,55,0.40)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
