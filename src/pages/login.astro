---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 153.
const pageDescription =
  "หน้าเข้าสู่ระบบ JUDTEM168 กดปุ่มเดียวเข้าบัญชีสมาชิกเพื่อเล่นเกมสล็อตต่อได้ทันที ตรวจสอบเครดิต รายการฝากถอนออโต้ และสิทธิ์รับโปรโมชั่นได้ครบจากบัญชีเดียว";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ JUDTEM168 ล็อกอินเข้าบัญชีสมาชิก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="เข้าสู่ระบบ JUDTEM168 ล็อกอินเข้าบัญชีสมาชิก เล่นเกมสล็อตได้ตลอดทั้งวัน" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ JUDTEM168" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ JUDTEM168"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#6a5115]/70 bg-[#050301] px-6 py-4 text-lg font-black text-[#fff6d4] shadow-[0_10px_30px_rgba(204,156,45,0.18)] transition-all duration-300 hover:scale-105 hover:border-[#e8bf4e] hover:bg-[#120c04] hover:shadow-[0_15px_40px_rgba(232,191,78,0.30)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
