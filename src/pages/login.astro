---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect. The title and
// description below are written for exactly that reason.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// UOK365 (รอบทองเมทัลลิก-เงินโครเมียมบนดำ 2026-10-07, brand-spec §2 — ทองแบรนด์
// #c8912f ปรับสว่างจาก vivid อันดับ 1 ของ logo.webp (#a46b25) ที่ตัวอักษร UOK
// เป็นทอง ส่วนเลข 365 เป็นเงินโครเมียม #d8dbe0 ซึ่งเป็น "เมทัลแอกเซนต์"
// ไม่ใช่สีแบรนด์ตัวที่สอง · bg.json ของดรอปนี้เป็น #000000 และงานศิลป์ทั้งชุด
// เป็นโถงเกือบดำที่ส่องด้วยแสงทอง จึงไม่มีฮิวที่สองมาแยกลำดับปุ่ม):
// ปุ่มนี้เป็นตัว SECONDARY ของคู่ จึงถม **ผิวยกเข้ม** #19100a → #070504
// ขอบทองแบรนด์ #c8912f/55 บนหมึกทองอ่อน #f5d98a แล้ว hover ยกขอบเป็นทองเต็ม
// ส่วน /register ถม **ทอง** เต็มใบ (#f5d98a → #c8912f 55% → #a46b25) บนหมึก
// #191005 ลำดับความสำคัญรอบนี้จึงสื่อด้วย "ทองถม vs ผิวเข้มขอบทอง" ไม่ใช่ถม
// สีเดียวกันสองใบซึ่งจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม — ตรงกับคู่ปุ่มของ NavbarPremium
// กับ FooterPremium ที่ orchestrator รีธีมไว้แล้ว (ทองถม/หมึก #191005 คู่กับ
// ผิว #19100a ขอบ #c8912f/55 ตัวอักษร #f5d98a)
// กฎคอนทราสต์ของสเปก: พื้นทองถมใช้หมึกเข้ม **#191005** เสมอ ห้ามขาว/ครีม
// (หมึกสว่างบน #c8912f เหลือ ~2.6:1 ตก AA) และสต็อปเข้มสุดของไล่เฉดหยุดที่
// #a46b25 ไม่ลงไปถึง #6d4412 เพื่อให้ #191005 ยังอ่านได้ทั้งใบ
// ชุดเขียวนีออนของ BOOM369 (#42fb5a #8dffa0 #04ab3a #036b26 #03150a #0b231b
// #07170f #041109 #cfe9d7 #dadcdc #f3c44a rgba(66,251,90,*) rgba(141,255,160,*)
// rgba(4,171,58,*) rgba(3,107,38,*)) ออกครบแล้ว ห้ามนำกลับมา
//
// Announcement หมุนมาเป็น AnnouncementPremium ทั้งเว็บรอบนี้ (รอบก่อนเป็น
// AnnouncementCyber) — default message ของไฟล์นั้นเป็นคอปปี้ของ UOK365 แล้ว และ
// index ก็เรียกแบบ bare จึงห้ามส่ง prop message
//
// UOK365 เป็น **เว็บสล็อต** ไม่ใช่เว็บหวย — คำหมวดหวย (หวย ส่งโพย โพย เลขเด็ด
// แนวทาง อัตราจ่าย งวด ผลรางวัล ตรวจหวย) ห้ามหลงเหลือ และคำของแบรนด์ก่อน
// (ไฮคลาส VIP ส่งตรงจากเว็บแม่ ค่ายเกมพรีเมียม ไม่ผ่านบัญชีม้า) ก็ห้ามเช่นกัน
// บรีฟบรรทัด 9 กับ 16 ระบุว่าหลัง Login สมาชิกตรวจสอบโปรโมชั่น ยอดคำนวณ สถานะ
// การรับสิทธิ์ เครดิต และประวัติรายการได้จากบัญชีเดียว พร้อมค้นหาเกมสล็อตเอง
// ตัวเลขที่ใช้ได้มีแค่ของบรีฟเอง: 0.3% / 0.8% / 100% / 24 ชั่วโมง / 3 ขั้นตอน
// ห้ามแต่งชื่อค่ายเกม ชื่อธนาคาร ยอดฝากขั้นต่ำ เลขใบอนุญาต หรือจำนวนสมาชิก
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). UOK365 (6) ให้ 156
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าเข้าสู่ระบบ ${BRAND_NAME} กดปุ่มเดียวเข้าบัญชีสมาชิก เพื่อเลือกค่ายเกมสล็อตเบทต่ำ ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการจากบัญชีเดียวทั้งมือถือและคอมพิวเตอร์`;

const graph = pageGraph(Astro, {
  name: `เข้าสู่ระบบ ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`เข้าสู่ระบบ ${BRAND_NAME} ล็อกอินเข้าบัญชีสมาชิก เล่นสล็อตเบทต่ำค่ายตรงได้ทันที`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`เข้าสู่ระบบ ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#c8912f]/55 bg-gradient-to-b from-[#19100a] to-[#070504] px-6 py-4 text-lg font-black text-[#f5d98a] shadow-[0_0_12px_rgba(200,145,47,0.25)] transition-all duration-300 hover:scale-105 hover:border-[#c8912f] hover:shadow-[0_0_28px_rgba(200,145,47,0.45)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
