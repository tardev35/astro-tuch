---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// The button wears the SILVER half of the two-tone MEPAY77 logo; /register
// carries the gold gradient, so the pair reads as primary + secondary action.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 158.
const pageDescription =
  "หน้าเข้าสู่ระบบ MEPAY77 กดปุ่มเดียวเข้าบัญชีสมาชิก เล่นบาคาร่า สล็อต หวย และบอลได้ในบัญชีเดียว พร้อมตรวจสอบเครดิตคงเหลือ โปรโมชั่นที่กดรับได้ และประวัติฝากถอน";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ MEPAY77 ล็อกอินเข้าบัญชีสมาชิก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="เข้าสู่ระบบ MEPAY77 ล็อกอินเข้าบัญชีสมาชิก เล่นได้ครบทุกหมวดเกม" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ MEPAY77" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ MEPAY77"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#dfe3e8]/55 bg-[#130c01] px-6 py-4 text-lg font-black text-[#dfe3e8] shadow-[0_10px_30px_rgba(223,227,232,0.16)] transition-all duration-300 hover:scale-105 hover:border-[#dfe3e8] hover:bg-[#241503] hover:text-[#fff6e0] hover:shadow-[0_15px_40px_rgba(223,227,232,0.34)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
