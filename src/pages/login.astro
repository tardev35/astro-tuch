---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect. The title and
// description below were rewritten this round for exactly that reason.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// BRAVO168 (รอบน้ำเงินรอยัล-ทอง-กรมท่า 2026-09-30): ปุ่มนี้เป็นตัว SECONDARY ของคู่
// จึงเป็นแบบ OUTLINE — ผิวยก #072247 ในกรอบน้ำเงินรอยัล #1558c4 บนตัวอักษรทอง
// #f4cb69 แล้วยกผิวขึ้นเป็นน้ำเงินเส้น #0e3f8f ตอน hover ส่วน /register สวมไล่เฉด
// ทองเต็มใบ (#ffe39a → #f4cb69 → #c9922e) ลำดับความสำคัญรอบนี้สื่อด้วย
// "ถมทอง vs กรอบน้ำเงิน" — สองปุ่มที่ถมทองเหมือนกันจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม
// กฎคอนทราสต์ brand-spec §2: พื้นทอง = หมึกเข้ม #0a1020 · พื้นเข้ม = ตัวอักษรทอง
// #f4cb69 · ห้ามตัวอักษรขาวบนพื้นทอง (ขาวบน #f4cb69 ตก AA)
// ชุดเขียวนีออนของ CK268 (#8bfc13 #c9ff8f #eaffd6 #12a008 #1a7a08 #d5e6cd
// #e8f0e6 #030703 #0f1b0e #052e16 #071007 rgba(139,252,19,*) rgba(30,193,13,*)
// rgba(3,7,3,*)) ออกครบแล้ว ห้ามนำกลับมา
//
// Announcement หมุนมาเป็น AnnouncementPremium ทั้งเว็บรอบนี้ (รอบก่อนเป็น
// Announcement5) — default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ index
// ก็เรียกแบบ bare
//
// BRAVO168 เป็นเว็บแทงบอล/พนันบอลออนไลน์ ไม่ใช่สล็อตและไม่ใช่หวย — บรีฟพูดถึงการ
// ติดตามคู่แข่งขันจากหลายลีกในบัญชีเดียว บอลเดี่ยว บอลสเต็ป บอลสด ราคาและอัตราต่อรอง
// เวลาปิดรับ รายละเอียดบิล ประวัติบิล โปรโมชั่น โบนัสคืนยอดเสีย 0.3% โบนัสแนะนำเพื่อน
// 0.8% และแอดมิน 24 ชม. เท่านั้น
// คำศัพท์ของสองแบรนด์ก่อน (สล็อต วงล้อ ฟรีสปิน ตัวคูณ ค่ายเกม RTP เกมแตก หวย
// เลขเด็ด ตรวจหวย แนวทาง ยี่กี บาคาร่า) ห้ามหลงเหลือ
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 159
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = "หน้าเข้าสู่ระบบ BRAVO168 กดปุ่มเดียวเข้าบัญชีสมาชิกเพื่อดูลีก คู่แข่งขัน และอัตราต่อรองที่เปิดรับ ตรวจสอบบิล โปรโมชั่น และประวัติรายการ ผ่านเบราว์เซอร์บนมือถือ";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ BRAVO168",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="เข้าสู่ระบบ BRAVO168 ล็อกอินเข้าบัญชีสมาชิก ดูราคาบอลและบิลได้ทันที" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ BRAVO168" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ BRAVO168"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#1558c4] bg-[#072247] px-6 py-4 text-lg font-black text-[#f4cb69] shadow-[0_10px_30px_rgba(2,8,26,0.85)] transition-all duration-300 hover:scale-105 hover:border-[#2f86f0] hover:bg-[#0e3f8f] hover:text-[#ffe39a] hover:shadow-[0_15px_40px_rgba(21,88,196,0.35)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
