---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// SEXYGAME666 (รอบชมพูนีออน-ม่วง-ดำ 2026-09-28): ปุ่มนี้เป็นตัว SECONDARY ของคู่
// และรับฝั่ง "GAME" ของโลโก้ที่เป็นม่วง — ผิวยก #140722 ในกรอบม่วง #8b3df3 บน
// เนื้อความ #f2dcee แล้วยกเป็นผิว #3d1180 กับขอบม่วงอ่อน #c9a4ff ตัวอักษรเน้น
// #fff2fb ตอน hover ส่วน /register สวมไล่เฉดชมพูไปม่วงเต็มใบ ลำดับความสำคัญ
// ถูกสื่อด้วย "สีไหนถมเต็มปุ่ม" ตามโลโก้ที่ SEXY กับ 666 เป็นชมพูและ GAME เป็นม่วง
// — ชมพูคู่ม่วง ไม่ใช่ชมพูสองใบ ซึ่งจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม
// ชุดทอง+เขียวของแบรนด์ก่อนหน้า (#fde90e #fff89a #f5c518 #35d413 #5df53a #10160a
// #0b1408 #101a0b #1f5a16 #e9f0dd #fbffe8 rgba(253,233,14,*) rgba(53,212,19,*)
// rgba(3,6,2,*)) ออกครบแล้ว ห้ามนำกลับมา
//
// Announcement หมุนจาก Announcement2 มาเป็น Announcement5 ทั้งเว็บรอบนี้ —
// default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ index ก็เรียกแบบ bare
//
// SEXYGAME666 เป็นแบรนด์เกมเซ็กซี่บาคาร่า/คาสิโนไลฟ์สด — บรีฟพูดถึงโต๊ะบาคาร่า
// และเกมคาสิโนสดตามรายการที่เปิดให้บริการ เมนูค้นหาง่าย และข่าวสาร/เกมใหม่/
// โปรโมชั่นที่อัปเดตตามช่วงเวลาเท่านั้น คำศัพท์เฉพาะหมวดของแบรนด์ก่อนหน้า (สล็อต
// ค่ายสล็อตย่อย หวย) รวมถึง API/ใบอนุญาต/ชื่อค่าย/ชื่อโต๊ะ/ธนาคาร/ฝากถอนออโต้/
// เครดิตฟรี/อัตราจ่าย ห้ามหลงเหลือในหน้านี้
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 156
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = "หน้าเข้าสู่ระบบ SEXYGAME666 กดปุ่มเดียวเข้าบัญชีสมาชิกเพื่อเลือกโต๊ะบาคาร่าและเกมคาสิโนไลฟ์สดที่เปิดให้บริการ พร้อมดูข่าวสารและโปรโมชั่นที่อัปเดตตามช่วงเวลา";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ SEXYGAME666",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="เข้าสู่ระบบ SEXYGAME666 ล็อกอินเข้าบัญชีสมาชิก เลือกโต๊ะไลฟ์สดได้ทันที" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ SEXYGAME666" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ SEXYGAME666"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#8b3df3] bg-[#140722] px-6 py-4 text-lg font-black text-[#f2dcee] shadow-[0_10px_30px_rgba(4,1,8,0.85)] transition-all duration-300 hover:scale-105 hover:border-[#c9a4ff] hover:bg-[#3d1180] hover:text-[#fff2fb] hover:shadow-[0_15px_40px_rgba(139,61,243,0.30)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
