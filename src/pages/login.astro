---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — this page is indexed and must not
// describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// The button is the SECONDARY of the pair on the หวยพยัคฆ์ palette: navy card
// surface (#08152f) inside a primary-gold outline (#fadb6c) over body ink
// (#dbe4f7), lifting to bright gold (#fdf5a4) on a lighter navy (#0f2149) on
// hover, while /register wears the full gold-gradient fill. The tier is carried
// by the brightness of the fill, not by a second hue.
//
// Announcement รอบนี้หมุนมาใช้ AnnouncementHuay ทั้งเว็บ — default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ไม่ต้องส่ง prop
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 157
const pageDescription = "หน้าเข้าสู่ระบบ หวยพยัคฆ์ กดปุ่มเดียวเข้าบัญชีสมาชิกเพื่อดูรอบหวยที่เปิดรับ ตรวจสอบอัตราจ่ายเลข 2 ตัวและ 3 ตัว เลือกเลขที่ต้องการ และติดตามรายการบิลของตัวเอง";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ หวยพยัคฆ์",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="เข้าสู่ระบบ หวยพยัคฆ์ ล็อกอินเข้าบัญชีสมาชิก เลือกเลขและดูรอบหวย" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ หวยพยัคฆ์" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ หวยพยัคฆ์"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fadb6c] bg-[#08152f] px-6 py-4 text-lg font-black text-[#dbe4f7] shadow-[0_10px_30px_rgba(3,11,28,0.7)] transition-all duration-300 hover:scale-105 hover:border-[#fdf5a4] hover:bg-[#0f2149] hover:text-[#fdf5a4] hover:shadow-[0_15px_40px_rgba(250,219,108,0.36)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
