---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement4.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change (CtaRedirect.astro
// itself belongs to the orchestrator — ห้ามแก้ไฟล์นั้นจากหน้านี้)
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page, which means verify-build holds its
// description to the same 150–160 character window as every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES — คอปปี้ของหน้านี้จึงพูด
// ได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 4: ผู้ใช้งานสามารถศึกษากติกาเกม ตรวจสอบเงื่อนไข
// โบนัส และรายละเอียดฝากถอนก่อนใช้งานได้ · บรรทัด 6: ควรอ่านข้อกำหนดล่าสุดให้
// ครบถ้วน · บรรทัด 22: ควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ
// เพื่อหลีกเลี่ยงบัญชีแอบอ้าง)
// ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า หน้านี้มีโควตาเป็นปุ่มเดียว
//
// ⚠️ แกนของบรีฟรอบนี้คือ **เว็บสล็อต** (เกมสล็อตแท้ · เว็บตรงถูกลิขสิทธิ์ ·
// ฝากรับโบนัสได้ทั้งวัน ไม่ต้องทำเทิร์น) คำนิยามตัวเองของแบรนด์ก่อนๆ ห้ามเหลือ
// (brand-spec §5) ศัพท์หมวดหวยที่บรีฟไม่มีทุกคำก็เป็นของค้างที่ห้ามหลุดกลับมา
// รายการคำเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไป
// เจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// คำที่ใช้ได้รอบนี้: เกมสล็อตแท้ · เว็บตรงถูกลิขสิทธิ์ · ฝากรับโบนัสได้ทั้งวัน
// ไม่ต้องทำเทิร์น · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% ไม่จำกัด · ฝากถอนทุกธนาคาร
// และทรูมันนี่ · แอดมิน 24ชม. · กติกาเกม · เงื่อนไขโบนัส · เครดิต · ยอดเสีย ·
// ชื่อบัญชีปลายทาง · บัญชีแอบอ้าง · ธุรกรรม · หมายเลขรายการ · หลักฐาน ·
// สมัครสมาชิก · เข้าสู่ระบบ · เว็บไซต์ทางการ · ประกาศล่าสุด · รหัสผ่าน · รหัส OTP
// ⚠️ **สองหน้าของหมวดลอตเตอรีถูกปิดรอบนี้** (อยู่ใน src/pages-disabled/ เพราะ
// รอบนี้เป็นเว็บสล็อต) และหน้านี้มีโควตาเป็นปุ่มเดียว จึงไม่ลิงก์ไปที่อื่นเพิ่ม
// อยู่แล้ว
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกม ชื่อธนาคาร ชื่อวอลเล็ต หน่วยงานกำกับ
// หรือใบอนุญาต แม้แต่รายเดียว** (พูดถึง "ธนาคารและทรูมันนี่" แบบรวมๆ เท่านั้น)
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 3 ขั้นตอน · 24ชม. **ไม่มีค่า RTP
// ไม่มีจำนวนเกม ไม่มีจำนวนค่าย ไม่มียอดฝากขั้นต่ำเป็นตัวเลข และไม่มีอัตราจ่ายเป็น
// ตัวเลข** ห้ามแต่งใบอนุญาต ตัวเลขการเงิน หรือจำนวนสมาชิก · หัวข้อช่องทางติดต่อ
// แอดมินของบรีฟเป็นของ index.astro ไม่ใช่ของหน้านี้
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตต์รอบนี้อยู่ใน brand-spec §2
// ⚠️⚠️ **รอบนี้กลับทิศจากรอบก่อนทั้งเว็บ: จากธีมมืด เป็นธีมสว่าง**
// bg.json = {"mode":"color","color":"#ffe5ff"} = **ชมพูพาสเทลสว่างมาก**
// (รอบก่อนเป็นดำอมแดง — ค่ามาจากไฟล์ ห้ามเดาว่าเท่าเดิม และห้าม "แก้" การ์ดให้มืด)
// การ์ด ContentBox จึงเป็นผิว #ffffff บนหมึกเข้ม #3b0b26 (= BRAND_TEXT)
// ปุ่มนี้เป็นคู่ **รอง (secondary)** ของพาเลต: ไล่เฉดชมพูสด #fb8cc0 -> #fa539c
// บนหมึก **พลัมเข้ม #3b0b26** (7.4 / 5.3:1 — ผ่านทั้งสอง stop)
// ส่วน /register เป็น **หลัก (primary)** ไล่เฉดชมพูเข้ม #c2185b -> #8e0f41
// บนหมึกขาว จึงไม่ซ้ำกัน
// 🚨🚨 **ขาวบนชมพูสด #fa539c ได้แค่ 3.2:1 และหมึกเข้มบนพื้นชมพูเข้ม #8e0f41 ก็
// แทบมองไม่เห็น** พื้นถมสว่างต้องคู่กับหมึกเข้มเสมอ และพื้นชมพูที่ถือหมึกขาวได้
// ต้องเป็น #c2185b ลงไป ห้ามกลับด้านทั้งสองกรณี
// 🚨🚨 **#fa539c / #fb8cc0 / #ef8dbd / #f7bcd9 / #fdc6c3 ห้ามถือตัวอักษรเอง**
// เป็นพื้นถม/ขอบ/ออราเท่านั้น · ที่ถือตัวอักษรได้บนผิวสว่างชุดนี้คือ #3b0b26
// (16.8:1) · #7a4463 (7.4:1) · #c2185b (5.9:1) · #8e0f41 (9.2:1)
// ⚠️⚠️ **วัสดุของรอบนี้คือชมพูแคนดี้บนพื้นสว่าง** อ่านจากอาร์ตเวิร์กตรงๆ:
// โลโก้เป็นลูกหมูการ์ตูนชมพูมีปีกนางฟ้าสีขาว คู่กับตัวอักษรบับเบิลสามมิติชมพู-ขาวมุก
// มีหัวใจชมพูลอยประดับ บนพื้นโปร่ง
// ⚠️⚠️ **มีทรัพย์168 ก็เป็นแบรนด์หมูการ์ตูนชมพูเหมือนกัน แต่เป็นหมูสวมหน้ากากโจร
// บนแมเจนต้าเข้มพื้นมืด** — รอบนี้ห้ามมีหน้ากาก โจร หรือถุงเงิน และห้ามใช้ค่าสี
// ชุดนั้น (อยู่ใน brand-spec §2)
// ⚠️⚠️ **คาร์ดิแกนชมพู เสื้อกล้ามขาว พื้นสตูดิโอขาว และสีผิวนักแสดงเป็นวัตถุในภาพ
// ไม่ใช่สี UI** — พื้นเพจมาจาก bg.json เท่านั้น
// ⚠️ ปุ่มของ Navfoot อยู่บนแถบโครมคนละโซนกับปุ่มบนการ์ดนี้
// **ห้ามลอกคลาสของ Navfoot มาวางบนการ์ด**
// ออราในไฟล์นี้ใช้ rgba(250,83,156,α) · rgba(251,140,192,α) · rgba(194,24,91,α) ·
// rgba(59,11,38,α) เท่านั้น
//
// ⚠️⚠️ กับดักรอบนี้คือ **ชมพู** — รีโปนี้มีแบรนด์ชมพูมาแล้วหลายเจ้า "มีชมพูอยู่แล้ว"
// จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้ ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน
// brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ
// false positive · **ชมพูของรอบนี้คือ #fa539c / #fb8cc0 / #c2185b / #8e0f41 /
// #ef8dbd / #f7bcd9 เท่านั้น**
// รอบนี้ **ไม่มีทอง ไม่มีเหลือง ไม่มีน้ำเงิน/ฟ้า ไม่มีส้ม ไม่มีเขียว (ยกเว้น
// LINE green ที่หน้าอื่น) ไม่มีแดงเจล ไม่มีม่วง ไม่มีน้ำตาล ไม่มีครีม และไม่มี
// โครเมียมเงินเย็น** แดงเจลกับมุกอุ่นคือวัสดุคู่ของแบรนด์ขาออก (ชื่ออยู่ใน
// brand-spec §1) การปล่อยไว้ = ทั้งผิดพาเลตและหลงเหลือข้ามแบรนด์พร้อมกัน
//
// Announcement หมุนมาเป็น Announcement4 ทั้งเว็บรอบนี้ (brand-spec §3 — รอบก่อนใช้
// Announcement5 จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็น
// คอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare — ห้ามส่ง prop message
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) สตริงนี้ยาว 152
// ด้วยชื่อแบรนด์ 9 อักขระของรอบนี้ — ถ้ารอบหน้าชื่อยาวกว่านี้มากต้องตัดข้อความ
// ไม่ใช่ปล่อยผ่าน
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าเข้าสู่ระบบ ${BRAND_NAME} กดปุ่มเดียวเพื่อเข้าบัญชีสมาชิก สำหรับดูเงื่อนไขโบนัส รายการคืนยอดเสีย และรายการฝากถอน ควรตรวจสอบประกาศล่าสุดจากเว็บไซต์ทางการ`;

const graph = pageGraph(Astro, {
  name: `เข้าสู่ระบบ ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`เข้าสู่ระบบ ${BRAND_NAME} กดปุ่มเดียวเข้าบัญชีสมาชิกเว็บหลัก`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`เข้าสู่ระบบ ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ef8dbd] bg-gradient-to-b from-[#fb8cc0] to-[#fa539c] px-6 py-4 text-2xl font-bold tracking-wide text-[#3b0b26] shadow-[0_10px_30px_rgba(194,24,91,0.22)] transition-all duration-300 hover:scale-105 hover:border-[#c2185b] hover:shadow-[0_15px_40px_rgba(250,83,156,0.4)]">
        <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-white/25 to-transparent"></span>
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
