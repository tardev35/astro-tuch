---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change.
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page, which means verify-build holds its
// description to the same 150–160 character window as every other page.
//
// ⚠️ แบรนด์รอบนี้เป็น **เว็บเล่นสล็อตออนไลน์ล้วน** (สล็อตปันโปรในตำนาน) ไม่ใช่เว็บ
// คาสิโนรวมแบบแบรนด์ก่อน ไม่ใช่เว็บกีฬา และไม่ใช่เว็บลอตเตอรี คอปปี้ของหน้านี้จึง
// พูดถึง "ทางเข้าเล่นหลัก" และ "หมวดเกมสล็อต" — รายการคำที่ห้ามหลุดกลับมาอยู่ใน
// brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำต้องห้ามเจอ false positive
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% / 0.8% / 3 ขั้นตอน / 24 ชั่วโมง / ปี 2026
// — ห้ามแต่งใบอนุญาต หน่วยงานกำกับ ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP หรือยอดขั้นต่ำ
//
// แบรนด์รอบนี้ (รอบชมพูฮอตพิงก์-ทองบนพลัมเข้ม 2026-10-12, brand-spec §2):
// ชมพูฮอตพิงก์ #f41571 (ฮิวนำ) · ชมพูสว่าง #ff5ca8 (ระดับสอง) ·
// ทองสว่าง #fce343 (ฮิวที่สอง) · ทองอำพัน #ffc554 (ปลายเข้มสุดของไล่เฉดทอง) ·
// ทองไฮไลต์ #ffd94a (สงวนไว้ให้ <strong> ในย่อหน้า) · เนื้อความ #fde7f2
// (= BRAND_TEXT) · เส้น/ออรา #8a0a45 และ #4a0426 · หมึกบนพื้นถม #2a0012
// ชั้นผิว: ยก #4a1038 (= การ์ด ContentBox) / กลาง #3a0a2a / พื้นเพจ #2e0022 /
// จม #1c0014 — รอบนี้ bg.json เป็นพลัมเข้ม #2e0022 ไม่ใช่ดำสนิท จึง **มี** ชั้นที่
// ลึกกว่าพื้นเพจได้ (ค่าของรอบก่อนอยู่ใน §2 ไม่พิมพ์ซ้ำที่นี่)
// ปุ่มนี้เป็นคู่ SECONDARY: จมลงจากการ์ดด้วยชั้น #3a0a2a → #1c0014 ขอบชมพู
// #f41571/55 บนเนื้อความ #fde7f2 — hover ยกขอบเป็นชมพูเต็ม
// ส่วน /register เป็น PRIMARY ถมพื้นทอง จึงไม่ซ้ำกัน
// ⚠️ ห้ามใช้ผิวยก #4a1038 เป็นพื้นปุ่ม มันเป็นสีเดียวกับการ์ดที่ปุ่มวางอยู่
// ⚠️ #8a0a45 #4a0426 ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่เส้นขอบ ออรา และเงา
// — ออราในไฟล์นี้ใช้ rgba(244,21,113,α) เท่านั้น นอกจากเงาดำล้วน
// ⚠️ ทั้งชมพูและทองเคยมาแล้วทั้งคู่ในรอบก่อนๆ "เจอชมพู" หรือ "เจอทอง" ไม่ได้แปลว่า
// ถูกค่า ให้เทียบเป็นตัวๆ กับตารางแบนใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้
// grep หาสีของแบรนด์เก่าเจอ false positive — ชุดทองอำพันของแบรนด์ก่อนออกครบทุกจุด
// ในไฟล์นี้แล้ว และรอบนี้ **ไม่มีเขียว ไม่มีน้ำเงิน ไม่มีเทา ไม่มีส้มอิฐ**
//
// Announcement หมุนมาเป็น Announcement3 ทั้งเว็บรอบนี้ (ตัวที่แบรนด์ก่อนใช้ถูกหมุน
// ออกตาม brand-spec §3) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้
// ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare — ห้ามส่ง prop message จากหน้านี้
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) หน้านี้ยาว 157
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าเข้าสู่ระบบ ${BRAND_NAME} เว็บเล่นสล็อตออนไลน์ กดปุ่มเดียวไปยังทางเข้าเล่นหลักของเว็บ เพื่อเลือกหมวดเกมสล็อตที่สนใจ ตรวจสอบเครดิต และดูข้อมูลบัญชีสมาชิกของตน`;

const graph = pageGraph(Astro, {
  name: `เข้าสู่ระบบ ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`เข้าสู่ระบบ ${BRAND_NAME} เว็บเล่นสล็อตออนไลน์ เข้าจากทางเข้าหลัก`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`เข้าสู่ระบบ ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f41571]/55 bg-gradient-to-b from-[#3a0a2a] to-[#1c0014] px-6 py-4 text-2xl font-bold tracking-wide text-[#fde7f2] shadow-[0_10px_30px_rgba(0,0,0,0.55)] transition-all duration-300 hover:scale-105 hover:border-[#f41571] hover:shadow-[0_15px_40px_rgba(244,21,113,0.4)]">
        <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#f41571]/25 to-transparent"></div>
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
