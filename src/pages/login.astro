---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect. The title and
// description below are written for exactly that reason.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
// หน้านี้ indexed แล้ว จึงไม่เข้าข้อยกเว้นของ noindex stub อีกต่อไป — ห้ามใส่
// define:vars หรือ <script> แบบไม่มีแอตทริบิวต์ลงในไฟล์นี้
//
// 789BETTING (รอบทองเมทัลลิกบนดำสนิท 2026-10-08, brand-spec §2): รอบนี้เป็น
// **ทองฮิวเดียวบนดำ ไม่มีสีที่สองเลย** — โลโก้เป็นเลข 789 ทองสามมิติเหนือคำว่า
// BETTING ดำบนแถบขาว งานศิลป์เป็นโถงคาสิโนดำ-ทอง และ bg.json เป็นดำตัน #000000
// รอบก่อน (GUCCI168) เป็นชุดตรุษจีนสามสีซึ่งมีเขียวมรกตเป็นฮิวที่สองไว้แยกลำดับ
// ปุ่มได้ รอบนี้ไม่มี ลำดับจึงสื่อด้วย **ถม vs โปร่ง** แทน:
// ปุ่มนี้เป็นตัว SECONDARY ของคู่ จึงเป็น **ผิวเข้มขอบทอง** #17130a → #060402
// ขอบทองแบรนด์ #fad354/55 บนหมึกทองแชมเปญ #ffe79a แล้ว hover ยกขอบเป็นทองเต็ม
// ส่วน /register ถม **ทองไล่เฉด** เต็มใบ (#ffe79a → #fad354 → #ddab33) ขอบทองลึก
// #8a6410 บนหมึกเข้ม #0a0802 — เข้าชุดกับคู่ปุ่มของ /ทางเข้า ที่ให้
// เข้าสู่ระบบ = ผิวเข้ม, สมัครสมาชิก = ทองถม
// กฎคอนทราสต์ของสเปก: #ffe79a บนผิว #17130a ผ่าน AA สบาย ส่วนพื้น **ทอง/แชมเปญ
// ถมเต็มใบต้องใช้หมึกเข้ม #0a0802 เสมอ ห้ามครีมหรือขาว** จึงไม่เอาทองมาถมเป็นพื้น
// ของปุ่มนี้ ออร่าใช้บรอนซ์ rgba(201,136,31,α) กับทอง rgba(250,211,84,α) เท่านั้น
// ชุดแดง-เขียวมรกต-ทองของ GUCCI168 ถูกแทนครบแล้ว ทั้งคลาส Tailwind, raw hex และ
// rgba() glow (ค่าเดิมอยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสี
// แบรนด์เก่าเจอ false positive)
// CtaRedirect รีธีมโดย orchestrator ไปแล้ว ห้ามแก้จากหน้านี้
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ (รอบก่อนเป็น Announcement3)
// default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์ปัจจุบันแล้ว และทุกหน้าเรียกแบบ
// bare จึงห้ามส่ง prop message จากหน้านี้
//
// แบรนด์นี้เป็น **คาสิโนฐานเข้าหลัก** ที่รวมบาคาร่า รูเล็ต บอล หวย สล็อต และเกม
// คาสิโนตามรายการที่เปิดให้บริการไว้ในบัญชีเดียว — หวยเป็นหนึ่งหมวด ไม่ใช่เว็บหวย
// และไม่ใช่เว็บสล็อตเบทต่ำแบบรอบก่อนๆ คำของแบรนด์ก่อนทั้งชุดห้ามหลงเหลือ
// (รายการเต็มอยู่ใน brand-spec §4 ไม่พิมพ์ซ้ำที่นี่)
// บรีฟบรรทัด 4 และ 9 ระบุว่าหลัง Login สมาชิกเลือกเกม ตรวจสอบเครดิต โปรโมชั่น
// ยอดที่เข้าเกณฑ์ และประวัติการเดิมพันผ่านบัญชีเดียวได้
// ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 0.3% / 0.8% / 100% / 24 ชั่วโมง
// ห้ามแต่งชื่อค่ายเกม ชื่อธนาคาร เลขใบอนุญาต หน่วยงานกำกับ ค่า RTP ยอดฝากขั้นต่ำ
// จำนวนสมาชิก หรือปีก่อตั้ง — หน้านี้มีโควตาเป็นปุ่มเดียวเท่านั้น
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 155
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าเข้าสู่ระบบ ${BRAND_NAME} กดปุ่มเดียวเข้าบัญชีสมาชิก เพื่อเลือกบาคาร่า รูเล็ต บอล หวย สล็อต พร้อมตรวจสอบเครดิต โปรโมชั่น และประวัติการเดิมพันจากบัญชีเดียว`;

const graph = pageGraph(Astro, {
  name: `เข้าสู่ระบบ ${BRAND_NAME} คาสิโนฐานเข้าหลัก`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`เข้าสู่ระบบ ${BRAND_NAME} ล็อกอินเข้าบัญชีสมาชิก เลือกเกมเดิมพันได้ทันที`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`เข้าสู่ระบบ ${BRAND_NAME} คาสิโนฐานเข้าหลัก`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fad354]/55 bg-gradient-to-b from-[#17130a] to-[#060402] px-6 py-4 text-lg font-black text-[#ffe79a] shadow-[0_0_12px_rgba(201,136,31,0.30)] transition-all duration-300 hover:scale-105 hover:border-[#fad354] hover:shadow-[0_0_28px_rgba(250,211,84,0.45)]">
        <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#c9881f]/25 to-transparent"></div>
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
