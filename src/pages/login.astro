---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change (CtaRedirect.astro
// itself belongs to the orchestrator — ห้ามแก้ไฟล์นั้นจากหน้านี้)
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page, which means verify-build holds its
// description to the same 150–160 character window as every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES — คอปปี้ของหน้านี้จึงพูด
// ได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 16: เข้าสู่เว็บไซต์ทางการและค้นหาข้อมูลเกี่ยวกับ
// เนื้อหาการสอน รูปแบบบทเรียน · บรรทัด 20: เลือกศึกษาหัวข้อเกี่ยวกับสล็อต บาคาร่า
// ยิงปลา ไฮโล บอล หรือหวย · บรรทัด 8: ก่อนเข้าร่วมควรอ่านรายละเอียดจากประกาศล่าสุด)
// ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า หน้านี้มีโควตาเป็นปุ่มเดียว
//
// ⚠️ แบรนด์รอบนี้เป็น **เว็บสอนเล่นเกมเดิมพันออนไลน์หลายประเภท** (สล็อต บาคาร่า
// ยิงปลา ไฮโล บอล หวย) **ไม่ใช่เว็บหวย และไม่ใช่เว็บบอล** รอบก่อนเป็นเว็บกีฬา/
// ฟุตบอลล้วน ศัพท์หมวดกีฬาของรอบก่อนทุกคำจึงเป็นของค้างที่ห้ามหลุดกลับมา
// (คำว่า บอล/ฟุตบอล เฉยๆ ใช้ได้ เพราะบรีฟรอบนี้ระบุเอง แต่คำแวดล้อมของเว็บบอล
// ไม่ได้) รายการคำเต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของ
// รอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// คำที่ใช้ได้รอบนี้: เว็บสอนเล่นเกมออนไลน์ · เกมเดิมพันออนไลน์ · กติกา ·
// ความน่าจะเป็น · สัญลักษณ์ · ตารางจ่ายรางวัล · ประเภทการเดิมพัน · อัตราจ่าย ·
// สูตร · เทคนิค · บทเรียน · หลักสูตร · หัวข้อเรียน · ผู้สอน · เศรษฐีพนันมือ1
// พร้อมโปรโมชั่นสองรายการคือ **คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%**
// แบรนด์ก่อนหน้าขายตัวเองด้วยวลีที่บรีฟรอบนี้ไม่มีเลยสักคำ จึงต้องเขียนใหม่จากบรีฟ
// ไม่ใช่ find-and-replace ทับของเดิม
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกมแม้แต่ชื่อเดียว** จึงห้ามเขียนลงหน้า
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 24ชม. · 3 ขั้นตอน ห้ามแต่ง
// ใบอนุญาต หน่วยงานกำกับ ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก
// หรือปีใดๆ (บรีฟรอบนี้ไม่ได้เอ่ยปีไว้เลย) · ห้ามใช้คำว่า เว็บตรง / ไม่ผ่านเอเย่นต์ /
// คาสิโนสด — หัวข้อขั้นตอนสมัครกับช่องทางติดต่อแอดมินของบรีฟ (บรรทัด 13-22)
// เป็นของ index.astro ไม่ใช่ของหน้านี้
//
// พาเลตต์รอบนี้อยู่ใน .claude/brand-spec-duangsetthi168.md §2 — **ทองน้ำผึ้งนำ +
// แดงชาดจีนรอง บนพื้นดำสนิท** (bg.json = {"mode":"color","color":"#000000"})
// ทองน้ำผึ้ง #f0c878 (8.47:1 บนผิวการ์ด · 15.9:1 บนผิวจม) · งาช้าง #fff8d8
// (= BRAND_TEXT, 12.59:1 บนผิวการ์ด) · หมึกบนพื้นถมทอง/งาช้าง #2a0608
// ชั้นผิว: ยก #4e2120 (= การ์ด ContentBox) / กลาง #300605 / จม #150303
// ปุ่มนี้เป็นคู่ SECONDARY: จมลงจากการ์ดด้วยชั้น #4e2120 → #150303 ขอบ **แดงชาด**
// #d9212a/80 บนตัวอักษร **ทองน้ำผึ้ง** #f0c878 — hover ยกขอบเป็นทองน้ำผึ้ง
// (ขั้วเดียวกับปุ่ม เข้าสู่ระบบ ของ Navfoot ที่ขึ้นทุกหน้าบนมือถือ จึงอ่านเป็นปุ่ม
// เดียวกันทั้งเว็บ) ส่วน /register เป็น PRIMARY ถมพื้น **งาช้าง→ทอง** บนหมึกเข้ม
// จึงไม่ซ้ำกัน
// ⚠️⚠️ **แดงทั้งสองเฉดห้ามถือตัวอักษรทุกขนาด** — #d9212a ได้ 2.69:1 บนผิวการ์ด
// และ 4.20:1 บนพื้นเพจ ส่วน #8e1a16 ต่ำกว่านั้นทุกพื้น ทั้งคู่จึงเป็น **ขอบ / ออรา /
// พื้นถม** เท่านั้น ถ้าต้องการตัวอักษรที่อ่านว่าแดง ให้ถม #d9212a แล้ววาง #fff8d8
// ทับ (4.68:1) · ออราในไฟล์นี้ใช้ rgba(217,33,42,α) เท่านั้น นอกจากเงาดำล้วน
// ⚠️ กับดักรอบนี้คือ **ทองเคยนำมาแล้วเกือบทุกแบรนด์ และแดงเคยนำมาแล้วหลายแบรนด์**
// "มีทองอยู่แล้ว" จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้ ให้เทียบเป็น "ค่า" ทีละหลักกับ
// ตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ
// false positive
// รอบนี้ **ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง ไม่มีเขียว ไม่มีเงิน/โครเมียม
// ไม่มีโรสโกลด์ ไม่มีชมพู/ฟูเชีย ไม่มีส้มสด และไม่มีบรอนซ์** (บรอนซ์เป็นสีที่สาม
// ของรอบก่อน) — แดงรอบนี้เป็นแดงชาดจีน ไม่ใช่ส้มและไม่ใช่โรสโกลด์
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ (brand-spec §3 — รอบก่อนใช้
// Announcement3 จึงหมุนออก) orchestrator ตั้ง default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare — ห้ามส่ง prop message
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) หน้านี้ยาว 159
// ด้วยชื่อแบรนด์ 12 ตัวอักษรของรอบนี้
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าเข้าสู่ระบบ ${BRAND_NAME} กดปุ่มเดียวเข้าสู่บัญชีสมาชิก เพื่อศึกษาหัวข้อบทเรียนของแต่ละเกม ตรวจสอบเงื่อนไขการใช้บริการ และรายละเอียดโปรโมชั่นจากประกาศล่าสุด`;

const graph = pageGraph(Astro, {
  name: `เข้าสู่ระบบ ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`เข้าสู่ระบบ ${BRAND_NAME} เข้าบัญชีสมาชิกเพื่อศึกษาบทเรียนและโปรโมชั่น`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`เข้าสู่ระบบ ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#d9212a]/80 bg-gradient-to-b from-[#4e2120] to-[#150303] px-6 py-4 text-2xl font-bold tracking-wide text-[#f0c878] shadow-[0_10px_30px_rgba(0,0,0,0.55)] transition-all duration-300 hover:scale-105 hover:border-[#f0c878] hover:shadow-[0_15px_40px_rgba(217,33,42,0.45)]">
        <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#d9212a]/25 to-transparent"></div>
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
