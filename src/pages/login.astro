---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// LOTTO24 (รอบแดง-ทอง-ดำ 2026-09-28): ปุ่มนี้เป็นตัว SECONDARY ของคู่ จึงรับฝั่ง
// "ทอง" ของงานศิลป์ — ผิวยกแดงเกือบดำ #2a0405 ในกรอบทอง #fbbf24 บนตัวอักษรทองอ่อน
// #fde68a แล้วยกเป็นผิวแดงเข้ม #7f1d1d ตอน hover ส่วน /register สวมไล่เฉดแดงเต็มใบ
// ลำดับความสำคัญถูกสื่อด้วย "สีไหนถมเต็มปุ่ม" — แดงคู่ทอง ไม่ใช่แดงสองใบ ซึ่งจะ
// อ่านเป็นปุ่มซ้ำกันสองปุ่ม
// ชุดชมพู+ม่วงของแบรนด์ก่อนหน้า (#fa42b5 #ffb3e2 #ec3fae #7d1550 #8b3df3 #c9a4ff
// #4a17a0 #3d1180 #140722 #0f0518 #070109 #12041c #f2dcee #fff2fb
// rgba(250,66,181,*) rgba(139,61,243,*) rgba(4,1,8,*)) ออกครบแล้ว ห้ามนำกลับมา
//
// Announcement หมุนจาก Announcement5 มาเป็น AnnouncementHuay ทั้งเว็บรอบนี้ —
// default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ index ก็เรียกแบบ bare
//
// LOTTO24 เป็นเว็บแทงหวยออนไลน์ — บรีฟพูดถึงรอบหวย เลข 2 ตัว/3 ตัว อัตราจ่าย
// (3 ตัวสูงสุด 1,000 · 2 ตัว 100) บิล/โพย ยอดเข้าบัญชีบริษัทโดยตรงไม่ผ่านม้า
// โบนัสแนะนำเพื่อน 0.8% คืนยอดเสีย 0.3% และไลน์ 24 ชม. เท่านั้น คำศัพท์ของสอง
// แบรนด์ก่อนหน้า (สล็อต ค่ายเกม RTP บาคาร่า ไลฟ์สด เกมยิงปลา) ห้ามหลงเหลือ
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 157
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = "หน้าเข้าสู่ระบบ LOTTO24 กดปุ่มเดียวเข้าบัญชีสมาชิกเพื่อเลือกรอบหวยและแทงเลข 2 ตัว 3 ตัว พร้อมตรวจอัตราจ่ายและรายละเอียดบิลทุกรายการก่อนกดยืนยันส่งโพยทุกครั้ง";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ LOTTO24",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="เข้าสู่ระบบ LOTTO24 ล็อกอินเข้าบัญชีสมาชิก เลือกรอบหวยได้ทันที" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ LOTTO24" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ LOTTO24"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fbbf24] bg-[#2a0405] px-6 py-4 text-lg font-black text-[#fde68a] shadow-[0_10px_30px_rgba(0,0,0,0.85)] transition-all duration-300 hover:scale-105 hover:border-[#fde68a] hover:bg-[#7f1d1d] hover:text-[#fff7e0] hover:shadow-[0_15px_40px_rgba(251,191,36,0.30)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
