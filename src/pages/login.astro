---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect. The title and
// description below are written for exactly that reason.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// UP555 (รอบทอง + เงินโครเมียม บนดำอมน้ำตาล 2026-10-03, brand-spec §2 — มาจาก
// logo.webp ที่ตัว U กับ UP เป็นเงินโครเมียม #d5d4d3 ส่วนลูกศร วงรี และเลข 555
// เป็นทองเมทัลลิก #ebbb54):
// ปุ่มนี้เป็นตัว SECONDARY ของคู่ จึงเป็นแบบ outline — พื้นชิป #241705 ในกรอบ
// เงินโครเมียม #d5d4d3/60 บนตัวอักษรเงินสว่าง #f3f3f2 แล้วยกกรอบเป็นเงินเต็ม
// #f3f3f2 ตอน hover ส่วน /register สวมไล่เฉดทองเต็มใบ (#fce675 → #ebbb54 → #ab6d24)
// บนตัวอักษรดำอมน้ำตาล #160d02
// ลำดับความสำคัญรอบนี้จึงสื่อด้วย "ทองถม vs เงินกรอบ" ไม่ใช่ถมทองสองใบซึ่งจะอ่าน
// เป็นปุ่มซ้ำกันสองปุ่ม — และคู่ทอง/เงินนี้คือสองโทนที่อยู่บนโลโก้จริง
// กฎคอนทราสต์: พื้นทองสว่าง = หมึก **ดำอมน้ำตาล #160d02** เสมอ (หมึกขาวบน #fce675
// ตก) · พื้นเข้ม #241705/#0c0502 = ตัวอักษรเงินสว่าง #f3f3f2 หรือเนื้อความ #f8eed9
// ชุดเขียว-แดงของ DM899 (#01a326 #4ade6b #12c23a #01841b #fb252b #ffe9a8 #f2b422
// #030a05 #0a1a0e #102a16 #061008 #06140a #e4f2e4 rgba(1,163,38,*) rgba(3,10,5,*)
// rgba(242,180,34,*)) ออกครบแล้ว ห้ามนำกลับมา
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ (รอบก่อน DM899 เป็น
// Announcement3) — default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ
// index ก็เรียกแบบ bare จึงห้ามส่ง prop message
//
// UP555 เป็นคาสิโนที่รวมสล็อต บาคาร่า บอล และหวยไว้ในบัญชีเดียว — ไม่ใช่เว็บหวย
// และไม่ใช่ "เว็บตรงต่างประเทศ" บรีฟระบุว่าหลัง Login ใช้บัญชีเดียวเลือกหมวดเกม
// พร้อมตรวจสอบเครดิต โปรโมชั่น และประวัติรายการได้จากระบบเดียว
// ตัวเลขที่ใช้ได้มีแค่ 0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง
// ห้ามแต่งตัวเลขอื่นขึ้นมาเอง และห้ามเอ่ยชื่อค่ายเกม ชื่อธนาคาร ค่า RTP หรือเลขใบอนุญาต
// คำศัพท์หวยของแบรนด์ก่อนหน้า (แทงหวย ส่งโพย โพย เลือกเลข 2 ตัว 3 ตัว อัตราจ่าย
// งวด รัฐบาลไทย ฮานอย ลาวพัฒนา หวยหุ้น สถิติหวย ผลหวย แนวทางหวย) ห้ามหลงเหลือ
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 159
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าเข้าสู่ระบบ ${BRAND_NAME} คาสิโนอัปเดตล่าสุด กดปุ่มเดียวเข้าบัญชีสมาชิก เลือกหมวดเกมสล็อต บาคาร่า บอล หวย พร้อมตรวจสอบเครดิต โปรโมชั่น และประวัติรายการจากระบบเดียว`;

const graph = pageGraph(Astro, {
  name: `เข้าสู่ระบบ ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`เข้าสู่ระบบ ${BRAND_NAME} ล็อกอินเข้าบัญชีสมาชิก เลือกหมวดเกมได้ทันที`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`เข้าสู่ระบบ ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#d5d4d3]/60 bg-[#241705] px-6 py-4 text-lg font-black text-[#f3f3f2] shadow-[0_10px_30px_rgba(12,5,2,0.75)] transition-all duration-300 hover:scale-105 hover:border-[#f3f3f2] hover:bg-[#0c0502] hover:shadow-[0_15px_40px_rgba(213,212,211,0.3)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
