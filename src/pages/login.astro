---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect. The title and
// description below are written for exactly that reason.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// หวย365 (รอบแดงสด-ทอง 2026-10-02, brand-spec §2):
// ปุ่มนี้เป็นตัว SECONDARY ของคู่ จึงเป็นแบบ OUTLINE — ผิวการ์ด #240406 ในกรอบ
// แดงลึก #9c0201 บนตัวอักษรทอง #ffc93c แล้วยกผิวขึ้นเป็นแดงลึก #9c0201 ตอน hover
// ส่วน /register สวมไล่เฉดทองเต็มใบ (#ffeab0 → #ffc93c → #c08a07)
// ลำดับความสำคัญรอบนี้สื่อด้วย "ถมทอง vs กรอบแดง" — สองปุ่มที่ถมทองเหมือนกัน
// จะอ่านเป็นปุ่มซ้ำกันสองปุ่ม
// กฎคอนทราสต์ brand-spec §2: พื้นทอง = หมึกเข้ม #1a0303 (ไล่เฉดห้ามจบเข้มกว่า
// #c08a07 = 6.4:1) · พื้นเข้ม = ตัวอักษรทอง #ffc93c · ห้ามตัวอักษรขาวบนพื้นทอง ·
// ห้ามหมึกเข้มบนพื้นแดง พื้นแดงรับตัวอักษรขาวเท่านั้น
// ชุดของ หวยเฮง789 (#dc2224 #f4bc5d #ffefc2 #fbe3d4 #1c0606 #2b0909 #ab0204
// #e43434 #d99a10 #a8690c #5c0a0a rgba(244,188,93,*) rgba(220,34,36,*)
// rgba(11,2,2,*)) ออกครบแล้ว ห้ามนำกลับมา
//
// Announcement หมุนมาเป็น AnnouncementCyber ทั้งเว็บรอบนี้ (รอบก่อนเป็น
// Announcement2) — default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ index
// ก็เรียกแบบ bare
//
// หวย365 เป็นเว็บแทงหวยออนไลน์ ไม่ใช่บอลและไม่ใช่สล็อต — บรีฟรอบนี้พูดถึงแนวทางหวย
// กลุ่มหวย สถิติหวยย้อนหลัง และผลหวยตามรอบที่ประกาศ ของหวยรัฐบาลไทย หวยฮานอย
// หวยลาวพัฒนา และหวยหุ้นต่างประเทศ จากบัญชีเดียว
// ตัวเลขที่ใช้ได้มีแค่ 2 ตัว จ่าย 100 บาท · 3 ตัว จ่าย 1,000 บาท · 3 ขั้นตอน ·
// 24 ชั่วโมง
// คำศัพท์ของแบรนด์ก่อนหน้า (เลขเด็ด เลขดัง ไม่จำกัด แทงได้ไม่อั้น ฮานอยปกติ/พิเศษ/
// วีไอพี ฝากถอนวอลเลท สล็อต ฟรีสปิน RTP บอล ค่าน้ำ อัตราต่อรอง ลีก คาสิโน บาคาร่า)
// ห้ามหลงเหลือ
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 152
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าเข้าสู่ระบบ ${BRAND_NAME} กดปุ่มเดียวเข้าบัญชีสมาชิก เพื่อเลือกประเภทหวย ส่งโพย ดูสถิติหวยย้อนหลัง และตรวจผลหวยตามรอบที่ประกาศ พร้อมตรวจอัตราจ่ายก่อนยืนยัน`;

const graph = pageGraph(Astro, {
  name: `เข้าสู่ระบบ ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`เข้าสู่ระบบ ${BRAND_NAME} ล็อกอินเข้าบัญชีสมาชิก ส่งโพยและดูผลหวยได้ทันที`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`เข้าสู่ระบบ ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#9c0201] bg-[#240406] px-6 py-4 text-lg font-black text-[#ffc93c] shadow-[0_10px_30px_rgba(8,1,1,0.85)] transition-all duration-300 hover:scale-105 hover:border-[#f5282a] hover:bg-[#9c0201] hover:text-[#ffeab0] hover:shadow-[0_15px_40px_rgba(220,2,3,0.35)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
