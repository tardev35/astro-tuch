---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change.
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page, which means verify-build holds its
// description to the same 150–160 character window as every other page.
//
// ⚠️ แบรนด์รอบนี้เป็น **เว็บเกมสล็อตล้วน** ตามบรีฟ — ไม่ใช่คาสิโน ไม่ใช่กีฬา
// ไม่ใช่หวย บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES เลย คอปปี้ของ
// หน้านี้จึงอนุมานจากบรรทัด 4 และ 6 ซึ่งพูดถึงการเข้าเล่น ฝากถอน และการขอคำแนะนำ
// เกี่ยวกับขั้นตอนการใช้งานจากเจ้าหน้าที่ได้ตลอด 24 ชั่วโมง เท่านั้น
// — คำที่ห้ามหลุดกลับมาอยู่ใน brand-spec §7 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep
// หาคำต้องห้ามเจอ false positive · สามแบรนด์ก่อนหน้าขายกรอบ
// "คาสิโน + กีฬา + เซิร์ฟเวอร์นอก" ซึ่งบรีฟรอบนี้ไม่มีเลยสักคำ
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 24 ชั่วโมง — ห้ามแต่งใบอนุญาต
// หน่วยงานกำกับ ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP ยอดขั้นต่ำ จำนวนสมาชิก หรือปีใดๆ
// (บรีฟรอบนี้ไม่ได้เอ่ยปีไว้เลย)
//
// แบรนด์รอบนี้ (รับตัง168, รอบ **ทองไทยนำ แดงมังกรรอง บนพื้นดำอมแดง** 2026-10-18,
// brand-spec §2): **สองโทนจริง แต่รอบนี้ทองนำ แดงรอง** — กองเหรียญทองจีนในโลโก้
// คือพื้นที่อิ่มสีที่ใหญ่ที่สุด ส่วนรอบก่อนสลับกันคือแดงนำและทองเป็นเส้นขอบ
// ทองลึก #9a6c0c · แดงแบรนด์ #d30304 · แดงลึก #a00203 · แดงเข้มสุด #4a0202 ·
// ตัวที่ถือตัวอักษรได้: ทองสว่าง #ffdc8c (12:1) · ทองแบรนด์ #f0b429 (8.5:1) ·
// เงินอมฟ้า #cfd9e6 (ตัวอักษรรอง 10.9:1) · แดงสว่าง #ff6b6e (5.4:1) ·
// เนื้อความ #f5ece0 (= BRAND_TEXT) · หมึกบนพื้นถมทอง/แดง #1a0505
// ชั้นผิว: ยก #2b100f (= การ์ด ContentBox) / กลาง #200a09 / จม #140505 /
// พื้นเพจ #1a0505 — bg.json รอบนี้เป็นดำอมแดง ไม่ใช่ดำสนิท
// ปุ่มนี้เป็นคู่ SECONDARY: จมลงจากการ์ดด้วยชั้น #200a09 → #140505 ขอบ **แดง**
// #d30304/55 บนตัวอักษรแดงสว่าง #ff6b6e (6.8:1) — hover ยกขอบเป็น #ff6b6e
// ส่วน /register เป็น PRIMARY ถมพื้น **ทอง** จึงไม่ซ้ำกัน (รอบก่อนกลับขั้วกัน)
// ⚠️ ห้ามใช้ผิวยก #2b100f เป็นพื้นปุ่ม มันเป็นสีเดียวกับการ์ดที่ปุ่มวางอยู่
// ⚠️ #9a6c0c #d30304 #a00203 #4a0202 ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่เส้นขอบ
// ออรา พื้นถม และเงา — ออราในไฟล์นี้ใช้ rgba(211,3,4,α) เท่านั้น นอกจากเงาดำล้วน
// ⚠️ กับดักรอบนี้คือ **แดง** และหนักกว่าทุกรอบ เพราะสามแบรนด์ก่อนหน้าเป็นแดง
// ทั้งสามเจ้า และต่างจากแดงรอบนี้ (#d30304) เพียงไม่กี่หลัก
// "มีแดงอยู่แล้ว" จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้ ให้เทียบเป็น "ค่า" ทีละตัวกับตาราง
// ใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ
// false positive — ของเรามีค่าใกล้ของเก่าแค่ไม่กี่หลัก ทั้งแดงและทอง จึงต้องเทียบ
// ทีละหลักกับตารางในสเปก ไม่เทียบด้วยตาและไม่เทียบด้วยตระกูลสี
// และรอบนี้ **ไม่มีม่วง ไม่มีชมพู ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว ไม่มีส้ม**
// เงินอมฟ้า #cfd9e6 เป็นตัวอักษรรองเท่านั้น ไม่ใช่สีระบบ ไม่ใช่เส้นขอบ
//
// Announcement หมุนมาเป็น AnnouncementPremium ทั้งเว็บรอบนี้ (brand-spec §3 —
// แบรนด์ก่อนใช้ Announcement3 จึงหมุนออก) orchestrator ตั้ง default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare — ห้ามส่ง prop message
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) หน้านี้ยาว 159
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าเข้าสู่ระบบ ${BRAND_NAME} กดปุ่มเดียวไปยังทางเข้าหลักของเว็บเกมสล็อตออนไลน์ เพื่อเข้าเล่น ฝากถอน และขอคำแนะนำเกี่ยวกับขั้นตอนการใช้งานจากเจ้าหน้าที่ 24 ชั่วโมง`;

const graph = pageGraph(Astro, {
  name: `เข้าสู่ระบบ ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/2u19";
---

<MainLayout title={`เข้าสู่ระบบ ${BRAND_NAME} ฐานหลักเกมสล็อต เข้าจากทางเข้าหลัก`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`เข้าสู่ระบบ ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#d30304]/55 bg-gradient-to-b from-[#200a09] to-[#140505] px-6 py-4 text-2xl font-bold tracking-wide text-[#ff6b6e] shadow-[0_10px_30px_rgba(0,0,0,0.55)] transition-all duration-300 hover:scale-105 hover:border-[#ff6b6e] hover:shadow-[0_15px_40px_rgba(211,3,4,0.4)]">
        <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#d30304]/20 to-transparent"></div>
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
