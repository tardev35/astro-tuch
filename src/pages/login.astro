---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change (CtaRedirect.astro
// itself belongs to the orchestrator — ห้ามแก้ไฟล์นั้นจากหน้านี้)
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page, which means verify-build holds its
// description to the same 150–160 character window as every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES — คอปปี้ของหน้านี้จึงพูด
// ได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 20: หลังลงทะเบียนเรียบร้อย สามารถตรวจสอบโปรแกรม
// แข่งขัน ราคาบอล ประเภทการเดิมพัน และเงื่อนไขโปรโมชั่นก่อนใช้งาน · บรรทัด 4:
// โปรแกรมแข่งขัน ผลการแข่งขัน และแนวทางวิเคราะห์ก่อนเกม)
// ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า หน้านี้มีโควตาเป็นปุ่มเดียว
//
// ⚠️ แบรนด์รอบนี้เป็น **แฟนเพจเว็บบอลยูฟ่า = เว็บกีฬา/ฟุตบอล** ไม่ใช่สล็อตและ
// ไม่ใช่หวย คำว่า สล็อต · ยิงปลา · ไฮโล · หวยออนไลน์ · แทงหวย ทุกคำเป็น
// **ของค้างจากแบรนด์ก่อน (รวยเทพ168)** ห้ามหลุดกลับมา
// คำที่ใช้ได้รอบนี้: ฟุตบอล · เว็บบอล · ยูฟ่า · แทงบอล · ทริคแทงบอล · ข่าวสารฟุตบอล ·
// โปรแกรมแข่งขัน · ผลการแข่งขัน · แนวทางวิเคราะห์ก่อนเกม · ราคาบอล · ค่าน้ำ ·
// ราคาต่อรอง · อัตราจ่าย · ประเภทการเดิมพัน พร้อมโปรโมชั่นสองรายการคือ
// **คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%** — รายการเต็มอยู่ใน brand-spec §6
// แบรนด์ก่อนหน้าขายตัวเองด้วยวลีที่บรีฟรอบนี้ไม่มีเลยสักคำ จึงต้องเขียนใหม่จากบรีฟ
// ไม่ใช่ find-and-replace ทับของเดิม
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกมหรือชื่อลีกแม้แต่ชื่อเดียว** จึงห้ามเขียนลงหน้า
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 24ชม. · 3 ขั้นตอน ห้ามแต่ง
// ใบอนุญาต หน่วยงานกำกับ ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก
// หรือปีใดๆ (บรีฟรอบนี้ไม่ได้เอ่ยปีไว้เลย) · ห้ามใช้คำว่า เว็บตรง / ไม่ผ่านเอเย่นต์ /
// ลิขสิทธิ์แท้ — หัวข้อขั้นตอนสมัครกับช่องทางติดต่อแอดมินของบรีฟ (บรรทัด 13-22)
// เป็นของ index.astro ไม่ใช่ของหน้านี้
//
// พาเลตต์รอบนี้อยู่ใน .claude/brand-spec-ufalion168.md §2 — **ทองสองเฉด + บรอนซ์
// บนพื้นดำสนิท ไม่มีสีที่สองที่เป็นคนละวงศ์** (bg.json =
// {"mode":"color","color":"#000000"})
// ทองอำพัน #d4922c (5.9:1 บนผิวการ์ด) · ทองเลมอน #fdfc71 (14.3:1) ·
// ครีมทอง #f6e3b4 (12.3:1) · เนื้อความ #fbf6e3 (= BRAND_TEXT) ·
// หมึกบนพื้นถมทอง/ครีม #1a1000
// ชั้นผิว: ยก #33200a (= การ์ด ContentBox) / กลาง #1f1304 / จม #0a0601
// ปุ่มนี้เป็นคู่ SECONDARY: จมลงจากการ์ดด้วยชั้น #1f1304 → #0a0601 ขอบ **บรอนซ์**
// #a25b24 บนตัวอักษร **ครีมทอง** #f6e3b4 — hover ยกขอบเป็นทองอำพัน #d4922c
// (ขั้วเดียวกับปุ่ม เข้าสู่ระบบ ของ Navfoot ที่ขึ้นทุกหน้าบนมือถือ จึงอ่านเป็นปุ่ม
// เดียวกันทั้งเว็บ) ส่วน /register เป็น PRIMARY ถมพื้น **ทอง** บนหมึกเข้ม จึงไม่ซ้ำกัน
// ⚠️ ห้ามใช้ผิวยก #33200a เป็นพื้นปุ่ม มันเป็นสีเดียวกับการ์ดที่ปุ่มวางอยู่
// ⚠️ **บรอนซ์ #a25b24 ตกเกณฑ์ AA ทุกพื้น (3.0–4.1:1) จึงเป็นขอบ/พื้นถม/ไอคอน
// เท่านั้น ห้ามถือตัวอักษร** ถ้าต้องมีตัวอักษรบนบรอนซ์ให้ถมบรอนซ์แล้ววาง #fbf6e3
// ทับ (4.8:1) · บรอนซ์ไหม้ #5a3310 เป็นเส้น/ออราเท่านั้น ไม่เคยถือตัวอักษร
// ออราในไฟล์นี้ใช้ rgba(212,146,44,α) และ rgba(253,252,113,α) เท่านั้น นอกจากเงาดำล้วน
// ⚠️ กับดักรอบนี้คือ **ทองเคยนำมาแล้วเกือบทุกแบรนด์** "มีทองอยู่แล้ว" จึงไม่พิสูจน์
// ว่าเป็นค่าของรอบนี้ ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน brand-spec §2 ซึ่งไม่
// พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive (ทองของ
// TND168 ใกล้ที่สุด ตัวตัดสินคือ G146 vs G163 และ B44 vs B16 — ตาแยกไม่ออก)
// รอบนี้ **ไม่มีแดง** (ต่างจากรอบก่อนที่แดงเป็นฮิวที่สอง) **ไม่มีฟ้า/น้ำเงิน ไม่มีม่วง
// ไม่มีเขียว ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์ ไม่มีชมพู/ฟูเชีย ไม่มีส้มสด** —
// บรอนซ์เป็นฮิวที่สามที่อ่านจาก logo.webp จริง ไม่ใช่ส้มอิสระ
//
// Announcement หมุนมาเป็น Announcement3 ทั้งเว็บรอบนี้ (brand-spec §3 — รอบก่อนใช้
// AnnouncementPremium จึงหมุนออก) orchestrator ตั้ง default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare — ห้ามส่ง prop message
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) หน้านี้ยาว 152
// ด้วยชื่อแบรนด์ 10 ตัวอักษรของรอบนี้
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าเข้าสู่ระบบ ${BRAND_NAME} กดปุ่มเดียวเข้าสู่บัญชีสมาชิก เพื่อตรวจสอบโปรแกรมแข่งขัน ผลการแข่งขัน ราคาบอล ประเภทการเดิมพัน และเงื่อนไขโปรโมชั่นก่อนใช้งาน`;

const graph = pageGraph(Astro, {
  name: `เข้าสู่ระบบ ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`เข้าสู่ระบบ ${BRAND_NAME} เข้าบัญชีสมาชิกเพื่อตรวจสอบราคาบอลและโปรโมชั่น`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`เข้าสู่ระบบ ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#a25b24] bg-gradient-to-b from-[#1f1304] to-[#0a0601] px-6 py-4 text-2xl font-bold tracking-wide text-[#f6e3b4] shadow-[0_10px_30px_rgba(0,0,0,0.55)] transition-all duration-300 hover:scale-105 hover:border-[#d4922c] hover:shadow-[0_15px_40px_rgba(212,146,44,0.45)]">
        <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#d4922c]/20 to-transparent"></div>
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
