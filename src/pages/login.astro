---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 159.
const pageDescription =
  "หน้าเข้าสู่ระบบ HIX168 กดปุ่มเดียวเข้าบัญชีสมาชิกเพื่อเล่นเกมสล็อตออนไลน์ต่อได้ทันที พร้อมตรวจสอบเครดิต โปรโมชั่น และประวัติรายการฝากถอนของตัวเองได้จากหน้าเว็บ";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ HIX168 ล็อกอินเข้าบัญชีสมาชิก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="เข้าสู่ระบบ HIX168 ล็อกอินเข้าบัญชีสมาชิก ปั่นสล็อตต่อได้ทันที" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ HIX168" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ HIX168"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#1e7bf5]/60 bg-[#01030d] px-6 py-4 text-lg font-black text-[#1e7bf5] shadow-[0_10px_30px_rgba(30,123,245,0.20)] transition-all duration-300 hover:scale-105 hover:border-[#8ec5ff] hover:bg-[#0d1730] hover:shadow-[0_15px_40px_rgba(30,123,245,0.32)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
