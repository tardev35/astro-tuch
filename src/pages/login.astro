---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement4.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1×1, h2×0, h3×0. Never write an article here and never add an <h2>.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change.
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens. It is an indexed page now, which
// means verify-build holds its description to the same 150–160 character window
// as every other page.
//
// FAH999 (รอบชมพูฮ็อต-ทอง 2026-10-11, brand-spec §2):
// ชมพูแบรนด์ #ff3fa4 (ฮิวหลัก) · ชมพูไฮไลต์ #ff6cbb · ชมพูซีด #ffd1ea ·
// ชมพูลึก #b3006a (รูปทรง/ขอบ/ออราเท่านั้น) · ทอง #f5c53d (ฮิวที่สอง) ·
// เนื้อความ #fde8f3 (= BRAND_TEXT) · หมึกเข้ม #2b0019 ใช้ได้เฉพาะบนพื้นถมชมพูหรือทอง
// ชั้นผิว: ยก #4a0b42 (= การ์ด ContentBox) / กลาง #3a0534 / พื้นเพจ #2e002c /
// ลึก #210220 — รอบนี้พื้นเพจเป็นพลัมดำ ไม่ใช่ดำสนิท จึงมีชั้นที่ "ลึกกว่าพื้น" ได้
// ปุ่มนี้เป็นคู่ SECONDARY เดียวกับ /ทางเข้า: จมลงจากการ์ดด้วยชั้น #3a0534 → #210220
// ขอบทอง #f5c53d/55 บนเนื้อความ #fde8f3 — hover ยกขอบเป็นทองเต็ม
// ส่วน /register เป็น PRIMARY ถมชมพู จึงไม่ซ้ำกัน
// ⚠️ ห้ามใช้ผิวยก #4a0b42 เป็นพื้นปุ่ม มันเป็นสีเดียวกับการ์ดที่ปุ่มวางอยู่
// ⚠️ #b3006a #7a0046 #4d002b #9c6f08 ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่เส้นขอบ ออรา
// และเงา — ออราใช้ rgba(245,197,61,α) เท่านั้นในไฟล์นี้ นอกจากเงาดำล้วน
// ⚠️ แบรนด์ก่อนๆ ก็มีทั้งชมพูและทอง (เจ็ดในเก้ารอบหลังสุดมีทอง) เจอชมพูหรือทอง
// ที่ไหนห้ามเหมาว่าเป็นของรอบนี้ ให้เทียบเป็น "ค่า" ทีละตัวกับตารางแบนใน
// brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false
// positive — ชุดทอง-ส้มอำพันของรอบก่อนออกครบทุกจุดในไฟล์นี้แล้ว และรอบนี้
// ไม่มีสีส้มอำพันเป็นฮิวเลย
//
// Announcement หมุนมาเป็น Announcement4 ทั้งเว็บรอบนี้ (รอบก่อนใช้ Announcement6 —
// brand-spec §3 หมุนออก) และเรียกแบบ bare ทุกหน้า — ห้ามส่ง prop message จากหน้านี้
//
// แบรนด์นี้เป็น **ฟาสล็อตเว็บตรง** ล้วนๆ — รายการคำต้องห้ามเต็มอยู่ใน
// brand-spec §7 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep เจอ false positive
// ⚠️ ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 0.3% / 0.8% / 3 ขั้นตอน / 24 ชั่วโมง
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) หน้านี้ยาว 151
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าเข้าสู่ระบบ ${BRAND_NAME} ฟาสล็อตเว็บตรง กดปุ่มเดียวไปยังทางเข้าหลักของเว็บไซต์ เพื่อเลือกค่ายเกม ค้นหาเกมสล็อต และตรวจสอบข้อมูลบัญชีได้สะดวกจากบัญชีเดียว`;

const graph = pageGraph(Astro, {
  name: `เข้าสู่ระบบ ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`เข้าสู่ระบบ ${BRAND_NAME} ฟาสล็อตเว็บตรง เข้าใช้งานจากทางเข้าหลัก`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`เข้าสู่ระบบ ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f5c53d]/55 bg-gradient-to-b from-[#3a0534] to-[#210220] px-6 py-4 text-2xl font-bold tracking-wide text-[#fde8f3] shadow-[0_10px_30px_rgba(0,0,0,0.55)] transition-all duration-300 hover:scale-105 hover:border-[#f5c53d] hover:shadow-[0_15px_40px_rgba(245,197,61,0.4)]">
        <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#f5c53d]/25 to-transparent"></div>
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
