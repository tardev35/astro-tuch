---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect. The title and
// description below are written for exactly that reason.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// หวย24 (รอบแดงแบรนด์ + ทอง บนดำอมแดง 2026-10-04, brand-spec §2 — แดง #d20a0a
// มาจาก vivid ของ logo.webp และผ้าไหมแดงบนแบนเนอร์ ส่วนทอง #f5c33b / #ffd45e คือ
// เหรียญทองกับเวิร์ดมาร์ก หวย24 ที่สวมมงกุฎทอง รอบ หวยคิง ที่แล้วทองเป็นสีหลักและ
// สีรองเป็นครีมอมพีช รอบนี้กลับทิศ: แดงนำ ทองรอง ห้ามใช้ครีมอมพีชอีก):
// ปุ่มนี้เป็นตัว SECONDARY ของคู่ จึงถม **แดงเข้มสุด #2a0606 ในกรอบแดงแบรนด์
// #d20a0a/60** บนตัวอักษรเนื้อความ #f7e2d6 แล้ว hover ยกกรอบเป็นทองแบรนด์
// #f5c33b/65 กับผิวแดงลึก #7a0505 — คู่เดียวกับที่ NavbarStyle10 และ FooterStyle3
// ใช้อยู่แล้ว ส่วน /register สวมไล่เฉดทองเต็มใบ (#ffd45e → #f5c33b → #a9761a) บน
// ตัวอักษรดำอมแดง #1a0303
// ลำดับความสำคัญรอบนี้จึงสื่อด้วย "ทองถม vs แดงถม" ไม่ใช่ถมทองสองใบซึ่งจะอ่าน
// เป็นปุ่มซ้ำกันสองปุ่ม — และคู่แดง/ทองนี้คือสองโทนที่อยู่บนอาร์ตเวิร์กจริง
// กฎคอนทราสต์: พื้นทองสว่าง = หมึก **ดำอมแดง #1a0303** เสมอ (หมึกขาวบน #ffd45e
// ตก) · พื้นเข้ม #2a0606 / #7a0505 = ตัวอักษรเนื้อความ #f7e2d6 หรือทองสว่าง #ffd45e
// ชุดทองโลหะ + ครีมอมพีชของ หวยคิง (#cd9a2c #fdeb7c #ab7314 #f5e7c8 #fcd4c3
// #fce2d4 #1c140b #0c0b0a #120a02 rgba(205,154,44,*) rgba(252,212,195,*)
// rgba(12,11,10,*)) ออกครบแล้ว ห้ามนำกลับมา
//
// Announcement หมุนมาเป็น Announcement3 ทั้งเว็บรอบนี้ (รอบก่อน หวยคิง เป็น
// AnnouncementHuay) — default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ
// index ก็เรียกแบบ bare จึงห้ามส่ง prop message
//
// หวย24 เป็น **เว็บรับแทงหวยล้วน** ไม่ใช่คาสิโน บรีฟระบุว่าหลัง Login สมาชิกเลือก
// หวย รอบ และเลขที่ต้องการ แล้วตรวจสอบยอดเดิมพันกับอัตราจ่ายก่อนยืนยันรายการ
// พร้อมดูผลรางวัลและประวัติโพยจากบัญชีเดียว
// ตลาดหวยที่บรีฟระบุและอ้างได้มีสามตัว: หวยลาว · หวยฮานอย · รัฐบาลไทย
// ตัวเลขที่ใช้ได้มีแค่ 100 / 1,000 / 2 ตัว / 3 ตัว / 3 ขั้นตอน / 24 ชั่วโมง
// ห้ามแต่งตัวเลขอื่นขึ้นมาเอง และห้ามเอ่ยเวลาเปิด-ปิดรับของหวยรอบใดรอบหนึ่ง
// ชื่อธนาคาร ยอดฝากขั้นต่ำ หรือเลขใบอนุญาต ที่บรีฟไม่ได้ระบุ
// คำหมวดคาสิโน (สล็อต บาคาร่า คาสิโนสด ค่ายเกม RTP คืนยอดเสีย % แนะนำเพื่อน %)
// ห้ามหลงเหลือ
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 157
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าเข้าสู่ระบบ ${BRAND_NAME} กดปุ่มเดียวเข้าบัญชีสมาชิก เพื่อเลือกหวยลาว หวยฮานอย รัฐบาลไทย กรอกเลขเด็ดเลขดัง ตรวจอัตราจ่ายและวงเงินรับแทง ก่อนยืนยันส่งโพยได้ทุกรอบ`;

const graph = pageGraph(Astro, {
  name: `เข้าสู่ระบบ ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`เข้าสู่ระบบ ${BRAND_NAME} ล็อกอินเข้าบัญชีสมาชิก เลือกหวยและส่งโพยได้ทันที`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`เข้าสู่ระบบ ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#d20a0a]/60 bg-[#2a0606] px-6 py-4 text-lg font-black text-[#f7e2d6] shadow-[0_10px_30px_rgba(10,3,3,0.75)] transition-all duration-300 hover:scale-105 hover:border-[#f5c33b]/65 hover:bg-[#7a0505] hover:shadow-[0_15px_40px_rgba(210,10,10,0.4)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
