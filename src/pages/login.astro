---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — this page is indexed and must not
// describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// The button is the SECONDARY of the pair on the FAH999 palette: raised panel
// surface (#1c160e) inside a primary-gold outline (#e8c25a) over cream-gold body
// ink (#e7dcc4), lifting to highlight gold (#f7e7a8) on hover, while /register
// wears the full gold-gradient fill. Same hue on both — the tier is carried by
// the brightness of the fill, not by a second colour.
//
// Announcement รอบนี้หมุนมาใช้ Announcement5 ทั้งเว็บ — default message ของไฟล์
// นั้นเป็นคอปปี้ของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ไม่ต้องส่ง prop
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 158
const pageDescription = "หน้าเข้าสู่ระบบ FAH999 กดปุ่มเดียวเข้าบัญชีสมาชิกเพื่อเล่นสล็อตจากหลายค่ายแบบไม่ล็อคยูส ตรวจสอบสิทธิ์โบนัส สถานะฝากถอน และเงื่อนไขของแต่ละเกมได้จากบัญชีตัวเอง";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ FAH999",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="เข้าสู่ระบบ FAH999 ล็อกอินเข้าบัญชีสมาชิก เล่นสล็อตได้ทุกค่ายแบบไม่ล็อคยูส" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ FAH999" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ FAH999"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#e8c25a] bg-[#1c160e] px-6 py-4 text-lg font-black text-[#e7dcc4] shadow-[0_10px_30px_rgba(232,194,90,0.22)] transition-all duration-300 hover:scale-105 hover:border-[#f7e7a8] hover:bg-[#241c11] hover:text-[#f7e7a8] hover:shadow-[0_15px_40px_rgba(247,231,168,0.36)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
