---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1×1, h2×0, h3×0. Never write an article here and never add an <h2>.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change.
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens. It is an indexed page now, which
// means verify-build holds its description to the same 150–160 character window
// as every other page.
//
// DUCK1688 (รอบทองเป็ด-ส้มปากเป็ด 2026-10-10, brand-spec §2):
// ทองเป็ด #f3bb34 (ฮิวหลัก) · ทองสว่าง #fde464 · ทองกลาง #c8901a ·
// ส้มอำพันปากเป็ด #f58b2a (ฮิวที่สอง) · ส้มอ่อน #ffc98a · เนื้อความ #f6ecd9 ·
// หมึกบนพื้นถมทอง #1a1203 · ชั้นผิว ยก #1f1709 / กลาง #171106 / ลึก #0d0903
// (พื้นเพจจาก bg.json = #000000 ดำสนิท — ไม่มีชั้นไหนลึกกว่าพื้นได้อีก)
// ปุ่มนี้เป็นคู่ SECONDARY เดียวกับ /ทางเข้า: จมลงจากการ์ด ContentBox (ผิวยก
// #1f1709) ด้วยชั้น #171106 → #0d0903 ขอบส้มอำพัน #f58b2a/55 บนเนื้อความ #f6ecd9
// hover ยกขอบเป็นส้มเต็ม #f58b2a — ส่วน /register เป็น PRIMARY ถมทอง จึงไม่ซ้ำกัน
// ⚠️ ห้ามใช้ผิวยก #1f1709 เป็นพื้นปุ่ม มันเป็นสีเดียวกับการ์ดที่ปุ่มวางอยู่
// ⚠️ #8a5f08 #5c3f04 #a3510c ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่เส้นขอบ ออรา และเงา
// — ออราใช้ rgba(245,139,42,α) เท่านั้นในไฟล์นี้ นอกจากเงาดำล้วน
// ⚠️ แบรนด์รอบก่อน (NAZA168) ก็เป็นแบรนด์ "ทอง" เหมือนกัน เจอทองที่ไหนห้ามเหมาว่า
// เป็นของรอบนี้ ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน brand-spec §2 — ชุด
// #fbc134 #ffe87a #cf9a18 #96690a #6b4a05 #cfd6e3 #3f4859 #fdf3df #4e3406
// #432b03 #382400 #241700 rgba(251,193,52,α) rgba(207,214,227,α) ออกครบแล้ว
// และรอบนี้ไม่มีสีแดงและไม่มีเงินโครเมียมเป็นฮิวเลย
//
// Announcement หมุนมาเป็น Announcement6 ทั้งเว็บรอบนี้ และเรียกแบบ bare
// ทุกหน้า — ห้ามส่ง prop message จากหน้านี้
//
// แบรนด์นี้เป็นสล็อตพีจีเว็บเป็ดล้วนๆ ไม่ใช่เว็บหวย — รายการคำต้องห้ามเต็มอยู่ใน
// brand-spec §7 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep เจอ false positive
// ⚠️ ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 0.3% / 0.8% / 3 ขั้นตอน / 24 ชั่วโมง
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) หน้านี้ยาว 157
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าเข้าสู่ระบบ ${BRAND_NAME} สล็อตพีจีเว็บเป็ด กดปุ่มเดียวไปยังช่องทางหลักของเว็บไซต์ เพื่อค้นหาเกมสล็อต เลือกยอดเดิมพัน และตรวจสอบรายละเอียดของแต่ละค่ายได้สะดวก`;

const graph = pageGraph(Astro, {
  name: `เข้าสู่ระบบ ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`เข้าสู่ระบบ ${BRAND_NAME} สล็อตพีจีเว็บเป็ด เข้าใช้งานจากช่องทางหลัก`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`เข้าสู่ระบบ ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f58b2a]/55 bg-gradient-to-b from-[#171106] to-[#0d0903] px-6 py-4 text-2xl font-bold tracking-wide text-[#f6ecd9] shadow-[0_10px_30px_rgba(0,0,0,0.55)] transition-all duration-300 hover:scale-105 hover:border-[#f58b2a] hover:shadow-[0_15px_40px_rgba(245,139,42,0.4)]">
        <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#f58b2a]/25 to-transparent"></div>
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
