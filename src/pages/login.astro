---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char).
const pageDescription =
  "หน้าเข้าสู่ระบบ AKA99 สล็อตเว็บตรงค่ายใหญ่ สำหรับสมาชิกที่ต้องการล็อกอินเข้าบัญชี ตรวจสอบเครดิตและสิทธิ์โบนัส พร้อมฝากถอนอัตโนมัติได้เองตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ AKA99 ล็อกอินเข้าบัญชีสมาชิก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="เข้าสู่ระบบ AKA99 สล็อตเว็บตรงค่ายใหญ่ ล็อกอินเข้าบัญชีสมาชิก ฝากถอนออโต้ 24 ชั่วโมง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ AKA99" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าระบบเกม AKA99"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#1e4b9e]/80 bg-[#03081c] px-6 py-4 text-lg font-black text-[#eaf3fd] shadow-[0_10px_30px_rgba(11,108,240,0.18)] transition-all duration-300 hover:scale-105 hover:border-[#9dd2fa] hover:bg-[#061436] hover:shadow-[0_15px_40px_rgba(11,108,240,0.30)]">
        เข้าระบบเกม
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
