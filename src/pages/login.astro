---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — this page is indexed and must not
// describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// The button is the SECONDARY of the pair on the HENG35 palette: black card
// surface (#12100b) inside a primary-gold outline (#ecc55c) over body ink
// (#ece1cb), lifting to highlight gold (#ffdf8a) on a brighter black (#1c1710)
// on hover, while /register wears the full gold-gradient fill. The tier is
// carried by the brightness of the fill, not by a second hue.
//
// Announcement รอบนี้หมุนมาใช้ AnnouncementPremium ทั้งเว็บ — default message
// ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ไม่ต้องส่ง prop
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 153
const pageDescription = "หน้าเข้าสู่ระบบ HENG35 กดปุ่มเดียวเข้าบัญชีสมาชิกเพื่อเข้าเล่นสล็อตจากหลายค่าย ตรวจสอบสิทธิ์โปรโมชั่น สถานะฝากถอน และรายละเอียดของเกมได้จากบัญชีของตัวเอง";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ HENG35",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="เข้าสู่ระบบ HENG35 ล็อกอินเข้าบัญชีสมาชิก เล่นสล็อตรวมหลายค่าย" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ HENG35" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ HENG35"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ecc55c] bg-[#12100b] px-6 py-4 text-lg font-black text-[#ece1cb] shadow-[0_10px_30px_rgba(7,6,5,0.7)] transition-all duration-300 hover:scale-105 hover:border-[#ffdf8a] hover:bg-[#1c1710] hover:text-[#ffdf8a] hover:shadow-[0_15px_40px_rgba(236,197,92,0.36)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
