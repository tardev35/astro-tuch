---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// The button is the SECONDARY of the pair: navy card surface with a metallic
// gold outline, while /register wears the solid gold gradient.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 152.
const pageDescription =
  "หน้าเข้าสู่ระบบ OCZPLUS กดปุ่มเดียวเข้าบัญชีสมาชิกเพื่อเล่นสล็อต พร้อมตรวจสอบเครดิตคงเหลือ โปรโมชั่นที่กดรับได้ และรายการฝาก-ถอนอัตโนมัติตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ OCZPLUS",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="เข้าสู่ระบบ OCZPLUS ล็อกอินเข้าบัญชีสมาชิก เริ่มเล่นสล็อตได้ทันที" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ OCZPLUS" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ OCZPLUS"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#d9b45e]/60 bg-[#071a36] px-6 py-4 text-lg font-black text-[#e4c67f] shadow-[0_10px_30px_rgba(217,180,94,0.22)] transition-all duration-300 hover:scale-105 hover:border-[#f2dc9a] hover:bg-[#03101f] hover:text-[#f2dc9a] hover:shadow-[0_15px_40px_rgba(217,180,94,0.40)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
