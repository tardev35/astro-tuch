---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change (CtaRedirect.astro
// itself belongs to the orchestrator — ห้ามแก้ไฟล์นั้นจากหน้านี้)
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page, which means verify-build holds its
// description to the same 150–160 character window as every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES — คอปปี้ของหน้านี้จึงพูด
// ได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 6: เกมสล็อตคลาสสิก เกมที่มีฟีเจอร์โบนัส และเกมที่
// ปรับระดับการเดิมพันได้ พร้อมยอดเดิมพันขั้นต่ำและข้อกำหนดการฝากเงิน · บรรทัด 20:
// หลังลงทะเบียนสามารถศึกษารายชื่อเกมสล็อต กติกาการเล่น ยอดเดิมพันขั้นต่ำ และ
// เงื่อนไขโปรโมชั่น · บรรทัด 22: ควรตรวจสอบช่องทางจากเว็บไซต์ทางการ)
// ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า หน้านี้มีโควตาเป็นปุ่มเดียว
//
// ⚠️ แกนของบรีฟรอบนี้คือ **เว็บเกมสล็อตออนไลน์เบทต่ำ** ไม่ใช่เว็บพนันครบวงจร
// แบบรอบก่อน และไม่ใช่เว็บลอตเตอรีแบบรอบก่อนหน้านั้น ศัพท์ของหมวดอื่นที่บรีฟ
// ไม่มีทุกคำจึงเป็นของค้างที่ห้ามหลุดกลับมา รายการคำเต็มอยู่ใน brand-spec §5
// ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์
// ของไฟล์นี้เอง
// คำที่ใช้ได้รอบนี้: สล็อต · สล็อตออนไลน์ · เบทต่ำ · สบายเป๋า · ทุนน้อย · เล่นง่าย ·
// ยอดเข้าบริษัทโดยตรง · เกมเดิมพันออนไลน์ · ค่ายแท้ · เกมสล็อตคลาสสิก ·
// ฟีเจอร์โบนัส · ปรับระดับการเดิมพัน · ยอดเดิมพันขั้นต่ำ · งบประมาณ ·
// ข้อกำหนดการฝากเงิน · โปรโมชั่น · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · เครดิต ·
// สมัครสมาชิก · เข้าสู่ระบบ · ยืนยันบัญชี · รหัสผ่าน · รหัส OTP · แอดมิน ·
// เจ้าหน้าที่ · 24ชม. · เว็บไซต์ทางการ · ประกาศล่าสุด · บัญชีแอบอ้าง · ฝากถอน
// ⚠️ **สองหน้าหมวดลอตเตอรีอยู่ใน src/pages-disabled/ รอบนี้**
// ห้ามลิงก์ไปสองเส้นทางนั้น route ไม่มีอยู่จริง build จะแดง
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกม ชื่อธนาคาร หรือใบอนุญาตแม้แต่รายเดียว**
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 24ชม. · 3 ขั้นตอน
// ห้ามแต่งใบอนุญาต หน่วยงานกำกับ ค่า RTP ยอดฝากขั้นต่ำ หรือจำนวนสมาชิก ·
// บรีฟรอบนี้มี "ขั้นตอน 1-3" ของการสมัคร แต่นั่นเป็นของ index.astro
// (FeatureHighlights) ไม่ใช่ของหน้านี้ หัวข้อฝากถอนกับช่องทางติดต่อแอดมินของบรีฟ
// ก็เป็นของ index.astro เช่นกัน
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตต์รอบนี้อยู่ใน .claude/brand-spec-sabai168.md §2
// ⚠️⚠️ **รอบนี้กลับมาเป็น "ธีมสว่าง" หลังรอบก่อนเป็นดำสนิท — การ์ดผิวขาว
// หมึกน้ำเงินเข้ม** bg.json = {"mode":"color","color":"#ccf7ff"} = **ฟ้าพาสเทล
// สว่าง** ไม่ใช่ดำ การ์ด ContentBox จึงเป็นผิวขาวบนหมึกน้ำเงิน #0f3a4a
// (= BRAND_TEXT) **ห้าม "แก้" ให้กลับไปมืดเพราะรอบที่แล้วมืด**
// ปุ่มนี้เป็นคู่ SECONDARY ของพาเลตโซน "เนื้อหา": พื้นถม **ทองคานารี**
// ไล่ #fefb6b → #fdcb0c ขอบ #fdcb0c บนหมึก **เข้ม** #2a1f02 (~9:1 ผ่าน AA)
// ส่วน /register เป็น PRIMARY ถมไล่เฉดฟ้าบนหมึกเข้ม จึงไม่ซ้ำกัน
// ⚠️ ปุ่มของ Navfoot อยู่บนแถบโครมน้ำเงินลึก คนละโซนกับปุ่มบนการ์ดสว่างนี้
// **ห้ามลอกคลาสของ Navfoot มาวางบนการ์ด**
// ⚠️⚠️ **ห้ามสลับเป็นพื้นทองแล้วใส่ตัวอักษรขาว** ขั้วคือพื้นถมสว่าง-หมึกเข้ม
// ⚠️⚠️ **#fdcb0c #fefb6b #2cc3fc #6bdcfb #9ae0fa ห้ามถือตัวอักษรบนพื้นสว่าง**
// (1.5–2.4:1) เป็นสีพื้นถม/ขอบ/ออราเท่านั้น
// ออราในไฟล์นี้ใช้ rgba(253,203,12,α) · rgba(44,195,252,α) เท่านั้น
//
// ⚠️ กับดักรอบนี้คือ **ฟ้าและทองเคยผ่านรีโปนี้มาแล้วหลายเจ้า** (สบายเบท168 /
// นินจา168 / รวยแทร่168) "มีฟ้าหรือทองอยู่แล้ว" จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้
// ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive
// รอบนี้ **ไม่มีแดง ไม่มีเขียว (ยกเว้น LINE green ที่หน้าอื่น) ไม่มีชมพู
// ไม่มีม่วง ไม่มีส้ม ไม่มีโรสโกลด์ และไม่มีเงิน/โครเมียม**
//
// Announcement หมุนมาเป็น Announcement6 ทั้งเว็บรอบนี้ (brand-spec §3 — รอบก่อน
// ใช้ Announcement3 จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์
// นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare — ห้ามส่ง prop message
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) หน้านี้ยาว 158
// ด้วยชื่อแบรนด์ 7 ตัวอักษรของรอบนี้
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าเข้าสู่ระบบ ${BRAND_NAME} กดปุ่มเดียวเข้าบัญชีสมาชิก เพื่อตรวจสอบรายละเอียดเกมสล็อตเบทต่ำ ยอดเดิมพันขั้นต่ำ และเงื่อนไขโปรโมชั่นจากประกาศล่าสุดของเว็บไซต์ทางการ`;

const graph = pageGraph(Astro, {
  name: `เข้าสู่ระบบ ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`เข้าสู่ระบบ ${BRAND_NAME} เข้าบัญชีสมาชิกเพื่อดูรายละเอียดเกมสล็อตและโปรโมชั่น`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`เข้าสู่ระบบ ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border-2 border-[#fdcb0c] bg-gradient-to-b from-[#fefb6b] to-[#fdcb0c] px-6 py-4 text-2xl font-bold tracking-wide text-[#2a1f02] shadow-[0_10px_30px_rgba(253,203,12,0.35)] transition-all duration-300 hover:scale-105 hover:border-[#2cc3fc] hover:shadow-[0_15px_40px_rgba(253,203,12,0.5)]">
        <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#fefb6b]/60 to-transparent"></span>
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
