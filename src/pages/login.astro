---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — this page is indexed and must not
// describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// The button is the SECONDARY of the pair on the FAH999 palette: purple card
// surface (#2a0a4d) inside a primary-gold outline (#fbbf13) over body ink
// (#ecdcff), lifting to highlight gold (#ffdf6b) on a brighter purple (#331058)
// on hover, while /register wears the full gold-gradient fill. The tier is
// carried by the brightness of the fill, not by a second hue.
//
// Announcement รอบนี้หมุนมาใช้ Announcement3 ทั้งเว็บ — default message ของไฟล์
// นั้นเป็นคอปปี้ของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ไม่ต้องส่ง prop
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 158
const pageDescription = "หน้าเข้าสู่ระบบ FAH999 กดปุ่มเดียวเข้าบัญชีสมาชิกเพื่อเล่นสล็อตออโต้เว็บตรงจากหลายค่าย ตรวจสอบสิทธิ์โปรโมชั่น สถานะฝากถอน และรายละเอียดของเกมได้จากบัญชีตัวเอง";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ FAH999",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="เข้าสู่ระบบ FAH999 ล็อกอินเข้าบัญชีสมาชิก เล่นสล็อตออโต้เว็บตรงทุกค่าย" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ FAH999" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ FAH999"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fbbf13] bg-[#2a0a4d] px-6 py-4 text-lg font-black text-[#ecdcff] shadow-[0_10px_30px_rgba(124,47,212,0.32)] transition-all duration-300 hover:scale-105 hover:border-[#ffdf6b] hover:bg-[#331058] hover:text-[#ffdf6b] hover:shadow-[0_15px_40px_rgba(251,191,19,0.36)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
