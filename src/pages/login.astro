---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// GOT777 (รอบทอง-แดง-ดำ 2026-09-29): ปุ่มนี้เป็นตัว SECONDARY ของคู่ จึงเป็นแบบ
// OUTLINE — ผิวปุ่มรอง #241108 ในกรอบแดงรอง #d21622 บนตัวอักษรทองอ่อน #ffe9a8
// แล้วยกผิวขึ้นเป็นแดงเข้มสุด #4c0301 ตอน hover ส่วน /register สวมไล่เฉดทองเต็มใบ
// (#ffe9a8 → #f5c518 → #96690f) ลำดับความสำคัญรอบนี้สื่อด้วย "ถมทอง vs กรอบแดง"
// ซึ่งใช้ทั้งสองสีของแบรนด์พอดี — สองปุ่มที่ถมทองเหมือนกันจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม
// กฎคอนทราสต์ brand-spec §2: พื้นทอง = หมึกเข้ม #0a0503 · พื้นเข้ม = ตัวอักษรทองอ่อน
// #ffe9a8 · ห้ามตัวอักษรขาวบนพื้นทอง
// ชุดแดง-ทองของ LOTTOPLUS (#dc020e #ff2d38 #6b0207 #f3c623 #fde79a #8a6a0a #f0e2e2
// #fff4f4 #2a0d0f #3a1114 rgba(220,2,14,*) rgba(243,198,35,*) rgba(5,1,2,*))
// ออกครบแล้ว ห้ามนำกลับมา
//
// Announcement หมุนมาเป็น Announcement3 ทั้งเว็บรอบนี้ — default message ของไฟล์
// นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ index ก็เรียกแบบ bare
//
// GOT777 เป็นเว็บเกมสล็อตออนไลน์ ไม่ใช่เว็บหวย — บรีฟพูดถึงเกมสล็อตจากแพลตฟอร์ม
// ค่ายใหญ่ สล็อตคลาสสิก สล็อตธีมเอเชีย เกมผจญภัย วงล้อ ฟรีสปิน ตัวคูณ เกมโบนัส
// แจ็กพอต เครดิต ประวัติรายการ โบนัสคืนยอดเสีย 0.3% โบนัสแนะนำเพื่อน 0.8%
// และแอดมิน 24 ชม. เท่านั้น คำศัพท์ตระกูลหวยของแบรนด์ก่อน (หวย โพย แทงหวย ส่งโพย
// งวด รอบออกรางวัล เลขเด็ด อัตราจ่าย 2 ตัว 3 ตัว รัฐบาลไทย ลาวพัฒนา ฮานอย หวยหุ้น)
// ห้ามหลงเหลือ
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 155
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = "หน้าเข้าสู่ระบบ GOT777 กดปุ่มเดียวเข้าบัญชีสมาชิกเพื่อเลือกเกมสล็อตจากค่ายที่เปิดให้บริการ ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการ ผ่านเบราว์เซอร์บนมือถือ";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ GOT777",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="เข้าสู่ระบบ GOT777 ล็อกอินเข้าบัญชีสมาชิก เลือกเกมสล็อตได้ทุกค่าย" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ GOT777" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ GOT777"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#d21622] bg-[#241108] px-6 py-4 text-lg font-black text-[#ffe9a8] shadow-[0_10px_30px_rgba(10,5,3,0.85)] transition-all duration-300 hover:scale-105 hover:border-[#f5c518] hover:bg-[#4c0301] hover:text-[#fff6dd] hover:shadow-[0_15px_40px_rgba(210,22,34,0.35)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
