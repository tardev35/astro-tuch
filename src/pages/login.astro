---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change.
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page, which means verify-build holds its
// description to the same 150–160 character window as every other page.
//
// ⚠️ แบรนด์รอบนี้ (สบายเบท168) เป็น **เว็บสล็อตล้วน** ที่เรียกตัวเองว่า
// "เว็บสล็อตทางการ ผู้ให้บริการฐานเกมหลัก" ตามบรีฟ — ไม่มีหมวดคาสิโน ไม่มีกีฬา
// และไม่ใช่เว็บหวย
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES เลย คอปปี้ของหน้านี้จึง
// อนุมานจากบรรทัด 4 และ 6 ซึ่งพูดถึงการเข้าใช้งานเกมสล็อตออนไลน์ เมนูจัดการบัญชี
// สมาชิก การตรวจสอบรายการฝากถอน และการดูโปรโมชั่นตามเงื่อนไขบริการ เท่านั้น
// — คำที่ห้ามหลุดกลับมาอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep
// หาคำต้องห้ามเจอ false positive · สองแบรนด์ก่อนหน้าขายตัวเองด้วยวลีที่บรีฟรอบนี้
// ไม่มีเลยสักคำ จึงต้องเขียนใหม่จากบรีฟ ไม่ใช่ find-and-replace ทับของเดิม
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกมแม้แต่ค่ายเดียว** จึงห้ามเขียนชื่อค่ายใดๆ
// ให้ใช้คำกลางว่า "ค่ายเกม" ตามบรีฟ
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 100% · 3 ขั้นตอน · 24ชม. ·
// อันดับ1 ห้ามแต่งใบอนุญาต หน่วยงานกำกับ ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP
// ยอดขั้นต่ำ จำนวนสมาชิก หรือปีใดๆ (บรีฟรอบนี้ไม่ได้เอ่ยปีไว้เลย)
// หัวข้อสมัคร 3 ขั้นตอน กับแอดมิน LINE ของบรีฟ (บรรทัด 13-22) เป็นของ
// index.astro ไม่ใช่ของหน้านี้ ห้ามยกมาเขียนซ้ำที่นี่
//
// พาเลตต์รอบนี้อยู่ใน .claude/brand-spec-sabuybet168.md §2 — **ฟ้าบับเบิลนำ
// ทองเป็นฮิวที่สอง น้ำเงินลึกไม่เคยถือตัวอักษร บนพื้นดำสนิท** (bg.json =
// {"mode":"color","color":"#000000"}) โลโก้คือ **แมวการ์ตูนขนขาวลายส้ม** ใส่
// ปลอกคอฟ้ามีกระดิ่งทอง นั่งคู่กับมือถือจอฟ้าและปึกแบงก์สีฟ้า เหนือคำว่า "สบาย"
// ตัวอักษรไทยหนาสามมิติ **สีทอง** ต่อด้วย "เบท168" สามมิติ **สีฟ้าบับเบิล**
// ฟ้าแบรนด์ #2f9ff5 · ฟ้าอ่อน #a8dcff · ทอง #ffc82e (11.3:1 บนผิวการ์ด) ·
// เนื้อความ #e8f4ff (= BRAND_TEXT) · หมึกบนพื้นถมฟ้า/ทอง #04121f
// ชั้นผิว: ยก #0e2238 (= การ์ด ContentBox) / กลาง #081726 / จม #040d16
// ปุ่มนี้เป็นคู่ SECONDARY: จมลงจากการ์ดด้วยชั้น #081726 → #040d16 ขอบ **ทอง**
// #ffc82e/55 บนตัวอักษร **ทอง** #ffc82e — hover ยกขอบเป็น #ffc82e เต็ม
// ส่วน /register เป็น PRIMARY ถมพื้น **ฟ้า** จึงไม่ซ้ำกัน
// ⚠️ ห้ามใช้ผิวยก #0e2238 เป็นพื้นปุ่ม มันเป็นสีเดียวกับการ์ดที่ปุ่มวางอยู่
// ⚠️ #0b3f78 (น้ำเงินลึก) และ #5c4a16 (ทองลึก) ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่
// เส้นขอบ ออรา พื้นถม และเงา — ออราในไฟล์นี้ใช้ rgba(255,200,46,α) เท่านั้น
// นอกจากเงาดำล้วน
// ⚠️ กับดักรอบนี้คือ **ทอง** เพราะห้ารอบหลังสุดมีทองเป็นฮิวนำหรือฮิวรองทุกรอบ
// "มีทองอยู่แล้ว" จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้ ทองรอบนี้คือ #ffc82e
// (255,200,46) และ **ฟ้าก็เป็นกับดักได้** เพราะมีแบรนด์เก่าในรีโปที่เคยเป็นฟ้า
// ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive
// และรอบนี้ **ไม่มีชมพู ไม่มีแดง ไม่มีม่วง ไม่มีเขียว ไม่มีส้ม ไม่มีเงิน/โครเมียม
// ไม่มีโรสโกลด์**
//
// Announcement หมุนมาเป็น Announcement2 ทั้งเว็บรอบนี้ (brand-spec §3 —
// รอบก่อนใช้ Announcement6 จึงหมุนออก) orchestrator ตั้ง default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare — ห้ามส่ง prop message
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) หน้านี้ยาว 153
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าเข้าสู่ระบบ ${BRAND_NAME} เว็บสล็อตทางการ กดปุ่มเดียวไปยังช่องทางเข้าเล่นเกมสล็อตออนไลน์ ตรวจสอบรายการฝากถอน และดูโปรโมชั่นตามเงื่อนไขบริการที่ประกาศไว้`;

const graph = pageGraph(Astro, {
  name: `เข้าสู่ระบบ ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`เข้าสู่ระบบ ${BRAND_NAME} เว็บสล็อตทางการ ผู้ให้บริการฐานเกมหลัก`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`เข้าสู่ระบบ ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ffc82e]/55 bg-gradient-to-b from-[#081726] to-[#040d16] px-6 py-4 text-2xl font-bold tracking-wide text-[#ffc82e] shadow-[0_10px_30px_rgba(0,0,0,0.55)] transition-all duration-300 hover:scale-105 hover:border-[#ffc82e] hover:shadow-[0_15px_40px_rgba(255,200,46,0.45)]">
        <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ffc82e]/20 to-transparent"></div>
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
