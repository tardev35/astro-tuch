---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — this page is indexed and must not
// describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// The button is the SECONDARY of the pair on the MHEEPOOH168 palette: inner
// panel surface (#2b0101) with a mid-gold outline (#f5b70a) over cream body ink
// (#f1dccd), brightening to gold-bright (#fced74) on hover, while /register
// wears the solid red fill.
//
// Announcement รอบนี้หมุนมาใช้ AnnouncementPremium ทั้งเว็บ — default message
// ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ไม่ต้องส่ง prop
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char).
const pageDescription = "หน้าเข้าสู่ระบบ MHEEPOOH168 กดปุ่มเดียวเข้าบัญชีสมาชิก เลือกเล่นบาคาร่า สล็อต หวย และบอลได้จากบัญชีเดียว พร้อมตรวจสอบสถานะรายการและสิทธิ์โปรโมชั่นด้วยตนเอง";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ MHEEPOOH168",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="เข้าสู่ระบบ MHEEPOOH168 ล็อกอินเข้าบัญชีสมาชิก เล่นได้ครบทุกหมวดเกม" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ MHEEPOOH168" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ MHEEPOOH168"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f5b70a] bg-[#2b0101] px-6 py-4 text-lg font-black text-[#f1dccd] shadow-[0_10px_30px_rgba(245,183,10,0.22)] transition-all duration-300 hover:scale-105 hover:border-[#fced74] hover:bg-[#120303] hover:text-[#fced74] hover:shadow-[0_15px_40px_rgba(252,237,116,0.36)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
