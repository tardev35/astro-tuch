---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect. The title and
// description below are written for exactly that reason.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// หวยคิง (รอบทองโลหะ + ครีมอมพีช บนดำอมน้ำตาล 2026-10-04, brand-spec §2 — ครีมอมพีช
// #fcd4c3 / #fce2d4 มาจากชุดขาวของนางแบบใน slide1/slide2 และมาแทน "เงินโครเมียม"
// ของ UP555 รอบก่อน ห้ามใช้โทนเงินอีก):
// ปุ่มนี้เป็นตัว SECONDARY ของคู่ จึงเป็นแบบ outline — พื้นลึกสุด #0c0b0a ในกรอบ
// ครีมอมพีช #fcd4c3/60 บนตัวอักษรครีมอ่อน #fce2d4 แล้วยกกรอบเป็นครีมเต็ม #fce2d4
// ตอน hover ส่วน /register สวมไล่เฉดทองเต็มใบ (#fdeb7c → #cd9a2c → #ab7314) บน
// ตัวอักษรดำอมน้ำตาล #120a02
// ลำดับความสำคัญรอบนี้จึงสื่อด้วย "ทองถม vs ครีมกรอบ" ไม่ใช่ถมทองสองใบซึ่งจะอ่าน
// เป็นปุ่มซ้ำกันสองปุ่ม — และคู่ทอง/ครีมนี้คือสองโทนที่อยู่บนอาร์ตเวิร์กจริง
// กฎคอนทราสต์: พื้นทองสว่าง = หมึก **ดำอมน้ำตาล #120a02** เสมอ (หมึกขาวบน #fdeb7c
// ตก) · พื้นเข้ม #0c0b0a / #1c140b = ตัวอักษรครีม #fce2d4 หรือเนื้อความ #f5e7c8
// ชุดทอง + เงินโครเมียมของ UP555 (#ebbb54 #fce675 #ab6d24 #d5d4d3 #f3f3f2 #130b03
// #241705 #0c0502 #160d02 #f8eed9 rgba(235,187,84,*) rgba(12,5,2,*)
// rgba(213,212,211,*)) ออกครบแล้ว ห้ามนำกลับมา
//
// Announcement หมุนมาเป็น AnnouncementHuay ทั้งเว็บรอบนี้ (รอบก่อน UP555 เป็น
// Announcement5) — default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ
// index ก็เรียกแบบ bare จึงห้ามส่ง prop message
//
// หวยคิง เป็น **เว็บรับแทงหวยล้วน** ไม่ใช่คาสิโน บรีฟระบุว่าหลัง Login สมาชิกเลือก
// รายการหวยและรอบ กรอกเลขกับยอดที่ต้องการ แล้วตรวจสอบเลข ยอดแทง อัตราจ่าย วงเงิน
// รับแทง และสถานะโพยได้ก่อนยืนยัน พร้อมดูเครดิตและประวัติโพยจากบัญชีของตนเอง
// ตัวเลขที่ใช้ได้มีแค่ 100 / 1,000 / 2 ตัว / 3 ตัว / 3 ขั้นตอน / 24 ชั่วโมง
// ห้ามแต่งตัวเลขอื่นขึ้นมาเอง และห้ามเอ่ยชื่อตลาดหวย เวลาเปิด-ปิดรับ ชื่อธนาคาร
// ยอดฝากขั้นต่ำ หรือเลขใบอนุญาต ที่บรีฟไม่ได้ระบุ
// คำคาสิโนของแบรนด์ก่อนหน้า (สล็อต บาคาร่า บอล เดิมพันฟุตบอล ค่ายเกม คาสิโนสด
// หมวดเกม RTP ความผันผวน ทางเข้าเล่นใหม่ ระบบอัปเกรด คืนยอดเสีย 0.3% แนะนำเพื่อน
// 0.8%) ห้ามหลงเหลือ
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 154
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าเข้าสู่ระบบ ${BRAND_NAME} กดปุ่มเดียวเข้าบัญชีสมาชิกเพื่อเลือกรายการหวยและรอบ กรอกเลข ตรวจอัตราจ่าย วงเงินรับแทง เครดิต และประวัติโพยก่อนยืนยันส่งโพยทุกครั้ง`;

const graph = pageGraph(Astro, {
  name: `เข้าสู่ระบบ ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`เข้าสู่ระบบ ${BRAND_NAME} ล็อกอินเข้าบัญชีสมาชิก เลือกรายการหวยส่งโพยได้ทันที`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`เข้าสู่ระบบ ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fcd4c3]/60 bg-[#0c0b0a] px-6 py-4 text-lg font-black text-[#fce2d4] shadow-[0_10px_30px_rgba(12,11,10,0.75)] transition-all duration-300 hover:scale-105 hover:border-[#fce2d4] hover:bg-[#1c140b] hover:shadow-[0_15px_40px_rgba(252,212,195,0.3)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
