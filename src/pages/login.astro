---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
//
// MAHAGAME66 (รอบแดง-ดำ-เงินโครเมียม 2026-09-24): ปุ่มนี้เป็นตัว SECONDARY ของคู่ —
// ผิวการ์ดยก #26100f ในกรอบแดงแบรนด์ #de161d บนเนื้อความ #e8e3e1 แล้วยกเป็นแดงลึก
// #7a0a0e กับขอบเงินโครเมียม #e2e8ef ตอน hover ส่วน /register สวมไล่เฉดแดงเต็มใบ
// ลำดับความสำคัญถูกสื่อด้วย "สีไหนถมเต็มปุ่ม" ไม่ใช่ความสว่าง ตามคู่สีในโลโก้ที่
// MAHA/66 เป็นเงิน-ดำ และ GAME เป็นแดง
// ชุดทอง-เขียวของ 888PARUAY (#fcdc2b #fff6ae #a87d0c #0d2312 #143a1c #07130a
// #e8e4c6 #fffdf0) ออกครบแล้ว ห้ามนำกลับมา
//
// Announcement รอบนี้หมุนจาก Announcement3 มาเป็น Announcement5 ทั้งเว็บ —
// default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ index ก็เรียกแบบ bare
// จึงห้ามส่ง prop
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 154
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = "หน้าเข้าสู่ระบบ MAHAGAME66 กดปุ่มเดียวเข้าบัญชีสมาชิกเพื่อเลือกบาคาร่า สล็อต หวย บอล รูเล็ต และเกมไลฟ์สด พร้อมตรวจสอบยอดและสถานะรายการฝากถอนผ่านบัญชีเดียว";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ MAHAGAME66",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="เข้าสู่ระบบ MAHAGAME66 ล็อกอินเข้าบัญชีสมาชิก เลือกเกมที่ต้องการได้ทันที" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ MAHAGAME66" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ MAHAGAME66"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#de161d] bg-[#26100f] px-6 py-4 text-lg font-black text-[#e8e3e1] shadow-[0_10px_30px_rgba(8,5,6,0.80)] transition-all duration-300 hover:scale-105 hover:border-[#e2e8ef] hover:bg-[#7a0a0e] hover:text-[#fff6f5] hover:shadow-[0_15px_40px_rgba(222,22,29,0.45)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
