---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// ⚠️ This page is NOT one of the "full custom HTML + own <style> block"
// standalone pages SKILL.md Phase 4.5 warns about — it renders through
// MainLayout + ContentBox like every other sub-page, so it has no .brand-identity
// string and no raw-hex <style> block of its own. The only brand colours here
// are the Tailwind arbitrary values on the button below. Do not "restore" a
// <style> block; the font link and <html> colour come from MainLayout.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change (CtaRedirect.astro
// itself belongs to the orchestrator — ห้ามแก้ไฟล์นั้นจากหน้านี้)
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page (no `robots` prop = indexable), which means
// verify-build holds its description to the same 150–160 character window as
// every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) **ไม่มีส่วน SUB-PAGES** → title/description
// ของหน้านี้เขียนเอง และพูดได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 4: เกมเดิมพันออนไลน์
// หลากหลายประเภท พร้อมรายละเอียดระบบสมาชิก · บรรทัด 16: ตรวจสอบที่อยู่เว็บไซต์
// ให้ถูกต้อง · บรรทัด 18 และ 22: ไม่เปิดเผยรหัสผ่านและรหัส OTP ให้ใครทราบ)
// ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า — หน้านี้มีโควตาเป็น **ปุ่มเดียว**
//
// 🚨 แกนของแบรนด์รอบนี้คือ **เว็บเกมพนัน/คาสิโนออนไลน์** **กลับทิศจากหมวดของ
// แบรนด์ขาออก** — คอปปี้เก่าของหน้านี้พูดถึงหมวดที่ไม่ใช่แบรนด์นี้แล้ว เขียนใหม่ทั้งคู่
// ⚠️ น้ำเสียงของบรีฟรอบนี้คือ "โฆษณาและกำกับในประโยคเดียวกัน" ไม่ใช่การันตี
// คลังคำที่ใช้ได้รอบนี้อยู่ใน .claude/brand-spec-teva69.md §5 (ไม่พิมพ์ซ้ำ
// ที่นี่ และ **ไม่พิมพ์คำของแบรนด์เก่าซ้ำที่นี่** เพื่อไม่ให้ sweep ของรอบถัดไป
// เจอ false positive ในคอมเมนต์ของไฟล์นี้เอง)
// ตัวเลขที่อ้างได้รอบนี้มีแค่ 0.3% · 0.8% · 3 ขั้นตอน · 24ชม. — ห้ามแต่ง
// ใบอนุญาต จำนวนสมาชิก ปีก่อตั้ง จำนวนค่าย/เกม หรือค่าร้อยละอื่นใด
// 🚨🚨 **บรีฟรอบนี้ไม่พูดถึงธนาคาร วอลเลท หรือการฝากถอนเลยแม้แต่คำเดียว** —
// ห้ามเขียนถึงรายการฝากถอน ชื่อวอลเล็ต หรือชื่อค่ายเกมบนหน้านี้
// (ค่าร้อยละสองค่าของโปรโมชั่นเป็นเนื้อหาของ index กับ /promotion ไม่ใช่ของหน้านี้)
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตรอบนี้อยู่ใน .claude/brand-spec-teva69.md §2 — **เนื้อหาสว่าง โครมเข้ม**
// (ทิศเดียวกับรอบก่อน แต่คนละตระกูลสีทั้งชุด)
// bg.json = {"mode":"color","color":"#f0ffeb"} = **ขาวอมมิ้นต์จาง**
// (รอบก่อนเป็นขาวอมชมพูจาง — ค่ามาจากไฟล์ ห้ามเดาว่าเท่าเดิม และห้าม "แก้"
// การ์ดให้มืดตามโครม)
// การ์ด ContentBox จึงเป็นผิว #ffffff บนหมึก #10280f (= BRAND_TEXT, 15.8:1)
// ปุ่มนี้เป็นคู่ **รอง (secondary)** ของพาเลต: ไล่เฉดขาว #ffffff -> #e6f7df
// บนหมึกเขียวป่าจม #10280f (15.8 / 14.1:1 — ผ่านทั้งสอง stop)
// ส่วน /register เป็น **หลัก (primary)** ไล่เฉด #0b4a12 -> #116018 -> #1a7d24
// บนหมึกขาว จึงไม่ซ้ำกัน
// 🚨🚨 **ขาวบน 28c437 ได้ 2.3:1 บน e3bb45 ได้ 2.0:1 และบนพื้นเพจ f0ffeb
// ได้ 1.07:1** พื้นถมสว่างต้องคู่กับหมึกเข้มเสมอ และพื้นที่ถือหมึกขาวได้ต้องเข้ม
// ถึง **#1a7d24 (5.3:1) ลงไป** เท่านั้น ห้ามกลับด้านทั้งสองกรณี
// 🚨🚨 **f0ffeb / e6f7df / d7f0cd / b2dba3 / c6cfd2 / 28c437 / e3bb45
// ห้ามถือตัวอักษรบนผิวสว่าง** เป็นพื้นถม/ขอบ/ออราเท่านั้น และ 3f7a2e เป็น
// **เส้น/ขอบ** เท่านั้น · ที่ถือตัวอักษรได้บนผิวสว่างชุดนี้คือ #10280f (15.8:1) ·
// #3c5b36 (7.7:1) · #116018 (7.8:1) · #0b4a12 (10.5:1) · #1a7d24 (5.3:1) ·
// #8a6a0e (5.1:1)
// ⚠️⚠️ **0b2a12 15401d 051409 2d6b2f e8fbe4 b4d6ad เป็นค่าของผิวโครมเข้ม
// เท่านั้น ห้ามหลุดเข้ามาในไฟล์นี้**
// ⚠️ ปุ่มนี้ผิวขาวบนการ์ดขาว — **ขอบ #3f7a2e คือสิ่งเดียวที่แยกปุ่มออกจากการ์ด
// ห้ามถอดออก** และห้ามเปลี่ยนเป็นขอบจางกว่านี้
// ⚠️⚠️ **วัสดุของรอบนี้คือฉากห้องสีขาวครีม** อ่านจากอาร์ตเวิร์กตรงๆ: โลโก้เป็น
// เวิร์ดมาร์กสามมิติ ครึ่งแรกตัวอักษรละตินผิวโครเมียมเงินขัดเงา ครึ่งหลังตัวเลข
// ผิวเขียวมรกตเคลือบเงาเรืองแสง ตัดขอบดำหนา
// ⚠️⚠️ **หญิงสาวสวมสูทขาว ชิปคาสิโนเขียวเข้มสลับขาว มงกุฎทองดวงเล็ก และต้นไม้
// ในกระถางเป็นวัตถุในภาพ ไม่ใช่สี UI** — พื้นเพจมาจาก bg.json เท่านั้น
// ⚠️ ปุ่มของ Navfoot อยู่บนแถบโครม **ผิวเข้ม** คนละโซนกับปุ่มบนการ์ดสว่างนี้
// **ห้ามลอกคลาสของ Navfoot มาวางบนการ์ด**
// ออราในไฟล์นี้ใช้ rgba(17,96,24,α) · rgba(40,196,55,α) เท่านั้น
//
// ⚠️⚠️ กับดักรอบนี้คือ **เขียวเคยเป็นฮิวนำของแบรนด์เก่ามาแล้วหลายเจ้า และเขียว
// เป็นฮิวที่ตาแยกค่าได้ยากที่สุด** "มีเขียวอยู่แล้ว" จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้
// ให้เทียบเป็น **"ค่า" ทีละหลัก** กับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive
// **ผิว/หมึกของรอบนี้คือ #f0ffeb / #ffffff / #e6f7df / #d7f0cd / #b2dba3 /
// #3f7a2e / #10280f / #3c5b36 / #116018 / #0b4a12 / #1a7d24 / #8a6a0e
// เท่านั้น** (และโครมเข้ม 0b2a12 / 15401d / 051409 / 2d6b2f / e8fbe4 / b4d6ad /
// c6cfd2 / e3bb45 / 28c437 ซึ่งอยู่ในไฟล์โครม ไม่ใช่ไฟล์นี้)
// รอบนี้ **ไม่มีม่วง ไม่มีฟ้า/ไซแอน ไม่มีแมเจนต้า/ชมพู ไม่มีส้มเพลิง และไม่มีแดง
// เป็นสี UI** เลยสักเฉด · ปุ่ม LINE (#00B900) อยู่บน /about-us กับ /contact-us
// ไม่ใช่หน้านี้
//
// Announcement หมุนมาเป็นตัวท้ายชื่อ Premium ของตระกูล ทั้งเว็บรอบนี้ (brand-spec §3 —
// รอบก่อนใช้ตัวท้ายชื่อ Huay จึงหมุนออก · เขียนชื่อไฟล์แบบไม่มีเครื่องหมายคำพูด
// โดยตั้งใจ เพราะ tools/gen-tw-sources.mjs นับ literal ที่มีเครื่องหมายคำพูดว่าเป็น
// การ import จริง คอมเมนต์จึงทำให้ variant เก่าหลุดเข้า Tailwind scan แล้วสีของ
// แบรนด์ก่อนขึ้น stylesheet) orchestrator เป็นเจ้าของ default message ของไฟล์นั้น
// จึงเรียกแบบ bare — **ห้ามส่ง prop message**
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) สตริงนี้ยาว 157
// ด้วยชื่อแบรนด์ 6 อักขระของรอบนี้ ส่วนที่ไม่ใช่ชื่อแบรนด์ยาว 151 → รับชื่อแบรนด์
// ได้ 1–9 อักขระ ถ้ารอบหน้าชื่อยาวกว่านั้นต้องแก้ข้อความ ไม่ใช่ปล่อยผ่าน
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าเข้าสู่ระบบ ${BRAND_NAME} เว็บเกมเดิมพันออนไลน์ กดปุ่มเดียวไปยังหน้าเข้าบัญชีสมาชิก ควรตรวจสอบที่อยู่เว็บไซต์ทางการ และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้ผู้อื่น`;

const graph = pageGraph(Astro, {
  name: `เข้าสู่ระบบ ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/hx8w";
---

<MainLayout title={`เข้าสู่ระบบ ${BRAND_NAME} เว็บเกมเดิมพันออนไลน์ กดปุ่มเดียวเข้าบัญชีสมาชิก`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`เข้าสู่ระบบ ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="group mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 rounded-xl border-2 border-[#3f7a2e] bg-gradient-to-b from-[#ffffff] to-[#e6f7df] px-6 py-4 text-2xl font-bold tracking-wide text-[#10280f] shadow-[0_10px_30px_rgba(17,96,24,0.18)] transition-all duration-300 hover:scale-105 hover:border-[#116018] hover:shadow-[0_15px_40px_rgba(40,196,55,0.32)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
