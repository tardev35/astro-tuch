---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1×1, h2×0, h3×0. Never write an article here and never add an <h2>.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change.
//
// CtaRedirect.astro เป็น shared chrome ที่ orchestrator retheme ให้แล้วรอบนี้ —
// หน้านี้แค่ render มัน ห้ามแก้ไฟล์นั้นจากหน้านี้
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens. It is an indexed page now, which
// means verify-build holds its description to the same 150–160 character window
// as every other page.
//
// WEPLAY168 (รอบม่วงนีออน-ทองอาร์เขต 2026-10-09, brand-spec §2):
// ม่วงสด #a435f0 · ม่วงกลาง #7a1fc4 · ม่วงลึก #5b1a75 · ม่วงอ่อน #d2a6ff ·
// ทองสว่าง #fbe455 · ทองอุ่น #ffd23d · ทองเข้ม #c98a05 · ครีมลาเวนเดอร์ #efe6ff ·
// หมึกเข้ม #190633 · ผิวการ์ดยก #1e0a3c
// ปุ่มนี้เป็นคู่ SECONDARY เดียวกับ /ทางเข้า: ถมม่วงไล่เฉด #7a1fc4 → #5b1a75
// ขอบม่วงสด #a435f0/60 บนครีมลาเวนเดอร์ #efe6ff (≈6.2:1 บน #7a1fc4 และสูงกว่านั้น
// บน #5b1a75) hover ยกขอบเป็นม่วงสดเต็ม — ส่วน /register เป็น PRIMARY ถมทอง
// จึงไม่ซ้ำกัน
// ⚠️ พื้นถมทองต้องใช้หมึกเข้ม #190633 เสมอ ห้ามครีมหรือขาว และห้ามวางตัวอักษร
// สว่างบนม่วงสด #a435f0 เลย (#ece2ff บน #a435f0 = 3.1:1 สเปกระบุว่าต้องห้าม)
// ม่วงสดใช้ได้แค่เส้นขอบ ออรา และเงา
// ชุดแดงแล็กเกอร์-ทองของแบรนด์ก่อนออกครบแล้ว ทั้ง raw hex และ rgba()
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ และเรียกแบบ bare ทุกหน้า
// — ห้ามส่ง prop message จากหน้านี้
//
// แบรนด์นี้เป็นเว็บสล็อตออโต้ล้วน รอบนี้ไม่มีหมวดหวยเลย — รายการคำต้องห้ามเต็มอยู่
// ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep เจอ false positive
// ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 1 บาท / 0.3% / 0.8% / 24 ชั่วโมง
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) หน้านี้ยาว 154
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าเข้าสู่ระบบ ${BRAND_NAME} เล่นสล็อตออโต้ทุกค่าย กดปุ่มเดียวไปยังช่องทางหลัก เข้าใช้งานบัญชีเดียวเพื่อเลือกค่าย ค้นหาเกมสล็อต ตรวจสอบเครดิต และติดตามรายการ`;

const graph = pageGraph(Astro, {
  name: `เข้าสู่ระบบ ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`เข้าสู่ระบบ ${BRAND_NAME} เล่นสล็อตออโต้ทุกค่าย เข้าใช้งานบัญชีเดียวจากช่องทางหลัก`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`เข้าสู่ระบบ ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#a435f0]/60 bg-gradient-to-b from-[#7a1fc4] to-[#5b1a75] px-6 py-4 text-2xl font-bold tracking-wide text-[#efe6ff] shadow-[0_10px_30px_rgba(0,0,0,0.55)] transition-all duration-300 hover:scale-105 hover:border-[#a435f0] hover:shadow-[0_15px_40px_rgba(164,53,240,0.45)]">
        <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#a435f0]/25 to-transparent"></div>
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
