---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change (CtaRedirect.astro
// itself belongs to the orchestrator — ห้ามแก้ไฟล์นั้นจากหน้านี้)
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page, which means verify-build holds its
// description to the same 150–160 character window as every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES — คอปปี้ของหน้านี้จึงพูด
// ได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 4: ภายในเว็บไซต์มีรายละเอียดโปรโมชั่น ระบบฝากถอน
// และช่องทางติดต่อเจ้าหน้าที่ ควรตรวจสอบเงื่อนไขโบนัสไม่ต้องทำเทิร์นก่อนใช้งาน ·
// บรรทัด 8: ควรอ่านรายละเอียดล่าสุดให้ครบถ้วนก่อนเข้าร่วม · บรรทัด 16: ควรตรวจสอบ
// ช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง)
// ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า หน้านี้มีโควตาเป็นปุ่มเดียว
//
// ⚠️ แกนของบรีฟรอบนี้คือ **เว็บสล็อต** (เกมสล็อตสนุกสุดมันส์ · เว็บตรงแตกง่าย ·
// เบทต่ำ · ฝากรับโบนัสได้ทั้งวัน ไม่ต้องทำเทิร์น) คำนิยามตัวเองของแบรนด์ก่อนๆ
// ห้ามเหลือ (brand-spec §5) ศัพท์หมวดลอตเตอรีที่บรีฟไม่มีทุกคำก็เป็นของค้างที่ห้าม
// หลุดกลับมา รายการคำเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep
// ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// คำที่ใช้ได้รอบนี้: เกมสล็อตสนุกสุดมันส์ · เว็บตรงแตกง่าย · เบทต่ำ 1 บาท ·
// รวมค่ายดัง · ใช้ทุนเล่นน้อย · ถอนได้ไม่จำกัด · ฝากรับโบนัสได้ทั้งวัน ·
// ไม่ต้องทำเทิร์น · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · ฝากถอนทุกธนาคารและ
// ทรูมันนี่ · แอดมิน 24ชม. · สล็อตคลาสสิก · เกมโบนัส · เงื่อนไขโบนัส · เครดิต ·
// ยอดเสีย · ชื่อบัญชีปลายทาง · บัญชีแอบอ้าง · ธุรกรรม · หมายเลขรายการ · หลักฐาน ·
// สมัครสมาชิก · เข้าสู่ระบบ · เว็บไซต์ทางการ · ประกาศล่าสุด · รหัสผ่าน · รหัส OTP
// ⚠️ **สองหน้าของหมวดลอตเตอรีถูกปิดรอบนี้** (อยู่ใน src/pages-disabled/ เพราะ
// รอบนี้เป็นเว็บสล็อต) และหน้านี้มีโควตาเป็นปุ่มเดียว จึงไม่ลิงก์ไปที่อื่นเพิ่ม
// อยู่แล้ว
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกม ชื่อธนาคาร ชื่อวอลเล็ต หน่วยงานกำกับ
// หรือใบอนุญาต แม้แต่รายเดียว** (พูดถึง "ธนาคารและทรูมันนี่" แบบรวมๆ เท่านั้น)
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 1 บาท · 24ชม. **ไม่มีค่า RTP
// เป็นตัวเลข ไม่มีจำนวนเกม ไม่มีจำนวนค่าย ไม่มียอดฝากขั้นต่ำเป็นตัวเลขอื่น
// ไม่มีจำนวนขั้นตอนการสมัครเป็นตัวเลข และไม่มี 100%** ห้ามแต่งใบอนุญาต
// ตัวเลขการเงิน หรือจำนวน
// สมาชิก · หัวข้อช่องทางติดต่อแอดมินของบรีฟเป็นของ index.astro ไม่ใช่ของหน้านี้
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตต์รอบนี้อยู่ใน .claude/brand-spec-bohba168.md §2
// ⚠️⚠️ **รอบนี้ยังเป็นธีมสว่างเหมือนรอบก่อน แต่คนละฮิวสิ้นเชิง**
// bg.json = {"mode":"color","color":"#00bfff"} = **ฟ้าสกายอิ่มตัว**
// (รอบก่อนเป็นชมพูพาสเทล — ค่ามาจากไฟล์ ห้ามเดาว่าเท่าเดิม และห้าม "แก้" การ์ด
// ให้มืด) การ์ด ContentBox จึงเป็นผิว #ffffff บนหมึกเข้ม #06283f (= BRAND_TEXT)
// ปุ่มนี้เป็นคู่ **รอง (secondary)** ของพาเลต: ไล่เฉดขาว #ffffff -> #e4f6fb
// บนหมึก **น้ำเงินเข้ม #06283f** (15.2 / 14.0:1 — ผ่านทั้งสอง stop)
// ส่วน /register เป็น **หลัก (primary)** ไล่เฉดน้ำเงิน #1a6ea8 -> #0f5684 ->
// #06283f บนหมึกขาว จึงไม่ซ้ำกัน
// 🚨🚨 **ขาวบนฟ้าสกาย #12b4ef ได้แค่ 2.4:1 และบน #00bfff ได้ 2.1:1** พื้นถมสว่าง
// ต้องคู่กับหมึกเข้มเสมอ และพื้นฟ้าที่ถือหมึกขาวได้ต้องเข้มถึง #1a6ea8 (5.5:1)
// ลงไป ห้ามกลับด้านทั้งสองกรณี
// 🚨🚨 **#12b4ef / #00bfff / #b6e3f0 / #7fcbe8 / #4fb8ea ห้ามถือตัวอักษรบนผิว
// สว่างเอง** เป็นพื้นถม/ขอบ/ออราเท่านั้น · ที่ถือตัวอักษรได้บนผิวสว่างชุดนี้คือ
// #06283f (15.2:1) · #355f7d (6.8:1) · #0f5684 (7.8:1) · #1a6ea8 (5.5:1)
// ⚠️ ปุ่มนี้ผิวขาวบนการ์ดขาว — **ขอบ #4fb8ea คือสิ่งเดียวที่แยกปุ่มออกจากการ์ด
// ห้ามถอดออก** และห้ามเปลี่ยนเป็นขอบจางกว่านี้
// ⚠️⚠️ **วัสดุของรอบนี้คือบับเบิลเจลฟ้าสกายคู่ไฮไลต์ขาวหนา** อ่านจากอาร์ตเวิร์ก
// ตรงๆ: โลโก้เป็นหัวการ์ตูนผู้หญิงผมมวยสูงผูกโบว์ขาว ทำหน้าตกใจ สองมือแตะแก้ม
// คู่กับตัวอักษรบับเบิลสามมิติไล่เฉดฟ้าสกายเข้มลงหาฟ้าอ่อนเกือบขาว ตัดขอบขาวหนา
// ⚠️⚠️ **เสื้อคลุมถักฟ้าอ่อน เสื้อกล้ามขาว ฉากสตูดิโอขาว ดาวเหลือง เหรียญทอง
// และสีผิวนักแสดงเป็นวัตถุในภาพ ไม่ใช่สี UI** — พื้นเพจมาจาก bg.json เท่านั้น
// ⚠️ ปุ่มของ Navfoot อยู่บนแถบโครมคนละโซนกับปุ่มบนการ์ดนี้
// **ห้ามลอกคลาสของ Navfoot มาวางบนการ์ด**
// ออราในไฟล์นี้ใช้ rgba(15,86,132,α) · rgba(18,180,239,α) · rgba(6,40,63,α) ·
// rgba(182,227,240,α) · rgba(127,203,232,α) เท่านั้น
//
// ⚠️⚠️ กับดักรอบนี้คือ **ฟ้า** — รีโปนี้มีแบรนด์ฟ้า/น้ำเงินมาแล้วแปดเจ้า "มีฟ้า
// อยู่แล้ว" จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้ ให้เทียบเป็น "ค่า" ทีละหลักกับตาราง
// ใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ
// false positive · **ฟ้า/น้ำเงินของรอบนี้คือ #00bfff / #12b4ef / #b6e3f0 /
// #7fcbe8 / #4fb8ea / #2a87c4 / #1a6ea8 / #0f5684 / #0b4a73 / #06283f เท่านั้น**
// รอบนี้ **ไม่มีชมพู/แมเจนต้า/พลัม (ฮิวของแบรนด์ขาออกทันที) ไม่มีทอง ไม่มีเหลือง
// ไม่มีส้ม ไม่มีเขียว (ยกเว้น LINE green ที่หน้าอื่น) ไม่มีแดง ไม่มีม่วง
// ไม่มีน้ำตาล ไม่มีครีม และไม่มีโครเมียมเงินเย็น** การปล่อยชมพูไว้ = ทั้งผิด
// พาเลตและหลงเหลือข้ามแบรนด์พร้อมกัน
//
// Announcement หมุนมาเป็น `Announcement.astro` (ตัวฐาน) ทั้งเว็บรอบนี้
// (brand-spec §3 — รอบก่อนใช้ Announcement4 จึงหมุนออก) orchestrator ตั้ง default
// message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare — ห้ามส่ง
// prop message
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) สตริงนี้ยาว 155
// ด้วยชื่อแบรนด์ 10 อักขระของรอบนี้ — ถ้ารอบหน้าชื่อยาวกว่านี้มากต้องตัดข้อความ
// ไม่ใช่ปล่อยผ่าน
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าเข้าสู่ระบบ ${BRAND_NAME} กดปุ่มเดียวเพื่อเข้าบัญชีสมาชิก ดูเงื่อนไขโบนัสไม่ต้องทำเทิร์น รายการคืนยอดเสีย และรายการฝากถอน ควรอ่านประกาศล่าสุดจากเว็บทางการ`;

const graph = pageGraph(Astro, {
  name: `เข้าสู่ระบบ ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`เข้าสู่ระบบ ${BRAND_NAME} กดปุ่มเดียวเข้าบัญชีสมาชิกเว็บหลัก`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`เข้าสู่ระบบ ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="group mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 rounded-xl border-2 border-[#4fb8ea] bg-gradient-to-b from-[#ffffff] to-[#e4f6fb] px-6 py-4 text-2xl font-bold tracking-wide text-[#06283f] shadow-[0_10px_30px_rgba(15,86,132,0.2)] transition-all duration-300 hover:scale-105 hover:border-[#12b4ef] hover:shadow-[0_15px_40px_rgba(18,180,239,0.35)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
