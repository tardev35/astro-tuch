---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — this page is indexed and must not
// describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// The button is the SECONDARY of the pair on the UFAGOOL palette: card surface
// (#16100f) inside a brand-red outline (#c50d12) over body ink (#cdd5dd),
// lifting to chrome silver (#f4f7fa) on the raised surface (#241a1a) on hover,
// while /register wears the full crimson-gradient fill of the logo's "UFA".
// The tier is carried by which of the two brand hues fills the button, not by
// brightness.
//
// Announcement รอบนี้หมุนมาใช้ Announcement3 ทั้งเว็บ — default message ของไฟล์นั้น
// ถูกตั้งเป็นคอปปี้ของแบรนด์นี้แล้ว และ index ก็เรียกแบบ bare จึงห้ามส่ง prop
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 156
const pageDescription = "หน้าเข้าสู่ระบบ UFAGOOL กดปุ่มเดียวเข้าบัญชีสมาชิกเพื่อเลือกหมวดเกมที่ต้องการ ทั้งกีฬา คาสิโนสด สล็อต และเกมออนไลน์ประเภทอื่น พร้อมดูโปรโมชั่นของรอบปัจจุบัน";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ UFAGOOL",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="เข้าสู่ระบบ UFAGOOL ล็อกอินเข้าบัญชีสมาชิก เลือกหมวดเกมที่ต้องการ" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ UFAGOOL" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ UFAGOOL"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#c50d12] bg-[#16100f] px-6 py-4 text-lg font-black text-[#cdd5dd] shadow-[0_10px_30px_rgba(10,7,8,0.7)] transition-all duration-300 hover:scale-105 hover:border-[#ef1f25] hover:bg-[#241a1a] hover:text-[#f4f7fa] hover:shadow-[0_15px_40px_rgba(197,13,18,0.45)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
