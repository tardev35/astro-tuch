---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect. The title and
// description below are written for exactly that reason.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// BOOM369 (รอบนีออนเขียวบนพื้นดำ 2026-10-07, brand-spec §2 — เขียวนีออน #42fb5a
// มาจาก vivid ของ logo.webp ที่ตัวอักษร BOOM เป็นเขียวนีออน ส่วนเขียวแบรนด์
// #04ab3a กับเขียวลึก #036b26 มาจากวงแหวนที่ไล่เขียว→เทียลในโลโก้เดียวกัน
// รอบก่อน (HI59) เป็นฟ้าสว่าง+ทองบนการ์ดสว่าง รอบนี้พลิกทั้งขั้วความสว่าง เพราะ
// อาร์ตเวิร์กทั้งดรอปเป็นโถงเกือบดำที่สว่างด้วยนีออนเขียว และ bg.json เป็น #000000):
// ปุ่มนี้เป็นตัว SECONDARY ของคู่ จึงถม **ผิวการ์ดเข้ม** #0b231b → #041109
// ขอบเขียวนีออน #42fb5a/60 บนหมึก #cfe9d7 แล้ว hover ยกขอบเป็นนีออนเต็ม
// ส่วน /register ถม **เขียวนีออน** เต็มใบ (#42fb5a → #04ab3a → #036b26) บนหมึก
// #03150a ลำดับความสำคัญรอบนี้จึงสื่อด้วย "นีออนถม vs ผิวเข้มขอบนีออน" ไม่ใช่ถม
// สีเดียวกันสองใบซึ่งจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม ตรงกับคู่ปุ่มของ NavbarCyber กับ
// FooterCyber ที่ orchestrator รีธีมไว้แล้ว
// กฎคอนทราสต์ของสเปก: พื้น #42fb5a = หมึก **#03150a** เสมอ ห้ามขาว/ครีม ·
// ห้ามวางตัวอักษรสว่างบนพื้น #04ab3a (3.1:1 ตก AA) — #04ab3a เป็นสต็อปไล่เฉด/ขอบ
// ชุดฟ้า+ทองของ HI59 (#0a84e0 #065a9c #044b80 #033f70 #5ec2ff #9ecbf2 #f6fbff
// #eaf5ff #0d2744 #04203f #fdbc04 #ffe27a #c88a02 #8a6102 rgba(3,63,112,*)
// rgba(94,194,255,*) rgba(10,132,224,*)) ออกครบแล้ว ห้ามนำกลับมา
//
// Announcement หมุนมาเป็น AnnouncementCyber ทั้งเว็บรอบนี้ (รอบก่อนเป็น
// Announcement2) — default message ของไฟล์นั้นเป็นคอปปี้ของ BOOM369 แล้ว และ
// index ก็เรียกแบบ bare จึงห้ามส่ง prop message
//
// BOOM369 เป็น **เว็บสล็อต** ไม่ใช่เว็บหวย — คำหมวดหวย (หวย ส่งโพย โพย เลขเด็ด
// แนวทาง อัตราจ่าย งวด ผลรางวัล) ห้ามหลงเหลือ และคำของแบรนด์ก่อน (ไฮคลาส VIP
// ส่งตรงจากเว็บแม่ ค่ายเกมพรีเมียม ไม่ผ่านบัญชีม้า) ก็ห้ามหลงเหลือเช่นกัน
// บรีฟบรรทัด 9 กับ 16 ระบุว่าหลัง Login สมาชิกตรวจสอบโปรโมชั่น ยอดคำนวณ สถานะ
// การรับสิทธิ์ เครดิต และประวัติรายการได้จากบัญชีเดียว พร้อมค้นหาเกมสล็อตเอง
// ตัวเลขที่ใช้ได้มีแค่ของบรีฟเอง: 0.3% / 0.8% / 100% / 24 ชั่วโมง / 3 ขั้นตอน
// ห้ามแต่งชื่อค่ายเกม ชื่อธนาคาร ยอดฝากขั้นต่ำ เลขใบอนุญาต หรือจำนวนสมาชิก
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 157
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าเข้าสู่ระบบ ${BRAND_NAME} กดปุ่มเดียวเข้าบัญชีสมาชิก เพื่อเลือกค่ายเกมสล็อตเบทต่ำ ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการจากบัญชีเดียวทั้งมือถือและคอมพิวเตอร์`;

const graph = pageGraph(Astro, {
  name: `เข้าสู่ระบบ ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`เข้าสู่ระบบ ${BRAND_NAME} ล็อกอินเข้าบัญชีสมาชิก เล่นสล็อตเบทต่ำค่ายตรงได้ทันที`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`เข้าสู่ระบบ ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#42fb5a]/60 bg-gradient-to-b from-[#0b231b] to-[#041109] px-6 py-4 text-lg font-black text-[#cfe9d7] shadow-[0_0_12px_rgba(66,251,90,0.25)] transition-all duration-300 hover:scale-105 hover:border-[#42fb5a] hover:shadow-[0_0_28px_rgba(66,251,90,0.45)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
