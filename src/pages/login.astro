---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// The button wears the gold-coin accent of the YADOM168 artwork; /register
// carries the green gradient, so the pair reads as primary + secondary.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 158.
const pageDescription =
  "หน้าเข้าสู่ระบบ YADOM168 กดปุ่มเดียวเข้าบัญชีสมาชิกเพื่อเล่นสล็อตจากหลายค่าย พร้อมตรวจสอบเครดิตคงเหลือ โปรโมชั่นที่กดรับได้ และรายการฝากถอนของตัวเองผ่านมือถือ";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ YADOM168",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="เข้าสู่ระบบ YADOM168 ล็อกอินเข้าบัญชีสมาชิก เล่นสล็อตได้ครบทุกค่าย" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ YADOM168" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ YADOM168"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#e6bd5c]/60 bg-[#0f3d0d] px-6 py-4 text-lg font-black text-[#e6bd5c] shadow-[0_10px_30px_rgba(230,189,92,0.18)] transition-all duration-300 hover:scale-105 hover:border-[#e6bd5c] hover:bg-[#1d6b18] hover:text-[#f2fbef] hover:shadow-[0_15px_40px_rgba(230,189,92,0.36)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
