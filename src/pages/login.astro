---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
//
// UWIN33 (รอบทอง-โครเมียม-ดำ 2026-09-24): ปุ่มนี้เป็นตัว SECONDARY ของคู่ —
// ผิวการ์ดยก #26200e ในกรอบทองแบรนด์ #e0b429 บนเนื้อความ #ece6d8 แล้วยกเป็นบรอนซ์ลึก
// #7a5407 กับขอบเงินโครเมียม #dfe4ec ตอน hover ส่วน /register สวมไล่เฉดทองเต็มใบ
// ลำดับความสำคัญถูกสื่อด้วย "สีไหนถมเต็มปุ่ม" ไม่ใช่ความสว่าง ตามคู่สีในโลโก้ที่
// U และ 33 เป็นทอง ส่วน WIN เป็นเงินโครเมียม
// ชุดแดง-เงินของ MAHAGAME66 (#de161d #ff4d52 #7a0a0e #e2e8ef #16090a #26100f
// #e8e3e1 #fff6f5 #080506) ออกครบแล้ว ห้ามนำกลับมา
//
// Announcement รอบนี้หมุนจาก Announcement5 มาเป็น AnnouncementPremium ทั้งเว็บ —
// default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ index ก็เรียกแบบ bare
// จึงห้ามส่ง prop
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 153
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = "หน้าเข้าสู่ระบบ UWIN33 กดปุ่มเดียวเข้าบัญชีสมาชิกเพื่อเลือกเล่นบาคาร่า รูเล็ต ไฮโล สล็อต บอล และหวย พร้อมตรวจสอบโปรโมชั่นที่เปิดให้รับสิทธิ์จากบัญชีเดียว";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ UWIN33",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="เข้าสู่ระบบ UWIN33 ล็อกอินเข้าบัญชีสมาชิก เลือกเกมที่ต้องการได้ทันที" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ UWIN33" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ UWIN33"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#e0b429] bg-[#26200e] px-6 py-4 text-lg font-black text-[#ece6d8] shadow-[0_10px_30px_rgba(8,6,2,0.85)] transition-all duration-300 hover:scale-105 hover:border-[#dfe4ec] hover:bg-[#7a5407] hover:text-[#fff8e6] hover:shadow-[0_15px_40px_rgba(224,180,41,0.45)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
