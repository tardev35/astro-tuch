---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — this page is indexed and must not
// describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// The button is the SECONDARY of the pair on the HENG38 palette: emerald card
// surface (#061f0f) inside a primary-gold outline (#f3cf63) over body ink
// (#e6e2d2), lifting to bright gold (#fbeeb0) on a lighter emerald (#0a2d16) on
// hover, while /register wears the full gold-gradient fill. The tier is carried
// by the brightness of the fill, not by a second hue.
//
// Announcement รอบนี้หมุนมาใช้ AnnouncementPremium ทั้งเว็บ — default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้อยู่แล้วและ index ก็เรียกแบบ bare จึงห้ามส่ง prop
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 156
const pageDescription = "หน้าเข้าสู่ระบบ HENG38 กดปุ่มเดียวเข้าบัญชีสมาชิกเพื่อเลือกค่ายและเกมสล็อตที่ต้องการ ตรวจสอบโปรโมชั่น ยอดที่เข้าเกณฑ์ และรายละเอียดเดิมพันขั้นต่ำของแต่ละเกม";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ HENG38",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="เข้าสู่ระบบ HENG38 ล็อกอินเข้าบัญชีสมาชิก เลือกค่ายและเกมสล็อต" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ HENG38" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ HENG38"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f3cf63] bg-[#061f0f] px-6 py-4 text-lg font-black text-[#e6e2d2] shadow-[0_10px_30px_rgba(3,20,10,0.7)] transition-all duration-300 hover:scale-105 hover:border-[#fbeeb0] hover:bg-[#0a2d16] hover:text-[#fbeeb0] hover:shadow-[0_15px_40px_rgba(243,207,99,0.36)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
