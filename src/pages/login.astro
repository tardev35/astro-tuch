---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect. The title and
// description below are written for exactly that reason.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// HI59 (รอบฟ้าสว่าง + ทอง VIP บนการ์ดสว่าง 2026-10-07, brand-spec §2 — ฟ้า
// #0a84e0 มาจาก vivid ของ logo.webp ที่ตัวอักษร HI เป็นฟ้าสามมิติ ส่วนทอง
// #fdbc04 มาจากตัวเลข 59 กับวงแหวนโค้งในโลโก้เดียวกัน รอบก่อนเป็นแดง/เงินบนผิว
// เกือบดำ รอบนี้พลิกทั้งขั้วความสว่าง เพราะอาร์ตเวิร์กทั้งดรอปเป็นท้องฟ้ากลางวัน
// และ bg.json เป็นม่วงฟ้าอ่อน #c1cce6):
// ปุ่มนี้เป็นตัว SECONDARY ของคู่ จึงถม **ฟ้าลึก** #065a9c → #044b80 → #033f70
// ขอบฟ้าแบรนด์ #0a84e0 บนหมึก #eaf5ff แล้ว hover ยกขอบเป็นทองอ่อน #ffe27a
// ส่วน /register ถม **ทอง** เต็มใบ (#ffe27a → #fdbc04 → #c88a02) บนหมึกกรมท่า
// #04203f ลำดับความสำคัญรอบนี้จึงสื่อด้วย "ทองถม vs ฟ้าถม" ไม่ใช่ถมสีเดียวกัน
// สองใบซึ่งจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม — และคู่ฟ้า/ทองนี้คือสองสีที่อยู่บนโลโก้จริง
// ตรงกับคู่ปุ่มของ NavbarStyle6 กับ FooterStyle3 ที่ orchestrator รีธีมไว้แล้ว
// กฎคอนทราสต์ของสเปก: พื้นทอง = หมึก **กรมท่า #04203f** เสมอ ห้ามขาว/ครีม ·
// พื้นฟ้าลึก = หมึก #eaf5ff · #0a84e0 เป็นสีขอบ/เรืองแสง ไม่ใช่พื้นของตัวอักษรเล็ก
// ชุดแดง+เงินของ หวยดีใจ (#dc0409 #f5363d #8e0206 #4b0205 #e8161c #eef0f4
// #c3c7d1 #f3c54e #edeaf0 #211016 #17080c #0d0407 rgba(220,4,9,*)
// rgba(195,199,209,*) rgba(13,4,7,*)) ออกครบแล้ว ห้ามนำกลับมา
//
// Announcement หมุนมาเป็น Announcement2 ทั้งเว็บรอบนี้ (รอบก่อนเป็น
// Announcement5) — default message ของไฟล์นั้นเป็นคอปปี้ของ HI59 แล้ว และ
// index ก็เรียกแบบ bare จึงห้ามส่ง prop message
//
// HI59 เป็น **เว็บสล็อต** ไม่ใช่เว็บหวย — คำหมวดหวย (หวย ส่งโพย โพย เลข 2 ตัว
// เลข 3 ตัว แนวทาง อัตราจ่าย งวด ผลรางวัล หวยลาว หวยฮานอย ธ.ก.ส.) ห้ามหลงเหลือ
// บรีฟบรรทัด 4 กับ 6 ระบุว่าหลัง Login สมาชิกเลือกค่าย ค้นหาเกม ตรวจสอบเครดิต
// โปรโมชั่น และประวัติรายการได้จากบัญชีเดียว สลับเกมและค่ายโดยไม่ต้องสมัครใหม่
// รองรับทั้งมือถือและคอมพิวเตอร์
// ตัวเลขที่ใช้ได้มีแค่ของบรีฟเอง: 0.3% / 0.8% / 100% / 24 ชั่วโมง
// ห้ามแต่งชื่อค่ายเกม ชื่อธนาคาร ยอดฝากขั้นต่ำ เลขใบอนุญาต หรือจำนวนสมาชิก
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 157
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าเข้าสู่ระบบ ${BRAND_NAME} กดปุ่มเดียวเข้าบัญชีสมาชิก เพื่อเลือกค่ายเกม ค้นหาสล็อต ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการได้จากบัญชีเดียวทั้งมือถือและคอมพิวเตอร์`;

const graph = pageGraph(Astro, {
  name: `เข้าสู่ระบบ ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`เข้าสู่ระบบ ${BRAND_NAME} ล็อกอินเข้าบัญชีสมาชิก เล่นสล็อตค่ายพรีเมียมได้ทันที`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`เข้าสู่ระบบ ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#0a84e0] bg-gradient-to-r from-[#065a9c] via-[#044b80] to-[#033f70] px-6 py-4 text-lg font-black text-[#eaf5ff] shadow-[0_10px_30px_rgba(3,63,112,0.45)] transition-all duration-300 hover:scale-105 hover:border-[#ffe27a] hover:shadow-[0_15px_40px_rgba(94,194,255,0.40)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
