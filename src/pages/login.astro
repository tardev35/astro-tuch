---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change (CtaRedirect.astro
// itself belongs to the orchestrator — ห้ามแก้ไฟล์นั้นจากหน้านี้)
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page, which means verify-build holds its
// description to the same 150–160 character window as every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES — คอปปี้ของหน้านี้จึงพูด
// ได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 4: เมนูตรวจสอบรายการ เลือกประเภทหวย และรายละเอียด
// การฝากถอน · บรรทัด 6: ตรวจสอบวันเวลาเปิดรับ อัตราจ่าย และแหล่งอ้างอิงผลรางวัล ·
// บรรทัด 16: ควรตรวจสอบช่องทางจากเว็บไซต์ทางการก่อนส่งข้อความ)
// ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า หน้านี้มีโควตาเป็นปุ่มเดียว
//
// ⚠️ แกนของบรีฟรอบนี้คือ **เว็บหวยออนไลน์ที่รวมหวยหลายประเภทไว้ที่เดียว** —
// หวยรัฐบาลไทย หวยฮานอย หวยลาว และหวยหุ้นต่างประเทศ ซึ่งคนละแกนกับรอบก่อน
// (ระบบดูแลการเงิน + เกมหลายหมวด) ศัพท์หมวดนั้นทุกคำจึงเป็นของค้างที่ห้ามหลุดกลับมา
// รายการคำเต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไป
// เจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// คำที่ใช้ได้รอบนี้: หวยออนไลน์ · หวยรัฐบาลไทย · หวยฮานอย · หวยลาว ·
// หวยหุ้นต่างประเทศ · ระบบแทงหวย · รอบปิดรับ · รอบประกาศผล · อัตราจ่าย ·
// ตรวจสอบรายการ · ประเภทหวย · บิลหวย · หมายเลขรายการ · ฝากถอน · ธนาคาร · วอลเลท ·
// ยอดขั้นต่ำ · ระยะเวลาดำเนินการ · รหัสผ่าน · รหัส OTP · เจ้าหน้าที่ · แอดมิน ·
// 24ชม. · เว็บไซต์ทางการ · ประกาศล่าสุด
// พร้อมโปรโมชั่นสองรายการคือ **คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%**
// แบรนด์ก่อนหน้าขายตัวเองด้วยวลีที่บรีฟรอบนี้ไม่มีเลยสักคำ จึงต้องเขียนใหม่จากบรีฟ
// ไม่ใช่ find-and-replace ทับของเดิม
// ⚠️ **รอบนี้เป็นเว็บหวยล้วน** ห้ามเอ่ยถึงสล็อต ไฮโล ยิงปลา บอล บาคาร่า คาสิโนสด
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกม ชื่อธนาคาร หรือใบอนุญาตแม้แต่รายเดียว**
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 24ชม. · 100% ห้ามแต่งใบอนุญาต
// หน่วยงานกำกับ ค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีใดๆ · วลีขายของที่ห้ามใช้
// อยู่ใน brand-spec §6 และห้ามมีวลี "N ขั้นตอน" (รอบนี้บรีฟไม่มี)
// หัวข้อฝากถอนกับช่องทางติดต่อแอดมินของบรีฟเป็นของ index.astro ไม่ใช่ของหน้านี้
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตต์รอบนี้อยู่ใน .claude/brand-spec-satu168.md §2
// ⚠️⚠️ **รอบนี้เป็นแบรนด์ "ธีมสว่าง" รอบที่สองของรีโปนี้ — การ์ดสว่าง หมึกเข้ม**
// bg.json = {"mode":"color","color":"#d8ffc7"} = เขียวมิ้นต์ **สว่าง** ไม่ใช่ดำ
// การ์ด ContentBox จึงเป็นผิว **ขาว** #ffffff บนหมึกเขียวป่า #0c3a16 (= BRAND_TEXT)
// ปุ่มนี้เป็นคู่ SECONDARY ของพาเลตโซน "เนื้อหา": พื้น **ขาว→อินเซ็ตมิ้นต์**
// #ffffff → #e9fbdd ขอบ **เขียวมรกต** #0b7d28 บนตัวอักษร **เขียวเข้ม** #0a5f1c
// (7.9:1 บนทั้งสองผิว) ส่วน /register เป็น PRIMARY ถมเขียวบนตัวอักษรขาว จึงไม่ซ้ำกัน
// ⚠️ ปุ่มของ Navfoot เป็น **โครม** (พื้นเข้ม/ทองสัมฤทธิ์) คนละโซนกับปุ่มบนการ์ดนี้
// **ห้ามลอกคลาสของ Navfoot มาวางบนการ์ดสว่าง** ทองบนผิวขาวได้แค่ 1.7-2.8:1
// ⚠️⚠️ **เขียวใบตอง #0f9b35 ห้ามถือตัวอักษรและห้ามเป็นพื้นของตัวอักษร** (3.7:1)
// เป็น stop ของไล่เฉด/ออราเท่านั้น
// ⚠️⚠️ **ทองสัมฤทธิ์ #c9cb63 #aeb04a #9ba03c ห้ามใช้ในไฟล์นี้เลยสักจุด**
// ⚠️ ห้ามกลับด้าน: พื้นสว่างคู่หมึกเขียวเข้มเสมอ
// ออราในไฟล์นี้ใช้ rgba(11,125,40,α) · rgba(10,95,28,α) · rgba(12,58,22,α) เท่านั้น
//
// ⚠️ กับดักรอบนี้คือ **ทอง/เหลืองเคยนำมาแล้วเกือบทุกแบรนด์** "มีทองอยู่แล้ว" จึงไม่
// พิสูจน์ว่าเป็นค่าของรอบนี้ ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน brand-spec §2
// ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive
// ส่วนเขียวทั้งสี่ค่าของรอบนี้ (0b7d28 0f9b35 0a5f1c 0c3a16) ไม่มีแบรนด์ไหนเคยใช้เลย
// รอบนี้ **ไม่มีชมพู ไม่มีแดงชาด ไม่มีบรอนซ์ส้ม ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง
// ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์ และไม่มีทองส้มสด**
//
// Announcement หมุนมาเป็น AnnouncementHuay ทั้งเว็บรอบนี้ (brand-spec §3 — รอบก่อนใช้
// Announcement4 จึงหมุนออก) orchestrator ตั้ง default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare — ห้ามส่ง prop message
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) หน้านี้ยาว 152
// ด้วยชื่อแบรนด์ 7 ตัวอักษรของรอบนี้
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าเข้าสู่ระบบ ${BRAND_NAME} กดปุ่มเดียวเพื่อเข้าสู่บัญชีสมาชิก สำหรับตรวจสอบสถานะบิลหวย รอบปิดรับ อัตราจ่าย และรายการฝากถอน จากประกาศล่าสุดของเว็บไซต์ทางการ`;

const graph = pageGraph(Astro, {
  name: `เข้าสู่ระบบ ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`เข้าสู่ระบบ ${BRAND_NAME} เข้าบัญชีสมาชิกเพื่อตรวจสอบบิลหวยและรายการฝากถอน`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`เข้าสู่ระบบ ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border-2 border-[#0b7d28] bg-gradient-to-b from-[#ffffff] to-[#e9fbdd] px-6 py-4 text-2xl font-bold tracking-wide text-[#0a5f1c] shadow-[0_10px_30px_rgba(12,58,22,0.18)] transition-all duration-300 hover:scale-105 hover:border-[#0a5f1c] hover:shadow-[0_15px_40px_rgba(11,125,40,0.35)]">
        <div aria-hidden="true" class="absolute inset-x-0 bottom-0 -z-10 h-1/2 bg-gradient-to-t from-[#e9fbdd] to-transparent"></div>
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
