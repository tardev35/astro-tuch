---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change (CtaRedirect.astro
// itself belongs to the orchestrator — ห้ามแก้ไฟล์นั้นจากหน้านี้)
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page, which means verify-build holds its
// description to the same 150–160 character window as every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES — คอปปี้ของหน้านี้จึงพูด
// ได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 4: ตรวจสอบกติกาและเงื่อนไขการเดิมพัน ·
// บรรทัด 20: หลังลงทะเบียนสามารถศึกษารายชื่อค่ายเกมสล็อต กติกาการเล่น
// ช่วงเดิมพันขั้นต่ำ และรายละเอียดโปรโมชั่น · บรรทัด 22: ควรตรวจสอบช่องทาง
// จากเว็บไซต์ทางการก่อนส่งข้อความ)
// ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า หน้านี้มีโควตาเป็นปุ่มเดียว
//
// ⚠️ แกนของบรีฟรอบนี้คือ **เว็บสล็อตออนไลน์ล้วน** — เกมสล็อตลิขสิทธิ์แท้
// ค่ายตรงมาแรง พร้อมโปรโมชั่นก่อนสิ้นปี 2026
// ศัพท์ของหมวดอื่นที่บรีฟไม่มีทุกคำจึงเป็นของค้างที่ห้ามหลุดกลับมา
// รายการคำเต็มอยู่ใน brand-spec §1 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไป
// เจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// คำที่ใช้ได้รอบนี้: เกมสล็อตออนไลน์ · ค่ายเกม · ลิขสิทธิ์ · ฟีเจอร์พิเศษ ·
// กติกาการเล่น · เงื่อนไขการเดิมพัน · โปรโมชั่น · คืนยอดเสีย · แนะนำเพื่อน ·
// สมัครสมาชิก · ลงทะเบียน · เข้าสู่ระบบ · บัญชีสมาชิก · รายการฝากถอน ·
// รหัสผ่าน · รหัส OTP · เจ้าหน้าที่ · แอดมิน · 24ชม. · เว็บไซต์ทางการ ·
// ประกาศล่าสุด · ปี 2026
// พร้อมโปรโมชั่นสองรายการคือ **คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%**
// แบรนด์ก่อนหน้าขายตัวเองด้วยวลีที่บรีฟรอบนี้ไม่มีเลยสักคำ จึงต้องเขียน
// ใหม่จากบรีฟ ไม่ใช่ find-and-replace ทับของเดิม
// ⚠️ **สองหน้าหมวดลอตเตอรีของรอบก่อนถูกปิดรอบนี้** (ย้ายไป src/pages-disabled/)
// ห้ามลิงก์ไปสองเส้นทางนั้น route ไม่มีอยู่จริงแล้ว build จะแดง
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกม ชื่อธนาคาร หรือใบอนุญาตแม้แต่รายเดียว**
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 24ชม. · ปี 2026
// ห้ามแต่งใบอนุญาต หน่วยงานกำกับ ค่า RTP ยอดฝากขั้นต่ำ หรือจำนวนสมาชิก ·
// วลีขายของที่ห้ามใช้อยู่ใน brand-spec §1 · บรีฟรอบนี้มี "ขั้นตอน 1-3" ของการสมัคร
// แต่นั่นเป็นของ index.astro (FeatureHighlights) ไม่ใช่ของหน้านี้
// หัวข้อฝากถอนกับช่องทางติดต่อแอดมินของบรีฟก็เป็นของ index.astro เช่นกัน
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตต์รอบนี้อยู่ใน .claude/brand-spec-prodeee168.md §2
// ⚠️⚠️ **รอบนี้เป็นแบรนด์ "ธีมสว่าง" รอบที่สี่ของรีโปนี้ — การ์ดสว่าง หมึกเข้ม**
// bg.json = {"mode":"color","color":"#ffd1d1"} = ชมพูพาสเทล **สว่าง** ไม่ใช่ดำ
// การ์ด ContentBox จึงเป็นผิว **ขาว** #ffffff บนหมึกน้ำตาลแดง #401107
// (= BRAND_TEXT) → คลาสสีของรอบก่อน (แดงคริมสัน + ทองโบราณ) กวาดออกครบแล้ว
// ปุ่มนี้เป็นคู่ SECONDARY ของพาเลตโซน "เนื้อหา": ถม **ทองแดงไหม้→ทองแดงเข้ม**
// #b44c06 → #7a2f03 ขอบ #7a2f03 บนตัวอักษร **ขาว** (5.3:1 และ 9.4:1 ผ่าน AA)
// ส่วน /register เป็น PRIMARY ถมแดงเชอร์รี่บนตัวอักษรขาว จึงไม่ซ้ำกัน
// ⚠️ ปุ่มของ Navfoot เป็น **โครม** (พื้นน้ำตาลแดงเข้ม/ทองสาลี่) คนละโซนกับปุ่มบน
// การ์ดนี้ **ห้ามลอกคลาสของ Navfoot มาวางบนการ์ดสว่าง**
// ⚠️⚠️ **ทองสาลี่ (f0b46a เขียนโดยไม่มี # เพื่อกัน sweep) ห้ามปรากฏในไฟล์นี้** — เป็นสีของโซนโครม
// และบนพื้นสว่างได้แค่ 1.8:1 · ทองแดงไหม้ #b44c06 เป็นคนละค่าและผ่าน AA
// ⚠️⚠️ **แดงสด (ff4446) ห้ามถือตัวอักษรและห้ามเป็นพื้นของตัวอักษร** เป็น stop ของ
// ไล่เฉด/ออราเท่านั้น
// ⚠️ ไล่เฉดต้อง **เริ่มที่ #b44c06 แล้วเข้มลง** ห้ามไล่ขึ้นไปสว่างกว่านั้นใต้ตัวอักษรขาว
// ชั้นตกแต่งของปุ่มจึงเป็นชั้น **เข้มลง** ที่ขอบล่าง ไม่ใช่ sheen สว่างที่ขอบบน
// ออราในไฟล์นี้ใช้ rgba(180,76,6,α) · rgba(64,17,7,α) เท่านั้น
//
// ⚠️ กับดักรอบนี้คือ **แดงนำมาแล้วมากกว่าฮิวอื่นใดในรีโปนี้ และรอบก่อนก็เป็นแดง+ทอง
// บนธีมสว่างชมพูเหมือนกัน** "มีแดง/มีทองอยู่แล้ว" จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้
// ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive
// รอบนี้ **ไม่มีเขียว ไม่มีชมพูบานเย็น ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง
// ไม่มีเงิน/โครเมียม และไม่มีโรสโกลด์**
//
// Announcement หมุนมาเป็น AnnouncementPremium ทั้งเว็บรอบนี้ (brand-spec §3 —
// รอบก่อนใช้ ticker คนละตัว จึงหมุนออก) orchestrator ตั้ง default
// message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare —
// ห้ามส่ง prop message
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) หน้านี้ยาว 156
// ด้วยชื่อแบรนด์ 8 ตัวอักษรของรอบนี้
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าเข้าสู่ระบบ ${BRAND_NAME} กดปุ่มเดียวเพื่อเข้าสู่บัญชีสมาชิก สำหรับตรวจสอบรายละเอียดเกมสล็อต เงื่อนไขการเดิมพัน และโปรโมชั่น จากประกาศล่าสุดของเว็บไซต์ทางการ`;

const graph = pageGraph(Astro, {
  name: `เข้าสู่ระบบ ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`เข้าสู่ระบบ ${BRAND_NAME} เข้าบัญชีสมาชิกเพื่อดูรายละเอียดเกมและโปรโมชั่น`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`เข้าสู่ระบบ ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border-2 border-[#7a2f03] bg-gradient-to-b from-[#b44c06] to-[#7a2f03] px-6 py-4 text-2xl font-bold tracking-wide text-[#ffffff] shadow-[0_10px_30px_rgba(180,76,6,0.35)] transition-all duration-300 hover:scale-105 hover:border-[#401107] hover:shadow-[0_15px_40px_rgba(180,76,6,0.5)]">
        <span aria-hidden="true" class="absolute inset-x-0 bottom-0 -z-10 h-1/2 bg-gradient-to-t from-[#7a2f03]/60 to-transparent"></span>
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
