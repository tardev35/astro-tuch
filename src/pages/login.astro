---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — this page is indexed and must not
// describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// The button is the SECONDARY of the pair on the THE88 palette: near-black red
// surface (#1c0504) inside a brand-red outline (#a40201) over body ink
// (#f7e3dd), lifting to light gold (#ffe7a6) on the card surface (#2d0908) on
// hover, while /register wears the full gold-gradient fill of the logo's "88".
// The tier is carried by which of the two brand hues fills the button, not by
// brightness.
//
// Announcement รอบนี้หมุนมาใช้ Announcement2 ทั้งเว็บ — default message ของไฟล์นั้น
// เป็นคอปปี้ของแบรนด์นี้อยู่แล้วและ index ก็เรียกแบบ bare จึงห้ามส่ง prop
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 155
const pageDescription = "หน้าเข้าสู่ระบบ THE88 กดปุ่มเดียวเข้าบัญชีสมาชิกเพื่อเลือกหมวดเกมที่ต้องการ ทั้งบาคาร่า สล็อต หวย บอล และไฮโล พร้อมตรวจสอบโปรโมชั่นและยอดที่เข้าเกณฑ์ของรอบ";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ THE88",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="เข้าสู่ระบบ THE88 ล็อกอินเข้าบัญชีสมาชิก เลือกหมวดเกมที่ต้องการ" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ THE88" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ THE88"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#a40201] bg-[#1c0504] px-6 py-4 text-lg font-black text-[#f7e3dd] shadow-[0_10px_30px_rgba(28,5,4,0.7)] transition-all duration-300 hover:scale-105 hover:border-[#f2c14e] hover:bg-[#2d0908] hover:text-[#ffe7a6] hover:shadow-[0_15px_40px_rgba(164,2,1,0.45)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
