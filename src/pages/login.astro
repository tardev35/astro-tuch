---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// The button wears the gold-coin accent of the UVO88 artwork; /register
// carries the green gradient, so the pair reads as primary + secondary.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 152.
const pageDescription =
  "หน้าเข้าสู่ระบบ UVO88 กดปุ่มเดียวเข้าบัญชีสมาชิกเพื่อเล่นบาคาร่า เกมไพ่ สล็อต หวย และฟุตบอล พร้อมตรวจสอบเครดิตคงเหลือ โปรโมชั่น และรายการฝากถอนของตัวเอง";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ UVO88",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="เข้าสู่ระบบ UVO88 ล็อกอินเข้าบัญชีสมาชิก เดิมพันได้ครบทุกหมวดเกม" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ UVO88" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ UVO88"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f2c230]/60 bg-[#0a3b1c] px-6 py-4 text-lg font-black text-[#f2c230] shadow-[0_10px_30px_rgba(242,194,48,0.18)] transition-all duration-300 hover:scale-105 hover:border-[#f2c230] hover:bg-[#116330] hover:text-[#f3fbf5] hover:shadow-[0_15px_40px_rgba(242,194,48,0.36)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
