---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// PGW44 (รอบทอง-เขียว-ดำ 2026-09-27): ปุ่มนี้เป็นตัว SECONDARY ของคู่ และรับฝั่ง
// "W" ของโลโก้ที่เป็นเขียวจัด — ผิวยก #101a0b ในกรอบเขียว #35d413 บนเนื้อความ
// #e9f0dd แล้วยกเป็นผิว #1f5a16 กับขอบเขียวสว่าง #5df53a ตัวอักษรเน้น #fbffe8
// ตอน hover ส่วน /register สวมไล่เฉดทองไปเขียวเต็มใบ ลำดับความสำคัญถูกสื่อด้วย
// "สีไหนถมเต็มปุ่ม" ตามโลโก้ที่ P G 44 นำด้วยทองและ W เป็นเขียว — ทองคู่เขียว
// ไม่ใช่ทองสองใบ ซึ่งจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม
// ชุดทอง+โครเมียมของแบรนด์ก่อนหน้า (#fdd32a #ffe27a #ffeeb8 #c8920a #15110a
// #c2c8d0 #f2f4f7 #12100a #2a2110 #4a3a12 #080602 #efe6d2 #fff8e1
// rgba(253,211,42,*) rgba(194,200,208,*)) ออกครบแล้ว ห้ามนำกลับมา
//
// Announcement หมุนจาก AnnouncementPremium มาเป็น Announcement2 ทั้งเว็บรอบนี้ —
// default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ index ก็เรียกแบบ bare
//
// PGW44 เป็นแบรนด์สล็อตล้วน — บรีฟพูดถึงค่ายสล็อตย่อยหลายแนวในระบบเดียวและเมนู
// จัดหมวดหมู่เท่านั้น คำศัพท์เฉพาะหมวดของแบรนด์ก่อนหน้า (คาสิโนสด เกมโต๊ะ บาคาร่า
// หวย) รวมถึง API/ใบอนุญาต/ชื่อค่าย/ฝากถอนออโต้/เครดิตฟรี ห้ามหลงเหลือในหน้านี้
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 155
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = "หน้าเข้าสู่ระบบ PGW44 กดปุ่มเดียวเข้าบัญชีสมาชิกเพื่อเลือกเกมสล็อตจากค่ายย่อยหลายแนวในระบบเดียว พร้อมตรวจสอบเมนูหมวดหมู่เกมและโปรโมชั่นที่อัปเดตตามช่วงเวลา";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ PGW44",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="เข้าสู่ระบบ PGW44 ล็อกอินเข้าบัญชีสมาชิก เลือกเกมสล็อตได้ทันที" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ PGW44" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ PGW44"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#35d413] bg-[#101a0b] px-6 py-4 text-lg font-black text-[#e9f0dd] shadow-[0_10px_30px_rgba(3,6,2,0.85)] transition-all duration-300 hover:scale-105 hover:border-[#5df53a] hover:bg-[#1f5a16] hover:text-[#fbffe8] hover:shadow-[0_15px_40px_rgba(53,212,19,0.30)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
