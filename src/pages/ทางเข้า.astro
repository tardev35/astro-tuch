---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
// Every paragraph that has ever been on this page was invented by an earlier
// rebrand, not by the brief. Heading inventory must stay h1x1, h2x0, h3x0.
//
// The <h1> names what the page IS ("ทางเข้า <brand> เว็บหลัก"), not what an
// article on it would have argued — a title that previews a body reads as a
// broken promise once the body is gone, and is the line most likely to tempt
// the next rebrand into writing it back.
//
// cta toggle รอบนี้เปิด: /login และ /register เป็น button page ที่ index ได้
// หน้านี้จึงถูกถอดออกจากเมนูนาวบาร์ตามกติกา (เพราะเป็นลิงก์ที่สามไปที่เดียวกัน)
// แต่ยัง route และ index อยู่ และฟุตเตอร์ยังลิงก์มาที่นี่ — ห้ามลบไฟล์นี้ และห้ามย้าย
// ไป src/pages-disabled/
//
// FLASH877 (รอบทองสายฟ้า-แดงเลือดนก 2026-10-10, brand-spec §2):
// โลโก้เป็นเหรียญกลมขอบทองพื้นแดงเข้ม มีสายฟ้าทอง-ส้มผ่ากลาง คำว่า FLASH เป็นทอง
// สามมิติและ 877 เป็นแดงสด พื้นเพจจาก bg.json เป็น
// {"mode":"color","color":"#5c0000"} = แดงเลือดนกเข้ม การ์ด ContentBox เป็นผิวยก
// #7d1008 ที่สว่างกว่าพื้นเพจ ปุ่มบนการ์ดจึงห้ามใช้ผิวยกตัวเดียวกัน ไม่งั้นจมหาย
// ทองสายฟ้า #f5c518 (ฮิวหลัก) · ทองสว่าง #ffdd73 · ทองเข้ม #b8860f ·
// แดงสายฟ้า #ff3b14 (ฮิวที่สอง) · แดงเข้ม #8c0f0a · เนื้อความ #fdf0e2 ·
// หมึกบนพื้นถมทอง #2a0300 · ชั้นผิว ยก #7d1008 / กลาง #6d0804 / ลึก #5c0000 /
// ลึกสุด #430000
//
// ขั้วของปุ่มตามสเปก (พื้นสว่าง = หมึกเข้ม · พื้นเข้ม = หมึกสว่าง):
// สมัครสมาชิก = แอ็กชันหลัก ถม **ทองไล่เฉด** #ffdd73 → #f5c518 → #b8860f
// ขอบ #b8860f บนหมึกเข้ม #2a0300 (14.3:1 / 11.6:1 / 5.8:1 ตามลำดับสต็อป)
// เข้าสู่ระบบ = แอ็กชันรอง จมลงจากการ์ดด้วยชั้นลึก #5c0000 → #430000
// ขอบแดง #ff3b14/55 บนเนื้อความ #fdf0e2 (12.9:1 / 15.1:1) hover ยกขอบเป็นแดงเต็ม
// ⚠️ ห้ามกลับด้าน และห้ามไล่เฉดทองลงไปถึง #8a6208 ใต้ตัวอักษร (#2a0300 บน #8a6208
// = 3.45:1 ตก) ปลายเข้มของไล่เฉดจึงหยุดที่ #b8860f · แดงสายฟ้า #ff3b14 ไม่เคยถือ
// ตัวอักษรเนื้อความ (≈3.6:1 บนผิวการ์ด) ใช้ได้แค่เส้นขอบ ออรา และเงา
// ออราด้านบนของปุ่มใช้ปลายสว่างของฮิวตัวเอง rgba(245,197,24,α) และ
// rgba(255,59,20,α) ไม่มี rgba อื่นในไฟล์นี้นอกจากเงาดำล้วน
// ⚠️ แบรนด์รอบก่อนก็เป็นคู่ "แดง-ทอง" เหมือนกัน เจอแดงหรือทองที่ไหนห้ามเหมาว่าเป็น
// ของรอบนี้ ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน brand-spec §2
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ — orchestrator ตั้ง default
// message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์ปัจจุบันแล้ว และทุกหน้าเรียกแบบ bare จึง
// ห้ามส่ง prop message จากหน้านี้ ไม่งั้นตัววิ่งจะไม่ตรงกับ index.astro
//
// แบรนด์นี้เป็น **เว็บตรงฐานสล็อตหลัก** ล้วนๆ สองหน้าของหมวดลอตเตอรียัง park อยู่ใน
// src/pages-disabled/ จึงไม่มี route และลิงก์ค้างจะกลายเป็น href ตายที่ทำให้บิลด์แดง
// รายการคำต้องห้ามเต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำของ
// แบรนด์เก่าเจอ false positive
// บรีฟบรรทัด 4 ระบุว่าสมาชิกค้นหาเกม ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการได้
// ผ่านบัญชีเดียว — คอปปี้ของหน้านี้พูดได้แค่เท่านั้น
// ⚠️ ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 0.3% / 0.8% / 24 ชั่วโมง / 100% / 2026
// ห้ามแต่งชื่อค่ายเกม ชื่อธนาคาร เลขใบอนุญาต หน่วยงานกำกับ ค่า RTP ยอดฝากขั้นต่ำ
// จำนวนสมาชิก หรือปีก่อตั้ง — หน้านี้มีโควตาเป็นปุ่มสองปุ่มเท่านั้น
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้ไม่มี UTF-8 locale จึงนับเป็นไบต์ = เกินจริงราว 3 เท่า)
// หน้านี้ยาว 152
const pageDescription = `ทางเข้า ${BRAND_NAME} เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ เว็บตรงฐานสล็อตหลัก อัปเดตระบบเข้าเล่นใหม่ 2026 รวมเกมสล็อตหลายประเภทไว้ในบัญชีเดียว`;

const graph = pageGraph(Astro, {
  name: `ทางเข้า ${BRAND_NAME} เว็บหลัก`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title={`ทางเข้า ${BRAND_NAME} เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ทางเข้า ${BRAND_NAME} เว็บหลัก`} as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ff3b14]/55 bg-gradient-to-b from-[#5c0000] to-[#430000] px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.55)] transition-all duration-300 hover:scale-105 hover:border-[#ff3b14] hover:shadow-[0_15px_40px_rgba(255,59,20,0.45)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ff3b14]/30 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#fdf0e2] transition-colors group-hover:text-[#ffdd73]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#fdf0e2]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#b8860f] bg-gradient-to-b from-[#ffdd73] via-[#f5c518] to-[#b8860f] px-6 py-4 shadow-[0_10px_30px_rgba(245,197,24,0.40)] transition-all duration-300 hover:scale-105 hover:border-[#2a0300] hover:shadow-[0_15px_40px_rgba(245,197,24,0.60)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ffdd73]/60 to-transparent"></div>

          <svg class="h-9 w-9 text-[#2a0300]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-black tracking-wide text-[#2a0300]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
