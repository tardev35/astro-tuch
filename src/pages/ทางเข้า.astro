---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
// Heading inventory for this page must stay h1x1, h2x0, h3x0.
//
// This route stays OUT of the navbar menu on purpose while the cta toggle is on
// (/login and /register are menu entries themselves), but it is still routed,
// still indexed and still linked from the footer. Do not add a nav link and do
// not delete the page.
//
// Two button tiers on the MIRACLE55 palette (ทอง + เงินโครเมียมบนดำ ตามโลโก้ที่ MI
// เป็นทอง RACLE เป็นเงินขัดเงา และ 55 เป็นทอง เฉดที่สองรอบนี้เป็นโครเมียมเย็น ไม่ใช่
// ครีมอุ่น): สมัครสมาชิก คือแอ็กชันหลัก จึงได้พื้นไล่ทองเต็มใบ
// (#fee47b → #fcda65 → #8c5f14) ตัวอักษรเกือบดำ #14100a เพราะตัวหนังสือบน
// พื้นทองต้องเป็นสีเข้ม ห้ามใช้ขาว ส่วน เข้าสู่ระบบ เป็นแอ็กชันรอง จึงเป็นฝั่ง
// "RACLE" ของโลโก้ — เส้นขอบเงินโครเมียม #d2d3d4 บนผิวการ์ดเกือบดำ #14100a
// ตัวอักษรเนื้อความ #e8e6e1 (hover ยกผิวขึ้นเป็น #1b140b ขอบเงินสว่าง #eaeaea และ
// ตัวอักษรเน้น #fcfcfc) — สองโลหะ ไม่ใช่ทองสองใบ ชุดทองล้วนของรอบก่อนถูกแทนครบแล้ว
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ — default message ของไฟล์
// นั้นเป็นคอปปี้ของ MIRACLE55 แล้ว และ index ก็เรียกแบบ bare จึงห้ามส่ง prop
// message จากหน้านี้
//
// MIRACLE55 เป็นแบรนด์คาสิโน — คำศัพท์เฉพาะหมวดของแบรนด์ก่อนหน้าห้ามหลงเหลือ
// (ดู brand-spec §5) และห้ามลิงก์ไปเราต์ที่ถูกปิดไว้ใน src/pages-disabled รอบนี้
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 151
const pageDescription = "ทางเข้า MIRACLE55 เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ เพื่อเข้าเล่นเกมคาสิโนสดและเกมโต๊ะจากหลายค่ายในบัญชีเดียว ใช้งานได้ตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  name: "ทางเข้า MIRACLE55 เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ทางเข้า MIRACLE55 เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า MIRACLE55 เว็บหลัก" as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ MIRACLE55"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#d2d3d4]/70 bg-[#14100a] px-6 py-4 shadow-[0_10px_30px_rgba(5,4,3,0.85)] transition-all duration-300 hover:scale-105 hover:border-[#eaeaea] hover:bg-[#1b140b] hover:shadow-[0_15px_40px_rgba(210,211,212,0.28)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#d2d3d4]/28 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#e8e6e1] transition-colors group-hover:text-[#fcfcfc]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#e8e6e1] transition-colors group-hover:text-[#fcfcfc]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก MIRACLE55"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fee47b]/70 bg-gradient-to-r from-[#fee47b] via-[#fcda65] to-[#8c5f14] px-6 py-4 shadow-[0_10px_30px_rgba(252,218,101,0.40)] transition-all duration-300 hover:scale-105 hover:border-[#d2d3d4] hover:shadow-[0_15px_40px_rgba(210,211,212,0.28)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#fcfcfc]/30 to-transparent"></div>

          <svg class="h-9 w-9 text-[#14100a]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#14100a]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
