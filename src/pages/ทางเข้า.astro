---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// Button page, not an article: the docx gives this route a Title and a Meta and
// never a body. One heading from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the <h1>.
const pageDescription =
  "ทางเข้า AKA99 เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้ทันที รองรับสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ เข้าเล่นสล็อต PGSOFT เว็บตรงค่ายใหญ่ ฝากถอนออโต้ 24 ชม.";

const graph = pageGraph(Astro, {
  name: "ทางเข้า AKA99 เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ทางเข้า AKA99 เว็บหลัก สล็อตเว็บตรงค่ายใหญ่ เข้าสู่ระบบและสมัครสมาชิก" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า AKA99 เว็บหลัก" as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ AKA99"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#1e4b9e]/80 bg-[#03081c] px-6 py-4 shadow-[0_10px_30px_rgba(11,108,240,0.18)] transition-all duration-300 hover:scale-105 hover:border-[#9dd2fa] hover:bg-[#0a1836] hover:shadow-[0_15px_40px_rgba(11,108,240,0.30)]">
          <div class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#9dd2fa]/20 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#9dd2fa]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#eaf3fd]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก AKA99"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#4aa3ff]/70 bg-gradient-to-r from-[#4aa3ff] via-[#0b6cf0] to-[#0a2a6b] px-6 py-4 shadow-[0_10px_30px_rgba(11,108,240,0.25)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(195,206,217,0.30)]">
          <div class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-white/40 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#02060f]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#02060f]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
