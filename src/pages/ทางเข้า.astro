---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
// Every paragraph that has ever been on this page was invented by an earlier
// rebrand, not by the brief. Heading inventory must stay h1x1, h2x0, h3x0.
//
// The <h1> names what the page IS ("ทางเข้า <brand> เว็บหลัก"), not what an
// article on it would have argued — a title that previews a body reads as a
// broken promise once the body is gone, and is the line most likely to tempt
// the next rebrand into writing it back.
//
// cta toggle รอบนี้เปิด: /login และ /register เป็น button page ที่ index ได้
// หน้านี้จึงถูกถอดออกจากเมนูนาวบาร์ตามกติกา (เพราะเป็นลิงก์ที่สามไปที่เดียวกัน)
// แต่ยัง route และ index อยู่ และฟุตเตอร์ยังลิงก์มาที่นี่ — ห้ามลบไฟล์นี้ และห้ามย้าย
// ไป src/pages-disabled/
//
// NAZA168 (รอบทองอวกาศ-เงินโครเมียม 2026-10-10, brand-spec §2):
// โลโก้เป็นเหรียญกลมขอบทองพื้นดำ มีหมวกนักบินอวกาศโครเมียม-ทองอยู่กลาง คำว่า NAZA
// เป็นทองสามมิติ และ 168 เป็นเงินโครเมียมขอบทอง พื้นเพจจาก bg.json เป็น
// {"mode":"color","color":"#382400"} = น้ำตาลไหม้เข้ม การ์ด ContentBox เป็นผิวยก
// #4e3406 ที่สว่างกว่าพื้นเพจ ปุ่มบนการ์ดจึงห้ามใช้ผิวยกตัวเดียวกัน ไม่งั้นจมหาย
// ทองแบรนด์ #fbc134 (ฮิวหลัก) · ทองสว่าง #ffe87a · ทองกลางเข้ม #cf9a18 ·
// เงินโครเมียม #cfd6e3 (ฮิวที่สอง) · เนื้อความ #fdf3df · หมึกบนพื้นถมทอง #231500 ·
// ชั้นผิว ยก #4e3406 / กลาง #432b03 / ลึก #382400 / ลึกสุด #241700
//
// ขั้วของปุ่มตามสเปก (พื้นสว่าง = หมึกเข้ม · พื้นเข้ม = หมึกสว่าง):
// สมัครสมาชิก = แอ็กชันหลัก ถม **ทองไล่เฉด** #ffe87a → #fbc134 → #cf9a18
// ขอบ #cf9a18 บนหมึกเข้ม #231500 (ปลายเข้มสุดได้ 7.0:1)
// เข้าสู่ระบบ = แอ็กชันรอง จมลงจากการ์ดด้วยชั้นลึก #382400 → #241700
// ขอบเงินโครเมียม #cfd6e3/55 บนเนื้อความ #fdf3df (13.5:1 / 16.0:1)
// hover ยกขอบเป็นเงินเต็ม
// ⚠️ ห้ามกลับด้าน และห้ามไล่เฉดทองลงไปถึง #96690a ใต้ตัวอักษร (#231500 บน #96690a
// = 3.7:1 ตก) ปลายเข้มของไล่เฉดจึงหยุดที่ #cf9a18 · #96690a #6b4a05 #3f4859
// ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่เส้นขอบ ออรา และเงา
// ออราด้านบนของปุ่มใช้ปลายสว่างของฮิวตัวเอง rgba(251,193,52,α) และ
// rgba(207,214,227,α) ไม่มี rgba อื่นในไฟล์นี้นอกจากเงาดำล้วน
// ⚠️ แบรนด์รอบก่อน (FLASH877) ก็เป็นแบรนด์ "ทอง" เหมือนกัน เจอทองที่ไหนห้ามเหมาว่า
// เป็นของรอบนี้ ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน brand-spec §2 — ชุด
// #f5c518 #ffdd73 #b8860f #ff3b14 #5c0000 #430000 #fdf0e2 #2a0300
// rgba(245,197,24,α) rgba(255,59,20,α) ออกครบแล้ว และรอบนี้ไม่มีสีแดงเป็นฮิวเลย
//
// Announcement หมุนมาเป็น AnnouncementPremium ทั้งเว็บรอบนี้ — orchestrator ตั้ง
// default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์ปัจจุบันแล้ว และทุกหน้าเรียกแบบ bare
// จึงห้ามส่ง prop message จากหน้านี้ ไม่งั้นตัววิ่งจะไม่ตรงกับ index.astro
//
// แบรนด์นี้เป็น **เว็บสล็อตนาซ่า** ล้วนๆ ไม่ใช่เว็บหวย สองหน้าของหมวดลอตเตอรียัง
// park อยู่ใน src/pages-disabled/ จึงไม่มี route และลิงก์ค้างจะกลายเป็น href ตาย
// ที่ทำให้บิลด์แดง รายการคำต้องห้ามเต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาคำของแบรนด์เก่าเจอ false positive
// บรีฟบรรทัด 4 ระบุว่าสมาชิกค้นหาเกม ตรวจสอบเครดิต และติดตามโปรโมชั่นได้จาก
// แพลตฟอร์มเดียว — คอปปี้ของหน้านี้พูดได้แค่เท่านั้น
// ⚠️ ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 0.3% / 0.8% / 24 ชั่วโมง / 100%
// ห้ามแต่งชื่อค่ายเกม ชื่อธนาคาร เลขใบอนุญาต หน่วยงานกำกับ ค่า RTP ยอดฝากขั้นต่ำ
// จำนวนสมาชิก หรือปีก่อตั้ง — หน้านี้มีโควตาเป็นปุ่มสองปุ่มเท่านั้น
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้ไม่มี UTF-8 locale จึงนับเป็นไบต์ = เกินจริงราว 3 เท่า)
// หน้านี้ยาว 151
const pageDescription = `ทางเข้า ${BRAND_NAME} เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ เว็บสล็อตนาซ่า ส่งตรงจากเมกา รวมค่ายฮิตระดับประเทศ ระบบเดิมพันใหม่ล่าสุด มาตรฐานสากล`;

const graph = pageGraph(Astro, {
  name: `ทางเข้า ${BRAND_NAME} เว็บหลัก`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title={`ทางเข้า ${BRAND_NAME} เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ทางเข้า ${BRAND_NAME} เว็บหลัก`} as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#cfd6e3]/55 bg-gradient-to-b from-[#382400] to-[#241700] px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.55)] transition-all duration-300 hover:scale-105 hover:border-[#cfd6e3] hover:shadow-[0_15px_40px_rgba(207,214,227,0.4)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#cfd6e3]/25 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#fdf3df] transition-colors group-hover:text-[#ffe87a]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#fdf3df]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#cf9a18] bg-gradient-to-b from-[#ffe87a] via-[#fbc134] to-[#cf9a18] px-6 py-4 shadow-[0_10px_30px_rgba(251,193,52,0.4)] transition-all duration-300 hover:scale-105 hover:border-[#231500] hover:shadow-[0_15px_40px_rgba(251,193,52,0.6)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ffe87a]/60 to-transparent"></div>

          <svg class="h-9 w-9 text-[#231500]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-black tracking-wide text-[#231500]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
