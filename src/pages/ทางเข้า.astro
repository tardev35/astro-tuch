---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
//
// BUTTON PAGE ไม่ใช่บทความ — บรีฟ (src/assets/content.txt, 29 บรรทัด) **ไม่มีส่วน
// SUB-PAGES** จึงไม่เคยให้ body กับหน้านี้ ทุกย่อหน้าและทุกหัวข้อย่อยที่เคยอยู่บน
// หน้านี้คือของที่รีแบรนด์รอบก่อนๆ คิดขึ้นเอง แล้วรอบถัดมาก็เขียนทับด้วยความเชื่อว่า
// รอบก่อนมีเหตุผล — ไม่มี ทั้งหน้ามีแค่ชื่อเรื่องจาก ContentBox แล้วต่อด้วยปุ่มสองปุ่ม
// **ห้ามเขียนหัวข้อย่อยหรือย่อหน้าอธิบายใต้ชื่อเรื่อง** — ไม่มีรายการ "ตรวจ N จุด
// ก่อนล็อกอิน" ไม่มีประโยคเตือนเรื่องรหัสผ่าน/OTP ไม่ว่าคอปปี้นั้นจะเขียนดีแค่ไหน
// (ประโยคกำกับเรื่องรหัสผ่าน/OTP ของบรีฟอยู่บน index.astro และ /about-us ซึ่งเป็น
// บทความจริง ไม่ใช่บนหน้าปุ่ม)
//
// h1 บอกว่า "หน้านี้คืออะไร" ("ทางเข้า <แบรนด์> เว็บหลัก") ไม่ใช่บอกว่าบทความบน
// หน้านี้จะเถียงอะไร — ชื่อเรื่องที่โฆษณาเนื้อหาไว้คือบรรทัดที่ล่อให้รีแบรนด์รอบ
// ถัดไปเขียน body กลับมามากที่สุด
//
// cta toggle รอบนี้เปิด: /login และ /register เป็น button page ที่ index ได้
// หน้านี้จึง **ไม่อยู่ในเมนูนาวบาร์โดยตั้งใจ** แต่ยัง route และ index อยู่ และ
// footer ที่ใช้งานอยู่ยังลิงก์มาที่นี่ — ห้ามลบไฟล์นี้ ห้ามย้ายไป
// src/pages-disabled/ และห้ามเติมลิงก์กลับเข้าเมนู
//
// ───────────────────────────────────────────────────────────────────────────
// 🚨 แกนของแบรนด์รอบนี้คือ **เว็บหวยออนไลน์** และบรีฟระบุ **สี่ประเภทเท่านั้น**
// (หวยรัฐบาลไทย · หวยลาว · หวยฮานอย · หวยหุ้น — .claude/brand-spec-lottoplus.md §5)
// 🚨🚨 **รอบก่อนเป็นคาสิโน/บาคาร่า ห้ามสืบทอดลิสต์ข้ามรอบเด็ดขาด** คำนิยามตัวเองของ
// แบรนด์ก่อนๆ ห้ามเหลือที่ไหนทั้งสิ้น รายการคำที่ห้ามใช้อยู่ใน brand-spec §5
// ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์
// ของไฟล์นี้เอง
// ⚠️ **บรีฟรอบนี้ไม่มีหมวดฝากถอน/ธนาคาร/วอลเลท และไม่มีหมวดโปรโมชั่นเลยสักคำ** —
// หน้านี้ไม่เอ่ยถึงเลย
// ⚠️ route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ตรวจหวย · /แนวทาง · /ทดลองเล่น · /about-us · /contact-us · /terms · /privacy ·
// /line — **รอบนี้สองหน้าหมวดหวยย้ายกลับเข้า src/pages/ แล้ว** (แบรนด์นี้เป็น
// เว็บหวยเต็มตัว) ต่างจากรอบก่อนที่สองหน้านั้นปิดอยู่
// แต่หน้านี้มีโควตาเป็นปุ่มสองปุ่ม จึงไม่ลิงก์ไปที่อื่นเพิ่มอยู่แล้ว
// ⚠️ ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 100 · 1,000 · 2 ตัว · 3 ตัว · 3 ขั้นตอน · 24ชม. —
// หน้านี้มีโควตาเป็นปุ่มสองปุ่ม จึงไม่อ้างตัวเลขใดเลย
//
// พาเลตรอบนี้อยู่ใน .claude/brand-spec-lottoplus.md §2
// 🚨🚨 **กลับทิศ 180° จากรอบก่อน: รอบนี้ "เนื้อหาสว่าง โครมเข้ม"**
// bg.json = {"mode":"color","color":"#e1fef3"} = **เขียวมินต์จางเกือบขาว**
// (รอบก่อนเป็นดำอมเลือดหมู ซึ่งอยู่คนละปลายของสเกล — ค่ามาจากไฟล์ ห้ามเดาว่าเท่าเดิม)
// การ์ด ContentBox จึงเป็นผิวขาว #ffffff บนหมึกเข้ม #0d3326 (= BRAND_TEXT, 13.8:1)
// **ห้าม "แก้" การ์ดกลับไปเป็นผิวเข้มตามรอบก่อน** — ผิวเข้มบนหมึกนี้ = ตัวอักษร
// หายไปเลย ไม่ใช่แค่จางลง
//
// ขั้วของปุ่มบนการ์ดผิวขาว (ตรงกับคู่ปุ่มที่ล็อกไว้ใน brand-spec §2):
// สมัครสมาชิก = PRIMARY พื้นไล่เฉดเขียวมรกต #0c7c58 -> #046c4e -> #03543c
//   บนหมึก **ขาว #ffffff** (5.2 / 6.7 / 9.2:1 ผ่าน AA ทุกสต็อป) — ปุ่ม CTA หลัก
//   🚨🚨 **หมึกเข้ม #0d3326 บนเฉดนี้ตกทุก stop ห้ามใช้เด็ดขาด** (รอบก่อนปุ่มหลัก
//   เป็นส้ม-ทองจึงรองหมึกดำได้ รอบนี้กลับทิศ)
//   ⚠️⚠️ **ห้ามดันปลายอ่อนขึ้นไปถึง #19a97c** — ขาวบนค่านั้นเหลือ 3.0:1
// เข้าสู่ระบบ = SECONDARY ผิวพื้นถมอ่อน #d2f3e4 บนหมึก **#046c4e** (5.4:1)
//   ขอบ #19a97c คือสิ่งที่แยกปุ่มนี้ออกจากผิวการ์ดขาว — ห้ามถอดขอบออก
// ⚠️⚠️ **#ffffff #f0fdf7 #d2f3e4 #a3ddc3 #19a97c #2fd49b #e1fef3 เป็นผิว/เส้น
//   ห้ามถือตัวอักษรเด็ดขาด** · ที่ถือตัวอักษรได้บนการ์ดขาวคือ #0d3326 (13.8:1) ·
//   #046c4e (6.7:1) · #3f6f5c (6.0:1) · #8a6508 (5.4:1)
// 🚨 **#e2b32a (ทองอำพัน) ได้แค่ 2.0:1 บนการ์ดขาว — ห้ามถือตัวอักษรบนหน้านี้**
//   มันถือตัวอักษรได้เฉพาะบนโครมเข้ม #052e22 ซึ่งไม่ใช่โซนของไฟล์นี้
// ⚠️⚠️ **ค่าของ WIN8S รอบก่อน (1e0101 2a0a04 3b130b 5a2410 8a3a12 250604 140302
//   f27a1a e8620e f0a21e e5a92b c9d2dc fdf0e6 e0bda4 — เขียนแบบไม่มี # โดยตั้งใจ)
//   ห้ามหลงเหลือในไฟล์นี้แม้แต่ค่าเดียว**
// ⚠️⚠️ **ฮิวนำของรอบนี้คือเขียวมรกต #046c4e คู่ทองอำพัน #e2b32a บนผิวสว่าง** —
//   เวิร์ดมาร์กสามมิติสองบรรทัดที่บรรทัดบนเป็นผิวโครเมียมเงินโดยตัว O ตัวที่สอง
//   เป็นใบโคลเวอร์สี่แฉกสีเขียวมรกต บรรทัดล่างผิวเขียวมรกต ชุดไทยทอง-เขียวมรกต
//   เครื่องประดับทองฝังพลอยเขียว ยอดปรางค์ทอง ดอกลีลาวดีขาว และลูกบอลหวยเขียว-ขาว
//   ในอาร์ตเวิร์ก **เป็นวัตถุในภาพ ไม่ใช่สี UI** · พื้นเพจมาจาก bg.json เท่านั้น
// ⚠️ ปุ่มของ Navfoot อยู่บนแถบโครมเข้ม คนละโซนกับปุ่มบนการ์ดขาวนี้
// **ห้ามลอกคลาสของ Navfoot มาวางบนการ์ด** (หมึกของโครมเป็นหมึกสว่าง จะหายบนการ์ดขาว)
// ออราในไฟล์นี้ใช้ rgba(4,108,78,α) · rgba(25,169,124,α) · rgba(47,212,155,α) ·
// rgba(226,179,42,α) · rgba(13,51,38,α) · rgba(5,46,34,α) เท่านั้น
//
// ⚠️⚠️ กับดักรอบนี้: **ตระกูล Huay (เจ้าของเดิมของ AnnouncementHuay/NavbarHuay
// ที่หมุนเข้ามารอบนี้) เป็นแบรนด์หวย แดง/ทอง** และ **LOTTO189 ก็เป็นแบรนด์หวย** →
// **"เจอคำว่าหวย ไม่ได้แปลว่าเป็นของรอบนี้"** ส่วนสาธุ168 / TEVA69 / ZORO365
// เป็นเขียวทั้งหมด → **"เจอเขียวหรือทองอยู่แล้ว จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้"**
// ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive
// รอบนี้ **ไม่มีแดง/ส้ม/ม่วง/ฟ้า/แมเจนต้า/ชมพูเป็นสี UI** เลยสักเฉด
//
// Announcement รอบนี้หมุนมาเป็นตัวที่ลงท้ายด้วยคำว่าหวย ทั้งเว็บ
// (brand-spec §3 — รอบก่อนใช้ตัวท้ายชื่อพรีเมียมจึงหมุนออก · เขียนชื่อ variant แบบ
// ไม่มีเครื่องหมายคำพูดโดยตั้งใจ เพราะ tools/gen-tw-sources.mjs นับ literal
// ที่มีเครื่องหมายคำพูดว่าเป็นการ import จริง คอมเมนต์จึงทำให้ variant เก่าหลุด
// เข้า Tailwind scan แล้วสีของแบรนด์ก่อนขึ้น stylesheet) orchestrator เป็นเจ้าของ
// default message ของไฟล์นั้น ทุกหน้าเรียกแบบ bare จึง **ห้ามส่ง prop message**
// จากหน้านี้ ไม่งั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้ไม่มี UTF-8 locale จึงนับเป็นไบต์ = เกินจริงราว 3 เท่า)
// หน้านี้ยาว 155 ด้วยชื่อแบรนด์ 9 โค้ดพอยต์ของรอบนี้ (รอบก่อนยาว 5 — ต้องนับใหม่
// ทุกรอบ ห้ามสืบทอดความยาวข้ามแบรนด์) ส่วนที่ไม่ใช่ชื่อแบรนด์ยาว 146 →
// รับชื่อแบรนด์ได้ 4–14 อักขระ ถ้ารอบหน้าชื่อยาวกว่านั้นต้องตัดข้อความ
// ไม่ใช่ปล่อยผ่าน
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ทำให้ตัวนับเห็นเป็น 5 อักขระ
// ประโยคนี้บรรยาย "สิ่งที่หน้านี้มี" เท่านั้น — หน้านี้มีแค่ปุ่มสองปุ่ม ไม่มีปุ่ม LINE
// จึงไม่สัญญาช่องทางแชตไว้ใน description
const pageDescription = `ทางเข้า ${BRAND_NAME} เว็บหลัก รวมปุ่มเข้าสู่ระบบและสมัครสมาชิกไว้ในหน้าเดียว สำหรับผู้ที่ต้องการเข้าใช้งานระบบสมาชิก ควรตรวจสอบที่อยู่เว็บไซต์ทางการก่อนใช้งาน`;

const graph = pageGraph(Astro, {
  name: `ทางเข้า ${BRAND_NAME} เว็บหลัก`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title={`ทางเข้า ${BRAND_NAME} เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ทางเข้า ${BRAND_NAME} เว็บหลัก`} as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="group mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 rounded-xl border-2 border-[#19a97c] bg-[#d2f3e4] px-6 py-4 shadow-[0_8px_24px_rgba(13,51,38,0.10)] transition-all duration-300 hover:scale-105 hover:border-[#046c4e] hover:shadow-[0_14px_36px_rgba(4,108,78,0.18)]">
          <svg class="h-9 w-9 text-[#046c4e]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#046c4e]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border-2 border-[#19a97c] bg-gradient-to-b from-[#0c7c58] via-[#046c4e] to-[#03543c] px-6 py-4 shadow-[0_10px_30px_rgba(4,108,78,0.30)] transition-all duration-300 hover:scale-105 hover:border-[#2fd49b] hover:shadow-[0_15px_40px_rgba(4,108,78,0.40)]">
          <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-white/10 to-transparent"></span>

          <svg class="h-9 w-9 text-[#ffffff]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-black tracking-wide text-[#ffffff]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
