---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
// Heading inventory for this page must stay h1x1, h2x0, h3x0.
//
// The <h1> names what the page IS ("ทางเข้า <brand> เว็บหลัก"), not what an
// article on it would have argued — a title that previews a body reads as a
// broken promise once the body is gone, and is the line most likely to tempt
// the next rebrand into writing it back.
//
// This route stays OUT of the navbar menu on purpose while the cta toggle is on
// (/login and /register are menu entries themselves), but it is still routed,
// still indexed and still linked from the footer. Do not add a nav link and do
// not delete the page.
//
// Two button tiers on this round's palette (brand-spec §3 — ชุดตรุษจีน **สามสี:
// แดงนำ เขียวมรกตรอง ทองเป็นโลหะคั่น** บนผิวเกือบดำอมแดง · โลโก้เป็นเทพเจ้าโชคลาภ
// สวมหมวกเขียวมรกตคาดแดง กับตัวอักษร GUCCI ขาวเงินขอบเขียวทับเลข 168 แดงขอบทอง
// แบนเนอร์เป็นซุ้มจีนเขียว โคมแดง เหรียญทอง และชิปแดง-ขาว ส่วน bg.json เป็นไล่เฉด
// แดงเลือดหมู → ทองเข้ม รอบก่อนเป็นทองเมทัลลิก-เงินโครเมียมบนดำน้ำตาล รอบนี้จึง
// หมุนฮิวทั้งชุด ไม่ใช่แค่เปลี่ยนเบอร์สี):
// สมัครสมาชิก คือแอ็กชันหลัก จึงถม **แดงไล่เฉด** (#e0201f → #c41115 → #7a0505)
// ขอบทองแบรนด์ #d9a521 บนตัวอักษรขาว — สเปกตรวจแล้ว ขาวบน #c41115 = 6.1:1 และ
// ขาวบน #e0201f = 4.8:1 พอดี AA จึงห้ามดันปลายไล่เฉดให้สว่างกว่า #e0201f
// ส่วน เข้าสู่ระบบ เป็นแอ็กชันรอง จึงถม **เขียวมรกต** (#0b7a33 → #063f1c)
// ขอบเขียวสว่าง #2bbf63 บนตัวอักษรขาว (ขาวบน #0b7a33 = 5.5:1) — #2bbf63 ใช้เป็น
// สีขอบและแสงเรืองเท่านั้น ห้ามเอามาถมเป็นพื้นของตัวอักษรขาว (2.3:1 ตก AA)
// ลำดับความสำคัญจึงสื่อด้วย "ฮิวที่ต่างกัน" (แดงถม vs เขียวถม) ซึ่งมาจากโลโก้จริงของ
// รอบนี้ ไม่ใช่ความสว่างของสีเดียวกันสองใบ
// ออราด้านบนของปุ่มใช้ทองเป็นโลหะคั่นทั้งสองใบ: rgba(217,165,33,α) / #ffdf91
// ชุดทองเมทัลลิกและเงินโครเมียมของแบรนด์ก่อนถูกแทนครบแล้ว ทั้งคลาส Tailwind
// raw hex และ rgba() (ค่าเดิมอยู่ใน brand-spec §3 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep
// หาสีแบรนด์เก่าเจอ false positive)
//
// Announcement หมุนมาเป็น Announcement3 ทั้งเว็บรอบนี้ — default message ของไฟล์
// นั้นเป็นคอปปี้ของแบรนด์ปัจจุบันแล้ว และ index ก็เรียกแบบ bare จึงห้ามส่ง prop
// message จากหน้านี้
//
// แบรนด์นี้เป็น **เว็บคาสิโนไลฟ์ 24 ชม. + สล็อต + บอล** ไม่ใช่เว็บหวย — คำหมวดหวย
// (หวย โพย เลขเด็ด แนวทาง งวด อัตราจ่าย ตรวจหวย) ห้ามหลงเหลือ และคำของแบรนด์ก่อน
// (ไฮคลาส VIP เบทต่ำ ทุนน้อย ค่ายตรง ถูกลิขสิทธิ์ ส่งตรงจากเว็บแม่) ก็ห้ามเช่นกัน
// บรีฟบรรทัด 15 ระบุว่าหลัง Login สมาชิกเลือกหมวดเกม ตรวจสอบเครดิต โปรโมชั่น และ
// ประวัติรายการผ่านบัญชีเดียวได้ เข้าเล่นผ่านมือถือและคอมพิวเตอร์ได้
// ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 0.3% / 0.8% / 24 ชั่วโมง / 3 ขั้นตอน
// ห้ามแต่งชื่อค่ายเกม ชื่อธนาคาร เลขใบอนุญาต หน่วยงานกำกับ ค่า RTP ยอดฝากขั้นต่ำ
// จำนวนสมาชิก หรือปีก่อตั้ง — หน้านี้มีโควตาเป็นปุ่มสองปุ่มเท่านั้น
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 152
const pageDescription = `ทางเข้า ${BRAND_NAME} เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ เพื่อเลือกโต๊ะสดคาสิโนไลฟ์ บาคาร่า รูเล็ต ไฮโล สล็อต และบอล ได้จากบัญชีเดียวบนมือถือ`;

const graph = pageGraph(Astro, {
  name: `ทางเข้า ${BRAND_NAME} เว็บหลัก`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title={`ทางเข้า ${BRAND_NAME} เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ทางเข้า ${BRAND_NAME} เว็บหลัก`} as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#2bbf63]/60 bg-gradient-to-b from-[#0b7a33] to-[#063f1c] px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.55)] transition-all duration-300 hover:scale-105 hover:border-[#2bbf63] hover:shadow-[0_15px_40px_rgba(43,191,99,0.40)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#d9a521]/25 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#ffdf91] transition-colors group-hover:text-white"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-white">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#d9a521] bg-gradient-to-b from-[#e0201f] via-[#c41115] to-[#7a0505] px-6 py-4 shadow-[0_10px_30px_rgba(196,17,21,0.40)] transition-all duration-300 hover:scale-105 hover:border-[#ffdf91] hover:shadow-[0_15px_40px_rgba(196,17,21,0.60)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ffdf91]/30 to-transparent"></div>

          <svg class="h-9 w-9 text-[#ffdf91]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-black tracking-wide text-white">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
