---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// Button page, not an article: the brief gives this route no body at all —
// รอบนี้บรีฟ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES เลย ทุกย่อหน้าที่เคยอยู่
// บนหน้านี้จึงเป็นของที่รีแบรนด์รอบก่อนๆ คิดขึ้นเอง ไม่ใช่ของบรีฟ
// ทั้งหน้ามีแค่ชื่อเรื่องจาก ContentBox แล้วต่อด้วยปุ่มสองปุ่ม
// ห้ามเขียนหัวข้อย่อยหรือย่อหน้าอธิบายใต้ชื่อเรื่อง — ไม่มีรายการ "ตรวจ N จุดก่อน
// ล็อกอิน" และไม่มีประโยคเตือนเรื่อง PIN/OTP ไม่ว่าคอปปี้นั้นจะเขียนดีแค่ไหน
//
// The <h1> names what the page IS ("ทางเข้า <brand> เว็บหลัก"), not what an
// article on it would have argued — a title that previews a body reads as a
// broken promise once the body is gone, and is the line most likely to tempt
// the next rebrand into writing it back.
//
// cta toggle รอบนี้เปิด: /login และ /register เป็น button page ที่ index ได้
// หน้านี้จึงถูกถอดออกจากเมนูนาวบาร์ตามกติกา (เพราะเป็นลิงก์ที่สามไปที่เดียวกัน)
// แต่ยัง route และ index อยู่ และฟุตเตอร์ยังลิงก์มาที่นี่ — ห้ามลบไฟล์นี้ และห้ามย้าย
// ไป src/pages-disabled/
//
// แบรนด์รอบนี้ (ขวัญใจ168, รอบ **ทองนำ โรสโกลด์เป็นฮิวที่สอง แดงชาดเป็นสำเนียงลึก
// บนดำสนิท** 2026-10-18, brand-spec §2): โลโก้คือคำว่า "ขวัญใจ" ตัวอักษรไทยหนา
// สามมิติผิวทองขัดเงาตัดขอบแดงเข้ม ต่อด้วยเลข "168" ทองสามมิติ บนโบว์ริบบิ้นทอง
// ด้านหลังเป็นหญิงสาวผมดำเกล้ามวยประดับปิ่นทองห้อยระย้าและดอกไม้ขาว ในชุดไทยแดง
// ปักทอง ล้อมด้วยเหรียญจีนทองรูสี่เหลี่ยมและหัวใจแดง แบนเนอร์เป็นฉากพื้นดำที่มี
// หญิงสาวสองคนขนาบข้าง ฝนเหรียญทอง ผ้าซาตินแดง และดอกลิลลี่ขาว —
// **vivid อันดับหนึ่งที่ palette.json วัดได้คือโรสโกลด์ จึงเป็นฮิวที่สองของรอบนี้จริง**
// พื้นเพจจาก bg.json รอบนี้เป็น {"mode":"color","color":"#000000"} = ดำสนิท
// ชั้นผิว: ยก #241509 (= การ์ด ContentBox) / กลาง #160d06 / จม #0b0603 / พื้น #000000
// ทองลึก #8a5f12 · แดงชาด #b3121b · แดงลึก #5a0a0e (สามตัวนี้ห้ามถือตัวอักษร)
// ตัวที่ถือตัวอักษรได้: ทองสว่าง #ffe6a3 (14.5:1) · โรสโกลด์ #f2bba5 (10.4:1) ·
// ทองแบรนด์ #f7c92b (7.3:1) · โรสเข้ม #c98a74 (7.2:1) ·
// เนื้อความ #eadfce (= BRAND_TEXT ที่การ์ด ContentBox ตั้งให้แล้ว) ·
// หมึกบนพื้นถมทอง #140c06
//
// ขั้วของปุ่มตามสเปก (พื้นสว่าง = หมึกเข้ม · พื้นเข้ม = หมึกสว่าง):
// สมัครสมาชิก = แอ็กชันหลัก ถม **ทองไล่เฉด** #ffe6a3 → #f7c92b ขอบ #8a5f12
// บนหมึกเข้ม #140c06 (15.6:1 บนปลายสว่าง และ 7.9:1 บนปลายเข้มสุด #f7c92b)
// เข้าสู่ระบบ = แอ็กชันรอง จมลงจากการ์ดด้วยชั้น #160d06 → #0b0603
// ขอบ **โรสเข้ม** #c98a74/55 บนตัวอักษร **โรสโกลด์** #f2bba5 — hover ยกขอบเป็น
// #f2bba5 · รอบก่อนปุ่มรองเป็นขอบแดงบนตัวอักษรแดงสว่าง รอบนี้โรสโกลด์มาแทน
// ซึ่งคือฮิวที่แยกรอบนี้ออกจากสองรอบก่อนหน้า
// ⚠️ ห้ามกลับด้าน: พื้นถมทองต้องใช้หมึก #140c06 เสมอ ห้ามขาวหรือครีม ·
// #8a5f12 #b3121b #5a0a0e ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่เส้นขอบ ออรา พื้นถม
// และเงา — ออราในไฟล์นี้ใช้ rgba(247,201,43,α) และ rgba(242,187,165,α) เท่านั้น
// นอกจากเงาดำล้วน
// ⚠️ กับดักรอบนี้คือ **ทอง** เพราะแทบทุกแบรนด์ที่ผ่านไฟล์นี้มีทองอยู่ด้วย
// "มีทองอยู่แล้ว" จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้ ทองรอบนี้คือ #f7c92b
// (247,201,43) ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำ
// ที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive — ไม่เทียบด้วยตา
// และไม่เทียบด้วยตระกูลสี
// และรอบนี้ **ไม่มีม่วง ไม่มีชมพูบานเย็น ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว ไม่มีส้ม
// ไม่มีเงินอมฟ้า**
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ (brand-spec §3 —
// รอบก่อนใช้ AnnouncementPremium จึงหมุนออก) default message ของไฟล์นั้นเป็นคอปปี้
// ของแบรนด์นี้แล้ว และทุกหน้าเรียกแบบ bare จึงห้ามส่ง prop message จากหน้านี้
// ไม่งั้นตัววิ่งจะไม่ตรงกับ index.astro
//
// ⚠️ แบรนด์นี้เป็น **เว็บเกมสล็อตล้วน** ตามบรีฟรอบนี้ — ไม่ใช่คาสิโน ไม่ใช่กีฬา
// ไม่ใช่หวย สองหน้าของหมวดลอตเตอรี park อยู่ใน src/pages-disabled/ จึงไม่มี route
// และลิงก์ค้างจะเป็น href ตายที่ทำให้บิลด์แดง คำที่ห้ามหลงเหลือทั้งหมดอยู่ใน
// brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำของแบรนด์เก่าเจอ false
// positive — แบรนด์ก่อนๆ ขายตัวเองด้วยวลีที่บรีฟรอบนี้ไม่มีเลยสักคำ
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 24 ชั่วโมง · 100% · 3 ขั้นตอน
// ห้ามแต่งชื่อค่ายเกม ชื่อธนาคาร เลขใบอนุญาต หน่วยงานกำกับ ค่า RTP ยอดฝากขั้นต่ำ
// จำนวนสมาชิก หรือปีใดๆ (บรีฟรอบนี้ไม่ได้เอ่ยปีไว้เลย) — หน้านี้มีโควตาเป็นปุ่ม
// สองปุ่มเท่านั้น
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้ไม่มี UTF-8 locale จึงนับเป็นไบต์ = เกินจริงราว 3 เท่า)
// หน้านี้ยาว 151
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ทำให้ตัวนับเห็นเป็น 5 อักขระ
const pageDescription = `ทางเข้า ${BRAND_NAME} เว็บหลัก รวมเมนูเข้าสู่ระบบและสมัครสมาชิกของศูนย์บริการหลักเกมสล็อตออนไลน์ไว้ในหน้าเดียว กดเลือกเมนูที่ต้องการได้ทันทีตลอด 24 ชั่วโมง`;

const graph = pageGraph(Astro, {
  name: `ทางเข้า ${BRAND_NAME} เว็บหลัก`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title={`ทางเข้า ${BRAND_NAME} เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ทางเข้า ${BRAND_NAME} เว็บหลัก`} as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#c98a74]/55 bg-gradient-to-b from-[#160d06] to-[#0b0603] px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.6)] transition-all duration-300 hover:scale-105 hover:border-[#f2bba5] hover:shadow-[0_15px_40px_rgba(242,187,165,0.4)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#c98a74]/20 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#f2bba5] transition-colors group-hover:text-[#ffe6a3]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#f2bba5]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#8a5f12] bg-gradient-to-b from-[#ffe6a3] to-[#f7c92b] px-6 py-4 shadow-[0_10px_30px_rgba(247,201,43,0.4)] transition-all duration-300 hover:scale-105 hover:border-[#140c06] hover:shadow-[0_15px_40px_rgba(247,201,43,0.6)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ffe6a3]/70 to-transparent"></div>

          <svg class="h-9 w-9 text-[#140c06]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-black tracking-wide text-[#140c06]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
