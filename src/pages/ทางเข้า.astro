---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// Button page, not an article: the brief gives this route no body at all —
// รอบนี้บรีฟ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES เลย ทุกย่อหน้าที่เคยอยู่
// บนหน้านี้จึงเป็นของที่รีแบรนด์รอบก่อนๆ คิดขึ้นเอง ไม่ใช่ของบรีฟ
// ทั้งหน้ามีแค่ชื่อเรื่องจาก ContentBox แล้วต่อด้วยปุ่มสองปุ่ม
// ห้ามเขียนหัวข้อย่อยหรือย่อหน้าอธิบายใต้ชื่อเรื่อง — ไม่มีรายการ "ตรวจ N จุดก่อน
// ล็อกอิน" และไม่มีประโยคเตือนเรื่อง PIN/OTP ไม่ว่าคอปปี้นั้นจะเขียนดีแค่ไหน
//
// The <h1> names what the page IS ("ทางเข้า <brand> เว็บหลัก"), not what an
// article on it would have argued — a title that previews a body reads as a
// broken promise once the body is gone, and is the line most likely to tempt
// the next rebrand into writing it back.
//
// cta toggle รอบนี้เปิด: /login และ /register เป็น button page ที่ index ได้
// หน้านี้จึงถูกถอดออกจากเมนูนาวบาร์ตามกติกา (เพราะเป็นลิงก์ที่สามไปที่เดียวกัน)
// แต่ยัง route และ index อยู่ และฟุตเตอร์ยังลิงก์มาที่นี่ — ห้ามลบไฟล์นี้ และห้ามย้าย
// ไป src/pages-disabled/
//
// แบรนด์รอบนี้ (สมหวัง168, รอบแดงมังกร-ทองไทยบนพื้นดำอมแดง 2026-10-17,
// brand-spec §2): โลโก้คือคำว่า "สมหวัง" ตัวอักษรสามมิติโครเมียมขาวอมเงินขอบแดง
// ต่อด้วยเลข "168" สีแดงสดตัวหนาสามมิติ มีเปลวไฟแดงกับลายกนกไทยสีแดงพันรอบ
// แบนเนอร์และสไลด์เป็นฉากคาสิโนไทย-จีนพื้นดำ ผ้าซาตินแดงพลิ้ว **ลายกนก/นาคทองไทย**
// ขนาบสองข้าง กองชิปทอง-แดง-ดำ วงล้อรูเล็ต ไพ่เอซ — สีรองของรอบนี้คือ **ทอง**
// ไม่ใช่โครเมียมขาวแบบรอบก่อน
// พื้นเพจจาก bg.json รอบนี้เป็น {"mode":"color","color":"#290f0f"} = ดำอมแดง
// ชั้นผิว: ยก #2c1413 (= การ์ด ContentBox) / กลาง #1f0d0c / จม #140706 / พื้น #290f0f
// แดงแบรนด์ #fa0513 · แดงลึก #b90203 #8c0204 #3c0303 · ทองลึก #8a6210 ·
// ตัวที่ถือตัวอักษรได้: ทองสว่าง #ffe5a8 (14.1:1) · ทองไทย #e3b23c (8.9:1) ·
// แดงอ่อน #ffadaf (9.8:1) · ตัวอักษรรอง #ccb9b6 (9.2:1) · แดงสว่าง #ff5a5f (5.7:1) ·
// เนื้อความ #f4ecea (= BRAND_TEXT ที่การ์ด ContentBox ตั้งให้แล้ว) ·
// หมึกบนพื้นถมแดง/ทอง #170504
//
// ขั้วของปุ่มตามสเปก (พื้นสว่าง = หมึกเข้ม · พื้นเข้ม = หมึกสว่าง):
// สมัครสมาชิก = แอ็กชันหลัก ถม **แดงไล่เฉด** #ffadaf → #fa0513 ขอบ #b90203
// บนหมึกเข้ม #170504 (4.8:1 บนปลายเข้มสุด #fa0513 และสูงกว่านั้นบน #ffadaf)
// เข้าสู่ระบบ = แอ็กชันรอง จมลงจากการ์ดด้วยชั้น #1f0d0c → #140706
// ขอบ **ทอง** #e3b23c/55 บนตัวอักษรทองสว่าง #ffe5a8 — hover ยกขอบเป็น #ffe5a8
// ⚠️ ห้ามกลับด้าน และ **ห้ามไล่เฉดเข้มกว่า #fa0513** ใต้ตัวอักษร ·
// #fa0513 #b90203 #8c0204 #3c0303 #8a6210 ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่
// เส้นขอบ ออรา พื้นถม และเงา — ออราในไฟล์นี้ใช้ rgba(250,5,19,α)
// rgba(255,173,175,α) และ rgba(227,178,60,α) เท่านั้น นอกจากเงาดำล้วน
// ⚠️ กับดักรอบนี้คือ **แดง** และหนักเป็นพิเศษ เพราะสองแบรนด์ก่อนหน้าก็เป็นแดง
// เหมือนกันทั้งคู่ และต่างจากแดงรอบนี้ (#fa0513) แค่หลักเดียว
// "มีแดงอยู่แล้ว" จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้ ให้เทียบเป็น "ค่า" ทีละตัวกับตาราง
// ใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ
// false positive — สิ่งที่ทำให้รอบนี้ต่างจริงคือ **ทองไทยกับพื้นดำอมแดง**
// และรอบนี้ **ไม่มีโครเมียมขาว/เงินเป็นสีระบบ ไม่มีม่วง ไม่มีชมพู ไม่มีน้ำเงิน
// ไม่มีฟ้า ไม่มีเขียว ไม่มีส้ม**
//
// Announcement หมุนมาเป็น Announcement3 ทั้งเว็บรอบนี้ (brand-spec §3 — แบรนด์ก่อน
// ใช้ Announcement5/Announcement2 จึงหมุนออกทั้งคู่) default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และทุกหน้าเรียกแบบ bare จึงห้ามส่ง prop message
// จากหน้านี้ ไม่งั้นตัววิ่งจะไม่ตรงกับ index.astro
//
// ⚠️ แบรนด์นี้เป็น **เว็บเกมสล็อตล้วน** ตามบรีฟรอบนี้ — ไม่ใช่คาสิโน ไม่ใช่กีฬา
// ไม่ใช่หวย สองหน้าของหมวดลอตเตอรี park อยู่ใน src/pages-disabled/ จึงไม่มี route
// และลิงก์ค้างจะเป็น href ตายที่ทำให้บิลด์แดง คำที่ห้ามหลงเหลือทั้งหมดอยู่ใน
// brand-spec §7 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำของแบรนด์เก่าเจอ false
// positive — สองแบรนด์ก่อนหน้าขายกรอบ "คาสิโน + กีฬา + เซิร์ฟเวอร์นอก"
// ซึ่งบรีฟรอบนี้ไม่มีเลยสักคำ
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 24 ชั่วโมง — ห้ามแต่งชื่อค่ายเกม
// ชื่อธนาคาร เลขใบอนุญาต หน่วยงานกำกับ ค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปี
// ใดๆ (บรีฟรอบนี้ไม่ได้เอ่ยปีไว้เลย) — หน้านี้มีโควตาเป็นปุ่มสองปุ่มเท่านั้น
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้ไม่มี UTF-8 locale จึงนับเป็นไบต์ = เกินจริงราว 3 เท่า)
// หน้านี้ยาว 157
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ทำให้ตัวนับเห็นเป็น 5 อักขระ
const pageDescription = `ทางเข้า ${BRAND_NAME} เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ เว็บเกมสล็อตที่ตรวจสอบบัญชี รายการเครดิต และโปรโมชั่นผ่านช่องทางบริการได้ตลอด 24 ชั่วโมง`;

const graph = pageGraph(Astro, {
  name: `ทางเข้า ${BRAND_NAME} เว็บหลัก`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title={`ทางเข้า ${BRAND_NAME} เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ทางเข้า ${BRAND_NAME} เว็บหลัก`} as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#e3b23c]/55 bg-gradient-to-b from-[#1f0d0c] to-[#140706] px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.6)] transition-all duration-300 hover:scale-105 hover:border-[#ffe5a8] hover:shadow-[0_15px_40px_rgba(227,178,60,0.4)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#e3b23c]/20 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#ffe5a8] transition-colors group-hover:text-[#ffadaf]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#ffe5a8]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#b90203] bg-gradient-to-b from-[#ffadaf] to-[#fa0513] px-6 py-4 shadow-[0_10px_30px_rgba(250,5,19,0.4)] transition-all duration-300 hover:scale-105 hover:border-[#170504] hover:shadow-[0_15px_40px_rgba(250,5,19,0.6)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ffadaf]/70 to-transparent"></div>

          <svg class="h-9 w-9 text-[#170504]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-black tracking-wide text-[#170504]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
