---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
//
// This route stays OUT of the navbar menu on purpose while the cta toggle is on
// (/login and /register are menu entries themselves), but it is still routed,
// still indexed and still linked from the footer. Do not add a nav link and do
// not delete the page.
//
// Two button tiers on the SAGAME66 palette (ทอง + เงินโครเมียม บนน้ำตาลเกือบดำ
// ตามโลโก้ที่ SA เป็นทองสามมิติ GAME เป็นเงินโครเมียม แล้ว 66 กลับมาเป็นทอง):
// สมัครสมาชิก คือแอ็กชันหลัก จึงได้พื้นไล่ทองเต็มใบ (#ffe9a3 → #e8b93f →
// #96671a) ตัวอักษรเป็นหมึกเกือบดำ #0d0903 เพื่อให้คอนทราสต์บนทองอ่านออก
// ส่วน เข้าสู่ระบบ เป็นแอ็กชันรอง จึงเป็นเส้นขอบทองแบรนด์ #e8b93f บนพื้นการ์ด
// #171006 ตัวอักษรเนื้อความ #e3d8c0 (hover ยกผิวขึ้นเป็น #2a1d0b ขอบทองสว่าง
// #ffe9a3 และตัวอักษรเงินโครเมียม #eef3f8) — แดงคริมสันของ UFAGOOL รอบก่อน
// (#c50d12 / #ef1f25 / #7a0103 / #16100f / #cdd5dd / #f4f7fa) หายไปทั้งหมด
//
// Announcement รอบนี้หมุนมาใช้ Announcement5 ทั้งเว็บ — default message ของไฟล์นั้น
// ถูกตั้งเป็นคอปปี้ของแบรนด์นี้แล้ว และ index ก็เรียกแบบ bare จึงห้ามส่ง prop
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 152
const pageDescription = "ทางเข้า SAGAME66 เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ทันที เพื่อเข้าเล่นบาคาร่า รูเล็ต และคาสิโนสดจากบัญชีเดียว รองรับมือถือและคอมพิวเตอร์";

const graph = pageGraph(Astro, {
  name: "ทางเข้า SAGAME66 เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ทางเข้า SAGAME66 เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า SAGAME66 เว็บหลัก" as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ SAGAME66"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#e8b93f]/70 bg-[#171006] px-6 py-4 shadow-[0_10px_30px_rgba(13,9,3,0.7)] transition-all duration-300 hover:scale-105 hover:border-[#ffe9a3] hover:bg-[#2a1d0b] hover:shadow-[0_15px_40px_rgba(232,185,63,0.45)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#e8b93f]/30 to-transparent"></div>

          <svg class="h-9 w-9 text-[#e3d8c0] transition-colors group-hover:text-[#eef3f8]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#e3d8c0] transition-colors group-hover:text-[#eef3f8]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก SAGAME66"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ffe9a3]/70 bg-gradient-to-r from-[#ffe9a3] via-[#e8b93f] to-[#96671a] px-6 py-4 shadow-[0_10px_30px_rgba(232,185,63,0.40)] transition-all duration-300 hover:scale-105 hover:border-[#eef3f8] hover:shadow-[0_15px_40px_rgba(238,243,248,0.45)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#eef3f8]/30 to-transparent"></div>

          <svg class="h-9 w-9 text-[#0d0903]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#0d0903]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
