---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
// Heading inventory for this page must stay h1x1, h2x0, h3x0.
//
// The <h1> names what the page IS ("ทางเข้า <brand> เว็บหลัก"), not what an
// article on it would have argued — a title that previews a body reads as a
// broken promise once the body is gone, and is the line most likely to tempt
// the next rebrand into writing it back.
//
// This route stays OUT of the navbar menu on purpose while the cta toggle is on
// (/login and /register are menu entries themselves), but it is still routed,
// still indexed and still linked from the footer. Do not add a nav link and do
// not delete the page.
//
// Two button tiers on the DM899 palette (brand-spec §2 เขียวมรกตนำ แดงสดรอง
// ทองเสริม บนดำอมเขียว — มาจาก logo.webp ที่เป็นตัว D เขียว #01841b ซ้อนตัว M แดง
// #fb252b และเลข 899 เงินโครเมียม):
// สมัครสมาชิก คือแอ็กชันหลัก จึงได้ไล่เฉด **เขียว** เต็มใบ (#4ade6b → #01a326 →
// #01841b) ขอบเขียวแกน #01841b ตัวอักษร **ดำอมเขียว #06140a** — กฎคอนทราสต์:
// หมึกขาวบนเขียวอ่อน #4ade6b ตก พื้นเขียวจึงต้องใช้หมึกเข้มเสมอ (#06140a ≈ 11:1)
// ส่วน เข้าสู่ระบบ เป็นแอ็กชันรอง จึงเป็นแบบ outline — กรอบทองแบรนด์ #f2b422/60
// ตัวอักษรทองอ่อน #ffe9a8 บนพื้นยกระดับ #102a16 hover ยกกรอบเป็นทองเต็ม #f2b422
// ลำดับความสำคัญจึงสื่อด้วย "ถมเขียว vs กรอบทองบนพื้นดำอมเขียว" ไม่ใช่ถมสีเดียวกัน
// สองใบ ซึ่งจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม — และไม่ใช่เขียวจางๆ ซึ่งอ่านเป็นปุ่มที่ปิดใช้งาน
// ออราด้านบนของปุ่มใช้คู่ตรงข้ามตามลายเซ็นโลโก้: ปุ่มรองเป็นเขียว rgba(1,163,38,α)
// ปุ่มหลักเป็นทองอ่อนไล่ลงไปใส
// ชุดทอง-เงินโครเมียมของ 1SS365 (#edbb23 #ffeeb4 #a87708 #c8cbce #f1f2f3 #121010
// #f0e6d2 #050505 #2a2115 #f7d458 #1a1710 #c9930f rgba(237,187,35,*) rgba(5,5,5,*)
// rgba(247,212,88,*)) ถูกแทนครบแล้ว
//
// Announcement หมุนมาเป็น Announcement3 ทั้งเว็บรอบนี้ (รอบก่อนเป็น
// AnnouncementPremium) — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ
// DM899 แล้ว และ index ก็เรียกแบบ bare จึงห้ามส่ง prop message จากหน้านี้
//
// DM899 เป็นสล็อตคาสิโนออนไลน์เว็บตรงต่างประเทศ — ไม่ใช่เว็บหวยและไม่ใช่บอล
// บรีฟรอบนี้พูดถึงการเลือกประเภทการเดิมพันได้จากบัญชีเดียว ทั้งเกมสล็อต เกมคาสิโนสด
// และหมวดเกมอื่นตามผู้ให้บริการที่เชื่อมต่อกับระบบ พร้อมสลับหมวดเกม ตรวจสอบเครดิต
// และดูประวัติรายการได้โดยไม่ต้องสมัครบัญชีใหม่แยกตามค่าย
// คำศัพท์หวยของแบรนด์ก่อนหน้า (หวย แทงหวย ส่งโพย โพย เลือกเลข 2 ตัว 3 ตัว อัตราจ่าย
// งวด รัฐบาลไทย ฮานอย ลาวพัฒนา หวยหุ้น ตรวจหวย แนวทางหวย) ห้ามหลงเหลือ
// และห้ามเพิ่มใบอนุญาต ชื่อค่ายเกม ชื่อธนาคาร ยอดฝากขั้นต่ำ หรือชื่อผู้ให้บริการจริง
// ที่บรีฟไม่ได้ระบุ หน้านี้มีโควตาเป็นปุ่มสองปุ่มเท่านั้น
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 154
const pageDescription = `ทางเข้า ${BRAND_NAME} เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ เพื่อเลือกเกมสล็อตเว็บตรงต่างประเทศ ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการจากบัญชีเดียว`;

const graph = pageGraph(Astro, {
  name: `ทางเข้า ${BRAND_NAME} เว็บหลัก`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title={`ทางเข้า ${BRAND_NAME} เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ทางเข้า ${BRAND_NAME} เว็บหลัก`} as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f2b422]/60 bg-[#102a16] px-6 py-4 shadow-[0_10px_30px_rgba(3,10,5,0.75)] transition-all duration-300 hover:scale-105 hover:border-[#f2b422] hover:shadow-[0_15px_40px_rgba(242,180,34,0.32)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#01a326]/28 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#ffe9a8] transition-colors group-hover:text-[#f2b422]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#ffe9a8] transition-colors group-hover:text-[#f2b422]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#01841b] bg-gradient-to-r from-[#4ade6b] via-[#01a326] to-[#01841b] px-6 py-4 shadow-[0_10px_30px_rgba(1,163,38,0.40)] transition-all duration-300 hover:scale-105 hover:border-[#ffe9a8] hover:shadow-[0_15px_40px_rgba(74,222,107,0.35)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ffe9a8]/35 to-transparent"></div>

          <svg class="h-9 w-9 text-[#06140a]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#06140a]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
