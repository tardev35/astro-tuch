---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
// Heading inventory for this page must stay h1x1, h2x0, h3x0.
//
// This route stays OUT of the navbar menu on purpose while the cta toggle is on
// (/login and /register are menu entries themselves), but it is still routed,
// still indexed and still linked from the footer. Do not add a nav link and do
// not delete the page.
//
// Two button tiers on the SEXYGAME666 palette (ชมพูบานเย็นนีออน + ม่วง บนพื้น
// เกือบดำ ตามโลโก้ที่ SEXY เป็นชมพูบานเย็น GAME ไล่ไปเป็นม่วง และ 666 กลับมาเป็น
// ชมพู): สมัครสมาชิก คือแอ็กชันหลัก จึงได้ไล่เฉดประจำแบรนด์เต็มใบ (#ffb3e2 →
// #fa42b5 → #c9a4ff ชมพูไหลไปม่วงตามลำดับตัวอักษรในโลโก้) ตัวอักษรหมึกเข้ม
// #12041c เพราะตัวหนังสือบนพื้นชมพูสว่างต้องเป็นสีเข้ม ห้ามใช้ขาว — ปลายไล่เฉด
// จงใจหยุดที่ม่วงอ่อน #c9a4ff ไม่ใช่ม่วงเข้ม #8b3df3 เพราะหมึกเข้มบนม่วงเข้มเหลือ
// คอนทราสต์แค่ ~3.5:1 ส่วนบนม่วงอ่อนได้ ~9:1 ส่วน เข้าสู่ระบบ เป็นแอ็กชันรอง จึง
// เป็นฝั่ง "GAME" ของโลโก้ — เส้นขอบม่วง #8b3df3 บนผิวการ์ดเกือบดำ #0f0518
// ตัวอักษรเนื้อความ #f2dcee (hover ยกผิวขึ้นเป็น #140722 ขอบม่วงอ่อน #c9a4ff และ
// ตัวอักษรเน้น #fff2fb) — ชมพูคู่ม่วง ไม่ใช่ชมพูสองใบ
// ชุดทอง+เขียวของแบรนด์ก่อนหน้า (#fde90e #fff89a #f5c518 #35d413 #5df53a #10160a
// #0b1408 #101a0b #e9f0dd #fbffe8 rgba(253,233,14,*) rgba(53,212,19,*)
// rgba(3,6,2,*)) ถูกแทนครบทุกจุดแล้ว
//
// Announcement หมุนจาก Announcement2 มาเป็น Announcement5 ทั้งเว็บรอบนี้ —
// default message ของไฟล์นั้นเป็นคอปปี้ของ SEXYGAME666 แล้ว และ index ก็เรียกแบบ
// bare จึงห้ามส่ง prop message จากหน้านี้
//
// SEXYGAME666 เป็นแบรนด์เกมเซ็กซี่บาคาร่า/คาสิโนไลฟ์สด — บรีฟพูดถึงโต๊ะบาคาร่า
// และเกมคาสิโนสดตามรายการที่เปิดให้บริการ ผู้ให้บริการต่างประเทศ เมนูค้นหาง่าย
// และการรองรับมือถือ/คอมพิวเตอร์เท่านั้น ห้ามพูดถึงสล็อต ค่ายเกม ชื่อโต๊ะ หวย บอล
// ใบอนุญาต ธนาคาร เครดิตฟรี หรือฝากถอนออโต้ และห้ามลิงก์ไปเราต์ที่ถูกปิดไว้รอบนี้
// (/ตรวจหวย และ /แนวทาง)
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 157
const pageDescription = "ทางเข้า SEXYGAME666 เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ เพื่อเลือกโต๊ะบาคาร่าและเกมคาสิโนไลฟ์สดที่เปิดให้บริการ รองรับทั้งมือถือและคอมพิวเตอร์";

const graph = pageGraph(Astro, {
  name: "ทางเข้า SEXYGAME666 เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ทางเข้า SEXYGAME666 เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า SEXYGAME666 เว็บหลัก" as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ SEXYGAME666"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#8b3df3]/70 bg-[#0f0518] px-6 py-4 shadow-[0_10px_30px_rgba(4,1,8,0.85)] transition-all duration-300 hover:scale-105 hover:border-[#c9a4ff] hover:bg-[#140722] hover:shadow-[0_15px_40px_rgba(139,61,243,0.30)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#8b3df3]/28 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#f2dcee] transition-colors group-hover:text-[#fff2fb]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#f2dcee] transition-colors group-hover:text-[#fff2fb]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก SEXYGAME666"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ffb3e2]/70 bg-gradient-to-r from-[#ffb3e2] via-[#fa42b5] to-[#c9a4ff] px-6 py-4 shadow-[0_10px_30px_rgba(250,66,181,0.40)] transition-all duration-300 hover:scale-105 hover:border-[#c9a4ff] hover:shadow-[0_15px_40px_rgba(139,61,243,0.30)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ffb3e2]/30 to-transparent"></div>

          <svg class="h-9 w-9 text-[#12041c]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#12041c]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
