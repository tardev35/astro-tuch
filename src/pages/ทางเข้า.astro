---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
// Every paragraph that has ever been on this page was invented by an earlier
// rebrand, not by the brief: the docx SUB-PAGES section gives this route a
// Title and a Meta and never a body (รอบนี้บรีฟไม่มีส่วน SUB-PAGES เลย).
// Heading inventory must stay h1x1 h2x0 h3x0.
//
// The <h1> names what the page IS ("ทางเข้า <brand> เว็บหลัก"), not what an
// article on it would have argued — a title that previews a body reads as a
// broken promise once the body is gone, and is the line most likely to tempt
// the next rebrand into writing it back.
//
// cta toggle รอบนี้เปิด: /login และ /register เป็น button page ที่ index ได้
// หน้านี้จึงถูกถอดออกจากเมนูนาวบาร์ตามกติกา (เพราะเป็นลิงก์ที่สามไปที่เดียวกัน)
// แต่ยัง route และ index อยู่ และฟุตเตอร์ยังลิงก์มาที่นี่ — ห้ามลบไฟล์นี้ และห้ามย้าย
// ไป src/pages-disabled/
//
// แบรนด์รอบนี้ (รอบชมพูฮอตพิงก์-ทองบนพลัมเข้ม 2026-10-12, brand-spec §2):
// โลโก้เป็นเครื่องเกมพกพาสีชมพูหน้ายิ้มขยิบตา เหนือคำว่า PUNPRO ตัวหนาสามมิติชมพู
// บานเย็นขอบทอง และเลข 168 ตัวหนาสามมิติสีทองวาว แบนเนอร์กับสไลด์เป็นสาวผมชมพู
// สัตว์การ์ตูนสวมมงกุฎ เหรียญทอง และหัวใจชมพู บนพื้นดำประกายชมพู-ทอง
// พื้นเพจจาก bg.json รอบนี้เป็น {"mode":"color","color":"#2e0022"}
// = **พลัมเข้มอมม่วง ไม่ใช่ดำสนิท** จึงมีชั้นที่ลึกกว่าพื้นเพจได้
// ชมพูฮอตพิงก์ #f41571 (ฮิวนำ) · ชมพูสว่าง #ff5ca8 (ระดับสอง) ·
// ทองสว่าง #fce343 (ฮิวที่สอง) · ทองอำพัน #ffc554 (ปลายเข้มสุดของไล่เฉดทอง) ·
// ทองไฮไลต์ #ffd94a (สงวนไว้ให้ <strong> ในย่อหน้าเท่านั้น) ·
// เนื้อความ #fde7f2 (= BRAND_TEXT ที่การ์ด ContentBox ตั้งให้แล้ว) ·
// เส้น/ออรา #8a0a45 และ #4a0426 · หมึกบนพื้นถม #2a0012
// ชั้นผิว: ยก #4a1038 (= การ์ด) / กลาง #3a0a2a / พื้นเพจ #2e0022 / จม #1c0014
//
// ขั้วของปุ่มตามสเปก (พื้นสว่าง = หมึกเข้ม · พื้นเข้ม = หมึกสว่าง):
// สมัครสมาชิก = แอ็กชันหลัก ถม **ทองไล่เฉด** #fce343 → #ffc554 ขอบ #8a0a45
// บนหมึกเข้ม #2a0012 (บนปลายเข้มสุด #ffc554 ได้ 12.1:1)
// เข้าสู่ระบบ = แอ็กชันรอง จมลงจากการ์ดด้วยชั้น #3a0a2a → #1c0014
// ขอบชมพู #f41571/55 บนเนื้อความ #fde7f2 — hover ยกขอบเป็นชมพูเต็ม
// ⚠️ ห้ามกลับด้าน และ **ห้ามไล่เฉดทองเข้มกว่า #ffc554** ใต้ตัวอักษร ·
// #8a0a45 #4a0426 ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่เส้นขอบ ออรา และเงา
// ออราด้านบนของปุ่มใช้ปลายสว่างของฮิวตัวเอง rgba(244,21,113,α) และ
// rgba(252,227,67,α) ไม่มี rgba อื่นในไฟล์นี้นอกจากเงาดำล้วน
// ⚠️ ทั้งชมพูและทองเคยมาแล้วทั้งคู่ในรอบก่อนๆ "เจอชมพู" หรือ "เจอทอง" ไม่ได้แปลว่า
// เป็นของรอบนี้ ให้เทียบเป็น "ค่า" ทีละตัวกับตารางแบนใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำ
// ที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive — ชุดทองอำพันของแบรนด์ก่อน
// ออกครบทุกจุดในไฟล์นี้แล้ว และรอบนี้ **ไม่มีเขียว ไม่มีน้ำเงิน ไม่มีเทา**
//
// Announcement หมุนมาเป็น Announcement3 ทั้งเว็บรอบนี้ (รอบก่อนใช้ Announcement5 —
// brand-spec §3 หมุนออก) — default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์ปัจจุบันแล้ว
// และทุกหน้าเรียกแบบ bare จึงห้ามส่ง prop message จากหน้านี้ ไม่งั้นตัววิ่งจะไม่ตรงกับ
// index.astro
//
// แบรนด์นี้เป็น **เว็บเล่นสล็อตออนไลน์ล้วน** (สล็อตปันโปรในตำนาน) ไม่ใช่เว็บคาสิโนรวม
// แบบแบรนด์ก่อน ไม่ใช่เว็บกีฬา และไม่ใช่เว็บของหมวดลอตเตอรี สองหน้าของหมวดนั้นยัง
// park อยู่ใน src/pages-disabled/ จึงไม่มี route และลิงก์ค้างจะกลายเป็น href ตาย
// ที่ทำให้บิลด์แดง รายการคำต้องห้ามเต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาคำของแบรนด์เก่าเจอ false positive
// ⚠️ ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 0.3% / 0.8% / 3 ขั้นตอน / 24 ชั่วโมง / ปี 2026
// ห้ามแต่งชื่อค่ายเกม ชื่อธนาคาร เลขใบอนุญาต หน่วยงานกำกับ ค่า RTP ยอดฝากขั้นต่ำ
// จำนวนสมาชิก หรือปีก่อตั้ง — หน้านี้มีโควตาเป็นปุ่มสองปุ่มเท่านั้น
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้ไม่มี UTF-8 locale จึงนับเป็นไบต์ = เกินจริงราว 3 เท่า)
// หน้านี้ยาว 154
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ทำให้ตัวนับเห็นเป็น 5 อักขระ
const pageDescription = `ทางเข้า ${BRAND_NAME} เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ สล็อตปันโปรในตำนาน รวมสล็อตคลาสสิก เกมโบนัส และฟรีสปิน ไว้ในระบบเดียว ตลอด 24 ชั่วโมง`;

const graph = pageGraph(Astro, {
  name: `ทางเข้า ${BRAND_NAME} เว็บหลัก`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title={`ทางเข้า ${BRAND_NAME} เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ทางเข้า ${BRAND_NAME} เว็บหลัก`} as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f41571]/55 bg-gradient-to-b from-[#3a0a2a] to-[#1c0014] px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.6)] transition-all duration-300 hover:scale-105 hover:border-[#f41571] hover:shadow-[0_15px_40px_rgba(244,21,113,0.35)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#f41571]/25 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#fde7f2] transition-colors group-hover:text-[#ff5ca8]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#fde7f2]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#8a0a45] bg-gradient-to-b from-[#fce343] to-[#ffc554] px-6 py-4 shadow-[0_10px_30px_rgba(252,227,67,0.4)] transition-all duration-300 hover:scale-105 hover:border-[#2a0012] hover:shadow-[0_15px_40px_rgba(252,227,67,0.6)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#fce343]/60 to-transparent"></div>

          <svg class="h-9 w-9 text-[#2a0012]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-black tracking-wide text-[#2a0012]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
