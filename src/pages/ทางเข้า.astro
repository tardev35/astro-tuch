---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
// Heading inventory for this page must stay h1x1, h2x0, h3x0.
//
// The <h1> names what the page IS ("ทางเข้า <brand> เว็บหลัก"), not what an
// article on it would have argued — a title that previews a body reads as a
// broken promise once the body is gone, and is the line most likely to tempt
// the next rebrand into writing it back.
//
// This route stays OUT of the navbar menu on purpose while the cta toggle is on
// (/login and /register are menu entries themselves), but it is still routed,
// still indexed and still linked from the footer. Do not add a nav link and do
// not delete the page.
//
// Two button tiers on the หวย365 palette (brand-spec §2 แดงสด-ทอง-ดำ — แดงคือ
// สีตัวตน ทองคือสีเน้น ดำคือพื้น):
// สมัครสมาชิก คือแอ็กชันหลัก จึงได้ไล่เฉด **แดง** เต็มใบ (#f5282a → #dc0203 → #8c0402)
// ขอบทองลึก #c08a07 ตัวอักษร **ขาว** — กฎคอนทราสต์ brand-spec §2: หมึกเข้ม #1a0303
// บนพื้นแดงได้แค่ 2.8:1 ตก พื้นแดงจึงต้องใช้หมึกขาวเสมอ (ขาวบน #dc0203 ≈ 5.1:1)
// ส่วน เข้าสู่ระบบ เป็นแอ็กชันรอง จึงเป็นแบบ outline **ทอง** — กรอบ #c08a07 ตัวอักษร
// ทองแบรนด์ #ffc93c บนพื้นยกระดับ #3a0a0c (≈11:1) hover ยกเป็นทองอ่อน #ffeab0
// ลำดับความสำคัญจึงสื่อด้วย "ถมแดง vs กรอบทองบนพื้นดำอมแดง" ไม่ใช่ถมสีเดียวกันสองใบ
// ซึ่งจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม — และไม่ใช่แดงจางๆ ซึ่งอ่านเป็นปุ่มที่ปิดใช้งาน
// ชุดทอง-เงินของ NATO168 (#edb543 #fde8a8 #a9761f #e6e6e6 #101010 #1a1203 #241a09
// #17120a rgba(237,181,67,*) rgba(230,230,230,*) rgba(253,232,168,*) rgba(4,3,0,*))
// ถูกแทนครบแล้ว
//
// Announcement หมุนมาเป็น AnnouncementHuay ทั้งเว็บรอบนี้ (รอบก่อนเป็น Announcement5)
// — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ หวย365 แล้ว และ index
// ก็เรียกแบบ bare จึงห้ามส่ง prop message จากหน้านี้
//
// หวย365 เป็นเว็บแทงหวยออนไลน์ ไม่ใช่สล็อตและไม่ใช่บอล — บรีฟรอบนี้พูดถึงการรวม
// รายการหวยหลายประเภทไว้ในบัญชีเดียว ทั้งรัฐบาลไทย ฮานอย ลาวพัฒนา และหวยหุ้น
// ต่างประเทศ พร้อมเลือกเลข ส่งโพย และตรวจสอบรายการผ่านมือถือ
// คำศัพท์ของแบรนด์ก่อนหน้า (สล็อต พีจี PG ค่ายเกม ฟรีสปิน ตัวคูณ วงล้อ ปั่น โบนัสไทม์
// โบนัสทุกยูส ไม่มีล็อคยูส RTP คาสิโนสด บาคาร่า บอล ค่าน้ำ ลีก) ห้ามหลงเหลือ
// และห้ามเพิ่มใบอนุญาต ชื่อธนาคาร ยอดฝากขั้นต่ำ หรือชื่อผู้ให้บริการจริง ที่บรีฟไม่ได้ระบุ
// หน้านี้มีโควตาเป็นปุ่มสองปุ่มเท่านั้น
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 152
const pageDescription = `ทางเข้า ${BRAND_NAME} เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ เพื่อเลือกเลขและส่งโพยหวยรัฐบาลไทย ฮานอย ลาวพัฒนา และหวยหุ้นต่างประเทศได้จากบัญชีเดียว`;

const graph = pageGraph(Astro, {
  name: `ทางเข้า ${BRAND_NAME} เว็บหลัก`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title={`ทางเข้า ${BRAND_NAME} เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ทางเข้า ${BRAND_NAME} เว็บหลัก`} as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#c08a07]/70 bg-[#3a0a0c] px-6 py-4 shadow-[0_10px_30px_rgba(8,1,1,0.75)] transition-all duration-300 hover:scale-105 hover:border-[#ffc93c] hover:shadow-[0_15px_40px_rgba(255,201,60,0.30)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ffc93c]/22 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#ffc93c] transition-colors group-hover:text-[#ffeab0]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#ffc93c] transition-colors group-hover:text-[#ffeab0]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#c08a07] bg-gradient-to-r from-[#f5282a] via-[#dc0203] to-[#8c0402] px-6 py-4 shadow-[0_10px_30px_rgba(220,2,3,0.40)] transition-all duration-300 hover:scale-105 hover:border-[#ffc93c] hover:shadow-[0_15px_40px_rgba(245,40,42,0.35)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#f5282a]/40 to-transparent"></div>

          <svg class="h-9 w-9 text-white" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-white">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
