---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
// Heading inventory for this page must stay h1x1, h2x0, h3x0.
//
// The <h1> names what the page IS ("ทางเข้า <brand> เว็บหลัก"), not what an
// article on it would have argued — a title that previews a body reads as a
// broken promise once the body is gone, and is the line most likely to tempt
// the next rebrand into writing it back.
//
// This route stays OUT of the navbar menu on purpose while the cta toggle is on
// (/login and /register are menu entries themselves), but it is still routed,
// still indexed and still linked from the footer. Do not add a nav link and do
// not delete the page.
//
// Two button tiers on the HI59 palette (brand-spec §2 **ฟ้าสว่าง + ทอง VIP บน
// การ์ดสว่าง** — โลโก้รอบนี้คือ HI ฟ้า + 59 ทอง ในวงแหวนทอง/ฟ้าบนพื้นใส แบนเนอร์
// กับสไลด์เป็นท้องฟ้ากลางวัน และ bg.json เป็นม่วงฟ้าอ่อน #c1cce6 รอบก่อนเป็น
// แดง/เงินบนผิวเกือบดำ รอบนี้จึงพลิกทั้งขั้วความสว่าง ไม่ใช่แค่เปลี่ยนเบอร์สี):
// สมัครสมาชิก คือแอ็กชันหลัก จึงถม **ทอง** เต็มใบ (#ffe27a → #fdbc04 → #c88a02)
// ขอบทองเข้ม #c88a02 บนหมึก **กรมท่า #04203f** — กฎคอนทราสต์ของสเปก: พื้นทอง
// ห้ามใช้ตัวอักษรขาวหรือครีมเด็ดขาด
// ส่วน เข้าสู่ระบบ เป็นแอ็กชันรอง จึงถม **ฟ้าลึก** (#065a9c → #044b80 → #033f70)
// ขอบฟ้าแบรนด์ #0a84e0 บนหมึก #eaf5ff — #0a84e0 เป็นสีขอบ/เรืองแสง ไม่ใช่พื้น
// ของตัวอักษรเล็ก hover ยกขอบเป็นทองอ่อน #ffe27a ให้คู่ปุ่มสลับไฮไลต์กัน
// ลำดับความสำคัญจึงสื่อด้วยคู่ "ทองถม vs ฟ้าถม" ซึ่งเป็นสองสีบนโลโก้จริงของรอบนี้
// และตรงกับคู่ปุ่มของ NavbarStyle6 ที่ orchestrator รีธีมไว้แล้ว
// ออราด้านบนของปุ่มใช้สีของตัวเอง: ปุ่มทองเป็น rgba(255,226,122,α) ปุ่มฟ้าเป็น
// rgba(94,194,255,α)
// ชุดแดง+เงินของ หวยดีใจ (#dc0409 #f5363d #8e0206 #4b0205 #e8161c #eef0f4
// #c3c7d1 #f3c54e #edeaf0 #211016 #17080c rgba(220,4,9,*) rgba(245,54,61,*)
// rgba(195,199,209,*)) ถูกแทนครบแล้ว
//
// Announcement หมุนมาเป็น Announcement2 ทั้งเว็บรอบนี้ (แบรนด์ก่อนใช้
// Announcement5) — default message ของไฟล์นั้นเป็นคอปปี้ของ HI59 แล้ว และ
// index ก็เรียกแบบ bare จึงห้ามส่ง prop message จากหน้านี้
//
// HI59 เป็น **เว็บสล็อต** ไม่ใช่เว็บหวย — คำหมวดหวย (หวย ส่งโพย โพย เลข 2 ตัว
// เลข 3 ตัว แนวทาง อัตราจ่าย งวด ผลรางวัล หวยลาว หวยฮานอย ธ.ก.ส.) ห้ามหลงเหลือ
// บรีฟระบุว่าหลัง Login สมาชิกเลือกค่าย ค้นหาเกม ตรวจสอบเครดิต โปรโมชั่น และ
// ประวัติรายการได้จากบัญชีเดียว รองรับทั้งมือถือและคอมพิวเตอร์
// ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 0.3% / 0.8% / 100% / 24 ชั่วโมง ห้ามแต่งชื่อค่ายเกม
// ชื่อธนาคาร เลขใบอนุญาต ยอดฝากขั้นต่ำ หรือจำนวนสมาชิกที่บรีฟไม่ได้ระบุ
// หน้านี้มีโควตาเป็นปุ่มสองปุ่มเท่านั้น
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 155
const pageDescription = `ทางเข้า ${BRAND_NAME} เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ เพื่อเข้าเล่นสล็อตจากค่ายเกมพรีเมียม ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการผ่านบัญชีเดียว`;

const graph = pageGraph(Astro, {
  name: `ทางเข้า ${BRAND_NAME} เว็บหลัก`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title={`ทางเข้า ${BRAND_NAME} เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ทางเข้า ${BRAND_NAME} เว็บหลัก`} as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#0a84e0] bg-gradient-to-r from-[#065a9c] via-[#044b80] to-[#033f70] px-6 py-4 shadow-[0_10px_30px_rgba(3,63,112,0.45)] transition-all duration-300 hover:scale-105 hover:border-[#ffe27a] hover:shadow-[0_15px_40px_rgba(94,194,255,0.40)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#5ec2ff]/30 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#5ec2ff] transition-colors group-hover:text-[#ffe27a]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#eaf5ff]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#c88a02] bg-gradient-to-r from-[#ffe27a] via-[#fdbc04] to-[#c88a02] px-6 py-4 shadow-[0_10px_30px_rgba(253,188,4,0.40)] transition-all duration-300 hover:scale-105 hover:border-[#8a6102] hover:shadow-[0_15px_40px_rgba(255,226,122,0.50)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ffe27a]/45 to-transparent"></div>

          <svg class="h-9 w-9 text-[#04203f]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#04203f]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
