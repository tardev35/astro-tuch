---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
// Heading inventory for this page must stay h1x1, h2x0, h3x0.
//
// The <h1> names what the page IS ("ทางเข้า <brand> เว็บหลัก"), not what an
// article on it would have argued — a title that previews a body reads as a
// broken promise once the body is gone, and is the line most likely to tempt
// the next rebrand into writing it back.
//
// This route stays OUT of the navbar menu on purpose while the cta toggle is on
// (/login and /register are menu entries themselves), but it is still routed,
// still indexed and still linked from the footer. Do not add a nav link and do
// not delete the page.
//
// Two button tiers on the BOOM369 palette (brand-spec §2 **เขียวนีออนบนพื้นดำ** —
// โลโก้รอบนี้คือ BOOM เขียวนีออน + 369 เงินโครเมียม ในวงแหวนเขียว-เทอร์ควอยซ์บน
// พื้นใส แบนเนอร์กับสไลด์เป็นห้องโถงมืดที่ส่องด้วยไฟนีออนเขียวพร้อมชิปกับเหรียญทอง
// และ bg.json เป็น {"mode":"color","color":"#000000"} = พื้นดำสนิท รอบก่อน (HI59)
// เป็นฟ้า/ทองบนการ์ดสว่าง รอบนี้จึงพลิกทั้งขั้วความสว่าง ไม่ใช่แค่เปลี่ยนเบอร์สี):
// สมัครสมาชิก คือแอ็กชันหลัก จึงถม **เขียวนีออนไล่เฉด** (#42fb5a → #04ab3a →
// #036b26) ขอบเขียวลึก #036b26 บนหมึก **#03150a** — กฎคอนทราสต์ของสเปก: พื้น
// #42fb5a/#04ab3a ห้ามใช้ตัวอักษรขาวหรืออ่อนเด็ดขาด (#04ab3a กับขาว ≈ 3.1:1)
// ส่วน เข้าสู่ระบบ เป็นแอ็กชันรอง จึงถม **ผิวการ์ดเข้ม** (#0b231b → #041109)
// ขอบ #42fb5a/60 บนหมึก #cfe9d7 — #42fb5a เป็นสีขอบ ไอคอน และแสงเรือง
// ลำดับความสำคัญจึงสื่อด้วยคู่ "เขียวถม vs ผิวเข้มขอบเขียว" ซึ่งมาจากโลโก้จริง
// ของรอบนี้ และตรงกับคู่ปุ่มของ NavbarCyber ที่ orchestrator รีธีมไว้แล้ว
// ออราด้านบนของปุ่มใช้สีของตัวเอง: ปุ่มเขียวถมเป็น rgba(66,251,90,α) ส่วนปุ่มผิว
// เข้มใช้ #42fb5a/25 เป็นแสงบางด้านบน
// ชุดผิวฟ้าอ่อน หมึกกรมท่า ลิงก์ฟ้า และทองของ HI59 ถูกแทนครบแล้ว ทั้งคลาส
// Tailwind raw hex และ rgba() (ค่าเดิมอยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive)
//
// Announcement หมุนมาเป็น AnnouncementCyber ทั้งเว็บรอบนี้ (แบรนด์ก่อน HI59 ใช้
// Announcement2) — default message ของไฟล์นั้นเป็นคอปปี้ของ BOOM369 แล้ว และ
// index ก็เรียกแบบ bare จึงห้ามส่ง prop message จากหน้านี้
//
// BOOM369 เป็น **เว็บสล็อตเบทต่ำ** ไม่ใช่เว็บหวย — คำหมวดหวย (หวย โพย เลขเด็ด
// แนวทาง งวด อัตราจ่าย) ห้ามหลงเหลือ และคำของแบรนด์ก่อน (ไฮคลาส VIP
// ส่งตรงจากเว็บแม่ ยอดเข้าบริษัทตรง ไม่ผ่านบัญชีม้า ค่ายเกมพรีเมียม) ก็ห้ามเช่นกัน
// บรีฟระบุว่าหลัง Login สมาชิกใช้บัญชีเดียวค้นหาเกมสล็อต ดูเครดิต โปรโมชั่น และ
// ประวัติรายการได้ เข้าเล่นผ่านมือถือได้สะดวก
// ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 0.3% / 0.8% / 100% / 24 ชั่วโมง / 3 ขั้นตอน
// ห้ามแต่งชื่อค่ายเกม ชื่อธนาคาร เลขใบอนุญาต ยอดฝากขั้นต่ำ หรือจำนวนสมาชิก
// หน้านี้มีโควตาเป็นปุ่มสองปุ่มเท่านั้น
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 159
const pageDescription = `ทางเข้า ${BRAND_NAME} เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ เพื่อเข้าเล่นสล็อตเบทต่ำจากเกมค่ายตรง ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการผ่านบัญชีเดียว`;

const graph = pageGraph(Astro, {
  name: `ทางเข้า ${BRAND_NAME} เว็บหลัก`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title={`ทางเข้า ${BRAND_NAME} เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ทางเข้า ${BRAND_NAME} เว็บหลัก`} as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#42fb5a]/60 bg-gradient-to-b from-[#0b231b] to-[#041109] px-6 py-4 shadow-[0_10px_30px_rgba(3,21,10,0.55)] transition-all duration-300 hover:scale-105 hover:border-[#42fb5a] hover:shadow-[0_15px_40px_rgba(66,251,90,0.40)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#42fb5a]/25 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#42fb5a] transition-colors group-hover:text-[#ffffff]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#cfe9d7]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#036b26] bg-gradient-to-b from-[#42fb5a] via-[#04ab3a] to-[#036b26] px-6 py-4 shadow-[0_10px_30px_rgba(66,251,90,0.40)] transition-all duration-300 hover:scale-105 hover:border-[#03150a] hover:shadow-[0_15px_40px_rgba(66,251,90,0.55)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#42fb5a]/45 to-transparent"></div>

          <svg class="h-9 w-9 text-[#03150a]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-black tracking-wide text-[#03150a]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
