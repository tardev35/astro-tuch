---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
// Heading inventory for this page must stay h1x1, h2x0, h3x0.
//
// This route stays OUT of the navbar menu on purpose while the cta toggle is on
// (/login and /register are menu entries themselves), but it is still routed,
// still indexed and still linked from the footer. Do not add a nav link and do
// not delete the page.
//
// Two button tiers on the UWIN33 palette (ทอง + โครเมียม + ดำ ตามโลโก้ที่ตัว U และ
// เลข 33 เป็นทองสามมิติ ส่วน WIN เป็นเงินโครเมียม): สมัครสมาชิก คือแอ็กชันหลัก จึงได้
// พื้นไล่ทองเต็มใบ (#fbd564 → #e0b429 → #7a5407) ตัวอักษรเกือบดำ #161106 เพราะ
// ตัวหนังสือบนพื้นทองต้องเป็นสีเข้ม ห้ามใช้ขาว ส่วน เข้าสู่ระบบ เป็นแอ็กชันรอง จึงเป็น
// เส้นขอบทองแบรนด์ #e0b429 บนผิวการ์ดเกือบดำ #161106 ตัวอักษรเนื้อความ #ece6d8
// (hover ยกผิวขึ้นเป็น #26200e ขอบทองสว่าง #fbd564 และตัวอักษรเน้น #fff8e6) —
// ชุดแดง-เงินของ MAHAGAME66 รอบก่อน (#de161d #ff4d52 #7a0a0e #e2e8ef #16090a
// #26100f #e8e3e1 #fff6f5 #080506) ถูกแทนครบทุกจุดแล้ว
//
// Announcement รอบนี้หมุนจาก Announcement5 มาเป็น AnnouncementPremium ทั้งเว็บ —
// default message ของ AnnouncementPremium เป็นคอปปี้ของ UWIN33 แล้ว และ index ก็
// เรียกแบบ bare จึงห้ามส่ง prop message จากหน้านี้
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 152
const pageDescription = "ทางเข้า UWIN33 เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ เพื่อเข้าเล่นบาคาร่า รูเล็ต ไฮโล สล็อต บอล และหวย ที่รวมไว้ในบัญชีเดียวตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  name: "ทางเข้า UWIN33 เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ทางเข้า UWIN33 เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า UWIN33 เว็บหลัก" as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ UWIN33"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#e0b429]/70 bg-[#161106] px-6 py-4 shadow-[0_10px_30px_rgba(8,6,2,0.85)] transition-all duration-300 hover:scale-105 hover:border-[#fbd564] hover:bg-[#26200e] hover:shadow-[0_15px_40px_rgba(224,180,41,0.45)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#e0b429]/30 to-transparent"></div>

          <svg class="h-9 w-9 text-[#ece6d8] transition-colors group-hover:text-[#fff8e6]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#ece6d8] transition-colors group-hover:text-[#fff8e6]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก UWIN33"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fbd564]/70 bg-gradient-to-r from-[#fbd564] via-[#e0b429] to-[#7a5407] px-6 py-4 shadow-[0_10px_30px_rgba(224,180,41,0.40)] transition-all duration-300 hover:scale-105 hover:border-[#dfe4ec] hover:shadow-[0_15px_40px_rgba(223,228,236,0.35)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#dfe4ec]/30 to-transparent"></div>

          <svg class="h-9 w-9 text-[#161106]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#161106]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
