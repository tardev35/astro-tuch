---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// Button page, not an article: the brief gives this route no body at all —
// รอบนี้บรีฟ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES เลย ทุกย่อหน้าที่เคยอยู่
// บนหน้านี้จึงเป็นของที่รีแบรนด์รอบก่อนๆ คิดขึ้นเอง ไม่ใช่ของบรีฟ
// ทั้งหน้ามีแค่ชื่อเรื่องจาก ContentBox แล้วต่อด้วยปุ่มสองปุ่ม
// ห้ามเขียนหัวข้อย่อยหรือย่อหน้าอธิบายใต้ชื่อเรื่อง — ไม่มีรายการ "ตรวจ N จุดก่อน
// ล็อกอิน" และไม่มีประโยคเตือนเรื่อง PIN/OTP ไม่ว่าคอปปี้นั้นจะเขียนดีแค่ไหน
//
// The <h1> names what the page IS ("ทางเข้า <brand> เว็บหลัก"), not what an
// article on it would have argued — a title that previews a body reads as a
// broken promise once the body is gone, and is the line most likely to tempt
// the next rebrand into writing it back.
//
// cta toggle รอบนี้เปิด: /login และ /register เป็น button page ที่ index ได้
// หน้านี้จึงถูกถอดออกจากเมนูนาวบาร์ตามกติกา (เพราะเป็นลิงก์ที่สามไปที่เดียวกัน)
// แต่ยัง route และ index อยู่ และฟุตเตอร์ยังลิงก์มาที่นี่ — ห้ามลบไฟล์นี้ และห้ามย้าย
// ไป src/pages-disabled/
//
// แบรนด์รอบนี้ (KMD88, รอบม่วงราชา-ทองบนดำสนิท 2026-10-13, brand-spec §2):
// โลโก้คือคำว่า KMD เป็นตัวอักษรสามมิติม่วงขัดเงาขอบทอง ต่อด้วยเลข 88 ทองเมทัลลิก
// ในวงแหวนทองบาง แบนเนอร์และสไลด์เป็นฉากคาสิโนดำที่ส่องด้วยริบบิ้นแสงม่วงกับ
// ตัวอักษรไทยทองสามมิติ — **สองฮิวจริง: ม่วงนำ ทองรอง** ไม่ใช่ทองล้วนแบบรอบก่อน
// พื้นเพจจาก bg.json รอบนี้เป็น {"mode":"color","color":"#000000"} = ดำสนิท
// จึงไม่มีชั้นที่ "ลึกกว่าพื้นเพจ" ได้จริง แผ่นที่จมสุดคือ #0a0213
// ชั้นผิว: ยก #1d0832 (= การ์ด ContentBox) / กลาง #140522 / จม #0a0213 / พื้น #000000
// ม่วงแบรนด์ #7505cc · ม่วงสว่าง #b453ff · ม่วงที่ถือตัวอักษรได้ #c07cff (5.3:1)
// และ #d9b8ff (8.6:1) · ทองแบรนด์ #e2b33f (8.1:1) · ทองสว่าง #ffdf8c (12.0:1) ·
// เนื้อความ #ece2f8 (= BRAND_TEXT ที่การ์ด ContentBox ตั้งให้แล้ว) ·
// หมึกบนพื้นถมทอง/พื้นสว่าง #1a0526
//
// ขั้วของปุ่มตามสเปก (พื้นสว่าง = หมึกเข้ม · พื้นเข้ม = หมึกสว่าง):
// สมัครสมาชิก = แอ็กชันหลัก ถม **ทองไล่เฉด** #ffdf8c → #e2b33f ขอบ #7a5a0a
// บนหมึกเข้ม #1a0526 (8.4:1 บนปลายเข้มสุด #e2b33f)
// เข้าสู่ระบบ = แอ็กชันรอง จมลงจากการ์ดด้วยชั้น #140522 → #0a0213
// ขอบม่วง #7505cc/55 บนเนื้อความ #ece2f8 — hover ยกขอบเป็นม่วงสว่าง #b453ff
// ⚠️ ห้ามกลับด้าน และ **ห้ามไล่เฉดทองเข้มกว่า #e2b33f** ใต้ตัวอักษร ·
// #7505cc #b453ff #3a0565 #2c0349 #7a5a0a ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่
// เส้นขอบ ออรา และเงา — ออราในไฟล์นี้ใช้ rgba(117,5,204,α) และ rgba(226,179,63,α)
// เท่านั้น นอกจากเงาดำล้วน
// ⚠️ กับดักรอบนี้คือ **ทั้งสองฮิว**: ทองออกมาแล้วเก้าในสิบสองรอบหลังสุด และม่วงก็
// เพิ่งออกสองรอบ "เจอทองหรือเจอม่วง" จึงไม่ได้พิสูจน์ว่าเป็นค่าของรอบนี้ ให้เทียบ
// เป็น "ค่า" ทีละตัวกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep
// หาสีของแบรนด์เก่าเจอ false positive — ชุดทองของแบรนด์ก่อนออกครบทุกจุดในไฟล์นี้แล้ว
// และรอบนี้ **ไม่มีชมพู ไม่มีเขียว ไม่มีน้ำเงิน ไม่มีแดง ไม่มีส้ม ไม่มีเทา/เงิน**
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ (brand-spec §3) —
// default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และทุกหน้าเรียกแบบ bare
// จึงห้ามส่ง prop message จากหน้านี้ ไม่งั้นตัววิ่งจะไม่ตรงกับ index.astro
//
// แบรนด์นี้เป็น **คาสิโนรวมเกม** (บาคาร่า · สล็อต · บอลออนไลน์) ไม่ใช่เว็บสล็อตล้วน
// ไม่ใช่เว็บกีฬาล้วน และไม่ใช่เว็บหมวดลอตเตอรี สองหน้าของหมวดนั้น park อยู่ใน
// src/pages-disabled/ จึงไม่มี route และลิงก์ค้างจะเป็น href ตายที่ทำให้บิลด์แดง
// คำที่ห้ามหลงเหลือทั้งหมดอยู่ใน brand-spec §1/§6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep
// หาคำของแบรนด์เก่าเจอ false positive
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 24 ชั่วโมง — ห้ามแต่งชื่อค่ายเกม
// ชื่อธนาคาร เลขใบอนุญาต หน่วยงานกำกับ ค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปี
// ใดๆ (บรีฟรอบนี้ไม่ได้เอ่ยปีไว้เลย) — หน้านี้มีโควตาเป็นปุ่มสองปุ่มเท่านั้น
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้ไม่มี UTF-8 locale จึงนับเป็นไบต์ = เกินจริงราว 3 เท่า)
// หน้านี้ยาว 157
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ทำให้ตัวนับเห็นเป็น 5 อักขระ
const pageDescription = `ทางเข้า ${BRAND_NAME} เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ คาสิโนรวมเกม บาคาร่า สล็อต บอลออนไลน์ ครบวงจรในแพลตฟอร์มเดียว พร้อมระบบเดิมพันออโต้ทุกประเภท`;

const graph = pageGraph(Astro, {
  name: `ทางเข้า ${BRAND_NAME} เว็บหลัก`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title={`ทางเข้า ${BRAND_NAME} เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ทางเข้า ${BRAND_NAME} เว็บหลัก`} as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#7505cc]/55 bg-gradient-to-b from-[#140522] to-[#0a0213] px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.6)] transition-all duration-300 hover:scale-105 hover:border-[#b453ff] hover:shadow-[0_15px_40px_rgba(117,5,204,0.45)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#7505cc]/35 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#ece2f8] transition-colors group-hover:text-[#d9b8ff]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#ece2f8]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#7a5a0a] bg-gradient-to-b from-[#ffdf8c] to-[#e2b33f] px-6 py-4 shadow-[0_10px_30px_rgba(226,179,63,0.4)] transition-all duration-300 hover:scale-105 hover:border-[#1a0526] hover:shadow-[0_15px_40px_rgba(226,179,63,0.6)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ffdf8c]/70 to-transparent"></div>

          <svg class="h-9 w-9 text-[#1a0526]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-black tracking-wide text-[#1a0526]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
