---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
//
// This route stays OUT of the navbar menu on purpose while the cta toggle is on
// (/login and /register are menu entries themselves), but it is still routed,
// still indexed and still linked from the footer. Do not add a nav link and do
// not delete the page.
//
// Two button tiers, per the PAOTUNG palette: สมัครสมาชิก is the conversion
// action and takes the solid logo-blue fill (#3b9ddd → #226ca9 → #054e83) with
// near-white text (#eef6fd); เข้าสู่ระบบ is the secondary action and takes the
// blue outline on the page black-navy surface (#020f1e). Blue leads and gold
// metallic (#e0bd72) is the sparing secondary — this brand carries no red.
//
// Announcement รอบนี้หมุนมาใช้ Announcement5 ทั้งเว็บ — default message ของไฟล์นั้น
// เป็นข้อความของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ได้
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 158.
const pageDescription =
  "ทางเข้า PAOTUNG เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกจากหน้านี้ เข้าเล่นสล็อต บาคาร่า หวย และกีฬาผ่านช่องทางหลักอย่างเป็นทางการ รองรับทั้งมือถือและคอมพิวเตอร์";

const graph = pageGraph(Astro, {
  name: "ทางเข้า PAOTUNG เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ทางเข้า PAOTUNG เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า PAOTUNG เว็บหลัก" as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ PAOTUNG"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#226ca9]/55 bg-[#020f1e] px-6 py-4 shadow-[0_10px_30px_rgba(34,108,169,0.18)] transition-all duration-300 hover:scale-105 hover:border-[#3b9ddd] hover:bg-[#0a325a] hover:shadow-[0_15px_40px_rgba(34,108,169,0.38)]">
          <div class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#226ca9]/28 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#3b9ddd]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#7fc4f0]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก PAOTUNG"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#054e83]/70 bg-gradient-to-r from-[#3b9ddd] via-[#226ca9] to-[#054e83] px-6 py-4 shadow-[0_10px_30px_rgba(34,108,169,0.30)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(34,108,169,0.48)]">
          <div class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#7fc4f0]/45 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#eef6fd]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#eef6fd]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
