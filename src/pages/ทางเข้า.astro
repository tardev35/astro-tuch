---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
// Heading inventory for this page must stay h1x1, h2x0, h3x0.
//
// The <h1> names what the page IS ("ทางเข้า <brand> เว็บหลัก"), not what an
// article on it would have argued — a title that previews a body reads as a
// broken promise once the body is gone, and is the line most likely to tempt
// the next rebrand into writing it back.
//
// This route stays OUT of the navbar menu on purpose while the cta toggle is on
// (/login and /register are menu entries themselves), but it is still routed,
// still indexed and still linked from the footer. Do not add a nav link and do
// not delete the page.
//
// Two button tiers on the หวยดีใจ palette (brand-spec §2 **แดงแบรนด์ + เงิน
// โครเมียม ทองเป็นสีรอง** — โลโก้รอบนี้คือคำว่า "หวย" สีโครเมียมคู่กับ "ดีใจ" สีแดง
// เมทัลลิก มงกุฎทองอยู่เหนือขึ้นไปเป็น accent เดียว รอบก่อนคู่หลักเป็นแดง/ทอง
// รอบนี้จึงเปลี่ยนแกนที่สองจากทองเป็นเงิน):
// สมัครสมาชิก คือแอ็กชันหลัก จึงถม **แดงแบรนด์** เต็มใบ (#e8161c → #dc0409 →
// #8e0206) ขอบแดงดำ #4b0205 ตัวอักษร **ขาว** — กฎคอนทราสต์: แดงที่สว่างที่สุดที่
// ยังผ่าน AA บนตัวอักษรขาวคือ #e8161c จึงห้ามใช้แดงสว่าง #f5363d เป็นพื้นปุ่มที่มี
// ข้อความ (ใช้ได้เฉพาะขอบ ออรา และเรืองแสง)
// ส่วน เข้าสู่ระบบ เป็นแอ็กชันรอง จึงถม **ผิวการ์ดยก #211016 ในกรอบเงินโครเมียม
// #c3c7d1/50** ตัวอักษรเนื้อความ #edeaf0 hover ยกกรอบเป็นเงินสว่าง #eef0f4/80
// ลำดับความสำคัญจึงสื่อด้วยคู่ "แดงถม vs เงินขอบ" ซึ่งเป็นสองโทนบนโลโก้จริงของรอบนี้
// ไม่ใช่ถมสีเดียวกันสองใบ ซึ่งจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม
// ออราด้านบนของปุ่มใช้คู่ตรงข้ามตามลายเซ็นงานศิลป์: ปุ่มหลักเป็นแดงสว่าง
// rgba(245,54,61,α) ปุ่มรองเป็นเงินโครเมียม rgba(195,199,209,α) เงากลางเป็นดำ
// ชุดแดง+ทองของแบรนด์ก่อน (#d20a0a #f5c33b #ffd45e #a9761a #f7e2d6 #170707
// #0a0303 #230d0d #1a0303 rgba(210,10,10,*) rgba(245,195,59,*) rgba(255,212,94,*))
// ถูกแทนครบแล้ว
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ (แบรนด์ก่อนใช้
// Announcement3) — default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ
// index ก็เรียกแบบ bare จึงห้ามส่ง prop message จากหน้านี้
//
// หวยดีใจ เป็นเว็บรับแทงหวยล้วน บรีฟรอบนี้พูดถึงการเลือกหวย รอบ และเลขที่ต้องการ
// ตรวจอัตราจ่ายกับยอดเดิมพันก่อนส่งโพย และดูผลรางวัลกับประวัติรายการจากบัญชีเดียว
// ตลาดหวยที่บรีฟระบุและอ้างได้มีห้าตัว: รัฐบาลไทย · หวยลาว · หวยฮานอย ·
// หวยออมสิน · หวย ธ.ก.ส.
// คำหมวดสล็อต/คาสิโน (สล็อต บาคาร่า คาสิโนสด ค่ายเกม RTP) ห้ามหลงเหลือ
// และห้ามเพิ่มเวลาเปิด-ปิดรับ ใบอนุญาต ชื่อธนาคาร หรือยอดฝากขั้นต่ำที่บรีฟไม่ได้
// ระบุ หน้านี้มีโควตาเป็นปุ่มสองปุ่มเท่านั้น
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 154
const pageDescription = `ทางเข้า ${BRAND_NAME} เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ เพื่อเลือกรัฐบาลไทย หวยลาว หวยฮานอย ออมสิน ธ.ก.ส. ส่งโพย ตรวจอัตราจ่าย และดูผลรางวัลได้`;

const graph = pageGraph(Astro, {
  name: `ทางเข้า ${BRAND_NAME} เว็บหลัก`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title={`ทางเข้า ${BRAND_NAME} เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ทางเข้า ${BRAND_NAME} เว็บหลัก`} as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#c3c7d1]/50 bg-[#211016] px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.75)] transition-all duration-300 hover:scale-105 hover:border-[#eef0f4]/80 hover:bg-[#17080c] hover:shadow-[0_15px_40px_rgba(195,199,209,0.3)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#c3c7d1]/25 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#c3c7d1] transition-colors group-hover:text-[#eef0f4]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#edeaf0] transition-colors group-hover:text-[#eef0f4]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#4b0205] bg-gradient-to-r from-[#e8161c] via-[#dc0409] to-[#8e0206] px-6 py-4 shadow-[0_10px_30px_rgba(220,4,9,0.40)] transition-all duration-300 hover:scale-105 hover:border-[#f5363d] hover:shadow-[0_15px_40px_rgba(245,54,61,0.35)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#f5363d]/35 to-transparent"></div>

          <svg class="h-9 w-9 text-white" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-white">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
