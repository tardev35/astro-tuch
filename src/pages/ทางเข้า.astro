---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
// Heading inventory for this page must stay h1x1, h2x0, h3x0.
//
// This route stays OUT of the navbar menu on purpose while the cta toggle is on
// (/login and /register are menu entries themselves), but it is still routed,
// still indexed and still linked from the footer. Do not add a nav link and do
// not delete the page.
//
// Two button tiers on the LOTTO24 palette (แดงนำ + ทองตาม บนพื้นดำ ตามโลโก้ที่
// LOTTO เป็นขาวเงาและ 24 เป็นแดง พร้อมเหรียญทองกับลูกบอลหวยแดง-ขาวในอาร์ตเวิร์ก):
// สมัครสมาชิก คือแอ็กชันหลัก จึงได้ไล่เฉดทองเต็มใบ (#fbbf24 → #fde68a) ตัวอักษร
// หมึกเข้ม #2a0405 เพราะตัวหนังสือบนพื้นทองสว่างต้องเป็นสีเข้ม ห้ามใช้ขาว —
// ทองลึก #a16207 จงใจไม่อยู่ในไล่เฉดนี้ เพราะหมึกเข้มบนทองลึกเหลือคอนทราสต์แค่
// ~3.3:1 ส่วนบนทองแบรนด์ได้ ~10:1 ส่วน เข้าสู่ระบบ เป็นแอ็กชันรอง จึงเป็นฝั่งแดง
// ของโลโก้ — เส้นขอบแดง #dc2626 บนผิวการ์ด #2a0405 ตัวอักษรเนื้อความ #f6e2e2
// (hover ยกผิวขึ้นเป็น #7f1d1d ขอบแดงสว่าง #fc2b2c และตัวอักษรเน้นทองอ่อน #fde68a)
// — แดงคู่ทอง ไม่ใช่ทองสองใบ
// ชุดชมพู+ม่วงของแบรนด์ก่อนหน้า (#fa42b5 #ffb3e2 #ec3fae #8b3df3 #c9a4ff #3d1180
// #0f0518 #140722 #070109 #12041c #f2dcee #fff2fb rgba(250,66,181,*)
// rgba(139,61,243,*) rgba(4,1,8,*)) ถูกแทนครบทุกจุดแล้ว
//
// Announcement หมุนจาก Announcement5 มาเป็น AnnouncementHuay ทั้งเว็บรอบนี้ —
// orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ LOTTO24 แล้ว และ index
// ก็เรียกแบบ bare จึงห้ามส่ง prop message จากหน้านี้
//
// LOTTO24 เป็นเว็บแทงหวยออนไลน์ — บรีฟพูดถึงรอบหวย เลข 2 ตัว/3 ตัว อัตราจ่าย บิล
// ยอดเข้าบัญชีบริษัทโดยตรง และวอลเลทเท่านั้น ห้ามพูดถึงสล็อต ค่ายเกม บาคาร่า
// ไลฟ์สด บอล ใบอนุญาต ชื่อธนาคาร เครดิตฟรี หรือฝากถอนออโต้ และห้ามลิงก์ไปเราต์
// ที่ถูกปิดไว้รอบนี้ (/ตรวจหวย และ /แนวทาง)
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 157
const pageDescription = "ทางเข้า LOTTO24 เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ เพื่อเลือกรอบหวยและเลขที่ต้องการ ตรวจสอบอัตราจ่ายก่อนส่งบิล รองรับทั้งมือถือและคอมพิวเตอร์";

const graph = pageGraph(Astro, {
  name: "ทางเข้า LOTTO24 เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ทางเข้า LOTTO24 เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า LOTTO24 เว็บหลัก" as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ LOTTO24"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#dc2626]/80 bg-[#2a0405] px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.85)] transition-all duration-300 hover:scale-105 hover:border-[#fc2b2c] hover:bg-[#7f1d1d] hover:shadow-[0_15px_40px_rgba(220,38,38,0.35)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#dc2626]/28 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#f6e2e2] transition-colors group-hover:text-[#fde68a]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#f6e2e2] transition-colors group-hover:text-[#fde68a]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก LOTTO24"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fde68a]/70 bg-gradient-to-r from-[#fbbf24] to-[#fde68a] px-6 py-4 shadow-[0_10px_30px_rgba(251,191,36,0.40)] transition-all duration-300 hover:scale-105 hover:border-[#fbbf24] hover:shadow-[0_15px_40px_rgba(251,191,36,0.35)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#fde68a]/40 to-transparent"></div>

          <svg class="h-9 w-9 text-[#2a0405]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#2a0405]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
