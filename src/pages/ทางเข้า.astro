---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
// Heading inventory for this page must stay h1x1, h2x0, h3x0.
//
// This route stays OUT of the navbar menu on purpose while the cta toggle is on
// (/login and /register are menu entries themselves), but it is still routed,
// still indexed and still linked from the footer. Do not add a nav link and do
// not delete the page.
//
// Two button tiers on the BRAVO168 palette (น้ำเงินรอยัล + ทอง บนพื้นกรมท่าคืนแข่ง
// ตามโลโก้ BRAVO โครเมียม-น้ำเงินคู่เลข 168 สีทองทึบ และแบนเนอร์สนามฟุตบอลกลางคืน
// สีกรมท่าที่มีริ้วแสงทอง ลูกบอลทอง-กรมท่า กองเหรียญทอง และถ้วยรางวัลทอง):
// สมัครสมาชิก คือแอ็กชันหลัก จึงได้ไล่เฉดทองเต็มใบ (#ffe39a → #f4cb69 → #c9922e)
// ตัวอักษรเป็นหมึกเข้ม #0a1020 — ทองเป็นสีสว่าง ตัวอักษรขาวบน #f4cb69 ตก AA
// จึงห้ามใช้ขาวบนพื้นทองเด็ดขาด
// ส่วน เข้าสู่ระบบ เป็นแอ็กชันรอง จึงเป็นแบบ outline — กรอบน้ำเงินรอยัล #1558c4
// บนผิวยก #072247 ตัวอักษรทอง #f4cb69 (hover ยกผิวขึ้นเป็นน้ำเงินเส้น #0e3f8f
// ขอบน้ำเงินสว่าง #2f86f0 และตัวอักษรทองอ่อน #ffe39a) — ถมทองคู่กรอบน้ำเงิน
// ไม่ใช่ถมทองสองใบ ซึ่งจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม
// ชุดเขียวนีออนของ CK268 (#8bfc13 #c9ff8f #eaffd6 #12a008 #1a7a08 #d5e6cd
// #e8f0e6 #030703 #0f1b0e #052e16 #071007 rgba(139,252,19,*) rgba(30,193,13,*)
// rgba(3,7,3,*)) ถูกแทนครบทุกจุดแล้ว
//
// Announcement หมุนมาเป็น AnnouncementPremium ทั้งเว็บรอบนี้ (รอบก่อนเป็น
// Announcement5) — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ
// BRAVO168 แล้ว และ index ก็เรียกแบบ bare จึงห้ามส่ง prop message จากหน้านี้
//
// BRAVO168 เป็นเว็บแทงบอล/พนันบอลออนไลน์ ไม่ใช่สล็อตและไม่ใช่หวย — บรีฟพูดถึงการ
// เดิมพันฟุตบอลจากหลายลีกในบัญชีเดียว บอลเดี่ยว บอลสเต็ป บอลสด ค่าน้ำและอัตราต่อรอง
// ที่เปลี่ยนตามตลาด เวลา และคู่แข่งขัน เวลาปิดรับ รายละเอียดบิล โบนัสคืนยอดเสีย 0.3%
// โบนัสแนะนำเพื่อน 0.8% สมัครเอง 3 ขั้นตอน และแอดมิน 24 ชม. เท่านั้น
// คำศัพท์ของสองแบรนด์ก่อน (สล็อต วงล้อ ฟรีสปิน ตัวคูณ ค่ายเกม RTP เกมแตก หวย
// เลขเด็ด ตรวจหวย แนวทาง ยี่กี บาคาร่า) ห้ามหลงเหลือ และห้ามเพิ่มใบอนุญาต ชื่อธนาคาร
// ยอดฝากขั้นต่ำ หรือชื่อผู้ให้บริการจริง
// รอบนี้สองเราต์ตระกูลหวย (/ตรวจหวย, /แนวทาง) ถูกปิดไปอยู่ใน src/pages-disabled แล้ว
// หน้านี้จึงต้องไม่ลิงก์ถึง — และหน้านี้มีโควตาเป็นปุ่มสองปุ่มเท่านั้น
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 158
const pageDescription = "ทางเข้า BRAVO168 เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ เพื่อดูลีก คู่แข่งขัน และตลาดบอลที่เปิดรับ ผ่านเบราว์เซอร์บนมือถือได้เลย ไม่ต้องติดตั้งแอป";

const graph = pageGraph(Astro, {
  name: "ทางเข้า BRAVO168 เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ทางเข้า BRAVO168 เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า BRAVO168 เว็บหลัก" as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ BRAVO168"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#1558c4] bg-[#072247] px-6 py-4 shadow-[0_10px_30px_rgba(2,8,26,0.85)] transition-all duration-300 hover:scale-105 hover:border-[#2f86f0] hover:bg-[#0e3f8f] hover:shadow-[0_15px_40px_rgba(21,88,196,0.40)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#1558c4]/30 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#f4cb69] transition-colors group-hover:text-[#ffe39a]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#f4cb69] transition-colors group-hover:text-[#ffe39a]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก BRAVO168"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ffe39a]/70 bg-gradient-to-r from-[#ffe39a] via-[#f4cb69] to-[#c9922e] px-6 py-4 shadow-[0_10px_30px_rgba(244,203,105,0.40)] transition-all duration-300 hover:scale-105 hover:border-[#ffe39a] hover:shadow-[0_15px_40px_rgba(244,203,105,0.35)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ffe39a]/40 to-transparent"></div>

          <svg class="h-9 w-9 text-[#0a1020]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#0a1020]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
