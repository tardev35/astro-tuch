---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
// Every paragraph that has ever been on this page was invented by an earlier
// rebrand, not by the brief. Heading inventory must stay h1x1, h2x0, h3x0.
//
// The <h1> names what the page IS ("ทางเข้า <brand> เว็บหลัก"), not what an
// article on it would have argued — a title that previews a body reads as a
// broken promise once the body is gone, and is the line most likely to tempt
// the next rebrand into writing it back.
//
// cta toggle รอบนี้เปิด: /login และ /register เป็น button page ที่ index ได้
// หน้านี้จึงถูกถอดออกจากเมนูนาวบาร์ตามกติกา (เพราะเป็นลิงก์ที่สามไปที่เดียวกัน)
// แต่ยัง route และ index อยู่ และฟุตเตอร์ยังลิงก์มาที่นี่ — ห้ามลบไฟล์นี้ และห้ามย้าย
// ไป src/pages-disabled/
//
// SUPERSLOTCLUB (รอบแดงเสือโคร่ง-ทองถ่านไฟ 2026-10-09, brand-spec §2):
// โลโก้เป็นหัวเสือโคร่งส้ม-ดำคำรามเหนือป้ายโล่แดงกว้าง อุ้งเท้าขาวเกี่ยวขอบป้ายไว้
// ตัวอักษรบนป้ายเป็นแดงสามมิติขอบโครมแดง พื้นเพจจาก bg.json เป็น
// {"mode":"color","color":"#241000"} = น้ำตาลถ่านเกือบดำ การ์ดจึงยกลอยขึ้นจากพื้น
// แดงเสือโคร่ง #e8232a · แดงเรืองไฟ #ff5a46 · ทองถ่านไฟ #f2b705 · ทองสว่าง
// #ffd666 · ทองกลางเข้ม #c08a0b · ทองลึก #a8730a · ครีมอุ่น #f5cbb0 ·
// เนื้อความ #fbe8d5 · หมึกบนพื้นสว่าง #2b0a00 · ผิวการ์ดยก #3d1709 · ผิวกลาง #301105
//
// ขั้วของปุ่มตามสเปก (พื้นสว่าง = หมึกเข้ม · พื้นเข้ม = หมึกสว่าง):
// สมัครสมาชิก = แอ็กชันหลัก ถม **ทองไล่เฉด** #ffd666 → #f2b705 → #c08a0b
// ขอบทองลึก #a8730a บนหมึกเข้ม #2b0a00 (12.6:1 / 8.7:1 / 6.0:1 ตามลำดับสต็อป)
// เข้าสู่ระบบ = แอ็กชันรอง ผิวการ์ด #3d1709 → #301105 ขอบแดง #e8232a/55
// บนครีมอุ่น #f5cbb0 (10.7:1) hover ยกขอบเป็นแดงเต็ม #e8232a
// ⚠️ ห้ามกลับด้าน และห้ามไล่เฉดทองลงไปถึง #a8730a ใต้ตัวอักษร (#2b0a00 บน #a8730a
// = 4.48:1 ตก) ปลายเข้มของไล่เฉดจึงเป็น #c08a0b · แดงแบรนด์ #e8232a ไม่เคยถือ
// ตัวอักษร (3.5:1) ใช้ได้แค่เส้นขอบ ออรา และเงา
// ออราด้านบนของปุ่มใช้ปลายสว่างของฮิวตัวเอง rgba(242,183,5,α) และ
// rgba(232,35,42,α) ไม่มี rgba อื่นในไฟล์นี้นอกจากเงาดำล้วน
// ⚠️ ฮิวของรอบนี้เป็น "แดง" และแบรนด์ก่อนๆ หลายเจ้าก็แดงเหมือนกัน เจอแดงที่ไหน
// ห้ามเหมาว่าเป็นของรอบนี้ ให้เทียบค่าเป็นตัวๆ กับตารางใน brand-spec §2
//
// Announcement หมุนมาเป็น Announcement2 ทั้งเว็บรอบนี้ — orchestrator ตั้ง default
// message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์ปัจจุบันแล้ว และทุกหน้าเรียกแบบ bare จึง
// ห้ามส่ง prop message จากหน้านี้ ไม่งั้นตัววิ่งจะไม่ตรงกับ index.astro
//
// แบรนด์นี้เป็น **คลับคนเล่นสล็อต / สล็อตเว็บหลัก** ล้วนๆ สองหน้าของหมวดลอตเตอรี
// ยัง park อยู่ใน src/pages-disabled/ จึงไม่มี route และลิงก์ค้างจะกลายเป็น
// href ตายที่ทำให้บิลด์แดง รายการคำต้องห้ามเต็มอยู่ใน
// brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำของแบรนด์เก่าเจอ false positive
// บรีฟบรรทัด 4 ระบุว่าสมาชิกติดตามเกมใหม่ ตรวจสอบรายละเอียดโบนัส และเลือกหมวดเกม
// ที่สนใจผ่านระบบเดียว — คอปปี้ของหน้านี้พูดได้แค่เท่านั้น
// ⚠️ ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 0.3% / 0.8% / 24 ชั่วโมง — ตัวเลขพาดหัวของ
// แบรนด์ก่อน (ยอดเดิมพันขั้นต่ำ) ไม่อยู่ในบรีฟรอบนี้ ห้ามยกมาใช้
// ห้ามแต่งชื่อค่ายเกม ชื่อธนาคาร เลขใบอนุญาต หน่วยงานกำกับ ค่า RTP ยอดฝากขั้นต่ำ
// จำนวนสมาชิก หรือปีก่อตั้ง — หน้านี้มีโควตาเป็นปุ่มสองปุ่มเท่านั้น
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้ไม่มี UTF-8 locale จึงนับเป็นไบต์ = เกินจริงราว 3 เท่า)
// หน้านี้ยาว 159
const pageDescription = `ทางเข้า ${BRAND_NAME} เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ คลับคนเล่นสล็อตซุปเปอร์ รวมข้อมูลเกมจากค่ายต่างๆ กิจกรรมสมาชิก โปรโมชั่นไว้ในระบบเดียว`;

const graph = pageGraph(Astro, {
  name: `ทางเข้า ${BRAND_NAME} เว็บหลัก`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title={`ทางเข้า ${BRAND_NAME} เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ทางเข้า ${BRAND_NAME} เว็บหลัก`} as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#e8232a]/55 bg-gradient-to-b from-[#3d1709] to-[#301105] px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.55)] transition-all duration-300 hover:scale-105 hover:border-[#e8232a] hover:shadow-[0_15px_40px_rgba(232,35,42,0.45)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#e8232a]/30 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#f5cbb0] transition-colors group-hover:text-[#ffd666]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#f5cbb0]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#a8730a] bg-gradient-to-b from-[#ffd666] via-[#f2b705] to-[#c08a0b] px-6 py-4 shadow-[0_10px_30px_rgba(242,183,5,0.40)] transition-all duration-300 hover:scale-105 hover:border-[#2b0a00] hover:shadow-[0_15px_40px_rgba(242,183,5,0.60)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ffd666]/60 to-transparent"></div>

          <svg class="h-9 w-9 text-[#2b0a00]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-black tracking-wide text-[#2b0a00]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
