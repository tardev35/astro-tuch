---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
//
// This route stays OUT of the navbar menu on purpose while the cta toggle is on
// (/login and /register are menu entries themselves), but it is still routed,
// still indexed and still linked from the footer. Do not add a nav link and do
// not delete the page.
//
// Two button tiers on the UFAGOOL palette (แดงคริมสัน + เงินโครเมียม บนเกือบดำ
// ตามโลโก้ที่ UFA เป็นแดงเงาและ GOOL เป็นเงินโครเมียม): สมัครสมาชิก คือแอ็กชันหลัก
// จึงได้พื้นไล่แดงเต็มใบ (#ef1f25 → #c50d12 → #7a0103) ตัวอักษรเงินขาว #f4f7fa
// ส่วน เข้าสู่ระบบ เป็นแอ็กชันรอง จึงเป็นเส้นขอบแดงแบรนด์ #c50d12 บนพื้น #16100f
// ตัวอักษรเนื้อความ #cdd5dd (hover ยกผิวขึ้นเป็น #241a1a ขอบ #ef1f25 และตัวอักษร
// เงินขาว #f4f7fa) — โทนทองของแบรนด์รอบก่อนหายไปทั้งหมด
//
// Announcement รอบนี้หมุนมาใช้ Announcement3 ทั้งเว็บ — default message ของไฟล์นั้น
// ถูกตั้งเป็นคอปปี้ของแบรนด์นี้แล้ว และ index ก็เรียกแบบ bare จึงห้ามส่ง prop
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 158
const pageDescription = "ทางเข้า UFAGOOL เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ทันที เพื่อเข้าเล่นกีฬา คาสิโนสด สล็อต และเกมออนไลน์จากบัญชีเดียว รองรับมือถือและคอมพิวเตอร์";

const graph = pageGraph(Astro, {
  name: "ทางเข้า UFAGOOL เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ทางเข้า UFAGOOL เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า UFAGOOL เว็บหลัก" as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ UFAGOOL"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#c50d12]/70 bg-[#16100f] px-6 py-4 shadow-[0_10px_30px_rgba(10,7,8,0.7)] transition-all duration-300 hover:scale-105 hover:border-[#ef1f25] hover:bg-[#241a1a] hover:shadow-[0_15px_40px_rgba(197,13,18,0.45)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#c50d12]/30 to-transparent"></div>

          <svg class="h-9 w-9 text-[#cdd5dd] transition-colors group-hover:text-[#f4f7fa]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#cdd5dd] transition-colors group-hover:text-[#f4f7fa]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก UFAGOOL"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ef1f25]/70 bg-gradient-to-r from-[#ef1f25] via-[#c50d12] to-[#7a0103] px-6 py-4 shadow-[0_10px_30px_rgba(197,13,18,0.40)] transition-all duration-300 hover:scale-105 hover:border-[#f4f7fa] hover:shadow-[0_15px_40px_rgba(184,195,207,0.45)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#f4f7fa]/25 to-transparent"></div>

          <svg class="h-9 w-9 text-[#f4f7fa]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#f4f7fa]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
