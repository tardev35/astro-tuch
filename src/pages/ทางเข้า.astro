---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
//
// BUTTON PAGE ไม่ใช่บทความ — บรีฟรอบนี้ (src/assets/content.txt) จบที่บรรทัด 29
// และ **ไม่มีส่วน SUB-PAGES เลย** จึงไม่เคยให้ body กับหน้านี้ ทุกย่อหน้าและทุก
// หัวข้อย่อยที่เคยอยู่บนหน้านี้คือของที่รีแบรนด์รอบก่อนๆ คิดขึ้นเอง แล้วรอบถัดมา
// ก็เขียนทับด้วยความเชื่อว่ารอบก่อนมีเหตุผล — ไม่มี
// ทั้งหน้ามีแค่ชื่อเรื่องจาก ContentBox แล้วต่อด้วยปุ่มสองปุ่ม
// **ห้ามเขียนหัวข้อย่อยหรือย่อหน้าอธิบายใต้ชื่อเรื่อง** — ไม่มีรายการ "ตรวจ N จุด
// ก่อนล็อกอิน" ไม่มีประโยคเตือนเรื่องรหัสผ่าน/OTP ไม่ว่าคอปปี้นั้นจะเขียนดีแค่ไหน
// (ข้อความเตือนเรื่องรหัสผ่าน/OTP ของบรีฟอยู่บน index.astro ซึ่งเป็นบทความจริง
// ไม่ใช่บนหน้าปุ่ม)
//
// <h1> บอกว่า "หน้านี้คืออะไร" ("ทางเข้า <แบรนด์> เว็บหลัก") ไม่ใช่บอกว่าบทความบน
// หน้านี้จะเถียงอะไร — ชื่อเรื่องที่โฆษณาเนื้อหาไว้คือบรรทัดที่ล่อให้รีแบรนด์รอบ
// ถัดไปเขียน body กลับมามากที่สุด
//
// cta toggle รอบนี้เปิด: /login และ /register เป็น button page ที่ index ได้
// หน้านี้จึง **ไม่อยู่ในเมนูนาวบาร์โดยตั้งใจ** (NavbarStyle4Black) แต่ยัง route และ
// index อยู่ และ FooterStyle3 ยังลิงก์มาที่นี่ — ห้ามลบไฟล์นี้ ห้ามย้ายไป
// src/pages-disabled/ และห้ามเติมลิงก์กลับเข้าเมนู
//
// ───────────────────────────────────────────────────────────────────────────
// แกนของแบรนด์รอบนี้คือ **เว็บสล็อตออนไลน์เจ้าดังไม่ผ่านม้า เดิมพันค่ายแท้
// ถูกลิขสิทธิ์100%** **ไม่ใช่แกนของรอบก่อน และไม่ใช่เว็บลอตเตอรี**
// คำกลุ่มกีฬา/เกมไพ่/ลอตเตอรี และวลีขายของรอบก่อนทุกคำที่เจอในไฟล์นี้จึงเป็นของค้าง
// รายการเต็มอยู่ใน .claude/brand-spec-pakyok168.md §5 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้
// sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// ⚠️ **สองหน้าหมวดลอตเตอรีอยู่ใน src/pages-disabled/ รอบนี้** → ลิงก์ไปสอง
// route นั้นไม่มีอยู่จริง ห้ามเขียนกลับมาเด็ดขาด (build จะแดง)
// route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ทดลองเล่น · /about-us · /contact-us · /terms · /privacy · /line
// ⚠️ บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกม ชื่อธนาคาร ใบอนุญาต ปีก่อตั้ง จำนวนสมาชิก
// ค่า RTP หรือยอดฝากขั้นต่ำแม้แต่รายเดียว และตัวเลขที่ใช้ได้มีแค่
// 0.3% · 0.8% · 24ชม. · 3 ขั้นตอน · 100% — หน้านี้มีโควตาเป็นปุ่มสองปุ่มเท่านั้น
// จึงไม่อ้างตัวเลขใดเลย
//
// พาเลตรอบนี้อยู่ใน .claude/brand-spec-pakyok168.md §2
// ⚠️⚠️ **รอบนี้กลับมาเป็น "ธีมมืด" หลังรอบก่อนเป็นฟ้าพาสเทลสว่าง — การ์ดผิว
// น้ำตาลเข้ม หมึกไอวอรี** bg.json = {"mode":"color","color":"#291d0f"} =
// **น้ำตาลกาแฟเข้ม** การ์ด ContentBox จึงเป็นผิว #3a2713 บนหมึกไอวอรี #f4ead6
// (= BRAND_TEXT) **ห้าม "แก้" การ์ดกลับไปสว่างเพราะรอบก่อนเป็นแบบนั้น**
//
// ขั้วของปุ่มบนการ์ดมืด:
// สมัครสมาชิก = PRIMARY พื้นถมไล่เฉดทอง #fded41 -> #eeae12 -> #9f600d บนหมึก
//   **เข้ม** #1f0f04 (15.4 / 9.5:1 บนสองสต็อปแรก) — นี่คือปุ่ม CTA หลัก
// เข้าสู่ระบบ = SECONDARY ปุ่มขอบ: ขอบ #eeae12 ตัวอักษร #fded41 บนพื้นโครมกลาง
//   #2f1e0f (11.0:1) — รอบนี้ไม่มี "สีที่สอง" ที่เป็นพื้นถม ปุ่มรองจึงเป็นปุ่มขอบ
//   โครเมียม #e0e0df เป็นแค่ accent ของตัวเลข "168" ไม่ใช่สีที่สองที่เท่าเทียมกับทอง
// ⚠️⚠️ **ห้ามสลับเป็นพื้นทองแล้วใส่ตัวอักษรขาว** ขั้วคือพื้นถมทอง-หมึกเข้ม
// ⚠️⚠️ **#9f600d ห้ามถือตัวอักษรบนพื้นมืด** (2.8:1) เป็นพื้นถม/ขอบ/ออราเท่านั้น —
// ตัวอักษรบนการ์ดใช้ #f4ead6 (เนื้อความ) #fded41 (หัวข้อ/ไฮไลต์) หรือ #eeae12
// (7.2:1) เท่านั้น
// ⚠️ ปุ่มของ Navfoot อยู่บนแถบโครมน้ำตาลลึก คนละโซนกับปุ่มบนการ์ดนี้
// **ห้ามลอกคลาสของ Navfoot มาวางบนการ์ด**
// ออราในไฟล์นี้ใช้ rgba(238,174,18,α) · rgba(253,237,65,α) · rgba(224,224,223,α) ·
// rgba(31,15,4,α) · rgba(0,0,0,α) เท่านั้น
//
// ⚠️ กับดักรอบนี้คือ **ทองผ่านรีโปนี้มาแล้วเกือบทุกเจ้า และรอบก่อนหน้าทันทีก็เดิน
// ทองคานารีเป็นสีที่สอง** การเจอทองในไฟล์จึง **ไม่พิสูจน์ว่าเป็นค่าของรอบนี้**
// ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำ
// ที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive
// รอบนี้ **ไม่มีฟ้า/น้ำเงิน (ซึ่งเป็นสีนำของรอบก่อน จึงเป็นของค้างที่เสี่ยงที่สุด)
// ไม่มีแดง ไม่มีเขียว ไม่มีชมพู/บานเย็น ไม่มีม่วง ไม่มีส้ม และไม่มีโรสโกลด์**
//
// Announcement รอบนี้หมุนมาเป็น AnnouncementPremium ทั้งเว็บ (brand-spec §3 —
// รอบก่อนใช้ตัวอื่น จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์
// นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว ทุกหน้าเรียกแบบ bare จึง **ห้ามส่ง prop message**
// จากหน้านี้ ไม่งั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้ไม่มี UTF-8 locale จึงนับเป็นไบต์ = เกินจริงราว 3 เท่า)
// หน้านี้ยาว 155 ด้วยชื่อแบรนด์ 8 ตัวอักษรของรอบนี้
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ทำให้ตัวนับเห็นเป็น 5 อักขระ
// ประโยคนี้บรรยาย "สิ่งที่หน้านี้มี" เท่านั้น — หน้านี้มีแค่ปุ่มสองปุ่ม ไม่มีปุ่ม LINE
// จึงไม่สัญญาช่องทางแชตไว้ใน description
// ส่วนท้ายมาจากบรีฟบรรทัด 16 ตรงตัว: ตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้องก่อนดำเนินการ
const pageDescription = `ทางเข้า ${BRAND_NAME} เว็บหลัก รวมเมนูเข้าสู่ระบบและสมัครสมาชิกเว็บสล็อตค่ายแท้ไว้ในหน้าเดียว ควรตรวจสอบที่อยู่ของเว็บไซต์ทางการให้ถูกต้องทุกครั้งก่อนกรอกข้อมูล`;

const graph = pageGraph(Astro, {
  name: `ทางเข้า ${BRAND_NAME} เว็บหลัก`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title={`ทางเข้า ${BRAND_NAME} เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ทางเข้า ${BRAND_NAME} เว็บหลัก`} as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border-2 border-[#eeae12] bg-[#2f1e0f] px-6 py-4 shadow-[0_10px_30px_rgba(238,174,18,0.25)] transition-all duration-300 hover:scale-105 hover:border-[#fded41] hover:shadow-[0_15px_40px_rgba(238,174,18,0.45)]">
          <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#eeae12]/20 to-transparent"></span>

          <svg class="h-9 w-9 text-[#fded41]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#fded41]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border-2 border-[#9f600d] bg-gradient-to-b from-[#fded41] via-[#eeae12] to-[#9f600d] px-6 py-4 shadow-[0_10px_30px_rgba(238,174,18,0.35)] transition-all duration-300 hover:scale-105 hover:border-[#fded41] hover:shadow-[0_15px_40px_rgba(238,174,18,0.5)]">
          <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#fded41]/70 to-transparent"></span>

          <svg class="h-9 w-9 text-[#1f0f04]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-black tracking-wide text-[#1f0f04]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
