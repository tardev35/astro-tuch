---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
// Heading inventory for this page must stay h1x1, h2x0, h3x0.
//
// This route stays OUT of the navbar menu on purpose while the cta toggle is on
// (/login and /register are menu entries themselves), but it is still routed,
// still indexed and still linked from the footer. Do not add a nav link and do
// not delete the page.
//
// Two button tiers on the หวยเฮง24 palette (แดงเข้ม + ทอง ตามโลโก้ที่คำว่า "หวย"
// เป็นแดงเลือดนกเงาวาวขอบทอง และ "เฮง24" เป็นทองไล่เฉด บนแบนเนอร์ผ้าซาตินแดงที่มี
// เงาปราสาททอง เหรียญทอง ลูกหวยแดง-ขาว และลายไทยสีทอง):
// สมัครสมาชิก คือแอ็กชันหลัก จึงได้ไล่เฉดทองเต็มใบ (#fdea83 → #fbdc64 → #bd7c13)
// ตัวอักษรเป็นหมึกเข้ม #2a0606 — ทองเป็นสีสว่าง ตัวอักษรขาวบน #e0a52a ตก AA
// จึงห้ามใช้ขาวบนพื้นทองเด็ดขาด
// ส่วน เข้าสู่ระบบ เป็นแอ็กชันรอง จึงเป็นแบบ outline — กรอบแดงแบรนด์ #8b0302
// บนผิวยก #3d0808 ตัวอักษรทอง #e0a52a (hover ยกผิวขึ้นเป็นแดงลึก #5a0202
// ขอบแดงสว่าง #c01616 และตัวอักษรทองสว่าง #fbdc64) — ถมทองคู่กรอบแดง
// ไม่ใช่ถมทองสองใบ ซึ่งจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม
// ชุดเขียวป่า-ทองของ หวยเต็ง (#03150a #062a12 #0b3d18 #026314 #024a0f #0bb42f
// #e5c04f #fae474 #bd8d2d #d8ead9 #0a1a0c rgba(229,192,79,*) rgba(2,99,20,*)
// rgba(3,21,10,*)) ถูกแทนครบทุกจุดแล้ว
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ (รอบก่อนเป็น Announcement3)
// — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ หวยเฮง24 แล้ว และ
// index ก็เรียกแบบ bare จึงห้ามส่ง prop message จากหน้านี้
//
// หวยเฮง24 เป็นเว็บเล่นหวยออนไลน์ ไม่ใช่บอลและไม่ใช่สล็อต — บรีฟพูดถึงการรวมรายการ
// หวยยอดนิยมไว้ในบัญชีเดียว ทั้งหวยลาว หวยฮานอย หวยรัฐบาลไทย และหวยหุ้น การเลือกเลข
// ส่งโพย เวลาเปิดรับ เวลาปิดรับ อัตราจ่าย 2 ตัว จ่าย 100 บาท / 3 ตัว จ่าย 1,000 บาท
// สมัครเอง 3 ขั้นตอน ฝากถอนผ่านวอลเลทและธนาคาร และแอดมิน 24 ชม. เท่านั้น
// คำศัพท์ของแบรนด์ก่อนหน้า (สล็อต ฟรีสปิน ตัวคูณ ค่ายเกม RTP แตกง่าย เว็บตรง บอล
// ค่าน้ำ อัตราต่อรอง ลีก บิลสเต็ป แฮนดิแคป คาสิโน บาคาร่า) ห้ามหลงเหลือ และห้ามเพิ่ม
// ใบอนุญาต ชื่อธนาคาร ยอดฝากขั้นต่ำ หรือชื่อผู้ให้บริการจริง
// รอบนี้สองเราต์ตระกูลหวย (/ตรวจหวย, /แนวทาง) เปิดใช้งานอยู่ แต่หน้านี้มีโควตาเป็น
// ปุ่มสองปุ่มเท่านั้น จึงไม่เพิ่มลิงก์อะไรที่นี่
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 159
const pageDescription = "ทางเข้า หวยเฮง24 เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ เพื่อเลือกหวยลาว หวยฮานอย หวยรัฐบาลไทย และหวยหุ้น ผ่านเบราว์เซอร์บนมือถือ ไม่ต้องติดตั้งแอป";

const graph = pageGraph(Astro, {
  name: "ทางเข้า หวยเฮง24 เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ทางเข้า หวยเฮง24 เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า หวยเฮง24 เว็บหลัก" as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ หวยเฮง24"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#8b0302] bg-[#3d0808] px-6 py-4 shadow-[0_10px_30px_rgba(20,3,3,0.85)] transition-all duration-300 hover:scale-105 hover:border-[#c01616] hover:bg-[#5a0202] hover:shadow-[0_15px_40px_rgba(192,22,22,0.35)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#8b0302]/30 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#e0a52a] transition-colors group-hover:text-[#fbdc64]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#e0a52a] transition-colors group-hover:text-[#fbdc64]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก หวยเฮง24"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fdea83]/70 bg-gradient-to-r from-[#fdea83] via-[#fbdc64] to-[#bd7c13] px-6 py-4 shadow-[0_10px_30px_rgba(224,165,42,0.40)] transition-all duration-300 hover:scale-105 hover:border-[#fdea83] hover:shadow-[0_15px_40px_rgba(251,220,100,0.35)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#fdea83]/40 to-transparent"></div>

          <svg class="h-9 w-9 text-[#2a0606]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#2a0606]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
