---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// Button page, not an article: the docx gives this route a Title and a Meta and
// never a body. One heading from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the <h1>.
const pageDescription =
  "ทางเข้า JAIDEE928 เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้ทันที รองรับทั้งมือถือและคอมพิวเตอร์ เข้าเล่นบาคาร่า รูเล็ต และคาสิโนสด ฝากถอนอัตโนมัติ 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  name: "ทางเข้า JAIDEE928 เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ทางเข้า JAIDEE928 เว็บหลัก เข้าสู่ระบบและสมัครสมาชิก" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า JAIDEE928 เว็บหลัก" as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ JAIDEE928"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#062d94]/70 bg-[#01050f] px-6 py-4 shadow-[0_10px_30px_rgba(14,110,251,0.18)] transition-all duration-300 hover:scale-105 hover:border-[#7db4ff] hover:bg-[#032058] hover:shadow-[0_15px_40px_rgba(14,110,251,0.30)]">
          <div class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#0e6efb]/20 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#7db4ff]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#dce9ff]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก JAIDEE928"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#7db4ff]/70 bg-gradient-to-r from-[#e6e8ec] via-[#7db4ff] to-[#0e6efb] px-6 py-4 shadow-[0_10px_30px_rgba(14,110,251,0.25)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(14,110,251,0.35)]">
          <div class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-white/40 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#040e22]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#040e22]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
