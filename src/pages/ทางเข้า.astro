---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
//
// BUTTON PAGE ไม่ใช่บทความ — บรีฟ (src/assets/content.txt) **ไม่มีส่วน SUB-PAGES**
// จึงไม่เคยให้ body กับหน้านี้ ทุกย่อหน้าและทุกหัวข้อย่อยที่เคยอยู่บนหน้านี้คือของ
// ที่รีแบรนด์รอบก่อนๆ คิดขึ้นเอง แล้วรอบถัดมาก็เขียนทับด้วยความเชื่อว่ารอบก่อน
// มีเหตุผล — ไม่มี ทั้งหน้ามีแค่ชื่อเรื่องจาก ContentBox แล้วต่อด้วยปุ่มสองปุ่ม
// **ห้ามเขียนหัวข้อย่อยหรือย่อหน้าอธิบายใต้ชื่อเรื่อง** — ไม่มีรายการ "ตรวจ N จุด
// ก่อนล็อกอิน" ไม่มีประโยคเตือนเรื่องรหัสผ่าน/OTP ไม่ว่าคอปปี้นั้นจะเขียนดีแค่ไหน
// (ประโยคกำกับเรื่องรหัสผ่าน/OTP ของบรีฟอยู่บน index.astro ซึ่งเป็นบทความจริง
// ไม่ใช่บนหน้าปุ่ม)
//
// h1 บอกว่า "หน้านี้คืออะไร" ("ทางเข้า <แบรนด์> เว็บหลัก") ไม่ใช่บอกว่าบทความบน
// หน้านี้จะเถียงอะไร — ชื่อเรื่องที่โฆษณาเนื้อหาไว้คือบรรทัดที่ล่อให้รีแบรนด์รอบ
// ถัดไปเขียน body กลับมามากที่สุด
//
// cta toggle รอบนี้เปิด: /login และ /register เป็น button page ที่ index ได้
// หน้านี้จึง **ไม่อยู่ในเมนูนาวบาร์โดยตั้งใจ** แต่ยัง route และ index อยู่ และ
// footer ที่ใช้งานอยู่ยังลิงก์มาที่นี่ — ห้ามลบไฟล์นี้ ห้ามย้ายไป
// src/pages-disabled/ และห้ามเติมลิงก์กลับเข้าเมนู
//
// ───────────────────────────────────────────────────────────────────────────
// 🚨 แกนของแบรนด์รอบนี้คือ **เว็บเกมพนัน/คาสิโนออนไลน์** (.claude/brand-spec-teva69.md
// §1) **กลับทิศจากหมวดของแบรนด์ขาออก** — คำนิยามตัวเองของแบรนด์ก่อนๆ ห้ามเหลือ
// ที่ไหนทั้งสิ้น รายการคำที่ห้ามใช้อยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้
// sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// ⚠️ **บรีฟรอบนี้ไม่มีหมวดฝากถอน/ธนาคาร/วอลเลทเลยสักคำ** — หน้านี้ไม่เอ่ยถึงเลย
// ⚠️ route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ทดลองเล่น · /about-us · /contact-us · /terms · /privacy · /line —
// **สองหน้าหมวดของแบรนด์ขาออก (ชื่อไฟล์อยู่ใน brand-spec §1) ถูกย้ายไป
// src/pages-disabled/ แล้วรอบนี้ ลิงก์ไปที่นั้น = build แดง**
// แต่หน้านี้มีโควตาเป็นปุ่มสองปุ่ม จึงไม่ลิงก์ไปที่อื่นเพิ่มอยู่แล้ว
// ⚠️ ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 0.3% · 0.8% · 3 ขั้นตอน · 24ชม. — หน้านี้มีโควตา
// เป็นปุ่มสองปุ่ม จึงไม่อ้างตัวเลขใดเลย
//
// พาเลตรอบนี้อยู่ใน .claude/brand-spec-teva69.md §2
// 🚨 **รอบนี้เนื้อหาเป็นผิวสว่าง โครมเป็นผิวเข้ม (ทิศเดียวกับรอบก่อน) แต่ฮิว
// คนละตระกูลสิ้นเชิง** bg.json = {"mode":"color","color":"#f0ffeb"} =
// **ขาวอมมิ้นต์จาง** (รอบก่อนเป็นขาวอมชมพูจาง — ค่ามาจากไฟล์ ห้ามเดาว่าเท่าเดิม)
// การ์ด ContentBox จึงเป็นผิว #ffffff บนหมึก #10280f (= BRAND_TEXT, 15.8:1)
// **ห้าม "แก้" การ์ดกลับไปเป็นผิวมืดตามโครม** — การ์ดมืดบนหมึกนี้ = ตัวอักษรหายไปเลย
//
// ขั้วของปุ่มบนการ์ดผิวขาว (ตรงกับคู่ปุ่มที่ล็อกไว้ใน brand-spec §2):
// สมัครสมาชิก = PRIMARY พื้นไล่เฉดเขียวป่า #0b4a12 -> #116018 -> #1a7d24
//   บนหมึก **ขาว #ffffff** (10.5 / 7.8 / 5.3:1 ผ่านทุกสต็อป) — ปุ่ม CTA หลัก
//   ⚠️⚠️ **ห้ามลากสต็อปขึ้นไปถึง 28c437 หรือใช้ e3bb45 เป็นสต็อป** — ขาวบนสองค่านั้น
//   ตก AA ทั้งคู่ (2.3:1 / 2.0:1) สองค่านั้นเป็นขอบ/ออรา/พื้นถมบนโครมเข้มเท่านั้น
//   ⚠️⚠️ **และห้ามกลับด้านเป็นพื้นเขียวเข้ม + หมึก #10280f**
// เข้าสู่ระบบ = SECONDARY พื้นไล่เฉดขาว #ffffff -> #e6f7df บนหมึก
//   **เขียวป่าจม #10280f** (15.8 / 14.1:1) ขอบ #3f7a2e คือสิ่งที่แยกปุ่มนี้ออก
//   จากผิวการ์ดขาว — ห้ามถอดขอบออก
// ⚠️⚠️ **f0ffeb e6f7df d7f0cd b2dba3 c6cfd2 28c437 e3bb45 ห้ามถือตัวอักษรบนผิว
//   สว่างเด็ดขาด** เป็นพื้นถม/ขอบ/ออราเท่านั้น และ 3f7a2e เป็น **เส้น/ขอบ**
//   เท่านั้น · ที่ถือตัวอักษรได้บนผิวสว่างชุดนี้คือ #10280f (15.8:1) ·
//   #3c5b36 (7.7:1) · #116018 (7.8:1) · #0b4a12 (10.5:1) · #1a7d24 (5.3:1) ·
//   #8a6a0e (5.1:1)
// ⚠️⚠️ **0b2a12 15401d 051409 2d6b2f e8fbe4 b4d6ad เป็นค่าของผิวโครมเข้ม
//   เท่านั้น ห้ามหลุดเข้ามาในไฟล์นี้**
// ⚠️⚠️ **ฮิวนำของรอบนี้คือเขียวมรกต/เขียวป่าบนผิวสว่าง** — เวิร์ดมาร์กสามมิติที่
//   ครึ่งแรกเป็นตัวอักษรผิวโครเมียมเงิน ครึ่งหลังเป็นตัวเลขผิวเขียวมรกต ชิปคาสิโน
//   เขียวเข้มสลับขาว มงกุฎทองดวงเล็ก และต้นไม้ในกระถางในอาร์ตเวิร์กเป็นวัตถุในภาพ
//   ไม่ใช่สี UI · พื้นเพจมาจาก bg.json เท่านั้น
// ⚠️ ปุ่มของ Navfoot อยู่บนแถบโครม **ผิวเข้ม** คนละโซนกับปุ่มบนการ์ดสว่างนี้
// **ห้ามลอกคลาสของ Navfoot มาวางบนการ์ด**
// ออราในไฟล์นี้ใช้ rgba(17,96,24,α) · rgba(11,74,18,α) · rgba(26,125,36,α) ·
// rgba(40,196,55,α) เท่านั้น
//
// ⚠️⚠️ กับดักรอบนี้คือ **เขียวเคยเป็นฮิวนำของแบรนด์เก่ามาแล้วหลายเจ้า และเขียว
// เป็นฮิวที่ตาแยกค่าได้ยากที่สุด** การเจอเขียวในไฟล์จึง **ไม่พิสูจน์ว่าเป็นค่าของ
// รอบนี้** ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive
// รอบนี้ **ไม่มีม่วง/ฟ้า/ไซแอน/แมเจนต้า/ชมพู/ส้มเพลิง/แดงเป็นสี UI** เลยสักเฉด
//
// Announcement รอบนี้หมุนมาเป็นตัวท้ายชื่อ Premium ของตระกูล ทั้งเว็บ (brand-spec §3 —
// รอบก่อนใช้ตัวท้ายชื่อ Huay จึงหมุนออก · เขียนชื่อไฟล์แบบไม่มีเครื่องหมายคำพูด
// โดยตั้งใจ เพราะ tools/gen-tw-sources.mjs นับ literal ที่มีเครื่องหมายคำพูดว่าเป็น
// การ import จริง คอมเมนต์จึงทำให้ variant เก่าหลุดเข้า Tailwind scan แล้วสีของ
// แบรนด์ก่อนขึ้น stylesheet) orchestrator เป็นเจ้าของ default message ของไฟล์นั้น
// ทุกหน้าเรียกแบบ bare จึง **ห้ามส่ง prop message** จากหน้านี้ ไม่งั้นตัววิ่งจะพูด
// คนละเรื่องกับหน้าอื่น
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้ไม่มี UTF-8 locale จึงนับเป็นไบต์ = เกินจริงราว 3 เท่า)
// หน้านี้ยาว 152 ด้วยชื่อแบรนด์ 6 โค้ดพอยต์ของรอบนี้ (รอบก่อนยาว 8 — ต้องนับใหม่
// ทุกรอบ ห้ามสืบทอดความยาวข้ามแบรนด์) ส่วนที่ไม่ใช่ชื่อแบรนด์ยาว 146 →
// รับชื่อแบรนด์ได้ 4–14 อักขระ ถ้ารอบหน้าชื่อยาวกว่านั้นต้องตัดข้อความ
// ไม่ใช่ปล่อยผ่าน
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ทำให้ตัวนับเห็นเป็น 5 อักขระ
// ประโยคนี้บรรยาย "สิ่งที่หน้านี้มี" เท่านั้น — หน้านี้มีแค่ปุ่มสองปุ่ม ไม่มีปุ่ม LINE
// จึงไม่สัญญาช่องทางแชตไว้ใน description
const pageDescription = `ทางเข้า ${BRAND_NAME} เว็บหลัก รวมปุ่มเข้าสู่ระบบและสมัครสมาชิกไว้ในหน้าเดียว สำหรับผู้ที่ต้องการเข้าใช้งานระบบสมาชิก ควรตรวจสอบที่อยู่เว็บไซต์ทางการก่อนใช้งาน`;

const graph = pageGraph(Astro, {
  name: `ทางเข้า ${BRAND_NAME} เว็บหลัก`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title={`ทางเข้า ${BRAND_NAME} เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ทางเข้า ${BRAND_NAME} เว็บหลัก`} as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="group mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 rounded-xl border-2 border-[#3f7a2e] bg-gradient-to-b from-[#ffffff] to-[#e6f7df] px-6 py-4 shadow-[0_8px_24px_rgba(17,96,24,0.18)] transition-all duration-300 hover:scale-105 hover:border-[#116018] hover:shadow-[0_14px_36px_rgba(40,196,55,0.32)]">
          <svg class="h-9 w-9 text-[#10280f]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#10280f]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border-2 border-[#0b4a12] bg-gradient-to-b from-[#0b4a12] via-[#116018] to-[#1a7d24] px-6 py-4 shadow-[0_10px_30px_rgba(11,74,18,0.35)] transition-all duration-300 hover:scale-105 hover:border-[#1a7d24] hover:shadow-[0_15px_40px_rgba(26,125,36,0.42)]">
          <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-white/10 to-transparent"></span>

          <svg class="h-9 w-9 text-white" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-black tracking-wide text-white">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
