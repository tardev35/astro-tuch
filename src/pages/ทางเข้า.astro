---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
//
// This route stays OUT of the navbar menu on purpose while the cta toggle is on
// (/login and /register are menu entries themselves), but it is still routed,
// still indexed and still linked from the footer. Do not add a nav link and do
// not delete the page.
//
// Two button tiers on the THE88 palette (แดง + ทอง บนแดงเกือบดำ ตามโลโก้ที่ตัว THE
// เป็นแดงเงาขอบทองและเลข 88 เป็นครีมขอบทอง): สมัครสมาชิก คือแอ็กชันหลัก จึงได้
// พื้นไล่ทองเต็มใบ (#ffe7a6 → #f2c14e → #8a6524) ตัวอักษรเป็นแดงเกือบดำ #1c0504
// ส่วน เข้าสู่ระบบ เป็นแอ็กชันรอง จึงเป็นเส้นขอบแดงแบรนด์ #a40201 บนพื้น #1c0504
// ตัวอักษรแดงสด #dd0503 (hover ยกผิวขึ้นเป็นผิวการ์ด #2d0908 และเปลี่ยนเป็นทองอ่อน
// #ffe7a6) — โทนชมพูมาเจนตาของ WY88 รอบก่อนหายไปทั้งหมด
//
// Announcement รอบนี้หมุนมาใช้ Announcement2 ทั้งเว็บ — default message ของไฟล์นั้น
// เป็นคอปปี้ของแบรนด์นี้อยู่แล้วและ index ก็เรียกแบบ bare จึงห้ามส่ง prop
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 156
const pageDescription = "ทางเข้า THE88 เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ทันที เพื่อเข้าเล่นบาคาร่า สล็อต หวย บอล และไฮโลจากบัญชีเดียว รองรับทั้งมือถือและคอมพิวเตอร์";

const graph = pageGraph(Astro, {
  name: "ทางเข้า THE88 เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ทางเข้า THE88 เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า THE88 เว็บหลัก" as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ THE88"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#a40201]/70 bg-[#1c0504] px-6 py-4 shadow-[0_10px_30px_rgba(28,5,4,0.7)] transition-all duration-300 hover:scale-105 hover:border-[#f2c14e] hover:bg-[#2d0908] hover:shadow-[0_15px_40px_rgba(164,2,1,0.45)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#a40201]/30 to-transparent"></div>

          <svg class="h-9 w-9 text-[#dd0503] transition-colors group-hover:text-[#ffe7a6]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#dd0503] transition-colors group-hover:text-[#ffe7a6]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก THE88"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ffe7a6]/70 bg-gradient-to-r from-[#ffe7a6] via-[#f2c14e] to-[#8a6524] px-6 py-4 shadow-[0_10px_30px_rgba(242,193,78,0.40)] transition-all duration-300 hover:scale-105 hover:border-[#ffe7a6] hover:shadow-[0_15px_40px_rgba(255,231,166,0.45)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ffe7a6]/35 to-transparent"></div>

          <svg class="h-9 w-9 text-[#1c0504]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#1c0504]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
