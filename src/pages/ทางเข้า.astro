---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
// Heading inventory for this page must stay h1x1, h2x0, h3x0.
//
// This route stays OUT of the navbar menu on purpose while the cta toggle is on
// (/login and /register are menu entries themselves), but it is still routed,
// still indexed and still linked from the footer. Do not add a nav link and do
// not delete the page.
//
// Two button tiers on the MAHAGAME66 palette (แดง + ดำ + เงินโครเมียม ตามโลโก้ที่
// คำว่า "MAHA" และ "66" เป็นดำ-เงินโครเมียม ส่วน "GAME" เป็นแดงสด): สมัครสมาชิก คือ
// แอ็กชันหลัก จึงได้พื้นไล่แดงเต็มใบ (#ff4d52 → #de161d → #7a0a0e) ตัวอักษรสว่าง
// #fff6f5 เพื่อให้คอนทราสต์บนแดงอ่านออก ส่วน เข้าสู่ระบบ เป็นแอ็กชันรอง จึงเป็น
// เส้นขอบแดงแบรนด์ #de161d บนผิวการ์ดเกือบดำ #16090a ตัวอักษรเนื้อความ #e8e3e1
// (hover ยกผิวขึ้นเป็น #26100f ขอบแดงสว่าง #ff4d52 และตัวอักษรเน้น #fff6f5) —
// ชุดทอง-เขียวของ 888PARUAY รอบก่อน (#fcdc2b #fff6ae #a87d0c #1fae1c #0c4402
// #07130a #0d2312 #143a1c #e8e4c6 #fffdf0) ถูกแทนครบทุกจุดแล้ว
//
// Announcement รอบนี้หมุนจาก Announcement3 มาเป็น Announcement5 ทั้งเว็บ —
// default message ของ Announcement5 เป็นคอปปี้ของ MAHAGAME66 แล้ว และ index ก็
// เรียกแบบ bare จึงห้ามส่ง prop message จากหน้านี้
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 155
const pageDescription = "ทางเข้า MAHAGAME66 เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ เพื่อเข้าเล่นบาคาร่า สล็อต หวย บอล รูเล็ต และเกมไลฟ์สดได้ตลอด 24 ชั่วโมงจากบัญชีเดียว";

const graph = pageGraph(Astro, {
  name: "ทางเข้า MAHAGAME66 เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ทางเข้า MAHAGAME66 เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า MAHAGAME66 เว็บหลัก" as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ MAHAGAME66"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#de161d]/70 bg-[#16090a] px-6 py-4 shadow-[0_10px_30px_rgba(8,5,6,0.80)] transition-all duration-300 hover:scale-105 hover:border-[#ff4d52] hover:bg-[#26100f] hover:shadow-[0_15px_40px_rgba(222,22,29,0.45)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#de161d]/30 to-transparent"></div>

          <svg class="h-9 w-9 text-[#e8e3e1] transition-colors group-hover:text-[#fff6f5]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#e8e3e1] transition-colors group-hover:text-[#fff6f5]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก MAHAGAME66"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ff4d52]/70 bg-gradient-to-r from-[#ff4d52] via-[#de161d] to-[#7a0a0e] px-6 py-4 shadow-[0_10px_30px_rgba(222,22,29,0.40)] transition-all duration-300 hover:scale-105 hover:border-[#e2e8ef] hover:shadow-[0_15px_40px_rgba(226,232,239,0.35)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#e2e8ef]/30 to-transparent"></div>

          <svg class="h-9 w-9 text-[#fff6f5]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#fff6f5]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
