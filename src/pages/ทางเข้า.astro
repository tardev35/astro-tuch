---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
// Heading inventory for this page must stay h1x1, h2x0, h3x0.
//
// The <h1> names what the page IS ("ทางเข้า <brand> เว็บหลัก"), not what an
// article on it would have argued — a title that previews a body reads as a
// broken promise once the body is gone, and is the line most likely to tempt
// the next rebrand into writing it back.
//
// This route stays OUT of the navbar menu on purpose while the cta toggle is on
// (/login and /register are menu entries themselves), but it is still routed,
// still indexed and still linked from the footer. Do not add a nav link and do
// not delete the page.
//
// Two button tiers on the NAZA99 palette (brand-spec §2 ทอง-ดำ สีเดียว):
// สมัครสมาชิก คือแอ็กชันหลัก จึงได้ไล่เฉดทองเต็มใบ (#fdf2ac → #e4b34d → #c08f2b)
// ตัวอักษรเป็นหมึกเข้ม #1a1000 — ปลายไล่เฉดห้ามเข้มกว่า #c08f2b ซึ่งวัดได้ 7.0:1
// ส่วน เข้าสู่ระบบ เป็นแอ็กชันรอง จึงเป็นแบบ outline — กรอบทองลึก #8a5f12
// บนผิวยกระดับ #241404 ตัวอักษรทองอ่อน #fdf2ac (hover ยกขอบเป็นทองแบรนด์ #e4b34d
// และตัวอักษรเป็น #fef1a5) — แบรนด์นี้เป็นทองล้วนไม่มีฮิวที่สอง ลำดับความสำคัญจึง
// สื่อด้วย "ถมทอง vs กรอบทองบนพื้นดำ" ไม่ใช่ถมทองสองใบ ซึ่งจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม
// ห้ามตัวอักษรสีอ่อนบนพื้นทอง (ขาวบน #e4b34d ได้แค่ 1.9:1 — brand-spec §2)
// ชุดของ หวย365 (#dc0203 #f5282a #9c0201 #ffc93c #ffeab0 #c08a07 #240406 #180303
// #f6e7e0 #1a0303 rgba(255,201,60,*) rgba(220,2,3,*) rgba(8,1,1,*)) ถูกแทนครบแล้ว
//
// Announcement หมุนมาเป็น AnnouncementPremium ทั้งเว็บรอบนี้ (รอบก่อนเป็น
// AnnouncementCyber) — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ
// NAZA99 แล้ว และ index ก็เรียกแบบ bare จึงห้ามส่ง prop message จากหน้านี้
//
// NAZA99 เป็นเว็บสล็อตออนไลน์ ไม่ใช่หวยและไม่ใช่บอล — บรีฟรอบนี้พูดถึงการรวมเกมสล็อต
// หลายสไตล์จากค่ายยอดนิยมไว้ในระบบเดียว ทั้งเกมโบนัส ฟรีสปิน ตัวคูณ เลือกเกม
// ตรวจสอบโปรโมชั่น และติดตามรายการผ่านบัญชีเดียว
// คำศัพท์ของแบรนด์ก่อนหน้า (หวย โพย ส่งโพย งวด เลขเด็ด อัตราจ่าย ฮานอย ลาว หุ้น
// บอล ค่าน้ำ อัตราต่อรอง ลีก คาสิโนสด บาคาร่า ยิงปลา) ห้ามหลงเหลือ และห้ามเพิ่ม
// ใบอนุญาต ชื่อธนาคาร ยอดฝากขั้นต่ำ หรือชื่อผู้ให้บริการจริง
// รอบนี้สองเราต์ตระกูลหวย (/ตรวจหวย, /แนวทาง) ถูกย้ายไป src/pages-disabled/ แล้ว
// ห้ามสร้างลิงก์ไปสองเส้นทางนั้นที่นี่ (= href ไปหน้าที่ไม่มีอยู่ = build แดง)
// และหน้านี้มีโควตาเป็นปุ่มสองปุ่มเท่านั้นอยู่แล้ว
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 151
const pageDescription = `ทางเข้า ${BRAND_NAME} เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ เพื่อเลือกเกมสล็อตจากค่ายที่ระบบรองรับ ตรวจสอบโปรโมชั่น และติดตามรายการผ่านบัญชีเดียว`;

const graph = pageGraph(Astro, {
  name: `ทางเข้า ${BRAND_NAME} เว็บหลัก`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title={`ทางเข้า ${BRAND_NAME} เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ทางเข้า ${BRAND_NAME} เว็บหลัก`} as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#8a5f12] bg-[#241404] px-6 py-4 shadow-[0_10px_30px_rgba(10,5,1,0.85)] transition-all duration-300 hover:scale-105 hover:border-[#e4b34d] hover:shadow-[0_15px_40px_rgba(228,179,77,0.35)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#e4b34d]/25 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#fdf2ac] transition-colors group-hover:text-[#fef1a5]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#fdf2ac] transition-colors group-hover:text-[#fef1a5]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#8a5f12] bg-gradient-to-r from-[#fdf2ac] via-[#e4b34d] to-[#c08f2b] px-6 py-4 shadow-[0_10px_30px_rgba(228,179,77,0.40)] transition-all duration-300 hover:scale-105 hover:border-[#fdf2ac] hover:shadow-[0_15px_40px_rgba(253,242,172,0.35)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#fef1a5]/40 to-transparent"></div>

          <svg class="h-9 w-9 text-[#1a1000]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#1a1000]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
