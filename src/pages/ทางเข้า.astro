---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
// Heading inventory for this page must stay h1x1, h2x0, h3x0.
//
// This route stays OUT of the navbar menu on purpose while the cta toggle is on
// (/login and /register are menu entries themselves), but it is still routed,
// still indexed and still linked from the footer. Do not add a nav link and do
// not delete the page.
//
// Two button tiers on the หวยเฮง789 palette. รอบนี้เป็น "แดงนำ ทองรอง" กลับขั้ว
// กับรอบก่อน (หวยเฮง24 ทองนำ) ตามโลโก้ที่ vivid เด่นเป็นแดงเลือดนก ส่วนทองอยู่ที่
// ตัวอักษรและเหรียญบนแบนเนอร์:
// สมัครสมาชิก คือแอ็กชันหลัก จึงได้ไล่เฉดทองเต็มใบ (#ffefc2 → #f4bc5d → #d99a10)
// ตัวอักษรเป็นหมึกเข้ม #1c0606 — ไล่เฉดใต้หมึกเข้มห้ามจบเข้มกว่า #d99a10 ซึ่งวัดได้
// 7.0:1 ส่วน #a8690c (3.8:1) ใช้ได้เฉพาะขอบ/เส้นคั่น ห้ามเป็นพื้นหลังของตัวอักษร
// ส่วน เข้าสู่ระบบ เป็นแอ็กชันรอง จึงเป็นแบบ outline — กรอบแดงลึก #ab0204
// บนผิวการ์ด #2b0909 ตัวอักษรทอง #f4bc5d (hover ยกผิวขึ้นเป็นแดงมืดสุด #5c0a0a
// ขอบแดงสว่าง #e43434 และตัวอักษรทองอ่อน #ffefc2) — ถมทองคู่กรอบแดง
// ไม่ใช่ถมทองสองใบ ซึ่งจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม
// ห้ามใช้หมึกเข้มบนแดงแบรนด์ #dc2224 (3.4:1) พื้นแดงรับตัวอักษรขาวเท่านั้น
// ชุดทองนำของ หวยเฮง24 (#e0a52a #fdea83 #fbdc64 #bd7c13 #2a0606 #1a0505 #f6e6cf
// #e6c98f #8b0302 #c01616 #5a0202 #3d0808 #2e0707 rgba(224,165,42,*)
// rgba(251,220,100,*) rgba(253,234,131,*) rgba(192,22,22,*) rgba(20,3,3,*))
// ถูกแทนครบทุกจุดแล้ว
//
// Announcement หมุนมาเป็น Announcement2 ทั้งเว็บรอบนี้ (รอบก่อนเป็น Announcement5)
// — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ หวยเฮง789 แล้ว และ
// index ก็เรียกแบบ bare จึงห้ามส่ง prop message จากหน้านี้
//
// หวยเฮง789 เป็นเว็บแทงหวยออนไลน์ ไม่ใช่บอลและไม่ใช่สล็อต — บรีฟพูดถึงการรวมประเภทหวย
// ไว้ในบัญชีเดียว ทั้งหวยรัฐบาลไทย หวยฮานอย หวยลาว และหวยหุ้นต่างประเทศ การเลือกเลขเด็ด
// เลขดัง ส่งโพย เวลาปิดรับ อัตราจ่าย 2 ตัว จ่าย 100 บาท / 3 ตัว จ่าย 1,000 บาท
// สมัครเอง 3 ขั้นตอน และแอดมิน 24 ชม. เท่านั้น
// คำศัพท์ของแบรนด์ก่อนหน้า (สล็อต ฟรีสปิน ตัวคูณ ค่ายเกม RTP แตกง่าย เว็บตรง บอล
// ค่าน้ำ อัตราต่อรอง ลีก บิลสเต็ป แฮนดิแคป คาสิโน บาคาร่า ไพ่ เกมยิงปลา) ห้ามหลงเหลือ
// และห้ามเพิ่มใบอนุญาต ชื่อธนาคาร ยอดฝากขั้นต่ำ หรือชื่อผู้ให้บริการจริง
// บรีฟรอบนี้ไม่ได้ระบุรอบย่อยอย่าง ลาวพัฒนา/ฮานอยพิเศษ และไม่ได้พูดเรื่องฝากถอน
// จึงห้ามยกของรอบก่อนมาใช้ซ้ำ
// รอบนี้สองเราต์ตระกูลหวย (/ตรวจหวย, /แนวทาง) เปิดใช้งานอยู่ แต่หน้านี้มีโควตาเป็น
// ปุ่มสองปุ่มเท่านั้น จึงไม่เพิ่มลิงก์อะไรที่นี่
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 152
const pageDescription = "ทางเข้า หวยเฮง789 เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ เพื่อเลือกหวยรัฐบาลไทย หวยฮานอย หวยลาว และหวยหุ้นต่างประเทศ ผ่านเบราว์เซอร์บนมือถือ";

const graph = pageGraph(Astro, {
  name: "ทางเข้า หวยเฮง789 เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ทางเข้า หวยเฮง789 เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า หวยเฮง789 เว็บหลัก" as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ หวยเฮง789"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ab0204] bg-[#2b0909] px-6 py-4 shadow-[0_10px_30px_rgba(11,2,2,0.85)] transition-all duration-300 hover:scale-105 hover:border-[#e43434] hover:bg-[#5c0a0a] hover:shadow-[0_15px_40px_rgba(220,34,36,0.35)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#dc2224]/30 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#f4bc5d] transition-colors group-hover:text-[#ffefc2]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#f4bc5d] transition-colors group-hover:text-[#ffefc2]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก หวยเฮง789"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#a8690c]/70 bg-gradient-to-r from-[#ffefc2] via-[#f4bc5d] to-[#d99a10] px-6 py-4 shadow-[0_10px_30px_rgba(244,188,93,0.40)] transition-all duration-300 hover:scale-105 hover:border-[#ffefc2] hover:shadow-[0_15px_40px_rgba(244,188,93,0.35)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ffefc2]/40 to-transparent"></div>

          <svg class="h-9 w-9 text-[#1c0606]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#1c0606]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
