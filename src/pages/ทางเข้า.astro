---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
//
// BUTTON PAGE ไม่ใช่บทความ — บรีฟ (src/assets/content.txt, 29 บรรทัด) **ไม่มีส่วน
// SUB-PAGES** จึงไม่เคยให้ body กับหน้านี้ ทุกย่อหน้าและทุกหัวข้อย่อยที่เคยอยู่บน
// หน้านี้คือของที่รีแบรนด์รอบก่อนๆ คิดขึ้นเอง แล้วรอบถัดมาก็เขียนทับด้วยความเชื่อว่า
// รอบก่อนมีเหตุผล — ไม่มี ทั้งหน้ามีแค่ชื่อเรื่องจาก ContentBox แล้วต่อด้วยปุ่มสองปุ่ม
// **ห้ามเขียนหัวข้อย่อยหรือย่อหน้าอธิบายใต้ชื่อเรื่อง** — ไม่มีรายการ "ตรวจ N จุด
// ก่อนล็อกอิน" ไม่มีประโยคเตือนเรื่องรหัสผ่าน/OTP ไม่ว่าคอปปี้นั้นจะเขียนดีแค่ไหน
// (ประโยคกำกับเรื่องรหัสผ่าน/OTP ของบรีฟอยู่บน index.astro และ /about-us ซึ่งเป็น
// บทความจริง ไม่ใช่บนหน้าปุ่ม)
//
// h1 บอกว่า "หน้านี้คืออะไร" ("ทางเข้า <แบรนด์> เว็บหลัก") ไม่ใช่บอกว่าบทความบน
// หน้านี้จะเถียงอะไร — ชื่อเรื่องที่โฆษณาเนื้อหาไว้คือบรรทัดที่ล่อให้รีแบรนด์รอบ
// ถัดไปเขียน body กลับมามากที่สุด
//
// cta toggle รอบนี้เปิด: /login และ /register เป็น button page ที่ index ได้
// หน้านี้จึง **ไม่อยู่ในเมนูนาวบาร์โดยตั้งใจ** แต่ยัง route และ index อยู่ และ
// footer ที่ใช้งานอยู่ยังลิงก์มาที่นี่ — ห้ามลบไฟล์นี้ ห้ามย้ายไป
// src/pages-disabled/ และห้ามเติมลิงก์กลับเข้าเมนู
//
// ───────────────────────────────────────────────────────────────────────────
// 🚨 แกนของแบรนด์รอบนี้คือ **คาสิโนออนไลน์** (บาคาร่า · สล็อตออนไลน์ · รูเล็ต ·
// ไฮโล · คาสิโนสด — .claude/brand-spec-abm96.md §5)
// 🚨🚨 **รอบก่อนเป็นเว็บคนละแกนธุรกิจ ห้ามสืบทอดศัพท์หมวดนั้นข้ามรอบเด็ดขาด** และ
// บรีฟรอบนี้ **ไม่มีคำนั้นเลยสักคำ** คำนิยามตัวเองของแบรนด์ก่อนๆ ห้ามเหลือที่ไหน
// ทั้งสิ้น รายการคำที่ห้ามใช้อยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep
// ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// ⚠️ **บรีฟรอบนี้ไม่มีหมวดฝากถอน/ธนาคาร/วอลเลทเลยสักคำ** — หน้านี้ไม่เอ่ยถึงเลย
// ⚠️ route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ทดลองเล่น · /about-us · /contact-us · /terms · /privacy · /line
// **รอบนี้สองหน้าของแกนธุรกิจรอบก่อนถูกย้ายไปจอดใน src/pages-disabled/ แล้ว**
// (ต่างจากรอบก่อน
// ที่สองหน้านั้นเปิดอยู่) → ลิงก์ค้างไปสองหน้านั้น = href ชี้ route ที่ไม่มีจริง =
// verify-build แดง แต่หน้านี้มีโควตาเป็นปุ่มสองปุ่ม จึงไม่ลิงก์ไปที่อื่นเพิ่มอยู่แล้ว
// ⚠️ ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 1 บาท · 0.3% · 0.8% · 24 ชั่วโมง · 3 ขั้นตอน —
// หน้านี้มีโควตาเป็นปุ่มสองปุ่ม จึงไม่อ้างตัวเลขใดเลย
//
// พาเลตรอบนี้อยู่ใน .claude/brand-spec-abm96.md §2
// 🚨🚨 **ทิศความสว่างเหมือนรอบก่อน แต่คนละตระกูลสีทั้งชุด: เนื้อหาสว่าง โครมเข้ม**
// bg.json = {"mode":"color","color":"#f8b9f0"} = **ชมพูพาสเทลอิ่มตัว**
// (รอบก่อนเป็น e1fef3 เขียวมินต์จางเกือบขาว — ค่ามาจากไฟล์ ห้ามเดาว่าเท่าเดิม)
// การ์ด ContentBox จึงเป็นผิวขาว ffffff บนหมึกเข้ม 3d0a2c (= BRAND_TEXT, 16.4:1)
// **ห้าม "แก้" การ์ดกลับไปเป็นผิวเข้ม** — ผิวเข้มบนหมึกนี้ = ตัวอักษรหายไปเลย
//
// ขั้วของปุ่มบนการ์ดผิวขาว (ตรงกับคู่ปุ่มที่ล็อกไว้ใน brand-spec §2):
// สมัครสมาชิก = PRIMARY พื้นไล่เฉดชมพูบานเย็น d11a7e -> a30d63 -> 7a0449
//   บนหมึก **ขาว ffffff** (5.0 / 7.5 / 10.8:1 ผ่าน AA ทุกสต็อป) — ปุ่ม CTA หลัก
//   🚨🚨 **หมึกเข้ม 3d0a2c บนเฉดนี้ตกทุกสต็อป ห้ามใช้เด็ดขาด** (บน 7a0449 ได้ 1.5:1)
//   ⚠️⚠️ **ห้ามลากปลายอ่อนกว่า d11a7e** — ขาวบน e0509f เหลือ 3.6:1
// เข้าสู่ระบบ = SECONDARY ผิวพื้นถมอ่อน fcd9ee บนหมึก **a30d63** (5.8:1)
//   brand-spec §2 เขียนปุ่มรองไว้เป็นผิวขาว แต่การ์ดใบนี้ก็ขาว → ใช้ "พื้นถมอ่อน"
//   ของพาเลตเป็นผิวปุ่มแทน (ไม่ได้เพิ่มค่าใหม่) ขอบ e0509f คือสิ่งที่แยกปุ่มนี้ออก
//   จากผิวการ์ด — ห้ามถอดขอบออก
// ⚠️⚠️ **ffffff fff5fb fcd9ee f3a7d3 e0509f ff7ac2 f8b9f0 เป็นผิว/เส้น
//   ห้ามถือตัวอักษรเด็ดขาด** · ที่ถือตัวอักษรได้บนการ์ดขาวคือ 3d0a2c (16.4:1) ·
//   a30d63 (7.5:1) · 7a4263 (7.5:1) · 6e4705 (8.2:1)
// 🚨 **f2c14e (ทองอำพัน) ได้แค่ 1.7:1 บนการ์ดขาว — ห้ามถือตัวอักษรบนหน้านี้**
//   มันถือตัวอักษรได้เฉพาะบนโครมเข้ม 440d31 ซึ่งไม่ใช่โซนของไฟล์นี้
// ⚠️⚠️ **ค่าของแบรนด์รอบก่อน (e1fef3 f0fdf7 d2f3e4 a3ddc3 19a97c 2fd49b
//   052e22 0d3326 3f6f5c 046c4e 8a6508 e2b32a 0c7c58 03543c — เขียนแบบไม่มี #
//   โดยตั้งใจ) ห้ามหลงเหลือในไฟล์นี้แม้แต่ค่าเดียว**
// ⚠️⚠️ **ฮิวนำของรอบนี้คือชมพูบานเย็น a30d63 คู่ทองอำพัน f2c14e บนผิวสว่าง** —
//   เวิร์ดมาร์กละตินสามมิติอ้วนมนผิวไล่จากขาวนวลลงชมพูอ่อนตัดขอบชมพูเข้มสองชั้น
//   โดยตัว A มีหัวใจชมพูซ้อนในช่องกลางตัวอักษร คู่กับมาสคอตลูกหมูการ์ตูนหูตกใน
//   จานวงกลมขอบขาว ส่วนผ้าซาตินชมพู ไพ่เอซ ลูกเต๋าชมพู ชิปคาสิโน และวงล้อรูเล็ต
//   ขอบทองในอาร์ตเวิร์ก **เป็นวัตถุในภาพ ไม่ใช่สี UI** · พื้นเพจมาจาก bg.json
//   เท่านั้น **ห้ามอนุมานสีจากรูป**
// ⚠️ ปุ่มของ Navfoot อยู่บนแถบโครมเข้ม คนละโซนกับปุ่มบนการ์ดขาวนี้
// **ห้ามลอกคลาสของ Navfoot มาวางบนการ์ด** (หมึกของโครมเป็นหมึกสว่าง จะหายบนการ์ดขาว)
// ออราในไฟล์นี้ใช้ rgba(163,13,99,α) · rgba(224,80,159,α) · rgba(61,10,44,α) เท่านั้น
//
// ⚠️⚠️ กับดักรอบนี้: **มีแบรนด์เก่าในรีโปนี้ที่เป็นชมพูบานเย็น/ทอง ตระกูลสีเดียวกับ
// รอบนี้เป๊ะ** รองลงมาคือชมพูบับเบิลกัมและแดงชาด/ชมพูบลัชอีกสองเจ้า →
// **"เจอชมพูหรือทอง ไม่ได้แปลว่าเป็นของรอบนี้"** ต้องเทียบให้ตรงหกหลักกับตารางใน
// brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ
// false positive · คู่ที่ต้องสงสัยก่อนเสมอ: d91a73 ↔ d11a7e · 9c0f55 / b01160 /
// a30d1a ↔ a30d63 · fb439b / fa63b9 ↔ e0509f
// รอบนี้ **ไม่มีเขียว/ส้ม/แดงชาด/ม่วง/ฟ้า/ไซแอน/เหลืองมะนาวเป็นสี UI** เลยสักเฉด
//
// Announcement รอบนี้หมุนมาเป็นตัวที่ลงท้ายด้วยเลขห้า ทั้งเว็บ
// (brand-spec §3 — รอบก่อนใช้ตัวที่ลงท้ายด้วยชื่อตระกูลของแบรนด์ก่อนจึงหมุนออก ·
// เขียนชื่อ
// variant แบบไม่มีเครื่องหมายคำพูดโดยตั้งใจ เพราะ tools/gen-tw-sources.mjs นับ
// literal ที่มีเครื่องหมายคำพูดว่าเป็นการ import จริง คอมเมนต์จึงทำให้ variant เก่า
// หลุดเข้า Tailwind scan แล้วสีของแบรนด์ก่อนขึ้น stylesheet) orchestrator เป็น
// เจ้าของ default message ของไฟล์นั้น ทุกหน้าเรียกแบบ bare จึง **ห้ามส่ง prop
// message** จากหน้านี้ ไม่งั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้ไม่มี UTF-8 locale จึงนับเป็นไบต์ = เกินจริงราว 3 เท่า)
// หน้านี้ยาว 151 ด้วยชื่อแบรนด์ 5 โค้ดพอยต์ของรอบนี้ (รอบก่อนยาว 9 — ต้องนับใหม่
// ทุกรอบ ห้ามสืบทอดความยาวข้ามแบรนด์) ส่วนที่ไม่ใช่ชื่อแบรนด์ยาว 146 →
// รับชื่อแบรนด์ได้ 4–14 อักขระ ถ้ารอบหน้าชื่อยาวกว่านั้นต้องตัดข้อความ
// ไม่ใช่ปล่อยผ่าน
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ทำให้ตัวนับเห็นเป็น 5 อักขระ
// ประโยคนี้บรรยาย "สิ่งที่หน้านี้มี" เท่านั้น — หน้านี้มีแค่ปุ่มสองปุ่ม ไม่มีปุ่ม LINE
// จึงไม่สัญญาช่องทางแชตไว้ใน description
const pageDescription = `ทางเข้า ${BRAND_NAME} เว็บหลัก รวมปุ่มเข้าสู่ระบบและสมัครสมาชิกไว้ในหน้าเดียว สำหรับผู้ที่ต้องการเข้าใช้งานระบบสมาชิก ควรตรวจสอบที่อยู่เว็บไซต์ทางการก่อนใช้งาน`;

const graph = pageGraph(Astro, {
  name: `ทางเข้า ${BRAND_NAME} เว็บหลัก`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title={`ทางเข้า ${BRAND_NAME} เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ทางเข้า ${BRAND_NAME} เว็บหลัก`} as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="group mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 rounded-xl border-2 border-[#e0509f] bg-[#fcd9ee] px-6 py-4 shadow-[0_8px_24px_rgba(61,10,44,0.10)] transition-all duration-300 hover:scale-105 hover:border-[#a30d63] hover:shadow-[0_14px_36px_rgba(163,13,99,0.18)]">
          <svg class="h-9 w-9 text-[#a30d63]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#a30d63]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border-2 border-[#e0509f] bg-gradient-to-b from-[#d11a7e] via-[#a30d63] to-[#7a0449] px-6 py-4 shadow-[0_10px_30px_rgba(61,10,44,0.10)] transition-all duration-300 hover:scale-105 hover:border-[#ff7ac2] hover:shadow-[0_15px_40px_rgba(163,13,99,0.18)]">
          <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-white/10 to-transparent"></span>

          <svg class="h-9 w-9 text-[#ffffff]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-black tracking-wide text-[#ffffff]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
