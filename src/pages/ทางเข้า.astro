---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
//
// BUTTON PAGE ไม่ใช่บทความ — บรีฟรอบนี้ (src/assets/content.txt) จบที่บรรทัด 29
// และ **ไม่มีส่วน SUB-PAGES เลย** จึงไม่เคยให้ body กับหน้านี้ ทุกย่อหน้าและทุก
// หัวข้อย่อยที่เคยอยู่บนหน้านี้คือของที่รีแบรนด์รอบก่อนๆ คิดขึ้นเอง แล้วรอบถัดมา
// ก็เขียนทับด้วยความเชื่อว่ารอบก่อนมีเหตุผล — ไม่มี
// ทั้งหน้ามีแค่ชื่อเรื่องจาก ContentBox แล้วต่อด้วยปุ่มสองปุ่ม
// **ห้ามเขียนหัวข้อย่อยหรือย่อหน้าอธิบายใต้ชื่อเรื่อง** — ไม่มีรายการ "ตรวจ N จุด
// ก่อนล็อกอิน" ไม่มีประโยคเตือนเรื่องรหัสผ่าน/OTP ไม่ว่าคอปปี้นั้นจะเขียนดีแค่ไหน
// (ข้อความเตือนเรื่องรหัสผ่าน/OTP ของบรีฟอยู่บน index.astro ซึ่งเป็นบทความจริง
// ไม่ใช่บนหน้าปุ่ม)
//
// h1 บอกว่า "หน้านี้คืออะไร" ("ทางเข้า <แบรนด์> เว็บหลัก") ไม่ใช่บอกว่าบทความบน
// หน้านี้จะเถียงอะไร — ชื่อเรื่องที่โฆษณาเนื้อหาไว้คือบรรทัดที่ล่อให้รีแบรนด์รอบ
// ถัดไปเขียน body กลับมามากที่สุด
//
// cta toggle รอบนี้เปิด: /login และ /register เป็น button page ที่ index ได้
// หน้านี้จึง **ไม่อยู่ในเมนูนาวบาร์โดยตั้งใจ** (รอบนี้คือ NavbarStyle6) แต่ยัง route
// และ index อยู่ และ footer ที่ใช้งานอยู่ (FooterPremiumSumo) ยังลิงก์มาที่นี่ —
// ห้ามลบไฟล์นี้ ห้ามย้ายไป src/pages-disabled/ และห้ามเติมลิงก์กลับเข้าเมนู
//
// ───────────────────────────────────────────────────────────────────────────
// แกนของแบรนด์รอบนี้คือ **เว็บสล็อตออนไลน์ เกมสล็อตจ่ายแพง ปรับเรทแตกหนัก**
// **ไม่ใช่แกนของรอบก่อน และไม่ใช่เว็บลอตเตอรี**
// คำกลุ่มกีฬา/เกมไพ่/ลอตเตอรี และวลีขายของรอบก่อนทุกคำที่เจอในไฟล์นี้จึงเป็นของค้าง
// รายการเต็มอยู่ใน .claude/brand-spec-ruaythear168club.md §5 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้
// sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// ⚠️ **สองหน้าหมวดลอตเตอรีอยู่ใน src/pages-disabled/ รอบนี้** → ลิงก์ไปสอง
// route นั้นไม่มีอยู่จริง ห้ามเขียนกลับมาเด็ดขาด (build จะแดง)
// route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ทดลองเล่น · /about-us · /contact-us · /terms · /privacy · /line
// ⚠️ บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกม ชื่อธนาคาร ชื่อวอลเล็ต ใบอนุญาต ปีก่อตั้ง
// จำนวนสมาชิก ค่า RTP เป็นตัวเลข หรือยอดฝากขั้นต่ำแม้แต่รายเดียว และตัวเลขที่ใช้ได้
// มีแค่ 0.3% · 0.8% · 3 ขั้นตอน · 24ชม. — หน้านี้มีโควตาเป็นปุ่มสองปุ่มเท่านั้น
// จึงไม่อ้างตัวเลขใดเลย
//
// พาเลตรอบนี้อยู่ใน .claude/brand-spec-ruaythear168club.md §2
// 🚨🚨 **รอบนี้เป็นธีมสว่าง กลับทิศจากรอบก่อน 180 องศา — การ์ดผิวขาว หมึกน้ำเงิน
// เข้ม** bg.json = {"mode":"color","color":"#dbe6ff"} = **ฟ้าเพอริวิงเคิลอ่อน**
// การ์ด ContentBox จึงเป็นผิว #ffffff บนหมึก #16294a (= BRAND_TEXT)
// **ห้าม "แก้" การ์ดกลับไปเป็นผิวเข้มเพราะรอบก่อนเป็นแบบนั้น**
//
// ขั้วของปุ่มบนการ์ดผิวสว่าง:
// สมัครสมาชิก = PRIMARY พื้นไล่เฉดฟ้า #0d6b9b -> #0a5176 บนหมึก **ขาว #ffffff**
//   (5.6 / 8.0:1) — นี่คือปุ่ม CTA หลัก
// เข้าสู่ระบบ = SECONDARY ปุ่มขอบ: ขอบ #0d6b9b ตัวอักษร #0d6b9b บนผิวกลาง
//   #eef4ff (5.2:1) — รอบนี้ไม่มี "สีที่สอง" ที่ถมแล้วยังถือตัวอักษรได้
// ⚠️⚠️ **วัสดุที่สองของรอบนี้คือครีม #f4e4d3 / #e4cbb3 ซึ่งเป็นพื้น/ออราเท่านั้น**
//   ทองในอาร์ตเวิร์กเป็นวัตถุในภาพ ไม่ใช่สี UI และแรมป์เทาเงินเป็นของแบรนด์เก่า
//   **ห้ามใส่กลับเข้ามาในไฟล์นี้**
// ⚠️⚠️ **#18a5e2 ได้แค่ 2.6:1 บนผิวสว่าง ห้ามถือตัวอักษรและห้ามถมเป็นพื้นปุ่มที่มี
// ตัวอักษรขาว** เป็นขอบ/ออรา/ไอคอนเท่านั้น · **#a9d7f2 ห้ามถือตัวอักษร** —
// ตัวอักษรบนการ์ดใช้ #16294a (เนื้อความ) หรือ #0d6b9b (หัวข้อ/ไฮไลต์/ปุ่มรอง)
// เท่านั้น ส่วนตัวอักษรบนปุ่มหลักเป็น #ffffff
// ⚠️ ปุ่มของ Navfoot อยู่บนแถบโครมคนละโซนกับปุ่มบนการ์ดนี้
// **ห้ามลอกคลาสของ Navfoot มาวางบนการ์ด**
// ออราในไฟล์นี้ใช้ rgba(24,165,226,α) · rgba(13,107,155,α) · rgba(22,41,74,α) ·
// rgba(255,255,255,α) · rgba(0,0,0,α) เท่านั้น
//
// ⚠️ กับดักรอบนี้คือ **ฟ้าเคยนำมาแล้วห้าแบรนด์ในรีโปนี้** การเจอฟ้าในไฟล์จึง
// **ไม่พิสูจน์ว่าเป็นค่าของรอบนี้** ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน
// brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ
// false positive
// รอบนี้ **ไม่มีทอง/เหลือง ไม่มีน้ำตาล ไม่มีแดง ไม่มีเขียว ไม่มีชมพู/บานเย็น
// ไม่มีม่วง ไม่มีส้ม ไม่มีโรสโกลด์ และไม่มีแรมป์เทาเงิน**
//
// Announcement รอบนี้หมุนมาเป็น Announcement5 ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ Announcement2 จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์
// นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว ทุกหน้าเรียกแบบ bare จึง **ห้ามส่ง prop message**
// จากหน้านี้ ไม่งั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้ไม่มี UTF-8 locale จึงนับเป็นไบต์ = เกินจริงราว 3 เท่า)
// หน้านี้ยาว 156 ด้วยชื่อแบรนด์ 9 ตัวอักษรของรอบนี้
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ทำให้ตัวนับเห็นเป็น 5 อักขระ
// ประโยคนี้บรรยาย "สิ่งที่หน้านี้มี" เท่านั้น — หน้านี้มีแค่ปุ่มสองปุ่ม ไม่มีปุ่ม LINE
// จึงไม่สัญญาช่องทางแชตไว้ใน description
// ส่วนท้ายมาจากบรีฟบรรทัด 16 ตรงตัว: ตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้องก่อนดำเนินการ
const pageDescription = `ทางเข้า ${BRAND_NAME} เว็บหลัก รวมปุ่มเข้าสู่ระบบและสมัครสมาชิกเว็บสล็อตออนไลน์ไว้ในหน้าเดียว ควรตรวจสอบที่อยู่ของเว็บไซต์ทางการให้ถูกต้องทุกครั้งก่อนกรอกข้อมูล`;

const graph = pageGraph(Astro, {
  name: `ทางเข้า ${BRAND_NAME} เว็บหลัก`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title={`ทางเข้า ${BRAND_NAME} เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ทางเข้า ${BRAND_NAME} เว็บหลัก`} as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="group mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 rounded-xl border-2 border-[#0d6b9b] bg-[#eef4ff] px-6 py-4 shadow-[0_8px_24px_rgba(22,41,74,0.12)] transition-all duration-300 hover:scale-105 hover:border-[#18a5e2] hover:shadow-[0_14px_36px_rgba(24,165,226,0.35)]">
          <svg class="h-9 w-9 text-[#0d6b9b]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#0d6b9b]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border-2 border-[#0a5176] bg-gradient-to-b from-[#0d6b9b] to-[#0a5176] px-6 py-4 shadow-[0_10px_30px_rgba(13,107,155,0.35)] transition-all duration-300 hover:scale-105 hover:border-[#18a5e2] hover:shadow-[0_15px_40px_rgba(24,165,226,0.4)]">
          <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-white/20 to-transparent"></span>

          <svg class="h-9 w-9 text-[#ffffff]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-black tracking-wide text-[#ffffff]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
