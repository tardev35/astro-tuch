---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

// Button page, not an article: the docx gives this route a Title and a Meta and
// never a body. One heading from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 158.
const pageDescription =
  "ทางเข้า JUDTEM168 เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกใหม่ได้จากหน้านี้ทันที เข้าเล่นเกมสล็อตได้ต่อเนื่องตลอดทั้งวัน รองรับทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์";

const graph = pageGraph(Astro, {
  name: "ทางเข้า JUDTEM168 เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ทางเข้า JUDTEM168 เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกใหม่เข้าเล่นสล็อตได้ทันที" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า JUDTEM168 เว็บหลัก" as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ JUDTEM168"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f5d98a]/70 bg-[#050301] px-6 py-4 shadow-[0_10px_30px_rgba(204,156,45,0.18)] transition-all duration-300 hover:scale-105 hover:border-[#e8bf4e] hover:bg-[#1d1407] hover:shadow-[0_15px_40px_rgba(232,191,78,0.30)]">
          <div class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#cc9c2d]/25 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#e8bf4e]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#fff6d4]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก JUDTEM168"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#e8bf4e]/70 bg-gradient-to-r from-[#e8bf4e] via-[#d8ae3a] to-[#6a5115] px-6 py-4 shadow-[0_10px_30px_rgba(232,191,78,0.25)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(232,191,78,0.38)]">
          <div class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-white/25 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#050301]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#050301]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
