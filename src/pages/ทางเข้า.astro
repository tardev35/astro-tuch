---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
// Heading inventory for this page must stay h1x1, h2x0, h3x0.
//
// The <h1> names what the page IS ("ทางเข้า <brand> เว็บหลัก"), not what an
// article on it would have argued — a title that previews a body reads as a
// broken promise once the body is gone, and is the line most likely to tempt
// the next rebrand into writing it back.
//
// This route stays OUT of the navbar menu on purpose while the cta toggle is on
// (/login and /register are menu entries themselves), but it is still routed,
// still indexed and still linked from the footer. Do not add a nav link and do
// not delete the page.
//
// Two button tiers on the UP555 palette (brand-spec §2 ทองนำ เงินโครเมียมรอง
// บนดำอมน้ำตาล — มาจาก logo.webp ที่ตัว U กับ UP เป็นเงินโครเมียม #d5d4d3 ส่วน
// ลูกศร วงรี และเลข 555 เป็นทองเมทัลลิก #ebbb54):
// สมัครสมาชิก คือแอ็กชันหลัก จึงได้ไล่เฉด **ทอง** เต็มใบ (#fce675 → #ebbb54 →
// #ab6d24) ขอบทองเข้ม #ab6d24 ตัวอักษร **ดำอมน้ำตาล #160d02** — กฎคอนทราสต์:
// หมึกขาวบนทองสว่าง #fce675 ตก พื้นทองจึงต้องใช้หมึกเข้มเสมอ (#160d02 ≈ 14:1)
// ส่วน เข้าสู่ระบบ เป็นแอ็กชันรอง จึงเป็นแบบ outline **เงินโครเมียม** — กรอบ
// #d5d4d3/60 ตัวอักษรเงินสว่าง #f3f3f2 บนพื้นชิป #241705 hover ยกกรอบเป็น #f3f3f2
// ลำดับความสำคัญจึงสื่อด้วย "ถมทอง vs กรอบเงินบนพื้นดำอมน้ำตาล" ไม่ใช่ถมสีเดียวกัน
// สองใบ ซึ่งจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม — และไม่ใช่ทองจางๆ ซึ่งอ่านเป็นปุ่มที่ปิดใช้งาน
// ออราด้านบนของปุ่มใช้คู่ตรงข้ามตามลายเซ็นโลโก้: ปุ่มรองเป็นเงิน rgba(213,212,211,α)
// ปุ่มหลักเป็นทองสว่างไล่ลงไปใส
// ชุดเขียว-แดงของ DM899 (#01a326 #4ade6b #12c23a #01841b #fb252b #ffe9a8 #f2b422
// #030a05 #0a1a0e #102a16 #061008 #06140a #e4f2e4 rgba(1,163,38,*) rgba(3,10,5,*)
// rgba(74,222,107,*) rgba(242,180,34,*)) ถูกแทนครบแล้ว
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ (รอบก่อน DM899 เป็น
// Announcement3) — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ
// UP555 แล้ว และ index ก็เรียกแบบ bare จึงห้ามส่ง prop message จากหน้านี้
//
// UP555 เป็นคาสิโนที่รวมสล็อต บาคาร่า บอล และหวยไว้ในบัญชีเดียว — ไม่ใช่เว็บหวย
// และไม่ใช่ "เว็บตรงต่างประเทศ" บรีฟรอบนี้พูดถึงการเลือกหมวดเกมได้จากบัญชีเดียว
// ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการผ่านระบบเดียว โดยไม่ต้องสมัครใหม่หลายครั้ง
// คำศัพท์หวยของแบรนด์ก่อนหน้า (แทงหวย ส่งโพย โพย เลือกเลข 2 ตัว 3 ตัว อัตราจ่าย
// งวด รัฐบาลไทย ฮานอย ลาวพัฒนา หวยหุ้น ตรวจหวย แนวทางหวย) ห้ามหลงเหลือ — "หวย"
// เฉยๆ ใช้ได้เพราะบรีฟระบุเป็นหนึ่งในหมวดเกม แต่หน้าหวยสองหน้ายังปิดอยู่ตามสเปก
// และห้ามเพิ่มใบอนุญาต ชื่อค่ายเกม ชื่อธนาคาร ยอดฝากขั้นต่ำ ค่า RTP หรือชื่อผู้ให้
// บริการจริงที่บรีฟไม่ได้ระบุ หน้านี้มีโควตาเป็นปุ่มสองปุ่มเท่านั้น
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 156
const pageDescription = `ทางเข้า ${BRAND_NAME} เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ เพื่อเลือกสล็อต บาคาร่า บอล หวย จากบัญชีเดียว พร้อมตรวจสอบเครดิต โปรโมชั่น และประวัติรายการ`;

const graph = pageGraph(Astro, {
  name: `ทางเข้า ${BRAND_NAME} เว็บหลัก`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title={`ทางเข้า ${BRAND_NAME} เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ทางเข้า ${BRAND_NAME} เว็บหลัก`} as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#d5d4d3]/60 bg-[#241705] px-6 py-4 shadow-[0_10px_30px_rgba(12,5,2,0.75)] transition-all duration-300 hover:scale-105 hover:border-[#f3f3f2] hover:shadow-[0_15px_40px_rgba(213,212,211,0.3)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#d5d4d3]/28 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#d5d4d3] transition-colors group-hover:text-[#f3f3f2]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#d5d4d3] transition-colors group-hover:text-[#f3f3f2]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ab6d24] bg-gradient-to-r from-[#fce675] via-[#ebbb54] to-[#ab6d24] px-6 py-4 shadow-[0_10px_30px_rgba(235,187,84,0.40)] transition-all duration-300 hover:scale-105 hover:border-[#fce675] hover:shadow-[0_15px_40px_rgba(252,230,117,0.35)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#fce675]/35 to-transparent"></div>

          <svg class="h-9 w-9 text-[#160d02]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#160d02]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
