---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
// Heading inventory for this page must stay h1x1, h2x0, h3x0.
//
// The <h1> names what the page IS ("ทางเข้า <brand> เว็บหลัก"), not what an
// article on it would have argued — a title that previews a body reads as a
// broken promise once the body is gone, and is the line most likely to tempt
// the next rebrand into writing it back.
//
// This route stays OUT of the navbar menu on purpose while the cta toggle is on
// (/login and /register are menu entries themselves), but it is still routed,
// still indexed and still linked from the footer. Do not add a nav link and do
// not delete the page.
//
// Two button tiers on the หวยคิง palette (brand-spec §2 ทองโลหะบนดำอมน้ำตาล
// สีรองครีมอมพีช — มาจาก logo/banner ที่มงกุฎกับตัวอักษร "หวยคิง" เป็นทองเมทัลลิก
// ส่วนชุดของนางแบบใน slide1/slide2 เป็นครีมอมพีช #fcd4c3):
// สมัครสมาชิก คือแอ็กชันหลัก จึงได้ไล่เฉด **ทอง** เต็มใบ (#fdeb7c → #cd9a2c →
// #ab7314) ขอบทองลึก #ab7314 ตัวอักษร **ดำอมน้ำตาล #120a02** — กฎคอนทราสต์:
// หมึกขาวบนทองสว่าง #fdeb7c ตก พื้นทองจึงต้องใช้หมึกเข้มเสมอ (#120a02 ≈ 15:1)
// ส่วน เข้าสู่ระบบ เป็นแอ็กชันรอง จึงเป็นแบบ outline **ครีมอมพีช** — กรอบ
// #fcd4c3/60 ตัวอักษร #fce2d4 บนพื้นลึกสุด #0c0b0a hover ยกกรอบเป็น #fce2d4
// ลำดับความสำคัญจึงสื่อด้วย "ถมทอง vs กรอบครีมบนพื้นดำอมน้ำตาล" ไม่ใช่ถมสีเดียวกัน
// สองใบ ซึ่งจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม — และไม่ใช่ทองจางๆ ซึ่งอ่านเป็นปุ่มที่ปิดใช้งาน
// ออราด้านบนของปุ่มใช้คู่ตรงข้ามตามลายเซ็นงานศิลป์: ปุ่มรองเป็นครีม
// rgba(252,212,195,α) ปุ่มหลักเป็นทองสว่างไล่ลงไปใส เงากลางเป็น rgba(0,0,0,α)
// ชุดทอง-เงินโครเมียมของแบรนด์ก่อน (#ebbb54 #fce675 #ab6d24 #d5d4d3 #f3f3f2 #241705
// #0c0502 #160d02 rgba(235,187,84,*) rgba(12,5,2,*) rgba(213,212,211,*)
// rgba(252,230,117,*)) ถูกแทนครบแล้ว
//
// Announcement หมุนมาเป็น AnnouncementHuay ทั้งเว็บรอบนี้ (แบรนด์ก่อนหน้าใช้
// Announcement5) — default message ของไฟล์นั้นเป็นคอปปี้ของ หวยคิง แล้ว และ
// index ก็เรียกแบบ bare จึงห้ามส่ง prop message จากหน้านี้
//
// หวยคิง เป็นเว็บรับแทงหวยล้วน บรีฟรอบนี้พูดถึงการเลือกรายการหวย กรอกเลขและยอด
// ตรวจอัตราจ่ายก่อนส่งโพย และดูเครดิตกับประวัติโพยจากบัญชีเดียว คำของแบรนด์ก่อน
// (สล็อต บาคาร่า บอล ค่ายเกม คาสิโนสด RTP หมวดเกม ทางเข้าเล่นใหม่) ห้ามหลงเหลือ
// และห้ามเพิ่มชื่อตลาดหวย เวลาเปิด-ปิดรับ ใบอนุญาต ชื่อธนาคาร หรือยอดฝากขั้นต่ำ
// ที่บรีฟไม่ได้ระบุ หน้านี้มีโควตาเป็นปุ่มสองปุ่มเท่านั้น
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 157
const pageDescription = `ทางเข้า ${BRAND_NAME} เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ เพื่อเลือกรายการหวย ส่งโพย ตรวจอัตราจ่าย และเปิดดูเครดิตกับประวัติโพยของตัวเองจากบัญชีเดียว`;

const graph = pageGraph(Astro, {
  name: `ทางเข้า ${BRAND_NAME} เว็บหลัก`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title={`ทางเข้า ${BRAND_NAME} เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ทางเข้า ${BRAND_NAME} เว็บหลัก`} as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fcd4c3]/60 bg-[#0c0b0a] px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.75)] transition-all duration-300 hover:scale-105 hover:border-[#fce2d4] hover:shadow-[0_15px_40px_rgba(252,212,195,0.3)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#fcd4c3]/28 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#fcd4c3] transition-colors group-hover:text-[#fce2d4]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#fcd4c3] transition-colors group-hover:text-[#fce2d4]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ab7314] bg-gradient-to-r from-[#fdeb7c] via-[#cd9a2c] to-[#ab7314] px-6 py-4 shadow-[0_10px_30px_rgba(205,154,44,0.40)] transition-all duration-300 hover:scale-105 hover:border-[#fdeb7c] hover:shadow-[0_15px_40px_rgba(253,235,124,0.35)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#fdeb7c]/35 to-transparent"></div>

          <svg class="h-9 w-9 text-[#120a02]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#120a02]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
