---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
//
// This route stays OUT of the navbar menu on purpose while the cta toggle is on
// (/login and /register are menu entries themselves), but it is still routed,
// still indexed and still linked from the footer. Do not add a nav link and do
// not delete the page.
//
// Two button tiers on the FAH999 palette (ทองบนดำ ตามโลโก้ — แบรนด์นี้มีสีเดียว
// จึงแยกลำดับด้วย "ความสว่างของพื้น" ไม่ใช่ด้วยสีที่สอง): สมัครสมาชิก คือแอ็กชัน
// หลัก จึงได้พื้นไล่ทองเต็มใบ (#f7e7a8 → #e8c25a → #a3732c) ตัวอักษรเป็นดำอมทอง
// #140f06 ส่วน เข้าสู่ระบบ เป็นแอ็กชันรอง จึงเป็นเส้นขอบทอง #e8c25a บนผิวยก
// #1c160e ตัวอักษรทองหลัก (hover ยกผิวขึ้นอีกหนึ่งขั้นเป็น #241c11 ซึ่งเป็น
// เฉดเดียวกันที่สว่างกว่า ไม่ใช่สีที่สอง) แดงของแบรนด์ก่อนหายไปทั้งหมด
//
// Announcement รอบนี้หมุนมาใช้ Announcement5 ทั้งเว็บ — default message ของไฟล์
// นั้นเป็นคอปปี้ของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 157
const pageDescription = "ทางเข้า FAH999 เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกยูสใหม่ได้จากหน้านี้ทันที เข้าเล่นสล็อตจากหลายค่ายแบบไม่ล็อคยูส รองรับมือถือและคอมพิวเตอร์ ฝากถอนไม่จำกัด";

const graph = pageGraph(Astro, {
  name: "ทางเข้า FAH999 เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ทางเข้า FAH999 เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า FAH999 เว็บหลัก" as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ FAH999"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#e8c25a]/55 bg-[#1c160e] px-6 py-4 shadow-[0_10px_30px_rgba(232,194,90,0.18)] transition-all duration-300 hover:scale-105 hover:border-[#f7e7a8] hover:bg-[#241c11] hover:shadow-[0_15px_40px_rgba(232,194,90,0.38)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#e8c25a]/25 to-transparent"></div>

          <svg class="h-9 w-9 text-[#e8c25a]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#e8c25a]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก FAH999"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f7e7a8]/60 bg-gradient-to-r from-[#f7e7a8] via-[#e8c25a] to-[#a3732c] px-6 py-4 shadow-[0_10px_30px_rgba(232,194,90,0.38)] transition-all duration-300 hover:scale-105 hover:border-[#f7e7a8] hover:shadow-[0_15px_40px_rgba(247,231,168,0.42)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#fefac4]/35 to-transparent"></div>

          <svg class="h-9 w-9 text-[#140f06]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#140f06]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
