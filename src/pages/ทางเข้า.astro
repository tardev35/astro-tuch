---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
//
// BUTTON PAGE ไม่ใช่บทความ — บรีฟรอบนี้ (src/assets/content.txt) จบที่บรรทัด 29
// และ **ไม่มีส่วน SUB-PAGES เลย** จึงไม่เคยให้ body กับหน้านี้ ทุกย่อหน้าและทุก
// หัวข้อย่อยที่เคยอยู่บนหน้านี้คือของที่รีแบรนด์รอบก่อนๆ คิดขึ้นเอง แล้วรอบถัดมา
// ก็เขียนทับด้วยความเชื่อว่ารอบก่อนมีเหตุผล — ไม่มี
// ทั้งหน้ามีแค่ชื่อเรื่องจาก ContentBox แล้วต่อด้วยปุ่มสองปุ่ม
// **ห้ามเขียนหัวข้อย่อยหรือย่อหน้าอธิบายใต้ชื่อเรื่อง** — ไม่มีรายการ "ตรวจ N จุด
// ก่อนล็อกอิน" ไม่มีประโยคเตือนเรื่องรหัสผ่าน/OTP ไม่ว่าคอปปี้นั้นจะเขียนดีแค่ไหน
// (ประโยคกำกับเรื่องรหัสผ่าน/OTP ของบรีฟอยู่บน index.astro ซึ่งเป็นบทความจริง
// ไม่ใช่บนหน้าปุ่ม)
//
// h1 บอกว่า "หน้านี้คืออะไร" ("ทางเข้า <แบรนด์> เว็บหลัก") ไม่ใช่บอกว่าบทความบน
// หน้านี้จะเถียงอะไร — ชื่อเรื่องที่โฆษณาเนื้อหาไว้คือบรรทัดที่ล่อให้รีแบรนด์รอบ
// ถัดไปเขียน body กลับมามากที่สุด
//
// cta toggle รอบนี้เปิด: /login และ /register เป็น button page ที่ index ได้
// หน้านี้จึง **ไม่อยู่ในเมนูนาวบาร์โดยตั้งใจ** แต่ยัง route และ index อยู่ และ
// footer ที่ใช้งานอยู่ยังลิงก์มาที่นี่ — ห้ามลบไฟล์นี้ ห้ามย้ายไป
// src/pages-disabled/ และห้ามเติมลิงก์กลับเข้าเมนู
//
// ───────────────────────────────────────────────────────────────────────────
// แกนของแบรนด์รอบนี้คือ **สล็อตลิขสิทธิ์แท้ในไทย เว็บตรงไม่ผ่านเอเย่นต์**
// (.claude/brand-spec-zane96.md §1) คำนิยามตัวเองของแบรนด์ก่อนๆ ห้ามเหลือ
// ที่ไหนทั้งสิ้น รายการคำที่ห้ามใช้อยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้
// sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// 🚨 **บรีฟรอบนี้ไม่พูดถึงธนาคาร วอลเลท หรือการฝากถอนเลยแม้แต่คำเดียว** —
// ชื่อวอลเล็ตของแบรนด์ขาออกคือคำที่พลาดง่ายที่สุด เพราะมันอยู่เกือบทุกหน้าของรอบ
// ก่อนๆ (ค่าเต็มอยู่ใน brand-spec §5) หน้านี้ไม่เอ่ยถึงเลย
// ⚠️ **สองหน้าหมวดลอตเตอรีถูกปิดรอบนี้** (อยู่ใน src/pages-disabled/ เพราะรอบนี้
// เป็นเว็บสล็อต) route ที่มีจริงรอบนี้: / · /promotion · /register · /login ·
// /ทางเข้า · /ทดลองเล่น · /about-us · /contact-us · /terms · /privacy · /line
// **ลิงก์ไป route ที่ไม่มีจริง = build แดง** แต่หน้านี้มีโควตาเป็นปุ่มสองปุ่ม
// จึงไม่ลิงก์ไปที่อื่นเพิ่มอยู่แล้ว
// ⚠️ ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 1 บาท · 0.3% · 0.8% · 3 ขั้นตอน · 24ชม. —
// หน้านี้มีโควตาเป็นปุ่มสองปุ่ม จึงไม่อ้างตัวเลขใดเลย
//
// พาเลตรอบนี้อยู่ใน .claude/brand-spec-zane96.md §2
// 🚨 **รอบนี้เนื้อหาเป็นผิวสว่าง โครมเป็นผิวเข้ม (ทิศเดียวกับรอบก่อน) แต่ฮิว
// คนละตระกูลสิ้นเชิง** bg.json = {"mode":"color","color":"#f8e6f9"} =
// **ไลแลคอมชมพูจาง** (รอบก่อนเป็นขาวอมชมพูที่จางกว่านี้ — ค่ามาจากไฟล์
// ห้ามเดาว่าเท่าเดิม)
// การ์ด ContentBox จึงเป็นผิว #ffffff บนหมึก #241046 (= BRAND_TEXT, 16.8:1)
// **ห้าม "แก้" การ์ดกลับไปเป็นผิวมืดตามโครม** — การ์ดมืดบนหมึกนี้ = ตัวอักษรหายไปเลย
//
// ขั้วของปุ่มบนการ์ดผิวขาว (ตรงกับคู่ปุ่มที่ล็อกไว้ใน brand-spec §2):
// สมัครสมาชิก = PRIMARY พื้นไล่เฉดไวโอเลต→แมเจนต้า #5411c4 -> #8e14b8 -> #c2178b
//   บนหมึก **ขาว #ffffff** (9.3 / 7.2 / 5.6:1 ผ่านทุกสต็อป) — ปุ่ม CTA หลัก
//   ⚠️⚠️ **ห้ามลากสต็อปขึ้นไปถึง #f23bb4 #bb6dff หรือ #7aa7ff** — ขาวบนสามค่านั้น
//   เหลือ 2.6 / 2.0:1 สามค่านั้นเป็นขอบ/ออรา/พื้นถมเท่านั้น
// เข้าสู่ระบบ = SECONDARY พื้นไล่เฉดขาว #ffffff -> #ece0fb บนหมึก
//   **อินดิโกม่วง #241046** (16.8 / 12.6:1) ขอบ #9a6fd0 คือสิ่งที่แยกปุ่มนี้ออก
//   จากผิวการ์ดขาว — ห้ามถอดขอบออก
// ⚠️⚠️ **#f8e6f9 #f6edfe #ece0fb #dcc6f4 #f23bb4 #bb6dff #7aa7ff ห้ามถือ
//   ตัวอักษรบนผิวสว่างเด็ดขาด** เป็นพื้นถม/ขอบ/ออราเท่านั้น และ #9a6fd0 เป็น
//   **เส้น/ขอบ** เท่านั้น · ที่ถือตัวอักษรได้บนผิวสว่างชุดนี้คือ #241046 (16.8:1) ·
//   #6b4a86 (7.1:1) · #5411c4 (9.3:1) · #7a1bd6 (7.1:1) · #2b3fd9 (7.5:1) ·
//   #c2178b (5.6:1 คู่กับหมึกขาว)
// ⚠️⚠️ **#190b3d #271257 #100626 #5b2f9e #f3e8ff #c0a6e8 เป็นค่าของผิวโครมเข้ม
//   เท่านั้น ห้ามหลุดเข้ามาในไฟล์นี้**
// ⚠️⚠️ **ฮิวนำของรอบนี้คือไวโอเลตนีออนบนผิวสว่าง** — เวิร์ดมาร์กโครเมียมสามมิติ
//   ตู้สล็อต 777 ผิวแก้วม่วง ชิปคาสิโนแมเจนต้า เชอร์รี่ชมพู และเพชรม่วงใน
//   อาร์ตเวิร์กเป็นวัตถุในภาพ ไม่ใช่สี UI · ชุดเมทัลลิกโฮโลแกรมและสีผิวนักแสดง
//   ก็เช่นกัน — พื้นเพจมาจาก bg.json เท่านั้น
// ⚠️ ปุ่มของ Navfoot อยู่บนแถบโครม **ผิวเข้ม** คนละโซนกับปุ่มบนการ์ดสว่างนี้
// **ห้ามลอกคลาสของ Navfoot มาวางบนการ์ด**
// ออราในไฟล์นี้ใช้ rgba(84,17,196,α) · rgba(122,27,214,α) · rgba(194,23,139,α) ·
// rgba(242,59,180,α) · rgba(220,198,244,α) เท่านั้น
//
// ⚠️⚠️ กับดักรอบนี้คือ **ไล่เฉดฟ้า→ม่วง→แมเจนต้าของอาร์ตเวิร์กคร่อมสามตระกูลที่
// เป็นฮิวนำของแบรนด์ก่อนๆ พร้อมกัน** (ฟ้า ชมพู/แมเจนต้า และม่วง เคยเป็นฮิวนำมาแล้ว
// ทั้งสามตระกูล) การเจอม่วง/ชมพู/ฟ้าในไฟล์จึง **ไม่พิสูจน์ว่าเป็นค่าของรอบนี้**
// ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive
// รอบนี้ **ไม่มีแดง/ทอง/เหลือง/ส้ม/ครีม/เทาเงิน และไม่มีเขียวแบรนด์** เลยสักเฉด
//
// Announcement รอบนี้หมุนมาเป็นตัวเลข 2 ของตระกูล ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ตัวเลข 5 จึงหมุนออก · เขียนชื่อไฟล์แบบไม่มีเครื่องหมายคำพูดโดยตั้งใจ เพราะ
// tools/gen-tw-sources.mjs นับ literal ที่มีเครื่องหมายคำพูดว่าเป็นการ import จริง
// คอมเมนต์จึงทำให้ variant เก่าหลุดเข้า Tailwind scan แล้วสีของแบรนด์ก่อนขึ้น
// stylesheet) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว
// ทุกหน้าเรียกแบบ bare จึง **ห้ามส่ง prop message** จากหน้านี้ ไม่งั้นตัววิ่งจะพูด
// คนละเรื่องกับหน้าอื่น
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้ไม่มี UTF-8 locale จึงนับเป็นไบต์ = เกินจริงราว 3 เท่า)
// หน้านี้ยาว 157 ด้วยชื่อแบรนด์ 6 โค้ดพอยต์ของรอบนี้ (รอบก่อนยาว 12 จึงต้องนับใหม่
// ทุกรอบ ห้ามสืบทอดความยาวข้ามแบรนด์) ส่วนที่ไม่ใช่ชื่อแบรนด์ยาว 151 → รับชื่อ
// แบรนด์ได้ 1–9 อักขระ ถ้ารอบหน้าชื่อยาวกว่านั้นต้องตัดข้อความ ไม่ใช่ปล่อยผ่าน
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ทำให้ตัวนับเห็นเป็น 5 อักขระ
// ประโยคนี้บรรยาย "สิ่งที่หน้านี้มี" เท่านั้น — หน้านี้มีแค่ปุ่มสองปุ่ม ไม่มีปุ่ม LINE
// จึงไม่สัญญาช่องทางแชตไว้ใน description
const pageDescription = `ทางเข้า ${BRAND_NAME} เว็บหลัก รวมปุ่มเข้าสู่ระบบและสมัครสมาชิกไว้ในหน้าเดียว สำหรับผู้ที่ต้องการเข้าถึงเกมสล็อต ควรตรวจสอบที่อยู่เว็บไซต์ทางการให้ถูกต้องก่อนใช้งาน`;

const graph = pageGraph(Astro, {
  name: `ทางเข้า ${BRAND_NAME} เว็บหลัก`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title={`ทางเข้า ${BRAND_NAME} เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ทางเข้า ${BRAND_NAME} เว็บหลัก`} as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="group mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 rounded-xl border-2 border-[#9a6fd0] bg-gradient-to-b from-[#ffffff] to-[#ece0fb] px-6 py-4 shadow-[0_8px_24px_rgba(84,17,196,0.18)] transition-all duration-300 hover:scale-105 hover:border-[#5411c4] hover:shadow-[0_14px_36px_rgba(122,27,214,0.32)]">
          <svg class="h-9 w-9 text-[#241046]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#241046]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border-2 border-[#5411c4] bg-gradient-to-b from-[#5411c4] via-[#8e14b8] to-[#c2178b] px-6 py-4 shadow-[0_10px_30px_rgba(84,17,196,0.35)] transition-all duration-300 hover:scale-105 hover:border-[#f23bb4] hover:shadow-[0_15px_40px_rgba(242,59,180,0.4)]">
          <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-white/10 to-transparent"></span>

          <svg class="h-9 w-9 text-white" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-black tracking-wide text-white">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
