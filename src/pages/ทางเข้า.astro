---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
// Heading inventory for this page must stay h1x1, h2x0, h3x0.
//
// This route stays OUT of the navbar menu on purpose while the cta toggle is on
// (/login and /register are menu entries themselves), but it is still routed,
// still indexed and still linked from the footer. Do not add a nav link and do
// not delete the page.
//
// Two button tiers on the PKG44 palette (ทองเมทัลลิก + เงินโครเมียมบนดำ ตามโลโก้ที่
// P G และ 44 เป็นทองส่วน K เป็นเงินโครเมียม): สมัครสมาชิก คือแอ็กชันหลัก จึงได้พื้น
// ไล่ทองเต็มใบ (#ffeeb8 → #fdd32a → #c8920a) ตัวอักษรทองเข้มสุด #15110a เพราะ
// ตัวหนังสือบนพื้นทองสว่างต้องเป็นสีเข้ม ห้ามใช้ขาว ส่วน เข้าสู่ระบบ เป็นแอ็กชันรอง จึง
// เป็นฝั่ง "K" ของโลโก้ — เส้นขอบเงินโครเมียม #c2c8d0 บนผิวการ์ดเกือบดำ #12100a
// ตัวอักษรเนื้อความ #efe6d2 (hover ยกผิวขึ้นเป็น #2a2110 ขอบเงินสว่าง #f2f4f7 และ
// ตัวอักษรเน้น #fff8e1) — ทองคู่โครเมียม ไม่ใช่ทองสองใบ
// เขียวมรกตของ BRAZIL999 รอบก่อน (#22c55e #7cf25c #b6ff9c #0a6b18 #04380c บนพื้น
// #0a1a0c #123a18 #040a05) ถูกแทนครบทุกจุดแล้ว แบรนด์นี้ไม่มีเขียวเลย
//
// Announcement หมุนมาเป็น AnnouncementPremium ทั้งเว็บรอบนี้ — default message
// ของไฟล์นั้นเป็นคอปปี้ของ PKG44 แล้ว และ index ก็เรียกแบบ bare จึงห้ามส่ง prop
// message จากหน้านี้
//
// PKG44 เป็นแบรนด์สล็อต — บรีฟพูดถึงเกมปั่นสล็อตหลายค่ายเท่านั้น ห้ามพูดถึงคาสิโนสด
// บาคาร่า เกมโต๊ะ หรือหวย (คำของแบรนด์ก่อนหน้า ดู brand-spec §5) และห้ามลิงก์ไป
// เราต์ที่ถูกปิดไว้รอบนี้ (/ตรวจหวย และ /แนวทาง)
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 157
const pageDescription = "ทางเข้า PKG44 เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ เพื่อเข้าใช้งานเกมปั่นสล็อตจากหลายค่ายในบัญชีเดียว รองรับมือถือและคอมพิวเตอร์ตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  name: "ทางเข้า PKG44 เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ทางเข้า PKG44 เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า PKG44 เว็บหลัก" as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ PKG44"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#c2c8d0]/70 bg-[#12100a] px-6 py-4 shadow-[0_10px_30px_rgba(8,6,2,0.85)] transition-all duration-300 hover:scale-105 hover:border-[#f2f4f7] hover:bg-[#2a2110] hover:shadow-[0_15px_40px_rgba(194,200,208,0.28)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#c2c8d0]/28 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#efe6d2] transition-colors group-hover:text-[#fff8e1]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#efe6d2] transition-colors group-hover:text-[#fff8e1]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก PKG44"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ffe27a]/70 bg-gradient-to-r from-[#ffeeb8] via-[#fdd32a] to-[#c8920a] px-6 py-4 shadow-[0_10px_30px_rgba(253,211,42,0.40)] transition-all duration-300 hover:scale-105 hover:border-[#c2c8d0] hover:shadow-[0_15px_40px_rgba(194,200,208,0.28)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#f2f4f7]/30 to-transparent"></div>

          <svg class="h-9 w-9 text-[#15110a]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#15110a]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
