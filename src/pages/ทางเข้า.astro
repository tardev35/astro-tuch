---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
//
// BUTTON PAGE ไม่ใช่บทความ — บรีฟ (src/assets/content.txt, 29 บรรทัด) **ไม่มีส่วน
// SUB-PAGES** จึงไม่เคยให้ body กับหน้านี้ ทุกย่อหน้าและทุกหัวข้อย่อยที่เคยอยู่บน
// หน้านี้คือของที่รีแบรนด์รอบก่อนๆ คิดขึ้นเอง แล้วรอบถัดมาก็เขียนทับด้วยความเชื่อว่า
// รอบก่อนมีเหตุผล — ไม่มี ทั้งหน้ามีแค่ชื่อเรื่องจาก ContentBox แล้วต่อด้วยปุ่มสองปุ่ม
// **ห้ามเขียนหัวข้อย่อยหรือย่อหน้าอธิบายใต้ชื่อเรื่อง** — ไม่มีรายการ "ตรวจ N จุด
// ก่อนล็อกอิน" ไม่มีประโยคเตือนเรื่องรหัสผ่าน/OTP ไม่ว่าคอปปี้นั้นจะเขียนดีแค่ไหน
// (ประโยคกำกับเรื่องรหัสผ่าน/OTP ของบรีฟอยู่บน index.astro และ /about-us ซึ่งเป็น
// บทความจริง ไม่ใช่บนหน้าปุ่ม)
//
// h1 บอกว่า "หน้านี้คืออะไร" ("ทางเข้า <แบรนด์> เว็บหลัก") ไม่ใช่บอกว่าบทความบน
// หน้านี้จะเถียงอะไร — ชื่อเรื่องที่โฆษณาเนื้อหาไว้คือบรรทัดที่ล่อให้รีแบรนด์รอบ
// ถัดไปเขียน body กลับมามากที่สุด
//
// cta toggle รอบนี้เปิด: /login และ /register เป็น button page ที่ index ได้
// หน้านี้จึง **ไม่อยู่ในเมนูนาวบาร์โดยตั้งใจ** แต่ยัง route และ index อยู่ และ
// footer ที่ใช้งานอยู่ยังลิงก์มาที่นี่ — ห้ามลบไฟล์นี้ ห้ามย้ายไป
// src/pages-disabled/ และห้ามเติมลิงก์กลับเข้าเมนู
//
// ───────────────────────────────────────────────────────────────────────────
// 🚨 แกนของแบรนด์รอบนี้คือ **เว็บเกมคาสิโน/เดิมพันออนไลน์** (บาคาร่า สล็อต ไฮโล
// รูเล็ต ยิงปลา บอล หวย — .claude/brand-spec-123bet.md §5) คำนิยามตัวเองของ
// แบรนด์ก่อนๆ ห้ามเหลือที่ไหนทั้งสิ้น รายการคำที่ห้ามใช้อยู่ใน brand-spec §5
// ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์
// ของไฟล์นี้เอง
// ⚠️ **บรีฟรอบนี้ไม่มีหมวดฝากถอน/ธนาคาร/วอลเลทเลยสักคำ** — หน้านี้ไม่เอ่ยถึงเลย
// ⚠️ route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ทดลองเล่น · /about-us · /contact-us · /terms · /privacy · /line —
// **สองหน้าหมวดหวย (ชื่อไฟล์อยู่ใน brand-spec §7) อยู่ใน src/pages-disabled/
// ตามเดิม ลิงก์ไปที่นั่น = build แดง**
// แต่หน้านี้มีโควตาเป็นปุ่มสองปุ่ม จึงไม่ลิงก์ไปที่อื่นเพิ่มอยู่แล้ว
// ⚠️ ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 0.3% · 0.8% · 3 ขั้นตอน · 24ชม. — หน้านี้มีโควตา
// เป็นปุ่มสองปุ่ม จึงไม่อ้างตัวเลขใดเลย
//
// พาเลตรอบนี้อยู่ใน .claude/brand-spec-123bet.md §2
// 🚨🚨 **กลับทิศ 180° จากรอบก่อน: รอบนี้เนื้อหาสว่าง โครมเข้มแดงเลือดหมู**
// bg.json = {"mode":"color","color":"#f7e4e9"} = **ชมพูบลัชจาง**
// (รอบก่อนเป็นเขียวป่าจมเกือบดำ ซึ่งอยู่คนละปลายของสเกล — ค่ามาจากไฟล์ ห้ามเดาว่าเท่าเดิม)
// การ์ด ContentBox จึงเป็นผิว #fdf5f6 บนหมึก #36080f (= BRAND_TEXT, 16.3:1)
// **ห้าม "แก้" การ์ดกลับไปเป็นผิวเข้มตามรอบก่อน** — การ์ดเข้มบนหมึกนี้ = ตัวอักษร
// หายไปเลย ไม่ใช่แค่จางลง
//
// ขั้วของปุ่มบนการ์ดผิวสว่าง (ตรงกับคู่ปุ่มที่ล็อกไว้ใน brand-spec §2):
// สมัครสมาชิก = PRIMARY พื้นไล่เฉดแดง #8a1420 -> #a30d1a -> #c21325
//   บนหมึก **ขาว #ffffff** (9.5 / 8.0 / 6.2:1 ผ่าน AA ทุกสต็อป) — ปุ่ม CTA หลัก
//   ⚠️⚠️ **ห้ามลากสต็อปสว่างกว่า #c21325** — ขาวบนค่าที่สว่างกว่านั้นตก AA
// เข้าสู่ระบบ = SECONDARY พื้นไล่เฉด #fdf5f6 -> #f7dfe4 บนหมึก **#a30d1a**
//   ขอบ #d98fa0 คือสิ่งที่แยกปุ่มนี้ออกจากผิวการ์ด — ห้ามถอดขอบออก
// ⚠️⚠️ **f7e4e9 fdf5f6 f7dfe4 eec3cc d98fa0 330710 1c050b 4d0c18 เป็นผิว/เส้น
//   ห้ามถือตัวอักษรเด็ดขาด** · ที่ถือตัวอักษรได้บนผิวสว่างชุดนี้คือ #36080f (16.3:1) ·
//   #6b2b33 (9.7:1) · #a30d1a (7.4:1) · #7a4a0c (7.0:1)
// ⚠️⚠️ **ค่าของรอบก่อน (002908 010d04 031b09 073c1a 0e5424 1e7033 35a043 3ddc4a
//   dfe6e3 e8c86a eef7f0 9dc2a5 — เขียนแบบไม่มี # โดยตั้งใจ) ห้ามหลงเหลือในไฟล์นี้
//   แม้แต่ค่าเดียว**
// ⚠️⚠️ **ฮิวนำของรอบนี้คือแดงชาดบนผิวสว่าง** — เวิร์ดมาร์กสามมิติที่ครึ่งแรกเป็น
//   ตัวเลขผิวแดงชาดตัดขอบทอง ครึ่งหลังเป็นตัวอักษรละตินผิวโครเมียมเงิน มงกุฎเงิน
//   ประดับอัญมณีแดง โถงวังหินอ่อนงาช้าง ชุดราตรีแดง-ขาวปักทอง ชิปคาสิโนแดง-ขาว
//   และไพ่เอซในอาร์ตเวิร์กเป็นวัตถุในภาพ ไม่ใช่สี UI · พื้นเพจมาจาก bg.json เท่านั้น
// ⚠️ ปุ่มของ Navfoot อยู่บนแถบโครมเข้ม คนละโซนกับปุ่มบนการ์ดผิวสว่างนี้
// **ห้ามลอกคลาสของ Navfoot มาวางบนการ์ด**
// ออราในไฟล์นี้ใช้ rgba(163,13,26,α) · rgba(220,165,58,α) · rgba(217,143,160,α) ·
// rgba(54,8,15,α) เท่านั้น
//
// ⚠️⚠️ กับดักรอบนี้กลับทิศจากทุกรอบที่ผ่านมา — **spec ของสามรอบก่อนเขียนไว้ทุกไฟล์
// ว่า "รอบนี้ไม่มีแดงเป็นสี UI เลยสักเฉด" แต่รอบนี้แดงชาดคือฮิวนำของแบรนด์**
// คอมเมนต์เก่าในไฟล์ inventory ที่ห้ามแดงไว้เป็นของรอบก่อน ไม่ใช่ของรอบนี้ →
// ที่ห้ามคือ **ค่าเฮกซ์ของแบรนด์เก่าแบบตรงหกหลัก** ไม่ใช่ "สีแดง" ในฐานะตระกูลสี
// และเพราะรอบนี้เป็นแบรนด์ แดง/ทอง/ขาวชมพู **LOTTO189 จึงใกล้ตัวที่สุด
// (ตระกูลสีเดียวกันเป๊ะ)** รองลงมาคือ MEXICANOSLOT — การเจอแดงในไฟล์จึง
// **ไม่พิสูจน์ว่าเป็นค่าของรอบนี้** ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน
// brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ
// false positive
// รอบนี้ **ไม่มีเขียว/ม่วง/ฟ้า/ไซแอน/แมเจนต้า/ส้มเพลิงเป็นสี UI** เลยสักเฉด
//
// Announcement รอบนี้หมุนมาเป็นตัวท้ายชื่อเลขห้า ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ตัวท้ายชื่อเลขสามจึงหมุนออก · เขียนชื่อไฟล์แบบไม่มีเครื่องหมายคำพูด
// โดยตั้งใจ เพราะ tools/gen-tw-sources.mjs นับ literal ที่มีเครื่องหมายคำพูดว่าเป็น
// การ import จริง คอมเมนต์จึงทำให้ variant เก่าหลุดเข้า Tailwind scan แล้วสีของ
// แบรนด์ก่อนขึ้น stylesheet) orchestrator เป็นเจ้าของ default message ของไฟล์นั้น
// ทุกหน้าเรียกแบบ bare จึง **ห้ามส่ง prop message** จากหน้านี้ ไม่งั้นตัววิ่งจะพูด
// คนละเรื่องกับหน้าอื่น
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้ไม่มี UTF-8 locale จึงนับเป็นไบต์ = เกินจริงราว 3 เท่า)
// หน้านี้ยาว 152 ด้วยชื่อแบรนด์ 6 โค้ดพอยต์ของรอบนี้ (รอบก่อนยาว 7 — ต้องนับใหม่
// ทุกรอบ ห้ามสืบทอดความยาวข้ามแบรนด์) ส่วนที่ไม่ใช่ชื่อแบรนด์ยาว 146 →
// รับชื่อแบรนด์ได้ 4–14 อักขระ ถ้ารอบหน้าชื่อยาวกว่านั้นต้องตัดข้อความ
// ไม่ใช่ปล่อยผ่าน
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ทำให้ตัวนับเห็นเป็น 5 อักขระ
// ประโยคนี้บรรยาย "สิ่งที่หน้านี้มี" เท่านั้น — หน้านี้มีแค่ปุ่มสองปุ่ม ไม่มีปุ่ม LINE
// จึงไม่สัญญาช่องทางแชตไว้ใน description
const pageDescription = `ทางเข้า ${BRAND_NAME} เว็บหลัก รวมปุ่มเข้าสู่ระบบและสมัครสมาชิกไว้ในหน้าเดียว สำหรับผู้ที่ต้องการเข้าใช้งานระบบสมาชิก ควรตรวจสอบที่อยู่เว็บไซต์ทางการก่อนใช้งาน`;

const graph = pageGraph(Astro, {
  name: `ทางเข้า ${BRAND_NAME} เว็บหลัก`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title={`ทางเข้า ${BRAND_NAME} เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ทางเข้า ${BRAND_NAME} เว็บหลัก`} as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="group mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 rounded-xl border-2 border-[#d98fa0] bg-gradient-to-b from-[#fdf5f6] to-[#f7dfe4] px-6 py-4 shadow-[0_8px_24px_rgba(54,8,15,0.12)] transition-all duration-300 hover:scale-105 hover:border-[#a30d1a] hover:shadow-[0_14px_36px_rgba(163,13,26,0.22)]">
          <svg class="h-9 w-9 text-[#a30d1a]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#a30d1a]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border-2 border-[#8a1420] bg-gradient-to-b from-[#8a1420] via-[#a30d1a] to-[#c21325] px-6 py-4 shadow-[0_10px_30px_rgba(163,13,26,0.35)] transition-all duration-300 hover:scale-105 hover:border-[#c21325] hover:shadow-[0_15px_40px_rgba(163,13,26,0.45)]">
          <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-white/10 to-transparent"></span>

          <svg class="h-9 w-9 text-white" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-black tracking-wide text-white">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
