---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
//
// BUTTON PAGE ไม่ใช่บทความ — บรีฟ (src/assets/content.txt, 29 บรรทัด) **ไม่มีส่วน
// SUB-PAGES** จึงไม่เคยให้ body กับหน้านี้ ทุกย่อหน้าและทุกหัวข้อย่อยที่เคยอยู่บน
// หน้านี้คือของที่รีแบรนด์รอบก่อนๆ คิดขึ้นเอง แล้วรอบถัดมาก็เขียนทับด้วยความเชื่อว่า
// รอบก่อนมีเหตุผล — ไม่มี ทั้งหน้ามีแค่ชื่อเรื่องจาก ContentBox แล้วต่อด้วยปุ่มสองปุ่ม
// **ห้ามเขียนหัวข้อย่อยหรือย่อหน้าอธิบายใต้ชื่อเรื่อง** — ไม่มีรายการ "ตรวจ N จุด
// ก่อนล็อกอิน" ไม่มีประโยคเตือนเรื่องรหัสผ่าน/OTP ไม่ว่าคอปปี้นั้นจะเขียนดีแค่ไหน
// (ประโยคกำกับเรื่องรหัสผ่าน/OTP ของบรีฟอยู่บน index.astro และ /about-us ซึ่งเป็น
// บทความจริง ไม่ใช่บนหน้าปุ่ม)
//
// h1 บอกว่า "หน้านี้คืออะไร" ("ทางเข้า <แบรนด์> เว็บหลัก") ไม่ใช่บอกว่าบทความบน
// หน้านี้จะเถียงอะไร — ชื่อเรื่องที่โฆษณาเนื้อหาไว้คือบรรทัดที่ล่อให้รีแบรนด์รอบ
// ถัดไปเขียน body กลับมามากที่สุด
//
// cta toggle รอบนี้เปิด: /login และ /register เป็น button page ที่ index ได้
// หน้านี้จึง **ไม่อยู่ในเมนูนาวบาร์โดยตั้งใจ** แต่ยัง route และ index อยู่ และ
// footer ที่ใช้งานอยู่ยังลิงก์มาที่นี่ — ห้ามลบไฟล์นี้ ห้ามย้ายไป
// src/pages-disabled/ และห้ามเติมลิงก์กลับเข้าเมนู
//
// ───────────────────────────────────────────────────────────────────────────
// 🚨 แกนของแบรนด์รอบนี้คือ **เว็บคาสิโนออนไลน์เน้นบาคาร่า** และบรีฟระบุ
// **สามหมวดเกมเท่านั้น** (บาคาร่า · คาสิโนสด · สล็อต — .claude/brand-spec-win8s.md §5)
// 🚨🚨 **รอบก่อนมีเจ็ดหมวด ห้ามสืบทอดลิสต์ข้ามรอบเด็ดขาด** คำนิยามตัวเองของ
// แบรนด์ก่อนๆ ห้ามเหลือที่ไหนทั้งสิ้น รายการคำที่ห้ามใช้อยู่ใน brand-spec §5
// ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์
// ของไฟล์นี้เอง
// ⚠️ **บรีฟรอบนี้ไม่มีหมวดฝากถอน/ธนาคาร/วอลเลทเลยสักคำ** — หน้านี้ไม่เอ่ยถึงเลย
// ⚠️ route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ทดลองเล่น · /about-us · /contact-us · /terms · /privacy · /line —
// **สองหน้าหมวดหวย (ชื่อไฟล์อยู่ใน brand-spec §7) อยู่ใน src/pages-disabled/
// ตามเดิม ลิงก์ไปที่นั่น = build แดง** (บรีฟรอบนี้ไม่มีคำว่าหวยเลยสักคำ)
// แต่หน้านี้มีโควตาเป็นปุ่มสองปุ่ม จึงไม่ลิงก์ไปที่อื่นเพิ่มอยู่แล้ว
// ⚠️ ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 0.3% · 0.8% · 100% · 3 ขั้นตอน · 24ชม. —
// หน้านี้มีโควตาเป็นปุ่มสองปุ่ม จึงไม่อ้างตัวเลขใดเลย
//
// พาเลตรอบนี้อยู่ใน .claude/brand-spec-win8s.md §2
// 🚨🚨 **กลับทิศ 180° จากรอบก่อน: รอบนี้ "มืดทั้งเว็บ"** ทั้งเนื้อหาและโครม
// bg.json = {"mode":"color","color":"#1e0101"} = **ดำอมเลือดหมูเกือบสนิท**
// (รอบก่อนเป็นชมพูบลัชจาง ซึ่งอยู่คนละปลายของสเกล — ค่ามาจากไฟล์ ห้ามเดาว่าเท่าเดิม)
// การ์ด ContentBox จึงเป็นผิวเข้ม 2a0a04 บนหมึกสว่าง fdf0e6 (= BRAND_TEXT, 16.4:1)
// **ห้าม "แก้" การ์ดกลับไปเป็นผิวสว่างตามรอบก่อน** — ผิวสว่างบนหมึกนี้ = ตัวอักษร
// หายไปเลย ไม่ใช่แค่จางลง
//
// ขั้วของปุ่มบนการ์ดผิวเข้ม (ตรงกับคู่ปุ่มที่ล็อกไว้ใน brand-spec §2):
// สมัครสมาชิก = PRIMARY พื้นไล่เฉดส้ม-ทอง f0a21e -> f27a1a -> e8620e
//   บนหมึก **ดำอมเลือดหมู 1e0101** (9.3 / 7.1 / 5.8:1 ผ่าน AA ทุกสต็อป) — ปุ่ม CTA หลัก
//   🚨🚨 **หมึกขาวบนเฉดนี้ตก 2.8:1 ห้ามใช้ขาวเด็ดขาด** (รอบก่อนปุ่มหลักเป็นแดงเข้ม
//   จึงรองขาวได้ รอบนี้กลับทิศ)
//   ⚠️⚠️ **ห้ามลากปลายเฉดเข้มกว่า e8620e** — ต่ำกว่านั้นหมึกเข้มตกใต้ 4.5:1
// เข้าสู่ระบบ = SECONDARY ผิวชั้นยก 3b130b บนหมึก **f0a21e** (7.8:1)
//   ขอบ 8a3a12 คือสิ่งที่แยกปุ่มนี้ออกจากผิวการ์ด — ห้ามถอดขอบออก
// ⚠️⚠️ **1e0101 2a0a04 3b130b 5a2410 8a3a12 250604 140302 เป็นผิว/เส้น
//   ห้ามถือตัวอักษรเด็ดขาด** · ที่ถือตัวอักษรได้บนผิวเข้มชุดนี้คือ fdf0e6 (16.4:1) ·
//   c9d2dc (12.0:1) · e0bda4 (10.5:1) · e5a92b (8.8:1) · f0a21e · f27a1a (6.6:1)
// ⚠️⚠️ **ค่าของ 123BET รอบก่อน (f7e4e9 fdf5f6 f7dfe4 eec3cc d98fa0 330710 1c050b
//   4d0c18 36080f 6b2b33 a30d1a 8a1420 c21325 dca53a d2d7dd ef4a5e 7a4a0c —
//   เขียนแบบไม่มี # โดยตั้งใจ) ห้ามหลงเหลือในไฟล์นี้แม้แต่ค่าเดียว**
// ⚠️⚠️ **ฮิวนำของรอบนี้คือส้มเพลิง f27a1a คู่ทองอำพัน e5a92b บนผิวดำอมเลือดหมู** —
//   เวิร์ดมาร์กสามมิติที่สี่ตัวแรกเป็นผิวส้มเพลิงไล่ทองตัดขอบดำ ตัวสุดท้ายเป็นผิว
//   โครเมียมเงิน ตราสัญลักษณ์โล่เข้มที่มีมงกุฎทอง เสาโทริอิ และมังกร ห้องญี่ปุ่น
//   โทนขาวงาช้าง กิ่งซากุระชมพู-ขาว กิโมโนแดง-ดำปักทอง ชิปคาสิโนดำ-ทอง และไพ่เอซ
//   ในอาร์ตเวิร์ก **เป็นวัตถุในภาพ ไม่ใช่สี UI** · พื้นเพจมาจาก bg.json เท่านั้น
// ⚠️ ปุ่มของ Navfoot อยู่บนแถบโครม 250604 คนละโซนกับปุ่มบนการ์ด 2a0a04 นี้
// **ห้ามลอกคลาสของ Navfoot มาวางบนการ์ด**
// ออราในไฟล์นี้ใช้ rgba(242,122,26,α) · rgba(229,169,43,α) · rgba(138,58,18,α) ·
// rgba(30,1,1,α) · rgba(20,3,2,α) เท่านั้น
//
// ⚠️⚠️ กับดักรอบนี้: **ZNOVA168 (เจ้าของเดิมของ NavbarStyle9 ที่หมุนเข้ามารอบนี้)
// เป็นแบรนด์ น้ำตาลเข้ม/อำพัน = ตระกูลสีเดียวกับรอบนี้เป๊ะ** รองลงมาคือ
// MEXICANOSLOT (แดง/ทอง/ครีม) และ TEVA69 (ทอง) → **"เจอส้มหรือทองอยู่แล้ว"
// จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้** ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน
// brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ
// false positive
// รอบนี้ **ไม่มีเขียว/ม่วง/ฟ้า/ไซแอน/แมเจนต้า/ชมพูเป็นสี UI** เลยสักเฉด
//
// Announcement รอบนี้หมุนมาเป็นตัวที่ลงท้ายด้วยคำว่าพรีเมียม ทั้งเว็บ
// (brand-spec §3 — รอบก่อนใช้ตัวท้ายชื่อเลขห้าจึงหมุนออก · เขียนชื่อไฟล์แบบ
// ไม่มีเครื่องหมายคำพูดโดยตั้งใจ เพราะ tools/gen-tw-sources.mjs นับ literal
// ที่มีเครื่องหมายคำพูดว่าเป็นการ import จริง คอมเมนต์จึงทำให้ variant เก่าหลุด
// เข้า Tailwind scan แล้วสีของแบรนด์ก่อนขึ้น stylesheet) orchestrator เป็นเจ้าของ
// default message ของไฟล์นั้น ทุกหน้าเรียกแบบ bare จึง **ห้ามส่ง prop message**
// จากหน้านี้ ไม่งั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้ไม่มี UTF-8 locale จึงนับเป็นไบต์ = เกินจริงราว 3 เท่า)
// หน้านี้ยาว 159 ด้วยชื่อแบรนด์ 5 โค้ดพอยต์ของรอบนี้ (รอบก่อนยาว 6 — ต้องนับใหม่
// ทุกรอบ ห้ามสืบทอดความยาวข้ามแบรนด์) ส่วนที่ไม่ใช่ชื่อแบรนด์ยาว 154 →
// รับชื่อแบรนด์ได้แค่ 1–6 อักขระ ถ้ารอบหน้าชื่อยาวกว่านั้นต้องตัดข้อความ
// ไม่ใช่ปล่อยผ่าน
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ทำให้ตัวนับเห็นเป็น 5 อักขระ
// ประโยคนี้บรรยาย "สิ่งที่หน้านี้มี" เท่านั้น — หน้านี้มีแค่ปุ่มสองปุ่ม ไม่มีปุ่ม LINE
// จึงไม่สัญญาช่องทางแชตไว้ใน description
const pageDescription = `ทางเข้า ${BRAND_NAME} เว็บหลัก รวมปุ่มเข้าสู่ระบบและสมัครสมาชิกไว้ในหน้าเดียว สำหรับผู้ที่ต้องการเข้าใช้งานระบบสมาชิก ควรตรวจสอบที่อยู่เว็บไซต์ทางการก่อนใช้งานทุกครั้ง`;

const graph = pageGraph(Astro, {
  name: `ทางเข้า ${BRAND_NAME} เว็บหลัก`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title={`ทางเข้า ${BRAND_NAME} เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ทางเข้า ${BRAND_NAME} เว็บหลัก`} as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="group mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 rounded-xl border-2 border-[#8a3a12] bg-[#3b130b] px-6 py-4 shadow-[0_8px_24px_rgba(20,3,2,0.45)] transition-all duration-300 hover:scale-105 hover:border-[#f27a1a] hover:shadow-[0_14px_36px_rgba(242,122,26,0.22)]">
          <svg class="h-9 w-9 text-[#f0a21e]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#f0a21e]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border-2 border-[#8a3a12] bg-gradient-to-b from-[#f0a21e] via-[#f27a1a] to-[#e8620e] px-6 py-4 shadow-[0_10px_30px_rgba(242,122,26,0.35)] transition-all duration-300 hover:scale-105 hover:border-[#e5a92b] hover:shadow-[0_15px_40px_rgba(242,122,26,0.45)]">
          <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-white/10 to-transparent"></span>

          <svg class="h-9 w-9 text-[#1e0101]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-black tracking-wide text-[#1e0101]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
