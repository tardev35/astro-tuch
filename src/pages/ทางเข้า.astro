---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// Button page, not an article: the brief gives this route no body at all —
// รอบนี้บรีฟ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES เลย จบที่บรรทัด 29
// ทุกย่อหน้าที่เคยอยู่บนหน้านี้ในอดีตจึงเป็นของที่รีแบรนด์รอบก่อนๆ คิดขึ้นเอง
// ทั้งหน้ามีแค่ชื่อเรื่องจาก ContentBox แล้วต่อด้วยปุ่มสองปุ่ม
// ห้ามเขียนหัวข้อย่อยหรือย่อหน้าอธิบายใต้ชื่อเรื่อง — ไม่มีรายการ "ตรวจ N จุดก่อน
// ล็อกอิน" และไม่มีประโยคเตือนเรื่องรหัสผ่าน/OTP ไม่ว่าคอปปี้นั้นจะเขียนดีแค่ไหน
//
// The <h1> names what the page IS ("ทางเข้า <brand> เว็บหลัก"), not what an
// article on it would have argued — a title that previews a body reads as a
// broken promise once the body is gone, and is the line most likely to tempt
// the next rebrand into writing it back.
//
// cta toggle รอบนี้เปิด: /login และ /register เป็น button page ที่ index ได้
// หน้านี้จึงไม่อยู่ในเมนูนาวบาร์ (brand-spec §1) แต่ยัง route และ index อยู่
// และฟุตเตอร์ยังลิงก์มาที่นี่ — ห้ามลบไฟล์นี้ และห้ามย้ายไป src/pages-disabled/
//
// แบรนด์รอบนี้ (มีเฮ168, รอบ **แดงชาดนำ · ทองเนยรอง · บนพื้นดำสนิท**
// 2026-10-19, brand-spec §2): โลโก้คือคำว่า **"มี"** ตัวอักษรไทยหนาสามมิติ
// **สีขาวมุกตัดขอบเทา** ต่อด้วย **"เฮ168" สีแดงชาดบับเบิลผิวมันวาว**
// ทางซ้ายเป็น **หน้ายิ้มหัวเราะสีเหลืองทองแก้มชมพู** นั่งบน **กองเหรียญทอง**
// ล้อมด้วย **ประกายดาวสีทอง** และ **ขีดประกายสีแดง** บนพื้นขาว แบนเนอร์เป็นฉาก
// **พื้นขาว-ชมพูอ่อน** ที่มีหญิงสาวผมบลอนด์เงินชุดลูกไม้ขาวแต่งโบว์แดง ชี้นิ้วมา
// ทางผู้ชม มือถือขึ้นวงล้อสล็อต หัวใจแดง กล่องของขวัญผูกโบว์แดง มงกุฎทอง และ
// เหรียญทองร่วง — **ฮิวนำของรอบนี้คือแดงชาด #fb1b32 ทองเนย #fcd45c เป็นฮิวที่สอง**
// พื้นเพจจาก bg.json รอบนี้เป็น {"mode":"color","color":"#000000"} = ดำสนิท
// ชั้นผิว: ยก #2b0711 (= การ์ด ContentBox) / กลาง #1a040a / จม #0c0205 / พื้น #000000
// แดงลึก #5c0410 · บรอนซ์ลึก #6b4a08 (สองตัวนี้ห้ามถือตัวอักษรทุกขนาด)
// ตัวที่ถือตัวอักษรได้: ทองเนย #fcd45c (12.9:1) · ชมพูบลัช #ff8f9c (8.5:1) ·
// ครีมชมพู #ffe3e6 (14:1) · แดงชาด #fb1b32 (4.7:1 — หัวข้อ/ไอคอน ไม่ใช่เนื้อความยาว) ·
// เนื้อความ #fdeaec (= BRAND_TEXT ที่การ์ด ContentBox ตั้งให้แล้ว) ·
// หมึกบนพื้นถมแดง #1b0308 (5.0:1 บน #fb1b32 · 9.1:1 บน #ff8f9c)
//
// ขั้วของปุ่มตามสเปก (พื้นสว่าง = หมึกเข้ม · พื้นเข้ม = หมึกสว่าง) และตรงกับคู่ปุ่ม
// ของ Navfoot ที่ขึ้นทุกหน้าบนมือถือ:
// สมัครสมาชิก = แอ็กชันหลัก ถม **แดงไล่เฉด** #ff8f9c → #fb1b32 ขอบ #5c0410
// บนหมึกเข้ม #1b0308
// เข้าสู่ระบบ = แอ็กชันรอง จมลงจากการ์ดด้วยชั้น #1a040a → #0c0205
// ขอบ **ทองเนย** #fcd45c/55 บนตัวอักษร **ทองเนย** #fcd45c
// — hover ยกขอบเป็น #fcd45c เต็ม
// ⚠️ ห้ามกลับด้าน: พื้นถมแดงต้องใช้หมึก #1b0308 เสมอ ห้ามขาวหรือครีม ·
// ห้ามใช้ผิวยก #2b0711 เป็นพื้นปุ่ม มันเป็นสีเดียวกับการ์ดที่ปุ่มวางอยู่ ·
// #5c0410 #6b4a08 ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่เส้นขอบ ออรา พื้นถม และเงา —
// ออราในไฟล์นี้ใช้ rgba(251,27,50,α) และ rgba(252,212,92,α) เท่านั้น นอกจากเงาดำล้วน
// ⚠️ กับดักรอบนี้คือ **แดง** และ **ทอง** พร้อมกัน เพราะ **สามแบรนด์ก่อนหน้านี้**
// (สมหวัง168 แดงนำ+ทองรอง · รับตัง168 ทองนำ+แดงสด · ขวัญใจ168 ทองนำ+แดงชาด)
// ก็มีทั้งคู่ การเจอ "แดง" หรือ "ทอง" ในไฟล์นี้จึง
// **ไม่พิสูจน์ว่าเป็นค่าของรอบนี้** แดงรอบนี้คือ #fb1b32 (251,27,50) และ
// ทองรอบนี้คือ #fcd45c (252,212,92) ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน
// brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ
// false positive — ไม่เทียบด้วยตา และไม่เทียบด้วยตระกูลสี (แดงของสมหวัง168 ห่าง
// จากค่ารอบนี้แค่หลักหน่วยของ G กับ B)
// และรอบนี้ **ไม่มีฟ้า/น้ำเงิน ไม่มีม่วง ไม่มีเขียว ไม่มีส้ม ไม่มีเงิน/โครเมียม
// ไม่มีโรสโกลด์ ไม่มีเหลืองมะนาว ไม่มีชมพูฟูเชีย** — ชมพูตัวเดียวที่อนุญาตคือ
// บลัช #ff8f9c ซึ่งเป็นแดงจาง
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ (brand-spec §3 —
// รอบก่อนใช้ Announcement3 จึงหมุนออก) default message ของไฟล์นั้นเป็นคอปปี้
// ของแบรนด์นี้แล้ว และทุกหน้าเรียกแบบ bare จึงห้ามส่ง prop message จากหน้านี้
// ไม่งั้นตัววิ่งจะไม่ตรงกับ index.astro
//
// ⚠️ แบรนด์นี้เป็น **เว็บสล็อตล้วน** ที่บรีฟพูดถึงแค่โปรโมชั่นคืนยอดเสีย 0.3%
// แนะนำเพื่อน 0.8% การสมัครสมาชิก/เข้าสู่ระบบ และช่องทางติดต่อเจ้าหน้าที่ 24ชม.
// — ไม่ใช่คาสิโน ไม่มีกีฬา และไม่ใช่เว็บหวย สองหน้าของหมวดลอตเตอรี park อยู่ใน
// src/pages-disabled/ จึงไม่มี route และลิงก์ค้างจะเป็น href ตายที่ทำให้บิลด์แดง
// คำที่ห้ามหลงเหลือทั้งหมดอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep
// หาคำของแบรนด์เก่าเจอ false positive — รอบก่อนขายตัวเองด้วยวลีที่บรีฟรอบนี้
// ไม่มีเลยสักคำ
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกมแม้แต่ค่ายเดียว** จึงห้ามเขียนชื่อค่ายใดๆ
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 24ชม. ห้ามแต่งชื่อธนาคาร
// เลขใบอนุญาต หน่วยงานกำกับ ค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีใดๆ —
// หน้านี้มีโควตาเป็นปุ่มสองปุ่มเท่านั้น
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้ไม่มี UTF-8 locale จึงนับเป็นไบต์ = เกินจริงราว 3 เท่า)
// หน้านี้ยาว 152 ด้วยชื่อแบรนด์ 7 ตัวอักษรของรอบนี้
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ทำให้ตัวนับเห็นเป็น 5 อักขระ
// ประโยคนี้บรรยาย "สิ่งที่หน้านี้มี" เท่านั้น — หน้านี้มีแค่ปุ่มสองปุ่ม ไม่มีปุ่ม LINE
// จึงไม่สัญญาช่องทางแชตไว้ใน description (ของเดิมสัญญาไว้ ทั้งที่หน้าไม่มีให้)
// ส่วนท้ายมาจากบรีฟบรรทัด 4 ตรงตัว: ควรตรวจสอบกติกาและเงื่อนไขบริการก่อนใช้งาน
const pageDescription = `ทางเข้า ${BRAND_NAME} เว็บหลัก รวมเมนูเข้าสู่ระบบและสมัครสมาชิกไว้ในหน้าเดียว กดเลือกเมนูที่ต้องการได้ทันที โดยควรตรวจสอบกติกาและเงื่อนไขบริการก่อนเริ่มใช้งาน`;

const graph = pageGraph(Astro, {
  name: `ทางเข้า ${BRAND_NAME} เว็บหลัก`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title={`ทางเข้า ${BRAND_NAME} เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ทางเข้า ${BRAND_NAME} เว็บหลัก`} as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fcd45c]/55 bg-gradient-to-b from-[#1a040a] to-[#0c0205] px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.6)] transition-all duration-300 hover:scale-105 hover:border-[#fcd45c] hover:shadow-[0_15px_40px_rgba(252,212,92,0.45)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#fcd45c]/20 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#fcd45c] transition-colors group-hover:text-[#ff8f9c]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#fcd45c]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#5c0410] bg-gradient-to-b from-[#ff8f9c] to-[#fb1b32] px-6 py-4 shadow-[0_10px_30px_rgba(251,27,50,0.4)] transition-all duration-300 hover:scale-105 hover:border-[#1b0308] hover:shadow-[0_15px_40px_rgba(251,27,50,0.6)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ff8f9c]/70 to-transparent"></div>

          <svg class="h-9 w-9 text-[#1b0308]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-black tracking-wide text-[#1b0308]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
