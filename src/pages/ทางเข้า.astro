---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
//
// This route stays OUT of the navbar menu on purpose while the cta toggle is on
// (/login and /register are menu entries themselves), but it is still routed,
// still indexed and still linked from the footer. Do not add a nav link and do
// not delete the page.
//
// Two button tiers, per the LOTTOKA palette: สมัครสมาชิก is the conversion action
// and takes the solid logo-red fill (#e2353a → #c21e22 → #7d1114) with cream
// text (#ffe9ea); เข้าสู่ระบบ is the secondary action and takes the red outline
// on the page-ink surface (#0a0608) with pale-rose text (#ff9a9d). Red leads,
// near-black and cream carry everything else — no gold, no navy.
//
// Announcement รอบนี้หมุนมาใช้ AnnouncementHuay ทั้งเว็บ — default message ของไฟล์นั้น
// เป็นข้อความของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ได้
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 158.
const pageDescription = "ทางเข้า LOTTOKA เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกจากหน้านี้ แทงหวยรัฐบาลไทย ลาวพัฒนา ออมสิน ฮานอย และหวยหุ้น เว็บตรงไม่ผ่านเอเย่นต์ รองรับทั้งมือถือและคอม";

const graph = pageGraph(Astro, {
  name: "ทางเข้า LOTTOKA เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ทางเข้า LOTTOKA เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า LOTTOKA เว็บหลัก" as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ LOTTOKA"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#c21e22]/55 bg-[#0a0608] px-6 py-4 shadow-[0_10px_30px_rgba(194,30,34,0.18)] transition-all duration-300 hover:scale-105 hover:border-[#e2353a] hover:bg-[#1c0d0f] hover:shadow-[0_15px_40px_rgba(194,30,34,0.38)]">
          <div class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#c21e22]/28 to-transparent"></div>

          <svg class="h-9 w-9 text-[#e2353a]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#ff9a9d]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก LOTTOKA"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#7d1114]/70 bg-gradient-to-r from-[#e2353a] via-[#c21e22] to-[#7d1114] px-6 py-4 shadow-[0_10px_30px_rgba(194,30,34,0.30)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(194,30,34,0.48)]">
          <div class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ff9a9d]/45 to-transparent"></div>

          <svg class="h-9 w-9 text-[#ffe9ea]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#ffe9ea]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
