---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
// Heading inventory for this page must stay h1x1, h2x0, h3x0.
//
// The <h1> names what the page IS ("ทางเข้า <brand> เว็บหลัก"), not what an
// article on it would have argued — a title that previews a body reads as a
// broken promise once the body is gone, and is the line most likely to tempt
// the next rebrand into writing it back.
//
// This route stays OUT of the navbar menu on purpose while the cta toggle is on
// (/login and /register are menu entries themselves), but it is still routed,
// still indexed and still linked from the footer. Do not add a nav link and do
// not delete the page.
//
// Two button tiers on the NATO168 palette (brand-spec §2 ทอง + เงิน บนดำ):
// สมัครสมาชิก คือแอ็กชันหลัก จึงได้ไล่เฉดทองเต็มใบ (#fde8a8 → #edb543 → #a9761f)
// ตัวอักษรเป็นหมึกเข้ม #1a1203 — ปลายไล่เฉดห้ามเข้มกว่า #a9761f
// ส่วน เข้าสู่ระบบ เป็นแอ็กชันรอง จึงเป็นแบบ outline **สีเงิน** — กรอบและตัวอักษร
// #e6e6e6 บนผิวอุ่น #17120a (hover ยกพื้นเป็นผิวทอง #241a09 และตัวอักษรเป็น #fde8a8)
// แบรนด์นี้มีสองโทนจริง (คำว่า NATO เป็นเงินเมทัลลิก / 168 กับวงกลมตัว N เป็นทอง)
// ลำดับความสำคัญจึงสื่อด้วย "ถมทอง vs กรอบเงินบนพื้นดำ" ไม่ใช่ถมทองสองใบ
// ซึ่งจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม — และไม่ใช่ทองจางๆ ซึ่งอ่านเป็นปุ่มที่ปิดใช้งาน
// ห้ามตัวอักษรสีอ่อนบนพื้นทอง (ขาวบน #edb543 ได้แค่ ~1.9:1)
// ชุดทองล้วนของ NAZA99 (#e4b34d #fdf2ac #fef1a5 #c08f2b #8a5f12 #140c02 #241404
// #1a1000 #f3e8cf rgba(228,179,77,*) rgba(10,5,1,*)) ถูกแทนครบแล้ว
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ (รอบก่อนเป็น
// AnnouncementPremium) — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ
// NATO168 แล้ว และ index ก็เรียกแบบ bare จึงห้ามส่ง prop message จากหน้านี้
//
// NATO168 เป็นเว็บสล็อตออนไลน์ / พีจีเว็บตรง ไม่ใช่หวยและไม่ใช่บอล — บรีฟรอบนี้พูดถึง
// การรวมสล็อตพีจีและเกมจากค่ายที่เว็บไซต์เปิดรองรับไว้ในบัญชีเดียว เข้าเล่นผ่าน
// เบราว์เซอร์บนมือถือและคอมพิวเตอร์ หมวดโบนัสไทม์ ฟรีสปิน ตัวคูณ และวงล้อ
// คำศัพท์ของแบรนด์ก่อนหน้า (หวย โพย ส่งโพย งวด เลขเด็ด อัตราจ่าย ฮานอย ลาว หุ้น
// บอล ค่าน้ำ ลีก คาสิโนสด บาคาร่า) ห้ามหลงเหลือ และห้ามเพิ่มใบอนุญาต ชื่อธนาคาร
// ยอดฝากขั้นต่ำ ชื่อค่ายเกม ชื่อเกม หรือชื่อผู้ให้บริการจริง ที่บรีฟไม่ได้ระบุ
// รอบนี้สองเราต์ล็อตเตอรี่ของแบรนด์ก่อนถูกพาร์คไว้ใน src/pages-disabled/ แล้ว
// ห้ามสร้างลิงก์ไปสองเส้นทางนั้นที่นี่ (= href ไปหน้าที่ไม่มีอยู่ = build แดง)
// และหน้านี้มีโควตาเป็นปุ่มสองปุ่มเท่านั้นอยู่แล้ว
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 155
const pageDescription = `ทางเข้า ${BRAND_NAME} เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ เพื่อเลือกสล็อตพีจีและเกมจากค่ายที่เว็บไซต์เปิดรองรับ พร้อมตรวจสอบโบนัสไทม์จากบัญชีเดียว`;

const graph = pageGraph(Astro, {
  name: `ทางเข้า ${BRAND_NAME} เว็บหลัก`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title={`ทางเข้า ${BRAND_NAME} เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ทางเข้า ${BRAND_NAME} เว็บหลัก`} as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#e6e6e6]/45 bg-[#17120a] px-6 py-4 shadow-[0_10px_30px_rgba(4,3,0,0.85)] transition-all duration-300 hover:scale-105 hover:border-[#e6e6e6] hover:shadow-[0_15px_40px_rgba(230,230,230,0.30)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#e6e6e6]/22 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#e6e6e6] transition-colors group-hover:text-[#fde8a8]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#e6e6e6] transition-colors group-hover:text-[#fde8a8]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#a9761f] bg-gradient-to-r from-[#fde8a8] via-[#edb543] to-[#a9761f] px-6 py-4 shadow-[0_10px_30px_rgba(237,181,67,0.40)] transition-all duration-300 hover:scale-105 hover:border-[#fde8a8] hover:shadow-[0_15px_40px_rgba(253,232,168,0.35)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#fde8a8]/40 to-transparent"></div>

          <svg class="h-9 w-9 text-[#1a1203]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#1a1203]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
