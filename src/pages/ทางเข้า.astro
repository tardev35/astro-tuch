---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
// Heading inventory for this page must stay h1x1, h2x0, h3x0.
//
// This route stays OUT of the navbar menu on purpose while the cta toggle is on
// (/login and /register are menu entries themselves), but it is still routed,
// still indexed and still linked from the footer. Do not add a nav link and do
// not delete the page.
//
// Two button tiers on the 888PARUAY palette (ทอง + เขียวเข้ม + แดง ตามโลโก้ที่
// เลข "888" เป็นเขียวสดทับคำว่า "PARUAY" สีแดง ในวงแหวนทอง): สมัครสมาชิก คือ
// แอ็กชันหลัก จึงได้พื้นไล่ทองเต็มใบ (#fff6ae → #fcdc2b → #a87d0c) ตัวอักษรเป็น
// หมึกเขียวเกือบดำ #07130a เพื่อให้คอนทราสต์บนทองอ่านออก ส่วน เข้าสู่ระบบ เป็น
// แอ็กชันรอง จึงเป็นเส้นขอบทองแบรนด์ #fcdc2b บนผิวการ์ดเขียว #0d2312 ตัวอักษร
// เนื้อความ #e8e4c6 (hover ยกผิวขึ้นเป็น #143a1c ขอบทองอ่อน #fff6ae และตัวอักษร
// เน้น #fffdf0) — ชุดแดง-ทองของ 365LOTTO รอบก่อน (#fadc64 #ffe9a3 #9c6a12
// #e01f26 #f0ddc4 #1a0709 #33100f #120406 #f3f6fa) ถูกแทนครบทุกจุดแล้ว
//
// Announcement รอบนี้หมุนจาก AnnouncementHuay มาเป็น Announcement3 ทั้งเว็บ
// (ยกเว้นสองหน้าหวยที่คงธีม Huay ไว้) — default message ของ Announcement3 เป็น
// คอปปี้ของ 888PARUAY แล้ว และ index ก็เรียกแบบ bare จึงห้ามส่ง prop
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 159
const pageDescription = "ทางเข้า 888PARUAY เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ทันที เพื่อเข้าแทงหวยรัฐบาลไทย ฮานอย ลาวพัฒนา และหุ้นต่างประเทศ ได้ 24 ชั่วโมงจากบัญชีเดียว";

const graph = pageGraph(Astro, {
  name: "ทางเข้า 888PARUAY เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ทางเข้า 888PARUAY เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า 888PARUAY เว็บหลัก" as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ 888PARUAY"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fcdc2b]/70 bg-[#0d2312] px-6 py-4 shadow-[0_10px_30px_rgba(7,19,10,0.75)] transition-all duration-300 hover:scale-105 hover:border-[#fff6ae] hover:bg-[#143a1c] hover:shadow-[0_15px_40px_rgba(252,220,43,0.45)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#fcdc2b]/30 to-transparent"></div>

          <svg class="h-9 w-9 text-[#e8e4c6] transition-colors group-hover:text-[#fffdf0]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#e8e4c6] transition-colors group-hover:text-[#fffdf0]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก 888PARUAY"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fff6ae]/70 bg-gradient-to-r from-[#fff6ae] via-[#fcdc2b] to-[#a87d0c] px-6 py-4 shadow-[0_10px_30px_rgba(252,220,43,0.40)] transition-all duration-300 hover:scale-105 hover:border-[#1fae1c] hover:shadow-[0_15px_40px_rgba(31,174,28,0.45)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#fffdf0]/35 to-transparent"></div>

          <svg class="h-9 w-9 text-[#07130a]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#07130a]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
