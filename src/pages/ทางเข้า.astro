---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
// Every paragraph that has ever been on this page was invented by an earlier
// rebrand, not by the brief: the docx SUB-PAGES section gives this route a
// Title and a Meta and never a body. Heading inventory must stay h1x1 h2x0 h3x0.
//
// The <h1> names what the page IS ("ทางเข้า <brand> เว็บหลัก"), not what an
// article on it would have argued — a title that previews a body reads as a
// broken promise once the body is gone, and is the line most likely to tempt
// the next rebrand into writing it back.
//
// cta toggle รอบนี้เปิด: /login และ /register เป็น button page ที่ index ได้
// หน้านี้จึงถูกถอดออกจากเมนูนาวบาร์ตามกติกา (เพราะเป็นลิงก์ที่สามไปที่เดียวกัน)
// แต่ยัง route และ index อยู่ และฟุตเตอร์ยังลิงก์มาที่นี่ — ห้ามลบไฟล์นี้ และห้ามย้าย
// ไป src/pages-disabled/
//
// UFA324 (รอบทองแชมเปี้ยน-เงินโครเมียม 2026-10-11, brand-spec §2):
// โลโก้เป็นเหรียญตรากลม กลางเหรียญเป็นลูกฟุตบอลทองวางบนถ้วยรางวัลทองหูจับโค้งสองข้าง
// ใต้ลงมาเป็นตัวอักษร UFA สีทองวาว ต่อด้วย 324 สีเงินโครเมียม ล้อมด้วยวงแหวนทองบาง
// แบนเนอร์กับสไลด์เป็นฉากสนามกีฬากลางคืนไฟสปอตไลต์ทอง ชาย-หญิงชุดกีฬาดำ-ทอง
// พื้นเพจจาก bg.json รอบนี้เป็น {"mode":"color","color":"#000000"}
// = **ดำสนิท** ไม่ใช่ม่วงพลัมแบบรอบก่อน จึง **ไม่มีชั้นที่ลึกกว่าพื้นเพจได้เลย**
// ทุกผิวต้องสว่างขึ้นจาก #000000 เท่านั้น
// ทองแบรนด์ #e5a81b (ฮิวหลัก) · ทองสว่าง #ffe08a · ทองกลางเข้ม #bb8410 ·
// ทองลึก #7d5a07 (เส้น/ขอบเท่านั้น) · เงินแบรนด์ #b9c2cc (ฮิวที่สอง) ·
// เงินสว่าง #f2f5f9 · เนื้อความ #f0e8d4 (= BRAND_TEXT ที่การ์ด ContentBox ตั้งให้แล้ว) ·
// ไฮไลต์เนื้อความ #ffcf5e · หมึกเข้ม #140d01 ใช้ได้เฉพาะบนพื้นถมทอง
// ชั้นผิว: สูงสุด #312713 / ยก #231c0e (= การ์ด) / กลาง #17130a / จม #0d0b06 /
// พื้นเพจ #000000
//
// ขั้วของปุ่มตามสเปก (พื้นสว่าง = หมึกเข้ม · พื้นเข้ม = หมึกสว่าง):
// สมัครสมาชิก = แอ็กชันหลัก ถม **ทองไล่เฉด** #ffe08a → #e5a81b → #bb8410
// ขอบ #7d5a07 บนหมึกเข้ม #140d01 (ปลายเข้มสุด #bb8410 ได้ 6.3:1)
// เข้าสู่ระบบ = แอ็กชันรอง จมลงจากการ์ดด้วยชั้น #17130a → #0d0b06
// ขอบเงิน #b9c2cc/55 บนเนื้อความ #f0e8d4 — hover ยกขอบเป็นเงินเต็ม
// ⚠️ ห้ามกลับด้าน และห้ามไล่เฉดทองลงไปถึง #7d5a07 ใต้ตัวอักษร เพราะหมึก #140d01
// บน #7d5a07 ได้แค่ 3.3:1 ปลายเข้มของไล่เฉดจึงหยุดที่ #bb8410 ·
// #7d5a07 #43300a #464f5a ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่เส้นขอบ ออรา และเงา
// ออราด้านบนของปุ่มใช้ปลายสว่างของฮิวตัวเอง rgba(229,168,27,α) และ
// rgba(185,194,204,α) ไม่มี rgba อื่นในไฟล์นี้นอกจากเงาดำล้วน
// ⚠️ เจ็ดในสิบแบรนด์หลังสุดมีทอง เจอทองที่ไหนห้ามเหมาว่าเป็นของรอบนี้ ให้เทียบเป็น
// "ค่า" ทีละตัวกับตารางแบนใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep
// หาสีของแบรนด์เก่าเจอ false positive — ชุดชมพูบานเย็น-ทองของรอบก่อนออกครบทุกจุด
// ในไฟล์นี้แล้ว และรอบนี้ไม่มีชมพูเป็นฮิวเลย
//
// Announcement หมุนมาเป็น Announcement2 ทั้งเว็บรอบนี้ (รอบก่อนใช้ Announcement4 —
// brand-spec §3 หมุนออก) — default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์ปัจจุบันแล้ว
// และทุกหน้าเรียกแบบ bare จึงห้ามส่ง prop message จากหน้านี้ ไม่งั้นตัววิ่งจะไม่ตรงกับ
// index.astro
//
// แบรนด์นี้เป็น **เว็บเล่นเกมกีฬาออนไลน์** — ฟุตบอล มวย และเกมคาสิโน (เกมไพ่ เกมโต๊ะ
// สล็อต) ไม่ใช่เว็บสล็อตล้วนแบบแบรนด์ก่อน และไม่ใช่เว็บของหมวดลอตเตอรี
// สองหน้าของหมวดนั้นยัง park อยู่ใน src/pages-disabled/ จึงไม่มี route และลิงก์
// ค้างจะกลายเป็น href ตายที่ทำให้บิลด์แดง รายการคำต้องห้ามเต็มอยู่ใน brand-spec §7
// ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำของแบรนด์เก่าเจอ false positive
// ⚠️ ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 0.3% / 0.8% / 24 ชั่วโมง
// ห้ามแต่งชื่อค่ายเกม ชื่อธนาคาร เลขใบอนุญาต หน่วยงานกำกับ ค่า RTP ยอดฝากขั้นต่ำ
// จำนวนสมาชิก ชื่อลีก/ทีม/นักมวย หรือปีก่อตั้ง — หน้านี้มีโควตาเป็นปุ่มสองปุ่มเท่านั้น
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้ไม่มี UTF-8 locale จึงนับเป็นไบต์ = เกินจริงราว 3 เท่า)
// หน้านี้ยาว 156
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ทำให้ตัวนับเห็นเป็น 5 อักขระ
const pageDescription = `ทางเข้า ${BRAND_NAME} เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ เว็บเล่นเกมกีฬาออนไลน์ รวมเดิมพันฟุตบอล มวย และเกมคาสิโนไว้ในระบบเดียว เปิดตลอด 24 ชั่วโมง`;

const graph = pageGraph(Astro, {
  name: `ทางเข้า ${BRAND_NAME} เว็บหลัก`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title={`ทางเข้า ${BRAND_NAME} เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ทางเข้า ${BRAND_NAME} เว็บหลัก`} as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#b9c2cc]/55 bg-gradient-to-b from-[#17130a] to-[#0d0b06] px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.6)] transition-all duration-300 hover:scale-105 hover:border-[#b9c2cc] hover:shadow-[0_15px_40px_rgba(185,194,204,0.35)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#b9c2cc]/25 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#f0e8d4] transition-colors group-hover:text-[#f2f5f9]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#f0e8d4]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#7d5a07] bg-gradient-to-b from-[#ffe08a] via-[#e5a81b] to-[#bb8410] px-6 py-4 shadow-[0_10px_30px_rgba(229,168,27,0.4)] transition-all duration-300 hover:scale-105 hover:border-[#140d01] hover:shadow-[0_15px_40px_rgba(229,168,27,0.6)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ffe08a]/60 to-transparent"></div>

          <svg class="h-9 w-9 text-[#140d01]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-black tracking-wide text-[#140d01]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
