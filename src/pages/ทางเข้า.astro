---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
//
// This route stays OUT of the navbar menu on purpose while the cta toggle is on
// (/login and /register are menu entries themselves), but it is still routed,
// still indexed and still linked from the footer. Do not add a nav link and do
// not delete the page.
//
// Two button tiers on the HENG38 palette (ทองบนมรกตเกือบดำ ตามอาร์ตเวิร์กมงกุฎทอง):
// สมัครสมาชิก คือแอ็กชันหลัก จึงได้พื้นไล่ทองเต็มใบ (#fbeeb0 → #f3cf63 →
// #a5761a) ตัวอักษรเป็นเขียวเกือบดำ #03140a ส่วน เข้าสู่ระบบ เป็นแอ็กชันรอง จึงเป็น
// เส้นขอบทอง #f3cf63 บนผิวมรกต #061f0f ตัวอักษรทองหลัก (hover ยกผิวขึ้นเป็น
// #0a2d16 ซึ่งเป็นมรกตเฉดเดียวกันที่สว่างกว่า) ไม่มีโทนกรมท่า-ทองของรอบก่อนเหลืออยู่
//
// Announcement รอบนี้หมุนมาใช้ AnnouncementPremium ทั้งเว็บ — default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้อยู่แล้วและ index ก็เรียกแบบ bare จึงห้ามส่ง prop
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 159
const pageDescription = "ทางเข้า HENG38 เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ทันที เพื่อเข้าเล่นเกมสล็อตแท้จากค่ายดังผ่านระบบ API ตรงจากบริษัทแม่ ใช้งานได้ทั้งมือถือและคอม";

const graph = pageGraph(Astro, {
  name: "ทางเข้า HENG38 เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ทางเข้า HENG38 เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า HENG38 เว็บหลัก" as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ HENG38"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f3cf63]/55 bg-[#061f0f] px-6 py-4 shadow-[0_10px_30px_rgba(3,20,10,0.7)] transition-all duration-300 hover:scale-105 hover:border-[#fbeeb0] hover:bg-[#0a2d16] hover:shadow-[0_15px_40px_rgba(243,207,99,0.38)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#f3cf63]/25 to-transparent"></div>

          <svg class="h-9 w-9 text-[#f3cf63]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#f3cf63]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก HENG38"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fbeeb0]/60 bg-gradient-to-r from-[#fbeeb0] via-[#f3cf63] to-[#a5761a] px-6 py-4 shadow-[0_10px_30px_rgba(243,207,99,0.38)] transition-all duration-300 hover:scale-105 hover:border-[#fbeeb0] hover:shadow-[0_15px_40px_rgba(251,238,176,0.42)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#fbeeb0]/35 to-transparent"></div>

          <svg class="h-9 w-9 text-[#03140a]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#03140a]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
