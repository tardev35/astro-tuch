---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// Button page, not an article: the brief gives this route no body at all —
// รอบนี้บรีฟ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES เลย จบที่บรรทัด 29
// ทุกย่อหน้าที่เคยอยู่บนหน้านี้ในอดีตจึงเป็นของที่รีแบรนด์รอบก่อนๆ คิดขึ้นเอง
// ทั้งหน้ามีแค่ชื่อเรื่องจาก ContentBox แล้วต่อด้วยปุ่มสองปุ่ม
// ห้ามเขียนหัวข้อย่อยหรือย่อหน้าอธิบายใต้ชื่อเรื่อง — ไม่มีรายการ "ตรวจ N จุดก่อน
// ล็อกอิน" และไม่มีประโยคเตือนเรื่องรหัสผ่าน/OTP ไม่ว่าคอปปี้นั้นจะเขียนดีแค่ไหน
//
// The <h1> names what the page IS ("ทางเข้า <brand> เว็บหลัก"), not what an
// article on it would have argued — a title that previews a body reads as a
// broken promise once the body is gone, and is the line most likely to tempt
// the next rebrand into writing it back.
//
// cta toggle รอบนี้เปิด: /login และ /register เป็น button page ที่ index ได้
// หน้านี้จึงไม่อยู่ในเมนูนาวบาร์ (brand-spec §7) แต่ยัง route และ index อยู่
// และฟุตเตอร์ยังลิงก์มาที่นี่ — ห้ามลบไฟล์นี้ และห้ามย้ายไป src/pages-disabled/
//
// แบรนด์รอบนี้ (สบายเบท168, รอบ **ฟ้าบับเบิลนำ ทองเป็นฮิวที่สอง น้ำเงินลึก
// ไม่เคยถือตัวอักษร บนดำสนิท** 2026-10-19, brand-spec §2): โลโก้คือ **แมวการ์ตูน
// ขนขาวลายส้ม** หน้ายิ้มหลับตา ยกอุ้งเท้าขึ้น สวมปลอกคอฟ้ามีกระดิ่งทอง นั่งคู่กับ
// **มือถือจอฟ้าที่มีลูกศรดาวน์โหลด** และ **ปึกแบงก์สีฟ้า** อยู่เหนือคำว่า "สบาย"
// ตัวอักษรไทยหนาสามมิติ **สีทอง** ต่อด้วย "เบท168" **สีฟ้าบับเบิลผิวมันวาว**
// ล้อมด้วยหัวใจสีฟ้าและเหรียญบิตคอยน์ทอง แบนเนอร์เป็นฉากพื้นดำที่มีหญิงสาวผมบลอนด์
// เงินผูกโบว์ซาตินฟ้า ขยิบตาเป่าจูบ ข้างมือถือจอขาวที่ขึ้นเครื่องหมายถูกในวงกลมฟ้า
// พร้อมคำว่า ถอนสำเร็จ —
// **ฮิวนำของรอบนี้คือฟ้าบับเบิล #2f9ff5 ทอง #ffc82e เป็นฮิวที่สอง**
// พื้นเพจจาก bg.json รอบนี้เป็น {"mode":"color","color":"#000000"} = ดำสนิท
// ชั้นผิว: ยก #0e2238 (= การ์ด ContentBox) / กลาง #081726 / จม #040d16 / พื้น #000000
// น้ำเงินลึก #0b3f78 · ทองลึก #5c4a16 (สองตัวนี้ห้ามถือตัวอักษรทุกขนาด)
// ตัวที่ถือตัวอักษรได้: ฟ้าอ่อน #a8dcff (11.6:1) · ทอง #ffc82e (11.3:1) ·
// ฟ้าแบรนด์ #2f9ff5 (5.9:1) ·
// เนื้อความ #e8f4ff (= BRAND_TEXT ที่การ์ด ContentBox ตั้งให้แล้ว) ·
// หมึกบนพื้นถมฟ้า #04121f (6.9:1 บน #2f9ff5 · 13.1:1 บน #ffc82e)
//
// ขั้วของปุ่มตามสเปก (พื้นสว่าง = หมึกเข้ม · พื้นเข้ม = หมึกสว่าง):
// สมัครสมาชิก = แอ็กชันหลัก ถม **ฟ้าไล่เฉด** #a8dcff → #2f9ff5 ขอบ #0b3f78
// บนหมึกเข้ม #04121f
// เข้าสู่ระบบ = แอ็กชันรอง จมลงจากการ์ดด้วยชั้น #081726 → #040d16
// ขอบ **ทอง** #ffc82e/55 บนตัวอักษร **ทอง** #ffc82e — hover ยกขอบเป็น #ffc82e เต็ม
// รอบก่อนปุ่มหลักถมชมพู รอบนี้ฟ้าขึ้นนำตามอาร์ตเวิร์ก ซึ่งคือสิ่งที่แยกรอบนี้ออก
// จากห้ารอบก่อนที่วนอยู่ใน ชมพู/แดง/ทอง ทั้งหมด
// ⚠️ ห้ามกลับด้าน: พื้นถมฟ้าต้องใช้หมึก #04121f เสมอ ห้ามขาวหรือครีม ·
// #0b3f78 #5c4a16 ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่เส้นขอบ ออรา พื้นถม และเงา —
// ออราในไฟล์นี้ใช้ rgba(47,159,245,α) และ rgba(255,200,46,α) เท่านั้น นอกจากเงาดำล้วน
// ⚠️ กับดักรอบนี้มีสองชั้นคือ **ทอง** (แทบทุกแบรนด์ที่ผ่านรีโปนี้มีทอง) และ **ฟ้า**
// (TSDET911 เคยเป็นปีกเหยี่ยวน้ำเงิน · เงินอมฟ้าของรับตัง168 ก็ใกล้ฟ้าอ่อนมาก)
// "มีทอง/มีฟ้าอยู่แล้ว" จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้ ฟ้ารอบนี้คือ #2f9ff5
// (47,159,245) ทองรอบนี้คือ #ffc82e (255,200,46) ให้เทียบเป็น "ค่า" ทีละหลักกับ
// ตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่า
// เจอ false positive — ไม่เทียบด้วยตา และไม่เทียบด้วยตระกูลสี
// และรอบนี้ **ไม่มีชมพู ไม่มีแดง ไม่มีม่วง ไม่มีเขียว ไม่มีส้ม ไม่มีเงิน/โครเมียม
// ไม่มีโรสโกลด์**
//
// Announcement หมุนมาเป็น Announcement2 ทั้งเว็บรอบนี้ (brand-spec §3 —
// รอบก่อนใช้ Announcement6 จึงหมุนออก) default message ของไฟล์นั้นเป็นคอปปี้
// ของแบรนด์นี้แล้ว และทุกหน้าเรียกแบบ bare จึงห้ามส่ง prop message จากหน้านี้
// ไม่งั้นตัววิ่งจะไม่ตรงกับ index.astro
//
// ⚠️ แบรนด์นี้เป็น **เว็บสล็อตล้วน** ที่มีแกนเรื่อง **การเป็นช่องทาง/ฐานเกมหลัก
// ที่รวมทุกเมนูไว้ที่เดียว** ตามบรีฟรอบนี้ — ไม่ใช่คาสิโน ไม่มีกีฬา และไม่ใช่
// เว็บหวย สองหน้าของหมวดลอตเตอรี park อยู่ใน src/pages-disabled/ จึงไม่มี route
// และลิงก์ค้างจะเป็น href ตายที่ทำให้บิลด์แดง คำที่ห้ามหลงเหลือทั้งหมดอยู่ใน
// brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำของแบรนด์เก่าเจอ false
// positive — รอบก่อนขายตัวเองด้วยวลีที่บรีฟรอบนี้ไม่มีเลยสักคำ
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกมแม้แต่ค่ายเดียว** จึงห้ามเขียนชื่อค่ายใดๆ
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 100% · 3 ขั้นตอน · 24ชม. ·
// อันดับ1 ห้ามแต่งชื่อธนาคาร เลขใบอนุญาต หน่วยงานกำกับ ค่า RTP ยอดฝากขั้นต่ำ
// จำนวนสมาชิก หรือปีใดๆ — หน้านี้มีโควตาเป็นปุ่มสองปุ่มเท่านั้น
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้ไม่มี UTF-8 locale จึงนับเป็นไบต์ = เกินจริงราว 3 เท่า)
// หน้านี้ยาว 157
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ทำให้ตัวนับเห็นเป็น 5 อักขระ
const pageDescription = `ทางเข้า ${BRAND_NAME} เว็บหลัก รวมเมนูเข้าสู่ระบบและสมัครสมาชิกของเว็บสล็อตทางการ ผู้ให้บริการฐานเกมหลัก ไว้ในหน้าเดียว กดเลือกเมนูที่ต้องการได้ทันที ตลอด 24ชม.`;

const graph = pageGraph(Astro, {
  name: `ทางเข้า ${BRAND_NAME} เว็บหลัก`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title={`ทางเข้า ${BRAND_NAME} เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ทางเข้า ${BRAND_NAME} เว็บหลัก`} as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ffc82e]/55 bg-gradient-to-b from-[#081726] to-[#040d16] px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.6)] transition-all duration-300 hover:scale-105 hover:border-[#ffc82e] hover:shadow-[0_15px_40px_rgba(255,200,46,0.45)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ffc82e]/20 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#ffc82e] transition-colors group-hover:text-[#a8dcff]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#ffc82e]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#0b3f78] bg-gradient-to-b from-[#a8dcff] to-[#2f9ff5] px-6 py-4 shadow-[0_10px_30px_rgba(47,159,245,0.4)] transition-all duration-300 hover:scale-105 hover:border-[#04121f] hover:shadow-[0_15px_40px_rgba(47,159,245,0.6)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#a8dcff]/70 to-transparent"></div>

          <svg class="h-9 w-9 text-[#04121f]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-black tracking-wide text-[#04121f]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
