---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
//
// Two button tiers, per the OCZPLUS palette: สมัครสมาชิก is the conversion
// action and takes the metallic-gold fill (#f2dc9a → #d9b45e → #8a6b2c) with
// deep-navy text (#03101f); เข้าสู่ระบบ is the secondary action and takes the
// gold outline on the navy surface (#03101f). Gold = the brand; the logo's red
// (#c0202b) stays off this page — two red-vs-gold buttons would read as a
// warning next to a CTA.
//
// Announcement รอบนี้หมุนมาใช้ Announcement3 ทั้งเว็บ — default message ของไฟล์นั้น
// เป็นข้อความของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ได้
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 154.
const pageDescription =
  "ทางเข้า OCZPLUS เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ เข้าเล่นสล็อตผ่านช่องทางหลักอย่างเป็นทางการ รองรับทั้งมือถือ iOS Android และคอมพิวเตอร์";

const graph = pageGraph(Astro, {
  name: "ทางเข้า OCZPLUS เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ทางเข้า OCZPLUS เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า OCZPLUS เว็บหลัก" as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ OCZPLUS"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#d9b45e]/55 bg-[#03101f] px-6 py-4 shadow-[0_10px_30px_rgba(217,180,94,0.18)] transition-all duration-300 hover:scale-105 hover:border-[#f2dc9a] hover:bg-[#0b2547] hover:shadow-[0_15px_40px_rgba(217,180,94,0.38)]">
          <div class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#d9b45e]/28 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#d9b45e]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#e4c67f]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก OCZPLUS"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#8a6b2c]/70 bg-gradient-to-r from-[#f2dc9a] via-[#d9b45e] to-[#8a6b2c] px-6 py-4 shadow-[0_10px_30px_rgba(217,180,94,0.30)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(217,180,94,0.48)]">
          <div class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#f2dc9a]/45 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#03101f]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#03101f]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
