---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
//
// BUTTON PAGE ไม่ใช่บทความ — บรีฟรอบนี้ (src/assets/content.txt) จบที่บรรทัด 31
// และ **ไม่มีส่วน SUB-PAGES เลย** จึงไม่เคยให้ body กับหน้านี้ ทุกย่อหน้าและทุก
// หัวข้อย่อยที่เคยอยู่บนหน้านี้คือของที่รีแบรนด์รอบก่อนๆ คิดขึ้นเอง แล้วรอบถัดมา
// ก็เขียนทับด้วยความเชื่อว่ารอบก่อนมีเหตุผล — ไม่มี
// ทั้งหน้ามีแค่ชื่อเรื่องจาก ContentBox แล้วต่อด้วยปุ่มสองปุ่ม
// **ห้ามเขียนหัวข้อย่อยหรือย่อหน้าอธิบายใต้ชื่อเรื่อง** — ไม่มีรายการ "ตรวจ N จุด
// ก่อนล็อกอิน" ไม่มีประโยคเตือนเรื่องรหัสผ่าน/OTP ไม่ว่าคอปปี้นั้นจะเขียนดีแค่ไหน
// (ประโยคกำกับเรื่องรหัสผ่าน/OTP ของบรีฟอยู่บน index.astro ซึ่งเป็นบทความจริง
// ไม่ใช่บนหน้าปุ่ม)
//
// h1 บอกว่า "หน้านี้คืออะไร" ("ทางเข้า <แบรนด์> เว็บหลัก") ไม่ใช่บอกว่าบทความบน
// หน้านี้จะเถียงอะไร — ชื่อเรื่องที่โฆษณาเนื้อหาไว้คือบรรทัดที่ล่อให้รีแบรนด์รอบ
// ถัดไปเขียน body กลับมามากที่สุด
//
// cta toggle รอบนี้เปิด: /login และ /register เป็น button page ที่ index ได้
// หน้านี้จึง **ไม่อยู่ในเมนูนาวบาร์โดยตั้งใจ** แต่ยัง route และ index อยู่ และ
// footer ที่ใช้งานอยู่ยังลิงก์มาที่นี่ — ห้ามลบไฟล์นี้ ห้ามย้ายไป
// src/pages-disabled/ และห้ามเติมลิงก์กลับเข้าเมนู
//
// ───────────────────────────────────────────────────────────────────────────
// แกนของแบรนด์รอบนี้คือ **เว็บสล็อตเงินดี ทางเข้าเล่นง่าย ยูสใหม่แตกไว**
// (.claude/brand-spec-okkub88.md §1) คำนิยามตัวเองของแบรนด์ก่อนๆ ห้ามเหลือที่ไหน
// ทั้งสิ้น รายการคำที่ห้ามใช้อยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้
// sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// 🚨 คำที่พลาดง่ายที่สุดรอบนี้คือช่องทางวอลเล็ต — บรีฟเขียน **ทรูวอลเลท** เท่านั้น
// (content.txt บรรทัด 21-22 และ 30-31) ไม่ใช่คำของรอบก่อน — หน้านี้ไม่เอ่ยถึงเลย
// ⚠️ **สองหน้าหมวดลอตเตอรีถูกปิดรอบนี้** (อยู่ใน src/pages-disabled/)
// route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ทดลองเล่น · /about-us · /contact-us · /terms · /privacy · /line
// **ลิงก์ไป route ที่ไม่มีจริง = build แดง** แต่หน้านี้มีโควตาเป็นปุ่มสองปุ่ม
// จึงไม่ลิงก์ไปที่อื่นเพิ่มอยู่แล้ว
// ⚠️ ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 0.3% · 0.8% · 3 ขั้นตอน · 24ชม. — หน้านี้มี
// โควตาเป็นปุ่มสองปุ่ม จึงไม่อ้างตัวเลขใดเลย
//
// พาเลตรอบนี้อยู่ใน .claude/brand-spec-okkub88.md §2
// 🚨 **รอบนี้ยังเป็นธีมสว่างเหมือนรอบก่อน แต่คนละฮิวสิ้นเชิง**
// bg.json = {"mode":"color","color":"#ffd6fa"} = **ชมพูบับเบิลกัมพาสเทล**
// (รอบก่อนเป็นฟ้าสกายอิ่มตัว — ค่ามาจากไฟล์ ห้ามเดาว่าเท่าเดิม)
// การ์ด ContentBox จึงเป็นผิว #ffffff บนหมึก #6a0f3c (= BRAND_TEXT)
// **ห้าม "แก้" การ์ดกลับไปเป็นผิวมืด** — การ์ดมืดบนหมึกนี้ = ตัวอักษรหายไปเลย
//
// ขั้วของปุ่มบนการ์ดผิวขาว (ตรงกับคู่ปุ่มที่ล็อกไว้ใน brand-spec §2):
// สมัครสมาชิก = PRIMARY พื้นไล่เฉดชมพูเข้ม #d91a73 -> #b01160 -> #85094a บนหมึก
//   **ขาว #ffffff** (4.8 / 6.8 / 9.8:1 ผ่านทุกสต็อป) — ปุ่ม CTA หลัก
//   ⚠️⚠️ **ห้ามใช้ #fb439b หรือ #ffd6fa เป็น stop ของปุ่มที่ถือหมึกขาว**
//   (ขาวบน #fb439b ได้แค่ 3.3:1 บน #ffd6fa ได้ 1.2:1)
// เข้าสู่ระบบ = SECONDARY พื้นไล่เฉดขาว #ffffff -> #ffe3f5 บนหมึก
//   **เบอร์รีเข้ม #6a0f3c** (12.1 / 11.0:1) ขอบ #f479b9 คือสิ่งที่แยกปุ่มนี้ออก
//   จากผิวการ์ดขาว — ห้ามถอดขอบออก
// ⚠️⚠️ **#fb439b #ffd6fa #fc74b5 #ffc2e2 #f9b2d9 #f479b9 ห้ามถือตัวอักษรบนผิว
//   สว่างเด็ดขาด** เป็นพื้นถม/ขอบ/ออราเท่านั้น · ที่ถือตัวอักษรได้บนผิวสว่างชุดนี้
//   คือ #6a0f3c (12.1:1) · #95486b (6.2:1) · #9c0f55 (8.1:1) · #d91a73 (4.8:1)
// ⚠️⚠️ **ฮิวนำของรอบนี้คือชมพูบับเบิลกัมบนพื้นสว่าง ไม่ใช่ฟ้าสกายแบบรอบก่อน
//   และ "ไม่มีทองเลยสักเฉด"** — หมูการ์ตูนชมพู เหรียญทอง กล่องของขวัญ ฉากสตูดิโอขาว
//   และสีผิวนักแสดงในอาร์ตเวิร์กเป็นวัตถุในภาพ ไม่ใช่สี UI
// ⚠️ ปุ่มของ Navfoot อยู่บนแถบโครมคนละโซนกับปุ่มบนการ์ดนี้
// **ห้ามลอกคลาสของ Navfoot มาวางบนการ์ด**
// ออราในไฟล์นี้ใช้ rgba(156,15,85,α) · rgba(251,67,155,α) · rgba(106,15,60,α) ·
// rgba(255,194,226,α) · rgba(249,178,217,α) เท่านั้น
//
// ⚠️⚠️ กับดักรอบนี้คือ **รอบนี้เป็นแบรนด์ชมพูจริง และชมพูก็เป็นฮิวของแบรนด์เมื่อ
// สองรอบก่อนด้วย** การเจอชมพูในไฟล์จึง **ไม่พิสูจน์ว่าเป็นค่าของรอบนี้** ให้
// เทียบเป็น "ค่า" ทีละหลักกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้
// grep หาสีของแบรนด์เก่าเจอ false positive
// รอบนี้ **ไม่มีฟ้า/ไซแอน/น้ำเงิน (ฮิวของแบรนด์ขาออกทันที) ไม่มีทอง ไม่มีเหลือง
// ไม่มีแดง ไม่มีม่วง ไม่มีส้ม ไม่มีครีม/เบจ ไม่มีเทาเงิน และไม่มีเขียว**
//
// Announcement รอบนี้หมุนมาเป็น `Announcement3.astro` ทั้งเว็บ
// (brand-spec §3 — รอบก่อนใช้ตัวฐาน `Announcement.astro` จึงหมุนออก) orchestrator
// ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว ทุกหน้าเรียกแบบ bare
// จึง **ห้ามส่ง prop message** จากหน้านี้ ไม่งั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้ไม่มี UTF-8 locale จึงนับเป็นไบต์ = เกินจริงราว 3 เท่า)
// หน้านี้ยาว 155 ด้วยชื่อแบรนด์ 7 โค้ดพอยต์ของรอบนี้ (รอบก่อนยาว 10 จึงต้องนับใหม่
// ทุกรอบ ห้ามสืบทอดความยาวข้ามแบรนด์)
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ทำให้ตัวนับเห็นเป็น 5 อักขระ
// ประโยคนี้บรรยาย "สิ่งที่หน้านี้มี" เท่านั้น — หน้านี้มีแค่ปุ่มสองปุ่ม ไม่มีปุ่ม LINE
// จึงไม่สัญญาช่องทางแชตไว้ใน description
const pageDescription = `ทางเข้า ${BRAND_NAME} เว็บหลัก รวมปุ่มเข้าสู่ระบบและสมัครสมาชิกไว้ในหน้าเดียว สำหรับสมาชิกเว็บสล็อตเงินดี ควรตรวจสอบที่อยู่เว็บไซต์ทางการให้ถูกต้องก่อนกรอกข้อมูล`;

const graph = pageGraph(Astro, {
  name: `ทางเข้า ${BRAND_NAME} เว็บหลัก`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title={`ทางเข้า ${BRAND_NAME} เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ทางเข้า ${BRAND_NAME} เว็บหลัก`} as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="group mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 rounded-xl border-2 border-[#f479b9] bg-gradient-to-b from-[#ffffff] to-[#ffe3f5] px-6 py-4 shadow-[0_8px_24px_rgba(156,15,85,0.18)] transition-all duration-300 hover:scale-105 hover:border-[#fb439b] hover:shadow-[0_14px_36px_rgba(251,67,155,0.32)]">
          <svg class="h-9 w-9 text-[#6a0f3c]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#6a0f3c]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border-2 border-[#85094a] bg-gradient-to-b from-[#d91a73] via-[#b01160] to-[#85094a] px-6 py-4 shadow-[0_10px_30px_rgba(156,15,85,0.35)] transition-all duration-300 hover:scale-105 hover:border-[#fb439b] hover:shadow-[0_15px_40px_rgba(251,67,155,0.4)]">
          <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-white/10 to-transparent"></span>

          <svg class="h-9 w-9 text-white" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-black tracking-wide text-white">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
