---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// Button page, not an article: the brief gives this route no body at all —
// รอบนี้บรีฟ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES เลย จบที่บรรทัด 23
// ทุกย่อหน้าที่เคยอยู่บนหน้านี้ในอดีตจึงเป็นของที่รีแบรนด์รอบก่อนๆ คิดขึ้นเอง
// ทั้งหน้ามีแค่ชื่อเรื่องจาก ContentBox แล้วต่อด้วยปุ่มสองปุ่ม
// ห้ามเขียนหัวข้อย่อยหรือย่อหน้าอธิบายใต้ชื่อเรื่อง — ไม่มีรายการ "ตรวจ N จุดก่อน
// ล็อกอิน" และไม่มีประโยคเตือนเรื่องรหัสผ่าน/OTP ไม่ว่าคอปปี้นั้นจะเขียนดีแค่ไหน
//
// The <h1> names what the page IS ("ทางเข้า <brand> เว็บหลัก"), not what an
// article on it would have argued — a title that previews a body reads as a
// broken promise once the body is gone, and is the line most likely to tempt
// the next rebrand into writing it back.
//
// cta toggle รอบนี้เปิด: /login และ /register เป็น button page ที่ index ได้
// หน้านี้จึงไม่อยู่ในเมนูนาวบาร์ (brand-spec §7) แต่ยัง route และ index อยู่
// และฟุตเตอร์ยังลิงก์มาที่นี่ — ห้ามลบไฟล์นี้ ห้ามย้ายไป src/pages-disabled/
// และห้ามเติมลิงก์กลับเข้าเมนู
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตต์รอบนี้อยู่ใน .claude/brand-spec-satu168.md §2
// ⚠️⚠️ **รอบนี้เป็นแบรนด์ "ธีมสว่าง" รอบที่สองของรีโปนี้ — การ์ดสว่าง หมึกเข้ม**
// bg.json = {"mode":"color","color":"#d8ffc7"} = เขียวมิ้นต์ **สว่าง** ไม่ใช่ดำ
// การ์ด ContentBox จึงเป็นผิว **ขาว** #ffffff บนหมึกเขียวป่า #0c3a16 (= BRAND_TEXT)
// → คลาสสีของแบรนด์ก่อน (ชมพูบานเย็น/พลัม) กวาดออกครบแล้ว
//
// ขั้วของปุ่มตามสเปก (พื้นสว่าง = หมึกเข้ม · พื้นถมเข้ม = หมึกขาว) และตรงกับคู่ปุ่ม
// ของ /contact-us /login /register ซึ่งวางปุ่มคู่นี้บนการ์ดสว่างเหมือนกัน:
// ⚠️ ปุ่มของ Navfoot เป็น **โครม** (พื้นเข้ม/ทองสัมฤทธิ์) คนละโซนกับปุ่มบนการ์ดนี้
// **ห้ามลอกคลาสของ Navfoot มาวางบนการ์ดสว่าง** ทองบนผิวขาวได้แค่ 1.7-2.8:1
// สมัครสมาชิก = PRIMARY ถม **เขียวมรกต→เขียวเข้ม** #0b7d28 → #0a5f1c บนตัวอักษร
// **ขาว** (5.3:1 ที่ปลายสว่าง · 7.9:1 ที่ปลายเข้ม ผ่าน AA ทั้งคู่)
// เข้าสู่ระบบ = SECONDARY พื้น **ขาว→อินเซ็ตมิ้นต์** #ffffff → #e9fbdd ขอบ #0b7d28
// บนตัวอักษร **เขียวเข้ม** #0a5f1c (7.9:1 บนทั้งสองผิว) — hover เข้มขอบขึ้น
// ⚠️⚠️ **เขียวใบตอง #0f9b35 ห้ามถือตัวอักษรและห้ามเป็นพื้นของตัวอักษร** (3.7:1)
// เป็น stop ของไล่เฉด/ออราเท่านั้น
// ⚠️⚠️ **ทองสัมฤทธิ์ #c9cb63 #aeb04a #9ba03c ห้ามใช้ในไฟล์นี้** — บนผิวการ์ดขาว
// ได้แค่ 1.7-2.8:1 ทองเป็นสีของโครม (navbar/footer/ticker) เท่านั้น
// ⚠️ ห้ามกลับด้าน: พื้นถมเข้มคู่หมึกขาว พื้นสว่างคู่หมึกเขียวเข้มเสมอ และปลายสว่าง
// ของไล่เฉดปุ่มหลัก **ห้ามสว่างกว่า #0b7d28** (ขาวบนเขียวที่สว่างกว่านี้ตก AA ทันที)
// ชั้นตกแต่งของปุ่มหลักจึงเป็นชั้น **เข้มลง** ที่ขอบล่าง ไม่ใช่ sheen สว่างที่ขอบบน
// ออราในไฟล์นี้ใช้ rgba(11,125,40,α) · rgba(10,95,28,α) · rgba(12,58,22,α) เท่านั้น
//
// ⚠️ กับดักรอบนี้คือ **ทอง/เหลืองเคยนำมาแล้วเกือบทุกแบรนด์** การเจอทองในไฟล์จึง
// **ไม่พิสูจน์ว่าเป็นค่าของรอบนี้** ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน brand-spec
// §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive
// ส่วนเขียวทั้งสี่ค่าของรอบนี้ (0b7d28 0f9b35 0a5f1c 0c3a16) ไม่มีแบรนด์ไหนเคยใช้เลย
// รอบนี้ **ไม่มีชมพู ไม่มีแดงชาด ไม่มีบรอนซ์ส้ม ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง
// ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์ และไม่มีทองส้มสด**
//
// Announcement หมุนมาเป็น AnnouncementHuay ทั้งเว็บรอบนี้ (brand-spec §3 —
// รอบก่อนใช้ Announcement4 จึงหมุนออก) default message ของไฟล์นั้นเป็นคอปปี้
// ของแบรนด์นี้แล้ว และทุกหน้าเรียกแบบ bare จึงห้ามส่ง prop message จากหน้านี้
// ไม่งั้นตัววิ่งจะไม่ตรงกับ index.astro
//
// ⚠️ แกนของบรีฟรอบนี้คือ **เว็บหวยออนไลน์ล้วน** (หวยรัฐบาลไทย หวยฮานอย หวยลาว
// หวยหุ้นต่างประเทศ) ซึ่งคนละแกนกับรอบก่อน (ระบบดูแลการเงิน + เกมหลายหมวด)
// ศัพท์หมวดนั้นทุกคำจึงเป็นของค้างที่ต้องไม่เหลือแม้แต่คำเดียว รายการคำเต็มอยู่
// ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกม ชื่อธนาคาร หรือใบอนุญาตแม้แต่รายเดียว**
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 24ชม. · 100% ห้ามแต่งเลขใบอนุญาต
// หน่วยงานกำกับ ค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีใดๆ และห้ามมีวลี
// "N ขั้นตอน" — รอบนี้บรีฟไม่มี · หน้านี้มีโควตาเป็นปุ่มสองปุ่มเท่านั้น
// สองหน้าหมวดหวย (/ตรวจหวย /แนวทาง) เปิดอยู่รอบนี้ แต่ไม่ใช่ลิงก์ของหน้านี้
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้ไม่มี UTF-8 locale จึงนับเป็นไบต์ = เกินจริงราว 3 เท่า)
// หน้านี้ยาว 156 ด้วยชื่อแบรนด์ 7 ตัวอักษรของรอบนี้
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ทำให้ตัวนับเห็นเป็น 5 อักขระ
// ประโยคนี้บรรยาย "สิ่งที่หน้านี้มี" เท่านั้น — หน้านี้มีแค่ปุ่มสองปุ่ม ไม่มีปุ่ม LINE
// จึงไม่สัญญาช่องทางแชตไว้ใน description
// ส่วนท้ายมาจากบรีฟบรรทัด 16 ตรงตัว: ควรตรวจสอบช่องทางจากเว็บไซต์ทางการก่อนส่งข้อมูล
const pageDescription = `ทางเข้า ${BRAND_NAME} เว็บหวยหลัก รวมเมนูเข้าสู่ระบบและสมัครสมาชิกไว้ในหน้าเดียว เลือกเมนูที่ต้องการได้ทันที ควรตรวจสอบที่อยู่เว็บไซต์ทางการทุกครั้งก่อนกรอกข้อมูล`;

const graph = pageGraph(Astro, {
  name: `ทางเข้า ${BRAND_NAME} เว็บหลัก`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title={`ทางเข้า ${BRAND_NAME} เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ทางเข้า ${BRAND_NAME} เว็บหลัก`} as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border-2 border-[#0b7d28] bg-gradient-to-b from-[#ffffff] to-[#e9fbdd] px-6 py-4 shadow-[0_10px_30px_rgba(12,58,22,0.18)] transition-all duration-300 hover:scale-105 hover:border-[#0a5f1c] hover:shadow-[0_15px_40px_rgba(11,125,40,0.35)]">
          <div aria-hidden="true" class="absolute inset-x-0 bottom-0 -z-10 h-1/2 bg-gradient-to-t from-[#e9fbdd] to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#0b7d28] transition-colors group-hover:text-[#0a5f1c]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#0a5f1c]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#0a5f1c] bg-gradient-to-b from-[#0b7d28] to-[#0a5f1c] px-6 py-4 shadow-[0_10px_30px_rgba(11,125,40,0.4)] transition-all duration-300 hover:scale-105 hover:border-[#0c3a16] hover:shadow-[0_15px_40px_rgba(11,125,40,0.55)]">
          <div aria-hidden="true" class="absolute inset-x-0 bottom-0 -z-10 h-1/2 bg-gradient-to-t from-[#0a5f1c]/60 to-transparent"></div>

          <svg class="h-9 w-9 text-[#ffffff]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-black tracking-wide text-[#ffffff]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
