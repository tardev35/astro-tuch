---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
// Heading inventory for this page must stay h1x1, h2x0, h3x0.
//
// The <h1> names what the page IS ("ทางเข้า <brand> เว็บหลัก"), not what an
// article on it would have argued — a title that previews a body reads as a
// broken promise once the body is gone, and is the line most likely to tempt
// the next rebrand into writing it back.
//
// This route stays OUT of the navbar menu on purpose while the cta toggle is on
// (/login and /register are menu entries themselves), but it is still routed,
// still indexed and still linked from the footer. Do not add a nav link and do
// not delete the page.
//
// Two button tiers on the หวย24 palette (brand-spec §2 **แดงแบรนด์เป็นสีหลัก
// ทองเป็นสีรอง** — vivid ของ logo.webp คือแดง #c40303 และแบนเนอร์เป็นผ้าไหมแดง
// กับเหรียญทองบนพื้นดำ รอบ หวยคิง ที่แล้วทองเป็นสีหลัก รอบนี้กลับทิศ):
// สมัครสมาชิก คือแอ็กชันหลัก จึงได้ไล่เฉด **ทอง** เต็มใบ (#ffd45e → #f5c33b →
// #a9761a) ขอบทองลึก #a9761a ตัวอักษร **ดำอมแดง #1a0303** — กฎคอนทราสต์:
// หมึกขาวบนทองสว่าง #ffd45e ตก พื้นทองจึงต้องใช้หมึกเข้มเสมอ (#1a0303 ≈ 12:1)
// ส่วน เข้าสู่ระบบ เป็นแอ็กชันรอง จึงถม **แดงเข้มสุด #2a0606 ในกรอบแดงแบรนด์
// #d20a0a/60** ตัวอักษรเนื้อความ #f7e2d6 hover ยกกรอบเป็นทองแบรนด์ #f5c33b/65
// และผิวเป็นแดงลึก #7a0505 — คู่เดียวกับที่ NavbarStyle10 และ FooterStyle3 ใช้
// ลำดับความสำคัญจึงสื่อด้วย "ถมทอง vs ถมแดง" ไม่ใช่ถมสีเดียวกันสองใบ ซึ่งจะอ่าน
// เป็นปุ่มซ้ำกันสองปุ่ม — และไม่ใช่ทองจางๆ ซึ่งอ่านเป็นปุ่มที่ปิดใช้งาน
// ออราด้านบนของปุ่มใช้คู่ตรงข้ามตามลายเซ็นงานศิลป์: ปุ่มรองเป็นแดงสว่าง
// rgba(255,59,59,α) ปุ่มหลักเป็นทองสว่างไล่ลงไปใส เงากลางเป็น rgba(0,0,0,α)
// ชุดทองโลหะ-ครีมอมพีชของ หวยคิง (#cd9a2c #fdeb7c #ab7314 #f5e7c8 #fcd4c3 #fce2d4
// #1c140b #0c0b0a #120a02 rgba(205,154,44,*) rgba(252,212,195,*) rgba(253,235,124,*))
// ถูกแทนครบแล้ว
//
// Announcement หมุนมาเป็น Announcement3 ทั้งเว็บรอบนี้ (แบรนด์ก่อน หวยคิง ใช้
// AnnouncementHuay) — default message ของไฟล์นั้นเป็นคอปปี้ของ หวย24 แล้ว และ
// index ก็เรียกแบบ bare จึงห้ามส่ง prop message จากหน้านี้
//
// หวย24 เป็นเว็บรับแทงหวยล้วน บรีฟรอบนี้พูดถึงการเลือกหวย รอบ และเลขที่ต้องการ
// ตรวจอัตราจ่ายกับยอดเดิมพันก่อนส่งโพย และดูผลรางวัลกับประวัติโพยจากบัญชีเดียว
// ตลาดหวยที่บรีฟระบุและอ้างได้มีสามตัว: หวยลาว · หวยฮานอย · รัฐบาลไทย
// คำหมวดสล็อต/คาสิโน (สล็อต บาคาร่า คาสิโนสด ค่ายเกม RTP) ห้ามหลงเหลือ
// และห้ามเพิ่มเวลาเปิด-ปิดรับ ใบอนุญาต ชื่อธนาคาร หรือยอดฝากขั้นต่ำที่บรีฟไม่ได้
// ระบุ หน้านี้มีโควตาเป็นปุ่มสองปุ่มเท่านั้น
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 151
const pageDescription = `ทางเข้า ${BRAND_NAME} เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ เพื่อเลือกหวยลาว หวยฮานอย รัฐบาลไทย ส่งโพย ตรวจอัตราจ่าย และดูผลรางวัลกับประวัติโพยได้`;

const graph = pageGraph(Astro, {
  name: `ทางเข้า ${BRAND_NAME} เว็บหลัก`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title={`ทางเข้า ${BRAND_NAME} เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ทางเข้า ${BRAND_NAME} เว็บหลัก`} as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#d20a0a]/60 bg-[#2a0606] px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.75)] transition-all duration-300 hover:scale-105 hover:border-[#f5c33b]/65 hover:bg-[#7a0505] hover:shadow-[0_15px_40px_rgba(210,10,10,0.4)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ff3b3b]/28 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#ff3b3b] transition-colors group-hover:text-[#ffd45e]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#f7e2d6] transition-colors group-hover:text-[#ffd45e]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#a9761a] bg-gradient-to-r from-[#ffd45e] via-[#f5c33b] to-[#a9761a] px-6 py-4 shadow-[0_10px_30px_rgba(245,195,59,0.40)] transition-all duration-300 hover:scale-105 hover:border-[#ffd45e] hover:shadow-[0_15px_40px_rgba(255,212,94,0.35)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ffd45e]/35 to-transparent"></div>

          <svg class="h-9 w-9 text-[#1a0303]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#1a0303]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
