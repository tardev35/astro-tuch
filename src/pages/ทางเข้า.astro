---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
//
// BUTTON PAGE ไม่ใช่บทความ — บรีฟ (src/assets/content.txt, 29 บรรทัด) **ไม่มีส่วน
// SUB-PAGES** จึงไม่เคยให้ body กับหน้านี้ ทุกย่อหน้าและทุกหัวข้อย่อยที่เคยอยู่บน
// หน้านี้คือของที่รีแบรนด์รอบก่อนๆ คิดขึ้นเอง แล้วรอบถัดมาก็เขียนทับด้วยความเชื่อว่า
// รอบก่อนมีเหตุผล — ไม่มี ทั้งหน้ามีแค่ชื่อเรื่องจาก ContentBox แล้วต่อด้วยปุ่มสองปุ่ม
// **ห้ามเขียนหัวข้อย่อยหรือย่อหน้าอธิบายใต้ชื่อเรื่อง** — ไม่มีรายการ "ตรวจ N จุด
// ก่อนล็อกอิน" ไม่มีประโยคเตือนเรื่องรหัสผ่าน/OTP ไม่ว่าคอปปี้นั้นจะเขียนดีแค่ไหน
// (ประโยคกำกับเรื่องรหัสผ่าน/OTP ของบรีฟอยู่บน index.astro และ /about-us ซึ่งเป็น
// บทความจริง ไม่ใช่บนหน้าปุ่ม)
//
// h1 บอกว่า "หน้านี้คืออะไร" ("ทางเข้า <แบรนด์> เว็บหลัก") ไม่ใช่บอกว่าบทความบน
// หน้านี้จะเถียงอะไร — ชื่อเรื่องที่โฆษณาเนื้อหาไว้คือบรรทัดที่ล่อให้รีแบรนด์รอบ
// ถัดไปเขียน body กลับมามากที่สุด
//
// cta toggle รอบนี้เปิด: /login และ /register เป็น button page ที่ index ได้
// หน้านี้จึง **ไม่อยู่ในเมนูนาวบาร์โดยตั้งใจ** แต่ยัง route และ index อยู่ และ
// footer ที่ใช้งานอยู่ยังลิงก์มาที่นี่ — ห้ามลบไฟล์นี้ ห้ามย้ายไป
// src/pages-disabled/ และห้ามเติมลิงก์กลับเข้าเมนู
//
// ───────────────────────────────────────────────────────────────────────────
// 🚨 แกนของแบรนด์รอบนี้คือ **เว็บเกมคาสิโน/เดิมพันออนไลน์** (บาคาร่า สล็อต หวย
// บอล ไฮโล — .claude/brand-spec-zoro365.md §0) คำนิยามตัวเองของแบรนด์ก่อนๆ ห้ามเหลือ
// ที่ไหนทั้งสิ้น รายการคำที่ห้ามใช้อยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้
// sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// ⚠️ **บรีฟรอบนี้ไม่มีหมวดฝากถอน/ธนาคาร/วอลเลทเลยสักคำ** — หน้านี้ไม่เอ่ยถึงเลย
// ⚠️ route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ทดลองเล่น · /about-us · /contact-us · /terms · /privacy · /line —
// **สองหน้าหมวดหวย (ชื่อไฟล์อยู่ใน brand-spec §7) อยู่ใน src/pages-disabled/
// ตามเดิม ลิงก์ไปที่นั่น = build แดง**
// แต่หน้านี้มีโควตาเป็นปุ่มสองปุ่ม จึงไม่ลิงก์ไปที่อื่นเพิ่มอยู่แล้ว
// ⚠️ ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 0.3% · 0.8% · 3 ขั้นตอน · 24ชม. — หน้านี้มีโควตา
// เป็นปุ่มสองปุ่ม จึงไม่อ้างตัวเลขใดเลย
//
// พาเลตรอบนี้อยู่ใน .claude/brand-spec-zoro365.md §2
// 🚨🚨 **กลับทิศ 180° จากรอบก่อน: รอบนี้มืดทั้งเว็บ ทั้งเนื้อหาและโครม**
// bg.json = {"mode":"color","color":"#002908"} = **เขียวป่าจมเกือบดำ**
// (รอบก่อนเป็นขาวอมมิ้นต์จาง ซึ่งอยู่คนละปลายของสเกล — ค่ามาจากไฟล์ ห้ามเดาว่าเท่าเดิม)
// การ์ด ContentBox จึงเป็นผิว #073c1a บนหมึก #eef7f0 (= BRAND_TEXT, 12.0:1)
// **ห้าม "แก้" การ์ดกลับไปเป็นผิวขาวตามรอบก่อน** — การ์ดขาวบนหมึกนี้ = ตัวอักษร
// หายไปเลย ไม่ใช่แค่จางลง
//
// ขั้วของปุ่มบนการ์ดผิวเข้ม (ตรงกับคู่ปุ่มที่ล็อกไว้ใน brand-spec §2):
// สมัครสมาชิก = PRIMARY พื้นไล่เฉดเขียว #0e5424 -> #1e7033 -> #23823a
//   บนหมึก **ขาว #ffffff** (8.4 / 6.1 / 4.9:1 ผ่าน AA ทุกสต็อป) — ปุ่ม CTA หลัก
//   ⚠️⚠️ **ห้ามลากสต็อปขึ้นไปถึง #35a043 หรือ #3ddc4a** — ขาวบนสองค่านั้นตก AA
//   สองค่านั้นเป็นขอบ/ออรา/พื้นถมเท่านั้น
// เข้าสู่ระบบ = SECONDARY พื้นไล่เฉด #073c1a -> #0e5424 บนหมึก **#eef7f0**
//   ขอบ #35a043 คือสิ่งที่แยกปุ่มนี้ออกจากผิวการ์ด — ห้ามถอดขอบออก
// ⚠️⚠️ **002908 010d04 031b09 073c1a 0e5424 1e7033 35a043 เป็นผิว/เส้น ห้ามถือ
//   ตัวอักษรเด็ดขาด** · ที่ถือตัวอักษรได้บนผิวเข้มชุดนี้คือ #eef7f0 (12.0:1) ·
//   #dfe6e3 (9.9:1) · #e8c86a (8.0:1) · #3ddc4a (6.9:1) · #9dc2a5 (6.3:1)
// ⚠️⚠️ **ค่าของรอบก่อน (f0ffeb ffffff e6f7df b2dba3 3f7a2e 10280f 116018 0b4a12
//   1a7d24 28c437 e3bb45 c6cfd2 e8fbe4 b4d6ad 15401d — เขียนแบบไม่มี # โดยตั้งใจ)
//   ห้ามหลงเหลือในไฟล์นี้แม้แต่ค่าเดียว**
// ⚠️⚠️ **ฮิวนำของรอบนี้คือเขียวมรกตบนผิวเข้ม** — เวิร์ดมาร์กสามมิติที่ครึ่งแรกเป็น
//   ตัวอักษรผิวโครเมียมเงิน ครึ่งหลังเป็นตัวเลขผิวเขียวมรกต ดาบคาทานะ กอไผ่
//   กิโมโนลายดอกไม้ ชิปคาสิโนเขียว-ขาว และมงกุฎทองในอาร์ตเวิร์กเป็นวัตถุในภาพ
//   ไม่ใช่สี UI · พื้นเพจมาจาก bg.json เท่านั้น
// ⚠️ ปุ่มของ Navfoot อยู่บนแถบโครม #031b09 คนละโซนกับปุ่มบนการ์ด #073c1a นี้
// **ห้ามลอกคลาสของ Navfoot มาวางบนการ์ด**
// ออราในไฟล์นี้ใช้ rgba(1,13,4,α) · rgba(61,220,74,α) · rgba(232,200,106,α) ·
// rgba(223,230,227,α) เท่านั้น
//
// ⚠️⚠️ กับดักรอบนี้คือ **เขียวเคยเป็นฮิวนำของแบรนด์เก่ามาแล้วหลายเจ้า รวมถึง
// รอบก่อนทันที และเขียวเป็นฮิวที่ตาแยกค่าได้ยากที่สุด** การเจอเขียวในไฟล์จึง
// **ไม่พิสูจน์ว่าเป็นค่าของรอบนี้** ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน
// brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ
// false positive
// รอบนี้ **ไม่มีม่วง/ฟ้า/ไซแอน/แมเจนต้า/ชมพู/ส้มเพลิง/แดงเป็นสี UI** เลยสักเฉด
//
// Announcement รอบนี้หมุนมาเป็นตัวท้ายชื่อเลขสาม ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ตัวท้ายชื่อ Premium จึงหมุนออก · เขียนชื่อไฟล์แบบไม่มีเครื่องหมายคำพูด
// โดยตั้งใจ เพราะ tools/gen-tw-sources.mjs นับ literal ที่มีเครื่องหมายคำพูดว่าเป็น
// การ import จริง คอมเมนต์จึงทำให้ variant เก่าหลุดเข้า Tailwind scan แล้วสีของ
// แบรนด์ก่อนขึ้น stylesheet) orchestrator เป็นเจ้าของ default message ของไฟล์นั้น
// ทุกหน้าเรียกแบบ bare จึง **ห้ามส่ง prop message** จากหน้านี้ ไม่งั้นตัววิ่งจะพูด
// คนละเรื่องกับหน้าอื่น
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้ไม่มี UTF-8 locale จึงนับเป็นไบต์ = เกินจริงราว 3 เท่า)
// หน้านี้ยาว 153 ด้วยชื่อแบรนด์ 7 โค้ดพอยต์ของรอบนี้ (รอบก่อนยาว 6 — ต้องนับใหม่
// ทุกรอบ ห้ามสืบทอดความยาวข้ามแบรนด์) ส่วนที่ไม่ใช่ชื่อแบรนด์ยาว 146 →
// รับชื่อแบรนด์ได้ 4–14 อักขระ ถ้ารอบหน้าชื่อยาวกว่านั้นต้องตัดข้อความ
// ไม่ใช่ปล่อยผ่าน
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ทำให้ตัวนับเห็นเป็น 5 อักขระ
// ประโยคนี้บรรยาย "สิ่งที่หน้านี้มี" เท่านั้น — หน้านี้มีแค่ปุ่มสองปุ่ม ไม่มีปุ่ม LINE
// จึงไม่สัญญาช่องทางแชตไว้ใน description
const pageDescription = `ทางเข้า ${BRAND_NAME} เว็บหลัก รวมปุ่มเข้าสู่ระบบและสมัครสมาชิกไว้ในหน้าเดียว สำหรับผู้ที่ต้องการเข้าใช้งานระบบสมาชิก ควรตรวจสอบที่อยู่เว็บไซต์ทางการก่อนใช้งาน`;

const graph = pageGraph(Astro, {
  name: `ทางเข้า ${BRAND_NAME} เว็บหลัก`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title={`ทางเข้า ${BRAND_NAME} เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ทางเข้า ${BRAND_NAME} เว็บหลัก`} as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="group mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 rounded-xl border-2 border-[#35a043] bg-gradient-to-b from-[#073c1a] to-[#0e5424] px-6 py-4 shadow-[0_8px_24px_rgba(1,13,4,0.45)] transition-all duration-300 hover:scale-105 hover:border-[#3ddc4a] hover:shadow-[0_14px_36px_rgba(61,220,74,0.3)]">
          <svg class="h-9 w-9 text-[#eef7f0]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#eef7f0]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border-2 border-[#35a043] bg-gradient-to-b from-[#0e5424] via-[#1e7033] to-[#23823a] px-6 py-4 shadow-[0_10px_30px_rgba(1,13,4,0.5)] transition-all duration-300 hover:scale-105 hover:border-[#3ddc4a] hover:shadow-[0_15px_40px_rgba(61,220,74,0.35)]">
          <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-white/10 to-transparent"></span>

          <svg class="h-9 w-9 text-white" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-black tracking-wide text-white">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
