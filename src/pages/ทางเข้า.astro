---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";

// Button page, not an article: the docx gives this route a Title and a Meta and
// never a body. One heading from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the <h1>.
const pageDescription =
  "ทางเข้า DARK168 เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้ทันที รองรับมือถือ แท็บเล็ต คอมพิวเตอร์ เข้าเล่นดาร์คสล็อตค่ายหลักเว็บตรง ไม่ล็อคยูส ฝากถอนอัตโนมัติ";

const graph = pageGraph(Astro, {
  name: "ทางเข้า DARK168 เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ทางเข้า DARK168 เว็บดาร์คสล็อตเว็บหลัก เข้าสู่ระบบและสมัครสมาชิก" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า DARK168 เว็บหลัก" as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ DARK168"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#8a6320]/70 bg-[#050505] px-6 py-4 shadow-[0_10px_30px_rgba(230,183,78,0.18)] transition-all duration-300 hover:scale-105 hover:border-[#f6dfa4] hover:bg-[#5c4212] hover:shadow-[0_15px_40px_rgba(230,183,78,0.30)]">
          <div class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#e6b74e]/20 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#f6dfa4]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#ece3d1]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก DARK168"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f6dfa4]/70 bg-gradient-to-r from-[#c8cfd8] via-[#f6dfa4] to-[#e6b74e] px-6 py-4 shadow-[0_10px_30px_rgba(230,183,78,0.25)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(230,183,78,0.35)]">
          <div class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-white/40 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#131009]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#131009]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
