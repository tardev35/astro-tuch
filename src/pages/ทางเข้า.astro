---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "ทางเข้า WE168 เว็บหลักคาสิโนออนไลน์ พร้อมปุ่มเข้าสู่ระบบและสมัครสมาชิกสำหรับสมาชิก รองรับมือถือ แท็บเล็ต คอมพิวเตอร์ เข้าเล่นบาคาร่า รูเล็ต สล็อตได้สะดวกทุกที่";

const graph = pageGraph(Astro, {
  name: "ทางเข้า WE168 เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ทางเข้า WE168 เว็บหลัก" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า WE168 เว็บหลัก" as="h1">
    <div>
      <div class="mb-5 grid grid-cols-1 gap-8 md:grid-cols-2">
        <div class="flex flex-col items-center justify-center gap-4">
          <a
            href="/login"
            aria-label="เข้าสู่ระบบ WE168"
            class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#22c55e]/60 bg-[#0a1207] px-6 py-4 shadow-[0_10px_30px_rgba(34,197,94,0.18)] transition-all duration-300 hover:scale-105 hover:border-[#4ade80] hover:bg-[#0f1a06] hover:shadow-[0_15px_40px_rgba(22,163,74,0.30)]">
            <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-[#4ade80]/20 to-transparent"></div>

            <svg
              class="relative z-10 h-9 w-9 text-[#4ade80]"
              aria-hidden="true"
              focusable="false"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
            </svg>

            <span class="relative z-10 text-3xl font-bold tracking-wide text-[#e8f5ee]">เข้าสู่ระบบ</span>
          </a>
        </div>

        <div class="flex flex-col items-center justify-center gap-4">
          <a
            href="/register"
            aria-label="สมัครสมาชิก WE168"
            class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ec4899]/60 bg-gradient-to-r from-[#f9a8d4] to-[#db2777] px-6 py-4 shadow-[0_10px_30px_rgba(236,72,153,0.18)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(219,39,119,0.30)]">
            <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-white/55 to-transparent"></div>

            <svg
              class="relative z-10 h-9 w-9 text-[#4a0a29]"
              aria-hidden="true"
              focusable="false"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
            </svg>

            <span class="relative z-10 text-3xl font-bold tracking-wide text-[#4a0a29]">สมัครสมาชิก</span>
          </a>
        </div>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
