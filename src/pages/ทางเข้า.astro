---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
// Heading inventory for this page must stay h1x1, h2x0, h3x0.
//
// This route stays OUT of the navbar menu on purpose while the cta toggle is on
// (/login and /register are menu entries themselves), but it is still routed,
// still indexed and still linked from the footer. Do not add a nav link and do
// not delete the page.
//
// Two button tiers on the 365LOTTO palette (แดงเข้ม + ทองสว่าง + เงินโครเมียม
// บนพื้นแดงเกือบดำ ตามโลโก้ที่ "365" เป็นทองและ "LOTTO" เป็นเงินโครเมียมตัว O
// สีแดง): สมัครสมาชิก คือแอ็กชันหลัก จึงได้พื้นไล่ทองเต็มใบ (#ffe9a3 → #fadc64
// → #9c6a12) ตัวอักษรเป็นหมึกแดงเกือบดำ #120406 เพื่อให้คอนทราสต์บนทองอ่านออก
// ส่วน เข้าสู่ระบบ เป็นแอ็กชันรอง จึงเป็นเส้นขอบทองแบรนด์ #fadc64 บนพื้นการ์ด
// #1a0709 ตัวอักษรเนื้อความ #f0ddc4 (hover ยกผิวขึ้นเป็น #33100f ขอบทองสว่าง
// #ffe9a3 และตัวอักษรเงินโครเมียม #f3f6fa) — ทองอุ่น-น้ำตาลของ SAGAME66 รอบก่อน
// (#e8b93f / #96671a / #0d0903 / #171006 / #2a1d0b / #e3d8c0 / #eef3f8)
// ถูกแทนครบทุกจุดแล้ว
//
// Announcement รอบนี้หมุนมาใช้ AnnouncementHuay ทั้งเว็บ — default message ของ
// ไฟล์นั้นถูกตั้งเป็นคอปปี้ของ 365LOTTO แล้ว และ index ก็เรียกแบบ bare จึงห้ามส่ง prop
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 159
const pageDescription = "ทางเข้า 365LOTTO เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ทันที เพื่อเข้าเล่นหวยรัฐบาลไทย ฮานอย ลาวพัฒนา บาคาร่า ไพ่ และสล็อต ได้จากบัญชีเดียวบนมือถือ";

const graph = pageGraph(Astro, {
  name: "ทางเข้า 365LOTTO เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ทางเข้า 365LOTTO เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า 365LOTTO เว็บหลัก" as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ 365LOTTO"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fadc64]/70 bg-[#1a0709] px-6 py-4 shadow-[0_10px_30px_rgba(18,4,6,0.7)] transition-all duration-300 hover:scale-105 hover:border-[#ffe9a3] hover:bg-[#33100f] hover:shadow-[0_15px_40px_rgba(250,220,100,0.45)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#fadc64]/30 to-transparent"></div>

          <svg class="h-9 w-9 text-[#f0ddc4] transition-colors group-hover:text-[#f3f6fa]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#f0ddc4] transition-colors group-hover:text-[#f3f6fa]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก 365LOTTO"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ffe9a3]/70 bg-gradient-to-r from-[#ffe9a3] via-[#fadc64] to-[#9c6a12] px-6 py-4 shadow-[0_10px_30px_rgba(250,220,100,0.40)] transition-all duration-300 hover:scale-105 hover:border-[#f3f6fa] hover:shadow-[0_15px_40px_rgba(243,246,250,0.45)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#f3f6fa]/30 to-transparent"></div>

          <svg class="h-9 w-9 text-[#120406]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#120406]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
