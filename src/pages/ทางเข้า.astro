---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
// Heading inventory for this page must stay h1x1, h2x0, h3x0.
//
// This route stays OUT of the navbar menu on purpose while the cta toggle is on
// (/login and /register are menu entries themselves), but it is still routed,
// still indexed and still linked from the footer. Do not add a nav link and do
// not delete the page.
//
// Two button tiers on the หวยเต็ง palette (เขียวป่า + ทอง ตามโลโก้ที่คำว่า "หวย"
// เป็นเขียวมรกตขอบทอง และ "เต็ง" เป็นทองตัน บนแบนเนอร์ฉากคืนสีเขียวป่าที่มีริ้วแสงทอง
// เหรียญทอง ลูกหวยทอง-ขาว และเงาวัดสีทอง):
// สมัครสมาชิก คือแอ็กชันหลัก จึงได้ไล่เฉดทองเต็มใบ (#fae474 → #e5c04f → #bd8d2d)
// ตัวอักษรเป็นหมึกเข้ม #0a1a0c — ทองเป็นสีสว่าง ตัวอักษรขาวบน #e5c04f ตก AA
// จึงห้ามใช้ขาวบนพื้นทองเด็ดขาด
// ส่วน เข้าสู่ระบบ เป็นแอ็กชันรอง จึงเป็นแบบ outline — กรอบเขียวแบรนด์ #026314
// บนผิวยก #0b3d18 ตัวอักษรทอง #e5c04f (hover ยกผิวขึ้นเป็นเขียวเส้น #024a0f
// ขอบเขียวสว่าง #0bb42f และตัวอักษรทองอ่อน #fae474) — ถมทองคู่กรอบเขียว
// ไม่ใช่ถมทองสองใบ ซึ่งจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม
// ชุดน้ำเงินรอยัล-ทองของ BRAVO168 (#02081a #04142f #072247 #0e3f8f #1558c4 #2f86f0
// #f4cb69 #ffe39a #c9922e #dbe5f5 #0a1020 rgba(244,203,105,*) rgba(21,88,196,*)
// rgba(2,8,26,*)) ถูกแทนครบทุกจุดแล้ว
//
// Announcement หมุนมาเป็น Announcement3 ทั้งเว็บรอบนี้ (รอบก่อนเป็น
// AnnouncementPremium) — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ
// หวยเต็ง แล้ว และ index ก็เรียกแบบ bare จึงห้ามส่ง prop message จากหน้านี้
//
// หวยเต็ง เป็นเว็บแทงหวยออนไลน์ ไม่ใช่บอลและไม่ใช่สล็อต — บรีฟพูดถึงการรวมหวย
// หลายประเภทไว้ในบัญชีเดียว ทั้งรัฐบาลไทย ลาวพัฒนา ฮานอยปกติ ฮานอยพิเศษ ฮานอยวีไอพี
// และหวยหุ้นต่างประเทศ การเลือกเลข ส่งโพย เวลาปิดรับ อัตราจ่าย 2 ตัว จ่าย 100 บาท
// 3 ตัว จ่าย 1,000 บาท สมัครเอง 3 ขั้นตอน และแอดมิน 24 ชม. เท่านั้น
// คำศัพท์ของสองแบรนด์ก่อน (บอล ฟุตบอล บอลเดี่ยว บอลสเต็ป บอลสด ค่าน้ำ อัตราต่อรอง
// ลีก คู่แข่งขัน แมตช์ บิล แฮนดิแคป สล็อต ฟรีสปิน แจ็กพอต บาคาร่า รูเล็ต คาสิโน)
// ห้ามหลงเหลือ และห้ามเพิ่มใบอนุญาต ชื่อธนาคาร ยอดฝากขั้นต่ำ หรือชื่อผู้ให้บริการจริง
// รอบนี้สองเราต์ตระกูลหวย (/ตรวจหวย, /แนวทาง) เปิดใช้งานอยู่ แต่หน้านี้มีโควตาเป็น
// ปุ่มสองปุ่มเท่านั้น จึงไม่เพิ่มลิงก์อะไรที่นี่
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 157
const pageDescription = "ทางเข้า หวยเต็ง เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ เพื่อเลือกหวยรัฐบาลไทย ลาวพัฒนา ฮานอย และหวยหุ้น ผ่านเบราว์เซอร์บนมือถือ ไม่ต้องติดตั้งแอป";

const graph = pageGraph(Astro, {
  name: "ทางเข้า หวยเต็ง เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ทางเข้า หวยเต็ง เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า หวยเต็ง เว็บหลัก" as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ หวยเต็ง"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#026314] bg-[#0b3d18] px-6 py-4 shadow-[0_10px_30px_rgba(3,21,10,0.85)] transition-all duration-300 hover:scale-105 hover:border-[#0bb42f] hover:bg-[#024a0f] hover:shadow-[0_15px_40px_rgba(2,99,20,0.40)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#026314]/30 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#e5c04f] transition-colors group-hover:text-[#fae474]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#e5c04f] transition-colors group-hover:text-[#fae474]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก หวยเต็ง"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fae474]/70 bg-gradient-to-r from-[#fae474] via-[#e5c04f] to-[#bd8d2d] px-6 py-4 shadow-[0_10px_30px_rgba(229,192,79,0.40)] transition-all duration-300 hover:scale-105 hover:border-[#fae474] hover:shadow-[0_15px_40px_rgba(229,192,79,0.35)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#fae474]/40 to-transparent"></div>

          <svg class="h-9 w-9 text-[#0a1a0c]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#0a1a0c]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
