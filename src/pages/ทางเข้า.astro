---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
// Heading inventory for this page must stay h1x1, h2x0, h3x0.
//
// The <h1> names what the page IS ("ทางเข้า <brand> เว็บหลัก"), not what an
// article on it would have argued — a title that previews a body reads as a
// broken promise once the body is gone, and is the line most likely to tempt
// the next rebrand into writing it back.
//
// This route stays OUT of the navbar menu on purpose while the cta toggle is on
// (/login and /register are menu entries themselves), but it is still routed,
// still indexed and still linked from the footer. Do not add a nav link and do
// not delete the page.
//
// Two button tiers on the หวย365 palette (brand-spec §2 แดงสด-ทอง):
// สมัครสมาชิก คือแอ็กชันหลัก จึงได้ไล่เฉดทองเต็มใบ (#ffeab0 → #ffc93c → #c08a07)
// ตัวอักษรเป็นหมึกเข้ม #1a0303 — ปลายไล่เฉดห้ามเข้มกว่า #c08a07 ซึ่งวัดได้ 6.4:1
// ส่วน เข้าสู่ระบบ เป็นแอ็กชันรอง จึงเป็นแบบ outline — กรอบแดงลึก #9c0201
// บนผิวการ์ด #240406 ตัวอักษรทอง #ffc93c (hover ยกผิวขึ้นเป็นแดงลึก #9c0201
// ขอบแดงสว่าง #f5282a และตัวอักษรทองอ่อน #ffeab0) — ถมทองคู่กรอบแดง
// ไม่ใช่ถมทองสองใบ ซึ่งจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม
// ห้ามตัวอักษรขาวบนพื้นทอง และห้ามหมึกเข้มบนพื้นแดง (brand-spec §2)
// ชุดของ หวยเฮง789 (#dc2224 #f4bc5d #ffefc2 #fbe3d4 #1c0606 #2b0909 #ab0204
// #e43434 #d99a10 #a8690c #5c0a0a rgba(244,188,93,*) rgba(220,34,36,*)
// rgba(11,2,2,*)) ถูกแทนครบทุกจุดแล้ว
//
// Announcement หมุนมาเป็น AnnouncementCyber ทั้งเว็บรอบนี้ (รอบก่อนเป็น
// Announcement2) — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ
// หวย365 แล้ว และ index ก็เรียกแบบ bare จึงห้ามส่ง prop message จากหน้านี้
//
// หวย365 เป็นเว็บแทงหวยออนไลน์ ไม่ใช่บอลและไม่ใช่สล็อต — บรีฟรอบนี้พูดถึงการรวม
// แนวทางหวย กลุ่มหวย สถิติหวยย้อนหลัง และผลหวยตามรอบที่ประกาศไว้ในบัญชีเดียว ครบทั้ง
// หวยรัฐบาลไทย หวยฮานอย หวยลาวพัฒนา และหวยหุ้นต่างประเทศ พร้อมเวลาเปิดรับ เวลาปิดรับ
// อัตราจ่าย 2 ตัว จ่าย 100 บาท / 3 ตัว จ่าย 1,000 บาท สมัครเอง 3 ขั้นตอน และแอดมิน
// 24 ชม. เท่านั้น
// คำศัพท์ของแบรนด์ก่อนหน้า (เลขเด็ด เลขดัง ไม่จำกัด แทงได้ไม่อั้น ฮานอยปกติ/พิเศษ/
// วีไอพี ฝากถอนวอลเลท สล็อต ฟรีสปิน RTP บอล ค่าน้ำ อัตราต่อรอง ลีก คาสิโน บาคาร่า)
// ห้ามหลงเหลือ และห้ามเพิ่มใบอนุญาต ชื่อธนาคาร ยอดฝากขั้นต่ำ หรือชื่อผู้ให้บริการจริง
// รอบนี้สองเราต์ตระกูลหวย (/ตรวจหวย, /แนวทาง) เปิดใช้งานอยู่ แต่หน้านี้มีโควตาเป็น
// ปุ่มสองปุ่มเท่านั้น จึงไม่เพิ่มลิงก์อะไรที่นี่
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 160
const pageDescription = `ทางเข้า ${BRAND_NAME} เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ เพื่อติดตามแนวทางหวย กลุ่มหวย สถิติหวยย้อนหลัง และผลหวยรัฐบาลไทย ฮานอย ลาวพัฒนา หุ้นต่างประเทศ`;

const graph = pageGraph(Astro, {
  name: `ทางเข้า ${BRAND_NAME} เว็บหลัก`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title={`ทางเข้า ${BRAND_NAME} เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ทางเข้า ${BRAND_NAME} เว็บหลัก`} as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#9c0201] bg-[#240406] px-6 py-4 shadow-[0_10px_30px_rgba(8,1,1,0.85)] transition-all duration-300 hover:scale-105 hover:border-[#f5282a] hover:bg-[#9c0201] hover:shadow-[0_15px_40px_rgba(220,2,3,0.35)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#dc0203]/30 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#ffc93c] transition-colors group-hover:text-[#ffeab0]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#ffc93c] transition-colors group-hover:text-[#ffeab0]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#c08a07]/70 bg-gradient-to-r from-[#ffeab0] via-[#ffc93c] to-[#c08a07] px-6 py-4 shadow-[0_10px_30px_rgba(255,201,60,0.40)] transition-all duration-300 hover:scale-105 hover:border-[#ffeab0] hover:shadow-[0_15px_40px_rgba(255,201,60,0.35)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ffeab0]/40 to-transparent"></div>

          <svg class="h-9 w-9 text-[#1a0303]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#1a0303]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
