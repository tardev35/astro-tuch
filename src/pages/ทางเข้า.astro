---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
// Heading inventory for this page must stay h1x1, h2x0, h3x0.
//
// This route stays OUT of the navbar menu on purpose while the cta toggle is on
// (/login and /register are menu entries themselves), but it is still routed,
// still indexed and still linked from the footer. Do not add a nav link and do
// not delete the page.
//
// Two button tiers on the PGW44 palette (ทองเหลืองสด + เขียวจัด บนพื้นเกือบดำ ตาม
// โลโก้ที่ P เป็นดำขลิบทอง G เป็นทองไล่เฉด W เป็นเขียว และ 44 ไล่จากทองไปเขียว):
// สมัครสมาชิก คือแอ็กชันหลัก จึงได้ไล่เฉดประจำแบรนด์เต็มใบ (#fde90e → #f5c518 →
// #35d413 ทองไหลไปเขียวตามลำดับตัวอักษรในโลโก้) ตัวอักษรหมึกเข้ม #10160a เพราะ
// ตัวหนังสือบนพื้นทองสว่างต้องเป็นสีเข้ม ห้ามใช้ขาว ส่วน เข้าสู่ระบบ เป็นแอ็กชันรอง จึง
// เป็นฝั่ง "W" ของโลโก้ — เส้นขอบเขียว #35d413 บนผิวการ์ดเกือบดำ #0b1408
// ตัวอักษรเนื้อความ #e9f0dd (hover ยกผิวขึ้นเป็น #101a0b ขอบเขียวสว่าง #5df53a และ
// ตัวอักษรเน้น #fbffe8) — ทองคู่เขียว ไม่ใช่ทองสองใบ
// ชุดทอง+โครเมียมของแบรนด์ก่อนหน้า (#fdd32a #ffe27a #ffeeb8 #c8920a #15110a
// #c2c8d0 #f2f4f7 #12100a #2a2110 #080602 #efe6d2 #fff8e1) ถูกแทนครบทุกจุดแล้ว
//
// Announcement หมุนจาก AnnouncementPremium มาเป็น Announcement2 ทั้งเว็บรอบนี้ —
// default message ของไฟล์นั้นเป็นคอปปี้ของ PGW44 แล้ว และ index ก็เรียกแบบ bare
// จึงห้ามส่ง prop message จากหน้านี้
//
// PGW44 เป็นแบรนด์สล็อตล้วน — บรีฟพูดถึงค่ายสล็อตย่อยหลายแนวในระบบเดียว เมนู
// จัดหมวดหมู่ และการรองรับมือถือ/คอมพิวเตอร์เท่านั้น ห้ามพูดถึงคาสิโนสด บาคาร่า
// เกมโต๊ะ หวย บอล เครดิตฟรี หรือฝากถอนออโต้ และห้ามลิงก์ไปเราต์ที่ถูกปิดไว้รอบนี้
// (/ตรวจหวย และ /แนวทาง)
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 154
const pageDescription = "ทางเข้า PGW44 เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ เพื่อเลือกเกมสล็อตจากค่ายย่อยหลายแนวในระบบเดียว รองรับทั้งมือถือและคอมพิวเตอร์ตลอดทั้งวัน";

const graph = pageGraph(Astro, {
  name: "ทางเข้า PGW44 เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ทางเข้า PGW44 เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า PGW44 เว็บหลัก" as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ PGW44"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#35d413]/70 bg-[#0b1408] px-6 py-4 shadow-[0_10px_30px_rgba(3,6,2,0.85)] transition-all duration-300 hover:scale-105 hover:border-[#5df53a] hover:bg-[#101a0b] hover:shadow-[0_15px_40px_rgba(53,212,19,0.30)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#35d413]/28 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#e9f0dd] transition-colors group-hover:text-[#fbffe8]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#e9f0dd] transition-colors group-hover:text-[#fbffe8]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก PGW44"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fff89a]/70 bg-gradient-to-r from-[#fde90e] via-[#f5c518] to-[#35d413] px-6 py-4 shadow-[0_10px_30px_rgba(253,233,14,0.40)] transition-all duration-300 hover:scale-105 hover:border-[#5df53a] hover:shadow-[0_15px_40px_rgba(53,212,19,0.30)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#fff89a]/30 to-transparent"></div>

          <svg class="h-9 w-9 text-[#10160a]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#10160a]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
