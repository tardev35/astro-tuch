---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
// Heading inventory for this page must stay h1x1, h2x0, h3x0.
//
// This route stays OUT of the navbar menu on purpose while the cta toggle is on
// (/login and /register are menu entries themselves), but it is still routed,
// still indexed and still linked from the footer. Do not add a nav link and do
// not delete the page.
//
// Two button tiers on the KINGDOM66 palette (ทองราชวงศ์บนดำ ตามโลโก้ที่คำว่า KINGDOM
// เป็นทองสลักและเลข 66 เป็นทองสว่าง รอบนี้ไม่มีเฉดโครเมียมเย็น เฉดที่สองเป็นแพลตินัม
// ครีมอุ่น #efe6cf แทน): สมัครสมาชิก คือแอ็กชันหลัก จึงได้
// พื้นไล่ทองเต็มใบ (#f2d683 → #e6bf4e → #5c4113) ตัวอักษรเกือบดำ #151109 เพราะ
// ตัวหนังสือบนพื้นทองต้องเป็นสีเข้ม ห้ามใช้ขาว ส่วน เข้าสู่ระบบ เป็นแอ็กชันรอง จึงเป็น
// เส้นขอบทองแบรนด์ #e6bf4e บนผิวการ์ดเกือบดำ #151109 ตัวอักษรเนื้อความ #ebe3d3
// (hover ยกผิวขึ้นเป็น #241c13 ขอบทองสว่าง #f2d683 และตัวอักษรเน้น #fdf6e0) —
// ชุดทอง-โครเมียมของ UWIN33 รอบก่อน (#e0b429 #fbd564 #7a5407 #dfe4ec #161106
// #26200e #ece6d8 #fff8e6 #080602) ถูกแทนครบทุกจุดแล้ว
//
// Announcement รอบนี้หมุนจาก AnnouncementPremium มาเป็น AnnouncementCyber ทั้งเว็บ —
// default message ของ AnnouncementCyber เป็นคอปปี้ของ KINGDOM66 แล้ว และ index ก็
// เรียกแบบ bare จึงห้ามส่ง prop message จากหน้านี้
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 157
const pageDescription = "ทางเข้า KINGDOM66 เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ เพื่อเข้าเล่นบาคาร่า ไพ่ สล็อต หวย บอล และคาสิโนไลฟ์สด รวมไว้ในบัญชีเดียวตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  name: "ทางเข้า KINGDOM66 เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ทางเข้า KINGDOM66 เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า KINGDOM66 เว็บหลัก" as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ KINGDOM66"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#e6bf4e]/70 bg-[#151109] px-6 py-4 shadow-[0_10px_30px_rgba(5,4,3,0.85)] transition-all duration-300 hover:scale-105 hover:border-[#f2d683] hover:bg-[#241c13] hover:shadow-[0_15px_40px_rgba(230,191,78,0.45)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#e6bf4e]/30 to-transparent"></div>

          <svg class="h-9 w-9 text-[#ebe3d3] transition-colors group-hover:text-[#fdf6e0]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#ebe3d3] transition-colors group-hover:text-[#fdf6e0]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก KINGDOM66"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f2d683]/70 bg-gradient-to-r from-[#f2d683] via-[#e6bf4e] to-[#5c4113] px-6 py-4 shadow-[0_10px_30px_rgba(230,191,78,0.40)] transition-all duration-300 hover:scale-105 hover:border-[#efe6cf] hover:shadow-[0_15px_40px_rgba(239,230,207,0.35)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#efe6cf]/30 to-transparent"></div>

          <svg class="h-9 w-9 text-[#151109]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#151109]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
