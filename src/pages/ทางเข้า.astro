---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
// Heading inventory for this page must stay h1x1, h2x0, h3x0.
//
// This route stays OUT of the navbar menu on purpose while the cta toggle is on
// (/login and /register are menu entries themselves), but it is still routed,
// still indexed and still linked from the footer. Do not add a nav link and do
// not delete the page.
//
// Two button tiers on the BRAZIL999 palette (เขียว + เงินโครเมียมบนดำ ตามโลโก้ที่
// คำว่า BRAZIL เป็นตัวอักษรเงินโครเมียมและเลข 999 เป็นเขียวสด ทองเป็นแอ็กเซนต์ที่สาม
// ใช้เฉพาะจุดเล็ก ๆ ห้ามนำหน้า): สมัครสมาชิก คือแอ็กชันหลัก จึงได้พื้นไล่เขียวเต็มใบ
// (#b6ff9c → #22c55e → #0a6b18) ตัวอักษรเขียวเข้มสุด #04380c เพราะตัวหนังสือบน
// พื้นเขียวสว่างต้องเป็นสีเข้ม ห้ามใช้ขาว ส่วน เข้าสู่ระบบ เป็นแอ็กชันรอง จึงเป็นฝั่ง
// "BRAZIL" ของโลโก้ — เส้นขอบเงินโครเมียม #aab4bf บนผิวการ์ดเกือบดำ #0a1a0c
// ตัวอักษรเนื้อความ #dfeadd (hover ยกผิวขึ้นเป็น #123a18 ขอบเงินสว่าง #f1f5f9 และ
// ตัวอักษรเน้น #f4fbf2) — เขียวคู่โครเมียม ไม่ใช่เขียวสองใบ
//
// Announcement หมุนมาเป็น Announcement2 ทั้งเว็บรอบนี้ — default message ของไฟล์
// นั้นเป็นคอปปี้ของ BRAZIL999 แล้ว และ index ก็เรียกแบบ bare จึงห้ามส่ง prop
// message จากหน้านี้
//
// BRAZIL999 เป็นแบรนด์คาสิโน — คำศัพท์เฉพาะหมวดของแบรนด์ก่อนหน้าห้ามหลงเหลือ
// (ดู brand-spec §2 และ §4) และห้ามลิงก์ไปเราต์ที่ถูกปิดไว้ใน src/pages-disabled
// รอบนี้ (/ตรวจหวย และ /แนวทาง)
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 152
const pageDescription = "ทางเข้า BRAZIL999 เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ เพื่อเข้าใช้งานเกมคาสิโนออนไลน์จากบริษัทโดยตรงในบัญชีเดียว ใช้งานได้ตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  name: "ทางเข้า BRAZIL999 เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ทางเข้า BRAZIL999 เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า BRAZIL999 เว็บหลัก" as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ BRAZIL999"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#aab4bf]/70 bg-[#0a1a0c] px-6 py-4 shadow-[0_10px_30px_rgba(4,10,5,0.85)] transition-all duration-300 hover:scale-105 hover:border-[#f1f5f9] hover:bg-[#123a18] hover:shadow-[0_15px_40px_rgba(170,180,191,0.28)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#aab4bf]/28 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#dfeadd] transition-colors group-hover:text-[#f4fbf2]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#dfeadd] transition-colors group-hover:text-[#f4fbf2]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก BRAZIL999"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#7cf25c]/70 bg-gradient-to-r from-[#b6ff9c] via-[#22c55e] to-[#0a6b18] px-6 py-4 shadow-[0_10px_30px_rgba(34,197,94,0.40)] transition-all duration-300 hover:scale-105 hover:border-[#aab4bf] hover:shadow-[0_15px_40px_rgba(170,180,191,0.28)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#f1f5f9]/30 to-transparent"></div>

          <svg class="h-9 w-9 text-[#04380c]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#04380c]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
