---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// Button page, not an article: the brief gives this route no body at all —
// รอบนี้บรีฟ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES เลย ทุกย่อหน้าที่เคยอยู่
// บนหน้านี้จึงเป็นของที่รีแบรนด์รอบก่อนๆ คิดขึ้นเอง ไม่ใช่ของบรีฟ
// ทั้งหน้ามีแค่ชื่อเรื่องจาก ContentBox แล้วต่อด้วยปุ่มสองปุ่ม
// ห้ามเขียนหัวข้อย่อยหรือย่อหน้าอธิบายใต้ชื่อเรื่อง — ไม่มีรายการ "ตรวจ N จุดก่อน
// ล็อกอิน" และไม่มีประโยคเตือนเรื่อง PIN/OTP ไม่ว่าคอปปี้นั้นจะเขียนดีแค่ไหน
//
// The <h1> names what the page IS ("ทางเข้า <brand> เว็บหลัก"), not what an
// article on it would have argued — a title that previews a body reads as a
// broken promise once the body is gone, and is the line most likely to tempt
// the next rebrand into writing it back.
//
// cta toggle รอบนี้เปิด: /login และ /register เป็น button page ที่ index ได้
// หน้านี้จึงถูกถอดออกจากเมนูนาวบาร์ตามกติกา (เพราะเป็นลิงก์ที่สามไปที่เดียวกัน)
// แต่ยัง route และ index อยู่ และฟุตเตอร์ยังลิงก์มาที่นี่ — ห้ามลบไฟล์นี้ และห้ามย้าย
// ไป src/pages-disabled/
//
// แบรนด์รอบนี้ (ถอนชัวร์168, รอบ **ชมพูบับเบิลกัมนำ ทองเนยเป็นฮิวที่สอง พลัมเข้ม
// ไม่เคยถือตัวอักษร บนดำสนิท** 2026-10-18, brand-spec §2): โลโก้คือ **แมวการ์ตูน
// สีขาว-ชมพู** หน้ายิ้มหลับตา นั่งคู่กับมือถือจอชมพูที่มีลูกศรดาวน์โหลดและปึกแบงก์
// ชมพู อยู่เหนือคำว่า "ถอน" ตัวอักษรไทยหนาสามมิติ **สีทองเนยตัดขอบชมพู** ต่อด้วย
// "ชัวร์168" ตัวอักษรสามมิติ **สีชมพูบับเบิลกัมตัดขอบทอง** ล้อมด้วยหัวใจชมพูและ
// ประกายดาวทอง แบนเนอร์เป็นฉากพื้นดำที่มีหญิงสาวผมเงินประดับดอกซากุระชมพู
// สวมชุดชมพูปักทอง ถือเหรียญบิตคอยน์ทอง ข้างมือถือที่ขึ้นเครื่องหมายถูกในวงกลม
// ชมพูพร้อมคำว่า ถอนสำเร็จ —
// **ฮิวนำของรอบนี้คือชมพูบับเบิลกัม #fa63b9 ทองเนย #ffd84d เป็นฮิวที่สอง**
// พื้นเพจจาก bg.json รอบนี้เป็น {"mode":"color","color":"#000000"} = ดำสนิท
// ชั้นผิว: ยก #2b0f20 (= การ์ด ContentBox) / กลาง #1a0914 / จม #0d040a / พื้น #000000
// พลัมเข้ม #6d0b3f · ทองลึก #6b4708 (สองตัวนี้ห้ามถือตัวอักษรทุกขนาด)
// ตัวที่ถือตัวอักษรได้: ทองเนย #ffd84d (12.7:1) · ชมพูอ่อน #ffb3de (10.7:1) ·
// ชมพูบับเบิลกัม #fa63b9 (7.7:1 บนดำ) ·
// เนื้อความ #fdeaf5 (= BRAND_TEXT ที่การ์ด ContentBox ตั้งให้แล้ว) ·
// หมึกบนพื้นถมชมพู #2a0617 (7.0:1 บน #fa63b9)
//
// ขั้วของปุ่มตามสเปก (พื้นสว่าง = หมึกเข้ม · พื้นเข้ม = หมึกสว่าง):
// สมัครสมาชิก = แอ็กชันหลัก ถม **ชมพูไล่เฉด** #ffb3de → #fa63b9 ขอบ #6d0b3f
// บนหมึกเข้ม #2a0617
// เข้าสู่ระบบ = แอ็กชันรอง จมลงจากการ์ดด้วยชั้น #1a0914 → #0d040a
// ขอบ **ทองเนย** #ffd84d/55 บนตัวอักษร **ทองเนย** #ffd84d — hover ยกขอบเป็น
// #ffd84d เต็ม · รอบก่อนขั้วกลับกัน (ปุ่มหลักถมทอง ปุ่มรองขอบชมพู) รอบนี้ชมพู
// ขึ้นนำตามอาร์ตเวิร์ก ซึ่งคือสิ่งที่แยกรอบนี้ออกจากรอบก่อนจริงๆ
// ⚠️ ห้ามกลับด้าน: พื้นถมชมพูต้องใช้หมึก #2a0617 เสมอ ห้ามขาวหรือครีม ·
// #6d0b3f #6b4708 ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่เส้นขอบ ออรา พื้นถม และเงา —
// ออราในไฟล์นี้ใช้ rgba(250,99,185,α) และ rgba(255,216,77,α) เท่านั้น นอกจากเงาดำล้วน
// ⚠️ กับดักรอบนี้มีสองชั้นคือ **ชมพู** และ **ทอง** เพราะรอบที่แล้วก็เป็นทอง+ชมพู
// บนดำเหมือนกัน "มีทอง/มีชมพูอยู่แล้ว" จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้
// ชมพูรอบนี้คือ #fa63b9 (250,99,185) ทองรอบนี้คือ #ffd84d (255,216,77)
// ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive — ไม่เทียบด้วยตา
// และไม่เทียบด้วยตระกูลสี
// และรอบนี้ **ไม่มีม่วง ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว ไม่มีส้ม ไม่มีเงิน/โครเมียม
// ไม่มีโรสโกลด์ ไม่มีแดงชาด**
//
// Announcement หมุนมาเป็น Announcement6 ทั้งเว็บรอบนี้ (brand-spec §3 —
// รอบก่อนใช้ Announcement3 จึงหมุนออก) default message ของไฟล์นั้นเป็นคอปปี้
// ของแบรนด์นี้แล้ว และทุกหน้าเรียกแบบ bare จึงห้ามส่ง prop message จากหน้านี้
// ไม่งั้นตัววิ่งจะไม่ตรงกับ index.astro
//
// ⚠️ แบรนด์นี้เป็น **เว็บสล็อตล้วน** ที่มีแกนเรื่อง **ความง่ายในการถอนเงิน**
// ตามบรีฟรอบนี้ — ไม่ใช่หมวดอื่นใดทั้งสิ้น สองหน้าของหมวดลอตเตอรี park อยู่ใน
// src/pages-disabled/ จึงไม่มี route และลิงก์ค้างจะเป็น href ตายที่ทำให้บิลด์แดง
// คำที่ห้ามหลงเหลือทั้งหมดอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep
// หาคำของแบรนด์เก่าเจอ false positive — แบรนด์ก่อนขายตัวเองด้วยวลีที่บรีฟรอบนี้
// ไม่มีเลยสักคำ
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกมแม้แต่ค่ายเดียว** จึงห้ามเขียนชื่อค่ายใดๆ
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 100% · 3 ขั้นตอน · 24 ชม. ·
// หลักแสนยูสต่อวัน ห้ามแต่งชื่อธนาคาร เลขใบอนุญาต หน่วยงานกำกับ ค่า RTP
// ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีใดๆ (บรีฟรอบนี้ไม่ได้เอ่ยปีไว้เลย) — หน้านี้มี
// โควตาเป็นปุ่มสองปุ่มเท่านั้น
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้ไม่มี UTF-8 locale จึงนับเป็นไบต์ = เกินจริงราว 3 เท่า)
// หน้านี้ยาว 160
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ทำให้ตัวนับเห็นเป็น 5 อักขระ
const pageDescription = `ทางเข้า ${BRAND_NAME} เว็บหลัก รวมเมนูเข้าสู่ระบบและสมัครสมาชิกของเว็บสล็อตฐานหลักถอนง่าย ได้เงินจริง ไว้ในหน้าเดียว กดเลือกเมนูที่ต้องการได้ทันที ตลอด 24 ชั่วโมง`;

const graph = pageGraph(Astro, {
  name: `ทางเข้า ${BRAND_NAME} เว็บหลัก`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title={`ทางเข้า ${BRAND_NAME} เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ทางเข้า ${BRAND_NAME} เว็บหลัก`} as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ffd84d]/55 bg-gradient-to-b from-[#1a0914] to-[#0d040a] px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.6)] transition-all duration-300 hover:scale-105 hover:border-[#ffd84d] hover:shadow-[0_15px_40px_rgba(255,216,77,0.45)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ffd84d]/20 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#ffd84d] transition-colors group-hover:text-[#ffb3de]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#ffd84d]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#6d0b3f] bg-gradient-to-b from-[#ffb3de] to-[#fa63b9] px-6 py-4 shadow-[0_10px_30px_rgba(250,99,185,0.4)] transition-all duration-300 hover:scale-105 hover:border-[#2a0617] hover:shadow-[0_15px_40px_rgba(250,99,185,0.6)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ffb3de]/70 to-transparent"></div>

          <svg class="h-9 w-9 text-[#2a0617]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-black tracking-wide text-[#2a0617]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
