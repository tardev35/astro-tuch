---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
//
// BUTTON PAGE ไม่ใช่บทความ — บรีฟรอบนี้ (src/assets/content.txt) จบที่บรรทัด 29
// และ **ไม่มีส่วน SUB-PAGES เลย** จึงไม่เคยให้ body กับหน้านี้ ทุกย่อหน้าและทุก
// หัวข้อย่อยที่เคยอยู่บนหน้านี้คือของที่รีแบรนด์รอบก่อนๆ คิดขึ้นเอง แล้วรอบถัดมา
// ก็เขียนทับด้วยความเชื่อว่ารอบก่อนมีเหตุผล — ไม่มี
// ทั้งหน้ามีแค่ชื่อเรื่องจาก ContentBox แล้วต่อด้วยปุ่มสองปุ่ม
// **ห้ามเขียนหัวข้อย่อยหรือย่อหน้าอธิบายใต้ชื่อเรื่อง** — ไม่มีรายการ "ตรวจ N จุด
// ก่อนล็อกอิน" ไม่มีประโยคเตือนเรื่องรหัสผ่าน/OTP ไม่ว่าคอปปี้นั้นจะเขียนดีแค่ไหน
// (ประโยคกำกับเรื่องรหัสผ่าน/OTP ของบรีฟอยู่บน index.astro ซึ่งเป็นบทความจริง
// ไม่ใช่บนหน้าปุ่ม) รอบนี้ลบคอปปี้ชุด "ตรวจ 4 จุดก่อนล็อกอิน" ออกแล้ว
//
// h1 บอกว่า "หน้านี้คืออะไร" ("ทางเข้า <แบรนด์> เว็บหลัก") ไม่ใช่บอกว่าบทความบน
// หน้านี้จะเถียงอะไร — ชื่อเรื่องที่โฆษณาเนื้อหาไว้คือบรรทัดที่ล่อให้รีแบรนด์รอบ
// ถัดไปเขียน body กลับมามากที่สุด
//
// cta toggle รอบนี้เปิด: /login และ /register เป็น button page ที่ index ได้
// หน้านี้จึง **ไม่อยู่ในเมนูนาวบาร์โดยตั้งใจ** แต่ยัง route และ index อยู่ และ
// footer ที่ใช้งานอยู่ยังลิงก์มาที่นี่ — ห้ามลบไฟล์นี้ ห้ามย้ายไป
// src/pages-disabled/ และห้ามเติมลิงก์กลับเข้าเมนู
//
// ───────────────────────────────────────────────────────────────────────────
// 🚨 แกนของแบรนด์รอบนี้คือ **เว็บหวย/ลอตโต้ออนไลน์** (.claude/brand-spec-lotto189.md
// §0) ไม่ใช่หมวดเกมคาสิโนเหมือนสองรอบก่อน คำนิยามตัวเองของแบรนด์ก่อนๆ ห้ามเหลือ
// ที่ไหนทั้งสิ้น รายการคำที่ห้ามใช้อยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้
// sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// ⚠️ **บรีฟรอบนี้ไม่มีหมวดโปรโมชั่น ไม่มีธนาคาร/วอลเลท และไม่มีการฝากถอนเลย** —
// หน้านี้ไม่เอ่ยถึงเลยสักคำ
// ⚠️ route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ทดลองเล่น · /ตรวจหวย · /แนวทาง · /about-us · /contact-us · /terms · /privacy ·
// /line — **ลิงก์ไป route ที่ไม่มีจริง = build แดง** แต่หน้านี้มีโควตาเป็นปุ่มสองปุ่ม
// จึงไม่ลิงก์ไปที่อื่นเพิ่มอยู่แล้ว
// ⚠️ ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 2 ตัว 100 · 3 ตัว 1,000 · 3 ขั้นตอน · 24ชม. —
// หน้านี้มีโควตาเป็นปุ่มสองปุ่ม จึงไม่อ้างตัวเลขใดเลย
//
// พาเลตรอบนี้อยู่ใน .claude/brand-spec-lotto189.md §2
// 🚨 **รอบนี้เนื้อหาเป็นผิวสว่าง โครมเป็นผิวเข้ม (ทิศเดียวกับรอบก่อน) แต่ฮิว
// คนละตระกูลสิ้นเชิง** bg.json = {"mode":"color","color":"#fff0f0"} =
// **ขาวอมชมพูจาง** (รอบก่อนเป็นครีมอมงาช้าง — ค่ามาจากไฟล์ ห้ามเดาว่าเท่าเดิม)
// การ์ด ContentBox จึงเป็นผิว #ffffff บนหมึก #25090f (= BRAND_TEXT, 18.7:1)
// **ห้าม "แก้" การ์ดกลับไปเป็นผิวมืดตามโครม** — การ์ดมืดบนหมึกนี้ = ตัวอักษรหายไปเลย
//
// ขั้วของปุ่มบนการ์ดผิวขาว (ตรงกับคู่ปุ่มที่ล็อกไว้ใน brand-spec §2):
// สมัครสมาชิก = PRIMARY พื้นไล่เฉดแดงเลือดนก #8a0412 -> #b00718 -> #d61023
//   บนหมึก **ขาว #ffffff** (10.4 / 7.3 / 5.3:1 ผ่านทุกสต็อป) — ปุ่ม CTA หลัก
//   ⚠️⚠️ **ห้ามลากสต็อปขึ้นไปถึง ff2436 หรือ e9b53c** — ขาวบนสองค่านั้นตก AA
//   ทั้งคู่ สองค่านั้นเป็นขอบ/ออรา/พื้นถมบนโครมเข้มเท่านั้น
// เข้าสู่ระบบ = SECONDARY พื้นไล่เฉดขาว #ffffff -> #ffe4e6 บนหมึก
//   **แดงเลือดนกจม #25090f** (18.7 / 16.4:1) ขอบ #a8333f คือสิ่งที่แยกปุ่มนี้ออก
//   จากผิวการ์ดขาว — ห้ามถอดขอบออก
// ⚠️⚠️ **fff0f0 ffe4e6 ffd4d7 f5b9bd c3ccd6 ff2436 e9b53c ห้ามถือตัวอักษรบนผิว
//   สว่างเด็ดขาด** เป็นพื้นถม/ขอบ/ออราเท่านั้น และ a8333f เป็น **เส้น/ขอบ**
//   เท่านั้น · ที่ถือตัวอักษรได้บนผิวสว่างชุดนี้คือ #25090f (18.7:1) ·
//   #6e3b44 (8.8:1) · #b00718 (7.3:1) · #c1071b (6.6:1) · #8a0412 (10.4:1) ·
//   #8f6310 (5.3:1) · #d61023 (5.3:1 คู่กับหมึกขาว)
// ⚠️⚠️ **24060c 3d0d16 120307 7e1221 ffeaea f0bcbc เป็นค่าของผิวโครมเข้ม
//   เท่านั้น ห้ามหลุดเข้ามาในไฟล์นี้**
// ⚠️⚠️ **ฮิวนำของรอบนี้คือแดงเลือดนกบนผิวสว่าง** — เวิร์ดมาร์กผิวโครเมียมเงิน
//   ตัดขอบแดง ลูกบอลหวยสีขาวพิมพ์เลข โพยหวยกับปากกาสีทอง และอาร์มแชร์ขาวขอบทอง
//   ในอาร์ตเวิร์กเป็นวัตถุในภาพ ไม่ใช่สี UI · พื้นเพจมาจาก bg.json เท่านั้น
// ⚠️ ปุ่มของ Navfoot อยู่บนแถบโครม **ผิวเข้ม** คนละโซนกับปุ่มบนการ์ดสว่างนี้
// **ห้ามลอกคลาสของ Navfoot มาวางบนการ์ด**
// ออราในไฟล์นี้ใช้ rgba(138,4,18,α) · rgba(176,7,24,α) · rgba(193,7,27,α) ·
// rgba(214,16,35,α) เท่านั้น
//
// ⚠️⚠️ กับดักรอบนี้คือ **แดง/ทอง/ครีมเป็นตระกูลที่ผ่าน template นี้มาแล้วสิบกว่าเจ้า
// และเป็นตระกูลเดียวกับแบรนด์เมื่อสามรอบก่อนเป๊ะ** การเจอแดง/ทอง/ครีมในไฟล์จึง
// **ไม่พิสูจน์ว่าเป็นค่าของรอบนี้** ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน
// brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ
// false positive
// รอบนี้ **ไม่มีม่วง/ฟ้า/ไซแอน/แมเจนต้า/ชมพูบับเบิลกัม/ส้มเพลิง/เขียวแบรนด์**
// เลยสักเฉด
//
// Announcement รอบนี้หมุนมาเป็นตัวท้ายชื่อ Huay ของตระกูล ทั้งเว็บ (brand-spec §3 —
// รอบก่อนใช้ตัวเลข 2 จึงหมุนออก · เขียนชื่อไฟล์แบบไม่มีเครื่องหมายคำพูดโดยตั้งใจ
// เพราะ tools/gen-tw-sources.mjs นับ literal ที่มีเครื่องหมายคำพูดว่าเป็นการ import
// จริง คอมเมนต์จึงทำให้ variant เก่าหลุดเข้า Tailwind scan แล้วสีของแบรนด์ก่อนขึ้น
// stylesheet) orchestrator เป็นเจ้าของ default message ของไฟล์นั้น ทุกหน้าเรียก
// แบบ bare จึง **ห้ามส่ง prop message** จากหน้านี้ ไม่งั้นตัววิ่งจะพูดคนละเรื่อง
// กับหน้าอื่น
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้ไม่มี UTF-8 locale จึงนับเป็นไบต์ = เกินจริงราว 3 เท่า)
// หน้านี้ยาว 157 ด้วยชื่อแบรนด์ 8 โค้ดพอยต์ของรอบนี้ (รอบก่อนยาว 8 เช่นกัน แต่ต้อง
// นับใหม่ทุกรอบ ห้ามสืบทอดความยาวข้ามแบรนด์) ส่วนที่ไม่ใช่ชื่อแบรนด์ยาว 149 →
// รับชื่อแบรนด์ได้ 1–11 อักขระ ถ้ารอบหน้าชื่อยาวกว่านั้นต้องตัดข้อความ
// ไม่ใช่ปล่อยผ่าน
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ทำให้ตัวนับเห็นเป็น 5 อักขระ
// ประโยคนี้บรรยาย "สิ่งที่หน้านี้มี" เท่านั้น — หน้านี้มีแค่ปุ่มสองปุ่ม ไม่มีปุ่ม LINE
// จึงไม่สัญญาช่องทางแชตไว้ใน description
const pageDescription = `ทางเข้า ${BRAND_NAME} เว็บหลัก รวมปุ่มเข้าสู่ระบบและสมัครสมาชิกไว้ในหน้าเดียว สำหรับผู้ที่ต้องการแทงหวยออนไลน์ ควรตรวจสอบที่อยู่เว็บไซต์ทางการให้ถูกต้องก่อนใช้งาน`;

const graph = pageGraph(Astro, {
  name: `ทางเข้า ${BRAND_NAME} เว็บหลัก`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title={`ทางเข้า ${BRAND_NAME} เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ทางเข้า ${BRAND_NAME} เว็บหลัก`} as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="group mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 rounded-xl border-2 border-[#a8333f] bg-gradient-to-b from-[#ffffff] to-[#ffe4e6] px-6 py-4 shadow-[0_8px_24px_rgba(138,4,18,0.18)] transition-all duration-300 hover:scale-105 hover:border-[#b00718] hover:shadow-[0_14px_36px_rgba(193,7,27,0.32)]">
          <svg class="h-9 w-9 text-[#25090f]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#25090f]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border-2 border-[#8a0412] bg-gradient-to-b from-[#8a0412] via-[#b00718] to-[#d61023] px-6 py-4 shadow-[0_10px_30px_rgba(138,4,18,0.35)] transition-all duration-300 hover:scale-105 hover:border-[#d61023] hover:shadow-[0_15px_40px_rgba(214,16,35,0.42)]">
          <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-white/10 to-transparent"></span>

          <svg class="h-9 w-9 text-white" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-black tracking-wide text-white">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
