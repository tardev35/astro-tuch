---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// Button page, not an article: the brief gives this route no body at all —
// รอบนี้บรีฟ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES เลย จบที่บรรทัด 23
// ทุกย่อหน้าที่เคยอยู่บนหน้านี้ในอดีตจึงเป็นของที่รีแบรนด์รอบก่อนๆ คิดขึ้นเอง
// ทั้งหน้ามีแค่ชื่อเรื่องจาก ContentBox แล้วต่อด้วยปุ่มสองปุ่ม
// ห้ามเขียนหัวข้อย่อยหรือย่อหน้าอธิบายใต้ชื่อเรื่อง — ไม่มีรายการ "ตรวจ N จุดก่อน
// ล็อกอิน" และไม่มีประโยคเตือนเรื่องรหัสผ่าน/OTP ไม่ว่าคอปปี้นั้นจะเขียนดีแค่ไหน
//
// The <h1> names what the page IS ("ทางเข้า <brand> เว็บหลัก"), not what an
// article on it would have argued — a title that previews a body reads as a
// broken promise once the body is gone, and is the line most likely to tempt
// the next rebrand into writing it back.
//
// cta toggle รอบนี้เปิด: /login และ /register เป็น button page ที่ index ได้
// หน้านี้จึงไม่อยู่ในเมนูนาวบาร์ (brand-spec §9) แต่ยัง route และ index อยู่
// และฟุตเตอร์ยังลิงก์มาที่นี่ — ห้ามลบไฟล์นี้ และห้ามย้ายไป src/pages-disabled/
//
// แบรนด์รอบนี้ (นินจา168, รอบ **ฟ้าไซยานนำ · เหลืองมะนาวรอง · บนพื้นดำสนิท**
// 2026-10-19, brand-spec §2): โลโก้คือ **นินจาการ์ตูนชุดดำ** ผูกผ้าคาดหัวฟ้า-ขาว
// มีดาวน้ำเงิน ขยิบตา ถือ **ดาวกระจาย (ชูริเคน) สีฟ้า** มีผ้าพันคอฟ้าปลิว ยืนข้างคำว่า
// "นินจา" ตัวอักษรไทยหนาสามมิติ **สีเหลืองทอง** ต่อด้วย "168" **สีฟ้าบับเบิลผิวมันวาว**
// ล้อมด้วยประกายดาวทองและชูริเคนฟ้า แบนเนอร์เป็นฉาก **พื้นขาว-ฟ้าน้ำแข็ง** ที่มีนินจา
// ตัวเดียวกัน เหรียญทอง หัวใจฟ้า ตู้สล็อต 777 และหญิงสาวผมบลอนด์เงินชุดลูกไม้ขาว-ฟ้า
// ชี้นิ้วมาทางผู้ชม —
// **ฮิวนำของรอบนี้คือฟ้าไซยาน #32bcfb เหลืองมะนาว #fef54b เป็นฮิวที่สอง**
// พื้นเพจจาก bg.json รอบนี้เป็น {"mode":"color","color":"#000000"} = ดำสนิท
// ชั้นผิว: ยก #0c2a3d (= การ์ด ContentBox) / กลาง #071a28 / จม #030e16 / พื้น #000000
// น้ำเงินลึก #07335f · ทองลึก #6b5c10 (สองตัวนี้ห้ามถือตัวอักษรทุกขนาด)
// ตัวที่ถือตัวอักษรได้: ฟ้าน้ำแข็ง #a9e9ff (11.3:1) · เหลืองมะนาว #fef54b (12.7:1) ·
// ฟ้าแบรนด์ #32bcfb (7.1:1) ·
// เนื้อความ #dceefc (= BRAND_TEXT ที่การ์ด ContentBox ตั้งให้แล้ว) ·
// หมึกบนพื้นถมฟ้า #041019 (8.9:1 บน #32bcfb · 13.2:1 บน #a9e9ff)
//
// ขั้วของปุ่มตามสเปก (พื้นสว่าง = หมึกเข้ม · พื้นเข้ม = หมึกสว่าง) และตรงกับคู่ปุ่ม
// ของ Navfoot ที่ขึ้นทุกหน้าบนมือถือ:
// สมัครสมาชิก = แอ็กชันหลัก ถม **ฟ้าไล่เฉด** #a9e9ff → #32bcfb ขอบ #07335f
// บนหมึกเข้ม #041019
// เข้าสู่ระบบ = แอ็กชันรอง จมลงจากการ์ดด้วยชั้น #071a28 → #030e16
// ขอบ **เหลืองมะนาว** #fef54b/55 บนตัวอักษร **เหลืองมะนาว** #fef54b
// — hover ยกขอบเป็น #fef54b เต็ม
// ⚠️ ห้ามกลับด้าน: พื้นถมฟ้าต้องใช้หมึก #041019 เสมอ ห้ามขาวหรือครีม ·
// #07335f #6b5c10 ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่เส้นขอบ ออรา พื้นถม และเงา —
// ออราในไฟล์นี้ใช้ rgba(50,188,251,α) และ rgba(254,245,75,α) เท่านั้น นอกจากเงาดำล้วน
// ⚠️ กับดักรอบนี้คือ **ฟ้า** และ **เหลือง/ทอง** พร้อมกัน เพราะรอบที่แล้ว
// (สบายเบท168) ก็ฟ้านำ + ทองรองเหมือนกันทั้งชุด การเจอ "ฟ้า" หรือ "ทอง" ในไฟล์นี้
// จึง **ไม่พิสูจน์ว่าเป็นค่าของรอบนี้** ฟ้ารอบนี้คือ #32bcfb (50,188,251) และ
// เหลืองรอบนี้คือ #fef54b (254,245,75) ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน
// brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ
// false positive — ไม่เทียบด้วยตา และไม่เทียบด้วยตระกูลสี
// และรอบนี้ **ไม่มีชมพู ไม่มีแดง ไม่มีม่วง ไม่มีเขียว ไม่มีส้ม ไม่มีเงิน/โครเมียม
// ไม่มีโรสโกลด์**
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ (brand-spec §3 —
// รอบก่อนใช้ Announcement2 จึงหมุนออก) default message ของไฟล์นั้นเป็นคอปปี้
// ของแบรนด์นี้แล้ว และทุกหน้าเรียกแบบ bare จึงห้ามส่ง prop message จากหน้านี้
// ไม่งั้นตัววิ่งจะไม่ตรงกับ index.astro
//
// ⚠️ แบรนด์นี้เป็น **เว็บสล็อตล้วน** ที่บรีฟพูดถึงแค่โปรโมชั่นแนะนำเพื่อน 0.8%
// คืนยอดเสีย 0.3% ระบบฝากถอนผ่านธนาคารและวอลเลท และ LINE Official — ไม่ใช่คาสิโน
// ไม่มีกีฬา และไม่ใช่เว็บหวย สองหน้าของหมวดลอตเตอรี park อยู่ใน src/pages-disabled/
// จึงไม่มี route และลิงก์ค้างจะเป็น href ตายที่ทำให้บิลด์แดง คำที่ห้ามหลงเหลือทั้งหมด
// อยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำของแบรนด์เก่าเจอ false
// positive — รอบก่อนขายตัวเองด้วยวลีที่บรีฟรอบนี้ไม่มีเลยสักคำ
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกมแม้แต่ค่ายเดียว** จึงห้ามเขียนชื่อค่ายใดๆ
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 24ชม. ห้ามแต่งชื่อธนาคาร
// เลขใบอนุญาต หน่วยงานกำกับ ค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีใดๆ —
// หน้านี้มีโควตาเป็นปุ่มสองปุ่มเท่านั้น
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้ไม่มี UTF-8 locale จึงนับเป็นไบต์ = เกินจริงราว 3 เท่า)
// หน้านี้ยาว 156
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ทำให้ตัวนับเห็นเป็น 5 อักขระ
const pageDescription = `ทางเข้า ${BRAND_NAME} เว็บหลัก รวมเมนูเข้าสู่ระบบและสมัครสมาชิกไว้ในหน้าเดียว กดเลือกเมนูที่ต้องการได้ทันที หรือสอบถามเจ้าหน้าที่ผ่าน LINE Official ได้ตลอด 24ชม.`;

const graph = pageGraph(Astro, {
  name: `ทางเข้า ${BRAND_NAME} เว็บหลัก`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title={`ทางเข้า ${BRAND_NAME} เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ทางเข้า ${BRAND_NAME} เว็บหลัก`} as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fef54b]/55 bg-gradient-to-b from-[#071a28] to-[#030e16] px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.6)] transition-all duration-300 hover:scale-105 hover:border-[#fef54b] hover:shadow-[0_15px_40px_rgba(254,245,75,0.45)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#fef54b]/20 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#fef54b] transition-colors group-hover:text-[#a9e9ff]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#fef54b]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#07335f] bg-gradient-to-b from-[#a9e9ff] to-[#32bcfb] px-6 py-4 shadow-[0_10px_30px_rgba(50,188,251,0.4)] transition-all duration-300 hover:scale-105 hover:border-[#041019] hover:shadow-[0_15px_40px_rgba(50,188,251,0.6)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#a9e9ff]/70 to-transparent"></div>

          <svg class="h-9 w-9 text-[#041019]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-black tracking-wide text-[#041019]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
