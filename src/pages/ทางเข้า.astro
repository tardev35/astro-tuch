---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
// Heading inventory for this page must stay h1x1, h2x0, h3x0.
//
// The <h1> names what the page IS ("ทางเข้า <brand> เว็บหลัก"), not what an
// article on it would have argued — a title that previews a body reads as a
// broken promise once the body is gone, and is the line most likely to tempt
// the next rebrand into writing it back.
//
// This route stays OUT of the navbar menu on purpose while the cta toggle is on
// (/login and /register are menu entries themselves), but it is still routed,
// still indexed and still linked from the footer. Do not add a nav link and do
// not delete the page.
//
// 789BETTING (รอบทองเมทัลลิกบนดำสนิท 2026-10-08, brand-spec §2): รอบนี้เป็น
// **ทองฮิวเดียวบนดำ ไม่มีสีที่สองเลย** — โลโก้เป็นเลข 789 ทองสามมิติเหนือคำว่า
// BETTING ดำบนแถบขาว งานศิลป์เป็นโถงคาสิโนดำ-ทอง เสาร่องทอง โคมระย้า ชิปดำ-ทอง
// และ bg.json เป็นดำตัน #000000 — พลิกจากชุดตรุษจีนสามสี (แดงนำ เขียวมรกตรอง
// ทองคั่น) ของ GUCCI168 รอบก่อน ปลายลึกของทองจึงรับบทที่เขียวมรกตเคยเล่น
// ทองแบรนด์ #fad354 · ทองแชมเปญ #ffe79a · ทองกลาง #ddab33 · ทองลึก #8a6410 ·
// บรอนซ์ #c9881f · ผิวการ์ด #17130a · ผิวลึก #060402 · หมึกบนพื้นทอง #0a0802
//
// ไม่มีฮิวที่สองให้แยกลำดับปุ่มสองใบนี้ ลำดับจึงสื่อด้วย **ถม vs โปร่ง** ไม่ใช่
// ความสว่างของสีเดียวสองใบ:
// สมัครสมาชิก = แอ็กชันหลัก ถม **ทองไล่เฉด** #ffe79a → #fad354 → #ddab33
// ขอบทองลึก #8a6410 บนหมึกเข้ม #0a0802 (สเปกวัดไว้ 13.5:1 ผ่าน AA สบาย)
// เข้าสู่ระบบ = แอ็กชันรอง ผิวเข้ม #17130a → #060402 ขอบทอง #fad354/55 บนหมึก
// ทองแชมเปญ #ffe79a พร้อม hover ยกขอบเป็นทองเต็ม
// ⚠️ ห้ามกลับด้าน: พื้นที่ถมทองต้องใช้หมึกเข้มเสมอ ห้ามครีมหรือขาว (สเปก §2)
// ออราด้านบนของปุ่มใช้บรอนซ์/ทองลึกเป็นปลายอุ่นของฮิวเดียวกัน rgba(201,136,31,α)
// และ rgba(250,211,84,α) ไม่มี rgba อื่นในไฟล์นี้
// ชุดแดง-เขียวมรกตของแบรนด์ก่อนถูกแทนครบแล้ว ทั้งคลาส Tailwind raw hex และ
// rgba() (ค่าเดิมอยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีแบรนด์
// เก่าเจอ false positive)
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ (รอบก่อนเป็น Announcement3)
// default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์ปัจจุบันแล้ว และทุกหน้าเรียกแบบ
// bare จึงห้ามส่ง prop message จากหน้านี้
//
// แบรนด์นี้เป็น **คาสิโนฐานเข้าหลัก** ที่รวมบาคาร่า รูเล็ต บอล หวย สล็อต และเกม
// คาสิโนตามรายการที่เปิดให้บริการไว้ในบัญชีเดียว — หวยเป็นเพียงหนึ่งหมวดในนั้น
// ไม่ใช่เว็บหวย คำของแบรนด์ก่อนทั้งชุดห้ามหลงเหลือ (รายการเต็มอยู่ใน brand-spec §4
// ไม่พิมพ์ซ้ำที่นี่) โดยเฉพาะชื่อเกมที่บรีฟรอบนี้ไม่ได้เอ่ยถึง
// บรีฟบรรทัด 4 ระบุว่าหลัง Login สมาชิกเลือกเกม ตรวจสอบเครดิต โปรโมชั่น และ
// ประวัติการเดิมพันผ่านบัญชีเดียวได้
// ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 0.3% / 0.8% / 100% / 24 ชั่วโมง
// ห้ามแต่งชื่อค่ายเกม ชื่อธนาคาร เลขใบอนุญาต หน่วยงานกำกับ ค่า RTP ยอดฝากขั้นต่ำ
// จำนวนสมาชิก หรือปีก่อตั้ง — หน้านี้มีโควตาเป็นปุ่มสองปุ่มเท่านั้น
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 157
const pageDescription = `ทางเข้า ${BRAND_NAME} เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ เพื่อใช้บัญชีเดียวเลือกเดิมพันบาคาร่า รูเล็ต บอล หวย และสล็อต ตามรายการที่เปิดให้บริการ`;

const graph = pageGraph(Astro, {
  name: `ทางเข้า ${BRAND_NAME} เว็บหลัก`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title={`ทางเข้า ${BRAND_NAME} เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ทางเข้า ${BRAND_NAME} เว็บหลัก`} as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fad354]/55 bg-gradient-to-b from-[#17130a] to-[#060402] px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.55)] transition-all duration-300 hover:scale-105 hover:border-[#fad354] hover:shadow-[0_15px_40px_rgba(250,211,84,0.40)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#c9881f]/25 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#fad354] transition-colors group-hover:text-[#ffe79a]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#ffe79a]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#8a6410] bg-gradient-to-b from-[#ffe79a] via-[#fad354] to-[#ddab33] px-6 py-4 shadow-[0_10px_30px_rgba(250,211,84,0.40)] transition-all duration-300 hover:scale-105 hover:border-[#060402] hover:shadow-[0_15px_40px_rgba(250,211,84,0.60)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ffe79a]/60 to-transparent"></div>

          <svg class="h-9 w-9 text-[#0a0802]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-black tracking-wide text-[#0a0802]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
