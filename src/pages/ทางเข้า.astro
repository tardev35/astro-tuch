---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
// Button page, not an article: the brief gives this route no body at all —
// รอบนี้บรีฟ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES เลย ทุกย่อหน้าที่เคยอยู่
// บนหน้านี้จึงเป็นของที่รีแบรนด์รอบก่อนๆ คิดขึ้นเอง ไม่ใช่ของบรีฟ
// ทั้งหน้ามีแค่ชื่อเรื่องจาก ContentBox แล้วต่อด้วยปุ่มสองปุ่ม
// ห้ามเขียนหัวข้อย่อยหรือย่อหน้าอธิบายใต้ชื่อเรื่อง — ไม่มีรายการ "ตรวจ N จุดก่อน
// ล็อกอิน" และไม่มีประโยคเตือนเรื่อง PIN/OTP ไม่ว่าคอปปี้นั้นจะเขียนดีแค่ไหน
//
// The <h1> names what the page IS ("ทางเข้า <brand> เว็บหลัก"), not what an
// article on it would have argued — a title that previews a body reads as a
// broken promise once the body is gone, and is the line most likely to tempt
// the next rebrand into writing it back.
//
// cta toggle รอบนี้เปิด: /login และ /register เป็น button page ที่ index ได้
// หน้านี้จึงถูกถอดออกจากเมนูนาวบาร์ตามกติกา (เพราะเป็นลิงก์ที่สามไปที่เดียวกัน)
// แต่ยัง route และ index อยู่ และฟุตเตอร์ยังลิงก์มาที่นี่ — ห้ามลบไฟล์นี้ และห้ามย้าย
// ไป src/pages-disabled/
//
// แบรนด์รอบนี้ (มีโชค168, รอบ **ทองนำ ชมพูบานเย็นเป็นฮิวที่สอง พลัมเข้มเป็นเงา
// บนดำสนิท** 2026-10-18, brand-spec §2): โลโก้คือ **แมวกวักนำโชค** ตัวขาว-ส้มทอง
// นั่งอยู่เหนือคำว่า "มีโชค" ที่เป็นตัวอักษรไทยหนาสามมิติ **ไล่เฉดชมพูบานเย็นไปหา
// ทอง** ต่อด้วยเลข "168" ทองสามมิติ ล้อมด้วยริบบิ้นซาตินชมพู เหรียญจีนทองรู
// สี่เหลี่ยม ทองแท่งจีน หัวใจชมพู และดอกซากุระ แบนเนอร์เป็นฉากเดียวกันที่มีหญิงสาว
// ผมเงินเกล้ามวยประดับซากุระ สวมชุดจีนชมพูปักทอง ถือเหรียญจีน —
// **ฮิวที่สองของรอบนี้คือชมพูบานเย็น #f5469f ไม่ใช่โรสโกลด์ของรอบก่อน**
// พื้นเพจจาก bg.json รอบนี้เป็น {"mode":"color","color":"#000000"} = ดำสนิท
// ชั้นผิว: ยก #24101c (= การ์ด ContentBox) / กลาง #160a12 / จม #0b0509 / พื้น #000000
// ทองลึก #7a5508 · พลัมเข้ม #8c0f52 (สองตัวนี้ห้ามถือตัวอักษรทุกขนาด)
// ตัวที่ถือตัวอักษรได้: ทองสว่าง #ffeaa0 (15.2:1) · ชมพูอ่อน #ff8dc6 (9.9:1) ·
// ทองแบรนด์ #fcd434 (11.7:1) · ชมพูบานเย็น #f5469f (6.2:1) ·
// เนื้อความ #f6e4ee (= BRAND_TEXT ที่การ์ด ContentBox ตั้งให้แล้ว) ·
// หมึกบนพื้นถมทอง #1a0612 (13.5:1 บน #fcd434)
//
// ขั้วของปุ่มตามสเปก (พื้นสว่าง = หมึกเข้ม · พื้นเข้ม = หมึกสว่าง):
// สมัครสมาชิก = แอ็กชันหลัก ถม **ทองไล่เฉด** #ffeaa0 → #fcd434 ขอบ #7a5508
// บนหมึกเข้ม #1a0612
// เข้าสู่ระบบ = แอ็กชันรอง จมลงจากการ์ดด้วยชั้น #160a12 → #0b0509
// ขอบ **ชมพูบานเย็น** #f5469f/55 บนตัวอักษร **ชมพูอ่อน** #ff8dc6 — hover ยกขอบ
// เป็น #ff8dc6 · รอบก่อนปุ่มรองเป็นขอบโรสเข้มบนตัวอักษรโรสโกลด์ รอบนี้ชมพูมาแทน
// ซึ่งคือฮิวที่แยกรอบนี้ออกจากรอบก่อนๆ
// ⚠️ ห้ามกลับด้าน: พื้นถมทองต้องใช้หมึก #1a0612 เสมอ ห้ามขาวหรือครีม ·
// #7a5508 #8c0f52 ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่เส้นขอบ ออรา พื้นถม และเงา —
// ออราในไฟล์นี้ใช้ rgba(252,212,52,α) และ rgba(245,70,159,α) เท่านั้น นอกจากเงาดำล้วน
// ⚠️ กับดักรอบนี้คือ **ทอง** เพราะแทบทุกแบรนด์ที่ผ่านไฟล์นี้มีทองอยู่ด้วย
// "มีทองอยู่แล้ว" จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้ ทองรอบนี้คือ #fcd434
// (252,212,52) ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำ
// ที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive — ไม่เทียบด้วยตา
// และไม่เทียบด้วยตระกูลสี (ชมพูก็เช่นกัน มีแบรนด์เก่าที่เป็นชมพูฮอตพิงก์มาแล้ว
// แต่คนละค่าทั้งชุด)
// และรอบนี้ **ไม่มีม่วง ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว ไม่มีส้ม ไม่มีเงินอมฟ้า
// ไม่มีโรสโกลด์ ไม่มีแดงชาด**
//
// Announcement หมุนมาเป็น Announcement3 ทั้งเว็บรอบนี้ (brand-spec §3 —
// รอบก่อนใช้ Announcement5 จึงหมุนออก) default message ของไฟล์นั้นเป็นคอปปี้
// ของแบรนด์นี้แล้ว และทุกหน้าเรียกแบบ bare จึงห้ามส่ง prop message จากหน้านี้
// ไม่งั้นตัววิ่งจะไม่ตรงกับ index.astro
//
// ⚠️ แบรนด์นี้เป็น **เว็บสล็อตล้วน ลิขสิทธิ์แท้ นำเข้าตรงจากสิงคโปร์ สามค่ายหลัก
// PG SOFT / JOKER / JILI** ตามบรีฟรอบนี้ — ไม่ใช่หมวดอื่นใดทั้งสิ้น
// สองหน้าของหมวดลอตเตอรี park อยู่ใน src/pages-disabled/ จึงไม่มี route และลิงก์ค้าง
// จะเป็น href ตายที่ทำให้บิลด์แดง คำที่ห้ามหลงเหลือทั้งหมดอยู่ใน brand-spec §6
// ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำของแบรนด์เก่าเจอ false positive —
// แบรนด์ก่อนขายตัวเองด้วยวลีที่บรีฟรอบนี้ไม่มีเลยสักคำ
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 24 ชั่วโมง · 100% · 3 ขั้นตอน ·
// 3 ค่าย ห้ามแต่งชื่อค่ายเกมอื่น ชื่อธนาคาร เลขใบอนุญาต หน่วยงานกำกับ ค่า RTP
// ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีใดๆ (บรีฟรอบนี้ไม่ได้เอ่ยปีไว้เลย) — หน้านี้มี
// โควตาเป็นปุ่มสองปุ่มเท่านั้น
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้ไม่มี UTF-8 locale จึงนับเป็นไบต์ = เกินจริงราว 3 เท่า)
// หน้านี้ยาว 159
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ทำให้ตัวนับเห็นเป็น 5 อักขระ
const pageDescription = `ทางเข้า ${BRAND_NAME} เว็บหลัก รวมเมนูเข้าสู่ระบบและสมัครสมาชิกของเว็บสล็อตลิขสิทธิ์แท้ นำเข้าตรงจากสิงคโปร์ ไว้ในหน้าเดียว กดเลือกเมนูที่ต้องการได้ทันที 24 ชั่วโมง`;

const graph = pageGraph(Astro, {
  name: `ทางเข้า ${BRAND_NAME} เว็บหลัก`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title={`ทางเข้า ${BRAND_NAME} เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ทางเข้า ${BRAND_NAME} เว็บหลัก`} as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f5469f]/55 bg-gradient-to-b from-[#160a12] to-[#0b0509] px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.6)] transition-all duration-300 hover:scale-105 hover:border-[#ff8dc6] hover:shadow-[0_15px_40px_rgba(245,70,159,0.45)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#f5469f]/20 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#ff8dc6] transition-colors group-hover:text-[#ffeaa0]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#ff8dc6]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#7a5508] bg-gradient-to-b from-[#ffeaa0] to-[#fcd434] px-6 py-4 shadow-[0_10px_30px_rgba(252,212,52,0.4)] transition-all duration-300 hover:scale-105 hover:border-[#1a0612] hover:shadow-[0_15px_40px_rgba(252,212,52,0.6)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ffeaa0]/70 to-transparent"></div>

          <svg class="h-9 w-9 text-[#1a0612]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-black tracking-wide text-[#1a0612]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
