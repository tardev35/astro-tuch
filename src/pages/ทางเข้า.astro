---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// ผังหัวข้อของหน้านี้: h1x1 · h2x0 · h3x0
//
// BUTTON PAGE ไม่ใช่บทความ — บรีฟรอบนี้ (src/assets/content.txt) จบที่บรรทัด 27
// และ **ไม่มีส่วน SUB-PAGES เลย** จึงไม่เคยให้ body กับหน้านี้ ทุกย่อหน้าและทุก
// หัวข้อย่อยที่เคยอยู่บนหน้านี้คือของที่รีแบรนด์รอบก่อนๆ คิดขึ้นเอง แล้วรอบถัดมา
// ก็เขียนทับด้วยความเชื่อว่ารอบก่อนมีเหตุผล — ไม่มี
// ทั้งหน้ามีแค่ชื่อเรื่องจาก ContentBox แล้วต่อด้วยปุ่มสองปุ่ม
// **ห้ามเขียนหัวข้อย่อยหรือย่อหน้าอธิบายใต้ชื่อเรื่อง** — ไม่มีรายการ "ตรวจ N จุด
// ก่อนล็อกอิน" ไม่มีประโยคเตือนเรื่องรหัสผ่าน/OTP ไม่ว่าคอปปี้นั้นจะเขียนดีแค่ไหน
// (ข้อความเตือนเรื่องรหัสผ่าน/OTP ของบรีฟอยู่บน index.astro ซึ่งเป็นบทความจริง
// ไม่ใช่บนหน้าปุ่ม)
//
// h1 บอกว่า "หน้านี้คืออะไร" ("ทางเข้า <แบรนด์> เว็บหลัก") ไม่ใช่บอกว่าบทความบน
// หน้านี้จะเถียงอะไร — ชื่อเรื่องที่โฆษณาเนื้อหาไว้คือบรรทัดที่ล่อให้รีแบรนด์รอบ
// ถัดไปเขียน body กลับมามากที่สุด
//
// cta toggle รอบนี้เปิด: /login และ /register เป็น button page ที่ index ได้
// หน้านี้จึง **ไม่อยู่ในเมนูนาวบาร์โดยตั้งใจ** (รอบนี้คือ NavbarHuay) แต่ยัง route
// และ index อยู่ และ footer ที่ใช้งานอยู่ (FooterHuay) ยังลิงก์มาที่นี่ —
// ห้ามลบไฟล์นี้ ห้ามย้ายไป src/pages-disabled/ และห้ามเติมลิงก์กลับเข้าเมนู
//
// ───────────────────────────────────────────────────────────────────────────
// แกนของแบรนด์รอบนี้คือ **เว็บหวยออนไลน์** (หวยรัฐบาลไทย หวยลาว หวยฮานอย
// หวยออมสิน) **ไม่ใช่หมวดของรอบก่อน** คำนิยามตัวเองของรอบก่อนห้ามเหลือ (brand-spec §5)
// ที่ไหนทั้งสิ้น และวลีขายของรอบก่อนทุกคำที่เจอในไฟล์นี้จึงเป็นของค้าง
// รายการเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ
// false positive ในคอมเมนต์ของไฟล์นี้เอง
// ⚠️ **สองหน้าหมวดหวยเปิดอยู่รอบนี้** (ย้ายเข้า src/pages/ แล้ว) route ที่มีจริง
// รอบนี้: / · /promotion · /register · /login · /ทางเข้า · /ตรวจหวย · /แนวทาง ·
// /ทดลองเล่น · /about-us · /contact-us · /terms · /privacy · /line
// แต่หน้านี้มีโควตาเป็นปุ่มสองปุ่มเท่านั้น จึงไม่ลิงก์ไปที่อื่นเพิ่ม
// ⚠️ บรีฟรอบนี้ไม่ได้ระบุชื่อธนาคาร ชื่อวอลเล็ต ใบอนุญาต ปีก่อตั้ง จำนวนสมาชิก
// หรือตัวเลขการเงินแม้แต่รายการเดียว และตัวเลขที่ใช้ได้มีแค่ บาทละ 1,000 ·
// 2 ตัว 100 · 3 ตัว 1,000 · 0.3% · 0.8% · 24ชม. (**ไม่มีวลีจำนวนขั้นตอนรอบนี้**)
// — หน้านี้มีโควตาเป็นปุ่มสองปุ่ม จึงไม่อ้างตัวเลขใดเลย
//
// พาเลตรอบนี้อยู่ใน brand-spec §2
// 🚨🚨 **รอบนี้ยังเป็นธีมมืด แต่คนละฮิวกับรอบก่อนสิ้นเชิง — การ์ดผิวเข้ม หมึกสว่าง**
// bg.json = {"mode":"color","color":"#000000"} = **ดำสนิท**
// การ์ด ContentBox จึงเป็นผิว #121110 บนหมึก #f3ece0 (= BRAND_TEXT)
// **ห้าม "แก้" การ์ดกลับไปเป็นผิวสว่างเพราะรอบก่อนทำแบบนั้น**
//
// ขั้วของปุ่มบนการ์ดผิวมืด (ตรงกับคู่ปุ่มที่ล็อกไว้ใน brand-spec §2):
// สมัครสมาชิก = PRIMARY พื้นไล่เฉดทอง #ffd94a -> #e3a712 -> #b07d08 บนหมึก
//   **ดำ #0a0a0a** (14.6 / 9.2 / 5.4:1 ผ่านทุกสต็อป) — ปุ่ม CTA หลัก
//   ⚠️⚠️ **ขาวบนทองได้แค่ ~1.2–2.2:1 ห้ามวางหมึกขาวบนพื้นทองเด็ดขาด**
//   ⚠️⚠️ **ห้ามจบไล่เฉดที่ #9d6f06** (4.5:1 กับหมึกดำ) ค่านั้นใช้ได้เฉพาะขอบ/ออรา
// เข้าสู่ระบบ = SECONDARY พื้นไล่เฉดโครเมียมเงิน #e8eaee -> #b4b9c2 บนหมึกดำ
//   #0a0a0a (16.6 / 10.5:1)
// ⚠️⚠️ **#e3a712 #b07d08 #9d6f06 #b4b9c2 #6b7079 ห้ามถือตัวอักษรเด็ดขาด**
//   เป็นพื้นถม/ขอบ/ออราเท่านั้น
// ⚠️ **เส้น #3d3425 ห้ามถือตัวอักษร** ตัวอักษรบนการ์ดใช้ #f3ece0 (เนื้อความ)
//   #bfb8aa (หมึกรอง) #dde1e7 (แพลทินัม) #e8eaee (โครเมียม) หรือ #ffd94a
//   (ไฮไลต์/หัวข้อ) เท่านั้น ส่วนตัวอักษรบนปุ่มถมทั้งสองแบบเป็น #0a0a0a
// ⚠️⚠️ **ฮิวนำของรอบนี้คือทอง วัสดุที่สองคือโครเมียมเงิน ไม่ใช่แดงหรือน้ำเงิน**
//   ลิปสติกแดง ผมขาวเงิน และสีผิวนักแสดงในอาร์ตเวิร์กเป็น **วัตถุในภาพ ไม่ใช่สี UI**
// ⚠️ ปุ่มของ Navfoot อยู่บนแถบโครมคนละโซนกับปุ่มบนการ์ดนี้
// **ห้ามลอกคลาสของ Navfoot มาวางบนการ์ด**
// ออราในไฟล์นี้ใช้ rgba(255,217,74,α) · rgba(227,167,18,α) · rgba(176,125,8,α) ·
// rgba(232,234,238,α) · rgba(221,225,231,α) · rgba(0,0,0,α) เท่านั้น
//
// ⚠️ กับดักรอบนี้คือ **ทอง/เหลืองเคยนำมาแล้วเกือบทุกแบรนด์ในรีโปนี้** การเจอทอง
// ในไฟล์จึง **ไม่พิสูจน์ว่าเป็นค่าของรอบนี้** ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน
// brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ
// false positive
// รอบนี้ **ไม่มีแดง ไม่มีน้ำเงิน/ฟ้า ไม่มีน้ำตาล ไม่มีครีม ไม่มีเขียว ไม่มีชมพู/
// บานเย็น ไม่มีม่วง ไม่มีส้ม และไม่มีโรสโกลด์** — แดงคือฮิวนำของแบรนด์ขาออก
// (ชื่ออยู่ใน brand-spec §0) การปล่อยแดงไว้ = ทั้งผิดพาเลตและหลงเหลือข้ามแบรนด์พร้อมกัน
//
// Announcement รอบนี้หมุนมาเป็น AnnouncementHuay ทั้งเว็บ (brand-spec §3 —
// รอบก่อนใช้ AnnouncementPremium จึงหมุนออก) orchestrator ตั้ง default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว ทุกหน้าเรียกแบบ bare จึง **ห้ามส่ง prop message**
// จากหน้านี้ ไม่งั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้ไม่มี UTF-8 locale จึงนับเป็นไบต์ = เกินจริงราว 3 เท่า)
// หน้านี้ยาว 150 ด้วยชื่อแบรนด์ 6 ตัวอักษรของรอบนี้
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ทำให้ตัวนับเห็นเป็น 5 อักขระ
// ประโยคนี้บรรยาย "สิ่งที่หน้านี้มี" เท่านั้น — หน้านี้มีแค่ปุ่มสองปุ่ม ไม่มีปุ่ม LINE
// จึงไม่สัญญาช่องทางแชตไว้ใน description
// ส่วนท้ายมาจากบรีฟบรรทัด 20 ตรงตัว: ควรตรวจสอบช่องทางจากเว็บไซต์ทางการ
const pageDescription = `ทางเข้า ${BRAND_NAME} เว็บหลัก รวมปุ่มเข้าสู่ระบบและสมัครสมาชิกแทงหวยออนไลน์ไว้ในหน้าเดียว ควรตรวจสอบที่อยู่ของเว็บไซต์ทางการให้ถูกต้องทุกครั้งก่อนกรอกข้อมูล`;

const graph = pageGraph(Astro, {
  name: `ทางเข้า ${BRAND_NAME} เว็บหลัก`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title={`ทางเข้า ${BRAND_NAME} เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`ทางเข้า ${BRAND_NAME} เว็บหลัก`} as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="group mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 rounded-xl border-2 border-[#6b7079] bg-gradient-to-b from-[#e8eaee] to-[#b4b9c2] px-6 py-4 shadow-[0_8px_24px_rgba(0,0,0,0.65)] transition-all duration-300 hover:scale-105 hover:shadow-[0_14px_36px_rgba(232,234,238,0.35)]">
          <svg class="h-9 w-9 text-[#0a0a0a]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#0a0a0a]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border-2 border-[#9d6f06] bg-gradient-to-b from-[#ffd94a] via-[#e3a712] to-[#b07d08] px-6 py-4 shadow-[0_10px_30px_rgba(227,167,18,0.4)] transition-all duration-300 hover:scale-105 hover:border-[#ffd94a] hover:shadow-[0_15px_40px_rgba(255,217,74,0.45)]">
          <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#dde1e7]/25 to-transparent"></span>

          <svg class="h-9 w-9 text-[#0a0a0a]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-black tracking-wide text-[#0a0a0a]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
