---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
// Heading inventory for this page must stay h1x1, h2x0, h3x0.
//
// This route stays OUT of the navbar menu on purpose while the cta toggle is on
// (/login and /register are menu entries themselves), but it is still routed,
// still indexed and still linked from the footer. Do not add a nav link and do
// not delete the page.
//
// Two button tiers on the CK268 palette (เขียวนีออนนำ โครเมียมขาว-เงินรอง บนพื้นดำ
// ตามโลโก้ตัวอักษรโครเมียมขาวเงินสลับเขียวนีออน และแบนเนอร์พื้นดำสนิทที่มีริ้วแสง
// เขียวนีออนพาดโค้ง ชิปคาสิโนเขียว-ดำ และมงกุฎทองจุดเล็กๆ): สมัครสมาชิก คือแอ็กชัน
// หลัก จึงได้ไล่เฉดเขียวนีออนเต็มใบ (#c9ff8f → #8bfc13 → #1a7a08) ตัวอักษรเป็นหมึก
// เข้ม #071007 — เขียวนีออนเป็นสีสว่างมาก ขาวบน #8bfc13 ได้คอนทราสต์แค่ ~1.5:1
// จึงห้ามใช้ขาวบนพื้นเขียวเด็ดขาด
// ส่วน เข้าสู่ระบบ เป็นแอ็กชันรอง จึงเป็นแบบ outline — กรอบเขียวเข้มรอง #12a008
// บนผิว #0f1b0e ตัวอักษรเขียวอ่อน #c9ff8f (hover ยกผิวขึ้นเป็นเขียวมืด #052e16
// ขอบเขียวนีออน #8bfc13 และตัวอักษรเน้น #eaffd6) — ถมเขียวคู่กรอบเขียวเข้ม
// ไม่ใช่ถมเขียวสองใบ ซึ่งจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม
// ทองห้ามเป็นสีหลักรอบนี้ เพราะ GOT777 แบรนด์ก่อนเป็นทอง+แดง
// ชุดทอง-แดงของ GOT777 (#f5c518 #ffe9a8 #96690f #fff6dd #ece0cb #d21622 #7b0304
// #4c0301 #0a0503 #241108 rgba(245,197,24,*) rgba(210,22,34,*) rgba(10,5,3,*))
// ถูกแทนครบทุกจุดแล้ว
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ (รอบก่อนเป็น Announcement3)
// — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ CK268 แล้ว และ index
// ก็เรียกแบบ bare จึงห้ามส่ง prop message จากหน้านี้
//
// CK268 เป็นเว็บเกมสล็อตออนไลน์ ไม่ใช่เว็บหวย — บรีฟพูดถึงเกมสล็อตจากหลายค่ายผ่าน
// บัญชีเดียว เกมยอดนิยม สล็อตเปิดใหม่ ฟรีสปิน ตัวคูณ ฟีเจอร์โบนัส อัปเดตเกมใหม่
// ตลอดสัปดาห์ เดิมพันเริ่มต้นระดับ 1 บาทในบางเกม โบนัสคืนยอดเสีย 0.3% โบนัสแนะนำ
// เพื่อน 0.8% สมัครเอง 3 ขั้นตอน และแอดมิน 24 ชม. เท่านั้น
// คำศัพท์ตระกูลหวยของแบรนด์ก่อน (หวย โพย แทงหวย ส่งโพย งวด รอบออกรางวัล เลขเด็ด
// อัตราจ่าย 2 ตัว 3 ตัว รัฐบาลไทย ลาวพัฒนา ฮานอย หวยหุ้น) ห้ามหลงเหลือ
// และห้ามเพิ่มใบอนุญาต ชื่อธนาคาร ยอดฝากขั้นต่ำ ชื่อค่ายเกม หรือตัวเลข RTP
// รอบนี้สองเราต์ตระกูลหวย (/ตรวจหวย, /แนวทาง) ถูกปิดไปอยู่ใน src/pages-disabled แล้ว
// หน้านี้จึงต้องไม่ลิงก์ถึง — และหน้านี้มีโควตาเป็นปุ่มสองปุ่มเท่านั้น
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 157
const pageDescription = "ทางเข้า CK268 เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ เพื่อเข้าเล่นเกมสล็อตจากค่ายที่เปิดให้บริการ ผ่านเบราว์เซอร์บนมือถือได้เลย ไม่ต้องติดตั้งแอป";

const graph = pageGraph(Astro, {
  name: "ทางเข้า CK268 เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ทางเข้า CK268 เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า CK268 เว็บหลัก" as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ CK268"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#12a008] bg-[#0f1b0e] px-6 py-4 shadow-[0_10px_30px_rgba(3,7,3,0.85)] transition-all duration-300 hover:scale-105 hover:border-[#8bfc13] hover:bg-[#052e16] hover:shadow-[0_15px_40px_rgba(30,193,13,0.40)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#12a008]/30 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#c9ff8f] transition-colors group-hover:text-[#eaffd6]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#c9ff8f] transition-colors group-hover:text-[#eaffd6]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก CK268"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#c9ff8f]/70 bg-gradient-to-r from-[#c9ff8f] via-[#8bfc13] to-[#1a7a08] px-6 py-4 shadow-[0_10px_30px_rgba(139,252,19,0.40)] transition-all duration-300 hover:scale-105 hover:border-[#eaffd6] hover:shadow-[0_15px_40px_rgba(139,252,19,0.35)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#eaffd6]/40 to-transparent"></div>

          <svg class="h-9 w-9 text-[#071007]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#071007]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
