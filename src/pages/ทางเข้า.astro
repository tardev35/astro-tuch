---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

// Button page, not an article: the brief gives this route no body. One heading
// from the ContentBox title, then the two buttons.
// Do not add section headings or explanatory prose below the page title —
// no "ตรวจ N จุดก่อนล็อกอิน" list and no PIN/OTP notice, however well it reads.
// Heading inventory for this page must stay h1x1, h2x0, h3x0.
//
// This route stays OUT of the navbar menu on purpose while the cta toggle is on
// (/login and /register are menu entries themselves), but it is still routed,
// still indexed and still linked from the footer. Do not add a nav link and do
// not delete the page.
//
// Two button tiers on the GOT777 palette (ทองนำ แดงเลือดหมูรอง บนพื้นเกือบดำ ตามโลโก้
// ตัวอักษร GOT สีทองที่มีอัญมณีแดงในตัว O กับเลข 777 สีแดง และแบนเนอร์พื้นดำ-ทองที่มี
// ชิปคาสิโนแดงดำ เหรียญทอง และวงล้อรูเล็ต): สมัครสมาชิก คือแอ็กชันหลัก จึงได้ไล่เฉด
// ทองเต็มใบ (#ffe9a8 → #f5c518 → #96690f) ตัวอักษรเป็นหมึกเข้ม #0a0503 —
// ทองเป็นสีสว่าง ตัวอักษรขาวบนทองตกคอนทราสต์ จึงห้ามใช้ขาวบนพื้นทองเด็ดขาด
// ส่วน เข้าสู่ระบบ เป็นแอ็กชันรอง จึงเป็นแบบ outline — กรอบแดงรอง #d21622 บนผิว
// #241108 ตัวอักษรทองอ่อน #ffe9a8 (hover ยกผิวขึ้นเป็นแดงเข้มสุด #4c0301 ขอบทองนำ
// #f5c518 และตัวอักษรเน้น #fff6dd) — ถมทองคู่กรอบแดง ไม่ใช่ถมทองสองใบ ซึ่งจะอ่าน
// เป็นปุ่มซ้ำกันสองปุ่ม
// ชุดแดง-ทองของ LOTTOPLUS (#dc020e #ff2d38 #6b0207 #a80710 #f3c623 #fde79a #8a6a0a
// #f0e2e2 #fff4f4 #2a0d0f #3a1114 rgba(220,2,14,*) rgba(243,198,35,*) rgba(5,1,2,*))
// ถูกแทนครบทุกจุดแล้ว
//
// Announcement หมุนมาเป็น Announcement3 ทั้งเว็บรอบนี้ — orchestrator ตั้ง default
// message ของไฟล์นั้นเป็นคอปปี้ของ GOT777 แล้ว และ index ก็เรียกแบบ bare จึงห้ามส่ง
// prop message จากหน้านี้
//
// GOT777 เป็นเว็บเกมสล็อตออนไลน์ ไม่ใช่เว็บหวย — บรีฟพูดถึงเกมสล็อตจากแพลตฟอร์ม
// ค่ายใหญ่ สล็อตคลาสสิก สล็อตธีมเอเชีย เกมผจญภัย ฟรีสปิน ตัวคูณ เกมโบนัส แจ็กพอต
// โบนัสคืนยอดเสีย 0.3% โบนัสแนะนำเพื่อน 0.8% และแอดมิน 24 ชม. เท่านั้น
// คำศัพท์ตระกูลหวยของแบรนด์ก่อน (หวย โพย แทงหวย ส่งโพย งวด รอบออกรางวัล เลขเด็ด
// อัตราจ่าย 2 ตัว 3 ตัว รัฐบาลไทย ลาวพัฒนา ฮานอย หวยหุ้น) ห้ามหลงเหลือ
// และห้ามเพิ่มใบอนุญาต ชื่อธนาคาร ยอดฝากขั้นต่ำ ชื่อค่ายเกม หรือตัวเลข RTP
// รอบนี้สองเราต์ตระกูลหวย (/ตรวจหวย, /แนวทาง) ถูกปิดไปอยู่ใน src/pages-disabled แล้ว
// หน้านี้จึงต้องไม่ลิงก์ถึง — และหน้านี้มีโควตาเป็นปุ่มสองปุ่มเท่านั้น
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 155
const pageDescription = "ทางเข้า GOT777 เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ เพื่อเข้าเล่นเกมสล็อตจากแพลตฟอร์มค่ายใหญ่ ผ่านเบราว์เซอร์บนมือถือได้เลย ไม่ต้องติดตั้งแอป";

const graph = pageGraph(Astro, {
  name: "ทางเข้า GOT777 เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ทางเข้า GOT777 เว็บหลัก เข้าสู่ระบบและสมัครสมาชิกได้จากหน้าเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า GOT777 เว็บหลัก" as="h1">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ GOT777"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#d21622] bg-[#241108] px-6 py-4 shadow-[0_10px_30px_rgba(10,5,3,0.85)] transition-all duration-300 hover:scale-105 hover:border-[#f5c518] hover:bg-[#4c0301] hover:shadow-[0_15px_40px_rgba(210,22,34,0.40)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#d21622]/30 to-transparent"></div>

          <svg
            class="h-9 w-9 text-[#ffe9a8] transition-colors group-hover:text-[#fff6dd]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#ffe9a8] transition-colors group-hover:text-[#fff6dd]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก GOT777"
          class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ffe9a8]/70 bg-gradient-to-r from-[#ffe9a8] via-[#f5c518] to-[#96690f] px-6 py-4 shadow-[0_10px_30px_rgba(245,197,24,0.40)] transition-all duration-300 hover:scale-105 hover:border-[#fff6dd] hover:shadow-[0_15px_40px_rgba(245,197,24,0.35)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#fff6dd]/40 to-transparent"></div>

          <svg class="h-9 w-9 text-[#0a0503]" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="text-3xl font-bold tracking-wide text-[#0a0503]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
