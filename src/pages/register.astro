---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// This is the PRIMARY action of the pair, so it wears the crimson phoenix
// gradient of the VAK88 artwork; /login carries the metallic gold accent.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 155.
const pageDescription =
  "หน้าสมัครสมาชิก VAK88 กดปุ่มเดียวเปิดบัญชีใหม่ด้วยตัวเอง เข้าเล่นสล็อตเว็บตรงจากค่ายลิขสิทธิ์แท้ 100% พร้อมฝาก-ถอนอัตโนมัติและตรวจสอบโปรโมชั่นได้ด้วยตัวเอง";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก VAK88",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก VAK88 เปิดบัญชีใหม่ด้วยตัวเอง เริ่มเล่นสล็อตเว็บตรงได้ทันที" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก VAK88" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก VAK88"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#e6b23c]/60 bg-gradient-to-r from-[#ee3a34] via-[#cf2027] to-[#6b0d11] px-6 py-4 text-lg font-black text-[#fff4dd] shadow-[0_10px_30px_rgba(207,32,39,0.28)] transition-all duration-300 hover:scale-105 hover:border-[#ffd873] hover:shadow-[0_15px_40px_rgba(207,32,39,0.48)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
