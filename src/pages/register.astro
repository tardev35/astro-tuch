---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
//
// UWIN33 (รอบทอง-โครเมียม-ดำ 2026-09-24): ปุ่มนี้เป็นตัว PRIMARY ของคู่ จึงสวมไล่เฉด
// ทองของแบรนด์เต็มใบ (#fbd564 → #e0b429 → #7a5407) บนตัวอักษรเกือบดำ #161106 เพราะ
// ตัวหนังสือบนพื้นทองต้องเป็นสีเข้มจึงจะอ่านออก ห้ามใช้ขาว ส่วน /login ใช้ทองเดียวกัน
// เป็นเส้นขอบบนผิวการ์ดยก #26200e แทน — สองลำดับ หนึ่งการถมสีต่อหนึ่งปุ่ม ตามคู่
// ทอง-เงินในโลโก้ที่ U และ 33 เป็นทอง ส่วน WIN เป็นเงินโครเมียม
// ชุดแดง-เงินของ MAHAGAME66 (#de161d #ff4d52 #7a0a0e #e2e8ef #26100f #fff6f5)
// ออกครบแล้ว
//
// Announcement รอบนี้หมุนจาก Announcement5 มาเป็น AnnouncementPremium ทั้งเว็บ —
// default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ index ก็เรียกแบบ bare
// จึงห้ามส่ง prop
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 152
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = "สมัครสมาชิก UWIN33 กดปุ่มเดียวเปิดบัญชีใหม่ด้วยตัวเอง รองรับทั้งมือถือและคอมพิวเตอร์ จากนั้นเข้าสู่ระบบเลือกบาคาร่า รูเล็ต ไฮโล สล็อต บอล และหวยได้ทันที";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก UWIN33",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="สมัครสมาชิก UWIN33 เปิดบัญชีใหม่ด้วยตัวเอง เล่นได้จากบัญชีเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก UWIN33" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก UWIN33"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fbd564] bg-gradient-to-r from-[#fbd564] via-[#e0b429] to-[#7a5407] px-6 py-4 text-lg font-black text-[#161106] shadow-[0_10px_30px_rgba(224,180,41,0.50)] transition-all duration-300 hover:scale-105 hover:border-[#dfe4ec] hover:shadow-[0_15px_40px_rgba(223,228,236,0.40)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
