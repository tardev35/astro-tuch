---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
//
// PKG44 (รอบทองเมทัลลิก + เงินโครเมียมบนดำ 2026-09-27): ปุ่มนี้เป็นตัว PRIMARY ของ
// คู่ จึงสวมไล่เฉดทองของแบรนด์เต็มใบ (#ffeeb8 → #fdd32a → #c8920a) บนตัวอักษร
// เกือบดำ #15110a เพราะตัวหนังสือบนพื้นทองสว่างต้องเป็นสีเข้มจึงจะอ่านออก ห้ามใช้ขาว
// ส่วน /login รับฝั่ง "K" ของโลโก้ที่เป็นเงินขัดเงา — ขอบเงินโครเมียม #c2c8d0
// บนผิวยก #2a2110 แทน สองลำดับ หนึ่งสีต่อหนึ่งปุ่ม ตามโลโก้ที่ P G 44 เป็นทองและ
// K เป็นเงิน ไม่ใช่ทองสองใบซึ่งจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม
// ชุดเขียวมรกตของ BRAZIL999 รอบก่อน (#22c55e #7cf25c #b6ff9c #0a6b18 #04380c บน
// พื้น #0a1a0c #123a18 #040a05) ออกครบแล้ว ห้ามนำกลับมา
//
// Announcement หมุนมาเป็น AnnouncementPremium ทั้งเว็บรอบนี้ — default message
// ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ index ก็เรียกแบบ bare จึงห้ามส่ง prop
//
// PKG44 เป็นแบรนด์สล็อต — บรีฟพูดถึงเกมปั่นสล็อตหลายค่ายเท่านั้น คำศัพท์เฉพาะหมวด
// ของแบรนด์ก่อนหน้า (คาสิโนสด เกมโต๊ะ บาคาร่า หวย) ห้ามหลงเหลือในหน้านี้
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 158
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = "สมัครสมาชิก PKG44 กดปุ่มเดียวเปิดบัญชีใหม่ด้วยตัวเองใน 3 ขั้นตอน รองรับมือถือและคอมพิวเตอร์ จากนั้นเข้าสู่ระบบเลือกเกมสล็อตและตรวจสอบโปรโมชั่นได้จากบัญชีเดียว";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก PKG44",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="สมัครสมาชิก PKG44 เปิดบัญชีใหม่ด้วยตัวเอง เล่นได้จากบัญชีเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก PKG44" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก PKG44"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fdd32a] bg-gradient-to-r from-[#ffeeb8] via-[#fdd32a] to-[#c8920a] px-6 py-4 text-lg font-black text-[#15110a] shadow-[0_10px_30px_rgba(253,211,42,0.50)] transition-all duration-300 hover:scale-105 hover:border-[#c2c8d0] hover:shadow-[0_15px_40px_rgba(194,200,208,0.28)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
