---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// This is the PRIMARY action of the pair, so it wears the gold gradient;
// /login carries the chrome-silver MAX/168 half of the SUPERMAX168 logo.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 157.
const pageDescription =
  "หน้าสมัครสมาชิก SUPERMAX168 กดปุ่มเดียวเปิดยูสเซอร์ใหม่ด้วยตัวเอง เข้าเล่นบาคาร่า สล็อต บอล หวย ไฮโล ได้ในบัญชีเดียว พร้อมรับสิทธิ์โปรโมชั่นสำหรับสมาชิกทุกคน";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก SUPERMAX168 เปิดยูสเซอร์ใหม่",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก SUPERMAX168 เปิดยูสเซอร์ใหม่ด้วยตัวเอง เริ่มเล่นได้ทันที" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก SUPERMAX168" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก SUPERMAX168"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#d2a43b]/60 bg-gradient-to-r from-[#f9e38b] via-[#ecc964] to-[#ba8219] px-6 py-4 text-lg font-black text-[#030201] shadow-[0_10px_30px_rgba(236,201,100,0.25)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(236,201,100,0.45)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
