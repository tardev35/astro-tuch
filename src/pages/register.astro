---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect. The title and
// description below are written for exactly that reason.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// BOOM369 (รอบนีออนเขียวบนพื้นดำ 2026-10-07, brand-spec §2 — เขียวนีออน #42fb5a
// มาจาก vivid ของ logo.webp ที่ตัวอักษร BOOM เป็นเขียวนีออน ส่วนเขียวแบรนด์
// #04ab3a กับเขียวลึก #036b26 มาจากวงแหวนที่ไล่เขียว→เทียลในโลโก้เดียวกัน
// รอบก่อน (HI59) เป็นฟ้าสว่าง+ทองบนการ์ดสว่าง รอบนี้พลิกทั้งขั้วความสว่าง เพราะ
// อาร์ตเวิร์กทั้งดรอปเป็นโถงเกือบดำที่สว่างด้วยนีออนเขียว และ bg.json เป็น #000000):
// ปุ่มนี้เป็นตัว PRIMARY ของคู่ จึงถม **เขียวนีออน** เต็มใบ (#42fb5a → #04ab3a
// 55% → #036b26) ขอบเขียวลึก #036b26 บนหมึก **#03150a** — กฎคอนทราสต์ของสเปก:
// พื้น #42fb5a ห้ามใช้ตัวอักษรขาวหรือครีมเด็ดขาด และห้ามวางตัวอักษรสว่างบนพื้น
// #04ab3a (3.1:1 ตก AA) เพราะสีนั้นเป็นสต็อปไล่เฉด/ขอบ ไม่ใช่พื้นของตัวอักษร
// ส่วน /login ถมผิวการ์ดเข้ม #0b231b → #041109 ขอบ #42fb5a/60 บนหมึก #cfe9d7
// สองลำดับ หนึ่งรูปแบบต่อหนึ่งปุ่ม ไม่ใช่ถมสีเดียวกันสองใบ ซึ่งจะอ่านเป็นปุ่มซ้ำกัน
// ตรงกับคู่ปุ่มของ NavbarCyber และ FooterCyber ที่ orchestrator รีธีมไว้แล้ว
// ชุดฟ้า+ทองของ HI59 (#0a84e0 #065a9c #044b80 #033f70 #5ec2ff #9ecbf2 #f6fbff
// #eaf5ff #0d2744 #04203f #fdbc04 #ffe27a #c88a02 #8a6102 rgba(253,188,4,*)
// rgba(255,226,122,*) rgba(10,132,224,*)) ออกครบแล้ว ห้ามนำกลับมา
//
// Announcement หมุนมาเป็น AnnouncementCyber ทั้งเว็บรอบนี้ (รอบก่อนเป็น
// Announcement2) — default message ของไฟล์นั้นเป็นคอปปี้ของ BOOM369 แล้ว และ
// index ก็เรียกแบบ bare จึงห้ามส่ง prop message
//
// BOOM369 เป็น **เว็บสล็อต** ไม่ใช่เว็บหวย — คำหมวดหวย (หวย ส่งโพย โพย เลขเด็ด
// แนวทาง อัตราจ่าย งวด ผลรางวัล) ห้ามหลงเหลือ และคำของแบรนด์ก่อน (ไฮคลาส VIP
// ส่งตรงจากเว็บแม่ ค่ายเกมพรีเมียม ไม่ผ่านบัญชีม้า) ก็ห้ามหลงเหลือเช่นกัน
// บรีฟบรรทัด 15 กับ 16 ระบุว่าสมัครผ่านมือถือได้ใน 3 ขั้นตอน และหลังเปิดบัญชีใช้
// บัญชีเดียวค้นหาเกมสล็อต ดูเครดิต โปรโมชั่น และประวัติรายการได้เอง
// ตัวเลขที่ใช้ได้มีแค่ของบรีฟเอง: 0.3% / 0.8% / 100% / 24 ชั่วโมง / 3 ขั้นตอน
// ห้ามแต่งชื่อค่ายเกม ชื่อธนาคาร ยอดฝากขั้นต่ำ จำนวนสมาชิก ปีก่อตั้ง หรือ
// เลขใบอนุญาต ที่บรีฟไม่ได้ระบุ
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 155
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} กดปุ่มเดียวเปิดบัญชีเพื่อเข้าเล่นสล็อตเบทต่ำจากค่ายตรงในบัญชีเดียว พร้อมตรวจสอบเครดิต โปรโมชั่น และประวัติรายการได้ด้วยตัวเองทุกรอบ`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} เปิดบัญชีเองผ่านมือถือ 3 ขั้นตอน เล่นสล็อตเบทต่ำได้ทันที`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#036b26] bg-gradient-to-b from-[#42fb5a] via-[#04ab3a] via-55% to-[#036b26] px-6 py-4 text-lg font-black text-[#03150a] shadow-[0_0_14px_rgba(66,251,90,0.55)] transition-all duration-300 hover:scale-105 hover:border-[#42fb5a] hover:shadow-[0_0_32px_rgba(66,251,90,0.70)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
