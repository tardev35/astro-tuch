---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change.
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page, which means verify-build holds its
// description to the same 150–160 character window as every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES — คอปปี้ของหน้านี้จึงพูด
// ได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 10–13: คืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อน
// โบนัส 0.8% ไม่จำกัด) ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า หน้านี้มีโควตาเป็นปุ่มเดียว
//
// ⚠️ แบรนด์รอบนี้เป็น **คาสิโน + กีฬา** (บาคาร่า · ไฮโล · สล็อต · แทงบอล) ไม่ใช่
// เว็บสล็อตล้วน ไม่ใช่เว็บกีฬาล้วน และไม่ใช่เว็บหมวดลอตเตอรี คำที่ห้ามหลุดกลับมาอยู่
// ใน brand-spec §7 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำต้องห้ามเจอ false positive
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 24 ชั่วโมง — ห้ามแต่งใบอนุญาต
// หน่วยงานกำกับ ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP ยอดขั้นต่ำ จำนวนสมาชิก หรือปีใดๆ
// (บรีฟรอบนี้ไม่ได้เอ่ยปีไว้เลย) — "3 ขั้นตอน" ของบรีฟเป็นหัวข้อของ index.astro
// (บรรทัด 14–18) ไม่ใช่ของหน้านี้ ห้ามยกมาเขียนซ้ำที่นี่
//
// แบรนด์รอบนี้ (TSDET911, รอบน้ำเงินไฟฟ้า-เงินโครเมียมบนกรมเกือบดำ 2026-10-13,
// brand-spec §2): **สองโทนจริง: น้ำเงินไฟฟ้านำ เงินโครเมียมรอง** ไม่มีทองในดรอปนี้
// น้ำเงินแบรนด์ #0360f3 · ฟ้าสด #0292fb · น้ำเงินลึก #032dad #04186e #041a43 ·
// ตัวที่ถือตัวอักษรได้: เงินโครเมียม #cfdcec (10.6:1) #9db4d4 (6.1:1) ·
// ฟ้าไฮไลต์ #6ec8ff (7.4:1) · ฟ้าอ่อน #4fb4ff (6.0:1) ·
// เนื้อความ #dde8f7 (= BRAND_TEXT) · หมึกบนพื้นสว่าง/พื้นถมฟ้า #021026
// ชั้นผิว: ยก #102a5e (= การ์ด ContentBox) / กลาง #0a1c42 / จม #040e26 /
// พื้นเพจ #00081f — รอบนี้ bg.json เป็นกรมเกือบดำ
// ปุ่มนี้เป็น PRIMARY: ถมพื้นฟ้าไล่เฉด #6ec8ff → #0292fb ขอบ #032dad
// บนหมึกเข้ม #021026 (9.8:1 บนปลายสว่าง #6ec8ff · 6.0:1 บนปลายเข้มสุด #0292fb)
// ⚠️ ห้ามกลับด้าน: พื้นถมฟ้าต้องใช้หมึกเข้มเสมอ ห้ามขาวหรือครีม และไล่เฉดต้อง
// **หยุดที่ #0292fb** ห้ามไล่เข้มกว่านั้นใต้ตัวอักษร — #032dad อยู่ได้เฉพาะเป็น
// เส้นขอบของปุ่มนี้
// — ส่วน /login เป็น SECONDARY ชั้นจมขอบน้ำเงิน จึงไม่ซ้ำกัน · #0360f3 #0292fb
// #032dad #04186e #041a43 ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่เส้นขอบ ออรา พื้นถม
// และเงา — ออราในไฟล์นี้ใช้ rgba(2,146,251,α) เท่านั้น นอกจากเงาดำล้วน
// ⚠️ กับดักรอบนี้คือ **น้ำเงิน**: ไฟล์ inventory หลายตัวเคยเป็นของแบรนด์น้ำเงินมาก่อน
// "มีน้ำเงินอยู่แล้ว" จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้ ให้เทียบเป็น "ค่า" ทีละตัวกับ
// ตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ
// false positive — ชุดม่วง-ทองของแบรนด์ก่อนออกครบทุกจุดในไฟล์นี้แล้ว
// และรอบนี้ **ไม่มีทอง ไม่มีม่วง ไม่มีชมพู ไม่มีเขียว ไม่มีแดง ไม่มีส้ม**
//
// Announcement หมุนมาเป็น Announcement3 ทั้งเว็บรอบนี้ (brand-spec §3)
// orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว
// จึงเรียกแบบ bare — ห้ามส่ง prop message จากหน้านี้
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) หน้านี้ยาว 155
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} กดปุ่มเดียวไปยังทางเข้าเดิมพันหลักของเว็บ เว็บพนันลิขสิทธิ์ไทยแท้ พร้อมโปรโมชั่นคืนยอดเสีย 0.3% และแนะนำเพื่อน โบนัส 0.8% ไม่จำกัด`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/2u19";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} เว็บพนันลิขสิทธิ์ไทยแท้ สมัครจากทางเข้าเดิมพันหลัก`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#032dad] bg-gradient-to-b from-[#6ec8ff] to-[#0292fb] px-6 py-4 text-2xl font-black tracking-wide text-[#021026] shadow-[0_10px_30px_rgba(2,146,251,0.4)] transition-all duration-300 hover:scale-105 hover:border-[#021026] hover:shadow-[0_15px_40px_rgba(2,146,251,0.6)]">
        <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#6ec8ff]/70 to-transparent"></div>
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
