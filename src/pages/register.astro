---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change.
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page, which means verify-build holds its
// description to the same 150–160 character window as every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES — คอปปี้ของหน้านี้จึงพูด
// ได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 4: สมัครรับโปรโมชั่นผ่านบัญชีสมาชิก และบรรทัด 8:
// ควรศึกษายอดที่ใช้คำนวณโบนัส ระยะเวลารับสิทธิ์ และข้อกำหนดการใช้เครดิตให้ครบถ้วน
// ก่อนเข้าร่วม) ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า หน้านี้มีโควตาเป็นปุ่มเดียว
//
// ⚠️ แบรนด์รอบนี้ (นินจา168) เป็น **เว็บสล็อตล้วน** ที่บรีฟพูดถึงเรื่องเดียวคือ
// **โปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%** — ไม่มีหมวดคาสิโน ไม่มีกีฬา
// และไม่ใช่เว็บหวย
// คำที่ห้ามหลุดกลับมาอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำ
// ต้องห้ามเจอ false positive · สามแบรนด์ก่อนหน้าขายตัวเองด้วยวลีที่บรีฟรอบนี้
// ไม่มีเลยสักคำ จึงต้องเขียนใหม่จากบรีฟ ไม่ใช่ find-and-replace ทับของเดิม
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกมแม้แต่ค่ายเดียว** จึงห้ามเขียนชื่อค่ายใดๆ
// ให้ใช้คำกลางว่า "ค่ายเกม" ตามบรีฟ
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.8% · 0.3% · 24ชม. ห้ามแต่งใบอนุญาต
// หน่วยงานกำกับ ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีใดๆ
// (บรีฟรอบนี้ไม่ได้เอ่ยปีไว้เลย) — หัวข้อฝากถอนกับแอดมิน LINE ของบรีฟ
// (บรรทัด 13-16) เป็นของ index.astro ไม่ใช่ของหน้านี้ ห้ามยกมาเขียนซ้ำที่นี่
//
// พาเลตต์รอบนี้อยู่ใน .claude/brand-spec-ninja168.md §2 — **ฟ้าไซยานนำ
// เหลืองมะนาวเป็นฮิวที่สอง น้ำเงินลึกไม่เคยถือตัวอักษร บนพื้นดำสนิท** (bg.json =
// {"mode":"color","color":"#000000"}) โลโก้คือ **นินจาการ์ตูนชุดดำ** ผูกผ้าคาดหัว
// ฟ้า-ขาว ถือดาวกระจายสีฟ้า ข้างๆ เป็นคำว่า "นินจา" สามมิติ **สีเหลืองทอง**
// ต่อด้วย "168" **สีฟ้าบับเบิลผิวมันวาว**
// ฟ้าแบรนด์ #32bcfb · ฟ้าน้ำแข็ง #a9e9ff · เหลืองมะนาว #fef54b ·
// เนื้อความ #dceefc (= BRAND_TEXT) · หมึกบนพื้นถมสว่าง #041019
// ชั้นผิว: ยก #0c2a3d (= การ์ด ContentBox) / กลาง #071a28 / จม #030e16
// ปุ่มนี้เป็น PRIMARY: ถมพื้น **ฟ้า** ไล่เฉด #a9e9ff → #32bcfb ขอบ #07335f
// บนหมึกเข้ม #041019 (8.9:1 บนปลายเข้มสุด #32bcfb · 13.2:1 บนปลาย #a9e9ff)
// ⚠️ ห้ามกลับด้าน: พื้นถมฟ้าต้องใช้หมึก #041019 เสมอ ห้ามขาวหรือครีม และไล่เฉดต้อง
// **หยุดที่ #32bcfb** ห้ามไล่ลงไปถึง #07335f ใต้ตัวอักษร — น้ำเงินลึกให้ #041019
// แค่ 1.4:1 และอยู่ได้เฉพาะเป็นเส้นขอบของปุ่มนี้
// — ส่วน /login เป็น SECONDARY ชั้นจมขอบฟ้าบนตัวอักษรฟ้าน้ำแข็ง จึงไม่ซ้ำกัน ·
// #07335f (น้ำเงินลึก) และ #6b5c10 (ทองลึก) ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่
// เส้นขอบ ออรา พื้นถม และเงา — ออราในไฟล์นี้ใช้ rgba(50,188,251,α) เท่านั้น
// นอกจากเงาดำล้วน · #fef54b สงวนไว้ไฮไลต์ <strong> ในเนื้อความ หน้านี้จึงไม่มี
// ⚠️ กับดักรอบนี้คือ **ทั้งฟ้าและเหลือง** เพราะรอบก่อน (สบายเบท168) ก็เป็นฟ้านำ
// + ทองรองเหมือนกัน "มีฟ้าอยู่แล้ว" หรือ "มีสีเหลืองอยู่แล้ว" จึงไม่พิสูจน์ว่าเป็น
// ค่าของรอบนี้ ฟ้ารอบนี้คือ #32bcfb (50,188,251) และเหลืองรอบนี้คือ #fef54b
// (254,245,75) ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำ
// ที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive
// และรอบนี้ **ไม่มีชมพู ไม่มีแดง ไม่มีม่วง ไม่มีเขียว ไม่มีส้ม ไม่มีเงิน/โครเมียม
// ไม่มีโรสโกลด์**
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ (brand-spec §3 —
// รอบก่อนใช้ Announcement2 จึงหมุนออก) orchestrator ตั้ง default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare — ห้ามส่ง prop message
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) หน้านี้ยาว 152
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} กดปุ่มเดียวไปยังหน้าลงทะเบียน ควรอ่านเงื่อนไขการเปิดบัญชี รอบคำนวณโบนัสแนะนำเพื่อน 0.8% และเครดิตคืนยอดเสีย 0.3% ก่อนกรอกข้อมูล`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} เปิดบัญชีสมาชิกเพื่อรับโปรโมชั่นตามเงื่อนไข`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#07335f] bg-gradient-to-b from-[#a9e9ff] to-[#32bcfb] px-6 py-4 text-2xl font-black tracking-wide text-[#041019] shadow-[0_10px_30px_rgba(50,188,251,0.4)] transition-all duration-300 hover:scale-105 hover:border-[#041019] hover:shadow-[0_15px_40px_rgba(50,188,251,0.6)]">
        <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#a9e9ff]/70 to-transparent"></div>
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
