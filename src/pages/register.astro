---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change.
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page, which means verify-build holds its
// description to the same 150–160 character window as every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES — คอปปี้ของหน้านี้จึงพูด
// ได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 14: ก่อนลงทะเบียนควรอ่านข้อกำหนดเกี่ยวกับคุณสมบัติ
// ผู้สมัคร การเปิดบัญชี และการใช้ข้อมูลส่วนบุคคลให้ครบถ้วน · บรรทัด 12: ควรศึกษา
// รอบจ่ายโบนัสและเงื่อนไขการใช้เครดิตให้ชัดเจนก่อนเข้าร่วม)
// ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า หน้านี้มีโควตาเป็นปุ่มเดียว
//
// ⚠️ แบรนด์รอบนี้ (รวยแทร่168) เป็น **เว็บสล็อตล้วน** ที่บรีฟพูดถึงโปรโมชั่นเพียง
// สองรายการคือ **คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%** — ไม่มีหมวดคาสิโน
// ไม่มีกีฬา และไม่ใช่เว็บหวย
// คำที่ห้ามหลุดกลับมาอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำ
// ต้องห้ามเจอ false positive · แบรนด์ก่อนหน้าขายตัวเองด้วยวลีที่บรีฟรอบนี้
// ไม่มีเลยสักคำ จึงต้องเขียนใหม่จากบรีฟ ไม่ใช่ find-and-replace ทับของเดิม
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกมแม้แต่ค่ายเดียว** จึงห้ามเขียนชื่อค่ายใดๆ
// ให้ใช้คำกลางว่า "ค่ายเกม" ตามบรีฟ
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 24ชม. ห้ามแต่งใบอนุญาต
// หน่วยงานกำกับ ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีใดๆ
// (บรีฟรอบนี้ไม่ได้เอ่ยปีไว้เลย) — หัวข้อขั้นตอนสมัครกับช่องทางติดต่อแอดมินของบรีฟ
// (บรรทัด 13-22) เป็นของ index.astro ไม่ใช่ของหน้านี้ ห้ามยกมาเขียนซ้ำที่นี่
//
// พาเลตต์รอบนี้อยู่ใน .claude/brand-spec-ruaythear168.md §2 — **ฟ้าอะซัวร์นำ
// ทองอำพันเป็นฮิวที่สอง น้ำเงินลึกไม่เคยถือตัวอักษร บนพื้นดำสนิท** (bg.json =
// {"mode":"color","color":"#000000"}) โลโก้คือคำว่า **"รวย"** ตัวอักษรไทยหนา
// สามมิติ **สีทองอำพัน** ต่อด้วย **"แทร่168" สีฟ้าอะซัวร์บับเบิลผิวมันวาว**
// ข้างๆ เป็นถุงเงินสีฟ้า ปึกธนบัตร และกองเหรียญทอง
// ฟ้าอะซัวร์ #039cfa · ฟ้าน้ำแข็ง #c3ebfc · ทองอำพัน #f9a826 ·
// เนื้อความ #e3f2fc (= BRAND_TEXT) · หมึกบนพื้นถมสว่าง #031320
// ชั้นผิว: ยก #0b2d52 (= การ์ด ContentBox) / กลาง #071e38 / จม #030f1d
// ปุ่มนี้เป็น PRIMARY: ถมพื้น **ฟ้า** ไล่เฉด #c3ebfc → #039cfa ขอบ #04366b
// บนหมึกเข้ม #031320 (6.2:1 บนปลายเข้มสุด #039cfa · 14.6:1 บนปลาย #c3ebfc)
// ⚠️ ห้ามกลับด้าน: พื้นถมฟ้าต้องใช้หมึก #031320 เสมอ ห้ามขาวหรือครีม และไล่เฉดต้อง
// **หยุดที่ #039cfa** ห้ามไล่ลงไปถึง #04366b ใต้ตัวอักษร — น้ำเงินลึกให้ #031320
// แค่ 1.3:1 และอยู่ได้เฉพาะเป็นเส้นขอบของปุ่มนี้
// — ส่วน /login เป็น SECONDARY ชั้นจมขอบฟ้าบนตัวอักษรฟ้าน้ำแข็ง จึงไม่ซ้ำกัน ·
// #04366b (น้ำเงินลึก) และ #704504 (บรอนซ์ลึก) ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่
// เส้นขอบ ออรา พื้นถม และเงา — ออราในไฟล์นี้ใช้ rgba(3,156,250,α) เท่านั้น
// นอกจากเงาดำล้วน · #f9a826 สงวนไว้ไฮไลต์ <strong> ในเนื้อความ หน้านี้จึงไม่มี
// ⚠️ กับดักรอบนี้คือ **ทั้งฟ้าและทอง** เพราะสองรอบก่อน (นินจา168 ฟ้าไซยาน+
// เหลืองมะนาว · สบายเบท168 ฟ้าท้องฟ้า+ทองอำพัน) ก็เป็นฟ้านำ + ทองรองเหมือนกัน
// "มีฟ้าอยู่แล้ว" หรือ "มีทองอยู่แล้ว" จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้
// ฟ้ารอบนี้คือ #039cfa (3,156,250) และทองรอบนี้คือ #f9a826 (249,168,38)
// ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive
// และรอบนี้ **ไม่มีชมพู ไม่มีแดง ไม่มีม่วง ไม่มีเขียว ไม่มีส้ม ไม่มีเงิน/โครเมียม
// ไม่มีโรสโกลด์ ไม่มีเหลืองมะนาว**
//
// Announcement หมุนมาเป็น Announcement3 ทั้งเว็บรอบนี้ (brand-spec §3 —
// รอบก่อนใช้ Announcement5 จึงหมุนออก) orchestrator ตั้ง default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare — ห้ามส่ง prop message
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) หน้านี้ยาว 154
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} กดปุ่มเดียวไปยังหน้าลงทะเบียน ควรอ่านเงื่อนไขการเปิดบัญชี รอบคำนวณโบนัสแนะนำเพื่อน 0.8% และเครดิตคืนยอดเสีย 0.3% ก่อนกรอกข้อมูล`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} เปิดบัญชีสมาชิกเพื่อรับโปรโมชั่นตามเงื่อนไข`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#04366b] bg-gradient-to-b from-[#c3ebfc] to-[#039cfa] px-6 py-4 text-2xl font-black tracking-wide text-[#031320] shadow-[0_10px_30px_rgba(3,156,250,0.4)] transition-all duration-300 hover:scale-105 hover:border-[#031320] hover:shadow-[0_15px_40px_rgba(3,156,250,0.6)]">
        <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#c3ebfc]/70 to-transparent"></div>
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
