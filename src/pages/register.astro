---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 156.
const pageDescription =
  "หน้าสมัครสมาชิก LUCKY88 กดปุ่มเดียวเปิดยูสเซอร์ใหม่ด้วยตัวเองได้ทันที เริ่มเล่นสล็อตเครดิตฟรีรวมค่ายชั้นนำแบรนด์ดัง พร้อมรับโปรโมชั่นตามเงื่อนไขที่เว็บกำหนด";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก LUCKY88 เปิดยูสเซอร์ใหม่",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก LUCKY88 เปิดยูสเซอร์ใหม่ด้วยตัวเอง เริ่มเล่นสล็อตรวมค่ายชั้นนำ" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก LUCKY88" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก LUCKY88"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#e01a2b]/70 bg-gradient-to-r from-[#ff3b4d] via-[#e01a2b] to-[#8e0407] px-6 py-4 text-lg font-black text-[#f4f6f8] shadow-[0_10px_30px_rgba(224,26,43,0.25)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(224,26,43,0.40)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
