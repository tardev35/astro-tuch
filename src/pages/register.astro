---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// This is the PRIMARY action of the pair, so it wears the solid logo-blue
// gradient (#3b9ddd → #226ca9 → #054e83) under near-white text; /login carries
// the outline. Gold metallic stays a text-highlight colour on this brand and
// does not fill a button.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 155.
const pageDescription =
  "หน้าสมัครสมาชิก PAOTUNG กดปุ่มเดียวเปิดบัญชีใหม่ด้วยตัวเองบนมือถือ เดิมพันเริ่มต้น 1 บาท ทุกค่ายเกม พร้อมระบบฝาก-ถอนอัตโนมัติรองรับทุกธนาคารตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก PAOTUNG",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก PAOTUNG เปิดบัญชีใหม่ด้วยตัวเอง เริ่มเดิมพัน 1 บาททุกเกม" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก PAOTUNG" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก PAOTUNG"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#3b9ddd]/70 bg-gradient-to-r from-[#3b9ddd] via-[#226ca9] to-[#054e83] px-6 py-4 text-lg font-black text-[#eef6fd] shadow-[0_10px_30px_rgba(34,108,169,0.28)] transition-all duration-300 hover:scale-105 hover:border-[#7fc4f0] hover:shadow-[0_15px_40px_rgba(34,108,169,0.48)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
