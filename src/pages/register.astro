---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — this page is indexed and must not
// describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// This is the PRIMARY action of the pair on the FAH999 palette, so it wears the
// full gold-gradient fill (#f7e7a8 → #e8c25a → #a3732c) under the palette's
// text-on-gold ink (#140f06) with a highlight-gold outline; /login carries the
// same hue as an outline on the raised panel instead. One hue, two brightnesses.
//
// Announcement รอบนี้หมุนมาใช้ Announcement5 ทั้งเว็บ — default message ของไฟล์
// นั้นเป็นคอปปี้ของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ไม่ต้องส่ง prop
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 157
const pageDescription = "หน้าสมัครสมาชิก FAH999 กดปุ่มเดียวเปิดยูสใหม่เพื่อรับสิทธิ์โบนัสฝากแรกตามเงื่อนไขที่กำหนด เข้าเล่นสล็อตหลายค่ายแบบไม่ล็อคยูส รองรับทั้งช่องทางธนาคารและวอลเลท";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก FAH999",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก FAH999 เปิดยูสใหม่ ไม่ล็อคยูส รับโบนัสฝากแรกไม่อั้น" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก FAH999" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก FAH999"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f7e7a8] bg-gradient-to-r from-[#f7e7a8] via-[#e8c25a] to-[#a3732c] px-6 py-4 text-lg font-black text-[#140f06] shadow-[0_10px_30px_rgba(232,194,90,0.45)] transition-all duration-300 hover:scale-105 hover:border-[#fefac4] hover:shadow-[0_15px_40px_rgba(247,231,168,0.5)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
