---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect. The title and
// description below are written for exactly that reason.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// หวยคิง (รอบทองโลหะ + ครีมอมพีช บนดำอมน้ำตาล 2026-10-04, brand-spec §2 — ทองโลหะ
// #cd9a2c / #fdeb7c / #ab7314 มาจากมงกุฎและตัวอักษร "หวยคิง" บนโลโก้ ส่วนครีมอมพีช
// #fcd4c3 / #fce2d4 คือชุดขาวของนางแบบใน slide1/slide2 และมาแทนเงินโครเมียมของ
// UP555 รอบก่อน):
// ปุ่มนี้เป็นตัว PRIMARY ของคู่ จึงสวมไล่เฉด **ทอง** ประจำแบรนด์เต็มใบ
// (#fdeb7c → #cd9a2c → #ab7314) ขอบทองลึก #ab7314 บนตัวอักษร **ดำอมน้ำตาล #120a02** —
// กฎคอนทราสต์: หมึกขาวบนทองสว่าง #fdeb7c ได้ไม่ถึงเกณฑ์ พื้นทองจึงต้องใช้หมึกเข้ม
// เสมอ (#120a02 บน #fdeb7c ≈ 15:1 ผ่าน) และหมึกครีมอมพีชบนพื้นทองก็ตก
// ส่วน /login เป็นแบบ outline (กรอบครีมอมพีช #fcd4c3/60 + ตัวอักษรครีมอ่อน #fce2d4
// บนพื้นลึกสุด #0c0b0a) สองลำดับ หนึ่งรูปแบบต่อหนึ่งปุ่ม ไม่ใช่ถมทองสองใบ ซึ่งจะ
// อ่านเป็นปุ่มซ้ำกันสองปุ่ม — และคู่ทอง/ครีมนี้คือสองโทนที่อยู่บนอาร์ตเวิร์กจริง
// ชุดทอง + เงินโครเมียมของ UP555 (#ebbb54 #fce675 #ab6d24 #d5d4d3 #f3f3f2 #130b03
// #241705 #0c0502 #160d02 #f8eed9 rgba(235,187,84,*) rgba(252,230,117,*)) ออกครบแล้ว
//
// Announcement หมุนมาเป็น AnnouncementHuay ทั้งเว็บรอบนี้ (รอบก่อน UP555 เป็น
// Announcement5) — default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ
// index ก็เรียกแบบ bare จึงห้ามส่ง prop message
//
// หวยคิง เป็น **เว็บรับแทงหวยล้วน** ไม่ใช่คาสิโน บรีฟบรรทัด 17 ระบุการสมัครผ่าน
// มือถือได้เองด้วย 3 ขั้นตอน (เปิดหน้าสมัครและกรอกข้อมูลตามที่ระบบกำหนด → ยืนยัน
// ข้อมูลเพื่อสร้างบัญชีและ Login เข้าสู่ระบบ → เลือกรายการหวย กรอกตัวเลขและยอดที่
// ต้องการ พร้อมตรวจสอบอัตราจ่ายก่อนส่งโพย) แล้วตรวจสอบรายการหวย อัตราจ่าย เครดิต
// และประวัติโพยผ่านบัญชีของตนเองได้
// ตัวเลขที่ใช้ได้มีแค่ 100 / 1,000 / 2 ตัว / 3 ตัว / 3 ขั้นตอน / 24 ชั่วโมง
// ห้ามแต่งตัวเลขอื่นขึ้นมาเอง และห้ามเอ่ยชื่อตลาดหวย เวลาเปิด-ปิดรับ ชื่อธนาคาร
// ยอดฝากขั้นต่ำ จำนวนสมาชิก ปีก่อตั้ง หรือเลขใบอนุญาต ที่บรีฟไม่ได้ระบุ
// คำคาสิโนของแบรนด์ก่อนหน้า (สล็อต บาคาร่า บอล เดิมพันฟุตบอล ค่ายเกม คาสิโนสด
// หมวดเกม RTP ความผันผวน ทางเข้าเล่นใหม่ ระบบอัปเกรด คืนยอดเสีย 0.3% แนะนำเพื่อน
// 0.8%) ห้ามหลงเหลือ
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 155
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} กดปุ่มเดียวเปิดบัญชีผ่านมือถือได้ใน 3 ขั้นตอน แล้ว Login เลือกรายการหวย กรอกเลขและยอด ตรวจอัตราจ่ายและวงเงินรับแทงก่อนส่งโพยทุกครั้ง`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} เปิดบัญชีเองผ่านมือถือ 3 ขั้นตอน ส่งโพยได้เลย`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ab7314] bg-gradient-to-r from-[#fdeb7c] via-[#cd9a2c] to-[#ab7314] px-6 py-4 text-lg font-black text-[#120a02] shadow-[0_10px_30px_rgba(205,154,44,0.45)] transition-all duration-300 hover:scale-105 hover:border-[#fdeb7c] hover:shadow-[0_15px_40px_rgba(253,235,124,0.45)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
