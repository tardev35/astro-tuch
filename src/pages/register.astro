---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — this page is indexed and must not
// describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// This is the PRIMARY action of the pair on the HENG35 palette, so it wears the
// full gold-gradient fill (#fefac4 → #ecc55c → #a3732c) under the palette's
// text-on-gold ink (#0d0b0a); /login carries the same gold as an outline on the
// black card surface instead. One accent, two brightnesses.
//
// Announcement รอบนี้หมุนมาใช้ AnnouncementPremium ทั้งเว็บ — default message
// ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ไม่ต้องส่ง prop
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 153
const pageDescription = "หน้าสมัครสมาชิก HENG35 กดปุ่มเดียวเปิดบัญชียูสใหม่เพื่อเข้าเล่นสล็อตที่รวมเกมจากหลายค่าย พร้อมตรวจสอบเงื่อนไขโบนัสฝากแรกและช่องทางฝากถอนได้จากบัญชีสมาชิก";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก HENG35",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก HENG35 เปิดบัญชียูสใหม่ ไม่ล็อคยูส รับโบนัสฝากแรก" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก HENG35" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก HENG35"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fefac4] bg-gradient-to-r from-[#fefac4] via-[#ecc55c] to-[#a3732c] px-6 py-4 text-lg font-black text-[#0d0b0a] shadow-[0_10px_30px_rgba(236,197,92,0.45)] transition-all duration-300 hover:scale-105 hover:border-[#ffdf8a] hover:shadow-[0_15px_40px_rgba(254,250,196,0.5)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
