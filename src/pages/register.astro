---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change.
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page, which means verify-build holds its
// description to the same 150–160 character window as every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES — คอปปี้ของหน้านี้จึงพูด
// ได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 10–13: คืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อน
// โบนัส 0.8% ไม่จำกัด) ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า หน้านี้มีโควตาเป็นปุ่มเดียว
// หมายเหตุ: บรีฟรอบนี้ระบุ "สมัครเล่น 3 ขั้นตอน" ไว้จริง (บรรทัด 14–18) แต่เนื้อหา
// นั้นเป็นของ index.astro กับ /about-us — หน้านี้ห้ามเขียนเป็น prose ลงมา
//
// ⚠️ แบรนด์รอบนี้เป็น **แบรนด์คาสิโนรวมทุกหมวด** (บาคาร่า สล็อต รูเล็ต ไฮโล แทงบอล
// และคาสิโนไลฟ์สด) ไม่ใช่เว็บสล็อตล้วนแบบแบรนด์ก่อน ไม่ใช่เว็บกีฬาล้วน และไม่ใช่เว็บ
// ลอตเตอรี รายการคำที่ห้ามหลุดกลับมาอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้
// grep หาคำต้องห้ามเจอ false positive
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% / 0.8% / 3 ขั้นตอน / 24 ชั่วโมง
// — ห้ามแต่งใบอนุญาต หน่วยงานกำกับ ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP ยอดขั้นต่ำ หรือปี
// ใดๆ (บรีฟรอบนี้ไม่ได้เอ่ยปีไว้เลย)
//
// แบรนด์รอบนี้ (รอบทองมังกรบนดำสนิท 2026-10-12, brand-spec §2):
// ทองหลัก #dfa310 (ฮิวเดียวของแบรนด์ ไม่มีสีที่สอง) · ทองสว่าง #ffe4a3 (ไฮไลต์
// และสีตอน hover) · ทองไฮไลต์ #ffc93d (สงวนไว้ให้ <strong> ในย่อหน้า) ·
// เนื้อความ #f0e9dc (= BRAND_TEXT) · เส้น/ออรา #8a5c09 และ #43240b ·
// หมึกบนพื้นถมทอง #140d02
// ชั้นผิว: ยก #1b1307 (= การ์ด ContentBox) / กลาง #120c04 / จม #070502 /
// พื้นเพจ #000000 — รอบนี้ bg.json เป็นดำสนิท จึงไม่มีชั้นที่ลึกกว่าพื้นเพจ
// ปุ่มนี้เป็น PRIMARY: ถมพื้นทองไล่เฉด #ffc93d → #dfa310 ขอบ #8a5c09
// บนหมึกเข้ม #140d02 (8.7:1 บนปลายเข้มสุด #dfa310 และ 12.8:1 บน #ffc93d)
// ⚠️ ห้ามกลับด้าน: พื้นถมทองต้องใช้หมึกเข้มเสมอ ห้ามครีมหรือขาว และไล่เฉดต้อง
// **หยุดที่ #dfa310** ห้ามไล่เข้มกว่านั้นใต้ตัวอักษร — #8a5c09 อยู่ได้เฉพาะเป็น
// เส้นขอบของปุ่มนี้
// — ส่วน /login เป็น SECONDARY ชั้นจม จึงไม่ซ้ำกัน · #8a5c09 #43240b
// ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่เส้นขอบ ออรา และเงา — ออราในไฟล์นี้ใช้
// rgba(223,163,16,α) และ rgba(255,201,61,α) เท่านั้น นอกจากเงาดำล้วน
// ⚠️ ทองมาแล้วเก้าในสิบเอ็ดรอบหลังสุด "เจอทอง" ไม่ได้แปลว่าถูกค่า ให้เทียบเป็นตัวๆ
// กับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ
// false positive — ชุดชมพู-ทองของแบรนด์ก่อนออกครบทุกจุดในไฟล์นี้แล้ว
// และรอบนี้ **ไม่มีชมพู ไม่มีม่วง ไม่มีเขียว ไม่มีน้ำเงิน ไม่มีเทา/เงิน ไม่มีส้มอิฐ**
//
// Announcement หมุนมาเป็น AnnouncementPremium ทั้งเว็บรอบนี้ (brand-spec §3)
// orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว
// จึงเรียกแบบ bare — ห้ามส่ง prop message จากหน้านี้
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) หน้านี้ยาว 156
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} แบรนด์คาสิโนเซิร์ฟไทย กดปุ่มเดียวไปยังทางเข้าหลักของเว็บ สมัครได้ใน 3 ขั้นตอน พร้อมโปรโมชั่นคืนยอดเสีย 0.3% และแนะนำเพื่อน โบนัส 0.8%`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/2u19";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} แบรนด์คาสิโนเซิร์ฟไทย สมัครได้ใน 3 ขั้นตอน`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#8a5c09] bg-gradient-to-b from-[#ffc93d] to-[#dfa310] px-6 py-4 text-2xl font-black tracking-wide text-[#140d02] shadow-[0_10px_30px_rgba(223,163,16,0.4)] transition-all duration-300 hover:scale-105 hover:border-[#140d02] hover:shadow-[0_15px_40px_rgba(255,201,61,0.6)]">
        <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ffe4a3]/60 to-transparent"></div>
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
