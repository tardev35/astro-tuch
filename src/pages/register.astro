---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char).
const pageDescription =
  "หน้าสมัครสมาชิก PLUSPSG สล็อตแตกโคตรเก่ง กดปุ่มเดียวเพื่อเปิดบัญชีใหม่ด้วยตัวเองเพียง 3 ขั้นตอน กรอกข้อมูล ฝากเครดิต แล้วเริ่มปั่นสล็อตเบทต่ำแตกง่ายได้ทันที";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก PLUSPSG เปิดบัญชีใหม่",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก PLUSPSG สล็อตแตกโคตรเก่ง เปิดบัญชีใหม่ด้วยตัวเอง 3 ขั้นตอน" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก PLUSPSG" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก PLUSPSG"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ff4b18]/70 bg-gradient-to-r from-[#ff4b18] via-[#e2060a] to-[#7a0304] px-6 py-4 text-lg font-black text-[#fff6e0] shadow-[0_10px_30px_rgba(226,6,10,0.25)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(255,75,24,0.35)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
