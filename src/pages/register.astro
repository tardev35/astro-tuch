---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// This is the PRIMARY action of the pair, so it wears the gold gradient;
// /login carries the silver half of the two-tone MEPAY77 logo.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 158.
const pageDescription =
  "หน้าสมัครสมาชิก MEPAY77 กดปุ่มเดียวเปิดยูสเซอร์ใหม่ด้วยตัวเอง เล่นบาคาร่า สล็อต หวย บอล ครบในบัญชีเดียว ฝากถอนวอลเลทไม่มีขั้นต่ำ พร้อมรับสิทธิ์โปรโมชั่นสมาชิก";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก MEPAY77 เปิดยูสเซอร์ใหม่",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก MEPAY77 เปิดยูสเซอร์ใหม่ด้วยตัวเอง เริ่มเดิมพันได้ทันที" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก MEPAY77" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก MEPAY77"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f2ae35]/60 bg-gradient-to-r from-[#fff6e0] via-[#fdcc5c] to-[#a3701c] px-6 py-4 text-lg font-black text-[#130c01] shadow-[0_10px_30px_rgba(242,174,53,0.25)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(242,174,53,0.45)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
