---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change.
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page, which means verify-build holds its
// description to the same 150–160 character window as every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES — คอปปี้ของหน้านี้จึงพูด
// ได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 14: ควรอ่านข้อกำหนดการเปิดบัญชีและตรวจสอบรายชื่อ
// ค่ายเกมที่เปิดให้บริการจริงก่อนดำเนินการ และบรรทัด 16: อ่านรายละเอียดเกี่ยวกับ
// คุณสมบัติผู้ใช้งาน เงื่อนไขการเปิดบัญชี และนโยบายข้อมูลส่วนบุคคลก่อนกรอกข้อมูล)
// ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า หน้านี้มีโควตาเป็นปุ่มเดียว
//
// ⚠️ แบรนด์รอบนี้ (สบายเบท168) เป็น **เว็บสล็อตล้วน** ที่เรียกตัวเองว่า
// "เว็บสล็อตทางการ ผู้ให้บริการฐานเกมหลัก" ตามบรีฟ — ไม่มีหมวดคาสิโน ไม่มีกีฬา
// และไม่ใช่เว็บหวย
// คำที่ห้ามหลุดกลับมาอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำ
// ต้องห้ามเจอ false positive · สองแบรนด์ก่อนหน้าขายตัวเองด้วยวลีที่บรีฟรอบนี้
// ไม่มีเลยสักคำ จึงต้องเขียนใหม่จากบรีฟ ไม่ใช่ find-and-replace ทับของเดิม
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกมแม้แต่ค่ายเดียว** จึงห้ามเขียนชื่อค่ายใดๆ
// ให้ใช้คำกลางว่า "ค่ายเกม" ตามบรีฟ
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 100% · 3 ขั้นตอน · 24ชม. ·
// อันดับ1 ห้ามแต่งใบอนุญาต หน่วยงานกำกับ ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP
// ยอดขั้นต่ำ จำนวนสมาชิก หรือปีใดๆ (บรีฟรอบนี้ไม่ได้เอ่ยปีไว้เลย) — หัวข้อสมัคร
// 3 ขั้นตอน กับแอดมิน LINE ของบรีฟ (บรรทัด 13-22) เป็นของ index.astro ไม่ใช่ของ
// หน้านี้ ห้ามยกมาเขียนซ้ำที่นี่
//
// พาเลตต์รอบนี้อยู่ใน .claude/brand-spec-sabuybet168.md §2 — **ฟ้าบับเบิลนำ
// ทองเป็นฮิวที่สอง น้ำเงินลึกไม่เคยถือตัวอักษร บนพื้นดำสนิท** (bg.json =
// {"mode":"color","color":"#000000"}) โลโก้คือ **แมวการ์ตูนขนขาวลายส้ม** ใส่
// ปลอกคอฟ้ามีกระดิ่งทอง นั่งคู่กับมือถือจอฟ้าและปึกแบงก์สีฟ้า เหนือคำว่า "สบาย"
// ตัวอักษรไทยหนาสามมิติ **สีทอง** ต่อด้วย "เบท168" สามมิติ **สีฟ้าบับเบิล**
// ฟ้าแบรนด์ #2f9ff5 · ฟ้าอ่อน #a8dcff · ทอง #ffc82e · เนื้อความ #e8f4ff
// (= BRAND_TEXT) · หมึกบนพื้นถมฟ้า/ทอง #04121f
// ชั้นผิว: ยก #0e2238 (= การ์ด ContentBox) / กลาง #081726 / จม #040d16
// ปุ่มนี้เป็น PRIMARY: ถมพื้น **ฟ้า** ไล่เฉด #a8dcff → #2f9ff5 ขอบ #0b3f78
// บนหมึกเข้ม #04121f (6.9:1 บนปลายเข้มสุด #2f9ff5)
// ⚠️ ห้ามกลับด้าน: พื้นถมฟ้าต้องใช้หมึก #04121f เสมอ ห้ามขาวหรือครีม และไล่เฉดต้อง
// **หยุดที่ #2f9ff5** ห้ามไล่ลงไปถึง #0b3f78 ใต้ตัวอักษร — น้ำเงินลึกให้ #04121f
// แค่ 1.4:1 และอยู่ได้เฉพาะเป็นเส้นขอบของปุ่มนี้
// — ส่วน /login เป็น SECONDARY ชั้นจมขอบทองบนตัวอักษรทอง จึงไม่ซ้ำกัน ·
// #0b3f78 (น้ำเงินลึก) และ #5c4a16 (ทองลึก) ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่
// เส้นขอบ ออรา พื้นถม และเงา — ออราในไฟล์นี้ใช้ rgba(47,159,245,α) เท่านั้น
// นอกจากเงาดำล้วน
// ⚠️ กับดักรอบนี้คือ **ทอง** เพราะห้ารอบหลังสุดมีทองเป็นฮิวนำหรือฮิวรองทุกรอบ
// "มีทองอยู่แล้ว" จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้ ทองรอบนี้คือ #ffc82e
// (255,200,46) และ **ฟ้าก็เป็นกับดักได้** เพราะมีแบรนด์เก่าในรีโปที่เคยเป็นฟ้า
// ฟ้ารอบนี้คือ #2f9ff5 (47,159,245) ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน
// brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ
// false positive
// และรอบนี้ **ไม่มีชมพู ไม่มีแดง ไม่มีม่วง ไม่มีเขียว ไม่มีส้ม ไม่มีเงิน/โครเมียม
// ไม่มีโรสโกลด์**
//
// Announcement หมุนมาเป็น Announcement2 ทั้งเว็บรอบนี้ (brand-spec §3 —
// รอบก่อนใช้ Announcement6 จึงหมุนออก) orchestrator ตั้ง default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare — ห้ามส่ง prop message
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) หน้านี้ยาว 158
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} เว็บสล็อตทางการ กดปุ่มเดียวไปยังหน้าลงทะเบียน ควรอ่านข้อกำหนดการเปิดบัญชี คุณสมบัติผู้ใช้งาน และนโยบายข้อมูลส่วนบุคคลก่อนกรอกข้อมูล`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} เว็บสล็อตทางการ เข้าเล่นสล็อตได้ทุกค่าย`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#0b3f78] bg-gradient-to-b from-[#a8dcff] to-[#2f9ff5] px-6 py-4 text-2xl font-black tracking-wide text-[#04121f] shadow-[0_10px_30px_rgba(47,159,245,0.4)] transition-all duration-300 hover:scale-105 hover:border-[#04121f] hover:shadow-[0_15px_40px_rgba(47,159,245,0.6)]">
        <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#a8dcff]/70 to-transparent"></div>
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
