---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 159.
const pageDescription =
  "หน้าสมัครสมาชิก KINDEE365 กดปุ่มเดียวเปิดยูสเซอร์ใหม่ด้วยตัวเอง เริ่มส่งโพยหวยรัฐบาลไทย ลาวพัฒนา ฮานอย และหุ้นต่างประเทศ พร้อมใช้ฝากถอนออโต้ผ่านธนาคารและวอลเลท";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก KINDEE365 เปิดยูสเซอร์ใหม่",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก KINDEE365 เปิดยูสเซอร์ใหม่ด้วยตัวเอง เริ่มส่งโพยได้ทันที" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก KINDEE365" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก KINDEE365"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#e8bb4a]/60 bg-gradient-to-r from-[#f8dc8c] via-[#e8bb4a] to-[#b98213] px-6 py-4 text-lg font-black text-[#010b26] shadow-[0_10px_30px_rgba(232,187,74,0.25)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(232,187,74,0.45)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
