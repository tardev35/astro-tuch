---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — this page is indexed and must not
// describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// This is the PRIMARY action of the pair, so it wears the solid gold gradient
// (#ebd484 → #c4a255 → #8a6d2c) under near-black ink (#000000); /login carries
// the deep-gold outline on the raised dark surface.
//
// Announcement รอบนี้หมุนมาใช้ Announcement3 ทั้งเว็บ — default message ของไฟล์นั้น
// เป็นคอปปี้ของ ENTER55 อยู่แล้ว จึงเรียกแบบ bare ไม่ต้องส่ง prop
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 151.
const pageDescription = "หน้าสมัครสมาชิก ENTER55 กดปุ่มเดียวเปิดยูสใหม่ด้วยระบบออโต้ 3 ขั้นตอน รองรับทุกธนาคารชั้นนำและ TrueMoney Wallet ฝากไม่มีขั้นต่ำ เริ่มเดิมพันเพียง 1 บาท";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก ENTER55",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก ENTER55 เปิดยูสใหม่ระบบออโต้ 3 ขั้นตอน ฝากไม่มีขั้นต่ำ" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก ENTER55" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก ENTER55"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ebd484] bg-gradient-to-r from-[#ebd484] via-[#c4a255] to-[#8a6d2c] px-6 py-4 text-lg font-black text-[#000000] shadow-[0_10px_30px_rgba(196,162,85,0.42)] transition-all duration-300 hover:scale-105 hover:border-[#ebd484] hover:shadow-[0_15px_40px_rgba(235,212,132,0.62)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
