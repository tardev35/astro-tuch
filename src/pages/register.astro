---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change (CtaRedirect.astro
// itself belongs to the orchestrator — ห้ามแก้ไฟล์นั้นจากหน้านี้)
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page, which means verify-build holds its
// description to the same 150–160 character window as every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES — คอปปี้ของหน้านี้จึงพูด
// ได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 14: ควรตรวจสอบคุณสมบัติผู้สมัคร อายุที่ได้รับ
// อนุญาต และข้อกำหนดการเปิดบัญชีจากเว็บไซต์ทางการก่อนลงทะเบียน · บรรทัด 16-18:
// อ่านนโยบายการจัดเก็บข้อมูลส่วนบุคคล ตั้งรหัสผ่านที่ปลอดภัย และไม่เปิดเผย
// รหัส OTP ให้ใครทราบ · บรรทัด 8: ก่อนเข้าร่วมโปรโมชั่นควรอ่านประกาศล่าสุด)
// ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า หน้านี้มีโควตาเป็นปุ่มเดียว
//
// ⚠️ แกนของบรีฟรอบนี้คือ **เว็บพนันออนไลน์ครบวงจร แทงบอล + สล็อต + บาคาร่า**
// ไม่ใช่เว็บสล็อตล้วนแบบรอบก่อน และไม่ใช่เว็บลอตเตอรีแบบสองรอบก่อน
// ศัพท์ของหมวดอื่นที่บรีฟไม่มีทุกคำจึงเป็นของค้างที่ห้ามหลุดกลับมา
// รายการคำเต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไป
// เจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// คำที่ใช้ได้รอบนี้: แทงบอล · ฟุตบอล · สล็อตออนไลน์ · บาคาร่า · ค่ายเกม ·
// เว็บตรง100% · ไม่ผ่านม้า · โปรโมชั่น · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% ·
// สมัครสมาชิก · ลงทะเบียน · คุณสมบัติผู้สมัคร · การเปิดบัญชี · ข้อมูลส่วนบุคคล ·
// เข้าสู่ระบบ · ฝากถอน · ไม่มีขั้นต่ำ · ไม่จำกัด · รหัสผ่าน · รหัส OTP ·
// เจ้าหน้าที่ · แอดมิน · 24ชม. · เว็บไซต์ทางการ · ประกาศล่าสุด · บัญชีแอบอ้าง
// ⚠️ **สองหน้าหมวดลอตเตอรีอยู่ใน src/pages-disabled/ รอบนี้**
// ห้ามลิงก์ไปสองเส้นทางนั้น route ไม่มีอยู่จริง build จะแดง
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกม ชื่อธนาคาร หรือใบอนุญาตแม้แต่รายเดียว**
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 100% · 24ชม. · 3 ขั้นตอน
// ห้ามแต่งใบอนุญาต หน่วยงานกำกับ ค่า RTP ยอดฝากขั้นต่ำ หรือจำนวนสมาชิก ·
// บรีฟมี "ขั้นตอนที่ 1-3" ของการสมัคร แต่นั่นเป็นของ index.astro
// (FeatureHighlights) **ห้ามยกมาเขียนซ้ำที่หน้านี้**
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตต์รอบนี้อยู่ใน .claude/brand-spec-ufabet168.md §2
// ⚠️⚠️ **รอบนี้กลับมาเป็น "ธีมมืด" หลังสามรอบติดที่เป็นธีมสว่าง — การ์ดผิวมืด
// หมึกครีม** bg.json = {"mode":"color","color":"#000000"} = **ดำสนิท** ไม่ใช่
// ชมพูพาสเทล การ์ด ContentBox จึงเป็นผิว #15130f บนหมึกครีม #eae3d4 (= BRAND_TEXT)
// ปุ่มนี้เป็น PRIMARY: ถม **ทองคานารี → ทองกลาง → ทองลึก**
// #fee45d → #e6a416 → #b8780d ขอบ #b8780d บนหมึก **เข้ม** #140e02
// (15.1 / 8.7 / 5.3:1 ผ่าน AA ทุก stop)
// ส่วน /login เป็น SECONDARY ถมโครเมียมเงิน #e8ecf1 → #a8b2bf → #78828f บนหมึก
// #0b0d10 จึงไม่ซ้ำกัน
// ⚠️ ปุ่มของ Navfoot อยู่บนแถบจม #0a0908 คนละโซนกับปุ่มบนการ์ดนี้
// **ห้ามลอกคลาสของ Navfoot มาวางบนการ์ด**
// ⚠️ ไล่เฉดต้อง **เริ่มที่ #fee45d แล้วเข้มลงถึง #b8780d** ห้ามลากปลายเข้มเลยค่านั้น
// (#7a4e05 เป็นขอบ/ออราเท่านั้น ถือตัวอักษรไม่ได้ที่ 2.4:1)
// และ **ห้ามกลับด้านเป็นตัวอักษรขาวบนพื้นทอง** ขั้วของปุ่มนี้คือพื้นทอง-หมึกเข้ม
// ชั้นตกแต่งของปุ่มจึงเป็นชั้น **สว่างขึ้น** ที่ขอบบน ไม่ใช่ชั้นเข้มลงแบบรอบก่อน
// ⚠️⚠️ **#5a6472 ก็ห้ามถือตัวอักษรเช่นกัน** (3.3:1) เป็นสีขอบ/พื้นเท่านั้น
// ออราในไฟล์นี้ใช้ rgba(254,228,93,α) · rgba(230,164,22,α) เท่านั้น
//
// ⚠️ กับดักรอบนี้คือ **ทองถูกใช้มาแล้วเกือบทุกแบรนด์ในรีโปนี้** "มีทองอยู่แล้ว" จึง
// ไม่พิสูจน์ว่าเป็นค่าของรอบนี้ ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน brand-spec §2
// ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive
// (⚠️ มีแบรนด์บอลรอบก่อนในรีโปที่เป็นทองเหมือนกัน ต้องเทียบทีละค่า)
// รอบนี้ **ไม่มีแดง ไม่มีเขียว ไม่มีชมพู/บานเย็น ไม่มีฟ้า/น้ำเงิน/ไซยาน
// ไม่มีม่วง ไม่มีโรสโกลด์ และไม่มีทองแดงไหม้**
//
// Announcement หมุนมาเป็น Announcement3 ทั้งเว็บรอบนี้ (brand-spec §3 — รอบก่อน
// ใช้ AnnouncementPremium จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์
// นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare — ห้ามส่ง prop message
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) หน้านี้ยาว 156
// ด้วยชื่อแบรนด์ 8 ตัวอักษรของรอบนี้ (ส่วนที่ไม่ใช่ชื่อแบรนด์ยาว 148 จึงรับชื่อ
// ได้ตั้งแต่ 2 ถึง 12 ตัวอักษร — ยาวกว่านั้นต้องตัดข้อความ ไม่ใช่ปล่อยผ่าน)
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} กดปุ่มเดียวไปยังขั้นตอนลงทะเบียน ควรอ่านข้อกำหนดการเปิดบัญชีและเงื่อนไขโปรโมชั่นให้ครบ และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้ผู้อื่น`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} ลงทะเบียนเพื่อเข้าใช้งานเกมเดิมพันและโปรโมชั่น`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#b8780d] bg-gradient-to-b from-[#fee45d] via-[#e6a416] to-[#b8780d] px-6 py-4 text-2xl font-black tracking-wide text-[#140e02] shadow-[0_10px_30px_rgba(254,228,93,0.4)] transition-all duration-300 hover:scale-105 hover:border-[#fee45d] hover:shadow-[0_15px_40px_rgba(230,164,22,0.55)]">
        <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#fee45d]/50 to-transparent"></span>
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
