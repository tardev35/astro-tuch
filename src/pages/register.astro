---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 154.
const pageDescription =
  "หน้าสมัครสมาชิก LEKDED กดปุ่มเดียวเปิดยูสเซอร์ใหม่ด้วยตัวเองได้ทันที เริ่มซื้อหวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยหุ้น พร้อมระบบฝากถอนออโต้ได้จากบัญชีเดียว";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก LEKDED เปิดยูสเซอร์ใหม่",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก LEKDED เปิดยูสเซอร์ใหม่ เริ่มซื้อหวยออนไลน์ได้ตลอดทั้งวัน" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก LEKDED" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก LEKDED"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#e2c466]/70 bg-gradient-to-r from-[#fbe479] via-[#e2c466] to-[#b5811e] px-6 py-4 text-lg font-black text-[#030803] shadow-[0_10px_30px_rgba(226,196,102,0.25)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(181,129,30,0.38)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
