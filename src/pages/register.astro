---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect. The title and
// description below are written for exactly that reason.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// HI59 (รอบฟ้าสว่าง + ทอง VIP บนการ์ดสว่าง 2026-10-07, brand-spec §2 — ฟ้า
// #0a84e0 มาจาก vivid ของ logo.webp ที่ตัวอักษร HI เป็นฟ้าสามมิติ ส่วนทอง
// #fdbc04 มาจากตัวเลข 59 กับวงแหวนโค้งในโลโก้เดียวกัน รอบก่อนเป็นแดง/เงินบนผิว
// เกือบดำ รอบนี้พลิกทั้งขั้วความสว่าง เพราะอาร์ตเวิร์กทั้งดรอปเป็นท้องฟ้ากลางวัน
// และ bg.json เป็นม่วงฟ้าอ่อน #c1cce6):
// ปุ่มนี้เป็นตัว PRIMARY ของคู่ จึงถม **ทอง** เต็มใบ (#ffe27a → #fdbc04 →
// #c88a02) ขอบทองเข้ม #c88a02 บนหมึก **กรมท่า #04203f** — กฎคอนทราสต์ของสเปก:
// พื้นทองห้ามใช้ตัวอักษรขาวหรือครีมเด็ดขาด
// ส่วน /login ถมฟ้าลึก #065a9c → #044b80 → #033f70 ขอบ #0a84e0 บนหมึก #eaf5ff
// สองลำดับ หนึ่งรูปแบบต่อหนึ่งปุ่ม ไม่ใช่ถมสีเดียวกันสองใบ ซึ่งจะอ่านเป็นปุ่มซ้ำกัน
// — และคู่ทอง/ฟ้านี้คือสองสีที่อยู่บนโลโก้จริง ตรงกับคู่ปุ่มของ NavbarStyle6 และ
// FooterStyle3 ที่ orchestrator รีธีมไว้แล้ว
// ชุดแดง+เงินของ หวยดีใจ (#dc0409 #f5363d #8e0206 #4b0205 #e8161c #eef0f4
// #c3c7d1 #f3c54e #edeaf0 #211016 #17080c rgba(220,4,9,*) rgba(245,54,61,*)
// rgba(195,199,209,*)) ออกครบแล้ว ห้ามนำกลับมา
//
// Announcement หมุนมาเป็น Announcement2 ทั้งเว็บรอบนี้ (รอบก่อนเป็น
// Announcement5) — default message ของไฟล์นั้นเป็นคอปปี้ของ HI59 แล้ว และ
// index ก็เรียกแบบ bare จึงห้ามส่ง prop message
//
// HI59 เป็น **เว็บสล็อต** ไม่ใช่เว็บหวย — คำหมวดหวย (หวย ส่งโพย โพย เลข 2 ตัว
// เลข 3 ตัว แนวทาง อัตราจ่าย งวด ผลรางวัล หวยลาว หวยฮานอย ธ.ก.ส.) ห้ามหลงเหลือ
// บรีฟบรรทัด 4 กับ 6 ระบุว่าสมาชิกรวมเกมสล็อตจากหลายค่ายไว้ในบัญชีเดียว สลับเกม
// และค่ายโดยไม่ต้องสมัครใหม่หลายครั้ง และเลือกค่าย ค้นหาเกม ตรวจสอบเครดิต
// โปรโมชั่น กับประวัติรายการได้เอง รองรับทั้งมือถือและคอมพิวเตอร์
// ตัวเลขที่ใช้ได้มีแค่ของบรีฟเอง: 0.3% / 0.8% / 100% / 24 ชั่วโมง — บรีฟรอบนี้
// ไม่ได้ระบุจำนวนขั้นตอนการสมัคร จึงห้ามเขียน "3 ขั้นตอน" ที่ค้างจากแบรนด์ก่อน
// และห้ามแต่งชื่อค่ายเกม ชื่อธนาคาร ยอดฝากขั้นต่ำ จำนวนสมาชิก ปีก่อตั้ง หรือ
// เลขใบอนุญาต ที่บรีฟไม่ได้ระบุ
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 154
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} กดปุ่มเดียวเปิดบัญชีเพื่อเข้าเล่นสล็อตจากค่ายเกมพรีเมียมในบัญชีเดียว พร้อมตรวจสอบเครดิต โปรโมชั่น และประวัติรายการได้ด้วยตัวเองทุกรอบ`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} เปิดบัญชีเองผ่านมือถือ เข้าเล่นสล็อตได้ในบัญชีเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#c88a02] bg-gradient-to-r from-[#ffe27a] via-[#fdbc04] to-[#c88a02] px-6 py-4 text-lg font-black text-[#04203f] shadow-[0_10px_30px_rgba(253,188,4,0.40)] transition-all duration-300 hover:scale-105 hover:border-[#8a6102] hover:shadow-[0_15px_40px_rgba(255,226,122,0.50)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
