---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 155.
const pageDescription =
  "หน้าสมัครสมาชิก UFAFOX กดปุ่มเดียวเปิดยูสเซอร์ใหม่ด้วยตัวเองได้ทันที เริ่มเล่นเกมสล็อต PG ค่ายแท้ พร้อมคำแนะนำ เทคนิค และสูตรบริหารเงินทุนให้ศึกษาฟรีทุกเกม";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก UFAFOX เปิดยูสเซอร์ใหม่",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก UFAFOX เปิดยูสเซอร์ใหม่ด้วยตัวเอง เริ่มเล่นเกมสล็อต PG ค่ายแท้" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก UFAFOX" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก UFAFOX"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f26a02]/70 bg-gradient-to-r from-[#ffb266] via-[#f26a02] to-[#8c3a01] px-6 py-4 text-lg font-black text-[#070403] shadow-[0_10px_30px_rgba(242,106,2,0.25)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(140,58,1,0.38)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
