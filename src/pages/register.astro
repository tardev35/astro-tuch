---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect. The title and
// description below are written for exactly that reason.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// หวย24 (รอบแดงแบรนด์ + ทอง บนดำอมแดง 2026-10-04, brand-spec §2 — แดง #d20a0a
// มาจาก vivid ของ logo.webp กับผ้าไหมแดงบนแบนเนอร์ ส่วนทอง #f5c33b / #ffd45e /
// #a9761a คือเหรียญทองและเวิร์ดมาร์ก หวย24 ที่สวมมงกุฎทอง รอบ หวยคิง ที่แล้วทอง
// เป็นสีหลักและสีรองเป็นครีมอมพีช รอบนี้กลับทิศเป็นแดงนำ ทองรอง):
// ปุ่มนี้เป็นตัว PRIMARY ของคู่ จึงสวมไล่เฉด **ทอง** เต็มใบ
// (#ffd45e → #f5c33b → #a9761a) ขอบทองลึก #a9761a บนตัวอักษร **ดำอมแดง #1a0303** —
// กฎคอนทราสต์: หมึกขาวบนทองสว่าง #ffd45e ได้ไม่ถึงเกณฑ์ พื้นทองจึงต้องใช้หมึกเข้ม
// เสมอ (#1a0303 บน #f5c33b ≈ 10:1 ผ่าน) และหมึกเนื้อความ #f7e2d6 บนพื้นทองก็ตก
// ส่วน /login ถมแดงเข้มสุด #2a0606 ในกรอบแดงแบรนด์ #d20a0a/60 บนตัวอักษร #f7e2d6
// สองลำดับ หนึ่งรูปแบบต่อหนึ่งปุ่ม ไม่ใช่ถมทองสองใบ ซึ่งจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม
// — และคู่ทอง/แดงนี้คือสองโทนที่อยู่บนอาร์ตเวิร์กจริง ตรงกับคู่ปุ่มของ
// NavbarStyle10 และ FooterStyle3 ที่ orchestrator รีธีมไว้แล้ว
// ชุดทองโลหะ + ครีมอมพีชของ หวยคิง (#cd9a2c #fdeb7c #ab7314 #f5e7c8 #fcd4c3
// #fce2d4 #1c140b #0c0b0a #120a02 rgba(205,154,44,*) rgba(253,235,124,*)) ออกครบแล้ว
//
// Announcement หมุนมาเป็น Announcement3 ทั้งเว็บรอบนี้ (รอบก่อน หวยคิง เป็น
// AnnouncementHuay) — default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ
// index ก็เรียกแบบ bare จึงห้ามส่ง prop message
//
// หวย24 เป็น **เว็บรับแทงหวยล้วน** ไม่ใช่คาสิโน บรีฟบรรทัด 16–17 ระบุการสมัครผ่าน
// มือถือได้เองด้วย 3 ขั้นตอน (เข้าหน้าสมัครและกรอกข้อมูลตามที่ระบบกำหนด → ยืนยัน
// ข้อมูลเพื่อสร้างบัญชีและ Login เข้าสู่ระบบ → เลือกหวย รอบ และเลขที่ต้องการ พร้อม
// ตรวจสอบอัตราจ่ายและยอดเดิมพันก่อนส่งโพย) แล้วใช้บัญชีเดียวติดตามหวยลาว หวยฮานอย
// รัฐบาลไทย แนวทางหวย ผลรางวัล และประวัติโพยได้
// ตัวเลขที่ใช้ได้มีแค่ 100 / 1,000 / 2 ตัว / 3 ตัว / 3 ขั้นตอน / 24 ชั่วโมง
// ห้ามแต่งตัวเลขอื่นขึ้นมาเอง และห้ามเอ่ยเวลาเปิด-ปิดรับของหวยรอบใดรอบหนึ่ง ชื่อ
// ธนาคาร ยอดฝากขั้นต่ำ จำนวนสมาชิก ปีก่อตั้ง หรือเลขใบอนุญาต ที่บรีฟไม่ได้ระบุ
// คำหมวดคาสิโน (สล็อต บาคาร่า คาสิโนสด ค่ายเกม RTP คืนยอดเสีย % แนะนำเพื่อน %)
// ห้ามหลงเหลือ
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 158
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} กดปุ่มเดียวเปิดบัญชีผ่านมือถือได้ใน 3 ขั้นตอน แล้ว Login เลือกหวยและรอบที่ต้องการ ตรวจอัตราจ่ายกับวงเงินรับแทงก่อนส่งโพยได้จากบัญชีเดียว`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} เปิดบัญชีเองผ่านมือถือ 3 ขั้นตอน ส่งโพยได้เลย`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#a9761a] bg-gradient-to-r from-[#ffd45e] via-[#f5c33b] to-[#a9761a] px-6 py-4 text-lg font-black text-[#1a0303] shadow-[0_10px_30px_rgba(245,195,59,0.45)] transition-all duration-300 hover:scale-105 hover:border-[#ffd45e] hover:shadow-[0_15px_40px_rgba(255,212,94,0.45)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
