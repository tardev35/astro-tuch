---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect. The title and
// description below are written for exactly that reason.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// DM899 (รอบเขียวมรกต-แดงสด-ทอง บนดำอมเขียว 2026-10-03, brand-spec §2 — มาจาก
// logo.webp ที่เป็นตัว D เขียว #01841b ซ้อนตัว M แดง #fb252b และเลข 899 เงินโครเมียม):
// ปุ่มนี้เป็นตัว PRIMARY ของคู่ จึงสวมไล่เฉด **เขียว** ประจำแบรนด์เต็มใบ
// (#4ade6b → #01a326 → #01841b) ขอบเขียวแกน #01841b บนตัวอักษร **ดำอมเขียว #06140a** —
// กฎคอนทราสต์: หมึกขาวบนเขียวอ่อน #4ade6b ได้ไม่ถึงเกณฑ์ พื้นเขียวจึงต้องใช้หมึกเข้ม
// เสมอ (#06140a บน #4ade6b ≈ 11:1 ผ่าน) และหมึกทองอ่อนบนพื้นเขียวก็ตก
// ส่วน /login เป็นแบบ outline (กรอบทองแบรนด์ #f2b422/60 + ตัวอักษรทองอ่อน #ffe9a8
// บนพื้นยกระดับ #102a16) สองลำดับ หนึ่งรูปแบบต่อหนึ่งปุ่ม ไม่ใช่ถมเขียวสองใบ ซึ่งจะ
// อ่านเป็นปุ่มซ้ำกันสองปุ่ม
// ชุดทอง-เงินโครเมียมของ 1SS365 (#edbb23 #ffeeb4 #a87708 #c8cbce #f1f2f3 #121010
// #f0e6d2 #050505 #2a2115 #f7d458 #1a1710 #c9930f rgba(237,187,35,*) rgba(5,5,5,*)
// rgba(247,212,88,*)) ออกครบแล้ว
//
// Announcement หมุนมาเป็น Announcement3 ทั้งเว็บรอบนี้ (รอบก่อนเป็น
// AnnouncementPremium) — default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ
// index ก็เรียกแบบ bare จึงห้ามส่ง prop message
//
// DM899 เป็นสล็อตคาสิโนออนไลน์เว็บตรงต่างประเทศ — ไม่ใช่เว็บหวยและไม่ใช่บอล
// บรีฟบรรทัด 15 ระบุการสมัครผ่านมือถือได้เองด้วย 3 ขั้นตอน (เข้าหน้าสมัครและกรอกข้อมูล
// ตามที่ระบบกำหนด → ยืนยันข้อมูลเพื่อเปิดบัญชีและ Login เข้าสู่ระบบ → เลือกประเภทเกม
// ที่ต้องการ พร้อมตรวจสอบโปรโมชั่นและรายละเอียดการเดิมพันก่อนเริ่มใช้งาน) แล้วใช้
// บัญชีเดียวเข้าถึงหมวดเกมที่ระบบรองรับ ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการ
// ตัวเลขที่ใช้ได้มีแค่ 0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง · 100%
// ห้ามแต่งตัวเลขอื่นขึ้นมาเอง
// คำศัพท์หวยของแบรนด์ก่อนหน้า (หวย แทงหวย ส่งโพย โพย เลือกเลข 2 ตัว 3 ตัว อัตราจ่าย
// งวด รัฐบาลไทย ฮานอย ลาวพัฒนา หวยหุ้น ตรวจหวย แนวทางหวย) ห้ามหลงเหลือ และห้ามเพิ่ม
// ชื่อค่ายเกม ชื่อธนาคาร ยอดฝากขั้นต่ำ ชื่อผู้ให้บริการจริง หรือเลขใบอนุญาต ที่บรีฟไม่ได้ระบุ
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 151
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} กดปุ่มเดียวเปิดบัญชีผ่านมือถือได้ใน 3 ขั้นตอน แล้ว Login เลือกประเภทเกม พร้อมตรวจสอบโปรโมชั่นและรายละเอียดการเดิมพันก่อนเริ่มเล่น`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} เปิดบัญชีเองผ่านมือถือ 3 ขั้นตอน เริ่มเล่นได้เลย`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#01841b] bg-gradient-to-r from-[#4ade6b] via-[#01a326] to-[#01841b] px-6 py-4 text-lg font-black text-[#06140a] shadow-[0_10px_30px_rgba(1,163,38,0.45)] transition-all duration-300 hover:scale-105 hover:border-[#ffe9a8] hover:shadow-[0_15px_40px_rgba(74,222,107,0.45)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
