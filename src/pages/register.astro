---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — this page is indexed and must not
// describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// This is the PRIMARY action of the pair on the FAH999 palette, so it wears the
// full gold-gradient fill (#fef354 → #fbbf13 → #ffdf6b) under the palette's
// text-on-gold ink (#1f0639); /login carries the same gold as an outline on the
// purple card surface instead. One accent, two brightnesses.
//
// Announcement รอบนี้หมุนมาใช้ Announcement3 ทั้งเว็บ — default message ของไฟล์
// นั้นเป็นคอปปี้ของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ไม่ต้องส่ง prop
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 156
const pageDescription = "หน้าสมัครสมาชิก FAH999 กดปุ่มเดียวเปิดบัญชีเพื่อเข้าเล่นสล็อตออโต้เว็บตรงที่รวมเกมจากหลายค่าย พร้อมตรวจสอบเงื่อนไขโปรโมชั่นและช่องทางฝากถอนได้จากบัญชีสมาชิก";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก FAH999",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก FAH999 เปิดบัญชีเล่นสล็อตออโต้เว็บตรง ติดอันดับมาแรง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก FAH999" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก FAH999"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fef354] bg-gradient-to-r from-[#fef354] via-[#fbbf13] to-[#ffdf6b] px-6 py-4 text-lg font-black text-[#1f0639] shadow-[0_10px_30px_rgba(251,191,19,0.45)] transition-all duration-300 hover:scale-105 hover:border-[#ffdf6b] hover:shadow-[0_15px_40px_rgba(255,223,107,0.5)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
