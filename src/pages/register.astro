---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// ⚠️ This page is NOT one of the "full custom HTML + own <style> block"
// standalone pages SKILL.md Phase 4.5 warns about — it renders through
// MainLayout + ContentBox like every other sub-page, so it has no
// .brand-identity string and no raw-hex <style> block of its own. The only
// brand colours here are the Tailwind arbitrary values on the button below.
// Do not "restore" a <style> block; the font link and the <html> colour come
// from MainLayout.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change (CtaRedirect.astro
// itself belongs to the orchestrator — ห้ามแก้ไฟล์นั้นจากหน้านี้)
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page (no `robots` prop = indexable), which means
// verify-build holds its description to the same 150–160 character window as
// every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) **ไม่มีส่วน SUB-PAGES** → title/description
// ของหน้านี้เขียนเอง และพูดได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 14: ควรตรวจสอบข้อกำหนด
// ด้านอายุ กฎหมายที่เกี่ยวข้อง และนโยบายความเป็นส่วนตัว · บรรทัด 16: ตรวจสอบที่อยู่
// เว็บไซต์ให้ถูกต้องและอ่านข้อกำหนดการเปิดบัญชี · บรรทัด 18: ไม่ควรเปิดเผยรหัสผ่าน
// และรหัส OTP ให้ใครทราบ)
// ⚠️ บรีฟรอบนี้ **มีหัวข้อขั้นตอนสมัครแทงหวยด้วยมือถือ 3 ขั้นตอนจริง แต่เป็นของ
// index.astro** (หัวข้อ H2 ที่ 6 ในเช็กลิสต์ brand-spec §4) **ไม่ใช่ของหน้านี้** —
// หน้านี้มีโควตาเป็น **ปุ่มเดียว** ห้ามแตกเป็นหัวข้อหรือรายการขั้นตอนบนหน้า
//
// 🚨 แกนของแบรนด์รอบนี้คือ **เว็บหวย/ลอตโต้ออนไลน์** ไม่ใช่หมวดเกมคาสิโนเหมือน
// สองรอบก่อน — คอปปี้เก่าของหน้านี้พูดถึงหมวดเกมที่ไม่ใช่แบรนด์นี้แล้ว เขียนใหม่ทั้งคู่
// ⚠️ น้ำเสียงของบรีฟรอบนี้คือ "โฆษณาและกำกับในประโยคเดียวกัน" ไม่ใช่การันตี
// คลังคำที่ใช้ได้รอบนี้อยู่ใน .claude/brand-spec-lotto189.md §5 (ไม่พิมพ์ซ้ำ
// ที่นี่ และ **ไม่พิมพ์คำของแบรนด์เก่าซ้ำที่นี่** เพื่อไม่ให้ sweep ของรอบถัดไป
// เจอ false positive ในคอมเมนต์ของไฟล์นี้เอง)
// ตัวเลขที่อ้างได้รอบนี้มีแค่ 2 ตัว 100 · 3 ตัว 1,000 · 3 ขั้นตอน · 24ชม. — ห้ามแต่ง
// ใบอนุญาต จำนวนสมาชิก ปีก่อตั้ง หรือค่าร้อยละใดๆ
// 🚨🚨 **บรีฟรอบนี้ไม่มีหมวดโปรโมชั่น ไม่พูดถึงธนาคาร วอลเลท หรือการฝากถอนเลย
// แม้แต่คำเดียว** — ห้ามเขียนถึงรายการฝากถอน ชื่อวอลเล็ต หรือค่าร้อยละของสิทธิ
// ประโยชน์ใดๆ บนหน้านี้ (ค่าร้อยละสองค่าที่พิมพ์อยู่บนอาร์ตเวิร์กสไลด์จริง ใช้ได้
// เฉพาะใน alt ที่บรรยายโปสเตอร์ ไม่ใช่ใน description — brand-spec §5)
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตรอบนี้อยู่ใน .claude/brand-spec-lotto189.md §2 — **เนื้อหาสว่าง โครมเข้ม**
// (ทิศเดียวกับรอบก่อน แต่คนละตระกูลสีทั้งชุด)
// bg.json = {"mode":"color","color":"#fff0f0"} = **ขาวอมชมพูจาง**
// (รอบก่อนเป็นครีมอมงาช้าง — ค่ามาจากไฟล์ ห้ามเดาว่าเท่าเดิม และห้าม "แก้"
// การ์ดให้มืดตามโครม)
// การ์ด ContentBox จึงเป็นผิว #ffffff บนหมึก #25090f (= BRAND_TEXT, 18.7:1)
// ปุ่มนี้เป็น **หลัก (primary)** ของพาเลต: ไล่เฉดแดงเลือดนก
// #8a0412 -> #b00718 -> #d61023 ขอบ #8a0412 บนหมึก **ขาว #ffffff**
// (10.4 / 7.3 / 5.3:1 ต่อ stop — ค่าที่ตรวจคอนทราสต์มาแล้ว ห้ามแก้เอง)
// ส่วน /login เป็น **รอง (secondary)**: ไล่เฉดขาว #ffffff -> #ffe4e6 บนหมึก
// แดงเลือดนกจม #25090f จึงไม่ซ้ำกัน
// 🚨🚨 **ห้ามลากสต็อปของปุ่มนี้ขึ้นไปถึง ff2436 หรือ e9b53c** — ขาวบนสองค่านั้น
// เหลือ 3.9 / 2.0:1 สองค่านั้นสงวนไว้เป็นขอบ/ออรา/พื้นถมบนโครมเข้ม
// · แผ่นไฮไลต์ด้านบนปุ่มจึงจำกัดที่ white/10 (stop บนยังผ่าน AA) **ห้ามเพิ่ม
// ความทึบของแผ่นนี้**
// 🚨🚨 **fff0f0 ffe4e6 ffd4d7 f5b9bd c3ccd6 ff2436 e9b53c ห้ามถือตัวอักษร
// บนผิวสว่างเอง** เป็นพื้นถม/ขอบ/ออราเท่านั้น และ a8333f เป็น **เส้น/ขอบ**
// เท่านั้น · ที่ถือตัวอักษรได้บนผิวสว่างชุดนี้คือ #25090f (18.7:1) · #6e3b44
// (8.8:1) · #b00718 (7.3:1) · #c1071b (6.6:1) · #8a0412 (10.4:1) · #8f6310
// (5.3:1) · #d61023 (คู่กับขาว 5.3:1)
// ⚠️⚠️ **24060c 3d0d16 120307 7e1221 ffeaea f0bcbc เป็นค่าของผิวโครมเข้ม
// เท่านั้น ห้ามหลุดเข้ามาในไฟล์นี้**
// ⚠️⚠️ **วัสดุของรอบนี้คือฉากห้องสีขาวครีม** อ่านจากอาร์ตเวิร์กตรงๆ: โลโก้เป็น
// เวิร์ดมาร์กสามมิติ ครึ่งแรกตัวอักษรละตินผิวโครเมียมเงินขัดเงาตัดขอบแดง
// ครึ่งหลังตัวเลขผิวแดงเลือดนกเคลือบเงา
// ⚠️⚠️ **หญิงสาวสวมสูทขาว อาร์มแชร์ขาวขอบทอง ลูกบอลหวยสีขาวพิมพ์เลข และโพยหวย
// กับปากกาสีทองเป็นวัตถุในภาพ ไม่ใช่สี UI** — พื้นเพจมาจาก bg.json เท่านั้น
// ⚠️ ปุ่มของ Navfoot อยู่บนแถบโครม **ผิวเข้ม** คนละโซนกับปุ่มบนการ์ดสว่างนี้
// **ห้ามลอกคลาสของ Navfoot มาวางบนการ์ด**
// ออราในไฟล์นี้ใช้ rgba(138,4,18,α) · rgba(214,16,35,α) เท่านั้น
//
// ⚠️⚠️ กับดักรอบนี้คือ **แดง/ทอง/ครีมเป็นตระกูลที่ผ่าน template นี้มาแล้วสิบกว่าเจ้า
// และเป็นตระกูลเดียวกับแบรนด์เมื่อสามรอบก่อนเป๊ะ** "มีแดงอยู่แล้ว" จึงไม่พิสูจน์ว่า
// เป็นค่าของรอบนี้ ให้เทียบเป็น **"ค่า" ทีละหลัก** กับตารางใน brand-spec §2
// ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive
// **ผิว/หมึกของรอบนี้คือ #fff0f0 / #ffffff / #ffe4e6 / #ffd4d7 / #f5b9bd /
// #a8333f / #25090f / #6e3b44 / #b00718 / #c1071b / #8a0412 / #d61023 /
// #8f6310 เท่านั้น** (และโครมเข้ม 24060c / 3d0d16 / 120307 / 7e1221 / ffeaea /
// f0bcbc / c3ccd6 / e9b53c / ff2436 ซึ่งอยู่ในไฟล์โครม ไม่ใช่ไฟล์นี้)
// รอบนี้ **ไม่มีม่วง ไม่มีฟ้า/ไซแอน ไม่มีแมเจนต้า/ชมพูบับเบิลกัม ไม่มีส้มเพลิง
// ไม่มีโรสโกลด์ และไม่มีเขียวแบรนด์** เลยสักเฉด · ปุ่ม LINE (#00B900) อยู่บน
// /about-us กับ /contact-us ไม่ใช่หน้านี้
//
// Announcement หมุนมาเป็นตัวท้ายชื่อ Huay ของตระกูล ทั้งเว็บรอบนี้ (brand-spec §3 —
// รอบก่อนใช้ตัวเลข 2 จึงหมุนออก · เขียนชื่อไฟล์แบบไม่มีเครื่องหมายคำพูดโดยตั้งใจ
// เพราะ tools/gen-tw-sources.mjs นับ literal ที่มีเครื่องหมายคำพูดว่าเป็นการ import
// จริง คอมเมนต์จึงทำให้ variant เก่าหลุดเข้า Tailwind scan แล้วสีของแบรนด์ก่อนขึ้น
// stylesheet) orchestrator เป็นเจ้าของ default message ของไฟล์นั้น จึงเรียกแบบ bare
// — **ห้ามส่ง prop message**
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) สตริงนี้ยาว 153
// ด้วยชื่อแบรนด์ 8 อักขระของรอบนี้ ส่วนที่ไม่ใช่ชื่อแบรนด์ยาว 145 → รับชื่อแบรนด์
// ได้ 5–15 อักขระ ถ้ารอบหน้าชื่อสั้นหรือยาวกว่านั้นต้องแก้ข้อความ ไม่ใช่ปล่อยผ่าน
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} เว็บหวยลอตโต้ กดปุ่มเดียวไปยังขั้นตอนลงทะเบียน ควรตรวจสอบข้อกำหนดด้านอายุ กฎหมายที่เกี่ยวข้อง และนโยบายความเป็นส่วนตัวให้ครบถ้วน`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/hx8w";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} เว็บหวยลอตโต้ แทงหวยออนไลน์ทุกประเภท`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#8a0412] bg-gradient-to-b from-[#8a0412] via-[#b00718] to-[#d61023] px-6 py-4 text-2xl font-black tracking-wide text-white shadow-[0_10px_30px_rgba(138,4,18,0.35)] transition-all duration-300 hover:scale-105 hover:border-[#d61023] hover:shadow-[0_15px_40px_rgba(214,16,35,0.45)]">
        <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-white/10 to-transparent"></span>
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
