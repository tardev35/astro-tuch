---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
//
// MAHAGAME66 (รอบแดง-ดำ-เงินโครเมียม 2026-09-24): ปุ่มนี้เป็นตัว PRIMARY ของคู่ จึง
// สวมไล่เฉดแดงของแบรนด์เต็มใบ (#ff4d52 → #de161d → #7a0a0e) บนตัวอักษร #fff6f5 ซึ่ง
// เป็นค่าเน้นที่คุมคอนทราสต์บนแดงได้ ส่วน /login ใช้แดงเดียวกันเป็นเส้นขอบบนผิวการ์ด
// ยก #26100f แทน — สองลำดับ หนึ่งการถมสีต่อหนึ่งปุ่ม ตามคู่แดง-เงินในโลโก้
// ชุดทอง-เขียวของ 888PARUAY (#fcdc2b #fff6ae #a87d0c #1fae1c #07130a) ออกครบแล้ว
//
// Announcement รอบนี้หมุนจาก Announcement3 มาเป็น Announcement5 ทั้งเว็บ —
// default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ index ก็เรียกแบบ bare
// จึงห้ามส่ง prop
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 157
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = "สมัครสมาชิก MAHAGAME66 กดปุ่มเดียวเปิดบัญชีใหม่ด้วยตัวเอง รองรับมือถือและคอมพิวเตอร์ จากนั้นเข้าสู่ระบบเลือกบาคาร่า สล็อต หวย บอล รูเล็ต และเกมไลฟ์สดได้ทันที";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก MAHAGAME66",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="สมัครสมาชิก MAHAGAME66 เปิดบัญชีใหม่ด้วยตัวเอง เล่นได้จากบัญชีเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก MAHAGAME66" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก MAHAGAME66"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ff4d52] bg-gradient-to-r from-[#ff4d52] via-[#de161d] to-[#7a0a0e] px-6 py-4 text-lg font-black text-[#fff6f5] shadow-[0_10px_30px_rgba(222,22,29,0.50)] transition-all duration-300 hover:scale-105 hover:border-[#e2e8ef] hover:shadow-[0_15px_40px_rgba(226,232,239,0.40)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
