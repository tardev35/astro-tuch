---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char).
const pageDescription =
  "หน้าสมัครสมาชิก CREEKBET เกมคาสิโนเว็บแท้ สำหรับผู้ที่ต้องการเปิดบัญชีใหม่ รับโบนัสแนะนำเพื่อน 0.8% และคืนยอดเสียทุกวัน 0.3% ตามเงื่อนไขที่กำหนด ฝากถอนออโต้";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก CREEKBET เปิดบัญชีใหม่",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก CREEKBET เกมคาสิโนเว็บแท้ เปิดบัญชีใหม่ รับโบนัสได้ทุกวัน 24 ชั่วโมง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก CREEKBET" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก CREEKBET"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f4f6f8]/70 bg-gradient-to-r from-[#f4f6f8] via-[#cfd4da] to-[#9aa2ab] px-6 py-4 text-lg font-black text-[#0a0b0d] shadow-[0_10px_30px_rgba(207,212,218,0.25)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(192,36,52,0.30)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
