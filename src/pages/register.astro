---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — this page is indexed and must not
// describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// This is the PRIMARY action of the pair on the ABM96 palette, so it wears
// the full pink-gradient fill (#ffc9dc → #fd6494 → #b8325f) under the palette's
// text-on-pink ink (#12030a); /login carries the same pink as an outline on the
// dark card surface instead. One accent, two brightnesses.
//
// Announcement รอบนี้หมุนมาใช้ Announcement3 ทั้งเว็บ — default message ของไฟล์นั้น
// เป็นคอปปี้ของแบรนด์นี้อยู่แล้วและ index ก็เรียกแบบ bare จึงห้ามส่ง prop
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 160
const pageDescription = "หน้าสมัครสมาชิก ABM96 กดปุ่มเดียวเปิดบัญชีใหม่ได้ด้วยตัวเอง กรอกข้อมูล ตรวจสอบความถูกต้อง แล้วยืนยัน จากนั้นเข้าสู่ระบบเลือกบาคาร่า สล็อต หวย ไฮโล หรือบอลได้เลย";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก ABM96",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก ABM96 เปิดบัญชีใหม่ใน 3 ขั้นตอน เล่นได้ครบในบัญชีเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก ABM96" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก ABM96"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ffc9dc] bg-gradient-to-r from-[#ffc9dc] via-[#fd6494] to-[#b8325f] px-6 py-4 text-lg font-black text-[#12030a] shadow-[0_10px_30px_rgba(253,100,148,0.45)] transition-all duration-300 hover:scale-105 hover:border-[#ffc9dc] hover:shadow-[0_15px_40px_rgba(255,201,220,0.5)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
