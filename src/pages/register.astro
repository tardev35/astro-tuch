---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change.
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page, which means verify-build holds its
// description to the same 150–160 character window as every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES — คอปปี้ของหน้านี้จึงพูด
// ได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 14: ควรอ่านข้อกำหนดการเปิดบัญชี เงื่อนไขการใช้งาน
// และรายละเอียดของค่ายเกมที่เปิดให้บริการจริงก่อนลงทะเบียน และบรรทัด 16:
// ตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง พร้อมอ่านเรื่องคุณสมบัติผู้ใช้งาน)
// ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า หน้านี้มีโควตาเป็นปุ่มเดียว
//
// ⚠️ แบรนด์รอบนี้เป็น **เว็บสล็อตล้วน** ที่มีแกนเรื่อง **ความง่ายในการถอนเงิน**
// ตามบรีฟ — ไม่ใช่หมวดอื่นใดทั้งสิ้น
// คำที่ห้ามหลุดกลับมาอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำ
// ต้องห้ามเจอ false positive · แบรนด์ก่อนขายตัวเองด้วยวลีที่บรีฟรอบนี้ไม่มีเลยสักคำ
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกมแม้แต่ค่ายเดียว** จึงห้ามเขียนชื่อค่ายใดๆ
// ให้ใช้คำกลางว่า "ค่ายเกม" ตามบรีฟ
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 100% · 3 ขั้นตอน · 24 ชม. ·
// หลักแสนยูสต่อวัน ห้ามแต่งใบอนุญาต หน่วยงานกำกับ ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP
// ยอดขั้นต่ำ จำนวนสมาชิก หรือปีใดๆ (บรีฟรอบนี้ไม่ได้เอ่ยปีไว้เลย) — หัวข้อสมัคร
// 3 ขั้นตอนกับแอดมิน LINE ของบรีฟ (บรรทัด 13-22) เป็นของ index.astro ไม่ใช่ของ
// หน้านี้ ห้ามยกมาเขียนซ้ำที่นี่
//
// แบรนด์รอบนี้ (ถอนชัวร์168, รอบ **ชมพูบับเบิลกัมนำ ทองเนยเป็นฮิวที่สอง พลัมเข้ม
// ไม่เคยถือตัวอักษร บนดำสนิท** 2026-10-18, brand-spec §2): โลโก้คือ **แมวการ์ตูน
// สีขาว-ชมพู** หน้ายิ้มหลับตา นั่งคู่กับมือถือจอชมพูที่มีลูกศรดาวน์โหลด อยู่เหนือ
// คำว่า "ถอน" ตัวอักษรไทยหนาสามมิติ **สีทองเนยตัดขอบชมพู** ต่อด้วย "ชัวร์168"
// สามมิติ **สีชมพูบับเบิลกัมตัดขอบทอง** —
// **ชมพูบับเบิลกัม #fa63b9 คือฮิวนำของรอบนี้ ทองเนย #ffd84d เป็นฮิวที่สอง**
// พลัมเข้ม #6d0b3f · ทองลึก #6b4708 (สองตัวนี้ห้ามถือตัวอักษร) ·
// ตัวที่ถือตัวอักษรได้: ทองเนย #ffd84d (12.7:1) · ชมพูอ่อน #ffb3de (10.7:1) ·
// ชมพูบับเบิลกัม #fa63b9 (7.7:1 บนดำ) ·
// เนื้อความ #fdeaf5 (= BRAND_TEXT) · หมึกบนพื้นถมชมพู #2a0617
// ชั้นผิว: ยก #2b0f20 (= การ์ด ContentBox) / กลาง #1a0914 / จม #0d040a /
// พื้นเพจ #000000 — bg.json รอบนี้เป็นดำสนิท
// ปุ่มนี้เป็น PRIMARY: ถมพื้น **ชมพู** ไล่เฉด #ffb3de → #fa63b9 ขอบ #6d0b3f
// บนหมึกเข้ม #2a0617 (7.0:1 บนปลายเข้มสุด #fa63b9)
// ⚠️ ห้ามกลับด้าน: พื้นถมชมพูต้องใช้หมึก #2a0617 เสมอ ห้ามขาวหรือครีม และไล่เฉดต้อง
// **หยุดที่ #fa63b9** ห้ามไล่ลงไปถึง #6d0b3f ใต้ตัวอักษร — พลัมเข้มอยู่ได้เฉพาะเป็น
// เส้นขอบของปุ่มนี้
// — ส่วน /login เป็น SECONDARY ชั้นจมขอบทองเนยบนตัวอักษรทองเนย จึงไม่ซ้ำกัน ·
// #6d0b3f #6b4708 ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่เส้นขอบ ออรา พื้นถม และเงา —
// ออราในไฟล์นี้ใช้ rgba(250,99,185,α) เท่านั้น นอกจากเงาดำล้วน
// ⚠️ กับดักรอบนี้มีสองชั้นคือ **ชมพู** และ **ทอง** เพราะรอบที่แล้วก็เป็นทอง+ชมพู
// บนดำเหมือนกัน "มีทอง/มีชมพูอยู่แล้ว" จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้
// ชมพูรอบนี้คือ #fa63b9 (250,99,185) ทองรอบนี้คือ #ffd84d (255,216,77)
// ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive
// และรอบนี้ **ไม่มีม่วง ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว ไม่มีส้ม ไม่มีเงิน/โครเมียม
// ไม่มีโรสโกลด์ ไม่มีแดงชาด**
//
// Announcement หมุนมาเป็น Announcement6 ทั้งเว็บรอบนี้ (brand-spec §3 —
// รอบก่อนใช้ Announcement3 จึงหมุนออก) orchestrator ตั้ง default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare — ห้ามส่ง prop message
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) หน้านี้ยาว 157
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} กดปุ่มเดียวไปยังหน้าลงทะเบียนของเว็บสล็อตฐานหลักถอนง่าย ควรอ่านข้อกำหนดการเปิดบัญชี คุณสมบัติผู้ใช้งาน และเงื่อนไขบริการก่อนสมัคร`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} ลงทะเบียนกับฐานหลักเว็บสล็อตถอนง่าย`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#6d0b3f] bg-gradient-to-b from-[#ffb3de] to-[#fa63b9] px-6 py-4 text-2xl font-black tracking-wide text-[#2a0617] shadow-[0_10px_30px_rgba(250,99,185,0.4)] transition-all duration-300 hover:scale-105 hover:border-[#2a0617] hover:shadow-[0_15px_40px_rgba(250,99,185,0.6)]">
        <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ffb3de]/70 to-transparent"></div>
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
