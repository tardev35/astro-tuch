---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char).
const pageDescription =
  "หน้าสมัครสมาชิก HENGDEE89 เว็บพนันออนไลน์รวมครบทุกการเดิมพัน สำหรับผู้เปิดบัญชีใหม่ รับโบนัสแนะนำเพื่อน 0.8% และคืนยอดเสียทุกวัน 0.3% ตามเงื่อนไขที่กำหนด";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก HENGDEE89 เปิดบัญชีใหม่",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก HENGDEE89 เปิดบัญชีใหม่ เริ่มเดิมพันออนไลน์ครบทุกรูปแบบได้ทันที 24 ชั่วโมง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก HENGDEE89" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก HENGDEE89"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ffe98a]/70 bg-gradient-to-r from-[#f5322e] via-[#ffe98a] to-[#fdd32d] px-6 py-4 text-lg font-black text-[#1c0707] shadow-[0_10px_30px_rgba(253,211,45,0.25)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(253,211,45,0.35)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
