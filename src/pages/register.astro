---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// This is the PRIMARY action of the pair, so it wears the solid logo-crimson
// gradient (#f0435f → #cd1437 → #7a0a20) under silver-bright text; /login
// carries the outline. Pale rose (#ffb3bf) stays a text-highlight colour on this
// brand and does not fill a button.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 157.
const pageDescription = "หน้าสมัครสมาชิก NEXT55 กดปุ่มเดียวเปิดบัญชีใหม่ด้วยตัวเอง 3 ขั้นตอน เดิมพันเริ่มต้น 1 บาท ไม่มีขั้นต่ำฝาก-ถอน รองรับทุกธนาคารและ TrueMoney Wallet ตลอด 24 ชม.";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก NEXT55",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก NEXT55 เปิดบัญชีใหม่ด้วยตัวเอง เริ่มเดิมพัน 1 บาททุกเกม" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก NEXT55" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก NEXT55"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f0435f]/70 bg-gradient-to-r from-[#f0435f] via-[#cd1437] to-[#7a0a20] px-6 py-4 text-lg font-black text-[#e7eaef] shadow-[0_10px_30px_rgba(205,20,55,0.28)] transition-all duration-300 hover:scale-105 hover:border-[#ffb3bf] hover:shadow-[0_15px_40px_rgba(205,20,55,0.48)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
