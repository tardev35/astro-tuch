---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change.
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page, which means verify-build holds its
// description to the same 150–160 character window as every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES — คอปปี้ของหน้านี้จึงพูด
// ได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 10–13: คืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อน
// โบนัส 0.8% ไม่จำกัด) ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า หน้านี้มีโควตาเป็นปุ่มเดียว
// บรีฟยังกำกับเองว่าคำว่า "ไม่จำกัด" ควรระบุให้ชัดว่าหมายถึงอะไร คอปปี้ตรงนี้จึงเขียน
// ว่าโบนัส 0.8% เป็นไปตามเกณฑ์ที่กำหนด แทนที่จะโปรยคำว่าไม่จำกัดลอยๆ
//
// ⚠️ แบรนด์รอบนี้เป็น **คาสิโน** (บาคาร่า · ไฮโล · สล็อต) ตามบรีฟ — ไม่มีคำเกี่ยวกับ
// กีฬา/บอล และไม่มีคำเกี่ยวกับหวยเลย คำที่ห้ามหลุดกลับมาอยู่ใน brand-spec §7
// ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำต้องห้ามเจอ false positive · แบรนด์รอบก่อน
// (TKB55) ขายกรอบ "เว็บคาสิโนไทย / ฝากถอนทุกธนาคาร / บอลออนไลน์" ซึ่งบรีฟรอบนี้
// ไม่มีเลยสักคำ
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 24 ชั่วโมง — ห้ามแต่งใบอนุญาต
// หน่วยงานกำกับ ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP ยอดขั้นต่ำ จำนวนสมาชิก หรือปีใดๆ
// (บรีฟรอบนี้ไม่ได้เอ่ยปีไว้เลย) — หัวข้อสมัคร 3 ขั้นตอนกับแอดมิน 24 ชั่วโมงของบรีฟ
// (บรรทัด 14–21) เป็นของ index.astro ไม่ใช่ของหน้านี้ ห้ามยกมาเขียนซ้ำที่นี่
//
// แบรนด์รอบนี้ (GT66B, รอบแดงมังกร-โครเมียมขาวบนดำสนิท 2026-10-13,
// brand-spec §2): **สองโทนจริง: แดงมังกรนำ โครเมียมขาวรอง** ไม่มีทองในดรอปนี้
// แดงแบรนด์ #fb141b · แดงลึก #db040b #8a0609 #3b0405 ·
// ตัวที่ถือตัวอักษรได้: โครเมียม #fdfcfd (18.5:1) #b4bcc2 (9.9:1) ·
// แดงอ่อนไฮไลต์ #ffa0a2 (9.8:1) · แดงสว่าง #ff5f63 (6.4:1) ·
// เนื้อความ #eceaea (= BRAND_TEXT) · หมึกบนพื้นสว่าง/พื้นถมแดง #190505
// ชั้นผิว: ยก #1c0c0b (= การ์ด ContentBox) / กลาง #130c0c / จม #0b0303 /
// พื้นเพจ #000000 — รอบนี้ bg.json เป็นดำสนิท
// ปุ่มนี้เป็น PRIMARY: ถมพื้นแดงไล่เฉด #ffa0a2 → #fb141b ขอบ #db040b
// บนหมึกเข้ม #190505 (9.9:1 บนปลายสว่าง #ffa0a2 · 5.0:1 บนปลายเข้มสุด #fb141b)
// ⚠️ ห้ามกลับด้าน: พื้นถมแดงต้องใช้หมึกเข้มเสมอ ห้ามขาวหรือครีม และไล่เฉดต้อง
// **หยุดที่ #fb141b** ห้ามไล่เข้มกว่านั้นใต้ตัวอักษร — #db040b อยู่ได้เฉพาะเป็น
// เส้นขอบของปุ่มนี้ (บนหมึก #190505 ได้แค่ 3.0:1)
// — ส่วน /login เป็น SECONDARY ชั้นจมขอบแดง จึงไม่ซ้ำกัน · #fb141b #db040b
// #8a0609 #3b0405 ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่เส้นขอบ ออรา พื้นถม
// และเงา — ออราในไฟล์นี้ใช้ rgba(251,20,27,α) เท่านั้น นอกจากเงาดำล้วน
// ⚠️ กับดักรอบนี้คือ **แดง** และหนักเป็นพิเศษ เพราะแบรนด์ก่อนหน้าทันที (TKB55)
// ก็เป็นแดง-โลหะ-ดำเหมือนกัน แดงของมันคือ #fb131b ส่วนรอบนี้คือ #fb141b —
// ต่างกันหนึ่งหลัก "มีแดงอยู่แล้ว" จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้ ให้เทียบเป็น "ค่า"
// ทีละตัวกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของ
// แบรนด์เก่าเจอ false positive — ชุดแดงเลือดนก-เงินโครเมียมของ TKB55 ออกครบทุกจุด
// ในไฟล์นี้แล้ว
// และรอบนี้ **ไม่มีทอง ไม่มีม่วง ไม่มีชมพู ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว
// ไม่มีส้ม**
//
// Announcement หมุนมาเป็น Announcement2 ทั้งเว็บรอบนี้ (brand-spec §3 — รอบก่อน
// TKB55 ใช้ Announcement5 จึงหมุนออก) orchestrator ตั้ง default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare — ห้ามส่ง prop message
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) หน้านี้ยาว 154
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} กดปุ่มเดียวไปยังทางเข้าหลักของคาสิโนเซิร์ฟนอก พร้อมโปรโมชั่นคืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อน โบนัส 0.8% ตามเกณฑ์ที่กำหนด`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/2u19";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} คาสิโนเซิร์ฟนอก สมัครจากทางเข้าหลัก`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#db040b] bg-gradient-to-b from-[#ffa0a2] to-[#fb141b] px-6 py-4 text-2xl font-black tracking-wide text-[#190505] shadow-[0_10px_30px_rgba(251,20,27,0.4)] transition-all duration-300 hover:scale-105 hover:border-[#190505] hover:shadow-[0_15px_40px_rgba(251,20,27,0.6)]">
        <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ffa0a2]/70 to-transparent"></div>
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
