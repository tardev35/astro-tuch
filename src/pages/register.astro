---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change (CtaRedirect.astro
// itself belongs to the orchestrator — ห้ามแก้ไฟล์นั้นจากหน้านี้)
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page, which means verify-build holds its
// description to the same 150–160 character window as every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES — คอปปี้ของหน้านี้จึงพูด
// ได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 14: ก่อนดำเนินการควรตรวจสอบคุณสมบัติผู้สมัคร
// ข้อกำหนดด้านอายุ และกฎหมายที่เกี่ยวข้อง รวมถึงศึกษานโยบายความเป็นส่วนตัวเพื่อ
// ทำความเข้าใจวิธีจัดเก็บข้อมูลส่วนบุคคล · บรรทัด 16-18: ตรวจสอบที่อยู่เว็บไซต์
// ให้ถูกต้อง อ่านเงื่อนไขการเปิดบัญชี ตั้งรหัสผ่านที่คาดเดาได้ยาก และไม่เปิดเผย
// รหัส OTP ให้ใครทราบ · บรรทัด 8: ก่อนเข้าร่วมโปรโมชั่นควรอ่านประกาศล่าสุด)
// ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า หน้านี้มีโควตาเป็นปุ่มเดียว
//
// ⚠️ แกนของบรีฟรอบนี้คือ **เว็บสล็อตออนไลน์ "เกมสล็อตจ่ายแพง ปรับเรทแตกหนักที่สุด
// ในวงการ"** ไม่ใช่แกนของรอบก่อน และไม่ใช่เว็บลอตเตอรีแบบรอบก่อนหน้านั้น
// ศัพท์ของหมวดอื่นที่บรีฟไม่มีทุกคำจึงเป็นของค้างที่ห้ามหลุดกลับมา
// รายการคำเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไป
// เจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// คำที่ใช้ได้รอบนี้: สล็อต · เกมสล็อต · เกมสล็อตออนไลน์ · จ่ายแพง · ปรับเรท ·
// แตกหนัก · อัตราจ่าย · ระดับการเดิมพัน · เดิมพันไม่มีขั้นต่ำ · ทุนน้อยเล่นได้ ·
// ไม่อั้นจ่าย · ไม่อั้นถอน · กติกา · ตารางจ่ายรางวัล · ค่า RTP · ผู้พัฒนา ·
// ยอดฝากขั้นต่ำ · วงเงินถอน · เพดานธุรกรรม · ข้อกำหนดล่าสุด · โปรโมชั่น ·
// คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · กดรับได้ไม่จำกัด · เครดิต · สมัครสมาชิก ·
// เข้าสู่ระบบ · ยืนยันบัญชี · คุณสมบัติผู้สมัคร · ข้อกำหนดด้านอายุ ·
// นโยบายความเป็นส่วนตัว · ข้อมูลส่วนบุคคล · รหัสผ่าน · รหัส OTP · แอดมิน ·
// เจ้าหน้าที่ · 24ชม. · เว็บไซต์ทางการ · ประกาศล่าสุด · บัญชีแอบอ้าง · ฝากถอน
// ⚠️⚠️ **คำคู่ของแบรนด์เก่าที่ต่อท้ายชื่อ route /ทดลองเล่น ด้วย ฟรี / โหมด~
// ไม่ใช่คำของบรีฟรอบนี้** (คำเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่)
// ⚠️ **สองหน้าหมวดลอตเตอรีอยู่ใน src/pages-disabled/ รอบนี้**
// ห้ามลิงก์ไปสองเส้นทางนั้น route ไม่มีอยู่จริง build จะแดง
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกม ชื่อธนาคาร ชื่อวอลเล็ต หน่วยงานกำกับ หรือ
// ใบอนุญาตแม้แต่รายเดียว**
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 3 ขั้นตอน · 24ชม.
// **ไม่มี "1,000 เกม" และไม่มี "100%"** สองค่านั้นเป็นของแบรนด์ขาออก (เงินทอง168)
// ห้ามแต่งใบอนุญาต ค่า RTP ที่เป็นตัวเลข ยอดฝากขั้นต่ำ หรือจำนวนสมาชิก ·
// บรีฟมี "ขั้นตอนที่ 1-3" ของการสมัคร แต่นั่นเป็นของ index.astro
// (FeatureHighlights) **ห้ามยกมาเขียนซ้ำที่หน้านี้**
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตต์รอบนี้อยู่ใน .claude/brand-spec-ruaythear168club.md §2
// ⚠️⚠️ **รอบนี้กลับทิศจากรอบก่อน 180 องศา — เป็น "ธีมสว่าง" การ์ดผิวขาว หมึกเข้ม**
// bg.json = {"mode":"color","color":"#dbe6ff"} = **ฟ้าเพอริวิงเคิลอ่อน**
// (รอบก่อนเป็น 29210f = น้ำตาลโอลีฟเข้ม — ค่ามาจากไฟล์ ห้ามเดาว่าเท่าเดิม)
// การ์ด ContentBox จึงเป็นผิว #ffffff บนหมึกเข้ม #16294a (= BRAND_TEXT)
// ปุ่มนี้เป็น **หลัก (primary)**: พื้นไล่เฉดฟ้าเข้ม #0d6b9b -> ฟ้าลึก #0a5176
// ขอบ #0a5176 บนหมึก **ขาว** #ffffff (5.6 / 8.0:1 — ผ่านทั้งสอง stop)
// ส่วน /login เป็น **เน้น (accent)**: พื้นถม #18a5e2 บนหมึก #111a3f จึงไม่ซ้ำกัน
// ⚠️ ไล่เฉดต้อง **เริ่มที่ #0d6b9b แล้วเข้มลงถึง #0a5176** ห้ามลากปลายเข้มเลยค่านั้น
// และห้ามสลับเป็นพื้นถม #18a5e2 เพราะหมึกขาวบนค่านั้นเหลือ 2.6:1
// 🚨🚨 **#18a5e2 ห้ามถือตัวอักษรบนผิวสว่าง และห้ามรับตัวอักษรสีขาวทับบนตัวมันเอง**
// ⚠️⚠️ **วัสดุที่สองของรอบนี้คือครีมอุ่น #f4e4d3 ไม่ใช่เทาโครเมียม** — แรมป์เทาเงิน
// (e0e0df c0c0bf a1a09e / e8ecf1 a8b2bf) เป็นของ พักยก168 กับ ยูฟ้า168 ไปแล้ว
// **ห้ามยกกลับเข้ามาเป็นสี UI** ถึงแม้เลข 168 ในโลโก้รอบนี้จะเป็นโครเมียมจริง
// ⚠️ ปุ่มของ Navfoot อยู่บนแถบโครมคนละโซนกับปุ่มบนการ์ดนี้
// **ห้ามลอกคลาสของ Navfoot มาวางบนการ์ด**
// ออราในไฟล์นี้ใช้ rgba(13,107,155,α) กับ rgba(255,255,255,α) เท่านั้น
//
// ⚠️⚠️ กับดักรอบนี้คือ **ฟ้าเคยผ่านรีโปนี้มาแล้วห้าเจ้า** (สบาย168 · รวยแทร่168 ·
// นินจา168 · สบายเบท168 · TSDET911) "มีฟ้าอยู่แล้ว" จึงไม่พิสูจน์ว่าเป็นค่าของ
// รอบนี้ ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive
// รอบนี้ **ไม่มีทอง/เหลือง ไม่มีแดง ไม่มีเขียว (ยกเว้น LINE green ที่หน้าอื่น)
// ไม่มีชมพู ไม่มีม่วง ไม่มีส้ม ไม่มีน้ำตาล ไม่มีโรสโกลด์ และไม่มีแรมป์เทาเงิน**
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ (brand-spec §3 — รอบก่อนใช้
// Announcement2 จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์
// นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare — ห้ามส่ง prop message
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) ส่วนที่ไม่ใช่ชื่อแบรนด์
// ยาว 147 อักขระ จึงรับชื่อแบรนด์ได้ตั้งแต่ 3 ถึง 13 ตัวอักษร — นอกช่วงนั้นต้องแก้
// ข้อความ ไม่ใช่ปล่อยผ่าน รอบนี้ชื่อยาว 9 ตัวอักษร รวมเป็น 156
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} กดปุ่มเดียวไปยังขั้นตอนลงทะเบียน ควรตรวจสอบคุณสมบัติผู้สมัคร ข้อกำหนดด้านอายุ และนโยบายความเป็นส่วนตัวก่อนกรอกข้อมูลและยืนยันบัญชี`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} ลงทะเบียนเพื่อเข้าใช้งานเกมสล็อตและโปรโมชั่นสมาชิก`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#0a5176] bg-gradient-to-b from-[#0d6b9b] to-[#0a5176] px-6 py-4 text-2xl font-black tracking-wide text-[#ffffff] shadow-[0_10px_30px_rgba(13,107,155,0.35)] transition-all duration-300 hover:scale-105 hover:border-[#18a5e2] hover:shadow-[0_15px_40px_rgba(13,107,155,0.5)]">
        <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ffffff]/20 to-transparent"></span>
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
