---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 150.
const pageDescription =
  "หน้าสมัครสมาชิก JUDTEM168 กดปุ่มเดียวเปิดยูสเซอร์ใหม่ด้วยตัวเอง เริ่มเลือกเกมสล็อตจาก PG SOFT, Pragmatic Play, JILI, JDB และ Habanero ได้จากบัญชีเดียว";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก JUDTEM168 เปิดยูสเซอร์ใหม่",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก JUDTEM168 เปิดยูสเซอร์ใหม่ เริ่มเล่นเกมสล็อตได้ตลอดทั้งวัน" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก JUDTEM168" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก JUDTEM168"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#e8bf4e]/70 bg-gradient-to-r from-[#e8bf4e] via-[#cc9c2d] to-[#6a5115] px-6 py-4 text-lg font-black text-[#050301] shadow-[0_10px_30px_rgba(232,191,78,0.25)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(204,156,45,0.35)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
