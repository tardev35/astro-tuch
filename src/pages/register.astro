---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change (CtaRedirect.astro
// itself belongs to the orchestrator — ห้ามแก้ไฟล์นั้นจากหน้านี้)
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page, which means verify-build holds its
// description to the same 150–160 character window as every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES — คอปปี้ของหน้านี้จึงพูด
// ได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 3-4: ระบบสล็อตเว็บนอก ทางเข้าเล่นฐานเกมหลัก และ
// ควรตรวจสอบข้อมูลผู้ให้บริการก่อนใช้งาน · บรรทัด 16: ควรตรวจสอบช่องทางติดต่อจาก
// เว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง โดยไม่เปิดเผยรหัสผ่าน
// หรือรหัส OTP · บรรทัด 14: ควรตรวจสอบชื่อบัญชีปลายทางให้ตรงกับข้อมูลผู้ให้บริการ
// ที่ยืนยันได้) ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า หน้านี้มีโควตาเป็นปุ่มเดียว
//
// ⚠️ แกนของบรีฟรอบนี้คือ **เว็บสล็อต** (ระบบสล็อตเว็บนอก ค่ายแท้ถูกลิขสิทธิ์
// ฝากถอนยอดเข้าบริษัทแม่โดยตรง) **กลับทิศจากรอบก่อนซึ่งเป็นเว็บลอตเตอรี** คำนิยาม
// ตัวเองของรอบก่อนห้ามเหลือแม้แต่คำเดียว โดยเฉพาะศัพท์หมวดนั้นทั้งชุด (brand-spec §5
// ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของ
// ไฟล์นี้เอง)
// คำที่ใช้ได้รอบนี้: สล็อต168 · ระบบสล็อตเว็บนอก · ทางเข้าเล่นฐานเกมหลัก ·
// ไม่ผ่านเอเย่นต์100% · ค่ายแท้ถูกลิขสิทธิ์ · ฝากถอนยอดเข้าบริษัทแม่โดยตรง ·
// สล็อตคลาสสิก · รอบโบนัส · สัญลักษณ์พิเศษ · จ่ายสูง โบนัสเพียบ ·
// คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · ไม่จำกัด · ธนาคารและทรูมันนี่ ·
// แอดมิน 24ชม. · ค่ายผู้พัฒนาเกม · สมัครสมาชิก · เข้าสู่ระบบ · เว็บไซต์ทางการ ·
// ประกาศล่าสุด · รหัสผ่าน · รหัส OTP · บัญชีแอบอ้าง · ชื่อบัญชีปลายทาง
// ⚠️ **สองหน้าของหมวดเดิมปิดอยู่รอบนี้** (ถูกย้ายไป src/pages-disabled/ แล้ว ดู
// brand-spec §6) และหน้านี้มีโควตาเป็นปุ่มเดียวอยู่แล้ว จึงไม่ลิงก์ไปไหนเพิ่ม
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อธนาคาร ชื่อวอลเล็ต หน่วยงานกำกับ หรือใบอนุญาต
// แม้แต่รายเดียว** (พูดถึง "ธนาคารและทรูมันนี่" แบบรวมๆ เท่านั้น)
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 100% (เฉพาะในวลี
// "ไม่ผ่านเอเย่นต์100%") · 24ชม. **ไม่มี RTP ไม่มีจำนวนเกม/ค่าย ไม่มีวลีจำนวน
// ขั้นตอน ไม่มียอดขั้นต่ำเป็นตัวเลข** ห้ามแต่งใบอนุญาต ตัวเลขการเงิน หรือจำนวน
// สมาชิก — บรีฟรอบนี้ไม่มีหัวข้อขั้นตอนการสมัครเลย จึงไม่มีอะไรให้ยกมาเขียนซ้ำ
// ที่หน้านี้ตั้งแต่ต้น
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตต์รอบนี้อยู่ใน brand-spec §2
// ⚠️⚠️ **รอบนี้ยังเป็นธีมมืดเหมือนรอบก่อน แต่คนละฮิวสิ้นเชิง**
// bg.json = {"mode":"color","color":"#140000"} = **ดำอมแดงเข้มมาก**
// (รอบก่อนเป็น 000000 = ดำสนิท — ค่ามาจากไฟล์ ห้ามเดาว่าเท่าเดิม และห้าม "แก้"
// การ์ดให้สว่าง)
// การ์ด ContentBox จึงเป็นผิว #1c0607 บนหมึกสว่าง #f0e6e4 (= BRAND_TEXT)
// ปุ่มนี้เป็น **หลัก (primary)** ของพาเลต: ไล่เฉดแดงลึก
// #d81115 -> #b00d11 -> #8a0608 ขอบ #8a0608 บนหมึก **ขาว #ffffff**
// (5.2 / 7.2 / 10.0:1 ต่อ stop — ค่าที่ตรวจคอนทราสต์มาแล้ว ห้ามแก้เอง)
// ส่วน /login เป็น **รอง (secondary)**: ไล่เฉดมุกอุ่น #f0e6e4 -> #c9b9b7 บนหมึก
// ดำ #0a0a0a จึงไม่ซ้ำกัน
// 🚨🚨 **ห้ามใช้ #fb2e33 เป็น stop บนของปุ่ม** — ขาวบน #fb2e33 ได้แค่ 3.8:1
// ตกเกณฑ์ #fb2e33 ใช้ได้เฉพาะเป็น "ตัวอักษร/ขอบ outline" บนผิวมืด ไม่ใช่เป็นพื้นถม
// ที่มีหมึกขาวทับ · แผ่นไฮไลต์ด้านบนปุ่มจึงจำกัดที่ /12 (ผสมแล้วเหลือ ~4.8:1
// ยังผ่าน AA) **ห้ามเพิ่มความทึบของแผ่นนี้**
// 🚨🚨 **#cb0b0d #8a0608 #551c1e #7d6f6e ห้ามถือตัวอักษรเอง** เป็นพื้นถม/ขอบ/ออรา
// เท่านั้น · ที่ถือตัวอักษรได้บนผิวมืดชุดนี้คือ #fb2e33 (5.1:1) · #f0e6e4 (16.0:1) ·
// #c9b9b7 (10.3:1) · #e3d6d4 (14.1:1)
// ⚠️⚠️ **วัสดุของรอบนี้คือแดงเจลมันวาวนำ + มุกอุ่นรอง** อ่านจากอาร์ตเวิร์กตรงๆ:
// คำว่า "สล็อต168" ในโลโก้เป็นตัวอักษรไทยสามมิติผิวเจลแดงมันวาว ไฮไลต์ขาว
// สเปกคูลาร์ มีมงกุฎเล็กสีทองประดับหัวใจแดงบนตัวอักษรตัวแรก
// ⚠️⚠️ **มงกุฎนั้นเป็นรายละเอียด ~2% ของอาร์ตเวิร์ก ไม่ใช่สีแบรนด์** และทองคือ
// ฮิวนำของแบรนด์ขาออกทันที (ชื่ออยู่ใน brand-spec §1) — **รอบนี้ไม่มีทองเลยสักเฉด**
// เช่นเดียวกับเงินเย็น: วัสดุที่สองรอบนี้เป็น **มุกอุ่น (R>G>B)**
// ⚠️⚠️ **สีผม เสื้อผ้า พื้นสตูดิโอขาวของแบนเนอร์ และสีผิวนักแสดงเป็นวัตถุในภาพ
// ไม่ใช่สี UI** — พื้นเพจมาจาก bg.json เท่านั้น
// ⚠️ ปุ่มของ Navfoot อยู่บนแถบโครมคนละโซนกับปุ่มบนการ์ดนี้
// **ห้ามลอกคลาสของ Navfoot มาวางบนการ์ด**
// ออราในไฟล์นี้ใช้ rgba(251,46,51,α) · rgba(203,11,13,α) · rgba(138,6,8,α) ·
// rgba(240,230,228,α) · rgba(227,214,212,α) · rgba(0,0,0,α) เท่านั้น
//
// ⚠️⚠️ กับดักรอบนี้คือ **รอบนี้เป็นแบรนด์แดงจริง** "มีแดงอยู่แล้ว" จึงไม่พิสูจน์ว่า
// เป็นค่าของรอบนี้ ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์
// ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive · **แดงของรอบนี้คือ
// #fb2e33 / #d81115 / #b00d11 / #cb0b0d / #8a0608 เท่านั้น** (แดงของ GT66B ห่างจาก
// #fb2e33 แค่ G/B และห่างจาก #8a0608 แค่ B1 — เจอที่ไหนแปลว่าพิมพ์ผิด)
// รอบนี้ **ไม่มีทอง ไม่มีเหลือง ไม่มีเงินเย็น ไม่มีน้ำเงิน/ฟ้า ไม่มีส้ม
// ไม่มีเขียว (ยกเว้น LINE green ที่หน้าอื่น) ไม่มีชมพู ไม่มีม่วง ไม่มีน้ำตาล
// ไม่มีครีม และไม่มีโรสโกลด์**
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ (brand-spec §3 —
// รอบก่อนใช้ AnnouncementHuay จึงหมุนออก) orchestrator ตั้ง default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare — ห้ามส่ง prop message
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) ส่วนที่ไม่ใช่ชื่อแบรนด์
// ยาว 146 อักขระ จึงรับชื่อแบรนด์ได้ตั้งแต่ 4 ถึง 14 ตัวอักษร — นอกช่วงนั้นต้องแก้
// ข้อความ ไม่ใช่ปล่อยผ่าน รอบนี้ชื่อยาว 8 ตัวอักษร รวมเป็น 154
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} ระบบสล็อตเว็บนอก กดปุ่มเดียวไปยังขั้นตอนลงทะเบียน ควรตรวจสอบช่องทางจากเว็บไซต์ทางการ และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้ผู้อื่น`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} ระบบสล็อตเว็บนอก ทางเข้าเล่นฐานเกมหลัก`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#8a0608] bg-gradient-to-b from-[#d81115] via-[#b00d11] to-[#8a0608] px-6 py-4 text-2xl font-black tracking-wide text-white shadow-[0_10px_30px_rgba(203,11,13,0.45)] transition-all duration-300 hover:scale-105 hover:border-[#fb2e33] hover:shadow-[0_15px_40px_rgba(251,46,51,0.5)]">
        <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#f0e6e4]/12 to-transparent"></span>
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
