---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 153.
const pageDescription =
  "หน้าสมัครสมาชิก CASINO888 กดปุ่มเดียวเปิดยูสเซอร์ใหม่ด้วยตัวเอง เริ่มเดิมพันบาคาร่า สล็อต หวย และบอล พร้อมรับโปรโมชั่นแนะนำเพื่อนและคืนยอดเสียตามเงื่อนไข";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก CASINO888 เปิดยูสเซอร์ใหม่",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก CASINO888 เปิดยูสเซอร์ใหม่ด้วยตัวเอง เริ่มเดิมพันบาคาร่า สล็อต หวย บอล" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก CASINO888" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก CASINO888"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fdf49c]/50 bg-gradient-to-r from-[#fae582] via-[#e4c25a] to-[#b28a2a] px-6 py-4 text-lg font-black text-[#17120a] shadow-[0_10px_30px_rgba(228,194,90,0.25)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(228,194,90,0.40)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
