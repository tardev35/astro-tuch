---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change (CtaRedirect.astro
// itself belongs to the orchestrator — ห้ามแก้ไฟล์นั้นจากหน้านี้)
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page, which means verify-build holds its
// description to the same 150–160 character window as every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES — คอปปี้ของหน้านี้จึงพูด
// ได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 1-3: เกมสล็อตสนุกสุดมันส์ เว็บตรงแตกง่าย เบทต่ำ
// ไม่ทำเทิร์น · บรรทัด 16: ควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ
// เพื่อหลีกเลี่ยงบัญชีแอบอ้าง โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP)
// ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า หน้านี้มีโควตาเป็นปุ่มเดียว — และ **บรีฟรอบนี้
// ไม่มีลิสต์ขั้นตอนการสมัครเลยสักข้อ** (วลี "สมัคร N ขั้นตอน" เป็นคำของแบรนด์
// ขาออก — รายการเต็มอยู่ใน brand-spec §5 ห้ามเขียนกลับเข้ามาที่ไหนทั้งสิ้น)
//
// ⚠️ แกนของบรีฟรอบนี้คือ **เว็บสล็อต** (เกมสล็อตสนุกสุดมันส์ เว็บตรงแตกง่าย
// ฝากถอนทุกธนาคารและทรูมันนี่) คำนิยามตัวเองของแบรนด์ก่อนๆ ห้ามเหลือแม้แต่คำเดียว
// โดยเฉพาะศัพท์หมวดลอตเตอรีทั้งชุด (brand-spec §5 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้
// sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง)
// คำที่ใช้ได้รอบนี้: เกมสล็อตสนุกสุดมันส์ · เว็บตรงแตกง่าย · เบทต่ำ 1 บาท ·
// รวมค่ายดัง · ใช้ทุนเล่นน้อย · ถอนได้ไม่จำกัด · ฝากรับโบนัสได้ทั้งวัน ·
// ไม่ต้องทำเทิร์น · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% ·
// ฝากถอนทุกธนาคารและทรูมันนี่ · แอดมิน 24ชม. · สล็อตคลาสสิก · เกมโบนัส ·
// สมัครสมาชิก · เข้าสู่ระบบ · เว็บไซต์ทางการ · ประกาศล่าสุด · รหัสผ่าน ·
// รหัส OTP · บัญชีแอบอ้าง · ชื่อบัญชีปลายทาง
// ⚠️ **สองหน้าของหมวดลอตเตอรีปิดอยู่รอบนี้** (อยู่ใน src/pages-disabled/ ดู
// brand-spec §7) และหน้านี้มีโควตาเป็นปุ่มเดียวอยู่แล้ว จึงไม่ลิงก์ไปไหนเพิ่ม
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อธนาคาร ชื่อวอลเล็ต ชื่อค่ายเกม หน่วยงานกำกับ
// หรือใบอนุญาต แม้แต่รายเดียว** (พูดถึง "ธนาคารและทรูมันนี่" แบบรวมๆ เท่านั้น)
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 1 บาท · 24ชม. **ไม่มี RTP
// เป็นตัวเลข ไม่มีจำนวนเกม/ค่าย ไม่มียอดขั้นต่ำเป็นตัวเลขอื่น ไม่มีอัตราจ่าย
// ไม่มีจำนวนขั้นตอนการสมัครเป็นตัวเลข และไม่มี 100%** ห้ามแต่งใบอนุญาต
// ตัวเลขการเงิน ปีก่อตั้ง หรือจำนวนสมาชิก
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตต์รอบนี้อยู่ใน .claude/brand-spec-bohba168.md §2
// ⚠️⚠️ **รอบนี้ยังเป็นธีมสว่างเหมือนรอบก่อน แต่คนละฮิวสิ้นเชิง**
// bg.json = {"mode":"color","color":"#00bfff"} = **ฟ้าสกายอิ่มตัว**
// (รอบก่อนเป็นชมพูพาสเทล — ค่ามาจากไฟล์ ห้ามเดาว่าเท่าเดิม และห้าม "แก้" การ์ด
// ให้มืด) การ์ด ContentBox จึงเป็นผิว #ffffff บนหมึกเข้ม #06283f (= BRAND_TEXT)
// ปุ่มนี้เป็น **หลัก (primary)** ของพาเลต: ไล่เฉดน้ำเงิน
// #1a6ea8 -> #0f5684 -> #06283f ขอบ #06283f บนหมึก **ขาว #ffffff**
// (5.5 / 7.8 / 15.2:1 ต่อ stop — ค่าที่ตรวจคอนทราสต์มาแล้ว ห้ามแก้เอง)
// ส่วน /login เป็น **รอง (secondary)**: ไล่เฉดขาว #ffffff -> #e4f6fb บนหมึก
// น้ำเงินเข้ม #06283f จึงไม่ซ้ำกัน
// 🚨🚨 **ห้ามใช้ #12b4ef หรือ #00bfff เป็น stop ของปุ่มนี้** — ขาวบน #12b4ef ได้
// แค่ 2.4:1 และบน #00bfff ได้ 2.1:1 ตกเกณฑ์ทั้งคู่ สองค่านั้นสงวนไว้เป็นขอบ/ออรา/
// พื้นถมบนผิวสว่าง และเป็นตัวอักษรได้เฉพาะเมื่ออยู่บนโครมเข้ม · แผ่นไฮไลต์ด้านบน
// ปุ่มจึงจำกัดที่ white/10 (stop บนยังผ่าน AA) **ห้ามเพิ่มความทึบของแผ่นนี้**
// 🚨🚨 **#12b4ef #00bfff #b6e3f0 #7fcbe8 #4fb8ea ห้ามถือตัวอักษรบนผิวสว่างเอง**
// เป็นพื้นถม/ขอบ/ออราเท่านั้น · ที่ถือตัวอักษรได้บนผิวสว่างชุดนี้คือ #06283f
// (15.2:1) · #355f7d (6.8:1) · #0f5684 (7.8:1) · #1a6ea8 (5.5:1)
// ⚠️⚠️ **วัสดุของรอบนี้คือบับเบิลเจลฟ้าสกายมันวาวคู่ไฮไลต์ขาวหนา** อ่านจาก
// อาร์ตเวิร์กตรงๆ: โลโก้เป็นหัวการ์ตูนผู้หญิงผมมวยสูงผูกโบว์ขาว ทำหน้าตกใจ ตาโต
// ปากอ้า สองมือแตะแก้ม คู่กับชื่อแบรนด์ตัวอักษรไทยสามมิติทรงบับเบิลไล่เฉดฟ้าสกาย
// เข้มลงหาฟ้าอ่อนเกือบขาว ตัดขอบขาวหนา มีขีดประกายฟ้ารอบตัวอักษร
// ⚠️⚠️ **สีผม เสื้อคลุมถักฟ้าอ่อน พื้นสตูดิโอขาวของแบนเนอร์ ดาวเหลือง เหรียญทอง
// และสีผิวนักแสดงเป็นวัตถุในภาพ ไม่ใช่สี UI** — พื้นเพจมาจาก bg.json เท่านั้น
// ⚠️ ปุ่มของ Navfoot อยู่บนแถบโครมคนละโซนกับปุ่มบนการ์ดนี้
// **ห้ามลอกคลาสของ Navfoot มาวางบนการ์ด**
// ออราในไฟล์นี้ใช้ rgba(15,86,132,α) · rgba(18,180,239,α) · rgba(6,40,63,α) ·
// rgba(182,227,240,α) · rgba(127,203,232,α) เท่านั้น
//
// ⚠️⚠️ กับดักรอบนี้คือ **รอบนี้เป็นแบรนด์ฟ้าจริง** "มีฟ้าอยู่แล้ว" จึงไม่พิสูจน์ว่า
// เป็นค่าของรอบนี้ — รีโปนี้มีแบรนด์ฟ้า/น้ำเงินมาแล้วแปดเจ้า ให้เทียบเป็น "ค่า"
// ทีละหลักกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของ
// แบรนด์เก่าเจอ false positive · **ฟ้า/น้ำเงินของรอบนี้คือ #00bfff / #12b4ef /
// #b6e3f0 / #7fcbe8 / #4fb8ea / #2a87c4 / #1a6ea8 / #0f5684 / #0b4a73 / #06283f
// เท่านั้น**
// รอบนี้ **ไม่มีชมพู/แมเจนต้า/พลัม (ฮิวของแบรนด์ขาออกทันที) ไม่มีทอง ไม่มีเหลือง
// ไม่มีเงินเย็น ไม่มีส้ม ไม่มีเขียว (ยกเว้น LINE green ที่หน้าอื่น) ไม่มีแดง
// ไม่มีม่วง ไม่มีน้ำตาล ไม่มีครีม และไม่มีโรสโกลด์**
//
// Announcement หมุนมาเป็น `Announcement.astro` (ตัวฐาน) ทั้งเว็บรอบนี้
// (brand-spec §3 — รอบก่อนใช้ Announcement4 จึงหมุนออก) orchestrator ตั้ง default
// message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare — ห้ามส่ง
// prop message
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) สตริงนี้ยาว 157
// ด้วยชื่อแบรนด์ 10 อักขระของรอบนี้ — เหลือพื้นที่ 3 อักขระ ถ้ารอบหน้าชื่อยาวกว่า
// ต้องตัดข้อความส่วนที่ไม่ใช่ชื่อแบรนด์ลง ไม่ใช่ปล่อยผ่าน
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} เกมสล็อตสนุกสุดมันส์ เว็บตรงแตกง่าย กดปุ่มเดียวไปยังขั้นตอนลงทะเบียน ควรตรวจสอบช่องทางจากเว็บไซต์ทางการ ไม่เปิดเผยรหัสผ่านหรือ OTP`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} เกมสล็อตสนุกสุดมันส์ เว็บตรงแตกง่าย`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#06283f] bg-gradient-to-b from-[#1a6ea8] via-[#0f5684] to-[#06283f] px-6 py-4 text-2xl font-black tracking-wide text-white shadow-[0_10px_30px_rgba(15,86,132,0.35)] transition-all duration-300 hover:scale-105 hover:border-[#12b4ef] hover:shadow-[0_15px_40px_rgba(18,180,239,0.45)]">
        <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-white/10 to-transparent"></span>
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
