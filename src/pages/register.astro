---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 151.
const pageDescription =
  "หน้าสมัครสมาชิก UFA168 กดปุ่มเดียวเปิดยูสเซอร์ใหม่ด้วยตัวเองได้ทันที เริ่มเดิมพันสล็อต บาคาร่า คาสิโนสด กีฬา และหวย พร้อมรับโปรโมชั่นตามเงื่อนไขของเว็บ";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก UFA168 เปิดยูสเซอร์ใหม่",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก UFA168 เปิดยูสเซอร์ใหม่ด้วยตัวเอง เริ่มเดิมพันเกมครบวงจร" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก UFA168" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก UFA168"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#d4af37]/70 bg-gradient-to-r from-[#fff3bf] via-[#f3db5b] to-[#a37c14] px-6 py-4 text-lg font-black text-[#050403] shadow-[0_10px_30px_rgba(243,219,91,0.25)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(163,124,20,0.38)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
