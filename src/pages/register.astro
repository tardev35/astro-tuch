---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change.
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page, which means verify-build holds its
// description to the same 150–160 character window as every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES — คอปปี้ของหน้านี้จึงพูด
// ได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 10–13: คืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อน
// โบนัส 0.8% ไม่จำกัด) ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า หน้านี้มีโควตาเป็นปุ่มเดียว
//
// ⚠️ แบรนด์รอบนี้เป็น **คาสิโนรวมเกม** (บาคาร่า · สล็อต · บอลออนไลน์) ไม่ใช่เว็บ
// สล็อตล้วนแบบแบรนด์ก่อน ไม่ใช่เว็บกีฬาล้วน และไม่ใช่เว็บหมวดลอตเตอรี คำที่ห้ามหลุด
// กลับมาอยู่ใน brand-spec §1/§6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำต้องห้ามเจอ
// false positive
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 24 ชั่วโมง — **ไม่มี "3 ขั้นตอน"
// ในบรีฟรอบนี้** (นั่นเป็นของบรีฟรอบก่อน) ห้ามแต่งใบอนุญาต หน่วยงานกำกับ ชื่อค่ายเกม
// ชื่อธนาคาร ค่า RTP ยอดขั้นต่ำ จำนวนสมาชิก หรือปีใดๆ
//
// แบรนด์รอบนี้ (KMD88, รอบม่วงราชา-ทองบนดำสนิท 2026-10-13, brand-spec §2):
// **สองฮิวจริง: ม่วงนำ ทองรอง** ไม่ใช่ทองล้วนแบบรอบก่อน
// ม่วงแบรนด์ #7505cc · ม่วงสว่าง #b453ff · ม่วงที่ถือตัวอักษรได้ #c07cff (5.3:1)
// และ #d9b8ff (8.6:1) · ทองแบรนด์ #e2b33f (8.1:1) · ทองสว่าง #ffdf8c (12.0:1) ·
// เนื้อความ #ece2f8 (= BRAND_TEXT) · หมึกบนพื้นสว่าง/พื้นถมทอง #1a0526
// ชั้นผิว: ยก #1d0832 (= การ์ด ContentBox) / กลาง #140522 / จม #0a0213 /
// พื้นเพจ #000000 — รอบนี้ bg.json เป็นดำสนิท จึงไม่มีชั้นที่ลึกกว่าพื้นเพจ
// ปุ่มนี้เป็น PRIMARY: ถมพื้นทองไล่เฉด #ffdf8c → #e2b33f ขอบ #7a5a0a
// บนหมึกเข้ม #1a0526 (8.4:1 บนปลายเข้มสุด #e2b33f)
// ⚠️ ห้ามกลับด้าน: พื้นถมทองต้องใช้หมึกเข้มเสมอ ห้ามครีมหรือขาว และไล่เฉดต้อง
// **หยุดที่ #e2b33f** ห้ามไล่เข้มกว่านั้นใต้ตัวอักษร — #7a5a0a อยู่ได้เฉพาะเป็น
// เส้นขอบของปุ่มนี้
// — ส่วน /login เป็น SECONDARY ชั้นจมขอบม่วง จึงไม่ซ้ำกัน · #7505cc #b453ff
// #3a0565 #2c0349 #7a5a0a ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่เส้นขอบ ออรา และเงา
// — ออราในไฟล์นี้ใช้ rgba(226,179,63,α) เท่านั้น นอกจากเงาดำล้วน
// ⚠️ กับดักรอบนี้คือ **ทั้งสองฮิว**: ทองออกมาแล้วเก้าในสิบสองรอบหลังสุด และม่วงก็
// เพิ่งออกสองรอบ "เจอทองหรือเจอม่วง" จึงไม่ได้พิสูจน์ว่าเป็นค่าของรอบนี้ ให้เทียบเป็น
// "ค่า" ทีละตัวกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของ
// แบรนด์เก่าเจอ false positive — ชุดทองของแบรนด์ก่อนออกครบทุกจุดในไฟล์นี้แล้ว
// และรอบนี้ **ไม่มีชมพู ไม่มีเขียว ไม่มีน้ำเงิน ไม่มีแดง ไม่มีส้ม ไม่มีเทา/เงิน**
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ (brand-spec §3)
// orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว
// จึงเรียกแบบ bare — ห้ามส่ง prop message จากหน้านี้
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) หน้านี้ยาว 150
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} กดปุ่มเดียวไปยังทางเข้าหลักของเว็บ คาสิโนรวมเกม บาคาร่า สล็อต บอลออนไลน์ พร้อมโปรโมชั่นคืนยอดเสีย 0.3% และแนะนำเพื่อน โบนัส 0.8%`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/2u19";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} คาสิโนรวมเกม สมัครจากทางเข้าหลักของเว็บ`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#7a5a0a] bg-gradient-to-b from-[#ffdf8c] to-[#e2b33f] px-6 py-4 text-2xl font-black tracking-wide text-[#1a0526] shadow-[0_10px_30px_rgba(226,179,63,0.4)] transition-all duration-300 hover:scale-105 hover:border-[#1a0526] hover:shadow-[0_15px_40px_rgba(226,179,63,0.6)]">
        <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ffdf8c]/70 to-transparent"></div>
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
