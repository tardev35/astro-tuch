---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
//
// BRAZIL999 (รอบเขียวมรกต + เงินโครเมียมบนดำ 2026-09-25): ปุ่มนี้เป็นตัว PRIMARY ของ
// คู่ จึงสวมไล่เฉดเขียวของแบรนด์เต็มใบ (#b6ff9c → #22c55e → #0a6b18) บนตัวอักษร
// เกือบดำ #040a05 เพราะตัวหนังสือบนพื้นเขียวสว่างต้องเป็นสีเข้มจึงจะอ่านออก ห้ามใช้ขาว
// ส่วน /login รับฝั่ง "BRAZIL" ของโลโก้ที่เป็นเงินขัดเงา — ขอบเงินโครเมียม #aab4bf
// บนผิวยก #123a18 แทน สองลำดับ หนึ่งสีต่อหนึ่งปุ่ม ตามโลโก้ที่ BRAZIL เป็นเงินและ
// 999 เป็นเขียว ไม่ใช่เขียวสองใบซึ่งจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม
// ชุดทอง/เงินอุ่นของรอบก่อนออกครบแล้ว ทองเป็นแอ็กเซนต์ที่สามของแบรนด์นี้เท่านั้น
// และไม่ใช้บนปุ่ม
//
// Announcement หมุนมาเป็น Announcement2 ทั้งเว็บรอบนี้ — default message ของไฟล์
// นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ index ก็เรียกแบบ bare จึงห้ามส่ง prop
//
// BRAZIL999 เป็นแบรนด์คาสิโน — คำศัพท์เฉพาะหมวดของแบรนด์ก่อนหน้า (เกมสด เกมโต๊ะ
// ค่ายเกม) ห้ามหลงเหลือในหน้านี้ บรีฟรอบนี้ไม่ได้ระบุไว้สักคำ
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 157
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = "สมัครสมาชิก BRAZIL999 กดปุ่มเดียวเปิดบัญชีใหม่ด้วยตัวเองใน 3 ขั้นตอน รองรับมือถือและคอมพิวเตอร์ จากนั้นเข้าสู่ระบบเลือกเกมและตรวจสอบโปรโมชั่นได้จากบัญชีเดียว";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก BRAZIL999",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="สมัครสมาชิก BRAZIL999 เปิดบัญชีใหม่ด้วยตัวเอง เล่นได้จากบัญชีเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก BRAZIL999" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก BRAZIL999"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#22c55e] bg-gradient-to-r from-[#b6ff9c] via-[#22c55e] to-[#0a6b18] px-6 py-4 text-lg font-black text-[#040a05] shadow-[0_10px_30px_rgba(34,197,94,0.50)] transition-all duration-300 hover:scale-105 hover:border-[#aab4bf] hover:shadow-[0_15px_40px_rgba(170,180,191,0.28)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
