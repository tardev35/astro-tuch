---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// This is the PRIMARY action of the pair, so it wears the solid metallic-gold
// gradient of the OCZPLUS wordmark on navy text; /login carries the outline.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 152.
const pageDescription =
  "หน้าสมัครสมาชิก OCZPLUS กดปุ่มเดียวเปิดบัญชีใหม่ด้วยตัวเอง เข้าเล่นเกมสล็อตที่ไม่ล็อคยูส รับโบนัสทุกยูสเซอร์ พร้อมระบบฝาก-ถอนอัตโนมัติทุกธนาคารและวอลเลท";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก OCZPLUS",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก OCZPLUS เปิดบัญชีใหม่ด้วยตัวเอง เริ่มเล่นสล็อตได้ทันที" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก OCZPLUS" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก OCZPLUS"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f2dc9a]/70 bg-gradient-to-r from-[#f2dc9a] via-[#d9b45e] to-[#8a6b2c] px-6 py-4 text-lg font-black text-[#03101f] shadow-[0_10px_30px_rgba(217,180,94,0.28)] transition-all duration-300 hover:scale-105 hover:border-[#f2dc9a] hover:shadow-[0_15px_40px_rgba(217,180,94,0.48)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
