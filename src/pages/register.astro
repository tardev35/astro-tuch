---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect. The title and
// description below are written for exactly that reason.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// NAZA99 (รอบทอง-ดำ 2026-10-02, brand-spec §2 — แบรนด์นี้เป็นทองล้วน ไม่มีฮิวที่สอง):
// ปุ่มนี้เป็นตัว PRIMARY ของคู่ จึงสวมไล่เฉดทองประจำแบรนด์เต็มใบ
// (#fdf2ac → #e4b34d → #c08f2b) บนตัวอักษรหมึกเข้ม #1a1000 ซึ่งได้ 7.0:1 ที่ปลาย
// เข้มสุดของไล่เฉด — ห้ามให้ไล่เฉดจบเข้มกว่า #c08f2b
// ส่วน /login รับแบบ outline — กรอบทองลึก #8a5f12 บนผิวยกระดับ #241404 แทน
// สองลำดับ หนึ่งรูปแบบต่อหนึ่งปุ่ม ไม่ใช่ถมทองสองใบซึ่งจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม
// ห้ามตัวอักษรสีอ่อนบนพื้นทอง (ขาวบน #e4b34d ได้แค่ 1.9:1 — brand-spec §2)
// ชุดของ หวย365 (#dc0203 #f5282a #9c0201 #ffc93c #ffeab0 #c08a07 #240406 #180303
// #f6e7e0 #1a0303 rgba(255,201,60,*) rgba(220,2,3,*) rgba(8,1,1,*)) ออกครบแล้ว
//
// Announcement หมุนมาเป็น AnnouncementPremium ทั้งเว็บรอบนี้ (รอบก่อนเป็น
// AnnouncementCyber) — default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ
// index ก็เรียกแบบ bare
//
// NAZA99 เป็นเว็บสล็อตออนไลน์ ไม่ใช่หวยและไม่ใช่บอล — บรีฟระบุการสมัครผ่านมือถือได้เอง
// ด้วย 3 ขั้นตอน (เข้าหน้าสมัครและกรอกข้อมูลที่ระบบกำหนด → ยืนยันข้อมูลและ Login
// เข้าบัญชีสมาชิก → เลือกค่ายและเกมสล็อตที่ต้องการ พร้อมตรวจสอบโปรโมชั่นหรือ
// รายละเอียดเกมก่อนเริ่มเล่น) แล้วใช้บัญชีเดียวค้นหาเกมใหม่ ตรวจสอบเครดิต โปรโมชั่น
// และประวัติรายการ
// ชื่อเกมที่เอ่ยได้มีแค่สามชื่อของบรีฟ (Mahjong Ways 2, Fortune Tiger, Sweet Bonanza)
// คำศัพท์ของแบรนด์ก่อนหน้า (หวย โพย ส่งโพย งวด เลขเด็ด อัตราจ่าย ฮานอย ลาว หุ้น
// บอล ค่าน้ำ อัตราต่อรอง ลีก คาสิโนสด บาคาร่า ยิงปลา) ห้ามหลงเหลือ และห้ามเพิ่ม
// ชื่อธนาคาร ยอดฝากขั้นต่ำ ชื่อผู้ให้บริการจริง หรือเลขใบอนุญาต — บรีฟรอบนี้ไม่ได้
// พูดเรื่องฝากถอน จึงห้ามยกของรอบก่อนมาใช้ซ้ำ
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 157
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} กดปุ่มเดียวเปิดบัญชีผ่านมือถือได้ใน 3 ขั้นตอน แล้วเข้าสู่ระบบเลือกค่ายและเกมสล็อตที่ต้องการ พร้อมตรวจสอบโปรโมชั่นก่อนเริ่มเล่นทุกครั้ง`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} เปิดบัญชีเองผ่านเว็บ 3 ขั้นตอน เริ่มเล่นสล็อตได้เลย`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#8a5f12] bg-gradient-to-r from-[#fdf2ac] via-[#e4b34d] to-[#c08f2b] px-6 py-4 text-lg font-black text-[#1a1000] shadow-[0_10px_30px_rgba(228,179,77,0.45)] transition-all duration-300 hover:scale-105 hover:border-[#fdf2ac] hover:shadow-[0_15px_40px_rgba(253,242,172,0.35)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
