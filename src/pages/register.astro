---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1×1, h2×0, h3×0. Never write an article here and never add an <h2>.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change.
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens. It is an indexed page now, which
// means verify-build holds its description to the same 150–160 character window
// as every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES และไม่ได้ให้ขั้นตอน
// สมัครเป็นข้อๆ ไว้เลย — คอปปี้ของหน้านี้จึงพูดได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 4:
// เว็บสล็อตนาซ่า รวบรวมเกมสล็อตหลายประเภทไว้ในแพลตฟอร์มเดียว ค้นหาเกม ตรวจสอบ
// เครดิต และติดตามโปรโมชั่น · บรรทัด 10–13: คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%)
// ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า หน้านี้มีโควตาเป็นปุ่มเดียว
//
// NAZA168 (รอบทองอวกาศ-เงินโครเมียม 2026-10-10, brand-spec §2):
// ทองแบรนด์ #fbc134 (ฮิวหลัก) · ทองสว่าง #ffe87a · ทองกลางเข้ม #cf9a18 ·
// เงินโครเมียม #cfd6e3 (ฮิวที่สอง) · เนื้อความ #fdf3df · หมึกบนพื้นถมทอง #231500 ·
// ชั้นผิว ยก #4e3406 / กลาง #432b03 / ลึก #382400 / ลึกสุด #241700
// (พื้นเพจจาก bg.json = #382400 น้ำตาลไหม้เข้ม)
// ปุ่มนี้เป็น PRIMARY เดียวกับ /ทางเข้า: ถมทองไล่เฉด #ffe87a → #fbc134 → #cf9a18
// ขอบ #cf9a18 บนหมึกเข้ม #231500 (ปลายเข้มสุด #cf9a18 ได้ 7.0:1)
// ⚠️ ห้ามกลับด้าน: พื้นถมทองต้องใช้หมึกเข้มเสมอ ห้ามครีมหรือขาว และห้ามไล่เฉดลงไป
// ถึงทองลึก #96690a ใต้ตัวอักษร (3.7:1 ตก) ปลายเข้มจึงหยุดที่ #cf9a18
// — ส่วน /login เป็น SECONDARY ชั้นลึก จึงไม่ซ้ำกัน · #96690a #6b4a05 #3f4859
// ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่เส้นขอบ ออรา และเงา — ออราใช้
// rgba(251,193,52,α) เท่านั้นในไฟล์นี้ นอกจากเงาดำล้วน
// ⚠️ แบรนด์รอบก่อน (FLASH877) ก็เป็นแบรนด์ "ทอง" เหมือนกัน เจอทองที่ไหนห้ามเหมาว่า
// เป็นของรอบนี้ ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน brand-spec §2 — ชุด
// #f5c518 #ffdd73 #b8860f #ff3b14 #5c0000 #430000 #fdf0e2 #2a0300
// rgba(245,197,24,α) rgba(255,59,20,α) ออกครบแล้ว และรอบนี้ไม่มีสีแดงเป็นฮิวเลย
//
// Announcement หมุนมาเป็น AnnouncementPremium ทั้งเว็บรอบนี้ และเรียกแบบ bare
// ทุกหน้า — ห้ามส่ง prop message จากหน้านี้
//
// แบรนด์นี้เป็นเว็บสล็อตนาซ่าล้วนๆ ไม่ใช่เว็บหวย — รายการคำต้องห้ามเต็มอยู่ใน
// brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep เจอ false positive
// ⚠️ ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 0.3% / 0.8% / 24 ชั่วโมง / 100%
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) หน้านี้ยาว 156
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} เว็บสล็อตนาซ่า กดปุ่มเดียวไปยังช่องทางหลัก พร้อมโปรโมชั่นคืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อนรับโบนัสแชร์ลิงก์ 0.8% ไม่จำกัด`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} เว็บสล็อตนาซ่า ฝากถอนเข้าบัญชีบริษัทโดยตรง ไม่ผ่านม้า`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#cf9a18] bg-gradient-to-b from-[#ffe87a] via-[#fbc134] to-[#cf9a18] px-6 py-4 text-2xl font-black tracking-wide text-[#231500] shadow-[0_10px_30px_rgba(251,193,52,0.4)] transition-all duration-300 hover:scale-105 hover:border-[#231500] hover:shadow-[0_15px_40px_rgba(251,193,52,0.6)]">
        <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ffe87a]/60 to-transparent"></div>
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
