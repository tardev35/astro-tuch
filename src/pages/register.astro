---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// This is the PRIMARY action of the pair, so it wears the orange gradient;
// /login carries the chrome-silver 8S half of the WIN8S logo.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 155.
const pageDescription =
  "หน้าสมัครสมาชิก WIN8S กดปุ่มเดียวเปิดยูสเซอร์ใหม่ด้วยตัวเอง เล่นสล็อตออนไลน์เว็บตรงครบทุกค่ายในบัญชีเดียว ฝากถอนวอลเลทขั้นต่ำ 1 บาท พร้อมรับสิทธิ์โปรโมชั่น";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก WIN8S เปิดยูสเซอร์ใหม่",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก WIN8S เปิดยูสเซอร์ใหม่ด้วยตัวเอง เริ่มเล่นสล็อตได้ทันที" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก WIN8S" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก WIN8S"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f36403]/60 bg-gradient-to-r from-[#fc8d13] via-[#f36403] to-[#ec5402] px-6 py-4 text-lg font-black text-[#050201] shadow-[0_10px_30px_rgba(243,100,3,0.25)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(243,100,3,0.45)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
