---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — this page is indexed and must not
// describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// This is the PRIMARY action of the pair on the UFAGOOL palette, so it wears
// the full crimson-gradient fill of the logo's "UFA" (#ef1f25 → #c50d12 →
// #7a0103) under chrome-silver ink (#f4f7fa); /login carries the same red as an
// outline on the card surface instead. Two tiers, one fill each — the red/
// chrome pairing the logo itself uses.
//
// Announcement รอบนี้หมุนมาใช้ Announcement3 ทั้งเว็บ — default message ของไฟล์นั้น
// ถูกตั้งเป็นคอปปี้ของแบรนด์นี้แล้ว และ index ก็เรียกแบบ bare จึงห้ามส่ง prop
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 158
const pageDescription = "สมัครสมาชิก UFAGOOL กดปุ่มเดียวเปิดบัญชีใหม่ได้ด้วยตัวเอง จากนั้นเข้าสู่ระบบเลือกกีฬา คาสิโนสด สล็อต และเกมออนไลน์อื่นจากบัญชีเดียว รองรับมือถือและคอมพิวเตอร์";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก UFAGOOL",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="สมัครสมาชิก UFAGOOL เปิดบัญชีใหม่ด้วยตัวเอง เล่นได้ครบในบัญชีเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก UFAGOOL" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก UFAGOOL"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ef1f25] bg-gradient-to-r from-[#ef1f25] via-[#c50d12] to-[#7a0103] px-6 py-4 text-lg font-black text-[#f4f7fa] shadow-[0_10px_30px_rgba(197,13,18,0.50)] transition-all duration-300 hover:scale-105 hover:border-[#f4f7fa] hover:shadow-[0_15px_40px_rgba(184,195,207,0.45)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
