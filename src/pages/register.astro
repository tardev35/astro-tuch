---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1×1, h2×0, h3×0. Never write an article here and never add an <h2>.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change.
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page, which means verify-build holds its
// description to the same 150–160 character window as every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES — คอปปี้ของหน้านี้จึงพูด
// ได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 10–13: คืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อน
// โบนัส 0.8%) ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า หน้านี้มีโควตาเป็นปุ่มเดียว
// ⚠️ บรีฟรอบนี้ไม่ได้ระบุจำนวนขั้นตอนการสมัครไว้เลย (วลีนับขั้นตอนเป็นของแบรนด์ก่อน
// และอยู่ในแบนลิสต์ §7) จึงห้ามเอ่ยถึงจำนวนขั้นตอน — ของที่หลุดมาจากรอบก่อนถูกถอด
// ออกแล้วทั้ง title และ description
//
// ⚠️ UFA324 เป็น **เว็บเล่นเกมกีฬาออนไลน์** (ฟุตบอล · มวย · เกมคาสิโน ซึ่งรวม
// เกมไพ่ เกมโต๊ะ และสล็อต) ไม่ใช่เว็บสล็อตล้วนแบบแบรนด์ก่อน และไม่ใช่เว็บลอตเตอรี
// รายการคำที่ห้ามหลุดกลับมาอยู่ใน brand-spec §7 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep
// หาคำต้องห้ามเจอ false positive
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% / 0.8% / 24 ชั่วโมง — ห้ามแต่งใบอนุญาต
// หน่วยงานกำกับ ชื่อค่ายเกม ชื่อธนาคาร ชื่อลีก/ทีม/นักมวย หรือยอดขั้นต่ำเป็นตัวเลข
//
// UFA324 (รอบทองแชมเปี้ยน-เงินโครเมียม 2026-10-11, brand-spec §2):
// ทองแบรนด์ #e5a81b (ฮิวหลัก) · ทองสว่าง #ffe08a · ทองกลางเข้ม #bb8410 ·
// ทองลึก #7d5a07 (เส้น/ขอบ/ออราเท่านั้น) · เงินแบรนด์ #b9c2cc (ฮิวที่สอง) ·
// เนื้อความ #f0e8d4 (= BRAND_TEXT) · หมึกบนพื้นทอง #140d01
// ชั้นผิว: ยก #231c0e (= การ์ด ContentBox) / กลาง #17130a / จม #0d0b06 /
// พื้นเพจ #000000 — รอบนี้ bg.json เป็นดำสนิท จึงไม่มีชั้นที่ลึกกว่าพื้นเพจได้อีก
// ปุ่มนี้เป็น PRIMARY: ถมพื้นทองไล่เฉด #ffe08a → #e5a81b → #bb8410 ขอบ #7d5a07
// บนหมึกเข้ม #140d01 (16:1 บน #ffe08a · 9.8:1 บน #e5a81b · 6.3:1 บน #bb8410)
// ⚠️ ห้ามกลับด้าน: พื้นถมทองต้องใช้หมึกเข้มเสมอ ห้ามครีมหรือขาว และไล่เฉดต้อง
// **หยุดที่ #bb8410** ห้ามไล่ลงไปถึง #7d5a07 ใต้ตัวอักษร (#140d01 บน #7d5a07
// ได้แค่ 3.3:1 ตก AA) — #7d5a07 อยู่ได้เฉพาะเป็นเส้นขอบของปุ่มนี้
// — ส่วน /login เป็น SECONDARY ชั้นจม จึงไม่ซ้ำกัน · #7d5a07 #43300a #464f5a
// ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่เส้นขอบ ออรา และเงา — ออราในไฟล์นี้ใช้
// rgba(229,168,27,α) เท่านั้น นอกจากเงาดำล้วน
// ⚠️ เจ็ดในสิบแบรนด์หลังสุดมีทอง "เจอทอง" ไม่ได้แปลว่าถูกค่า ให้เทียบเป็นตัวๆ กับ
// ตารางแบนใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่า
// เจอ false positive — ชุดชมพูฮ็อต-ทองของรอบก่อนออกครบทุกจุดในไฟล์นี้แล้ว
//
// Announcement หมุนมาเป็น Announcement2 ทั้งเว็บรอบนี้ (ตัวที่แบรนด์ก่อนใช้ถูกหมุน
// ออกตาม brand-spec §3) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้
// ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare — ห้ามส่ง prop message จากหน้านี้
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) หน้านี้ยาว 157
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} เว็บเล่นเกมกีฬาออนไลน์ กดปุ่มเดียวไปยังทางเข้าเดิมพันหลักของเว็บ พร้อมโปรโมชั่นคืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อน โบนัส 0.8%`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} เว็บเล่นเกมกีฬาออนไลน์ ฐานเกมแท้ จ่ายตรง`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#7d5a07] bg-gradient-to-b from-[#ffe08a] via-[#e5a81b] to-[#bb8410] px-6 py-4 text-2xl font-black tracking-wide text-[#140d01] shadow-[0_10px_30px_rgba(229,168,27,0.4)] transition-all duration-300 hover:scale-105 hover:border-[#140d01] hover:shadow-[0_15px_40px_rgba(229,168,27,0.6)]">
        <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ffe08a]/60 to-transparent"></div>
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
