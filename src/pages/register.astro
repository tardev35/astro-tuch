---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char).
const pageDescription =
  "หน้าสมัครสมาชิก ขวัญใจ168 กดปุ่มเดียวเปิดยูสเซอร์ใหม่ด้วยตัวเอง เข้าเล่นสล็อตผ่านทางเข้าสำรองได้ทันที พร้อมตรวจสอบสิทธิ์โปรโมชั่นและฝากถอนออโต้ในบัญชีเดียว";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก ขวัญใจ168 เปิดยูสเซอร์ใหม่",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก ขวัญใจ168 เปิดยูสเซอร์ใหม่ด้วยตัวเอง เข้าเล่นสล็อตผ่านทางเข้าสำรอง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก ขวัญใจ168" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก ขวัญใจ168"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#4bdbee]/70 bg-gradient-to-r from-[#4bdbee] via-[#22b8e8] to-[#0e4f7a] px-6 py-4 text-lg font-black text-[#01050b] shadow-[0_10px_30px_rgba(75,219,238,0.25)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(34,184,232,0.35)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
