---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. The page carries exactly ONE heading, and it is the
// level-one heading that ContentBox renders from its own `as` prop; there is no
// level-two and no level-three heading anywhere on it. Never write an article
// here and never add a second heading — verify-build fails the build the moment
// a second top-level heading appears on an indexable page.
// (The heading token is deliberately not spelled out in this comment: a source
// grep for it used to match the prose here as well as the real prop below, and
// every round someone had to re-derive which of the two matches was real.)
//
// ⚠️ This page is NOT one of the "full custom HTML + own <style> block"
// standalone pages SKILL.md Phase 4.5 warns about — it renders through
// MainLayout + ContentBox like every other sub-page, so it has no
// .brand-identity string and no raw-hex <style> block of its own. The only
// brand colours here are the Tailwind arbitrary values on the button below.
// Do not "restore" a <style> block; the font link and the <html> colour come
// from MainLayout.
// ⚠️ **ห้ามใช้ define:vars บนหน้านี้** — เดิมหน้านี้เป็น interstitial แบบ noindex
// จึงเคยได้รับการยกเว้น แต่ตอนนี้มันเป็นหน้าที่ index ได้ ข้อยกเว้นนั้นหมดไปแล้ว
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change.
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page (no `robots` prop = indexable), which means
// verify-build holds its description to the same 150–160 character window as
// every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) **ไม่มีส่วน SUB-PAGES** → title/description
// ของหน้านี้เขียนเอง และพูดได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 14: ช่องทางสมัครสมาชิก
// ผ่านโทรศัพท์มือถือและอุปกรณ์ที่เชื่อมต่ออินเทอร์เน็ต ควรตรวจสอบขั้นตอนลงทะเบียน
// ข้อกำหนดด้านอายุ กฎหมายที่เกี่ยวข้อง และนโยบายความเป็นส่วนตัวก่อนดำเนินการ ·
// บรรทัด 16: ตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง · บรรทัด 18: ไม่ควรเปิดเผยรหัสผ่าน
// และรหัส OTP ให้ใครทราบ)
// ⚠️ บรีฟรอบนี้ **มีหัวข้อสมัครสมาชิก 3 ขั้นตอนจริง แต่เป็นของ index.astro**
// (หัวข้อระดับสองที่ 6 ในเช็กลิสต์ brand-spec §4) **ไม่ใช่ของหน้านี้** — หน้านี้มี
// โควตาเป็น **ปุ่มเดียว** ห้ามแตกเป็นหัวข้อหรือรายการขั้นตอนบนหน้า
//
// 🚨 แกนของแบรนด์รอบนี้คือ **เว็บหวย (lottery)** บรีฟระบุประเภทหวยไว้ **สี่ชื่อ**
// (หวยรัฐบาลไทย · หวยลาว · หวยฮานอย · หวยหุ้น)
// 🚨🚨 **รอบก่อนเป็นเว็บคาสิโน/บาคาร่า — ห้ามสืบทอดศัพท์หมวดเกมข้ามรอบเด็ดขาด**
// บรีฟรอบนี้ **ไม่มีคำว่าสล็อต บาคาร่า คาสิโนสด หรือเดิมพันกีฬาเลยสักคำ**
// ⚠️ น้ำเสียงของบรีฟรอบนี้คือ "โฆษณาและกำกับในประโยคเดียวกัน" ไม่ใช่การันตี
// คลังคำที่ใช้ได้รอบนี้อยู่ใน .claude/brand-spec-lottoplus.md §5 (ไม่พิมพ์ซ้ำที่นี่
// และ **ไม่พิมพ์คำของแบรนด์เก่าซ้ำที่นี่** เพื่อไม่ให้ sweep ของรอบถัดไปเจอ
// false positive ในคอมเมนต์ของไฟล์นี้เอง)
// ⚠️ กับดักรอบนี้: แบรนด์หวยเจ้าก่อนๆ ก็เคยถือไฟล์กลุ่มนี้ และวลีของเจ้านั้นต่าง
// จากวลีของรอบนี้แค่คำท้าย — ต้องอ่านให้ครบวลีก่อนตัดสินว่าเป็นคำของบรีฟรอบนี้
// ตัวเลขที่อ้างได้รอบนี้มีแค่ 100 · 1,000 · 2 ตัว · 3 ตัว · 3 ขั้นตอน · 24ชม.
// — ห้ามแต่งใบอนุญาต จำนวนสมาชิก ปีก่อตั้ง หรือค่าร้อยละใดๆ
// 🚨🚨 **บรีฟรอบนี้ไม่มีชื่อผู้ให้บริการกระเป๋าเงิน ไม่มีชื่อธนาคาร และไม่มี
// คำว่าฝากถอนออโต้เลยสักคำ** — ห้ามเขียนถึงสิ่งเหล่านั้นบนหน้านี้
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตรอบนี้อยู่ใน .claude/brand-spec-lottoplus.md §2
// 🚨🚨 **กลับทิศ 180° จากรอบก่อน: รอบนี้ "สว่างทั้งเว็บ"** เฉพาะโครมที่เข้ม
// bg.json = {"mode":"color","color":"#e1fef3"} = เขียวมินต์จางเกือบขาว
// การ์ด ContentBox จึงเป็น **ผิวขาว ffffff บนหมึกเข้ม 0d3326** (= BRAND_TEXT,
// 13.8:1) — **ห้ามคืนการ์ดผิวเข้มของรอบก่อนกลับมาแม้แต่ใบเดียว**
// ปุ่มนี้คือ **CTA หลัก** ของพาเลต ไล่เฉดเขียวมรกตสามสต็อป
// from 0c7c58 → via 046c4e → to 03543c บนหมึก **ขาว ffffff**
// (5.20 / 6.70 / 9.23:1 ต่อ stop — ค่าที่ตรวจคอนทราสต์มาแล้วใน §2 ห้ามแก้เอง)
// 🚨🚨 **ห้ามดันปลายอ่อนขึ้นไปถึง 19a97c** — ขาวบนค่านั้นได้แค่ 3.0:1 ตกเกณฑ์
// 🚨🚨 **ห้ามใช้หมึกเข้ม 0d3326 บนปุ่มนี้** — ตกทุก stop
// ⚠️ แผ่นไฮไลต์ด้านบนปุ่มจำกัดที่ white/10 และ **วางอยู่บนสต็อปอ่อนสุด (0c7c58,
// 5.20:1)** โดยตั้งใจ — ถ้าสลับทิศเฉดต้องย้ายแผ่นนี้ตามด้วย **ห้ามเพิ่มความทึบ**
// เพราะไฮไลต์ที่ทึบกว่านี้จะดันสต็อปอ่อนขึ้นไปใกล้ 19a97c แล้วขาวตกเกณฑ์
// 🚨🚨 **19a97c · 2fd49b · a3ddc3 · d2f3e4 · e2b32a ห้ามถือตัวอักษรบนผิวสว่าง** —
// เป็นเส้น/ขอบ/ออรา/พื้นถมเท่านั้น (ขอบปุ่มนี้คือทองอำพัน e2b32a ซึ่งเป็น "ขอบ"
// จึงใช้ได้ และเป็นตัวแยกปุ่มใบนี้จากปุ่มของหน้าเข้าสู่ระบบที่ขอบเป็นเขียวสด)
// ⚠️ ปุ่มนี้อยู่บนการ์ด **ผิวขาว** และตัวปุ่มเข้มกว่าการ์ดชัดเจน จึงไม่ต้องพึ่งเงาหนัก
// **เงาบนการ์ดสว่างต้องเบา** — rgba(13,51,38,0.10) และ hover ยกเป็น
// rgba(4,108,78,0.18) **ห้ามลอกค่า alpha 0.45-0.55 ของธีมมืดรอบก่อนมา**
// ⚠️⚠️ **ภาษาภาพของรอบนี้คือห้องโทนขาวงาช้าง ผ้าม่านโปร่ง ดอกลีลาวดีขาวกลางเหลือง
// หญิงสาวในชุดไทยเขียวมรกตปักทอง เครื่องประดับทองฝังพลอยเขียว ยอดปรางค์ทอง
// ลูกบอลหวยเขียว-ขาวพิมพ์ตัวเลข และใบโพยหวย** โลโก้เป็นเวิร์ดมาร์กสามมิติสองบรรทัด
// บรรทัดบนผิวโครเมียมเงินตัดขอบเขียวเข้ม ตัว O ตัวที่สองเป็นใบโคลเวอร์สี่แฉกเขียว
// มรกต บรรทัดล่างผิวเขียวมรกต — **ผนังห้องสีขาวงาช้างและสีผิวนางแบบเป็นวัตถุ
// ในภาพ ไม่ใช่สี UI** พื้นเพจมาจาก bg.json เท่านั้น **ห้ามอนุมานสีจากรูป**
// ออราในไฟล์นี้ใช้ rgba(13,51,38,α) · rgba(4,108,78,α) เท่านั้น
//
// ⚠️⚠️ กับดักรอบนี้: **มีแบรนด์เก่าหลายเจ้าในรีโปนี้ที่ก็เป็นเขียว** → "เจอเขียว
// อยู่แล้ว" จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้ ต้องเทียบ **ทีละหลัก** กับตารางใน
// brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ
// false positive **ผิว/หมึกของรอบนี้คือ e1fef3 / ffffff / f0fdf7 / d2f3e4 /
// a3ddc3 / 19a97c / 2fd49b / 052e22 / 03201a / 0a4433 / 046c4e / 0d3326 /
// 3f6f5c / 8a6508 / e9fbf3 / e2b32a / c8d4d0 / 0c7c58 / 03543c เท่านั้น**
// รอบนี้ **ไม่มีม่วง ไม่มีฟ้า/ไซแอน ไม่มีแมเจนต้า/ชมพู ไม่มีแดง และไม่มีส้ม**
// เลยสักเฉด · ปุ่ม LINE (00B900) อยู่บน /about-us กับ /contact-us ไม่ใช่หน้านี้
// **และห้ามกลืน 00B900 เข้าเขียวมรกตของรอบนี้** — รอบนี้สับสนง่ายที่สุดเพราะ
// แบรนด์ก็เป็นเขียว
// (เขียนเฮกซ์แบบถอด # และถอดวงเล็บโดยตั้งใจ — tools/gen-tw-sources.mjs สแกนไฟล์นี้
// แบบ plain text รวมคอมเมนต์ คลาสสีเต็มรูปในคอมเมนต์จะถูก generate ลง stylesheet จริง)
//
// Announcement รอบนี้หมุนมาเป็นตัวที่ลงท้ายด้วยคำว่าหวย ทั้งเว็บ
// (brand-spec §3 — รอบก่อนใช้ตัวท้ายชื่อพรีเมียมของตระกูลจึงหมุนออก · เขียนชื่อไฟล์
// แบบไม่มีเครื่องหมายคำพูดโดยตั้งใจ เพราะ tools/gen-tw-sources.mjs นับ literal
// ที่มีเครื่องหมายคำพูดว่าเป็นการ import จริง คอมเมนต์จึงทำให้ variant เก่าหลุดเข้า
// Tailwind scan แล้วสีของแบรนด์ก่อนขึ้น stylesheet) orchestrator เป็นเจ้าของ
// default message ของไฟล์นั้น จึงเรียกแบบ bare — **ห้ามส่ง prop message**
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) สตริงนี้ยาว 157
// ด้วยชื่อแบรนด์ 9 อักขระของรอบนี้ ส่วนที่ไม่ใช่ชื่อแบรนด์ยาว 148 → รับชื่อแบรนด์
// ได้ 2–12 อักขระ ถ้ารอบหน้าชื่อยาวกว่านั้นต้องแก้ข้อความ ไม่ใช่ปล่อยผ่าน
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} หวยพลัสลอตโต้ สมัคร 3 ขั้นตอน กดปุ่มเดียวไปยังหน้าลงทะเบียน ควรตรวจสอบข้อกำหนดด้านอายุ กฎหมายที่เกี่ยวข้อง และนโยบายความเป็นส่วนตัว`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/hx8w";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} หวยพลัสลอตโต้ ลงทะเบียน 3 ขั้นตอน กดปุ่มเดียว`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#e2b32a] bg-gradient-to-b from-[#0c7c58] via-[#046c4e] to-[#03543c] px-6 py-4 text-2xl font-black tracking-wide text-[#ffffff] shadow-[0_10px_30px_rgba(13,51,38,0.10)] transition-all duration-300 hover:scale-105 hover:border-[#2fd49b] hover:shadow-[0_15px_40px_rgba(4,108,78,0.18)]">
        <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-white/10 to-transparent"></span>
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
