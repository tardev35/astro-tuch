---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change (CtaRedirect.astro
// itself belongs to the orchestrator — ห้ามแก้ไฟล์นั้นจากหน้านี้)
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page, which means verify-build holds its
// description to the same 150–160 character window as every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES — คอปปี้ของหน้านี้จึงพูด
// ได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 14: ก่อนลงทะเบียนควรอ่านข้อกำหนดเกี่ยวกับคุณสมบัติ
// ผู้สมัคร การเปิดบัญชี และการจัดเก็บข้อมูลส่วนบุคคลให้ครบถ้วน · บรรทัด 18: ตั้ง
// รหัสผ่านที่ปลอดภัย ไม่ควรใช้ข้อมูลของบุคคลอื่นหรือเปิดเผยรหัส OTP ให้ใครทราบ ·
// บรรทัด 8: ก่อนเข้าร่วมควรตรวจสอบรายละเอียดโปรโมชั่นจากประกาศล่าสุด)
// ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า หน้านี้มีโควตาเป็นปุ่มเดียว
//
// ⚠️ แกนของบรีฟรอบนี้คือ **เว็บสล็อตออนไลน์ล้วน** — เกมสล็อตลิขสิทธิ์แท้
// ค่ายตรงมาแรง พร้อมโปรโมชั่นก่อนสิ้นปี 2026
// ศัพท์ของหมวดอื่นที่บรีฟไม่มีทุกคำจึงเป็นของค้างที่ห้ามหลุดกลับมา
// รายการคำเต็มอยู่ใน brand-spec §1 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไป
// เจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// คำที่ใช้ได้รอบนี้: เกมสล็อตออนไลน์ · ค่ายเกม · ลิขสิทธิ์ · โปรโมชั่น ·
// คืนยอดเสีย · แนะนำเพื่อน · สมัครสมาชิก · ลงทะเบียน · คุณสมบัติผู้สมัคร ·
// การเปิดบัญชี · ข้อมูลส่วนบุคคล · เข้าสู่ระบบ · รายการฝากถอน · รหัสผ่าน ·
// รหัส OTP · เจ้าหน้าที่ · แอดมิน · 24ชม. · เว็บไซต์ทางการ · ประกาศล่าสุด · ปี 2026
// พร้อมโปรโมชั่นสองรายการคือ **คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%**
// แบรนด์ก่อนหน้าขายตัวเองด้วยวลีที่บรีฟรอบนี้ไม่มีเลยสักคำ จึงต้องเขียน
// ใหม่จากบรีฟ ไม่ใช่ find-and-replace ทับของเดิม
// ⚠️ **สองหน้าหมวดลอตเตอรีของรอบก่อนถูกปิดรอบนี้** (ย้ายไป src/pages-disabled/)
// ห้ามลิงก์ไปสองเส้นทางนั้น route ไม่มีอยู่จริงแล้ว build จะแดง
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกม ชื่อธนาคาร หรือใบอนุญาตแม้แต่รายเดียว**
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 24ชม. · ปี 2026
// ห้ามแต่งใบอนุญาต หน่วยงานกำกับ ค่า RTP ยอดฝากขั้นต่ำ หรือจำนวนสมาชิก ·
// วลีขายของที่ห้ามใช้อยู่ใน brand-spec §1 · บรีฟมี "ขั้นตอนที่ 1-3" ของการสมัคร
// แต่นั่นเป็นของ index.astro (FeatureHighlights) **ห้ามยกมาเขียนซ้ำที่หน้านี้**
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตต์รอบนี้อยู่ใน .claude/brand-spec-prodeee168.md §2
// ⚠️⚠️ **รอบนี้เป็นแบรนด์ "ธีมสว่าง" รอบที่สี่ของรีโปนี้ — การ์ดสว่าง หมึกเข้ม**
// bg.json = {"mode":"color","color":"#ffd1d1"} = ชมพูพาสเทล **สว่าง** ไม่ใช่ดำ
// การ์ด ContentBox จึงเป็นผิว **ขาว** #ffffff บนหมึกน้ำตาลแดง #401107
// (= BRAND_TEXT) → คลาสสีของรอบก่อน (แดงคริมสัน + ทองโบราณ) กวาดออกครบแล้ว
// ปุ่มนี้เป็น PRIMARY: ถม **แดงเชอร์รี่** #eb0305 → #c20305 → #9b0a0c ขอบ #9b0a0c
// บนตัวอักษร **ขาว** (4.6 / 6.4 / 8.6:1 ผ่าน AA ทุก stop)
// ส่วน /login เป็น SECONDARY ถมทองแดงไหม้ #b44c06 → #7a2f03 บนตัวอักษรขาว
// จึงไม่ซ้ำกัน
// ⚠️ ปุ่มของ Navfoot เป็น **โครม** (พื้นน้ำตาลแดงเข้ม/ทองสาลี่) คนละโซนกับปุ่มบน
// การ์ดนี้ **ห้ามลอกคลาสของ Navfoot มาวางบนการ์ดสว่าง**
// ⚠️ ไล่เฉดต้อง **เริ่มที่ #eb0305 แล้วเข้มลงถึง #9b0a0c** ห้ามลากปลายเข้มเลยค่านั้น
// และ **ห้ามกลับด้านเป็นหมึกเข้มบนพื้นแดง** ขั้วของปุ่มนี้คือพื้นแดง-ตัวอักษรขาว
// ชั้นตกแต่งของปุ่มจึงเป็นชั้น **เข้มลง** ที่ขอบล่าง ไม่ใช่ sheen สว่างที่ขอบบน
// ⚠️⚠️ **ทองสาลี่ (f0b46a เขียนโดยไม่มี # เพื่อกัน sweep) ห้ามปรากฏในไฟล์นี้** — เป็นสีของโซนโครม
// และบนพื้นสว่างได้แค่ 1.8:1
// ⚠️⚠️ **แดงสด (ff4446) ห้ามถือตัวอักษรและห้ามเป็นพื้นของตัวอักษร** เป็น stop ของ
// ไล่เฉด/ออราเท่านั้น — ต้นเฉดของปุ่มนี้คือ #eb0305 ไม่ใช่ค่านั้น
// ออราในไฟล์นี้ใช้ rgba(235,3,5,α) · rgba(155,10,12,α) · rgba(64,17,7,α) เท่านั้น
//
// ⚠️ กับดักรอบนี้คือ **แดงนำมาแล้วมากกว่าฮิวอื่นใดในรีโปนี้ และรอบก่อนก็เป็นแดง+ทอง
// บนธีมสว่างชมพูเหมือนกัน** "มีแดงอยู่แล้ว" จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้ ให้เทียบเป็น
// "ค่า" ทีละหลักกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep
// หาสีของแบรนด์เก่าเจอ false positive
// รอบนี้ **ไม่มีเขียว ไม่มีชมพูบานเย็น ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง
// ไม่มีเงิน/โครเมียม และไม่มีโรสโกลด์**
//
// Announcement หมุนมาเป็น AnnouncementPremium ทั้งเว็บรอบนี้ (brand-spec §3 —
// รอบก่อนใช้ ticker คนละตัว จึงหมุนออก) orchestrator ตั้ง default
// message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare —
// ห้ามส่ง prop message
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) หน้านี้ยาว 156
// ด้วยชื่อแบรนด์ 8 ตัวอักษรของรอบนี้ (ส่วนที่ไม่ใช่ชื่อแบรนด์ยาว 148 จึงรับชื่อ
// ได้ตั้งแต่ 2 ถึง 12 ตัวอักษร — ยาวกว่านั้นต้องตัดข้อความ ไม่ใช่ปล่อยผ่าน)
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} กดปุ่มเดียวไปยังขั้นตอนลงทะเบียน ควรอ่านข้อกำหนดการเปิดบัญชีและเงื่อนไขโปรโมชั่นให้ครบ และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้ผู้อื่น`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} ลงทะเบียนเพื่อเข้าใช้งานเกมสล็อตและโปรโมชั่น`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#9b0a0c] bg-gradient-to-b from-[#eb0305] via-[#c20305] to-[#9b0a0c] px-6 py-4 text-2xl font-black tracking-wide text-[#ffffff] shadow-[0_10px_30px_rgba(235,3,5,0.45)] transition-all duration-300 hover:scale-105 hover:border-[#401107] hover:shadow-[0_15px_40px_rgba(155,10,12,0.6)]">
        <span aria-hidden="true" class="absolute inset-x-0 bottom-0 -z-10 h-1/2 bg-gradient-to-t from-[#9b0a0c]/60 to-transparent"></span>
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
