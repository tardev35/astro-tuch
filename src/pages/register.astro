---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. The page carries exactly ONE heading, and it is the
// level-one heading that ContentBox renders from its own `as` prop; there is no
// level-two and no level-three heading anywhere on it. Never write an article
// here and never add a second heading — verify-build fails the build the moment
// a second top-level heading appears on an indexable page.
// (The heading token is deliberately not spelled out in this comment: a source
// grep for it used to match the prose here as well as the real prop below, and
// every round someone had to re-derive which of the two matches was real.)
//
// ⚠️ This page is NOT one of the "full custom HTML + own <style> block"
// standalone pages SKILL.md Phase 4.5 warns about — it renders through
// MainLayout + ContentBox like every other sub-page, so it has no
// .brand-identity string and no raw-hex <style> block of its own. The only
// brand colours here are the Tailwind arbitrary values on the button below.
// Do not "restore" a <style> block; the font link and the <html> colour come
// from MainLayout.
// ⚠️ **ห้ามใช้ define:vars บนหน้านี้** — เดิมหน้านี้เป็น interstitial แบบ noindex
// จึงเคยได้รับการยกเว้น แต่ตอนนี้มันเป็นหน้าที่ index ได้ ข้อยกเว้นนั้นหมดไปแล้ว
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change.
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page (no `robots` prop = indexable), which means
// verify-build holds its description to the same 150–160 character window as
// every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) **ไม่มีส่วน SUB-PAGES** → title/description
// ของหน้านี้เขียนเอง และพูดได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 14: สมัครสมาชิกผ่าน
// โทรศัพท์มือถือและอุปกรณ์ที่เชื่อมต่ออินเทอร์เน็ต ควรตรวจสอบข้อกำหนดด้านอายุ
// กฎหมายที่เกี่ยวข้อง และนโยบายความเป็นส่วนตัว · บรรทัด 16: ตรวจสอบที่อยู่เว็บไซต์
// ให้ถูกต้อง · บรรทัด 18: ไม่ควรเปิดเผยรหัสผ่านและรหัส OTP ให้ใครทราบ)
// ⚠️ บรีฟรอบนี้ **มีหัวข้อสมัครสมาชิก 3 ขั้นตอนจริง แต่เป็นของ index.astro**
// (หัวข้อระดับสองที่ 6 ในเช็กลิสต์ brand-spec §4) **ไม่ใช่ของหน้านี้** — หน้านี้มี
// โควตาเป็น **ปุ่มเดียว** ห้ามแตกเป็นหัวข้อหรือรายการขั้นตอนบนหน้า
//
// 🚨 แกนของแบรนด์รอบนี้คือ **คาสิโนออนไลน์** บรีฟระบุหมวดเกมไว้ **ห้าหมวด**
// (บาคาร่า · สล็อตออนไลน์ · รูเล็ต · ไฮโล · คาสิโนสด)
// 🚨🚨 **รอบก่อนเป็นเว็บคนละแกนธุรกิจ — ห้ามสืบทอดศัพท์หมวดนั้นข้ามรอบเด็ดขาด**
// บรีฟรอบนี้ **ไม่มีคำนั้นเลยสักคำ** และไม่มีคำว่าเดิมพันกีฬาหรือยิงปลาด้วย
// ⚠️ น้ำเสียงของบรีฟรอบนี้คือ "โฆษณาและกำกับในประโยคเดียวกัน" ไม่ใช่การันตี
// คลังคำที่ใช้ได้รอบนี้อยู่ใน .claude/brand-spec-abm96.md §5 (ไม่พิมพ์ซ้ำที่นี่
// และ **ไม่พิมพ์คำของแบรนด์เก่าซ้ำที่นี่** เพื่อไม่ให้ sweep ของรอบถัดไปเจอ
// false positive ในคอมเมนต์ของไฟล์นี้เอง)
// ⚠️ กับดักรอบนี้: แบรนด์คาสิโนเจ้าก่อนๆ ก็เคยถือไฟล์กลุ่มนี้ และวลีของเจ้านั้นต่าง
// จากวลีของรอบนี้แค่คำท้าย — ต้องอ่านให้ครบวลีก่อนตัดสินว่าเป็นคำของบรีฟรอบนี้
// ตัวเลขที่อ้างได้รอบนี้มีแค่ 1 บาท · 0.3% · 0.8% · 24 ชั่วโมง · 3 ขั้นตอน
// — ห้ามแต่งใบอนุญาต จำนวนสมาชิก ปีก่อตั้ง ค่า RTP หรือค่าร้อยละอื่นใด
// 🚨🚨 **บรีฟรอบนี้ไม่มีชื่อผู้ให้บริการกระเป๋าเงิน ไม่มีชื่อธนาคาร และไม่มี
// คำว่าฝากถอนออโต้เลยสักคำ** — ห้ามเขียนถึงสิ่งเหล่านั้นบนหน้านี้ (บรีฟพูดถึง
// "ระบบสมาชิก" และ "ธุรกรรม" เท่านั้น ซึ่งไม่ใช่คำเดียวกัน)
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตรอบนี้อยู่ใน .claude/brand-spec-abm96.md §2
// 🚨🚨 **ทิศความสว่างเหมือนรอบก่อน แต่คนละตระกูลสีทั้งชุด: เนื้อหาสว่าง โครมเข้ม**
// bg.json = {"mode":"color","color":"#f8b9f0"} = ชมพูพาสเทลอิ่มตัว
// การ์ด ContentBox จึงเป็น **ผิวขาว ffffff บนหมึกเข้ม 3d0a2c** (= BRAND_TEXT,
// 16.4:1) — **ห้ามคืนการ์ดผิวเข้มของแบรนด์เก่ากลับมาแม้แต่ใบเดียว**
// ปุ่มนี้คือ **CTA หลัก** ของพาเลต ไล่เฉดชมพูบานเย็นสามสต็อป
// from d11a7e → via a30d63 → to 7a0449 บนหมึก **ขาว ffffff**
// (5.0 / 7.5 / 10.8:1 ต่อ stop — ค่าที่ตรวจคอนทราสต์มาแล้วใน §2 ห้ามแก้เอง)
// 🚨🚨 **ห้ามลากปลายอ่อนกว่า d11a7e** — ขาวบน e0509f เหลือ 3.6:1 ตกเกณฑ์
// 🚨🚨 **ห้ามใช้หมึกเข้ม 3d0a2c บนปุ่มนี้** — บน 7a0449 ได้ 1.5:1 ตกทุกสต็อป
// ⚠️ แผ่นไฮไลต์ด้านบนปุ่มจำกัดที่ white/10 และ **วางอยู่บนสต็อปอ่อนสุด (d11a7e,
// 5.0:1)** โดยตั้งใจ — ถ้าสลับทิศเฉดต้องย้ายแผ่นนี้ตามด้วย **ห้ามเพิ่มความทึบ**
// เพราะไฮไลต์ที่ทึบกว่านี้จะดันสต็อปอ่อนขึ้นไปใกล้ e0509f แล้วขาวตกเกณฑ์
// 🚨🚨 **fcd9ee · f3a7d3 · e0509f · ff7ac2 · f2c14e ห้ามถือตัวอักษรบนผิวสว่าง** —
// เป็นเส้น/ขอบ/ออรา/พื้นถมเท่านั้น (ขอบปุ่มนี้คือทองอำพัน f2c14e ซึ่งเป็น "ขอบ"
// จึงใช้ได้ และเป็นตัวแยกปุ่มใบนี้จากปุ่มของหน้าเข้าสู่ระบบที่ขอบเป็นชมพูกลาง)
// ⚠️ ปุ่มนี้อยู่บนการ์ด **ผิวขาว** และตัวปุ่มเข้มกว่าการ์ดชัดเจน จึงไม่ต้องพึ่งเงาหนัก
// **เงาบนการ์ดสว่างต้องเบา** — rgba(61,10,44,0.10) และ hover ยกเป็น
// rgba(163,13,99,0.18) **ห้ามลอกค่า alpha 0.45-0.55 ของธีมมืดของแบรนด์เก่ามา**
// ⚠️⚠️ **ภาษาภาพของรอบนี้คือฉากผ้าซาตินชมพูนวลพลิ้ว หญิงสาวผมยาวผูกโบว์ริบบิ้น
// ชมพูในชุดลูกไม้ ต่างหูรูปหัวใจ ไพ่เอซโพดำ-โพแดง ลูกเต๋าชมพูจุดขาว ชิปคาสิโน
// ชมพู-ขาว วงล้อรูเล็ตขอบทอง และหัวใจชมพูสามมิติลอยกระจาย** โลโก้เป็นเวิร์ดมาร์ก
// ละตินสามมิติอ้วนมนผิวไล่จากขาวนวลลงชมพูอ่อนตัดขอบชมพูเข้มสองชั้น โดยตัว A มี
// หัวใจชมพูซ้อนในช่องกลาง คู่กับมาสคอตลูกหมูการ์ตูนหูตกในจานวงกลมขอบขาว
// (**ไม่มีปีก และไม่ได้ชูสองนิ้ว** — สองอย่างนั้นเป็นของแบรนด์เก่าคนละเจ้า)
// — **ผ้าซาตินและสีผิวนางแบบเป็นวัตถุในภาพ ไม่ใช่สี UI** พื้นเพจมาจาก bg.json
// เท่านั้น **ห้ามอนุมานสีจากรูป**
// ออราในไฟล์นี้ใช้ rgba(61,10,44,α) · rgba(163,13,99,α) เท่านั้น
//
// ⚠️⚠️ กับดักรอบนี้: **มีแบรนด์เก่าหลายเจ้าในรีโปนี้ที่ก็เป็นชมพู** (เจ้าหนึ่งเป็น
// ชมพูบานเย็น/ทองตระกูลเดียวกันเป๊ะ อีกเจ้าเป็นชมพูบับเบิลกัม และอีกเจ้าแดงชาด/
// ชมพูบลัช ชื่อทั้งสามอยู่ใน brand-spec §2b) → "เจอชมพูอยู่แล้ว" จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้ ต้องเทียบ
// **ทีละหลัก** กับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่เพื่อไม่ให้ grep
// หาสีของแบรนด์เก่าเจอ false positive **ผิว/หมึกของรอบนี้คือ f8b9f0 / ffffff /
// fff5fb / fcd9ee / f3a7d3 / e0509f / ff7ac2 / 440d31 / 2b0620 / 5e1746 /
// 3d0a2c / 7a4263 / a30d63 / 6e4705 / ffeef8 / e8c3da / f2c14e / d11a7e /
// 7a0449 เท่านั้น**
// รอบนี้ **ไม่มีเขียว ไม่มีส้ม ไม่มีแดงชาด ไม่มีม่วง ไม่มีฟ้า/ไซแอน** เลยสักเฉด ·
// ปุ่ม LINE (00B900) อยู่บน footer กับ /contact-us ไม่ใช่หน้านี้
// **และห้ามกลืน 00B900 เข้าพาเลตชมพูของรอบนี้**
// (เขียนเฮกซ์แบบถอด # และถอดวงเล็บโดยตั้งใจ — tools/gen-tw-sources.mjs สแกนไฟล์นี้
// แบบ plain text รวมคอมเมนต์ คลาสสีเต็มรูปในคอมเมนต์จะถูก generate ลง stylesheet จริง)
//
// Announcement รอบนี้หมุนมาเป็นตัวที่ลงท้ายด้วยเลขห้า ทั้งเว็บ
// (brand-spec §3 — รอบก่อนใช้ตัวที่ลงท้ายด้วยชื่อตระกูลของแบรนด์ก่อนจึงหมุนออก ·
// เขียนชื่อไฟล์
// แบบไม่มีเครื่องหมายคำพูดโดยตั้งใจ เพราะ tools/gen-tw-sources.mjs นับ literal
// ที่มีเครื่องหมายคำพูดว่าเป็นการ import จริง คอมเมนต์จึงทำให้ variant เก่าหลุดเข้า
// Tailwind scan แล้วสีของแบรนด์ก่อนขึ้น stylesheet) orchestrator เป็นเจ้าของ
// default message ของไฟล์นั้น จึงเรียกแบบ bare — **ห้ามส่ง prop message**
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) สตริงนี้ยาว 155
// ด้วยชื่อแบรนด์ 5 อักขระของรอบนี้ ส่วนที่ไม่ใช่ชื่อแบรนด์ยาว 150 → รับชื่อแบรนด์
// ได้ไม่เกิน 10 อักขระ ถ้ารอบหน้าชื่อยาวกว่านั้นต้องแก้ข้อความ ไม่ใช่ปล่อยผ่าน
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} เว็บเอเอ็มบีคาสิโน กดปุ่มเดียวไปยังหน้าลงทะเบียน ควรตรวจสอบข้อกำหนดด้านอายุ กฎหมายที่เกี่ยวข้อง และนโยบายความเป็นส่วนตัวก่อนดำเนินการ`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/hx8w";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} เว็บเอเอ็มบีคาสิโน กดปุ่มเดียวไปยังหน้าลงทะเบียน`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f2c14e] bg-gradient-to-b from-[#d11a7e] via-[#a30d63] to-[#7a0449] px-6 py-4 text-2xl font-black tracking-wide text-[#ffffff] shadow-[0_10px_30px_rgba(61,10,44,0.10)] transition-all duration-300 hover:scale-105 hover:border-[#ff7ac2] hover:shadow-[0_15px_40px_rgba(163,13,99,0.18)]">
        <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-white/10 to-transparent"></span>
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
