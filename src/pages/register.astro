---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 156.
const pageDescription =
  "หน้าสมัครสมาชิก OSAKA198 กดปุ่มเดียวเปิดยูสเซอร์ใหม่ด้วยตัวเอง เริ่มแทงสล็อต 1 บาท ไม่มีขั้นต่ำ เล่นได้ทุกค่ายในเว็บเดียว พร้อมรับสิทธิ์โปรโมชั่นเฉพาะสมาชิก";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก OSAKA198 เปิดยูสเซอร์ใหม่",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก OSAKA198 เปิดยูสเซอร์ใหม่ด้วยตัวเอง เริ่มเล่นสล็อตได้ทันที" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก OSAKA198" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก OSAKA198"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#d1ae72]/60 bg-gradient-to-r from-[#f7f1e4] via-[#e4cc95] to-[#a37c4b] px-6 py-4 text-lg font-black text-[#0b0906] shadow-[0_10px_30px_rgba(209,174,114,0.25)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(209,174,114,0.45)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
