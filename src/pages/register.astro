---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char).
const pageDescription =
  "หน้าสมัครสมาชิก CAMPING289 สำหรับผู้ที่ต้องการเปิดบัญชีใหม่ด้วยตัวเองผ่านมือถือ กรอกข้อมูลตามที่ระบบกำหนด แล้วเข้าสู่ระบบเพื่อตรวจสอบสิทธิพิเศษได้ทันทีทุกวัน";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก CAMPING289 เปิดบัญชีใหม่",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก CAMPING289 สล็อตเว็บตรงเจ้าของแท้ เปิดบัญชีใหม่บนมือถือด้วยตัวเองได้ทุกวัน" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก CAMPING289" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก CAMPING289"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#9ada4e]/70 bg-gradient-to-r from-[#9ada4e] via-[#69b522] to-[#0b5232] px-6 py-4 text-lg font-black text-[#020a05] shadow-[0_10px_30px_rgba(105,181,34,0.25)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(219,170,138,0.30)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
