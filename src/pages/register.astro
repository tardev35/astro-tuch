---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change.
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page, which means verify-build holds its
// description to the same 150–160 character window as every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES — คอปปี้ของหน้านี้จึงพูด
// ได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 16–18: ควรตรวจสอบความถูกต้องของช่องทางสมัคร
// และอ่านรายละเอียดคุณสมบัติผู้สมัครกับข้อกำหนดในการเปิดบัญชีให้ครบถ้วนก่อน
// ดำเนินการ) ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า หน้านี้มีโควตาเป็นปุ่มเดียว
//
// ⚠️ แบรนด์รอบนี้เป็น **เว็บเกมสล็อตล้วน** ตามบรีฟ — ไม่ใช่คาสิโน ไม่ใช่กีฬา
// ไม่ใช่หวย คำที่ห้ามหลุดกลับมาอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้
// grep หาคำต้องห้ามเจอ false positive · แบรนด์ก่อนๆ ขายตัวเองด้วยวลีที่บรีฟรอบนี้
// ไม่มีเลยสักคำ
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 24 ชั่วโมง · 100% · 3 ขั้นตอน
// ห้ามแต่งใบอนุญาต หน่วยงานกำกับ ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP ยอดขั้นต่ำ
// จำนวนสมาชิก หรือปีใดๆ (บรีฟรอบนี้ไม่ได้เอ่ยปีไว้เลย) — หัวข้อสมัคร 3 ขั้นตอนกับ
// แอดมิน 24 ชั่วโมงของบรีฟ (บรรทัด 15–24) เป็นของ index.astro ไม่ใช่ของหน้านี้
// ห้ามยกมาเขียนซ้ำที่นี่
//
// แบรนด์รอบนี้ (ขวัญใจ168, รอบ **ทองนำ โรสโกลด์เป็นฮิวที่สอง แดงชาดเป็นสำเนียงลึก
// บนดำสนิท** 2026-10-18, brand-spec §2): โลโก้คือคำว่า "ขวัญใจ" ตัวอักษรไทยหนา
// สามมิติผิวทองขัดเงาตัดขอบแดงเข้ม ต่อด้วยเลข "168" ทองสามมิติ — **vivid อันดับ
// หนึ่งที่ palette.json วัดได้จากทั้งโลโก้และแบนเนอร์คือโรสโกลด์ #f2bba5
// จึงเป็นฮิวที่สองจริงของรอบนี้ ส่วนแดงชาดถอยไปเป็นสำเนียงลึกที่ไม่เคยนำ**
// ทองลึก #8a5f12 · แดงชาด #b3121b · แดงลึก #5a0a0e (สามตัวนี้ห้ามถือตัวอักษร) ·
// ตัวที่ถือตัวอักษรได้: ทองสว่าง #ffe6a3 (14.5:1) · โรสโกลด์ #f2bba5 (10.4:1) ·
// ทองแบรนด์ #f7c92b (7.3:1) · โรสเข้ม #c98a74 (7.2:1) ·
// เนื้อความ #eadfce (= BRAND_TEXT) · หมึกบนพื้นถมทอง #140c06
// ชั้นผิว: ยก #241509 (= การ์ด ContentBox) / กลาง #160d06 / จม #0b0603 /
// พื้นเพจ #000000 — bg.json รอบนี้เป็นดำสนิท ไม่ใช่ดำอมแดงแบบรอบก่อน
// ปุ่มนี้เป็น PRIMARY: ถมพื้น **ทอง** ไล่เฉด #ffe6a3 → #f7c92b ขอบ #8a5f12
// บนหมึกเข้ม #140c06 (15.6:1 บนปลายสว่าง #ffe6a3 · 7.9:1 บนปลายเข้มสุด #f7c92b)
// ⚠️ ห้ามกลับด้าน: พื้นถมทองต้องใช้หมึก #140c06 เสมอ ห้ามขาวหรือครีม และไล่เฉดต้อง
// **หยุดที่ #f7c92b** ห้ามไล่ลงไปถึง #8a5f12 ใต้ตัวอักษร — ทองลึกอยู่ได้เฉพาะเป็น
// เส้นขอบของปุ่มนี้
// — ส่วน /login เป็น SECONDARY ชั้นจมขอบโรสเข้มบนตัวอักษรโรสโกลด์ จึงไม่ซ้ำกัน ·
// #8a5f12 #b3121b #5a0a0e ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่เส้นขอบ ออรา พื้นถม
// และเงา — ออราในไฟล์นี้ใช้ rgba(247,201,43,α) เท่านั้น นอกจากเงาดำล้วน
// ⚠️ กับดักรอบนี้คือ **ทอง** เพราะแทบทุกแบรนด์ที่ผ่านไฟล์นี้มีทองอยู่ด้วย
// "มีทองอยู่แล้ว" จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้ ทองรอบนี้คือ #f7c92b
// (247,201,43) ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำ
// ที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive
// และรอบนี้ **ไม่มีม่วง ไม่มีชมพูบานเย็น ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว ไม่มีส้ม
// ไม่มีเงินอมฟ้า**
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ (brand-spec §3 —
// รอบก่อนใช้ AnnouncementPremium จึงหมุนออก) orchestrator ตั้ง default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare — ห้ามส่ง prop message
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) หน้านี้ยาว 153
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} กดปุ่มเดียวไปยังหน้าลงทะเบียนสมาชิกของศูนย์บริการเกมสล็อตออนไลน์ ควรอ่านคุณสมบัติผู้สมัครและข้อกำหนดในการเปิดบัญชีก่อนดำเนินการ`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/2u19";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} ลงทะเบียนสมาชิกจากศูนย์บริการหลัก`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#8a5f12] bg-gradient-to-b from-[#ffe6a3] to-[#f7c92b] px-6 py-4 text-2xl font-black tracking-wide text-[#140c06] shadow-[0_10px_30px_rgba(247,201,43,0.4)] transition-all duration-300 hover:scale-105 hover:border-[#140c06] hover:shadow-[0_15px_40px_rgba(247,201,43,0.6)]">
        <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ffe6a3]/70 to-transparent"></div>
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
