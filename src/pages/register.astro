---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char).
const pageDescription =
  "หน้าสมัครสมาชิก JADTEM88 สำหรับผู้ที่ต้องการเปิดบัญชีใหม่ด้วยตัวเองผ่านมือถือ กรอกข้อมูลตามที่ระบบกำหนด แล้วเข้าสู่ระบบเพื่อตรวจสอบโปรโมชั่นที่มีสิทธิ์รับ";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก JADTEM88 เปิดบัญชีใหม่",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก JADTEM88 สล็อตเครือยักษ์ใหญ่ เปิดบัญชีใหม่ด้วยตัวเองบนมือถือได้ทุกวัน" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก JADTEM88" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก JADTEM88"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#2563eb]/70 bg-gradient-to-r from-[#e2e8f0] via-[#93c5fd] to-[#60a5fa] px-6 py-4 text-lg font-black text-[#03060f] shadow-[0_10px_30px_rgba(59,130,246,0.25)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(203,213,225,0.30)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
