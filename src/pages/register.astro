---
import { fontStack, usesGoogleFonts } from "../lib/brandProfile";

const targetUrl = "https://yoalink.com/5n82";

// This page has its own <head> and does not import global.css, so it gets
// neither the @theme fallback for --font-sans nor the self-hosted Kanit
// @font-face. Both have to be supplied here or the page renders in the browser
// default while the rest of the site does not — hence the @font-face rules in
// the first <style> block below.
//
// Oswald is the only face left that needs a CDN: the two display headings use
// it and it is not self-hosted.
//
// The font request below is derived from BRAND_FONT, never typed by hand. The
// old value asked Google for "Kanit:wght@300;400;600" even though the site
// self-hosts Kanit: a third-party request for weights nothing here draws (300
// and 600 are used zero times), and a query string byte-identical on every
// Kanit brand in the portfolio — the shared signature BRAND_FONT exists to
// break up.
const fontHref = usesGoogleFonts
  ? "https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&family=Oswald:wght@700&display=swap"
  : "https://fonts.googleapis.com/css2?family=Oswald:wght@700&display=swap";
---

<html lang="th" style={`--font-sans: ${fontStack};`}>
  <head>
    <meta charset="utf-8" />
    <title>สมัครสมาชิก 12PLAY | กำลังเชื่อมต่อไปหน้าสมัครอัตโนมัติ</title>
    <meta name="description" content="หน้าเชื่อมต่อสมัครสมาชิก 12PLAY สำหรับผู้ที่ต้องการเปิดบัญชีเล่นคาสิโนสด บาคาร่า รูเล็ต เสือมังกร และสล็อต ระบบกำลังพาไปหน้าสมัครอัตโนมัติ รองรับทุกอุปกรณ์" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {
      /* This page exists only to forward; there is nothing here worth ranking,
        and its source carries the affiliate URL — the one host every brand in
        the group has in common. Keeping it out of the index means that link is
        not sitting in a page Google has stored. Astro's own /line redirect page
        ships noindex for the same reason. */
    }
    <meta name="robots" content="noindex, follow" />

    <meta http-equiv="refresh" content={`1.5;url=${targetUrl}`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontHref} rel="stylesheet" />

    <style>
      /* Self-hosted Kanit. This page has its own <head> and does not import
         global.css, so the @font-face rules there never reach it — which is why
         it used to pull Kanit from Google instead. Only the weights this page
         actually draws are declared. Kanit is the fallback inside fontStack, so
         these stay declared even on a Google Sans brand. */
      @font-face {
        font-family: "Kanit";
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url("/fonts/kanit-v17-latin_thai-regular.woff2") format("woff2");
      }
      @font-face {
        font-family: "Kanit";
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url("/fonts/kanit-v17-latin_thai-700.woff2") format("woff2");
      }
    </style>

    <style>
      /* 12PLAY is a dark casino brand on near-black: the wordmark reads 12PLAY
         in glossy red with polished chrome/silver bevels, so red is the primary
         accent and chrome the secondary — no blue, no gold anywhere. Every
         variable below is NAMED FOR THE COLOUR IT HOLDS, which previous brands
         stopped doing: this block twice shipped a `--brand-<hue>` variable
         naming a hue that brand did not have anywhere, so the next editor
         reused the name and shipped the wrong colour. If the value moves to
         another hue, rename the variable in the same edit. */
      :root {
        --page-bg: #0a0102;
        --panel-bg: rgba(26, 3, 4, 0.94);
        --brand-red: #e01020;
        --brand-red-deep: #8a0710;
        --brand-red-dark: #4b0304;
        --brand-red-light: #ff5a63;
        --brand-chrome: #f4eff0;
        --brand-chrome-deep: #cbd0d8;
        --text-body: #e0d7d8;
        --text-muted: #8f959f;
      }

      body {
        margin: 0;
        font-family: var(--font-sans);
        color: var(--text-body);

        background: radial-gradient(circle at 50% 10%, rgba(224, 16, 32, 0.2) 0%, transparent 55%), radial-gradient(circle at 50% 92%, rgba(244, 239, 240, 0.14) 0%, transparent 55%), var(--page-bg);
        display: flex;
        min-height: 100vh;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
      }

      .premium-loading-container {
        width: 90%;
        max-width: 450px;
        padding: 3.5rem;
        background: var(--panel-bg);
        border: 1px solid rgba(224, 16, 32, 0.4);
        border-radius: 2rem;
        box-shadow:
          0 1rem 3rem rgba(224, 16, 32, 0.18),
          0 0 2rem rgba(244, 239, 240, 0.16);
        text-align: center;
        backdrop-filter: blur(10px);
      }

      .brand-identity {
        font-family: "Oswald", sans-serif;
        font-size: 1.5rem;
        font-weight: 700;
        background: linear-gradient(180deg, var(--brand-chrome) 0%, var(--brand-red-light) 40%, var(--brand-red) 72%, var(--brand-red-dark) 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        letter-spacing: 0.3em;
        margin-bottom: 2rem;
        filter: drop-shadow(0 1px 2px rgba(224, 16, 32, 0.4));
      }

      .sophisticated-loader {
        position: relative;
        width: 100px;
        height: 100px;
        margin: 0 auto 3.5rem auto;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .orb {
        width: 40px;
        height: 40px;
        background: radial-gradient(circle, var(--brand-red-light) 0%, var(--brand-red) 45%, var(--brand-red-dark) 100%);
        border-radius: 50%;
        box-shadow: 0 0 2rem rgba(224, 16, 32, 0.4);
        animation: pulse 2s ease-in-out infinite;
      }

      .ring {
        position: absolute;
        border-radius: 50%;
        border: 3px solid rgba(224, 16, 32, 0.2);
        animation: spin linear infinite;
      }

      .ring-1 {
        width: 100%;
        height: 100%;
        border-top-color: var(--brand-chrome);
        animation-duration: 4s;
      }

      .ring-2 {
        width: 80%;
        height: 80%;
        border-bottom-color: var(--brand-red-deep);
        animation-duration: 6s;
        animation-direction: reverse;
      }

      @keyframes spin {
        0% {
          transform: rotate(0deg);
        }
        100% {
          transform: rotate(360deg);
        }
      }
      @keyframes pulse {
        0%,
        100% {
          transform: scale(1);
          box-shadow: 0 0 2rem rgba(224, 16, 32, 0.4);
        }
        50% {
          transform: scale(1.15);
          box-shadow: 0 0 3rem rgba(224, 16, 32, 0.55);
        }
      }

      .status-text .h1 {
        font-family: "Oswald", sans-serif;
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text-body);
        text-shadow: 0 1px 1px rgba(224, 16, 32, 0.3);
        margin: 0;
      }
      .status-text .p {
        font-size: 0.875rem;
        color: var(--text-muted);
        line-height: 1.6;
        margin: 1rem 0 0 0;
      }
    </style>
  </head>
  <body>
    <div class="premium-loading-container">
      <div class="brand-identity">12PLAY</div>

      <div class="sophisticated-loader">
        <div class="orb"></div>
        <div class="ring ring-1"></div>
        <div class="ring ring-2"></div>
      </div>

      <div class="status-text">
        <h1 class="h1">CREATING SECURE ACCOUNT SESSION...</h1>
        <p class="p">กำลังพาไปหน้าสมัครสมาชิก 12PLAY เพื่อเริ่มเล่นคาสิโนสด บาคาร่า รูเล็ต เสือมังกร และสล็อตทุกค่าย <span aria-hidden="true">🔒</span></p>
      </div>
    </div>

    <script define:vars={{ targetUrl }}>
      setTimeout(() => {
        window.location.replace(targetUrl);
      }, 3000);
    </script>
  </body>
</html>
