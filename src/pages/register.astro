---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change.
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page, which means verify-build holds its
// description to the same 150–160 character window as every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES — คอปปี้ของหน้านี้จึงพูด
// ได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 10–13: คืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อน
// โบนัส 0.8% ไม่จำกัด) ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า หน้านี้มีโควตาเป็นปุ่มเดียว
// บรีฟยังกำกับเองว่าคำว่า "ไม่จำกัด" ควรระบุให้ชัดว่าหมายถึงอะไร คอปปี้ตรงนี้จึงเขียน
// ว่าโบนัส 0.8% เป็นไปตามเกณฑ์ที่กำหนด แทนที่จะโปรยคำว่าไม่จำกัดลอยๆ
//
// ⚠️ แบรนด์รอบนี้เป็น **เว็บเกมสล็อตล้วน** ตามบรีฟ — ไม่ใช่คาสิโน ไม่ใช่กีฬา
// ไม่ใช่หวย คำที่ห้ามหลุดกลับมาอยู่ใน brand-spec §7 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้
// grep หาคำต้องห้ามเจอ false positive · สองแบรนด์ก่อนหน้าขายกรอบ
// "คาสิโน + กีฬา + เซิร์ฟเวอร์นอก" ซึ่งบรีฟรอบนี้ไม่มีเลยสักคำ
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 24 ชั่วโมง — ห้ามแต่งใบอนุญาต
// หน่วยงานกำกับ ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP ยอดขั้นต่ำ จำนวนสมาชิก หรือปีใดๆ
// (บรีฟรอบนี้ไม่ได้เอ่ยปีไว้เลย) — หัวข้อสมัคร 3 ขั้นตอนกับแอดมิน 24 ชั่วโมงของบรีฟ
// (บรรทัด 14–21) เป็นของ index.astro ไม่ใช่ของหน้านี้ ห้ามยกมาเขียนซ้ำที่นี่
//
// แบรนด์รอบนี้ (สมหวัง168, รอบแดงมังกร-ทองไทยบนพื้นดำอมแดง 2026-10-17,
// brand-spec §2): **สองโทนจริง แดงมังกรนำ ทองไทยรอง** — รอบก่อนสีรองเป็น
// โครเมียมขาว รอบนี้ดึง **ทอง** จากลายกนกในอาร์ตเวิร์กมาแทน
// แดงแบรนด์ #fa0513 · แดงลึก #b90203 #8c0204 #3c0303 · ทองลึก #8a6210 ·
// ตัวที่ถือตัวอักษรได้: ทองสว่าง #ffe5a8 (14.1:1) · ทองไทย #e3b23c (8.9:1) ·
// แดงอ่อนไฮไลต์ #ffadaf (9.8:1) · ตัวอักษรรอง #ccb9b6 (9.2:1) ·
// แดงสว่าง #ff5a5f (5.7:1) · เนื้อความ #f4ecea (= BRAND_TEXT) ·
// หมึกบนพื้นสว่าง/พื้นถมแดง #170504
// ชั้นผิว: ยก #2c1413 (= การ์ด ContentBox) / กลาง #1f0d0c / จม #140706 /
// พื้นเพจ #290f0f — รอบนี้ bg.json เป็นดำอมแดง ไม่ใช่ดำสนิท
// ปุ่มนี้เป็น PRIMARY: ถมพื้นแดงไล่เฉด #ffadaf → #fa0513 ขอบ #b90203
// บนหมึกเข้ม #170504 (9.8:1 บนปลายสว่าง #ffadaf · 4.8:1 บนปลายเข้มสุด #fa0513)
// ⚠️ ห้ามกลับด้าน: พื้นถมแดงต้องใช้หมึกเข้มเสมอ ห้ามขาวหรือครีม และไล่เฉดต้อง
// **หยุดที่ #fa0513** ห้ามไล่เข้มกว่านั้นใต้ตัวอักษร — #b90203 อยู่ได้เฉพาะเป็น
// เส้นขอบของปุ่มนี้
// — ส่วน /login เป็น SECONDARY ชั้นจมขอบทอง จึงไม่ซ้ำกัน · #fa0513 #b90203
// #8c0204 #3c0303 #8a6210 ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่เส้นขอบ ออรา พื้นถม
// และเงา — ออราในไฟล์นี้ใช้ rgba(250,5,19,α) เท่านั้น นอกจากเงาดำล้วน
// ⚠️ กับดักรอบนี้คือ **แดง** และหนักเป็นพิเศษ เพราะสองแบรนด์ก่อนหน้าก็เป็นแดง
// เหมือนกันทั้งคู่ และต่างจากแดงรอบนี้ (#fa0513) แค่หลักเดียว
// "มีแดงอยู่แล้ว" จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้ ให้เทียบเป็น "ค่า" ทีละตัวกับตาราง
// ใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ
// false positive — และรอบนี้ **ไม่มีโครเมียมขาว/เงินเป็นสีระบบ ไม่มีม่วง
// ไม่มีชมพู ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว ไม่มีส้ม**
//
// Announcement หมุนมาเป็น Announcement3 ทั้งเว็บรอบนี้ (brand-spec §3 — แบรนด์ก่อน
// ใช้ Announcement5/Announcement2 จึงหมุนออกทั้งคู่) orchestrator ตั้ง
// default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare
// — ห้ามส่ง prop message
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) หน้านี้ยาว 153
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} กดปุ่มเดียวไปยังหน้าสมัครของเว็บเกมสล็อต พร้อมโปรโมชั่นคืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อน โบนัส 0.8% ตามเกณฑ์ที่กำหนด`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/2u19";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} เว็บเกมสล็อต สมัครจากทางเข้าหลัก`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#b90203] bg-gradient-to-b from-[#ffadaf] to-[#fa0513] px-6 py-4 text-2xl font-black tracking-wide text-[#170504] shadow-[0_10px_30px_rgba(250,5,19,0.4)] transition-all duration-300 hover:scale-105 hover:border-[#170504] hover:shadow-[0_15px_40px_rgba(250,5,19,0.6)]">
        <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ffadaf]/70 to-transparent"></div>
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
