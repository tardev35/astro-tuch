---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect. The title and
// description below were rewritten this round for exactly that reason.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// หวยเต็ง (รอบเขียวป่า-ทอง 2026-10-01): ปุ่มนี้เป็นตัว PRIMARY ของคู่
// จึงสวมไล่เฉดทองประจำแบรนด์เต็มใบ (#fae474 → #e5c04f → #bd8d2d) บนตัวอักษรหมึกเข้ม
// #0a1a0c ซึ่งได้คอนทราสต์สูงสุดบนพื้นทอง — ตัวอักษรขาวบน #e5c04f ตก AA จึงห้ามใช้
// ส่วน /login รับแบบ outline — กรอบเขียวแบรนด์ #026314 บนผิวยก #0b3d18 แทน
// สองลำดับ หนึ่งรูปแบบต่อหนึ่งปุ่ม ไม่ใช่ถมทองสองใบซึ่งจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม
// ชุดน้ำเงินรอยัล-ทองของ BRAVO168 (#02081a #04142f #072247 #0e3f8f #1558c4 #2f86f0
// #f4cb69 #ffe39a #c9922e #dbe5f5 #0a1020 rgba(244,203,105,*) rgba(21,88,196,*)
// rgba(2,8,26,*)) ออกครบแล้ว
//
// Announcement หมุนมาเป็น Announcement3 ทั้งเว็บรอบนี้ (รอบก่อนเป็น
// AnnouncementPremium) — default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ
// index ก็เรียกแบบ bare
//
// หวยเต็ง เป็นเว็บแทงหวยออนไลน์ ไม่ใช่บอลและไม่ใช่สล็อต — บรีฟระบุการสมัครผ่านมือถือ
// ได้เองด้วย 3 ขั้นตอน (เข้าหน้าสมัครและกรอกข้อมูลตามที่ระบบกำหนด → ยืนยันข้อมูลและ
// Login เข้าบัญชีสมาชิก → เลือกรายการหวย เลขที่ต้องการ และตรวจสอบอัตราจ่ายก่อนส่งโพย)
// แล้วใช้บัญชีเดียวติดตามรัฐบาลไทย ลาวพัฒนา ฮานอย และหวยหุ้นต่างประเทศ พร้อมตรวจสอบ
// โพย ประวัติรายการ และผลหวย
// คำศัพท์ของสองแบรนด์ก่อน (บอล ฟุตบอล บอลเดี่ยว บอลสเต็ป บอลสด ค่าน้ำ อัตราต่อรอง
// ลีก คู่แข่งขัน แมตช์ บิล แฮนดิแคป สล็อต ฟรีสปิน แจ็กพอต บาคาร่า รูเล็ต คาสิโน)
// ห้ามหลงเหลือ และห้ามเพิ่มชื่อธนาคาร ยอดฝากขั้นต่ำ ชื่อผู้ให้บริการจริง หรือเลขใบอนุญาต
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 155
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = "หน้าสมัครสมาชิก หวยเต็ง กดปุ่มเดียวเปิดบัญชีด้วยตัวเองผ่านหน้าเว็บบนมือถือ แล้วเข้าสู่ระบบเลือกรายการหวย ส่งโพย และตรวจสอบอัตราจ่ายของแต่ละรอบจากบัญชีเดียว";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก หวยเต็ง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="สมัครสมาชิก หวยเต็ง เปิดบัญชีเองผ่านเว็บ เริ่มแทงหวยไม่ต้องลงแอป" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก หวยเต็ง" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก หวยเต็ง"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fae474]/70 bg-gradient-to-r from-[#fae474] via-[#e5c04f] to-[#bd8d2d] px-6 py-4 text-lg font-black text-[#0a1a0c] shadow-[0_10px_30px_rgba(229,192,79,0.45)] transition-all duration-300 hover:scale-105 hover:border-[#fae474] hover:shadow-[0_15px_40px_rgba(229,192,79,0.35)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
