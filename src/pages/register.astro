---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
//
// KINGDOM66 (รอบทองราชวงศ์บนดำ 2026-09-25): ปุ่มนี้เป็นตัว PRIMARY ของคู่ จึงสวมไล่เฉด
// ทองของแบรนด์เต็มใบ (#f2d683 → #e6bf4e → #5c4113) บนตัวอักษรเกือบดำ #151109 เพราะ
// ตัวหนังสือบนพื้นทองต้องเป็นสีเข้มจึงจะอ่านออก ห้ามใช้ขาว ส่วน /login ใช้ทองเดียวกัน
// เป็นเส้นขอบบนผิวการ์ดยก #241c13 แทน — สองลำดับ หนึ่งการถมสีต่อหนึ่งปุ่ม ตามโลโก้ที่
// คำว่า KINGDOM เป็นทองสลักและเลข 66 เป็นทองสว่าง รอบนี้ไม่มีเฉดโครเมียมเย็น
// เฉดที่สองเป็นแพลตินัมครีมอุ่น #efe6cf
// ชุดทอง-โครเมียมของ UWIN33 (#e0b429 #fbd564 #7a5407 #dfe4ec #26200e #fff8e6)
// ออกครบแล้ว
//
// Announcement รอบนี้หมุนจาก AnnouncementPremium มาเป็น AnnouncementCyber ทั้งเว็บ —
// default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ index ก็เรียกแบบ bare
// จึงห้ามส่ง prop
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 154
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = "สมัครสมาชิก KINGDOM66 กดปุ่มเดียวเปิดบัญชีใหม่ด้วยตัวเอง รองรับทั้งมือถือและคอมพิวเตอร์ จากนั้นเข้าสู่ระบบเลือกบาคาร่า ไพ่ สล็อต หวย บอล และไลฟ์สดได้ทันที";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก KINGDOM66",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="สมัครสมาชิก KINGDOM66 เปิดบัญชีใหม่ด้วยตัวเอง เล่นได้จากบัญชีเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก KINGDOM66" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก KINGDOM66"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f2d683] bg-gradient-to-r from-[#f2d683] via-[#e6bf4e] to-[#5c4113] px-6 py-4 text-lg font-black text-[#151109] shadow-[0_10px_30px_rgba(230,191,78,0.50)] transition-all duration-300 hover:scale-105 hover:border-[#efe6cf] hover:shadow-[0_15px_40px_rgba(239,230,207,0.40)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
