---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1×1, h2×0, h3×0. Never write an article here and never add an <h2>.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change.
//
// CtaRedirect.astro เป็น shared chrome ที่ orchestrator retheme ให้แล้วรอบนี้ —
// หน้านี้แค่ render มัน ห้ามแก้ไฟล์นั้นจากหน้านี้
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens. It is an indexed page now, which
// means verify-build holds its description to the same 150–160 character window
// as every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES และไม่ได้ให้ขั้นตอน
// สมัครเป็นข้อๆ ไว้เลย — คอปปี้ของหน้านี้จึงพูดได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 4:
// รวมเกมสล็อตหลายรูปแบบไว้ในแพลตฟอร์มเดียว ใช้บัญชีเดียว · บรรทัด 6: บางเกม
// เริ่มต้นได้ตั้งแต่ 1 บาทตามช่วงเดิมพันที่กำหนด) ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า
// หน้านี้มีโควตาเป็นปุ่มเดียว
//
// KINGKONG555 (รอบเขียวนีออนป่า-ทองมงกุฎ 2026-10-09, brand-spec §2):
// เขียวมะนาวสว่าง #8ce023 · เขียวสด #5cc211 · เขียวกลาง #2f8c07 · เขียวลึก #1a5c04 ·
// ทองมงกุฎ #f2c230 · ทองสว่าง #ffe066 · ทองเข้ม #a87a08 · ตัวอักษรรอง #bde397 ·
// เนื้อความ #e9f7d6 · หมึกบนพื้นสว่าง #06220a · ผิวการ์ดยก #14380a
// ปุ่มนี้เป็น PRIMARY เดียวกับ /ทางเข้า: ถมทองไล่เฉด #ffe066 → #f2c230 ขอบทองเข้ม
// #a87a08 บนหมึกเข้ม #06220a (13.0:1 บน #ffe066 · 10.1:1 บน #f2c230)
// ⚠️ ห้ามกลับด้าน: พื้นถมทองต้องใช้หมึกเข้มเสมอ ห้ามครีมหรือขาว เพราะตัวอักษรสว่าง
// บนทองลงไปต่ำกว่า 1.5:1 และห้ามไล่เฉดลงไปถึงทองเข้ม #a87a08 ใต้ตัวอักษร (4.4:1)
// — ส่วน /login เป็น SECONDARY ถมเขียว จึงไม่ซ้ำกัน ทองเข้ม เขียวกลาง และเขียวลึก
// ใช้ได้แค่เส้นขอบ ออรา และเงา — ออราใช้ rgba(242,194,48,α) เท่านั้นในไฟล์นี้
//
// Announcement หมุนมาเป็น Announcement3 ทั้งเว็บรอบนี้ และเรียกแบบ bare ทุกหน้า
// — ห้ามส่ง prop message จากหน้านี้
//
// แบรนด์นี้เป็นเว็บสล็อตธีมกอริลลาราชาป่า รอบนี้ไม่มีหมวดหวยเลย — รายการคำต้องห้าม
// เต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep เจอ false positive
// ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 1 บาท / 0.3% / 0.8% / 24 ชั่วโมง
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) หน้านี้ยาว 154
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} ฐานเว็บสล็อตหลัก กดปุ่มเดียวไปยังช่องทางหลัก รวมเกมสล็อตหลายรูปแบบไว้ในแพลตฟอร์มเดียว รองรับเดิมพันเริ่มต้น 1 บาทในเกมที่กำหนด`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} ฐานเว็บสล็อตหลัก เดิมพันเริ่มต้น 1 บาท เบทต่ำทุนน้อยก็เล่นได้`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#a87a08] bg-gradient-to-b from-[#ffe066] to-[#f2c230] px-6 py-4 text-2xl font-black tracking-wide text-[#06220a] shadow-[0_10px_30px_rgba(242,194,48,0.40)] transition-all duration-300 hover:scale-105 hover:border-[#06220a] hover:shadow-[0_15px_40px_rgba(242,194,48,0.60)]">
        <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ffe066]/60 to-transparent"></div>
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
