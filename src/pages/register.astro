---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// ⚠️ This page is NOT one of the "full custom HTML + own <style> block"
// standalone pages SKILL.md Phase 4.5 warns about — it renders through
// MainLayout + ContentBox like every other sub-page, so it has no
// .brand-identity string and no raw-hex <style> block of its own. The only
// brand colours here are the Tailwind arbitrary values on the button below.
// Do not "restore" a <style> block; the font link and the <html> colour come
// from MainLayout.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change (CtaRedirect.astro
// itself belongs to the orchestrator — ห้ามแก้ไฟล์นั้นจากหน้านี้)
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page (no `robots` prop = indexable), which means
// verify-build holds its description to the same 150–160 character window as
// every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) **ไม่มีส่วน SUB-PAGES** → title/description
// ของหน้านี้เขียนเอง และพูดได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 14: ควรตรวจสอบคุณสมบัติ
// ผู้สมัคร ข้อกำหนดด้านอายุ กฎหมายที่เกี่ยวข้อง และนโยบายความเป็นส่วนตัวให้ครบถ้วน ·
// บรรทัด 16: ตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้องและอ่านข้อกำหนดการเปิดบัญชี ·
// บรรทัด 18: ไม่ควรเปิดเผยรหัสผ่านและรหัส OTP ให้ใครทราบ)
// ⚠️ บรีฟรอบนี้ **มีหัวข้อขั้นตอนสมัครสมาชิกด้วยมือถือ 3 ขั้นตอนจริง แต่เป็นของ
// index.astro** (หัวข้อ H2 ที่ 6 ในเช็กลิสต์ brand-spec §4) **ไม่ใช่ของหน้านี้** —
// หน้านี้มีโควตาเป็น **ปุ่มเดียว** ห้ามแตกเป็นหัวข้อหรือรายการขั้นตอนบนหน้า
//
// ⚠️ น้ำเสียงของบรีฟรอบนี้คือ "โฆษณาและกำกับในประโยคเดียวกัน" ไม่ใช่การันตี
// คลังคำที่ใช้ได้รอบนี้อยู่ใน .claude/brand-spec-zane96.md §5 (ไม่พิมพ์ซ้ำ
// ที่นี่ และ **ไม่พิมพ์คำของแบรนด์เก่าซ้ำที่นี่** เพื่อไม่ให้ sweep ของรอบถัดไป
// เจอ false positive ในคอมเมนต์ของไฟล์นี้เอง)
// ตัวเลขที่อ้างได้รอบนี้มีแค่ 1 บาท · 0.3% · 0.8% · 3 ขั้นตอน · 24ชม. — ห้ามแต่ง
// ใบอนุญาต จำนวนเกม จำนวนค่าย ค่า RTP เป็นตัวเลข ปีก่อตั้ง จำนวนสมาชิก หรือ
// ค่าร้อยละเต็มจำนวน
// 🚨🚨 **บรีฟรอบนี้ไม่พูดถึงธนาคาร วอลเลท หรือการฝากถอนเลยแม้แต่คำเดียว** —
// ห้ามเขียนถึงรายการฝากถอนหรือชื่อวอลเล็ตใดๆ บนหน้านี้ (ชื่อวอลเล็ตของแบรนด์
// เก่าคือคำที่พลาดง่ายที่สุด — รายการเต็มใน brand-spec §5)
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตรอบนี้อยู่ใน .claude/brand-spec-zane96.md §2 — **เนื้อหาสว่าง โครมเข้ม**
// (ทิศเดียวกับรอบก่อน แต่คนละตระกูลสีทั้งชุด)
// bg.json = {"mode":"color","color":"#f8e6f9"} = **ไลแลคอมชมพูจาง**
// (รอบก่อนเป็นขาวอมชมพูที่จางกว่านี้ — ค่ามาจากไฟล์ ห้ามเดาว่าเท่าเดิม และห้าม
// "แก้" การ์ดให้มืดตามโครม)
// การ์ด ContentBox จึงเป็นผิว #ffffff บนหมึก #241046 (= BRAND_TEXT, 16.8:1)
// ปุ่มนี้เป็น **หลัก (primary)** ของพาเลต: ไล่เฉดไวโอเลต→แมเจนต้า
// #5411c4 -> #8e14b8 -> #c2178b ขอบ #5411c4 บนหมึก **ขาว #ffffff**
// (9.3 / 7.2 / 5.6:1 ต่อ stop — ค่าที่ตรวจคอนทราสต์มาแล้ว ห้ามแก้เอง)
// ส่วน /login เป็น **รอง (secondary)**: ไล่เฉดขาว #ffffff -> #ece0fb บนหมึก
// อินดิโกม่วง #241046 จึงไม่ซ้ำกัน
// 🚨🚨 **ห้ามลากสต็อปของปุ่มนี้ขึ้นไปถึง #f23bb4 #bb6dff หรือ #7aa7ff** — ขาวบน
// สามค่านั้นเหลือ 2.6 / 2.0 / 2.0:1 สามค่านั้นสงวนไว้เป็นขอบ/ออรา/พื้นถมบนผิวสว่าง
// · แผ่นไฮไลต์ด้านบนปุ่มจึงจำกัดที่ white/10 (stop บนยังผ่าน AA) **ห้ามเพิ่ม
// ความทึบของแผ่นนี้**
// 🚨🚨 **#f8e6f9 #f6edfe #ece0fb #dcc6f4 #f23bb4 #bb6dff #7aa7ff ห้ามถือตัวอักษร
// บนผิวสว่างเอง** เป็นพื้นถม/ขอบ/ออราเท่านั้น และ #9a6fd0 เป็น **เส้น/ขอบ**
// เท่านั้น · ที่ถือตัวอักษรได้บนผิวสว่างชุดนี้คือ #241046 (16.8:1) · #6b4a86
// (7.1:1) · #5411c4 (9.3:1) · #7a1bd6 (7.1:1) · #2b3fd9 (7.5:1) · #c2178b
// (คู่กับขาว 5.6:1)
// ⚠️⚠️ **#190b3d #271257 #100626 #5b2f9e #f3e8ff #c0a6e8 เป็นค่าของผิวโครมเข้ม
// เท่านั้น ห้ามหลุดเข้ามาในไฟล์นี้**
// ⚠️⚠️ **วัสดุของรอบนี้คือฉากสตูดิโอนีออนขาว-ไลแลค** อ่านจากอาร์ตเวิร์กตรงๆ:
// โลโก้เป็นเวิร์ดมาร์กสามมิติผิวโครเมียมล้วน ไม่มีมาสคอต "ZANE" ไล่ฟ้า→ม่วง
// คู่กับ "96" แมเจนต้า ตัดขอบขาวหนา มีประกายดาวสี่แฉก
// ⚠️⚠️ **ตู้สล็อต 777 ผิวแก้วม่วง ชิปคาสิโนแมเจนต้า เชอร์รี่ชมพู เพชรม่วง
// ชุดเมทัลลิกโฮโลแกรม และสีผิวนักแสดงเป็นวัตถุในภาพ ไม่ใช่สี UI** — พื้นเพจมาจาก
// bg.json เท่านั้น
// ⚠️ ปุ่มของ Navfoot อยู่บนแถบโครม **ผิวเข้ม** คนละโซนกับปุ่มบนการ์ดสว่างนี้
// **ห้ามลอกคลาสของ Navfoot มาวางบนการ์ด**
// ออราในไฟล์นี้ใช้ rgba(84,17,196,α) · rgba(242,59,180,α) เท่านั้น
//
// ⚠️⚠️ กับดักรอบนี้คือ **ไล่เฉดฟ้า→ม่วง→แมเจนต้าของอาร์ตเวิร์กคร่อมสามตระกูลที่
// เคยเป็นฮิวนำของแบรนด์ก่อนๆ พร้อมกัน** "มีม่วง/ชมพู/ฟ้าอยู่แล้ว" จึงไม่พิสูจน์ว่า
// เป็นค่าของรอบนี้ ให้เทียบเป็น **"ค่า" ทีละหลัก** กับตารางใน brand-spec §2
// ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive
// **ผิว/หมึกของรอบนี้คือ #f8e6f9 / #ffffff / #f6edfe / #ece0fb / #dcc6f4 /
// #9a6fd0 / #241046 / #6b4a86 / #5411c4 / #7a1bd6 / #2b3fd9 / #c2178b /
// #8e14b8 / #f23bb4 / #bb6dff / #7aa7ff เท่านั้น** (และโครมเข้ม #190b3d /
// #271257 / #100626 / #5b2f9e / #f3e8ff / #c0a6e8 ซึ่งอยู่ในไฟล์โครม ไม่ใช่ไฟล์นี้)
// รอบนี้ **ไม่มีแดง ไม่มีทอง/เหลือง/ส้ม ไม่มีครีม/เบจ ไม่มีโรสโกลด์ ไม่มีเทาเงิน
// และไม่มีเขียวแบรนด์** เลยสักเฉด · ปุ่ม LINE (#00B900) อยู่บน /about-us กับ
// /contact-us ไม่ใช่หน้านี้
//
// Announcement หมุนมาเป็นตัวเลข 2 ของตระกูล ทั้งเว็บรอบนี้ (brand-spec §3 — รอบก่อน
// ใช้ตัวเลข 5 จึงหมุนออก · เขียนชื่อไฟล์แบบไม่มีเครื่องหมายคำพูดโดยตั้งใจ เพราะ
// tools/gen-tw-sources.mjs นับ literal ที่มีเครื่องหมายคำพูดว่าเป็นการ import จริง
// คอมเมนต์จึงทำให้ variant เก่าหลุดเข้า Tailwind scan แล้วสีของแบรนด์ก่อนขึ้น
// stylesheet) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้
// ไว้แล้ว จึงเรียกแบบ bare — **ห้ามส่ง prop message**
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) สตริงนี้ยาว 157
// ด้วยชื่อแบรนด์ 6 อักขระของรอบนี้ ส่วนที่ไม่ใช่ชื่อแบรนด์ยาว 151 → รับชื่อแบรนด์
// ได้ 1–9 อักขระ ถ้ารอบหน้าชื่อยาวกว่านั้นต้องแก้ข้อความ ไม่ใช่ปล่อยผ่าน
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} เว็บสล็อตลิขสิทธิ์แท้ กดปุ่มเดียวไปยังขั้นตอนลงทะเบียน ควรตรวจสอบคุณสมบัติผู้สมัคร ข้อกำหนดด้านอายุ และนโยบายความเป็นส่วนตัวให้ครบถ้วน`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/hx8w";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} เว็บสล็อตลิขสิทธิ์แท้ไม่ผ่านเอเย่นต์`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#5411c4] bg-gradient-to-b from-[#5411c4] via-[#8e14b8] to-[#c2178b] px-6 py-4 text-2xl font-black tracking-wide text-white shadow-[0_10px_30px_rgba(84,17,196,0.35)] transition-all duration-300 hover:scale-105 hover:border-[#f23bb4] hover:shadow-[0_15px_40px_rgba(242,59,180,0.45)]">
        <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-white/10 to-transparent"></span>
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
