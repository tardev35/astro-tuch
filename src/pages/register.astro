---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — this page is indexed and must not
// describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// This is the PRIMARY action of the pair on the SAGAME66 palette, so it wears
// the full gold-gradient fill of the logo's "SA" (#ffe9a3 → #e8b93f → #96671a)
// under near-black ink (#0d0903, the only reading that keeps contrast on gold);
// /login carries the same gold as an outline on the card surface instead. Two
// tiers, one fill each — the gold/chrome pairing the logo itself uses.
//
// Announcement รอบนี้หมุนมาใช้ Announcement5 ทั้งเว็บ — default message ของไฟล์นั้น
// ถูกตั้งเป็นคอปปี้ของแบรนด์นี้แล้ว และ index ก็เรียกแบบ bare จึงห้ามส่ง prop
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 152
const pageDescription = "สมัครสมาชิก SAGAME66 กดปุ่มเดียวเปิดบัญชีใหม่ได้ด้วยตัวเอง จากนั้นเข้าสู่ระบบเลือกบาคาร่า รูเล็ต และคาสิโนสดจากบัญชีเดียว รองรับทั้งมือถือและคอมพิวเตอร์";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก SAGAME66",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="สมัครสมาชิก SAGAME66 เปิดบัญชีใหม่ด้วยตัวเอง เล่นครบในบัญชีเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก SAGAME66" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก SAGAME66"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ffe9a3] bg-gradient-to-r from-[#ffe9a3] via-[#e8b93f] to-[#96671a] px-6 py-4 text-lg font-black text-[#0d0903] shadow-[0_10px_30px_rgba(232,185,63,0.50)] transition-all duration-300 hover:scale-105 hover:border-[#eef3f8] hover:shadow-[0_15px_40px_rgba(238,243,248,0.45)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
