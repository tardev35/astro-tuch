---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
//
// MIRACLE55 (รอบทอง + เงินโครเมียมบนดำ 2026-09-25): ปุ่มนี้เป็นตัว PRIMARY ของคู่
// จึงสวมไล่เฉดทองของแบรนด์เต็มใบ (#fee47b → #fcda65 → #8c5f14) บนตัวอักษรเกือบดำ
// #14100a เพราะตัวหนังสือบนพื้นทองต้องเป็นสีเข้มจึงจะอ่านออก ห้ามใช้ขาว ส่วน /login
// รับฝั่ง "RACLE" ของโลโก้ที่เป็นเงินขัดเงา — ขอบเงินโครเมียม #d2d3d4 บนผิวการ์ดยก
// #1b140b แทน สองลำดับ หนึ่งโลหะต่อหนึ่งปุ่ม ตามโลโก้ที่ MI กับ 55 เป็นทองและ RACLE
// เป็นเงิน ไม่ใช่ทองสองใบซึ่งจะอ่านเป็นแบรนด์ก่อนหน้าเปลี่ยนชื่อ
// ชุดทองล้วนของรอบก่อนออกครบแล้ว
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ — default message ของไฟล์
// นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ index ก็เรียกแบบ bare จึงห้ามส่ง prop
//
// MIRACLE55 เป็นแบรนด์คาสิโน — คำศัพท์เฉพาะหมวดของแบรนด์ก่อนหน้าห้ามหลงเหลือในหน้านี้
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 151
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = "สมัครสมาชิก MIRACLE55 กดปุ่มเดียวเปิดบัญชีใหม่ด้วยตัวเอง รองรับทั้งมือถือและคอมพิวเตอร์ จากนั้นเข้าสู่ระบบเลือกเกมคาสิโนสดและเกมโต๊ะจากหลายค่ายได้ทันที";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก MIRACLE55",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="สมัครสมาชิก MIRACLE55 เปิดบัญชีใหม่ด้วยตัวเอง เล่นได้จากบัญชีเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก MIRACLE55" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก MIRACLE55"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fee47b] bg-gradient-to-r from-[#fee47b] via-[#fcda65] to-[#8c5f14] px-6 py-4 text-lg font-black text-[#14100a] shadow-[0_10px_30px_rgba(252,218,101,0.50)] transition-all duration-300 hover:scale-105 hover:border-[#d2d3d4] hover:shadow-[0_15px_40px_rgba(210,211,212,0.28)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
