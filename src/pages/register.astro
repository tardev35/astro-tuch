---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// GOT777 (รอบทอง-แดง-ดำ 2026-09-29): ปุ่มนี้เป็นตัว PRIMARY ของคู่ จึงสวมไล่เฉด
// ทองประจำแบรนด์เต็มใบ (#ffe9a8 → #f5c518 → #96690f) บนตัวอักษรหมึกเข้ม #0a0503
// ซึ่งได้คอนทราสต์สูงสุดบนพื้นทอง — ตัวอักษรขาวบนทองตกคอนทราสต์ จึงห้ามใช้เด็ดขาด
// ส่วน /login รับแบบ outline — กรอบแดงรอง #d21622 บนผิวปุ่มรอง #241108 แทน
// สองลำดับ หนึ่งรูปแบบต่อหนึ่งปุ่ม ไม่ใช่ถมทองสองใบซึ่งจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม
// ชุดแดง-ทองของ LOTTOPLUS (#dc020e #ff2d38 #6b0207 #f3c623 #fde79a #8a6a0a #f0e2e2
// #fff4f4 #2a0d0f #3a1114 rgba(220,2,14,*) rgba(243,198,35,*) rgba(5,1,2,*))
// ออกครบแล้ว
//
// Announcement หมุนมาเป็น Announcement3 ทั้งเว็บรอบนี้ — default message ของไฟล์
// นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ index ก็เรียกแบบ bare
//
// GOT777 เป็นเว็บเกมสล็อตออนไลน์ ไม่ใช่เว็บหวย — บรีฟระบุการสมัครผ่านระบบออนไลน์บน
// มือถือได้เอง (กรอกข้อมูลที่จำเป็น → ยืนยันข้อมูลตามขั้นตอน → Login เพื่อเลือก
// เกมสล็อต ตรวจสอบโปรโมชั่นและช่องทางจัดการเครดิต) โดยไม่ต้องสมัครหลายบัญชี
// คำศัพท์ตระกูลหวยของแบรนด์ก่อน (หวย โพย แทงหวย ส่งโพย งวด รอบออกรางวัล เลขเด็ด
// อัตราจ่าย 2 ตัว 3 ตัว รัฐบาลไทย ลาวพัฒนา ฮานอย หวยหุ้น) ห้ามหลงเหลือ และห้าม
// เพิ่มชื่อธนาคาร ยอดฝากขั้นต่ำ ชื่อค่ายเกม ตัวเลข RTP หรือเลขใบอนุญาต
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 156
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = "หน้าสมัครสมาชิก GOT777 กดปุ่มเดียวเปิดบัญชีด้วยตัวเองผ่านหน้าเว็บบนมือถือ แล้วเข้าสู่ระบบเลือกเกมสล็อตตามค่าย ตรวจสอบโปรโมชั่นและเครดิตจากบัญชีเดียวได้ทันที";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก GOT777",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="สมัครสมาชิก GOT777 เปิดบัญชีเองผ่านเว็บ เข้าเล่นเกมสล็อตไม่ต้องลงแอป" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก GOT777" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก GOT777"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ffe9a8]/70 bg-gradient-to-r from-[#ffe9a8] via-[#f5c518] to-[#96690f] px-6 py-4 text-lg font-black text-[#0a0503] shadow-[0_10px_30px_rgba(245,197,24,0.45)] transition-all duration-300 hover:scale-105 hover:border-[#fff6dd] hover:shadow-[0_15px_40px_rgba(245,197,24,0.35)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
