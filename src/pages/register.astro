---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect. The title and
// description below were rewritten this round for exactly that reason.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// หวยเฮง789 (รอบแดงนำ-ทองรอง 2026-10-01 กลับขั้วจากรอบก่อนที่เป็นทองนำ):
// ปุ่มนี้เป็นตัว PRIMARY ของคู่ จึงสวมไล่เฉดทองประจำแบรนด์เต็มใบ
// (#ffefc2 → #f4bc5d → #d99a10) บนตัวอักษรหมึกเข้ม #1c0606 ซึ่งได้ 7.0:1 ที่ปลาย
// เข้มสุดของไล่เฉด — ห้ามให้ไล่เฉดจบเข้มกว่า #d99a10 และ #a8690c (3.8:1) ใช้ได้
// เฉพาะขอบ/เส้นคั่น ห้ามเป็นพื้นหลังของตัวอักษร
// ส่วน /login รับแบบ outline — กรอบแดงลึก #ab0204 บนผิวการ์ด #2b0909 แทน
// สองลำดับ หนึ่งรูปแบบต่อหนึ่งปุ่ม ไม่ใช่ถมทองสองใบซึ่งจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม
// ห้ามหมึกเข้มบนแดงแบรนด์ #dc2224 (3.4:1) พื้นแดงรับตัวอักษรขาวเท่านั้น
// ชุดทองนำของ หวยเฮง24 (#e0a52a #fdea83 #fbdc64 #bd7c13 #2a0606 #1a0505 #f6e6cf
// #e6c98f #8b0302 #c01616 #5a0202 #3d0808 #2e0707 rgba(224,165,42,*)
// rgba(251,220,100,*) rgba(253,234,131,*) rgba(192,22,22,*) rgba(20,3,3,*))
// ออกครบแล้ว
//
// Announcement หมุนมาเป็น Announcement2 ทั้งเว็บรอบนี้ (รอบก่อนเป็น Announcement5)
// — default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ index ก็เรียกแบบ bare
//
// หวยเฮง789 เป็นเว็บแทงหวยออนไลน์ ไม่ใช่บอลและไม่ใช่สล็อต — บรีฟระบุการสมัครผ่านมือถือ
// ได้เองด้วย 3 ขั้นตอน (เข้าหน้าสมัครและกรอกข้อมูลที่ระบบกำหนด → ยืนยันข้อมูลและ
// Login เข้าบัญชีสมาชิก → เลือกประเภทหวย รอบ และตัวเลขที่ต้องการ พร้อมตรวจสอบอัตรา
// จ่ายก่อนส่งโพย) แล้วใช้บัญชีเดียวติดตามหวยรัฐบาลไทย หวยฮานอย หวยลาว และหวยหุ้น
// ต่างประเทศ พร้อมตรวจสอบโพย ประวัติรายการ และผลของแต่ละรอบ
// คำศัพท์ของแบรนด์ก่อนหน้า (สล็อต ฟรีสปิน ตัวคูณ ค่ายเกม RTP แตกง่าย เว็บตรง บอล
// ค่าน้ำ อัตราต่อรอง ลีก บิลสเต็ป แฮนดิแคป คาสิโน บาคาร่า ไพ่ เกมยิงปลา) ห้ามหลงเหลือ
// และห้ามเพิ่มชื่อธนาคาร ยอดฝากขั้นต่ำ ชื่อผู้ให้บริการจริง หรือเลขใบอนุญาต
// บรีฟรอบนี้ไม่ได้พูดเรื่องฝากถอนวอลเลท/ธนาคาร จึงห้ามยกของรอบก่อนมาใช้ซ้ำ
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 155
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = "หน้าสมัครสมาชิก หวยเฮง789 กดปุ่มเดียวเปิดบัญชีผ่านมือถือ แล้วเข้าสู่ระบบเลือกประเภทหวย รอบ และตัวเลขที่ต้องการ พร้อมตรวจสอบอัตราจ่ายก่อนส่งโพยจากบัญชีเดียว";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก หวยเฮง789",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="สมัครสมาชิก หวยเฮง789 เปิดบัญชีเองผ่านเว็บ เริ่มแทงหวยไม่ต้องลงแอป" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก หวยเฮง789" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก หวยเฮง789"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#a8690c]/70 bg-gradient-to-r from-[#ffefc2] via-[#f4bc5d] to-[#d99a10] px-6 py-4 text-lg font-black text-[#1c0606] shadow-[0_10px_30px_rgba(244,188,93,0.45)] transition-all duration-300 hover:scale-105 hover:border-[#ffefc2] hover:shadow-[0_15px_40px_rgba(244,188,93,0.35)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
