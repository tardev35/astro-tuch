---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect. The title and
// description below are written for exactly that reason.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// หวยดีใจ (รอบแดงแบรนด์ + เงินโครเมียม บนดำอมแดง 2026-10-04, brand-spec §2 —
// แดง #dc0409 มาจาก vivid ของ logo.webp ที่คำว่า "ดีใจ" เป็นแดงเมทัลลิก ส่วนเงิน
// โครเมียม #eef0f4 / #c3c7d1 มาจากคำว่า "หวย" ในโลโก้เดียวกัน ทอง #f3c54e เหลือ
// เป็น accent รองจากมงกุฎเหนือโลโก้เท่านั้น รอบก่อนคู่หลักเป็นแดง/ทอง รอบนี้จึง
// เปลี่ยนแกนที่สองจากทองเป็นเงิน ห้ามใช้ทองเป็นพื้นปุ่มอีก):
// ปุ่มนี้เป็นตัว PRIMARY ของคู่ จึงถม **แดงแบรนด์** เต็มใบ
// (#e8161c → #dc0409 → #8e0206) ขอบแดงดำ #4b0205 บนตัวอักษร **ขาว** —
// กฎคอนทราสต์: แดงที่สว่างที่สุดที่ยังผ่าน AA บนตัวอักษรขาวคือ #e8161c จึงเป็น
// สต็อปแรกของไล่เฉด และห้ามใช้แดงสว่าง #f5363d เป็นพื้นปุ่มที่มีข้อความ
// (ใช้ได้เฉพาะขอบตอน hover ออรา และเรืองแสง)
// ส่วน /login ถมผิวการ์ดยก #211016 ในกรอบเงินโครเมียม #c3c7d1/50 บนตัวอักษร #edeaf0
// สองลำดับ หนึ่งรูปแบบต่อหนึ่งปุ่ม ไม่ใช่ถมแดงสองใบ ซึ่งจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม
// — และคู่แดง/เงินนี้คือสองโทนที่อยู่บนโลโก้จริง ตรงกับคู่ปุ่มของ NavbarStyle8 และ
// FooterPremium ที่ orchestrator รีธีมไว้แล้ว
// ชุดแดง+ทองของแบรนด์ก่อน (#d20a0a #f5c33b #ffd45e #a9761a #f7e2d6 #170707
// #0a0303 #230d0d #1a0303 rgba(210,10,10,*) rgba(245,195,59,*) rgba(255,212,94,*))
// ออกครบแล้ว
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ (รอบก่อนเป็น
// Announcement3) — default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ
// index ก็เรียกแบบ bare จึงห้ามส่ง prop message
//
// หวยดีใจ เป็น **เว็บรับแทงหวยล้วน** ไม่ใช่คาสิโน บรีฟบรรทัด 16–17 ระบุการสมัครผ่าน
// มือถือได้เองด้วย 3 ขั้นตอน (เปิดหน้าสมัครและกรอกข้อมูลตามที่ระบบกำหนด → ยืนยัน
// ข้อมูลและ Login เข้าบัญชีสมาชิก → เลือกประเภทหวย รอบ และเลขที่ต้องการ พร้อม
// ตรวจสอบอัตราจ่ายก่อนส่งโพย) แล้วใช้บัญชีเดียวติดตามรัฐบาลไทย หวยลาว หวยฮานอย
// หวยออมสิน หวย ธ.ก.ส. แนวทาง และผลหวยตามรายการที่เปิดให้บริการ
// ตัวเลขที่ใช้ได้มีแค่ 100 / 1,000 / 2 ตัว / 3 ตัว / 3 ขั้นตอน / 24 ชั่วโมง
// ห้ามแต่งตัวเลขอื่นขึ้นมาเอง และห้ามเอ่ยเวลาเปิด-ปิดรับของหวยรอบใดรอบหนึ่ง ชื่อ
// ธนาคาร ยอดฝากขั้นต่ำ จำนวนสมาชิก ปีก่อตั้ง หรือเลขใบอนุญาต ที่บรีฟไม่ได้ระบุ
// คำหมวดคาสิโน (สล็อต บาคาร่า คาสิโนสด ค่ายเกม RTP คืนยอดเสีย % แนะนำเพื่อน %)
// ห้ามหลงเหลือ
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 157
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} กดปุ่มเดียวเปิดบัญชีผ่านมือถือได้ใน 3 ขั้นตอน แล้ว Login เลือกประเภทหวยและรอบที่ต้องการ ตรวจอัตราจ่ายกับวงเงินก่อนส่งโพยจากบัญชีเดียว`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} เปิดบัญชีเองผ่านมือถือ 3 ขั้นตอน ส่งโพยได้เลย`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#4b0205] bg-gradient-to-r from-[#e8161c] via-[#dc0409] to-[#8e0206] px-6 py-4 text-lg font-black text-white shadow-[0_10px_30px_rgba(220,4,9,0.45)] transition-all duration-300 hover:scale-105 hover:border-[#f5363d] hover:shadow-[0_15px_40px_rgba(245,54,61,0.45)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
