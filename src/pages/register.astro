---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — this page is indexed and must not
// describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// This is the PRIMARY action of the pair, so it wears the solid red fill
// (#c4161c → #8f0505 → #540202) under gold-bright ink (#fced74) with a gold
// outline; /login carries the gold outline on the dark panel surface.
//
// Announcement รอบนี้หมุนมาใช้ AnnouncementPremium ทั้งเว็บ — default message
// ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ไม่ต้องส่ง prop
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char).
const pageDescription = "หน้าสมัครสมาชิก MHEEPOOH168 กดปุ่มเดียวเปิดบัญชีสมาชิกใหม่ เข้าเล่นบาคาร่า สล็อต หวย และบอลในระบบเดียว รองรับช่องทางธนาคารและวอลเลทที่กำหนดไว้ภายในเว็บไซต์";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก MHEEPOOH168",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก MHEEPOOH168 เปิดบัญชีใหม่ เข้าเล่นคาสิโนเกมครบในระบบเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก MHEEPOOH168" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก MHEEPOOH168"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fced74] bg-gradient-to-r from-[#c4161c] via-[#8f0505] to-[#540202] px-6 py-4 text-lg font-black text-[#fced74] shadow-[0_10px_30px_rgba(196,22,28,0.45)] transition-all duration-300 hover:scale-105 hover:border-[#fced74] hover:shadow-[0_15px_40px_rgba(252,237,116,0.5)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
