---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// LOTTOPLUS (รอบแดง-ทอง-ดำ 2026-09-29): ปุ่มนี้เป็นตัว PRIMARY ของคู่ จึงสวมไล่เฉด
// แดงประจำแบรนด์เต็มใบ (#ff2d38 → #dc020e → #6b0207) บนตัวอักษร "ขาว" ซึ่งได้
// คอนทราสต์ 5.17:1 บนแดงแบรนด์ — หมึกเข้ม #1a0203 บนแดงเหลือแค่ 3.85:1 จึงห้ามใช้
// บนพื้นแดงเด็ดขาด (หมึกเข้มสงวนไว้ให้พื้นทอง #f3c623 ซึ่งได้ 12.4:1)
// ส่วน /login รับแบบ outline — กรอบทองรอง #f3c623 บนผิวปุ่มรอง #2a0d0f แทน
// สองลำดับ หนึ่งรูปแบบต่อหนึ่งปุ่ม ไม่ใช่ถมแดงสองใบซึ่งจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม
// ชุดทอง-ดำของ WIN999 (#fcc403 #fdda04 #e0a800 #8a6502 #fff0a8 #e9e4d6 #fffbea
// #101010 #191712 #241f14 rgba(252,196,3,*) rgba(3,2,0,*)) และชุดแดงของ LOTTO24
// (#dc2626 #fc2b2c #b40102 #fbbf24 #fde68a rgba(220,38,38,*)) ออกครบแล้ว
//
// Announcement หมุนมาเป็น AnnouncementHuay ทั้งเว็บรอบนี้ — default message ของไฟล์
// นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ index ก็เรียกแบบ bare
//
// LOTTOPLUS เป็นเว็บหวยออนไลน์ ไม่ใช่คาสิโน — บรีฟระบุการสมัครผ่านหน้าเว็บไซต์บน
// มือถือได้เอง (กรอกข้อมูลตามที่ระบบกำหนด → ยืนยันบัญชี → Login เพื่อเลือกประเภทหวย
// แล้วตรวจสอบรอบหวย อัตราจ่าย โปรโมชั่น เครดิต และประวัติโพย) โดยไม่ต้องติดตั้งแอป
// คำศัพท์ตระกูลคาสิโนของแบรนด์ก่อน (คาสิโน บาคาร่า สล็อต เกมไพ่ ค่ายเกม RTP
// กีฬา/บอล) ห้ามหลงเหลือ และห้ามเพิ่มชื่อธนาคาร ยอดฝากขั้นต่ำ หรือเลขใบอนุญาต
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 155
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = "หน้าสมัครสมาชิก LOTTOPLUS กดปุ่มเดียวเปิดบัญชีด้วยตัวเองผ่านหน้าเว็บ แล้วเข้าสู่ระบบเลือกรอบหวย ส่งโพย และตรวจสอบอัตราจ่ายกับโปรโมชั่นจากบัญชีเดียวได้ทันที";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก LOTTOPLUS",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="สมัครสมาชิก LOTTOPLUS เปิดบัญชีเองผ่านเว็บ เข้าแทงหวยไม่ต้องลงแอป" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก LOTTOPLUS" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก LOTTOPLUS"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ff2d38]/70 bg-gradient-to-r from-[#ff2d38] via-[#dc020e] to-[#6b0207] px-6 py-4 text-lg font-black text-white shadow-[0_10px_30px_rgba(220,2,14,0.45)] transition-all duration-300 hover:scale-105 hover:border-[#ff2d38] hover:shadow-[0_15px_40px_rgba(220,2,14,0.35)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
