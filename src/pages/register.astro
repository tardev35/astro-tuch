---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change (CtaRedirect.astro
// itself belongs to the orchestrator — ห้ามแก้ไฟล์นั้นจากหน้านี้)
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page, which means verify-build holds its
// description to the same 150–160 character window as every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES — คอปปี้ของหน้านี้จึงพูด
// ได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 16: ควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการ
// ก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ·
// บรรทัด 4: ควรตรวจสอบชื่อบัญชีปลายทางและข้อมูลนิติบุคคลจากหลักฐานที่เชื่อถือได้ ·
// บรรทัด 8: ก่อนเข้าร่วมโปรโมชั่นควรอ่านประกาศล่าสุด)
// ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า หน้านี้มีโควตาเป็นปุ่มเดียว
// ⚠️ description ที่สืบทอดมาจากรอบก่อนอ้างเงื่อนไขก่อนสมัครสองข้อที่ **เป็นคำของ
// แบรนด์ขาออก ไม่ใช่ของบรีฟรอบนี้** (ดูรายการเต็มใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่)
// — ถอดออกแล้ว ห้ามเขียนกลับมา
//
// ⚠️ แกนของบรีฟรอบนี้คือ **เว็บสล็อตเซิร์ฟไทย "ระบบเล่นง่าย รองรับภาษาไทย
// ลิขสิทธิ์แท้จากอเมริกา ฝากถอนเข้าบริษัทตรง ไม่ผ่านม้า"** ไม่ใช่แกนของรอบก่อน
// และไม่ใช่เว็บลอตเตอรีแบบรอบก่อนหน้านั้น
// ศัพท์ของหมวดอื่นที่บรีฟไม่มีทุกคำจึงเป็นของค้างที่ห้ามหลุดกลับมา
// รายการคำเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไป
// เจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// คำที่ใช้ได้รอบนี้: สล็อต · เกมสล็อต · เกมสล็อตออนไลน์ · สล็อตนาซ่าเซิร์ฟไทย ·
// เซิร์ฟไทย · ระบบเล่นง่าย · รองรับภาษาไทย · ภาษาไทย · เมนู · กติกาเกม · ฟีเจอร์ ·
// รูปแบบการจ่ายรางวัล · ระดับการเดิมพัน · ลิขสิทธิ์แท้จากอเมริกา · ผู้พัฒนาเกม ·
// ประเทศที่จดทะเบียน · หลักฐานการอนุญาต · ฝากถอนเข้าบริษัทตรง · ไม่ผ่านม้า ·
// บัญชีม้า · บัญชีแอบอ้าง · ชื่อบัญชีปลายทาง · ข้อมูลนิติบุคคล ·
// หลักฐานที่เชื่อถือได้ · โปรโมชั่น · สิทธิพิเศษ · คืนยอดเสีย 0.3% ·
// แนะนำเพื่อน 0.8% · กดรับได้ไม่จำกัด · เครดิต · เงื่อนไขการใช้โบนัส · ธนาคาร ·
// ทรูมันนี่ · ยอดขั้นต่ำ · ข้อกำหนดการถอนเงิน · แอดมิน · เจ้าหน้าที่ · 24ชม. ·
// ช่องทางติดต่อ · เว็บไซต์ทางการ · ประกาศล่าสุด · หลักฐาน · ธุรกรรม · รหัสผ่าน ·
// รหัส OTP · สมัครสมาชิก · เข้าสู่ระบบ · ฝากถอน
// ⚠️⚠️ **คำคู่ของแบรนด์เก่าที่ต่อท้ายชื่อ route /ทดลองเล่น ด้วย ฟรี / โหมด~
// ไม่ใช่คำของบรีฟรอบนี้** (คำเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่)
// ⚠️ **สองหน้าหมวดลอตเตอรีอยู่ใน src/pages-disabled/ รอบนี้**
// ห้ามลิงก์ไปสองเส้นทางนั้น route ไม่มีอยู่จริง build จะแดง
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกม ชื่อธนาคาร ชื่อวอลเล็ต หน่วยงานกำกับ หรือ
// ใบอนุญาตแม้แต่รายเดียว** (พูดถึง "ธนาคารและทรูมันนี่" แบบรวมๆ เท่านั้น)
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 24ชม.
// **ไม่มีวลีจำนวนขั้นตอน ไม่มีจำนวนเกม ไม่มีเปอร์เซ็นต์เต็ม และไม่มีอัตราคืนเป็นตัวเลข**
// ห้ามแต่งใบอนุญาต ตัวเลขการเงิน หรือจำนวนสมาชิก — บรีฟรอบนี้ไม่มีหัวข้อขั้นตอน
// การสมัครเลย จึงไม่มีอะไรให้ยกมาเขียนซ้ำที่หน้านี้ตั้งแต่ต้น
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตต์รอบนี้อยู่ใน brand-spec §2
// ⚠️⚠️ **รอบนี้กลับทิศจากรอบก่อน 180 องศา — เป็น "ธีมมืด" การ์ดผิวเข้ม หมึกสว่าง**
// bg.json = {"mode":"color","color":"#0d1017"} = **ถ่านเกือบดำอมน้ำเงิน**
// (รอบก่อนเป็น dbe6ff = ฟ้าเพอริวิงเคิลอ่อน — ค่ามาจากไฟล์ ห้ามเดาว่าเท่าเดิม)
// การ์ด ContentBox จึงเป็นผิว #1b2434 บนหมึกสว่าง #e6edf8 (= BRAND_TEXT)
// ปุ่มนี้เป็น **หลัก (primary)**: พื้นไล่เฉดอุลตรามารีน #1d4fd8 -> #143aa0
// ขอบ #143aa0 บนหมึก **ขาว** #ffffff (6.6 / 9.8:1 — ผ่านทั้งสอง stop)
// ส่วน /login เป็น **เน้น (accent)**: พื้นถม #1fd8f0 บนหมึก #0d1017 จึงไม่ซ้ำกัน
// ⚠️ ไล่เฉดต้อง **เริ่มที่ #1d4fd8 แล้วเข้มลงถึง #143aa0** ห้ามลากปลายเข้มเลยค่านั้น
// และห้ามสลับเป็นพื้นถม #1fd8f0 เพราะหมึกขาวบนค่านั้นเหลือ 1.7:1
// 🚨🚨 **#1d4fd8 / #143aa0 ห้ามถือตัวอักษรเอง** (2.4:1 บนการ์ด) เป็นพื้น/ขอบ/ออรา
// เท่านั้น · **เส้น #33455f ห้ามถือตัวอักษร**
// ⚠️⚠️ **วัสดุที่สองของรอบนี้คือน้ำเงินอุลตรามารีน ไม่ใช่ทองอวกาศหรือเทาโครเมียม**
// — ชื่อแบรนด์รอบนี้ซ้ำกับลูกค้าเก่าที่ใช้ธีมทองอวกาศ + เงินโครเมียม (brand-spec §0)
// **ชุดสีนั้นห้ามกลับเข้ามาเด็ดขาด** ถึงแม้เลข 168 ในโลโก้รอบนี้จะเป็นทองอำพันจริง
// (เป็นวัตถุในภาพ ไม่ใช่สี UI) และแรมป์เทาเงินเป็นของแบรนด์เก่าเช่นกัน
// ⚠️ ปุ่มของ Navfoot อยู่บนแถบโครมคนละโซนกับปุ่มบนการ์ดนี้
// **ห้ามลอกคลาสของ Navfoot มาวางบนการ์ด**
// ออราในไฟล์นี้ใช้ rgba(29,79,216,α) · rgba(31,216,240,α) · rgba(143,217,236,α)
// เท่านั้น
//
// ⚠️⚠️ กับดักรอบนี้คือ **ฟ้าเคยผ่านรีโปนี้มาแล้วหกเจ้า และรอบก่อนทันทีก็ฟ้านำ**
// "มีฟ้าอยู่แล้ว" จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้ ให้เทียบเป็น "ค่า" ทีละหลักกับ
// ตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่า
// เจอ false positive
// รอบนี้ **ไม่มีทอง/เหลือง ไม่มีแดง ไม่มีเขียว (ยกเว้น LINE green ที่หน้าอื่น)
// ไม่มีชมพู ไม่มีม่วง ไม่มีส้ม ไม่มีน้ำตาล ไม่มีโรสโกลด์ และไม่มีแรมป์เทาเงิน**
//
// Announcement หมุนมาเป็น AnnouncementCyber ทั้งเว็บรอบนี้ (brand-spec §3 — รอบก่อน
// ใช้ Announcement5 จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์
// นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare — ห้ามส่ง prop message
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) ส่วนที่ไม่ใช่ชื่อแบรนด์
// ยาว 146 อักขระ จึงรับชื่อแบรนด์ได้ตั้งแต่ 4 ถึง 14 ตัวอักษร — นอกช่วงนั้นต้องแก้
// ข้อความ ไม่ใช่ปล่อยผ่าน รอบนี้ชื่อยาว 8 ตัวอักษร รวมเป็น 154
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} กดปุ่มเดียวไปยังขั้นตอนลงทะเบียน ควรตรวจสอบช่องทางจากเว็บไซต์ทางการ ตั้งรหัสผ่านที่คาดเดายาก และไม่เปิดเผยรหัส OTP ให้ผู้อื่นทราบ`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} ลงทะเบียนเพื่อเข้าใช้งานเกมสล็อตและโปรโมชั่นสมาชิก`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#143aa0] bg-gradient-to-b from-[#1d4fd8] to-[#143aa0] px-6 py-4 text-2xl font-black tracking-wide text-[#ffffff] shadow-[0_10px_30px_rgba(29,79,216,0.4)] transition-all duration-300 hover:scale-105 hover:border-[#1fd8f0] hover:shadow-[0_15px_40px_rgba(29,79,216,0.55)]">
        <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#8fd9ec]/25 to-transparent"></span>
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
