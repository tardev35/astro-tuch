---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement4.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change (CtaRedirect.astro
// itself belongs to the orchestrator — ห้ามแก้ไฟล์นั้นจากหน้านี้)
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page, which means verify-build holds its
// description to the same 150–160 character window as every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES — คอปปี้ของหน้านี้จึงพูด
// ได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 8: ก่อนเข้าร่วมควรอ่านข้อกำหนดล่าสุดให้ครบถ้วน ·
// บรรทัด 16: สอบถามเกี่ยวกับการสมัครสมาชิก การเข้าสู่ระบบ รายการฝากถอน และ
// รายละเอียดโปรโมชั่น โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น)
// ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า หน้านี้มีโควตาเป็นปุ่มเดียว
//
// ⚠️ แกนของบรีฟรอบนี้คือ **ระบบดูแลการเงิน — ช่องทางฝากถอนผ่านธนาคารชั้นนำและ
// วอลเลท พร้อมความปลอดภัยของบัญชีผู้รับเงิน (ไม่ผ่านบัญชีม้า)** ซึ่งคนละแกนกับ
// รอบก่อน (หมวดการเรียนการสอน) ศัพท์หมวดนั้นทุกคำจึงเป็นของค้างที่ห้าม
// หลุดกลับมา รายการคำเต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep
// ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// คำที่ใช้ได้รอบนี้: ระบบดูแลการเงิน · ฝากถอน · ทุกช่องทาง · ธนาคารชั้นนำ · วอลเลท ·
// ปลอดภัยไม่ผ่านม้า · บัญชีแอบอ้าง · ชื่อบัญชีปลายทาง · ธุรกรรม · ยอดขั้นต่ำ ·
// สมัครสมาชิก · ลงทะเบียน · รหัสผ่าน · รหัส OTP · เจ้าหน้าที่ · 24ชม. ·
// เว็บไซต์ทางการ · ประกาศล่าสุด · ข้อกำหนดล่าสุด
// พร้อมโปรโมชั่นสองรายการคือ **คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%**
// แบรนด์ก่อนหน้าขายตัวเองด้วยวลีที่บรีฟรอบนี้ไม่มีเลยสักคำ จึงต้องเขียนใหม่จากบรีฟ
// ไม่ใช่ find-and-replace ทับของเดิม
// ⚠️ บรีฟรอบนี้ระบุเกมไว้ **ห้าประเภท** (สล็อต ไฮโล ยิงปลา หวย บอล) ไม่ใช่หก
// ห้ามเติมประเภทที่หกของรอบก่อนกลับเข้ามาเอง
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกมหรือชื่อธนาคารแม้แต่รายเดียว** ห้ามเขียนลงหน้า
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 24ชม. ห้ามแต่งใบอนุญาต
// หน่วยงานกำกับ ค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีใดๆ · วลีขายของที่ห้ามใช้
// อยู่ใน brand-spec §6 และห้ามมีวลี "N ขั้นตอน" (รอบนี้บรีฟไม่มี)
// หัวข้อฝากถอนกับช่องทางติดต่อแอดมินของบรีฟเป็นของ index.astro ห้ามยกมาเขียนซ้ำ
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตต์รอบนี้อยู่ใน .claude/brand-spec-meesub168.md §2
// ⚠️⚠️ **รอบนี้เป็นแบรนด์ "ธีมสว่าง" ตัวแรกของรีโปนี้ — ทิศกลับด้านจากทุกรอบก่อน**
// bg.json = {"mode":"color","color":"#f0ccf5"} = ชมพูอมม่วง **สว่าง** ไม่ใช่ดำ
// การ์ด ContentBox จึงเป็นผิว **ขาว** #ffffff บนหมึกพลัม #4a0d35 (= BRAND_TEXT)
// ปุ่มนี้เป็น PRIMARY: ถม **ชมพูบานเย็น→โรสเข้ม** #dd1b74 → #a4186b ขอบ #a4186b
// บนตัวอักษร **ขาว** (4.67:1 ที่ปลายสว่าง · 7.17:1 ที่ปลายเข้ม ผ่าน AA ทั้งคู่)
// ขั้วของปุ่มนี้ตรงกับปุ่ม สมัครสมาชิก ของ Navfoot ที่ขึ้นทุกหน้าบนมือถือ จึงอ่าน
// เป็นปุ่มเดียวกันทั้งเว็บ — ส่วน /login เป็น SECONDARY พื้นพลัมเข้มขอบชมพูบน
// ตัวอักษรชมพูอ่อน จึงไม่ซ้ำกัน
// ⚠️ ไล่เฉดต้อง **เริ่มที่ #dd1b74 แล้วเข้มลง** ห้ามไล่ขึ้นไปสว่างกว่านั้นใต้ตัวอักษร
// (ขาวบนชมพูที่สว่างกว่า #dd1b74 ตก AA ทันที — ขาวบน f5469f เหลือราว 3.6:1)
// ชั้นตกแต่งของปุ่มจึงเป็นชั้น **เข้มลง** ที่ขอบล่าง ไม่ใช่ sheen สว่างที่ขอบบน
// ⚠️⚠️ **#dd1b74 ห้ามถือตัวอักษร** — 4.67:1 บนผิวการ์ดขาวคือเฉียดฉิว และบนพื้นเข้ม
// #4a0d35 เหลือ 3.2:1 เป็น **พื้นถม / ขอบ / ออรา** เท่านั้น
// ออราในไฟล์นี้ใช้ rgba(221,27,116,α) และ rgba(164,24,107,α) เท่านั้น
//
// ⚠️ กับดักรอบนี้คือ **ชมพูเคยนำมาแล้วสามแบรนด์** (ถอนชัวร์168 fa63b9 ·
// มีโชค168 f5469f · มีเฮ168 ff8f9c) "มีชมพูอยู่แล้ว" จึงไม่พิสูจน์ว่าเป็นค่าของ
// รอบนี้ ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive
// รอบก่อนหน้าทันที (ดวงเศรษฐี168 ทองน้ำผึ้ง/แดงชาด บนดำ) กวาดออกครบแล้ว:
//   d9212a 8e1a16 f0c878 fff8d8 2a0608 4e2120 300605 150303
// รอบนี้ **ไม่มีทอง/เหลือง ไม่มีแดงชาด ไม่มีบรอนซ์ ไม่มีฟ้า/น้ำเงิน/ไซยาน
// ไม่มีเขียว ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์ และไม่มีส้มสด**
// (เฮกซ์ของแบรนด์เก่าเขียนแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep รอบหน้าสะดุด)
//
// Announcement หมุนมาเป็น Announcement4 ทั้งเว็บรอบนี้ (brand-spec §3 — รอบก่อนใช้
// Announcement5 จึงหมุนออก) orchestrator ตั้ง default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare — ห้ามส่ง prop message
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) หน้านี้ยาว 158
// ด้วยชื่อแบรนด์ 11 ตัวอักษรของรอบนี้
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} กดปุ่มเดียวไปยังขั้นตอนลงทะเบียน ควรอ่านข้อกำหนดเรื่องการฝากถอนและโปรโมชั่นให้ครบถ้วน และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้ผู้อื่น`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} ลงทะเบียนเพื่อใช้ระบบฝากถอนทุกช่องทาง`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#a4186b] bg-gradient-to-b from-[#dd1b74] to-[#a4186b] px-6 py-4 text-2xl font-black tracking-wide text-white shadow-[0_10px_30px_rgba(221,27,116,0.4)] transition-all duration-300 hover:scale-105 hover:border-[#4a0d35] hover:shadow-[0_15px_40px_rgba(221,27,116,0.55)]">
        <div aria-hidden="true" class="absolute inset-x-0 bottom-0 -z-10 h-1/2 bg-gradient-to-t from-[#a4186b]/60 to-transparent"></div>
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
