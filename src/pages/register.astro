---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect. The title and
// description below are written for exactly that reason.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// หวย365 (รอบแดงสด-ทอง-ดำ 2026-10-03, brand-spec §2 — แดงคือสีตัวตน ทองคือสีเน้น
// ดำคือพื้น มาจาก logo.webp ที่คำว่า หวย เป็นแดงสด #dc0203 และ 365 เป็นดำ):
// ปุ่มนี้เป็นตัว PRIMARY ของคู่ จึงสวมไล่เฉด **แดง** ประจำแบรนด์เต็มใบ
// (#f5282a → #dc0203 → #8c0402) ขอบทองลึก #c08a07 บนตัวอักษร **ขาว** —
// กฎคอนทราสต์ brand-spec §2: หมึกเข้ม #1a0303 บนแดงแบรนด์ได้แค่ 2.8:1 ตก พื้นแดง
// จึงต้องใช้หมึกขาวเสมอ (ขาวบน #dc0203 ≈ 5.1:1 ผ่าน) และหมึกทองอ่อนบนพื้นแดงก็ตก
// ส่วน /login ถือ "ทอง" ซึ่งเป็นแอ็กเซนต์รองของแบรนด์ (กรอบ #c08a07 + ตัวอักษร
// #ffc93c บนพื้นยกระดับ #3a0a0c) สองลำดับ หนึ่งรูปแบบต่อหนึ่งปุ่ม ไม่ใช่ถมแดงสองใบ
// ซึ่งจะอ่านเป็นปุ่มซ้ำกันสองปุ่มและทำให้ฮิวที่สองของแบรนด์หายไป
// ชุดทอง-เงินของ NATO168 (#edb543 #fde8a8 #a9761f #e6e6e6 #101010 #070707 #f4ead3
// #1a1203 #241a09 #17120a rgba(237,181,67,*) rgba(252,220,115,*) rgba(230,230,230,*)
// rgba(4,3,0,*)) ออกครบแล้ว
//
// Announcement หมุนมาเป็น AnnouncementHuay ทั้งเว็บรอบนี้ (รอบก่อนเป็น Announcement5)
// — default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ index ก็เรียกแบบ bare
// จึงห้ามส่ง prop message
//
// หวย365 เป็นเว็บแทงหวยออนไลน์ ไม่ใช่สล็อตและไม่ใช่บอล — บรีฟบรรทัด 15 ระบุการสมัคร
// ผ่านมือถือได้เองด้วย 3 ขั้นตอน (เข้าหน้าสมัครและกรอกข้อมูลตามที่ระบบกำหนด → ยืนยัน
// ข้อมูลและ Login เข้าบัญชี → เลือกประเภทหวย รอบ และตัวเลขที่ต้องการ พร้อมตรวจสอบ
// อัตราจ่ายก่อนส่งโพย) แล้วใช้บัญชีเดียวติดตามแนวทางหวย สถิติย้อนหลัง ผลหวย และ
// รายการที่เปิดรับในแต่ละวัน
// ตัวเลขที่ใช้ได้มีแค่ 2 ตัว จ่าย 100 บาท · 3 ตัว จ่าย 1,000 บาท · 3 ขั้นตอน ·
// 24 ชั่วโมง ห้ามแต่งตัวเลขอื่นขึ้นมาเอง
// คำศัพท์ของแบรนด์ก่อนหน้า (สล็อต พีจี PG ค่ายเกม ฟรีสปิน ตัวคูณ วงล้อ ปั่น โบนัสไทม์
// โบนัสทุกยูส ไม่มีล็อคยูส คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% RTP คาสิโนสด บาคาร่า บอล
// ค่าน้ำ ลีก) ห้ามหลงเหลือ และห้ามเพิ่มชื่อธนาคาร ยอดฝากขั้นต่ำ ชื่อผู้ให้บริการจริง
// หรือเลขใบอนุญาต — บรีฟรอบนี้ไม่ได้พูดเรื่องฝากถอน จึงห้ามยกของรอบก่อนมาใช้ซ้ำ
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 158
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} กดปุ่มเดียวเปิดบัญชีผ่านมือถือได้ใน 3 ขั้นตอน แล้ว Login เลือกประเภทหวย รอบ และตัวเลขที่ต้องการ พร้อมตรวจสอบอัตราจ่ายก่อนส่งโพยทุกครั้ง`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} เปิดบัญชีเองผ่านเว็บ 3 ขั้นตอน เริ่มส่งโพยได้เลย`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#c08a07] bg-gradient-to-r from-[#f5282a] via-[#dc0203] to-[#8c0402] px-6 py-4 text-lg font-black text-white shadow-[0_10px_30px_rgba(220,2,3,0.45)] transition-all duration-300 hover:scale-105 hover:border-[#ffc93c] hover:shadow-[0_15px_40px_rgba(245,40,42,0.45)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
