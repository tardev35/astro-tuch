---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char).
const pageDescription =
  "หน้าสมัครสมาชิก UFA99 สำหรับผู้ที่ต้องการเปิดบัญชีใหม่ กรอกข้อมูลตามระบบกำหนด แล้วเข้าเล่นสล็อต บาคาร่า คาสิโนสด รูเล็ต และเสือมังกร ได้ตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก UFA99 เปิดบัญชีใหม่",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก UFA99 เปิดบัญชีใหม่ เริ่มเดิมพันออนไลน์ 24 ชั่วโมง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก UFA99" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก UFA99"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fce48c]/70 bg-gradient-to-r from-[#e6e8ec] via-[#fce48c] to-[#ebc36b] px-6 py-4 text-lg font-black text-[#150e05] shadow-[0_10px_30px_rgba(235,195,107,0.25)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(235,195,107,0.35)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
