---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — this page is indexed and must not
// describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// This is the PRIMARY action of the pair on the หวยพยัคฆ์ palette, so it wears
// the full gold-gradient fill (#fdf5a4 → #fadb6c → #ab6d13) under the palette's
// text-on-gold ink (#030b1c); /login carries the same gold as an outline on the
// navy card surface instead. One accent, two brightnesses.
//
// Announcement รอบนี้หมุนมาใช้ AnnouncementHuay ทั้งเว็บ — default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ไม่ต้องส่ง prop
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 160
const pageDescription = "หน้าสมัครสมาชิก หวยพยัคฆ์ กดปุ่มเดียวเปิดบัญชีใหม่ได้ด้วยตัวเอง กรอกข้อมูล ตรวจสอบความถูกต้อง แล้วยืนยันบัญชี จากนั้นเข้าสู่ระบบเลือกรายการหวยที่เปิดรับได้ทันที";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก หวยพยัคฆ์",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก หวยพยัคฆ์ เปิดบัญชีใหม่ใน 3 ขั้นตอน แทงหวยครบทุกประเภท" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก หวยพยัคฆ์" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก หวยพยัคฆ์"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fdf5a4] bg-gradient-to-r from-[#fdf5a4] via-[#fadb6c] to-[#ab6d13] px-6 py-4 text-lg font-black text-[#030b1c] shadow-[0_10px_30px_rgba(250,219,108,0.45)] transition-all duration-300 hover:scale-105 hover:border-[#fdf5a4] hover:shadow-[0_15px_40px_rgba(253,245,164,0.5)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
