---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// This is the PRIMARY action of the pair, so it wears the solid logo-red
// gradient (#e2353a → #c21e22 → #7d1114) under cream text (#ffe9ea); /login
// carries the outline. Pale rose (#ff9a9d) stays a text-highlight colour on
// this brand and does not fill a button.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 156.
const pageDescription = "หน้าสมัครสมาชิก LOTTOKA กดปุ่มเดียวเปิดบัญชีใหม่ด้วยตัวเอง 3 ขั้นตอน แทงหวยได้ครบทุกแนว ไม่มีขั้นต่ำในการฝาก รองรับทุกธนาคารและ TrueMoney Wallet ตลอด 24 ชม.";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก LOTTOKA",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก LOTTOKA เปิดบัญชีใหม่ด้วยตัวเอง 3 ขั้นตอน แทงหวยครบทุกแนว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก LOTTOKA" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก LOTTOKA"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#e2353a]/70 bg-gradient-to-r from-[#e2353a] via-[#c21e22] to-[#7d1114] px-6 py-4 text-lg font-black text-[#ffe9ea] shadow-[0_10px_30px_rgba(194,30,34,0.28)] transition-all duration-300 hover:scale-105 hover:border-[#ff9a9d] hover:shadow-[0_15px_40px_rgba(194,30,34,0.48)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
