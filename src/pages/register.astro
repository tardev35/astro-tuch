---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect. The title and
// description below are written for exactly that reason.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// UOK365 (รอบทองเมทัลลิก-เงินโครเมียมบนดำ 2026-10-07, brand-spec §2 — ทองแบรนด์
// #c8912f ปรับสว่างจาก vivid อันดับ 1 ของ logo.webp (#a46b25) ที่ตัวอักษร UOK
// เป็นทอง ส่วนเลข 365 เป็นเงินโครเมียม #d8dbe0 ซึ่งเป็น "เมทัลแอกเซนต์"
// ไม่ใช่สีแบรนด์ตัวที่สอง · bg.json ของดรอปนี้เป็น #000000 และงานศิลป์ทั้งชุด
// เป็นโถงเกือบดำที่ส่องด้วยแสงทอง จึงไม่มีฮิวที่สองมาแยกลำดับปุ่ม):
// ปุ่มนี้เป็นตัว PRIMARY ของคู่ จึงถม **ทอง** เต็มใบ (#f5d98a → #c8912f 55% →
// #a46b25) ขอบทองลึก #6d4412 บนหมึก **#191005** — กฎคอนทราสต์ของสเปก: พื้นทองถม
// ห้ามใช้ตัวอักษรขาวหรือครีมเด็ดขาด (หมึกสว่างบน #c8912f เหลือ ~2.6:1 ตก AA)
// และไล่เฉดหยุดสต็อปเข้มสุดที่ #a46b25 ไม่ลงไปถึง #6d4412 เพราะ #191005 บน
// #6d4412 เหลือ ~2.4:1 — #6d4412 จึงใช้เป็นขอบ ไม่ใช่พื้นของตัวอักษร
// ส่วน /login ถมผิวยกเข้ม #19100a → #070504 ขอบ #c8912f/55 บนหมึก #f5d98a
// สองลำดับ หนึ่งรูปแบบต่อหนึ่งปุ่ม ไม่ใช่ถมสีเดียวกันสองใบ ซึ่งจะอ่านเป็นปุ่มซ้ำกัน
// ตรงกับคู่ปุ่มของ NavbarPremium และ FooterPremium ที่ orchestrator รีธีมไว้แล้ว
// ชุดเขียวนีออนของ BOOM369 (#42fb5a #8dffa0 #04ab3a #036b26 #03150a #0b231b
// #07170f #041109 #cfe9d7 #dadcdc #f3c44a rgba(66,251,90,*) rgba(141,255,160,*)
// rgba(4,171,58,*) rgba(3,107,38,*)) ออกครบแล้ว ห้ามนำกลับมา
//
// Announcement หมุนมาเป็น AnnouncementPremium ทั้งเว็บรอบนี้ (รอบก่อนเป็น
// AnnouncementCyber) — default message ของไฟล์นั้นเป็นคอปปี้ของ UOK365 แล้ว และ
// index ก็เรียกแบบ bare จึงห้ามส่ง prop message
//
// UOK365 เป็น **เว็บสล็อต** ไม่ใช่เว็บหวย — คำหมวดหวย (หวย ส่งโพย โพย เลขเด็ด
// แนวทาง อัตราจ่าย งวด ผลรางวัล ตรวจหวย) ห้ามหลงเหลือ และคำของแบรนด์ก่อน
// (ไฮคลาส VIP ส่งตรงจากเว็บแม่ ค่ายเกมพรีเมียม ไม่ผ่านบัญชีม้า) ก็ห้ามเช่นกัน
// บรีฟบรรทัด 15 กับ 16 ระบุว่าสมัครผ่านมือถือได้ใน 3 ขั้นตอน และหลังเปิดบัญชีใช้
// บัญชีเดียวค้นหาเกมสล็อต ดูเครดิต โปรโมชั่น และประวัติรายการได้เอง
// ตัวเลขที่ใช้ได้มีแค่ของบรีฟเอง: 0.3% / 0.8% / 100% / 24 ชั่วโมง / 3 ขั้นตอน
// ห้ามแต่งชื่อค่ายเกม ชื่อธนาคาร ยอดฝากขั้นต่ำ จำนวนสมาชิก ปีก่อตั้ง หรือ
// เลขใบอนุญาต ที่บรีฟไม่ได้ระบุ
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). UOK365 (6) ให้ 154
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} กดปุ่มเดียวเปิดบัญชีเพื่อเข้าเล่นสล็อตเบทต่ำจากค่ายตรงในบัญชีเดียว พร้อมตรวจสอบเครดิต โปรโมชั่น และประวัติรายการได้ด้วยตัวเองทุกรอบ`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} เปิดบัญชีเองผ่านมือถือ 3 ขั้นตอน เล่นสล็อตเบทต่ำได้ทันที`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#6d4412] bg-gradient-to-b from-[#f5d98a] via-[#c8912f] via-55% to-[#a46b25] px-6 py-4 text-lg font-black text-[#191005] shadow-[0_0_14px_rgba(200,145,47,0.55)] transition-all duration-300 hover:scale-105 hover:border-[#f5d98a] hover:shadow-[0_0_32px_rgba(200,145,47,0.70)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
