---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — this page is indexed and must not
// describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// This is the PRIMARY action of the pair on the THE88 palette, so it wears the
// full gold-gradient fill of the logo's "88" (#ffe7a6 → #f2c14e → #8a6524)
// under the palette's near-black red ink (#1c0504); /login carries the other
// brand hue, red, as an outline on the dark surface instead. Two hues, one
// per tier — the same pairing the logo itself uses.
//
// Announcement รอบนี้หมุนมาใช้ Announcement2 ทั้งเว็บ — default message ของไฟล์นั้น
// เป็นคอปปี้ของแบรนด์นี้อยู่แล้วและ index ก็เรียกแบบ bare จึงห้ามส่ง prop
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 155
const pageDescription = "สมัครสมาชิก THE88 กดปุ่มเดียวเปิดบัญชีใหม่ได้ด้วยตัวเอง จากนั้นเข้าสู่ระบบเลือกเล่นบาคาร่า สล็อต หวย บอล และไฮโลได้จากบัญชีเดียว รองรับมือถือและคอมพิวเตอร์";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก THE88",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="สมัครสมาชิก THE88 เปิดบัญชีใหม่ด้วยตัวเอง เล่นได้ครบในบัญชีเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก THE88" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก THE88"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ffe7a6] bg-gradient-to-r from-[#ffe7a6] via-[#f2c14e] to-[#8a6524] px-6 py-4 text-lg font-black text-[#1c0504] shadow-[0_10px_30px_rgba(242,193,78,0.50)] transition-all duration-300 hover:scale-105 hover:border-[#ffe7a6] hover:shadow-[0_15px_40px_rgba(255,231,166,0.45)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
