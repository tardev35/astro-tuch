---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect. The title and
// description below are written for exactly that reason.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// GUCCI168 (รอบตรุษจีน 2026-10-08, brand-spec §2 — ชุด **สามสี: แดงนำ
// เขียวมรกตรอง ทองเป็นโลหะคั่น** บนผิวเกือบดำ · โลโก้เป็นเทพเจ้าโชคลาภสวมหมวก
// เขียวคาดแดง ตัวอักษร GUCCI ขาวเงินขอบเขียวมรกตทับเลข 168 แดงขอบทอง ส่วน
// bg.json เป็นไล่เฉดแดงเลือดหมู → ทองเข้ม จึงมีฮิวที่สองจริงมาแยกลำดับปุ่มได้):
// ปุ่มนี้เป็นตัว PRIMARY ของคู่ จึงถม **แดงแบรนด์** เต็มใบ (#e0201f → #c41115
// 55% → #7a0505) ขอบทองแบรนด์ #d9a521 บนหมึก **ขาว** — สเปกตรวจคอนทราสต์แล้ว:
// ขาวบน #c41115 = 6.1:1 และขาวบน #e0201f = 4.8:1 พอดี AA จึงห้ามดันปลายไล่เฉด
// ให้สว่างเกิน #e0201f และห้ามใช้หมึกเข้มบนแดง (#1d0b08 บน #c41115 เหลือ ~2.8:1)
// พื้น **ทอง/แชมเปญถมเต็มใบต้องใช้หมึกเข้ม #1d0b08 เสมอ ห้ามครีมหรือขาว** รอบนี้
// จึงไม่เอาทองมาถมเป็นพื้นปุ่มเลย ใช้ทองเป็นขอบและออร่าโลหะคั่นเท่านั้น
// ส่วน /login ถมผิวเกือบดำอมเขียว #0b231b → #041109 ขอบเขียวมรกต #2bbf63/55
// บนหมึกทองอ่อน #ffdf91 สองลำดับ หนึ่งรูปแบบต่อหนึ่งปุ่ม ไม่ใช่ถมสีเดียวกันสองใบ
// ซึ่งจะอ่านเป็นปุ่มซ้ำกัน และเข้าชุดกับคู่ปุ่มของ /ทางเข้า ที่ให้ สมัครสมาชิก = แดง,
// เข้าสู่ระบบ = เขียว
// ชุดทองเมทัลลิก-เงินโครเมียมของ UOK365 ถูกแทนครบแล้ว ทั้งคลาส Tailwind, raw hex
// และ rgba() glow (ค่าเดิมอยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep
// หาสีแบรนด์เก่าเจอ false positive)
//
// Announcement หมุนมาเป็น Announcement3 ทั้งเว็บรอบนี้ (รอบก่อนเป็น
// AnnouncementPremium ซึ่งหน้านี้ยังค้างอยู่ตัวเดียวในเว็บ — สลับแล้ว) default
// message ของ Announcement3 เป็นคอปปี้ของแบรนด์ปัจจุบันแล้ว และ index ก็เรียกแบบ
// bare จึงห้ามส่ง prop message จากหน้านี้ AnnouncementPremium คงไว้บนดิสก์เป็น
// inventory ของรอบถัดไป ห้ามลบ
//
// แบรนด์นี้เป็น **เว็บคาสิโนไลฟ์ 24 ชม. + สล็อต + บอล** ไม่ใช่เว็บสล็อตเบทต่ำและ
// ไม่ใช่เว็บหวย — คำของแบรนด์ก่อน (เบทต่ำ ทุนน้อย ค่ายตรง ถูกลิขสิทธิ์ ไฮคลาส VIP
// ส่งตรงจากเว็บแม่) และคำหมวดหวย (หวย โพย เลขเด็ด แนวทาง งวด อัตราจ่าย ตรวจหวย)
// ห้ามหลงเหลือ
// บรีฟบรรทัด 15 ระบุว่าสมัครผ่านมือถือทำได้ใน 3 ขั้นตอน แล้วหลังเปิดบัญชีเลือก
// หมวดเกม ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการผ่านบัญชีเดียวได้
// ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 0.3% / 0.8% / 24 ชั่วโมง / 3 ขั้นตอน
// ห้ามแต่งชื่อค่ายเกม ชื่อธนาคาร เลขใบอนุญาต หน่วยงานกำกับ ค่า RTP ยอดฝากขั้นต่ำ
// จำนวนสมาชิก หรือปีก่อตั้ง — หน้านี้มีโควตาเป็นปุ่มเดียวเท่านั้น
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 159
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} กดปุ่มเดียวเปิดบัญชีใหม่ใน 3 ขั้นตอน เพื่อเข้าเล่นคาสิโนไลฟ์ บาคาร่า รูเล็ต ไฮโล สล็อต และบอล พร้อมดูเครดิต โปรโมชั่น และประวัติรายการ`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME} คาสิโนไลฟ์`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} เปิดบัญชีเองผ่านมือถือ 3 ขั้นตอน เข้าเล่นคาสิโนไลฟ์ได้ทันที`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME} คาสิโนไลฟ์`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#d9a521] bg-gradient-to-b from-[#e0201f] via-[#c41115] via-55% to-[#7a0505] px-6 py-4 text-lg font-black text-white shadow-[0_0_14px_rgba(196,17,21,0.50)] transition-all duration-300 hover:scale-105 hover:border-[#ffdf91] hover:shadow-[0_0_32px_rgba(196,17,21,0.70)]">
        <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ffdf91]/30 to-transparent"></div>
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
