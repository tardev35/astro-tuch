---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char).
const pageDescription =
  "หน้าสมัครสมาชิก JAIDEE928 สล็อตใจดีเว็บแท้ สำหรับผู้ที่ต้องการเปิดบัญชีใหม่ กรอกข้อมูลตามที่ระบบกำหนด รับโบนัสและคอมมิชชั่น แล้วเข้าปั่นสล็อตค่ายดังได้ทันที";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก JAIDEE928 เปิดบัญชีใหม่",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก JAIDEE928 เปิดบัญชีใหม่ เริ่มปั่นสล็อตค่ายดังได้ทันที 24 ชั่วโมง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก JAIDEE928" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก JAIDEE928"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#c47bff]/70 bg-gradient-to-r from-[#e8e6ee] via-[#c47bff] to-[#9d16f1] px-6 py-4 text-lg font-black text-[#150726] shadow-[0_10px_30px_rgba(157,22,241,0.25)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(157,22,241,0.35)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
