---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char).
const pageDescription =
  "หน้าสมัครสมาชิก AKA99 สล็อตเว็บตรงค่ายใหญ่ สำหรับผู้ที่ต้องการเปิดบัญชีใหม่ รับโบนัสคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8% ตามเงื่อนไข ฝากถอนออโต้ 24 ชม.";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก AKA99 เปิดบัญชีใหม่",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก AKA99 สล็อตเว็บตรงค่ายใหญ่ เปิดบัญชีใหม่ รับโบนัสได้ทุกวัน 24 ชั่วโมง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก AKA99" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก AKA99"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#4aa3ff]/70 bg-gradient-to-r from-[#4aa3ff] via-[#0b6cf0] to-[#0a2a6b] px-6 py-4 text-lg font-black text-[#02060f] shadow-[0_10px_30px_rgba(11,108,240,0.25)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(195,206,217,0.30)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
