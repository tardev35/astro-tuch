---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect. The title and
// description below are written for exactly that reason.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// 1SS365 (รอบทอง-ดำ 2026-10-03, brand-spec §"New palette" — ทองคือสีตัวตน
// เงินโครมคือฮิวที่สอง ดำคือพื้น มาจาก logo.webp ที่ vivid เป็นทอง #edbb23):
// ปุ่มนี้เป็นตัว PRIMARY ของคู่ จึงสวมไล่เฉด **ทอง** ประจำแบรนด์เต็มใบ
// (#f7d458 → #edbb23 → #c9930f) ขอบทองลึก #a87708 บนตัวอักษร **ดำ #050505** —
// กฎคอนทราสต์: หมึกขาวบนทองแบรนด์ได้แค่ 1.9:1 ตก พื้นทองจึงต้องใช้หมึกเข้มเสมอ
// (ดำบน #edbb23 ≈ 11:1 ผ่าน) และหมึกทองอ่อนบนพื้นทองก็ตก
// ส่วน /login เป็นแบบ outline (กรอบ #a87708 + ตัวอักษร #edbb23 บนพื้นยกระดับ
// #1a1710) สองลำดับ หนึ่งรูปแบบต่อหนึ่งปุ่ม ไม่ใช่ถมทองสองใบ ซึ่งจะอ่านเป็นปุ่มซ้ำกัน
// สองปุ่ม
// ชุดแดง-ทองของ หวย365 (#dc0203 #f5282a #8c0402 #ffc93c #ffeab0 #c08a07 #240406
// #3a0a0c #f6e7e0 rgba(220,2,3,*) rgba(245,40,42,*) rgba(255,201,60,*)
// rgba(8,1,1,*)) ออกครบแล้ว
//
// Announcement หมุนมาเป็น AnnouncementPremium ทั้งเว็บรอบนี้ (รอบก่อนเป็น
// AnnouncementHuay) — default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ
// index ก็เรียกแบบ bare จึงห้ามส่ง prop message
//
// 1SS365 เป็นสล็อตออนไลน์เว็บตรงต่างประเทศ ไม่ผ่านเอเย่นต์ — ไม่ใช่เว็บหวยและไม่ใช่บอล
// บรีฟบรรทัด 15 ระบุการสมัครผ่านมือถือได้เองด้วย 3 ขั้นตอน (เข้าหน้าสมัครและกรอกข้อมูล
// ที่ระบบกำหนด → ยืนยันข้อมูลและ Login เข้าบัญชีสมาชิก → เลือกค่ายและเกมสล็อต
// ที่ต้องการ พร้อมตรวจสอบช่วงเดิมพันและโปรโมชั่นก่อนเริ่มเล่น) แล้วใช้บัญชีเดียวค้นหา
// เกมสล็อต ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการ
// ตัวเลขที่ใช้ได้มีแค่ 0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง · 100%
// ห้ามแต่งตัวเลขอื่นขึ้นมาเอง
// คำศัพท์หวยของแบรนด์ก่อนหน้า (หวย แทงหวย ส่งโพย โพย เลือกเลข 2 ตัว 3 ตัว อัตราจ่าย
// งวด รัฐบาลไทย ฮานอย ลาวพัฒนา หวยหุ้น ตรวจหวย แนวทางหวย) ห้ามหลงเหลือ และห้ามเพิ่ม
// ชื่อธนาคาร ยอดฝากขั้นต่ำ ชื่อผู้ให้บริการจริง หรือเลขใบอนุญาต ที่บรีฟไม่ได้ระบุ
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 157
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} กดปุ่มเดียวเปิดบัญชีผ่านมือถือได้ใน 3 ขั้นตอน แล้ว Login เลือกค่ายและเกมสล็อต พร้อมตรวจสอบช่วงเดิมพันและโปรโมชั่นก่อนเริ่มเล่นทุกครั้ง`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} เปิดบัญชีเองผ่านมือถือ 3 ขั้นตอน เริ่มเล่นได้เลย`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#a87708] bg-gradient-to-r from-[#f7d458] via-[#edbb23] to-[#c9930f] px-6 py-4 text-lg font-black text-[#050505] shadow-[0_10px_30px_rgba(237,187,35,0.45)] transition-all duration-300 hover:scale-105 hover:border-[#ffeeb4] hover:shadow-[0_15px_40px_rgba(247,212,88,0.45)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
