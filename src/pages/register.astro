---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change (CtaRedirect.astro
// itself belongs to the orchestrator — ห้ามแก้ไฟล์นั้นจากหน้านี้)
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page, which means verify-build holds its
// description to the same 150–160 character window as every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES — คอปปี้ของหน้านี้จึงพูด
// ได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 14: ก่อนรับสิทธิ์ควรอ่านเงื่อนไขล่าสุดและตรวจสอบว่า
// โปรโมชั่นใช้ร่วมกันได้หรือไม่ · บรรทัด 22: สอบถามเกี่ยวกับรอบหวย อัตราจ่าย
// การตรวจสอบบิล และรายการฝากถอน โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น)
// ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า หน้านี้มีโควตาเป็นปุ่มเดียว
//
// ⚠️ แกนของบรีฟรอบนี้คือ **เว็บหวยออนไลน์ที่รวมหวยหลายประเภทไว้ที่เดียว** —
// หวยรัฐบาลไทย หวยลาวพัฒนา หวยฮานอย และหวยหุ้นต่างประเทศ
// ศัพท์หมวดสล็อต/คาสิโน/บอลทุกคำจึงเป็นของค้างที่ห้ามหลุดกลับมา
// รายการคำเต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไป
// เจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// คำที่ใช้ได้รอบนี้: หวยออนไลน์ · หวยรัฐบาลไทย · หวยลาวพัฒนา · หวยฮานอย ·
// หวยหุ้นต่างประเทศ · ช่องทางเล่นหวย · ประเภทหวย · รอบปิดรับ · อัตราจ่าย · บิลหวย ·
// ฝากถอน · ธนาคาร · วอลเลท · ยอดขั้นต่ำ · ชื่อบัญชีปลายทาง · บัญชีแอบอ้าง ·
// สมัครสมาชิก · ลงทะเบียน · รหัสผ่าน · รหัส OTP · เจ้าหน้าที่ · แอดมิน · 24ชม. ·
// เว็บไซต์ทางการ · ประกาศล่าสุด
// พร้อมโปรโมชั่นสองรายการคือ **คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%**
// แบรนด์ก่อนหน้าขายตัวเองด้วยวลีที่บรีฟรอบนี้ไม่มีเลยสักคำ จึงต้องเขียนใหม่จากบรีฟ
// ไม่ใช่ find-and-replace ทับของเดิม
// ⚠️ **รอบนี้เป็นเว็บหวยล้วน** ห้ามเอ่ยถึงสล็อต ไฮโล ยิงปลา บอล บาคาร่า คาสิโนสด
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกม ชื่อธนาคาร หรือใบอนุญาตแม้แต่รายเดียว**
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 2 ตัว 100 · 3 ตัว 1,000 · 0.3% · 0.8% · 24ชม.
// ห้ามแต่งใบอนุญาต หน่วยงานกำกับ ค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีใดๆ ·
// วลีขายของที่ห้ามใช้อยู่ใน brand-spec §6 และห้ามมีวลี "N ขั้นตอน" (รอบนี้บรีฟไม่มี)
// หัวข้อฝากถอนกับช่องทางติดต่อแอดมินของบรีฟเป็นของ index.astro ห้ามยกมาเขียนซ้ำ
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตต์รอบนี้อยู่ใน .claude/brand-spec-ruaythear168vip.md §2
// ⚠️⚠️ **รอบนี้เป็นแบรนด์ "ธีมสว่าง" รอบที่สามของรีโปนี้ — การ์ดสว่าง หมึกเข้ม**
// bg.json = {"mode":"color","color":"#ffdbdb"} = ชมพูกุหลาบ **สว่าง** ไม่ใช่ดำ
// การ์ด ContentBox จึงเป็นผิว **ขาว** #ffffff บนหมึกแดงเลือดหมู #4a0f0f
// (= BRAND_TEXT) → คลาสสีของแบรนด์ก่อน (เขียวมรกต/บรอนซ์มะกอก) กวาดออกครบแล้ว
// ปุ่มนี้เป็น PRIMARY: ถม **ทองโบราณ** #dcb95f → #c99a3f → #b8862b ขอบ #b8862b
// บนหมึก **#280b0b** (9.8 / 7.2 / 5.7:1 ผ่าน AA ทุก stop) — ทองใช้ได้ตรงนี้เพราะ
// หมึกวางอยู่ **บน** พื้นทอง ไม่ใช่ทองวางบนพื้นขาว
// ส่วน /login เป็น SECONDARY ถมแดง #c30303 → #8f0505 บนตัวอักษรขาว จึงไม่ซ้ำกัน
// ⚠️ ปุ่มของ Navfoot เป็น **โครม** (พื้นมารูนเข้ม/ทอง) คนละโซนกับปุ่มบนการ์ดนี้
// **ห้ามลอกคลาสของ Navfoot มาวางบนการ์ดสว่าง**
// ⚠️ ไล่เฉดต้อง **เริ่มที่ #dcb95f แล้วเข้มลงถึง #b8862b** ห้ามลากปลายเข้มเลยค่านั้น
// และ **ห้ามกลับด้านเป็นตัวอักษรขาวบนพื้นทอง** (ขาวบน #dcb95f เหลือ 1.9:1)
// ชั้นตกแต่งของปุ่มจึงเป็นชั้น **เข้มลง** ที่ขอบล่าง ไม่ใช่ sheen สว่างที่ขอบบน
// ⚠️⚠️ นอกจากพื้นถมปุ่มนี้ **ทองโบราณห้ามถือตัวอักษรบนผิวการ์ดขาว** (1.9-3.5:1)
// ⚠️⚠️ **แดงชาด #e81313 ห้ามถือตัวอักษรและห้ามเป็นพื้นของตัวอักษร** เป็น stop ของ
// ไล่เฉด/ออราเท่านั้น
// ออราในไฟล์นี้ใช้ rgba(184,134,43,α) · rgba(220,185,95,α) · rgba(143,5,5,α) ·
// rgba(74,15,15,α) เท่านั้น
//
// ⚠️ กับดักรอบนี้คือ **แดงนำมาแล้วมากกว่าฮิวอื่นใดในรีโปนี้ และทองก็เคยนำมาแล้ว
// เกือบทุกแบรนด์** "มีแดง/มีทองอยู่แล้ว" จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้ ให้เทียบเป็น
// "ค่า" ทีละหลักกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep
// หาสีของแบรนด์เก่าเจอ false positive
// รอบนี้ **ไม่มีเขียว ไม่มีชมพูบานเย็น ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง
// ไม่มีเงิน/โครเมียม และไม่มีโรสโกลด์**
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ (brand-spec §3 — รอบก่อนใช้
// AnnouncementHuay จึงหมุนออก เหลือไว้เฉพาะสองหน้าหมวดหวย) orchestrator ตั้ง
// default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare —
// ห้ามส่ง prop message
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) หน้านี้ยาว 158
// ด้วยชื่อแบรนด์ 9 ตัวอักษรของรอบนี้ (ส่วนที่ไม่ใช่ชื่อแบรนด์ยาว 149 จึงรับชื่อ
// ได้ตั้งแต่ 1 ถึง 11 ตัวอักษร — ยาวกว่านั้นต้องตัดข้อความ ไม่ใช่ปล่อยผ่าน)
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} กดปุ่มเดียวไปยังขั้นตอนลงทะเบียนสมาชิก ควรอ่านเงื่อนไขประเภทหวยและโปรโมชั่นให้ครบถ้วน และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} ลงทะเบียนเพื่อใช้ระบบแทงหวยและฝากถอน`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#b8862b] bg-gradient-to-b from-[#dcb95f] via-[#c99a3f] to-[#b8862b] px-6 py-4 text-2xl font-black tracking-wide text-[#280b0b] shadow-[0_10px_30px_rgba(184,134,43,0.45)] transition-all duration-300 hover:scale-105 hover:border-[#8f0505] hover:shadow-[0_15px_40px_rgba(184,134,43,0.6)]">
        <span aria-hidden="true" class="absolute inset-x-0 bottom-0 -z-10 h-1/2 bg-gradient-to-t from-[#b8862b]/60 to-transparent"></span>
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
