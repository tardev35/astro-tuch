---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect. The title and
// description below were rewritten this round for exactly that reason.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// BRAVO168 (รอบน้ำเงินรอยัล-ทอง-กรมท่า 2026-09-30): ปุ่มนี้เป็นตัว PRIMARY ของคู่
// จึงสวมไล่เฉดทองประจำแบรนด์เต็มใบ (#ffe39a → #f4cb69 → #c9922e) บนตัวอักษรหมึกเข้ม
// #0a1020 ซึ่งได้คอนทราสต์สูงสุดบนพื้นทอง — ตัวอักษรขาวบน #f4cb69 ตก AA จึงห้ามใช้
// ส่วน /login รับแบบ outline — กรอบน้ำเงินรอยัล #1558c4 บนผิวยก #072247 แทน
// สองลำดับ หนึ่งรูปแบบต่อหนึ่งปุ่ม ไม่ใช่ถมทองสองใบซึ่งจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม
// ชุดเขียวนีออนของ CK268 (#8bfc13 #c9ff8f #eaffd6 #12a008 #1a7a08 #d5e6cd
// #e8f0e6 #030703 #0f1b0e #052e16 #071007 rgba(139,252,19,*) rgba(30,193,13,*)
// rgba(3,7,3,*)) ออกครบแล้ว
//
// Announcement หมุนมาเป็น AnnouncementPremium ทั้งเว็บรอบนี้ (รอบก่อนเป็น
// Announcement5) — default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ index
// ก็เรียกแบบ bare
//
// BRAVO168 เป็นเว็บแทงบอล/พนันบอลออนไลน์ ไม่ใช่สล็อตและไม่ใช่หวย — บรีฟระบุการสมัคร
// ผ่านระบบออนไลน์บนมือถือได้เองด้วย 3 ขั้นตอน (เข้าหน้าสมัครและกรอกข้อมูลตามที่ระบบ
// กำหนด → ยืนยันข้อมูลและ Login เข้าบัญชีสมาชิก → เลือกลีก คู่แข่งขัน และรูปแบบเดิมพัน
// ที่ต้องการ พร้อมตรวจสอบราคาและรายละเอียดบิลก่อนยืนยัน) แล้วติดตามอัตราต่อรอง
// โปรโมชั่น และประวัติบิลจากบัญชีเดียว
// คำศัพท์ของสองแบรนด์ก่อน (สล็อต วงล้อ ฟรีสปิน ตัวคูณ ค่ายเกม RTP เกมแตก หวย
// เลขเด็ด ตรวจหวย แนวทาง ยี่กี บาคาร่า) ห้ามหลงเหลือ และห้ามเพิ่มชื่อธนาคาร
// ยอดฝากขั้นต่ำ ชื่อผู้ให้บริการจริง หรือเลขใบอนุญาต
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 159
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = "หน้าสมัครสมาชิก BRAVO168 กดปุ่มเดียวเปิดบัญชีด้วยตัวเองผ่านหน้าเว็บบนมือถือ แล้วเข้าสู่ระบบเลือกลีกและคู่แข่งขัน ตรวจสอบค่าน้ำและโปรโมชั่นจากบัญชีเดียวได้ทันที";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก BRAVO168",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="สมัครสมาชิก BRAVO168 เปิดบัญชีเองผ่านเว็บ เริ่มแทงบอลไม่ต้องลงแอป" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก BRAVO168" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก BRAVO168"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ffe39a]/70 bg-gradient-to-r from-[#ffe39a] via-[#f4cb69] to-[#c9922e] px-6 py-4 text-lg font-black text-[#0a1020] shadow-[0_10px_30px_rgba(244,203,105,0.45)] transition-all duration-300 hover:scale-105 hover:border-[#ffe39a] hover:shadow-[0_15px_40px_rgba(244,203,105,0.35)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
