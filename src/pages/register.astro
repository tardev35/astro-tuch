---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — this page is indexed and must not
// describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// This is the PRIMARY action of the pair, so it wears the solid gold gradient
// (#e2c87f → #c2a55c → #5c4418) under near-black ink (#050403); /login carries
// the deep-gold outline on the raised dark surface.
//
// Announcement รอบนี้หมุนมาใช้ Announcement5 ทั้งเว็บ — default message ของไฟล์นั้น
// เป็นคอปปี้ของ GODBET88 อยู่แล้ว จึงเรียกแบบ bare ไม่ต้องส่ง prop
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 160.
const pageDescription = "หน้าสมัครสมาชิก GODBET88 กดปุ่มเดียวเปิดยูสใหม่ด้วยระบบออโต้ 3 ขั้นตอน ไม่ถึง 1 นาที รองรับทุกธนาคารและ TrueMoney Wallet ฝากไม่มีขั้นต่ำ เริ่มเดิมพันเพียง 1 บาท";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก GODBET88",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก GODBET88 เปิดยูสใหม่ระบบออโต้ 3 ขั้นตอน เสร็จไม่ถึง 1 นาที" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก GODBET88" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก GODBET88"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#e2c87f] bg-gradient-to-r from-[#e2c87f] via-[#c2a55c] to-[#5c4418] px-6 py-4 text-lg font-black text-[#050403] shadow-[0_10px_30px_rgba(194,165,92,0.42)] transition-all duration-300 hover:scale-105 hover:border-[#f6e7b8] hover:shadow-[0_15px_40px_rgba(226,200,127,0.62)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
