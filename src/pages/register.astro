---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char).
const pageDescription =
  "หน้าสมัครสมาชิก JAIDEE928 คาสิโนใจดีเว็บแท้ สำหรับผู้ที่ต้องการเปิดบัญชีใหม่ กรอกข้อมูลตามที่ระบบกำหนด แล้วเข้าเล่นบาคาร่า รูเล็ต คาสิโนสด ได้ตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก JAIDEE928 เปิดบัญชีใหม่",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก JAIDEE928 เปิดบัญชีใหม่ เริ่มเล่นคาสิโนออนไลน์ 24 ชั่วโมง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก JAIDEE928" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก JAIDEE928"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#7db4ff]/70 bg-gradient-to-r from-[#e6e8ec] via-[#7db4ff] to-[#0e6efb] px-6 py-4 text-lg font-black text-[#040e22] shadow-[0_10px_30px_rgba(14,110,251,0.25)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(14,110,251,0.35)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
