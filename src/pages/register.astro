---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — this page is indexed and must not
// describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// This is the PRIMARY action of the pair on the HENG38 palette, so it wears
// the full gold-gradient fill (#fbeeb0 → #f3cf63 → #a5761a) under the palette's
// text-on-gold ink (#03140a); /login carries the same gold as an outline on the
// emerald card surface instead. One accent, two brightnesses.
//
// Announcement รอบนี้หมุนมาใช้ AnnouncementPremium ทั้งเว็บ — default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้อยู่แล้วและ index ก็เรียกแบบ bare จึงห้ามส่ง prop
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 158
const pageDescription = "หน้าสมัครสมาชิก HENG38 กดปุ่มเดียวเปิดบัญชีใหม่ได้ด้วยตัวเอง กรอกข้อมูล ตรวจสอบความถูกต้อง แล้วยืนยัน จากนั้นเข้าสู่ระบบเลือกค่ายและเกมสล็อตที่ต้องการได้ทันที";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก HENG38",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก HENG38 เปิดบัญชีใหม่ใน 3 ขั้นตอน เล่นสล็อตไม่มีขั้นต่ำ" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก HENG38" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก HENG38"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fbeeb0] bg-gradient-to-r from-[#fbeeb0] via-[#f3cf63] to-[#a5761a] px-6 py-4 text-lg font-black text-[#03140a] shadow-[0_10px_30px_rgba(243,207,99,0.45)] transition-all duration-300 hover:scale-105 hover:border-[#fbeeb0] hover:shadow-[0_15px_40px_rgba(251,238,176,0.5)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
