---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 151.
const pageDescription =
  "หน้าสมัครสมาชิก PREMSUK365 กดปุ่มเดียวเปิดยูสเซอร์ใหม่ด้วยตัวเอง เริ่มแทงหวยออนไลน์ รับเลขดัง เลขอั้น พร้อมรับสิทธิ์แนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก PREMSUK365 เปิดยูสเซอร์ใหม่",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก PREMSUK365 เปิดยูสเซอร์ใหม่ด้วยตัวเอง เริ่มแทงหวยออนไลน์ได้ทันที" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก PREMSUK365" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก PREMSUK365"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f7e8b4]/50 bg-gradient-to-r from-[#f7e8b4] via-[#e3c56a] to-[#8a6a26] px-6 py-4 text-lg font-black text-[#020c06] shadow-[0_10px_30px_rgba(227,197,106,0.25)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(227,197,106,0.45)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
