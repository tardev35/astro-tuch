---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 159.
const pageDescription =
  "หน้าสมัครสมาชิก FAH999 กดปุ่มเดียวเปิดยูสเซอร์ใหม่ด้วยตัวเอง เริ่มเล่นเกมสล็อตธีมเอเชียและเกมโบนัสได้ทันที พร้อมตรวจสอบสิทธิ์โปรโมชั่นและระบบฝากถอนในบัญชีเดียว";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก FAH999 เปิดยูสเซอร์ใหม่",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก FAH999 เปิดยูสเซอร์ใหม่ เริ่มเล่นเกมสล็อตได้ทุกวัน" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก FAH999" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก FAH999"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fb44b3]/70 bg-gradient-to-r from-[#fb44b3] via-[#c2249b] to-[#6b1fa8] px-6 py-4 text-lg font-black text-[#0d0114] shadow-[0_10px_30px_rgba(251,68,179,0.25)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(194,36,155,0.35)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
