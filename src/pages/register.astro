---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1×1, h2×0, h3×0. Never write an article here and never add an <h2>.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change.
//
// CtaRedirect.astro เป็น shared chrome ที่ orchestrator retheme ให้แล้วรอบนี้ —
// หน้านี้แค่ render มัน ห้ามแก้ไฟล์นั้นจากหน้านี้
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens. It is an indexed page now, which
// means verify-build holds its description to the same 150–160 character window
// as every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES และไม่ได้ให้ขั้นตอน
// สมัครเป็นข้อๆ ไว้เลย — คอปปี้ของหน้านี้จึงพูดได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 4:
// คลับ/ชุมชนคนเล่นสล็อต รวบรวมข้อมูลเกมจากค่ายต่างๆ กิจกรรมสมาชิก และโปรโมชั่น
// ไว้ในระบบเดียว · บรรทัด 9–13: คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%)
// ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า หน้านี้มีโควตาเป็นปุ่มเดียว
//
// SUPERSLOTCLUB (รอบแดงเสือโคร่ง-ทองถ่านไฟ 2026-10-09, brand-spec §2):
// แดงเสือโคร่ง #e8232a · แดงเรืองไฟ #ff5a46 · ทองถ่านไฟ #f2b705 · ทองสว่าง
// #ffd666 · ทองกลางเข้ม #c08a0b · ทองลึก #a8730a · ครีมอุ่น #f5cbb0 ·
// เนื้อความ #fbe8d5 · หมึกบนพื้นสว่าง #2b0a00 · ผิวการ์ดยก #3d1709 · ผิวกลาง #301105
// ปุ่มนี้เป็น PRIMARY เดียวกับ /ทางเข้า: ถมทองไล่เฉด #ffd666 → #f2b705 → #c08a0b
// ขอบทองลึก #a8730a บนหมึกเข้ม #2b0a00 (12.6:1 / 8.7:1 / 6.0:1 ตามลำดับสต็อป)
// ⚠️ ห้ามกลับด้าน: พื้นถมทองต้องใช้หมึกเข้มเสมอ ห้ามครีมหรือขาว และห้ามไล่เฉดลงไป
// ถึงทองลึก #a8730a ใต้ตัวอักษร (4.48:1 ตก) ปลายเข้มจึงเป็น #c08a0b
// — ส่วน /login เป็น SECONDARY ผิวการ์ด จึงไม่ซ้ำกัน · แดงแบรนด์ #e8232a ไม่เคย
// ถือตัวอักษร (3.5:1) ใช้ได้แค่เส้นขอบ ออรา และเงา — ออราใช้ rgba(242,183,5,α)
// เท่านั้นในไฟล์นี้
// ⚠️ ฮิวของรอบนี้เป็น "แดง" และแบรนด์ก่อนๆ หลายเจ้าก็แดง เจอแดงที่ไหนห้ามเหมาว่า
// เป็นของรอบนี้ ให้เทียบค่าเป็นตัวๆ กับตารางใน brand-spec §2
//
// Announcement หมุนมาเป็น Announcement2 ทั้งเว็บรอบนี้ และเรียกแบบ bare ทุกหน้า
// — ห้ามส่ง prop message จากหน้านี้
//
// แบรนด์นี้เป็นคลับคนเล่นสล็อต / สล็อตเว็บหลัก ล้วนๆ — รายการคำต้องห้ามเต็มอยู่ใน
// brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep เจอ false positive
// ⚠️ ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 0.3% / 0.8% / 24 ชั่วโมง — ตัวเลขพาดหัวของ
// แบรนด์ก่อน (ยอดเดิมพันขั้นต่ำ) ไม่อยู่ในบรีฟรอบนี้ ห้ามยกมาใช้
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) หน้านี้ยาว 157
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} คลับคนเล่นสล็อตซุปเปอร์ กดปุ่มเดียวไปยังช่องทางหลัก ติดตามเกมใหม่ กิจกรรมสมาชิก และโปรโมชั่นคืนยอดเสีย 0.3% กับแนะนำเพื่อน 0.8%`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} คลับคนเล่นสล็อตซุปเปอร์ ดับเบิ้ลโบนัสจัดเต็มทุกค่าย`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#a8730a] bg-gradient-to-b from-[#ffd666] via-[#f2b705] to-[#c08a0b] px-6 py-4 text-2xl font-black tracking-wide text-[#2b0a00] shadow-[0_10px_30px_rgba(242,183,5,0.40)] transition-all duration-300 hover:scale-105 hover:border-[#2b0a00] hover:shadow-[0_15px_40px_rgba(242,183,5,0.60)]">
        <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ffd666]/60 to-transparent"></div>
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
