---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char).
const pageDescription =
  "หน้าสมัครสมาชิก BETPLAY369 กดปุ่มเดียวเพื่อเปิดบัญชีใหม่ด้วยตัวเอง จากนั้นเข้าเล่นบาคาร่า คาสิโนสด สล็อต หวย มวย และบอล พร้อมตรวจสอบสิทธิ์โปรโมชั่นในบัญชีเดียว";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก BETPLAY369 เปิดบัญชีใหม่",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก BETPLAY369 เปิดบัญชีใหม่ด้วยตัวเอง เว็บเกมคาสิโนครบวงจร" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก BETPLAY369" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก BETPLAY369"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ff35b4]/70 bg-gradient-to-r from-[#ff35b4] via-[#e5399f] to-[#6d1750] px-6 py-4 text-lg font-black text-[#f4ebff] shadow-[0_10px_30px_rgba(229,57,159,0.25)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(255,53,180,0.35)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
