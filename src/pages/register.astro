---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change (CtaRedirect.astro
// itself belongs to the orchestrator — ห้ามแก้ไฟล์นั้นจากหน้านี้)
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page, which means verify-build holds its
// description to the same 150–160 character window as every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES — คอปปี้ของหน้านี้จึงพูด
// ได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 14: ควรตรวจสอบคุณสมบัติผู้สมัคร อายุที่กฎหมาย
// อนุญาต และเงื่อนไขการใช้บริการก่อนดำเนินการ · บรรทัด 16-18: อ่านนโยบายการจัดเก็บ
// ข้อมูลส่วนบุคคล ตั้งรหัสผ่านที่คาดเดาได้ยาก และไม่เปิดเผยรหัส OTP ให้ใครทราบ ·
// บรรทัด 8: ก่อนเข้าร่วมโปรโมชั่นควรอ่านประกาศล่าสุด)
// ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า หน้านี้มีโควตาเป็นปุ่มเดียว
//
// ⚠️ แกนของบรีฟรอบนี้คือ **เว็บสล็อตออนไลน์เจ้าดังไม่ผ่านม้า เดิมพันค่ายแท้
// ถูกลิขสิทธิ์100%** ไม่ใช่แกนของรอบก่อน และไม่ใช่เว็บลอตเตอรีแบบรอบ
// ก่อนหน้านั้น ศัพท์ของหมวดอื่นที่บรีฟไม่มีทุกคำจึงเป็นของค้างที่ห้ามหลุดกลับมา
// รายการคำเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไป
// เจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// คำที่ใช้ได้รอบนี้: สล็อต · สล็อตออนไลน์ · เว็บสล็อต · เจ้าดัง · ไม่ผ่านม้า ·
// บัญชีม้า · ค่ายแท้ · ค่ายเกม · ค่ายผู้พัฒนา · ถูกลิขสิทธิ์100% · ลิขสิทธิ์เกม ·
// ทดลองเล่นฟรี · โหมดทดลองเล่น · เกมแนวคลาสสิก · ฟีเจอร์โบนัส · สัญลักษณ์พิเศษ ·
// กติกาเกม · เดิมพันจริง · โปรโมชั่น · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% ·
// เครดิต · สมัครสมาชิก · เข้าสู่ระบบ · ยืนยันบัญชี · คุณสมบัติผู้สมัคร ·
// อายุที่กฎหมายอนุญาต · เงื่อนไขการใช้บริการ · นโยบายความเป็นส่วนตัว ·
// ข้อมูลส่วนบุคคล · รหัสผ่าน · รหัส OTP · แอดมิน · เจ้าหน้าที่ · 24ชม. ·
// เว็บไซต์ทางการ · ประกาศล่าสุด · บัญชีแอบอ้าง · ฝากถอน
// ⚠️ **สองหน้าหมวดลอตเตอรีอยู่ใน src/pages-disabled/ รอบนี้**
// ห้ามลิงก์ไปสองเส้นทางนั้น route ไม่มีอยู่จริง build จะแดง
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกม ชื่อธนาคาร หรือใบอนุญาตแม้แต่รายเดียว**
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 24ชม. · 3 ขั้นตอน · 100%
// ห้ามแต่งใบอนุญาต หน่วยงานกำกับ ค่า RTP ยอดฝากขั้นต่ำ หรือจำนวนสมาชิก ·
// บรีฟมี "ขั้นตอนที่ 1-3" ของการสมัคร แต่นั่นเป็นของ index.astro
// (FeatureHighlights) **ห้ามยกมาเขียนซ้ำที่หน้านี้**
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตต์รอบนี้อยู่ใน .claude/brand-spec-pakyok168.md §2
// ⚠️⚠️ **รอบนี้กลับมาเป็น "ธีมมืด" หลังรอบก่อนเป็นฟ้าพาสเทลสว่าง — การ์ดผิว
// น้ำตาลเข้ม หมึกไอวอรี** bg.json = {"mode":"color","color":"#291d0f"} =
// **น้ำตาลกาแฟเข้ม** ไม่ใช่สีสว่าง การ์ด ContentBox จึงเป็นผิว #3a2713 บนหมึก
// ไอวอรี #f4ead6 (= BRAND_TEXT) **ห้าม "แก้" ให้กลับไปสว่างเพราะรอบที่แล้วสว่าง**
// ปุ่มนี้เป็น PRIMARY: พื้นถม **ทองสว่าง → ทองแกน → ทองลึก**
// #fded41 → #eeae12 → #9f600d ขอบ #9f600d บนหมึก **เข้ม** #1f0f04
// (15.4 / 9.5:1 บนสองสต็อปแรก — หมึกเข้มบนพื้นถมทอง)
// ส่วน /login เป็น SECONDARY ปุ่มขอบ: ขอบ #eeae12 ตัวอักษร #fded41 บนพื้น #2f1e0f
// จึงไม่ซ้ำกัน
// ⚠️ ปุ่มของ Navfoot อยู่บนแถบโครมน้ำตาลลึก คนละโซนกับปุ่มบนการ์ดนี้
// **ห้ามลอกคลาสของ Navfoot มาวางบนการ์ด**
// ⚠️ ไล่เฉดต้อง **เริ่มที่ #fded41 แล้วเข้มลงถึง #9f600d** ห้ามลากปลายเข้มเลยค่านั้น
// และ **ห้ามกลับด้านเป็นตัวอักษรขาวบนพื้นทอง** ขั้วของปุ่มนี้คือพื้นถมทอง-หมึกเข้ม
// ⚠️⚠️ **#9f600d ห้ามถือตัวอักษรบนพื้นมืด** (2.8:1) เป็นสีพื้นถม/ขอบ/ออราเท่านั้น
// ออราในไฟล์นี้ใช้ rgba(238,174,18,α) · rgba(253,237,65,α) เท่านั้น
//
// ⚠️ กับดักรอบนี้คือ **ทองเคยผ่านรีโปนี้มาแล้วเกือบทุกเจ้า** (หลายเจ้าในตาราง) "มีทองอยู่แล้ว" จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้
// ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive
// รอบนี้ **ไม่มีฟ้า/น้ำเงิน (สีนำของรอบก่อน) ไม่มีแดง ไม่มีเขียว (ยกเว้น
// LINE green ที่หน้าอื่น) ไม่มีชมพู ไม่มีม่วง ไม่มีส้ม และไม่มีโรสโกลด์**
//
// Announcement หมุนมาเป็น AnnouncementPremium ทั้งเว็บรอบนี้ (brand-spec §3 —
// รอบก่อนใช้ตัวอื่น จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์
// นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare — ห้ามส่ง prop message
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) หน้านี้ยาว 155
// ด้วยชื่อแบรนด์ 8 ตัวอักษรของรอบนี้ (ส่วนที่ไม่ใช่ชื่อแบรนด์ยาว 147 จึงรับชื่อ
// ได้ตั้งแต่ 3 ถึง 13 ตัวอักษร — ยาวกว่านั้นต้องตัดข้อความ ไม่ใช่ปล่อยผ่าน)
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} กดปุ่มเดียวไปยังขั้นตอนลงทะเบียน ควรตรวจสอบคุณสมบัติ อายุที่กฎหมายอนุญาต และเงื่อนไขการใช้บริการ โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} ลงทะเบียนเพื่อเข้าใช้งานเกมสล็อตค่ายแท้และโปรโมชั่น`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#9f600d] bg-gradient-to-b from-[#fded41] via-[#eeae12] to-[#9f600d] px-6 py-4 text-2xl font-black tracking-wide text-[#1f0f04] shadow-[0_10px_30px_rgba(238,174,18,0.4)] transition-all duration-300 hover:scale-105 hover:border-[#fded41] hover:shadow-[0_15px_40px_rgba(238,174,18,0.55)]">
        <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#fded41]/60 to-transparent"></span>
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
