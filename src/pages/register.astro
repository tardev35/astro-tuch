---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect. The title and
// description below were rewritten this round for exactly that reason.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// หวยเฮง24 (รอบแดงเข้ม-ทอง 2026-10-01): ปุ่มนี้เป็นตัว PRIMARY ของคู่
// จึงสวมไล่เฉดทองประจำแบรนด์เต็มใบ (#fdea83 → #fbdc64 → #bd7c13) บนตัวอักษรหมึกเข้ม
// #2a0606 ซึ่งได้คอนทราสต์สูงสุดบนพื้นทอง — ตัวอักษรขาวบน #e0a52a ตก AA จึงห้ามใช้
// ส่วน /login รับแบบ outline — กรอบแดงแบรนด์ #8b0302 บนผิวยก #3d0808 แทน
// สองลำดับ หนึ่งรูปแบบต่อหนึ่งปุ่ม ไม่ใช่ถมทองสองใบซึ่งจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม
// ชุดเขียวป่า-ทองของ หวยเต็ง (#03150a #062a12 #0b3d18 #026314 #024a0f #0bb42f
// #e5c04f #fae474 #bd8d2d #d8ead9 #0a1a0c rgba(229,192,79,*) rgba(2,99,20,*)
// rgba(3,21,10,*)) ออกครบแล้ว
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ (รอบก่อนเป็น Announcement3)
// — default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ index ก็เรียกแบบ bare
//
// หวยเฮง24 เป็นเว็บเล่นหวยออนไลน์ ไม่ใช่บอลและไม่ใช่สล็อต — บรีฟระบุการสมัครผ่านมือถือ
// ได้เองด้วย 3 ขั้นตอน (เข้าหน้าสมัครและกรอกข้อมูลที่ระบบกำหนด → ยืนยันข้อมูลและ
// Login เข้าบัญชีสมาชิก → เลือกหวย รอบ และเลขที่ต้องการ พร้อมตรวจสอบรายละเอียดก่อน
// ส่งโพย) แล้วใช้บัญชีเดียวติดตามหวยลาว หวยฮานอย หวยรัฐบาลไทย และหวยหุ้น พร้อม
// ตรวจสอบโพย เช็คผล และจัดการธุรกรรมผ่านวอลเลทหรือธนาคารที่ระบบรองรับ
// คำศัพท์ของแบรนด์ก่อนหน้า (สล็อต ฟรีสปิน ตัวคูณ ค่ายเกม RTP แตกง่าย เว็บตรง บอล
// ค่าน้ำ อัตราต่อรอง ลีก บิลสเต็ป แฮนดิแคป คาสิโน บาคาร่า) ห้ามหลงเหลือ และห้ามเพิ่ม
// ชื่อธนาคาร ยอดฝากขั้นต่ำ ชื่อผู้ให้บริการจริง หรือเลขใบอนุญาต
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 156
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = "หน้าสมัครสมาชิก หวยเฮง24 กดปุ่มเดียวเปิดบัญชีด้วยตัวเองผ่านหน้าเว็บบนมือถือ แล้วเข้าสู่ระบบเลือกรายการหวย ส่งโพย และตรวจสอบอัตราจ่ายของแต่ละรอบจากบัญชีเดียว";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก หวยเฮง24",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="สมัครสมาชิก หวยเฮง24 เปิดบัญชีเองผ่านเว็บ เริ่มเล่นหวยไม่ต้องลงแอป" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก หวยเฮง24" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก หวยเฮง24"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fdea83]/70 bg-gradient-to-r from-[#fdea83] via-[#fbdc64] to-[#bd7c13] px-6 py-4 text-lg font-black text-[#2a0606] shadow-[0_10px_30px_rgba(224,165,42,0.45)] transition-all duration-300 hover:scale-105 hover:border-[#fdea83] hover:shadow-[0_15px_40px_rgba(251,220,100,0.35)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
