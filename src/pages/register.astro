---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect. The title and
// description below were rewritten this round for exactly that reason.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// CK268 (รอบเขียวนีออน-โครเมียม-ดำ 2026-09-30): ปุ่มนี้เป็นตัว PRIMARY ของคู่ จึงสวม
// ไล่เฉดเขียวนีออนประจำแบรนด์เต็มใบ (#c9ff8f → #8bfc13 → #1a7a08) บนตัวอักษรหมึกเข้ม
// #071007 ซึ่งได้คอนทราสต์สูงสุดบนพื้นเขียวนีออน — ตัวอักษรขาวบน #8bfc13 ได้แค่
// ~1.5:1 ตก AA จึงห้ามใช้เด็ดขาด
// ส่วน /login รับแบบ outline — กรอบเขียวเข้มรอง #12a008 บนผิวปุ่มรอง #0f1b0e แทน
// สองลำดับ หนึ่งรูปแบบต่อหนึ่งปุ่ม ไม่ใช่ถมเขียวสองใบซึ่งจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม
// ทองห้ามเป็นสีหลักรอบนี้ เพราะแบรนด์ก่อน GOT777 เป็นทอง+แดง
// ชุดทอง-แดงของ GOT777 (#f5c518 #ffe9a8 #96690f #fff6dd #ece0cb #d21622 #7b0304
// #4c0301 #0a0503 #241108 rgba(245,197,24,*) rgba(210,22,34,*) rgba(10,5,3,*))
// ออกครบแล้ว
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ (รอบก่อนเป็น Announcement3)
// — default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ index ก็เรียกแบบ bare
//
// CK268 เป็นเว็บเกมสล็อตออนไลน์ ไม่ใช่เว็บหวย — บรีฟระบุการสมัครผ่านระบบออนไลน์บน
// มือถือได้เองด้วย 3 ขั้นตอน (เข้าหน้าสมัครและกรอกข้อมูลที่ระบบกำหนด → ยืนยันข้อมูล
// และ Login เข้าสู่บัญชี → เลือกเกมสล็อต ค่ายเกม และโปรโมชั่นที่ต้องการ) แล้วตรวจสอบ
// เครดิต ประวัติรายการ และเกมใหม่ได้จากบัญชีเดียว
// คำศัพท์ตระกูลหวยของแบรนด์ก่อน (หวย โพย แทงหวย ส่งโพย งวด รอบออกรางวัล เลขเด็ด
// อัตราจ่าย 2 ตัว 3 ตัว รัฐบาลไทย ลาวพัฒนา ฮานอย หวยหุ้น) ห้ามหลงเหลือ และห้าม
// เพิ่มชื่อธนาคาร ยอดฝากขั้นต่ำ ชื่อค่ายเกม ตัวเลข RTP หรือเลขใบอนุญาต
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 155
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = "หน้าสมัครสมาชิก CK268 กดปุ่มเดียวเปิดบัญชีด้วยตัวเองผ่านหน้าเว็บบนมือถือ แล้วเข้าสู่ระบบเลือกเกมสล็อตตามค่าย ตรวจสอบโปรโมชั่นและเครดิตจากบัญชีเดียวได้ทันที";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก CK268",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="สมัครสมาชิก CK268 เปิดบัญชีเองผ่านเว็บ เข้าเล่นเกมสล็อตไม่ต้องลงแอป" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก CK268" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก CK268"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#c9ff8f]/70 bg-gradient-to-r from-[#c9ff8f] via-[#8bfc13] to-[#1a7a08] px-6 py-4 text-lg font-black text-[#071007] shadow-[0_10px_30px_rgba(139,252,19,0.45)] transition-all duration-300 hover:scale-105 hover:border-[#eaffd6] hover:shadow-[0_15px_40px_rgba(139,252,19,0.35)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
