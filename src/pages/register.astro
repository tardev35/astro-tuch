---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change (CtaRedirect.astro
// itself belongs to the orchestrator — ห้ามแก้ไฟล์นั้นจากหน้านี้)
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page, which means verify-build holds its
// description to the same 150–160 character window as every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES — คอปปี้ของหน้านี้จึงพูด
// ได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 20 และ 27: ควรตรวจสอบช่องทางติดต่อจากเว็บไซต์
// ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง โดยไม่เปิดเผยรหัสผ่านหรือรหัส
// OTP ให้บุคคลอื่น · บรรทัด 18: ควรตรวจสอบชื่อบัญชีปลายทางให้ตรงกับข้อมูลผู้ให้
// บริการที่ยืนยันได้ · บรรทัด 12: ควรตรวจสอบเงื่อนไขก่อนรับสิทธิ์)
// ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า หน้านี้มีโควตาเป็นปุ่มเดียว
//
// ⚠️ แกนของบรีฟรอบนี้คือ **เว็บหวยออนไลน์** (หวยรัฐบาลไทย หวยลาว หวยฮานอย
// หวยออมสิน) **ไม่ใช่หมวดของรอบก่อน** คำนิยามตัวเองของรอบก่อนห้ามเหลือ (brand-spec §5)
// ศัพท์ของหมวดอื่นที่บรีฟไม่มีทุกคำจึงเป็นของค้างที่ห้ามหลุดกลับมา
// รายการคำเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไป
// เจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// คำที่ใช้ได้รอบนี้: แทงหวย · หวยออนไลน์ · รับแทงเลขออนไลน์ · หวยรัฐบาลไทย ·
// หวยลาว · หวยฮานอย · หวยออมสิน · เลขเด็ด · เลขดัง · รอบปิดรับ · งวด ·
// อัตราจ่าย · บาทละ 1,000 · 2 ตัว 100 · 3 ตัว 1,000 · ตรวจบิล · ยืนยันบิล ·
// เงื่อนไขการเดิมพัน · โปรโมชั่น · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% ·
// เข้ายูสได้ทุกวัน · เครดิต · ยอดเสีย · กดรับเครดิต · ลิงก์แนะนำ · เชื่อมโยงบัญชี ·
// รอบจ่ายเครดิต · เงื่อนไขการใช้โบนัส · ประเภทหวยที่เข้าร่วม · ฝากถอน ·
// ระบบฝากถอน · ธนาคาร · ทรูมันนี่ · ยอดขั้นต่ำ · ระยะเวลาดำเนินการ ·
// ชื่อบัญชีปลายทาง · บัญชีแอบอ้าง · ผู้ให้บริการชำระเงิน · ธุรกรรม ·
// หมายเลขรายการ · หลักฐาน · สมัครสมาชิก · เข้าสู่ระบบ · แอดมิน · เจ้าหน้าที่ ·
// 24ชม. · ช่องทางติดต่อ · เว็บไซต์ทางการ · ประกาศล่าสุด · รหัสผ่าน · รหัส OTP
// ⚠️⚠️ **คำคู่ของแบรนด์เก่าที่ต่อท้ายชื่อ route /ทดลองเล่น ด้วย ฟรี / โหมด~
// ไม่ใช่คำของบรีฟรอบนี้** (คำเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่)
// ⚠️ **สองหน้าหมวดหวยเปิดอยู่รอบนี้** (/ตรวจหวย และ /แนวทาง อยู่ใน src/pages/)
// แต่หน้านี้มีโควตาเป็นปุ่มเดียว จึงไม่ลิงก์ไปที่อื่นเพิ่ม
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อธนาคาร ชื่อวอลเล็ต หน่วยงานกำกับ หรือใบอนุญาต
// แม้แต่รายเดียว** (พูดถึง "ธนาคารและทรูมันนี่" แบบรวมๆ เท่านั้น)
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ บาทละ 1,000 · 2 ตัว 100 · 3 ตัว 1,000 ·
// 0.3% · 0.8% · 24ชม. **ไม่มีวลีจำนวนขั้นตอน ไม่มีจำนวนงวด ไม่มีอัตรา 3.2 เป็น
// คำกล่าวอ้าง (อยู่บนภาพเท่านั้น)** ห้ามแต่งใบอนุญาต ตัวเลขการเงิน หรือจำนวน
// สมาชิก — บรีฟรอบนี้ไม่มีหัวข้อขั้นตอนการสมัครเลย จึงไม่มีอะไรให้ยกมาเขียนซ้ำ
// ที่หน้านี้ตั้งแต่ต้น
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตต์รอบนี้อยู่ใน brand-spec §2
// ⚠️⚠️ **รอบนี้ยังเป็นธีมมืดเหมือนรอบก่อน แต่คนละฮิวสิ้นเชิง**
// bg.json = {"mode":"color","color":"#000000"} = **ดำสนิท**
// (รอบก่อนเป็น 00091f = น้ำเงินเที่ยงคืน ไม่ใช่ดำสนิท — ค่ามาจากไฟล์ ห้ามเดาว่า
// เท่าเดิม และห้าม "แก้" การ์ดให้สว่าง)
// การ์ด ContentBox จึงเป็นผิว #121110 บนหมึกสว่าง #f3ece0 (= BRAND_TEXT)
// ปุ่มนี้เป็น **หลัก (primary)** ของพาเลต: ไล่เฉดทอง
// #ffd94a -> #e3a712 -> #b07d08 ขอบ #9d6f06 บนหมึก **ดำ #0a0a0a**
// ส่วน /login เป็น **รอง (secondary)**: ไล่เฉดโครเมียมเงิน #e8eaee -> #b4b9c2
// บนหมึกดำเช่นกัน จึงไม่ซ้ำกัน
// 🚨🚨 **ขาวบนทองได้แค่ ~1.2–2.2:1 — ห้ามวางหมึกขาวบนพื้นทองเด็ดขาด** แผ่นทองใน
// อาร์ตเวิร์กเองก็เป็นตัวอักษรเข้มบนทองเหมือนกัน
// 🚨🚨 **ห้ามจบไล่เฉดที่ #9d6f06** — ได้แค่ 4.5:1 กับหมึกดำ ไล่เฉดต้องจบที่
// #b07d08 (5.4:1) ส่วน #9d6f06 สงวนไว้ให้ขอบ/ออรา/พื้นถมที่ไม่มีตัวอักษร
// 🚨🚨 **#e3a712 / #b07d08 / #9d6f06 / #b4b9c2 / #6b7079 / #3d3425 ห้ามถือ
// ตัวอักษรเอง** เป็นพื้นถม/ขอบ/ออราเท่านั้น · ที่ถือตัวอักษรได้บนผิวมืดชุดนี้คือ
// #ffd94a (13.8:1) · #f3ece0 (16.0:1) · #bfb8aa (9.6:1) · #dde1e7 (13.5:1) ·
// #e8eaee (16.0:1)
// ⚠️⚠️ **วัสดุของรอบนี้คือทองนำ + โครเมียมเงินรอง** อ่านจากอาร์ตเวิร์กตรงๆ:
// คำว่า "รวย" ในโลโก้เป็นตัวอักษรไทยสามมิติโครเมียมเงินตัดขอบทอง มีมงกุฎทองเล็ก
// อยู่บนตัวอักษรตัวแรก ต่อด้วยเลข "168" สีทอง
// ⚠️⚠️ **ผมสีขาวเงิน ลิปสติกแดง สูทดำ และสีผิวนักแสดงเป็นวัตถุในภาพ ไม่ใช่สี UI**
// — รอบนี้ไม่มีแดง ไม่มีครีม ไม่มีพีช และไม่มีเบจ
// ⚠️ ปุ่มของ Navfoot อยู่บนแถบโครมคนละโซนกับปุ่มบนการ์ดนี้
// **ห้ามลอกคลาสของ Navfoot มาวางบนการ์ด**
// ออราในไฟล์นี้ใช้ rgba(255,217,74,α) · rgba(227,167,18,α) · rgba(176,125,8,α)
// · rgba(221,225,231,α) · rgba(0,0,0,α) เท่านั้น
//
// ⚠️⚠️ กับดักรอบนี้คือ **ทอง/เหลืองเคยนำมาแล้วเกือบทุกแบรนด์ในรีโปนี้**
// "มีทองอยู่แล้ว" จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้ ให้เทียบเป็น "ค่า" ทีละหลักกับ
// ตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่า
// เจอ false positive · **ทองของรอบนี้คือ #ffd94a / #e3a712 / #b07d08 / #9d6f06
// เท่านั้น** (ffd84d ของแบรนด์เก่าห่างจาก #ffd94a แค่ G1 — เจอที่ไหนแปลว่าพิมพ์ผิด)
// รอบนี้ **ไม่มีแดง ไม่มีน้ำเงิน/ฟ้า ไม่มีส้ม ไม่มีเขียว (ยกเว้น LINE green ที่
// หน้าอื่น) ไม่มีชมพู ไม่มีม่วง ไม่มีน้ำตาล ไม่มีครีม และไม่มีโรสโกลด์**
// แดงคือฮิวนำของแบรนด์ขาออก (ชื่ออยู่ใน brand-spec §0) การปล่อยแดงไว้ = ทั้งผิดพาเลตและหลงเหลือ
// ข้ามแบรนด์พร้อมกัน
//
// Announcement หมุนมาเป็น AnnouncementHuay ทั้งเว็บรอบนี้ (brand-spec §3 —
// รอบก่อนใช้ AnnouncementPremium จึงหมุนออก) orchestrator ตั้ง default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare — ห้ามส่ง prop message
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) ส่วนที่ไม่ใช่ชื่อแบรนด์
// ยาว 152 อักขระ จึงรับชื่อแบรนด์ได้ตั้งแต่ 1 ถึง 8 ตัวอักษร — นอกช่วงนั้นต้องแก้
// ข้อความ ไม่ใช่ปล่อยผ่าน รอบนี้ชื่อยาว 6 ตัวอักษร รวมเป็น 158
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} กดปุ่มเดียวไปยังขั้นตอนลงทะเบียนแทงหวย ควรตรวจสอบช่องทางจากเว็บไซต์ทางการ ตั้งรหัสผ่านที่คาดเดายาก และไม่เปิดเผยรหัส OTP ให้ผู้อื่นทราบ`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} ลงทะเบียนแทงหวยออนไลน์และรับสิทธิ์โปรโมชั่น`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#9d6f06] bg-gradient-to-b from-[#ffd94a] via-[#e3a712] to-[#b07d08] px-6 py-4 text-2xl font-black tracking-wide text-[#0a0a0a] shadow-[0_10px_30px_rgba(227,167,18,0.4)] transition-all duration-300 hover:scale-105 hover:border-[#ffd94a] hover:shadow-[0_15px_40px_rgba(255,217,74,0.55)]">
        <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#dde1e7]/25 to-transparent"></span>
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
