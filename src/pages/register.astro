---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — this page is indexed and must not
// describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// This is the PRIMARY action of the pair on the 888PARUAY palette, so it wears
// the full gold-gradient fill of the logo's ring (#fff6ae → #fcdc2b → #a87d0c)
// under near-black green ink (#07130a, the only reading that keeps contrast on
// gold); /login carries the same gold as an outline on the card surface
// instead. Two tiers, one fill each — the gold/green pairing the logo uses.
// ชุดแดง-ทองของ 365LOTTO (#fadc64 #ffe9a3 #9c6a12 #120406 #f3f6fa) ออกครบแล้ว
//
// Announcement รอบนี้หมุนจาก AnnouncementHuay มาเป็น Announcement3 ทั้งเว็บ —
// default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ index ก็เรียกแบบ bare
// จึงห้ามส่ง prop
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 157
const pageDescription = "สมัครสมาชิก 888PARUAY กดปุ่มเดียวเปิดบัญชีใหม่ด้วยตัวเองบนมือถือใน 3 ขั้นตอน จากนั้นเข้าสู่ระบบเลือกแทงหวยรัฐบาลไทย ฮานอย ลาวพัฒนา และหุ้นต่างประเทศ ได้ทันที";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก 888PARUAY",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="สมัครสมาชิก 888PARUAY เปิดบัญชีใหม่ด้วยตัวเอง แทงหวยได้ในบัญชีเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก 888PARUAY" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก 888PARUAY"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fff6ae] bg-gradient-to-r from-[#fff6ae] via-[#fcdc2b] to-[#a87d0c] px-6 py-4 text-lg font-black text-[#07130a] shadow-[0_10px_30px_rgba(252,220,43,0.50)] transition-all duration-300 hover:scale-105 hover:border-[#1fae1c] hover:shadow-[0_15px_40px_rgba(31,174,28,0.45)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
