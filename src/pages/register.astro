---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — do not describe a redirect here.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// This is the PRIMARY action of the pair, so it wears the green gradient of the
// UVO88 logo; /login carries the gold-coin accent.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 157.
const pageDescription =
  "หน้าสมัครสมาชิก UVO88 กดปุ่มเดียวเปิดบัญชีใหม่ด้วยตัวเอง เข้าเล่นบาคาร่า เกมไพ่ สล็อตออนไลน์ หวย และฟุตบอล ครบในบัญชีเดียว พร้อมตรวจสอบโปรโมชั่นได้ด้วยตัวเอง";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก UVO88",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก UVO88 เปิดบัญชีใหม่ด้วยตัวเอง เริ่มเดิมพันได้ทันที" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก UVO88" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก UVO88"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#57dd8f]/60 bg-gradient-to-r from-[#57dd8f] via-[#0f9d47] to-[#116330] px-6 py-4 text-lg font-black text-[#03110a] shadow-[0_10px_30px_rgba(15,157,71,0.28)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(15,157,71,0.48)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
