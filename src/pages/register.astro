---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect. The title and
// description below are written for exactly that reason.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// UP555 (รอบทอง + เงินโครเมียม บนดำอมน้ำตาล 2026-10-03, brand-spec §2 — มาจาก
// logo.webp ที่ตัว U กับ UP เป็นเงินโครเมียม #d5d4d3 ส่วนลูกศร วงรี และเลข 555
// เป็นทองเมทัลลิก #ebbb54):
// ปุ่มนี้เป็นตัว PRIMARY ของคู่ จึงสวมไล่เฉด **ทอง** ประจำแบรนด์เต็มใบ
// (#fce675 → #ebbb54 → #ab6d24) ขอบทองเข้ม #ab6d24 บนตัวอักษร **ดำอมน้ำตาล #160d02** —
// กฎคอนทราสต์: หมึกขาวบนทองสว่าง #fce675 ได้ไม่ถึงเกณฑ์ พื้นทองจึงต้องใช้หมึกเข้ม
// เสมอ (#160d02 บน #fce675 ≈ 14:1 ผ่าน) และหมึกเงินโครเมียมบนพื้นทองก็ตก
// ส่วน /login เป็นแบบ outline (กรอบเงินโครเมียม #d5d4d3/60 + ตัวอักษรเงินสว่าง
// #f3f3f2 บนพื้นชิป #241705) สองลำดับ หนึ่งรูปแบบต่อหนึ่งปุ่ม ไม่ใช่ถมทองสองใบ ซึ่งจะ
// อ่านเป็นปุ่มซ้ำกันสองปุ่ม — และคู่ทอง/เงินนี้คือสองโทนที่อยู่บนโลโก้จริง
// ชุดเขียว-แดงของ DM899 (#01a326 #4ade6b #12c23a #01841b #fb252b #ffe9a8 #f2b422
// #030a05 #0a1a0e #102a16 #061008 #06140a #e4f2e4 rgba(1,163,38,*) rgba(3,10,5,*)
// rgba(74,222,107,*)) ออกครบแล้ว
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ (รอบก่อน DM899 เป็น
// Announcement3) — default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ
// index ก็เรียกแบบ bare จึงห้ามส่ง prop message
//
// UP555 เป็นคาสิโนที่รวมสล็อต บาคาร่า บอล และหวยไว้ในบัญชีเดียว — ไม่ใช่เว็บหวย
// และไม่ใช่ "เว็บตรงต่างประเทศ" บรีฟบรรทัด 15 ระบุการสมัครผ่านมือถือได้เองด้วย
// 3 ขั้นตอน (เปิดหน้าสมัครและกรอกข้อมูลที่ระบบกำหนด → ยืนยันข้อมูลเพื่อเปิดบัญชีและ
// Login เข้าสู่ระบบ → เลือกสล็อต บาคาร่า บอล หวย หรือเกมที่ต้องการ พร้อมตรวจสอบ
// รายละเอียดและโปรโมชั่นก่อนเริ่มใช้งาน) แล้วใช้บัญชีเดียวเข้าถึงเกมที่ระบบเปิดให้
// บริการ ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการ
// ตัวเลขที่ใช้ได้มีแค่ 0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง
// ห้ามแต่งตัวเลขอื่นขึ้นมาเอง
// คำศัพท์หวยของแบรนด์ก่อนหน้า (แทงหวย ส่งโพย โพย เลือกเลข 2 ตัว 3 ตัว อัตราจ่าย
// งวด รัฐบาลไทย ฮานอย ลาวพัฒนา หวยหุ้น ตรวจหวย แนวทางหวย) ห้ามหลงเหลือ และห้ามเพิ่ม
// ชื่อค่ายเกม ชื่อธนาคาร ยอดฝากขั้นต่ำ ค่า RTP ชื่อผู้ให้บริการจริง หรือเลขใบอนุญาต
// ที่บรีฟไม่ได้ระบุ
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 151
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} กดปุ่มเดียวเปิดบัญชีผ่านมือถือได้ใน 3 ขั้นตอน แล้ว Login เลือกสล็อต บาคาร่า บอล หวย พร้อมตรวจสอบเครดิตและโปรโมชั่นก่อนเริ่มใช้งาน`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} เปิดบัญชีเองผ่านมือถือ 3 ขั้นตอน เริ่มเล่นได้เลย`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ab6d24] bg-gradient-to-r from-[#fce675] via-[#ebbb54] to-[#ab6d24] px-6 py-4 text-lg font-black text-[#160d02] shadow-[0_10px_30px_rgba(235,187,84,0.45)] transition-all duration-300 hover:scale-105 hover:border-[#fce675] hover:shadow-[0_15px_40px_rgba(252,230,117,0.45)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
