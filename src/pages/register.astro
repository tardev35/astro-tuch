---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// WIN999 (รอบทอง-ดำ 2026-09-29): ปุ่มนี้เป็นตัว PRIMARY ของคู่ จึงสวมไล่เฉดทอง
// ประจำแบรนด์เต็มใบ (#fdda04 → #fcc403 → #e0a800) บนหมึกเข้ม #120d02 ซึ่งได้
// คอนทราสต์ ~10:1 บนทองแบรนด์ — ตัวอักษรบนพื้นทองสว่างห้ามเป็นสีขาว และทองลึก
// #8a6502 จงใจไม่อยู่ในไล่เฉดนี้ เพราะหมึกเข้มบนทองลึกเหลือแค่ ~3.3:1
// ส่วน /login รับแบบ outline — กรอบทองบนผิวการ์ดอุ่น #191712 แทน สองลำดับ หนึ่งรูป
// แบบต่อหนึ่งปุ่ม ไม่ใช่ถมทองสองใบซึ่งจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม
// ชุดแดง+ทองของแบรนด์ก่อนหน้า (#dc2626 #fc2b2c #b40102 #fde68a #fbbf24 #a16207
// #2a0405 #7f1d1d #f6e2e2 rgba(220,38,38,*) rgba(251,191,36,*)) ออกครบแล้ว
//
// Announcement หมุนจาก AnnouncementHuay มาเป็น AnnouncementPremium ทั้งเว็บรอบนี้ —
// default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ index ก็เรียกแบบ bare
//
// WIN999 เป็นเว็บคาสิโนออนไลน์ — บรีฟระบุการสมัครเองผ่านหน้าเว็บไซต์ได้ 3 ขั้นตอน
// (กรอกข้อมูลที่ระบบกำหนด → ยืนยันข้อมูลหรือเบอร์โทรศัพท์ → Login เข้าบัญชีเพื่อ
// ตรวจสอบช่องทางฝากเงิน โปรโมชั่น และเกมที่เปิดให้บริการ) คำศัพท์ตระกูลสลาก/ลอตเตอรี
// ของแบรนด์ก่อน (เลข 2 ตัว/3 ตัว อัตราจ่าย บิล/โพย ม้า เอเย่นต์) ห้ามหลงเหลือ
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 157
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = "สมัครสมาชิก WIN999 กดปุ่มเดียวเปิดบัญชีด้วยตัวเองไม่ต้องรอคิว แล้วเข้าสู่ระบบเลือกบาคาร่า สล็อต และเกมไพ่ พร้อมตรวจสอบเครดิตและโปรโมชั่นจากบัญชีเดียวได้ทันที";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก WIN999",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="สมัครสมาชิก WIN999 เปิดบัญชีเองได้ใน 3 ขั้นตอน เล่นคาสิโนบัญชีเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก WIN999" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก WIN999"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fdda04]/70 bg-gradient-to-r from-[#fdda04] via-[#fcc403] to-[#e0a800] px-6 py-4 text-lg font-black text-[#120d02] shadow-[0_10px_30px_rgba(252,196,3,0.45)] transition-all duration-300 hover:scale-105 hover:border-[#fdda04] hover:shadow-[0_15px_40px_rgba(252,196,3,0.35)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
