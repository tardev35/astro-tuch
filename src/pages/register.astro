---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// LOTTO24 (รอบแดง-ทอง-ดำ 2026-09-28): ปุ่มนี้เป็นตัว PRIMARY ของคู่ จึงสวมไล่เฉด
// แดงประจำแบรนด์เต็มใบ (#fc2b2c → #dc2626 → #b40102) บนตัวอักษรทองอ่อน #fde68a
// ซึ่งได้คอนทราสต์บนแดงเข้มดีกว่าหมึกดำ ขอบเป็นทอง #fbbf24 ให้ปุ่มอ่านเป็นแดง+ทอง
// ส่วน /login รับฝั่งทอง — กรอบทองบนผิวแดงเกือบดำ #2a0405 แทน สองลำดับ หนึ่งสี
// ต่อหนึ่งปุ่ม ไม่ใช่แดงสองใบซึ่งจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม
// ชุดชมพู+ม่วงของแบรนด์ก่อนหน้า (#fa42b5 #ffb3e2 #ec3fae #7d1550 #8b3df3 #c9a4ff
// #4a17a0 #3d1180 #140722 #0f0518 #070109 #12041c #f2dcee #fff2fb
// rgba(250,66,181,*) rgba(139,61,243,*)) ออกครบแล้ว ห้ามนำกลับมา
//
// Announcement หมุนจาก Announcement5 มาเป็น AnnouncementHuay ทั้งเว็บรอบนี้ —
// default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ index ก็เรียกแบบ bare
//
// LOTTO24 เป็นเว็บแทงหวยออนไลน์ — บรีฟระบุการสมัครเองผ่านหน้าเว็บไซต์ได้ 3 ขั้นตอน
// (กรอกข้อมูล → ตรวจสอบข้อมูลส่วนตัวและบัญชี → ยืนยันแล้วเข้าสู่ระบบเลือกรอบหวย)
// คำศัพท์ของสองแบรนด์ก่อนหน้า (สล็อต ค่ายเกม RTP บาคาร่า ไลฟ์สด เกมยิงปลา)
// ห้ามหลงเหลือในหน้านี้
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 152
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = "สมัครสมาชิก LOTTO24 กดปุ่มเดียวเปิดบัญชีด้วยตัวเองไม่ต้องรอคิว แล้วเข้าสู่ระบบเลือกรอบหวยและแทงเลข 2 ตัว 3 ตัว ตรวจอัตราจ่ายกับรายละเอียดบิลก่อนกดยืนยัน";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก LOTTO24",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="สมัครสมาชิก LOTTO24 เปิดบัญชีเองได้ใน 3 ขั้นตอน แทงหวยจากบัญชีเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก LOTTO24" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก LOTTO24"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fbbf24] bg-gradient-to-r from-[#fc2b2c] via-[#dc2626] to-[#b40102] px-6 py-4 text-lg font-black text-[#fde68a] shadow-[0_10px_30px_rgba(220,38,38,0.45)] transition-all duration-300 hover:scale-105 hover:border-[#fde68a] hover:shadow-[0_15px_40px_rgba(251,191,36,0.32)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
