---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// PGW44 (รอบทอง-เขียว-ดำ 2026-09-27): ปุ่มนี้เป็นตัว PRIMARY ของคู่ จึงสวมไล่เฉด
// ประจำแบรนด์เต็มใบ (#fde90e → #f5c518 → #35d413 ทองไหลไปเขียวตามลำดับตัวอักษร
// ในโลโก้) บนตัวอักษรหมึกเข้ม #10160a เพราะตัวหนังสือบนพื้นทองสว่างต้องเป็นสีเข้ม
// จึงจะอ่านออก ห้ามใช้ขาว ส่วน /login รับฝั่ง "W" ของโลโก้ที่เป็นเขียวจัด — ขอบเขียว
// #35d413 บนผิวยก #101a0b แทน สองลำดับ หนึ่งสีต่อหนึ่งปุ่ม ไม่ใช่ทองสองใบซึ่งจะ
// อ่านเป็นปุ่มซ้ำกันสองปุ่ม
// ชุดทอง+โครเมียมของแบรนด์ก่อนหน้า (#fdd32a #ffe27a #ffeeb8 #c8920a #15110a
// #c2c8d0 #f2f4f7 #12100a #2a2110 #080602 #efe6d2 #fff8e1 rgba(253,211,42,*)
// rgba(194,200,208,*)) ออกครบแล้ว ห้ามนำกลับมา
//
// Announcement หมุนจาก AnnouncementPremium มาเป็น Announcement2 ทั้งเว็บรอบนี้ —
// default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ index ก็เรียกแบบ bare
//
// PGW44 เป็นแบรนด์สล็อตล้วน — บรีฟระบุการสมัครเองผ่านหน้าเว็บไซต์ได้ 3 ขั้นตอน
// (กรอกข้อมูล → ตรวจสอบความถูกต้อง → ยืนยันและเข้าสู่ระบบ) คำศัพท์เฉพาะหมวดของ
// แบรนด์ก่อนหน้า (คาสิโนสด เกมโต๊ะ บาคาร่า หวย) รวมถึง API/ใบอนุญาต/ชื่อค่าย/
// ฝากถอนออโต้/เครดิตฟรี ห้ามหลงเหลือในหน้านี้
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 151
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = "สมัครสมาชิก PGW44 กดปุ่มเดียวเปิดบัญชีด้วยตัวเองใน 3 ขั้นตอน กรอกข้อมูล ตรวจสอบความถูกต้อง แล้วยืนยันเข้าสู่ระบบเพื่อเลือกเกมสล็อตจากค่ายย่อยได้ทั้งวัน";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก PGW44",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="สมัครสมาชิก PGW44 เปิดบัญชีเองได้ใน 3 ขั้นตอน เล่นจากบัญชีเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก PGW44" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก PGW44"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fde90e] bg-gradient-to-r from-[#fde90e] via-[#f5c518] to-[#35d413] px-6 py-4 text-lg font-black text-[#10160a] shadow-[0_10px_30px_rgba(253,233,14,0.50)] transition-all duration-300 hover:scale-105 hover:border-[#5df53a] hover:shadow-[0_15px_40px_rgba(53,212,19,0.30)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
