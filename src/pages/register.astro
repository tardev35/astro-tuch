---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement4.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change (CtaRedirect.astro
// itself belongs to the orchestrator — ห้ามแก้ไฟล์นั้นจากหน้านี้)
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page, which means verify-build holds its
// description to the same 150–160 character window as every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES — คอปปี้ของหน้านี้จึงพูด
// ได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 3-4: เกมสล็อตแท้ เว็บตรงถูกลิขสิทธิ์ และควร
// ตรวจสอบจากข้อมูลผู้พัฒนาและหลักฐานการได้รับอนุญาตที่เชื่อถือได้ · บรรทัด 16:
// ไม่ควรใช้ข้อมูลของบุคคลอื่นหรือเปิดเผยรหัส OTP ให้ใครทราบ · บรรทัด 22: ควรตรวจสอบ
// ช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง)
// ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า หน้านี้มีโควตาเป็นปุ่มเดียว — ขั้นตอนสมัคร
// 3 ขั้นตอนของบรีฟเป็นของ index.astro ซึ่งเป็นบทความจริง ไม่ใช่ของหน้านี้
//
// ⚠️ แกนของบรีฟรอบนี้คือ **เว็บสล็อต** (เกมสล็อตแท้ เว็บตรงถูกลิขสิทธิ์
// ฝากถอนทุกธนาคารและทรูมันนี่) คำนิยามตัวเองของแบรนด์ก่อนๆ ห้ามเหลือแม้แต่คำเดียว
// โดยเฉพาะศัพท์หมวดลอตเตอรีทั้งชุด (brand-spec §5 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้
// sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง)
// คำที่ใช้ได้รอบนี้: เกมสล็อตแท้ · เว็บตรงถูกลิขสิทธิ์ · ฝากรับโบนัสได้ทั้งวัน
// ไม่ต้องทำเทิร์น · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% ไม่จำกัด ·
// ฝากถอนทุกธนาคารและทรูมันนี่ · แอดมิน 24ชม. · สมัครสมาชิก · เข้าสู่ระบบ ·
// เว็บไซต์ทางการ · ประกาศล่าสุด · รหัสผ่าน · รหัส OTP · บัญชีแอบอ้าง ·
// ชื่อบัญชีปลายทาง
// ⚠️ **สองหน้าของหมวดลอตเตอรีปิดอยู่รอบนี้** (อยู่ใน src/pages-disabled/ ดู
// brand-spec §7) และหน้านี้มีโควตาเป็นปุ่มเดียวอยู่แล้ว จึงไม่ลิงก์ไปไหนเพิ่ม
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อธนาคาร ชื่อวอลเล็ต ชื่อค่ายเกม หน่วยงานกำกับ
// หรือใบอนุญาต แม้แต่รายเดียว** (พูดถึง "ธนาคารและทรูมันนี่" แบบรวมๆ เท่านั้น)
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 3 ขั้นตอน · 24ชม. **ไม่มี RTP
// ไม่มีจำนวนเกม/ค่าย ไม่มียอดขั้นต่ำเป็นตัวเลข ไม่มีอัตราจ่าย** ห้ามแต่งใบอนุญาต
// ตัวเลขการเงิน ปีก่อตั้ง หรือจำนวนสมาชิก
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตต์รอบนี้อยู่ใน brand-spec §2
// ⚠️⚠️ **รอบนี้กลับทิศจากรอบก่อนทั้งเว็บ: จากธีมมืด เป็นธีมสว่าง**
// bg.json = {"mode":"color","color":"#ffe5ff"} = **ชมพูพาสเทลสว่างมาก**
// (รอบก่อนเป็นดำอมแดง — ค่ามาจากไฟล์ ห้ามเดาว่าเท่าเดิม และห้าม "แก้" การ์ดให้มืด)
// การ์ด ContentBox จึงเป็นผิว #ffffff บนหมึกเข้ม #3b0b26 (= BRAND_TEXT)
// ปุ่มนี้เป็น **หลัก (primary)** ของพาเลต: ไล่เฉดชมพูเข้ม
// #c2185b -> #8e0f41 ขอบ #8e0f41 บนหมึก **ขาว #ffffff**
// (5.9 / 9.2:1 ต่อ stop — ค่าที่ตรวจคอนทราสต์มาแล้ว ห้ามแก้เอง)
// ส่วน /login เป็น **รอง (secondary)**: ไล่เฉดชมพูสด #fb8cc0 -> #fa539c บนหมึก
// พลัมเข้ม #3b0b26 จึงไม่ซ้ำกัน
// 🚨🚨 **ห้ามใช้ #fa539c เป็นพื้นถมของปุ่มนี้** — ขาวบน #fa539c ได้แค่ 3.2:1
// ตกเกณฑ์ #fa539c ใช้ได้เฉพาะเป็นพื้นถมที่ "ถือหมึกพลัมเข้ม" (5.3:1) หรือเป็น
// เส้น/ออรา · แผ่นไฮไลต์ด้านบนปุ่มจึงจำกัดที่ white/10 (ผสมแล้ว stop บนเหลือ
// ~5.0:1 ยังผ่าน AA) **ห้ามเพิ่มความทึบของแผ่นนี้**
// 🚨🚨 **#fa539c #fb8cc0 #ef8dbd #f7bcd9 #fdc6c3 ห้ามถือตัวอักษรเอง** เป็นพื้นถม/
// ขอบ/ออราเท่านั้น · ที่ถือตัวอักษรได้บนผิวสว่างชุดนี้คือ #3b0b26 (16.8:1) ·
// #7a4463 (7.4:1) · #c2185b (5.9:1) · #8e0f41 (9.2:1)
// ⚠️⚠️ **วัสดุของรอบนี้คือชมพูแคนดี้มันวาวบนพื้นสว่าง** อ่านจากอาร์ตเวิร์กตรงๆ:
// โลโก้เป็นลูกหมูการ์ตูนอ้วนกลมสีชมพูมีปีกนางฟ้าสีขาว คู่กับคำว่าแบรนด์ในตัวอักษร
// ไทยสามมิติทรงบับเบิลชมพูบานเย็นสลับขาวมุก มีหัวใจชมพูลอยประดับ
// ⚠️⚠️ **มีทรัพย์168 ก็เป็นแบรนด์หมูการ์ตูนชมพู แต่เป็นหมูสวมหน้ากากโจรบน
// แมเจนต้าเข้มพื้นมืด** — รอบนี้ห้ามมีหน้ากาก โจร หรือถุงเงิน และห้ามใช้ค่าสี
// ชุดนั้น (อยู่ใน brand-spec §2)
// ⚠️⚠️ **สีผม เสื้อผ้า พื้นสตูดิโอขาวของแบนเนอร์ และสีผิวนักแสดงเป็นวัตถุในภาพ
// ไม่ใช่สี UI** — พื้นเพจมาจาก bg.json เท่านั้น
// ⚠️ ปุ่มของ Navfoot อยู่บนแถบโครมคนละโซนกับปุ่มบนการ์ดนี้
// **ห้ามลอกคลาสของ Navfoot มาวางบนการ์ด**
// ออราในไฟล์นี้ใช้ rgba(250,83,156,α) · rgba(251,140,192,α) · rgba(194,24,91,α) ·
// rgba(59,11,38,α) เท่านั้น
//
// ⚠️⚠️ กับดักรอบนี้คือ **รอบนี้เป็นแบรนด์ชมพูจริง** "มีชมพูอยู่แล้ว" จึงไม่พิสูจน์ว่า
// เป็นค่าของรอบนี้ ให้เทียบเป็น "ค่า" ทีละหลักกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์
// ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive · **ชมพูของรอบนี้
// คือ #fa539c / #fb8cc0 / #c2185b / #8e0f41 / #ef8dbd / #f7bcd9 เท่านั้น**
// รอบนี้ **ไม่มีทอง ไม่มีเหลือง ไม่มีเงินเย็น ไม่มีน้ำเงิน/ฟ้า ไม่มีส้ม
// ไม่มีเขียว (ยกเว้น LINE green ที่หน้าอื่น) ไม่มีแดงเจล ไม่มีม่วง ไม่มีน้ำตาล
// ไม่มีครีม และไม่มีโรสโกลด์**
//
// Announcement หมุนมาเป็น Announcement4 ทั้งเว็บรอบนี้ (brand-spec §3 —
// รอบก่อนใช้ Announcement5 จึงหมุนออก) orchestrator ตั้ง default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare — ห้ามส่ง prop message
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) สตริงนี้ยาว 159
// ด้วยชื่อแบรนด์ 9 อักขระของรอบนี้ — เหลือพื้นที่แค่ 1 อักขระ ถ้ารอบหน้าชื่อยาวกว่า
// ต้องตัดข้อความส่วนที่ไม่ใช่ชื่อแบรนด์ลง ไม่ใช่ปล่อยผ่าน
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} เกมสล็อตแท้ เว็บตรงถูกลิขสิทธิ์ กดปุ่มเดียวไปยังขั้นตอนลงทะเบียน ควรตรวจสอบช่องทางจากเว็บไซต์ทางการ และไม่เปิดเผยรหัสผ่านหรือรหัส OTP`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} เกมสล็อตแท้ เว็บตรงถูกลิขสิทธิ์`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#8e0f41] bg-gradient-to-b from-[#c2185b] to-[#8e0f41] px-6 py-4 text-2xl font-black tracking-wide text-white shadow-[0_10px_30px_rgba(194,24,91,0.35)] transition-all duration-300 hover:scale-105 hover:border-[#fa539c] hover:shadow-[0_15px_40px_rgba(250,83,156,0.45)]">
        <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-white/10 to-transparent"></span>
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
