---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — this page is indexed and must not
// describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// This is the PRIMARY action of the pair, so it wears the solid crimson
// gradient (#c81e1e → #a51515 → #6d0d0d) under gold-light text (#f2dc9a);
// /login carries the antique-gold outline on the dark surface.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 153.
const pageDescription = "หน้าสมัครสมาชิก JOKERSLOTZ กดปุ่มเดียวเปิดยูสใหม่ด้วยตัวเองภายใน 1 นาที ด้วยระบบออโต้ 3 ขั้นตอน รองรับทุกธนาคารและ TrueMoney Wallet เข้าเล่นสล็อตได้ทันที";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก JOKERSLOTZ",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก JOKERSLOTZ เปิดยูสใหม่ด้วยตัวเอง 3 ขั้นตอน เสร็จใน 1 นาที" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก JOKERSLOTZ" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก JOKERSLOTZ"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#6d0d0d]/70 bg-gradient-to-r from-[#c81e1e] via-[#a51515] to-[#6d0d0d] px-6 py-4 text-lg font-black text-[#f2dc9a] shadow-[0_10px_30px_rgba(165,21,21,0.32)] transition-all duration-300 hover:scale-105 hover:border-[#d9b45e] hover:shadow-[0_15px_40px_rgba(165,21,21,0.48)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
