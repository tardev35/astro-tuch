---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// ⚠️ This page is NOT one of the "full custom HTML + own <style> block"
// standalone pages SKILL.md Phase 4.5 warns about — it renders through
// MainLayout + ContentBox like every other sub-page, so it has no
// .brand-identity string and no raw-hex <style> block of its own. The only
// brand colours here are the Tailwind arbitrary values on the button below.
// Do not "restore" a <style> block; the font link and the <html> colour come
// from MainLayout.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change.
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page (no `robots` prop = indexable), which means
// verify-build holds its description to the same 150–160 character window as
// every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) **ไม่มีส่วน SUB-PAGES** → title/description
// ของหน้านี้เขียนเอง และพูดได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 14: ควรตรวจสอบข้อกำหนด
// ด้านอายุ กฎหมายที่เกี่ยวข้อง และนโยบายความเป็นส่วนตัว · บรรทัด 16: ตรวจสอบที่อยู่
// เว็บไซต์ให้ถูกต้องและอ่านข้อกำหนดการเปิดบัญชี · บรรทัด 18: ไม่ควรเปิดเผยรหัสผ่าน
// และรหัส OTP ให้ใครทราบ)
// ⚠️ บรีฟรอบนี้ **มีหัวข้อสมัครสมาชิก 3 ขั้นตอนจริง แต่เป็นของ index.astro**
// (หัวข้อ H2 ที่ 6 ในเช็กลิสต์ brand-spec §4) **ไม่ใช่ของหน้านี้** — หน้านี้มีโควตา
// เป็น **ปุ่มเดียว** ห้ามแตกเป็นหัวข้อหรือรายการขั้นตอนบนหน้า
//
// 🚨 แกนของแบรนด์รอบนี้คือ **เว็บเกมคาสิโน/เดิมพันออนไลน์** (บาคาร่า สล็อต หวย
// บอล ไฮโล) — "หวย" เป็นชื่อหมวดเกมหนึ่งในห้าเท่านั้น ห้ามเขียนเนื้อหาเฉพาะทางหวย
// ⚠️ น้ำเสียงของบรีฟรอบนี้คือ "โฆษณาและกำกับในประโยคเดียวกัน" ไม่ใช่การันตี
// คลังคำที่ใช้ได้รอบนี้อยู่ใน .claude/brand-spec-zoro365.md §5 (ไม่พิมพ์ซ้ำที่นี่
// และ **ไม่พิมพ์คำของแบรนด์เก่าซ้ำที่นี่** เพื่อไม่ให้ sweep ของรอบถัดไปเจอ
// false positive ในคอมเมนต์ของไฟล์นี้เอง)
// ตัวเลขที่อ้างได้รอบนี้มีแค่ 0.3% · 0.8% · 3 ขั้นตอน · 24ชม. — ห้ามแต่ง
// ใบอนุญาต จำนวนสมาชิก ปีก่อตั้ง จำนวนค่าย/เกม หรือค่าร้อยละอื่นใด
// 🚨🚨 **บรีฟรอบนี้ไม่พูดถึงธนาคาร วอลเลท หรือการฝากถอนเลยแม้แต่คำเดียว** —
// ห้ามเขียนถึงรายการฝากถอน ชื่อวอลเล็ต หรือชื่อค่ายเกมบนหน้านี้
// (ค่าร้อยละสองค่าของโปรโมชั่นเป็นเนื้อหาของ index กับ /promotion ไม่ใช่ของหน้านี้)
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตรอบนี้อยู่ใน .claude/brand-spec-zoro365.md §2
// 🚨🚨 **กลับทิศ 180° จากรอบก่อน: รอบนี้มืดทั้งเว็บ ทั้งเนื้อหาและโครม**
// bg.json = {"mode":"color","color":"#002908"} = เขียวป่าจมเกือบดำ
// การ์ด ContentBox จึงเป็นผิวเข้ม #073c1a บนหมึกสว่าง #eef7f0 (= BRAND_TEXT,
// 12.0:1) — **ห้ามคืนการ์ดขาวของรอบก่อนกลับมาแม้แต่ใบเดียว**
// ปุ่มนี้เป็น **หลัก (primary)** ของพาเลต: ไล่เฉดเขียวป่า
// #0e5424 -> #1e7033 -> #23823a ขอบ #35a043 บนหมึก **ขาว #ffffff**
// (8.4 / 6.1 / 4.9:1 ต่อ stop — ค่าที่ตรวจคอนทราสต์มาแล้ว ห้ามแก้เอง)
// ส่วน /login เป็น **รอง (secondary)**: ไล่เฉด #0e5424 -> #073c1a บนหมึก #eef7f0
// จึงไม่ซ้ำกัน
// 🚨🚨 **ห้ามลากสต็อปของปุ่มนี้ขึ้นไปถึง #35a043 หรือ #3ddc4a** — ขาวบนสองค่านั้น
// ตกต่ำกว่า 4.5:1 สองค่านั้นสงวนไว้เป็นขอบ/ออรา/พื้นถม · แผ่นไฮไลต์ด้านบนปุ่ม
// จำกัดที่ white/10 (stop บนยังผ่าน AA) **ห้ามเพิ่มความทึบของแผ่นนี้**
// 🚨🚨 **#35a043 (3.8:1 บนการ์ด) กับ #1e7033 (2.1:1) ห้ามถือตัวอักษรเด็ดขาด**
// เป็นเส้น/ขอบ/ออรา/พื้นถมเท่านั้น · ที่ถือตัวอักษรบนผิวเข้มได้คือ #eef7f0
// (12.0:1) · #dfe6e3 (9.9:1) · #e8c86a (8.0:1) · #3ddc4a (6.9:1) · #9dc2a5 (6.3:1)
// ⚠️⚠️ **ภาษาภาพของรอบนี้คือซามูไร/คาทานะ/วงพู่กันหมึก/กิโมโน** โลโก้เป็น
// เวิร์ดมาร์กสามมิติ ครึ่งแรกตัวอักษรละตินผิวโครเมียมเงินขัดเงา ครึ่งหลังตัวเลข
// ผิวเขียวมรกตเคลือบเงาเรืองแสง — **ผิวเงินโครเมียม กอไผ่ และฉากห้องสว่าง
// เป็นวัตถุในภาพ ไม่ใช่สี UI** พื้นเพจมาจาก bg.json เท่านั้น
// ออราในไฟล์นี้ใช้ rgba(1,13,4,α) · rgba(61,220,74,α) เท่านั้น
//
// ⚠️⚠️ กับดักรอบนี้คือ **รอบก่อนก็เป็นแบรนด์เขียว + เงินโครเมียม + ทองอำพัน
// เหมือนกันเป๊ะ ต่างกันแค่กลับทิศสว่าง-มืด** "มีเขียวอยู่แล้ว" จึงไม่พิสูจน์ว่าเป็น
// ค่าของรอบนี้ ให้เทียบ **ทีละหลัก** กับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive
// **ผิว/หมึกของรอบนี้คือ #002908 / #010d04 / #031b09 / #073c1a / #0e5424 /
// #1e7033 / #23823a / #35a043 / #3ddc4a / #eef7f0 / #dfe6e3 / #e8c86a / #9dc2a5
// เท่านั้น** รอบนี้ **ไม่มีม่วง ไม่มีฟ้า/ไซแอน ไม่มีแมเจนต้า/ชมพู ไม่มีส้มเพลิง
// และไม่มีแดงเป็นสี UI** เลยสักเฉด · ปุ่ม LINE (#00B900) อยู่บน /about-us กับ
// /contact-us ไม่ใช่หน้านี้
//
// Announcement รอบนี้หมุนมาเป็นตัวท้ายชื่อเลข 3 ของตระกูล ทั้งเว็บ (brand-spec §3 —
// รอบก่อนใช้ตัวท้ายชื่อ Premium จึงหมุนออก · เขียนชื่อไฟล์แบบไม่มีเครื่องหมายคำพูด
// โดยตั้งใจ เพราะ tools/gen-tw-sources.mjs นับ literal ที่มีเครื่องหมายคำพูดว่าเป็น
// การ import จริง คอมเมนต์จึงทำให้ variant เก่าหลุดเข้า Tailwind scan แล้วสีของ
// แบรนด์ก่อนขึ้น stylesheet) orchestrator เป็นเจ้าของ default message ของไฟล์นั้น
// จึงเรียกแบบ bare — **ห้ามส่ง prop message**
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) สตริงนี้ยาว 155
// ด้วยชื่อแบรนด์ 7 อักขระของรอบนี้ ส่วนที่ไม่ใช่ชื่อแบรนด์ยาว 148 → รับชื่อแบรนด์
// ได้ 2–12 อักขระ ถ้ารอบหน้าชื่อยาวกว่านั้นต้องแก้ข้อความ ไม่ใช่ปล่อยผ่าน
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} เว็บเกมคาสิโนสายตรง กดปุ่มเดียวไปยังขั้นตอนลงทะเบียนของผู้ให้บริการ ควรตรวจสอบข้อกำหนดด้านอายุและนโยบายความเป็นส่วนตัวก่อนเปิดบัญชี`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/hx8w";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} เว็บเกมคาสิโนสายตรง ไม่มีขั้นต่ำ 3 ขั้นตอน`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#35a043] bg-gradient-to-b from-[#0e5424] via-[#1e7033] to-[#23823a] px-6 py-4 text-2xl font-black tracking-wide text-white shadow-[0_10px_30px_rgba(1,13,4,0.5)] transition-all duration-300 hover:scale-105 hover:border-[#3ddc4a] hover:shadow-[0_15px_40px_rgba(61,220,74,0.35)]">
        <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-white/10 to-transparent"></span>
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
