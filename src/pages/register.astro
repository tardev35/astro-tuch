---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect. The title and
// description below are written for exactly that reason.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// หวย365 (รอบแดงสด-ทอง 2026-10-02, brand-spec §2):
// ปุ่มนี้เป็นตัว PRIMARY ของคู่ จึงสวมไล่เฉดทองประจำแบรนด์เต็มใบ
// (#ffeab0 → #ffc93c → #c08a07) บนตัวอักษรหมึกเข้ม #1a0303 ซึ่งได้ 6.4:1 ที่ปลาย
// เข้มสุดของไล่เฉด — ห้ามให้ไล่เฉดจบเข้มกว่า #c08a07
// ส่วน /login รับแบบ outline — กรอบแดงลึก #9c0201 บนผิวการ์ด #240406 แทน
// สองลำดับ หนึ่งรูปแบบต่อหนึ่งปุ่ม ไม่ใช่ถมทองสองใบซึ่งจะอ่านเป็นปุ่มซ้ำกันสองปุ่ม
// ห้ามตัวอักษรขาวบนพื้นทอง และห้ามหมึกเข้มบนพื้นแดง พื้นแดงรับตัวอักษรขาวเท่านั้น
// ชุดของ หวยเฮง789 (#dc2224 #f4bc5d #ffefc2 #fbe3d4 #1c0606 #2b0909 #ab0204
// #e43434 #d99a10 #a8690c #5c0a0a rgba(244,188,93,*) rgba(220,34,36,*)
// rgba(11,2,2,*)) ออกครบแล้ว
//
// Announcement หมุนมาเป็น AnnouncementCyber ทั้งเว็บรอบนี้ (รอบก่อนเป็น
// Announcement2) — default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ index
// ก็เรียกแบบ bare
//
// หวย365 เป็นเว็บแทงหวยออนไลน์ ไม่ใช่บอลและไม่ใช่สล็อต — บรีฟระบุการสมัครผ่านมือถือ
// ได้เองด้วย 3 ขั้นตอน (เข้าหน้าสมัครและกรอกข้อมูลที่ระบบกำหนด → ยืนยันข้อมูลและ
// Login เข้าบัญชี → เลือกประเภทหวย รอบ และตัวเลขที่ต้องการ พร้อมตรวจสอบอัตราจ่าย
// ก่อนส่งโพย) แล้วใช้บัญชีเดียวติดตามแนวทางหวย สถิติหวยย้อนหลัง ผลหวย และรายการที่
// เปิดรับในแต่ละวัน ทั้งหวยรัฐบาลไทย หวยฮานอย หวยลาวพัฒนา และหวยหุ้นต่างประเทศ
// คำศัพท์ของแบรนด์ก่อนหน้า (เลขเด็ด เลขดัง ไม่จำกัด แทงได้ไม่อั้น ฮานอยปกติ/พิเศษ/
// วีไอพี ฝากถอนวอลเลท สล็อต ฟรีสปิน RTP บอล ค่าน้ำ อัตราต่อรอง ลีก คาสิโน บาคาร่า)
// ห้ามหลงเหลือ และห้ามเพิ่มชื่อธนาคาร ยอดฝากขั้นต่ำ ชื่อผู้ให้บริการจริง หรือเลข
// ใบอนุญาต — บรีฟรอบนี้ไม่ได้พูดเรื่องฝากถอน จึงห้ามยกของรอบก่อนมาใช้ซ้ำ
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 151
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} กดปุ่มเดียวเปิดบัญชีผ่านมือถือได้ใน 3 ขั้นตอน แล้วเข้าสู่ระบบเลือกประเภทหวย รอบ และตัวเลขที่ต้องการ พร้อมตรวจอัตราจ่ายก่อนส่งโพย`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} เปิดบัญชีเองผ่านเว็บ เริ่มแทงหวยไม่ต้องลงแอป`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#c08a07]/70 bg-gradient-to-r from-[#ffeab0] via-[#ffc93c] to-[#c08a07] px-6 py-4 text-lg font-black text-[#1a0303] shadow-[0_10px_30px_rgba(255,201,60,0.45)] transition-all duration-300 hover:scale-105 hover:border-[#ffeab0] hover:shadow-[0_15px_40px_rgba(255,201,60,0.35)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
