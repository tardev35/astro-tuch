---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. The page carries exactly ONE heading, and it is the
// level-one heading that ContentBox renders from its own `as` prop; there is no
// level-two and no level-three heading anywhere on it. Never write an article
// here and never add a second heading — verify-build fails the build the moment
// a second top-level heading appears on an indexable page.
// (The heading token is deliberately not spelled out in this comment: a source
// grep for it used to match the prose here as well as the real prop below, and
// every round someone had to re-derive which of the two matches was real.)
//
// ⚠️ This page is NOT one of the "full custom HTML + own <style> block"
// standalone pages SKILL.md Phase 4.5 warns about — it renders through
// MainLayout + ContentBox like every other sub-page, so it has no
// .brand-identity string and no raw-hex <style> block of its own. The only
// brand colours here are the Tailwind arbitrary values on the button below.
// Do not "restore" a <style> block; the font link and the <html> colour come
// from MainLayout.
// ⚠️ **ห้ามใช้ define:vars บนหน้านี้** — เดิมหน้านี้เป็น interstitial แบบ noindex
// จึงเคยได้รับการยกเว้น แต่ตอนนี้มันเป็นหน้าที่ index ได้ ข้อยกเว้นนั้นหมดไปแล้ว
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change.
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page (no `robots` prop = indexable), which means
// verify-build holds its description to the same 150–160 character window as
// every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) **ไม่มีส่วน SUB-PAGES** → title/description
// ของหน้านี้เขียนเอง และพูดได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 13: ไม่มีขั้นต่ำ
// 3 ขั้นตอน · บรรทัด 14: ควรตรวจสอบข้อกำหนดด้านอายุ กฎหมายที่เกี่ยวข้อง และ
// นโยบายความเป็นส่วนตัว · บรรทัด 16: ตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้องและอ่าน
// ข้อกำหนดการเปิดบัญชี · บรรทัด 18: ไม่ควรเปิดเผยรหัสผ่านและรหัส OTP ให้ใครทราบ)
// ⚠️ บรีฟรอบนี้ **มีหัวข้อสมัครสมาชิก 3 ขั้นตอนจริง แต่เป็นของ index.astro**
// (หัวข้อระดับสองที่ 6 ในเช็กลิสต์ brand-spec §4) **ไม่ใช่ของหน้านี้** — หน้านี้มี
// โควตาเป็น **ปุ่มเดียว** ห้ามแตกเป็นหัวข้อหรือรายการขั้นตอนบนหน้า
//
// 🚨 แกนของแบรนด์รอบนี้คือ **เว็บเกมคาสิโน/เดิมพันออนไลน์** บรีฟระบุ **เจ็ดหมวดเกม**
// (บาคาร่า · สล็อตออนไลน์ · ไฮโล · รูเล็ต · ยิงปลา · เดิมพันฟุตบอล · หวยออนไลน์)
// — "หวย" เป็นชื่อหมวดเกมหนึ่งในเจ็ดเท่านั้น ห้ามเขียนเนื้อหาเฉพาะทางหวย
// ⚠️ น้ำเสียงของบรีฟรอบนี้คือ "โฆษณาและกำกับในประโยคเดียวกัน" ไม่ใช่การันตี
// คลังคำที่ใช้ได้รอบนี้อยู่ใน .claude/brand-spec-123bet.md §5 (ไม่พิมพ์ซ้ำที่นี่
// และ **ไม่พิมพ์คำของแบรนด์เก่าซ้ำที่นี่** เพื่อไม่ให้ sweep ของรอบถัดไปเจอ
// false positive ในคอมเมนต์ของไฟล์นี้เอง)
// 🚨 สามคำที่ **กลับทิศจากรอบก่อน** และเป็นถ้อยคำของบรีฟรอบนี้เอง:
// **เว็บตรง · ถูกลิขสิทธิ์ · ปลอดภัยในไทย** — ห้ามลบออกเพราะอ่านคอมเมนต์เก่า
// ในไฟล์ inventory แล้วเข้าใจผิดว่าเป็นคำของแบรนด์เก่า
// ตัวเลขที่อ้างได้รอบนี้มีแค่ 0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง — ห้ามแต่ง
// ใบอนุญาต จำนวนสมาชิก ปีก่อตั้ง จำนวนค่าย/เกม หรือค่าร้อยละอื่นใด
// 🚨🚨 **บรีฟรอบนี้ไม่มีหมวดธุรกรรมการเงิน/สถาบันการเงิน/กระเป๋าเงินอิเล็กทรอนิกส์เลยสักคำ** —
// ห้ามเขียนถึงรายการเหล่านั้น ชื่อผู้ให้บริการกระเป๋าเงิน หรือชื่อค่ายเกมบนหน้านี้
// (ค่าร้อยละสองค่าของโปรโมชั่นเป็นเนื้อหาของ index กับ /promotion ไม่ใช่ของหน้านี้)
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตรอบนี้อยู่ใน .claude/brand-spec-123bet.md §2
// 🚨🚨 **กลับทิศ 180° จากรอบก่อน: รอบนี้ "เนื้อหาสว่าง + โครมเข้ม"**
// bg.json = {"mode":"color","color":"#f7e4e9"} = ชมพูบลัชจาง
// การ์ด ContentBox จึงเป็น **ผิวสว่าง fdf5f6 บนหมึกเข้ม 36080f** (= BRAND_TEXT,
// 16.3:1) — **ห้ามคืนการ์ดเข้มของรอบก่อนกลับมาแม้แต่ใบเดียว**
// ปุ่มนี้เป็น **CTA หลัก** ของพาเลตแบบสามสต็อปเต็ม ไล่ **เข้มลงสว่าง**
// from 8a1420 → via a30d1a → to c21325 บนหมึก **ขาว ffffff**
// (9.5 / 8.0 / 6.2:1 ต่อ stop — ค่าที่ตรวจคอนทราสต์มาแล้ว ห้ามแก้เอง)
// ส่วน /login ใช้สองสต็อปและไล่ **สว่างลงเข้ม** (a30d1a → 8a1420) จึงไม่ซ้ำกัน
// 🚨🚨 **ห้ามลากปลายเฉดสว่างกว่า c21325** — ขาวบนค่าที่สว่างกว่านั้นตกต่ำกว่า 4.5:1
// ⚠️ แผ่นไฮไลต์ด้านบนปุ่มจำกัดที่ white/10 และ **วางอยู่บนสต็อปเข้มสุด (8a1420,
// 9.5:1)** โดยตั้งใจ — ถ้าสลับทิศเฉดต้องย้ายแผ่นนี้ตามด้วย **ห้ามเพิ่มความทึบ**
// 🚨🚨 **eec3cc (1.5:1) · d98fa0 (2.3:1) · ef4a5e ห้ามถือตัวอักษรทุกบริบท** —
// เป็นเส้น/ขอบ/ออรา/พื้นถมเท่านั้น (ขอบปุ่มนี้คือทองอำพัน dca53a ซึ่งเป็น "ขอบ")
// ⚠️ ปุ่มนี้อยู่บนการ์ด **ผิวสว่าง** ขอบทองกับเงาคือสิ่งที่แยกปุ่มออกจากการ์ด
// ห้ามถอดออก
// ⚠️⚠️ **ภาษาภาพของรอบนี้คือราชสำนัก/โถงวังหินอ่อนงาช้าง/มงกุฎอัญมณีแดง/
// ชิปคาสิโนแดง-ขาว/ไพ่เอซ** โลโก้เป็นเวิร์ดมาร์กสามมิติ ครึ่งแรกเป็นตัวเลขผิว
// แดงชาดเคลือบเงาตัดขอบทอง ครึ่งหลังเป็นตัวอักษรละตินผิวโครเมียมเงินขัดเงา —
// **ผนังหินอ่อนงาช้างและสีผิวนางแบบเป็นวัตถุในภาพ ไม่ใช่สี UI**
// พื้นเพจมาจาก bg.json เท่านั้น
// ออราในไฟล์นี้ใช้ rgba(54,8,15,α) · rgba(220,165,58,α) เท่านั้น
//
// ⚠️⚠️ กับดักรอบนี้คือ **สเปกของสามรอบก่อนเขียนไว้ว่า "รอบนี้ไม่มีแดงเป็นสี UI
// เลยสักเฉด" — รอบนี้กลับทิศเต็มๆ แดงชาดคือฮิวนำของแบรนด์** และ **LOTTO189
// ก็เป็นแบรนด์ แดง/ทอง/ขาวชมพู ตระกูลเดียวกันเป๊ะ** → "เจอแดงอยู่แล้ว" จึงไม่
// พิสูจน์ว่าเป็นค่าของรอบนี้ ต้องเทียบ **ทีละหลัก** กับตารางใน brand-spec §2
// ซึ่งไม่พิมพ์ซ้ำที่นี่เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive
// **ผิว/หมึกของรอบนี้คือ f7e4e9 / fdf5f6 / f7dfe4 / eec3cc / d98fa0 / 330710 /
// 1c050b / 4d0c18 / 36080f / 6b2b33 / a30d1a / 7a4a0c / 8a1420 / c21325 /
// dca53a / d2d7dd / ef4a5e เท่านั้น**
// รอบนี้ **ไม่มีม่วง ไม่มีฟ้า/ไซแอน ไม่มีแมเจนต้า/ชมพูจัด และไม่มีเขียวเป็นสี UI**
// เลยสักเฉด · ปุ่ม LINE (00B900) อยู่บน /about-us กับ /contact-us ไม่ใช่หน้านี้
// (เขียนเฮกซ์แบบถอด # และถอดวงเล็บโดยตั้งใจ — tools/gen-tw-sources.mjs สแกนไฟล์นี้
// แบบ plain text รวมคอมเมนต์ คลาสสีเต็มรูปในคอมเมนต์จะถูก generate ลง stylesheet จริง)
//
// Announcement รอบนี้หมุนมาเป็นตัวท้ายชื่อเลข 5 ของตระกูล ทั้งเว็บ (brand-spec §3 —
// รอบก่อนใช้ตัวท้ายชื่อเลข 3 จึงหมุนออก · เขียนชื่อไฟล์แบบไม่มีเครื่องหมายคำพูด
// โดยตั้งใจ เพราะ tools/gen-tw-sources.mjs นับ literal ที่มีเครื่องหมายคำพูดว่าเป็น
// การ import จริง คอมเมนต์จึงทำให้ variant เก่าหลุดเข้า Tailwind scan แล้วสีของ
// แบรนด์ก่อนขึ้น stylesheet) orchestrator เป็นเจ้าของ default message ของไฟล์นั้น
// จึงเรียกแบบ bare — **ห้ามส่ง prop message**
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) สตริงนี้ยาว 156
// ด้วยชื่อแบรนด์ 6 อักขระของรอบนี้ ส่วนที่ไม่ใช่ชื่อแบรนด์ยาว 150 → รับชื่อแบรนด์
// ได้ 1–10 อักขระ ถ้ารอบหน้าชื่อยาวกว่านั้นต้องแก้ข้อความ ไม่ใช่ปล่อยผ่าน
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} เว็บตรง ถูกลิขสิทธิ์ ไม่มีขั้นต่ำ 3 ขั้นตอน กดปุ่มเดียวไปยังหน้าลงทะเบียน ควรตรวจสอบข้อกำหนดด้านอายุและนโยบายความเป็นส่วนตัวก่อนสมัคร`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/hx8w";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} เว็บตรง ถูกลิขสิทธิ์ ไม่มีขั้นต่ำ 3 ขั้นตอน`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#dca53a] bg-gradient-to-b from-[#8a1420] via-[#a30d1a] to-[#c21325] px-6 py-4 text-2xl font-black tracking-wide text-white shadow-[0_10px_30px_rgba(54,8,15,0.25)] transition-all duration-300 hover:scale-105 hover:border-[#d98fa0] hover:shadow-[0_15px_40px_rgba(220,165,58,0.38)]">
        <span aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-white/10 to-transparent"></span>
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
