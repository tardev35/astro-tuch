---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1x1, h2x0, h3x0. Never write an article here and never add a second heading.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change.
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens — the visitor has to press the
// button now. It is an indexed page, which means verify-build holds its
// description to the same 150–160 character window as every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES — คอปปี้ของหน้านี้จึงพูด
// ได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 10–13: คืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อน
// โบนัส 0.8% ไม่จำกัด) ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า หน้านี้มีโควตาเป็นปุ่มเดียว
//
// ⚠️ แบรนด์รอบนี้เป็น **คาสิโน + กีฬา** (บาคาร่า · ไฮโล · บอล · สล็อต) ไม่ใช่
// เว็บสล็อตล้วน ไม่ใช่เว็บกีฬาล้วน และไม่ใช่เว็บหมวดลอตเตอรี คำที่ห้ามหลุดกลับมาอยู่
// ใน brand-spec §7 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำต้องห้ามเจอ false positive
// ⚠️ ตัวเลขที่บรีฟให้และอ้างได้มีแค่ 0.3% · 0.8% · 24 ชั่วโมง — ห้ามแต่งใบอนุญาต
// หน่วยงานกำกับ ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP ยอดขั้นต่ำ จำนวนสมาชิก หรือปีใดๆ
// (บรีฟรอบนี้ไม่ได้เอ่ยปีไว้เลย) — หัวข้อระบบฝากถอนกับแอดมิน 24 ชั่วโมงของบรีฟ
// (บรรทัด 14–19) เป็นของ index.astro ไม่ใช่ของหน้านี้ ห้ามยกมาเขียนซ้ำที่นี่
//
// แบรนด์รอบนี้ (TKB55, รอบแดงเลือดนก-เงินโครเมียมบนดำสนิท 2026-10-13,
// brand-spec §2): **สองโทนจริง: แดงเลือดนกนำ เงินโครเมียมรอง** ไม่มีทองในดรอปนี้
// แดงแบรนด์ #fb131b · แดงลึก #c40304 #8a0206 #53050a ·
// ตัวที่ถือตัวอักษรได้: เงินโครเมียม #e9eef4 (15.2:1) #aeb9c6 (8.9:1) ·
// แดงอ่อนไฮไลต์ #ff8a8f (7.8:1) · แดงสว่าง #ff4d55 (5.6:1) ·
// เนื้อความ #f2e4e5 (= BRAND_TEXT) · หมึกบนพื้นสว่าง/พื้นถมแดง #1a0304
// ชั้นผิว: ยก #2a0d0f (= การ์ด ContentBox) / กลาง #1a0708 / จม #0d0304 /
// พื้นเพจ #000000 — รอบนี้ bg.json เป็นดำสนิท
// ปุ่มนี้เป็น PRIMARY: ถมพื้นแดงไล่เฉด #ff8a8f → #fb131b ขอบ #c40304
// บนหมึกเข้ม #1a0304 (8.7:1 บนปลายสว่าง #ff8a8f · 4.9:1 บนปลายเข้มสุด #fb131b)
// ⚠️ ห้ามกลับด้าน: พื้นถมแดงต้องใช้หมึกเข้มเสมอ ห้ามขาวหรือครีม และไล่เฉดต้อง
// **หยุดที่ #fb131b** ห้ามไล่เข้มกว่านั้นใต้ตัวอักษร — #c40304 อยู่ได้เฉพาะเป็น
// เส้นขอบของปุ่มนี้ (บนหมึก #1a0304 ได้แค่ 2.6:1)
// — ส่วน /login เป็น SECONDARY ชั้นจมขอบแดง จึงไม่ซ้ำกัน · #fb131b #c40304
// #8a0206 #53050a ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่เส้นขอบ ออรา พื้นถม
// และเงา — ออราในไฟล์นี้ใช้ rgba(251,19,27,α) เท่านั้น นอกจากเงาดำล้วน
// ⚠️ กับดักรอบนี้คือ **แดง**: โค้ดเบสนี้เคยมีแบรนด์แดงมาแล้วหลายเจ้า
// "มีแดงอยู่แล้ว" จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้ ให้เทียบเป็น "ค่า" ทีละตัวกับ
// ตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ
// false positive — ชุดน้ำเงินไฟฟ้า-เงินโครเมียมของแบรนด์ก่อนออกครบทุกจุดในไฟล์นี้แล้ว
// และรอบนี้ **ไม่มีทอง ไม่มีม่วง ไม่มีชมพู ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว
// ไม่มีส้ม**
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ (brand-spec §3 — รอบก่อน
// TSDET911 ใช้ Announcement3 จึงหมุนออก) orchestrator ตั้ง default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare — ห้ามส่ง prop message
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) หน้านี้ยาว 153
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} กดปุ่มเดียวไปยังทางเข้าเดิมพันหลักของเว็บคาสิโนไทยเซิร์ฟต่างประเทศ พร้อมโปรโมชั่นคืนยอดเสีย 0.3% และแนะนำเพื่อน โบนัส 0.8% ไม่จำกัด`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/2u19";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} เว็บคาสิโนไทย สมัครจากทางเข้าเดิมพันหลัก`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#c40304] bg-gradient-to-b from-[#ff8a8f] to-[#fb131b] px-6 py-4 text-2xl font-black tracking-wide text-[#1a0304] shadow-[0_10px_30px_rgba(251,19,27,0.4)] transition-all duration-300 hover:scale-105 hover:border-[#1a0304] hover:shadow-[0_15px_40px_rgba(251,19,27,0.6)]">
        <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ff8a8f]/70 to-transparent"></div>
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
