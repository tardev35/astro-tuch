---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose.
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char).
const pageDescription =
  "หน้าสมัครสมาชิก DARK168 เว็บดาร์คสล็อตค่ายหลักเว็บตรง สำหรับผู้เปิดบัญชีใหม่ รับโบนัสแนะนำเพื่อน 0.8% และคืนยอดเสียทุกวัน 0.3% ฝากถอนอัตโนมัติ ไม่ล็อคยูส";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก DARK168 เปิดบัญชีใหม่",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/5n82";
---

<MainLayout title="สมัครสมาชิก DARK168 เปิดบัญชีใหม่ เริ่มเล่นดาร์คสล็อตค่ายหลักได้ทันที 24 ชั่วโมง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก DARK168" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก DARK168"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f6dfa4]/70 bg-gradient-to-r from-[#c8cfd8] via-[#f6dfa4] to-[#e6b74e] px-6 py-4 text-lg font-black text-[#131009] shadow-[0_10px_30px_rgba(230,183,78,0.25)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(230,183,78,0.35)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
