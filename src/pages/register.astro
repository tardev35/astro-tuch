---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect. The title and
// description below are written for exactly that reason.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// NATO168 (รอบทอง-เงิน-ดำ 2026-10-02, brand-spec §2 — สองโทนจริง: NATO เป็นเงิน
// เมทัลลิก ส่วน 168 กับวงกลมตัว N เป็นทอง):
// ปุ่มนี้เป็นตัว PRIMARY ของคู่ จึงสวมไล่เฉดทองประจำแบรนด์เต็มใบ
// (#fde8a8 → #edb543 → #a9761f) บนตัวอักษรหมึกเข้ม #1a1203 ซึ่งได้ 4.7:1 ที่ปลาย
// เข้มสุดของไล่เฉดและเป็นตัวหนาขนาดใหญ่ — ห้ามให้ไล่เฉดจบเข้มกว่า #a9761f
// ส่วน /login ถือ "เงิน" ซึ่งเป็นแอ็กเซนต์รองของแบรนด์ (กรอบ+ตัวอักษร #e6e6e6 บน
// ผิวอุ่น #17120a) สองลำดับ หนึ่งรูปแบบต่อหนึ่งปุ่ม ไม่ใช่ถมทองสองใบซึ่งจะอ่านเป็น
// ปุ่มซ้ำกันสองปุ่มและทำให้ฮิวที่สองของแบรนด์หายไป
// ห้ามตัวอักษรสีอ่อนบนพื้นทอง (brand-spec §2)
// ชุดทองล้วนของ NAZA99 (#fdf2ac #e4b34d #c08f2b #8a5f12 #140c02 #241404 #0a0501
// #1a1000 #f3e8cf rgba(228,179,77,*) rgba(253,242,172,*) rgba(10,5,1,*)) ออกครบแล้ว
//
// Announcement หมุนมาเป็น Announcement5 ทั้งเว็บรอบนี้ (รอบก่อนเป็น
// AnnouncementPremium) — default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ
// index ก็เรียกแบบ bare จึงห้ามส่ง prop message
//
// NATO168 เป็นเว็บสล็อตออนไลน์ / พีจีเว็บตรง ไม่ใช่หวยและไม่ใช่บอล — บรีฟระบุการสมัคร
// ผ่านมือถือได้เองด้วย 3 ขั้นตอน (เข้าหน้าสมัครและกรอกข้อมูลที่ระบบกำหนด → ยืนยัน
// ข้อมูลและ Login เข้าสู่บัญชี → เลือกเกมสล็อตหรือค่ายที่ต้องการ พร้อมตรวจสอบโบนัส
// และรายละเอียดเกมก่อนเริ่มเล่น) แล้วใช้บัญชีเดียวค้นหาเกมพีจี เกมใหม่ โปรโมชั่น
// และประวัติรายการ
// บรีฟรอบนี้ไม่ได้เอ่ยชื่อเกมใดเลย จึงห้ามยกชื่อเกมของรอบก่อน (Mahjong Ways 2 /
// Fortune Tiger / Sweet Bonanza) กลับมา
// คำศัพท์ของแบรนด์ก่อนหน้า (หวย โพย ส่งโพย งวด เลขเด็ด อัตราจ่าย ฮานอย ลาว หุ้น
// บอล ค่าน้ำ ลีก คาสิโนสด บาคาร่า) ห้ามหลงเหลือ และห้ามเพิ่มชื่อธนาคาร ยอดฝากขั้นต่ำ
// ชื่อผู้ให้บริการจริง หรือเลขใบอนุญาต — บรีฟรอบนี้ไม่ได้พูดเรื่องฝากถอน จึงห้ามยก
// ของรอบก่อนมาใช้ซ้ำ
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 155
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} กดปุ่มเดียวเปิดบัญชีผ่านมือถือได้ใน 3 ขั้นตอน แล้ว Login เลือกสล็อตพีจีและค่ายที่ต้องการ พร้อมตรวจสอบโบนัสและโปรโมชั่นก่อนเริ่มเล่น`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} เปิดบัญชีเองผ่านเว็บ 3 ขั้นตอน เริ่มเล่นสล็อตได้เลย`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#a9761f] bg-gradient-to-r from-[#fde8a8] via-[#edb543] to-[#a9761f] px-6 py-4 text-lg font-black text-[#1a1203] shadow-[0_10px_30px_rgba(237,181,67,0.45)] transition-all duration-300 hover:scale-105 hover:border-[#fde8a8] hover:shadow-[0_15px_40px_rgba(252,220,115,0.45)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
