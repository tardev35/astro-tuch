---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. The hop to the operator
// happens on CLICK, not on page load — this page is indexed and must not
// describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor.
// This is the PRIMARY action of the pair on the WY88 palette, so it wears the
// full gold-gradient fill of the logo's "88" (#fced94 → #e8b33a → #c3832b)
// under the palette's near-black plum ink (#170411); /login carries the other
// brand hue, magenta, as an outline on the dark surface instead. Two hues, one
// per tier — the same pairing the logo itself uses.
//
// Announcement รอบนี้หมุนมาใช้ Announcement5 ทั้งเว็บ — default message ของไฟล์นั้น
// เป็นคอปปี้ของแบรนด์นี้อยู่แล้วและ index ก็เรียกแบบ bare จึงห้ามส่ง prop
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 153
const pageDescription = "หน้าสมัครสมาชิก WY88 กดปุ่มเดียวเปิดบัญชีใหม่ได้ด้วยตัวเอง กรอกข้อมูล ตรวจสอบความถูกต้อง แล้วยืนยัน จากนั้นเข้าสู่ระบบเลือกเกมสดหรือสล็อตแบบ VIP ได้ทันที";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก WY88",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="สมัครสมาชิก WY88 เปิดบัญชีใหม่ใน 3 ขั้นตอน เล่นได้ครบในบัญชีเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก WY88" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก WY88"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fced94] bg-gradient-to-r from-[#fced94] via-[#e8b33a] to-[#c3832b] px-6 py-4 text-lg font-black text-[#170411] shadow-[0_10px_30px_rgba(232,179,58,0.45)] transition-all duration-300 hover:scale-105 hover:border-[#fced94] hover:shadow-[0_15px_40px_rgba(252,237,148,0.5)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
