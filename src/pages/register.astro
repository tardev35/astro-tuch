---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement4.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article — the cta toggle turned the old noindex
// interstitial into a real indexable page whose only content is one button to
// the same destination. One <h1> from the ContentBox title plus one button:
// h1×1, h2×0, h3×0. Never write an article here and never add an <h2>.
//
// targetUrl is this brand's affiliate link, carried over from the interstitial
// it replaced. **Do not edit it**, and keep rel="nofollow sponsored" plus
// data-cta-redirect on the anchor — data-cta-redirect is what CtaRedirect's
// script binds to, so the loading animation fires on the click instead of on
// page load. Only the button's colours are ours to change.
//
// The copy is rewritten every round rather than patched: the page used to be a
// noindex interstitial, so any inherited title/description still promises an
// automatic forward that no longer happens. It is an indexed page now, which
// means verify-build holds its description to the same 150–160 character window
// as every other page.
//
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES — คอปปี้ของหน้านี้จึงพูด
// ได้แค่สิ่งที่บรีฟมีจริง (บรรทัด 14–18: สมัคร 3 ขั้นตอน · บรรทัด 10–13: คืนยอดเสีย
// 0.3% และแนะนำเพื่อน 0.8%) ห้ามแตกเป็นหัวข้อหรือรายการบนหน้า หน้านี้มีโควตา
// เป็นปุ่มเดียว
//
// FAH999 (รอบชมพูฮ็อต-ทอง 2026-10-11, brand-spec §2):
// ชมพูแบรนด์ #ff3fa4 (ฮิวหลัก) · ชมพูไฮไลต์ #ff6cbb · ชมพูซีด #ffd1ea ·
// ชมพูลึก #b3006a (รูปทรง/ขอบ/ออราเท่านั้น) · ทอง #f5c53d (ฮิวที่สอง) ·
// เนื้อความ #fde8f3 (= BRAND_TEXT) · หมึกเข้ม #2b0019
// ชั้นผิว: ยก #4a0b42 (= การ์ด ContentBox) / กลาง #3a0534 / พื้นเพจ #2e002c /
// ลึก #210220
// ปุ่มนี้เป็น PRIMARY เดียวกับ /ทางเข้า: ถมชมพูไล่เฉด #ffd1ea → #ff6cbb → #ff3fa4
// ขอบ #b3006a บนหมึกเข้ม #2b0019 (ปลายเข้มสุด #ff3fa4 ได้ 5.8:1)
// ⚠️ ห้ามกลับด้าน: พื้นถมชมพูต้องใช้หมึกเข้มเสมอ ห้ามครีมหรือขาว และห้ามไล่เฉด
// ลงไปถึง #b3006a ใต้ตัวอักษร (หมึก #2b0019 บน #b3006a ได้แค่ 2.8:1 ตกเกณฑ์)
// ปลายเข้มของไล่เฉดที่รองตัวอักษรจึงหยุดที่ #ff3fa4
// — ส่วน /login เป็น SECONDARY ชั้นลึก จึงไม่ซ้ำกัน · #b3006a #7a0046 #4d002b
// #9c6f08 ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่เส้นขอบ ออรา และเงา — ออราใช้
// rgba(255,63,164,α) เท่านั้นในไฟล์นี้ นอกจากเงาดำล้วน
// ⚠️ แบรนด์ก่อนๆ ก็เคยมีแบรนด์ชมพูมาแล้ว "มีชมพูอยู่แล้ว" ไม่ได้แปลว่าถูกค่า
// ให้เทียบเป็นตัวๆ กับตารางแบนใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้
// grep หาสีของแบรนด์เก่าเจอ false positive — ชุดทอง-ส้มอำพันของรอบก่อนออกครบแล้ว
//
// Announcement หมุนมาเป็น Announcement4 ทั้งเว็บรอบนี้ (รอบก่อนใช้ Announcement6 —
// brand-spec §3 หมุนออก) และเรียกแบบ bare ทุกหน้า — ห้ามส่ง prop message จากหน้านี้
//
// แบรนด์นี้เป็น **ฟาสล็อตเว็บตรง** ล้วนๆ — รายการคำต้องห้ามเต็มอยู่ใน
// brand-spec §7 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep เจอ false positive
// ⚠️ ตัวเลขที่บรีฟให้และใช้ได้มีแค่ 0.3% / 0.8% / 3 ขั้นตอน / 24 ชั่วโมง
//
// 150–160 CODE POINTS (นับด้วย [...s].length เหมือน verify-build.mjs ห้ามใช้
// wc -m — git-bash กล่องนี้นับเป็นไบต์ = เกินจริงราว 3 เท่า) หน้านี้ยาว 156
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = `หน้าสมัครสมาชิก ${BRAND_NAME} ฟาสล็อตเว็บตรง กดปุ่มเดียวไปยังทางเข้าหลักของเว็บไซต์ สมัคร 3 ขั้นตอน พร้อมโปรโมชั่นคืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อน 0.8%`;

const graph = pageGraph(Astro, {
  name: `สมัครสมาชิก ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title={`สมัครสมาชิก ${BRAND_NAME} ฟาสล็อตเว็บตรง สมัครง่ายๆ 3 ขั้นตอน`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME}`} as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#b3006a] bg-gradient-to-b from-[#ffd1ea] via-[#ff6cbb] to-[#ff3fa4] px-6 py-4 text-2xl font-black tracking-wide text-[#2b0019] shadow-[0_10px_30px_rgba(255,63,164,0.4)] transition-all duration-300 hover:scale-105 hover:border-[#2b0019] hover:shadow-[0_15px_40px_rgba(255,63,164,0.6)]">
        <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-[#ffd1ea]/60 to-transparent"></div>
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
