---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import CtaRedirect from "../components/CtaRedirect.astro";

// Button page, not an article: one heading from the ContentBox title and one
// button. No section headings, no explanatory prose. Inventory: h1x1, h2x0, h3x0.
// The hop to the operator happens on CLICK, not on page load — this page is
// indexed and must not describe itself as an automatic redirect.
// targetUrl is this brand's affiliate link — never edit it, and keep
// rel="nofollow sponsored" on the anchor. data-cta-redirect is what
// CtaRedirect's script binds to; leave the attribute in place.
//
// SEXYGAME666 (รอบชมพูนีออน-ม่วง-ดำ 2026-09-28): ปุ่มนี้เป็นตัว PRIMARY ของคู่
// จึงสวมไล่เฉดประจำแบรนด์เต็มใบ (#ffb3e2 → #fa42b5 → #c9a4ff ชมพูไหลไปม่วงตาม
// ลำดับตัวอักษรในโลโก้) บนตัวอักษรหมึกเข้ม #12041c เพราะตัวหนังสือบนพื้นชมพูสว่าง
// ต้องเป็นสีเข้มจึงจะอ่านออก ห้ามใช้ขาว — ปลายไล่เฉดจงใจหยุดที่ม่วงอ่อน #c9a4ff
// ไม่ใช่ม่วงเข้ม #8b3df3 เพราะหมึกเข้มบนม่วงเข้มเหลือคอนทราสต์แค่ ~3.5:1 ส่วนบน
// ม่วงอ่อนได้ ~9:1 ส่วน /login รับฝั่ง "GAME" ของโลโก้ที่เป็นม่วง — ขอบม่วง
// #8b3df3 บนผิวยก #140722 แทน สองลำดับ หนึ่งสีต่อหนึ่งปุ่ม ไม่ใช่ชมพูสองใบซึ่งจะ
// อ่านเป็นปุ่มซ้ำกันสองปุ่ม
// ชุดทอง+เขียวของแบรนด์ก่อนหน้า (#fde90e #fff89a #f5c518 #35d413 #5df53a #10160a
// #0b1408 #101a0b #e9f0dd #fbffe8 rgba(253,233,14,*) rgba(53,212,19,*)) ออกครบ
// แล้ว ห้ามนำกลับมา
//
// Announcement หมุนจาก Announcement2 มาเป็น Announcement5 ทั้งเว็บรอบนี้ —
// default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว และ index ก็เรียกแบบ bare
//
// SEXYGAME666 เป็นแบรนด์เกมเซ็กซี่บาคาร่า/คาสิโนไลฟ์สด — บรีฟระบุการสมัครเอง
// ผ่านหน้าเว็บไซต์ได้ 3 ขั้นตอน (กรอกข้อมูล → ตรวจสอบความถูกต้อง → ยืนยันบัญชี
// แล้วเข้าสู่ระบบ) คำศัพท์เฉพาะหมวดของแบรนด์ก่อนหน้า (สล็อต ค่ายสล็อตย่อย หวย)
// รวมถึง API/ใบอนุญาต/ชื่อค่าย/ชื่อโต๊ะ/ธนาคาร/ฝากถอนออโต้/เครดิตฟรี/อัตราจ่าย
// ห้ามหลงเหลือในหน้านี้
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). หน้านี้ยาว 155
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ตัวนับจะเห็นเป็น 5 อักขระ
const pageDescription = "สมัครสมาชิก SEXYGAME666 กดปุ่มเดียวเปิดบัญชีด้วยตัวเองใน 3 ขั้นตอน กรอกข้อมูล ตรวจสอบความถูกต้อง แล้วยืนยันเข้าสู่ระบบเพื่อเลือกโต๊ะบาคาร่าไลฟ์สดได้ทั้งวัน";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก SEXYGAME666",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/l360";
---

<MainLayout title="สมัครสมาชิก SEXYGAME666 เปิดบัญชีเองได้ใน 3 ขั้นตอน เล่นจากบัญชีเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก SEXYGAME666" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก SEXYGAME666"
        class="group relative isolate mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fa42b5] bg-gradient-to-r from-[#ffb3e2] via-[#fa42b5] to-[#c9a4ff] px-6 py-4 text-lg font-black text-[#12041c] shadow-[0_10px_30px_rgba(250,66,181,0.50)] transition-all duration-300 hover:scale-105 hover:border-[#c9a4ff] hover:shadow-[0_15px_40px_rgba(139,61,243,0.30)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
