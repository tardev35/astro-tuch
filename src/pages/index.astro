---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement4.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LatestWinnersCyber from "../components/LatestWinnersCyber.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

const pageTitle = "FIN8888 แบรนด์เกมสล็อต เข้าเล่นผ่านมือถือและเว็บเบราว์เซอร์";

const pageDescription =
  "FIN8888 แบรนด์เกมสล็อตออนไลน์ เข้าเล่นง่ายผ่านมือถือและเว็บเบราว์เซอร์ รองรับทุกเครือข่าย พร้อมโปรโมชั่นแนะนำเพื่อน 0.8% คืนยอดเสีย 0.3% และโบนัสสมาชิกใหม่";

const onboardingSteps = [
  {
    icon: "📝",
    title: "สมัครสมาชิก",
    description: "กรอกข้อมูลตามที่ระบบกำหนดผ่านมือถือหรือคอมพิวเตอร์ ใช้เวลาไม่กี่นาทีก็พร้อมยืนยันบัญชี",
    accent: "gold" as const,
  },
  {
    icon: "💳",
    title: "ยืนยันบัญชีและฝากครั้งแรก",
    description: "ยืนยันบัญชีให้เรียบร้อยแล้วฝากเงินครั้งแรกเพื่อรับโบนัสสมาชิกใหม่ตามเงื่อนไขของโปรโมชั่น",
    accent: "blue" as const,
  },
  {
    icon: "🎮",
    title: "เลือกเกมและเริ่มเล่น",
    description: "เลือกเกมสล็อตที่ต้องการผ่านมือถือหรือคอมพิวเตอร์ได้ทันทีหลังฝากเครดิตสำเร็จ",
    accent: "gold" as const,
  },
];

const faqs = [
  {
    q: "FIN8888 เข้าเล่นผ่านอุปกรณ์ใดได้บ้าง?",
    a: "FIN8888 รองรับการเข้าใช้งานผ่านโทรศัพท์ Android, iPhone, แท็บเล็ต และคอมพิวเตอร์ โดยเข้าเล่นผ่านเว็บเบราว์เซอร์ที่รองรับได้โดยตรง",
  },
  {
    q: "โปรโมชั่นแนะนำเพื่อน 0.8% รับอย่างไร?",
    a: "สมาชิกสามารถรับลิงก์แนะนำจากบัญชีของตนเองและส่งให้เพื่อนสมัคร เมื่อมียอดเล่นตรงตามเงื่อนไข ระบบจะคำนวณโบนัสสูงถึง 0.8%",
  },
  {
    q: "หากฝากเงินหรือถอนเงินไม่สำเร็จต้องทำอย่างไร?",
    a: "ควรตรวจสอบสถานะรายการและข้อมูลบัญชีให้ถูกต้อง หากรายการยังไม่อัปเดต สามารถส่งรายละเอียดให้แอดมิน FIN8888 ช่วยตรวจสอบได้ตลอด 24 ชั่วโมง",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message="FIN8888 แบรนด์เกมสล็อต เข้าเล่นผ่านมือถือและเว็บเบราว์เซอร์ • รองรับทุกเครือข่าย • แนะนำเพื่อนรับโบนัส 0.8% • คืนยอดเสียทุกวันสูงถึง 0.3%" />

  <ContentBoxFloatingBadge as="h1" title="FIN8888 แบรนด์เกมสล็อต เข้าเล่นผ่านมือถือและเว็บเบราว์เซอร์">
    <p class="text-left text-base leading-relaxed text-[#dbeafe]">
      <strong class="text-[#22d3ee]">FIN8888</strong> ให้บริการเกมสล็อตออนไลน์ที่รองรับการเข้าใช้งานผ่านโทรศัพท์มือถือ แท็บเล็ต และคอมพิวเตอร์
      สามารถเลือกเกม สมัครสมาชิก ตรวจสอบโปรโมชั่น และติดต่อทีมงานได้สะดวกผ่านหน้าเว็บไซต์
    </p>
  </ContentBoxFloatingBadge>

  <SmoothCarousel />

  <ContentBox as="h2" title="FIN8888 เปิดให้บริการเกมสล็อตออนไลน์ รองรับทุกเครือข่าย">
    <p class="text-left text-base leading-relaxed text-[#dbeafe]">
      เข้าเล่นเกมสล็อตกับ FIN8888 ได้ผ่านเครือข่ายอินเทอร์เน็ตและอุปกรณ์หลากหลายประเภท รองรับทั้งระบบ Android, iOS
      และคอมพิวเตอร์ โดยไม่จำเป็นต้องสลับใช้งานหลายแพลตฟอร์ม
    </p>
  </ContentBox>

  <ProviderGrid />

  <ContentBox as="h2" title="โปรโมชั่น FIN8888 พร้อมสิทธิพิเศษสำหรับสมาชิก">
    <p class="text-left text-base leading-relaxed text-[#dbeafe]">
      สมาชิกสามารถตรวจสอบโปรโมชั่นและสิทธิพิเศษผ่านหน้าเว็บไซต์ ทั้งโบนัสจากการแนะนำเพื่อนและยอดคืนจากการเล่นตามเงื่อนไขที่กำหนด
    </p>
  </ContentBox>

  <ContentBoxSevenThreeCyberCut titleright="แนะนำเพื่อน รับโบนัสสูง 0.8%">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="ภาพประกอบ FIN8888 แนะนำเพื่อน รับโบนัสสูง 0.8% ธีมงานเทศกาลพลุไฟ มาสคอตเจ้าสัว โทนกรมท่า-ทอง-ฟ้าไซแอน"
      class="mx-auto h-auto w-full rounded-2xl border border-[#0891b2]/25 shadow-[0_10px_30px_rgba(8,145,178,0.18)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#dbeafe]">
      แชร์ลิงก์แนะนำให้เพื่อนสมัครสมาชิกกับ FIN8888 รับโบนัสสูงถึง 0.8% จากยอดเล่นของเพื่อนตามเงื่อนไข
      สามารถตรวจสอบยอดโบนัสผ่านบัญชีสมาชิกได้
    </p>
  </ContentBoxSevenThreeCyberCut>

  <ContentBoxSevenThreeCyberCut titleright="คืนยอดเสียทุกวัน สูงถึง 0.3%">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="ภาพประกอบ FIN8888 คืนยอดเสียทุกวัน สูงถึง 0.3% ธีมงานเทศกาลพลุไฟ มาสคอตเจ้าสัว โทนกรมท่า-ทอง-ฟ้าไซแอน"
      class="mx-auto h-auto w-full rounded-2xl border border-[#0891b2]/25 shadow-[0_10px_30px_rgba(8,145,178,0.18)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#dbeafe]">
      สมาชิกที่มียอดเล่นเสียตามเงื่อนไขสามารถรับยอดคืนสูงถึง 0.3% โดยเข้าสู่ระบบและกดรับสิทธิ์ด้วยตนเองผ่านหน้าเว็บไซต์
    </p>
  </ContentBoxSevenThreeCyberCut>

  <ContentBox as="h2" title="สมัคร FIN8888 พร้อมฝากครั้งแรก รับโบนัสสมาชิกใหม่">
    <p class="text-left text-base leading-relaxed text-[#dbeafe]">
      เริ่มต้นสมัครสมาชิก FIN8888 ผ่านโทรศัพท์มือถือได้ง่าย กรอกข้อมูลตามที่ระบบกำหนด ยืนยันบัญชี
      และฝากเงินครั้งแรกเพื่อรับโบนัสสมาชิกใหม่ตามเงื่อนไขของโปรโมชั่น
    </p>
    <p class="mt-4 text-left text-lg font-black text-[#22d3ee]">เริ่มต้นใช้งานได้ง่ายเพียง 3 ขั้นตอน</p>
    <FeatureHighlights items={onboardingSteps} heading={false} />
  </ContentBox>

  <ContentBox as="h2" title="พบปัญหาการใช้งาน ติดต่อแอดมิน FIN8888 ได้ตลอด 24 ชั่วโมง">
    <p class="text-left text-base leading-relaxed text-[#dbeafe]">
      หากพบปัญหาเกี่ยวกับการสมัครสมาชิก การเข้าสู่ระบบ โปรโมชั่น หรือรายการฝากถอน สามารถติดต่อทีมงาน FIN8888
      ผ่านช่องทางบริการลูกค้าอย่างเป็นทางการเพื่อให้ช่วยตรวจสอบได้ทันที
    </p>
  </ContentBox>

  <LatestWinnersCyber />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#22d3ee] to-[#0891b2] px-4 py-3 text-sm font-black whitespace-nowrap text-[#050b16] shadow-[0_10px_30px_rgba(8,145,178,0.26)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(8,145,178,0.4)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>

    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#155e75]/70 bg-[#050b16]/85 px-4 py-3 text-sm font-black whitespace-nowrap text-[#dbeafe] backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:border-[#0891b2] hover:bg-[#0a1628]/85 hover:shadow-[0_15px_40px_rgba(103,232,249,0.35)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>
  </div>

  <Faq title="คำถามที่พบบ่อยเกี่ยวกับ FIN8888" faqs={faqs} />

  <ReviewCardSumo2 />

  <Navfoot />
</MainLayout>
