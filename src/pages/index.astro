---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ProviderGridPremium from "../components/ProviderGridPremium.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import LatestWinners from "../components/LatestWinnersCyber.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Faq from "../components/Faq4.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// Title and description are the brief's own Title/Description lines, used
// verbatim. A brief-supplied description is never padded up to the 150-char
// floor and never topped up from the H1/H2.
const pageTitle = "MGM9 เล่นบาคาร่า สล็อต บอล หวย ไม่อั้นจ่าย ไม่มีขั้นต่ำ";

const pageDescription = "MGM9 คาสิโนเกมครบวงจร เล่นบาคาร่า สล็อต บอล หวย ครบทุกรูปแบบเกม ไม่อั้นจ่าย ไม่มีขั้นต่ำ สมัครรับโปรโมชั่นได้ตลอดทั้งวัน";

// The ticker copy is passed explicitly rather than relying on the component's
// default — every Announcement* variant's default belongs to whichever brand
// wired it in last. No emoji in this string: an emoji baked into a text prop
// cannot be given its own aria-hidden span, and this marquee prints the string
// twice.
const announcement =
  "MGM9 คาสิโนเกมครบวงจร เล่นบาคาร่า สล็อต บอล หวย ไม่อั้นจ่าย ไม่มีขั้นต่ำ • รวมบาคาร่าออนไลน์ เกมคาสิโนสด สล็อตออนไลน์ เดิมพันฟุตบอลตามรายการแข่งขัน และหวยออนไลน์ตามรอบที่เปิดให้บริการไว้ในบัญชีเดียว • ตรวจสอบกติกา อัตราจ่าย และช่วงเดิมพันของแต่ละเกมได้ก่อนยืนยันรายการ • ฝากถอนรองรับทั้งวอลเลทและบัญชีธนาคารตามช่องทางที่กำหนด ตรวจยอดและติดตามสถานะธุรกรรมได้ด้วยตัวเอง • โปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไขและรอบที่ระบบกำหนด • สมัครเองได้ด้วย 3 ขั้นตอน พร้อมแอดมิน MGM9 ให้บริการออนไลน์ตลอด 24 ชั่วโมง";

// The brief's own 3 registration steps, kept as data so the markup below stays
// one semantic <ol> instead of three hand-typed rows.
const registerSteps = [
  "เข้าหน้าสมัคร MGM9 และกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน",
  "Login เข้าบัญชี เลือกช่องทางฝากเครดิตผ่านธนาคารหรือวอลเลทที่รองรับ",
  "เลือกบาคาร่า สล็อต บอล หรือหวย ตรวจสอบกติกาและรายละเอียดก่อนเริ่มเดิมพัน",
];

// One array, used by both <Faq> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last.
const faqs = [
  {
    q: "MGM9 มีเกมอะไรให้เลือกเดิมพันบ้าง?",
    a: "มีเกมหลักทั้งบาคาร่า สล็อตออนไลน์ ฟุตบอล หวยออนไลน์ และเกมประเภทอื่นตามที่ระบบเปิดให้บริการ สมาชิกสามารถตรวจสอบรายการล่าสุด รวมถึงกติกาและอัตราจ่ายของแต่ละเกมก่อนเริ่มเดิมพันได้",
  },
  {
    q: "โปรโมชั่น MGM9 โบนัส 0.8% และ 0.3% รับอย่างไร?",
    a: "โบนัส 0.8% เป็นโปรโมชั่นแนะนำเพื่อนสำหรับรายการที่ตรงตามเงื่อนไข ส่วนโบนัส 0.3% เป็นโปรโมชั่นคืนยอดเสียตามรอบที่กำหนด ควรตรวจสอบยอดที่นำมาคำนวณและข้อกำหนดล่าสุดก่อนกดรับทุกครั้ง",
  },
  {
    q: "MGM9 ฝากถอนผ่านวอลเลทและธนาคารได้หรือไม่?",
    a: "สามารถเลือกใช้วอลเลทและธนาคารตามช่องทางที่ระบบ MGM9 เปิดรองรับในขณะนั้นได้ โดยควรตรวจสอบยอดขั้นต่ำ วงเงินต่อรายการ และรายชื่อช่องทางล่าสุดจากหน้าฝากถอนก่อนยืนยันธุรกรรมทุกครั้ง",
  },
];

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb. Every URL in the graph is derived
// by pageGraph from `site:` — no domain is typed out in this file.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <ContentBox as="h1" title="MGM9 เล่นบาคาร่าออนไลน์บนเว็บ คาสิโนเกมครบวงจร">
    <p class="text-left text-base leading-relaxed text-[#d3e6ff]">
      <strong class="text-[#9ad4ff]">MGM9</strong> รวมบริการเกมเดิมพันออนไลน์หลายประเภทไว้ในระบบเดียว ทั้งบาคาร่า สล็อต ฟุตบอล และหวย รองรับการใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์
      สมาชิกสามารถเลือกเกม ฝากถอน ตรวจสอบโปรโมชั่น และจัดการบัญชีได้จากหน้าเว็บไซต์ พร้อมโปรโมชั่นแนะนำเพื่อน <strong class="text-[#9ad4ff]">0.8%</strong> และคืนยอดเสีย
      <strong class="text-[#9ad4ff]">0.3%</strong> ตามเงื่อนไข รวมถึงมีแอดมินคอยให้คำแนะนำและรับเรื่องปัญหาการใช้งานตลอด 24 ชั่วโมง
    </p>
  </ContentBox>

  <ContentBoxTwoPremium as="h2" title="MGM9 เปิดบริการ บาคาร่า สล็อต บอล หวย ไม่อั้นจ่าย ไม่มีขั้นต่ำ">
    <p slot="left" class="text-left text-base leading-relaxed text-[#d3e6ff]">
      <strong class="text-[#9ad4ff]">MGM9</strong> จัดหมวดเกมหลักไว้ให้สมาชิกเลือกตามความสนใจ ไม่ว่าจะเป็นบาคาร่าออนไลน์ เกมคาสิโนสด สล็อตออนไลน์ เดิมพันฟุตบอลตามรายการแข่งขัน
      และหวยออนไลน์ตามรอบที่เปิดให้บริการ สามารถตรวจสอบกติกา อัตราจ่าย ช่วงเดิมพัน และรายละเอียดของแต่ละเกมก่อนยืนยันรายการได้จากบัญชีเดียว ช่วยให้สลับเล่นระหว่างเกมแต่ละประเภทได้สะดวกบนมือถือ
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#d3e6ff]">
      สำหรับเงื่อนไข “ไม่อั้นจ่าย” และ “ไม่มีขั้นต่ำ” ควรยึดวงเงินและข้อกำหนดที่ระบบแสดง ณ เวลาทำรายการเป็นหลัก เนื่องจากเกม โต๊ะ หรือประเภทการเดิมพันแต่ละรายการอาจกำหนดวงเงินแตกต่างกัน
    </p>
  </ContentBoxTwoPremium>

  <ProviderGridPremium />

  <ContentBoxFloatingBadge as="h2" title="MGM9 ฝากถอนวอลเลท รองรับทุกธนาคาร โปรโมชั่นครบทุกรูปแบบ">
    <p class="text-left text-base leading-relaxed text-[#d3e6ff]">
      สมาชิก <strong class="text-[#9ad4ff]">MGM9</strong> สามารถจัดการเครดิตผ่านระบบฝากถอนที่เว็บไซต์เปิดให้บริการ รองรับทั้งวอลเลทและบัญชีธนาคารตามช่องทางที่กำหนด สามารถตรวจสอบยอด ฝากเครดิต
      ส่งคำขอถอน และติดตามสถานะธุรกรรมผ่านบัญชีสมาชิกได้ด้วยตนเอง นอกจากนี้ยังสามารถ Login เพื่อตรวจสอบโปรโมชั่นและสิทธิ์โบนัสที่พร้อมให้กดรับได้ในแต่ละรอบ
    </p>
  </ContentBoxFloatingBadge>

  <ContentBoxSevenThreePremium as="h3" title="โปรโมชั่นแนะนำเพื่อน โบนัส 0.8%">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อนของ MGM9 ฉากคาสิโนสีน้ำเงินเข้ม ด้านบนกลางภาพเป็นโลโก้ MGM9 ถัดลงมาเป็นแผ่นป้ายสีน้ำเงินเขียนว่า โปรโมชั่น ตามด้วยข้อความตัวใหญ่สีขาวว่า แนะนำเพื่อน วางเหนือตัวเลข 0.8% ตรงกลางเป็นผู้หญิงสวมชุดกี่เพ้าสีขาวสลับแดงชี้มือไปที่ตัวเลข รอบตัวมีไพ่ ชิปคาสิโนสีน้ำเงิน และวงล้อรูเล็ต ด้านล่างเป็นชิปสีน้ำเงินสามอันเขียนว่า ชวนเพื่อนง่าย รับโบนัสทันที กับ รับโบนัส จากยอดเล่นเพื่อน และ ปลอดภัย มั่นคง 100%"
      class="mx-auto h-auto w-full rounded-2xl border border-[#4aa4f4]/40 shadow-[0_10px_30px_rgba(74,164,244,0.25)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#d3e6ff]">
      สมาชิกสามารถแชร์ลิงก์แนะนำส่วนตัวให้เพื่อน เมื่อเพื่อนสมัครและมียอดใช้งานตรงตามข้อกำหนด ระบบจะคำนวณโบนัสแนะนำเพื่อน <strong class="text-[#9ad4ff]">0.8%</strong> ตามเงื่อนไข
      สามารถตรวจสอบจำนวนเพื่อน ยอดที่เข้าเกณฑ์ และโบนัสที่มีสิทธิ์รับผ่านบัญชี <strong class="text-[#9ad4ff]">MGM9</strong> ได้โดยตรง ก่อนรับโบนัสควรตรวจสอบรอบคำนวณและข้อกำหนดของโปรโมชั่นให้ครบถ้วน
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBoxSevenThreeNeumorphism as="h3" title="โปรโมชั่นคืนยอดเสีย โบนัส 0.3%">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นคืนยอดเสียของ MGM9 ฉากคาสิโนสีน้ำเงินเข้ม ด้านบนกลางภาพเป็นโลโก้ MGM9 ถัดลงมาเป็นแผ่นป้ายสีน้ำเงินเขียนว่า โปรโมชั่น ตามด้วยข้อความตัวใหญ่สีขาวว่า คืนยอดเสีย วางเหนือตัวเลข 0.3% ตรงกลางเป็นผู้หญิงสวมชุดกี่เพ้าสีขาวสลับแดงชี้มือไปที่ตัวเลข รอบตัวมีไพ่ วงล้อรูเล็ต วงล้อสล็อต และชิปคาสิโนสีน้ำเงิน ด้านล่างเป็นชิปสีน้ำเงินสามอันเขียนว่า คืนยอดเสีย ทุกวัน กับ มั่นคง ปลอดภัย และ ฝาก-ถอน ออโต้ 24 ชม."
      class="mx-auto h-auto w-full rounded-2xl border border-[#4aa4f4]/40 shadow-[0_10px_30px_rgba(74,164,244,0.25)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#d3e6ff]">
      สมาชิกที่มียอดเสียเข้าเงื่อนไขสามารถตรวจสอบสิทธิ์รับโบนัสคืนยอดเสีย <strong class="text-[#9ad4ff]">0.3%</strong> ตามรอบที่ <strong class="text-[#9ad4ff]">MGM9</strong> กำหนด
      ระบบจะแสดงยอดที่นำมาคำนวณและโบนัสที่สามารถกดรับได้ โดยควรตรวจสอบว่าเกมที่เดิมพันเข้าร่วมโปรโมชั่นหรือไม่ รวมถึงอ่านเงื่อนไขเกี่ยวกับรอบรับและการถอนก่อนใช้สิทธิ์
    </p>
  </ContentBoxSevenThreeNeumorphism>

  <LoginRtpSection />

  <ContentBoxSpecial as="h2" title="สมัคร MGM9 ด้วย 3 ขั้นตอนง่าย ๆ" iconleft="📝" iconright="🔐">
    <div slot="left" class="flex min-w-0 flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d3e6ff]">
        ผู้ใช้งานใหม่สามารถเริ่มสมัคร <strong class="text-[#9ad4ff]">MGM9</strong> ผ่านมือถือได้ด้วยขั้นตอนที่ไม่ซับซ้อน หลังเปิดบัญชีแล้วสามารถเลือกเกมและตรวจสอบโปรโมชั่นที่ต้องการได้ทันที
      </p>
      <ol class="list-decimal space-y-2 pl-5 text-left text-base leading-relaxed text-[#d3e6ff]">
        {registerSteps.map((step) => <li>{step}</li>)}
      </ol>
    </div>
    <p slot="right" class="text-left text-base leading-relaxed text-[#d3e6ff]">
      หลังสมัครสมาชิกสามารถตรวจสอบเครดิต ประวัติธุรกรรม โปรโมชั่น และรายการเดิมพันผ่านบัญชีของตนเองได้ โดยควรตั้งรหัสผ่านที่คาดเดายากและไม่เปิดเผย OTP แก่บุคคลอื่น
    </p>
  </ContentBoxSpecial>

  <LatestWinners />

  <ContentBoxTwoNeumorphism as="h2" title="แอดมิน MGM9 ให้บริการออนไลน์ตลอด 24 ชั่วโมง">
    <p slot="left" class="text-left text-base leading-relaxed text-[#d3e6ff]">
      หากพบปัญหาเกี่ยวกับการสมัคร Login ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง โปรโมชั่นไม่แสดง หรือเข้าเกมไม่ได้ สามารถติดต่อแอดมิน <strong class="text-[#9ad4ff]">MGM9</strong>
      ได้ตลอด 24 ชั่วโมง พร้อมแจ้งเวลา จำนวนเงิน และรายละเอียดของรายการ เพื่อช่วยให้เจ้าหน้าที่ตรวจสอบข้อมูลได้ตรงจุด
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#d3e6ff]">
      สมาชิกใหม่ยังสามารถสอบถามวิธีฝากถอน ขั้นตอนรับโปรโมชั่น หรือการเข้าใช้งานเกมแต่ละหมวดได้ หากเป็นปัญหาเกี่ยวกับธุรกรรมควรเก็บหลักฐานรายการไว้จนกว่าการตรวจสอบจะเสร็จสิ้น
      และไม่ควรแจ้งรหัสผ่านหรือ OTP ให้บุคคลอื่น
    </p>
  </ContentBoxTwoNeumorphism>

  <ReviewCardSumo />

  <Faq title="คำถามที่พบบ่อยเกี่ยวกับ MGM9" faqs={faqs} />

  <Navfoot />
</MainLayout>
