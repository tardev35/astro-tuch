---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import LatestWinners from "../components/LatestWinners2.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBox from "../components/ContentBox.astro";
import Faq from "../components/Faq2.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgTwoDigit from "../assets/slide1.png";
import imgThreeDigit from "../assets/slide2.png";

// VARIANT ROTATION THIS ROUND (หวยเต็ง -> หวยเฮง24). Zero file reuse from the
// previous round: Announcement5 replaces Announcement3, LatestWinners2 replaces
// LatestWinners3, Faq2 replaces Faq4, ReviewCardSumo2 replaces ReviewCardSumo,
// and the ContentBox shape-mix moves off CyberCut / TwoNeumorphism /
// SevenThreeCyberCut / SevenThreeNeumorphism / TwoCyberCut onto Premium /
// TwoPremium / FloatingBadge / SevenThreePremium / SevenThreeFloatingBadge /
// Special. NavbarStyle6 and FooterStyle3 are the layout's pair this round
// (previously NavbarStyle9 / FooterStyle2).
// Plain ContentBox is the one deliberate carry-over: terms, privacy, 404 and
// every button page render through it by rule and cannot follow a rotation, so
// it is always-live and the orchestrator rethemes it in the shared step.
// Every CyberCut / Neumorphism / Huay / Cyber file, Faq4, Announcement3,
// LatestWinners3 and ReviewCardSumo stay on disk as inventory for the next brand
// — none of them was deleted. The *Huay family is deliberately NOT used here
// even though this is a lottery brand: it belongs to /ตรวจหวย and /แนวทาง, which
// keep their own theme.
//
// <Announcement /> runs bare on purpose: Announcement5's default message is
// already this brand's copy and every sub-page calls it bare too, so passing an
// override here is exactly how the ticker ends up saying two different things on
// two pages of the same site.
//
// IMAGE ROLES FOR THIS DROP (2026-10-01). Two files are referenced from this page
// and only two, and the pairing is read off the artwork itself, not off the file
// number:
//   slide1.png — the gold-bordered pill under the headline reads "2ตัวจ่าย100บาท"
//     and white balls marked 5 and 9 float down the left edge, so it belongs to
//     docx H3 #4. Imported as imgTwoDigit.
//   slide2.png — the pill reads "3ตัวจ่าย1,000บาท" and she holds a red ball
//     marked 3, so it belongs to docx H3 #5. Imported as imgThreeDigit.
// Both files measure 600x400, so 600 is the top real candidate width — nothing
// above it would be a real pixel — and each picture carries max-w-[600px] so the
// art is never upscaled past its own bitmap. Each slide sits in a
// ContentBoxSevenThree* image+text block, which is that family's hard cap of two
// per rebrand, so there is no third SevenThree anywhere on the site.
// The two blocks mirror each other: SevenThreePremium lays out
// md:grid-cols-[3fr_7fr] so its picture goes in slot="left", and
// SevenThreeFloatingBadge was flipped to md:grid-cols-[7fr_3fr] this round so its
// picture goes in slot="right" while the paragraph keeps the wide column. The two
// pictures therefore alternate sides instead of stacking down the same edge, and
// each `sizes` describes its own 3fr column rather than the viewport.
//
// The alt text was written from THIS drop's artwork (a deep-red satin ground with
// gold Thai ornament and light rays, banks of gold coins, red-and-white numbered
// lottery balls, Thai lottery tickets, a woman in a white-and-gold Thai dress, the
// red-and-gold หวยเฮง24 wordmark and huge gold Thai type reading อัตราจ่ายหวย).
//
// Deliberately NOT imported, and every file still on disk:
//   slide3.png / slide4.png / banner2.png / banner3.png all predate this drop and
//   belong to previous brands — importing any of them would emit a competitor's
//   artwork into dist/, so there is no inline article illustration this round.
//   banner1.png and banner1-mobile.png belong to MainLayout's own pinned globs and
//   are never referenced from a page — the hero is the LCP element, so nothing here
//   gets loading="eager" fetchpriority="high". og.png is the same: MainLayout owns it.
//
// Vocabulary: หวยเฮง24 is a เว็บเล่นหวยออนไลน์ — หวย, โพย, ส่งโพย, เลข 2 ตัว / 3 ตัว,
// อัตราจ่าย, รอบ, เวลาเปิดรับ / เวลาปิดรับ, งวด, ผลรางวัล, เช็คผล, หวยรัฐบาลไทย,
// หวยลาว, หวยฮานอย, หวยหุ้น, ฝากถอนวอลเลทและธนาคาร. The brand before this one sold
// a different lottery line-up and the two before that sold football and slots;
// every one of those words (ลาวพัฒนา, ฮานอยวีไอพี, บอล, ค่าน้ำ, อัตราต่อรอง, ลีก,
// สล็อต, ฟรีสปิน, RTP …) is gone, and the page was rewritten from the brief rather
// than find-and-replaced over the old sentences. Nothing here claims a licence, an
// operator, a bank, a deposit minimum, a member count or a founding year, because
// the brief names none. The only figures are the brief's own: 2 ตัว จ่าย 100 บาท,
// 3 ตัว จ่าย 1,000 บาท, 3 ขั้นตอน, 24 ชั่วโมง. The brief's own hedging ships with
// the copy ("ผลรางวัลควรอ้างอิงข้อมูลอย่างเป็นทางการของหวยแต่ละประเภท") — it is part
// of the paragraphs, not trimmed as downbeat.
//
// Title and description are the brief's own Title/Description lines, used verbatim.
// The description ships at 124 characters, the length the brief wrote it — it is
// not padded up to 150.
const pageTitle = "หวยเฮง24 เว็บเล่นหวยออนไลน์ หวยลาว ฮานอย รัฐบาลไทย เช็คผลทันที";

const pageDescription = "หวยเฮง24 เว็บเล่นหวยออนไลน์ เข้าแทงหวยลาว หวยฮานอย หวยรัฐบาลไทย ฝากถอนวอลเลทและธนาคารชั้นนำ พร้อมเช็คผลได้ทันทีหลังหวยออก";

// The brief has a real H2 -> H3 nesting this round, so the page is NOT flattened to
// H2-only. The two H3s are genuine headings — the two payout sub-points, both
// nested under the อัตราการจ่าย H2 — and they stay H3.
//
// The checklist, in document order, and what carries each one:
//    1 H1  หวยเฮง24 เว็บเล่นหวยออนไลน์ หวยลาว ฮานอย รัฐบาลไทย พร้อมเช็คผลทันที
//          ContentBoxPremium, L4
//    2 H2  เว็บ หวยเฮง24 เข้าแทงหวยลาว หวยฮานอย หวยรัฐบาลไทย หวยหุ้น ครบ
//          ContentBoxTwoPremium, L6 left + L7 right
//    3 H2  อัตราการจ่าย หวยเฮง24 2ตัว จ่าย100บาท 3ตัว จ่าย1,000บาท
//          ContentBoxFloatingBadge, L9
//    4 H3  2ตัว จ่าย100บาท
//          ContentBoxSevenThreePremium + slide1 (imgTwoDigit), L11
//    5 H3  3ตัว จ่าย1,000บาท
//          ContentBoxSevenThreeFloatingBadge + slide2 (imgThreeDigit), L13
//    6 H2  สมัครแทงหวย หวยเฮง24 ง่ายๆ 3ขั้นตอน
//          ContentBoxSpecial, L15 left + L16 right
//    7 H2  ติดต่อแอดมินเว็บ หวยเฮง24 เกี่ยวกับการแทงหวย 24 ชั่วโมง
//          ContentBox + LINE / สมัคร buttons, L18 + L19
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ หวยเฮง24
//          Faq2 + faqs prop
// Final inventory for this page: h1 x1, h2 x5, h3 x2.
//
// Every brief paragraph ships in full. Sections 2, 6 and 7 each have TWO
// paragraphs and both ship, nothing merged or summarised: in the two-column blocks
// they run one per column, in section 7's single-column block they stack inside one
// wrapper div. The column labels passed to ContentBoxTwoPremium are this page's own
// layout wording, not brief headings, and that variant renders them as <p>.
//
// Everything else on the page is chrome and emits no heading tag at any level:
// Announcement5, LatestWinners2, LoginRtpSection and ReviewCardSumo2 render their
// titles as <p>/<span> with an aria-label on the section, and Faq2's questions live
// inside <summary> as <span>. The non-brief widgets sit before section 1
// (LatestWinners2, right after the ticker) and after section 8 (LoginRtpSection,
// ReviewCardSumo2, Navfoot) — never spliced between two content sections.

// One array, used by both <Faq> and the FAQPage node — never the component's own
// defaults, which belong to whichever brand shipped last. The three pairs are the
// brief's own Q/A block, verbatim.
const faqs = [
  {
    q: "หวยเฮง24 มีหวยอะไรให้เลือกแทงบ้าง?",
    a: "สมาชิกสามารถเลือกหวยลาว หวยฮานอย หวยรัฐบาลไทย หวยหุ้น และรายการอื่นตามที่ระบบเปิดรับในแต่ละวัน โดยควรตรวจสอบรอบและเวลาปิดรับก่อนส่งโพยทุกครั้ง",
  },
  {
    q: "หวยเฮง24 2 ตัวจ่าย 100 และ 3 ตัวจ่าย 1,000 ใช้กับทุกหวยหรือไม่?",
    a: "อัตราจ่ายขึ้นอยู่กับประเภทหวยและรูปแบบการเดิมพันที่ร่วมเงื่อนไข จึงควรตรวจสอบตัวเลขที่แสดงในหน้าส่งโพยก่อนยืนยัน ไม่ควรถือว่าอัตรา 2 ตัว 100 และ 3 ตัว 1,000 ใช้เหมือนกันทุกรายการ",
  },
  {
    q: "หวยออกแล้วสามารถเช็คผลกับ หวยเฮง24 ได้ทันทีหรือไม่?",
    a: "เมื่อผลของรอบนั้นได้รับการประกาศและระบบอัปเดตแล้ว สมาชิกสามารถตรวจสอบผลและสถานะโพยผ่านหน้าเว็บไซต์ได้ ระยะเวลาอัปเดตอาจแตกต่างกันตามหวยแต่ละประเภท จึงควรตรวจสอบผลจากแหล่งประกาศอย่างเป็นทางการประกอบด้วย",
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space that
// splits the word — the copy must read identically with the tags removed. One
// highlight colour only: #fdea83, the wordmark's light gold, against the inherited
// body colour #f6e6cf (BRAND_TEXT). The paragraphs below carry no colour class of
// their own: every ContentBox* card in this mix already sets
// `text-left text-base leading-relaxed text-[#f6e6cf]` on the element holding the
// slot, so the prose inherits it and no page-level override can drift from the card.

// No breadcrumb: this is the homepage, so a trail from the root to itself would be a
// single self-referential crumb. Every URL in the graph is derived by pageGraph from
// `site:` — no domain is typed out in this file, and no Review / AggregateRating /
// sameAs / address node is passed.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <LatestWinners />

  <ContentBoxPremium as="h1" title="หวยเฮง24 เว็บเล่นหวยออนไลน์ หวยลาว ฮานอย รัฐบาลไทย พร้อมเช็คผลทันที">
    <p>
      หวยเฮง24
      <strong class="text-[#fdea83]">เว็บเล่นหวยออนไลน์ที่รวมรายการยอดนิยมไว้ให้เลือกในบัญชีเดียว</strong>
      <strong class="text-[#fdea83]">ทั้งหวยลาว หวยฮานอย หวยรัฐบาลไทย และหวยหุ้น</strong>
      รองรับการเข้าใช้งานผ่านมือถือ สมาชิกสามารถเลือกเลข ส่งโพย ตรวจสอบรายการ และเช็คผลหลังประกาศผลของแต่ละรอบได้จากหน้าเว็บไซต์
      <strong class="text-[#fdea83]">พร้อมช่องทางฝากถอนผ่านวอลเลทและธนาคารที่ระบบรองรับ</strong>
      ช่วยให้จัดการตั้งแต่เลือกหวยไปจนถึงตรวจผลได้สะดวกในที่เดียว
    </p>
  </ContentBoxPremium>

  <ContentBoxTwoPremium
    as="h2"
    title="เว็บ หวยเฮง24 เข้าแทงหวยลาว หวยฮานอย หวยรัฐบาลไทย หวยหุ้น ครบ"
    titleleft="ประเภทหวยที่เปิดรับ"
    titleright="ข้อควรตรวจหลังส่งโพย">
    <p slot="left">
      เว็บ หวยเฮง24
      <strong class="text-[#fdea83]">รวมหวยหลายประเภทสำหรับสมาชิกที่ต้องการเลือกแทงตามรอบในแต่ละวัน</strong>
      มีทั้งหวยลาวตามรายการที่เปิดรับ หวยฮานอยหลายรอบ หวยรัฐบาลไทยตามกำหนดออกรางวัล และหวยหุ้นตามตลาดที่ระบบรองรับ
      <strong class="text-[#fdea83]">สามารถตรวจสอบเวลาเปิดรับ เวลาปิดรับ และอัตราจ่ายของแต่ละรายการก่อนเลือกเลขได้จากหน้าเดียว</strong>
    </p>
    <p slot="right">
      หลังส่งโพยควรตรวจสอบชื่อหวย รอบเวลา เลขที่เลือก และยอดเดิมพันให้ถูกต้อง
      <strong class="text-[#fdea83]">เมื่อมีการประกาศผลสามารถกลับมาเช็คผลและสถานะโพยผ่านบัญชีสมาชิกได้</strong>
      <strong class="text-[#fdea83]">โดยผลรางวัลควรอ้างอิงข้อมูลอย่างเป็นทางการของหวยแต่ละประเภทเพื่อความถูกต้อง</strong>
    </p>
  </ContentBoxTwoPremium>

  <ContentBoxFloatingBadge as="h2" title="อัตราการจ่าย หวยเฮง24 2ตัว จ่าย100บาท 3ตัว จ่าย1,000บาท">
    <p>
      หวยเฮง24 มีอัตราจ่ายสำหรับรายการที่เข้าเงื่อนไข โดยกำหนดตัวเลือก
      <strong class="text-[#fdea83]">2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท</strong>
      ตามประเภทหวยและรูปแบบการแทงที่ระบบเปิดรับ
      <strong class="text-[#fdea83]">สมาชิกควรตรวจสอบอัตราที่แสดงก่อนส่งโพยทุกครั้ง</strong>
      เพราะหวยลาว ฮานอย รัฐบาลไทย และหวยหุ้นอาจกำหนดรายละเอียดแตกต่างกันในแต่ละรอบ
    </p>
  </ContentBoxFloatingBadge>

  <ContentBoxSevenThreePremium as="h3" title="2ตัว จ่าย100บาท">
    <Picture
      slot="left"
      src={imgTwoDigit}
      loading="lazy"
      fetchpriority="low"
      widths={[339, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), (max-width: 1279px) calc(30vw - 46px), 339px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="ศิลปะโปสเตอร์อัตราจ่ายหวยของ หวยเฮง24 พื้นผ้าซาตินสีแดงเข้มมีลายไทยสีทองและริ้วแสงทองพาดทั่วภาพ ด้านซ้ายเป็นหญิงสาวผมเกล้าสวมชุดไทยสีขาวประดับทอง สวมสร้อยและกำไลทอง ยิ้มพร้อมแบมือขวาออกมาเชิญชวน มีลูกหวยสีขาวหมายเลข 5 และ 9 ลอยอยู่ริมซ้าย ด้านขวาบนเป็นโลโก้ หวยเฮง24 ตัวอักษรแดงคู่ทอง ถัดลงมาเป็นตัวอักษรไทยสีทองขนาดใหญ่ว่า อัตราจ่ายหวย ในกรอบแดงขอบทอง ใต้ลงไปเป็นป้ายขอบทองคาดข้อความ 2ตัวจ่าย100บาท และมุมขวาล่างมีลูกหวยทองหมายเลข 24 กับ 6 วางอยู่บนกองเหรียญทอง"
      class="mx-auto h-auto w-full max-w-[600px] rounded-2xl border border-[#e0a52a]/60 shadow-[0_10px_30px_rgba(224,165,42,0.30)]"
    />
    <p slot="right">
      สำหรับรายการที่กำหนดอัตรา 2 ตัว จ่าย 100 บาท
      <strong class="text-[#fdea83]">สมาชิกสามารถเลือกเลขตามประเภทการเดิมพันที่ระบบเปิดรับ</strong>
      <strong class="text-[#fdea83]">พร้อมตรวจสอบยอดและอัตราจ่ายก่อนยืนยันโพย</strong>
      ควรดูรายละเอียดให้ชัดเจนว่าอัตรานี้ใช้กับหวยและรูปแบบ 2 ตัวประเภทใด เพื่อให้ตรงกับรายการที่เลือก
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBoxSevenThreeFloatingBadge as="h3" title="3ตัว จ่าย1,000บาท">
    <p slot="left">
      รายการที่กำหนดอัตรา 3 ตัว จ่าย 1,000 บาท
      <strong class="text-[#fdea83]">ควรตรวจสอบประเภทเลขและเงื่อนไขของหวยรอบนั้นก่อนส่งโพย</strong>
      เนื่องจากเลข 3 ตัวแต่ละรูปแบบอาจมีวิธีคำนวณและอัตราจ่ายแตกต่างกัน
      <strong class="text-[#fdea83]">สมาชิกจึงควรยึดข้อมูลล่าสุดที่แสดงในระบบเป็นหลัก</strong>
    </p>
    <Picture
      slot="right"
      src={imgThreeDigit}
      loading="lazy"
      fetchpriority="low"
      widths={[344, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), (max-width: 1279px) calc(30vw - 41px), 344px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
