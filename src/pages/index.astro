---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import LatestWinners from "../components/LatestWinners4.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBox from "../components/ContentBox.astro";
import Faq from "../components/Faq2.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgCashback from "../assets/slide2.png";
import imgReferral from "../assets/slide1.png";

// VARIANT ROTATION THIS ROUND (1SS365 -> DM899). Zero file reuse from the
// previous round: Announcement3 replaces AnnouncementPremium, LatestWinners4
// replaces LatestWinnersPremium, Faq2 replaces Faq3, ReviewCardSumo2 replaces
// ReviewCardSumo, and the ContentBox shape-mix moves off Neumorphism /
// TwoCyberCut / CyberCut / SevenThreeNeumorphism / SevenThreeCyberCut /
// TwoNeumorphism onto Premium / TwoPremium / FloatingBadge / SevenThreePremium /
// SevenThreeFloatingBadge / Special. NavbarStyle9 and FooterStyle3 are the
// layout's pair this round (previously NavbarStyle4Black / FooterPremiumSumo).
// Plain ContentBox is the one deliberate carry-over: terms, privacy, 404 and
// every button page render their body through it by rule and cannot follow a
// rotation, so it is always-live and the orchestrator rethemes it in the shared
// step — this page only passes it props.
// Every Neumorphism / CyberCut / Huay / Style file, Faq3, AnnouncementPremium,
// LatestWinnersPremium, ReviewCardSumo, NavbarStyle4Black and FooterPremiumSumo
// stay on disk as inventory for the next brand — none of them was deleted, and
// the previous brand's copy and colour still inside them is expected drift, not
// a bug.
//
// <Announcement /> runs bare on purpose: Announcement3's default message is
// already this brand's copy and every sub-page calls it bare too, so passing an
// override here is exactly how the ticker ends up saying two different things on
// two pages of the same site.
//
// IMAGE ROLES FOR THIS DROP (2026-10-03). Two files are referenced from this page
// and only two, and each pairing is read off the artwork itself:
//   slide2.png — green-and-red glowing rings behind the model, roulette wheel and
//     red dice, and the plaque under the big gold โปรโมชั่น wordmark reads
//     "คืนยอดเสีย โบนัส" with a huge three-dimensional red 0.3%, so it belongs to
//     docx H3 #4. Imported as imgCashback.
//   slide1.png — white/green/red drapes, casino chips, aces and gift boxes, and
//     its black gold-edged plaque reads "แนะนำเพื่อน โบนัส 0.8%" under a gold
//     crown, so it belongs to docx H3 #5. Imported as imgReferral.
// Both files measure 600x600, so 600 is the top real candidate width — nothing
// above it would be a real pixel — and each picture carries max-w-[600px] so the
// art is never upscaled past its own bitmap. Each slide sits in a
// ContentBoxSevenThree* image+text block, which is that family's hard cap of two
// per rebrand, so there is no third SevenThree anywhere on the site.
// The two blocks mirror each other: SevenThreePremium lays out
// md:grid-cols-[3fr_7fr] so its picture goes in slot="left", and
// SevenThreeFloatingBadge lays out md:grid-cols-[7fr_3fr] so its picture goes in
// slot="right" while the paragraph keeps the wide column. The two pictures
// therefore alternate sides instead of stacking down the same edge, and each
// `sizes` describes its own 3fr column rather than the viewport:
//   SevenThreePremium:      max-w-7xl/1280px cap, px-4, md:p-10, gap-10, no inner
//                           padding on the image column
//                           -> (1280 - 32 - 80 - 40) x 0.3 = 338px
//   SevenThreeFloatingBadge: max-w-7xl/1280px cap, px-4, p-8, gap-10, md:pl-10 +
//                           border on the image column
//                           -> (1280 - 32 - 64 - 40) x 0.3 - 41 = 302px
// Below md both cards collapse to one column at p-8, so the drawn width is
// 100vw - 32 (section px-4) - 64 (card p-8) = 100vw - 96px, capped at 600px.
// Neither picture is the LCP element — MainLayout's hero banner is — so both are
// loading="lazy" fetchpriority="low".
//
// The alt text was written from THIS drop's artwork, re-opened with the Read
// tool before it was typed: both slides are 600x600 portraits of a model in
// white against a green-and-red casino set, with the DM899 logo (a green D
// overlapping a red M, then a silver 899) in the upper area, a large gold Thai
// โปรโมชั่น wordmark under it, and that slide's own offer plaque beneath.
//
// Deliberately NOT imported, and every file still on disk:
//   banner2.png / banner3.png / slide3.png / slide4.png all predate this drop and
//   belong to previous brands — importing any of them would emit a competitor's
//   artwork into dist/, so there is no inline article illustration this round.
//   banner1.png and banner1-mobile.png belong to MainLayout's own pinned globs
//   and are never referenced from a page. og.png is the same: MainLayout owns it.
//
// Vocabulary: DM899 is a สล็อตคาสิโนออนไลน์ เว็บตรงต่างประเทศ — สล็อต, คาสิโนสด,
// เว็บตรงต่างประเทศ, บัญชีบริษัทแท้ 100%, ค่ายเกม, เครดิต, โปรโมชั่น, คืนยอดเสีย 0.3%,
// แนะนำเพื่อน 0.8%, รอบคำนวณ, ยอดที่เข้าเกณฑ์, ฝากถอน, ประวัติรายการ, สมัครสมาชิก,
// Login, แอดมิน 24 ชั่วโมง, 3 ขั้นตอน, PIN, OTP, ลิงก์แนะนำ. Two brands ago this
// template sold lottery; every one of those words (หวย, แทงหวย, ส่งโพย, โพย, งวด,
// เลข 2 ตัว / 3 ตัว, อัตราจ่าย, รัฐบาลไทย, ฮานอย, ลาวพัฒนา, หวยหุ้น, แนวทางหวย,
// ตรวจหวย) is gone, and so is the previous slot brand's "ไม่ผ่านเอเย่นต์" /
// "เดิมพันไม่มีขั้นต่ำ" angle, which this brief does not contain. The page was
// written from the brief rather than find-and-replaced over the old sentences.
// Nothing here claims a licence, an operator, a bank, a deposit minimum, a member
// count, a founding year, an RTP figure or a named game studio, because the brief
// names none. The only figures are the brief's own: 0.3%, 0.8%, 3 ขั้นตอน,
// 24 ชั่วโมง, 100%. The brief's own hedging ships with the copy (คำว่า "บัญชี
// บริษัทแท้ 100%" ควรมีชื่อนิติบุคคลและข้อมูลที่ตรวจสอบได้รองรับ, "การันตีระบบเกม
// มาตรฐาน" ควรระบุมาตรฐาน ใบอนุญาต หรือหน่วยงานที่ตรวจสอบได้, การเป็นแพลตฟอร์ม
// ต่างประเทศไม่ได้ยืนยันมาตรฐานหรือความปลอดภัยของระบบโดยอัตโนมัติ) — it is part of
// the paragraphs, not trimmed as downbeat.
//
// Title and description are the brief's own Title/Description lines, used
// verbatim and NOT padded up to 150: verify-build deliberately skips its
// 150-character floor on the home page for exactly this reason.
const pageTitle = "DM899 สล็อตคาสิโนเว็บตรงต่างประเทศ การันตีระบบ บัญชีบริษัทแท้100%";

const pageDescription = "DM899 สล็อตคาสิโนเว็บตรงต่างประเทศ ทางเข้าเล่นเกมเดิมพันครบวงจร การันตีระบบเกมมาตรฐาน มั่นใจได้ ฝากถอนปลอดภัย เข้าบัญชีบริษัทแท้100%";

// The brief has a real H2 -> H3 nesting this round, so the page is NOT flattened
// to H2-only. The two H3s are genuine headings — the two promotion sub-points,
// both nested under the โปรโมชั่น H2 — and they stay H3.
//
// The checklist, in document order, and what carries each one:
//    1 H1  DM899 สล็อตคาสิโนเว็บตรงต่างประเทศ บัญชีบริษัทแท้100%
//          ContentBoxPremium, brief paragraph on line 4
//    2 H2  ทางเข้าเล่นเกม DM899 เดิมพันครบวงจร การันตีระบบเกมมาตรฐาน
//          ContentBoxTwoPremium, line 6 left / line 7 right
//    3 H2  โปรโมชั่นเล่นสล็อต DM899 อัปเดตใหม่ทุกเดือน
//          ContentBoxFloatingBadge, line 9
//    4 H3  โปรโมชั่น คืนยอดเสีย โบนัส 0.3%
//          ContentBoxSevenThreePremium + slide2 (imgCashback), line 11
//    5 H3  โปรโมชั่น แนะนำเพื่อน โบนัส 0.8%
//          ContentBoxSevenThreeFloatingBadge + slide1 (imgReferral), line 13
//    6 H2  สมัครเดิมพัน DM899 บนมือถือง่ายๆ 3ขั้นตอน
//          ContentBoxSpecial, line 15 left / line 16 right
//    7 H2  ติดต่อแอดมิน DM899 ผู้ให้บริการเว็บหลัก 24 ชั่วโมง
//          ContentBox + LINE / สมัครสมาชิก buttons, lines 18+19
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ DM899
//          Faq2 + faqs prop, lines 21-26
// Final inventory for this page: h1 x1, h2 x5, h3 x2.
//
// Every brief paragraph ships in full — all ten of them, nothing merged or
// summarised. Sections 2 and 6 have two paragraphs each and run one per column;
// section 7 has two and they stack inside one wrapper div so the slot still
// receives exactly one element. The column labels passed to ContentBoxTwoPremium
// are this page's own layout wording, not brief headings, and that variant
// renders them as <p>.
//
// Everything else on the page is chrome and emits no heading tag at any level:
// Announcement3, LatestWinners4, LoginRtpSection and ReviewCardSumo2 render their
// titles as <p>/<span> with an aria-label on the section, and Faq2's questions
// live inside <summary> as <span>. The non-brief widgets sit before section 1
// (the ticker, then the winners feed) and after section 8 (LoginRtpSection,
// ReviewCardSumo, Navfoot) — never spliced between two content sections.

// One array, used by both <Faq> and the FAQPage node — never the component's own
// defaults, which belong to whichever brand shipped last. The three pairs are the
// brief's own Q/A block, verbatim.
const faqs = [
  {
    q: "DM899 มีเกมเดิมพันประเภทไหนให้เลือก?",
    a: "DM899 สามารถรวมเกมสล็อต คาสิโนสด และเกมประเภทอื่นตามค่ายที่ระบบเปิดให้บริการ สมาชิกควรตรวจสอบรายการล่าสุดจากหน้าเกม เนื่องจากจำนวนค่ายและเกมสามารถมีการเพิ่มหรือลดได้ตามช่วงเวลา",
  },
  {
    q: "DM899 ใช้บัญชีบริษัทโดยตรงจริงหรือไม่?",
    a: "หากเว็บไซต์ระบุว่าใช้บัญชีบริษัทโดยตรง ควรตรวจสอบชื่อบัญชี ชื่อนิติบุคคล และข้อมูลบริษัทให้ตรงกันก่อนทำธุรกรรมทุกครั้ง การระบุว่าเป็น “บัญชีบริษัทแท้ 100%” เพียงอย่างเดียวไม่เพียงพอสำหรับยืนยันความปลอดภัย",
  },
  {
    q: "โปรโมชั่น DM899 โบนัส 0.3% และ 0.8% ต่างกันอย่างไร?",
    a: "โบนัส 0.3% เป็นโปรโมชั่นคืนยอดเสียจากยอดที่ตรงตามเงื่อนไข ส่วนโบนัส 0.8% เป็นกิจกรรมแนะนำเพื่อนจากยอดที่เข้าเกณฑ์ ทั้งสองรายการอาจกำหนดรอบคำนวณและเกมที่ร่วมรายการแตกต่างกัน จึงควรตรวจสอบรายละเอียดล่าสุดก่อนรับสิทธิ์",
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// One highlight colour only: #ffe9a8, the brand's pale gold, against the
// inherited body colour #e4f2e4 (BRAND_TEXT). The paragraphs below carry no
// colour class of their own: every ContentBox* card in this mix already sets
// `text-left text-base leading-relaxed text-[#e4f2e4]` on the element holding
// the slot, so the prose inherits it and no page-level override can drift from
// the card.

// No breadcrumb: this is the homepage, so a trail from the root to itself would
// be a single self-referential crumb. Every URL in the graph is derived by
// pageGraph from `site:` — no domain is typed out in this file, and no Review /
// AggregateRating / sameAs / address node is passed.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <LatestWinners />

  <ContentBoxPremium as="h1" title="DM899 สล็อตคาสิโนเว็บตรงต่างประเทศ บัญชีบริษัทแท้100%">
    <p>
      <strong class="text-[#ffe9a8]">DM899 สล็อตคาสิโนเว็บตรงต่างประเทศที่รวบรวมเกมเดิมพันหลายรูปแบบไว้ในระบบเดียว</strong>
      รองรับการเข้าเล่นผ่านมือถือ มีทั้งเกมสล็อต คาสิโน และเกมประเภทอื่นตามที่เว็บไซต์เปิดให้บริการ สมาชิกสามารถเลือกเกม ตรวจสอบโปรโมชั่น และจัดการรายการผ่านบัญชีเดียว พร้อมระบบฝากถอนที่เว็บไซต์ระบุว่าเชื่อมต่อกับบัญชีบริษัทโดยตรง
      อย่างไรก็ตาม
      <strong class="text-[#ffe9a8]">คำว่า “บัญชีบริษัทแท้ 100%” ควรมีชื่อนิติบุคคลและข้อมูลที่ตรวจสอบได้รองรับก่อนนำมาใช้ยืนยันด้านความปลอดภัย</strong>
    </p>
  </ContentBoxPremium>

  <ContentBoxTwoPremium as="h2" title="ทางเข้าเล่นเกม DM899 เดิมพันครบวงจร การันตีระบบเกมมาตรฐาน" titleleft="ทางเข้าเล่นเกมจากบัญชีเดียว" titleright="ข้อความการันตีที่ควรตรวจสอบ">
    <p slot="left">
      <strong class="text-[#ffe9a8]">ทางเข้าเล่นเกม DM899 ถูกจัดให้สมาชิกสามารถเลือกประเภทการเดิมพันได้จากบัญชีเดียว</strong>
      มีทั้งเกมสล็อต เกมคาสิโนสด และหมวดเกมอื่นตามผู้ให้บริการที่เชื่อมต่อกับระบบ รองรับการใช้งานผ่านเว็บเบราว์เซอร์บนมือถือ
      <strong class="text-[#ffe9a8]">สามารถสลับหมวดเกม ตรวจสอบเครดิต และดูประวัติรายการได้โดยไม่ต้องสมัครบัญชีใหม่แยกตามค่าย</strong>
    </p>
    <p slot="right">
      หากต้องการใช้ข้อความว่า “การันตีระบบเกมมาตรฐาน”
      <strong class="text-[#ffe9a8]">ควรระบุมาตรฐาน ใบอนุญาต หรือหน่วยงานที่ตรวจสอบได้อย่างชัดเจน</strong>
      เพราะการเป็นแพลตฟอร์มต่างประเทศไม่ได้ยืนยันมาตรฐานหรือความปลอดภัยของระบบโดยอัตโนมัติ
    </p>
  </ContentBoxTwoPremium>

  <ContentBoxFloatingBadge as="h2" title="โปรโมชั่นเล่นสล็อต DM899 อัปเดตใหม่ทุกเดือน">
    <p>
      <strong class="text-[#ffe9a8]">DM899 มีโปรโมชั่นสำหรับสมาชิกตามแคมเปญที่เปิดในแต่ละเดือน</strong>
      โดยสามารถ Login เพื่อตรวจสอบรายการที่บัญชีมีสิทธิ์รับ มีทั้งโบนัสคืนยอดเสียและกิจกรรมแนะนำเพื่อน แต่ละโปรโมชั่นอาจกำหนดรอบคำนวณ ยอดที่เข้าเกณฑ์ เกมที่ร่วมรายการ และระยะเวลารับสิทธิ์แตกต่างกัน
      <strong class="text-[#ffe9a8]">จึงควรตรวจสอบเงื่อนไขล่าสุดก่อนกดรับโบนัส</strong>
    </p>
  </ContentBoxFloatingBadge>

  <ContentBoxSevenThreePremium as="h3" title="โปรโมชั่น คืนยอดเสีย โบนัส 0.3%">
    <Picture
      slot="left"
      src={imgCashback}
      loading="lazy"
      fetchpriority="low"
      widths={[338, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), (max-width: 1279px) calc(30vw - 46px), 338px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="ภาพโปรโมชั่นของ DM899 ฉากหลังเป็นวงแหวนเรืองแสงสีเขียวและสีแดงบนพื้นดำ ด้านซ้ายเป็นหญิงสาวผมยาวสยาย สวมชุดสีขาวประดับเพชร ยื่นมือซ้ายแบออกมาข้างหน้า รอบตัวมีชิปคาสิโนลอยกระจาย ด้านล่างขวามีลูกเต๋าสีแดงสองลูก ไพ่เอซสองใบ กองชิป และวงล้อรูเล็ต มุมบนเป็นโลโก้ DM899 ที่ตัว D สีเขียวซ้อนตัว M สีแดง ตามด้วยเลข 899 สีเงิน ถัดลงมาเป็นมงกุฎทองและตัวอักษรไทยสีทองขนาดใหญ่ว่า โปรโมชั่น ใต้ลงมาเป็นข้อความ คืนยอดเสีย โบนัส กับตัวเลข 0.3% สีแดงสามมิติขนาดใหญ่"
      class="mx-auto h-auto w-full max-w-[600px] rounded-2xl border border-[#01a326]/60 shadow-[0_10px_30px_rgba(1,163,38,0.26)]"
    />
    <p slot="right">
      <strong class="text-[#ffe9a8]">สมาชิกที่มียอดเสียตรงตามเงื่อนไขสามารถตรวจสอบสิทธิ์รับโบนัสคืนยอดเสีย 0.3% ตามรอบที่ DM899 กำหนด</strong>
      ระบบจะคำนวณจากยอดที่เข้าเกณฑ์ก่อนแสดงโบนัสที่สามารถรับได้
      <strong class="text-[#ffe9a8]">ควรตรวจสอบประเภทเกม รอบตัดยอด และข้อกำหนดการใช้โบนัสให้ครบถ้วนก่อนกดรับ</strong>
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBoxSevenThreeFloatingBadge as="h3" title="โปรโมชั่น แนะนำเพื่อน โบนัส 0.8%">
    <p slot="left">
