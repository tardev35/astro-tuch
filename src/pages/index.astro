---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import LatestWinners from "../components/LatestWinners3.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxTwoFloatingBadge from "../components/ContentBoxTwoFloatingBadge.astro";
import ContentBox from "../components/ContentBox.astro";
import Faq from "../components/Faq2.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgCashback from "../assets/slide2.png";
import imgReferral from "../assets/slide1.png";

// VARIANT ROTATION THIS ROUND (NAZA99 -> NATO168). Zero file reuse from the
// previous round: Announcement5 replaces AnnouncementPremium, LatestWinners3
// replaces LatestWinnersPremium, Faq2 replaces Faq4, ReviewCardSumo replaces
// ReviewCardSumo2, and the ContentBox shape-mix moves off Premium / TwoPremium /
// FloatingBadge / SevenThreePremium / SevenThree / Special onto CyberCut /
// TwoCyberCut / Neumorphism / SevenThreeCyberCut / SevenThreeNeumorphism /
// TwoFloatingBadge. NavbarStyle8 and FooterStyle3 are the layout's pair this
// round (previously NavbarPremium / FooterPremium).
// Plain ContentBox is the one deliberate carry-over: terms, privacy, 404 and
// every button page render their body through it by rule and cannot follow a
// rotation, so it is always-live and the orchestrator rethemes it in the shared
// step — this page only passes it props.
// Every Premium / Special / Huay / Cyber file, Faq4, AnnouncementPremium,
// LatestWinnersPremium, ReviewCardSumo2, NavbarPremium and FooterPremium stay on
// disk as inventory for the next brand — none of them was deleted, and the
// previous brand's copy and colour still inside them is expected drift, not a bug.
//
// <Announcement /> runs bare on purpose: Announcement5's default message is
// already this brand's copy and every sub-page calls it bare too, so passing an
// override here is exactly how the ticker ends up saying two different things on
// two pages of the same site.
//
// IMAGE ROLES FOR THIS DROP (2026-10-02). Two files are referenced from this page
// and only two, and each pairing is read off the artwork itself:
//   slide2.png — the gold-edged black pill under the big gold โปรโมชั่น wordmark
//     reads "คืนยอดเสีย โบนัส" over a huge gold 0.3%, so it belongs to docx H3 #4.
//     Imported as imgCashback.
//   slide1.png — the same set, the pill reads "แนะนำเพื่อน โบนัส" over a huge gold
//     0.8%, so it belongs to docx H3 #5. Imported as imgReferral.
// Both files measure 600x400, so 600 is the top real candidate width — nothing
// above it would be a real pixel — and each picture carries max-w-[600px] so the
// art is never upscaled past its own bitmap. Each slide sits in a
// ContentBoxSevenThree* image+text block, which is that family's hard cap of two
// per rebrand, so there is no third SevenThree anywhere on the site.
// The two blocks mirror each other: SevenThreeCyberCut lays out
// md:grid-cols-[3fr_7fr] so its picture goes in slot="left", and
// SevenThreeNeumorphism lays out md:grid-cols-[7fr_3fr] so its picture goes in
// slot="right" while the paragraph keeps the wide column. The two pictures
// therefore alternate sides instead of stacking down the same edge, and each
// `sizes` describes its own 3fr column rather than the viewport (CyberCut:
// max-w-7xl/1280px cap, p-8, gap-8, no inner padding on the image column ->
// 346px; Neumorphism: 1400px cap, p-8, gap-8, md:pl-8 on the image column ->
// 350px).
//
// The alt text was written from THIS drop's artwork (a cream-and-gold ground of
// swept gold satin ribbons and floating gold coins, a woman in a white-and-gold
// outfit, the two-tone NATO168 wordmark with its circled N, huge gold Thai type
// reading โปรโมชั่น under a small crown, a black gold-edged pill with the bonus
// line, and the gold 3-D percentage figure).
//
// Deliberately NOT imported, and every file still on disk:
//   banner2.png / banner3.png / slide3.png / slide4.png all predate this drop and
//   belong to previous brands (LOTTO24 / LOTTOPLUS) — importing any of them would
//   emit a competitor's artwork into dist/, so there is no inline article
//   illustration this round. banner1.png and banner1-mobile.png belong to
//   MainLayout's own pinned globs and are never referenced from a page — the hero
//   is the LCP element, so nothing here gets loading="eager" fetchpriority="high".
//   og.png is the same: MainLayout owns it.
//
// Vocabulary: NATO168 is a เว็บสล็อตออนไลน์ / พีจีเว็บตรง — สล็อต, พีจี, ค่ายเกม,
// โบนัสไทม์, ฟรีสปิน, ตัวคูณ, วงล้อ, สัญลักษณ์, ปั่น, โบนัสทุกยูส, ไม่มีล็อคยูส,
// คืนยอดเสีย 0.3%, แนะนำเพื่อน 0.8%, สมัครสมาชิก, Login, แอดมิน 24 ชั่วโมง, PIN, OTP.
// Several brands before this one sold lottery lines; every one of those words
// (หวย, โพย, ส่งโพย, เลข 2 ตัว / 3 ตัว, เลขเด็ด, เลขดัง, งวด, อัตราจ่าย, หวยฮานอย /
// ลาว / หุ้น, บอล, ค่าน้ำ, ลีก, คาสิโนสด, บาคาร่า) is gone, and the page was written
// from the brief rather than find-and-replaced over the old sentences. Nothing here
// claims a licence, an operator, a bank, a deposit minimum, a member count, a
// founding year or an RTP figure, because the brief names none. It names no game
// titles either — unlike the previous round's brief, this one lists game FORMATS
// (สล็อตวงล้อทั่วไป, ฟรีสปิน, ตัวคูณ, เกมที่มีฟีเจอร์โบนัส) and no titles, so neither
// does the page. The only figures are the brief's own: 0.3%, 0.8%, 3 ขั้นตอน,
// 24 ชั่วโมง. The brief's own hedging ships with the copy
// ("ควรอ้างอิงเงื่อนไขจริงของเว็บไซต์", "อาจกำหนดประเภทสมาชิก เกมที่ร่วมรายการ หรือยอด
// ที่ใช้คำนวณแตกต่างกัน", "จึงควรตรวจสอบรายละเอียดก่อนกดรับทุกครั้ง") — it is part of
// the paragraphs, not trimmed as downbeat.
//
// Title and description are the brief's own Title/Description lines, used verbatim.
// The description ships at 139 characters, the length the brief wrote it — it is
// not padded up to 150.
const pageTitle = "NATO168 เกมสล็อตโบนัสไทม์ พีจีเว็บตรง มือใหม่รับโบนัสทุกยูส";

const pageDescription = "NATO168 เกมสล็อตโบนัสไทม์ ทางเข้าเล่นพีจีเว็บตรง เกมเดิมพันสำหรับมือใหม่ เล่นง่ายทุกเกมทุกค่าย รับโบนัสทุกยูส ไม่มีล็อคยูส";

// The brief has a real H2 -> H3 nesting this round, so the page is NOT flattened to
// H2-only. The two H3s are genuine headings — the two promotion sub-points, both
// nested under the โปรโมชั่น H2 — and they stay H3.
//
// The checklist, in document order, and what carries each one:
//    1 H1  NATO168 เกมสล็อตโบนัสไทม์ พีจีเว็บตรง มือใหม่รับโบนัสทุกยูส
//          ContentBoxCyberCut, brief paragraph on line 4
//    2 H2  ทางเข้าเล่น NATO168 สล็อตเว็บตรง รับโบนัสทุกยูส ไม่มีล็อค
//          ContentBoxTwoCyberCut, line 6 left / line 7 right
//    3 H2  โปรโมชั่นเล่นสล็อต NATO168 จัดหนักตลอดทั้งเดือน
//          ContentBoxNeumorphism, line 9
//    4 H3  คืนยอดเสีย โบนัส 0.3%
//          ContentBoxSevenThreeCyberCut + slide2 (imgCashback), line 11
//    5 H3  แนะนำเพื่อน โบนัส 0.8%
//          ContentBoxSevenThreeNeumorphism + slide1 (imgReferral), line 13
//    6 H2  สมัครเล่นเกมสล็อต NATO168 ง่ายๆ 3ขั้นตอน
//          ContentBoxTwoFloatingBadge, line 15 left / line 16 right
//    7 H2  ติดต่อแอดมิน NATO168 ผู้ให้บริการ 24 ชั่วโมง
//          ContentBox + LINE / สมัครสมาชิก buttons, lines 18+19
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ NATO168
//          Faq2 + faqs prop, lines 21-26
// Final inventory for this page: h1 x1, h2 x5, h3 x2.
//
// Every brief paragraph ships in full — all eleven of them, nothing merged or
// summarised. Sections 2 and 6 have two paragraphs each and run one per column;
// section 7 has two and they stack inside one wrapper div so the slot still
// receives exactly one element. The column labels passed to ContentBoxTwoCyberCut
// and ContentBoxTwoFloatingBadge are this page's own layout wording, not brief
// headings, and both variants render them as <p>.
//
// Everything else on the page is chrome and emits no heading tag at any level:
// Announcement5, LatestWinners3, LoginRtpSection and ReviewCardSumo render their
// titles as <p>/<span> with an aria-label on the section, and Faq2's questions
// live inside <summary> as <span>. The non-brief widgets sit before section 1
// (the ticker, then the winners feed) and after section 8 (LoginRtpSection,
// ReviewCardSumo, Navfoot) — never spliced between two content sections.

// One array, used by both <Faq> and the FAQPage node — never the component's own
// defaults, which belong to whichever brand shipped last. The three pairs are the
// brief's own Q/A block, verbatim.
const faqs = [
  {
    q: "NATO168 เหมาะกับมือใหม่ที่เพิ่งเริ่มเล่นสล็อตหรือไม่?",
    a: "เว็บไซต์มีเกมสล็อตหลายรูปแบบตามค่ายที่เปิดรองรับ มือใหม่สามารถเลือกเกมที่มีกติกาเข้าใจง่ายและตรวจสอบข้อมูลก่อนเริ่มเล่นได้ ควรอ่านกติกา ฟีเจอร์ และช่วงเดิมพันของแต่ละเกม รวมถึงกำหนดงบก่อนเริ่มทุกครั้ง",
  },
  {
    q: "NATO168 รับโบนัสทุกยูสจริงหรือไม่?",
    a: "การได้รับโบนัสขึ้นอยู่กับเงื่อนไขของโปรโมชั่นในช่วงนั้น สมาชิกที่มีคุณสมบัติตรงตามข้อกำหนดสามารถตรวจสอบและรับสิทธิ์จากบัญชีได้ จึงควรอ่านรายละเอียดเรื่องเกมที่ร่วมรายการ ยอดคำนวณ และรอบรับก่อนใช้โปรโมชั่น",
  },
  {
    q: "โปรโมชั่น NATO168 โบนัส 0.3% และ 0.8% ต่างกันอย่างไร?",
    a: "โบนัส 0.3% เป็นสิทธิ์คืนยอดเสียจากยอดที่เข้าเงื่อนไข ส่วนโบนัส 0.8% เป็นโปรโมชั่นแนะนำเพื่อนจากยอดที่กำหนด ทั้งสองรายการอาจมีรอบและเงื่อนไขต่างกัน จึงควรตรวจสอบรายละเอียดล่าสุดก่อนกดรับ",
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space that
// splits the word — the copy must read identically with the tags removed. One
// highlight colour only: #fde8a8, the logo's light gold, against the inherited body
// colour #f4ead3 (BRAND_TEXT). The paragraphs below carry no colour class of their
// own: every ContentBox* card in this mix already sets
// `text-left text-base leading-relaxed text-[#f4ead3]` on the element holding the
// slot, so the prose inherits it and no page-level override can drift from the card.

// No breadcrumb: this is the homepage, so a trail from the root to itself would be a
// single self-referential crumb. Every URL in the graph is derived by pageGraph from
// `site:` — no domain is typed out in this file, and no Review / AggregateRating /
// sameAs / address node is passed.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <LatestWinners />

  <ContentBoxCyberCut as="h1" title="NATO168 เกมสล็อตโบนัสไทม์ พีจีเว็บตรง มือใหม่รับโบนัสทุกยูส">
    <p>
      NATO168 รวมเกมสล็อตออนไลน์สำหรับผู้ที่ต้องการเริ่มต้นเล่นผ่านระบบที่ใช้งานไม่ซับซ้อน
      <strong class="text-[#fde8a8]">มีทั้งสล็อตพีจีและเกมจากค่ายที่เว็บไซต์เปิดรองรับ</strong>
      สามารถเข้าเล่นผ่านมือถือได้โดยไม่ต้องสลับหลายแพลตฟอร์ม
      <strong class="text-[#fde8a8]">พร้อมหมวดโบนัสไทม์สำหรับติดตามเกมและกิจกรรมที่เปิดสิทธิ์ในแต่ละช่วง</strong>
      สมาชิกใหม่สามารถตรวจสอบโบนัส เกมยอดนิยม เครดิต และรายละเอียดโปรโมชั่นผ่านบัญชีของตนเองก่อนเริ่มเล่นได้ทันที
    </p>
  </ContentBoxCyberCut>

  <ContentBoxTwoCyberCut
    as="h2"
    title="ทางเข้าเล่น NATO168 สล็อตเว็บตรง รับโบนัสทุกยูส ไม่มีล็อค"
    titleleft="ทางเข้าเล่นและรูปแบบเกม"
    titleright="เงื่อนไขของโบนัสทุกยูส">
    <p slot="left">
      ทางเข้าเล่น NATO168
      <strong class="text-[#fde8a8]">รองรับการเข้าสู่ระบบผ่านเว็บเบราว์เซอร์ทั้งบนมือถือและคอมพิวเตอร์</strong>
      หลัง Login สามารถเลือกสล็อตพีจี รวมถึงเกมสล็อตจากค่ายอื่นที่เปิดให้บริการได้จากบัญชีเดียว มีเกมหลายรูปแบบตั้งแต่สล็อตวงล้อทั่วไป ฟรีสปิน ตัวคูณ ไปจนถึงเกมที่มีฟีเจอร์โบนัส
      <strong class="text-[#fde8a8]">เหมาะสำหรับมือใหม่ที่ต้องการเริ่มจากเกมที่มีกติกาไม่ซับซ้อน</strong>
    </p>
    <p slot="right">
      <strong class="text-[#fde8a8]">สมาชิกที่มีคุณสมบัติตรงตามโปรโมชั่นสามารถตรวจสอบโบนัสจากบัญชีได้โดยตรง</strong>
      ส่วนคำว่า “รับโบนัสทุกยูส” และ “ไม่มีล็อคยูส”
      <strong class="text-[#fde8a8]">ควรอ้างอิงเงื่อนไขจริงของเว็บไซต์</strong>
      เพราะบางโปรโมชั่นอาจกำหนดประเภทสมาชิก เกมที่ร่วมรายการ หรือยอดที่ใช้คำนวณแตกต่างกัน
    </p>
  </ContentBoxTwoCyberCut>

  <ContentBoxNeumorphism as="h2" title="โปรโมชั่นเล่นสล็อต NATO168 จัดหนักตลอดทั้งเดือน">
    <p>
      NATO168 มีโปรโมชั่นเกมสล็อตให้สมาชิกติดตามตลอดเดือน
      <strong class="text-[#fde8a8]">โดยสิทธิ์หลักมีทั้งโบนัสคืนยอดเสียและโบนัสแนะนำเพื่อน</strong>
      สามารถ Login เพื่อตรวจสอบโปรโมชั่น ยอดที่เข้าเกณฑ์ และรอบรับโบนัสได้จากบัญชีสมาชิก แต่ละรายการอาจมีเงื่อนไขเกี่ยวกับค่ายเกม รอบคำนวณ หรือยอดที่นำมาคิดโบนัส
      <strong class="text-[#fde8a8]">จึงควรตรวจสอบรายละเอียดก่อนกดรับทุกครั้ง</strong>
    </p>
  </ContentBoxNeumorphism>

  <ContentBoxSevenThreeCyberCut as="h3" title="คืนยอดเสีย โบนัส 0.3%">
    <Picture
      slot="left"
      src={imgCashback}
      loading="lazy"
      fetchpriority="low"
      widths={[346, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), (max-width: 1279px) calc(30vw - 38px), 346px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="ภาพโปสเตอร์โปรโมชั่นของ NATO168 พื้นหลังสีขาวครีมอมทองมีริ้วผ้าซาตินทองโค้งพาดและเหรียญทองลอยกระจาย ด้านซ้ายเป็นหญิงสาวผมยาวสีน้ำตาลสวมชุดสีขาวคาดแถบทองประดับตราตัว N แบมือขวาหงายขึ้นมาข้างหน้า มุมบนขวาเป็นโลโก้ NATO168 โดยคำว่า NATO เป็นสีเงินและเลข 168 เป็นสีทอง พร้อมสัญลักษณ์ตัว N ในวงกลม ถัดลงมาเป็นตัวอักษรไทยสีทองขนาดใหญ่มีมงกุฎเล็กด้านบนว่า โปรโมชั่น ใต้ลงมาเป็นป้ายสีดำขอบทองคาดข้อความ คืนยอดเสีย โบนัส และตัวเลขทองสามมิติขนาดใหญ่ว่า 0.3% มุมล่างขวาเป็นชิปคาสิโนสีดำขอบทองประดับตัว N วางซ้อนกับเหรียญทอง"
      class="mx-auto h-auto w-full max-w-[600px] rounded-2xl border border-[#edb543]/60 shadow-[0_10px_30px_rgba(237,181,67,0.30)]"
    />
    <p slot="right">
      <strong class="text-[#fde8a8]">สมาชิกที่มียอดเสียตรงตามข้อกำหนดสามารถตรวจสอบสิทธิ์รับโบนัสคืนยอดเสีย 0.3% ตามรอบที่ NATO168 กำหนด</strong>
      ระบบจะนำเฉพาะยอดที่เข้าเงื่อนไขมาคำนวณและแสดงโบนัสที่มีสิทธิ์รับ
      <strong class="text-[#fde8a8]">ก่อนกดรับควรตรวจสอบค่ายเกม รอบตัดยอด และรายละเอียดของโปรโมชั่นให้ครบถ้วน</strong>
    </p>
  </ContentBoxSevenThreeCyberCut>

  <ContentBoxSevenThreeNeumorphism as="h3" title="แนะนำเพื่อน โบนัส 0.8%">
    <p slot="left">
      <strong class="text-[#fde8a8]">สมาชิกสามารถแชร์ลิงก์แนะนำ NATO168 ให้เพื่อน</strong>
      เมื่อเพื่อนสมัครและมียอดใช้งานตรงตามเงื่อนไข
      <strong class="text-[#fde8a8]">ระบบจะคำนวณโบนัสแนะนำเพื่อน 0.8% จากยอดที่เข้าเกณฑ์</strong>
      สามารถติดตามจำนวนเพื่อน ยอดคำนวณ และโบนัสผ่านบัญชีสมาชิกตามรอบที่เว็บไซต์กำหนด
    </p>
    <Picture
