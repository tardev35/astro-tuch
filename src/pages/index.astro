---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import LatestWinners from "../components/LatestWinnersPremium.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Faq2 from "../components/Faq2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// SLIDE ROLES FOR UVO88 — READ BEFORE REUSING THESE IMPORTS.
// Verified against the artwork on the 2026-09-04 drop: slide1.png is the
// แนะนำเพื่อน 0.8% poster and slide2.png is the คืนยอดเสีย 0.3% one, which is the
// order the docx puts them in (H3 #4 then H3 #5), so slide1 sits in the first
// SevenThree block and slide2 in the second. Re-check the actual posters on the
// next rebrand rather than trusting this order — a previous brand shipped the
// two swapped, which builds clean and reads wrong.
//
// Both posters print the exact percentage its section describes, so the alt text
// and the section prose agree with each other and with the brief.
//
// Stale assets that must stay unimported: slide3.png / slide4.png (2026-08-13)
// are a DIFFERENT client's artwork (PIGAUTO — red Chinese-New-Year lottery
// posters with a pink pig logo), and banner2.png / banner3.png (2026-08-20 /
// 2026-08-11) are earlier clients' drops. This brand has no banner2+ article
// illustration, so no ContentBox gets an inline banner image this round.
// banner1.png and banner1-mobile.png are the hero pair and belong to
// MainLayout's own pinned globs — never referenced from a page.

// Title and description are the brief's own Title/Description lines, used
// verbatim. A brief-supplied description is never padded up to the 150-char
// floor and never topped up from the H1/H2.
const pageTitle = "UVO88 เว็บพนันที่น่าเชื่อที่สุด ครบทุกการเดิมพัน ส่งตรงจากต่างประเทศ";

const pageDescription = "UVO88 เว็บพนันที่น่าเชื่อที่สุด รวมเกม บาคาร่า ไพ่ สล็อต หวย บอล สนุกครบทุกการเดิมพัน ไม่มีขั้นต่ำ ส่งตรงจากต่างประเทศ";

// The ticker copy is passed explicitly rather than relying on the component's
// default — every Announcement* variant's default belongs to whichever brand
// wired it in last. No emoji in this string: an emoji baked into a text prop
// cannot be given its own aria-hidden span, and this marquee prints the string
// twice.
const announcement =
  "UVO88 ให้บริการเกมเดิมพันออนไลน์หลายประเภทผ่านบัญชีเดียว ทั้งบาคาร่า เกมไพ่ สล็อตออนไลน์ หวย และฟุตบอล • รองรับการใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ สลับประเภทเกมได้โดยไม่ต้องสมัครหลายบัญชี • ก่อนเริ่มเดิมพันควรตรวจสอบกติกา อัตราจ่าย ช่วงเดิมพัน และวงเงินของแต่ละเกมให้ครบถ้วน เพราะรายละเอียดอาจแตกต่างกันตามผู้ให้บริการ และผลลัพธ์ของเกมไม่สามารถรับประกันกำไรหรือผลชนะได้ทุกครั้ง • โปรโมชั่นแนะนำเพื่อน โบนัส 0.8% คำนวณจากยอดที่เข้าเงื่อนไข ตามรอบคำนวณและข้อกำหนดที่เว็บไซต์กำหนด • โปรโมชั่นคืนยอดเสีย โบนัส 0.3% ตรวจสอบสิทธิ์และยอดที่เข้าเกณฑ์ได้จากบัญชีสมาชิก • สำหรับคำว่า ไม่มีขั้นต่ำ ควรยึดตัวเลขที่เกมหรือระบบแสดง ณ เวลาทำรายการ • ติดต่อแอดมิน UVO88 ได้ตลอด 24 ชั่วโมง";

// One array, used by both <Faq2> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last.
const faqs = [
  {
    q: "UVO88 มีเกมอะไรให้เลือกเดิมพันบ้าง?",
    a: "มีทั้งบาคาร่า เกมไพ่ สล็อตออนไลน์ หวยออนไลน์ และการเดิมพันฟุตบอล รวมถึงเกมประเภทอื่นตามที่ระบบเปิดให้บริการ สมาชิกสามารถเลือกหมวดเกมและตรวจสอบกติกา อัตราจ่าย และวงเงินก่อนเริ่มเดิมพันได้",
  },
  {
    q: "โปรโมชั่น UVO88 โบนัส 0.8% และ 0.3% ต่างกันอย่างไร?",
    a: "โบนัส 0.8% เป็นโปรโมชั่นแนะนำเพื่อนสำหรับยอดที่เข้าเงื่อนไข ส่วนโบนัส 0.3% เป็นโปรโมชั่นคืนยอดเสียตามรอบที่กำหนด สมาชิกควรตรวจสอบวิธีคำนวณและข้อกำหนดของแต่ละโปรโมชั่นก่อนกดรับ",
  },
  {
    q: "UVO88 เดิมพันแบบไม่มีขั้นต่ำได้ทุกเกมหรือไม่?",
    a: "ขึ้นอยู่กับช่วงเดิมพันที่แต่ละเกมกำหนด บางเกมอาจเปิดให้เริ่มด้วยยอดต่ำ ขณะที่บางเกมอาจมีขั้นต่ำแตกต่างกัน จึงควรตรวจสอบตัวเลขเดิมพันที่แสดงในเกมก่อนยืนยันทุกครั้ง",
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// Heading white (#f3fbf5) marks a claim the brief states outright; the caveat
// gold (#ffd76a) marks the warning that goes with it — a caution painted in the
// brand's own emerald stops reading as a caution.

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb. Every URL in the graph is derived
// by pageGraph from `site:` — no domain is typed out in this file.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <ContentBoxNeumorphism as="h1" title="UVO88 เว็บพนันที่น่าเชื่อที่สุด การันตีจากเจ้าของแท้">
    <div class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#c8e3d0]">
      <p>
        <strong class="text-[#f3fbf5]">UVO88</strong> ให้บริการเกมเดิมพันออนไลน์หลายประเภทผ่านบัญชีเดียว
        <strong class="text-[#f3fbf5]">มีทั้งบาคาร่า เกมไพ่ สล็อตออนไลน์ หวย และฟุตบอล</strong>
        รองรับการใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ สมาชิกสามารถเลือกเกม ตรวจสอบเครดิต ฝากถอน รับโปรโมชั่น และจัดการบัญชีได้จากหน้าเว็บไซต์
        <strong class="text-[#f3fbf5]">พร้อมระบบช่วยเหลือสำหรับผู้ใช้งานตลอด 24 ชั่วโมง</strong>
        เพื่อให้การใช้งานแต่ละส่วนเป็นไปอย่างสะดวกและไม่ซับซ้อน
      </p>
      <p>
        สำหรับคำว่า “การันตีจากเจ้าของแท้” และ “น่าเชื่อที่สุด”
        <strong class="text-[#ffd76a]">ควรมีข้อมูลผู้ให้บริการหรือหลักฐานที่ตรวจสอบได้บนเว็บไซต์</strong>
        เพื่อให้คำกล่าวอ้างมีความชัดเจนและสร้างความน่าเชื่อถือได้มากขึ้น
      </p>
    </div>
  </ContentBoxNeumorphism>

  <ContentBoxTwoPremium as="h2" title="UVO88 รวมเกม บาคาร่า ไพ่ สล็อต หวย บอล ครบทุกการเดิมพัน">
    <p slot="left" class="text-left text-base leading-relaxed text-[#c8e3d0]">
      <strong class="text-[#f3fbf5]">UVO88</strong> รวมหมวดเกมเดิมพันยอดนิยมไว้ให้สมาชิกเลือกใช้งานผ่านระบบเดียว
      <strong class="text-[#f3fbf5]">ไม่ว่าจะเป็นบาคาร่าออนไลน์ เกมไพ่ในหมวดคาสิโน สล็อตออนไลน์จากหลายค่าย หวยออนไลน์ตามรอบที่เปิดรับ และการเดิมพันฟุตบอลตามรายการแข่งขัน</strong>
      ช่วยให้สมาชิกสามารถสลับประเภทเกมได้โดยไม่ต้องสมัครหลายบัญชี
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#c8e3d0]">
      <strong class="text-[#ffd76a]">ก่อนเริ่มเดิมพันควรตรวจสอบกติกา อัตราจ่าย ช่วงเดิมพัน และวงเงินของแต่ละเกมให้ครบถ้วน</strong>
      เนื่องจากรายละเอียดอาจแตกต่างกันตามผู้ให้บริการและประเภทการเดิมพัน
      <strong class="text-[#ffd76a]">รวมถึงผลลัพธ์ของเกมไม่สามารถรับประกันกำไรหรือผลชนะได้ทุกครั้ง</strong>
    </p>
  </ContentBoxTwoPremium>

  <ProviderGrid />

  <GameRankingBoard />

  <ContentBox as="h2" title="เล่นสล็อต UVO88 ผ่านมือถือ ไม่มีขั้นต่ำ รับโปรโมชั่นได้ทุกวัน">
    <div class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#c8e3d0]">
      <p>
        <strong class="text-[#f3fbf5]">สมาชิกสามารถเล่นสล็อต UVO88 ผ่านเว็บเบราว์เซอร์บนมือถือได้</strong>
        โดยเลือกเกมจากค่ายที่ระบบเปิดให้บริการ พร้อมตรวจสอบเครดิต ประวัติรายการ และโปรโมชั่นผ่านบัญชีเดียว
        <strong class="text-[#f3fbf5]">ช่วยให้เข้าถึงเกมสล็อตได้สะดวกทั้งบนสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์</strong>
      </p>
      <p>
        สำหรับคำว่า “ไม่มีขั้นต่ำ”
        <strong class="text-[#ffd76a]">ควรตรวจสอบช่วงเดิมพันของแต่ละเกมและยอดขั้นต่ำของช่องทางฝากถอนก่อนใช้งาน</strong>
        เพราะเงื่อนไขอาจแตกต่างกัน ขณะที่โปรโมชั่นสามารถตรวจสอบสิทธิ์ได้ตามรายการที่เปิดให้รับในแต่ละวัน
      </p>
    </div>
  </ContentBox>

  <ContentBoxSevenThreePremium as="h3" title="โปรโมชั่นแนะนำเพื่อน โบนัส 0.8%">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อน 0.8% ของ UVO88 พื้นหลังโทนเขียวมรกตเข้ม มีเหรียญทองและชิปคาสิโนกองอยู่รอบภาพ มุมซ้ายบนเป็นโลโก้ UVO88 ตัวอักษร UVO สีทองวางบนชิปโป๊กเกอร์สีเขียว และเลข 88 สีทองอยู่ใต้ลงมา ถัดมาเป็นป้ายโค้งสีเขียวเขียนว่า โปรโมชั่น ตามด้วยข้อความ แนะนำเพื่อน สีขาวขอบทอง วางเหนือตัวเลข 0.8% ขนาดใหญ่สีทองเงา ด้านขวาเป็นผู้หญิงผมบลอนด์สวมชุดสีเขียวแต่งทองกำลังชี้มาที่ตัวเลข ฉากหลังมีวงล้อรูเล็ต ไพ่เอซ และกองชิป ด้านล่างเป็นป้ายสามอันพร้อมไอคอน เขียนว่า แนะนำเพื่อน รับโบนัสไม่อั้น กับ เพื่อนสมัคร รับโบนัสไปเลย และ รับโบนัสสูงสุด ไม่จำกัด"
      class="mx-auto h-auto w-full rounded-2xl border border-[#0f9d47]/45 shadow-[0_10px_30px_rgba(15,157,71,0.25)]"
    />
    <div slot="right" class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#c8e3d0]">
      <p>
        สมาชิกสามารถนำลิงก์แนะนำส่วนตัวไปแชร์ให้เพื่อน เมื่อเพื่อนสมัคร <strong class="text-[#f3fbf5]">UVO88</strong> และมียอดใช้งานตรงตามข้อกำหนด
        <strong class="text-[#f3fbf5]">ระบบจะคำนวณโบนัสแนะนำเพื่อน 0.8% จากยอดที่เข้าเงื่อนไข</strong>
        สามารถตรวจสอบจำนวนเพื่อน ยอดคำนวณ และโบนัสที่มีสิทธิ์รับผ่านบัญชีสมาชิกได้โดยตรง
      </p>
      <p>
        <strong class="text-[#ffd76a]">ก่อนรับโบนัสควรตรวจสอบรอบคำนวณ ประเภทเกมที่ร่วมรายการ และเงื่อนไขของโปรโมชั่นล่าสุดให้ครบถ้วน</strong>
      </p>
    </div>
  </ContentBoxSevenThreePremium>

  <ContentBoxSevenThree as="h3" title="โปรโมชั่นคืนยอดเสีย โบนัส 0.3%">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นคืนยอดเสีย 0.3% ของ UVO88 พื้นหลังโทนเขียวมรกตเข้ม มีเหรียญทองและชิปคาสิโนกองอยู่รอบภาพ มุมซ้ายบนเป็นโลโก้ UVO88 ตัวอักษร UVO สีทองวางบนชิปโป๊กเกอร์สีเขียว และเลข 88 สีทองอยู่ใต้ลงมา ถัดมาเป็นป้ายโค้งสีเขียวเขียนว่า โปรโมชั่น ตามด้วยข้อความ คืนยอดเสีย สีขาวขอบทอง วางเหนือตัวเลข 0.3% ขนาดใหญ่สีทองเงา ด้านขวาเป็นผู้หญิงผมบลอนด์สวมชุดสีเขียวแต่งทองกำลังชี้มาที่ตัวเลข ฉากหลังมีวงล้อรูเล็ต ไพ่เอซ และกองชิป ด้านล่างเป็นป้ายสามอันพร้อมไอคอน เขียนว่า คืนยอดเสีย ทุกวัน กับ มั่นคง ปลอดภัย มาตรฐานระดับสากล และ ระบบออโต้ รวดเร็ว ทันใจ"
      class="mx-auto h-auto w-full rounded-2xl border border-[#f2c230]/45 shadow-[0_10px_30px_rgba(242,194,48,0.22)]"
    />
    <div slot="right" class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#c8e3d0]">
      <p>
        <strong class="text-[#f3fbf5]">สมาชิกที่มียอดเสียตรงตามเงื่อนไขสามารถตรวจสอบสิทธิ์รับโบนัสคืนยอดเสีย 0.3% ตามรอบที่ UVO88 กำหนด</strong>
        ระบบจะแสดงยอดที่เข้าเกณฑ์และจำนวนโบนัสที่สามารถกดรับได้จากบัญชีสมาชิก
      </p>
      <p>
        <strong class="text-[#ffd76a]">ก่อนกดรับควรตรวจสอบประเภทเกม รอบเวลา วิธีคำนวณ และเงื่อนไขการถอนของโปรโมชั่น</strong>
        เพื่อให้ใช้งานโบนัสได้ตรงตามข้อกำหนด
      </p>
    </div>
  </ContentBoxSevenThree>

  <ContentBoxPremium as="h2" title="สมัคร UVO88 เดิมพันได้ไม่มีขั้นต่ำ">
    <div class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#c8e3d0]">
      <p>
        <strong class="text-[#f3fbf5]">ผู้ใช้งานใหม่สามารถสมัคร UVO88 ผ่านระบบออนไลน์ได้ด้วยตัวเอง</strong>
