---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import LatestWinners from "../components/LatestWinners4.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import Faq from "../components/Faq2.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide4 from "../assets/slide4.png";

// VARIANT ROTATION THIS ROUND (WIN999 -> LOTTOPLUS). Zero file reuse from the
// previous round except plain ContentBox, which is pinned live by terms/privacy
// and therefore never rotates: AnnouncementHuay replaces AnnouncementPremium,
// LatestWinners4 replaces LatestWinnersPremium, Faq2 replaces Faq3,
// ReviewCardSumo replaces ReviewCardSumo2, and the ContentBox shape-mix moves
// to CyberCut / TwoCyberCut / SevenThreeCyberCut / Neumorphism /
// TwoNeumorphism / SevenThreeNeumorphism / Special. NavbarHuay and FooterHuay
// are the layout's pair this round (previously NavbarPremium / FooterPremium).
// Every *Premium and *FloatingBadge file, Announcement Premium, Faq3,
// LatestWinnersPremium and ReviewCardSumo2 stay on disk as inventory for the
// next brand — none of them was deleted.
//
// <Announcement /> runs bare on purpose: AnnouncementHuay's default message is
// already this brand's copy and every sub-page calls it bare too, so passing an
// override here is exactly how the ticker ends up saying two different things
// on two pages of the same site.
//
// IMAGE ROLES FOR THIS DROP (2026-09-29). Two files are referenced from this
// page and only two:
//   slide1.png — the poster whose red pill reads "อัตราจ่าย หวย" above a huge
//     "2ตัว100", so it belongs to docx H3 #4.
//   slide4.png — the companion poster whose pill reads "แนะนำเพื่อน โบนัส"
//     above a huge gold "0.8%", so it belongs to docx H3 #7.
// Both files are 600x334, so 600 is the top candidate width — nothing above it
// would be a real pixel. Each slide sits in a ContentBoxSevenThree* image+text
// block, which is that family's hard cap of two per rebrand, so there is no
// third SevenThree on this page. The two blocks put the picture on OPPOSITE
// sides: SevenThreeCyberCut runs image(3fr)-then-text, SevenThreeNeumorphism
// runs text(7fr)-then-image.
//
// The alt text was written from THIS drop's artwork (a light studio ground with
// red-and-white ribbons, the LOTTOPLUS wordmark in white on a red block, two
// models holding Thai lottery tickets, red-and-white numbered lottery balls and
// stacks of gold coins) and is NOT the previous brand's text — the WIN999
// posters were black-and-gold with spade cards and casino chips, none of which
// is in these pictures.
//
// Deliberately NOT imported, and every file still on disk as inventory:
//   slide2.png reads "3ตัว1,000" and slide3.png is pixel-for-pixel the same
//   offer, but the SevenThree cap of two is already spent, so neither gets a
//   home rather than being relocated into a box it does not belong in.
//   banner2.png (2026-09-28) and banner3.png (2026-09-27) predate this drop and
//   carry a previous client's artwork, so there is no inline article
//   illustration this round. banner1.png and banner1-mobile.png belong to
//   MainLayout's own pinned globs and are never referenced from a page — the
//   hero is the LCP element, so nothing here gets loading="eager"
//   fetchpriority="high". og.png is the same: MainLayout owns it.
//
// Vocabulary: LOTTOPLUS is a เว็บหวยออนไลน์. Nothing on this page may say
// คาสิโน, บาคาร่า, สล็อต, เกมไพ่, ค่ายเกม, RTP, ผู้ให้บริการเกม, เดิมพันกีฬา/บอล,
// เว็บตรง as a claim, or ใบอนุญาต — the previous brand on this template was a
// casino and every one of those words is wrong now. LoginRtpSection's
// right-hand column was a casino game-category panel and is a หวยที่เปิดรับ +
// จุดที่ต้องตรวจก่อนส่งโพย panel this round; it states no provider, no RTP, no
// bank and no minimum stake, because the brief names none. The only figures on
// this page are the five the brief itself states: 2 ตัว 100, 3 ตัว 1,000,
// คืนยอดเสีย 0.3%, แนะนำเพื่อน 0.8% and 24 ชั่วโมง.
//
// Title and description are the brief's own Title/Description lines, used
// verbatim. A brief-supplied description is never padded up to the 150-char
// floor and never topped up from the H1/H2 — this one ships at the length the
// brief wrote it, which is a passing build (verify-build exempts the home page
// from DESC_MIN for exactly this reason), not a gap to fill.
const pageTitle = "LOTTOPLUS หวยออนไลน์ไม่ผ่านแอป แทงหวย ตรวจผล ฝากถอนปลอดภัย100%";

const pageDescription = "LOTTOPLUS หวยออนไลน์ไม่ผ่านแอป สมัครเข้าแทงหวย รัฐบาลไทย ลาวพัฒนา ฮานอย หวยหุ้น ตรวจผล ฝากถอนปลอดภัย100%";

// The docx has a real H2 -> H3 nesting this round, so the page is NOT flattened
// to H2-only. The four H3s are genuine docx headings — the two อัตราจ่าย
// sub-points and the two bonus sub-points, all of them nested under the
// โปรโมชั่นและอัตราจ่าย H2 — and they stay H3.
//
// The docx checklist, in document order, and what carries each one:
//    1 H1  LOTTOPLUS หวยออนไลน์ไม่ผ่านแอป แทงหวย ตรวจผล ฝากถอน ปลอดภัย100%
//          ContentBoxCyberCut, txt L4 + L5
//    2 H2  เข้าแทงหวย LOTTOPLUS รัฐบาลไทย ลาวพัฒนา ฮานอย หวยหุ้น ครบทุกแนว
//          ContentBoxTwoCyberCut, L7 left + L8 right
//    3 H2  โปรโมชั่นและอัตราจ่าย หวย LOTTOPLUS สุดพิเศษ
//          ContentBoxNeumorphism, L10
//    4 H3  อัตราจ่าย หวย 2ตัว100
//          ContentBoxSevenThreeCyberCut + slide1, L12
//    5 H3  อัตราจ่าย หวย 3ตัว1,000
//          ContentBoxSpecial, L14
//    6 H3  คืนยอดเสีย โบนัส 0.3%
//          ContentBox (plain), L16
//    7 H3  แนะนำเพื่อน โบนัส 0.8%
//          ContentBoxSevenThreeNeumorphism + slide4, L18
//    8 H2  สมัครแทงหวย LOTTOPLUS เข้าบัญชีบริษัทตรง ไม่ผ่านตัวแทน
//          ContentBoxTwoNeumorphism, L20 left + L21 right
//    9 H2  ติดต่อสอบถามแอดมินผู้ให้บริการ LOTTOPLUS ได้ 24 ชั่วโมง
//          ContentBoxCyberCut + LINE / สมัคร buttons, L23 + L24
//   10 H2  คำถามที่พบบ่อยเกี่ยวกับ LOTTOPLUS
//          Faq2 + faqs prop, L26-L31
// Final inventory for this page: h1 x1, h2 x5, h3 x4.
//
// Every docx paragraph ships in full. Sections 1, 2, 8 and 9 each have TWO
// paragraphs in the brief and both ship, nothing merged or summarised: in the
// two-column blocks they run one per column, in the single-column blocks they
// stack inside one wrapper div. Section 5's single paragraph is the one that is
// split, across ContentBoxSpecial's two halves, reproducing the sentence word
// for word with nothing added and nothing dropped.
//
// Everything else on the page is chrome and emits no heading tag at any level:
// LatestWinners4, LoginRtpSection and ReviewCardSumo render their titles as
// <p>/<span> with an aria-label on the section, and Faq2's questions live inside
// <summary> as <span>. The non-docx widgets sit before section 1
// (LatestWinners4, right after the ticker) and after section 10
// (LoginRtpSection, ReviewCardSumo) — never spliced between two docx sections.

// One array, used by both <Faq> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last. The three pairs
// are the brief's own Q/A block (content.txt L26-L31), verbatim.
const faqs = [
  {
    q: "LOTTOPLUS มีหวยประเภทไหนให้เลือกแทงบ้าง?",
    a: "สมาชิกสามารถเลือกหวยรัฐบาลไทย ลาวพัฒนา ฮานอย หวยหุ้น และรายการอื่นตามที่ระบบเปิดรับในแต่ละวัน โดยควรตรวจสอบเวลาปิดรับ อัตราจ่าย และรายละเอียดของรอบก่อนส่งโพยทุกครั้ง",
  },
  {
    q: "หวย 2 ตัว 100 และหวย 3 ตัว 1,000 ใช้กับหวยทุกประเภทหรือไม่?",
    a: "ไม่ควรถือว่าเป็นอัตราเดียวกันทุกประเภท อัตราจ่ายอาจแตกต่างตามรายการหวย รูปแบบการเดิมพัน และรอบที่เปิดรับ สมาชิกควรตรวจสอบตัวเลขที่ LOTTOPLUS แสดงในหน้าส่งโพยก่อนยืนยันรายการ",
  },
  {
    q: "LOTTOPLUS ต้องดาวน์โหลดแอปก่อนแทงหวยหรือไม่?",
    a: "หากระบบเปิดให้บริการผ่านเว็บไซต์ สมาชิกสามารถสมัคร Login เลือกหวย ส่งโพย และตรวจผลผ่านเว็บเบราว์เซอร์บนมือถือได้โดยไม่จำเป็นต้องติดตั้งแอป ควรเข้าผ่านช่องทางหลักของ LOTTOPLUS เพื่อหลีกเลี่ยงเว็บไซต์ที่ไม่เกี่ยวข้อง",
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// One highlight colour only: #fff4f4 against the body colour #f0e2e2, so the
// brand's red stays the page's structural accent and the paragraphs never
// compete with a heading for it.

// No breadcrumb: this is the homepage, so a trail from the root to itself would
// be a single self-referential crumb. Every URL in the graph is derived by
// pageGraph from `site:` — no domain is typed out in this file, and no Review /
// AggregateRating / sameAs / address node is passed.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <LatestWinners />

  <ContentBoxCyberCut as="h1" title="LOTTOPLUS หวยออนไลน์ไม่ผ่านแอป แทงหวย ตรวจผล ฝากถอน ปลอดภัย100%">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        LOTTOPLUS ให้บริการหวยออนไลน์ผ่านหน้าเว็บไซต์
        <strong class="text-[#fff4f4]">สามารถสมัครและเข้าใช้งานผ่านเบราว์เซอร์บนมือถือได้โดยไม่จำเป็นต้องติดตั้งแอป</strong>
        รวมหวยหลายประเภทไว้ในบัญชีเดียว ทั้งรัฐบาลไทย ลาวพัฒนา ฮานอย และหวยหุ้น สมาชิกสามารถเลือกเลข ส่งโพย ตรวจสอบรายการ ตรวจผลหวย รวมถึงจัดการฝากถอนผ่านระบบออนไลน์ได้สะดวก ก่อนทำรายการควรตรวจสอบรอบหวย อัตราจ่าย
        <strong class="text-[#fff4f4]">และข้อมูลบัญชีปลายทางทุกครั้ง</strong>
        เพื่อให้รายละเอียดตรงกับข้อมูลล่าสุดที่เว็บไซต์แสดง
      </p>
      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        สำหรับคำว่า “ปลอดภัย 100%”
        <strong class="text-[#fff4f4]">ควรมีมาตรการและข้อมูลที่ตรวจสอบได้รองรับ</strong>
        เนื่องจากไม่ควรรับประกันความปลอดภัยของระบบหรือธุรกรรมแบบสมบูรณ์จากข้อความโฆษณาเพียงอย่างเดียว
      </p>
    </div>
  </ContentBoxCyberCut>

  <ContentBoxTwoCyberCut
    as="h2"
    title="เข้าแทงหวย LOTTOPLUS รัฐบาลไทย ลาวพัฒนา ฮานอย หวยหุ้น ครบทุกแนว"
    titleleft="หวยที่เปิดรับในระบบ"
    titleright="ตรวจโพยและตรวจผล">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f0e2e2]">
      สมาชิก LOTTOPLUS
      <strong class="text-[#fff4f4]">สามารถเลือกแทงหวยได้หลายประเภทจากบัญชีเดียว</strong>
      เริ่มจากหวยรัฐบาลไทยตามรอบออกรางวัล หวยลาวพัฒนา หวยฮานอยตามรายการที่เปิดรับ และหวยหุ้นที่มีรอบเดิมพันแตกต่างกันในแต่ละวัน
      <strong class="text-[#fff4f4]">สามารถเลือกประเภทเลขและตรวจสอบเวลาปิดรับก่อนส่งโพยได้จากหน้าเว็บไซต์</strong>
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#f0e2e2]">
      หลังส่งรายการแล้วควรกลับมาตรวจสอบโพย เลขที่เลือก ยอดเดิมพัน
      <strong class="text-[#fff4f4]">และสถานะรายการให้เรียบร้อย</strong>
      ส่วนการตรวจผลควรอ้างอิงผลอย่างเป็นทางการของหวยแต่ละประเภท
      <strong class="text-[#fff4f4]">หากมีหลายรอบต่อวันควรตรวจสอบชื่อรายการและเวลาของรอบให้ตรงกันก่อนคำนวณผลรางวัล</strong>
    </p>
  </ContentBoxTwoCyberCut>

  <ContentBoxNeumorphism as="h2" title="โปรโมชั่นและอัตราจ่าย หวย LOTTOPLUS สุดพิเศษ">
    <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
      LOTTOPLUS
      <strong class="text-[#fff4f4]">มีทั้งอัตราจ่ายหวยและโปรโมชั่นสำหรับสมาชิก</strong>
      โดยสามารถตรวจสอบรายละเอียดของเลข 2 ตัว เลข 3 ตัว โบนัสคืนยอดเสีย และกิจกรรมแนะนำเพื่อนจากหน้าโปรโมชั่น อัตราจ่ายจริงอาจขึ้นอยู่กับประเภทหวย รูปแบบการแทง และรอบที่เปิดรับ
      <strong class="text-[#fff4f4]">จึงควรยึดตัวเลขที่ระบบแสดงก่อนยืนยันโพยเป็นหลัก</strong>
    </p>
  </ContentBoxNeumorphism>

  <ContentBoxSevenThreeCyberCut as="h3" title="อัตราจ่าย หวย 2ตัว100">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[340, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), 346px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นพื้นขาวเทาพาดริ้วโบว์แดงและขาว ด้านซ้ายเป็นหญิงสาวผมยาวสีเข้มในชุดขาวสลับดำถือสลากกินแบ่งของไทย ด้านขวาเป็นชายหนุ่มในสูทดำทับเชิ้ตขาวชี้นิ้วมาข้างหน้าและถือสลากเช่นกัน ด้านบนกลางภาพเป็นโลโก้ LOTTOPLUS ตัวอักษรขาวบนบล็อกแดง ถัดลงมาเป็นตัวอักษรไทยสีแดงขอบขาวขนาดใหญ่ว่า โปรโมชั่น และอัตราจ่าย ใต้ลงไปเป็นป้ายแคปซูลสีแดงคำว่า อัตราจ่าย หวย คร่อมตัวเลขขนาดใหญ่สีดำแดง 2ตัว100 รอบภาพมีลูกหวยสีแดงสลับขาวหมายเลข 9 6 3 และ 7 กับกองเหรียญทอง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#6b0207] shadow-[0_10px_30px_rgba(220,2,14,0.26)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f0e2e2]">
      หากรอบหวยที่เลือกกำหนดอัตราจ่าย หวย 2 ตัว 100
      <strong class="text-[#fff4f4]">สมาชิกสามารถตรวจสอบรายละเอียดได้จากหน้าส่งโพยก่อนยืนยันการเดิมพัน</strong>
      โดยควรดูให้ครบว่าอัตราดังกล่าวใช้กับหวยประเภทใด รูปแบบเลขใด และมีข้อกำหนดเพิ่มเติมหรือไม่
      <strong class="text-[#fff4f4]">เพราะหวยแต่ละรายการอาจใช้อัตราจ่ายไม่เท่ากัน</strong>
    </p>
  </ContentBoxSevenThreeCyberCut>

  <ContentBoxSpecial as="h3" title="อัตราจ่าย หวย 3ตัว1,000">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f0e2e2]">
      สำหรับรายการที่ LOTTOPLUS กำหนดอัตราจ่าย หวย 3 ตัว 1,000
      <strong class="text-[#fff4f4]">ควรตรวจสอบประเภทการเดิมพันและอัตราที่แสดงในรอบนั้นก่อนส่งโพย</strong>
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#f0e2e2]">
      โดยเฉพาะเลข 3 ตัวตรงและรูปแบบการเดิมพันอื่นที่อาจมีวิธีคำนวณเงินรางวัลแตกต่างกัน
      <strong class="text-[#fff4f4]">เพื่อให้ทราบอัตราจ่ายที่ใช้กับรายการของตนเองอย่างชัดเจน</strong>
    </p>
  </ContentBoxSpecial>

  <ContentBox as="h3" title="คืนยอดเสีย โบนัส 0.3%">
    <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
      สมาชิกที่มียอดเสียตรงตามเงื่อนไขสามารถตรวจสอบสิทธิ์รับโบนัสคืนยอดเสีย 0.3% ตามรอบที่ LOTTOPLUS กำหนด
      <strong class="text-[#fff4f4]">ระบบจะคำนวณจากยอดที่เข้าเกณฑ์และแสดงจำนวนโบนัสที่มีสิทธิ์รับ</strong>
      ควรตรวจสอบประเภทหวย รอบคำนวณ
      <strong class="text-[#fff4f4]">และเงื่อนไขล่าสุดก่อนกดรับโบนัสทุกครั้ง</strong>
    </p>
  </ContentBox>

