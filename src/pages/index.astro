---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import LatestWinners from "../components/LatestWinners3.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBox3ThreePremium from "../components/ContentBox3ThreePremium.astro";
import ContentBoxTwoFloatingBadge from "../components/ContentBoxTwoFloatingBadge.astro";
import Faq from "../components/Faq4.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import { pageGraph } from "../lib/schema";
import imgPromotions from "../assets/slide1.png";

// VARIANT ROTATION THIS ROUND, decided in .claude/brand-spec-somwang168.md §3 and
// NOT re-picked here: Announcement3 replaces Announcement5, LatestWinners3
// replaces LatestWinnersPremium, Faq4 replaces Faq2, ReviewCardSumo2 replaces
// ReviewCardSumo, and the ContentBox shape-mix leaves CyberCut / TwoPremium /
// SevenThreePremium / SevenThreeNeumorphism / Special / FloatingBadge behind for
// Premium / TwoNeumorphism / SevenThreeCyberCut / Neumorphism / 3ThreePremium /
// TwoFloatingBadge. NavbarStyle7 + FooterPremium are the layout's pair this round
// and the brand font moves google-sans -> kanit; all of that is the orchestrator's
// shared-chrome step, not this page's.
// Plain ContentBox is the one sanctioned carry-over (brand-spec §3): it is the
// always-live box that terms, privacy, 404 and the button pages render through, so
// it cannot follow a rotation. Section 4 is the single docx section it carries.
// ContentBoxTwo is live too but is NOT imported here — it is reached only through
// LoginRtpSection, so an "is it used?" grep has to match the bare filename.
// Every unused *Premium / *Cyber / *Huay / *FloatingBadge / *Style sibling, the
// other Faq* and Announcement* files, the other LatestWinners* and the previous
// ReviewCardSumo all stay on disk as inventory for the next brand — nothing was
// deleted, and the earlier brands' hues still inside them are expected drift.
//
// <Announcement /> runs bare on purpose: Announcement3's default message is already
// this brand's copy, set by the orchestrator from this brief, and every sub-page
// calls it bare too — so passing an override here is exactly how the ticker ends up
// saying two different things on two pages of the same site.
//
// PALETTE — DRAGON RED + THAI GOLD ON RED-BLACK (brand-spec §2). Read off the
// artwork: the logo is the word สมหวัง in chrome-white 3-D lettering with red edges
// followed by 168 in bold vivid-red 3-D numerals, wrapped in red flames and red
// Thai kanok scrollwork. The banner and slide1 are the same Thai-Chinese casino
// scene on black — flowing red satin, GOLD Thai kanok/naga scrollwork down both
// sides, a young man in a gold-embroidered black Thai outfit beside a woman in a
// red-and-gold dress, gold/red/black chip stacks, a roulette wheel and ace cards.
// ⚠️ The second hue this round is GOLD, not chrome: the silvery-blue inside the
// word สมหวัง is detail in the picture, and §2 forbids promoting it to a theme
// colour. There is no violet, blue, cyan, green, orange or pink in this drop.
// ⚠️ The page background is RED-BLACK #290f0f (bg.json), not the pure black of the
// last two brands. Depth ramp: #2c1413 raised / #1f0d0c mid / #140706 sunken /
// #290f0f page — mid and sunken sit BELOW the page colour, which is new this round.
// ⚠️ Compare by VALUE, never by colour family — RED is this round's trap, and it is
// sharper than usual because BOTH previous brands were red too: GT66B #fb141b
// (G=20) and TKB55 #fb131b (G=19). This brand's primary is #fa0513 (R=250 G=5
// B=19), measured from logo.webp in this drop, and is neither of those, nor
// SUPERSLOTCLUB #e8232a, PIGPG #d4200d or FLASH877 #ff3b14. The gold is the same
// story: #e3b23c is not TND168's #dfa310, UFA324's #e5a81b or KMD88's #e2b33f.
// Body copy is #f4ecea (= BRAND_TEXT), 15.4:1 on the page background and 14.9:1 on
// the raised surface. The ONE highlight colour a <strong> may take is #ffadaf
// (9.8:1) — unlike #e3b23c (8.9:1) and #ffe5a8 (14.1:1), which are heading and
// secondary values, and unlike #ff5a5f, which is links/hover and large headings.
// #fa0513, #b90203, #8c0204, #5b0203, #3c0303 and #8a6210 never carry text at any
// size: they are borders, plates, rules, gradient ends and glows. #170504 is the
// only ink allowed on a solid gold or solid red fill. Glow rgba is
// rgba(250,5,19,α), rgba(185,2,3,α), rgba(255,173,175,α), rgba(227,178,60,α) or
// rgba(255,229,168,α).
//
// IMAGE ROLES FOR THIS DROP (2026-10-17, brand-spec §4). ONE file is referenced
// from this page and only one. slide1.png is a 600x600 square split into two
// side-by-side panels in a single image: the LEFT panel prints โปรโมชั่น in huge
// 3-D gold type over a black plaque reading คืนยอดเสีย with 0.3% in vivid red, and
// the RIGHT panel prints โปรโมชั่น over a plaque reading แนะนำเพื่อน / โบนัส with
// 0.8% in vivid red. Because the one picture states BOTH offers, it pairs with the
// docx's H2 promotion OVERVIEW (§3) and not with either H3 underneath it — hanging
// it under §4 or §5 would make the picture contradict the heading above it.
// The alt below was written from THIS drop's artwork and is not a counter; the
// previous rounds' alt text described a burglar mascot / dragon glyph / chrome
// wordmark, none of which exist in this picture.
// Deliberately NOT imported, and every file still on disk as inventory: banner2.png
// (10-08) and banner3.png (09-27) are previous brands' article art, slide2.png
// (10-13) literally carries the previous brand's 龍GT66B wordmark printed on the
// image, and slide3/slide4.png (09-29) are an older brand's posters. An eager
// import IS an emit, rendered or not, so importing any of them would ship a
// competitor's picture into dist/ and turn verify-build red. There is therefore NO
// current-drop article illustration this round, and a slide is never substituted
// for one — the playbook pins slides to ContentBoxSevenThree* blocks only.
// banner1 and its mobile crop belong to MainLayout's own pinned globs and are never
// referenced from a page; og.png is the same, MainLayout owns it.
// slide1 is 600x600 on disk, so 600 is the top real candidate — anything above it
// would not be a real pixel — and the picture carries max-w-[600px] so the art is
// never upscaled past its own bitmap. The `sizes` list below is the 3fr column
// arithmetic from inside ContentBoxSevenThreeCyberCut itself (max-w-7xl section,
// p-8, gap-8, md:pl-8 + md:border-l), NOT last round's numbers, which came from two
// different variants that pay different padding:
//   >= 1280px : 312px            (1280-32-2-64-32) x 0.3 - 33 = 312
//   md..1279  : calc(30vw - 72px)
//   698..767  : 600px (bitmap cap)
//   < 698     : calc(100vw - 98px)
// Neither this nor anything else on the page is the LCP element — MainLayout's hero
// banner is — so the picture is loading="lazy" fetchpriority="low" decoding="async"
// and never takes fetchpriority="high". formats/fallbackFormat/quality stay at the
// house values: tools/avif-quality-service.mjs rescales AVIF quality on its own, so
// quality={80} must not be hand-tuned per format.
// Also deliberately unused, and named without the file extension on purpose because
// the playbook's "is this component live?" check is a bare-filename grep:
// ProviderGrid and GameRankingBoard have nothing to carry because the brief names no
// game studio and no ranking; SmoothCarousel has no brief section asking for a
// carousel and only one usable slide anyway; BankStrip already renders inside the
// active footer; and FeatureHighlights is explicitly banned this round by
// brand-spec §5, because its items render as <h3> and would add three headings the
// brief does not have.
//
// VOCABULARY — brand-spec §7, the brief's own words only. This is a PURE SLOT brand
// whose subject is the OPERATOR CONTACT CHANNEL, not a casino and not a sportsbook.
// Everything the copy says traces to src/assets/content.txt: ช่องทางติดต่อผู้ให้บริการ,
// เว็บเกมสล็อต, เกมสล็อตสั่งได้, 24 ชั่วโมง, ขอความช่วยเหลือ, การเข้าสู่ระบบ,
// ตรวจสอบบัญชี, การใช้งานเกม, เกมไม่แสดงผล, รายการเครดิตไม่ตรง, แจ้งรายละเอียดปัญหา,
// เวลาที่เกิดเหตุ, ข้อความแจ้งเตือน, ติดตามสถานะการแก้ไขปัญหา, เวลาตอบกลับ,
// หลักฐานประกอบ, ปิดบังข้อมูลสำคัญ, รหัสผ่าน, PIN, OTP, โบนัสคืนยอดเสีย 0.3%,
// โบนัสแนะนำเพื่อน 0.8%, ไม่จำกัด, ยอดที่เข้าเกณฑ์, รอบคำนวณ, รอบประจำวัน, เวลาตัดยอด,
// วิธีรับสิทธิ์, เกมที่ร่วมรายการ, การใช้โบนัส, ลิงก์แนะนำ, ระบบสมาชิก, สมัครสมาชิก,
// ชื่อโดเมน, ข้อมูลผู้ให้บริการ, รหัสผ่านที่คาดเดายาก, ยืนยันบัญชี, ข้อกำหนด,
// LINE Official, แอดมิน, บัญชีปลอม, ฝ่ายบริการลูกค้า.
// ⚠️ GT66B and TKB55 both sold themselves as คาสิโน + กีฬา. This brief does not say
// a single one of those words, and none of them survived here: the page was written
// FROM the brief rather than find-and-replaced over the old sentences. There is no
// บาคาร่า, ไฮโล, บอล/บอลออนไลน์/แทงบอล, อัตราต่อรอง, รายการแข่งขัน, ชื่อคู่แข่งขัน,
// คาสิโน, เซิร์ฟเวอร์ต่างประเทศ, ยอดเข้าบริษัทโดยตรง, ฝากถอนทุกธนาคาร, ไม่มีขั้นต่ำ,
// ถูกลิขสิทธิ์, ค่ายระดับเอเชีย or ได้มาตรฐาน anywhere on this page, and no lottery
// wording either.
// Nothing here claims a licence number, a regulator, a legal-entity name, a game
// studio, a bank, an RTP figure, a deposit minimum, a member count, a founding year
// or a server location, because the brief names none. The only figures on the page
// are the brief's own three: 0.3%, 0.8% and 24 ชั่วโมง.
// The brief hedges at least seven separate times (brand-spec §5) and every one of
// those clauses is part of its paragraph below, not trimmed as downbeat filler.
//
// The brief, the artwork and the operator's prompt all agree on the brand name. Even
// so the name is never typed on the page: it is interpolated from ${BRAND_NAME} so it
// can never drift from brandProfile. No domain is written out anywhere here and no
// URL is built with `+`.
//
// Title and description are the brief's own Title/Description lines (content.txt
// lines 1-2) verbatim, with the brand name interpolated. They are NOT padded up to
// 150 characters — the description is 133 and verify-build deliberately skips its
// 150-character floor on the home page for exactly this reason.
const pageTitle = `${BRAND_NAME} ช่องทางติดต่อผู้ให้บริการ เกมสล็อตสั่งได้ 24 ชั่วโมง`;

const pageDescription = `${BRAND_NAME} ช่องทางติดต่อผู้ให้บริการ เว็บเกมสล็อตสั่งได้ ผู้เล่นสามารถเข้ามาติดต่อ ขอความช่วยเหลือเกี่ยวกับการใช้งานได้ตลอด 24 ชั่วโมง`;

// The brief has a real H2 -> H3 nesting this round, so the page is NOT flattened to
// H2-only. The two H3s are the docx's own H3 lines — the two promotion sub-points
// that sit under section 3's โปรโมชั่น H2 in the brief's own outline. There is no
// FeatureHighlights H3 exception this round, and no component rendered here emits a
// hardcoded heading, so the printed h3 count stays at exactly 2.
//
// The checklist, in document order, and what carries each one:
//    1 H1  ${BRAND_NAME} ช่องทางติดต่อผู้ให้บริการ เว็บเกมสล็อตสั่งได้
//          ContentBoxPremium, brief paragraph on line 4
//    2 H2  ผู้เล่นสามารถเข้ามาติดต่อ ${BRAND_NAME} ขอความช่วยเหลือได้ตลอด 24 ชั่วโมง
//          ContentBoxTwoNeumorphism, line 6 left / line 7 right
//    3 H2  โปรโมชั่นเดิมพัน ${BRAND_NAME} จากผู้ให้บริการเว็บเกมสล็อต
//          ContentBoxSevenThreeCyberCut + slide1, line 9 left / picture right
//    4 H3  โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสทุกวัน
//          ContentBox (the plain, always-live variant), line 11
//    5 H3  โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด
//          ContentBoxNeumorphism, line 13
//    6 H2  สมัครเล่นสล็อต ${BRAND_NAME} ง่ายๆ 3 ขั้นตอน
//          ContentBox3ThreePremium heading={false}, line 15 intro + steps 16/17/18
//    7 H2  ช่องทางติดต่อแอดมิน ${BRAND_NAME} ทาง LINE OFFICIAL 24 ชม.
//          ContentBoxTwoFloatingBadge, line 20 left / line 21 right
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ${BRAND_NAME}
//          Faq4 + faqs prop, lines 23-28
// Final inventory for this page: h1 x1, h2 x5, h3 x2.
//
// SHAPE RHYTHM, top to bottom — no two adjacent sections read as the same card, and
// each neighbour pair differs in at least two of {corner, surface depth, heading
// treatment}:
//   §1 rounded-3xl GRADED from RAISED #2c1413 down to SUNKEN #140706 in a deep-gold
//      #8a6210 frame, two corner auras, heading gradient #ff5a5f -> #ffe5a8 ->
//      #e3b23c over a deep-red rule
//   §2 rounded-[30px] NEUMORPHIC on RAISED #2c1413 with NO frame and twin shadows
//      (#140706 pressed, #5b0203 lifted that climbs to #8c0204 on hover), heading
//      gradient #e3b23c -> #ff5a5f -> #ffe5a8, two columns split by a gold rule
//   §3 CLIPPED corners (30px, top-right/bottom-left) on flat MID #1f0d0c, four
//      corner rules crossing red against gold, heading SOLID #ffe5a8 behind a gold
//      ◆, picture in the 3fr right column
//   §4 rounded-3xl on flat RAISED #2c1413 with a gold top hairline and a 20px
//      underline bar, heading gradient #ffe5a8 -> #e3b23c -> #ff5a5f (the
//      always-live box; its treatment is fixed by the orchestrator)
//   §5 rounded-[25px] NEUMORPHIC on MID #1f0d0c inside a #3c0303 frame, twin shadows
//      with no hover change, heading SOLID #ff5a5f and CENTRED — the only heading on
//      the page that is both solid and centred
//   §6 rounded-3xl on flat RAISED #2c1413 in a gold frame, one top aura, a vertical
//      gold-to-red rail beside the heading, heading gradient #e3b23c -> #ffe5a8 ->
//      #ff5a5f, three columns with gold dividers and <p> step labels
//   §7 rounded-2xl GRADED from MID #1f0d0c up to RAISED #2c1413 in a 2px brand-red
//      frame, heading INVERTED into a floating SOLID GOLD plate carrying #170504 ink
//      — the opposite polarity of every other heading here
//   §8 clipped-free accordion rows on SUNKEN #140706 behind a title plate with a
//      gold left rail, heading gradient #ff5a5f -> #e3b23c -> #ffe5a8, questions
//      inside <summary> as <span>
// The two neumorphic cards (§2, §5) are three sections apart and differ in surface
// depth, corner radius, frame presence and heading treatment. The two flat raised
// rounded-3xl boxes (§4, §6) differ in column count, rail, aura and gradient
// direction. All five gradient headings run a different order of the same three
// ramps, and the three non-gradient headings (§3 solid gold, §5 solid red centred,
// §7 dark ink on gold) are each unique in a different way.
//
// ContentBoxSevenThreeCyberCut lays out md:grid-cols-[7fr_3fr] with the TEXT column
// FIRST, so the picture goes in slot="right": the heading always lands on the prose,
// never on the picture, and on a phone the single column reads heading, text,
// picture rather than opening with an image. It is passed no `titleright`, so the
// image column carries no heading and the block emits exactly one.
// ContentBoxTwoNeumorphism and ContentBoxTwoFloatingBadge are passed no `titleleft`/
// `titleright` either — the brief gives §2 and §7 two running paragraphs each with
// no sub-labels, and inventing a pair here would be this page's own wording rather
// than the docx's.
// ContentBox3ThreePremium is passed heading={false} on purpose: the brief writes its
// three steps as running prose ("ขั้นตอนที่ 1 เข้าหน้าสมัครสมาชิก เลือกเมนูสมัคร…"),
// not as labelled sub-headings with bodies, so the three column labels render as <p>
// and only the section's own as="h2" is a heading. Flipping that to true would put
// three h3s on the page that the brief does not have.
// ⚠️ §7's floating badge was re-checked against the REAL title this round, which at
// 49 advancing cells is the longest any *FloatingBadge has carried on this template.
// The arithmetic lives in ContentBoxTwoFloatingBadge's own frontmatter; the result
// is that pt-36 clears the wrapped badge by 72-84px at every breakpoint, so NO
// *FloatingBadge padding changed and the flat pt-36 stays in sync across all four
// files. There is no `whitespace-nowrap` in any of them.
//
// Every brief paragraph ships in full — nothing merged, nothing summarised, and
// every hedging clause is in place. §2, §6 and §7 run one paragraph (or one step)
// per column, and no slot receives more than one element, so the house rule's "one
// element per slot" holds everywhere without a wrapper <div> being needed this
// round.
//
// Everything else on the page is chrome and emits no heading tag at any level:
// Announcement3, LatestWinners3, LoginRtpSection and ReviewCardSumo2 render their
// titles as <p>/<span> with an aria-label on the section, and Faq4's questions live
// inside <summary> as <span>. The non-brief widgets sit before section 1 (the
// ticker, then the member-ledger feed) and after section 8 (LoginRtpSection,
// ReviewCardSumo2, Navfoot) — never spliced between two content sections.

// One array, used by both <Faq> and the FAQPage node — never the component's own
// defaults (Faq4 deliberately ships an empty list, so a forgotten prop renders an
// empty accordion rather than some previous brand's questions). The three pairs are
// the brief's own Q/A block (content.txt lines 23-28), verbatim.
const faqs = [
  {
    q: `${BRAND_NAME} ติดต่อผู้ให้บริการเพื่อขอความช่วยเหลือเรื่องอะไรได้บ้าง?`,
    a: `สามารถสอบถามเรื่องการเข้าสู่ระบบ การใช้งานบัญชี ปัญหาเกมสล็อต การตรวจสอบโปรโมชั่น และรายการที่ต้องการให้เจ้าหน้าที่ตรวจสอบ โดยควรแจ้งรายละเอียดปัญหาให้ครบถ้วนเพื่อช่วยให้การประสานงานตรงประเด็น`,
  },
  {
    q: `ติดต่อแอดมิน${BRAND_NAME} ผ่าน LINE Official ได้ตลอด 24 ชั่วโมงหรือไม่?`,
    a: `ข้อมูลที่กำหนดระบุว่ามีช่องทาง LINE Official สำหรับติดต่อแอดมินตลอด 24 ชั่วโมง ผู้เล่นควรตรวจสอบบัญชี LINE จากหน้าเว็บไซต์หลัก และพิจารณาเวลาตอบกลับจริงจากช่องทางที่ใช้งาน`,
  },
  {
    q: `โปรโมชั่น${BRAND_NAME} มีอะไรบ้าง และตรวจสอบสิทธิ์ได้อย่างไร?`,
    a: `โปรโมชั่นตามข้อมูลที่กำหนดมีคืนยอดเสีย 0.3% และแนะนำเพื่อนโบนัส 0.8% ผู้เล่นสามารถตรวจสอบยอดที่เข้าเกณฑ์ รอบรับสิทธิ์ และข้อกำหนดการใช้โบนัสจากหน้าโปรโมชั่นหรือสอบถามผ่านช่องทางบริการหลัก`,
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space that
// splits the word — the copy must read identically with the tags removed. No two
// <strong> elements are adjacent either: every pair is separated by at least one run
// of plain text, so the whitespace between them can never collapse into a missing
// space.
// One highlight colour only: #ffadaf, against the inherited body colour #f4ecea
// (BRAND_TEXT). The paragraphs below carry no colour class of their own: every
// ContentBox* card in this mix already sets
// `text-left text-base leading-relaxed text-[#f4ecea]` on the element holding the
// slot, so the prose inherits it and no page-level override can drift from the card.
// No paragraph carries mx-auto or max-w-* either — the cards cap their own width,
// and the only max-w-* on the page is the one capping the slide, which is an image
// and not prose. No slot's copy names a colour.

// No breadcrumb: this is the homepage, so a trail from the root to itself would be a
// single self-referential crumb. Every URL in the graph is derived by pageGraph from
// `site:` — no domain is typed out in this file, no URL is built with `+`, and no
// Review / AggregateRating / sameAs / address / email node is passed. `description`
// is the exact same string MainLayout gets, and `faqs` is the exact same array <Faq>
// gets.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <LatestWinners />

  <ContentBoxPremium as="h1" title={`${BRAND_NAME} ช่องทางติดต่อผู้ให้บริการ เว็บเกมสล็อตสั่งได้`}>
    <p>
