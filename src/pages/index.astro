---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ContentBoxHuay from "../components/ContentBoxHuay.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThreeHuay from "../components/ContentBoxSevenThreeHuay.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import Faq from "../components/FaqHuay.astro";
import LatestWinners from "../components/LatestWinnersHuay.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgBanner2 from "../assets/banner2.png";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// VARIANT ROTATION THIS ROUND (SEXYGAME666 -> LOTTO24). Zero file reuse from the
// previous round: AnnouncementHuay replaces Announcement5, LatestWinnersHuay
// replaces LatestWinnersCyber, FaqHuay replaces Faq3, and the ContentBox
// shape-mix moves to Huay / CyberCut / plain ContentBox / SevenThreeHuay /
// SevenThreeNeumorphism / Neumorphism / Special. NavbarHuay and FooterHuay are
// the layout's pair this round (previously NavbarCyber / FooterCyber). No
// *Premium variant is used at all — Premium was the outgoing brand's lead.
// Nothing was deleted; every outgoing variant file stays on disk as inventory
// for the next brand.
//
// IMAGE ROLES FOR THIS DROP (2026-09-28) — READ BEFORE REUSING THESE IMPORTS.
// Three files are referenced from this page and only three:
//   banner2.png — the article illustration whose Thai type reads "อัตราจ่าย
//     LOTTO24 3ตัวสูงสุด 1,000 2ตัว100", so it belongs to docx H2 #3 and sits
//     INSIDE that single-column ContentBox, width-capped at max-w-2xl. It is
//     1254 px square, so 1254 is the top candidate width.
//   slide1.png — the poster whose type reads "แนะนำเพื่อน" above a large
//     "โบนัส 0.8%", so it belongs to docx H3 #4.
//   slide2.png — the companion poster reading "คืนยอดเสีย" above "โบนัส 0.3%",
//     so it belongs to docx H3 #5.
// Both slides are 600 px wide, so 600 is the top candidate width — nothing
// above it would be a real pixel. Each slide sits in a ContentBoxSevenThree*
// image+text block, which is the family's hard cap of two per rebrand, so
// there is no third SevenThree here. The two blocks put the picture on
// OPPOSITE sides: SevenThreeHuay runs image-then-text, SevenThreeNeumorphism
// runs text-then-image.
//
// The alt text was written from THIS drop's artwork (black grounds shot with
// red, the LOTTO24 wordmark in chrome-silver LOTTO plus a red 24, red-and-white
// numbered lottery balls, stacks of gold coins, the woman in the white suit)
// and is NOT the previous brand's text — those posters were hot pink and violet
// neon with a pink-to-violet SEXYGAME666 wordmark, casino chips and playing
// cards, none of which is in these pictures.
//
// Deliberately NOT imported, and all still on disk as inventory:
//   banner3.png (2026-09-27), slide3.png (2026-09-18) and slide4.png
//   (2026-08-13) all predate this drop and carry a previous client's artwork.
//   banner1.png and banner1-mobile.png belong to MainLayout's own pinned globs
//   and are never referenced from a page — the hero is the LCP element, so
//   nothing here gets loading="eager" fetchpriority="high". og.png is the same:
//   MainLayout's glob owns it.
//
// DROPPED THIS ROUND, and none of the files deleted — every one is inventory
// for the next brand: ProviderGrid / FeaturedGames / PopularGamesStrip /
// GameRankingBoard each have to name specific studios, table names or payout
// figures that only a slot/casino brief supplies, and this is a หวย brief.
// BankStrip needs a named bank; the brief says only "วอลเลทและช่องทางบัญชี
// บริษัท" and names no bank. SmoothCarousel is out because it would put slide*
// outside a ContentBoxSevenThree*. FeatureHighlights is out because it emits an
// <h3> per item with its own title, and this round's two <h3> are real docx
// headings with their own slides — the 3 signup steps have no titles in the
// brief, only sentences, so they ship as a plain <ol> inside section 6's box.
// LottoGrid is lottery-specific and would have fitted the genre, but the only
// four-market list this page can honestly show is the one already in
// LoginRtpSection's payout table; naming the same four markets twice on one
// page is repetition, not content, so the table keeps them and the grid stays
// inventory.
//
// Vocabulary: this is a เว็บแทงหวย. Nothing on this page may say สล็อต, ค่ายเกม,
// RTP, ความผันผวน, บาคาร่า, ไลฟ์สด or เกมยิงปลา — the previous two brands on this
// template were a slot site and a live-baccarat site, and every one of those
// words is wrong now. LoginRtpSection's right-hand column was a slot RTP /
// volatility table and is a lottery payout table this round.
//
// Title and description are the brief's own Title/Description lines, used
// verbatim. A brief-supplied description is never padded up to the 150-char
// floor and never topped up from the H1/H2 — this one ships at 140 characters,
// the length the brief wrote it, which is a passing build (verify-build exempts
// the home page from DESC_MIN for exactly this reason), not a gap to fill.
const pageTitle = "LOTTO24 ราชาเว็บแทงหวย No.1 จ่ายสูงสุด 1,000 ไม่ลดเรท บช.บริษัท";

const pageDescription = "LOTTO24 ราชาเว็บแทงหวย No.1 อัตราจ่าย3ตัวสูงสุด 1,000 2ตัว100 จ่ายไม่อั้น ไม่ลดเรท ฝากถอนง่าย ผ่านวอลเลท ยอดเข้า บช.บริษัท โดยตรง ไม่ผ่านม้า";

// <Announcement /> runs bare: AnnouncementHuay's default message is already this
// brand's copy, and every sub-page calls it bare too — passing an override here
// is how the ticker ends up saying two different things on two pages.

// The docx has a real H2 -> H3 nesting this round: "แนะนำเพื่อน โบนัส 0.8%" and
// "คืนยอดเสีย โบนัส 0.3%" are genuine sub-points of the อัตราจ่าย/โปรโมชั่น H2, so
// the page is NOT flattened to H2-only. Those two are the only <h3> here, and
// each one is carried by its own ContentBoxSevenThree* block together with the
// slide whose artwork states that exact figure.
// Everything else is chrome and emits no heading tag: LatestWinnersHuay,
// LoginRtpSection and ReviewCardSumo2 render their titles as <p>/<span> with an
// aria-label on the section, and FaqHuay's questions live inside <summary>.
//
// The docx checklist, in order, and what carries each one:
//    1 H1  LOTTO24 ราชาเว็บแทงหวย No.1 จ่ายสูงสุด 1,000 ...        ContentBoxHuay
//    2 H2  LOTTO24 รับแทงหวยยอดเข้า บช.บริษัท โดยตรง ...          ContentBoxCyberCut
//    3 H2  อัตราจ่าย LOTTO24 3ตัวสูงสุด 1,000 2ตัว100 ...          ContentBox + banner2
//    4 H3  แนะนำเพื่อน โบนัส 0.8%                               ContentBoxSevenThreeHuay + slide1
//    5 H3  คืนยอดเสีย โบนัส 0.3%                                ContentBoxSevenThreeNeumorphism + slide2
//    6 H2  สมัครแทงหวย LOTTO24 แทงง่าย จ่ายทันที ไม่ต้องรอคิว        ContentBoxNeumorphism (intro + <ol>)
//    7 H2  ติดต่อเจ้าหน้าที่ LOTTO24 ผ่านช่องทางไลน์ได้ 24 ชั่วโมง      ContentBoxSpecial
//    8 H2  คำถามที่พบบ่อย                                       FaqHuay
// Final inventory for this page: h1 x1, h2 x5, h3 x2.
//
// Every docx paragraph ships in full. One block is a two-half shell, so the
// paragraph that fills it is split across its halves and nowhere else: item 7's
// single paragraph runs left half then right half and reproduces the sentence
// word for word; nothing is summarised, merged or repeated.
//
// The non-docx widgets sit before section 1 (LatestWinnersHuay, right after the
// hero) and after section 8 (LoginRtpSection, ReviewCardSumo2) — never spliced
// between two docx sections.
//
// The brief names only two figures beyond the payout rates — the 0.8% and 0.3%
// bonuses — and both appear only under the headings that state them. It names
// no lottery draw time, no licence number, no bank and no minimum stake, so
// neither does this page.

// One array, used by both <Faq> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last. The three pairs
// are the brief's own Q/A block, verbatim.
const faqs = [
  {
    q: "LOTTO24 เลข 2 ตัวและ 3 ตัวจ่ายเท่าไร?",
    a: "ตามข้อมูลที่กำหนด เลข 2 ตัวมีอัตราจ่าย 100 และเลข 3 ตัวสูงสุด 1,000 โดยอัตราจริงและเงื่อนไขอาจแตกต่างกันตามประเภทหวยและรอบที่เปิดรับ ควรตรวจสอบรายละเอียดก่อนยืนยันบิลทุกครั้ง",
  },
  {
    q: "LOTTO24 ทำรายการผ่านบัญชีบริษัทได้หรือไม่?",
    a: "ตามข้อมูลของเว็บไซต์ รองรับการทำรายการผ่านช่องทางบัญชีบริษัทโดยตรง รวมถึงวอลเลทตามรายการที่ระบบเปิดให้ใช้งาน สมาชิกควรตรวจสอบชื่อบัญชีและรายละเอียดจากช่องทางทางการก่อนทำรายการ",
  },
  {
    q: "LOTTO24 มีโปรโมชั่นอะไรบ้าง?",
    a: "โปรโมชั่นหลักตามข้อมูลที่กำหนดมีโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% โดยแต่ละรายการมีเงื่อนไขและรอบรับสิทธิ์แตกต่างกัน แนะนำให้ตรวจสอบหน้าโปรโมชั่นก่อนกดรับทุกครั้ง",
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// One highlight colour only: near-white #fff1f1 against the body colour
// #f6e2e2, so the brand's red and gold stay the page's structural accents and
// the paragraphs never compete with a heading for them.

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb. Every URL in the graph is derived
// by pageGraph from `site:` — no domain is typed out in this file, and no
// Review / AggregateRating / sameAs / address node is passed.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <LatestWinners />

  <ContentBoxHuay as="h1" title="LOTTO24 ราชาเว็บแทงหวย No.1 จ่ายสูงสุด 1,000 ไม่ลดเรท บช.บริษัท">
    <p class="text-left text-base leading-relaxed text-[#f6e2e2]">
      LOTTO24
      <strong class="text-[#fff1f1]">รวมบริการแทงหวยออนไลน์หลายประเภทไว้ในระบบเดียว</strong>
      พร้อมอัตราจ่ายที่ระบุชัดเจนทั้งเลข 2 ตัวและ 3 ตัว โดยเน้นรูปแบบไม่ลดเรทตามเงื่อนไขที่กำหนด
      <strong class="text-[#fff1f1]">รองรับการทำรายการผ่านวอลเลทและช่องทางบัญชีบริษัทโดยตรง</strong>
      ช่วยให้สมาชิกตรวจสอบข้อมูลก่อนยืนยันบิลได้สะดวกมากขึ้น
    </p>
  </ContentBoxHuay>

  <ContentBoxCyberCut as="h2" title="LOTTO24 รับแทงหวยยอดเข้า บช.บริษัท โดยตรง ไม่ผ่านม้า">
    <p class="text-left text-base leading-relaxed text-[#f6e2e2]">
      LOTTO24
      <strong class="text-[#fff1f1]">รองรับการทำรายการผ่านช่องทางบัญชีบริษัทตามข้อมูลที่เว็บไซต์กำหนด</strong>
      ช่วยให้สมาชิกตรวจสอบรายละเอียดบัญชีและสถานะรายการได้ชัดเจนก่อนดำเนินการ
      <strong class="text-[#fff1f1]">โดยไม่ต้องผ่านช่องทางบุคคลอื่น</strong>
      พร้อมระบบสมาชิกที่ช่วยติดตามยอด รายการย้อนหลัง และข้อมูลการแทงหวยได้จากหน้าเดียว
    </p>
  </ContentBoxCyberCut>

  <ContentBox as="h2" title="อัตราจ่าย LOTTO24 3ตัวสูงสุด 1,000 2ตัว100 และโปรโมชั่นอื่นๆ">
    <div class="flex flex-col gap-6">
      <p class="text-left text-base leading-relaxed text-[#f6e2e2]">
        LOTTO24
        <strong class="text-[#fff1f1]">ระบุอัตราจ่ายเลข 3 ตัวสูงสุด 1,000 และเลข 2 ตัว 100 ตามเงื่อนไขของแต่ละรายการ</strong>
        พร้อมโปรโมชั่นสำหรับสมาชิกให้เลือกเพิ่มเติม ทั้งโบนัสแนะนำเพื่อนและโบนัสคืนยอดเสีย
        <strong class="text-[#fff1f1]">ผู้ใช้งานสามารถตรวจสอบอัตราจ่าย รอบหวย และเงื่อนไขของโปรโมชั่นก่อนทำรายการได้ทุกครั้ง</strong>
      </p>
      <Picture
        src={imgBanner2}
        loading="lazy"
        fetchpriority="low"
        widths={[480, 672, 1254]}
        sizes="(max-width: 767px) calc(100vw - 96px), 672px"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
        alt="ภาพประกอบอัตราจ่ายพื้นดำโทนแดง ด้านซ้ายเป็นหญิงสาวผมยาวสีเข้มสวมสูทสีขาว ยกมือทั้งสองข้างรับข้อความ ด้านขวาเป็นโลโก้ LOTTO24 ที่คำว่า LOTTO เป็นสีเงินเมทัลลิกและเลข 24 เป็นสีแดง ถัดลงมาเป็นตัวอักษรไทยว่า อัตราจ่าย LOTTO24 ต่อด้วยคำว่า 3ตัวสูงสุด แล้วเป็นตัวเลขขนาดใหญ่ 1,000 สีแดงขอบทองที่มีมงกุฎทองวางอยู่มุมขวา ปิดท้ายด้วยแถบดำที่เขียนว่า 2ตัว100 รอบภาพมีลูกหวยสีแดงสลับขาวหมายเลข 6 9 24 17 และ 8 กับกองเหรียญทองกระจายอยู่"
        class="mx-auto h-auto w-full max-w-2xl rounded-2xl border border-[#a16207]/55 shadow-[0_10px_30px_rgba(251,191,36,0.24)]"
      />
    </div>
  </ContentBox>

  <ContentBoxSevenThreeHuay as="h3" titleright="แนะนำเพื่อน โบนัส 0.8%">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[340, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), 386px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นพื้นดำโทนแดง ด้านซ้ายเป็นหญิงสาวผมยาวสีเข้มสวมสูทสีขาว ชี้นิ้วชี้ทั้งสองข้างมาที่ข้อความ ด้านขวาบนเป็นโลโก้ LOTTO24 ที่คำว่า LOTTO เป็นสีเงินเมทัลลิกและเลข 24 เป็นสีแดง ถัดลงมาเป็นตัวอักษรไทยสีขาวว่า แนะนำเพื่อน ต่อด้วยคำว่า โบนัส สีแดงข้างไอคอนคนกับลูกศรชี้ขึ้น แล้วปิดท้ายด้วยตัวเลขขนาดใหญ่ 0.8% สีแดงขอบทอง มุมล่างมีลูกหวยสีแดงสลับขาวหมายเลข 24 และ 6 กับกองเหรียญทองกระจายอยู่"
      class="mx-auto h-auto w-full rounded-2xl border border-[#a16207]/55 shadow-[0_10px_30px_rgba(251,191,36,0.24)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f6e2e2]">
      สมาชิก LOTTO24
      <strong class="text-[#fff1f1]">ที่แนะนำเพื่อนเข้ามาสมัครสามารถรับโบนัส 0.8% ตามเงื่อนไขของโปรโมชั่น</strong>
      ระบบมีรายละเอียดเกี่ยวกับยอดที่เข้าเกณฑ์และวิธีรับสิทธิ์ให้ตรวจสอบ
      <strong class="text-[#fff1f1]">ช่วยให้ติดตามโบนัสจากการแนะนำเพื่อนได้สะดวกผ่านบัญชีสมาชิก</strong>
    </p>
  </ContentBoxSevenThreeHuay>

  <ContentBoxSevenThreeNeumorphism as="h3" titleleft="คืนยอดเสีย โบนัส 0.3%">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f6e2e2]">
      โปรโมชั่นคืนยอดเสีย LOTTO24
      <strong class="text-[#fff1f1]">ให้โบนัส 0.3% ตามยอดและเงื่อนไขที่กำหนด</strong>
      สมาชิกสามารถตรวจสอบรอบคำนวณ ยอดที่เข้าเกณฑ์ และรายละเอียดก่อนกดรับสิทธิ์
      <strong class="text-[#fff1f1]">ช่วยให้ติดตามโบนัสในแต่ละรอบได้ง่ายและรู้ข้อมูลก่อนนำสิทธิ์ไปใช้งาน</strong>
    </p>
    <Picture
      slot="right"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[340, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), 360px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นชุดเดียวกันพื้นดำโทนแดง ด้านซ้ายเป็นหญิงสาวผมยาวสีเข้มสวมสูทสีขาว ชี้นิ้วมาที่ข้อความ ด้านขวาบนเป็นโลโก้ LOTTO24 ที่คำว่า LOTTO เป็นสีเงินเมทัลลิกและเลข 24 เป็นสีแดง ถัดลงมาเป็นตัวอักษรไทยสีขาวว่า คืนยอดเสีย ต่อด้วยคำว่า โบนัส สีแดง แล้วปิดท้ายด้วยตัวเลขขนาดใหญ่ 0.3% สีแดงขอบทองที่มีลูกศรโค้งวางอยู่ใต้ตัวเลข ฉากหลังมีใบสลากกินแบ่งและมุมล่างมีลูกหวยสีแดงสลับขาวหมายเลข 24 6 และ 8 กับกองเหรียญทองกระจายอยู่"
      class="mx-auto h-auto w-full rounded-2xl border border-[#a16207]/55 shadow-[0_10px_30px_rgba(251,191,36,0.24)]"
    />
  </ContentBoxSevenThreeNeumorphism>

  <ContentBoxNeumorphism as="h2" title="สมัครแทงหวย LOTTO24 แทงง่าย จ่ายทันที ไม่ต้องรอคิว">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed text-[#f6e2e2]">
        การสมัครแทงหวย LOTTO24
        <strong class="text-[#fff1f1]">สามารถทำผ่านหน้าเว็บไซต์ได้ด้วยตัวเอง</strong>
