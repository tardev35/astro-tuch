    />
  </ContentBoxSevenThree>

  <ContentBoxFloatingBadge as="h2" title={`สมัครเล่น ${BRAND_NAME} ไม่มีขั้นต่ำ 3 ขั้นตอน`}>
    <div class="flex flex-col gap-4">
      <p>
        {BRAND_NAME}
