---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBox3ThreePremium from "../components/ContentBox3ThreePremium.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import Faq4 from "../components/Faq4.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import LatestWinners from "../components/LatestWinners4.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide2 from "../assets/slide2.png";

// Title and description are the brief's own Title/Description lines, verbatim.
// A brief-supplied description ships at whatever length it was written — it is
// not padded up to the 150-character floor.
const pageTitle = "FAH999 เกมสล็อตเว็บที่ดีที่สุด เล่นง่าย จ่ายจริง เข้าเล่นได้ทุกวัน";

const pageDescription = "FAH999 เกมสล็อตเว็บที่ดีที่สุด แนะนำเกมสล็อต เล่นง่าย เข้าเล่นได้ทุกวัน พร้อมโปรโบนัสสูง 0.8% รับได้ทุกวัน";

// The ticker copy is passed explicitly rather than relying on the component's
// default — every Announcement* variant's default belongs to whichever brand
// wired it in last. The string matches Announcement5's current default on
// purpose, so the pages that call <Announcement /> bare show the same ticker.
// No emoji in this string: an emoji baked into a text prop cannot be given its
// own aria-hidden span, and this marquee prints the string twice.
const announcement =
  "FAH999 เกมสล็อตเว็บที่ดีที่สุด เล่นง่าย จ่ายจริง เข้าเล่นได้ทุกวัน • รวมสล็อตธีมเอเชีย เกมโบนัส และเกมที่ออกแบบมาให้เล่นบนมือถือ • โปรโบนัสสูง 0.8% รับได้ทุกวันตามเงื่อนไขของกิจกรรม • รองรับทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์ • แอดมิน FAH999 ดูแลสมาชิกตลอด 24 ชั่วโมง";

// One array, used by both <Faq4> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last.
const faqs = [
  {
    q: "มือใหม่ควรเริ่มเล่นสล็อต FAH999 เกมไหนดี?",
    a: "สามารถเริ่มจากเกมที่มีกติกาเข้าใจง่าย แล้วอ่าน Paytable และรายละเอียดฟีเจอร์ก่อนเล่น เช่น Fortune Tiger ที่ใช้วงล้อ 3x3 หรือเลือก Mahjong Ways 2 หากชอบระบบ Free Spins และตัวคูณ ทั้งนี้ควรเลือกจากรูปแบบเกมที่ชอบมากกว่าคำกล่าวอ้างว่าเกมใด “แตกง่าย”",
  },
  {
    q: "FAH999 โบนัส 0.8% รับได้อย่างไร?",
    a: "สมาชิกควร Login และตรวจสอบหน้าโปรโมชั่นเพื่อดูว่ายอดหรือกิจกรรมใดเข้าเงื่อนไขโบนัส 0.8% พร้อมอ่านรอบการคำนวณและข้อกำหนดก่อนกดรับ เนื่องจากรายละเอียดโปรโมชั่นอาจมีการเปลี่ยนแปลงได้",
  },
  {
    q: "หากเล่นสล็อตแล้วฝากถอนมีปัญหาต้องทำอย่างไร?",
    a: "ตรวจสอบสถานะรายการในบัญชี FAH999 ก่อน หากเครดิตยังไม่เข้าหรือรายการถอนยังค้าง ให้ติดต่อแอดมินพร้อมแจ้งเวลา จำนวนเงิน และรายละเอียดธุรกรรม เพื่อช่วยให้เจ้าหน้าที่ค้นหารายการและตรวจสอบปัญหาได้รวดเร็วขึ้น",
  },
];

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <SmoothCarousel />

  <ContentBoxNeumorphism as="h1" title="FAH999 เกมสล็อตเว็บที่ดีที่สุด เข้าเล่นง่าย จ่ายให้ทุกวัน">
    <p class="text-left text-base leading-relaxed text-[#e6cfe9]">
      <strong class="text-[#fdeaf8]">FAH999</strong> เป็นจุดรวมเกมสล็อตออนไลน์สำหรับผู้ที่ต้องการเลือกเล่นเกมหลากหลายรูปแบบผ่านมือถือและคอมพิวเตอร์ มีทั้งสล็อตธีมเอเชีย เกมโบนัส และเกมที่ออกแบบมาให้เล่นบนมือถือ
      พร้อมโปรโมชั่นสำหรับสมาชิกตามเงื่อนไข ระบบรองรับการฝากถอนและการจัดการบัญชีออนไลน์ หากพบปัญหาระหว่างใช้งานสามารถติดต่อแอดมินเพื่อขอคำแนะนำและตรวจสอบรายการได้ตลอด 24 ชั่วโมง
    </p>
  </ContentBoxNeumorphism>

  <ContentBoxPremium as="h2" title="แนะนำเกมสล็อต FAH999 ที่นิยมเล่นมากที่สุด">
    <p class="text-left text-base leading-relaxed text-[#e6cfe9]">
      สำหรับคนที่ยังไม่รู้ว่าจะเริ่มจากเกมไหนดี สามารถลองดู 3 เกมจาก PG SOFT ได้แก่ Mahjong Ways 2, Fortune Tiger และ Lucky Neko ซึ่งแต่ละเกมมีรูปแบบแตกต่างกัน ทั้งระบบฟรีสปิน ตัวคูณ และรูปแบบวงล้อ
      ก่อนเลือกเล่นควรดูรายละเอียดของเกมและเลือกจำนวนเดิมพันให้เหมาะกับงบประมาณของตัวเอง
    </p>
  </ContentBoxPremium>

  <ContentBox3ThreePremium
    titleleft="Mahjong Ways 2 สล็อตไพ่นกกระจอก พร้อมฟรีสปินและตัวคูณ"
    titlecenter="Fortune Tiger สล็อตเสือทอง รูปแบบ 3 รีล เข้าใจง่าย"
    titleright="Lucky Neko สล็อตแมวกวักญี่ปุ่น ฟีเจอร์โบนัสหลากหลาย">
    <p slot="left" class="text-left text-base leading-relaxed text-[#e6cfe9]">
      Mahjong Ways 2 เป็นสล็อตธีมไพ่นกกระจอกของ PG SOFT ใช้รูปแบบ 5 รีล พร้อมฟีเจอร์ Wild และ Free Spins โดยเมื่อเข้าโหมดฟรีสปิน ตัวคูณสามารถเพิ่มขึ้นตามรูปแบบของเกม
      เหมาะกับคนที่ชอบสล็อตธีมเอเชียและระบบโบนัสที่มีรายละเอียดให้ติดตามระหว่างเล่น
    </p>
    <p slot="center" class="text-left text-base leading-relaxed text-[#e6cfe9]">
      Fortune Tiger มาในธีมเสือทองและสัญลักษณ์มงคล ตัวเกมใช้รูปแบบ 3 รีล 3 แถว มีฟีเจอร์ Respin และตัวคูณ x10 ตามเงื่อนไขของเกม รูปแบบหน้าจอไม่ซับซ้อน
      จึงเป็นอีกตัวเลือกสำหรับผู้ที่ต้องการเกมที่ทำความเข้าใจกติกาได้ไม่ยาก และรองรับทั้งมือถือกับเว็บ HTML5
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#e6cfe9]">
      Lucky Neko เป็นเกมสล็อตธีมญี่ปุ่นที่ใช้แมวกวักนำโชคเป็นตัวละครหลัก มีระบบ Free Spins และตัวคูณภายในเกม จากข้อมูลเกมของ PG SOFT ตัวเกมจัดอยู่ในกลุ่มธีม Classic / Asian / Japanese
      และมีรายละเอียดเกี่ยวกับระดับ RTP ให้ผู้เล่นตรวจสอบก่อนเลือกเดิมพัน เหมาะสำหรับคนที่ชอบภาพสีสันสดใสและธีมมงคลแบบญี่ปุ่น
    </p>
  </ContentBox3ThreePremium>

  <ProviderGrid />

  <ContentBoxSevenThreeNeumorphism as="h2" title="โปรสล็อต FAH999 โบนัสสูง 0.8% รับได้ทุกวัน">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์แนวนอน พื้นหลังคาสิโนแสงนีออนสีชมพูม่วง ด้านบนเป็นโลโก้ FAH999 พร้อมสัญลักษณ์โพดำ กลางภาพเขียนว่า โปรโมชั่น แนะนำเพื่อน 0.8% เป็นตัวอักษรไทยสีขาวเรืองแสง ด้านขวาเป็นผู้หญิงผมบลอนด์สวมชุดซาตินสีชมพู มุมล่างซ้ายมีกล่องของขวัญสีชมพู กองชิปคาสิโน เหรียญทอง และอัญมณีสีชมพู ฉากหลังมีป้ายนีออน BIG WIN และวงล้อสล็อตเลข 777"
      class="mx-auto h-auto w-full rounded-2xl border border-[#c2249b]/50 shadow-[0_10px_30px_rgba(194,36,155,0.28)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#e6cfe9]">
      สมาชิก FAH999 สามารถตรวจสอบโปรโมชั่นที่เปิดให้รับผ่านหน้าเว็บไซต์ โดยโปรโมชั่นหลักตามข้อมูลที่กำหนดคือโบนัส <span class="font-black text-[#c98cff]">0.8%</span>
      ซึ่งสิทธิ์ในการรับโบนัสควรเป็นไปตามยอดและเงื่อนไขของกิจกรรม สมาชิกควรตรวจสอบรอบคำนวณ ยอดที่นำมาคิดโบนัส และข้อกำหนดการถอนก่อนกดรับทุกครั้ง เพื่อให้เข้าใจรายละเอียดของโปรโมชั่นอย่างครบถ้วน
    </p>
  </ContentBoxSevenThreeNeumorphism>

  <ContentBoxTwoCyberCut as="h2" title="ติดขัดปัญหา ติดต่อแอดมิน FAH999 แก้ไขปัญหาให้ได้ทันที" titleleft="แจ้งปัญหาที่พบระหว่างใช้งาน" titleright="สอบถามข้อมูลสำหรับสมาชิกใหม่">
    <p slot="left" class="text-left text-base leading-relaxed text-[#e6cfe9]">
      หากพบปัญหา Login ไม่ได้ ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินล่าช้า โปรโมชั่นไม่แสดง หรือเข้าเกมสล็อตไม่ได้ สามารถติดต่อแอดมิน FAH999 พร้อมแจ้งรายละเอียดของรายการและช่วงเวลาที่เกิดปัญหา
      เพื่อให้ทีมงานตรวจสอบได้ตรงจุด
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#e6cfe9]">
      รวมถึงสามารถสอบถามข้อมูลเกี่ยวกับเกม โปรโมชั่น และขั้นตอนการใช้งานสำหรับสมาชิกใหม่ได้
    </p>
  </ContentBoxTwoCyberCut>

  <Faq4 title="คำถามที่พบบ่อยเกี่ยวกับ FAH999" faqs={faqs} />

  <LoginRtpSection />

  <LatestWinners />

  <ReviewCardSumo2 />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#ffb3e2] via-[#fb44b3] to-[#c2249b] px-4 py-3 text-sm font-black whitespace-nowrap text-[#0d0114] shadow-[0_10px_30px_rgba(194,36,155,0.3)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(251,68,179,0.44)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#6b1fa8]/75 bg-gradient-to-r from-[#2a0640] to-[#0d0114] px-4 py-3 text-sm font-black whitespace-nowrap text-[#fdeaf8] shadow-[0_10px_30px_rgba(194,36,155,0.18)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#fb44b3]/80 hover:text-[#fb44b3] hover:shadow-[0_15px_40px_rgba(194,36,155,0.32)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>
  </div>

  <Navfoot />
</MainLayout>
