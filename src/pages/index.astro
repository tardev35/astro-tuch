---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import LatestWinners from "../components/LatestWinnersCyber.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import Faq from "../components/Faq3.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import { pageGraph } from "../lib/schema";
import imgCashback from "../assets/slide1.png";
import imgReferral from "../assets/slide2.png";

// VARIANT ROTATION THIS ROUND (HI59 -> BOOM369), per brand-spec §3. Zero file
// reuse from the previous round except the one noted below: AnnouncementCyber
// replaces Announcement2, LatestWinnersCyber replaces LatestWinners4, Faq3
// replaces Faq2, and the ContentBox shape-mix moves off CyberCut / TwoCyberCut /
// FloatingBadge / SevenThreeCyberCut x2 / TwoFloatingBadge onto Premium /
// TwoNeumorphism / Neumorphism / SevenThreePremium / SevenThreeNeumorphism /
// TwoPremium. NavbarCyber and FooterCyber are the layout's pair this round
// (previously NavbarStyle6 / FooterStyle3) and the brand font moves
// google-sans -> kanit; all three are the orchestrator's shared-chrome step,
// not this page's.
// ContentBoxSpecial is the ONE deliberate carry-over: it is the only box in the
// library with an `actions` slot, which section 7's LINE + สมัครสมาชิก button row
// needs. Plain ContentBox is the other always-live file — terms, privacy, 404 and
// every button page render their body through it by rule and cannot follow a
// rotation, so the orchestrator rethemes it in the shared step; this page does
// not render it at all this round.
// Every unused *CyberCut / *FloatingBadge / *Huay / Style file, Faq2,
// Announcement2 and LatestWinners4 stay on disk as inventory for the next brand —
// none of them was deleted, and the previous brand's copy and colour still inside
// them is expected drift, not a bug. ReviewCardSumo2 is reused rather than rotated
// to ReviewCardSumo because this page owns it and rewrote every row from the new
// brief; the rotation rule is about shape families with live siblings, and the
// review ledger's only sibling is the shape this one replaced.
//
// <Announcement /> runs bare on purpose: AnnouncementCyber's default message is
// already this brand's copy and every sub-page calls it bare too, so passing an
// override here is exactly how the ticker ends up saying two different things on
// two pages of the same site.
//
// POLARITY OF THIS BRAND (brand-spec §2). BOOM369 is a DARK brand and this round
// is a polarity FLIP back from HI59, which was the template's first light brand
// (pale sky cards #f6fbff / #e7f2fd / #d3e7fa, navy ink #0d2744 / #04203f /
// #065a9c / #0a84e0, gold #fdbc04 / #ffe27a). None of that survives on this page
// or in any component it renders. logo.webp is a neon-green BOOM + chrome-silver
// 369 in a green-to-teal ring, banner1 and both slides are a near-black hall lit
// by green neon with gold chips and coins, and bg.json is {"mode":"color",
// "color":"#000000"} — a pure black page background. So the content cards are
// dark green-black (#0b231b raised / #07170f mid / #041109 deep) with body copy
// #cfe9d7 (= BRAND_TEXT), and gold #f3c44a appears only as a sparing accent,
// never as a second brand hue.
// Highlights below are the neon accent #42fb5a — 14.6:1 on #07170f, which is safe
// for body-size highlight text, unlike the mid green #04ab3a that §2 pins to
// borders and gradient stops only.
//
// IMAGE ROLES FOR THIS DROP (2026-10-07 21:16, brand-spec §5). Two files are
// referenced from this page and only two, and each pairing is read off the
// artwork itself:
//   slide1.png — square green-neon hall, BOOM369 logo top-LEFT, the word
//     โปรโมชั่น with a gold crown under it on the left, a dark plaque reading
//     "คืนยอดเสีย 0.3%" with the figure in gold, and the model on the RIGHT
//     holding her open palm out — so it belongs to docx H3 #4. Imported as
//     imgCashback.
//   slide2.png — the same set mirrored, BOOM369 logo top-RIGHT, โปรโมชั่น and a
//     dark plaque reading "แนะนำเพื่อน 0.8%" on the right, and the model on the
//     LEFT in a white-and-green suit jacket reaching toward the viewer — so it
//     belongs to docx H3 #5. Imported as imgReferral.
// Both files are 600x600, so 600 is the top real candidate — nothing above it
// would be a real pixel — and each picture carries max-w-[600px] so the art is
// never upscaled past its own bitmap. Each slide sits in a ContentBoxSevenThree*
// image+text block, which is that family's hard cap of two per rebrand, so there
// is no third SevenThree anywhere on the site.
// The two blocks mirror each other: SevenThreePremium lays out
// md:grid-cols-[3fr_7fr] so its picture goes in slot="left" while the paragraph
// keeps the wide column, and SevenThreeNeumorphism lays out md:grid-cols-[7fr_3fr]
// so its picture goes in slot="right". The two pictures therefore alternate sides
// instead of stacking down the same edge, and each `sizes` describes its own 3fr
// column rather than the viewport. Both figures are copied from the arithmetic
// block in the component that owns the column — if a padding/gap/cap changes
// there, these move with it:
//   SevenThreePremium:     max-w-7xl/1280px cap, px-4(32), md:p-10(80), gap-10(40),
//                          and NO inner padding on the image column
//                          -> (1280 - 32 - 80 - 40) x 0.3 = 1128 x 0.3 = 338px
//   SevenThreeNeumorphism: max-w-[1400px] cap, px-4(32), p-8(64), gap-8(32), and
//                          the image column adds md:pl-8(32)
//                          -> (1400 - 32 - 64 - 32) x 0.3 - 32 = 381.6 - 32 = 350px
// Below md both cards collapse to one column at p-8, so the drawn width is
// 100vw - 32 (section px-4) - 64 (card p-8) = calc(100vw - 96px), capped at 600px.
// Neither picture is the LCP element — MainLayout's hero banner is — so both are
// loading="lazy" fetchpriority="low" decoding="async".
//
// The alt text was written from THIS drop's artwork per brand-spec §5, not carried
// over: the two slides are a near-black hall of green neon with gold casino chips
// and coins, not the bright daylight skies of the previous drop.
//
// Deliberately NOT imported, and every file still on disk:
//   banner2.png / banner3.png / slide3.png / slide4.png all predate this drop and
//   belong to previous brands — importing any of them would emit a competitor's
//   artwork into dist/, so there is no inline article illustration this round.
//   banner1.png and banner1-mobile.png belong to MainLayout's own pinned globs and
//   are never referenced from a page. og.png is the same: MainLayout owns it.
// Also deliberately unused: FeatureHighlights.astro (it renders sub-points as <h3>,
// and the brief's heading inventory allows exactly two H3s — sections 4 and 5 — so
// wiring it in would break the count), and the ContentBox3Three* family (no brief
// section on this page is a three-way split; every section is one or two running
// paragraphs).
//
// Vocabulary (brand-spec §4): BOOM369 is a สล็อต / คาสิโนออนไลน์ brand, NOT a
// lottery site. The words this page may use are the brief's own: สล็อต, เบทต่ำ,
// ทุนน้อย, ไม่มีขั้นต่ำ, ค่ายตรง, ถูกลิขสิทธิ์, เกมคลาสสิก, ฟรีสปิน, โบนัส, ตัวคูณ,
// วงล้อ, ตารางจ่าย, ช่วงเดิมพัน, เกมเปิดใหม่, บัญชีเดียว, เครดิต, โปรโมชั่น,
// คืนยอดเสีย 0.3%, แนะนำเพื่อน 0.8%, สมัคร 3 ขั้นตอน, Login, แอดมิน 24 ชั่วโมง, PIN,
// OTP, ประวัติรายการ, ฝากถอน.
// The previous brand's vocabulary is banned and gone (ไฮคลาส, VIP, ส่งตรงจากเว็บแม่,
// ยอดเข้าบริษัทตรง, ไม่ผ่านบัญชีม้า, ค่ายเกมพรีเมียม), as is every lottery word
// (หวย, โพย, เลขเด็ด, แนวทาง, งวด, อัตราจ่าย) — the page was written from the new
// brief rather than find-and-replaced over the old sentences. Nothing here claims a
// licence, a regulator, an operator, a bank, a game studio, an RTP figure, a
// deposit minimum, a member count or a founding year, because the brief names
// none. The only figures are the brief's own: 0.3%, 0.8%, 100%, 24 ชั่วโมง,
// 3 ขั้นตอน. The brief's own hedging ships with the copy ("ไม่มีขั้นต่ำ" ควรอ้างอิง
// จากเกมที่เปิดให้บริการจริง · "โบนัสสูง ให้เยอะกว่าใคร" ควรมีข้อมูลเปรียบเทียบรองรับ ·
// "เล่นสล็อตไม่จำกัดยอด" ควรอ้างอิงวงเงินของแต่ละเกม · ค่ายตรงและถูกลิขสิทธิ์ควรมี
// รายชื่อผู้ให้บริการที่ตรวจสอบได้) — it is part of the paragraphs, not trimmed as
// downbeat filler.
//
// Title and description are the brief's own Title/Description lines, used verbatim
// and NOT padded up to 150: verify-build deliberately skips its 150-character floor
// on the home page for exactly this reason. The brand name is interpolated rather
// than typed so it can never drift from brandProfile, and no domain is written out
// anywhere in this file.
const pageTitle = `${BRAND_NAME} สุดยอดเกมสล็อตเบทต่ำ เว็บเดิมพัน ทางเข้าหลัก ปลอดภัย100%`;

const pageDescription = `${BRAND_NAME} สุดยอดเกมสล็อตเบทต่ำ มีทุนน้อยก็เล่นได้ เว็บเดิมพัน ทางเข้าหลัก รวมเกมค่ายตรง ถูกลิขสิทธิ์ ปลอดภัย100%`;

// The brief has a real H2 -> H3 nesting this round, so the page is NOT flattened to
// H2-only. The two H3s are genuine headings — the two bonus sub-points, both nested
// under section 3's โปรโมชั่น H2 — and they stay H3.
//
// The checklist, in document order, and what carries each one:
//    1 H1  BOOM369 สุดยอดเกมสล็อตเบทต่ำ รวมเกมค่ายตรง ถูกลิขสิทธิ์
//          ContentBoxPremium, brief paragraph on line 4
//    2 H2  BOOM369 เว็บเล่นสล็อต ไม่มีขั้นต่ำ มีทุนน้อยก็เล่นได้
//          ContentBoxTwoNeumorphism, line 6 left / line 7 right
//    3 H2  โปรโมชั่นเล่นสล็อต BOOM369 โบนัสสูง ให้เยอะกว่าใคร
//          ContentBoxNeumorphism, line 9
//    4 H3  คืนยอดเสีย โบนัส 0.3%
//          ContentBoxSevenThreePremium + slide1 (imgCashback), line 11
//    5 H3  แนะนำเพื่อน โบนัส 0.8%
//          ContentBoxSevenThreeNeumorphism + slide2 (imgReferral), line 13
//    6 H2  สมัครเว็บ BOOM369 เล่นสล็อตไม่จำกัดยอด 3 ขั้นตอน
//          ContentBoxTwoPremium, line 15 left / line 16 right
//    7 H2  ติดต่อแอดมิน BOOM369 เว็บหลักได้ 24 ชั่วโมง
//          ContentBoxSpecial + LINE / สมัครสมาชิก buttons, lines 18 + 19
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ BOOM369
//          Faq3 + faqs prop, lines 21-26
// Final inventory for this page: h1 x1, h2 x5, h3 x2.
//
// Shape rhythm, top to bottom: gradient slab with a neon left rail -> neumorphic
// two-column plate on the raised surface -> neumorphic single plate on the mid
// surface with a centered heading -> 3:7 gradient card with the picture on the
// LEFT -> 7:3 neumorphic plate on the deep surface with the picture on the RIGHT
// -> two-column glass card with two rails -> two icon halves plus a button row ->
// accordion. No shape repeats back to back, the three neumorphic plates are
// separated by surface depth (#0b231b / #07170f / #041109) rather than by heading
// colour alone, and each of the eight headings runs a different colour sequence so
// no two cards read as the same card twice.
//
// ContentBoxSevenThreePremium takes the docx heading through `title`, which falls
// back to its wide (7fr) RIGHT text column; its image column is passed no
// `titleleft`, so the block emits exactly one heading. ContentBoxSevenThreeNeumorphism
// is the mirror and takes its heading through `title` too, which falls back to the
// wide LEFT column, with no `titleright` on the picture.
//
// Every brief paragraph ships in full — all eleven of them, nothing merged or
// summarised. Sections 2, 6 and 7 have two paragraphs each and run one per column;
// sections 1, 3, 4 and 5 have one each. The column labels passed to the two
// two-column boxes are this page's own layout wording, not brief headings, and
// both variants render them as <p>.
//
// Everything else on the page is chrome and emits no heading tag at any level:
// AnnouncementCyber, LatestWinnersCyber, LoginRtpSection and ReviewCardSumo2 render
// their titles as <p>/<span> with an aria-label on the section, and Faq3's questions
// live inside <summary> as <p>. The non-brief widgets sit before section 1 (the
// ticker, then the winners feed) and after section 8 (LoginRtpSection,
// ReviewCardSumo2, Navfoot) — never spliced between two content sections.

// One array, used by both <Faq> and the FAQPage node — never the component's own
// defaults, which belong to whichever brand shipped last. The three pairs are the
// brief's own Q/A block (content.txt lines 21-26), verbatim.
const faqs = [
  {
    q: `${BRAND_NAME} มีเกมสล็อตเบทต่ำสำหรับคนทุนน้อยหรือไม่?`,
    a: `${BRAND_NAME} มีเกมสล็อตที่รองรับการเดิมพันยอดต่ำตามรายการของแต่ละค่าย เหมาะกับผู้ที่ต้องการแบ่งงบเป็นรอบ แต่ยอดขั้นต่ำจะแตกต่างกันตามเกม จึงควรตรวจสอบตัวเลขภายในเกมก่อนเริ่มเล่น`,
  },
  {
    q: `${BRAND_NAME} เล่นสล็อตแบบไม่มีขั้นต่ำได้ทุกเกมหรือไม่?`,
    a: `ไม่จำเป็นต้องเหมือนกันทุกเกม เพราะค่ายและเกมสล็อตแต่ละรายการสามารถกำหนดเดิมพันขั้นต่ำและสูงสุดต่างกัน หากต้องการเล่นด้วยยอดต่ำควรเลือกเกมจากช่วงเดิมพันที่ระบบแสดงและกำหนดงบไว้ล่วงหน้า`,
  },
  {
    q: `${BRAND_NAME} มีโปรโมชั่นอะไรสำหรับสมาชิก?`,
    a: `โปรโมชั่นหลักตามข้อมูลที่กำหนดมี คืนยอดเสีย 0.3% และ แนะนำเพื่อน 0.8% โดยแต่ละรายการมีเกณฑ์คำนวณ รอบรับสิทธิ์ และเงื่อนไขแตกต่างกัน ควรตรวจสอบรายละเอียดล่าสุดจากระบบ ${BRAND_NAME} ก่อนกดรับโบนัส`,
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space that
// splits the word — the copy must read identically with the tags removed.
// One highlight colour only: #42fb5a, the neon accent, against the inherited body
// colour #cfe9d7 (BRAND_TEXT). The paragraphs below carry no colour class of their
// own: every ContentBox* card in this mix already sets
// `text-left text-base leading-relaxed text-[#cfe9d7]` on the element holding the
// slot, so the prose inherits it and no page-level override can drift from the
// card. No paragraph carries mx-auto or max-w-* either — the cards cap their own
// width.

// No breadcrumb: this is the homepage, so a trail from the root to itself would be a
// single self-referential crumb. Every URL in the graph is derived by pageGraph from
// `site:` — no domain is typed out in this file, and no Review / AggregateRating /
// sameAs / address / email node is passed.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <LatestWinners />

  <ContentBoxPremium as="h1" title={`${BRAND_NAME} สุดยอดเกมสล็อตเบทต่ำ รวมเกมค่ายตรง ถูกลิขสิทธิ์`}>
    <p>
      {BRAND_NAME}
      <strong class="text-[#42fb5a]">สุดยอดเกมสล็อตเบทต่ำที่รวบรวมเกมหลายรูปแบบไว้ในระบบเดียว</strong>
      เหมาะกับสายสล็อตที่ต้องการเริ่มจากยอดเดิมพันไม่สูง มีทั้งเกมคลาสสิก ฟรีสปิน โบนัส ตัวคูณ และสล็อตเปิดใหม่จากค่ายที่ระบบรองรับ
      <strong class="text-[#42fb5a]">สามารถเข้าเล่นผ่านมือถือได้สะดวก พร้อมเลือกเกมตามช่วงเดิมพันที่ต้องการ</strong>
      ส่วนการระบุว่าเป็นเกมค่ายตรงและถูกลิขสิทธิ์ ควรมีรายชื่อผู้ให้บริการหรือข้อมูลสิทธิ์การให้บริการที่สามารถตรวจสอบได้ประกอบ
    </p>
  </ContentBoxPremium>

  <ContentBoxTwoNeumorphism as="h2" title={`${BRAND_NAME} เว็บเล่นสล็อต ไม่มีขั้นต่ำ มีทุนน้อยก็เล่นได้`} titleleft="เกมเบทต่ำและการคุมงบต่อรอบ" titleright="ข้อควรรู้เรื่องยอดขั้นต่ำ">
    <p slot="left">
      {BRAND_NAME}
      <strong class="text-[#42fb5a]">เว็บเล่นสล็อตที่มีเกมเบทต่ำให้เลือก เหมาะกับผู้ที่มีทุนน้อยและต้องการแบ่งงบเล่นเป็นรอบ</strong>
      สามารถเลือกเกมจากยอดเดิมพันขั้นต่ำที่ระบบกำหนด
      <strong class="text-[#42fb5a]">พร้อมตรวจสอบตารางจ่าย ฟีเจอร์โบนัส ฟรีสปิน และรายละเอียดของแต่ละเกมก่อนเริ่ม</strong>
      ทำให้ควบคุมจำนวนเงินต่อรอบได้ง่ายกว่าเลือกเกมโดยไม่ดูช่วงเดิมพัน
    </p>
    <p slot="right">
      <strong class="text-[#42fb5a]">คำว่า ไม่มีขั้นต่ำ ควรอ้างอิงจากเกมที่เปิดให้บริการจริง</strong>
      เนื่องจากเกมสล็อตแต่ละค่ายกำหนดยอดเดิมพันต่ำสุดไม่เท่ากัน บางเกมอาจเริ่มด้วยยอดต่ำมาก ขณะที่บางเกมใช้ขั้นต่ำสูงกว่า
      <strong class="text-[#42fb5a]">จึงควรยึดตัวเลขที่แสดงภายในเกมเป็นหลักและกำหนดงบก่อนเล่นทุกครั้ง</strong>
    </p>
  </ContentBoxTwoNeumorphism>

  <ContentBoxNeumorphism as="h2" title={`โปรโมชั่นเล่นสล็อต ${BRAND_NAME} โบนัสสูง ให้เยอะกว่าใคร`}>
    <p>
      โปรโมชั่นเล่นสล็อต {BRAND_NAME}
      <strong class="text-[#42fb5a]">มีสิทธิ์ให้สมาชิกเลือกตามแคมเปญที่เปิดในแต่ละช่วง</strong>
      ทั้งโบนัสจากยอดที่เข้าเงื่อนไขและกิจกรรมแนะนำเพื่อน
      <strong class="text-[#42fb5a]">สามารถ Login เพื่อตรวจสอบโปรโมชั่น ยอดคำนวณ และสถานะการรับสิทธิ์จากบัญชีได้โดยตรง</strong>
      ส่วนคำว่า โบนัสสูง ให้เยอะกว่าใคร ควรมีข้อมูลเปรียบเทียบรองรับ หากไม่มีควรยึดจำนวนโบนัสและเงื่อนไขจริงของแต่ละรายการเป็นหลัก
    </p>
  </ContentBoxNeumorphism>

  <ContentBoxSevenThreePremium as="h3" title="คืนยอดเสีย โบนัส 0.3%">
    <Picture
      slot="left"
      src={imgCashback}
      loading="lazy"
      fetchpriority="low"
      widths={[338, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), (max-width: 1311px) calc(30vw - 46px), 338px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
