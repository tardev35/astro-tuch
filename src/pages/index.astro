---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import LatestWinners from "../components/LatestWinners2.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxTwoFloatingBadge from "../components/ContentBoxTwoFloatingBadge.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import ContentBox from "../components/ContentBox.astro";
import Faq from "../components/Faq4.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgCashback from "../assets/slide2.png";
import imgReferral from "../assets/slide1.png";

// VARIANT ROTATION THIS ROUND (DM899 -> UP555). Zero file reuse from the previous
// round: Announcement5 replaces Announcement3, LatestWinners2 replaces
// LatestWinners4, Faq4 replaces Faq2, ReviewCardSumo replaces ReviewCardSumo2,
// and the ContentBox shape-mix moves off Premium / TwoPremium / FloatingBadge /
// SevenThreePremium / SevenThreeFloatingBadge / Special onto Neumorphism /
// TwoFloatingBadge / CyberCut / SevenThreeNeumorphism / SevenThreeCyberCut /
// TwoCyberCut. NavbarStyle7 and FooterPremium are the layout's pair this round
// (previously NavbarStyle9 / FooterStyle3).
// Plain ContentBox is the one deliberate carry-over: terms, privacy, 404 and
// every button page render their body through it by rule and cannot follow a
// rotation, so it is always-live and the orchestrator rethemes it in the shared
// step — this page only passes it props.
// Every Premium / FloatingBadge / Huay / Style file, Faq2, Announcement3,
// LatestWinners4, ReviewCardSumo2, NavbarStyle9 and FooterStyle3 stay on disk as
// inventory for the next brand — none of them was deleted, and the previous
// brand's copy and colour still inside them is expected drift, not a bug.
//
// <Announcement /> runs bare on purpose: Announcement5's default message is
// already this brand's copy and every sub-page calls it bare too, so passing an
// override here is exactly how the ticker ends up saying two different things on
// two pages of the same site.
//
// IMAGE ROLES FOR THIS DROP (2026-10-03). Two files are referenced from this page
// and only two, and each pairing is read off the artwork itself:
//   slide2.png — gold-on-black promotion art whose plaque under the big gold
//     โปรโมชั่น wordmark reads "คืนยอดเสีย โบนัส" with a huge 0.3%, so it belongs
//     to docx H3 #4. Imported as imgCashback.
//   slide1.png — the same gold-on-black set with a black gold-edged plaque that
//     reads "แนะนำเพื่อน โบนัส 0.8%", so it belongs to docx H3 #5. Imported as
//     imgReferral.
// Both files measure 600x600, so 600 is the top real candidate width — nothing
// above it would be a real pixel — and each picture carries max-w-[600px] so the
// art is never upscaled past its own bitmap. Each slide sits in a
// ContentBoxSevenThree* image+text block, which is that family's hard cap of two
// per rebrand, so there is no third SevenThree anywhere on the site.
// The two blocks mirror each other: SevenThreeNeumorphism lays out
// md:grid-cols-[7fr_3fr] so its picture goes in slot="right" while the paragraph
// keeps the wide column, and SevenThreeCyberCut lays out md:grid-cols-[3fr_7fr]
// so its picture goes in slot="left". The two pictures therefore alternate sides
// instead of stacking down the same edge, and each `sizes` describes its own 3fr
// column rather than the viewport:
//   SevenThreeNeumorphism: max-w-[1400px] cap, px-4, p-8, gap-8, and the image
//                          column adds md:pl-8 + a 1px border
//                          -> (1400 - 32 - 64 - 32) x 0.3 - 33 = 348px
//   SevenThreeCyberCut:    max-w-7xl/1280px cap, px-4, p-8, gap-8, no inner
//                          padding on the image column
//                          -> (1280 - 32 - 64 - 32) x 0.3 = 345px
// Below md both cards collapse to one column at p-8, so the drawn width is
// 100vw - 32 (section px-4) - 64 (card p-8) = 100vw - 96px, capped at 600px.
// Neither picture is the LCP element — MainLayout's hero banner is — so both are
// loading="lazy" fetchpriority="low".
//
// The alt text was written from THIS drop's artwork: both slides are 600x600
// portraits of a model in white against a black-and-gold casino set, with the
// UP555 logo (a chrome-silver U holding a gold arrow inside a tilted gold
// ellipse, then chrome UP and gold 555) in the upper area, a large gold Thai
// โปรโมชั่น wordmark under it, and that slide's own offer plaque beneath.
//
// Deliberately NOT imported, and every file still on disk:
//   banner2.png / banner3.png / slide3.png / slide4.png all predate this drop and
//   belong to previous brands — importing any of them would emit a competitor's
//   artwork into dist/, so there is no inline article illustration this round.
//   banner1.png and banner1-mobile.png belong to MainLayout's own pinned globs
//   and are never referenced from a page. og.png is the same: MainLayout owns it.
//
// Vocabulary: UP555 is a คาสิโน/สล็อต brand, not a lottery site — หวย is one of
// the game categories the brief lists, nothing more. The words this page may use
// are the brief's own: คาสิโนอัปเดตล่าสุด, ทางเข้าเล่นใหม่, ระบบอัปเกรด, สล็อต,
// บาคาร่า, บอล (เดิมพันฟุตบอล), หวย, บัญชีเดียว, หมวดเกม, เครดิต, โปรโมชั่น,
// ประวัติรายการ, คืนยอดเสีย 0.3%, แนะนำเพื่อน 0.8%, ลิงก์แนะนำ, รอบตัดยอด,
// ยอดที่เข้าเกณฑ์, สมัคร 3 ขั้นตอน, Login, ยืนยันตัวตน, แอดมิน 24 ชั่วโมง, PIN, OTP.
// The previous brand's angle (เว็บตรงต่างประเทศ, บัญชีบริษัทแท้ 100%, การันตีระบบเกม
// มาตรฐาน, ค่ายเกม, คาสิโนสด) is gone, and so is the lottery vocabulary two brands
// back (โพย, งวด, อัตราจ่าย, เลข 2 ตัว / 3 ตัว, ฮานอย, ลาวพัฒนา, หวยหุ้น, แนวทางหวย,
// ตรวจหวย). The page was written from the brief rather than find-and-replaced over
// the old sentences. Nothing here claims a licence, a regulator, an operator, a
// bank, a game studio, a deposit minimum, a member count, a founding year or an
// RTP figure, because the brief names none. The only figures are the brief's own:
// 0.3%, 0.8%, 3 ขั้นตอน, 24 ชั่วโมง. The brief's own hedging ships with the copy
// (ผลการเดิมพันมีความไม่แน่นอน จึงไม่สามารถรับประกันผลกำไรหรือเงินรางวัลได้ · ไม่ควรใช้
// คำว่า "ปลอดภัยแน่นอน" เป็นการรับประกันโดยไม่มีข้อมูลรองรับ) — it is part of the
// paragraphs, not trimmed as downbeat.
//
// Title and description are the brief's own Title/Description lines, used
// verbatim and NOT padded up to 150: verify-build deliberately skips its
// 150-character floor on the home page for exactly this reason.
const pageTitle = "UP555 คาสิโนอัปเดตล่าสุด ทางเข้าเล่นใหม่ ระบบอัปเกรด ปลอดภัย ได้เงินจริง";

const pageDescription = "UP555 คาสิโนอัปเดตล่าสุด ปรับปรุงทางเข้าเล่นเกมคาสิโนใหม่ สล็อต บาคาร่า บอล หวย ครบทุกประเภท ระบบอัปเกรด ปลอดภัย ได้เงินจริง";

// The brief has a real H2 -> H3 nesting this round, so the page is NOT flattened
// to H2-only. The two H3s are genuine headings — the two promotion sub-points,
// both nested under the โปรโมชั่น H2 — and they stay H3.
//
// The checklist, in document order, and what carries each one:
//    1 H1  UP555 คาสิโนอัปเดตล่าสุด ปรับปรุงทางเข้าเล่นเกมคาสิโนใหม่
//          ContentBoxNeumorphism, brief paragraph on line 4
//    2 H2  UP555 สล็อต บาคาร่า บอล หวย ครบทุกประเภท ระบบอัปเกรดใหม่ ปลอดภัยแน่นอน
//          ContentBoxTwoFloatingBadge, line 6 left / line 7 right
//    3 H2  โปรโมชั่นเล่นคาสิโน UP555 ครบทุกเกม
//          ContentBoxCyberCut, line 9
//    4 H3  โปรโมชั่น คืนยอดเสีย โบนัส 0.3%
//          ContentBoxSevenThreeNeumorphism + slide2 (imgCashback), line 11
//    5 H3  โปรโมชั่น แนะนำเพื่อน โบนัส 0.8%
//          ContentBoxSevenThreeCyberCut + slide1 (imgReferral), line 13
//    6 H2  สมัครเดิมพัน UP555 คาสิโนบนมือถือง่ายๆ 3ขั้นตอน
//          ContentBoxTwoCyberCut, line 15 left / line 16 right
//    7 H2  ติดต่อแอดมิน UP555 ผู้ให้บริการเว็บคาสิโน 24 ชั่วโมง
//          ContentBox + LINE / สมัครสมาชิก buttons, lines 18+19
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ UP555
//          Faq4 + faqs prop, lines 21-26
// Final inventory for this page: h1 x1, h2 x5, h3 x2.
//
// ContentBoxTwoCyberCut defaults to as="p" so a chrome usage stays out of the
// heading inventory — section 6 therefore passes as="h2" explicitly.
//
// Every brief paragraph ships in full — all eleven of them, nothing merged or
// summarised. Sections 2 and 6 have two paragraphs each and run one per column;
// section 7 has two and they stack inside one wrapper div so the slot still
// receives exactly one element. The column labels passed to the two two-column
// boxes are this page's own layout wording, not brief headings, and both variants
// render them as <p>.
//
// Everything else on the page is chrome and emits no heading tag at any level:
// Announcement5, LatestWinners2, LoginRtpSection and ReviewCardSumo render their
// titles as <p>/<span> with an aria-label on the section, and Faq4's questions
// live inside <summary> as <span>. The non-brief widgets sit before section 1
// (the ticker, then the winners feed) and after section 8 (LoginRtpSection,
// ReviewCardSumo, Navfoot) — never spliced between two content sections.

// One array, used by both <Faq> and the FAQPage node — never the component's own
// defaults, which belong to whichever brand shipped last. The three pairs are the
// brief's own Q/A block, verbatim.
const faqs = [
  {
    q: "UP555 มีเกมอะไรให้เลือกเล่นบ้าง?",
    a: "UP555 รวมเกมหลายประเภทตามที่ระบบเปิดให้บริการ เช่น สล็อต บาคาร่า เดิมพันฟุตบอล และหวย สมาชิกสามารถเลือกหมวดเกมจากบัญชีเดียว โดยรายการเกมและผู้ให้บริการอาจมีการอัปเดตหรือเปลี่ยนแปลงตามช่วงเวลา",
  },
  {
    q: "ทางเข้า UP555 ใหม่แตกต่างจากระบบเดิมอย่างไร?",
    a: "หาก UP555 มีการอัปเกรดทางเข้าใหม่ สมาชิกควรตรวจสอบประกาศจากช่องทางหลักของเว็บไซต์เพื่อดูรายละเอียดการเปลี่ยนแปลง เช่น หน้า Login เมนูเกม หรือระบบบัญชี และควรหลีกเลี่ยงลิงก์ที่ไม่สามารถยืนยันแหล่งที่มาได้",
  },
  {
    q: "โปรโมชั่น UP555 โบนัส 0.3% และ 0.8% ต่างกันอย่างไร?",
    a: "โบนัส 0.3% เป็นโปรโมชั่นคืนยอดเสียจากยอดที่ตรงตามเงื่อนไข ส่วนโบนัส 0.8% เป็นกิจกรรมแนะนำเพื่อนจากยอดที่เข้าเกณฑ์ ทั้งสองรายการอาจกำหนดเกมที่ร่วมรายการและรอบคำนวณแตกต่างกัน ควรตรวจสอบเงื่อนไขล่าสุดก่อนรับสิทธิ์",
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// One highlight colour only: #fce675, the brand's bright gold, against the
// inherited body colour #f8eed9 (BRAND_TEXT). The paragraphs below carry no
// colour class of their own: every ContentBox* card in this mix already sets
// `text-left text-base leading-relaxed text-[#f8eed9]` on the element holding
// the slot, so the prose inherits it and no page-level override can drift from
// the card.

// No breadcrumb: this is the homepage, so a trail from the root to itself would
// be a single self-referential crumb. Every URL in the graph is derived by
// pageGraph from `site:` — no domain is typed out in this file, and no Review /
// AggregateRating / sameAs / address node is passed.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <LatestWinners />

  <ContentBoxNeumorphism as="h1" title="UP555 คาสิโนอัปเดตล่าสุด ปรับปรุงทางเข้าเล่นเกมคาสิโนใหม่">
    <p>
      <strong class="text-[#fce675]">UP555 คาสิโนอัปเดตล่าสุด ปรับปรุงทางเข้าเล่นเกมคาสิโนใหม่ให้รองรับการใช้งานผ่านมือถือได้สะดวกขึ้น</strong>
      รวมเกมหลายประเภทไว้ในบัญชีเดียว ทั้งสล็อต บาคาร่า บอล และหวย สมาชิกสามารถเลือกหมวดเกม ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการผ่านระบบเดียว พร้อมปรับส่วนการเข้าสู่ระบบและเมนูต่าง ๆ ให้ค้นหาเกมที่ต้องการได้ง่ายขึ้น อย่างไรก็ตาม
      <strong class="text-[#fce675]">ผลการเดิมพันมีความไม่แน่นอน จึงไม่สามารถรับประกันผลกำไรหรือเงินรางวัลจากการเล่นได้</strong>
    </p>
  </ContentBoxNeumorphism>

  <ContentBoxTwoFloatingBadge
    as="h2"
    title="UP555 สล็อต บาคาร่า บอล หวย ครบทุกประเภท ระบบอัปเกรดใหม่ ปลอดภัยแน่นอน"
    titleleft="หมวดเกมที่รวมไว้ในบัญชีเดียว"
    titleright="ข้อความด้านความปลอดภัยที่ควรพิจารณา">
    <p slot="left">
      <strong class="text-[#fce675]">UP555 รวมเกมเดิมพันหลายรูปแบบไว้ให้เลือกตามความสนใจ</strong>
      ตั้งแต่เกมสล็อตที่มีธีมและฟีเจอร์แตกต่างกัน บาคาร่าออนไลน์ ตลาดเดิมพันฟุตบอล ไปจนถึงหวยตามรายการที่ระบบเปิดให้บริการ การอัปเกรดระบบช่วยจัดหมวดหมู่เกมและเมนูสำคัญให้เข้าถึงได้ง่าย
      <strong class="text-[#fce675]">สามารถสลับประเภทเกมผ่านบัญชีเดียวโดยไม่ต้องสมัครใหม่หลายครั้ง</strong>
    </p>
    <p slot="right">
      <strong class="text-[#fce675]">ด้านความปลอดภัยควรพิจารณาจากมาตรการที่ตรวจสอบได้</strong>
      เช่น การรักษาความปลอดภัยของบัญชี ระบบยืนยันตัวตน และข้อมูลผู้ดำเนินงาน
      <strong class="text-[#fce675]">จึงไม่ควรใช้คำว่า “ปลอดภัยแน่นอน” เป็นการรับประกันโดยไม่มีข้อมูลดังกล่าวรองรับ</strong>
    </p>
  </ContentBoxTwoFloatingBadge>

  <ContentBoxCyberCut as="h2" title="โปรโมชั่นเล่นคาสิโน UP555 ครบทุกเกม">
    <p>
      <strong class="text-[#fce675]">โปรโมชั่น UP555 มีสิทธิพิเศษสำหรับสมาชิกตามแคมเปญที่เปิดให้รับในแต่ละช่วง</strong>
      โดยสามารถ Login เพื่อตรวจสอบรายการล่าสุดจากบัญชีได้ มีทั้งโปรโมชั่นคืนยอดเสียและกิจกรรมแนะนำเพื่อน แต่ละรายการอาจกำหนดประเภทเกม ยอดที่ใช้คำนวณ รอบตัดยอด และระยะเวลารับโบนัสแตกต่างกัน
      <strong class="text-[#fce675]">จึงควรอ่านรายละเอียดก่อนเลือกรับโปรโมชั่นทุกครั้ง</strong>
    </p>
  </ContentBoxCyberCut>

  <ContentBoxSevenThreeNeumorphism as="h3" title="โปรโมชั่น คืนยอดเสีย โบนัส 0.3%">
    <p slot="left">
      <strong class="text-[#fce675]">สมาชิกที่มียอดเสียตรงตามเงื่อนไขสามารถตรวจสอบสิทธิ์รับโบนัสคืนยอดเสีย 0.3% ตามรอบที่ UP555 กำหนด</strong>
      ระบบจะนำเฉพาะยอดที่เข้าเกณฑ์มาคำนวณก่อนแสดงโบนัสที่สามารถรับได้
      <strong class="text-[#fce675]">ควรตรวจสอบว่าเกมสล็อต บาคาร่า บอล หรือเกมประเภทใดร่วมรายการ รวมถึงรอบตัดยอดก่อนกดรับสิทธิ์</strong>
    </p>
    <Picture
      slot="right"
      src={imgCashback}
      loading="lazy"
      fetchpriority="low"
      widths={[348, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), (max-width: 1431px) calc(30vw - 72px), 348px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="ภาพโปรโมชั่นของ UP555 พื้นหลังสีดำอมทอง มีประกายทองและเหรียญทองลอยกระจาย ด้านซ้ายเป็นหญิงสาวผมยาวสีน้ำตาล สวมชุดสีขาวประดับทองและสร้อยคอ ชี้นิ้วมือขวาขึ้นและยื่นมือซ้ายแบออกมาข้างหน้า ด้านล่างมีกองเหรียญทองและไพ่ มุมบนเป็นโลโก้ UP555 ตัว U สีเงินโครเมียมมีลูกศรทองล้อมด้วยวงรีทอง ตามด้วย UP สีเงินและ 555 สีทอง ถัดลงมาเป็นมงกุฎทองและตัวอักษรไทยสีทองขนาดใหญ่ว่า โปรโมชั่น ใต้ลงมาเป็นป้ายคาดข้อความ คืนยอดเสีย โบนัส กับตัวเลข 0.3% ขนาดใหญ่"
      class="mx-auto h-auto w-full max-w-[600px] rounded-2xl border border-[#ebbb54]/60 shadow-[0_10px_30px_rgba(235,187,84,0.26)]"
    />
  </ContentBoxSevenThreeNeumorphism>

  <ContentBoxSevenThreeCyberCut as="h3" title="โปรโมชั่น แนะนำเพื่อน โบนัส 0.8%">
    <Picture
      slot="left"
      src={imgReferral}
      loading="lazy"
      fetchpriority="low"
      widths={[345, 480, 600]}
