---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import LatestWinners from "../components/LatestWinnersPremium.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxTwoFloatingBadge from "../components/ContentBoxTwoFloatingBadge.astro";
import ContentBox from "../components/ContentBox.astro";
import Faq from "../components/Faq2.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgReferral from "../assets/slide1.png";
import imgCashback from "../assets/slide2.png";

// VARIANT ROTATION THIS ROUND (CK268 -> BRAVO168). Zero file reuse from the
// previous round: AnnouncementPremium replaces Announcement5, LatestWinnersPremium
// replaces LatestWinnersCyber, Faq2 replaces Faq3, ReviewCardSumo2 replaces
// ReviewCardSumo, and the ContentBox shape-mix moves off CyberCut / TwoCyberCut /
// Neumorphism / TwoNeumorphism / SevenThreeCyberCut / SevenThreeNeumorphism /
// Special onto Premium / TwoPremium / FloatingBadge / TwoFloatingBadge /
// SevenThreeFloatingBadge / SevenThreePremium / plain ContentBox.
// NavbarPremium and FooterPremium are the layout's pair this round (previously
// NavbarStyle6 / FooterStyle3).
// Every CyberCut / Neumorphism / Huay file, Faq3, Announcement5, LatestWinnersCyber,
// ContentBoxSpecial and ReviewCardSumo stay on disk as inventory for the next
// brand — none of them was deleted.
//
// <Announcement /> runs bare on purpose: AnnouncementPremium's default message is
// already this brand's copy and every sub-page calls it bare too, so passing an
// override here is exactly how the ticker ends up saying two different things on
// two pages of the same site.
//
// IMAGE ROLES FOR THIS DROP (2026-09-30). Two files are referenced from this page
// and only two, and the pairing is read off the artwork itself, not off the file
// number — the two posters are NOT in docx order:
//   slide1.png — the pill reads "แนะนำเพื่อน โบนัส" around a huge gold "0.8%",
//     so it belongs to docx H3 #5. Imported as imgReferral.
//   slide2.png — the pill reads "คืนยอดเสีย โบนัส" around a huge gold "0.3%",
//     so it belongs to docx H3 #4. Imported as imgCashback.
// promotion.astro reads the same two files under the same two names, so the two
// pages cannot drift apart on which poster is which.
// Both files are 600x600, so 600 is the top candidate width — nothing above it
// would be a real pixel, and each picture carries max-w-[600px] so the square is
// never upscaled past its own pixels. Each slide sits in a ContentBoxSevenThree*
// image+text block, which is that family's hard cap of two per rebrand, so there
// is no third SevenThree on this page. Both variants lay out md:grid-cols-[3fr_7fr],
// so the picture goes in slot="left" (the 3fr column) in both and the prose in
// slot="right" — the two blocks are told apart by the card instead: #4 hangs its
// heading in a floating badge above a #0e3f8f-bordered card, #5 puts its heading
// inside the text column on a gradient card.
// The sizes attribute describes the 3fr column, not the viewport: the card is
// max-w-7xl inside px-4 with p-8 and gap-10, so the drawn width is
// 0.3 * (100vw - 136px) until the card caps at 1280px, and 353px after that.
//
// The alt text was written from THIS drop's artwork (a navy stadium-night ground
// with gold light streaks, white-and-navy footballs, stacked gold coins, navy gift
// boxes and the two-tone BRAVO168 wordmark) and is NOT the previous brand's text —
// the CK268 posters were black with neon-green chips and green gift boxes, none of
// which is in these pictures.
//
// Deliberately NOT imported, and every file still on disk as inventory:
//   slide3.png and slide4.png are LOTTOPLUS lottery posters, banner2.png is a
//   LOTTO24 banner and banner3.png is a PGW44 wordmark — all four predate this
//   drop, and importing any of them would emit a competitor's artwork into dist/,
//   so there is no inline article illustration beyond the two slides this round.
//   banner1.png and banner1-mobile.png belong to MainLayout's own pinned globs and
//   are never referenced from a page — the hero is the LCP element, so nothing here
//   gets loading="eager" fetchpriority="high". og.png is the same: MainLayout owns it.
//
// Vocabulary: BRAVO168 is a เว็บแทงบอลออนไลน์ — บอลเดี่ยว บอลสเต็ป บอลสด ค่าน้ำ
// อัตราต่อรอง ลีก คู่แข่งขัน บิล เวลาปิดรับ. The outgoing brands on this template
// sold a different product entirely (spinning-reel games, live tables, number
// draws), and every one of those words is gone — the page was rewritten from the
// brief rather than find-and-replaced over the old sentences. Nothing here claims a
// licence, a named betting operator, a bank, a deposit minimum, a payout figure, a
// member count or a founding year, because the brief names none. The only figures
// on this page are the ones the brief itself states: 0.3%, 0.8%, 3 ขั้นตอน,
// 24 ชั่วโมง, and the 168 inside the brand name. The brief's hedging ships with it
// — every claim is paired with its own caution ("ควรอ้างอิงราคาที่แสดงจริงในขณะนั้น",
// "ควรตรวจสอบเวลาปิดรับ อัตราต่อรอง และรายละเอียดบิลก่อนกดยืนยัน") and those
// sentences are part of the paragraphs, not trimmed as downbeat.
//
// Title and description are the brief's own Title/Description lines, used verbatim.
// The description ships at 152 characters, the length the brief wrote it.
const pageTitle = "BRAVO168 เว็บเล่นบอลค่าน้ำดีที่สุด การันตีได้โปรแรงทุกยูสใหม่";

const pageDescription =
  "BRAVO168 เว็บเล่นบอลค่าน้ำดีที่สุด เปิดรับบิลทันที เมื่อฤดูกาลเปิด ครอบคลุมทุกลีก ทุกแมตช์ ทั้งบอลสเต็ป บอลเดี่ยว รวมถึงบอลสด การันตีได้โปรแรงทุกยูสใหม่";

// The brief has a real H2 -> H3 nesting this round, so the page is NOT flattened to
// H2-only. The two H3s are genuine headings — the two bonus sub-points, both nested
// under the โปรโมชั่น H2 — and they stay H3.
//
// The checklist, in document order, and what carries each one:
//    1 H1  BRAVO168 เว็บเล่นบอลค่าน้ำดีที่สุด เปิดรับบิลทันที เมื่อฤดูกาลเปิด
//          ContentBoxPremium, L4 + L5
//    2 H2  BRAVO168 ครอบคลุมทุกลีก ทุกแมตช์ ทั้งบอลสเต็ป บอลเดี่ยว รวมถึงบอลสด
//          ContentBoxTwoPremium, L7 left + L8 right
//    3 H2  โปรโมชั่นแทงบอล BRAVO168 จัดหนักทุกฤดูกาล
//          ContentBoxFloatingBadge, L10
//    4 H3  คืนยอดเสีย โบนัส 0.3%
//          ContentBoxSevenThreeFloatingBadge + slide2 (imgCashback), L12
//    5 H3  แนะนำเพื่อน โบนัส 0.8%
//          ContentBoxSevenThreePremium + slide1 (imgReferral), L14
//    6 H2  สมัครแทงบอล BRAVO168 ง่ายๆ 3ขั้นตอน
//          ContentBoxTwoFloatingBadge, L16 left + L17 right
//    7 H2  ติดต่อแอดมิน BRAVO168 ผู้ให้บริการเกี่ยวกับการแทงบอลได้ 24 ชั่วโมง
//          ContentBox + LINE / สมัคร buttons, L19 + L20
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ BRAVO168
//          Faq2 + faqs prop
// Final inventory for this page: h1 x1, h2 x5, h3 x2.
//
// Every brief paragraph ships in full. Sections 1, 2, 6 and 7 each have TWO
// paragraphs and both ship, nothing merged or summarised: in the two-column blocks
// they run one per column, in the single-column blocks they stack inside one
// wrapper div. The column labels passed to the two-column boxes are this page's own
// layout wording, not brief headings, and both of those variants render them as <p>.
//
// Everything else on the page is chrome and emits no heading tag at any level:
// LatestWinnersPremium, LoginRtpSection and ReviewCardSumo2 render their titles as
// <p>/<span> with an aria-label on the section, and Faq2's questions live inside
// <summary> as <span>. The non-brief widgets sit before section 1
// (LatestWinnersPremium, right after the ticker) and after section 8
// (LoginRtpSection, ReviewCardSumo2, Navfoot) — never spliced between two content
// sections.

// One array, used by both <Faq> and the FAQPage node — never the component's own
// defaults, which belong to whichever brand shipped last. The three pairs are the
// brief's own Q/A block, verbatim.
const faqs = [
  {
    q: "BRAVO168 มีทั้งบอลเดี่ยว บอลสเต็ป และบอลสดหรือไม่?",
    a: "หากตลาดของคู่แข่งขันเปิดให้บริการ สมาชิกสามารถเลือกบอลเดี่ยว บอลสเต็ป และบอลสดได้ตามรายการที่ระบบรองรับ โดยควรตรวจสอบราคา เวลาปิดรับ และกติกาของตลาดก่อนยืนยันบิลทุกครั้ง",
  },
  {
    q: "โปรโมชั่น BRAVO168 โบนัส 0.3% และ 0.8% ต่างกันอย่างไร?",
    a: "โบนัส 0.3% เป็นโปรโมชั่นคืนยอดเสียจากยอดที่เข้าเงื่อนไข ส่วนโบนัส 0.8% เป็นกิจกรรมแนะนำเพื่อนตามยอดที่กำหนด สมาชิกควรตรวจสอบประเภทบิล รอบคำนวณ และเงื่อนไขล่าสุดก่อนรับโบนัส",
  },
  {
    q: "ค่าน้ำ BRAVO168 เหมือนกันทุกลีกและทุกคู่หรือไม่?",
    a: "ไม่จำเป็นต้องเท่ากัน เพราะค่าน้ำและอัตราต่อรองสามารถเปลี่ยนตามลีก คู่แข่งขัน ตลาด และช่วงเวลา สมาชิกควรตรวจสอบราคาล่าสุดที่แสดงบนบิลก่อนกดยืนยันการเดิมพัน",
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space that
// splits the word — the copy must read identically with the tags removed. One
// highlight colour only: #ffe39a, the wordmark's light gold, against the inherited
// body colour #dbe5f5 (BRAND_TEXT). The paragraphs below carry no colour class of
// their own: every ContentBox* card in this mix already sets
// `text-left text-base leading-relaxed text-[#dbe5f5]` on the element holding the
// slot, so the prose inherits it and no page-level override can drift from the card.

// No breadcrumb: this is the homepage, so a trail from the root to itself would be a
// single self-referential crumb. Every URL in the graph is derived by pageGraph from
// `site:` — no domain is typed out in this file, and no Review / AggregateRating /
// sameAs / address node is passed.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <LatestWinners />

  <ContentBoxPremium as="h1" title="BRAVO168 เว็บเล่นบอลค่าน้ำดีที่สุด เปิดรับบิลทันที เมื่อฤดูกาลเปิด">
    <div class="flex flex-col gap-5">
      <p>
        BRAVO168
        <strong class="text-[#ffe39a]">ให้บริการการเดิมพันฟุตบอลออนไลน์สำหรับผู้ที่ต้องการติดตามคู่แข่งขันจากหลายลีกในบัญชีเดียว</strong>
        มีทั้งบอลเดี่ยว บอลสเต็ป และบอลสด พร้อมรายการแข่งขันตามฤดูกาลที่ระบบเปิดรับ สมาชิกสามารถตรวจสอบคู่บอล ราคา อัตราต่อรอง
        <strong class="text-[#ffe39a]">และรายละเอียดบิลผ่านมือถือได้ก่อนยืนยันการเดิมพัน</strong>
        เมื่อการแข่งขันในแต่ละลีกเริ่มเปิดตลาด ระบบจะทยอยแสดงรายการที่สามารถเลือกเดิมพันได้ตามช่วงเวลาที่กำหนด
      </p>
      <p>
        ส่วนคำว่า “ค่าน้ำดีที่สุด”
        <strong class="text-[#ffe39a]">ควรอ้างอิงราคาที่แสดงจริงในขณะนั้น</strong>
        เนื่องจากค่าน้ำและอัตราต่อรองสามารถเปลี่ยนแปลงได้ตามตลาด เวลา และคู่แข่งขัน
      </p>
    </div>
  </ContentBoxPremium>

  <ContentBoxTwoPremium
    as="h2"
    title="BRAVO168 ครอบคลุมทุกลีก ทุกแมตช์ ทั้งบอลสเต็ป บอลเดี่ยว รวมถึงบอลสด"
    titleleft="รูปแบบเดิมพันที่เปิดรับ"
    titleright="ข้อควรตรวจก่อนกดยืนยัน">
    <p slot="left">
      BRAVO168
      <strong class="text-[#ffe39a]">รวบรวมตลาดฟุตบอลจากหลายรายการแข่งขันให้สมาชิกเลือกตามสไตล์การเดิมพัน</strong>
      บอลเดี่ยวเหมาะกับผู้ที่ต้องการเลือกผลจากคู่ใดคู่หนึ่ง
      <strong class="text-[#ffe39a]">ขณะที่บอลสเต็ปสามารถรวมหลายคู่ไว้ในบิลเดียว</strong>
      ส่วนบอลสดเปิดตัวเลือกการเดิมพันระหว่างการแข่งขันตามตลาดที่ระบบรองรับ ช่วยให้เลือกดูราคาและรูปแบบเดิมพันได้หลากหลายจากบัญชีเดียว
    </p>
    <p slot="right">
      รายการลีกและแมตช์ที่เปิดรับจริงขึ้นอยู่กับตารางแข่งขันและผู้ให้บริการ
      <strong class="text-[#ffe39a]">จึงควรตรวจสอบเวลาปิดรับ อัตราต่อรอง และรายละเอียดบิลก่อนกดยืนยัน</strong>
      โดยเฉพาะบอลสดที่ราคาและตลาดสามารถเปลี่ยนได้ระหว่างการแข่งขัน
    </p>
  </ContentBoxTwoPremium>

  <ContentBoxFloatingBadge as="h2" title="โปรโมชั่นแทงบอล BRAVO168 จัดหนักทุกฤดูกาล">
    <p>
      สมาชิก BRAVO168
      <strong class="text-[#ffe39a]">สามารถตรวจสอบโปรโมชั่นที่เปิดให้รับในแต่ละช่วงฤดูกาลผ่านบัญชีของตนเอง</strong>
      มีทั้งกิจกรรมคืนยอดเสียและโบนัสแนะนำเพื่อน โดยโปรโมชั่นอาจกำหนดประเภทการเดิมพัน ลีก ยอดที่เข้าเกณฑ์ และรอบคำนวณแตกต่างกัน
      <strong class="text-[#ffe39a]">ก่อนรับโบนัสจึงควรอ่านเงื่อนไขล่าสุดให้ครบถ้วน</strong>
    </p>
  </ContentBoxFloatingBadge>

  <ContentBoxSevenThreeFloatingBadge as="h3" title="คืนยอดเสีย โบนัส 0.3%">
    <Picture
      slot="left"
      src={imgCashback}
      loading="lazy"
      fetchpriority="low"
      widths={[353, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), (max-width: 1311px) calc(30vw - 41px), 353px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่น BRAVO168 พื้นน้ำเงินกรมท่า มีลูกฟุตบอลขาว-น้ำเงินและเหรียญทองลอยกระจายอยู่รอบภาพ ด้านซ้ายเป็นหญิงสาวผมยาวสวมชุดขาวยื่นมือออกมาข้างหน้า ด้านบนเป็นโลโก้ BRAVO168 ถัดลงมาเป็นตัวอักษรไทยสีทองขนาดใหญ่ว่า โปรโมชั่น ใต้ลงไปเป็นป้ายคำว่า คืนยอดเสีย โบนัส คร่อมตัวเลขทองขนาดใหญ่ 0.3% และมีกล่องของขวัญสีน้ำเงินคาดริบบิ้นทองอยู่มุมซ้ายล่าง"
      class="mx-auto h-auto w-full max-w-[600px] rounded-2xl border border-[#f4cb69]/60 shadow-[0_10px_30px_rgba(244,203,105,0.22)]"
    />
    <p slot="right">
      สมาชิกที่มียอดเสียตรงตามข้อกำหนดสามารถตรวจสอบสิทธิ์รับโบนัสคืนยอดเสีย 0.3% ตามรอบที่ BRAVO168 กำหนด
      <strong class="text-[#ffe39a]">ระบบจะคำนวณจากยอดเดิมพันที่เข้าเกณฑ์และแสดงโบนัสที่สามารถรับได้</strong>
      ควรตรวจสอบว่าบอลเดี่ยว บอลสเต็ป หรือบอลสดประเภทใดร่วมรายการ
      <strong class="text-[#ffe39a]">รวมถึงรอบตัดยอดก่อนกดรับสิทธิ์</strong>
    </p>
  </ContentBoxSevenThreeFloatingBadge>

  <ContentBoxSevenThreePremium as="h3" title="แนะนำเพื่อน โบนัส 0.8%">
    <Picture
      slot="left"
      src={imgReferral}
      loading="lazy"
      fetchpriority="low"
      widths={[353, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), (max-width: 1311px) calc(30vw - 41px), 353px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่น BRAVO168 ชุดเดียวกัน พื้นน้ำเงินกรมท่า มีลูกฟุตบอลขาว-น้ำเงิน เหรียญทอง และกล่องของขวัญสีน้ำเงินกระจายอยู่ ด้านซ้ายเป็นหญิงสาวผมยาวสวมชุดขาวยกนิ้วชี้ขึ้นหนึ่งข้างและยื่นอีกมือออกมา ด้านบนเป็นโลโก้ BRAVO168 ถัดลงมาเป็นตัวอักษรไทยสีทองขนาดใหญ่ว่า โปรโมชั่น ใต้ลงไปเป็นป้ายคำว่า แนะนำเพื่อน โบนัส คร่อมตัวเลขทองขนาดใหญ่ 0.8%"
      class="mx-auto h-auto w-full max-w-[600px] rounded-2xl border border-[#1558c4]/70 shadow-[0_10px_30px_rgba(21,88,196,0.28)]"
    />
    <p slot="right">
      สมาชิกสามารถแชร์ลิงก์แนะนำส่วนตัวให้เพื่อน เมื่อเพื่อนสมัคร BRAVO168 และมียอดเดิมพันตรงตามเงื่อนไข
      <strong class="text-[#ffe39a]">ระบบจะคำนวณโบนัสแนะนำเพื่อน 0.8% จากยอดที่เข้าเกณฑ์</strong>
      สามารถตรวจสอบจำนวนเพื่อน ยอดคำนวณ
      <strong class="text-[#ffe39a]">และโบนัสที่มีสิทธิ์รับผ่านบัญชีสมาชิกตามรอบที่กำหนด</strong>
    </p>
  </ContentBoxSevenThreePremium>

