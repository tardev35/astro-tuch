---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import LatestWinners from "../components/LatestWinnersPremium.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxTwoFloatingBadge from "../components/ContentBoxTwoFloatingBadge.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import Faq from "../components/Faq4.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import { pageGraph } from "../lib/schema";
import imgCashback from "../assets/slide1.png";
import imgReferral from "../assets/slide2.png";

// VARIANT ROTATION THIS ROUND (WEPLAY168 -> KINGKONG555), per brand-spec §3. Zero
// file reuse from the previous round: Announcement3 replaces Announcement5,
// LatestWinnersPremium replaces LatestWinners4, Faq4 replaces Faq3,
// ReviewCardSumo replaces ReviewCardSumo2, and the ContentBox shape-mix moves
// off Premium / Neumorphism / SevenThreePremium / SevenThreeNeumorphism /
// TwoPremium / TwoNeumorphism onto CyberCut / FloatingBadge /
// SevenThreeCyberCut / SevenThreeFloatingBadge / TwoCyberCut / Special.
// NavbarStyle10 and FooterStyle3 are the layout's pair this round (previously
// NavbarStyle6 / FooterCyber) and the brand font moves google-sans -> kanit;
// all three are the orchestrator's shared-chrome step, not this page's.
// Plain ContentBox is the one deliberate carry-over: it is the always-live box
// that terms, privacy, 404 and the button pages render through, so it cannot
// follow a rotation. Section 3 is the single docx section it carries here.
// Every unused *Premium / *Neumorphism / *Huay / *Cyber / Style file, Faq3,
// ReviewCardSumo2, LatestWinners4 and Announcement5 stay on disk as inventory
// for the next brand — none of them was deleted, and WEPLAY168's copy and violet
// still inside them is expected drift, not a bug.
//
// <Announcement /> runs bare on purpose: Announcement3's default message is
// already this brand's copy, set by the orchestrator from this brief, and every
// sub-page calls it bare too — so passing an override here is exactly how the
// ticker ends up saying two different things on two pages of the same site.
//
// PALETTE OF THIS BRAND (brand-spec §2). KINGKONG555 is a jungle / gorilla-king
// slot brand and a genuine TWO-COLOUR pair — jungle lime #8ce023 leads and crown
// gold #f2c230 is the second real hue — over the deep greens of the artwork's
// foliage. This round is a full flip off WEPLAY168's neon-arcade violet set
// (#a435f0 #7a1fc4 #fbe455 #efe6ff #ece2ff #d2a6ff #ffd23d #5b1a75 #c98a05
// #190633 #1e0a3c #17062e #110321 #0a0117 #0c0024 and every rgba(164,53,240,α) /
// rgba(251,228,85,α) glow), off PIGPG's Chinese-New-Year lacquer set before it,
// off KOON234's emerald-and-gold, off SUDYOD888's red-and-gold and off the
// blue/yellow set. None of those survives on this page or in any component it
// renders — and gold is the trap: "there is already gold here" does not mean it
// is THIS brand's gold (#fbe455, #ffd23d, #f5b61d, #ffd87a, #f5c53d, #fce604,
// #fad354 and #c8921e are all previous brands' values; ours is #f2c230 /
// #ffe066 / #a87a08). Green is the same trap in reverse this round, because the
// brand hue IS green: KOON234's emerald and DM899's #12c23a are not our lime.
// logo.webp is a green gorilla wearing a gold crown set with green gems, framed
// by jungle leaves, carrying KINGKONG in bright-lime 3-D letters and 555 in
// silver. bg.json this drop is {"mode":"color","color":"#0a2400"} — a near-black
// jungle-green page surface, so the depth ladder below (#14380a raised /
// #0f2e05 mid / #0a2400 deep / #051400 deepest) makes every card LIFT OFF the
// page rather than sink into it.
// Body copy is #e9f7d6 (= BRAND_TEXT), 11:1 on the raised surface.
// Highlights below are #8ce023, which §2 pins to exactly this one job — unlike
// #5cc211 which it pins to borders, rails and gradient mids, unlike #ffe066
// which is the gradient bright end, unlike #bde397 which is the secondary/hover
// text colour, and unlike #2f8c07, #1a5c04 and #a87a08, which never carry text
// at all and appear here only as border, rail and shadow colours. #06220a is the
// only ink allowed on a lime / gold / cream fill.
//
// IMAGE ROLES FOR THIS DROP (2026-10-09, brand-spec §4). Two files are
// referenced from this page and only two, and each pairing is read off the
// artwork itself:
//   slide1.png — square 600x600: the KINGKONG555 logo top left, a gold-crowned
//     gorilla at left giving a thumbs-up with a gold chain, a blonde woman in a
//     leaf outfit centre reaching toward the viewer, a baby gorilla and a toucan
//     at right, a 777 slot machine, a stone idol with glowing green eyes and a
//     waterfall behind, and gold coins everywhere; across the bottom โปรโมชั่น
//     in large green-and-gold 3-D type under a gold crown, with คืนยอดเสีย and
//     an oversized 0.3% under it. The artwork prints the heading itself, so it
//     belongs to docx H3 #4. Imported as imgCashback.
//   slide2.png — the companion, same square set: the logo top left, a toucan at
//     left, the gold-crowned gorilla with a thumbs-up, the blonde woman centre
//     holding a green-and-gold gift box, a baby gorilla at right, 777 reels,
//     gold coins and gift boxes; across the bottom โปรโมชั่น in green-and-gold
//     3-D type with แนะนำเพื่อน โบนัส and an oversized 0.8% under it. It belongs
//     to docx H3 #5. Imported as imgReferral.
// Both slides are 600x600 on disk, so 600 is the top real candidate — nothing
// above it would be a real pixel — and each picture carries max-w-[600px] so the
// art is never upscaled past its own bitmap.
// Each slide sits in a ContentBoxSevenThree* image+text block, which is that
// family's hard cap of two per rebrand, so there is no third SevenThree anywhere
// on the site and no slide appears outside those two blocks.
// The two blocks mirror each other: ContentBoxSevenThreeCyberCut lays out
// md:grid-cols-[3fr_7fr] so its picture goes in slot="left" while the paragraph
// keeps the wide column, and ContentBoxSevenThreeFloatingBadge lays out
// md:grid-cols-[7fr_3fr] so its picture goes in slot="right". The two pictures
// therefore alternate sides instead of stacking down the same edge, and each
// `sizes` describes its own 3fr column rather than the viewport. Tailwind sets
// box-sizing: border-box globally, so every max-w-* below caps the box INCLUDING
// its padding and border. Both figures are recomputed from the component that
// owns the column — if a padding/gap/border/cap changes there, these move with it:
//   ContentBoxSevenThreeCyberCut: cap on the SECTION (max-w-7xl/1280 + px-4), so
//     the card is min(100vw,1280) - 32 and the cap is reached at 100vw >= 1280.
//     border(1x2=2) + p-8(32x2=64) + gap-8(32) -> 1150 of column space at the
//     cap. The 3fr image column has no padding of its own (md:border-l and
//     md:pl-8 are on the TEXT column).
//       >= 1280px : 1150 x 0.3                        = 345px
//       md..1279  : (100vw - 130) x 0.3               = calc(30vw - 39px)
//       < md      : one column at p-8                 = calc(100vw - 98px)
//   ContentBoxSevenThreeFloatingBadge: same max-w-7xl/1280 + px-4 cap, but
//     border-2(2x2=4) + p-8(64) + gap-10(40) -> 1140, and the image column here
//     DOES add md:border-l(1) + md:pl-10(40) = 41 of its own.
//       >= 1280px : 1140 x 0.3 - 41                   = 342 - 41 = 301px
//       md..1279  : (100vw - 140) x 0.3 - 41          = calc(30vw - 83px)
//       < md      : one column at p-8                 = calc(100vw - 100px)
// Neither is the LCP element — MainLayout's hero banner is — so both are
// loading="lazy" fetchpriority="low" decoding="async" and neither takes
// fetchpriority="high". formats/fallbackFormat/quality are left at the house
// values: tools/avif-quality-service.mjs rescales AVIF quality on its own, so
// quality={80} must not be hand-tuned per format.
//
// The alt text was written from THIS drop's artwork per brand-spec §4, read off
// the files rather than carried over: the set is a sunlit jungle scene of green
// foliage, a waterfall, a stone idol, gold coins, 777 reels and a crowned
// gorilla — not WEPLAY168's violet neon arcade with a silver-haired woman, a
// sunglasses tiger, a blue penguin and a purple Game-Boy handheld, and not
// PIGPG's deep-red Chinese-New-Year scene. There is no handheld console, no
// tiger, no penguin and no red lantern on either file, and the logo is a crowned
// gorilla rather than a purple console.
//
// Deliberately NOT imported, and every file still on disk:
//   banner2.png (10-08) is WEPLAY168's artwork, banner3.png (09-27) is older
//   still, and slide3.png / slide4.png (09-29) are a lottery brand's posters —
//   all previous brands' artwork. Importing any of them emits a competitor's
//   picture into dist/ (an eager import IS an emit, rendered or not) and turns
//   verify-build red. There is therefore NO current-drop article illustration
//   this round, and a slide is not substituted for one.
//   banner1.png and banner1-mobile.png belong to MainLayout's own pinned globs
//   and are never referenced from a page. og.png is the same: MainLayout owns it.
// Also deliberately unused (named without the file extension on purpose — the
// playbook's "is this component live?" check is a bare-filename grep, and a
// mention here would read as a render): FeatureHighlights renders sub-points as
// <h3>, and this brief already spends both of its allowed H3s on sections 4 and
// 5, so wiring it in would break the count; ProviderGrid, GameRankingBoard and
// SmoothCarousel have no brief section asking for a provider wall, a ranking
// board or a carousel this round (the brief names no studio, so a provider wall
// would have to invent one); BankStrip already renders inside the active footer;
// and the three-column ContentBox3Three family has nothing to carry — every
// section in this brief is one or two running paragraphs, not a three-way split.
//
// Vocabulary (brand-spec §6): KINGKONG555 is a ฐานเว็บสล็อตหลัก and nothing
// else. The words this page may use are the brief's own: ฐานเว็บสล็อตหลัก,
// แพลตฟอร์มเดียว, เดิมพันเริ่มต้น 1 บาท, สล็อตเบทต่ำ, ทุนน้อย, เกมคลาสสิก,
// ฟรีสปิน, โบนัส, ตัวคูณ, ฟีเจอร์พิเศษ, ตารางจ่าย, ช่วงเดิมพัน,
// ผลการหมุนเป็นแบบสุ่ม, เครดิต, บัญชีเดียว, ค่าย, คืนยอดเสีย 0.3%, เข้ายูส,
// รอบตัดยอด, รอบคำนวณ, ยอดที่เข้าเกณฑ์, แนะนำเพื่อน 0.8%, แชร์ลิงก์,
// ฝากถอนเข้าบริษัทโดยตรง, บัญชีปลายทาง, นิติบุคคล, ไม่ผ่านม้า / บัญชีม้า,
// หลักฐานธุรกรรม, แอดมิน 24 ชั่วโมง, PIN, OTP, ช่องทางติดต่อหลัก,
// ทางเข้าเล่นผ่านมือถือ.
// WEPLAY168's vocabulary is banned and gone (เล่นสล็อตออโต้ทุกค่าย, แตกง่าย,
// ไม่มีขั้นต่ำ, อัตราการคืนเงินผู้เล่น, เกมรูปแบบใหม่), as is every older
// brand's (ค่ายตรง, ส่งตรงจากเว็บแม่, ไม่ผ่านเอเย่นต์, ไม่ผ่านเว็บตัวแทน,
// ศูนย์รวมเกมสล็อตค่ายแท้, การันตีเว็บแท้, รีวิวถอนจริง, ถูกลิขสิทธิ์,
// อัปเกรดระบบ, บาคาร่า, รูเล็ต, ไฮโล, โต๊ะสด, คาสิโนไลฟ์, บอล, กีฬา,
// ตลาดเดิมพัน, VIP, ไฮคลาส) — the page is written straight from the brief
// rather than find-and-replaced over the old sentences, and three of those
// banned phrases were in the page this replaces.
// There is NO หวย anywhere on this site this round: it is a slot brand, the word
// appears nowhere, and /ตรวจหวย and /แนวทาง stay parked in src/pages-disabled/.
// Nothing here claims a licence, a regulator, an operator, a studio, a bank, an
// RTP figure, a deposit minimum, a member count or a founding year, because the
// brief names none. The only figures are the brief's own: 1 บาท, 0.3%, 0.8%
// and 24 ชั่วโมง.
// The brief's own hedging ships with the copy — it states it four separate times
// (การยืนยันว่าเป็นเว็บแท้และปลอดภัยควรมีข้อมูลผู้ให้บริการที่ตรวจสอบได้รองรับ ·
// ผลการหมุนเป็นแบบสุ่ม · ชื่อบัญชีบริษัทเพียงอย่างเดียวไม่สามารถรับประกัน
// ความปลอดภัยของธุรกรรมได้ทั้งหมด · คำว่าไม่จำกัดควรตรวจสอบว่าเป็นจำนวนเพื่อน
// จำนวนครั้ง หรือวงเงิน) and it is part of the paragraphs, not trimmed as
// downbeat filler.
//
// The brief says KINGKONG555 throughout and so does every piece of artwork in
// the drop and the operator's prompt — no conflict this round. Even so the brand
// name is never typed on the page: it is interpolated from ${BRAND_NAME} so it
// can never drift from brandProfile. No domain is written out anywhere here.
//
// Title and description are the brief's own Title/Description lines (minus that
// substitution), used verbatim and NOT padded up to 150: verify-build
// deliberately skips its 150-character floor on the home page for exactly this
// reason.
const pageTitle = `${BRAND_NAME} ฐานเว็บสล็อตหลัก เริ่มต้น1บาท เข้าเล่น 24 ชั่วโมง`;

const pageDescription = `${BRAND_NAME} ฐานเว็บสล็อตหลัก เดิมพันเริ่มต้น1บาท เบทต่ำ ทุนน้อยก็เล่นได้ เว็บแท้ เล่นง่าย ปลอดภัยทุกระการใช้งาน เข้าเล่นได้ 24 ชั่วโมง`;

// The brief has a real H2 -> H3 nesting this round, so the page is NOT flattened
// to H2-only. The two H3s are genuine headings — the two promotion sub-points,
// both nested under section 3's โปรโมชั่น H2 — and they stay H3.
//
// The checklist, in document order, and what carries each one:
//    1 H1  KINGKONG555 ฐานเว็บสล็อตหลัก เริ่มต้น1บาท เข้าเล่น 24 ชั่วโมง
//          ContentBoxCyberCut, brief paragraph on line 4
//    2 H2  KINGKONG555 เกมสล็อตเบทต่ำ มีทุนน้อยก็เล่นได้
//          ContentBoxTwoFloatingBadge, line 6 left / line 7 right
//    3 H2  โปรโมชั่นเล่นสล็อต KINGKONG555 เครือเว็บหลัก กดรับได้เลย
//          ContentBox (the plain, always-live variant), line 9
//    4 H3  โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสทุกวัน
//          ContentBoxSevenThreeCyberCut + slide1 (imgCashback), line 11
//    5 H3  โปรโมชั่น แนะนำเพื่อน รับโบนัสแชร์ลิงก์ 0.8% ไม่จำกัด
//          ContentBoxSevenThreeFloatingBadge + slide2 (imgReferral), line 13
//    6 H2  ระบบเล่นสล็อต KINGKONG555 ฝากถอนเข้าบริษัทโดยตรง ปลอดภัย ไม่ผ่านม้า
//          ContentBoxSpecial, line 15 left half / line 16 right half
//    7 H2  แอดมิน KINGKONG555 ฐานสล็อตเว็บหลัก เปิดให้บริการ 24 ชั่วโมง
//          ContentBoxTwoCyberCut, line 18 left / line 19 right
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ KINGKONG555
//          Faq4 + faqs prop, lines 21-26
// Final inventory for this page: h1 x1, h2 x5, h3 x2.
//
// Shape rhythm, top to bottom: clipped-corner glass slab on the raised surface
// with a gold rail beside the heading -> rounded two-column card with a floating
// DARK badge plate -> flat glass card from the always-live plain box -> 3:7
// clipped-corner card on the deepest surface with a solid gold heading and the
// picture on the LEFT -> 7:3 rounded card with a floating SOLID GOLD badge and
// the picture on the RIGHT -> rounded-3xl two-half card with icon plates ->
// clipped-corner two-column card on the mid surface -> clipped accordion.
// No shape repeats back to back; the three clipped-corner cards are separated by
// surface depth (#14380a raised / #051400 deepest / #0f2e05 mid) rather than by
// heading colour alone, the two floating badges are deliberate opposites (dark
// plate with a bright gradient vs solid gold plate with #06220a ink), and every
// card's heading gradient runs a different order of the same four light hues, so
// no two cards read as the same card twice.
//
// ContentBoxSevenThreeCyberCut takes the docx heading through `title`, which
// falls back to its wide (7fr) RIGHT text column; its image column is passed no
// `titleleft`, so the block emits exactly one heading.
// ContentBoxSevenThreeFloatingBadge puts `title` in the floating badge and is
// passed neither `titleleft` nor `titleright`, so it emits exactly one too.
//
// Every brief paragraph ships in full — all eleven of them, nothing merged or
// summarised. Sections 2, 6 and 7 have two paragraphs each and run one per
// column/half; sections 1, 3, 4 and 5 have one paragraph each. The column labels
// passed to ContentBoxTwoFloatingBadge and ContentBoxTwoCyberCut are this page's
// own layout wording, not brief headings, and both variants render them as <p>.
//
// Everything else on the page is chrome and emits no heading tag at any level:
// Announcement3, LatestWinnersPremium, LoginRtpSection and ReviewCardSumo render
// their titles as <p>/<span> with an aria-label on the section, and Faq4's
// questions live inside <summary> as <span>. The non-brief widgets sit before
// section 1 (the ticker, then the winners feed) and after section 8
// (LoginRtpSection, ReviewCardSumo, Navfoot) — never spliced between two content
// sections.

// One array, used by both <Faq> and the FAQPage node — never the component's own
// defaults (Faq4 deliberately ships none, so a forgotten prop renders an empty
// accordion rather than some previous brand's questions). The three pairs are
// the brief's own Q/A block (content.txt lines 21-26), verbatim.
const faqs = [
  {
    q: `${BRAND_NAME} มีเกมสล็อตเริ่มต้น 1 บาททุกเกมหรือไม่?`,
    a: `เกมสล็อตบางรายการของ ${BRAND_NAME} รองรับการเดิมพันเริ่มต้น 1 บาท แต่ยอดขั้นต่ำอาจแตกต่างกันตามค่ายและเกมที่เลือก สมาชิกควรตรวจสอบช่วงเดิมพันที่แสดงภายในเกมก่อนเริ่มเล่นทุกครั้ง`,
  },
  {
    q: `${BRAND_NAME} สามารถเข้าเล่นสล็อตและทำรายการได้ตลอด 24 ชั่วโมงหรือไม่?`,
    a: `หากเว็บไซต์เปิดระบบให้บริการตลอดวัน สมาชิกสามารถเข้าสู่ระบบและเลือกเกมสล็อตที่เปิดให้บริการได้ตลอด 24 ชั่วโมง ส่วนรายการฝากถอนอาจมีระยะเวลาดำเนินการแตกต่างกันตามช่องทางชำระเงินและขั้นตอนตรวจสอบ`,
  },
  {
    q: `${BRAND_NAME} มีโปรโมชั่นอะไรให้สมาชิกเลือกบ้าง?`,
    a: `โปรโมชั่นหลักตามข้อมูลที่กำหนดมี คืนยอดเสีย 0.3% และ แนะนำเพื่อน 0.8% โดยแต่ละรายการมีวิธีคำนวณ รอบรับสิทธิ์ และเงื่อนไขแตกต่างกัน สมาชิกควรตรวจสอบรายละเอียดล่าสุดจากหน้าโปรโมชั่นก่อนกดรับโบนัส`,
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// One highlight colour only: #8ce023, against the inherited body colour #e9f7d6
// (BRAND_TEXT). The paragraphs below carry no colour class of their own: every
// ContentBox* card in this mix already sets
// `text-left text-base leading-relaxed text-[#e9f7d6]` on the element holding
// the slot, so the prose inherits it and no page-level override can drift from
// the card. No paragraph carries mx-auto or max-w-* either — the cards cap their
// own width, and the only max-w-* on the page is the one capping each slide,
// which is an image and not prose. One element per slot, everywhere.

// No breadcrumb: this is the homepage, so a trail from the root to itself would
// be a single self-referential crumb. Every URL in the graph is derived by
// pageGraph from `site:` — no domain is typed out in this file, no URL is built
// with `+`, and no Review / AggregateRating / sameAs / address / email node is
// passed. `description` is the exact same string MainLayout gets.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <LatestWinners />

  <ContentBoxCyberCut as="h1" title={`${BRAND_NAME} ฐานเว็บสล็อตหลัก เริ่มต้น1บาท เข้าเล่น 24 ชั่วโมง`}>
    <p>
      {BRAND_NAME}
      <strong class="text-[#8ce023]">ฐานเว็บสล็อตหลักที่รวบรวมเกมสล็อตหลายรูปแบบไว้ในแพลตฟอร์มเดียว</strong>
