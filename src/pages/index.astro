---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import LottoGrid from "../components/LottoGrid.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBox from "../components/ContentBox.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ContentBoxTwoHuay from "../components/ContentBoxTwoHuay.astro";
import LatestWinners from "../components/LatestWinnersCyber.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Faq from "../components/Faq2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";

// Title and description are the brief's own Title/Description lines, used
// verbatim. A brief-supplied description is never padded up to the 150-char
// floor and never topped up from the H1/H2.
const pageTitle = "PREMSUK365 หวยที่ดีต้องเปรมสุข การันตีจ่ายจริง รับเลขดัง เลขอั้น ไม่ลบบิล ไม่เบี้ยวโพย";

const pageDescription = "PREMSUK365 หวยที่ดีต้องเปรมสุข เว็บแทงหวยออนไลน์ที่ดีที่สุด เปิดรับทุกเลขดัง เว็บไหนอั้นเว็บเรารับหมด ไม่ลบบิล ไม่เบี้ยวโพยแน่นอน";

// The ticker copy is passed explicitly rather than relying on the component's
// default — every Announcement* variant's default belongs to whichever brand
// wired it in last. No emoji in this string: an emoji baked into a text prop
// cannot be given its own aria-hidden span, and this marquee prints the string
// twice.
const announcement =
  "PREMSUK365 หวยที่ดีต้องเปรมสุข เว็บแทงหวยออนไลน์ผ่านระบบที่ใช้งานง่าย • เปิดรับเลขดังและเลขอั้นตามวงเงินที่ระบบเปิดรับ เว็บไหนอั้นเว็บเรารับหมด • แสดงอัตราจ่ายให้ตรวจสอบก่อนส่งโพยทุกครั้ง เลข 2 ตัวบาทละ 100 และเลข 3 ตัวบาทละ 1,000 ตามเรทที่กำหนดสำหรับหน้านี้ • เลือกเลข กำหนดยอด และเช็กบิลย้อนหลังได้ด้วยตัวเอง ไม่ลบบิล ไม่เบี้ยวโพย • ฝากถอนออโต้ผ่านวอลเลทหรือธนาคารชั้นนำที่ระบบรองรับ ตรวจสอบรายละเอียดก่อนยืนยันรายการ • หวยแต่ละประเภทและแต่ละรอบอาจมีเงื่อนไขต่างกัน ให้ยึดข้อมูลที่ระบบแสดง ณ เวลาทำรายการเป็นหลัก • ติดปัญหาเรื่องโพยหรือธุรกรรม แจ้งแอดมิน PREMSUK365 ได้ทันที";

// The brief's own rate tables, kept as data so the markup below stays a single
// semantic <table> per H3 instead of two hand-typed grids.
const rateTwoDigit = [
  { stake: "1 บาท", rate: "1 : 100", payout: "100 บาท" },
  { stake: "10 บาท", rate: "1 : 100", payout: "1,000 บาท" },
  { stake: "50 บาท", rate: "1 : 100", payout: "5,000 บาท" },
  { stake: "100 บาท", rate: "1 : 100", payout: "10,000 บาท" },
];

const rateThreeDigit = [
  { stake: "1 บาท", rate: "1 : 1,000", payout: "1,000 บาท" },
  { stake: "10 บาท", rate: "1 : 1,000", payout: "10,000 บาท" },
  { stake: "50 บาท", rate: "1 : 1,000", payout: "50,000 บาท" },
  { stake: "100 บาท", rate: "1 : 1,000", payout: "100,000 บาท" },
];

// One array, used by both <Faq> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last.
const faqs = [
  {
    q: "PREMSUK365 รับเลขดังและเลขอั้นทุกเลขหรือไม่?",
    a: "สามารถตรวจสอบเลขดังและเลขอั้นที่ต้องการได้จากหน้าส่งโพย โดยวงเงินจริงของแต่ละเลขควรยึดข้อมูลที่ระบบแสดง ณ เวลานั้น หากเลขใดมีข้อจำกัด ระบบควรแสดงรายละเอียดก่อนสมาชิกยืนยันรายการ",
  },
  {
    q: "PREMSUK365 เลข 2 ตัวและ 3 ตัวจ่ายเท่าไร?",
    a: "ตามเรทที่กำหนดสำหรับหน้านี้ เลข 2 ตัวจ่ายบาทละ 100 และเลข 3 ตัวจ่ายบาทละ 1,000 อย่างไรก็ตาม ควรตรวจสอบอัตราจ่ายบนหน้าส่งโพยอีกครั้ง เพราะหวยแต่ละประเภทหรือแต่ละรอบอาจมีเงื่อนไขต่างกัน",
  },
  {
    q: "หากโพยหรือรายการฝากถอน PREMSUK365 มีปัญหาต้องทำอย่างไร?",
    a: "ให้ตรวจสอบประวัติโพยหรือธุรกรรมในบัญชีก่อน หากยังพบความผิดปกติ สามารถติดต่อแอดมิน PREMSUK365 พร้อมแจ้งเวลา จำนวนเงิน ประเภทหวย และรายละเอียดรายการ เพื่อให้เจ้าหน้าที่ตรวจสอบต่อได้อย่างรวดเร็ว",
  },
];

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb. Every URL in the graph is derived
// by pageGraph from `site:` — no domain is typed out in this file.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <ContentBoxFloatingBadge as="h1" title="PREMSUK365 หวยที่ดีต้องเปรมสุข เว็บแทงหวยออนไลน์ที่ดีที่สุดในตอนนี้">
    <p class="text-left text-base leading-relaxed text-[#e4e7d8]">
      <strong class="text-[#f7e8b4]">PREMSUK365</strong> เปิดบริการสำหรับคนที่ต้องการแทงหวยออนไลน์ผ่านระบบที่ใช้งานง่าย มีจุดเด่นเรื่องการรับเลขดังและเลขอั้นตามวงเงินที่ระบบเปิดรับ
      พร้อมแสดงอัตราจ่ายให้ตรวจสอบก่อนส่งโพย สมาชิกสามารถเลือกเลข กำหนดยอด และเช็กบิลย้อนหลังได้ด้วยตัวเอง รวมถึงมีระบบฝากถอนออโต้ผ่านวอลเลทและธนาคารที่รองรับ
      หากเกิดปัญหาเรื่องโพยหรือธุรกรรมสามารถติดต่อแอดมินเพื่อช่วยตรวจสอบได้ทันที
    </p>
  </ContentBoxFloatingBadge>

  <LottoGrid />

  <ContentBoxSpecial as="h2" title="PREMSUK365 เปิดรับทุกเลขดัง เลขอั้น เว็บไหนอั้นเว็บเรารับหมด" iconleft="🔥" iconright="🧾">
    <p slot="left" class="text-left text-base leading-relaxed text-[#e4e7d8]">
      สายหวยที่มีเลขในใจสามารถเข้ามาตรวจสอบการรับแทงกับ <strong class="text-[#f7e8b4]">PREMSUK365</strong> ได้ก่อนส่งโพย ไม่ว่าจะเป็นเลขดัง เลขกระแส หรือเลขที่บางรอบมีผู้เลือกเดิมพันจำนวนมาก
      ระบบจะแสดงวงเงินที่สามารถรับได้ก่อนยืนยันรายการ ทำให้สมาชิกเห็นรายละเอียดของเลขและยอดเดิมพันอย่างชัดเจน
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#e4e7d8]">
      เมื่อส่งโพยสำเร็จแล้วควรเก็บประวัติบิลไว้ตรวจสอบผลและยอดรางวัลภายหลัง โดยวงเงินรับจริงให้ยึดข้อมูลที่ระบบแสดงในรอบนั้นเป็นหลัก
    </p>
  </ContentBoxSpecial>

  <ContentBoxSevenThreeCyberCut as="h2" title="PREMSUK365 โปรโมชั่นดีอัตราจ่ายสูง">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อนของ PREMSUK365 พื้นหลังสีเขียวเข้มไล่เป็นสีดำมีประกายทอง ด้านบนเป็นโลโก้คำว่า PREMSUK สีทองวางเหนือเลข 365 ถัดลงมาเป็นคำว่า โปรโมชั่น ในกรอบขอบทอง คำว่า แนะนำเพื่อน สีขาวขอบทอง และตัวเลข 0.8% ขนาดใหญ่สีทองบนแผ่นป้ายสีเขียว ด้านขวาเป็นผู้หญิงผมยาวสีเงินสวมชุดสีขาวทองเขียวกำลังชี้นิ้วมาที่ตัวเลข รอบภาพมีลูกบอลหวยเลข 9 2 5 3 และ 8 สลากกินแบ่งรัฐบาลไทย กองเหรียญทอง และกล่องของขวัญสีเขียวผูกโบว์ทอง ด้านล่างเป็นแถบสี่ช่องเขียนว่า การันตีจ่ายจริง รับเลขดังเลขอั้น ไม่ลบบิล และไม่เบี้ยวโพย"
      class="mx-auto h-auto w-full border border-[#e3c56a]/40 shadow-[0_10px_30px_rgba(227,197,106,0.25)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#e4e7d8]">
      <strong class="text-[#f7e8b4]">PREMSUK365</strong> เน้นแสดงอัตราจ่ายให้สมาชิกตรวจสอบก่อนตัดสินใจส่งโพย โดยเรทที่กำหนดสำหรับหน้านี้คือ เลข 2 ตัว บาทละ
      <span class="font-black text-[#e3c56a]">100</span> และเลข 3 ตัว บาทละ <span class="font-black text-[#e3c56a]">1,000</span> ช่วยให้คำนวณยอดเบื้องต้นได้ง่าย ก่อนแทงควรตรวจสอบประเภทหวย
      เลขที่เลือก และอัตราจ่ายจริงในระบบอีกครั้ง เพราะบางรอบหรือบางประเภทอาจมีเงื่อนไขเฉพาะ
    </p>
  </ContentBoxSevenThreeCyberCut>

  <ContentBox as="h3" title="อัตราจ่าย 2 ตัวบาทละ 100">
    <div class="flex flex-col gap-6">
      <div class="overflow-x-auto rounded-2xl border border-[#e3c56a]/35">
        <table class="w-full min-w-[420px] border-collapse text-left text-base">
          <caption class="sr-only">ตารางอัตราจ่ายหวย 2 ตัว บาทละ 100 เทียบยอดแทงกับยอดตามเรทเมื่อถูก</caption>
          <thead class="bg-gradient-to-r from-[#0d3a22] to-[#03130a]">
            <tr class="text-[#f7e8b4]">
              <th scope="col" class="p-4 font-black">ยอดแทง</th>
              <th scope="col" class="p-4 text-center font-black">อัตราจ่าย</th>
              <th scope="col" class="p-4 text-right font-black">ยอดตามเรทเมื่อถูก</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#1c6b3f]/60 text-[#e4e7d8]">
            {
              rateTwoDigit.map((row) => (
                <tr class="transition-colors hover:bg-[#0d3a22]/70">
                  <td class="p-4 font-bold text-[#e4e7d8]">{row.stake}</td>
                  <td class="p-4 text-center font-black tracking-wider text-[#e3c56a]">{row.rate}</td>
                  <td class="p-4 text-right font-black tracking-wider text-[#2a9d5c]">{row.payout}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="text-left text-base leading-relaxed text-[#e4e7d8]">
        ตัวอย่าง หากเลือกเลข 2 ตัวและลงเดิมพัน 10 บาท ด้วยเรท 1 ต่อ 100 เมื่อผลตรงตามเงื่อนไข ยอดตามเรทจะเท่ากับ 1,000 บาท ทั้งนี้ให้ยึดอัตราจ่ายที่ปรากฏบนหน้าส่งโพยก่อนกดยืนยันเป็นหลัก
      </p>
    </div>
  </ContentBox>

  <ContentBox as="h3" title="อัตราจ่าย 3 ตัวบาทละ 1,000">
    <div class="flex flex-col gap-6">
      <div class="overflow-x-auto rounded-2xl border border-[#e3c56a]/35">
        <table class="w-full min-w-[420px] border-collapse text-left text-base">
          <caption class="sr-only">ตารางอัตราจ่ายหวย 3 ตัว บาทละ 1,000 เทียบยอดแทงกับยอดตามเรทเมื่อถูก</caption>
          <thead class="bg-gradient-to-r from-[#0d3a22] to-[#03130a]">
            <tr class="text-[#f7e8b4]">
              <th scope="col" class="p-4 font-black">ยอดแทง</th>
              <th scope="col" class="p-4 text-center font-black">อัตราจ่าย</th>
              <th scope="col" class="p-4 text-right font-black">ยอดตามเรทเมื่อถูก</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#1c6b3f]/60 text-[#e4e7d8]">
            {
              rateThreeDigit.map((row) => (
                <tr class="transition-colors hover:bg-[#0d3a22]/70">
                  <td class="p-4 font-bold text-[#e4e7d8]">{row.stake}</td>
                  <td class="p-4 text-center font-black tracking-wider text-[#e3c56a]">{row.rate}</td>
                  <td class="p-4 text-right font-black tracking-wider text-[#2a9d5c]">{row.payout}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="text-left text-base leading-relaxed text-[#e4e7d8]">
        หากเลือกเลข 3 ตัวและเดิมพัน 10 บาท ด้วยเรท 1 ต่อ 1,000 ยอดตามเรทเมื่อผลตรงตามเงื่อนไขจะเท่ากับ 10,000 บาท ควรตรวจสอบเรทและรายละเอียดบิลอีกครั้งก่อนส่งโพยทุกครั้ง
      </p>
    </div>
  </ContentBox>

  <LoginRtpSection />

  <ContentBoxTwoHuay as="h2" titleleft="สมาชิก PREMSUK365 สามารถฝากถอนออโต้ผ่านวอลเลทหรือธนาคารชั้นนำได้ตลอดเวลา" iconleft="🏦">
    <p slot="left" class="text-left text-base leading-relaxed text-[#e4e7d8]">
      สมาชิก <strong class="text-[#f7e8b4]">PREMSUK365</strong> สามารถจัดการเครดิตผ่านระบบฝากถอนออโต้ โดยเลือกวอลเลทหรือบัญชีธนาคารจากช่องทางที่เว็บไซต์เปิดรองรับ
      จากนั้นระบุจำนวนเงินและตรวจสอบรายละเอียดก่อนยืนยันรายการ
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#e4e7d8]">
      สามารถติดตามสถานะฝากถอนและประวัติธุรกรรมผ่านบัญชีสมาชิกได้ด้วยตัวเอง สำหรับยอดขั้นต่ำ วงเงินสูงสุด และรายชื่อธนาคารที่รองรับ ควรตรวจสอบข้อมูลล่าสุดในระบบก่อนทำรายการทุกครั้ง
    </p>
  </ContentBoxTwoHuay>

  <LatestWinners />

  <ContentBoxNeumorphism as="h2" title="ติดปัญหาสอบถามแอดมิน PREMSUK365 ได้ทันที">
    <p class="text-left text-base leading-relaxed text-[#e4e7d8]">
      หากส่งโพยไม่สำเร็จ เลขที่ต้องการแทงไม่แสดง ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง หรือพบยอดในบิลไม่ตรงกับรายการ สามารถติดต่อแอดมิน <strong class="text-[#f7e8b4]">PREMSUK365</strong>
      พร้อมแจ้งประเภทหวย รอบเดิมพัน เวลา และรายละเอียดธุรกรรม เพื่อให้ตรวจสอบได้ตรงจุด สมาชิกควรเก็บข้อมูลบิลและหลักฐานการทำรายการไว้จนกว่าปัญหาจะได้รับการตรวจสอบ
      และไม่ควรเปิดเผยรหัสผ่านหรือ OTP แก่บุคคลอื่น
    </p>
  </ContentBoxNeumorphism>

  <ReviewCardSumo />

  <Faq title="คำถามที่พบบ่อยเกี่ยวกับ PREMSUK365" faqs={faqs} />

  <Navfoot />
</MainLayout>
