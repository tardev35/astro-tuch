---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement2.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxTwo from "../components/ContentBoxTwo.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBox from "../components/ContentBox.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import Faq from "../components/Faq.astro";
import LatestWinners from "../components/LatestWinners2.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";

// Title and description are the brief's own Title/Description lines, verbatim.
// A brief-supplied description ships at whatever length it was written — it is
// not padded up to the 150-character floor.
const pageTitle = "CAMPING289 สล็อตคนมือโปร เว็บตรง เจ้าของแท้ระดับโลก ปลอดภัย ได้เงินจริง";

const pageDescription =
  "CAMPING289 เกมสล็อตมือโปร เดิมพันอัปสกิลการเล่น เข้าถึงเว็บได้อย่างปลอดภัย ผ่านลิงก์ตรงทันทีหลังสมัคร รับสกิลและเทคนิคการเดิมพันเพิ่มเติมจากแอดมินได้ก่อนใคร";

// The ticker copy is passed explicitly rather than relying on the component's
// default — every Announcement* variant's default belongs to whichever brand
// wired it in last. No emoji in this string: an emoji baked into a text prop
// cannot be given its own aria-hidden span.
const announcement =
  "CAMPING289 สล็อตคนมือโปร เว็บตรง เจ้าของแท้ระดับโลก เข้าถึงเว็บได้อย่างปลอดภัยผ่านลิงก์ตรงทันทีหลังสมัคร • รวมเกมสล็อตหลากหลายรูปแบบ พร้อมข้อมูลกติกาและฟีเจอร์ให้ศึกษาก่อนเดิมพัน • ตรวจสอบโปรโมชั่นและสิทธิพิเศษที่เปิดให้รับในแต่ละวันได้จากบัญชีของตนเอง • รองรับเว็บเบราว์เซอร์ทั้ง Android และ iOS รวมถึงแท็บเล็ตและคอมพิวเตอร์ • แอดมิน CAMPING289 พร้อมให้คำแนะนำผ่าน LINE Official ตลอด 24 ชั่วโมง";

// The brief's three registration steps. They are list items in the docx, not
// headings, so they render as an <ol> — turning them into cards with their own
// titles would add an h3 tier the brief does not have.
const steps = [
  "สมัครสมาชิก CAMPING289 ผ่านหน้าเว็บไซต์และกรอกข้อมูลที่ระบบกำหนด",
  "Login เข้าสู่บัญชีและตรวจสอบช่องทางฝากเครดิตที่เปิดให้บริการ",
  "เลือกเกมสล็อต ศึกษากติกาและรายละเอียดให้เรียบร้อยก่อนเริ่มเดิมพัน",
];

// One array, used by both <Faq> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last.
const faqs = [
  {
    q: "CAMPING289 สามารถเล่นสล็อตผ่านมือถือได้หรือไม่?",
    a: "ได้ ระบบรองรับการเข้าใช้งานผ่านเว็บเบราว์เซอร์บน Android และ iOS รวมถึงแท็บเล็ตและคอมพิวเตอร์ สมาชิกสามารถ Login ตรวจสอบบัญชี และเลือกเกมที่รองรับอุปกรณ์ของตนเองได้โดยตรง",
  },
  {
    q: "เทคนิคเล่นสล็อตของ CAMPING289 ช่วยให้ทำกำไรได้แน่นอนหรือไม่?",
    a: "ไม่สามารถรับประกันได้ เทคนิคและคู่มือต่าง ๆ มีไว้สำหรับช่วยทำความเข้าใจกติกา ฟีเจอร์ และการบริหารงบประมาณเท่านั้น ผลของเกมสล็อตมีความไม่แน่นอนและมีโอกาสเสียเงินได้เสมอ",
  },
  {
    q: "หากสมัครหรือฝากถอนไม่สำเร็จต้องทำอย่างไร?",
    a: "ตรวจสอบข้อมูลบัญชีและสถานะรายการก่อน หากยังพบปัญหา สามารถติดต่อแอดมิน CAMPING289 ผ่าน LINE Official พร้อมแจ้งรายละเอียดและเวลาที่ทำรายการ เพื่อให้ทีมงานช่วยตรวจสอบได้ตลอด 24 ชั่วโมง",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <SmoothCarousel />

  <ContentBoxPremium as="h1" title="CAMPING289 เดิมพันอัปสกิลมือโปร เข้าถึงเว็บเจ้าของจริงระดับโลก ได้อย่างปลอดภัย">
    <p class="text-left text-base leading-relaxed text-[#d6e6cc]">
      <strong class="text-[#eefae4]">CAMPING289</strong> พร้อมให้บริการสมาชิกที่ต้องการเล่นสล็อตออนไลน์ผ่านมือถือและคอมพิวเตอร์ มีเกมสล็อตหลากหลายรูปแบบให้เลือก พร้อมข้อมูลเกี่ยวกับกติกา ฟีเจอร์ และแนวทางการบริหารงบประมาณสำหรับผู้เล่น ระบบรองรับการสมัครและเข้าใช้งานผ่านเว็บเบราว์เซอร์
      พร้อมสิทธิพิเศษสำหรับสมาชิก และแอดมินคอยให้คำแนะนำผ่าน LINE Official ตลอด 24 ชั่วโมง
    </p>
  </ContentBoxPremium>

  <ContentBoxTwo as="h2" title="ทางเข้าเว็บตรง CAMPING289 อัปเดตเทคนิคเล่นพนันออนไลน์ อย่างลงตัว">
    <p slot="left" class="text-left text-base leading-relaxed text-[#d6e6cc]">
      สมาชิกสามารถเข้าสู่ CAMPING289 ผ่านหน้าเว็บไซต์ที่รองรับสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ พร้อมติดตามข้อมูลเกมสล็อตและแนวทางการเล่นที่อัปเดตอย่างต่อเนื่อง ไม่ว่าจะเป็นวิธีอ่านกติกา การทำความเข้าใจฟีเจอร์โบนัส การเลือกขนาดเดิมพัน หรือการกำหนดงบประมาณให้เหมาะกับรูปแบบการเล่นของตนเอง
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#d6e6cc]">
      เทคนิคต่าง ๆ ใช้เป็นข้อมูลประกอบการเล่นเท่านั้น ไม่สามารถทำให้เกมสล็อตแตกหรือรับประกันผลกำไรได้ เนื่องจากผลลัพธ์ของแต่ละเกมขึ้นอยู่กับระบบและกติกาของเกมนั้น ๆ
    </p>
  </ContentBoxTwo>

  <ProviderGrid />

  <ContentBoxSevenThreePremium as="h2" title="เข้าเล่น CAMPING289 รับสิทธิพิเศษเพิ่มเติมทุกวัน ไม่จำกัด">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600, 800]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นพื้นป่ายามค่ำคืนโทนเขียวเข้ม มีเต็นท์ ตะเกียง กองไฟ และเหรียญทองกระจายอยู่ ด้านบนซ้ายเป็นโลโก้ CAMPING289 กลางภาพเขียนว่า โปรโมชั่น คืนยอดเสีย 0.3% ตัวใหญ่ ด้านขวาเป็นหญิงสาวสวมชุดแคมป์ปิ้งสีเขียวเข้มแบมือไปทางข้อความ ข้างหลังเป็นวงล้อสล็อตเลข 777 แถวล่างมีป้ายสี่ช่อง มั่นคงปลอดภัย ฝาก-ถอนรวดเร็ว บริการตลอด 24 ชม. และเกมสล็อตคุณภาพ"
      class="mx-auto h-auto w-full rounded-2xl border border-[#69b522]/45 shadow-[0_10px_30px_rgba(105,181,34,0.24)]"
    />
    <div slot="right" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d6e6cc]">
        สมาชิกสามารถ Login เพื่อตรวจสอบโปรโมชั่น โบนัส และสิทธิพิเศษที่เปิดให้รับในแต่ละวันผ่านบัญชีของตนเอง โดยแต่ละกิจกรรมอาจกำหนดยอดที่ใช้คำนวณ รอบการรับ และเงื่อนไขแตกต่างกัน จึงควรอ่านรายละเอียดให้ครบถ้วนก่อนกดรับสิทธิ์
      </p>
      <p class="text-left text-base leading-relaxed text-[#d6e6cc]">
        สำหรับโปรโมชั่นที่ระบุว่าไม่จำกัด ควรยึดวงเงินและข้อกำหนดล่าสุดที่แสดงบนหน้าโปรโมชั่นเป็นหลัก เพื่อให้ทราบรายละเอียดก่อนเข้าร่วมอย่างชัดเจน
      </p>
    </div>
  </ContentBoxSevenThreePremium>

  <ContentBox as="h2" title="สามารถสมัครสมาชิก CAMPING289 บนมือถือด้วยตัวเองได้ง่าย ๆ">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d6e6cc]">เริ่มต้นใช้งานผ่านมือถือได้ง่ายเพียง 3 ขั้นตอน</p>

      <ol class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#d6e6cc]">
        {
          steps.map((step, i) => (
            <li class="flex items-start gap-3 rounded-2xl border border-[#2f7a2a]/60 bg-[#04120a]/70 p-4">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-[#9ada4e] via-[#69b522] to-[#0b5232] text-sm font-black text-[#020a05]">{i + 1}</span>
              <span>{step}</span>
            </li>
          ))
        }
      </ol>

      <p class="text-left text-base leading-relaxed text-[#d6e6cc]">
        ระบบรองรับการใช้งานผ่านเว็บเบราว์เซอร์ทั้ง Android และ iOS รวมถึงแท็บเล็ตและคอมพิวเตอร์ ช่วยให้สมาชิกสามารถตรวจสอบบัญชี โปรโมชั่น และรายการต่าง ๆ ได้จากอุปกรณ์ที่สะดวก
      </p>
    </div>
  </ContentBox>

  <LoginRtpSection />

  <ContentBoxSpecial as="h2" title="รับคำแนะนำกับแอดมิน CAMPING289 ผ่าน LINE Official ได้ตลอด 24 ชั่วโมง">
    <p slot="left" class="text-left text-base leading-relaxed text-[#d6e6cc]">
      หากมีข้อสงสัยเกี่ยวกับการสมัครสมาชิก การเข้าสู่ระบบ การฝากถอน โปรโมชั่น หรือวิธีใช้งานส่วนต่าง ๆ สามารถติดต่อแอดมิน CAMPING289 ผ่าน LINE Official ได้ตลอด 24 ชั่วโมง ทีมงานพร้อมช่วยตรวจสอบรายการและแนะนำขั้นตอนการใช้งาน รวมถึงแจ้งข้อมูลเกมและโปรโมชั่นที่อัปเดตล่าสุด
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#d6e6cc]">
      หากต้องการคำแนะนำเกี่ยวกับเกมสล็อต สามารถสอบถามข้อมูลเกี่ยวกับกติกาและฟีเจอร์ของเกมได้ แต่ควรหลีกเลี่ยงการเชื่อคำแนะนำที่อ้างว่าสามารถการันตีกำไรหรือผลรางวัลได้
    </p>
  </ContentBoxSpecial>

  <Faq title="คำถามที่พบบ่อยเกี่ยวกับ CAMPING289" faqs={faqs} />

  <LatestWinners />

  <ReviewCardSumo2 />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#9ada4e] via-[#69b522] to-[#0b5232] px-4 py-3 text-sm font-black whitespace-nowrap text-[#020a05] shadow-[0_10px_30px_rgba(105,181,34,0.28)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(105,181,34,0.42)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#dbaa8a]/50 bg-gradient-to-r from-[#0a2c18] to-[#04120a] px-4 py-3 text-sm font-black whitespace-nowrap text-[#eefae4] shadow-[0_10px_30px_rgba(105,181,34,0.16)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#dbaa8a]/80 hover:text-[#f4fdec] hover:shadow-[0_15px_40px_rgba(219,170,138,0.3)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>
  </div>

  <Navfoot />
</MainLayout>
