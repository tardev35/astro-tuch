---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxTwoFloatingBadge from "../components/ContentBoxTwoFloatingBadge.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import Faq from "../components/Faq.astro";
import LatestWinners from "../components/LatestWinnersPremium.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import { pageGraph } from "../lib/schema";
import cashbackPoster from "../assets/slide2.png";
import referralPoster from "../assets/slide1.png";

// การหมุน variant รอบนี้ตัดสินไว้แล้วใน .claude/brand-spec-teva69.md §3 —
// **ห้ามเลือกใหม่ที่นี่** แบรนด์ขาออก (LOTTO189) ถูกหมุนออกจากทุกตระกูลพร้อมกัน:
// AnnouncementPremium แทน AnnouncementHuay · Faq แทน Faq2 · LatestWinnersPremium
// แทน LatestWinners3 · ReviewCardSumo2 แทน ReviewCardSumo · และ shape-mix ของ
// ContentBox ทิ้งชุด *Huay + Premium ของรอบก่อนทั้งชุด ไปใช้ **ชุด *FloatingBadge
// นำ + CyberCut + ตัวฐาน + SevenThree + Special** แทน พร้อมวิดเจ็ตใหม่
// **ProviderGrid** (ค่ายเกม) แทน LottoGrid ซึ่งตรงแกนแบรนด์รอบนี้ที่เป็น
// **เว็บเกมพนัน/คาสิโน-สล็อต ไม่ใช่เว็บหวย** (กลับทิศจากรอบก่อน)
// ไม่ลบไฟล์ที่ไม่ได้ใช้แม้แต่ตัวเดียว — มันคือ inventory ของแบรนด์ถัดไป
// Navbar/Footer อยู่ที่ MainLayout (NavbarStyle10 / FooterStyle2) ไม่ใช่ที่ไฟล์นี้
// ❌ รอบนี้ **ไม่ใช้ BankStrip / FeatureHighlights / SmoothCarousel /
// ContentBox3Three*** — บรีฟรอบนี้ไม่มีหมวดฝากถอน ธนาคาร หรือวอลเลทเลยแม้แต่คำเดียว
// และไม่มีหมวดใดที่เป็นลิสต์ย่อย 2-4 ข้อแบบ FeatureHighlights
// ⚠️ `<Announcement />` ถูกเรียกแบบ **ไม่ส่ง message** โดยตั้งใจ — orchestrator ตั้ง
// ค่า default ของ AnnouncementPremium เป็นคอปปี้ของแบรนด์รอบนี้ไว้แล้วใน P1 และหน้า
// ย่อยทุกหน้าก็เรียกแบบ bare เหมือนกัน ข้อความ ticker จึงตรงกันทั้งเว็บจากที่เดียว
//
// ⚠️⚠️ พาเลตรอบนี้ (brand-spec §2 ล็อกค่าไว้ ห้ามเดาเพิ่ม ห้ามดูดสีจากรูป):
// **เนื้อหาสว่าง (การ์ดขาวบนพื้นขาวอมมิ้นต์จาง) · โครมเข้ม (เขียวป่าเกือบดำ)**
// พื้นเพจ #f0ffeb (bg.json) · การ์ด #ffffff · ชั้นยก #e6f7df · wash #d7f0cd ·
// เส้น #b2dba3 / #3f7a2e · หมึก #10280f (= BRAND_TEXT) · หมึกรอง #3c5b36 ·
// **หัวข้อ + ลิงก์ + <strong> = #116018** (7.8:1 บนขาว) · เขียวลึก #0b4a12 ·
// เขียวแบรนด์ #1a7d24 · ทองเข้ม #8a6a0e · ปุ่มไล่ #0b4a12 -> #116018 -> #1a7d24
// 🚨🚨 **#28c437 (2.3:1) #e3bb45 (2.0:1) #c6cfd2 #b2dba3 #d7f0cd #e6f7df #f0ffeb
// ห้ามถือตัวอักษรบนผิวสว่างเด็ดขาด** (พื้นถม/ขอบ/ออราเท่านั้น) และ #3f7a2e เป็น
// **เส้น** เท่านั้น · #28c437 #e3bb45 #c6cfd2 เป็นไฮไลต์ของ **โครมเข้ม** ห้ามหลุด
// มาถือตัวอักษรบนการ์ดขาว → `<strong>` ทุกตัวในไฟล์นี้จึงเป็น **#116018 ค่าเดียว**
// ไม่ใช่ #1a7d24 และไม่ใช่ #28c437
// ⚠️⚠️ **รอบนี้เป็นแบรนด์เขียว/เงินโครเมียม และเขียวเคยเป็นฮิวนำของแบรนด์เก่ามาแล้ว
// หลายเจ้า** → "เจอเขียว ≠ เป็นของรอบนี้" ต้องเทียบให้ตรงหกหลัก ค่าที่ห้ามเหลือ
// (เขียนแบบไม่มี # เพื่อไม่ให้ sweep สะดุดที่คอมเมนต์นี้): fff0f0 ffe4e6 ffd4d7
// f5b9bd a8333f 25090f 6e3b44 b00718 c1071b 8a0412 8f6310 d61023 ff2436 e9b53c
// 24060c 3d0d16 120307 7e1221 ffeaea f0bcbc c3ccd6 (LOTTO189 ขาออก เสี่ยงสูงสุด —
// **e9b53c ↔ e3bb45 · c3ccd6 ↔ c6cfd2 · 8f6310 ↔ 8a6a0e**) · 8ce023 e9f7d6 bde397
// 1a5c04 2f8c07 051400 0f2e05 06220a a87a08 f2c230 ffe066 (KINGKONG555 —
// **e9f7d6 ↔ e6f7df · bde397 ↔ b2dba3 · 1a5c04 ↔ 1a7d24**) · 0b7d28 0a5f1c 0f9b35
// 0c3a16 061f0c (สาธุ168 — **0b7d28 ↔ 0b4a12**) · 1fae1c 0d2312 143a1c 07130a
// (888PARUAY) · 117a41 2bb061 2fbf6a (MEXICANOSLOT/KOON234 — **2bb061 ↔ 28c437**) ·
// 2a1206 7a3a0c fff3e0 e0b784 c98a24 c23400 d13800 fa4903 fde90b e8a000 ff8a2b
// (ZNOVA168) · 7a1bd6 2b3fd9 c2178b f23bb4 bb6dff 7aa7ff 5411c4 241046 f8e6f9
// f6edfe ece0fb dcc6f4 (ZANE96) · de2b1e f2a033 a81410 c81e12 3f130d (MEXICANOSLOT)
// ⚠️ รอบนี้ **ไม่มีม่วง ไม่มีฟ้า/ไซแอน ไม่มีชมพู/แมเจนต้า ไม่มีแดง ไม่มีส้มเพลิง**
// เป็นสี UI เลยสักเฉด · LINE green 00B900 กับเขียว success ของฟีดเป็นสีเชิงความหมาย
// **คงไว้ ห้ามกลืนเข้าพาเลตเขียวของรอบนี้**
//
// ย่อหน้าในไฟล์นี้ไม่ถือคลาสสีหรือขนาดของตัวเอง — ทุก ContentBox* ในมิกซ์นี้ตั้ง
// `text-left text-base leading-relaxed` + หมึก #10280f ไว้บน element ที่ถือ slot
// อยู่แล้ว และไม่มี `<p>` ไหนมี mx-auto / max-w-* (การ์ดคุมความกว้างเองแล้ว)
// ข้อยกเว้นเดียวคือ **ป้าย "ขั้นตอนที่ 1/2/3" ใน §6** ซึ่งเป็นป้าย ไม่ใช่เนื้อความ
// จึงถือ font-bold + สีหัวข้อได้ และต้องเป็น <p> **ห้ามเป็น heading ทุกระดับ**
//
// ⚠️ ชื่อแบรนด์รอบนี้เป็น **ตัวละตินพิมพ์ใหญ่ + เลข ติดกัน ไม่มีเว้นวรรค ไม่มีขีด**
// (ต่างจากโดเมนที่มีขีด) แต่ยัง interpolate จาก `${BRAND_NAME}` ทุกจุดรวมถึงใน alt
// ของสไลด์ **ห้ามพิมพ์ชื่อแบรนด์เป็นตัวอักษรตรงๆ ที่ไหนเลย** ไม่มีโดเมนเขียนไว้
// ที่ไหน และไม่มี URL ที่ต่อด้วย `+`
//
// <strong> ทุกตัวคร่อม "ก้อนที่คั่นด้วยช่องว่าง" ทั้งก้อน เพราะภาษาไทยไม่มีช่องว่าง
// ระหว่างคำ — ไฮไลต์ที่เริ่มหรือจบกลางคำจะถูก formatter ตัดบรรทัดในแท็กแล้วแทรก
// ช่องว่างกลางคำ อ่านคอปปี้โดยถอดแท็กออกต้องได้ข้อความของบรีฟเป๊ะ และไม่มี <strong>
// สองตัวติดกันโดยไม่มีข้อความธรรมดาคั่น
//
// บรีฟรอบนี้ **โฆษณาและกำกับในประโยคเดียวกัน** (brand-spec §5): หัวข้อเขียนว่า
// ค่ายแท้ ถูกลิขสิทธิ์ เซิร์ฟนอก ปลอดภัยในไทย / สมัครเล่นไม่มีขั้นต่ำ ขณะที่ย่อหน้า
// ของบรีฟเองตอบกลับว่า คำกล่าวอ้างว่าเป็นเกมถูกลิขสิทธิ์หรือมีความปลอดภัยในไทย
// ไม่สามารถยืนยันได้จากข้อความโฆษณาเพียงอย่างเดียว · ควรตรวจสอบว่าข้อความไม่มี
// ขั้นต่ำครอบคลุมเฉพาะการสมัครสมาชิกหรือรวมถึงการฝากเงินและการเดิมพันด้วย ·
// โปรโมชั่นคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาส
// ชนะในครั้งถัดไป — **ship ทั้งสองครึ่งตรงตามที่บรีฟเขียน ไม่ขยายคำโฆษณาเป็นคำกล่าว
// อ้างใหม่ และทุกประโยคกำกับ ship ครบ ไม่ตัดเพราะฟังดูลบ**
// ตัวเลขบนหน้านี้มีแค่ของบรีฟเอง: **0.3% · 0.8% · 3 ขั้นตอน · 24ชม.**
// 🚨🚨 **กลับทิศจากรอบก่อน: `0.3%` กับ `0.8%` รอบก่อนห้ามเป็นเนื้อความ แต่รอบนี้เป็น
// เนื้อหาของบรีฟจริง (content.txt บรรทัด 8-12)** จึงเป็นทั้งหัวข้อและเนื้อความได้
// ❌ และคำของแบรนด์ก่อนห้ามเขียนกลับเข้ามา: LOTTO189 / แนะนำเว็บหวยลอตโต้ /
// แทงหวยจ่ายสด / รับทุกเลข ไม่มีอั้น / หวยรัฐบาลไทย / หวยลาว / หวยฮานอย /
// หวยหุ้นต่างประเทศ / จ่ายเต็ม จ่ายสด / อัตราจ่าย 2 ตัว 100 / 3 ตัว 1,000 /
// สองตัวบน-ล่าง / สามตัวตรง-โต๊ด / รอบปิดรับ / บิลหวย / โพยหวย / งวด (LOTTO189 —
// ใกล้ตัวที่สุดเพราะเป็นแบรนด์ขาออกทันที) · ZNOVA168 / ZOLO99 / สล็อต1บาททรูวอลเลท /
// ฝากถอนธนาคารและวอลเลท / สล็อตคลาสสิก / ฟรีสปิน / เกมโบนัส / ค่า RTP /
// ความผันผวน (ZNOVA168) · ZANE96 / สล็อตลิขสิทธิ์แท้ในไทย / เว็บตรงไม่ผ่านเอเย่นต์ /
// ยูสใหม่เล่น1บาทได้ (ZANE96) · MEXICANOSLOT / สล็อตเมกซิกัน / การันตีเว็บตรง /
// ยอดเข้าบริษัทแน่นอน (MEXICANOSLOT) · okkub88 / ทรูวอลเลท / ทรูมันนี่ /
// โบ๊ะบ๊ะ168 / หมูบิน168 / สล็อต168 / นาซ่า168 / มาดาม168 / เงินทอง168 /
// KINGKONG555 / ขวัญใจ168 / เว็บตรงแตกง่าย / เบทต่ำ / ไม่ทำเทิร์น /
// ถอนได้ไม่จำกัด / ไม่ผ่านเอเย่นต์100% / ไม่ผ่านม้า
// ⚠️ **คำหมวดเกมพนันทั่วไปรอบนี้ใช้ได้** (เกมพนัน · เกมเดิมพัน · ค่ายเกม ·
// ค่ายแท้ ถูกลิขสิทธิ์ · เซิร์ฟนอก · ปลอดภัยในไทย · สมัครสมาชิก · โปรโมชั่น ·
// คืนยอดเสีย · แนะนำเพื่อน) เพราะเป็นคำของบรีฟเอง — อย่าสืบทอดข้อห้ามข้ามรอบ
// โดยไม่เปิดบรีฟดู ("เซิร์ฟนอก" ของบรีฟรอบนี้ ≠ "เซิร์ฟไทย" ของ นาซ่า168)
//
// title/description = บรรทัด 1-2 ของบรีฟ **verbatim** (src/assets/content.txt)
// ส่งที่นี่เพราะ pageGraph ต้องใช้สตริงเดียวกับที่ MainLayout ได้รับ
// **ห้ามต่อเติม** (description = 123 ตัวอักษร ตามที่บรีฟเขียนมาเอง และ
// verify-build ยกเว้นเพดานล่าง 150 ให้หน้าแรกไว้ด้วยเหตุผลนี้โดยเฉพาะ)
const pageTitle = `${BRAND_NAME} เกมพนันเบอร์ต้นๆของไทย สมัครเล่นไม่มีขั้นต่ำ`;

const pageDescription = `${BRAND_NAME} เกมพนันเบอร์ต้นๆของไทย แหล่งรวมเกมเดิมพันออนไลน์ ค่ายแท้ ถูกลิขสิทธิ์ เซิร์ฟนอก ปลอดภัยในไทย สมัครเล่นไม่มีขั้นต่ำ`;

// บรรทัด 1 กับบรรทัด 3 ของบรีฟรอบนี้เป็นข้อความเดียวกันพอดี — H1 จึงใช้สตริงเดียวกับ
// title ตามที่บรีฟเขียนมา **ไม่ใช่การคัดลอก แต่เป็นการไม่แต่งเพิ่ม**
const pageH1 = pageTitle;

// บรีฟรอบนี้มีชั้น H1 -> H2 -> H3 จริง จึง **ไม่** แบนเป็น H2 ล้วน
//
// checklist ตามลำดับเอกสาร (brand-spec §4) และตัวที่รับแต่ละข้อ:
//    1 H1  <แบรนด์> เกมพนันเบอร์ต้นๆของไทย สมัครเล่นไม่มีขั้นต่ำ
//          ContentBoxCyberCut, ย่อหน้าบรรทัด 4
//    2 H2  <แบรนด์> ค่ายแท้ ถูกลิขสิทธิ์ เซิร์ฟนอก ปลอดภัยในไทย
//          ContentBoxTwoFloatingBadge, บรรทัด 6 แบ่งสองซีกโดยไม่ตกประโยคไหน
//          + ProviderGrid ต่อท้าย (วิดเจ็ตอธิบายค่ายเกม/เซิร์ฟ/ลิขสิทธิ์ของหัวข้อนี้โดยตรง)
//    3 H2  โปรโมชั่น <แบรนด์> อัปเดตใหม่ตลอดสัปดาห์
//          ContentBox ตัวฐาน (จังหวะคั่นกลางชุด FloatingBadge โดยตั้งใจ), บรรทัด 8
//    4 H3  โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน
//          ContentBoxSevenThreeFloatingBadge + slide2 ในสล็อตขวา, บรรทัด 10
//    5 H3  โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด
//          ContentBoxSevenThree ตัวฐาน + slide1 ในสล็อตขวา, บรรทัด 12
//    6 H2  สมัครเล่น <แบรนด์> ไม่มีขั้นต่ำ 3 ขั้นตอน
//          ContentBoxFloatingBadge, intro (บรรทัด 14) + สามขั้นตอน (บรรทัด 15-20)
//          ห่อใน <div> เดียวตามกฎบ้าน "หนึ่งสล็อตรับ element เดียว"
//    7 H2  แอดมิน <แบรนด์> ออนไลน์ตลอด 24ชม.
//          ContentBoxSpecial, บรรทัด 22 แบ่งสองซีกโดยไม่ตกประโยคไหน
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ <แบรนด์>
//          Faq + prop faqs ชัดเจน, บรรทัด 24-29
// inventory ที่ต้องได้: **h1 ×1 · h2 ×5 · h3 ×2** — ตรงเป้าของ brand-spec §4
//
// ⚠️ จุดที่ชั้น heading รั่วได้ และกันไว้แล้วทุกจุด: บรรทัด 15/17/19 ของบรีฟ
// (ขั้นตอนที่ 1/2/3) **ไม่มี prefix H** จึง render เป็น <p class="font-bold">
// ในสล็อตของ §6 ไม่ใช่ป้ายคอลัมน์และไม่ใช่ heading · ContentBoxTwoFloatingBadge
// **ไม่ส่ง titleleft/titleright** เพราะบรีฟไม่ได้ตั้งชื่อให้สองซีกนั้น การคิดป้าย
// ขึ้นมาเองจะเป็นถ้อยคำของหน้า ไม่ใช่ของบรีฟ · **ไม่ส่ง titleright ให้ SevenThree
// ทั้งสองใบ** คอลัมน์ภาพจึงไม่มี heading · ContentBoxSpecial ปล่อยหัวข้อเดียว
// สองซีกไม่มีป้าย · คำถามใน Faq เป็น <p> ใน <summary> ไม่ใช่ heading และหัวข้อของมัน
// มาจาก prop
// grep `<h[1-6]` ในทุก component ที่ไฟล์นี้เรียกแล้วรอบนี้ — ไม่มีตัวไหน hardcode
// heading ไว้เลย ทุกแท็ก heading บนหน้ามาจาก prop คือมาจากบรีฟ
// chrome บนหน้านี้ (AnnouncementPremium · ProviderGrid · LatestWinnersPremium ·
// ReviewCardSumo2 · Navfoot) ขึ้นป้ายเป็น <p>/<span> พร้อม aria-label บน <section>
// **ห้ามเลื่อน <p> พวกนั้นขึ้นเป็น h2 เพื่อ "แก้ชื่อที่ขาด"**
//
// ── รูปภาพ ────────────────────────────────────────────────────────────────
// รอบนี้ใช้ **สองใบ** และอยู่ในตระกูล SevenThree ทั้งคู่ (playbook ตรึง slide* ไว้
// กับตระกูลนี้ และเพดานคือ 2 บล็อก — รอบนี้ใช้ครบพอดี ไม่มีใบที่สาม)
// **ข้อความที่พิมพ์บนอาร์ตเวิร์กคือตัวตัดสินการจับคู่ ไม่ใช่ลำดับไฟล์** เปิดอ่านจริง
// ด้วย Read แล้วรอบนี้ได้ว่า:
//   slide2.png พิมพ์ **คืนยอดเสีย 0.3%** -> §4 (ContentBoxSevenThreeFloatingBadge)
//   slide1.png พิมพ์ **แนะนำเพื่อน 0.8%** -> §5 (ContentBoxSevenThree ตัวฐาน)
// ⚠️ **กลับข้างจากรอบก่อน** uploader เขียนทับสองไฟล์นี้ทุกดรอป การจับคู่จึงไม่มี
// ความหมายข้ามแบรนด์ — ห้ามลอกจากรอบก่อน
// ⛔ **banner1 / banner1-mobile / og.png เป็นของ MainLayout** (glob ปักชื่อไว้แล้ว)
// และ **banner2.png / banner3.png / slide3.png / slide4.png เป็นอาร์ตเวิร์กของ
// แบรนด์อื่น ห้าม import เด็ดขาด** เพราะ eager import = emit ขึ้น dist ทุก build
// แม้ไม่มีหน้าไหน render และ verify-build.mjs จะแดงถ้ามีรูปที่ไม่ได้ถูก render
// ⚠️ ไม่มีภาพไหนบนหน้านี้เป็น LCP (hero อยู่ที่ MainLayout) จึง **ไม่มี
// loading="eager" / fetchpriority="high"** สักใบ สไลด์ทั้งสองอยู่ใต้ fold
//
// `widths`/`sizes` คำนวณจากเรขาคณิตจริงของคอลัมน์ภาพ (3fr ฝั่งขวา) ของ **variant
// ที่ถือรูปใบนั้นจริง ๆ** — สองชุดนี้ **สลับกันไม่ได้** และ **ไม่ได้ลอกจากรอบก่อน**
// (Tailwind เป็น border-box ทั่วโปรเจกต์ max-w/padding จึงนับรวมกัน · บิตแมปจริงของ
// ดรอปนี้วัดจาก IHDR ได้ **375x600 ทั้งสองใบ** เพดานจึงเป็น 375 และ **ห้ามมี
// candidate ไหนเกิน 375** เพราะเกินกว่านั้นคือการอัพสเกล ไม่ใช่พิกเซลจริง)
//
// §4 ContentBoxSevenThreeFloatingBadge — **max-w-7xl อยู่ที่การ์ด** px-4 จึงไม่ถูกหัก
// ออกจาก 1280 เมื่อ cap ทำงาน · border-2 = 4 · p-8 = 64 · gap-10 = 40 ·
// คอลัมน์ภาพจ่าย md:pl-10 (40) + md:border-l (1) = 41
//   >= 1312px : (1280 − 4 − 64 − 40) × 0.3 − 41 = 1172 × 0.3 − 41 ≈ 311px
//   768–1311  : (100vw − 140) × 0.3 − 41        = calc(30vw − 83px)
//   475–767   : ยุบเหลือคอลัมน์เดียวที่การ์ด p-8 → 100vw − 100 ซึ่ง ≥ 375 จึงติด
//               เพดานบิตแมป                      = 375px
//   < 475     : คอลัมน์เดียวที่ p-8               = calc(100vw − 100px)
// candidate: 156 = ครึ่งของ 311 (และใกล้ค่าต่ำสุดของแบนด์ md ที่ 768px = 147) ·
//   275 = 100vw−100 ที่จอ 375px · 311 = 1× ที่ >= 1312px · 375 = **เพดานบิตแมปจริง**
const cashbackWidths = [156, 275, 311, 375];
const cashbackSizes = "(min-width: 1312px) 311px, (min-width: 768px) calc(30vw - 83px), (min-width: 475px) 375px, calc(100vw - 100px)";

// §5 ContentBoxSevenThree ตัวฐาน — **max-w-7xl อยู่ที่ <section>** px-4 จึงถูกหักออก
// จาก 1280 · border 1×2 = 2 · p-8 = 64 / md:p-10 = 80 · gap-10 = 40 ·
// คอลัมน์ภาพจ่าย md:pl-6 = 24 (ส่วน md:border-r + md:pr-6 อยู่บนคอลัมน์ข้อความ
// จึงหักจากแทร็กของมันเอง ไม่ใช่ของรูป)
//   >= 1280px : (1280 − 32 − 2 − 80 − 40) × 0.3 − 24 = 1126 × 0.3 − 24 ≈ 314px
//   768–1279  : (100vw − 154) × 0.3 − 24             = calc(30vw − 70px)
//   473–767   : คอลัมน์เดียวที่การ์ด p-8 → 100vw − 98 ซึ่ง ≥ 375 จึงติดเพดาน = 375px
//   < 473     : คอลัมน์เดียวที่ p-8                   = calc(100vw − 98px)
// candidate: 157 = ครึ่งของ 314 (และใกล้ค่าต่ำสุดของแบนด์ md ที่ 768px = 160) ·
//   277 = 100vw−98 ที่จอ 375px · 314 = 1× ที่ >= 1280px · 375 = **เพดานบิตแมปจริง**
const referralWidths = [157, 277, 314, 375];
const referralSizes = "(min-width: 1280px) 314px, (min-width: 768px) calc(30vw - 70px), (min-width: 473px) 375px, calc(100vw - 98px)";

// ⚠️ อาร์ตเวิร์กพิมพ์ชื่อแบรนด์ไว้บนรูปจริง แต่ alt บรรยาย **รูปทรงของเวิร์ดมาร์ก**
// แล้วอ้างชื่อด้วย ${BRAND_NAME} — ห้ามพิมพ์ตัวอักษรชื่อแบรนด์ลง alt ตรงๆ
// บรรยายจากบิตแมปจริงของดรอปนี้ (brand-spec §6) ไม่ใช่คัดลอกของรอบก่อน:
// ภาษาภาพของ LOTTO189 ที่ **ไม่มี** ในสองรูปนี้ — ลูกบอลหวยสีขาวพิมพ์ตัวเลข ·
// ใบโพยหวยกองซ้อน · ปากกาด้ามสีทอง · อาร์มแชร์ขาวขอบทอง · แคปซูลแดงเข้มขอบทอง ·
// และของเก่ากว่านั้น นักรบหญิงถือดาบเงิน · ริบบิ้นแดงพลิ้ว · ทองหลอมเหลว ·
// ตู้สล็อต 777 ม่วง · เชอร์รี่ชมพู · เพชรม่วง · ซอมเบรโร · กระบองเพชร
// ✅ **ชิปคาสิโนเขียว มงกุฎทอง และต้นไม้ในกระถางมีจริงในดรอปนี้** บรรยายได้ตามที่เห็น
const cashbackAlt = `โปสเตอร์แนวตั้งของ ${BRAND_NAME} บนฉากห้องสีขาวครีม มุมบนซ้ายเป็นโลโก้ ${BRAND_NAME} ซึ่งเป็นเวิร์ดมาร์กสามมิติที่ครึ่งแรกเป็นตัวอักษรละตินผิวโครเมียมเงินขัดเงา และครึ่งหลังเป็นตัวเลขผิวเขียวมรกตเคลือบเงา ตัดขอบดำหนาทั้งชุด กลางภาพเป็นหญิงสาวผมยาวสีน้ำตาลเข้มดัดลอน สวมสูทสีขาว นั่งเท้าแขนอยู่ที่โต๊ะที่มีโน้ตบุ๊กเปิดอยู่ ขนาบด้วยกองชิปคาสิโนสีเขียวเข้มสลับขาวพิมพ์เลข 69 และ 6 และมีต้นไม้ใบเขียวในกระถางอยู่ริมหน้าต่างบานสูงด้านหลัง ครึ่งล่างพิมพ์คำว่า โปรโมชั่น เป็นตัวอักษรสามมิติสีเขียวมรกตตัดขอบขาว โดยมีมงกุฎทองดวงเล็กอยู่เหนือตัวอักษร ใต้ลงมาเป็นคำว่า คืนยอดเสีย ตัวอักษรขาวบนแถบเขียวเข้ม แล้วตามด้วยตัวเลข 0.3% ตัวโตสีเขียวตัดขอบขาว ปิดท้ายด้วยแคปซูลพื้นเขียวเข้มขอบขาวที่เขียนว่า สมัครสมาชิก พร้อมไอคอนรูปคนและเครื่องหมายลูกศรคู่`;

const referralAlt = `โปสเตอร์แนวตั้งของ ${BRAND_NAME} ในฉากห้องสีขาวครีมเดียวกัน มุมบนซ้ายเป็นโลโก้ ${BRAND_NAME} แบบเวิร์ดมาร์กสามมิติ ครึ่งแรกเป็นตัวอักษรละตินผิวโครเมียมเงินขัดเงา ครึ่งหลังเป็นตัวเลขผิวเขียวมรกตเคลือบเงา ตัดขอบดำหนา กลางภาพเป็นหญิงสาวผมยาวสีน้ำตาลเข้มดัดลอน สวมสูทสีขาว ท้าวคางอยู่ที่โต๊ะที่มีโน้ตบุ๊กเปิดอยู่ รายล้อมด้วยกองชิปคาสิโนสีเขียวเข้มสลับขาวพิมพ์เลข 69 และ 6 กับต้นไม้ใบเขียวในกระถางด้านหลัง ครึ่งล่างพิมพ์คำว่า โปรโมชั่น เป็นตัวอักษรสามมิติสีเขียวมรกตตัดขอบขาว มีมงกุฎทองดวงเล็กวางอยู่เหนือตัวอักษร ถัดลงมาเป็นคำว่า แนะนำเพื่อน ตัวอักษรขาวบนแถบเขียวเข้ม แล้วตามด้วยตัวเลข 0.8% ตัวโตสีเขียวตัดขอบขาว ปิดท้ายด้วยแคปซูลพื้นเขียวเข้มขอบขาวที่เขียนว่า สมัครสมาชิก พร้อมไอคอนรูปคนและเครื่องหมายลูกศรคู่`;

// อาร์เรย์เดียว ใช้ทั้งกับ <Faq> และโน้ด FAQPage — ไม่ใช้ default ของ component
// (Faq ตั้งใจ ship เป็นลิสต์ว่าง prop ที่ลืมส่งจึงได้ accordion เปล่า ไม่ใช่
// คำถามของแบรนด์ก่อน) สามคู่นี้คือบล็อก Q/A ของบรีฟเอง (content.txt บรรทัด 24-29)
// ตรงตัว ตัดเฉพาะหมายเลข "1." "2." "3." ออกเพราะ accordion เป็นตัวลิสต์อยู่แล้ว
// ทุกคำตอบคงประโยคกำกับของบรีฟไว้ครบ — เป็นเนื้อหาของบรีฟทั้งสองครึ่ง
const faqs = [
  {
    q: `${BRAND_NAME} สมัครสมาชิกโดยไม่มีขั้นต่ำได้จริงหรือไม่?`,
    a: `ตามข้อมูลที่ระบุ ${BRAND_NAME} เปิดให้สมัครสมาชิกโดยไม่มีขั้นต่ำ แต่ควรตรวจสอบว่าข้อกำหนดดังกล่าวครอบคลุมการฝากเงินและการเดิมพันหรือไม่ เพราะแต่ละเกมอาจกำหนดยอดขั้นต่ำแตกต่างกัน`,
  },
  {
    q: `${BRAND_NAME} มีโปรโมชั่นคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% หรือไม่?`,
    a: `ตามข้อมูลที่ระบุ มีโปรโมชั่นทั้งสองรายการ โดยควรตรวจสอบประเภทเกมที่เข้าร่วม รอบคำนวณยอด และเงื่อนไขการรับเครดิตจากประกาศล่าสุดก่อนใช้สิทธิ์`,
  },
  {
    q: `${BRAND_NAME} มีเจ้าหน้าที่ให้บริการตลอด 24 ชั่วโมงหรือไม่?`,
    a: `เว็บไซต์ระบุว่ามีแอดมินออนไลน์ตลอด 24 ชั่วโมง โดยควรตรวจสอบช่องทางติดต่อและเวลาการให้บริการจริงจากประกาศล่าสุดของผู้ให้บริการ`,
  },
];

// ไม่มี breadcrumb: นี่คือหน้าแรก เส้นทางจาก root มาหาตัวเองจะเหลือครั้งเดียวที่ชี้ตัวเอง
// ทุก URL ในกราฟมาจาก pageGraph ที่ derive จาก site: — ไม่มีโดเมนพิมพ์ไว้ในไฟล์นี้
// ไม่มี URL ที่ต่อด้วย `+` และไม่ส่งโน้ด Review / AggregateRating / sameAs /
// address / email เข้าไปเลย
// `description` เป็นสตริงเดียวกับที่ MainLayout ได้รับ `name` เป็น H1 ของหน้า และ
// `faqs` เป็นอาร์เรย์ตัวเดียวกับที่ <Faq> ได้รับ
const graph = pageGraph(Astro, {
  name: pageH1,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxCyberCut as="h1" title={pageH1}>
    <p>
      {BRAND_NAME}
      <strong class="text-[#116018]">นำเสนอข้อมูลเกมเดิมพันออนไลน์หลากหลายประเภท</strong>
      พร้อมรายละเอียดระบบสมาชิก โปรโมชั่น และช่องทางติดต่อเจ้าหน้าที่ ภายในเว็บไซต์มีข้อมูลเกมจากค่ายต่าง ๆ ให้ผู้ใช้งานศึกษากติกา รูปแบบการเดิมพัน และเงื่อนไขการใช้บริการ
      <strong class="text-[#116018]">โดยระบุว่าสามารถสมัครสมาชิกได้โดยไม่มีขั้นต่ำ</strong>
      ทั้งนี้ ควรตรวจสอบข้อกำหนดเกี่ยวกับยอดฝากและยอดเดิมพันของแต่ละเกม รวมถึงความน่าเชื่อถือของผู้ให้บริการก่อนใช้งาน
    </p>
  </ContentBoxCyberCut>

  <ContentBoxTwoFloatingBadge as="h2" title={`${BRAND_NAME} ค่ายแท้ ถูกลิขสิทธิ์ เซิร์ฟนอก ปลอดภัยในไทย`}>
    <p slot="left">
      {BRAND_NAME} นำเสนอข้อมูลเกมเดิมพันจากผู้พัฒนาหลายค่าย
      <strong class="text-[#116018]">พร้อมระบุการใช้งานระบบเซิร์ฟเวอร์ต่างประเทศและการเชื่อมต่อเกมผ่านแพลตฟอร์มออนไลน์</strong>
    </p>
    <p slot="right">
      ผู้ใช้งานควรตรวจสอบรายชื่อค่ายเกม ข้อมูลบริษัทผู้ให้บริการ และหลักฐานการได้รับอนุญาตอย่างชัดเจน
      <strong class="text-[#116018]">เนื่องจากคำกล่าวอ้างว่าเป็นเกมถูกลิขสิทธิ์หรือมีความปลอดภัยในไทยไม่สามารถยืนยันได้จากข้อความโฆษณาเพียงอย่างเดียว</strong>
      นอกจากนี้ควรตรวจสอบนโยบายคุ้มครองข้อมูลส่วนบุคคลและข้อกำหนดทางกฎหมายที่เกี่ยวข้องก่อนใช้งาน
    </p>
  </ContentBoxTwoFloatingBadge>

  <ProviderGrid />

  <ContentBox as="h2" title={`โปรโมชั่น ${BRAND_NAME} อัปเดตใหม่ตลอดสัปดาห์`}>
    <p>
      {BRAND_NAME} นำเสนอข้อมูลโปรโมชั่นสำหรับสมาชิก
      <strong class="text-[#116018]">โดยมีรายการคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8% เป็นสิทธิพิเศษที่ระบุไว้</strong>
      ผู้ใช้งานสามารถติดตามรายละเอียดโปรโมชั่นที่อัปเดตในแต่ละสัปดาห์ เพื่อศึกษาช่วงเวลารับสิทธิ์และเงื่อนไขการใช้เครดิต ทั้งนี้ โปรโมชั่นแต่ละรายการอาจกำหนดประเภทเกม ยอดที่นำมาคำนวณ และข้อจำกัดการถอนเงินแตกต่างกัน
      <strong class="text-[#116018]">จึงควรตรวจสอบประกาศล่าสุดก่อนเข้าร่วม</strong>
    </p>
  </ContentBox>

  <ContentBoxSevenThreeFloatingBadge as="h3" title="โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน">
    <p slot="left">
