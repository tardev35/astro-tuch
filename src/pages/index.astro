---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import LatestWinners from "../components/LatestWinners3.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import Faq from "../components/Faq2.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import { pageGraph } from "../lib/schema";
import imgCashback from "../assets/slide1.png";
import imgReferral from "../assets/slide2.png";

// VARIANT ROTATION THIS ROUND (UOK365 -> GUCCI168), per brand-spec §3. Zero file
// reuse from the previous round: Announcement3 replaces AnnouncementPremium,
// LatestWinners3 replaces LatestWinnersPremium, Faq2 replaces Faq4,
// ReviewCardSumo2 replaces ReviewCardSumo, and the ContentBox shape-mix moves off
// FloatingBadge / TwoCyberCut / ContentBox(plain) / SevenThree(plain) /
// SevenThreeCyberCut / TwoFloatingBadge / CyberCut onto Premium / TwoPremium /
// Neumorphism / SevenThreePremium / SevenThreeNeumorphism / TwoNeumorphism /
// Special. NavbarStyle8 and FooterStyle3 are the layout's pair this round
// (previously NavbarPremium / FooterPremium) and the brand font moves
// google-sans -> kanit; all three are the orchestrator's shared-chrome step, not
// this page's.
// Plain ContentBox is deliberately NOT used by this page this round — terms,
// privacy, 404 and every button page render their body through it by rule and
// cannot follow a rotation, so it stays always-live in the shared step and this
// page leaves it to them.
// Every unused *CyberCut / *FloatingBadge / *Huay / Style file, Faq4,
// ReviewCardSumo, LatestWinnersPremium and AnnouncementPremium stay on disk as
// inventory for the next brand — none of them was deleted, and the previous
// brand's copy and colour still inside them is expected drift, not a bug.
//
// <Announcement /> runs bare on purpose: Announcement3's default message is
// already this brand's copy, written from this brief, and every sub-page calls it
// bare too — so passing an override here is exactly how the ticker ends up saying
// two different things on two pages of the same site.
//
// PALETTE OF THIS BRAND (brand-spec §2). GUCCI168 is a Chinese-new-year THREE
// colour brand — red leads, emerald green is a genuine second hue, gold is the
// metal between them — and this round is a full hue flip off UOK365's gold
// metallic + chrome silver on near-black warm brown (#c8912f #f5d98a #a46b25
// #6d4412 #191005 #19100a #120c07 #070504 #191108 #d8dbe0 #ece1cc and every
// rgba(200,145,47,α) glow). None of that survives on this page or in any
// component it renders. logo.webp is a Chinese God-of-Fortune in a green-and-red
// cap with "GUCCI" in white-silver over "168" in red with a gold outline, both
// slides are a green Chinese arch hung with red lanterns over gold coins and
// red-and-white chips, and bg.json is
// linear-gradient(180deg, #660000, #7a5a00) — oxblood red fading into deep gold.
// So the content cards are near-black warm red (#1d0b08 raised / #140705 mid /
// #090302 deep) with body copy #f6e3cf (= BRAND_TEXT).
// Highlights below are the champagne gold #ffdf91, which §2 pins to exactly this
// job (<strong> highlights and the light end of gradients), unlike the brand red
// #c41115, the emerald #0b7a33 and the brand gold #d9a521 that it pins to
// borders, rules and aura.
//
// IMAGE ROLES FOR THIS DROP (2026-10-08 01:51, brand-spec §5). Two files are
// referenced from this page and only two, and each pairing is read off the
// artwork itself:
//   slide1.png — Chinese-new-year set in front of a green pavilion arch hung with
//     red lanterns, gold coins and red-and-white chips below. The GUCCI168 logo
//     and the God-of-Fortune sit on the LEFT, the model in a red jacket on the
//     RIGHT, and the green plaque under the gold-crowned word โปรโมชั่น reads
//     "คืนยอดเสีย 0.3%" — so it belongs to docx H3 #4. Imported as imgCashback.
//   slide2.png — the same set mirrored: the model in a red dress holding two
//     playing cards on the LEFT, the GUCCI168 logo and the God-of-Fortune on the
//     RIGHT, and the plaque reads "แนะนำเพื่อน 0.8%" — so it belongs to docx H3
//     #5. Imported as imgReferral.
// Both files are 600 px wide (600x250 on disk — the brand spec's "600x600" is a
// typo, but the width it drives the candidates from is right), so 600 is the top
// real candidate — nothing above it would be a real pixel — and each picture
// carries max-w-[600px] so the art is never upscaled past its own bitmap.
// Each slide sits in a ContentBoxSevenThree* image+text block, which is that
// family's hard cap of two per rebrand, so there is no third SevenThree anywhere
// on the site and no slide appears outside those two blocks.
// The two blocks mirror each other: ContentBoxSevenThreePremium lays out
// md:grid-cols-[3fr_7fr] so its picture goes in slot="left" while the paragraph
// keeps the wide column, and ContentBoxSevenThreeNeumorphism lays out
// md:grid-cols-[7fr_3fr] so its picture goes in slot="right". The two pictures
// therefore alternate sides instead of stacking down the same edge, and each
// `sizes` describes its own 3fr column rather than the viewport. Tailwind sets
// box-sizing: border-box globally, so each section's max-w-* caps the box
// INCLUDING its px-4 — which is also where each card's cap breakpoint comes from.
// Both figures are recomputed from the component that owns the column — if a
// padding/gap/cap changes there, these move with it:
//   ContentBoxSevenThreePremium:      max-w-7xl/1280px cap, px-4(32), md:p-10(80),
//                                     gap-10(40), and NO inner padding on the
//                                     image column
//                                     -> (1280 - 32 - 80 - 40) x 0.3
//                                     =  1128 x 0.3 = 338.4 -> 338px
//                                     cap reached at 100vw >= 1280, so below that
//                                     (100vw - 152) x 0.3 = calc(30vw - 46px)
//   ContentBoxSevenThreeNeumorphism:  max-w-[1400px] cap, px-4(32), p-8(64),
//                                     gap-8(32), and the image column adds
//                                     md:pl-8(32)
//                                     -> (1400 - 32 - 64 - 32) x 0.3 - 32
//                                     =  1272 x 0.3 - 32 = 381.6 - 32 = 349.6
//                                     -> 350px
//                                     cap reached at 100vw >= 1400, so below that
//                                     (100vw - 128) x 0.3 - 32 = calc(30vw - 70px)
// Below md both cards collapse to one column at p-8, so the drawn width is
// 100vw - 32 (section px-4) - 64 (card p-8) = calc(100vw - 96px), capped at 600px.
// Neither picture is the LCP element — MainLayout's hero banner is — so both are
// loading="lazy" fetchpriority="low" decoding="async" and neither takes
// fetchpriority="high".
//
// The alt text was written from THIS drop's artwork per brand-spec §5, not
// carried over: the two slides are a red-green-gold Chinese-new-year set, not
// UOK365's near-black gold hall, there is no white-silver suit on either, and the
// logo and the model swap sides between the two files.
//
// Deliberately NOT imported, and every file still on disk:
//   banner2.png (09-28), banner3.png (09-27), slide3.png / slide4.png (09-29) all
//   predate this drop and belong to previous brands — importing any of them emits
//   a competitor's artwork into dist/ (an eager import IS an emit, rendered or
//   not) and turns verify-build red, so there is no inline article illustration
//   this round.
//   banner1.png and banner1-mobile.png belong to MainLayout's own pinned globs and
//   are never referenced from a page. og.png is the same: MainLayout owns it.
// Also deliberately unused: FeatureHighlights.astro (it renders sub-points as <h3>,
// and the brief's heading inventory allows exactly two H3s — sections 4 and 5 — so
// wiring it in would break the count), and the ContentBox3Three* family (no brief
// section on this page is a three-way split; every section is one or two running
// paragraphs).
//
// Vocabulary (brand-spec §4): GUCCI168 is a LIVE CASINO brand — บาคาร่า รูเล็ต
// ไฮโล สล็อต บอล — not a lottery site and not the previous brand's slot-site
// framing. The words this page may use are the brief's own: คาสิโนไลฟ์,
// คาสิโนออนไลน์, บาคาร่า, รูเล็ต, ไฮโล, สล็อต, บอล/แทงบอล, โต๊ะสด, หมวดเกม,
// ไม่มีขั้นต่ำทุกรูปแบบเกม, วงเงิน, Limit, บัญชีเดียว, เครดิต, โปรโมชั่น,
// คืนยอดเสีย 0.3%, แนะนำเพื่อน 0.8%, สมัคร 3 ขั้นตอน, Login, แอดมิน 24 ชั่วโมง,
// PIN, OTP, ประวัติรายการ, ฝากถอน, คู่แข่งขัน, ตลาดเดิมพัน, ฟรีสปิน, ตัวคูณ,
// โบนัส, รอบตัดยอด.
// The previous brands' vocabulary is banned and gone (เบทต่ำ, ทุนน้อย, ค่ายตรง,
// ถูกลิขสิทธิ์, ไฮคลาส, VIP, ส่งตรงจากเว็บแม่, ไม่ผ่านบัญชีม้า), as is every
// lottery word (หวย, โพย, เลขเด็ด, แนวทาง, งวด, อัตราจ่าย, ตรวจหวย) — the page is
// written straight from the brief rather than find-and-replaced over the old
// sentences. Nothing here claims a licence, a regulator, an operator, a bank, a
// game studio, an RTP figure, a deposit minimum, a member count or a founding
// year, because the brief names none. The only figures are the brief's own:
// 0.3%, 0.8%, 24 ชั่วโมง, 3 ขั้นตอน.
// The brief's own hedging ships with the copy ("ไม่มีขั้นต่ำทุกรูปแบบเกม"
// ควรอ้างอิงวงเงินจริงภายในระบบ · "คาสิโนไม่จำกัดยอด" ควรพิจารณาจากวงเงินของโต๊ะ
// และเกมจริง) — it is part of the paragraphs, not trimmed as downbeat filler.
//
// The brief says GUCCI168 throughout and so does every piece of artwork in the
// drop and the operator's prompt — no conflict this round. Even so the brand name
// is never typed on the page: it is interpolated from ${BRAND_NAME} so it can
// never drift from brandProfile. No domain is written out anywhere in this file.
//
// Title and description are the brief's own Title/Description lines (minus that
// substitution), used verbatim and NOT padded up to 150: verify-build deliberately
// skips its 150-character floor on the home page for exactly this reason.
const pageTitle = `${BRAND_NAME} เว็บเล่นคาสิโนไลฟ์24ชม บาคาร่า รูเล็ต ไฮโล สล็อต บอล`;

const pageDescription = `${BRAND_NAME} เว็บเล่นคาสิโนไลฟ์24ชม รวมเกมเดิมพัน บาคาร่า รูเล็ต ไฮโล สล็อต บอล ไม่มีขั้นต่ำทุกรูปแบบเกม เข้าเล่นแบบสดๆ ได้ตลอดเวลา`;

// The brief has a real H2 -> H3 nesting this round, so the page is NOT flattened to
// H2-only. The two H3s are genuine headings — the two bonus sub-points, both nested
// under section 3's โปรโมชั่น H2 — and they stay H3.
//
// The checklist, in document order, and what carries each one:
//    1 H1  GUCCI168 เว็บเล่นคาสิโนไลฟ์24ชม รวมเกมเดิมพันครบวงจร
//          ContentBoxPremium, brief paragraph on line 4
//    2 H2  คาสิโนออนไลน์ GUCCI168 บาคาร่า รูเล็ต ไฮโล สล็อต บอล
//          ไม่มีขั้นต่ำทุกรูปแบบเกม
//          ContentBoxTwoPremium, line 6 left / line 7 right
//    3 H2  โปรโมชั่นเล่น GUCCI168 โบนัสสูงทุกรูปแบบเกม
//          ContentBoxNeumorphism, line 9
//    4 H3  คืนยอดเสีย โบนัส 0.3%
//          ContentBoxSevenThreePremium + slide1 (imgCashback), line 11
//    5 H3  แนะนำเพื่อน โบนัส 0.8%
//          ContentBoxSevenThreeNeumorphism + slide2 (imgReferral), line 13
//    6 H2  สมัครเว็บ GUCCI168 3 ขั้นตอน คาสิโนไม่จำกัดยอด
//          ContentBoxTwoNeumorphism, line 15 left / line 16 right
//    7 H2  ติดต่อแอดมิน GUCCI168 เว็บหลักได้ 24 ชั่วโมง
//          ContentBoxSpecial, lines 18 + 19, plus the LINE / สมัครสมาชิก button
//          row in its `actions` slot
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ GUCCI168
//          Faq2 + faqs prop, lines 21-26
// Final inventory for this page: h1 x1, h2 x5, h3 x2.
//
// Shape rhythm, top to bottom: glass slab with a red spine and a red border ->
// two-column glass plate with a gold border and a red/green column pair ->
// neumorphic raised panel with a centred gradient heading -> 3:7 glass card with a
// green-deep border and the picture on the LEFT -> 7:3 neumorphic panel on the
// deepest surface with the picture on the RIGHT -> two-column neumorphic panel on
// the raised surface -> two half-cards with icon badges and a button row ->
// cut-corner accordion. No shape repeats back to back; the three neumorphic
// panels are separated by surface depth (#140705 / #090302 / #1d0b08) rather than
// by heading colour alone, and each of the eight headings runs a different colour
// sequence so no two cards read as the same card twice.
//
// ContentBoxSevenThreePremium takes the docx heading through `title`, which falls
// back to its wide (7fr) RIGHT text column; its image column is passed no
// `titleleft`, so the block emits exactly one heading. ContentBoxSevenThree-
// Neumorphism is the mirror and takes its heading through `title` too, which falls
// back to the wide LEFT column, with no `titleright` on the picture.
//
// Every brief paragraph ships in full — all eleven of them, nothing merged or
// summarised. Sections 2, 6 and 7 have two paragraphs each and run one per column;
// sections 1, 3, 4 and 5 have one each. The column labels passed to the two
// two-column boxes and to ContentBoxSpecial's icons are this page's own layout
// wording, not brief headings, and every variant renders those labels as <p>.
//
// Everything else on the page is chrome and emits no heading tag at any level:
// Announcement3, LatestWinners3, LoginRtpSection and ReviewCardSumo2 render their
// titles as <p>/<span> with an aria-label on the section, and Faq2's questions
// live inside <summary> as <span>. The non-brief widgets sit before section 1 (the
// ticker, then the winners feed) and after section 8 (LoginRtpSection,
// ReviewCardSumo2, Navfoot) — never spliced between two content sections.

// One array, used by both <Faq> and the FAQPage node — never the component's own
// defaults (Faq2 deliberately ships none, so a forgotten prop renders an empty
// accordion rather than some previous brand's questions). The three pairs are the
// brief's own Q/A block (content.txt lines 21-26), verbatim.
const faqs = [
  {
    q: `${BRAND_NAME} มีคาสิโนไลฟ์อะไรให้เลือกเล่นบ้าง?`,
    a: `${BRAND_NAME} มีเกมคาสิโนตามรายการที่ระบบเปิดให้บริการ เช่น บาคาร่า รูเล็ต และไฮโล รวมถึงเกมสล็อตและแทงบอล สามารถเลือกหลายหมวดผ่านบัญชีเดียว โดยจำนวนโต๊ะและรายการสดอาจเปลี่ยนแปลงตามช่วงเวลา`,
  },
  {
    q: `${BRAND_NAME} คาสิโนออนไลน์เปิดให้เล่นตลอด 24 ชั่วโมงหรือไม่?`,
    a: `เว็บไซต์สามารถเปิดให้เข้าใช้งานได้ตลอดวัน แต่โต๊ะคาสิโนไลฟ์หรือการแข่งขันกีฬาบางรายการอาจมีช่วงเวลาให้บริการแตกต่างกัน ควรตรวจสอบสถานะของโต๊ะหรือรายการจากระบบก่อนเริ่มเดิมพัน`,
  },
  {
    q: `${BRAND_NAME} ไม่มีขั้นต่ำและเดิมพันได้ไม่จำกัดจริงหรือไม่?`,
    a: `ยอดเดิมพันขึ้นอยู่กับเกม โต๊ะ และผู้ให้บริการแต่ละรายการ บาคาร่า รูเล็ต ไฮโล สล็อต และบอลอาจกำหนดขั้นต่ำหรือวงเงินสูงสุดแตกต่างกัน จึงควรยึด Limit ที่แสดงอยู่ในระบบ ${BRAND_NAME} ก่อนยืนยันการเดิมพัน`,
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space that
// splits the word — the copy must read identically with the tags removed.
// One highlight colour only: #ffdf91, the champagne gold, against the inherited
// body colour #f6e3cf (BRAND_TEXT). The paragraphs below carry no colour class of
// their own: every ContentBox* card in this mix already sets
// `text-left text-base leading-relaxed text-[#f6e3cf]` on the element holding the
// slot, so the prose inherits it and no page-level override can drift from the
// card. No paragraph carries mx-auto or max-w-* either — the cards cap their own
// width.

// No breadcrumb: this is the homepage, so a trail from the root to itself would be a
// single self-referential crumb. Every URL in the graph is derived by pageGraph from
// `site:` — no domain is typed out in this file, no URL is built with `+`, and no
// Review / AggregateRating / sameAs / address / email node is passed. `description`
// is the exact same string MainLayout gets.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <LatestWinners />

  <ContentBoxPremium as="h1" title={`${BRAND_NAME} เว็บเล่นคาสิโนไลฟ์24ชม รวมเกมเดิมพันครบวงจร`}>
    <p>
      {BRAND_NAME}
      <strong class="text-[#ffdf91]">เว็บเล่นคาสิโนไลฟ์24ชมที่รวมเกมเดิมพันหลายรูปแบบไว้ในระบบเดียว</strong>
      มีทั้งบาคาร่า รูเล็ต ไฮโล สล็อต และบอล รองรับการเข้าเล่นผ่านมือถือและคอมพิวเตอร์
      <strong class="text-[#ffdf91]">พร้อมเลือกโต๊ะสดหรือหมวดเกมที่สนใจได้จากบัญชีเดียว</strong>
      ระบบจัดหมวดหมู่ชัดเจน ช่วยให้สลับระหว่างคาสิโน สล็อต และกีฬาได้สะดวก ส่วนเกมไลฟ์และการแข่งขันบางรายการจะมีเวลาเปิดให้เดิมพันแตกต่างกัน ควรตรวจสอบสถานะจากระบบก่อนเริ่มทุกครั้ง
    </p>
  </ContentBoxPremium>

  <ContentBoxTwoPremium
    as="h2"
    title={`คาสิโนออนไลน์ ${BRAND_NAME} บาคาร่า รูเล็ต ไฮโล สล็อต บอล ไม่มีขั้นต่ำทุกรูปแบบเกม`}
    titleleft="หมวดเกมที่เปิดให้เลือก"
    titleright="ข้อควรรู้เรื่องวงเงินของแต่ละโต๊ะ">
    <p slot="left">
      เว็บคาสิโน {BRAND_NAME}
      <strong class="text-[#ffdf91]">รวมเกมยอดนิยมหลายแนว บาคาร่าและรูเล็ตมีโต๊ะให้เลือกตามรายการที่เปิดบริการ</strong>
      ไฮโลเน้นรูปแบบการเดิมพันที่เข้าใจง่าย ส่วนสล็อตมีทั้งเกมโบนัส ฟรีสปิน และตัวคูณ ขณะที่แทงบอลสามารถเลือกคู่แข่งขันและตลาดเดิมพันตามช่วงเวลาที่ระบบเปิดรับ
      <strong class="text-[#ffdf91]">ทำให้สมาชิกเลือกเกมได้หลากหลายผ่านบัญชีเดียว</strong>
    </p>
    <p slot="right">
      สำหรับคำว่า
      <strong class="text-[#ffdf91]">ไม่มีขั้นต่ำทุกรูปแบบเกม ควรอ้างอิงวงเงินจริงภายในระบบ</strong>
      เพราะบาคาร่า รูเล็ต ไฮโล สล็อต และบอลสามารถกำหนดยอดเดิมพันขั้นต่ำแตกต่างกันตามโต๊ะ เกม หรือผู้ให้บริการ
      <strong class="text-[#ffdf91]">หากต้องการเริ่มจากยอดต่ำควรตรวจสอบช่วงเดิมพันก่อนยืนยันรายการ</strong>
    </p>
  </ContentBoxTwoPremium>

  <ContentBoxNeumorphism as="h2" title={`โปรโมชั่นเล่น ${BRAND_NAME} โบนัสสูงทุกรูปแบบเกม`}>
    <p>
      โปรโมชั่น {BRAND_NAME}
      <strong class="text-[#ffdf91]">มีสิทธิ์ให้สมาชิกตามแคมเปญที่เปิดในแต่ละช่วง</strong>
