---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxTwo from "../components/ContentBoxTwo.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import Faq from "../components/Faq3.astro";
import LatestWinnersCyber from "../components/LatestWinnersCyber.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// Title and description are the brief's own Title/Description lines, verbatim.
// A brief-supplied description ships at whatever length it was written — it is
// not padded up to the 150-character floor.
const pageTitle = "CREEKBET เกมคาสิโนเว็บแท้ โบนัสจัดเต็ม ฝากถอนออโต้";

const pageDescription = "เข้าเล่น CREEKBET เกมคาสิโนเว็บแท้ อัตราจ่ายสูง แบรนด์ดัง รับโบนัส 0.3% - 0.8% ได้ทุกวัน ไม่มีล็อคยูส สมัครเล่นง่ายๆ บนมือถือได้ 24 ชั่วโมง";

// The ticker copy is passed explicitly rather than relying on the component's
// default — every Announcement* variant's default belongs to whichever brand
// wired it in last. No emoji in this string: an emoji baked into a text prop
// cannot be given its own aria-hidden span.
const announcement =
  "CREEKBET เกมคาสิโนเว็บแท้ รวมบาคาร่า รูเล็ต เสือมังกร คาสิโนสด และสล็อตไว้ในบัญชีเดียว • โบนัสคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8% ตามเงื่อนไขของแต่ละรายการ • ระบบฝากถอนอัตโนมัติ ทำรายการเองได้ตลอด 24 ชั่วโมง • แอดมิน CREEKBET พร้อมตรวจสอบรายการให้ทุกวัน";

// The brief's three registration steps. They are list items in the docx, not
// headings, so they render as an <ol> — turning them into cards with their own
// titles would add an h3 tier the brief does not have.
const steps = [
  "สมัครสมาชิกผ่านหน้าเว็บไซต์และกรอกข้อมูลตามที่ระบบกำหนด",
  "Login เข้าสู่บัญชีและฝากเครดิตผ่านระบบฝากถอนอัตโนมัติ",
  "ตรวจสอบโปรโมชั่น เลือกเกมคาสิโนที่ต้องการ และศึกษากติกาก่อนเริ่มเดิมพัน",
];

// One array, used by both <Faq> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last.
const faqs = [
  {
    q: "CREEKBET มีโปรโมชั่นอะไรให้สมาชิกกดรับ?",
    a: "โปรโมชั่นหลักประกอบด้วยคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8% ตามเงื่อนไขของแต่ละรายการ สมาชิกสามารถ Login เพื่อตรวจสอบยอด สิทธิ์ และรายละเอียดล่าสุดก่อนกดรับโบนัสได้",
  },
  {
    q: "CREEKBET เล่นคาสิโนผ่านมือถือได้หรือไม่?",
    a: "ได้ ระบบรองรับมือถือทั้ง Android และ iOS รวมถึงแท็บเล็ตและคอมพิวเตอร์ สามารถเปิดเว็บไซต์ผ่านเบราว์เซอร์ เข้าสู่บัญชี และเลือกเกมคาสิโนที่รองรับอุปกรณ์นั้นได้โดยตรง",
  },
  {
    q: "หากฝากถอนหรือรับโบนัส CREEKBET ไม่สำเร็จต้องทำอย่างไร?",
    a: "ให้ตรวจสอบสถานะรายการในบัญชีสมาชิกก่อน หากเครดิตยังไม่เข้า รายการถอนค้าง หรือโบนัสไม่แสดง สามารถติดต่อแอดมิน CREEKBET พร้อมแจ้งรายละเอียดของรายการ เพื่อให้ทีมงานช่วยตรวจสอบได้ตลอด 24 ชั่วโมง",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <SmoothCarousel />

  <ContentBoxCyberCut as="h1" title="CREEKBET เกมคาสิโนเว็บแท้ จ่ายโบนัสหนักทุกก้อน กดรับได้ทุกวัน">
    <p class="text-left text-base leading-relaxed text-[#dfe4ea]">
      <strong class="text-[#f4f6f8]">CREEKBET</strong> พร้อมให้บริการสมาชิกที่ต้องการเล่นเกมคาสิโนออนไลน์ผ่านมือถือและคอมพิวเตอร์ มีเกมเดิมพันหลากหลายประเภทให้เลือก พร้อมโปรโมชั่นสำหรับสมาชิกตั้งแต่ 0.3% - 0.8% ตามเงื่อนไขที่กำหนด
      ระบบฝากถอนอัตโนมัติช่วยให้ทำรายการได้สะดวกตลอด 24 ชั่วโมง พร้อมทีมงานคอยดูแลตั้งแต่การสมัคร การรับโบนัส ฝากถอน ไปจนถึงการแก้ไขปัญหาระหว่างใช้งาน
    </p>
  </ContentBoxCyberCut>

  <ContentBoxTwo as="h2" title="เข้าเล่น CREEKBET เว็บพนันคาสิโน อัตราจ่ายสูง แบรนด์แท้ ไม่จำกัดขั้นต่ำ">
    <p slot="left" class="text-left text-base leading-relaxed text-[#dfe4ea]">
      สมาชิกสามารถเข้าเล่นคาสิโน CREEKBET ผ่านระบบที่รองรับทั้งสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ ภายในมีเกมให้เลือกหลายหมวดหมู่ ทั้งบาคาร่า รูเล็ต เสือมังกร คาสิโนสด สล็อต และเกมเดิมพันอื่น ๆ พร้อมจัดหมวดหมู่ให้เลือกใช้งานได้ง่ายผ่านบัญชีเดียว
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#dfe4ea]">
      สำหรับอัตราการจ่าย ยอดเดิมพันขั้นต่ำ และวงเงินของแต่ละเกม อาจแตกต่างกันตามประเภทเกมและผู้ให้บริการ สมาชิกจึงควรตรวจสอบรายละเอียดที่แสดงในระบบก่อนยืนยันการเดิมพันทุกครั้ง
    </p>
  </ContentBoxTwo>

  <ProviderGrid />

  <ContentBoxFloatingBadge as="h2" title="Login CREEKBET รับโบนัส 0.3% - 0.8% ทุกวัน ไม่ล็อคยูส">
    <p class="text-left text-base leading-relaxed text-[#dfe4ea]">
      สมาชิกสามารถ Login CREEKBET เพื่อตรวจสอบโปรโมชั่นและสิทธิ์โบนัสที่เปิดให้รับผ่านบัญชีของตนเอง โดยโปรโมชั่นหลักมีทั้งโบนัสคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8% ซึ่งแต่ละรายการจะมีวิธีคำนวณและเงื่อนไขแตกต่างกัน ควรตรวจสอบรายละเอียดล่าสุดก่อนกดรับสิทธิ์ทุกครั้ง
    </p>
  </ContentBoxFloatingBadge>

  <ContentBoxSevenThree as="h3" titleright="โปรรับโบนัส 0.3%">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600, 800]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นพื้นหลังสีเงินเทาเป็นลายคลื่นแสง มีชิปคาสิโนและลูกเต๋าสีขาวกระจายอยู่ ด้านซ้ายเป็นโลโก้ CREEKBET ตัวอักษรโครเมียมสามมิติ ถัดลงมาเป็นคำว่า โปรโมชั่น คืนยอดเสีย และ รับโบนัส พร้อมตัวเลข 0.3% ขนาดใหญ่สีเงินเงา ด้านขวาเป็นหญิงสาวผมบลอนด์เกล้ามวย สวมชุดคอจีนสีเงินสลับแดง กำลังแบฝ่ามือเปิดไปทางข้อความ"
      class="mx-auto h-auto w-full rounded-2xl border border-[#cfd4da]/45 shadow-[0_10px_30px_rgba(207,212,218,0.24)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#dfe4ea]">
      สมาชิกที่มียอดเสียตรงตามข้อกำหนดสามารถตรวจสอบสิทธิ์รับโบนัสคืนยอดเสีย 0.3% ตามรอบประจำวันที่กำหนด ระบบจะแสดงยอดที่ใช้คำนวณและโบนัสที่สามารถกดรับได้ โดยควรตรวจสอบประเภทเกมที่เข้าร่วม รอบคำนวณ และเงื่อนไขการถอนให้ครบถ้วน
    </p>
  </ContentBoxSevenThree>

  <ContentBoxSevenThreeCyberCut as="h3" titleright="โปรรับโบนัส 0.8%">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600, 800]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นพื้นหลังสีเงินเทา มีชิปโป๊กเกอร์และลูกเต๋าวางกระจาย มุมบนซ้ายเป็นโลโก้ CREEKBET ตัวอักษรโครเมียมสามมิติ ถัดลงมาเป็นคำว่า โปรโมชั่น บนป้ายสีเข้ม ตามด้วย แนะนำเพื่อน และ รับโบนัส พร้อมตัวเลข 0.8% ขนาดใหญ่สีเงินเงา ด้านขวาเป็นหญิงสาวผมบลอนด์เกล้ามวย สวมเสื้อกล้ามสีเงินสลับแดงที่มีคำว่า CREEKBET อยู่บนอก กำลังชี้นิ้วมาที่ข้อความ"
      class="mx-auto h-auto w-full rounded-2xl border border-[#cfd4da]/45 shadow-[0_10px_30px_rgba(207,212,218,0.24)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#dfe4ea]">
      โปรโมชั่นแนะนำเพื่อนเปิดให้สมาชิกนำลิงก์แนะนำส่วนตัวไปแชร์ เมื่อเพื่อนสมัครและมียอดการใช้งานตรงตามเงื่อนไข สมาชิกสามารถรับโบนัสแนะนำ 0.8% ตามข้อกำหนด พร้อมติดตามข้อมูลการแนะนำและยอดโบนัสผ่านบัญชีของตนเองได้อย่างสะดวก
    </p>
  </ContentBoxSevenThreeCyberCut>

  <ContentBoxTwoNeumorphism as="h2" title="สมัครสมาชิก CREEKBET เล่นบนมือถือได้ทุกเกม">
    <div slot="left" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dfe4ea]">เริ่มต้นใช้งาน CREEKBET ผ่านมือถือได้ง่ายเพียง 3 ขั้นตอน</p>
      <p class="text-left text-base leading-relaxed text-[#dfe4ea]">
        หน้าเว็บไซต์รองรับทั้ง Android, iOS แท็บเล็ต และคอมพิวเตอร์ สามารถเข้าใช้งานผ่านเว็บเบราว์เซอร์ได้โดยตรง ช่วยให้สมาชิกตรวจสอบเครดิต ฝากถอน รับโบนัส และเลือกเกมได้จากอุปกรณ์ที่สะดวก
      </p>
    </div>
    <ol slot="right" class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#dfe4ea]">
      {
        steps.map((step, i) => (
          <li class="flex items-start gap-3 rounded-2xl border border-[#5b636b]/55 bg-[#0a0b0d]/70 p-4">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-[#f4f6f8] via-[#cfd4da] to-[#9aa2ab] text-sm font-black text-[#0a0b0d]">{i + 1}</span>
            <span>{step}</span>
          </li>
        ))
      }
    </ol>
  </ContentBoxTwoNeumorphism>

  <ContentBoxNeumorphism as="h2" title="แอดมิน CREEKBET แก้ไขปัญหาการใช้งานได้ทันที ไม่ต้องรอคิวนาน">
    <p class="text-left text-base leading-relaxed text-[#dfe4ea]">
      หากพบปัญหาเกี่ยวกับการสมัครสมาชิก การ Login เครดิตไม่เข้า ฝากถอนล่าช้า โบนัสไม่แสดง หรือไม่สามารถเข้าเกมได้ สามารถติดต่อแอดมิน CREEKBET ได้ตลอด 24 ชั่วโมง พร้อมแจ้งรายละเอียดและเวลาที่พบปัญหา เพื่อให้ทีมงานตรวจสอบรายการและแนะนำขั้นตอนดำเนินการต่อได้รวดเร็วยิ่งขึ้น
    </p>
  </ContentBoxNeumorphism>

  <Faq title="คำถามที่พบบ่อยเกี่ยวกับ CREEKBET" faqs={faqs} />

  <LatestWinnersCyber />

  <LoginRtpSection />

  <ReviewCardSumo2 />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#f4f6f8] via-[#cfd4da] to-[#9aa2ab] px-4 py-3 text-sm font-black whitespace-nowrap text-[#0a0b0d] shadow-[0_10px_30px_rgba(207,212,218,0.28)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(207,212,218,0.42)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#cfd4da]/50 bg-gradient-to-r from-[#5a0a12] to-[#0a0b0d] px-4 py-3 text-sm font-black whitespace-nowrap text-[#f4f6f8] shadow-[0_10px_30px_rgba(207,212,218,0.16)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#f4f6f8]/70 hover:text-[#cfd4da] hover:shadow-[0_15px_40px_rgba(192,36,52,0.3)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>
  </div>

  <Navfoot />
</MainLayout>
