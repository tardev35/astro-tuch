---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement2.astro";
import LatestWinners from "../components/LatestWinnersCyber.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBox3ThreeNeumorphism from "../components/ContentBox3ThreeNeumorphism.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import Faq from "../components/Faq4.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import { pageGraph } from "../lib/schema";
import promoCashback from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";

// การหมุน variant รอบนี้ตัดสินไว้แล้วใน .claude/brand-spec-zane96.md §3 —
// **ห้ามเลือกใหม่ที่นี่** แบรนด์ขาออก (MEXICANOSLOT) ถูกหมุนออกจากทุกตระกูลพร้อมกัน:
// Announcement2 แทน Announcement5 · LatestWinnersCyber แทน LatestWinners4 ·
// Faq4 แทน Faq3 · และ shape-mix ของ ContentBox ทิ้งชุด Premium/CyberCut ของรอบก่อน
// ทั้งชุด ไปใช้ **Neumorphism + ตัวฐาน + SevenThree ตัวฐาน + Special** แทน
// ไม่ทับไฟล์เดิมแม้แต่ตัวเดียว (ไฟล์ที่ไม่ได้ใช้คือ inventory ของแบรนด์ถัดไป)
// Navbar/Footer อยู่ที่ MainLayout (NavbarStyle2 -> NavbarStyle6,
// FooterPremiumSumo -> FooterCyber) ไม่ใช่ที่ไฟล์นี้
// ❌ **รอบนี้ไม่ใช้ *FloatingBadge สักตัว** (badge ยัง whitespace-nowrap และ H1
// รอบนี้ยาว 51 ตัวอักษร จะล้น viewport มือถือ) · **ไม่ใช้ FeatureHighlights**
// (มัน render แต่ละข้อเป็น <h3> จะทำให้ h3 เกินเป้า) · **ไม่ใช้ SmoothCarousel**
// (มัน render slide* นอก SevenThree = ผิดกฎแข็งของ playbook) · **ไม่ใช้ BankStrip
// ที่ไหนทั้งสิ้น** (บรีฟรอบนี้ไม่มีธนาคาร/วอลเลท/ฝากถอนเลยแม้แต่คำเดียว)
// `ContentBox` ตัวฐานกับ `ReviewCardSumo2` คงตัวเดิมตาม §3 (ตัวแรกเป็น shared chrome
// ที่หน้าถาวรอีกสิบหน้าใช้อยู่แล้วไม่ว่า index จะเลือกอะไร ตัวหลัง sibling เก่า
// ไม่มี aria-label บน <section> = บิลด์แดง)
//
// ⚠️⚠️ รอบนี้ **เนื้อหายังเป็นธีมสว่างและโครมยังเข้มเหมือนรอบก่อน แต่ฮิวคนละ
// ตระกูลสิ้นเชิง** พาเลต (brand-spec §2 ล็อกค่าไว้ ห้ามเดาเพิ่ม): พื้นเพจ #f8e6f9
// ไลแลคอมชมพูจาง (bg.json) · การ์ด #ffffff · ผิวยก #f6edfe · wash #ece0fb ·
// เส้น #dcc6f4 / #9a6fd0 · หมึก #241046 (= BRAND_TEXT) · หมึกรอง #6b4a86 ·
// **หัวข้อ + ไฮไลต์ #5411c4** · ฮิวนำ #7a1bd6 · ฟ้าอิเล็กทริก #2b3fd9 ·
// แมเจนต้า #c2178b · ปุ่มไล่ #5411c4 -> #8e14b8 -> #c2178b บนหมึกขาว
// 🚨🚨 **#f23bb4 บนพื้นขาวได้แค่ 3.5:1 · #bb6dff 3.1:1 · #7aa7ff ก็ตก → สามค่านี้
// ห้ามเป็นสีตัวอักษรบนผิวสว่างเด็ดขาด** และ **ขาวบนสามค่านั้นก็ตก AA** พื้นที่รับ
// หมึกขาวต้องเป็น #c2178b (5.6:1) ลงไปหาเข้ม
// ⚠️ #dcc6f4 #9a6fd0 #f23bb4 #bb6dff #7aa7ff #ece0fb #f6edfe #f8e6f9 **ห้ามถือ
// ตัวอักษรบนผิวสว่าง** (เส้น/พื้นถม/ออราเท่านั้น) · #f23bb4 #bb6dff #7aa7ff
// เป็นไฮไลต์ของ "ผิวโครมเข้ม" ห้ามหลุดมาถือตัวอักษรบนการ์ดขาว
// `<strong>` ทุกตัวในไฟล์นี้จึงเป็น **#5411c4 ค่าเดียว** (9.3:1 บนขาว ·
// ~9:1 บนผิวยก #f6edfe) ไม่ใช่ #7a1bd6 และไม่ใช่ #f23bb4
// ⚠️⚠️ **อาร์ตเวิร์กรอบนี้ไล่ฟ้า → ม่วง → แมเจนต้า ซึ่งคร่อมฮิวนำของแบรนด์ก่อนๆ
// สามเจ้าพร้อมกัน** (ฟ้า = โบ๊ะบ๊ะ168 · ชมพู/แมเจนต้า = okkub88 · ม่วง = KMD88)
// **"เจอฟ้า/ชมพู/ม่วง ≠ เป็นของรอบนี้" ต้องเทียบด้วยค่าให้ตรงหกหลัก**:
// 7505cc b453ff c07cff d9b8ff 3a0565 (KMD88 — **7505cc ↔ #7a1bd6 และ b453ff ↔
// #bb6dff ใกล้ที่สุดในลิสต์ทั้งหมด**) · 7e22ce d946ef a855f7 (CEO66) ·
// ffd6fa fff4fb ffe3f5 ffe9f7 f9b2d9 f479b9 6a0f3c 95486b 9c0f55 fb439b fc74b5
// ffc2e2 d91a73 b01160 85094a (okkub88 — **d91a73 ↔ #c2178b · fb439b ↔ #f23bb4**) ·
// 00bfff 12b4ef b6e3f0 7fcbe8 4fb8ea 06283f 0f5684 1a6ea8 (โบ๊ะบ๊ะ168) ·
// 1d4fd8 143aa0 1fd8f0 (นาซ่า168 — **1d4fd8 ↔ #2b3fd9**) · 60a5fa 00f3ff e0ffff
// (ค่า default ของ variant cyber-neon — **60a5fa ↔ #7aa7ff**) · และแดง/ทอง/ครีม
// ของ **MEXICANOSLOT แบรนด์ขาออก เสี่ยงหลงเหลือสูงสุด** ที่เคยอยู่ทั้งไฟล์นี้:
// de2b1e f2a033 a81410 c81e12 9d140c 6f0e08 3f130d 80453a 2b100a 431a10 1d0a06
// 8c3a22 fdeee2 e8c6ae fed7b5 fec28d f6c4a4 e2855c fde4d3 fff3ea fef6fb 117a41
// 2bb061 f2543f — ออกครบทุกค่าแล้ว
// ⚠️ **รอบนี้ไม่มีแดง ไม่มีทอง/เหลือง ไม่มีส้ม ไม่มีเขียวแบรนด์ ไม่มีครีม/เบจ
// และไม่มีแรมป์เทาเงินสักเฉด**
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep สะดุดที่คอมเมนต์นี้)
//
// ย่อหน้าในไฟล์นี้ไม่ถือคลาสสีหรือขนาดของตัวเอง — ทุก ContentBox* ในมิกซ์นี้ตั้ง
// `text-left text-base leading-relaxed` + หมึก #241046 ไว้บน element ที่ถือ slot
// อยู่แล้ว และไม่มี `<p>` ไหนมี mx-auto / max-w-* (การ์ดคุมความกว้างเองแล้ว)
// ข้อยกเว้นเดียวคือ **ป้าย "ขั้นตอนที่ 1/2/3" ใน §6** ซึ่งเป็นป้าย ไม่ใช่เนื้อความ
// จึงถือ font-bold + สีหัวข้อได้ และต้องเป็น <p> **ห้ามเป็น heading ทุกระดับ**
//
// ⚠️ **ชื่อแบรนด์รอบนี้เป็นตัวละตินพิมพ์ใหญ่ + เลข ติดกัน ไม่มีเว้นวรรค** แต่ยัง
// interpolate จาก `${BRAND_NAME}` ทุกจุดรวมถึงใน alt ของสองสไลด์
// **ห้ามพิมพ์ชื่อแบรนด์เป็นตัวอักษรตรงๆ ที่ไหนเลย** ไม่มีโดเมนเขียนไว้ที่ไหน
// และไม่มี URL ที่ต่อด้วย `+`
//
// <strong> ทุกตัวคร่อม "ก้อนที่คั่นด้วยช่องว่าง" ทั้งก้อน เพราะภาษาไทยไม่มีช่องว่าง
// ระหว่างคำ — ไฮไลต์ที่เริ่มหรือจบกลางคำจะถูก formatter ตัดบรรทัดในแท็กแล้วแทรก
// ช่องว่างกลางคำ อ่านคอปปี้โดยถอดแท็กออกต้องได้ข้อความของบรีฟเป๊ะ และไม่มี <strong>
// สองตัวติดกันโดยไม่มีข้อความธรรมดาคั่น
//
// บรีฟรอบนี้ **โฆษณาและกำกับในประโยคเดียวกัน** (brand-spec §5): หัวข้อของบรีฟเอง
// เขียนว่า สล็อตลิขสิทธิ์แท้ในไทย / เว็บตรงไม่ผ่านเอเย่นต์ / ยูสใหม่เล่นง่าย
// ไม่มีขั้นต่ำ 1 บาทก็เล่นได้ ขณะที่ย่อหน้าของบรีฟเองตอบกลับว่า คำกล่าวอ้าง
// เกี่ยวกับลิขสิทธิ์เกมและการเป็นเว็บตรงไม่ผ่านเอเย่นต์ ควรตรวจสอบข้อมูลบริษัทและ
// หลักฐานการได้รับอนุญาตจากแหล่งที่เชื่อถือได้ · ควรศึกษาค่า RTP และความผันผวนของ
// เกม เพื่อทำความเข้าใจความเสี่ยงโดยไม่คาดหวังผลรางวัลที่แน่นอน · เครดิตคืนยอดเสีย
// ไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพัน · แม้จะมีข้อความว่าไม่จำกัด
// แต่ควรยืนยันจำนวนบัญชีที่เข้าร่วมได้ · ควรตรวจสอบเวลาการให้บริการจริงจากประกาศ
// ล่าสุดอีกครั้ง — **ship ทั้งสองครึ่งตรงตามที่บรีฟเขียน ไม่ขยายคำโฆษณาเป็น
// คำกล่าวอ้างใหม่ และทุกประโยคกำกับ ship ครบ ไม่ตัดเพราะฟังดูลบ**
// ตัวเลขบนหน้านี้มีแค่ของบรีฟเอง: **1 บาท · 0.3% · 0.8% · 3 ขั้นตอน · 24ชม.**
// ไม่มีค่า RTP เป็นตัวเลข (บรีฟพูดถึง RTP เป็นแนวคิดเท่านั้น) ไม่มีจำนวนเกม/ค่าย
// ไม่มีปีก่อตั้ง ไม่มีจำนวนสมาชิก ไม่มี 100% และไม่มี 30 วินาที
// 🚨🚨 **บรีฟรอบนี้ไม่พูดถึงธนาคาร วอลเลท หรือการฝากถอนเป็นหมวดเลย** — หน้านี้จึง
// **ไม่มีหัวข้อ/ย่อหน้าเรื่องฝากถอน** (คำว่า "ข้อจำกัดการถอนเงิน" / "การถอนเงิน"
// ที่ปรากฏใน §3 และ §4 เป็นประโยคกำกับของบรีฟเองตรงตัว ไม่ใช่หมวดที่เขียนขึ้นเอง)
// และ **"ทรูวอลเลท" / "ทรูมันนี่" เป็นคำของแบรนด์ก่อนๆ ห้ามเขียนกลับเข้ามา** ·
// คำของ MEXICANOSLOT ที่ห้าม: สล็อตเมกซิกัน · เมกซิกัน · เม็กซิโก · สดส่งตรงจาก
// เมกซิกัน · การันตีเว็บตรง · ยอดเข้าบริษัทแน่นอน · เว็บแท้ที่นี่ที่เดียว ·
// อัปเดตใหม่ตลอดสัปดาห์ (รอบนี้บรีฟเขียน "ทุกสัปดาห์") · สมัครด้วยตัวเอง 3 ขั้นตอน
// (รอบนี้บรีฟเขียน "ด้วยมือถือ") · คำของ okkub88: เว็บสล็อตเงินดี · ทางเข้าเล่นง่าย
// · ยูสใหม่แตกไว · รับโปรไม่อั้น · โบนัสแจกทั้งวันไม่จำกัด · ฝากถอนไม่มีขั้นต่ำ ·
// คำของ โบ๊ะบ๊ะ168: เว็บตรงแตกง่าย · เบทต่ำ · ไม่ทำเทิร์น · รวมค่ายดัง · ถอนได้
// ไม่จำกัด · คำของ หมูบิน168: เกมสล็อตแท้ · เว็บตรงถูกลิขสิทธิ์ · ไม่จำกัดยอด ·
// และไม่มีคำหมวดหวยสักคำ (รอบนี้เป็นเว็บสล็อต /ตรวจหวย /แนวทาง ยังปิดอยู่)
// ⚠️ **"สล็อตคลาสสิก" กับ "เกมโบนัส" รอบนี้ใช้ได้** เพราะอยู่ในบรีฟรอบนี้ตรงตัว
// (content.txt บรรทัด 6) — อย่าสืบทอดข้อห้ามข้ามรอบโดยไม่เปิดบรีฟดู
//
// title/description = บรรทัด 1-2 ของบรีฟตรงตัว (src/assets/content.txt) และตรงกับ
// ค่า default ของ MainLayout อยู่แล้ว — ส่งซ้ำที่นี่เพราะ pageGraph ต้องใช้สตริง
// เดียวกัน **ห้ามต่อเติม** (description = 122 ตัวอักษร ตามที่บรีฟเขียนมาเอง และ
// verify-build ยกเว้นเพดานล่าง 150 ให้หน้าแรกไว้ด้วยเหตุผลนี้โดยเฉพาะ)
const pageTitle = `${BRAND_NAME} สล็อตลิขสิทธิ์แท้ในไทย รวมเกมแบรนด์ดัง ยูสใหม่เล่น1บาทได้`;

const pageDescription = `${BRAND_NAME} สล็อตลิขสิทธิ์แท้ในไทย เว็บตรงไม่ผ่านเอเย่นต์ แหล่งรวมเกมสล็อตแบรนด์ดัง ยูสใหม่เล่นง่ายไม่มีขั้นต่ำ1บาทก็เล่นได้`;

const pageH1 = `${BRAND_NAME} สล็อตลิขสิทธิ์แท้ในไทย เว็บตรงไม่ผ่านเอเย่นต์`;

// บรีฟรอบนี้มีชั้น H1 -> H2 -> H3 จริง จึง **ไม่** แบนเป็น H2 ล้วน
//
// checklist ตามลำดับเอกสาร (brand-spec §4) และตัวที่รับแต่ละข้อ:
//    1 H1  <แบรนด์> สล็อตลิขสิทธิ์แท้ในไทย เว็บตรงไม่ผ่านเอเย่นต์
//          ContentBoxNeumorphism, ย่อหน้าบรรทัด 4
//    2 H2  <แบรนด์> แหล่งรวมเกมสล็อตแบรนด์ดัง ยูสใหม่เล่นง่ายไม่มีขั้นต่ำ 1 บาทก็เล่นได้
//          ContentBoxTwoNeumorphism, บรรทัด 6 แบ่งสองซีกโดยไม่ตกประโยคไหน
//    3 H2  โปรโมชั่น <แบรนด์> อัปเดตใหม่ทุกสัปดาห์
//          ContentBox (ตัวฐาน — จังหวะคั่นกลางชุด Neumorphism โดยตั้งใจ), บรรทัด 8
//    4 H3  โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสทุกวัน
//          ContentBoxSevenThreeNeumorphism + slide1, บรรทัด 10 ซ้าย / ภาพขวา
//    5 H3  โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด
//          ContentBoxSevenThree (ตัวฐาน) + slide2, บรรทัด 12 ซ้าย / ภาพขวา
//    6 H2  วิธีการสมัคร <แบรนด์> ด้วยมือถือ 3 ขั้นตอน
//          ContentBox3ThreeNeumorphism, บรรทัด 14 เป็น intro + บรรทัด 15-20 สามคอลัมน์
//    7 H2  <แบรนด์> มีแอดมินออนไลน์ตลอด 24ชม.
//          ContentBoxSpecial, บรรทัด 22 แบ่งสองซีกโดยไม่ตกประโยคไหน
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ <แบรนด์>
//          Faq4 + prop faqs ชัดเจน, บรรทัด 24-29
// inventory ที่ต้องได้: **h1 ×1 · h2 ×5 · h3 ×2** — ตรงเป้าของ brand-spec §4
//
// ⚠️ จุดที่ชั้น heading รั่วได้ และกันไว้แล้วทุกจุด: บรรทัด 15/17/19 ของบรีฟ
// (ขั้นตอนที่ 1/2/3) **ไม่มี prefix H** จึง render เป็น <p class="font-bold">
// ในสล็อตของตัวเอง ไม่ใช่ป้ายคอลัมน์และไม่ใช่ heading (ContentBox3ThreeNeumorphism
// render ป้ายคอลัมน์ผ่าน LabelTag ซึ่ง default เป็น heading — หน้านี้จึง **ไม่ส่ง
// titleleft/titlecenter/titleright เลย**) · ContentBoxTwoNeumorphism กับ
// ContentBoxSpecial ก็ไม่ส่งป้ายคอลัมน์ เพราะบรีฟไม่ได้ตั้งชื่อให้สองซีก ·
// **ไม่ส่ง titleright ให้ SevenThree ทั้งสองบล็อก** คอลัมน์ภาพจึงไม่มี heading ·
// คำถามใน Faq4 เป็น <span> ใน <summary> ไม่ใช่ heading และหัวข้อของมันมาจาก prop
// grep `<h[1-6]` ในทุก component ที่ไฟล์นี้กับ MainLayout เรียกแล้วรอบนี้ — ไม่มี
// ตัวไหน hardcode heading ไว้เลย ทุกแท็ก heading บนหน้ามาจาก prop คือมาจากบรีฟ
//
// ทั้ง ContentBoxSevenThree* วาง md:grid-cols-[7fr_3fr] โดยให้ **คอลัมน์ข้อความ
// มาก่อน** ภาพจึงไปอยู่ slot="right" ทุกครั้ง: heading ลงบนเนื้อความไม่ใช่บนภาพ
// และบนมือถือคอลัมน์เดียวอ่านลำดับ หัวข้อ -> ข้อความ -> ภาพ ไม่ใช่เปิดด้วยรูป
// สองบล็อกนี้คือ **เพดาน 2 บล็อกของตระกูล SevenThree พอดี** และ **สไลด์ขึ้นได้
// เฉพาะในสองบล็อกนี้เท่านั้น**
// การจับคู่สไลด์อ่านจากตัวอักษรบนภาพเอง (เปิดรูปอ่านใหม่รอบนี้แล้ว): **slide1
// พิมพ์ โปรโมชั่น + คืนยอดเสีย + 0.3% -> §4** · **slide2 พิมพ์ โปรโมชั่น +
// แนะนำเพื่อน + 0.8% -> §5** (ทั้งสองใบปิดท้ายด้วยแคปซูลม่วงเข้มขอบนีออน
// แจกโบนัสทั้งวัน ขนาบด้วยกล่องของขวัญ)
// ⚠️ **เลขในชื่อไฟล์ไม่มีความหมายข้ามแบรนด์** uploader เขียนทับทุกดรอป —
// รอบนี้การจับคู่ **สลับทิศจากรอบก่อน** (รอบก่อน slide2 = คืนยอดเสีย)
// ⛔ **slide3.png / slide4.png (2026-09-29) และ banner2.png / banner3.png
// (2026-10-23) เป็นอาร์ตเวิร์กของแบรนด์อื่น ห้าม import เด็ดขาด** เพราะ eager
// import = emit ขึ้น dist ทุก build แม้ไม่มีหน้าไหน render — **รอบนี้จึงไม่มี
// "รูปประกอบบทความ" (banner2+) เลย** และนั่นถูกต้องตาม playbook
// ⚠️ **banner1 / banner1-mobile / og.png เป็นของ MainLayout** (glob ปักชื่อไว้แล้ว)
// ห้าม import ที่ไฟล์นี้ · ไม่มีภาพไหนบนหน้านี้เป็น LCP จึง **ไม่มี
// loading="eager" / fetchpriority="high"** สักใบ สไลด์ทั้งสองอยู่ใต้ fold
// ⚠️ `widths`/`sizes` ของสองบล็อกนี้ **ต่างกันจริง** เพราะเรขาคณิตของการ์ดต่างกัน
// (§4 แคป max-w-[1400px] · p-8/md:p-10 · gap-8 · คอลัมน์ภาพจ่าย md:border-l +
// md:pl-8 -> 343px / calc(30vw - 77px) ส่วน §5 แคป max-w-7xl · p-8/md:p-10 ·
// gap-10 · คอลัมน์ภาพจ่าย md:pl-6 ล้วน -> 314px / calc(30vw - 70px))
// ที่มาของตัวเลขเขียนไว้ใน frontmatter ของแต่ละ component **ห้ามลอกข้ามไฟล์** ·
// บิตแมปจริงของสไลด์ทั้งคู่คือ **375x600** เพดาน candidate จึงเป็น 375 ห้าม upscale
//
// ที่เหลือบนหน้าเป็น chrome และไม่ออกแท็ก heading ที่ระดับไหนเลย: Announcement2,
// LatestWinnersCyber และ ReviewCardSumo2 ขึ้นชื่อหัวข้อเป็น <p>/<span> พร้อม
// aria-label บน <section> · ticker วางก่อน §1 ส่วนฟีดรายการกับการ์ดรีวิว/Navfoot
// วาง **หลัง §8 ทั้งหมด** เพื่อไม่ให้วิดเจ็ตคั่นกลางสองหัวข้อ docx ตาม playbook
//
// <Announcement /> เรียกเปล่าโดยตั้งใจ: orchestrator ตั้ง default message ของ
// Announcement2 เป็นคอปปี้ของแบรนด์นี้ไว้แล้วใน P1 และหน้าย่อยก็เรียกเปล่า
// เหมือนกัน — ticker จึงตรงกันทั้งเว็บจากแหล่งเดียว

// อาร์เรย์เดียว ใช้ทั้งกับ <Faq> และโน้ด FAQPage — ไม่ใช้ default ของ component
// (Faq4 ตั้งใจ ship เป็นลิสต์ว่าง prop ที่ลืมส่งจึงได้ accordion เปล่า ไม่ใช่
// คำถามของแบรนด์ก่อน) สามคู่นี้คือบล็อก Q/A ของบรีฟเอง (content.txt บรรทัด 24-29)
// ตรงตัว ตัดเฉพาะหมายเลข "1." "2." "3." ออกเพราะ accordion เป็นตัวลิสต์อยู่แล้ว
// ทุกคำตอบคงประโยคกำกับของบรีฟไว้ครบ — เป็นเนื้อหาของบรีฟทั้งสองครึ่ง
const faqs = [
  {
    q: `${BRAND_NAME} มีเกมสล็อตเดิมพันเริ่มต้น 1 บาทหรือไม่?`,
    a: `ตามข้อมูลที่ระบุ ${BRAND_NAME} มีเกมสล็อตที่เริ่มต้นเดิมพันได้ตั้งแต่ 1 บาท แต่ควรตรวจสอบยอดเดิมพันขั้นต่ำของแต่ละเกม เพราะบางรายการอาจกำหนดวงเงินแตกต่างกัน`,
  },
  {
    q: `${BRAND_NAME} มีโปรโมชั่นคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% หรือไม่?`,
    a: `ตามข้อมูลที่ระบุ มีโปรโมชั่นทั้งสองรายการ โดยควรตรวจสอบประเภทเกมที่เข้าร่วม รอบคำนวณยอด และเงื่อนไขการรับเครดิตจากประกาศล่าสุดก่อนใช้สิทธิ์`,
  },
  {
    q: `สามารถสมัครสมาชิก ${BRAND_NAME} ผ่านมือถือได้หรือไม่?`,
    a: `เว็บไซต์ระบุว่ารองรับการสมัครสมาชิกผ่านมือถือ โดยควรตรวจสอบที่อยู่เว็บไซต์ ขั้นตอนยืนยันบัญชี และข้อกำหนดการใช้บริการก่อนลงทะเบียน`,
  },
];

// ไม่มี breadcrumb: นี่คือหน้าแรก เส้นทางจาก root มาหาตัวเองจะเหลือครั้งเดียวที่ชี้ตัวเอง
// ทุก URL ในกราฟมาจาก pageGraph ที่ derive จาก site: — ไม่มีโดเมนพิมพ์ไว้ในไฟล์นี้
// ไม่มี URL ที่ต่อด้วย `+` และไม่ส่งโน้ด Review / AggregateRating / sameAs /
// address / email เข้าไปเลย
// `description` เป็นสตริงเดียวกับที่ MainLayout ได้รับ `name` เป็น H1 ของหน้า และ
// `faqs` เป็นอาร์เรย์ตัวเดียวกับที่ <Faq> ได้รับ
const graph = pageGraph(Astro, {
  name: pageH1,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxNeumorphism as="h1" title={pageH1}>
    <p>
      {BRAND_NAME} นำเสนอเกมสล็อตออนไลน์จากค่ายเกมหลากหลายแบรนด์
      <strong class="text-[#5411c4]">พร้อมระบบสมาชิกที่ออกแบบให้ใช้งานผ่านมือถือได้สะดวก</strong>
      ภายในเว็บไซต์รวบรวมข้อมูลเกมสล็อต โปรโมชั่น และช่องทางติดต่อเจ้าหน้าที่ไว้ในที่เดียว ผู้ใช้งานสามารถศึกษารายละเอียดเกมและเงื่อนไขต่าง ๆ ก่อนใช้งาน
      <strong class="text-[#5411c4]">
        ส่วนคำกล่าวอ้างเกี่ยวกับลิขสิทธิ์เกมและการเป็นเว็บตรงไม่ผ่านเอเย่นต์ ควรตรวจสอบข้อมูลบริษัทและหลักฐานการได้รับอนุญาตจากแหล่งที่เชื่อถือได้
      </strong>
    </p>
  </ContentBoxNeumorphism>

  <ContentBoxTwoNeumorphism as="h2" title={`${BRAND_NAME} แหล่งรวมเกมสล็อตแบรนด์ดัง ยูสใหม่เล่นง่ายไม่มีขั้นต่ำ 1 บาทก็เล่นได้`}>
    <p slot="left">
      {BRAND_NAME} นำเสนอเกมสล็อตจากค่ายต่าง ๆ
      <strong class="text-[#5411c4]">ทั้งสล็อตคลาสสิก เกมที่มีฟีเจอร์ฟรีสปิน และเกมโบนัสที่มีกติกาแตกต่างกัน</strong>
      โดยมีข้อมูลการเดิมพันเริ่มต้น 1 บาทสำหรับบางรายการตามที่ระบุ
    </p>
    <p slot="right">
      สมาชิกใหม่ควรตรวจสอบยอดเดิมพันขั้นต่ำ ตารางจ่ายรางวัล และกติกาของแต่ละเกมก่อนใช้งาน
      <strong class="text-[#5411c4]">เพราะเกมสล็อตแต่ละประเภทอาจกำหนดวงเงินเดิมพันไม่เท่ากัน</strong>
      นอกจากนี้ควรศึกษาค่า RTP และความผันผวนของเกม
      <strong class="text-[#5411c4]">เพื่อทำความเข้าใจความเสี่ยงโดยไม่คาดหวังผลรางวัลที่แน่นอน</strong>
    </p>
  </ContentBoxTwoNeumorphism>

  <ContentBox as="h2" title={`โปรโมชั่น ${BRAND_NAME} อัปเดตใหม่ทุกสัปดาห์`}>
    <p>
      {BRAND_NAME} นำเสนอข้อมูลโปรโมชั่นสำหรับสมาชิก
      <strong class="text-[#5411c4]">โดยมีรายการคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8% เป็นสิทธิพิเศษหลักที่ระบุไว้</strong>
      ผู้ใช้งานสามารถติดตามรายละเอียดโปรโมชั่นประจำสัปดาห์เพื่อศึกษารอบรับเครดิตและเงื่อนไขการเข้าร่วม ทั้งนี้ แต่ละโปรโมชั่นอาจกำหนดประเภทเกม ยอดที่นำมาคำนวณ และข้อจำกัดการถอนเงินแตกต่างกัน
      <strong class="text-[#5411c4]">จึงควรตรวจสอบประกาศล่าสุดให้ครบถ้วนก่อนรับสิทธิ์</strong>
    </p>
  </ContentBox>

  <ContentBoxSevenThreeNeumorphism as="h3" title="โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสทุกวัน">
    <p slot="left">
      โปรโมชั่นคืนยอดเสีย 0.3% เป็นรายการที่ระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขรายวัน
      <strong class="text-[#5411c4]">
        สมาชิกควรตรวจสอบว่าเกมสล็อตประเภทใดเข้าร่วมรายการ มีรอบสรุปยอดเวลาใด และต้องกดรับเครดิตด้วยตนเองหรือระบบดำเนินการให้อัตโนมัติ
      </strong>
      รวมถึงศึกษาข้อกำหนดการใช้เครดิตและการถอนเงินให้ครบถ้วน เพราะยอดเสียบางรายการอาจไม่เข้าเกณฑ์รับสิทธิ์ ทั้งนี้
      <strong class="text-[#5411c4]">เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งต่อไป</strong>
    </p>
    <Picture
      slot="right"
      src={promoCashback}
      loading="lazy"
      fetchpriority="low"
      widths={[172, 257, 343, 375]}
      sizes="(min-width: 1400px) 343px, (min-width: 768px) calc(30vw - 77px), (min-width: 473px) 375px, calc(100vw - 98px)"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={64}
      alt={`โปสเตอร์โปรโมชั่นของ ${BRAND_NAME} บนฉากสตูดิโอนีออนโทนม่วง-แมเจนต้า มีวงแหวนและลำแสงเรืองแสงเป็นฉากหลัง มุมบนซ้ายเป็นโลโก้ ${BRAND_NAME} ซึ่งเป็นเวิร์ดมาร์กสามมิติผิวโครเมียมไล่จากฟ้าอิเล็กทริกไปม่วงแล้วจบด้วยตัวเลขสีแมเจนต้า ตัดขอบขาวหนา กลางภาพเป็นหญิงสาวผมยาวสีน้ำตาลเข้มดัดลอน สวมชุดเมทัลลิกโฮโลแกรมสีม่วงเงินพร้อมปลอกแขนวาว ยิ้มและขยิบตาข้างหนึ่ง มือหนึ่งชูโทรศัพท์ที่หน้าจอขึ้นโลโก้ ${BRAND_NAME} ส่วนอีกมือกำหมัดดีใจ รอบตัวมีหัวใจเส้นขอบสีม่วง กล่องของขวัญผูกโบว์สีม่วงขนาบทั้งสองข้าง และเหรียญทองลอยกระจาย ครึ่งล่างพิมพ์คำว่า โปรโมชั่น เป็นตัวอักษรสามมิติไล่สีขาว ม่วง และแมเจนต้า ตัดขอบขาวหนา ใต้ลงมาเป็นคำว่า คืนยอดเสีย ตัวอักษรขาวสามมิติบนแถบเข้ม แล้วตามด้วยเลข 0.3% ตัวโตสีชมพูแมเจนต้าตัดขอบขาว ปิดท้ายด้วยแคปซูลพื้นม่วงเข้มขอบนีออนเขียนว่า แจกโบนัสทั้งวัน ขนาบด้วยกล่องของขวัญสองใบ`}
      class="mx-auto h-auto w-full max-w-[375px] rounded-2xl border border-[#dcc6f4] shadow-[0_10px_24px_rgba(84,17,196,0.18)]"
    />
  </ContentBoxSevenThreeNeumorphism>

  <ContentBoxSevenThree as="h3" title="โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด">
    <p slot="left">
      โปรโมชั่นแนะนำเพื่อนโบนัส 0.8% เป็นรายการที่ระบุสิทธิ์สำหรับสมาชิกที่แนะนำผู้ใช้งานรายใหม่
      <strong class="text-[#5411c4]">โดยควรตรวจสอบวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และฐานยอดที่ใช้คำนวณโบนัสให้ชัดเจน</strong>
      แม้จะมีข้อความว่าไม่จำกัด แต่ควรยืนยันจำนวนบัญชีที่เข้าร่วมได้ รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุด
      <strong class="text-[#5411c4]">เพื่อป้องกันความเข้าใจคลาดเคลื่อนเกี่ยวกับจำนวนเครดิตที่มีสิทธิ์ได้รับ</strong>
    </p>
    <Picture
      slot="right"
      src={promoReferral}
      loading="lazy"
      fetchpriority="low"
      widths={[157, 236, 314, 375]}
      sizes="(min-width: 1280px) 314px, (min-width: 768px) calc(30vw - 70px), (min-width: 473px) 375px, calc(100vw - 98px)"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={64}
