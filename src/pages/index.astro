---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBox from "../components/ContentBox.astro";
import Faq2 from "../components/Faq2.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import LatestWinners from "../components/LatestWinnersPremium.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// Title and description are the brief's own Title/Description lines, verbatim.
// A brief-supplied description ships at whatever length it was written — it is
// not padded up to the 150-character floor.
const pageTitle = "JADTEM88 สล็อตเครือยักษ์ใหญ่ ไม่ล็อครางวัล มาตรฐานโลก ปลอดภัยแน่นอน";

const pageDescription =
  "JADTEM88 สล็อตเครือยักษ์ใหญ่ บริการเกมออนไลน์ครบวงจร เซิร์ฟนอก เล่นง่ายปลอดภัย โปรค่ายเกมชั้นนํา ไม่ล็อกรางวัล สมัครรับโบนัสได้ทันที";

// The ticker copy is passed explicitly rather than relying on the component's
// default — every Announcement* variant's default belongs to whichever brand
// wired it in last. No emoji in this string: an emoji baked into a text prop
// cannot be given its own aria-hidden span.
const announcement =
  "JADTEM88 คาสิโนเครือยักษ์ใหญ่ เซิร์ฟนอก ปลอดภัย เชื่อถือได้ • รวมเกมสล็อต บาคาร่า คาสิโนสด รูเล็ต เสือมังกร และแบล็กแจ็กจากหลายค่ายไว้ในบัญชีเดียว • สมัครด้วยตัวเองง่าย ๆ 3 ขั้นตอน พร้อมตรวจสอบโปรโมชั่นสำหรับสมาชิกใหม่ • เลือกเล่นได้ทั้งสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ • แจ้งปัญหาการใช้งานกับแอดมิน JADTEM88 ผ่าน LINE Official ได้ทันที";

// The brief's three registration steps. They are list items in the docx, not
// headings, so they render as an <ol> — turning them into cards with their own
// titles would add an h3 tier the brief does not have.
const steps = [
  "เข้าหน้าสมัครสมาชิก JADTEM88 และกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน",
  "Login เข้าสู่บัญชี ฝากเครดิต และตรวจสอบโปรโมชั่นสำหรับสมาชิกใหม่",
  "เลือกค่ายและเกมที่ต้องการ ศึกษากติกาให้เรียบร้อยก่อนเริ่มเดิมพัน",
];

// One array, used by both <Faq2> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last.
const faqs = [
  {
    q: "JADTEM88 มีเกมอะไรให้เลือกเล่นบ้าง?",
    a: "ภายในระบบมีทั้งเกมสล็อต บาคาร่า คาสิโนสด รูเล็ต เสือมังกร แบล็กแจ็ก และเกมเดิมพันประเภทอื่น ๆ จากหลายค่าย โดยสามารถตรวจสอบรายชื่อเกมที่เปิดให้บริการล่าสุดผ่านหน้าเว็บไซต์ได้โดยตรง",
  },
  {
    q: "สมัคร JADTEM88 ครั้งแรกได้รับโปรโมชั่นทันทีหรือไม่?",
    a: "สมาชิกใหม่สามารถตรวจสอบโปรโมชั่นที่บัญชีมีสิทธิ์รับหลังสมัครได้ โดยโบนัสและเงื่อนไขจะแตกต่างกันตามรายการที่เปิดให้บริการในขณะนั้น ควรตรวจสอบยอดฝาก เงื่อนไข และข้อกำหนดการถอนก่อนกดรับทุกครั้ง",
  },
  {
    q: "หากฝากถอนหรือเข้าเกม JADTEM88 ไม่ได้ต้องทำอย่างไร?",
    a: "ให้ตรวจสอบสถานะรายการและข้อมูลบัญชีก่อน หากยังพบปัญหา สามารถติดต่อแอดมิน JADTEM88 ผ่าน LINE Official พร้อมแจ้งรายละเอียดของรายการ เพื่อให้ทีมงานช่วยตรวจสอบและแนะนำวิธีดำเนินการต่อได้",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <SmoothCarousel />

  <ContentBoxPremium as="h1" title="JADTEM88 คาสิโนเครือยักษ์ใหญ่ เซิร์ฟนอก ปลอดภัย เชื่อถือได้">
    <p class="text-left text-base leading-relaxed text-[#cbd5e1]">
      <strong class="text-[#f1f5f9]">JADTEM88</strong> พร้อมให้บริการสมาชิกที่ต้องการเล่นคาสิโนและเกมสล็อตออนไลน์ผ่านระบบที่รองรับทั้งมือถือและคอมพิวเตอร์ มีเกมจากหลากหลายค่ายให้เลือกในบัญชีเดียว
      พร้อมโปรโมชั่นสำหรับสมาชิกใหม่ ระบบสมัครใช้งานไม่ซับซ้อน และมีแอดมินคอยให้คำแนะนำเกี่ยวกับการสมัคร ฝากถอน โปรโมชั่น และปัญหาการใช้งานผ่าน LINE Official
    </p>
  </ContentBoxPremium>

  <ContentBoxCyberCut as="h2" title="เกมคาสิโน JADTEM88 ไม่ล็อกรางวัล รวมค่ายชั้นนำครบวงจร">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#cbd5e1]">
        JADTEM88 รวบรวมเกมเดิมพันออนไลน์หลากหลายประเภทไว้ภายในระบบเดียว ทั้งเกมสล็อต บาคาร่า คาสิโนสด รูเล็ต เสือมังกร แบล็กแจ็ก และเกมยอดนิยมจากหลายค่าย สมาชิกสามารถเลือกเกมผ่านสมาร์ตโฟน แท็บเล็ต
        และคอมพิวเตอร์ พร้อมตรวจสอบกติกา ฟีเจอร์ อัตราเดิมพัน และรายละเอียดของแต่ละเกมก่อนเริ่มเล่น
      </p>
      <p class="text-left text-base leading-relaxed text-[#cbd5e1]">
        ผลลัพธ์และรางวัลของเกมขึ้นอยู่กับระบบและกติกาของผู้ให้บริการแต่ละราย ไม่มีรูปแบบการเดิมพันใดสามารถรับประกันรางวัลหรือผลกำไรได้ จึงควรกำหนดงบประมาณและศึกษารายละเอียดก่อนเดิมพันทุกครั้ง
      </p>
    </div>
  </ContentBoxCyberCut>

  <ProviderGrid />

  <ContentBoxSevenThreePremium as="h2" title="กดรับโปรโมชั่นได้ทันที เมื่อสมัครเข้าเล่น JADTEM88 ครั้งแรก">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600, 800]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นโทนน้ำเงินกรมท่า พื้นหลังเป็นดวงดาวและลูกโลกเรืองแสง กลางภาพเขียนว่า โปรโมชั่น แนะนำเพื่อน พร้อมตัวเลข 0.8% ขนาดใหญ่สีโครมฟ้า ด้านข้างเป็นหญิงสาวผมบลอนด์สวมชุดกี่เพ้าสีกรมท่าขลิบเงินยื่นมือไปทางข้อความ รอบ ๆ มีชิปคาสิโนสีน้ำเงินและสีดำวางซ้อนกัน ไพ่ และชิปลาย 777"
      class="mx-auto h-auto w-full rounded-2xl border border-[#3b82f6]/45 shadow-[0_10px_30px_rgba(59,130,246,0.24)]"
    />
    <div slot="right" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#cbd5e1]">
        สมาชิกใหม่สามารถตรวจสอบโปรโมชั่น JADTEM88 ที่เปิดให้รับหลังสมัครผ่านหน้าเว็บไซต์ ไม่ว่าจะเป็นโบนัสสมาชิกใหม่ โบนัสยอดฝาก หรือสิทธิพิเศษจากกิจกรรมที่กำลังเปิดให้บริการ
        ระบบจะแสดงรายละเอียดของโปรโมชั่นและสิทธิ์ที่บัญชีสามารถรับได้ เพื่อช่วยให้ตรวจสอบข้อมูลก่อนตัดสินใจกดรับ
      </p>
      <p class="text-left text-base leading-relaxed text-[#cbd5e1]">
        โปรโมชั่นแต่ละรายการอาจกำหนดยอดฝาก ระยะเวลารับสิทธิ์ ยอดเทิร์น หรือเงื่อนไขการถอนแตกต่างกัน แนะนำให้อ่านรายละเอียดให้ครบถ้วนก่อนเข้าร่วมทุกครั้ง
      </p>
    </div>
  </ContentBoxSevenThreePremium>

  <ContentBoxSevenThreeCyberCut as="h2" title="สมัคร JADTEM88 ด้วยตัวเองง่าย ๆ 3 ขั้นตอน">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600, 800]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นโทนน้ำเงินกรมท่าบนพื้นหลังดวงดาว กลางภาพเขียนว่า โปรโมชั่น คืนยอดเสีย พร้อมตัวเลข 0.3% ขนาดใหญ่สีโครมฟ้า ด้านข้างเป็นหญิงสาวผมบลอนด์สวมชุดราตรีสีกรมท่าคาดสายสะพายสีเงิน ถัดไปเป็นตู้สล็อตสีโครมที่หน้าจอขึ้นเลข 777 และมีชิปคาสิโนสีน้ำเงินกระจายอยู่รอบข้อความ"
      class="mx-auto h-auto w-full rounded-2xl border border-[#3b82f6]/45 shadow-[0_10px_30px_rgba(59,130,246,0.24)]"
    />
    <div slot="right" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#cbd5e1]">ผู้ใช้งานใหม่สามารถสมัคร JADTEM88 ผ่านมือถือได้ด้วยตนเอง โดยไม่ต้องติดตั้งโปรแกรมเพิ่มเติม เริ่มต้นง่ายเพียง 3 ขั้นตอน</p>

      <ol class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#cbd5e1]">
        {
          steps.map((step, i) => (
            <li class="flex items-start gap-3 rounded-2xl border border-[#1d4ed8]/60 bg-[#0a142c]/70 p-4">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-[#e2e8f0] via-[#93c5fd] to-[#60a5fa] text-sm font-black text-[#03060f]">{i + 1}</span>
              <span>{step}</span>
            </li>
          ))
        }
      </ol>

      <p class="text-left text-base leading-relaxed text-[#cbd5e1]">
        หลังสมัครเรียบร้อย สามารถจัดการบัญชี ตรวจสอบเครดิต ฝากถอน ติดตามโปรโมชั่น และดูประวัติรายการผ่านระบบสมาชิกได้จากอุปกรณ์ที่สะดวก
      </p>
    </div>
  </ContentBoxSevenThreeCyberCut>

  <ContentBox as="h2" title="แจ้งปัญหาการใช้งานกับแอดมิน JADTEM88 ผ่าน LINE Official ได้ทันที">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#cbd5e1]">
        หากพบปัญหาเกี่ยวกับการสมัครสมาชิก Login ไม่ได้ เครดิตไม่เข้า ฝากถอนล่าช้า โปรโมชั่นไม่แสดง หรือเข้าเกมไม่ได้ สามารถติดต่อแอดมิน JADTEM88 ผ่าน LINE Official ของเว็บไซต์
        พร้อมแจ้งรายละเอียดของปัญหาและเวลาที่ทำรายการ เพื่อให้ทีมงานตรวจสอบข้อมูลและแนะนำขั้นตอนแก้ไขได้ตรงจุด
      </p>
      <p class="text-left text-base leading-relaxed text-[#cbd5e1]">
        สมาชิกยังสามารถสอบถามเกี่ยวกับขั้นตอนการใช้งาน โปรโมชั่นใหม่ หรือรายละเอียดเกมที่เปิดให้บริการ เพื่อช่วยลดความสับสนก่อนทำรายการผ่านระบบด้วยตนเอง
      </p>
    </div>
  </ContentBox>

  <Faq2 title="คำถามที่พบบ่อยเกี่ยวกับ JADTEM88" faqs={faqs} />

  <LoginRtpSection />

  <LatestWinners />

  <ReviewCardSumo2 />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#e2e8f0] via-[#93c5fd] to-[#60a5fa] px-4 py-3 text-sm font-black whitespace-nowrap text-[#03060f] shadow-[0_10px_30px_rgba(59,130,246,0.28)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(59,130,246,0.42)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#cbd5e1]/50 bg-gradient-to-r from-[#132447] to-[#0a142c] px-4 py-3 text-sm font-black whitespace-nowrap text-[#f1f5f9] shadow-[0_10px_30px_rgba(59,130,246,0.16)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#cbd5e1]/80 hover:text-[#f1f5f9] hover:shadow-[0_15px_40px_rgba(203,213,225,0.3)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>
  </div>

  <Navfoot />
</MainLayout>
