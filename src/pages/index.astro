---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import Faq from "../components/Faq.astro";
import LatestWinners from "../components/LatestWinnersPremium.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// slide1 is the คืนยอดเสีย 0.3% poster and slide2 is the แนะนำเพื่อน 0.8% one —
// the docx runs 0.8% first, so slide2 pairs with the earlier section. slide3 and
// slide4 belong to a previous client's drop and are never imported here, and
// there is no banner2+ illustration in this brand's drop.

// Title and description are the brief's own Title/Description lines, used
// verbatim. A brief-supplied description is never padded up to the 150-char
// floor and never topped up from the H1/H2 — this one is 109 characters and
// that is correct.
const pageTitle = "MEPAY77 คาสิโน แตกง่าย เว็บตรง วอลเลท ไม่มีขั้นต่ำ";

const pageDescription = "MEPAY77 คาสิโน แตกง่าย รวมเกมฮิต บาคาร่า สล็อต หวย บอล ครบวงจร เว็บตรงมาแรง ฝากถอนวอลเลท ไม่มีขั้นต่ำ";

// The ticker copy is passed explicitly rather than relying on the component's
// default — every Announcement* variant's default belongs to whichever brand
// wired it in last. No emoji in this string: an emoji baked into a text prop
// cannot be given its own aria-hidden span, and this marquee prints the string
// twice.
const announcement =
  "MEPAY77 คาสิโน แตกง่าย เว็บตรง รวมเกมแท้ทุกค่าย ฝากถอนวอลเลท ไม่มีขั้นต่ำ • รวมเกมฮิตครบวงจร ทั้งบาคาร่าและคาสิโนสด สล็อตออนไลน์หลายค่าย หวยออนไลน์ตามรอบที่เปิดให้บริการ และเดิมพันฟุตบอลตามรายการแข่งขัน • สลับหมวดเกมผ่านบัญชีเดียวได้โดยไม่ต้องสมัครหลายครั้ง ตรวจสอบกติกาและอัตราจ่ายก่อนยืนยันเดิมพัน • โปรโมชั่นแนะนำเพื่อน โบนัส 0.8% และโปรโมชั่นคืนยอดเสีย โบนัส 0.3% ตามเงื่อนไขที่กำหนด • ฝากถอนผ่านวอลเลทหรือธนาคารตามช่องทางที่รองรับ ควรตรวจสอบขั้นต่ำและวงเงินล่าสุดก่อนทำรายการ • ติดต่อแอดมิน MEPAY77 ได้ตลอด 24 ชั่วโมง";

// One array, used by both <Faq> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last.
const faqs = [
  {
    q: "MEPAY77 มีเกมอะไรให้เลือกเล่นบ้าง?",
    a: "MEPAY77 มีเกมหลักทั้งบาคาร่า สล็อตออนไลน์ หวยออนไลน์ และการเดิมพันฟุตบอล รวมถึงเกมประเภทอื่นตามที่ระบบเปิดให้บริการ สมาชิกสามารถเลือกหมวดที่ต้องการและตรวจสอบรายละเอียดของแต่ละเกมก่อนเริ่มเดิมพันได้",
  },
  {
    q: "โปรโมชั่น MEPAY77 โบนัส 0.8% และ 0.3% ต่างกันอย่างไร?",
    a: "โบนัส 0.8% เป็นโปรโมชั่นแนะนำเพื่อนสำหรับรายการที่เข้าเงื่อนไข ส่วนโบนัส 0.3% เป็นโปรโมชั่นคืนยอดเสียตามรอบที่กำหนด ควรตรวจสอบวิธีคำนวณและข้อกำหนดล่าสุดก่อนกดรับโบนัสทุกครั้ง",
  },
  {
    q: "MEPAY77 ฝากถอนผ่านวอลเลทและธนาคารได้หรือไม่?",
    a: "สามารถเลือกใช้วอลเลทและบัญชีธนาคารตามช่องทางที่ระบบเปิดรองรับได้ โดยก่อนทำรายการควรตรวจสอบยอดขั้นต่ำ วงเงิน และรายละเอียดช่องทางล่าสุดจากหน้าฝากถอนของ MEPAY77",
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// Gold marks a claim the brief states outright; brushed silver marks the caveat
// that goes with it, matching the two halves of the wordmark.

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb. Every URL in the graph is derived
// by pageGraph from `site:` — no domain is typed out in this file.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <ContentBoxFloatingBadge as="h1" title="MEPAY77 คาสิโน แตกง่าย เว็บตรง รวมเกมแท้ทุกค่าย">
    <p class="text-left text-base leading-relaxed text-[#f1e5cd]">
      <strong class="text-[#fff6e0]">MEPAY77</strong> ให้บริการเกมคาสิโนออนไลน์หลายหมวดหมู่ผ่านระบบเดียว ทั้งบาคาร่า สล็อต หวย และฟุตบอล รองรับการใช้งานบนมือถือและคอมพิวเตอร์ สมาชิกสามารถเลือกเกม ตรวจสอบโปรโมชั่น
      ฝากถอน และจัดการเครดิตได้สะดวก พร้อมระบบวอลเลทและธนาคารตามช่องทางที่รองรับ
      <strong class="text-[#fdcc5c]">มีโปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไข</strong>
      รวมถึงแอดมินคอยดูแลปัญหาการใช้งานตลอด 24 ชั่วโมง
    </p>
  </ContentBoxFloatingBadge>

  <ContentBoxTwoPremium as="h2" title="MEPAY77 รวมเกมฮิต บาคาร่า สล็อต หวย บอล ครบวงจร">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f1e5cd]">
      <strong class="text-[#fff6e0]">MEPAY77</strong> จัดเกมเดิมพันหลักไว้ให้สมาชิกเลือกได้ตามความสนใจ ไม่ว่าจะเป็นบาคาร่าออนไลน์และคาสิโนสด สล็อตออนไลน์จากหลายค่าย หวยออนไลน์ตามรอบที่เปิดให้บริการ
      รวมถึงการเดิมพันฟุตบอลตามรายการแข่งขัน
      <strong class="text-[#dfe3e8]">สมาชิกสามารถสลับหมวดเกมผ่านบัญชีเดียวได้โดยไม่ต้องสมัครหลายครั้ง</strong>
      พร้อมตรวจสอบกติกา อัตราจ่าย และวงเงินของแต่ละเกมก่อนยืนยันเดิมพัน
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#f1e5cd]">
      เกมสล็อตและเกมคาสิโนมีผลลัพธ์ไม่แน่นอน <strong class="text-[#fdcc5c]">จึงไม่มีเกมใดรับประกันว่า “แตกง่าย” หรือสร้างกำไรได้ทุกครั้ง</strong> ควรเลือกเกมจากกติกา รูปแบบการเดิมพัน และงบประมาณที่เหมาะสมกับตนเอง
    </p>
  </ContentBoxTwoPremium>

  <ProviderGrid />

  <GameRankingBoard />

  <ContentBoxNeumorphism as="h2" title="โปรโมชั่น MEPAY77 สุดพิเศษเฉพาะสมาชิกเท่านั้น">
    <p class="text-left text-base leading-relaxed text-[#f1e5cd]">
      สมาชิกที่มีบัญชี <strong class="text-[#fff6e0]">MEPAY77</strong> สามารถ Login เพื่อตรวจสอบโปรโมชั่นที่เปิดให้รับในแต่ละช่วง โดยมีทั้งกิจกรรมแนะนำเพื่อนและโบนัสคืนยอดเสีย สิทธิ์แต่ละรายการอาจกำหนดยอดที่ใช้คำนวณ
      รอบรับโบนัส ประเภทเกม และเงื่อนไขแตกต่างกัน
      <strong class="text-[#fdcc5c]">จึงควรอ่านรายละเอียดให้ครบก่อนกดรับโปรโมชั่น</strong>
    </p>
  </ContentBoxNeumorphism>

  <LoginRtpSection />

  <ContentBoxSevenThreePremium as="h3" title="โปรโมชั่นแนะนำเพื่อน โบนัส 0.8%">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อน 0.8% ของ MEPAY77 พื้นหลังคาสิโนโทนทองเข้ม ด้านบนกลางภาพเป็นโลโก้ MEPAY77 ตัวอักษร ME กับเลข 77 สีทองและคำว่า PAY สีเงินแปรงขัดคั่นตรงกลาง ถัดลงมาเป็นป้ายคำว่า โปรโมชั่น ตามด้วยข้อความ แนะนำเพื่อน วางเหนือตัวเลข 0.8% ขนาดใหญ่สีขาวขอบทอง ด้านขวาเป็นผู้หญิงสวมชุดสีขาวทองยกมือชี้มาที่ตัวเลข รอบภาพมีกล่องของขวัญ กองเหรียญทอง ไพ่ และวงล้อรูเล็ต ด้านล่างเป็นป้ายวงรีสามอันเขียนว่า ชวนเพื่อนง่าย รับโบนัสทันที กับ รับโบนัส จากยอดเพื่อนเล่น และ มั่นคง ปลอดภัย เชื่อถือได้ 100%"
      class="mx-auto h-auto w-full rounded-2xl border border-[#f2ae35]/40 shadow-[0_10px_30px_rgba(242,174,53,0.25)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f1e5cd]">
      สมาชิกสามารถแชร์ลิงก์แนะนำส่วนตัวให้เพื่อน เมื่อเพื่อนสมัครและมียอดใช้งานตรงตามเงื่อนไข <strong class="text-[#fdcc5c]">ระบบจะคำนวณโบนัสแนะนำเพื่อน 0.8% ตามข้อกำหนด</strong> สามารถตรวจสอบจำนวนเพื่อน ยอดที่เข้าเกณฑ์
      และโบนัสที่ได้รับผ่านบัญชีสมาชิกได้ด้วยตัวเอง
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBoxSevenThree as="h3" title="โปรโมชั่นคืนยอดเสีย โบนัส 0.3%">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นคืนยอดเสีย 0.3% ของ MEPAY77 พื้นหลังคาสิโนโทนทองเข้ม ด้านบนกลางภาพเป็นโลโก้ MEPAY77 ตัวอักษร ME กับเลข 77 สีทองและคำว่า PAY สีเงินแปรงขัดคั่นตรงกลาง ถัดลงมาเป็นป้ายคำว่า โปรโมชั่น ตามด้วยข้อความ คืนยอดเสีย วางเหนือตัวเลข 0.3% ขนาดใหญ่สีขาวขอบทอง ด้านขวาเป็นผู้หญิงสวมชุดสีขาวทองยกมือชี้มาที่ตัวเลข ข้างหลังเป็นวงล้อสล็อตขึ้นเลข 777 และช่อง BAR ด้านซ้ายมีกล่องของขวัญ ไพ่เอซสามใบ และกองเหรียญทอง ด้านล่างเป็นป้ายวงรีสามอันเขียนว่า คืนยอดเสียทุกวัน กดรับได้เอง กับ มั่นคง ปลอดภัย เชื่อถือได้ 100% และ รองรับ วอลเลท ทุกธนาคาร"
      class="mx-auto h-auto w-full rounded-2xl border border-[#dfe3e8]/35 shadow-[0_10px_30px_rgba(223,227,232,0.18)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f1e5cd]">
      <strong class="text-[#dfe3e8]">สมาชิกที่มียอดเสียตรงตามเงื่อนไขสามารถตรวจสอบสิทธิ์รับโบนัสคืนยอดเสีย 0.3%</strong> ตามรอบที่ <strong class="text-[#fff6e0]">MEPAY77</strong> กำหนด โดยระบบจะแสดงยอดที่ใช้คำนวณและจำนวนโบนัสที่สามารถกดรับได้
      ก่อนรับสิทธิ์ควรตรวจสอบประเภทเกม รอบเวลา และข้อกำหนดเกี่ยวกับโบนัสให้เรียบร้อย
    </p>
  </ContentBoxSevenThree>

  <ContentBoxTwoCyberCut as="h2" title="ระบบ MEPAY77 ฝากถอนวอลเลท ไม่มีขั้นต่ำ รองรับทุกธนาคาร">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f1e5cd]">
      <strong class="text-[#fff6e0]">MEPAY77</strong> มีระบบฝากถอนสำหรับช่วยให้สมาชิกจัดการเครดิตผ่านบัญชีของตนเอง สามารถเลือกใช้วอลเลทหรือธนาคารจากช่องทางที่เว็บไซต์เปิดรองรับ
      <strong class="text-[#fdcc5c]">ฝากเครดิต ส่งคำขอถอน และตรวจสอบสถานะรายการผ่านมือถือได้โดยตรง</strong>
      ช่วยลดขั้นตอนและไม่จำเป็นต้องแจ้งรายการกับเจ้าหน้าที่ทุกครั้ง
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#f1e5cd]">
      สำหรับเงื่อนไข ไม่มีขั้นต่ำ และ รองรับทุกธนาคาร <strong class="text-[#dfe3e8]">ควรตรวจสอบข้อมูลล่าสุดในหน้าฝากถอนก่อนทำรายการ</strong> เนื่องจากแต่ละช่องทางอาจมีขั้นต่ำ วงเงินสูงสุด หรือข้อกำหนดแตกต่างกัน
    </p>
  </ContentBoxTwoCyberCut>

  <ContentBoxSpecial as="h2" title="ติดต่อสอบถามแอดมิน MEPAY77 ได้ตลอด 24 ชั่วโมง" iconleft="💳" iconright="💬">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f1e5cd]">
      หากสมาชิกพบปัญหา Login ไม่ได้ ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง เข้าเกมไม่ได้ หรือโปรโมชั่นไม่แสดง สามารถติดต่อแอดมิน <strong class="text-[#fff6e0]">MEPAY77</strong> ได้ตลอด 24 ชั่วโมง พร้อมแจ้งเวลา จำนวนเงิน
      และรายละเอียดรายการ เพื่อช่วยให้เจ้าหน้าที่ตรวจสอบข้อมูลในระบบได้ตรงจุด
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#f1e5cd]">
      สมาชิกใหม่ยังสามารถสอบถามวิธีใช้งาน ขั้นตอนฝากถอน โปรโมชั่น หรือข้อมูลเกี่ยวกับเกมแต่ละหมวดได้ หากเป็นปัญหาด้านธุรกรรมควรเก็บหลักฐานรายการไว้จนกว่าการตรวจสอบจะเสร็จสิ้น
      <strong class="text-[#fdcc5c]">และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น</strong>
    </p>
  </ContentBoxSpecial>

  <Faq title="คำถามที่พบบ่อยเกี่ยวกับ MEPAY77" faqs={faqs} />

  <LatestWinners />

  <ReviewCardSumo2 />

  <Navfoot />
</MainLayout>
