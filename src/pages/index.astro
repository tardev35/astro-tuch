---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import LatestWinners from "../components/LatestWinnersCyber.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import Faq from "../components/Faq3.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import { pageGraph } from "../lib/schema";
import imgReferral from "../assets/slide1.png";
import imgCashback from "../assets/slide2.png";

// VARIANT ROTATION THIS ROUND (TND168 -> KMD88). Every family moves off the
// outgoing pick: Announcement5 replaces AnnouncementPremium, LatestWinnersCyber
// replaces LatestWinners3, Faq3 replaces the base Faq, ReviewCardSumo replaces
// ReviewCardSumo2, and the ContentBox shape-mix leaves Neumorphism /
// TwoCyberCut / SevenThree / SevenThreeFloatingBadge / 3ThreePremium / Premium
// behind for CyberCut / TwoPremium / SevenThreePremium /
// SevenThreeNeumorphism / Special / FloatingBadge. NavbarStyle11 +
// FooterStyle3 are the layout's pair this round (previously NavbarStyle4Black /
// FooterPremiumSumo) and the brand font moves google-sans -> kanit; all three
// are the orchestrator's shared-chrome step, not this page's.
// Plain ContentBox is the one sanctioned carry-over: it is the always-live box
// that terms, privacy, 404 and the button pages render through, so it cannot
// follow a rotation. Section 3 is the single docx section it carries here.
// ContentBoxTwo is also still live but is NOT imported here — it is reached only
// through LoginRtpSection, so an "is it used?" grep has to match the bare
// filename, not "components/ContentBoxTwo.astro".
// Every unused *Premium / *Cyber / *Huay / *FloatingBadge / *Style file, the
// other Faq* and Announcement* siblings, ReviewCardSumo2 and the other
// LatestWinners* stay on disk as inventory for the next brand — none was
// deleted, and the previous brands' dragon gold, hot pink, tiger amber and
// chrome silver still inside them are expected drift, not a bug.
//
// <Announcement /> runs bare on purpose: Announcement5's default message is
// already this brand's copy, set by the orchestrator from this brief, and every
// sub-page calls it bare too — so passing an override here is exactly how the
// ticker ends up saying two different things on two pages of the same site.
//
// PALETTE OF THIS BRAND — TWO REAL HUES: VIOLET LEADS, GOLD IS SECOND, ON PURE
// BLACK. Read off the artwork: the logo is the word KMD in polished 3-D violet
// lettering with a gold-edged bevel, followed by 88 in metallic gold, with a
// broken gold ring circling behind the wordmark. The banner and both slides are
// the same black casino scene lit with violet light ribbons and gold type — a
// silver-haired man and woman in black with violet and gold trim, gold-edged
// aces, a gold crown, violet-and-gold chips, gold dice and gold coins. The page
// background is PURE BLACK (bg.json = {"mode":"color","color":"#000000"}).
// ⚠️ CONSEQUENCE: nothing on this page can sink BELOW the page background. The
// deepest plate that still reads as a plate is #0a0213. The depth ramp is
// #1d0832 raised / #140522 mid / #0a0213 sunken / #000000 page.
// ⚠️ THE TRAP THIS ROUND IS BOTH HUES — gold has shipped in nine of the last
// twelve rounds AND purple has shipped twice recently, so "there is already gold
// or purple in this file" proves nothing at all. Compare by VALUE, never by
// colour family. This brand's primary is #7505cc (R=117 G=5 B=204), which is
// deeper and more saturated than the closest previous values: WEPLAY168's
// #a435f0 (R=164 G=53 B=240) and BPLAY639's #7e22ce (R=126 G=34 B=206). Its gold
// is #e2b33f (R=226 G=179 B=63), not UFA324's #e5a81b and not the outgoing
// TND168 set (#dfa310 #ffc93d #ffe4a3 #c9b88e #f0e9dc #8a5c09 #43240b #140d02
// #1b1307 #120c04 #070502, plus rgba(223,163,16,α) and rgba(255,201,61,α)),
// which is gone from every file this page renders, as are PUNPRO168's,
// TIGERWIN369's, UFA324's, FAH999's, DUCK1688's, NAZA168's and FLASH877's.
// There is NO pink, NO silver/grey/chrome, NO green, NO blue, NO burnt orange
// and NO red anywhere on this page.
// Body copy is #ece2f8 (= BRAND_TEXT), 12.6:1 on the raised surface and 17.8:1
// on the page background. Highlights below are #ffd45e, which the spec pins to
// exactly this one job (11.1:1) — unlike #e2b33f, which is the border/accent/
// heading gold, unlike #ffdf8c, which is the bright end of the heading gradients
// and the hover colour, and unlike #bba8d4, which is muted secondary text.
// #7505cc, #b453ff, #3a0565, #2c0349 and #7a5a0a never carry text at any size;
// the only violets that do are #c07cff (5.3:1) and #d9b8ff (8.6:1). #1a0526 is
// the only ink allowed on a gold or light fill.
//
// IMAGE ROLES FOR THIS DROP (2026-10-13). Two files are referenced from this page
// and only two, and each pairing is read off the artwork itself — the percentage
// printed ON the slide has to match the heading the block carries, or the picture
// contradicts the section above it. ⚠️ NOTE the pairing is the REVERSE of last
// round's: here slide1 is the REFERRAL art and slide2 is the CASHBACK art, which
// is why the import names below are taken from what is printed on each picture
// and never from the file number.
//   slide1.png — square 600x600. The KMD88 wordmark inside a gold ring across the
//     top, the silver-haired couple below it, gold-edged aces, a gold crown,
//     violet-and-gold chips and gold dice around them. Across the middle
//     โปรโมชั่น in huge 3-D gold type under a small gold crown and, on a black
//     gold-edged plate below it, แนะนำเพื่อน โบนัส 0.8%. The artwork prints the
//     offer itself, so it belongs to docx H3 §5. Imported as imgReferral.
//   slide2.png — the companion square. Same wordmark, same couple, same gold
//     crown, gold aces at the left, gold dice at the right and gold coins along
//     the bottom. Across the middle โปรโมชั่น in the same 3-D gold type and, on a
//     black gold-edged plate below it, คืนยอดเสีย 0.3%. It belongs to docx H3 §4.
//     Imported as imgCashback.
// Both slides are 600x600 on disk, so 600 is the top real candidate — nothing
// above it would be a real pixel — and each picture carries max-w-[600px] so the
// art is never upscaled past its own bitmap.
// Each slide sits in a ContentBoxSevenThree* image+text block, which is that
// family's hard cap of two per rebrand, so there is no third SevenThree anywhere
// on the site and no slide appears outside those two blocks.
// Both blocks lay out md:grid-cols-[7fr_3fr] with the TEXT column first, so each
// picture goes in slot="right": the heading always lands on the prose, never on
// the picture, and on a phone the single column reads heading, text, picture
// rather than opening with an image. Each `sizes` therefore describes its own
// 3fr column rather than the viewport, and both were taken from the arithmetic
// block inside the variant that owns them — they are NOT last round's numbers,
// because both variants cap the SECTION at max-w-7xl this round (so the 1280
// breakpoint replaces last round's 1400) and they pay different padding:
// SevenThreePremium pays border + md:p-10 + gap-10 + md:pl-10 + md:border-l,
// while SevenThreeNeumorphism pays border + a flat p-8 + gap-8 + md:pl-8 +
// md:border-l:
//   ContentBoxSevenThreePremium (section 4)      >= 1280px : 297px
//                                                md..1279  : calc(30vw - 87px)
//                                                698..767  : 600px (bitmap cap)
//                                                < 698     : calc(100vw - 98px)
//   ContentBoxSevenThreeNeumorphism (section 5)  >= 1280px : 312px
//                                                md..1279  : calc(30vw - 72px)
//                                                698..767  : 600px (bitmap cap)
//                                                < 698     : calc(100vw - 98px)
// Neither is the LCP element — MainLayout's hero banner is — so both are
// loading="lazy" fetchpriority="low" decoding="async" and neither takes
// fetchpriority="high". formats/fallbackFormat/quality stay at the house values:
// tools/avif-quality-service.mjs rescales AVIF quality on its own, so
// quality={80} must not be hand-tuned per format.
//
// The alt text was written from THIS drop's artwork, not carried over: the set is
// a BLACK scene lit with VIOLET light and GOLD type — a silver-haired couple in
// black, a violet-and-gold wordmark in a broken gold ring, gold-edged aces, a
// gold crown, violet-and-gold chips, gold dice and gold coins. It is NOT
// TND168's gold dragon medallion (no dragon, no roulette wheel), not PUNPRO168's
// pink cartoon set (no pink handheld console, no pink-bobbed girl, no 777
// cabinet, no pink hearts), not TIGERWIN369's tiger medallion, not UFA324's
// night stadium and not LOTTOPLUS's lottery posters.
//
// Deliberately NOT imported, and every file still on disk:
//   banner2.png (10-08) and banner3.png (09-27) are previous brands' article
//   banners, and slide3.png / slide4.png (09-29) are a lottery brand's posters.
//   Importing any of them emits a competitor's picture into dist/ (an eager
//   import IS an emit, rendered or not) and turns verify-build red. There is
//   therefore NO current-drop article illustration this round, and a slide is
//   not substituted for one.
//   banner1.png and banner1-mobile.png belong to MainLayout's own pinned globs
//   and are never referenced from a page. og.png is the same: MainLayout owns it.
// Also deliberately unused (named without the file extension on purpose — the
// playbook's "is this component live?" check is a bare-filename grep, and a
// mention here would read as a render): ProviderGrid and GameRankingBoard have
// nothing to carry because the brief names no game studio and no ranking;
// SmoothCarousel has no brief section asking for a carousel; BankStrip already
// renders inside the active footer; and FeatureHighlights has nothing to carry
// either, because the brief's two H3s are real docx headings with full paragraphs
// under them, not a labelled sub-list — they take their own SevenThree blocks.
//
// Vocabulary: this brand is a MIXED CASINO — a "เว็บลิขสิทธิ์ไทยแท้" running a
// "ระบบเดิมพันออนไลน์ ออโต้ทุกประเภท" that covers บาคาร่า, สล็อต and บอลออนไลน์.
// It is NOT a slot-only site, NOT a sports book and NOT a lottery site. The words
// this page may use are the brief's own: เว็บลิขสิทธิ์ไทยแท้, ระบบเดิมพันออนไลน์,
// ออโต้ทุกประเภท, คาสิโนรวมเกม, บาคาร่า, สล็อต, บอลออนไลน์, แพลตฟอร์มเดียว,
// เมนูจัดการบัญชี, ตรวจสอบเครดิต, เกมไพ่, เกมวงล้อทั่วไป, ฟรีสปิน, ฟีเจอร์โบนัส,
// คู่แข่งขัน, อัตราต่อรอง, ตารางจ่าย, กติกา, ยืนยันรายการ, ยอดเครดิต,
// ประวัติธุรกรรม, คืนยอดเสีย 0.3%, เข้ายูสทุกวัน, รอบประจำวัน, เวลาตัดยอด,
// ยอดที่เข้าเกณฑ์, แนะนำเพื่อน, โบนัส 0.8%, ไม่จำกัด, ลิงก์แนะนำ,
// ฝากถอนเข้าบริษัทเจ้าของโดยตรง, บัญชีบริษัท, นิติบุคคล, ชื่อบัญชีปลายทาง,
// หลักฐานธุรกรรม, แอดมิน 24 ชั่วโมง, PIN, OTP.
// ⚠️ TND168's framing is gone from this page (แบรนด์คาสิโนเซิร์ฟไทย, เล่นได้ทุกค่าย,
// มีโบนัสทุกเกม, คาสิโนไลฟ์สด, เกมถ่ายทอดสดจากโต๊ะจริง, รูเล็ต, ไฮโล, ตารางเปิดโต๊ะ,
// สมัคร 3 ขั้นตอน), as is PUNPRO168's slot-only set (สล็อตปันโปรในตำนาน,
// เว็บเล่นสล็อตออนไลน์, เว็บตรงในตำนาน, ทางเข้าเล่นใหม่ 2026, สล็อตคลาสสิก),
// TIGERWIN369's (เว็บดังของแท้ในตำนาน, เบทต่ำ, ทุนน้อย, ยิงปลา, เสือมังกร), UFA324's
// sports framing (ฐานเกมแท้, จ่ายตรง, ไม่บิดยูส, เว็บตรง) and every older brand's set
// (แตกง่าย, ส่งตรงจากเมกา, ไม่ผ่านเอเย่นต์, การันตีเว็บแท้, จ่ายไว, ค่ายตรง,
// รีวิวถอนจริง, VIP) — the page is written straight from the brief rather than
// find-and-replaced over the old sentences. There is NO หวย / โพย / เลขเด็ด / งวด /
// แนวทาง / ตรวจหวย / 3 ตัว / 2 ตัว anywhere on this site this round: it is a casino
// brand, and /ตรวจหวย and /แนวทาง stay parked in src/pages-disabled/.
// Nothing here claims a licence, a regulator, an operator, a game studio, a bank,
// an RTP figure, a deposit minimum, a member count, a founding year or a server
// location, because the brief names none — it explicitly hedges the
// "เว็บลิขสิทธิ์ไทยแท้" and "ไม่จำกัด" claims rather than asserting them, and that
// hedge ships with the copy. The only figures are the brief's own three: 0.3%,
// 0.8% and 24 ชั่วโมง.
// The brief hedges six separate times (ส่วนการระบุว่าเป็นเว็บลิขสิทธิ์ไทยแท้ควรมี
// ข้อมูลใบอนุญาตและหน่วยงานที่ออกใบอนุญาตให้ตรวจสอบได้ · ไม่มีเกมประเภทใดรับประกัน
// ผลกำไร · ควรตรวจสอบว่าโปรโมชั่นครอบคลุมบาคาร่า สล็อต หรือบอลออนไลน์ประเภทใดบ้าง ·
// หากมีการใช้บัญชีบริษัทเจ้าของโดยตรง ควรแสดงชื่อบริษัทหรือนิติบุคคลที่เกี่ยวข้องให้
// ตรวจสอบได้ · การใช้บัญชีบริษัทไม่ได้รับประกันความปลอดภัยของธุรกรรมทั้งหมด ·
// คำว่าไม่จำกัดควรระบุให้ชัด) and every one of those clauses is part of its
// paragraph, not trimmed as downbeat filler.
//
// The brief, every piece of artwork in the drop and the operator's prompt all
// agree on the brand name — no conflict this round. Even so the name is never
// typed on the page: it is interpolated from ${BRAND_NAME} so it can never drift
// from brandProfile. No domain is written out anywhere here — note the brand name
// and the domain do NOT match this round (brand KMD88 with no hyphen, domain
// kmd88-play.com with a hyphen, a -play tail and a .com TLD), which is exactly
// the kind of thing a hand-typed URL gets wrong.
//
// Title and description are the brief's own Title/Description lines
// (content.txt lines 1-2), used verbatim apart from the brief's own typo
// ลิขสิทธิื, which is spelled ลิขสิทธิ์ here the way the brief's own line 3 spells
// it. They are NOT padded up to 150 characters — verify-build deliberately skips
// its 150-character floor on the home page for exactly this reason. Both strings
// are byte-identical to the defaults the orchestrator set in MainLayout.astro,
// which is what makes passing them here a no-op rather than a second source of
// truth.
const pageTitle = `${BRAND_NAME} เว็บลิขสิทธิ์ไทยแท้ คาสิโนรวมเกม บาคาร่า สล็อต บอล ครบวงจร`;

const pageDescription = `${BRAND_NAME} เว็บลิขสิทธิ์ไทยแท้ เปิดระบบเดิมพันออนไลน์ แบบออโต้ทุกประเภท ฝากถอนเข้าบริษัทเจ้าของโดยตรง คาสิโนรวมเกม บาคาร่า สล็อต บอล ครบวงจร`;

// The brief has a real H2 -> H3 nesting this round, so the page is NOT flattened
// to H2-only. The two H3s are the docx's own H3 lines — the two promotion
// sub-points that sit under section 3's โปรโมชั่น H2 in the brief's own outline.
// There is no FeatureHighlights H3 exception this round.
//
// The checklist, in document order, and what carries each one:
//    1 H1  ${BRAND_NAME} เว็บลิขสิทธิ์ไทยแท้ เปิดระบบเดิมพันออนไลน์ ออโต้ทุกประเภท
//          ContentBoxCyberCut, brief paragraph on line 4
//    2 H2  ${BRAND_NAME} คาสิโนรวมเกม บาคาร่า สล็อต บอล ครบวงจร
//          ContentBoxTwoPremium, line 6 left / line 7 right
//    3 H2  โปรโมชั่นเดิมพัน ${BRAND_NAME} เว็บพนันคาสิโนเซิร์ฟไทย
//          ContentBox (the plain, always-live variant), line 9
//    4 H3  โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสทุกวัน
//          ContentBoxSevenThreePremium + slide2 (imgCashback), line 11
//    5 H3  โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด
//          ContentBoxSevenThreeNeumorphism + slide1 (imgReferral), line 13
//    6 H2  ${BRAND_NAME} ระบบฝากถอนเข้าบริษัทเจ้าของโดยตรง
//          ContentBoxSpecial, line 15 in the left half / line 16 in the right
//    7 H2  แอดมิน ${BRAND_NAME} เปิดบริการ 24 ชั่วโมง
//          ContentBoxFloatingBadge, lines 18 and 19
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ ${BRAND_NAME}
//          Faq3 + faqs prop, lines 21-26
// Final inventory for this page: h1 x1, h2 x5, h3 x2.
//
// SHAPE RHYTHM, top to bottom — no two adjacent sections read as the same card,
// and each neighbour pair differs in at least two of {corner, surface depth,
// heading treatment}:
//   §1 CLIPPED corners (40px) on RAISED #1d0832 with four corner rules crossing
//      gold against violet, heading gradient bright gold -> violet -> brand gold
//      behind a violet spine
//   §2 rounded-3xl on MID #140522 with a violet wash and a gold corner bloom,
//      heading gradient brand gold -> light lilac -> violet, two columns split by
//      a violet marker vs a gold marker
//   §3 rounded-3xl on RAISED #1d0832 with a top hairline and a 20px underline
//      rule, heading gradient bright gold -> brand gold -> bright violet (the
//      always-live box; its treatment is fixed by the orchestrator)
//   §4 rounded-3xl GRADED from RAISED #1d0832 down to SUNKEN #0a0213, heading
//      gradient violet -> bright gold -> brand gold, picture right
//   §5 rounded-[25px] NEUMORPHIC on MID #140522, twin inset/outset shadows and no
//      border glow at all, heading SOLID brand gold — the only solid-gold heading
//      on the page, picture right
//   §6 rounded-3xl GLASS on RAISED #1d0832 whose two halves drop to SUNKEN
//      #0a0213, heading gradient light lilac -> violet -> brand gold, the left
//      half's icon on a solid gold plate against the right half's dark plate
//   §7 rounded-2xl GRADED from RAISED #1d0832 to MID #140522 in a 2px violet
//      frame, heading INVERTED into a floating SOLID GOLD plate carrying #1a0526
//      ink — the opposite polarity of every other heading here
//   §8 rounded accordion rows on SUNKEN #0a0213 inside a deep-violet hairline
//      frame, heading gradient brand gold -> bright gold -> violet, centred
// The two RAISED-surfaced content cards (§1, §3) are separated by §2's mid card
// and differ in corner shape entirely; the two MID-surfaced ones (§2, §5) are
// separated by two sections and differ in corner, shadow treatment and heading;
// and every card's heading gradient runs a different order of the same violet
// and gold ramps, so no two read as one card.
//
// ContentBoxSevenThreePremium and ContentBoxSevenThreeNeumorphism both take the
// docx heading through `title`, which falls back to their wide (7fr) LEFT text
// column; neither is passed a `titleright`, so each block emits exactly one
// heading and the picture column never carries one.
//
// Every brief paragraph ships in full — all eleven of them, nothing merged or
// summarised, plus the three FAQ answers. Sections 2, 6 and 7 have two
// paragraphs each; sections 1, 3, 4 and 5 have one paragraph each. Section 2
// runs one paragraph per column and section 6 one per half, so only section 7's
// single slot receives more than one paragraph — and it wraps them in ONE
// <div class="flex flex-col gap-4"> as the house rule requires, because that slot
// would otherwise put two siblings into a gap-* flex column.
// No column label is passed to ContentBoxTwoPremium this round: the brief gives
// section 2 two running paragraphs with no sub-labels, and inventing a pair here
// would be this page's own wording rather than the docx's.
//
// Everything else on the page is chrome and emits no heading tag at any level:
// Announcement5, LatestWinnersCyber, LoginRtpSection and ReviewCardSumo render
// their titles as <p>/<span> with an aria-label on the section, and Faq3's
// questions live inside <summary> as <p>. The non-brief widgets sit before
// section 1 (the ticker, then the winners feed) and after section 8
// (LoginRtpSection, ReviewCardSumo, Navfoot) — never spliced between two content
// sections.

// One array, used by both <Faq> and the FAQPage node — never the component's own
// defaults (Faq3 deliberately ships an empty list, so a forgotten prop renders an
// empty accordion rather than some previous brand's questions). The three pairs
// are the brief's own Q/A block (content.txt lines 21-26), verbatim.
const faqs = [
  {
    q: `${BRAND_NAME} มีเกมคาสิโนและการเดิมพันประเภทใดบ้าง?`,
    a: `${BRAND_NAME} นำเสนอหมวดเกมบาคาร่า สล็อต และบอลออนไลน์ โดยจำนวนเกมและค่ายที่เปิดให้บริการจริงขึ้นอยู่กับระบบ สมาชิกควรตรวจสอบกติกา ตารางจ่าย และช่วงเดิมพันของแต่ละรายการก่อนเริ่มเล่น`,
  },
  {
    q: `${BRAND_NAME} ฝากถอนเข้าบัญชีบริษัทเจ้าของโดยตรงจริงหรือไม่?`,
    a: `หากเว็บไซต์ระบุว่าใช้บัญชีบริษัทเจ้าของโดยตรง ควรมีชื่อบัญชีและข้อมูลนิติบุคคลที่สามารถตรวจสอบได้ ก่อนทำรายการควรเปรียบเทียบชื่อบัญชีปลายทางกับข้อมูลจากช่องทางหลัก และตรวจสอบเงื่อนไขการฝากถอนให้ครบถ้วน`,
  },
  {
    q: `${BRAND_NAME} มีโปรโมชั่นอะไร และติดต่อแอดมินได้ตอนไหน?`,
    a: `โปรโมชั่นหลักตามข้อมูลที่กำหนดมี คืนยอดเสีย 0.3% และ แนะนำเพื่อน 0.8% โดยแต่ละรายการมีเงื่อนไขแตกต่างกัน ส่วนแอดมินระบุว่าเปิดให้บริการตลอด 24 ชั่วโมง สมาชิกควรตรวจสอบช่องทางติดต่อหลักและเวลาตอบกลับจริงจากหน้าเว็บไซต์`,
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// No two <strong> elements are adjacent either: every pair is separated by at
// least one run of plain text, so the whitespace between them can never collapse
// into a missing space.
// One highlight colour only: #ffd45e, against the inherited body colour #ece2f8
// (BRAND_TEXT). The paragraphs below carry no colour class of their own: every
// ContentBox* card in this mix already sets
// `text-left text-base leading-relaxed text-[#ece2f8]` on the element holding the
// slot, so the prose inherits it and no page-level override can drift from the
// card. No paragraph carries mx-auto or max-w-* either — the cards cap their own
// width, and the only max-w-* on the page is the one capping each slide, which is
// an image and not prose. No slot's copy names a colour.

// No breadcrumb: this is the homepage, so a trail from the root to itself would
// be a single self-referential crumb. Every URL in the graph is derived by
// pageGraph from `site:` — no domain is typed out in this file, no URL is built
// with `+`, and no Review / AggregateRating / sameAs / address / email node is
// passed. `description` is the exact same string MainLayout gets, and `faqs` is
// the exact same array <Faq> gets.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <LatestWinners />

  <ContentBoxCyberCut as="h1" title={`${BRAND_NAME} เว็บลิขสิทธิ์ไทยแท้ เปิดระบบเดิมพันออนไลน์ ออโต้ทุกประเภท`}>
    <p>
      {BRAND_NAME} เว็บคาสิโนออนไลน์ที่นำเสนอระบบเดิมพันออโต้สำหรับผู้สนใจเกมหลายประเภท
      <strong class="text-[#ffd45e]">ทั้งบาคาร่า สล็อต และบอลออนไลน์ รวมหมวดเกมไว้ในแพลตฟอร์มเดียว</strong>
      พร้อมเมนูจัดการบัญชี ตรวจสอบเครดิต และติดตามรายการต่างๆ ผ่านมือถือหรือคอมพิวเตอร์ได้สะดวก ระบบอัตโนมัติช่วยลดขั้นตอนการทำรายการตามรูปแบบที่เว็บไซต์เปิดให้บริการ
      <strong class="text-[#ffd45e]">ส่วนการระบุว่าเป็นเว็บลิขสิทธิ์ไทยแท้ควรมีข้อมูลใบอนุญาตและหน่วยงานที่ออกใบอนุญาตให้ตรวจสอบได้</strong>
    </p>
  </ContentBoxCyberCut>

  <ContentBoxTwoPremium as="h2" title={`${BRAND_NAME} คาสิโนรวมเกม บาคาร่า สล็อต บอล ครบวงจร`}>
    <p slot="left">
      {BRAND_NAME} คาสิโนรวมเกมเดิมพันหลายรูปแบบไว้สำหรับผู้ที่สนใจทั้งเกมคาสิโนและกีฬา
      <strong class="text-[#ffd45e]">โดยบาคาร่าเป็นเกมไพ่ที่มีตัวเลือกการเดิมพันตามกติกา</strong>
      สล็อตมีทั้งเกมวงล้อทั่วไป ฟรีสปิน และฟีเจอร์โบนัส
      <strong class="text-[#ffd45e]">ส่วนบอลออนไลน์มีข้อมูลคู่แข่งขัน ประเภทการเดิมพัน และอัตราต่อรองให้ตรวจสอบก่อนทำรายการ</strong>
      การรวมหมวดเกมไว้ในระบบเดียวช่วยให้ค้นหาประเภทเกมและศึกษารายละเอียดได้สะดวกขึ้น
    </p>
    <p slot="right">
      สำหรับระบบเดิมพันแบบออโต้
      <strong class="text-[#ffd45e]">สมาชิกควรตรวจสอบขั้นตอนยืนยันรายการ การแสดงยอดเครดิต และประวัติธุรกรรมให้ครบถ้วน</strong>
      รวมถึงศึกษาตารางจ่ายและเงื่อนไขของแต่ละเกม เพราะบาคาร่า สล็อต และการเดิมพันฟุตบอลมีวิธีตัดสินผลแตกต่างกัน
      <strong class="text-[#ffd45e]">ไม่มีเกมประเภทใดรับประกันผลกำไร และการเดิมพันทุกประเภทมีความเสี่ยงต่อการสูญเสียเงิน</strong>
    </p>
  </ContentBoxTwoPremium>

  <ContentBox as="h2" title={`โปรโมชั่นเดิมพัน ${BRAND_NAME} เว็บพนันคาสิโนเซิร์ฟไทย`}>
    <p>
      โปรโมชั่นเดิมพัน {BRAND_NAME} มีรายการสิทธิพิเศษสำหรับสมาชิกตามกิจกรรมที่เว็บไซต์กำหนด
      <strong class="text-[#ffd45e]">โดยเน้นโบนัสคืนยอดเสียและกิจกรรมแนะนำเพื่อน</strong>
      ผู้ใช้งานสามารถตรวจสอบยอดที่เข้าเกณฑ์ รอบคำนวณ และสถานะการรับสิทธิ์ผ่านบัญชีตามระบบที่เปิดให้บริการ
      <strong class="text-[#ffd45e]">ทั้งนี้ควรตรวจสอบว่าโปรโมชั่นครอบคลุมบาคาร่า สล็อต หรือบอลออนไลน์ประเภทใดบ้าง</strong>
      เพราะแต่ละกิจกรรมอาจมีข้อกำหนดแตกต่างกัน
    </p>
  </ContentBox>

  <ContentBoxSevenThreePremium as="h3" title="โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสทุกวัน">
    <p slot="left">
      สมาชิก {BRAND_NAME} ที่มียอดเสียตรงตามเงื่อนไขสามารถตรวจสอบสิทธิ์รับ
      <strong class="text-[#ffd45e]">โบนัสคืนยอดเสีย 0.3% ตามรอบประจำวันที่เว็บไซต์กำหนด</strong>
      โดยคำนวณจากยอดที่เข้าเกณฑ์ของกิจกรรม หากระบบรองรับการโอนโบนัสเข้ายูสอัตโนมัติ สมาชิกสามารถตรวจสอบจำนวนโบนัสและประวัติการรับสิทธิ์ได้จากบัญชี
      <strong class="text-[#ffd45e]">ควรอ่านรายละเอียดประเภทเกมที่ร่วมรายการ เวลาตัดยอด และข้อกำหนดการใช้โบนัสก่อนรับทุกครั้ง</strong>
    </p>
    <Picture
      slot="right"
      src={imgCashback}
      loading="lazy"
      fetchpriority="low"
      widths={[297, 480, 600]}
      sizes="(max-width: 697px) calc(100vw - 98px), (max-width: 767px) 600px, (max-width: 1279px) calc(30vw - 87px), 297px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt={`ภาพโปรโมชั่นคืนยอดเสียของ ${BRAND_NAME} เป็นงานอาร์ตสี่เหลี่ยมจัตุรัสบนฉากคาสิโนสีดำที่ส่องด้วยแสงสีม่วง ด้านบนเป็นโลโก้ ${BRAND_NAME} ตัวอักษรสามมิติสีม่วงขัดเงาขอบทองคู่กับตัวเลขสีทองเมทัลลิก อยู่ในวงแหวนทองที่ขาดช่วง ใต้โลโก้เป็นชายหนุ่มผมขาวเงินและหญิงสาวผมสั้นสีขาวเงินในชุดสีดำยืนเคียงกัน รอบตัวมีไพ่เอซขอบทอง มงกุฎทอง ชิปคาสิโนสีม่วงสลับทอง ลูกเต๋าสีทองทางด้านขวา และเหรียญทองเรียงอยู่ด้านล่าง กลางภาพเป็นคำว่า โปรโมชั่น ตัวอักษรทองสามมิติขนาดใหญ่ ถัดลงมาบนแผ่นป้ายสีดำขอบทองเป็นคำว่า คืนยอดเสีย คู่กับเลข 0.3%`}
      class="mx-auto h-auto w-full max-w-[600px] rounded-2xl border border-[#7505cc]/60 shadow-[0_0_28px_rgba(117,5,204,0.3)]"
    />
  </ContentBoxSevenThreePremium>

  <ContentBoxSevenThreeNeumorphism as="h3" title="โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด">
    <p slot="left">
      โปรโมชั่นแนะนำเพื่อน {BRAND_NAME}
      <strong class="text-[#ffd45e]">ระบุอัตราโบนัส 0.8% จากยอดที่เข้าเกณฑ์ตามข้อกำหนด</strong>
      สมาชิกสามารถตรวจสอบรายละเอียดลิงก์แนะนำ จำนวนเพื่อนที่สมัคร และวิธีคำนวณโบนัสผ่านระบบสมาชิก
      <strong class="text-[#ffd45e]">ส่วนคำว่าไม่จำกัดควรระบุให้ชัดว่าหมายถึงจำนวนเพื่อนที่แนะนำ จำนวนครั้งในการรับสิทธิ์ หรือยอดโบนัสสูงสุด</strong>
      เพื่อให้เข้าใจเงื่อนไขของกิจกรรมตรงกัน
    </p>
    <Picture
      slot="right"
      src={imgReferral}
      loading="lazy"
      fetchpriority="low"
      widths={[312, 480, 600]}
      sizes="(max-width: 697px) calc(100vw - 98px), (max-width: 767px) 600px, (max-width: 1279px) calc(30vw - 72px), 312px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt={`ภาพโปรโมชั่นแนะนำเพื่อนของ ${BRAND_NAME} เป็นงานอาร์ตสี่เหลี่ยมจัตุรัสชุดเดียวกัน บนฉากคาสิโนสีดำที่ส่องด้วยแสงสีม่วง ด้านบนเป็นโลโก้ ${BRAND_NAME} ตัวอักษรสามมิติสีม่วงขัดเงาขอบทองคู่กับตัวเลขสีทองเมทัลลิก อยู่ในวงแหวนทองที่ขาดช่วง ใต้โลโก้เป็นชายหนุ่มผมขาวเงินและหญิงสาวผมสั้นสีขาวเงินในชุดสีดำ ด้านข้างมีไพ่เอซขอบทอง มงกุฎทอง ชิปคาสิโนสีม่วงสลับทอง และลูกเต๋าสีทอง กลางภาพเป็นคำว่า โปรโมชั่น ตัวอักษรทองสามมิติขนาดใหญ่ใต้มงกุฎทองดวงเล็ก ถัดลงมาบนแผ่นป้ายสีดำขอบทองเป็นคำว่า แนะนำเพื่อน และคำว่า โบนัส คู่กับเลข 0.8%`}
      class="mx-auto h-auto w-full max-w-[600px] rounded-2xl border border-[#e2b33f]/55 shadow-[0_0_28px_rgba(226,179,63,0.24)]"
    />
  </ContentBoxSevenThreeNeumorphism>

  <ContentBoxSpecial as="h2" title={`${BRAND_NAME} ระบบฝากถอนเข้าบริษัทเจ้าของโดยตรง`}>
    <p slot="left">
      ระบบฝากถอน {BRAND_NAME} นำเสนอการจัดการธุรกรรมผ่านบัญชีสมาชิก
      <strong class="text-[#ffd45e]">โดยผู้ใช้งานสามารถตรวจสอบยอดเงิน ช่องทางชำระเงิน และสถานะรายการตามระบบที่เว็บไซต์เปิดให้บริการ</strong>
      หากมีการใช้บัญชีบริษัทเจ้าของโดยตรง
      <strong class="text-[#ffd45e]">ควรแสดงชื่อบริษัทหรือนิติบุคคลที่เกี่ยวข้องให้ตรวจสอบได้</strong>
      พร้อมรายละเอียดบัญชีรับเงินที่ตรงกับข้อมูลของผู้ดำเนินงาน
    </p>
    <p slot="right">
      <strong class="text-[#ffd45e]">ก่อนทำรายการควรตรวจสอบชื่อบัญชีปลายทาง จำนวนเงิน และเงื่อนไขการฝากถอนให้ครบถ้วน</strong>
      เนื่องจากการใช้บัญชีบริษัทไม่ได้รับประกันความปลอดภัยของธุรกรรมทั้งหมด หากพบชื่อบัญชีไม่ตรงกับข้อมูลที่เว็บไซต์แจ้ง หรือมีการเปลี่ยนช่องทางรับเงินโดยไม่ชัดเจน
      <strong class="text-[#ffd45e]">ควรสอบถามฝ่ายบริการผ่านช่องทางหลักก่อนยืนยันรายการ พร้อมเก็บหลักฐานธุรกรรมไว้สำหรับตรวจสอบ</strong>
    </p>
  </ContentBoxSpecial>

  <ContentBoxFloatingBadge as="h2" title={`แอดมิน ${BRAND_NAME} เปิดบริการ 24 ชั่วโมง`}>
    <div class="flex flex-col gap-4">
      <p>
        แอดมิน {BRAND_NAME}
        <strong class="text-[#ffd45e]">มีช่องทางสำหรับรับเรื่องสอบถามเกี่ยวกับการเข้าสู่ระบบ การใช้งานเกมคาสิโน การเดิมพันฟุตบอล โปรโมชั่น และรายการฝากถอนที่อยู่ระหว่างตรวจสอบ</strong>
        โดยระบุเวลาให้บริการตลอด 24 ชั่วโมง สมาชิกสามารถติดต่อผ่านช่องทางหลักที่เว็บไซต์กำหนด
        <strong class="text-[#ffd45e]">พร้อมแจ้งรายละเอียดปัญหาให้ครบถ้วน</strong>
        เพื่อให้เจ้าหน้าที่ตรวจสอบรายการได้ตรงประเด็น
      </p>
      <p>
        หากพบปัญหาเกี่ยวกับบาคาร่าและสล็อต
        <strong class="text-[#ffd45e]">ควรแจ้งชื่อเกม ค่าย และเวลาที่เกิดเหตุ</strong>
        ส่วนการเดิมพันบอลออนไลน์ควรเตรียมชื่อคู่แข่งขันและหมายเลขรายการ หากเป็นปัญหาธุรกรรมควรเก็บหลักฐานจำนวนเงินและเวลาทำรายการไว้สำหรับตรวจสอบ
        <strong class="text-[#ffd45e]">โดยไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น</strong>
        แม้จะอ้างว่าเป็นเจ้าหน้าที่ของเว็บไซต์ก็ตาม
      </p>
    </div>
  </ContentBoxFloatingBadge>

  <Faq as="h2" title={`คำถามที่พบบ่อยเกี่ยวกับ ${BRAND_NAME}`} faqs={faqs} />

  <LoginRtpSection />

  <ReviewCardSumo />

  <Navfoot />
</MainLayout>
