---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ProviderGrid from "../components/ProviderGridPremium.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import LatestWinners from "../components/LatestWinnersPremium.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import Faq4 from "../components/Faq4.astro";
import ReviewCardSumo from "../components/ReviewCardSumo.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// slide1 is the แนะนำเพื่อน 0.8% poster and slide2 is the คืนยอดเสีย 0.3% one, in
// the same order the docx runs its two H3 sub-sections. slide3 and slide4 belong
// to a previous client's drop (dated weeks before this one) and are never
// imported here, and there is no banner2+ illustration in this brand's drop
// either — banner2.png/banner3.png are likewise older brands' leftovers.

// Title and description are the brief's own Title/Description lines, used
// verbatim. A brief-supplied description is never padded up to the 150-char
// floor and never topped up from the H1/H2 — this one is 118 characters and
// that is correct.
const pageTitle = "SUPERMAX168 คาสิโนเว็บตรง100% บาคาร่า สล็อต เข้าเล่นได้24ชม.";

const pageDescription = "SUPERMAX168 คาสิโนเว็บตรง100% ทางเข้าแท้ บาคาร่า สล็อต บอล หวย ไฮโล ปลอดภัยทุกการเดิมพัน สมัครรับโปรโมชั่นดีๆ อีกมากมาย";

// The ticker copy is passed explicitly rather than relying on the component's
// default — every Announcement* variant's default belongs to whichever brand
// wired it in last. No emoji in this string: an emoji baked into a text prop
// cannot be given its own aria-hidden span, and this marquee prints the string
// twice.
const announcement =
  "SUPERMAX168 คาสิโนเว็บตรง100% รวมบาคาร่า สล็อต บอล หวย และไฮโล ไว้ในบัญชีเดียว • รองรับการเข้าใช้งานผ่านมือถือและคอมพิวเตอร์ตลอด 24 ชั่วโมง • Login แล้วเลือกเกมที่ต้องการได้ทันที พร้อมตรวจสอบกติกา อัตราจ่าย และวงเงินเดิมพันก่อนทำรายการด้วยตัวเอง • โปรโมชั่นแนะนำเพื่อน โบนัส 0.8% และโปรโมชั่นคืนยอดเสีย โบนัส 0.3% ตามเงื่อนไขและรอบคำนวณที่กำหนด ควรตรวจสอบรายละเอียดก่อนกดรับทุกครั้ง • ระบบฝากถอนรองรับวอลเลทและบัญชีธนาคารตามช่องทางที่เว็บไซต์เปิดรองรับ ควรตรวจสอบชื่อบัญชี ยอดขั้นต่ำ และวงเงินก่อนทำธุรกรรม • แอดมิน SUPERMAX168 ดูแลออนไลน์ตลอด 24 ชั่วโมง";

// One array, used by both <Faq4> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last.
const faqs = [
  {
    q: "SUPERMAX168 มีเกมอะไรให้เลือกบ้าง?",
    a: "มีเกมหลักอย่างบาคาร่า สล็อต บอล หวย และไฮโล รวมถึงเกมประเภทอื่นตามที่ระบบเปิดให้บริการ สมาชิกสามารถเลือกหมวดที่สนใจและตรวจสอบกติกา อัตราจ่าย และวงเงินก่อนเริ่มเดิมพันได้",
  },
  {
    q: "โปรโมชั่น SUPERMAX168 0.8% และ 0.3% รับอย่างไร?",
    a: "โบนัส 0.8% เป็นโปรโมชั่นแนะนำเพื่อนสำหรับยอดที่เข้าเงื่อนไข ส่วนโบนัส 0.3% เป็นโปรโมชั่นคืนยอดเสียตามรอบที่กำหนด สมาชิกควรตรวจสอบยอดคำนวณและข้อกำหนดของแต่ละโปรโมชั่นก่อนกดรับ",
  },
  {
    q: "หากฝากถอน SUPERMAX168 แล้วเครดิตไม่เข้าต้องทำอย่างไร?",
    a: "ให้ตรวจสอบประวัติธุรกรรมในบัญชีก่อน หากรายการยังค้างหรือยอดไม่ถูกต้อง สามารถติดต่อแอดมิน SUPERMAX168 พร้อมแจ้งจำนวนเงิน เวลา และช่องทางที่ใช้ทำรายการ เพื่อให้เจ้าหน้าที่ตรวจสอบและช่วยแก้ไขปัญหาได้ตลอด 24 ชั่วโมง",
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// Cream marks a claim the brief states outright; gold marks the caveat that
// goes with it.

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb. Every URL in the graph is derived
// by pageGraph from `site:` — no domain is typed out in this file.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <ContentBoxNeumorphism as="h1" title="SUPERMAX168 คาสิโนเว็บตรง100% เข้าเล่นได้ทุกรูปแบบ">
    <p class="text-left text-base leading-relaxed text-[#f3e6c8]">
      <strong class="text-[#fff8e2]">SUPERMAX168</strong> เปิดบริการเกมคาสิโนออนไลน์สำหรับสมาชิกที่ต้องการรวมหลายรูปแบบการเดิมพันไว้ในบัญชีเดียว มีทั้งบาคาร่า สล็อต บอล หวย และไฮโล
      <strong class="text-[#fff8e2]">รองรับการเข้าใช้งานผ่านมือถือและคอมพิวเตอร์ตลอด 24 ชั่วโมง</strong>
      สมาชิกสามารถเลือกเกม ตรวจสอบเครดิต รับโปรโมชั่น และจัดการฝากถอนได้จากหน้าเว็บไซต์ พร้อมระบบรองรับวอลเลทและธนาคาร รวมถึงมีแอดมินคอยช่วยเหลือเมื่อพบปัญหาระหว่างใช้งาน
    </p>
  </ContentBoxNeumorphism>

  <ContentBoxTwoPremium as="h2" title="ทางเข้าแท้ SUPERMAX168 บาคาร่า สล็อต บอล หวย ไฮโล ปลอดภัยทุกการเดิมพัน">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f3e6c8]">
      <strong class="text-[#fff8e2]">SUPERMAX168</strong> รวมหมวดเกมหลักไว้ให้เลือกตามความต้องการ ทั้งบาคาร่าออนไลน์สำหรับผู้ที่ชอบเกมไพ่ สล็อตออนไลน์จากหลายค่าย เดิมพันฟุตบอลตามรายการแข่งขัน
      หวยออนไลน์ตามรอบที่เปิดรับ และไฮโลในหมวดคาสิโน
      <strong class="text-[#fff8e2]">สมาชิกสามารถ Login แล้วเลือกเกมที่ต้องการผ่านบัญชีเดียว</strong>
      พร้อมตรวจสอบกติกา อัตราจ่าย และวงเงินเดิมพันก่อนทำรายการได้ด้วยตัวเอง
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#f3e6c8]">
      สำหรับคำว่า “เว็บตรง 100%” หรือ “ทางเข้าแท้”
      <strong class="text-[#ecc964]">ควรมีข้อมูลผู้ให้บริการหรือรายละเอียดที่สามารถตรวจสอบได้บนเว็บไซต์</strong>
      เพื่อช่วยให้สมาชิกแยกช่องทางหลักออกจากลิงก์ที่ไม่เกี่ยวข้องได้ชัดเจนยิ่งขึ้น
    </p>
  </ContentBoxTwoPremium>

  <LoginRtpSection />

  <ProviderGrid />

  <GameRankingBoard />

  <ContentBox as="h2" title="สมัคร SUPERMAX168 รับโปรโมชั่นสำหรับสมาชิกได้ไม่จำกัด">
    <p class="text-left text-base leading-relaxed text-[#f3e6c8]">
      หลังสมัคร <strong class="text-[#fff8e2]">SUPERMAX168</strong> สมาชิกสามารถ Login เพื่อตรวจสอบโปรโมชั่นที่เปิดให้รับในแต่ละช่วงได้
      <strong class="text-[#fff8e2]">โดยมีทั้งกิจกรรมแนะนำเพื่อนและคืนยอดเสียตามเงื่อนไข</strong>
      โปรโมชั่นแต่ละรายการอาจกำหนดรอบคำนวณ ยอดที่เข้าเกณฑ์ และเงื่อนไขการรับโบนัสแตกต่างกัน
      <strong class="text-[#ecc964]">จึงควรตรวจสอบรายละเอียดก่อนกดรับทุกครั้ง</strong>
    </p>
  </ContentBox>

  <ContentBoxSevenThree as="h3" title="โปรโมชั่นแนะนำเพื่อน โบนัส 0.8%">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อน 0.8% ของ SUPERMAX168 พื้นหลังคาสิโนโทนดำทอง มีเหรียญทองปลิวกระจาย ด้านบนกลางภาพเป็นโลโก้ SUPERMAX168 ตัวอักษร SUPER สีทองไล่เฉด คำว่า MAX สีเงินโครเมียม และเลข 168 สีทองคู่กับชิปคาสิโนรูปโพดำ ถัดลงมาเป็นป้ายกรอบทองเขียนว่า โปรโมชั่น ตามด้วยข้อความ แนะนำเพื่อน สีทอง วางเหนือตัวเลข 0.8% ขนาดใหญ่สีขาวเงินขอบทอง ด้านซ้ายเป็นไพ่เอซสี่ใบ กล่องของขวัญผูกโบว์ทอง และกองเหรียญทอง ด้านขวาเป็นผู้หญิงผมรวบสวมชุดสีดำคาดทองยกมือชี้มาที่ตัวเลข ฉากหลังด้านขวาเป็นวงล้อรูเล็ตและตู้สล็อต 777 ด้านล่างเป็นป้ายสามอันพร้อมไอคอน เขียนว่า ชวนเพื่อนง่าย รับโบนัสทันที กับ รับโบนัส จากยอดเพื่อนเล่น และ มั่นคง ปลอดภัย เชื่อถือได้ 100%"
      class="mx-auto h-auto w-full rounded-2xl border border-[#ecc964]/45 shadow-[0_10px_30px_rgba(236,201,100,0.25)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f3e6c8]">
      สมาชิกสามารถแชร์ลิงก์แนะนำส่วนตัวให้เพื่อน เมื่อเพื่อนสมัครและมีรายการตรงตามเงื่อนไข
      <strong class="text-[#fff8e2]">ระบบจะคำนวณโบนัสแนะนำเพื่อน 0.8% ตามยอดที่เข้าเกณฑ์</strong>
      สามารถตรวจสอบจำนวนเพื่อน ยอดคำนวณ และโบนัสที่ได้รับผ่านบัญชีสมาชิกได้ด้วยตัวเอง
    </p>
  </ContentBoxSevenThree>

  <ContentBoxSevenThreePremium as="h3" title="โปรโมชั่นคืนยอดเสีย โบนัส 0.3%">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นคืนยอดเสีย 0.3% ของ SUPERMAX168 พื้นหลังคาสิโนโทนดำทอง มีเหรียญทองปลิวกระจาย ด้านบนกลางภาพเป็นโลโก้ SUPERMAX168 ตัวอักษร SUPER สีทองไล่เฉด คำว่า MAX สีเงินโครเมียม และเลข 168 สีทองคู่กับชิปคาสิโนรูปโพดำ ถัดลงมาเป็นป้ายกรอบทองเขียนว่า โปรโมชั่น ตามด้วยข้อความ คืนยอดเสีย สีขาว วางเหนือตัวเลข 0.3% ขนาดใหญ่สีขาวเงินขอบทอง ด้านซ้ายเป็นไพ่เอซสี่ใบ กล่องของขวัญผูกโบว์ทอง และกองเหรียญทอง ด้านขวาเป็นผู้หญิงผมรวบสวมชุดสีดำคาดทองยกมือชี้มาที่ตัวเลข ฉากหลังด้านขวาเป็นวงล้อรูเล็ตและตู้สล็อต 777 ด้านล่างเป็นป้ายสามอันพร้อมไอคอน เขียนว่า คืนยอดเสียทุกวัน กดรับได้เอง กับ มั่นคง ปลอดภัย เชื่อถือได้ 100% และ รองรับ วอลเลท ทุกธนาคาร"
      class="mx-auto h-auto w-full rounded-2xl border border-[#e3e3e4]/35 shadow-[0_10px_30px_rgba(227,227,228,0.18)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f3e6c8]">
      หากสมาชิกมียอดเสียตรงตามข้อกำหนด
      <strong class="text-[#fff8e2]">สามารถตรวจสอบสิทธิ์รับโบนัสคืนยอดเสีย 0.3% ตามรอบที่ SUPERMAX168 กำหนด</strong>
      ระบบจะแสดงยอดที่เข้าเงื่อนไขและจำนวนโบนัสที่สามารถกดรับได้
      <strong class="text-[#ecc964]">ควรตรวจสอบประเภทเกม รอบคำนวณ และข้อกำหนดก่อนรับสิทธิ์ทุกครั้ง</strong>
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBoxTwoCyberCut as="h2" title="ระบบฝากถอน SUPERMAX168 รองรับวอลเลทและธนาคารชั้นนำ">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f3e6c8]">
      สมาชิกสามารถจัดการเครดิตผ่านระบบฝากถอน <strong class="text-[#fff8e2]">SUPERMAX168</strong> โดยเลือกวอลเลทหรือบัญชีธนาคารจากช่องทางที่เว็บไซต์เปิดรองรับ
      <strong class="text-[#fff8e2]">ทำรายการฝาก ส่งคำขอถอน และติดตามสถานะผ่านบัญชีสมาชิกได้โดยตรง</strong>
      ช่วยให้จัดการธุรกรรมผ่านมือถือได้สะดวกโดยไม่จำเป็นต้องแจ้งรายการกับเจ้าหน้าที่ทุกครั้ง
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#f3e6c8]">
      ก่อนทำธุรกรรม
      <strong class="text-[#ecc964]">ควรตรวจสอบชื่อบัญชี จำนวนเงิน ยอดขั้นต่ำ และวงเงินของช่องทางที่เลือก</strong>
      เนื่องจากธนาคารหรือวอลเลทแต่ละประเภทอาจมีเงื่อนไขแตกต่างกัน
    </p>
  </ContentBoxTwoCyberCut>

  <LatestWinners />

  <ContentBoxSpecial as="h2" title="แอดมิน SUPERMAX168 มีระบบดูแลออนไลน์ ตลอด 24 ชั่วโมง" iconleft="🎧" iconright="🔐">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f3e6c8]">
      หากพบปัญหาเกี่ยวกับการสมัคร Login เข้าเกมไม่ได้ ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง หรือโปรโมชั่นไม่แสดง
      <strong class="text-[#fff8e2]">สามารถติดต่อแอดมิน SUPERMAX168 ได้ตลอด 24 ชั่วโมง</strong>
      โดยควรแจ้งเวลา จำนวนเงิน และรายละเอียดของรายการให้ครบ เพื่อช่วยให้เจ้าหน้าที่ตรวจสอบปัญหาได้รวดเร็วและตรงจุด
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#f3e6c8]">
      สมาชิกใหม่ยังสามารถสอบถามขั้นตอนการใช้งาน วิธีฝากถอน การรับโปรโมชั่น หรือรายละเอียดเกมแต่ละประเภทได้ และ
      <strong class="text-[#ecc964]">ไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น</strong>
    </p>
  </ContentBoxSpecial>

  <Faq4 title="คำถามที่พบบ่อยเกี่ยวกับ SUPERMAX168" faqs={faqs} />

  <ReviewCardSumo />

  <Navfoot />
</MainLayout>
