---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxTwo from "../components/ContentBoxTwo.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import Faq2 from "../components/Faq2.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import LatestWinners from "../components/LatestWinners2.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// Title and description are the brief's own Title/Description lines, verbatim.
// A brief-supplied description ships at whatever length it was written — it is
// not padded up to the 150-character floor.
const pageTitle = "ขวัญใจ168 ทางเข้าสำรอง สมัครเซิร์ฟเดิม เข้าเดิมพันสล็อตได้ทันที";

const pageDescription = "ทางเข้าสำรอง ขวัญใจ168 เว็บสล็อตเซิร์ฟใหม่ เมื่อเว็บหลักโดนแบน สามารถสมัครเข้าเล่น ด้วยยูสเซอร์ใหม่ ฝากถอนออโต้ ได้ทันที";

// The ticker copy is passed explicitly rather than relying on the component's
// default — every Announcement* variant's default belongs to whichever brand
// wired it in last. The string matches Announcement3's current default on
// purpose, so the pages that call <Announcement /> bare show the same ticker.
// No emoji in this string: an emoji baked into a text prop cannot be given its
// own aria-hidden span, and this marquee prints the string twice.
const announcement =
  "ขวัญใจ168 ทางเข้าเล่นสล็อตสำรอง เข้าเดิมพันได้ทันทีเมื่อช่องทางหลักใช้งานไม่ได้ • สมัครยูสเซอร์ใหม่หรือใช้บัญชีเดิมตามที่ระบบกำหนด ฝากถอนออโต้ • โปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไข • รองรับทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์ • แอดมิน ขวัญใจ168 ดูแลสมาชิกตลอด 24 ชั่วโมง";

// One array, used by both <Faq2> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last.
const faqs = [
  {
    q: "ทางเข้า ขวัญใจ168 เดิมเข้าไม่ได้ควรทำอย่างไร?",
    a: "ควรตรวจสอบประกาศหรือสอบถามช่องทางติดต่อของผู้ให้บริการเพื่อยืนยันทางเข้าสำรองก่อนใช้งาน ไม่ควรเลือกเว็บไซต์จากลิงก์ที่ไม่ทราบแหล่งที่มา โดยเฉพาะก่อนกรอกข้อมูล Login หรือทำรายการฝากเงิน",
  },
  {
    q: "ทางเข้าใหม่ต้องสมัครยูสเซอร์ ขวัญใจ168 ใหม่หรือไม่?",
    a: "ขึ้นอยู่กับระบบที่เปิดให้บริการ หากบัญชีเดิมยังรองรับสามารถใช้ข้อมูลเดิมตามคำแนะนำของผู้ให้บริการ แต่หากมีการเปลี่ยนระบบและกำหนดให้เปิดบัญชีใหม่ ควรสมัครผ่านหน้าที่ได้รับการยืนยันเท่านั้น",
  },
  {
    q: "หากสมัครแล้วฝากถอนหรือโบนัสไม่เข้าต้องทำอย่างไร?",
    a: "ตรวจสอบสถานะรายการในบัญชีก่อน หากเครดิตหรือโบนัสยังไม่แสดง สามารถติดต่อแอดมิน ขวัญใจ168 พร้อมแจ้งรายละเอียดและเวลาที่ทำรายการ เพื่อให้เจ้าหน้าที่ช่วยตรวจสอบและแนะนำขั้นตอนดำเนินการต่อได้",
  },
];

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <SmoothCarousel />

  <ContentBoxCyberCut as="h1" title="ขวัญใจ168 ทางเข้าเล่นสล็อตสำรอง ปลอดภัย เชื่อถือได้">
    <p class="text-left text-base leading-relaxed text-[#cfe7f2]">
      <strong class="text-[#eafcff]">ขวัญใจ168</strong> จัดเตรียมทางเข้าเล่นสล็อตสำรองสำหรับสมาชิกที่ไม่สามารถเข้าใช้งานช่องทางเดิมได้ รองรับการใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ พร้อมระบบสมัครสมาชิก ฝากถอนอัตโนมัติ
      และโปรโมชั่นสำหรับผู้ใช้งานตามเงื่อนไข สมาชิกควรตรวจสอบว่าลิงก์ที่เข้าใช้งานเป็นช่องทางที่ประกาศโดยผู้ให้บริการก่อนกรอกข้อมูลบัญชีหรือทำธุรกรรมทุกครั้ง
    </p>
  </ContentBoxCyberCut>

  <ContentBoxTwoPremium as="h2" title="ทางเข้าเล่นสำรอง ขวัญใจ168 เมื่อเว็บหลักโดนแบน เข้าเล่นช่องทางนี้ได้เลย">
    <p slot="left" class="text-left text-base leading-relaxed text-[#cfe7f2]">
      หากช่องทางหลักของ ขวัญใจ168 ไม่สามารถเข้าใช้งานได้ สมาชิกสามารถตรวจสอบทางเข้าสำรองจากช่องทางติดต่ออย่างเป็นทางการของผู้ให้บริการ โดยหน้าเว็บสำรองรองรับการใช้งานผ่านเบราว์เซอร์บนมือถือและคอมพิวเตอร์
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#cfe7f2]">
      ก่อน Login หรือสมัครบัญชีใหม่ ควรตรวจสอบชื่อเว็บไซต์และช่องทางให้ถูกต้อง เพื่อหลีกเลี่ยงเว็บไซต์เลียนแบบหรือการส่งข้อมูลให้บุคคลอื่นโดยไม่ตั้งใจ
    </p>
  </ContentBoxTwoPremium>

  <ContentBoxFloatingBadge as="h2" title="สมัครเข้าเล่นสล็อต ขวัญใจ168 ใช้ยูสใหม่ เข้าเล่นได้ทันที">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#cfe7f2]">
        กรณีระบบกำหนดให้สมัครบัญชีใหม่ สมาชิกสามารถดำเนินการผ่านหน้าสมัครของ ขวัญใจ168 โดยกรอกข้อมูลตามที่ระบบร้องขอ จากนั้น Login และตรวจสอบช่องทางฝากเครดิตที่เปิดให้บริการ
        ก่อนทำรายการควรตรวจสอบว่าบัญชีเดิมสามารถใช้งานต่อได้หรือจำเป็นต้องสร้างยูสเซอร์ใหม่กับเจ้าหน้าที่ เพื่อป้องกันการสมัครบัญชีซ้ำโดยไม่จำเป็น
      </p>
      <p class="text-left text-base leading-relaxed font-black text-[#eafcff]">เริ่มต้นใช้งานได้ใน 3 ขั้นตอน</p>
      <ol class="ml-5 flex list-decimal flex-col gap-3 text-left text-base leading-relaxed text-[#cfe7f2] marker:font-black marker:text-[#4bdbee]">
        <li>ตรวจสอบทางเข้าสำรองจากช่องทางของ ขวัญใจ168</li>
        <li>สมัครยูสเซอร์ใหม่หรือเข้าสู่ระบบตามที่ระบบกำหนด</li>
        <li>ตรวจสอบเครดิต โปรโมชั่น และรายละเอียดเกมก่อนเริ่มเดิมพัน</li>
      </ol>
    </div>
  </ContentBoxFloatingBadge>

  <ProviderGrid />

  <ContentBox as="h2" title="โปรโมชั่น ขวัญใจ168 จัดเต็มทุกโปร">
    <p class="text-left text-base leading-relaxed text-[#cfe7f2]">
      สมาชิกสามารถตรวจสอบโปรโมชั่น ขวัญใจ168 ผ่านบัญชีผู้ใช้งาน โดยมีทั้งกิจกรรมแนะนำเพื่อนและโปรโมชั่นคืนยอดเสียตามรอบที่กำหนด แต่ละรายการอาจมีวิธีคำนวณ ยอดที่เข้าเงื่อนไข และข้อกำหนดการถอนแตกต่างกัน
      จึงควรอ่านรายละเอียดล่าสุดก่อนกดรับโบนัสทุกครั้ง
    </p>
  </ContentBox>

  <ContentBoxSevenThreePremium as="h3" title="โปรโมชั่นขายดี แจกคอมมิชชั่น 0.8% แค่แนะนำ">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์จัตุรัส พื้นหลังรีสอร์ทริมทะเลกลางคืนแสงนีออนฟ้า มุมบนซ้ายเป็นโลโก้ ขวัญใจ168 กลางภาพเขียนว่า โปรโมชั่น แนะนำเพื่อน 0.8% ตัวเลขใหญ่สีขาวฟ้า ด้านขวาเป็นผู้หญิงห่มผ้าลายฟ้าขาวยืนแบมือ ด้านล่างเป็นการ์ตูนครอบครัวชายทะเล ปู หอย ลูกเต๋า ไพ่เอซ และแถบเขียนว่า สล็อต ครบจบในที่เดียว พร้อมไอคอน มั่นคง ฝาก-ถอน รวดเร็ว และโบนัสจัดเต็ม"
      class="mx-auto h-auto w-full rounded-2xl border border-[#1687c9]/50 shadow-[0_10px_30px_rgba(22,135,201,0.28)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#cfe7f2]">
      สมาชิกสามารถแชร์ลิงก์แนะนำของตนเองให้เพื่อน เมื่อมีการสมัครและยอดใช้งานตรงตามข้อกำหนด ระบบจะคำนวณคอมมิชชั่นแนะนำ <span class="font-black text-[#ffd76a]">0.8%</span> ตามเงื่อนไข
      สามารถตรวจสอบยอดการแนะนำและโบนัสที่มีสิทธิ์รับผ่านบัญชีสมาชิกก่อนกดรับได้
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBoxSevenThree as="h3" title="โปรโมชั่นรอง คืนยอดเสีย 0.3% รับได้ทุกวัน">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์จัตุรัส พื้นหลังคาสิโนใต้น้ำแสงนีออนฟ้า มุมบนซ้ายเป็นโลโก้ ขวัญใจ168 มุมบนขวาเป็นตู้สล็อตป้าย JACKPOT 168,000,000 กลางภาพเขียนว่า โปรโมชั่น คืนยอดเสีย 0.3% ตัวเลขใหญ่สีขาวฟ้า ด้านขวาเป็นผู้หญิงชุดว่ายน้ำลายฟ้าขาวยืนแบมือ ด้านล่างเป็นการ์ตูนครอบครัวชายทะเล ปู กุ้ง หอย ลูกเต๋า ไพ่เอซ ชิป 168 และแถบไอคอนสี่ช่อง มั่นคง ปลอดภัย 100% จ่ายจริง ไม่อั้นสูงสุด ระบบออโต้ รวดเร็ว ทันใจ และบริการดี ตลอด 24 ชม."
      class="mx-auto h-auto w-full rounded-2xl border border-[#1687c9]/50 shadow-[0_10px_30px_rgba(22,135,201,0.28)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#cfe7f2]">
      สมาชิกที่มียอดเสียตรงตามเงื่อนไขสามารถตรวจสอบสิทธิ์รับโบนัสคืนยอดเสีย <span class="font-black text-[#ffd76a]">0.3%</span> ตามรอบประจำวันที่กำหนด โดยควรตรวจสอบยอดที่นำมาคำนวณ ประเภทเกมที่เข้าร่วม
      และข้อกำหนดเกี่ยวกับโบนัสก่อนรับสิทธิ์ทุกครั้ง
    </p>
  </ContentBoxSevenThree>

  <ContentBoxTwo as="h2" title="แจ้งปัญหาการใช้งาน ผ่านแอดมิน ขวัญใจ168 ตลอด 24 ชั่วโมง">
    <p slot="left" class="text-left text-base leading-relaxed text-[#cfe7f2]">
      หากไม่สามารถเข้าหน้าเว็บสำรอง Login ไม่ได้ สมัครยูสใหม่ไม่สำเร็จ เครดิตไม่เข้า หรือพบปัญหาเกี่ยวกับการฝากถอนและโปรโมชั่น สามารถติดต่อแอดมิน ขวัญใจ168 ผ่านช่องทางที่ผู้ให้บริการประกาศไว้
      พร้อมแจ้งรายละเอียดของปัญหาและเวลาที่ทำรายการ เพื่อให้เจ้าหน้าที่ตรวจสอบได้ตรงจุด
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#cfe7f2]">
      ไม่ควรส่งรหัสผ่าน รหัส OTP หรือข้อมูลยืนยันบัญชีที่เป็นความลับให้บุคคลอื่น และควรตรวจสอบช่องทางติดต่อทุกครั้งก่อนดำเนินการเกี่ยวกับบัญชีหรือการเงิน
    </p>
  </ContentBoxTwo>

  <Faq2 title="คำถามที่พบบ่อยเกี่ยวกับ ขวัญใจ168" faqs={faqs} />

  <LoginRtpSection />

  <LatestWinners />

  <ReviewCardSumo2 />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#9df1ff] via-[#4bdbee] to-[#1687c9] px-4 py-3 text-sm font-black whitespace-nowrap text-[#01050b] shadow-[0_10px_30px_rgba(22,135,201,0.3)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(75,219,238,0.44)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#0e4f7a]/75 bg-gradient-to-r from-[#041d38] to-[#01050b] px-4 py-3 text-sm font-black whitespace-nowrap text-[#eafcff] shadow-[0_10px_30px_rgba(22,135,201,0.18)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#4bdbee]/80 hover:text-[#4bdbee] hover:shadow-[0_15px_40px_rgba(22,135,201,0.32)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>
  </div>

  <Navfoot />
</MainLayout>
