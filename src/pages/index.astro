---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import LatestWinners from "../components/LatestWinners4.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import Faq from "../components/Faq3.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import { pageGraph } from "../lib/schema";
import imgCashback from "../assets/slide1.png";
import imgReferral from "../assets/slide2.png";

// VARIANT ROTATION THIS ROUND (PIGPG -> WEPLAY168), per brand-spec §3. Zero file
// reuse from the previous round: Announcement5 replaces AnnouncementCyber,
// LatestWinners4 replaces LatestWinners3, Faq3 replaces Faq2, ReviewCardSumo2
// replaces ReviewCardSumo, and the ContentBox shape-mix moves off CyberCut /
// FloatingBadge / SevenThreeCyberCut / SevenThreeFloatingBadge / TwoCyberCut /
// Special onto Premium / Neumorphism / SevenThreePremium /
// SevenThreeNeumorphism / TwoPremium / TwoNeumorphism.
// NavbarStyle6 and FooterCyber are the layout's pair this round (previously
// NavbarStyle9 / FooterStyle2) and the brand font moves kanit -> google-sans;
// all three are the orchestrator's shared-chrome step, not this page's.
// Plain ContentBox is the one deliberate carry-over: it is the always-live box
// that terms, privacy, 404 and the button pages render through, so it cannot
// follow a rotation. Section 3 is the single docx section it carries here.
// Every unused *CyberCut / *FloatingBadge / *Huay / *Special / Style file, Faq2,
// ReviewCardSumo, LatestWinners3 and AnnouncementCyber stay on disk as inventory
// for the next brand — none of them was deleted, and PIGPG's copy and colour
// still inside them is expected drift, not a bug.
//
// <Announcement /> runs bare on purpose: Announcement5's default message is
// already this brand's copy, written from this brief, and every sub-page calls
// it bare too — so passing an override here is exactly how the ticker ends up
// saying two different things on two pages of the same site.
//
// PALETTE OF THIS BRAND (brand-spec §2). WEPLAY168 is a neon retro-arcade brand
// and a genuine TWO-COLOUR pair — electric violet #a435f0 / #7a1fc4 leads and
// arcade gold #fbe455 is the second real hue — over the logo's own silver-
// lavender #efe6ff. This round is a full flip off PIGPG's Chinese-New-Year
// lacquer set (#d4200d #a30303 #f5b61d #ffd87a #fdf9e4 #b07a06 #6b0402 #3a0d07
// #2a0806 #1c0503 #120302 #fdeedd #ffd24a and every rgba(245,182,29,α) /
// rgba(212,32,13,α) / rgba(163,3,3,α) glow), off KOON234's emerald-and-gold set
// before it, off แตกดี168's sky-and-lemon set, and off 789BETTING's single-hue
// metallic gold. None of those survives on this page or in any component it
// renders — and gold is the trap: "there is already gold here" does not mean it
// is THIS brand's gold (#f5b61d, #fce604, #fad354 and #cc920a are all previous
// brands' values).
// logo.webp is a purple Game-Boy-shaped handheld with a gold pixel space-invader
// on its screen and a gold d-pad, carrying WEPLAY in silver-lavender 3-D letters
// and 168 in bright gold, over a violet lightning-bolt flash. bg.json this drop
// is {"mode":"color","color":"#0c0024"} — a near-black indigo page surface, so
// the depth ladder below (#1e0a3c raised / #17062e mid / #110321 deep / #0a0117
// deepest) makes every card LIFT OFF the page rather than sink into it, which is
// what the glowing arcade cabinets in the artwork call for.
// Body copy is #ece2ff (= BRAND_TEXT), 12.5:1 on the raised surface.
// Highlights below are #fbe455, which §2 pins to exactly this one job — unlike
// #ffd23d and #efe6ff which it pins to gradient mids and bright ends, unlike
// #d2a6ff which is the secondary/hover text colour, and unlike #a435f0, #5b1a75
// and #c98a05, which never carry text at all (violet bright is only 3.1:1
// against light text) and appear here only as border, rail and shadow colours.
// #190633 is the only ink allowed on a gold / cream / violet-bright fill.
//
// IMAGE ROLES FOR THIS DROP (2026-10-09, brand-spec §4). Two files are
// referenced from this page and only two, and each pairing is read off the
// artwork itself:
//   slide1.png — square 600x600: the WEPLAY168 logo top left, the silver-haired
//     woman centre winking with one hand open toward the viewer, the sunglasses
//     tiger at right, a gold gift box at left, a 777 slot machine at right and
//     gold coins everywhere, and across the bottom โปรโมชั่น in large gold 3-D
//     type with คืนยอดเสีย and an oversized gold 0.3% under it. The artwork
//     prints the heading itself, so it belongs to docx H3 #4. Imported as
//     imgCashback.
//   slide2.png — the companion, same square set: the logo top left, the gold-
//     haired woman centre giving a thumbs-up with the silver-haired woman behind
//     her left shoulder, the blue penguin at lower left, the sunglasses tiger at
//     right, red cherries, a gold star, violet-and-gold 777 reels and gold
//     coins, and across the bottom โปรโมชั่น in gold 3-D type with
//     แนะนำเพื่อน โบนัส and an oversized gold 0.8% under it. It belongs to docx
//     H3 #5. Imported as imgReferral.
// Both slides are 600x600 on disk, so 600 is the top real candidate — nothing
// above it would be a real pixel — and each picture carries max-w-[600px] so the
// art is never upscaled past its own bitmap.
// Each slide sits in a ContentBoxSevenThree* image+text block, which is that
// family's hard cap of two per rebrand, so there is no third SevenThree anywhere
// on the site and no slide appears outside those two blocks.
// The two blocks mirror each other: ContentBoxSevenThreePremium lays out
// md:grid-cols-[3fr_7fr] so its picture goes in slot="left" while the paragraph
// keeps the wide column, and ContentBoxSevenThreeNeumorphism lays out
// md:grid-cols-[7fr_3fr] so its picture goes in slot="right". The two pictures
// therefore alternate sides instead of stacking down the same edge, and each
// `sizes` describes its own 3fr column rather than the viewport. Tailwind sets
// box-sizing: border-box globally, so every max-w-* below caps the box INCLUDING
// its padding and border. Both figures are recomputed from the component that
// owns the column — if a padding/gap/border/cap changes there, these move with it:
//   ContentBoxSevenThreePremium: cap on the SECTION (max-w-7xl/1280 + px-4), so
//     the card is min(100vw,1280) - 32 and the cap is reached at 100vw >= 1280.
//     border(1x2=2) + md:p-10(40x2=80) + gap-10(40) -> 1126 of column space at
//     the cap. The 3fr image column has no padding of its own (md:border-l and
//     md:pl-10 are on the TEXT column).
//       >= 1280px : 1126 x 0.3                        = 337.8 -> 338px
//       md..1279  : (100vw - 154) x 0.3               = calc(30vw - 46px)
//       < md      : one column at p-8                 = calc(100vw - 98px)
//   ContentBoxSevenThreeNeumorphism: cap on the SECTION (max-w-[1400px] + px-4),
//     border(1x2=2) + p-8(32x2=64) + gap-8(32) -> 1270, and the image column here
//     DOES add md:border-l(1) + md:pl-8(32) = 33 of its own.
//       >= 1400px : 1270 x 0.3 - 33                   = 381 - 33 = 348px
//       md..1399  : (100vw - 130) x 0.3 - 33          = calc(30vw - 72px)
//       < md      : one column at p-8                 = calc(100vw - 98px)
// Neither is the LCP element — MainLayout's hero banner is — so both are
// loading="lazy" fetchpriority="low" decoding="async" and neither takes
// fetchpriority="high". formats/fallbackFormat/quality are left at the house
// values: tools/avif-quality-service.mjs rescales AVIF quality on its own, so
// quality={80} must not be hand-tuned per format.
//
// The alt text was written from THIS drop's artwork per brand-spec §4, read off
// the files rather than carried over: the set is a violet neon arcade scene of
// gold coins, gold space-invaders, 777 reels and a purple handheld console with
// two women and a sunglasses tiger — not PIGPG's deep-red Chinese-New-Year scene
// with red lanterns, gold ingots and 福 envelopes, and not KOON234's emerald
// lounge. There is no red lacquer plaque, no cheongsam, no ingot and no pig in a
// Chinese cap on either file, and the logo is a purple handheld rather than a
// pig's head.
//
// Deliberately NOT imported, and every file still on disk:
//   banner2.png (10-08) is PIGPG's artwork, banner3.png (09-27) is older still,
//   and slide3.png / slide4.png (09-29) are LOTTOPLUS lottery posters — all
//   previous brands' artwork. Importing any of them emits a competitor's picture
//   into dist/ (an eager import IS an emit, rendered or not) and turns
//   verify-build red. There is therefore NO current-drop article illustration
//   this round, and a slide is not substituted for one.
//   banner1.png and banner1-mobile.png belong to MainLayout's own pinned globs
//   and are never referenced from a page. og.png is the same: MainLayout owns it.
// Also deliberately unused (named without the file extension on purpose — the
// playbook's "is this component live?" check is a bare-filename grep, and a
// mention here would read as a render): FeatureHighlights renders sub-points as
// <h3>, and this brief already spends both of its allowed H3s on sections 4 and
// 5, so wiring it in would break the count; ProviderGrid, GameRankingBoard and
// SmoothCarousel have no brief section asking for a provider wall, a ranking
// board or a carousel this round (the brief names no studio, so a provider wall
// would have to invent one); BankStrip already renders inside the active footer;
// and the three-column ContentBox3Three family has nothing to carry — every
// section in this brief is one or two running paragraphs, not a three-way split.
//
// Vocabulary (brand-spec §6): WEPLAY168 is a เล่นสล็อตออโต้ทุกค่าย site and
// nothing else. The words this page may use are the brief's own: เล่นสล็อตออโต้,
// ทุกค่าย, ค่ายหลัก, แพลตฟอร์มเดียว, สล็อตคลาสสิก, เกมโบนัส, ฟรีสปิน, ตัวคูณ,
// เกมรูปแบบใหม่, เบทเริ่มต้น 1 บาท, เบทต่ำ, แตกง่าย, ไม่มีขั้นต่ำ, ตารางจ่าย,
// อัตราการคืนเงินผู้เล่น, ช่วงเดิมพัน, ผลการหมุนสล็อตเป็นแบบสุ่ม, เครดิต,
// บัญชีเดียว, คืนยอดเสีย 0.3%, เข้ายูส, รอบคำนวณ, ยอดที่เข้าเกณฑ์,
// แนะนำเพื่อน 0.8%, แชร์ลิงก์, ฝากถอนเข้าบริษัทโดยตรง, บัญชีปลายทาง, นิติบุคคล,
// ไม่ผ่านม้า / บัญชีม้า, หลักฐานธุรกรรม, แอดมิน 24 ชั่วโมง, PIN, OTP,
// ช่องทางติดต่อหลัก.
// PIGPG's vocabulary is banned and gone (ฐานเข้าเล่นสล็อตเว็บหลัก,
// ศูนย์รวมเกมสล็อตค่ายแท้, ไม่ผ่านเว็บตัวแทน, สมัคร 3 ขั้นตอน, ยืนยันบัญชี,
// เว็บไซต์เลียนแบบ, ถอนยอด 24 ชั่วโมง, รอบตัดยอด), as is every older brand's
// (คาสิโนฐานเข้าหลัก, เว็บพนันฐานเล่นหลัก, ทางเข้าเล่นออนไลน์, ไม่ผ่านเอเย่นต์,
// อัปเกรดระบบ, การันตีเว็บแท้, รีวิวถอนจริง, ถูกลิขสิทธิ์, บาคาร่า, รูเล็ต, ไฮโล,
// โต๊ะสด, คาสิโนไลฟ์, บอล, กีฬา, ตลาดเดิมพัน, หวย, ไฮคลาส, VIP, ส่งตรงจากเว็บแม่,
// ทุนน้อย, ค่ายตรง) — the page is written straight from the brief rather than
// find-and-replaced over the old sentences, and four of those banned phrases were
// in the page this replaces.
// There is NO หวย anywhere on this site this round: it is a slot brand, the word
// appears nowhere, and /ตรวจหวย and /แนวทาง stay parked in src/pages-disabled/.
// Nothing here claims a licence, a regulator, an operator, a studio, a bank, an
// RTP figure, a deposit minimum, a member count or a founding year, because the
// brief names none — it mentions อัตราการคืนเงินผู้เล่น only as something to look
// up inside the game. The only figures are the brief's own: 1 บาท, 0.3%, 0.8%
// and 24 ชั่วโมง.
// The brief's own hedging ships with the copy — it states it four separate times
// (แตกง่าย/ไม่มีขั้นต่ำ ควรพิจารณาจากข้อมูลเกมจริง · ผลการหมุนสล็อตเป็นแบบสุ่ม
// ไม่มีเกมใดรับประกัน · ชื่อบัญชีบริษัทเพียงอย่างเดียวไม่ได้รับประกันความปลอดภัย ·
// คำว่าไม่จำกัดควรตรวจสอบเงื่อนไข) and it is part of the paragraphs, not trimmed
// as downbeat filler.
//
// The brief says WEPLAY168 throughout and so does every piece of artwork in the
// drop and the operator's prompt — no conflict this round. Even so the brand name
// is never typed on the page: it is interpolated from ${BRAND_NAME} so it can
// never drift from brandProfile. No domain is written out anywhere in this file.
//
// Title and description are the brief's own Title/Description lines (minus that
// substitution), used verbatim and NOT padded up to 150: verify-build
// deliberately skips its 150-character floor on the home page for exactly this
// reason.
const pageTitle = `${BRAND_NAME} เล่นสล็อตออโต้ทุกค่าย แตกง่าย ไม่มีขั้นต่ำ ปลอดภัย`;

const pageDescription = `${BRAND_NAME} เล่นสล็อตออโต้ทุกค่าย รวมเกมจากค่ายหลัก เบทเริ่มต้น 1บาท แตกง่าย ไม่มีขั้นต่ำ ฝากถอนเข้า บริษัทโดยตรง ปลอดภัย ไม่ผ่านม้า`;

// The brief has a real H2 -> H3 nesting this round, so the page is NOT flattened
// to H2-only. The two H3s are genuine headings — the two bonus sub-points, both
// nested under section 3's โปรโมชั่น H2 — and they stay H3.
//
// The checklist, in document order, and what carries each one:
//    1 H1  WEPLAY168 เล่นสล็อตออโต้ทุกค่าย รวมเกมจากค่ายหลัก
//          ContentBoxPremium, brief paragraph on line 4
//    2 H2  WEPLAY168 เล่นสล็อตเบทเริ่มต้น 1บาท แตกง่าย ไม่มีขั้นต่ำ
//          ContentBoxNeumorphism, lines 6 + 7 in one wrapping <div>
//    3 H2  โปรโมชั่นเล่นสล็อต WEPLAY168 เครือเว็บหลัก จัดเต็ม
//          ContentBox (the plain, always-live variant), line 9
//    4 H3  โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสทุกวัน
//          ContentBoxSevenThreePremium + slide1 (imgCashback), line 11
//    5 H3  โปรโมชั่น แนะนำเพื่อน รับโบนัสแชร์ลิงก์ 0.8% ไม่จำกัด
//          ContentBoxSevenThreeNeumorphism + slide2 (imgReferral), line 13
//    6 H2  ระบบ WEPLAY168 ฝากถอนเข้าบริษัทโดยตรง ปลอดภัย ไม่ผ่านม้า
//          ContentBoxTwoPremium, line 15 left / line 16 right
//    7 H2  แอดมิน WEPLAY168 ฐานค่ายหลัก เปิดให้บริการ 24 ชั่วโมง
//          ContentBoxTwoNeumorphism, line 18 left / line 19 right
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ WEPLAY168
//          Faq3 + faqs prop, lines 21-26
// Final inventory for this page: h1 x1, h2 x5, h3 x2.
//
// Shape rhythm, top to bottom: gradient glass slab with a violet rail beside the
// heading -> neumorphic plate on the mid surface with a centered gold-to-violet
// heading -> flat glass card with a top hairline and an underline bar -> 3:7
// gradient card in a deep-violet frame with the picture on the LEFT -> 7:3
// neumorphic plate on the deepest surface with a solid gold heading and the
// picture on the RIGHT -> two-column glass card with violet/gold column rails ->
// two-column neumorphic plate on the raised surface -> rounded accordion.
// No shape repeats back to back; the three neumorphic plates are separated by
// surface depth (#17062e mid / #0a0117 deepest / #1e0a3c raised) rather than by
// heading colour alone, the two gradient-glass cards wear different frames
// (violet bright vs violet deep), and every card's heading gradient runs a
// different order of the same four light hues, so no two cards read as the same
// card twice.
//
// ContentBoxSevenThreePremium takes the docx heading through `title`, which
// falls back to its wide (7fr) RIGHT text column; its image column is passed no
// `titleleft`, so the block emits exactly one heading.
// ContentBoxSevenThreeNeumorphism is the mirror: `title` falls back to its wide
// (7fr) LEFT text column and its picture column is passed no `titleright`, so it
// emits exactly one heading too.
//
// Every brief paragraph ships in full — all eleven of them, nothing merged or
// summarised. Sections 2, 6 and 7 have two paragraphs each; section 2 runs both
// down one column inside one <div>, while 6 and 7 run one per column. Sections
// 1, 3, 4 and 5 have one paragraph each. The column labels passed to
// ContentBoxTwoPremium and ContentBoxTwoNeumorphism are this page's own layout
// wording, not brief headings, and both variants render them as <p>.
//
// Everything else on the page is chrome and emits no heading tag at any level:
// Announcement5, LatestWinners4, LoginRtpSection and ReviewCardSumo2 render
// their titles as <p>/<span> with an aria-label on the section, and Faq3's
// questions live inside <summary> as <p>. The non-brief widgets sit before
// section 1 (the ticker, then the winners feed) and after section 8
// (LoginRtpSection, ReviewCardSumo2, Navfoot) — never spliced between two
// content sections.

// One array, used by both <Faq> and the FAQPage node — never the component's own
// defaults (Faq3 deliberately ships none, so a forgotten prop renders an empty
// accordion rather than some previous brand's questions). The three pairs are
// the brief's own Q/A block (content.txt lines 21-26), verbatim.
const faqs = [
  {
    q: `${BRAND_NAME} มีเกมสล็อตเดิมพันเริ่มต้น 1 บาททุกค่ายหรือไม่?`,
    a: `ยอดเดิมพันขั้นต่ำขึ้นอยู่กับเกมสล็อตและค่ายผู้ให้บริการ บางเกมรองรับการเดิมพันเริ่มต้น 1 บาท ขณะที่บางรายการอาจกำหนดยอดขั้นต่ำแตกต่างกัน สมาชิกควรตรวจสอบช่วงเดิมพันที่แสดงภายในเกมก่อนเริ่มเล่นทุกครั้ง`,
  },
  {
    q: `${BRAND_NAME} ฝากถอนเข้าบัญชีบริษัทโดยตรงจริงหรือไม่?`,
    a: `หาก ${BRAND_NAME} ระบุว่าใช้บัญชีบริษัทโดยตรง ควรมีชื่อบัญชีและข้อมูลนิติบุคคลที่สามารถตรวจสอบได้ ก่อนทำรายการควรเปรียบเทียบชื่อบัญชีปลายทางกับข้อมูลจากช่องทางหลัก และไม่ควรถือคำว่าไม่ผ่านบัญชีม้าเป็นการรับประกันความปลอดภัยโดยไม่มีหลักฐานประกอบ`,
  },
  {
    q: `โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ต่างกันอย่างไร?`,
    a: `โบนัส 0.3% เป็นโปรโมชั่นคืนยอดเสียจากยอดที่เข้าเงื่อนไขตามรอบที่กำหนด ส่วนโบนัส 0.8% เป็นกิจกรรมแนะนำเพื่อน โดยคำนวณจากยอดของเพื่อนที่เข้าเกณฑ์ ทั้งสองรายการมีวิธีคำนวณและเงื่อนไขรับสิทธิ์แตกต่างกัน ควรตรวจสอบรายละเอียดล่าสุดก่อนกดรับโบนัส`,
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// One highlight colour only: #fbe455, against the inherited body colour #ece2ff
// (BRAND_TEXT). The paragraphs below carry no colour class of their own: every
// ContentBox* card in this mix already sets
// `text-left text-base leading-relaxed text-[#ece2ff]` on the element holding
// the slot, so the prose inherits it and no page-level override can drift from
// the card. No paragraph carries mx-auto or max-w-* either — the cards cap their
// own width, and the only max-w-* on the page is the one capping each slide,
// which is an image and not prose. One element per slot, everywhere: section 2
// passes a single <div> wrapping its two paragraphs.

// No breadcrumb: this is the homepage, so a trail from the root to itself would
// be a single self-referential crumb. Every URL in the graph is derived by
// pageGraph from `site:` — no domain is typed out in this file, no URL is built
// with `+`, and no Review / AggregateRating / sameAs / address / email node is
// passed. `description` is the exact same string MainLayout gets.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

