---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import LatestWinners from "../components/LatestWinnersPremium.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBox from "../components/ContentBox.astro";
import Faq from "../components/Faq4.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgCashback from "../assets/slide1.png";
import imgReferral from "../assets/slide2.png";

// VARIANT ROTATION THIS ROUND (หวย365 -> NAZA99). Zero file reuse from the
// previous round: AnnouncementPremium replaces Announcement2, LatestWinnersPremium
// replaces LatestWinners4, Faq4 replaces Faq3, ReviewCardSumo2 replaces
// ReviewCardSumo, and the ContentBox shape-mix moves off Neumorphism /
// TwoNeumorphism / CyberCut / SevenThreeCyberCut / SevenThreeNeumorphism /
// TwoCyberCut onto Premium / TwoPremium / FloatingBadge / SevenThreePremium /
// SevenThree (plain) / Special. NavbarPremium and FooterPremium are the layout's
// pair this round (previously NavbarStyle10 / FooterCyber).
// Plain ContentBox is the one deliberate carry-over: terms, privacy, 404 and
// every button page render their body through it by rule and cannot follow a
// rotation, so it is always-live and the orchestrator rethemes it in the shared
// step.
// Every Neumorphism / CyberCut / Huay / Cyber file, Faq3, Announcement2,
// LatestWinners4, ReviewCardSumo, NavbarStyle10 and FooterCyber stay on disk as
// inventory for the next brand — none of them was deleted, and the previous
// brand's copy and colour still inside them is expected drift, not a bug.
//
// <Announcement /> runs bare on purpose: AnnouncementPremium's default message is
// already this brand's copy and every sub-page calls it bare too, so passing an
// override here is exactly how the ticker ends up saying two different things on
// two pages of the same site.
//
// IMAGE ROLES FOR THIS DROP (2026-10-02). Two files are referenced from this page
// and only two, and each pairing is read off the artwork itself:
//   slide1.png — the gold-edged pill under the big gold โปรโมชั่น wordmark reads
//     "คืนยอดเสีย โบนัส 0.3%" and she holds an open right palm forward, so it
//     belongs to docx H3 #4. Imported as imgCashback.
//   slide2.png — the same set, pill reads "แนะนำเพื่อน โบนัส 0.8%" and she points
//     a finger forward with flowers in her hair, so it belongs to docx H3 #5.
//     Imported as imgReferral.
// Both files measure 600x400, so 600 is the top real candidate width — nothing
// above it would be a real pixel — and each picture carries max-w-[600px] so the
// art is never upscaled past its own bitmap. Each slide sits in a
// ContentBoxSevenThree* image+text block, which is that family's hard cap of two
// per rebrand, so there is no third SevenThree anywhere on the site.
// The two blocks mirror each other: SevenThreePremium lays out
// md:grid-cols-[3fr_7fr] so its picture goes in slot="left", and plain
// SevenThree lays out md:grid-cols-[7fr_3fr] so its picture goes in slot="right"
// while the paragraph keeps the wide column. The two pictures therefore alternate
// sides instead of stacking down the same edge, and each `sizes` describes its own
// 3fr column rather than the viewport (Premium: 1280px cap, gap-10, no inner
// padding on the image column -> 338px; plain: 1400px cap, gap-8, md:pl-6 on the
// image column -> 353px).
//
// The alt text was written from THIS drop's artwork (a brown-black ground packed
// with floating gold coins and sweeping gold light, a woman in a white-and-gold
// dress with long gold earrings, the gold NAZA99 wordmark with its circled N, huge
// gold Thai type reading โปรโมชั่น, a black gold-edged pill with the bonus line,
// and a 777 slot reel with coins and chips in the lower right of slide1).
//
// Deliberately NOT imported, and every file still on disk:
//   slide3.png / slide4.png / banner2.png / banner3.png all predate this drop and
//   belong to previous brands — importing any of them would emit a competitor's
//   artwork into dist/, so there is no inline article illustration this round.
//   banner1.png and banner1-mobile.png belong to MainLayout's own pinned globs and
//   are never referenced from a page — the hero is the LCP element, so nothing here
//   gets loading="eager" fetchpriority="high". og.png is the same: MainLayout owns it.
//
// Vocabulary: NAZA99 is a เว็บสล็อตออนไลน์ — สล็อต, ค่ายเกม, เกมโบนัส, ฟรีสปิน, ตัวคูณ,
// วงล้อ, สัญลักษณ์, ปั่น, แตก, อัปเดตเกมใหม่, คืนยอดเสีย 0.3%, แนะนำเพื่อน 0.8%,
// สมัครสมาชิก, Login, แอดมิน 24 ชั่วโมง, PIN, OTP. The three brands before this one
// sold lottery lines; every one of those words (หวย, โพย, ส่งโพย, เลข 2 ตัว / 3 ตัว,
// เลขเด็ด, เลขดัง, งวด, อัตราจ่าย, หวยฮานอย / ลาว / หุ้น, บอล, ค่าน้ำ, ลีก, คาสิโนสด,
// บาคาร่า …) is gone, and the page was rewritten from the brief rather than
// find-and-replaced over the old sentences. Nothing here claims a licence, an
// operator, a bank, a deposit minimum, a member count, a founding year or an RTP
// figure, because the brief names none. The only game names are the three the brief
// itself lists: Mahjong Ways 2, Fortune Tiger, Sweet Bonanza. The only figures are
// the brief's own: 0.3%, 0.8%, 3 เกม, 3 ขั้นตอน, 24 ชั่วโมง. The brief's own hedging
// ships with the copy ("ไม่สามารถใช้รับประกันผลลัพธ์ได้ เนื่องจากเกมสล็อตมีผลลัพธ์แบบสุ่ม",
// "แต่ละรายการอาจกำหนดค่ายเกมและเงื่อนไขแตกต่างกัน จึงควรอ่านรายละเอียดก่อนกดรับ",
// "จำนวนเกมและช่วงเวลาอัปเดตขึ้นอยู่กับค่ายและผู้ให้บริการ") — it is part of the
// paragraphs, not trimmed as downbeat.
//
// Title and description are the brief's own Title/Description lines, used verbatim.
// The description ships at 118 characters, the length the brief wrote it — it is
// not padded up to 150.
const pageTitle = "NAZA99 สล็อตเว็บใหม่ อัปฟีเจอร์การเล่น แตกหนัก ปั่นแตกง่าย";

const pageDescription = "NAZA99 สล็อตเว็บใหม่ รวมค่ายฮิตติดอันดับ อัปฟีเจอร์การเล่นตลอดเดือน แตกหนัก ปั่นแตกง่าย พร้อมโบนัสและโปรโมชั่นจัดเต็ม";

// The brief has a real H2 -> H3 nesting this round, so the page is NOT flattened to
// H2-only. The two H3s are genuine headings — the two promotion sub-points, both
// nested under the โปรโมชั่น H2 — and they stay H3.
//
// The checklist, in document order, and what carries each one:
//    1 H1  NAZA99 สล็อตเว็บใหม่ รวมค่ายฮิตติดอันดับ
//          ContentBoxPremium, brief paragraph on line 4
//    2 H2  NAZA99 อัปฟีเจอร์การเล่น 3เกม แตกหนัก ปั่นแตกง่ายที่สุด
//          ContentBoxTwoPremium, lines 6+7 left / lines 8+9 right
//    3 H2  โปรโมชั่นเล่นสล็อต NAZA99 จัดหนักตลอดทั้งเดือน
//          ContentBoxFloatingBadge, line 11
//    4 H3  คืนยอดเสีย โบนัส 0.3%
//          ContentBoxSevenThreePremium + slide1 (imgCashback), line 13
//    5 H3  แนะนำเพื่อน โบนัส 0.8%
//          ContentBoxSevenThree (plain) + slide2 (imgReferral), line 15
//    6 H2  สมัครเล่นสล็อต NAZA99 ง่ายๆ 3ขั้นตอน
//          ContentBoxSpecial, line 17 left half / line 18 right half
//    7 H2  ติดต่อแอดมิน NAZA99 ผู้ให้บริการได้ 24 ชั่วโมง
//          ContentBox + LINE / สมัครสมาชิก buttons, lines 20+21
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ NAZA99
//          Faq4 + faqs prop, lines 23-28
// Final inventory for this page: h1 x1, h2 x5, h3 x2.
//
// Every brief paragraph ships in full — all eleven of them, nothing merged or
// summarised. Section 2 has FOUR paragraphs and all four ship: two per column,
// each column's pair wrapped in a single `flex flex-col gap-5` div so the slot
// still receives exactly one element. Sections 6 and 7 have two paragraphs each;
// in Special they run one per half, in ContentBox they stack inside one wrapper.
// The column labels passed to ContentBoxTwoPremium are this page's own layout
// wording, not brief headings, and that variant renders them as <p>.
//
// Everything else on the page is chrome and emits no heading tag at any level:
// AnnouncementPremium, LatestWinnersPremium, LoginRtpSection and ReviewCardSumo2
// render their titles as <p>/<span> with an aria-label on the section, and Faq4's
// questions live inside <summary> as <span>. The non-brief widgets sit before
// section 1 (the ticker, then the winners feed) and after section 8
// (LoginRtpSection, ReviewCardSumo2, Navfoot) — never spliced between two content
// sections.

// One array, used by both <Faq> and the FAQPage node — never the component's own
// defaults, which belong to whichever brand shipped last. The three pairs are the
// brief's own Q/A block, verbatim.
const faqs = [
  {
    q: "NAZA99 มีเกมสล็อตอะไรน่าสนใจ?",
    a: "ตัวอย่างเกมที่สามารถเลือกได้ตามค่ายที่ระบบรองรับ ได้แก่ Mahjong Ways 2, Fortune Tiger และ Sweet Bonanza ซึ่งมีจุดเด่นแตกต่างกันทั้งระบบตัวคูณ ฟรีสปิน และรูปแบบการจ่าย ก่อนเล่นควรตรวจสอบว่าเกมดังกล่าวเปิดให้บริการอยู่ในระบบหรือไม่",
  },
  {
    q: "โปรโมชั่น NAZA99 โบนัส 0.3% และ 0.8% ต่างกันอย่างไร?",
    a: "โบนัส 0.3% เป็นโปรโมชั่นคืนยอดเสียจากยอดที่เข้าเงื่อนไข ส่วนโบนัส 0.8% เป็นกิจกรรมแนะนำเพื่อนตามยอดที่กำหนด ควรตรวจสอบรอบคำนวณ เกมที่ร่วมรายการ และเงื่อนไขล่าสุดก่อนกดรับ",
  },
  {
    q: "NAZA99 อัปเดตเกมสล็อตใหม่ตลอดเดือนหรือไม่?",
    a: "จำนวนเกมและช่วงเวลาอัปเดตขึ้นอยู่กับค่ายและผู้ให้บริการ หาก NAZA99 มีการเพิ่มเกมใหม่ระหว่างเดือน สมาชิกสามารถตรวจสอบรายการล่าสุดจากหมวดเกมใหม่หรือประกาศบนเว็บไซต์ได้โดยตรง",
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space that
// splits the word — the copy must read identically with the tags removed. One
// highlight colour only: #fdf2ac, the logo's light champagne gold, against the
// inherited body colour #f3e8cf (BRAND_TEXT). The paragraphs below carry no colour
// class of their own: every ContentBox* card in this mix already sets
// `text-left text-base leading-relaxed text-[#f3e8cf]` on the element holding the
// slot, so the prose inherits it and no page-level override can drift from the card.

// No breadcrumb: this is the homepage, so a trail from the root to itself would be a
// single self-referential crumb. Every URL in the graph is derived by pageGraph from
// `site:` — no domain is typed out in this file, and no Review / AggregateRating /
// sameAs / address node is passed.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <LatestWinners />

  <ContentBoxPremium as="h1" title="NAZA99 สล็อตเว็บใหม่ รวมค่ายฮิตติดอันดับ">
    <p>
      NAZA99
      <strong class="text-[#fdf2ac]">สล็อตเว็บใหม่ที่รวบรวมเกมสล็อตหลายสไตล์จากค่ายยอดนิยมไว้ในระบบเดียว</strong>
      มีทั้งเกมโบนัส ฟรีสปิน ตัวคูณ และฟีเจอร์ใหม่ที่ช่วยเพิ่มรูปแบบการเล่นให้หลากหลาย
      <strong class="text-[#fdf2ac]">รองรับการเข้าใช้งานผ่านมือถือและคอมพิวเตอร์</strong>
      สมาชิกสามารถเลือกเกม ตรวจสอบโปรโมชั่น และติดตามรายการผ่านบัญชีเดียวได้สะดวก พร้อมอัปเดตเกมตามรายการที่ผู้ให้บริการเปิดให้ใช้งานในแต่ละช่วง
    </p>
  </ContentBoxPremium>

  <ContentBoxTwoPremium as="h2" title="NAZA99 อัปฟีเจอร์การเล่น 3เกม แตกหนัก ปั่นแตกง่ายที่สุด" titleleft="3 เกมแนะนำประจำหมวด" titleright="ฟีเจอร์และข้อควรทราบ">
    <div slot="left" class="flex flex-col gap-5">
      <p>
        NAZA99 มีเกมสล็อตหลายรูปแบบให้เลือก โดย
        <strong class="text-[#fdf2ac]">3 เกมที่เหมาะสำหรับนำมาจัดหมวดแนะนำ ได้แก่ Mahjong Ways 2, Fortune Tiger และ Sweet Bonanza</strong>
        ซึ่งมีฟีเจอร์และรูปแบบการเล่นแตกต่างกัน ช่วยให้สมาชิกเลือกเกมได้ตามสไตล์ที่สนใจ ไม่ว่าจะเน้นตัวคูณ ฟรีสปิน หรือรูปแบบการจ่ายที่มีจังหวะโบนัสระหว่างเกม
      </p>
      <p>
        Mahjong Ways 2 มาในธีมไพ่นกกระจอก
        <strong class="text-[#fdf2ac]">จุดเด่นอยู่ที่ระบบตัวคูณและฟีเจอร์ฟรีสปิน</strong>
        ทำให้รูปแบบของแต่ละรอบมีรายละเอียดให้ติดตามมากกว่าเกมสล็อตพื้นฐาน เหมาะสำหรับผู้ที่ชอบสล็อตธีมเอเชียและระบบโบนัสหลายจังหวะ
      </p>
    </div>
    <div slot="right" class="flex flex-col gap-5">
      <p>
        Fortune Tiger
        <strong class="text-[#fdf2ac]">ใช้ธีมเสือนำโชคและรูปแบบวงล้อที่เข้าใจง่าย</strong>
        มีฟีเจอร์ภายในเกมที่ช่วยเพิ่มจังหวะการเล่น ส่วน Sweet Bonanza มาในธีมขนมและผลไม้
        <strong class="text-[#fdf2ac]">ใช้ระบบจ่ายแบบกลุ่มสัญลักษณ์ พร้อมฟรีสปินและตัวคูณเป็นองค์ประกอบหลัก</strong>
      </p>
      <p>
        คำว่า “แตกหนัก” หรือ “ปั่นแตกง่ายที่สุด”
        <strong class="text-[#fdf2ac]">ไม่สามารถใช้รับประกันผลลัพธ์ได้ เนื่องจากเกมสล็อตมีผลลัพธ์แบบสุ่ม</strong>
        สมาชิกควรตรวจสอบกติกา ช่วงเดิมพัน และรายละเอียดฟีเจอร์ของแต่ละเกมก่อนเริ่มเล่น
      </p>
    </div>
  </ContentBoxTwoPremium>

  <ContentBoxFloatingBadge as="h2" title="โปรโมชั่นเล่นสล็อต NAZA99 จัดหนักตลอดทั้งเดือน">
    <p>
      โปรโมชั่น NAZA99
      <strong class="text-[#fdf2ac]">มีสิทธิ์สำหรับสมาชิกให้เลือกตามแคมเปญที่เปิดในแต่ละเดือน ทั้งโบนัสคืนยอดเสียและกิจกรรมแนะนำเพื่อน</strong>
      สามารถ Login เพื่อตรวจสอบยอดที่เข้าเกณฑ์ รอบคำนวณ และจำนวนโบนัสจากบัญชีสมาชิกได้โดยตรง
      <strong class="text-[#fdf2ac]">แต่ละรายการอาจกำหนดค่ายเกมและเงื่อนไขแตกต่างกัน จึงควรอ่านรายละเอียดก่อนกดรับ</strong>
    </p>
  </ContentBoxFloatingBadge>

  <ContentBoxSevenThreePremium as="h3" title="คืนยอดเสีย โบนัส 0.3%">
    <Picture
      slot="left"
      src={imgCashback}
      loading="lazy"
      fetchpriority="low"
      widths={[338, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), (max-width: 1279px) calc(30vw - 46px), 338px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="ภาพโปสเตอร์โปรโมชั่นของ NAZA99 พื้นหลังสีดำอมน้ำตาลมีเหรียญทองลอยเต็มภาพและริ้วแสงสีทองพาดเป็นวงรอบ ด้านซ้ายเป็นหญิงสาวผมยาวสวมชุดสีขาวประดับทอง สวมต่างหูทองเส้นยาว แบมือขวาหงายขึ้นมาข้างหน้า มุมบนขวาเป็นโลโก้ NAZA99 สีทองพร้อมสัญลักษณ์ตัว N ในวงกลม ถัดลงมาเป็นตัวอักษรไทยสีทองขนาดใหญ่มีเงาว่า โปรโมชั่น และใต้ลงมาเป็นป้ายสีดำขอบทองคาดข้อความ คืนยอดเสีย โบนัส 0.3% มุมล่างขวาเป็นวงล้อสล็อตเลข 777 วางอยู่กับกองเหรียญทองและชิป"
      class="mx-auto h-auto w-full max-w-[600px] rounded-2xl border border-[#e4b34d]/60 shadow-[0_10px_30px_rgba(228,179,77,0.30)]"
    />
    <p slot="right">
      สมาชิกที่มียอดเสียตรงตามเงื่อนไข
      <strong class="text-[#fdf2ac]">สามารถตรวจสอบสิทธิ์รับโบนัสคืนยอดเสีย 0.3% ตามรอบที่ NAZA99 กำหนด</strong>
      ระบบจะคำนวณจากยอดที่เข้าเกณฑ์และแสดงจำนวนโบนัสที่สามารถรับได้
      <strong class="text-[#fdf2ac]">ควรตรวจสอบรอบตัดยอด เกมที่ร่วมรายการ และเงื่อนไขการใช้โบนัสก่อนรับสิทธิ์ทุกครั้ง</strong>
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBoxSevenThree as="h3" title="แนะนำเพื่อน โบนัส 0.8%">
    <p slot="left">
      สมาชิกสามารถ
      <strong class="text-[#fdf2ac]">แชร์ลิงก์แนะนำ NAZA99 ให้เพื่อน</strong>
      เมื่อเพื่อนสมัครและมียอดใช้งานตรงตามข้อกำหนด
      <strong class="text-[#fdf2ac]">ระบบจะคำนวณโบนัสแนะนำเพื่อน 0.8% จากยอดที่เข้าเกณฑ์</strong>
