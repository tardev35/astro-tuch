---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ProviderGridPremium from "../components/ProviderGridPremium.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import LatestWinners from "../components/LatestWinners4.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import Faq from "../components/Faq3.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// SLIDE ROLES FOR FAH999 — READ BEFORE REUSING THESE IMPORTS.
// Checked against the 2026-09-21 drop by opening both posters: slide2.png reads
// "โปรโมชั่น คืนยอดเสีย 0.3%" so it belongs to docx H3 #4, and slide1.png reads
// "โปรโมชั่นแนะนำเพื่อน 0.8%" so it belongs to docx H3 #5. That is the REVERSE of
// the order the previous brand's index used — the pairing is not stable across
// brands, so re-open the posters next rebrand rather than copying this forward.
// Both posters are black + gold; any alt text describing a red background is
// left over from an earlier brand's artwork.
//
// slide3.png (2026-09-18) and slide4.png (2026-08-13) are deliberately NOT
// imported: both predate this drop and print a PREVIOUS brand's name in large
// type on the artwork itself. Nothing else on this page carries an image —
//   banner1 / banner1-mobile  = MainLayout's own pinned globs. A page never
//                               references them, and nothing here gets
//                               loading="eager" fetchpriority="high" — the hero
//                               is the LCP element and it belongs to the layout.
//   banner2.png (2026-08-20) and banner3.png (2026-08-11) predate the
//   2026-09-21 asset drop -> stale inventory from earlier clients, must stay
//   unimported. With no current banner2/3/4 there are no single-column
//   ContentBox inline illustrations this round.
// A slide may only ever live inside a ContentBoxSevenThree*; two of them is the
// family's hard cap per rebrand and this page uses exactly two, which is the
// whole budget for this rebrand.
//
// Dropped from the previous brand's index and NOT deleted from disk (they are
// inventory for the next brand): AnnouncementPremium, ContentBoxFloatingBadge,
// ContentBoxSevenThreeCyberCut, ContentBoxSevenThreeNeumorphism,
// ContentBoxSpecial, ProviderGrid, LatestWinners2 and Faq4 — that whole mix went
// out with the outgoing brand and none of it may be reused this round.

// The artwork in this drop prints a different wordmark than the operator's
// instruction. The operator's instruction wins: every brand string on this page
// is FAH999, and no alt transcribes the literal wordmark off the poster.

// Title and description are the brief's own Title/Meta Description lines, used
// verbatim. A brief-supplied description is never padded up to the 150-char
// floor and never topped up from the H1/H2.
const pageTitle = "FAH999 สมัครสล็อตยูสใหม่ ไม่ล็อค โบนัสฝากแรก ไม่อั้น";

const pageDescription =
  "FAH999 สมัครสล็อตยูสใหม่ รับสิทธิพิเศษเพียบ ไม่ล็อคยูส ฝากถอนไม่จำกัด ได้โบนัสฝากแรก ทั้งวอลเลทและธนาคาร เดิมพันไม่อั้น ไม่จำกัดยอดเดิมพัน";

// <Announcement /> runs bare: Announcement5's default message is already this
// brand's copy, and every sub-page calls it bare too — passing an override here
// is how the ticker ends up saying two different things on two pages.

// The docx has a real H1 -> H2 -> H3 hierarchy this round: #4 and #5 are genuine
// H3 sub-points of H2 #3, so the page is NOT flattened to H2-only. They are the
// only <h3> on the site and they are carried by the two SevenThree blocks.
// Everything else on the page is chrome — ProviderGridPremium, LatestWinners4,
// LoginRtpSection and ReviewCardSumo2 all render their titles as <p>/<span> with
// an aria-label on the section, and Faq3's questions stay <p> inside <summary>,
// so none of them emits a heading.
// Final inventory for this page: h1 x1, h2 x5, h3 x2.

// One array, used by both <Faq> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last. The three pairs
// are the brief's L17-L22, verbatim with the brand name substituted.
const faqs = [
  {
    q: "สมัคร FAH999 ยูสใหม่ได้รับโบนัสฝากแรกหรือไม่?",
    a: "ยูสใหม่สามารถตรวจสอบสิทธิ์โบนัสฝากแรกได้จากหน้าโปรโมชั่น โดยรายละเอียดของโบนัส ยอดที่เข้าเกณฑ์ และเงื่อนไขการรับอาจแตกต่างกันตามรายการที่เปิดให้ใช้งานในช่วงนั้น",
  },
  {
    q: "FAH999 มีการล็อคยูสหรือจำกัดการเข้าเล่นหรือไม่?",
    a: "ตามข้อมูลที่กำหนด จุดเด่นของระบบคือการใช้งานแบบไม่ล็อคยูส สมาชิกสามารถเลือกเกมและค่ายที่ต้องการได้ตามรายการที่รองรับ โดยควรตรวจสอบเงื่อนไขของแต่ละเกมก่อนเข้าเล่น",
  },
  {
    q: "FAH999 รองรับธนาคารและวอลเลทหรือไม่?",
    a: "ระบบรองรับช่องทางธนาคารและวอลเลทตามรายการที่เปิดให้ใช้งาน สมาชิกสามารถตรวจสอบช่องทางที่รองรับ รวมถึงสถานะฝากถอนและรายละเอียดของบัญชีได้จากหน้าเว็บไซต์โดยตรง",
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// The highlight colour is the palette's highlight gold (#f7e7a8); it marks a
// claim the brief states outright and nothing else.

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb. Every URL in the graph is derived
// by pageGraph from `site:` — no domain is typed out in this file.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxCyberCut as="h1" title="FAH999 สมัครสล็อตยูสใหม่ ไม่ล็อค รับโบนัสฝากแรก ไม่อั้น">
    <p class="text-left text-base leading-relaxed text-[#e7dcc4]">
      <strong class="text-[#f7e7a8]">FAH999 เปิดรับสมาชิกใหม่ที่ต้องการเริ่มเล่นสล็อตผ่านระบบที่ใช้งานง่าย ไม่ล็อคยูส</strong>
      <strong class="text-[#f7e7a8]">พร้อมสิทธิ์โบนัสฝากแรกตามเงื่อนไขที่กำหนด</strong>
      รองรับทั้งมือถือและคอมพิวเตอร์ มีเกมจากหลายค่ายให้เลือก พร้อมระบบบัญชีที่จัดการได้สะดวก เหมาะกับยูสใหม่ที่ต้องการเริ่มต้นโดยไม่จำกัดรูปแบบการเล่นมากเกินไป
    </p>
  </ContentBoxCyberCut>

  <ContentBoxTwoPremium as="h2" title="สล็อต FAH999 รับสิทธิพิเศษเฉพาะสมาชิก ไม่มีล็อคยูส">
    <p slot="left" class="text-left text-base leading-relaxed text-[#e7dcc4]">
      สล็อต FAH999
      <strong class="text-[#f7e7a8]">มีสิทธิพิเศษสำหรับสมาชิกทั้งยูสใหม่และยูสเดิม โดยเน้นการใช้งานแบบไม่มีล็อคยูส</strong>
      สามารถเลือกเกมจากหลายค่ายและตรวจสอบเงื่อนไขก่อนเข้าเล่นได้จากหน้าเดียว
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#e7dcc4]">
      <strong class="text-[#f7e7a8]">ระบบจัดหมวดเกมชัดเจน</strong>
      ช่วยให้ค้นหาเกมที่ต้องการได้ง่าย
      <strong class="text-[#f7e7a8]">พร้อมตัวเลือกการเดิมพันที่หลากหลายตามแต่ละเกม</strong>
    </p>
  </ContentBoxTwoPremium>

  <ProviderGridPremium />

  <ContentBox as="h2" title="โปรโมชั่นสล็อต FAH999 รับได้ทุกฝากไม่จำกัด">
    <p class="text-left text-base leading-relaxed text-[#e7dcc4]">
      โปรโมชั่นสล็อต FAH999 มีสิทธิ์ให้เลือกหลายรูปแบบตามเงื่อนไขของระบบ
      <strong class="text-[#f7e7a8]">ทั้งโบนัสคืนยอดเสียและโบนัสแนะนำเพื่อน</strong>
      <strong class="text-[#f7e7a8]">สมาชิกสามารถตรวจสอบรายละเอียดก่อนกดรับได้จากหน้าโปรโมชั่น</strong>
      เพื่อดูยอดที่เข้าเกณฑ์ รอบรับสิทธิ์ และเงื่อนไขของแต่ละรายการก่อนนำไปใช้งาน
    </p>
  </ContentBox>

  <ContentBoxSevenThreePremium as="h3" title="คืนยอดเสีย โบนัส 0.3%">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[260, 400, 700]}
      sizes="(max-width: 767px) 92vw, 346px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นคืนยอดเสียของ FAH999 พื้นหลังสีดำตัดทอง ด้านซ้ายเป็นผู้หญิงผมยาวสีเข้มสวมชุดสีดำสลับทอง ด้านบนเป็นตราสัญลักษณ์มงกุฎทองของ FAH999 ใต้ลงมาเป็นข้อความว่า โปรโมชั่น คืนยอดเสีย และตัวเลข 0.3% ขนาดใหญ่สีทอง รอบข้างมีเหรียญทองและชิปโป๊กเกอร์สีดำขอบทอง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#e8c25a]/55 shadow-[0_10px_30px_rgba(232,194,90,0.28)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#e7dcc4]">
      สมาชิก FAH999
      <strong class="text-[#f7e7a8]">สามารถรับโบนัสคืนยอดเสีย 0.3% ตามยอดและเงื่อนไขที่กำหนด</strong>
      โดยระบบจะแสดงรายละเอียดของรอบคำนวณและยอดที่เข้าเกณฑ์ให้ตรวจสอบก่อนรับสิทธิ์ ช่วยให้ติดตามโบนัสของตัวเองได้ง่ายขึ้น
      <strong class="text-[#f7e7a8]">และสามารถวางแผนการใช้เครดิตในแต่ละรอบได้อย่างชัดเจน</strong>
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBoxSevenThree as="h3" title="แนะนำเพื่อน โบนัส 0.8%">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[280, 420, 760]}
      sizes="(max-width: 767px) 92vw, 380px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อนของ FAH999 พื้นหลังสีดำตัดทอง ด้านซ้ายเป็นผู้หญิงผมยาวสีเข้มสวมชุดสีดำสลับทอง ด้านบนเป็นตราสัญลักษณ์มงกุฎทองของ FAH999 ใต้ลงมาเป็นข้อความว่า โปรโมชั่นแนะนำเพื่อน และตัวเลข 0.8% ขนาดใหญ่สีทอง ด้านขวามีไพ่โพดำกับเหรียญทองและชิปโป๊กเกอร์ มุมขวาบนมีข้อความว่า PLAY BIGGER TOGETHER และด้านล่างมีข้อความว่า MORE FRIENDS MORE WINS"
      class="mx-auto h-auto w-full rounded-2xl border border-[#f7e7a8]/50 shadow-[0_10px_30px_rgba(247,231,168,0.22)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#e7dcc4]">
      โปรโมชั่นแนะนำเพื่อนของ FAH999
      <strong class="text-[#f7e7a8]">ให้โบนัส 0.8% ตามเงื่อนไขของกิจกรรม</strong>
      สมาชิกสามารถชวนคนรู้จักเข้ามาสมัครผ่านช่องทางที่ระบบรองรับ
      <strong class="text-[#f7e7a8]">พร้อมตรวจสอบยอดสิทธิ์และรายละเอียดของโบนัสได้จากบัญชีสมาชิก</strong>
      ช่วยให้ติดตามผลของการแนะนำเพื่อนได้สะดวกมากขึ้น
    </p>
  </ContentBoxSevenThree>

  <ContentBoxNeumorphism as="h2" title="FAH999 รับทุกธนาคารและวอลเลท ฝากถอนไม่จำกัด">
    <p class="text-left text-base leading-relaxed text-[#e7dcc4]">
      ระบบ FAH999
      <strong class="text-[#f7e7a8]">รองรับช่องทางธนาคารและวอลเลทตามรายการที่เว็บไซต์เปิดให้ใช้งาน</strong>
      สมาชิกสามารถเลือกช่องทางที่เหมาะกับตัวเอง
      <strong class="text-[#f7e7a8]">พร้อมตรวจสอบยอดและสถานะฝากถอนจากบัญชีได้โดยตรง</strong>
      ขั้นตอนถูกจัดให้เข้าใจง่าย และรองรับการทำรายการตามวงเงินและเงื่อนไขที่ระบบกำหนด
    </p>
  </ContentBoxNeumorphism>

  <LatestWinners />

  <ContentBoxPremium as="h2" title="ติดต่อแอดมิน FAH999 พร้อมให้บริการ 24 ชั่วโมง">
    <p class="text-left text-base leading-relaxed text-[#e7dcc4]">
      หากมีข้อสงสัยเกี่ยวกับการสมัคร โบนัสฝากแรก โปรโมชั่น การเข้าเกม หรือระบบฝากถอน
      <strong class="text-[#f7e7a8]">สามารถติดต่อแอดมิน FAH999 ได้ตลอด 24 ชั่วโมง</strong>
      ทีมงานพร้อมช่วยตรวจสอบข้อมูลและแนะนำขั้นตอนใช้งานตามปัญหาที่แจ้ง
      <strong class="text-[#f7e7a8]">ช่วยให้ทั้งสมาชิกใหม่และสมาชิกเดิมเข้าถึงข้อมูลได้สะดวกทุกช่วงเวลา</strong>
    </p>
  </ContentBoxPremium>

  <Faq as="h2" title="คำถามที่พบบ่อย" faqs={faqs} />

  <LoginRtpSection />

  <ReviewCardSumo />

  <Navfoot />
</MainLayout>
