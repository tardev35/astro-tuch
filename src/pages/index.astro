---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ContentBoxHuay from "../components/ContentBoxHuay.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import LottoGrid from "../components/LottoGrid.astro";
import ContentBoxSevenThreeHuay from "../components/ContentBoxSevenThreeHuay.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxTwoHuay from "../components/ContentBoxTwoHuay.astro";
import LatestWinners from "../components/LatestWinners4.astro";
import ContentBox from "../components/ContentBox.astro";
import Faq from "../components/Faq3.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgBanner2 from "../assets/banner2.png";
import imgSlide1 from "../assets/slide1.png";

// IMAGE ROLES FOR THIS DROP (2026-09-22) — READ BEFORE REUSING THESE IMPORTS.
// Two files are referenced from this page and only two:
//   banner2.png (1254x1254) — the square navy poster with the four flag badges
//     รัฐบาลไทย / ลาว / ฮานอย / หวยหุ้น. It is a single-column ContentBox inline
//     illustration, width-capped at max-w-2xl, never a hero and never a
//     SevenThree column.
//   slide1.png (600x200) — the only usable slide in this drop. It prints
//     "อัตราจ่ายหวย 2 ตัว 100 / 3 ตัวจ่าย 1,000", so it belongs to docx H2 #3
//     (อัตราจ่าย) and lives in the page's ONE ContentBoxSevenThree* block.
//     Two of those is the family's hard cap per rebrand; this page spends one.
//
// Deliberately NOT imported, and all still on disk as inventory:
//   banner3.png (2026-08-11, HSOD red), slide2.png (2026-09-21, HENG35 black +
//   gold), slide3.png (2026-09-18, ENTER55), slide4.png (2026-08-13) — every one
//   predates this drop and carries a previous client's artwork.
//   banner1.png and banner1-mobile.png belong to MainLayout's own pinned globs
//   and are never referenced from a page — the hero is the LCP element, so
//   nothing here gets loading="eager" fetchpriority="high".
//
// Rotated out of this round's mix and NOT deleted from disk (they are inventory
// for the next brand): AnnouncementPremium, ContentBoxPremium,
// ContentBoxTwoPremium, ContentBoxCyberCut, ContentBoxSevenThreePremium,
// ContentBoxSevenThree, ProviderGridPremium, LatestWinners3 and Faq4.

// Title and description are the brief's own Title/Description lines, used
// verbatim. A brief-supplied description is never padded up to the 150-char
// floor and never topped up from the H1/H2.
const pageTitle = "หวยพยัคฆ์ แทงหวย อันดับ1 รัฐบาลไทย ฮานอย ลาวพัฒนา จ่ายเต็ม";

const pageDescription = "หวยพยัคฆ์ แทงหวย อันดับ1 เปิดรับ รัฐบาลไทย ฮานอย ลาวพัฒนา หวยหุ้นต่างประเทศ รับทุกเลข จ่ายเต็ม ไม่อั้นเลข";

// <Announcement /> runs bare: AnnouncementHuay's default message is already this
// brand's copy, and every sub-page calls it bare too — passing an override here
// is how the ticker ends up saying two different things on two pages.

// The docx has a real H1 -> H2 -> H3 hierarchy this round: "2 ตัวจ่าย 100" and
// "3 ตัวจ่าย 1,000" are genuine H3 sub-points of the H2 อัตราจ่าย section, so the
// page is NOT flattened to H2-only. They are the only <h3> here and they are
// carried by ContentBoxSpecial and ContentBoxNeumorphism. Everything else is
// chrome — LottoGrid, LatestWinners4, LoginRtpSection and ReviewCardSumo2 all
// render their titles as <p>/<span> with an aria-label on the section, and
// Faq3's questions stay <p> inside <summary>, so none of them emits a heading.
// Final inventory for this page: h1 x1, h2 x5, h3 x2.

// One array, used by both <Faq> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last. The three pairs
// are the brief's own Q/A block, verbatim.
const faqs = [
  {
    q: "หวยพยัคฆ์ มีหวยประเภทไหนให้เลือกบ้าง?",
    a: "ภายในระบบมีทั้งรัฐบาลไทย หวยฮานอย ลาวพัฒนา และหวยหุ้นต่างประเทศ โดยรายการที่เปิดรับอาจแตกต่างกันตามวันและช่วงเวลา สามารถตรวจสอบรอบล่าสุดได้จากหน้ารวมหวยก่อนทำรายการ",
  },
  {
    q: "หวยพยัคฆ์ เลข 2 ตัวและ 3 ตัวจ่ายเท่าไร?",
    a: "ตามข้อมูลที่กำหนด เลข 2 ตัวมีอัตราจ่าย 100 และเลข 3 ตัวมีอัตราจ่าย 1,000 โดยควรตรวจสอบเงื่อนไขและรายละเอียดของแต่ละรอบก่อนยืนยันรายการทุกครั้ง",
  },
  {
    q: "สมัครหวยพยัคฆ์ ต้องทำอย่างไร?",
    a: "เริ่มจากกรอกข้อมูลในหน้าสมัคร ตรวจสอบรายละเอียดให้ถูกต้อง แล้วกดยืนยันบัญชี เมื่อสมัครเสร็จสามารถเข้าสู่ระบบเพื่อเลือกรายการหวย รอบที่เปิดรับ และเลขที่ต้องการได้จากหน้าเว็บไซต์",
  },
];

// The brief's own three registration steps, verbatim, in its own order.
const registerSteps = [
  "เปิดหน้าสมัครหวยพยัคฆ์ แล้วกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน",
  "ตรวจสอบข้อมูลส่วนตัวและรายละเอียดบัญชีให้ถูกต้องก่อนกดยืนยัน",
  "ยืนยันการสมัครและเข้าสู่ระบบ จากนั้นเลือกรัฐบาลไทย ฮานอย ลาวพัฒนา หรือรายการอื่นที่ต้องการได้ทันที",
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// The highlight colour is the palette's primary gold (#fadb6c); it marks a
// claim the brief states outright and nothing else.

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb. Every URL in the graph is derived
// by pageGraph from `site:` — no domain is typed out in this file.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxHuay as="h1" title="หวยพยัคฆ์ แทงหวย อันดับ1 รัฐบาลไทย ฮานอย ลาวพัฒนา ครบทุกประเภท">
    <p class="text-left text-base leading-relaxed text-[#dbe4f7]">
      หวยพยัคฆ์
      <strong class="text-[#fadb6c]">รวมรายการแทงหวยหลายประเภทไว้ในระบบเดียว</strong>
      <strong class="text-[#fadb6c]">ทั้งรัฐบาลไทย ฮานอย ลาวพัฒนา และหวยหุ้นต่างประเทศ</strong>
      ผู้ใช้งานสามารถเลือกดูรอบที่เปิดรับ ตรวจสอบเลขที่ต้องการ และจัดการรายการได้จากหน้าเดียว เหมาะกับคนที่ต้องการติดตามหวยหลายประเภทโดยไม่ต้องสลับหลายเว็บไซต์
    </p>
  </ContentBoxHuay>

  <ContentBoxFloatingBadge as="h2" title="หวยพยัคฆ์ แทงหวย อันดับ1 เปิดรับทุกเลขเด็ด เลขดัง ไม่อั้นเลข จ่ายเต็ม">
    <div class="flex flex-col gap-6">
      <p class="text-left text-base leading-relaxed text-[#dbe4f7]">
        หวยพยัคฆ์
        <strong class="text-[#fadb6c]">เปิดให้เลือกเลขเด็ดและเลขดังจากหลายรายการตามรอบที่ระบบกำหนด</strong>
        สามารถตรวจสอบเลขที่เปิดรับ ประเภทการแทง และรายละเอียดก่อนยืนยันได้ทุกครั้ง
        <strong class="text-[#fadb6c]">พร้อมรองรับรายการจากหลายตลาด</strong>
        ช่วยให้ผู้ใช้งานเลือกเลขและติดตามรอบที่สนใจได้สะดวกมากขึ้น
      </p>
      <Picture
        src={imgBanner2}
        loading="lazy"
        fetchpriority="low"
        widths={[336, 672, 1254]}
        sizes="(max-width: 767px) calc(100vw - 96px), 672px"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
        alt="โปสเตอร์สี่เหลี่ยมจัตุรัสพื้นน้ำเงินกรมท่าของหวยพยัคฆ์ ด้านซ้ายเป็นผู้หญิงผมยาวสวมชุดคลุมสีขาวประดับเครื่องประดับทอง ด้านขวาเป็นคำว่า หวย สีเงินวางทับคำว่า พยัคฆ์ สีทอง ถัดลงมาเป็นคำว่า รวม สีทองคู่กับคำว่า หวย สีเงินที่มีมงกุฎอยู่ด้านบน ใต้ลงมาเป็นแคปซูลข้อความว่า รัฐบาลไทย ลาว ฮานอย หวยหุ้น และตราธงกลมสี่วงกำกับชื่อ รัฐบาลไทย ลาว ฮานอย หวยหุ้น ด้านล่างเป็นลูกบอลหวยสีน้ำเงินสลับขาวหมายเลข 3 6 และ 9 วางคู่กับใบสลากและเหรียญทอง พร้อมข้อความว่า แทงง่าย ปลอดภัย 100% จ่ายจริง ไม่มีอั้น และ อัตราจ่ายสูง มั่นคง เชื่อถือได้"
        class="mx-auto h-auto w-full max-w-2xl rounded-2xl border border-[#ab6d13]/55 shadow-[0_10px_30px_rgba(250,219,108,0.26)]"
      />
    </div>
  </ContentBoxFloatingBadge>

  <LottoGrid />

  <ContentBoxSevenThreeHuay as="h2" titleright="อัตราจ่าย หวยพยัคฆ์ ให้ยอดสูงที่สุด ในวงการหวยออนไลน์">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), 377px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์แนวนอนพื้นน้ำเงินกรมท่าของหวยพยัคฆ์ ด้านซ้ายเป็นผู้หญิงผมยาวสวมชุดขาวสลับน้ำเงินขลิบทอง ตรงกลางเป็นคำว่า หวย สีเงินวางทับคำว่า พยัคฆ์ สีทอง ถัดมาเป็นข้อความว่า อัตราจ่ายหวย และตัวเลขขนาดใหญ่สีทองสลับขาวว่า 2 ตัว 100 และ 3 ตัวจ่าย 1,000 ใต้ลงมาเป็นข้อความว่า จ่ายจริง เล่นง่าย มั่นใจได้ รอบข้างมีลูกบอลหวยสีทองหมายเลข 5 6 8 และ 9 ส่วนด้านขวาเป็นเงาหัวเสือสีทอง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#ab6d13]/55 shadow-[0_10px_30px_rgba(250,219,108,0.26)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#dbe4f7]">
      หวยพยัคฆ์
      <strong class="text-[#fadb6c]">แสดงอัตราจ่ายของแต่ละประเภทเลขไว้อย่างชัดเจนก่อนยืนยันรายการ</strong>
      <strong class="text-[#fadb6c]">ทั้งเลข 2 ตัวและเลข 3 ตัว</strong>
      ผู้ใช้งานสามารถตรวจสอบอัตรา รอบหวย และประเภทบิลได้จากหน้าเดียว ช่วยให้เปรียบเทียบรายละเอียดและเลือกวิธีแทงที่เหมาะกับเลขที่ต้องการได้ง่ายขึ้น
    </p>
  </ContentBoxSevenThreeHuay>

  <ContentBoxSpecial as="h3" title="2 ตัวจ่าย 100" iconleft="2️⃣" iconright="🧾">
    <p slot="left" class="min-w-0 flex-1 text-left text-base leading-relaxed text-[#dbe4f7]">
      <strong class="text-[#fadb6c]">เลข 2 ตัวของหวยพยัคฆ์ระบุอัตราจ่ายไว้ที่ 100</strong>
      ตามเงื่อนไขของแต่ละรายการ
    </p>
    <p slot="right" class="min-w-0 flex-1 text-left text-base leading-relaxed text-[#dbe4f7]">
      ผู้ใช้งานสามารถเลือกเลขที่ต้องการ ตรวจสอบรอบเปิดรับ และเช็กรายละเอียดของบิลก่อนยืนยัน ช่วยให้จัดการเลขที่ติดตามได้เป็นขั้นตอนและลดความผิดพลาดก่อนส่งรายการ
    </p>
  </ContentBoxSpecial>

  <ContentBoxNeumorphism as="h3" title="3 ตัวจ่าย 1,000">
    <p class="text-left text-base leading-relaxed text-[#dbe4f7]">
      สำหรับเลข 3 ตัว
      <strong class="text-[#fadb6c]">หวยพยัคฆ์ระบุอัตราจ่ายไว้ที่ 1,000 ตามเงื่อนไขของระบบ</strong>
      ก่อนยืนยันสามารถตรวจสอบเลข ประเภทหวย รอบเวลา และรายละเอียดของรายการได้อีกครั้ง เหมาะกับผู้ที่มีชุดเลข 3 ตัวและต้องการดูข้อมูลให้ครบก่อนส่งบิล
    </p>
  </ContentBoxNeumorphism>

  <ContentBoxTwoHuay as="h2" titleleft="สมัครแทงหวย หวยพยัคฆ์ ได้ใน 3 ขั้นตอน" iconleft="📝">
    <p slot="left" class="text-left text-base leading-relaxed text-[#dbe4f7]">
      <strong class="text-[#fadb6c]">การสมัครหวยพยัคฆ์สามารถทำผ่านหน้าเว็บไซต์ได้ด้วยตัวเอง</strong>
      ขั้นตอนไม่ซับซ้อน และหลังยืนยันบัญชีเรียบร้อยสามารถเข้าสู่ระบบเพื่อดูรายการหวยที่เปิดรับได้ทันที โดยมี 3 ขั้นตอนหลักดังนี้
    </p>
    <ol slot="right" class="list-decimal space-y-3 pl-6 text-left text-base leading-relaxed text-[#dbe4f7] marker:font-black marker:text-[#fadb6c]">
      {registerSteps.map((step) => <li>{step}</li>)}
    </ol>
  </ContentBoxTwoHuay>

  <LatestWinners />

  <ContentBox as="h2" title="แอดมิน หวยพยัคฆ์ ออนไลน์ 24 ชั่วโมง ติดต่อได้ทันที">
    <p class="text-left text-base leading-relaxed text-[#dbe4f7]">
      หากมีข้อสงสัยเกี่ยวกับการสมัคร รอบหวย อัตราจ่าย วิธีเลือกเลข หรือการใช้งานเมนูภายในเว็บไซต์
      <strong class="text-[#fadb6c]">สามารถติดต่อแอดมินหวยพยัคฆ์ได้ตลอด 24 ชั่วโมง</strong>
      <strong class="text-[#fadb6c]">ทีมงานพร้อมช่วยให้ข้อมูลและตรวจสอบปัญหาตามรายละเอียดที่แจ้ง</strong>
      เพื่อให้ทั้งสมาชิกใหม่และสมาชิกเดิมใช้งานระบบได้สะดวกขึ้น
    </p>
  </ContentBox>

  <Faq as="h2" title="คำถามที่พบบ่อย" faqs={faqs} />

  <LoginRtpSection />

  <ReviewCardSumo />

  <Navfoot />
</MainLayout>
