---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import LatestWinners from "../components/LatestWinners2.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import Faq from "../components/Faq4.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import { pageGraph } from "../lib/schema";
import imgReview from "../assets/banner2.png";
import imgCashback from "../assets/slide2.png";
import imgReferral from "../assets/slide1.png";

// VARIANT ROTATION THIS ROUND (789BETTING -> แตกดี168), per brand-spec §3. Zero
// file reuse from the previous round: Announcement3 replaces Announcement5,
// LatestWinners2 replaces LatestWinners4, Faq4 replaces Faq3, ReviewCardSumo2
// replaces ReviewCardSumo, and the ContentBox shape-mix moves off CyberCut / Two
// / FloatingBadge / SevenThreeCyberCut / SevenThreeFloatingBadge / TwoCyberCut /
// Special onto Premium / Neumorphism / plain ContentBox / SevenThreePremium /
// SevenThreeNeumorphism / TwoPremium / TwoNeumorphism.
// NavbarStyle10 and FooterStyle3 are the layout's pair this round (previously
// NavbarStyle4Black / FooterStyle2) and the brand font moves google-sans ->
// kanit; all three are the orchestrator's shared-chrome step, not this page's.
// Plain ContentBox carrying a docx section is itself new this round: it is the
// always-live box that terms, privacy, 404 and the button pages render through
// (so it cannot follow a rotation), and last round deliberately kept it off
// index — section 3 puts it back on the home page.
// Every unused *CyberCut / *FloatingBadge / *Special / *Huay / Style file, Faq3,
// ReviewCardSumo, LatestWinners4 and Announcement5 stay on disk as inventory for
// the next brand — none of them was deleted, and 789BETTING's copy and colour
// still inside them is expected drift, not a bug.
//
// <Announcement /> runs bare on purpose: Announcement3's default message is
// already this brand's copy, written from this brief, and every sub-page calls
// it bare too — so passing an override here is exactly how the ticker ends up
// saying two different things on two pages of the same site.
//
// PALETTE OF THIS BRAND (brand-spec §2). แตกดี168 is a TWO-COLOUR brand — bright
// sky blue #0193fb leads and lemon yellow #fce604 is a genuine second hue — and
// this round is a full flip off 789BETTING's single-hue metallic-gold set
// (#fad354 #feda5c #ffe79a #ddab33 #8a6410 #c9881f #4a3407 #f3e7cd #b5a888
// #17130a #0e0b05 #0a0802 #060402 and every rgba(250,211,84,α) /
// rgba(255,231,154,α) / rgba(201,136,31,α) glow), as well as GUCCI168's older
// red/emerald/gold set before it. None of that survives on this page or in any
// component it renders. logo.webp is the Thai word แตกดี in flat lemon-yellow
// bold lettering over the numerals 168 in flat sky blue — no metal, no gradient.
// banner1 and both slides are a bright sky-and-clouds scene with gold coins,
// crowns and gift boxes, but bg.json is {"mode":"color","color":"#000000"} —
// solid black, so the page surface stays dark.
// The content cards therefore run a deep navy-black depth ladder (#0a1726 raised
// / #07111d mid / #040b14 deep / #020609 deepest) with body copy #dbeafe
// (= BRAND_TEXT), so the two bright hues read as neon against them.
// Highlights below are the lemon yellow #fce604, which §2 pins to exactly this
// job (<strong> highlights and headings' light end) — unlike the sky light
// #7bcffb and sky pale #d4ecfd that it pins to hover text and gradient ends, and
// unlike the blue deep #064a86 and yellow deep #c9a703 that never carry text at
// all and appear here only as border and shadow colours.
//
// IMAGE ROLES FOR THIS DROP (2026-10-08 22:46, brand-spec §4). Three files are
// referenced from this page and only three, and each pairing is read off the
// artwork itself:
//   banner2.png — a 2508x627 wide strip: the same sky-blue-and-cloud set, the
//     แตกดี168 logo at the far left, the silver-haired woman resting her chin on
//     her hands, 3-D lettering รีวิวถอนจริง over a white plaque reading
//     ภาพสลิปถอนเงิน 3 ภาพรวมกัน, and three phone mock-ups showing KBank, SCB and
//     Krungthai transfer-success slips. It illustrates docx section 2, whose
//     whole subject is การันตีเว็บแท้ / มีรีวิวถอนจริงเพียบ. Imported as imgReview.
//     Per the Phase 1 rule a banner2+ file is an INLINE illustration inside a
//     single-column ContentBox — never a hero, never a SevenThree column, never
//     full-bleed — so it is capped at max-w-2xl inside section 2's card.
//   slide2.png — square 600x533: the woman resting her cheek on her hand on the
//     left, the logo top centre, โปรโมชั่น in big yellow 3-D type over a blue
//     plaque reading "คืนยอดเสีย 0.3%", and a 777 slot machine behind her right.
//     The artwork prints the heading itself, so it belongs to docx H3 #4.
//     Imported as imgCashback.
//   slide1.png — the mirror: logo top left, โปรโมชั่น in yellow, a blue plaque
//     reading "แนะนำเพื่อน" and โบนัส 0.8% under it, and the woman on the RIGHT
//     giving a double thumbs-up. It belongs to docx H3 #5. Imported as imgReferral.
// Both slides are 600x533 on disk, so 600 is the top real candidate — nothing
// above it would be a real pixel — and each picture carries max-w-[600px] so the
// art is never upscaled past its own bitmap.
// Each slide sits in a ContentBoxSevenThree* image+text block, which is that
// family's hard cap of two per rebrand, so there is no third SevenThree anywhere
// on the site and no slide appears outside those two blocks.
// The two blocks mirror each other: ContentBoxSevenThreePremium lays out
// md:grid-cols-[3fr_7fr] so its picture goes in slot="left" while the paragraph
// keeps the wide column, and ContentBoxSevenThreeNeumorphism lays out
// md:grid-cols-[7fr_3fr] so its picture goes in slot="right". The two pictures
// therefore alternate sides instead of stacking down the same edge, and each
// `sizes` describes its own 3fr column rather than the viewport. Tailwind sets
// box-sizing: border-box globally, so every max-w-* below caps the box INCLUDING
// its padding and border. Both figures are recomputed from the component that
// owns the column — if a padding/gap/border/cap changes there, these move with it:
//   ContentBoxSevenThreePremium: cap on the SECTION (max-w-7xl/1280 + px-4), so
//     the card is min(100vw,1280) - 32 and the cap is reached at 100vw >= 1280.
//     border(1x2=2) + md:p-10(80) + gap-10(40) -> 1126 of column space at the cap.
//     The 3fr image column has no padding of its own (md:border-l + md:pl-10 are
//     on the TEXT column).
//       >= 1280px : 1126 x 0.3                        = 337.8 -> 338px
//       md..1279  : (100vw - 154) x 0.3               = calc(30vw - 46px)
//       < md      : one column at p-8                 = calc(100vw - 98px)
//   ContentBoxSevenThreeNeumorphism: cap on the SECTION (max-w-[1400px] + px-4).
//     border(2) + p-8(64) + gap-8(32) -> 1270, and the image column here DOES add
//     md:border-l(1) + md:pl-8(32) = 33 of its own.
//       >= 1400px : 1270 x 0.3 - 33                   = 381 - 33 = 348px
//       md..1399  : (100vw - 130) x 0.3 - 33          = calc(30vw - 72px)
//       < md      : one column at p-8                 = calc(100vw - 98px)
//   banner2 in ContentBoxNeumorphism: the card is min(100vw,1400) - 32, border(2)
//     + p-8(64) -> inner min(100vw - 98, 1270), and the picture caps itself at
//     max-w-2xl(672). 100vw - 98 reaches 672 at 100vw = 770.
//       >= 770px  : 672px
//       < 770px   : calc(100vw - 98px)
//     The file is 2508 wide, so 672 / 1008 / 1344 are all real pixels.
// None of the three is the LCP element — MainLayout's hero banner is — so all are
// loading="lazy" fetchpriority="low" decoding="async" and none takes
// fetchpriority="high".
//
// The alt text was written from THIS drop's artwork per brand-spec §4, read off
// the files rather than carried over: the set is a bright sky-blue-and-lemon
// kawaii scene, not 789BETTING's black-and-gold casino hall — there is no
// roulette wheel, no chandelier, no chip stack, no spade card and no black suit
// on any of the three, and the logo is Thai lettering rather than the numerals
// 789 in polished gold.
//
// Deliberately NOT imported, and every file still on disk:
//   banner3.png (09-27) and slide3.png / slide4.png (09-29) all predate this drop
//   and belong to previous brands — importing any of them emits a competitor's
//   artwork into dist/ (an eager import IS an emit, rendered or not) and turns
//   verify-build red.
//   banner1.png and banner1-mobile.png belong to MainLayout's own pinned globs and
//   are never referenced from a page. og.png is the same: MainLayout owns it.
// Also deliberately unused (named without the file extension on purpose — the
// playbook's "is this component live?" check is a bare-filename grep, and a
// mention here would read as a render): FeatureHighlights renders sub-points as
// <h3>, and this brief already spends both of its allowed H3s on sections 4 and
// 5, so wiring it in would break the count; ProviderGrid, GameRankingBoard and
// SmoothCarousel have no brief section asking for a provider wall, a ranking
// board or a carousel this round; BankStrip already renders inside the active
// footer; and the three-column ContentBox3Three family has nothing to carry —
// every section in this brief is one or two running paragraphs, not a split.
//
// Vocabulary (brand-spec §6): แตกดี168 is a เว็บสล็อตออนไลน์ — a slot site and
// nothing else. The words this page may use are the brief's own: เกมสล็อต,
// ถูกลิขสิทธิ์, ทางเข้าเล่นเกมเดิมพัน, ไม่มีขั้นต่ำ, สล็อตคลาสสิก, เกมโบนัส, ฟรีสปิน,
// ตัวคูณ, เกมเปิดใหม่, ค่าย/ผู้ให้บริการ, โบนัสสมาชิกทุกวัน, การันตีเว็บแท้,
// รีวิวถอนจริง, คืนยอดเสีย 0.3%, แนะนำเพื่อน 0.8%, รอบตัดยอด, ยอดที่เข้าเกณฑ์,
// รอบการรับสิทธิ์, Login, เครดิต, ประวัติรายการ, สมัครสมาชิก, แอดมิน 24 ชั่วโมง,
// ฝากถอน, PIN, OTP, หลักฐานธุรกรรม, ช่องทางหลัก.
// 789BETTING's vocabulary is banned and gone (คาสิโนฐานเข้าหลัก,
// เดิมพันตรงกับบริษัท 100%, บาคาร่า, รูเล็ต, บอล, โต๊ะ, ตลาดเดิมพัน, คู่แข่งขัน,
// นิติบุคคล, ยอดเข้าบริษัทตรง), as is every older brand's (ไฮโล, โต๊ะสด, คาสิโนไลฟ์,
// เบทต่ำ, ทุนน้อย, ค่ายตรง, ไฮคลาส, VIP, ส่งตรงจากเว็บแม่, ไม่ผ่านบัญชีม้า,
// สมัคร 3 ขั้นตอน) — the page is written straight from the brief rather than
// find-and-replaced over the old sentences. There is NO หวย anywhere on this site
// this round: it is a slot brand, the word appears nowhere, and /ตรวจหวย and
// /แนวทาง stay parked in src/pages-disabled/.
// Nothing here claims a licence, a regulator, an operator, a studio, a bank, an
// RTP figure, a deposit minimum, a member count or a founding year, because the
// brief names none. The only figures are the brief's own: 0.3%, 0.8%, 24 ชั่วโมง.
// The brief's own hedging ships with the copy — it states it four separate times
// (คำว่าไม่มีขั้นต่ำควรตรวจสอบวงเงินจริงของแต่ละเกม · การระบุว่าเกมสล็อตถูกลิขสิทธิ์
// ควรมีข้อมูลค่ายหรือผู้ให้บริการที่ตรวจสอบได้รองรับ · โบนัสที่ได้รับจริงควรยึด
// รายละเอียดล่าสุดจากระบบเป็นหลัก · ไม่ควรนำผลลัพธ์ของสมาชิกคนหนึ่งมาเป็นการ
// รับประกันผลลัพธ์ของสมาชิกทุกคน) and it is part of the paragraphs, not trimmed
// as downbeat filler.
//
// The brief says แตกดี168 throughout and so does every piece of artwork in the
// drop and the operator's prompt — no conflict this round. Even so the brand name
// is never typed on the page: it is interpolated from ${BRAND_NAME} so it can
// never drift from brandProfile. No domain is written out anywhere in this file.
//
// Title and description are the brief's own Title/Description lines (minus that
// substitution), used verbatim and NOT padded up to 150: the description is 142
// code points, and verify-build deliberately skips its 150-character floor on the
// home page for exactly this reason.
const pageTitle = `${BRAND_NAME} เกมสล็อตถูกลิขสิทธิ์ จ่ายโบนัสทุกวัน มีรีวิวถอนจริงเพียบ`;

const pageDescription = `${BRAND_NAME} เกมสล็อตถูกลิขสิทธิ์ ทางเข้าเล่นเกมเดิมพัน ไม่มีขั้นต่ำ จ่ายโบนัสสมาชิกทุกวัน สมัครง่าย ไม่ยุ่งยาก การันตีเว็บแท้ มีรีวิวถอนจริงเพียบ`;

// The brief has a real H2 -> H3 nesting this round, so the page is NOT flattened
// to H2-only. The two H3s are genuine headings — the two bonus sub-points, both
// nested under section 3's โปรโมชั่น H2 — and they stay H3.
//
// The checklist, in document order, and what carries each one:
//    1 H1  แตกดี168เกมสล็อตถูกลิขสิทธิ์ ทางเข้าเล่นเกมเดิมพันออนไลน์ ไม่มีขั้นต่ำ
//          ContentBoxPremium, brief paragraph on line 4
//    2 H2  แตกดี168 จ่ายโบนัสสมาชิกทุกวัน การันตีเว็บแท้ มีรีวิวถอนจริงเพียบ
//          ContentBoxNeumorphism, lines 6 + 7 plus the capped banner2 illustration
//    3 H2  โปรโมชั่นเล่นสล็อต แตกดี168 จ่ายโบนัสสมาชิกทุกวัน
//          ContentBox (the plain, always-live variant), line 9
//    4 H3  คืนยอดเสีย โบนัส 0.3%
//          ContentBoxSevenThreePremium + slide2 (imgCashback), line 11
//    5 H3  แนะนำเพื่อน โบนัส 0.8%
//          ContentBoxSevenThreeNeumorphism + slide1 (imgReferral), line 13
//    6 H2  ร่วมเป็นสมาชิกเว็บสล็อต แตกดี168 เพียงสมัครง่ายๆ ไม่ยุ่งยาก
//          ContentBoxTwoPremium, line 15 left / line 16 right
//    7 H2  ติดต่อแอดมิน แตกดี168 ผู้ให้บริการได้ 24 ชั่วโมง
//          ContentBoxTwoNeumorphism, line 18 left / line 19 right
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ แตกดี168
//          Faq4 + faqs prop, lines 21-26
// Final inventory for this page: h1 x1, h2 x5, h3 x2.
//
// Shape rhythm, top to bottom: gradient slab with a vertical blue rail beside the
// heading -> flat neumorphic plate with a centred heading and an inline picture
// -> rounded glass card with an underline rule -> 3:7 gradient card with the
// picture on the LEFT -> 7:3 deep neumorphic plate with the picture on the RIGHT
// -> two-column glass card with coloured column rails -> two-column neumorphic
// plate -> clipped-corner accordion. No shape repeats back to back; the three
// neumorphic plates are separated by surface depth (#07111d / #020609 / #0a1726)
// rather than by heading colour alone, and every card's heading gradient runs a
// different order of the same four hues, so no two cards read as the same card
// twice.
//
// ContentBoxSevenThreePremium takes the docx heading through `title`, which falls
// back to its wide (7fr) RIGHT text column; its image column is passed no
// `titleleft`, so the block emits exactly one heading. ContentBoxSevenThree-
// Neumorphism is the mirror: `title` falls back to its wide (7fr) LEFT text
// column and no `titleright` is passed, so its picture column carries none.
//
// Every brief paragraph ships in full — all eleven of them, nothing merged or
// summarised. Sections 2, 6 and 7 have two paragraphs each; section 2 runs both
// down one column with the picture under them, while 6 and 7 run one per column.
// Sections 1, 3, 4 and 5 have one paragraph each. The column labels passed to the
// two two-column boxes are this page's own layout wording, not brief headings,
// and both variants render those labels as <p>.
//
// Everything else on the page is chrome and emits no heading tag at any level:
// Announcement3, LatestWinners2, LoginRtpSection and ReviewCardSumo2 render their
// titles as <p>/<span> with an aria-label on the section, and Faq4's questions
// live inside <summary> as <span>. The non-brief widgets sit before section 1
// (the ticker, then the winners feed) and after section 8 (LoginRtpSection,
// ReviewCardSumo2, Navfoot) — never spliced between two content sections.

// One array, used by both <Faq> and the FAQPage node — never the component's own
// defaults (Faq4 deliberately ships none, so a forgotten prop renders an empty
// accordion rather than some previous brand's questions). The three pairs are the
// brief's own Q/A block (content.txt lines 21-26), verbatim.
const faqs = [
  {
    q: `${BRAND_NAME} มีเกมสล็อตแบบไม่มีขั้นต่ำทุกเกมหรือไม่?`,
    a: `ยอดเดิมพันขั้นต่ำขึ้นอยู่กับเกมสล็อตและค่ายผู้ให้บริการ บางเกมรองรับการเดิมพันด้วยยอดต่ำ ขณะที่บางรายการอาจกำหนดขั้นต่ำต่างกัน จึงควรตรวจสอบช่วงเดิมพันภายในเกมก่อนเริ่มเล่นทุกครั้ง`,
  },
  {
    q: `${BRAND_NAME} จ่ายโบนัสสมาชิกทุกวันจริงหรือไม่?`,
    a: `หากมีโปรโมชั่นประจำวันที่เปิดให้รับ สมาชิกสามารถตรวจสอบสิทธิ์จากบัญชีตามรอบที่เว็บไซต์กำหนด แต่โบนัส จำนวนครั้ง และยอดที่ได้รับขึ้นอยู่กับเงื่อนไขของแต่ละกิจกรรม จึงควรตรวจสอบรายละเอียดล่าสุดก่อนรับสิทธิ์`,
  },
  {
    q: `รีวิวถอนจริงของ${BRAND_NAME} ใช้ยืนยันว่าเว็บแท้ได้หรือไม่?`,
    a: `รีวิวจากสมาชิกสามารถใช้เป็นข้อมูลประกอบได้ แต่ไม่ควรใช้เป็นหลักฐานเพียงอย่างเดียวในการยืนยันว่าเป็นเว็บแท้ ควรตรวจสอบช่องทางหลัก ข้อมูลผู้ให้บริการ รายละเอียดค่ายเกม และเงื่อนไขการทำธุรกรรมร่วมด้วย`,
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// One highlight colour only: #fce604, the lemon yellow, against the inherited
// body colour #dbeafe (BRAND_TEXT). The paragraphs below carry no colour class of
// their own: every ContentBox* card in this mix already sets
// `text-left text-base leading-relaxed text-[#dbeafe]` on the element holding the
// slot, so the prose inherits it and no page-level override can drift from the
// card. No paragraph carries mx-auto or max-w-* either — the cards cap their own
// width, and the only max-w-* on the page is the one capping the banner2 picture,
// which is an image and not prose. One element per slot, everywhere: section 2
// passes a single <div> wrapping its two paragraphs and its picture.

// No breadcrumb: this is the homepage, so a trail from the root to itself would
// be a single self-referential crumb. Every URL in the graph is derived by
// pageGraph from `site:` — no domain is typed out in this file, no URL is built
// with `+`, and no Review / AggregateRating / sameAs / address / email node is
// passed. `description` is the exact same string MainLayout gets.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <LatestWinners />

  <ContentBoxPremium as="h1" title={`${BRAND_NAME}เกมสล็อตถูกลิขสิทธิ์ ทางเข้าเล่นเกมเดิมพันออนไลน์ ไม่มีขั้นต่ำ`}>
    <p>
      {BRAND_NAME}
      <strong class="text-[#fce604]">เกมสล็อตออนไลน์ที่รวบรวมเกมเดิมพันหลายรูปแบบไว้ในระบบเดียว</strong>
