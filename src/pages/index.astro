---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ContentBoxHuay from "../components/ContentBoxHuay.astro";
import ContentBoxTwoHuay from "../components/ContentBoxTwoHuay.astro";
import ContentBoxSevenThreeHuay from "../components/ContentBoxSevenThreeHuay.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import LottoGrid from "../components/LottoGrid.astro";
import Faq from "../components/Faq2.astro";
import LatestWinners from "../components/LatestWinners3.astro";
import ReviewCardSumo from "../components/ReviewCardSumo.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import { pageGraph } from "../lib/schema";
import signupPoster from "../assets/slide1.png";

// การหมุน variant รอบนี้ตัดสินไว้แล้วใน .claude/brand-spec-lotto189.md §3 —
// **ห้ามเลือกใหม่ที่นี่** แบรนด์ขาออก (ZNOVA168) ถูกหมุนออกจากทุกตระกูลพร้อมกัน:
// AnnouncementHuay แทน Announcement2 · Faq2 แทน Faq4 · LatestWinners3 แทน
// LatestWinnersCyber · ReviewCardSumo แทน ReviewCardSumo2 · และ shape-mix ของ
// ContentBox ทิ้งชุด Neumorphism/ฐาน/Special ของรอบก่อนทั้งชุด ไปใช้ **ตระกูล
// *Huay + ContentBoxPremium** แทน พร้อมวิดเจ็ตใหม่ **LottoGrid** ซึ่งตรงแกน
// แบรนด์รอบนี้ที่เป็น **เว็บหวย/ลอตโต้ ไม่ใช่เว็บสล็อต** (กลับทิศจากรอบก่อน)
// ไม่ลบไฟล์ที่ไม่ได้ใช้แม้แต่ตัวเดียว — มันคือ inventory ของแบรนด์ถัดไป
// Navbar/Footer อยู่ที่ MainLayout (NavbarHuay / FooterHuay) ไม่ใช่ที่ไฟล์นี้
// ❌ รอบนี้ **ไม่ใช้ *FloatingBadge / FeatureHighlights / SmoothCarousel /
// BankStrip / ContentBox3Three*** — บรีฟรอบนี้ไม่มีหมวดฝากถอน ไม่มีหมวดธนาคาร
// หรือวอลเลท และไม่มีหมวดโปรโมชั่นเลยแม้แต่คำเดียว
//
// ⚠️⚠️ พาเลตรอบนี้ (brand-spec §2 ล็อกค่าไว้ ห้ามเดาเพิ่ม ห้ามดูดสีจากรูป):
// **เนื้อหาสว่าง (การ์ดขาวบนพื้นชมพูจาง) · โครมเข้ม (ออกซ์บลัดเกือบดำ)**
// พื้นเพจ #fff0f0 (bg.json) · การ์ด #ffffff · ชั้นยก #ffe4e6 · wash #ffd4d7 ·
// เส้น #f5b9bd / #a8333f · หมึก #25090f (= BRAND_TEXT) · หมึกรอง #6e3b44 ·
// **หัวข้อ + ลิงก์ + <strong> = #b00718** (7.3:1 บนขาว) · แดงแบรนด์ #c1071b ·
// แดงลึก #8a0412 · ทองเข้ม #8f6310 · ปุ่มไล่ #8a0412 -> #b00718 -> #d61023
// 🚨🚨 **#ff2436 (3.9:1) #e9b53c (2.0:1) #c3ccd6 #f5b9bd #ffd4d7 #ffe4e6 #fff0f0
// ห้ามถือตัวอักษรบนผิวสว่างเด็ดขาด** (พื้นถม/ขอบ/ออราเท่านั้น) และ #a8333f เป็น
// **เส้น** เท่านั้น · #e9b53c #c3ccd6 #ff2436 เป็นไฮไลต์ของ **โครมเข้ม**
// ห้ามหลุดมาถือตัวอักษรบนการ์ดขาว → `<strong>` ทุกตัวในไฟล์นี้จึงเป็น
// **#b00718 ค่าเดียว** ไม่ใช่ #c1071b และไม่ใช่ #ff2436
// ⚠️⚠️ **รอบนี้เป็นแบรนด์แดง/ทอง/ครีม = ตระกูลเดียวกับ MEXICANOSLOT เมื่อสามรอบ
// ก่อน และใกล้กับ ZNOVA168 รอบก่อน (ส้ม/ทอง/ครีม)** → "เจอแดง/ทอง/ครีม ≠ เป็นของ
// รอบนี้" ต้องเทียบให้ตรงหกหลัก ค่าที่ห้ามเหลือ (เขียนแบบไม่มี # เพื่อไม่ให้
// sweep สะดุดที่คอมเมนต์นี้): 2a1206 1a0c04 2b1608 0e0602 7a3a0c fff3e0 e0b784
// fffbf0 fff4e0 ffe9c7 f3d9a8 c98a24 c23400 b8300a 9a5b00 9a2a00 d13800 fa4903
// fde90b e8a000 ff8a2b d8dde6 8f9aa8 6a4a30 (ZNOVA168 ขาออก เสี่ยงสูงสุด) ·
// a81410 c81e12 9d140c de2b1e 3f130d 2b100a 431a10 1d0a06 fdeee2 fff3ea fde4d3
// e8c6ae f6c4a4 f2a033 (MEXICANOSLOT) · 7a1bd6 5411c4 241046 c2178b f8e6f9
// (ZANE96) · cf1111 e01f26 1fae1c 0d2312 143a1c 07130a fcdc2b fff6ae a87d0c
// (แบรนด์หวยเก่าที่เคยเป็นเจ้าของ LottoGrid)
// ⚠️ รอบนี้ **ไม่มีม่วง ไม่มีฟ้า/ไซแอน ไม่มีชมพูบับเบิลกัม ไม่มีเขียวแบรนด์
// ไม่มีส้มเพลิง** เป็นสี UI เลยสักเฉด
//
// ย่อหน้าในไฟล์นี้ไม่ถือคลาสสีหรือขนาดของตัวเอง — ทุก ContentBox* ในมิกซ์นี้ตั้ง
// `text-left text-base leading-relaxed` + หมึก #25090f ไว้บน element ที่ถือ slot
// อยู่แล้ว และไม่มี `<p>` ไหนมี mx-auto / max-w-* (การ์ดคุมความกว้างเองแล้ว)
// ข้อยกเว้นเดียวคือ **ป้าย "ขั้นตอนที่ 1/2/3" ใน §6** ซึ่งเป็นป้าย ไม่ใช่เนื้อความ
// จึงถือ font-bold + สีหัวข้อได้ และต้องเป็น <p> **ห้ามเป็น heading ทุกระดับ**
//
// ⚠️ ชื่อแบรนด์รอบนี้เป็น **ตัวละตินพิมพ์ใหญ่ + เลข ติดกัน ไม่มีเว้นวรรค** แต่ยัง
// interpolate จาก `${BRAND_NAME}` ทุกจุดรวมถึงใน alt ของสไลด์
// **ห้ามพิมพ์ชื่อแบรนด์เป็นตัวอักษรตรงๆ ที่ไหนเลย** ไม่มีโดเมนเขียนไว้ที่ไหน
// และไม่มี URL ที่ต่อด้วย `+`
//
// <strong> ทุกตัวคร่อม "ก้อนที่คั่นด้วยช่องว่าง" ทั้งก้อน เพราะภาษาไทยไม่มีช่องว่าง
// ระหว่างคำ — ไฮไลต์ที่เริ่มหรือจบกลางคำจะถูก formatter ตัดบรรทัดในแท็กแล้วแทรก
// ช่องว่างกลางคำ อ่านคอปปี้โดยถอดแท็กออกต้องได้ข้อความของบรีฟเป๊ะ และไม่มี <strong>
// สองตัวติดกันโดยไม่มีข้อความธรรมดาคั่น
//
// บรีฟรอบนี้ **โฆษณาและกำกับในประโยคเดียวกัน** (brand-spec §5): หัวข้อเขียนว่า
// จ่ายเต็ม รับทุกเลข ไม่มีอั้นเลข / อัตราจ่าย 2 ตัว 100 และ 3 ตัว 1,000 ขณะที่
// ย่อหน้าของบรีฟเองตอบกลับว่า ควรตรวจสอบความถูกต้องของข้อมูลและข้อกำหนดก่อนทำรายการ
// เนื่องจากผลการออกรางวัลมีความไม่แน่นอนและไม่สามารถคาดการณ์ได้อย่างแม่นยำ ·
// ควรตรวจสอบข้อจำกัดการรับหมายเลข วงเงินเดิมพันสูงสุด และเงื่อนไขการจ่ายรางวัล ·
// ผลการออกรางวัลไม่สามารถรับประกันได้จากสถิติหรือเลขย้อนหลัง · ควรตรวจสอบเวลา
// การให้บริการจริงจากประกาศล่าสุดอีกครั้ง — **ship ทั้งสองครึ่งตรงตามที่บรีฟเขียน
// ไม่ขยายคำโฆษณาเป็นคำกล่าวอ้างใหม่ และทุกประโยคกำกับ ship ครบ ไม่ตัดเพราะฟังดูลบ**
// ตัวเลขบนหน้านี้มีแค่ของบรีฟเอง: **2 ตัว 100 · 3 ตัว 1,000 · 3 ขั้นตอน · 24ชม.**
// 🚨🚨 **`0.3%` กับ `0.8%` พิมพ์อยู่บนอาร์ตเวิร์ก slide1/slide2 จริง** แต่บรีฟรอบนี้
// **ไม่มีหมวดโปรโมชั่นเลย** และสองค่านั้นเป็นคอปปี้ของ ZNOVA168 รอบก่อน →
// เขียนลงได้ **เฉพาะใน alt ที่บรรยายว่าโปสเตอร์พิมพ์อะไรไว้** เท่านั้น
// **ห้ามเป็นเนื้อความ ห้ามเป็นหัวข้อ ห้ามอยู่ใน title/description/FAQ**
// ❌ และคำของแบรนด์ก่อนห้ามเขียนกลับเข้ามา: ZNOVA168 / ZOLO99 /
// สล็อต1บาททรูวอลเลท / รวมค่ายสล็อตลิขสิทธิ์แท้ / ฝากถอนธนาคารและวอลเลท /
// คืนยอดเสีย / แนะนำเพื่อน / สล็อตคลาสสิก / ฟรีสปิน / เกมโบนัส / ค่า RTP /
// ความผันผวน (ZNOVA168) · ZANE96 / สล็อตลิขสิทธิ์แท้ในไทย / เว็บตรงไม่ผ่าน
// เอเย่นต์ (ZANE96) · MEXICANOSLOT / การันตีเว็บตรง (MEXICANOSLOT) ·
// รวย168 / แทงหวยเว็บรวย / บาทละ 1,000 / 888PARUAY / JEDI66 / LOTTOPLUS /
// หวยเต็ง (แบรนด์หวยเก่า — ใกล้ตัวที่สุดเพราะหมวดเดียวกัน)
// ⚠️ **คำหมวดหวยทั่วไปรอบนี้ใช้ได้** (หวย · สลาก · งวด · บิลหวย · รอบปิดรับ ·
// สองตัวบน/ล่าง · สามตัวตรง/โต๊ด) เพราะเป็นคำของบรีฟเอง — อย่าสืบทอดข้อห้าม
// ข้ามรอบโดยไม่เปิดบรีฟดู
//
// title/description = บรรทัด 1-2 ของบรีฟ **verbatim** (src/assets/content.txt)
// ส่งที่นี่เพราะ pageGraph ต้องใช้สตริงเดียวกับที่ MainLayout ได้รับ
// **ห้ามต่อเติม** (description = 119 ตัวอักษร ตามที่บรีฟเขียนมาเอง และ
// verify-build ยกเว้นเพดานล่าง 150 ให้หน้าแรกไว้ด้วยเหตุผลนี้โดยเฉพาะ)
const pageTitle = `${BRAND_NAME} แนะนำเว็บหวยลอตโต้ แทงหวยจ่ายสด รับทุกเลข ไม่มีอั้น`;

const pageDescription = `${BRAND_NAME} แนะนำเว็บหวยลอตโต้ แทงหวยออนไลน์ ลาว ฮานอย รัฐบาลไทย หุ้นต่างประเทศ จ่ายเต็ม จ่ายสด เปิดรับทุกเลข ไม่มีอั้นเลข`;

const pageH1 = `${BRAND_NAME} แนะนำเว็บหวยลอตโต้ แทงหวยออนไลน์ ทุกประเภท`;

// บรีฟรอบนี้มีชั้น H1 -> H2 -> H3 จริง จึง **ไม่** แบนเป็น H2 ล้วน
//
// checklist ตามลำดับเอกสาร (brand-spec §4) และตัวที่รับแต่ละข้อ:
//    1 H1  <แบรนด์> แนะนำเว็บหวยลอตโต้ แทงหวยออนไลน์ ทุกประเภท
//          ContentBoxHuay, ย่อหน้าบรรทัด 4
//    2 H2  <แบรนด์> ลาว ฮานอย รัฐบาลไทย หุ้น จ่ายเต็ม รับทุกเลข ไม่มีอั้นเลข
//          ContentBoxTwoHuay, บรรทัด 6 แบ่งสองซีกโดยไม่ตกประโยคไหน
//          + LottoGrid ต่อท้าย (วิดเจ็ตอธิบายสี่ตลาดของหัวข้อนี้โดยตรง)
//    3 H2  อัตราจ่ายเว็บ <แบรนด์> แทงหวยทุกประเภท
//          ContentBoxPremium (จังหวะคั่นกลางชุด Huay โดยตั้งใจ), บรรทัด 8
//    4 H3  อัตราจ่าย 2 ตัว ถูกรับ 100
//          ContentBoxHuay, บรรทัด 10
//    5 H3  อัตราจ่าย 3 ตัว ถูกรับ 1,000
//          ContentBoxHuay, บรรทัด 12
//    6 H2  วิธีการสมัครแทงหวย <แบรนด์> ด้วยมือถือ 3 ขั้นตอน
//          ContentBoxSevenThreeHuay, ซ้าย = intro (บรรทัด 14) + สามขั้นตอน
//          (บรรทัด 15-20) ห่อใน <div> เดียว · ขวา = slide1
//    7 H2  เว็บแทงหวย <แบรนด์> มีแอดมินออนไลน์ตลอด 24ชม.
//          ContentBoxTwoHuay, บรรทัด 22 แบ่งสองซีกโดยไม่ตกประโยคไหน
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ <แบรนด์>
//          Faq2 + prop faqs ชัดเจน, บรรทัด 24-29
// inventory ที่ต้องได้: **h1 ×1 · h2 ×5 · h3 ×2** — ตรงเป้าของ brand-spec §4
//
// ⚠️ จุดที่ชั้น heading รั่วได้ และกันไว้แล้วทุกจุด: บรรทัด 15/17/19 ของบรีฟ
// (ขั้นตอนที่ 1/2/3) **ไม่มี prefix H** จึง render เป็น <p class="font-bold">
// ในสล็อตซ้ายของ §6 ไม่ใช่ป้ายคอลัมน์และไม่ใช่ heading · ContentBoxTwoHuay
// **ไม่ส่ง titleleft/titleright เลย** ทั้งสองครั้ง เพราะบรีฟไม่ได้ตั้งชื่อให้
// สองซีกนั้น การคิดป้ายขึ้นมาเองจะเป็นถ้อยคำของหน้า ไม่ใช่ของบรีฟ ·
// **ไม่ส่ง titleright ให้ SevenThree** คอลัมน์ภาพจึงไม่มี heading ·
// คำถามใน Faq2 เป็น <span> ใน <summary> ไม่ใช่ heading และหัวข้อของมันมาจาก prop
// grep `<h[1-6]` ในทุก component ที่ไฟล์นี้เรียกแล้วรอบนี้ — ไม่มีตัวไหน hardcode
// heading ไว้เลย ทุกแท็ก heading บนหน้ามาจาก prop คือมาจากบรีฟ
// chrome บนหน้านี้ (AnnouncementHuay · LottoGrid · LatestWinners3 ·
// ReviewCardSumo · Navfoot) ขึ้นป้ายเป็น <p>/<span> พร้อม aria-label บน <section>
//
// ── รูปภาพ ────────────────────────────────────────────────────────────────
// รอบนี้ใช้ **slide1 ใบเดียว** และอยู่ใน ContentBoxSevenThreeHuay ของ §6 เท่านั้น
// (playbook ตรึง slide* ไว้กับตระกูล SevenThree) เหตุผลที่จับคู่กับ §6:
// **ตัวหนังสือบนงานอาร์ตเป็นตัวตัดสิน** — slide1 ปิดท้ายด้วยแคปซูลแดงเข้มขอบทอง
// ที่เขียนว่า **สมัครสมาชิก** ซึ่งตรงกับหัวข้อ "วิธีการสมัครแทงหวย…" ส่วนครึ่งล่าง
// ที่พิมพ์ 0.3% เป็นคอปปี้ของแบรนด์ก่อน จึงบรรยายไว้ใน alt ในฐานะ "สิ่งที่พิมพ์อยู่
// บนโปสเตอร์" ไม่ใช่คำกล่าวอ้างของหน้า
// ⚠️ **slide2 ไม่ใช้ในหน้านี้** (ใช้ที่ /promotion) — เพดานของตระกูล SevenThree คือ
// 2 บล็อก แต่รอบนี้ใช้ **1** เพราะบรีฟไม่มีหมวดโปรโมชั่นที่จะรับใบที่สอง
// ⛔ **banner1 / banner1-mobile / og.png เป็นของ MainLayout** (glob ปักชื่อไว้แล้ว)
// และ **banner2.png / banner3.png / slide3.png / slide4.png เป็นอาร์ตเวิร์กของ
// แบรนด์อื่น ห้าม import เด็ดขาด** เพราะ eager import = emit ขึ้น dist ทุก build
// แม้ไม่มีหน้าไหน render และ verify-build.mjs จะแดงถ้ามีรูปที่ไม่ได้ถูก render
// ⚠️ ไม่มีภาพไหนบนหน้านี้เป็น LCP (hero อยู่ที่ MainLayout) จึง **ไม่มี
// loading="eager" / fetchpriority="high"** สักใบ สไลด์อยู่ใต้ fold
//
// `widths`/`sizes` คำนวณจากเรขาคณิตจริงของคอลัมน์ภาพ (3fr ฝั่งขวา) ใน
// ContentBoxSevenThreeHuay — **คำนวณใหม่สำหรับดรอปนี้ ห้ามลอกของรอบก่อนหรือของ
// ไฟล์พี่น้อง** (section max-w-[1400px] + px-4 = 32 · การ์ด border 1×2 = 2 ·
// md:p-10 = 80 · grid gap-8 = 32 · คอลัมน์ภาพมี md:pl-6 = 24 อยู่ในกล่องของมันเอง ·
// Tailwind เป็น border-box ทั่วโปรเจกต์ max-w/padding จึงนับรวมกัน):
//   >= 1400px : (1400 − 32 − 2 − 80 − 32) × 0.3 − 24 = 1254 × 0.3 − 24 ≈ 352px
//   768–1399  : (100vw − 146) × 0.3 − 24             = calc(30vw − 68px)
//   473–767   : ยุบเหลือคอลัมน์เดียวที่การ์ด p-8 → 100vw − 98 ซึ่ง ≥ 375 จึงติด
//               เพดานความกว้างจริงของบิตแมป          = 375px
//   < 473     : คอลัมน์เดียวที่ p-8                   = calc(100vw − 98px)
// candidate: 176 = ครึ่งของ 352 (คอลัมน์แคบ DPR1) · 277 = 100vw−98 ที่จอ 375px ·
// 352 = 1× ที่ >= 1400px · 375 = **เพดานบิตแมปจริง (375×600)** ซึ่งรับ 2× ของสอง
// ค่าแรกไปพร้อมกัน — **ห้าม upscale เกิน 375** (2× ของ 352 = 704 เกินบิตแมป)
const posterWidths = [176, 277, 352, 375];
const posterSizes = "(min-width: 1400px) 352px, (min-width: 768px) calc(30vw - 68px), (min-width: 473px) 375px, calc(100vw - 98px)";

// ⚠️ อาร์ตเวิร์กพิมพ์ชื่อแบรนด์ไว้บนรูปจริง แต่ alt บรรยาย **รูปทรงของเวิร์ดมาร์ก**
// แล้วอ้างชื่อด้วย ${BRAND_NAME} — ห้ามพิมพ์ตัวอักษรชื่อแบรนด์ลง alt ตรงๆ
// บรรยายจากบิตแมปจริงของดรอปนี้ (brand-spec §6) ไม่ใช่คัดลอกของรอบก่อน:
// ภาษาภาพของ ZNOVA168 ที่ **ไม่มี** ในรูปนี้ — นักรบหญิงถือดาบเงิน · ชุดเกราะ
// เมทัลลิกประดับหนาม · ริบบิ้นแดงพลิ้ว · ทองหลอมเหลว/ส้มเพลิง · โลโก้ทรูมันนี่
// วอลเล็ต · ฉากสตูดิโอขาว-เทาควัน · กล่องของขวัญ · หัวใจนีออน
const posterAlt = `โปสเตอร์แนวตั้งของ ${BRAND_NAME} บนฉากห้องสีขาวครีม มุมบนซ้ายเป็นโลโก้ ${BRAND_NAME} ซึ่งเป็นเวิร์ดมาร์กสามมิติที่ครึ่งแรกเป็นตัวอักษรละตินผิวโครเมียมเงินขัดเงาตัดขอบแดง และครึ่งหลังเป็นตัวเลขผิวแดงเลือดนกเคลือบเงา กลางภาพเป็นหญิงสาวผมยาวสีน้ำตาลเข้มดัดลอน สวมสูทขาว นั่งอยู่ที่โต๊ะที่มีโพยหวยกองอยู่ตรงหน้า ขนาบด้วยลูกบอลหวยสีขาวพิมพ์เลข 8 9 6 และ 1 ครึ่งล่างพิมพ์คำว่า โปรโมชั่น เป็นตัวอักษรสามมิติสีแดงตัดขอบทอง ใต้ลงมาเป็นคำว่า คืนยอดเสีย ตัวอักษรขาวบนแถบแดง แล้วตามด้วยตัวเลข 0.3% ตัวโตสีแดงตัดขอบขาว โดยมีมงกุฎทองดวงเล็กอยู่เหนือตัวอักษร ปิดท้ายด้วยแคปซูลพื้นแดงเข้มขอบทองที่เขียนว่า สมัครสมาชิก พร้อมไอคอนรูปคนและเครื่องหมายลูกศรคู่`;

// อาร์เรย์เดียว ใช้ทั้งกับ <Faq> และโน้ด FAQPage — ไม่ใช้ default ของ component
// (Faq2 ตั้งใจ ship เป็นลิสต์ว่าง prop ที่ลืมส่งจึงได้ accordion เปล่า ไม่ใช่
// คำถามของแบรนด์ก่อน) สามคู่นี้คือบล็อก Q/A ของบรีฟเอง (content.txt บรรทัด 24-29)
// ตรงตัว ตัดเฉพาะหมายเลข "1." "2." "3." ออกเพราะ accordion เป็นตัวลิสต์อยู่แล้ว
// ทุกคำตอบคงประโยคกำกับของบรีฟไว้ครบ — เป็นเนื้อหาของบรีฟทั้งสองครึ่ง
const faqs = [
  {
    q: `${BRAND_NAME} มีหวยประเภทไหนให้เลือกบ้าง?`,
    a: `ตามข้อมูลที่ระบุ ${BRAND_NAME} นำเสนอหวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยหุ้นต่างประเทศ โดยควรตรวจสอบรายการที่เปิดให้บริการจริง รวมถึงรอบปิดรับและแหล่งอ้างอิงผลรางวัลก่อนทำรายการ`,
  },
  {
    q: `${BRAND_NAME} มีอัตราจ่ายหวย 2 ตัว 100 และ 3 ตัว 1,000 จริงหรือไม่?`,
    a: `เว็บไซต์ระบุอัตราจ่ายดังกล่าว แต่ควรตรวจสอบฐานเงินเดิมพัน ประเภทหวยที่เข้าร่วม และวงเงินจ่ายสูงสุดจากตารางอัตราจ่ายล่าสุดก่อนยืนยันบิล`,
  },
  {
    q: `สามารถสมัครสมาชิก ${BRAND_NAME} ผ่านมือถือได้หรือไม่?`,
    a: `ตามข้อมูลที่ระบุ ${BRAND_NAME} รองรับการสมัครสมาชิกผ่านมือถือ โดยควรตรวจสอบที่อยู่เว็บไซต์ ขั้นตอนยืนยันบัญชี และข้อกำหนดการใช้บริการก่อนลงทะเบียน`,
  },
];

// ไม่มี breadcrumb: นี่คือหน้าแรก เส้นทางจาก root มาหาตัวเองจะเหลือครั้งเดียวที่ชี้ตัวเอง
// ทุก URL ในกราฟมาจาก pageGraph ที่ derive จาก site: — ไม่มีโดเมนพิมพ์ไว้ในไฟล์นี้
// ไม่มี URL ที่ต่อด้วย `+` และไม่ส่งโน้ด Review / AggregateRating / sameAs /
// address / email เข้าไปเลย
// `description` เป็นสตริงเดียวกับที่ MainLayout ได้รับ `name` เป็น H1 ของหน้า และ
// `faqs` เป็นอาร์เรย์ตัวเดียวกับที่ <Faq> ได้รับ
const graph = pageGraph(Astro, {
  name: pageH1,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxHuay as="h1" title={pageH1}>
    <p>
      {BRAND_NAME} นำเสนอข้อมูลหวยออนไลน์หลายประเภท
      <strong class="text-[#b00718]">ทั้งหวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยหุ้นต่างประเทศ</strong>
      พร้อมรายละเอียดอัตราจ่ายและรอบประกาศผลที่แตกต่างกัน ผู้ใช้งานสามารถศึกษารูปแบบการเลือกหมายเลข ตรวจสอบเงื่อนไขการเดิมพัน และติดตามข้อมูลผลรางวัลได้ในช่องทางเดียว
      <strong class="text-[#b00718]">โดยควรตรวจสอบความถูกต้องของข้อมูลและข้อกำหนดก่อนทำรายการ</strong>
      เนื่องจากผลการออกรางวัลมีความไม่แน่นอนและไม่สามารถคาดการณ์ได้อย่างแม่นยำ
    </p>
  </ContentBoxHuay>

  <ContentBoxTwoHuay as="h2" title={`${BRAND_NAME} ลาว ฮานอย รัฐบาลไทย หุ้น จ่ายเต็ม รับทุกเลข ไม่มีอั้นเลข`}>
    <p slot="left">
      {BRAND_NAME} รวบรวมข้อมูลหวยหลากหลายประเภท ได้แก่
      <strong class="text-[#b00718]">หวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยหุ้นต่างประเทศ</strong>
      ซึ่งแต่ละรายการมีวันประกาศผลและรูปแบบการเดิมพันแตกต่างกัน
      <strong class="text-[#b00718]">เว็บไซต์ระบุว่ารับทุกเลข ไม่มีเลขอั้น และจ่ายเต็มตามอัตราที่กำหนด</strong>
    </p>
    <p slot="right">
      อย่างไรก็ตาม
      <strong class="text-[#b00718]">ควรตรวจสอบข้อจำกัดการรับหมายเลข วงเงินเดิมพันสูงสุด และเงื่อนไขการจ่ายรางวัลของแต่ละประเภทให้ชัดเจนก่อนยืนยันบิล</strong>
      เพื่อให้เข้าใจรายละเอียดการทำรายการอย่างถูกต้อง
    </p>
  </ContentBoxTwoHuay>

  <LottoGrid />

  <ContentBoxPremium as="h2" title={`อัตราจ่ายเว็บ ${BRAND_NAME} แทงหวยทุกประเภท`}>
    <p>
      {BRAND_NAME} ระบุข้อมูลอัตราจ่ายหวยออนไลน์สำหรับหมายเลข 2 ตัวและ 3 ตัว
      <strong class="text-[#b00718]">โดยมีอัตราที่กล่าวถึงคือ 2 ตัว 100 และ 3 ตัว 1,000</strong>
      ผู้ใช้งานควรตรวจสอบว่าอัตราดังกล่าวคำนวณจากเงินเดิมพันจำนวนเท่าใด และใช้กับหวยประเภทใดบ้าง
      <strong class="text-[#b00718]">เนื่องจากหวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยหุ้นอาจมีข้อกำหนดแตกต่างกัน</strong>
      รวมถึงควรตรวจสอบวงเงินจ่ายสูงสุดและเงื่อนไขการรับรางวัลก่อนทำรายการ
    </p>
  </ContentBoxPremium>

  <ContentBoxHuay as="h3" title="อัตราจ่าย 2 ตัว ถูกรับ 100">
    <p>
      อัตราจ่ายหวย 2 ตัว 100 เป็นข้อมูลที่ระบุไว้สำหรับการเดิมพันหมายเลขสองหลัก
      <strong class="text-[#b00718]">โดยควรตรวจสอบว่าใช้กับเลขสองตัวบนหรือสองตัวล่าง และคำนวณจากเงินเดิมพันจำนวนเท่าใด</strong>
      เพราะแต่ละประเภทอาจกำหนดอัตราจ่ายไม่เท่ากัน ก่อนยืนยันรายการควรตรวจสอบหมายเลขที่เลือก รอบประกาศผล และเงื่อนไขการจ่ายรางวัลให้ครบถ้วน
      <strong class="text-[#b00718]">เพื่อหลีกเลี่ยงความเข้าใจคลาดเคลื่อนเกี่ยวกับยอดเงินที่มีสิทธิ์ได้รับ</strong>
    </p>
  </ContentBoxHuay>

  <ContentBoxHuay as="h3" title="อัตราจ่าย 3 ตัว ถูกรับ 1,000">
    <p>
      อัตราจ่ายหวย 3 ตัว 1,000 เป็นข้อมูลสำหรับผู้ที่ต้องการศึกษาการจ่ายรางวัลหมายเลขสามหลัก
      <strong class="text-[#b00718]">โดยควรตรวจสอบว่าอัตราดังกล่าวใช้กับสามตัวตรง สามตัวโต๊ด หรือการเดิมพันรูปแบบใด</strong>
      รวมถึงฐานเงินเดิมพันและวงเงินจ่ายสูงสุดของแต่ละรายการ ก่อนยืนยันบิลควรตรวจสอบหมายเลขและประเภทหวยให้ถูกต้อง
      <strong class="text-[#b00718]">เพราะผลการออกรางวัลไม่สามารถรับประกันได้จากสถิติหรือเลขย้อนหลัง</strong>
    </p>
  </ContentBoxHuay>

  <ContentBoxSevenThreeHuay as="h2" title={`วิธีการสมัครแทงหวย ${BRAND_NAME} ด้วยมือถือ 3 ขั้นตอน`}>
    <div slot="left" class="flex flex-col gap-4">
      <p>
        {BRAND_NAME} ระบุช่องทางสมัครสมาชิกผ่านโทรศัพท์มือถือ
        <strong class="text-[#b00718]">โดยขั้นตอนทั่วไปประกอบด้วยการเข้าสู่หน้าลงทะเบียน กรอกข้อมูล และยืนยันบัญชี</strong>
        ก่อนดำเนินการควรตรวจสอบข้อกำหนดด้านอายุ กฎหมายที่เกี่ยวข้อง และนโยบายความเป็นส่วนตัว เพื่อให้เข้าใจเงื่อนไขการใช้บริการและการจัดเก็บข้อมูลส่วนบุคคล
      </p>

      <p class="font-bold text-[#b00718]">ขั้นตอนที่ 1 เข้าสู่หน้าสมัครสมาชิก {BRAND_NAME}</p>
      <p>
        เปิดเว็บไซต์ {BRAND_NAME} ผ่านเบราว์เซอร์บนมือถือ
        <strong class="text-[#b00718]">ตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง</strong>
        จากนั้นเลือกเมนูสมัครสมาชิกและอ่านข้อกำหนดการเปิดบัญชี รวมถึงรายละเอียดการใช้บริการก่อนดำเนินการ
      </p>

      <p class="font-bold text-[#b00718]">ขั้นตอนที่ 2 กรอกข้อมูลและยืนยันบัญชี</p>
      <p>
        กรอกข้อมูลตามที่เว็บไซต์กำหนด ตรวจสอบความถูกต้องก่อนยืนยัน และตั้งรหัสผ่านที่คาดเดาได้ยาก
        <strong class="text-[#b00718]">ไม่ควรใช้ข้อมูลของบุคคลอื่นหรือเปิดเผยรหัสผ่านและรหัส OTP ให้ใครทราบ</strong>
      </p>

      <p class="font-bold text-[#b00718]">ขั้นตอนที่ 3 เข้าสู่ระบบและตรวจสอบรายละเอียดหวย</p>
      <p>
        หลังลงทะเบียนเรียบร้อย สามารถศึกษารายการหวยที่เปิดให้บริการ รอบปิดรับ อัตราจ่าย และข้อกำหนดการเดิมพัน
        <strong class="text-[#b00718]">หากมีข้อสงสัยเกี่ยวกับระบบสมาชิกควรสอบถามเจ้าหน้าที่ผ่านช่องทางทางการก่อนทำรายการ</strong>
      </p>
    </div>

    <Picture
      slot="right"
      src={signupPoster}
      loading="lazy"
      fetchpriority="low"
      widths={posterWidths}
      sizes={posterSizes}
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={64}
      alt={posterAlt}
      class="mx-auto h-auto w-full max-w-[375px] rounded-2xl border border-[#f5b9bd] shadow-[0_10px_24px_rgba(138,4,18,0.18)]"
    />
  </ContentBoxSevenThreeHuay>

  <ContentBoxTwoHuay as="h2" title={`เว็บแทงหวย ${BRAND_NAME} มีแอดมินออนไลน์ตลอด 24ชม.`}>
    <p slot="left">
      {BRAND_NAME}
      <strong class="text-[#b00718]">ระบุช่องทางติดต่อเจ้าหน้าที่สำหรับผู้ใช้งานที่ต้องการสอบถามเกี่ยวกับการสมัครสมาชิก การเข้าสู่ระบบ ประเภทหวย รอบปิดรับ อัตราจ่าย และการตรวจสอบรายการ</strong>
      โดยควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง
    </p>
    <p slot="right">
      หากพบปัญหาเกี่ยวกับบิลหวยหรือธุรกรรม
      <strong class="text-[#b00718]">ควรเก็บหมายเลขรายการและหลักฐานที่เกี่ยวข้องไว้สำหรับตรวจสอบ</strong>
      พร้อมแจ้งรายละเอียดให้ชัดเจน โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ทั้งนี้
      <strong class="text-[#b00718]">ควรตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุดอีกครั้ง</strong>
    </p>
  </ContentBoxTwoHuay>

  <Faq as="h2" title={`คำถามที่พบบ่อยเกี่ยวกับ ${BRAND_NAME}`} faqs={faqs} />

  <LatestWinners />

  <ReviewCardSumo />

  <Navfoot />
</MainLayout>
