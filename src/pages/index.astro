---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement2.astro";
import LatestWinners from "../components/LatestWinners4.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import ContentBox from "../components/ContentBox.astro";
import Faq from "../components/Faq3.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgThreeDigit from "../assets/slide1.png";
import imgTwoDigit from "../assets/slide2.png";

// VARIANT ROTATION THIS ROUND (หวยเฮง24 -> หวยเฮง789). Zero file reuse from the
// previous round: Announcement2 replaces Announcement5, LatestWinners4 replaces
// LatestWinners2, Faq3 replaces Faq2, ReviewCardSumo replaces ReviewCardSumo2,
// and the ContentBox shape-mix moves off Premium / TwoPremium / FloatingBadge /
// SevenThreePremium / SevenThreeFloatingBadge / Special onto Neumorphism /
// TwoNeumorphism / CyberCut / SevenThreeCyberCut / SevenThreeNeumorphism /
// TwoCyberCut. NavbarHuay and FooterHuay are the layout's pair this round
// (previously NavbarStyle6 / FooterStyle3).
// Plain ContentBox is the one deliberate carry-over: terms, privacy, 404 and
// every button page render their body through it by rule and cannot follow a
// rotation, so it is always-live and the orchestrator rethemes it in the shared
// step.
// Every Premium / FloatingBadge / Special / Cyber file, Faq2, Announcement5,
// LatestWinners2, ReviewCardSumo2, NavbarStyle6 and FooterStyle3 stay on disk as
// inventory for the next brand — none of them was deleted, and the previous
// brand's copy and colour still inside them is expected drift, not a bug. The
// *Huay ContentBox/Faq/LatestWinners family is deliberately NOT used here even
// though this is a lottery brand: it belongs to /ตรวจหวย and /แนวทาง, which keep
// their own theme.
//
// <Announcement /> runs bare on purpose: Announcement2's default message is
// already this brand's copy and every sub-page calls it bare too, so passing an
// override here is exactly how the ticker ends up saying two different things on
// two pages of the same site.
//
// IMAGE ROLES FOR THIS DROP (2026-10-01). Two files are referenced from this page
// and only two, and the pairing is read off the artwork itself, not off the file
// number — they are the opposite way round from what the numbering suggests:
//   slide2.png — the gold-edged pill under the headline reads "2ตัวจ่าย100บาท"
//     and she holds a RED ball marked 2 with a white ball marked 5 beside it, so
//     it belongs to docx H3 #4. Imported as imgTwoDigit.
//   slide1.png — the pill reads "3ตัวจ่าย1,000บาท" and she holds a WHITE ball
//     marked 3 while pointing forward, so it belongs to docx H3 #5. Imported as
//     imgThreeDigit.
// Both files measure 600x400, so 600 is the top real candidate width — nothing
// above it would be a real pixel — and each picture carries max-w-[600px] so the
// art is never upscaled past its own bitmap. Each slide sits in a
// ContentBoxSevenThree* image+text block, which is that family's hard cap of two
// per rebrand, so there is no third SevenThree anywhere on the site.
// The two blocks mirror each other: SevenThreeCyberCut lays out
// md:grid-cols-[3fr_7fr] so its picture goes in slot="left", and
// SevenThreeNeumorphism lays out md:grid-cols-[7fr_3fr] so its picture goes in
// slot="right" while the paragraph keeps the wide column. The two pictures
// therefore alternate sides instead of stacking down the same edge, and each
// `sizes` describes its own 3fr column rather than the viewport.
//
// The alt text was written from THIS drop's artwork (a deep-red satin ground with
// gold Thai ornament and sweeping gold light rays, banks of gold coins and Thai
// lottery tickets, red-and-white numbered lottery balls, a woman in a white-and-
// gold Thai dress with gold jewellery, the red-and-gold หวยเฮง789 wordmark and
// huge gold Thai type reading อัตราจ่ายหวย).
//
// Deliberately NOT imported, and every file still on disk:
//   slide3.png / slide4.png / banner2.png / banner3.png all predate this drop and
//   belong to previous brands — importing any of them would emit a competitor's
//   artwork into dist/, so there is no inline article illustration this round.
//   banner1.png and banner1-mobile.png belong to MainLayout's own pinned globs and
//   are never referenced from a page — the hero is the LCP element, so nothing here
//   gets loading="eager" fetchpriority="high". og.png is the same: MainLayout owns it.
//
// Vocabulary: หวยเฮง789 is a เว็บแทงหวยออนไลน์ — หวย, โพย, ส่งโพย, เลข 2 ตัว / 3 ตัว,
// เลขเด็ด, เลขดัง, อัตราจ่าย, รอบ, เวลาปิดรับ, งวด, ผลรางวัล, วงเงิน, หวยรัฐบาลไทย,
// หวยฮานอย, หวยลาว, หวยหุ้นต่างประเทศ, สมัครสมาชิก, Login, แอดมิน 24 ชั่วโมง. The brand
// before this one sold a different lottery line-up and the ones before that sold
// football and slots; every one of those words (ลาวพัฒนา, ฮานอยวีไอพี, บอล, ค่าน้ำ,
// อัตราต่อรอง, ลีก, สล็อต, ฟรีสปิน, RTP, คาสิโน …) is gone, and the page was rewritten
// from the brief rather than find-and-replaced over the old sentences. The previous
// round's ฝากถอนวอลเลทและธนาคาร and เช็คผลทันที angles are not in this brief either and
// were dropped rather than re-typed; this brief's angles are เลขเด็ด / เลขดัง,
// ไม่จำกัด / แทงได้ไม่อั้น (always with the วงเงิน caveat), and บัญชีเดียวครบทุกประเภทหวย.
// Nothing here claims a licence, an operator, a bank, a deposit minimum, a member
// count or a founding year, because the brief names none. The only figures are the
// brief's own: 2 ตัว จ่าย 100 บาท, 3 ตัว จ่าย 1,000 บาท, 3 ขั้นตอน, 24 ชั่วโมง. The
// brief's own hedging ships with the copy ("ควรอ้างอิงวงเงินที่ระบบเปิดรับจริง",
// "ไม่สามารถรับประกันผลรางวัลได้", "อัตราจ่ายอาจแตกต่างกันตามประเภทหวย") — it is part of
// the paragraphs, not trimmed as downbeat.
//
// Title and description are the brief's own Title/Description lines, used verbatim.
// The description ships at 112 characters, the length the brief wrote it — it is
// not padded up to 150.
const pageTitle = "หวยเฮง789 รับแทงหวย เลขเด็ด เลขดัง ไม่จำกัด แทงได้ไม่อั้น";

const pageDescription = "หวยเฮง789 เปิดรับแทงหวยออนไลน์ เลขเด็ด เลขดัง ทุกตัว รัฐบาลไทย ฮานอย ลาว หุ้นต่างประเทศ ไม่จำกัด แทงได้ไม่อั้น";

// The brief has a real H2 -> H3 nesting this round, so the page is NOT flattened to
// H2-only. The two H3s are genuine headings — the two payout sub-points, both
// nested under the อัตราการจ่าย H2 — and they stay H3.
//
// The checklist, in document order, and what carries each one:
//    1 H1  หวยเฮง789 รับแทงหวย เลขเด็ด เลขดัง ไม่จำกัด แทงได้ไม่อั้น
//          ContentBoxNeumorphism, brief paragraphs 1 + 2
//    2 H2  เว็บ หวยเฮง789 รัฐบาลไทย ฮานอย ลาว หุ้นต่างประเทศ ไม่จำกัด แทงได้ไม่อั้น
//          ContentBoxTwoNeumorphism, para 1 left + para 2 right
//    3 H2  อัตราการจ่าย หวยเฮง789 2ตัว จ่าย100บาท 3ตัว จ่าย1,000บาท
//          ContentBoxCyberCut, both paragraphs in one wrapper
//    4 H3  2ตัว จ่าย100บาท
//          ContentBoxSevenThreeCyberCut + slide2 (imgTwoDigit)
//    5 H3  3ตัว จ่าย1,000บาท
//          ContentBoxSevenThreeNeumorphism + slide1 (imgThreeDigit)
//    6 H2  สมัครแทงหวย หวยเฮง789 ง่ายๆ 3ขั้นตอน
//          ContentBoxTwoCyberCut, para 1 left + para 2 right
//    7 H2  ติดต่อแอดมินเว็บ หวยเฮง789 ได้ ตลอด 24 ชั่วโมง
//          ContentBox + LINE / สมัครสมาชิก buttons
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ หวยเฮง789
//          Faq3 + faqs prop
// Final inventory for this page: h1 x1, h2 x5, h3 x2.
//
// Every brief paragraph ships in full. Sections 1, 2, 3, 6 and 7 each have TWO
// paragraphs and both ship, nothing merged or summarised: in the two-column blocks
// they run one per column, in the single-column blocks they stack inside one
// wrapper div (one element per slot). The column labels passed to
// ContentBoxTwoNeumorphism and ContentBoxTwoCyberCut are this page's own layout
// wording, not brief headings, and both variants render them as <p>.
//
// Everything else on the page is chrome and emits no heading tag at any level:
// Announcement2, LatestWinners4, LoginRtpSection and ReviewCardSumo render their
// titles as <p>/<span> with an aria-label on the section, and Faq3's questions live
// inside <summary> as <p>. The non-brief widgets sit before section 1
// (LatestWinners4, right after the ticker) and after section 8 (LoginRtpSection,
// ReviewCardSumo, Navfoot) — never spliced between two content sections.

// One array, used by both <Faq> and the FAQPage node — never the component's own
// defaults, which belong to whichever brand shipped last. The three pairs are the
// brief's own Q/A block, verbatim.
const faqs = [
  {
    q: "หวยเฮง789 มีหวยประเภทไหนให้เลือกแทง?",
    a: "มีทั้งรัฐบาลไทย หวยฮานอย หวยลาว และหวยหุ้นต่างประเทศตามรายการที่ระบบเปิดรับ สมาชิกควรตรวจสอบตารางรอบ เวลาปิดรับ และอัตราจ่ายล่าสุดก่อนส่งโพยทุกครั้ง",
  },
  {
    q: "หวยเฮง789 แทงเลขเด็ด เลขดัง ได้ไม่จำกัดจริงหรือไม่?",
    a: "สามารถเลือกเลขที่ต้องการได้ตามรายการที่เปิดรับ แต่จำนวนเงินสูงสุดอาจขึ้นอยู่กับประเภทหวย รอบ และวงเงินของเลขนั้น จึงควรตรวจสอบยอดที่ระบบอนุญาตก่อนยืนยันโพย โดยเฉพาะเลขที่มีผู้เลือกจำนวนมาก",
  },
  {
    q: "หวยเฮง789 2 ตัวจ่าย 100 และ 3 ตัวจ่าย 1,000 ใช้กับทุกหวยหรือไม่?",
    a: "อัตราจ่ายอาจแตกต่างกันตามประเภทหวยและรูปแบบการเดิมพัน ไม่ควรถือว่าใช้กับทุกรายการเหมือนกัน สมาชิกควรตรวจสอบอัตรา 2 ตัวและ 3 ตัวที่แสดงในหน้าส่งโพยของแต่ละรอบก่อนยืนยัน",
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space that
// splits the word — the copy must read identically with the tags removed. One
// highlight colour only: #ffefc2, the wordmark's light gold, against the inherited
// body colour #fbe3d4 (BRAND_TEXT). The paragraphs below carry no colour class of
// their own: every ContentBox* card in this mix already sets
// `text-left text-base leading-relaxed text-[#fbe3d4]` on the element holding the
// slot, so the prose inherits it and no page-level override can drift from the card.

// No breadcrumb: this is the homepage, so a trail from the root to itself would be a
// single self-referential crumb. Every URL in the graph is derived by pageGraph from
// `site:` — no domain is typed out in this file, and no Review / AggregateRating /
// sameAs / address node is passed.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <LatestWinners />

  <ContentBoxNeumorphism as="h1" title="หวยเฮง789 รับแทงหวย เลขเด็ด เลขดัง ไม่จำกัด แทงได้ไม่อั้น">
    <div class="flex flex-col gap-5">
      <p>
        หวยเฮง789
        <strong class="text-[#ffefc2]">เปิดให้เลือกแทงหวยออนไลน์หลายประเภทผ่านบัญชีเดียว</strong>
        <strong class="text-[#ffefc2]">รองรับทั้งรัฐบาลไทย หวยฮานอย หวยลาว และหวยหุ้นต่างประเทศ</strong>
        สมาชิกสามารถเลือกเลขเด็ด เลขดัง หรือชุดตัวเลขที่สนใจด้วยตัวเอง พร้อมตรวจสอบรอบ อัตราจ่าย และรายละเอียดโพยก่อนยืนยันรายการ ระบบรองรับการใช้งานผ่านมือถือ ช่วยให้ติดตามรอบหวย ส่งโพย และตรวจสอบผลได้จากหน้าเว็บไซต์โดยไม่ต้องสลับใช้งานหลายบัญชี
      </p>
      <p>
        สำหรับคำว่า “ไม่จำกัด” และ “แทงได้ไม่อั้น”
        <strong class="text-[#ffefc2]">ควรอ้างอิงวงเงินที่ระบบเปิดรับจริง</strong>
        เนื่องจากหวยแต่ละประเภท เลขแต่ละชุด และแต่ละรอบอาจกำหนดวงเงินแตกต่างกัน
      </p>
    </div>
  </ContentBoxNeumorphism>

  <ContentBoxTwoNeumorphism
    as="h2"
    title="เว็บ หวยเฮง789 รัฐบาลไทย ฮานอย ลาว หุ้นต่างประเทศ ไม่จำกัด แทงได้ไม่อั้น"
    titleleft="ประเภทหวยที่เปิดรับ"
    titleright="ข้อควรตรวจก่อนส่งโพย">
    <p slot="left">
      เว็บ หวยเฮง789
      <strong class="text-[#ffefc2]">รวมรายการหวยที่ได้รับความสนใจไว้หลายรูปแบบ</strong>
      มีทั้งรัฐบาลไทยตามกำหนดออกรางวัล หวยฮานอยและหวยลาวตามรอบที่เปิดรับ รวมถึงหวยหุ้นต่างประเทศตามตลาดที่ระบบรองรับ
      <strong class="text-[#ffefc2]">สมาชิกสามารถเลือกประเภทหวย ดูเวลาปิดรับ และตรวจสอบอัตราจ่ายก่อนเลือกตัวเลขได้จากบัญชีเดียว</strong>
    </p>
    <p slot="right">
      ผู้ที่ติดตามเลขเด็ดหรือเลขดังสามารถนำตัวเลขมาเลือกแทงตามรูปแบบที่ระบบเปิดรับได้
      <strong class="text-[#ffefc2]">แต่ตัวเลขดังกล่าวไม่สามารถรับประกันผลรางวัลได้</strong>
      ก่อนส่งโพยควรตรวจสอบเลข ยอดเดิมพัน และวงเงินที่รับได้ในรอบนั้น
      <strong class="text-[#ffefc2]">โดยเฉพาะเลขที่มียอดเดิมพันจำนวนมากซึ่งอาจมีข้อจำกัดแตกต่างจากเลขทั่วไป</strong>
    </p>
  </ContentBoxTwoNeumorphism>

  <ContentBoxCyberCut as="h2" title="อัตราการจ่าย หวยเฮง789 2ตัว จ่าย100บาท 3ตัว จ่าย1,000บาท">
    <div class="flex flex-col gap-5">
      <p>
        หวยเฮง789 มีอัตราจ่ายสำหรับรายการที่เข้าเงื่อนไข โดยมี
        <strong class="text-[#ffefc2]">2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท</strong>
        ตามประเภทหวยและรูปแบบการเดิมพันที่กำหนด
        <strong class="text-[#ffefc2]">สมาชิกสามารถตรวจสอบอัตราล่าสุดก่อนยืนยันโพย</strong>
        เพื่อให้ทราบรายละเอียดของรายการและอัตราที่ใช้คำนวณอย่างชัดเจน
      </p>
      <p>
        รัฐบาลไทย ฮานอย ลาว และหุ้นต่างประเทศอาจไม่ได้ใช้อัตราเดียวกันทุกประเภท
        <strong class="text-[#ffefc2]">จึงควรยึดอัตราที่ปรากฏในหน้าส่งโพยของรอบนั้นเป็นหลัก</strong>
      </p>
    </div>
  </ContentBoxCyberCut>

  <ContentBoxSevenThreeCyberCut as="h3" title="2ตัว จ่าย100บาท">
    <Picture
      slot="left"
      src={imgTwoDigit}
      loading="lazy"
      fetchpriority="low"
      widths={[346, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), (max-width: 1279px) calc(30vw - 38px), 346px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="ภาพโปสเตอร์อัตราจ่ายหวยของ หวยเฮง789 พื้นหลังเป็นผ้าซาตินสีแดงเข้มมีริ้วแสงสีทองพาดเป็นวงรอบภาพ ด้านซ้ายเป็นหญิงสาวผมยาวสวมชุดไทยสีขาวประดับทอง สวมต่างหูและสร้อยทอง มือซ้ายชูลูกหวยสีแดงหมายเลข 2 ขึ้นข้างใบหน้า โดยมีลูกหวยสีขาวหมายเลข 5 อยู่ถัดไปทางซ้าย และแบมือขวาออกมาเหนือกองเหรียญทองกับสลากกินแบ่งที่เรียงอยู่ด้านล่าง มุมขวาบนมีลูกหวยสีแดงหมายเลข 8 มุมขวาล่างมีลูกหวยสีแดงหมายเลข 9 กลางภาพด้านขวาเป็นโลโก้ หวยเฮง789 ที่คำว่า หวย เป็นสีแดงและ เฮง789 เป็นสีทอง ใต้ลงมาเป็นตัวอักษรไทยสีทองขนาดใหญ่ว่า อัตราจ่ายหวย และป้ายสีดำขอบทองคาดข้อความ 2ตัวจ่าย100บาท"
      class="mx-auto h-auto w-full max-w-[600px] rounded-2xl border border-[#f4bc5d]/60 shadow-[0_10px_30px_rgba(244,188,93,0.30)]"
    />
    <p slot="right">
      สำหรับรายการที่กำหนดอัตรา 2 ตัว จ่าย 100 บาท
      <strong class="text-[#ffefc2]">สมาชิกสามารถเลือกตัวเลขและจำนวนเงินตามวงเงินที่ระบบเปิดรับ</strong>
      ก่อนยืนยันควรตรวจสอบว่ารายการดังกล่าวใช้กับหวยประเภทใด
      <strong class="text-[#ffefc2]">รวมถึงดูอัตราจ่ายและรายละเอียดของเลข 2 ตัวให้เรียบร้อย</strong>
      เพื่อให้ตรงกับโพยที่ต้องการส่ง
    </p>
  </ContentBoxSevenThreeCyberCut>

  <ContentBoxSevenThreeNeumorphism as="h3" title="3ตัว จ่าย1,000บาท">
    <p slot="left">
      รายการที่กำหนดอัตรา 3 ตัว จ่าย 1,000 บาท
