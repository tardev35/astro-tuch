---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxTwo from "../components/ContentBoxTwo.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBox3ThreePremium from "../components/ContentBox3ThreePremium.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import Faq from "../components/Faq4.astro";
import LatestWinners from "../components/LatestWinners2.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import { pageGraph } from "../lib/schema";
import cashbackPoster from "../assets/slide2.png";
import referralPoster from "../assets/slide1.png";

// การหมุน variant รอบนี้ตัดสินไว้แล้วใน .claude/brand-spec-123bet.md §3 —
// **ห้ามเลือกใหม่ที่นี่** แบรนด์ขาออก (ZORO365) ถูกหมุนออกจากทุกตระกูลพร้อมกัน:
// Announcement5 แทน Announcement3 · Faq4 แทน Faq3 · LatestWinners2 แทน
// LatestWinnersCyber · ReviewCardSumo2 แทน ReviewCardSumo · ProviderGrid ตัวฐาน
// แทน ProviderGridPremium · และ shape-mix ของ ContentBox ทิ้งชุด Neumorphism +
// Premium + TwoCyberCut ของรอบก่อนทั้งชุด ไปใช้ **CyberCut x2 + ตัวฐาน x3 +
// 3ThreePremium + Special** แทน
// ไม่ลบไฟล์ที่ไม่ได้ใช้แม้แต่ตัวเดียว — มันคือ inventory ของแบรนด์ถัดไป
// Navbar/Footer อยู่ที่ MainLayout (NavbarPremium / FooterPremiumSumo) ไม่ใช่ที่ไฟล์นี้
// ❌ รอบนี้ **ไม่ใช้ BankStrip / FeatureHighlights / SmoothCarousel / LottoGrid /
// ตระกูล *Huay** — บรีฟรอบนี้ไม่มีหมวดฝากถอน ธนาคาร วอลเลท หรือออโต้เลยแม้แต่คำเดียว
// ⚠️ `<Announcement />` ถูกเรียกแบบ **ไม่ส่ง message** โดยตั้งใจ — orchestrator ตั้ง
// ค่า default ของ Announcement5 เป็นคอปปี้ของแบรนด์รอบนี้ไว้แล้ว และหน้าย่อยทุกหน้า
// ก็เรียกแบบ bare เหมือนกัน ข้อความ ticker จึงตรงกันทั้งเว็บจากที่เดียว
//
// ⚠️⚠️ พาเลตรอบนี้ (brand-spec §2 ล็อกค่าไว้ ห้ามเดาเพิ่ม ห้ามดูดสีจากรูป):
// 🚨🚨 **กลับทิศ 180° จากรอบก่อน — รอบนี้ "เนื้อหาสว่าง + โครมเข้ม"** (รอบก่อน
// ZORO365 มืดทั้งเว็บ) พื้นเพจ #f7e4e9 (bg.json) = ชมพูบลัชจาง · การ์ด #fdf5f6 ·
// ชั้นยก #f7dfe4 · เส้นบาง #eec3cc · ขอบ/ออรา #d98fa0 · โครม #330710 / #1c050b /
// #4d0c18 · หมึก #36080f (= BRAND_TEXT) · หมึกรอง #6b2b33 · ทองเข้ม #7a4a0c ·
// **หัวข้อ + <strong> = #a30d1a** (7.4:1 บนการ์ด · 6.6:1 บนพื้นเพจ)
// 🚨🚨 **#eec3cc (1.5:1) · #d98fa0 (2.3:1) · #ef4a5e ห้ามถือตัวอักษรเด็ดขาด** —
// เส้น/ขอบ/ออรา/พื้นถมเท่านั้น
// 🚨🚨 **รอบนี้แดงชาดคือฮิวนำของแบรนด์** ซึ่งกลับทิศจาก spec สามรอบก่อนที่เขียนว่า
// "ไม่มีแดงเป็นสี UI เลยสักเฉด" — ที่ห้ามคือ **ค่าเฮกซ์ของแบรนด์เก่าแบบตรงหกหลัก**
// ไม่ใช่ "สีแดง" ในฐานะตระกูลสี และ **LOTTO189 เป็นแบรนด์ที่ใกล้ตัวที่สุดรอบนี้**
// (แดง/ทอง/ขาวชมพูเหมือนกันทั้งชุด) ลิสต์เฮกซ์เต็มอยู่ที่ brand-spec §2
// ✅ LINE green 00B900 กับเขียว success ของฟีดเป็นสีเชิงความหมาย **คงไว้
// ห้ามกลืนเข้าพาเลตแดงของรอบนี้**
//
// ย่อหน้าในไฟล์นี้ไม่ถือคลาสสีหรือขนาดของตัวเอง — ทุก ContentBox* ในมิกซ์นี้ตั้ง
// `text-left text-base leading-relaxed` + หมึก #36080f ไว้บน element ที่ถือ slot
// อยู่แล้ว และไม่มี `<p>` ไหนมี mx-auto / max-w-* (การ์ดคุมความกว้างเองแล้ว)
//
// ⚠️ ชื่อแบรนด์รอบนี้เป็น **ตัวเลข 123 ติดกับตัวละตินพิมพ์ใหญ่ BET เป็นคำเดียว**
// (ต่างจากโดเมนที่มีขีดและมีคำว่า play) แต่ยัง interpolate จาก `${BRAND_NAME}`
// ทุกจุดรวมถึงใน alt ของสไลด์ **ห้ามพิมพ์ชื่อแบรนด์เป็นตัวอักษรตรงๆ ที่ไหนเลย**
// ไม่มีโดเมนเขียนไว้ที่ไหน และไม่มี URL ที่ต่อด้วย `+`
//
// <strong> ทุกตัวคร่อม "ก้อนที่คั่นด้วยช่องว่าง" ทั้งก้อน เพราะภาษาไทยไม่มีช่องว่าง
// ระหว่างคำ — อ่านคอปปี้โดยถอดแท็กออกต้องได้ข้อความของบรีฟเป๊ะ
//
// บรีฟรอบนี้ **โฆษณาและกำกับในย่อหน้าเดียวกัน** (brand-spec §5): หัวข้อเขียนว่า
// เจ้าของบาคาร่าสล็อต · เว็บตรง · ถูกลิขสิทธิ์ · เซิร์ฟแท้ · ปลอดภัยในไทย ·
// ครบทุกค่าย · ไม่มีขั้นต่ำ ขณะที่ย่อหน้าของบรีฟเองตอบกลับว่า ควรตรวจสอบข้อมูล
// บริษัทและหลักฐานการได้รับอนุญาตจากแหล่งที่เชื่อถือได้ก่อนใช้งาน · คำกล่าวอ้างว่า
// ใช้เซิร์ฟเวอร์แท้หรือปลอดภัยในไทยยืนยันจากข้อความโฆษณาเพียงอย่างเดียวไม่ได้ ·
// โปรโมชั่นคืนยอดเสียไม่ได้รับประกันว่าจะได้รับเงินคืนจากทุกการเดิมพัน ·
// ควรตรวจสอบว่าข้อความไม่มีขั้นต่ำครอบคลุมเฉพาะการสมัครหรือรวมถึงการฝากเงินและ
// การเดิมพันด้วย — **ship ทั้งสองครึ่งตรงตามที่บรีฟเขียน ไม่ขยายคำโฆษณาเป็นคำ
// กล่าวอ้างใหม่ และทุกประโยคกำกับ ship ครบ ไม่ตัดเพราะฟังดูลบ**
// ตัวเลขบนหน้านี้มีแค่ของบรีฟเอง: **0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง/24ชม.**
// ❌ ไม่มีจำนวนสมาชิก ไม่มีปีก่อตั้ง ไม่มี 100% ไม่มีค่า RTP ไม่มีจำนวนค่าย/เกม
// ไม่มียอดฝากขั้นต่ำเป็นตัวเลข
// ⚠️ `หวยออนไลน์` ใช้ได้เฉพาะในฐานะ **หนึ่งในเจ็ดหมวดเกม** ตามที่บรีฟเขียน —
// ไม่มีเนื้อหาเฉพาะทางหวย (งวด · เลขเด็ด · สลาก · โพย · รอบปิดรับ · สองตัวบน-ล่าง ·
// สามตัวตรง-โต๊ด · ลอตโต้) บนหน้านี้เลย
// 🚨 สามคำนี้ **กลับทิศจากรอบก่อน** และเป็นถ้อยคำของบรีฟรอบนี้เอง (บรรทัด 1-3):
// `ปลอดภัยในไทย` · `ถูกลิขสิทธิ์` · `เว็บตรง` — **ห้ามลบออกเพราะอ่านคอมเมนต์เก่า
// ในไฟล์ inventory แล้วเข้าใจผิด**
// ❌ คำของแบรนด์ก่อนห้ามเขียนกลับเข้ามา: ZORO365 / เกมคาสิโนสายตรง / แทงได้เท่าไหร่ /
// เว็บจ่ายเต็ม / ไม่มีโกง / ไม่ผ่านเว็บตัวแทน (ขาออกทันที) · TEVA69 /
// เกมพนันเบอร์ต้นๆของไทย / เซิร์ฟนอก · LOTTO189 / แนะนำเว็บหวยลอตโต้ / แทงหวยจ่ายสด /
// อัตราจ่าย 2 ตัว 100 · ZANE96 / เว็บตรงไม่ผ่านเอเย่นต์ · ZNOVA168 / ฟรีสปิน /
// ค่า RTP · MEXICANOSLOT / การันตีเว็บตรง · okkub88 / ยูสใหม่แตกไว / ทรูวอลเลท /
// ทรูมันนี่ · รวยเทพ168 · เว็บตรงแตกง่าย / เบทต่ำ / ไม่ทำเทิร์น / ไม่ผ่านเอเย่นต์100%
//
// title/description = บรรทัด 1-2 ของบรีฟ **verbatim** (src/assets/content.txt)
// ส่งที่นี่เพราะ pageGraph ต้องใช้สตริงเดียวกับที่ MainLayout ได้รับ
// **ห้ามต่อเติม** (description = 139 ตัวอักษร ตามที่บรีฟเขียนมาเอง และ
// verify-build ยกเว้นเพดานล่าง 150 ให้หน้าแรกไว้ด้วยเหตุผลนี้โดยเฉพาะ)
const pageTitle = `${BRAND_NAME} เจ้าของบาคาร่าสล็อต ถูกลิขสิทธิ์ เซิร์ฟแท้ ปลอดภัยในไทย`;

const pageDescription = `${BRAND_NAME} เจ้าของบาคาร่าสล็อต เว็บตรง ถูกลิขสิทธิ์ ครบทุกค่าย ไฮโล รูเล็ต ยิงปลา บอล หวย เข้าเล่นได้ 24 ชั่วโมง เซิร์ฟแท้ ปลอดภัยในไทย`;

// บรรทัด 3 ของบรีฟ ซึ่ง **ต่างจากบรรทัด 1** — ใช้ตามบรีฟ ไม่ copy title
const pageH1 = `${BRAND_NAME} เจ้าของบาคาร่าสล็อต เว็บตรง ถูกลิขสิทธิ์`;

// บรีฟรอบนี้มีชั้น H1 -> H2 -> H3 จริง จึง **ไม่** แบนเป็น H2 ล้วน
//
// checklist ตามลำดับเอกสาร (brand-spec §4) และตัวที่รับแต่ละข้อ:
//    1 H1  <แบรนด์> เจ้าของบาคาร่าสล็อต เว็บตรง ถูกลิขสิทธิ์
//          ContentBoxCyberCut, ย่อหน้าบรรทัด 4
//    2 H2  <แบรนด์> บาคาร่า สล็อต ไฮโล รูเล็ต ยิงปลา บอล หวย เซิร์ฟแท้ ปลอดภัยในไทย
//          ContentBoxTwo, บรรทัด 6 แบ่งสองซีกโดยไม่ตกประโยคไหน
//          + ProviderGrid ต่อท้ายทันที (วิดเจ็ตหมวดเกมของหัวข้อนี้โดยตรง)
//    3 H2  โปรโมชั่น <แบรนด์> อัปเดตใหม่ตลอดสัปดาห์
//          ContentBox ตัวฐาน, บรรทัด 8
//    4 H3  โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน
//          ContentBoxSevenThree + slide2 ในสล็อตขวา, บรรทัด 10
//    5 H3  โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด
//          ContentBoxSevenThreeCyberCut + slide1 ในสล็อตขวา, บรรทัด 12
//    6 H2  สมัครเล่นบาคาร่าสล็อต <แบรนด์> ไม่มีขั้นต่ำ 3 ขั้นตอน
//          ContentBox3ThreePremium, intro (บรรทัด 14) เข้า default slot และ
//          ขั้นตอน 1/2/3 (บรรทัด 15-20) เข้า left/center/right
//    7 H2  แอดมิน <แบรนด์> ออนไลน์ตลอด 24ชม.
//          ContentBoxSpecial (**ส่ง as="h2" ชัดเจน**), บรรทัด 22 แบ่งสองซีก
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ <แบรนด์>
//          Faq4 + prop faqs ชัดเจน (**ส่ง as="h2"** default ของมันเป็น "p"),
//          บรรทัด 24-29
// inventory ที่ต้องได้: **h1 ×1 · h2 ×5 · h3 ×2** — ตรงเป้าของ brand-spec §4
//
// ⚠️ จุดที่ชั้น heading รั่วได้ และกันไว้แล้วทุกจุด: บรรทัด 15/17/19 ของบรีฟ
// (ขั้นตอนที่ 1/2/3) **ไม่มี prefix H** จึงส่งเข้า titleleft/titlecenter/titleright
// ของ ContentBox3ThreePremium โดย **ไม่ส่ง `heading`** (default false -> <p>) ·
// **ไม่ส่ง titleright ให้ ContentBoxTwo และ SevenThree ทั้งสองใบ** คอลัมน์ภาพและ
// ซีกขวาจึงไม่มี heading · คำถามใน Faq4 เป็น <span> ใน <summary> ไม่ใช่ heading
// grep `<h[1-6]` ในทุก component ที่ไฟล์นี้เรียกแล้วรอบนี้ — ไม่มีตัวไหน hardcode
// heading ไว้เลย ทุกแท็ก heading บนหน้ามาจาก prop คือมาจากบรีฟ
// chrome บนหน้านี้ (Announcement5 · ProviderGrid · LatestWinners2 ·
// ReviewCardSumo2 · Navfoot) ขึ้นป้ายเป็น <p>/<span> พร้อม aria-label บน <section>
// **ห้ามเลื่อน <p> พวกนั้นขึ้นเป็น h2 เพื่อ "แก้ชื่อที่ขาด"**
//
// ── รูปภาพ ────────────────────────────────────────────────────────────────
// รอบนี้ใช้ **สองใบ** และอยู่ในตระกูล SevenThree ทั้งคู่ (playbook ตรึง slide* ไว้
// กับตระกูลนี้ และเพดานคือ 2 บล็อก — รอบนี้ใช้ครบพอดี ไม่มีใบที่สาม)
// **ข้อความที่พิมพ์บนอาร์ตเวิร์กคือตัวตัดสินการจับคู่ ไม่ใช่ลำดับไฟล์** (เปิดอ่าน
// บิตแมปจริงแล้วรอบนี้):
//   slide2.png พิมพ์ **คืนยอดเสีย 0.3%** -> §4 (ContentBoxSevenThree)
//   slide1.png พิมพ์ **แนะนำเพื่อน 0.8%** -> §5 (ContentBoxSevenThreeCyberCut)
// ⚠️⚠️ **กลับข้างจากรอบก่อน** (รอบก่อน slide1 = คืนยอดเสีย) — uploader เขียนทับ
// สองไฟล์นี้ทุกดรอป การจับคู่จึงไม่มีความหมายข้ามแบรนด์ **ห้ามลอกจากรอบก่อน**
// ⛔ **banner1 / banner1-mobile / og.png เป็นของ MainLayout** (glob ปักชื่อไว้แล้ว)
// และ **banner2.png / banner3.png / slide3.png / slide4.png เป็นอาร์ตเวิร์กของ
// แบรนด์อื่น ห้าม import เด็ดขาด** เพราะ eager import = emit ขึ้น dist ทุก build
// แม้ไม่มีหน้าไหน render และ verify-build.mjs จะแดงถ้ามีรูปที่ไม่ได้ถูก render
// ⚠️ ไม่มีภาพไหนบนหน้านี้เป็น LCP (hero อยู่ที่ MainLayout) จึง **ไม่มี
// loading="eager" / fetchpriority="high"** สักใบ สไลด์ทั้งสองอยู่ใต้ fold
//
// `widths`/`sizes` คำนวณจากเรขาคณิตจริงของคอลัมน์ภาพ (3fr ฝั่งขวา) ของ **variant
// ที่ถือรูปใบนั้นจริง ๆ** — สองชุดนี้ **สลับกันไม่ได้** และ **ไม่ได้ลอกจากรอบก่อน**
// (รอบก่อนคิดจาก ContentBoxSevenThreePremium + ContentBoxSevenThreeNeumorphism
// ซึ่งเป็นคนละไฟล์กับรอบนี้ทั้งคู่) Tailwind เป็น border-box ทั่วโปรเจกต์ max-w/
// padding จึงนับรวมกัน · บิตแมปจริงของดรอปนี้ **375x600 ทั้งสองใบ** เพดานจึงเป็น
// **375 และห้ามมี candidate ไหนเกิน 375** เพราะเกินกว่านั้นคือการอัพสเกล
//
// §4 ContentBoxSevenThree ตัวฐาน — **max-w-7xl อยู่ที่ <section>** px-4 จึงถูกหัก
// ออกจาก 1280 · border 1x2 = 2 · md:p-10 = 80 · gap-10 = 40 ·
// คอลัมน์ภาพจ่าย md:pl-6 (24) ส่วน md:border-r + md:pr-6 อยู่ที่คอลัมน์ข้อความ
//   >= 1280px : (1280 - 32 - 2 - 80 - 40) x 0.3 - 24 = 1126 x 0.3 - 24 = 314px
//   768-1279  : (100vw - 154) x 0.3 - 24             = calc(30vw - 70px)
//   473-767   : ยุบเหลือคอลัมน์เดียวที่การ์ด p-8 -> 100vw - 98 ซึ่ง >= 375 จึงติด
//               เพดานบิตแมป                          = 375px
//   < 473     : คอลัมน์เดียวที่ p-8                  = calc(100vw - 98px)
// candidate: 160 = ค่าต่ำสุดของแบนด์ md (ที่ 768px) · 277 = 100vw-98 ที่จอ 375px ·
//   314 = 1x ที่ >= 1280px · 375 = **เพดานบิตแมปจริง**
const cashbackWidths = [160, 277, 314, 375];
const cashbackSizes = "(min-width: 1280px) 314px, (min-width: 768px) calc(30vw - 70px), (min-width: 473px) 375px, calc(100vw - 98px)";

// §5 ContentBoxSevenThreeCyberCut — **max-w-7xl อยู่ที่ <section>** เช่นกัน แต่
// การ์ดเป็น p-8 **ไม่มี md:p-10** · gap-8 = 32 · คอลัมน์ภาพจ่าย md:border-l (1) +
// md:pl-8 (32) = 33 — คนละชุดกับ §4 ทั้งที่ 1x และใน calc()
//   >= 1280px : (1280 - 32 - 2 - 64 - 32) x 0.3 - 33 = 1150 x 0.3 - 33 = 312px
//   768-1279  : (100vw - 130) x 0.3 - 33             = calc(30vw - 72px)
//   473-767   : คอลัมน์เดียวที่การ์ด p-8 -> 100vw - 98 ซึ่ง >= 375 จึงติดเพดาน = 375px
//   < 473     : คอลัมน์เดียวที่ p-8                  = calc(100vw - 98px)
// candidate: 158 = ค่าต่ำสุดของแบนด์ md (ที่ 768px) · 277 = 100vw-98 ที่จอ 375px ·
//   312 = 1x ที่ >= 1280px · 375 = **เพดานบิตแมปจริง**
const referralWidths = [158, 277, 312, 375];
const referralSizes = "(min-width: 1280px) 312px, (min-width: 768px) calc(30vw - 72px), (min-width: 473px) 375px, calc(100vw - 98px)";

// ⚠️ อาร์ตเวิร์กพิมพ์ชื่อแบรนด์ไว้บนรูปจริง แต่ alt บรรยาย **รูปทรงของเวิร์ดมาร์ก**
// แล้วอ้างชื่อด้วย ${BRAND_NAME} — ห้ามพิมพ์ตัวอักษรชื่อแบรนด์ลง alt ตรงๆ
// บรรยายจากบิตแมปจริงของดรอปนี้ (เปิดอ่านด้วย Read แล้ว) **ไม่ใช่คัดลอกของรอบก่อน**
// ภาษาภาพของ ZORO365 ที่ **ไม่มี** ในสองรูปนี้เลย — ห้องสไตล์ญี่ปุ่น · กอไผ่ ·
// กิโมโนเขียว-ขาว · ดาบคาทานะ · ชิปคาสิโนเขียว-ขาว · ควันเขียวเรืองแสง
// ✅ **โถงวังหินอ่อนสีงาช้าง มงกุฎทองประดับอัญมณีแดง ชุดแดง-ขาวปักทอง กำมะหยี่แดง
// ชิปคาสิโนแดง-ขาว และแคปซูลพื้นดำขอบทอง มีจริงในดรอปนี้** บรรยายได้ตามที่เห็น
const cashbackAlt = `โปสเตอร์แนวตั้งของ ${BRAND_NAME} ในโถงวังหินอ่อนสีงาช้างที่มีเสาและซุ้มโค้ง ฝั่งซ้ายเป็นหญิงสาวผมยาวสีน้ำตาลเป็นลอน สวมมงกุฎทองประดับอัญมณีแดง ชุดราตรีแดง-ขาวปักทองแต่งลูกไม้ขาว และผ้ากำมะหยี่แดง มุมบนขวาเป็นโลโก้ ${BRAND_NAME} ซึ่งเป็นเวิร์ดมาร์กสามมิติที่ครึ่งแรกเป็นตัวเลขผิวแดงชาดเคลือบเงาตัดขอบทอง ครึ่งหลังเป็นตัวอักษรละตินผิวโครเมียมเงินขัดเงา วางอยู่บนโล่ตราสัญลักษณ์ที่มีมงกุฎเงินประดับกำมะหยี่แดงอยู่ด้านบน ครึ่งล่างพิมพ์คำว่า โปรโมชั่น เป็นตัวอักษรสามมิติแดงเคลือบเงาตัดขอบทองโดยมีมงกุฎทองดวงเล็กอยู่เหนือตัวอักษร ถัดลงมาเป็นแถบแคปซูลพื้นดำขอบทองที่เขียนว่า คืนยอดเสีย แล้วตามด้วยตัวเลข 0.3% ตัวโตผิวแดงเคลือบเงาตัดขอบทอง มุมล่างขวาเป็นกองชิปคาสิโนสีแดงสลับขาว ปิดท้ายด้วยแคปซูลพื้นดำขอบทองที่เขียนว่า สมัครสมาชิก พร้อมไอคอนรูปคนกับเครื่องหมายบวกและลูกศรคู่`;

const referralAlt = `โปสเตอร์แนวตั้งของ ${BRAND_NAME} ในโถงวังหินอ่อนสีงาช้างเดียวกัน ฝั่งซ้ายเป็นหญิงสาวผมยาวสีน้ำตาลเป็นลอน สวมมงกุฎทองประดับอัญมณีแดง ต่างหูและสร้อยอัญมณีแดง ชุดราตรีแดง-ขาวปักทองแต่งลูกไม้ขาว พร้อมผ้าคลุมกำมะหยี่แดงพาดยาวลงพื้น มุมบนขวาเป็นโลโก้ ${BRAND_NAME} แบบเวิร์ดมาร์กสามมิติ ครึ่งแรกเป็นตัวเลขผิวแดงชาดเคลือบเงาตัดขอบทอง ครึ่งหลังเป็นตัวอักษรละตินผิวโครเมียมเงินขัดเงา บนโล่ตราสัญลักษณ์ที่มีมงกุฎเงินประดับอัญมณีแดงอยู่ด้านบน ครึ่งล่างพิมพ์คำว่า โปรโมชั่น เป็นตัวอักษรสามมิติแดงเคลือบเงาตัดขอบทองโดยมีมงกุฎทองดวงเล็กอยู่เหนือตัวอักษร ถัดลงมาเป็นแถบแคปซูลพื้นดำขอบทองที่เขียนว่า แนะนำเพื่อน แล้วตามด้วยตัวเลข 0.8% ตัวโตผิวแดงเคลือบเงาตัดขอบทอง ปิดท้ายด้วยแคปซูลพื้นดำขอบทองที่เขียนว่า สมัครสมาชิก พร้อมไอคอนรูปคนกับเครื่องหมายบวกและลูกศรคู่`;

// อาร์เรย์เดียว ใช้ทั้งกับ <Faq> และโน้ด FAQPage — ไม่ใช้ default ของ component
// (Faq4 ตั้งใจ ship เป็นลิสต์ว่าง prop ที่ลืมส่งจึงได้ accordion เปล่า ไม่ใช่
// คำถามของแบรนด์ก่อน) สามคู่นี้คือบล็อก Q/A ของบรีฟเอง (content.txt บรรทัด 24-29)
// ตรงตัว ตัดเฉพาะหมายเลข "1." "2." "3." ออกเพราะ accordion เป็นตัวลิสต์อยู่แล้ว
// ทุกคำตอบคงประโยคกำกับของบรีฟไว้ครบ — เป็นเนื้อหาของบรีฟทั้งสองครึ่ง
const faqs = [
  {
    q: `${BRAND_NAME} มีเกมคาสิโนประเภทไหนให้เลือกบ้าง?`,
    a: `ตามข้อมูลที่ระบุ ${BRAND_NAME} นำเสนอบาคาร่าสล็อต ไฮโล รูเล็ต ยิงปลา เดิมพันฟุตบอล และหวยออนไลน์ โดยควรตรวจสอบรายชื่อเกมและผู้ให้บริการที่เปิดใช้งานจริงจากเว็บไซต์`,
  },
  {
    q: `${BRAND_NAME} มีโปรโมชั่นคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% หรือไม่?`,
    a: `ตามข้อมูลที่ระบุ มีโปรโมชั่นทั้งสองรายการ โดยควรตรวจสอบประเภทเกมที่เข้าร่วม รอบคำนวณยอด และเงื่อนไขการรับเครดิตจากประกาศล่าสุดก่อนใช้สิทธิ์`,
  },
  {
    q: `${BRAND_NAME} มีแอดมินให้บริการตลอด 24 ชั่วโมงหรือไม่?`,
    a: `เว็บไซต์ระบุว่ามีแอดมินออนไลน์ตลอด 24 ชั่วโมง โดยควรตรวจสอบช่องทางติดต่อและเวลาการให้บริการจริงจากประกาศล่าสุดของผู้ให้บริการ`,
  },
];

// ไม่มี breadcrumb: นี่คือหน้าแรก เส้นทางจาก root มาหาตัวเองจะเหลือครั้งเดียวที่ชี้ตัวเอง
// ทุก URL ในกราฟมาจาก pageGraph ที่ derive จาก site: — ไม่มีโดเมนพิมพ์ไว้ในไฟล์นี้
// ไม่มี URL ที่ต่อด้วย `+` และไม่ส่งโน้ด Review / AggregateRating / sameAs /
// address / email เข้าไปเลย
// `description` เป็นสตริงเดียวกับที่ MainLayout ได้รับ `name` เป็น H1 ของหน้า และ
// `faqs` เป็นอาร์เรย์ตัวเดียวกับที่ <Faq> ได้รับ
const graph = pageGraph(Astro, {
  name: pageH1,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxCyberCut as="h1" title={pageH1}>
    <p>
      {BRAND_NAME}
      <strong class="text-[#a30d1a]">นำเสนอข้อมูลเกมคาสิโนออนไลน์หลากหลายประเภท</strong>
      ทั้งบาคาร่า สล็อตออนไลน์ ไฮโล รูเล็ต ยิงปลา เดิมพันฟุตบอล และหวยออนไลน์ พร้อมระบบสมาชิกที่รองรับการใช้งานผ่านมือถือ ผู้ใช้งานสามารถศึกษากติกาเกม โปรโมชั่น และรายละเอียดบริการได้ในเว็บไซต์เดียว
      <strong class="text-[#a30d1a]">ส่วนคำกล่าวอ้างเกี่ยวกับการเป็นเจ้าของระบบเกม เว็บตรง และลิขสิทธิ์ถูกต้อง ควรตรวจสอบข้อมูลบริษัทและหลักฐานการได้รับอนุญาตจากแหล่งที่เชื่อถือได้ก่อนใช้งาน</strong>
    </p>
  </ContentBoxCyberCut>

  <ContentBoxTwo as="h2" title={`${BRAND_NAME} บาคาร่า สล็อต ไฮโล รูเล็ต ยิงปลา บอล หวย เซิร์ฟแท้ ปลอดภัยในไทย`}>
    <p slot="left">
      {BRAND_NAME} รวบรวมข้อมูลเกมเดิมพันหลายหมวดหมู่
      <strong class="text-[#a30d1a]">ทั้งบาคาร่าและรูเล็ตที่มีกติกาเฉพาะตัว สล็อตออนไลน์ที่มีฟีเจอร์แตกต่างกัน ไฮโล เกมยิงปลา เดิมพันฟุตบอล และหวยออนไลน์</strong>
      โดยแต่ละประเภทมีรูปแบบการเล่นและอัตราจ่ายไม่เหมือนกัน
    </p>
    <p slot="right">
      ผู้ใช้งานควรตรวจสอบรายชื่อผู้พัฒนาเกม ความน่าเชื่อถือของระบบเซิร์ฟเวอร์ และนโยบายคุ้มครองข้อมูลส่วนบุคคลให้ชัดเจน
      <strong class="text-[#a30d1a]">เพราะคำกล่าวอ้างว่าใช้เซิร์ฟเวอร์แท้หรือปลอดภัยในไทย ไม่สามารถยืนยันได้จากข้อความโฆษณาเพียงอย่างเดียว</strong>
    </p>
  </ContentBoxTwo>

  <ProviderGrid />

  <ContentBox as="h2" title={`โปรโมชั่น ${BRAND_NAME} อัปเดตใหม่ตลอดสัปดาห์`}>
    <p>
      {BRAND_NAME} นำเสนอข้อมูลโปรโมชั่นสำหรับสมาชิก
      <strong class="text-[#a30d1a]">โดยมีรายการคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8% เป็นสิทธิพิเศษที่ระบุไว้</strong>
      ผู้ใช้งานสามารถติดตามประกาศโปรโมชั่นประจำสัปดาห์เพื่อศึกษารายละเอียดการรับเครดิตและเงื่อนไขการเข้าร่วม ทั้งนี้ แต่ละรายการอาจกำหนดประเภทเกม ยอดที่นำมาคำนวณ รอบรับสิทธิ์ และข้อจำกัดการถอนเงินแตกต่างกัน
      <strong class="text-[#a30d1a]">จึงควรตรวจสอบข้อมูลล่าสุดก่อนรับโบนัสทุกครั้ง</strong>
    </p>
  </ContentBox>

  <ContentBoxSevenThree as="h3" title="โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน">
    <p slot="left">
      โปรโมชั่นคืนยอดเสีย 0.3%
      <strong class="text-[#a30d1a]">เป็นรายการที่ระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขรายวัน</strong>
      สมาชิกควรตรวจสอบว่าบาคาร่าสล็อต ไฮโล รูเล็ต ยิงปลา บอล หรือหวยประเภทใดเข้าร่วมรายการ รวมถึงรอบเวลาคำนวณยอดและวิธีรับเครดิตให้ครบถ้วน เพราะการเดิมพันบางรายการอาจไม่เข้าเกณฑ์รับสิทธิ์ นอกจากนี้ควรศึกษาข้อกำหนดการใช้โบนัสและการถอนเงินก่อนรับเครดิต
      <strong class="text-[#a30d1a]">โดยโปรโมชั่นคืนยอดเสียไม่ได้รับประกันว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งถัดไป</strong>
    </p>

    <Picture
      slot="right"
      src={cashbackPoster}
      loading="lazy"
      fetchpriority="low"
      widths={cashbackWidths}
      sizes={cashbackSizes}
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={64}
      alt={cashbackAlt}
      class="mx-auto h-auto w-full max-w-[375px] rounded-2xl border border-[#d98fa0] shadow-[0_10px_24px_rgba(54,8,15,0.25)]"
    />
  </ContentBoxSevenThree>

  <ContentBoxSevenThreeCyberCut as="h3" title="โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด">
    <p slot="left">
      โปรโมชั่นแนะนำเพื่อนโบนัส 0.8%
      <strong class="text-[#a30d1a]">เป็นรายการที่ระบุสิทธิ์สำหรับสมาชิกที่แนะนำผู้ใช้งานรายใหม่</strong>
      โดยควรตรวจสอบวิธีเชื่อมโยงบัญชีแนะนำเพื่อน ฐานยอดที่ใช้คำนวณโบนัส และรอบจ่ายเครดิตให้ชัดเจน
      <strong class="text-[#a30d1a]">แม้จะระบุว่าไม่จำกัด แต่ควรตรวจสอบข้อกำหนดเกี่ยวกับจำนวนบัญชี วงเงินโบนัส และเงื่อนไขการถอนเงิน</strong>
      เพื่อให้เข้าใจรายละเอียดสิทธิ์ที่ได้รับตามประกาศจริง
    </p>

    <Picture
      slot="right"
      src={referralPoster}
      loading="lazy"
      fetchpriority="low"
      widths={referralWidths}
      sizes={referralSizes}
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={64}
      alt={referralAlt}
      class="mx-auto h-auto w-full max-w-[375px] rounded-xl border border-[#d98fa0] shadow-[0_10px_24px_rgba(54,8,15,0.25)]"
    />
  </ContentBoxSevenThreeCyberCut>

  <ContentBox3ThreePremium
    as="h2"
    title={`สมัครเล่นบาคาร่าสล็อต ${BRAND_NAME} ไม่มีขั้นต่ำ 3 ขั้นตอน`}
    titleleft={`ขั้นตอนที่ 1 เข้าสู่หน้าสมัครสมาชิก ${BRAND_NAME}`}
    titlecenter="ขั้นตอนที่ 2 กรอกข้อมูลและยืนยันบัญชี"
    titleright="ขั้นตอนที่ 3 เข้าสู่ระบบและตรวจสอบรายละเอียดเกม">
