---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import LatestWinners from "../components/LatestWinnersHuay.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThreeHuay from "../components/ContentBoxSevenThreeHuay.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBox from "../components/ContentBox.astro";
import Faq from "../components/FaqHuay.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgTwoDigit from "../assets/slide2.png";
import imgThreeDigit from "../assets/slide1.png";

// VARIANT ROTATION THIS ROUND (NATO168 -> หวย365). Zero file reuse from the
// previous round: AnnouncementHuay replaces Announcement5, LatestWinnersHuay
// replaces LatestWinners3, FaqHuay replaces Faq2, ReviewCardSumo2 replaces
// ReviewCardSumo, and the ContentBox shape-mix moves off CyberCut / TwoCyberCut /
// Neumorphism / SevenThreeCyberCut / SevenThreeNeumorphism / TwoFloatingBadge
// onto Premium / TwoPremium / FloatingBadge / SevenThreePremium /
// SevenThreeHuay / Special. NavbarHuay and FooterHuay are the layout's pair this
// round (previously NavbarStyle8 / FooterStyle3).
// Plain ContentBox is the one deliberate carry-over: terms, privacy, 404 and
// every button page render their body through it by rule and cannot follow a
// rotation, so it is always-live and the orchestrator rethemes it in the shared
// step — this page only passes it props.
// Every CyberCut / Neumorphism / Style file, Faq2, Announcement5, LatestWinners3,
// ReviewCardSumo, NavbarStyle8 and FooterStyle3 stay on disk as inventory for the
// next brand — none of them was deleted, and the previous brand's copy and colour
// still inside them is expected drift, not a bug.
//
// <Announcement /> runs bare on purpose: AnnouncementHuay's default message is
// already this brand's copy and every sub-page calls it bare too, so passing an
// override here is exactly how the ticker ends up saying two different things on
// two pages of the same site.
//
// IMAGE ROLES FOR THIS DROP (2026-10-03). Two files are referenced from this page
// and only two, and each pairing is read off the artwork itself:
//   slide2.png — the white gold-edged plaque under the big gold อัตราจ่ายหวย
//     wordmark reads "2ตัวจ่าย 100 บาท" and the model holds the white ball
//     numbered 2, so it belongs to docx H3 #4. Imported as imgTwoDigit.
//   slide1.png — the same set, the plaque is red with a gold edge and reads
//     "3ตัว จ่าย 1,000 บาท" over the ball numbered 3, so it belongs to docx
//     H3 #5. Imported as imgThreeDigit.
// Both files measure 600x400, so 600 is the top real candidate width — nothing
// above it would be a real pixel — and each picture carries max-w-[600px] so the
// art is never upscaled past its own bitmap. Each slide sits in a
// ContentBoxSevenThree* image+text block, which is that family's hard cap of two
// per rebrand, so there is no third SevenThree anywhere on the site.
// The two blocks mirror each other: SevenThreePremium lays out
// md:grid-cols-[3fr_7fr] so its picture goes in slot="left", and
// SevenThreeHuay lays out md:grid-cols-[7fr_3fr] so its picture goes in
// slot="right" while the paragraph keeps the wide column. The two pictures
// therefore alternate sides instead of stacking down the same edge, and each
// `sizes` describes its own 3fr column rather than the viewport:
//   Premium:  max-w-7xl/1280px cap, px-4, md:p-10, gap-10, no inner padding on
//             the image column -> (1280 - 32 - 80 - 40) x 0.3 = 339px
//   Huay:     max-w-[1400px] cap, px-4, md:p-10, gap-8, md:pl-6 on the image
//             column -> (1400 - 32 - 80 - 32) x 0.3 - 24 = 353px
// Below md both cards collapse to one column at p-8, so the drawn width is
// 100vw - 32 (section px-4) - 64 (card p-8) = 100vw - 96px, capped at 600px.
//
// The alt text was written from THIS drop's artwork, re-opened with the Read
// tool before it was typed: a woman in a white-and-gold Thai outfit against
// swept red satin, white lottery balls, scattered gold coins and lottery
// tickets, the หวย365 wordmark in the top corner, big gold red-edged Thai type
// reading อัตราจ่ายหวย, and the payout plaque underneath.
//
// Deliberately NOT imported, and every file still on disk:
//   banner2.png / banner3.png / slide3.png / slide4.png all predate this drop and
//   belong to previous brands — importing any of them would emit a competitor's
//   artwork into dist/, so there is no inline article illustration this round.
//   banner1.png and banner1-mobile.png belong to MainLayout's own pinned globs
//   and are never referenced from a page — the hero is the LCP element, so
//   nothing here gets loading="eager" fetchpriority="high". og.png is the same:
//   MainLayout owns it.
//
// Vocabulary: หวย365 is a เว็บแทงหวยออนไลน์ — หวย, แทงหวย, ส่งโพย, โพย, เลือกเลข,
// 2 ตัว / 3 ตัว, อัตราจ่าย, งวด, รอบ, เวลาเปิดรับ / ปิดรับ, รัฐบาลไทย, ฮานอย,
// ลาวพัฒนา, หวยหุ้นต่างประเทศ, แนวทางหวย, กลุ่มหวย, สถิติหวยย้อนหลัง, ผลหวย,
// สมัครสมาชิก, Login, แอดมิน 24 ชั่วโมง, PIN, OTP.
// Several brands before this one sold slots or sport; every one of those words
// (สล็อต, พีจี, ค่ายเกม, ฟรีสปิน, ตัวคูณ, วงล้อ, ปั่น, โบนัสไทม์, โบนัสทุกยูส,
// ไม่มีล็อคยูส, คืนยอดเสีย 0.3%, แนะนำเพื่อน 0.8%, RTP, คาสิโนสด, บาคาร่า, บอล,
// ค่าน้ำ, ลีก) is gone, and the page was written from the brief rather than
// find-and-replaced over the old sentences. Nothing here claims a licence, an
// operator, a bank, a deposit minimum, a member count, a founding year or a
// draw time, because the brief names none. The only figures are the brief's own:
// 2 ตัว จ่าย 100 บาท, 3 ตัว จ่าย 1,000 บาท, 3 ขั้นตอน, 24 ชั่วโมง. The brief's own
// hedging ships with the copy ("ไม่สามารถใช้ยืนยันหรือรับประกันเลขที่จะออกในงวด
// ถัดไปได้", "แนวทางหรือสถิติย้อนหลังเป็นเพียงข้อมูลประกอบ", "ควรยึดรายละเอียด
// ล่าสุดในหน้าส่งโพยก่อนยืนยันรายการ") — it is part of the paragraphs, not
// trimmed as downbeat.
//
// Title and description are the brief's own Title/Description lines, used
// verbatim. The description ships at 137 code points (the brief sheet quotes it
// as 147 — that count includes the Thai combining marks separately), which is
// the length the brief wrote it: it is NOT padded up to 150, and verify-build
// deliberately skips its 150-character floor on the home page for exactly this
// reason.
const pageTitle = "หวย365 เว็บแทงหวย แนวทางหวย กลุ่มหวย สถิติหวย ผลหวย ครบทุกประเภท";

const pageDescription = "หวย365 เว็บแทงหวย ช่องทางเข้าเล่นหวยออนไลน์ แนวทางหวย กลุ่มหวย สถิติหวย ผลหวย ทั้งรัฐบาลไทย ฮานอย ลาวพัฒนา หวยหุ้นต่างประเทศ ครบทุกประเภท";

// The brief has a real H2 -> H3 nesting this round, so the page is NOT flattened
// to H2-only. The two H3s are genuine headings — the two payout sub-points, both
// nested under the อัตราการจ่าย H2 — and they stay H3.
//
// The checklist, in document order, and what carries each one:
//    1 H1  หวย365 เว็บแทงหวย แนวทางหวย กลุ่มหวย สถิติหวย ผลหวย
//          ContentBoxPremium, brief paragraph on line 4
//    2 H2  เว็บ หวย365 รัฐบาลไทย ฮานอย ลาวพัฒนา หวยหุ้นต่างประเทศ ครบ
//          ContentBoxTwoPremium, line 6 left / line 7 right
//    3 H2  อัตราการจ่าย หวย365 2ตัว จ่าย100บาท 3ตัว จ่าย1,000บาท
//          ContentBoxFloatingBadge, line 9
//    4 H3  2ตัว จ่าย100บาท
//          ContentBoxSevenThreePremium + slide2 (imgTwoDigit), line 11
//    5 H3  3ตัว จ่าย1,000บาท
//          ContentBoxSevenThreeHuay + slide1 (imgThreeDigit), line 13
//    6 H2  สมัครแทงหวยเว็บ หวย365 ง่ายๆ 3ขั้นตอน
//          ContentBoxSpecial, line 15 left / line 16 right
//    7 H2  ติดต่อแอดมินเว็บแทง หวย365 ได้ ตลอด 24 ชั่วโมง
//          ContentBox + LINE / สมัครสมาชิก buttons, lines 18+19
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ หวย365
//          FaqHuay + faqs prop, lines 21-26
// Final inventory for this page: h1 x1, h2 x5, h3 x2.
//
// Every brief paragraph ships in full — all eleven of them, nothing merged or
// summarised. Sections 2 and 6 have two paragraphs each and run one per column;
// section 7 has two and they stack inside one wrapper div so the slot still
// receives exactly one element. The column labels passed to ContentBoxTwoPremium
// are this page's own layout wording, not brief headings, and that variant
// renders them as <p>.
//
// Everything else on the page is chrome and emits no heading tag at any level:
// AnnouncementHuay, LatestWinnersHuay, LoginRtpSection and ReviewCardSumo2
// render their titles as <p>/<span> with an aria-label on the section, and
// FaqHuay's questions live inside <summary> as <p>. The non-brief widgets sit
// before section 1 (the ticker, then the winners feed) and after section 8
// (LoginRtpSection, ReviewCardSumo, Navfoot) — never spliced between two content
// sections.

// One array, used by both <Faq> and the FAQPage node — never the component's own
// defaults, which belong to whichever brand shipped last. The three pairs are the
// brief's own Q/A block, verbatim.
const faqs = [
  {
    q: "หวย365 มีหวยอะไรให้เลือกบ้าง?",
    a: "มีรัฐบาลไทย ฮานอย ลาวพัฒนา หวยหุ้นต่างประเทศ และรายการอื่นตามที่ระบบเปิดรับในแต่ละวัน สามารถตรวจสอบตารางหวย เวลาปิดรับ อัตราจ่าย และผลของแต่ละรอบได้จากหน้าเว็บไซต์",
  },
  {
    q: "สถิติหวยและแนวทางหวย365 ใช้ทำนายเลขงวดต่อไปได้หรือไม่?",
    a: "สถิติย้อนหลังช่วยให้ดูผลและรูปแบบตัวเลขที่เคยออก ส่วนแนวทางหวยเป็นข้อมูลประกอบจากแหล่งหรือกลุ่มต่าง ๆ แต่ไม่สามารถรับประกันผลของงวดถัดไปได้ เพราะผลการออกรางวัลแต่ละรอบไม่ได้ยืนยันจากสถิติที่ผ่านมา",
  },
  {
    q: "หวย365 2 ตัวจ่าย 100 และ 3 ตัวจ่าย 1,000 ใช้กับหวยทุกประเภทหรือไม่?",
    a: "ขึ้นอยู่กับประเภทหวยและเงื่อนไขของแต่ละรอบ อัตรา 2 ตัว 100 และ 3 ตัว 1,000 ควรตรวจสอบจากหน้าส่งโพยก่อนเดิมพันทุกครั้ง เนื่องจากบางรายการอาจกำหนดอัตราหรือวงเงินแตกต่างกัน",
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// One highlight colour only: #ffc93c, the brand gold, against the inherited body
// colour #f6e7e0 (BRAND_TEXT). The paragraphs below carry no colour class of
// their own: every ContentBox* card in this mix already sets
// `text-left text-base leading-relaxed text-[#f6e7e0]` on the element holding
// the slot, so the prose inherits it and no page-level override can drift from
// the card.

// No breadcrumb: this is the homepage, so a trail from the root to itself would
// be a single self-referential crumb. Every URL in the graph is derived by
// pageGraph from `site:` — no domain is typed out in this file, and no Review /
// AggregateRating / sameAs / address node is passed.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <LatestWinners />

  <ContentBoxPremium as="h1" title="หวย365 เว็บแทงหวย แนวทางหวย กลุ่มหวย สถิติหวย ผลหวย">
    <p>
      หวย365
      <strong class="text-[#ffc93c]">เว็บแทงหวยออนไลน์ที่รวมข้อมูลและรายการหวยไว้ในหน้าเดียว</strong>
      ทั้งแนวทางหวย กลุ่มหวย สถิติหวยย้อนหลัง และผลหวยตามรอบที่ประกาศ สมาชิกสามารถติดตามรัฐบาลไทย ฮานอย ลาวพัฒนา และหวยหุ้นต่างประเทศ พร้อมเลือกเลข ส่งโพย และตรวจสอบรายการผ่านมือถือได้สะดวก ข้อมูลสถิติช่วยสำหรับย้อนดูผลในรอบที่ผ่านมา
      <strong class="text-[#ffc93c]">แต่ไม่สามารถใช้ยืนยันหรือรับประกันเลขที่จะออกในงวดถัดไปได้</strong>
    </p>
  </ContentBoxPremium>

  <ContentBoxTwoPremium as="h2" title="เว็บ หวย365 รัฐบาลไทย ฮานอย ลาวพัฒนา หวยหุ้นต่างประเทศ ครบ" titleleft="รายการหวยที่เปิดรับ" titleright="แนวทาง กลุ่ม และสถิติย้อนหลัง">
    <p slot="left">
      เว็บ หวย365
      <strong class="text-[#ffc93c]">รวบรวมรายการหวยหลายประเภทสำหรับผู้ที่ต้องการติดตามหลายรอบในบัญชีเดียว</strong>
      มีทั้งหวยรัฐบาลไทยตามกำหนดออกรางวัล หวยฮานอยหลายรอบ หวยลาวพัฒนา และหวยหุ้นต่างประเทศตามตลาดที่เปิดให้บริการ สมาชิกสามารถตรวจสอบเวลาเปิดรับ เวลาปิดรับ อัตราจ่าย
      <strong class="text-[#ffc93c]">และผลของแต่ละรายการได้ก่อนเลือกแทง</strong>
    </p>
    <p slot="right">
      นอกจากรายการหวยแล้ว
      <strong class="text-[#ffc93c]">ยังสามารถจัดหมวดแนวทางหวย กลุ่มพูดคุย และสถิติย้อนหลังแยกตามประเภท</strong>
      เพื่อให้ค้นหาข้อมูลได้ง่ายขึ้น อย่างไรก็ตาม แนวทางหรือสถิติย้อนหลังเป็นเพียงข้อมูลประกอบ
      <strong class="text-[#ffc93c]">ไม่ได้เพิ่มความแน่นอนในการทายผลหวยรอบถัดไป</strong>
    </p>
  </ContentBoxTwoPremium>

  <ContentBoxFloatingBadge as="h2" title="อัตราการจ่าย หวย365 2ตัว จ่าย100บาท 3ตัว จ่าย1,000บาท">
    <p>
      หวย365 มีอัตราจ่ายสำหรับรายการที่เข้าเงื่อนไข โดยกำหนด
      <strong class="text-[#ffc93c]">2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท</strong>
      ตามประเภทหวยและรูปแบบการเดิมพันที่เปิดรับ ก่อนส่งโพยควรตรวจสอบอัตราที่แสดงในระบบ รวมถึงเลขที่เลือก ยอดเดิมพัน และรอบหวยให้ถูกต้อง
      <strong class="text-[#ffc93c]">เพราะแต่ละรายการอาจกำหนดอัตราจ่ายหรือวงเงินแตกต่างกัน</strong>
    </p>
  </ContentBoxFloatingBadge>

  <ContentBoxSevenThreePremium as="h3" title="2ตัว จ่าย100บาท">
    <Picture
      slot="left"
      src={imgTwoDigit}
      loading="lazy"
      fetchpriority="low"
      widths={[339, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), (max-width: 1279px) calc(30vw - 46px), 339px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="ภาพโปสเตอร์อัตราจ่ายของ หวย365 ฉากหลังเป็นผ้าซาตินสีแดงสดพลิ้ว ด้านซ้ายเป็นหญิงสาวผมยาวประดับดอกไม้ขาวและเครื่องประดับทองฝังพลอยแดง สวมชุดไทยสีขาวครีมปักทอง มือขวายกลูกบอลหวยสีขาวเลข 2 ขึ้นมาข้างแก้ม รอบตัวมีลูกบอลหวยเลข 6 9 8 และ 5 กองเหรียญทองและใบหวยกระจายอยู่ มุมบนขวาเป็นโลโก้ หวย365 ถัดลงมาเป็นตัวอักษรไทยสีทองขอบแดงขนาดใหญ่ว่า อัตราจ่ายหวย และป้ายสีขาวขอบทองคาดข้อความ 2ตัวจ่าย 100 บาท"
      class="mx-auto h-auto w-full max-w-[600px] rounded-2xl border border-[#c08a07]/60 shadow-[0_10px_30px_rgba(255,201,60,0.28)]"
    />
    <p slot="right">
      รายการที่กำหนดอัตรา
      <strong class="text-[#ffc93c]">2 ตัว จ่าย 100 บาท</strong>
      สามารถเลือกเลขและยอดตามวงเงินที่ระบบเปิดรับได้ ก่อนยืนยันโพยควรตรวจสอบว่าราคาดังกล่าวใช้กับหวยประเภทและรูปแบบใด
      <strong class="text-[#ffc93c]">เนื่องจากรัฐบาลไทย ฮานอย ลาวพัฒนา หรือหวยหุ้นอาจไม่ได้ใช้อัตราเดียวกันในทุกรอบ</strong>
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBoxSevenThreeHuay as="h3" titleleft="3ตัว จ่าย1,000บาท">
    <p slot="left">
      สำหรับรายการที่กำหนดอัตรา
      <strong class="text-[#ffc93c]">3 ตัว จ่าย 1,000 บาท</strong>
      สมาชิกควรตรวจสอบรายละเอียดของเลข 3 ตัวก่อนส่งโพย โดยเฉพาะประเภทการเดิมพันและเงื่อนไขของหวยรอบนั้น หากระบบแสดงอัตราที่แตกต่างจากข้อมูลประชาสัมพันธ์
      <strong class="text-[#ffc93c]">ควรยึดรายละเอียดล่าสุดในหน้าส่งโพยก่อนยืนยันรายการ</strong>
    </p>
    <Picture
      slot="right"
      src={imgThreeDigit}
      loading="lazy"
      fetchpriority="low"
      widths={[353, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), (max-width: 1399px) calc(30vw - 68px), 353px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
