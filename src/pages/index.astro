---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import LottoGrid from "../components/LottoGrid.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import LatestWinners from "../components/LatestWinners3.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ReviewCardSumo from "../components/ReviewCardSumo.astro";
import Faq from "../components/Faq4.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// Title and description are the brief's own Title/Description lines, used
// verbatim. A brief-supplied description is never padded up to the 150-char
// floor and never topped up from the H1/H2.
const pageTitle = "กินดี365 เว็บหวยราคาจ่ายดีที่สุด แทงถูก 2ตัว100/3ตัว1,000";

const pageDescription =
  "กินดี365 เว็บหวยราคาจ่ายดีที่สุด จ่ายจริง เข้าไว รวมหวยออนไลน์ ครบวงจร รัฐบาลไทย ลาวพัฒนา ฮานอย VIP หุ้นต่างประเทศ ให้อัตราจ่าย 2ตัว100/3ตัว1,000";

// The ticker copy is passed explicitly rather than relying on the component's
// default — every Announcement* variant's default belongs to whichever brand
// wired it in last. No emoji in this string: an emoji baked into a text prop
// cannot be given its own aria-hidden span, and this marquee prints the string
// twice.
const announcement =
  "กินดี365 เว็บหวยราคาจ่ายดีที่สุด จ่ายจริง เข้าไว ไม่หักเปอร์เซ็นต์ • รวมหวยออนไลน์ครบวงจรไว้ในบัญชีเดียว ทั้งหวยรัฐบาลไทย หวยลาวพัฒนา หวยฮานอย VIP และหวยหุ้นต่างประเทศ • อัตราจ่ายตามที่กำหนดสำหรับหน้านี้ เลข 2 ตัวบาทละ 100 และเลข 3 ตัวบาทละ 1,000 คำนวณยอดตามเรทได้ตั้งแต่ก่อนเดิมพัน • ตรวจสอบเรท เลือกเลข ส่งโพย และเช็กประวัติรายการได้ด้วยตัวเอง • ฝากเครดิตผ่านบัญชีธนาคารและวอลเลทที่ระบบเปิดรองรับ ตรวจชื่อบัญชีและจำนวนเงินก่อนยืนยันรายการ • แต่ละตลาดหวยมีเวลาเปิดรับและเงื่อนไขต่างกัน ให้ยึดรายละเอียดที่แสดงบนหน้าส่งโพยในรอบนั้นเป็นหลัก • เจ้าหน้าที่ กินดี365 ดูแลเรื่องฝากถอนตลอด 24 ชั่วโมง";

// The brief's own rate tables, kept as data so the markup below stays a single
// semantic <table> per H3 instead of two hand-typed grids. All five rows the
// brief lists are included.
const rateTwoDigit = [
  { stake: "1 บาท", rate: "1 : 100", payout: "100 บาท" },
  { stake: "5 บาท", rate: "1 : 100", payout: "500 บาท" },
  { stake: "10 บาท", rate: "1 : 100", payout: "1,000 บาท" },
  { stake: "50 บาท", rate: "1 : 100", payout: "5,000 บาท" },
  { stake: "100 บาท", rate: "1 : 100", payout: "10,000 บาท" },
];

const rateThreeDigit = [
  { stake: "1 บาท", rate: "1 : 1,000", payout: "1,000 บาท" },
  { stake: "5 บาท", rate: "1 : 1,000", payout: "5,000 บาท" },
  { stake: "10 บาท", rate: "1 : 1,000", payout: "10,000 บาท" },
  { stake: "50 บาท", rate: "1 : 1,000", payout: "50,000 บาท" },
  { stake: "100 บาท", rate: "1 : 1,000", payout: "100,000 บาท" },
];

// One array, used by both <Faq> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last.
const faqs = [
  {
    q: "กินดี365 มีหวยอะไรให้เลือกแทงบ้าง?",
    a: "มีหวยหลายประเภทตามที่กำหนดไว้ ได้แก่ หวยรัฐบาลไทย หวยลาวพัฒนา หวยฮานอย VIP และหวยหุ้นต่างประเทศ โดยแต่ละประเภทมีรอบและเวลาเปิดรับแตกต่างกัน ควรตรวจสอบรอบล่าสุดก่อนส่งโพย",
  },
  {
    q: "กินดี365 เลข 2 ตัวและ 3 ตัวจ่ายเท่าไร?",
    a: "ตามอัตราที่กำหนดสำหรับหน้านี้ เลข 2 ตัวจ่ายบาทละ 100 และเลข 3 ตัวจ่ายบาทละ 1,000 แต่ควรตรวจสอบเรทบนหน้าส่งโพยอีกครั้งก่อนเดิมพัน เพราะรายละเอียดอาจแตกต่างกันตามประเภทหวยหรือรอบที่เลือก",
  },
  {
    q: "ฝากถอน กินดี365 มีปัญหาต้องทำอย่างไร?",
    a: "ตรวจสอบประวัติธุรกรรมในบัญชีก่อน หากเครดิตยังไม่เข้าหรือรายการถอนยังค้าง ให้ติดต่อเจ้าหน้าที่ กินดี365 พร้อมแจ้งจำนวนเงิน เวลา และรายละเอียดรายการ เพื่อให้ทีมงานตรวจสอบและช่วยแก้ไขได้ตลอด 24 ชั่วโมง",
  },
];

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb. Every URL in the graph is derived
// by pageGraph from `site:` — no domain is typed out in this file.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <ContentBoxPremium as="h1" title="กินดี365 เว็บหวยราคาจ่ายดีที่สุด จ่ายจริง เข้าไว ไม่หักเปอร์เซ็นต์">
    <p class="text-left text-base leading-relaxed text-[#dbe4f5]">
      <strong class="text-[#fbeeb8]">กินดี365</strong> รวมบริการแทงหวยออนไลน์สำหรับคนที่ต้องการเลือกหวยหลายประเภทผ่านบัญชีเดียว มีทั้งหวยรัฐบาลไทย ลาวพัฒนา ฮานอย VIP และหวยหุ้นต่างประเทศ
      พร้อมอัตราจ่ายตามที่กำหนด เลข 2 ตัวบาทละ <strong class="text-[#fbeeb8]">100</strong> และเลข 3 ตัวบาทละ <strong class="text-[#fbeeb8]">1,000</strong> สมาชิกสามารถตรวจสอบเรท เลือกเลข ส่งโพย
      และเช็กประวัติรายการได้ด้วยตัวเอง รองรับการฝากเครดิตผ่านธนาคารและวอลเลท พร้อมเจ้าหน้าที่ดูแลเรื่องฝากถอนตลอด 24 ชั่วโมง
    </p>
  </ContentBoxPremium>

  <ContentBoxTwoPremium as="h2" title="กินดี365 หวยออนไลน์ ครบวงจร รัฐบาลไทย ลาวพัฒนา ฮานอย VIP หุ้นต่างประเทศ">
    <p slot="left" class="text-left text-base leading-relaxed text-[#dbe4f5]">
      <strong class="text-[#fbeeb8]">กินดี365</strong> จัดหมวดหวยออนไลน์ไว้ให้เลือกตามรอบที่เปิดบริการ ไม่ว่าจะเป็นหวยรัฐบาลไทย หวยลาวพัฒนา หวยฮานอย VIP หรือหวยหุ้นต่างประเทศ
      สมาชิกสามารถเลือกประเภทหวย รอบที่ต้องการ เลข 2 ตัวหรือ 3 ตัว แล้วระบุยอดเดิมพันผ่านมือถือได้โดยตรง ก่อนยืนยันโพยควรตรวจสอบเวลาเปิด-ปิด อัตราจ่าย และรายละเอียดของเลขที่เลือกให้ครบ
      เพื่อป้องกันการส่งผิดรอบหรือผิดประเภท
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#dbe4f5]">
      แต่ละตลาดหวยอาจมีเวลาเปิดรับและเงื่อนไขต่างกัน จึงควรยึดรายละเอียดที่แสดงบนหน้าส่งโพยในรอบนั้นเป็นหลัก
    </p>
  </ContentBoxTwoPremium>

  <LottoGrid />

  <ContentBoxSevenThreePremium as="h2" title="เว็บหวย กินดี365 ให้อัตราจ่ายไม่น้อยกว่ากำหนด 2ตัว100/3ตัว1,000">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อนของ กินดี365 พื้นหลังสีน้ำเงินกรมท่าไล่เฉดพร้อมประกายทอง ด้านบนกลางภาพเป็นโลโก้คำว่า กินดี สีทองวางเหนือเลข 365 ถัดลงมาเป็นคำว่า โปรโมชั่น สีขาวในแผ่นป้ายสีน้ำเงิน ตามด้วยคำว่า แนะนำเพื่อน ตัวหนาสีขาวขอบทอง และตัวเลข 0.8% ขนาดใหญ่สีทองบนแผ่นป้ายสีน้ำเงินขอบทอง ด้านขวาเป็นผู้หญิงผมยาวสีเงินสวมชุดไทยประยุกต์สีขาวทองประดับอัญมณีสีน้ำเงิน กำลังชี้นิ้วมาที่ตัวเลข ด้านซ้ายมีลูกบอลหวยเลข 9 เลข 3 และเลข 8 พร้อมสลากกินแบ่งรัฐบาลไทยและเหรียญทองกระจายอยู่รอบภาพ ด้านล่างเป็นแถบสี่ช่องเขียนว่า จ่ายจริงไม่อั้น รับเลขดังเลขอั้น ไม่ลบบิล และไม่เบี้ยวโพย"
      class="mx-auto h-auto w-full rounded-2xl border border-[#e9c55d]/40 shadow-[0_10px_30px_rgba(233,197,93,0.25)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#dbe4f5]">
      อัตราจ่ายเป็นข้อมูลสำคัญที่คนแทงหวยควรเห็นก่อนส่งโพย โดย <strong class="text-[#fbeeb8]">กินดี365</strong> กำหนดเรทสำหรับหน้านี้ไว้ที่ เลข 2 ตัว จ่ายบาทละ
      <span class="font-black text-[#e9c55d]">100</span> และเลข 3 ตัว จ่ายบาทละ <span class="font-black text-[#e9c55d]">1,000</span> ทำให้สามารถคำนวณยอดตามเรทได้ตั้งแต่ก่อนเดิมพัน
      ทั้งนี้ควรตรวจสอบตัวเลขที่ระบบแสดงจริงอีกครั้งก่อนกดยืนยันทุกโพย
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBoxCyberCut as="h3" title="แทงหวย 2 ตัว ถูกจ่ายบาทละ 100">
    <div class="flex flex-col gap-6">
      <p class="text-left text-base leading-relaxed text-[#dbe4f5]">
        สำหรับเลข 2 ตัว ใช้อัตราจ่ายตามที่กำหนดคือ 1 บาท จ่าย <strong class="text-[#fbeeb8]">100</strong> บาท หากต้องการเพิ่มยอดแทงก็สามารถคำนวณตามสัดส่วนได้ง่าย
      </p>

      <div class="overflow-x-auto rounded-2xl border border-[#e9c55d]/35">
        <table class="w-full min-w-[420px] border-collapse text-left text-base">
          <caption class="sr-only">ตารางอัตราจ่ายหวย 2 ตัว บาทละ 100 เทียบยอดแทงกับยอดตามเรทเมื่อถูก</caption>
          <thead class="bg-gradient-to-r from-[#062052] to-[#00081f]">
            <tr class="text-[#fbeeb8]">
              <th scope="col" class="p-4 font-black">ยอดแทง 2 ตัว</th>
              <th scope="col" class="p-4 text-center font-black">เรทจ่าย</th>
              <th scope="col" class="p-4 text-right font-black">ยอดตามเรทเมื่อถูก</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#1c47a8]/60 text-[#dbe4f5]">
            {
              rateTwoDigit.map((row) => (
                <tr class="transition-colors hover:bg-[#0a2f7a]/70">
                  <td class="p-4 font-bold text-[#dbe4f5]">{row.stake}</td>
                  <td class="p-4 text-center font-black tracking-wider text-[#e9c55d]">{row.rate}</td>
                  <td class="p-4 text-right font-black tracking-wider text-[#5ec2f5]">{row.payout}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="text-left text-base leading-relaxed text-[#dbe4f5]">
        ตัวอย่าง แทงเลข 2 ตัวจำนวน 10 บาท หากผลตรงตามเงื่อนไขและใช้อัตราจ่าย 100 จะคำนวณตามเรทเป็น 10 × 100 = <strong class="text-[#fbeeb8]">1,000</strong> บาท
      </p>
    </div>
  </ContentBoxCyberCut>

  <ContentBoxCyberCut as="h3" title="แทงหวย 3 ตัว ถูกจ่ายบาทละ 1,000">
    <div class="flex flex-col gap-6">
      <p class="text-left text-base leading-relaxed text-[#dbe4f5]">
        เลข 3 ตัวกำหนดอัตราจ่ายไว้ที่ 1 บาท จ่าย <strong class="text-[#fbeeb8]">1,000</strong> บาท เหมาะสำหรับคนที่ต้องการเห็นยอดตามเรทอย่างชัดเจนก่อนส่งโพย
      </p>

      <div class="overflow-x-auto rounded-2xl border border-[#e9c55d]/35">
        <table class="w-full min-w-[420px] border-collapse text-left text-base">
          <caption class="sr-only">ตารางอัตราจ่ายหวย 3 ตัว บาทละ 1,000 เทียบยอดแทงกับยอดตามเรทเมื่อถูก</caption>
          <thead class="bg-gradient-to-r from-[#062052] to-[#00081f]">
            <tr class="text-[#fbeeb8]">
              <th scope="col" class="p-4 font-black">ยอดแทง 3 ตัว</th>
              <th scope="col" class="p-4 text-center font-black">เรทจ่าย</th>
              <th scope="col" class="p-4 text-right font-black">ยอดตามเรทเมื่อถูก</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#1c47a8]/60 text-[#dbe4f5]">
            {
              rateThreeDigit.map((row) => (
                <tr class="transition-colors hover:bg-[#0a2f7a]/70">
                  <td class="p-4 font-bold text-[#dbe4f5]">{row.stake}</td>
                  <td class="p-4 text-center font-black tracking-wider text-[#e9c55d]">{row.rate}</td>
                  <td class="p-4 text-right font-black tracking-wider text-[#5ec2f5]">{row.payout}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="text-left text-base leading-relaxed text-[#dbe4f5]">
        ตัวอย่าง แทงเลข 3 ตัวจำนวน 10 บาท หากผลตรงตามเงื่อนไขและเรทที่หน้าโพยยังเป็น 1,000 จะคำนวณตามเรทเป็น 10 × 1,000 = <strong class="text-[#fbeeb8]">10,000</strong> บาท
        โดยควรยึดอัตราจ่ายที่ระบบแสดงก่อนส่งโพยเป็นหลัก
      </p>
    </div>
  </ContentBoxCyberCut>

  <LoginRtpSection />

  <ContentBoxSevenThreeNeumorphism as="h2" title="ฝากเครดิตแทงหวย กินดี365 ได้ทุกช่องทาง ธนาคารและวอลเลท">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นคืนยอดเสียของ กินดี365 พื้นหลังสีน้ำเงินกรมท่าไล่เฉดพร้อมประกายทอง ด้านบนกลางภาพเป็นโลโก้คำว่า กินดี สีทองวางเหนือเลข 365 ถัดลงมาเป็นคำว่า โปรโมชั่น สีขาวในแผ่นป้ายสีน้ำเงิน ตามด้วยคำว่า คืนยอดเสีย ตัวหนาสีขาวขอบทอง และตัวเลข 0.3% ขนาดใหญ่สีทองบนแผ่นป้ายสีน้ำเงินขอบทอง ด้านขวาเป็นผู้หญิงผมยาวสีเงินสวมชุดไทยประยุกต์สีขาวทองประดับอัญมณีสีน้ำเงิน กำลังชี้นิ้วมาที่ตัวเลข รอบภาพมีลูกบอลหวยเลข 8 เลข 3 และเลข 7 สลากรัฐบาลไทยสองใบ และเหรียญทองกระจายอยู่ ด้านล่างเป็นแถบสี่ช่องเขียนว่า จ่ายจริงไม่อั้น รับเลขดังเลขอั้น ไม่ลบบิล และไม่เบี้ยวโพย"
      class="mx-auto h-auto w-full rounded-2xl border border-[#e9c55d]/40 shadow-[0_10px_30px_rgba(233,197,93,0.25)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#dbe4f5]">
      สมาชิก <strong class="text-[#fbeeb8]">กินดี365</strong> สามารถเติมเครดิตสำหรับแทงหวยผ่านช่องทางการเงินที่ระบบเปิดรองรับ ทั้งบัญชีธนาคารและวอลเลท สามารถตรวจสอบยอด ฝากเครดิต ส่งคำขอถอน
