---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxTwoFloatingBadge from "../components/ContentBoxTwoFloatingBadge.astro";
import LottoGrid from "../components/LottoGrid.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import LatestWinners from "../components/LatestWinners2.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Faq from "../components/Faq2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// Title and description are the brief's own Title/Description lines, used
// verbatim. A brief-supplied description is never padded up to the 150-char
// floor and never topped up from the H1/H2.
const pageTitle = "หวยกินดี365 จ่ายเต็มบาทละ1,000 รับแทงไม่อั้น ตรวจสอบได้ ไม่มีประวัติเสีย";

const pageDescription = "หวยกินดี365 จ่ายเต็มบาทละ1,000 รับแทงหวย รัฐบาลไทย ลาวพัฒนา 3ฮานอย หุ้นต่างประเทศ";

// The ticker copy is passed explicitly rather than relying on the component's
// default — every Announcement* variant's default belongs to whichever brand
// wired it in last. No emoji in this string: an emoji baked into a text prop
// cannot be given its own aria-hidden span, and this marquee prints the string
// twice.
const announcement =
  "หวยกินดี365 จ่ายเต็มบาทละ 1,000 รับแทงไม่อั้น ตรวจสอบได้ ไม่มีประวัติเสีย • รวมบริการแทงหวยออนไลน์หลายประเภทไว้ในระบบเดียว ทั้งหวยรัฐบาลไทย หวยลาวพัฒนา หวยฮานอย 3 รูปแบบ และหวยหุ้นต่างประเทศ • อัตราจ่ายตามที่กำหนดสำหรับหน้านี้ เลข 3 ตัวบาทละ 1,000 และเลข 2 ตัวบาทละ 100 คำนวณยอดตามเรทได้ก่อนส่งโพย • เลือกตลาดหวย รอบเดิมพัน เลขที่ต้องการ และจำนวนเงินผ่านมือถือได้ด้วยตัวเอง • ก่อนยืนยันโพยควรตรวจสอบเวลาเปิด-ปิด อัตราจ่าย และยอดรวมอีกครั้ง เพราะรายละเอียดของหวยแต่ละประเภทอาจไม่เหมือนกัน • ฝากเครดิตผ่านระบบออโต้ เลือกช่องทางธนาคารหรือวอลเลทที่เว็บไซต์เปิดรองรับ • เจ้าหน้าที่ หวยกินดี365 ออนไลน์ตลอด 24 ชั่วโมง ติดต่อได้ทันที";

// The brief's own rate tables, kept as data so the markup below stays a single
// semantic <table> per H3 instead of two hand-typed grids. All five rows the
// brief lists are included.
const rateTwoDigit = [
  { stake: "1 บาท", rate: "1 : 100", payout: "100 บาท" },
  { stake: "5 บาท", rate: "1 : 100", payout: "500 บาท" },
  { stake: "10 บาท", rate: "1 : 100", payout: "1,000 บาท" },
  { stake: "50 บาท", rate: "1 : 100", payout: "5,000 บาท" },
  { stake: "100 บาท", rate: "1 : 100", payout: "10,000 บาท" },
];

const rateThreeDigit = [
  { stake: "1 บาท", rate: "1 : 1,000", payout: "1,000 บาท" },
  { stake: "5 บาท", rate: "1 : 1,000", payout: "5,000 บาท" },
  { stake: "10 บาท", rate: "1 : 1,000", payout: "10,000 บาท" },
  { stake: "50 บาท", rate: "1 : 1,000", payout: "50,000 บาท" },
  { stake: "100 บาท", rate: "1 : 1,000", payout: "100,000 บาท" },
];

// One array, used by both <Faq> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last.
const faqs = [
  {
    q: "หวยกินดี365 มีหวยประเภทไหนให้เลือกแทงบ้าง?",
    a: "มีหวยรัฐบาลไทย หวยลาวพัฒนา หวยฮานอย 3 รูปแบบ และหวยหุ้นต่างประเทศตามรอบที่เปิดให้บริการ โดยเวลาเปิดรับและรายละเอียดการเดิมพันอาจแตกต่างกัน ควรตรวจสอบข้อมูลบนหน้าส่งโพยก่อนแทงทุกครั้ง",
  },
  {
    q: "หวยกินดี365 จ่าย 3 ตัว 1,000 และ 2 ตัว 100 หรือไม่?",
    a: "ตามอัตราที่กำหนดสำหรับหน้านี้ เลข 3 ตัวอยู่ที่บาทละ 1,000 และเลข 2 ตัวอยู่ที่บาทละ 100 แต่สมาชิกควรตรวจสอบเรทจริงที่ระบบแสดงก่อนยืนยันโพย เนื่องจากบางประเภทหรือบางรอบอาจมีเงื่อนไขเฉพาะ",
  },
  {
    q: "ฝากถอน หวยกินดี365 แล้วเครดิตไม่เข้าต้องทำอย่างไร?",
    a: "เริ่มจากตรวจสอบประวัติธุรกรรมในบัญชี หากรายการยังค้างหรือยอดไม่ถูกต้อง ให้ติดต่อเจ้าหน้าที่พร้อมแจ้งจำนวนเงิน เวลา และช่องทางที่ใช้ทำรายการ เพื่อให้ทีมงานช่วยตรวจสอบได้ตลอด 24 ชั่วโมง",
  },
];

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb. Every URL in the graph is derived
// by pageGraph from `site:` — no domain is typed out in this file.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <ContentBoxNeumorphism as="h1" title="หวยกินดี365 จ่ายเต็มบาทละ1,000 รับแทงหวยทั่วโลก">
    <p class="text-left text-base leading-relaxed text-[#dce7fb]">
      <strong class="text-[#fbe473]">หวยกินดี365</strong> รวมบริการแทงหวยออนไลน์หลายประเภทไว้ในระบบเดียว เหมาะกับคนที่ต้องการเลือกเล่นได้หลายตลาดโดยไม่ต้องสลับเว็บไซต์ มีทั้งหวยรัฐบาลไทย
      หวยลาวพัฒนา หวยฮานอย และหวยหุ้นต่างประเทศ พร้อมอัตราจ่ายตามที่กำหนด 3 ตัวบาทละ <strong class="text-[#fbe473]">1,000</strong> และ 2 ตัวบาทละ
      <strong class="text-[#fbe473]">100</strong> สมาชิกสามารถตรวจสอบเรทก่อนส่งโพย ฝากเครดิตผ่านระบบออโต้ และติดต่อเจ้าหน้าที่ได้ตลอด 24 ชั่วโมง
    </p>
  </ContentBoxNeumorphism>

  <ContentBoxTwoFloatingBadge as="h2" title="หวยกินดี365 รับแทงทุกประเภท รัฐบาลไทย ลาวพัฒนา 3ฮานอย หุ้นต่างประเทศ">
    <p slot="left" class="text-left text-base leading-relaxed text-[#dce7fb]">
      <strong class="text-[#fbe473]">หวยกินดี365</strong> เปิดหมวดหวยให้เลือกตามรอบที่ให้บริการ ครอบคลุมหวยรัฐบาลไทย หวยลาวพัฒนา หวยฮานอย 3 รูปแบบ และหวยหุ้นต่างประเทศ
      สมาชิกสามารถเลือกตลาดหวย รอบเดิมพัน เลขที่ต้องการ และจำนวนเงินผ่านมือถือได้ด้วยตัวเอง ก่อนยืนยันโพยแนะนำให้ตรวจสอบเวลาเปิด-ปิด เลขที่เลือก อัตราจ่าย และยอดรวมอีกครั้ง
      เพราะรายละเอียดของหวยแต่ละประเภทอาจไม่เหมือนกัน
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#dce7fb]">
      สำหรับคำว่า “รับแทงไม่อั้น” ควรยึดวงเงินที่ระบบแสดง ณ เวลาส่งโพยเป็นหลัก เนื่องจากบางรอบหรือบางหมายเลขอาจมีวงเงินรับแตกต่างกัน
    </p>
  </ContentBoxTwoFloatingBadge>

  <LottoGrid />

  <ContentBoxSevenThreeCyberCut as="h2" title="เว็บ หวยกินดี365 ให้อัตราจ่ายสูง 3ตัว1,000/2ตัว100">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อนของ หวยกินดี365 พื้นหลังสีน้ำเงินไล่เฉดพร้อมประกายทอง มุมขวาบนเป็นโลโก้คำว่า หวยกินดี สีทองวางเหนือเลข 365 สีขาวขอบทอง ถัดลงมาเป็นคำว่า โปรโมชั่น ตัวหนาสีทอง ตามด้วยแผ่นป้ายสีน้ำเงินขอบทองเขียนว่า แนะนำเพื่อน และตัวเลข 0.8% ขนาดใหญ่สีทอง ด้านซ้ายเป็นผู้หญิงผมยาวสีเงินสวมชุดไทยประยุกต์สีน้ำเงินขาวประดับทอง กำลังแบมือไปทางตัวเลข รอบภาพมีลูกบอลหวยเลข 5 เลข 9 เลข 3 และเลข 8 พร้อมสลากกินแบ่งรัฐบาลไทยและเหรียญทองกระจายอยู่"
      class="mx-auto h-auto w-full rounded-2xl border border-[#f6db6b]/40 shadow-[0_10px_30px_rgba(246,219,107,0.25)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#dce7fb]">
      อัตราจ่ายของ <strong class="text-[#fbe473]">หวยกินดี365</strong> ตามข้อมูลที่กำหนดสำหรับหน้านี้คือ เลข 2 ตัว บาทละ <span class="font-black text-[#f6db6b]">100</span> และเลข 3 ตัว บาทละ
      <span class="font-black text-[#f6db6b]">1,000</span> สมาชิกจึงสามารถคำนวณยอดตามเรทเบื้องต้นได้ก่อนส่งโพย อย่างไรก็ตาม ควรตรวจสอบอัตราจ่ายจริงบนหน้าแทงหวยทุกครั้ง
      โดยเฉพาะเมื่อต้องการแทงหวยต่างประเภทหรือต่างรอบ
    </p>
  </ContentBoxSevenThreeCyberCut>

  <ContentBoxPremium as="h3" title="แทงหวย 2 ตัว ถูกจ่ายบาทละ 100">
    <div class="flex flex-col gap-6">
      <p class="text-left text-base leading-relaxed text-[#dce7fb]">
        เลข 2 ตัวกำหนดเรทไว้ที่ 1 บาท จ่าย <strong class="text-[#fbe473]">100</strong> บาท สามารถคำนวณยอดตามจำนวนเงินที่เลือกแทงได้ตรงไปตรงมา
      </p>

      <div class="overflow-x-auto rounded-2xl border border-[#f6db6b]/35">
        <table class="w-full min-w-[420px] border-collapse text-left text-base">
          <caption class="sr-only">ตารางอัตราจ่ายหวย 2 ตัว บาทละ 100 เทียบยอดแทงกับยอดตามเรทเมื่อถูก</caption>
          <thead class="bg-gradient-to-r from-[#062a6b] to-[#03153b]">
            <tr class="text-[#fbe473]">
              <th scope="col" class="p-4 font-black">ยอดแทง</th>
              <th scope="col" class="p-4 text-center font-black">อัตราจ่าย</th>
              <th scope="col" class="p-4 text-right font-black">ยอดตามเรทเมื่อถูก</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#0534ba]/60 text-[#dce7fb]">
            {
              rateTwoDigit.map((row) => (
                <tr class="transition-colors hover:bg-[#041b44]/80">
                  <td class="p-4 font-bold text-[#dce7fb]">{row.stake}</td>
                  <td class="p-4 text-center font-black tracking-wider text-[#f6db6b]">{row.rate}</td>
                  <td class="p-4 text-right font-black tracking-wider text-[#5ec2f5]">{row.payout}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="text-left text-base leading-relaxed text-[#dce7fb]">
        ตัวอย่าง หากแทงเลข 2 ตัวจำนวน 10 บาท และเรทในรอบนั้นยังอยู่ที่ 100 เมื่อผลตรงตามเงื่อนไขจะคำนวณตามเรทเป็น 10 × 100 = <strong class="text-[#fbe473]">1,000</strong> บาท
      </p>
    </div>
  </ContentBoxPremium>

  <ContentBoxPremium as="h3" title="แทงหวย 3 ตัว ถูกจ่ายบาทละ 1,000">
    <div class="flex flex-col gap-6">
      <p class="text-left text-base leading-relaxed text-[#dce7fb]">
        สำหรับเลข 3 ตัว กำหนดเรทตามข้อมูลหน้านี้ไว้ที่ 1 บาท จ่าย <strong class="text-[#fbe473]">1,000</strong> บาท เหมาะกับการแสดงเป็นตารางเพื่อให้ผู้ใช้เห็นยอดตามเรทได้ชัดเจนก่อนตัดสินใจส่งโพย
      </p>

      <div class="overflow-x-auto rounded-2xl border border-[#f6db6b]/35">
        <table class="w-full min-w-[420px] border-collapse text-left text-base">
          <caption class="sr-only">ตารางอัตราจ่ายหวย 3 ตัว บาทละ 1,000 เทียบยอดแทงกับยอดตามเรทเมื่อถูก</caption>
          <thead class="bg-gradient-to-r from-[#062a6b] to-[#03153b]">
            <tr class="text-[#fbe473]">
              <th scope="col" class="p-4 font-black">ยอดแทง</th>
              <th scope="col" class="p-4 text-center font-black">อัตราจ่าย</th>
              <th scope="col" class="p-4 text-right font-black">ยอดตามเรทเมื่อถูก</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#0534ba]/60 text-[#dce7fb]">
            {
              rateThreeDigit.map((row) => (
                <tr class="transition-colors hover:bg-[#041b44]/80">
                  <td class="p-4 font-bold text-[#dce7fb]">{row.stake}</td>
                  <td class="p-4 text-center font-black tracking-wider text-[#f6db6b]">{row.rate}</td>
                  <td class="p-4 text-right font-black tracking-wider text-[#5ec2f5]">{row.payout}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="text-left text-base leading-relaxed text-[#dce7fb]">
        ตัวอย่าง หากแทงเลข 3 ตัว 10 บาท และอัตราจ่ายที่แสดงก่อนส่งโพยคือ 1,000 ยอดตามเรทเมื่อผลตรงตามเงื่อนไขจะเท่ากับ 10 × 1,000 = <strong class="text-[#fbe473]">10,000</strong> บาท
      </p>
    </div>
  </ContentBoxPremium>

  <LoginRtpSection />

  <ContentBoxSevenThreeFloatingBadge as="h2" title="ฝากเครดิตออโต้ เว็บ หวยกินดี365 ได้ทุกช่องทางธนาคารและวอลเลท">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นคืนยอดเสียของ หวยกินดี365 พื้นหลังสีน้ำเงินไล่เฉดพร้อมประกายทอง ด้านบนกลางภาพเป็นโลโก้คำว่า หวยกินดี สีทองวางเหนือเลข 365 สีขาวขอบทอง ถัดลงมาเป็นคำว่า โปรโมชั่น ตัวหนาสีทอง ตามด้วยแผ่นป้ายสีน้ำเงินขอบทองเขียนว่า คืนยอดเสีย และตัวเลข 0.3% ขนาดใหญ่สีทอง ด้านซ้ายเป็นผู้หญิงผมยาวสีเงินสวมชุดไทยประยุกต์สีน้ำเงินขาวประดับทอง กำลังชี้นิ้วไปทางตัวเลข สี่มุมภาพมีลูกบอลหวยเลข 8 เลข 3 เลข 5 และเลข 9 พร้อมสลากกินแบ่งรัฐบาลไทยและกองเหรียญทองวางอยู่"
      class="mx-auto h-auto w-full rounded-2xl border border-[#f6db6b]/40 shadow-[0_10px_30px_rgba(246,219,107,0.25)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#dce7fb]">
      สมาชิกสามารถเติมเครดิต <strong class="text-[#fbe473]">หวยกินดี365</strong> ผ่านระบบฝากออโต้ โดยเลือกช่องทางธนาคารหรือวอลเลทที่เว็บไซต์เปิดรองรับ
      จากนั้นตรวจสอบจำนวนเงินและรายละเอียดบัญชีก่อนยืนยัน เมื่อทำรายการแล้วสามารถติดตามเครดิตและประวัติธุรกรรมผ่านบัญชีสมาชิกได้ด้วยตัวเอง ส่วนรายชื่อธนาคาร วอลเลท ยอดฝากขั้นต่ำ
      และวงเงินถอน ควรยึดข้อมูลล่าสุดที่ปรากฏในระบบก่อนทำธุรกรรม
    </p>
  </ContentBoxSevenThreeFloatingBadge>

  <LatestWinners />

  <ContentBoxCyberCut as="h2" title="เจ้าหน้าที่ หวยกินดี365 ออนไลน์ตลอด 24 ชั่วโมง ติดต่อได้ทันที">
