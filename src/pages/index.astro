---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxTwoFloatingBadge from "../components/ContentBoxTwoFloatingBadge.astro";
import ContentBoxTwo from "../components/ContentBoxTwo.astro";
import Faq3 from "../components/Faq3.astro";
import LatestWinners from "../components/LatestWinnersCyber.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// slide1 is the แนะนำเพื่อน 0.8% poster and slide2 is the คืนยอดเสีย 0.3% one, in
// the same order the docx runs its two H3 sub-sections. slide3 and slide4 belong
// to a previous client's drop and are never imported here, and there is no
// banner2+ illustration in this brand's drop.

// Title and description are the brief's own Title/Description lines, used
// verbatim. A brief-supplied description is never padded up to the 150-char
// floor and never topped up from the H1/H2 — this one is 108 characters and
// that is correct.
const pageTitle = "WIN8S สล็อตเว็บตรงที่ดีที่สุด ฝากวอลเลท เล่นขั้นต่ำ1บาท";

const pageDescription = "WIN8S สล็อตเว็บตรงที่ดีที่สุด เล่นง่าย ไม่มีขั้นต่ำ เบท1บาททุกเกม รองรับการฝากถอน วอลเลท ธนาคารชั้นนำ";

// The ticker copy is passed explicitly rather than relying on the component's
// default — every Announcement* variant's default belongs to whichever brand
// wired it in last. No emoji in this string: an emoji baked into a text prop
// cannot be given its own aria-hidden span, and this marquee prints the string
// twice.
const announcement =
  "WIN8S สล็อตเว็บตรง เล่นง่าย ฝากวอลเลท รองรับมือถือ แท็บเล็ต และคอมพิวเตอร์ • รวมเกมสล็อตจากหลายค่ายไว้ในบัญชีเดียว ทั้งสล็อตคลาสสิก สล็อตวิดีโอ เกมโบนัส ฟรีสปิน และเกมธีมต่าง ๆ • เลือกเกมและปรับระดับเดิมพันได้ตามช่วงที่แต่ละเกมกำหนด ควรตรวจสอบช่วงเดิมพันในเกมก่อนเริ่มเล่นทุกครั้ง เนื่องจากขั้นต่ำจริงอาจแตกต่างกันตามค่ายและเกมสล็อต • Login เพื่อตรวจสอบโปรโมชั่นที่มีสิทธิ์รับผ่านบัญชีของตนเอง • โปรโมชั่นแนะนำเพื่อน โบนัส 0.8% และโปรโมชั่นคืนยอดเสีย โบนัส 0.3% ตามเงื่อนไขที่กำหนด • ฝากถอนผ่านวอลเลทหรือธนาคารตามช่องทางที่ระบบเปิดรองรับ ควรตรวจสอบยอดขั้นต่ำและวงเงินก่อนทำรายการ • ทีมงาน WIN8S ช่วยเหลือด้านการใช้งานตลอด 24 ชั่วโมง";

// One array, used by both <Faq3> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last.
const faqs = [
  {
    q: "WIN8S เล่นเกมสล็อตเริ่มต้น 1 บาทได้ทุกเกมหรือไม่?",
    a: "ขึ้นอยู่กับช่วงเดิมพันที่แต่ละค่ายและแต่ละเกมกำหนด บางเกมอาจเริ่มต้นที่ 1 บาท ขณะที่บางเกมอาจมีขั้นต่ำต่างกัน จึงควรตรวจสอบตัวเลขเดิมพันในเกมก่อนเริ่มเล่นทุกครั้ง",
  },
  {
    q: "โปรโมชั่น WIN8S โบนัส 0.8% และ 0.3% ต่างกันอย่างไร?",
    a: "โบนัส 0.8% เป็นโปรโมชั่นแนะนำเพื่อนสำหรับยอดที่ตรงตามเงื่อนไข ส่วนโบนัส 0.3% เป็นโปรโมชั่นคืนยอดเสียตามรอบที่กำหนด สมาชิกควรตรวจสอบวิธีคำนวณและเงื่อนไขล่าสุดก่อนกดรับโบนัส",
  },
  {
    q: "WIN8S ฝากถอนผ่านวอลเลทและธนาคารได้หรือไม่?",
    a: "สามารถเลือกใช้วอลเลทและบัญชีธนาคารตามช่องทางที่ WIN8S เปิดรองรับในขณะนั้นได้ ก่อนทำรายการควรตรวจสอบยอดขั้นต่ำ วงเงิน และสถานะของแต่ละช่องทางจากหน้าฝากถอนโดยตรง",
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// Cream marks a claim the brief states outright; warm amber marks the caveat
// that goes with it.

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb. Every URL in the graph is derived
// by pageGraph from `site:` — no domain is typed out in this file.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <ContentBoxCyberCut as="h1" title="WIN8S สล็อตเว็บตรงที่ดีที่สุด ค่ายแท้ ได้เงินจริง ปลอดภัย100%">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f6e4d6]">
        <strong class="text-[#fff2e6]">WIN8S</strong> ให้บริการเกมสล็อตออนไลน์สำหรับสมาชิกที่ต้องการรวมเกมจากหลายค่ายไว้ในบัญชีเดียว รองรับการใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ สามารถเลือกเกม ฝากถอน
        ตรวจสอบโปรโมชั่น และจัดการเครดิตได้จากหน้าเว็บไซต์
        <strong class="text-[#fff2e6]">พร้อมช่องทางวอลเลทและธนาคารตามที่ระบบเปิดรองรับ</strong>
        รวมถึงมีทีมงานคอยช่วยเหลือด้านการใช้งานตลอด 24 ชั่วโมง
      </p>
      <p class="text-left text-base leading-relaxed text-[#f6e4d6]">
        สำหรับคำว่า “ดีที่สุด”, “ค่ายแท้”, “ได้เงินจริง” และ “ปลอดภัย 100%”
        <strong class="text-[#ffc98a]">ควรใช้เมื่อมีข้อมูลหรือหลักฐานบนเว็บไซต์รองรับอย่างชัดเจน</strong>
        เพื่อให้เนื้อหาน่าเชื่อถือและไม่เป็นการกล่าวอ้างเกินจริง
      </p>
    </div>
  </ContentBoxCyberCut>

  <ContentBoxTwoNeumorphism as="h2" title="WIN8S เล่นง่าย ไม่มีขั้นต่ำ เบท1บาททุกเกม">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f6e4d6]">
      <strong class="text-[#fff2e6]">WIN8S</strong> จัดหมวดเกมสล็อตจากหลายค่ายไว้ให้สมาชิกเลือกตามรูปแบบที่สนใจ มีทั้งสล็อตคลาสสิก สล็อตวิดีโอ เกมโบนัส ฟรีสปิน และเกมธีมต่าง ๆ
      <strong class="text-[#fff2e6]">สมาชิกสามารถเลือกเกมและปรับระดับเดิมพันได้ตามช่วงที่แต่ละเกมกำหนด</strong>
      รองรับการเล่นผ่านมือถือโดยไม่ต้องติดตั้งหลายระบบ
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#f6e4d6]">
      หากต้องการเล่นด้วยเดิมพันเริ่มต้น 1 บาท <strong class="text-[#ffc98a]">ควรตรวจสอบช่วงเดิมพันในเกมก่อนทุกครั้ง</strong> เนื่องจากขั้นต่ำจริงอาจแตกต่างกันตามค่ายและเกมสล็อต ส่วนคำว่า “ไม่มีขั้นต่ำ”
      ควรอ้างอิงจากเงื่อนไขที่ระบบแสดง ณ เวลาทำรายการ
    </p>
  </ContentBoxTwoNeumorphism>

  <ProviderGrid />

  <GameRankingBoard />

  <ContentBoxPremium as="h2" title="เว็บสล็อต WIN8S รองรับวอลเลท รับโปรโมชั่นได้ทุกยูส">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f6e4d6]">
        สมาชิก <strong class="text-[#fff2e6]">WIN8S</strong> สามารถเลือกใช้วอลเลทหรือช่องทางการเงินที่เว็บไซต์เปิดรองรับ
        <strong class="text-[#fff2e6]">พร้อม Login เพื่อตรวจสอบโปรโมชั่นที่มีสิทธิ์รับผ่านบัญชีของตนเอง</strong>
        โดยโปรโมชั่นแต่ละรายการอาจกำหนดรอบคำนวณ ยอดขั้นต่ำ เกมที่เข้าร่วม และเงื่อนไขการถอนแตกต่างกัน
      </p>
      <p class="text-left text-base leading-relaxed text-[#f6e4d6]">
        คำว่า “รับโปรโมชั่นได้ทุกยูส” <strong class="text-[#ffc98a]">ควรใช้ตามเงื่อนไขจริงของแต่ละกิจกรรม</strong> เนื่องจากบางโปรโมชั่นอาจจำกัดเฉพาะบัญชีที่มีคุณสมบัติตรงตามที่กำหนด
      </p>
    </div>
  </ContentBoxPremium>

  <LoginRtpSection />

  <ContentBoxSevenThreeNeumorphism as="h3" title="โปรโมชั่นแนะนำเพื่อน โบนัส 0.8%">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อน 0.8% ของ WIN8S พื้นหลังคาสิโนโทนดำส้ม ด้านบนกลางภาพเป็นโลโก้ WIN8S ตัวอักษร WIN สีส้มและเลข 8S สีเงินโครเมียม มีวงล้อสล็อต 777 คั่น ถัดลงมาเป็นป้ายคำว่า โปรโมชั่น ตามด้วยข้อความ แนะนำเพื่อน วางเหนือตัวเลข 0.8% ขนาดใหญ่สีขาวขอบส้ม ด้านซ้ายเป็นมือถือแสดงหน้าเกมสล็อต MEGA WIN 12,450.00 ด้านขวาเป็นผู้หญิงผมรวบสวมชุดสีดำคาดส้มยกมือชี้มาที่ตัวเลข ฉากหลังมีป้าย JACKPOT 168,888.00 วงล้อสล็อต 777 BAR เหรียญทองปลิว และกล่องของขวัญ ด้านล่างเป็นป้ายสามอันเขียนว่า แนะนำเพื่อน รับโบนัสทันที กับ เพื่อนสมัคร รับโบนัสได้เลย และ รับโบนัสสูงสุด ไม่จำกัด"
      class="mx-auto h-auto w-full rounded-2xl border border-[#f36403]/45 shadow-[0_10px_30px_rgba(243,100,3,0.25)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f6e4d6]">
      สมาชิกสามารถแชร์ลิงก์แนะนำส่วนตัวให้เพื่อน เมื่อเพื่อนสมัครและมียอดใช้งานตรงตามเงื่อนไข <strong class="text-[#fff2e6]">ระบบจะคำนวณโบนัสแนะนำเพื่อน 0.8% ตามยอดที่เข้าเกณฑ์</strong> สามารถตรวจสอบจำนวนเพื่อน
      ยอดคำนวณ และโบนัสที่มีสิทธิ์รับผ่านบัญชีสมาชิกได้โดยตรง
    </p>
  </ContentBoxSevenThreeNeumorphism>

  <ContentBoxSevenThreeCyberCut as="h3" title="โปรโมชั่นคืนยอดเสีย โบนัส 0.3%">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นคืนยอดเสีย 0.3% ของ WIN8S พื้นหลังคาสิโนโทนดำส้ม ด้านบนกลางภาพเป็นโลโก้ WIN8S ตัวอักษร WIN สีส้มและเลข 8S สีเงินโครเมียม มีวงล้อสล็อต 777 คั่น ถัดลงมาเป็นป้ายคำว่า โปรโมชั่น ตามด้วยข้อความ คืนยอดเสีย วางเหนือตัวเลข 0.3% ขนาดใหญ่สีส้มไล่เฉด ด้านขวาเป็นผู้หญิงผมรวบสวมชุดสีดำคาดส้มยกมือชี้มาที่ตัวเลข ด้านซ้ายเป็นวงล้อสล็อต 777 และเหรียญชิปสีส้มดำ ฉากหลังมีตู้สล็อตเรืองแสงส้ม เหรียญทองปลิว และกล่องของขวัญ"
      class="mx-auto h-auto w-full rounded-2xl border border-[#e3e7ec]/35 shadow-[0_10px_30px_rgba(227,231,236,0.18)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f6e4d6]">
      หากสมาชิกมียอดเสียตรงตามข้อกำหนด <strong class="text-[#fff2e6]">สามารถตรวจสอบสิทธิ์รับโบนัสคืนยอดเสีย 0.3% ตามรอบที่ WIN8S กำหนด</strong> โดยระบบจะแสดงยอดที่เข้าเงื่อนไขและจำนวนโบนัสที่สามารถรับได้
      ก่อนกดรับควรตรวจสอบประเภทเกม รอบคำนวณ และเงื่อนไขของโปรโมชั่นให้ครบถ้วน
    </p>
  </ContentBoxSevenThreeCyberCut>

  <ContentBoxTwoFloatingBadge as="h2" title="สมัครสมาชิก WIN8S ง่ายๆ 3 ขั้นตอน">
    <div slot="left" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f6e4d6]">การสมัคร <strong class="text-[#fff2e6]">WIN8S</strong> สามารถดำเนินการผ่านมือถือหรือคอมพิวเตอร์ได้ด้วยขั้นตอนที่ไม่ซับซ้อน</p>
      <ol class="flex list-decimal flex-col gap-2 pl-6 text-left text-base leading-relaxed text-[#f6e4d6]">
        <li>เข้าหน้าสมัคร WIN8S และกรอกข้อมูลตามที่ระบบกำหนด</li>
        <li>Login เข้าสู่บัญชีและเลือกช่องทางฝากเครดิตที่เปิดให้บริการ</li>
        <li>ตรวจสอบโปรโมชั่น เลือกค่ายและเกมสล็อตที่ต้องการก่อนเริ่มเล่น</li>
      </ol>
    </div>
    <p slot="right" class="text-left text-base leading-relaxed text-[#f6e4d6]">
      หลังสมัครเรียบร้อย สมาชิกสามารถตรวจสอบเครดิต โปรโมชั่น ประวัติรายการ และสถานะฝากถอนผ่านบัญชีของตนเองได้ <strong class="text-[#ffc98a]">
        โดยควรตั้งรหัสผ่านที่คาดเดายากและไม่เปิดเผย OTP ให้บุคคลอื่น
      </strong>
    </p>
  </ContentBoxTwoFloatingBadge>

  <ContentBoxTwo as="h2" title="ระบบช่วยเหลือ WIN8S สามารถติดต่อแอดมิน ได้ 24 ชั่วโมง">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f6e4d6]">
      หากพบปัญหาเกี่ยวกับการสมัคร Login ไม่ได้ ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง โปรโมชั่นไม่แสดง หรือเข้าเกมสล็อตไม่ได้ <strong class="text-[#fff2e6]">
        สามารถติดต่อแอดมิน WIN8S ได้ตลอด 24 ชั่วโมง
      </strong>
      พร้อมแจ้งเวลา จำนวนเงิน และรายละเอียดของรายการ เพื่อช่วยให้เจ้าหน้าที่ตรวจสอบปัญหาได้ตรงจุด
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#f6e4d6]">
      สมาชิกใหม่ยังสามารถสอบถามเกี่ยวกับขั้นตอนฝากถอน วิธีรับโปรโมชั่น หรือการเข้าใช้งานเกมแต่ละค่ายได้ <strong class="text-[#ffc98a]">
