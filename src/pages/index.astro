---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import LatestWinners from "../components/LatestWinners3.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBox3ThreeCyberCut from "../components/ContentBox3ThreeCyberCut.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import Faq from "../components/Faq4.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import { pageGraph } from "../lib/schema";
import promoCashback from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";

// VARIANT ROTATION THIS ROUND, decided in .claude/brand-spec-meechoke168.md §3 and
// NOT re-picked here: Announcement3 replaces Announcement5, LatestWinners3 replaces
// LatestWinnersPremium, Faq4 replaces Faq2, ReviewCardSumo replaces ReviewCardSumo2,
// and the ContentBox shape-mix leaves Premium / TwoNeumorphism / SevenThreeCyberCut /
// SevenThreeNeumorphism / 3ThreePremium / Special behind for FloatingBadge /
// TwoCyberCut / SevenThreePremium / SevenThree / 3ThreeCyberCut / Neumorphism.
// NavbarStyle8 + FooterStyle3 are the layout's pair this round and the brand font moves
// kanit -> google-sans; all of that is the orchestrator's shared-chrome step, not this
// page's.
// Plain ContentBox is the one sanctioned carry-over (brand-spec §3): it is the
// always-live box that terms, privacy, 404, /promotion and the button pages render
// through, so it cannot follow a rotation. Section 3 is the single docx section it
// carries here.
// ContentBoxTwo is live too but is NOT imported here — it is reached only through
// LoginRtpSection, so an "is it used?" grep has to match the bare filename.
// Every unused *Premium / *Cyber / *Huay / *Neumorphism / *Style sibling, the other
// Faq* and Announcement* files, the other LatestWinners* and ReviewCardSumo2 all stay
// on disk as inventory for the next brand — nothing was deleted, and the earlier
// brands' hues still inside them are expected drift.
//
// <Announcement /> runs bare on purpose: Announcement3's default message is already
// this brand's copy, set by the orchestrator from this brief, and every sub-page calls
// it bare too — so passing an override here is exactly how the ticker ends up saying
// two different things on two pages of the same site.
//
// PALETTE — GOLD LEADS, HOT PINK IS THE REAL SECOND HUE, DEEP PLUM IS A SHADOW THAT
// NEVER CARRIES TEXT, ON PURE BLACK (brand-spec §2). Read off the artwork: the logo is
// a white-and-orange-gold maneki-neko lucky cat sitting above the word มีโชค in thick
// 3-D Thai lettering that ramps HOT PINK into GOLD, followed by 168 in 3-D gold
// numerals, ringed by hot-pink satin ribbon, square-holed Chinese gold coins, Chinese
// gold ingots, pink hearts and pink sakura blossoms. The banner is the same black scene
// with a silver-haired woman in a pink gold-embroidered Chinese gown holding a Chinese
// coin, sakura in her hair.
// ⚠️ The thing that separates this round from the three before it is the SECOND HUE:
// ขวัญใจ168 was rose-gold f2bba5/c98a74, รับตัง168 was vivid red d30304 and สมหวัง168
// was red-lead fa0513 — this round is HOT PINK #f5469f, and it has to be VISIBLE on the
// page rather than written down in a spec. It carries headings, column labels, gradient
// stops, picture frames and auras across every box below.
// ⚠️ The page background is PURE BLACK #000000 (bg.json). Depth ramp: #24101c raised /
// #160a12 mid / #0b0509 sunken / #000000 page — nothing sinks below the page.
// ⚠️ Compare by VALUE, never by colour family — GOLD is this round's trap because gold
// leads here and nearly every brand that ever passed through this repo also had a gold.
// This round's gold is #fcd434 (R=252 G=212 B=52) and nothing else: not f7c92b
// (ขวัญใจ168, the brand immediately before), f0b429 (รับตัง168), e3b23c (สมหวัง168),
// dfa310 ffc93d ffe4a3 (TND168), f2c230 ffe066 (KINGKONG555), e2b33f (KMD88), e5a81b
// (UFA324), fad354 (789BETTING), f5c518 (FLASH877), fce343 (PUNPRO168), f3bb34
// (DUCK1688) or fbe455 (WEPLAY168). This round's pink is #f5469f / #ff8dc6 — NOT
// f41571 / ff5ca8 (PUNPRO168), which is the same hot-pink family at different values.
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// Body copy is #f6e4ee (= BRAND_TEXT), 17.2:1 on the page and 14.9:1 on the raised
// surface. The ONE highlight colour a <strong> may take is #ffeaa0 (17.6:1). #fcd434
// (12.4:1), #f5469f (6.2:1) and #ff8dc6 (9.9:1) carry headings, links and secondary
// labels. #8c0f52 and #7a5508 never carry text at any size: borders, plates, rules,
// gradient ends and auras only. #1a0612 is the only ink allowed on a solid gold or
// solid pink fill. Glow rgba is rgba(252,212,52,α), rgba(245,70,159,α),
// rgba(255,141,198,α) or rgba(140,15,82,α).
// ⚠️ No blue, cyan, purple/violet, green, orange, silver/chrome, rose-gold (f2bba5 /
// c98a74) or vermilion (b3121b) this round. eadfce is ขวัญใจ168's body colour and
// cfd9e6 is รับตัง168's silver — if either is anywhere, it is stale.
//
// IMAGE ROLES FOR THIS DROP (2026-10-18, brand-spec §4). Exactly TWO files are
// referenced from this page, both from this drop, and THE TEXT PRINTED ON THE ART is
// what decides the pairing:
//   slide1.png -> §4, because its own plaque reads คืนยอดเสีย with 0.3% under it
//   slide2.png -> §5, because its own plaque reads แนะนำเพื่อน with 0.8% under it
// ⚠️ LAST ROUND THESE WERE SWAPPED (slide2 = คืนยอดเสีย, slide1 = แนะนำเพื่อน). Anyone
// copying the previous brand's import lines gets a picture that contradicts the heading
// above it. Both alts below were written from THIS drop's bitmaps, opened and read with
// the Read tool; neither is copied from a spec table and neither is a counter.
// Deliberately NOT imported, and every file still on disk as inventory: banner2.png
// (10-08) and banner3.png (09-27) are previous brands' article art, and slide3.png /
// slide4.png (09-29) are an older brand's posters. An eager import IS an emit, rendered
// or not, so importing any of them would ship a competitor's picture into dist/ and turn
// verify-build red. There is therefore NO current-drop article illustration this round,
// and a slide is never substituted for one — the playbook pins slide* to
// ContentBoxSevenThree* blocks only, and these two are the round's full 2-block budget.
// banner1 and its mobile crop belong to MainLayout's own pinned globs and are never
// referenced from a page; og.png is the same, MainLayout owns it.
// Both slides are 600px wide on disk (600x352 and 600x351), so 600 is the top real
// candidate — anything above it would not be a real pixel — and each picture carries
// max-w-[600px] so the art is never upscaled past its own bitmap. The two `sizes` lists
// are NOT interchangeable: each is the 3fr-column arithmetic from inside the variant
// that actually holds that picture, and the two variants cap and pad differently.
//   §4 ContentBoxSevenThreePremium — max-w-7xl section, px-4, border 1x2, md:p-10,
//      gap-10, image column md:border-l + md:pl-10 = 41:
//        >= 1280px : (1280 - 32 - 2 - 80 - 40) x 0.3 - 41 = 297px
//        md..1279  : calc(30vw - 87px)
//        698..767  : 600px (bitmap cap)
//        < 698     : calc(100vw - 98px)
//   §5 ContentBoxSevenThree — max-w-[1400px] section, px-4, border 1x2, md:p-10, gap-8,
//      image column md:pl-6 = 24 (the md:border-r + md:pr-6 are on the TEXT column):
//        >= 1400px : (1400 - 32 - 2 - 80 - 32) x 0.3 - 24 = 352px
//        md..1399  : calc(30vw - 68px)
//        698..767  : 600px (bitmap cap)
//        < 698     : calc(100vw - 98px)
// Neither picture is the LCP element — MainLayout's hero banner is — so both are
// loading="lazy" fetchpriority="low" decoding="async" and neither ever takes
// fetchpriority="high". formats/fallbackFormat stay at the house values, and quality is
// still ONE number for both formats — tools/avif-quality-service.mjs rescales the AVIF
// side on its own (x0.65), so it must never be hand-tuned per format.
//
// quality={64}, not the usual 80, and it is measured rather than preferred: both slides
// are dark artwork with heavy fine grain (falling coins, satin, sakura petals), which is
// the case AVIF handles worst. At 80 the AVIF came out LARGER than its own WebP fallback
// at every width of both slides (+2%..+10%), so every AVIF-capable browser would have
// taken the heavier file; verify-build.mjs fails the build on exactly that. 64 is the
// highest value that wins at every emitted width for both images (-2%..-14%). The fix is
// a LOWER quality, never a higher one. Same number on /promotion for the same slides.
// Also deliberately unused, and named without the file extension on purpose because the
// playbook's "is this component live?" check is a bare-filename grep: ProviderGrid is
// banned by brand-spec §5 because its หวย/บาคาร่า/ไพ่ categories appear nowhere in this
// slot-only brief; GameRankingBoard has no ranking to carry; SmoothCarousel has no brief
// section asking for a carousel; BankStrip already renders inside the active footer; and
// FeatureHighlights is banned too, because its items render as <h3> and would add
// headings the brief does not have.
//
// VOCABULARY — brand-spec §6, the brief's own words only. This is a PURE SLOT brand
// whose subject is LICENSED SLOT GAMES IMPORTED DIRECT FROM SINGAPORE across THREE
// studios. Everything the copy says traces to src/assets/content.txt: ฐานหลัก,
// เว็บสล็อตลิขสิทธิ์แท้, นำเข้าตรงจากสิงคโปร์, ค่ายเกมมาตรฐานสากล, PG SOFT, JOKER,
// JILI, 3 ค่ายหลัก, เกมสล็อตออนไลน์, สมัครสมาชิก, ลงทะเบียน, เข้าใช้งาน, เข้าสู่ระบบ,
// โปรโมชั่น, คืนยอดเสีย 0.3%, แนะนำเพื่อน 0.8%, เครดิต, ยอดเดิมพัน, รอบการคำนวณ,
// รหัสแนะนำ, ตารางการจ่ายรางวัล, ฟีเจอร์, กติกา, LINE Official, QR Code, บัญชีแอบอ้าง,
// รหัสผ่าน, รหัส OTP, ฝากถอน, เจ้าหน้าที่, หลักฐาน, ผู้ให้บริการ, สถานะลิขสิทธิ์,
// ข้อกำหนดบริการ, อายุผู้ใช้งาน.
// ⚠️ ขวัญใจ168's own phrases ศูนย์บริการหลัก, ศูนย์รวมช่องทางบริการ, ช่องทางรับบริการ
// and ลิขสิทธิ์เว็บแท้100% are GONE — this brief says ฐานหลัก and เว็บสล็อตลิขสิทธิ์แท้
// instead, and the page was written FROM the brief rather than find-and-replaced over
// last round's sentences. There is no คาสิโน, บาคาร่า, รูเล็ต, ไฮโล, ยิงปลา,
// บอล/แทงบอล/กีฬา, อัตราต่อรอง, หวย/แนวทาง/ตรวจหวย, เว็บตรง, ไม่ผ่านเอเย่นต์, แตกง่าย,
// จ่ายจริง, การันตี, ไม่มีขั้นต่ำ, ฝากถอนทุกธนาคาร, บัญชีม้า or ออโต้ 1 วินาที anywhere
// here. Nothing claims a licence number, a regulator, a legal-entity name, a bank, an
// RTP figure, a deposit minimum, a member count, a founding year or any game studio
// beyond the brief's own PG SOFT / JOKER / JILI. The only figures on the page are the
// brief's own: 0.3%, 0.8%, 100%, 3 ขั้นตอน and 3 ค่าย.
// The brief hedges repeatedly (ควรตรวจสอบจากหลักฐานของผู้ให้บริการโดยตรง,
// ไม่ได้รับประกันผลตอบแทน, ควรตรวจสอบกับผู้ให้บริการโดยตรง) and every one of those
// clauses ships in full — they are brief content, not downbeat filler to be trimmed.
//
// The brief, the artwork and the operator's prompt all agree on the brand name. Even so
// the name is never typed on the page: it is interpolated from ${BRAND_NAME} so it can
// never drift from brandProfile, including inside the two alts. No domain is written out
// anywhere here and no URL is built with `+`.
//
// Title and description are the brief's own Title / Description lines (content.txt
// lines 1-2) verbatim, with the brand name interpolated. The description is NOT padded
// up to 150 characters — verify-build deliberately skips its 150-character floor on the
// home page for exactly this reason. (The brief spells สิงค์โปร์ in those two meta lines
// and สิงคโปร์ in its H1; each is reproduced from its own source line rather than
// normalised to the other.)
const pageTitle = `${BRAND_NAME} ฐานหลักเว็บสล็อตลิขสิทธิ์แท้ นำเข้าตรงจากสิงค์โปร์`;

const pageDescription = `${BRAND_NAME} ฐานหลักเว็บสล็อตลิขสิทธิ์แท้ รวมค่ายเกมมาตรฐานสากล PGSOFT JOKER JILI 3ค่ายหลัก นำเข้าตรงจากสิงค์โปร์ พร้อมโปรโมชั่นจัดเต็ม`;

// The brief has a real H2 -> H3 nesting this round, so the page is NOT flattened to
// H2-only. The two H3s are the docx's own H3 lines — the two promotion sub-points that
// sit under section 3's โปรโมชั่น H2 in the brief's own outline. There is no
// FeatureHighlights H3 exception this round, and no component rendered here emits a
// hardcoded heading, so the printed h3 count stays at exactly 2.
//
// The checklist, in document order, and what carries each one:
//    1 H1  ${BRAND_NAME} ฐานหลักเว็บสล็อตลิขสิทธิ์แท้ นำเข้าตรงจากสิงคโปร์
//          ContentBoxFloatingBadge, brief paragraph on line 4
//    2 H2  ${BRAND_NAME} รวมค่ายเกมมาตรฐานสากล PG SOFT JOKER JILI 3 ค่ายหลัก
//          นำเข้าตรง 100% — ContentBoxTwoCyberCut, line 6 run one half per column
//    3 H2  โปรโมชั่นเข้าเล่น ${BRAND_NAME} เว็บเกมสล็อตแท้ 100%
//          ContentBox (the plain, always-live variant), line 8
//    4 H3  โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสทุกวัน
//          ContentBoxSevenThreePremium + slide1, line 10 left / picture right
//    5 H3  โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด
//          ContentBoxSevenThree + slide2, line 12 left / picture right
//    6 H2  สมัครรับบริการเล่นสล็อต ${BRAND_NAME} ง่ายๆ 3 ขั้นตอน
//          ContentBox3ThreeCyberCut heading={false}, line 14 intro + steps 15-20
//    7 H2  ช่องทางติดต่อแอดมิน ${BRAND_NAME} ทาง LINE OFFICIAL 24ชม.
//          ContentBoxNeumorphism, line 22
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ ${BRAND_NAME}
//          Faq4 + faqs prop, lines 24-29
// Final inventory for this page: h1 x1, h2 x5, h3 x2.
//
// Both ContentBoxSevenThree* variants lay out md:grid-cols-[7fr_3fr] with the TEXT
// column FIRST and fall `title` back to that left column, so each picture goes in
// slot="right": the heading always lands on the prose, never on the picture, and on a
// phone the single column reads heading, text, picture rather than opening with an
// image. Neither is passed a `titleright`, so neither image column carries a heading and
// each block emits exactly one.
// ContentBoxTwoCyberCut is passed no titleleft/titleright — the brief gives §2 one
// running paragraph with no sub-labels, and inventing a pair here would be this page's
// own wording rather than the docx's. The paragraph runs one half per column, which
// keeps every clause and still gives the component both of its slots.
// ContentBox3ThreeCyberCut is passed heading={false} on purpose: the brief writes its
// three steps as a SHORT LABEL LINE plus its own sentence, but marks none of the three
// as a heading, so the three column labels render as <p> and only the section's own
// as="h2" is a heading. Flipping that to true would put three h3s on the page that the
// brief does not have. Each label is the brief's line 15/17/19 verbatim and each column
// body is the matching line 16/18/20, so a column read end to end says exactly what
// content.txt says.
//
// Every brief paragraph ships in full — nothing merged, nothing summarised. §2 runs one
// paragraph half per slot and §6 one step per slot, and NO slot receives more than one
// element, so the house rule's "one element per slot" holds everywhere without a wrapper
// <div> being needed.
//
// Everything else on the page is chrome and emits no heading tag at any level:
// Announcement3, LatestWinners3, LoginRtpSection and ReviewCardSumo render their titles
// as <p>/<span> with an aria-label on the section, and Faq4's questions live inside
// <summary> as <span> (all four were grepped for <h[1-6] this round and none has one).
// The non-brief widgets sit before section 1 (the ticker, then the member feed) and
// after section 8 (LoginRtpSection, ReviewCardSumo, Navfoot) — never spliced between two
// content sections.

// One array, used by both <Faq> and the FAQPage node — never the component's own
// defaults (Faq4 deliberately ships an empty list, so a forgotten prop renders an empty
// accordion rather than some previous brand's questions). The three pairs are the
// brief's own Q/A block (content.txt lines 24-29), verbatim; only the "1." / "2." / "3."
// list markers are dropped, since the accordion is the list.
const faqs = [
  {
    q: `${BRAND_NAME} มีเกมสล็อตจากค่ายไหนให้เลือกบ้าง?`,
    a: `ตามข้อมูลที่ระบุ ${BRAND_NAME} นำเสนอเกมสล็อตจาก 3 ค่ายหลัก ได้แก่ PG SOFT, JOKER และ JILI โดยสามารถตรวจสอบรายชื่อเกมที่เปิดให้บริการจริงได้จากหน้าเว็บไซต์`,
  },
  {
    q: `โปรโมชั่นคืนยอดเสีย 0.3% ของ${BRAND_NAME} ต้องกดรับเองหรือไม่?`,
    a: `ควรตรวจสอบรายละเอียดโปรโมชั่นล่าสุดก่อนรับสิทธิ์ เพราะวิธีรับเครดิตอาจเป็นแบบอัตโนมัติหรือกำหนดให้สมาชิกกดรับเอง รวมถึงอาจมีเงื่อนไขเกี่ยวกับยอดเดิมพันและช่วงเวลาคำนวณ`,
  },
  {
    q: `หากสมัครสมาชิกหรือเข้าสู่ระบบไม่ได้ ต้องติดต่อที่ไหน?`,
    a: `สามารถตรวจสอบช่องทาง LINE Official ที่ระบุบนเว็บไซต์ทางการของ${BRAND_NAME} เพื่อแจ้งปัญหาและขอคำแนะนำจากเจ้าหน้าที่ โดยไม่ต้องเปิดเผยรหัสผ่านหรือรหัส OTP`,
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own sentence.
// Thai has no inter-word space, so a highlight that starts or ends mid-word lets the
// formatter break the line inside the tag and render a space that splits the word — the
// copy must read identically with the tags removed. No two <strong> elements are
// adjacent either: every pair is separated by at least one run of plain text, so the
// whitespace between them can never collapse into a missing space.
// One highlight colour only: #ffeaa0 (brand-spec §2 reserves it for exactly this job),
// against the inherited body colour #f6e4ee (BRAND_TEXT). The paragraphs below carry no
// colour class of their own: every ContentBox* card in this mix already sets
// `text-left text-base leading-relaxed text-[#f6e4ee]` on the element holding the slot,
// so the prose inherits it and no page-level override can drift from the card. No
// paragraph carries mx-auto or max-w-* either — the cards cap their own width, and the
// only max-w-* on the page are the two capping the slides, which are images and not
// prose. No slot's copy names a colour.

// No breadcrumb: this is the homepage, so a trail from the root to itself would be a
// single self-referential crumb. Every URL in the graph is derived by pageGraph from
// `site:` — no domain is typed out in this file, no URL is built with `+`, and no
// Review / AggregateRating / sameAs / address / email node is passed. `description` is
// the exact same string MainLayout gets, and `faqs` is the exact same array <Faq> gets.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <LatestWinners />

  <ContentBoxFloatingBadge as="h1" title={`${BRAND_NAME} ฐานหลักเว็บสล็อตลิขสิทธิ์แท้ นำเข้าตรงจากสิงคโปร์`}>
    <p>
      {BRAND_NAME} นำเสนอเกมสล็อตออนไลน์จากค่ายเกมที่เป็นที่รู้จักอย่าง
      <strong class="text-[#ffeaa0]">PG SOFT, JOKER และ JILI</strong>
      พร้อมรวบรวมข้อมูลเกี่ยวกับการสมัครสมาชิก การเข้าใช้งาน และโปรโมชั่นไว้ในเว็บไซต์เดียว ผู้เล่นสามารถศึกษารายละเอียดของแต่ละค่ายก่อนเลือกเกมที่สนใจ
      <strong class="text-[#ffeaa0]">รวมถึงติดต่อเจ้าหน้าที่เพื่อสอบถามบริการเพิ่มเติมได้</strong>
