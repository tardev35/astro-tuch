---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import LatestWinners from "../components/LatestWinnersPremium.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBox3ThreePremium from "../components/ContentBox3ThreePremium.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import Faq from "../components/Faq2.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import { pageGraph } from "../lib/schema";
import imgCashback from "../assets/slide2.png";
import imgReferral from "../assets/slide1.png";

// VARIANT ROTATION THIS ROUND, decided in .claude/brand-spec-kwanjai168.md §3 and
// NOT re-picked here: Announcement5 replaces AnnouncementPremium, LatestWinnersPremium
// replaces LatestWinners4, Faq2 replaces Faq3, ReviewCardSumo2 replaces ReviewCardSumo,
// and the ContentBox shape-mix leaves FloatingBadge / TwoCyberCut / SevenThreePremium /
// CyberCut / 3ThreeNeumorphism / TwoPremium behind for Premium / TwoNeumorphism /
// SevenThreeCyberCut / SevenThreeNeumorphism / 3ThreePremium / Special. NavbarStyle10 +
// FooterPremiumSumo are the layout's pair this round and the brand font moves
// google-sans -> kanit; all of that is the orchestrator's shared-chrome step, not this
// page's.
// Plain ContentBox is the one sanctioned carry-over (brand-spec §3): it is the
// always-live box that terms, privacy, 404, /promotion and the button pages render
// through, so it cannot follow a rotation. Section 3 is the single docx section it
// carries here.
// ContentBoxTwo is live too but is NOT imported here — it is reached only through
// LoginRtpSection, so an "is it used?" grep has to match the bare filename.
// Every unused *Premium / *Cyber / *Huay / *FloatingBadge / *Style sibling, the other
// Faq* and Announcement* files, the other LatestWinners* and ReviewCardSumo all stay on
// disk as inventory for the next brand — nothing was deleted, and the earlier brands'
// hues still inside them are expected drift.
//
// <Announcement /> runs bare on purpose: Announcement5's default message is already
// this brand's copy, set by the orchestrator from this brief, and every sub-page calls
// it bare too — so passing an override here is exactly how the ticker ends up saying
// two different things on two pages of the same site.
//
// PALETTE — GOLD LEADS, ROSE-GOLD IS THE REAL SECOND HUE, VERMILION IS A DEEP ACCENT
// THAT NEVER LEADS, ON PURE BLACK (brand-spec §2). Read off the artwork: the logo is
// the word ขวัญใจ in thick 3-D Thai lettering with a polished GOLD face and dark-red
// edges, followed by 168 in 3-D gold numerals, all sitting on a curved gold ribbon; a
// young woman stands behind it, black hair in a high bun dressed with dangling gold
// hairpins and white flowers, hands making a small heart, in a red Thai gown embroidered
// with gold, ringed by square-holed Chinese gold coins and two red hearts. The banner is
// the same black scene with two women flanking the logo, white lilies, gold-embroidered
// red and cream gowns and a shower of gold coins.
// ⚠️ ROSE-GOLD #f2bba5 is the measured number-one vivid in palette.json for BOTH the
// logo and the banner, and it is the thing that separates this round from the two before
// it: รับตัง168 was gold-lead with VIVID RED as the partner, and สมหวัง168 before that
// was RED-lead with gold trim. Bringing red back to the front would repeat สมหวัง168;
// making red the partner would repeat รับตัง168. So rose-gold has to be VISIBLE on the
// page — it carries §4's whole heading, §2's and §6's column labels, gradient stops in
// §5/§7, and the §5 picture frame — not just be written down in a spec.
// ⚠️ The page background is PURE BLACK #000000 (bg.json), not last round's red-black.
// Depth ramp: #241509 raised / #160d06 mid / #0b0603 sunken / #000000 page.
// ⚠️ Compare by VALUE, never by colour family — GOLD is this round's trap because gold
// is the LEAD hue and nearly every brand that ever passed through this repo also had a
// gold. This round's gold is #f7c92b (R=247 G=201 B=43) and nothing else: not f0b429
// (รับตัง168), e3b23c (สมหวัง168), dfa310 (TND168), e2b33f (KMD88), e5a81b (UFA324),
// fad354 (789BETTING), f5c518 (FLASH877), fce343 (PUNPRO168), f3bb34 (DUCK1688) or
// fbe455 (WEPLAY168). This round's red is #b3121b — not d30304 (รับตัง168), fa0513
// (สมหวัง168), fb131b (TKB55), fb141b (GT66B), d4200d (PIGPG), e8232a (SUPERSLOTCLUB)
// or ff3b14 (FLASH877).
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// Body copy is #eadfce (= BRAND_TEXT), 13.5:1 on the raised surface and 15.8:1 on the
// page. The ONE highlight colour a <strong> may take is #ffe6a3 (14.5:1). #f7c92b
// (7.3:1), #f2bba5 (10.4:1) and #c98a74 (7.2:1) carry headings, links and secondary
// labels. #b3121b, #5a0a0e and #8a5f12 never carry text at any size: borders, plates,
// rules, gradient ends and auras only. #140c06 is the only ink allowed on a solid gold
// or solid rose fill. Glow rgba is rgba(247,201,43,α), rgba(255,230,163,α),
// rgba(242,187,165,α) or rgba(179,18,27,α).
// ⚠️ No blue, cyan, purple, magenta, green, orange or silver/chrome this round. #cfd9e6
// is รับตัง168's silver — if it is anywhere, it is stale, and this logo has no chrome
// in it at all.
//
// IMAGE ROLES FOR THIS DROP (2026-10-18, brand-spec §4). Exactly TWO files are
// referenced from this page, both from this drop, and the NUMBER PRINTED ON THE ART is
// what decides the pairing:
//   slide2.png -> §4, because its own plaque reads คืนยอดเสีย with 0.3% under it
//   slide1.png -> §5, because its own plaque reads แนะนำเพื่อน with 0.8% under it
// Swapping them would make each picture contradict the heading above it. Both alts
// below were written from THIS drop's bitmaps, opened and read with the Read tool; they
// are not copied from any spec table and neither is a counter.
// Deliberately NOT imported, and every file still on disk as inventory: banner2.png
// (10-08) and banner3.png (09-27) are previous brands' article art, and slide3.png /
// slide4.png (09-29) are an older brand's posters. An eager import IS an emit, rendered
// or not, so importing any of them would ship a competitor's picture into dist/ and turn
// verify-build red. There is therefore NO current-drop article illustration this round,
// and a slide is never substituted for one — the playbook pins slide* to
// ContentBoxSevenThree* blocks only, and these two are the round's full 2-block budget.
// banner1 and its mobile crop belong to MainLayout's own pinned globs and are never
// referenced from a page; og.png is the same, MainLayout owns it.
// Both slides are 600x600 on disk, so 600 is the top real candidate — anything above it
// would not be a real pixel — and each picture carries max-w-[600px] so the art is never
// upscaled past its own bitmap. The two `sizes` lists are NOT interchangeable: each is
// the 3fr-column arithmetic from inside the variant that actually holds that picture,
// and the two variants pay different padding.
//   §4 ContentBoxSevenThreeCyberCut — max-w-7xl section, px-4, border 2, p-8, gap-8,
//      image column md:border-l + md:pl-8 = 33:
//        >= 1280px : (1280 - 32 - 2 - 64 - 32) x 0.3 - 33 = 312px
//        md..1279  : calc(30vw - 72px)
//        698..767  : 600px (bitmap cap)
//        < 698     : calc(100vw - 98px)
//   §5 ContentBoxSevenThreeNeumorphism — same section, border 2, md:p-10, gap-10, image
//      column md:border-l + md:pl-10 = 41:
//        >= 1280px : (1280 - 32 - 2 - 80 - 40) x 0.3 - 41 = 297px
//        md..1279  : calc(30vw - 87px)
//        698..767  : 600px (bitmap cap)
//        < 698     : calc(100vw - 98px)
// Neither picture is the LCP element — MainLayout's hero banner is — so both are
// loading="lazy" fetchpriority="low" decoding="async" and neither ever takes
// fetchpriority="high". formats/fallbackFormat/quality stay at the house values:
// tools/avif-quality-service.mjs rescales AVIF quality on its own, so quality={80} must
// not be hand-tuned per format.
// Also deliberately unused, and named without the file extension on purpose because the
// playbook's "is this component live?" check is a bare-filename grep: ProviderGrid and
// GameRankingBoard have nothing to carry because the brief names no game studio and no
// ranking; SmoothCarousel has no brief section asking for a carousel; BankStrip already
// renders inside the active footer; and FeatureHighlights is explicitly banned this
// round by brand-spec §5, because its items render as <h3> and would add headings the
// brief does not have.
//
// VOCABULARY — brand-spec §6, the brief's own words only. This is a PURE SLOT brand
// whose subject is the OPERATOR'S SERVICE CENTRE, not a casino, not a sportsbook and
// not a lottery site. Everything the copy says traces to src/assets/content.txt:
// ศูนย์บริการหลัก, ศูนย์รวมช่องทางบริการ, เกมสล็อตออนไลน์, ลิขสิทธิ์เว็บแท้100%,
// สมัครสมาชิก, ลงทะเบียนสมาชิก, เข้าเล่น, เข้าสู่ระบบ, ฝากถอน, รายการฝากถอน,
// ติดต่อเจ้าหน้าที่, ช่องทางติดต่อ, โปรโมชั่น, รับโปร, 24 ชั่วโมง, คืนยอดเสีย 0.3%,
// แนะนำเพื่อน 0.8%, เครดิต, รอบเวลาคำนวณยอด, ประเภทเกมที่ร่วมรายการ,
// เงื่อนไขการใช้โบนัส, รหัสแนะนำ, การเชื่อมโยงบัญชี, รอบจ่ายโบนัส, LINE Official,
// QR Code, บัญชีปลอม, ผู้แอบอ้าง, หลักฐานรายการ, รหัสผ่าน, รหัส OTP,
// ข้อมูลผู้ให้บริการ, หลักฐานทางการ, คุณสมบัติผู้สมัคร, ข้อกำหนดในการเปิดบัญชี,
// ระยะเวลาตอบกลับ.
// ⚠️ รับตัง168's own phrases ฐานหลัก and ช่องทางรับบริการ are GONE — this brief says
// ศูนย์บริการหลัก and ศูนย์รวมช่องทางบริการ instead, and the page was written FROM the
// brief rather than find-and-replaced over last round's sentences. There is no คาสิโน,
// บาคาร่า, รูเล็ต, ไฮโล, ยิงปลา, บอล/แทงบอล/กีฬา, อัตราต่อรอง, หวย/แนวทาง/ตรวจหวย,
// เว็บตรง, ไม่ผ่านเอเย่นต์, แตกง่าย, จ่ายจริง, การันตีเว็บแท้, ไม่มีขั้นต่ำ,
// ฝากถอนทุกธนาคาร, บัญชีม้า, เซิร์ฟเวอร์ต่างประเทศ or ค่ายระดับเอเชีย anywhere here.
// Nothing claims a licence number, a regulator, a legal-entity name, a game studio, a
// bank, an RTP figure, a deposit minimum, a member count or a founding year, because
// the brief names none. The only figures on the page are the brief's own: 0.3%, 0.8%,
// 24 ชั่วโมง, 100% and 3 ขั้นตอน — all inside the brief's own phrases, not added counts.
// The brief hedges repeatedly (ควรตรวจสอบข้อมูลผู้ให้บริการ…, ไม่ใช่การรับประกัน…,
// ทั้งนี้ ระยะเวลาตอบกลับขึ้นอยู่กับ…) and every one of those clauses ships in full —
// they are brief content, not downbeat filler to be trimmed.
//
// The brief, the artwork and the operator's prompt all agree on the brand name. Even so
// the name is never typed on the page: it is interpolated from ${BRAND_NAME} so it can
// never drift from brandProfile, including inside the two alts. No domain is written out
// anywhere here and no URL is built with `+`.
//
// Title and description are the brief's own Title/Meta Description lines (content.txt
// lines 3-4) verbatim, with the brand name interpolated. They are NOT padded up to 150
// characters — verify-build deliberately skips its 150-character floor on the home page
// for exactly this reason.
const pageTitle = `${BRAND_NAME} ศูนย์บริการหลัก เข้าเล่น ฝากถอน ติดต่อ รับโปร ครบในเว็บเดียว`;

const pageDescription = `${BRAND_NAME} ศูนย์บริการหลัก ทางเข้าเล่นเกมสล็อตออนไลน์ ลิขสิทธิ์เว็บแท้100% ผู้เล่นสามารถสมัคร เข้าเล่น ฝากถอน ติดต่อ รับโปรโมชั่น จบครบในเว็บเดียว`;

// The brief has a real H2 -> H3 nesting this round, so the page is NOT flattened to
// H2-only. The two H3s are the docx's own H3 lines — the two promotion sub-points that
// sit under section 3's โปรโมชั่น H2 in the brief's own outline. There is no
// FeatureHighlights H3 exception this round, and no component rendered here emits a
// hardcoded heading, so the printed h3 count stays at exactly 2.
//
// The checklist, in document order, and what carries each one:
//    1 H1  ${BRAND_NAME} ศูนย์บริการหลักเกมสล็อตออนไลน์ ลิขสิทธิ์เว็บแท้100%
//          ContentBoxPremium, brief paragraph on line 6
//    2 H2  ผู้เล่นสามารถ สมัคร เข้าเล่น ${BRAND_NAME} ฝากถอน ติดต่อ รับโปร ในเว็บเดียว
//          ContentBoxTwoNeumorphism, line 8 run one half per column
//    3 H2  โปรโมชั่นเข้าเล่น ${BRAND_NAME} จากผู้ให้บริการเว็บเกมสล็อตแท้100%
//          ContentBox (the plain, always-live variant), line 10
//    4 H3  โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสทุกวัน
//          ContentBoxSevenThreeCyberCut + slide2, line 12 left / picture right
//    5 H3  โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด
//          ContentBoxSevenThreeNeumorphism + slide1, line 14 left / picture right
//    6 H2  สมัครรับบริการเล่นสล็อต ${BRAND_NAME} ง่ายๆ 3 ขั้นตอน
//          ContentBox3ThreePremium heading={false}, line 16 intro + steps 17-22
//    7 H2  ช่องทางติดต่อแอดมิน ${BRAND_NAME} ทาง LINE OFFICIAL 24ชม.
//          ContentBoxSpecial, line 24 run one half per side
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ ${BRAND_NAME}
//          Faq2 + faqs prop, lines 26-31
// Final inventory for this page: h1 x1, h2 x5, h3 x2.
//
// Both ContentBoxSevenThree* variants lay out md:grid-cols-[7fr_3fr] with the TEXT
// column FIRST and fall `title` back to that left column, so each picture goes in
// slot="right": the heading always lands on the prose, never on the picture, and on a
// phone the single column reads heading, text, picture rather than opening with an
// image. Neither is passed a `titleright`, so neither image column carries a heading and
// each block emits exactly one.
// ContentBoxTwoNeumorphism is passed no titleleft/titleright — the brief gives §2 one
// running paragraph with no sub-labels, and inventing a pair here would be this page's
// own wording rather than the docx's. The paragraph runs one half per column, which
// keeps every clause and still gives the component both of its slots. ContentBoxSpecial
// is the same shape for §7 and takes no `actions` slot, because the brief asks for no
// button pair there.
// ContentBox3ThreePremium is passed heading={false} on purpose: the brief writes its
// three steps as a SHORT LABEL LINE plus its own sentence, but marks none of the three
// as a heading, so the three column labels render as <p> and only the section's own
// as="h2" is a heading. Flipping that to true would put three h3s on the page that the
// brief does not have. Each label is the brief's line 17/19/21 verbatim and each column
// body is the matching line 18/20/22, so a column read end to end says exactly what
// content.txt says.
//
// Every brief paragraph ships in full — nothing merged, nothing summarised. §2, §6 and
// §7 run one paragraph half (or one step) per slot, and NO slot receives more than one
// element, so the house rule's "one element per slot" holds everywhere without a wrapper
// <div> being needed.
//
// Everything else on the page is chrome and emits no heading tag at any level:
// Announcement5, LatestWinnersPremium, LoginRtpSection and ReviewCardSumo2 render their
// titles as <p>/<span> with an aria-label on the section, and Faq2's questions live
// inside <summary> as <span>. The non-brief widgets sit before section 1 (the ticker,
// then the member feed) and after section 8 (LoginRtpSection, ReviewCardSumo2, Navfoot)
// — never spliced between two content sections.

// One array, used by both <Faq> and the FAQPage node — never the component's own
// defaults (Faq2 deliberately ships an empty list, so a forgotten prop renders an empty
// accordion rather than some previous brand's questions). The three pairs are the
// brief's own Q/A block (content.txt lines 26-31), verbatim; only the "1." / "2." / "3."
// list markers are dropped, since the accordion is the list.
const faqs = [
  {
    q: `${BRAND_NAME} สามารถสมัครสมาชิกและเข้าเล่นผ่านเว็บไซต์เดียวได้หรือไม่?`,
    a: `ตามรูปแบบบริการที่ระบุ ผู้ใช้งานสามารถเข้าถึงเมนูสมัครสมาชิกและเข้าสู่ระบบจากเว็บไซต์หลักได้ โดยควรตรวจสอบลิงก์ทางการก่อนกรอกข้อมูลหรือดำเนินการใด ๆ`,
  },
  {
    q: `โปรโมชั่นคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% รับได้อย่างไร?`,
    a: `สมาชิกควรตรวจสอบเงื่อนไขและวิธีรับสิทธิ์ของแต่ละโปรโมชั่นจากหน้าประกาศหรือเจ้าหน้าที่ เนื่องจากรอบคำนวณยอด วิธีรับโบนัส และข้อกำหนดการใช้เครดิตอาจแตกต่างกัน`,
  },
  {
    q: `หากฝากถอนมีปัญหา สามารถติดต่อแอดมินผ่าน LINE Official ได้หรือไม่?`,
    a: `สามารถใช้ช่องทาง LINE Official ที่เว็บไซต์ระบุเพื่อสอบถามและแจ้งปัญหาได้ โดยควรเตรียมข้อมูลรายการที่เกี่ยวข้องให้พร้อม และไม่ส่งรหัสผ่านหรือรหัส OTP ให้เจ้าหน้าที่หรือบุคคลอื่น`,
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own sentence.
// Thai has no inter-word space, so a highlight that starts or ends mid-word lets the
// formatter break the line inside the tag and render a space that splits the word — the
// copy must read identically with the tags removed. No two <strong> elements are
// adjacent either: every pair is separated by at least one run of plain text, so the
// whitespace between them can never collapse into a missing space.
// One highlight colour only: #ffe6a3 (brand-spec §2 reserves it for exactly this job),
// against the inherited body colour #eadfce (BRAND_TEXT). The paragraphs below carry no
// colour class of their own: every ContentBox* card in this mix already sets
// `text-left text-base leading-relaxed text-[#eadfce]` on the element holding the slot,
// so the prose inherits it and no page-level override can drift from the card. No
// paragraph carries mx-auto or max-w-* either — the cards cap their own width, and the
// only max-w-* on the page are the two capping the slides, which are images and not
// prose. No slot's copy names a colour.

// No breadcrumb: this is the homepage, so a trail from the root to itself would be a
// single self-referential crumb. Every URL in the graph is derived by pageGraph from
// `site:` — no domain is typed out in this file, no URL is built with `+`, and no
// Review / AggregateRating / sameAs / address / email node is passed. `description` is
// the exact same string MainLayout gets, and `faqs` is the exact same array <Faq> gets.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <LatestWinners />

  <ContentBoxPremium as="h1" title={`${BRAND_NAME} ศูนย์บริการหลักเกมสล็อตออนไลน์ ลิขสิทธิ์เว็บแท้100%`}>
    <p>
      {BRAND_NAME} ศูนย์รวมช่องทางบริการเกมสล็อตออนไลน์ที่จัดเตรียมเมนูสำหรับสมัครสมาชิก
      <strong class="text-[#ffe6a3]">เข้าเล่น ฝากถอน และติดต่อเจ้าหน้าที่ไว้ในเว็บไซต์เดียว</strong>
      ช่วยให้ผู้ใช้งานค้นหาข้อมูลที่ต้องการได้สะดวก ไม่ว่าจะเป็นขั้นตอนเริ่มต้นใช้งาน รายละเอียดโปรโมชั่น หรือการสอบถามปัญหาต่าง ๆ
      <strong class="text-[#ffe6a3]">พร้อมช่องทางติดต่อทีมงานตลอด 24 ชั่วโมง</strong>
      ทั้งนี้ ควรตรวจสอบข้อมูลผู้ให้บริการและสถานะลิขสิทธิ์จากหลักฐานทางการก่อนใช้งาน
    </p>
  </ContentBoxPremium>

