---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import LatestWinners from "../components/LatestWinnersPremium.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBox from "../components/ContentBox.astro";
import Faq from "../components/Faq3.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgCashback from "../assets/slide2.png";
import imgReferral from "../assets/slide1.png";

// VARIANT ROTATION THIS ROUND (หวย365 -> 1SS365). Zero file reuse from the
// previous round: AnnouncementPremium replaces AnnouncementHuay,
// LatestWinnersPremium replaces LatestWinnersHuay, Faq3 replaces FaqHuay,
// ReviewCardSumo replaces ReviewCardSumo2, and the ContentBox shape-mix moves
// off Premium / TwoPremium / FloatingBadge / SevenThreePremium / SevenThreeHuay /
// Special onto Neumorphism / TwoCyberCut / CyberCut / SevenThreeNeumorphism /
// SevenThreeCyberCut / TwoNeumorphism. NavbarStyle4Black and FooterPremiumSumo
// are the layout's pair this round (previously NavbarHuay / FooterHuay).
// Plain ContentBox is the one deliberate carry-over: terms, privacy, 404 and
// every button page render their body through it by rule and cannot follow a
// rotation, so it is always-live and the orchestrator rethemes it in the shared
// step — this page only passes it props.
// Every Premium / FloatingBadge / Special / Huay / Style file, FaqHuay,
// AnnouncementHuay, LatestWinnersHuay, ReviewCardSumo2, NavbarHuay and FooterHuay
// stay on disk as inventory for the next brand — none of them was deleted, and
// the previous brand's copy and colour still inside them is expected drift, not
// a bug.
//
// <Announcement /> runs bare on purpose: AnnouncementPremium's default message is
// already this brand's copy and every sub-page calls it bare too, so passing an
// override here is exactly how the ticker ends up saying two different things on
// two pages of the same site.
//
// IMAGE ROLES FOR THIS DROP (2026-10-03). Two files are referenced from this page
// and only two, and each pairing is read off the artwork itself:
//   slide2.png — the dark gold-edged plaque under the big gold โปรโมชั่น wordmark
//     reads "คืนยอดเสีย โบนัส 0.3%", so it belongs to docx H3 #4. Imported as
//     imgCashback.
//   slide1.png — the same set, and its plaque reads "แนะนำเพื่อน โบนัส 0.8%", so
//     it belongs to docx H3 #5. Imported as imgReferral.
// Both files measure 600x360, so 600 is the top real candidate width — nothing
// above it would be a real pixel — and each picture carries max-w-[600px] so the
// art is never upscaled past its own bitmap. Each slide sits in a
// ContentBoxSevenThree* image+text block, which is that family's hard cap of two
// per rebrand, so there is no third SevenThree anywhere on the site.
// The two blocks mirror each other: SevenThreeNeumorphism lays out
// md:grid-cols-[7fr_3fr] so its picture goes in slot="right", and
// SevenThreeCyberCut lays out md:grid-cols-[3fr_7fr] so its picture goes in
// slot="left" while the paragraph keeps the wide column. The two pictures
// therefore alternate sides instead of stacking down the same edge, and each
// `sizes` describes its own 3fr column rather than the viewport:
//   Neumorphism: max-w-[1400px] cap, px-4, p-8, gap-8, md:pl-8 + border on the
//                image column -> (1400 - 32 - 64 - 32) x 0.3 - 33 = 349px
//   CyberCut:    max-w-7xl/1280px cap, px-4, p-8, gap-8, no inner padding on the
//                image column -> (1280 - 32 - 64 - 32) x 0.3 = 346px
// Below md both cards collapse to one column at p-8, so the drawn width is
// 100vw - 32 (section px-4) - 64 (card p-8) = 100vw - 96px, capped at 600px.
//
// The alt text was written from THIS drop's artwork, re-opened with the Read
// tool before it was typed: a smiling young woman in a white-and-gold outfit with
// gold jewellery against swept white-and-gold satin, gold coins and ribbons
// scattered around her, the 1SS365 wordmark in the top-right corner, a large gold
// Thai word โปรโมชั่น with a crown above it, and the offer plaque underneath.
//
// Deliberately NOT imported, and every file still on disk:
//   banner2.png / banner3.png / slide3.png / slide4.png all predate this drop and
//   belong to previous brands — importing any of them would emit a competitor's
//   artwork into dist/, so there is no inline article illustration this round.
//   banner1.png and banner1-mobile.png belong to MainLayout's own pinned globs
//   and are never referenced from a page — the hero is the LCP element, so
//   nothing here gets loading="eager" fetchpriority="high". og.png is the same:
//   MainLayout owns it.
//
// Vocabulary: 1SS365 is a เว็บสล็อตออนไลน์ เว็บตรงต่างประเทศ ไม่ผ่านเอเย่นต์ —
// สล็อตออนไลน์, เว็บตรง, ค่ายเกม, สล็อตคลาสสิก, ฟรีสปิน, ตัวคูณ, เกมโบนัส, เครดิต,
// โปรโมชั่น, คืนยอดเสีย 0.3%, แนะนำเพื่อน 0.8%, รอบคำนวณ, ยอดที่เข้าเกณฑ์, ฝากถอน,
// ประวัติรายการ, สมัครสมาชิก, Login, แอดมิน 24 ชั่วโมง, PIN, OTP, เดิมพันไม่มีขั้นต่ำ.
// The brand before this one sold lottery; every one of those words (หวย, แทงหวย,
// ส่งโพย, โพย, เลือกเลข, 2 ตัว / 3 ตัว, อัตราจ่าย, งวด, รัฐบาลไทย, ฮานอย, ลาวพัฒนา,
// หวยหุ้น, แนวทางหวย, กลุ่มหวย, สถิติหวย, ผลหวย, ตรวจหวย) is gone, and the page was
// written from the brief rather than find-and-replaced over the old sentences.
// Nothing here claims a licence, an operator, a bank, a deposit minimum, a member
// count, a founding year or an RTP figure, because the brief names none. The only
// figures are the brief's own: 0.3%, 0.8%, 3 ขั้นตอน, 24 ชั่วโมง, 100%. The brief's
// own hedging ships with the copy ("แตกง่ายหรือจ่ายไวเป็นลักษณะเชิงโฆษณา ไม่สามารถใช้
// รับประกันผลการเล่น", "ไม่ควรถือว่าทุกเกมไม่มีขั้นต่ำเหมือนกันทั้งหมด", "การเป็นเว็บ
// ต่างประเทศหรือไม่ผ่านเอเย่นต์เพียงอย่างเดียวไม่ได้รับประกันว่าปลอดภัย 100%") — it is
// part of the paragraphs, not trimmed as downbeat.
//
// Title and description are the brief's own Title/Description lines, used
// verbatim and NOT padded up to 150: verify-build deliberately skips its
// 150-character floor on the home page for exactly this reason.
const pageTitle = "1SS365 สล็อตเว็บตรงต่างประเทศ ไม่ผ่านเอเย่นต์ ปลอดภัย มั่นใจได้100%";

const pageDescription =
  "1SS365 สล็อตเว็บตรงต่างประเทศ แตกง่าย จ่ายไว ไม่ผ่านเอเย่นต์ เดิมพันไม่มีขั้นต่ำ ปลอดภัยทุกการใช้งาน ฝากถอนเข้าไว ไม่ติดสแกม มั่นใจได้100%";

// The brief has a real H2 -> H3 nesting this round, so the page is NOT flattened
// to H2-only. The two H3s are genuine headings — the two promotion sub-points,
// both nested under the โปรโมชั่น H2 — and they stay H3.
//
// The checklist, in document order, and what carries each one:
//    1 H1  1SS365 สล็อตเว็บตรงต่างประเทศ แตกง่าย จ่ายไว ไม่ผ่านเอเย่นต์
//          ContentBoxNeumorphism, brief paragraph on line 4
//    2 H2  1SS365 สล็อตเว็บตรง เดิมพันไม่มีขั้นต่ำ ไม่ติดสแกม มั่นใจได้100%
//          ContentBoxTwoCyberCut, line 6 left / line 7 right
//    3 H2  โปรโมชั่นเล่นสล็อต 1SS365 อัปเดตตลอดทั้งเดือน
//          ContentBoxCyberCut, line 9
//    4 H3  คืนยอดเสีย โบนัส 0.3%
//          ContentBoxSevenThreeNeumorphism + slide2 (imgCashback), line 11
//    5 H3  แนะนำเพื่อน โบนัส 0.8%
//          ContentBoxSevenThreeCyberCut + slide1 (imgReferral), line 13
//    6 H2  สมัครเล่นสล็อต 1SS365 บนมือถือง่ายๆ 3ขั้นตอน
//          ContentBoxTwoNeumorphism, line 15 left / line 16 right
//    7 H2  ติดต่อแอดมิน 1SS365 ผู้ให้บริการเว็บหลักได้ 24 ชั่วโมง
//          ContentBox + LINE / สมัครสมาชิก buttons, lines 18+19
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ 1SS365
//          Faq3 + faqs prop, lines 21-26
// Final inventory for this page: h1 x1, h2 x5, h3 x2.
//
// Every brief paragraph ships in full — all eleven of them, nothing merged or
// summarised. Sections 2 and 6 have two paragraphs each and run one per column;
// section 7 has two and they stack inside one wrapper div so the slot still
// receives exactly one element. The column labels passed to ContentBoxTwoCyberCut
// and ContentBoxTwoNeumorphism are this page's own layout wording, not brief
// headings, and both variants render them as <p>.
//
// Everything else on the page is chrome and emits no heading tag at any level:
// AnnouncementPremium, LatestWinnersPremium, LoginRtpSection and ReviewCardSumo
// render their titles as <p>/<span> with an aria-label on the section, and Faq3's
// questions live inside <summary> as <p>. The non-brief widgets sit before
// section 1 (the ticker, then the winners feed) and after section 8
// (LoginRtpSection, ReviewCardSumo, Navfoot) — never spliced between two content
// sections.

// One array, used by both <Faq> and the FAQPage node — never the component's own
// defaults, which belong to whichever brand shipped last. The three pairs are the
// brief's own Q/A block, verbatim.
const faqs = [
  {
    q: "1SS365 เป็นสล็อตเว็บตรงต่างประเทศและไม่ผ่านเอเย่นต์จริงหรือไม่?",
    a: "ควรตรวจสอบจากข้อมูลผู้ดำเนินงาน เงื่อนไขบริการ และข้อมูลบริษัทที่เว็บไซต์เปิดเผย หาก 1SS365 ระบุว่าเป็นระบบต่างประเทศและไม่ผ่านเอเย่นต์ ควรมีรายละเอียดที่สมาชิกสามารถตรวจสอบได้ ไม่ควรพิจารณาจากข้อความประชาสัมพันธ์เพียงอย่างเดียว",
  },
  {
    q: "1SS365 มีเกมสล็อตไม่มีขั้นต่ำทุกเกมหรือไม่?",
    a: "ไม่จำเป็นต้องเหมือนกันทุกเกม เพราะยอดเดิมพันขั้นต่ำและสูงสุดขึ้นอยู่กับค่ายและเกมที่เลือก บางรายการอาจรองรับการเดิมพันด้วยยอดต่ำ สมาชิกควรเปิดข้อมูลเกมและตรวจสอบช่วงเดิมพันก่อนเริ่มเล่นทุกครั้ง",
  },
  {
    q: "โปรโมชั่น 1SS365 โบนัส 0.3% และ 0.8% ต่างกันอย่างไร?",
    a: "โบนัส 0.3% เป็นโปรโมชั่นคืนยอดเสียจากยอดที่ตรงตามเงื่อนไข ส่วนโบนัส 0.8% เป็นกิจกรรมแนะนำเพื่อนจากยอดที่เข้าเกณฑ์ ทั้งสองโปรโมชั่นอาจมีรอบคำนวณและข้อกำหนดแตกต่างกัน จึงควรตรวจสอบรายละเอียดล่าสุดก่อนกดรับ",
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// One highlight colour only: #ffeeb4, the brand's pale gold, against the
// inherited body colour #f0e6d2 (BRAND_TEXT). The paragraphs below carry no
// colour class of their own: every ContentBox* card in this mix already sets
// `text-left text-base leading-relaxed text-[#f0e6d2]` on the element holding
// the slot, so the prose inherits it and no page-level override can drift from
// the card.

// No breadcrumb: this is the homepage, so a trail from the root to itself would
// be a single self-referential crumb. Every URL in the graph is derived by
// pageGraph from `site:` — no domain is typed out in this file, and no Review /
// AggregateRating / sameAs / address node is passed.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <LatestWinners />

  <ContentBoxNeumorphism as="h1" title="1SS365 สล็อตเว็บตรงต่างประเทศ แตกง่าย จ่ายไว ไม่ผ่านเอเย่นต์">
    <p>
      1SS365
      <strong class="text-[#ffeeb4]">ให้บริการเกมสล็อตออนไลน์จากแพลตฟอร์มต่างประเทศ รวมเกมหลายรูปแบบไว้ให้เลือกผ่านบัญชีเดียว</strong>
      ทั้งสล็อตคลาสสิก ฟรีสปิน ตัวคูณ และเกมโบนัส รองรับการเข้าเล่นผ่านมือถือโดยไม่ต้องสลับหลายเว็บไซต์ สมาชิกสามารถตรวจสอบค่ายเกม เครดิต โปรโมชั่น และประวัติรายการได้จากระบบเดียว
      <strong class="text-[#ffeeb4]">ส่วนคำว่าแตกง่ายหรือจ่ายไวเป็นลักษณะเชิงโฆษณา ไม่สามารถใช้รับประกันผลการเล่นหรือระยะเวลาของธุรกรรมได้ในทุกกรณี</strong>
    </p>
  </ContentBoxNeumorphism>

  <ContentBoxTwoCyberCut
    as="h2"
    title="1SS365 สล็อตเว็บตรง เดิมพันไม่มีขั้นต่ำ ไม่ติดสแกม มั่นใจได้100%"
    titleleft="ช่วงเดิมพันตามค่ายและเกม"
    titleright="ข้อมูลที่ตรวจสอบได้">
    <p slot="left">
      1SS365
      <strong class="text-[#ffeeb4]">เปิดให้สมาชิกเลือกเกมสล็อตตามค่ายและช่วงเดิมพันที่ระบบรองรับ</strong>
      มีทั้งเกมที่เริ่มต้นด้วยยอดต่ำและเกมที่สามารถปรับระดับเดิมพันได้หลายช่วง ก่อนเริ่มเล่นควรตรวจสอบขั้นต่ำและสูงสุดของเกมนั้นโดยตรง เนื่องจากแต่ละค่ายสามารถกำหนดช่วงเดิมพันแตกต่างกัน
      <strong class="text-[#ffeeb4]">จึงไม่ควรถือว่าทุกเกมไม่มีขั้นต่ำเหมือนกันทั้งหมด</strong>
    </p>
    <p slot="right">
      สำหรับคำว่า ไม่ติดสแกม หรือ มั่นใจได้ 100%
      <strong class="text-[#ffeeb4]">ควรมีข้อมูลที่ตรวจสอบได้รองรับ</strong>
      เช่น ผู้ดำเนินงาน ช่องทางติดต่อ ระบบรักษาความปลอดภัย และรายละเอียดธุรกรรม
      <strong class="text-[#ffeeb4]">การเป็นเว็บต่างประเทศหรือไม่ผ่านเอเย่นต์เพียงอย่างเดียวไม่ได้รับประกันว่าเว็บไซต์หรือธุรกรรมจะปลอดภัย 100%</strong>
    </p>
  </ContentBoxTwoCyberCut>

  <ContentBoxCyberCut as="h2" title="โปรโมชั่นเล่นสล็อต 1SS365 อัปเดตตลอดทั้งเดือน">
    <p>
      สมาชิกสามารถ
      <strong class="text-[#ffeeb4]">ตรวจสอบโปรโมชั่น 1SS365 ที่เปิดให้รับในแต่ละช่วงของเดือนผ่านบัญชีของตนเอง</strong>
      มีทั้งโบนัสคืนยอดเสียและกิจกรรมแนะนำเพื่อน แต่ละรายการอาจกำหนดรอบคำนวณ ค่ายเกม ยอดที่เข้าเกณฑ์ และระยะเวลารับโบนัสแตกต่างกัน
      <strong class="text-[#ffeeb4]">ควรอ่านรายละเอียดล่าสุดก่อนเลือกใช้โปรโมชั่น</strong>
      เพื่อให้ทราบว่ายอดส่วนใดถูกนำมาคำนวณและต้องดำเนินการอย่างไรจึงจะได้รับสิทธิ์
    </p>
  </ContentBoxCyberCut>

  <ContentBoxSevenThreeNeumorphism as="h3" title="คืนยอดเสีย โบนัส 0.3%">
    <p slot="left">
      สมาชิกที่มียอดเสียตรงตามข้อกำหนดสามารถ
      <strong class="text-[#ffeeb4]">ตรวจสอบสิทธิ์รับโบนัสคืนยอดเสีย 0.3% ตามรอบที่ 1SS365 กำหนด</strong>
      ระบบจะนำยอดที่เข้าเกณฑ์มาคำนวณก่อนแสดงโบนัสที่สามารถรับได้
      <strong class="text-[#ffeeb4]">ควรตรวจสอบรอบตัดยอด ค่ายเกมที่ร่วมรายการ และเงื่อนไขการใช้โบนัสก่อนกดรับทุกครั้ง</strong>
    </p>
    <Picture
      slot="right"
      src={imgCashback}
      loading="lazy"
      fetchpriority="low"
      widths={[349, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), (max-width: 1399px) calc(30vw - 71px), 349px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="ภาพโปรโมชั่นของ 1SS365 ฉากหลังเป็นผ้าซาตินสีขาวและทองพลิ้ว ด้านซ้ายเป็นหญิงสาวผมยาวประดับดอกไม้สีขาว สวมชุดสีขาวปักทองพร้อมสร้อยและกำไลทอง ยื่นมือซ้ายแบออกมาข้างหน้าและชี้นิ้วมือขวาขึ้น รอบตัวมีเหรียญทอง ลูกเต๋าทอง และกล่องของขวัญกระจายอยู่ มุมบนขวาเป็นโลโก้ 1SS365 ถัดลงมาเป็นตัวอักษรไทยสีทองขนาดใหญ่ว่า โปรโมชั่น มีมงกุฎทองอยู่ด้านบน และป้ายพื้นเข้มขอบทองคาดข้อความ คืนยอดเสีย โบนัส 0.3%"
      class="mx-auto h-auto w-full max-w-[600px] rounded-2xl border border-[#a87708]/60 shadow-[0_10px_30px_rgba(237,187,35,0.28)]"
    />
  </ContentBoxSevenThreeNeumorphism>

  <ContentBoxSevenThreeCyberCut as="h3" title="แนะนำเพื่อน โบนัส 0.8%">
    <Picture
      slot="left"
      src={imgReferral}
      loading="lazy"
      fetchpriority="low"
      widths={[346, 480, 600]}
