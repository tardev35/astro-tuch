---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import LatestWinners from "../components/LatestWinners3.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import ContentBox3ThreePremium from "../components/ContentBox3ThreePremium.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import Faq from "../components/Faq.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import { pageGraph } from "../lib/schema";
import imgCashback from "../assets/slide1.png";
import imgReferral from "../assets/slide2.png";

// VARIANT ROTATION THIS ROUND (PUNPRO168 -> TND168). Every family moves off the
// outgoing pick: AnnouncementPremium replaces Announcement3, LatestWinners3
// replaces LatestWinners2, the base Faq replaces Faq2, ReviewCardSumo2 replaces
// ReviewCardSumo, and the ContentBox shape-mix leaves FloatingBadge /
// TwoPremium / SevenThreePremium / SevenThreeCyberCut / 3Three / Special behind
// for Neumorphism / TwoCyberCut / SevenThree / SevenThreeFloatingBadge /
// 3ThreePremium / Premium. NavbarStyle4Black + FooterPremiumSumo are the
// layout's pair this round (previously NavbarStyle9 / FooterStyle2) and the
// brand font moves kanit -> google-sans; all three are the orchestrator's
// shared-chrome step, not this page's.
// Plain ContentBox is the one sanctioned carry-over: it is the always-live box
// that terms, privacy, 404 and the button pages render through, so it cannot
// follow a rotation. Section 3 is the single docx section it carries here.
// ContentBoxTwo is also still live but is NOT imported here — it is reached only
// through LoginRtpSection, so an "is it used?" grep has to match the bare
// filename, not "components/ContentBoxTwo.astro".
// Every unused *Premium / *Cyber / *Huay / *FloatingBadge / *Style file, the
// other Faq* and Announcement* siblings, the base ReviewCardSumo and the other
// LatestWinners* stay on disk as inventory for the next brand — none was
// deleted, and the previous brands' hot pink, tiger amber, champion gold and
// chrome silver still inside them are expected drift, not a bug.
//
// <Announcement /> runs bare on purpose: AnnouncementPremium's default message is
// already this brand's copy, set by the orchestrator from this brief, and every
// sub-page calls it bare too — so passing an override here is exactly how the
// ticker ends up saying two different things on two pages of the same site.
//
// PALETTE OF THIS BRAND — SINGLE GOLD HUE ON PURE BLACK, NO SECOND COLOUR.
// Read off the artwork: the logo is a round medallion with a polished 3-D gold
// Chinese dragon coiled around it and TND168 in gold serif lettering laid across
// the middle; there is no metal and no second hue anywhere in it. The banner and
// both slides are the same black-and-gold casino scene — a silver-haired couple
// in black suits with gold trim, ribbons of gold light, black gold-rimmed chips,
// gold aces, gold dice, a roulette wheel and stacks of gold coins. The page
// background is PURE BLACK (bg.json = {"mode":"color","color":"#000000"}).
// ⚠️ CONSEQUENCE: nothing on this page can sink BELOW the page background. The
// deepest plate that still reads as a plate is #070502. The depth ramp is
// #1b1307 raised / #120c04 mid / #070502 sunken / #000000 page.
// ⚠️ THE TRAP THIS ROUND IS GOLD ITSELF — gold has shipped in nine of the last
// eleven rounds, so "there is already gold in this file" proves nothing at all.
// Compare by VALUE, never by colour family. This brand's primary is #dfa310
// (R=223 G=163 B=16), which is darker and warmer than the closest previous
// values: UFA324's #e5a81b (R=229 G=168 B=27) and 1SS365's #edbb23. The outgoing
// PUNPRO168 set (#f41571 #ff5ca8 #fce343 #ffd94a #f0c3dc #fde7f2 #8a0a45 #4a0426
// #2a0012 #4a1038 #3a0a2a #2e0022 #1c0014, plus rgba(244,21,113,α) and
// rgba(252,227,67,α)) is gone from every file this page renders, as are
// TIGERWIN369's, UFA324's, FAH999's, DUCK1688's, NAZA168's, FLASH877's and
// 789BETTING's. There is NO pink, NO purple/plum, NO silver/grey/chrome, NO
// green, NO blue, NO burnt orange and NO red anywhere on this page.
// Body copy is #f0e9dc (= BRAND_TEXT), 15.3:1 on the raised surface and 18.3:1
// on the page background. Highlights below are #ffc93d, which the spec pins to
// exactly this one job (10.2:1 on the raised surface) — unlike #dfa310, which is
// the border/accent/heading gold, unlike #ffe4a3, which is the bright end of the
// heading gradients and the hover colour, and unlike #c9b88e, which is muted
// secondary text. #8a5c09 and #43240b never carry text at any size; #140d02 is
// the only ink allowed on a gold fill.
//
// IMAGE ROLES FOR THIS DROP (2026-10-12). Two files are referenced from this page
// and only two, and each pairing is read off the artwork itself — the percentage
// printed ON the slide has to match the heading the block carries, or the picture
// contradicts the section above it. NOTE the pairing is the REVERSE of last
// round's: here slide1 is the cashback art and slide2 is the referral art.
//   slide1.png — square 600x600. The dragon-medallion logo top-right, a man in a
//     black suit and a woman in a black-and-gold sequined dress, both silver
//     haired, reaching out from the left; a roulette wheel, gold aces, black
//     gold-rimmed chips and stacks of gold coins around them. Across the middle
//     โปรโมชั่น in huge 3-D gold type and, on a black gold-edged plate below it,
//     คืนยอดเสีย 0.3%. The artwork prints the offer itself, so it belongs to docx
//     H3 §4. Imported as imgCashback.
//   slide2.png — the companion square. Same couple, logo top-LEFT this time, a
//     gold crown above the lettering, gold aces bottom-left and gold dice on the
//     right. Across the middle โปรโมชั่น in the same 3-D gold type and, on a
//     black gold-edged plate below it, แนะนำเพื่อน โบนัส 0.8%. It belongs to docx
//     H3 §5. Imported as imgReferral.
// Both slides are 600x600 on disk, so 600 is the top real candidate — nothing
// above it would be a real pixel — and each picture carries max-w-[600px] so the
// art is never upscaled past its own bitmap.
// Each slide sits in a ContentBoxSevenThree* image+text block, which is that
// family's hard cap of two per rebrand, so there is no third SevenThree anywhere
// on the site and no slide appears outside those two blocks.
// Both blocks lay out md:grid-cols-[7fr_3fr] with the TEXT column first, so each
// picture goes in slot="right": the heading always lands on the prose, never on
// the picture, and on a phone the single column reads heading, text, picture
// rather than opening with an image. Each `sizes` therefore describes its own
// 3fr column rather than the viewport, and both were taken from the arithmetic
// block inside the variant that owns them — they are NOT last round's numbers,
// because SevenThree caps the SECTION at max-w-[1400px] (so px-4 comes out of the
// cap) and pays border + md:p-10 + gap-8 + md:pl-6, while
// SevenThreeFloatingBadge caps the CARD at max-w-7xl and pays border-2 + a flat
// p-8 + gap-10 + md:pl-10 + md:border-l:
//   ContentBoxSevenThree (section 4)            >= 1400px : 352px
//                                               md..1399  : calc(30vw - 68px)
//                                               698..767  : 600px (bitmap cap)
//                                               < 698     : calc(100vw - 98px)
//   ContentBoxSevenThreeFloatingBadge (sect. 5) >= 1312px : 311px
//                                               md..1311  : calc(30vw - 83px)
//                                               700..767  : 600px (bitmap cap)
//                                               < 700     : calc(100vw - 100px)
// Neither is the LCP element — MainLayout's hero banner is — so both are
// loading="lazy" fetchpriority="low" decoding="async" and neither takes
// fetchpriority="high". formats/fallbackFormat/quality stay at the house values:
// tools/avif-quality-service.mjs rescales AVIF quality on its own, so
// quality={80} must not be hand-tuned per format.
//
// The alt text was written from THIS drop's artwork, not carried over: the set is
// a BLACK-AND-GOLD photographic casino scene — a silver-haired couple in black
// suits with gold trim, a gold dragon medallion, a roulette wheel, gold aces,
// gold dice, black gold-rimmed chips and gold coins. It is NOT PUNPRO168's pink
// cartoon set (no pink handheld console, no pink-bobbed girl, no crowned cartoon
// cat or rabbit, no 777 cabinet, no pink hearts), not TIGERWIN369's tiger
// medallion, not UFA324's night stadium and not LOTTOPLUS's lottery posters.
//
// Deliberately NOT imported, and every file still on disk:
//   banner2.png (10-08) and banner3.png (09-27) are previous brands' article
//   banners, and slide3.png / slide4.png (09-29) are a lottery brand's posters.
//   Importing any of them emits a competitor's picture into dist/ (an eager
//   import IS an emit, rendered or not) and turns verify-build red. There is
//   therefore NO current-drop article illustration this round, and a slide is
//   not substituted for one.
//   banner1.png and banner1-mobile.png belong to MainLayout's own pinned globs
//   and are never referenced from a page. og.png is the same: MainLayout owns it.
// Also deliberately unused (named without the file extension on purpose — the
// playbook's "is this component live?" check is a bare-filename grep, and a
// mention here would read as a render): ProviderGrid and GameRankingBoard have
// nothing to carry because the brief names no game studio and no ranking;
// SmoothCarousel has no brief section asking for a carousel; BankStrip already
// renders inside the active footer; and FeatureHighlights has nothing to carry
// either, because section 6's three steps are running prose in the brief rather
// than a labelled sub-list — they go in ContentBox3ThreePremium's three columns
// with heading={false}, so the steps render as <p> and never become <h3>.
//
// Vocabulary: this brand is a MIXED CASINO — "แบรนด์คาสิโนเซิร์ฟไทย" covering
// บาคาร่า, สล็อต, รูเล็ต, ไฮโล and แทงบอล plus a live-dealer section. It is NOT a
// slot-only site, NOT a sports book and NOT a lottery site. The words this page
// may use are the brief's own: แบรนด์คาสิโนเซิร์ฟไทย, เกมเดิมพันออนไลน์,
// แพลตฟอร์มเดียว, บาคาร่า, สล็อต, รูเล็ต, ไฮโล, แทงบอล, คาสิโนไลฟ์สด,
// เกมถ่ายทอดสดจากโต๊ะจริง, Login, ตรวจสอบเครดิต, เกมไพ่, เกมวงล้อทั่วไป, ฟรีสปิน,
// ฟีเจอร์ตัวคูณ, การทายผล, คู่แข่งขัน, อัตราต่อรอง, ตารางจ่าย, กติกา, ยอดเดิมพัน,
// มีโบนัสทุกเกม, รอบโบนัส, คืนยอดเสีย 0.3%, เข้ายูสทุกวัน, รอบประจำวัน, เวลาตัดยอด,
// เกมที่ร่วมรายการ, ยอดที่เข้าเกณฑ์, แนะนำเพื่อน, โบนัส 0.8%, ไม่จำกัด, ลิงก์แนะนำ,
// สมัคร 3 ขั้นตอน, ยืนยันบัญชี, โดเมนหลัก, ข้อมูลผู้ดำเนินงาน, แอดมิน 24 ชั่วโมง,
// ตารางเปิดโต๊ะ, PIN, OTP.
// ⚠️ PUNPRO168's slot-only framing is gone from this page (สล็อตปันโปรในตำนาน,
// เว็บเล่นสล็อตออนไลน์, เว็บตรงในตำนาน, ทางเข้าเล่นใหม่ 2026, สล็อตคลาสสิก,
// เว็บคนนิยมเล่นมายาวนาน, ฝากถอนเข้า บช. บริษัทตรง, เว็บไซต์เลียนแบบ), as is
// TIGERWIN369's (เว็บดังของแท้ในตำนาน, เบทต่ำ, ทุนน้อย, ยิงปลา, เสือ), UFA324's
// sports framing (ฐานเกมแท้, จ่ายตรง, ไม่บิทยูส, ไม่ผ่าน บช. ม้า, มวย) and every
// older brand's set (แตกง่ายทุกเกม, ส่งตรงจากเมกา, ไม่ผ่านเอเย่นต์, ทุนน้อยกำไรงาม,
// การันตีเว็บแท้, จ่ายไว, ค่ายตรง, รีวิวถอนจริง, ถูกลิขสิทธิ์, VIP, ชุมชน) — the
// page is written straight from the brief rather than find-and-replaced over the
// old sentences. There is NO หวย / โพย / เลขเด็ด / งวด / แนวทาง / ตรวจหวย /
// อัตราจ่ายหวย / 3 ตัว / 2 ตัว anywhere on this site this round: it is a casino
// brand, and /ตรวจหวย and /แนวทาง stay parked in src/pages-disabled/.
// Nothing here claims a licence, a regulator, an operator, a game studio, a bank,
// an RTP figure, a deposit minimum, a member count, a founding year or a server
// location, because the brief names none — it explicitly hedges the "เซิร์ฟไทย"
// and "ทุกค่าย" claims rather than asserting them, and that hedge ships with the
// copy. The only figures are the brief's own: 0.3%, 0.8%, 3 ขั้นตอน and
// 24 ชั่วโมง.
// The brief hedges seven separate times (ส่วนจำนวนค่ายที่เปิดให้บริการและที่ตั้ง
// เซิร์ฟเวอร์ควรตรวจสอบจากข้อมูลผู้ให้บริการจริง · สำหรับคำว่ามีโบนัสทุกเกมควร
// ตรวจสอบว่าหมายถึงฟีเจอร์โบนัสภายในเกมหรือโปรโมชั่น · ไม่มีเกมประเภทใดรับประกัน
// ผลตอบแทน · ควรตรวจสอบว่าโปรโมชั่นครอบคลุมเกมประเภทใดบ้าง · ควรอ่านเวลาตัดยอดและ
// เงื่อนไขการใช้โบนัสก่อนรับทุกครั้ง · คำว่าไม่จำกัดควรระบุให้ชัด · ควรตรวจสอบ
// ตารางเปิดโต๊ะเพราะบางเกมอาจมีช่วงปิดปรับปรุง) and every one of those clauses is
// part of its paragraph, not trimmed as downbeat filler.
//
// The brief, every piece of artwork in the drop and the operator's prompt all
// agree on the brand name — no conflict this round. Even so the name is never
// typed on the page: it is interpolated from ${BRAND_NAME} so it can never drift
// from brandProfile. No domain is written out anywhere here — note the brand name
// and the domain do NOT match this round (brand TND168, domain tnd168-play.com,
// which has a hyphen, a -play tail and a .com TLD), which is exactly the kind of
// thing a hand-typed URL gets wrong.
//
// Title and description are the brief's own Title/Description lines
// (content.txt lines 1-2), used verbatim and NOT padded up to 150 characters —
// verify-build deliberately skips its 150-character floor on the home page for
// exactly this reason. Both strings are byte-identical to the defaults the
// orchestrator set in MainLayout.astro, which is what makes passing them here a
// no-op rather than a second source of truth.
const pageTitle = `${BRAND_NAME} แบรนด์คาสิโนเซิร์ฟไทย เล่นได้ทุกค่าย ไลฟ์ 24 ชั่วโมง`;

const pageDescription = `${BRAND_NAME} แบรนด์คาสิโนเซิร์ฟไทย เข้าเล่นเดิมพันได้ทุกค่าย บาคาร่า สล็อต รูเล็ต ไฮโล แทงบอล มีโบนัสทุกเกม Login เข้าไลฟ์สดได้ 24 ชั่วโมง`;

// The brief has a real H2 -> H3 nesting this round, so the page is NOT flattened
// to H2-only. The two H3s are the docx's own H3 lines — the two promotion
// sub-points that sit under section 3's โปรโมชั่น H2 in the brief's own outline.
// There is no FeatureHighlights H3 exception this round.
//
// The checklist, in document order, and what carries each one:
//    1 H1  ${BRAND_NAME} แบรนด์คาสิโนเซิร์ฟไทย เข้าเล่นเดิมพันได้ทุกค่าย
//          ContentBoxNeumorphism, brief paragraph on line 4
//    2 H2  ${BRAND_NAME} บาคาร่า สล็อต รูเล็ต ไฮโล แทงบอล มีโบนัสทุกเกม
//          ContentBoxTwoCyberCut, line 6 left / line 7 right
//    3 H2  โปรโมชั่นเดิมพัน ${BRAND_NAME} เว็บพนันคาสิโนเซิร์ฟไทย
//          ContentBox (the plain, always-live variant), line 9
//    4 H3  โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสทุกวัน
//          ContentBoxSevenThree + slide1 (imgCashback), line 11
//    5 H3  โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด
//          ContentBoxSevenThreeFloatingBadge + slide2 (imgReferral), line 13
//    6 H2  สมัครเล่น ${BRAND_NAME} คาสิโน 3 ขั้นตอน เข้าไลฟ์สดได้ 24 ชั่วโมง
//          ContentBox3ThreePremium, lines 15 + 19 as the intro slot and lines
//          16/17/18 as the three columns
//    7 H2  แอดมิน ${BRAND_NAME} เปิดบริการ 24 ชั่วโมง
//          ContentBoxPremium, lines 21 and 22
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ ${BRAND_NAME}
//          Faq + faqs prop, lines 24-29
// Final inventory for this page: h1 x1, h2 x5, h3 x2.
//
// SHAPE RHYTHM, top to bottom — no two adjacent sections read as the same card,
// and each neighbour pair differs in at least two of {corner, surface depth,
// heading treatment}:
//   §1 rounded-[25px] NEUMORPHIC on MID #120c04, twin inset/outset shadows and no
//      border glow at all, heading CENTRED on a gradient ivory -> bright gold ->
//      primary gold — the only centred heading above the FAQ
//   §2 CLIPPED corners (30px) on SUNKEN #070502 with four corner rules, heading
//      gradient primary -> sand -> bright gold, two columns split by a square
//      gold marker vs a deep-gold marker
//   §3 rounded-3xl on RAISED #1b1307 with a top hairline and a 20px underline
//      rule, heading gradient bright -> highlight -> primary (the always-live
//      box; its treatment is fixed by the orchestrator)
//   §4 CLIPPED corners (36px, deeper than §2's) on MID #120c04, heading SOLID
//      primary gold behind a vertical spine — the only solid-gold heading on the
//      page, picture right
//   §5 rounded-2xl GRADED from RAISED #1b1307 down to SUNKEN #070502, heading
//      INVERTED into a floating SOLID GOLD plate carrying #140d02 ink — the
//      opposite polarity of every other heading here, picture right
//   §6 rounded-3xl on RAISED #1b1307 with a leading vertical bar, heading
//      gradient sand -> bright -> primary, three columns whose step labels are
//      <p> with gold lead dots
//   §7 rounded-3xl GRADED from MID #120c04 to SUNKEN #070502 with a full-width
//      underline, heading gradient primary -> bright -> sand
//   §8 clipped accordion rows on MID -> SUNKEN inside a deep-gold hairline frame,
//      heading gradient ivory -> primary -> bright, centred
// The two CLIPPED-corner blocks (§2, §4) are separated by §3's rounded raised
// card and differ in clip depth and surface; the two RAISED-surfaced ones (§3,
// §6) are separated by three sections; and every card's heading gradient runs a
// different order of the same gold ramp, so no two read as one card.
//
// ContentBoxSevenThree and ContentBoxSevenThreeFloatingBadge both take the docx
// heading through `title`, which falls back to their wide (7fr) LEFT text column;
// neither is passed a `titleright`, so each block emits exactly one heading and
// the picture column never carries one.
//
// Every brief paragraph ships in full — all thirteen of them, nothing merged or
// summarised, plus the three FAQ answers. Section 2 has two paragraphs and runs
// one per column; section 6 runs its intro paragraph AND its closing live-table
// hedge in the default slot and its three step paragraphs one per column;
// section 7 has two paragraphs in one single-slot card; sections 1, 3, 4 and 5
// have one paragraph each.
// Two slots receive more than one paragraph (§6's intro and §7's body), and each
// wraps them in ONE <div class="flex flex-col gap-4"> as the house rule requires
// — a slot never receives two siblings, because both of those slots sit inside a
// gap-* flex column and bare siblings would pick up the column's own gap instead.
// The column labels passed to ContentBoxTwoCyberCut are this page's own layout
// wording, not brief headings, and that variant renders them as <p>.
// The three labels passed to ContentBox3ThreePremium are the brief's own
// "ขั้นตอนที่ N" openers, but the brief writes them as running prose rather than
// as headings, so heading={false} (the default) keeps them <p> too.
//
// Everything else on the page is chrome and emits no heading tag at any level:
// AnnouncementPremium, LatestWinners3, LoginRtpSection and ReviewCardSumo2 render
// their titles as <p>/<span> with an aria-label on the section, and Faq's
// questions live inside <summary> as <span>. The non-brief widgets sit before
// section 1 (the ticker, then the winners feed) and after section 8
// (LoginRtpSection, ReviewCardSumo2, Navfoot) — never spliced between two content
// sections.

// One array, used by both <Faq> and the FAQPage node — never the component's own
// defaults (Faq deliberately ships an empty list, so a forgotten prop renders an
// empty accordion rather than some previous brand's questions). The three pairs
// are the brief's own Q/A block (content.txt lines 24-29), verbatim.
const faqs = [
  {
    q: `${BRAND_NAME} มีเกมคาสิโนและการเดิมพันประเภทใดบ้าง?`,
    a: `${BRAND_NAME} นำเสนอเกมหลายประเภท ได้แก่ บาคาร่า สล็อต รูเล็ต ไฮโล และแทงบอล รวมถึงหมวดคาสิโนไลฟ์สด โดยจำนวนเกมและค่ายที่เปิดให้บริการจริงขึ้นอยู่กับระบบ สมาชิกควรตรวจสอบกติกาและช่วงเดิมพันของแต่ละรายการก่อนเริ่มเล่น`,
  },
  {
    q: `${BRAND_NAME} คาสิโนไลฟ์สดเปิดให้เล่นตลอด 24 ชั่วโมงหรือไม่?`,
    a: `เว็บไซต์ระบุว่ารองรับการเข้าใช้งานตลอด 24 ชั่วโมง แต่เวลาเปิดโต๊ะคาสิโนไลฟ์สดอาจแตกต่างกันตามค่ายและรอบถ่ายทอดสด ควรตรวจสอบสถานะเกมในระบบก่อนเข้าใช้งาน`,
  },
  {
    q: `${BRAND_NAME} มีโปรโมชั่นอะไร และติดต่อแอดมินได้ตอนไหน?`,
    a: `โปรโมชั่นหลักตามข้อมูลที่กำหนดมี คืนยอดเสีย 0.3% และ แนะนำเพื่อน 0.8% โดยแต่ละรายการมีเงื่อนไขแตกต่างกัน ส่วนแอดมินระบุว่าเปิดให้บริการตลอด 24 ชั่วโมง สมาชิกควรตรวจสอบช่องทางติดต่อหลักและเวลาตอบกลับจริงจากหน้าเว็บไซต์`,
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// No two <strong> elements are adjacent either: every pair is separated by at
// least one run of plain text, so the whitespace between them can never collapse
// into a missing space.
// One highlight colour only: #ffc93d, against the inherited body colour #f0e9dc
// (BRAND_TEXT). The paragraphs below carry no colour class of their own: every
// ContentBox* card in this mix already sets
// `text-left text-base leading-relaxed text-[#f0e9dc]` on the element holding the
// slot, so the prose inherits it and no page-level override can drift from the
// card. No paragraph carries mx-auto or max-w-* either — the cards cap their own
// width, and the only max-w-* on the page is the one capping each slide, which is
// an image and not prose.

// No breadcrumb: this is the homepage, so a trail from the root to itself would
// be a single self-referential crumb. Every URL in the graph is derived by
// pageGraph from `site:` — no domain is typed out in this file, no URL is built
// with `+`, and no Review / AggregateRating / sameAs / address / email node is
// passed. `description` is the exact same string MainLayout gets, and `faqs` is
// the exact same array <Faq> gets.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <LatestWinners />

  <ContentBoxNeumorphism as="h1" title={`${BRAND_NAME} แบรนด์คาสิโนเซิร์ฟไทย เข้าเล่นเดิมพันได้ทุกค่าย`}>
    <p>
      {BRAND_NAME} แบรนด์คาสิโนเซิร์ฟไทยที่นำเสนอเกมเดิมพันออนไลน์หลายประเภทไว้ในแพลตฟอร์มเดียว
      <strong class="text-[#ffc93d]">ทั้งบาคาร่า สล็อต รูเล็ต ไฮโล และแทงบอล</strong>
      พร้อมหมวดคาสิโนไลฟ์สดสำหรับผู้ที่สนใจเกมถ่ายทอดสดจากโต๊ะจริง รองรับการใช้งานผ่านมือถือและคอมพิวเตอร์ สมาชิกสามารถ
      <strong class="text-[#ffc93d]">Login เพื่อค้นหาเกม ตรวจสอบเครดิต และติดตามรายการต่างๆ ได้สะดวก</strong>
      ส่วนจำนวนค่ายที่เปิดให้บริการและที่ตั้งเซิร์ฟเวอร์ในประเทศไทยควรตรวจสอบจากข้อมูลผู้ให้บริการจริง
    </p>
  </ContentBoxNeumorphism>

  <ContentBoxTwoCyberCut
    as="h2"
    title={`${BRAND_NAME} บาคาร่า สล็อต รูเล็ต ไฮโล แทงบอล มีโบนัสทุกเกม`}
    titleleft="ประเภทเกมที่รวบรวมไว้"
    titleright="ก่อนเชื่อคำว่ามีโบนัสทุกเกม">
    <p slot="left">
      {BRAND_NAME} รวบรวมเกมคาสิโนและการเดิมพันกีฬาไว้หลายรูปแบบ
      <strong class="text-[#ffc93d]">โดยบาคาร่าเป็นเกมไพ่ที่มีตัวเลือกการเดิมพันตามกติกา</strong>
      สล็อตมีทั้งเกมวงล้อทั่วไป ฟรีสปิน และฟีเจอร์ตัวคูณ ส่วนรูเล็ตและไฮโลมีรูปแบบการทายผลที่แตกต่างกัน
      <strong class="text-[#ffc93d]">ขณะที่แทงบอลมีข้อมูลคู่แข่งขันและอัตราต่อรองให้ตรวจสอบก่อนทำรายการ</strong>
      สมาชิกสามารถเลือกประเภทเกมตามความสนใจและศึกษารายละเอียดผ่านระบบได้
    </p>
    <p slot="right">
      สำหรับคำว่า มีโบนัสทุกเกม
      <strong class="text-[#ffc93d]">ควรตรวจสอบว่าหมายถึงฟีเจอร์โบนัสภายในเกมหรือโปรโมชั่นของเว็บไซต์</strong>
      เพราะแต่ละค่ายมีเงื่อนไขไม่เหมือนกัน บางเกมอาจไม่มีรอบโบนัสหรือสิทธิพิเศษเพิ่มเติม
      <strong class="text-[#ffc93d]">และไม่มีเกมประเภทใดรับประกันผลตอบแทน</strong>
      สมาชิกจึงควรตรวจสอบตารางจ่าย กติกา และยอดเดิมพันก่อนเริ่มเล่นทุกครั้ง
    </p>
  </ContentBoxTwoCyberCut>

  <ContentBox as="h2" title={`โปรโมชั่นเดิมพัน ${BRAND_NAME} เว็บพนันคาสิโนเซิร์ฟไทย`}>
    <p>
      โปรโมชั่นเดิมพัน {BRAND_NAME} นำเสนอสิทธิพิเศษสำหรับสมาชิกตามกิจกรรมที่เว็บไซต์กำหนด
      <strong class="text-[#ffc93d]">โดยมีทั้งโบนัสคืนยอดเสียและกิจกรรมแนะนำเพื่อน</strong>
      สามารถตรวจสอบยอดที่เข้าเกณฑ์ รอบคำนวณ และสถานะการรับสิทธิ์ผ่านบัญชีสมาชิกได้ตามระบบที่เปิดให้บริการ
      <strong class="text-[#ffc93d]">ทั้งนี้ควรตรวจสอบว่าโปรโมชั่นครอบคลุมบาคาร่า สล็อต รูเล็ต ไฮโล หรือแทงบอลประเภทใดบ้าง</strong>
      เพราะแต่ละกิจกรรมอาจมีข้อกำหนดแตกต่างกัน
    </p>
  </ContentBox>

  <ContentBoxSevenThree as="h3" title="โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสทุกวัน">
    <p slot="left">
      สมาชิก {BRAND_NAME} ที่มียอดเสียตรงตามเงื่อนไขสามารถตรวจสอบสิทธิ์รับ
      <strong class="text-[#ffc93d]">โบนัสคืนยอดเสีย 0.3% ตามรอบประจำวันที่เว็บไซต์กำหนด</strong>
      โดยระบบจะนำยอดที่เข้าเกณฑ์มาคำนวณก่อนแสดงจำนวนโบนัส หากรองรับการโอนโบนัสเข้ายูสอัตโนมัติ สมาชิกสามารถตรวจสอบยอดและประวัติการรับสิทธิ์ผ่านบัญชีได้
      <strong class="text-[#ffc93d]">ควรอ่านรายละเอียดประเภทเกมที่ร่วมรายการ เวลาตัดยอด และเงื่อนไขการใช้โบนัสก่อนรับทุกครั้ง</strong>
    </p>
    <Picture
      slot="right"
      src={imgCashback}
      loading="lazy"
      fetchpriority="low"
      widths={[352, 480, 600]}
      sizes="(max-width: 697px) calc(100vw - 98px), (max-width: 767px) 600px, (max-width: 1399px) calc(30vw - 68px), 352px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt={`ภาพโปรโมชั่นคืนยอดเสียของ ${BRAND_NAME} เป็นงานอาร์ตสี่เหลี่ยมจัตุรัสโทนดำสลับทอง มุมขวาบนเป็นโลโก้เหรียญตรากลมรูปมังกรจีนสีทองขดอยู่รอบตัวอักษร TND168 ด้านซ้ายเป็นชายหนุ่มผมขาวเงินในชุดสูทดำและหญิงสาวผมสั้นสีขาวเงินในชุดสีดำปักเลื่อมทองยืนยื่นมือออกมาทางผู้ชม ด้านหลังมีวงล้อรูเล็ต ไพ่เอซสีทอง ชิปคาสิโนสีดำขอบทอง และกองเหรียญทอง กลางภาพเป็นคำว่า โปรโมชั่น ตัวอักษรทองสามมิติขนาดใหญ่ ถัดลงมาบนแผ่นป้ายสีดำขอบทองเป็นคำว่า คืนยอดเสีย คู่กับเลข 0.3%`}
      class="mx-auto h-auto w-full max-w-[600px] rounded-2xl border border-[#dfa310]/55 shadow-[0_0_28px_rgba(223,163,16,0.28)]"
    />
  </ContentBoxSevenThree>

  <ContentBoxSevenThreeFloatingBadge as="h3" title="โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด">
    <p slot="left">
      โปรโมชั่นแนะนำเพื่อน {BRAND_NAME}
      <strong class="text-[#ffc93d]">ระบุอัตราโบนัส 0.8% จากยอดที่เข้าเกณฑ์ตามข้อกำหนด</strong>
      สมาชิกสามารถตรวจสอบรายละเอียดลิงก์แนะนำ จำนวนเพื่อนที่สมัคร และวิธีคำนวณโบนัสผ่านระบบสมาชิก
      <strong class="text-[#ffc93d]">ส่วนคำว่าไม่จำกัดควรระบุให้ชัดว่าหมายถึงจำนวนเพื่อนที่แนะนำ จำนวนครั้งในการรับสิทธิ์ หรือยอดโบนัสสูงสุด</strong>
      เพื่อป้องกันความเข้าใจคลาดเคลื่อนเกี่ยวกับผลตอบแทน
    </p>
    <Picture
      slot="right"
      src={imgReferral}
      loading="lazy"
      fetchpriority="low"
      widths={[311, 480, 600]}
      sizes="(max-width: 699px) calc(100vw - 100px), (max-width: 767px) 600px, (max-width: 1311px) calc(30vw - 83px), 311px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt={`ภาพโปรโมชั่นแนะนำเพื่อนของ ${BRAND_NAME} เป็นงานอาร์ตสี่เหลี่ยมจัตุรัสชุดเดียวกัน โทนดำสลับทอง มุมซ้ายบนเป็นโลโก้เหรียญตรากลมรูปมังกรจีนสีทองขดอยู่รอบตัวอักษร TND168 กลางภาพด้านบนเป็นชายหนุ่มผมขาวเงินและหญิงสาวผมสั้นสีขาวเงินในชุดสูทดำขลิบทองยืนยื่นมือออกมาทางผู้ชม มุมซ้ายล่างเป็นไพ่เอซสีทอง ด้านขวาเป็นลูกเต๋าสีทองและชิปคาสิโนสีดำขอบทอง รอบตัวมีเหรียญทองกองอยู่ กลางภาพเป็นคำว่า โปรโมชั่น ตัวอักษรทองสามมิติขนาดใหญ่ใต้มงกุฎทอง ถัดลงมาบนแผ่นป้ายสีดำขอบทองเป็นคำว่า แนะนำเพื่อน และคำว่า โบนัส คู่กับเลข 0.8%`}
      class="mx-auto h-auto w-full max-w-[600px] rounded-2xl border border-[#ffe4a3]/45 shadow-[0_0_28px_rgba(255,228,163,0.22)]"
    />
  </ContentBoxSevenThreeFloatingBadge>

  <ContentBox3ThreePremium
    as="h2"
    title={`สมัครเล่น ${BRAND_NAME} คาสิโน 3 ขั้นตอน เข้าไลฟ์สดได้ 24 ชั่วโมง`}
    titleleft="ขั้นตอนที่ 1 เข้าหน้าสมัครสมาชิก"
    titlecenter="ขั้นตอนที่ 2 กรอกข้อมูลบัญชี"
    titleright="ขั้นตอนที่ 3 ยืนยันบัญชีและ Login">
    <div class="flex flex-col gap-4">
      <p>
        การสมัครเล่น {BRAND_NAME} คาสิโนสามารถดำเนินการผ่านหน้าสมัครสมาชิกของเว็บไซต์ที่เปิดให้บริการ
        <strong class="text-[#ffc93d]">โดยมีขั้นตอนตั้งแต่กรอกข้อมูลจนถึงยืนยันบัญชี</strong>
        พร้อมเมนูสำหรับเข้าสู่หมวดคาสิโนไลฟ์สดตามช่วงเวลาที่ผู้ให้บริการเปิดให้เล่น ผู้สมัครควรตรวจสอบโดเมนหลัก ข้อมูลผู้ดำเนินงาน และข้อกำหนดการใช้งานก่อนส่งข้อมูลส่วนตัว
        <strong class="text-[#ffc93d]">รวมถึงตรวจสอบอายุและข้อกฎหมายที่เกี่ยวข้องในพื้นที่ของตน</strong>
      </p>
      <p>
        สำหรับคาสิโนไลฟ์สดที่ระบุว่าเปิดให้บริการ 24 ชั่วโมง
        <strong class="text-[#ffc93d]">ควรตรวจสอบตารางเปิดโต๊ะและสถานะผู้ให้บริการแต่ละค่าย</strong>
        เพราะบางเกมอาจมีช่วงปิดปรับปรุงหรือเปลี่ยนรอบถ่ายทอดสด
      </p>
    </div>
    <p slot="left">
      เลือกเมนูสมัครจากทางเข้าหลักของ {BRAND_NAME}
      <strong class="text-[#ffc93d]">พร้อมตรวจสอบชื่อเว็บไซต์และรายละเอียดผู้ให้บริการให้ถูกต้อง</strong>
    </p>
    <p slot="center">
      ระบุข้อมูลตามแบบฟอร์มที่ระบบกำหนด
      <strong class="text-[#ffc93d]">พร้อมตั้งรหัสผ่านที่คาดเดายากและไม่ใช้ซ้ำกับบัญชีอื่น</strong>
    </p>
    <p slot="right">
      ตรวจสอบรายละเอียดที่กรอก อ่านเงื่อนไขให้ครบถ้วน และดำเนินการยืนยันบัญชีตามขั้นตอนของเว็บไซต์
      <strong class="text-[#ffc93d]">ก่อนเข้าสู่ระบบเพื่อดูหมวดเกมและคาสิโนไลฟ์สด</strong>
    </p>
  </ContentBox3ThreePremium>

  <ContentBoxPremium as="h2" title={`แอดมิน ${BRAND_NAME} เปิดบริการ 24 ชั่วโมง`}>
    <div class="flex flex-col gap-4">
      <p>
        แอดมิน {BRAND_NAME}
        <strong class="text-[#ffc93d]">มีช่องทางสำหรับสมาชิกที่ต้องการสอบถามเกี่ยวกับการสมัคร การเข้าสู่ระบบ เกมคาสิโนไลฟ์สด โปรโมชั่น หรือรายการธุรกรรมที่อยู่ระหว่างตรวจสอบ</strong>
        โดยระบุเวลาให้บริการตลอด 24 ชั่วโมง สมาชิกสามารถติดต่อผ่านช่องทางหลักที่เว็บไซต์กำหนด
        <strong class="text-[#ffc93d]">พร้อมแจ้งรายละเอียดปัญหาให้ครบถ้วน</strong>
        เพื่อช่วยให้เจ้าหน้าที่ตรวจสอบรายการได้ตรงประเด็น
      </p>
      <p>
        หากพบปัญหาเกี่ยวกับคาสิโนไลฟ์สด
        <strong class="text-[#ffc93d]">ควรแจ้งชื่อเกม ค่าย และเวลาที่เกิดเหตุ</strong>
        ส่วนการเดิมพันกีฬาควรเตรียมชื่อคู่แข่งขันและหมายเลขรายการ หากเป็นปัญหาโปรโมชั่นควรระบุชื่อกิจกรรมและรอบรับสิทธิ์
        <strong class="text-[#ffc93d]">โดยไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น</strong>
        แม้จะอ้างว่าเป็นเจ้าหน้าที่ของเว็บไซต์ก็ตาม
      </p>
    </div>
  </ContentBoxPremium>

  <Faq as="h2" title={`คำถามที่พบบ่อยเกี่ยวกับ ${BRAND_NAME}`} faqs={faqs} />

  <LoginRtpSection />

  <ReviewCardSumo />

  <Navfoot />
</MainLayout>
