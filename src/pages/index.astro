---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import ContentBox from "../components/ContentBox.astro";
import ProviderGridPremium from "../components/ProviderGridPremium.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import Faq from "../components/Faq4.astro";
import LatestWinners from "../components/LatestWinnersCyber.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// Title and description are the brief's own Title/Description lines, used
// verbatim. A brief-supplied description is never padded up to the 150-char
// floor and never topped up from the H1/H2.
const pageTitle = "LION991 คาสิโนvip รวมเกมเดิมพัน แบรนด์แท้ไลฟ์สด 24 ชม";

const pageDescription = "LION991 คาสิโนvip เกมเดิมพันออนไลน์ ครบทุกแบรนด์แท้ ระบบเดิมพันมาตรฐาน มีห้องไลฟ์สด 24 ชั่วโมง";

// The ticker copy is passed explicitly rather than relying on the component's
// default — every Announcement* variant's default belongs to whichever brand
// wired it in last. No emoji in this string: an emoji baked into a text prop
// cannot be given its own aria-hidden span, and this marquee prints the string
// twice.
const announcement =
  "LION991 คาสิโน VIP เกมเดิมพันออนไลน์ ครบทุกแบรนด์แท้ มีห้องไลฟ์สด 24 ชั่วโมง • เลือกเข้าเล่นคาสิโนแบบ Live ได้ตามโต๊ะและผู้ให้บริการที่เปิดให้บริการ ทั้งบาคาร่า รูเล็ต เสือมังกร และแบล็กแจ็ก • รองรับการรับชมผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ ติดตามการดำเนินเกมแบบเรียลไทม์ได้ • ก่อนเดิมพันควรตรวจสอบกติกา อัตราจ่าย วงเงินขั้นต่ำและสูงสุดของแต่ละโต๊ะให้ครบถ้วน • Login เพื่อตรวจสอบโปรโมชั่นที่เปิดให้รับในช่วงเวลานั้นได้จากบัญชีสมาชิก • สมัคร LION991 ออนไลน์ได้เอง 3 ขั้นตอน ไม่ต้องผ่านแอดมิน • แอดมิน LION991 รับเรื่องตลอด 24 ชั่วโมง";

// One array, used by both <Faq> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last.
const faqs = [
  {
    q: "LION991 มีเกมคาสิโน Live อะไรให้เลือกบ้าง?",
    a: "ระบบสามารถมีเกมอย่างบาคาร่า รูเล็ต เสือมังกร แบล็กแจ็ก และคาสิโนสดประเภทอื่น ๆ โดยโต๊ะและผู้ให้บริการที่พร้อมใช้งานอาจเปลี่ยนแปลงได้ สมาชิกควรตรวจสอบรายการล่าสุดจากหมวดคาสิโน Live ก่อนเข้าเล่น",
  },
  {
    q: "สมัคร LION991 ต้องติดต่อแอดมินก่อนหรือไม่?",
    a: "หากระบบสมัครออนไลน์เปิดให้บริการ สมาชิกสามารถกรอกข้อมูลและสร้างบัญชีได้ด้วยตัวเองโดยไม่ต้องสมัครผ่านแอดมิน หากติดปัญหาในขั้นตอนใดจึงค่อยติดต่อทีมงานเพื่อขอคำแนะนำ",
  },
  {
    q: "หากคาสิโน Live หรือฝากถอน LION991 มีปัญหาต้องทำอย่างไร?",
    a: "ตรวจสอบสถานะระบบและรายการในบัญชีก่อน หากยังพบปัญหา ให้ติดต่อแอดมิน LION991 พร้อมแจ้งชื่อเกม เวลา จำนวนเงิน หรือรายละเอียดธุรกรรม เพื่อให้เจ้าหน้าที่ตรวจสอบและแนะนำขั้นตอนดำเนินการต่อได้",
  },
];

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb. Every URL in the graph is derived
// by pageGraph from `site:` — no domain is typed out in this file.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <ContentBox as="h1" title="LION991 คาสิโน VIP เกมเดิมพันออนไลน์ ครบทุกแบรนด์แท้">
    <p class="text-left text-base leading-relaxed text-[#d6e2f5]">
      <strong class="text-[#e6ecf7]">LION991</strong> พร้อมให้บริการสมาชิกที่ต้องการเล่นคาสิโนออนไลน์ผ่านมือถือและคอมพิวเตอร์ โดยรวบรวมเกมเดิมพันหลายหมวดหมู่ไว้ในบัญชีเดียว
      พร้อมคาสิโนสดและโต๊ะ <strong class="text-[#8fc2ff]">Live</strong> ตามที่ระบบเปิดให้บริการ สมาชิกสามารถสมัคร เข้าเกม ตรวจสอบโปรโมชั่น ฝากถอน และจัดการบัญชีได้อย่างสะดวก
      พร้อมทีมงานคอยช่วยเหลือด้านการใช้งานตลอด 24 ชั่วโมง
    </p>
  </ContentBox>

  <ProviderGridPremium />

  <ContentBoxSpecial as="h2" title="ระบบเดิมพัน LION991 มีห้องไลฟ์สด 24 ชั่วโมง" iconleft="🎥" iconright="🃏">
    <p slot="left" class="text-left text-base leading-relaxed text-[#d6e2f5]">
      สมาชิกสามารถเลือกเข้าเล่นเกมคาสิโนแบบ Live ผ่านระบบ <strong class="text-[#e6ecf7]">LION991</strong> ได้ตามโต๊ะและผู้ให้บริการที่เปิดให้บริการ มีทั้งบาคาร่า รูเล็ต เสือมังกร แบล็กแจ็ก
      และเกมคาสิโนสดประเภทอื่น ๆ รองรับการรับชมผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ ทำให้สามารถติดตามการดำเนินเกมแบบเรียลไทม์ได้อย่างสะดวก
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#d6e2f5]">
      ก่อนเดิมพันควรตรวจสอบกติกา อัตราจ่าย <strong class="text-[#8fc2ff]">วงเงินขั้นต่ำและสูงสุดของแต่ละโต๊ะ</strong> เนื่องจากรายละเอียดอาจแตกต่างกันตามเกมและผู้ให้บริการ
      ส่วนข้อมูลเกี่ยวกับสตูดิโอหรือแหล่งถ่ายทอดสดควรยึดข้อมูลที่แสดงในเกมโดยตรง
    </p>
  </ContentBoxSpecial>

  <GameRankingBoard />

  <ContentBoxSevenThreePremium as="h2" title="โปรโมชั่น LION991 ยอดนิยมที่สมาชิกกดรับบ่อยที่สุด">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นคืนยอดเสีย 0.3% ของ LION991 พื้นหลังเป็นห้องคาสิโนสดโทนน้ำเงินเข้ม ด้านบนเป็นโลโก้ LION991 ตัวอักษร LION สีน้ำเงินเมทัลลิกต่อด้วยเลข 991 สีเงิน ถัดลงมาเป็นป้ายคำว่า โปรโมชั่น ตามด้วยข้อความสีขาวว่า คืนยอดเสีย วางเหนือตัวเลข 0.3% ขนาดใหญ่สีน้ำเงินสลับขาว ตรงกลางเป็นผู้หญิงสวมชุดสีน้ำเงินกรมท่ายกมือชี้ไปที่ตัวเลข ด้านข้างมีป้ายวงรีสีน้ำเงินสี่อันเขียนว่า มั่นคง ปลอดภัย กับ บริการระดับพรีเมียม และ คืนยอดเสียทุกวัน ด้านล่างสุดเป็นแถบข้อความว่า คาสิโนออนไลน์ คาสิโนสด สล็อต โปรโมชั่นพิเศษมากมาย"
      class="mx-auto h-auto w-full rounded-2xl border border-[#3d82ff]/40 shadow-[0_10px_30px_rgba(61,130,255,0.25)]"
    />
    <div slot="right" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d6e2f5]">
        สมาชิกสามารถ Login เพื่อตรวจสอบโปรโมชั่น <strong class="text-[#e6ecf7]">LION991</strong> ที่เปิดให้รับในช่วงเวลานั้น ไม่ว่าจะเป็นสิทธิ์สำหรับสมาชิกใหม่ โปรโมชั่นยอดฝาก
        กิจกรรมแนะนำเพื่อน หรือโบนัสประเภทอื่น ๆ ตามที่เว็บไซต์กำหนด โดยแต่ละโปรโมชั่นอาจมีเปอร์เซ็นต์ วิธีคำนวณ รอบรับโบนัส และข้อกำหนดในการถอนแตกต่างกัน
      </p>
      <p class="text-left text-base leading-relaxed text-[#d6e2f5]">
        ก่อนกดรับควรอ่านรายละเอียดให้ครบถ้วน โดยเฉพาะ<strong class="text-[#8fc2ff]">ยอดขั้นต่ำ ประเภทเกมที่ร่วมรายการ และเงื่อนไขที่ต้องทำให้สำเร็จก่อนถอนโบนัส</strong>
        เพื่อเลือกโปรโมชั่นให้เหมาะกับการใช้งานของตนเอง
      </p>
    </div>
  </ContentBoxSevenThreePremium>

  <ContentBoxSevenThree as="h2" title="สมัครสมาชิก LION991 3 ขั้นตอน ไม่ต้องผ่านแอดมิน">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อน 0.8% ของ LION991 พื้นหลังโทนน้ำเงินเข้ม มุมบนซ้ายเป็นเงาหัวสิงโต ถัดมาเป็นโลโก้ LION991 ตัวอักษร LION สีน้ำเงินเมทัลลิกต่อด้วยเลข 991 สีเงิน ใต้ลงมาเป็นป้ายคำว่า โปรโมชั่น ตามด้วยข้อความว่า แนะนำเพื่อน วางเหนือตัวเลข 0.8% ขนาดใหญ่ ตรงกลางเป็นผู้หญิงสวมชุดสีน้ำเงินกรมท่ายกมือชี้ไปที่ตัวเลข รอบตัวมีชิปคาสิโนและไพ่กระจายอยู่ ด้านล่างเป็นป้ายวงรีสีน้ำเงินสามอันเขียนว่า ชวนเพื่อนง่าย รับโบนัสทันที กับ รับโบนัส จากยอดเพื่อนเล่น และ ปลอดภัย มั่นคง เชื่อถือได้ 100%"
      class="mx-auto h-auto w-full rounded-2xl border border-[#3d82ff]/40 shadow-[0_10px_30px_rgba(61,130,255,0.25)]"
    />
    <div slot="right" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d6e2f5]">
        ผู้ใช้งานใหม่สามารถสมัคร <strong class="text-[#e6ecf7]">LION991</strong> ผ่านระบบออนไลน์ได้ด้วยตัวเอง โดยไม่จำเป็นต้องส่งข้อมูลการสมัครผ่านเจ้าหน้าที่ เริ่มต้นใช้งานได้ง่ายเพียง 3 ขั้นตอน
      </p>
      <ol class="ml-5 list-decimal space-y-2 text-left text-base leading-relaxed text-[#d6e2f5] marker:font-black marker:text-[#8fc2ff]">
        <li>เปิดหน้าสมัคร LION991 และกรอกข้อมูลตามที่ระบบกำหนด</li>
        <li>Login เข้าสู่บัญชีและเลือกช่องทางฝากเครดิตที่เปิดให้บริการ</li>
        <li>ตรวจสอบโปรโมชั่น เลือกเกมคาสิโนหรือโต๊ะ Live และศึกษากติกาก่อนเริ่มเดิมพัน</li>
      </ol>
      <p class="text-left text-base leading-relaxed text-[#d6e2f5]">
        หลังสมัครเรียบร้อยสามารถตรวจสอบ<strong class="text-[#8fc2ff]">เครดิต ประวัติรายการ โปรโมชั่น และสถานะฝากถอน</strong>ผ่านบัญชีสมาชิกได้โดยตรง
      </p>
    </div>
  </ContentBoxSevenThree>

  <LoginRtpSection />

  <ContentBoxTwoPremium as="h2" title="ติดต่อแอดมิน LION991 ได้ตลอด 24 ชั่วโมง">
    <p slot="left" class="text-left text-base leading-relaxed text-[#d6e2f5]">
      หากพบปัญหาเกี่ยวกับการสมัคร Login เข้าโต๊ะ Live ไม่ได้ ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง หรือโปรโมชั่นไม่แสดง สามารถติดต่อแอดมิน <strong class="text-[#e6ecf7]">LION991</strong>
      ได้ตลอด 24 ชั่วโมง พร้อมแจ้งรายละเอียด เวลา และข้อมูลรายการที่เกี่ยวข้อง เพื่อให้เจ้าหน้าที่ช่วยตรวจสอบปัญหาได้ตรงจุด
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#d6e2f5]">
      สมาชิกยังสามารถสอบถามเกี่ยวกับวิธีใช้งานคาสิโนสด ขั้นตอนฝากถอน หรือโปรโมชั่นที่เปิดให้บริการได้ โดย<strong class="text-[#8fc2ff]">ไม่ควรเปิดเผยรหัสผ่านและ OTP</strong>ให้บุคคลอื่น
    </p>
  </ContentBoxTwoPremium>

  <Faq title="คำถามที่พบบ่อยเกี่ยวกับ LION991" faqs={faqs} />

  <LatestWinners />

  <ReviewCardSumo2 />

  <Navfoot />
</MainLayout>
