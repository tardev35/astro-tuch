---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBox3ThreePremium from "../components/ContentBox3ThreePremium.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import Faq from "../components/Faq4.astro";
import LatestWinners from "../components/LatestWinnersPremium.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// IMAGE ROLES FOR THIS DROP (2026-09-25) — READ BEFORE REUSING THESE IMPORTS.
// Two files are referenced from this page and only two, both slides, both spent
// on a ContentBoxSevenThree* block — the family's hard cap of two per rebrand,
// so there is no third SevenThree here:
//   slide2.png — the poster whose gold Thai type reads "โปรโมชั่น แนะนำเพื่อน" over
//     a gold badge "โบนัส 0.8%", so it belongs to docx H3 #4.
//   slide1.png — the matching poster reading "โปรโมชั่น คืนยอดเสีย" with "โบนัส 0.3%"
//     in large gold numerals, so it belongs to docx H3 #5.
// Note the pairing is the reverse of KINGDOM66's round, where slide1 carried the
// 0.8% artwork — the numbers printed on this drop's files are swapped, so these
// two imports must not be copied over from git history without reading the art.
// Both files are 600x400, so 600 is the top candidate width — nothing above it
// would be a real pixel. The alt text was written from the CURRENT artwork (the
// two-metal MIRACLE55 wordmark, the woman in the white blazer, the small gold
// crown, the black-and-gold chips, the gold coins and the printed aces), never
// carried over from KINGDOM66's "engraved gold wordmark / man in a black tuxedo
// / gold megaphone / red plaque" strings — none of that is in these pictures.
//
// Deliberately NOT imported, and all still on disk as inventory:
//   banner2.png (2026-09-22), banner3.png (2026-08-11), slide3.png
//   (2026-09-18), slide4.png (2026-08-13) — every one predates this drop and
//   carries a previous client's artwork. There is therefore NO usable banner2+
//   this round and NO single-column inline illustration, which is the expected
//   outcome, not a gap to fill with a stale file.
//   banner1.png and banner1-mobile.png belong to MainLayout's own pinned globs
//   and are never referenced from a page — the hero is the LCP element, so
//   nothing here gets loading="eager" fetchpriority="high".
//
// DROPPED THIS ROUND, and none of the files deleted — every one is inventory for
// the next brand: ProviderGrid / ProviderGridPremium / FeaturedGames /
// PopularGamesStrip / GameRankingBoard each have to name specific studios, game
// titles or payout figures, and this brief names none at all. BankStrip needs a
// deposit/withdrawal channel, which the brief also never mentions.
// SmoothCarousel is out because it would put slide* outside a
// ContentBoxSevenThree*. LottoGrid is out because MIRACLE55 is a casino brand,
// not เว็บหวย (which is also why /ตรวจหวย and /แนวทาง stay parked).
// FeatureHighlights is out because it emits an <h3> per item and the brief gives
// its 3 signup steps no per-step headings — the steps ship as a plain <ol>
// instead. Filling any of these in would be inventing facts.

// Title and description are the brief's own Title/Description lines, used
// verbatim. A brief-supplied description is never padded up to the 150-char
// floor and never topped up from the H1/H2 — this one is 107 characters.
const pageTitle = "MIRACLE55 คาสิโนฐานหลัก เล่นผ่านบริษัทตรง ปลอดภัยทุกการเล่น100%";

const pageDescription = "MIRACLE55 คาสิโนฐานหลัก เข้าเล่นผ่านบริษัทแม่โดยตรง สนุกทุกค่าย ใช้งานปลอดภัย ตลอดทั้งการเดิมพัน100%";

// <Announcement /> runs bare: Announcement5's default message is already this
// brand's copy, and every sub-page calls it bare too — passing an override here
// is how the ticker ends up saying two different things on two pages.

// The docx has a real H2 -> H3 nesting this round: "แนะนำเพื่อน โบนัส 0.8%" and
// "คืนยอดเสีย โบนัส 0.3%" are genuine sub-points of the โปรโมชั่น H2, so the page
// is NOT flattened to H2-only. Those two are the only <h3> here, and each one is
// carried by its own ContentBoxSevenThree* block together with the slide whose
// artwork states that exact figure.
// Everything else is chrome and emits no heading tag: LatestWinnersPremium,
// LoginRtpSection and ReviewCardSumo2 render their titles as <p>/<span> with an
// aria-label on the section, and Faq4's questions live inside <summary>.
// ContentBox3ThreePremium's three column captions are this page's own wording for
// splitting one docx paragraph into three readable columns, not docx sub-points,
// so heading={false} renders them as <p> (that file's default is now false too).
// ContentBoxTwoPremium's two column labels were hardcoded headings and were
// downgraded to <p> inside the component this round, keeping their classes;
// ContentBoxTwoNeumorphism's were already <p>.
//
// The docx checklist, in order, and what carries each one:
//    1 H1  MIRACLE55 คาสิโนฐานหลัก เล่นผ่านบริษัทตรง ครบทุกแบรนด์แน่นอน      ContentBoxPremium
//    2 H2  เกมคาสิโน MIRACLE55 สนุกทุกค่าย ปลอดภัย ตลอดทั้งการเดิมพัน100%    ContentBox3ThreePremium
//    3 H2  สมาชิก MIRACLE55 รับการอัปเดตโปรโมชั่นก่อนใครตลอดทั้งเดือน         ContentBoxCyberCut
//    4 H3  แนะนำเพื่อน โบนัส 0.8%                                      ContentBoxSevenThreePremium + slide2
//    5 H3  คืนยอดเสีย โบนัส 0.3%                                       ContentBoxSevenThree (plain) + slide1
//    6 H2  สมัคร MIRACLE55 รับโปรโมชั่นจัดเต็มได้ทุกวัน แค่ 3 ขั้นตอน          ContentBoxTwoPremium (intro + <ol>)
//    7 H2  ติดต่อเจ้าหน้าที่ MIRACLE55 ผ่านไลน์แอด 24 ชั่วโมง                 ContentBoxTwoNeumorphism
//    8 H2  คำถามที่พบบ่อย                                              Faq4
// Final inventory for this page: h1 x1, h2 x5, h3 x2.
//
// Every docx paragraph ships in full. The one place a paragraph is split is item
// 2, whose single brief paragraph fills the three columns in order — reading the
// columns left, centre, right reproduces that sentence word for word.
//
// Vocabulary: this brief says ไลน์แอด, never "LINE OFFICIAL" (KINGDOM66's word),
// and never เครดิตฟรี / บาคาร่า / หวย / บอล — MIRACLE55 is a คาสิโนฐานหลัก brand.

// One array, used by both <Faq> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last. The three pairs
// are the brief's own Q/A block, verbatim.
const faqs = [
  {
    q: "MIRACLE55 มีเกมคาสิโนจากค่ายไหนให้เลือกบ้าง?",
    a: "ภายในระบบมีเกมคาสิโนจากหลายค่ายตามรายการที่เว็บไซต์เปิดให้บริการ ทั้งเกมสด เกมโต๊ะ และหมวดเกมยอดนิยม สมาชิกสามารถตรวจสอบค่ายและรายละเอียดของแต่ละเกมได้จากหน้ารวมเกมก่อนเข้าใช้งาน",
  },
  {
    q: "MIRACLE55 มีโปรโมชั่นอะไรสำหรับสมาชิกบ้าง?",
    a: "โปรโมชั่นหลักตามข้อมูลที่กำหนดมีโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% โดยรายละเอียดและเงื่อนไขของแต่ละรายการอาจแตกต่างกัน ควรตรวจสอบหน้าโปรโมชั่นก่อนกดรับสิทธิ์ทุกครั้ง",
  },
  {
    q: "ติดต่อแอดมิน MIRACLE55 ได้ตลอด 24 ชั่วโมงหรือไม่?",
    a: "สามารถติดต่อเจ้าหน้าที่ผ่านไลน์แอดได้ตลอด 24 ชั่วโมง เพื่อสอบถามเรื่องบัญชี โปรโมชั่น ทางเข้าเกม หรือปัญหาการใช้งาน โดยทีมงานจะช่วยตรวจสอบข้อมูลตามรายละเอียดที่แจ้งเข้ามา",
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// One highlight colour only: chrome #fcfcfc against the body colour #e8e6e1, so
// the brand gold stays the page's structural accent and the paragraphs never
// compete with a heading for it.

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb. Every URL in the graph is derived
// by pageGraph from `site:` — no domain is typed out in this file, and no
// Review / AggregateRating / sameAs / address node is passed.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxPremium as="h1" title="MIRACLE55 คาสิโนฐานหลัก เล่นผ่านบริษัทตรง ครบทุกแบรนด์แน่นอน">
    <p class="text-left text-base leading-relaxed text-[#e8e6e1]">
      MIRACLE55
      <strong class="text-[#fcfcfc]">คาสิโนฐานหลักที่รวมเกมจากหลายแบรนด์ไว้ในระบบเดียว</strong>
      พร้อมรูปแบบการเข้าเล่นผ่านระบบบริษัทตรงตามข้อมูลของเว็บไซต์ สมาชิกสามารถเลือกเกมที่สนใจได้จากหลายค่าย ทั้งคาสิโนสดและเกมรูปแบบอื่น
      <strong class="text-[#fcfcfc]">พร้อมเมนูที่จัดไว้ชัดเจน รองรับการใช้งานผ่านมือถือและคอมพิวเตอร์ได้สะดวก</strong>
    </p>
  </ContentBoxPremium>

  <ContentBox3ThreePremium
    as="h2"
    title="เกมคาสิโน MIRACLE55 สนุกทุกค่าย ปลอดภัย ตลอดทั้งการเดิมพัน100%"
    heading={false}
    titleleft="ตัวเลือกจากหลายค่าย"
    titlecenter="ค้นหาและตรวจสอบง่าย"
    titleright="จัดการผ่านระบบเดียว">
    <p slot="left" class="text-left text-base leading-relaxed text-[#e8e6e1]">
      เกมคาสิโน MIRACLE55
      <strong class="text-[#fcfcfc]">มีตัวเลือกจากหลายค่ายและหลายรูปแบบ</strong>
      ทั้งเกมสด เกมโต๊ะ และหมวดที่ได้รับความนิยม
    </p>
    <p slot="center" class="text-left text-base leading-relaxed text-[#e8e6e1]">
      <strong class="text-[#fcfcfc]">ระบบจัดแยกแต่ละค่ายให้ค้นหาได้ง่าย</strong>
      พร้อมรายละเอียดเกมก่อนเข้าใช้งาน
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#e8e6e1]">ช่วยให้สมาชิกเลือกประเภทที่เหมาะกับตัวเองและจัดการบัญชีผ่านระบบเดียวได้สะดวกมากขึ้น</p>
  </ContentBox3ThreePremium>

  <ContentBoxCyberCut as="h2" title="สมาชิก MIRACLE55 รับการอัปเดตโปรโมชั่นก่อนใครตลอดทั้งเดือน">
    <p class="text-left text-base leading-relaxed text-[#e8e6e1]">
      สมาชิก MIRACLE55
      <strong class="text-[#fcfcfc]">สามารถตรวจสอบโปรโมชั่นที่อัปเดตตามช่วงเวลาผ่านหน้าเว็บไซต์ได้ตลอดทั้งเดือน</strong>
      <strong class="text-[#fcfcfc]">โดยมีทั้งโบนัสแนะนำเพื่อนและโบนัสคืนยอดเสีย</strong>
      พร้อมรายละเอียดของยอดที่เข้าเงื่อนไขและวิธีรับสิทธิ์
      <strong class="text-[#fcfcfc]">ช่วยให้ติดตามโปรโมชั่นที่เปิดให้ใช้งานได้ง่ายและไม่พลาดสิทธิ์สำคัญ</strong>
    </p>
  </ContentBoxCyberCut>

  <ContentBoxSevenThreePremium as="h3" title="แนะนำเพื่อน โบนัส 0.8%">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[340, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), 340px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นพื้นดำ-ทอง มุมซ้ายบนเป็นโลโก้ MIRACLE55 ตัวอักษรทองสลับเงินโครเมียม ถัดลงมาเป็นตัวอักษรไทยสีทองว่า โปรโมชั่น แนะนำเพื่อน และป้ายสีทองด้านล่างเขียนว่า โบนัส 0.8% ด้านขวาเป็นหญิงสาวผมยาวสีเข้มสวมเบลเซอร์สีขาว ยิ้มและยื่นสองมือเสนอโปรโมชั่น มุมซ้ายล่างมีชิปคาสิโนสีดำขอบทอง มุมขวาบนมีไพ่เอซพิมพ์ลายทอง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#d9a62b]/55 shadow-[0_10px_30px_rgba(252,218,101,0.3)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#e8e6e1]">
      สมาชิก MIRACLE55
      <strong class="text-[#fcfcfc]">ที่แนะนำเพื่อนเข้ามาสมัครสามารถรับโบนัส 0.8% ตามเงื่อนไขของโปรโมชั่น</strong>
      ระบบมีรายละเอียดเกี่ยวกับยอดที่เข้าเกณฑ์และวิธีรับสิทธิ์ให้ตรวจสอบ
      <strong class="text-[#fcfcfc]">ช่วยให้ติดตามโบนัสจากกิจกรรมแนะนำเพื่อนได้สะดวกผ่านบัญชีสมาชิก</strong>
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBoxSevenThree as="h3" title="คืนยอดเสีย โบนัส 0.3%">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[340, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), 352px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นชุดเดียวกันพื้นดำ-ทอง ด้านบนกลางภาพเป็นโลโก้ MIRACLE55 พร้อมมงกุฎทองดวงเล็ก ถัดลงมาเป็นตัวอักษรไทยสีทองว่า โปรโมชั่น คืนยอดเสีย และตัวเลขทองขนาดใหญ่ว่า โบนัส 0.3% ด้านซ้ายเป็นหญิงสาวสวมเบลเซอร์สีขาว ยิ้มและชี้มือขึ้นไปที่ข้อความ รอบขอบภาพมีชิปคาสิโนสีดำขอบทอง เหรียญทอง และไพ่โพดำเอซกระจายอยู่"
      class="mx-auto h-auto w-full rounded-2xl border border-[#d2d3d4]/35 shadow-[0_10px_30px_rgba(5,4,3,0.85)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#e8e6e1]">
      <strong class="text-[#fcfcfc]">โปรโมชั่นคืนยอดเสีย MIRACLE55 ให้โบนัส 0.3% ตามยอดและเงื่อนไขที่ระบบกำหนด</strong>
      สมาชิกสามารถตรวจสอบรอบคำนวณ ยอดที่เข้าเกณฑ์ และรายละเอียดก่อนกดรับสิทธิ์
      <strong class="text-[#fcfcfc]">ช่วยให้ติดตามโบนัสในแต่ละรอบได้ง่ายและรู้ข้อมูลก่อนนำสิทธิ์ไปใช้งาน</strong>
    </p>
  </ContentBoxSevenThree>

  <ContentBoxTwoPremium as="h2" title="สมัคร MIRACLE55 รับโปรโมชั่นจัดเต็มได้ทุกวัน แค่ 3 ขั้นตอน" titleleft="รายละเอียดการสมัคร" titleright="3 ขั้นตอนหลัก">
    <p slot="left" class="text-left text-base leading-relaxed text-[#e8e6e1]">
      <strong class="text-[#fcfcfc]">การสมัคร MIRACLE55 สามารถทำผ่านหน้าเว็บไซต์ได้ด้วยตัวเอง</strong>
      ขั้นตอนไม่ซับซ้อน หลังจากยืนยันบัญชีเรียบร้อยสามารถเข้าสู่ระบบเพื่อเลือกเกมและตรวจสอบโปรโมชั่นที่เปิดให้รับในแต่ละวันได้
      <strong class="text-[#fcfcfc]">โดยมีขั้นตอนหลักเพียง 3 ขั้นตอนดังนี้</strong>
    </p>
    <ol slot="right" class="flex list-decimal flex-col gap-4 pl-6 text-left text-base leading-relaxed text-[#e8e6e1] marker:font-black marker:text-[#fcda65]">
      <li>เปิดหน้าสมัคร MIRACLE55 แล้วกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน</li>
      <li>ตรวจสอบข้อมูลส่วนตัวและรายละเอียดบัญชีให้ถูกต้องก่อนกดยืนยัน</li>
      <li>ยืนยันการสมัครและเข้าสู่ระบบ จากนั้นเลือกเกมและตรวจสอบโปรโมชั่นที่เปิดให้สมาชิกได้ทันที</li>
    </ol>
  </ContentBoxTwoPremium>

  <ContentBoxTwoNeumorphism as="h2" title="ติดต่อเจ้าหน้าที่ MIRACLE55 ผ่านไลน์แอด 24 ชั่วโมง" titleleft="รายละเอียดการติดต่อ" titleright="ช่องทางติดต่อด่วน">
    <p slot="left" class="text-left text-base leading-relaxed text-[#e8e6e1]">
      หากมีข้อสงสัยเกี่ยวกับการสมัคร โปรโมชั่น ทางเข้าเกม หรือการใช้งานบัญชี
      <strong class="text-[#fcfcfc]">สามารถติดต่อเจ้าหน้าที่ MIRACLE55 ผ่านไลน์แอดได้ตลอด 24 ชั่วโมง</strong>
      ทีมงานพร้อมช่วยให้ข้อมูลเกี่ยวกับเกม โปรโมชั่น และขั้นตอนต่าง ๆ ภายในเว็บไซต์
