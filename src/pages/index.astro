---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import LatestWinners from "../components/LatestWinnersPremium.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBox3ThreePremium from "../components/ContentBox3ThreePremium.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import Faq from "../components/Faq4.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import { pageGraph } from "../lib/schema";
import imgCashback from "../assets/slide2.png";
import imgReferral from "../assets/slide1.png";

// VARIANT ROTATION THIS ROUND (brand-spec §3 — locked there, not re-chosen
// here). Every family moves off the outgoing UFA324 pick: Announcement5 replaces
// Announcement2, LatestWinnersPremium replaces LatestWinners4, Faq4 replaces
// Faq3, ReviewCardSumo2 replaces the base ReviewCardSumo, and the ContentBox
// shape-mix leaves CyberCut / TwoPremium / SevenThreePremium /
// SevenThreeCyberCut / Special / TwoFloatingBadge behind for Premium /
// TwoNeumorphism / SevenThreeNeumorphism / SevenThree / 3ThreePremium /
// TwoCyberCut. NavbarPremium + FooterPremium are the layout's pair this round
// (previously NavbarStyle6 / FooterStyle3) and the brand font moves kanit ->
// google-sans; all three are the orchestrator's shared-chrome step, not this
// page's.
// Plain ContentBox is the one sanctioned carry-over: it is the always-live box
// that terms, privacy, 404 and the button pages render through, so it cannot
// follow a rotation. Section 3 is the single docx section it carries here.
// ContentBoxTwo is also still live but is NOT imported here — it is reached only
// through LoginRtpSection, so an "is it used?" grep has to match the bare
// filename, not "components/ContentBoxTwo.astro".
// Every unused *Premium / *Cyber / *Huay / *Neumorphism / Style file, the other
// Faq* and Announcement* siblings, the base ReviewCardSumo and the other
// LatestWinners* stay on disk as inventory for the next brand — none was
// deleted, and the previous brands' champion gold, chrome silver, hot pink and
// emerald still inside them are expected drift, not a bug.
//
// <Announcement /> runs bare on purpose: Announcement5's default message is
// already this brand's copy, set by the orchestrator from this brief, and every
// sub-page calls it bare too — so passing an override here is exactly how the
// ticker ends up saying two different things on two pages of the same site.
//
// PALETTE OF THIS BRAND (brand-spec §2) — TIGER GOLD ON PURE BLACK. Read off the
// artwork: a gold tiger's head in a gold crown at the centre of a black-and-gold
// casino medallion, bright gold 3-D lettering, gold aces, gold chips. This is a
// SINGLE-FAMILY palette in two levels: TIGER AMBER #d98324 leads (the tiger's
// fur, the medallion rim, the banner lettering) and BRIGHT GOLD #f7b733 is the
// second level (the face of the 3-D TIGERWIN369 type, the crown). The page
// background is PURE BLACK (bg.json = {"mode":"color","color":"#000000"}).
// ⚠️ CONSEQUENCE: nothing can sink below the page. Every surface must be
// LIGHTER than #000000 — #2d1c0a raised / #1c1206 mid / #0f0903 sunken is the
// floor, and it is a WARM BROWN ramp, not last round's olive one.
// ⚠️ THE TRAP: this is the EIGHTH gold brand in ten rounds, so "there is already
// gold here" proves nothing — compare by VALUE, never by family. Our #d98324 is
// deliberately more orange than every predecessor (G=131 vs UFA324's #e5a81b at
// 168 and UOK365's #c8912f at 145). The outgoing brand's full set (#e5a81b
// #b9c2cc #231c0e #17130a #0d0b06 #f0e8d4 #ffcf5e #ffe08a #7d5a07 #43300a
// #464f5a #140d01 #0b0f14) is gone from every file this page renders, as are
// NAZA99's (#e4b34d #fdf2ac #c08f2b), FLASH877's #ffdd73 and the
// DUCK1688/NAZA168/WEPLAY168 set (#f3bb34 #fde464 #fbc134 #fbe455 #ffd23d
// #cfd6e3). UFA324 was a GOLD-AND-SILVER pair; this brand has NO silver, NO
// grey, NO chrome and no cool hue at all — and no pink, purple, red, green or
// blue anywhere.
// Body copy is #f7e4c0 (= BRAND_TEXT), 13.3:1 on the raised surface and 16.8:1
// on pure black. Highlights below are #ffd98a, which §2 pins to exactly this one
// job (12.3:1 on the raised surface) — unlike #d98324, which is the
// border/accent/heading amber, unlike #f7b733, which is the gradient bright end
// and the hover colour, and unlike #e3cfae, which is muted secondary text.
// #8a5214 and #4a2a08 never carry text at any size; #1a0d02 is the only ink
// allowed on a gold fill.
//
// IMAGE ROLES FOR THIS DROP (2026-10-11, brand-spec §4). Two files are
// referenced from this page and only two, and each pairing is read off the
// artwork itself — the percentage printed ON the slide has to match the heading
// the block carries, or the picture contradicts the section above it:
//   slide2.png — square 600x600. The gold-suited pair either side of the tiger
//     medallion, gold aces and a gold spade in the corners, gold chips and dice
//     along the bottom. Across the middle โปรโมชั่น in huge 3-D gold type and,
//     on a dark gold-edged plate below it, คืนยอดเสีย 0.3%. The artwork prints
//     the offer itself, so it belongs to docx H3 §4. Imported as imgCashback.
//   slide1.png — the companion square. Same pair, same medallion, gold aces at
//     the upper corners and a tall gold spade lower-left. Across the middle
//     โปรโมชั่น in the same 3-D gold type and, on a dark gold-edged plate below
//     it, แนะนำเพื่อน โบนัส 0.8%. It belongs to docx H3 §5. Imported as
//     imgReferral.
// Both slides are 600x600 on disk, so 600 is the top real candidate — nothing
// above it would be a real pixel — and each picture carries max-w-[600px] so the
// art is never upscaled past its own bitmap.
// Each slide sits in a ContentBoxSevenThree* image+text block, which is that
// family's hard cap of two per rebrand, so there is no third SevenThree anywhere
// on the site and no slide appears outside those two blocks.
// Both blocks lay out md:grid-cols-[7fr_3fr] with the TEXT column first, so each
// picture goes in slot="right": the heading always lands on the prose, never on
// the picture, and on a phone the single column reads heading, text, picture
// rather than opening with an image. Each `sizes` therefore describes its own
// 3fr column rather than the viewport. The two figures below were RECOMPUTED
// from the two variants THIS brand picked — they are not last round's numbers,
// because SevenThreeNeumorphism caps at max-w-7xl and pays a flat p-8 while the
// base SevenThree caps at max-w-[1400px] and pays md:p-10:
//   ContentBoxSevenThreeNeumorphism (section 4): section max-w-7xl(1280) +
//     px-4(32), card border(2) + p-8(64) + gap-8(32), image column
//     md:border-l(1) + md:pl-8(32) = 33
//       >= 1280px : (1280 - 32 - 2 - 64 - 32) x 0.3 - 33 = 345 - 33   = 312px
//       md..1279  : (100vw - 130) x 0.3 - 33             = calc(30vw - 72px)
//       698..767  : one column at p-8 exceeds the 600px bitmap, so
//                   max-w-[600px] binds                              = 600px
//       < 698     : one column at p-8                    = calc(100vw - 98px)
//   ContentBoxSevenThree (section 5): section max-w-[1400px] + px-4(32), card
//     border(2) + md:p-10(80) + gap-8(32), image column md:pl-6(24) only — its
//     md:border-r + md:pr-6 sit on the TEXT column and come out of THAT track
//       >= 1400px : (1400 - 32 - 2 - 80 - 32) x 0.3 - 24 = 376.2 - 24 = 352px
//       md..1399  : (100vw - 146) x 0.3 - 24             = calc(30vw - 68px)
//       698..767  : capped by max-w-[600px]                          = 600px
//       < 698     : one column at p-8 (no md:p-10)       = calc(100vw - 98px)
// Neither is the LCP element — MainLayout's hero banner is — so both are
// loading="lazy" fetchpriority="low" decoding="async" and neither takes
// fetchpriority="high". formats/fallbackFormat/quality stay at the house values:
// tools/avif-quality-service.mjs rescales AVIF quality on its own, so
// quality={80} must not be hand-tuned per format.
//
// The alt text was written from THIS drop's artwork (brand-spec §4), not carried
// over: the set is a GOLD-AND-BLACK CASINO scene — a crowned tiger medallion,
// gold card aces, a gold spade, gold chips and dice, a black-and-gold roulette
// wheel, and a man and a woman in black suits. It is NOT UFA324's night-stadium
// set (no football, no trophy, no stadium), not FAH999's hot-pink bunny-girl
// scene, not DUCK1688's crowned duck, and not LOTTOPLUS's lottery posters.
//
// Deliberately NOT imported, and every file still on disk:
//   banner2.png (10-08) is แตกดี168's "รีวิวถอนจริง" banner, banner3.png (09-27)
//   is older still, and slide3.png / slide4.png (09-29) are LOTTOPLUS's lottery
//   posters — all previous brands' artwork. Importing any of them emits a
//   competitor's picture into dist/ (an eager import IS an emit, rendered or
//   not) and turns verify-build red. There is therefore NO current-drop article
//   illustration this round, and a slide is not substituted for one.
//   banner1.png and banner1-mobile.png belong to MainLayout's own pinned globs
//   and are never referenced from a page. og.png is the same: MainLayout owns it.
// Also deliberately unused (named without the file extension on purpose — the
// playbook's "is this component live?" check is a bare-filename grep, and a
// mention here would read as a render): ProviderGrid and GameRankingBoard have
// nothing to carry because the brief names no game studio and no ranking;
// SmoothCarousel has no brief section asking for a carousel; BankStrip already
// renders inside the active footer; and FeatureHighlights has nothing to carry
// either, because section 6's three steps are running prose in the brief rather
// than a labelled sub-list — they go in ContentBox3ThreePremium's three columns,
// whose titleleft/titlecenter/titleright render as <p> with its `heading` prop
// left false, so the steps never become <h3>.
//
// Vocabulary (brand-spec §7): this brand is a เกมคาสิโนรวม — บาคาร่า, สล็อต,
// บอลออนไลน์, ไฮโล, ยิงปลา. It is NOT slot-only, NOT a sports-only book and NOT
// a lottery site. The words this page may use are the brief's own:
// เกมคาสิโนรวม, เดิมพันไม่มีขั้นต่ำ, ครบวงจร, บาคาร่า, สล็อต, บอลออนไลน์, ไฮโล,
// ยิงปลา, เว็บดังของแท้ในตำนาน, เบทต่ำ, ทุนน้อย, หมวดเกม, ฟรีสปิน, ฟีเจอร์โบนัส,
// เกมไพ่, คู่แข่งขัน, อัตราต่อรอง, ลูกเต๋า, เกมโต๊ะ, กติกา, ตารางจ่าย,
// ช่วงเดิมพัน, คืนยอดเสีย 0.3%, เข้ายูสทุกวัน, รอบคำนวณ, เวลาตัดยอด,
// ยอดที่เข้าเกณฑ์, แนะนำเพื่อน, โบนัส 0.8%, ไม่จำกัด, ลิงก์แนะนำ,
// สมัครสมาชิก 3 ขั้นตอน, ยืนยันบัญชี, แอดมิน 24 ชั่วโมง, ช่องทางติดต่อหลัก,
// หมายเลขรายการ, PIN, OTP.
// ⚠️ บอลออนไลน์ and คู่แข่งขัน ARE this brief's own words (lines 6 and 24) and
// ship normally — §7's ban on UFA324 covers its SPORTS-BRAND FRAMING
// (เว็บเล่นเกมกีฬาออนไลน์, ทางเข้าเดิมพัน, ฐานเกมแท้, จ่ายตรง, ไม่บิทยูส,
// ไม่ผ่าน บช. ม้า, มวย, เว็บตรงในตำนาน), not those two nouns. That framing is
// gone from this page, as is every older brand's set (ฟาสล็อตเว็บตรง,
// เล่นสล็อตระบบแท้, แตกง่ายทุกเกม, เว็บสล็อตนาซ่า, เว็บเป็ด, ส่งตรงจากเมกา,
// ฐานเกมหลัก 100%, เครือหลัก, ไม่ผ่านเอเย่นต์, เดิมพันเริ่มต้น 1 บาท,
// ทุนน้อยกำไรงาม, ดับเบิ้ลโบนัส, การันตีเว็บแท้, จ่ายไว, ค่ายตรง,
// ส่งตรงจากเว็บแม่, เว็บตรงฐานสล็อตหลัก, รีวิวถอนจริง, ถูกลิขสิทธิ์, ไฮคลาส,
// VIP) — the page is written straight from the brief rather than
// find-and-replaced over the old sentences. There is NO หวย / โพย / เลขเด็ด /
// งวด / แนวทาง / ตรวจหวย / อัตราจ่ายหวย / 3 ตัว / 2 ตัว anywhere on this site
// this round: it is a casino brand, and /ตรวจหวย and /แนวทาง stay parked in
// src/pages-disabled/.
// Nothing here claims a licence, a regulator, an operator, a game studio, a
// bank, a league, a team, an RTP figure, a deposit minimum, a member count or a
// founding year, because the brief names none. The only figures are the brief's
// own: 0.3%, 0.8%, 3 ขั้นตอน and 24 ชั่วโมง.
// The brief's own hedging ships with the copy — it hedges seven separate times
// (ควรตรวจสอบรายละเอียดในระบบก่อนทำรายการ · จำนวนเกมขึ้นอยู่กับระบบ ·
// ความนิยมและความน่าเชื่อถือไม่สามารถยืนยันจากข้อความโฆษณาเพียงอย่างเดียว ·
// ควรตรวจสอบข้อกำหนดของแต่ละเกม เนื่องจากอาจมีวงเงินเริ่มต้นไม่เท่ากัน ·
// คำว่าไม่จำกัดควรระบุให้ชัด · ควรตรวจสอบชื่อโดเมนและข้อกำหนดก่อนส่งข้อมูล
// ส่วนตัว · ไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP) and every one of those clauses
// is part of its paragraph, not trimmed as downbeat filler.
//
// The brief, every piece of artwork in the drop and the operator's prompt all
// agree on the brand name — no conflict this round. Even so the name is never
// typed on the page: it is interpolated from ${BRAND_NAME} so it can never drift
// from brandProfile. No domain is written out anywhere here — note the real
// domain has a dash and a .net TLD (brand-spec §1) that the brand name does not,
// which is exactly the kind of thing a hand-typed URL gets wrong.
//
// Title and description are the brief's own Title/Description lines
// (content.txt lines 1-2), used verbatim and NOT padded up to 150 characters —
// verify-build deliberately skips its 150-character floor on the home page for
// exactly this reason. Both strings are byte-identical to the defaults the
// orchestrator set in MainLayout.astro, which is what makes passing them here a
// no-op rather than a second source of truth.
const pageTitle = `${BRAND_NAME} เกมคาสิโนรวม บาคาร่า สล็อต บอลออนไลน์ เว็บดังของแท้`;

const pageDescription = `${BRAND_NAME} เกมคาสิโนรวม เดิมพันไม่มีขั้นต่ำ ครบวงจร บาคาร่า สล็อต บอลออนไลน์ ไฮโล ยิงปลา เบทต่ำ ทุนน้อย เว็บดังของแท้ในตำนาน`;

// The brief has a real H2 -> H3 nesting this round, so the page is NOT flattened
// to H2-only. The two H3s are the docx's own H3 lines — the two promotion
// sub-points that sit under section 3's โปรโมชั่น H2 in the brief's own outline.
// There is no FeatureHighlights H3 exception this round.
//
// The checklist, in document order, and what carries each one (brand-spec §5):
//    1 H1  ${BRAND_NAME} เกมคาสิโนรวม เดิมพันไม่มีขั้นต่ำ ครบวงจร
//          ContentBoxPremium, brief paragraph on line 4
//    2 H2  ${BRAND_NAME} บาคาร่า สล็อต บอลออนไลน์ ไฮโล ยิงปลา เว็บดังของแท้ในตำนาน
//          ContentBoxTwoNeumorphism, line 6 left / line 7 right
//    3 H2  โปรโมชั่นเดิมพัน ${BRAND_NAME} เว็บพนันคาสิโนแท้ในตำนาน
//          ContentBox (the plain, always-live variant), line 9
//    4 H3  โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสทุกวัน
//          ContentBoxSevenThreeNeumorphism + slide2 (imgCashback), line 11
//    5 H3  โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด
//          ContentBoxSevenThree + slide1 (imgReferral), line 13
//    6 H2  สมัครเล่น ${BRAND_NAME} ง่ายๆ 3 ขั้นตอน
//          ContentBox3ThreePremium, line 15 as the intro slot and lines 16/17/18
//          as the three columns
//    7 H2  แอดมิน ${BRAND_NAME} คอยให้บริการ 24 ชั่วโมง
//          ContentBoxTwoCyberCut, line 20 left / line 21 right
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ ${BRAND_NAME}
//          Faq4 + faqs prop, lines 23-28
// Final inventory for this page: h1 x1, h2 x5, h3 x2.
//
// SHAPE RHYTHM, top to bottom — no two adjacent sections read as the same card,
// and each neighbour pair differs in at least two of {corner, surface depth,
// heading treatment}:
//   §1 rounded-3xl, RAISED #2d1c0a graded down to MID #1c1206, heading gradient
//      bright -> pale -> amber behind a vertical spine
//   §2 rounded-[25px] NEUMORPHIC on RAISED #2d1c0a (dark #0f0903 / light
//      #8a5214, hover light climbs to #d98324), heading gradient
//      amber -> bright -> pale
//   §3 rounded-3xl FLAT on RAISED #2d1c0a with an underline rule, heading
//      gradient pale -> bright -> amber (the always-live box; its treatment is
//      fixed by the orchestrator)
//   §4 rounded-[25px] NEUMORPHIC on MID #1c1206 (dark #0f0903 / light #4a2a08,
//      hover light climbs only to #8a5214 — the opposite end from §2), heading
//      SOLID bright gold, picture right
//   §5 CLIPPED corners (36px) on SUNKEN #0f0903 with a bright-gold hairline
//      along the top edge, heading SOLID amber behind a three-stop spine that
//      runs bright -> amber -> deep (§4's is solid bright gold with no spine at
//      all), picture right
//   §6 rounded-3xl on RAISED #2d1c0a, heading gradient cream -> bright -> amber,
//      three columns whose step labels are <p>
//   §7 CLIPPED corners on MID #1c1206, corner rules in amber/pale pairs, heading
//      gradient amber -> pale -> bright
//   §8 rounded accordion rows on SUNKEN #0f0903 with an amber left rail, heading
//      gradient bright -> amber -> pale
// The two neumorphic plates (§2, §4) sit on different surfaces and climb to
// different hover extremes; the two clipped cards (§5, §7) sit at opposite ends
// of the depth ramp and are separated by §6; and every card's heading gradient
// runs a different order of the same four golds, so no two read as one card.
//
// ContentBoxSevenThreeNeumorphism and ContentBoxSevenThree both take the docx
// heading through `title`, which falls back to their wide (7fr) LEFT text
// column; neither is passed a `titleright`, so each block emits exactly one
// heading and the picture column never carries one.
//
// Every brief paragraph ships in full — all eleven of them, nothing merged or
// summarised, plus the three FAQ answers. Sections 2 and 7 have two paragraphs
// each and both run one paragraph per column; section 6 runs its intro paragraph
// in the default slot and its three step paragraphs one per column; sections 1,
// 3, 4 and 5 have one paragraph each. No slot on this page receives two
// siblings, so no wrapper <div> is needed anywhere this round.
// The column labels passed to ContentBoxTwoNeumorphism and ContentBoxTwoCyberCut
// are this page's own layout wording, not brief headings, and both variants
// render them as <p>. The three labels passed to ContentBox3ThreePremium are the
// brief's own "ขั้นตอนที่ N" openers, but the brief writes them as running prose
// rather than as headings, so `heading` stays false and they render as <p> too.
//
// Everything else on the page is chrome and emits no heading tag at any level:
// Announcement5, LatestWinnersPremium, LoginRtpSection and ReviewCardSumo2
// render their titles as <p>/<span> with an aria-label on the section, and
// Faq4's questions live inside <summary> as <span>. The non-brief widgets sit
// before section 1 (the ticker, then the winners feed) and after section 8
// (LoginRtpSection, ReviewCardSumo2, Navfoot) — never spliced between two
// content sections.

// One array, used by both <Faq> and the FAQPage node — never the component's own
// defaults (Faq4 deliberately ships an empty list, so a forgotten prop renders
// an empty accordion rather than some previous brand's questions). The three
// pairs are the brief's own Q/A block (content.txt lines 23-28), verbatim.
const faqs = [
  {
    q: `${BRAND_NAME} มีเกมคาสิโนประเภทใดให้เลือกบ้าง?`,
    a: `${BRAND_NAME} นำเสนอเกมหลายประเภท ได้แก่ บาคาร่า สล็อต บอลออนไลน์ ไฮโล และยิงปลา โดยจำนวนเกมและค่ายที่เปิดให้บริการจริงขึ้นอยู่กับระบบ สมาชิกควรตรวจสอบกติกาและช่วงเดิมพันของแต่ละรายการก่อนเริ่มเล่น`,
  },
  {
    q: `${BRAND_NAME} มีโปรโมชั่นอะไรสำหรับสมาชิก?`,
    a: `โปรโมชั่นหลักตามข้อมูลที่กำหนดมี คืนยอดเสีย 0.3% และ แนะนำเพื่อน 0.8% โดยแต่ละรายการมีวิธีคำนวณ รอบรับสิทธิ์ และเงื่อนไขแตกต่างกัน ควรตรวจสอบรายละเอียดล่าสุดจากหน้าโปรโมชั่นก่อนกดรับโบนัส`,
  },
  {
    q: `สมัครสมาชิก ${BRAND_NAME} อย่างไร และติดต่อแอดมินได้ตอนไหน?`,
    a: `การสมัครแบ่งเป็น 3 ขั้นตอน ได้แก่ เข้าหน้าสมัคร กรอกข้อมูลบัญชี และยืนยันการสมัครตามระบบที่กำหนด ส่วนแอดมินระบุว่าเปิดให้บริการตลอด 24 ชั่วโมง โดยควรตรวจสอบช่องทางติดต่อหลักและเวลาตอบกลับจริงจากหน้าเว็บไซต์`,
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// No two <strong> elements are adjacent either: every pair is separated by at
// least one run of plain text, so the whitespace between them can never collapse
// into a missing space.
// One highlight colour only: #ffd98a, against the inherited body colour #f7e4c0
// (BRAND_TEXT). The paragraphs below carry no colour class of their own: every
// ContentBox* card in this mix already sets
// `text-left text-base leading-relaxed text-[#f7e4c0]` on the element holding
// the slot, so the prose inherits it and no page-level override can drift from
// the card. No paragraph carries mx-auto or max-w-* either — the cards cap their
// own width, and the only max-w-* on the page is the one capping each slide,
// which is an image and not prose.

// No breadcrumb: this is the homepage, so a trail from the root to itself would
// be a single self-referential crumb. Every URL in the graph is derived by
// pageGraph from `site:` — no domain is typed out in this file, no URL is built
// with `+`, and no Review / AggregateRating / sameAs / address / email node is
// passed. `description` is the exact same string MainLayout gets, and `faqs` is
// the exact same array <Faq> gets.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <LatestWinners />

  <ContentBoxPremium as="h1" title={`${BRAND_NAME} เกมคาสิโนรวม เดิมพันไม่มีขั้นต่ำ ครบวงจร`}>
    <p>
      {BRAND_NAME} เกมคาสิโนรวมที่นำเสนอทางเลือกการเดิมพันครบวงจรในแพลตฟอร์มเดียว
      <strong class="text-[#ffd98a]">ทั้งบาคาร่า สล็อต บอลออนไลน์ ไฮโล และเกมยิงปลา</strong>
      พร้อมหมวดเกมที่จัดเรียงให้ค้นหาได้สะดวก รองรับการใช้งานผ่านมือถือและคอมพิวเตอร์ เหมาะกับผู้ที่สนใจเกมหลายประเภทและต้องการตรวจสอบยอดเดิมพันก่อนเริ่มเล่น โดยแต่ละเกมมีเงื่อนไขและยอดขั้นต่ำแตกต่างกัน
      <strong class="text-[#ffd98a]">จึงควรตรวจสอบรายละเอียดในระบบก่อนทำรายการ</strong>
    </p>
  </ContentBoxPremium>

  <ContentBoxTwoNeumorphism
    as="h2"
    title={`${BRAND_NAME} บาคาร่า สล็อต บอลออนไลน์ ไฮโล ยิงปลา เว็บดังของแท้ในตำนาน`}
    titleleft="หมวดเกมที่รวบรวมไว้"
    titleright="ก่อนเชื่อภาพลักษณ์">
    <p slot="left">
      {BRAND_NAME} รวบรวมเกมคาสิโนหลายแนวไว้ให้เลือกตามความสนใจ
      <strong class="text-[#ffd98a]">ไม่ว่าจะเป็นบาคาร่าเกมไพ่ยอดนิยม สล็อตที่มีทั้งฟรีสปินและฟีเจอร์โบนัส</strong>
      บอลออนไลน์ที่แสดงคู่แข่งขันพร้อมอัตราต่อรอง ไฮโลที่ใช้ผลจากลูกเต๋า หรือเกมยิงปลาที่มีรูปแบบการเล่นแตกต่างจากเกมโต๊ะทั่วไป
      <strong class="text-[#ffd98a]">สมาชิกสามารถศึกษากติกา ตารางจ่าย และช่วงเดิมพันของแต่ละประเภทก่อนตัดสินใจเล่นได้</strong>
    </p>
    <p slot="right">
      สำหรับภาพลักษณ์ เว็บดังของแท้ในตำนาน ควรมีข้อมูลประวัติการเปิดให้บริการ รายชื่อผู้ให้บริการเกม และรายละเอียดผู้ดำเนินงานที่ตรวจสอบได้ประกอบ
      <strong class="text-[#ffd98a]">เพราะความนิยมและความน่าเชื่อถือไม่สามารถยืนยันจากข้อความโฆษณาเพียงอย่างเดียว</strong>
      ส่วนการเดิมพันแบบเบทต่ำหรือไม่มีขั้นต่ำควรตรวจสอบข้อกำหนดของแต่ละเกม
      <strong class="text-[#ffd98a]">เนื่องจากอาจมีวงเงินเริ่มต้นไม่เท่ากัน</strong>
    </p>
  </ContentBoxTwoNeumorphism>

  <ContentBox as="h2" title={`โปรโมชั่นเดิมพัน ${BRAND_NAME} เว็บพนันคาสิโนแท้ในตำนาน`}>
    <p>
      โปรโมชั่นเดิมพัน {BRAND_NAME}
      <strong class="text-[#ffd98a]">นำเสนอสิทธิพิเศษสำหรับสมาชิกตามกิจกรรมที่เว็บไซต์กำหนด</strong>
      โดยมีทั้งรายการคืนยอดเสียและโบนัสแนะนำเพื่อน ผู้ใช้งานสามารถตรวจสอบยอดที่เข้าเกณฑ์ รอบคำนวณ และสถานะการรับสิทธิ์ผ่านบัญชีตามระบบที่เปิดให้บริการ
      <strong class="text-[#ffd98a]">ทั้งนี้ควรตรวจสอบว่าโปรโมชั่นครอบคลุมบาคาร่า สล็อต บอลออนไลน์ ไฮโล หรือยิงปลาประเภทใดบ้าง</strong>
      เพราะแต่ละกิจกรรมอาจกำหนดเงื่อนไขไม่เหมือนกัน
    </p>
  </ContentBox>

  <ContentBoxSevenThreeNeumorphism as="h3" title="โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสทุกวัน">
    <p slot="left">
      สมาชิก {BRAND_NAME} ที่มียอดเสียตรงตามเงื่อนไขสามารถตรวจสอบสิทธิ์รับ
      <strong class="text-[#ffd98a]">โบนัสคืนยอดเสีย 0.3% ตามรอบประจำวันที่เว็บไซต์กำหนด</strong>
      โดยคำนวณจากยอดที่เข้าเกณฑ์ของกิจกรรม หากระบบรองรับการโอนโบนัสเข้ายูสอัตโนมัติ สมาชิกสามารถตรวจสอบจำนวนโบนัสและประวัติการรับสิทธิ์ได้จากบัญชี
      <strong class="text-[#ffd98a]">ควรอ่านรายละเอียดเกมที่ร่วมรายการ เวลาตัดยอด และเงื่อนไขการใช้โบนัสก่อนรับทุกครั้ง</strong>
    </p>
    <Picture
      slot="right"
      src={imgCashback}
      loading="lazy"
      fetchpriority="low"
      widths={[312, 480, 600]}
      sizes="(max-width: 697px) calc(100vw - 98px), (max-width: 767px) 600px, (max-width: 1279px) calc(30vw - 72px), 312px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt={`ภาพโปรโมชั่นคืนยอดเสียของ ${BRAND_NAME} เป็นงานอาร์ตสี่เหลี่ยมจัตุรัสโทนทองสลับดำ กลางภาพด้านบนเป็นเหรียญตรากลมที่มีหัวเสือขนสีทองอำพันสวมมงกุฎทองอยู่กลางวงแหวนดำ ขนาบด้วยชายหนุ่มและหญิงสาวในชุดสูทดำคนละข้าง มุมภาพมีไพ่เอซทองและโพดำทอง ด้านล่างเป็นกองชิปคาสิโนทองกับลูกเต๋า กลางภาพเป็นคำว่า โปรโมชั่น ตัวอักษรทองสามมิติขนาดใหญ่ ถัดลงมาบนแผ่นป้ายสีเข้มขอบทองเป็นคำว่า คืนยอดเสีย คู่กับเลข 0.3%`}
      class="mx-auto h-auto w-full max-w-[600px] rounded-2xl border border-[#d98324]/55 shadow-[0_0_28px_rgba(217,131,36,0.3)]"
    />
  </ContentBoxSevenThreeNeumorphism>

  <ContentBoxSevenThree as="h3" title="โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด">
    <p slot="left">
      โปรโมชั่นแนะนำเพื่อน {BRAND_NAME}
      <strong class="text-[#ffd98a]">ระบุอัตราโบนัส 0.8% จากยอดที่เข้าเกณฑ์ตามข้อกำหนด</strong>
      สมาชิกสามารถตรวจสอบรายละเอียดลิงก์แนะนำ จำนวนเพื่อนที่สมัคร และวิธีคำนวณโบนัสผ่านระบบสมาชิก
      <strong class="text-[#ffd98a]">ส่วนคำว่าไม่จำกัดควรระบุให้ชัดว่าหมายถึงจำนวนเพื่อนที่แนะนำ จำนวนครั้งในการรับสิทธิ์ หรือยอดโบนัสสูงสุด</strong>
      เพื่อป้องกันความเข้าใจคลาดเคลื่อนเกี่ยวกับผลตอบแทน
    </p>
    <Picture
      slot="right"
      src={imgReferral}
      loading="lazy"
      fetchpriority="low"
      widths={[352, 480, 600]}
      sizes="(max-width: 697px) calc(100vw - 98px), (max-width: 767px) 600px, (max-width: 1399px) calc(30vw - 68px), 352px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt={`ภาพโปรโมชั่นแนะนำเพื่อนของ ${BRAND_NAME} เป็นงานอาร์ตสี่เหลี่ยมจัตุรัสชุดเดียวกัน โทนทองสลับดำ กลางภาพด้านบนเป็นเหรียญตรากลมหัวเสือขนทองอำพันสวมมงกุฎทอง ขนาบด้วยชายหนุ่มและหญิงสาวในชุดสูทดำคนละข้าง มุมบนทั้งสองข้างเป็นไพ่เอซทอง มุมล่างซ้ายเป็นโพดำทองทรงสูง กลางภาพเป็นคำว่า โปรโมชั่น ตัวอักษรทองสามมิติขนาดใหญ่ ถัดลงมาบนแผ่นป้ายสีเข้มขอบทองเป็นคำว่า แนะนำเพื่อน และคำว่า โบนัส คู่กับเลข 0.8%`}
      class="mx-auto h-auto w-full max-w-[600px] rounded-2xl border border-[#f7b733]/55 shadow-[0_0_28px_rgba(247,183,51,0.28)]"
    />
  </ContentBoxSevenThree>

  <ContentBox3ThreePremium
    as="h2"
    title={`สมัครเล่น ${BRAND_NAME} ง่ายๆ 3 ขั้นตอน`}
    titleleft="ขั้นตอนที่ 1 เข้าหน้าสมัครสมาชิก"
    titlecenter="ขั้นตอนที่ 2 กรอกข้อมูลบัญชี"
    titleright="ขั้นตอนที่ 3 ตรวจสอบและยืนยันการสมัคร">
    <p>
      การสมัครเล่น {BRAND_NAME} สามารถดำเนินการผ่านหน้าสมัครสมาชิกของเว็บไซต์ที่เปิดให้บริการ
      <strong class="text-[#ffd98a]">โดยเน้นขั้นตอนการกรอกข้อมูลและยืนยันบัญชีให้เข้าใจง่าย</strong>
      ผู้สมัครควรตรวจสอบชื่อโดเมน ข้อมูลผู้ดำเนินงาน และข้อกำหนดการใช้งานก่อนส่งข้อมูลส่วนตัว
      <strong class="text-[#ffd98a]">รวมถึงตรวจสอบอายุและข้อกฎหมายที่เกี่ยวข้องในพื้นที่ของตน</strong>
    </p>
    <p slot="left">
      เลือกเมนูสมัครจากช่องทางหลักของ {BRAND_NAME}
      <strong class="text-[#ffd98a]">พร้อมตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้องก่อนดำเนินการต่อ</strong>
    </p>
    <p slot="center">
      ระบุข้อมูลตามแบบฟอร์มที่ระบบกำหนด
      <strong class="text-[#ffd98a]">พร้อมตั้งรหัสผ่านที่คาดเดายากและไม่ใช้ซ้ำกับบัญชีอื่น</strong>
    </p>
    <p slot="right">
      ทบทวนข้อมูล อ่านเงื่อนไขให้ครบถ้วน และดำเนินการยืนยันบัญชีตามขั้นตอนที่เว็บไซต์กำหนด
      <strong class="text-[#ffd98a]">ก่อนเข้าสู่ระบบเพื่อดูหมวดเกมและรายละเอียดการใช้งาน</strong>
    </p>
  </ContentBox3ThreePremium>

  <ContentBoxTwoCyberCut
    as="h2"
    title={`แอดมิน ${BRAND_NAME} คอยให้บริการ 24 ชั่วโมง`}
    titleleft="ช่องทางติดต่อหลัก"
    titleright="แจ้งปัญหาให้ตรงรายการ">
    <p slot="left">
      แอดมิน {BRAND_NAME}
      <strong class="text-[#ffd98a]">มีช่องทางสำหรับรับเรื่องสอบถามเกี่ยวกับการสมัคร การเข้าสู่ระบบ กติกาเกมคาสิโน โปรโมชั่น และรายการธุรกรรมที่อยู่ระหว่างตรวจสอบ</strong>
      โดยระบุเวลาให้บริการตลอด 24 ชั่วโมง สมาชิกสามารถติดต่อผ่านช่องทางหลักที่เว็บไซต์กำหนด
      <strong class="text-[#ffd98a]">พร้อมแจ้งรายละเอียดปัญหาให้ครบถ้วน</strong>
      เพื่อช่วยให้เจ้าหน้าที่ตรวจสอบรายการได้ตรงประเด็น
    </p>
    <p slot="right">
      หากพบปัญหาเกี่ยวกับบาคาร่า สล็อต ไฮโล หรือยิงปลา
      <strong class="text-[#ffd98a]">ควรแจ้งชื่อเกมและเวลาที่เกิดเหตุ</strong>
      ส่วนการเดิมพันบอลออนไลน์ควรเตรียมชื่อคู่แข่งขันและหมายเลขรายการ หากเป็นปัญหาโปรโมชั่นควรระบุชื่อกิจกรรมและรอบรับสิทธิ์
      <strong class="text-[#ffd98a]">โดยไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น</strong>
      แม้จะอ้างว่าเป็นเจ้าหน้าที่ของเว็บไซต์ก็ตาม
    </p>
  </ContentBoxTwoCyberCut>

  <Faq as="h2" title={`คำถามที่พบบ่อยเกี่ยวกับ ${BRAND_NAME}`} faqs={faqs} />

  <LoginRtpSection />

  <ReviewCardSumo />

  <Navfoot />
</MainLayout>
