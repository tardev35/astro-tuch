---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import LatestWinners from "../components/LatestWinners3.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBox3ThreeCyberCut from "../components/ContentBox3ThreeCyberCut.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import Faq from "../components/Faq4.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import { pageGraph } from "../lib/schema";
import imgCashback from "../assets/slide2.png";
import imgReferral from "../assets/slide1.png";

// VARIANT ROTATION THIS ROUND, decided in .claude/brand-spec-tsdet911.md §3 and
// NOT re-picked here: Announcement3 replaces Announcement5, LatestWinners3
// replaces LatestWinnersCyber, Faq4 replaces Faq3, ReviewCardSumo2 replaces
// ReviewCardSumo, and the ContentBox shape-mix leaves CyberCut / TwoPremium /
// SevenThreePremium / SevenThreeNeumorphism / Special / FloatingBadge behind for
// Premium / TwoNeumorphism / SevenThreeFloatingBadge / SevenThree /
// 3ThreeCyberCut / Neumorphism. NavbarStyle7 + FooterPremium are the layout's
// pair this round and the brand font moves kanit -> google-sans; all of that is
// the orchestrator's shared-chrome step, not this page's.
// Plain ContentBox is the one sanctioned carry-over (brand-spec §3): it is the
// always-live box that terms, privacy, 404 and the button pages render through,
// so it cannot follow a rotation. Section 3 is the single docx section it carries.
// ContentBoxTwo is live too but is NOT imported here — it is reached only through
// LoginRtpSection, so an "is it used?" grep has to match the bare filename.
// Every unused *Premium / *Cyber / *Huay / *FloatingBadge / *Style sibling, the
// other Faq* and Announcement* files, the other LatestWinners* and the previous
// ReviewCardSumo all stay on disk as inventory for the next brand — nothing was
// deleted, and the earlier brands' hues still inside them are expected drift.
//
// <Announcement /> runs bare on purpose: Announcement3's default message is
// already this brand's copy, set by the orchestrator from this brief, and every
// sub-page calls it bare too — so passing an override here is exactly how the
// ticker ends up saying two different things on two pages of the same site.
//
// PALETTE — ELECTRIC BLUE + CHROME SILVER ON NEAR-BLACK NAVY (brand-spec §2).
// Read off the artwork: the logo is the word TSDET in polished chrome-silver 3-D
// lettering followed by 911 in electric blue, with a blue falcon/swoosh mark to
// its left. The banner and both slides are the same black studio scene lit with
// electric-blue light ribbons and blue lens flare — a silver-haired man and a
// silver-haired woman in black and white formalwear, blue-and-silver chips,
// black-and-silver aces and a chrome roulette wheel rim. There is no gold in this
// drop at all, and no violet, pink, green, orange or red either.
// ⚠️ The page background is NEAR-BLACK NAVY #00081f (bg.json), so nothing on this
// page may sink below it. Depth ramp: #102a5e raised / #0a1c42 mid / #040e26
// sunken / #00081f page.
// ⚠️ Compare by VALUE, never by colour family — blue has shipped before on this
// template. This brand's primary is #0360f3 (R=3 G=96 B=243) and its bright blue
// is #0292fb (R=2 G=146 B=251), both measured from logo.webp in this drop; the
// closest previous value anywhere in the repo is #0193fb (R=1 G=147 B=251), which
// is a different file's brand and is not this one.
// Body copy is #dde8f7 (= BRAND_TEXT), 17.4:1 on the page background and 11.6:1
// on the raised surface. The ONE highlight colour a <strong> may take is #6ec8ff
// (7.4:1) — unlike #cfdcec / #9db4d4, which are the chrome-silver heading and
// secondary-text values, and unlike #4fb4ff, which is links/hover only.
// #0360f3, #0292fb, #032dad, #04186e and #041a43 never carry text at any size:
// they are borders, plate edges, column rules, gradient ends and glows. #021026
// is the only ink allowed on a light or bright-blue fill. Glow rgba is
// rgba(3,96,243,α), rgba(2,146,251,α) or rgba(110,200,255,α).
//
// IMAGE ROLES FOR THIS DROP (2026-10-13, brand-spec §4). Two files are referenced
// from this page and only two, and each pairing is read off the artwork itself —
// the percentage printed ON the slide has to match the heading its block carries,
// or the picture contradicts the section above it. The import names come from what
// is printed on each picture, never from the file number.
//   slide2.png — square 600x600. The wordmark top left, the couple facing forward,
//     and stacked at the left โปรโมชั่น, then คืนยอดเสีย on a black blue-edged
//     plate, then 0.3% in very large 3-D chrome-blue numerals. Along the bottom a
//     blue-and-black chip carrying the falcon mark, more chips and a chrome
//     roulette wheel rim. It prints the offer itself, so it belongs to docx H3 §4.
//     Imported as imgCashback.
//   slide1.png — the companion square. Same wordmark top left; at the right the
//     man in a black suit seated beside the woman in a white blazer. Left of
//     centre, stacked: โปรโมชั่น in huge 3-D chrome-and-blue type, แนะนำเพื่อน on
//     a black blue-edged plate, then โบนัส 0.8% in large blue numerals. Along the
//     bottom black-and-silver chips and a spade ace, with blue light ribbons
//     arcing behind everything. It belongs to docx H3 §5. Imported as imgReferral.
// Both slides are 600x600 on disk, so 600 is the top real candidate — anything
// above it would not be a real pixel — and each picture carries max-w-[600px] so
// the art is never upscaled past its own bitmap.
// Each slide sits in a ContentBoxSevenThree* image+text block, which is that
// family's hard cap of two per rebrand, so there is no third SevenThree anywhere
// on the site and no slide appears outside those two blocks.
// Both blocks lay out md:grid-cols-[7fr_3fr] with the TEXT column first, so each
// picture goes in slot="right": the heading always lands on the prose, never on
// the picture, and on a phone the single column reads heading, text, picture
// rather than opening with an image. Each `sizes` therefore describes its own 3fr
// column rather than the viewport, and both were taken from the arithmetic block
// inside the variant that owns them — they are NOT last round's numbers, because
// the two variants cap different boxes and pay different padding:
//   ContentBoxSevenThreeFloatingBadge (§4)  >= 1312px : 311px
//     (max-w-7xl on the CARD, border-2,     md..1311  : calc(30vw - 83px)
//      flat p-8, gap-10, md:pl-10 + 1px)    700..767  : 600px (bitmap cap)
//                                           < 700     : calc(100vw - 100px)
//   ContentBoxSevenThree (§5)               >= 1400px : 352px
//     (max-w-[1400px] on the SECTION with   md..1399  : calc(30vw - 68px)
//      px-4 inside it, 1px border,          698..767  : 600px (bitmap cap)
//      md:p-10, gap-8, md:pl-6)             < 698     : calc(100vw - 98px)
// Neither is the LCP element — MainLayout's hero banner is — so both are
// loading="lazy" fetchpriority="low" decoding="async" and neither takes
// fetchpriority="high". formats/fallbackFormat/quality stay at the house values:
// tools/avif-quality-service.mjs rescales AVIF quality on its own, so quality={80}
// must not be hand-tuned per format.
//
// The alt text was written from THIS drop's artwork (brand-spec §4 transcribes
// what is actually drawn on each slide), not carried over from the outgoing
// brand's violet-and-gold set, and neither alt is a counter like "the second
// image" — each describes its own picture.
//
// Deliberately NOT imported, and every file still on disk: the two higher-numbered
// banners (10-08 and 09-27) are previous brands' article art, and the two
// higher-numbered slides (09-29) are an older brand's posters. Importing any of
// them emits a competitor's picture into dist/ — an eager import IS an emit,
// rendered or not — and turns verify-build red. There is therefore NO current-drop
// article illustration this round, and a slide is never substituted for one.
// banner1 and its mobile crop belong to MainLayout's own pinned globs and are
// never referenced from a page; og.png is the same, MainLayout owns it.
// Also deliberately unused, and named without the file extension on purpose,
// because the playbook's "is this component live?" check is a bare-filename grep:
// ProviderGrid and GameRankingBoard have nothing to carry because the brief names
// no game studio and no ranking; SmoothCarousel has no brief section asking for a
// carousel; BankStrip already renders inside the active footer; and
// FeatureHighlights has nothing to carry either, because the brief's two H3s are
// real docx headings with full paragraphs under them rather than a labelled
// sub-list — they take their own SevenThree blocks.
//
// VOCABULARY — brand-spec §7, the brief's own words only. This is a MIXED CASINO
// + SPORTS brand: บาคาร่า, ไฮโล, สล็อต and แทงบอล, which are the only four game
// words on the page. Everything the copy says traces to src/assets/content.txt:
// เว็บพนันลิขสิทธิ์ไทยแท้, ผ่านเซิร์ฟไทย 100%, ทางเข้าเดิมพัน, ไม่มีขั้นต่ำ, หมวดเกม,
// แพลตฟอร์มเดียว, เกมไพ่, ลูกเต๋า, เกมวงล้อทั่วไป, ฟีเจอร์โบนัส, รายการแข่งขัน,
// อัตราต่อรอง, ตารางจ่าย, กติกา, เงื่อนไขการตัดสินผล, ยอดเดิมพัน, บัญชีเดียว,
// 24 ชั่วโมง, โบนัสคืนยอดเสีย 0.3%, เข้ายูสทุกวัน, รอบประจำวัน, เวลาตัดยอด,
// ยอดที่เข้าเกณฑ์, แนะนำเพื่อน, โบนัส 0.8%, ไม่จำกัด, ลิงก์แนะนำ, ยืนยันบัญชี,
// รหัสผ่าน, PIN, OTP, แอดมิน, หมายเลขรายการ, คู่แข่งขัน. The outgoing brand's
// framing and every older brand's slogans are gone from this page — it is written
// straight from the brief rather than find-and-replaced over the old sentences —
// and there is no lottery wording anywhere, because this is not a lottery brand.
// Nothing here claims a licence number, a regulator, an operator name, a game
// studio, a bank, an RTP figure, a deposit minimum, a member count, a founding
// year or a server location, because the brief names none: it explicitly HEDGES
// the "ลิขสิทธิ์ไทยแท้" and "ไม่จำกัด" claims rather than asserting them, and that
// hedge ships with the copy. The only figures on the page are the brief's own
// three: 0.3%, 0.8% and 24 ชั่วโมง.
// The brief hedges five separate times (brand-spec §5) and every one of those
// clauses is part of its paragraph below, not trimmed as downbeat filler.
//
// The brief, the artwork and the operator's prompt all agree on the brand name.
// Even so the name is never typed on the page: it is interpolated from
// ${BRAND_NAME} so it can never drift from brandProfile. No domain is written out
// anywhere here and no URL is built with `+` — note the brand name and the domain
// do NOT match this round, which is exactly the kind of thing a hand-typed URL
// gets wrong.
//
// Title and description are the brief's own Title/Description lines (content.txt
// lines 1-2) verbatim, with the brand name interpolated. They are NOT padded up to
// 150 characters — verify-build deliberately skips its 150-character floor on the
// home page for exactly this reason. Both strings are byte-identical to the
// defaults the orchestrator set in MainLayout.astro, which is what makes passing
// them here a no-op rather than a second source of truth.
const pageTitle = `${BRAND_NAME} เว็บพนันลิขสิทธิ์ไทยแท้ เดิมพันได้ 24 ชั่วโมง ผ่านเซิร์ฟไทย`;

const pageDescription = `${BRAND_NAME} เว็บพนันลิขสิทธิ์ไทยแท้ ทางเข้าเดิมพัน บาคาร่า ไฮโล สล็อต แทงบอล ไม่มีขั้นต่ำ เปิดระบบเข้าเล่นได้ 24 ชั่วโมง ผ่านเซิร์ฟไทย100%`;

// The brief has a real H2 -> H3 nesting this round, so the page is NOT flattened
// to H2-only. The two H3s are the docx's own H3 lines — the two promotion
// sub-points that sit under section 3's โปรโมชั่น H2 in the brief's own outline.
// There is no FeatureHighlights H3 exception this round: section 6's three steps
// are the docx's own "ขั้นตอนที่ 1/2/3 …" labels rendered as <p> column captions
// by ContentBox3ThreeCyberCut with heading={false}, so they add no heading at any
// level and the printed h3 count stays at exactly 2.
//
// The checklist, in document order, and what carries each one:
//    1 H1  ${BRAND_NAME} เว็บพนันลิขสิทธิ์ไทยแท้ ผ่านเซิร์ฟไทย 100%
//          ContentBoxPremium, brief paragraph on line 4
//    2 H2  ทางเข้าเดิมพัน ${BRAND_NAME} บาคาร่า ไฮโล สล็อต แทงบอล ไม่มีขั้นต่ำ
//          ContentBoxTwoNeumorphism, line 6 left / line 7 right
//    3 H2  โปรโมชั่นเดิมพัน ${BRAND_NAME} เว็บพนันคาสิโนเซิร์ฟไทยแท้
//          ContentBox (the plain, always-live variant), line 9
//    4 H3  โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสทุกวัน
//          ContentBoxSevenThreeFloatingBadge + slide2 (imgCashback), line 11
//    5 H3  โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด
//          ContentBoxSevenThree + slide1 (imgReferral), line 13
//    6 H2  สมัครเล่น ${BRAND_NAME} คาสิโน 3 ขั้นตอน
//          ContentBox3ThreeCyberCut, line 15 as the intro slot and lines 16, 17,
//          18 as the three columns, each split at the brief's own step label
//    7 H2  แอดมิน ${BRAND_NAME} เปิดบริการ 24 ชั่วโมง
//          ContentBoxNeumorphism, lines 20 and 21
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ ${BRAND_NAME}
//          Faq4 + faqs prop, lines 23-28
// Final inventory for this page: h1 x1, h2 x5, h3 x2.
//
// SHAPE RHYTHM, top to bottom — no two adjacent sections read as the same card,
// and each neighbour pair differs in at least two of {corner, surface depth,
// heading treatment}:
//   §1 rounded-3xl GRADED from MID #0a1c42 down to SUNKEN #040e26 in a brand-blue
//      frame, two corner auras, heading gradient #6ec8ff -> #cfdcec -> #4fb4ff
//   §2 rounded-[30px] NEUMORPHIC on RAISED #102a5e with NO border at all, twin
//      shadows pressed to the page bg and lifted with #04186e, heading gradient
//      #9db4d4 -> #6ec8ff -> #cfdcec, two columns split by a deep-blue rule
//   §3 rounded-3xl on flat RAISED #102a5e with a top hairline and a 20px underline
//      rule, heading gradient #cfdcec -> #6ec8ff -> #0360f3 (the always-live box;
//      its treatment is fixed by the orchestrator)
//   §4 rounded-2xl GRADED from RAISED #102a5e down to SUNKEN #040e26 in a 2px
//      brand-blue frame, heading INVERTED into a floating chrome-silver plate
//      carrying #021026 ink — the opposite polarity of every other heading here,
//      picture right
//   §5 CLIPPED corners (36px, top-left/bottom-right) on MID #0a1c42, heading SOLID
//      #cfdcec behind a vertical blue spark — the only solid light-on-dark heading
//      on the page, picture right
//   §6 CLIPPED corners mirrored (30px, top-right/bottom-left) on SUNKEN #040e26
//      with four corner rules crossing brand blue against chrome silver, heading
//      gradient #4fb4ff -> #cfdcec -> #9db4d4, three captioned columns
//   §7 rounded-[25px] NEUMORPHIC on MID #0a1c42 inside a #102a5e frame, heading
//      gradient #cfdcec -> #4fb4ff -> #6ec8ff, centred
//   §8 rounded accordion rows on a sunken surface behind a left-railed title
//      plate, questions inside <summary> as <span>
// The two clipped cards (§5, §6) are adjacent on purpose and are told apart three
// ways at once: the direction of the cut is mirrored, the cut size differs
// (36px vs 30px) and the surface depth differs (mid vs sunken). The two
// neumorphic plates (§2, §7) are separated by four sections and differ in corner,
// border and surface. No two headings run the same order of the same ramps.
//
// ContentBoxSevenThreeFloatingBadge and ContentBoxSevenThree both take the docx
// heading through `title`, which falls back to their wide (7fr) LEFT text column;
// neither is passed a `titleright`, so each block emits exactly one heading and
// the picture column never carries one.
//
// Every brief paragraph ships in full — nothing merged, nothing summarised. §2
// runs one paragraph per column, §6 one step per column under the intro, and §7
// is the only single slot that receives more than one paragraph: it wraps them in
// ONE <div class="flex flex-col gap-4"> as the house rule requires, because that
// slot would otherwise put two siblings into a gap-* flex column.
// No column label is passed to ContentBoxTwoNeumorphism: the brief gives §2 two
// running paragraphs with no sub-labels, and inventing a pair here would be this
// page's own wording rather than the docx's.
//
// Everything else on the page is chrome and emits no heading tag at any level:
// Announcement3, LatestWinners3, LoginRtpSection and ReviewCardSumo2 render their
// titles as <p>/<span> with an aria-label on the section, and Faq4's questions
// live inside <summary> as <span>. The non-brief widgets sit before section 1 (the
// ticker, then the winners feed) and after section 8 (LoginRtpSection,
// ReviewCardSumo2, Navfoot) — never spliced between two content sections.

// One array, used by both <Faq> and the FAQPage node — never the component's own
// defaults (Faq4 deliberately ships an empty list, so a forgotten prop renders an
// empty accordion rather than some previous brand's questions). The three pairs
// are the brief's own Q/A block (content.txt lines 23-28), verbatim.
const faqs = [
  {
    q: `${BRAND_NAME} มีเกมเดิมพันประเภทใดให้เลือกบ้าง?`,
    a: `${BRAND_NAME} นำเสนอเกมหลายประเภท ได้แก่ บาคาร่า ไฮโล สล็อต และแทงบอล โดยจำนวนเกมและรายการที่เปิดให้บริการจริงขึ้นอยู่กับระบบ สมาชิกควรตรวจสอบกติกา ช่วงเดิมพัน และเงื่อนไขของแต่ละประเภทก่อนทำรายการ`,
  },
  {
    q: `${BRAND_NAME} เดิมพันไม่มีขั้นต่ำทุกเกมหรือไม่?`,
    a: `ยอดเดิมพันขั้นต่ำขึ้นอยู่กับประเภทเกมและผู้ให้บริการ บางรายการอาจรองรับการเดิมพันเริ่มต้นด้วยจำนวนเงินไม่สูง แต่ไม่ได้หมายความว่าทุกเกมจะไม่มีขั้นต่ำ ควรตรวจสอบวงเงินที่แสดงในระบบก่อนยืนยันการเดิมพัน`,
  },
  {
    q: `${BRAND_NAME} มีโปรโมชั่นอะไร และติดต่อแอดมินได้ตอนไหน?`,
    a: `โปรโมชั่นหลักตามข้อมูลที่กำหนดมี คืนยอดเสีย 0.3% และ แนะนำเพื่อน 0.8% โดยแต่ละรายการมีเงื่อนไขแตกต่างกัน ส่วนแอดมินระบุว่าเปิดให้บริการตลอด 24 ชั่วโมง สมาชิกควรตรวจสอบช่องทางติดต่อหลักและเวลาตอบกลับจริงจากหน้าเว็บไซต์`,
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// No two <strong> elements are adjacent either: every pair is separated by at
// least one run of plain text, so the whitespace between them can never collapse
// into a missing space.
// One highlight colour only: #6ec8ff, against the inherited body colour #dde8f7
// (BRAND_TEXT). The paragraphs below carry no colour class of their own: every
// ContentBox* card in this mix already sets
// `text-left text-base leading-relaxed text-[#dde8f7]` on the element holding the
// slot, so the prose inherits it and no page-level override can drift from the
// card. No paragraph carries mx-auto or max-w-* either — the cards cap their own
// width, and the only max-w-* on the page is the one capping each slide, which is
// an image and not prose. No slot's copy names a colour.

// No breadcrumb: this is the homepage, so a trail from the root to itself would be
// a single self-referential crumb. Every URL in the graph is derived by pageGraph
// from `site:` — no domain is typed out in this file, no URL is built with `+`,
// and no Review / AggregateRating / sameAs / address / email node is passed.
// `description` is the exact same string MainLayout gets, and `faqs` is the exact
// same array <Faq> gets.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <LatestWinners />

  <ContentBoxPremium as="h1" title={`${BRAND_NAME} เว็บพนันลิขสิทธิ์ไทยแท้ ผ่านเซิร์ฟไทย 100%`}>
    <p>
      {BRAND_NAME} เว็บพนันออนไลน์ที่นำเสนอระบบเข้าเดิมพันผ่านเว็บไซต์
      <strong class="text-[#6ec8ff]">รองรับเกมหลายประเภททั้งบาคาร่า ไฮโล สล็อต และแทงบอล</strong>
      พร้อมจัดหมวดเกมให้เลือกใช้งานผ่านมือถือและคอมพิวเตอร์ได้สะดวก สมาชิกสามารถตรวจสอบข้อมูลเกม ยอดเดิมพัน และรายการต่างๆ ผ่านบัญชีเดียว โดยเว็บไซต์ระบุว่าเปิดให้เข้าใช้งานตลอด 24 ชั่วโมง
      <strong class="text-[#6ec8ff]">ส่วนการกล่าวอ้างว่าเป็นเว็บลิขสิทธิ์ไทยแท้และใช้เซิร์ฟเวอร์ในประเทศไทย 100% ควรมีข้อมูลใบอนุญาตและผู้ให้บริการระบบที่ตรวจสอบได้ประกอบ</strong>
