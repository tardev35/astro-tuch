---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import Faq from "../components/Faq2.astro";
import LatestWinners from "../components/LatestWinners4.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// Title and description are the brief's own Title/Description lines, verbatim.
// A brief-supplied description ships at whatever length it was written — it is
// not padded up to the 150-character floor.
const pageTitle = "HONGHAO เว็บคาสิโนออนไลน์ รวมค่ายดัง สมัครง่าย โบนัสมีให้ทุกวัน";

const pageDescription = "คาสิโนออนไลน์เว็บตรง HONGHAO เกมครบวงจร ฝากถอนออโต้ 24 ชม. สมัครง่าย มีโบนัสให้กดรับได้ทุกวัน";

// The ticker copy is passed explicitly rather than relying on the component's
// default — every Announcement* variant's default belongs to whichever brand
// wired it in last. No emoji in this string: an emoji baked into a text prop
// cannot be given its own aria-hidden span.
const announcement =
  "HONGHAO เว็บพนันออนไลน์ มัดรวมค่ายเกมดัง ทั้งบาคาร่า คาสิโนสด รูเล็ต เสือมังกร แบล็กแจ็ก และสล็อต ไว้ในบัญชีเดียว • โบนัสคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8% ตามเงื่อนไขที่กำหนด • ระบบฝากถอนอัตโนมัติ ทำรายการเองได้ตลอด 24 ชั่วโมง • ทีมงาน HONGHAO พร้อมตรวจสอบรายการให้ทุกวัน";

// The brief's three registration steps. They are list items in the docx, not
// headings, so they render as an <ol> — turning them into cards with their own
// titles would add an h3 tier the brief does not have.
const steps = [
  "สมัครสมาชิกผ่านหน้าเว็บไซต์และกรอกข้อมูลที่ระบบกำหนด",
  "Login เข้าสู่บัญชีและฝากเครดิตผ่านระบบอัตโนมัติ",
  "ตรวจสอบโปรโมชั่น เลือกเกมที่ต้องการ และศึกษากติกาก่อนเริ่มเดิมพัน",
];

// One array, used by both <Faq> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last.
const faqs = [
  {
    q: "HONGHAO มีเกมอะไรให้เลือกเล่นบ้าง?",
    a: "ระบบมีเกมหลายประเภท เช่น บาคาร่า คาสิโนสด รูเล็ต เสือมังกร สล็อต และเกมเดิมพันอื่น ๆ สมาชิกสามารถตรวจสอบรายชื่อค่ายและเกมที่เปิดให้บริการล่าสุดผ่านหน้าเว็บไซต์ได้โดยตรง",
  },
  {
    q: "โปรโมชั่น HONGHAO 0.3% และ 0.8% รับอย่างไร?",
    a: "โบนัส 0.3% เป็นโปรโมชั่นคืนยอดเสียสำหรับยอดที่เข้าเงื่อนไข ส่วนโบนัส 0.8% เป็นโปรโมชั่นแนะนำเพื่อน สมาชิกควรตรวจสอบรายละเอียด รอบคำนวณ และข้อกำหนดล่าสุดก่อนกดรับสิทธิ์ทุกครั้ง",
  },
  {
    q: "หากฝากถอน HONGHAO แล้วรายการไม่เข้าต้องทำอย่างไร?",
    a: "ให้ตรวจสอบสถานะธุรกรรมในบัญชีสมาชิกก่อน หากเครดิตยังไม่เข้าหรือรายการถอนยังค้าง สามารถติดต่อทีมงาน HONGHAO พร้อมแจ้งรายละเอียดและเวลาที่ทำรายการ เพื่อให้เจ้าหน้าที่ช่วยตรวจสอบได้ตลอด 24 ชั่วโมง",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <SmoothCarousel />

  <ContentBox as="h1" title="HONGHAO เว็บพนันออนไลน์ มัดรวมค่ายเกมดัง">
    <p class="text-left text-base leading-relaxed text-[#dbe5d3]">
      <strong class="text-[#f2f8ec]">HONGHAO</strong> พร้อมให้บริการสมาชิกที่ต้องการเล่นเกมพนันออนไลน์ผ่านมือถือและคอมพิวเตอร์ รวมเกมจากหลากหลายค่ายไว้ในระบบเดียว พร้อมระบบฝากถอนอัตโนมัติตลอด 24 ชั่วโมง และโปรโมชั่นสำหรับสมาชิกทั้งคืนยอดเสีย
      0.3% และโบนัสแนะนำเพื่อน 0.8% ตามเงื่อนไข สามารถสมัคร เข้าเล่น ตรวจสอบโปรโมชั่น และติดต่อทีมงานได้อย่างสะดวกผ่านหน้าเว็บไซต์
    </p>
  </ContentBox>

  <ContentBoxTwoPremium as="h2" title="คาสิโนออนไลน์เว็บตรง HONGHAO รวมเกมค่ายดังครบวงจร">
    <p slot="left" class="text-left text-base leading-relaxed text-[#dbe5d3]">
      HONGHAO รวบรวมเกมคาสิโนออนไลน์จากหลากหลายค่ายไว้ให้เลือกภายในบัญชีเดียว มีทั้งบาคาร่า คาสิโนสด รูเล็ต เสือมังกร แบล็กแจ็ก สล็อต และเกมเดิมพันประเภทอื่น ๆ พร้อมจัดหมวดหมู่ให้ค้นหาได้ง่าย รองรับการเข้าเล่นผ่านสมาร์ตโฟน แท็บเล็ต
      และคอมพิวเตอร์ ช่วยให้สมาชิกเลือกเกมที่สนใจได้โดยไม่ต้องสลับใช้งานหลายระบบ
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#dbe5d3]">
      ก่อนเริ่มเดิมพันควรตรวจสอบกติกา อัตราการจ่าย และเงื่อนไขของแต่ละเกม เนื่องจากรายละเอียดอาจแตกต่างกันตามค่ายและประเภทการเดิมพัน
    </p>
  </ContentBoxTwoPremium>

  <ProviderGrid />

  <ContentBoxSpecial as="h2" title="เข้าเล่น HONGHAO ฝากถอนออโต้ได้ตลอด 24 ชม. ไม่มีขั้นต่ำ">
    <p slot="left" class="text-left text-base leading-relaxed text-[#dbe5d3]">
      สมาชิกสามารถทำรายการฝากและถอนผ่านระบบอัตโนมัติของ HONGHAO ได้ตลอด 24 ชั่วโมง พร้อมตรวจสอบเครดิตและสถานะธุรกรรมผ่านบัญชีของตนเอง ช่วยลดขั้นตอนและระยะเวลาในการทำรายการ
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#dbe5d3]">
      สำหรับยอดฝากถอนขั้นต่ำ ช่องทางที่รองรับ และวงเงินต่อรายการ ควรตรวจสอบข้อมูลล่าสุดที่แสดงในระบบก่อนยืนยันธุรกรรม หากเครดิตไม่เข้าหรือรายการถอนล่าช้า สามารถติดต่อทีมงานให้ช่วยตรวจสอบได้ทันที
    </p>
  </ContentBoxSpecial>

  <LoginRtpSection />

  <ContentBoxTwoCyberCut as="h2" title="สมัคร HONGHAO เล่นเกมบนมือถือ 3 ขั้นตอน">
    <p class="text-left text-base leading-relaxed text-[#dbe5d3]">เริ่มต้นสมัคร HONGHAO และเข้าเล่นผ่านมือถือได้ง่ายเพียง 3 ขั้นตอน</p>

    <ol slot="left" class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#dbe5d3]">
      {
        steps.map((step, i) => (
          <li class="flex items-start gap-3 rounded-2xl border border-[#3f6b23]/60 bg-[#060a04]/70 p-4">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-[#a8e37c] via-[#62ae2d] to-[#2f6a0c] text-sm font-black text-[#060a04]">{i + 1}</span>
            <span>{step}</span>
          </li>
        ))
      }
    </ol>

    <p slot="right" class="text-left text-base leading-relaxed text-[#dbe5d3]">
      ระบบรองรับการใช้งานผ่านมือถือทั้ง Android และ iOS รวมถึงแท็บเล็ตและคอมพิวเตอร์ สามารถเปิดผ่านเว็บเบราว์เซอร์และจัดการบัญชีสมาชิกได้โดยตรง
    </p>
  </ContentBoxTwoCyberCut>

  <ContentBoxSevenThreePremium as="h3" titleright="โปรโมชั่นคืนยอดเสีย รับโบนัส 0.3%">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600, 800]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นพื้นเงินขาวลายวงกลมจีน ด้านบนเป็นโลโก้ HONGHAO ตัวอักษรเขียวหยกสลับเงิน ถัดลงมาเป็นคำว่า โปรโมชั่น คืนยอดเสีย และป้าย รับโบนัส พร้อมตัวเลข 0.3% ขนาดใหญ่ ด้านซ้ายมีไพ่และชิปคาสิโนสีเขียว ด้านขวาเป็นหญิงสาวชุดกี่เพ้าสีเขียวมะกอกปักลายดอกไม้ เกล้าผมประดับเครื่องประดับทอง แบฝ่ามือไปทางข้อความ แถวล่างมีไอคอนสี่ช่อง คืนยอดเสียทุกวัน ทำเทิร์นครบรับโบนัสทันที มั่นคง ปลอดภัย เชื่อถือได้ และบริการลูกค้าตลอด 24 ชม."
      class="mx-auto h-auto w-full rounded-2xl border border-[#62ae2d]/45 shadow-[0_10px_30px_rgba(98,174,45,0.24)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#dbe5d3]">
      สมาชิกที่มียอดเสียตรงตามข้อกำหนดสามารถตรวจสอบสิทธิ์รับโบนัสคืนยอดเสีย 0.3% ตามรอบที่กำหนด โดยระบบจะแสดงยอดที่ใช้คำนวณและสิทธิ์ที่สามารถกดรับได้ ควรตรวจสอบประเภทเกมที่ร่วมรายการ รอบคำนวณ และเงื่อนไขการถอนก่อนรับโบนัสทุกครั้ง
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBoxSevenThreeFloatingBadge as="h3" title="โปรโมชั่นแนะนำเพื่อน รับโบนัส 0.8%">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600, 800]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นพื้นเงินขาวลายจีนมีเจดีย์และภูเขาหมอก ด้านบนเป็นโลโก้ HONGHAO ตัวอักษรเขียวหยกสลับเงิน ถัดลงมาเป็นคำว่า โปรโมชั่น แนะนำเพื่อน และ รับโบนัส พร้อมตัวเลข 0.8% ขนาดใหญ่ ด้านขวาเป็นหญิงสาวชุดกี่เพ้าสีครีมทองปักลายดอกไม้เขียว เกล้าผมประดับปิ่นทอง แบฝ่ามือไปทางข้อความ มุมล่างมีไพ่ กองเหรียญทอง และกล่องของขวัญ"
      class="mx-auto h-auto w-full rounded-2xl border border-[#d9b95c]/45 shadow-[0_10px_30px_rgba(217,185,92,0.24)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#dbe5d3]">
      สมาชิกสามารถนำลิงก์แนะนำของตนเองไปแชร์ให้เพื่อน เมื่อเพื่อนสมัครและมียอดตรงตามเงื่อนไข ระบบจะคำนวณโบนัสแนะนำเพื่อน 0.8% ให้ตามข้อกำหนด สามารถติดตามข้อมูลการแนะนำและตรวจสอบโบนัสผ่านบัญชีสมาชิกได้อย่างสะดวก
    </p>
  </ContentBoxSevenThreeFloatingBadge>

  <ContentBoxPlain as="h2" title="ทีมงาน HONGHAO ให้คำแนะนำ ตลอดทั้งการเดิมพัน">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dbe5d3]">
        หากพบปัญหาเกี่ยวกับการสมัครสมาชิก การ Login การฝากถอน การรับโปรโมชั่น หรือการเข้าเล่นเกม สามารถติดต่อทีมงาน HONGHAO ได้ตลอด 24 ชั่วโมง เจ้าหน้าที่พร้อมช่วยตรวจสอบรายการและแนะนำขั้นตอนการใช้งาน
        เพื่อให้สมาชิกสามารถแก้ไขปัญหาและกลับมาใช้งานระบบได้อย่างต่อเนื่อง
      </p>
      <p class="text-left text-base leading-relaxed text-[#dbe5d3]">
        การเดิมพันมีความเสี่ยงและไม่สามารถรับประกันผลกำไรได้ สมาชิกควรศึกษากติกาและกำหนดงบประมาณให้เหมาะสมก่อนเดิมพันทุกครั้ง
      </p>
    </div>
  </ContentBoxPlain>

  <Faq title="คำถามที่พบบ่อยเกี่ยวกับ HONGHAO" faqs={faqs} />

  <LatestWinners />

  <ReviewCardSumo2 />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#a8e37c] via-[#62ae2d] to-[#2f6a0c] px-4 py-3 text-sm font-black whitespace-nowrap text-[#060a04] shadow-[0_10px_30px_rgba(98,174,45,0.28)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(98,174,45,0.42)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#d9b95c]/50 bg-gradient-to-r from-[#3a2a08] to-[#060a04] px-4 py-3 text-sm font-black whitespace-nowrap text-[#f2f8ec] shadow-[0_10px_30px_rgba(98,174,45,0.16)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#d9b95c]/80 hover:text-[#f0dca0] hover:shadow-[0_15px_40px_rgba(217,185,92,0.3)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>
  </div>

  <Navfoot />
</MainLayout>
