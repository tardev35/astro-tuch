---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBox3ThreeNeumorphism from "../components/ContentBox3ThreeNeumorphism.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import Faq from "../components/Faq3.astro";
import LatestWinners from "../components/LatestWinners3.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// IMAGE ROLES FOR THIS DROP (2026-09-25) — READ BEFORE REUSING THESE IMPORTS.
// Two files are referenced from this page and only two, both slides, both spent
// on a ContentBoxSevenThree* block — the family's hard cap of two per rebrand,
// so there is no third SevenThree here:
//   slide1.png — the black-and-gold poster whose type reads "โปรโมชั่น แนะนำเพื่อน
//     / โบนัส 0.8%", so it belongs to docx H3 #4.
//   slide2.png — the same pair of models over "โปรโมชั่น คืนยอดเสีย / โบนัส 0.3%",
//     so it belongs to docx H3 #5.
// Both files are 600x400, so 600 is the top candidate width — nothing above it
// would be a real pixel. The alt text was written from the CURRENT artwork (the
// engraved gold KINGDOM66 wordmark, the woman in the white blazer with black
// lapels, the man in the black tuxedo, the gold crown, the gold megaphone, the
// gold chips and gift boxes, the aces and gold coins), never carried over from
// UWIN33's "gold U / chrome WIN / gold 33" strings — this brand's logo has no
// chrome or silver in it at all.
//
// Deliberately NOT imported, and all still on disk as inventory:
//   banner2.png (2026-09-22), banner3.png (2026-08-11), slide3.png
//   (2026-09-18), slide4.png (2026-08-13) — every one predates this drop and
//   carries a previous client's artwork. There is therefore NO usable banner2+
//   this round and NO single-column inline illustration, which is the expected
//   outcome, not a gap to fill with a stale file.
//   banner1.png and banner1-mobile.png belong to MainLayout's own pinned globs
//   and are never referenced from a page — the hero is the LCP element, so
//   nothing here gets loading="eager" fetchpriority="high".
//
// ProviderGrid / ProviderGridPremium / FeaturedGames / PopularGamesStrip /
// GameRankingBoard are DROPPED this round and NOT deleted from disk: each one
// has to name specific studios or game titles, and this brief names none — the
// closest it comes is "ผู้ให้บริการต่างประเทศตามรายการที่เปิดให้บริการ", so filling
// them in would be inventing facts. SmoothCarousel is out because it would put
// slide* outside a ContentBoxSevenThree*, LottoGrid because KINGDOM66 is a mixed
// casino brand rather than a lottery one (so /ตรวจหวย and /แนวทาง also stay
// parked), FeatureHighlights because the 3-step signup list has no per-step
// headings in the brief (it emits <h3> per item, which would break the heading
// inventory), BankStrip because the brief names no deposit or withdrawal channel
// at all.

// Title and description are the brief's own Title/Description lines, used
// verbatim. A brief-supplied description is never padded up to the 150-char
// floor and never topped up from the H1/H2 — this one is 121 characters.
const pageTitle = "KINGDOM66 เล่นบาคาร่าฟรีเครดิต เกมคาสิโน ไลฟ์สดส่งตรงครบ";

const pageDescription = "KINGDOM66 เล่นบาคาร่าฟรีเครดิต แหล่งรวมเกมคาสิโน ไพ่ สล็อต หวย บอล เดิมพันไลฟ์สดส่งตรงจากบริษัทต่างประเทศ ครบทุกแบรนด์ดัง";

// <Announcement /> runs bare: AnnouncementCyber's default message is already
// this brand's copy, and every sub-page calls it bare too — passing an override
// here is how the ticker ends up saying two different things on two pages.

// The rendered H1 fixes one typo in the brief, and only that one: the docx line
// reads "เล่นบาคาร่าสเครดิตฟรี" with a stray ส between บาคาร่า and เครดิตฟรี. It
// ships as "เล่นบาคาร่าเครดิตฟรี"; the brief's own Title line spells the same
// phrase without the ส, which is what makes it a typo rather than a variant.
//
// The docx has a real H2 -> H3 nesting this round: "แนะนำเพื่อน โบนัส 0.8%" and
// "คืนยอดเสีย โบนัส 0.3%" are genuine sub-points of the โปรโมชั่น H2, so the page
// is NOT flattened to H2-only. Those two are the only <h3> here, and each one is
// carried by its own ContentBoxSevenThree* block together with the slide whose
// artwork states that exact figure.
// Everything else is chrome — LatestWinners3, LoginRtpSection and
// ReviewCardSumo2 render their titles as <p>/<span> with an aria-label on the
// section, ContentBoxTwo renders its column labels as <p>, and Faq3's questions
// live in a <p> inside <summary> — so none of them emits a heading tag.
// ContentBox3ThreeNeumorphism is passed heading={false} because its three column
// captions are this page's own wording for splitting one docx paragraph into
// three readable columns, not docx sub-headings; they render as <p>. That file
// used to hardcode <h3> on all three, which was fixed in this round's retheme.
// ContentBoxTwoCyberCut's two column labels are <p> in the component already —
// the docx paragraph sits whole in its left column and the right column is a CTA
// pair, so nothing is summarised to make it fit.
//
// The docx checklist, in order, and what carries each one:
//    1 H1  KINGDOM66 เล่นบาคาร่าเครดิตฟรี เกมคาสิโน ไลฟ์สดส่งตรงครบ   ContentBoxFloatingBadge
//    2 H2  KINGDOM66 รวมเกมคาสิโน ไพ่ สล็อต หวย บอล ไลฟ์สด …          ContentBox3ThreeNeumorphism
//    3 H2  KINGDOM66 จัดโปรโมชั่น แจกโบนัส 0.8% ให้สมาชิกทุกยูส        ContentBox
//    4 H3  แนะนำเพื่อน โบนัส 0.8%                                  ContentBoxSevenThreeNeumorphism + slide1
//    5 H3  คืนยอดเสีย โบนัส 0.3%                                   ContentBoxSevenThreeFloatingBadge + slide2
//    6 H2  สมัคร KINGDOM66 รับโปรโมชั่นได้ทุกวัน ง่ายๆ แค่ 3 ขั้นตอน     ContentBoxSpecial (intro + <ol>)
//    7 H2  ติดต่อเจ้าหน้าที่ KINGDOM66 ผ่าน LINE OFFICIAL 24 ชั่วโมง    ContentBoxTwoCyberCut
//    8 H2  คำถามที่พบบ่อย                                          Faq3
// Final inventory for this page: h1 x1, h2 x5, h3 x2.

// One array, used by both <Faq> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last. The three pairs
// are the brief's own Q/A block, verbatim.
const faqs = [
  {
    q: "KINGDOM66 มีเกมประเภทไหนให้เลือกบ้าง?",
    a: "ภายในระบบมีทั้งบาคาร่า ไพ่ สล็อต หวย บอล และคาสิโนไลฟ์สดตามรายการที่เปิดให้บริการ สมาชิกสามารถตรวจสอบหมวดเกมและค่ายที่รองรับได้จากหน้ารวมเกมก่อนเลือกเข้าใช้งาน",
  },
  {
    q: "KINGDOM66 มีเครดิตฟรีและโปรโมชั่นอะไรบ้าง?",
    a: "สิทธิ์โปรโมชั่นขึ้นอยู่กับรายการที่ระบบเปิดให้รับ โดยโปรโมชั่นหลักตามข้อมูลที่กำหนดมีโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% ส่วนเครดิตฟรีควรตรวจสอบรายละเอียดและเงื่อนไขของโปรโมชั่นที่หน้าเว็บไซต์ก่อนรับสิทธิ์",
  },
  {
    q: "ติดต่อแอดมิน KINGDOM66 ผ่านช่องทางใด?",
    a: "สามารถติดต่อเจ้าหน้าที่ผ่าน LINE OFFICIAL ได้ตลอด 24 ชั่วโมง เพื่อสอบถามเรื่องบัญชี โปรโมชั่น เครดิตฟรี ทางเข้าเกม หรือปัญหาการใช้งาน โดยทีมงานจะช่วยตรวจสอบตามข้อมูลที่แจ้งเข้ามา",
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// One highlight colour only this round: #fdf6e0 against the body colour
// #ebe3d3, so the brand gold stays the page's structural accent and the
// paragraphs never compete with a heading for it.

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb. Every URL in the graph is derived
// by pageGraph from `site:` — no domain is typed out in this file.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxFloatingBadge as="h1" title="KINGDOM66 เล่นบาคาร่าเครดิตฟรี เกมคาสิโน ไลฟ์สดส่งตรงครบ">
    <p class="text-left text-base leading-relaxed text-[#ebe3d3]">
      KINGDOM66
      <strong class="text-[#fdf6e0]">รวมเกมคาสิโนหลายรูปแบบไว้ในระบบเดียว</strong>
      <strong class="text-[#fdf6e0]">ทั้งบาคาร่า ไพ่ สล็อต หวย บอล และเกมไลฟ์สดจากผู้ให้บริการต่างประเทศตามรายการที่เปิดให้บริการ</strong>
      สมาชิกสามารถเลือกหมวดเกมที่สนใจได้จากบัญชีเดียว
      <strong class="text-[#fdf6e0]">พร้อมสิทธิ์เครดิตฟรีและโปรโมชั่นตามเงื่อนไขที่กำหนด</strong>
      รองรับการใช้งานทั้งบนมือถือและคอมพิวเตอร์
    </p>
  </ContentBoxFloatingBadge>

  <ContentBox3ThreeNeumorphism
    as="h2"
    title="KINGDOM66 รวมเกมคาสิโน ไพ่ สล็อต หวย บอล ไลฟ์สดจากบริษัทต่างประเทศ"
    heading={false}
    titleleft="หมวดเกมที่รวมไว้ครบ"
    titlecenter="จัดหมวดหมู่ค้นหาง่าย"
    titleright="ตรวจสอบก่อนเข้าเล่น">
    <p slot="left" class="text-left text-base leading-relaxed text-[#ebe3d3]">
      KINGDOM66
      <strong class="text-[#fdf6e0]">รวมเกมยอดนิยมจากหลายหมวดไว้ครบ</strong>
      <strong class="text-[#fdf6e0]">ทั้งบาคาร่า ไพ่ สล็อต หวย บอล และคาสิโนไลฟ์สดจากผู้ให้บริการต่างประเทศตามข้อมูลของเว็บไซต์</strong>
    </p>
    <p slot="center" class="text-left text-base leading-relaxed text-[#ebe3d3]">
      <strong class="text-[#fdf6e0]">ระบบจัดหมวดหมู่ให้ค้นหาได้ง่าย</strong>
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#ebe3d3]">
      สามารถตรวจสอบรายละเอียดเกม ค่ายที่ให้บริการ
      <strong class="text-[#fdf6e0]">และรูปแบบเดิมพันก่อนเข้าเล่นได้จากหน้าเดียว</strong>
    </p>
  </ContentBox3ThreeNeumorphism>

  <ContentBox as="h2" title="KINGDOM66 จัดโปรโมชั่น แจกโบนัส 0.8% ให้สมาชิกทุกยูส">
    <p class="text-left text-base leading-relaxed text-[#ebe3d3]">
      โปรโมชั่น KINGDOM66
      <strong class="text-[#fdf6e0]">มีสิทธิ์ให้สมาชิกเลือกตามเงื่อนไขของแต่ละรายการ</strong>
      <strong class="text-[#fdf6e0]">โดยมีทั้งโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3%</strong>
      สมาชิกสามารถตรวจสอบยอดที่เข้าเกณฑ์ รอบรับสิทธิ์ และข้อกำหนดต่าง ๆ
      <strong class="text-[#fdf6e0]">ได้จากหน้าโปรโมชั่นก่อนกดรับ</strong>
      เพื่อเลือกสิทธิ์ให้เหมาะกับการใช้งานของตัวเอง
    </p>
  </ContentBox>

  <ContentBoxSevenThreeNeumorphism as="h3" title="แนะนำเพื่อน โบนัส 0.8%">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[340, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), 380px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นพื้นดำ-ทอง ด้านซ้ายเป็นหญิงสาวสวมเบลเซอร์สีขาวปกสีดำถือโทรโข่งสีทอง ด้านขวาเป็นชายหนุ่มสวมทักซิโด้สีดำ ด้านบนกลางภาพเป็นโลโก้ KINGDOM66 ตัวอักษรทองแกะสลัก ถัดลงมามีมงกุฎสีทองอยู่เหนือข้อความสีทองว่า โปรโมชั่น แนะนำเพื่อน และแผ่นป้ายสีแดงด้านล่างเขียนว่า โบนัส 0.8% รอบข้างมีชิปคาสิโนสีทองกับกล่องของขวัญสีทองวางประกอบ"
      class="mx-auto h-auto w-full rounded-2xl border border-[#e6bf4e]/55 shadow-[0_10px_30px_rgba(230,191,78,0.3)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#ebe3d3]">
      สมาชิก KINGDOM66
      <strong class="text-[#fdf6e0]">ที่แนะนำเพื่อนเข้ามาสมัครสามารถรับโบนัส 0.8% ตามเงื่อนไขของโปรโมชั่น</strong>
      ระบบมีรายละเอียดเกี่ยวกับยอดที่เข้าเกณฑ์และวิธีรับสิทธิ์ให้ตรวจสอบ
      <strong class="text-[#fdf6e0]">ช่วยให้ติดตามโบนัสจากกิจกรรมแนะนำเพื่อนได้สะดวกผ่านบัญชีสมาชิก</strong>
    </p>
  </ContentBoxSevenThreeNeumorphism>

  <ContentBoxSevenThreeFloatingBadge as="h3" title="คืนยอดเสีย โบนัส 0.3%">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[340, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), 352px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นพื้นดำ-ทองชุดเดียวกัน ด้านซ้ายเป็นหญิงสาวสวมเบลเซอร์สีขาวปกสีดำ ด้านขวาเป็นชายหนุ่มสวมทักซิโด้สีดำ ทั้งคู่ชี้มือเข้าหาข้อความกลางภาพ ด้านหลังมีไพ่โพดำเอซกับเหรียญทองกระจายอยู่ ด้านบนเป็นโลโก้ KINGDOM66 ตัวอักษรทองแกะสลัก และมีมงกุฎสีทองอยู่เหนือข้อความสีทองว่า โปรโมชั่น คืนยอดเสีย โดยแผ่นป้ายด้านล่างเขียนว่า โบนัส 0.3%"
      class="mx-auto h-auto w-full rounded-xl border border-[#efe6cf]/35 shadow-[0_10px_30px_rgba(5,4,3,0.85)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#ebe3d3]">
      <strong class="text-[#fdf6e0]">โปรโมชั่นคืนยอดเสียของ KINGDOM66 ให้โบนัส 0.3% ตามยอดและเงื่อนไขที่ระบบกำหนด</strong>
      สมาชิกสามารถตรวจสอบรอบคำนวณ ยอดที่เข้าเกณฑ์ และรายละเอียดก่อนกดรับได้
      <strong class="text-[#fdf6e0]">ช่วยให้ติดตามสิทธิ์ของตัวเองในแต่ละรอบได้ง่ายและเป็นขั้นตอนมากขึ้น</strong>
    </p>
  </ContentBoxSevenThreeFloatingBadge>

  <ContentBoxSpecial as="h2" title="สมัคร KINGDOM66 รับโปรโมชั่นได้ทุกวัน ง่ายๆ แค่ 3 ขั้นตอน" iconleft="📝" iconright="🔢">
    <p slot="left" class="text-left text-base leading-relaxed text-[#ebe3d3]">
      <strong class="text-[#fdf6e0]">การสมัคร KINGDOM66 สามารถทำผ่านหน้าเว็บไซต์ได้ด้วยตัวเอง</strong>
      ขั้นตอนไม่ซับซ้อน และหลังจากยืนยันบัญชีเรียบร้อยสามารถเข้าสู่ระบบเพื่อเลือกเกมและตรวจสอบโปรโมชั่นที่เปิดให้รับในแต่ละวันได้ทันที
      <strong class="text-[#fdf6e0]">โดยมี 3 ขั้นตอนหลักดังนี้</strong>
    </p>
    <ol slot="right" class="flex list-decimal flex-col gap-4 pl-6 text-left text-base leading-relaxed text-[#ebe3d3] marker:font-black marker:text-[#e6bf4e]">
      <li>เปิดหน้าสมัคร KINGDOM66 แล้วกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน</li>
      <li>ตรวจสอบข้อมูลและรายละเอียดบัญชีให้ถูกต้องก่อนกดยืนยัน</li>
      <li>ยืนยันการสมัครและเข้าสู่ระบบ จากนั้นเลือกเกมและตรวจสอบโปรโมชั่นที่เปิดให้รับได้ทันที</li>
    </ol>
  </ContentBoxSpecial>

  <ContentBoxTwoCyberCut as="h2" title="ติดต่อเจ้าหน้าที่ KINGDOM66 ผ่าน LINE OFFICIAL 24 ชั่วโมง" titleleft="รายละเอียดการติดต่อ" titleright="ช่องทางติดต่อด่วน">
    <p slot="left" class="text-left text-base leading-relaxed text-[#ebe3d3]">
      หากมีข้อสงสัยเกี่ยวกับการสมัคร เครดิตฟรี โปรโมชั่น เกมไลฟ์สด หรือการใช้งานบัญชี
      <strong class="text-[#fdf6e0]">สามารถติดต่อเจ้าหน้าที่ KINGDOM66 ผ่าน LINE OFFICIAL ได้ตลอด 24 ชั่วโมง</strong>
      ทีมงานพร้อมช่วยให้ข้อมูลและตรวจสอบปัญหาตามรายละเอียดที่แจ้ง
