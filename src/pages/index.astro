---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ProviderGridPremium from "../components/ProviderGridPremium.astro";
import ContentBoxTwo from "../components/ContentBoxTwo.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import LatestWinners from "../components/LatestWinnersCyber.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Faq from "../components/Faq2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// Title and description are the brief's own Title/Description lines, used
// verbatim. A brief-supplied description is never padded up to the 150-char
// floor and never topped up from the H1/H2.
const pageTitle = "HIX168 สล็อตปั่นแตกไว เล่นง่าย ได้เงินจริง ฝากถอนออโต้ ปลอดภัย การันตีเชื่อถือได้";

const pageDescription = "HIX168 เปิดระบบ เล่นสล็อตปั่นแตกไว ใช้งานง่าย ได้เงินจริง รอบรับฝากถอนออโต้ทุกช่องทาง ระบบกลางปลอดภัย การันตีเชื่อถือได้";

// The ticker copy is passed explicitly rather than relying on the component's
// default — every Announcement* variant's default belongs to whichever brand
// wired it in last. No emoji in this string: an emoji baked into a text prop
// cannot be given its own aria-hidden span, and this marquee prints the string
// twice.
const announcement =
  "HIX168 ให้บริการสล็อตออนไลน์ผ่านระบบที่ใช้งานง่ายทั้งบนมือถือและคอมพิวเตอร์ • มีเกมสล็อตหลายรูปแบบให้เลือก พร้อมอัปเดตระบบให้ค้นหาเกม จัดการบัญชี และทำรายการได้สะดวกขึ้น • Login เลือกค่าย ค้นหาเกม ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการได้จากบัญชีเดียว • โปรโมชั่นแนะนำเพื่อนรับโบนัส 0.8% ตามเงื่อนไข • โปรโมชั่นคืนยอดเสียรับโบนัส 0.3% ตามรอบที่กำหนด • ระบบฝากถอนออโต้ HIX168 รองรับช่องทางการเงินตามที่ระบบเปิดให้บริการ • เกมสล็อตมีผลลัพธ์ที่ไม่แน่นอน ควรกำหนดงบประมาณและตรวจสอบกติกาก่อนเล่นทุกครั้ง • แอดมิน HIX168 หลังบ้านออนไลน์ตลอด 24 ชั่วโมง";

// One array, used by both <Faq> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last.
const faqs = [
  {
    q: "HIX168 มีเกมสล็อตแตกไวและทำกำไรได้จริงหรือไม่?",
    a: "เกมสล็อตแต่ละเกมมีระบบและความผันผวนแตกต่างกัน จึงไม่มีเกมใดรับประกันว่าแตกไวหรือทำกำไรได้แน่นอน สมาชิกควรศึกษากติกา RTP และช่วงเดิมพันก่อนเล่น รวมถึงกำหนดงบประมาณให้ชัดเจน",
  },
  {
    q: "โปรโมชั่น HIX168 โบนัส 0.8% และ 0.3% รับอย่างไร?",
    a: "โบนัส 0.8% เป็นโปรโมชั่นแนะนำเพื่อนสำหรับรายการที่ตรงตามเงื่อนไข ส่วนโบนัส 0.3% เป็นโปรโมชั่นคืนยอดเสียตามรอบที่กำหนด สามารถตรวจสอบยอดและข้อกำหนดล่าสุดจากหน้าโปรโมชั่นก่อนกดรับได้",
  },
  {
    q: "หากฝากถอน HIX168 แล้วเครดิตไม่เข้าต้องทำอย่างไร?",
    a: "ควรตรวจสอบสถานะธุรกรรมในบัญชีก่อน หากรายการยังค้างหรือยอดไม่ถูกต้อง ให้ติดต่อแอดมิน HIX168 พร้อมแจ้งจำนวนเงิน เวลา และรายละเอียดรายการ เพื่อให้ทีมงานหลังบ้านช่วยตรวจสอบและแนะนำขั้นตอนดำเนินการต่อได้",
  },
];

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb. Every URL in the graph is derived
// by pageGraph from `site:` — no domain is typed out in this file.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <ContentBoxFloatingBadge as="h1" title="HIX168 สล็อตปั่นแตกไว แหล่งรวมเกมเล่นง่าย กำไรดี">
    <p class="text-left text-base leading-relaxed text-[#d6e2f5]">
      <strong class="text-[#8ec5ff]">HIX168</strong> พร้อมให้บริการสมาชิกที่ต้องการเล่นสล็อตออนไลน์ผ่านระบบที่ใช้งานง่ายบนมือถือและคอมพิวเตอร์ มีเกมสล็อตหลายรูปแบบให้เลือก พร้อมอัปเดตระบบเพื่อให้การค้นหาเกม
      จัดการบัญชี และทำรายการต่าง ๆ สะดวกขึ้น มีโปรโมชั่นแนะนำเพื่อน <span class="font-black text-[#6fb4ff]">0.8%</span> และคืนยอดเสีย
      <span class="font-black text-[#6fb4ff]">0.3%</span> ตามเงื่อนไข รวมถึงระบบฝากถอนออโต้และแอดมินหลังบ้านคอยช่วยตรวจสอบปัญหาตลอด 24 ชั่วโมง
    </p>
  </ContentBoxFloatingBadge>

  <ProviderGridPremium />

  <ContentBoxTwo as="h2" title="HIX168 อัปเดตระบบเกมใหม่ ใช้งานง่าย ระบบกลาง ดีขึ้นกว่าเดิมแน่นอน">
    <p slot="left" class="text-left text-base leading-relaxed text-[#d6e2f5]">
      <strong class="text-[#8ec5ff]">HIX168</strong> ปรับระบบให้สมาชิกเข้าถึงเกมสล็อตและฟังก์ชันต่าง ๆ ได้สะดวกมากขึ้น ไม่ว่าจะเป็นการ Login เลือกค่าย ค้นหาเกม ตรวจสอบเครดิต โปรโมชั่น หรือประวัติรายการ
      รองรับการใช้งานผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ ช่วยให้จัดการบัญชีได้จากอุปกรณ์ที่สะดวก โดยก่อนเข้าเล่นควรตรวจสอบกติกา ช่วงเดิมพัน และรายละเอียดของเกมแต่ละรายการให้ครบถ้วน
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#d6e2f5]">
      เกมสล็อตมีผลลัพธ์ที่ไม่แน่นอน คำว่า “แตกไว” หรือ “กำไรดี” ไม่สามารถรับประกันผลการเล่นได้ สมาชิกควรกำหนดงบประมาณและเลือกเดิมพันในระดับที่เหมาะสมกับตนเอง
    </p>
  </ContentBoxTwo>

  <LoginRtpSection />

  <ContentBox as="h2" title="โปรโมชั่น HIX168 สุดฮิตประจำวัน">
    <p class="text-left text-base leading-relaxed text-[#d6e2f5]">
      สมาชิกสามารถ Login <strong class="text-[#8ec5ff]">HIX168</strong> เพื่อตรวจสอบโปรโมชั่นที่เปิดให้รับในแต่ละวัน โดยมีทั้งโบนัสจากกิจกรรมแนะนำเพื่อนและโปรโมชั่นคืนยอดเสีย แต่ละรายการมีเปอร์เซ็นต์ วิธีคำนวณ
      รอบรับ และข้อกำหนดแตกต่างกัน จึงควรตรวจสอบรายละเอียดบนหน้าโปรโมชั่นก่อนกดรับสิทธิ์ทุกครั้ง
    </p>
  </ContentBox>

  <ContentBoxSevenThreePremium as="h3" title="โปรโมชั่นแนะนำเพื่อน โบนัส 0.8%">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อนของ HIX168 พื้นหลังสีน้ำเงินเข้มมีประกายแสงสีฟ้า ด้านบนเป็นโลโก้คำว่า HIX 168 สีขาว ถัดลงมาเป็นข้อความว่า โปรโมชั่น ในกรอบสีฟ้า และคำว่า แนะนำเพื่อน สีขาว พร้อมตัวเลข 0.8% ขนาดใหญ่ ด้านขวาเป็นนางแบบผมสีเงินยาวในชุดสีเงินเมทัลลิกกำลังชี้นิ้วมาทางข้อความ ด้านซ้ายมีกองชิปคาสิโนสีน้ำเงินและไพ่โพดำสองใบ ด้านขวามีวงล้อสล็อตเลข 7 พร้อมคันโยก"
      class="mx-auto h-auto w-full rounded-2xl border border-[#1e7bf5]/40 shadow-[0_10px_30px_rgba(30,123,245,0.28)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#d6e2f5]">
      สมาชิกสามารถนำลิงก์แนะนำส่วนตัวไปแชร์ให้เพื่อน เมื่อเพื่อนสมัครและมีรายการตรงตามข้อกำหนด ระบบจะคำนวณโบนัสแนะนำเพื่อน <span class="font-black text-[#6fb4ff]">0.8%</span> ตามเงื่อนไข สามารถติดตามจำนวนผู้สมัครจากลิงก์
      ยอดที่เข้าเกณฑ์ และโบนัสที่มีสิทธิ์รับผ่านบัญชีสมาชิกได้ด้วยตนเอง
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBoxSevenThreePremium as="h3" title="โปรโมชั่นคืนยอดเสีย โบนัส 0.3%">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นคืนยอดเสียของ HIX168 พื้นหลังสีน้ำเงินเข้มมีลำแสงสีฟ้า ด้านบนเป็นโลโก้คำว่า HIX 168 สีขาว ถัดลงมาเป็นข้อความว่า โปรโมชั่น ในกรอบสีฟ้า และคำว่า คืนยอดเสีย สีขาว พร้อมตัวเลข 0.3% ขนาดใหญ่ ด้านขวาเป็นนางแบบผมสีเงินยาวในชุดสีเงินกำลังชี้นิ้วลงมาที่ตัวเลข ด้านซ้ายมีกองชิปคาสิโนสีน้ำเงินและสัญลักษณ์โพดำ ด้านขวามีวงล้อสล็อตเลข 7 สีแดง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#1e7bf5]/40 shadow-[0_10px_30px_rgba(30,123,245,0.28)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#d6e2f5]">
      หากสมาชิกมียอดเสียตรงตามข้อกำหนด สามารถตรวจสอบสิทธิ์รับโบนัสคืนยอดเสีย <span class="font-black text-[#6fb4ff]">0.3%</span> ตามรอบที่ <strong class="text-[#8ec5ff]">HIX168</strong> กำหนด ระบบจะแสดงยอดที่นำมาคำนวณและโบนัสที่สามารถรับได้
      ก่อนกดรับควรตรวจสอบประเภทเกม รอบเวลา และเงื่อนไขการถอนโบนัสให้เรียบร้อย
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBoxSpecial as="h2" title="ระบบฝากถอนออโต้ HIX168 รองรับทุกช่องทาง">
    <p slot="left" class="text-left text-base leading-relaxed text-[#d6e2f5]">
      ระบบฝากถอนออโต้ <strong class="text-[#8ec5ff]">HIX168</strong> ช่วยให้สมาชิกจัดการเครดิตผ่านบัญชีของตนเองได้ โดยสามารถตรวจสอบช่องทางฝากเงิน ส่งคำขอถอน และติดตามสถานะรายการผ่านหน้าเว็บไซต์ รองรับช่องทางการเงินตามที่ระบบเปิดให้บริการ
      ช่วยลดขั้นตอนในการทำธุรกรรมและสามารถใช้งานผ่านมือถือได้ตลอดทั้งวัน
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#d6e2f5]">
      สำหรับธนาคาร วอลเลท ยอดฝากขั้นต่ำ ยอดถอน และวงเงินต่อรายการ ควรตรวจสอบข้อมูลล่าสุดที่หน้าเว็บไซต์ก่อนยืนยันธุรกรรม เนื่องจากช่องทางและข้อกำหนดอาจแตกต่างกันในแต่ละช่วงเวลา
    </p>
  </ContentBoxSpecial>

  <LatestWinners />

  <ContentBoxTwoNeumorphism as="h2" title="แอดมิน HIX168 หลังบ้าน ออนไลน์ตลอด 24 ชั่วโมง">
    <p slot="left" class="text-left text-base leading-relaxed text-[#d6e2f5]">
      หากพบปัญหา Login ไม่ได้ ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง โปรโมชั่นไม่แสดง หรือไม่สามารถเข้าเกมสล็อตได้ สามารถติดต่อแอดมิน <strong class="text-[#8ec5ff]">HIX168</strong>
      ได้ตลอด 24 ชั่วโมง พร้อมแจ้งรายละเอียด เวลา และข้อมูลรายการที่เกี่ยวข้อง เพื่อให้เจ้าหน้าที่หลังบ้านช่วยค้นหารายการและตรวจสอบปัญหาได้ตรงจุด
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#d6e2f5]">
      สมาชิกใหม่ยังสามารถสอบถามขั้นตอนสมัคร วิธีฝากถอน การรับโปรโมชั่น หรือการใช้งานส่วนต่าง ๆ ของระบบได้ โดยไม่ควรส่งรหัสผ่านหรือ OTP ให้บุคคลอื่น
    </p>
  </ContentBoxTwoNeumorphism>

  <ReviewCardSumo />

  <Faq title="คำถามที่พบบ่อยเกี่ยวกับ HIX168" faqs={faqs} />

  <Navfoot />
</MainLayout>
