//    3 H2  อัตราจ่าย หวย ${BRAND_NAME} จ่ายสูงไม่อั้น
//          ContentBoxCyberCut, line 8
//    4 H3  อัตราจ่าย หวย 2 ตัว 100          ContentBoxTwoPremium left column, line 10
//    5 H3  อัตราจ่าย หวย 3 ตัว 1,000        ContentBoxTwoPremium right column, line 12
//    6 H2  โปรโมชั่นแทงหวย ${BRAND_NAME} รับได้ไม่จำกัดยูส
//          ContentBoxSpecial, line 14 run one paragraph half per column
//    7 H3  โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสทุกวัน
//          ContentBoxSevenThreePremium + slide2, line 16 left / picture right
//    8 H3  โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด
//          ContentBoxSevenThreeNeumorphism + slide1, line 18 left / picture right
//    9 H2  ${BRAND_NAME} รองรับการฝากถอนวอลเลทและธนาคารชั้นนำ
//          ContentBoxTwoNeumorphism, line 20 split into two halves
//   10 H2  ช่องทางติดต่อแอดมิน ${BRAND_NAME} ตลอด 24ชม.
//          ContentBox3Three (base), line 22 split across its three columns
//   11 H2  คำถามที่พบบ่อยเกี่ยวกับ ${BRAND_NAME}
//          Faq3 + explicit faqs prop, lines 24-29
// Final inventory for this page: h1 x1, h2 x6, h3 x4 — brand-spec §7's target.
//
// ⚠️ §4 and §5 are the ONE place this page passes heading={true}. ContentBoxTwoPremium's
// column labels default to <p> because on most briefs a two-column split is the page's own
// wording — but here the two labels ARE the brief's own H3 lines, so they opt in and render
// at as="h3". The box is passed NO `title` for the same reason: their parent H2 is §3's
// ContentBoxCyberCut above, and a `title` here would add a seventh h2 the brief never wrote.
// `label` names that <section> for assistive tech instead.
//
// Both ContentBoxSevenThree* variants lay out md:grid-cols-[7fr_3fr] with the TEXT column
// FIRST, so each picture goes in slot="right": the heading always lands on the prose, never
// on the picture, and on a phone the single column reads heading, text, picture rather than
// opening with an image. Neither is passed a `titleright`, so neither image column carries a
// heading and each block emits exactly one. Both take the same prop name (`title`) for that
// heading, unlike the Huay/CyberCut pair the previous brand used.
// No block on this page uses a floating badge, so there is no -top-6 clearance arithmetic to
// redo this round.
// ContentBox3ThreePremium, ContentBoxSpecial, ContentBoxTwoNeumorphism and ContentBox3Three
// are passed no column labels — the brief gives §2, §6, §9 and §10 one running paragraph each
// with no sub-labels, and inventing a set here would be this page's own wording rather than
// the docx's. Both 3Three boxes therefore emit no per-column tag at all, which is what stops
// them adding six headings the brief never wrote, and their default icons stay unrendered.
//
// Every brief paragraph ships in full — nothing merged, nothing summarised. §2 runs one third
// per column, §6 one half per column, §9 one half per column, §10 one third per column, and
// NO slot receives more than one element, so the house rule's "one element per slot" holds
// everywhere without a wrapper <div> being needed.
//
// Everything else on the page is chrome and emits no heading tag at any level: Announcement5,
// LatestWinnersPremium and ReviewCardSumo2 render their titles as <p>/<span> with an
// aria-label on the section, and the FAQ's questions live inside <summary>. The non-brief
// widgets sit before section 1 (the ticker, then the winners feed) and after section 11 (the
// review ledger, then Navfoot) — never spliced between two content sections.

// One array, used by both <Faq> and the FAQPage node — never the component's own defaults
// (Faq3 deliberately ships an empty list, so a forgotten prop renders an empty accordion
// rather than some previous brand's questions). The three pairs are the brief's own Q/A block
// (content.txt lines 24-29), verbatim; only the "1." / "2." / "3." list markers are dropped,
// since the accordion is the list.
const faqs = [
  {
    q: `${BRAND_NAME} มีหวยประเภทไหนให้เลือกบ้าง?`,
    a: `ตามข้อมูลที่ระบุ ${BRAND_NAME} นำเสนอหวยรัฐบาลไทย ลาวพัฒนา ฮานอย และหวยหุ้นต่างประเทศ โดยควรตรวจสอบรายการที่เปิดให้บริการจริงและรอบปิดรับของแต่ละประเภทจากเว็บไซต์ก่อนทำรายการ`,
  },
  {
    q: `อัตราจ่ายหวย 2 ตัว 100 และ 3 ตัว 1,000 ใช้ได้กับหวยทุกประเภทหรือไม่?`,
    a: `ยังไม่สามารถยืนยันได้ว่าใช้อัตราเดียวกันกับหวยทุกประเภท ผู้ใช้งานควรตรวจสอบตารางอัตราจ่าย ฐานเงินเดิมพัน และข้อจำกัดของแต่ละรายการจากข้อมูลล่าสุดก่อนยืนยันบิล`,
  },
  {
    q: `หากฝากเงินแล้วไม่เข้าระบบหรือมีปัญหาเกี่ยวกับบิลหวย ควรทำอย่างไร?`,
    a: `ควรตรวจสอบสถานะรายการและเก็บหลักฐานที่เกี่ยวข้อง จากนั้นติดต่อเจ้าหน้าที่ผ่านช่องทางทางการของ${BRAND_NAME} หากสงสัยว่ามีการโอนเงินไปยังบัญชีแอบอ้าง ควรแจ้งธนาคารหรือผู้ให้บริการชำระเงินโดยเร็ว`,
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own sentence. Thai
// has no inter-word space, so a highlight that starts or ends mid-word lets the formatter
// break the line inside the tag and render a space that splits the word — the copy must read
// identically with the tags removed. No two <strong> elements are adjacent either: every pair
// is separated by at least one run of plain text, so the whitespace between them can never
// collapse into a missing space.
// One highlight colour only: #8f0505 (brand-spec §2 reserves the deep red for exactly this
// job at 9.6:1 on a white card), against the inherited body colour #4a0f0f (= BRAND_TEXT).
// ⚠️ The lead crimson #c30303 is NOT available for this — §2 confines it to headings, fills,
// borders and auras — the scarlet #e81313 may never carry text at all, and the antique gold
// is not available anywhere on this page's light cards. The paragraphs below carry no colour
// class of their own: every ContentBox* card in this mix already sets
// `text-left text-base leading-relaxed text-[#4a0f0f]` on the element holding the slot, so
// the prose inherits it and no page-level override can drift from the card. No paragraph
// carries mx-auto or max-w-* either — the cards cap their own width, and the only max-w-* on
// the page are the two capping the slides, which are images and not prose. No slot's copy
// names a colour.

// No breadcrumb: this is the homepage, so a trail from the root to itself would be a single
// self-referential crumb. Every URL in the graph is derived by pageGraph from `site:` — no
// domain is typed out in this file, no URL is built with `+`, and no Review / AggregateRating
// / sameAs / address / email node is passed. `description` is the exact same string MainLayout
// gets, and `faqs` is the exact same array <Faq> gets.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <LatestWinners />

  <ContentBoxPremium as="h1" title={`${BRAND_NAME} ช่องทางเล่นหวยออนไลน์ ระบบจริงจากเว็บแม่ ไม่มีประวัติโกง`}>
    <p>
      {BRAND_NAME} นำเสนอช่องทางหวยออนไลน์ที่รวบรวมข้อมูลหวยหลายประเภทไว้ในเว็บไซต์เดียว
      <strong class="text-[#8f0505]">ทั้งหวยรัฐบาลไทย ลาวพัฒนา ฮานอย และหวยหุ้นต่างประเทศ</strong>
      พร้อมรายละเอียดอัตราจ่าย โปรโมชั่น และระบบฝากถอนสำหรับสมาชิก ผู้ใช้งานสามารถตรวจสอบรอบเปิดรับและเงื่อนไขของแต่ละรายการก่อนทำธุรกรรม
      <strong class="text-[#8f0505]">ส่วนข้อมูลเกี่ยวกับบริษัทแม่และประวัติการให้บริการควรตรวจสอบจากหลักฐานที่เชื่อถือได้</strong>
    </p>
  </ContentBoxPremium>

  <ContentBox3ThreePremium as="h2" title={`${BRAND_NAME} ช่องทางเล่นหวยออนไลน์ รัฐบาลไทย ลาวพัฒนา ฮานอย หุ้นต่างประเทศ`}>
    <p slot="left">
      {BRAND_NAME} รวบรวมข้อมูลหวยออนไลน์หลายประเภทเพื่อให้ผู้ใช้งานศึกษารายละเอียดได้จากช่องทางเดียว
    </p>
    <p slot="center">
      ไม่ว่าจะเป็น
      <strong class="text-[#8f0505]">หวยรัฐบาลไทยที่อ้างอิงผลสลากกินแบ่งรัฐบาล หวยลาวพัฒนา หวยฮานอย และหวยหุ้นต่างประเทศ</strong>
      ที่มีรอบประกาศผลแตกต่างกัน
    </p>
    <p slot="right">
      ผู้สนใจควรตรวจสอบวันเวลาเปิดรับ อัตราจ่าย แหล่งอ้างอิงผลรางวัล และข้อกำหนดของแต่ละประเภทก่อนทำรายการ
      <strong class="text-[#8f0505]">เพื่อป้องกันความเข้าใจคลาดเคลื่อนเกี่ยวกับรอบหวยและผลการตรวจรางวัล</strong>
    </p>
  </ContentBox3ThreePremium>

  <ContentBoxCyberCut as="h2" title={`อัตราจ่าย หวย ${BRAND_NAME} จ่ายสูงไม่อั้น`}>
    <p>
      {BRAND_NAME} นำเสนอข้อมูลอัตราจ่ายหวยสำหรับผู้ที่ต้องการศึกษารายละเอียดก่อนทำรายการ
      <strong class="text-[#8f0505]">โดยมีตัวอย่างอัตราจ่ายเลข 2 ตัว 100 และเลข 3 ตัว 1,000</strong>
      ตามที่ระบุไว้ในข้อมูลโปรโมชั่น อย่างไรก็ตาม อัตราจ่ายจริงอาจขึ้นอยู่กับประเภทหวย รูปแบบการเดิมพัน และเงื่อนไขของแต่ละรอบ
      <strong class="text-[#8f0505]">ผู้ใช้งานควรตรวจสอบตารางอัตราจ่ายล่าสุด รวมถึงข้อจำกัดยอดรับและวงเงินจ่ายสูงสุดก่อนยืนยันรายการทุกครั้ง</strong>
    </p>
  </ContentBoxCyberCut>

  <ContentBoxTwoPremium
    as="h3"
    heading={true}
    label={`อัตราจ่าย หวย ${BRAND_NAME}`}
    titleleft="อัตราจ่าย หวย 2 ตัว 100"
    titleright="อัตราจ่าย หวย 3 ตัว 1,000">
    <p slot="left">
      อัตราจ่ายหวย 2 ตัว 100 เป็นรูปแบบที่ระบุไว้สำหรับการเดิมพันเลขสองหลัก
      <strong class="text-[#8f0505]">โดยผู้ใช้งานควรตรวจสอบก่อนว่าอัตราดังกล่าวคิดต่อเงินเดิมพันจำนวนเท่าใด และครอบคลุมรายการสองตัวบนหรือสองตัวล่างหรือไม่</strong>
      เนื่องจากหวยแต่ละประเภทอาจมีหลักเกณฑ์แตกต่างกัน นอกจากนี้ควรอ่านเงื่อนไขเกี่ยวกับเลขอั้น การจำกัดยอดรับ และการคำนวณเงินรางวัลจากตารางทางการก่อนทำรายการ
      <strong class="text-[#8f0505]">เพื่อให้เข้าใจอัตราจ่ายตามข้อกำหนดจริง</strong>
    </p>
    <p slot="right">
      อัตราจ่ายหวย 3 ตัว 1,000 เป็นข้อมูลสำหรับผู้ที่ต้องการตรวจสอบรูปแบบการจ่ายรางวัลเลขสามหลัก
      <strong class="text-[#8f0505]">โดยควรศึกษาว่าอัตราดังกล่าวใช้กับสามตัวตรง สามตัวโต๊ด หรือรายการประเภทใด</strong>
      รวมถึงตรวจสอบฐานเงินเดิมพันที่ใช้คำนวณและวงเงินจ่ายสูงสุดของแต่ละรอบ เพราะเงื่อนไขอาจแตกต่างกันตามประเภทหวย ก่อนยืนยันรายการควรตรวจสอบหมายเลขที่เลือกและอัตราจ่ายให้ถูกต้อง
      <strong class="text-[#8f0505]">เนื่องจากผลรางวัลไม่สามารถคาดการณ์หรือรับประกันได้</strong>
    </p>
  </ContentBoxTwoPremium>

  <ContentBoxSpecial as="h2" title={`โปรโมชั่นแทงหวย ${BRAND_NAME} รับได้ไม่จำกัดยูส`} iconleft="🎁" iconright="📋">
    <p slot="left">
      {BRAND_NAME} นำเสนอข้อมูลโปรโมชั่นสำหรับสมาชิกที่สนใจสิทธิพิเศษจากการใช้บริการหวยออนไลน์
      <strong class="text-[#8f0505]">โดยมีรายการคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8%</strong>
      ซึ่งแต่ละโปรโมชั่นอาจมีข้อกำหนดเกี่ยวกับประเภทหวย ยอดที่นำมาคำนวณ รอบรับเครดิต และจำนวนบัญชีที่เข้าร่วมแตกต่างกัน
    </p>
    <p slot="right">
      <strong class="text-[#8f0505]">ผู้ใช้งานควรอ่านเงื่อนไขล่าสุดก่อนรับสิทธิ์ รวมถึงตรวจสอบว่าโปรโมชั่นสามารถใช้ร่วมกันได้หรือไม่</strong>
      เพื่อให้เข้าใจรายละเอียดอย่างครบถ้วน
    </p>
  </ContentBoxSpecial>

  <ContentBoxSevenThreePremium as="h3" title="โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสทุกวัน">
    <p slot="left">
      โปรโมชั่นคืนยอดเสีย 0.3% เป็นรายการที่ระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขในแต่ละวัน
      <strong class="text-[#8f0505]">สมาชิกควรตรวจสอบว่าหวยรัฐบาลไทย ลาวพัฒนา ฮานอย หรือหวยหุ้นต่างประเทศประเภทใดเข้าร่วมรายการ</strong>
      รวมถึงศึกษารอบคำนวณยอดและวิธีรับเครดิตให้ชัดเจน เนื่องจากหวยแต่ละประเภทมีรอบประกาศผลไม่เหมือนกัน ก่อนเข้าร่วมควรอ่านข้อกำหนดการใช้โบนัสและการถอนเงินให้ครบถ้วน
      <strong class="text-[#8f0505]">ทั้งนี้ เครดิตคืนยอดเสียไม่ได้รับประกันผลตอบแทนจากการเดิมพันครั้งต่อไป</strong>
    </p>
    <Picture
      slot="right"
      src={promoCashback}
      loading="lazy"
      fetchpriority="low"
      widths={[297, 480, 540]}
      sizes="(max-width: 637px) calc(100vw - 98px), (max-width: 767px) 540px, (max-width: 1279px) calc(30vw - 87px), 297px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={64}
      alt={`โปสเตอร์โปรโมชั่นของ ${BRAND_NAME} เป็นภาพแนวตั้ง ฉากวัดไทยริมน้ำกลางแดด มีเจดีย์และยอดปรางค์ทองหลายองค์กับต้นไม้เขียวเป็นฉากหลัง ฝั่งซ้ายเป็นชายหนุ่มผมสั้นสีดำ สวมชุดไทยลายปักทองพร้อมสร้อยและกำไลทอง มือถือใบสลากคลี่เป็นพัด ฝั่งขวาเป็นหญิงสาวผมยาวสีดำทัดดอกไม้ขาว สวมชุดไทยสไบลายทองพร้อมต่างหูและสร้อยทอง มือถือใบสลากคลี่เป็นพัดเช่นกัน ด้านบนเป็นโลโก้ ${BRAND_NAME} กลางภาพเป็นคำว่า โปรโมชั่น ตัวอักษรไทยสามมิติสีทองตัวโตบนริบบิ้นแดง ใต้ลงมาเป็นแผ่นป้ายพื้นดำขอบทองเขียนว่า คืนยอดเสีย ต่อท้ายด้วยเลข 0.3% ตัวโต ด้านล่างมีเหรียญทอง ดอกบัวขาว ใบสลาก และลูกบอลหวยขาว-ดำเลข 6 กับ 3`}
      class="mx-auto h-auto w-full max-w-[540px] rounded-2xl border border-[#c30303]/60 shadow-[0_10px_28px_rgba(74,15,15,0.2)]"
    />
  </ContentBoxSevenThreePremium>

  <ContentBoxSevenThreeNeumorphism as="h3" title="โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด">
    <p slot="left">
      โปรโมชั่นแนะนำเพื่อนโบนัส 0.8% เป็นรายการที่ระบุสิทธิ์สำหรับสมาชิกที่แนะนำผู้ใช้งานรายใหม่
      <strong class="text-[#8f0505]">โดยควรตรวจสอบวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และยอดที่ใช้คำนวณโบนัสให้ครบถ้วน</strong>
      แม้โปรโมชั่นจะระบุว่าไม่จำกัด แต่ควรยืนยันรายละเอียดเกี่ยวกับจำนวนบัญชีที่เข้าร่วม รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุด
      <strong class="text-[#8f0505]">เพื่อให้ทราบหลักเกณฑ์การรับสิทธิ์อย่างถูกต้องและไม่เกิดความคลาดเคลื่อนเกี่ยวกับยอดโบนัส</strong>
    </p>
    <Picture
      slot="right"
      src={promoReferral}
      loading="lazy"
      fetchpriority="low"
      widths={[344, 480, 540]}
      sizes="(max-width: 637px) calc(100vw - 98px), (max-width: 767px) 540px, (max-width: 1399px) calc(30vw - 77px), 344px"
      decoding="async"
      formats={["avif", "webp"]}
