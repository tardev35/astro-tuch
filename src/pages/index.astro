---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement2.astro";
import LatestWinners from "../components/LatestWinners2.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBox3Three from "../components/ContentBox3Three.astro";
import ContentBox from "../components/ContentBox.astro";
import Faq from "../components/Faq2.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import { pageGraph } from "../lib/schema";
import promoReferral from "../assets/slide1.png";
import promoCashback from "../assets/slide2.png";

// VARIANT ROTATION THIS ROUND, decided in .claude/brand-spec-sabuybet168.md §3 and NOT
// re-picked here: Announcement2 replaces Announcement6, LatestWinners2 replaces the BASE
// LatestWinners, Faq2 replaces the BASE Faq, the BASE ReviewCardSumo replaces
// ReviewCardSumo2, and the ContentBox shape-mix leaves Premium / CyberCut / Special /
// SevenThreeNeumorphism / SevenThreeCyberCut / 3ThreePremium / TwoPremium behind for
// FloatingBadge / Neumorphism / TwoNeumorphism / SevenThreePremium / SevenThree /
// 3Three / plain ContentBox. NavbarStyle9 + FooterStyle2 are the layout's pair this
// round and the brand font moves kanit -> google-sans; all of that is the orchestrator's
// shared-chrome step, not this page's.
// ⚠️ Plain ContentBox IS in this round's mix (§7) and is also the always-live box that
// terms, privacy, 404, /promotion and the button pages render through — it sits in the
// shared-chrome set either way. ContentBoxTwo is live too but is NOT imported here: it is
// reached only through LoginRtpSection, so an "is it used?" grep has to match the bare
// filename rather than the components/ path.
// Every unused *Premium / *Cyber / *Huay / *CyberCut / *Special / *Style sibling, the
// other Faq* and Announcement* files, the other LatestWinners* and ReviewCardSumo2 all
// stay on disk as inventory for the next brand — nothing was deleted, and the earlier
// brands' hues still inside them are expected drift.
//
// <Announcement /> runs bare on purpose: Announcement2's default message is already this
// brand's copy, set from this brief, and every sub-page calls it bare too — so passing an
// override here is exactly how the ticker ends up saying two different things on two
// pages of the same site.
//
// PALETTE — SKY BLUE LEADS, GOLD IS THE SECOND HUE, DEEP BLUE NEVER CARRIES TEXT, ON PURE
// BLACK (brand-spec §2). Read off the artwork: the logo is a white-and-orange cartoon cat
// with a closed-eye smile and a BLUE collar with a gold bell, raising one paw beside a
// BLUE phone showing a download arrow and a stack of BLUE banknotes, ringed by gold
// bitcoin coins and BLUE hearts, above the word สบาย in thick 3-D GOLD Thai lettering
// followed by เบท168 in glossy 3-D BUBBLE BLUE. The banner is the same black scene with a
// silver-blonde woman in blue satin bows and white-and-blue lace, a phone beside her
// showing a blue tick and the words ถอนสำเร็จ, a gift box tied with a blue ribbon, and
// blue light arcs sweeping the frame.
// ⚠️ The thing that separates this round from the one before it is WHICH HUE LEADS, and
// this round changes the family outright: ถอนชัวร์168 was BUBBLEGUM PINK fa63b9 leading
// BUTTER GOLD ffd84d on plum-black. This round is SKY BLUE #2f9ff5 leading GOLD #ffc82e
// on pure black — a hue not used in any of the last four rounds.
// ⚠️ The page background is PURE BLACK #000000 (bg.json). Depth ramp: #0e2238 raised /
// #081726 mid / #040d16 sunken / #000000 page — nothing sinks below the page.
// ⚠️ Compare by VALUE, never by colour family — BLUE IS ITS OWN TRAP HERE, because
// several earlier brands in this repo were blue too. This round's blue is #2f9ff5 (R=47
// G=159 B=245) with light partner #a8dcff and deep #0b3f78; NOT 0a84e0 / 04203f / e4f1fd
// (HI59, still the values sitting in several inventory files), not 04225b, not 2563eb.
// This round's gold is #ffc82e (R=255 G=200 B=46) and nothing else: not ffd84d
// (ถอนชัวร์168), fcd434 / ffeaa0 (มีโชค168), f7c92b / ffe6a3 (ขวัญใจ168), f0b429
// (รับตัง168), e3b23c (สมหวัง168), dfa310, f2c230, e2b33f, e5a81b, fad354, f5c518, fce343,
// f3bb34, fbe455, f2b705 or ffd666.
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// Body copy is #e8f4ff (= BRAND_TEXT), 17.6:1 on the page and 15.4:1 on the raised
// surface. The ONE highlight colour a <strong> may take is #ffc82e (11.3:1). #2f9ff5
// (5.9:1 on card) and #a8dcff (11.6:1) carry headings, links and secondary labels.
// #0b3f78 (1.5:1) and #5c4a16 (2.1:1) never carry text at any size: borders, plates,
// rules, gradient ends and auras only. #04121f is the only ink allowed on a solid blue or
// solid gold fill. Glow rgba is rgba(47,159,245,α), rgba(255,200,46,α),
// rgba(168,220,255,α) or rgba(11,63,120,α).
// ⚠️ No pink, purple/violet, green, orange, red, rose-gold or silver/chrome this round.
// fdeaf5 is ถอนชัวร์168's body colour and f6e4ee is มีโชค168's — if either is anywhere, it
// is stale.
//
// IMAGE ROLES FOR THIS DROP (2026-10-19, brand-spec §5). Exactly TWO files are referenced
// from this page, both from this drop, and THE TEXT PRINTED ON THE ART is what decides
// the pairing:
//   slide2.png -> §4, because its own plaque reads คืนยอดเสีย with 0.3% under it
//   slide1.png -> §5, because its own plaque reads แนะนำเพื่อน with 0.8% under it
// Both alts below were written from THIS drop's bitmaps, opened and read with the Read
// tool; neither is copied from a spec table and neither is a counter.
// Deliberately NOT imported, and every file still on disk as inventory: banner2.png
// (10-08) and banner3.png (09-27) are previous brands' article art, and slide3.png /
// slide4.png (09-29) are an older brand's posters. An eager import IS an emit, rendered or
// not, so importing any of them would ship a competitor's picture into dist/ and turn
// verify-build red. There is therefore NO current-drop article illustration this round,
// and a slide is never substituted for one — the playbook pins slide* to
// ContentBoxSevenThree* blocks only, and these two are the round's full 2-block budget.
// banner1 and its mobile crop belong to MainLayout's own pinned globs and are never
// referenced from a page; og.png is the same, MainLayout owns it.
// ⚠️ Both slides are 600x600 SQUARE on disk this round — last round's pair was 600x351,
// so the width lists are NOT carried over: 600 is the top real candidate (anything above
// it would not be a real pixel) and each picture carries max-w-[600px] so the art is never
// upscaled past its own bitmap. The two `sizes` lists are NOT interchangeable either —
// each is the 3fr-column arithmetic from inside the variant that actually holds that
// picture, and the two variants cap, pad and rule differently:
//   §4 ContentBoxSevenThreePremium — max-w-7xl/1280 section, px-4, border 1x2, md:p-10,
//      gap-10, image column md:border-l + md:pl-10 = 41:
//        >= 1280px : (1280 - 32 - 2 - 80 - 40) x 0.3 - 41 = 297px
//        md..1279  : calc(30vw - 87px)
//        698..767  : 600px (bitmap cap)
//        < 698     : calc(100vw - 98px)
//   §5 ContentBoxSevenThree — max-w-[1400px] section, px-4, border 1x2, md:p-10, gap-8,
//      image column md:pl-6 = 24 (the RULE is md:border-r on the text column, so the
//      image column deducts padding only):
//        >= 1400px : (1400 - 32 - 2 - 80 - 32) x 0.3 - 24 = 352px
//        md..1399  : calc(30vw - 68px)
//        698..767  : 600px (bitmap cap)
//        < 698     : calc(100vw - 98px)
// Neither picture is the LCP element — MainLayout's hero banner is — so both are
// loading="lazy" fetchpriority="low" decoding="async" and neither ever takes
// fetchpriority="high". formats/fallbackFormat stay at the house values, and quality is
// still ONE number for both formats — tools/avif-quality-service.mjs rescales the AVIF
// side on its own (x0.65), so it must never be hand-tuned per format.
//
// quality={64}, not the usual 80, carried over because the measurement that produced it
// still applies: both of this drop's slides are dark artwork with heavy fine grain
// (falling coins, bitcoin, satin bows, lace, bokeh), which is the case AVIF handles worst.
// At 80 that is exactly the shape that comes out LARGER than its own WebP fallback at
// every emitted width, and verify-build.mjs fails the build on precisely that. 64 is the
// value already proven to win on this art style; the fix is always a LOWER quality, never
// a higher one. Same number on /promotion for the same two slides.
// Also deliberately unused, and named without the file extension on purpose because the
// playbook's "is this component live?" check is a bare-filename grep: ProviderGrid is
// banned by brand-spec §6 because this brief names NO game studio at all; GameRankingBoard
// has no ranking to carry; SmoothCarousel has no brief section asking for a carousel;
// BankStrip already renders inside the active footer; and FeatureHighlights is banned too,
// because its items render as <h3> and the only two h3s this page may have are the brief's
// own.
//
// VOCABULARY — brand-spec §6, the brief's own words only. This is a PURE SLOT brand whose
// subject is BEING THE OFFICIAL CHANNEL. Everything the copy says traces to
// src/assets/content.txt: เว็บสล็อตทางการ, ผู้ให้บริการฐานเกมหลัก, เว็บแท้อันดับ1,
// เว็บแท้100%, เกมสล็อตออนไลน์, สมัครสมาชิก, เข้าสู่ระบบ, ฝากถอน, โปรโมชั่น,
// คืนยอดเสีย 0.3%, แนะนำเพื่อน 0.8%, เครดิต, ยอดเสีย, รอบสรุปยอด, รหัสแนะนำ, ค่ายเกม,
// กติกา, เงื่อนไขบริการ, LINE Official, QR Code, บัญชีที่แอบอ้าง, รหัสผ่าน, รหัส OTP,
// เจ้าหน้าที่, นโยบายข้อมูลส่วนบุคคล, คุณสมบัติผู้ใช้งาน, 3 ขั้นตอน, 24ชม.
// ⚠️ มีโชค168's phrases เว็บสล็อตลิขสิทธิ์แท้, นำเข้าตรงจากสิงคโปร์, PG SOFT, JOKER, JILI
// and ถอนชัวร์168's ถอนง่าย, ไม่มีรีวิวเสีย, หลักแสนยูสต่อวัน, การันตีเว็บแท้ are all GONE.
// **This brief names NO game studio whatsoever**, so no studio name appears anywhere on
// this page — the brief's own neutral word ค่ายเกม is used instead. There is no คาสิโน,
// บาคาร่า, รูเล็ต, ไฮโล, ยิงปลา, บอล/แทงบอล/กีฬา, อัตราต่อรอง, หวย/แนวทาง/ตรวจหวย,
// เว็บตรง, ไม่ผ่านเอเย่นต์, แตกง่าย, ไม่มีขั้นต่ำ, บัญชีม้า or ออโต้ 1 วินาที anywhere
// here. Nothing claims a licence number, a regulator, a legal-entity name, a bank, an RTP
// figure, a deposit minimum, a member count or a founding year. The only figures on the
// page are the brief's own: 0.3%, 0.8%, 100%, 3 ขั้นตอน, 24ชม. and อันดับ1.
// ⚠️ This brief HEDGES UNUSUALLY HARD — it says of itself that คำกล่าวอ้างเกี่ยวกับการเป็น
// เว็บหลักหรือเว็บอันดับหนึ่ง ควรพิจารณาร่วมกับข้อมูลผู้ให้บริการ หลักฐานการอนุญาต, and
// that เครดิตคืนยอดเสียไม่ใช่การรับประกันผลตอบแทนจากการเดิมพัน. EVERY hedging clause ships
// in full — they are brief content, not downbeat filler to be trimmed — and nothing here
// is written up into the advertising claim the brief is warning about. The boastful
// phrases (เว็บแท้อันดับ1 · เว็บแท้100% · ผู้ให้บริการฐานเกมหลัก) appear only inside the
// docx's own headings, never as a sentence this page asserts on its own.
//
// The brief, the artwork and the operator's prompt all agree on the brand name. Even so
// the name is never typed on the page: it is interpolated from ${BRAND_NAME} so it can
// never drift from brandProfile, including inside the two alts. No domain is written out
// anywhere here and no URL is built with `+`.
//
// Title and description are the brief's own Title / Description lines (content.txt lines
// 1-2) verbatim, with the brand name interpolated. The description is NOT padded up to 150
// characters — verify-build deliberately skips its 150-character floor on the home page
// for exactly this reason.
const pageTitle = `${BRAND_NAME} เว็บสล็อตทางการ ผู้ให้บริการฐานเกมหลัก เว็บแท้อันดับ1`;

const pageDescription = `${BRAND_NAME} เว็บสล็อตทางการ ศูนย์ผู้ให้บริการ ฐานเกมเดิมพันออนไลน์ ช่องทางหลัก เว็บแท้อันดับ1`;

// The brief has a real H2 -> H3 nesting this round, so the page is NOT flattened to
// H2-only. The two H3s are the docx's own H3 lines (content.txt lines 9 and 11) — the two
// promotion sub-points that sit under section 3's โปรโมชั่น H2 in the brief's own outline.
// There is no FeatureHighlights H3 exception this round, and no component rendered here
// emits a hardcoded heading, so the printed h3 count stays at exactly 2.
//
// The checklist, in document order, and what carries each one:
//    1 H1  ${BRAND_NAME} เว็บสล็อตทางการ ผู้ให้บริการฐานเกมหลักที่ดีที่สุด
//          ContentBoxFloatingBadge, brief paragraph on line 4
//    2 H2  ${BRAND_NAME} ช่องทางเล่นสล็อตเว็บหลัก เว็บแท้อันดับ1
//          ContentBoxNeumorphism, line 6
//    3 H2  โปรโมชั่นเข้าเล่นเว็บสล็อต ${BRAND_NAME} เว็บแท้100%
//          ContentBoxTwoNeumorphism, line 8 run one paragraph half per column
//    4 H3  โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสทุกวัน
//          ContentBoxSevenThreePremium + slide2, line 10 left / picture right
//    5 H3  โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด
//          ContentBoxSevenThree + slide1, line 12 left / picture right
//    6 H2  สมัครเข้าเล่นสล็อต ${BRAND_NAME} ได้ทุกค่ายง่ายๆ 3 ขั้นตอน
//          ContentBox3Three heading={false}, line 14 intro + steps 15-20
//    7 H2  ช่องทางติดต่อแอดมิน ${BRAND_NAME} ทาง LINE OFFICIAL 24ชม.
//          ContentBox (the base variant), line 22
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ ${BRAND_NAME}
//          Faq2 + faqs prop, lines 24-29
// Final inventory for this page: h1 x1, h2 x5, h3 x2.
//
// Both ContentBoxSevenThree* variants lay out md:grid-cols-[7fr_3fr] with the TEXT column
// FIRST and fall `title` back to that left column, so each picture goes in slot="right":
// the heading always lands on the prose, never on the picture, and on a phone the single
// column reads heading, text, picture rather than opening with an image. Neither is passed
// a `titleright`, so neither image column carries a heading and each block emits exactly
// one.
// ContentBoxTwoNeumorphism is passed no column labels — the brief gives §3 one running
// paragraph with no sub-labels, and inventing a pair here would be this page's own wording
// rather than the docx's. The paragraph runs one half per slot, which keeps every clause
// and still gives the component both slots.
// ContentBox3Three is passed heading={false} on purpose: the brief writes its three steps
// as a SHORT LABEL LINE plus its own sentence, but marks none of the three as a heading,
// so the three column labels render as <p> and only the section's own as="h2" is a
// heading. Flipping that to true would put three h3s on the page that the brief does not
// have. Because those labels are <p>, the component needs `label` to give its <section> an
// accessible name. Each label is the brief's line 15/17/19 verbatim and each column body is
// the matching line 16/18/20, so a column read end to end says exactly what content.txt
// says.
//
// Every brief paragraph ships in full — nothing merged, nothing summarised. §3 runs one
// paragraph half per slot and §6 one step per slot, and NO slot receives more than one
// element, so the house rule's "one element per slot" holds everywhere without a wrapper
// <div> being needed.
//
// Everything else on the page is chrome and emits no heading tag at any level:
// Announcement2, LatestWinners2, LoginRtpSection and ReviewCardSumo render their titles as
// <p>/<span> with an aria-label on the section, and Faq2's questions live inside <summary>
// (all four were grepped for <h[1-6] this round and none has one). The non-brief widgets
// sit before section 1 (the ticker, then the member feed) and after section 8
// (LoginRtpSection, ReviewCardSumo, Navfoot) — never spliced between two content sections.

// One array, used by both <Faq> and the FAQPage node — never the component's own defaults
// (Faq2 deliberately ships an empty list, so a forgotten prop renders an empty accordion
// rather than some previous brand's questions). The three pairs are the brief's own Q/A
// block (content.txt lines 24-29), verbatim; only the "1." / "2." / "3." list markers are
// dropped, since the accordion is the list.
const faqs = [
  {
    q: `${BRAND_NAME} สามารถเข้าเล่นสล็อตได้ทุกค่ายหรือไม่?`,
    a: `ควรตรวจสอบรายชื่อค่ายเกมสล็อตที่เปิดให้บริการจริงจากหน้าเว็บไซต์ เนื่องจากจำนวนค่ายเกมและรายการเกมอาจเปลี่ยนแปลงได้ตามการให้บริการของแต่ละช่วงเวลา`,
  },
  {
    q: `โปรโมชั่นคืนยอดเสีย 0.3% ของ${BRAND_NAME} รับได้ทุกวันหรือไม่?`,
    a: `โปรโมชั่นระบุการคืนยอดเสียรายวัน แต่สมาชิกควรตรวจสอบรอบคำนวณยอด วิธีรับเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุดก่อนเข้าร่วม`,
  },
  {
    q: `หากสมัครสมาชิกหรือถอนเงินมีปัญหา ต้องติดต่อช่องทางไหน?`,
    a: `สามารถตรวจสอบช่องทาง LINE Official ที่แสดงบนเว็บไซต์ทางการของ${BRAND_NAME} เพื่อแจ้งปัญหาและขอคำแนะนำจากเจ้าหน้าที่ โดยไม่ส่งรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น`,
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own sentence.
// Thai has no inter-word space, so a highlight that starts or ends mid-word lets the
// formatter break the line inside the tag and render a space that splits the word — the
// copy must read identically with the tags removed. No two <strong> elements are adjacent
// either: every pair is separated by at least one run of plain text, so the whitespace
// between them can never collapse into a missing space.
// One highlight colour only: #ffc82e (brand-spec §2 reserves it for exactly this job),
// against the inherited body colour #e8f4ff (BRAND_TEXT). The paragraphs below carry no
// colour class of their own: every ContentBox* card in this mix already sets
// `text-left text-base leading-relaxed text-[#e8f4ff]` on the element holding the slot, so
// the prose inherits it and no page-level override can drift from the card. No paragraph
// carries mx-auto or max-w-* either — the cards cap their own width, and the only max-w-*
// on the page are the two capping the slides, which are images and not prose. No slot's
// copy names a colour.

// No breadcrumb: this is the homepage, so a trail from the root to itself would be a
// single self-referential crumb. Every URL in the graph is derived by pageGraph from
// `site:` — no domain is typed out in this file, no URL is built with `+`, and no Review /
// AggregateRating / sameAs / address / email node is passed. `description` is the exact
// same string MainLayout gets, and `faqs` is the exact same array <Faq> gets.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <LatestWinners />

  <ContentBoxFloatingBadge as="h1" title={`${BRAND_NAME} เว็บสล็อตทางการ ผู้ให้บริการฐานเกมหลักที่ดีที่สุด`}>
    <p>
      {BRAND_NAME} นำเสนอช่องทางสำหรับผู้ที่สนใจเกมสล็อตออนไลน์
      <strong class="text-[#ffc82e]">โดยรวบรวมข้อมูลการสมัครสมาชิก การเข้าสู่ระบบ การฝากถอน และโปรโมชั่นไว้ในเว็บไซต์เดียว</strong>
      ผู้ใช้งานสามารถศึกษารายละเอียดของเกมและเงื่อนไขบริการก่อนเริ่มต้น พร้อมช่องทางติดต่อเจ้าหน้าที่เมื่อมีข้อสงสัย ทั้งนี้
      <strong class="text-[#ffc82e]">ควรตรวจสอบข้อมูลผู้ให้บริการและความน่าเชื่อถือจากหลักฐานที่ตรวจสอบได้ก่อนใช้งาน</strong>
    </p>
  </ContentBoxFloatingBadge>

  <ContentBoxNeumorphism as="h2" title={`${BRAND_NAME} ช่องทางเล่นสล็อตเว็บหลัก เว็บแท้อันดับ1`}>
    <p>
