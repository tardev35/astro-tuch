---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBox3ThreePremium from "../components/ContentBox3ThreePremium.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import Faq from "../components/Faq4.astro";
import LatestWinners from "../components/LatestWinnersPremium.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// IMAGE ROLES FOR THIS DROP (2026-09-27) — READ BEFORE REUSING THESE IMPORTS.
// Two files are referenced from this page and only two, both slides, both spent
// on a ContentBoxSevenThree* block — the family's hard cap of two per rebrand,
// so there is no third SevenThree here:
//   slide1.png — the poster whose Thai type reads "โปรโมชั่น แนะนำเพื่อน" above a
//     large "โบนัส 0.8%", so it belongs to docx H3 #4.
//   slide2.png — the mirrored poster reading "โปรโมชั่น คืนยอดเสีย" above
//     "โบนัส 0.3%", so it belongs to docx H3 #5.
// Both files are 600x400, so 600 is the top candidate width — nothing above it
// would be a real pixel. The alt text was written from the CURRENT artwork
// (black-and-gold ground, the PKG44 wordmark with a chrome K between gold
// letters, the woman in the white suit pointing at the type, the gold coins,
// the black-and-gold chips and the ribboned gift box) and never carried over
// from BRAZIL999's green/chrome strings — none of that is in these pictures.
//
// Deliberately NOT imported, and all still on disk as inventory:
//   banner2.png (2026-09-22), banner3.png (2026-08-11), slide3.png
//   (2026-09-18), slide4.png (2026-08-13) — every one predates this drop and
//   carries a previous client's artwork. There is therefore NO usable banner2+
//   this round and NO single-column inline illustration, which is the expected
//   outcome, not a gap to fill with a stale file.
//   banner1.png and banner1-mobile.png belong to MainLayout's own pinned globs
//   and are never referenced from a page — the hero is the LCP element, so
//   nothing here gets loading="eager" fetchpriority="high". og.png is the same:
//   MainLayout's glob owns it.
//
// DROPPED THIS ROUND, and none of the files deleted — every one is inventory for
// the next brand: ProviderGrid / ProviderGridPremium / FeaturedGames /
// PopularGamesStrip / GameRankingBoard each have to name specific studios, game
// titles or payout figures, and this brief names none at all — it says only
// "รวมเกมปั่นสล็อตจากหลายค่ายไว้ในระบบเดียว". BankStrip needs a bank or a
// deposit channel, which the brief also never mentions. SmoothCarousel is out
// because it would put slide* outside a ContentBoxSevenThree*. LottoGrid is out
// because PKG44 is a slot brand, not เว็บหวย (which is also why /ตรวจหวย and
// /แนวทาง stay parked and are never linked from here). FeatureHighlights is out
// because it emits an <h3> per item and the brief gives its 3 signup steps no
// per-step headings — the steps ship as a plain <ol> instead. Filling any of
// these in would be inventing facts.

// Title and description are the brief's own Title/Description lines, used
// verbatim. A brief-supplied description is never padded up to the 150-char
// floor and never topped up from the H1/H2 — this one ships at the length the
// brief wrote it (116 characters), which is a passing build, not a gap to fill.
const pageTitle = "PKG44 เกมปั่นสล็อตAPIแท้ รับอนุญาตลิขสิทธิ์จากเจ้าของ ปลอดภัยแน่นอน";

const pageDescription = "PKG44 เกมปั่นสล็อตAPIแท้ รับอนุญาตลิขสิทธิ์จากเจ้าของโดยตรง ทางเข้าใช้งานง่าย สนุกทุกค่าย ปลอดภัยทุกการเดิมพันแน่นอน";

// <Announcement /> runs bare: AnnouncementPremium's default message is already
// this brand's copy, and every sub-page calls it bare too — passing an override
// here is how the ticker ends up saying two different things on two pages.

// The docx has a real H2 -> H3 nesting this round: "แนะนำเพื่อน โบนัส 0.8%" and
// "คืนยอดเสีย 0.3%" are genuine sub-points of the โปรโมชั่น H2, so the page is
// NOT flattened to H2-only. Those two are the only <h3> here, and each one is
// carried by its own ContentBoxSevenThree* block together with the slide whose
// artwork states that exact figure.
// Everything else is chrome and emits no heading tag: LatestWinnersPremium,
// LoginRtpSection and ReviewCardSumo2 render their titles as <p>/<span> with an
// aria-label on the section, and Faq4's questions live inside <summary>.
// ContentBox3ThreePremium's three column captions are this page's own wording for
// splitting one docx paragraph into three readable columns, not docx sub-points,
// so heading={false} renders them as <p>.
// ContentBoxTwoPremium's and ContentBoxTwoNeumorphism's column labels are <p>
// inside those components already.
//
// The docx checklist, in order, and what carries each one:
//    1 H1  PKG44 เกมปั่นสล็อตAPIแท้ รับอนุญาตลิขสิทธิ์จากเจ้าของ        ContentBoxPremium
//    2 H2  ทางเข้า PKG44 ใช้งานง่าย สนุกทุกค่าย ปลอดภัย ทุกการเดิมพัน    ContentBox3ThreePremium
//    3 H2  อัปเดตข่าวสารและโปรโมชั่น PKG44 ได้ก่อนใคร                ContentBoxCyberCut
//    4 H3  แนะนำเพื่อน โบนัส 0.8%                                ContentBoxSevenThreePremium + slide1
//    5 H3  คืนยอดเสีย โบนัส 0.3%                                 ContentBoxSevenThree + slide2
//    6 H2  สมัคร PKG44 รับโปรโมชั่นง่ายๆ แค่ 3 ขั้นตอน                ContentBoxTwoPremium (intro + <ol>)
//    7 H2  ติดต่อเจ้าหน้าที่ PKG44 ได้ตลอด 24 ชั่วโมง                  ContentBoxTwoNeumorphism
//    8 H2  คำถามที่พบบ่อย                                        Faq4
// Final inventory for this page: h1 x1, h2 x5, h3 x2.
//
// Every docx paragraph ships in full. One block is a multi-column shell, so the
// paragraph that fills it is split across its columns and nowhere else: item 2's
// single paragraph fills the three Premium columns in order. Reading them left ->
// centre -> right reproduces the sentence word for word; nothing is summarised,
// merged or repeated.
//
// Vocabulary: this brief says only "ติดต่อเจ้าหน้าที่ PKG44 ได้ตลอด 24 ชั่วโมง"
// and never names LINE, so no paragraph on this page writes ไลน์ / ไลน์แอด /
// LINE OFFICIAL — only the button that actually links to /line carries that
// wording, because that is the button's real destination. It names no game
// studio, no game title, no RTP figure, no licence number, no bank and no
// deposit channel, so neither does this page.

// One array, used by both <Faq> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last. The three pairs
// are the brief's own Q/A block, verbatim.
const faqs = [
  {
    q: "PKG44 มีเกมสล็อตจากหลายค่ายหรือไม่?",
    a: "ภายในระบบมีเกมสล็อตจากหลายค่ายตามรายการที่เว็บไซต์เปิดให้บริการ ทั้งเกมยอดนิยม เกมโบนัส และเกมใหม่ที่อัปเดตตามช่วงเวลา สมาชิกสามารถตรวจสอบรายชื่อค่ายและรายละเอียดของแต่ละเกมได้จากหน้ารวมเกม",
  },
  {
    q: "PKG44 ใช้ระบบ API จากเจ้าของเกมโดยตรงหรือไม่?",
    a: "ตามข้อมูลที่เว็บไซต์ระบุ PKG44 ใช้รูปแบบการเชื่อมต่อ API และมีข้อมูลเกี่ยวกับลิขสิทธิ์ของเกมจากผู้ให้บริการ สมาชิกควรตรวจสอบรายละเอียดค่ายและข้อมูลที่เกี่ยวข้องจากช่องทางอย่างเป็นทางการเพิ่มเติมก่อนใช้งาน",
  },
  {
    q: "PKG44 มีโปรโมชั่นอะไรบ้าง?",
    a: "โปรโมชั่นหลักตามข้อมูลที่กำหนดมีโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% โดยแต่ละรายการมีเงื่อนไขและรอบรับสิทธิ์แตกต่างกัน ควรตรวจสอบรายละเอียดจากหน้าโปรโมชั่นก่อนกดรับทุกครั้ง",
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// One highlight colour only: near-white gold #fff8e1 against the body colour
// #efe6d2, so the brand gold stays the page's structural accent and the
// paragraphs never compete with a heading for it.

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb. Every URL in the graph is derived
// by pageGraph from `site:` — no domain is typed out in this file, and no
// Review / AggregateRating / sameAs / address node is passed.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxPremium as="h1" title="PKG44 เกมปั่นสล็อตAPIแท้ รับอนุญาตลิขสิทธิ์จากเจ้าของ">
    <p class="text-left text-base leading-relaxed text-[#efe6d2]">
      PKG44
      <strong class="text-[#fff8e1]">รวมเกมปั่นสล็อตจากหลายค่ายไว้ในระบบเดียว พร้อมรูปแบบการเชื่อมต่อ API และข้อมูลลิขสิทธิ์ตามที่เว็บไซต์ระบุ</strong>
      สมาชิกสามารถเลือกเกมได้หลายแนว ทั้งสล็อตยอดนิยม เกมโบนัส และเกมใหม่ที่อัปเดตตามช่วงเวลา
      <strong class="text-[#fff8e1]">รองรับการใช้งานบนมือถือและคอมพิวเตอร์ผ่านเมนูที่จัดไว้ชัดเจน</strong>
    </p>
  </ContentBoxPremium>

  <ContentBox3ThreePremium
    as="h2"
    title="ทางเข้า PKG44 ใช้งานง่าย สนุกทุกค่าย ปลอดภัย ทุกการเดิมพัน"
    heading={false}
    titleleft="บัญชีเดียวทุกค่าย"
    titlecenter="เมนูแบ่งหมวดหมู่"
    titleright="ระบบบัญชีสมาชิก">
    <p slot="left" class="text-left text-base leading-relaxed text-[#efe6d2]">
      ทางเข้า PKG44
      <strong class="text-[#fff8e1]">ออกแบบให้เข้าถึงเกมสล็อตแต่ละค่ายได้สะดวกจากบัญชีเดียว</strong>
    </p>
    <p slot="center" class="text-left text-base leading-relaxed text-[#efe6d2]">
      เมนูแบ่งหมวดหมู่ชัดเจนและรองรับการใช้งานผ่านมือถือ
      <strong class="text-[#fff8e1]">สามารถตรวจสอบชื่อค่าย รายละเอียดเกม และข้อมูลที่เกี่ยวข้องก่อนเริ่มเล่น</strong>
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#efe6d2]">พร้อมระบบบัญชีที่ช่วยให้จัดการรายการต่าง ๆ ได้เป็นขั้นตอนมากขึ้น</p>
  </ContentBox3ThreePremium>

  <ContentBoxCyberCut as="h2" title="อัปเดตข่าวสารและโปรโมชั่น PKG44 ได้ก่อนใคร">
    <p class="text-left text-base leading-relaxed text-[#efe6d2]">
      สมาชิก PKG44 สามารถติดตามข่าวสาร เกมใหม่ และโปรโมชั่นที่เว็บไซต์อัปเดตตามช่วงเวลาได้จากหน้าเดียว
      <strong class="text-[#fff8e1]">โดยมีทั้งโบนัสแนะนำเพื่อนและโบนัสคืนยอดเสีย</strong>
      พร้อมรายละเอียดเกี่ยวกับยอดที่เข้าเกณฑ์ รอบรับสิทธิ์ และ
      <strong class="text-[#fff8e1]">เงื่อนไขที่ควรตรวจสอบก่อนกดรับโปรโมชั่นแต่ละรายการ</strong>
    </p>
  </ContentBoxCyberCut>

  <ContentBoxSevenThreePremium as="h3" title="แนะนำเพื่อน โบนัส 0.8%">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[340, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), 348px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นพื้นดำ-ทอง ด้านขวาบนเป็นโลโก้ PKG44 ตัวอักษร P G และเลข 44 เป็นทองเมทัลลิก ส่วนตัว K เป็นเงินโครเมียม ใต้ลงมาเป็นตัวอักษรไทยสีขาวขอบทองว่า โปรโมชั่น แนะนำเพื่อน แล้วปิดท้ายด้วยตัวเลขขนาดใหญ่ว่า โบนัส 0.8% ด้านซ้ายเป็นหญิงสาวผมยาวสีเข้มสวมชุดสูทสีขาว ยิ้มและชี้นิ้วชี้ทั้งสองข้างมาที่ข้อความ มุมซ้ายบนมีกล่องของขวัญผูกโบว์ทอง รอบภาพมีเหรียญทองลอยอยู่และมีชิปคาสิโนสีดำขอบทองกองอยู่ที่ขอบล่าง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#fdd32a]/55 shadow-[0_10px_30px_rgba(253,211,42,0.3)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#efe6d2]">
      สมาชิก PKG44
      <strong class="text-[#fff8e1]">ที่แนะนำเพื่อนเข้ามาสมัครสามารถรับโบนัส 0.8% ตามเงื่อนไขของโปรโมชั่น</strong>
      ระบบมีรายละเอียดเกี่ยวกับยอดที่เข้าเกณฑ์และขั้นตอนรับสิทธิ์ให้ตรวจสอบ
      <strong class="text-[#fff8e1]">ช่วยให้ติดตามโบนัสจากกิจกรรมแนะนำเพื่อนได้สะดวกผ่านบัญชีสมาชิก</strong>
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBoxSevenThree as="h3" title="คืนยอดเสีย โบนัส 0.3%">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[340, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), 360px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นชุดเดียวกันพื้นดำ-ทองแต่สลับด้าน ด้านซ้ายเป็นหญิงสาวผมยาวสีเข้มสวมชุดสูทสีขาว ชี้นิ้วมือทั้งสองข้างไปที่ข้อความ มุมขวาบนเป็นโลโก้ PKG44 ตัวอักษร P G และเลข 44 เป็นทองเมทัลลิก ส่วนตัว K เป็นเงินโครเมียม ถัดลงมาเป็นตัวอักษรไทยสีขาวขอบทองว่า โปรโมชั่น คืนยอดเสีย และตัวเลขขนาดใหญ่ว่า โบนัส 0.3% ด้านขวามีกล่องของขวัญผูกโบว์ทอง ตามขอบภาพมีเหรียญทองและชิปคาสิโนสีดำขอบทองลายมงกุฎกระจายอยู่"
      class="mx-auto h-auto w-full rounded-2xl border border-[#c2c8d0]/40 shadow-[0_10px_30px_rgba(8,6,2,0.85)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#efe6d2]">
      <strong class="text-[#fff8e1]">โปรโมชั่นคืนยอดเสีย PKG44 ให้โบนัส 0.3% ตามยอดและเงื่อนไขที่กำหนด</strong>
      สมาชิกสามารถตรวจสอบรอบคำนวณ ยอดที่เข้าเกณฑ์ และรายละเอียดก่อนกดรับสิทธิ์
      <strong class="text-[#fff8e1]">ช่วยให้ติดตามโบนัสในแต่ละรอบได้ง่ายและรู้เงื่อนไขก่อนนำสิทธิ์ไปใช้งาน</strong>
    </p>
  </ContentBoxSevenThree>

  <ContentBoxTwoPremium as="h2" title="สมัคร PKG44 รับโปรโมชั่นง่ายๆ แค่ 3 ขั้นตอน" titleleft="รายละเอียดการสมัคร" titleright="3 ขั้นตอนหลัก">
    <p slot="left" class="text-left text-base leading-relaxed text-[#efe6d2]">
      <strong class="text-[#fff8e1]">การสมัคร PKG44 สามารถทำผ่านหน้าเว็บไซต์ได้ด้วยตัวเอง</strong>
      ขั้นตอนไม่ซับซ้อน หลังจากยืนยันบัญชีเรียบร้อยสามารถเข้าสู่ระบบเพื่อเลือกเกมสล็อตและตรวจสอบโปรโมชั่นที่กำลังเปิดให้รับได้ทันที
      <strong class="text-[#fff8e1]">โดยมีขั้นตอนหลักเพียง 3 ขั้นตอนดังนี้</strong>
    </p>
    <ol slot="right" class="flex list-decimal flex-col gap-4 pl-6 text-left text-base leading-relaxed text-[#efe6d2] marker:font-black marker:text-[#ffe27a]">
      <li>เปิดหน้าสมัคร PKG44 แล้วกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน</li>
      <li>ตรวจสอบข้อมูลส่วนตัวและรายละเอียดบัญชีให้ถูกต้องก่อนกดยืนยัน</li>
      <li>ยืนยันการสมัครและเข้าสู่ระบบ จากนั้นเลือกค่ายสล็อต เกมที่สนใจ และโปรโมชั่นที่เปิดให้รับได้ทันที</li>
    </ol>
  </ContentBoxTwoPremium>

  <ContentBoxTwoNeumorphism as="h2" title="ติดต่อเจ้าหน้าที่ PKG44 ได้ตลอด 24 ชั่วโมง" titleleft="สอบถามเจ้าหน้าที่" titleright="สมัครสมาชิกและเริ่มใช้งาน">
    <p class="text-left text-base leading-relaxed text-[#efe6d2]">
      หากมีข้อสงสัยเกี่ยวกับการสมัคร ทางเข้า โปรโมชั่น เกม หรือการใช้งานบัญชี
