---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement2.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import LottoGrid from "../components/LottoGrid.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import LatestWinners from "../components/LatestWinners4.astro";
import ContentBoxTwo from "../components/ContentBoxTwo.astro";
import ReviewCardSumo from "../components/ReviewCardSumo.astro";
import Faq from "../components/Faq3.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// Title and description are the brief's own Title/Description lines, used
// verbatim. A brief-supplied description is never padded up to the 150-char
// floor and never topped up from the H1/H2.
const pageTitle = "KINDEE365 หวยลอตเตอรี่ออนไลน์ ราคาดีสุด จ่ายเต็มบิล ไม่มีประวัติโกง";

const pageDescription =
  "KINDEE365 เว็บหวยลอตเตอรี่ออนไลน์ จ่ายไม่อั้น รับทุกเลข หวยรัฐบาลไทย หวยลาวพัฒนา หวยฮานอย หวยหุ้นต่างประเทศ อัตราจ่ายสูง 3ตัว1,000 2ตัว100";

// The ticker copy is passed explicitly rather than relying on the component's
// default — every Announcement* variant's default belongs to whichever brand
// wired it in last. No emoji in this string: an emoji baked into a text prop
// cannot be given its own aria-hidden span, and this marquee prints the string
// three times.
const announcement =
  "KINDEE365 หวยลอตเตอรี่ออนไลน์ ราคาดีสุด จ่ายเต็มบิล ไม่มีประวัติโกง • เปิดรับแทงหวยรัฐบาลไทย หวยลาวพัฒนา หวยฮานอย และหวยหุ้นต่างประเทศ เลือกประเภทหวย เลขที่ต้องการ และจำนวนเงินเดิมพันได้จากระบบโดยตรง • อัตราจ่ายสำหรับหน้านี้ เลข 3 ตัวบาทละ 1,000 และเลข 2 ตัวบาทละ 100 คำนวณยอดตามเรทได้ก่อนส่งโพย • ก่อนยืนยันโพยควรตรวจเวลาเปิด-ปิด อัตราจ่าย เลขอั้น และวงเงินของรอบนั้นให้ครบถ้วน • ฝากถอนระบบออโต้ผ่านธนาคารและวอลเลทตามช่องทางที่เปิดรองรับ ตรวจสถานะรายการเองได้จากบัญชีของตนเอง • เจ้าหน้าที่ KINDEE365 รับเรื่องออนไลน์ตลอด 24 ชั่วโมง";

// The brief prints both rate tables as flat lines (ยอดแทง / อัตราจ่าย /
// ยอดตามเรทเมื่อถูก, then five rows). They are kept as data so the markup below
// stays one real <table> per section instead of ten hand-typed cells — the
// header cells are <th scope="col">, never headings.
const rate3 = [
  { bet: "1 บาท", rate: "1 : 1,000", payout: "1,000 บาท" },
  { bet: "5 บาท", rate: "1 : 1,000", payout: "5,000 บาท" },
  { bet: "10 บาท", rate: "1 : 1,000", payout: "10,000 บาท" },
  { bet: "50 บาท", rate: "1 : 1,000", payout: "50,000 บาท" },
  { bet: "100 บาท", rate: "1 : 1,000", payout: "100,000 บาท" },
];

const rate2 = [
  { bet: "1 บาท", rate: "1 : 100", payout: "100 บาท" },
  { bet: "5 บาท", rate: "1 : 100", payout: "500 บาท" },
  { bet: "10 บาท", rate: "1 : 100", payout: "1,000 บาท" },
  { bet: "50 บาท", rate: "1 : 100", payout: "5,000 บาท" },
  { bet: "100 บาท", rate: "1 : 100", payout: "10,000 บาท" },
];

// One array, used by both <Faq> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last.
const faqs = [
  {
    q: "KINDEE365 มีหวยอะไรให้เลือกแทงบ้าง?",
    a: "มีทั้งหวยรัฐบาลไทย หวยลาวพัฒนา หวยฮานอย และหวยหุ้นต่างประเทศตามรอบที่เปิดให้บริการ โดยแต่ละประเภทอาจมีเวลาเปิด-ปิดและเงื่อนไขแตกต่างกัน ควรตรวจสอบรายละเอียดก่อนส่งโพยทุกครั้ง",
  },
  {
    q: "KINDEE365 จ่าย 3 ตัว 1,000 และ 2 ตัว 100 หรือไม่?",
    a: "ตามข้อมูลที่กำหนดสำหรับหน้านี้ เลข 3 ตัวอยู่ที่บาทละ 1,000 และเลข 2 ตัวอยู่ที่บาทละ 100 แต่ควรยึดอัตราจ่ายจริงที่แสดงในระบบ ณ เวลาส่งโพยเป็นหลัก โดยเฉพาะหวยหรือรอบที่อาจมีเงื่อนไขเฉพาะ",
  },
  {
    q: "ฝากถอน KINDEE365 แล้วเครดิตไม่เข้าต้องทำอย่างไร?",
    a: "ให้ตรวจสอบสถานะธุรกรรมในบัญชีก่อน หากรายการยังค้างหรือยอดไม่ถูกต้อง สามารถติดต่อเจ้าหน้าที่ KINDEE365 พร้อมแจ้งจำนวนเงิน เวลา และช่องทางที่ใช้ทำรายการ เพื่อให้ทีมงานช่วยตรวจสอบและแนะนำขั้นตอนดำเนินการต่อได้",
  },
];

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb. Every URL in the graph is derived
// by pageGraph from `site:` — no domain is typed out in this file.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <ContentBoxPremium as="h1" title="KINDEE365 เว็บหวยลอตเตอรี่ออนไลน์ มีครบทุกเลข จ่ายไม่อั้น รับทุกเลข">
    <p class="text-left text-base leading-relaxed text-[#cfe3f7]">
      <strong class="text-[#f8dc8c]">KINDEE365</strong> เปิดบริการสำหรับผู้ที่ต้องการแทงหวยออนไลน์ผ่านระบบที่ใช้งานง่ายบนมือถือและคอมพิวเตอร์ มีทั้งหวยรัฐบาลไทย หวยลาวพัฒนา หวยฮานอย และหวยหุ้นต่างประเทศ
      พร้อมอัตราจ่ายตามที่กำหนด เลข <strong class="text-[#f8dc8c]">3 ตัวบาทละ 1,000</strong> และเลข <strong class="text-[#f8dc8c]">2 ตัวบาทละ 100</strong> สมาชิกสามารถตรวจสอบเรท ส่งโพย ฝากถอน
      และติดตามประวัติรายการได้จากบัญชีของตนเอง พร้อมเจ้าหน้าที่คอยรับเรื่องและช่วยตรวจสอบปัญหาตลอด 24 ชั่วโมง
    </p>
  </ContentBoxPremium>

  <ContentBoxSevenThreeCyberCut as="h2" title="KINDEE365 เปิดรับแทง หวยรัฐบาลไทย หวยลาวพัฒนา หวยฮานอย หวยหุ้นต่างประเทศ">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นคืนยอดเสีย 0.3% ของ KINDEE365 พื้นหลังสีน้ำเงินกรมท่าเข้มมีลำแสงสีทองพาดเป็นเส้น ด้านบนกลางภาพเป็นโลโก้ KINDEE365 ตัวอักษร KINDEE สีน้ำเงินวางเหนือเลข 365 สีทอง ถัดลงมาเป็นแผ่นป้ายขอบทองเขียนว่า โปรโมชั่น ตามด้วยข้อความตัวใหญ่สีขาวว่า คืนยอดเสีย วางเหนือตัวเลข 0.3% สีทองขนาดใหญ่ ตรงกลางเป็นผู้หญิงสวมชุดไทยประยุกต์สีน้ำเงินสลับทองชี้มือไปที่ตัวเลข รอบตัวมีลูกบอลหวยและเหรียญทองกระจายอยู่ ด้านขวาเป็นตารางผลรางวัลสลากแบบไทย ด้านล่างเป็นชิปไอคอนสีน้ำเงินสี่อันเรียงกันเขียนว่า จ่ายจริง จ่ายเต็ม กับ มั่นคง ปลอดภัย กับ ตรวจสอบได้ และ ไม่มีประวัติโกง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#e8bb4a]/40 shadow-[0_10px_30px_rgba(232,187,74,0.25)]"
    />
    <div slot="right" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#cfe3f7]">
        <strong class="text-[#f8dc8c]">KINDEE365</strong> จัดหมวดหวยออนไลน์หลายประเภทไว้ให้เลือกตามรอบที่เปิดบริการ ไม่ว่าจะเป็นหวยรัฐบาลไทย หวยลาวพัฒนา หวยฮานอย หรือหวยหุ้นต่างประเทศ
        สมาชิกสามารถเลือกประเภทหวย เลขที่ต้องการ และจำนวนเงินเดิมพันได้จากระบบโดยตรง ก่อนยืนยันโพยควรตรวจสอบเวลาเปิด-ปิด อัตราจ่าย เลขอั้น และวงเงินของรอบนั้นให้ครบถ้วน
        เพื่อให้รายละเอียดตรงกับรายการที่ต้องการส่ง
      </p>
      <p class="text-left text-base leading-relaxed text-[#cfe3f7]">
        สำหรับข้อความว่า “รับทุกเลข” หรือ “จ่ายไม่อั้น” ควรยึดวงเงินและเงื่อนไขที่ระบบแสดง ณ เวลาส่งโพยเป็นหลัก เนื่องจากบางเลขหรือบางรอบอาจมีข้อกำหนดเฉพาะ
      </p>
    </div>
  </ContentBoxSevenThreeCyberCut>

  <LottoGrid />

  <ContentBoxCyberCut as="h2" title="เว็บ KINDEE365 ให้อัตราจ่ายสูง 3ตัว1,000 2ตัว100">
    <p class="text-left text-base leading-relaxed text-[#cfe3f7]">
      <strong class="text-[#f8dc8c]">KINDEE365</strong> กำหนดอัตราจ่ายสำหรับหน้านี้ไว้ที่ เลข 3 ตัว บาทละ 1,000 และเลข 2 ตัว บาทละ 100 เพื่อให้สมาชิกเห็นเรทและคำนวณยอดเบื้องต้นได้ก่อนส่งโพย
      อย่างไรก็ตาม ควรตรวจสอบตัวเลขที่แสดงจริงในระบบก่อนยืนยันทุกครั้ง เพราะประเภทหวยหรือรอบเดิมพันอาจมีเงื่อนไขแตกต่างกัน
    </p>
  </ContentBoxCyberCut>

  <ContentBoxNeumorphism as="h3" title="แทงหวย 3 ตัว ถูกจ่ายบาทละ 1,000">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed text-[#cfe3f7]">เลข 3 ตัวใช้อัตราจ่ายตามที่กำหนดคือ 1 บาท จ่าย 1,000 บาท สามารถดูตัวอย่างการคำนวณได้ดังนี้</p>

      <div class="overflow-x-auto rounded-2xl border border-[#1f6fd0]/50">
        <table class="w-full min-w-[420px] border-collapse text-left">
          <caption class="border-b border-[#1f6fd0]/40 bg-[#010b26]/70 px-4 py-3 text-left text-sm leading-relaxed text-[#8fb3d9]">
            ตารางคำนวณยอดตามเรทของเลข 3 ตัว ที่อัตราจ่ายบาทละ 1,000
          </caption>
          <thead>
            <tr class="bg-[#083163]">
              <th scope="col" class="px-4 py-3 text-sm font-black tracking-wide text-[#f8dc8c]">ยอดแทง</th>
              <th scope="col" class="px-4 py-3 text-sm font-black tracking-wide text-[#f8dc8c]">อัตราจ่าย</th>
              <th scope="col" class="px-4 py-3 text-sm font-black tracking-wide text-[#f8dc8c]">ยอดตามเรทเมื่อถูก</th>
            </tr>
          </thead>
          <tbody>
            {
              rate3.map((row) => (
                <tr class="border-t border-[#1f6fd0]/30 odd:bg-[#02153c]/70 even:bg-[#010b26]/50">
                  <td class="px-4 py-2.5 text-base text-[#cfe3f7]">{row.bet}</td>
                  <td class="px-4 py-2.5 text-base text-[#a3dbfb]">{row.rate}</td>
                  <td class="px-4 py-2.5 text-base font-bold text-[#e8bb4a]">{row.payout}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="text-left text-base leading-relaxed text-[#cfe3f7]">
        ตัวอย่าง หากแทงเลข 3 ตัว 10 บาท และเรทในรอบนั้นยังอยู่ที่ 1,000 เมื่อผลตรงตามเงื่อนไข ยอดตามเรทจะเท่ากับ 10 × 1,000 = 10,000 บาท
      </p>
    </div>
  </ContentBoxNeumorphism>

  <ContentBoxFloatingBadge as="h3" title="แทงหวย 2 ตัว ถูกจ่ายบาทละ 100">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed text-[#cfe3f7]">สำหรับเลข 2 ตัว กำหนดเรทไว้ที่ 1 บาท จ่าย 100 บาท โดยสามารถคำนวณยอดตามจำนวนเงินที่เลือกแทงได้ง่าย</p>

      <div class="overflow-x-auto rounded-2xl border border-[#1f6fd0]/50">
        <table class="w-full min-w-[420px] border-collapse text-left">
          <caption class="border-b border-[#1f6fd0]/40 bg-[#010b26]/70 px-4 py-3 text-left text-sm leading-relaxed text-[#8fb3d9]">
            ตารางคำนวณยอดตามเรทของเลข 2 ตัว ที่อัตราจ่ายบาทละ 100
          </caption>
          <thead>
            <tr class="bg-[#083163]">
              <th scope="col" class="px-4 py-3 text-sm font-black tracking-wide text-[#f8dc8c]">ยอดแทง</th>
              <th scope="col" class="px-4 py-3 text-sm font-black tracking-wide text-[#f8dc8c]">อัตราจ่าย</th>
              <th scope="col" class="px-4 py-3 text-sm font-black tracking-wide text-[#f8dc8c]">ยอดตามเรทเมื่อถูก</th>
            </tr>
          </thead>
          <tbody>
            {
              rate2.map((row) => (
                <tr class="border-t border-[#1f6fd0]/30 odd:bg-[#02153c]/70 even:bg-[#010b26]/50">
                  <td class="px-4 py-2.5 text-base text-[#cfe3f7]">{row.bet}</td>
                  <td class="px-4 py-2.5 text-base text-[#a3dbfb]">{row.rate}</td>
                  <td class="px-4 py-2.5 text-base font-bold text-[#e8bb4a]">{row.payout}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="text-left text-base leading-relaxed text-[#cfe3f7]">
        ตัวอย่าง หากแทงเลข 2 ตัวจำนวน 10 บาท และระบบแสดงเรท 100 เมื่อผลตรงตามเงื่อนไข ยอดตามเรทจะเท่ากับ 10 × 100 = 1,000 บาท
      </p>
    </div>
  </ContentBoxFloatingBadge>

  <LoginRtpSection />

  <ContentBoxSevenThreeFloatingBadge as="h2" title="เว็บ KINDEE365 ฝากถอนระบบออโต้ ทุกช่องทางและวอลเลท">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อน 0.8% ของ KINDEE365 พื้นหลังสีน้ำเงินกรมท่าเข้มมีลำแสงสีทองพาดเป็นเส้น ด้านบนกลางภาพเป็นโลโก้ KINDEE365 ตัวอักษร KINDEE สีน้ำเงินวางเหนือเลข 365 สีทอง ถัดลงมาเป็นแผ่นป้ายขอบทองเขียนว่า โปรโมชั่น ตามด้วยข้อความตัวใหญ่สีขาวว่า แนะนำเพื่อน วางเหนือตัวเลข 0.8% สีทองขนาดใหญ่ ตรงกลางเป็นผู้หญิงสวมชุดไทยประยุกต์สีน้ำเงินสลับทองชี้มือไปที่ตัวเลข รอบตัวมีลูกบอลหวยและเหรียญทองกระจายอยู่ ด้านขวาเป็นตารางผลรางวัลสลากแบบไทย ด้านล่างเป็นชิปไอคอนสีน้ำเงินสี่อันเรียงกันเขียนว่า จ่ายจริง จ่ายเต็ม กับ แนะนำง่าย ได้จริง กับ มั่นคง ปลอดภัย และ ตรวจสอบได้"
      class="mx-auto h-auto w-full rounded-2xl border border-[#e8bb4a]/40 shadow-[0_10px_30px_rgba(232,187,74,0.25)]"
    />
    <div slot="right" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#cfe3f7]">
        สมาชิกสามารถจัดการเครดิตผ่านระบบฝากถอนออโต้ของ <strong class="text-[#f8dc8c]">KINDEE365</strong> โดยเลือกใช้ธนาคารหรือวอลเลทตามช่องทางที่เว็บไซต์เปิดรองรับ สามารถฝากเครดิต ส่งคำขอถอน
