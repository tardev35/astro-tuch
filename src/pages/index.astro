---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import LottoGrid from "../components/LottoGrid.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBox3ThreePremium from "../components/ContentBox3ThreePremium.astro";
import Faq from "../components/Faq2.astro";
import LatestWinners from "../components/LatestWinners2.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// IMAGE ROLES FOR THIS DROP (2026-09-24) — READ BEFORE REUSING THESE IMPORTS.
// Two files are referenced from this page and only two, both slides, both spent
// on a ContentBoxSevenThree* block — which is the family's hard cap of two per
// rebrand, so there is no third SevenThree here:
//   slide1.png — deep-green artwork whose gold-edged plaque reads "อัตราจ่ายหวย /
//     2 ตัวจ่าย 100", so it belongs to docx H3 #4.
//   slide2.png — the same two models over "อัตราจ่ายหวย / 3 ตัวจ่าย 1,000", so it
//     belongs to docx H3 #5.
// Both files are 600x333, so 600 is the top candidate width — nothing above it
// would be a real pixel. The alt text was written from the current artwork (the
// round gold-ringed 888PARUAY logo with its green 888 and red PARUAY, the woman
// in the red dress, the man in the white jacket with the red bow tie, the red,
// green and white numbered lottery balls), not carried over from a previous
// brand's banners.
//
// Deliberately NOT imported, and all still on disk as inventory:
//   banner2.png (2026-09-22), banner3.png (2026-08-11), slide3.png
//   (2026-09-18), slide4.png (2026-08-13) — every one predates this drop and
//   carries a previous client's artwork. There is therefore NO usable banner2+
//   this round and NO single-column inline illustration, which is the expected
//   outcome, not a gap to fill with a stale file.
//   banner1.png and banner1-mobile.png belong to MainLayout's own pinned globs
//   and are never referenced from a page — the hero is the LCP element, so
//   nothing here gets loading="eager" fetchpriority="high".
//
// ProviderGrid is DROPPED this round and NOT deleted from disk: it lists slot
// and casino studios, and this brief names no games at all — 888PARUAY is a
// lottery-only brand. LottoGrid stays and carries the four markets the H2 names.
//
// Rotated out of this round's mix and NOT deleted from disk (they are inventory
// for the next brand): AnnouncementHuay, ContentBoxHuay, ContentBoxTwoHuay,
// ContentBoxSevenThreeHuay, ContentBoxSevenThree, ContentBox3ThreeHuay,
// FaqHuay, LatestWinnersHuay, FeatureHighlights and ProviderGrid.

// Title and description are the brief's own Title/Description lines, used
// verbatim. A brief-supplied description is never padded up to the 150-char
// floor and never topped up from the H1/H2 — this one is 125 characters.
const pageTitle = "888PARUAY แทงหวย ตรวจหวย เว็บตรงอันดับ1 แทงได้ 24 ชั่วโมง";

const pageDescription = "888PARUAY แทงหวย ตรวจหวย เว็บอันดับ1 สมาชิกเข้าแทงหวยออนไลน์ ทุกประเภท รัฐบาลไทย ฮานอย ลาวพัฒนา หุ้นต่างประเทศ ได้ 24 ชั่วโมง";

// <Announcement /> runs bare: Announcement3's default message is already this
// brand's copy, and every sub-page calls it bare too — passing an override here
// is how the ticker ends up saying two different things on two pages.

// The docx has a real H2 -> H3 nesting this round: "2 ตัวจ่าย 100" and
// "3 ตัวจ่าย 1,000" are genuine sub-points of the อัตราจ่ายหวย H2, so the page is
// NOT flattened to H2-only. Those two are the only <h3> here, and each one is
// carried by its own ContentBoxSevenThree* block together with the slide whose
// artwork states that exact figure.
// Everything else is chrome — LottoGrid, LatestWinners2, LoginRtpSection and
// ReviewCardSumo2 all render their titles as <p>/<span> with an aria-label on
// the section, ContentBox3ThreePremium is passed heading={false} so its three
// ขั้นตอน labels stay <p>, and Faq2's questions live in a <span> inside
// <summary> — so none of them emits a heading tag.
//
// The docx checklist, in order, and what carries each one:
//    1 H1  888PARUAY แทงหวย ตรวจหวย เว็บตรงอันดับ1 …   ContentBoxPremium
//    2 H2  888PARUAY แทงหวย รัฐบาลไทย ฮานอย …          ContentBoxTwoCyberCut (+ LottoGrid)
//    3 H2  อัตราจ่ายหวย 888PARUAY กดรับได้ทันที         ContentBoxNeumorphism
//    4 H3  2 ตัวจ่าย 100                              ContentBoxSevenThreePremium + slide1
//    5 H3  3 ตัวจ่าย 1,000                            ContentBoxSevenThreeCyberCut + slide2
//    6 H2  สมัครแทงหวย 888PARUAY 3 ขั้นตอนง่ายๆ …       ContentBox3ThreePremium (intro slot + 3 คอลัมน์)
//    7 H2  แอดมินเว็บ 888PARUAY ออนไลน์ตลอด 24 ชั่วโมง  ContentBoxCyberCut
//    8 H2  คำถามที่พบบ่อย                              Faq2
// Final inventory for this page: h1 x1, h2 x5, h3 x2.

// One array, used by both <Faq> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last. The three pairs
// are the brief's own Q/A block, verbatim.
const faqs = [
  {
    q: "888PARUAY มีหวยประเภทไหนให้แทงบ้าง?",
    a: "ภายในระบบมีทั้งรัฐบาลไทย หวยฮานอย ลาวพัฒนา และหุ้นต่างประเทศ โดยรายการที่เปิดรับและช่วงเวลาของแต่ละรอบอาจแตกต่างกัน ผู้ใช้งานสามารถตรวจสอบข้อมูลล่าสุดจากหน้ารวมหวยก่อนยืนยันรายการ",
  },
  {
    q: "888PARUAY เลข 2 ตัวและ 3 ตัวจ่ายเท่าไร?",
    a: "ตามข้อมูลที่กำหนด เลข 2 ตัวมีอัตราจ่าย 100 และเลข 3 ตัวมีอัตราจ่าย 1,000 โดยควรตรวจสอบเงื่อนไขและรายละเอียดของแต่ละรอบอีกครั้งก่อนทำรายการ",
  },
  {
    q: "สามารถตรวจหวยผ่าน 888PARUAY ได้หรือไม่?",
    a: "สามารถตรวจสอบผลหวยตามรายการที่เว็บไซต์เปิดให้บริการได้ โดยเลือกประเภทหวยและรอบที่ต้องการจากหน้าตรวจผล ช่วยให้ติดตามทั้งรัฐบาลไทย ฮานอย ลาวพัฒนา และรายการอื่นได้จากหน้าเดียว",
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// One highlight colour only this round: the emphasis cream #fffdf0 against the
// body cream #e8e4c6, so the gold stays the page's structural accent and the
// paragraphs never compete with a heading for it.

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb. Every URL in the graph is derived
// by pageGraph from `site:` — no domain is typed out in this file.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxPremium as="h1" title="888PARUAY แทงหวย ตรวจหวย เว็บตรงอันดับ1 ปลอดภัยแน่นอน">
    <p class="text-left text-base leading-relaxed text-[#e8e4c6]">
      888PARUAY
      <strong class="text-[#fffdf0]">รวมบริการแทงหวยและตรวจหวยออนไลน์ไว้ในระบบเดียว</strong>
      <strong class="text-[#fffdf0]">รองรับรายการยอดนิยมทั้งรัฐบาลไทย ฮานอย ลาวพัฒนา และหุ้นต่างประเทศ</strong>
      พร้อมแสดงรอบเปิดรับและข้อมูลผลหวยให้ตรวจสอบได้สะดวก ระบบจัดหมวดหมู่ชัดเจนและ
      <strong class="text-[#fffdf0]">รองรับการใช้งานผ่านมือถือ</strong>
      ช่วยให้สมาชิกเข้าถึงรายการที่ต้องการได้ง่ายขึ้น
    </p>
  </ContentBoxPremium>

  <ContentBoxTwoCyberCut as="h2" title="888PARUAY แทงหวย รัฐบาลไทย ฮานอย ลาวพัฒนา หุ้นต่างประเทศ ได้ 24 ชั่วโมง" titleleft="ตลาดหวยที่เปิดรับ" titleright="ตรวจรอบก่อนยืนยัน">
    <p slot="left" class="text-left text-base leading-relaxed text-[#e8e4c6]">
      888PARUAY
      <strong class="text-[#fffdf0]">รวมรายการหวยหลายประเภทให้เลือก</strong>
      ทั้งรัฐบาลไทย หวยฮานอย ลาวพัฒนา และหุ้นต่างประเทศ
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#e8e4c6]">
      <strong class="text-[#fffdf0]">ผู้ใช้งานสามารถตรวจสอบรอบเปิดรับ เลือกตัวเลข และดูรายละเอียดของแต่ละรายการจากหน้าเดียว</strong>
      โดยแต่ละประเภทจะมีช่วงเวลาเปิดและปิดรับแตกต่างกันตามรอบที่ระบบกำหนด
    </p>
  </ContentBoxTwoCyberCut>

  <LottoGrid />

  <ContentBoxNeumorphism as="h2" title="อัตราจ่ายหวย 888PARUAY กดรับได้ทันที">
    <p class="text-left text-base leading-relaxed text-[#e8e4c6]">
      888PARUAY
      <strong class="text-[#fffdf0]">แสดงอัตราจ่ายของเลขแต่ละประเภทให้ตรวจสอบก่อนยืนยันรายการ</strong>
      <strong class="text-[#fffdf0]">ทั้งเลข 2 ตัวและเลข 3 ตัว</strong>
      ผู้ใช้งานสามารถเช็กตัวเลข รอบหวย และรายละเอียดของบิลได้อย่างเป็นขั้นตอน ช่วยให้ทราบอัตราจ่ายล่วงหน้าและเลือกประเภทการแทงได้ตรงกับรูปแบบที่ต้องการ
    </p>
  </ContentBoxNeumorphism>

  <ContentBoxSevenThreePremium as="h3" title="2 ตัวจ่าย 100">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[340, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), 353px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์อัตราจ่ายหวยพื้นเขียวเข้มที่มีแสงโบเก้สีทองและเหรียญทองกระจายทั่วภาพ ด้านซ้ายเป็นหญิงสาวผมยาวสวมชุดเดรสสีแดงกำลังชี้นิ้วทั้งสองข้างเข้าหาข้อความ ด้านขวาเป็นชายหนุ่มสวมสูทสีขาวผูกโบว์ไทสีแดงยืนยิ้ม ด้านบนกลางภาพเป็นโลโก้ 888PARUAY ทรงกลมในวงแหวนทอง โดยเลข 888 เป็นสีเขียวและคำว่า PARUAY เป็นสีแดง ถัดลงมามีมงกุฎทองและข้อความบนแถบแดงว่า อัตราจ่ายหวย แล้วเป็นแผ่นป้ายขอบทองเขียนว่า 2 ตัวจ่าย 100 รอบภาพมีลูกบอลหวยสีแดง เขียว และขาวพิมพ์ตัวเลข พร้อมสลากกินแบ่งและกองเหรียญทองที่ฐานภาพ"
      class="mx-auto h-auto w-full rounded-2xl border border-[#a87d0c]/60 shadow-[0_10px_30px_rgba(252,220,43,0.28)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#e8e4c6]">
      สำหรับเลข 2 ตัว 888PARUAY
      <strong class="text-[#fffdf0]">ระบุอัตราจ่ายไว้ที่ 100 ตามเงื่อนไขของรายการ</strong>
      สามารถเลือกเลขที่ต้องการ ตรวจสอบรอบเปิดรับ และเช็กรายละเอียดของบิลก่อนกดยืนยัน
      <strong class="text-[#fffdf0]">ช่วยให้จัดชุดเลขและติดตามรายการของตัวเองได้ง่ายขึ้นจากบัญชีสมาชิก</strong>
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBoxSevenThreeCyberCut as="h3" title="3 ตัวจ่าย 1,000">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[340, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), 353px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์อัตราจ่ายหวยพื้นเขียวเข้มที่มีเหรียญทองและสลากกินแบ่งเรียงอยู่ด้านหลัง ด้านซ้ายเป็นหญิงสาวผมยาวสวมชุดเดรสสีแดงกำลังชี้นิ้วเข้าหาข้อความ ด้านขวาเป็นชายหนุ่มสวมสูทสีขาวผูกโบว์ไทสีแดงกำลังชี้นิ้วกลับมาที่ข้อความเช่นกัน ด้านบนกลางภาพเป็นโลโก้ 888PARUAY ทรงกลมในวงแหวนทอง โดยเลข 888 เป็นสีเขียวและคำว่า PARUAY เป็นสีแดง ถัดลงมาเป็นข้อความบนแถบแดงว่า อัตราจ่ายหวย แล้วเป็นแผ่นป้ายขอบทองเขียนว่า 3 ตัวจ่าย 1,000 รอบภาพมีลูกบอลหวยสีแดง เขียว และขาวพิมพ์ตัวเลขวางอยู่ทั้งสองฝั่ง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#cf1111]/55 shadow-[0_10px_30px_rgba(252,220,43,0.24)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#e8e4c6]">
      เลข 3 ตัวของ 888PARUAY
      <strong class="text-[#fffdf0]">ระบุอัตราจ่ายไว้ที่ 1,000 ตามเงื่อนไขที่กำหนด</strong>
      ก่อนส่งรายการสามารถตรวจสอบตัวเลข ประเภทหวย รอบเวลา และอัตราจ่ายได้อีกครั้ง
      <strong class="text-[#fffdf0]">เหมาะสำหรับผู้ที่ต้องการติดตามเลข 3 ตัวจากหลายตลาดผ่านระบบเดียว</strong>
    </p>
  </ContentBoxSevenThreeCyberCut>

  <ContentBox3ThreePremium as="h2" title="สมัครแทงหวย 888PARUAY 3 ขั้นตอนง่ายๆ บนมือถือ" heading={false} titleleft="ขั้นตอนที่ 1" titlecenter="ขั้นตอนที่ 2" titleright="ขั้นตอนที่ 3">
    <p class="text-left text-base leading-relaxed text-[#e8e4c6]">
      การสมัครแทงหวย 888PARUAY
      <strong class="text-[#fffdf0]">สามารถทำผ่านมือถือได้ด้วยตัวเอง</strong>
      ขั้นตอนถูกจัดไว้ให้เข้าใจง่าย และหลังจากยืนยันบัญชีเรียบร้อยสามารถเข้าสู่ระบบเพื่อเลือกหวยที่กำลังเปิดรับได้ทันที โดยมี 3 ขั้นตอนหลักดังนี้
    </p>
    <p slot="left" class="text-left text-base leading-relaxed text-[#e8e4c6]">เปิดหน้าสมัคร 888PARUAY บนมือถือ แล้วกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน</p>
    <p slot="center" class="text-left text-base leading-relaxed text-[#e8e4c6]">ตรวจสอบข้อมูลส่วนตัวและรายละเอียดบัญชีให้ถูกต้องก่อนกดยืนยัน</p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#e8e4c6]">ยืนยันการสมัครและเข้าสู่ระบบ จากนั้นเลือกรัฐบาลไทย ฮานอย ลาวพัฒนา หรือหุ้นต่างประเทศที่ต้องการได้ทันที</p>
  </ContentBox3ThreePremium>

  <ContentBoxCyberCut as="h2" title="แอดมินเว็บ 888PARUAY ออนไลน์ตลอด 24 ชั่วโมง">
    <p class="text-left text-base leading-relaxed text-[#e8e4c6]">
      หากมีข้อสงสัยเกี่ยวกับการสมัคร รอบหวย อัตราจ่าย การตรวจหวย หรือการใช้งานบัญชี
      <strong class="text-[#fffdf0]">สามารถติดต่อแอดมินเว็บ 888PARUAY ได้ตลอด 24 ชั่วโมง</strong>
      <strong class="text-[#fffdf0]">ทีมงานพร้อมให้ข้อมูลเกี่ยวกับเมนูและช่วยตรวจสอบปัญหาตามรายละเอียดที่แจ้ง</strong>
      เพื่อให้สมาชิกเข้าถึงข้อมูลที่ต้องการได้สะดวกทุกช่วงเวลา
    </p>
  </ContentBoxCyberCut>

  <Faq as="h2" title="คำถามที่พบบ่อย" faqs={faqs} />

  <LatestWinners />

  <LoginRtpSection />

  <ReviewCardSumo />

  <Navfoot />
</MainLayout>
