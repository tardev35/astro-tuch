---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LatestWinnersPremium from "../components/LatestWinnersPremium.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

const pageTitle = "FUN24 รวมเกมเดิมพันครบ เล่นง่ายบนมือถือ สนุกได้ทั้งวัน";

const pageDescription =
  "FUN24 รวมเกมเดิมพันครบทุกหมวด คาสิโน บาคาร่า สล็อต ยิงปลา กีฬา และหวย สมัครง่าย รองรับมือถือ ฝากถอนผ่านระบบออโต้ พร้อมโปรโมชั่นและทีมงานบริการตลอด 24 ชั่วโมง";

const gameTypes = [
  {
    icon: "🎴",
    title: "คาสิโนออนไลน์และบาคาร่า",
    description: "เลือกโต๊ะคาสิโนและเกมบาคาร่าได้จากค่ายที่เปิดให้บริการ รองรับการเล่นผ่านมือถือและเว็บเบราว์เซอร์",
    accent: "gold" as const,
  },
  {
    icon: "🎰",
    title: "สล็อตออนไลน์และเกมยิงปลา",
    description: "รวมเกมสล็อตและเกมยิงปลาหลากหลายรูปแบบ มีทั้งเกมยอดนิยมและเกมเปิดใหม่ให้เลือกตามความสนใจ",
    accent: "blue" as const,
  },
  {
    icon: "⚽",
    title: "เดิมพันกีฬาและหวยออนไลน์",
    description: "รองรับการเลือกเดิมพันกีฬาหลายประเภท รวมถึงบริการหวยออนไลน์ที่สามารถตรวจสอบรายการและรอบเดิมพันได้ผ่านหน้าเว็บไซต์",
    accent: "gold" as const,
  },
];

const onboardingSteps = [
  {
    icon: "📝",
    title: "ขั้นตอนที่ 1 กดสมัครสมาชิก",
    description: "",
    accent: "gold" as const,
  },
  {
    icon: "🧾",
    title: "ขั้นตอนที่ 2 กรอกข้อมูลตามแบบฟอร์ม",
    description: "",
    accent: "blue" as const,
  },
  {
    icon: "✅",
    title: "ขั้นตอนที่ 3 กดปุ่มยืนยันการสมัคร",
    description: "",
    accent: "gold" as const,
  },
];

const faqs = [
  {
    q: "FUN24 มีเกมอะไรให้เลือกเล่นบ้าง?",
    a: "FUN24 รวมหลายหมวดบริการไว้ในระบบเดียว เช่น คาสิโนออนไลน์ บาคาร่า สล็อต ยิงปลา กีฬา และหวย โดยสามารถตรวจสอบรายการเกมและค่ายที่เปิดให้บริการได้จากหน้าเว็บไซต์",
  },
  {
    q: "FUN24 เล่นผ่านมือถือได้หรือไม่?",
    a: "รองรับการใช้งานผ่านโทรศัพท์ Android และ iPhone รวมถึงแท็บเล็ตและคอมพิวเตอร์ โดยสามารถเปิดผ่านเว็บเบราว์เซอร์ที่รองรับได้โดยตรง",
  },
  {
    q: "หากฝากถอนหรือเข้าใช้งาน FUN24 ไม่ได้ต้องทำอย่างไร?",
    a: "ตรวจสอบข้อมูลบัญชี การเชื่อมต่ออินเทอร์เน็ต และสถานะรายการก่อน หากยังพบปัญหา สามารถติดต่อทีมงาน FUN24 พร้อมแจ้งรายละเอียดเพื่อให้ช่วยตรวจสอบได้ตลอด 24 ชั่วโมง",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message="FUN24 รวมเกมเดิมพันครบทุกหมวด คาสิโน บาคาร่า สล็อต ยิงปลา กีฬา หวย • คืนยอดเสียทุกวัน 0.3% • แนะนำเพื่อนรับโบนัส 0.8% • ฝากถอนออโต้ 24 ชม." />

  <ContentBoxPremium as="h1" title="FUN24 เว็บเกมเดิมพันออนไลน์ รวมครบ เล่นง่าย สนุกได้ทั้งวัน">
    <p class="text-left text-base leading-relaxed text-[#fbe6d8]">
      <strong class="text-[#fb923c]">FUN24</strong> รวมบริการเกมเดิมพันออนไลน์หลายประเภทไว้ในระบบเดียว ทั้งคาสิโน บาคาร่า สล็อต ยิงปลา กีฬา และหวย รองรับการเข้าใช้งานผ่านโทรศัพท์มือถือ
      พร้อมระบบฝากถอนอัตโนมัติ โปรโมชั่นสำหรับสมาชิก และทีมงานคอยให้บริการตลอด 24 ชั่วโมง
    </p>
  </ContentBoxPremium>

  <SmoothCarousel />

  <ContentBox as="h2" title="FUN24 รวมเกมเดิมพันครบทุกหมวด คาสิโน บาคาร่า สล็อต ยิงปลา กีฬา หวย">
    <p class="text-left text-base leading-relaxed text-[#fbe6d8]">
      เลือกเล่นเกมออนไลน์กับ FUN24 ได้หลากหลายรูปแบบภายในเว็บไซต์เดียว ไม่ว่าจะเป็นคาสิโนสด บาคาร่า สล็อตออนไลน์ เกมยิงปลา เดิมพันกีฬา หรือหวยออนไลน์
      ช่วยให้สมาชิกเลือกบริการที่สนใจได้ง่ายโดยไม่ต้องสลับหลายเว็บไซต์
    </p>
    <FeatureHighlights items={gameTypes} heading={true} />
  </ContentBox>

  <ProviderGrid />

  <ContentBox as="h2" title="โปรโมชั่น FUN24 สิทธิพิเศษสำหรับสมาชิก รับได้ทุกวัน">
    <p class="text-left text-base leading-relaxed text-[#fbe6d8]">
      FUN24 มีโปรโมชั่นสำหรับสมาชิกทั้งยอดคืนจากการเล่นและโบนัสแนะนำเพื่อน สามารถเข้าสู่ระบบเพื่อตรวจสอบสิทธิ์ รายละเอียด และเงื่อนไขของแต่ละโปรโมชั่นได้ผ่านหน้าเว็บไซต์
    </p>
  </ContentBox>

  <ContentBoxSevenThreePremium titleright="โปรเล่นสล็อต คืนยอดเสีย รับโบนัส 0.3%">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="ภาพประกอบ FUN24 โปรเล่นสล็อต คืนยอดเสีย รับโบนัส 0.3% ธีมคาร์นิวัลสีส้ม-ดำ หญิงสาวยิ้มดีใจถือโทรศัพท์มือถือ เครื่องสล็อต 777 ไพ่เอซ ลูกเต๋า วงล้อรูเล็ต ชิปคาสิโนตรา FUN24 และเงาชิงช้าสวรรค์อยู่ด้านหลัง พร้อมตัวเลข 0.3% เรืองแสงสีส้ม"
      class="mx-auto h-auto w-full rounded-2xl border border-[#fb923c]/25 shadow-[0_10px_30px_rgba(251,146,60,0.18)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#fbe6d8]">
      สมาชิกที่มียอดเล่นเสียตรงตามเงื่อนไขสามารถรับยอดคืน 0.3% โดยตรวจสอบยอดและกดรับสิทธิ์ผ่านบัญชีสมาชิกตามรอบที่กำหนด
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBoxSevenThreePremium titleright="โปรแนะนำเพื่อน รับโบนัส 0.8%">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="ภาพประกอบ FUN24 โปรแนะนำเพื่อน รับโบนัส 0.8% ธีมคาร์นิวัลสีส้ม-ดำ หญิงสาวยิ้มดีใจถือโทรศัพท์มือถือ เครื่องสล็อต 777 วงล้อรูเล็ต ไพ่เอซ ลูกเต๋า ชิปคาสิโนตรา FUN24 และเงาหอคอยชมวิวคาร์นิวัลอยู่ด้านหลัง พร้อมตัวเลข 0.8% เรืองแสงสีส้มในกรอบข้อความ"
      class="mx-auto h-auto w-full rounded-2xl border border-[#fb923c]/25 shadow-[0_10px_30px_rgba(251,146,60,0.18)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#fbe6d8]">
      แชร์ลิงก์แนะนำให้เพื่อนสมัคร FUN24 และรับโบนัส 0.8% จากยอดเล่นของเพื่อนตามเงื่อนไข สมาชิกสามารถตรวจสอบยอดโบนัสผ่านบัญชีของตนเองได้
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBox as="h2" title="เริ่มต้นง่าย สมัครสมาชิก FUN24 เพียง 3 ขั้นตอน">
    <p class="text-left text-base leading-relaxed text-[#fbe6d8]">
      สมัคร FUN24 ผ่านโทรศัพท์มือถือได้ง่าย ใช้เพียงไม่กี่ขั้นตอนก่อนเริ่มใช้งาน
    </p>
    <FeatureHighlights items={onboardingSteps} heading={false} />
  </ContentBox>

  <LatestWinnersPremium />

  <ContentBox as="h2" title="เล่น FUN24 ผ่านมือถือได้สะดวก ใช้งานได้ทุกที่">
    <p class="text-left text-base leading-relaxed text-[#fbe6d8]">
      FUN24 รองรับการเข้าใช้งานผ่านโทรศัพท์มือถือทั้ง Android และ iOS รวมถึงแท็บเล็ตและคอมพิวเตอร์ สามารถเปิดผ่านเว็บเบราว์เซอร์เพื่อสมัครสมาชิก เข้าสู่ระบบ
      เลือกเกม ตรวจสอบโปรโมชั่น และจัดการบัญชีได้จากอุปกรณ์เครื่องเดียว
    </p>
  </ContentBox>

  <ContentBoxCyberCut as="h2" title="ฝากถอน FUN24 ผ่านระบบออโต้ พร้อมขั้นตอนแนะนำ">
    <p class="text-left text-base leading-relaxed text-[#fbe6d8]">
      สมาชิกสามารถทำรายการฝากและถอนผ่านระบบของ FUN24 ได้ด้วยตนเอง ควรตรวจสอบข้อมูลบัญชี จำนวนเงิน และสถานะรายการให้ถูกต้องก่อนยืนยันทุกครั้ง
    </p>
    <p class="mt-4 text-left text-base leading-relaxed text-[#fbe6d8]">
      หากเป็นสมาชิกใหม่ สามารถดูขั้นตอนการฝากและถอนแบบละเอียดผ่านหน้าคู่มือการใช้งานของเว็บไซต์
    </p>
  </ContentBoxCyberCut>

  <ContentBox as="h2" title="พบปัญหาการใช้งาน ติดต่อทีมงาน FUN24 ได้ตลอด 24 ชั่วโมง">
    <p class="text-left text-base leading-relaxed text-[#fbe6d8]">
      หากพบปัญหาเกี่ยวกับการสมัครสมาชิก การเข้าสู่ระบบ โปรโมชั่น เกม หรือรายการฝากถอน สามารถติดต่อทีมงาน FUN24 ผ่านช่องทางบริการลูกค้าอย่างเป็นทางการเพื่อให้ช่วยตรวจสอบได้ตลอด 24 ชั่วโมง
    </p>
    <p class="mt-4 text-left text-base leading-relaxed text-[#fbe6d8]">
      ทีมงานสามารถช่วยตรวจสอบเรื่องต่าง ๆ เช่น การสมัครไม่สำเร็จ ลืมรหัสผ่าน รายการฝากถอนไม่อัปเดต การรับโปรโมชั่น และปัญหาการเข้าใช้งาน
    </p>
  </ContentBox>

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#fb923c] to-[#ea580c] px-4 py-3 text-sm font-black whitespace-nowrap text-[#1a0800] shadow-[0_10px_30px_rgba(234,88,12,0.26)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(234,88,12,0.4)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>

    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#c2410c]/70 bg-[#170a03]/85 px-4 py-3 text-sm font-black whitespace-nowrap text-[#fbe6d8] backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:border-[#ea580c] hover:bg-[#2a1206]/85 hover:shadow-[0_15px_40px_rgba(251,146,60,0.35)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>
  </div>

  <Faq title="คำถามที่พบบ่อยเกี่ยวกับ FUN24" faqs={faqs} />

  <ReviewCardSumo2 />

  <Navfoot />
</MainLayout>
