---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ContentBoxHuay from "../components/ContentBoxHuay.astro";
import ContentBoxTwoHuay from "../components/ContentBoxTwoHuay.astro";
import LottoGrid from "../components/LottoGrid.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxSevenThreeHuay from "../components/ContentBoxSevenThreeHuay.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBox3Three from "../components/ContentBox3Three.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import Faq from "../components/Faq3.astro";
import LatestWinners from "../components/LatestWinnersHuay.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import { pageGraph } from "../lib/schema";
import threeDigitPoster from "../assets/slide1.png";
import twoDigitPoster from "../assets/slide2.png";

// การหมุน variant รอบนี้ตัดสินไว้แล้วใน .claude/brand-spec-lottoplus.md §3 —
// **ห้ามเลือกใหม่ที่นี่** แบรนด์ขาออก (WIN8S) ถูกหมุนออกจากทุกตระกูลพร้อมกัน และ
// รอบนี้ **ทับซ้อนกับรอบก่อนศูนย์ตัว**: AnnouncementHuay แทน AnnouncementPremium ·
// Faq3 แทน Faq2 · LatestWinnersHuay แทน LatestWinners4 · ReviewCardSumo2 แทน
// ReviewCardSumo · **LottoGrid แทน ProviderGridPremium** (แบรนด์รอบนี้เป็นเว็บหวย
// ไม่ใช่คาสิโน บรีฟจึงไม่มีค่ายเกมให้ขึ้นกริด) · และ shape-mix ของ ContentBox ทิ้ง
// ชุด Premium + TwoNeumorphism + FloatingBadge + SevenThreePremium +
// SevenThreeNeumorphism + 3ThreeCyberCut + TwoCyberCut ของรอบก่อนทั้งชุด ไปใช้
// **Huay + TwoHuay + CyberCut + SevenThreeHuay + SevenThree(ฐาน) + 3Three(ฐาน) +
// Special** แทน
// ไม่ลบไฟล์ที่ไม่ได้ใช้แม้แต่ตัวเดียว — มันคือ inventory ของแบรนด์ถัดไป
// Navbar/Footer อยู่ที่ MainLayout (NavbarHuay / FooterHuay) ไม่ใช่ที่ไฟล์นี้
// ❌ รอบนี้ **ไม่ใช้ ProviderGrid* / FeatureHighlights (render h3 จะดัน h3 เกิน) /
// BankStrip / SmoothCarousel / LoginRtpSection / GameRankingBoard / FeaturedGames /
// PopularGamesStrip / ตระกูล *Premium · *Neumorphism · *FloatingBadge** —
// บรีฟรอบนี้ไม่มีหมวดฝากถอน ธนาคาร วอลเลท ค่ายเกม หรือโปรโมชั่นเลยแม้แต่คำเดียว
// ⚠️ `<Announcement />` ถูกเรียกแบบ **ไม่ส่ง message** โดยตั้งใจ — default ของ
// AnnouncementHuay เป็นคอปปี้ของแบรนด์รอบนี้อยู่แล้ว และหน้าย่อยทุกหน้า (promotion ·
// about-us · contact-us · ทางเข้า · ทดลองเล่น · login · register · ตรวจหวย ·
// แนวทาง) ก็เรียกแบบ bare เหมือนกัน ข้อความ ticker จึงตรงกันทั้งเว็บจากที่เดียว
//
// ⚠️⚠️ พาเลตรอบนี้ (brand-spec §2 ล็อกค่าไว้ ห้ามเดาเพิ่ม ห้ามดูดสีจากรูป):
// 🚨🚨 **กลับทิศ 180° จากรอบก่อน — รอบนี้ "สว่างทั้งเว็บ"** (รอบก่อน WIN8S พื้นเพจ
// เป็นดำอมเลือดหมู = มืดทั้งเว็บ) พื้นเพจ #e1fef3 (bg.json) = เขียวมินต์จางเกือบขาว ·
// การ์ดเนื้อหา #ffffff · การ์ดสำรอง #f0fdf7 · ชั้นยก/พื้นถมอ่อน #d2f3e4 ·
// เส้นบาง #a3ddc3 · ขอบ/ออรา #19a97c · ออราสว่าง #2fd49b ·
// โครม (navbar/footer/ticker เท่านั้น) #052e22 / #03201a / #0a4433 ·
// หมึก #0d3326 (= BRAND_TEXT) · หมึกรอง #3f6f5c ·
// **หัวข้อ + ลิงก์ + <strong> = #046c4e เขียวมรกต** (6.70:1 บนการ์ดขาว ·
// 6.27:1 บนพื้นเพจ) · ทองเข้มที่ถือตัวอักษรได้ #8a6508 · ทองอำพัน #e2b32a ·
// เงินโครเมียม #c8d4d0
// 🚨🚨 **#19a97c (3.0:1) #2fd49b #a3ddc3 #d2f3e4 ห้ามถือตัวอักษรทุกกรณี** และ
// **#e2b32a ได้ 2.0:1 บนขาว** จึงถือตัวอักษรได้เฉพาะเมื่อนั่งบนโครมเข้มเท่านั้น
// 🚨🚨 **ตระกูล *Huay ที่หมุนเข้ามารอบนี้เป็นของแบรนด์หวยเจ้าก่อนซึ่งเป็นแดง/ทอง**
// และ LOTTO189 ก็เป็นเว็บหวยเหมือนกัน — "เป็นเว็บหวยเหมือนกัน" กับ "เจอเขียว"
// ไม่เคยพิสูจน์ว่าสีเป็นของรอบนี้ ต้องเทียบให้ตรงหกหลัก ลิสต์เฮกซ์เต็มของทุกแบรนด์
// อยู่ที่ brand-spec §2
// ✅ LINE green 00B900 กับเขียว success ของฟีดถอนเงินเป็นสีเชิงความหมาย **คงไว้
// ห้ามกลืนเข้าเขียวมรกตของรอบนี้** — รอบนี้สับสนง่ายที่สุดเพราะแบรนด์ก็เป็นเขียว
//
// ย่อหน้าในไฟล์นี้ไม่ถือคลาสสีหรือขนาดของตัวเอง — ทุก ContentBox* ในมิกซ์นี้ตั้ง
// `text-left text-base leading-relaxed` + หมึก #0d3326 ไว้บน element ที่ถือ slot
// อยู่แล้ว และไม่มี `<p>` ไหนมี mx-auto / max-w-* (การ์ดคุมความกว้างเองแล้ว)
// ไฮไลต์ <strong> มีสีเดียวคือ #046c4e ซึ่งเป็นงานของหน้านี้ ไม่ใช่ของ component
//
// ⚠️ ชื่อแบรนด์รอบนี้เป็น **ตัวละตินพิมพ์ใหญ่ LOTTO ติด PLUS เป็นคำเดียว
// เก้าเคอแรกเตอร์** แต่ยัง interpolate จาก `${BRAND_NAME}` ทุกจุดรวมถึงใน alt
// **ห้ามพิมพ์ชื่อแบรนด์เป็นตัวอักษรตรงๆ ที่ไหนเลย** ไม่มีโดเมนเขียนไว้ที่ไหน
// และไม่มี URL ที่ต่อด้วย `+`
// ⚠️ ชื่อไทยที่บรีฟใช้คู่กันคือ **หวยพลัสลอตโต้** — นั่นเป็นคำในเนื้อหาของบรีฟ
// ไม่ใช่ค่าของ BRAND_NAME จึงพิมพ์ตรงได้ในฐานะถ้อยคำของบรีฟ
//
// <strong> ทุกตัวคร่อม "ก้อนที่คั่นด้วยช่องว่าง" ทั้งก้อน เพราะภาษาไทยไม่มีช่องว่าง
// ระหว่างคำ — อ่านคอปปี้โดยถอดแท็กออกต้องได้ข้อความของบรีฟเป๊ะ
//
// บรีฟรอบนี้ **โฆษณาและกำกับในย่อหน้าเดียวกัน** (brand-spec §5): หัวข้อเขียนว่า
// ทางเข้าเว็บแม่ · อัตราจ่ายสูง · จ่ายเต็ม · โอนไว · การันตีเว็บหวยอัตราจ่ายสูง
// ขณะที่ย่อหน้าของบรีฟเองตอบกลับว่า คำกล่าวอ้างว่าเป็นเว็บแม่จำเป็นต้องมีหลักฐาน
// ที่ตรวจสอบได้ · ความรวดเร็วในการโอนอาจขึ้นอยู่กับสถานะระบบและผู้ให้บริการชำระเงิน ·
// ควรตรวจสอบฐานเงินเดิมพันที่ใช้คำนวณอัตราจ่าย · **ผลการออกรางวัลมีความไม่แน่นอน
// และไม่สามารถรับประกันได้จากสถิติหรือเลขย้อนหลัง** · ไม่ควรเปิดเผยรหัสผ่านและรหัส
// OTP · ควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการเพื่อหลีกเลี่ยงบัญชีแอบอ้าง —
// **ship ทั้งสองครึ่งตรงตามที่บรีฟเขียน ไม่ขยายคำโฆษณาเป็นคำกล่าวอ้างใหม่ และทุก
// ประโยคกำกับ ship ครบ ไม่ตัดเพราะฟังดูลบ**
// 🚨🚨 **ประเภทหวยรอบนี้มีสี่ ไม่ใช่เจ็ด**: หวยรัฐบาลไทย · หวยลาว · หวยฮานอย ·
// หวยหุ้น (บรีฟเขียน "หวยหุ้นต่างประเทศ" ในบรรทัด 4 และ "หวยหุ้นที่อ้างอิงดัชนี
// ตลาดหลักทรัพย์" ในบรรทัด 6 — ทั้งสองรูปเป็นถ้อยคำของบรีฟเอง)
// ❌ **สล็อต · บาคาร่า · คาสิโนสด · ไฮโล · รูเล็ต · ยิงปลา · เดิมพันฟุตบอล ·
// ค่ายเกม · ฟรีสปิน · ค่า RTP · ฝากถอนออโต้ · ทรูวอลเลท · ไม่มีขั้นต่ำ ·
// คืนยอดเสีย % · แนะนำเพื่อน % ไม่มีในบรีฟรอบนี้เลยสักคำ** (ชุดคาสิโนเป็นของ WIN8S
// รอบก่อนทันที — ห้ามสืบทอดลิสต์ข้ามรอบ)
// ⚠️ คำว่า **"การตรวจสอบรายการฝากถอน"** ในบรรทัด 22 เป็นถ้อยคำของบรีฟเองตรงตัว
// (เป็นหัวข้อที่สอบถามแอดมินได้ **ไม่ใช่การเปิดหมวดฝากถอน/ธนาคารของเว็บ**) จึง
// ship ตามที่เขียน และยังไม่มี BankStrip บนหน้านี้
// ตัวเลขบนหน้านี้มีแค่ของบรีฟเอง: **100 · 1,000 · 2 ตัว · 3 ตัว · 3 ขั้นตอน · 24ชม.**
// ❌ ไม่มีจำนวนสมาชิก ไม่มีปีก่อตั้ง ไม่มีใบอนุญาต ไม่มีจำนวนค่าย/เกม
// ❌ คำของแบรนด์ก่อนห้ามเขียนกลับเข้ามา: WIN8S / คาสิโนเล่นบาคาร่า / ลิขสิทธิ์แท้
// จากเมกา / เซิร์ฟนอก / ปลอดภัย100% / ไม่หักเปอร์เซ็นต์ / โบนัสไม่อั้น ·
// 123BET / เว็บตรง / เซิร์ฟแท้ / ครบทุกค่าย · ZORO365 · TEVA69 · LOTTO189 /
// แนะนำเว็บหวยลอตโต้ / รับทุกเลข ไม่มีอั้นเลข / หวยออมสิน / หวยลาวพัฒนา /
// บาทละ 1,000 / เลขเด็ด · ZANE96 · ZNOVA168 · MEXICANOSLOT · JEDI66 · okkub88 ·
// SUMOHENG
//
// title/description = บรรทัด 1-2 ของบรีฟ **verbatim** (src/assets/content.txt)
// ส่งที่นี่เพราะ pageGraph ต้องใช้สตริงเดียวกับที่ MainLayout ได้รับ
// **ห้ามต่อเติม** (description = 122 ตัวอักษร ตามที่บรีฟเขียนมาเอง และ
// verify-build ยกเว้นเพดานล่าง 150 ให้หน้าแรกไว้ด้วยเหตุผลนี้โดยเฉพาะ —
// หน้าย่อยไม่ได้รับการยกเว้น)
const pageTitle = `${BRAND_NAME} หวยพลัสลอตโต้ แทงหวยออนไลน์ จ่ายเต็ม โอนไว`;

const pageDescription = `${BRAND_NAME} หวยพลัสลอตโต้ ทางเข้าเว็บแม่ แทงหวยออนไลน์ รัฐบาลไทย ลาว ฮานอย หุ้น อัตราจ่ายสูง 3ตัว 1,000 จ่ายเต็ม โอนไวแน่นอน`;

// บรรทัด 3 ของบรีฟ ซึ่ง **ต่างจากบรรทัด 1** — ใช้ตามบรีฟ ไม่ copy title
const pageH1 = `${BRAND_NAME} หวยพลัสลอตโต้ ทางเข้าเว็บแม่ แทงหวยออนไลน์`;

// บรีฟรอบนี้มีชั้น H1 -> H2 -> H3 จริง จึง **ไม่** แบนเป็น H2 ล้วน
//
// checklist ตามลำดับเอกสาร (brand-spec §4) และตัวที่รับแต่ละข้อ:
//    1 H1  <แบรนด์> หวยพลัสลอตโต้ ทางเข้าเว็บแม่ แทงหวยออนไลน์
//          ContentBoxHuay, ย่อหน้าบรรทัด 4
//    2 H2  <แบรนด์> รัฐบาลไทย ลาว ฮานอย หุ้น อัตราจ่ายสูง จ่ายเต็ม โอนไว
//          ContentBoxTwoHuay, บรรทัด 6 แบ่งสองซีกโดยไม่ตกประโยคไหน
//          + LottoGrid ต่อท้ายทันที (วิดเจ็ตประเภทหวยของหัวข้อนี้โดยตรง)
//    3 H2  <แบรนด์> การันตี เว็บหวยอัตราจ่ายสูง
//          ContentBoxCyberCut, บรรทัด 8
//    4 H3  หวย 2 ตัว อัตราจ่าย 100
//          ContentBoxSevenThreeHuay + **slide2** ในสล็อตขวา, บรรทัด 10
//    5 H3  หวย 3 ตัว อัตราจ่าย 1,000
//          ContentBoxSevenThree (ฐาน) + **slide1** ในสล็อตขวา, บรรทัด 12
//    6 H2  สมัครแทงหวย <แบรนด์> ครบทุกประเภท
//          ContentBox3Three (ฐาน), intro (บรรทัด 14) เข้า default slot และ
//          ขั้นตอน 1/2/3 (บรรทัด 15-20) เข้า left/center/right
//    7 H2  แอดมิน <แบรนด์> แทงหวยออนไลน์ตลอด 24ชม.
//          ContentBoxSpecial (**ส่ง as="h2" ชัดเจน**), บรรทัด 22 แบ่งสองซีก
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ <แบรนด์>
//          Faq3 + prop faqs ชัดเจน (**ส่ง as="h2"**), บรรทัด 24-29
// inventory ที่ต้องได้: **h1 ×1 · h2 ×5 · h3 ×2** — ตรงเป้าของ brand-spec §4
//
// ⚠️ จุดที่ชั้น heading รั่วได้ และกันไว้แล้วทุกจุด: บรรทัด 15/17/19 ของบรีฟ
// (ขั้นตอนที่ 1/2/3) **ไม่มี prefix H** จึงส่งเข้า titleleft/titlecenter/titleright
// ของ ContentBox3Three โดย **ไม่ส่ง `heading`** (default false -> <p>) ·
// **ไม่ส่ง titleright ให้ ContentBoxTwoHuay และ SevenThree ทั้งสองใบ** ซีกขวาและ
// คอลัมน์ภาพจึงไม่มี heading · คำถามใน Faq3 เป็น <span> ใน <summary> ไม่ใช่ heading
// grep `<h[1-6]` ในทุก component ที่ไฟล์นี้เรียกแล้วรอบนี้ — **ไม่มีไฟล์ไหนมีแท็ก
// heading เป็นตัวอักษรเลยสักตัว** ทุกหัวข้อบนหน้ามาจาก <HeadingTag> ที่ผูกกับ prop
// คือมาจากบรีฟ
// chrome บนหน้านี้ (AnnouncementHuay · LottoGrid · LatestWinnersHuay ·
// ReviewCardSumo2 · Navfoot) ขึ้นป้ายเป็น <p>/<span> พร้อม aria-label บน <section>
// **ห้ามเลื่อน <p> พวกนั้นขึ้นเป็น h2 เพื่อ "แก้ชื่อที่ขาด"**
//
// ── รูปภาพ ────────────────────────────────────────────────────────────────
// รอบนี้ใช้ **สองใบ** และอยู่ในตระกูล SevenThree ทั้งคู่ (playbook ตรึง slide* ไว้
// กับตระกูลนี้ และเพดานคือ 2 บล็อก — รอบนี้ใช้ครบพอดี ไม่มีใบที่สาม)
// **ข้อความที่พิมพ์บนอาร์ตเวิร์กคือตัวตัดสินการจับคู่ ไม่ใช่ลำดับไฟล์** (เปิดอ่าน
// บิตแมปจริงด้วย Read แล้วรอบนี้):
//   slide1.png พิมพ์ **อัตราจ่าย / 3 ตัว จ่าย / 1,000 บาท** โดยมี **มงกุฎทองดวงเล็ก**
//     วางอยู่เหนือคำว่า อัตราจ่าย และนางแบบ **พนมมือไหว้** -> §5
//   slide2.png พิมพ์ **อัตราจ่าย / 2 ตัว จ่าย / 100 บาท** และนางแบบ **ถือพัดพับทอง**
//     ขึ้นมาข้างใบหน้า ไม่มีมงกุฎ -> §4
// ⚠️⚠️ **สลับกับลำดับเลขท้ายชื่อไฟล์โดยตั้งใจ** — uploader เขียนทับสองไฟล์นี้ทุกดรอป
// การจับคู่จึงไม่มีความหมายข้ามแบรนด์ **ห้ามลอกจากรอบก่อน** หน้า /promotion ใช้
// สองใบเดียวกันนี้ (2 ตัว มาก่อน 3 ตัว ตามลำดับหัวข้อของบรีฟ)
// ⛔ **banner1 / banner1-mobile / og.png เป็นของ MainLayout** (glob ปักชื่อไว้แล้ว)
// และ **banner2.png / banner3.png / slide3.png / slide4.png เป็นอาร์ตเวิร์กของ
// แบรนด์อื่น ห้าม import เด็ดขาด** เพราะ eager import = emit ขึ้น dist ทุก build
// แม้ไม่มีหน้าไหน render และ verify-build.mjs จะแดงถ้ามีรูปที่ไม่ได้ถูก render
// ⚠️ ไม่มีภาพไหนบนหน้านี้เป็น LCP (hero อยู่ที่ MainLayout) จึง **ไม่มี
// loading="eager" / fetchpriority="high"** สักใบ สไลด์ทั้งสองอยู่ใต้ fold
//
// `widths`/`sizes` คำนวณจากเรขาคณิตจริงของคอลัมน์ภาพ (3fr ฝั่งขวา) ของ **variant
// ที่ถือรูปใบนั้นจริง ๆ** — สองชุดนี้ **สลับกันไม่ได้** และ **ไม่ได้ลอกจากรอบก่อน**
// (รอบก่อนคิดจาก SevenThreePremium + SevenThreeNeumorphism ซึ่งเป็นคนละไฟล์กับ
// รอบนี้ทั้งคู่) Tailwind เป็น border-box ทั้งโปรเจกต์ max-w/padding จึงนับรวมกัน
// บิตแมปจริงของดรอปนี้ **375x600 ทั้งสองใบ** เพดานจึงเป็น **375 และห้ามมี
// candidate ไหนเกิน 375** เพราะเกินกว่านั้นคือการอัพสเกล
//
// §4 ContentBoxSevenThreeHuay — section **max-w-[1400px]** + px-4(32) · การ์ด
//   border(1x2=2) · p-8 / md:p-10(80) · grid **gap-8(32)** · คอลัมน์ภาพจ่าย
//   md:pl-6(24) อยู่ในกล่องของมันเอง (md:border-r + md:pr-6 อยู่บนคอลัมน์ข้อความ
//   จึงกินแทร็กของฝั่งนั้น ไม่ใช่ของรูป)
//   >=1400px : (1400 - 32 - 2 - 80 - 32) x 0.3 - 24 = 1254 x 0.3 - 24 = 352px
//   768-1399 : (100vw - 146) x 0.3 - 24             = calc(30vw - 68px)
//   473-767  : ยุบเหลือคอลัมน์เดียวที่ p-8 -> 100vw - 98 ซึ่ง >= 375 จึงติดเพดาน = 375px
//   < 473    : คอลัมน์เดียวที่ p-8                   = calc(100vw - 98px)
// candidate: 163 = ค่าต่ำสุดของแบนด์ md (ที่ 768px: 230.4 - 68 = 162.4) ·
//   277 = 100vw-98 ที่จอ 375px · 352 = 1x ที่ >= 1400px · 375 = **เพดานบิตแมปจริง**
//   (2x ของ 352 = 704 เกินบิตแมป จึงตกลงมาที่ 375)
const twoDigitWidths = [163, 277, 352, 375];
const twoDigitSizes = "(min-width: 1400px) 352px, (min-width: 768px) calc(30vw - 68px), (min-width: 473px) 375px, calc(100vw - 98px)";

// §5 ContentBoxSevenThree (ฐาน) — section **max-w-7xl (1280)** + px-4(32) · การ์ด
//   border(1x2=2) · p-8 / md:p-10(80) · grid **gap-10(40)** · คอลัมน์ภาพจ่าย
//   md:pl-6(24) — cap อยู่บน <section> ดังนั้น px-4 ออกจาก 1280
//   >=1280px : (1280 - 32 - 2 - 80 - 40) x 0.3 - 24 = 1126 x 0.3 - 24 = 314px
//   768-1279 : (100vw - 154) x 0.3 - 24             = calc(30vw - 70px)
//   473-767  : คอลัมน์เดียวที่ p-8 -> 100vw - 98 ซึ่ง >= 375 จึงติดเพดาน = 375px
//   < 473    : คอลัมน์เดียวที่ p-8                   = calc(100vw - 98px)
// candidate: 161 = ค่าต่ำสุดของแบนด์ md (ที่ 768px: 230.4 - 70 = 160.4) ·
//   277 = 100vw-98 ที่จอ 375px · 314 = 1x ที่ >= 1280px · 375 = **เพดานบิตแมปจริง**
// ⚠️ ต่างจาก §4 ที่ 1x ถึง 38px และคนละเบรกพอยต์บนสุด — **ห้ามลอกตัวเลขข้ามไฟล์**
// ถ้าแก้ padding/gap/border/cap ที่ component ต้องกลับมาแก้สองชุดนี้ด้วย
const threeDigitWidths = [161, 277, 314, 375];
const threeDigitSizes = "(min-width: 1280px) 314px, (min-width: 768px) calc(30vw - 70px), (min-width: 473px) 375px, calc(100vw - 98px)";

// บรรยายจากบิตแมปจริงของดรอปนี้ (เปิดอ่านด้วย Read แล้ว) **ไม่ใช่คัดลอกของรอบก่อน**
// ภาษาภาพของ WIN8S ที่ **ไม่มี** ในสองรูปนี้เลย — ห้องญี่ปุ่น กิ่งซากุระ กิโมโน
// เสาโทริอิ มังกร ร่มกระดาษญี่ปุ่น พัดพับแดง-ขาว ชิปคาสิโน ไพ่เอซ
// ✅ สิ่งที่มีจริงในดรอปนี้: ห้องโทนขาวงาช้าง · ยอดปรางค์ทองแบบไทย · ดอกลีลาวดี
// ขาวกลางเหลือง · หญิงสาวในชุดไทยผ้าทอทองครีมปักลาย · เครื่องประดับทองฝังพลอยเขียว ·
// ลูกบอลหวยเขียว-ขาวพิมพ์ตัวเลข · เวิร์ดมาร์กสามมิติสองบรรทัดที่ใบโคลเวอร์สี่แฉก
// เขียวมรกตแทนตัว O ตัวที่สอง
// ✅ brand-spec §6 ยืนยันว่าอาร์ตเวิร์กดรอปนี้ **สะอาด** — เวิร์ดมาร์กบนสไลด์เป็นของ
// แบรนด์ปัจจุบันจริง จึงอ้างชื่อผ่าน ${BRAND_NAME} ได้ (ไม่ใช่กรณีของบางดรอปที่ตรา
// ของแบรนด์เก่าค้างบนรูป)
const twoDigitAlt = `โปสเตอร์อัตราจ่ายแนวตั้ง มุมบนขวาเป็นโลโก้ ${BRAND_NAME} แบบเวิร์ดมาร์กสามมิติสองบรรทัด บรรทัดบนเป็นผิวโครเมียมเงินขัดเงาโดยตัว O ตัวที่สองถูกแทนด้วยใบโคลเวอร์สี่แฉกสีเขียวมรกต บรรทัดล่างเป็นผิวเขียวมรกตไล่เงาในวงรีแถบโครเมียม-เขียว ฝั่งซ้ายเป็นหญิงสาวผมยาวสีเข้มในชุดไทยผ้าทอสีทองครีมปักลาย สวมสร้อย กำไล และเครื่องประดับผมทองฝังพลอยเขียว ถือพัดพับสีทองขึ้นมาข้างใบหน้า ฉากหลังเป็นห้องโทนขาวงาช้าง ยอดปรางค์ทองแบบไทย และดอกลีลาวดีขาวกลางเหลือง ครึ่งขวาเป็นตัวอักษรไทยสามมิติผิวเขียวมรกตตัดขอบทองอ่านว่า อัตราจ่าย ใต้ลงมาเป็นคำว่า 2 ตัว จ่าย ตัวขาว แล้วตัวเลข 100 ตัวโตสามมิติผิวทองตัดขอบเข้ม ต่อท้ายด้วยคำว่า บาท ปิดท้ายด้วยแคปซูลพื้นขาวขอบทองที่เขียนว่า สมัครสมาชิก พร้อมไอคอนรูปคนกับเครื่องหมายบวกและลูกศรคู่ ขอบล่างขวามีลูกบอลหวยสีเขียว-ขาวพิมพ์ตัวเลข`;

const threeDigitAlt = `โปสเตอร์อัตราจ่ายแนวตั้งในห้องโทนขาวงาช้างเดียวกัน มุมบนขวาเป็นโลโก้ ${BRAND_NAME} แบบเวิร์ดมาร์กสามมิติสองบรรทัด บรรทัดบนเป็นผิวโครเมียมเงินขัดเงาโดยตัว O ตัวที่สองถูกแทนด้วยใบโคลเวอร์สี่แฉกสีเขียวมรกต บรรทัดล่างเป็นผิวเขียวมรกตไล่เงา ฝั่งซ้ายเป็นหญิงสาวผมยาวสีเข้มถักเปียในชุดไทยผ้าทอสีทองครีมปักลาย สวมเครื่องประดับทองฝังพลอยเขียวและมีดอกไม้ขาวประดับผม ยกมือขึ้นพนมไหว้ ฉากหลังเป็นยอดปรางค์ทองแบบไทยและดอกลีลาวดีขาวกลางเหลือง ครึ่งขวาเป็นตัวอักษรไทยสามมิติผิวเขียวมรกตตัดขอบทองอ่านว่า อัตราจ่าย โดยมีมงกุฎทองดวงเล็กวางอยู่ด้านบน ใต้ลงมาเป็นคำว่า 3 ตัว จ่าย ตัวขาว แล้วตัวเลข 1,000 ตัวโตสามมิติผิวทองตัดขอบเข้ม ต่อท้ายด้วยคำว่า บาท ปิดท้ายด้วยแคปซูลพื้นขาวขอบทองที่เขียนว่า สมัครสมาชิก พร้อมไอคอนรูปคนกับเครื่องหมายบวกและลูกศรคู่ ขอบล่างขวามีลูกบอลหวยสีเขียว-ขาวพิมพ์ตัวเลข`;

// อาร์เรย์เดียว ใช้ทั้งกับ <Faq> และโน้ด FAQPage — ไม่ใช้ default ของ component
// (Faq3 ตั้งใจ ship เป็นลิสต์ว่าง prop ที่ลืมส่งจึงได้ accordion เปล่า ไม่ใช่
// คำถามของแบรนด์ก่อน) สามคู่นี้คือบล็อก Q/A ของบรีฟเอง (content.txt บรรทัด 24-29)
// ตรงตัว ตัดเฉพาะหมายเลข "1." "2." "3." ออกเพราะ accordion เป็นตัวลิสต์อยู่แล้ว
// ทุกคำตอบคงประโยคกำกับของบรีฟไว้ครบ — เป็นเนื้อหาของบรีฟทั้งสองครึ่ง
const faqs = [
  {
    q: `${BRAND_NAME} มีหวยประเภทไหนให้เลือกบ้าง?`,
    a: `ตามข้อมูลที่ระบุ ${BRAND_NAME} นำเสนอหวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยหุ้น โดยควรตรวจสอบรายการที่เปิดให้บริการจริง รวมถึงรอบปิดรับและแหล่งอ้างอิงผลรางวัลก่อนทำรายการ`,
  },
  {
    q: `${BRAND_NAME} มีอัตราจ่ายหวย 2 ตัว 100 และ 3 ตัว 1,000 จริงหรือไม่?`,
    a: `เว็บไซต์ระบุอัตราจ่ายดังกล่าว แต่ควรตรวจสอบฐานเงินเดิมพัน ประเภทหวยที่เข้าร่วม และวงเงินจ่ายสูงสุดจากตารางอัตราจ่ายล่าสุดก่อนยืนยันบิล`,
  },
  {
    q: `${BRAND_NAME} มีแอดมินให้บริการตลอด 24 ชั่วโมงหรือไม่?`,
    a: `เว็บไซต์ระบุว่ามีช่องทางติดต่อแอดมินตลอด 24 ชั่วโมง โดยควรตรวจสอบช่องทางติดต่อและเวลาการให้บริการจริงจากประกาศล่าสุดของผู้ให้บริการ`,
  },
];

// ไม่มี breadcrumb: นี่คือหน้าแรก เส้นทางจาก root มาหาตัวเองจะเหลือครั้งเดียวที่ชี้ตัวเอง
// ทุก URL ในกราฟมาจาก pageGraph ที่ derive จาก site: — ไม่มีโดเมนพิมพ์ไว้ในไฟล์นี้
// ไม่มี URL ที่ต่อด้วย `+` และไม่ส่งโน้ด Review / AggregateRating / sameAs /
// address / PostalAddress / email เข้าไปเลย
// `description` เป็นสตริงเดียวกับที่ MainLayout ได้รับ `name` เป็น H1 ของหน้า และ
// `faqs` เป็นอาร์เรย์ตัวเดียวกับที่ <Faq> ได้รับ
const graph = pageGraph(Astro, {
  name: pageH1,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxHuay as="h1" title={pageH1}>
    <p>
      {BRAND_NAME} หวยพลัสลอตโต้
      <strong class="text-[#046c4e]">นำเสนอข้อมูลหวยออนไลน์หลากหลายประเภท ทั้งหวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยหุ้นต่างประเทศ</strong>
      พร้อมรายละเอียดอัตราจ่ายและรอบประกาศผลที่แตกต่างกัน ผู้ใช้งานสามารถศึกษารูปแบบการเดิมพัน ตรวจสอบหมายเลข และติดตามข้อมูลผลรางวัลได้ผ่านเว็บไซต์ โดยควรตรวจสอบความถูกต้องของช่องทางเข้าใช้งาน รวมถึงข้อมูลผู้ให้บริการก่อนทำรายการ
      <strong class="text-[#046c4e]">เพราะคำกล่าวอ้างว่าเป็นเว็บแม่จำเป็นต้องมีหลักฐานที่ตรวจสอบได้</strong>
    </p>
  </ContentBoxHuay>

  <ContentBoxTwoHuay as="h2" title={`${BRAND_NAME} รัฐบาลไทย ลาว ฮานอย หุ้น อัตราจ่ายสูง จ่ายเต็ม โอนไว`}>
    <p slot="left">
      {BRAND_NAME}
      <strong class="text-[#046c4e]">รวบรวมข้อมูลหวยหลายประเภทไว้ในแพลตฟอร์มเดียว</strong>
      ไม่ว่าจะเป็นหวยรัฐบาลไทยที่อ้างอิงผลสลากกินแบ่งรัฐบาล หวยลาว หวยฮานอย และหวยหุ้นที่อ้างอิงดัชนีตลาดหลักทรัพย์
      <strong class="text-[#046c4e]">โดยแต่ละรายการมีรอบปิดรับและเวลาออกผลแตกต่างกัน</strong>
    </p>
    <p slot="right">
      เว็บไซต์ระบุว่ามีอัตราจ่ายสูงและระบบโอนเงินรวดเร็ว อย่างไรก็ตาม
      <strong class="text-[#046c4e]">ควรตรวจสอบตารางอัตราจ่าย วงเงินรับรางวัล และเงื่อนไขการถอนเงินให้ครบถ้วน</strong>
      เพราะความรวดเร็วในการโอนอาจขึ้นอยู่กับสถานะระบบและผู้ให้บริการชำระเงิน
    </p>
  </ContentBoxTwoHuay>

  <LottoGrid />

  <ContentBoxCyberCut as="h2" title={`${BRAND_NAME} การันตี เว็บหวยอัตราจ่ายสูง`}>
    <p>
      {BRAND_NAME} ระบุอัตราจ่ายหวยออนไลน์สำหรับหมายเลข 2 ตัวและ 3 ตัว
      <strong class="text-[#046c4e]">โดยมีข้อมูลอัตราจ่าย 2 ตัว 100 และ 3 ตัว 1,000</strong>
      ซึ่งเป็นรายละเอียดสำคัญสำหรับผู้ที่ต้องการเปรียบเทียบรูปแบบการเดิมพัน
      <strong class="text-[#046c4e]">ก่อนทำรายการควรตรวจสอบว่าอัตราดังกล่าวคำนวณจากเงินเดิมพันจำนวนเท่าใด และใช้กับหวยประเภทใดบ้าง</strong>
      เนื่องจากแต่ละรายการอาจมีข้อกำหนดเกี่ยวกับเลขอั้น วงเงินเดิมพัน และการจ่ายรางวัลแตกต่างกัน
    </p>
  </ContentBoxCyberCut>

  <ContentBoxSevenThreeHuay as="h3" title="หวย 2 ตัว อัตราจ่าย 100">
    <p slot="left">
      หวย 2 ตัว อัตราจ่าย 100 เป็นข้อมูลการจ่ายรางวัลสำหรับการเดิมพันหมายเลขสองหลัก
      <strong class="text-[#046c4e]">โดยผู้ใช้งานควรตรวจสอบว่าใช้กับเลขสองตัวบนหรือสองตัวล่าง รวมถึงฐานเงินเดิมพันที่นำมาคำนวณอัตราจ่าย</strong>
      เพราะหวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยหุ้นอาจมีเงื่อนไขแตกต่างกัน
