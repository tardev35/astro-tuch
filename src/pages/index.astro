---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxTwoFloatingBadge from "../components/ContentBoxTwoFloatingBadge.astro";
import ContentBox3ThreePremium from "../components/ContentBox3ThreePremium.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import Faq from "../components/Faq3.astro";
import LatestWinners from "../components/LatestWinnersPremium.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// VARIANT ROTATION THIS ROUND (LOTTO24 -> WIN999). Zero file reuse from the
// previous round: AnnouncementPremium replaces AnnouncementHuay,
// LatestWinnersPremium replaces LatestWinnersHuay, Faq3 replaces FaqHuay, and
// the ContentBox shape-mix moves to Premium / FloatingBadge / TwoPremium /
// TwoFloatingBadge / 3ThreePremium / SevenThreePremium /
// SevenThreeFloatingBadge plus plain ContentBox (which is pinned live by
// terms/privacy and so never rotates). NavbarPremium and FooterPremium are the
// layout's pair this round (previously NavbarHuay / FooterHuay). Huay, CyberCut,
// Neumorphism and Special are dropped entirely — every one of those files stays
// on disk as inventory for the next brand.
//
// IMAGE ROLES FOR THIS DROP (2026-09-29) — READ BEFORE REUSING THESE IMPORTS.
// Two files are referenced from this page and only two:
//   slide1.png — the poster whose type reads "คืนยอดเสีย" above a large
//     "โบนัส 0.3%", so it belongs to docx H3 #8.
//   slide2.png — the companion poster reading "แนะนำเพื่อน" above "โบนัส 0.8%",
//     so it belongs to docx H3 #9.
// Both slides are 600 px square, so 600 is the top candidate width — nothing
// above it would be a real pixel. Each slide sits in a ContentBoxSevenThree*
// image+text block, which is the family's hard cap of two per rebrand, so there
// is no third SevenThree here. The two blocks put the picture on OPPOSITE
// sides: SevenThreePremium runs image(3fr)-then-text, SevenThreeFloatingBadge
// runs text-then-image(7fr, capped at max-w-md so the 600 px source is never
// upscaled).
//
// The alt text was written from THIS drop's artwork (black grounds shot with
// gold, the WIN999 wordmark in gold WIN plus white 999, the woman in the
// white-and-gold dress, spade cards, a gold crown, black gold-rimmed casino
// chips) and is NOT the previous brand's text — those posters were red and
// black with a chrome LOTTO / red 24 wordmark, red-and-white lottery balls and
// stacks of gold coins, none of which is in these pictures.
//
// Deliberately NOT imported, and all still on disk as inventory:
//   banner2.png (2026-09-28, LOTTO24 artwork), banner3.png (2026-09-27),
//   slide3.png (2026-09-18) and slide4.png (2026-08-13) all predate this drop
//   and carry a previous client's artwork, so there is no inline article
//   illustration this round. banner1.png and banner1-mobile.png belong to
//   MainLayout's own pinned globs and are never referenced from a page — the
//   hero is the LCP element, so nothing here gets loading="eager"
//   fetchpriority="high". og.png is the same: MainLayout owns it.
//
// DROPPED THIS ROUND, and none of the files deleted — every one is inventory
// for the next brand: ProviderGrid / FeaturedGames / PopularGamesStrip /
// GameRankingBoard each have to name specific studios, table names or payout
// figures, and this brief names no ค่ายเกม at all ("เกมอื่นตามค่ายที่ระบบรองรับ"
// is as specific as it gets). BankStrip needs a named bank; the brief says only
// "บัญชีบริษัท". SmoothCarousel is out because it would put slide* outside a
// ContentBoxSevenThree*. FeatureHighlights is out because it emits an <h3> per
// item with its own title, and this round's four <h3> are real docx headings —
// the 3 signup steps have no titles in the brief, only one sentence, so they
// ship as the three <p>-labelled columns of ContentBox3ThreePremium.
//
// Vocabulary: this is a คาสิโนออนไลน์. Nothing on this page may say หวย, แทงหวย,
// เลข 2 ตัว/3 ตัว, อัตราจ่าย 1,000, รอบหวย, ยี่กี, ลาว/ฮานอย, บิล/โพย, ไม่ลดเรท or
// ม้า(เอเย่นต์) — the previous brand on this template was a lottery site and
// every one of those words is wrong now. LoginRtpSection's right-hand column
// was a lottery payout table and is a game-category + account-checks panel this
// round; it states no RTP, no provider, no minimum stake and no bank, because
// the brief names none.
//
// Title and description are the brief's own Title/Description lines, used
// verbatim. A brief-supplied description is never padded up to the 150-char
// floor and never topped up from the H1/H2 — this one ships at the length the
// brief wrote it, which is a passing build (verify-build exempts the home page
// from DESC_MIN for exactly this reason), not a gap to fill.
const pageTitle = "WIN999 เข้าเล่นเกมคาสิโน บัญชีบริษัท ฝากถอนปลอดภัย";

const pageDescription = "WIN999 บริการเกมคาสิโนออนไลน์ เล่นง่ายบนมือถือ ตลอด 24 ชั่วโมง ฝากถอนออโต้ บัญชีบริษัท ปลอดภัยไม่โดนอายัด";

// <Announcement /> runs bare: AnnouncementPremium's default message is already
// this brand's copy, and every sub-page calls it bare too — passing an override
// here is how the ticker ends up saying two different things on two pages.

// The docx has a real H2 -> H3 nesting this round, so the page is NOT flattened
// to H2-only. Four headings are H3 in the brief and stay H3 here: the เว็บปลอม
// sub-point under the mobile-play H2, the สมัครสมาชิกใหม่ sub-point, and the two
// bonus sub-points under the โปรโมชั่น H2, each carried by its own
// ContentBoxSevenThree* block together with the slide whose artwork states that
// exact figure.
// Everything else is chrome and emits no heading tag: LatestWinnersPremium,
// LoginRtpSection and ReviewCardSumo2 render their titles as <p>/<span> with an
// aria-label on the section, and Faq3's questions live inside <summary> as <p>.
//
// The docx checklist, in order, and what carries each one:
//    1 H1  WIN999 เข้าเล่นเกมคาสิโน บัญชีบริษัท ฝากถอนปลอดภัย       ContentBoxPremium
//    2 H2  WIN999 บริการเกมคาสิโนออนไลน์ เล่นง่ายบนมือถือ ...        ContentBoxTwoPremium
//    3 H3  ลดความเสี่ยงจากเว็บปลอม เลือกทางเข้า WIN999 ...           ContentBox (plain)
//    4 H2  ระบบฝากถอนที่ปลอดภัย WIN999 ระบบบัญชีบริษัท ...           ContentBoxFloatingBadge
//    5 H2  หมดปัญหาเรื่องระบบปิดปรับปรุง ทางเข้า WIN999 ล่าสุด ...     ContentBoxTwoFloatingBadge
//    6 H3  แนะนำวิธี WIN999 สมัครสมาชิกใหม่ สะดวก ...                ContentBox3ThreePremium
//    7 H2  โปรโมชั่น WIN999 โบนัสจัดเต็มทุกวัน                      ContentBoxPremium
//    8 H3  คืนยอดเสีย โบนัส 0.3%                                 ContentBoxSevenThreePremium + slide1
//    9 H3  แนะนำเพื่อน โบนัส 0.8%                                ContentBoxSevenThreeFloatingBadge + slide2
//   10 H2  มีปัญหาในการเล่น ติดต่อแอดมิน WIN999 ...                 ContentBox (plain) + ปุ่ม LINE/สมัคร
//   11 H2  คำถามที่พบบ่อยเกี่ยวกับ WIN999                          Faq3
// Final inventory for this page: h1 x1, h2 x6, h3 x4.
//
// Every docx paragraph ships in full. Sections 2, 4, 5 and 10 each have TWO
// paragraphs in the brief and both ship, nothing merged or summarised: in the
// two-column blocks they run one per column, in the single-column blocks they
// stack. Section 6's single paragraph is the one that is split — its lead-in
// goes in the intro slot and the rest runs across the three step columns,
// reproducing the sentence word for word with nothing added.
//
// The non-docx widgets sit before section 1 (LatestWinnersPremium, right after
// the ticker) and after section 11 (LoginRtpSection, ReviewCardSumo2) — never
// spliced between two docx sections.
//
// The brief names only two figures — the 0.3% and 0.8% bonuses — and both
// appear only under the headings that state them. It names no game studio, no
// licence number, no bank, no RTP and no minimum stake, so neither does this
// page.

// One array, used by both <Faq> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last. The three pairs
// are the brief's own Q/A block, verbatim.
const faqs = [
  {
    q: "WIN999 เล่นเกมคาสิโนบนมือถือได้หรือไม่?",
    a: "หากอุปกรณ์และเว็บเบราว์เซอร์รองรับ สมาชิกสามารถ Login ผ่านมือถือเพื่อเลือกเกม ตรวจสอบเครดิต โปรโมชั่น และจัดการบัญชีได้ โดยเกมที่เปิดให้เล่นขึ้นอยู่กับค่ายที่ระบบรองรับในขณะนั้น",
  },
  {
    q: "โปรโมชั่น WIN999 โบนัส 0.3% และ 0.8% ต่างกันอย่างไร?",
    a: "โบนัส 0.3% เป็นโปรโมชั่นคืนยอดเสียจากยอดที่เข้าเงื่อนไข ส่วน 0.8% เป็นโบนัสแนะนำเพื่อนตามยอดที่เว็บไซต์กำหนด ควรตรวจสอบรอบคำนวณและเงื่อนไขก่อนรับทุกครั้ง",
  },
  {
    q: "จะตรวจสอบบัญชีบริษัท WIN999 ก่อนฝากเงินอย่างไร?",
    a: "ควรเปรียบเทียบชื่อบัญชีปลายทางกับชื่อนิติบุคคลหรือข้อมูลบริษัทที่เว็บไซต์เปิดเผย หากชื่อไม่ตรง มีการเปลี่ยนบัญชีผิดปกติ หรือไม่สามารถตรวจสอบที่มาได้ ควรหยุดทำรายการและติดต่อช่องทางหลักเพื่อยืนยันข้อมูลก่อนโอนเงิน",
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// One highlight colour only: near-white #fffbea against the body colour
// #e9e4d6, so the brand's gold stays the page's structural accent and the
// paragraphs never compete with a heading for it.

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb. Every URL in the graph is derived
// by pageGraph from `site:` — no domain is typed out in this file, and no
// Review / AggregateRating / sameAs / address node is passed.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <LatestWinners />

  <ContentBoxPremium as="h1" title="WIN999 เข้าเล่นเกมคาสิโน บัญชีบริษัท ฝากถอนปลอดภัย">
    <p class="text-left text-base leading-relaxed text-[#e9e4d6]">
      WIN999
      <strong class="text-[#fffbea]">ให้บริการเกมคาสิโนออนไลน์ผ่านระบบเว็บไซต์</strong>
      รองรับการใช้งานบนมือถือ แท็บเล็ต และคอมพิวเตอร์ สมาชิกสามารถเลือกเกม ตรวจสอบเครดิต โปรโมชั่น และจัดการฝากถอนผ่านบัญชีเดียวได้ตลอดช่วงเวลาที่ระบบเปิดให้บริการ พร้อมช่องทางช่วยเหลือจากแอดมินตลอด 24 ชั่วโมง สำหรับข้อมูลเรื่องบัญชีบริษัทและความปลอดภัย
      <strong class="text-[#fffbea]">ควรตรวจสอบชื่อบัญชีและรายละเอียดผู้ให้บริการจากหน้าเว็บไซต์ก่อนทำธุรกรรมทุกครั้ง</strong>
    </p>
  </ContentBoxPremium>

  <ContentBoxTwoPremium
    as="h2"
    title="WIN999 บริการเกมคาสิโนออนไลน์ เล่นง่ายบนมือถือ เล่นได้ตลอด 24 ชั่วโมง"
    titleleft="หมวดเกมในระบบเดียว"
    titleright="สถานะการให้บริการ">
    <p slot="left" class="text-left text-base leading-relaxed text-[#e9e4d6]">
      WIN999
      <strong class="text-[#fffbea]">รวมเกมคาสิโนออนไลน์หลายรูปแบบไว้สำหรับสมาชิกที่ต้องการเข้าเล่นผ่านมือถือ</strong>
      มีทั้งบาคาร่า สล็อต เกมไพ่ และเกมอื่นตามค่ายที่ระบบรองรับ สามารถ Login ผ่านเว็บเบราว์เซอร์และเลือกหมวดเดิมพันจากบัญชีเดียวได้ ช่วยลดขั้นตอนในการสลับเว็บไซต์ พร้อมตรวจสอบเครดิต ประวัติรายการ
      <strong class="text-[#fffbea]">และรายละเอียดเกมก่อนเริ่มเดิมพันได้ด้วยตัวเอง</strong>
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#e9e4d6]">
      การเปิดให้บริการตลอด 24 ชั่วโมงขึ้นอยู่กับสถานะของเว็บไซต์และผู้ให้บริการเกม หากบางค่ายมีการปิดปรับปรุง
      <strong class="text-[#fffbea]">สมาชิกอาจไม่สามารถเข้าเกมดังกล่าวได้เป็นการชั่วคราว</strong>
    </p>
  </ContentBoxTwoPremium>

  <ContentBox as="h3" title="ลดความเสี่ยงจากเว็บปลอม เลือกทางเข้า WIN999 ที่ตรวจสอบแหล่งที่มาได้">
    <p class="text-left text-base leading-relaxed text-[#e9e4d6]">
      ก่อน Login หรือฝากเงินควรตรวจสอบว่าเป็นทางเข้า WIN999
      <strong class="text-[#fffbea]">ที่เว็บไซต์ประกาศไว้จริง</strong>
      โดยเฉพาะชื่อโดเมน ช่องทางติดต่อ และข้อมูลบัญชีปลายทาง ไม่ควรใช้ข้อความ “เว็บตรง”, “ไม่ผ่านเอเย่นต์” หรือ “มาตรฐานสากล” เป็นหลักฐานเพียงอย่างเดียว หากเว็บไซต์มีข้อมูลบริษัท ใบอนุญาต หรือผู้ให้บริการที่ตรวจสอบได้
      <strong class="text-[#fffbea]">ควรแสดงรายละเอียดเหล่านั้นให้สมาชิกตรวจสอบได้โดยตรง</strong>
    </p>
  </ContentBox>

  <ContentBoxFloatingBadge as="h2" title="ระบบฝากถอนที่ปลอดภัย WIN999 ระบบบัญชีบริษัท ไม่เสี่ยงโดนอายัด">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed text-[#e9e4d6]">
        ระบบฝากถอน WIN999
        <strong class="text-[#fffbea]">ช่วยให้สมาชิกทำรายการและติดตามสถานะเครดิตผ่านบัญชีของตนเอง</strong>
        ก่อนฝากเงินควรตรวจสอบชื่อบัญชี จำนวนเงิน และข้อมูลปลายทางให้ตรงกับรายละเอียดที่เว็บไซต์แสดง
        <strong class="text-[#fffbea]">ส่วนรายการถอนควรตรวจสอบสถานะผ่านระบบและเก็บหลักฐานธุรกรรมไว้จนกว่าจะดำเนินการเสร็จสมบูรณ์</strong>
      </p>
      <p class="text-left text-base leading-relaxed text-[#e9e4d6]">
        หากระบุว่าเป็น “บัญชีบริษัท”
        <strong class="text-[#fffbea]">ควรมีชื่อนิติบุคคลที่ตรวจสอบได้</strong>
        ส่วนข้อความ “ไม่เสี่ยงโดนอายัด” ไม่สามารถรับประกันได้จากประเภทบัญชีเพียงอย่างเดียว เพราะบัญชีธนาคารอาจถูกจำกัดหรือระงับได้จากหลายสาเหตุ
        <strong class="text-[#fffbea]">จึงควรใช้ข้อมูลที่ตรวจสอบได้จริงประกอบการตัดสินใจทำธุรกรรม</strong>
      </p>
    </div>
  </ContentBoxFloatingBadge>

  <ContentBoxTwoFloatingBadge
    as="h2"
    title="หมดปัญหาเรื่องระบบปิดปรับปรุง ทางเข้า WIN999 ล่าสุด เล่นได้ตลอด 24 ชั่วโมง"
    titleleft="บันทึกทางเข้าล่าสุด"
    titleright="ช่วงบำรุงรักษาระบบ">
    <p slot="left" class="text-left text-base leading-relaxed text-[#e9e4d6]">
      สมาชิกควรบันทึกทางเข้า WIN999
      <strong class="text-[#fffbea]">ล่าสุดจากช่องทางหลักของเว็บไซต์</strong>
      เพื่อใช้ Login เมื่อต้องการเข้าเกม ตรวจสอบโปรโมชั่น หรือจัดการบัญชี หากลิงก์เดิมไม่สามารถใช้งานได้ ควรตรวจสอบประกาศล่าสุดหรือติดต่อแอดมินก่อนกรอกข้อมูลผ่านลิงก์อื่น
      <strong class="text-[#fffbea]">เพื่อช่วยลดความเสี่ยงจากหน้าเว็บไซต์ที่ไม่เกี่ยวข้อง</strong>
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#e9e4d6]">
      แม้เว็บไซต์จะเปิดระบบตลอด 24 ชั่วโมง แต่บางช่วงอาจมีการบำรุงรักษาระบบ ธนาคาร หรือค่ายเกม
      <strong class="text-[#fffbea]">จึงไม่ควรรับประกันว่าจะไม่มีการปิดปรับปรุงเลย</strong>
      หากมีสถานะขัดข้องควรแจ้งข้อมูลให้สมาชิกทราบอย่างชัดเจน
    </p>
  </ContentBoxTwoFloatingBadge>

  <ContentBox3ThreePremium
    as="h3"
    title="แนะนำวิธี WIN999 สมัครสมาชิกใหม่ สะดวก ทำได้ด้วยตัวเอง"
    titleleft="ขั้นตอนที่ 1"
    titlecenter="ขั้นตอนที่ 2"
    titleright="ขั้นตอนที่ 3">
    <p class="text-left text-base leading-relaxed text-[#e9e4d6]">
      การสมัคร WIN999
      <strong class="text-[#fffbea]">สามารถแบ่งเป็น 3 ขั้นตอน</strong>
    </p>
