---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import LatestWinners from "../components/LatestWinners3.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import Faq from "../components/Faq2.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import { pageGraph } from "../lib/schema";
import imgCashback from "../assets/slide1.png";
import imgReferral from "../assets/slide2.png";

// VARIANT ROTATION THIS ROUND (KOON234 -> PIGPG), per brand-spec §3. Zero file
// reuse from the previous round: AnnouncementCyber replaces Announcement3,
// LatestWinners3 replaces LatestWinners2, Faq2 replaces Faq4, ReviewCardSumo
// replaces ReviewCardSumo2, and the ContentBox shape-mix moves off Premium /
// Neumorphism / SevenThreePremium / SevenThreeNeumorphism / TwoPremium /
// TwoNeumorphism onto CyberCut / FloatingBadge / SevenThreeCyberCut /
// SevenThreeFloatingBadge / TwoCyberCut / Special.
// NavbarStyle9 and FooterStyle2 are the layout's pair this round (previously
// NavbarStyle8 / FooterPremium) and the brand font moves google-sans -> kanit;
// all three are the orchestrator's shared-chrome step, not this page's.
// Plain ContentBox is the one deliberate carry-over: it is the always-live box
// that terms, privacy, 404 and the button pages render through, so it cannot
// follow a rotation. Section 3 is the single docx section it carries here.
// Every unused *Premium / *Neumorphism / *Huay / Style file, Faq4,
// ReviewCardSumo2, LatestWinners2 and Announcement3 stay on disk as inventory
// for the next brand — none of them was deleted, and KOON234's copy and colour
// still inside them is expected drift, not a bug.
//
// <Announcement /> runs bare on purpose: AnnouncementCyber's default message is
// already this brand's copy, written from this brief, and every sub-page calls
// it bare too — so passing an override here is exactly how the ticker ends up
// saying two different things on two pages of the same site.
//
// PALETTE OF THIS BRAND (brand-spec §2). PIGPG is a Chinese-New-Year prosperity
// brand and a genuine TWO-COLOUR pair — lacquer red #d4200d / #a30303 leads and
// metallic gold #f5b61d is the second real hue — over the logo's own ivory cream
// #fdf9e4. This round is a full flip off KOON234's emerald-and-gold set
// (#0a6b32 #2fbf6a #043d1c #cc920a #f7d14e #fde9a6 #8a6204 #0d2414 #09190d
// #051007 #020803 #e8f2e6 #07170c and every rgba(204,146,10,α) /
// rgba(247,209,78,α) / rgba(10,107,50,α) glow), off แตกดี168's sky-and-lemon set
// before it, and off 789BETTING's single-hue metallic gold before that. None of
// those survives on this page or in any component it renders — and gold is the
// trap: "there is already gold here" does not mean it is THIS brand's gold.
// logo.webp is a cartoon pig's head in a red Chinese cap with a gold coin and
// finial, gold coins and ingots fanned behind it, over a red lacquer plaque with
// a thick gold border carrying PIGPG in ivory-cream 3-D letters and a red
// diamond gem beneath. bg.json this drop is
// {"mode":"gradient","css":"linear-gradient(180deg, #6b0000, #7a4100)"} — a deep
// maroon-to-dark-amber page surface, so for the first time in several rounds the
// page is LIGHTER than the cards: the depth ladder below (#3a0d07 raised /
// #2a0806 mid / #1c0503 deep / #120302 deepest) makes every card sink into the
// page rather than lift off it, which is what lets gold read as metal on top.
// Body copy is #fdeedd (= BRAND_TEXT), 14.8:1 on the raised surface.
// Highlights below are #ffd24a, which §2 pins to exactly this one job — unlike
// #ffd87a and #fdf9e4 which it pins to hover text and gradient ends, and unlike
// #d4200d, #6b0402 and #b07a06, which never carry text at all (red bright is
// only 3.5:1 on a card) and appear here only as border, plaque and shadow
// colours.
//
// IMAGE ROLES FOR THIS DROP (2026-10-09 14:11, brand-spec §4). Two files are
// referenced from this page and only two, and each pairing is read off the
// artwork itself:
//   slide1.png — square 600x600: the PIGPG logo top left, a tiger cub with a red
//     福 envelope, a mouse with a gold ingot and a red-capped pig laughing down
//     the left side, the silver-haired woman in a red-and-gold cheongsam holding
//     a gold ingot on the right, and across the bottom โปรโมชั่น in large gold
//     3-D type on a red cloud plaque with คืนยอดเสีย and an oversized gold 0.3%
//     under it. The artwork prints the heading itself, so it belongs to docx
//     H3 #4. Imported as imgCashback.
//   slide2.png — the companion, same square set: the logo top left, a tiger cub
//     with a 福 envelope and a red-capped pig at left, the same woman at right
//     with a gold ingot and a 777 slot machine behind her, gold coins and a red
//     gift box, and across the bottom โปรโมชั่น in gold 3-D type on a red plaque
//     with แนะนำเพื่อน โบนัส and an oversized gold 0.8% under it. It belongs to
//     docx H3 #5. Imported as imgReferral.
// Both slides are 600x600 on disk, so 600 is the top real candidate — nothing
// above it would be a real pixel — and each picture carries max-w-[600px] so the
// art is never upscaled past its own bitmap.
// Each slide sits in a ContentBoxSevenThree* image+text block, which is that
// family's hard cap of two per rebrand, so there is no third SevenThree anywhere
// on the site and no slide appears outside those two blocks.
// The two blocks mirror each other: ContentBoxSevenThreeCyberCut lays out
// md:grid-cols-[3fr_7fr] so its picture goes in slot="left" while the paragraph
// keeps the wide column, and ContentBoxSevenThreeFloatingBadge lays out
// md:grid-cols-[7fr_3fr] so its picture goes in slot="right". The two pictures
// therefore alternate sides instead of stacking down the same edge, and each
// `sizes` describes its own 3fr column rather than the viewport. Tailwind sets
// box-sizing: border-box globally, so every max-w-* below caps the box INCLUDING
// its padding and border. Both figures are recomputed from the component that
// owns the column — if a padding/gap/border/cap changes there, these move with it:
//   ContentBoxSevenThreeCyberCut: cap on the SECTION (max-w-7xl/1280 + px-4), so
//     the card is min(100vw,1280) - 32 and the cap is reached at 100vw >= 1280.
//     border(1x2=2) + p-8(64) + gap-8(32) -> 1150 of column space at the cap.
//     The 3fr image column has no padding of its own (md:border-l + md:pl-8 are
//     on the TEXT column).
//       >= 1280px : 1150 x 0.3                        = 345px
//       md..1279  : (100vw - 130) x 0.3               = calc(30vw - 39px)
//       < md      : one column at p-8                 = calc(100vw - 98px)
//   ContentBoxSevenThreeFloatingBadge: cap on the CARD (max-w-7xl/1280) inside a
//     px-4 section, border-2(4) + p-8(64) + gap-10(40) -> 1140, and the image
//     column here DOES add md:border-l(1) + md:pl-10(40) = 41 of its own.
//       >= 1280px : 1140 x 0.3 - 41                   = 342 - 41 = 301px
//       md..1279  : (100vw - 140) x 0.3 - 41          = calc(30vw - 83px)
//       < md      : one column at p-8                 = calc(100vw - 100px)
// Neither is the LCP element — MainLayout's hero banner is — so both are
// loading="lazy" fetchpriority="low" decoding="async" and neither takes
// fetchpriority="high".
//
// The alt text was written from THIS drop's artwork per brand-spec §4, read off
// the files rather than carried over: the set is a deep-red Chinese-New-Year
// scene of gold coins, gold ingots, red lanterns and 福 envelopes with a capped
// cartoon pig, not KOON234's emerald lounge with gold ribbons and not แตกดี168's
// bright sky-blue kawaii set — there is no green curtain, no blue sky, no white
// cloud and no chrome lettering on either file, and the logo is a pig's head
// over a red plaque rather than the word KOON beside the numerals 234.
//
// Deliberately NOT imported, and every file still on disk:
//   banner2.png (10-08) is แตกดี168's blue/yellow "รีวิวถอนจริง" strip,
//   banner3.png (09-27) is the PGW44 logo, and slide3.png / slide4.png (09-29)
//   are LOTTOPLUS lottery promos — all previous brands' artwork. Importing any
//   of them emits a competitor's picture into dist/ (an eager import IS an emit,
//   rendered or not) and turns verify-build red. There is therefore NO
//   current-drop article illustration this round, and a slide is not substituted
//   for one.
//   banner1.png and banner1-mobile.png belong to MainLayout's own pinned globs
//   and are never referenced from a page. og.png is the same: MainLayout owns it.
// Also deliberately unused (named without the file extension on purpose — the
// playbook's "is this component live?" check is a bare-filename grep, and a
// mention here would read as a render): FeatureHighlights renders sub-points as
// <h3>, and this brief already spends both of its allowed H3s on sections 4 and
// 5, so wiring it in would break the count; ProviderGrid, GameRankingBoard and
// SmoothCarousel have no brief section asking for a provider wall, a ranking
// board or a carousel this round (the brief names no studio, so a provider wall
// would have to invent one); BankStrip already renders inside the active footer;
// and the three-column ContentBox3Three family has nothing to carry — every
// section in this brief is one or two running paragraphs, not a three-way split.
//
// Vocabulary (brand-spec §6): PIGPG is a ฐานเข้าเล่นสล็อตเว็บหลัก /
// ศูนย์รวมเกมสล็อตค่ายแท้ — a slot site and nothing else. The words this page may
// use are the brief's own: เกมสล็อต, ศูนย์รวมเกมสล็อตค่ายแท้, ไม่ผ่านเว็บตัวแทน,
// สล็อตคลาสสิก, เกมโบนัส, ฟรีสปิน, ตัวคูณ, เกมใหม่, ค่าย/ผู้ให้บริการ, เครดิต,
// ประวัติรายการ, บัญชีสมาชิก, ถอนยอด 24 ชั่วโมง, ยอดขั้นต่ำ, เงื่อนไขการถอน,
// สถานะรายการ, คืนยอดเสีย 0.3%, เข้ายูส, รอบตัดยอด, ยอดที่เข้าเกณฑ์,
// แนะนำเพื่อน 0.8%, แชร์ลิงก์, สมัคร 3 ขั้นตอน, ยืนยันบัญชี, แอดมิน 24 ชั่วโมง,
// PIN, OTP, หลักฐานธุรกรรม, ช่องทางหลัก, เว็บไซต์เลียนแบบ.
// KOON234's vocabulary is banned and gone (คาสิโนฐานเข้าหลัก, เว็บพนันฐานเล่นหลัก,
// ทางเข้าเล่นออนไลน์, ไม่ผ่านเอเย่นต์, อัปเกรดระบบ, การเข้ารหัสข้อมูล,
// การจัดการสิทธิ์เข้าถึง, แจ้งเตือนรายการผิดปกติ, ปลอดภัยขึ้น 100%), as is every
// older brand's (การันตีเว็บแท้, รีวิวถอนจริง, ไม่มีขั้นต่ำ, ถูกลิขสิทธิ์, บาคาร่า,
// รูเล็ต, ไฮโล, โต๊ะสด, คาสิโนไลฟ์, บอล, กีฬา, ตลาดเดิมพัน, หวย, นิติบุคคล, เบทต่ำ,
// ทุนน้อย, ค่ายตรง, ไฮคลาส, VIP, ส่งตรงจากเว็บแม่, ไม่ผ่านบัญชีม้า) — the page is
// written straight from the brief rather than find-and-replaced over the old
// sentences, and four of those banned phrases were in the page this replaces.
// There is NO หวย anywhere on this site this round: it is a slot brand, the word
// appears nowhere, and /ตรวจหวย and /แนวทาง stay parked in src/pages-disabled/.
// Nothing here claims a licence, a regulator, an operator, a studio, a bank, an
// RTP figure, a deposit minimum, a member count or a founding year, because the
// brief names none. The only figures are the brief's own: 0.3%, 0.8%,
// 3 ขั้นตอน and 24 ชั่วโมง.
// The brief's own hedging ships with the copy — it states it four separate times
// (ควรมีข้อมูลผู้ให้บริการและรายชื่อค่ายเกมที่ตรวจสอบได้ · ระยะเวลาที่เงินเข้าบัญชี
// อาจแตกต่างกัน · ควรอ่านรายละเอียดก่อนรับสิทธิ์ · คำว่าไม่จำกัดควรตรวจสอบ
// รายละเอียด) and it is part of the paragraphs, not trimmed as downbeat filler.
//
// The brief says PIGPG throughout and so does every piece of artwork in the drop
// and the operator's prompt — no conflict this round. Even so the brand name is
// never typed on the page: it is interpolated from ${BRAND_NAME} so it can never
// drift from brandProfile. No domain is written out anywhere in this file.
//
// Title and description are the brief's own Title/Description lines (minus that
// substitution), used verbatim and NOT padded up to 150: verify-build
// deliberately skips its 150-character floor on the home page for exactly this
// reason.
const pageTitle = `${BRAND_NAME} ฐานเข้าเล่นสล็อตเว็บหลัก เปิดให้เล่นพร้อมถอนได้ 24 ชั่วโมง`;

const pageDescription = `${BRAND_NAME} ฐานเข้าเล่นสล็อตเว็บหลัก ศูนย์รวมเกมสล็อตค่ายแท้ ไม่ผ่านเว็บตัวแทนข่าย เปิดระบบให้เล่นเกมพร้อมถอนยอดได้ 24 ชั่วโมง`;

// The brief has a real H2 -> H3 nesting this round, so the page is NOT flattened
// to H2-only. The two H3s are genuine headings — the two bonus sub-points, both
// nested under section 3's โปรโมชั่น H2 — and they stay H3.
//
// The checklist, in document order, and what carries each one:
//    1 H1  PIGPG ฐานเข้าเล่นสล็อตเว็บหลัก ศูนย์รวมเกมสล็อตค่ายแท้ ไม่ผ่านเว็บตัวแทนข่าย
//          ContentBoxCyberCut, brief paragraph on line 4
//    2 H2  PIGPG เปิดระบบให้เล่นเกมสล็อต พร้อมถอนยอดได้ 24 ชั่วโมง
//          ContentBoxFloatingBadge, lines 6 + 7 in one wrapping <div>
//    3 H2  โปรโมชั่นเล่นสล็อต PIGPG เครือหลัก จัดให้เต็มสูบ
//          ContentBox (the plain, always-live variant), line 9
//    4 H3  โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสทุกวัน
//          ContentBoxSevenThreeCyberCut + slide1 (imgCashback), line 11
//    5 H3  โปรโมชั่น แนะนำเพื่อน รับโบนัสแชร์ลิงก์ 0.8% ไม่จำกัด
//          ContentBoxSevenThreeFloatingBadge + slide2 (imgReferral), line 13
//    6 H2  ช่องทางสมัคร PIGPG ง่ายๆ 3 ขั้นตอน
//          ContentBoxTwoCyberCut, line 15 left / line 16 right
//    7 H2  แอดมิน PIGPG ฐานเว็บหลัก เปิดให้บริการ 24 ชั่วโมง
//          ContentBoxSpecial, line 18 left / line 19 right
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ PIGPG
//          Faq2 + faqs prop, lines 21-26
// Final inventory for this page: h1 x1, h2 x5, h3 x2.
//
// Shape rhythm, top to bottom: clipped-corner slab with a gold rail beside the
// heading -> rounded card wearing a floating RED LACQUER plaque with a thick
// gold border and ivory-cream letters (the logo's own shape) -> rounded glass
// card with an underline rule -> 3:7 clipped card with the picture on the LEFT
// -> 7:3 rounded card wearing a floating GOLD plate with dark ink and the
// picture on the RIGHT -> two-column clipped card with coloured column dots ->
// two half-cards with opposite-polarity icon plates -> clipped-corner accordion.
// No shape repeats back to back; the three clipped-corner cards are separated by
// surface depth (#3a0d07 raised / #2a0806 mid / #1c0503 deep) rather than by
// heading colour alone, the two floating badges are deliberate inverses of each
// other (cream-on-red vs dark-on-gold), and every card's heading gradient runs a
// different order of the same three light hues, so no two cards read as the same
// card twice.
//
// ContentBoxSevenThreeCyberCut takes the docx heading through `title`, which
// falls back to its wide (7fr) RIGHT text column; its image column is passed no
// `titleleft`, so the block emits exactly one heading.
// ContentBoxSevenThreeFloatingBadge puts its single heading in the floating
// badge and is passed neither `titleleft` nor `titleright`, so its picture
// column carries none either.
//
// Every brief paragraph ships in full — all eleven of them, nothing merged or
// summarised. Sections 2, 6 and 7 have two paragraphs each; section 2 runs both
// down one column inside one <div>, while 6 and 7 run one per column. Sections
// 1, 3, 4 and 5 have one paragraph each. The column labels passed to
// ContentBoxTwoCyberCut are this page's own layout wording, not brief headings,
// and that variant renders them as <p>. ContentBoxSpecial takes no column
// labels at all — only the two emoji icon plates, both aria-hidden.
//
// Everything else on the page is chrome and emits no heading tag at any level:
// AnnouncementCyber, LatestWinners3, LoginRtpSection and ReviewCardSumo render
// their titles as <p>/<span> with an aria-label on the section, and Faq2's
// questions live inside <summary> as <span>. The non-brief widgets sit before
// section 1 (the ticker, then the winners feed) and after section 8
// (LoginRtpSection, ReviewCardSumo, Navfoot) — never spliced between two content
// sections.

// One array, used by both <Faq> and the FAQPage node — never the component's own
// defaults (Faq2 deliberately ships none, so a forgotten prop renders an empty
// accordion rather than some previous brand's questions). The three pairs are
// the brief's own Q/A block (content.txt lines 21-26), verbatim.
const faqs = [
  {
    q: `${BRAND_NAME} มีเกมสล็อตจากค่ายหลักให้เลือกอะไรบ้าง?`,
    a: `${BRAND_NAME} รวบรวมเกมสล็อตตามรายชื่อค่ายที่ระบบเปิดให้บริการ มีทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน และเกมที่มีฟีเจอร์ตัวคูณ สมาชิกสามารถเลือกดูเกมจากหมวดหมู่ภายในเว็บไซต์ โดยจำนวนค่ายและเกมอาจมีการเปลี่ยนแปลงตามช่วงเวลา`,
  },
  {
    q: `${BRAND_NAME} สามารถถอนเงินได้ตลอด 24 ชั่วโมงจริงหรือไม่?`,
    a: `หากระบบเปิดรับคำขอถอนเงินตลอด 24 ชั่วโมง สมาชิกสามารถส่งรายการได้ตามช่องทางที่รองรับ แต่ระยะเวลาที่เงินเข้าบัญชีขึ้นอยู่กับการตรวจสอบและระบบชำระเงิน ควรตรวจสอบเงื่อนไขการถอนและสถานะรายการจากบัญชีสมาชิกทุกครั้ง`,
  },
  {
    q: `โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ต่างกันอย่างไร?`,
    a: `โบนัส 0.3% เป็นโปรโมชั่นคืนยอดเสียจากยอดที่เข้าเงื่อนไขตามรอบที่กำหนด ส่วนโบนัส 0.8% เป็นกิจกรรมแนะนำเพื่อน โดยคำนวณจากยอดของเพื่อนที่เข้าเกณฑ์ ทั้งสองรายการมีวิธีคำนวณและเงื่อนไขรับสิทธิ์แตกต่างกัน ควรตรวจสอบรายละเอียดล่าสุดก่อนรับโบนัส`,
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// One highlight colour only: #ffd24a, against the inherited body colour #fdeedd
// (BRAND_TEXT). The paragraphs below carry no colour class of their own: every
// ContentBox* card in this mix already sets
// `text-left text-base leading-relaxed text-[#fdeedd]` on the element holding
// the slot, so the prose inherits it and no page-level override can drift from
// the card. No paragraph carries mx-auto or max-w-* either — the cards cap their
// own width, and the only max-w-* on the page is the one capping each slide,
// which is an image and not prose. One element per slot, everywhere: section 2
// passes a single <div> wrapping its two paragraphs.

// No breadcrumb: this is the homepage, so a trail from the root to itself would
// be a single self-referential crumb. Every URL in the graph is derived by
// pageGraph from `site:` — no domain is typed out in this file, no URL is built
// with `+`, and no Review / AggregateRating / sameAs / address / email node is
// passed. `description` is the exact same string MainLayout gets.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <LatestWinners />

  <ContentBoxCyberCut as="h1" title={`${BRAND_NAME} ฐานเข้าเล่นสล็อตเว็บหลัก ศูนย์รวมเกมสล็อตค่ายแท้ ไม่ผ่านเว็บตัวแทนข่าย`}>
    <p>
      {BRAND_NAME}
      <strong class="text-[#ffd24a]">ฐานเข้าเล่นสล็อตเว็บหลักที่รวบรวมเกมสล็อตหลากหลายรูปแบบไว้ในระบบเดียว</strong>
