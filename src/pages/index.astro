---
import MainLayout from "../layouts/MainLayout.astro";
import AnnouncementPremium from "../components/AnnouncementPremium.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBox from "../components/ContentBox.astro";
import ProviderGridPremium from "../components/ProviderGridPremium.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import Faq2 from "../components/Faq2.astro";
import LatestWinners4 from "../components/LatestWinners4.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// Title and description are the brief's own Title/Description lines, verbatim.
// A docx-supplied description ships at whatever length it was written — it is
// not padded up to the 150-character floor.
const pageTitle = "UFA99 เว็บรวมคาสิโนสล็อต ได้มาตรฐาน โบนัสสูง การันตีเว็บแท้ ปลอดภัย";

const pageDescription = "UFA99 เว็บคาสิโนสล็อต ค่ายเกมแท้ มาตรฐานเอเชีย โปรโมชั่นดี โบนัสสูง เดิมพันออนไลน์ได้ 24 ชั่วโมง เว็บตรงมาตรฐาน ปลอดภัย เชื่อถือได้";

// The ticker copy is passed explicitly rather than relying on the component's
// default — every Announcement* variant's default belongs to whichever brand
// wired it in last.
const announcement =
  "UFA99 เว็บรวมคาสิโนสล็อต ค่ายเกมแท้ มาตรฐานเอเชีย รวมสล็อต บาคาร่า รูเล็ต เสือมังกร แบล็กแจ็ก และคาสิโนสดไว้ในบัญชีเดียว • โบนัสแนะนำเพื่อน 0.8% แชร์ลิงก์แนะนำของตนเองแล้วติดตามสิทธิ์ได้ในบัญชีสมาชิก • โปรโมชั่นคืนยอดเสีย 0.3% คำนวณตามยอดและประเภทเกมที่เข้าเงื่อนไข • ระบบฝากถอนอัตโนมัติ พร้อมทีมงาน UFA99 ดูแลตลอด 24 ชั่วโมง";

// The brief's "เริ่มต้นใช้งาน UFA99 ... ได้ง่ายเพียง 3 ขั้นตอน" sub-points. Each
// title is the brief's line verbatim, because FeatureHighlights renders them as
// the only <h3> tier on the page and a heading may only carry docx text.
const steps = [
  {
    icon: "📝",
    title: "สมัครสมาชิกผ่านหน้าเว็บไซต์และกรอกข้อมูลที่ระบบกำหนด",
    accent: "gold" as const,
  },
  {
    icon: "💳",
    title: "Login เข้าสู่บัญชีและฝากเครดิตผ่านระบบฝากถอนอัตโนมัติ",
    accent: "silver" as const,
  },
  {
    icon: "🎯",
    title: "เลือกหมวดหมู่เกม ศึกษากติกาและรายละเอียดก่อนเริ่มเดิมพัน",
    accent: "gold" as const,
  },
];

// One array, used by both <Faq2> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last.
const faqs = [
  {
    q: "UFA99 มีเกมคาสิโนและสล็อตอะไรให้เล่นบ้าง?",
    a: "ระบบมีเกมหลายหมวดหมู่ เช่น สล็อตออนไลน์ บาคาร่า คาสิโนสด รูเล็ต เสือมังกร แบล็กแจ็ก และเกมเดิมพันอื่น ๆ โดยรายการเกมที่เปิดให้บริการสามารถตรวจสอบได้จากหน้าเกมภายในบัญชีสมาชิก",
  },
  {
    q: "โบนัสแนะนำเพื่อนและคืนยอดเสียของ UFA99 รับอย่างไร?",
    a: "สมาชิกสามารถตรวจสอบโปรโมชั่นที่เปิดให้รับผ่านหน้าเว็บไซต์ โดยโบนัสแนะนำเพื่อนและคืนยอดเสียจะคำนวณตามเงื่อนไขของแต่ละรายการ ควรตรวจสอบเปอร์เซ็นต์ รอบคำนวณ และข้อกำหนดการถอนก่อนกดรับโบนัส",
  },
  {
    q: "หากฝากถอน UFA99 ไม่สำเร็จต้องทำอย่างไร?",
    a: "ตรวจสอบสถานะธุรกรรมและข้อมูลบัญชีที่ใช้ทำรายการก่อน หากเครดิตยังไม่เข้าหรือรายการถอนยังค้าง สามารถติดต่อทีมงาน UFA99 พร้อมแจ้งรายละเอียดและเวลาที่ทำรายการ เพื่อให้เจ้าหน้าที่ช่วยตรวจสอบได้ตลอด 24 ชั่วโมง",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <AnnouncementPremium message={announcement} />

  <SmoothCarousel />

  <ContentBoxNeumorphism as="h1" title="UFA99 เว็บพนันสล็อต รวมเกมเดิมพันออนไลน์ครบวงจร">
    <p class="text-left text-base leading-relaxed text-[#ece0c8]">
      <strong class="text-[#fce48c]">UFA99</strong> พร้อมให้บริการสมาชิกที่ต้องการเล่นคาสิโนและเกมสล็อตออนไลน์ผ่านระบบเดียว รองรับการใช้งานทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์ มีเกมเดิมพันหลายหมวดหมู่ให้เลือก
      พร้อมโปรโมชั่นสำหรับสมาชิก ระบบฝากถอนอัตโนมัติ และบริการช่วยเหลือตลอด 24 ชั่วโมง เพื่อให้การสมัคร เข้าสู่ระบบ ฝากถอน และเลือกเกมทำได้อย่างสะดวกในทุกช่วงเวลา
    </p>
  </ContentBoxNeumorphism>

  <ContentBox as="h2" title="แหล่งเดิมพัน UFA99 คาสิโนเกมพนัน ค่ายแท้ มาตรฐานเอเชีย">
    <p class="text-left text-base leading-relaxed text-[#ece0c8]">
      UFA99 รวบรวมเกมคาสิโนและเกมสล็อตจากหลากหลายค่ายไว้ในบัญชีเดียว มีทั้งสล็อต บาคาร่า รูเล็ต เสือมังกร แบล็กแจ็ก คาสิโนสด และเกมเดิมพันประเภทอื่น ๆ ระบบจัดหมวดหมู่ให้ค้นหาเกมได้ง่าย
      พร้อมรองรับการเล่นผ่านเว็บเบราว์เซอร์บนทุกอุปกรณ์ ก่อนเดิมพันสมาชิกสามารถตรวจสอบกติกา รายละเอียด และเงื่อนไขของเกมที่สนใจได้จากระบบ
    </p>
  </ContentBox>

  <ProviderGridPremium />

  <ContentBoxSevenThree titleright="โปรโมชั่นดี UFA99 ค่าแนะนำสูง ยอดเสียมีคืนทุกวัน">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นพื้นหลังสีดำลายวงจรสีทอง ด้านบนเป็นโลโก้ UFA99 พร้อมคำว่า SPORT BETTING AND CASINO ONLINE ถัดลงมาเป็นข้อความ โปรโมชั่น คืนยอดเสีย รับโบนัส พร้อมตัวเลข 0.3% ขนาดใหญ่สีทอง หญิงสาวสวมชุดจีนสีแดงดำยืนแบมือทางขวาของภาพ มุมซ้ายมีไพ่เอซสองใบและชิปคาสิโนสีทองสลักคำว่า UFA99 แถบด้านล่างเขียนว่า มั่นคง ปลอดภัย เชื่อถือได้ 100% ฝาก-ถอน รวดเร็ว ระบบอัตโนมัติ และ บริการตลอด 24 ชม."
      class="mx-auto h-auto w-full rounded-2xl border border-[#ebc36b]/45 shadow-[0_10px_30px_rgba(235,195,107,0.22)]"
    />
    <div slot="right" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ece0c8]">
        สมาชิกสามารถติดตามโปรโมชั่น UFA99 ที่เปิดให้รับได้เป็นประจำ ไม่ว่าจะเป็นโบนัสแนะนำเพื่อน โปรโมชั่นคืนยอดเสีย หรือสิทธิพิเศษอื่น ๆ ตามช่วงเวลาที่กำหนด โดยสามารถตรวจสอบเปอร์เซ็นต์โบนัส
        ยอดที่นำมาคำนวณ รอบการกดรับ และเงื่อนไขการถอนผ่านหน้ารายละเอียดโปรโมชั่นก่อนเข้าร่วมทุกครั้ง
      </p>
      <p class="text-left text-base leading-relaxed text-[#ece0c8]">
        สำหรับโปรโมชั่นแนะนำเพื่อน สมาชิกสามารถแชร์ลิงก์แนะนำของตนเองและติดตามสิทธิ์ผ่านบัญชีสมาชิก ส่วนโปรโมชั่นคืนยอดเสียจะคำนวณตามยอดและประเภทเกมที่เข้าเงื่อนไข ช่วยให้ตรวจสอบสิทธิ์ของตนเองได้อย่างชัดเจนก่อนกดรับโบนัส
      </p>
    </div>
  </ContentBoxSevenThree>

  <ContentBoxSevenThree titleright="สมัครสมาชิก UFA99 เดิมพันออนไลน์ได้ 24 ชั่วโมง">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นพื้นหลังสีดำลายวงจรสีทอง ด้านบนเป็นโลโก้ UFA99 ตัวอักษรทองสลับเงิน ถัดลงมาเป็นข้อความ โปรโมชั่น แนะนำเพื่อน รับโบนัส พร้อมตัวเลข 0.8% ขนาดใหญ่สีทอง หญิงสาวสวมชุดจีนสีแดงดำชี้มือทางขวาของภาพ รอบตัวมีชิปคาสิโนสีทอง ไพ่เอซ และวงล้อรูเล็ต แถบด้านล่างเขียนว่า มั่นคง ปลอดภัย ระบบมาตรฐานสากล ฝาก-ถอน อัตโนมัติ และ บริการตลอด 24 ชม."
      class="mx-auto h-auto w-full rounded-2xl border border-[#ebc36b]/45 shadow-[0_10px_30px_rgba(235,195,107,0.22)]"
    />
    <div slot="right" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ece0c8]">
        ระบบเปิดให้สมาชิกเข้าสู่บัญชี ตรวจสอบเครดิต ฝากถอน และเลือกเกมได้ตลอด 24 ชั่วโมง หากติดขัดในขั้นตอนใดสามารถติดต่อเจ้าหน้าที่เพื่อขอคำแนะนำเพิ่มเติมได้
      </p>
      <p class="text-left text-base leading-relaxed font-bold text-[#fce48c]">เริ่มต้นใช้งาน UFA99 ผ่านมือถือหรือคอมพิวเตอร์ได้ง่ายเพียง 3 ขั้นตอน</p>
      <FeatureHighlights items={steps} />
    </div>
  </ContentBoxSevenThree>

  <ContentBoxSpecial as="h2" title="เว็บตรงมาตรฐานคาสิโน UFA99 ชั้นนำ ปลอดภัย เชื่อถือได้">
    <p slot="left" class="text-left text-base leading-relaxed text-[#ece0c8]">
      ระบบ UFA99 ออกแบบให้สมาชิกสามารถจัดการข้อมูลบัญชีและธุรกรรมผ่านหน้าเว็บไซต์ได้ด้วยตนเอง พร้อมแสดงประวัติรายการเพื่อให้ง่ายต่อการตรวจสอบ หากพบปัญหาเกี่ยวกับการเข้าสู่ระบบ เครดิตไม่เข้า ถอนเงินล่าช้า
      หรือโปรโมชั่นไม่แสดง สามารถติดต่อทีมงาน UFA99 ได้ตลอด 24 ชั่วโมง เพื่อให้เจ้าหน้าที่ช่วยตรวจสอบและแนะนำขั้นตอนดำเนินการต่อ
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#ece0c8]">
      การพนันมีความเสี่ยงและไม่สามารถรับประกันผลกำไรได้ สมาชิกควรศึกษากติกาของแต่ละเกมและกำหนดงบประมาณก่อนเดิมพันทุกครั้ง
    </p>
  </ContentBoxSpecial>

  <Faq2 title="คำถามที่พบบ่อยเกี่ยวกับ UFA99" faqs={faqs} />

  <LatestWinners4 />

  <LoginRtpSection />

  <ReviewCardSumo2 />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#fce48c] via-[#ebc36b] to-[#7b5213] px-4 py-3 text-sm font-black whitespace-nowrap text-[#0d0904] shadow-[0_10px_30px_rgba(235,195,107,0.28)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(235,195,107,0.42)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#ebc36b]/50 bg-gradient-to-r from-[#0d0904] to-[#050301] px-4 py-3 text-sm font-black whitespace-nowrap text-[#fce48c] shadow-[0_10px_30px_rgba(235,195,107,0.16)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#fce48c]/70 hover:text-[#e6e8ec] hover:shadow-[0_15px_40px_rgba(230,232,236,0.28)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>
  </div>

  <Navfoot />
</MainLayout>
