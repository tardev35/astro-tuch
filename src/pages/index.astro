---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxTwoFloatingBadge from "../components/ContentBoxTwoFloatingBadge.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBox from "../components/ContentBox.astro";
import LottoGrid from "../components/LottoGrid.astro";
import Faq4 from "../components/Faq4.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import LatestWinners from "../components/LatestWinners3.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide2 from "../assets/slide2.png";

// Title and description are the brief's own Title/Description lines, verbatim.
// A brief-supplied description ships at whatever length it was written — it is
// not padded up to the 150-character floor.
const pageTitle = "LEKDED เว็บซื้อหวยออนไลน์อันดับ1 ระบบฝากถอนออโต้ เร็ว ปลอดภัย";

const pageDescription =
  "LEKDED เว็บซื้อหวยออนไลน์อันดับ1 รับหวยไม่อั้นทุกรูปแบบ รัฐบาลไทย ลาว ฮานอย หุ้น ครบทุกประเภท จัดโปรรับโบนัสทุกวันที่1และ16 ฝากถอนรองรับทุกธนาคารและวอลเลท";

// The ticker copy is passed explicitly rather than relying on the component's
// default — every Announcement* variant's default belongs to whichever brand
// wired it in last. No emoji in this string: an emoji baked into a text prop
// cannot be given its own aria-hidden span, and this marquee prints the string
// twice.
const announcement =
  "LEKDED เว็บซื้อหวยออนไลน์อันดับ1 เปิดรับหวยไม่อั้นทุกรูปแบบ • รวมหวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยหุ้น ไว้ในบัญชีเดียว • เลือกเลข กรอกจำนวนเงิน และตรวจโพยก่อนยืนยันได้จากมือถือ • จัดโปรรับโบนัสทุกวันที่ 1 และ 16 ตามเงื่อนไขของกิจกรรม • ระบบฝากถอนรองรับบัญชีธนาคารและวอลเลทตามช่องทางที่เปิดให้บริการ • แอดมิน LEKDED ออนไลน์ตลอด 24 ชั่วโมง";

// One array, used by both <Faq4> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last.
const faqs = [
  {
    q: "LEKDED มีหวยประเภทไหนเปิดให้ซื้อบ้าง?",
    a: "มีหวยหลายประเภทให้เลือกตามรอบที่เปิดให้บริการ เช่น หวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยหุ้น โดยสมาชิกควรตรวจสอบเวลาเปิด-ปิด อัตราจ่าย และวงเงินของหวยแต่ละประเภทก่อนยืนยันโพย",
  },
  {
    q: "โปรโมชั่นวันที่ 1 และ 16 ของ LEKDED รับอย่างไร?",
    a: "สมาชิกที่เข้าเงื่อนไขสามารถตรวจสอบสิทธิ์ผ่านหน้าโปรโมชั่นในวันที่กำหนด โดยรายละเอียดโบนัสและวิธีรับอาจแตกต่างกันตามกิจกรรม ควรตรวจสอบเงื่อนไขล่าสุดก่อนกดรับทุกครั้ง",
  },
  {
    q: "ฝากถอน LEKDED แล้วเครดิตไม่เข้าต้องทำอย่างไร?",
    a: "ตรวจสอบสถานะรายการในบัญชีสมาชิกก่อน หากยอดยังไม่เข้าหรือรายการถอนยังค้าง สามารถติดต่อแอดมิน LEKDED พร้อมแจ้งจำนวนเงิน เวลา และรายละเอียดธุรกรรม เพื่อให้เจ้าหน้าที่ช่วยตรวจสอบได้ตลอด 24 ชั่วโมง",
  },
];

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb. Every URL in the graph is derived
// by pageGraph from `site:` — no domain is typed out in this file.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <SmoothCarousel />

  <ContentBoxFloatingBadge as="h1" title="LEKDED เว็บซื้อหวยออนไลน์อันดับ1 เปิดรับหวยไม่อั้นทุกรูปแบบ">
    <p class="text-left text-base leading-relaxed text-[#ecdfb4]">
      <strong class="text-[#fff4cd]">LEKDED</strong> พร้อมให้บริการผู้ที่ต้องการซื้อหวยออนไลน์ผ่านมือถือและคอมพิวเตอร์ รวมหวยหลายประเภทไว้ให้เลือกในบัญชีเดียว ทั้งหวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยหุ้น
      พร้อมระบบฝากถอนออโต้ที่รองรับช่องทางตามที่เว็บไซต์กำหนด มีโปรโมชั่นสำหรับสมาชิกในวันที่ 1 และ 16 ของเดือน รวมถึงแอดมินออนไลน์ตลอด 24 ชั่วโมง คอยช่วยตรวจสอบการสมัคร ส่งโพย ฝากถอน และปัญหาการใช้งาน
    </p>
  </ContentBoxFloatingBadge>

  <ContentBoxTwoFloatingBadge as="h2" title="LEKDED เว็บซื้อหวยออนไลน์ รัฐบาลไทย ลาว ฮานอย หุ้น ครบทุกประเภท">
    <p slot="left" class="text-left text-base leading-relaxed text-[#ecdfb4]">
      สมาชิก <strong class="text-[#fff4cd]">LEKDED</strong> สามารถเลือกซื้อหวยออนไลน์ได้หลายประเภทตามรอบที่เปิดให้บริการ ไม่ว่าจะเป็นหวยรัฐบาลไทย หวยลาว หวยฮานอย หรือหวยหุ้น
      โดยระบบแยกหมวดหมู่และรอบเดิมพันให้ตรวจสอบได้ง่าย สามารถเลือกเลข กรอกจำนวนเงิน และตรวจสอบรายละเอียดโพยก่อนยืนยันรายการผ่านมือถือได้โดยตรง
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#ecdfb4]">
      สำหรับวงเงินรับแทง <span class="font-black text-[#efd591]">เลขอั้น</span> เวลาเปิด-ปิด และอัตราจ่ายของหวยแต่ละประเภทอาจแตกต่างกัน จึงควรตรวจสอบข้อมูลที่ระบบแสดงในรอบนั้นก่อนส่งโพยทุกครั้ง
    </p>
  </ContentBoxTwoFloatingBadge>

  <LottoGrid />

  <ContentBoxSevenThreeCyberCut as="h2" title="จัดโปร LEKDED รับโบนัสทุกวันที่ 1 และ 16 ได้ทุกยูส">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นสี่เหลี่ยมจัตุรัส พื้นหลังสีดำเขียวทองมีลูกบิลเลียดเลข 8 เลข 9 เลข 3 และกองเหรียญทอง ด้านบนเป็นโลโก้ LEKDED สีทองเขียวมีมงกุฎและลูกบิลเลียดเลข 8 กลางภาพเป็นกรอบทองเขียนว่า โปรโมชั่น คืนยอดเสีย พร้อมตัวเลขทองขนาดใหญ่ 0.3% ด้านขวาเป็นผู้หญิงผมยาวสีเงินในชุดสีทองเขียวยืนแบมือ ด้านล่างซ้ายมีโพยหวยสามใบติดป้ายว่า รัฐบาลไทย ฮานอย และ ลาว พร้อมแถบข้อความ กดรับได้ทุกวัน มั่นคงปลอดภัยเชื่อถือได้ 100% บริการตลอด 24 ชม. และแถบล่างสุดเขียนว่า ซื้อหวยง่าย จ่ายจริง จ่ายเต็มทุกบิล"
      class="mx-auto h-auto w-full rounded-2xl border border-[#e2c466]/50 shadow-[0_10px_30px_rgba(226,196,102,0.28)]"
    />
    <div slot="right" class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ecdfb4]">
      <p>
        <strong class="text-[#fff4cd]">LEKDED</strong> มีโปรโมชั่นสำหรับสมาชิกตามรอบวันที่ 1 และ 16 ของเดือน โดยสมาชิกที่มีคุณสมบัติตรงตามข้อกำหนดสามารถ Login เพื่อตรวจสอบสิทธิ์และรายละเอียดโบนัสผ่านบัญชีของตนเอง
        ก่อนกดรับควรอ่านข้อมูลเกี่ยวกับยอดที่ใช้คำนวณ ช่วงเวลารับสิทธิ์ และเงื่อนไขที่เกี่ยวข้องให้ครบถ้วน
      </p>
      <p>หากไม่พบโบนัสหรือไม่แน่ใจว่าบัญชีของตนเองเข้าเงื่อนไขหรือไม่ สามารถสอบถามแอดมิน LEKDED เพื่อตรวจสอบสิทธิ์ก่อนทำรายการได้</p>
    </div>
  </ContentBoxSevenThreeCyberCut>

  <ContentBoxTwoNeumorphism as="h2" title="เว็บหวย LEKDED ระบบฝากถอนรองรับทุกธนาคารและวอลเลท">
    <p slot="left" class="text-left text-base leading-relaxed text-[#ecdfb4]">
      ระบบฝากถอนของ <strong class="text-[#fff4cd]">LEKDED</strong> ออกแบบให้สมาชิกสามารถจัดการเครดิตผ่านบัญชีของตนเอง รองรับบัญชีธนาคารและวอลเลทตามช่องทางที่เปิดให้บริการ สามารถตรวจสอบยอด ฝากเครดิต
      ส่งคำขอถอน และติดตามสถานะธุรกรรมผ่านระบบได้โดยตรง ช่วยให้จัดการเงินสำหรับซื้อหวยออนไลน์ได้สะดวกตลอดทั้งวัน
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#ecdfb4]">
      ก่อนยืนยันรายการควรตรวจสอบชื่อบัญชี จำนวนเงิน และช่องทางฝากถอนให้ถูกต้อง หากเครดิตไม่เข้าหรือรายการถอนค้าง สามารถแจ้งเจ้าหน้าที่พร้อมรายละเอียดธุรกรรมเพื่อให้ช่วยตรวจสอบได้
    </p>
  </ContentBoxTwoNeumorphism>

  <ContentBox as="h2" title="แอดมิน LEKDED ออนไลน์ตลอด 24 ชั่วโมง">
    <div class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ecdfb4]">
      <p>
        หากพบปัญหาเกี่ยวกับการสมัครสมาชิก Login ไม่ได้ ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินล่าช้า ส่งโพยไม่สำเร็จ หรือโปรโมชั่นไม่แสดง สามารถติดต่อแอดมิน <strong class="text-[#fff4cd]">LEKDED</strong>
        ได้ตลอด 24 ชั่วโมง พร้อมแจ้งรายละเอียดและเวลาที่เกิดปัญหา เพื่อช่วยให้เจ้าหน้าที่ค้นหารายการและแนะนำขั้นตอนแก้ไขได้ตรงจุด
      </p>
      <p>
        สมาชิกใหม่ยังสามารถสอบถามวิธีเลือกประเภทหวย วิธีส่งโพย ตรวจสอบอัตราจ่าย หรือขั้นตอนการฝากถอนก่อนเริ่มใช้งานจริงได้ โดยการเดิมพันมีความเสี่ยง ควรกำหนดงบประมาณให้เหมาะสมทุกครั้ง
      </p>
    </div>
  </ContentBox>

  <Faq4 title="คำถามที่พบบ่อยเกี่ยวกับ LEKDED" faqs={faqs} />

  <LoginRtpSection />

  <LatestWinners />

  <ReviewCardSumo2 />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#fbe479] via-[#e2c466] to-[#b5811e] px-4 py-3 text-sm font-black whitespace-nowrap text-[#030803] shadow-[0_10px_30px_rgba(226,196,102,0.32)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(251,228,121,0.46)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#7a5d2c]/80 bg-gradient-to-r from-[#123209] to-[#030803] px-4 py-3 text-sm font-black whitespace-nowrap text-[#fff4cd] shadow-[0_10px_30px_rgba(226,196,102,0.18)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#e2c466]/80 hover:text-[#fbe479] hover:shadow-[0_15px_40px_rgba(226,196,102,0.34)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>
  </div>

  <Navfoot />
</MainLayout>
