---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ProviderGrid from "../components/ProviderGridPremium.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import LatestWinners from "../components/LatestWinners3.astro";
import ContentBox from "../components/ContentBox.astro";
import Faq from "../components/Faq4.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// SLIDE ROLES FOR THIS DROP (2026-09-21) — READ BEFORE REUSING THESE IMPORTS.
// slide2.png prints "โปรโมชั่นคืนยอดเสีย 0.3%" so it belongs to docx H3 #4, and
// slide1.png prints "โปรโมชั่นแนะนำเพื่อน 0.8%" so it belongs to docx H3 #5. The
// pairing is NOT stable across brands — re-open the posters next rebrand instead
// of copying this forward. This drop's artwork is BLACK + GOLD (crown emblem,
// gold chips, black aces); any alt text on this page describing a purple or red
// poster is left over from an earlier brand and is wrong.
//
// slide3.png (2026-09-18) and slide4.png (2026-08-13) are deliberately NOT
// imported: both predate this drop and carry a previous client's artwork.
// banner2.png (2026-08-20) and banner3.png (2026-08-11) are stale for the same
// reason, so there is no single-column ContentBox inline illustration this
// round. banner1 / banner1-mobile belong to MainLayout's own pinned globs and
// are never referenced from a page — the hero is the LCP element, so nothing
// here gets loading="eager" fetchpriority="high".
//
// A slide may only ever live inside a ContentBoxSevenThree*. Two of them is the
// family's hard cap per rebrand and this page spends the whole budget.
//
// Rotated out of this round's mix and NOT deleted from disk (they are inventory
// for the next brand): Announcement3, ContentBoxFloatingBadge,
// ContentBoxTwoCyberCut, ContentBoxSpecial, ContentBoxSevenThreeNeumorphism,
// ContentBoxSevenThreeCyberCut, ContentBoxTwoNeumorphism, ProviderGrid,
// LatestWinnersPremium and Faq2.

// Title and description are the brief's own Title/Description lines, used
// verbatim. A brief-supplied description is never padded up to the 150-char
// floor and never topped up from the H1/H2.
const pageTitle = "HENG35 สมัครสล็อตยูสใหม่ ไม่ล็อค โบนัสฝากแรก ไม่อั้น";

const pageDescription = "HENG35 สมัครสล็อตยูสใหม่ รับสิทธิพิเศษเพียบ ไม่ล็อคยูส ฝากถอนไม่จำกัด ได้โบนัสฝากแรก ทั้งวอลเลทและธนาคาร เดิมพันไม่อั้น ไม่จำกัดยอดเดิมพัน";

// <Announcement /> runs bare: AnnouncementPremium's default message is already
// this brand's copy, and every sub-page calls it bare too — passing an override
// here is how the ticker ends up saying two different things on two pages.

// The docx has a real H1 -> H2 -> H3 hierarchy this round: #4 and #5 are genuine
// H3 sub-points of H2 #3 (โปรโมชั่น), so the page is NOT flattened to H2-only.
// They are the only <h3> on the site and they are carried by the two SevenThree
// blocks. Everything else here is chrome — ProviderGridPremium, LatestWinners3,
// LoginRtpSection and ReviewCardSumo2 all render their titles as <p>/<span> with
// an aria-label on the section, and Faq4's questions stay <span> inside
// <summary>, so none of them emits a heading.
// Final inventory for this page: h1 x1, h2 x5, h3 x2.

// One array, used by both <Faq> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last. The three pairs
// are the brief's own Q/A block, verbatim.
const faqs = [
  {
    q: "สมัคร HENG35 ยูสใหม่ได้รับโบนัสฝากแรกหรือไม่?",
    a: "ยูสใหม่สามารถตรวจสอบสิทธิ์โบนัสฝากแรกได้จากหน้าโปรโมชั่น โดยรายละเอียดของโบนัส ยอดที่เข้าเกณฑ์ และเงื่อนไขการรับอาจแตกต่างกันตามรายการที่เปิดให้ใช้งานในช่วงนั้น",
  },
  {
    q: "HENG35 มีการล็อคยูสหรือจำกัดการเข้าเล่นหรือไม่?",
    a: "ตามข้อมูลที่กำหนด จุดเด่นของระบบคือการใช้งานแบบไม่ล็อคยูส สมาชิกสามารถเลือกเกมและค่ายที่ต้องการได้ตามรายการที่รองรับ โดยควรตรวจสอบเงื่อนไขของแต่ละเกมก่อนเข้าเล่น",
  },
  {
    q: "HENG35 รองรับธนาคารและวอลเลทหรือไม่?",
    a: "ระบบรองรับช่องทางธนาคารและวอลเลทตามรายการที่เปิดให้ใช้งาน สมาชิกสามารถตรวจสอบช่องทางที่รองรับ รวมถึงสถานะฝากถอนและรายละเอียดของบัญชีได้จากหน้าเว็บไซต์โดยตรง",
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// The highlight colour is the palette's soft gold (#ffdf8a); it marks a claim
// the brief states outright and nothing else.

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb. Every URL in the graph is derived
// by pageGraph from `site:` — no domain is typed out in this file.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxPremium as="h1" title="HENG35 สมัครสล็อตยูสใหม่ ไม่ล็อค รับโบนัสฝากแรก ไม่อั้น">
    <p class="text-left text-base leading-relaxed text-[#ece1cb]">
      HENG35 เปิดรับสมาชิกใหม่ที่ต้องการเริ่มเล่นสล็อตผ่านระบบที่ใช้งานง่าย
      <strong class="text-[#ffdf8a]">ไม่ล็อคยูส</strong>
      <strong class="text-[#ffdf8a]">พร้อมสิทธิ์โบนัสฝากแรกตามเงื่อนไขที่กำหนด</strong>
      รองรับทั้งมือถือและคอมพิวเตอร์ มีเกมจากหลายค่ายให้เลือก พร้อมระบบบัญชีที่จัดการได้สะดวก เหมาะกับยูสใหม่ที่ต้องการเริ่มต้นโดยไม่จำกัดรูปแบบการเล่นมากเกินไป
    </p>
  </ContentBoxPremium>

  <ContentBoxTwoPremium as="h2" title="สล็อต HENG35 รับสิทธิพิเศษเฉพาะสมาชิก ไม่มีล็อคยูส">
    <p slot="left" class="text-left text-base leading-relaxed text-[#ece1cb]">
      สล็อต HENG35
      <strong class="text-[#ffdf8a]">มีสิทธิพิเศษสำหรับสมาชิกทั้งยูสใหม่และยูสเดิม</strong>
      <strong class="text-[#ffdf8a]">โดยเน้นการใช้งานแบบไม่มีล็อคยูส</strong>
      สามารถเลือกเกมจากหลายค่ายและตรวจสอบเงื่อนไขก่อนเข้าเล่นได้จากหน้าเดียว
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#ece1cb]">
      <strong class="text-[#ffdf8a]">ระบบจัดหมวดเกมชัดเจน</strong>
      ช่วยให้ค้นหาเกมที่ต้องการได้ง่าย
      <strong class="text-[#ffdf8a]">พร้อมตัวเลือกการเดิมพันที่หลากหลายตามแต่ละเกม</strong>
    </p>
  </ContentBoxTwoPremium>

  <ProviderGrid />

  <ContentBoxCyberCut as="h2" title="โปรโมชั่นสล็อต HENG35 รับได้ทุกฝากไม่จำกัด">
    <p class="text-left text-base leading-relaxed text-[#ece1cb]">
      โปรโมชั่นสล็อต HENG35
      <strong class="text-[#ffdf8a]">มีสิทธิ์ให้เลือกหลายรูปแบบตามเงื่อนไขของระบบ</strong>
      <strong class="text-[#ffdf8a]">ทั้งโบนัสคืนยอดเสียและโบนัสแนะนำเพื่อน</strong>
      สมาชิกสามารถตรวจสอบรายละเอียดก่อนกดรับได้จากหน้าโปรโมชั่น เพื่อดูยอดที่เข้าเกณฑ์ รอบรับสิทธิ์ และเงื่อนไขของแต่ละรายการก่อนนำไปใช้งาน
    </p>
  </ContentBoxCyberCut>

  <ContentBoxSevenThreePremium as="h3" title="คืนยอดเสีย โบนัส 0.3%">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[264, 382, 764]}
      sizes="(max-width: 767px) calc(100vw - 96px), 382px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นคืนยอดเสียของ HENG35 พื้นหลังสีดำตัดทอง ด้านบนเป็นตราสัญลักษณ์มงกุฎทอง HENG35 ใต้ลงมาเป็นข้อความว่า โปรโมชั่นคืนยอดเสีย และตัวเลข 0.3% ขนาดใหญ่สีทอง ด้านซ้ายเป็นผู้หญิงผมยาวสีเข้มสวมชุดดำสลับทอง รอบข้างมีเหรียญทองกระจายอยู่"
      class="mx-auto h-auto w-full rounded-2xl border border-[#ecc55c]/55 shadow-[0_10px_30px_rgba(236,197,92,0.28)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#ece1cb]">
      สมาชิก HENG35
      <strong class="text-[#ffdf8a]">สามารถรับโบนัสคืนยอดเสีย 0.3% ตามยอดและเงื่อนไขที่กำหนด</strong>
      <strong class="text-[#ffdf8a]">โดยระบบจะแสดงรายละเอียดของรอบคำนวณและยอดที่เข้าเกณฑ์ให้ตรวจสอบก่อนรับสิทธิ์</strong>
      ช่วยให้ติดตามโบนัสของตัวเองได้ง่ายขึ้น และสามารถวางแผนการใช้เครดิตในแต่ละรอบได้อย่างชัดเจน
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBoxSevenThree as="h3" title="แนะนำเพื่อน โบนัส 0.8%">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[264, 346, 692]}
      sizes="(max-width: 767px) calc(100vw - 96px), 346px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อนของ HENG35 พื้นหลังสีดำตัดทอง ด้านบนเป็นตราสัญลักษณ์มงกุฎทอง HENG35 ใต้ลงมาเป็นข้อความว่า โปรโมชั่นแนะนำเพื่อน และตัวเลข 0.8% ขนาดใหญ่สีทอง ด้านซ้ายเป็นผู้หญิงผมยาวสีเข้มสวมชุดดำสลับทอง ด้านขวาเป็นไพ่โพดำสีดำ มุมขวาบนมีข้อความว่า PLAY BIGGER TOGETHER และตามขอบล่างมีข้อความว่า MORE FRIENDS MORE WINS"
      class="mx-auto h-auto w-full rounded-2xl border border-[#a3732c]/55 shadow-[0_10px_30px_rgba(163,115,44,0.28)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#ece1cb]">
      โปรโมชั่นแนะนำเพื่อนของ HENG35
      <strong class="text-[#ffdf8a]">ให้โบนัส 0.8% ตามเงื่อนไขของกิจกรรม</strong>
      <strong class="text-[#ffdf8a]">สมาชิกสามารถชวนคนรู้จักเข้ามาสมัครผ่านช่องทางที่ระบบรองรับ</strong>
      พร้อมตรวจสอบยอดสิทธิ์และรายละเอียดของโบนัสได้จากบัญชีสมาชิก ช่วยให้ติดตามผลของการแนะนำเพื่อนได้สะดวกมากขึ้น
    </p>
  </ContentBoxSevenThree>

  <ContentBoxNeumorphism as="h2" title="HENG35 รับทุกธนาคารและวอลเลท ฝากถอนไม่จำกัด">
    <p class="text-left text-base leading-relaxed text-[#ece1cb]">
      ระบบ HENG35
      <strong class="text-[#ffdf8a]">รองรับช่องทางธนาคารและวอลเลทตามรายการที่เว็บไซต์เปิดให้ใช้งาน</strong>
      สมาชิกสามารถเลือกช่องทางที่เหมาะกับตัวเอง
      <strong class="text-[#ffdf8a]">พร้อมตรวจสอบยอดและสถานะฝากถอนจากบัญชีได้โดยตรง</strong>
      ขั้นตอนถูกจัดให้เข้าใจง่าย และรองรับการทำรายการตามวงเงินและเงื่อนไขที่ระบบกำหนด
    </p>
  </ContentBoxNeumorphism>

  <LatestWinners />

  <ContentBox as="h2" title="ติดต่อแอดมิน HENG35 พร้อมให้บริการ 24 ชั่วโมง">
    <p class="text-left text-base leading-relaxed text-[#ece1cb]">
      หากมีข้อสงสัยเกี่ยวกับการสมัคร โบนัสฝากแรก โปรโมชั่น การเข้าเกม หรือระบบฝากถอน
      <strong class="text-[#ffdf8a]">สามารถติดต่อแอดมิน HENG35 ได้ตลอด 24 ชั่วโมง</strong>
      <strong class="text-[#ffdf8a]">ทีมงานพร้อมช่วยตรวจสอบข้อมูลและแนะนำขั้นตอนใช้งานตามปัญหาที่แจ้ง</strong>
      ช่วยให้ทั้งสมาชิกใหม่และสมาชิกเดิมเข้าถึงข้อมูลได้สะดวกทุกช่วงเวลา
    </p>
  </ContentBox>

  <Faq as="h2" title="คำถามที่พบบ่อย" faqs={faqs} />

  <LoginRtpSection />

  <ReviewCardSumo />

  <Navfoot />
</MainLayout>
