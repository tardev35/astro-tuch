---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBox from "../components/ContentBox.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import Faq4 from "../components/Faq4.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import LatestWinners from "../components/LatestWinnersCyber.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// Title and description are the brief's own Title/Description lines, verbatim.
// A brief-supplied description ships at whatever length it was written — it is
// not padded up to the 150-character floor.
const pageTitle = "BETPLAY369 เว็บเกมคาสิโนครอบคลุมทั้งวงจร แบรนด์แท้ ต้องมีไลฟ์สด";

const pageDescription = "BETPLAY369 เว็บเกมคาสิโนครอบคลุมทั้งวงจร บาคาร่า สล็อต หวย มวย บอล ปลอดภัยแน่นอนด้วยแบรนด์แท้ของเอเชีย การันตีได้จากไลฟ์สด ส่งตรงจากเมกา";

// The ticker copy is passed explicitly rather than relying on the component's
// default — every Announcement* variant's default belongs to whichever brand
// wired it in last. The string matches the variant's current default on
// purpose, so the pages that call <Announcement /> bare show the same ticker.
// No emoji in this string: an emoji baked into a text prop cannot be given its
// own aria-hidden span, and this marquee prints the string twice.
const announcement =
  "BETPLAY369 เว็บเกมคาสิโนครอบคลุมทั้งวงจร แบรนด์แท้ของเอเชีย • รวมบาคาร่า คาสิโนสด สล็อต หวย มวย และฟุตบอล ไว้ในบัญชีเดียว • โปรโมชั่นคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ตามเงื่อนไข • รองรับทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์ • แอดมิน BETPLAY369 ดูแลสมาชิกตลอด 24 ชั่วโมง";

// One array, used by both <Faq4> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last.
const faqs = [
  {
    q: "BETPLAY369 มีเกมอะไรให้เลือกเดิมพันบ้าง?",
    a: "ระบบมีหลายหมวดหมู่ เช่น บาคาร่า คาสิโนสด สล็อต หวย มวย และฟุตบอล รวมถึงเกมเดิมพันประเภทอื่น ๆ โดยสมาชิกสามารถตรวจสอบรายการเกมและตลาดเดิมพันที่เปิดให้บริการล่าสุดผ่านหน้าเว็บไซต์ได้",
  },
  {
    q: "โบนัส BETPLAY369 0.3% และ 0.8% รับอย่างไร?",
    a: "โบนัส 0.3% เป็นโปรโมชั่นคืนยอดเสียสำหรับยอดที่เข้าเงื่อนไข ส่วน 0.8% เป็นโบนัสจากกิจกรรมแนะนำเพื่อน สมาชิกควรตรวจสอบรอบคำนวณ ยอดขั้นต่ำ และเงื่อนไขการถอนของแต่ละโปรโมชั่นก่อนกดรับ",
  },
  {
    q: "BETPLAY369 มีคาสิโนแบบไลฟ์สดหรือไม่?",
    a: "หากระบบเปิดให้บริการเกม Live สมาชิกสามารถเลือกโต๊ะคาสิโนสดจากหมวดที่เกี่ยวข้องและตรวจสอบผู้ให้บริการได้ก่อนเข้าเล่น ส่วนสตูดิโอหรือประเทศต้นทางของสัญญาณควรตรวจสอบจากข้อมูลที่แสดงในเกมโดยตรง เนื่องจากอาจแตกต่างกันในแต่ละผู้ให้บริการ",
  },
];

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <SmoothCarousel />

  <ContentBoxPremium as="h1" title="BETPLAY369 เกมคาสิโนออนไลน์ ครอบคลุมครบวงจร">
    <p class="text-left text-base leading-relaxed text-[#dfd0ee]">
      <strong class="text-[#f4ebff]">BETPLAY369</strong> พร้อมให้บริการสมาชิกที่ต้องการรวมเกมเดิมพันออนไลน์หลายประเภทไว้ในบัญชีเดียว ทั้งบาคาร่า สล็อต หวย มวย และฟุตบอล รองรับการใช้งานผ่านมือถือและคอมพิวเตอร์
      พร้อมเกมคาสิโนสดจากโต๊ะ Live ที่เปิดให้บริการตามระบบ มีโปรโมชั่นคืนยอดเสีย <span class="font-black text-[#ffd54a]">0.3%</span> และแนะนำเพื่อน
      <span class="font-black text-[#ffd54a]">0.8%</span> ตามเงื่อนไข รวมถึงแอดมินคอยให้คำแนะนำด้านการใช้งานตลอด 24 ชั่วโมง
    </p>
  </ContentBoxPremium>

  <ContentBoxTwoNeumorphism as="h2" title="BETPLAY369 รวมเกมเดิมพัน บาคาร่า สล็อต หวย มวย บอล ครบทุกแนว">
    <p slot="left" class="text-left text-base leading-relaxed text-[#dfd0ee]">
      BETPLAY369 จัดหมวดหมู่เกมเดิมพันให้สมาชิกเลือกได้ตามความสนใจ มีทั้งบาคาร่าและคาสิโนสดสำหรับผู้ที่ชอบรูปแบบ Live, สล็อตออนไลน์หลากหลายค่าย, หวยออนไลน์หลายรอบ รวมถึงการเดิมพันมวยและฟุตบอล
      สมาชิกสามารถเลือกหมวดเกม ตรวจสอบกติกา อัตราจ่าย และรายละเอียดการเดิมพันผ่านบัญชีเดียวได้สะดวกทั้งบนมือถือ แท็บเล็ต และคอมพิวเตอร์
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#dfd0ee]">
      เกมและการเดิมพันแต่ละประเภทมีความเสี่ยงแตกต่างกัน ผลการแข่งขันหรือผลของเกมไม่สามารถรับประกันล่วงหน้าได้ จึงควรตรวจสอบกติกาและกำหนดงบประมาณก่อนยืนยันการเดิมพัน
    </p>
  </ContentBoxTwoNeumorphism>

  <ProviderGrid />

  <ContentBoxTwoCyberCut as="h2" title="สมัครสมาชิก BETPLAY369 กับเรา ปลอดภัยแน่นอน ด้วยแบรนด์แท้ของเอเชีย">
    <p slot="left" class="text-left text-base leading-relaxed text-[#dfd0ee]">
      ผู้ใช้งานใหม่สามารถสมัคร BETPLAY369 ผ่านหน้าเว็บไซต์ได้ด้วยขั้นตอนที่ไม่ซับซ้อน หลังเปิดบัญชีสามารถ Login เพื่อตรวจสอบเกม โปรโมชั่น ช่องทางฝากถอน และประวัติรายการต่าง ๆ ได้จากระบบสมาชิก
      โดยควรใช้ข้อมูลที่ถูกต้องในการสมัคร และไม่เปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#dfd0ee]">
      สำหรับข้อมูลเกี่ยวกับผู้ให้บริการ ลิขสิทธิ์ หรือแหล่งที่มาของเกม แนะนำให้ตรวจสอบรายละเอียดที่เว็บไซต์หรือผู้ให้บริการเกมประกาศโดยตรงก่อนใช้งาน
    </p>
  </ContentBoxTwoCyberCut>

  <ContentBoxNeumorphism as="h2" title="โปร BETPLAY369 สมัครรับได้ทันที แม้ฝากน้อย">
    <p class="text-left text-base leading-relaxed text-[#dfd0ee]">
      สมาชิกสามารถตรวจสอบโปรโมชั่น BETPLAY369 ที่กำลังเปิดให้รับได้จากหน้าโปรโมชั่น โดยแต่ละรายการอาจกำหนดยอดขั้นต่ำ เกมที่เข้าร่วม วิธีคำนวณโบนัส และเงื่อนไขการถอนแตกต่างกัน
      แม้เป็นผู้เล่นที่ใช้เงินเดิมพันไม่สูงก็ควรตรวจสอบสิทธิ์ในบัญชีของตนเองก่อนกดรับ เพื่อเลือกโปรโมชั่นให้ตรงกับรูปแบบการใช้งาน
    </p>
  </ContentBoxNeumorphism>

  <ContentBoxSevenThreeCyberCut as="h3" title="โปรโมชั่นคืนยอดเสีย รับโบนัส 0.3%">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นแนวนอน ฉากคาสิโนแสงนีออนบนพื้นหลังดำ ด้านบนกลางเป็นโลโก้ BETPLAY369 มีไพ่เอซสองใบที่มุมบนซ้าย วงล้อรูเล็ตและชิปนีออนที่มุมล่างซ้าย พร้อมสัญลักษณ์โพดำ ด้านขวาเป็นนางแบบในชุดดำตัดนีออน กลางภาพเขียนว่า โปรโมชั่น คืนยอดเสีย 0.3% โดยตัวเลข 0.3% เป็นนีออนสีทอง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#e5399f]/45 shadow-[0_10px_30px_rgba(229,57,159,0.24)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#dfd0ee]">
      สมาชิกที่มียอดเสียตรงตามข้อกำหนดสามารถตรวจสอบสิทธิ์รับโบนัสคืนยอดเสีย <span class="font-black text-[#ffd54a]">0.3%</span> ตามรอบที่กำหนด ระบบจะแสดงยอดที่ใช้คำนวณและสิทธิ์ที่สามารถรับได้ โดยควรอ่านรายละเอียดเกี่ยวกับประเภทเกม
      รอบคำนวณ และข้อกำหนดของโบนัสก่อนกดรับทุกครั้ง
    </p>
  </ContentBoxSevenThreeCyberCut>

  <ContentBoxSevenThreeNeumorphism as="h3" title="โปรโมชั่นแนะนำเพื่อน รับโบนัส 0.8%">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นแนวนอน ฉากคาสิโนแสงนีออนบนพื้นหลังดำ ด้านบนกลางเป็นโลโก้ BETPLAY369 มีป้ายมงกุฎทองคำคำว่า CASINO วงล้อรูเล็ตและกองชิปที่มุมล่างซ้าย ไพ่กระจายอยู่ข้างกัน ด้านขวาเป็นนางแบบยิ้มในชุดดำตัดนีออน กลางภาพเขียนว่า โปรโมชั่น แนะนำเพื่อน 0.8% โดยตัวเลข 0.8% เป็นนีออนสีทอง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#22c6f0]/45 shadow-[0_10px_30px_rgba(34,198,240,0.2)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#dfd0ee]">
      สมาชิกสามารถแชร์ลิงก์แนะนำของตนเองให้เพื่อน เมื่อเพื่อนสมัครและมีรายการตรงตามเงื่อนไข ระบบจะคำนวณโบนัสแนะนำเพื่อน <span class="font-black text-[#ffd54a]">0.8%</span> ตามข้อกำหนด สามารถติดตามจำนวนการแนะนำ
      ยอดที่ใช้คำนวณ และโบนัสผ่านบัญชีสมาชิกได้โดยตรง
    </p>
  </ContentBoxSevenThreeNeumorphism>

  <ContentBox as="h2" title="แอดมิน BETPLAY369 ออนไลน์ 24 ชั่วโมง พร้อมดูแลระบบคาสิโนสด">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dfd0ee]">
        หากพบปัญหาเกี่ยวกับการสมัครสมาชิก Login ฝากถอน เครดิตไม่เข้า โปรโมชั่นไม่แสดง หรือเข้าโต๊ะคาสิโน Live ไม่ได้ สามารถติดต่อแอดมิน BETPLAY369 ได้ตลอด 24 ชั่วโมง
        พร้อมแจ้งรายละเอียดและเวลาที่เกิดปัญหา เพื่อให้ทีมงานช่วยตรวจสอบระบบและแนะนำขั้นตอนดำเนินการต่อได้ตรงจุด
      </p>
      <p class="text-left text-base leading-relaxed text-[#dfd0ee]">
        สำหรับคำกล่าวเรื่องไลฟ์สดหรือการส่งสัญญาณจากต่างประเทศ ควรยึดข้อมูลของสตูดิโอและผู้ให้บริการเกมที่แสดงในระบบเป็นหลัก เนื่องจากแต่ละโต๊ะ Live อาจมาจากผู้ให้บริการและสถานที่แตกต่างกัน
      </p>
    </div>
  </ContentBox>

  <Faq4 title="คำถามที่พบบ่อยเกี่ยวกับ BETPLAY369" faqs={faqs} />

  <LoginRtpSection />

  <LatestWinners />

  <ReviewCardSumo2 />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#22c6f0] via-[#ff35b4] to-[#e5399f] px-4 py-3 text-sm font-black whitespace-nowrap text-[#08030f] shadow-[0_10px_30px_rgba(229,57,159,0.28)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(229,57,159,0.42)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#a48fc4]/55 bg-gradient-to-r from-[#1a0730] to-[#08030f] px-4 py-3 text-sm font-black whitespace-nowrap text-[#f4ebff] shadow-[0_10px_30px_rgba(229,57,159,0.16)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#22c6f0]/80 hover:text-[#22c6f0] hover:shadow-[0_15px_40px_rgba(229,57,159,0.3)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>
  </div>

  <Navfoot />
</MainLayout>
