---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import LatestWinners from "../components/LatestWinnersPremium.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import ContentBox from "../components/ContentBox.astro";
import Faq from "../components/Faq3.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import { pageGraph } from "../lib/schema";
import imgTwoDigit from "../assets/slide1.png";
import imgThreeDigit from "../assets/slide2.png";

// VARIANT ROTATION THIS ROUND (หวยคิง -> หวย24). Zero file reuse from the previous
// round: Announcement3 replaces AnnouncementHuay, LatestWinnersPremium replaces
// LatestWinnersHuay, Faq3 replaces FaqHuay, and the ContentBox shape-mix moves off
// Huay / TwoHuay / Premium / SevenThreeHuay / SevenThreePremium / TwoPremium onto
// FloatingBadge / TwoNeumorphism / CyberCut / SevenThreeNeumorphism /
// SevenThreeCyberCut / TwoCyberCut. NavbarStyle10 and FooterStyle3 are the layout's
// pair this round (previously NavbarHuay / FooterHuay) and the brand font moves
// kanit -> google-sans; all three are the orchestrator's shared-chrome step, not
// this page's.
// Plain ContentBox is the one deliberate carry-over: terms, privacy, 404 and every
// button page render their body through it by rule and cannot follow a rotation,
// so it is always-live and the orchestrator rethemes it in the shared step — this
// page only passes it props.
// Every *Huay / *Premium / Style file, FaqHuay, AnnouncementHuay and
// LatestWinnersHuay stay on disk as inventory for the next brand — none of them was
// deleted, and the previous brand's copy and colour still inside them is expected
// drift, not a bug. ReviewCardSumo2 is reused rather than rotated to ReviewCardSumo
// because this page owns it and rewrote every row from the new brief; the rotation
// rule is about shape families with live siblings, and the review ledger's only
// sibling is the shape this one replaced last round.
//
// <Announcement /> runs bare on purpose: Announcement3's default message is already
// this brand's copy and every sub-page calls it bare too, so passing an override
// here is exactly how the ticker ends up saying two different things on two pages
// of the same site.
//
// IMAGE ROLES FOR THIS DROP (2026-10-04). Two files are referenced from this page
// and only two, and each pairing is read off the artwork itself rather than copied
// from last round — the pairing is REVERSED from หวยคิง, which had slide2 on the
// 2-digit section:
//   slide1.png — model on the LEFT of a black-and-gold set holding lottery ball 2,
//     and the black gold-edged plaque under the big gold อัตราการจ่าย wordmark reads
//     "2ตัว จ่าย100บาท", so it belongs to docx H3 #4. Imported as imgTwoDigit.
//   slide2.png — red silk curtain set, model on the RIGHT, balls 7 / 3 / 9 bottom
//     left, plaque reads "3ตัว จ่าย1,000บาท", so it belongs to docx H3 #5. Imported
//     as imgThreeDigit.
// Both files are 600px wide (600x334 and 600x333 — the brand spec's "600x600" is a
// typo; only the width drives the candidate list), so 600 is the top real candidate
// — nothing above it would be a real pixel — and each picture carries
// max-w-[600px] so the art is never upscaled past its own bitmap. Each slide sits
// in a ContentBoxSevenThree* image+text block, which is that family's hard cap of
// two per rebrand, so there is no third SevenThree anywhere on the site.
// The two blocks mirror each other: SevenThreeNeumorphism lays out
// md:grid-cols-[7fr_3fr] so its picture goes in slot="right" while the paragraph
// keeps the wide column, and SevenThreeCyberCut lays out md:grid-cols-[3fr_7fr] so
// its picture goes in slot="left". The two pictures therefore alternate sides
// instead of stacking down the same edge, and each `sizes` describes its own 3fr
// column rather than the viewport. Both figures are copied from the arithmetic
// block in the component that owns the column — if a padding/gap/cap changes there,
// these move with it:
//   SevenThreeNeumorphism: max-w-[1400px] cap, px-4, p-8, gap-8, and the image
//                          column adds md:pl-8
//                          -> (1400 - 32 - 64 - 32) x 0.3 - 32 = 350px
//   SevenThreeCyberCut:    max-w-7xl/1280px cap, px-4, p-8, gap-8, and NO inner
//                          padding on the image column
//                          -> (1280 - 32 - 64 - 32) x 0.3 = 346px
// Below md both cards collapse to one column at p-8, so the drawn width is
// 100vw - 32 (section px-4) - 64 (card p-8) = 100vw - 96px, capped at 600px.
// Neither picture is the LCP element — MainLayout's hero banner is — so both are
// loading="lazy" fetchpriority="low".
//
// The alt text was written from THIS drop's artwork, not carried over: slide1 is a
// black-and-gold set with the model on the left holding ball 2, loose gold coins and
// balls 6 and 8, and a lottery ticket in the lower right; slide2 is a red silk
// curtain over black with the model on the right in a gold-embroidered black Chinese
// dress, her left palm turned up, and coins plus balls 7, 3 and 9 in the lower left.
// Both carry the circular red 24 logo and the หวย24 wordmark across the top, a large
// gold Thai อัตราการจ่าย wordmark under it, and that slide's own rate plaque beneath.
//
// Deliberately NOT imported, and every file still on disk:
//   banner2.png (2026-09-28) / banner3.png (2026-09-27) / slide3.png /
//   slide4.png (2026-09-29) all predate this drop and belong to previous brands —
//   importing any of them would emit a competitor's artwork into dist/, so there is
//   no inline article illustration this round.
//   banner1.png and banner1-mobile.png belong to MainLayout's own pinned globs and
//   are never referenced from a page. og.png is the same: MainLayout owns it.
// Also deliberately unused: FeatureHighlights.astro (it renders sub-points as <h3>,
// and the brief's heading inventory allows exactly two H3s — sections 4 and 5 — so
// wiring it in would break the count), ContentBox3ThreeCyberCut and
// ContentBox3ThreeNeumorphism (no brief section on this page is a three-way split;
// every section is one or two running paragraphs), and ContentBoxTwoFloatingBadge
// (its badge clearance was re-derived against /about-us's shorter section title, so
// using it here would put a longer sentence in padding sized for that one).
//
// Vocabulary: หวย24 is a pure lottery brand — a เว็บแทงหวยออนไลน์, not a casino. The
// words this page may use are the brief's own: แทงหวย, ส่งโพย, โพย, รอบ, รายการหวย,
// หวยลาว, หวยฮานอย, รัฐบาลไทย, เลข 2 ตัว, เลข 3 ตัว, เลขเด็ด, เลขดัง, แนวทางหวย,
// อัตราจ่าย, เรทจ่าย, วงเงินรับแทง, ยอดสูงสุดที่ระบบเปิดรับ, ผลรางวัล, ประวัติโพย,
// สมัคร 3 ขั้นตอน, Login, แอดมิน 24 ชั่วโมง, PIN, OTP.
// The previous brand's entire angle (บาทละ 1,000 as the headline promise, เว็บแม่,
// จ่ายไม่อั้น, ยอดเข้าบริษัทโดยตรง, นิติบุคคล/บัญชีบริษัท, เครดิต/วอลเลท) is gone —
// the page was written from the new brief rather than find-and-replaced over the old
// sentences. Nothing here claims a licence, a regulator, an operator, a bank, a draw
// time, a lottery market beyond the brief's own ลาว/ฮานอย/รัฐบาลไทย (no ลาวพัฒนา,
// หวยหุ้น or ยี่กี), a deposit minimum, a member count or a founding year, because
// the brief names none. The only figures are the brief's own: 2 ตัว, 3 ตัว, 100,
// 1,000, 3 ขั้นตอน, 24 ชั่วโมง. The brief's own hedging ships with the copy (เวลารับ
// แทงจริงขึ้นกับรอบเปิด-ปิดของหวยแต่ละรายการ · "รับไม่อั้น"/"จ่ายเต็มทุกโพย" ควรยึด
// วงเงินและเงื่อนไขจริงที่ระบบแสดง · แนวทางหวย/เลขดังไม่รับประกันผลรางวัลรอบถัดไป ·
// ถ้าไม่มีข้อมูลเปรียบเทียบที่ตรวจสอบได้ "เรทจ่ายสูง" เหมาะกว่า "เรทจ่ายสูงที่สุด") —
// it is part of the paragraphs, not trimmed as downbeat.
//
// Title and description are the brief's own Title/Description lines, used verbatim
// and NOT padded up to 150: verify-build deliberately skips its 150-character floor
// on the home page for exactly this reason. The brand name is interpolated rather
// than typed so it can never drift from brandProfile, and no domain is written out
// anywhere in this file.
const pageTitle = `${BRAND_NAME} เว็บแทงหวยออนไลน์ 24ชั่วโมง แนวทางหวยครบ ลาว ฮานอย รัฐบาลไทย`;

const pageDescription = `${BRAND_NAME} เว็บแทงหวยออนไลน์ 24ชั่วโมง แนวทางหวยครบ ลาว ฮานอย รัฐบาลไทย รับทุกเลขเด็ด เลขดัง รับไม่อั้น จ่ายเต็มทุกโพย`;

// The brief has a real H2 -> H3 nesting this round, so the page is NOT flattened to
// H2-only. The two H3s are genuine headings — the two rate sub-points, both nested
// under the อัตราการจ่าย H2 — and they stay H3.
//
// The checklist, in document order, and what carries each one:
//    1 H1  หวย24 เว็บแทงหวยออนไลน์ 24ชั่วโมง แนวทางหวยครบ จ่ายเต็ม
//          ContentBoxFloatingBadge, brief paragraph on line 4
//    2 H2  หวย24 รับแทง ลาว ฮานอย รัฐบาลไทย รับเลขเด็ด เลขดัง ไม่อั้น จ่ายเต็มทุกโพย
//          ContentBoxTwoNeumorphism, line 6 left / line 7 right
//    3 H2  อัตราการจ่าย หวย24 ให้เรทจ่ายสูงที่สุด
//          ContentBoxCyberCut, lines 9 + 10
//    4 H3  2ตัว จ่าย100บาท
//          ContentBoxSevenThreeNeumorphism + slide1 (imgTwoDigit), line 12
//    5 H3  3ตัว จ่าย1,000บาท
//          ContentBoxSevenThreeCyberCut + slide2 (imgThreeDigit), line 14
//    6 H2  สมัครแทง หวย24 ง่ายๆ 3ขั้นตอน
//          ContentBoxTwoCyberCut, line 16 left / line 17 right
//    7 H2  ติดต่อแอดมิน หวย24 เว็บแทงหวยได้ตลอด 24 ชั่วโมง
//          ContentBox + LINE / สมัครสมาชิก buttons, lines 19 + 20
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ หวย24
//          Faq3 + faqs prop, lines 22-27
// Final inventory for this page: h1 x1, h2 x5, h3 x2.
//
// Shape rhythm, top to bottom: floating-badge card -> two-column raised slab ->
// single-column cut-corner -> 7:3 raised slab -> 3:7 cut-corner -> two-column
// cut-corner -> single-column rounded -> accordion. No shape repeats back to back,
// and the three cut-corner cards sit on three different surface depths (#170707,
// #0a0303, #230d0d) exactly as their own files document.
//
// ContentBoxSevenThreeNeumorphism takes the docx heading through `title`, which
// falls back to its wide (7fr) LEFT text column; its image column is passed no
// `titleright`, so the block emits exactly one heading. ContentBoxSevenThreeCyberCut
// is the mirror and takes the same heading through `title`, which falls back to its
// wide RIGHT column, with no `titleleft` on the picture.
//
// Every brief paragraph ships in full — all eleven of them, nothing merged or
// summarised. Sections 3 and 7 have two paragraphs each and stack inside one wrapper
// div so the slot still receives exactly one element; sections 2 and 6 have two each
// and run one per column; sections 1, 4 and 5 have one each. The column labels
// passed to the two two-column boxes are this page's own layout wording, not brief
// headings, and both variants render them as <p>.
//
// Everything else on the page is chrome and emits no heading tag at any level:
// Announcement3, LatestWinnersPremium, LoginRtpSection and ReviewCardSumo2 render
// their titles as <p>/<span> with an aria-label on the section, and Faq3's questions
// live inside <summary> as <p>. The non-brief widgets sit before section 1 (the
// ticker, then the winners feed) and after section 8 (LoginRtpSection,
// ReviewCardSumo2, Navfoot) — never spliced between two content sections.

// One array, used by both <Faq> and the FAQPage node — never the component's own
// defaults, which belong to whichever brand shipped last. The three pairs are the
// brief's own Q/A block, verbatim.
const faqs = [
  {
    q: `${BRAND_NAME} เปิดรับแทงหวยตลอด 24 ชั่วโมงหรือไม่?`,
    a: "เว็บไซต์อาจเปิดให้ Login และตรวจสอบข้อมูลได้ตลอด 24 ชั่วโมง แต่การรับแทงขึ้นอยู่กับเวลาเปิดและปิดของหวยแต่ละรอบ สมาชิกควรตรวจสอบเวลาที่ระบบแสดงก่อนส่งโพย",
  },
  {
    q: `${BRAND_NAME} รับเลขเด็ดและเลขดังแบบไม่อั้นจริงหรือไม่?`,
    a: "สามารถเลือกเลขตามรายการที่เปิดรับได้ แต่วงเงินอาจแตกต่างกันตามหวย รอบ และยอดรวมของเลขนั้น โดยเฉพาะเลขที่ได้รับความนิยมสูง ควรตรวจสอบจำนวนเงินสูงสุดที่ระบบรับได้ก่อนยืนยันโพย",
  },
  {
    q: `${BRAND_NAME} 2 ตัวจ่าย 100 และ 3 ตัวจ่าย 1,000 ทุกประเภทหรือไม่?`,
    a: "อัตรา 2 ตัว 100 บาท และ 3 ตัว 1,000 บาท ใช้กับรายการที่เข้าเงื่อนไขเท่านั้น หวยแต่ละประเภทหรือรูปแบบการเดิมพันอาจมีเรทแตกต่างกัน จึงควรตรวจสอบอัตราล่าสุดบนหน้าส่งโพยก่อนเดิมพัน",
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space that
// splits the word — the copy must read identically with the tags removed.
// One highlight colour only: #ffd45e, the brand's bright gold, against the inherited
// body colour #f7e2d6 (BRAND_TEXT). The paragraphs below carry no colour class of
// their own: every ContentBox* card in this mix already sets
// `text-left text-base leading-relaxed text-[#f7e2d6]` on the element holding the
// slot, so the prose inherits it and no page-level override can drift from the card.
// No paragraph carries mx-auto or max-w-* either — the cards cap their own width.

// No breadcrumb: this is the homepage, so a trail from the root to itself would be a
// single self-referential crumb. Every URL in the graph is derived by pageGraph from
// `site:` — no domain is typed out in this file, and no Review / AggregateRating /
// sameAs / address / email node is passed.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <LatestWinners />

  <ContentBoxFloatingBadge as="h1" title={`${BRAND_NAME} เว็บแทงหวยออนไลน์ 24ชั่วโมง แนวทางหวยครบ จ่ายเต็ม`}>
    <p>
      <strong class="text-[#ffd45e]">{BRAND_NAME} เว็บแทงหวยออนไลน์ที่รวมรายการและแนวทางหวยไว้ให้ติดตามผ่านมือถือ</strong>
      มีทั้งหวยลาว หวยฮานอย และรัฐบาลไทย พร้อมข้อมูลรอบเปิดรับ อัตราจ่าย และผลรางวัล
      <strong class="text-[#ffd45e]">สมาชิกสามารถเลือกเลขเด็ด เลขดัง หรือชุดตัวเลขที่สนใจแล้วตรวจสอบรายละเอียดก่อนส่งโพยได้ตลอดช่วงเวลาที่แต่ละรายการเปิดให้เดิมพัน</strong>
      แม้ระบบเว็บไซต์จะเข้าใช้งานได้ 24 ชั่วโมง แต่เวลารับแทงจริงยังขึ้นอยู่กับกำหนดเปิดและปิดของหวยแต่ละรอบ
    </p>
  </ContentBoxFloatingBadge>

  <ContentBoxTwoNeumorphism
    as="h2"
    title={`${BRAND_NAME} รับแทง ลาว ฮานอย รัฐบาลไทย รับเลขเด็ด เลขดัง ไม่อั้น จ่ายเต็มทุกโพย`}
    titleleft="รายการหวยที่เปิดรับในบัญชีเดียว"
    titleright="วงเงินรับแทงและแนวทางหวย">
    <p slot="left">
      <strong class="text-[#ffd45e]">{BRAND_NAME} รวบรวมหวยยอดนิยมหลายรายการไว้ในบัญชีเดียว</strong>
      ทั้งหวยลาวตามรอบที่เปิดรับ หวยฮานอยหลายช่วงเวลา และรัฐบาลไทยตามกำหนดออกรางวัล
      <strong class="text-[#ffd45e]">สมาชิกสามารถนำเลขเด็ด เลขดัง หรือเลขที่เลือกด้วยตัวเองมาตรวจสอบวงเงินและส่งโพยผ่านระบบ</strong>
      พร้อมดูยอดเดิมพันและอัตราจ่ายก่อนยืนยันรายการได้ทันที
    </p>
    <p slot="right">
      <strong class="text-[#ffd45e]">คำว่า “รับไม่อั้น” และ “จ่ายเต็มทุกโพย” ควรยึดตามวงเงินและเงื่อนไขจริงที่ระบบแสดง</strong>
      เนื่องจากเลขที่มียอดเดิมพันสูงอาจมีวงเงินรับแตกต่างจากเลขทั่วไป
      <strong class="text-[#ffd45e]">ส่วนแนวทางหวยหรือเลขดังเป็นข้อมูลประกอบเท่านั้น ไม่สามารถรับประกันผลรางวัลของรอบถัดไปได้</strong>
    </p>
  </ContentBoxTwoNeumorphism>

  <ContentBoxCyberCut as="h2" title={`อัตราการจ่าย ${BRAND_NAME} ให้เรทจ่ายสูงที่สุด`}>
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#ffd45e]">อัตราการจ่าย {BRAND_NAME} สามารถตรวจสอบได้ก่อนส่งโพย</strong>
        โดยรายการที่เข้าเงื่อนไขมีเรท
        <strong class="text-[#ffd45e]">2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท</strong>
        ช่วยให้สมาชิกทราบอัตราที่ใช้คำนวณก่อนยืนยันการเดิมพัน ทั้งนี้อัตราจริงอาจแตกต่างตามประเภทหวย รูปแบบการแทง และรอบที่เลือก จึงควรยึดข้อมูลล่าสุดบนหน้าส่งโพยเป็นหลัก
      </p>
      <p>
        <strong class="text-[#ffd45e]">หากใช้ข้อความว่า “เรทจ่ายสูงที่สุด” ควรมีข้อมูลเปรียบเทียบกับผู้ให้บริการรายอื่นที่ตรวจสอบได้</strong>
        หากไม่มีข้อมูลดังกล่าว การใช้คำว่า
        <strong class="text-[#ffd45e]">“เรทจ่ายสูง” จะเหมาะสมกว่า</strong>
      </p>
    </div>
  </ContentBoxCyberCut>

  <ContentBoxSevenThreeNeumorphism as="h3" title="2ตัว จ่าย100บาท">
    <p slot="left">
      <strong class="text-[#ffd45e]">สำหรับรายการที่กำหนดอัตรา 2 ตัว จ่าย 100 บาท สมาชิกสามารถเลือกเลขและกำหนดยอดตามวงเงินที่ระบบเปิดรับ</strong>
      ก่อนส่งโพยควรตรวจสอบเลขทั้งสองหลัก ประเภทการเดิมพัน และอัตราจ่ายให้เรียบร้อย
      <strong class="text-[#ffd45e]">เพราะหวยลาว ฮานอย และรัฐบาลไทยอาจกำหนดรายละเอียดของแต่ละรอบแตกต่างกัน</strong>
    </p>
    <Picture
      slot="right"
      src={imgTwoDigit}
      loading="lazy"
      fetchpriority="low"
      widths={[350, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), (max-width: 1399px) calc(30vw - 70px), 350px"
