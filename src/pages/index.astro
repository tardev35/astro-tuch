---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBox from "../components/ContentBox.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import Faq from "../components/Faq3.astro";
import LatestWinners from "../components/LatestWinnersPremium.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// IMAGE ROLES FOR THIS DROP (2026-09-23) — READ BEFORE REUSING THESE IMPORTS.
// Two files are referenced from this page and only two, both slides, both spent
// on a ContentBoxSevenThree* block — which is the family's hard cap of two per
// rebrand, so there is no third SevenThree here:
//   slide1.png — sweet-pink promo banner, WY88 logo above a gold crown, reading
//     "โปรโมชั่น แนะนำเพื่อน" over a giant gold "0.8%", so it belongs to docx
//     H3 #4 (แนะนำเพื่อน โบนัส 0.8%).
//   slide2.png — the same artwork reading "โปรโมชั่น คืนยอดเสีย" over "0.3%",
//     so it belongs to docx H3 #5 (คืนยอดเสีย โบนัส 0.3%).
//
// Deliberately NOT imported, and all still on disk as inventory:
//   banner2.png (หวยพยัคฆ์'s navy lottery poster, 2026-09-22), banner3.png
//   (2026-08-11), slide3.png (2026-09-18), slide4.png (2026-08-13) — every one
//   predates this drop and carries a previous client's artwork. There is
//   therefore NO usable banner2+ this round and NO single-column inline
//   illustration, which is the expected outcome, not a gap to fill with a stale
//   file.
//   banner1.png and banner1-mobile.png belong to MainLayout's own pinned globs
//   and are never referenced from a page — the hero is the LCP element, so
//   nothing here gets loading="eager" fetchpriority="high".
//
// Rotated out of this round's mix and NOT deleted from disk (they are inventory
// for the next brand): Announcement3, ContentBoxNeumorphism,
// ContentBoxFloatingBadge, ContentBoxSpecial, ContentBoxSevenThreeNeumorphism,
// ContentBoxSevenThreeFloatingBadge, ContentBoxTwoNeumorphism, Faq2,
// LatestWinners3 — and LottoGrid, which stays out for a reason rather than a
// rotation: this brief is a casino/live-game brand and never mentions หวย at
// all, so a lottery grid would be inventing a category. The file stays on disk
// for the next lottery client.

// Title and description are the brief's own Title/Description lines, used
// verbatim. A brief-supplied description is never padded up to the 150-char
// floor and never topped up from the H1/H2.
const pageTitle = "WY88 เว็บเล่นพนันอันดับ1ในไทย เข้าเล่นแบบVIP สำหรับยูสไทย";

const pageDescription = "WY88 เว็บเล่นพนันอันดับ1ในไทย ให้ทางเข้าเล่นใหม่ รูปแบบVIP การใช้งานอัปเกรดคุณภาพดีขึ้นกว่าระบบเดิม พร้อมสิทธิสำหรับยูสไทย";

// <Announcement /> runs bare: Announcement5's default message is already this
// brand's copy, and every sub-page calls it bare too — passing an override here
// is how the ticker ends up saying two different things on two pages.

// The docx has a real H1 -> H2 -> H3 hierarchy this round: "แนะนำเพื่อน โบนัส
// 0.8%" and "คืนยอดเสีย 0.3%" are genuine H3 sub-points of the H2 โปรโมชั่น
// section, so the page is NOT flattened to H2-only. They are the only <h3> here
// and they are carried by the two ContentBoxSevenThree* blocks. Everything else
// is chrome — ProviderGrid, LatestWinnersPremium, LoginRtpSection and
// ReviewCardSumo2 all render their titles as <p>/<span> with an aria-label on
// the section, and Faq3's questions stay <p> inside <summary>, so none of them
// emits a heading tag.
//
// The docx checklist, in order, and what carries each one:
//   1 H1  WY88 เว็บเล่นพนันอันดับ1ในไทย …        ContentBoxPremium
//   2 H2  ทางเข้าเล่น WY88 ใหม่ …                ContentBoxCyberCut (+ ProviderGrid)
//   3 H2  โปรโมชั่น WY88 …                       ContentBox
//   4 H3  แนะนำเพื่อน โบนัส 0.8%                 ContentBoxSevenThreePremium  + slide1
//   5 H3  คืนยอดเสีย โบนัส 0.3%                  ContentBoxSevenThreeCyberCut + slide2
//   6 H2  สมัคร WY88 เล่นเว็บพนันออนไลน์ 3 ขั้นตอน ContentBoxTwoPremium
//   7 H2  สอบถามแอดมินคาสิโน WY88 …              ContentBoxTwoCyberCut
//   8 H2  คำถามที่พบบ่อย                          Faq3
// Final inventory for this page: h1 x1, h2 x5, h3 x2.

// One array, used by both <Faq> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last. The three pairs
// are the brief's own Q/A block, verbatim.
const faqs = [
  {
    q: "WY88 มีทางเข้าเล่นแบบ VIP หรือไม่?",
    a: "ตามข้อมูลที่กำหนด WY88 มีทางเข้าเล่นรูปแบบ VIP สำหรับยูสไทย พร้อมการอัปเกรดหน้าระบบและเมนูให้ใช้งานได้สะดวกขึ้น โดยสามารถตรวจสอบรายละเอียดของสิทธิ์และรูปแบบที่เปิดให้ใช้งานได้จากหน้าเว็บไซต์",
  },
  {
    q: "โปรโมชั่น WY88 ต้องฝากก่อนรับหรือไม่?",
    a: "โปรโมชั่นบางรายการสามารถกดรับหลังสมัครได้ตามเงื่อนไขที่กำหนด ส่วนโบนัสอื่นอาจมีข้อกำหนดแตกต่างกัน แนะนำให้ตรวจสอบรายละเอียดของแต่ละโปรโมชั่นก่อนกดรับสิทธิ์ทุกครั้ง",
  },
  {
    q: "หากเข้า WY88 ไม่ได้ควรทำอย่างไร?",
    a: "แนะนำให้ตรวจสอบทางเข้าล่าสุดที่เว็บไซต์ประกาศไว้และเช็กการเชื่อมต่ออินเทอร์เน็ต หากยังพบปัญหา สามารถติดต่อแอดมิน WY88 ได้ตลอด 24 ชั่วโมงเพื่อให้ช่วยตรวจสอบการเข้าใช้งานหรือข้อมูลบัญชี",
  },
];

// The brief's own three registration steps, verbatim, in its own order.
const registerSteps = [
  "เปิดหน้าสมัคร WY88 แล้วกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน",
  "ตรวจสอบข้อมูลและรายละเอียดบัญชีให้ถูกต้องก่อนกดยืนยัน",
  "ยืนยันการสมัครและเข้าสู่ระบบ จากนั้นเลือกสล็อต เกมสด หรือหมวดที่ต้องการได้ทันที",
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// Two highlight colours, matching the logo and the slide artwork: the palette's
// rose highlight (#f9a8cd) marks a claim the brief states outright, and the
// logo gold (#e8b33a) is reserved for the two bonus figures, which is exactly
// how slide1 and slide2 print them.

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb. Every URL in the graph is derived
// by pageGraph from `site:` — no domain is typed out in this file.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxPremium as="h1" title="WY88 เว็บเล่นพนันอันดับ1ในไทย เข้าเล่นเกมสดแบบVIP ได้ทันที">
    <p class="text-left text-base leading-relaxed text-[#fce9f3]">
      WY88
      <strong class="text-[#f9a8cd]">เว็บรวมเกมออนไลน์ที่เน้นทางเข้าเล่นรูปแบบ VIP สำหรับยูสไทย</strong>
      พร้อมปรับหน้าระบบและเมนูให้ใช้งานสะดวกกว่าเดิม รองรับทั้งมือถือและคอมพิวเตอร์
      <strong class="text-[#f9a8cd]">สามารถเลือกเกมสดและหมวดเกมที่สนใจได้จากบัญชีเดียว</strong>
      พร้อมสิทธิ์สำหรับสมาชิกตามเงื่อนไขที่เว็บไซต์กำหนด
    </p>
  </ContentBoxPremium>

  <ContentBoxCyberCut as="h2" title="ทางเข้าเล่น WY88 ใหม่ รูปแบบพิเศษ อัปเกรดคุณภาพดีขึ้นกว่าเดิม">
    <p class="text-left text-base leading-relaxed text-[#fce9f3]">
      ทางเข้าเล่น WY88
      <strong class="text-[#f9a8cd]">เวอร์ชันใหม่ได้รับการปรับรูปแบบให้ทันสมัยขึ้น</strong>
      ทั้งหน้าหลัก เมนูเกม และระบบสมาชิก
      <strong class="text-[#f9a8cd]">ช่วยให้ค้นหาเกมและสลับหมวดได้ง่ายกว่าเดิม</strong>
      พร้อมรูปแบบ VIP ที่จัดองค์ประกอบการใช้งานให้เป็นระเบียบ รองรับยูสไทยที่ต้องการเข้าถึงเกมผ่านมือถือได้อย่างคล่องตัว
    </p>
  </ContentBoxCyberCut>

  <ProviderGrid />

  <ContentBox as="h2" title="โปรโมชั่น WY88 กดรับหลังสมัครได้ต้องฝาก">
    <p class="text-left text-base leading-relaxed text-[#fce9f3]">
      WY88
      <strong class="text-[#f9a8cd]">มีโปรโมชั่นสำหรับสมาชิกใหม่และสมาชิกเดิมให้เลือกตามเงื่อนไขของแต่ละรายการ</strong>
      โดยสิทธิ์บางประเภทสามารถตรวจสอบและกดรับหลังสมัครได้ตามที่ระบบกำหนด
      <strong class="text-[#f9a8cd]">พร้อมโบนัสแนะนำเพื่อนและคืนยอดเสีย</strong>
      ช่วยให้สมาชิกเลือกสิทธิ์ที่เหมาะกับรูปแบบการใช้งานของตัวเองได้ง่ายขึ้น
    </p>
  </ContentBox>

  <ContentBoxSevenThreePremium as="h3" titleright="แนะนำเพื่อน โบนัส 0.8%">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[340, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), 340px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่นพื้นชมพูหวาน ด้านซ้ายเป็นผู้หญิงผมยาวสีเข้มสวมชุดสีชมพูขาวยืนกอดอก ด้านบนเป็นโลโก้ WY88 ตัวอักษร WY สีชมพูและเลข 88 สีทอง ถัดลงมาเป็นข้อความสีขาวขอบชมพูว่า โปรโมชั่น และข้อความว่า แนะนำเพื่อน ใต้มงกุฎทอง ล่างสุดเป็นตัวเลขสีทองขนาดใหญ่ว่า 0.8% รอบภาพมีเหรียญทอง หัวใจสีชมพู และกล่องของขวัญลอยอยู่"
      class="mx-auto h-auto w-full rounded-2xl border border-[#a3145a]/55 shadow-[0_10px_30px_rgba(236,43,132,0.26)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#fce9f3]">
      สมาชิก WY88
      <strong class="text-[#f9a8cd]">ที่แนะนำเพื่อนเข้ามาสมัครสามารถรับโบนัส</strong>
      <strong class="text-[#e8b33a]">0.8%</strong>
      <strong class="text-[#f9a8cd]">ตามเงื่อนไขของโปรโมชั่น</strong>
      โดยระบบมีรายละเอียดให้ตรวจสอบเกี่ยวกับยอดที่เข้าเกณฑ์และรอบรับสิทธิ์ ช่วยให้ติดตามโบนัสจากกิจกรรมแนะนำเพื่อนได้สะดวกผ่านบัญชีสมาชิก
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBoxSevenThreeCyberCut as="h3" titleright="คืนยอดเสีย โบนัส 0.3%">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[340, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), 340px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่นพื้นชมพูหวาน ด้านซ้ายเป็นผู้หญิงผมยาวสีเข้มสวมชุดสีชมพูขาวยืนกอดอก ด้านบนเป็นโลโก้ WY88 ตัวอักษร WY สีชมพูและเลข 88 สีทอง ถัดลงมาเป็นข้อความสีขาวขอบชมพูว่า โปรโมชั่น และข้อความว่า คืนยอดเสีย ใต้มงกุฎทอง ล่างสุดเป็นตัวเลขสีทองขนาดใหญ่ว่า 0.3% รอบภาพมีเหรียญทอง หัวใจสีชมพู และเหรียญมงกุฎลอยอยู่"
      class="mx-auto h-auto w-full rounded-2xl border border-[#a3145a]/55 shadow-[0_10px_30px_rgba(236,43,132,0.26)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#fce9f3]">
      โปรโมชั่นคืนยอดเสียของ WY88
      <strong class="text-[#f9a8cd]">ให้โบนัส</strong>
      <strong class="text-[#e8b33a]">0.3%</strong>
      <strong class="text-[#f9a8cd]">ตามยอดและเงื่อนไขที่ระบบกำหนด</strong>
      สมาชิกสามารถตรวจสอบรอบคำนวณและยอดที่เข้าเกณฑ์ก่อนกดรับได้ ช่วยให้ติดตามสิทธิ์ในแต่ละรอบได้ง่าย และรู้รายละเอียดก่อนนำโบนัสไปใช้งาน
    </p>
  </ContentBoxSevenThreeCyberCut>

  <ContentBoxTwoPremium as="h2" title="สมัคร WY88 เล่นเว็บพนันออนไลน์ 3 ขั้นตอน">
    <p slot="left" class="text-left text-base leading-relaxed text-[#fce9f3]">
      การสมัคร WY88
      <strong class="text-[#f9a8cd]">สามารถทำผ่านหน้าเว็บไซต์ได้ด้วยตัวเอง</strong>
      ใช้ขั้นตอนไม่ซับซ้อน และหลังยืนยันบัญชีเรียบร้อยสามารถเข้าสู่ระบบเพื่อเลือกเกมสล็อตหรือเกมสดที่ต้องการได้ทันที โดยมี 3 ขั้นตอนหลักดังนี้
    </p>
    <ol slot="right" class="list-decimal space-y-3 pl-6 text-left text-base leading-relaxed text-[#fce9f3] marker:font-black marker:text-[#e8b33a]">
      {registerSteps.map((step) => <li>{step}</li>)}
    </ol>
  </ContentBoxTwoPremium>

  <ContentBoxTwoCyberCut as="h2" title="สอบถามแอดมินคาสิโน WY88 ได้ตลอด 24 ชั่วโมง">
    <p slot="left" class="text-left text-base leading-relaxed text-[#fce9f3]">
      หากมีข้อสงสัยเกี่ยวกับการสมัคร ทางเข้า VIP โปรโมชั่น เกมสด หรือการใช้งานบัญชี
      <strong class="text-[#f9a8cd]">สามารถติดต่อแอดมินคาสิโน WY88 ได้ตลอด 24 ชั่วโมง</strong>
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#fce9f3]">
      <strong class="text-[#f9a8cd]">ทีมงานพร้อมช่วยตรวจสอบข้อมูลและแนะนำขั้นตอนตามปัญหาที่แจ้ง</strong>
      เพื่อให้สมาชิกใหม่และสมาชิกเดิมเข้าถึงข้อมูลที่ต้องการได้สะดวกทุกช่วงเวลา
    </p>
  </ContentBoxTwoCyberCut>

  <Faq as="h2" title="คำถามที่พบบ่อย" faqs={faqs} />

  <LatestWinners />

  <LoginRtpSection />

  <ReviewCardSumo />

  <Navfoot />
</MainLayout>
