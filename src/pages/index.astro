---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement5 from "../components/Announcement5.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBox from "../components/ContentBox.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import Faq4 from "../components/Faq4.astro";
import LatestWinners2 from "../components/LatestWinners2.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// Title and description are the brief's own Title/Description lines, verbatim.
// A brief-supplied description ships at whatever length it was written — it is
// not padded up to the 150-character floor.
const pageTitle = "JAIDEE928 คาสิโนใจดีเว็บแท้ โบนัสจัดเต็ม ฝากถอนไม่มีขั้นต่ำ";

const pageDescription =
  "JAIDEE928 คาสิโนใจดีเว็บแท้ รวมเกมมาตรฐาน โบนัสแนะนำสูง จัดให้เต็มสูบ ไม่จำกัดยอดฝากถอน ให้บริการเกมเดิมพันครบวงจร";

// The ticker copy is passed explicitly rather than relying on the component's
// default — every Announcement* variant's default belongs to whichever brand
// wired it in last. No emoji in this string: an emoji baked into a text prop
// cannot be given its own aria-hidden span.
const announcement =
  "JAIDEE928 คาสิโนใจดีเว็บแท้ การันตีความปลอดภัย เชื่อได้ 100% รวมบาคาร่า รูเล็ต เสือมังกร แบล็กแจ็ก คาสิโนสด และสล็อตไว้ในบัญชีเดียว • โบนัสแนะนำเพื่อนสูงสุด 0.8% คืนยอดเสียสูงสุด 0.3% ตามเงื่อนไขของแต่ละโปรโมชั่น • เดิมพันไม่มีขั้นต่ำ ไม่จำกัดยอดฝาก ระบบฝากถอนอัตโนมัติทำรายการเองได้ตลอด 24 ชั่วโมง • แอดมิน JAIDEE928 พร้อมช่วยตรวจสอบรายการทุกวัน";

// The brief's "เริ่มต้นง่ายเพียง 3 ขั้นตอน" sub-points. Each title is the brief's
// line verbatim, because FeatureHighlights renders them as the only <h3> tier on
// the page and a heading may only carry docx text.
const steps = [
  {
    icon: "📝",
    title: "สมัครสมาชิก JAIDEE928 และกรอกข้อมูลตามที่ระบบกำหนด",
    accent: "gold" as const,
  },
  {
    icon: "💳",
    title: "Login เข้าสู่บัญชีและทำรายการฝากเครดิตผ่านระบบอัตโนมัติ",
    accent: "silver" as const,
  },
  {
    icon: "🎁",
    title: "ตรวจสอบโปรโมชั่น เลือกเกมคาสิโนที่ต้องการ และศึกษากติกาก่อนเดิมพัน",
    accent: "gold" as const,
  },
];

// One array, used by both <Faq4> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last.
const faqs = [
  {
    q: "JAIDEE928 มีเกมคาสิโนประเภทไหนให้เลือกเล่น?",
    a: "ระบบมีเกมหลากหลายหมวดหมู่ เช่น บาคาร่า คาสิโนสด รูเล็ต เสือมังกร แบล็กแจ็ก สล็อต และเกมเดิมพันอื่น ๆ โดยสมาชิกสามารถตรวจสอบรายชื่อเกมที่เปิดให้บริการล่าสุดได้จากหน้าเกมภายในบัญชี",
  },
  {
    q: "โบนัสแนะนำ JAIDEE928 รับอย่างไร?",
    a: "สมาชิกสามารถนำลิงก์แนะนำของตนเองไปแชร์ให้เพื่อน เมื่อรายการตรงตามข้อกำหนด ระบบจะคำนวณโบนัสตามเงื่อนไขของโปรโมชั่น แนะนำให้ตรวจสอบเปอร์เซ็นต์ รอบคำนวณ และเงื่อนไขการถอนก่อนกดรับทุกครั้ง",
  },
  {
    q: "JAIDEE928 ฝากถอนมีขั้นต่ำหรือไม่?",
    a: "วงเงินฝากถอนขึ้นอยู่กับช่องทางและข้อกำหนดที่เปิดให้บริการในขณะทำรายการ สมาชิกควรตรวจสอบยอดขั้นต่ำและสูงสุดที่แสดงในหน้าฝากถอนก่อนยืนยัน หากพบปัญหาสามารถติดต่อแอดมินให้ช่วยตรวจสอบได้ตลอด 24 ชั่วโมง",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement5 message={announcement} />

  <SmoothCarousel />

  <ContentBoxFloatingBadge as="h1" title="JAIDEE928 คาสิโนใจดีเว็บแท้ การันตีความปลอดภัย เชื่อได้ 100%">
    <p class="text-left text-base leading-relaxed text-[#dce9ff]">
      <strong class="text-[#7db4ff]">JAIDEE928</strong> พร้อมให้บริการสมาชิกที่ต้องการเล่นคาสิโนออนไลน์ผ่านมือถือและคอมพิวเตอร์ รวมเกมเดิมพันหลากหลายประเภทไว้ในระบบเดียว พร้อมโปรโมชั่นและโบนัสแนะนำตามเงื่อนไข
      ระบบฝากถอนอัตโนมัติช่วยให้ทำรายการได้ด้วยตนเองตลอด 24 ชั่วโมง รองรับการใช้งานที่สะดวกตั้งแต่สมัครสมาชิก เลือกเกม ฝากถอน ไปจนถึงการติดต่อแอดมินเมื่อพบปัญหาระหว่างใช้งาน
    </p>
  </ContentBoxFloatingBadge>

  <ContentBox as="h2" title="รวมเกมคาสิโน JAIDEE928 แหล่งเดิมพัน มาตรฐานเกมชั้นนำ">
    <p class="text-left text-base leading-relaxed text-[#dce9ff]">
      JAIDEE928 รวบรวมเกมคาสิโนออนไลน์หลากหลายหมวดหมู่ให้เลือกผ่านบัญชีเดียว ทั้งบาคาร่า รูเล็ต เสือมังกร แบล็กแจ็ก คาสิโนสด สล็อต และเกมเดิมพันประเภทอื่น ๆ รองรับการเข้าเล่นผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์
      พร้อมจัดหมวดหมู่ให้ค้นหาเกมได้ง่าย ก่อนเดิมพันสมาชิกสามารถตรวจสอบกติกา อัตราจ่าย และรายละเอียดของแต่ละเกมได้จากระบบ
    </p>
  </ContentBox>

  <ProviderGrid />

  <ContentBoxSevenThreeNeumorphism title="โปรโมชั่น JAIDEE928 โบนัสแนะนำจัดเต็มสูบ">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นพื้นหลังสีน้ำเงินเข้ม ด้านบนเป็นโลโก้ JAIDEE928 ตัวอักษรโครมสีน้ำเงินตัดเงิน ใต้โลโก้เขียนว่า คาสิโนออนไลน์ อันดับ 1 มั่นคง ปลอดภัย จ่ายจริง ตรงกลางเป็นข้อความ โปรโมชั่น แนะนำเพื่อน รับโบนัส และตัวเลข 0.8% ขนาดใหญ่ หญิงสาวสวมชุดสีน้ำเงินเงินยืนชี้นิ้วไปทางซ้ายของภาพ รอบตัวมีชิปคาสิโนสีน้ำเงินสลักเลข 928 ไพ่เอซ และวงล้อสล็อต แถบด้านล่างเขียนว่า ปลอดภัย มั่นคง ฝาก-ถอน ออโต้ และ บริการ 24 ชม."
      class="mx-auto h-auto w-full rounded-2xl border border-[#0e6efb]/45 shadow-[0_10px_30px_rgba(14,110,251,0.22)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#dce9ff]">
      สมาชิกสามารถติดตามโปรโมชั่น JAIDEE928 ที่เปิดให้รับได้อย่างต่อเนื่อง โดยเฉพาะโบนัสแนะนำเพื่อนสำหรับสมาชิกที่แชร์ลิงก์แนะนำและมียอดตรงตามเงื่อนไข ระบบจะแสดงรายละเอียดเกี่ยวกับเปอร์เซ็นต์โบนัส วิธีคำนวณ รอบการรับ
      และข้อกำหนดต่าง ๆ ให้ตรวจสอบก่อนกดรับสิทธิ์ เพื่อให้สมาชิกทราบข้อมูลของโปรโมชั่นอย่างชัดเจนก่อนเข้าร่วม
    </p>
  </ContentBoxSevenThreeNeumorphism>

  <ContentBoxSevenThree title="สมัครเล่น JAIDEE928 เดิมพันไม่มีขั้นต่ำ ไม่จำกัดยอดฝาก">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นพื้นหลังสีน้ำเงินเข้ม ด้านบนเป็นโลโก้ JAIDEE928 ตัวอักษรโครมสีน้ำเงินตัดเงิน ถัดลงมาเป็นข้อความ โปรโมชั่น คืนยอดเสีย รับโบนัส และตัวเลข 0.3% ขนาดใหญ่ หญิงสาวสวมชุดสีน้ำเงินยืนแบมือทางขวาของภาพ ข้างหลังเป็นตู้เกมที่ขึ้นคำว่า JACKPOT รอบตัวมีไพ่เอซและชิปคาสิโนสีน้ำเงิน แถบด้านล่างเขียนว่า มั่นคง ปลอดภัย คืนยอดเสียทุกวัน และ บริการตลอด 24 ชม."
      class="mx-auto h-auto w-full rounded-2xl border border-[#0e6efb]/45 shadow-[0_10px_30px_rgba(14,110,251,0.22)]"
    />
    <div slot="right" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dce9ff]">
        เริ่มต้นใช้งาน JAIDEE928 ผ่านมือถือได้ง่าย โดยสมาชิกสามารถสมัครและจัดการบัญชีผ่านหน้าเว็บไซต์ หลังเปิดบัญชีเรียบร้อยแล้วสามารถตรวจสอบช่องทางฝากถอน วงเงิน และข้อกำหนดล่าสุดที่ระบบรองรับได้โดยตรง
      </p>
      <p class="text-left text-base leading-relaxed font-bold text-[#7db4ff]">เริ่มต้นง่ายเพียง 3 ขั้นตอน</p>
      <FeatureHighlights items={steps} />
      <p class="text-left text-base leading-relaxed text-[#dce9ff]">สำหรับยอดฝากขั้นต่ำ ยอดถอน และวงเงินต่อรายการ ควรยึดข้อมูลที่แสดงในระบบ ณ เวลาทำธุรกรรมเป็นหลัก</p>
    </div>
  </ContentBoxSevenThree>

  <ContentBoxTwoCyberCut as="h2" title="เว็บ JAIDEE928 บริการเกมเดิมพันครบวงจร">
    <p slot="left" class="text-left text-base leading-relaxed text-[#dce9ff]">
      สมาชิกสามารถใช้งานบริการต่าง ๆ ผ่านบัญชีเดียว ตั้งแต่เลือกเกมคาสิโน ตรวจสอบเครดิต รับโปรโมชั่น ฝากถอน และติดตามประวัติรายการ หากพบปัญหาเกี่ยวกับการ Login เครดิตไม่เข้า ถอนเงินล่าช้า โบนัสไม่แสดง
      หรือการใช้งานเกม สามารถติดต่อแอดมิน JAIDEE928 ได้ตลอด 24 ชั่วโมง เพื่อให้ทีมงานช่วยตรวจสอบและแนะนำขั้นตอนดำเนินการต่อ
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#dce9ff]">
      การพนันมีความเสี่ยงและไม่มีเกมหรือโปรโมชั่นใดรับประกันผลกำไร สมาชิกควรกำหนดงบประมาณและศึกษากติกาก่อนเดิมพันทุกครั้ง
    </p>
  </ContentBoxTwoCyberCut>

  <Faq4 title="คำถามที่พบบ่อยเกี่ยวกับ JAIDEE928" faqs={faqs} />

  <LatestWinners2 />

  <LoginRtpSection />

  <ReviewCardSumo2 />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#a9ccff] via-[#0e6efb] to-[#062d94] px-4 py-3 text-sm font-black whitespace-nowrap text-[#01050f] shadow-[0_10px_30px_rgba(14,110,251,0.28)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(14,110,251,0.42)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#0e6efb]/50 bg-gradient-to-r from-[#040e22] to-[#01050f] px-4 py-3 text-sm font-black whitespace-nowrap text-[#7db4ff] shadow-[0_10px_30px_rgba(14,110,251,0.16)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#a9ccff]/70 hover:text-[#e6e8ec] hover:shadow-[0_15px_40px_rgba(230,232,236,0.28)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>
  </div>

  <Navfoot />
</MainLayout>
