---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import LatestWinners from "../components/LatestWinners3.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import Faq from "../components/Faq4.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgTwoDigit from "../assets/slide1.png";
import imgThreeDigit from "../assets/slide2.png";

// VARIANT ROTATION THIS ROUND (BRAVO168 -> หวยเต็ง). Zero file reuse from the
// previous round: Announcement3 replaces AnnouncementPremium, LatestWinners3
// replaces LatestWinnersPremium, Faq4 replaces Faq2, ReviewCardSumo replaces
// ReviewCardSumo2, and the ContentBox shape-mix moves off Premium / TwoPremium /
// FloatingBadge / TwoFloatingBadge / SevenThreeFloatingBadge / SevenThreePremium
// onto CyberCut / TwoNeumorphism / SevenThreeCyberCut / SevenThreeNeumorphism /
// TwoCyberCut / plain ContentBox. NavbarStyle9 and FooterStyle2 are the layout's
// pair this round (previously NavbarPremium / FooterPremium).
// Every Premium / FloatingBadge / Huay / Cyber file, Faq2, AnnouncementPremium,
// LatestWinnersPremium and ReviewCardSumo2 stay on disk as inventory for the next
// brand — none of them was deleted. The *Huay family is deliberately NOT used
// here even though this is a lottery brand: it belongs to /ตรวจหวย and /แนวทาง,
// which keep their own red-gold theme.
//
// <Announcement /> runs bare on purpose: Announcement3's default message is
// already this brand's copy and every sub-page calls it bare too, so passing an
// override here is exactly how the ticker ends up saying two different things on
// two pages of the same site.
//
// IMAGE ROLES FOR THIS DROP (2026-10-01). Two files are referenced from this page
// and only two, and the pairing is read off the artwork itself, not off the file
// number:
//   slide1.png — the green pill under the headline reads "2ตัวจ่าย100บาท" and she
//     holds a green ball marked 6, so it belongs to docx H3 #4. Imported as
//     imgTwoDigit.
//   slide2.png — the pill reads "3ตัวจ่าย1,000บาท" and the ball is marked 3, so it
//     belongs to docx H3 #5. Imported as imgThreeDigit.
// Both files measure 600x351, so 600 is the top real candidate width — nothing
// above it would be a real pixel — and each picture carries max-w-[600px] so the
// art is never upscaled past its own bitmap. Each slide sits in a
// ContentBoxSevenThree* image+text block, which is that family's hard cap of two
// per rebrand, so there is no third SevenThree anywhere on the site.
// The two blocks mirror each other: SevenThreeCyberCut lays out
// md:grid-cols-[3fr_7fr] so its picture goes in slot="left", SevenThreeNeumorphism
// lays out md:grid-cols-[7fr_3fr] so its picture goes in slot="right". The two
// pictures therefore alternate sides instead of stacking down the same edge, and
// each `sizes` describes its own 3fr column rather than the viewport.
//
// The alt text was written from THIS drop's artwork (a deep-green ground with gold
// light rays, a bank of gold coins, green-and-white numbered lottery balls, Thai
// lottery tickets, a long-haired woman in white holding a green ball, the
// green-and-gold หวยเต็ง wordmark and huge gold Thai type reading อัตราจ่ายหวย).
//
// Deliberately NOT imported, and every file still on disk:
//   slide3.png / slide4.png / banner2.png / banner3.png all predate this drop and
//   belong to previous brands — importing any of them would emit a competitor's
//   artwork into dist/, so there is no inline article illustration this round.
//   banner1.png and banner1-mobile.png belong to MainLayout's own pinned globs and
//   are never referenced from a page — the hero is the LCP element, so nothing here
//   gets loading="eager" fetchpriority="high". og.png is the same: MainLayout owns it.
//
// Vocabulary: หวยเต็ง is a เว็บแทงหวยออนไลน์ — หวย, โพย, ส่งโพย, เลข 2 ตัว / 3 ตัว,
// อัตราจ่าย, รอบ/เวลาปิดรับ, งวด, ผลรางวัล, หวยรัฐบาลไทย, ลาวพัฒนา, ฮานอย (ปกติ /
// พิเศษ / วีไอพี), หวยหุ้นต่างประเทศ. The outgoing brand sold football and the one
// before it sold slots; every one of those words (บอล, ค่าน้ำ, อัตราต่อรอง, ลีก, บิล,
// สล็อต, ฟรีสปิน, RTP …) is gone, and the page was rewritten from the brief rather
// than find-and-replaced over the old sentences. Nothing here claims a licence, an
// operator, a bank, a deposit minimum, a member count or a founding year, because
// the brief names none. The only figures are the brief's own: 2 ตัว จ่าย 100 บาท,
// 3 ตัว จ่าย 1,000 บาท, 3 ขั้นตอน, 24 ชั่วโมง. The brief's own hedging ships with
// the copy ("ควรยึดข้อมูลที่แสดงในหน้าส่งโพยของแต่ละรอบเป็นหลัก") — it is part of
// the paragraphs, not trimmed as downbeat.
//
// Title and description are the brief's own Title/Description lines, used verbatim.
// The description ships at 126 characters, the length the brief wrote it — it is
// not padded up to 150.
const pageTitle = "หวยเต็ง เว็บแทงหวยออนไลน์อันดับ1 มีหวยครบ รัฐบาลไทย ลาว ฮานอย หุ้น";

const pageDescription = "หวยเต็ง เว็บแทงหวยออนไลน์อันดับ1 มีหวยให้เลือกเล่นครบ ทั้งหวย รัฐบาลไทย ลาวพัฒนาย ฮานอยพิเศษ ปกติ วีไอพี หวยหุ้นต่างประเทศ";

// The brief has a real H2 -> H3 nesting this round, so the page is NOT flattened to
// H2-only. The two H3s are genuine headings — the two payout sub-points, both
// nested under the อัตราการจ่าย H2 — and they stay H3.
//
// The checklist, in document order, and what carries each one:
//    1 H1  หวยเต็ง เว็บแทงหวยออนไลน์อันดับ1 มีหวยครบ รัฐบาล ลาว ฮานอย หุ้น
//          ContentBoxCyberCut, L4 + L5
//    2 H2  หวยเต็ง รับแทง รัฐบาลไทย ลาวพัฒนา ฮานอยพิเศษ ปกติ วีไอพี หวยหุ้นต่างประเทศ
//          ContentBoxTwoNeumorphism, L7 left + L8 right
//    3 H2  อัตราการจ่าย หวยเต็ง 2ตัว จ่าย100บาท 3ตัว จ่าย1,000บาท
//          ContentBox, L10 + L11
//    4 H3  2ตัว จ่าย100บาท
//          ContentBoxSevenThreeCyberCut + slide1 (imgTwoDigit), L13
//    5 H3  3ตัว จ่าย1,000บาท
//          ContentBoxSevenThreeNeumorphism + slide2 (imgThreeDigit), L15
//    6 H2  สมัครแทงหวย หวยเต็ง ง่ายๆ 3ขั้นตอน
//          ContentBoxTwoCyberCut, L17 left + L18 right
//    7 H2  ติดต่อแอดมินเว็บ หวยเต็ง ผู้ให้บริการเกี่ยวกับการแทงหวย 24 ชั่วโมง
//          ContentBox + LINE / สมัคร buttons, L20 + L21
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ หวยเต็ง
//          Faq4 + faqs prop
// Final inventory for this page: h1 x1, h2 x5, h3 x2.
//
// Every brief paragraph ships in full. Sections 1, 2, 3, 6 and 7 each have TWO
// paragraphs and both ship, nothing merged or summarised: in the two-column blocks
// they run one per column, in the single-column blocks they stack inside one
// wrapper div. The column labels passed to the two-column boxes are this page's own
// layout wording, not brief headings, and both of those variants render them as <p>.
//
// Everything else on the page is chrome and emits no heading tag at any level:
// Announcement3, LatestWinners3, LoginRtpSection and ReviewCardSumo render their
// titles as <p>/<span> with an aria-label on the section, and Faq4's questions live
// inside <summary> as <span>. The non-brief widgets sit before section 1
// (LatestWinners3, right after the ticker) and after section 8 (LoginRtpSection,
// ReviewCardSumo, Navfoot) — never spliced between two content sections.

// One array, used by both <Faq> and the FAQPage node — never the component's own
// defaults, which belong to whichever brand shipped last. The three pairs are the
// brief's own Q/A block, verbatim.
const faqs = [
  {
    q: "หวยเต็ง มีหวยประเภทไหนเปิดให้แทงบ้าง?",
    a: "มีทั้งรัฐบาลไทย ลาวพัฒนา ฮานอยปกติ ฮานอยพิเศษ ฮานอยวีไอพี และหวยหุ้นต่างประเทศตามรายการที่ระบบเปิดรับในแต่ละวัน ควรตรวจสอบตารางและเวลาปิดรับก่อนส่งโพยทุกครั้ง",
  },
  {
    q: "หวยเต็ง 2 ตัวจ่าย 100 และ 3 ตัวจ่าย 1,000 ใช้กับทุกหวยหรือไม่?",
    a: "อัตราจ่ายขึ้นอยู่กับประเภทหวยและรูปแบบการเดิมพันที่ร่วมเงื่อนไข จึงควรตรวจสอบอัตราที่แสดงในหน้าส่งโพยก่อนยืนยัน ไม่ควรถือว่าอัตรา 2 ตัว 100 และ 3 ตัว 1,000 ใช้เหมือนกันทุกประเภท",
  },
  {
    q: "สมัคร หวยเต็ง ผ่านมือถือได้หรือไม่?",
    a: "หากเว็บไซต์รองรับการใช้งานผ่านเว็บเบราว์เซอร์ สามารถสมัคร Login เลือกรายการหวย และส่งโพยผ่านมือถือได้โดยตรง หลังสมัครควรตรวจสอบข้อมูลบัญชีและตั้งรหัสผ่านให้ปลอดภัยก่อนเริ่มใช้งาน",
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space that
// splits the word — the copy must read identically with the tags removed. One
// highlight colour only: #fae474, the wordmark's light gold, against the inherited
// body colour #d8ead9 (BRAND_TEXT). The paragraphs below carry no colour class of
// their own: every ContentBox* card in this mix already sets
// `text-left text-base leading-relaxed text-[#d8ead9]` on the element holding the
// slot, so the prose inherits it and no page-level override can drift from the card.

// No breadcrumb: this is the homepage, so a trail from the root to itself would be a
// single self-referential crumb. Every URL in the graph is derived by pageGraph from
// `site:` — no domain is typed out in this file, and no Review / AggregateRating /
// sameAs / address node is passed.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <LatestWinners />

  <ContentBoxCyberCut as="h1" title="หวยเต็ง เว็บแทงหวยออนไลน์อันดับ1 มีหวยครบ รัฐบาล ลาว ฮานอย หุ้น">
    <div class="flex flex-col gap-5">
      <p>
        หวยเต็ง
        <strong class="text-[#fae474]">เว็บแทงหวยออนไลน์ที่รวบรวมรายการหวยยอดนิยมไว้ให้เลือกผ่านบัญชีเดียว</strong>
        มีทั้งรัฐบาลไทย ลาวพัฒนา ฮานอย และหวยหุ้นต่างประเทศ
        <strong class="text-[#fae474]">รองรับการเข้าใช้งานผ่านมือถือโดยไม่ต้องสลับหลายเว็บไซต์</strong>
        สมาชิกสามารถเลือกเลข ส่งโพย ตรวจสอบรายการ อัตราจ่าย และผลหวยตามรอบที่เปิดให้บริการได้จากระบบเดียว เหมาะกับผู้ที่ต้องการติดตามหวยหลายประเภทและหลายรอบในแต่ละวันได้สะดวกมากขึ้น
      </p>
      <p>
        สำหรับคำว่า “เว็บแทงหวยออนไลน์อันดับ 1” หากนำมาใช้เป็นจุดขายหลัก
        <strong class="text-[#fae474]">ควรมีเกณฑ์หรือข้อมูลที่สามารถตรวจสอบได้รองรับ</strong>
      </p>
    </div>
  </ContentBoxCyberCut>

  <ContentBoxTwoNeumorphism
    as="h2"
    title="หวยเต็ง รับแทง รัฐบาลไทย ลาวพัฒนา ฮานอยพิเศษ ปกติ วีไอพี หวยหุ้นต่างประเทศ"
    titleleft="ประเภทหวยที่เปิดรับ"
    titleright="ข้อควรตรวจก่อนส่งโพย">
    <p slot="left">
      หวยเต็ง
      <strong class="text-[#fae474]">รวมรายการหวยหลายประเภทให้สมาชิกเลือกแทงตามรอบที่สนใจ</strong>
      เริ่มจากหวยรัฐบาลไทยตามกำหนดออกรางวัล หวยลาวพัฒนา ไปจนถึงหวยฮานอยที่มีทั้งรอบปกติ ฮานอยพิเศษ และฮานอยวีไอพี รวมถึงหวยหุ้นต่างประเทศตามตลาดและรอบเวลาที่ระบบเปิดรับ
      <strong class="text-[#fae474]">ช่วยให้เลือกประเภทหวยได้ครบจากบัญชีเดียว</strong>
    </p>
    <p slot="right">
      ก่อนส่งโพยควรตรวจสอบชื่อรายการ เลขที่เลือก ยอดเดิมพัน เวลาปิดรับ และอัตราจ่ายของรอบนั้นให้เรียบร้อย
      <strong class="text-[#fae474]">เนื่องจากหวยแต่ละประเภทมีตารางเวลาและเงื่อนไขแตกต่างกัน</strong>
      <strong class="text-[#fae474]">เมื่อประกาศผลแล้วสามารถกลับมาตรวจสอบโพยและผลรางวัลตามรายการที่เลือกไว้ได้</strong>
    </p>
  </ContentBoxTwoNeumorphism>

  <ContentBox as="h2" title="อัตราการจ่าย หวยเต็ง 2ตัว จ่าย100บาท 3ตัว จ่าย1,000บาท">
    <div class="flex flex-col gap-5">
      <p>
        หวยเต็ง กำหนดอัตราจ่ายสำหรับรายการที่ร่วมเงื่อนไข โดยมีตัวเลือก
        <strong class="text-[#fae474]">2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท</strong>
        ตามประเภทหวยและรูปแบบการเดิมพันที่ระบบกำหนด
        <strong class="text-[#fae474]">สมาชิกสามารถตรวจสอบอัตราจ่ายล่าสุดได้ก่อนส่งโพย</strong>
        เพื่อให้ทราบรายละเอียดของรายการและจำนวนเงินที่ใช้คำนวณอย่างชัดเจน
      </p>
      <p>
        อัตราดังกล่าวไม่ควรถือว่าใช้กับหวยทุกประเภทโดยอัตโนมัติ เพราะรัฐบาลไทย ลาวพัฒนา ฮานอย และหวยหุ้นอาจมีอัตราหรือเงื่อนไขแตกต่างกัน
        <strong class="text-[#fae474]">ควรยึดข้อมูลที่แสดงในหน้าส่งโพยของแต่ละรอบเป็นหลัก</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBoxSevenThreeCyberCut as="h3" title="2ตัว จ่าย100บาท">
    <Picture
      slot="left"
      src={imgTwoDigit}
      loading="lazy"
      fetchpriority="low"
      widths={[355, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), (max-width: 1311px) calc(30vw - 38px), 355px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์อัตราจ่ายหวยของ หวยเต็ง พื้นเขียวเข้มมีริ้วแสงทองพาดเฉียง กองเหรียญทองเรียงเต็มด้านล่าง ลูกหวยสีเขียวและสีขาวติดหมายเลขลอยอยู่รอบภาพ และสลากกินแบ่งวางซ้อนกันอยู่สองข้าง ด้านซ้ายเป็นหญิงสาวผมยาวสวมชุดขาวถือลูกหวยสีเขียวหมายเลข 6 ไว้ข้างแก้มและยื่นอีกมือออกมาข้างหน้า ด้านบนเป็นโลโก้ หวยเต็ง สีเขียวคู่ทอง ถัดลงมาเป็นตัวอักษรไทยสีทองขนาดใหญ่ว่า อัตราจ่ายหวย และใต้ลงไปเป็นป้ายสีเขียวขอบทองคาดข้อความ 2ตัวจ่าย100บาท"
      class="mx-auto h-auto w-full max-w-[600px] rounded-2xl border border-[#e5c04f]/60 shadow-[0_10px_30px_rgba(229,192,79,0.22)]"
    />
    <p slot="right">
      สำหรับรายการที่กำหนดอัตรา 2 ตัว จ่าย 100 บาท
      <strong class="text-[#fae474]">สมาชิกสามารถเลือกเลขตามรูปแบบที่ระบบเปิดรับและตรวจสอบยอดก่อนยืนยันโพย</strong>
      ควรดูให้ชัดเจนว่าอัตราดังกล่าวใช้กับหวยประเภทใดและรูปแบบ 2 ตัวรายการใด
      <strong class="text-[#fae474]">เพื่อป้องกันความเข้าใจคลาดเคลื่อนเมื่อตรวจผลและคำนวณรางวัล</strong>
    </p>
  </ContentBoxSevenThreeCyberCut>

  <ContentBoxSevenThreeNeumorphism as="h3" title="3ตัว จ่าย1,000บาท">
    <p slot="left">
      รายการที่กำหนดอัตรา 3 ตัว จ่าย 1,000 บาท
      <strong class="text-[#fae474]">ควรตรวจสอบรายละเอียดจากหน้าส่งโพยก่อนยืนยันทุกครั้ง</strong>
      โดยเฉพาะประเภทของเลข 3 ตัวและหวยที่ร่วมอัตรานี้
      <strong class="text-[#fae474]">เนื่องจากรูปแบบการเดิมพันแต่ละรายการอาจมีหลักเกณฑ์และอัตราจ่ายแตกต่างกัน</strong>
    </p>
    <Picture
      slot="right"
      src={imgThreeDigit}
      loading="lazy"
      fetchpriority="low"
      widths={[391, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), (max-width: 1431px) calc(30vw - 38px), 391px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
