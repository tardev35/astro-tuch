---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import LatestWinners from "../components/LatestWinners2.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBox3ThreeCyberCut from "../components/ContentBox3ThreeCyberCut.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import Faq from "../components/Faq3.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import { pageGraph } from "../lib/schema";
import promoCashback from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";

// การหมุน variant รอบนี้ตัดสินไว้แล้วใน .claude/brand-spec-slot168.md §3 —
// ห้ามเลือกใหม่ที่นี่ แบรนด์ขาออก (รวย168) ถูกหมุนออกจากทุกตระกูลพร้อมกัน:
// Announcement5 แทน AnnouncementHuay · LatestWinners2 แทน LatestWinnersHuay ·
// Faq3 แทน FaqHuay · ReviewCardSumo2 แทน ReviewCardSumo · และ shape-mix ของ
// ContentBox ทิ้ง Huay / TwoHuay / Neumorphism / 3ThreeHuay / SevenThreeHuay /
// SevenThreeNeumorphism / FloatingBadge / TwoNeumorphism ไปใช้ Premium /
// TwoPremium / 3ThreeCyberCut / SevenThreePremium / SevenThreeCyberCut /
// Special / CyberCut แทน — **ไม่ทับไฟล์เดิมแม้แต่ตัวเดียว**
// Navbar/Footer อยู่ที่ MainLayout (NavbarHuay -> NavbarStyle11, FooterHuay ->
// Footer ตัวฐาน) ไม่ใช่ที่ไฟล์นี้
// ⚠️ รอบนี้ **กลับทิศจากรอบก่อน**: รวย168 เป็นเว็บหวย รอบนี้เป็น **เว็บสล็อต**
// คำว่า "สล็อต / เกมสล็อต / เว็บสล็อต" จึงใช้ได้ ส่วนคำหมวดหวยทั้งหมดห้ามมี
//
// พาเลตรอบนี้ (brand-spec §2 ล็อกค่าไว้แล้ว ห้ามเดาเพิ่ม): พื้นเพจ #140000
// ดำอมแดงเข้มมาก (bg.json) · ผิวจม #0b0000 · การ์ด #1c0607 · ผิวยก #2a0c0d ·
// เส้น #551c1e · หมึก #f0e6e4 · **แดงเจลมันวาวเป็นฮิวนำ #fb2e33 / #cb0b0d /
// #8a0608** · แผ่นถม CTA #d81115 → #b00d11 · **มุกอุ่น (R>G>B) เป็นวัสดุที่สอง
// #e3d6d4 / #c9b9b7 / #7d6f6e** · หมึกรอง #c9b9b7
// ⚠️ #cb0b0d (3.5:1) #8a0608 #7d6f6e #551c1e **ห้ามถือตัวอักษร** — ไฮไลต์ใน
// ย่อหน้าทั้งหมดจึงเป็น **#fb2e33 ตัวเดียว** (5.1:1 บนผิวการ์ด · 5.5:1 บนผิวจม)
// ⚠️⚠️ **ขาวบน #fb2e33 ได้แค่ 3.8:1** — ทุกพื้นถมแดงสว่างในหน้านี้ถือหมึกดำ
// #0a0a0a (5.2:1) ส่วนพื้นถมที่รับหมึกขาวต้องเป็น #d81115 ลงไป
// ⚠️⚠️ **รอบนี้ไม่มีทองเป็นสี UI เลยสักเฉด** — มงกุฎทองเล็กในโลโก้เป็นรายละเอียด
// ~2% ของอาร์ตเวิร์ก และ **ทองคือฮิวนำของ รวย168 แบรนด์ขาออกพอดี** การเหลือทอง
// ไว้ = หลงเหลือข้ามแบรนด์ตรงตัว · ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง ไม่มีเขียว
// (ยกเว้นเขียว success ของฟีดถอนเงิน) ไม่มีส้ม ไม่มีครีม/เบจ และไม่มีแรมป์เทาเงินเย็น
// ย่อหน้าในไฟล์นี้ไม่ถือคลาสสีของตัวเอง — ทุก ContentBox* ในมิกซ์นี้ตั้ง
// `text-left text-base leading-relaxed text-[#f0e6e4]` ไว้บน element ที่ถือ slot
// อยู่แล้ว และไม่มี `<p>` ไหนมี mx-auto / max-w-* (การ์ดคุมความกว้างเองแล้ว)
//
// ชื่อแบรนด์ไม่พิมพ์ตรง ๆ ในไฟล์นี้เลย — interpolate จาก ${BRAND_NAME} ทุกจุด
// รวมถึงใน alt ของสองสไลด์ ไม่มีโดเมนเขียนไว้ที่ไหน และไม่มี URL ที่ต่อด้วย `+`
// ⚠️ **ห้ามเขียน "SLOT168" / "slot168" ตัวละตินที่ไหนทั้งสิ้น** — แบรนด์รอบนี้
// เป็นภาษาไทยล้วน
//
// <strong> ทุกตัวคร่อม "ก้อนที่คั่นด้วยช่องว่าง" ทั้งก้อน เพราะภาษาไทยไม่มีช่องว่าง
// ระหว่างคำ — ไฮไลต์ที่เริ่มหรือจบกลางคำจะถูก formatter ตัดบรรทัดในแท็กแล้วแทรก
// ช่องว่างกลางคำ อ่านคอปปี้โดยถอดแท็กออกต้องได้ข้อความเดิมเป๊ะ และไม่มี <strong>
// สองตัวติดกันโดยไม่มีข้อความธรรมดาคั่น
//
// บรีฟรอบนี้ **โฆษณาและกำกับในประโยคเดียวกัน** (brand-spec §5): หัวข้อของบรีฟเอง
// เขียนว่า ค่ายแท้ถูกลิขสิทธิ์ / จ่ายสูง โบนัสเพียบ / ไม่ผ่านเอเย่นต์100% /
// ไม่จำกัด ขณะที่ย่อหน้าของบรีฟเองตอบว่า ควรตรวจสอบข้อมูลผู้ให้บริการและหลักฐาน
// ความเกี่ยวข้องกับค่ายเกมโดยตรงก่อนใช้งาน · คำกล่าวอ้างว่าเป็นเกมลิขสิทธิ์แท้
// หรือยอดเงินเข้าบริษัทแม่โดยตรงไม่สามารถยืนยันได้จากข้อความโฆษณาเพียงอย่างเดียว ·
// ไม่ควรตีความข้อความว่าจ่ายสูงเป็นการรับประกันผลกำไร · เครดิตคืนยอดเสียไม่ได้
// หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพัน — **ship ทั้งสองครึ่งตรงตามที่บรีฟ
// เขียน ไม่ขยายคำโฆษณาเป็นคำกล่าวอ้างใหม่ และทุกประโยคกำกับ ship ครบ ไม่ตัด
// เพราะฟังดูลบ**
// ตัวเลขบนหน้านี้มีแค่ของบรีฟเอง: **0.3% · 0.8% · 100% (เฉพาะในวลี
// "ไม่ผ่านเอเย่นต์100%") · 24ชม.** ไม่มี RTP ไม่มีจำนวนเกม/ค่าย ไม่มีปีก่อตั้ง
// ไม่มีจำนวนสมาชิก ไม่มี "3 ขั้นตอน" ไม่มียอดฝากขั้นต่ำเป็นตัวเลข และไม่มีอัตรา
// จ่ายเป็นตัวเลข
//
// title/description = บรรทัด 1-2 ของบรีฟตรงตัว (src/assets/content.txt)
// description ยาวราว 115 ตัวอักษร — **ห้ามเติมให้ครบ 150** verify-build ยกเว้น
// เพดานล่างให้หน้าแรกไว้เพราะเหตุผลนี้ ส่วนเพดานบน 160 ยังผ่านสบาย
const pageTitle = `${BRAND_NAME} ระบบสล็อตเว็บนอก ทางเข้าแท้ ไม่ผ่านเอเย่นต์100%`;

const pageDescription = `${BRAND_NAME} ระบบสล็อตเว็บนอก ทางเข้าเล่นฐานเกมหลัก ค่ายแท้ถูกลิขสิทธิ์ ฝากถอนยอดเข้าบริษัทแม่โดยตรง ไม่ผ่านเอเย่นต์100%`;

const pageH1 = `${BRAND_NAME} ระบบสล็อตเว็บนอก ทางเข้าเล่นฐานเกมหลัก ไม่ผ่านเอเย่นต์100%`;

// บรีฟรอบนี้มีชั้น H1 -> H2 -> H3 จริง จึง **ไม่** แบนเป็น H2 ล้วน มี H3 สองตัว
// พอดี และทั้งคู่เป็นบรรทัด H3 ของบรีฟเอง (content.txt บรรทัด 9 และ 11)
// รอบนี้ไม่มี FeatureHighlights จึงไม่มีแหล่ง H3 ที่สาม
//
// checklist ตามลำดับเอกสาร (brand-spec §4) และตัวที่รับแต่ละข้อ:
//    1 H1  ${BRAND_NAME} ระบบสล็อตเว็บนอก ทางเข้าเล่นฐานเกมหลัก ไม่ผ่านเอเย่นต์100%
//          ContentBoxPremium, ย่อหน้าบรรทัด 4
//    2 H2  ${BRAND_NAME} ค่ายแท้ถูกลิขสิทธิ์ ฝากถอนยอดเข้าบริษัทแม่โดยตรง
//          ContentBoxTwoPremium, บรรทัด 6 แบ่งสองครึ่ง
//    3 H2  โปรโมชั่นเล่น ${BRAND_NAME} จ่ายสูง โบนัสเพียบ
//          ContentBox3ThreeCyberCut, บรรทัด 8 แบ่งสามส่วน
//    4 H3  โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน
//          ContentBoxSevenThreePremium + slide1, บรรทัด 10 ซ้าย / ภาพขวา
//    5 H3  โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด
//          ContentBoxSevenThreeCyberCut + slide2, บรรทัด 12 ซ้าย / ภาพขวา
//    6 H2  ระบบฝากถอน ${BRAND_NAME} ได้ทุกธนาคารและทรูมันนี่
//          ContentBoxSpecial, บรรทัด 14 แบ่งสองครึ่ง
//    7 H2  ช่องทางติดต่อแอดมินเว็บ ${BRAND_NAME} ตลอด 24ชม.
//          ContentBoxCyberCut, บรรทัด 16
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ ${BRAND_NAME}
//          Faq3 + prop faqs ชัดเจน, บรรทัด 18-23
// inventory ที่ต้องได้: **h1 ×1 · h2 ×5 · h3 ×2** — ตรงเป้าของ brand-spec §4
//
// ⚠️ จุดที่ชั้น heading รั่วได้ และกันไว้แล้วทุกจุด: ContentBoxTwoPremium กับ
// ContentBox3ThreeCyberCut มี prop `heading` ที่ **ค่าปริยายเป็น false** และหน้านี้
// **ไม่ส่งป้ายคอลัมน์เลยสักใบ** (ไม่มี titleleft/titlecenter/titleright) ป้ายจึง
// ไม่ถูก render และถ้ารอบถัดไปส่งมาก็ออกเป็น <p> ที่ถือคลาสเดิม · ContentBoxSpecial
// ปล่อยหัวข้อใบเดียวจาก `title` สองซีกไม่มีป้ายของตัวเองโดยรูปร่างของมันเอง ·
// และ **ไม่ส่ง titleright ให้ SevenThree ทั้งสองบล็อก** คอลัมน์ภาพจึงไม่มี heading
// grep `<h[1-6]` ในทุก component ที่ไฟล์นี้กับ MainLayout เรียกแล้วรอบนี้ — ไม่มี
// ตัวไหน hardcode heading ไว้เลย ทุกแท็ก heading บนหน้ามาจาก prop คือมาจากบรีฟ
//
// ทั้ง ContentBoxSevenThree* วาง md:grid-cols-[7fr_3fr] โดยให้ **คอลัมน์ข้อความ
// มาก่อน** ภาพจึงไปอยู่ slot="right" ทุกครั้ง: heading ลงบนเนื้อความไม่ใช่บนภาพ
// และบนมือถือคอลัมน์เดียวอ่านลำดับ หัวข้อ -> ข้อความ -> ภาพ ไม่ใช่เปิดด้วยรูป
// สองบล็อกนี้คือ **เพดาน 2 บล็อกของตระกูล SevenThree พอดี** และ **สไลด์ขึ้นได้
// เฉพาะในสองบล็อกนี้เท่านั้น**
// การจับคู่สไลด์อ่านจากตัวอักษรบนภาพเอง (เปิดรูปอ่านใหม่รอบนี้แล้ว): **slide1
// เขียน โปรโมชั่น + คืนยอดเสีย 0.3% -> §4** · **slide2 เขียน โปรโมชั่น +
// แนะนำเพื่อน 0.8% -> §5** — uploader เขียนทับไฟล์ทุกดรอป เลขในชื่อไฟล์จึงไม่มี
// ความหมายข้ามแบรนด์ และ **รอบก่อนจับคู่กลับทางกับรอบนี้**
// ⛔ **slide3.png / slide4.png / banner2.png / banner3.png เป็นอาร์ตเวิร์กของ
// แบรนด์อื่น ห้าม import เด็ดขาด** เพราะ eager import = emit ขึ้น dist ทุก build
// แม้ไม่มีหน้าไหน render — **รอบนี้จึงไม่มี "รูปประกอบบทความ" (banner2+) เลย**
// และนั่นถูกต้องตาม playbook
// ⚠️ **banner1 / banner1-mobile เป็น hero ของ MainLayout** (glob ปักชื่อไว้แล้ว)
// ห้าม import ที่ไฟล์นี้ · ไม่มีภาพไหนบนหน้านี้เป็น LCP จึง **ไม่มี
// loading="eager" / fetchpriority="high"** สักใบ สไลด์ทั้งสองอยู่ใต้ fold
// ⚠️ `widths`/`sizes` ของสองบล็อกนี้ **ต่างกันจริง** เพราะเรขาคณิตของการ์ดต่างกัน
// (§4 เป็น md:p-10 · gap-10 · md:pl-10 -> 297px / calc(30vw - 87px) ส่วน §5 เป็น
// p-8 ล้วน · gap-8 · md:pl-8 -> 312px / calc(30vw - 72px)) ที่มาของตัวเลขเขียนไว้
// ใน frontmatter ของแต่ละ component **ห้ามลอกข้ามไฟล์** · บิตแมปจริงของสไลด์ทั้งคู่
// คือ **375x600** เพดาน candidate จึงเป็น 375 ห้าม upscale
//
// ที่เหลือบนหน้าเป็น chrome และไม่ออกแท็ก heading ที่ระดับไหนเลย: Announcement5,
// LatestWinners2 และ ReviewCardSumo2 ขึ้นชื่อหัวข้อเป็น <p>/<span> พร้อม
// aria-label บน <section> ส่วนคำถามของ FAQ อยู่ใน <summary> · ticker วางก่อน §1
// และการ์ดรีวิว/Navfoot วางหลัง §8 ส่วน **ฟีดรับเครดิตวางต่อท้าย §6 (ระบบฝากถอน)
// โดยตั้งใจ** เพราะมันเป็นวิดเจ็ตที่สังกัดหัวข้อนั้นตรง ๆ ตาม playbook Phase 2
// ("วางไว้ถัดจากหัวข้อที่มันสังกัด") ไม่ใช่การแทรกมั่วระหว่างสองหัวข้อ
//
// <Announcement /> เรียกเปล่าโดยตั้งใจ: orchestrator ตั้ง default message ของ
// Announcement5 เป็นคอปปี้ของแบรนด์นี้ไว้แล้วใน P1 และหน้าย่อยก็เรียกเปล่า
// เหมือนกัน — ticker จึงตรงกันทั้งเว็บจากแหล่งเดียว

// อาร์เรย์เดียว ใช้ทั้งกับ <Faq> และโน้ด FAQPage — ไม่ใช้ default ของ component
// (Faq3 ตั้งใจ ship เป็นลิสต์ว่าง prop ที่ลืมส่งจึงได้ accordion เปล่า ไม่ใช่
// คำถามของแบรนด์ก่อน) สามคู่นี้คือบล็อก Q/A ของบรีฟเอง (content.txt บรรทัด 18-23)
// ตรงตัว ตัดเฉพาะหมายเลข "1." "2." "3." ออกเพราะ accordion เป็นตัวลิสต์อยู่แล้ว
// ทุกคำตอบคงประโยคกำกับของบรีฟไว้ครบ — เป็นเนื้อหาของบรีฟทั้งสองครึ่ง
const faqs = [
  {
    q: `${BRAND_NAME} เป็นสล็อตเว็บนอกที่ไม่ผ่านเอเย่นต์จริงหรือไม่?`,
    a: `ยังไม่สามารถยืนยันได้จากข้อความโฆษณาเพียงอย่างเดียว ควรตรวจสอบข้อมูลบริษัทผู้ให้บริการ ความเกี่ยวข้องกับค่ายเกม และหลักฐานการได้รับอนุญาตจากแหล่งที่เชื่อถือได้`,
  },
  {
    q: `${BRAND_NAME} มีโปรโมชั่นคืนยอดเสีย 0.3% ทุกวันหรือไม่?`,
    a: `ตามข้อมูลที่ระบุ มีโปรโมชั่นคืนยอดเสีย 0.3% รายวัน แต่ควรตรวจสอบประเภทเกมที่เข้าร่วม รอบคำนวณยอด และเงื่อนไขการรับเครดิตจากประกาศล่าสุดก่อนใช้สิทธิ์`,
  },
  {
    q: `${BRAND_NAME} ฝากถอนผ่านธนาคารและทรูมันนี่ได้หรือไม่?`,
    a: `เว็บไซต์ระบุว่ารองรับธนาคารและทรูมันนี่ โดยควรตรวจสอบรายชื่อบริการที่ใช้งานได้จริง ยอดขั้นต่ำ และชื่อบัญชีรับเงินก่อนทำรายการทุกครั้ง`,
  },
];

// ไม่มี breadcrumb: นี่คือหน้าแรก เส้นทางจาก root มาหาตัวเองจะเหลือครั้งเดียวที่ชี้ตัวเอง
// ทุก URL ในกราฟมาจาก pageGraph ที่ derive จาก site: — ไม่มีโดเมนพิมพ์ไว้ในไฟล์นี้
// ไม่มี URL ที่ต่อด้วย `+` และไม่ส่งโน้ด Review / AggregateRating / sameAs /
// address / email เข้าไปเลย
// `description` เป็นสตริงเดียวกับที่ MainLayout ได้รับ `name` เป็น H1 ของหน้า และ
// `faqs` เป็นอาร์เรย์ตัวเดียวกับที่ <Faq> ได้รับ
const graph = pageGraph(Astro, {
  name: pageH1,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxPremium as="h1" title={pageH1}>
    <p>
      {BRAND_NAME} นำเสนอข้อมูลเกมสล็อตออนไลน์จากค่ายต่างประเทศ
      <strong class="text-[#fb2e33]">พร้อมรายละเอียดระบบเกม โปรโมชั่น และช่องทางฝากถอนสำหรับสมาชิก</strong>
      ภายในเว็บไซต์มีเมนูสำหรับศึกษากติกาเกม ตรวจสอบเงื่อนไขการเดิมพัน และเลือกดูข้อมูลค่ายเกมที่สนใจ ส่วนคำกล่าวอ้างเกี่ยวกับการเป็นทางเข้าเว็บหลักหรือไม่ผ่านเอเย่นต์
      <strong class="text-[#fb2e33]">ควรตรวจสอบข้อมูลผู้ให้บริการและหลักฐานความเกี่ยวข้องกับค่ายเกมโดยตรงก่อนใช้งาน</strong>
    </p>
  </ContentBoxPremium>

  <ContentBoxTwoPremium as="h2" title={`${BRAND_NAME} ค่ายแท้ถูกลิขสิทธิ์ ฝากถอนยอดเข้าบริษัทแม่โดยตรง`}>
    <p slot="left">
      {BRAND_NAME} นำเสนอเกมสล็อตจากค่ายต่าง ๆ ที่มีรูปแบบการเล่นและฟีเจอร์แตกต่างกัน
      <strong class="text-[#fb2e33]">ทั้งสล็อตคลาสสิก เกมที่มีรอบโบนัส และเกมที่ใช้สัญลักษณ์พิเศษในการจ่ายรางวัล</strong>
    </p>
    <p slot="right">
      ผู้ใช้งานควรตรวจสอบรายชื่อค่ายผู้พัฒนาและหลักฐานการได้รับอนุญาตให้บริการเกม
      <strong class="text-[#fb2e33]">รวมถึงตรวจสอบข้อมูลบริษัทและชื่อบัญชีรับเงินก่อนทำธุรกรรม</strong>
      เพราะคำกล่าวอ้างว่าเป็นเกมลิขสิทธิ์แท้หรือยอดเงินเข้าบริษัทแม่โดยตรง
      <strong class="text-[#fb2e33]">ไม่สามารถยืนยันได้จากข้อความโฆษณาเพียงอย่างเดียว</strong>
    </p>
  </ContentBoxTwoPremium>

  <ContentBox3ThreeCyberCut as="h2" title={`โปรโมชั่นเล่น ${BRAND_NAME} จ่ายสูง โบนัสเพียบ`}>
    <p slot="left">
      {BRAND_NAME} นำเสนอข้อมูลโปรโมชั่นสำหรับสมาชิกที่ต้องการศึกษาสิทธิพิเศษจากการใช้บริการ
      <strong class="text-[#fb2e33]">โดยมีรายการคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8% เป็นโปรโมชั่นหลักที่ระบุไว้</strong>
    </p>
    <p slot="center">แต่ละรายการอาจมีข้อกำหนดเกี่ยวกับประเภทเกม ยอดที่นำมาคำนวณ รอบเวลารับเครดิต และเงื่อนไขการถอนเงินแตกต่างกัน</p>
    <p slot="right">
      ผู้ใช้งานควรตรวจสอบประกาศล่าสุดก่อนเข้าร่วม
      <strong class="text-[#fb2e33]">และไม่ควรตีความข้อความว่าจ่ายสูงเป็นการรับประกันผลกำไรจากเกมสล็อต</strong>
    </p>
  </ContentBox3ThreeCyberCut>

  <ContentBoxSevenThreePremium as="h3" title="โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน">
    <p slot="left">
      โปรโมชั่นคืนยอดเสีย 0.3% เป็นรายการที่ระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขรายวัน
      <strong class="text-[#fb2e33]">สมาชิกควรตรวจสอบว่าเกมสล็อตประเภทใดเข้าร่วมรายการ มีรอบสรุปยอดเวลาใด และต้องกดรับเครดิตด้วยตนเองหรือระบบดำเนินการให้อัตโนมัติ</strong>
      รวมถึงศึกษาข้อกำหนดการใช้เครดิตและการถอนเงินให้ครบถ้วน เพราะยอดเสียบางรายการอาจไม่เข้าเกณฑ์รับสิทธิ์ ทั้งนี้
      <strong class="text-[#fb2e33]">เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งต่อไป</strong>
    </p>
    <Picture
      slot="right"
      src={promoCashback}
      loading="lazy"
      fetchpriority="low"
      widths={[150, 225, 297, 375]}
      sizes="(min-width: 1280px) 297px, (min-width: 768px) calc(30vw - 87px), (min-width: 473px) 375px, calc(100vw - 98px)"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={64}
      alt={`โปสเตอร์โปรโมชั่นของ ${BRAND_NAME} พื้นหลังสีดำสนิท ด้านหน้าเป็นผู้หญิงผมยาวสีน้ำตาลเข้ม ใส่เสื้อกล้ามสีดำ ขยิบตาหนึ่งข้าง มือซ้ายถือโทรศัพท์ที่จอแสดงตารางเกมสล็อตหกช่อง และใช้มือขวาชี้ไปที่จอ มุมบนซ้ายเป็นโลโก้ ${BRAND_NAME} ตัวอักษรเจลสีแดงมันวาวที่มีมงกุฎเล็กประดับหัวใจแดงอยู่บนตัวอักษรตัวแรก ครึ่งล่างของภาพเป็นคำว่า โปรโมชั่น ตัวอักษรไทยสีขาวตัดขอบแดง ใต้ลงมาเป็นแคปซูลพื้นดำขอบแดงเขียนว่า คืนยอดเสีย ด้วยตัวอักษรสีขาว ต่อท้ายด้วยเลข 0.3% ตัวโตสีแดง`}
      class="mx-auto h-auto w-full max-w-[375px] rounded-2xl border border-[#551c1e] shadow-[0_10px_28px_rgba(0,0,0,0.65)]"
    />
  </ContentBoxSevenThreePremium>

  <ContentBoxSevenThreeCyberCut as="h3" title="โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด">
    <p slot="left">
      โปรโมชั่นแนะนำเพื่อนโบนัส 0.8% เป็นรายการที่ระบุสิทธิ์สำหรับสมาชิกที่แนะนำผู้ใช้งานรายใหม่
      <strong class="text-[#fb2e33]">โดยควรตรวจสอบวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และฐานยอดที่ใช้คำนวณโบนัสให้ชัดเจน</strong>
      แม้จะมีข้อความว่าไม่จำกัด แต่ควรยืนยันจำนวนบัญชีที่เข้าร่วมได้ รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุด
      <strong class="text-[#fb2e33]">เพื่อป้องกันความเข้าใจคลาดเคลื่อนเกี่ยวกับจำนวนเครดิตที่มีสิทธิ์ได้รับ</strong>
    </p>
    <Picture
      slot="right"
      src={promoReferral}
      loading="lazy"
      fetchpriority="low"
      widths={[156, 234, 312, 375]}
      sizes="(min-width: 1280px) 312px, (min-width: 768px) calc(30vw - 72px), (min-width: 473px) 375px, calc(100vw - 98px)"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={64}
      alt={`โปสเตอร์โปรโมชั่นของ ${BRAND_NAME} พื้นหลังสีดำสนิท ด้านหน้าเป็นผู้หญิงผมยาวสีน้ำตาลเข้มคนเดิม ใส่เสื้อกล้ามสีดำ ยกโทรศัพท์ขึ้นด้วยมือขวาให้เห็นโลโก้ ${BRAND_NAME} บนจอ และชี้นิ้วไปที่จอด้วยมือซ้าย มุมบนขวาเป็นโลโก้ ${BRAND_NAME} ตัวอักษรเจลสีแดงมันวาวที่มีมงกุฎเล็กประดับหัวใจแดงอยู่บนตัวอักษรตัวแรก ครึ่งล่างของภาพเป็นคำว่า โปรโมชั่น ตัวอักษรไทยสีขาวตัดขอบแดง ใต้ลงมาเป็นแคปซูลพื้นดำขอบแดงเขียนว่า แนะนำเพื่อน ด้วยตัวอักษรสีขาว ต่อท้ายด้วยเลข 0.8% ตัวโตสีแดง`}
      class="mx-auto h-auto w-full max-w-[375px] rounded-2xl border border-[#551c1e] shadow-[0_10px_28px_rgba(0,0,0,0.65)]"
    />
  </ContentBoxSevenThreeCyberCut>

  <ContentBoxSpecial as="h2" title={`ระบบฝากถอน ${BRAND_NAME} ได้ทุกธนาคารและทรูมันนี่`} iconleft="💳" iconright="🔎">
    <p slot="left">
      {BRAND_NAME} ระบุช่องทางฝากถอนผ่านธนาคารและทรูมันนี่ เพื่อให้สมาชิกตรวจสอบวิธีทำรายการตามบริการที่เปิดใช้งานจริง
      <strong class="text-[#fb2e33]">ก่อนฝากเงินควรตรวจสอบรายชื่อธนาคารที่รองรับ ยอดขั้นต่ำ และชื่อบัญชีปลายทางให้ตรงกับข้อมูลผู้ให้บริการที่ยืนยันได้</strong>
    </p>
    <p slot="right">
      รวมถึงศึกษาระยะเวลาดำเนินการและข้อกำหนดการถอนเงินให้ครบถ้วน หากพบชื่อบัญชีไม่ตรงกับข้อมูลทางการหรือมีการแจ้งเปลี่ยนบัญชีอย่างผิดปกติ
      <strong class="text-[#fb2e33]">ควรหยุดทำรายการและติดต่อธนาคารหรือผู้ให้บริการชำระเงินเพื่อตรวจสอบก่อนโอนเงิน</strong>
    </p>
  </ContentBoxSpecial>

  <LatestWinners />

  <ContentBoxCyberCut as="h2" title={`ช่องทางติดต่อแอดมินเว็บ ${BRAND_NAME} ตลอด 24ชม.`}>
    <p>
      {BRAND_NAME} ระบุช่องทางติดต่อเจ้าหน้าที่สำหรับผู้ใช้งานที่ต้องการสอบถามเกี่ยวกับการเข้าสู่ระบบ รายชื่อค่ายเกม รายการฝากถอน และรายละเอียดโปรโมชั่น
      <strong class="text-[#fb2e33]">โดยควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง</strong>
      หากพบปัญหาเกี่ยวกับธุรกรรม ควรเก็บหมายเลขรายการและหลักฐานที่เกี่ยวข้องไว้สำหรับตรวจสอบ พร้อมแจ้งรายละเอียดปัญหาให้ชัดเจน
      <strong class="text-[#fb2e33]">โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP</strong>
      ทั้งนี้ ควรตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุดอีกครั้ง
    </p>
  </ContentBoxCyberCut>

  <Faq as="h2" title={`คำถามที่พบบ่อยเกี่ยวกับ ${BRAND_NAME}`} faqs={faqs} />

  <ReviewCardSumo />

  <Navfoot />
</MainLayout>
