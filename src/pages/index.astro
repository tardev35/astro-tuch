// Final inventory for this page: h1 x1, h2 x5, h3 x2 — brand-spec §4's target.
//
// Both ContentBoxSevenThree* variants lay out md:grid-cols-[7fr_3fr] with the TEXT column
// FIRST, so each picture goes in slot="right": the heading always lands on the prose, never
// on the picture, and on a phone the single column reads heading, text, picture rather than
// opening with an image. ⚠️ §5's heading is a floating badge at -top-6; with this round's
// real title it wraps to TWO lines at 320px and the card's pt-36 (144px) still leaves 90px
// of daylight, so no padding bump was needed — the arithmetic is written out in that
// component's frontmatter and must be redone, not copied, by the next brand.
// Neither SevenThree is passed a `titleright`, so neither image column carries a heading and
// each block emits exactly one. ContentBoxTwoNeumorphism, ContentBoxSpecial and
// ContentBox3Three are passed no column labels either — the brief gives §3, §6 and §7 one
// running paragraph each with no sub-labels, and inventing a set here would be this page's
// own wording rather than the docx's. ContentBox3Three therefore also keeps `heading` at its
// default false, which is what stops it adding three h3s the brief never wrote.
//
// Every brief paragraph ships in full — nothing merged, nothing summarised. §3, §6 and §7
// run one sentence group per slot, and NO slot receives more than one element, so the house
// rule's "one element per slot" holds everywhere without a wrapper <div> being needed.
//
// Everything else on the page is chrome and emits no heading tag at any level:
// Announcement4, LatestWinners3 and ReviewCardSumo2 render their titles as <p>/<span> with
// an aria-label on the section, and the FAQ's questions live inside <summary>. The non-brief
// widgets sit before section 1 (the ticker, then the transaction feed) and after section 8
// (the review ledger, then Navfoot) — never spliced between two content sections.
//
// ContentBoxSpecial's two icons are passed explicitly as 💰 / 🏧 rather than left at the
// component's 💬 / 🛡️ defaults: §6 is the deposit/withdrawal section, so the glyphs read as
// this brand's own axis (ระบบดูแลการเงิน) instead of a generic support pair. Both sit inside
// the component's own aria-hidden plate and are never part of a text prop.

// One array, used by both <Faq> and the FAQPage node — never the component's own defaults
// (Faq deliberately ships an empty list, so a forgotten prop renders an empty accordion
// rather than some previous brand's questions). The three pairs are the brief's own Q/A
// block (content.txt lines 18-23), verbatim; only the "1." / "2." / "3." list markers are
// dropped, since the accordion is the list.
const faqs = [
  {
    q: `${BRAND_NAME} รองรับการฝากถอนผ่านธนาคารและวอลเลทหรือไม่?`,
    a: `เว็บไซต์ระบุช่องทางฝากถอนผ่านธนาคารและวอลเลท แต่ควรตรวจสอบรายชื่อบริการที่รองรับจริง ยอดขั้นต่ำ และเงื่อนไขการทำรายการก่อนดำเนินการทุกครั้ง`,
  },
  {
    q: `จะตรวจสอบได้อย่างไรว่าบัญชีรับเงินไม่ใช่บัญชีม้า?`,
    a: `ควรตรวจสอบชื่อบัญชีปลายทางกับข้อมูลผู้ให้บริการที่ยืนยันได้ และหลีกเลี่ยงการโอนเงินเข้าบัญชีที่มีชื่อไม่ตรงหรือมีการเปลี่ยนแปลงโดยไม่มีคำอธิบาย หากสงสัยควรติดต่อธนาคารเพื่อขอคำแนะนำก่อนโอนเงิน`,
  },
  {
    q: `หากฝากเงินแล้วไม่เข้าระบบ ควรทำอย่างไร?`,
    a: `ควรเก็บหลักฐานการโอนเงิน ตรวจสอบสถานะธุรกรรม และติดต่อช่องทางบริการทางการของ${BRAND_NAME} หากพบความผิดปกติหรือสงสัยการฉ้อโกง ควรแจ้งธนาคารหรือผู้ให้บริการชำระเงินโดยเร็ว`,
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own sentence. Thai
// has no inter-word space, so a highlight that starts or ends mid-word lets the formatter
// break the line inside the tag and render a space that splits the word — the copy must read
// identically with the tags removed. No two <strong> elements are adjacent either: every pair
// is separated by at least one run of plain text, so the whitespace between them can never
// collapse into a missing space.
// One highlight colour only: #a4186b (brand-spec §2 reserves the deep rose for exactly this
// job at 7.2:1 on a white card), against the inherited body colour #4a0d35 (= BRAND_TEXT).
// ⚠️ The lead pink #dd1b74 is NOT available for this — it clears AA on a white card by the
// narrowest margin (4.67:1) and §2 confines it to headings, fills, borders and auras. The
// paragraphs below carry no colour class of their own: every ContentBox* card in this mix
// already sets `text-left text-base leading-relaxed text-[#4a0d35]` on the element holding
// the slot, so the prose inherits it and no page-level override can drift from the card. No
// paragraph carries mx-auto or max-w-* either — the cards cap their own width, and the only
// max-w-* on the page are the two capping the slides, which are images and not prose. No
// slot's copy names a colour.

// No breadcrumb: this is the homepage, so a trail from the root to itself would be a single
// self-referential crumb. Every URL in the graph is derived by pageGraph from `site:` — no
// domain is typed out in this file, no URL is built with `+`, and no Review / AggregateRating
// / sameAs / address / email node is passed. `description` is the exact same string MainLayout
// gets, and `faqs` is the exact same array <Faq> gets.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <LatestWinners />

  <ContentBoxPremium as="h1" title={`${BRAND_NAME} ระบบดูแลการเงิน ฝากถอนทุกช่องทาง ปลอดภัยไม่ผ่านม้า`}>
    <p>
      {BRAND_NAME} นำเสนอระบบบริการสมาชิกที่รวบรวมช่องทางฝากถอนและข้อมูลเกมออนไลน์ไว้ในเว็บไซต์เดียว
      <strong class="text-[#a4186b]">ทั้งเกมสล็อต ไฮโล ยิงปลา หวย และฟุตบอล</strong>
      พร้อมช่องทางทำรายการผ่านธนาคารและวอลเลทตามที่เปิดให้บริการ ผู้ใช้งานสามารถตรวจสอบรายละเอียดธุรกรรมและติดต่อเจ้าหน้าที่เมื่อพบปัญหาได้
      <strong class="text-[#a4186b]">โดยควรตรวจสอบชื่อบัญชีผู้รับเงิน ข้อมูลผู้ให้บริการ และหลักฐานความน่าเชื่อถือก่อนโอนเงินทุกครั้ง</strong>
      เพื่อหลีกเลี่ยงความเสี่ยงจากบัญชีแอบอ้างหรือบัญชีม้า
    </p>
  </ContentBoxPremium>

  <ContentBoxCyberCut as="h2" title={`${BRAND_NAME} เปิดระบบเล่นสล็อต ไฮโล ยิงปลา หวย บอล ครบวงจร`}>
    <p>
      {BRAND_NAME} รวบรวมข้อมูลเกมเดิมพันออนไลน์หลายประเภทไว้ในช่องทางเดียว
      <strong class="text-[#a4186b]">ไม่ว่าจะเป็นเกมสล็อตที่มีรูปแบบและฟีเจอร์แตกต่างกัน</strong>
      ไฮโลที่ใช้ผลการทอยลูกเต๋า เกมยิงปลาที่มีระบบคะแนน หวยออนไลน์ที่เลือกหมายเลขตามประเภทการเดิมพัน และฟุตบอลที่มีราคาต่อรองหลากหลาย ผู้ใช้งานควรศึกษากติกา อัตราจ่าย และเงื่อนไขของแต่ละเกมก่อนทำรายการ
      <strong class="text-[#a4186b]">เพราะเกมเดิมพันทุกประเภทมีความเสี่ยงต่อการสูญเสียเงิน และไม่มีรูปแบบใดสามารถรับประกันผลกำไรได้</strong>
    </p>
  </ContentBoxCyberCut>

  <ContentBoxTwoNeumorphism as="h2" title={`โปรโมชั่น ${BRAND_NAME} รับได้ไม่จำกัดยูส`}>
    <p slot="left">
      {BRAND_NAME} นำเสนอข้อมูลโปรโมชั่นสำหรับสมาชิกที่สนใจสิทธิพิเศษจากการใช้บริการ
      <strong class="text-[#a4186b]">โดยมีรายการคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8%</strong>
      ซึ่งแต่ละโปรโมชั่นอาจมีเงื่อนไขเกี่ยวกับประเภทเกม ยอดที่นำมาคำนวณ และรอบเวลารับเครดิตแตกต่างกัน
    </p>
    <p slot="right">
      ก่อนเข้าร่วมควรอ่านข้อกำหนดล่าสุดให้ครบถ้วน
      <strong class="text-[#a4186b]">รวมถึงตรวจสอบจำนวนบัญชีที่มีสิทธิ์รับโปรโมชั่นและเงื่อนไขการใช้โบนัส</strong>
      เพื่อให้เข้าใจรายละเอียดอย่างถูกต้อง
    </p>
  </ContentBoxTwoNeumorphism>

  <ContentBoxSevenThreeNeumorphism as="h3" title="โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสทุกวัน">
    <p slot="left">
      โปรโมชั่นคืนยอดเสีย 0.3% เป็นรายการที่ระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขในแต่ละวัน
      <strong class="text-[#a4186b]">สมาชิกควรตรวจสอบว่าเกมสล็อต ไฮโล ยิงปลา หวย หรือฟุตบอลประเภทใดเข้าร่วมรายการบ้าง</strong>
      รวมถึงศึกษารอบเวลาคำนวณยอดและวิธีรับเครดิตให้ชัดเจน ก่อนเข้าร่วมควรอ่านข้อกำหนดเกี่ยวกับการใช้โบนัสและการถอนเงินให้ครบถ้วน หากไม่แน่ใจสามารถสอบถามเจ้าหน้าที่เพิ่มเติมได้
      <strong class="text-[#a4186b]">ทั้งนี้ เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือรับประกันผลตอบแทนในอนาคต</strong>
    </p>
    <Picture
      slot="right"
      src={promoCashback}
      loading="lazy"
      fetchpriority="low"
      widths={[297, 480, 600]}
      sizes="(max-width: 697px) calc(100vw - 98px), (max-width: 767px) 600px, (max-width: 1279px) calc(30vw - 87px), 297px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={64}
      alt={`โปสเตอร์โปรโมชั่นของ ${BRAND_NAME} เป็นภาพแนวนอนฉากพื้นสตูดิโอสีขาวสว่าง ฝั่งซ้ายเป็นชายหนุ่มผมสั้นสีเงินสวมเสื้อกล้ามขาว ฝั่งขวาเป็นหญิงสาวผมสั้นสีเงินสวมสปอร์ตบราสีชมพู ตรงกลางเป็นหมูการ์ตูนสวมหน้ากากโจรสีดำ รอบตัวมีกล่องของขวัญขาว-ชมพูผูกโบว์ เหรียญสีชมพูปลิว และลูกฟุตบอลขาว-ชมพู ด้านบนเป็นโลโก้หัวหมูคู่กับชื่อ ${BRAND_NAME} กลางภาพเป็นคำว่า โปรโมชั่น ตัวอักษรไทยสามมิติสีชมพูตัวโต ใต้ลงมาเป็นแผ่นป้ายเขียนว่า คืนยอดเสีย ต่อท้ายด้วยเลข 0.3% ตัวโต`}
      class="mx-auto h-auto w-full max-w-[600px] rounded-2xl border border-[#dd1b74]/60 shadow-[0_10px_28px_rgba(74,13,53,0.2)]"
    />
  </ContentBoxSevenThreeNeumorphism>

  <ContentBoxSevenThreeFloatingBadge as="h3" title="โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด">
    <p slot="left">
      โปรโมชั่นแนะนำเพื่อนโบนัส 0.8% เป็นรายการที่ระบุสิทธิ์สำหรับสมาชิกที่แนะนำผู้ใช้งานรายใหม่
      <strong class="text-[#a4186b]">โดยควรตรวจสอบวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และยอดที่ใช้คำนวณโบนัสให้ครบถ้วน</strong>
      แม้โปรโมชั่นจะระบุว่าไม่จำกัด แต่ควรยืนยันข้อกำหนดเกี่ยวกับจำนวนบัญชีที่เข้าร่วม รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุด
      <strong class="text-[#a4186b]">เพื่อให้เข้าใจหลักเกณฑ์การรับสิทธิ์และหลีกเลี่ยงความคลาดเคลื่อนเกี่ยวกับยอดโบนัส</strong>
    </p>
    <Picture
      slot="right"
      src={promoReferral}
      loading="lazy"
      fetchpriority="low"
      widths={[311, 480, 600]}
      sizes="(max-width: 699px) calc(100vw - 100px), (max-width: 767px) 600px, (max-width: 1311px) calc(30vw - 83px), 311px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={64}
      alt={`โปสเตอร์โปรโมชั่นของ ${BRAND_NAME} เป็นภาพแนวนอนฉากพื้นสตูดิโอสีขาวสว่าง ฝั่งซ้ายเป็นชายหนุ่มผมสั้นสีเงินสวมเสื้อกล้ามขาวและกางเกงขาสั้นขาว ฝั่งขวาเป็นหญิงสาวผมสั้นสีเงินสวมสปอร์ตบราและกางเกงขาสั้นสีชมพู ตรงกลางเป็นหมูการ์ตูนสวมหน้ากากโจรสีดำ รอบตัวมีกล่องของขวัญขาว-ชมพูผูกโบว์ เหรียญสีชมพูปลิว และลูกฟุตบอลขาว-ชมพู ด้านบนเป็นโลโก้หัวหมูคู่กับชื่อ ${BRAND_NAME} กลางภาพเป็นคำว่า โปรโมชั่น ตัวอักษรไทยสามมิติสีชมพูตัวโต ใต้ลงมาเป็นแผ่นป้ายเขียนว่า แนะนำเพื่อน ต่อท้ายด้วยเลข 0.8% ตัวโต`}
      class="mx-auto h-auto w-full max-w-[600px] rounded-2xl border border-[#dd1b74]/60 shadow-[0_10px_28px_rgba(164,24,107,0.22)]"
    />
  </ContentBoxSevenThreeFloatingBadge>

  <ContentBoxSpecial as="h2" title={`${BRAND_NAME} รองรับการฝากถอนทุกธนาคารและวอลเลท`} iconleft="💰" iconright="🏧">
    <p slot="left">
      {BRAND_NAME} ระบุช่องทางฝากถอนผ่านธนาคารชั้นนำและวอลเลท เพื่อให้สมาชิกเลือกตรวจสอบวิธีทำรายการที่เหมาะกับบริการที่ใช้งานจริง
      <strong class="text-[#a4186b]">ก่อนฝากเงินควรตรวจสอบชื่อบัญชีปลายทางและรายละเอียดผู้รับเงินให้ตรงกับข้อมูลทางการ</strong>
      โดยไม่โอนเงินไปยังบัญชีบุคคลอื่นที่ไม่สามารถยืนยันความเกี่ยวข้องกับผู้ให้บริการได้
    </p>
    <p slot="right">
      ส่วนการถอนเงินควรศึกษายอดขั้นต่ำ ระยะเวลาดำเนินการ และข้อกำหนดที่เกี่ยวข้อง
      <strong class="text-[#a4186b]">หากพบรายการผิดปกติควรหยุดทำธุรกรรมและติดต่อธนาคารหรือผู้ให้บริการชำระเงินทันที</strong>
    </p>
  </ContentBoxSpecial>

  <ContentBox3Three as="h2" title={`ช่องทางติดต่อแอดมิน ${BRAND_NAME} ตลอด 24ชม.`}>
    <p slot="left">
      {BRAND_NAME} ระบุช่องทางติดต่อเจ้าหน้าที่สำหรับผู้ใช้งานที่ต้องการสอบถามเกี่ยวกับ
      <strong class="text-[#a4186b]">การสมัครสมาชิก การเข้าสู่ระบบ รายการฝากถอน และรายละเอียดโปรโมชั่น</strong>
    </p>
    <p slot="center">
      <strong class="text-[#a4186b]">โดยควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ</strong>
      เพื่อหลีกเลี่ยงบัญชีหรือบุคคลที่แอบอ้างชื่อบริการ หากพบปัญหาเกี่ยวกับธุรกรรม ควรเตรียมข้อมูลรายการและหลักฐานที่เกี่ยวข้องไว้สำหรับตรวจสอบ
    </p>
    <p slot="right">
      โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น
      <strong class="text-[#a4186b]">ทั้งนี้ ควรตรวจสอบเวลาการให้บริการและระยะเวลาตอบกลับล่าสุดอีกครั้ง</strong>
    </p>
  </ContentBox3Three>

  <Faq as="h2" title={`คำถามที่พบบ่อยเกี่ยวกับ ${BRAND_NAME}`} faqs={faqs} />

  <ReviewCardSumo2 />

  <Navfoot />
</MainLayout>
