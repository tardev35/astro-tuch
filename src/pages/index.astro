---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement2.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import Faq from "../components/Faq4.astro";
import LatestWinners from "../components/LatestWinnersCyber.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// IMAGE ROLES FOR THIS DROP (2026-09-23) — READ BEFORE REUSING THESE IMPORTS.
// Two files are referenced from this page and only two, both slides, both spent
// on a ContentBoxSevenThree* block — which is the family's hard cap of two per
// rebrand, so there is no third SevenThree here:
//   slide2.png — red promo banner reading "โปรโมชั่น แนะนำเพื่อน" over a giant
//     gold "0.8%", with a ribboned gift box, so it belongs to docx H3 #4
//     (แนะนำเพื่อน โบนัส 0.8%).
//   slide1.png — the same artwork reading "โปรโมชั่น คืนยอดเสีย" over "0.3%",
//     so it belongs to docx H3 #5 (คืนยอดเสีย โบนัส 0.3%).
// Both files are 600x333, so 600 is the top candidate width — nothing above it
// would be a real pixel.
//
// Deliberately NOT imported, and all still on disk as inventory:
//   banner2.png (2026-09-22), banner3.png (2026-08-11), slide3.png
//   (2026-09-18), slide4.png (2026-08-13) — every one predates this drop and
//   carries a previous client's artwork. There is therefore NO usable banner2+
//   this round and NO single-column inline illustration, which is the expected
//   outcome, not a gap to fill with a stale file.
//   banner1.png and banner1-mobile.png belong to MainLayout's own pinned globs
//   and are never referenced from a page — the hero is the LCP element, so
//   nothing here gets loading="eager" fetchpriority="high".
//
// Rotated out of this round's mix and NOT deleted from disk (they are inventory
// for the next brand): Announcement5, ContentBoxPremium, ContentBoxCyberCut,
// ContentBoxSevenThreePremium, ContentBoxSevenThreeCyberCut, ContentBoxTwoPremium,
// ContentBoxTwoCyberCut, Faq3, LatestWinnersPremium — and LottoGrid, which stays
// out for a reason rather than a rotation: the brief names หวย only as one of
// five game categories in a single list, never as a section of its own, so a
// dedicated lottery grid would outweigh what the brief actually says. The file
// stays on disk for the next lottery client.

// Title and description are the brief's own Title/Description lines, used
// verbatim. A brief-supplied description is never padded up to the 150-char
// floor and never topped up from the H1/H2.
const pageTitle = "THE88 ผู้ให้บริการระบบพนันออนไลน์ จากบริษัทหลักโดยตรง ปลอดภัยชัวร์";

const pageDescription = "THE88 ผู้ให้บริการระบบพนันออนไลน์ รวมเกมครบ ทั้ง บาคาร่า สล็อต หวย บอล ไฮโล จากบริษัทหลักโดยตรง แท้ได้มาตรฐานสากล ปลอดภัยชัวร์";

// <Announcement /> runs bare: Announcement2's default message is already this
// brand's copy, and every sub-page calls it bare too — passing an override here
// is how the ticker ends up saying two different things on two pages.

// The docx has a real H1 -> H2 -> H3 hierarchy this round: "แนะนำเพื่อน โบนัส
// 0.8%" and "คืนยอดเสีย โบนัส 0.3%" are genuine H3 sub-points of the H2
// โปรโมชั่น section, so the page is NOT flattened to H2-only. They are the only
// <h3> here and they are carried by the two ContentBoxSevenThree* blocks.
// Everything else is chrome — ProviderGrid, LatestWinnersCyber, LoginRtpSection
// and ReviewCardSumo2 all render their titles as <p>/<span> with an aria-label
// on the section, and Faq4's questions stay <span> inside <summary>, so none of
// them emits a heading tag.
//
// The docx checklist, in order, and what carries each one:
//   1 H1  THE88 ผู้ให้บริการระบบพนันออนไลน์ …   ContentBoxNeumorphism
//   2 H2  เว็บ THE88 บาคาร่า สล็อต หวย บอล ไฮโล … ContentBoxFloatingBadge (+ ProviderGrid)
//   3 H2  โปรโมชั่นสูงสุดในวงการ …               ContentBox
//   4 H3  แนะนำเพื่อน โบนัส 0.8%                ContentBoxSevenThreeNeumorphism   + slide2
//   5 H3  คืนยอดเสีย โบนัส 0.3%                 ContentBoxSevenThreeFloatingBadge + slide1
//   6 H2  ระบบ THE88 ฝากถอนวอลเลทและธนาคารชั้นนำ ContentBoxSpecial
//   7 H2  แอดมิน THE88 ดูแลสมาชิกตลอด 24 ชั่วโมง ContentBoxTwoNeumorphism
//   8 H2  คำถามที่พบบ่อย                         Faq4
// Final inventory for this page: h1 x1, h2 x5, h3 x2.

// One array, used by both <Faq> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last. The three pairs
// are the brief's own Q/A block, verbatim.
const faqs = [
  {
    q: "THE88 มีเกมอะไรให้เลือกบ้าง?",
    a: "ภายในระบบมีทั้งบาคาร่า สล็อต หวย บอล และไฮโล รวมถึงเกมจากหลายค่ายตามรายการที่เปิดให้บริการ สมาชิกสามารถตรวจสอบหมวดเกมและรายละเอียดของแต่ละรายการได้จากหน้าเว็บไซต์",
  },
  {
    q: "โปรโมชั่น THE88 สมัครแล้วรับได้เลยหรือไม่?",
    a: "โปรโมชั่นบางรายการสามารถกดรับหลังสมัครได้ตามเงื่อนไขที่กำหนด ขณะที่บางสิทธิ์อาจมีข้อกำหนดเพิ่มเติม แนะนำให้ตรวจสอบรายละเอียดของแต่ละโปรโมชั่นก่อนกดรับทุกครั้ง",
  },
  {
    q: "THE88 รองรับการฝากถอนช่องทางใด?",
    a: "ระบบรองรับวอลเลทและธนาคารตามรายการที่เว็บไซต์เปิดให้ใช้งาน สมาชิกสามารถตรวจสอบช่องทางที่รองรับ สถานะรายการ และรายละเอียดบัญชีได้จากหน้าฝากถอนโดยตรง",
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// Two highlight colours, matching the logo and both slides: the palette's gold
// light (#ffe7a6) marks a claim the brief states outright, and the gold mid
// (#f2c14e) is reserved for the two bonus figures, which is exactly how slide1
// and slide2 print them.

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb. Every URL in the graph is derived
// by pageGraph from `site:` — no domain is typed out in this file.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxNeumorphism as="h1" title="THE88 ผู้ให้บริการระบบพนันออนไลน์ จากบริษัทหลักโดยตรง">
    <p class="text-left text-base leading-relaxed text-[#f7e3dd]">
      THE88
      <strong class="text-[#ffe7a6]">ผู้ให้บริการระบบพนันออนไลน์ที่รวมเกมหลายประเภทไว้ในระบบเดียว</strong>
      พร้อมรูปแบบการเชื่อมต่อจากบริษัทหลักตามข้อมูลของเว็บไซต์
      <strong class="text-[#ffe7a6]">สมาชิกสามารถเลือกเล่นได้ทั้งบาคาร่า สล็อต หวย บอล และไฮโล ผ่านบัญชีเดียว</strong>
      รองรับการใช้งานบนมือถือและคอมพิวเตอร์ พร้อมเมนูที่จัดหมวดหมู่ชัดเจนและเข้าถึงง่าย
    </p>
  </ContentBoxNeumorphism>

  <ContentBoxFloatingBadge as="h2" title="เว็บ THE88 บาคาร่า สล็อต หวย บอล ไฮโล แท้ได้มาตรฐานสากล ปลอดภัยชัวร์">
    <p class="text-left text-base leading-relaxed text-[#f7e3dd]">
      เว็บ THE88
      <strong class="text-[#ffe7a6]">รวมเกมยอดนิยมไว้ครบทั้งบาคาร่า สล็อต หวย บอล และไฮโล</strong>
      โดยแบ่งหมวดหมู่ให้เลือกอย่างชัดเจน พร้อมระบบที่ออกแบบให้รองรับการใช้งานหลายอุปกรณ์
      <strong class="text-[#ffe7a6]">สมาชิกสามารถตรวจสอบรายละเอียดเกมและค่ายที่เปิดให้บริการก่อนเข้าเล่น</strong>
      เพื่อเลือกประเภทที่เหมาะกับรูปแบบการใช้งานของตัวเอง
    </p>
  </ContentBoxFloatingBadge>

  <ProviderGrid />

  <ContentBox as="h2" title="โปรโมชั่นสูงสุดในวงการ กดรับหลังสมัคร THE88 ไม่ต้องฝาก">
    <p class="text-left text-base leading-relaxed text-[#f7e3dd]">
      โปรโมชั่น THE88
      <strong class="text-[#ffe7a6]">มีสิทธิ์สำหรับสมาชิกให้เลือกหลายรูปแบบ</strong>
      โดยบางรายการสามารถตรวจสอบและกดรับหลังสมัครได้ตามเงื่อนไขที่กำหนด
      <strong class="text-[#ffe7a6]">มีทั้งโบนัสแนะนำเพื่อนและโบนัสคืนยอดเสีย</strong>
      พร้อมรายละเอียดของแต่ละรายการให้ตรวจสอบก่อนรับ เพื่อให้สมาชิกเลือกสิทธิ์ได้ตรงกับความต้องการมากขึ้น
    </p>
  </ContentBox>

  <ContentBoxSevenThreeNeumorphism as="h3" titleright="แนะนำเพื่อน โบนัส 0.8%">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[340, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), 382px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่นพื้นแดง ด้านซ้ายเป็นผู้หญิงผมยาวสีเข้มสวมชุดสีแดงสลับขาวที่มีคำว่า THE88 อยู่บนชุด กำหมัดชูขึ้นหนึ่งข้าง ด้านขวาเป็นโลโก้ THE88 ตัวอักษร THE สีแดงเงาขอบทองและเลข 88 สีครีมขอบทอง ถัดลงมาเป็นข้อความสีขาวขอบทองว่า โปรโมชั่น และคำว่า แนะนำเพื่อน ล่างสุดเป็นตัวเลขสีทองขนาดใหญ่ว่า 0.8% รอบภาพมีเหรียญทอง กล่องของขวัญผูกโบว์แดง และเหรียญคาสิโนแดงทองลายมงกุฎลอยอยู่"
      class="mx-auto h-auto w-full rounded-2xl border border-[#6b0302]/55 shadow-[0_10px_30px_rgba(164,2,1,0.45)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f7e3dd]">
      สมาชิก THE88
      <strong class="text-[#ffe7a6]">ที่แนะนำเพื่อนเข้ามาสมัครสามารถรับโบนัส</strong>
      <strong class="text-[#f2c14e]">0.8%</strong>
      <strong class="text-[#ffe7a6]">ตามเงื่อนไขของกิจกรรม</strong>
      ระบบมีรายละเอียดเกี่ยวกับยอดที่เข้าเกณฑ์และขั้นตอนรับสิทธิ์ให้ตรวจสอบ ช่วยให้ติดตามโบนัสจากการแนะนำเพื่อนได้สะดวกผ่านบัญชีสมาชิก
    </p>
  </ContentBoxSevenThreeNeumorphism>

  <ContentBoxSevenThreeFloatingBadge as="h3" title="คืนยอดเสีย โบนัส 0.3%">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[340, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), 353px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่นพื้นแดง ด้านซ้ายเป็นผู้หญิงผมยาวสีเข้มสวมชุดสีแดงสลับขาวที่มีคำว่า THE88 อยู่บนชุด ยกมือขึ้นหนึ่งข้างแบบแบมือ ด้านขวาเป็นโลโก้ THE88 ตัวอักษร THE สีแดงเงาขอบทองและเลข 88 สีครีมขอบทอง ถัดลงมาเป็นข้อความสีขาวขอบทองว่า โปรโมชั่น และคำว่า คืนยอดเสีย ล่างสุดเป็นตัวเลขสีทองขนาดใหญ่ว่า 0.3% รอบภาพมีเหรียญทอง ไพ่โพดำ และเหรียญคาสิโนแดงทองลายมงกุฎลอยอยู่"
      class="mx-auto h-auto w-full rounded-2xl border border-[#6b0302]/55 shadow-[0_10px_30px_rgba(164,2,1,0.45)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f7e3dd]">
      โปรโมชั่นคืนยอดเสียของ THE88
      <strong class="text-[#ffe7a6]">ให้โบนัส</strong>
      <strong class="text-[#f2c14e]">0.3%</strong>
      <strong class="text-[#ffe7a6]">ตามยอดและเงื่อนไขที่กำหนด</strong>
      สมาชิกสามารถตรวจสอบรอบคำนวณ ยอดที่เข้าเกณฑ์ และรายละเอียดก่อนกดรับได้จากหน้าโปรโมชั่น ช่วยให้ติดตามสิทธิ์ของตัวเองในแต่ละรอบได้ชัดเจนมากขึ้น
    </p>
  </ContentBoxSevenThreeFloatingBadge>

  <ContentBoxSpecial as="h2" title="ระบบ THE88 ฝากถอนวอลเลทและธนาคารชั้นนำ" iconleft="💳" iconright="🏦">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f7e3dd]">
      ระบบ THE88
      <strong class="text-[#ffe7a6]">รองรับช่องทางฝากถอนผ่านวอลเลทและธนาคารที่เว็บไซต์กำหนด</strong>
      สมาชิกสามารถเลือกช่องทางที่สะดวก
      <strong class="text-[#ffe7a6]">พร้อมตรวจสอบยอดเครดิตและสถานะรายการผ่านบัญชีของตัวเองได้</strong>
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#f7e3dd]">
      <strong class="text-[#ffe7a6]">ขั้นตอนถูกจัดให้เข้าใจง่าย</strong>
      ช่วยให้จัดการรายการต่าง ๆ ได้จากหน้าเว็บไซต์โดยไม่ต้องสลับหลายระบบ
    </p>
  </ContentBoxSpecial>

  <ContentBoxTwoNeumorphism as="h2" title="แอดมิน THE88 ดูแลสมาชิกตลอด 24 ชั่วโมง" titleleft="ติดต่อแอดมินได้ทุกช่วงเวลา" titleright="ทีมงานช่วยตรวจสอบและแนะนำขั้นตอน">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f7e3dd]">
      หากมีข้อสงสัยเกี่ยวกับการสมัคร โปรโมชั่น เกม การเข้าใช้งาน หรือระบบฝากถอน
      <strong class="text-[#ffe7a6]">สามารถติดต่อแอดมิน THE88 ได้ตลอด 24 ชั่วโมง</strong>
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#f7e3dd]">
      <strong class="text-[#ffe7a6]">ทีมงานพร้อมช่วยตรวจสอบข้อมูลและแนะนำขั้นตอนตามปัญหาที่แจ้ง</strong>
      เพื่อให้ทั้งสมาชิกใหม่และสมาชิกเดิมเข้าถึงข้อมูลที่ต้องการได้สะดวกทุกช่วงเวลา
    </p>
  </ContentBoxTwoNeumorphism>

  <Faq as="h2" title="คำถามที่พบบ่อย" faqs={faqs} />

  <LatestWinners />

  <LoginRtpSection />

  <ReviewCardSumo />

  <Navfoot />
</MainLayout>
