---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBox3ThreePremium from "../components/ContentBox3ThreePremium.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import Faq from "../components/Faq.astro";
import LatestWinners from "../components/LatestWinnersPremium.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// IMAGE ROLES FOR THIS DROP (2026-09-24) — READ BEFORE REUSING THESE IMPORTS.
// Two files are referenced from this page and only two, both slides, both spent
// on a ContentBoxSevenThree* block — the family's hard cap of two per rebrand,
// so there is no third SevenThree here:
//   slide1.png — the black-and-gold poster whose type reads "โปรโมชั่น แนะนำเพื่อน
//     / โบนัส 0.8%", so it belongs to docx H3 #4.
//   slide2.png — the same set with two models over "โปรโมชั่น คืนยอดเสีย /
//     โบนัส 0.3%", so it belongs to docx H3 #5.
// Both files are 600x333, so 600 is the top candidate width — nothing above it
// would be a real pixel. The alt text was written from the CURRENT artwork (the
// UWIN33 wordmark with a gold U, chrome WIN and gold 33, the woman in the white
// blazer with black-and-gold trim, the man in the black suit, the gold chips,
// the ace of spades and the gold crown), never carried over from MAHAGAME66's
// red-and-chrome strings.
//
// Deliberately NOT imported, and all still on disk as inventory:
//   banner2.png (2026-09-22), banner3.png (2026-08-11), slide3.png
//   (2026-09-18), slide4.png (2026-08-13) — every one predates this drop and
//   carries a previous client's artwork. There is therefore NO usable banner2+
//   this round and NO single-column inline illustration, which is the expected
//   outcome, not a gap to fill with a stale file.
//   banner1.png and banner1-mobile.png belong to MainLayout's own pinned globs
//   and are never referenced from a page — the hero is the LCP element, so
//   nothing here gets loading="eager" fetchpriority="high".
//
// ProviderGrid / ProviderGridPremium / FeaturedGames / PopularGamesStrip /
// GameRankingBoard are DROPPED this round and NOT deleted from disk: each one
// has to name specific studios or game titles, and this brief names none —
// filling them in would be inventing facts. SmoothCarousel is out because it
// would put slide* outside a ContentBoxSevenThree*, LottoGrid because UWIN33 is
// a mixed casino brand rather than a lottery one, FeatureHighlights because the
// 3-step signup list has no per-step headings in the brief (it emits <h3> per
// item, which would break the heading inventory), BankStrip because the brief
// names no deposit or withdrawal channel at all.

// Title and description are the brief's own Title/Description lines, used
// verbatim. A brief-supplied description is never padded up to the 150-char
// floor and never topped up from the H1/H2 — this one is 131 characters.
const pageTitle = "UWIN33 พนันเว็บตรงยอดนิยมอันดับ1 เกมเดิมพันสำหรับนักเล่นชาวไทย";

const pageDescription = "UWIN33 พนันเว็บตรงยอดนิยมอันดับ1 บาคาร่า รูเล็ต ไฮโล สล็อต บอล หวย เกมเดิมพันสำหรับนักเล่นชาวไทย รวมครบไว้ให้ในเว็บเดียว แบบครบวงจร";

// <Announcement /> runs bare: AnnouncementPremium's default message is already
// this brand's copy, and every sub-page calls it bare too — passing an override
// here is how the ticker ends up saying two different things on two pages.

// The docx has a real H2 -> H3 nesting this round: "แนะนำเพื่อน โบนัส 0.8%" and
// "คืนยอดเสีย โบนัส 0.3%" are genuine sub-points of the โปรโมชั่น H2, so the page
// is NOT flattened to H2-only. Those two are the only <h3> here, and each one is
// carried by its own ContentBoxSevenThree* block together with the slide whose
// artwork states that exact figure.
// Everything else is chrome — LatestWinnersPremium, LoginRtpSection and
// ReviewCardSumo2 render their titles as <p>/<span> with an aria-label on the
// section, ContentBoxTwo renders its column labels as <p>, and Faq's questions
// live in a <p> inside <summary> — so none of them emits a heading tag.
// ContentBox3ThreePremium is passed heading={false} because its three column
// captions are this page's own wording for splitting one docx paragraph into
// three readable columns, not docx sub-headings; they render as <p>.
//
// The docx checklist, in order, and what carries each one:
//    1 H1  UWIN33 พนันเว็บตรงยอดนิยมอันดับ1 เกมเดิมพัน …   ContentBoxPremium
//    2 H2  UWIN33 บาคาร่า รูเล็ต ไฮโล สล็อต บอล หวย …     ContentBox3ThreePremium
//    3 H2  อัปเดตโปรโมชั่น สำหรับสมาชิก UWIN33 …           ContentBoxCyberCut
//    4 H3  แนะนำเพื่อน โบนัส 0.8%                        ContentBoxSevenThreePremium + slide1
//    5 H3  คืนยอดเสีย โบนัส 0.3%                         ContentBoxSevenThreeCyberCut + slide2
//    6 H2  สมัคร UWIN33 รับโปรโมชั่นทุกวัน แค่ 3 ขั้นตอน    ContentBoxTwoPremium (intro + <ol>)
//    7 H2  ติดต่อเจ้าหน้าที่ UWIN33 ผ่าน LINE OFFICIAL …    ContentBoxNeumorphism
//    8 H2  คำถามที่พบบ่อย                                Faq
// Final inventory for this page: h1 x1, h2 x5, h3 x2.

// One array, used by both <Faq> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last. The three pairs
// are the brief's own Q/A block, verbatim.
const faqs = [
  {
    q: "UWIN33 มีเกมประเภทไหนให้เลือกบ้าง?",
    a: "ภายในระบบมีทั้งบาคาร่า รูเล็ต ไฮโล สล็อต บอล และหวย รวมถึงรายการจากหลายค่ายตามหมวดที่เว็บไซต์เปิดให้บริการ สมาชิกสามารถตรวจสอบเกมและรายละเอียดที่เกี่ยวข้องได้จากหน้ารวมเกมก่อนเข้าใช้งาน",
  },
  {
    q: "UWIN33 มีโปรโมชั่นอะไรให้สมาชิกบ้าง?",
    a: "โปรโมชั่นหลักตามข้อมูลที่กำหนดมีโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% โดยสิทธิ์และเงื่อนไขของแต่ละรายการอาจแตกต่างกัน แนะนำให้ตรวจสอบรายละเอียดจากหน้าโปรโมชั่นก่อนกดรับทุกครั้ง",
  },
  {
    q: "ติดต่อแอดมิน UWIN33 ได้ตลอด 24 ชั่วโมงหรือไม่?",
    a: "สามารถติดต่อเจ้าหน้าที่ผ่าน LINE OFFICIAL ได้ตลอด 24 ชั่วโมง เพื่อสอบถามเรื่องบัญชี ทางเข้าเกม โปรโมชั่น หรือปัญหาการใช้งาน โดยทีมงานจะช่วยตรวจสอบข้อมูลตามรายละเอียดที่แจ้งเข้ามา",
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// One highlight colour only this round: #fff8e6 against the body colour
// #ece6d8, so the brand gold stays the page's structural accent and the
// paragraphs never compete with a heading for it.

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb. Every URL in the graph is derived
// by pageGraph from `site:` — no domain is typed out in this file.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxPremium as="h1" title="UWIN33 พนันเว็บตรงยอดนิยมอันดับ1 เกมเดิมพัน สำหรับนักเล่นชาวไทย">
    <p class="text-left text-base leading-relaxed text-[#ece6d8]">
      UWIN33
      <strong class="text-[#fff8e6]">รวมเกมเดิมพันหลายประเภทสำหรับผู้ใช้งานชาวไทยไว้ในระบบเดียว</strong>
      <strong class="text-[#fff8e6]">ทั้งบาคาร่า รูเล็ต ไฮโล สล็อต บอล และหวย</strong>
      พร้อมเมนูที่แบ่งหมวดชัดเจน
      <strong class="text-[#fff8e6]">รองรับการเข้าใช้งานผ่านมือถือและคอมพิวเตอร์</strong>
      ช่วยให้เลือกเกมที่สนใจและจัดการบัญชีได้สะดวกโดยไม่ต้องสลับใช้งานหลายเว็บไซต์
    </p>
  </ContentBoxPremium>

  <ContentBox3ThreePremium
    as="h2"
    title="UWIN33 บาคาร่า รูเล็ต ไฮโล สล็อต บอล หวย รวมครบไว้ให้ในเว็บเดียว"
    heading={false}
    titleleft="เกมครบทุกหมวดในบัญชีเดียว"
    titlecenter="เลือกดูและสลับหมวดได้ง่าย"
    titleright="เมนูอ่านชัดบนมือถือ">
    <p slot="left" class="text-left text-base leading-relaxed text-[#ece6d8]">
      UWIN33
      <strong class="text-[#fff8e6]">มีตัวเลือกเกมครบทั้งบาคาร่า รูเล็ต ไฮโล สล็อต บอล และหวย</strong>
      พร้อมรวบรวมแต่ละหมวดไว้ในบัญชีเดียว
    </p>
    <p slot="center" class="text-left text-base leading-relaxed text-[#ece6d8]">
      <strong class="text-[#fff8e6]">ผู้ใช้งานสามารถเลือกดูเกมตามประเภท</strong>
      ตรวจสอบรายละเอียด
      <strong class="text-[#fff8e6]">และสลับไปยังหมวดที่สนใจได้ง่าย</strong>
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#ece6d8]">ระบบออกแบบให้เมนูอ่านชัดและเหมาะกับการใช้งานผ่านมือถือของสมาชิกชาวไทย</p>
  </ContentBox3ThreePremium>

  <ContentBoxCyberCut as="h2" title="อัปเดตโปรโมชั่น สำหรับสมาชิก UWIN33 ตลอดทั้งเดือน">
    <p class="text-left text-base leading-relaxed text-[#ece6d8]">
      โปรโมชั่น UWIN33
      <strong class="text-[#fff8e6]">มีการจัดสิทธิ์สำหรับสมาชิกตามรายการและช่วงเวลาที่กำหนด</strong>
      <strong class="text-[#fff8e6]">โดยมีทั้งโบนัสแนะนำเพื่อนและโบนัสคืนยอดเสีย</strong>
      สมาชิกสามารถตรวจสอบรายละเอียด ยอดที่เข้าเงื่อนไข
      <strong class="text-[#fff8e6]">และวิธีรับสิทธิ์จากหน้าโปรโมชั่น</strong>
      เพื่อเลือกใช้สิทธิ์ให้เหมาะกับรูปแบบการใช้งานของตัวเองในแต่ละเดือน
    </p>
  </ContentBoxCyberCut>

  <ContentBoxSevenThreePremium as="h3" title="แนะนำเพื่อน โบนัส 0.8%">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[340, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), 340px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นพื้นดำ-ทอง ด้านซ้ายเป็นหญิงสาวสวมเบลเซอร์สีขาวปกสีดำยืนชี้มือมาที่ข้อความ ด้านหลังมีชิปคาสิโนสีทองกับไพ่โพดำเอซวางซ้อนกัน ด้านบนกลางภาพเป็นโลโก้ UWIN33 ที่ตัว U และเลข 33 เป็นทองนูน ส่วนคำว่า WIN เป็นสีเงินโครเมียม กลางภาพเป็นตัวอักษรสีทองว่า โปรโมชั่น แนะนำเพื่อน โดยมีมงกุฎสีทองอยู่เหนือข้อความ และแผ่นป้ายด้านล่างเขียนว่า โบนัส 0.8%"
      class="mx-auto h-auto w-full rounded-2xl border border-[#e0b429]/55 shadow-[0_10px_30px_rgba(224,180,41,0.3)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#ece6d8]">
      สมาชิก UWIN33
      <strong class="text-[#fff8e6]">ที่แนะนำเพื่อนเข้ามาสมัครสามารถรับโบนัส 0.8% ตามเงื่อนไขของโปรโมชั่น</strong>
      ระบบมีข้อมูลเกี่ยวกับยอดที่เข้าเกณฑ์และขั้นตอนรับสิทธิ์ให้ตรวจสอบ
      <strong class="text-[#fff8e6]">ช่วยให้ติดตามโบนัสจากกิจกรรมแนะนำเพื่อนได้สะดวกผ่านบัญชีสมาชิกโดยตรง</strong>
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBoxSevenThreeCyberCut as="h3" title="คืนยอดเสีย โบนัส 0.3%">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[340, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), 346px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นพื้นดำ-ทองชุดเดียวกัน ด้านซ้ายเป็นหญิงสาวสวมเบลเซอร์สีขาวคาดขอบดำ-ทอง ด้านขวาเป็นชายหนุ่มสวมสูทสีดำผูกเนกไทสีดำ ทั้งคู่ชี้มือเข้าหาข้อความกลางภาพ ด้านล่างมีชิปคาสิโนสีทองสลับดำวางซ้อนกันเป็นกอง ด้านบนเป็นโลโก้ UWIN33 ที่ตัว U และเลข 33 เป็นทองนูน ส่วนคำว่า WIN เป็นสีเงินโครเมียม กลางภาพเป็นข้อความว่า โปรโมชั่น คืนยอดเสีย และแผ่นป้ายด้านล่างเขียนว่า โบนัส 0.3%"
      class="mx-auto h-auto w-full rounded-xl border border-[#dfe4ec]/35 shadow-[0_10px_30px_rgba(8,6,2,0.8)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#ece6d8]">
      <strong class="text-[#fff8e6]">โปรโมชั่นคืนยอดเสีย UWIN33 ให้โบนัส 0.3% ตามยอดและเงื่อนไขที่ระบบกำหนด</strong>
      สมาชิกสามารถตรวจสอบรอบคำนวณ ยอดที่เข้าเกณฑ์ และรายละเอียดก่อนกดรับสิทธิ์
      <strong class="text-[#fff8e6]">ช่วยให้ติดตามโบนัสในแต่ละรอบได้ง่ายและรู้เงื่อนไขก่อนนำสิทธิ์ไปใช้งาน</strong>
    </p>
  </ContentBoxSevenThreeCyberCut>

  <ContentBoxTwoPremium as="h2" title="สมัคร UWIN33 รับโปรโมชั่นทุกวัน แค่ 3 ขั้นตอน">
    <p slot="left" class="text-left text-base leading-relaxed text-[#ece6d8]">
      <strong class="text-[#fff8e6]">การสมัคร UWIN33 สามารถทำผ่านหน้าเว็บไซต์ได้ด้วยตัวเอง</strong>
      ใช้ขั้นตอนไม่ซับซ้อน หลังยืนยันบัญชีเรียบร้อยสามารถเข้าสู่ระบบเพื่อเลือกเกมและตรวจสอบโปรโมชั่นที่เปิดให้รับได้
      <strong class="text-[#fff8e6]">โดยมีขั้นตอนหลักเพียง 3 ขั้นตอนดังนี้</strong>
    </p>
    <ol slot="right" class="flex list-decimal flex-col gap-4 pl-6 text-left text-base leading-relaxed text-[#ece6d8] marker:font-black marker:text-[#e0b429]">
      <li>เปิดหน้าสมัคร UWIN33 แล้วกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน</li>
      <li>ตรวจสอบข้อมูลส่วนตัวและรายละเอียดบัญชีให้ถูกต้องก่อนกดยืนยัน</li>
      <li>ยืนยันการสมัครและเข้าสู่ระบบ จากนั้นเลือกเกมและตรวจสอบโปรโมชั่นที่เปิดให้สมาชิกได้ทันที</li>
    </ol>
  </ContentBoxTwoPremium>

  <ContentBoxNeumorphism as="h2" title="ติดต่อเจ้าหน้าที่ UWIN33 ผ่าน LINE OFFICIAL 24 ชั่วโมง">
    <p class="text-left text-base leading-relaxed text-[#ece6d8]">
      หากมีข้อสงสัยเกี่ยวกับการสมัคร โปรโมชั่น ทางเข้าเกม หรือการใช้งานบัญชี
      <strong class="text-[#fff8e6]">สามารถติดต่อเจ้าหน้าที่ UWIN33 ผ่าน LINE OFFICIAL ได้ตลอด 24 ชั่วโมง</strong>
      ทีมงานพร้อมช่วยให้ข้อมูลเกี่ยวกับบาคาร่า รูเล็ต ไฮโล สล็อต บอล หวย
      <strong class="text-[#fff8e6]">และตรวจสอบปัญหาการใช้งานตามรายละเอียดที่สมาชิกแจ้งเข้ามา</strong>
    </p>
  </ContentBoxNeumorphism>

  <Faq as="h2" title="คำถามที่พบบ่อย" faqs={faqs} />

  <LatestWinners />

  <LoginRtpSection />

  <ReviewCardSumo />

  <Navfoot />
</MainLayout>
