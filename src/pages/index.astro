---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement2.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBox3ThreeNeumorphism from "../components/ContentBox3ThreeNeumorphism.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxTwoFloatingBadge from "../components/ContentBoxTwoFloatingBadge.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import Faq from "../components/Faq2.astro";
import LatestWinners from "../components/LatestWinners4.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// IMAGE ROLES FOR THIS DROP (2026-09-25) — READ BEFORE REUSING THESE IMPORTS.
// Two files are referenced from this page and only two, both slides, both spent
// on a ContentBoxSevenThree* block — the family's hard cap of two per rebrand,
// so there is no third SevenThree here:
//   slide1.png — the poster whose Thai type reads "โปรโมชั่น แนะนำเพื่อน" over a
//     green badge "โบนัส 0.8%", so it belongs to docx H3 #4.
//   slide2.png — the mirrored poster reading "โปรโมชั่น คืนยอดเสีย" with a large
//     green-and-gold badge "โบนัส 0.3%", so it belongs to docx H3 #5.
// This pairing is the REVERSE of MIRACLE55's round, where slide1 carried the
// 0.3% artwork — the numbers printed on this drop's files are swapped, so these
// two imports must not be copied over from git history without reading the art.
// Both files are 600x400, so 600 is the top candidate width — nothing above it
// would be a real pixel. The alt text was written from the CURRENT artwork (the
// chrome BRAZIL / green 999 wordmark, the woman in the white blazer, the green
// and black chips, the fan of ace cards, the gold coins and small gold crown),
// never carried over from the previous brand's gold-wordmark strings — none of
// that is in these pictures.
//
// Deliberately NOT imported, and all still on disk as inventory:
//   banner2.png (2026-09-22), banner3.png (2026-08-11), slide3.png
//   (2026-09-18), slide4.png (2026-08-13) — every one predates this drop and
//   carries a previous client's artwork. There is therefore NO usable banner2+
//   this round and NO single-column inline illustration, which is the expected
//   outcome, not a gap to fill with a stale file.
//   banner1.png and banner1-mobile.png belong to MainLayout's own pinned globs
//   and are never referenced from a page — the hero is the LCP element, so
//   nothing here gets loading="eager" fetchpriority="high". og.png is the same:
//   MainLayout's glob owns it.
//
// DROPPED THIS ROUND, and none of the files deleted — every one is inventory for
// the next brand: ProviderGrid / ProviderGridPremium / FeaturedGames /
// PopularGamesStrip / GameRankingBoard each have to name specific studios, game
// titles or payout figures, and this brief names none at all — it says only
// "รวมเกมหลายประเภทไว้ให้เลือกจากบัญชีเดียว". BankStrip needs a deposit/withdrawal
// channel, which the brief also never mentions. SmoothCarousel is out because it
// would put slide* outside a ContentBoxSevenThree*. LottoGrid is out because
// BRAZIL999 is a casino brand, not เว็บหวย (which is also why /ตรวจหวย and
// /แนวทาง stay parked). FeatureHighlights is out because it emits an <h3> per
// item and the brief gives its 3 signup steps no per-step headings — the steps
// ship as a plain <ol> instead. Filling any of these in would be inventing facts.

// Title and description are the brief's own Title/Description lines, used
// verbatim. A brief-supplied description is never padded up to the 150-char
// floor and never topped up from the H1/H2 — this one is 129 characters.
const pageTitle = "BRAZIL999 คาสิโนแท้ จากบริษัทโดยตรง เว็บนี้ไม่มีประวัติโกง ตรวจสอบได้";

const pageDescription = "BRAZIL999 คาสิโนแท้ จากบริษัทโดยตรง เว็บนี้ไม่มีประวัติโกง สมาชิกสามารถเดิมพันได้อย่างมั่นใจ การันตีความปลอดภัย ตรวจสอบได้ทุกขั้นตอน";

// <Announcement /> runs bare: Announcement2's default message is already this
// brand's copy, and every sub-page calls it bare too — passing an override here
// is how the ticker ends up saying two different things on two pages.

// The docx has a real H2 -> H3 nesting this round: "แนะนำเพื่อน โบนัส 0.8%" and
// "คืนยอดเสีย โบนัส 0.3%" are genuine sub-points of the โปรโมชั่น H2, so the page
// is NOT flattened to H2-only. Those two are the only <h3> here, and each one is
// carried by its own ContentBoxSevenThree* block together with the slide whose
// artwork states that exact figure.
// Everything else is chrome and emits no heading tag: LatestWinners4,
// LoginRtpSection and ReviewCardSumo2 render their titles as <p>/<span> with an
// aria-label on the section, and Faq2's questions live inside <summary>.
// ContentBox3ThreeNeumorphism's three column captions are this page's own wording
// for splitting one docx paragraph into three readable columns, not docx
// sub-points, so heading={false} renders them as <p>.
// ContentBoxTwoFloatingBadge's and ContentBoxTwoCyberCut's column labels are <p>
// inside those components already.
//
// The docx checklist, in order, and what carries each one:
//    1 H1  BRAZIL999 คาสิโนแท้ จากบริษัทโดยตรง เว็บนี้ไม่มีประวัติโกง        ContentBoxFloatingBadge
//    2 H2  เดิมพัน BRAZIL999 การันตีความปลอดภัยทุกยูส                   ContentBox3ThreeNeumorphism
//    3 H2  สมาชิก BRAZIL999 รับการอัปเดตข่าวสารและโปรโมชั่นได้ก่อนใคร      ContentBoxSpecial
//    4 H3  แนะนำเพื่อน โบนัส 0.8%                                  ContentBoxSevenThreeNeumorphism + slide1
//    5 H3  คืนยอดเสีย โบนัส 0.3%                                   ContentBoxSevenThreeCyberCut + slide2
//    6 H2  สมัคร BRAZIL999 รับโปรโมชั่นง่ายๆ แค่ 3 ขั้นตอน                ContentBoxTwoFloatingBadge (intro + <ol>)
//    7 H2  ติดต่อเจ้าหน้าที่ผ่านไลน์ BRAZIL999 ได้ 24 ชั่วโมง               ContentBoxTwoCyberCut
//    8 H2  คำถามที่พบบ่อย                                          Faq2
// Final inventory for this page: h1 x1, h2 x5, h3 x2.
//
// Every docx paragraph ships in full. Two blocks are multi-column shells, so the
// paragraph that fills each is split across its columns and nowhere else:
// item 2's single paragraph fills the three Neumorphism columns in order, and
// item 3's fills ContentBoxSpecial's two halves. Reading the columns left ->
// centre -> right (and left -> right) reproduces each sentence word for word;
// nothing is summarised, merged or repeated.
//
// Vocabulary: this brief says ไลน์ / ช่องทางไลน์ — never "ไลน์แอด" (MIRACLE55's
// word) and never "LINE OFFICIAL" (KINGDOM66's). It names no game studio, no
// game type, no payout table, no license body, no deposit channel and no
// ฝากถอนไม่มีขั้นต่ำ, so neither does this page.

// One array, used by both <Faq> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last. The three pairs
// are the brief's own Q/A block, verbatim.
const faqs = [
  {
    q: "BRAZIL999 เป็นคาสิโนจากบริษัทโดยตรงหรือไม่?",
    a: "ตามข้อมูลที่เว็บไซต์ระบุ BRAZIL999 ใช้รูปแบบการเชื่อมต่อจากบริษัทโดยตรง ผู้ใช้งานควรตรวจสอบข้อมูลบริษัท ช่องทางอย่างเป็นทางการ และรายละเอียดของระบบเพิ่มเติมก่อนสมัครหรือทำรายการ",
  },
  {
    q: "BRAZIL999 มีโปรโมชั่นอะไรบ้าง?",
    a: "โปรโมชั่นหลักตามข้อมูลที่กำหนดมีโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% โดยแต่ละรายการมีเงื่อนไขและรอบรับสิทธิ์แตกต่างกัน ควรตรวจสอบรายละเอียดจากหน้าโปรโมชั่นก่อนกดรับทุกครั้ง",
  },
  {
    q: "ติดต่อเจ้าหน้าที่ BRAZIL999 ได้ตอนไหน?",
    a: "สามารถติดต่อเจ้าหน้าที่ผ่านช่องทางไลน์ที่เว็บไซต์กำหนดได้ตลอด 24 ชั่วโมง เพื่อสอบถามเรื่องบัญชี โปรโมชั่น ทางเข้าเกม หรือปัญหาการใช้งาน โดยทีมงานจะช่วยตรวจสอบตามข้อมูลที่แจ้งเข้ามา",
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// One highlight colour only: near-white #f4fbf2 against the body colour
// #dfeadd, so the brand green stays the page's structural accent and the
// paragraphs never compete with a heading for it.

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb. Every URL in the graph is derived
// by pageGraph from `site:` — no domain is typed out in this file, and no
// Review / AggregateRating / sameAs / address node is passed.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxFloatingBadge as="h1" title="BRAZIL999 คาสิโนแท้ จากบริษัทโดยตรง เว็บนี้ไม่มีประวัติโกง">
    <p class="text-left text-base leading-relaxed text-[#dfeadd]">
      BRAZIL999
      <strong class="text-[#f4fbf2]">นำเสนอระบบคาสิโนออนไลน์ที่เชื่อมต่อจากบริษัทโดยตรงตามข้อมูลของเว็บไซต์</strong>
      พร้อมรวมเกมหลายประเภทไว้ให้เลือกจากบัญชีเดียว ผู้ใช้งานสามารถตรวจสอบรายละเอียดเกม โปรโมชั่น และข้อมูลการใช้งานก่อนเริ่มเล่น
      <strong class="text-[#f4fbf2]">ช่วยให้เข้าถึงแต่ละเมนูได้ง่ายทั้งบนมือถือและคอมพิวเตอร์</strong>
    </p>
  </ContentBoxFloatingBadge>

  <ContentBox3ThreeNeumorphism as="h2" title="เดิมพัน BRAZIL999 การันตีความปลอดภัยทุกยูส" heading={false} titleleft="ระบบบัญชีสมาชิก" titlecenter="ตรวจสอบก่อนทำรายการ" titleright="ลดความเสี่ยง">
    <p slot="left" class="text-left text-base leading-relaxed text-[#dfeadd]">
      BRAZIL999
      <strong class="text-[#f4fbf2]">ให้ความสำคัญกับระบบบัญชีและการจัดการข้อมูลของสมาชิก</strong>
    </p>
    <p slot="center" class="text-left text-base leading-relaxed text-[#dfeadd]">
      โดยมีขั้นตอนเข้าสู่ระบบและจัดการรายการผ่านบัญชีส่วนตัว
      <strong class="text-[#f4fbf2]">ผู้ใช้งานควรตรวจสอบข้อมูล เงื่อนไข และช่องทางอย่างเป็นทางการของเว็บไซต์ก่อนทำรายการทุกครั้ง</strong>
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#dfeadd]">เพื่อช่วยลดความเสี่ยงจากการเข้าใช้งานผ่านช่องทางที่ไม่ถูกต้อง</p>
  </ContentBox3ThreeNeumorphism>

  <ContentBoxSpecial as="h2" title="สมาชิก BRAZIL999 รับการอัปเดตข่าวสารและโปรโมชั่นได้ก่อนใคร" iconleft="📣" iconright="🎁">
    <p slot="left" class="text-left text-base leading-relaxed text-[#dfeadd]">
      สมาชิก BRAZIL999 สามารถติดตามข่าวสารและโปรโมชั่นที่เว็บไซต์อัปเดตตามช่วงเวลา
      <strong class="text-[#f4fbf2]">โดยมีทั้งโบนัสแนะนำเพื่อนและโบนัสคืนยอดเสีย</strong>
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#dfeadd]">
      พร้อมรายละเอียดเกี่ยวกับยอดที่เข้าเกณฑ์และวิธีรับสิทธิ์
      <strong class="text-[#f4fbf2]">ช่วยให้ตรวจสอบโปรโมชั่นล่าสุดและเลือกใช้สิทธิ์ได้ตรงกับเงื่อนไขของแต่ละรายการ</strong>
    </p>
  </ContentBoxSpecial>

  <ContentBoxSevenThreeNeumorphism as="h3" title="แนะนำเพื่อน โบนัส 0.8%">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[340, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), 384px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นพื้นดำ-เขียว ด้านบนกลางภาพเป็นโลโก้ BRAZIL999 ตัวอักษร BRAZIL สีโครเมียมเงินและเลข 999 สีเขียวสด ใต้ลงมามีมงกุฎทองดวงเล็กเหนือตัวอักษรไทยสีขาวและเขียวว่า โปรโมชั่น แนะนำเพื่อน และป้ายสีเขียวเขียนว่า โบนัส 0.8% ด้านขวาเป็นหญิงสาวผมยาวสีเข้มสวมเบลเซอร์สีขาว ยิ้มและชี้นิ้วชี้ทั้งสองข้างมาที่ข้อความ รอบตัวมีชิปคาสิโนสีเขียวสลับดำและไพ่เอซกระจายอยู่"
      class="mx-auto h-auto w-full rounded-2xl border border-[#22c55e]/55 shadow-[0_10px_30px_rgba(34,197,94,0.3)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#dfeadd]">
      สมาชิก BRAZIL999
      <strong class="text-[#f4fbf2]">ที่แนะนำเพื่อนเข้ามาสมัครสามารถรับโบนัส 0.8% ตามเงื่อนไขของโปรโมชั่น</strong>
      ระบบมีรายละเอียดเกี่ยวกับยอดที่เข้าเกณฑ์และขั้นตอนรับสิทธิ์ให้ตรวจสอบ
      <strong class="text-[#f4fbf2]">ช่วยให้ติดตามโบนัสจากกิจกรรมแนะนำเพื่อนได้สะดวกผ่านบัญชีสมาชิก</strong>
    </p>
  </ContentBoxSevenThreeNeumorphism>

  <ContentBoxSevenThreeCyberCut as="h3" title="คืนยอดเสีย โบนัส 0.3%">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[340, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), 352px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นชุดเดียวกันพื้นดำ-เขียวแต่สลับด้าน ด้านซ้ายเป็นหญิงสาวผมยาวสีเข้มสวมเบลเซอร์สีขาว ถือไพ่เอซคลี่เป็นพัดและชี้มืออีกข้างไปที่ข้อความ มุมขวาบนเป็นโลโก้ BRAZIL999 ตัวอักษร BRAZIL สีโครเมียมเงินและเลข 999 สีเขียวสด ถัดลงมาเป็นตัวอักษรไทยว่า โปรโมชั่น คืนยอดเสีย และป้ายสีเขียวขอบทองขนาดใหญ่เขียนว่า โบนัส 0.3% ตามขอบล่างมีเหรียญทอง มงกุฎทอง และชิปคาสิโนสีเขียวสลับดำ"
      class="mx-auto h-auto w-full rounded-2xl border border-[#aab4bf]/40 shadow-[0_10px_30px_rgba(4,10,5,0.85)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#dfeadd]">
      <strong class="text-[#f4fbf2]">โปรโมชั่นคืนยอดเสียของ BRAZIL999 ให้โบนัส 0.3% ตามยอดและเงื่อนไขที่กำหนด</strong>
      สมาชิกสามารถตรวจสอบรอบคำนวณ ยอดที่เข้าเกณฑ์ และรายละเอียดก่อนกดรับสิทธิ์
      <strong class="text-[#f4fbf2]">ช่วยให้ติดตามโบนัสในแต่ละรอบได้ง่ายและรู้เงื่อนไขก่อนนำไปใช้งาน</strong>
    </p>
  </ContentBoxSevenThreeCyberCut>

  <ContentBoxTwoFloatingBadge as="h2" title="สมัคร BRAZIL999 รับโปรโมชั่นง่ายๆ แค่ 3 ขั้นตอน" titleleft="รายละเอียดการสมัคร" titleright="3 ขั้นตอนหลัก">
    <p slot="left" class="text-left text-base leading-relaxed text-[#dfeadd]">
      <strong class="text-[#f4fbf2]">การสมัคร BRAZIL999 สามารถทำผ่านหน้าเว็บไซต์ได้ด้วยตัวเอง</strong>
      ขั้นตอนไม่ซับซ้อน หลังจากยืนยันบัญชีเรียบร้อยสามารถเข้าสู่ระบบเพื่อตรวจสอบเกมและโปรโมชั่นที่เปิดให้รับได้
      <strong class="text-[#f4fbf2]">โดยมีขั้นตอนหลักเพียง 3 ขั้นตอนดังนี้</strong>
    </p>
    <ol slot="right" class="flex list-decimal flex-col gap-4 pl-6 text-left text-base leading-relaxed text-[#dfeadd] marker:font-black marker:text-[#7cf25c]">
      <li>เปิดหน้าสมัคร BRAZIL999 แล้วกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน</li>
      <li>ตรวจสอบข้อมูลส่วนตัวและรายละเอียดบัญชีให้ถูกต้องก่อนกดยืนยัน</li>
      <li>ยืนยันการสมัครและเข้าสู่ระบบ จากนั้นเลือกเกมและตรวจสอบโปรโมชั่นที่เปิดให้สมาชิกได้ทันที</li>
    </ol>
  </ContentBoxTwoFloatingBadge>

  <ContentBoxTwoCyberCut as="h2" title="ติดต่อเจ้าหน้าที่ผ่านไลน์ BRAZIL999 ได้ 24 ชั่วโมง" titleleft="ช่องทางไลน์ตลอด 24 ชั่วโมง" titleright="สมัครสมาชิกและเริ่มใช้งาน">
    <p class="text-left text-base leading-relaxed text-[#dfeadd]">
