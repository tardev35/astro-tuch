---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import LatestWinners from "../components/LatestWinnersPremium.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import Faq from "../components/Faq2.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import { pageGraph } from "../lib/schema";
import imgCashback from "../assets/slide2.png";
import imgReferral from "../assets/slide1.png";

// VARIANT ROTATION THIS ROUND, decided in .claude/brand-spec-tkb55.md §3 and NOT
// re-picked here: Announcement5 replaces Announcement3, LatestWinnersPremium
// replaces LatestWinners3, Faq2 replaces Faq4, ReviewCardSumo replaces
// ReviewCardSumo2, and the ContentBox shape-mix leaves Premium / TwoNeumorphism /
// SevenThreeFloatingBadge / SevenThree / 3ThreeCyberCut / Neumorphism behind for
// CyberCut / TwoPremium / SevenThreePremium / SevenThreeNeumorphism / Special /
// FloatingBadge. NavbarStyle9 + FooterStyle2 are the layout's pair this round and
// the brand font moves google-sans -> kanit; all of that is the orchestrator's
// shared-chrome step, not this page's.
// Plain ContentBox is the one sanctioned carry-over (brand-spec §3): it is the
// always-live box that terms, privacy, 404 and the button pages render through, so
// it cannot follow a rotation. Section 3 is the single docx section it carries.
// ContentBoxTwo is live too but is NOT imported here — it is reached only through
// LoginRtpSection, so an "is it used?" grep has to match the bare filename.
// Every unused *Premium / *Cyber / *Huay / *FloatingBadge / *Style sibling, the
// other Faq* and Announcement* files, the other LatestWinners* and the previous
// ReviewCardSumo2 all stay on disk as inventory for the next brand — nothing was
// deleted, and the earlier brands' hues still inside them are expected drift.
//
// <Announcement /> runs bare on purpose: Announcement5's default message is already
// this brand's copy, set by the orchestrator from this brief, and every sub-page
// calls it bare too — so passing an override here is exactly how the ticker ends up
// saying two different things on two pages of the same site.
//
// PALETTE — BLOOD RED + CHROME SILVER ON PURE BLACK (brand-spec §2). Read off the
// artwork: the logo is the word TKB in vivid-red 3-D lettering followed by 55 in
// polished chrome silver, with a masked cartoon burglar mascot carrying a $ money
// bag above it. The banner and both slides are the same pure-black studio scene lit
// with red light ribbons — a silver-haired couple in black-and-red formalwear,
// red/black/silver casino chips, black ace cards, red dice, flowing red satin and a
// roulette wheel. There is no gold, violet, pink, blue, cyan, green or orange in
// this drop at all.
// ⚠️ The page background is PURE BLACK #000000 (bg.json), so nothing on this page
// may sink below it. Depth ramp: #2a0d0f raised / #1a0708 mid / #0d0304 sunken /
// #000000 page.
// ⚠️ Compare by VALUE, never by colour family — RED is this round's trap, this
// template has shipped red brands before and their values are still in inventory
// files: SUPERSLOTCLUB #e8232a (R=232), PIGPG #d4200d (R=212), FLASH877 #ff3b14
// (R=255 G=59). This brand's primary is #fb131b (R=251 G=19 B=27), measured from
// logo.webp in this drop, and is none of those. The outgoing brand TSDET911 was
// electric blue + chrome (#0360f3 #0292fb #6ec8ff #4fb4ff #cfdcec #9db4d4 #dde8f7
// #102a5e #0a1c42 #040e26 #00081f #032dad #04186e #041a43 #021026) and not one of
// those values survives on this page. This round's chrome silver is #e9eef4 /
// #aeb9c6, which is NOT TSDET911's #cfdcec / #9db4d4.
// Body copy is #f2e4e5 (= BRAND_TEXT), 17.0:1 on the page background and 14.5:1 on
// the raised surface. The ONE highlight colour a <strong> may take is #ff8a8f
// (7.8:1) — unlike #e9eef4 / #aeb9c6, which are the chrome heading and secondary
// values, and unlike #ff4d55, which is links/hover and large headings only.
// #fb131b, #c40304, #8a0206 and #53050a never carry text at any size: they are
// borders, plates, rules, gradient ends and glows. #1a0304 is the only ink allowed
// on a light or solid-red fill. Glow rgba is rgba(251,19,27,α), rgba(196,3,4,α),
// rgba(255,138,143,α) or rgba(233,238,244,α).
//
// IMAGE ROLES FOR THIS DROP (2026-10-13, brand-spec §4). Two files are referenced
// from this page and only two, and each pairing is read off the artwork itself —
// the percentage printed ON the slide has to match the heading its block carries,
// or the picture contradicts the section above it.
// ⚠️ brand-spec §4 has the two FILENAMES swapped. Both slides were opened and read
// before writing this page, and the artwork on disk is:
//   slide2.png — square 600x600, the CASHBACK poster. Burglar mascot + the TKB/55
//     wordmark top left; the couple at the right (black three-piece suit with a red
//     tie beside a red satin gown); stacked at the left a small silver crown, then
//     โปรโมชั่น in huge 3-D white-silver type, then a black red-edged plate reading
//     คืนยอดเสีย with 0.3% in vivid red. Red satin, red/black/silver chip stacks and
//     a roulette wheel fill the rest. It prints the §4 offer, so it goes to §4.
//     Imported as imgCashback.
//   slide1.png — the companion square, the REFERRAL poster. Same mascot and
//     wordmark top left; at the right the man in a black suit with a red tie beside
//     the woman in a red sequin dress with a black fur stole; stacked at the left a
//     crown, โปรโมชั่น, a black red-edged plate reading แนะนำเพื่อน and below it
//     โบนัส 0.8% with the 0.8% oversized. Red dice, ace cards and red chip stacks
//     along the bottom. It prints the §5 offer, so it goes to §5. Imported as
//     imgReferral.
// The file-number ordering in brand-spec §4 is therefore NOT followed; the printed
// offer is. The two variants' own frontmatter reached the same reading
// independently, so three sources agree against the spec's filename column.
// Both slides are 600x600 on disk, so 600 is the top real candidate — anything
// above it would not be a real pixel — and each picture carries max-w-[600px] so
// the art is never upscaled past its own bitmap.
// Each slide sits in a ContentBoxSevenThree* image+text block, which is that
// family's hard cap of two per rebrand, so there is no third SevenThree anywhere on
// the site and no slide appears outside those two blocks.
// Both blocks lay out md:grid-cols-[7fr_3fr] with the TEXT column first, so each
// picture goes in slot="right": the heading always lands on the prose, never on the
// picture, and on a phone the single column reads heading, text, picture rather
// than opening with an image. Each `sizes` therefore describes its own 3fr column
// rather than the viewport, and both were taken from the arithmetic block inside
// the variant that owns them — they are NOT last round's numbers, because the two
// variants cap different boxes and pay different padding:
//   ContentBoxSevenThreePremium (§4)      >= 1280px : 297px
//     (max-w-7xl 1280 + px-4 32, border 2, md..1279 : calc(30vw - 87px)
//      md:p-10 80, gap-10 40, md:pl-10    698..767  : 600px (bitmap cap)
//      + md:border-l = 41)                < 698     : calc(100vw - 98px)
//     (1280-32-2-80-40) x 0.3 - 41 = 296.8
//   ContentBoxSevenThreeNeumorphism (§5)  >= 1280px : 312px
//     (max-w-7xl 1280 + px-4 32, border 2, md..1279 : calc(30vw - 72px)
//      flat p-8 64, gap-8 32, md:pl-8     698..767  : 600px (bitmap cap)
//      + md:border-l = 33)                < 698     : calc(100vw - 98px)
//     (1280-32-2-64-32) x 0.3 - 33 = 312
// Both cards collapse to a single p-8 column below md (768), where the drawn width
// is 100vw - 98 and crosses the 600px bitmap at a 698px viewport.
// Neither is the LCP element — MainLayout's hero banner is — so both are
// loading="lazy" fetchpriority="low" decoding="async" and neither takes
// fetchpriority="high". formats/fallbackFormat/quality stay at the house values:
// tools/avif-quality-service.mjs rescales AVIF quality on its own, so quality={80}
// must not be hand-tuned per format.
//
// The alt text was written from THIS drop's artwork (brand-spec §4 transcribes what
// is actually drawn on each slide), not carried over from the outgoing brand's blue
// and chrome set, and neither alt is a counter like "the second image" — each
// describes its own picture.
//
// Deliberately NOT imported, and every file still on disk: the two higher-numbered
// banners (10-08 and 09-27) are previous brands' article art, and the two
// higher-numbered slides (09-29) are an older brand's posters. Importing any of them
// emits a competitor's picture into dist/ — an eager import IS an emit, rendered or
// not — and turns verify-build red. There is therefore NO current-drop article
// illustration this round, and a slide is never substituted for one. banner1 and its
// mobile crop belong to MainLayout's own pinned globs and are never referenced from
// a page; og.png is the same, MainLayout owns it.
// Also deliberately unused, and named without the file extension on purpose, because
// the playbook's "is this component live?" check is a bare-filename grep:
// ProviderGrid and GameRankingBoard have nothing to carry because the brief names no
// game studio and no ranking; SmoothCarousel has no brief section asking for a
// carousel; BankStrip already renders inside the active footer; and FeatureHighlights
// has nothing to carry either, because the brief's two H3s are real docx headings
// with full paragraphs under them rather than a labelled sub-list — they take their
// own SevenThree blocks.
//
// VOCABULARY — brand-spec §7, the brief's own words only. This is a CASINO + SPORTS
// brand and the only four game words on the page are บาคาร่า, ไฮโล, บอล (บอลออนไลน์)
// and สล็อต. Everything the copy says traces to src/assets/content.txt:
// เว็บคาสิโนไทย, เซิร์ฟเวอร์ต่างประเทศ, ยอดเข้าบริษัทโดยตรง, ฝากถอนทุกธนาคาร,
// แพลตฟอร์มเดียว, บัญชีเดียว, หมวดเกม, เกมไพ่, ลูกเต๋า, เกมวงล้อทั่วไป, ฟรีสปิน,
// ฟีเจอร์โบนัส, รายการแข่งขัน, อัตราต่อรอง, ตารางจ่าย, กติกา, ยอดเดิมพันขั้นต่ำ,
// วิธีตัดสินผล, ตรวจสอบเครดิต, 24 ชั่วโมง, โบนัสคืนยอดเสีย 0.3%, เข้ายูสทุกวัน,
// รอบประจำวัน, เวลาตัดยอด, ยอดที่เข้าเกณฑ์, แนะนำเพื่อน, โบนัส 0.8%, ไม่จำกัด,
// ลิงก์แนะนำ, ชื่อนิติบุคคล, ชื่อบัญชีรับเงิน, หลักฐานธุรกรรม, แอดมิน, รหัสผ่าน, PIN,
// OTP, ชื่อคู่แข่งขัน, หมายเลขรายการ.
// ⚠️ The outgoing brand TSDET911 sold เว็บพนันลิขสิทธิ์ไทยแท้ / ผ่านเซิร์ฟไทย 100% /
// ไม่มีขั้นต่ำ / สมัครเล่น 3 ขั้นตอน. NONE of that framing exists in this brief and
// none of it survived: this page was written FROM the brief rather than
// find-and-replaced over the old sentences. This brief's framing is
// เซิร์ฟเวอร์ต่างประเทศ / ยอดเข้าบริษัทโดยตรง / ฝากถอนทุกธนาคาร.
// There is no lottery wording anywhere, because this is not a lottery brand.
// Nothing here claims a licence number, a regulator, a legal-entity name, a game
// studio, a bank, an RTP figure, a deposit minimum, a member count, a founding year
// or a server location more specific than ต่างประเทศ, because the brief names none.
// The only figures on the page are the brief's own three: 0.3%, 0.8% and 24 ชั่วโมง.
// The brief hedges six separate times (brand-spec §5) and every one of those clauses
// is part of its paragraph below, not trimmed as downbeat filler.
//
// The brief, the artwork and the operator's prompt all agree on the brand name. Even
// so the name is never typed on the page: it is interpolated from ${BRAND_NAME} so it
// can never drift from brandProfile. No domain is written out anywhere here and no
// URL is built with `+`.
//
// Title and description are the brief's own Title/Description lines (content.txt
// lines 1-2) verbatim, with the brand name interpolated. They are NOT padded up to
// 150 characters — verify-build deliberately skips its 150-character floor on the
// home page for exactly this reason. Both strings are byte-identical to the defaults
// the orchestrator set in MainLayout.astro, which is what makes passing them here a
// no-op rather than a second source of truth.
const pageTitle = `${BRAND_NAME} เว็บคาสิโนไทย เซิร์ฟต่างประเทศ ยอดเข้าบริษัทโดยตรง`;

const pageDescription = `${BRAND_NAME} เว็บคาสิโนไทย เข้าเล่นปลอดภัย ด้วยเซิร์ฟต่างประเทศ บาคาร่า ไฮโล บอล สล็อต ครบ ฝากถอนทุกธนาคาร ยอดเข้าบริษัทโดยตรง`;

// The brief has a real H2 -> H3 nesting this round, so the page is NOT flattened to
// H2-only. The two H3s are the docx's own H3 lines — the two promotion sub-points
// that sit under section 3's โปรโมชั่น H2 in the brief's own outline. There is no
// FeatureHighlights H3 exception this round, and no component rendered here emits a
// hardcoded heading, so the printed h3 count stays at exactly 2.
//
// The checklist, in document order, and what carries each one:
//    1 H1  ${BRAND_NAME} เว็บพนันคาสิโนไทย เข้าเล่นปลอดภัย ด้วยเซิร์ฟต่างประเทศ
//          ContentBoxCyberCut, brief paragraph on line 4
//    2 H2  เว็บพนันคาสิโน ${BRAND_NAME} บาคาร่า ไฮโล บอล สล็อต ครบ
//          ContentBoxTwoPremium, line 6 left / line 7 right
//    3 H2  โปรโมชั่นเดิมพัน ${BRAND_NAME} เว็บพนันคาสิโนเซิร์ฟต่างประเทศ
//          ContentBox (the plain, always-live variant), line 9
//    4 H3  โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสทุกวัน
//          ContentBoxSevenThreePremium + slide2 (imgCashback), line 11
//    5 H3  โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด
//          ContentBoxSevenThreeNeumorphism + slide1 (imgReferral), line 13
//    6 H2  ระบบฝากถอน ${BRAND_NAME} ยอดเข้าบริษัทโดยตรง
//          ContentBoxSpecial, line 15 left / line 16 right
//    7 H2  แอดมิน ${BRAND_NAME} เปิดบริการ 24 ชั่วโมง
//          ContentBoxFloatingBadge, lines 18 and 19
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ ${BRAND_NAME}
//          Faq2 + faqs prop, lines 21-26
// Final inventory for this page: h1 x1, h2 x5, h3 x2.
//
// SHAPE RHYTHM, top to bottom — no two adjacent sections read as the same card, and
// each neighbour pair differs in at least two of {corner, surface depth, heading
// treatment}:
//   §1 CLIPPED corners (40px, top-left/bottom-right) GRADED from RAISED #2a0d0f down
//      to MID #1a0708, four corner rules crossing red against chrome, heading
//      gradient #ff4d55 -> #e9eef4 -> #aeb9c6 behind a thick red left rail
//   §2 rounded-3xl on flat MID #1a0708 in a deep-red frame, heading gradient
//      #aeb9c6 -> #ff4d55 -> #e9eef4 beside a vertical red spark, two columns split
//      by a #53050a rule
//   §3 rounded-3xl on flat RAISED #2a0d0f with a top hairline and a 20px underline
//      rule, heading gradient #e9eef4 -> #ff8a8f -> #fb131b (the always-live box;
//      its treatment is fixed by the orchestrator)
//   §4 rounded-3xl GRADED from RAISED #2a0d0f to SUNKEN #0d0304 in a #8a0206 frame,
//      two corner auras, heading gradient #e9eef4 -> #aeb9c6 -> #ff4d55, picture right
//   §5 rounded-[25px] NEUMORPHIC on MID #1a0708 with NO gradient and twin shadows
//      (#0d0304 pressed, #53050a lifted), heading SOLID #ff4d55 — the only solid
//      single-colour heading on the page, picture right
//   §6 rounded-3xl on RAISED #2a0d0f with the two halves dropped to SUNKEN #0d0304
//      inside their own frames, heading gradient #aeb9c6 -> #e9eef4 -> #fb131b,
//      icon plates in opposite polarity (solid chrome vs dark red-framed)
//   §7 rounded-2xl GRADED from RAISED #2a0d0f to MID #1a0708 in a 2px brand-red
//      frame, heading INVERTED into a floating chrome plate carrying #1a0304 ink —
//      the opposite polarity of every other heading here
//   §8 clipped accordion rows on SUNKEN #0d0304 behind a centred title, heading
//      gradient #fb131b -> #ff4d55 -> #e9eef4, questions inside <summary> as <span>
// The two graded red-framed cards (§4, §7) are four sections apart and differ in
// corner, frame weight and heading polarity. The two flat-surface boxes (§2, §3) are
// adjacent but differ in surface depth (mid vs raised), heading gradient direction
// (chrome-first vs chrome-to-red) and column count. No two headings run the same
// order of the same ramps.
//
// ContentBoxSevenThreePremium and ContentBoxSevenThreeNeumorphism both take the docx
// heading through `title`, which falls back to their wide (7fr) LEFT text column;
// neither is passed a `titleright`, so each block emits exactly one heading and the
// picture column never carries one. ContentBoxTwoPremium is passed no `titleleft`/
// `titleright` either — the brief gives §2 two running paragraphs with no sub-labels,
// and inventing a pair here would be this page's own wording rather than the docx's.
// ContentBoxSpecial keeps its default 🏦 / 🧾 icons: a company bank account and a
// transaction record, which is exactly what §6's two paragraphs are about, and both
// sit inside an aria-hidden box so neither joins an accessible name.
//
// Every brief paragraph ships in full — nothing merged, nothing summarised. §2 and
// §6 run one paragraph per column, and §7 is the only single slot that receives more
// than one paragraph: it wraps them in ONE <div class="flex flex-col gap-4"> as the
// house rule requires, because that card would otherwise take two siblings into one
// slot.
//
// Everything else on the page is chrome and emits no heading tag at any level:
// Announcement5, LatestWinnersPremium, LoginRtpSection and ReviewCardSumo render
// their titles as <p>/<span> with an aria-label on the section, and Faq2's questions
// live inside <summary> as <span>. The non-brief widgets sit before section 1 (the
// ticker, then the winners feed) and after section 8 (LoginRtpSection,
// ReviewCardSumo, Navfoot) — never spliced between two content sections.

// One array, used by both <Faq> and the FAQPage node — never the component's own
// defaults (Faq2 deliberately ships an empty list, so a forgotten prop renders an
// empty accordion rather than some previous brand's questions). The three pairs are
// the brief's own Q/A block (content.txt lines 21-26), verbatim.
const faqs = [
  {
    q: `${BRAND_NAME} มีเกมคาสิโนและการเดิมพันประเภทใดให้เลือกบ้าง?`,
    a: `${BRAND_NAME} นำเสนอเกมหลายประเภท ได้แก่ บาคาร่า ไฮโล บอลออนไลน์ และสล็อต โดยจำนวนเกมและค่ายที่เปิดให้บริการจริงขึ้นอยู่กับระบบ สมาชิกควรตรวจสอบกติกา ช่วงเดิมพัน และเงื่อนไขของแต่ละรายการก่อนเริ่มเล่น`,
  },
  {
    q: `${BRAND_NAME} ฝากถอนผ่านทุกธนาคารและเข้าบัญชีบริษัทโดยตรงจริงหรือไม่?`,
    a: `เว็บไซต์ระบุว่ารองรับการฝากถอนผ่านธนาคารและบัญชีบริษัทโดยตรง แต่ควรตรวจสอบรายชื่อธนาคารที่ใช้งานได้จริง รวมถึงชื่อบัญชีและข้อมูลนิติบุคคลก่อนทำธุรกรรม เพื่อให้ข้อมูลตรงกับช่องทางหลักของเว็บไซต์`,
  },
  {
    q: `${BRAND_NAME} มีโปรโมชั่นอะไร และติดต่อแอดมินได้ตอนไหน?`,
    a: `โปรโมชั่นหลักตามข้อมูลที่กำหนดมี คืนยอดเสีย 0.3% และ แนะนำเพื่อน 0.8% โดยแต่ละรายการมีเงื่อนไขแตกต่างกัน ส่วนแอดมินระบุว่าเปิดให้บริการตลอด 24 ชั่วโมง สมาชิกควรตรวจสอบช่องทางติดต่อหลักและเวลาตอบกลับจริงจากหน้าเว็บไซต์`,
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space that
// splits the word — the copy must read identically with the tags removed. No two
// <strong> elements are adjacent either: every pair is separated by at least one run
// of plain text, so the whitespace between them can never collapse into a missing
// space.
// One highlight colour only: #ff8a8f, against the inherited body colour #f2e4e5
// (BRAND_TEXT). The paragraphs below carry no colour class of their own: every
// ContentBox* card in this mix already sets
// `text-left text-base leading-relaxed text-[#f2e4e5]` on the element holding the
// slot, so the prose inherits it and no page-level override can drift from the card.
// No paragraph carries mx-auto or max-w-* either — the cards cap their own width,
// and the only max-w-* on the page is the one capping each slide, which is an image
// and not prose. No slot's copy names a colour.

// No breadcrumb: this is the homepage, so a trail from the root to itself would be a
// single self-referential crumb. Every URL in the graph is derived by pageGraph from
// `site:` — no domain is typed out in this file, no URL is built with `+`, and no
// Review / AggregateRating / sameAs / address / email node is passed. `description`
// is the exact same string MainLayout gets, and `faqs` is the exact same array <Faq>
// gets.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <LatestWinners />

  <ContentBoxCyberCut as="h1" title={`${BRAND_NAME} เว็บพนันคาสิโนไทย เข้าเล่นปลอดภัย ด้วยเซิร์ฟต่างประเทศ`}>
    <p>
      {BRAND_NAME} เว็บพนันคาสิโนไทยที่นำเสนอระบบเดิมพันออนไลน์ผ่านแพลตฟอร์มเดียว พร้อมรวมเกมคาสิโนและกีฬาไว้หลายประเภท
      <strong class="text-[#ff8a8f]">ทั้งบาคาร่า ไฮโล บอล และสล็อต</strong>
      รองรับการใช้งานผ่านมือถือและคอมพิวเตอร์ สมาชิกสามารถค้นหาเกม ตรวจสอบเครดิต และติดตามรายการต่างๆ ได้สะดวก โดยเว็บไซต์ระบุว่าใช้เซิร์ฟเวอร์ต่างประเทศเพื่อรองรับการเข้าใช้งาน
      <strong class="text-[#ff8a8f]">ส่วนความปลอดภัยและตำแหน่งเซิร์ฟเวอร์จริงควรมีข้อมูลทางเทคนิคและรายละเอียดผู้ให้บริการที่สามารถตรวจสอบได้ประกอบ</strong>
    </p>
  </ContentBoxCyberCut>

  <ContentBoxTwoPremium as="h2" title={`เว็บพนันคาสิโน ${BRAND_NAME} บาคาร่า ไฮโล บอล สล็อต ครบ`}>
    <p slot="left">
      เว็บคาสิโน {BRAND_NAME} รวบรวมเกมเดิมพันหลายประเภทไว้ให้เลือกตามความสนใจ
      <strong class="text-[#ff8a8f]">โดยบาคาร่าเป็นเกมไพ่ที่มีตัวเลือกการเดิมพันตามกติกา ไฮโลใช้ผลจากลูกเต๋าในการตัดสิน</strong>
      ส่วนบอลออนไลน์มีรายการแข่งขันและอัตราต่อรองให้ตรวจสอบก่อนทำรายการ
      <strong class="text-[#ff8a8f]">ขณะที่เกมสล็อตมีทั้งเกมวงล้อทั่วไป ฟรีสปิน และฟีเจอร์โบนัสจากค่ายที่เปิดให้บริการ</strong>
      ช่วยให้ผู้ใช้งานเข้าถึงหมวดเกมต่างๆ ผ่านบัญชีเดียว
    </p>
    <p slot="right">
      แต่ละเกมมีรูปแบบการเดิมพันและเงื่อนไขแตกต่างกัน
      <strong class="text-[#ff8a8f]">สมาชิกควรตรวจสอบกติกา ตารางจ่าย ยอดเดิมพันขั้นต่ำ และวิธีตัดสินผลก่อนเริ่มเล่น</strong>
      โดยเฉพาะการเดิมพันฟุตบอลที่อัตราต่อรองอาจเปลี่ยนแปลงตามช่วงเวลา ส่วนเกมคาสิโนมีผลลัพธ์ตามกติกาของแต่ละประเภท
      <strong class="text-[#ff8a8f]">และไม่มีเกมใดรับประกันว่าจะได้รับกำไรทุกครั้ง</strong>
    </p>
  </ContentBoxTwoPremium>

  <ContentBox as="h2" title={`โปรโมชั่นเดิมพัน ${BRAND_NAME} เว็บพนันคาสิโนเซิร์ฟต่างประเทศ`}>
    <p>
      โปรโมชั่นเดิมพัน {BRAND_NAME} มีสิทธิพิเศษสำหรับสมาชิกตามกิจกรรมที่เว็บไซต์กำหนด
      <strong class="text-[#ff8a8f]">โดยเน้นโบนัสคืนยอดเสียและกิจกรรมแนะนำเพื่อน</strong>
      ผู้ใช้งานสามารถตรวจสอบยอดที่เข้าเกณฑ์ รอบคำนวณ และสถานะการรับสิทธิ์ผ่านบัญชีสมาชิกตามระบบที่เปิดให้บริการ
      <strong class="text-[#ff8a8f]">ทั้งนี้ควรตรวจสอบว่าโปรโมชั่นครอบคลุมบาคาร่า ไฮโล บอล หรือสล็อตประเภทใดบ้าง</strong>
      เพราะแต่ละกิจกรรมอาจกำหนดเงื่อนไขไม่เหมือนกัน
    </p>
  </ContentBox>

  <ContentBoxSevenThreePremium as="h3" title="โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสทุกวัน">
    <p slot="left">
      สมาชิก {BRAND_NAME} ที่มียอดเสียตรงตามข้อกำหนดสามารถตรวจสอบสิทธิ์รับ
      <strong class="text-[#ff8a8f]">โบนัสคืนยอดเสีย 0.3% ตามรอบประจำวันที่เว็บไซต์กำหนด</strong>
      โดยระบบจะนำยอดที่เข้าเกณฑ์มาคำนวณก่อนแสดงจำนวนโบนัส หากรองรับการโอนโบนัสเข้ายูสอัตโนมัติ สมาชิกสามารถตรวจสอบยอดและประวัติการรับสิทธิ์ผ่านบัญชีได้
      <strong class="text-[#ff8a8f]">ควรอ่านรายละเอียดประเภทเกมที่ร่วมรายการ เวลาตัดยอด และเงื่อนไขการใช้โบนัสก่อนรับทุกครั้ง</strong>
    </p>
    <Picture
      slot="right"
      src={imgCashback}
      loading="lazy"
      fetchpriority="low"
      widths={[297, 480, 600]}
      sizes="(max-width: 697px) calc(100vw - 98px), (max-width: 767px) 600px, (max-width: 1279px) calc(30vw - 87px), 297px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt={`ภาพโปรโมชั่นคืนยอดเสียของ ${BRAND_NAME} เป็นงานอาร์ตสี่เหลี่ยมจัตุรัสบนฉากสตูดิโอคาสิโนสีดำสนิทที่ส่องด้วยริบบิ้นแสงสีแดง มุมซ้ายบนเป็นมาสคอตโจรการ์ตูนใส่หน้ากากสีดำแบกถุงเงินที่มีเครื่องหมายดอลลาร์ ใต้ลงมาเป็นโลโก้ ${BRAND_NAME} ที่ตัวอักษรเป็นสีแดงสามมิติต่อด้วยตัวเลขสีเงินโครเมียมขัดเงา ฝั่งขวาเป็นชายหนุ่มผมสีขาวเงินในชุดสูทสามชิ้นสีดำกับเนกไทสีแดง ยืนเคียงหญิงสาวผมสีขาวเงินในชุดราตรียาวผ้าซาตินสีแดง ฝั่งซ้ายเรียงซ้อนกันเป็นมงกุฎเล็กสีเงิน ถัดลงมาเป็นคำว่า โปรโมชั่น ตัวอักษรสามมิติสีขาวอมเงินขนาดใหญ่ และใต้ลงไปเป็นแถบป้ายสีดำขอบแดงที่เขียนว่า คืนยอดเสีย คู่กับเลข 0.3% สีแดงสด ขอบล่างเป็นกองชิปคาสิโนสีแดงสลับดำและเงิน ผ้าซาตินสีแดงพลิ้ว และวงล้อรูเล็ตกับไพ่อยู่ด้านหลัง`}
      class="mx-auto h-auto w-full max-w-[600px] rounded-2xl border border-[#fb131b]/60 shadow-[0_0_28px_rgba(251,19,27,0.32)]"
    />
  </ContentBoxSevenThreePremium>

  <ContentBoxSevenThreeNeumorphism as="h3" title="โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด">
    <p slot="left">
      โปรโมชั่นแนะนำเพื่อน {BRAND_NAME}
      <strong class="text-[#ff8a8f]">ระบุอัตราโบนัส 0.8% จากยอดที่เข้าเกณฑ์ตามข้อกำหนด</strong>
      สมาชิกสามารถตรวจสอบรายละเอียดลิงก์แนะนำ จำนวนเพื่อนที่สมัคร และวิธีคำนวณโบนัสผ่านระบบสมาชิก
      <strong class="text-[#ff8a8f]">ส่วนคำว่าไม่จำกัดควรระบุให้ชัดว่าหมายถึงจำนวนเพื่อนที่แนะนำ จำนวนครั้งในการรับสิทธิ์ หรือยอดโบนัสสูงสุด</strong>
      เพื่อให้เข้าใจเงื่อนไขของกิจกรรมตรงกัน
    </p>
    <Picture
      slot="right"
      src={imgReferral}
      loading="lazy"
      fetchpriority="low"
      widths={[312, 480, 600]}
      sizes="(max-width: 697px) calc(100vw - 98px), (max-width: 767px) 600px, (max-width: 1279px) calc(30vw - 72px), 312px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt={`ภาพโปรโมชั่นแนะนำเพื่อนของ ${BRAND_NAME} เป็นงานอาร์ตสี่เหลี่ยมจัตุรัสชุดเดียวกัน ฉากโต๊ะคาสิโนสีดำสนิทที่มีริบบิ้นแสงสีแดงโค้งอยู่เบื้องหลัง มุมซ้ายบนเป็นมาสคอตโจรการ์ตูนใส่หน้ากากสีดำแบกถุงเงินที่มีเครื่องหมายดอลลาร์ ใต้ลงมาเป็นโลโก้ ${BRAND_NAME} ที่ตัวอักษรเป็นสีแดงสามมิติต่อด้วยตัวเลขสีเงินโครเมียมขัดเงา ฝั่งขวาเป็นชายหนุ่มผมสีขาวเงินในชุดสูทสีดำกับเนกไทสีแดง ยืนเคียงหญิงสาวผมสีขาวเงินในชุดราตรีสีแดงเลื่อมที่คลุมขนเฟอร์สีดำ ฝั่งซ้ายเรียงซ้อนกันเป็นมงกุฎเล็กสีเงิน ถัดลงมาเป็นคำว่า โปรโมชั่น ตัวอักษรสามมิติสีขาวอมเงินขนาดใหญ่ ใต้ลงไปเป็นแถบป้ายสีดำขอบแดงที่เขียนว่า แนะนำเพื่อน และแถบล่างสุดเขียนว่า โบนัส คู่กับเลข 0.8% เป็นตัวโตสีขาวเงิน ขอบล่างเป็นกองชิปคาสิโนสีแดงสลับดำ ไพ่เอซ และลูกเต๋าสีแดง`}
      class="mx-auto h-auto w-full max-w-[600px] rounded-2xl border border-[#aeb9c6]/45 shadow-[0_0_28px_rgba(233,238,244,0.18)]"
    />
  </ContentBoxSevenThreeNeumorphism>

  <ContentBoxSpecial as="h2" title={`ระบบฝากถอน ${BRAND_NAME} ยอดเข้าบริษัทโดยตรง`}>
    <p slot="left">
      ระบบฝากถอน {BRAND_NAME} นำเสนอการจัดการธุรกรรมผ่านบัญชีสมาชิก
      <strong class="text-[#ff8a8f]">โดยเว็บไซต์ระบุว่ารองรับการฝากถอนผ่านธนาคารและส่งยอดเข้าบัญชีบริษัทโดยตรง</strong>
      ผู้ใช้งานควรตรวจสอบรายชื่อธนาคารที่รองรับ ชื่อบัญชีรับเงิน และสถานะรายการจากระบบก่อนยืนยันธุรกรรม หากใช้บัญชีบริษัทเจ้าของเว็บไซต์
      <strong class="text-[#ff8a8f]">ควรแสดงชื่อนิติบุคคลที่สามารถตรวจสอบได้และตรงกับบัญชีรับชำระจริง</strong>
    </p>
    <p slot="right">
      สำหรับการฝากถอนทุกธนาคาร
      <strong class="text-[#ff8a8f]">ควรตรวจสอบช่องทางที่เปิดให้บริการในปัจจุบัน</strong>
      เพราะแต่ละธนาคารอาจมีข้อจำกัดด้านเวลาและระบบธุรกรรม
      <strong class="text-[#ff8a8f]">ส่วนการโอนเงินเข้าบัญชีบริษัทไม่ได้รับประกันความปลอดภัยทั้งหมด</strong>
      หากพบชื่อบัญชีปลายทางไม่ตรงกับข้อมูลจากช่องทางหลัก ควรสอบถามฝ่ายบริการก่อนทำรายการ และเก็บหลักฐานธุรกรรมไว้จนกว่าจะดำเนินการเสร็จสิ้น
    </p>
  </ContentBoxSpecial>

  <ContentBoxFloatingBadge as="h2" title={`แอดมิน ${BRAND_NAME} เปิดบริการ 24 ชั่วโมง`}>
    <div class="flex flex-col gap-4">
      <p>
        แอดมิน {BRAND_NAME}
        <strong class="text-[#ff8a8f]">มีช่องทางสำหรับสมาชิกที่ต้องการสอบถามเกี่ยวกับการสมัคร การเข้าสู่ระบบ เกมคาสิโน การเดิมพันกีฬา โปรโมชั่น และรายการฝากถอนที่อยู่ระหว่างตรวจสอบ</strong>
        โดยระบุเวลาให้บริการตลอด 24 ชั่วโมง สมาชิกสามารถติดต่อผ่านช่องทางหลักที่เว็บไซต์กำหนด
        <strong class="text-[#ff8a8f]">พร้อมแจ้งรายละเอียดปัญหาให้ครบถ้วน</strong>
        เพื่อช่วยให้เจ้าหน้าที่ตรวจสอบรายการได้ตรงประเด็น
      </p>
      <p>
        หากพบปัญหาเกี่ยวกับบาคาร่า ไฮโล หรือสล็อต
        <strong class="text-[#ff8a8f]">ควรแจ้งชื่อเกม ค่าย และเวลาที่เกิดเหตุ</strong>
        ส่วนการเดิมพันบอลออนไลน์ควรเตรียมชื่อคู่แข่งขันและหมายเลขรายการ หากเป็นปัญหาธุรกรรมควรเก็บหลักฐานจำนวนเงินและเวลาทำรายการไว้สำหรับตรวจสอบ
        <strong class="text-[#ff8a8f]">โดยไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น</strong>
        แม้จะอ้างว่าเป็นเจ้าหน้าที่ของเว็บไซต์ก็ตาม
      </p>
    </div>
  </ContentBoxFloatingBadge>

  <Faq as="h2" title={`คำถามที่พบบ่อยเกี่ยวกับ ${BRAND_NAME}`} faqs={faqs} />

  <LoginRtpSection />

  <ReviewCardSumo />

  <Navfoot />
</MainLayout>
