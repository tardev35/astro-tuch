---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement2.astro";
import LatestWinners from "../components/LatestWinners4.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxTwoFloatingBadge from "../components/ContentBoxTwoFloatingBadge.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import Faq from "../components/Faq2.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import { pageGraph } from "../lib/schema";
import imgCashback from "../assets/slide1.png";
import imgReferral from "../assets/slide2.png";

// VARIANT ROTATION THIS ROUND (หวยดีใจ -> HI59). Zero file reuse from the previous
// round: Announcement2 replaces Announcement5, LatestWinners4 replaces
// LatestWinners3, Faq2 replaces Faq4, and the ContentBox shape-mix moves off
// Premium / TwoHuay / Neumorphism / SevenThreePremium / SevenThreeHuay /
// TwoPremium onto CyberCut / TwoCyberCut / FloatingBadge / SevenThreeCyberCut /
// SevenThreeNeumorphism / TwoFloatingBadge / Special. NavbarStyle6 and
// FooterStyle3 are the layout's pair this round (previously NavbarStyle8 /
// FooterPremium) and the brand font moves kanit -> google-sans; all three are the
// orchestrator's shared-chrome step, not this page's.
// Plain ContentBox is the one deliberate carry-over: terms, privacy, 404 and every
// button page render their body through it by rule and cannot follow a rotation,
// so it is always-live and the orchestrator rethemes it in the shared step — this
// page does not render it at all this round.
// Every unused *Premium / *Huay / *Cyber / Style file, Faq4, Announcement5 and
// LatestWinners3 stay on disk as inventory for the next brand — none of them was
// deleted, and the previous brand's copy and colour still inside them is expected
// drift, not a bug. ReviewCardSumo2 is reused rather than rotated to
// ReviewCardSumo because this page owns it and rewrote every row from the new
// brief; the rotation rule is about shape families with live siblings, and the
// review ledger's only sibling is the shape this one replaced.
//
// <Announcement /> runs bare on purpose: Announcement2's default message is already
// this brand's copy and every sub-page calls it bare too, so passing an override
// here is exactly how the ticker ends up saying two different things on two pages
// of the same site.
//
// POLARITY OF THIS BRAND (brand-spec §2). HI59 is the first LIGHT brand on this
// template: logo.webp is a sky-blue "HI" + gold "59" on transparent, banner1 and
// both slides are a daylight sky, and bg.json is a pale periwinkle #c1cce6. So the
// content cards are light ice-glass (#f6fbff / #e7f2fd / #d3e7fa) with dark navy
// body copy #0d2744 (= BRAND_TEXT), while the chrome — ticker, navbar, footer and
// the withdrawal feed — stays deep ocean navy #04203f and sets its own light text.
// Highlights below are #065a9c, not the brand blue #0a84e0: on a light card
// #0a84e0 is only 4.0:1, and brand-spec §2 pins link/label text to #065a9c.
//
// IMAGE ROLES FOR THIS DROP (2026-10-07). Two files are referenced from this page
// and only two, and each pairing is read off the artwork itself:
//   slide1.png — square daylight sky, HI59 wordmark top-LEFT, model on the RIGHT
//     in a white gold-buttoned jacket resting her cheek on her hand, and the
//     plaque under โปรโมชั่น reads "คืนยอดเสีย 0.3%", so it belongs to docx H3 #4.
//     Imported as imgCashback.
//   slide2.png — same sky set, HI59 wordmark top-RIGHT, model on the LEFT in a
//     white gold-trimmed dress reaching toward the viewer, a blue ribbon reading
//     แนะนำเพื่อน over a large gold 0.8%, and a gift box with gold coins at the
//     lower right, so it belongs to docx H3 #5. Imported as imgReferral.
// Both files are 600x600, so 600 is the top real candidate — nothing above it
// would be a real pixel — and each picture carries max-w-[600px] so the art is
// never upscaled past its own bitmap. Each slide sits in a ContentBoxSevenThree*
// image+text block, which is that family's hard cap of two per rebrand, so there
// is no third SevenThree anywhere on the site.
// The two blocks mirror each other: SevenThreeCyberCut lays out
// md:grid-cols-[3fr_7fr] so its picture goes in slot="left" while the paragraph
// keeps the wide column, and SevenThreeNeumorphism lays out md:grid-cols-[7fr_3fr]
// so its picture goes in slot="right". The two pictures therefore alternate sides
// instead of stacking down the same edge, and each `sizes` describes its own 3fr
// column rather than the viewport. Both figures are copied from the arithmetic
// block in the component that owns the column — if a padding/gap/cap changes
// there, these move with it:
//   SevenThreeCyberCut:    max-w-7xl/1280px cap, px-4, p-8, gap-8, and NO inner
//                          padding on the image column
//                          -> (1280 - 32 - 64 - 32) x 0.3 = 346px
//   SevenThreeNeumorphism: max-w-[1400px] cap, px-4, p-8, gap-8, and the image
//                          column adds md:pl-8
//                          -> (1400 - 32 - 64 - 32) x 0.3 - 32 = 350px
// Below md both cards collapse to one column at p-8, so the drawn width is
// 100vw - 32 (section px-4) - 64 (card p-8) = 100vw - 96px, capped at 600px.
// Neither picture is the LCP element — MainLayout's hero banner is — so both are
// loading="lazy" fetchpriority="low".
//
// The alt text was written from THIS drop's artwork, not carried over: the two
// slides are bright daylight skies with white clouds, planets and gold coins
// rather than the white-and-silver lottery sets of the previous drop.
//
// Deliberately NOT imported, and every file still on disk:
//   banner2.png / banner3.png / slide3.png / slide4.png all predate this drop and
//   belong to previous brands — importing any of them would emit a competitor's
//   artwork into dist/, so there is no inline article illustration this round.
//   banner1.png and banner1-mobile.png belong to MainLayout's own pinned globs and
//   are never referenced from a page. og.png is the same: MainLayout owns it.
// Also deliberately unused: FeatureHighlights.astro (it renders sub-points as <h3>,
// and the brief's heading inventory allows exactly two H3s — sections 4 and 5 — so
// wiring it in would break the count), and the ContentBox3Three* family (no brief
// section on this page is a three-way split; every section is one or two running
// paragraphs).
//
// Vocabulary: HI59 is a สล็อต / คาสิโนออนไลน์ brand, NOT a lottery site. The words
// this page may use are the brief's own: สล็อต, ไฮคลาส, VIP, เว็บตรง, ลิขสิทธิ์แท้,
// ค่ายเกมพรีเมียม, ส่งตรงจากเว็บแม่, วงล้อ, ฟรีสปิน, ตัวคูณ, ฟีเจอร์โบนัส,
// เกมเปิดใหม่, บัญชีเดียว, เครดิต, โปรโมชั่น, คืนยอดเสีย 0.3%, แนะนำเพื่อน 0.8%,
// ฝากถอน, ยอดเข้าบริษัทตรง, ไม่ผ่านบัญชีม้า, Login, แอดมิน 24 ชั่วโมง, PIN, OTP,
// ประวัติรายการ.
// The previous brand's lottery vocabulary (หวย, แทงหวย, ส่งโพย, โพย, เลข 2 ตัว,
// เลข 3 ตัว, เลขเด็ด, แนวทาง, หวยลาว, หวยฮานอย, หวยออมสิน, ธ.ก.ส., อัตราจ่าย,
// เรทจ่าย, ไม่อั้นจ่าย, ไม่มีลบโพย, งวด, ผลรางวัล) is gone — the page was written
// from the new brief rather than find-and-replaced over the old sentences. Nothing
// here claims a licence, a regulator, an operator, a bank, a game studio, an RTP
// figure, a deposit minimum, a member count or a founding year, because the brief
// names none. The only figures are the brief's own: 0.3%, 0.8%, 100%, 24 ชั่วโมง.
// The brief's own hedging ships with the copy (เว็บตรง/ลิขสิทธิ์แท้ ควรมีข้อมูล
// ผู้ให้บริการที่ตรวจสอบได้ · "ปลอดภัย 100%" ไม่ควรใช้เป็นการรับประกันโดยไม่มี
// หลักฐาน · "โบนัสสูง ให้เยอะกว่าใคร" ควรมีข้อมูลเปรียบเทียบรองรับ · "ฝากถอนได้ทุก
// ช่องทาง" ควรหมายถึงเฉพาะช่องทางที่ระบบรองรับจริง · "ไม่ผ่านบัญชีม้า" ควรมีข้อมูล
// นิติบุคคลรองรับ) — it is part of the paragraphs, not trimmed as downbeat.
//
// Title and description are the brief's own Title/Description lines, used verbatim
// and NOT padded up to 150: verify-build deliberately skips its 150-character floor
// on the home page for exactly this reason. The brand name is interpolated rather
// than typed so it can never drift from brandProfile, and no domain is written out
// anywhere in this file.
const pageTitle = `${BRAND_NAME} สล็อตไฮคลาส เล่นง่ายสไตล์VIP รวมค่ายพรีเมียม ยอดเข้าบริษัทตรง`;

const pageDescription = `${BRAND_NAME} สล็อตไฮคลาส เว็บตรง ลิขสิทธิ์แท้ เล่นง่ายสไตล์VIP รวมค่ายเกมพรีเมียม ส่งตรงจากเว็บแม่ ฝากถอนได้ทุกช่องทาง ยอดเข้าบริษัทตรง ปลอดภัย100%`;

// The brief has a real H2 -> H3 nesting this round, so the page is NOT flattened to
// H2-only. The two H3s are genuine headings — the two bonus sub-points, both nested
// under section 3's โปรโมชั่น H2 — and they stay H3.
//
// The checklist, in document order, and what carries each one:
//    1 H1  HI59 สล็อตไฮคลาส เว็บตรง ลิขสิทธิ์แท้ เล่นง่ายสไตล์VIP
//          ContentBoxCyberCut, brief paragraph on line 4
//    2 H2  HI59 รวมค่ายเกมพรีเมียม ส่งตรงจากเว็บแม่ ปลอดภัย100%
//          ContentBoxTwoCyberCut, line 6 left / line 7 right
//    3 H2  โปรโมชั่นเล่นสล็อต HI59 โบนัสสูง ให้เยอะกว่าใคร
//          ContentBoxFloatingBadge, line 9
//    4 H3  คืนยอดเสีย โบนัส 0.3%
//          ContentBoxSevenThreeCyberCut + slide1 (imgCashback), line 11
//    5 H3  แนะนำเพื่อน โบนัส 0.8%
//          ContentBoxSevenThreeNeumorphism + slide2 (imgReferral), line 13
//    6 H2  เว็บ HI59 ฝากถอนได้ทุกช่องทาง ยอดเข้าบริษัทตรง ไม่ผ่านม้า
//          ContentBoxTwoFloatingBadge, line 15 left / line 16 right
//    7 H2  ติดต่อแอดมิน HI59 เว็บหลักได้ 24 ชั่วโมง
//          ContentBoxSpecial + LINE / สมัครสมาชิก buttons, lines 18 + 19
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ HI59
//          Faq2 + faqs prop, lines 21-26
// Final inventory for this page: h1 x1, h2 x5, h3 x2.
//
// Shape rhythm, top to bottom: cut-corner slab with a left rail -> two-column
// cut-corner card -> floating gold badge over a light slab -> 3:7 cut-corner with
// the picture on the LEFT -> 7:3 neumorphic raised panel with the picture on the
// RIGHT -> two-column with a floating navy badge -> two icon halves plus a button
// row -> accordion. No shape repeats back to back, the three cut-corner cards are
// separated by surface depth (#f6fbff / #e7f2fd / #d3e7fa) rather than by heading
// colour alone, and the two floating badges are opposite polarities (gold plaque
// vs navy plaque) so they do not read as the same badge twice.
//
// ContentBoxSevenThreeCyberCut takes the docx heading through `title`, which falls
// back to its wide (7fr) RIGHT text column; its image column is passed no
// `titleleft`, so the block emits exactly one heading. ContentBoxSevenThreeNeumorphism
// is the mirror and takes its heading through `title` too, which falls back to the
// wide LEFT column, with no `titleright` on the picture.
//
// Every brief paragraph ships in full — all eleven of them, nothing merged or
// summarised. Sections 2, 6 and 7 have two paragraphs each and run one per column;
// sections 1, 3, 4 and 5 have one each. The column labels passed to the two
// two-column boxes are this page's own layout wording, not brief headings, and
// both variants render them as <p>.
//
// Everything else on the page is chrome and emits no heading tag at any level:
// Announcement2, LatestWinners4, LoginRtpSection and ReviewCardSumo2 render their
// titles as <p>/<span> with an aria-label on the section, and Faq2's questions live
// inside <summary> as <span>. The non-brief widgets sit before section 1 (the
// ticker, then the winners feed) and after section 8 (LoginRtpSection,
// ReviewCardSumo2, Navfoot) — never spliced between two content sections.

// One array, used by both <Faq> and the FAQPage node — never the component's own
// defaults, which belong to whichever brand shipped last. The three pairs are the
// brief's own Q/A block, verbatim.
const faqs = [
  {
    q: `${BRAND_NAME} มีเกมสล็อตจากค่ายพรีเมียมอะไรให้เลือกบ้าง?`,
    a: `${BRAND_NAME} สามารถรวมเกมสล็อตจากหลายค่ายตามที่ระบบเชื่อมต่อ มีทั้งสล็อตคลาสสิก เกมฟรีสปิน ตัวคูณ และเกมโบนัส รายชื่อค่ายและจำนวนเกมอาจมีการอัปเดต จึงควรตรวจสอบรายการล่าสุดจากหน้าเกมสล็อตของเว็บไซต์`,
  },
  {
    q: `${BRAND_NAME} เป็นเว็บตรงและใช้เกมลิขสิทธิ์แท้หรือไม่?`,
    a: `หาก ${BRAND_NAME} ระบุว่าเป็นเว็บตรงและใช้เกมลิขสิทธิ์แท้ ควรมีข้อมูลผู้ให้บริการ รายชื่อค่าย หรือรายละเอียดการเชื่อมต่อที่สามารถตรวจสอบได้ ไม่ควรพิจารณาจากข้อความประชาสัมพันธ์เพียงอย่างเดียว`,
  },
  {
    q: `โปรโมชั่น ${BRAND_NAME} โบนัส 0.3% และ 0.8% ต่างกันอย่างไร?`,
    a: `โบนัส 0.3% เป็นโปรโมชั่นคืนยอดเสียจากยอดที่เข้าเงื่อนไข ส่วนโบนัส 0.8% เป็นกิจกรรมแนะนำเพื่อนจากยอดที่กำหนด ทั้งสองโปรโมชั่นอาจมีรอบคำนวณและค่ายเกมที่ร่วมรายการแตกต่างกัน ควรตรวจสอบเงื่อนไขล่าสุดก่อนรับสิทธิ์`,
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space that
// splits the word — the copy must read identically with the tags removed.
// One highlight colour only: #065a9c, the deep brand blue, against the inherited
// body colour #0d2744 (BRAND_TEXT). The paragraphs below carry no colour class of
// their own: every ContentBox* card in this mix already sets
// `text-left text-base leading-relaxed text-[#0d2744]` on the element holding the
// slot, so the prose inherits it and no page-level override can drift from the
// card. No paragraph carries mx-auto or max-w-* either — the cards cap their own
// width.

// No breadcrumb: this is the homepage, so a trail from the root to itself would be a
// single self-referential crumb. Every URL in the graph is derived by pageGraph from
// `site:` — no domain is typed out in this file, and no Review / AggregateRating /
// sameAs / address / email node is passed.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <LatestWinners />

  <ContentBoxCyberCut as="h1" title={`${BRAND_NAME} สล็อตไฮคลาส เว็บตรง ลิขสิทธิ์แท้ เล่นง่ายสไตล์VIP`}>
    <p>
      {BRAND_NAME}
      <strong class="text-[#065a9c]">สล็อตไฮคลาสที่เน้นรูปแบบการใช้งานสไตล์ VIP พร้อมรวบรวมเกมสล็อตจากหลายค่ายไว้ในบัญชีเดียว</strong>
      มีทั้งสล็อตยอดนิยม เกมเปิดใหม่ ฟรีสปิน ตัวคูณ และฟีเจอร์โบนัสหลากหลายรูปแบบ รองรับการเข้าเล่นผ่านมือถือและคอมพิวเตอร์
      <strong class="text-[#065a9c]">สมาชิกสามารถเลือกค่าย ค้นหาเกม ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการได้สะดวก</strong>
      ส่วนการระบุว่าเป็นเว็บตรงหรือลิขสิทธิ์แท้ควรมีข้อมูลผู้ให้บริการที่ตรวจสอบได้รองรับอย่างชัดเจน
    </p>
  </ContentBoxCyberCut>

  <ContentBoxTwoCyberCut
    as="h2"
    title={`${BRAND_NAME} รวมค่ายเกมพรีเมียม ส่งตรงจากเว็บแม่ ปลอดภัย100%`}
    titleleft="ค่ายเกมและการสลับเกม"
    titleright="ข้อมูลที่ควรตรวจสอบได้">
    <p slot="left">
      {BRAND_NAME}
      <strong class="text-[#065a9c]">รวมค่ายเกมพรีเมียมไว้ให้เลือกหลายสไตล์ ช่วยให้สมาชิกสามารถสลับเกมและค่ายผ่านบัญชีเดียวโดยไม่ต้องสมัครใหม่หลายครั้ง</strong>
      แต่ละเกมมีทั้งรูปแบบวงล้อ ฟีเจอร์โบนัส ฟรีสปิน และช่วงเดิมพันแตกต่างกัน
      <strong class="text-[#065a9c]">สามารถตรวจสอบรายละเอียดเกมก่อนเริ่มเล่นเพื่อเลือกประเภทที่ตรงกับความสนใจได้ง่ายขึ้น</strong>
    </p>
    <p slot="right">
      <strong class="text-[#065a9c]">หากระบุว่าเกม ส่งตรงจากเว็บแม่ ควรมีรายชื่อผู้ให้บริการหรือข้อมูลการเชื่อมต่อที่สามารถตรวจสอบได้</strong>
      ส่วนคำว่า ปลอดภัย 100% ไม่ควรใช้เป็นการรับประกันโดยไม่มีหลักฐานด้านระบบ ความปลอดภัย หรือข้อมูลผู้ดำเนินงานประกอบ
    </p>
  </ContentBoxTwoCyberCut>

  <ContentBoxFloatingBadge as="h2" title={`โปรโมชั่นเล่นสล็อต ${BRAND_NAME} โบนัสสูง ให้เยอะกว่าใคร`}>
    <p>
      โปรโมชั่นเล่นสล็อต {BRAND_NAME} มีสิทธิ์สำหรับสมาชิกตามแคมเปญที่เปิดในแต่ละช่วง
      <strong class="text-[#065a9c]">โดยสามารถ Login เพื่อตรวจสอบโบนัส ยอดที่เข้าเกณฑ์ และรอบรับสิทธิ์ผ่านบัญชีได้</strong>
      มีทั้งกิจกรรมคืนยอดเสียและแนะนำเพื่อน
      <strong class="text-[#065a9c]">ส่วนคำว่า “โบนัสสูง ให้เยอะกว่าใคร” ควรมีข้อมูลเปรียบเทียบรองรับ</strong>
      หากไม่มีข้อมูลดังกล่าวควรเน้นจำนวนโบนัสและเงื่อนไขจริงของแต่ละโปรโมชั่นแทน
    </p>
  </ContentBoxFloatingBadge>

  <ContentBoxSevenThreeCyberCut as="h3" title="คืนยอดเสีย โบนัส 0.3%">
    <Picture
      slot="left"
      src={imgCashback}
      loading="lazy"
      fetchpriority="low"
      widths={[346, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), (max-width: 1279px) calc(30vw - 38px), 346px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
