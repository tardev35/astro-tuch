---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import LatestWinners from "../components/LatestWinners4.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxTwo from "../components/ContentBoxTwo.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import Faq from "../components/Faq3.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import { pageGraph } from "../lib/schema";
import imgCashback from "../assets/slide1.png";
import imgReferral from "../assets/slide2.png";

// VARIANT ROTATION THIS ROUND (GUCCI168 -> 789BETTING), per brand-spec §3. Zero
// file reuse from the previous round except the one deliberate case noted below:
// Announcement5 replaces Announcement3, LatestWinners4 replaces LatestWinners3,
// Faq3 replaces Faq2, ReviewCardSumo replaces ReviewCardSumo2, and the
// ContentBox shape-mix moves off Premium / TwoPremium / Neumorphism /
// SevenThreePremium / SevenThreeNeumorphism / TwoNeumorphism onto CyberCut / Two
// / FloatingBadge / SevenThreeCyberCut / SevenThreeFloatingBadge / TwoCyberCut.
// NavbarStyle4Black and FooterStyle2 are the layout's pair this round
// (previously NavbarStyle8 / FooterStyle3) and the brand font moves
// kanit -> google-sans; all three are the orchestrator's shared-chrome step, not
// this page's.
// ContentBoxSpecial is the ONE deliberate carry-over: it is the only box in the
// library with an `actions` slot, and docx section 7 is exactly its shape — two
// paragraphs plus a LINE / สมัครสมาชิก button row. brand-spec §3 records the reuse.
// Plain ContentBox is deliberately NOT used by this page this round — terms,
// privacy, 404 and every button page render their body through it by rule and
// cannot follow a rotation, so it stays always-live in the shared step and this
// page leaves it to them.
// Every unused *Premium / *Neumorphism / *Huay / Style file, Faq2,
// ReviewCardSumo2, LatestWinners3 and Announcement3 stay on disk as inventory for
// the next brand — none of them was deleted, and GUCCI168's copy and colour still
// inside them is expected drift, not a bug.
//
// <Announcement /> runs bare on purpose: Announcement5's default message is
// already this brand's copy, written from this brief, and every sub-page calls it
// bare too — so passing an override here is exactly how the ticker ends up saying
// two different things on two pages of the same site.
//
// PALETTE OF THIS BRAND (brand-spec §2). 789BETTING is a SINGLE-HUE brand —
// metallic gold on solid black, no second colour anywhere — and this round is a
// full hue flip off GUCCI168's Chinese-new-year three-colour set (red leads,
// emerald green is a genuine second hue, gold is the metal between them:
// #c41115 #e0201f #7a0505 #0b7a33 #2bbf63 #d9a521 #ffdf91 #8c6410 #1d0b08
// #140705 #090302 #f6e3cf #1a0604 and every rgba(196,17,21,α) /
// rgba(217,165,33,α) / rgba(11,122,51,α) glow). None of that survives on this
// page or in any component it renders. logo.webp is the number 789 in polished
// three-dimensional gold over BETTING in black on a white rule, banner1 and both
// slides are a black-and-gold casino hall, and bg.json is
// {"mode":"color","color":"#000000"} — solid black, not a gradient.
// So the content cards run a depth ladder on near-black warm gold (#17130a
// raised / #0e0b05 mid / #0a0802 deep / #060402 deepest) with body copy #f3e7cd
// (= BRAND_TEXT).
// Highlights below are the champagne gold #ffe79a, which §2 pins to exactly this
// job (<strong> highlights and the light end of gradients), unlike the brand gold
// #fad354, the mid gold #ddab33, the bronze #c9881f and the deep gold #8a6410
// that it pins to borders, rules and aura. The deep gold and the hairline #4a3407
// never carry text on this page — they fall below AA on every card surface — so
// they appear only as border and shadow colours.
//
// IMAGE ROLES FOR THIS DROP (2026-10-08 19:12, brand-spec §4). Two files are
// referenced from this page and only two, and each pairing is read off the
// artwork itself:
//   slide1.png — black-and-gold casino set: black-and-gold columns with a roulette
//     wheel at the right, gold chips and a spade card floating around the frame.
//     The model with long silver-white hair in a black suit stands on the LEFT with
//     her right palm open towards the right of the frame; the 789BETTING logo sits
//     top right; the centre reads โปรโมชั่น in gold under a small gold crown, and
//     the black gold-edged plaque below it reads "คืนยอดเสีย 0.3%" — so it belongs
//     to docx H3 #4. Imported as imgCashback.
//   slide2.png — the same set seen from a different angle: gold arches and a row of
//     hanging lanterns behind, the model in a black blazer with gold buttons again
//     on the LEFT with her palm open to the right, and stacks of black-and-gold
//     chips, gold dice and two ace cards at the lower right. The logo is top right
//     again and the plaque reads "แนะนำเพื่อน 0.8%" — so it belongs to docx H3 #5.
//     Imported as imgReferral.
// Both files are 600x533 on disk, so 600 is the top real candidate — nothing above
// it would be a real pixel — and each picture carries max-w-[600px] so the art is
// never upscaled past its own bitmap.
// Each slide sits in a ContentBoxSevenThree* image+text block, which is that
// family's hard cap of two per rebrand, so there is no third SevenThree anywhere
// on the site and no slide appears outside those two blocks.
// The two blocks mirror each other: ContentBoxSevenThreeCyberCut lays out
// md:grid-cols-[3fr_7fr] so its picture goes in slot="left" while the paragraph
// keeps the wide column, and ContentBoxSevenThreeFloatingBadge lays out
// md:grid-cols-[7fr_3fr] so its picture goes in slot="right". The two pictures
// therefore alternate sides instead of stacking down the same edge, and each
// `sizes` describes its own 3fr column rather than the viewport. Tailwind sets
// box-sizing: border-box globally, so every max-w-* below caps the box INCLUDING
// its padding and border — which is also where each card's cap breakpoint comes
// from. Both figures are recomputed from the component that owns the column — if a
// padding/gap/border/cap changes there, these move with it:
//   ContentBoxSevenThreeCyberCut: the cap is on the SECTION (max-w-7xl/1280 + px-4),
//     so the card is 1280 - 32 = 1248 wide and the cap is reached at 100vw >= 1280.
//     Card border(2) + p-8(64) -> inner 1182. gap-8(32) -> 1150 of column space.
//     The image column is the bare 3fr <article>: no padding, no border (the
//     md:border-l + md:pl-8 pair is on the TEXT column).
//       >= 1280px : 1150 x 0.3                     = 345.0 -> 345px
//       md..1279  : (100vw - 32 - 2 - 64 - 32) x 0.3 = calc(30vw - 39px)
//       < md      : one column, no md: padding      = calc(100vw - 98px)
//   ContentBoxSevenThreeFloatingBadge: the cap is on the CARD (w-full max-w-7xl
//     inside a plain px-4 flex section), so the card is min(100vw - 32, 1280) and
//     the cap is reached at 100vw >= 1312, not 1280. Card border-2(4) + p-8(64) ->
//     inner W - 68. gap-10(40) -> W - 108 of column space. The image column here
//     DOES add md:border-l(1) + md:pl-10(40) = 41 of its own.
//       >= 1312px : (1280 - 108) x 0.3 - 41 = 351.6 - 41 = 310.6 -> 311px
//       md..1311  : (100vw - 140) x 0.3 - 41        = calc(30vw - 83px)
//       < md      : one column, no md: padding      = calc(100vw - 100px)
//     (Both files carry an older derivation in their own frontmatter that drops the
//     border and puts the FloatingBadge cap at 1280; the numbers above are the
//     re-derivation from the markup as it stands today.)
// Neither picture is the LCP element — MainLayout's hero banner is — so both are
// loading="lazy" fetchpriority="low" decoding="async" and neither takes
// fetchpriority="high".
//
// The alt text was written from THIS drop's artwork per brand-spec §4, not carried
// over: the two slides are a black-and-gold casino hall, not GUCCI168's red-green
// Chinese-new-year set — there is no green arch, no red lantern, no God-of-Fortune
// and no red jacket on either file, the model wears black in both, and the logo
// stays at the top RIGHT in both rather than swapping sides.
//
// Deliberately NOT imported, and every file still on disk:
//   banner2.png (09-28), banner3.png (09-27), slide3.png / slide4.png (09-29) all
//   predate this drop and belong to previous brands — importing any of them emits
//   a competitor's artwork into dist/ (an eager import IS an emit, rendered or
//   not) and turns verify-build red, so there is no inline article illustration
//   this round.
//   banner1.png and banner1-mobile.png belong to MainLayout's own pinned globs and
//   are never referenced from a page. og.png is the same: MainLayout owns it.
// Also deliberately unused: FeatureHighlights.astro (it renders sub-points as <h3>,
// and the brief's heading inventory allows exactly two H3s — sections 4 and 5 — so
// wiring it in would break the count), and the ContentBox3Three* family (no brief
// section on this page is a three-way split; every section is one or two running
// paragraphs).
//
// Vocabulary (brand-spec §7): 789BETTING is a MULTI-CATEGORY CASINO PORTAL — a
// คาสิโนฐานเข้าหลัก that carries บาคาร่า รูเล็ต บอล หวย สล็อต side by side — not a
// live-casino-only brand and not a lottery site. The words this page may use are
// the brief's own: คาสิโนฐานเข้าหลัก, เดิมพันตรงกับบริษัท 100%, เกมคาสิโน, บาคาร่า,
// รูเล็ต, บอล, หวย, สล็อต, โต๊ะ, ตลาดเดิมพัน, คู่แข่งขัน, รอบเปิดรับ, เกมคลาสสิก,
// ฟรีสปิน, โบนัส, ตัวคูณ, บัญชีเดียว, เครดิต, ประวัติการเดิมพัน, โปรโมชั่น,
// คืนยอดเสีย 0.3%, แนะนำเพื่อน 0.8%, รอบตัดยอด, ยอดที่เข้าเกณฑ์, Login, ฝากถอน,
// ชื่อบัญชีปลายทาง, นิติบุคคล, ยอดเข้าบริษัทตรง, แอดมิน 24 ชั่วโมง, PIN, OTP,
// หลักฐานธุรกรรม, วงเงิน, เวลาเปิด-ปิด.
// หวย appears because THIS brief lists it as one of the categories the hub
// carries. That does not make the site a lottery brand: /ตรวจหวย and /แนวทาง stay
// parked in src/pages-disabled/, and no lottery-page vocabulary (โพย, เลขเด็ด,
// แนวทาง, งวด, อัตราจ่าย, ตรวจหวย) appears anywhere on this page.
// GUCCI168's vocabulary is banned and gone (คาสิโนไลฟ์24ชม, ไฮโล, โต๊ะสด, หมวดเกม,
// Limit, ไม่มีขั้นต่ำทุกรูปแบบเกม, คาสิโนไม่จำกัดยอด, สมัคร 3 ขั้นตอน), as is every
// older brand's (เบทต่ำ, ทุนน้อย, ค่ายตรง, ถูกลิขสิทธิ์, ไฮคลาส, VIP,
// ส่งตรงจากเว็บแม่, ไม่ผ่านบัญชีม้า) — the page is written straight from the brief
// rather than find-and-replaced over the old sentences. Nothing here claims a
// licence, a regulator, an operator, a bank, a game studio, an RTP figure, a
// deposit minimum, a member count or a founding year, because the brief names
// none. The only figures are the brief's own: 0.3%, 0.8%, 24 ชั่วโมง, 100%.
// The brief's own hedging ships with the copy ("เดิมพันตรงกับบริษัท 100%"
// ควรมีชื่อบริษัทหรือนิติบุคคลที่ตรวจสอบได้ · "ยอดเข้าบริษัทตรง" ควรแสดงชื่อนิติบุคคล
// · "ฝากถอนได้ทุกช่องทาง" ควรหมายถึงช่องทางที่ระบบรองรับจริงในขณะทำรายการ) — it is
// part of the paragraphs, not trimmed as downbeat filler.
//
// The brief says 789BETTING throughout and so does every piece of artwork in the
// drop and the operator's prompt — no conflict this round. Even so the brand name
// is never typed on the page: it is interpolated from ${BRAND_NAME} so it can
// never drift from brandProfile. No domain is written out anywhere in this file.
//
// Title and description are the brief's own Title/Description lines (minus that
// substitution), used verbatim and NOT padded up to 150: verify-build deliberately
// skips its 150-character floor on the home page for exactly this reason.
const pageTitle = `${BRAND_NAME} คาสิโนฐานเข้าหลัก เดิมพันตรงกับบริษัท100%`;

const pageDescription = `${BRAND_NAME} คาสิโนฐานเข้าหลัก ทางเข้าเดิมพัน เกมคาสิโน บาคาร่า รูเล็ต บอล หวย สล็อต ครบวงจร ฝากถอนตรงกับบริษัท100%`;

// The brief has a real H2 -> H3 nesting this round, so the page is NOT flattened to
// H2-only. The two H3s are genuine headings — the two bonus sub-points, both nested
// under section 3's โปรโมชั่น H2 — and they stay H3.
//
// The checklist, in document order, and what carries each one:
//    1 H1  789BETTING คาสิโนฐานเข้าหลัก เดิมพันตรงกับบริษัท100%
//          ContentBoxCyberCut, brief paragraph on line 4
//    2 H2  789BETTING เกมคาสิโน บาคาร่า รูเล็ต บอล หวย สล็อต ครบวงจร
//          ContentBoxTwo, line 6 left / line 7 right
//    3 H2  โปรโมชั่นเล่น 789BETTING โบนัสสูงทุกรูปแบบเกม
//          ContentBoxFloatingBadge, line 9
//    4 H3  คืนยอดเสีย โบนัส 0.3%
//          ContentBoxSevenThreeCyberCut + slide1 (imgCashback), line 11
//    5 H3  แนะนำเพื่อน โบนัส 0.8%
//          ContentBoxSevenThreeFloatingBadge + slide2 (imgReferral), line 13
//    6 H2  คาสิโนออนไลน์ 789BETTING ฝากถอนได้ทุกช่องทาง ยอดเข้าบริษัทตรง
//          ContentBoxTwoCyberCut, line 15 left / line 16 right
//    7 H2  ติดต่อแอดมิน 789BETTING คาสิโนฐานหลักได้ 24 ชั่วโมง
//          ContentBoxSpecial, lines 18 + 19, plus the LINE / สมัครสมาชิก button
//          row in its `actions` slot
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ 789BETTING
//          Faq3 + faqs prop, lines 21-26
// Final inventory for this page: h1 x1, h2 x5, h3 x2.
//
// ContentBoxTwoCyberCut defaults its title tag to `p` (so a chrome usage stays out
// of the heading inventory), so section 6 passes as="h2" explicitly — leaving it
// off would silently drop an H2 from the rendered page.
//
// Shape rhythm, top to bottom: cut-corner slab on the raised surface with a
// border-left heading rail -> borderless two-column grid with gold/black icon
// chips -> rounded card with a solid-gold floating badge -> 3:7 cut-corner card on
// the deepest surface with the picture on the LEFT -> 7:3 rounded card with a dark
// floating badge and the picture on the RIGHT -> two-column cut-corner card on the
// mid surface -> two half-cards with icon badges and a button row -> accordion.
// No shape repeats back to back; the three cut-corner cards are separated by
// surface depth (#17130a / #060402 / #0e0b05) rather than by heading colour alone,
// and the two floating badges are deliberate opposites (solid-gold plate with dark
// ink vs dark plate with gradient gold text), so no two cards read as the same card
// twice.
//
// ContentBoxSevenThreeCyberCut takes the docx heading through `title`, which falls
// back to its wide (7fr) RIGHT text column; its image column is passed no
// `titleleft`, so the block emits exactly one heading. ContentBoxSevenThree-
// FloatingBadge is the mirror and takes its heading through `title` too, which
// renders in the floating badge, with neither `titleleft` nor `titleright` passed.
//
// Every brief paragraph ships in full — all eleven of them, nothing merged or
// summarised. Sections 2, 6 and 7 have two paragraphs each and run one per column;
// sections 1, 3, 4 and 5 have one each. The column labels passed to the two
// two-column boxes are this page's own layout wording, not brief headings, and both
// variants render those labels as <p>.
//
// Everything else on the page is chrome and emits no heading tag at any level:
// Announcement5, LatestWinners4, LoginRtpSection and ReviewCardSumo render their
// titles as <p>/<span> with an aria-label on the section, and Faq3's questions live
// inside <summary> as <p>. The non-brief widgets sit before section 1 (the ticker,
// then the winners feed) and after section 8 (LoginRtpSection, ReviewCardSumo,
// Navfoot) — never spliced between two content sections.

// One array, used by both <Faq> and the FAQPage node — never the component's own
// defaults (Faq3 deliberately ships none, so a forgotten prop renders an empty
// accordion rather than some previous brand's questions). The three pairs are the
// brief's own Q/A block (content.txt lines 21-26), verbatim.
const faqs = [
  {
    q: `${BRAND_NAME} มีเกมเดิมพันอะไรให้เลือกบ้าง?`,
    a: `${BRAND_NAME} รวมหลายหมวดไว้ในระบบเดียว ทั้งบาคาร่า รูเล็ต บอล หวย สล็อต และเกมคาสิโนอื่นตามรายการที่เปิดให้บริการ จำนวนเกม โต๊ะ และตลาดเดิมพันอาจเปลี่ยนแปลงตามช่วงเวลา`,
  },
  {
    q: `${BRAND_NAME} ฝากถอนตรงกับบริษัทจริงหรือไม่?`,
    a: `หากเว็บไซต์ระบุว่ายอดเข้าบริษัทโดยตรง ควรมีชื่อบัญชีและข้อมูลนิติบุคคลที่สามารถตรวจสอบได้ ก่อนทำรายการควรเปรียบเทียบชื่อบัญชีปลายทางกับข้อมูลจากช่องทางหลัก ไม่ควรพิจารณาจากข้อความ “บริษัท 100%” เพียงอย่างเดียว`,
  },
  {
    q: `โปรโมชั่น ${BRAND_NAME} โบนัส 0.3% และ 0.8% ต่างกันอย่างไร?`,
    a: `โบนัส 0.3% เป็นโปรโมชั่นคืนยอดเสียจากยอดที่เข้าเงื่อนไข ส่วนโบนัส 0.8% เป็นกิจกรรมแนะนำเพื่อนจากยอดที่กำหนด ทั้งสองรายการอาจมีรอบคำนวณ ประเภทเกม และเงื่อนไขรับโบนัสแตกต่างกัน ควรตรวจสอบรายละเอียดล่าสุดก่อนรับสิทธิ์`,
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space that
// splits the word — the copy must read identically with the tags removed.
// One highlight colour only: #ffe79a, the champagne gold, against the inherited
// body colour #f3e7cd (BRAND_TEXT). The paragraphs below carry no colour class of
// their own: every ContentBox* card in this mix already sets
// `text-left text-base leading-relaxed text-[#f3e7cd]` on the element holding the
// slot, so the prose inherits it and no page-level override can drift from the
// card. No paragraph carries mx-auto or max-w-* either — the cards cap their own
// width. One element per slot, everywhere.

// No breadcrumb: this is the homepage, so a trail from the root to itself would be a
// single self-referential crumb. Every URL in the graph is derived by pageGraph from
// `site:` — no domain is typed out in this file, no URL is built with `+`, and no
// Review / AggregateRating / sameAs / address / email node is passed. `description`
// is the exact same string MainLayout gets.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <LatestWinners />

  <ContentBoxCyberCut as="h1" title={`${BRAND_NAME} คาสิโนฐานเข้าหลัก เดิมพันตรงกับบริษัท100%`}>
    <p>
      {BRAND_NAME}
      <strong class="text-[#ffe79a]">คาสิโนฐานเข้าหลักที่รวมช่องทางเดิมพันหลายประเภทไว้ในระบบเดียว</strong>
      รองรับทั้งบาคาร่า รูเล็ต บอล หวย สล็อต และเกมคาสิโนตามรายการที่เปิดให้บริการ
      <strong class="text-[#ffe79a]">สมาชิกสามารถเลือกเกม ตรวจสอบเครดิต โปรโมชั่น และประวัติการเดิมพันผ่านบัญชีเดียวได้สะดวก</strong>
      ส่วนข้อความ เดิมพันตรงกับบริษัท 100% ควรมีชื่อบริษัทหรือนิติบุคคลที่สามารถตรวจสอบได้ เพื่อยืนยันว่าข้อมูลบนเว็บไซต์สอดคล้องกับผู้ให้บริการจริง
    </p>
  </ContentBoxCyberCut>

  <ContentBoxTwo
    as="h2"
    title={`${BRAND_NAME} เกมคาสิโน บาคาร่า รูเล็ต บอล หวย สล็อต ครบวงจร`}
    titleleft="หมวดเดิมพันที่เปิดให้เลือก"
    titleright="กติกาและเวลาเปิดรับของแต่ละรายการ"
    iconleft="🎲"
    iconright="⏱️">
    <p slot="left">
      {BRAND_NAME}
