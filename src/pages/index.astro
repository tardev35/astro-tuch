---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import ContentBox3ThreePremium from "../components/ContentBox3ThreePremium.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LatestWinners from "../components/LatestWinnersCyber.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import Faq3 from "../components/Faq3.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// SLIDE ROLES FOR NEXT55 — READ BEFORE REUSING THESE IMPORTS.
// Both posters were read off the 2026-09-17 drop, and each prints the exact
// percentage its section describes:
//   slide1.png = the แนะนำเพื่อน 0.8% poster (light grey office ground, crimson
//                circuit-node linework, a woman in a grey suit with a phone)
//                                                            -> docx H3 #4
//   slide2.png = the คืนยอดเสีย 0.3% poster (dark charcoal ground, gold coins at
//                the left, a woman in a grey suit over a red top) -> docx H3 #5
// Re-read the actual artwork on the next rebrand rather than trusting this
// order — a previous brand shipped the two swapped, which builds clean and
// reads wrong.
//
// Two ContentBoxSevenThree* blocks in total — that is the hard cap for the
// family, and a slide* image may not appear anywhere else on the site.
//
// Stale assets that must stay unimported: slide3.png / slide4.png and
// banner2.png / banner3.png all belong to earlier clients. This brand has no
// banner2+ article illustration, so no ContentBox gets an inline banner image
// this round. banner1.png and banner1-mobile.png are the hero pair and belong to
// MainLayout's own pinned globs — never referenced from a page.

// Title and description are the brief's own Title/Meta Description lines, used
// verbatim. A brief-supplied description is never padded up to the 150-char
// floor and never topped up from the H1/H2.
const pageTitle = "NEXT55 คาสิโนออนไลน์เว็บตรงครบวงจร ไม่มีขั้นต่ำ รับวอลเลท";

const pageDescription = "NEXT55 คาสิโนออนไลน์เว็บตรงครบวงจร เดิมพันไม่มีขั้นต่ำ ฝากถอนไม่จำกัด รับทุกธนาคารและวอลเลท";

// <Announcement /> runs bare: Announcement3's default message is already this
// brand's copy, and every sub-page calls it bare too — passing an override here
// is how the ticker ends up saying two different things on two pages.

// The docx has a real H1 -> H2 -> H3 hierarchy this round (#4 and #5 are genuine
// H3 sub-points of #3), so the page is NOT flattened to H2-only. The other H3s
// are the sanctioned sub-point shapes: FeatureHighlights' five game types under
// #2 and ContentBox3ThreePremium's three signup steps under #6.

// One array, used by both <Faq3> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last. The three pairs
// are the brief's Q1-Q3, verbatim.
const faqs = [
  {
    q: "NEXT55 มีข้อกำหนดเรื่องขั้นต่ำในการฝาก-ถอนเงินหรือไม่?",
    a: "เว็บไซต์ของเราให้อิสระทางการเงินอย่างเต็มที่ ไม่มีขั้นต่ำในการฝาก-ถอน ทุน 1 บาทก็สามารถฝากเข้ามาเล่นได้ และรองรับการทำธุรกรรมผ่านทุกธนาคารชั้นนำ รวมถึง TrueMoney Wallet ด้วยระบบออโต้ที่รวดเร็วภายใน 5 วินาที",
  },
  {
    q: "NEXT55 เป็นเว็บตรง ไม่ผ่านเอเย่นต์ จริงหรือไม่ ปลอดภัยแค่ไหน?",
    a: "NEXT55 คือเว็บตรง 100% ที่ได้รับอนุญาตอย่างถูกต้อง ไม่ผ่านเอเย่นต์หรือตัวแทนใดๆ ทำให้มีความมั่นคงทางการเงินสูง จ่ายจริงทุกยอดบิล และมีระบบรักษาความปลอดภัยของข้อมูลสมาชิกระดับสากล",
  },
  {
    q: "สามารถเข้าเล่นเกมของ NEXT55 ผ่านมือถือได้ไหม?",
    a: "ได้แน่นอนครับ แพลตฟอร์มของเราถูกพัฒนามาให้รองรับการใช้งานบนทุกอุปกรณ์ ทั้งสมาร์ทโฟน (iOS และ Android), แท็บเล็ต และคอมพิวเตอร์พีซี คุณสามารถเข้าเล่นผ่านเว็บบราว์เซอร์ได้ทันทีโดยไม่ต้องดาวน์โหลดแอปพลิเคชันให้ยุ่งยาก",
  },
];

// The five game types the brief lists under H2 #2, as the sanctioned
// FeatureHighlights sub-point shape — each label renders as an <h3> under that
// section's single <h2>, and the descriptions are the docx's own sentences.
const gameTypes = [
  {
    icon: "🃏",
    title: "บาคาร่าและคาสิโนสด",
    description: "ถ่ายทอดสดจากคาสิโนชั้นนำ ภาพคมชัดระดับ Full HD สัมผัสบรรยากาศสมจริงเหมือนนั่งอยู่ในคาสิโนวีไอพี",
    accent: "crimson" as const,
  },
  {
    icon: "🎰",
    title: "สล็อตออนไลน์",
    description: "รวบรวมค่ายเกมสล็อตลิขสิทธิ์แท้ แจ็คพอตแตกง่าย ฟีเจอร์แน่น ภาพสวยงามตระการตา",
    accent: "steel" as const,
  },
  {
    icon: "🐟",
    title: "เกมยิงปลา",
    description: "สนุกไปกับเกมยิงปลาที่เล่นง่าย ตายไว กราฟิกสวยงาม ทำกำไรได้รวดเร็ว",
    accent: "crimson" as const,
  },
  {
    icon: "🎫",
    title: "หวยออนไลน์",
    description: "รับแทงหวยทุกประเภท ทั้งหวยรัฐบาล ลาว ฮานอย จ่ายหนัก จ่ายเต็ม ไม่มีเลขอั้น",
    accent: "steel" as const,
  },
  {
    icon: "⚽",
    title: "แทงบอลและกีฬา",
    description: "ค่าน้ำดีที่สุด เปิดรับเดิมพันทุกลีกดังทั่วโลก พร้อมรูปแบบการแทงที่หลากหลาย",
    accent: "crimson" as const,
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// The highlight colour is the palette's pale rose (#ffb3bf); it marks a claim
// the brief states outright and nothing else.

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb. Every URL in the graph is derived
// by pageGraph from `site:` — no domain is typed out in this file.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxPremium as="h1" title="NEXT55 คาสิโนออนไลน์เว็บตรงครบวงจร ปลอดภัย เชื่อถือได้">
    <p class="text-left text-base leading-relaxed text-[#d5dae2]">
      ยินดีต้อนรับสู่ NEXT55
      <strong class="text-[#ffb3bf]">ศูนย์รวมความบันเทิงและคาสิโนออนไลน์เว็บตรงที่มาแรงที่สุดในขณะนี้</strong>
      <strong class="text-[#ffb3bf]">เราคือผู้ให้บริการแพลตฟอร์มเดิมพันครบวงจรที่ไม่ผ่านเอเย่นต์ มุ่งเน้นมาตรฐานความปลอดภัยระดับสากล</strong>
      เพื่อให้ผู้เล่นทุกคนสัมผัสประสบการณ์การเดิมพันที่โปร่งใส
      <strong class="text-[#ffb3bf]">ยุติธรรม และเชื่อถือได้ 100%</strong>
      ไม่ว่าคุณจะชื่นชอบเกมประเภทไหน NEXT55 พร้อมมอบความสนุกและโอกาสในการทำกำไรให้คุณตลอดเวลา ด้วยระบบที่เสถียรและบริการที่เหนือระดับ
    </p>
  </ContentBoxPremium>

  <ContentBoxCyberCut as="h2" title="NEXT55 รวมเกมคาสิโน บาคาร่า สล็อต ยิงปลา หวย บอล เริ่มต้น1บาท">
    <div>
      <p class="text-left text-base leading-relaxed text-[#d5dae2]">
        ที่ NEXT55
        <strong class="text-[#ffb3bf]">เราตอบโจทย์ทุกไลฟ์สไตล์การเดิมพันด้วยการรวบรวมเกมยอดฮิตจากทุกค่ายดังทั่วโลกมาไว้ในเว็บเดียว (One-Stop Service)</strong>
        เปิดโอกาสให้ทุกคนเข้าถึงความสนุกได้ง่ายๆ ด้วยเงินทุน
        <strong class="text-[#ffb3bf]">เริ่มต้นเพียง 1 บาท</strong>
        เท่านั้น
      </p>
      <FeatureHighlights items={gameTypes} />
    </div>
  </ContentBoxCyberCut>

  <ProviderGrid />

  <GameRankingBoard />

  <ContentBoxTwoPremium as="h2" title="โปรโมชั่น NEXT55 จัดเต็มทุกยูส รับได้ทุกวัน">
    <p slot="left" class="text-left text-base leading-relaxed text-[#d5dae2]">
      <strong class="text-[#ffb3bf]">เราพร้อมคืนกำไรและมอบความคุ้มค่าสูงสุดให้กับสมาชิกด้วยโปรโมชั่นสุดพิเศษที่แจกหนัก</strong>
      จัดเต็มให้กับทุกยูสเซอร์
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#d5dae2]">
      ไม่ว่าจะเป็นสมาชิกใหม่หรือเก่า
      <strong class="text-[#ffb3bf]">ก็สามารถกดรับสิทธิประโยชน์ดีๆ จากเราได้ทุกวัน ไม่มีกั๊ก</strong>
    </p>
  </ContentBoxTwoPremium>

  <ContentBoxSevenThreePremium as="h3" title="โปรโมชั่น แนะนำเพื่อน 0.8%">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อน 0.8% ของ NEXT55 พื้นหลังโทนเทาอ่อนแบบออฟฟิศ มีลายเส้นวงจรจุดต่อสีแดงเข้มและเครื่องหมายกากบาทสีแดงจางอยู่ด้านหลัง มุมซ้ายบนเป็นโลโก้ NEXT55 ตัวอักษรสีเทากราไฟต์ที่แทนตัว X ด้วยลูกศรสีแดงสองอันประกบกัน ด้านซ้ายเขียนว่า โปรโมชั่น บรรทัดถัดมาเขียนว่า แนะนำเพื่อน และตัวเลข 0.8% ตัวใหญ่สีแดงสด ใต้ลงมาเขียนว่า เพื่อรับสิทธิพิเศษวันนี้! ด้านขวาเป็นหญิงสวมสูทสีเทาถือโทรศัพท์มือถือและชี้มือไปที่ตัวเลข"
      class="mx-auto h-auto w-full rounded-2xl border border-[#cd1437]/45 shadow-[0_10px_30px_rgba(205,20,55,0.24)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#d5dae2]">
      สร้างรายได้เสริมแบบง่ายๆ เพียงนำลิงก์ส่วนตัวของคุณไปแชร์ให้เพื่อนสมัครและเข้าเล่น
      <strong class="text-[#ffb3bf]">คุณจะได้รับค่าคอมมิชชั่นสูงถึง 0.8% จากทุกยอดการเล่นของเพื่อนทันที</strong>
      เป็นระบบ
      <strong class="text-[#ffb3bf]">Passive Income ที่ยิ่งชวนมาก ยิ่งได้เงินมาก สามารถถอนเป็นเงินสดได้ตลอดเวลา</strong>
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBoxSevenThreeFloatingBadge as="h3" title="โปรโมชั่น คืนยอดเสีย 0.3%">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นคืนยอดเสีย 0.3% ของ NEXT55 พื้นหลังสีเทากราไฟต์เข้ม มีลายเส้นเทคโนโลยีสีจางพาดทั่วภาพและเหรียญทองกระจายอยู่ทางซ้าย มุมซ้ายบนเป็นโลโก้ NEXT55 ตัวอักษรสีขาวที่แทนตัว X ด้วยลูกศรสีแดงสองอันประกบกัน ตรงกลางเขียนด้วยตัวอักษรสีขาวว่า โปรโมชั่น บรรทัดถัดมาเขียนว่า คืนยอดเสีย 0.3% ด้านขวาเป็นหญิงสวมสูทสีเทาทับเสื้อสีแดงกำลังชี้มือขึ้นไปทางขวาบน"
      class="mx-auto h-auto w-full rounded-2xl border border-[#cd1437]/45 shadow-[0_10px_30px_rgba(205,20,55,0.24)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#d5dae2]">
      ทุกการเดิมพันมีจังหวะของมัน หากวันไหนมือไม่ขึ้น NEXT55 มีระบบเซฟตี้คอยดูแลคุณด้วยโปรโมชั่น
      <strong class="text-[#ffb3bf]">คืนยอดเสีย 0.3% ในทุกยอดการเล่น</strong>
      เพื่อให้คุณมีเครดิตเงินทุนสำรองไว้สำหรับนำไปต่อยอดและพลิกสถานการณ์กลับมาทำกำไรได้อีกครั้ง
    </p>
  </ContentBoxSevenThreeFloatingBadge>

  <LatestWinners />

  <ContentBox as="h2" title="สมัคร NEXT55 ด้วยตัวเอง 3 ขั้นตอน">
    <p class="text-left text-base leading-relaxed text-[#d5dae2]">
      เริ่มต้นความสนุกและเปิดประสบการณ์การเดิมพันที่เหนือกว่าได้ง่ายๆ
      <strong class="text-[#ffb3bf]">ผ่านระบบสมัครสมาชิกอัตโนมัติ (Auto) ที่รวดเร็ว ปลอดภัย ใช้เวลาไม่ถึง 1 นาที</strong>
      เพียงทำตาม 3 ขั้นตอนดังนี้
    </p>
  </ContentBox>

  <ContentBox3ThreePremium
    as="h3"
    label="สามขั้นตอนการสมัครสมาชิก NEXT55 ด้วยตัวเอง"
    titleleft="กรอกเบอร์โทรศัพท์"
    titlecenter="ผูกบัญชีธนาคาร/วอลเลท"
    titleright="ตั้งรหัสผ่าน">
    <p slot="left" class="text-left text-base leading-relaxed text-[#d5dae2]">
      ระบุเบอร์มือถือของคุณเพื่อรับรหัส
      <strong class="text-[#ffb3bf]">OTP สำหรับยืนยันตัวตน</strong>
    </p>
    <p slot="center" class="text-left text-base leading-relaxed text-[#d5dae2]">
      เลือกธนาคารหรือ TrueMoney Wallet พร้อมกรอกเลขบัญชี
      <strong class="text-[#ffb3bf]">(ชื่อ-นามสกุลต้องตรงกับข้อมูลที่ใช้สมัคร เพื่อความปลอดภัยในการฝาก-ถอน)</strong>
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#d5dae2]">
      กำหนด Username และ Password ของคุณ ล็อคอินเข้าสู่ระบบ
      <strong class="text-[#ffb3bf]">ฝากเงินแบบไม่มีขั้นต่ำ แล้วเริ่มทำกำไรได้ทันที!</strong>
    </p>
  </ContentBox3ThreePremium>

  <LoginRtpSection />

  <ContentBoxNeumorphism as="h2" title="NEXT55 เปิดช่องทางติดต่อแอดมินได้ 24 ชั่วโมง">
    <p class="text-left text-base leading-relaxed text-[#d5dae2]">
      เราใส่ใจในทุกรายละเอียดการให้บริการ NEXT55
      <strong class="text-[#ffb3bf]">มีทีมงานแอดมินคุณภาพที่ผ่านการอบรมมาเป็นอย่างดี</strong>
      พร้อมสแตนด์บายดูแลสมาชิกทุกท่านผ่านช่องทาง
      <strong class="text-[#ffb3bf]">Line Official ตลอด 24 ชั่วโมง</strong>
      ไม่ว่าคุณจะติดปัญหาเรื่องการใช้งาน สอบถามข้อมูลโปรโมชั่น หรือต้องการความช่วยเหลือเรื่องการฝาก-ถอน
      <strong class="text-[#ffb3bf]">ทีมงานของเราพร้อมตอบกลับอย่างรวดเร็ว สุภาพ และคอยซัพพอร์ตคุณในทุกสถานการณ์</strong>
    </p>
  </ContentBoxNeumorphism>

  <Faq3 as="h2" title="คำถามที่พบบ่อย (FAQ)" faqs={faqs} />

  <ReviewCardSumo2 />

  <Navfoot />
</MainLayout>
