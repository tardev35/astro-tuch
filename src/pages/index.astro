---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement2.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ContentBox from "../components/ContentBox.astro";
import LatestWinners from "../components/LatestWinners3.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Faq from "../components/Faq4.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// Title and description are the brief's own Title/Description lines, used
// verbatim. A brief-supplied description is never padded up to the 150-char
// floor and never topped up from the H1/H2.
const pageTitle = "CASINO888 เว็บคาสิโน888 บาคาร่า สล็อต หวย บอล ขั้นต่ำ1บาท";

const pageDescription = "CASINO888 ทางเข้าเล่น เว็บคาสิโน888 รวมเกมเดิมพันครบวงจร บาคาร่า สล็อต หวย บอล ถูกลิขสิทธิ์ ขั้นต่ำในการเดิมพันแค่ 1 บาท ไม่จำกัดรอบ";

// The ticker copy is passed explicitly rather than relying on the component's
// default — every Announcement* variant's default belongs to whichever brand
// wired it in last. No emoji in this string: an emoji baked into a text prop
// cannot be given its own aria-hidden span, and this marquee prints the string
// three times.
const announcement =
  "CASINO888 รวมเกมเดิมพันออนไลน์หลายประเภทไว้ให้เลือกผ่านบัญชีเดียว ทั้งบาคาร่า สล็อต หวย และฟุตบอล • รองรับการใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ • จัดหมวดหมู่เกมไว้ให้ค้นหาได้ง่าย ทั้งบาคาร่าและคาสิโนสด สล็อตออนไลน์ หวยออนไลน์หลายประเภท และการเดิมพันฟุตบอลตามรายการที่เปิดให้บริการ • ควรตรวจสอบอัตราจ่าย กติกา และขั้นต่ำของการเดิมพันก่อนยืนยันรายการทุกครั้ง • บางเกมอาจรองรับการเดิมพันเริ่มต้นประมาณ 1 บาท ขึ้นอยู่กับข้อกำหนดของผู้ให้บริการแต่ละราย • โปรโมชั่นแนะนำเพื่อนรับโบนัส 0.8% ตามเงื่อนไข • โปรโมชั่นคืนยอดเสียรับโบนัส 0.3% ตามรอบที่กำหนด • สมัคร CASINO888 ผ่านมือถือหรือคอมพิวเตอร์ได้ด้วย 3 ขั้นตอนหลัก • แอดมิน CASINO888 ให้บริการตลอด 24 ชั่วโมง";

// One array, used by both <Faq> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last.
const faqs = [
  {
    q: "CASINO888 มีเกมอะไรให้เลือกเดิมพันบ้าง?",
    a: "มีทั้งบาคาร่า สล็อตออนไลน์ หวยออนไลน์ ฟุตบอล และเกมเดิมพันประเภทอื่น ๆ ตามที่ระบบเปิดให้บริการ สมาชิกสามารถตรวจสอบรายการเกม อัตราจ่าย และรายละเอียดล่าสุดได้ก่อนเริ่มเดิมพัน",
  },
  {
    q: "CASINO888 เดิมพันขั้นต่ำ 1 บาทได้ทุกเกมหรือไม่?",
    a: "ไม่จำเป็นต้องทุกเกม เนื่องจากขั้นต่ำขึ้นอยู่กับประเภทการเดิมพันและผู้ให้บริการ หากต้องการเล่นด้วยทุนเริ่มต้น 1 บาท ควรเลือกเกมที่แสดงขั้นต่ำดังกล่าวและตรวจสอบตัวเลขก่อนยืนยันเดิมพัน",
  },
  {
    q: "โบนัส CASINO888 0.8% และ 0.3% รับอย่างไร?",
    a: "โบนัส 0.8% เป็นโปรโมชั่นแนะนำเพื่อนสำหรับรายการที่เข้าเงื่อนไข ส่วนโบนัส 0.3% เป็นโปรโมชั่นคืนยอดเสียตามรอบที่กำหนด สมาชิกควรตรวจสอบวิธีคำนวณและเงื่อนไขล่าสุดจากหน้าโปรโมชั่นก่อนกดรับทุกครั้ง",
  },
];

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb. Every URL in the graph is derived
// by pageGraph from `site:` — no domain is typed out in this file.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <ContentBoxCyberCut as="h1" title="CASINO888 เว็บพนัน888 แหล่งเดิมพันออนไลน์ ครบวงจร">
    <p class="text-left text-base leading-relaxed text-[#e9ddc4]">
      <strong class="text-[#fdf49c]">CASINO888</strong> รวมเกมเดิมพันออนไลน์หลายประเภทไว้ให้เลือกผ่านบัญชีเดียว ทั้งบาคาร่า สล็อต หวย และฟุตบอล รองรับการใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ มีเกมที่เริ่มเดิมพันในระดับต่ำตามเงื่อนไขของแต่ละค่าย
      พร้อมโปรโมชั่นแนะนำเพื่อน <span class="font-black text-[#fae582]">0.8%</span> และคืนยอดเสีย <span class="font-black text-[#fae582]">0.3%</span>
      สมาชิกสามารถสมัคร ตรวจสอบโบนัส ฝากถอน และเลือกเกมที่ต้องการได้จากระบบเดียว พร้อมแอดมินให้บริการตลอด 24 ชั่วโมง
    </p>
  </ContentBoxCyberCut>

  <ProviderGrid />

  <ContentBoxPremium as="h2" title="ทางเข้าเล่น CASINO888 บาคาร่า สล็อต หวย บอล ถูกลิขสิทธิ์ ไม่ผ่านเอเย่นต์">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e9ddc4]">
        <strong class="text-[#fdf49c]">CASINO888</strong> จัดหมวดหมู่เกมเดิมพันไว้ให้ค้นหาได้ง่าย ไม่ว่าจะเป็นบาคาร่าและเกมคาสิโนสด สล็อตออนไลน์ หวยออนไลน์หลายประเภท รวมถึงการเดิมพันฟุตบอลตามรายการที่เปิดให้บริการ
        สมาชิกสามารถเลือกเกม ตรวจสอบอัตราจ่าย กติกา และขั้นต่ำของการเดิมพันก่อนยืนยันรายการ โดยบางเกมอาจรองรับการเดิมพันเริ่มต้นประมาณ <span class="font-black text-[#fae582]">1 บาท</span>
        ขึ้นอยู่กับข้อกำหนดของผู้ให้บริการแต่ละราย
      </p>
      <p class="text-left text-base leading-relaxed text-[#e9ddc4]">
        สำหรับข้อมูลเรื่องลิขสิทธิ์และสถานะการเป็นเว็บตรง ควรตรวจสอบรายละเอียดผู้ให้บริการเกมหรือใบอนุญาตที่เว็บไซต์แสดงโดยตรง เพื่อให้ข้อมูลบนหน้าเว็บสอดคล้องกับบริการจริง
      </p>
    </div>
  </ContentBoxPremium>

  <ContentBoxNeumorphism as="h2" title="โบนัส CASINO888 ทุกยอดฝาก กดรับได้ทุกวัน">
    <p class="text-left text-base leading-relaxed text-[#e9ddc4]">
      สมาชิก <strong class="text-[#fdf49c]">CASINO888</strong> สามารถ Login เพื่อตรวจสอบโปรโมชั่นที่เปิดให้รับในแต่ละวัน โดยมีทั้งโบนัสจากกิจกรรมแนะนำเพื่อนและโปรโมชั่นคืนยอดเสีย แต่ละรายการอาจกำหนดยอดที่ใช้คำนวณ
      รอบรับโบนัส และเงื่อนไขแตกต่างกัน ก่อนกดรับจึงควรอ่านรายละเอียดให้ครบถ้วน โดยเฉพาะข้อกำหนดเกี่ยวกับยอดเดิมพันและการถอนโบนัส
    </p>
  </ContentBoxNeumorphism>

  <ContentBoxSevenThreeCyberCut as="h3" title="โปรโมชั่นแนะนำเพื่อน รับโบนัส 0.8%">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อนของ CASINO888 พื้นหลังสีดำมีประกายสีทอง ด้านบนเป็นโลโก้คำว่า CASINO สีขาวเงินคู่กับเลข 888 ถัดลงมาเป็นข้อความสีขาวว่า โปรโมชั่น และคำว่า แนะนำเพื่อน สีทอง พร้อมตัวเลข 0.8% ขนาดใหญ่สีทองในกรอบสีดำ ด้านขวาเป็นนางแบบผมสีเงินยาวในชุดสีดำทองกำลังชี้นิ้วมาที่ตัวเลข ฉากหลังมีวงล้อรูเล็ต กองเหรียญทอง และไพ่โพดำกระจายอยู่"
      class="mx-auto h-auto w-full rounded-2xl border border-[#e4c25a]/35 shadow-[0_10px_30px_rgba(228,194,90,0.28)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#e9ddc4]">
      สมาชิกสามารถแชร์ลิงก์แนะนำส่วนตัวให้เพื่อน เมื่อเพื่อนสมัครและมียอดการใช้งานตรงตามเงื่อนไข ระบบจะคำนวณโบนัสแนะนำเพื่อน <span class="font-black text-[#fae582]">0.8%</span> ตามข้อกำหนด สามารถติดตามจำนวนการแนะนำ
      ยอดที่นำมาคำนวณ และโบนัสที่มีสิทธิ์รับผ่านบัญชีสมาชิกได้ด้วยตนเอง
    </p>
  </ContentBoxSevenThreeCyberCut>

  <ContentBoxSevenThreeCyberCut as="h3" title="โปรโมชั่นคืนยอดเสีย รับโบนัส 0.3%">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นคืนยอดเสียของ CASINO888 พื้นหลังสีดำมีประกายสีทองและวงล้อรูเล็ต ด้านบนเป็นโลโก้ CASINO 888 ถัดลงมาเป็นข้อความสีขาวว่า โปรโมชั่น ในกรอบสีดำ และคำว่า คืนยอดเสีย สีขาว พร้อมตัวเลข 0.3% สีทองขนาดใหญ่ ด้านขวาเป็นนางแบบผมสีเงินยาวในชุดสีดำทอง ฉากหลังมีเหรียญทอง ไพ่ และเลข 777 กระจายอยู่"
      class="mx-auto h-auto w-full rounded-2xl border border-[#e4c25a]/35 shadow-[0_10px_30px_rgba(228,194,90,0.28)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#e9ddc4]">
      สมาชิกที่มียอดเสียตรงตามเงื่อนไขสามารถตรวจสอบสิทธิ์รับโบนัสคืนยอดเสีย <span class="font-black text-[#fae582]">0.3%</span> ตามรอบประจำวันที่กำหนด ระบบจะแสดงยอดที่เข้าเกณฑ์และโบนัสที่สามารถรับได้ ก่อนกดยืนยันควรตรวจสอบประเภทเกม
      รอบคำนวณ และข้อกำหนดของโปรโมชั่นให้เรียบร้อย
    </p>
  </ContentBoxSevenThreeCyberCut>

  <ContentBoxTwoPremium as="h2" title="สมัคร CASINO888 ง่าย ๆ 3 ขั้นตอน">
    <div slot="left" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e9ddc4]">
        การสมัคร <strong class="text-[#fdf49c]">CASINO888</strong> สามารถทำผ่านมือถือหรือคอมพิวเตอร์ได้ โดยหลังเปิดบัญชีเรียบร้อย สมาชิกสามารถเลือกหมวดเกมและจัดการเครดิตผ่านระบบออนไลน์ได้ทันที
      </p>
      <ol class="list-decimal space-y-2 pl-5 text-left text-base leading-relaxed text-[#e9ddc4] marker:font-black marker:text-[#e4c25a]">
        <li>เปิดหน้าสมัคร CASINO888 และกรอกข้อมูลตามที่ระบบกำหนด</li>
        <li>Login เข้าบัญชี ฝากเครดิต และตรวจสอบโปรโมชั่นที่มีสิทธิ์รับ</li>
        <li>เลือกบาคาร่า สล็อต หวย หรือฟุตบอล ตรวจสอบขั้นต่ำและกติกาก่อนเดิมพัน</li>
      </ol>
    </div>
    <p slot="right" class="text-left text-base leading-relaxed text-[#e9ddc4]">
      หากต้องการเริ่มเดิมพันเพียง <span class="font-black text-[#fae582]">1 บาท</span> ควรตรวจสอบขั้นต่ำจริงของเกมหรือประเภทการเดิมพันนั้นก่อนทำรายการ เพราะแต่ละค่ายและแต่ละเกมอาจกำหนดขั้นต่ำไม่เท่ากัน
    </p>
  </ContentBoxTwoPremium>

  <LoginRtpSection />

  <ContentBox as="h2" title="ติดต่อสอบถามแอดมิน CASINO888 ได้ตลอด 24 ชั่วโมง">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e9ddc4]">
        หากพบปัญหาเกี่ยวกับการสมัครสมาชิก Login ไม่ได้ ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง โปรโมชั่นไม่แสดง หรือเข้าเกมไม่ได้ สามารถติดต่อแอดมิน <strong class="text-[#fdf49c]">CASINO888</strong>
        ได้ตลอด 24 ชั่วโมง พร้อมแจ้งรายละเอียด เวลา และข้อมูลรายการที่เกี่ยวข้อง เพื่อช่วยให้เจ้าหน้าที่ตรวจสอบปัญหาได้ตรงจุด
      </p>
      <p class="text-left text-base leading-relaxed text-[#e9ddc4]">
        สมาชิกใหม่ยังสามารถสอบถามขั้นตอนฝากถอน วิธีรับโปรโมชั่น หรือข้อมูลการใช้งานเกมแต่ละหมวดได้ โดยไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      </p>
    </div>
  </ContentBox>

  <LatestWinners />

  <ReviewCardSumo />

  <Faq title="คำถามที่พบบ่อยเกี่ยวกับ CASINO888" faqs={faqs} />

  <Navfoot />
</MainLayout>
