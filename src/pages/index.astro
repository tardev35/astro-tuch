---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBox3ThreeCyberCut from "../components/ContentBox3ThreeCyberCut.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBox from "../components/ContentBox.astro";
import ProviderGridPremium from "../components/ProviderGridPremium.astro";
import Faq2 from "../components/Faq2.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import LatestWinners from "../components/LatestWinnersPremium.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// Title and description are the brief's own Title/Description lines, verbatim.
// A brief-supplied description ships at whatever length it was written — it is
// not padded up to the 150-character floor.
const pageTitle = "JUDTEM168 ศูนย์สล็อตอันดับ1 ฝากถอนออโต้ เล่นง่าย บริการตลอดทั้งวัน";

const pageDescription = "JUDTEM168 ศูนย์สล็อตอันดับ1 รวมค่ายเกมฮิตติดอันดับ โปรแตกง่าย ฝากถอนออโต้ เล่นได้ตลอดทั้งวัน";

// The ticker copy is passed explicitly rather than relying on the component's
// default — every Announcement* variant's default belongs to whichever brand
// wired it in last. The string matches AnnouncementPremium's current default on
// purpose, so the pages that call <Announcement /> bare show the same ticker.
// No emoji in this string: an emoji baked into a text prop cannot be given its
// own aria-hidden span, and this marquee prints the string twice.
const announcement =
  "JUDTEM168 ศูนย์สล็อตอันดับ1 รวมค่ายเกมฮิตติดอันดับ ฝากถอนออโต้ เล่นได้ตลอดทั้งวัน • รวมเกมจาก PG SOFT, Pragmatic Play, JILI, JDB และ Habanero ไว้ในบัญชีเดียว • โปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไขของกิจกรรม • รองรับทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์ • แอดมิน JUDTEM168 ตรวจสอบรายการให้ตลอดทั้งวัน";

// One array, used by both <Faq2> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last.
const faqs = [
  {
    q: "JUDTEM168 มีค่ายเกมสล็อตอะไรให้เลือกบ้าง?",
    a: "สามารถมีเกมจากค่ายอย่าง PG SOFT, Pragmatic Play, JILI, JDB และ Habanero รวมถึงผู้ให้บริการอื่น ๆ โดยควรตรวจสอบรายชื่อค่ายที่เปิดให้บริการล่าสุดภายในหน้าเกมสล็อตของ JUDTEM168 อีกครั้ง",
  },
  {
    q: "โบนัส 0.8% และคืนยอดเสีย 0.3% รับอย่างไร?",
    a: "โบนัส 0.8% เป็นสิทธิ์จากกิจกรรมแนะนำเพื่อน ส่วน 0.3% เป็นโปรโมชั่นคืนยอดเสียสำหรับยอดที่เข้าเงื่อนไข สมาชิกควรตรวจสอบวิธีคำนวณ รอบรับ และข้อกำหนดของแต่ละโปรโมชั่นก่อนกดรับทุกครั้ง",
  },
  {
    q: "ฝากถอน JUDTEM168 แล้วเครดิตไม่เข้าต้องทำอย่างไร?",
    a: "ให้ตรวจสอบสถานะธุรกรรมในบัญชีก่อน หากรายการยังค้างหรือยอดไม่ถูกต้อง สามารถติดต่อแอดมิน JUDTEM168 พร้อมแจ้งเวลา จำนวนเงิน และรายละเอียดรายการ เพื่อให้ทีมงานช่วยตรวจสอบและแนะนำขั้นตอนต่อไปได้",
  },
];

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <SmoothCarousel />

  <ContentBoxCyberCut as="h1" title="JUDTEM168 ศูนย์สล็อตอันดับ1 เข้าเล่นเกมได้ตลอดทั้งวัน">
    <p class="text-left text-base leading-relaxed text-[#f0e2bd]">
      <strong class="text-[#fff6d4]">JUDTEM168</strong> รวมเกมสล็อตออนไลน์หลายรูปแบบไว้ให้สมาชิกเลือกเล่นผ่านบัญชีเดียว รองรับการเข้าใช้งานบนมือถือ แท็บเล็ต และคอมพิวเตอร์ พร้อมระบบฝากถอนออโต้ที่ทำรายการได้ตลอดทั้งวัน
      มีโปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไข รวมถึงทีมงานคอยช่วยตรวจสอบปัญหาเกี่ยวกับบัญชี ฝากถอน โปรโมชั่น และการเข้าเกม
    </p>
  </ContentBoxCyberCut>

  <ContentBoxNeumorphism as="h2" title="JUDTEM168 รวมค่ายเกมสล็อต ฮิตติดอันดับเอเชีย">
    <p class="text-left text-base leading-relaxed text-[#f0e2bd]">
      ภายใน JUDTEM168 สามารถจัดหมวดหมู่เกมสล็อตจากผู้ให้บริการหลายค่าย เพื่อช่วยให้สมาชิกค้นหาเกมที่ชอบได้สะดวก เช่น PG SOFT, Pragmatic Play, JILI, JDB และ Habanero
      ซึ่งแต่ละค่ายมีทั้งสล็อตธีมเอเชีย เกมโบนัส เกมฟีเจอร์พิเศษ และสล็อตรูปแบบอื่น ๆ ให้เลือก ก่อนเข้าเล่นควรตรวจสอบรายชื่อค่ายที่เปิดให้บริการจริง รวมถึงกติกา RTP และรายละเอียดการเดิมพันของแต่ละเกม
    </p>
  </ContentBoxNeumorphism>

  <ProviderGridPremium />

  <ContentBox3ThreeCyberCut
    titleleft="PG SOFT สล็อตเน้นมือถือ เกมหลากหลายธีม"
    titlecenter="Pragmatic Play รวมสล็อตหลายรูปแบบและฟีเจอร์โบนัส"
    titleright="JILI, JDB และ Habanero เพิ่มตัวเลือกเกมสล็อตให้หลากหลาย">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f0e2bd]">
      PG SOFT มีเกมสล็อตที่ออกแบบให้รองรับการเล่นผ่านมือถือ โดยมีเกมหลากหลายธีมและรูปแบบ เช่น Mahjong Ways, Fortune Tiger และ Lucky Neko ผู้เล่นสามารถเลือกเกมตามฟีเจอร์ที่สนใจ
      พร้อมอ่าน Paytable และรายละเอียดโบนัสก่อนเริ่มเดิมพัน
    </p>
    <p slot="center" class="text-left text-base leading-relaxed text-[#f0e2bd]">
      Pragmatic Play เป็นอีกค่ายที่มีเกมสล็อตจำนวนมาก ครอบคลุมทั้งสล็อตคลาสสิก เกมที่มี Free Spins และฟีเจอร์โบนัสหลากหลายรูปแบบ หากพบเกมของค่ายนี้ใน JUDTEM168 ควรตรวจสอบข้อมูลของเกมนั้นโดยตรง
      เนื่องจาก RTP ความผันผวน และขนาดเดิมพันแตกต่างกันในแต่ละเกม
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#f0e2bd]">
      สมาชิกที่ต้องการเปลี่ยนแนวเกมสามารถเลือกดูสล็อตจาก JILI, JDB และ Habanero เพิ่มเติมได้ แต่ละผู้ให้บริการมีธีมและระบบโบนัสแตกต่างกัน ช่วยให้เลือกเกมได้ตามรูปแบบที่ชอบ
      โดยรายชื่อเกมและค่ายที่พร้อมใช้งานจริงให้ยึดข้อมูลล่าสุดที่แสดงภายในระบบ JUDTEM168 เป็นหลัก
    </p>
  </ContentBox3ThreeCyberCut>

  <ContentBoxSpecial as="h2" title="โปรเล่นสล็อต แตกง่าย แจกสมาชิกทุกวัน">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f0e2bd]">
      JUDTEM168 มีโปรโมชั่นสำหรับสมาชิกที่เข้าเงื่อนไขให้ตรวจสอบและกดรับผ่านระบบ ทั้งกิจกรรมแนะนำเพื่อนและคืนยอดเสีย
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#f0e2bd]">
      โดยโปรโมชั่นไม่ได้ทำให้เกมสล็อตมีโอกาสชนะเพิ่มขึ้นหรือรับประกันว่าเกมจะแตกง่าย ผู้เล่นควรใช้โบนัสตามเงื่อนไขและกำหนดงบประมาณในการเล่นให้เหมาะสม
    </p>
  </ContentBoxSpecial>

  <ContentBoxSevenThreePremium as="h3" title="โปรโมชั่นแนะนำเพื่อน รับโบนัส 0.8%">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นพื้นหลังคาสิโนสีดำทอง ด้านบนเป็นโลโก้โพดำสีทอง JUDTEM168 กลางภาพเป็นกรอบทองเขียนว่า โปรโมชั่น แนะนำเพื่อน พร้อมตัวเลขทองขนาดใหญ่ 0.8% ด้านขวาเป็นผู้หญิงผมบลอนด์ในชุดสีทองยืนแบมือ ด้านล่างซ้ายมีกล่องของขวัญสีดำทอง ไพ่เอซ ลูกเต๋า เหรียญทอง และวงล้อสล็อตเลข 777 แถบล่างมีข้อความ ชวนเพื่อนรับค่าคอมสูง รับโบนัสทุกยอดแนะนำ ปลอดภัยมั่นคง 100% และฝากถอนออโต้ 24 ชั่วโมง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#cc9c2d]/50 shadow-[0_10px_30px_rgba(204,156,45,0.28)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f0e2bd]">
      สมาชิกสามารถแชร์ลิงก์แนะนำของตนเองให้เพื่อน เมื่อเพื่อนสมัครและมียอดตรงตามข้อกำหนด ระบบจะคำนวณโบนัสแนะนำเพื่อน <span class="font-black text-[#f5d98a]">0.8%</span> ตามเงื่อนไข
      สามารถตรวจสอบยอดที่นำมาคำนวณและโบนัสที่มีสิทธิ์รับผ่านบัญชีสมาชิกก่อนกดรับได้
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBoxSevenThreePremium as="h3" title="โปรโมชั่นคืนยอดเสีย รับโบนัส 0.3%">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นพื้นหลังคาสิโนสีดำทอง ด้านบนเป็นโลโก้โพดำสีทอง JUDTEM168 กลางภาพเป็นกรอบทองเขียนว่า โปรโมชั่น คืนยอดเสีย พร้อมตัวเลขทองขนาดใหญ่ 0.3% ด้านขวาเป็นผู้หญิงผมบลอนด์ในชุดสีทองดำยืนแบมือ ด้านล่างซ้ายมีหีบสมบัติเหรียญทอง วงล้อสล็อตเลข 777 ไพ่เอซ ลูกเต๋าทอง และเหรียญทองกระจายอยู่รอบภาพ"
      class="mx-auto h-auto w-full rounded-2xl border border-[#cc9c2d]/50 shadow-[0_10px_30px_rgba(204,156,45,0.28)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f0e2bd]">
      สมาชิกที่มียอดเสียเข้าเงื่อนไขสามารถตรวจสอบสิทธิ์รับโบนัสคืนยอดเสีย <span class="font-black text-[#f5d98a]">0.3%</span> ตามรอบที่กำหนด ก่อนรับโบนัสควรตรวจสอบประเภทเกม ยอดที่นำมาคำนวณ
      รอบเวลา และเงื่อนไขการถอนให้ครบถ้วน เพื่อให้ทราบรายละเอียดของสิทธิ์ที่ได้รับ
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBoxPremium as="h2" title="สมัครเล่นสล็อต JUDTEM168 ฝากถอนออโต้ ได้ตลอดทั้งวันทั้งคืน">
    <div class="text-left text-base leading-relaxed text-[#f0e2bd]">
      <p>เริ่มต้นใช้งาน JUDTEM168 ผ่านมือถือได้ง่ายเพียง 3 ขั้นตอน</p>
      <ol class="my-4 flex list-decimal flex-col gap-2 pl-6 marker:font-black marker:text-[#fae27c]">
        <li>สมัครสมาชิกและกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน</li>
        <li>Login เข้าสู่บัญชีและทำรายการฝากเครดิตผ่านระบบออโต้</li>
        <li>เลือกค่ายและเกมสล็อตที่ต้องการ ตรวจสอบกติกาก่อนเริ่มเดิมพัน</li>
      </ol>
      <p>
        สมาชิกสามารถตรวจสอบเครดิต ประวัติรายการ และสถานะฝากถอนผ่านบัญชีของตนเองได้ โดยยอดขั้นต่ำ วงเงิน และช่องทางที่รองรับควรยึดรายละเอียดล่าสุดในระบบ ณ เวลาทำรายการ
      </p>
    </div>
  </ContentBoxPremium>

  <ContentBox as="h2" title="ติดต่อแอดมิน JUDTEM168 แก้ไขปัญหาให้ได้ทันท่วงที ไม่ข้ามวัน">
    <p class="text-left text-base leading-relaxed text-[#f0e2bd]">
      หากพบปัญหา Login ไม่ได้ เครดิตไม่เข้า ถอนเงินค้าง โปรโมชั่นไม่แสดง หรือเข้าเกมสล็อตไม่ได้ สามารถติดต่อแอดมิน JUDTEM168 พร้อมแจ้งรายละเอียดและเวลาที่เกิดปัญหา
      เพื่อให้ทีมงานค้นหารายการและตรวจสอบได้ตรงจุด สำหรับระยะเวลาแก้ไขจะขึ้นอยู่กับลักษณะของปัญหาและขั้นตอนตรวจสอบของแต่ละรายการ
    </p>
  </ContentBox>

  <Faq2 title="คำถามที่พบบ่อยเกี่ยวกับ JUDTEM168" faqs={faqs} />

  <LoginRtpSection />

  <LatestWinners />

  <ReviewCardSumo2 />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#fae27c] via-[#e8bf4e] to-[#cc9c2d] px-4 py-3 text-sm font-black whitespace-nowrap text-[#050301] shadow-[0_10px_30px_rgba(204,156,45,0.32)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(232,191,78,0.46)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#6a5115]/80 bg-gradient-to-r from-[#1d1407] to-[#050301] px-4 py-3 text-sm font-black whitespace-nowrap text-[#fff6d4] shadow-[0_10px_30px_rgba(204,156,45,0.18)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#e8bf4e]/80 hover:text-[#fae27c] hover:shadow-[0_15px_40px_rgba(204,156,45,0.34)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>
  </div>

  <Navfoot />
</MainLayout>
