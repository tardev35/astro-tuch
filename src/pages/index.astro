---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBox3ThreePremium from "../components/ContentBox3ThreePremium.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import Faq from "../components/Faq3.astro";
import LatestWinners from "../components/LatestWinnersCyber.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// VARIANT ROTATION THIS ROUND (PGW44 -> SEXYGAME666). Zero file reuse from the
// previous round: Announcement5 replaces Announcement2, LatestWinnersCyber
// replaces LatestWinners3, Faq3 replaces Faq2, and the ContentBox shape-mix
// moves to Premium / 3ThreePremium / plain ContentBox / SevenThreePremium /
// plain SevenThree / TwoPremium / TwoNeumorphism. NavbarCyber and FooterCyber
// are the layout's pair this round (previously NavbarStyle8 / FooterStyle3).
// Nothing was deleted — every outgoing variant file stays on disk as inventory
// for the next brand.
//
// IMAGE ROLES FOR THIS DROP (2026-09-28) — READ BEFORE REUSING THESE IMPORTS.
// Two files are referenced from this page and only two, both slides, both spent
// on a ContentBoxSevenThree* block — the family's hard cap of two per rebrand,
// so there is no third SevenThree here:
//   slide1.png — the poster whose Thai type reads "โปรโมชั่น แนะนำเพื่อน" above a
//     large "โบนัส 0.8%", so it belongs to docx H3 #4.
//   slide2.png — the companion poster reading "โปรโมชั่น คืนยอดเสีย" above
//     "โบนัส 0.3%", so it belongs to docx H3 #5.
// Both files are 600 px wide, so 600 is the top candidate width — nothing above
// it would be a real pixel. The alt text was written from THIS drop's artwork
// (hot pink and violet neon on black, the SEXYGAME666 wordmark grading pink into
// violet, the woman in the white suit pointing at the type, gold coins, pink and
// violet chips, the spade and heart cards) and is NOT the previous brand's text
// — that poster was gold-and-green with a black-gold P and a vivid green W, none
// of which is in these pictures.
//
// Deliberately NOT imported, and all still on disk as inventory:
//   banner2.png (2026-09-22), banner3.png (2026-09-27), slide3.png (2026-09-18)
//   and slide4.png (2026-08-13) all predate this drop and carry a previous
//   client's artwork. There is therefore NO usable article illustration this
//   round and NO single-column inline image, which is the expected outcome, not
//   a gap to fill with a stale file. banner1.png and banner1-mobile.png belong
//   to MainLayout's own pinned globs and are never referenced from a page — the
//   hero is the LCP element, so nothing here gets loading="eager"
//   fetchpriority="high". og.png is the same: MainLayout's glob owns it.
//
// DROPPED THIS ROUND, and none of the files deleted — every one is inventory for
// the next brand: ProviderGrid / ProviderGridPremium / FeaturedGames /
// PopularGamesStrip / GameRankingBoard each have to name specific studios, table
// names or payout figures, and this brief names none at all — it says only
// "โต๊ะบาคาร่าและเกมคาสิโนสดหลายรูปแบบ ... ตามรายการที่เปิดให้บริการ". BankStrip needs a
// bank or a deposit channel, which the brief also never mentions. SmoothCarousel
// is out because it would put slide* outside a ContentBoxSevenThree*. LottoGrid
// is out because SEXYGAME666 is a live-casino brand, not เว็บหวย (which is also
// why /ตรวจหวย and /แนวทาง stay parked and are never linked from here).
// FeatureHighlights is out because it emits an <h3> per item, and this round's
// two <h3> are real docx headings with their own slides — the 3 signup steps get
// no per-step headings in the brief, so they ship as a plain <ol> instead.
// Filling any of these in would be inventing facts.

// Title and description are the brief's own Title/Description lines, used
// verbatim. A brief-supplied description is never padded up to the 150-char
// floor and never topped up from the H1/H2 — this one ships at 144 characters,
// the length the brief wrote it, which is a passing build (verify-build exempts
// the home page from DESC_MIN for exactly this reason), not a gap to fill.
const pageTitle = "SEXYGAME666 เกมเซ็กซี่บาคาร่าออนไลน์ เว็บแท้เล่นสด 24 ชั่วโมง";

const pageDescription = "SEXYGAME666 เกมเซ็กซี่บาคาร่าออนไลน์ ทางเข้าเล่น เว็บแท้เล่นสดๆ ส่งตรงจากต่างประเทศ ไลฟ์ออนไลน์ 24 ชั่วโมง ปลอดภัย เชื่อถือได้ บัญชีบริษัทโดยตรง";

// <Announcement /> runs bare: Announcement5's default message is already this
// brand's copy, and every sub-page calls it bare too — passing an override here
// is how the ticker ends up saying two different things on two pages.

// The docx has a real H2 -> H3 nesting this round: "แนะนำเพื่อน โบนัส 0.8%" and
// "คืนยอดเสีย โบนัส 0.3%" are genuine sub-points of the โปรโมชั่น H2, so the page
// is NOT flattened to H2-only. Those two are the only <h3> here, and each one is
// carried by its own ContentBoxSevenThree* block together with the slide whose
// artwork states that exact figure.
// Everything else is chrome and emits no heading tag: LatestWinnersCyber,
// LoginRtpSection and ReviewCardSumo2 render their titles as <p>/<span> with an
// aria-label on the section, and Faq3's questions live inside <summary>.
// ContentBox3ThreePremium's three column captions are this page's own wording
// for splitting one docx paragraph into three readable columns, not docx
// sub-points, so heading={false} renders them as <p>.
// ContentBoxTwoPremium's and ContentBoxTwoNeumorphism's column labels are <p>
// inside those components already.
//
// The docx checklist, in order, and what carries each one:
//    1 H1  SEXYGAME666 เกมเซ็กซี่บาคาร่าออนไลน์ เล่นสด 24 ชั่วโมง        ContentBoxPremium
//    2 H2  ทางเข้าเล่น SEXYGAME666 เว็บแท้เล่นสดๆ ส่งตรงจากต่างประเทศ    ContentBox3ThreePremium
//    3 H2  อัปเดตข่าวสารและโปรโมชั่น SEXYGAME666 ได้ก่อนใคร            ContentBox (ตัวธรรมดา)
//    4 H3  แนะนำเพื่อน โบนัส 0.8%                                ContentBoxSevenThreePremium + slide1
//    5 H3  คืนยอดเสีย โบนัส 0.3%                                 ContentBoxSevenThree + slide2
//    6 H2  สมัคร SEXYGAME666 รับโปรโมชั่นง่ายๆ แค่ 3 ขั้นตอน           ContentBoxTwoPremium (intro + <ol>)
//    7 H2  ติดต่อเจ้าหน้าที่ SEXYGAME666 ได้ตลอด 24 ชั่วโมง            ContentBoxTwoNeumorphism
//    8 H2  คำถามที่พบบ่อย                                        Faq3
// Final inventory for this page: h1 x1, h2 x5, h3 x2.
//
// Every docx paragraph ships in full. One block is a multi-column shell, so the
// paragraph that fills it is split across its columns and nowhere else: item 2's
// single paragraph fills the three 3ThreePremium columns in order. Reading them
// left -> centre -> right reproduces the sentence word for word; nothing is
// summarised, merged or repeated. Item 7's paragraph splits the same way across
// the two TwoNeumorphism columns.
//
// Vocabulary: this brief never writes "ไลน์" anywhere, so no copy on this page is
// built around it as a claim — the /line button below is existing chrome and
// keeps its own label, nothing more. The brief also names no game studio, no
// table name, no RTP figure, no licence number, no bank and no deposit channel,
// so neither does this page. The only two numbers it supplies are the 0.8% and
// 0.3% bonuses, and both appear only under the headings that state them.

// One array, used by both <Faq> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last. The three pairs
// are the brief's own Q/A block, verbatim.
const faqs = [
  {
    q: "SEXYGAME666 มีบาคาร่าไลฟ์สดตลอด 24 ชั่วโมงหรือไม่?",
    a: "เว็บไซต์มีเกมบาคาร่าและคาสิโนไลฟ์สดตามรายการและช่วงเวลาที่ผู้ให้บริการเปิดให้ใช้งาน สมาชิกสามารถตรวจสอบโต๊ะที่กำลังออนไลน์และรายละเอียดของแต่ละเกมได้จากหน้าคาสิโนสด",
  },
  {
    q: "SEXYGAME666 มีโปรโมชั่นอะไรบ้าง?",
    a: "โปรโมชั่นหลักตามข้อมูลที่กำหนดมีโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% โดยแต่ละรายการมีเงื่อนไขและรอบรับสิทธิ์แตกต่างกัน ควรตรวจสอบรายละเอียดก่อนกดรับทุกครั้ง",
  },
  {
    q: "สมัคร SEXYGAME666 ผ่านมือถือได้หรือไม่?",
    a: "สามารถสมัครผ่านมือถือได้โดยกรอกข้อมูล ตรวจสอบความถูกต้อง และยืนยันบัญชี เมื่อสมัครเรียบร้อยสามารถเข้าสู่ระบบเพื่อเลือกบาคาร่าและเกมไลฟ์สดที่เปิดให้บริการได้จากหน้าเว็บไซต์",
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// One highlight colour only: near-white #fff2fb against the body colour
// #f2dcee, so the brand's pink and violet stay the page's structural accents
// and the paragraphs never compete with a heading for them.

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb. Every URL in the graph is derived
// by pageGraph from `site:` — no domain is typed out in this file, and no
// Review / AggregateRating / sameAs / address node is passed.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxPremium as="h1" title="SEXYGAME666 เกมเซ็กซี่บาคาร่าออนไลน์ เล่นสด 24 ชั่วโมง">
    <p class="text-left text-base leading-relaxed text-[#f2dcee]">
      SEXYGAME666
      <strong class="text-[#fff2fb]">รวมเกมเซ็กซี่บาคาร่าออนไลน์ในรูปแบบไลฟ์สด</strong>
      พร้อมโต๊ะเกมและรูปแบบการเดิมพันให้เลือกตามรายการที่เปิดให้บริการ
      <strong class="text-[#fff2fb]">รองรับการเข้าใช้งานผ่านมือถือและคอมพิวเตอร์</strong>
      สมาชิกสามารถเลือกโต๊ะ ตรวจสอบรายละเอียดเกม และเข้าเล่นผ่านระบบออนไลน์ได้ตลอด 24 ชั่วโมงตามช่วงเวลาที่ระบบรองรับ
    </p>
  </ContentBoxPremium>

  <ContentBox3ThreePremium
    as="h2"
    title="ทางเข้าเล่น SEXYGAME666 เว็บแท้เล่นสดๆ ส่งตรงจากต่างประเทศ"
    heading={false}
    titleleft="เชื่อมต่อจากต่างประเทศ"
    titlecenter="โต๊ะและเกมคาสิโนสด"
    titleright="ตรวจก่อนเข้าเล่นจริง">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f2dcee]">
      ทางเข้าเล่น SEXYGAME666
      <strong class="text-[#fff2fb]">เชื่อมต่อเกมบาคาร่าไลฟ์สดจากผู้ให้บริการต่างประเทศตามข้อมูลที่เว็บไซต์ระบุ</strong>
    </p>
    <p slot="center" class="text-left text-base leading-relaxed text-[#f2dcee]">
      <strong class="text-[#fff2fb]">มีทั้งโต๊ะบาคาร่าและเกมคาสิโนสดหลายรูปแบบให้เลือก</strong>
      ระบบจัดเมนูให้ค้นหาได้ง่าย
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#f2dcee]">
      รองรับการใช้งานผ่านมือถือ
      <strong class="text-[#fff2fb]">พร้อมรายละเอียดเกมและโต๊ะให้ตรวจสอบก่อนเข้าเล่นจริง</strong>
    </p>
  </ContentBox3ThreePremium>

  <ContentBox as="h2" title="อัปเดตข่าวสารและโปรโมชั่น SEXYGAME666 ได้ก่อนใคร">
    <p class="text-left text-base leading-relaxed text-[#f2dcee]">
      สมาชิก SEXYGAME666 สามารถติดตามข่าวสาร เกมใหม่
      <strong class="text-[#fff2fb]">และโปรโมชั่นที่อัปเดตตามช่วงเวลาได้จากหน้าเว็บไซต์</strong>
      โดยมีทั้งโบนัสแนะนำเพื่อนและโบนัสคืนยอดเสีย พร้อมรายละเอียดเกี่ยวกับยอดที่เข้าเกณฑ์ รอบรับสิทธิ์
      <strong class="text-[#fff2fb]">และเงื่อนไขของแต่ละรายการให้ตรวจสอบก่อนกดรับ</strong>
    </p>
  </ContentBox>

  <ContentBoxSevenThreePremium as="h3" title="แนะนำเพื่อน โบนัส 0.8%">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[340, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), 340px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นพื้นดำโทนชมพู-ม่วง ด้านซ้ายเป็นหญิงสาวผมยาวสีเข้มสวมชุดสูทสีขาว ชี้นิ้วชี้ทั้งสองข้างมาที่ข้อความ ด้านขวาเป็นโลโก้ SEXYGAME666 ไล่เฉดชมพูไปม่วง ถัดลงมาเป็นตัวอักษรไทยสีขาวขอบทองว่า โปรโมชั่น ต่อด้วยคำว่า แนะนำเพื่อน แล้วปิดท้ายด้วยตัวอักษรขนาดใหญ่ว่า โบนัส 0.8% ตามขอบภาพมีเหรียญทอง ชิปคาสิโนสีชมพู และไพ่โพดำกระจายอยู่"
      class="mx-auto h-auto w-full rounded-2xl border border-[#fa42b5]/55 shadow-[0_10px_30px_rgba(250,66,181,0.3)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f2dcee]">
      สมาชิก SEXYGAME666
      <strong class="text-[#fff2fb]">ที่แนะนำเพื่อนเข้ามาสมัครสามารถรับโบนัส 0.8% ตามเงื่อนไขของโปรโมชั่น</strong>
      ระบบมีรายละเอียดเกี่ยวกับยอดที่เข้าเกณฑ์และขั้นตอนรับสิทธิ์ให้ตรวจสอบ
      <strong class="text-[#fff2fb]">ช่วยให้ติดตามโบนัสจากกิจกรรมแนะนำเพื่อนได้สะดวกผ่านบัญชีสมาชิก</strong>
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBoxSevenThreePremium as="h3" title="คืนยอดเสีย โบนัส 0.3%">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[340, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), 380px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นชุดเดียวกันพื้นดำโทนชมพู-ม่วง ด้านซ้ายเป็นหญิงสาวผมยาวสีเข้มสวมชุดสูทสีขาว ชี้นิ้วมาที่ข้อความ ด้านขวาเป็นโลโก้ SEXYGAME666 ไล่เฉดชมพูไปม่วง ถัดลงมาเป็นตัวอักษรไทยสีขาวขอบทองว่า โปรโมชั่น ต่อด้วยคำว่า คืนยอดเสีย แล้วปิดท้ายด้วยตัวอักษรขนาดใหญ่ว่า โบนัส 0.3% รอบภาพมีชิปคาสิโนสีชมพูและม่วง เหรียญทอง และไพ่โพแดงกระจายอยู่"
      class="mx-auto h-auto w-full rounded-2xl border border-[#8b3df3]/55 shadow-[0_10px_30px_rgba(139,61,243,0.26)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f2dcee]">
      โปรโมชั่นคืนยอดเสีย SEXYGAME666
      <strong class="text-[#fff2fb]">ให้โบนัส 0.3% ตามยอดและเงื่อนไขที่ระบบกำหนด</strong>
      สมาชิกสามารถตรวจสอบรอบคำนวณ ยอดที่เข้าเกณฑ์ และรายละเอียดก่อนกดรับ
      <strong class="text-[#fff2fb]">ช่วยให้ติดตามสิทธิ์ในแต่ละรอบได้ง่ายและรู้เงื่อนไขก่อนนำโบนัสไปใช้งาน</strong>
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBoxTwoPremium as="h2" title="สมัคร SEXYGAME666 รับโปรโมชั่นง่ายๆ แค่ 3 ขั้นตอน" titleleft="รายละเอียดการสมัคร" titleright="3 ขั้นตอนหลัก">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f2dcee]">
      การสมัคร SEXYGAME666
      <strong class="text-[#fff2fb]">สามารถทำผ่านหน้าเว็บไซต์ได้ด้วยตัวเอง</strong>
      ขั้นตอนไม่ซับซ้อน หลังจากยืนยันบัญชีเรียบร้อยสามารถเข้าสู่ระบบเพื่อเลือกโต๊ะบาคาร่าและตรวจสอบโปรโมชั่นที่กำลังเปิดให้รับได้
      <strong class="text-[#fff2fb]">โดยมีขั้นตอนหลักเพียง 3 ขั้นตอนดังนี้</strong>
    </p>
    <ol slot="right" class="flex list-decimal flex-col gap-4 pl-6 text-left text-base leading-relaxed text-[#f2dcee] marker:font-black marker:text-[#fa42b5]">
      <li>เปิดหน้าสมัคร SEXYGAME666 แล้วกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน</li>
      <li>ตรวจสอบข้อมูลส่วนตัวและรายละเอียดบัญชีให้ถูกต้องก่อนกดยืนยัน</li>
      <li>ยืนยันการสมัครและเข้าสู่ระบบ จากนั้นเลือกโต๊ะบาคาร่า เกมไลฟ์สด และโปรโมชั่นที่ต้องการได้ทันที</li>
    </ol>
  </ContentBoxTwoPremium>

  <ContentBoxTwoNeumorphism as="h2" title="ติดต่อเจ้าหน้าที่ SEXYGAME666 ได้ตลอด 24 ชั่วโมง" titleleft="ช่องทางติดต่อสอบถาม" titleright="ทีมงานช่วยตรวจสอบ">
    <div slot="left" class="flex flex-col gap-3">
