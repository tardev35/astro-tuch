---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LatestWinnersCyber from "../components/LatestWinnersCyber.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq4.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgPromo from "../assets/slide1.png";

const pageTitle = "BETFLIX6789 อัปเดตเกมใหม่ล่าสุด รวมโปรแตกแรง โบนัสฝากถอนสูง";

const pageDescription =
  "ทางเข้า BETFLIX6789 อัปเดตระบบเกมใหม่ล่าสุด รวมโปรโมชั่น คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% แจกหนักแตกแรง โบนัสฝากถอนสูง พร้อมระบบฝากถอนอัตโนมัติ 24 ชั่วโมง";

const promoItems = [
  {
    icon: "💸",
    title: "โปรโมชั่นคืนยอดเสีย 0.3%",
    description: "สมาชิกที่เข้าร่วมโปรโมชั่นสามารถตรวจสอบสิทธิ์รับคืนยอดเสีย 0.3% ได้ตามเงื่อนไขของเว็บไซต์ โดยระบบจะอัปเดตรายละเอียดการรับสิทธิ์และช่วงเวลาที่สามารถกดรับได้อย่างชัดเจน",
    accent: "gold" as const,
  },
  {
    icon: "🤝",
    title: "โปรโมชั่นแนะนำเพื่อน 0.8%",
    description: "สมาชิกสามารถร่วมกิจกรรมแนะนำเพื่อนและรับโบนัส 0.8% ตามเงื่อนไขที่เว็บไซต์กำหนด พร้อมตรวจสอบข้อมูลการแนะนำและโบนัสที่ได้รับผ่านระบบสมาชิกได้อย่างสะดวก",
    accent: "gold" as const,
  },
];

const onboardingSteps = [
  {
    icon: "📝",
    title: "สมัครสมาชิก",
    description: "กรอกข้อมูลสมัครสมาชิกผ่านระบบออนไลน์ให้ครบถ้วน ใช้เวลาไม่กี่นาทีก็พร้อมเริ่มใช้งาน",
    accent: "gold" as const,
  },
  {
    icon: "💳",
    title: "เข้าสู่ระบบและฝากเครดิต",
    description: "เข้าสู่ระบบแล้วฝากเครดิตผ่านระบบฝากถอนอัตโนมัติ ทำรายการได้เองตลอด 24 ชั่วโมง",
    accent: "blue" as const,
  },
  {
    icon: "🎮",
    title: "เลือกเกมเดิมพัน",
    description: "เลือกเล่นเกมที่ต้องการผ่านมือถือหรือคอมพิวเตอร์ได้ทันที ครบทั้งสล็อต คาสิโน และกีฬา",
    accent: "gold" as const,
  },
];

const faqs = [
  {
    q: "เข้าเล่น BETFLIX6789 ผ่านมือถือต้องติดตั้งโปรแกรมเพิ่มหรือไม่",
    a: "ไม่ต้องติดตั้งโปรแกรมเพิ่มเติม สมาชิกเข้าใช้งาน BETFLIX6789 ผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ได้โดยตรง รองรับทั้งระบบ Android และ iOS พร้อมปรับการแสดงผลให้เหมาะกับทุกขนาดหน้าจอโดยอัตโนมัติ ไม่ว่าจะอยู่ที่บ้าน ที่ทำงาน หรือระหว่างเดินทาง ก็เปิดเล่นต่อจากจุดเดิมได้ทันที",
  },
  {
    q: "BETFLIX6789 รวมเกมเดิมพันประเภทไหนบ้าง",
    a: "BETFLIX6789 รวบรวมเกมเดิมพันออนไลน์จากผู้ให้บริการชั้นนำไว้ในที่เดียว ทั้งเกมสล็อต คาสิโนสด กีฬา และเกมยอดนิยมอื่น ๆ พร้อมอัปเดตเกมใหม่อย่างต่อเนื่อง สมาชิกเลือกใช้งานได้สะดวกผ่านระบบเดียว โดยไม่ต้องสลับหลายเว็บไซต์",
  },
  {
    q: "ก่อนเข้าเล่นควรตรวจอะไรให้ตรงทางเข้า BETFLIX6789",
    a: "ควรตรวจชื่อเว็บไซต์ การเชื่อมต่อ HTTPS โลโก้ และปลายทางของปุ่มเข้าสู่ระบบให้ตรงกันก่อนกรอกข้อมูล โดยเฉพาะลิงก์ที่ส่งมาจากข้อความส่วนตัว เพราะทางเข้า BETFLIX6789 ที่แท้จริงมีมาตรฐานเดียวกันทุกช่องทาง หากมีคนขอรหัสผ่านหรือข้อมูลธนาคารผ่านแชตควรหยุดทันที",
  },
  {
    q: "ระบบฝากถอนของ BETFLIX6789 ใช้เวลาเท่าไหร่",
    a: "ระบบฝากถอนอัตโนมัติเปิดให้บริการตลอด 24 ชั่วโมง รองรับทั้งบัญชีธนาคารและวอลเลท สมาชิกฝากเครดิต ถอนเงิน และตรวจสอบสถานะรายการได้ด้วยตนเองผ่านระบบ หากยอดยังไม่เข้าให้ตรวจประวัติรายการก่อนทำซ้ำ เพราะรายการแรกอาจอยู่ระหว่างประมวลผล",
  },
  {
    q: "สมัครสมาชิก BETFLIX6789 เริ่มเล่นได้เร็วแค่ไหน",
    a: "เริ่มต้นใช้งานได้ง่ายเพียงสมัครสมาชิกผ่านระบบออนไลน์พร้อมกรอกข้อมูลให้ครบถ้วน จากนั้นเข้าสู่ระบบและฝากเครดิตผ่านระบบฝากถอนอัตโนมัติ ก็เลือกเล่นเกมที่ต้องการผ่านมือถือหรือคอมพิวเตอร์ได้ทันที หากพบปัญหาระหว่างสมัครสามารถติดต่อแอดมิน BETFLIX6789 ได้ตลอด 24 ชั่วโมง",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxCyberCut as="h1" title="BETFLIX6789 อัปเดตเกมเข้าใหม่ล่าสุด ระบบแรง แตกไว">
    <p class="text-left text-base leading-relaxed text-[#f4e3c8]">
      <strong class="text-[#f6d78a]">BETFLIX6789</strong> พร้อมให้บริการสำหรับผู้ที่ต้องการเล่นเกมคาสิโนและเกมสล็อตออนไลน์ผ่านระบบที่ทันสมัย รองรับการใช้งานทั้งมือถือและคอมพิวเตอร์
      พร้อมอัปเดตเกมใหม่อย่างต่อเนื่อง เพื่อให้สมาชิกเลือกเล่นได้หลากหลายยิ่งขึ้น ระบบฝากถอนอัตโนมัติช่วยให้การทำธุรกรรมเป็นไปอย่างรวดเร็ว และมีทีมงานคอยดูแลตลอด 24 ชั่วโมง
    </p>
  </ContentBoxCyberCut>

  <SmoothCarousel />

  <ContentBoxFloatingBadge as="h2" title="ทางเข้า BETFLIX6789 อัปเดตระบบเกมใหม่ล่าสุด">
    <p class="text-left text-base leading-relaxed text-[#f4e3c8]">
      สมาชิกสามารถเข้าสู่ระบบ BETFLIX6789 ผ่านทางเข้าเว็บหลักได้ทุกอุปกรณ์ ไม่ว่าจะเป็นสมาร์ตโฟน แท็บเล็ต หรือคอมพิวเตอร์ ระบบได้รับการอัปเดตอย่างสม่ำเสมอ
      เพื่อรองรับเกมใหม่และเพิ่มประสิทธิภาพการใช้งาน ช่วยให้เข้าเล่นเกมได้อย่างลื่นไหล พร้อมรองรับการใช้งานได้ตลอดทั้งวัน
    </p>
  </ContentBoxFloatingBadge>

  <ProviderGrid />

  <ContentBox as="h2" title="BETFLIX6789 รวมโปรโมชั่นยอดฮิต สมาชิกกดรับบ่อย">
    <p class="text-left text-base leading-relaxed text-[#f4e3c8]">
      BETFLIX6789 มีโปรโมชั่นที่อัปเดตอย่างต่อเนื่อง เพื่อเพิ่มความคุ้มค่าในการใช้งาน สมาชิกสามารถตรวจสอบรายละเอียดและเงื่อนไขของแต่ละรายการได้ผ่านหน้าเว็บไซต์
      และเลือกรับสิทธิ์ตามโปรโมชั่นที่เปิดให้บริการ
    </p>
    <FeatureHighlights items={promoItems} />
  </ContentBox>

  <ContentBoxSevenThree titleright="คาสิโน BETFLIX6789 จัดโปรหนัก อัปเกมใหม่แตกแรง">
    <Picture
      slot="left"
      src={imgPromo}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์ BETFLIX6789 คืนยอดเสียทุกวัน รับโบนัส 0.3% พื้นหลังโทนขาวทอง มีวงล้อรูเล็ต ไพ่เอซ และชิปคาสิโนสีแดงทอง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#c8102e]/25 shadow-[0_10px_30px_rgba(200,16,46,0.18)]"
    />
    <div slot="right">
      <p class="text-left text-base leading-relaxed text-[#f4e3c8]">
        ภายในระบบมีการอัปเดตเกมใหม่จากผู้พัฒนาเกมชั้นนำอย่างต่อเนื่อง ทั้งเกมสล็อต คาสิโนสด และเกมเดิมพันยอดนิยม เพื่อให้สมาชิกมีตัวเลือกที่หลากหลาย
        พร้อมติดตามกิจกรรมและโปรโมชั่นใหม่ ๆ ที่จัดขึ้นเป็นประจำผ่านหน้าเว็บไซต์
      </p>
    </div>
  </ContentBoxSevenThree>

  <ContentBoxSpecial as="h2" title="BETFLIX6789 การันตีแจกโบนัสฝากถอนสูงกว่าทุกเจ้า">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f4e3c8]">
      ระบบฝากถอนอัตโนมัติของ BETFLIX6789 เปิดให้บริการตลอด 24 ชั่วโมง รองรับทั้งบัญชีธนาคารและวอลเลท สมาชิกสามารถฝากเครดิต ถอนเงิน และตรวจสอบสถานะรายการได้ด้วยตนเองผ่านระบบ
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#f4e3c8]">
      หากพบปัญหาเกี่ยวกับการสมัครสมาชิก การเข้าสู่ระบบ การฝากถอน หรือการใช้งานเว็บไซต์ สามารถติดต่อทีมงานได้ตลอด 24 ชั่วโมง เพื่อรับคำแนะนำและความช่วยเหลืออย่างรวดเร็ว
    </p>
  </ContentBoxSpecial>

  <LatestWinnersCyber />

  <ContentBoxNeumorphism>
    <p class="text-left text-lg font-black text-[#f6d78a]">เริ่มต้นใช้งานได้ง่ายเพียง 3 ขั้นตอน</p>
    <FeatureHighlights items={onboardingSteps} />
  </ContentBoxNeumorphism>

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#f6d78a] to-[#c8102e] px-4 py-3 text-sm font-black whitespace-nowrap text-white shadow-[0_10px_30px_rgba(200,16,46,0.26)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(200,16,46,0.4)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>

    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#8a1420]/70 bg-[#150806]/85 px-4 py-3 text-sm font-black whitespace-nowrap text-[#e3cdb0] backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:border-[#c8102e] hover:bg-[#220a0a]/85 hover:shadow-[0_15px_40px_rgba(201,168,105,0.35)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>
  </div>

  <Faq title="คำถามที่พบบ่อยเกี่ยวกับ BETFLIX6789" faqs={faqs} />

  <ReviewCardSumo2 />

  <Navfoot />
</MainLayout>
