---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxTwoFloatingBadge from "../components/ContentBoxTwoFloatingBadge.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ProviderGridPremium from "../components/ProviderGridPremium.astro";
import Faq from "../components/Faq4.astro";
import LatestWinners from "../components/LatestWinnersCyber.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// Title and description are the brief's own Title/Description lines, verbatim.
// A brief-supplied description ships at whatever length it was written — it is
// not padded up to the 150-character floor.
const pageTitle = "AKA99 สล็อตเว็บตรงค่ายใหญ่ เซิร์ฟนอก การันตีเจ้าเจ้าของแท้ ปลอดภัยแน่นอน";

const pageDescription = "AKA99 สล็อตเว็บตรงค่ายใหญ่ เปิดให้คุณเดิมพันได้อย่างปลอดภัย ด้วยเซิร์ฟนอก การันตีความสนุกด้วยเจ้าของแท้ PGSOFT แตกง่าย จ่ายไว สนุกได้ทุกการเดิมพัน";

// The ticker copy is passed explicitly rather than relying on the component's
// default — every Announcement* variant's default belongs to whichever brand
// wired it in last. No emoji in this string: an emoji baked into a text prop
// cannot be given its own aria-hidden span.
const announcement =
  "AKA99 สล็อตเว็บตรงค่ายใหญ่ เซิร์ฟนอก เจ้าของแท้ ไม่ผ่านเอเยนต์ • รวมเกมสล็อต PGSOFT ทั้งเกมยอดนิยม เกมใหม่ เกมโบนัส และสล็อตแจ็คพอตไว้ในระบบเดียว • โบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไขที่กำหนด • ฝากถอนผ่านระบบอัตโนมัติ ทำรายการเองได้ตลอด 24 ชั่วโมง • แอดมิน AKA99 พร้อมให้คำแนะนำและอัปเดตข่าวสารทาง LINE Official";

// The brief's three registration steps. They are list items in the docx, not
// headings, so they render as an <ol> — turning them into cards with their own
// titles would add an h3 tier the brief does not have.
const steps = [
  "สมัครสมาชิกผ่านหน้าเว็บไซต์และกรอกข้อมูลตามที่ระบบกำหนด",
  "Login เข้าสู่บัญชีและทำรายการฝากเครดิตผ่านระบบอัตโนมัติ",
  "ตรวจสอบโปรโมชั่น เลือกเกมสล็อตที่ต้องการ และศึกษารายละเอียดก่อนเริ่มเดิมพัน",
];

// One array, used by both <Faq> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last.
const faqs = [
  {
    q: "AKA99 มีเกมสล็อต PGSOFT ให้เลือกหรือไม่?",
    a: "มีเกมสล็อต PGSOFT ให้เลือกหลายรูปแบบ โดยสมาชิกสามารถตรวจสอบรายชื่อเกมที่เปิดให้บริการ เกมใหม่ และรายละเอียดของแต่ละเกมผ่านหน้าเว็บไซต์ก่อนเข้าเล่นได้",
  },
  {
    q: "โปรโมชั่น AKA99 0.8% และ 0.3% แตกต่างกันอย่างไร?",
    a: "โบนัส 0.8% เป็นโปรโมชั่นแนะนำเพื่อนสำหรับรายการที่เข้าเงื่อนไข ส่วนโบนัส 0.3% เป็นโปรโมชั่นคืนยอดเสียตามรอบที่กำหนด สมาชิกควรตรวจสอบรายละเอียดของแต่ละโปรโมชั่นก่อนกดรับสิทธิ์ทุกครั้ง",
  },
  {
    q: "หากสมัคร ฝากถอน หรือรับโบนัสไม่ได้ต้องทำอย่างไร?",
    a: "สามารถติดต่อแอดมิน AKA99 ผ่าน LINE Official พร้อมแจ้งรายละเอียดของปัญหาและข้อมูลรายการที่เกี่ยวข้อง เพื่อให้ทีมงานช่วยตรวจสอบและแนะนำขั้นตอนดำเนินการต่อได้",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <SmoothCarousel />

  <ContentBoxNeumorphism as="h1" title="AKA99 เว็บตรงค่ายใหญ่ เซิร์ฟนอก เล่นได้อย่างปลอดภัย ไม่โดนแบน">
    <p class="text-left text-base leading-relaxed text-[#cfdcea]">
      <strong class="text-[#eaf3fd]">AKA99</strong> พร้อมให้บริการสมาชิกที่ต้องการเล่นสล็อตออนไลน์ผ่านระบบที่รองรับทั้งมือถือและคอมพิวเตอร์ มีเกมสล็อตจาก PGSOFT และเกมยอดนิยมให้เลือก พร้อมโปรโมชั่นสำหรับสมาชิกทั้งโบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%
      ตามเงื่อนไข ระบบออกแบบให้เข้าใช้งานง่าย ฝากถอนสะดวก และมีแอดมินคอยให้คำแนะนำพร้อมอัปเดตข่าวสารตลอด 24 ชั่วโมง
    </p>
  </ContentBoxNeumorphism>

  <ContentBoxTwoFloatingBadge as="h2" title="AKA99 สล็อตเว็บตรงค่ายใหญ่ PGSOFT เกมครบ แตกไว จ่ายง่าย คอนเฟิร์ม">
    <p slot="left" class="text-left text-base leading-relaxed text-[#cfdcea]">
      AKA99 รวบรวมเกมสล็อต PGSOFT หลากหลายรูปแบบไว้ให้เลือกภายในระบบเดียว มีทั้งเกมยอดนิยม เกมใหม่ เกมโบนัส และสล็อตแจ็คพอต พร้อมรองรับการเล่นผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ สมาชิกสามารถค้นหาเกมและตรวจสอบรายละเอียดก่อนเข้าเล่นได้อย่างสะดวก
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#cfdcea]">
      เกมสล็อตแต่ละเกมมีรูปแบบ อัตราเดิมพัน ฟีเจอร์ และเงื่อนไขแตกต่างกัน ก่อนเริ่มเดิมพันจึงควรศึกษากติกาของเกมและกำหนดงบประมาณให้เหมาะสม โดยผลของเกมสล็อตไม่สามารถรับประกันกำไรหรือการถูกรางวัลได้
    </p>
  </ContentBoxTwoFloatingBadge>

  <ProviderGridPremium />

  <ContentBoxCyberCut as="h2" title="ทดลองเล่น AKA99 พร้อมรับโปรโมชั่นพิเศษได้ทันที">
    <p class="text-left text-base leading-relaxed text-[#cfdcea]">
      สมาชิกสามารถตรวจสอบเกมและโปรโมชั่น AKA99 ที่เปิดให้บริการผ่านหน้าเว็บไซต์ โดยมีสิทธิพิเศษสำหรับสมาชิกทั้งกิจกรรมแนะนำเพื่อนและโปรโมชั่นคืนยอดเสีย แต่ละรายการจะแสดงรายละเอียดเกี่ยวกับเปอร์เซ็นต์ วิธีคำนวณ รอบการรับ และเงื่อนไขที่เกี่ยวข้องให้ตรวจสอบก่อนกดรับสิทธิ์
    </p>
  </ContentBoxCyberCut>

  <ContentBoxSevenThreeCyberCut as="h3" titleright="โปรค่าแนะนำเพื่อน 0.8%">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600, 800]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นพื้นน้ำเงินเข้มลายเรขาคณิต ด้านบนซ้ายเป็นโลโก้ AKA99 ถัดลงมาเป็นคำว่า โปรโมชั่น ตัวใหญ่ และป้าย แนะนำเพื่อน รับโบนัส 0.8% ด้านขวาเป็นหญิงสาวชุดรัดรูปสีเงินเมทัลลิกมีโลโก้ AKA99 ที่หน้าอก แบฝ่ามือไปทางข้อความ"
      class="mx-auto h-auto w-full rounded-2xl border border-[#0b6cf0]/45 shadow-[0_10px_30px_rgba(11,108,240,0.24)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#cfdcea]">
      สมาชิกสามารถนำลิงก์แนะนำส่วนตัวไปแชร์ให้เพื่อน เมื่อเพื่อนสมัครและมียอดการใช้งานตรงตามข้อกำหนด ระบบจะคำนวณโบนัสแนะนำเพื่อน 0.8% ตามเงื่อนไข สมาชิกสามารถตรวจสอบยอดแนะนำและโบนัสที่ได้รับผ่านบัญชีของตนเองได้
    </p>
  </ContentBoxSevenThreeCyberCut>

  <ContentBoxSevenThreeNeumorphism as="h3" titleright="โปรคืนยอดเสีย 0.3%">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600, 800]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นพื้นน้ำเงินเข้มลายเทคโนโลยี ด้านบนซ้ายเป็นโลโก้ AKA99 ถัดลงมาเป็นป้าย โปรโมชั่น คำว่า คืนยอดเสีย และ รับโบนัส 0.3% ตัวใหญ่ ด้านขวาเป็นหญิงสาวชุดครอปสีเงินเมทัลลิกชี้นิ้วไปทางข้อความ แถวล่างมีไอคอนสามช่อง คืนยอดเสียทุกวันไม่ต้องทำเทิร์น รับโบนัสไวภายใน 24 ชม. และสิทธิพิเศษสำหรับสมาชิกทุกระดับ"
      class="mx-auto h-auto w-full rounded-2xl border border-[#c3ced9]/45 shadow-[0_10px_30px_rgba(195,206,217,0.24)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#cfdcea]">
      สมาชิกที่มียอดเสียตรงตามเงื่อนไขสามารถตรวจสอบสิทธิ์รับโบนัสคืนยอดเสีย 0.3% ตามรอบที่กำหนด โดยควรตรวจสอบยอดที่นำมาคำนวณ ประเภทเกมที่เข้าร่วม และข้อกำหนดในการรับหรือถอนโบนัสก่อนกดรับทุกครั้ง
    </p>
  </ContentBoxSevenThreeNeumorphism>

  <ContentBoxTwoNeumorphism as="h2" title="สมัคร AKA99 เองได้ง่าย ไม่ยุ่งยาก แค่ 3 ขั้นตอน เลือกเกมเดิมพันได้เลย">
    <p class="text-left text-base leading-relaxed text-[#cfdcea]">เริ่มต้นสมัคร AKA99 ผ่านมือถือหรือคอมพิวเตอร์ได้ง่ายเพียง 3 ขั้นตอน</p>

    <ol slot="left" class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#cfdcea]">
      {
        steps.map((step, i) => (
          <li class="flex items-start gap-3 rounded-2xl border border-[#1e4b9e]/60 bg-[#03081c]/70 p-4">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-[#4aa3ff] via-[#0b6cf0] to-[#0a2a6b] text-sm font-black text-[#02060f]">{i + 1}</span>
            <span>{step}</span>
          </li>
        ))
      }
    </ol>

    <p slot="right" class="text-left text-base leading-relaxed text-[#cfdcea]">
      หลังสมัครเรียบร้อย สมาชิกสามารถจัดการบัญชี ตรวจสอบเครดิต ฝากถอน และเลือกเกมสล็อตผ่านระบบเดียวได้ตลอด 24 ชั่วโมง
    </p>
  </ContentBoxTwoNeumorphism>

  <LoginRtpSection />

  <ContentBoxFloatingBadge as="h2" title="รับคำแนะนำ AKA99 พร้อมอัปเดตข่าวสารและโปรโมชั่นใหม่ ๆ จากแอดมินทาง LINE Official">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#cfdcea]">
        หากต้องการสอบถามเกี่ยวกับการสมัครสมาชิก การ Login การฝากถอน โปรโมชั่น หรือเกมสล็อตที่เปิดให้บริการ สามารถติดต่อแอดมิน AKA99 ผ่านช่องทาง LINE Official ของเว็บไซต์ได้ ทีมงานพร้อมให้คำแนะนำเกี่ยวกับขั้นตอนการใช้งาน รวมถึงแจ้งข่าวสาร เกมใหม่
        และโปรโมชั่นล่าสุดให้สมาชิกติดตามได้อย่างต่อเนื่อง
      </p>
      <p class="text-left text-base leading-relaxed text-[#cfdcea]">
        หากพบปัญหาเครดิตไม่เข้า ถอนเงินล่าช้า หรือโบนัสไม่แสดง ควรแจ้งรายละเอียดและเวลาที่ทำรายการให้เจ้าหน้าที่ เพื่อช่วยให้ตรวจสอบปัญหาได้รวดเร็วยิ่งขึ้น
      </p>
    </div>
  </ContentBoxFloatingBadge>

  <Faq title="คำถามที่พบบ่อยเกี่ยวกับ AKA99" faqs={faqs} />

  <LatestWinners />

  <ReviewCardSumo2 />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#4aa3ff] via-[#0b6cf0] to-[#0a2a6b] px-4 py-3 text-sm font-black whitespace-nowrap text-[#02060f] shadow-[0_10px_30px_rgba(11,108,240,0.28)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(11,108,240,0.42)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#c3ced9]/50 bg-gradient-to-r from-[#0a1b3e] to-[#03081c] px-4 py-3 text-sm font-black whitespace-nowrap text-[#eaf3fd] shadow-[0_10px_30px_rgba(11,108,240,0.16)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#c3ced9]/80 hover:text-[#e8f2fd] hover:shadow-[0_15px_40px_rgba(195,206,217,0.3)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>
  </div>

  <Navfoot />
</MainLayout>
