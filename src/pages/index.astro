---
import MainLayout from "../layouts/MainLayout.astro";
import AnnouncementPremium from "../components/AnnouncementPremium.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBox from "../components/ContentBox.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import LatestWinnersPremium from "../components/LatestWinnersPremium.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import Faq4 from "../components/Faq4.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide2 from "../assets/slide2.png";

const pageTitle = "SUPERWIN9 คาสิโนเกมนักล่า รับโบนัสแนะนำ0.8% เข้ากระเป๋าออนไลน์ทันที เพียงแค่แชร์ รับได้เลย";

const pageDescription =
  "SUPERWIN9 คาสิโนเกมนักล่า เปิดให้เข้าร่วมเล่นคาสิโนสด บาคาร่า รูเล็ต และสล็อตทุกค่าย พร้อมรับโบนัสทุกวัน 0.8% เข้ากระเป๋าเงินออนไลน์ กดรับทันที ถอนไม่จำกัด";

const faqs = [
  {
    q: "โบนัสแนะนำเพื่อน SUPERWIN9 0.8% รับอย่างไร?",
    a: "สมาชิกสามารถเข้าสู่ระบบและนำลิงก์แนะนำของตนเองไปแชร์ให้เพื่อน เมื่อเพื่อนสมัครและมียอดที่เข้าเงื่อนไข ระบบจะคำนวณโบนัสแนะนำ 0.8% ตามข้อกำหนดของโปรโมชั่น ควรตรวจสอบรายละเอียดล่าสุดก่อนกดรับทุกครั้ง",
  },
  {
    q: "SUPERWIN9 รองรับการฝากถอนผ่านธนาคารอะไรบ้าง?",
    a: "ระบบรองรับธนาคารและช่องทางการทำธุรกรรมตามรายการที่แสดงอยู่ในหน้าฝากถอนของเว็บไซต์ สมาชิกควรตรวจสอบช่องทางที่เปิดให้บริการ ณ เวลาทำรายการ รวมถึงชื่อบัญชีและรายละเอียดให้ถูกต้องก่อนยืนยัน",
  },
  {
    q: "หากโบนัสไม่เข้าหรือถอนเงินไม่ได้ต้องทำอย่างไร?",
    a: "ให้ตรวจสอบสถานะรายการและเงื่อนไขของโปรโมชั่นก่อน หากยังพบปัญหา สามารถติดต่อแอดมิน SUPERWIN9 พร้อมแจ้งรายละเอียดบัญชีและรายการที่เกี่ยวข้อง เพื่อให้ทีมงานตรวจสอบและแนะนำขั้นตอนดำเนินการต่อได้ตลอด 24 ชั่วโมง",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <AnnouncementPremium
    message="SUPERWIN9 คาสิโนเกมนักล่า รวมคาสิโนสด บาคาร่า รูเล็ต เสือมังกร และสล็อตจากหลายค่ายไว้ในบัญชีเดียว • โบนัสแนะนำเพื่อน 0.8% ตามเงื่อนไขของกิจกรรม เพียงแชร์ลิงก์แนะนำของตนเองให้เพื่อน • ฝากถอนรองรับช่องทางธนาคารที่เว็บไซต์เปิดให้บริการ ตรวจสอบสถานะรายการได้ด้วยตนเอง • แอดมิน SUPERWIN9 พร้อมให้คำแนะนำตลอด 24 ชั่วโมง"
  />

  <SmoothCarousel />

  <ContentBoxPremium as="h1" title="SUPERWIN9 คาสิโนเกมนักล่า เข้าร่วมสมาชิก รับโบนัสเพียบ">
    <p class="text-left text-base leading-relaxed text-[#efe3d2]">
      <strong class="text-[#ebbb4a]">SUPERWIN9</strong> พร้อมให้บริการสมาชิกที่ต้องการเล่นเกมคาสิโนออนไลน์ผ่านมือถือและคอมพิวเตอร์ มีเกมหลากหลายหมวดหมู่ให้เลือก พร้อมโปรโมชั่นสำหรับสมาชิก
      โดยเฉพาะโบนัสแนะนำเพื่อน 0.8% ตามเงื่อนไขที่กำหนด ระบบรองรับการฝากถอนผ่านช่องทางที่เปิดให้บริการ และมีแอดมินคอยช่วยเหลือตลอด 24 ชั่วโมง ตั้งแต่ขั้นตอนสมัครสมาชิกไปจนถึงการใช้งานภายในระบบ
    </p>
  </ContentBoxPremium>

  <ContentBox as="h2" title="SUPERWIN9 แหล่งรวมเกมคาสิโน โบนัสหนัก ทุกค่าย">
    <p class="text-left text-base leading-relaxed text-[#efe3d2]">
      สมาชิกสามารถเลือกเล่นเกมคาสิโนออนไลน์ได้หลากหลายประเภทภายในบัญชีเดียว ทั้งคาสิโนสด บาคาร่า รูเล็ต เสือมังกร สล็อต และเกมเดิมพันยอดนิยมจากหลายค่าย พร้อมอัปเดตเกมใหม่อย่างต่อเนื่อง
      ระบบรองรับการใช้งานผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ ช่วยให้ค้นหาเกมที่สนใจและสลับเข้าเล่นแต่ละหมวดหมู่ได้สะดวก
    </p>
  </ContentBox>

  <ProviderGrid />

  <ContentBoxSevenThreeNeumorphism title="สิทธิพิเศษสำหรับสมาชิก SUPERWIN9 รับโบนัสแนะนำ 0.8%">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่น SUPERWIN9 พื้นหลังดำแดงประกายทอง โลโก้ SUPERWIN9 ตัวอักษรแดงทองสามมิติ ข้อความ โปรโมชั่น แนะนำเพื่อน รับโบนัส พร้อมตัวเลข 0.8% ขนาดใหญ่สีทอง หญิงสาวผมยาวสวมชุดราตรีแดงดำยืนชี้นิ้ว ข้างกายมีวงล้อรูเล็ต ไพ่เอซสามใบ ชิปคาสิโน กองเหรียญทอง และกล่องของขวัญสีดำคาดโบว์ทอง แถบล่างเขียนว่า แนะนำเพื่อนง่ายๆ เพียงแค่แชร์ลิงก์ให้เพื่อน และเพื่อนเล่นคุณรับโบนัสทันที"
      class="mx-auto h-auto w-full rounded-2xl border border-[#ebbb4a]/45 shadow-[0_10px_30px_rgba(200,17,24,0.22)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#efe3d2]">
      สมาชิก SUPERWIN9 สามารถเข้าร่วมโปรโมชั่นแนะนำเพื่อนเพื่อรับโบนัส 0.8% ตามเงื่อนไขของกิจกรรม เพียงเข้าสู่บัญชีสมาชิก คัดลอกลิงก์แนะนำของตนเองและแชร์ให้เพื่อน เมื่อรายการเป็นไปตามข้อกำหนด
      ระบบจะแสดงโบนัสที่สามารถรับได้ สมาชิกควรตรวจสอบยอดคำนวณ รอบการรับ และเงื่อนไขการถอนก่อนกดรับสิทธิ์ทุกครั้ง
    </p>
  </ContentBoxSevenThreeNeumorphism>

  <LatestWinnersPremium />

  <ContentBoxFloatingBadge as="h2" title="SUPERWIN9 ฝากและถอนได้ทุกช่องทาง รองรับทุกธนาคาร">
    <p class="text-left text-base leading-relaxed text-[#efe3d2]">
      ระบบฝากถอนของ SUPERWIN9 รองรับช่องทางธนาคารและวิธีการชำระเงินที่เว็บไซต์เปิดให้บริการ สมาชิกสามารถฝากเครดิต ตรวจสอบยอด ส่งคำขอถอน และติดตามสถานะรายการผ่านบัญชีของตนเองได้โดยตรง
      ช่วยลดขั้นตอนในการทำธุรกรรม หากรายการล่าช้าหรือเครดิตไม่เข้า สามารถแจ้งทีมงานพร้อมรายละเอียดรายการเพื่อให้ช่วยตรวจสอบได้ทันที
    </p>
  </ContentBoxFloatingBadge>

  <LoginRtpSection />

  <ContentBoxCyberCut as="h2" title="ปรึกษาแอดมิน SUPERWIN9 ได้ทันที ไม่ต้องรอคิว">
    <div>
      <p class="text-left text-base leading-relaxed text-[#efe3d2]">
        หากพบปัญหาเกี่ยวกับการสมัครสมาชิก การ Login การฝากถอน การรับโบนัสแนะนำเพื่อน หรือการเข้าเล่นเกมคาสิโน สามารถติดต่อแอดมิน SUPERWIN9 ได้ตลอด 24 ชั่วโมง
        ทีมงานพร้อมให้คำแนะนำตามขั้นตอนและช่วยตรวจสอบรายการ เพื่อให้สมาชิกแก้ไขปัญหาและกลับมาใช้งานได้อย่างต่อเนื่อง
      </p>
      <a
        href="/line"
        class="mt-6 inline-flex items-center justify-center gap-2 rounded-full bg-gradient-to-r from-[#00B900] to-[#009900] px-7 py-3 text-sm font-black text-white shadow-[0_10px_30px_rgba(0,185,0,0.24)] transition-transform duration-300 hover:-translate-y-0.5 hover:scale-105">
        <span aria-hidden="true">💬</span> ติดต่อแอดมิน SUPERWIN9 ผ่าน LINE
      </a>
    </div>
  </ContentBoxCyberCut>

  <Faq4 title="คำถามที่พบบ่อยเกี่ยวกับ SUPERWIN9" faqs={faqs} />

  <ReviewCardSumo2 />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#f5333c] via-[#c81118] to-[#7a0d10] px-4 py-3 text-sm font-black whitespace-nowrap text-[#2a0a02] shadow-[0_10px_30px_rgba(200,17,24,0.28)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(200,17,24,0.42)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#ebbb4a]/50 bg-gradient-to-r from-[#240607] to-[#170405] px-4 py-3 text-sm font-black whitespace-nowrap text-[#ebbb4a] shadow-[0_10px_30px_rgba(235,187,74,0.16)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#fbe289]/70 hover:text-[#fbe289] hover:shadow-[0_15px_40px_rgba(235,187,74,0.28)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>
  </div>

  <Navfoot />
</MainLayout>
