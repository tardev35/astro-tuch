---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement2.astro";
import LatestWinners from "../components/LatestWinners4.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxTwoFloatingBadge from "../components/ContentBoxTwoFloatingBadge.astro";
import Faq from "../components/Faq3.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import { pageGraph } from "../lib/schema";
import imgCashback from "../assets/slide2.png";
import imgReferral from "../assets/slide1.png";

// VARIANT ROTATION THIS ROUND, per brand-spec §3. Every family moves off the
// outgoing brand's pick: Announcement2 replaces Announcement4, LatestWinners4
// replaces LatestWinners3, Faq3 replaces Faq2, the base ReviewCardSumo replaces
// ReviewCardSumo2, and the ContentBox shape-mix leaves FloatingBadge /
// TwoCyberCut / SevenThreeNeumorphism / SevenThree / Premium /
// FeatureHighlights / TwoNeumorphism for CyberCut / TwoPremium /
// SevenThreePremium / SevenThreeCyberCut / Special / TwoFloatingBadge.
// NavbarStyle6 and FooterStyle3 are the layout's pair this round (previously
// NavbarStyle11 and the base Footer) and the brand font moves google-sans ->
// kanit; all three are the orchestrator's shared-chrome step, not this page's.
// Plain ContentBox is the one deliberate carry-over: it is the always-live box
// that terms, privacy, 404 and the button pages render through, so it cannot
// follow a rotation. Section 3 is the single docx section it carries here.
// ContentBoxTwo is also still live but is NOT imported here — it is reached only
// through LoginRtpSection, so an "is it used?" grep has to match the bare
// filename, not "components/ContentBoxTwo.astro".
// Every unused *Premium / *Cyber / *Huay / *Neumorphism / Style file, the other
// Faq* and Announcement* siblings, ReviewCardSumo2 and the other LatestWinners*
// stay on disk as inventory for the next brand — none was deleted, and the
// previous brand's hot pink and gold still inside them are expected drift, not
// a bug.
//
// <Announcement /> runs bare on purpose: Announcement2's default message is
// already this brand's copy, set by the orchestrator from this brief, and every
// sub-page calls it bare too — so passing an override here is exactly how the
// ticker ends up saying two different things on two pages of the same site.
//
// PALETTE OF THIS BRAND (brand-spec §2). This is a genuine TWO-COLOUR pair read
// straight off the artwork: CHAMPION GOLD #e5a81b LEADS (the trophy, the gold
// football, the UFA lettering, the stadium spotlights, the coins) and CHROME
// SILVER #b9c2cc is the second hue (the 324 numerals on the logo, both
// characters' silver-white hair) over a page background that is PURE BLACK
// (bg.json = {"mode":"color","color":"#000000"}).
// ⚠️ CONSEQUENCE: unlike last round's plum-black #2e002c page, NOTHING can sink
// below the page this round. Every surface must be LIGHTER than #000000:
// #231c0e raised / #17130a mid / #0d0b06 sunken, and that is the floor.
// ⚠️ TWO TRAPS. Seven of the last ten brands had gold, so "there is already gold
// here" proves nothing — the outgoing brand's #f5c53d, #f5c518, #fbc134,
// #f3bb34 and #f2b705 each differ from our #e5a81b by only a few characters, and
// one older brand was ALSO a gold-and-chrome pair whose silver was #cfd6e3, not
// our #b9c2cc. Compare by value, never by family. The outgoing brand's own set
// (#ff3fa4 #ff6cbb #ffd1ea #e8b9d4 #fde8f3 #f5c53d #9c6f08 #b3006a #7a0046
// #4d002b #2b0019 #4a0b42 #3a0534 #2e002c #210220) is gone from every rendered
// file. THERE IS NO PINK, NO ORANGE, NO RED, NO GREEN AND NO PURPLE HUE AT ALL
// this round.
// Body copy is #f0e8d4 (= BRAND_TEXT), 13.9:1 on the raised surface and 17.2:1
// on pure black.
// Highlights below are #ffcf5e, which §2 pins to exactly this one job (11.6:1 on
// the raised surface) — unlike #e5a81b which is the border/accent/heading gold,
// unlike #ffe08a which is the gradient bright end and the hover colour, and
// unlike #b9c2cc / #8792a0 which are the chrome accent and the muted secondary
// text. #7d5a07, #43300a and #464f5a never carry text at any size; #140d01 is
// the only ink allowed on a gold fill and #0b0f14 the only ink on a silver one.
//
// IMAGE ROLES FOR THIS DROP (2026-10-11, brand-spec §4). Two files are
// referenced from this page and only two, and each pairing is read off the
// artwork itself — the percentage printed ON the slide has to match the heading
// the block carries, or the picture contradicts the section above it. NOTE the
// pairing is the OPPOSITE WAY ROUND from last round's drop, so the import names
// cannot be trusted from memory:
//   slide2.png — square 600x600 gold-and-black scene. A young man with
//     silver-white hair in a black-and-gold football shirt points out at the
//     viewer; a young woman with silver-white hair in black-and-gold sportswear
//     holds a gold football. Both stand on a gold ring-shaped stage. Along the
//     top is the champion-trophy logo with the gold UFA lettering and the chrome
//     324 numerals. Across the middle โปรโมชั่น in large 3-D gold type and under
//     it คืนยอดเสีย 0.3%. The artwork prints the offer itself, so it belongs to
//     docx H3 #4. Imported as imgCashback.
//   slide1.png — the companion square. The same pair, both smiling and reaching
//     a hand out, their black-and-gold kit screen-printed with the brand name,
//     gold footballs in the two lower corners, the same trophy logo along the
//     top. Across the middle a gold crown above โปรโมชั่น in the same 3-D gold
//     type and, on a dark gold-edged plate below it, แนะนำเพื่อน and
//     โบนัส 0.8%. It belongs to docx H3 #5. Imported as imgReferral.
// Both slides are 600x600 on disk, so 600 is the top real candidate — nothing
// above it would be a real pixel — and each picture carries max-w-[600px] so the
// art is never upscaled past its own bitmap.
// Each slide sits in a ContentBoxSevenThree* image+text block, which is that
// family's hard cap of two per rebrand, so there is no third SevenThree anywhere
// on the site and no slide appears outside those two blocks.
// Both blocks lay out md:grid-cols-[7fr_3fr] with the TEXT column first, so each
// picture goes in slot="right" and the heading always lands on the prose, never
// on the picture — and on a phone the single column reads heading, text, picture
// rather than opening with an image. Each `sizes` therefore describes its own
// 3fr column rather than the viewport. The two figures below were RECOMPUTED
// from the two variants this brand picked — they are NOT the numbers last round
// used, because SevenThreeNeumorphism/SevenThree capped at max-w-[1400px] while
// both of ours cap at max-w-7xl (1280) and pay different padding:
//   ContentBoxSevenThreePremium (section 4): section max-w-7xl(1280) + px-4(32),
//     card border(2) + md:p-10(80) + gap-10(40), image column md:border-l(1) +
//     md:pl-10(40) = 41
//       >= 1280px : (1280 - 32 - 2 - 80 - 40) x 0.3 - 41 = 337.8 - 41 = 297px
//       md..1279  : (100vw - 154) x 0.3 - 41             = calc(30vw - 87px)
//       698..767  : one column at p-8 exceeds 600, so max-w-[600px] binds = 600px
//       < 698     : one column at p-8 (no md:p-10)       = calc(100vw - 98px)
//   ContentBoxSevenThreeCyberCut (section 5): same section cap, but a flat
//     p-8(64) and gap-8(32), image column md:border-l(1) + md:pl-8(32) = 33
//       >= 1280px : (1280 - 32 - 2 - 64 - 32) x 0.3 - 33 = 345 - 33 = 312px
//       md..1279  : (100vw - 130) x 0.3 - 33             = calc(30vw - 72px)
//       698..767  : capped by max-w-[600px]              = 600px
//       < 698     : one column at p-8                    = calc(100vw - 98px)
// Neither is the LCP element — MainLayout's hero banner is — so both are
// loading="lazy" fetchpriority="low" decoding="async" and neither takes
// fetchpriority="high". formats/fallbackFormat/quality are left at the house
// values: tools/avif-quality-service.mjs rescales AVIF quality on its own, so
// quality={80} must not be hand-tuned per format.
//
// The alt text was written from THIS drop's artwork, read off the files rather
// than carried over: the set is a gold-and-black SPORTS scene — a champion
// trophy, gold footballs, gold coins, a night stadium under gold spotlights, and
// two silver-white-haired characters in black-and-gold kit. It is NOT the
// outgoing brand's hot-pink bunny-girl scene with pink rabbit ears, glowing
// hearts, playing-card aces, crowned pink chips or gold 777 cabinets, not an
// earlier brand's black-and-gold SPACE scene with a crowned duck mascot and
// planets, and not the astronaut-helmet medallion before that. There is no
// bunny, no heart, no duck, no planet and no slot cabinet on either file.
//
// Deliberately NOT imported, and every file still on disk:
//   banner2.png (10-08) is the previous brand's artwork, banner3.png (09-27) is
//   older still, and slide3.png / slide4.png (09-29) are a lottery brand's
//   posters — all previous brands' artwork. Importing any of them emits a
//   competitor's picture into dist/ (an eager import IS an emit, rendered or
//   not) and turns verify-build red. There is therefore NO current-drop article
//   illustration this round, and a slide is not substituted for one.
//   banner1.png and banner1-mobile.png belong to MainLayout's own pinned globs
//   and are never referenced from a page. og.png is the same: MainLayout owns it.
// Also deliberately unused (named without the file extension on purpose — the
// playbook's "is this component live?" check is a bare-filename grep, and a
// mention here would read as a render): ProviderGrid, GameRankingBoard and
// SmoothCarousel have no brief section asking for a provider wall, a ranking
// board or a carousel this round (the brief names no studio, no league and no
// team, so a provider wall would have to invent one); BankStrip already renders
// inside the active footer; FeatureHighlights has nothing to carry because no
// section in this brief has a short labelled sub-list as its body (unlike last
// round's "สมัคร 3 ขั้นตอน"); and the three-column ContentBox3Three family has
// nothing to carry either — every section here is one or two running paragraphs,
// not a three-way split.
//
// Vocabulary (brand-spec §7): this brand is a เว็บเล่นเกมกีฬาออนไลน์ — ฟุตบอล +
// มวย + เกมคาสิโน (เกมไพ่, เกมโต๊ะ, สล็อต). It is NOT a slot-only site and NOT a
// lottery site. The words this page may use are the brief's own:
// เว็บเล่นเกมกีฬาออนไลน์, ทางเข้าเดิมพัน, ฐานเกมแท้, จ่ายตรง, ไม่บิทยูส /
// ไม่บิดยูส, ไม่มีขั้นต่ำ, ไม่ผ่าน บช. ม้า / บัญชีม้า, ฟุตบอล, มวย, เกมคาสิโน,
// เกมไพ่, เกมโต๊ะ, สล็อต, ค่ายต่างๆ, คู่แข่งขัน, ประเภทการเดิมพัน, อัตราต่อรอง,
// กติกา, อัตราจ่าย, เงื่อนไขการตัดสินผล, หมายเลขรายการ, เว็บตรงในตำนาน,
// คืนยอดเสีย 0.3%, เข้ายูสทุกวัน, รอบคำนวณ, เวลาตัดรอบ, ยอดที่เข้าเกณฑ์,
// แนะนำเพื่อน, โบนัส 0.8%, ไม่จำกัด, ลิงก์แนะนำ, ฝากถอน, ช่องทางชำระเงิน,
// สถานะรายการ, ชื่อบัญชีผู้รับเงิน, ระยะเวลาดำเนินการ, แอดมิน 24 ชั่วโมง,
// ช่องทางติดต่อหลัก, PIN, OTP.
// ⚠️ "ไม่มีขั้นต่ำ", "ไม่ผ่าน บช. ม้า" and "เว็บตรงในตำนาน" all sat on an older
// brand's ban list and all three ship verbatim here — the ban covers invented
// copy, not a line the brief supplies (content.txt lines 2, 8, 14, 16). The
// brief hedges each of them in the very same paragraph, and that hedge ships
// with it rather than being trimmed as downbeat filler.
// The outgoing brand's vocabulary is banned and gone (ฟาสล็อตเว็บตรง,
// เล่นสล็อตระบบแท้, Login ใช้งานง่าย, สมัคร 3 ขั้นตอน, แตกง่ายทุกเกม,
// ผลการหมุนเป็นแบบสุ่ม, สล็อตคลาสสิก, ฟรีสปิน, โบนัสตัวคูณ), as is every older
// brand's (เว็บสล็อตนาซ่า, สล็อตพีจีเว็บเป็ด, เว็บเป็ด, คลับคนเล่นสล็อตซุปเปอร์,
// ส่งตรงจากเมกา, ส่งตรงจากอเมริกา, ฐานเกมหลัก 100%, เครือหลัก, ไม่ผ่านเอเย่นต์,
// เบทต่ำ, เดิมพันเริ่มต้น 1 บาท, ทุนน้อยกำไรงาม, ดับเบิ้ลโบนัส,
// การันตีความน่าเชื่อถือ, การันตีเว็บแท้, จ่ายไว, ค่ายตรง, ส่งตรงจากเว็บแม่,
// เว็บตรงฐานสล็อตหลัก, ฐานเว็บสล็อตหลัก, รีวิวถอนจริง, ถูกลิขสิทธิ์, ไฮคลาส, VIP)
// — the page is written straight from the brief rather than find-and-replaced
// over the old sentences. There is NO หวย / โพย / เลขเด็ด / งวด / แนวทาง /
// ตรวจหวย anywhere on this site this round: it is a sports brand, those words
// appear nowhere, and /ตรวจหวย and /แนวทาง stay parked in src/pages-disabled/.
// Nothing here claims a licence, a regulator, an operator, a studio, a bank, a
// league, a team, a fighter, an RTP figure, a deposit minimum, a member count or
// a founding year, because the brief names none. The only figures are the
// brief's own: 0.3%, 0.8% and 24 ชั่วโมง.
// The brief's own hedging ships with the copy — it states it seven separate
// times (ควรมีข้อมูลผู้ให้บริการและระบบเกมที่สามารถตรวจสอบได้ ·
// อัตราต่อรองอาจเปลี่ยนแปลงตามช่วงเวลา · ไม่มีการเดิมพันประเภทใดรับประกัน
// ผลตอบแทน · ควรตรวจสอบว่าโปรโมชั่นครอบคลุมเฉพาะสล็อตหรือรวมกีฬา/คาสิโนด้วย ·
// คำว่าไม่จำกัดควรระบุให้ชัด · ไม่มีระบบธุรกรรมใดรับประกันความปลอดภัยได้ทั้งหมด ·
// ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP) and every one of those clauses is part of its
// paragraph, not trimmed as downbeat filler.
//
// The brief, every piece of artwork in the drop and the operator's prompt all
// agree on the brand name — no conflict this round. Even so the name is never
// typed on the page: it is interpolated from ${BRAND_NAME} so it can never drift
// from brandProfile. No domain is written out anywhere here — note the real
// domain has a dash and a .org TLD (per brand-spec §1) that the brand name does
// not, which is exactly the kind of thing a hand-typed URL gets wrong.
//
// Title and description are the brief's own Title/Description lines, used
// verbatim and NOT padded up to 150 characters — verify-build deliberately skips
// its 150-character floor on the home page for exactly this reason. Both strings
// are byte-identical to the defaults the orchestrator set in MainLayout.astro,
// which is what makes passing them here a no-op rather than a second source of
// truth.
const pageTitle = `${BRAND_NAME} เว็บเล่นเกมกีฬาออนไลน์ ฐานเกมแท้ จ่ายตรง ไม่บิทยูส`;

const pageDescription = `${BRAND_NAME} เว็บเล่นเกมกีฬาออนไลน์ ทางเข้าเดิมพัน ฐานเกมแท้ ฝากถอนง่าย จ่ายตรง ไม่มีขั้นต่ำ ไม่บิทยูส เข้าเล่นอย่างปลอดภัย ไม่ผ่าน บช. ม้า`;

// The brief has a real H2 -> H3 nesting this round, so the page is NOT flattened
// to H2-only. The two H3s are the two promotion sub-points, which sit under
// section 3's โปรโมชั่น H2 in the brief's own outline. There is no sanctioned
// FeatureHighlights H3 exception this round: no docx section's body is a short
// labelled sub-list.
//
// The checklist, in document order, and what carries each one:
//    1 H1  ${BRAND_NAME} เว็บเล่นเกมกีฬาออนไลน์ ทางเข้าเดิมพัน ฐานเกมแท้
//          ContentBoxCyberCut, brief paragraph on line 4
//    2 H2  ทางเข้า ${BRAND_NAME} เดิมพันบอล มวย และเกมคาสิโนอื่นๆ ครบวงจร
//          ContentBoxTwoPremium, line 6 left / line 7 right
//    3 H2  โปรโมชั่นเล่นสล็อต ${BRAND_NAME} เว็บตรงในตำนาน
//          ContentBox (the plain, always-live variant), line 9
//    4 H3  โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสทุกวัน
//          ContentBoxSevenThreePremium + slide2 (imgCashback), line 11
//    5 H3  โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด
//          ContentBoxSevenThreeCyberCut + slide1 (imgReferral), line 13
//    6 H2  ${BRAND_NAME} ฝากถอนง่าย จ่ายตรง ไม่มีขั้นต่ำ
//          ContentBoxSpecial, line 15 left / line 16 right
//    7 H2  แอดมิน ${BRAND_NAME} คอยให้บริการ 24 ชั่วโมง
//          ContentBoxTwoFloatingBadge, line 18 left / line 19 right
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ ${BRAND_NAME}
//          Faq3 + faqs prop, lines 21-26
// Final inventory for this page: h1 x1, h2 x5, h3 x2.
//
// Shape rhythm, top to bottom: clipped-corner card on the brightest RAISED
// surface whose corner rules pair gold horizontals with silver verticals, taking
// the H1 -> rounded gradient-framed two-column card on the MID surface with a
// gold spine on the left column and a silver spine on the right -> flat rounded
// card from the always-live plain box -> rounded 7:3 slab gradient-filled from
// raised down to sunken, gold-to-silver gradient heading, picture right ->
// clipped-corner 7:3 card on the SUNKEN surface with a solid gold heading behind
// a silver diamond, picture right -> glass card with two icon-plate halves, a
// solid-gold plate against a dark silver-edged plate -> floating-badge card
// gradient-filled from mid up to raised, its badge a dark plate with bright
// gradient ink -> clipped accordion rows on the sunken surface.
// No shape repeats back to back; the two clipped-corner cards sit at opposite
// ends of the depth order (#231c0e raised vs #0d0b06 sunken) and differ in
// corner radius (40px vs 30px); the two SevenThree blocks differ in corner
// (rounded vs clipped), surface (gradient vs flat sunken) AND heading treatment
// (gold-to-silver gradient vs solid gold); and every card's heading gradient
// runs a different order of the same hues, so no two cards read as the same
// card.
//
// ContentBoxSevenThreePremium and ContentBoxSevenThreeCyberCut both take the
// docx heading through `title`, which falls back to their wide (7fr) LEFT text
// column; neither is passed a `titleright`, so each block emits exactly one
// heading and the picture column never carries one.
//
// Every brief paragraph ships in full — all ten of them, nothing merged or
// summarised, plus the three FAQ answers. Sections 2, 6 and 7 have two
// paragraphs each and all three run one paragraph per column, so no slot there
// receives two siblings; sections 1, 3, 4 and 5 have one paragraph each. No
// single-slot box on this page carries two paragraphs, so no wrapper <div> is
// needed in any slot this round.
// The column labels passed to ContentBoxTwoPremium and ContentBoxTwoFloatingBadge
// are this page's own layout wording, not brief headings, and both variants
// render them as <p>. ContentBoxSpecial has no column labels at all — its two
// halves are told apart by their icon plates, which are aria-hidden.
//
// Everything else on the page is chrome and emits no heading tag at any level:
// Announcement2, LatestWinners4, LoginRtpSection and ReviewCardSumo render their
// titles as <p>/<span> with an aria-label on the section, and Faq3's questions
// live inside <summary> as <p>. The non-brief widgets sit before section 1 (the
// ticker, then the winners feed) and after section 8 (LoginRtpSection,
// ReviewCardSumo, Navfoot) — never spliced between two content sections.

// One array, used by both <Faq> and the FAQPage node — never the component's own
// defaults (Faq3 deliberately ships an empty list, so a forgotten prop renders
// an empty accordion rather than some previous brand's questions). The three
// pairs are the brief's own Q/A block (content.txt lines 21-26), verbatim.
const faqs = [
  {
    q: `${BRAND_NAME} มีเดิมพันกีฬาและเกมคาสิโนประเภทใดบ้าง?`,
    a: `${BRAND_NAME} นำเสนอหมวดการเดิมพันฟุตบอล มวย และเกมคาสิโน โดยรายการที่เปิดให้บริการจริงขึ้นอยู่กับผู้ให้บริการและช่วงเวลา ผู้ใช้งานควรตรวจสอบประเภทเดิมพัน กติกา และอัตราต่อรองจากระบบก่อนทำรายการ`,
  },
  {
    q: `${BRAND_NAME} ฝากถอนเงินไม่มีขั้นต่ำจริงหรือไม่?`,
    a: `ยอดฝากถอนขั้นต่ำขึ้นอยู่กับข้อกำหนดและช่องทางชำระเงินที่เว็บไซต์เปิดให้บริการ หาก ${BRAND_NAME} ระบุว่าไม่มีขั้นต่ำ ควรตรวจสอบรายละเอียดธุรกรรมจริง รวมถึงชื่อบัญชีผู้รับเงินและเงื่อนไขการถอนก่อนยืนยันรายการ`,
  },
  {
    q: `${BRAND_NAME} มีโปรโมชั่นอะไร และติดต่อแอดมินได้ตอนไหน?`,
    a: `โปรโมชั่นตามข้อมูลที่กำหนดมี คืนยอดเสีย 0.3% และ แนะนำเพื่อน 0.8% ซึ่งมีเงื่อนไขการคำนวณแตกต่างกัน ส่วนแอดมินระบุว่าให้บริการตลอด 24 ชั่วโมง โดยควรตรวจสอบช่องทางติดต่อหลักและเวลาตอบกลับจริงจากหน้าเว็บไซต์`,
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// No two <strong> elements are adjacent either: every pair is separated by at
// least one run of plain text, so the whitespace between them can never collapse
// into a missing space.
// One highlight colour only: #ffcf5e, against the inherited body colour #f0e8d4
// (BRAND_TEXT). The paragraphs below carry no colour class of their own: every
// ContentBox* card in this mix already sets
// `text-left text-base leading-relaxed text-[#f0e8d4]` on the element holding
// the slot, so the prose inherits it and no page-level override can drift from
// the card. No paragraph carries mx-auto or max-w-* either — the cards cap their
// own width, and the only max-w-* on the page is the one capping each slide,
// which is an image and not prose.

// No breadcrumb: this is the homepage, so a trail from the root to itself would
// be a single self-referential crumb. Every URL in the graph is derived by
// pageGraph from `site:` — no domain is typed out in this file, no URL is built
// with `+`, and no Review / AggregateRating / sameAs / address / email node is
// passed. `description` is the exact same string MainLayout gets, and `faqs` is
// the exact same array <Faq> gets.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <LatestWinners />

  <ContentBoxCyberCut as="h1" title={`${BRAND_NAME} เว็บเล่นเกมกีฬาออนไลน์ ทางเข้าเดิมพัน ฐานเกมแท้`}>
    <p>
      {BRAND_NAME} เว็บเล่นเกมกีฬาออนไลน์ที่นำเสนอทางเข้าเดิมพันหลายประเภท
      <strong class="text-[#ffcf5e]">ทั้งฟุตบอล มวย และเกมคาสิโนในแพลตฟอร์มเดียว</strong>
      ช่วยให้ผู้ใช้งานค้นหาประเภทกีฬา ตรวจสอบรายละเอียดการแข่งขัน และเลือกหมวดเกมที่สนใจได้สะดวกผ่านมือถือหรือคอมพิวเตอร์ พร้อมเมนูจัดการบัญชีและติดตามรายการต่างๆ
      <strong class="text-[#ffcf5e]">ส่วนการระบุว่าเป็นฐานเกมแท้ควรมีข้อมูลผู้ให้บริการและระบบเกมที่สามารถตรวจสอบได้</strong>
      เพื่อประกอบการพิจารณาก่อนใช้งาน
    </p>
  </ContentBoxCyberCut>

  <ContentBoxTwoPremium
    as="h2"
    title={`ทางเข้า ${BRAND_NAME} เดิมพันบอล มวย และเกมคาสิโนอื่นๆ ครบวงจร`}
    titleleft="หมวดเดิมพันในระบบเดียว"
    titleright="ก่อนเลือกประเภทเดิมพัน">
    <p slot="left">
      ทางเข้า {BRAND_NAME}
      <strong class="text-[#ffcf5e]">รวบรวมหมวดเดิมพันกีฬาและเกมคาสิโนไว้ในระบบเดียว</strong>
      โดยฟุตบอลมีข้อมูลคู่แข่งขัน ประเภทการเดิมพัน และอัตราต่อรองให้ศึกษาก่อนตัดสินใจ ส่วนมวยมีรายการแข่งขันและรูปแบบการเดิมพันตามที่ผู้ให้บริการเปิดให้บริการ
      <strong class="text-[#ffcf5e]">นอกจากนี้ยังมีหมวดเกมคาสิโนสำหรับผู้ที่สนใจเกมไพ่ เกมโต๊ะ และสล็อตจากค่ายต่างๆ</strong>
      โดยจำนวนรายการจริงขึ้นอยู่กับระบบที่เปิดใช้งาน
    </p>
    <p slot="right">
      <strong class="text-[#ffcf5e]">การเลือกเดิมพันแต่ละประเภทควรตรวจสอบกติกา อัตราจ่าย และเงื่อนไขการตัดสินผลให้ครบถ้วน</strong>
      โดยเฉพาะการเดิมพันกีฬา ซึ่งอัตราต่อรองอาจเปลี่ยนแปลงตามช่วงเวลา ส่วนเกมคาสิโนมีรูปแบบการคำนวณผลแตกต่างกัน
      <strong class="text-[#ffcf5e]">ไม่มีการเดิมพันประเภทใดรับประกันผลตอบแทน</strong>
      จึงควรกำหนดวงเงินและพิจารณาความเสี่ยงก่อนทำรายการ
    </p>
  </ContentBoxTwoPremium>

  <ContentBox as="h2" title={`โปรโมชั่นเล่นสล็อต ${BRAND_NAME} เว็บตรงในตำนาน`}>
    <p>
      โปรโมชั่น {BRAND_NAME}
      <strong class="text-[#ffcf5e]">นำเสนอสิทธิพิเศษสำหรับสมาชิกตามกิจกรรมที่เว็บไซต์กำหนด</strong>
      โดยมีทั้งรายการคืนยอดเสียและโบนัสแนะนำเพื่อน ผู้ใช้งานสามารถตรวจสอบยอดที่เข้าเกณฑ์ รอบคำนวณ และเงื่อนไขการรับสิทธิ์ผ่านระบบสมาชิกตามที่เปิดให้บริการ
      <strong class="text-[#ffcf5e]">ทั้งนี้ควรตรวจสอบว่าโปรโมชั่นครอบคลุมเฉพาะเกมสล็อตหรือรวมการเดิมพันกีฬาและคาสิโนประเภทอื่นด้วย</strong>
      เพราะแต่ละกิจกรรมอาจกำหนดเงื่อนไขไม่เหมือนกัน
    </p>
  </ContentBox>

  <ContentBoxSevenThreePremium as="h3" title="โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสทุกวัน">
    <p slot="left">
      <strong class="text-[#ffcf5e]">โปรโมชั่นคืนยอดเสีย 0.3%</strong>
      ของ {BRAND_NAME} เป็นกิจกรรมที่คำนวณโบนัสจากยอดเสียที่เข้าเงื่อนไขตามรอบประจำวันที่กำหนด
      <strong class="text-[#ffcf5e]">สมาชิกควรตรวจสอบว่าระบบนับยอดจากสล็อต กีฬา หรือคาสิโนประเภทใดบ้าง</strong>
      รวมถึงเวลาตัดรอบและวิธีรับโบนัส หากมีการโอนโบนัสเข้ายูสทุกวัน สามารถติดตามยอดที่ได้รับจากประวัติบัญชีตามระบบที่เว็บไซต์จัดเตรียมไว้
    </p>
    <Picture
      slot="right"
      src={imgCashback}
      loading="lazy"
      fetchpriority="low"
      widths={[297, 480, 600]}
      sizes="(max-width: 697px) calc(100vw - 98px), (max-width: 767px) 600px, (max-width: 1279px) calc(30vw - 87px), 297px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt={`ภาพโปรโมชั่นคืนยอดเสียของ ${BRAND_NAME} เป็นงานอาร์ตสี่เหลี่ยมจัตุรัสโทนทองสลับดำ ซ้ายเป็นชายหนุ่มผมสีเงินขาวใส่เสื้อฟุตบอลสีดำสลับทองสกรีนชื่อ ${BRAND_NAME} กำลังชี้นิ้วมาทางผู้ชม ขวาเป็นหญิงสาวผมสีเงินขาวใส่ชุดกีฬาสีดำสลับทองถือลูกฟุตบอลสีทองอยู่ในมือ ทั้งคู่ยืนอยู่บนเวทีวงแหวนสีทอง บนสุดของภาพเป็นโลโก้ถ้วยแชมป์ทองที่มีลูกฟุตบอลทองอยู่กลางถ้วย เหนือตัวอักษร UFA สีทองคู่กับเลข 324 สีเงินโครเมียม กลางภาพเป็นคำว่า โปรโมชั่น ตัวอักษรทองสามมิติขนาดใหญ่ ถัดลงมาเป็นคำว่า คืนยอดเสีย คู่กับเลข 0.3%`}
      class="mx-auto h-auto w-full max-w-[600px] rounded-2xl border border-[#e5a81b]/55 shadow-[0_0_28px_rgba(229,168,27,0.3)]"
    />
  </ContentBoxSevenThreePremium>

  <ContentBoxSevenThreeCyberCut as="h3" title="โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด">
    <p slot="left">
      กิจกรรมแนะนำเพื่อน {BRAND_NAME}
      <strong class="text-[#ffcf5e]">ระบุอัตราโบนัส 0.8% จากยอดที่เข้าเกณฑ์ตามข้อกำหนด</strong>
      สมาชิกสามารถตรวจสอบรายละเอียดการแชร์ลิงก์ จำนวนเพื่อนที่แนะนำ และวิธีคำนวณโบนัสได้จากหน้าโปรโมชั่น
      <strong class="text-[#ffcf5e]">ส่วนคำว่าไม่จำกัดควรระบุให้ชัดเจนว่าเกี่ยวข้องกับจำนวนเพื่อน จำนวนครั้งในการรับสิทธิ์ หรือยอดโบนัสสูงสุด</strong>
      เพื่อป้องกันความเข้าใจคลาดเคลื่อนเกี่ยวกับผลตอบแทน
    </p>
    <Picture
      slot="right"
      src={imgReferral}
      loading="lazy"
      fetchpriority="low"
      widths={[312, 480, 600]}
      sizes="(max-width: 697px) calc(100vw - 98px), (max-width: 767px) 600px, (max-width: 1279px) calc(30vw - 72px), 312px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt={`ภาพโปรโมชั่นแนะนำเพื่อนของ ${BRAND_NAME} เป็นงานอาร์ตสี่เหลี่ยมจัตุรัสชุดเดียวกัน โทนทองสลับดำ ซ้ายเป็นชายหนุ่มผมสีเงินขาวใส่เสื้อฟุตบอลสีดำสลับทองสกรีนชื่อ ${BRAND_NAME} ขวาเป็นหญิงสาวผมบ๊อบสีเงินขาวใส่ชุดกีฬาครอปสีดำสลับทองสกรีนชื่อเดียวกัน ทั้งคู่ยืนยิ้มและยื่นมือออกมาทางผู้ชม มีลูกฟุตบอลสีทองวางอยู่ที่มุมล่างทั้งสองข้าง บนสุดของภาพเป็นโลโก้ถ้วยแชมป์ทองที่มีลูกฟุตบอลทองอยู่กลางถ้วย เหนือตัวอักษร UFA สีทองคู่กับเลข 324 สีเงินโครเมียม กลางภาพมีมงกุฎทองอยู่เหนือคำว่า โปรโมชั่น ตัวอักษรทองสามมิติขนาดใหญ่ ถัดลงมาบนแผ่นป้ายสีดำขอบทองเป็นคำว่า แนะนำเพื่อน และคำว่า โบนัส คู่กับเลข 0.8%`}
      class="mx-auto h-auto w-full max-w-[600px] rounded-2xl border border-[#b9c2cc]/55 shadow-[0_0_28px_rgba(185,194,204,0.26)]"
    />
  </ContentBoxSevenThreeCyberCut>

  <ContentBoxSpecial as="h2" title={`${BRAND_NAME} ฝากถอนง่าย จ่ายตรง ไม่มีขั้นต่ำ`} iconleft="💳" iconright="🛡️">
    <p slot="left">
      ระบบฝากถอน {BRAND_NAME}
      <strong class="text-[#ffcf5e]">นำเสนอการจัดการธุรกรรมผ่านบัญชีสมาชิก</strong>
      โดยผู้ใช้งานสามารถตรวจสอบยอดเงิน ช่องทางชำระเงิน และสถานะรายการตามระบบที่เปิดให้บริการ
      <strong class="text-[#ffcf5e]">ก่อนยืนยันธุรกรรมควรตรวจสอบชื่อบัญชีผู้รับเงินให้ตรงกับข้อมูลที่เว็บไซต์แจ้ง</strong>
      รวมถึงอ่านข้อกำหนดเกี่ยวกับยอดฝากถอนขั้นต่ำและระยะเวลาดำเนินการให้ครบถ้วน
    </p>
    <p slot="right">
      สำหรับข้อความ
      <strong class="text-[#ffcf5e]">จ่ายตรง ไม่บิดยูส ไม่มีขั้นต่ำ และไม่ผ่านบัญชีม้า</strong>
      ควรมีข้อมูลที่ตรวจสอบได้รองรับ โดยเฉพาะชื่อผู้ดำเนินงาน ข้อกำหนดการถอนเงิน และข้อมูลบัญชีรับชำระ
      <strong class="text-[#ffcf5e]">เพราะไม่มีระบบธุรกรรมใดสามารถรับประกันความปลอดภัยได้ทั้งหมด</strong>
      หากพบข้อมูลบัญชีปลายทางผิดปกติหรือรายการไม่เป็นไปตามเงื่อนไข ควรติดต่อฝ่ายบริการผ่านช่องทางหลักก่อนทำธุรกรรมเพิ่มเติม
    </p>
  </ContentBoxSpecial>

  <ContentBoxTwoFloatingBadge
    as="h2"
    title={`แอดมิน ${BRAND_NAME} คอยให้บริการ 24 ชั่วโมง`}
    titleleft="ช่องทางติดต่อหลัก"
    titleright="แจ้งปัญหาให้ตรงรายการ">
    <p slot="left">
      แอดมิน {BRAND_NAME}
      <strong class="text-[#ffcf5e]">มีช่องทางสำหรับรับเรื่องสอบถามเกี่ยวกับการเข้าสู่ระบบ การตรวจสอบรายการกีฬา ปัญหาเกมคาสิโน โปรโมชั่น และธุรกรรมฝากถอน</strong>
      โดยระบุเวลาให้บริการตลอด 24 ชั่วโมง
      <strong class="text-[#ffcf5e]">ผู้ใช้งานสามารถแจ้งรายละเอียดผ่านช่องทางติดต่อหลักที่เว็บไซต์กำหนด</strong>
      เพื่อให้เจ้าหน้าที่ตรวจสอบปัญหาได้ตรงกับรายการที่ต้องการความช่วยเหลือ
    </p>
    <p slot="right">
      หากเป็นปัญหาเกี่ยวกับการเดิมพันกีฬา
      <strong class="text-[#ffcf5e]">ควรเตรียมชื่อคู่แข่งขัน เวลาแข่งขัน และหมายเลขรายการ</strong>
      ส่วนปัญหาคาสิโนควรแจ้งชื่อเกมและเวลาที่เกิดเหตุ หากเป็นเรื่องธุรกรรมควรเก็บหลักฐานจำนวนเงินและเวลาทำรายการไว้สำหรับตรวจสอบ
      <strong class="text-[#ffcf5e]">โดยไม่เปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น</strong>
      แม้จะอ้างว่าเป็นเจ้าหน้าที่ของเว็บไซต์ก็ตาม
    </p>
  </ContentBoxTwoFloatingBadge>

  <Faq as="h2" title={`คำถามที่พบบ่อยเกี่ยวกับ ${BRAND_NAME}`} faqs={faqs} />

  <LoginRtpSection />

  <ReviewCardSumo />

  <Navfoot />
</MainLayout>
