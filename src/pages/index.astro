---
import MainLayout from "../layouts/MainLayout.astro";
import AnnouncementCyber from "../components/AnnouncementCyber.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBox3ThreeCyberCut from "../components/ContentBox3ThreeCyberCut.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LatestWinnersCyber from "../components/LatestWinnersCyber.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";

const pageTitle = "WE168 คาสิโนออนไลน์ครบวงจร รองรับมือถือ สนุกได้ทุกที่ มีเงินได้ทุกวัน";

const pageDescription =
  "WE168 คาสิโนออนไลน์ครบวงจร เกมหลากหลายในบัญชีเดียว รองรับมือถือ แท็บเล็ต คอมพิวเตอร์ ฝากถอนอัตโนมัติ 24 ชั่วโมง ทีมงานดูแลตลอดเวลา สนุกได้ทุกที่ มีเงินได้ทุกวัน";

const signupSteps = [
  {
    icon: "📝",
    title: "ขั้นตอนที่ 1 กดสมัครสมาชิก",
    description: "กดสมัครสมาชิกและกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน",
    accent: "gold" as const,
  },
  {
    icon: "💳",
    title: "ขั้นตอนที่ 2 ฝากเครดิต",
    description: "เข้าสู่บัญชีสมาชิกและทำรายการฝากเครดิตผ่านระบบอัตโนมัติ",
    accent: "blue" as const,
  },
  {
    icon: "🎰",
    title: "ขั้นตอนที่ 3 เลือกเกม",
    description: "เลือกหมวดหมู่และเกมคาสิโนที่ต้องการ จากนั้นจึงเริ่มเดิมพันตามเงื่อนไขของเกม",
    accent: "gold" as const,
  },
];

const supportIssues = ["สมัครสมาชิกไม่สำเร็จ", "เข้าสู่ระบบไม่ได้", "ลืมรหัสผ่าน", "ฝากเงินไม่สำเร็จ", "ถอนเงินไม่สำเร็จ", "เลือกเกมไม่ได้"];

const faqs = [
  {
    q: "WE168 มีเกมคาสิโนอะไรให้เลือกเล่นบ้าง?",
    a: "WE168 รวมเกมคาสิโนออนไลน์หลายประเภทไว้ภายในเว็บไซต์เดียว ทั้งบาคาร่า รูเล็ต เสือมังกร แบล็กแจ็ก ไฮโล และสล็อต สามารถเลือกเล่นได้จากบัญชีสมาชิกเดียวโดยไม่ต้องสมัครหลายบัญชี",
  },
  {
    q: "WE168 เล่นผ่านมือถือได้หรือไม่?",
    a: "รองรับการใช้งานผ่านโทรศัพท์ Android และ iPhone รวมถึงแท็บเล็ตและคอมพิวเตอร์ สมาชิกสามารถเข้าสู่ระบบ เลือกเกม และเดิมพันผ่านเว็บเบราว์เซอร์ที่รองรับได้ทันที",
  },
  {
    q: "หากฝากเงินหรือถอนเงินไม่สำเร็จต้องทำอย่างไร?",
    a: "ควรตรวจสอบข้อมูลบัญชีและจำนวนเงินให้ถูกต้องก่อนทำรายการ หากยังพบปัญหา สามารถติดต่อแอดมิน WE168 พร้อมแจ้งรายละเอียดเพื่อให้ทีมงานช่วยตรวจสอบได้ตลอด 24 ชั่วโมง",
  },
];

const graph = pageGraph(Astro, {
  name: "WE168",
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <AnnouncementCyber message="WE168 คาสิโนออนไลน์ครบวงจร บาคาร่า รูเล็ต เสือมังกร แบล็กแจ็ก ไฮโล สล็อต • ฝากถอนออโต้ 24 ชม. • ทีมงานพร้อมดูแลตลอดเวลา • สมัครสมาชิกวันนี้เริ่มเล่นได้ทันที" />

  <ContentBoxFloatingBadge as="h1" title="WE168 คาสิโนออนไลน์ครบวงจร รองรับมือถือ สนุกได้ทุกที่ มีเงินได้ทุกวัน">
    <p class="text-left text-base leading-relaxed text-[#e9f7e6]">
      <strong class="text-[#4ade80]">WE168</strong> เว็บคาสิโนออนไลน์ครบวงจร รองรับการใช้งานผ่านโทรศัพท์มือถือ แท็บเล็ต และคอมพิวเตอร์ในระบบเดียว รวมเกมคาสิโนหลากหลายประเภทไว้ในบัญชีสมาชิกเดียว
      พร้อมระบบฝากถอนอัตโนมัติที่ทำรายการได้ด้วยตัวเองตลอดเวลา และทีมงานพร้อมดูแลให้บริการตลอด 24 ชั่วโมง
    </p>
  </ContentBoxFloatingBadge>

  <SmoothCarousel />

  <ContentBoxCyberCut as="h2" title="WE168 บริการเกมคาสิโนออนไลน์ทุกประเภท มีให้เล่นครบทุกหมวดหมู่เกม">
    <p class="text-left text-base leading-relaxed text-[#e9f7e6]">
      WE168 รวมเกมคาสิโนออนไลน์ไว้ให้เลือกเล่นครบทุกประเภท ทั้งบาคาร่า รูเล็ต เสือมังกร แบล็กแจ็ก ไฮโล และสล็อต ฯลฯ จัดหมวดหมู่เกมไว้อย่างเป็นระเบียบ ค้นหาและเลือกเล่นได้ง่าย
      โดยใช้บัญชีสมาชิกเดียวสลับเล่นได้ทุกหมวดหมู่โดยไม่ต้องสมัครหลายบัญชี
    </p>
  </ContentBoxCyberCut>

  <ContentBox3ThreeCyberCut titleleft="เกมคาสิโนสด" titlecenter="สล็อตออนไลน์" titleright="บัญชีเดียวครบทุกเกม">
    <p slot="left" class="text-left text-sm leading-relaxed text-[#e9f7e6]/80">บาคาร่า รูเล็ต เสือมังกร แบล็กแจ็ก และไฮโล ถ่ายสดภาพคมชัด เดิมพันได้แบบเรียลไทม์</p>
    <p slot="center" class="text-left text-sm leading-relaxed text-[#e9f7e6]/80">รวมเกมสล็อตหลากหลายค่าย หมุนได้ทุกวันในบัญชีเดียว ไม่ต้องสลับเว็บไซต์</p>
    <p slot="right" class="text-left text-sm leading-relaxed text-[#e9f7e6]/80">สมัครครั้งเดียวเล่นได้ทุกหมวดหมู่เกม สลับเล่นได้ทันทีโดยไม่ต้องสมัครซ้ำ</p>
  </ContentBox3ThreeCyberCut>

  <ProviderGrid />

  <ContentBoxSevenThreeCyberCut titleright="WE168 พัฒนาระบบใหม่ ปลอดภัยมากขึ้น พร้อมรองรับมือถือ สะดวกที่สุด">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์ WE168 โปรคืนยอดเสีย รับโบนัส 0.3% พื้นหลังธีมนีออนเขียว-ชมพู หญิงสาวชุดสีชมพูเงางามชี้ไปที่ตัวเลขโบนัส 0.3% พร้อมภาพหน้าจอมือถือแอป WE168 แสดงโต๊ะบาคาร่าและยอดเครดิต วงล้อรูเล็ต ไพ่เอซคู่ และชิปคาสิโนประกอบฉาก"
      class="mx-auto h-auto w-full rounded-2xl border border-[#22c55e]/25 shadow-[0_10px_30px_rgba(34,197,94,0.18)]"
    />
    <div slot="right">
      <p class="text-left text-base leading-relaxed text-[#e9f7e6]">
        ระบบของ WE168 รองรับการใช้งานผ่านโทรศัพท์ Android และ iPhone รวมถึงแท็บเล็ตและคอมพิวเตอร์ หน้าเว็บไซต์ปรับขนาดให้พอดีกับทุกอุปกรณ์โดยอัตโนมัติ
      </p>
      <p class="mt-4 text-left text-base leading-relaxed text-[#e9f7e6]">
        พร้อมระบบจัดการบัญชีสมาชิกและรายการธุรกรรมที่ปลอดภัยมากขึ้น ตรวจสอบยอดเงินและประวัติการทำรายการได้สะดวกทุกที่ทุกเวลา
      </p>
    </div>
  </ContentBoxSevenThreeCyberCut>

  <ContentBoxNeumorphism as="h2" title="เดิมพันจริงในรูปแบบคาสิโนออนไลน์ ลงเงินจริง ได้เงินจริง เสียเงินจริง">
    <p class="text-left text-base leading-relaxed text-[#fdeaf4]">
      การเดิมพันบน WE168 เป็นการเดิมพันจริงในรูปแบบคาสิโนออนไลน์ ลงเงินจริง มีโอกาสได้เงินจริงและเสียเงินจริงในทุกรอบการเล่น สมาชิกควรตรวจสอบกติกาและอัตราจ่ายของแต่ละเกมให้เข้าใจก่อนเริ่มเดิมพันทุกครั้ง
    </p>
    <p class="mt-4 text-left text-base leading-relaxed text-[#fdeaf4]">ควรกำหนดงบประมาณในการเล่นล่วงหน้า และเล่นตามกำลังทรัพย์ของตนเองเพื่อความเหมาะสมในการใช้งาน</p>
  </ContentBoxNeumorphism>

  <ContentBoxTwoCyberCut titleleft="ฝากเงินเข้าเดิมพันง่าย WE168 มีระบบออโต้ มีคู่มือขั้นตอนให้ดู">
    <p slot="left" class="text-left text-base leading-relaxed text-[#fdeaf4]">
      WE168 มีระบบฝากเงินเข้าเดิมพันแบบออโต้ ทำรายการได้ด้วยตัวเองตลอด 24 ชั่วโมงโดยไม่ต้องรอเจ้าหน้าที่ พร้อมคู่มือขั้นตอนการฝากเงินให้ดูบนหน้าเว็บไซต์อย่างละเอียด
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#fdeaf4]">
      หากทำรายการฝากเงินไม่สำเร็จ สามารถติดต่อเจ้าหน้าที่ของ WE168 เพื่อขอความช่วยเหลือและตรวจสอบรายการได้ทันที
    </p>
  </ContentBoxTwoCyberCut>

  <ContentBoxFloatingBadge as="h2" title="เริ่มต้นเล่นเกมคาสิโนกับ WE168 สมัครเพียง 3 ขั้นตอน">
    <p class="text-left text-base leading-relaxed text-[#e9f7e6]">เริ่มต้นใช้งานได้ง่ายภายในไม่กี่ขั้นตอน</p>
    <FeatureHighlights items={signupSteps} heading={true} />
    <p class="mt-4 text-left text-base leading-relaxed text-[#e9f7e6]">ก่อนยืนยันการเดิมพันทุกครั้ง ควรตรวจสอบจำนวนเงินและรายละเอียดของรายการให้เรียบร้อย</p>
  </ContentBoxFloatingBadge>

  <ContentBoxCyberCut as="h2" title="พบปัญหาขณะใช้งาน ติดต่อสอบถามแอดมินได้ตลอด 24 ชม.">
    <p class="text-left text-base leading-relaxed text-[#e9f7e6]">
      หากพบปัญหาขณะใช้งาน ไม่ว่าจะเป็นการสมัครสมาชิก การเข้าสู่ระบบ การฝากถอนเงิน หรือการเลือกเกม สามารถติดต่อสอบถามแอดมิน WE168 ได้ตลอด 24 ชั่วโมง
    </p>
    <p class="mt-4 text-left text-base leading-relaxed text-[#e9f7e6]">ทีมงานสามารถช่วยตรวจสอบปัญหาต่าง ๆ เช่น</p>
    <ul class="mt-3 grid grid-cols-1 gap-2 text-left text-base leading-relaxed text-[#e9f7e6] sm:grid-cols-2">
      {
        supportIssues.map((issue) => (
          <li class="flex items-center gap-2">
            <span aria-hidden="true" class="text-[#4ade80]">
              •
            </span>
            {issue}
          </li>
        ))
      }
    </ul>
  </ContentBoxCyberCut>

  <LatestWinnersCyber />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#4ade80] to-[#16a34a] px-4 py-3 text-sm font-black whitespace-nowrap text-[#04120a] shadow-[0_10px_30px_rgba(34,197,94,0.26)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(34,197,94,0.4)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>

    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#f9a8d4] to-[#db2777] px-4 py-3 text-sm font-black whitespace-nowrap text-[#4a0a29] shadow-[0_10px_30px_rgba(219,39,119,0.26)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(219,39,119,0.4)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>
  </div>

  <ReviewCardSumo2 />

  <Faq title="คำถามที่พบบ่อยเกี่ยวกับ WE168" faqs={faqs} />

  <Navfoot />
</MainLayout>
