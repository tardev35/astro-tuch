---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import LatestWinners from "../components/LatestWinners2.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Faq from "../components/Faq4.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// SLIDE ROLES FOR MHEEPOOH168 — READ BEFORE REUSING THESE IMPORTS.
// Checked against the 2026-09-21 drop by opening both posters: slide1.png reads
// "โปรโมชั่น คืนยอดเสีย 0.3%" so it belongs to docx H3 #4, and slide2.png reads
// "โปรโมชั่นแนะนำเพื่อน 0.8%" so it belongs to docx H3 #5. The order is NOT
// stable across brands — re-read the posters next rebrand rather than copying
// this order forward.
//
// slide3.png (2026-09-18) and slide4.png (2026-08-13) are deliberately NOT
// imported: both print a PREVIOUS brand's name in large type on the artwork
// itself (ENTER55 and PIGAUTO). Nothing else on this page carries an image —
//   banner1 / banner1-mobile  = MainLayout's own pinned globs. A page never
//                               references them, and nothing here gets
//                               loading="eager" fetchpriority="high" — the hero
//                               is the LCP element and it belongs to the layout.
//   banner2.png (2026-08-20) and banner3.png (2026-08-11) predate the
//   2026-09-21 asset drop -> stale inventory from earlier clients, must stay
//   unimported.
// A slide may only ever live inside a ContentBoxSevenThree*; two of them is the
// family's hard cap per rebrand and this page uses exactly two, which is the
// whole budget for this rebrand.
//
// Dropped from the previous brand's index and NOT deleted from disk (they are
// inventory for the next brand): Announcement3, ContentBoxCyberCut,
// ContentBoxSevenThree, ContentBoxSevenThreePremium, FeatureHighlights,
// ProviderGridPremium, LatestWinnersPremium and Faq2 — that whole mix went out
// with the outgoing brand and none of it may be reused this round.

// Title and description are the brief's own Title/Meta Description lines, used
// verbatim. A brief-supplied description is never padded up to the 150-char
// floor and never topped up from the H1/H2.
const pageTitle = "MHEEPOOH168 เว็บรวมคาสิโนเกม บาคาร่า สล็อต หวย บอล ปลอดภัย100%";

const pageDescription = "MHEEPOOH168 เว็บรวมคาสิโนเกม บาคาร่า สล็อต หวย บอล เข้าเล่นง่าย ได้เงินจริง ฝากถอนมั่นใจ ปลอดภัย100%";

// <Announcement /> runs bare: AnnouncementPremium's default message is already
// this brand's copy, and every sub-page calls it bare too — passing an override
// here is how the ticker ends up saying two different things on two pages.

// The docx has a real H1 -> H2 -> H3 hierarchy this round: #4 and #5 are genuine
// H3 sub-points of H2 #3, so the page is NOT flattened to H2-only. They are the
// only <h3> on the site and they are carried by the two SevenThree blocks.
// Everything else on the page is chrome — ProviderGrid, LatestWinners,
// LoginRtpSection and ReviewCardSumo all render their titles as <p>/<span> with
// an aria-label on the section, and Faq4's questions stay <span> inside
// <summary>, so none of them emits a heading.
// Final inventory for this page: h1 x1, h2 x5, h3 x2.

// One array, used by both <Faq> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last. The three pairs
// are the brief's L16-L21, verbatim.
const faqs = [
  {
    q: "MHEEPOOH168 มีเกมประเภทไหนให้เลือกบ้าง?",
    a: "ภายในระบบมีทั้งบาคาร่า สล็อต หวย และบอล รวมถึงเกมจากหลายค่ายที่เปิดให้เลือกตามหมวดหมู่ สมาชิกสามารถตรวจสอบรายการที่เปิดให้ใช้งานได้จากหน้าเกมของเว็บไซต์",
  },
  {
    q: "โปรโมชั่น MHEEPOOH168 มีอะไรบ้าง?",
    a: "โปรโมชั่นหลักที่กำหนดไว้มีโบนัสคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8% โดยแต่ละรายการมีเงื่อนไขแตกต่างกัน แนะนำให้ตรวจสอบรายละเอียดก่อนกดรับสิทธิ์ทุกครั้ง",
  },
  {
    q: "หากมีปัญหาในการใช้งานติดต่อได้ตอนไหน?",
    a: "สามารถติดต่อแอดมิน MHEEPOOH168 ได้ตลอด 24 ชั่วโมง เพื่อสอบถามเรื่องบัญชี เกม โปรโมชั่น ช่องทางเครดิต หรือปัญหาการเข้าสู่ระบบ โดยทีมงานจะช่วยตรวจสอบตามข้อมูลที่แจ้งเข้ามา",
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// The highlight colour is the palette's bright gold (#fced74); it marks a claim
// the brief states outright and nothing else.

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb. Every URL in the graph is derived
// by pageGraph from `site:` — no domain is typed out in this file.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxNeumorphism as="h1" title="MHEEPOOH168 เว็บรวมคาสิโนเกม มาตรฐานสากล 2026">
    <p class="text-left text-base leading-relaxed text-[#f1dccd]">
      <strong class="text-[#fced74]">MHEEPOOH168 เว็บรวมคาสิโนเกมที่รวบรวมความบันเทิงหลายรูปแบบไว้ในระบบเดียว</strong>
      <strong class="text-[#fced74]">ทั้งบาคาร่า สล็อต หวย และบอล</strong>
      พร้อมรูปแบบการใช้งานที่ออกแบบให้เข้าถึงได้ง่ายบนมือถือและคอมพิวเตอร์
      <strong class="text-[#fced74]">ระบบจัดหมวดหมู่เกมชัดเจน</strong>
      ช่วยให้สมาชิกเลือกประเภทที่ต้องการได้สะดวก พร้อมมาตรฐานการใช้งานที่เน้นความเป็นระบบในปี 2026
    </p>
  </ContentBoxNeumorphism>

  <ContentBoxFloatingBadge as="h2" title="เกมเว็บ MHEEPOOH168 บาคาร่า สล็อต หวย บอล ครบวงจร">
    <p class="text-left text-base leading-relaxed text-[#f1dccd]">
      ภายใน MHEEPOOH168 มีเกมให้เลือกครบหลายหมวด
      <strong class="text-[#fced74]">ทั้งบาคาร่า สล็อต หวย และบอล</strong>
      <strong class="text-[#fced74]">โดยแต่ละประเภทถูกแยกเป็นเมนูอย่างชัดเจน สามารถสลับรูปแบบการเล่นได้จากบัญชีเดียว</strong>
      <strong class="text-[#fced74]">พร้อมตัวเลือกจากหลายค่ายและหลายตลาด</strong>
      ช่วยให้ผู้ใช้งานเข้าถึงเกมที่สนใจได้โดยไม่ต้องเปลี่ยนหลายเว็บไซต์
    </p>
  </ContentBoxFloatingBadge>

  <ProviderGrid />

  <ContentBox as="h2" title="โปรโมชั่นสล็อต MHEEPOOH168 ใช้ได้ทุกเกม ไม่จำกัด">
    <p class="text-left text-base leading-relaxed text-[#f1dccd]">
      โปรโมชั่นสล็อต MHEEPOOH168 มีตัวเลือกสำหรับสมาชิกที่ต้องการรับสิทธิ์เพิ่มเติมจากการใช้งาน
      <strong class="text-[#fced74]">โดยมีทั้งโบนัสคืนยอดเสียและโบนัสแนะนำเพื่อน</strong>
      แต่ละโปรโมชั่นมีรายละเอียดและเงื่อนไขแยกไว้อย่างชัดเจน
      <strong class="text-[#fced74]">สามารถตรวจสอบสิทธิ์ก่อนรับเพื่อเลือกโปรโมชั่นที่เหมาะกับรูปแบบการเล่นของตัวเอง</strong>
    </p>
  </ContentBox>

  <ContentBoxSevenThreeCyberCut as="h3" title="คืนยอดเสีย โบนัส 0.3%">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[260, 400, 700]}
      sizes="(max-width: 767px) 92vw, 346px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นคืนยอดเสียของ MHEEPOOH168 พื้นหลังสีแดงทองมีเหรียญทอง กล่องของขวัญ ไพ่ และลูกบอลหวยเลข 8 6 และ 3 ด้านบนเป็นตัวอักษรทองคำว่า MHEEPOOH168 ใต้ลงมาเป็นข้อความว่า โปรโมชั่น คืนยอดเสีย และตัวเลข 0.3% ขนาดใหญ่สีทอง ด้านซ้ายเป็นผู้หญิงผมยาวสวมชุดสีแดงสลับขาวที่มีคำว่า MHEEPOOH168 อยู่บนชุด"
      class="mx-auto h-auto w-full rounded-2xl border border-[#f5b70a]/55 shadow-[0_10px_30px_rgba(245,183,10,0.28)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f1dccd]">
      สมาชิก MHEEPOOH168
      <strong class="text-[#fced74]">สามารถรับโบนัสคืนยอดเสีย 0.3% ตามยอดและเงื่อนไขที่ระบบกำหนด</strong>
      โดยสามารถตรวจสอบรอบคำนวณ รายละเอียดของยอดที่เข้าเกณฑ์ และขั้นตอนรับสิทธิ์ได้จากหน้าโปรโมชั่น ช่วยให้ติดตามโบนัสแต่ละรอบได้ง่ายขึ้นและไม่พลาดสิทธิ์ที่ได้รับ
    </p>
  </ContentBoxSevenThreeCyberCut>

  <ContentBoxSevenThreeNeumorphism as="h3" title="แนะนำเพื่อน โบนัส 0.8%">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[280, 420, 760]}
      sizes="(max-width: 767px) 92vw, 380px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อนของ MHEEPOOH168 พื้นหลังสีแดงทองมีเหรียญทอง กล่องของขวัญ และโทรโข่งสีแดง ด้านบนเป็นตัวอักษรทองคำว่า MHEEPOOH168 ใต้ลงมาเป็นข้อความว่า โปรโมชั่นแนะนำเพื่อน และตัวเลข 0.8% ขนาดใหญ่สีทอง มุมซ้ายบนมีป้ายข้อความ GOOD FRIENDS BIG BONUS ด้านขวามีป้ายกลมว่า ชวนเพื่อน รับโบนัส ไม่จำกัด และด้านซ้ายเป็นผู้หญิงผมยาวสวมชุดสีแดงสลับขาวที่มีคำว่า MHEEPOOH168 อยู่บนชุด"
      class="mx-auto h-auto w-full rounded-2xl border border-[#fced74]/50 shadow-[0_10px_30px_rgba(252,237,116,0.22)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f1dccd]">
      โปรโมชั่นแนะนำเพื่อนของ MHEEPOOH168
      <strong class="text-[#fced74]">ให้โบนัส 0.8% ตามเงื่อนไขที่กำหนด</strong>
      สมาชิกสามารถชวนคนรู้จักเข้ามาสมัครผ่านช่องทางที่ระบบรองรับ
      <strong class="text-[#fced74]">พร้อมตรวจสอบข้อมูลของโบนัสและยอดสิทธิ์ได้จากบัญชีสมาชิก</strong>
      เหมาะสำหรับผู้ที่ต้องการรับสิทธิ์เพิ่มเติมจากกิจกรรมแนะนำเพื่อน
    </p>
  </ContentBoxSevenThreeNeumorphism>

  <ContentBoxPremium as="h2" title="MHEEPOOH168 รองรับทุกธนาคารและวอลเลท ไม่จำกัดยอด">
    <p class="text-left text-base leading-relaxed text-[#f1dccd]">
      ระบบ MHEEPOOH168
      <strong class="text-[#fced74]">รองรับช่องทางธนาคารและวอลเลทที่กำหนดไว้ภายในเว็บไซต์</strong>
      ช่วยให้สมาชิกเลือกวิธีจัดการเครดิตได้ตามความสะดวก
      <strong class="text-[#fced74]">โดยสามารถตรวจสอบสถานะรายการและยอดผ่านบัญชีของตัวเองได้</strong>
      ขั้นตอนถูกจัดวางให้เข้าใจง่าย เหมาะกับทั้งสมาชิกใหม่และผู้ที่ใช้งานเป็นประจำ
    </p>
  </ContentBoxPremium>

  <LatestWinners />

  <ContentBoxSpecial as="h2" title="แอดมิน MHEEPOOH168 คอยให้บริการ 24 ชั่วโมง" iconleft="💬" iconright="🛟">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f1dccd]">
      หากมีข้อสงสัยเกี่ยวกับการสมัคร เกม โปรโมชั่น ระบบเครดิต หรือการเข้าใช้งาน
      <strong class="text-[#fced74]">สามารถติดต่อแอดมิน MHEEPOOH168 ได้ตลอด 24 ชั่วโมง</strong>
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#f1dccd]">
      ทีมงานพร้อมให้ข้อมูลเกี่ยวกับเมนูและขั้นตอนต่าง ๆ ภายในเว็บไซต์
      <strong class="text-[#fced74]">รวมถึงช่วยตรวจสอบปัญหาเบื้องต้นเพื่อให้สมาชิกใช้งานระบบได้ต่อเนื่องมากขึ้น</strong>
    </p>
  </ContentBoxSpecial>

  <LoginRtpSection />

  <Faq as="h2" title="คำถามที่พบบ่อย" faqs={faqs} />

  <ReviewCardSumo />

  <Navfoot />
</MainLayout>
