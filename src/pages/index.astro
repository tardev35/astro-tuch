---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ProviderGrid from "../components/ProviderGridPremium.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBox3ThreeCyberCut from "../components/ContentBox3ThreeCyberCut.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import Faq from "../components/Faq2.astro";
import LatestWinners from "../components/LatestWinners4.astro";
import ReviewCardSumo from "../components/ReviewCardSumo.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import { pageGraph } from "../lib/schema";
import cashbackPoster from "../assets/slide1.png";
import referralPoster from "../assets/slide2.png";

// การหมุน variant รอบนี้ตัดสินไว้แล้วใน .claude/brand-spec-win8s.md §3 —
// **ห้ามเลือกใหม่ที่นี่** แบรนด์ขาออก (123BET) ถูกหมุนออกจากทุกตระกูลพร้อมกัน:
// AnnouncementPremium แทน Announcement5 · Faq2 แทน Faq4 · LatestWinners4 แทน
// LatestWinners2 · ReviewCardSumo แทน ReviewCardSumo2 · ProviderGridPremium แทน
// ProviderGrid ตัวฐาน · และ shape-mix ของ ContentBox ทิ้งชุด CyberCut + ตัวฐาน +
// 3ThreePremium + Special ของรอบก่อนทั้งชุด ไปใช้ **Premium + TwoNeumorphism +
// FloatingBadge + SevenThreePremium + SevenThreeNeumorphism + 3ThreeCyberCut +
// TwoCyberCut** แทน
// ไม่ลบไฟล์ที่ไม่ได้ใช้แม้แต่ตัวเดียว — มันคือ inventory ของแบรนด์ถัดไป
// Navbar/Footer อยู่ที่ MainLayout (NavbarStyle9 / FooterStyle2) ไม่ใช่ที่ไฟล์นี้
// ❌ รอบนี้ **ไม่ใช้ BankStrip / FeatureHighlights / SmoothCarousel / LottoGrid /
// LoginRtpSection / GameRankingBoard / ContentBoxSpecial / ตระกูล *Huay** —
// บรีฟรอบนี้ไม่มีหมวดฝากถอน ธนาคาร วอลเลท หรือออโต้เลยแม้แต่คำเดียว
// ⚠️ `<Announcement />` ถูกเรียกแบบ **ไม่ส่ง message** โดยตั้งใจ — orchestrator ตั้ง
// ค่า default ของ AnnouncementPremium เป็นคอปปี้ของแบรนด์รอบนี้ไว้แล้ว และหน้าย่อย
// ทุกหน้าก็เรียกแบบ bare เหมือนกัน ข้อความ ticker จึงตรงกันทั้งเว็บจากที่เดียว
//
// ⚠️⚠️ พาเลตรอบนี้ (brand-spec §2 ล็อกค่าไว้ ห้ามเดาเพิ่ม ห้ามดูดสีจากรูป):
// 🚨🚨 **กลับทิศ 180° จากรอบก่อน — รอบนี้ "มืดทั้งเว็บ"** (รอบก่อน 123BET เป็น
// เนื้อหาสว่าง + โครมเข้ม) พื้นเพจ #1e0101 (bg.json) = ดำอมเลือดหมู · การ์ด #2a0a04 ·
// ชั้นยก #3b130b · เส้นบาง #5a2410 · ขอบ/ออรา #8a3a12 · โครม #250604 / #140302 ·
// หมึก #fdf0e6 (= BRAND_TEXT) · หมึกรอง #e0bda4 ·
// **หัวข้อ + <strong> = #f27a1a ส้มเพลิง** (6.6:1 บนการ์ด · 7.1:1 บนพื้นเพจ) ·
// ทองอำพัน #e5a92b · เงินโครเมียม #c9d2dc
// 🚨🚨 **#5a2410 กับ #8a3a12 ห้ามถือตัวอักษรเด็ดขาด** — เส้น/ขอบ/ออรา/พื้นถมเท่านั้น
// 🚨🚨 **ZNOVA168 (เจ้าของเดิมของ NavbarStyle9) เป็นน้ำตาลเข้ม/อำพัน = ตระกูลสี
// เดียวกับรอบนี้เป๊ะ** — "เจอส้ม/ทอง" ไม่เคยพิสูจน์ว่าเป็นของรอบนี้ ต้องเทียบให้
// ตรงหกหลัก ลิสต์เฮกซ์เต็มของทุกแบรนด์อยู่ที่ brand-spec §2
// ✅ LINE green 00B900 กับเขียว success ของฟีดเป็นสีเชิงความหมาย **คงไว้
// ห้ามกลืนเข้าพาเลตส้มของรอบนี้**
//
// ย่อหน้าในไฟล์นี้ไม่ถือคลาสสีหรือขนาดของตัวเอง — ทุก ContentBox* ในมิกซ์นี้ตั้ง
// `text-left text-base leading-relaxed` + หมึก #fdf0e6 ไว้บน element ที่ถือ slot
// อยู่แล้ว และไม่มี `<p>` ไหนมี mx-auto / max-w-* (การ์ดคุมความกว้างเองแล้ว)
//
// ⚠️ ชื่อแบรนด์รอบนี้เป็น **ตัวละตินพิมพ์ใหญ่ WIN ติดเลข 8 ติด S เป็นคำเดียว
// ห้าเคอแรกเตอร์** แต่ยัง interpolate จาก `${BRAND_NAME}` ทุกจุดรวมถึงใน alt
// **ห้ามพิมพ์ชื่อแบรนด์เป็นตัวอักษรตรงๆ ที่ไหนเลย** ไม่มีโดเมนเขียนไว้ที่ไหน
// และไม่มี URL ที่ต่อด้วย `+`
//
// <strong> ทุกตัวคร่อม "ก้อนที่คั่นด้วยช่องว่าง" ทั้งก้อน เพราะภาษาไทยไม่มีช่องว่าง
// ระหว่างคำ — อ่านคอปปี้โดยถอดแท็กออกต้องได้ข้อความของบรีฟเป๊ะ
//
// บรีฟรอบนี้ **โฆษณาและกำกับในย่อหน้าเดียวกัน** (brand-spec §5): หัวข้อเขียนว่า
// คาสิโนเล่นบาคาร่า · ทางเข้าเล่น · เกมเดิมพันสด · ทุกค่ายดัง · ลิขสิทธิ์แท้จากเมกา ·
// เล่นง่าย · ไม่หักเปอร์เซ็นต์ · เซิร์ฟนอก · ปลอดภัย100% · โบนัสไม่อั้น ขณะที่
// ย่อหน้าของบรีฟเองตอบกลับว่า ควรตรวจสอบหลักฐานการได้รับอนุญาตและชื่อบริษัท ·
// การใช้เซิร์ฟเวอร์ต่างประเทศไม่ได้รับประกันความปลอดภัยของข้อมูลหรือความถูกต้อง
// ตามกฎหมายในไทย · โปรโมชั่นคืนยอดเสียไม่ได้รับประกันว่าจะได้รับเงินคืนจากทุกการ
// เดิมพัน · เกมคาสิโนมีความเสี่ยงและไม่สามารถรับประกันผลรางวัลได้ — **ship ทั้งสอง
// ครึ่งตรงตามที่บรีฟเขียน ไม่ขยายคำโฆษณาเป็นคำกล่าวอ้างใหม่ และทุกประโยคกำกับ
// ship ครบ ไม่ตัดเพราะฟังดูลบ**
// 🚨🚨 **หมวดเกมรอบนี้มีสามหมวด ไม่ใช่เจ็ด**: บาคาร่าออนไลน์ · คาสิโนสด · สล็อต
// ❌ **ไฮโล · รูเล็ต · ยิงปลา · เดิมพันฟุตบอล/บอล · หวย/หวยออนไลน์ ไม่มีในบรีฟรอบนี้
// เลยสักคำ** (ทั้งห้าเป็นของ 123BET รอบก่อนทันที — ห้ามสืบทอดลิสต์ข้ามรอบ)
// ❌ **ไม่มีหมวดฝากถอน/ธนาคาร/วอลเลท** — ไม่มี ฝากถอน · ออโต้ · ทรูวอลเลท ·
// ทุกธนาคาร · ไม่มีขั้นต่ำ (คำหลังเป็นของ 123BET ไม่ใช่ของบรีฟนี้)
// ตัวเลขบนหน้านี้มีแค่ของบรีฟเอง: **0.3% · 0.8% · 100% · 3 ขั้นตอน · 24ชม.**
// ❌ ไม่มีจำนวนสมาชิก ไม่มีปีก่อตั้ง ไม่มีค่า RTP ไม่มีจำนวนค่าย/เกม ไม่มียอดขั้นต่ำ
// 🚨 สามคำนี้ **กลับทิศจากรอบก่อน** และเป็นถ้อยคำของบรีฟรอบนี้เอง (บรรทัด 1-2, 5):
// `เซิร์ฟนอก` · `ปลอดภัย100%` · `ลิขสิทธิ์แท้จากเมกา` — **ห้ามลบออกเพราะอ่าน
// คอมเมนต์เก่าในไฟล์ inventory แล้วเข้าใจผิด** (spec ของ 123BET แบน "เซิร์ฟนอก"
// ไว้ในฐานะคำของ TEVA69 และเขียนว่าไม่มี 100% — รอบนี้กลับกัน)
// ❌ คำของแบรนด์ก่อนห้ามเขียนกลับเข้ามา: 123BET / เจ้าของบาคาร่าสล็อต / เว็บตรง /
// ถูกลิขสิทธิ์ / เซิร์ฟแท้ / ปลอดภัยในไทย / ครบทุกค่าย / ไม่มีขั้นต่ำ /
// อัปเดตใหม่ตลอดสัปดาห์ (ขาออกทันที — สังเกตว่า "เซิร์ฟแท้"/"ปลอดภัยในไทย" ต่างจาก
// "เซิร์ฟนอก"/"ปลอดภัย100%" ของรอบนี้แค่คำท้าย ต้องอ่านให้ครบคำ) · ZORO365 /
// เกมคาสิโนสายตรง / เว็บจ่ายเต็ม / ไม่มีโกง · TEVA69 · LOTTO189 · ZANE96 ·
// ZNOVA168 / ฟรีสปิน / ค่า RTP · MEXICANOSLOT / การันตีเว็บตรง · okkub88 /
// ยูสใหม่แตกไว / ทรูวอลเลท · รวยเทพ168 · เว็บตรงแตกง่าย / เบทต่ำ / ไม่ทำเทิร์น
//
// title/description = บรรทัด 1-2 ของบรีฟ **verbatim** (src/assets/content.txt)
// ส่งที่นี่เพราะ pageGraph ต้องใช้สตริงเดียวกับที่ MainLayout ได้รับ
// **ห้ามต่อเติม** (description = 135 ตัวอักษร ตามที่บรีฟเขียนมาเอง และ
// verify-build ยกเว้นเพดานล่าง 150 ให้หน้าแรกไว้ด้วยเหตุผลนี้โดยเฉพาะ)
const pageTitle = `${BRAND_NAME} คาสิโนเล่นบาคาร่า ลิขสิทธิ์แท้จากเมกา เซิร์ฟนอก ปลอดภัย100%`;

const pageDescription = `${BRAND_NAME} คาสิโนเล่นบาคาร่า ทางเข้าเล่น เกมเดิมพันสด ทุกค่ายดัง การันตีลิขสิทธิ์แท้จากเมกา เล่นง่าย ไม่หักเปอร์เซ็นต์ เซิร์ฟนอก ปลอดภัย100%`;

// บรรทัด 3 ของบรีฟ ซึ่ง **ต่างจากบรรทัด 1** — ใช้ตามบรีฟ ไม่ copy title
const pageH1 = `${BRAND_NAME} คาสิโนเล่นบาคาร่า ทางเข้าเล่น เกมเดิมพันสด ทุกค่ายดัง`;

// บรีฟรอบนี้มีชั้น H1 -> H2 -> H3 จริง จึง **ไม่** แบนเป็น H2 ล้วน
//
// checklist ตามลำดับเอกสาร (brand-spec §4) และตัวที่รับแต่ละข้อ:
//    1 H1  <แบรนด์> คาสิโนเล่นบาคาร่า ทางเข้าเล่น เกมเดิมพันสด ทุกค่ายดัง
//          ContentBoxPremium, ย่อหน้าบรรทัด 4
//    2 H2  การันตี <แบรนด์> ลิขสิทธิ์แท้จากเมกา เล่นง่าย ไม่หักเปอร์เซ็นต์ เซิร์ฟนอก ปลอดภัย100%
//          ContentBoxTwoNeumorphism, บรรทัด 6 แบ่งสองซีกโดยไม่ตกประโยคไหน
//          + ProviderGridPremium ต่อท้ายทันที (วิดเจ็ตหมวดเกมของหัวข้อนี้โดยตรง)
//    3 H2  โปรโมชั่นคาสิโนเว็บ <แบรนด์> โบนัสไม่อั้น
//          ContentBoxFloatingBadge, บรรทัด 8
//    4 H3  โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน
//          ContentBoxSevenThreePremium + slide1 ในสล็อตขวา, บรรทัด 10
//    5 H3  โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด
//          ContentBoxSevenThreeNeumorphism + slide2 ในสล็อตขวา, บรรทัด 12
//    6 H2  สมัครเล่น <แบรนด์> บาคาร่า สล็อต ครบ
//          ContentBox3ThreeCyberCut, intro (บรรทัด 14) เข้า default slot และ
//          ขั้นตอน 1/2/3 (บรรทัด 15-20) เข้า left/center/right
//    7 H2  แอดมิน <แบรนด์> ออนไลน์ตลอด 24ชม.
//          ContentBoxTwoCyberCut (**ส่ง as="h2" ชัดเจน** default ของมันเป็น "p"),
//          บรรทัด 22 แบ่งสองซีก
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ <แบรนด์>
//          Faq2 + prop faqs ชัดเจน (**ส่ง as="h2"**), บรรทัด 24-29
// inventory ที่ต้องได้: **h1 ×1 · h2 ×5 · h3 ×2** — ตรงเป้าของ brand-spec §4
//
// ⚠️ จุดที่ชั้น heading รั่วได้ และกันไว้แล้วทุกจุด: บรรทัด 15/17/19 ของบรีฟ
// (ขั้นตอนที่ 1/2/3) **ไม่มี prefix H** จึงส่งเข้า titleleft/titlecenter/titleright
// ของ ContentBox3ThreeCyberCut โดย **ไม่ส่ง `heading`** (default false -> <p>) ·
// **ไม่ส่ง titleright ให้ ContentBoxTwoNeumorphism, ContentBoxTwoCyberCut และ
// SevenThree ทั้งสองใบ** คอลัมน์ภาพและซีกขวาจึงไม่มี heading ·
// คำถามใน Faq2 เป็น <span> ใน <summary> ไม่ใช่ heading
// grep `<h[1-6]` ในทุก component ที่ไฟล์นี้เรียกแล้วรอบนี้ — ไม่มีตัวไหน hardcode
// heading ไว้เลย ทุกแท็ก heading บนหน้ามาจาก prop คือมาจากบรีฟ
// chrome บนหน้านี้ (AnnouncementPremium · ProviderGridPremium · LatestWinners4 ·
// ReviewCardSumo · Navfoot) ขึ้นป้ายเป็น <p>/<span> พร้อม aria-label บน <section>
// **ห้ามเลื่อน <p> พวกนั้นขึ้นเป็น h2 เพื่อ "แก้ชื่อที่ขาด"**
//
// ── รูปภาพ ────────────────────────────────────────────────────────────────
// รอบนี้ใช้ **สองใบ** และอยู่ในตระกูล SevenThree ทั้งคู่ (playbook ตรึง slide* ไว้
// กับตระกูลนี้ และเพดานคือ 2 บล็อก — รอบนี้ใช้ครบพอดี ไม่มีใบที่สาม)
// **ข้อความที่พิมพ์บนอาร์ตเวิร์กคือตัวตัดสินการจับคู่ ไม่ใช่ลำดับไฟล์** (เปิดอ่าน
// บิตแมปจริงแล้วรอบนี้ และครอปซูมดูเวิร์ดมาร์กด้วย):
//   slide1.png พิมพ์ **คืนยอดเสีย 0.3%** และมี **ร่มกระดาษแดง-ขาว** -> §4
//   slide2.png พิมพ์ **แนะนำเพื่อน 0.8%** และมี **พัดพับแดง-ขาว** -> §5
// ⚠️⚠️ **กลับข้างจากรอบก่อน** (123BET ใช้ slide1 = แนะนำเพื่อน) — uploader เขียนทับ
// สองไฟล์นี้ทุกดรอป การจับคู่จึงไม่มีความหมายข้ามแบรนด์ **ห้ามลอกจากรอบก่อน**
// หน้า /promotion ก็จับคู่ชุดเดียวกันนี้ (slide1 = คืนยอดเสีย มาก่อน)
//
// 🚨🚨🚨 **ปัญหาของอาร์ตเวิร์กดรอปนี้ที่ต้องแจ้ง operator — แก้ด้วยโค้ดไม่ได้**
// เปิดบิตแมปจริงและครอปซูมแล้ว: **ตราสัญลักษณ์บน slide1 / slide2 / og.png และ
// ตราเล็กมุมขวาบนของ banner1 ยังเป็นเวิร์ดมาร์กของแบรนด์ขาออก (123BET)** ส่วน
// `src/assets/logo.webp` กับ `public/logo.webp` เป็นโลโก้ของแบรนด์ขาออก **ทั้งใบ**
// มีแต่เวิร์ดมาร์กตัวใหญ่กลาง banner1 เท่านั้นที่เป็นของแบรนด์รอบนี้จริง
// → **ต้องให้ operator อัปอาร์ตเวิร์กชุดใหม่ที่ไม่มีตราของแบรนด์เก่า** ก่อน deploy
// → ระหว่างนี้ `alt` ของสองใบนี้จึงบรรยาย **รูปทรงและวัสดุของตรา** โดย
//    **ไม่ระบุว่าเป็นตราของแบรนด์ใด** — เขียนว่าเป็นโลโก้ ${BRAND_NAME} จะเป็น
//    คำบรรยายที่ไม่ตรงกับรูป และพิมพ์ชื่อแบรนด์เก่าลง alt ก็คือการ ship ชื่อแบรนด์
//    เก่าขึ้นเว็บใหม่ ซึ่งเป็นสิ่งที่ playbook ทั้งเล่มมีไว้เพื่อกัน
// ⛔ **banner1 / banner1-mobile / og.png เป็นของ MainLayout** (glob ปักชื่อไว้แล้ว)
// และ **banner2.png / banner3.png (10-23) / slide3.png / slide4.png (09-29) เป็น
// อาร์ตเวิร์กของแบรนด์อื่น ห้าม import เด็ดขาด** เพราะ eager import = emit ขึ้น
// dist ทุก build แม้ไม่มีหน้าไหน render และ verify-build.mjs จะแดงถ้ามีรูปที่ไม่ได้
// ถูก render
// ⚠️ ไม่มีภาพไหนบนหน้านี้เป็น LCP (hero อยู่ที่ MainLayout) จึง **ไม่มี
// loading="eager" / fetchpriority="high"** สักใบ สไลด์ทั้งสองอยู่ใต้ fold
//
// `widths`/`sizes` คำนวณจากเรขาคณิตจริงของคอลัมน์ภาพ (3fr ฝั่งขวา) ของ **variant
// ที่ถือรูปใบนั้นจริง ๆ** — สองชุดนี้ **สลับกันไม่ได้** และ **ไม่ได้ลอกจากรอบก่อน**
// (รอบก่อนคิดจาก ContentBoxSevenThree ตัวฐาน + ContentBoxSevenThreeCyberCut ซึ่ง
// เป็นคนละไฟล์กับรอบนี้ทั้งคู่) ตัวเลขชุดนี้ยกมาจากคอมเมนต์ที่คำนวณไว้ในตัว
// component เอง ถ้าแก้ padding/border/gap/max-w ที่นั่นต้องแก้ที่นี่ด้วย
// บิตแมปจริงของดรอปนี้ **375x600 ทั้งสองใบ** เพดานจึงเป็น **375 และห้ามมี
// candidate ไหนเกิน 375** เพราะเกินกว่านั้นคือการอัพสเกล
//
// §4 ContentBoxSevenThreePremium — max-w-7xl · md:p-10 · gap-10 · คอลัมน์ภาพจ่าย
//   md:border-l(1) + md:pl-10(40) = 41
//   >=1280px : (1280 - 32 - 2 - 80 - 40) x 0.3 - 41 = 1126 x 0.3 - 41 = 297px
//   768-1279 : (100vw - 154) x 0.3 - 41             = calc(30vw - 87px)
//   473-767  : ยุบเหลือคอลัมน์เดียวที่ p-8 -> 100vw - 98 ซึ่ง >= 375 จึงติดเพดาน = 375px
//   < 473    : คอลัมน์เดียวที่ p-8                   = calc(100vw - 98px)
// candidate: 143 = ค่าต่ำสุดของแบนด์ md (ที่ 768px) · 277 = 100vw-98 ที่จอ 375px ·
//   297 = 1x ที่ >= 1280px · 375 = **เพดานบิตแมปจริง**
const cashbackWidths = [143, 277, 297, 375];
const cashbackSizes = "(min-width: 1280px) 297px, (min-width: 768px) calc(30vw - 87px), (min-width: 473px) 375px, calc(100vw - 98px)";

// §5 ContentBoxSevenThreeNeumorphism — **max-w-[1400px]** (ไม่ใช่ max-w-7xl) ·
//   md:p-10 · gap-8 · คอลัมน์ภาพจ่าย md:border-l(1) + md:pl-8(32) = 33
//   >=1400px : (1400 - 32 - 2 - 80 - 32) x 0.3 - 33 = 1254 x 0.3 - 33 = 343px
//   768-1399 : (100vw - 146) x 0.3 - 33             = calc(30vw - 77px)
//   473-767  : คอลัมน์เดียวที่ p-8 -> 100vw - 98 ซึ่ง >= 375 จึงติดเพดาน = 375px
//   < 473    : คอลัมน์เดียวที่ p-8                   = calc(100vw - 98px)
// candidate: 154 = ค่าต่ำสุดของแบนด์ md (ที่ 768px) · 277 = 100vw-98 ที่จอ 375px ·
//   343 = 1x ที่ >= 1400px · 375 = **เพดานบิตแมปจริง**
// ⚠️ ต่างจาก §4 ที่ 1x ถึง 46px — **ห้ามลอกตัวเลขข้ามไฟล์**
const referralWidths = [154, 277, 343, 375];
const referralSizes = "(min-width: 1400px) 343px, (min-width: 768px) calc(30vw - 77px), (min-width: 473px) 375px, calc(100vw - 98px)";

// บรรยายจากบิตแมปจริงของดรอปนี้ (เปิดอ่านด้วย Read + ครอปซูมแล้ว) **ไม่ใช่คัดลอก
// ของรอบก่อน** ภาษาภาพของ 123BET ที่ **ไม่มี** ในสองรูปนี้เลย — โถงวังหินอ่อน
// สีงาช้างที่มีเสาและซุ้มโค้ง · ชุดราตรีแดง-ขาวปักทอง · มงกุฎทองประดับอัญมณีแดงที่
// สวมบนศีรษะ · กำมะหยี่แดง · ชิปคาสิโนแดง-ขาว
// ✅ สิ่งที่มีจริงในดรอปนี้: ห้องญี่ปุ่นโทนขาวงาช้าง · กิ่งซากุระชมพู-ขาว ·
// กิโมโนลายดอกไม้แดง-ขาว · เครื่องประดับผมแดง-ขาวพร้อมพู่ทอง · ร่ม (slide1) และ
// พัด (slide2) · ตราสัญลักษณ์พื้นดำที่มีเสาโทริอิและมังกร
// 🚨 **ตราสัญลักษณ์ในสองรูปนี้เป็นของแบรนด์ขาออก** (ดูบล็อกเตือนด้านบน) จึงบรรยาย
// เป็น "ตราสัญลักษณ์" ตามรูปทรงและวัสดุ **โดยไม่อ้างว่าเป็นโลโก้ของแบรนด์ใด**
const cashbackAlt = `โปสเตอร์โปรโมชั่นแนวตั้ง ฉากเป็นห้องสไตล์ญี่ปุ่นโทนขาวงาช้างที่มีกิ่งซากุระชมพู-ขาวและผ้าม่านโปร่ง หญิงสาวผมยาวสีน้ำตาลเกล้าผมประดับดอกไม้แดง-ขาวพร้อมพู่ทอง สวมกิโมโนลายดอกไม้แดง-ขาว มือขวาถือร่มกระดาษญี่ปุ่นสีแดง-ขาวที่กางอยู่ด้านหลัง มุมขวาบนเป็นตราสัญลักษณ์พื้นดำทรงกลมที่มีเสาโทริอิและมังกรพันอยู่ โดยมีเวิร์ดมาร์กสามมิติวางทับ ครึ่งแรกเป็นผิวส้มเพลิงไล่ทองตัดขอบดำ ครึ่งหลังเป็นผิวโครเมียมเงินขัดเงา กลางภาพพิมพ์คำว่า โปรโมชั่น เป็นตัวอักษรสามมิติผิวแดงเคลือบเงาตัดขอบทอง ถัดลงมาเป็นแถบแคปซูลพื้นดำขอบทองที่เขียนว่า คืนยอดเสีย แล้วตามด้วยตัวเลข 0.3% ตัวโตผิวแดงเคลือบเงาตัดขอบทอง ปิดท้ายด้วยแคปซูลพื้นขาวขอบทองที่เขียนว่า สมัครสมาชิก พร้อมไอคอนรูปคนกับเครื่องหมายบวกและลูกศรคู่`;

const referralAlt = `โปสเตอร์โปรโมชั่นแนวตั้งในห้องสไตล์ญี่ปุ่นโทนขาวงาช้างเดียวกัน มีกิ่งซากุระชมพู-ขาวอยู่ทั้งสองข้าง หญิงสาวผมยาวสีน้ำตาลเกล้าผมประดับดอกซากุระขาว-ชมพูพร้อมพู่ทอง สวมกิโมโนลายดอกไม้แดง-ขาวคาดโอบิทอง มือถือพัดพับสีแดง-ขาวที่คลี่อยู่ระดับไหล่ มุมขวาบนเป็นตราสัญลักษณ์พื้นดำทรงกลมที่มีเสาโทริอิและมังกรพันอยู่ โดยมีเวิร์ดมาร์กสามมิติวางทับ ครึ่งแรกเป็นผิวส้มเพลิงไล่ทองตัดขอบดำ ครึ่งหลังเป็นผิวโครเมียมเงินขัดเงา กลางภาพมีแถบสีทองสาดเป็นพื้นหลังของคำว่า โปรโมชั่น ซึ่งเป็นตัวอักษรสามมิติผิวแดงเคลือบเงาตัดขอบทอง ถัดลงมาเป็นแถบแคปซูลพื้นดำขอบทองที่เขียนว่า แนะนำเพื่อน แล้วตามด้วยตัวเลข 0.8% ตัวโตผิวแดงเคลือบเงาตัดขอบทอง ปิดท้ายด้วยแคปซูลพื้นขาวขอบทองที่เขียนว่า สมัครสมาชิก พร้อมไอคอนรูปคนกับเครื่องหมายบวกและลูกศรคู่`;

// อาร์เรย์เดียว ใช้ทั้งกับ <Faq> และโน้ด FAQPage — ไม่ใช้ default ของ component
// (Faq2 ตั้งใจ ship เป็นลิสต์ว่าง prop ที่ลืมส่งจึงได้ accordion เปล่า ไม่ใช่
// คำถามของแบรนด์ก่อน) สามคู่นี้คือบล็อก Q/A ของบรีฟเอง (content.txt บรรทัด 24-29)
// ตรงตัว ตัดเฉพาะหมายเลข "1." "2." "3." ออกเพราะ accordion เป็นตัวลิสต์อยู่แล้ว
// ทุกคำตอบคงประโยคกำกับของบรีฟไว้ครบ — เป็นเนื้อหาของบรีฟทั้งสองครึ่ง
const faqs = [
  {
    q: `${BRAND_NAME} มีเกมคาสิโนประเภทไหนให้เลือกบ้าง?`,
    a: `ตามข้อมูลที่ระบุ ${BRAND_NAME} นำเสนอเกมบาคาร่าออนไลน์ เกมคาสิโนสด และเกมสล็อตจากค่ายต่าง ๆ โดยควรตรวจสอบรายชื่อเกมและผู้ให้บริการที่เปิดใช้งานจริงจากเว็บไซต์`,
  },
  {
    q: `${BRAND_NAME} มีโปรโมชั่นคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% หรือไม่?`,
    a: `ตามข้อมูลที่ระบุ มีโปรโมชั่นทั้งสองรายการ โดยควรตรวจสอบประเภทเกมที่เข้าร่วม รอบคำนวณยอด และเงื่อนไขการรับเครดิตจากประกาศล่าสุดก่อนใช้สิทธิ์`,
  },
  {
    q: `${BRAND_NAME} เป็นคาสิโนลิขสิทธิ์จากสหรัฐอเมริกาและไม่หักเปอร์เซ็นต์จริงหรือไม่?`,
    a: `ยังไม่สามารถยืนยันได้จากข้อความโฆษณาเพียงอย่างเดียว ควรตรวจสอบหลักฐานลิขสิทธิ์จากหน่วยงานที่เกี่ยวข้อง รวมถึงกติกาและอัตราค่าคอมมิชชันของเกมบาคาร่าแต่ละประเภทก่อนใช้งาน`,
  },
];

// ไม่มี breadcrumb: นี่คือหน้าแรก เส้นทางจาก root มาหาตัวเองจะเหลือครั้งเดียวที่ชี้ตัวเอง
// ทุก URL ในกราฟมาจาก pageGraph ที่ derive จาก site: — ไม่มีโดเมนพิมพ์ไว้ในไฟล์นี้
// ไม่มี URL ที่ต่อด้วย `+` และไม่ส่งโน้ด Review / AggregateRating / sameAs /
// address / email เข้าไปเลย
// `description` เป็นสตริงเดียวกับที่ MainLayout ได้รับ `name` เป็น H1 ของหน้า และ
// `faqs` เป็นอาร์เรย์ตัวเดียวกับที่ <Faq> ได้รับ
const graph = pageGraph(Astro, {
  name: pageH1,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxPremium as="h1" title={pageH1}>
    <p>
      {BRAND_NAME}
      <strong class="text-[#f27a1a]">นำเสนอข้อมูลคาสิโนออนไลน์ที่รวบรวมเกมบาคาร่าและเกมสล็อตจากค่ายต่าง ๆ</strong>
      พร้อมรายละเอียดเกมเดิมพันสด ระบบสมาชิก และโปรโมชั่นภายในเว็บไซต์เดียว ผู้ใช้งานสามารถศึกษากติกาบาคาร่าสด รูปแบบการเดิมพัน และเงื่อนไขของแต่ละเกมผ่านมือถือได้ โดยควรตรวจสอบรายชื่อผู้ให้บริการเกมและความน่าเชื่อถือของแพลตฟอร์มก่อนใช้งาน
      <strong class="text-[#f27a1a]">เพราะเกมคาสิโนมีความเสี่ยงและไม่สามารถรับประกันผลรางวัลได้</strong>
    </p>
  </ContentBoxPremium>

  <ContentBoxTwoNeumorphism as="h2" title={`การันตี ${BRAND_NAME} ลิขสิทธิ์แท้จากเมกา เล่นง่าย ไม่หักเปอร์เซ็นต์ เซิร์ฟนอก ปลอดภัย100%`}>
    <p slot="left">
      {BRAND_NAME}
      <strong class="text-[#f27a1a]">ระบุว่าให้บริการเกมคาสิโนผ่านระบบเซิร์ฟเวอร์ต่างประเทศ</strong>
      พร้อมนำเสนอข้อมูลเกี่ยวกับลิขสิทธิ์เกมจากสหรัฐอเมริกาและรูปแบบการเดิมพันที่ไม่หักเปอร์เซ็นต์
    </p>
    <p slot="right">
      อย่างไรก็ตาม
      <strong class="text-[#f27a1a]">ผู้ใช้งานควรตรวจสอบหลักฐานการได้รับอนุญาต ชื่อบริษัทผู้ให้บริการ และกติกาการคิดค่าธรรมเนียมให้ชัดเจน</strong>
      โดยเฉพาะบาคาร่าแต่ละรูปแบบที่อาจมีอัตราจ่ายหรือค่าคอมมิชชันแตกต่างกัน ทั้งนี้
      <strong class="text-[#f27a1a]">การใช้เซิร์ฟเวอร์ต่างประเทศไม่ได้รับประกันความปลอดภัยของข้อมูลหรือความถูกต้องตามกฎหมายในไทย</strong>
    </p>
  </ContentBoxTwoNeumorphism>

  <ProviderGrid />

  <ContentBoxFloatingBadge as="h2" title={`โปรโมชั่นคาสิโนเว็บ ${BRAND_NAME} โบนัสไม่อั้น`}>
    <p>
      {BRAND_NAME} นำเสนอข้อมูลโปรโมชั่นสำหรับสมาชิก
      <strong class="text-[#f27a1a]">โดยมีรายการคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8% เป็นสิทธิพิเศษที่ระบุไว้</strong>
      ผู้ใช้งานควรตรวจสอบรายละเอียดโปรโมชั่นแต่ละรายการ ทั้งประเภทเกมที่เข้าร่วม ยอดที่นำมาคำนวณ รอบเวลารับเครดิต และข้อกำหนดการถอนเงิน
      <strong class="text-[#f27a1a]">แม้เว็บไซต์จะใช้ข้อความว่าโบนัสไม่อั้น แต่ควรศึกษาวงเงินสูงสุดและเงื่อนไขจากประกาศล่าสุดก่อนรับสิทธิ์</strong>
    </p>
  </ContentBoxFloatingBadge>

  <ContentBoxSevenThreePremium as="h3" title="โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน">
    <p slot="left">
      โปรโมชั่นคืนยอดเสีย 0.3%
      <strong class="text-[#f27a1a]">เป็นรายการที่ระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขรายวัน</strong>
      สมาชิกควรตรวจสอบว่าบาคาร่าสดหรือเกมสล็อตประเภทใดเข้าร่วมรายการ รวมถึงรอบเวลาสรุปยอดและวิธีรับเครดิตให้ครบถ้วน เพราะการเดิมพันบางรายการอาจไม่เข้าเกณฑ์รับสิทธิ์ นอกจากนี้ควรศึกษาข้อกำหนดการใช้โบนัสและการถอนเงินก่อนรับเครดิต
