---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThreeHuay from "../components/ContentBoxSevenThreeHuay.astro";
import ContentBoxTwoHuay from "../components/ContentBoxTwoHuay.astro";
import LottoGrid from "../components/LottoGrid.astro";
import FaqHuay from "../components/FaqHuay.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import LatestWinners from "../components/LatestWinnersHuay.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// Title and description are the brief's own Title/Description lines, verbatim.
// A brief-supplied description ships at whatever length it was written — it is
// not padded up to the 150-character floor. The brief's own line was 176
// characters, over the 160 upper bound verify-build enforces, so the one clause
// that repeats what the rest already says ("เปิดให้แทงก่อนใคร") is dropped —
// 158 characters. The floor is not binding here; the ceiling is.
const pageTitle = "HUAY928 รับแทงหวย รัฐบาลไทย ลาว ฮานอย ยี่กี่ หุ้น รับทุกเลข ไม่มีอั้น";

const pageDescription =
  "HUAY928 เปิดรับแทงหวยออนไลน์ ครบทุกประเภท ครอบคลุม รัฐบาลไทย ลาว ฮานอย ยี่กี่ หุ้น เปิดระบบแทง 2ตัวจ่าย100 และ 3ตัวจ่าย1,000 พร้อมรับทุกเลขเด็ด เลขดัง เลขอั้น";

// The ticker copy is passed explicitly rather than relying on the component's
// default — every Announcement* variant's default belongs to whichever brand
// wired it in last. No emoji in this string: an emoji baked into a text prop
// cannot be given its own aria-hidden span, and this marquee prints the string
// twice.
const announcement =
  "HUAY928 รับแทงหวยออนไลน์ จ่ายจริง ครบทุกรูปแบบ • ครอบคลุมหวยรัฐบาลไทย หวยลาว หวยฮานอย หวยยี่กี่ และหวยหุ้น ในระบบเดียว • รองรับเลข 2 ตัวและ 3 ตัวตามอัตราจ่ายที่กำหนด 2 ตัวจ่าย 100 และ 3 ตัวจ่าย 1,000 • เลือกเลข ตรวจเรท ส่งโพย และติดตามรายการผ่านมือถือได้ด้วยตัวเอง • ควรยึดอัตราจ่ายและวงเงินที่ระบบแสดง ณ เวลาส่งโพยเป็นหลัก • แอดมิน HUAY928 ออนไลน์ตลอด 24 ชั่วโมง";

// One array, used by both <FaqHuay> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last.
const faqs = [
  {
    q: "HUAY928 เปิดรับแทงหวยอะไรบ้าง?",
    a: "มีทั้งหวยรัฐบาลไทย หวยลาว หวยฮานอย หวยยี่กี่ และหวยหุ้น รวมถึงประเภทการเดิมพันที่เปิดในแต่ละรอบ สมาชิกควรตรวจสอบเวลาเปิด-ปิดและรายการล่าสุดจากหน้าแทงหวยก่อนส่งโพย",
  },
  {
    q: "HUAY928 เลข 2 ตัวจ่าย 100 และ 3 ตัวจ่าย 1,000 จริงหรือไม่?",
    a: "ตามเรทที่กำหนดในหน้านี้ เลข 2 ตัวใช้อัตราจ่าย 100 และเลข 3 ตัวใช้อัตราจ่าย 1,000 แต่ก่อนเดิมพันควรยึดอัตราจ่ายที่แสดงในระบบ ณ เวลาส่งโพยเป็นหลัก โดยเฉพาะเลขหรือรอบที่อาจมีเงื่อนไขเฉพาะ",
  },
  {
    q: "หากแทงหวยหรือฝากถอน HUAY928 มีปัญหาต้องทำอย่างไร?",
    a: "ตรวจสอบสถานะรายการในบัญชีก่อน หากโพย เครดิต หรือรายการถอนยังผิดปกติ ให้ติดต่อแอดมิน HUAY928 พร้อมแจ้งประเภทหวย เวลา จำนวนเงิน และรายละเอียดรายการ เพื่อให้เจ้าหน้าที่ช่วยตรวจสอบได้รวดเร็วยิ่งขึ้น",
  },
];

// The two rate tables the brief asks for as HTML tables rather than pictures —
// Google reads the numbers straight out of the markup and a phone can read them
// without pinching. Rows are the brief's own, verbatim.
const twoDigitRows = [
  ["หวย 2 ตัว", "28", "1 บาท", "100 บาท"],
  ["หวย 2 ตัว", "56", "10 บาท", "1,000 บาท"],
  ["หวย 2 ตัว", "89", "100 บาท", "10,000 บาท"],
];

const threeDigitRows = [
  ["หวย 3 ตัว", "289", "1 บาท", "1,000 บาท"],
  ["หวย 3 ตัว", "928", "10 บาท", "10,000 บาท"],
  ["หวย 3 ตัว", "168", "100 บาท", "100,000 บาท"],
];

const tableWrap = "overflow-x-auto rounded-2xl border border-[#2c4d84]/70 bg-[#01091b]/60";
const tableClass = "w-full min-w-[520px] border-collapse text-left text-sm";
const thClass = "border-b border-[#dfb455]/40 px-4 py-3 text-[13px] font-black tracking-wide text-[#fdf1cd] uppercase";
const tdClass = "border-b border-[#1d3a68]/60 px-4 py-3 text-[#d5e3f7]";
const tdStrongClass = "border-b border-[#1d3a68]/60 px-4 py-3 font-black text-[#f7d979]";

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb. Every URL in the graph is derived
// by pageGraph from `site:` — no domain is typed out in this file.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <ContentBoxPremium as="h1" title="HUAY928 รับแทงหวยออนไลน์ จ่ายจริง ครบทุกรูปแบบ">
    <p class="text-left text-base leading-relaxed text-[#d5e3f7]">
      <strong class="text-[#fdf1cd]">HUAY928</strong> เปิดให้บริการแทงหวยออนไลน์หลายประเภทผ่านระบบเดียว ครอบคลุมทั้งหวยรัฐบาลไทย หวยลาว หวยฮานอย หวยยี่กี่ และหวยหุ้น
      พร้อมรองรับการเดิมพันเลข 2 ตัวและ 3 ตัวตามอัตราจ่ายที่กำหนด สมาชิกสามารถเลือกเลข ตรวจสอบเรท ส่งโพย และติดตามรายการผ่านมือถือได้ด้วยตัวเอง พร้อมแอดมินคอยดูแลเรื่องการสมัคร ฝากถอน
      และปัญหาการใช้งานตลอด 24 ชั่วโมง
    </p>
  </ContentBoxPremium>

  <ContentBoxSevenThreePremium as="h2" title="HUAY928 ให้บริการ แทงหวยรัฐบาลไทย ลาว ฮานอย ยี่กี่ หุ้น ไม่จำกัดยอด">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 28vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นคืนยอดเสียของ HUAY928 พื้นหลังสีน้ำเงินกรมท่าประดับเส้นโค้งสีทอง ด้านบนเป็นโลโก้ HUAY928 กลางภาพเป็นข้อความสีขาวว่า โปรโมชั่น คืนยอดเสีย พร้อมตัวเลขทองขนาดใหญ่ 0.3% ด้านซ้ายเป็นใบสลากสามใบติดป้าย รัฐบาลไทย ลาว และ ฮานอย ด้านขวาเป็นผู้หญิงผมสีเงินในชุดสีทองน้ำเงินชี้นิ้วขึ้น ด้านล่างมีไอคอนห้าช่องเขียนว่า รัฐบาลไทย ลาว ฮานอย ยี่กี่ หุ้น และแถบล่างสุดเขียนว่า รับทุกเลข ไม่มีอั้น"
      class="mx-auto h-auto w-full rounded-2xl border border-[#dfb455]/50 shadow-[0_10px_30px_rgba(223,180,85,0.28)]"
    />
    <div slot="right" class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d5e3f7]">
      <p>
        <strong class="text-[#fdf1cd]">HUAY928</strong> รวมหวยหลายประเภทไว้ให้เลือกตามรอบที่เปิดรับ ไม่ว่าจะเป็นหวยรัฐบาลไทย หวยลาว หวยฮานอย หวยยี่กี่ หรือหวยหุ้น
        สมาชิกสามารถเลือกประเภทหวยและรอบที่ต้องการ จากนั้นกรอกเลขและยอดเดิมพันผ่านระบบได้โดยตรง ก่อนส่งโพยควรตรวจสอบเวลาเปิด-ปิด อัตราจ่าย <span class="font-black text-[#8fc3ec]">เลขอั้น</span>
        และวงเงินที่ระบบแสดง เนื่องจากรายละเอียดของหวยแต่ละประเภทและแต่ละรอบอาจแตกต่างกัน
      </p>
      <p>สำหรับข้อความว่า “ไม่จำกัดยอด” ควรยึดวงเงินที่หน้าแทงแสดง ณ เวลาทำรายการเป็นหลัก เพื่อป้องกันความคลาดเคลื่อนหากเลขบางรายการมีการกำหนดวงเงินเฉพาะ</p>
    </div>
  </ContentBoxSevenThreePremium>

  <LottoGrid />

  <ContentBox as="h2" title="เว็บ HUAY928 ให้อัตราจ่ายสูง ไม่น้อยกว่าใคร">
    <div class="flex flex-col gap-6 text-left text-base leading-relaxed text-[#d5e3f7]">
      <p>
        จุดที่ควรแสดงให้ชัดบนหน้า <strong class="text-[#fdf1cd]">HUAY928</strong> คืออัตราจ่ายของเลข 2 ตัวและ 3 ตัว เพื่อให้สมาชิกเห็นข้อมูลก่อนส่งโพย โดยจากเรทที่กำหนดไว้ 2 ตัวจ่าย 100
        และ 3 ตัวจ่าย 1,000 สามารถทำเป็นตารางบนหน้าเว็บเพื่อให้อ่านง่ายทั้งบนคอมพิวเตอร์และมือถือ
      </p>

      <h3 class="text-xl leading-normal font-black tracking-widest text-[#f7d979] uppercase">2 ตัวจ่าย 100</h3>

      <div class={tableWrap}>
        <table class={tableClass}>
          <thead class="bg-[#08234c]/80">
            <tr>
              <th scope="col" class={thClass}>ประเภทเดิมพัน</th>
              <th scope="col" class={thClass}>ตัวอย่างเลข</th>
              <th scope="col" class={thClass}>เดิมพันตัวอย่าง</th>
              <th scope="col" class={thClass}>อัตราจ่ายตามที่กำหนด</th>
            </tr>
          </thead>
          <tbody>
            {
              twoDigitRows.map(([type, number, stake, payout]) => (
                <tr class="transition-colors hover:bg-[#08234c]/50">
                  <td class={tdClass}>{type}</td>
                  <td class={tdStrongClass}>{number}</td>
                  <td class={tdClass}>{stake}</td>
                  <td class={tdStrongClass}>{payout}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p>ตัวอย่างการคำนวณ: หากอัตราจ่ายคือ 1 บาทต่อ 100 บาท การแทง 10 บาท เมื่อถูกรางวัลตามเงื่อนไขจะคำนวณเป็น 10 × 100 = 1,000 บาท</p>

      <p>อัตราจ่ายจริงควรยึดตัวเลขที่ระบบ <strong class="text-[#fdf1cd]">HUAY928</strong> แสดงก่อนยืนยันโพย เนื่องจากเลขบางรายการหรือหวยบางประเภทอาจมีเงื่อนไขแตกต่างกัน</p>

      <h3 class="text-xl leading-normal font-black tracking-widest text-[#f7d979] uppercase">3 ตัวจ่าย 1,000</h3>

      <div class={tableWrap}>
        <table class={tableClass}>
          <thead class="bg-[#08234c]/80">
            <tr>
              <th scope="col" class={thClass}>ประเภทเดิมพัน</th>
              <th scope="col" class={thClass}>ตัวอย่างเลข</th>
              <th scope="col" class={thClass}>เดิมพันตัวอย่าง</th>
              <th scope="col" class={thClass}>อัตราจ่ายตามที่กำหนด</th>
            </tr>
          </thead>
          <tbody>
            {
              threeDigitRows.map(([type, number, stake, payout]) => (
                <tr class="transition-colors hover:bg-[#08234c]/50">
                  <td class={tdClass}>{type}</td>
                  <td class={tdStrongClass}>{number}</td>
                  <td class={tdClass}>{stake}</td>
                  <td class={tdStrongClass}>{payout}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p>ตัวอย่างการคำนวณ: หากอัตราจ่ายคือ 1 บาทต่อ 1,000 บาท การแทง 10 บาท เมื่อถูกรางวัลตามเงื่อนไขจะคำนวณเป็น 10 × 1,000 = 10,000 บาท</p>
    </div>
  </ContentBox>

  <ContentBoxSevenThreeHuay titleright="สมัครแทงหวย HUAY928 ด้วยตัวเอง ไม่ต้องผ่านเจ้ามือ">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 28vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อนของ HUAY928 พื้นหลังสีน้ำเงินกรมท่าประดับเส้นโค้งสีทองและลูกบอลหวยเลข 9 เลข 3 เลข 8 ด้านบนเป็นโลโก้ HUAY928 กลางภาพเป็นข้อความสีขาวว่า โปรโมชั่น แนะนำเพื่อน พร้อมตัวเลขทองขนาดใหญ่ 0.8% ด้านขวาเป็นผู้หญิงผมสีเงินในชุดสีทองน้ำเงินชี้นิ้วขึ้น ด้านล่างมีไอคอนสี่ช่องเขียนว่า เพื่อนสมัคร เพื่อนเล่น รับโบนัส และ ถอนได้ไม่อั้น"
      class="mx-auto h-auto w-full rounded-2xl border border-[#dfb455]/50 shadow-[0_10px_30px_rgba(223,180,85,0.28)]"
    />
    <div slot="right" class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d5e3f7]">
      <p>ผู้ใช้งานใหม่สามารถสมัคร <strong class="text-[#fdf1cd]">HUAY928</strong> และเริ่มส่งโพยผ่านระบบออนไลน์ได้ด้วยตัวเอง โดยขั้นตอนไม่ซับซ้อนและรองรับการใช้งานผ่านมือถือ</p>
      <ol class="list-decimal space-y-2 pl-5 marker:font-black marker:text-[#f7d979]">
        <li>สมัครสมาชิก HUAY928 และกรอกข้อมูลตามที่ระบบกำหนด</li>
        <li>Login เข้าบัญชีและฝากเครดิตผ่านช่องทางที่เปิดให้บริการ</li>
        <li>เลือกหวยและรอบที่ต้องการ กรอกเลขกับยอดเดิมพัน ตรวจสอบเรท แล้วจึงยืนยันโพย</li>
      </ol>
      <p>
        หลังส่งโพยสามารถกลับมาตรวจสอบเลข ยอดเดิมพัน สถานะรายการ และประวัติโพยได้จากบัญชีสมาชิก ควรตรวจสอบข้อมูลให้เรียบร้อยก่อนกดยืนยัน
        เนื่องจากรายการที่ส่งสำเร็จแล้วอาจไม่สามารถแก้ไขได้ตามเงื่อนไขของระบบ
      </p>
    </div>
  </ContentBoxSevenThreeHuay>

  <ContentBoxTwoHuay titleleft="แอดมิน HUAY928 ให้บริการออนไลน์ 24 ชั่วโมง">
    <p slot="left" class="text-left text-base leading-relaxed text-[#d5e3f7]">
      หากพบปัญหาเกี่ยวกับการสมัคร Login ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง ส่งโพยไม่สำเร็จ หรือยอดเดิมพันแสดงไม่ถูกต้อง สามารถติดต่อแอดมิน
      <strong class="text-[#fdf1cd]">HUAY928</strong> ได้ตลอด 24 ชั่วโมง พร้อมแจ้งรายละเอียดและเวลาที่เกิดรายการ เพื่อช่วยให้เจ้าหน้าที่ตรวจสอบได้ตรงจุด
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#d5e3f7]">
      สมาชิกยังสามารถสอบถามเรื่องรอบหวย เวลาเปิดรับ อัตราจ่าย และวิธีใช้งานระบบก่อนส่งโพยได้ โดยไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
    </p>
  </ContentBoxTwoHuay>

  <FaqHuay title="คำถามที่พบบ่อยเกี่ยวกับ HUAY928" faqs={faqs} />

  <LoginRtpSection />

  <LatestWinners />

  <ReviewCardSumo2 />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#f7d979] via-[#dfb455] to-[#a87a1e] px-4 py-3 text-sm font-black whitespace-nowrap text-[#01091b] shadow-[0_10px_30px_rgba(223,180,85,0.32)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(247,217,121,0.46)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>

    <a
      href="/login"
