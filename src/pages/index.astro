---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import LatestWinners from "../components/LatestWinnersCyber.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBox from "../components/ContentBox.astro";
import Faq from "../components/Faq4.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import { pageGraph } from "../lib/schema";
import promoReferral from "../assets/slide1.png";
import promoCashback from "../assets/slide2.png";

// VARIANT ROTATION THIS ROUND, decided in .claude/brand-spec-ninja168.md §3 and NOT
// re-picked here: Announcement5 replaces Announcement2, LatestWinnersCyber replaces
// LatestWinners2, Faq4 replaces Faq2, ReviewCardSumo2 replaces the BASE ReviewCardSumo,
// and the ContentBox shape-mix leaves FloatingBadge / Neumorphism / TwoNeumorphism /
// SevenThreePremium / SevenThree / 3Three behind for CyberCut / Premium / TwoCyberCut /
// SevenThreeCyberCut / SevenThreeNeumorphism / Special. NavbarCyber + FooterCyber are the
// layout's pair this round and the brand font moves google-sans -> kanit; all of that is
// the orchestrator's shared-chrome step, not this page's.
// ⚠️ Plain ContentBox IS in this round's mix (§3) and is also the always-live box that
// terms, privacy, 404, /promotion and the button pages render through — it sits in the
// shared-chrome set either way. ContentBoxTwo is live too but is NOT imported here: it is
// reached only through LoginRtpSection, so an "is it used?" grep has to match the bare
// filename rather than the components/ path.
// Every unused *Premium / *Cyber / *Huay / *Style / *FloatingBadge / *Neumorphism sibling,
// the other Faq* and Announcement* files, the other LatestWinners* and the base
// ReviewCardSumo all stay on disk as inventory for the next brand — nothing was deleted,
// and the earlier brands' hues still inside them are expected drift.
//
// <Announcement /> runs bare on purpose: Announcement5's default message is already this
// brand's copy, set from this brief, and every sub-page calls it bare too — so passing an
// override here is exactly how the ticker ends up saying two different things on two
// pages of the same site.
//
// PALETTE — CYAN BLUE LEADS, LIME YELLOW IS THE SECOND HUE, DEEP BLUE NEVER CARRIES TEXT,
// ON PURE BLACK (brand-spec §2). Read off the artwork: the logo is a cartoon NINJA in a
// black suit with a blue-and-white headband carrying a navy star, one eye winking, holding
// a BLUE shuriken, a blue scarf streaming behind him, ringed by gold sparkles and more
// blue shuriken — beside thick 3-D Thai lettering in GOLDEN YELLOW followed by glossy
// BUBBLE-BLUE numerals. The banner is a WHITE-AND-ICE-BLUE scene with the same ninja, gold
// coins, blue hearts, a 777 slot cabinet and a silver-blonde woman in white-and-blue lace
// pointing at the viewer.
// ⚠️ The trap this round is that BLUE + GOLD REPEATS THE PREVIOUS ROUND'S FAMILY, so
// finding "a blue" or "a gold" in a file proves nothing — compare by VALUE. สบายเบท168 was
// sky blue 2f9ff5 leading amber gold ffc82e. This round is CYAN #32bcfb leading LIME
// #fef54b, and the depth ramp is INK-BLUE #0c2a3d / #071a28 / #030e16, not 0e2238 /
// 081726 / 040d16.
// ⚠️ The page background is PURE BLACK #000000 (bg.json) — nothing sinks below the page.
// Body copy is #dceefc (= BRAND_TEXT), 16.8:1 on the page and 13:1 on the raised surface.
// The ONE highlight colour a <strong> may take is #fef54b (12.7:1). #32bcfb (7.1:1) and
// #a9e9ff (11.3:1) carry headings, links and secondary labels. #07335f (1.4:1) and
// #6b5c10 (1.9:1) never carry text at any size: borders, plates, rules, gradient ends and
// auras only. #041019 is the only ink allowed on a solid cyan or solid lime fill. Glow
// rgba is rgba(50,188,251,α), rgba(254,245,75,α), rgba(169,233,255,α) or rgba(7,51,95,α).
// ⚠️ No pink, purple/violet, green, orange, red, rose-gold or silver/chrome this round.
// Values that must not survive anywhere that renders: 2f9ff5 a8dcff 0b3f78 ffc82e 5c4a16
// e8f4ff 0e2238 081726 040d16 04121f (สบายเบท168) · fa63b9 ffb3de ffd84d 2b0f20 1a0914
// 0d040a 6d0b3f 6b4708 2a0617 fdeaf5 (ถอนชัวร์168) · fcd434 f5469f f6e4ee (มีโชค168) ·
// 0a84e0 04203f e4f1fd (HI59) · 04225b · 2563eb
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
//
// IMAGE ROLES FOR THIS DROP (2026-10-19, brand-spec §5). Exactly TWO files are referenced
// from this page, both from this drop, and THE TEXT PRINTED ON THE ART is what decides
// the pairing:
//   slide2.png -> §4, because its own plaque reads คืนยอดเสีย with 0.3% under it
//   slide1.png -> §5, because its own plaque reads แนะนำเพื่อน with 0.8% under it
// Both alts below were written from THIS drop's bitmaps, opened and read with the Read
// tool; neither is copied from a spec table and neither is a counter. The previous
// round's alts described an orange-and-white cartoon cat and a phone reading ถอนสำเร็จ —
// neither of those is anywhere in this drop, and the ground is WHITE-AND-ICE-BLUE here,
// not black.
// Deliberately NOT imported, and every file still on disk as inventory: banner2.png
// (10-08) and banner3.png (09-27) are previous brands' article art, and slide3.png /
// slide4.png (09-29) are an older brand's posters. An eager import IS an emit, rendered or
// not, so importing any of them would ship a competitor's picture into dist/ and turn
// verify-build red. There is therefore NO current-drop article illustration this round,
// and a slide is never substituted for one — the playbook pins slide* to
// ContentBoxSevenThree* blocks only, and these two are the round's full 2-block budget.
// banner1 and its mobile crop belong to MainLayout's own pinned globs and are never
// referenced from a page; og.png is the same, MainLayout owns it.
// ⚠️ Both slides are 600x600 SQUARE on disk this round, so 600 is the top real candidate
// (anything above it would not be a real pixel) and each picture carries max-w-[600px] so
// the art is never upscaled past its own bitmap. The two `sizes` lists are NOT
// interchangeable — each is the 3fr-column arithmetic from inside the variant that
// actually holds that picture, and the two variants pad and rule differently:
//   §4 ContentBoxSevenThreeCyberCut — max-w-7xl/1280 section, px-4, border 1x2, p-8,
//      gap-8, image column md:border-l + md:pl-8 = 33:
//        >= 1280px : (1280 - 32 - 2 - 64 - 32) x 0.3 - 33 = 312px
//        md..1279  : calc(30vw - 72px)
//        698..767  : 600px (bitmap cap)
//        < 698     : calc(100vw - 98px)
//   §5 ContentBoxSevenThreeNeumorphism — max-w-7xl/1280 section, px-4, border 1x2,
//      md:p-10, gap-10, image column md:border-l + md:pl-10 = 41:
//        >= 1280px : (1280 - 32 - 2 - 80 - 40) x 0.3 - 41 = 297px
//        md..1279  : calc(30vw - 87px)
//        698..767  : 600px (bitmap cap)
//        < 698     : calc(100vw - 98px)
// Neither picture is the LCP element — MainLayout's hero banner is — so both are
// loading="lazy" fetchpriority="low" decoding="async" and neither ever takes
// fetchpriority="high". formats/fallbackFormat stay at the house values, and quality is
// still ONE number for both formats — tools/avif-quality-service.mjs rescales the AVIF
// side on its own (x0.65), so it must never be hand-tuned per format.
//
// quality={64}, not the usual 80, carried over because the measurement that produced it
// still applies: both of this drop's slides are busy artwork with heavy fine grain
// (falling coins, lace, satin bows, bokeh), which is the case AVIF handles worst. At 80
// that is exactly the shape that comes out LARGER than its own WebP fallback at every
// emitted width, and verify-build.mjs fails the build on precisely that. 64 is the value
// already proven to win on this art style; the fix is always a LOWER quality, never a
// higher one. Same number on /promotion for the same two slides.
// Also deliberately unused, and named without the file extension on purpose because the
// playbook's "is this component live?" check is a bare-filename grep: ProviderGrid is
// banned by brand-spec §6 because this brief names NO game studio at all; GameRankingBoard
// has no ranking to carry; SmoothCarousel has no brief section asking for a carousel;
// BankStrip already renders inside the active footer; and FeatureHighlights is banned too,
// because its items render as <h3> and the only two h3s this page may have are the brief's
// own.
//
// VOCABULARY — brand-spec §6, the brief's own words only. This is a PURE SLOT brand whose
// subject is TWO PROMOTIONS: แนะนำเพื่อน 0.8% and คืนยอดเสีย 0.3%. Everything the copy
// says traces to src/assets/content.txt: สล็อต, โปรโมชั่น, แนะนำเพื่อน, ลิงก์แนะนำ,
// รหัสแนะนำ, โบนัส 0.8%, คืนยอดเสีย 0.3%, เครดิต, ยอดเสีย, รอบคำนวณ, รอบจ่ายโบนัส,
// สมัครสมาชิก, เข้าสู่ระบบ, บัญชีสมาชิก, ฝากถอน, ธนาคาร, วอลเลท, ยอดขั้นต่ำ,
// ระยะเวลาดำเนินการ, หลักฐานการทำรายการ, LINE Official, QR Code, บัญชีที่แอบอ้าง,
// รหัสผ่าน, รหัส OTP, เจ้าหน้าที่, เงื่อนไข, 24ชม.
// ⚠️ สบายเบท168's phrases เว็บสล็อตทางการ, ผู้ให้บริการฐานเกมหลัก, เว็บแท้อันดับ1,
// เว็บแท้100%, 3 ขั้นตอน · มีโชค168's เว็บสล็อตลิขสิทธิ์แท้, นำเข้าตรงจากสิงคโปร์, PG
// SOFT, JOKER, JILI · and ถอนชัวร์168's ถอนง่าย, ไม่มีรีวิวเสีย, หลักแสนยูสต่อวัน,
// การันตีเว็บแท้ are all GONE.
// **This brief names NO game studio whatsoever**, so no studio name appears anywhere on
// this page. There is no คาสิโน, บาคาร่า, รูเล็ต, ไฮโล, ยิงปลา, บอล/แทงบอล/กีฬา,
// อัตราต่อรอง, หวย/แนวทาง/ตรวจหวย, เว็บตรง, ไม่ผ่านเอเย่นต์, แตกง่าย, ไม่มีขั้นต่ำ or
// ออโต้ 1 วินาที anywhere here. Nothing claims a licence number, a regulator, a
// legal-entity name, a named bank, an RTP figure, a deposit minimum, a member count or a
// founding year. The only figures on the page are the brief's own: 0.8%, 0.3% and 24ชม.
// ⚠️ This brief HEDGES UNUSUALLY HARD — ก่อนเข้าร่วมควรตรวจสอบวิธีคำนวณโบนัสและข้อจำกัด,
// แม้โปรโมชั่นจะระบุว่ารับได้ไม่อั้น แต่ควรยืนยันรอบการจ่ายโบนัส, and
// เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกรายการหรือรับประกันผลตอบแทน.
// EVERY hedging clause ships in full — they are brief content, not downbeat filler to be
// trimmed — and nothing here is written up into the advertising claim the brief is
// warning about.
//
// The brief, the artwork and the operator's prompt all agree on the brand name. Even so
// the name is never typed on the page: it is interpolated from ${BRAND_NAME} so it can
// never drift from brandProfile, including inside the two alts. No domain is written out
// anywhere here and no URL is built with `+`.
//
// Title and description are the brief's own Title / Description lines (content.txt lines
// 1-2) verbatim, with the brand name interpolated. The description is NOT padded up to 150
// characters — verify-build deliberately skips its 150-character floor on the home page
// for exactly this reason.
const pageTitle = `${BRAND_NAME} สล็อตโปรแรงโบนัส0.8%ทุกวัน แค่แนะนำง่ายๆ รับได้ไม่อั้น`;

const pageDescription = `${BRAND_NAME} สล็อตโปรแรงโบนัส0.8%ทุกวัน สมัครรับโปรโมชั่นได้ไม่จำกัด แค่แนะนำลิ้งก์ง่ายๆ รับโบนัสเข้ายูสได้ไม่อั้น`;

// The brief has a real H2 -> H3 nesting this round, so the page is NOT flattened to
// H2-only. The two H3s are the docx's own H3 lines (content.txt lines 9 and 11) — the two
// promotion sub-points that sit under section 3's สมัคร…รับโปรโมชั่นได้ไม่จำกัด H2 in the
// brief's own outline. There is no FeatureHighlights H3 exception this round, and no
// component rendered here emits a hardcoded heading, so the printed h3 count stays at
// exactly 2.
//
// The checklist, in document order, and what carries each one:
//    1 H1  ${BRAND_NAME} สล็อตโปรแรงโบนัส 0.8% ทุกวัน แค่แนะนำง่ายๆ รับได้ไม่อั้น
//          ContentBoxCyberCut, brief paragraph on line 4
//    2 H2  แค่แนะนำลิงก์ ${BRAND_NAME} ง่ายๆ รับโบนัสเข้ายูสได้ไม่อั้น
//          ContentBoxPremium, line 6
//    3 H2  สมัคร ${BRAND_NAME} รับโปรโมชั่นได้ไม่จำกัด
//          ContentBoxTwoCyberCut, line 8 run one paragraph half per column
//    4 H3  โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสทุกวัน
//          ContentBoxSevenThreeCyberCut + slide2, line 10 left / picture right
//    5 H3  โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด
//          ContentBoxSevenThreeNeumorphism + slide1, line 12 left / picture right
//    6 H2  ระบบฝากถอน ${BRAND_NAME} ธนาคารชั้นนำและวอลเลท
//          ContentBoxSpecial, line 14 split across its two halves
//    7 H2  ช่องทางติดต่อแอดมิน ${BRAND_NAME} ทาง LINE OFFICIAL 24ชม.
//          ContentBox (the base variant), line 16
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ ${BRAND_NAME}
//          Faq4 + faqs prop, lines 18-23
// Final inventory for this page: h1 x1, h2 x5, h3 x2.
//
// Both ContentBoxSevenThree* variants lay out md:grid-cols-[7fr_3fr] with the TEXT column
// FIRST and fall `title` back to that left column, so each picture goes in slot="right":
// the heading always lands on the prose, never on the picture, and on a phone the single
// column reads heading, text, picture rather than opening with an image. Neither is passed
// a `titleright`, so neither image column carries a heading and each block emits exactly
// one.
// ContentBoxTwoCyberCut is passed no column labels — the brief gives §3 one running
// paragraph with no sub-labels, and inventing a pair here would be this page's own wording
// rather than the docx's. The paragraph runs one half per slot, which keeps every clause
// and still gives the component both slots. ContentBoxSpecial does the same for §6, with
// the brief's two halves landing in its two icon rows (🏦 for the channels half, 🛡️ for
// the what-to-do-if-a-transaction-stalls half).
//
// Every brief paragraph ships in full — nothing merged, nothing summarised. §3 and §6 run
// one paragraph half per slot, and NO slot receives more than one element, so the house
// rule's "one element per slot" holds everywhere without a wrapper <div> being needed.
//
// Everything else on the page is chrome and emits no heading tag at any level:
// Announcement5, LatestWinnersCyber, LoginRtpSection (and ContentBoxTwo inside it) and
// ReviewCardSumo2 render their titles as <p>/<span> with an aria-label on the section, and
// Faq4's questions live inside <summary> (all five were grepped for <h[1-6] this round and
// none has one). The non-brief widgets sit before section 1 (the ticker, then the member
// feed) and after section 8 (LoginRtpSection, ReviewCardSumo2, Navfoot) — never spliced
// between two content sections.

// One array, used by both <Faq> and the FAQPage node — never the component's own defaults
// (Faq4 deliberately ships an empty list, so a forgotten prop renders an empty accordion
// rather than some previous brand's questions). The three pairs are the brief's own Q/A
// block (content.txt lines 18-23), verbatim; only the "1." / "2." / "3." list markers are
// dropped, since the accordion is the list.
const faqs = [
  {
    q: `โปรโมชั่นแนะนำเพื่อน 0.8% ของ${BRAND_NAME} รับโบนัสได้ทุกวันหรือไม่?`,
    a: `โปรโมชั่นระบุอัตราโบนัส 0.8% แต่ควรตรวจสอบรอบคำนวณยอดและเวลาจ่ายโบนัสจากประกาศล่าสุด เพราะการรับเครดิตอาจขึ้นอยู่กับเงื่อนไขของบัญชีและรายการที่เข้าเกณฑ์`,
  },
  {
    q: `โปรโมชั่นคืนยอดเสีย 0.3% ต้องกดรับเองหรือไม่?`,
    a: `ควรตรวจสอบวิธีรับเครดิตจากหน้าประกาศโปรโมชั่นหรือสอบถามเจ้าหน้าที่ เนื่องจากระบบอาจกำหนดให้รับอัตโนมัติหรือกดรับด้วยตนเองตามเงื่อนไขที่ใช้ในแต่ละช่วงเวลา`,
  },
  {
    q: `${BRAND_NAME} รองรับการฝากถอนผ่านวอลเลทหรือไม่?`,
    a: `เว็บไซต์ระบุบริการฝากถอนผ่านธนาคารและวอลเลท ผู้ใช้งานควรตรวจสอบรายชื่อช่องทางที่รองรับจริง ยอดขั้นต่ำ และเงื่อนไขการทำรายการจากหน้าเว็บไซต์ก่อนดำเนินการ`,
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own sentence.
// Thai has no inter-word space, so a highlight that starts or ends mid-word lets the
// formatter break the line inside the tag and render a space that splits the word — the
// copy must read identically with the tags removed. No two <strong> elements are adjacent
// either: every pair is separated by at least one run of plain text, so the whitespace
// between them can never collapse into a missing space.
// One highlight colour only: #fef54b (brand-spec §2 reserves it for exactly this job),
// against the inherited body colour #dceefc (BRAND_TEXT). The paragraphs below carry no
// colour class of their own: every ContentBox* card in this mix already sets
// `text-left text-base leading-relaxed text-[#dceefc]` on the element holding the slot, so
// the prose inherits it and no page-level override can drift from the card. No paragraph
// carries mx-auto or max-w-* either — the cards cap their own width, and the only max-w-*
// on the page are the two capping the slides, which are images and not prose. No slot's
// copy names a colour.

// No breadcrumb: this is the homepage, so a trail from the root to itself would be a
// single self-referential crumb. Every URL in the graph is derived by pageGraph from
// `site:` — no domain is typed out in this file, no URL is built with `+`, and no Review /
// AggregateRating / sameAs / address / email node is passed. `description` is the exact
// same string MainLayout gets, and `faqs` is the exact same array <Faq> gets.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <LatestWinners />

  <ContentBoxCyberCut as="h1" title={`${BRAND_NAME} สล็อตโปรแรงโบนัส 0.8% ทุกวัน แค่แนะนำง่ายๆ รับได้ไม่อั้น`}>
    <p>
      {BRAND_NAME} นำเสนอโปรโมชั่นสำหรับสมาชิกที่สนใจรับสิทธิ์จากการแนะนำเพื่อน
      <strong class="text-[#fef54b]">โดยระบุอัตราโบนัส 0.8% พร้อมช่องทางแชร์ลิงก์แนะนำและตรวจสอบข้อมูลโปรโมชั่นผ่านบัญชีสมาชิก</strong>
      นอกจากนี้ยังมีรายละเอียดเกี่ยวกับการฝากถอนผ่านธนาคารและวอลเลท รวมถึงช่องทางติดต่อเจ้าหน้าที่สำหรับสอบถามเงื่อนไขต่าง ๆ
      <strong class="text-[#fef54b]">ก่อนเข้าร่วมควรตรวจสอบวิธีคำนวณโบนัสและข้อจำกัดของแต่ละรายการให้ครบถ้วน</strong>
    </p>
  </ContentBoxCyberCut>

  <ContentBoxPremium as="h2" title={`แค่แนะนำลิงก์ ${BRAND_NAME} ง่ายๆ รับโบนัสเข้ายูสได้ไม่อั้น`}>
    <p>
      {BRAND_NAME} มีโปรโมชั่นแนะนำเพื่อนที่ระบุอัตราโบนัส 0.8% สำหรับสมาชิกที่เข้าร่วมตามเงื่อนไข
