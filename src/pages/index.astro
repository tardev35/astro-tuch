---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBox3ThreePremium from "../components/ContentBox3ThreePremium.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import Faq from "../components/Faq4.astro";
import LatestWinners from "../components/LatestWinners2.astro";
import ReviewCardSumo from "../components/ReviewCardSumo.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import { pageGraph } from "../lib/schema";
import cashbackPoster from "../assets/slide1.png";
import referralPoster from "../assets/slide2.png";

// การหมุน variant รอบนี้ตัดสินไว้แล้วใน .claude/brand-spec-abm96.md §3 —
// **ห้ามเลือกใหม่ที่นี่** แบรนด์ขาออก (LOTTOPLUS) ถูกหมุนออกจากทุกตระกูลพร้อมกัน
// และรอบนี้ **ทับซ้อนกับรอบก่อนศูนย์ตัว**: Announcement5 แทน AnnouncementHuay ·
// Faq4 แทน Faq3 · LatestWinners2 แทน LatestWinnersHuay · ReviewCardSumo แทน
// ReviewCardSumo2 · **ProviderGrid แทน LottoGrid** (รอบนี้เป็นเว็บคาสิโน ไม่ใช่
// เว็บหวย บรีฟจึงไล่ชื่อ **หมวดเกม** ไว้ห้าหมวด) · และ shape-mix ของ ContentBox
// ทิ้งชุด Huay + TwoHuay + CyberCut + SevenThreeHuay + SevenThree(ฐาน) +
// 3Three(ฐาน) + Special ของรอบก่อนทั้งชุด ไปใช้ **Premium + TwoCyberCut +
// FloatingBadge + SevenThreeCyberCut + SevenThreeNeumorphism + 3ThreePremium +
// TwoNeumorphism** แทน
// ไม่ลบไฟล์ที่ไม่ได้ใช้แม้แต่ตัวเดียว — มันคือ inventory ของแบรนด์ถัดไป
// Navbar/Footer อยู่ที่ MainLayout (NavbarStyle6 / FooterCyber) ไม่ใช่ที่ไฟล์นี้
// ❌ รอบนี้ **ไม่ใช้ LottoGrid / BankStrip / SmoothCarousel / LoginRtpSection /
// GameRankingBoard / FeaturedGames / PopularGamesStrip / FeatureHighlights
// (render h3 จะดัน h3 เกิน checklist) / ProviderGridPremium / ตระกูล *Huay ทั้งชุด**
// — บรีฟรอบนี้ไม่มีหมวดฝากถอน ธนาคาร วอลเลท ชื่อค่ายเกม หรือคำว่าหวยเลยสักคำ
// ⚠️ `<Announcement />` ถูกเรียกแบบ **ไม่ส่ง message** โดยตั้งใจ — default ของ
// Announcement5 เป็นคอปปี้ของแบรนด์รอบนี้อยู่แล้ว และหน้าย่อยทุกหน้าก็เรียกแบบ
// bare เหมือนกัน ข้อความ ticker จึงตรงกันทั้งเว็บจากที่เดียว
//
// ⚠️⚠️ พาเลตรอบนี้ (brand-spec §2 ล็อกค่าไว้ ห้ามเดาเพิ่ม ห้ามดูดสีจากรูป):
// 🚨🚨 **ยังเป็น "เนื้อหาสว่าง + โครมเข้ม" เหมือนรอบก่อน แต่คนละตระกูลสีทั้งชุด**
// พื้นเพจ #f8b9f0 (bg.json) = **ชมพูพาสเทลอิ่มตัว** (รอบก่อน LOTTOPLUS เป็น
// e1fef3 เขียวมินต์จางเกือบขาว — **ห้ามสืบทอดค่าข้ามรอบ** เขียนแบบไม่มี # โดย
// ตั้งใจ เพื่อไม่ให้ sweep ที่ไล่หาสีของแบรนด์เก่าสะดุดที่คอมเมนต์ของไฟล์นี้เอง) ·
// การ์ดเนื้อหา #ffffff · การ์ดสำรอง #fff5fb · พื้นถมอ่อน/ชั้นยก/ชิป #fcd9ee ·
// เส้นบาง #f3a7d3 · ขอบตกแต่ง/ออรา #e0509f · ออราสว่าง #ff7ac2 ·
// โครม (navbar/footer/ticker/Navfoot เท่านั้น) #440d31 / #2b0620 / #5e1746 ·
// หมึก #3d0a2c (= BRAND_TEXT) · หมึกรอง #7a4263 ·
// **หัวข้อ + ลิงก์ + <strong> = #a30d63 ชมพูบานเย็น** (7.5:1 บนการ์ดขาว ·
// 4.7:1 บนพื้นเพจ) · ทองเข้มที่ถือตัวอักษรบนผิวสว่างได้ #6e4705 ·
// ทองอำพัน #f2c14e · เงินอมชมพู #e8c3da · หมึกบนโครม #ffeef8
// 🚨🚨 **#f8b9f0 #ffffff #fff5fb #fcd9ee #f3a7d3 #e0509f (3.6:1) #ff7ac2
// ห้ามถือตัวอักษรทุกบริบท** และ **#f2c14e ได้แค่ 1.7:1 บนการ์ดขาว** จึงถือ
// ตัวอักษรได้เฉพาะเมื่อนั่งบนโครมเข้มเท่านั้น
// 🚨🚨 **ตัวอักษรขาวบนพื้นเพจได้แค่ 1.6:1 = ห้ามเด็ดขาด** — ข้อความที่นั่งบน
// พื้นเพจตรง ๆ (หัวแผง ProviderGrid) ต้องเป็นหมึกเข้ม #3d0a2c เท่านั้น
// 🚨🚨 **ไฟล์ที่หมุนเข้ามารอบนี้เฉียดชมพูทั้งคู่** — NavbarStyle6 เพิ่งเป็น
// ไวโอเลต-แมเจนต้าของ ZANE96 · Announcement5 + ProviderGrid เพิ่งเป็นแดงชาด-
// ชมพูบลัชของ 123BET · และ okkub88 เป็น **แบรนด์ชมพูเหมือนกันเป๊ะ**
// **"เจอชมพู" ไม่เคยพิสูจน์ว่าสีเป็นของรอบนี้ ต้องเทียบให้ตรงหกหลัก**
// (a30d1a ↔ #a30d63 ต่างสองหลักท้าย · d91a73 ↔ #d11a7e) ลิสต์เฮกซ์เต็มของทุก
// แบรนด์อยู่ที่ brand-spec §2b
// ✅ LINE green #00B900 กับเขียว success ของฟีดถอนเงินเป็นสีเชิงความหมาย **คงไว้
// ห้ามกลืนเข้าชมพูของรอบนี้**
//
// ย่อหน้าในไฟล์นี้ไม่ถือคลาสสีหรือขนาดของตัวเอง — ทุก ContentBox* ในมิกซ์นี้ตั้ง
// `text-left text-base leading-relaxed` + หมึก #3d0a2c ไว้บน element ที่ถือ slot
// อยู่แล้ว และไม่มี `<p>` ไหนมี mx-auto / max-w-* (การ์ดคุมความกว้างเองแล้ว)
// ไฮไลต์ <strong> มีสีเดียวคือ #a30d63 ซึ่งเป็นงานของหน้านี้ ไม่ใช่ของ component
//
// ⚠️ ชื่อแบรนด์รอบนี้เป็น **ตัวละตินพิมพ์ใหญ่ ABM ติดเลข 96 เป็นคำเดียว ห้า
// เคอแรกเตอร์** แต่ยัง interpolate จาก `${BRAND_NAME}` ทุกจุดรวมถึงใน alt
// **ห้ามพิมพ์ชื่อแบรนด์เป็นตัวอักษรตรงๆ ที่ไหนเลย** ไม่มีโดเมนเขียนไว้ที่ไหน
// และไม่มี URL ที่ต่อด้วย `+`
// ⚠️ ชื่อไทยที่บรีฟใช้คู่กันคือ **เว็บเอเอ็มบีคาสิโน** — นั่นเป็นคำในเนื้อหาของ
// บรีฟ ไม่ใช่ค่าของ BRAND_NAME จึงพิมพ์ตรงได้ในฐานะถ้อยคำของบรีฟ
//
// <strong> ทุกตัวคร่อม "ก้อนที่คั่นด้วยช่องว่าง" ทั้งก้อน เพราะภาษาไทยไม่มีช่องว่าง
// ระหว่างคำ — อ่านคอปปี้โดยถอดแท็กออกต้องได้ข้อความของบรีฟเป๊ะ
// ⚠️ บรรทัด 6 ของบรีฟเขียน "ตามกติกาเกมสล็อต" ติดกันโดยไม่มีช่องว่าง และบรรทัด 10
// เขียน "บาคาร่าสล็อต" ติดกัน — **ship ตามบรีฟตรงตัว ห้าม "แก้" ให้มีช่องว่าง**
//
// บรีฟรอบนี้ **โฆษณาและกำกับในย่อหน้าเดียวกัน** (brand-spec §5): หัวข้อเขียนว่า
// ครบวงจร · เริ่มต้น1บาท · โบนัสไม่อั้น · ไม่จำกัด ขณะที่ย่อหน้าของบรีฟเองตอบกลับว่า
// **เกมเดิมพันมีความเสี่ยงและไม่สามารถรับประกันผลรางวัลได้** · ควรตรวจสอบรายชื่อ
// ผู้ให้บริการเกม เงื่อนไขการใช้งาน และความน่าเชื่อถือของแพลตฟอร์มก่อนทำรายการ ·
// ยอดขั้นต่ำอาจแตกต่างกันตามประเภทเกมและค่ายผู้ให้บริการ · แม้เว็บไซต์จะใช้ข้อความ
// ว่าโบนัสไม่อั้น แต่ควรตรวจสอบว่ามีวงเงินสูงสุดหรือข้อกำหนดเพิ่มเติมหรือไม่ ·
// **โปรโมชั่นคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่ม
// โอกาสชนะในครั้งถัดไป** · ไม่ควรเปิดเผยรหัสผ่านและรหัส OTP · ควรตรวจสอบช่องทาง
// ติดต่อจากเว็บไซต์ทางการเพื่อหลีกเลี่ยงบัญชีแอบอ้าง —
// **ship ทั้งสองครึ่งตรงตามที่บรีฟเขียน ไม่ขยายคำโฆษณาเป็นคำกล่าวอ้างใหม่ และทุก
// ประโยคกำกับ ship ครบ ไม่ตัดเพราะฟังดูลบ**
// 🚨🚨 **หมวดเกมรอบนี้มีห้า ไม่ใช่เจ็ด**: บาคาร่า (บาคาร่าออนไลน์) · สล็อตออนไลน์ ·
// รูเล็ต · ไฮโล · คาสิโนสด
// ❌ **หวยทุกรูป · สลาก · งวด · โพย · เลขอั้น · รอบปิดรับ · สองตัวบน-ล่าง ·
// สามตัวตรง-โต๊ด · 2 ตัว จ่าย 100 · 3 ตัว จ่าย 1,000 · อัตราจ่ายสูง · จ่ายเต็ม ·
// โอนไว · ทางเข้าเว็บแม่ (LOTTOPLUS รอบก่อนทันที) · ยิงปลา · เดิมพันฟุตบอล ·
// เว็บตรง · ไม่ผ่านเอเย่นต์ · ครบทุกค่าย · เซิร์ฟแท้ (123BET/ZORO365/TEVA69) ·
// ลิขสิทธิ์แท้จากเมกา · เซิร์ฟนอก · ปลอดภัย100% (WIN8S) · ฝากถอนออโต้ ·
// ทรูวอลเลท · ชื่อธนาคาร · ไม่มีขั้นต่ำ · ฟรีสปิน · ค่า RTP · แตกง่าย
// ไม่มีในบรีฟรอบนี้เลยสักคำ** (ห้ามสืบทอดลิสต์ข้ามรอบ)
// ตัวเลขบนหน้านี้มีแค่ของบรีฟเอง: **1 บาท · 0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง**
// ❌ ไม่มีจำนวนสมาชิก ไม่มีปีก่อตั้ง ไม่มีใบอนุญาต ไม่มีจำนวนค่าย/เกม ไม่มี 100%
//
// title/description = บรรทัด 1-2 ของบรีฟ **verbatim** (src/assets/content.txt)
// ส่งที่นี่เพราะ pageGraph ต้องใช้สตริงเดียวกับที่ MainLayout ได้รับ
// **ห้ามต่อเติม** (verify-build ยกเว้นเพดานล่าง 150 ให้หน้าแรกไว้ด้วยเหตุผลนี้
// โดยเฉพาะ — หน้าย่อยไม่ได้รับการยกเว้น)
const pageTitle = `${BRAND_NAME} เว็บเอเอ็มบีคาสิโน บาคาร่า สล็อต รูเล็ต ไฮโล รวมครบวงจร`;

const pageDescription = `${BRAND_NAME} เว็บเอเอ็มบีคาสิโน แหล่งเดิมพันเกมออนไลน์ บาคาร่า สล็อต รูเล็ต ไฮโล เริ่มต้น1บาท มีไลฟ์เล่นได้ 24 ชั่วโมง และเกมอื่นๆ ครบวงจร`;

// บรรทัด 3 ของบรีฟ ซึ่ง **ต่างจากบรรทัด 1** — ใช้ตามบรีฟ ไม่ copy title
const pageH1 = `${BRAND_NAME} เว็บเอเอ็มบีคาสิโน แหล่งเดิมพันเกมออนไลน์ ครบทุกแนว`;

// บรีฟรอบนี้มีชั้น H1 -> H2 -> H3 จริง จึง **ไม่** แบนเป็น H2 ล้วน
//
// checklist ตามลำดับเอกสาร (brand-spec §4) และตัวที่รับแต่ละข้อ:
//    1 H1  <แบรนด์> เว็บเอเอ็มบีคาสิโน แหล่งเดิมพันเกมออนไลน์ ครบทุกแนว
//          ContentBoxPremium, ย่อหน้าบรรทัด 4
//    2 H2  <แบรนด์> บาคาร่า สล็อต รูเล็ต ไฮโล เริ่มต้น1บาท ไลฟ์เดิมพัน 24 ชั่วโมง
//          ContentBoxTwoCyberCut, บรรทัด 6 แบ่งสองซีกโดยไม่ตกประโยคไหน
//          + ProviderGrid ต่อท้ายทันที (หัวข้อเดียวของบรีฟที่ไล่ชื่อหมวดเกม)
//    3 H2  โปรโมชั่นคาสิโนเว็บ <แบรนด์> โบนัสไม่อั้น
//          ContentBoxFloatingBadge, บรรทัด 8
//    4 H3  โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน
//          ContentBoxSevenThreeCyberCut + **slide1** ในสล็อตขวา, บรรทัด 10
//    5 H3  โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด
//          ContentBoxSevenThreeNeumorphism + **slide2** ในสล็อตขวา, บรรทัด 12
//    6 H2  สมัครเล่น <แบรนด์> บาคาร่า สล็อต คาสิโนครบ
//          ContentBox3ThreePremium, intro (บรรทัด 14) เข้า default slot และ
//          ขั้นตอน 1/2/3 (บรรทัด 15-20) เข้า left/center/right
//    7 H2  แอดมิน <แบรนด์> ออนไลน์ตลอด 24ชม.
//          ContentBoxTwoNeumorphism (**ส่ง as="h2" ชัดเจน**), บรรทัด 22 แบ่งสองซีก
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ <แบรนด์>
//          Faq4 + prop faqs ชัดเจน (**ส่ง as="h2"**), บรรทัด 24-29
// inventory ที่ต้องได้: **h1 ×1 · h2 ×5 · h3 ×2** — ตรงเป้าของ brand-spec §4
//
// ⚠️ จุดที่ชั้น heading รั่วได้ และกันไว้แล้วทุกจุด: บรรทัด 15/17/19 ของบรีฟ
// (ขั้นตอนที่ 1/2/3) **ไม่มี prefix H** จึงส่งเข้า titleleft/titlecenter/titleright
// ของ ContentBox3ThreePremium โดย **ไม่ส่ง `heading`** (default false -> <p>) ·
// **ไม่ส่ง titleright ให้ ContentBoxTwo* และ SevenThree* ทั้งสองใบ** ซีกขวาและ
// คอลัมน์ภาพจึงไม่มี heading · **ContentBoxTwoCyberCut กับ Faq4 default เป็น "p"
// จึงต้องส่ง as="h2" ชัดเจน** ไม่ส่งแล้ว inventory จะเหลือ h2 สามใบ ·
// คำถามใน Faq4 เป็น <span> ใน <summary> ไม่ใช่ heading
// grep `<h[1-6]` ในทุก component ที่ไฟล์นี้เรียกแล้วรอบนี้ — **ไม่มีไฟล์ไหนมีแท็ก
// heading เป็นตัวอักษรเลยสักตัว** ทุกหัวข้อบนหน้ามาจาก <HeadingTag> ที่ผูกกับ prop
// คือมาจากบรีฟ
// chrome บนหน้านี้ (Announcement5 · ProviderGrid · LatestWinners2 ·
// ReviewCardSumo · Navfoot) ขึ้นป้ายเป็น <p>/<span> พร้อม aria-label บน <section>
// **ห้ามเลื่อน <p> พวกนั้นขึ้นเป็น heading เพื่อ "แก้ชื่อที่ขาด"**
//
// ── รูปภาพ ────────────────────────────────────────────────────────────────
// รอบนี้ใช้ **สองใบ** และอยู่ในตระกูล SevenThree ทั้งคู่ (playbook ตรึง slide* ไว้
// กับตระกูลนี้ และเพดานคือ 2 บล็อก — รอบนี้ใช้ครบพอดี ไม่มีใบที่สาม)
// **ข้อความที่พิมพ์บนอาร์ตเวิร์กคือตัวตัดสินการจับคู่ ไม่ใช่ลำดับไฟล์** (เปิดอ่าน
// บิตแมปจริงด้วย Read แล้วรอบนี้):
//   slide1.png พิมพ์ **โปรโมชั่น / คืนยอดเสีย / 0.3%** โดยขอบล่างมี **กองชิป
//     คาสิโนชมพู-ขาวกับไพ่เอซโพแดง** และ **ไม่มีโทรโข่ง** -> §4
//   slide2.png พิมพ์ **โปรโมชั่น / แนะนำเพื่อน / โบนัส / 0.8%** โดยมี **โทรโข่ง
//     สีชมพู-ขาว** เอียงอยู่เหนือตัวเลข และขอบล่างเป็น **กล่องของขวัญผูกริบบิ้น** -> §5
// ⚠️⚠️ uploader เขียนทับสองไฟล์นี้ทุกดรอป การจับคู่จึงไม่มีความหมายข้ามแบรนด์
// **ห้ามลอกจากรอบก่อน** (รอบก่อนจับ slide2 ไว้กับหัวข้อแรก ซึ่งสลับกับรอบนี้)
// ⛔ **banner1 / banner1-mobile / og.png เป็นของ MainLayout** (glob ปักชื่อไว้แล้ว)
// และ **banner2.png / banner3.png / slide3.png / slide4.png เป็นอาร์ตเวิร์กของ
// ดรอปเก่า ห้าม import เด็ดขาด** เพราะ eager import = emit ขึ้น dist ทุก build
// แม้ไม่มีหน้าไหน render และ verify-build.mjs จะแดงถ้ามีรูปที่ไม่ได้ถูก render
// ⚠️ ไม่มีภาพไหนบนหน้านี้เป็น LCP (hero อยู่ที่ MainLayout) สไลด์ทั้งสองอยู่ใต้
// fold จึงเป็น **loading="lazy" fetchpriority="low"** ไม่มี eager/high สักใบ
//
// `widths`/`sizes` คำนวณจากเรขาคณิตจริงของคอลัมน์ภาพ (3fr ฝั่งขวา) ของ **variant
// ที่ถือรูปใบนั้นจริง ๆ** — สองชุดนี้ **สลับกันไม่ได้** และ **ไม่ได้ลอกจากรอบก่อน**
// (รอบก่อนคิดจาก SevenThreeHuay + SevenThree ตัวฐาน ซึ่งเป็นคนละไฟล์กับรอบนี้
// ทั้งคู่) Tailwind เป็น border-box ทั้งโปรเจกต์ max-w/padding จึงนับรวมกัน
// บิตแมปจริงของดรอปนี้ **375x600 ทั้งสองใบ** เพดานจึงเป็น **375 และห้ามมี
// candidate ไหนเกิน 375** เพราะเกินกว่านั้นคือการอัพสเกล
//
// §4 ContentBoxSevenThreeCyberCut — section **max-w-7xl (1280)** + px-4(32) ·
//   การ์ด border(1x2=2) · p-8(64) **ไม่มี md:p-10** · grid **gap-8(32)** ·
//   คอลัมน์ภาพจ่าย md:border-l(1) + md:pl-8(32) = 33 ในกล่องของมันเอง
//   >=1280px : (1280 - 32 - 2 - 64 - 32) x 0.3 - 33 = 1150 x 0.3 - 33 = 312px
//   768-1279 : (100vw - 130) x 0.3 - 33             = calc(30vw - 72px)
//   473-767  : ยุบเหลือคอลัมน์เดียวที่ p-8 -> 100vw - 98 ซึ่ง >= 375 จึงติดเพดาน = 375px
//   < 473    : คอลัมน์เดียวที่ p-8                   = calc(100vw - 98px)
// candidate: 159 = ค่าต่ำสุดของแบนด์ md (ที่ 768px: 230.4 - 72 = 158.4) ·
//   277 = 100vw-98 ที่จอ 375px · 312 = 1x ที่ >= 1280px · 375 = **เพดานบิตแมปจริง**
//   (2x ของ 312 = 624 เกินบิตแมป จึงตกลงมาที่ 375)
const cashbackWidths = [159, 277, 312, 375];
const cashbackSizes = "(min-width: 1280px) 312px, (min-width: 768px) calc(30vw - 72px), (min-width: 473px) 375px, calc(100vw - 98px)";

// §5 ContentBoxSevenThreeNeumorphism — section **max-w-[1400px]** + px-4(32) ·
//   การ์ด border(1x2=2) · p-8 / **md:p-10(80)** · grid **gap-8(32)** ·
//   คอลัมน์ภาพจ่าย md:border-l(1) + md:pl-8(32) = 33
//   >=1400px : (1400 - 32 - 2 - 80 - 32) x 0.3 - 33 = 1254 x 0.3 - 33 = 343px
//   768-1399 : (100vw - 146) x 0.3 - 33             = calc(30vw - 76.8px)
//   473-767  : คอลัมน์เดียวที่ p-8 -> 100vw - 98 ซึ่ง >= 375 จึงติดเพดาน = 375px
//   < 473    : คอลัมน์เดียวที่ p-8                   = calc(100vw - 98px)
// candidate: 154 = ค่าต่ำสุดของแบนด์ md (ที่ 768px: 230.4 - 76.8 = 153.6) ·
//   277 = 100vw-98 ที่จอ 375px · 343 = 1x ที่ >= 1400px · 375 = **เพดานบิตแมปจริง**
// ⚠️ ต่างจาก §4 ที่ 1x ถึง 31px และคนละเบรกพอยต์บนสุด — **ห้ามลอกตัวเลขข้ามไฟล์**
// ถ้าแก้ padding/gap/border/cap ที่ component ต้องกลับมาแก้สองชุดนี้ด้วย
const referralWidths = [154, 277, 343, 375];
const referralSizes = "(min-width: 1400px) 343px, (min-width: 768px) calc(30vw - 76.8px), (min-width: 473px) 375px, calc(100vw - 98px)";

// บรรยายจากบิตแมปจริงของดรอปนี้ (เปิดอ่านด้วย Read แล้ว) **ไม่ใช่คัดลอกของรอบก่อน**
// 🚫 ภาษาภาพของ LOTTOPLUS ที่ **ไม่มี** ในสองรูปนี้เลย — ชุดไทยเขียวมรกตปักทอง
// ดอกลีลาวดีขาวกลางเหลือง ยอดปรางค์ทอง ลูกบอลหวยเขียว-ขาวพิมพ์ตัวเลข ใบโพยหวย
// ใบโคลเวอร์สี่แฉก เวิร์ดมาร์กโครเมียมเงิน วงรีแถบวงโคจร
// 🚫 และ **ไม่ใช่** ลูกหมูมีปีกของหมูบิน168 (ดรอปนี้ **ไม่มีปีก**) **ไม่ใช่**
// หน้าการ์ตูนกลมชมพูชูสองนิ้วของ okkub88 (ดรอปนี้ **ไม่ได้ชูนิ้ว**) และ **ไม่ใช่**
// ชุดราตรีแดง-ขาวกับมงกุฎทองของ 123BET (ดรอปนี้ **ไม่มีมงกุฎ**)
// ✅ สิ่งที่มีจริงในดรอปนี้: ผ้าซาตินชมพูนวล · เวิร์ดมาร์กละตินสามมิติอ้วนมนที่ตัว A
// มีหัวใจเล็กในช่องกลาง · มาสคอตลูกหมูหูตกขยิบตาในจานวงกลม · หญิงสาวผูกโบว์
// ริบบิ้นชมพูในชุดลูกไม้ชมพู ต่างหูรูปหัวใจ · หัวใจชมพูสามมิติผิวมันเงา ·
// ชิปคาสิโนชมพู-ขาว · ไพ่เอซ · กล่องของขวัญผูกริบบิ้น · โทรโข่งชมพู-ขาว (เฉพาะ slide2)
// ✅ brand-spec §6 ยืนยันว่าอาร์ตเวิร์กดรอปนี้ **สะอาด** — เวิร์ดมาร์กบนสไลด์เป็นของ
// แบรนด์ปัจจุบันจริง จึงอ้างชื่อผ่าน ${BRAND_NAME} ได้
const cashbackAlt = `โปสเตอร์โปรโมชั่นแนวตั้งบนฉากผ้าซาตินชมพูนวล มุมบนขวาเป็นโลโก้ ${BRAND_NAME} แบบเวิร์ดมาร์กละตินสามมิติตัวอ้วนมน ผิวไล่จากขาวนวลลงชมพูอ่อนตัดขอบชมพูเข้มหนาสองชั้น โดยตัว A มีหัวใจชมพูเล็กซ้อนอยู่ในช่องกลางตัวอักษร เหนือเวิร์ดมาร์กเป็นจานวงกลมชมพูขอบขาวที่มีมาสคอตลูกหมูการ์ตูนหน้ากลมสีชมพู หูตก แก้มแดงระเรื่อ ขยิบตาข้างหนึ่ง เอาสองขาหน้าเกาะขอบจานไว้ ฝั่งซ้ายเป็นหญิงสาวผมยาวสีน้ำตาลเกล้าผมผูกโบว์ริบบิ้นซาตินชมพู สวมชุดลูกไม้ระบายสีชมพูอ่อน สร้อยคอและต่างหูรูปหัวใจ ท้าวคางมองมาทางผู้ชม ครึ่งขวาเป็นตัวอักษรไทยสามมิติผิวขาวตัดขอบชมพูอ่านว่า โปรโมชั่น ใต้ลงมาเป็นคำว่า คืนยอดเสีย ผิวชมพูบานเย็นตัดขอบขาว แล้วตัวเลข 0.3% ตัวโตสามมิติผิวทองตัดขอบขาว ต่อท้ายด้วยคำว่า สมัครสมาชิก สีชมพูเข้มพร้อมไอคอนรูปคนกับเครื่องหมายบวกและลูกศรคู่ ขอบล่างขวามีกองชิปคาสิโนชมพู-ขาวและไพ่เอซโพแดง รอบภาพมีหัวใจชมพูสามมิติผิวมันเงาลอยกระจาย ฉากหลังเป็นกล่องของขวัญผูกริบบิ้นชมพูและดอกไม้ชมพูจาง`;

const referralAlt = `โปสเตอร์โปรโมชั่นแนวตั้งบนฉากผ้าซาตินชมพูนวลใบเดียวกัน มุมบนขวาเป็นโลโก้ ${BRAND_NAME} แบบเวิร์ดมาร์กละตินสามมิติตัวอ้วนมนผิวไล่ขาวนวลลงชมพูอ่อน ตัดขอบชมพูเข้มหนาสองชั้น โดยตัว A มีหัวใจชมพูเล็กซ้อนอยู่ในช่องกลางตัวอักษร เหนือเวิร์ดมาร์กเป็นจานวงกลมชมพูขอบขาวที่มีมาสคอตลูกหมูการ์ตูนหูตก แก้มแดง ขยิบตาข้างหนึ่ง เกาะขอบจานอยู่ ฝั่งซ้ายเป็นหญิงสาวผมยาวสีน้ำตาลผูกโบว์ริบบิ้นซาตินชมพูสองจุด สวมชุดลูกไม้ระบายสีชมพูอ่อนและต่างหูรูปหัวใจ ท้าวคางมองมาทางผู้ชม ครึ่งขวาเป็นตัวอักษรไทยสามมิติผิวขาวตัดขอบชมพูอ่านว่า โปรโมชั่น ใต้ลงมาเป็นคำว่า แนะนำเพื่อน ผิวชมพูบานเย็น ถัดลงมาเป็นคำว่า โบนัส ผิวทอง โดยมีโทรโข่งสีชมพู-ขาวเอียงพุ่งขึ้นอยู่ทางซ้ายของตัวเลข แล้วตัวเลข 0.8% ตัวโตสามมิติผิวทองตัดขอบขาว ปิดท้ายด้วยแคปซูลพื้นชมพูเข้มขอบขาวที่เขียนว่า สมัครสมาชิก พร้อมไอคอนรูปคนกับเครื่องหมายบวกและลูกศรคู่ ขอบล่างเป็นกองกล่องของขวัญสีชมพูผูกริบบิ้น และมีหัวใจชมพูสามมิติผิวมันเงาลอยกระจายทั่วภาพ`;

// อาร์เรย์เดียว ใช้ทั้งกับ <Faq> และโน้ด FAQPage — ไม่ใช้ default ของ component
// (Faq4 ตั้งใจ ship เป็นลิสต์ว่าง prop ที่ลืมส่งจึงได้ accordion เปล่า ไม่ใช่
// คำถามของแบรนด์ก่อน) สามคู่นี้คือบล็อก Q/A ของบรีฟเอง (content.txt บรรทัด 24-29)
// ตรงตัว ตัดเฉพาะหมายเลข "1." "2." "3." ออกเพราะ accordion เป็นตัวลิสต์อยู่แล้ว
// ทุกคำตอบคงประโยคกำกับของบรีฟไว้ครบ — เป็นเนื้อหาของบรีฟทั้งสองครึ่ง
const faqs = [
  {
    q: `${BRAND_NAME} มีเกมคาสิโนประเภทไหนให้เลือกบ้าง?`,
    a: `ตามข้อมูลที่ระบุ ${BRAND_NAME} นำเสนอบาคาร่าสล็อต รูเล็ต ไฮโล และคาสิโนสด โดยควรตรวจสอบรายชื่อเกมและผู้ให้บริการที่เปิดใช้งานจริงจากเว็บไซต์`,
  },
  {
    q: `${BRAND_NAME} สามารถเริ่มต้นเดิมพันด้วยเงิน 1 บาทได้หรือไม่?`,
    a: `เว็บไซต์ระบุว่าสามารถเริ่มต้นเดิมพันได้ตั้งแต่ 1 บาท แต่ยอดขั้นต่ำอาจแตกต่างกันตามประเภทเกมและค่ายผู้ให้บริการ จึงควรตรวจสอบเงื่อนไขของเกมที่ต้องการก่อนทำรายการ`,
  },
  {
    q: `${BRAND_NAME} มีโปรโมชั่นคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% หรือไม่?`,
    a: `ตามข้อมูลที่ระบุ มีโปรโมชั่นทั้งสองรายการ โดยควรตรวจสอบประเภทเกมที่เข้าร่วม รอบคำนวณยอด และเงื่อนไขการรับเครดิตจากประกาศล่าสุดก่อนใช้สิทธิ์`,
  },
];

// ไม่มี breadcrumb: นี่คือหน้าแรก เส้นทางจาก root มาหาตัวเองจะเหลือครั้งเดียวที่ชี้ตัวเอง
// ทุก URL ในกราฟมาจาก pageGraph ที่ derive จาก site: — ไม่มีโดเมนพิมพ์ไว้ในไฟล์นี้
// ไม่มี URL ที่ต่อด้วย `+` และไม่ส่งโน้ด Review / AggregateRating / sameAs /
// address / PostalAddress / email เข้าไปเลย
// `description` เป็นสตริงเดียวกับที่ MainLayout ได้รับ `name` เป็น H1 ของหน้า และ
// `faqs` เป็นอาร์เรย์ตัวเดียวกับที่ <Faq> ได้รับ
const graph = pageGraph(Astro, {
  name: pageH1,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxPremium as="h1" title={pageH1}>
    <p>
      {BRAND_NAME} เว็บเอเอ็มบีคาสิโน
      <strong class="text-[#a30d63]">นำเสนอข้อมูลเกมเดิมพันออนไลน์หลากหลายประเภท ทั้งบาคาร่า สล็อตออนไลน์ รูเล็ต ไฮโล และคาสิโนสดที่มีการถ่ายทอดเกมแบบเรียลไทม์</strong>
      พร้อมรายละเอียดระบบสมาชิกและโปรโมชั่นภายในเว็บไซต์เดียว ผู้ใช้งานสามารถศึกษากติกา รูปแบบการเดิมพัน และอัตราจ่ายของแต่ละเกมผ่านโทรศัพท์มือถือหรือคอมพิวเตอร์ได้ โดยควรตรวจสอบรายชื่อผู้ให้บริการเกม เงื่อนไขการใช้งาน และความน่าเชื่อถือของแพลตฟอร์มก่อนทำรายการ
      <strong class="text-[#a30d63]">เนื่องจากเกมเดิมพันมีความเสี่ยงและไม่สามารถรับประกันผลรางวัลได้</strong>
    </p>
  </ContentBoxPremium>

  <ContentBoxTwoCyberCut as="h2" title={`${BRAND_NAME} บาคาร่า สล็อต รูเล็ต ไฮโล เริ่มต้น1บาท ไลฟ์เดิมพัน 24 ชั่วโมง`}>
    <p slot="left">
      {BRAND_NAME}
      <strong class="text-[#a30d63]">รวบรวมข้อมูลเกมคาสิโนหลายรูปแบบ</strong>
      ไม่ว่าจะเป็นบาคาร่าออนไลน์ที่มีตัวเลือกเดิมพันตามกติกาเกมสล็อตที่มีธีมและฟีเจอร์แตกต่างกัน รูเล็ตที่ใช้การหมุนวงล้อ และไฮโลที่อ้างอิงผลจากลูกเต๋า
      <strong class="text-[#a30d63]">รวมถึงคาสิโนสดที่มีการถ่ายทอดเกมจากโต๊ะเดิมพัน</strong>
    </p>
    <p slot="right">
