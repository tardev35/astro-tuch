---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import LatestWinners from "../components/LatestWinners2.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBox3ThreeNeumorphism from "../components/ContentBox3ThreeNeumorphism.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import Faq from "../components/Faq2.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import { pageGraph } from "../lib/schema";
import promoCashback from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";

// การหมุน variant รอบนี้ตัดสินไว้แล้วใน .claude/brand-spec-okkub88.md §3 —
// **ห้ามเลือกใหม่ที่นี่** แบรนด์ขาออก (โบ๊ะบ๊ะ168) ถูกหมุนออกจากทุกตระกูลพร้อมกัน:
// Announcement3 แทน Announcement ตัวฐาน · LatestWinners2 แทน LatestWinners3 ·
// Faq2 แทน Faq4 · และ shape-mix ของ ContentBox ทิ้งชุด Premium / Two (ฐาน) /
// CyberCut / SevenThreePremium / SevenThreeCyberCut / 3ThreePremium ของรอบก่อน
// ทั้งชุด ไปใช้ **Neumorphism (นูนนุ่มสามมิติ) + ตัวฐาน** แทน
// — **ไม่ทับไฟล์เดิมแม้แต่ตัวเดียว** Navbar/Footer อยู่ที่ MainLayout
// (NavbarStyle5 -> NavbarStyle8, FooterStyle2 -> FooterStyle3) ไม่ใช่ที่ไฟล์นี้
// ❌ **รอบนี้ไม่ใช้ *FloatingBadge สักตัว** (§3 — badge ยัง whitespace-nowrap และ
// หัวข้อ docx รอบนี้ยาวมาก h1 ยาว 54 ตัวอักษร จะล้น viewport มือถือแน่นอน)
// `ContentBoxSpecial` กับ `ReviewCardSumo2` คงตัวเดิมตาม §7 (ตัวแรกเป็นสมาชิกเดียว
// ของตระกูล ตัวหลัง sibling เก่าไม่มี aria-label บน <section> = บิลด์แดง)
//
// ⚠️⚠️ รอบนี้ยังเป็น **ธีมสว่างเหมือนรอบก่อน แต่คนละตระกูลฮิวสิ้นเชิง**
// พาเลต (brand-spec §2 ล็อกค่าไว้ ห้ามเดาเพิ่ม): พื้นเพจ #ffd6fa ชมพูบับเบิลกัม
// พาสเทล (bg.json) · การ์ด #ffffff · ผิวยก #fff4fb · wash #ffe3f5 ·
// เส้น #f9b2d9 / #f479b9 · หมึก #6a0f3c (= BRAND_TEXT) · หมึกรอง #95486b ·
// **หัวข้อ + ไฮไลต์ #9c0f55** · ฮิวนำ #fb439b · พาสเทล #fc74b5 / #ffc2e2 ·
// ปุ่มหลักไล่ #d91a73 -> #b01160 -> #85094a บนหมึกขาว
// 🚨🚨 **ขาวบน #fb439b ได้แค่ 3.3:1 และบน #ffd6fa ได้ 1.2:1 → ห้ามเด็ดขาด**
// พื้นที่รับหมึกขาวต้องเป็น #d91a73 ลงไป · **#fb439b บนพื้นขาวก็ได้แค่ 3.3:1
// → ห้ามเป็นสีตัวอักษรบนผิวสว่าง**
// `<strong>` ทุกตัวในไฟล์นี้จึงเป็น **#9c0f55 ค่าเดียว** (8.1:1 บนขาว ·
// 7.7:1 บนผิวยก #fff4fb) ไม่ใช่ #fb439b
// ⚠️ #f9b2d9 #f479b9 #fc74b5 #ffc2e2 #fb439b #ffd6fa **ห้ามถือตัวอักษรบนผิวสว่าง**
// (เส้น/พื้น/ออราเท่านั้น)
// ⚠️⚠️ **แบรนด์นี้ชมพู และ หมูบิน168 เมื่อสองรอบก่อนก็ชมพู "เจอชมพู ≠ เป็นของ
// รอบนี้" ต้องเทียบด้วยค่า**: fa539c c2185b 8e0f41 fb8cc0 fdc6c3 ffd1cd f7bcd9
// ef8dbd ffe5ff fff0f8 ffeef7 3b0b26 54123a 7a2350 ffe9f5 7a4463 (หมูบิน168 —
// **fb8cc0 มี R=fb ตรงกับ #fb439b เป๊ะ · f7bcd9 มี B=d9 ตรงกับ #f9b2d9 เป๊ะ ·
// ffe9f5 ต่างจาก #ffe9f7 แค่ไบต์สุดท้าย**) และชุดฟ้าสกายของ **โบ๊ะบ๊ะ168 แบรนด์
// ขาออก = เสี่ยงหลงเหลือสูงสุด** (00bfff 12b4ef b6e3f0 7fcbe8 4fb8ea 06283f 0b4a73
// 2a87c4 eaf7ff f0faff e4f6fb 355f7d 0f5684 1a6ea8) ซึ่งเคยอยู่ทั้งไฟล์นี้ —
// ออกครบทุกค่าแล้ว · ค่าของเจ้าอื่น: f41571 ff5ca8 (PUNPRO168 — ใกล้ #fb439b ที่สุด)
// f5469f ff8dc6 8c0f52 (มีโชค168) fa63b9 ffb3de (ถอนชัวร์168) dd1b74 a4186b
// (มีทรัพย์168) b00d11 (สล็อต168 — **b01 ตรงกับ #b01160 สี่ตัวแรก**)
// ⚠️ **รอบนี้ไม่มีฟ้า/ไซแอน/น้ำเงินสักเฉด ไม่มีเขียวมิ้นต์ ไม่มีทอง/เหลือง
// ไม่มีส้ม ไม่มีม่วง ไม่มีครีม/เบจ และไม่มีแรมป์เทาเงิน** (ยกเว้น LINE green และ
// เขียว success ของฟีดซึ่งอยู่ไฟล์อื่น)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep สะดุดที่คอมเมนต์นี้)
//
// ย่อหน้าในไฟล์นี้ไม่ถือคลาสสีหรือขนาดของตัวเอง — ทุก ContentBox* ในมิกซ์นี้ตั้ง
// `text-left text-base leading-relaxed text-[#6a0f3c]` ไว้บน element ที่ถือ slot
// อยู่แล้ว และไม่มี `<p>` ไหนมี mx-auto / max-w-* (การ์ดคุมความกว้างเองแล้ว)
//
// ⚠️ **ชื่อแบรนด์รอบนี้เป็นตัวละตินพิมพ์เล็กล้วน `okkub88`** (กลับทิศจากรอบก่อนที่
// ห้ามเขียนละติน) แต่ยัง interpolate จาก `${BRAND_NAME}` ทุกจุดรวมถึงใน alt ของ
// สองสไลด์ **ห้ามพิมพ์ OKKUB88 / OkKub88 ที่ไหน** (เวิร์ดมาร์กบนโลโก้เขียน
// stylised เป็นอาร์ตเวิร์ก ไม่ใช่การสะกด) ไม่มีโดเมนเขียนไว้ที่ไหน และไม่มี URL
// ที่ต่อด้วย `+`
//
// <strong> ทุกตัวคร่อม "ก้อนที่คั่นด้วยช่องว่าง" ทั้งก้อน เพราะภาษาไทยไม่มีช่องว่าง
// ระหว่างคำ — ไฮไลต์ที่เริ่มหรือจบกลางคำจะถูก formatter ตัดบรรทัดในแท็กแล้วแทรก
// ช่องว่างกลางคำ อ่านคอปปี้โดยถอดแท็กออกต้องได้ข้อความของบรีฟเป๊ะ และไม่มี <strong>
// สองตัวติดกันโดยไม่มีข้อความธรรมดาคั่น
//
// บรีฟรอบนี้ **โฆษณาและกำกับในประโยคเดียวกัน** (brand-spec §5): หัวข้อของบรีฟเอง
// เขียนว่า เว็บสล็อตเงินดี / ทางเข้าเล่นง่าย / ยูสใหม่แตกไว / รับโปรไม่อั้น /
// โบนัสแจกทั้งวันไม่จำกัด / ฝากถอนไม่มีขั้นต่ำ ขณะที่ย่อหน้าของบรีฟเองตอบกลับว่า
// คำกล่าวอ้างว่ายูสใหม่แตกไวไม่สามารถใช้รับประกันผลรางวัลได้ เพราะเกมสล็อตมีผลลัพธ์
// ที่ไม่แน่นอนในแต่ละรอบ · แม้จะมีข้อความระบุว่าแจกโบนัสทั้งวันไม่จำกัด แต่ควร
// ยืนยันรายละเอียดจากประกาศล่าสุด · การคืนเครดิตไม่ได้หมายความว่าจะได้รับเงินคืน
// จากทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งต่อไป · แม้จะมีข้อความว่าฝากถอนไม่มี
// ขั้นต่ำ แต่ควรตรวจสอบวงเงินต่อรายการ —
// **ship ทั้งสองครึ่งตรงตามที่บรีฟเขียน ไม่ขยายคำโฆษณาเป็นคำกล่าวอ้างใหม่ และ
// ทุกประโยคกำกับ ship ครบ ไม่ตัดเพราะฟังดูลบ**
// ตัวเลขบนหน้านี้มีแค่ของบรีฟเอง: **0.3% · 0.8% · 3 ขั้นตอน · 24ชม.** ไม่มีตัวเลข
// RTP ไม่มีจำนวนเกม/ค่าย ไม่มีปีก่อตั้ง ไม่มีจำนวนสมาชิก ไม่มี 100% และไม่มี 1 บาท
// 🚨 **บรีฟรอบนี้เขียน "ทรูวอลเลท" เท่านั้น — "ทรูมันนี่" เป็นคำของโบ๊ะบ๊ะ168
// รอบก่อน และเป็นคำที่พลาดง่ายที่สุดของรอบนี้** · คำของ **โบ๊ะบ๊ะ168 (รอบก่อน
// ทันที)** ที่ห้ามเขียนกลับเข้ามา: โบ๊ะบ๊ะ · เกมสล็อตสนุกสุดมันส์ · เว็บตรงแตกง่าย ·
// เบทต่ำ · เบทต่ำ 1 บาท · ไม่ทำเทิร์น · รวมค่ายดัง · ใช้ทุนเล่นน้อย ·
// ถอนได้ไม่จำกัด · สล็อตคลาสสิก · เกมโบนัส — ไฟล์เดิมสร้างอยู่บนคำเหล่านี้ทั้งหน้า
// และไม่มีคำไหนอยู่ในบรีฟรอบนี้เลย · และคำของ **หมูบิน168 (N-2)**: หมูบิน ·
// เกมสล็อตแท้ · เว็บตรงถูกลิขสิทธิ์ · เชื่อถือได้ · ไม่จำกัดยอด · ไม่มีคำหมวดหวย
// สักคำ (รอบนี้เป็นเว็บสล็อต)
//
// title/description = บรรทัด 1-2 ของบรีฟตรงตัว (src/assets/content.txt) และตรงกับ
// ค่า default ของ MainLayout อยู่แล้ว — ส่งซ้ำที่นี่เพราะ pageGraph ต้องใช้สตริง
// เดียวกัน **ห้ามต่อเติม** (description = 152 ตัวอักษร อยู่ในช่วง 150-160 พอดี)
const pageTitle = `${BRAND_NAME} เว็บสล็อตเงินดี เล่นง่าย ยูสใหม่แตกไว โบนัสแจกทั้งวัน`;

const pageDescription = `${BRAND_NAME} เว็บสล็อตเงินดี ทางเข้าเล่นง่าย ยูสใหม่แตกไว สมัครสมาชิกรับโปรไม่อั้น โบนัสแจกทั้งวันไม่จำกัด ฝากถอนไม่มีขั้นต่ำ รองรับทุกธนาคารและวอลเลท`;

const pageH1 = `${BRAND_NAME} เว็บสล็อตเงินดี ทางเข้าเล่นง่าย ยูสใหม่แตกไว`;

// บรีฟรอบนี้มีชั้น H1 -> H2 -> H3 จริง จึง **ไม่** แบนเป็น H2 ล้วน
//
// checklist ตามลำดับเอกสาร (brand-spec §4) และตัวที่รับแต่ละข้อ:
//    1 H1  ${BRAND_NAME} เว็บสล็อตเงินดี ทางเข้าเล่นง่าย ยูสใหม่แตกไว
//          ContentBoxNeumorphism, ย่อหน้าบรรทัด 4
//    2 H2  สมัครสมาชิก ${BRAND_NAME} รับโปรไม่อั้น โบนัสแจกทั้งวันไม่จำกัด
//          ContentBoxTwoNeumorphism, บรรทัด 6 ซ้าย + ลิสต์ไฮไลต์ (ไม่ใช่หัวข้อ) ขวา
//    3 H3  ขั้นตอนสมัครสมาชิก ${BRAND_NAME} ง่าย ๆ เพียง 3 ขั้นตอน
//          ContentBox (ตัวฐาน — จังหวะคั่นกลางชุด Neumorphism โดยตั้งใจ),
//          บรรทัด 8 + สามขั้นตอนจากบรรทัด 9-14
//    4 H2  โปรโมชั่น ${BRAND_NAME} เปิดรับสมาชิกใหม่ทุกวัน
//          ContentBoxNeumorphism, บรรทัด 16
//    5 H3  โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน
//          ContentBoxSevenThreeNeumorphism + slide1, บรรทัด 18 ซ้าย / ภาพขวา
//    6 H3  โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด
//          ContentBoxSevenThree (ตัวฐาน) + slide2, บรรทัด 20 ซ้าย / ภาพขวา
//    7 H2  ฝากถอน ${BRAND_NAME} ทุกธนาคารและทรูวอลเลท
//          ContentBox3ThreeNeumorphism, บรรทัด 22 แบ่งสามส่วนโดยไม่ตกประโยคไหน
//    8 H2  ติดต่อแอดมินเว็บ ${BRAND_NAME} ตลอด 24ชม.
//          ContentBoxSpecial, บรรทัด 24 แบ่งสองซีก
//    9 H2  คำถามที่พบบ่อยเกี่ยวกับ ${BRAND_NAME}
//          Faq2 + prop faqs ชัดเจน, บรรทัด 26-31
// inventory ที่ต้องได้: **h1 ×1 · h2 ×5 · h3 ×3** — ตรงเป้าของ brand-spec §4
//
// ⚠️ จุดที่ชั้น heading รั่วได้ และกันไว้แล้วทุกจุด: §3 **ไม่ใช้ FeatureHighlights**
// เพราะมัน render `title` ของแต่ละข้อเป็น <h3> ซึ่งจะทำให้ h3 กลายเป็น 6 ตัวและได้
// h3 ซ้อนใต้ h3 — บรรทัด 9/11/13 ของบรีฟไม่มี prefix H1/H2/H3 จึงเป็นย่อหน้า
// ธรรมดา render เป็น <p class="font-bold"> · ContentBoxTwoNeumorphism และ
// ContentBox3ThreeNeumorphism มีป้ายคอลัมน์ได้ แต่หน้านี้ **ไม่ส่งป้ายสักใบ**
// (ไม่มี titleleft/titlecenter/titleright) เพราะบรีฟไม่ได้ตั้งชื่อให้คอลัมน์ ·
// ContentBox3ThreeNeumorphism ยังมี prop `heading` ที่คาที่ false ได้ถ้ารอบหน้า
// ต้องใช้ป้าย · **ไม่ส่ง titleright ให้ SevenThree ทั้งสองบล็อก** คอลัมน์ภาพจึง
// ไม่มี heading · คำถามใน Faq2 เป็น <span> ใน <summary> ไม่ใช่ <h3> ·
// ContentBoxSpecial ไม่ส่ง `actions` จึงไม่มีสล็อตที่สามโผล่มา
// grep `<h[1-6]` ในทุก component ที่ไฟล์นี้กับ MainLayout เรียกแล้วรอบนี้ — ไม่มี
// ตัวไหน hardcode heading ไว้เลย ทุกแท็ก heading บนหน้ามาจาก prop คือมาจากบรีฟ
//
// ทั้ง ContentBoxSevenThree* วาง md:grid-cols-[7fr_3fr] โดยให้ **คอลัมน์ข้อความ
// มาก่อน** ภาพจึงไปอยู่ slot="right" ทุกครั้ง: heading ลงบนเนื้อความไม่ใช่บนภาพ
// และบนมือถือคอลัมน์เดียวอ่านลำดับ หัวข้อ -> ข้อความ -> ภาพ ไม่ใช่เปิดด้วยรูป
// สองบล็อกนี้คือ **เพดาน 2 บล็อกของตระกูล SevenThree พอดี** และ **สไลด์ขึ้นได้
// เฉพาะในสองบล็อกนี้เท่านั้น** (ห้ามเพิ่ม SmoothCarousel — มัน render slide* นอก
// SevenThree ซึ่งผิดกฎแข็งของ playbook)
// การจับคู่สไลด์อ่านจากตัวอักษรบนภาพเอง (เปิดรูปอ่านใหม่รอบนี้แล้ว): **slide1
// พิมพ์ โปรโมชั่น + แคปซูล คืนยอดเสีย + 0.3% -> §5** · **slide2 พิมพ์ โปรโมชั่น +
// แคปซูล แนะนำเพื่อน + 0.8% -> §6** (ทั้งสองใบปิดท้ายด้วยแคปซูล แจกโบนัสทั้งวัน)
// uploader เขียนทับไฟล์ทุกดรอป เลขในชื่อไฟล์จึงไม่มีความหมายข้ามแบรนด์
// ⛔ **slide3.png / slide4.png / banner2.png / banner3.png เป็นอาร์ตเวิร์กของ
// แบรนด์อื่น ห้าม import เด็ดขาด** เพราะ eager import = emit ขึ้น dist ทุก build
// แม้ไม่มีหน้าไหน render — **รอบนี้จึงไม่มี "รูปประกอบบทความ" (banner2+) เลย**
// และนั่นถูกต้องตาม playbook
// ⚠️ **banner1 / banner1-mobile / og.png เป็นของ MainLayout** (glob ปักชื่อไว้แล้ว)
// ห้าม import ที่ไฟล์นี้ · ไม่มีภาพไหนบนหน้านี้เป็น LCP จึง **ไม่มี
// loading="eager" / fetchpriority="high"** สักใบ สไลด์ทั้งสองอยู่ใต้ fold
// ⚠️ `widths`/`sizes` ของสองบล็อกนี้ **ต่างกันจริง** เพราะเรขาคณิตของการ์ดต่างกัน
// (§5 แคป max-w-[1400px] · p-8/md:p-10 · gap-8 · คอลัมน์ภาพจ่าย md:border-l +
// md:pl-8 -> 343px / calc(30vw - 77px) ส่วน §6 แคป max-w-7xl · p-8/md:p-10 ·
// gap-10 · คอลัมน์ภาพจ่าย md:pl-6 โดยไม่มี border -> 314px / calc(30vw - 70px))
// ที่มาของตัวเลขเขียนไว้ใน frontmatter ของแต่ละ component **ห้ามลอกข้ามไฟล์** ·
// บิตแมปจริงของสไลด์ทั้งคู่คือ **375x600** (อ่านจาก IHDR) เพดาน candidate จึงเป็น
// 375 ห้าม upscale
//
// ที่เหลือบนหน้าเป็น chrome และไม่ออกแท็ก heading ที่ระดับไหนเลย: Announcement3,
// LatestWinners2 และ ReviewCardSumo2 ขึ้นชื่อหัวข้อเป็น <p>/<span> พร้อม aria-label
// บน <section> · ticker วางก่อน §1 ส่วนฟีดรายการกับการ์ดรีวิว/Navfoot วาง **หลัง
// §9 ทั้งหมด** เพื่อไม่ให้วิดเจ็ตคั่นกลางสองหัวข้อ docx ตาม playbook Phase 2
//
// <Announcement /> เรียกเปล่าโดยตั้งใจ: orchestrator ตั้ง default message ของ
// Announcement3 เป็นคอปปี้ของแบรนด์นี้ไว้แล้วใน P1 และหน้าย่อยก็เรียกเปล่า
// เหมือนกัน — ticker จึงตรงกันทั้งเว็บจากแหล่งเดียว

// อาร์เรย์เดียว ใช้ทั้งกับ <Faq> และโน้ด FAQPage — ไม่ใช้ default ของ component
// (Faq2 ตั้งใจ ship เป็นลิสต์ว่าง prop ที่ลืมส่งจึงได้ accordion เปล่า ไม่ใช่
// คำถามของแบรนด์ก่อน) สามคู่นี้คือบล็อก Q/A ของบรีฟเอง (content.txt บรรทัด 26-31)
// ตรงตัว ตัดเฉพาะหมายเลข "1." "2." "3." ออกเพราะ accordion เป็นตัวลิสต์อยู่แล้ว
// ทุกคำตอบคงประโยคกำกับของบรีฟไว้ครบ — เป็นเนื้อหาของบรีฟทั้งสองครึ่ง
const faqs = [
  {
    q: `${BRAND_NAME} เปิดรับสมัครสมาชิกใหม่ทุกวันหรือไม่?`,
    a: `ตามข้อมูลที่ระบุ ${BRAND_NAME} มีช่องทางสมัครสมาชิกใหม่ โดยควรตรวจสอบสถานะการเปิดรับสมัครและเงื่อนไขการลงทะเบียนจากเว็บไซต์ทางการก่อนดำเนินการ`,
  },
  {
    q: `${BRAND_NAME} มีโปรโมชั่นคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% หรือไม่?`,
    a: `ตามข้อมูลที่ระบุ มีโปรโมชั่นทั้งสองรายการ แต่ควรตรวจสอบรอบคำนวณยอด วิธีรับเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุดก่อนรับสิทธิ์`,
  },
  {
    q: `${BRAND_NAME} ฝากถอนผ่านธนาคารและทรูวอลเลทได้หรือไม่?`,
    a: `เว็บไซต์ระบุว่ารองรับธนาคารและทรูวอลเลท โดยควรตรวจสอบรายชื่อบริการที่ใช้งานได้จริง ยอดขั้นต่ำ วงเงินถอน และชื่อบัญชีรับเงินก่อนทำรายการทุกครั้ง`,
  },
];

// ไม่มี breadcrumb: นี่คือหน้าแรก เส้นทางจาก root มาหาตัวเองจะเหลือครั้งเดียวที่ชี้ตัวเอง
// ทุก URL ในกราฟมาจาก pageGraph ที่ derive จาก site: — ไม่มีโดเมนพิมพ์ไว้ในไฟล์นี้
// ไม่มี URL ที่ต่อด้วย `+` และไม่ส่งโน้ด Review / AggregateRating / sameAs /
// address / email เข้าไปเลย
// `description` เป็นสตริงเดียวกับที่ MainLayout ได้รับ `name` เป็น H1 ของหน้า และ
// `faqs` เป็นอาร์เรย์ตัวเดียวกับที่ <Faq> ได้รับ
const graph = pageGraph(Astro, {
  name: pageH1,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxNeumorphism as="h1" title={pageH1}>
    <p>
      {BRAND_NAME} นำเสนอเกมสล็อตออนไลน์หลากหลายรูปแบบ
      <strong class="text-[#9c0f55]">พร้อมระบบสมาชิกที่รวบรวมข้อมูลเกม โปรโมชั่น และช่องทางฝากถอนไว้ในเว็บไซต์เดียว</strong>
      ผู้ใช้งานสามารถศึกษากติกาเกม ตรวจสอบเงื่อนไขโบนัส และเลือกดูรายละเอียดค่ายเกมที่สนใจได้ โดยเฉพาะสมาชิกใหม่ที่ควรทำความเข้าใจระบบก่อนใช้งาน ทั้งนี้
      <strong class="text-[#9c0f55]">คำกล่าวอ้างว่ายูสใหม่แตกไวไม่สามารถใช้รับประกันผลรางวัลได้</strong>
      เพราะเกมสล็อตมีผลลัพธ์ที่ไม่แน่นอนในแต่ละรอบ
    </p>
  </ContentBoxNeumorphism>

  <ContentBoxTwoNeumorphism as="h2" title={`สมัครสมาชิก ${BRAND_NAME} รับโปรไม่อั้น โบนัสแจกทั้งวันไม่จำกัด`}>
    <p slot="left">
      {BRAND_NAME} นำเสนอข้อมูลการสมัครสมาชิกและโปรโมชั่นสำหรับผู้ใช้งานใหม่ โดยมีรายละเอียดเกี่ยวกับการลงทะเบียน การเข้าสู่ระบบ และสิทธิพิเศษที่เว็บไซต์ประกาศไว้
      <strong class="text-[#9c0f55]">สมาชิกควรตรวจสอบเงื่อนไขของแต่ละโปรโมชั่นก่อนรับโบนัส โดยเฉพาะจำนวนครั้งที่รับสิทธิ์ได้ ยอดที่ใช้คำนวณเครดิต และข้อกำหนดการถอนเงิน</strong>
      แม้จะมีข้อความระบุว่าแจกโบนัสทั้งวันไม่จำกัด แต่ควรยืนยันรายละเอียดจากประกาศล่าสุดเพื่อให้เข้าใจสิทธิ์ที่ได้รับอย่างถูกต้อง
    </p>
    <ul slot="right" class="list-disc space-y-2 pl-5">
      <li>เปิดรับสมาชิกใหม่ทุกวัน ตามที่เว็บไซต์ระบุไว้</li>
      <li>รับโปรไม่อั้น โบนัสแจกทั้งวันไม่จำกัด โดยควรตรวจสอบเงื่อนไขก่อนรับโบนัสทุกครั้ง</li>
      <li>ฝากถอนไม่มีขั้นต่ำ ทุกธนาคารและทรูวอลเลท โดยควรตรวจสอบวงเงินต่อรายการ</li>
      <li>แอดมินตลอด 24ชม. โดยควรตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุด</li>
    </ul>
  </ContentBoxTwoNeumorphism>

  <ContentBox as="h3" title={`ขั้นตอนสมัครสมาชิก ${BRAND_NAME} ง่าย ๆ เพียง 3 ขั้นตอน`}>
    <div class="flex flex-col gap-4">
      <p>
        การสมัครสมาชิก {BRAND_NAME} สามารถศึกษาขั้นตอนทั่วไปได้จากเมนูลงทะเบียนของเว็บไซต์
        <strong class="text-[#9c0f55]">โดยควรตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง อ่านเงื่อนไขการใช้บริการ และตรวจสอบข้อกำหนดด้านอายุกับกฎหมายที่เกี่ยวข้องก่อนดำเนินการ</strong>
      </p>
      <p class="font-bold text-[#9c0f55]">ขั้นตอนที่ 1 เข้าสู่หน้าสมัครสมาชิก</p>
      <p>เปิดเว็บไซต์ผ่านช่องทางที่ตรวจสอบได้ จากนั้นเลือกเมนูสมัครสมาชิกและศึกษาข้อกำหนดการเปิดบัญชี รวมถึงนโยบายการจัดเก็บข้อมูลส่วนบุคคลก่อนกรอกข้อมูล</p>
      <p class="font-bold text-[#9c0f55]">ขั้นตอนที่ 2 กรอกข้อมูลและยืนยันบัญชี</p>
      <p>กรอกข้อมูลตามที่ระบบกำหนด ตรวจสอบความถูกต้องก่อนยืนยัน และตั้งรหัสผ่านที่ปลอดภัย ไม่ควรใช้ข้อมูลของบุคคลอื่นหรือเปิดเผยรหัส OTP ให้ใครทราบ</p>
      <p class="font-bold text-[#9c0f55]">ขั้นตอนที่ 3 เข้าสู่ระบบและตรวจสอบโปรโมชั่น</p>
      <p>
        หลังลงทะเบียนเรียบร้อย สามารถศึกษารายชื่อเกมสล็อต กติกาการเล่น และรายละเอียดโปรโมชั่นสำหรับสมาชิกใหม่ หากมีข้อสงสัยเกี่ยวกับเงื่อนไขโบนัสควรสอบถามเจ้าหน้าที่ผ่านช่องทางทางการก่อนทำรายการ
      </p>
    </div>
  </ContentBox>

  <ContentBoxNeumorphism as="h2" title={`โปรโมชั่น ${BRAND_NAME} เปิดรับสมาชิกใหม่ทุกวัน`}>
    <p>
      {BRAND_NAME} นำเสนอข้อมูลโปรโมชั่นสำหรับสมาชิกใหม่และสมาชิกปัจจุบัน
      <strong class="text-[#9c0f55]">โดยมีรายการคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8% เป็นสิทธิพิเศษที่ระบุไว้</strong>
      แต่ละรายการอาจมีเงื่อนไขเกี่ยวกับประเภทเกม ยอดที่นำมาคำนวณ รอบรับเครดิต และจำนวนครั้งที่เข้าร่วมแตกต่างกัน
      <strong class="text-[#9c0f55]">ผู้ใช้งานควรติดตามประกาศโปรโมชั่นล่าสุดและตรวจสอบข้อกำหนดให้ครบถ้วนก่อนรับสิทธิ์</strong>
    </p>
  </ContentBoxNeumorphism>

  <ContentBoxSevenThreeNeumorphism as="h3" title="โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน">
    <p slot="left">
      โปรโมชั่นคืนยอดเสีย 0.3% เป็นรายการที่ระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขรายวัน
      <strong class="text-[#9c0f55]">
        สมาชิกควรตรวจสอบว่าเกมสล็อตประเภทใดเข้าร่วมรายการ มีรอบสรุปยอดเวลาใด และต้องกดรับเครดิตด้วยตนเองหรือระบบดำเนินการให้อัตโนมัติ
      </strong>
      รวมถึงศึกษาข้อกำหนดการใช้เครดิตและการถอนเงินให้ครบถ้วน เพราะยอดเสียบางรายการอาจไม่เข้าเกณฑ์รับสิทธิ์ ทั้งนี้
      <strong class="text-[#9c0f55]">การคืนเครดิตไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งต่อไป</strong>
    </p>
    <Picture
      slot="right"
      src={promoCashback}
      loading="lazy"
      fetchpriority="low"
      widths={[172, 257, 343, 375]}
      sizes="(min-width: 1400px) 343px, (min-width: 768px) calc(30vw - 77px), (min-width: 473px) 375px, calc(100vw - 98px)"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={64}
      alt={`โปสเตอร์โปรโมชั่นของ ${BRAND_NAME} บนฉากสตูดิโอพื้นขาวอมชมพู ด้านหน้าเป็นหญิงสาวผมยาวสีน้ำตาลเข้ม ขยิบตาหนึ่งข้างและยิ้มกว้าง สวมเสื้อสายเดี่ยวลูกไม้ขาว ยกโทรศัพท์ขึ้นด้วยมือข้างหนึ่งและกำหมัดดีใจด้วยอีกข้าง ข้างซ้ายเป็นหมูการ์ตูนชมพูกอดหัวใจ รอบภาพมีหัวใจชมพู เหรียญทอง กล่องของขวัญชมพู และวงล้อสล็อตที่มีเลข 7 ประดับอยู่ มุมบนซ้ายเป็นโลโก้ ${BRAND_NAME} ซึ่งเป็นตัวอักษรเจลลี่สามมิติชมพูบับเบิลกัมตัดขอบขาวหนา โดยตัวแรกเป็นหน้าการ์ตูนกลมสีชมพูขยิบตาและชูสองนิ้ว ครึ่งล่างของภาพพิมพ์คำว่า โปรโมชั่น เป็นตัวอักษรเจลลี่ชมพูตัวโตคู่กับโทรโข่ง ใต้ลงมาเป็นแคปซูลพื้นขาวเขียนว่า คืนยอดเสีย แล้วตามด้วยเลข 0.3% ตัวเจลลี่ตัวโต ท้ายภาพเป็นแคปซูลพื้นขาวขอบชมพูเขียนว่า แจกโบนัสทั้งวัน`}
      class="mx-auto h-auto w-full max-w-[375px] rounded-2xl border border-[#f9b2d9] shadow-[0_10px_24px_rgba(156,15,85,0.18)]"
    />
  </ContentBoxSevenThreeNeumorphism>

  <ContentBoxSevenThree as="h3" title="โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด">
    <p slot="left">
      โปรโมชั่นแนะนำเพื่อนโบนัส 0.8% เป็นรายการที่ระบุสิทธิ์สำหรับสมาชิกที่แนะนำผู้ใช้งานรายใหม่
      <strong class="text-[#9c0f55]">โดยควรตรวจสอบวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และฐานยอดที่ใช้คำนวณโบนัสให้ชัดเจน</strong>
      แม้จะมีข้อความว่าไม่จำกัด แต่ควรยืนยันจำนวนบัญชีที่เข้าร่วมได้ รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุด
      <strong class="text-[#9c0f55]">เพื่อป้องกันความเข้าใจคลาดเคลื่อนเกี่ยวกับจำนวนเครดิตที่มีสิทธิ์ได้รับ</strong>
    </p>
    <Picture
      slot="right"
      src={promoReferral}
      loading="lazy"
      fetchpriority="low"
      widths={[157, 235, 314, 375]}
      sizes="(min-width: 1280px) 314px, (min-width: 768px) calc(30vw - 70px), (min-width: 473px) 375px, calc(100vw - 98px)"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={64}
