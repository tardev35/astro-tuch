---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import LatestWinners from "../components/LatestWinnersPremium.astro";
import ContentBox from "../components/ContentBox.astro";
import Faq from "../components/Faq2.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// SLIDE ROLES FOR THIS DROP (2026-09-21) — READ BEFORE REUSING THESE IMPORTS.
// Both posters were opened and read: slide2.png prints "โปรโมชั่นคืนยอดเสีย 0.3%"
// so it belongs to docx H3 #4, and slide1.png prints "โปรโมชั่นแนะนำเพื่อน 0.8%"
// so it belongs to docx H3 #5. The pairing is NOT stable across brands — re-open
// the posters next rebrand instead of copying this forward. This drop's artwork
// is ROYAL PURPLE + GOLD; any alt text on this page describing a black-and-gold
// or red poster is left over from an earlier brand and is wrong.
//
// slide3.png (2026-09-18) and slide4.png (2026-08-13) are deliberately NOT
// imported: both predate this drop and carry a previous client's artwork.
// banner2.png (2026-08-20) and banner3.png (2026-08-11) are stale for the same
// reason, so there is no single-column ContentBox inline illustration this
// round. banner1 / banner1-mobile belong to MainLayout's own pinned globs and
// are never referenced from a page — the hero is the LCP element, so nothing
// here gets loading="eager" fetchpriority="high".
//
// A slide may only ever live inside a ContentBoxSevenThree*. Two of them is the
// family's hard cap per rebrand and this page spends the whole budget.
//
// Rotated out of this round's mix and NOT deleted from disk (they are inventory
// for the next brand): Announcement5, ContentBoxCyberCut, ContentBoxTwoPremium,
// ContentBoxSevenThreePremium, ContentBoxSevenThree, ContentBoxNeumorphism,
// ContentBoxPremium, ProviderGridPremium, LatestWinners4 and Faq3.

// Title and description are the brief's own Title/Description lines, used
// verbatim. A brief-supplied description is never padded up to the 150-char
// floor and never topped up from the H1/H2.
const pageTitle = "FAH999 สล็อตออโต้Top3 เว็บตรง ติดอันดับมาแรง";

const pageDescription = "FAH999 สล็อตออโต้Top3 รวมเกมยอดนิยม แตกง่าย แจ็คพอตเข้าไว การันตีเชื่อถือได้ สมัครเว็บตรงติดอันดับมาแรงต้องที่นี่ที่เดียว";

// <Announcement /> runs bare: Announcement3's default message is already this
// brand's copy, and every sub-page calls it bare too — passing an override here
// is how the ticker ends up saying two different things on two pages.

// The docx has a real H1 -> H2 -> H3 hierarchy this round: #4 and #5 are genuine
// H3 sub-points of H2 #3 (โปรโมชั่น), so the page is NOT flattened to H2-only.
// They are the only <h3> on the site and they are carried by the two SevenThree
// blocks. Everything else here is chrome — ProviderGrid, LatestWinnersPremium,
// LoginRtpSection and ReviewCardSumo2 all render their titles as <p>/<span> with
// an aria-label on the section, and Faq2's questions stay <span> inside
// <summary>, so none of them emits a heading.
// Final inventory for this page: h1 x1, h2 x5, h3 x2.

// One array, used by both <Faq> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last. The three pairs
// are the brief's own Q/A block, verbatim.
const faqs = [
  {
    q: "FAH999 มีเกมสล็อตประเภทไหนให้เลือกบ้าง?",
    a: "ภายในระบบมีเกมสล็อตจากหลายค่าย ทั้งเกมยอดนิยม เกมโบนัส เกมแจ็คพอต และเกมใหม่ที่อัปเดตตามช่วงเวลา สมาชิกสามารถเลือกดูตามหมวดหมู่และตรวจสอบรายละเอียดของแต่ละเกมได้ก่อนเข้าเล่น",
  },
  {
    q: "โปรโมชั่น FAH999 มีอะไรบ้าง?",
    a: "โปรโมชั่นหลักตามข้อมูลที่กำหนดมีโบนัสคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8% โดยแต่ละรายการมีเงื่อนไขและวิธีรับสิทธิ์แตกต่างกัน ควรตรวจสอบรายละเอียดจากหน้าโปรโมชั่นก่อนกดรับทุกครั้ง",
  },
  {
    q: "หากฝากถอนหรือเข้าเว็บไม่ได้ควรทำอย่างไร?",
    a: "แนะนำให้ตรวจสอบอินเทอร์เน็ตและเลือกใช้ทางเข้า FAH999 ที่เว็บไซต์ประกาศไว้ หากยังพบปัญหา สามารถติดต่อแอดมินเพื่อให้ช่วยตรวจสอบบัญชี ช่องทางทำรายการ หรือปัญหาการเข้าใช้งานได้โดยตรง",
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// The highlight colour is the palette's soft gold (#ffdf6b); it marks a claim
// the brief states outright and nothing else.

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb. Every URL in the graph is derived
// by pageGraph from `site:` — no domain is typed out in this file.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxFloatingBadge as="h1" title="FAH999 สล็อตออโต้Top3 เว็บตรง ติดอันดับมาแรง">
    <p class="text-left text-base leading-relaxed text-[#ecdcff]">
      FAH999
      <strong class="text-[#ffdf6b]">สล็อตออโต้Top3 ที่รวมเกมสล็อตจากหลายค่ายไว้ในระบบเดียว</strong>
      <strong class="text-[#ffdf6b]">เน้นทางเข้าเว็บตรง</strong>
      ใช้งานง่าย และจัดหมวดเกมไว้อย่างชัดเจน เหมาะกับคนที่ต้องการค้นหาเกมยอดนิยมจากหน้าเดียว พร้อมระบบออโต้ที่ช่วยให้จัดการบัญชีและเข้าเล่นได้สะดวกมากขึ้นบนทั้งมือถือและคอมพิวเตอร์
    </p>
  </ContentBoxFloatingBadge>

  <ContentBoxTwoCyberCut as="h2" title="FAH999 เกมยอดนิยม แตกง่าย แจ็คพอตเข้าไว การันตีเชื่อถือได้">
    <p slot="left" class="text-left text-base leading-relaxed text-[#ecdcff]">
      FAH999
      <strong class="text-[#ffdf6b]">รวบรวมเกมยอดนิยมหลายสไตล์</strong>
      ทั้งสล็อตโบนัส เกมฟีเจอร์
      <strong class="text-[#ffdf6b]">และเกมแจ็คพอตจากหลายค่าย</strong>
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#ecdcff]">
      <strong class="text-[#ffdf6b]">สมาชิกสามารถเปิดดูข้อมูลของแต่ละเกมก่อนเลือกเล่น</strong>
      พร้อมตรวจสอบรายละเอียดของรอบโบนัสและระดับเดิมพันได้จากหน้าเกมโดยตรง ช่วยให้เลือกเกมที่เหมาะกับสไตล์ของตัวเองได้ง่ายขึ้น
    </p>
  </ContentBoxTwoCyberCut>

  <ProviderGrid />

  <ContentBoxSpecial as="h2" title="โปรโมชั่นสล็อต FAH999 กดรับได้ทุกฝาก ไม่จำกัด" iconleft="🎁" iconright="📋">
    <p slot="left" class="text-left text-base leading-relaxed text-[#ecdcff]">
      โปรโมชั่นสล็อต FAH999
      <strong class="text-[#ffdf6b]">มีสิทธิ์ให้สมาชิกเลือกตามเงื่อนไขของแต่ละรายการ</strong>
      <strong class="text-[#ffdf6b]">ทั้งโบนัสคืนยอดเสียและโบนัสแนะนำเพื่อน</strong>
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#ecdcff]">
      <strong class="text-[#ffdf6b]">โดยสามารถตรวจสอบรายละเอียดก่อนกดรับได้จากหน้าโปรโมชั่น</strong>
      ช่วยให้รู้เงื่อนไข ยอดที่เข้าเกณฑ์ และรอบรับสิทธิ์ได้ชัดเจนก่อนใช้งานจริง
    </p>
  </ContentBoxSpecial>

  <ContentBoxSevenThreeNeumorphism as="h3" title="คืนยอดเสีย โบนัส 0.3%">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[264, 382, 764]}
      sizes="(max-width: 767px) calc(100vw - 96px), 382px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นคืนยอดเสียของ FAH999 พื้นหลังสีม่วงเข้มตัดทอง ด้านซ้ายเป็นผู้หญิงผมยาวสีเข้มสวมชุดสีขาวสลับม่วงทองกำลังชี้นิ้วขึ้น ด้านบนเป็นตราสัญลักษณ์มงกุฎทอง FAH999 ใต้ลงมาเป็นข้อความว่า โปรโมชั่นคืนยอดเสีย และตัวเลข 0.3% ขนาดใหญ่สีทอง มีมงกุฎทองประดับอยู่ด้านบน"
      class="mx-auto h-auto w-full rounded-2xl border border-[#fbbf13]/55 shadow-[0_10px_30px_rgba(251,191,19,0.28)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#ecdcff]">
      สมาชิก FAH999
      <strong class="text-[#ffdf6b]">สามารถรับโบนัสคืนยอดเสีย 0.3% ตามยอดและเงื่อนไขที่ระบบกำหนด</strong>
      <strong class="text-[#ffdf6b]">โดยสามารถตรวจสอบรอบคำนวณและรายละเอียดของยอดที่เข้าเกณฑ์ได้ก่อนรับสิทธิ์</strong>
      ช่วยให้ติดตามโบนัสในแต่ละรอบได้ง่ายและวางแผนการใช้งานเครดิตได้เป็นระบบมากขึ้น
    </p>
  </ContentBoxSevenThreeNeumorphism>

  <ContentBoxSevenThreeCyberCut as="h3" title="แนะนำเพื่อน โบนัส 0.8%">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[264, 346, 692]}
      sizes="(max-width: 767px) calc(100vw - 96px), 346px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อนของ FAH999 พื้นหลังสีม่วงเข้มตัดทอง ด้านซ้ายเป็นผู้หญิงผมยาวสีเข้มสวมชุดสีขาวสลับม่วงทอง ด้านบนเป็นตราสัญลักษณ์มงกุฎทอง FAH999 ใต้ลงมาเป็นข้อความว่า โปรโมชั่นแนะนำเพื่อน และตัวเลข 0.8% ขนาดใหญ่สีทอง รอบข้างมีเหรียญทองและกล่องของขวัญสีม่วงผูกโบทอง มุมซ้ายบนมีข้อความว่า GOOD FRIENDS BIG BONUS และมุมขวาบนมีข้อความลายมือว่า Play Win Together"
      class="mx-auto h-auto w-full rounded-2xl border border-[#a855f7]/55 shadow-[0_10px_30px_rgba(168,85,247,0.28)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#ecdcff]">
      โปรโมชั่นแนะนำเพื่อนของ FAH999
      <strong class="text-[#ffdf6b]">ให้โบนัส 0.8% ตามเงื่อนไขที่กำหนด</strong>
      <strong class="text-[#ffdf6b]">สมาชิกสามารถชวนคนรู้จักเข้ามาสมัครผ่านช่องทางที่ระบบรองรับ</strong>
      พร้อมตรวจสอบยอดสิทธิ์และรายละเอียดของโบนัสจากบัญชีสมาชิกได้ ช่วยให้ติดตามผลของกิจกรรมแนะนำเพื่อนได้สะดวก
    </p>
  </ContentBoxSevenThreeCyberCut>

  <ContentBoxTwoNeumorphism as="h2" title="FAH999 รับทุกธนาคารและวอลเลท ไม่จำกัดยอดฝากถอน">
    <p slot="left" class="text-left text-base leading-relaxed text-[#ecdcff]">
      ระบบ FAH999
      <strong class="text-[#ffdf6b]">รองรับช่องทางธนาคารและวอลเลทตามรายการที่เว็บไซต์เปิดให้ใช้งาน</strong>
      <strong class="text-[#ffdf6b]">สมาชิกสามารถเลือกช่องทางที่เหมาะกับตัวเอง</strong>
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#ecdcff]">
      <strong class="text-[#ffdf6b]">พร้อมตรวจสอบสถานะฝากถอนและยอดเครดิตจากบัญชีได้โดยตรง</strong>
      ขั้นตอนถูกออกแบบให้ใช้งานง่ายและลดความซับซ้อนในการจัดการรายการแต่ละครั้ง
    </p>
  </ContentBoxTwoNeumorphism>

  <LatestWinners />

  <ContentBox as="h2" title="ติดต่อแอดมินสล็อต FAH999 ได้ทันทีที่ต้องการ">
    <p class="text-left text-base leading-relaxed text-[#ecdcff]">
      หากพบปัญหาเกี่ยวกับการสมัคร ทางเข้าเว็บ โปรโมชั่น เกม หรือระบบฝากถอน
      <strong class="text-[#ffdf6b]">สามารถติดต่อแอดมินสล็อต FAH999 เพื่อสอบถามข้อมูลได้โดยตรง</strong>
      <strong class="text-[#ffdf6b]">ทีมงานพร้อมช่วยตรวจสอบรายละเอียดและแนะนำขั้นตอนใช้งานตามปัญหาที่แจ้ง</strong>
      ช่วยให้ทั้งสมาชิกใหม่และสมาชิกเดิมเข้าถึงข้อมูลได้สะดวกขึ้น
    </p>
  </ContentBox>

  <Faq as="h2" title="คำถามที่พบบ่อย" faqs={faqs} />

  <LoginRtpSection />

  <ReviewCardSumo />

  <Navfoot />
</MainLayout>
