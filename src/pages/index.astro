---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import ProviderGrid from "../components/ProviderGridPremium.astro";
import LatestWinners from "../components/LatestWinnersPremium.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Faq from "../components/Faq2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide3 from "../assets/slide3.png";
import imgSlide2 from "../assets/slide2.png";

// SLIDE ROLES FOR ENTER55 — READ BEFORE REUSING THESE IMPORTS.
// Checked against the 2026-09-18 drop: slide3.png is the หวย rate poster
// (2ตัว จ่าย 100 / 3ตัว จ่าย 1,000) so it belongs to docx H2 #3, and slide2.png
// is the แนะนำเพื่อน 0.8% poster so it belongs to the promo section, H2 #6.
// The order is NOT stable across brands — re-read the posters next rebrand
// rather than copying this order forward.
//
// slide1.png (คืนยอดเสีย 0.3%) is deliberately NOT imported here: it is
// MainLayout's og:image and it belongs to /promotion's grid. Nothing else on
// this page carries an image either —
//   banner1 / banner1-mobile  = MainLayout's own pinned globs. A page never
//                               references them, and nothing here gets
//                               loading="eager" fetchpriority="high" — the hero
//                               is the LCP element and it belongs to the layout.
//   banner2.png (2026-08-20), banner3.png (2026-08-11) and slide4.png
//   (2026-08-13) all predate the 2026-09-18 asset drop -> stale inventory from
//   earlier clients, must stay unimported.
// A slide may only ever live inside a ContentBoxSevenThree*; two of them is the
// family's hard cap per rebrand and this page uses exactly two.
//
// Dropped from the previous brand's index and NOT deleted from disk (they are
// inventory for the next brand): Announcement5, ContentBoxFloatingBadge,
// ContentBoxSpecial, ContentBoxSevenThreeCyberCut,
// ContentBoxSevenThreeNeumorphism, ProviderGrid, LatestWinners3, ReviewCardSumo
// and Faq3 — that whole mix went out with the outgoing brand and none of it may
// be reused this round.

// Title and description are the brief's own Title/Meta Description lines, used
// verbatim. A brief-supplied description is never padded up to the 150-char
// floor and never topped up from the H1/H2.
const pageTitle = "ENTER55 เว็บเล่นสล็อตและหวยออนไลน์ รวมครบในทางเข้าเดียว";

const pageDescription = "ENTER55 เว็บเล่นสล็อตและหวยออนไลน์ เรทจ่ายสูง ให้ความมั่นใจทุกการเดิมพัน นำมารวมให้เลือกเล่นครบในทางเข้าเดียว ปลอดภัยแน่นอน";

// <Announcement /> runs bare: Announcement3's default message is already this
// brand's copy, and every sub-page calls it bare too — passing an override here
// is how the ticker ends up saying two different things on two pages.

// The docx has a real H1 -> H2 -> H3 hierarchy this round: #4/#5 are genuine H3
// sub-points of H2 #3, and #7/#8 of H2 #6, so the page is NOT flattened to
// H2-only. Both pairs are carried by FeatureHighlights, which is the only place
// an <h3> comes from. Everything else on the page is chrome — ProviderGrid,
// LatestWinners, LoginRtpSection and ReviewCardSumo all render their titles as
// <p>/<span> with an aria-label on the section, so none of them emits a heading.
// Final inventory for this page: h1 x1, h2 x5, h3 x4.

// docx H3 #4 and #5 — the two หวย payout rates under H2 #3, each with the full
// paragraph the brief puts under it. The accents are two brightnesses of the one
// gold, alternating down the list.
const lottoRates = [
  {
    icon: "🎯",
    accent: "deep" as const,
    title: "แทงหวย 2ตัว จ่าย 100บาท",
    description: "ให้คุณทำกำไรได้มากกว่าที่เคย กับอัตราการจ่ายรางวัลหวยประเภท 2 ตัวบน และ 2 ตัวล่าง ที่เรากล้าให้สูงสุดถึง บาทละ 100 ลงทุนเพียงหลักสิบก็สามารถเปลี่ยนเป็นเงินหลักพันได้ง่ายๆ",
  },
  {
    icon: "💎",
    accent: "sheen" as const,
    title: "แทงหวย 3ตัว จ่าย 1,000บาท",
    description: "สัมผัสความรวยแบบก้าวกระโดดเมื่อทายผลเลข 3 ตัวตรงถูกต้อง รับเงินรางวัลไปเลยในอัตราที่สูงที่สุดในตลาดถึง บาทละ 1,000 แทงถูกปุ๊บ ระบบปรับยอดเครดิตให้ปั๊บ ถอนเงินไปใช้ได้ทันที",
  },
];

// docx H3 #7 and #8 — the two slot promotions under H2 #6, same shape.
const slotPromos = [
  {
    icon: "🤝",
    accent: "deep" as const,
    title: "โปรโมชั่น แนะนำเพื่อน 0.8%",
    description:
      "ชวนเพื่อนมาสนุกด้วยกัน รับเงินฟรีทุกวัน! เพียงนำลิงก์ส่วนตัวของคุณไปแชร์ให้เพื่อนสมัครและเข้าเล่นสล็อต คุณจะได้รับค่าคอมมิชชั่นสูงถึง 0.8% จากทุกยอดการเล่นของเพื่อน ยิ่งชวนมากยิ่งได้มาก เป็นรายได้แบบ Passive Income ที่ถอนเป็นเงินสดได้จริง",
  },
  {
    icon: "💰",
    accent: "sheen" as const,
    title: "โปรโมชั่น คืนยอดเสีย 0.3%",
    description:
      "ทุกการเดิมพันมีหลักประกันเสมอ หากโชคไม่เข้าข้าง เรามีระบบดูแลด้วยโปรโมชั่น คืนยอดเสีย 0.3% ในทุกรอบบิล เพื่อให้คุณมีทุนสำรองไว้สำหรับนำไปแก้มือและต่อยอดสร้างกำไรในเกมสล็อตได้อย่างต่อเนื่อง ไร้กังวล",
  },
];

// The brief's three auto-signup steps (its L21-L23), split at the colon into the
// step name and its instruction. Nothing is added or reworded. They sit under
// docx H2 #9 as a list, not as headings — the docx marks no heading for them.
const signupSteps = [
  {
    icon: "📱",
    name: "กรอกเบอร์โทรศัพท์",
    detail: "ระบุเบอร์มือถือของคุณเพื่อรับรหัส OTP ยืนยันตัวตน",
  },
  {
    icon: "🏦",
    name: "ผูกบัญชีธนาคาร",
    detail: "เลือกธนาคารและกรอกเลขบัญชีที่ตรงกับชื่อ-นามสกุลของคุณ (รองรับการฝาก-ถอนทุกธนาคารชั้นนำ และ TrueMoney Wallet)",
  },
  {
    icon: "🔑",
    name: "ตั้งรหัสผ่าน",
    detail: "กำหนด Username และ Password เพื่อล็อคอินเข้าสู่ระบบ เติมเงินและเริ่มต้นทำกำไรได้ครบทุกเกมในทางเข้าเดียว!",
  },
];

// One array, used by both <Faq> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last. The three pairs
// are the brief's Q1-Q3, verbatim, with only the "Q1:"/"A:" prefixes removed.
const faqs = [
  {
    q: "กระเป๋าเดียว (Single Wallet) ของ ENTER55 คืออะไร?",
    a: "คือระบบที่อำนวยความสะดวกให้ผู้เล่น โดยยอดเครดิตทั้งหมดของคุณจะรวมอยู่ในกระเป๋าเดียว คุณสามารถสลับหน้าไปเล่นเกมสล็อต หรือเปลี่ยนไปแทงหวยออนไลน์ได้ทันที โดยไม่จำเป็นต้องกดย้ายเงินหรือโยกเครดิตระหว่างค่ายเกม",
  },
  {
    q: "ENTER55 มีขั้นต่ำในการฝาก-ถอนเงินหรือไม่?",
    a: "เว็บไซต์ของเราให้อิสระทางการเงินกับผู้เล่นทุกคน ด้วยระบบฝาก-ถอนอัตโนมัติที่ไม่มีขั้นต่ำ ทุน 1 บาทก็สามารถฝากเข้ามาเดิมพันได้ และสามารถทำรายการได้ตลอด 24 ชั่วโมง ใช้เวลาเพียง 3-5 วินาที",
  },
  {
    q: "ถ้าแทงหวยถูก และสล็อตแตกในวันเดียวกัน สามารถถอนเงินทั้งหมดได้เลยไหม?",
    a: "ถอนได้ทั้งหมด 100% ทันที ENTER55 เป็นเว็บตรงที่มีฐานการเงินแข็งแกร่ง ไม่ว่ายอดถอนของคุณจะรวมกันหลักหมื่น หลักแสน หรือหลักล้าน เราก็พร้อมโอนจ่ายให้เต็มจำนวน ไม่มีอั้นยอดถอนต่อวัน",
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// The highlight colour is the palette's bright champagne gold (#ebd484); it
// marks a claim the brief states outright and nothing else.

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb. Every URL in the graph is derived
// by pageGraph from `site:` — no domain is typed out in this file.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxPremium as="h1" title="ENTER55 เว็บเล่นสล็อตและหวยออนไลน์ รวมครบในทางเข้าเดียว">
    <p class="text-left text-base leading-relaxed text-[#ded8cb]">
      เปิดประสบการณ์ใหม่แห่งการเดิมพันที่สะดวกสบายและคุ้มค่าที่สุดกับ
      <strong class="text-[#ebd484]">ENTER55 อาณาจักรความบันเทิงที่ตอบโจทย์ทั้งสายปั่นสล็อตและคอหวยออนไลน์ในที่เดียว</strong>
      เราได้รวบรวมค่ายเกมสล็อตชั้นนำระดับโลกและหวยออนไลน์ทุกประเภทมาไว้ให้คุณเลือกเล่นอย่างจุใจ
      <strong class="text-[#ebd484]">ไม่ต้องเสียเวลาสมัครหลายเว็บ ไม่ต้องจำหลายรหัสผ่าน</strong>
      เพราะที่นี่ให้คุณเข้าถึงทุกความสนุกได้ง่ายๆ
      <strong class="text-[#ebd484]">"ครบจบในทางเข้าเดียว"</strong>
      มั่นใจได้ด้วยระบบที่เสถียร ปลอดภัย และได้มาตรฐานสากล
    </p>
  </ContentBoxPremium>

  <ContentBox as="h2" title="ENTER55 เว็บเดิมพันออนไลน์ เรทจ่ายสูง ให้ความมั่นใจทุกการเดิมพัน">
    <p class="text-left text-base leading-relaxed text-[#ded8cb]">
      ที่ ENTER55
      <strong class="text-[#ebd484]">เราคือเว็บตรงไม่ผ่านเอเย่นต์ที่มีความมั่นคงทางการเงินระดับประเทศ</strong>
      ทำให้เรากล้าให้เรทอัตราจ่ายที่สูงกว่าเว็บทั่วไปในตลาด ไม่ว่าคุณจะเข้ามาทำกำไรจากโบนัสแจ็คพอตสล็อตที่แตกหนัก แตกง่าย หรือจะเข้ามาลุ้นรวยกับตัวเลขหวยออนไลน์ เราก็พร้อมจ่ายให้คุณแบบไม่อั้น
      <strong class="text-[#ebd484]">การันตีความปลอดภัย 100%</strong>
      <strong class="text-[#ebd484]">ทุกยอดการชนะของคุณสามารถถอนออกได้จริงเต็มจำนวน</strong>
      ให้ความมั่นใจในทุกการเดิมพัน ไม่มีประวัติการโกง
    </p>
  </ContentBox>

  <ProviderGrid />

  <ContentBoxSevenThreePremium as="h2" title="อัตราจ่าย ENTER55 ให้เต็มทุกบิล ไม่หักเปอร์เซ็นต์">
    <Picture
      slot="left"
      src={imgSlide3}
      loading="lazy"
      fetchpriority="low"
      widths={[260, 400, 700]}
      sizes="(max-width: 767px) 92vw, 346px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์อัตราจ่ายหวยของ ENTER55 พื้นหลังสีดำลายวงจรเส้นทอง ด้านบนเป็นตัวอักษรสีทองเมทัลลิกคำว่า ENTER55 ใต้ลงมาเป็นข้อความสองบรรทัดว่า แทงหวย 2ตัว จ่าย 100บาท และ แทงหวย 3ตัว จ่าย 1,000บาท มีลูกบอลหวยกลมสีทองวางประกอบ และมีผู้หญิงผมยาวสวมชุดราตรีสีทองยืนอยู่ด้านข้าง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#c4a255]/55 shadow-[0_10px_30px_rgba(196,162,85,0.28)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#ded8cb]">
      สำหรับคอหวยที่กำลังมองหาเว็บที่จ่ายหนักและซื่อตรง ENTER55 คือคำตอบที่ดีที่สุด เราเปิดรับแทงหวยทุกประเภท
      <strong class="text-[#ebd484]">ทั้งหวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยหุ้น</strong>
      โดยมีนโยบาย
      <strong class="text-[#ebd484]">จ่ายเต็มทุกบิล ไม่หักเปอร์เซ็นต์</strong>
      แม้จะเป็นเลขเด็ด เลขดัง หรือเลขอั้น เราก็พร้อมให้เรทราคาที่ยุติธรรมและคุ้มค่าที่สุด
    </p>
  </ContentBoxSevenThreePremium>

  <FeatureHighlights items={lottoRates} />

  <LatestWinners />

  <ContentBoxSevenThree as="h2" title="โปรโมชั่นเกมสล็อต ENTER55">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[280, 420, 760]}
      sizes="(max-width: 767px) 92vw, 380px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อน 0.8% ของ ENTER55 พื้นหลังสีดำทอง ด้านบนเป็นตัวอักษรสีทองเมทัลลิกคำว่า ENTER55 ใต้ลงมาเป็นข้อความว่า โปรโมชั่น แนะนำเพื่อน และตัวเลข 0.8% ขนาดใหญ่สีทอง ด้านข้างเป็นผู้หญิงผมยาวสวมชุดราตรีสีดำปักลายทอง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#ebd484]/45 shadow-[0_10px_30px_rgba(235,212,132,0.22)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#ded8cb]">
      นอกจากหวยแล้ว ในส่วนของเกมสล็อตออนไลน์
      <strong class="text-[#ebd484]">ENTER55 ก็จัดเต็มความคุ้มค่าให้สมาชิกแบบไม่มีกั๊ก</strong>
      ด้วยโปรโมชั่นสุดพิเศษที่ออกแบบมาเพื่อคืนกำไรและเพิ่มโอกาสในการชนะให้กับทุกยูสเซอร์
    </p>
  </ContentBoxSevenThree>

  <FeatureHighlights items={slotPromos} />

  <ContentBoxCyberCut as="h2" title="สมัครสมาชิก ENTER55 เข้าเล่นได้ครบในทางเข้าเดียว">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed text-[#ded8cb]">
        สมัครสมาชิกกับ ENTER55 วันนี้ สัมผัสความสะดวกสบายขั้นสุดด้วยระบบ
        <strong class="text-[#ebd484]">"กระเป๋าเดียว (Single Wallet)"</strong>
        ที่ให้คุณฝากเงินเพียงครั้งเดียว แต่สามารถนำเครดิตไปเล่นได้ทั้งสล็อตและหวย
        <strong class="text-[#ebd484]">โดยไม่ต้องโยกเงินไปมาให้ยุ่งยาก</strong>
        สมัครฟรีด้วยตัวเองผ่านระบบออโต้เพียง 3 ขั้นตอน:
      </p>
      <ol class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#ded8cb]">
        {
          signupSteps.map((step, i) => (
            <li class="flex items-start gap-4 rounded-xl border border-[#26200f] bg-[#000000]/70 p-4 transition-colors hover:border-[#c4a255]/70 hover:bg-[#16140f]">
              <span
                aria-hidden="true"
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-[#c4a255]/60 bg-gradient-to-br from-[#c4a255] to-[#8a6d2c] text-xl text-[#ebd484] shadow-[0_0_12px_rgba(196,162,85,0.35)]">
                {step.icon}
              </span>
              <span class="flex flex-col gap-1">
                <span class="font-black tracking-wide text-[#ebd484]">
                  ขั้นตอนที่ {i + 1} — {step.name}
                </span>
                <span class="text-[#ded8cb]">{step.detail}</span>
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </ContentBoxCyberCut>

  <LoginRtpSection />

  <Faq as="h2" title="คำถามที่พบบ่อย (FAQ)" faqs={faqs} />

  <ReviewCardSumo />

  <Navfoot />
</MainLayout>
