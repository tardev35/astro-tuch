      widths={cashbackWidths}
      sizes={cashbackSizes}
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={64}
      alt={cashbackAlt}
      class="mx-auto h-auto w-full max-w-[375px] rounded-2xl border border-[#b2dba3] shadow-[0_10px_24px_rgba(11,74,18,0.18)]"
    />
