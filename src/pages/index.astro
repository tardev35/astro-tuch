---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement2.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBox from "../components/ContentBox.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import Faq3 from "../components/Faq3.astro";
import LatestWinnersPremium from "../components/LatestWinnersPremium.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// Title and description are the brief's own Title/Description lines, verbatim.
// A brief-supplied description ships at whatever length it was written — it is
// not padded up to the 150-character floor.
const pageTitle = "DARK168 เว็บดาร์คสล็อต เจ้าของแท้ การันตีไม่ล็อคยูส";

const pageDescription =
  "DARK168 เว็บดาร์คสล็อต ค่ายหลัก ได้เงินจริง เล่นง่ายไม่ล็อคยูส พร้อมโปรสุดพิเศษกว่าทุกเจ้า สมัครวันนี้ รับโบนัสเดิมพันได้ทันที";

// The ticker copy is passed explicitly rather than relying on the component's
// default — every Announcement* variant's default belongs to whichever brand
// wired it in last. No emoji in this string: an emoji baked into a text prop
// cannot be given its own aria-hidden span.
const announcement =
  "DARK168 เว็บดาร์คสล็อต เจ้าของเกมแท้ รวมเกมสล็อตจากค่ายหลักไว้ในบัญชีเดียว • การันตีไม่ล็อคยูส แตกง่าย ไม่มีขั้นต่ำ • โบนัสแนะนำเพื่อน 0.8% และคืนยอดเสียทุกวัน 0.3% ตามเงื่อนไขของแต่ละโปรโมชั่น • ระบบฝากถอนอัตโนมัติ ทำรายการเองได้ตลอด 24 ชั่วโมง • แอดมิน DARK168 พร้อมช่วยตรวจสอบรายการทุกวัน";

// The brief's three registration steps. They are list items in the docx, not
// headings, so they render as an <ol> — turning them into cards with their own
// titles would add an h3 tier the brief does not have.
const steps = [
  "สมัครสมาชิก DARK168 และกรอกข้อมูลตามที่ระบบกำหนด",
  "Login เข้าสู่บัญชีและทำรายการฝากเครดิตผ่านระบบอัตโนมัติ",
  "ตรวจสอบโปรโมชั่นที่มีสิทธิ์ เลือกเกมสล็อต และศึกษากติกาก่อนเริ่มเล่น",
];

// One array, used by both <Faq3> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last.
const faqs = [
  {
    q: "DARK168 มีโปรโมชั่นอะไรสำหรับสมาชิก?",
    a: "โปรโมชั่นหลักประกอบด้วยโบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไขที่กำหนด สมาชิกสามารถตรวจสอบรายละเอียดและโปรโมชั่นล่าสุดได้จากหน้าเว็บไซต์ก่อนกดรับสิทธิ์",
  },
  {
    q: "DARK168 เล่นผ่านมือถือได้หรือไม่?",
    a: "ได้ ระบบรองรับการใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ สมาชิกสามารถเปิดเว็บไซต์ผ่านเบราว์เซอร์ Login เข้าสู่บัญชี และเลือกเกมสล็อตที่ต้องการได้โดยตรง",
  },
  {
    q: "หากฝากถอน DARK168 แล้วรายการไม่สำเร็จต้องทำอย่างไร?",
    a: "ให้ตรวจสอบสถานะธุรกรรมในบัญชีก่อน หากเครดิตยังไม่เข้าหรือรายการถอนยังค้าง สามารถติดต่อแอดมิน DARK168 พร้อมแจ้งรายละเอียดและเวลาที่ทำรายการ เพื่อให้ทีมงานช่วยตรวจสอบได้ตลอด 24 ชั่วโมง",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <SmoothCarousel />

  <ContentBoxPremium as="h1" title="DARK168 เว็บดาร์คสล็อต เจ้าของเกมแท้ แตกง่าย ไม่มีขั้นต่ำ">
    <p class="text-left text-base leading-relaxed text-[#ece3d1]">
      <strong class="text-[#f6dfa4]">DARK168</strong> พร้อมให้บริการสมาชิกที่ต้องการเล่นสล็อตออนไลน์ผ่านมือถือและคอมพิวเตอร์ มีเกมสล็อตหลากหลายค่ายให้เลือก พร้อมโปรโมชั่นสำหรับสมาชิกทั้งโบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไข
      ระบบฝากถอนอัตโนมัติช่วยให้จัดการเครดิตและตรวจสอบรายการได้สะดวก พร้อมแอดมินคอยให้คำแนะนำตลอด 24 ชั่วโมง
    </p>
  </ContentBoxPremium>

  <ContentBox as="h2" title="DARK168 ดาร์คสล็อต เว็บตรงค่ายหลัก">
    <p class="text-left text-base leading-relaxed text-[#ece3d1]">
      DARK168 รวมเกมสล็อตออนไลน์หลากหลายรูปแบบไว้ภายในระบบเดียว มีทั้งเกมยอดนิยม เกมใหม่ สล็อตโบนัส และเกมแจ็คพอต พร้อมรองรับการใช้งานผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ สมาชิกสามารถ Login เลือกค่ายและค้นหาเกมที่ต้องการได้จากบัญชีเดียว
      โดยก่อนเริ่มเล่นควรตรวจสอบกติกา อัตราเดิมพัน และรายละเอียดของเกมให้ครบถ้วน
    </p>
  </ContentBox>

  <ProviderGrid />

  <ContentBoxCyberCut as="h2" title="เล่น DARK168 ไม่ล็อคยูส ได้สิทธิพิเศษกว่าเจ้าอื่น">
    <p class="text-left text-base leading-relaxed text-[#ece3d1]">
      สมาชิก DARK168 สามารถติดตามโปรโมชั่นและสิทธิพิเศษที่เปิดให้รับผ่านหน้าเว็บไซต์ โดยรายละเอียดของโบนัส ยอดที่นำมาคำนวณ รอบการรับ และข้อกำหนดการถอนจะแสดงไว้ในแต่ละโปรโมชั่นอย่างชัดเจน แนะนำให้ตรวจสอบเงื่อนไขล่าสุดก่อนกดรับสิทธิ์ทุกครั้ง
    </p>
  </ContentBoxCyberCut>

  <ContentBoxSevenThree as="h3" title="โปรโมชั่นแนะนำเพื่อน โบนัส 0.8%">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นพื้นหลังสีดำ ด้านซ้ายบนเป็นโลโก้ DARK168 ตัวอักษร DARK สีทองและเลข 168 สีเงินเมทัลลิก ถัดลงมาเป็นข้อความสีทอง โปรโมชั่น แนะนำเพื่อน รับโบนัส พร้อมตัวเลข 0.8% ขนาดใหญ่ ด้านขวาเป็นหญิงสาวสวมชุดราตรียาวสีทองเงิน รอบตัวมีลูกเต๋าและเหรียญทองกระจายอยู่ แถบด้านล่างเขียนว่า ชวนเพื่อนเลย รับโบนัสไม่อั้น! ใต้แถบมีไอคอนสามช่อง มั่นคง ปลอดภัย เชื่อถือได้ 100% ชวนง่าย ได้จริง รับโบนัสทันที และ ไม่จำกัดยอดเพื่อน ยิ่งชวน ยิ่งได้"
      class="mx-auto h-auto w-full rounded-2xl border border-[#e6b74e]/45 shadow-[0_10px_30px_rgba(230,183,78,0.22)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#ece3d1]">
      สมาชิกสามารถนำลิงก์แนะนำส่วนตัวไปแชร์ให้เพื่อน เมื่อเพื่อนสมัครและมียอดการใช้งานตรงตามข้อกำหนด ระบบจะคำนวณโบนัสแนะนำเพื่อน 0.8% ตามเงื่อนไข สมาชิกสามารถติดตามยอดและตรวจสอบสิทธิ์ที่ได้รับผ่านบัญชีของตนเองได้อย่างสะดวก
    </p>
  </ContentBoxSevenThree>

  <ContentBoxSevenThreeCyberCut as="h3" titleright="โปรโมชั่นคืนยอดเสียทุกวัน 0.3%">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นพื้นหลังสีดำ ด้านซ้ายบนเป็นโลโก้ DARK168 ตัวอักษร DARK สีทองและเลข 168 สีเงินเมทัลลิก ถัดลงมาเป็นข้อความสีทอง โปรโมชั่น คืนยอดเสีย รับโบนัส พร้อมตัวเลข 0.3% ขนาดใหญ่ ด้านขวาเป็นหญิงสาวสวมชุดราตรียาวสีเงินตัดทอง ฉากหลังเป็นลำแสงเรขาคณิตสีทองพาดผ่านพื้นสีดำ"
      class="mx-auto h-auto w-full rounded-2xl border border-[#e6b74e]/45 shadow-[0_10px_30px_rgba(230,183,78,0.22)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#ece3d1]">
      สำหรับสมาชิกที่มียอดเสียตรงตามเงื่อนไข สามารถตรวจสอบสิทธิ์รับโบนัสคืนยอดเสีย 0.3% ตามรอบประจำวันที่กำหนด โดยควรตรวจสอบประเภทเกมที่ร่วมรายการ ยอดที่ใช้คำนวณ และเงื่อนไขก่อนกดรับโบนัสทุกครั้ง
    </p>
  </ContentBoxSevenThreeCyberCut>

  <ContentBoxTwoNeumorphism as="h2" title="สมัคร DARK168 3 ขั้นตอน รับโบนัสได้ทันที">
    <p slot="left" class="text-left text-base leading-relaxed text-[#ece3d1]">
      ผู้ใช้งานใหม่สามารถสมัคร DARK168 ผ่านมือถือหรือคอมพิวเตอร์ได้ด้วยขั้นตอนที่ไม่ซับซ้อน หลังเปิดบัญชีเรียบร้อยแล้วสามารถตรวจสอบโปรโมชั่นสมาชิกใหม่และโบนัสที่กำลังเปิดให้รับได้ทันที
    </p>
    <div slot="right" class="flex flex-col gap-4">
      <ol class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#ece3d1]">
        {
          steps.map((step, i) => (
            <li class="flex items-start gap-3 rounded-2xl border border-[#8a6320]/45 bg-[#050505]/70 p-4">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-[#f6dfa4] via-[#e6b74e] to-[#8a6320] text-sm font-black text-[#050505]">{i + 1}</span>
              <span>{step}</span>
            </li>
          ))
        }
      </ol>
      <p class="text-left text-base leading-relaxed text-[#ece3d1]">สิทธิ์โบนัสและเงื่อนไขการเดิมพันอาจแตกต่างกันในแต่ละโปรโมชั่น จึงควรตรวจสอบรายละเอียดก่อนเข้าร่วมทุกครั้ง</p>
    </div>
  </ContentBoxTwoNeumorphism>

  <ContentBoxSpecial as="h2" title="ติดต่อแอดมิน DARK168 ได้ทันที เมื่อติดปัญหาตลอด 24 ชั่วโมง">
    <p slot="left" class="text-left text-base leading-relaxed text-[#ece3d1]">
      หากพบปัญหาเกี่ยวกับการสมัครสมาชิก การ Login ฝากเงิน ถอนเงิน เครดิตไม่เข้า โปรโมชั่นไม่แสดง หรือเข้าเกมสล็อตไม่ได้ สามารถติดต่อแอดมิน DARK168 ได้ตลอด 24 ชั่วโมง
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#ece3d1]">
      พร้อมแจ้งรายละเอียดของปัญหาและเวลาที่ทำรายการ เพื่อให้ทีมงานช่วยตรวจสอบและแนะนำวิธีดำเนินการต่อได้รวดเร็วยิ่งขึ้น
    </p>
  </ContentBoxSpecial>

  <Faq3 title="คำถามที่พบบ่อยเกี่ยวกับ DARK168" faqs={faqs} />

  <LatestWinnersPremium />

  <LoginRtpSection />

  <ReviewCardSumo2 />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#f6dfa4] via-[#e6b74e] to-[#8a6320] px-4 py-3 text-sm font-black whitespace-nowrap text-[#050505] shadow-[0_10px_30px_rgba(230,183,78,0.28)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(230,183,78,0.42)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#e6b74e]/50 bg-gradient-to-r from-[#131009] to-[#050505] px-4 py-3 text-sm font-black whitespace-nowrap text-[#f6dfa4] shadow-[0_10px_30px_rgba(230,183,78,0.16)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#f6dfa4]/70 hover:text-[#c8cfd8] hover:shadow-[0_15px_40px_rgba(200,207,216,0.28)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>
  </div>

  <Navfoot />
</MainLayout>
