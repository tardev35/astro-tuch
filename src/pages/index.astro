---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LatestWinnersPremium from "../components/LatestWinnersPremium.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq3.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgPromo from "../assets/slide1.png";

const pageTitle = "RUAYHENG289 คาสิโนแบรนด์หลัก เกมเดิมพันครบ ฝากถอนอัตโนมัติ";

const pageDescription =
  "RUAYHENG289 คาสิโนออนไลน์แบรนด์หลัก เกมเดิมพันครบวงจรผ่านมือถือและคอมพิวเตอร์ ฝากถอนอัตโนมัติ 24 ชม. ทีมงานดูแลตลอดเวลา แชร์ลิงก์แนะนำเพื่อนรับโบนัส 0.8% ทันที";

const referralItems = [
  {
    icon: "🔗",
    title: "แชร์ลิงก์ง่าย",
    description: "สร้างและแชร์ลิงก์แนะนำเพื่อนได้ทันทีผ่านระบบสมาชิก ไม่ต้องกรอกข้อมูลซ้ำในแต่ละครั้ง",
    accent: "gold" as const,
  },
  {
    icon: "🎁",
    title: "รับโบนัสอัตโนมัติ",
    description: "ระบบคำนวณและมอบโบนัสค่าแนะนำ 0.8% ให้อัตโนมัติเมื่อเพื่อนที่แนะนำทำรายการครบเงื่อนไข",
    accent: "gold" as const,
  },
];

const onboardingSteps = [
  {
    icon: "📝",
    title: "สมัครสมาชิก",
    description: "กรอกข้อมูลสมัครสมาชิกผ่านระบบออนไลน์ให้ครบถ้วน ใช้เวลาไม่กี่นาทีก็พร้อมเริ่มใช้งาน",
    accent: "gold" as const,
  },
  {
    icon: "💳",
    title: "เข้าสู่ระบบและฝากเครดิต",
    description: "เข้าสู่ระบบแล้วฝากเครดิตผ่านระบบฝากถอนอัตโนมัติ ทำรายการได้เองตลอด 24 ชั่วโมง",
    accent: "blue" as const,
  },
  {
    icon: "🎮",
    title: "เลือกเกมเดิมพัน",
    description: "เลือกเล่นเกมที่ต้องการผ่านมือถือหรือคอมพิวเตอร์ได้ทันที ครบทั้งสล็อต คาสิโน และกีฬา",
    accent: "gold" as const,
  },
];

const faqs = [
  {
    q: "เข้าเล่น RUAYHENG289 ผ่านมือถือต้องดาวน์โหลดแอปหรือไม่",
    a: "ไม่จำเป็นต้องดาวน์โหลดแอปเพิ่ม สมาชิกเปิดเว็บ RUAYHENG289 ผ่านเบราว์เซอร์บนมือถือ แท็บเล็ต หรือคอมพิวเตอร์ได้ทันที หน้าจอปรับขนาดให้พอดีอัตโนมัติทุกอุปกรณ์ รองรับทั้งระบบ Android และ iOS พร้อมเล่นต่อจากจุดเดิมได้แม้เปลี่ยนอุปกรณ์",
  },
  {
    q: "RUAYHENG289 มีเกมเดิมพันให้เลือกเล่นแบบไหนบ้าง",
    a: "RUAYHENG289 รวมเกมจากค่ายเกมมาตรฐานไว้ในระบบเดียว ทั้งเกมสล็อต คาสิโนสด และเกมเดิมพันยอดนิยมอื่น ๆ พร้อมอัปเดตเกมใหม่อย่างต่อเนื่อง สมาชิกเลือกเล่นได้หลากหลายโดยไม่ต้องสมัครหลายเว็บไซต์",
  },
  {
    q: "ก่อนเข้าเล่นควรตรวจทางเข้า RUAYHENG289 อย่างไรให้ปลอดภัย",
    a: "ควรตรวจชื่อโดเมน การเชื่อมต่อ HTTPS โลโก้แบรนด์ และปลายทางของปุ่มเข้าสู่ระบบให้ตรงกับเว็บ RUAYHENG289 เจ้าของแท้ทุกครั้งก่อนกรอกข้อมูล โดยเฉพาะลิงก์ที่ได้รับผ่านข้อความส่วนตัว หากมีการขอรหัสผ่านหรือข้อมูลบัญชีธนาคารผ่านแชตควรหยุดและตรวจสอบก่อนดำเนินการต่อ",
  },
  {
    q: "ฝากถอนเครดิตกับ RUAYHENG289 ใช้เวลานานแค่ไหน",
    a: "ระบบฝากถอนอัตโนมัติของ RUAYHENG289 เปิดให้บริการตลอด 24 ชั่วโมง รองรับทั้งบัญชีธนาคารและวอลเลท สมาชิกทำรายการฝากเครดิตและถอนเงินได้ด้วยตนเอง พร้อมตรวจสอบสถานะรายการผ่านระบบ หากยอดยังไม่เข้าให้ตรวจประวัติรายการก่อนทำซ้ำ เพราะรายการอาจอยู่ระหว่างประมวลผล",
  },
  {
    q: "สมัครสมาชิก RUAYHENG289 แล้วเริ่มเล่นได้เร็วแค่ไหน",
    a: "กรอกข้อมูลสมัครสมาชิกผ่านระบบออนไลน์ให้ครบถ้วนใช้เวลาเพียงไม่กี่นาที จากนั้นเข้าสู่ระบบและฝากเครดิตผ่านระบบฝากถอนอัตโนมัติ ก็เริ่มเลือกเล่นเกมที่ต้องการผ่านมือถือหรือคอมพิวเตอร์ได้ทันที หากพบปัญหาระหว่างสมัครสามารถติดต่อทีมงาน RUAYHENG289 ได้ตลอด 24 ชั่วโมง",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message="RUAYHENG289 ทางเข้าเล่นคาสิโนแบรนด์หลัก เจ้าของแท้ • รวมค่ายเกมมาตรฐานครบวงจร • ฝากถอนอัตโนมัติ 24 ชั่วโมง • สมัครแชร์ลิงก์แนะนำรับโบนัส 0.8%" />

  <ContentBoxPremium as="h1" title="RUAYHENG289 คาสิโนแบรนด์หลัก เกมเดิมพันครบ">
    <p class="text-left text-base leading-relaxed text-[#dfeacf]">
      <strong class="text-[#a4e254]">RUAYHENG289</strong> คาสิโนออนไลน์แบรนด์หลัก พร้อมให้บริการเกมเดิมพันครบวงจรผ่านมือถือและคอมพิวเตอร์
      ระบบฝากถอนอัตโนมัติทำรายการได้เองตลอด 24 ชั่วโมง พร้อมทีมงานคอยดูแลและให้คำแนะนำทุกขั้นตอนการใช้งาน
    </p>
  </ContentBoxPremium>

  <SmoothCarousel />

  <ContentBox as="h2" title="เว็บ RUAYHENG289 ทางเข้าเล่น คาสิโนออนไลน์แบรนด์ต้นฉบับ">
    <p class="text-left text-base leading-relaxed text-[#dfeacf]">
      สมาชิกเข้าสู่ระบบเว็บ RUAYHENG289 ทางเข้าเล่นคาสิโนออนไลน์แบรนด์ต้นฉบับได้สะดวกทุกอุปกรณ์ ไม่ว่าจะเป็นมือถือ แท็บเล็ต หรือคอมพิวเตอร์
      ระบบมีความเสถียรรองรับการใช้งานพร้อมกันจำนวนมาก ช่วยให้เข้าเล่นเกมได้อย่างต่อเนื่องไม่สะดุด
    </p>
  </ContentBox>

  <ContentBoxCyberCut as="h2" title="RUAYHENG289 รับอนุญาตจากเจ้าของแท้ เข้าเล่นได้อย่างปลอดภัย">
    <p class="text-left text-base leading-relaxed text-[#dfeacf]">
      RUAYHENG289 ดำเนินการโดยเจ้าของแท้ ให้บริการอย่างถูกต้องและปลอดภัย ระบบใช้งานง่าย สมาชิกจัดการข้อมูลส่วนตัว
      รายการฝากถอน และประวัติการทำรายการได้ด้วยตนเองผ่านหน้าเว็บไซต์ตลอดเวลา
    </p>
  </ContentBoxCyberCut>

  <ContentBoxNeumorphism as="h2" title="RUAYHENG289 แหล่งรวมค่ายเกมมาตรฐาน ครบวงจร">
    <p class="text-left text-base leading-relaxed text-[#dfeacf]">
      RUAYHENG289 เป็นแหล่งรวมค่ายเกมมาตรฐานไว้ในระบบเดียวแบบครบวงจร ทั้งเกมสล็อตและคาสิโนสดจากผู้ให้บริการชั้นนำ
      พร้อมอัปเดตเกมใหม่อย่างต่อเนื่อง เพื่อให้สมาชิกมีตัวเลือกเล่นที่หลากหลายตลอดเวลา
    </p>
  </ContentBoxNeumorphism>

  <ProviderGrid />

  <ContentBoxSpecial as="h2" title="โปรโบนัสค่าแนะนำสูงถึง 0.8% สมัคร RUAYHENG289 แชร์ลิงก์แนะนำ กดรับได้เลย">
    <div slot="left">
      <p class="text-left text-base leading-relaxed text-[#dfeacf]">
        สมาชิก RUAYHENG289 สามารถแชร์ลิงก์แนะนำให้เพื่อนสมัครสมาชิกได้ง่าย ๆ ผ่านระบบ พร้อมรับโบนัสค่าแนะนำสูงถึง 0.8%
        ตามเงื่อนไขที่เว็บไซต์กำหนด
      </p>
      <FeatureHighlights items={referralItems} />
    </div>
    <p slot="right" class="text-left text-base leading-relaxed text-[#dfeacf]">
      ตรวจสอบข้อมูลการแนะนำและโบนัสที่ได้รับผ่านระบบสมาชิกได้ตลอดเวลา หากมีข้อสงสัยสามารถติดต่อทีมงาน RUAYHENG289
      เพื่อขอคำแนะนำได้ตลอด 24 ชั่วโมง
    </p>
  </ContentBoxSpecial>

  <ContentBoxSevenThreePremium>
    <Picture
      slot="left"
      src={imgPromo}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์ RUAYHENG289 แนะนำเพื่อน รับโบนัส 0.8% พื้นหลังโทนดำ-เขียว มีไพ่เอซ ชิปคาสิโน และไอคอนแนะนำง่าย รับโบนัสสูง ปลอดภัย ถอนเงินไว"
      class="mx-auto h-auto w-full rounded-2xl border border-[#3fa316]/25 shadow-[0_10px_30px_rgba(63,163,22,0.18)]"
    />
    <div slot="right">
      <p class="text-left text-base leading-relaxed text-[#dfeacf]">
        แชร์ลิงก์แนะนำของ RUAYHENG289 ให้เพื่อนสมัครสมาชิก รับโบนัสค่าแนะนำสูงถึง 0.8% ตามเงื่อนไขที่กำหนด
        พร้อมทีมงานคอยดูแลและให้คำแนะนำได้ตลอด 24 ชั่วโมง
      </p>
    </div>
  </ContentBoxSevenThreePremium>

  <LatestWinnersPremium />

  <ContentBox>
    <p class="text-left text-lg font-black text-[#a4e254]">เริ่มต้นใช้งานได้ง่ายเพียง 3 ขั้นตอน</p>
    <FeatureHighlights items={onboardingSteps} heading={false} />
  </ContentBox>

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#a4e254] to-[#3fa316] px-4 py-3 text-sm font-black whitespace-nowrap text-[#0a1207] shadow-[0_10px_30px_rgba(63,163,22,0.26)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(63,163,22,0.4)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>

    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#2f6b0f]/70 bg-[#0a1207]/85 px-4 py-3 text-sm font-black whitespace-nowrap text-[#dfeacf] backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:border-[#3fa316] hover:bg-[#122008]/85 hover:shadow-[0_15px_40px_rgba(85,170,37,0.35)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>
  </div>

  <Faq title="คำถามที่พบบ่อยเกี่ยวกับ RUAYHENG289" faqs={faqs} />

  <ReviewCardSumo2 />

  <Navfoot />
</MainLayout>
