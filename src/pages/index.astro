---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxHuay from "../components/ContentBoxHuay.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxTwoHuay from "../components/ContentBoxTwoHuay.astro";
import ContentBox3ThreeHuay from "../components/ContentBox3ThreeHuay.astro";
import LottoGrid from "../components/LottoGrid.astro";
import LatestWinners from "../components/LatestWinnersHuay.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import Faq4 from "../components/Faq4.astro";
import Navfoot from "../components/Navfoot.astro";

import { pageGraph } from "../lib/schema";

// NO IMAGES ON THIS PAGE BEYOND THE HERO — deliberate, and here is why, so the
// next rebrand does not "fix" it by wiring a slide back in:
//   banner1 / banner1-mobile  = MainLayout's own pinned globs. A page never
//                               references them.
//   banner2.png (2026-08-20), banner3.png (2026-08-11), slide3.png and
//   slide4.png (2026-08-13) all predate the 2026-09-17 asset drop -> stale
//   inventory from earlier clients, must stay unimported.
//   slide1.png (แนะนำเพื่อน 0.8%) and slide2.png (คืนยอดเสีย 0.3%) ARE from this
//   drop, but LOTTOKA's brief has no promotion section at all, so neither maps
//   onto a docx heading. Per the SevenThree rule a slide with no matching
//   section is left unused rather than forced into another box — so this round
//   ships ZERO ContentBoxSevenThree* blocks on the index. Both slides render on
//   /promotion, which is their page.
//
// Dropped from the previous brand's index and NOT deleted from disk (they are
// inventory for the next brand): ProviderGrid (casino provider logos — off
// topic for a pure lottery brand), GameRankingBoard (slot-game popularity board
// — would duplicate LottoGrid), FeatureHighlights (its sub-point role under
// docx H2 #2 is carried by LottoGrid instead).

// Title and description are the brief's own Title/Meta Description lines, used
// verbatim. A brief-supplied description is never padded up to the 150-char
// floor and never topped up from the H1/H2.
const pageTitle = "LOTTOKA แทงหวยลอตโต้เว็บหลัก ยอดเข้าบัญชีบริษัทโดยตรง";

const pageDescription = "LOTTOKA แทงหวยลอตโต้เว็บหลัก รัฐบาลไทย ลาว ออมสิน ฮานอย หวยหุ้น จ่ายตรง ฝากถอนวอลเลทและทุกธนาคาร รับยอดฝากถอนเข้าเต็ม100%";

// <Announcement /> runs bare: AnnouncementHuay's default message is already this
// brand's copy, and every casino-side sub-page calls it bare too — passing an
// override here is how the ticker ends up saying two different things on two
// pages.

// The docx has a real H1 -> H2 -> H3 hierarchy this round (#4 and #5 are genuine
// H3 sub-points of #3), so the page is NOT flattened to H2-only. The only other
// H3s are the three signup steps under #6, carried by ContentBox3ThreeHuay.
// The five lottery markets under #2 are a bullet list in the docx, not headings,
// so LottoGrid renders them as chrome — <p> labels plus an aria-label, no
// heading tag.

// One array, used by both <Faq4> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last. The three pairs
// are the brief's Q1-Q3, verbatim, with only the "Q1:"/"A:" prefixes removed.
const faqs = [
  {
    q: 'ระบบโอนเงิน "เข้าบัญชีบริษัทโดยตรง" ดีอย่างไร?',
    a: "การฝาก-ถอนเงินเข้าบัญชีบริษัทโดยตรง (ไม่ผ่านบัญชีม้า) ช่วยเพิ่มความปลอดภัยขั้นสูงสุดให้กับสมาชิก ป้องกันปัญหาเว็บโดนบล็อกหรือการทุจริต ยอดเงินของคุณจะถูกทำรายการอย่างถูกต้อง โปร่งใส และได้รับเงินเต็ม 100% อย่างรวดเร็ว",
  },
  {
    q: "LOTTOKA รองรับการฝาก-ถอนผ่านช่องทางไหนบ้าง มีขั้นต่ำไหม?",
    a: "เรารองรับการทำธุรกรรมผ่านทุกธนาคารชั้นนำในประเทศไทย และระบบ TrueMoney Wallet ดำเนินการด้วยระบบออโต้ที่รวดเร็วทันใจ และที่สำคัญคือ ไม่มีขั้นต่ำ ในการฝากเงิน",
  },
  {
    q: "ถ้ามีเลขดัง หรือเลขอั้น ทางเว็บจะจ่ายเต็มหรือไม่?",
    a: "LOTTOKA มีนโยบายรับแทงทุกเลข ไม่มีปิดกั้น หากคุณทำรายการแทงสำเร็จก่อนที่ระบบจะปิดรับโพย หากถูกรางวัล เราการันตีจ่ายเต็มจำนวนตามเรทราคาที่กำหนดไว้ในบิล โดยไม่มีการหักเปอร์เซ็นต์ย้อนหลัง",
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// The highlight colour is the palette's pale rose (#ff9a9d); it marks a claim
// the brief states outright and nothing else.

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb. Every URL in the graph is derived
// by pageGraph from `site:` — no domain is typed out in this file.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxHuay as="h1" title="LOTTOKA แทงหวยลอตโต้เว็บหลัก จ่ายไว จ่ายตรง ยอดเต็ม100%">
    <p class="text-left text-base leading-relaxed text-[#ded9da]">
      ยินดีต้อนรับสู่ LOTTOKA (ลอตโตก้า)
      <strong class="text-[#ff9a9d]">เว็บแทงหวยออนไลน์ที่เป็นแพลตฟอร์มหลักเว็บตรง ไม่ผ่านเอเย่นต์</strong>
      โดดเด่นด้วยระบบการเงินที่โปร่งใสและปลอดภัยที่สุดในยุคนี้ เพราะทุกยอดการฝาก-ถอนของคุณจะถูกโอนเข้าสู่
      <strong class="text-[#ff9a9d]">บัญชีของบริษัทโดยตรง ไม่มีการใช้บัญชีม้าหรือผ่านบุคคลที่สาม</strong>
      <strong class="text-[#ff9a9d]">รับประกันยอดเงินเข้าเต็ม 100% ไม่มีหักค่าธรรมเนียม จ่ายไว จ่ายตรง</strong>
      ให้คุณสนุกกับการลุ้นตัวเลขได้อย่างสบายใจไร้กังวล
    </p>
  </ContentBoxHuay>

  <ContentBoxFloatingBadge as="h2" title="LOTTOKA รัฐบาลไทย ลาว ออมสิน ฮานอย หวยหุ้น ครบทุกแนว">
    <p class="text-left text-base leading-relaxed text-[#ded9da]">
      ที่ LOTTOKA
      <strong class="text-[#ff9a9d]">เราคือศูนย์รวมหวยออนไลน์ที่ครบครันที่สุด ตอบโจทย์คอหวยทุกสาย</strong>
      ไม่ว่าคุณจะชอบลุ้นรางวัลใหญ่หรือชอบทำกำไรทุกวัน
      <strong class="text-[#ff9a9d]">เรามีเปิดรับแทงครบทุกประเภท:</strong>
    </p>
  </ContentBoxFloatingBadge>

  <LottoGrid />

  <ContentBoxSpecial as="h2" title="อัตราจ่าย LOTTOKA เต็มทุกบิล ไม่หักเปอร์เซ็นต์" iconleft="💰" iconright="💯">
    <p slot="left" class="text-left text-base leading-relaxed text-[#ded9da]">
      เรากล้าให้มากกว่าใคร!
      <strong class="text-[#ff9a9d]">ด้วยความเป็นเว็บหลักที่มีฐานการเงินมั่นคงระดับประเทศ</strong>
      LOTTOKA จึงสามารถมอบอัตราการจ่ายที่สูงที่สุดในตลาด
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#ded9da]">
      แทงถูกปุ๊บ
      <strong class="text-[#ff9a9d]">รับเงินเต็มจำนวนปั๊บ ไม่มีหักเปอร์เซ็นต์ใดๆ ทั้งสิ้น</strong>
    </p>
  </ContentBoxSpecial>

  <ContentBoxTwoHuay as="h3" titleleft="ถูก 2ตัวจ่าย 100บาท" titleright="ถูก 3ตัวจ่าย 1,000บาท" iconleft="🎯" iconright="🏆">
    <p slot="left" class="text-left text-base leading-relaxed text-[#ded9da]">
      คุ้มค่าสุดๆ กับการแทงหวย 2 ตัวบน และ 2 ตัวล่าง
      <strong class="text-[#ff9a9d]">รับอัตราจ่ายสูงสุดถึง บาทละ 100</strong>
      ลงทุนเพียงเล็กน้อยก็สามารถสร้างกำไรก้อนโตได้ง่ายๆ
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#ded9da]">
      สัมผัสประสบการณ์รวยพริบตาเมื่อทายผล 3 ตัวตรงถูกต้อง รับเงินรางวัลไปเลยในเรทสูงสุด
      <strong class="text-[#ff9a9d]">บาทละ 1,000 จ่ายจริง จ่ายเต็ม ทุกบิลการเดิมพัน</strong>
    </p>
  </ContentBoxTwoHuay>

  <LatestWinners />

  <ContentBox as="h2" title="สมัคร LOTTOKA ด้วยตัวเอง 3 ขั้นตอน">
    <p class="text-left text-base leading-relaxed text-[#ded9da]">
      เริ่มต้นรับความคุ้มค่าและปลอดภัยกับ LOTTOKA ได้ง่ายๆ
      <strong class="text-[#ff9a9d]">ผ่านระบบสมัครสมาชิกอัตโนมัติ (Auto) ใช้เวลาเพียงไม่กี่วินาที:</strong>
    </p>
  </ContentBox>

  <ContentBox3ThreeHuay as="h3" label="สามขั้นตอนการสมัครสมาชิก LOTTOKA ด้วยตัวเอง" titleleft="กรอกเบอร์โทรศัพท์" titlecenter="ผูกบัญชีธนาคารหรือวอลเลท" titleright="ตั้งรหัสผ่าน">
    <p slot="left" class="text-left text-base leading-relaxed text-[#ded9da]">
      ระบุเบอร์มือถือที่ใช้งานจริง
      <strong class="text-[#ff9a9d]">เพื่อรับรหัส OTP สำหรับการยืนยันตัวตนและความปลอดภัยของข้อมูล</strong>
    </p>
    <p slot="center" class="text-left text-base leading-relaxed text-[#ded9da]">
      เลือกธนาคารหรือ TrueMoney Wallet แล้วระบุเลขบัญชี
      <strong class="text-[#ff9a9d]">(ชื่อ-นามสกุลต้องตรงกับชื่อที่สมัคร เพื่อให้ระบบโอนยอดเข้า-ออกบริษัทโดยตรงได้อย่างถูกต้อง)</strong>
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#ded9da]">
      กำหนดรหัสผ่านที่รัดกุม ล็อคอินเข้าสู่ระบบ เติมเงินฝากเครดิต
      <strong class="text-[#ff9a9d]">แล้วเริ่มแทงหวยได้ทันที</strong>
    </p>
  </ContentBox3ThreeHuay>

  <LoginRtpSection />

  <ContentBoxHuay as="h2" title="ช่องทางติดต่อแอดมิน LOTTOKA ได้ 24 ชั่วโมง">
    <p class="text-left text-base leading-relaxed text-[#ded9da]">
      เราให้ความสำคัญกับการบริการลูกค้าเป็นอันดับหนึ่ง ทีมงานแอดมินคุณภาพของ LOTTOKA
      <strong class="text-[#ff9a9d]">พร้อมสแตนด์บายดูแลคุณผ่าน Line Official ตลอด 24 ชั่วโมง</strong>
      ไม่ว่าคุณจะต้องการคำแนะนำในการแทงหวย สอบถามเรื่องระบบการโอนเงินตรงเข้าบริษัท หรือแจ้งปัญหาการใช้งาน
      <strong class="text-[#ff9a9d]">แอดมินของเราพร้อมตอบกลับอย่างรวดเร็ว สุภาพ และแก้ปัญหาให้อย่างมืออาชีพ</strong>
    </p>
  </ContentBoxHuay>

  <Faq4 as="h2" title="คำถามที่พบบ่อย (FAQ)" faqs={faqs} />

  <ReviewCardSumo2 />

  <Navfoot />
</MainLayout>
