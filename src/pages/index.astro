---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement5 from "../components/Announcement5.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import LottoGrid from "../components/LottoGrid.astro";
import ContentBox from "../components/ContentBox.astro";
import LatestWinnersCyber from "../components/LatestWinnersCyber.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import Faq3 from "../components/Faq3.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgBanner2 from "../assets/banner2.png";
import imgBanner3 from "../assets/banner3.png";
import imgSlide1 from "../assets/slide1.png";

const pageTitle = "HSOD รับหวยเลขอั้น ไม่จํากัดยอดแทง จ่ายเต็มทุกบิล ปล่อยถอนทันที";

const pageDescription =
  "HSOD เว็บแทงหวยออนไลน์ รับหวยเลขอั้นทั้ง 2 ตัว 3 ตัว รองรับยอดแทงตามเงื่อนไข เรทจ่ายสูงสุด 1,000 ตรวจโพยง่าย ฝากถอนออโต้ พร้อมแอดมินบริการตลอด 24 ชั่วโมง";

const registerSteps = [
  {
    icon: "📝",
    title: "สมัครสมาชิกและกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน",
    description: "",
    accent: "red" as const,
  },
  {
    icon: "🔐",
    title: "Login เข้าสู่บัญชีและฝากเครดิตผ่านระบบอัตโนมัติ",
    description: "",
    accent: "silver" as const,
  },
  {
    icon: "🎯",
    title: "เลือกประเภทหวย ใส่เลขและยอดแทง ตรวจสอบรายละเอียดก่อนกดยืนยันโพย",
    description: "",
    accent: "red" as const,
  },
];

const faqs = [
  {
    q: "HSOD รับแทงเลขอั้น 2 ตัวและ 3 ตัวหรือไม่?",
    a: "ระบบรองรับการเดิมพันเลข 2 ตัวและ 3 ตัว รวมถึงเลขที่มีการกำหนดวงเงินเฉพาะในแต่ละรอบ โดยวงเงินและอัตราจ่ายอาจแตกต่างกัน ควรตรวจสอบข้อมูลที่ระบบแสดงก่อนยืนยันโพยทุกครั้ง",
  },
  {
    q: "หวย 3 ตัวจ่ายสูงสุด 1,000 ทุกประเภทหรือไม่?",
    a: "เรทจ่ายสูงสุดขึ้นอยู่กับประเภทหวย รอบเดิมพัน และเงื่อนไขของรายการนั้น ๆ ลูกค้าควรตรวจสอบอัตราจ่ายที่แสดงบนหน้าส่งโพยก่อนเดิมพัน เพื่อทราบเรทที่ใช้กับรายการของตนอย่างชัดเจน",
  },
  {
    q: "แทงถูกแล้วสามารถถอนเงินได้อย่างไร?",
    a: "เมื่อระบบตรวจผลและเครดิตยอดตามเงื่อนไขเรียบร้อยแล้ว สมาชิกสามารถเข้าสู่หน้าถอนเงิน กรอกจำนวนที่ต้องการ และยืนยันรายการผ่านระบบ หากพบปัญหาหรือรายการล่าช้า สามารถติดต่อแอดมิน HSOD ให้ช่วยตรวจสอบได้ตลอด 24 ชั่วโมง",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement5
    message="HSOD รับแทงหวยเลขอั้นทุกประเภท ไม่จำกัด • รับหวย 2 ตัว 3 ตัว เรทจ่ายสูงสุด 1,000 ตามเงื่อนไขของแต่ละรอบ • แทงถูก จ่ายเต็มทุกบิล ปล่อยถอนทันที ไม่ล็อกโพย • เลือกเลข ส่งโพย และตรวจสอบรายการผ่านมือถือได้ตลอดเวลา • แอดมิน HSOD บริการออนไลน์ 24 ชั่วโมง"
  />

  <SmoothCarousel />

  <ContentBoxNeumorphism as="h1" title="HSOD รับแทงหวยเลขอั้น ทุกประเภท ไม่จำกัด">
    <p class="text-left text-base leading-relaxed text-[#dfe3ea]">
      <strong class="text-[#e8121d]">HSOD</strong> เปิดบริการสำหรับลูกค้าที่ต้องการแทงหวยออนไลน์ โดยรองรับทั้งเลข 2 ตัว 3 ตัว และเลขอั้นตามเงื่อนไขของแต่ละรอบ สามารถเลือกเลข กรอกยอดแทง
      และตรวจสอบโพยผ่านมือถือได้อย่างสะดวก พร้อมระบบฝากถอนอัตโนมัติที่ช่วยให้จัดการเครดิตได้รวดเร็ว ก่อนยืนยันรายการทุกครั้งสามารถตรวจสอบเรทจ่าย วงเงิน และรายละเอียดของโพยได้โดยตรงจากระบบ
    </p>
  </ContentBoxNeumorphism>

  <ContentBoxFloatingBadge as="h2" title="HSOD แทงถูก จ่ายทันที ให้เต็มทุกบิล ไม่บิดแน่นอน">
    <p class="text-left text-base leading-relaxed text-[#dfe3ea]">
      ลูกค้าสามารถตรวจสอบโพยหวยที่ยืนยันแล้วและติดตามผลของแต่ละรอบผ่านบัญชีสมาชิกได้ หลังประกาศผล ระบบจะตรวจสอบรายการตามเลขและประเภทการเดิมพัน
      พร้อมดำเนินการตามอัตราจ่ายและเงื่อนไขที่แสดงไว้ก่อนส่งโพย แนะนำให้ตรวจสอบรายละเอียดของรายการทุกครั้ง เพื่อให้ทราบเรทและยอดที่ใช้คำนวณอย่างชัดเจน
    </p>
  </ContentBoxFloatingBadge>

  <LottoGrid />

  <ContentBox as="h2" title="HSOD รับหวย 2 ตัว 3 ตัว จ่ายสูงสุด 1,000 ไม่อั้นทุกรายการ">
    <div>
      <p class="text-left text-base leading-relaxed text-[#dfe3ea]">
        HSOD รองรับการแทงหวยทั้งเลข 2 ตัวและเลข 3 ตัว พร้อมอัตราจ่ายสูงสุด 1,000 ตามประเภทหวยและเงื่อนไขของแต่ละรอบ ลูกค้าสามารถกรอกเลขที่ต้องการ ระบุยอดแทง
        และตรวจสอบวงเงินรับของเลขนั้นก่อนยืนยันโพยได้ทันที ช่วยให้วางรายการแทงได้สะดวกยิ่งขึ้น โดยควรยึดเรทและวงเงินที่ระบบแสดง ณ เวลาส่งโพยเป็นหลัก
      </p>
      <Picture
        src={imgBanner2}
        loading="lazy"
        fetchpriority="low"
        widths={[320, 640, 960]}
        sizes="(max-width: 768px) 100vw, 672px"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={72}
        alt="แบนเนอร์ HSOD พื้นหลังดำลายวงจรเรืองแสงสีแดง โลโก้ HSOD ตัวอักษรโครเมียมเงินขอบแดง ข้อความ หวย 2 ตัว 3 ตัว จ่ายสูงสุด 1,000 หญิงสาวผมยาวสีเงินสวมชุดหนังแดง-ดำ มือถือแสดงหน้าแทงหวยออนไลน์และผลรางวัลล่าสุด ลูกบอลหวยเลข 8 3 2 และ 7 กับโถหมุนรางวัล แถบล่างเขียนว่า มั่นคง ปลอดภัย จ่ายจริง 100% ออกรางวัลไวทุกวัน และเล่นง่าย จ่ายชัวร์ 24 ชั่วโมง"
        class="mx-auto mt-6 h-auto w-full max-w-2xl rounded-2xl border border-[#7c0207]/45 shadow-[0_10px_30px_rgba(232,18,29,0.18)]"
      />
    </div>
  </ContentBox>

  <LatestWinnersCyber />

  <ContentBoxSevenThreePremium title="สมัครแทงหวย HSOD แทงถูกปล่อยถอนทันที ไม่ล็อกโพย">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่น HSOD พื้นหลังดำลายวงจรเรืองแสงสีแดง โลโก้ HSOD ตัวอักษรโครเมียมเงินขอบแดง ข้อความ โปรโมชั่น คืนยอดเสีย รับโบนัส พร้อมตัวเลข 0.3% ขนาดใหญ่ หญิงสาวผมยาวสีเงินสวมชุดหนังแดง-ดำ ยืนข้างมือถือที่แสดงหน้าแทงหวยและผลรางวัล ลูกบอลหวยเลข 8 3 9 กองเหรียญทอง และสลากกินแบ่งรัฐบาล"
      class="mx-auto h-auto w-full rounded-2xl border border-[#7c0207]/45 shadow-[0_10px_30px_rgba(232,18,29,0.18)]"
    />
    <div slot="right">
      <p class="text-left text-base leading-relaxed text-[#dfe3ea]">เริ่มต้นแทงหวย HSOD ผ่านมือถือได้ง่ายเพียง 3 ขั้นตอน</p>
      <FeatureHighlights items={registerSteps} />
      <p class="mt-6 text-left text-base leading-relaxed text-[#dfe3ea]">
        เมื่อมีรายการที่เข้าเงื่อนไขการถอน สมาชิกสามารถส่งคำขอถอนผ่านระบบได้ตามขั้นตอน พร้อมตรวจสอบสถานะธุรกรรมผ่านบัญชีของตนเอง หากพบรายการค้างสามารถแจ้งเจ้าหน้าที่ให้ช่วยตรวจสอบได้
      </p>
    </div>
  </ContentBoxSevenThreePremium>

  <LoginRtpSection />

  <ContentBoxCyberCut as="h2" title="มีแอดมิน HSOD บริการออนไลน์ตลอด 24 ชั่วโมง">
    <div>
      <p class="text-left text-base leading-relaxed text-[#dfe3ea]">
        หากพบปัญหาเกี่ยวกับการสมัครสมาชิก ฝากเงิน ถอนเงิน เครดิตไม่เข้า การส่งโพย หรือไม่สามารถตรวจสอบรายการได้ สามารถติดต่อแอดมิน HSOD ได้ตลอด 24 ชั่วโมง
        เจ้าหน้าที่พร้อมช่วยตรวจสอบข้อมูลและแนะนำวิธีดำเนินการตามขั้นตอน เพื่อให้ลูกค้ากลับมาใช้งานระบบได้อย่างต่อเนื่อง
      </p>
      <Picture
        src={imgBanner3}
        loading="lazy"
        fetchpriority="low"
        widths={[320, 640, 960]}
        sizes="(max-width: 768px) 100vw, 672px"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={72}
        alt="แบนเนอร์ HSOD พื้นหลังดำลายวงจรเรืองแสงสีแดง โลโก้ HSOD ตัวอักษรโครเมียมเงินขอบแดงพร้อมคำว่า เว็บล็อตเตอรี่ออนไลน์ ข้อความ แอดมิน HSOD บริการออนไลน์ ตลอด 24 ชั่วโมง หญิงสาวผมสั้นสีเงินสวมสูทสีแดงชี้นิ้วขึ้น มือถือแสดงเมนูประเภทหวยและผลรางวัลล่าสุด ลูกบอลหวยเลข 3 8 และ 7 วางบนสลากกินแบ่งรัฐบาล"
        class="mx-auto mt-6 h-auto w-full max-w-2xl rounded-2xl border border-[#7c0207]/45 shadow-[0_10px_30px_rgba(232,18,29,0.18)]"
      />
      <a
        href="/line"
        class="mt-6 inline-flex items-center justify-center gap-2 rounded-full bg-gradient-to-r from-[#00B900] to-[#009900] px-7 py-3 text-sm font-black text-white shadow-[0_10px_30px_rgba(0,185,0,0.24)] transition-transform duration-300 hover:-translate-y-0.5 hover:scale-105">
        <span aria-hidden="true">💬</span> ติดต่อแอดมิน HSOD ผ่าน LINE
      </a>
    </div>
  </ContentBoxCyberCut>

  <Faq3 title="คำถามที่พบบ่อยเกี่ยวกับ HSOD" faqs={faqs} />

  <ReviewCardSumo2 />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#ff4d55] via-[#e8121d] to-[#7c0207] px-4 py-3 text-sm font-black whitespace-nowrap text-[#1a0204] shadow-[0_10px_30px_rgba(232,18,29,0.28)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(232,18,29,0.42)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#c2c9d4]/50 bg-gradient-to-r from-[#1c1e22] to-[#170406] px-4 py-3 text-sm font-black whitespace-nowrap text-[#c2c9d4] shadow-[0_10px_30px_rgba(194,201,212,0.16)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#e8121d]/60 hover:text-[#ff4d55] hover:shadow-[0_15px_40px_rgba(232,18,29,0.28)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>
  </div>

  <Navfoot />
</MainLayout>
