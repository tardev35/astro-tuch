---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import LatestWinners from "../components/LatestWinnersPremium.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxTwo from "../components/ContentBoxTwo.astro";
import ContentBox3ThreePremium from "../components/ContentBox3ThreePremium.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import Faq from "../components/Faq2.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import { pageGraph } from "../lib/schema";
import promoCashback from "../assets/slide2.png";
import promoReferral from "../assets/slide1.png";

// การหมุน variant รอบนี้ตัดสินไว้แล้วใน .claude/brand-spec-madum168.md §3 —
// ห้ามเลือกใหม่ที่นี่ แบรนด์ขาออก (นาซ่า168) ถูกหมุนออกจากทุกตระกูลพร้อมกัน:
// AnnouncementPremium แทน AnnouncementCyber · LatestWinnersPremium แทน
// LatestWinnersCyber · Faq2 แทน Faq4 · ReviewCardSumo2 แทน ReviewCardSumo ·
// และ shape-mix ของ ContentBox ทิ้ง Neumorphism / 3ThreeCyberCut / TwoPremium /
// SevenThreePremium / SevenThreeNeumorphism / FloatingBadge / TwoCyberCut
// ไปใช้ Premium / Two / 3ThreePremium / SevenThree / SevenThreeCyberCut /
// CyberCut / Special แทน — **ไม่ทับไฟล์เดิมแม้แต่ตัวเดียว**
// Navbar/Footer อยู่ที่ MainLayout (NavbarCyber -> NavbarStyle4Black,
// FooterCyber -> FooterPremium) ไม่ใช่ที่ไฟล์นี้
//
// พาเลตรอบนี้ (brand-spec §2 ล็อกค่าไว้แล้ว ห้ามเดาเพิ่ม): พื้นเพจ #00091f ·
// การ์ด #0b1733 · เส้น #2a3c70 · หมึก #f4eef1 · แดงคริมสันเป็นฮิวนำ #ff2e52 /
// #e01238 / #c9102f · น้ำเงินอะซัวร์เป็นวัสดุที่สอง #1177e8 / #0e68cc / #0a4ea8
// ⚠️ อะซัวร์ **ห้ามถือตัวอักษร** — ไฮไลต์ในย่อหน้าทั้งหมดจึงเป็น #ff2e52 ตัวเดียว
// (4.9:1 บนการ์ด) บนหมึกที่การ์ดกำหนดเองคือ #f4eef1
// ย่อหน้าในไฟล์นี้ไม่ถือคลาสสีของตัวเอง — ทุก ContentBox* ในมิกซ์นี้ตั้ง
// `text-left text-base leading-relaxed text-[#f4eef1]` ไว้บน element ที่ถือ slot
// อยู่แล้ว และไม่มี `<p>` ไหนมี mx-auto / max-w-* (การ์ดคุมความกว้างเองแล้ว)
//
// ชื่อแบรนด์ไม่พิมพ์ตรงๆ ในไฟล์นี้เลย — interpolate จาก ${BRAND_NAME} ทุกจุด
// รวมถึงใน alt ของสองสไลด์ ไม่มีโดเมนเขียนไว้ที่ไหน และไม่มี URL ที่ต่อด้วย `+`
//
// <strong> ทุกตัวคร่อม "ก้อนที่คั่นด้วยช่องว่าง" ทั้งก้อน เพราะภาษาไทยไม่มีช่องว่าง
// ระหว่างคำ — ไฮไลต์ที่เริ่มหรือจบกลางคำจะถูก formatter ตัดบรรทัดในแท็กแล้วแทรก
// ช่องว่างกลางคำ อ่านคอปปี้โดยถอดแท็กออกต้องได้ข้อความเดิมเป๊ะ และไม่มี <strong>
// สองตัวติดกันโดยไม่มีข้อความธรรมดาคั่น
//
// บรีฟรอบนี้ **โฆษณาและกำกับในประโยคเดียวกัน** (brand-spec §5): หัวข้อของบรีฟเอง
// เขียนว่า เปย์แรง / จ่ายไม่มีอั้น / ไม่จำกัด ขณะที่ย่อหน้าของบรีฟเองตอบว่า
// โปรโมชั่นไม่ได้รับประกันผลกำไร · ไม่สามารถรับประกันระยะเวลาหรือจำนวนเงินที่ถอนได้
// · การคืนเครดิตไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพัน — ship ทั้งสองครึ่ง
// ตรงตามที่บรีฟเขียน คำโฆษณาอยู่เฉพาะในหัวข้อที่บรีฟเขียนไว้เอง ไม่ขยายเป็นคำ
// กล่าวอ้างใหม่ และทุกประโยคกำกับ ship ครบ ไม่ตัดเพราะฟังดูลบ
// ตัวเลขบนหน้านี้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 24ชม. ไม่มีจำนวนเกม ไม่มี RTP
// ไม่มีปีก่อตั้ง ไม่มีจำนวนสมาชิก ไม่มียอดขั้นต่ำเป็นตัวเลข
//
// title/description = บรรทัด 1-2 ของบรีฟตรงตัว (src/assets/content.txt)
// description ยาว 112 ตัวอักษร — **ห้ามเติมให้ครบ 150** verify-build ยกเว้นเพดานล่าง
// ให้หน้าแรกไว้เพราะเหตุผลนี้ ส่วนเพดานบน 160 ยังผ่านสบาย
const pageTitle = `${BRAND_NAME} เกมสล็อตเปย์แรง แจกโบนัสสมาชิกทุกวัน ไม่อั้น`;

const pageDescription = `${BRAND_NAME} เกมสล็อตเปย์แรง สมัครรับโปรใหม่ เก็บโบนัสได้ทุกวัน ฝากถอนง่าย จ่ายเร็ว ยอดสูงเท่าไหร่ เราก็จ่ายไม่มีอั้น`;

// บรีฟรอบนี้มีชั้น H1 -> H2 -> H3 จริง จึง **ไม่** แบนเป็น H2 ล้วน มี H3 สองตัวพอดี
// และทั้งคู่เป็นบรรทัด H3 ของบรีฟเอง (content.txt บรรทัด 9 และ 11 = สองโปรโมชั่นย่อย
// ใต้ H2 ของ §3) รอบนี้ไม่มี FeatureHighlights จึงไม่มีแหล่ง H3 ที่สาม
//
// checklist ตามลำดับเอกสาร (brand-spec §4) และตัวที่รับแต่ละข้อ:
//    1 H1  ${BRAND_NAME}เกมสล็อตเปย์แรง สมัครรับโปรใหม่ เก็บโบนัสได้ทุกวัน
//          ContentBoxPremium, ย่อหน้าบรรทัด 4
//    2 H2  ${BRAND_NAME} ฝากถอนง่าย จ่ายเร็ว ยอดสูงเท่าไหร่ เราก็จ่ายไม่มีอั้น
//          ContentBoxTwo, บรรทัด 6 แบ่งสองครึ่ง
//    3 H2  โปรโมชั่นสมาชิก ${BRAND_NAME} อัปเดตใหม่ตลอดทั้งเดือน
//          ContentBox3ThreePremium, บรรทัด 8 แบ่งสามส่วน
//    4 H3  โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน
//          ContentBoxSevenThree + slide2, บรรทัด 10 ซ้าย / ภาพขวา
//    5 H3  โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด
//          ContentBoxSevenThreeCyberCut + slide1, บรรทัด 12 ซ้าย / ภาพขวา
//    6 H2  ระบบฝากถอน ${BRAND_NAME} ได้ทุกธนาคารและทรูมันนี่
//          ContentBoxCyberCut, บรรทัด 14
//    7 H2  ช่องทางติดต่อแอดมินเว็บสล็อต ${BRAND_NAME} ตลอด 24ชม.
//          ContentBoxSpecial, บรรทัด 16 แบ่งสองครึ่ง
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ ${BRAND_NAME}
//          Faq2 + prop faqs ชัดเจน, บรรทัด 18-23
// inventory ที่ต้องได้: **h1 ×1 · h2 ×5 · h3 ×2** — ตรงเป้าของ brand-spec §4
//
// ⚠️ จุดที่ชั้น heading รั่วได้ และกันไว้แล้วทุกจุด: ContentBox3ThreePremium จะยก
// ป้ายสามคอลัมน์เป็น heading ถ้าสั่ง — หน้านี้ส่ง heading={false} จึงออกเป็น <p>
// ส่วน ContentBoxTwo รับ titleleft/titleright เป็น <p> อยู่แล้วตามตัวมันเอง และ
// **ไม่ส่ง titleright ให้ SevenThree ทั้งสองบล็อก** คอลัมน์ภาพจึงไม่มี heading
// grep `<h[1-6]` ในทุก component ที่ไฟล์นี้กับ MainLayout เรียกแล้วรอบนี้ — ไม่มีตัวไหน
// hardcode heading ไว้เลย ทุกแท็ก heading บนหน้ามาจาก prop คือมาจากบรีฟทั้งหมด
//
// ทั้ง ContentBoxSevenThree* วาง md:grid-cols-[7fr_3fr] โดยให้ **คอลัมน์ข้อความมาก่อน**
// ภาพจึงไปอยู่ slot="right" ทุกครั้ง: heading ลงบนเนื้อความไม่ใช่บนภาพ และบนมือถือ
// คอลัมน์เดียวอ่านลำดับ หัวข้อ -> ข้อความ -> ภาพ ไม่ใช่เปิดด้วยรูป
// สองบล็อกนี้คือ **เพดาน 2 บล็อกของตระกูล SevenThree พอดี** และ **สไลด์ขึ้นได้เฉพาะ
// ในสองบล็อกนี้เท่านั้น** — รอบก่อนวางกริดโปสเตอร์คู่ไว้บนหน้าซึ่งผิด HARD RULE
// ของ playbook รอบนี้จึงไม่มีกริดนั้น
// การจับคู่สไลด์อ่านจากตัวอักษรบนภาพเอง: slide2 เขียน คืนยอดเสีย 0.3% -> §4 ·
// slide1 เขียน แนะนำเพื่อน 0.8% -> §5
// slide3/slide4 กับ banner2/banner3 เป็นของค้างจากแบรนด์เก่า (brand-spec §1)
// **ห้าม import** เพราะ eager import = emit ขึ้น dist ทุก build แม้ไม่มีหน้าไหน render
//
// ทุกย่อหน้าของบรีฟ ship ครบ ไม่มีการรวบหรือย่อ — §2 กับ §7 ครึ่งละคอลัมน์ §3 สามส่วน
// และ **ไม่มี slot ไหนรับมากกว่า 1 element** กฎ one-element-per-slot จึงถือได้ทุกจุด
// โดยไม่ต้องห่อ <div> เพิ่ม
//
// ที่เหลือบนหน้าเป็น chrome และไม่ออกแท็ก heading ที่ระดับไหนเลย: AnnouncementPremium,
// LatestWinnersPremium และ ReviewCardSumo2 ขึ้นชื่อหัวข้อเป็น <p>/<span> พร้อม
// aria-label บน <section> ส่วนคำถามของ FAQ อยู่ใน <summary> วิดเจ็ตที่ไม่ใช่ของบรีฟ
// วางไว้ก่อน §1 (ticker) และหลัง §8 (ฟีดถอนเงิน -> การ์ดรีวิว -> Navfoot) เท่านั้น
// ไม่แทรกกลางสองหัวข้อของบรีฟ
//
// <Announcement /> เรียกเปล่าโดยตั้งใจ: orchestrator ตั้ง default message ของ
// AnnouncementPremium เป็นคอปปี้ของแบรนด์นี้ไว้แล้วใน P1 (ย่อหน้าบรรทัด 4 ของบรีฟ)
// และหน้าย่อยทั้ง 7 หน้าก็เรียกเปล่าเหมือนกัน — ticker จึงตรงกันทั้งเว็บจากแหล่งเดียว
// ไม่มี emoji นำหน้าข้อความใน message ด้วย (prop อ่านออกเสียงซ้ำสามรอบใน marquee)

// อาร์เรย์เดียว ใช้ทั้งกับ <Faq> และโน้ด FAQPage — ไม่ใช้ default ของ component
// (Faq2 ตั้งใจ ship เป็นลิสต์ว่าง prop ที่ลืมส่งจึงได้ accordion เปล่า ไม่ใช่คำถามของ
// แบรนด์ก่อน) สามคู่นี้คือบล็อก Q/A ของบรีฟเอง (content.txt บรรทัด 18-23) ตรงตัว
// ตัดเฉพาะหมายเลข "1." "2." "3." ออกเพราะ accordion เป็นตัวลิสต์อยู่แล้ว
// ทุกคำตอบคงประโยคกำกับของบรีฟไว้ครบ — เป็นเนื้อหาของบรีฟทั้งสองครึ่ง
const faqs = [
  {
    q: `${BRAND_NAME} มีโปรโมชั่นสำหรับสมาชิกทุกวันหรือไม่?`,
    a: `ตามข้อมูลที่ระบุ ${BRAND_NAME} มีโปรโมชั่นคืนยอดเสีย 0.3% รายวัน และโบนัสแนะนำเพื่อน 0.8% โดยควรตรวจสอบเงื่อนไขและรอบรับเครดิตจากประกาศล่าสุดก่อนเข้าร่วม`,
  },
  {
    q: `${BRAND_NAME} ฝากถอนผ่านธนาคารและทรูมันนี่ได้หรือไม่?`,
    a: `เว็บไซต์ระบุว่ารองรับธนาคารและทรูมันนี่ แต่ควรตรวจสอบรายชื่อธนาคารที่ใช้งานได้จริง ยอดขั้นต่ำ และเงื่อนไขการทำรายการก่อนฝากถอนทุกครั้ง`,
  },
  {
    q: `หากฝากถอนมีปัญหาหรือไม่ได้รับโบนัส ควรทำอย่างไร?`,
    a: `ควรตรวจสอบสถานะรายการและเงื่อนไขโปรโมชั่นก่อน จากนั้นติดต่อเจ้าหน้าที่ผ่านช่องทางทางการของ${BRAND_NAME} พร้อมหลักฐานที่เกี่ยวข้อง โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น`,
  },
];

// ไม่มี breadcrumb: นี่คือหน้าแรก เส้นทางจาก root มาหาตัวเองจะเหลือครั้งเดียวที่ชี้ตัวเอง
// ทุก URL ในกราฟมาจาก pageGraph ที่ derive จาก site: — ไม่มีโดเมนพิมพ์ไว้ในไฟล์นี้
// ไม่มี URL ที่ต่อด้วย `+` และไม่ส่งโน้ด Review / AggregateRating / sameAs /
// address / email เข้าไปเลย
// `description` เป็นสตริงเดียวกับที่ MainLayout ได้รับ และ `faqs` เป็นอาร์เรย์
// ตัวเดียวกับที่ <Faq> ได้รับ
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxPremium as="h1" title={`${BRAND_NAME}เกมสล็อตเปย์แรง สมัครรับโปรใหม่ เก็บโบนัสได้ทุกวัน`}>
    <p>
      {BRAND_NAME} นำเสนอเกมสล็อตออนไลน์พร้อมข้อมูลโปรโมชั่นสำหรับสมาชิกที่ต้องการติดตามสิทธิพิเศษในแต่ละวัน
      <strong class="text-[#ff2e52]">ภายในเว็บไซต์มีรายละเอียดเกี่ยวกับเกม การสมัครสมาชิก และช่องทางฝากถอนให้ตรวจสอบก่อนใช้งาน</strong>
      โดยมีโปรโมชั่นคืนยอดเสียและแนะนำเพื่อนตามเงื่อนไขที่กำหนด ผู้ใช้งานควรศึกษากติกาเกมและข้อกำหนดการรับโบนัสให้ครบถ้วน
      <strong class="text-[#ff2e52]">เพราะโปรโมชั่นไม่ได้รับประกันว่าจะได้รับผลกำไรจากการเดิมพัน</strong>
    </p>
  </ContentBoxPremium>

  <ContentBoxTwo
    as="h2"
    title={`${BRAND_NAME} ฝากถอนง่าย จ่ายเร็ว ยอดสูงเท่าไหร่ เราก็จ่ายไม่มีอั้น`}
    titleleft="สิ่งที่ควรตรวจก่อนทำธุรกรรม"
    titleright="เงื่อนไขจริงจากผู้ให้บริการ"
    iconleft="🏧"
    iconright="📋">
    <p slot="left">
      {BRAND_NAME} ระบุว่ามีระบบฝากถอนสำหรับสมาชิกที่ต้องการทำรายการผ่านช่องทางที่เว็บไซต์รองรับ
      <strong class="text-[#ff2e52]">โดยผู้ใช้งานควรตรวจสอบยอดฝากขั้นต่ำ วงเงินถอนสูงสุด ระยะเวลาดำเนินการ และข้อกำหนดการยืนยันตัวตนก่อนทำธุรกรรม</strong>
    </p>
    <p slot="right">
      แม้จะมีข้อความโฆษณาว่าจ่ายเร็วหรือถอนได้ไม่จำกัด
      <strong class="text-[#ff2e52]">แต่ควรตรวจสอบเงื่อนไขจริงจากผู้ให้บริการก่อน</strong>
      เพราะรายการที่มียอดสูงอาจต้องผ่านขั้นตอนตรวจสอบเพิ่มเติม
