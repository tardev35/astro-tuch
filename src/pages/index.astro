---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import LatestWinners from "../components/LatestWinnersCyber.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Faq4 from "../components/Faq4.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// SLIDE ROLES FOR YADOM168 — READ BEFORE REUSING THESE IMPORTS.
// Verified against the artwork on the 2026-09-04 drop, and note they are
// SWAPPED versus the previous brand: slide1.png is the แนะนำเพื่อน 0.8% poster
// and slide2.png is the คืนยอดเสีย 0.3% one. The docx runs its ฝาก/โบนัสรายวัน
// section (H2) before its แนะนำเพื่อน 0.8% sub-section (H3), so slide2 sits in
// the H2 block and slide1 in the H3 block. Re-check the actual posters on the
// next rebrand rather than trusting this order — a previous brand shipped the
// two swapped, which builds clean and reads wrong.
//
// slide2's own artwork prints a 0.3% cashback offer, but this brief has NO
// คืนยอดเสีย section — so the alt text describes what the poster shows while the
// section prose stays on the brief and never claims a cashback promotion.
//
// Stale assets that must stay unimported: slide3.png / slide4.png (2026-08-13)
// and banner2.png / banner3.png (2026-08-20 / 2026-08-11) belong to earlier
// clients' drops, and there is no banner2+ article illustration in this brand's
// drop. banner1.png and banner1-mobile.png are the hero pair and belong to
// MainLayout's own pinned globs — never referenced from a page.

// Title and description are the brief's own Title/Description lines, used
// verbatim. A brief-supplied description is never padded up to the 150-char
// floor and never topped up from the H1/H2.
const pageTitle = "YADOM168 สล็อตเกมแตกง่าย เบทต่ำ1บาท เดิมพันออโต้";

const pageDescription = "YADOM168 สล็อตเกมแตกง่าย ค่ายแท้ไม่ผ่านตัวแทน เบทต่ำ1บาท เดิมพันออโต้ เว็บตรง ปลอดภัย เชื่อถือได้";

// The ticker copy is passed explicitly rather than relying on the component's
// default — every Announcement* variant's default belongs to whichever brand
// wired it in last. No emoji in this string: an emoji baked into a text prop
// cannot be given its own aria-hidden span, and this marquee prints the string
// twice.
const announcement =
  "YADOM168 รวมเกมสล็อตจากหลายค่ายไว้ในบัญชีเดียว ทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน แจ็กพอต และเกมธีมใหม่ ๆ • รองรับการใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ โดยไม่ต้องสลับสมัครหลายเว็บไซต์ • มีเกมที่รองรับเบทต่ำ 1 บาทให้เลือก แต่ควรตรวจสอบขั้นต่ำภายในเกมก่อนกด Spin ทุกครั้ง เพราะแต่ละค่ายกำหนดช่วงเดิมพันไม่เท่ากัน • ระบบออโต้สำหรับจัดการเครดิต ฝากถอน และตรวจสอบรายการผ่านบัญชีสมาชิก • Login เพื่อตรวจสอบโบนัสที่มีสิทธิ์รับในแต่ละวัน โดยสิทธิ์จริงขึ้นอยู่กับกิจกรรมและเงื่อนไขของโปรโมชั่นในช่วงนั้น • โปรโมชั่นแนะนำเพื่อน โบนัส 0.8% คำนวณจากยอดที่เข้าเงื่อนไข ตามรอบคำนวณและข้อกำหนดที่เว็บไซต์กำหนด • ติดต่อแอดมิน YADOM168 ได้ตลอด 24 ชั่วโมง";

// One array, used by both <Faq4> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last.
const faqs = [
  {
    q: "YADOM168 มีเกมสล็อตเบทเริ่มต้น 1 บาทหรือไม่?",
    a: "สามารถมีเกมสล็อตที่รองรับการเดิมพันเริ่มต้นระดับ 1 บาทตามช่วงเดิมพันของแต่ละค่าย แต่ไม่ใช่ทุกเกมจะกำหนดขั้นต่ำเท่ากัน จึงควรตรวจสอบราคาต่อ Spin ที่แสดงภายในเกมก่อนเริ่มเล่น",
  },
  {
    q: "โปรโมชั่นแนะนำเพื่อน YADOM168 โบนัส 0.8% รับอย่างไร?",
    a: "สมาชิกใช้ลิงก์แนะนำส่วนตัวเพื่อชวนเพื่อนสมัคร เมื่อเพื่อนมียอดใช้งานตรงตามข้อกำหนด ระบบจะนำยอดที่เข้าเกณฑ์มาคำนวณโบนัส 0.8% โดยควรตรวจสอบรอบรับและเงื่อนไขโปรโมชั่นล่าสุดก่อนใช้สิทธิ์",
  },
  {
    q: "หากฝากถอนหรือเข้าเกม YADOM168 มีปัญหาต้องทำอย่างไร?",
    a: "ควรตรวจสอบสถานะรายการและข้อมูลในบัญชีก่อน หากปัญหายังไม่ถูกแก้ไข สามารถติดต่อแอดมิน YADOM168 พร้อมแจ้งเวลา จำนวนเงิน หรือรายละเอียดที่เกี่ยวข้อง เพื่อให้ทีมงานช่วยตรวจสอบได้ตลอด 24 ชั่วโมง",
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// Heading white (#f2fbef) marks a claim the brief states outright; the amber
// accent (#f0b93a) marks the caveat that goes with it — a warning painted in
// the brand's own green stops reading as a warning.

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb. Every URL in the graph is derived
// by pageGraph from `site:` — no domain is typed out in this file.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <ContentBoxFloatingBadge as="h1" title="YADOM168 สล็อตเกมแตกง่าย จ่ายไว ไม่จำกัดยอดแทง">
    <p class="text-left text-base leading-relaxed text-[#d4e8cb]">
      <strong class="text-[#f2fbef]">YADOM168</strong> ให้บริการเกมสล็อตออนไลน์ที่รวมเกมจากหลายค่ายไว้ในบัญชีเดียว
      <strong class="text-[#f2fbef]">รองรับการใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์</strong>
      มีเกมสล็อตที่สามารถเลือกเบทเริ่มต้นระดับต่ำตามเงื่อนไขของแต่ละเกม พร้อมระบบออโต้สำหรับจัดการเครดิต ฝากถอน และตรวจสอบรายการ สมาชิกสามารถเลือกเกม รับโปรโมชั่น และติดตามสถานะบัญชีได้ด้วยตัวเอง
      <strong class="text-[#f2fbef]">พร้อมแอดมินคอยช่วยเหลือด้านการใช้งานตลอด 24 ชั่วโมง</strong>
    </p>
  </ContentBoxFloatingBadge>

  <ContentBoxTwoCyberCut as="h2" title="YADOM168 รวมเกมค่ายดัง สล็อตเบทต่ำ1บาท เดิมพันออโต้">
    <p slot="left" class="text-left text-base leading-relaxed text-[#d4e8cb]">
      <strong class="text-[#f2fbef]">YADOM168</strong> รวบรวมเกมสล็อตจากหลายผู้ให้บริการ
      <strong class="text-[#f2fbef]">มีทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน แจ็กพอต และเกมธีมใหม่ ๆ</strong>
      ให้สมาชิกเลือกผ่านบัญชีเดียว รองรับการเล่นบนมือถือโดยไม่ต้องสลับสมัครหลายเว็บไซต์ พร้อมระบบออโต้ที่ช่วยให้ตรวจสอบเครดิตและจัดการรายการต่าง ๆ ได้สะดวกมากขึ้น
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#d4e8cb]">
      สำหรับผู้ที่ต้องการเล่นสล็อตเบทต่ำ 1 บาท สามารถเลือกเกมที่รองรับช่วงเดิมพันดังกล่าวได้
      <strong class="text-[#f0b93a]">แต่ควรตรวจสอบขั้นต่ำภายในเกมก่อนกด Spin ทุกครั้ง เพราะแต่ละค่ายอาจกำหนดช่วงเดิมพันไม่เท่ากัน</strong>
      <strong class="text-[#f0b93a]">และผลลัพธ์ของเกมสล็อตไม่สามารถรับประกันว่าเกมใดจะแตกง่ายหรือทำกำไรได้ทุกครั้ง</strong>
    </p>
  </ContentBoxTwoCyberCut>

  <ProviderGrid />

  <GameRankingBoard />

  <ContentBoxSevenThreeNeumorphism as="h2" title="YADOM168 รองรับการเดิมพัน ไม่จำกัดยอดฝาก รับโบนัสได้ทุกวัน">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นคืนยอดเสีย 0.3% ของ YADOM168 พื้นหลังโทนดำเขียว มีชิปคาสิโนและเหรียญทองกระจาย มุมซ้ายบนเป็นโลโก้ YADOM168 ตัวอักษรสีขาวเหนือเลข 168 สีเขียว ถัดมาเป็นป้ายเขียนว่า โปรโมชั่น ตามด้วยข้อความ คืนยอดเสีย สีขาว วางเหนือตัวเลข 0.3% ขนาดใหญ่สีขาวเงา ด้านขวาเป็นผู้หญิงผมบลอนด์สวมชุดสีเขียวดำชี้มาที่ตัวเลข ฉากหลังเป็นตู้สล็อตสีเขียว ด้านล่างเป็นป้ายสามอันพร้อมไอคอน เขียนว่า คืนยอดเสียทุกวัน กับ ระบบมั่นคง ปลอดภัย 100% และ ถอนเร็ว ไม่อั้น"
      class="mx-auto h-auto w-full rounded-2xl border border-[#5cc23f]/45 shadow-[0_10px_30px_rgba(92,194,63,0.25)]"
    />
    <div slot="right" class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d4e8cb]">
      <p>
        สมาชิก <strong class="text-[#f2fbef]">YADOM168</strong> สามารถเติมเครดิตผ่านช่องทางฝากเงินที่ระบบเปิดรองรับ
        <strong class="text-[#f2fbef]">พร้อมตรวจสอบสถานะรายการผ่านบัญชีของตนเองได้</strong>
        <strong class="text-[#f0b93a]">หากต้องการทำรายการจำนวนมากควรตรวจสอบวงเงินขั้นต่ำและสูงสุดของช่องทางที่เลือกก่อนยืนยัน เนื่องจากข้อกำหนดอาจแตกต่างกันตามธนาคารหรือช่องทางชำระเงิน</strong>
      </p>
      <p>
        ในส่วนของโปรโมชั่น สมาชิกสามารถ Login เพื่อตรวจสอบโบนัสที่มีสิทธิ์รับในแต่ละวันได้
        <strong class="text-[#f0b93a]">โดยสิทธิ์จริงขึ้นอยู่กับกิจกรรมและเงื่อนไขของโปรโมชั่นในช่วงนั้น</strong>
        ไม่ว่าจะเป็นยอดที่ใช้คำนวณ รอบรับโบนัส หรือประเภทเกมที่เข้าร่วมรายการ
      </p>
    </div>
  </ContentBoxSevenThreeNeumorphism>

  <ContentBoxSevenThreeCyberCut as="h3" title="โปรโมชั่นแนะนำเพื่อน โบนัส 0.8% โปรขายดีมาแรงในตอนนี้">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อน 0.8% ของ YADOM168 พื้นหลังโทนดำเขียว มีชิปคาสิโนและเหรียญทองกระจาย มุมซ้ายบนเป็นโลโก้ YADOM168 ตัวอักษรสีขาวเหนือเลข 168 สีเขียว ถัดมาเป็นป้ายเขียนว่า โปรโมชั่น ตามด้วยข้อความ แนะนำเพื่อน สีขาว วางเหนือตัวเลข 0.8% ขนาดใหญ่สีขาวเงา ด้านขวาเป็นผู้หญิงผมบลอนด์สวมชุดสีเขียวดำชี้มาที่ตัวเลข ฉากหลังเป็นตู้สล็อตสีเขียว ด้านล่างเป็นป้ายสามอันพร้อมไอคอน เขียนว่า ชวนเพื่อน รับโบนัสไม่อั้น กับ เพื่อนเล่นยิ่งมาก ยิ่งได้เยอะ และ รับโบนัสสูงสุด ไม่จำกัด"
      class="mx-auto h-auto w-full rounded-2xl border border-[#e6bd5c]/40 shadow-[0_10px_30px_rgba(230,189,92,0.20)]"
    />
    <div slot="right" class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d4e8cb]">
      <p>
        สมาชิกสามารถใช้ลิงก์แนะนำส่วนตัวเพื่อชวนเพื่อนสมัคร <strong class="text-[#f2fbef]">YADOM168</strong> เมื่อบัญชีที่แนะนำมียอดใช้งานตรงตามข้อกำหนด
        <strong class="text-[#f2fbef]">ระบบจะคำนวณโบนัสแนะนำเพื่อน 0.8% จากยอดที่เข้าเงื่อนไข</strong>
        พร้อมให้ตรวจสอบจำนวนเพื่อน ยอดคำนวณ และโบนัสที่มีสิทธิ์รับผ่านบัญชีสมาชิก
      </p>
      <p>
        <strong class="text-[#f0b93a]">ก่อนใช้โปรโมชั่นควรตรวจสอบรอบคำนวณ วิธีรับโบนัส และข้อกำหนดล่าสุดให้ครบถ้วน</strong>
        เนื่องจากรายละเอียดของกิจกรรมอาจมีการเปลี่ยนแปลงตามช่วงเวลาที่เว็บไซต์กำหนด
      </p>
    </div>
  </ContentBoxSevenThreeCyberCut>

  <ContentBoxPremium as="h2" title="สมัคร YADOM168 เล่นสล็อตแตกง่าย ไม่มีขั้นต่ำ">
    <div class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d4e8cb]">
      <p>
        <strong class="text-[#f2fbef]">ผู้ใช้งานใหม่สามารถสมัคร YADOM168 ผ่านระบบออนไลน์ได้ด้วยตัวเอง</strong>
        เริ่มจากกรอกข้อมูลที่จำเป็นสำหรับเปิดบัญชี จากนั้น Login เลือกช่องทางเติมเครดิตและตรวจสอบโปรโมชั่น ก่อนเข้าสู่หน้าเกมสล็อตเพื่อเลือกค่ายหรือเกมที่สนใจได้ทันที
      </p>
      <p>
        หลังเปิดบัญชีแล้วสามารถตรวจสอบเครดิต ประวัติฝากถอน โปรโมชั่น และรายการใช้งานผ่านมือถือได้ สำหรับคำว่า “ไม่มีขั้นต่ำ”
        <strong class="text-[#f0b93a]">ควรตรวจสอบเงื่อนไขของเกมและช่องทางฝากถอนจริงก่อนทำรายการ เนื่องจากแต่ละระบบอาจกำหนดขั้นต่ำแตกต่างกัน</strong>
      </p>
    </div>
  </ContentBoxPremium>

  <LoginRtpSection />

  <ContentBoxCyberCut as="h2" title="ติดต่อแอดมิน YADOM168 ปรึกษาปัญหาพร้อมแก้ไขได้ 24 ชั่วโมง">
    <div class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d4e8cb]">
      <p>
        หากพบปัญหาเกี่ยวกับการสมัคร Login เข้าเกมไม่ได้ เครดิตไม่อัปเดต ฝากถอนค้าง หรือโปรโมชั่นไม่แสดง
        <strong class="text-[#f2fbef]">สามารถติดต่อแอดมิน YADOM168 ได้ตลอด 24 ชั่วโมง</strong>
        โดยควรแจ้งรายละเอียดของปัญหา เวลา จำนวนเงิน และข้อมูลรายการที่เกี่ยวข้อง เพื่อช่วยให้เจ้าหน้าที่ตรวจสอบได้ตรงจุด
      </p>
      <p>
