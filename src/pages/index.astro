---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import LatestWinners from "../components/LatestWinners4.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBox from "../components/ContentBox.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import Faq from "../components/Faq2.astro";
import ReviewCardSumo from "../components/ReviewCardSumo.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import { pageGraph } from "../lib/schema";
import promoCashback from "../assets/slide2.png";
import promoReferral from "../assets/slide1.png";

// VARIANT ROTATION THIS ROUND, decided in .claude/brand-spec-ruaythep168.md §3 and NOT
// re-picked here: AnnouncementPremium replaces Announcement5, LatestWinners4 replaces
// LatestWinners2, Faq2 replaces Faq4, the base ReviewCardSumo replaces ReviewCardSumo2,
// and the ContentBox shape-mix drops Premium / CyberCut / TwoCyberCut /
// SevenThreeNeumorphism / SevenThreeCyberCut / Special / the base ContentBoxTwo for
// FloatingBadge / Neumorphism / TwoPremium / SevenThreePremium / the base
// ContentBoxSevenThree / TwoNeumorphism / the base ContentBox — **zero overlap with the
// outgoing brand's mix**. NavbarPremium + the base Footer are the layout's pair this
// round and the brand font moves kanit -> google-sans; all of that is the orchestrator's
// shared-chrome step, not this page's.
// ⚠️ Plain ContentBox IS in this round's index mix (§7) and it is ALSO always-live,
// because terms, privacy, 404, /promotion and the button pages all render through it —
// it sits in the shared-chrome set regardless, so this page **uses it and never edits
// it**. An "is it used?" check has to match the bare filename rather than the
// components/ path, which is how a component reached only from another file got misread
// as inventory once before.
// Every unused *Style / *Premium / *Cyber / *Huay / *CyberCut / *FloatingBadge sibling,
// the other Faq* and Announcement* files, the other LatestWinners* and ReviewCardSumo2
// all stay on disk as inventory for the next brand — nothing was deleted, and the
// earlier brands' hues still inside them are expected drift.
//
// Three widgets this template usually offers are deliberately absent, and they are named
// without their file extension on purpose because the playbook's "is this component live?"
// check is a bare-filename grep: ProviderGrid is banned by brand-spec §6 because this brief
// names NO game studio at all, GameRankingBoard has no ranking to carry, and SmoothCarousel
// has no brief section asking for a carousel. LoginRtpSection is out for the same reason —
// its RTP table would put an RTP figure on the page, and §6 allows only the brief's own
// numbers (0.3%, 0.8%, 24ชม., 3 ขั้นตอน).
//
// <Announcement /> runs bare on purpose: AnnouncementPremium's default message is already
// this brand's copy, written from this brief, and every sub-page calls it bare too — so
// passing an override here is exactly how the ticker ends up saying two different things
// on two pages of the same site.
//
// PALETTE — IMPERIAL GOLD LEADS, SCARLET IS THE SECOND HUE, COPPER IS THE THIRD, BURNT
// BRONZE NEVER CARRIES TEXT, ON PURE BLACK (brand-spec §2). Read off the artwork: the logo
// is the word รวย in thick 3-D GOLD Thai lettering, then เทพ in PEARL-WHITE edged in grey,
// then 168 in glossy SCARLET, beside a laughing CHINESE GOD-OF-WEALTH mascot in a
// gold-and-red winged cap, sitting on a gold swoosh ringed by gold sparkles. The banner
// and both slides are a BLACK scene with a gold crown, falling gold coins, red-and-white
// poker chips, playing cards, a slot cabinet showing 777, red hearts, red gift boxes and a
// silver-blonde woman in a red-and-white outfit reaching toward the viewer.
// ⚠️ The trap this round is that GOLD has led almost every brand through this repo and RED
// has led four, so finding "a gold" or "a red" in a file proves NOTHING — compare by VALUE.
// This round's gold is #f0bb4e (R240 G187 B78) and ⚠️ รับตัง168's f0b429 has the EXACT
// SAME RED CHANNEL (B78 vs B41 is the only tell); the outgoing มีเฮ168 gold was fcd45c
// (G212 vs G187). This round's scarlet is #e4021b (R228 G2 B27), not มีเฮ168's fb1b32 and
// not สมหวัง168's fa0513, which sits a hair away.
// ⚠️ The page background is PURE BLACK #000000 (bg.json) — which happens to match the
// artwork's own scene, but bg.json is the only source of that value. The depth ramp is
// #3b1b0e raised / #260d04 mid / #0d0501 sunk, not 2b0711 / 1a040a / 0c0205 of the
// previous round. #5c2a06 is the burnt-bronze shadow tier and never carries text.
// Body copy is #fff8ec (= BRAND_TEXT), 19.9:1 on the page and 14.7:1 on the raised surface.
// The ONE highlight colour a <strong> may take is #f0bb4e (11.9:1 on the page, 8.8:1 on the
// raised surface). ⚠️ #e4021b measures 3.20 / 3.79 / 4.16 / 4.32 on the four surfaces — it
// FAILS AA everywhere and is a FILL / BORDER / ICON colour only, never text on a dark
// surface. Text on a scarlet fill is #fff8ec (4.60:1). #2b1400 is the only ink allowed on a
// solid gold or cream fill (9.91:1 on gold). Glow rgba is rgba(240,187,78,α),
// rgba(228,2,27,α), rgba(255,236,203,α) or rgba(217,112,26,α).
// ⚠️ No blue/azure/cyan, purple, green, silver/chrome, rose-gold, lime-yellow or
// fuchsia/pink this round. The one orange allowed is copper #d9701a, which is the shadow
// tone of the gold gradients, not a free-standing orange. Values that must not survive
// anywhere that renders: fb1b32 ff8f9c 5c0410 fcd45c 6b4a08 2b0711 1a040a 0c0205 fdeaec
// 1b0308 (มีเฮ168, last round) · 039cfa 0494f5 c3ebfc 04366b f9a826 704504 e3f2fc 0b2d52
// 071e38 030f1d 031320 (รวยแทร่168) · 32bcfb a9e9ff fef54b 07335f 6b5c10 dceefc (นินจา168)
// · 2f9ff5 a8dcff ffc82e 0b3f78 e8f4ff (สบายเบท168) · fa63b9 ffb3de ffd84d (ถอนชัวร์168) ·
// fcd434 f5469f ff8dc6 f6e4ee (มีโชค168) · f7c92b f2bba5 c98a74 b3121b eadfce (ขวัญใจ168) ·
// f0b429 d30304 ff6b6e cfd9e6 f5ece0 (รับตัง168) · fa0513 ff5a5f ffadaf e3b23c f4ecea
// (สมหวัง168) · 2563eb
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
//
// IMAGE ROLES FOR THIS DROP (2026-10-20, brand-spec §5). Exactly TWO files are referenced
// from this page, both from this drop, and THE TEXT PRINTED ON THE ART is what decides the
// pairing — both bitmaps were opened and read with the Read tool this round:
//   slide2.png -> §4, because its own plaque reads คืนยอดเสีย with 0.3% beside it
//   slide1.png -> §5, because its own plaque reads แนะนำเพื่อน with 0.8% beside it
// ⚠️ The uploader overwrites both files every drop, so the numbering carries no meaning
// across brands and the plaque has to be re-read each time — trusting an inherited pairing
// would have captioned each promotion with the other one's poster.
// Both alts below were written from THIS drop's bitmaps; neither is copied from a spec
// table and neither is a counter. The previous round's alts described a WHITE-AND-BLUSH-
// PINK scene with a woman in white lace and a butter-gold smiley — there is no white
// scene, no lace, no smiley and no pink anywhere in this drop.
// Deliberately NOT imported, and every file still on disk as inventory: banner2.png
// (10-08) and banner3.png (09-27) are previous brands' article art, and slide3.png /
// slide4.png (09-29) are **LOTTOPLUS lottery posters from a completely different brand**.
// An eager import IS an emit, rendered or not, so importing any of them would ship a
// competitor's picture into dist/ and turn verify-build red. There is therefore NO
// current-drop article illustration this round, and a slide is never substituted for one —
// the playbook pins slide* to ContentBoxSevenThree* blocks only, and these two are the
// round's full 2-block budget.
// banner1 and its mobile crop belong to MainLayout's own pinned globs and are never
// referenced from a page; og.png is the same, MainLayout owns it.
// ⚠️ Both slides are 600x200 WIDE STRIPS on disk this round, so 600 is the top real
// candidate (anything above it would not be a real pixel) and each picture carries
// max-w-[600px] so the art is never upscaled past its own bitmap. The two `sizes` lists are
// NOT interchangeable — each is the 3fr-column arithmetic from inside the variant that
// actually holds that picture, and the two variants cap, pad and rule differently:
//   §4 ContentBoxSevenThreePremium — max-w-7xl/1280 section, px-4, border 1x2, md:p-10,
//      gap-10, image column md:border-l + md:pl-10 = 41:
//        >= 1280px : (1280 - 32 - 2 - 80 - 40) x 0.3 - 41 = 297px
//        md..1279  : calc(30vw - 87px)
//        698..767  : 600px (bitmap cap)
//        < 698     : calc(100vw - 98px)
//   §5 ContentBoxSevenThree (base) — max-w-[1400px] section, px-4, border 1x2, md:p-10,
//      gap-8, image column md:pl-6 = 24 (its md:border-r + md:pr-6 are on the TEXT column,
//      so they come out of THAT track):
//        >= 1400px : (1400 - 32 - 2 - 80 - 32) x 0.3 - 24 = 352px
//        md..1399  : calc(30vw - 68px)
//        698..767  : 600px (bitmap cap)
//        < 698     : calc(100vw - 98px)
// ⚠️ These numbers were recomputed from THIS round's variants, not copied from last
// round's pair (SevenThreeNeumorphism 297 / SevenThreeCyberCut 312) — the second block
// changed file and its section cap, padding, gap and column rule all moved with it.
// Neither picture is the LCP element — MainLayout's hero banner is — so both are
// loading="lazy" fetchpriority="low" decoding="async" and neither ever takes
// fetchpriority="high". formats/fallbackFormat stay at the house values, and quality is
// still ONE number for both formats — tools/avif-quality-service.mjs rescales the AVIF side
// on its own (x0.65), so it must never be hand-tuned per format.
//
// quality={64}, not the usual 80, because both of this drop's slides are busy artwork with
// heavy fine grain (falling coins, bokeh, gold sparkles, gradient 3-D lettering, satin and
// skin), which is the case AVIF handles worst. At 80 that is exactly the shape that comes
// out LARGER than its own WebP fallback at every emitted width, and verify-build.mjs fails
// the build on precisely that. 64 is the value already proven to win on this art style; the
// fix is always a LOWER quality, never a higher one. Same number on /promotion for the same
// two slides.
//
// VOCABULARY — brand-spec §6, the brief's own words only. This brand is **เกมสล็อตเป็นแกน**
// and the brief itself names FOUR game categories — สล็อต · ยิงปลา · ไฮโล · หวยออนไลน์ /
// แทงหวย — so those words ARE allowed this round (the previous round banned them; what
// changed is that this brief uses them). It is still **not a เว็บหวย**: หวยออนไลน์ is one of
// four categories it lists, not the site's subject, which is why /ตรวจหวย and /แนวทาง stay
// parked. Everything the copy says traces to src/assets/content.txt: สล็อต, ยิงปลา, ไฮโล,
// หวยออนไลน์, แทงหวย, กติกา, อัตราจ่าย, อัตราเดิมพัน, เงื่อนไขการเดิมพัน, ข้อมูลผู้ให้บริการ,
// โปรโมชั่น, คืนยอดเสีย 0.3%, แนะนำเพื่อน 0.8%, โบนัส, เครดิต, ยอดเสีย, รอบเวลารับเครดิต,
// ลิงก์แนะนำ, เชื่อมโยงบัญชี, สมัครสมาชิก, เข้าสู่ระบบ, ลงทะเบียน, ฝากถอน, ข้อมูลส่วนบุคคล,
// รหัสผ่าน, รหัส OTP, เจ้าหน้าที่, แอดมิน, 24ชม., ช่องทางทางการ.
// ⚠️ มีเฮ168's phrases เกมสล็อตเจนซี, ระบบเข้าทางคนรุ่นใหม่, ใส่ใจทุกค่ายเกม, เดิมพันง่าย
// ไม่มีขั้นต่ำ and วอลเลทและธนาคารชั้นนำ — which is what this very file said last round — are
// GONE, as are รวยแทร่168's สล็อตรวมเกมกำไรงาม, เล่นง่ายทุกค่าย, ได้เงินสูงทุกรอบ,
// ทุนน้อยก็เล่นได้ · นินจา168's สล็อตโปรแรงโบนัส0.8%ทุกวัน, แค่แนะนำง่ายๆ รับได้ไม่อั้น ·
// ถอนชัวร์168's ถอนง่าย, ไม่มีรีวิวเสีย, หลักแสนยูสต่อวัน, การันตีเว็บแท้ · สบายเบท168's
// เว็บสล็อตทางการ, ผู้ให้บริการฐานเกมหลัก, เว็บแท้อันดับ1, เว็บแท้100% · and มีโชค168's
// เว็บสล็อตลิขสิทธิ์แท้, นำเข้าตรงจากสิงคโปร์, PG SOFT, JOKER, JILI.
// **This brief names NO game studio whatsoever**, so no studio name appears anywhere on this
// page — and the brief does not even use the word ค่ายเกม, so neither does this page; it
// says ข้อมูลผู้ให้บริการ, which is the brief's own wording. There is no คาสิโน, บาคาร่า,
// รูเล็ต, บอล/แทงบอล/กีฬา, อัตราต่อรอง, แนวทาง/ตรวจหวย, เว็บตรง or ไม่ผ่านเอเย่นต์ anywhere
// here. Nothing claims a licence number, a regulator, a legal-entity name, a named bank, an
// RTP figure, a deposit minimum, a member count or a founding year. The only figures on the
// page are the brief's own: 0.3%, 0.8%, 24ชม. and 3 ขั้นตอน.
// ⚠️ This brief ADVERTISES AND HEDGES IN THE SAME BREATH: its own headings say รวยขั้นเทพ
// and รับได้ไม่จำกัด while its own paragraphs answer that
// เกมเหล่านี้มีความเสี่ยงต่อการสูญเสียเงิน, ไม่มีรูปแบบใดรับประกันผลกำไรจากการเดิมพัน and
// เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือรับประกันผลตอบแทนในอนาคต.
// Both halves ship exactly as written: the advertising words appear ONLY inside the headings
// the brief itself wrote them into and are never expanded into new claims of this page's
// own, and EVERY hedging clause ships in full — they are brief content, not downbeat filler
// to be trimmed.
//
// The brief, the artwork and the operator's prompt all agree on the brand name. Even so the
// name is never typed on the page: it is interpolated from ${BRAND_NAME} so it can never
// drift from brandProfile, including inside the two alts. ⚠️ มีเฮ168 is the OUTGOING brand
// and มีโชค168 is a THIRD, unrelated brand that also came through this repo — all three are
// different clients. No domain is written out anywhere here and no URL is built with `+`.
//
// Title and description are the brief's own Title / Description lines (content.txt lines
// 1-2) verbatim, with the brand name interpolated. The description is NOT padded up to 150
// characters — verify-build deliberately skips its 150-character floor on the home page for
// exactly this reason.
const pageTitle = `${BRAND_NAME} เกมสล็อตรวยขั้นเทพ สมัคร ฝากถอน รับโปร ครบในเว็บเดียว`;

const pageDescription = `${BRAND_NAME} เกมสล็อตรวยขั้นเทพ สมัครเล่นสล็อต ยิงปลา ไฮโล แทงหวย พร้อมระบบฝากถอน รับโปร ครบในเว็บเดียว`;

// The brief has a real H2 -> H3 nesting this round, so the page is NOT flattened to H2-only.
// Five H3s, and all five are the brief's own lines: two promotion sub-points under §3's
// โปรโมชั่น…รับได้ไม่จำกัด H2 (content.txt lines 9 and 11), plus the three ขั้นตอนที่ 1-3
// labels under §6's สมัครเล่นสล็อต… H2 (lines 15, 17, 19). The three steps go through
// FeatureHighlights, which is the one place the playbook allows a docx sub-list to become
// h3s rather than hand-rolled icon cards. No component rendered here emits a hardcoded
// heading, so the printed h3 count stays at exactly 5.
//
// The checklist, in document order, and what carries each one:
//    1 H1  ${BRAND_NAME} เกมสล็อตรวยขั้นเทพ สมัคร ฝากถอน รับโปร ในที่เดียว
//          ContentBoxFloatingBadge, brief paragraph on line 4
//    2 H2  ${BRAND_NAME} เล่นสล็อต ยิงปลา ไฮโล แทงหวย ครบวงจร
//          ContentBoxNeumorphism, line 6
//    3 H2  โปรโมชั่น ${BRAND_NAME} รับได้ไม่จำกัด
//          ContentBoxTwoPremium, line 8 run one paragraph half per column
//    4 H3  โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสทุกวัน
//          ContentBoxSevenThreePremium + slide2, line 10 left / picture right
//    5 H3  โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด
//          ContentBoxSevenThree (base) + slide1, line 12 left / picture right
//    6 H2  สมัครเล่นสล็อต ${BRAND_NAME} ง่ายๆ 3 ขั้นตอน
//          ContentBoxTwoNeumorphism, line 14 split across its two columns
//      H3  ขั้นตอนที่ 1-3, FeatureHighlights, lines 15-20 as label + description pairs
//    7 H2  ช่องทางติดต่อแอดมิน ${BRAND_NAME} ตลอด 24ชม.
//          ContentBox (base), line 22 as one paragraph in its single slot
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ ${BRAND_NAME}
//          Faq2 + faqs prop, lines 23-29
// Final inventory for this page: h1 x1, h2 x5, h3 x5 — brand-spec §4's target.
//
// Both ContentBoxSevenThree* variants lay out md:grid-cols-[7fr_3fr] with the TEXT column
// FIRST and fall `title` back to that left column, so each picture goes in slot="right": the
// heading always lands on the prose, never on the picture, and on a phone the single column
// reads heading, text, picture rather than opening with an image. Neither is passed a
// `titleright`, so neither image column carries a heading and each block emits exactly one.
// ContentBoxTwoPremium and ContentBoxTwoNeumorphism are passed no column labels either —
// the brief gives §3 and §6 one running paragraph each with no sub-labels, and inventing a
// pair here would be this page's own wording rather than the docx's. Each paragraph runs
// one half per slot, which keeps every clause and still gives the component both slots.
// ContentBoxTwoNeumorphism is passed no default slot either, so its optional `intro` block
// stays unused.
//
// Every brief paragraph ships in full — nothing merged, nothing summarised. §3 and §6 run
// one paragraph half per slot, and NO slot receives more than one element, so the house
// rule's "one element per slot" holds everywhere without a wrapper <div> being needed.
//
// Everything else on the page is chrome and emits no heading tag at any level:
// AnnouncementPremium, LatestWinners4 and ReviewCardSumo render their titles as <p>/<span>
// with an aria-label on the section, and Faq2's questions live inside <summary>. The
// non-brief widgets sit before section 1 (the ticker, then the member feed) and after
// section 8 (the review cards, then Navfoot) — never spliced between two content sections.

// One array, used by both <Faq> and the FAQPage node — never the component's own defaults
// (Faq2 deliberately ships an empty list, so a forgotten prop renders an empty accordion
// rather than some previous brand's questions). The three pairs are the brief's own Q/A
// block (content.txt lines 24-29), verbatim; only the "1." / "2." / "3." list markers are
// dropped, since the accordion is the list.
const faqs = [
  {
    q: `${BRAND_NAME} มีเกมประเภทไหนให้เลือกบ้าง?`,
    a: `ตามข้อมูลที่ระบุ ${BRAND_NAME} นำเสนอเกมสล็อต ยิงปลา ไฮโล และหวยออนไลน์ โดยผู้ใช้งานควรตรวจสอบรายชื่อเกมและประเภทการเดิมพันที่เปิดให้บริการจริงจากหน้าเว็บไซต์`,
  },
  {
    q: `โปรโมชั่นคืนยอดเสีย 0.3% ของ${BRAND_NAME} ใช้ได้กับทุกเกมหรือไม่?`,
    a: `ควรตรวจสอบเงื่อนไขโปรโมชั่นล่าสุดก่อนเข้าร่วม เพราะเกมแต่ละประเภทอาจมีหลักเกณฑ์การคำนวณยอดเสียและข้อกำหนดการรับเครดิตแตกต่างกัน`,
  },
  {
    q: `หากฝากถอนมีปัญหา สามารถติดต่อเจ้าหน้าที่ได้อย่างไร?`,
    a: `สามารถตรวจสอบช่องทางติดต่อเจ้าหน้าที่จากหน้าเว็บไซต์ทางการของ${BRAND_NAME} เพื่อแจ้งปัญหาพร้อมข้อมูลรายการที่จำเป็นสำหรับตรวจสอบ โดยไม่ส่งรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น`,
  },
];

// §6's three sub-points, lines 15-20 of the brief: each ขั้นตอนที่ N line is the item's own
// label and the line under it is its description, both verbatim. The icons are a sibling of
// the label inside FeatureHighlights' own aria-hidden="true" plate, never inside the text,
// and they read as the step they mark (check the address, fill the form, open the game list)
// rather than as three slot machines — the brand's genre is already established by
// everything around them.
// The accents alternate gold/red/gold, so the three cards carry the brand's two hues in the
// order the logo itself reads (gold "รวย" first, scarlet "168" second). ⚠️ The union is
// `"gold" | "red"` as of this round — FeatureHighlights used to accept `"blue"`, and blue is
// banned outright by brand-spec §2, so the spelling was removed from the component rather
// than left accepted-but-recoloured.
const registerSteps = [
  {
    icon: "🔎",
    title: "ขั้นตอนที่ 1 เข้าสู่หน้าสมัครสมาชิก",
    description: `ตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง จากนั้นเลือกเมนูสมัครสมาชิกและอ่านรายละเอียดเกี่ยวกับข้อกำหนดการเปิดบัญชี รวมถึงเงื่อนไขการใช้บริการต่าง ๆ`,
    accent: "gold" as const,
  },
  {
    icon: "✍️",
    title: "ขั้นตอนที่ 2 กรอกข้อมูลและยืนยันการลงทะเบียน",
    description: `กรอกข้อมูลตามที่ระบบกำหนด ตรวจสอบความถูกต้องก่อนยืนยัน และตั้งรหัสผ่านที่ปลอดภัย โดยไม่ใช้ข้อมูลของบุคคลอื่นหรือเปิดเผยรหัส OTP ให้ใครทราบ`,
    accent: "red" as const,
  },
  {
    icon: "🎰",
    title: "ขั้นตอนที่ 3 เข้าสู่ระบบและศึกษารายละเอียดเกม",
    description: `หลังลงทะเบียนเรียบร้อย สามารถตรวจสอบเมนูเกมสล็อต ยิงปลา ไฮโล และหวยออนไลน์ รวมถึงกติกา อัตราเดิมพัน และรายละเอียดโปรโมชั่นก่อนใช้งาน หากมีข้อสงสัยควรสอบถามเจ้าหน้าที่ผ่านช่องทางทางการ`,
    accent: "gold" as const,
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own sentence. Thai
// has no inter-word space, so a highlight that starts or ends mid-word lets the formatter
// break the line inside the tag and render a space that splits the word — the copy must read
// identically with the tags removed. No two <strong> elements are adjacent either: every pair
// is separated by at least one run of plain text, so the whitespace between them can never
// collapse into a missing space.
// One highlight colour only: #f0bb4e (brand-spec §2 reserves it for exactly this job),
// against the inherited body colour #fff8ec (BRAND_TEXT). ⚠️ The second hue #e4021b is NOT
// available for this — it fails AA on every surface (3.2-4.3:1) and §2 confines it to fills,
// borders and icons. The paragraphs below carry no colour class of their own: every
// ContentBox* card in this mix already sets `text-left text-base leading-relaxed
// text-[#fff8ec]` on the element holding the slot, so the prose inherits it and no
// page-level override can drift from the card. No paragraph carries mx-auto or max-w-*
// either — the cards cap their own width, and the only max-w-* on the page are the two
// capping the slides, which are images and not prose. No slot's copy names a colour.

// No breadcrumb: this is the homepage, so a trail from the root to itself would be a single
// self-referential crumb. Every URL in the graph is derived by pageGraph from `site:` — no
// domain is typed out in this file, no URL is built with `+`, and no Review / AggregateRating
// / sameAs / address / email node is passed. `description` is the exact same string MainLayout
// gets, and `faqs` is the exact same array <Faq> gets.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <LatestWinners />

  <ContentBoxFloatingBadge as="h1" title={`${BRAND_NAME} เกมสล็อตรวยขั้นเทพ สมัคร ฝากถอน รับโปร ในที่เดียว`}>
    <p>
      {BRAND_NAME} นำเสนอช่องทางบริการเกมออนไลน์หลากหลายประเภท
      <strong class="text-[#f0bb4e]">ทั้งเกมสล็อต ยิงปลา ไฮโล และหวยออนไลน์</strong>
      พร้อมรวบรวมเมนูสมัครสมาชิก เข้าสู่ระบบ ฝากถอน และตรวจสอบโปรโมชั่นไว้ในเว็บไซต์เดียว ผู้ใช้งานสามารถศึกษารายละเอียดของแต่ละเกมและเลือกดูบริการที่สนใจได้สะดวก
      <strong class="text-[#f0bb4e]">โดยควรตรวจสอบกติกา เงื่อนไขการเดิมพัน และข้อมูลผู้ให้บริการก่อนเริ่มใช้งานทุกครั้ง</strong>
    </p>
  </ContentBoxFloatingBadge>

  <ContentBoxNeumorphism as="h2" title={`${BRAND_NAME} เล่นสล็อต ยิงปลา ไฮโล แทงหวย ครบวงจร`}>
    <p>
      {BRAND_NAME} รวบรวมข้อมูลเกมเดิมพันหลายรูปแบบไว้ในช่องทางเดียว
      <strong class="text-[#f0bb4e]">ไม่ว่าจะเป็นเกมสล็อตที่มีธีมและฟีเจอร์แตกต่างกัน เกมยิงปลาที่เน้นการเลือกเป้าหมาย ไฮโลที่ใช้ผลการทอยลูกเต๋า และหวยออนไลน์ที่มีรูปแบบการเลือกหมายเลข</strong>
      ผู้ใช้งานสามารถศึกษากติกา อัตราจ่าย และข้อกำหนดของแต่ละประเภทก่อนเลือกใช้งานได้
      <strong class="text-[#f0bb4e]">โดยควรเข้าใจว่าเกมเหล่านี้มีความเสี่ยงต่อการสูญเสียเงิน และไม่มีรูปแบบใดรับประกันผลกำไรจากการเดิมพัน</strong>
    </p>
  </ContentBoxNeumorphism>

  <ContentBoxTwoPremium as="h2" title={`โปรโมชั่น ${BRAND_NAME} รับได้ไม่จำกัด`}>
    <p slot="left">
      {BRAND_NAME} นำเสนอข้อมูลโปรโมชั่นสำหรับสมาชิกที่สนใจสิทธิพิเศษจากการใช้งานเกมออนไลน์
      <strong class="text-[#f0bb4e]">โดยมีรายการคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8% เป็นโปรโมชั่นหลักที่ระบุไว้</strong>
    </p>
    <p slot="right">
      แต่ละรายการอาจมีเงื่อนไขเกี่ยวกับประเภทเกม ยอดที่ใช้คำนวณโบนัส รอบเวลารับเครดิต และข้อจำกัดในการใช้งานแตกต่างกัน
      <strong class="text-[#f0bb4e]">ผู้ใช้งานจึงควรอ่านรายละเอียดจากประกาศล่าสุดและตรวจสอบว่าโปรโมชั่นใดสามารถรับร่วมกันได้ก่อนเข้าร่วม</strong>
    </p>
  </ContentBoxTwoPremium>

  <ContentBoxSevenThreePremium as="h3" title="โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสทุกวัน">
    <p slot="left">
      โปรโมชั่นคืนยอดเสีย 0.3% เป็นรายการที่ระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขในแต่ละวัน
      <strong class="text-[#f0bb4e]">สมาชิกควรตรวจสอบว่าเกมสล็อต ยิงปลา ไฮโล หรือหวยออนไลน์ประเภทใดเข้าร่วมรายการบ้าง รวมถึงศึกษารอบเวลาคำนวณยอดและวิธีรับเครดิตให้ชัดเจน</strong>
      ก่อนเข้าร่วมควรอ่านข้อกำหนดเกี่ยวกับการใช้โบนัสและการถอนเงินให้ครบถ้วน หากไม่แน่ใจสามารถสอบถามเจ้าหน้าที่เพิ่มเติมได้ ทั้งนี้
      <strong class="text-[#f0bb4e]">เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือรับประกันผลตอบแทนในอนาคต</strong>
    </p>
    <Picture
      slot="right"
      src={promoCashback}
      loading="lazy"
      fetchpriority="low"
      widths={[297, 480, 600]}
      sizes="(max-width: 697px) calc(100vw - 98px), (max-width: 767px) 600px, (max-width: 1279px) calc(30vw - 87px), 297px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={64}
      alt={`โปสเตอร์โปรโมชั่นแนวนอนของ ${BRAND_NAME} บนฉากพื้นดำ มุมซ้ายบนเป็นโลโก้ ${BRAND_NAME} ที่คำว่า รวย เป็นตัวอักษรไทยหนาสามมิติสีทอง ต่อด้วย เทพ สีขาวมุกตัดขอบเทา และเลข 168 สีแดงชาดผิวมันวาว ถัดมาเป็นเทพเจ้าแห่งโชคลาภจีนหัวเราะ สวมหมวกปีกสีทองแต่งแดง กลางภาพเป็นคำว่า โปรโมชั่น ตัวอักษรไทยสามมิติขนาดใหญ่สีทองตัดขอบแดง มีมงกุฎทองวางอยู่ด้านบน ใต้ลงมาเป็นป้ายโค้งสีแดงบรรจุคำว่า คืนยอดเสีย สีขาว ต่อท้ายด้วยเลข 0.3% ตัวโตสีทองตัดขอบขาว ครึ่งขวาเป็นหญิงสาวผมยาวสีบลอนด์เงินปักปิ่นทอง สวมชุดสีขาว-แดงประดับทองและโช้กเกอร์แดง ขยิบตาหนึ่งข้างพร้อมยื่นมือมาทางผู้ชม ริมขวาเป็นตู้สล็อตที่หน้าปัดขึ้นเลขเจ็ด รอบภาพมีเหรียญทองร่วง ริ้วทองโค้ง หัวใจสีแดง ชิปกลมสีแดง-ขาว กล่องของขวัญสีแดง และประกายดาวสีทองกระจายอยู่`}
      class="mx-auto h-auto w-full max-w-[600px] rounded-2xl border border-[#f0bb4e]/60 shadow-[0_0_28px_rgba(228,2,27,0.35)]"
    />
  </ContentBoxSevenThreePremium>

  <ContentBoxSevenThree as="h3" title="โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด">
    <p slot="left">
      โปรโมชั่นแนะนำเพื่อนโบนัส 0.8% เป็นรายการสำหรับสมาชิกที่ต้องการตรวจสอบสิทธิประโยชน์จากการแนะนำผู้ใช้งานรายใหม่
      <strong class="text-[#f0bb4e]">โดยควรศึกษาวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และหลักเกณฑ์การคำนวณโบนัสให้ครบถ้วน</strong>
      แม้โปรโมชั่นจะระบุว่าไม่จำกัด แต่สมาชิกควรตรวจสอบข้อกำหนดเกี่ยวกับจำนวนผู้เข้าร่วม ยอดที่นำมาคำนวณ รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัส
      <strong class="text-[#f0bb4e]">เพื่อให้เข้าใจสิทธิ์ที่ได้รับตามรายละเอียดจริงของเว็บไซต์</strong>
    </p>
    <Picture
      slot="right"
      src={promoReferral}
      loading="lazy"
      fetchpriority="low"
      widths={[352, 480, 600]}
      sizes="(max-width: 697px) calc(100vw - 98px), (max-width: 767px) 600px, (max-width: 1399px) calc(30vw - 68px), 352px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={64}
      alt={`โปสเตอร์โปรโมชั่นแนวนอนของ ${BRAND_NAME} บนฉากพื้นดำ มุมซ้ายบนเป็นโลโก้ ${BRAND_NAME} ที่คำว่า รวย เป็นตัวอักษรไทยหนาสามมิติสีทอง ต่อด้วย เทพ สีขาวมุกตัดขอบเทา และเลข 168 สีแดงชาดผิวมันวาว ถัดมาเป็นเทพเจ้าแห่งโชคลาภจีนหัวเราะ สวมหมวกปีกสีทองแต่งแดง กลางภาพเป็นคำว่า โปรโมชั่น ตัวอักษรไทยสามมิติขนาดใหญ่สีทองตัดขอบแดง มีมงกุฎทองวางอยู่ด้านบน ใต้ลงมาเป็นโทรโข่งสีแดงหันเข้าหาคำว่า แนะนำเพื่อน สีขาว ต่อท้ายด้วยเลข 0.8% ตัวโตสีทองตัดขอบขาว ครึ่งขวาเป็นหญิงสาวผมยาวสีบลอนด์เงินปักปิ่นทอง สวมชุดสีขาว-แดงประดับทองและโช้กเกอร์แดง ขยิบตาหนึ่งข้างพร้อมยื่นมือมาทางผู้ชม ริมขวาเป็นไพ่โพแดงกับตู้สล็อต รอบภาพมีเหรียญทองร่วง ริ้วทองโค้ง หัวใจสีแดง กล่องของขวัญสีแดง และประกายดาวสีทองกระจายอยู่`}
      class="mx-auto h-auto w-full max-w-[600px] rounded-2xl border border-[#e4021b]/70 shadow-[0_0_28px_rgba(240,187,78,0.35)]"
    />
  </ContentBoxSevenThree>

  <ContentBoxTwoNeumorphism as="h2" title={`สมัครเล่นสล็อต ${BRAND_NAME} ง่ายๆ 3 ขั้นตอน`}>
    <p slot="left">
      ผู้ที่สนใจศึกษาวิธีสมัครสมาชิกกับ{BRAND_NAME}
      <strong class="text-[#f0bb4e]">สามารถตรวจสอบขั้นตอนการลงทะเบียนผ่านหน้าเว็บไซต์ทางการ</strong>
    </p>
    <p slot="right">
      โดยควรอ่านข้อกำหนดเกี่ยวกับคุณสมบัติผู้สมัคร เงื่อนไขการเปิดบัญชี
      <strong class="text-[#f0bb4e]">และนโยบายข้อมูลส่วนบุคคลก่อนดำเนินการ</strong>
    </p>
  </ContentBoxTwoNeumorphism>

  <FeatureHighlights items={registerSteps} />

  <ContentBox as="h2" title={`ช่องทางติดต่อแอดมิน ${BRAND_NAME} ตลอด 24ชม.`}>
    <p>
      {BRAND_NAME} ระบุช่องทางติดต่อเจ้าหน้าที่สำหรับผู้ใช้งานที่ต้องการสอบถามเกี่ยวกับการสมัครสมาชิก การเข้าสู่ระบบ รายการฝากถอน และรายละเอียดโปรโมชั่น
      <strong class="text-[#f0bb4e]">โดยควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีหรือบุคคลที่แอบอ้างชื่อบริการ</strong>
      หากพบปัญหาในการทำรายการ ควรเตรียมข้อมูลและหลักฐานที่เกี่ยวข้องไว้สำหรับการตรวจสอบ พร้อมแจ้งรายละเอียดให้ชัดเจน
      <strong class="text-[#f0bb4e]">โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น</strong>
      ทั้งนี้ ควรตรวจสอบเวลาการให้บริการและระยะเวลาตอบกลับล่าสุดจากช่องทางทางการอีกครั้ง
    </p>
  </ContentBox>

  <Faq as="h2" title={`คำถามที่พบบ่อยเกี่ยวกับ ${BRAND_NAME}`} faqs={faqs} />

  <ReviewCardSumo />

  <Navfoot />
</MainLayout>
