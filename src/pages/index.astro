---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import Faq from "../components/Faq.astro";
import LatestWinners from "../components/LatestWinners4.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// Title and description are the brief's own Title/Description lines, verbatim.
// A brief-supplied description ships at whatever length it was written — it is
// not padded up to the 150-character floor.
const pageTitle = "BPLAY639 คาสิโนลิขสิทธิ์แท้อเมริกา เกมเสถียร การันตีมีรางวัลใหญ่ทุกเกม";

const pageDescription =
  "BPLAY639 คาสิโนเกมมาใหม่ การันตีลิขสิทธิ์แท้จากอเมริกา อัปเกรดเกมใหม่ส่งตรงจากเจ้าของ ต้อนรับสมาชิกด้วยโบนัส เกมใหม่ปล่อยแตกทั้งวัน สมัครเลย";

// The ticker copy is passed explicitly rather than relying on the component's
// default — every Announcement* variant's default belongs to whichever brand
// wired it in last. No emoji in this string: an emoji baked into a text prop
// cannot be given its own aria-hidden span.
const announcement =
  "BPLAY639 คาสิโนเกมมาใหม่ ลิขสิทธิ์แท้จากอเมริกา เชื่อถือได้ ปลอดภัยแน่นอน • รวมบาคาร่า รูเล็ต เสือมังกร แบล็กแจ็ก คาสิโนสด และสล็อต ไว้ในบัญชีเดียว • โบนัสแนะนำเพื่อน 0.8% และคืนยอดเสียสูงถึง 0.3% ทุกวันตามเงื่อนไข • สมัครและเข้าใช้งานได้ทั้งสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ • แอดมิน BPLAY639 พร้อมช่วยตรวจสอบเมื่อพบปัญหาระหว่างใช้งาน";

// The brief's three registration steps. They are list items in the docx, not
// headings, so they render as an <ol> — turning them into cards with their own
// titles would add an h3 tier the brief does not have.
const steps = [
  "สมัครสมาชิกผ่านหน้าเว็บไซต์และกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน",
  "Login เข้าสู่บัญชี ฝากเครดิต และตรวจสอบโปรโมชั่นที่มีสิทธิ์รับ",
  "เลือกเกมคาสิโนที่ต้องการ ศึกษากติกาและรายละเอียดก่อนเริ่มเดิมพัน",
];

// The docx's two H3 sub-points under "โบนัสพิเศษสำหรับสมาชิกใหม่". They render
// as <h3> inside FeatureHighlights, which is the only sanctioned h3 tier.
const bonusPoints = [
  {
    icon: "🤝",
    accent: "gold" as const,
    title: "เพียงแค่แนะนำเพื่อน ก็รับโบนัส 0.8% ได้ทันทีเมื่อเพื่อนฝาก",
    description:
      "สมาชิกสามารถนำลิงก์แนะนำของตนเองไปแชร์ให้เพื่อน เมื่อเพื่อนสมัคร ฝากเงิน และมีรายการตรงตามข้อกำหนด ระบบจะคำนวณโบนัสแนะนำเพื่อน 0.8% ตามเงื่อนไขของโปรโมชั่น สามารถตรวจสอบยอดแนะนำและสถานะโบนัสผ่านบัญชีสมาชิกได้",
  },
  {
    icon: "💰",
    accent: "silver" as const,
    title: "ยอดที่เล่นเสียไป เราก็ให้คืนทุกวัน สูงถึง 0.3% ทุกวัน",
    description:
      "สมาชิกที่มียอดเสียตรงตามเงื่อนไขสามารถตรวจสอบสิทธิ์รับโบนัสคืนยอดเสียสูงถึง 0.3% ตามรอบประจำวันที่กำหนด โดยควรตรวจสอบประเภทเกมที่ร่วมรายการ ยอดที่นำมาคำนวณ และข้อกำหนดการรับหรือถอนโบนัสให้เรียบร้อยก่อนกดรับทุกครั้ง",
  },
];

// One array, used by both <Faq> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last.
const faqs = [
  {
    q: "BPLAY639 มีเกมคาสิโนประเภทไหนให้เลือกเล่น?",
    a: "ระบบมีเกมหลายหมวดหมู่ เช่น บาคาร่า คาสิโนสด รูเล็ต เสือมังกร แบล็กแจ็ก สล็อต และเกมคาสิโนประเภทอื่น ๆ สมาชิกสามารถตรวจสอบเกมและผู้ให้บริการที่เปิดให้ใช้งานล่าสุดผ่านหน้าเว็บไซต์ได้",
  },
  {
    q: "โบนัส 0.8% และคืนยอดเสีย 0.3% รับอย่างไร?",
    a: "โบนัส 0.8% เป็นโปรโมชั่นแนะนำเพื่อนสำหรับรายการที่ตรงตามเงื่อนไข ส่วนโบนัสคืนยอดเสียสูงถึง 0.3% จะคำนวณจากยอดที่เข้าเกณฑ์ตามรอบที่กำหนด ควรตรวจสอบรายละเอียดล่าสุดของแต่ละโปรโมชั่นก่อนกดรับสิทธิ์",
  },
  {
    q: "หากสมัคร ฝากถอน หรือรับโบนัส BPLAY639 ไม่สำเร็จต้องทำอย่างไร?",
    a: "ตรวจสอบสถานะรายการและข้อมูลบัญชีก่อน หากยังพบปัญหา สามารถติดต่อแอดมิน BPLAY639 พร้อมแจ้งรายละเอียดและเวลาที่ทำรายการ เพื่อให้ทีมงานช่วยตรวจสอบและแนะนำวิธีดำเนินการต่อได้",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <SmoothCarousel />

  <ContentBoxNeumorphism as="h1" title="BPLAY639 คาสิโนเกมมาใหม่ ลิขสิทธิ์แท้จากอเมริกา เชื่อถือได้ ปลอดภัยแน่นอน">
    <p class="text-left text-base leading-relaxed text-[#f2e3f7]">
      <strong class="text-[#fdf2f8]">BPLAY639</strong> พร้อมให้บริการสมาชิกที่ต้องการเล่นเกมคาสิโนออนไลน์ผ่านมือถือและคอมพิวเตอร์ มีเกมหลากหลายประเภทให้เลือก พร้อมอัปเดตเกมใหม่อย่างต่อเนื่อง รวมถึงโปรโมชั่นสำหรับสมาชิกทั้งโบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไข
      ระบบออกแบบให้สมัครและเข้าใช้งานได้สะดวก พร้อมแอดมินคอยช่วยเหลือเมื่อพบปัญหาระหว่างใช้งาน
    </p>
  </ContentBoxNeumorphism>

  <ContentBoxSpecial as="h2" title="รวมเกมคาสิโน BPLAY639 ส่งตรงจากเจ้าของ เกมปล่อยแตกตลอดทั้งวัน">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f2e3f7]">
      BPLAY639 รวบรวมเกมคาสิโนออนไลน์หลายหมวดหมู่ไว้ภายในบัญชีเดียว ทั้งบาคาร่า รูเล็ต เสือมังกร แบล็กแจ็ก คาสิโนสด สล็อต และเกมใหม่จากผู้ให้บริการที่เปิดให้ใช้งาน สมาชิกสามารถเลือกเกมผ่านสมาร์ตโฟน แท็บเล็ต หรือคอมพิวเตอร์ พร้อมตรวจสอบกติกา ฟีเจอร์ อัตราเดิมพัน และรายละเอียดของเกมก่อนเริ่มเล่นได้โดยตรง
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#f2e3f7]">
      เกมคาสิโนมีผลลัพธ์ที่ไม่แน่นอน จึงไม่มีเกมใดสามารถรับประกันการแตกรางวัลหรือกำไรได้ทุกครั้ง ควรเลือกเดิมพันตามงบประมาณและศึกษากติกาของเกมก่อนเริ่มเล่น
    </p>
  </ContentBoxSpecial>

  <ProviderGrid />

  <ContentBoxSevenThreeNeumorphism as="h2" title="โบนัสพิเศษสำหรับสมาชิกใหม่ BPLAY639">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600, 800]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นโทนชมพูพาสเทลและม่วงลาเวนเดอร์ มีดาวและก้อนเมฆเป็นฉากหลัง กลางภาพเขียนว่า โปรโมชั่น แนะนำเพื่อน 0.8% ตัวใหญ่ ด้านขวาเป็นหญิงสาวสวมชุดพาสเทลยืนแบมือไปทางข้อความ ข้างกันมีโล่ตราสัญลักษณ์ AMERICAN LICENSED ส่วนด้านล่างมีชิปคาสิโนหลากสีและไพ่วางกระจายอยู่"
      class="mx-auto h-auto w-full rounded-2xl border border-[#f472b6]/45 shadow-[0_10px_30px_rgba(244,114,182,0.24)]"
    />
    <div slot="right" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f2e3f7]">
        สมาชิก BPLAY639 สามารถตรวจสอบโปรโมชั่นและโบนัสที่กำลังเปิดให้รับผ่านหน้าเว็บไซต์ โดยมีทั้งสิทธิ์สำหรับสมาชิกใหม่และโปรโมชั่นสำหรับสมาชิกที่ใช้งานเป็นประจำ แต่ละรายการจะแสดงเปอร์เซ็นต์ วิธีคำนวณ รอบการรับ และข้อกำหนดที่เกี่ยวข้องให้ตรวจสอบก่อนกดรับสิทธิ์
      </p>
      <FeatureHighlights items={bonusPoints} />
    </div>
  </ContentBoxSevenThreeNeumorphism>

  <ContentBoxSevenThreeNeumorphism as="h2" title="สมัครสมาชิก BPLAY639 ง่าย ๆ พร้อมรับโปรสมาชิกใหม่ ไม่จำกัดจำนวน">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600, 800]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นโทนชมพูพาสเทล กลางภาพเขียนว่า โปรโมชั่น คืนยอดเสีย 0.3% ตัวใหญ่ ด้านหนึ่งเป็นหญิงสาวสวมชุดสีชมพูยืนอยู่บนแท่นโพเดียม ข้าง ๆ มีโล่ตราสัญลักษณ์ AMERICAN LICENSED พร้อมชิปคาสิโนและไพ่วางประกอบอยู่รอบข้อความ"
      class="mx-auto h-auto w-full rounded-2xl border border-[#f472b6]/45 shadow-[0_10px_30px_rgba(244,114,182,0.24)]"
    />
    <div slot="right" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f2e3f7]">เริ่มต้นสมัคร BPLAY639 ผ่านมือถือหรือคอมพิวเตอร์ได้ง่ายเพียง 3 ขั้นตอน</p>

      <ol class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f2e3f7]">
        {
          steps.map((step, i) => (
            <li class="flex items-start gap-3 rounded-2xl border border-[#7e22ce]/60 bg-[#150724]/70 p-4">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-[#f9a8d4] via-[#f472b6] to-[#7e22ce] text-sm font-black text-[#0a0313]">{i + 1}</span>
              <span>{step}</span>
            </li>
          ))
        }
      </ol>

      <p class="text-left text-base leading-relaxed text-[#f2e3f7]">
        สำหรับโปรโมชั่นที่ระบุว่าไม่จำกัดจำนวน ให้ยึดรายละเอียด วงเงิน และข้อกำหนดล่าสุดที่แสดงบนหน้าโปรโมชั่นเป็นหลัก เพื่อให้ทราบสิทธิ์ที่ได้รับอย่างชัดเจนก่อนเข้าร่วม
      </p>
    </div>
  </ContentBoxSevenThreeNeumorphism>

  <LoginRtpSection />

  <ContentBoxFloatingBadge as="h2" title="ติดต่อแอดมิน BPLAY639 ได้ทันทีหากเกิดปัญหา ไม่ต้องรอนานแน่นอน">
    <p class="text-left text-base leading-relaxed text-[#f2e3f7]">
      หากพบปัญหาเกี่ยวกับการสมัครสมาชิก การ Login เครดิตไม่เข้า ฝากถอนล่าช้า โบนัสไม่แสดง หรือไม่สามารถเข้าเกมได้ สามารถติดต่อแอดมิน BPLAY639 พร้อมแจ้งรายละเอียดของปัญหาและเวลาที่ทำรายการ ทีมงานพร้อมช่วยตรวจสอบข้อมูลและแนะนำขั้นตอนดำเนินการต่อ เพื่อให้สมาชิกกลับมาใช้งานระบบได้อย่างต่อเนื่อง
    </p>
  </ContentBoxFloatingBadge>

  <Faq title="คำถามที่พบบ่อยเกี่ยวกับ BPLAY639" faqs={faqs} />

  <LatestWinners />

  <ReviewCardSumo2 />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#f9a8d4] via-[#f472b6] to-[#7e22ce] px-4 py-3 text-sm font-black whitespace-nowrap text-[#0a0313] shadow-[0_10px_30px_rgba(244,114,182,0.28)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(244,114,182,0.42)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#fcd34d]/50 bg-gradient-to-r from-[#35134f] to-[#150724] px-4 py-3 text-sm font-black whitespace-nowrap text-[#fdf2f8] shadow-[0_10px_30px_rgba(244,114,182,0.16)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#fcd34d]/80 hover:text-[#fdf2f8] hover:shadow-[0_15px_40px_rgba(252,211,77,0.3)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>
  </div>

  <Navfoot />
</MainLayout>
