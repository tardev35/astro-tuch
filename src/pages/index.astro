---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement3 from "../components/Announcement3.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBox from "../components/ContentBox.astro";
import ProviderGridPremium from "../components/ProviderGridPremium.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import LatestWinners2 from "../components/LatestWinners2.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import Faq4 from "../components/Faq4.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// Title and description are the brief's own Title/Description lines, verbatim.
// A docx-supplied description ships at whatever length it was written — it is
// not padded up to the 150-character floor.
const pageTitle = "JUMBOBET เว็บพนันเบอร์1ติดอันดับมาแรง โบนัสไม่จำกัด สมัครได้ทุกวัน";

const pageDescription = "JUMBOBET เว็บพนันเบอร์1ยอดนิยม รวมเกมครบครัน โบนัสทุกวัน 0.3% ไม่จำกัด ฝากถอนไม่อั้น สมัครสมาชิกได้ทุกวัน";

// The ticker copy is passed explicitly rather than relying on the component's
// default — every Announcement* variant's default belongs to whichever brand
// wired it in last.
const announcement =
  "JUMBOBET เว็บพนันเบอร์1ยอดนิยม รวมสล็อต บาคาร่า คาสิโนสด รูเล็ต เสือมังกร เกมไพ่ และหวยไว้ในบัญชีเดียว • คืนยอดเสีย 0.3% ไม่จำกัด ตรวจสอบสิทธิ์ได้ตามรอบที่กำหนด • ระบบฝากถอนอัตโนมัติ ทำรายการเองได้ตลอด 24 ชั่วโมง • สมัครสมาชิกใหม่ตรวจสอบโบนัสที่เปิดให้รับได้ทุกวัน";

// The brief's "เริ่มต้นใช้งานได้ง่ายเพียง 3 ขั้นตอน" sub-points. Each title is the
// brief's line verbatim, because FeatureHighlights renders them as the only
// <h3> tier on the page and a heading may only carry docx text.
const steps = [
  {
    icon: "📝",
    title: "สมัครสมาชิก JUMBOBET และกรอกข้อมูลที่ระบบกำหนด",
    accent: "green" as const,
  },
  {
    icon: "💳",
    title: "Login เข้าสู่บัญชีและฝากเครดิตผ่านระบบอัตโนมัติ",
    accent: "silver" as const,
  },
  {
    icon: "🎯",
    title: "ตรวจสอบโปรโมชั่น เลือกเกมที่ต้องการ และศึกษากติกาก่อนเริ่มเดิมพัน",
    accent: "green" as const,
  },
];

// One array, used by both <Faq4> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last.
const faqs = [
  {
    q: "โบนัสคืนยอดเสีย 0.3% ของ JUMBOBET รับได้ทุกวันหรือไม่?",
    a: "สมาชิกที่มียอดตรงตามเงื่อนไขสามารถรับโบนัสคืนยอดเสียตามรอบที่กำหนดได้ โดยควรตรวจสอบยอดคำนวณ ประเภทเกมที่ร่วมรายการ และเงื่อนไขล่าสุดบนหน้าโปรโมชั่นก่อนกดรับทุกครั้ง",
  },
  {
    q: "JUMBOBET ฝากถอนผ่านช่องทางไหนได้บ้าง?",
    a: "ระบบรองรับช่องทางฝากถอนตามรายการที่เปิดให้บริการในบัญชีสมาชิก สมาชิกควรตรวจสอบช่องทาง วงเงิน และรายละเอียดบัญชีให้ถูกต้องก่อนยืนยันธุรกรรม หากทำรายการไม่สำเร็จสามารถติดต่อเจ้าหน้าที่ให้ช่วยตรวจสอบได้",
  },
  {
    q: "สมัครสมาชิกใหม่แล้วได้รับโบนัสทันทีหรือไม่?",
    a: "สิทธิ์โบนัสขึ้นอยู่กับโปรโมชั่นที่เปิดให้บริการในช่วงเวลาที่สมัคร สมาชิกควรตรวจสอบยอดฝากที่กำหนด เงื่อนไขรับโบนัส และข้อกำหนดการถอนก่อนเข้าร่วม เพื่อเลือกโปรโมชั่นที่เหมาะกับการใช้งานของตนเอง",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement3 message={announcement} />

  <SmoothCarousel />

  <ContentBoxPremium as="h1" title="JUMBOBET เว็บพนันเบอร์1ยอดนิยม แหล่งเดิมพันที่ดีที่สุดในตอนนี้">
    <p class="text-left text-base leading-relaxed text-[#d5e8d0]">
      <strong class="text-[#6ef25a]">JUMBOBET</strong> พร้อมให้บริการสมาชิกที่ต้องการเข้าเล่นเกมพนันออนไลน์ผ่านมือถือและคอมพิวเตอร์ มีเกมเดิมพันหลากหลายประเภทให้เลือก พร้อมโปรโมชั่นคืนยอดเสีย 0.3% ตามเงื่อนไข
      ระบบฝากถอนอัตโนมัติช่วยให้สมาชิกจัดการธุรกรรมได้สะดวกตลอดทั้งวัน และสามารถสมัครสมาชิกเพื่อตรวจสอบโปรโมชั่นหรือเกมที่เปิดให้บริการได้ทุกวัน
    </p>
  </ContentBoxPremium>

  <ContentBox as="h2" title="คาสิโน JUMBOBET รวมเกมพนันออนไลน์ ครบวงจร">
    <p class="text-left text-base leading-relaxed text-[#d5e8d0]">
      สมาชิกสามารถเลือกเล่นเกมพนันออนไลน์ได้หลายหมวดหมู่ภายในบัญชีเดียว ทั้งเกมสล็อต บาคาร่า คาสิโนสด รูเล็ต เสือมังกร เกมไพ่ หวย และการเดิมพันประเภทอื่น ๆ ระบบจัดหมวดหมู่เกมให้ค้นหาได้สะดวก
      พร้อมรองรับการเข้าใช้งานผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ ช่วยให้เลือกเกมที่สนใจได้โดยไม่ต้องสลับใช้งานหลายบัญชี
    </p>
  </ContentBox>

  <ProviderGridPremium />

  <ContentBoxSevenThreePremium titleright="JUMBOBET แจกโบนัสยอดเสียคืนทุกวัน 0.3% ไม่จำกัด">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นพื้นหลังสีดำ ลายวงจรไฟฟ้าเรืองแสงสีเขียว ด้านบนกลางเป็นโลโก้ตัวอักษรโครเมียมสลับเขียวเขียนว่า JUMBOBET ถัดลงมาเป็นแผ่นป้ายข้อความ โปรโมชั่น คืนยอดเสีย รับโบนัส พร้อมตัวเลข 0.3% ขนาดใหญ่ หญิงสาวในชุดดีลเลอร์สีแดงดำยืนแบมือทางขวาของภาพ รอบตัวมีชิปคาสิโนและไพ่เอซ ด้านล่างเป็นแถวไอคอนบิตคอยน์ โล่ และ 24 ชั่วโมง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#25cb0e]/45 shadow-[0_10px_30px_rgba(37,203,14,0.22)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#d5e8d0]">
      สมาชิกที่มียอดเสียตามข้อกำหนดสามารถตรวจสอบสิทธิ์รับโบนัสคืนยอดเสีย 0.3% ได้ตามรอบที่เว็บไซต์กำหนด โดยระบบจะแสดงยอดที่เข้าเงื่อนไขและรายละเอียดสำหรับกดรับโบนัส สมาชิกควรตรวจสอบประเภทเกมที่ร่วมรายการ
      รอบคำนวณ และเงื่อนไขการถอนก่อนรับสิทธิ์ทุกครั้ง เพื่อให้ทราบรายละเอียดของโปรโมชั่นอย่างครบถ้วน
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBoxFloatingBadge as="h2" title="JUMBOBET รองรับระบบฝากถอนทุกช่องทาง ฝากถอนได้ไม่อั้น">
    <p class="text-left text-base leading-relaxed text-[#d5e8d0]">
      JUMBOBET มีระบบฝากถอนอัตโนมัติ รองรับช่องทางการทำธุรกรรมตามที่เว็บไซต์เปิดให้บริการ สมาชิกสามารถฝากเครดิต ส่งคำขอถอน และตรวจสอบสถานะรายการได้ด้วยตนเองตลอด 24 ชั่วโมง
      โดยวงเงินและข้อกำหนดของแต่ละช่องทางให้ยึดข้อมูลที่แสดงในระบบ ณ เวลาทำรายการ หากเครดิตไม่เข้าหรือรายการล่าช้า สามารถติดต่อทีมงานให้ช่วยตรวจสอบได้ทันที
    </p>
  </ContentBoxFloatingBadge>

  <LatestWinners2 />

  <ContentBoxSevenThreeFloatingBadge title="สมัคร JUMBOBET รับโบนัสสมาชิกใหม่ได้ทุกวัน">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นพื้นหลังสีดำ ลายวงจรไฟฟ้าเรืองแสงสีเขียว ด้านบนเป็นโลโก้ตัวอักษรโครเมียมสลับเขียวเขียนว่า JUMBOBET ถัดลงมาเป็นแผ่นป้ายข้อความ โปรโมชั่น แนะนำเพื่อน รับโบนัส พร้อมตัวเลข 0.8% ขนาดใหญ่ หญิงสาวในชุดกีฬาครอปสีแดงดำกำลังชี้มือ มุมล่างซ้ายมีชิปคาสิโนสีแดงกับสีเขียวและไพ่เอซสี่ใบ"
      class="mx-auto h-auto w-full rounded-2xl border border-[#25cb0e]/45 shadow-[0_10px_30px_rgba(37,203,14,0.22)]"
    />
    <div slot="right" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d5e8d0]">
        ผู้ใช้งานใหม่สามารถสมัครสมาชิกผ่านระบบออนไลน์ได้ทุกวัน หลังเปิดบัญชีเรียบร้อยแล้วสามารถเข้าสู่ระบบเพื่อตรวจสอบโปรโมชั่นสำหรับสมาชิกใหม่ที่กำลังเปิดให้รับ
        โดยโบนัสและสิทธิพิเศษจะแตกต่างกันตามเงื่อนไขของแต่ละรายการ
      </p>
      <p class="text-left text-base leading-relaxed font-bold text-[#6ef25a]">เริ่มต้นใช้งานได้ง่ายเพียง 3 ขั้นตอน</p>
      <FeatureHighlights items={steps} />
    </div>
  </ContentBoxSevenThreeFloatingBadge>

  <Faq4 title="คำถามที่พบบ่อยเกี่ยวกับ JUMBOBET" faqs={faqs} />

  <LoginRtpSection />

  <ReviewCardSumo2 />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#6ef25a] via-[#25cb0e] to-[#0b7a06] px-4 py-3 text-sm font-black whitespace-nowrap text-[#031204] shadow-[0_10px_30px_rgba(37,203,14,0.28)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(37,203,14,0.42)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#25cb0e]/50 bg-gradient-to-r from-[#031204] to-[#010301] px-4 py-3 text-sm font-black whitespace-nowrap text-[#6ef25a] shadow-[0_10px_30px_rgba(37,203,14,0.16)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#6ef25a]/70 hover:text-[#f0f7ee] hover:shadow-[0_15px_40px_rgba(240,247,238,0.28)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>
  </div>

  <Navfoot />
</MainLayout>
