---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBox3ThreePremium from "../components/ContentBox3ThreePremium.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LatestWinners from "../components/LatestWinners3.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import Faq2 from "../components/Faq2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// SLIDE ROLES FOR OCZPLUS — READ BEFORE REUSING THESE IMPORTS.
// Verified against the artwork on the 2026-09-16 drop: slide1.png is the
// แนะนำเพื่อน 0.8% poster (navy network ground, a couple with a tablet showing a
// people graph) and slide2.png is the คืนยอดเสีย 0.3% one (cream-to-black split
// ground, a tablet showing a rising chart). The docx puts แนะนำเพื่อน first
// (H3 #4) and คืนยอดเสีย second (H3 #5), so slide1 sits in the first SevenThree
// block and slide2 in the second. Re-check the actual posters on the next
// rebrand rather than trusting this order — a previous brand shipped the two
// swapped, which builds clean and reads wrong.
//
// Both posters print the exact percentage its section describes, so the alt text
// and the section prose agree with each other and with the brief. Two
// ContentBoxSevenThree* blocks in total — that is the hard cap for the family.
//
// Stale assets that must stay unimported: slide3.png / slide4.png (2026-08-13)
// and banner2.png / banner3.png (2026-08-20 / 2026-08-11) all belong to earlier
// clients. This brand has no banner2+ article illustration, so no ContentBox
// gets an inline banner image this round. banner1.png and banner1-mobile.png are
// the hero pair and belong to MainLayout's own pinned globs — never referenced
// from a page.

// Title and description are the brief's own Title/Meta Description lines, used
// verbatim. A brief-supplied description is never padded up to the 150-char
// floor and never topped up from the H1/H2.
const pageTitle = "OCZPLUS สล็อตอันดับหนึ่ง การันตียอดถอนทุกวัน รีวิวเพียบ";

const pageDescription = "OCZPLUS สล็อตอันดับหนึ่ง แหล่งเดิมพันชั้นเยี่ยมที่ดีที่สุด การันตียอดถอนทุกวัน รีวิวจากสมาชิกเพียบ แจกโบนัสหนัก ไม่ล็อคยูส";

// <Announcement /> runs bare: Announcement3's default message is already this
// brand's copy, and every sub-page calls it bare too — passing an override here
// is how the ticker ends up saying two different things on two pages.

// One array, used by both <Faq2> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last. The three pairs
// are the brief's Q1-Q3, verbatim.
const faqs = [
  {
    q: "OCZPLUS มีการล็อคยูสเซอร์ใหม่หรือยูสเซอร์เก่าหรือไม่?",
    a: "ไม่มีอย่างแน่นอนครับ OCZPLUS ใช้ระบบเกมลิขสิทธิ์แท้ที่ควบคุมด้วยระบบสุ่ม RNG (Random Number Generator) 100% ทั้งลูกค้าเก่าและใหม่มีโอกาสชนะและรับแจ็คพอตเท่าเทียมกัน ไม่มีการปรับลดอัตราการชนะใดๆ ทั้งสิ้น",
  },
  {
    q: "การถอนเงินใช้เวลานานเท่าไหร่ และมีจำกัดรอบต่อวันไหม?",
    a: "ระบบฝาก-ถอนอัตโนมัติของเราประมวลผลรวดเร็วภายใน 3-5 วินาที สมาชิกสามารถทำรายการถอนเงินได้ตลอด 24 ชั่วโมง โดยไม่จำกัดจำนวนครั้งและไม่จำกัดยอดถอนสูงสุดต่อวัน",
  },
  {
    q: "ภาพกราฟิกของเกมสล็อตในเว็บจะทำให้มือถือกระตุกไหม?",
    a: "ระบบแพลตฟอร์มของเราถูกปรับแต่ง (Optimize) มาเป็นอย่างดี แม้ตัวเกมจะจัดเต็มด้วยภาพระดับพรีเมียมและเอฟเฟกต์สุดอลังการ แต่ก็สามารถเล่นได้อย่างไหลลื่น ไม่มีสะดุด รองรับการทำงานบนสมาร์ทโฟนทุกรุ่นทั้ง iOS และ Android",
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// The highlight colour is the palette's light gold (#f2dc9a); it marks a claim
// the brief states outright and nothing else.

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb. Every URL in the graph is derived
// by pageGraph from `site:` — no domain is typed out in this file.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxPremium as="h1" title="OCZPLUS สล็อตอันดับหนึ่ง แหล่งเดิมพันชั้นเยี่ยมที่ดีที่สุด">
    <p class="text-left text-base leading-relaxed text-[#ccd6e6]">
      ก้าวสู่ความเหนือระดับกับ <strong class="text-[#f2dc9a]">OCZPLUS สล็อตอันดับหนึ่ง แหล่งเดิมพันชั้นเยี่ยมที่ดีที่สุดในยุคนี้</strong>
      เราได้พัฒนาระบบนิเวศการเดิมพันในรูปแบบ
      <strong class="text-[#f2dc9a]">Portal &amp; Privilege ที่พร้อมมอบเอกสิทธิ์และผลตอบแทนสูงสุดให้กับสมาชิก</strong>
      สัมผัสประสบการณ์การใช้งานที่หรูหราผ่านหน้าอินเทอร์เฟซ (UI/UX) โทนสีกรมท่าตัดกับสีทองเมทัลลิคสุดพรีเมียม
      <strong class="text-[#f2dc9a]">พร้อมกราฟิกเกมสล็อตที่จัดเต็มด้วยแสงเงาระดับ Cinematic Lighting</strong>
      ให้คุณดื่มด่ำกับความบันเทิงระดับลักชูรีและทำกำไรได้อย่างไร้ขีดจำกัด
    </p>
  </ContentBoxPremium>

  <ProviderGrid />

  <GameRankingBoard />

  <ContentBox as="h2" title="OCZPLUS การันตียอดถอนทุกวัน รีวิวจากสมาชิกเพียบ">
    <p class="text-left text-base leading-relaxed text-[#ccd6e6]">
      ความน่าเชื่อถือคือสิ่งที่เราให้ความสำคัญเป็นอันดับแรก OCZPLUS ได้รับการยอมรับจากผู้เล่นทั่วประเทศด้วยการ
      <strong class="text-[#f2dc9a]">การันตียอดถอนทุกวัน</strong>
      ไม่ว่าคุณจะทำกำไรได้หลักหมื่นหรือหลักล้าน
      <strong class="text-[#f2dc9a]">เราพร้อมจ่ายเต็มจำนวน ไร้ประวัติการโกง</strong>
      พิสูจน์ได้จากรีวิวของสมาชิกตัวจริงที่หมุนเวียนเข้ามาทำกำไรและแบ่งปันความประทับใจผ่านช่องทางต่างๆ อย่างล้นหลาม มั่นใจได้เลยว่าทุกการเดิมพันที่นี่
      <strong class="text-[#f2dc9a]">ปลอดภัยและได้เงินชัวร์ 100%</strong>
    </p>
  </ContentBox>

  <LatestWinners />

  <ReviewCardSumo2 />

  <ContentBoxPremium as="h2" title="โปรโมชั่น OCZPLUS แจกทุกยูส ไม่มีล็อค">
    <p class="text-left text-base leading-relaxed text-[#ccd6e6]">
      เราดูแลสมาชิกทุกคนอย่างเท่าเทียม ไม่ว่าจะเป็นฐานลูกค้าเก่าที่สะสมยอดฝากมาอย่างยาวนาน หรือสมาชิกใหม่ที่เพิ่งสมัครเข้ามา
      <strong class="text-[#f2dc9a]">OCZPLUS แจกโบนัสหนัก จัดเต็มทุกยูสเซอร์แบบไม่มีการล็อคยูส (RNG 100%)</strong>
      เพื่อให้ทุกคนมีโอกาสคว้ารางวัลใหญ่ได้อย่างยุติธรรม
    </p>
  </ContentBoxPremium>

  <ContentBoxSevenThree as="h3" title="โปรโมชั่น แนะนำเพื่อน 0.8%">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อน 0.8% ของ OCZPLUS พื้นหลังโทนสีกรมท่าไล่เฉด มีเส้นเชื่อมโยงเครือข่ายและจุดแสงสีฟ้าทองกระจายทั่วภาพ มุมซ้ายบนเป็นโลโก้ OCZPLUS ตัวอักษร OCZ สีเงินโครเมียม เครื่องหมายบวกสีแดง และคำว่า PLUS สีทองเมทัลลิค ตรงกลางเป็นหญิงสวมชุดสีทองตัดดำถือแท็บเล็ตที่แสดงแผนผังเครือข่ายรูปคน ยืนคู่กับชายสวมสูทสีกรมท่าที่ยกมือชี้ไปทางข้อความ ด้านขวาเป็นคำว่า โปรโมชั่น สีขาว บรรทัดถัดมาเขียนว่า แนะนำเพื่อน สีขาว วางเหนือตัวเลข 0.8% ขนาดใหญ่สีทองเงาขอบแดง และบรรทัดล่างสุดเขียนว่า ง่ายๆ เพียงส่งต่อลิงก์"
      class="mx-auto h-auto w-full rounded-2xl border border-[#d9b45e]/45 shadow-[0_10px_30px_rgba(217,180,94,0.24)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#ccd6e6]">
      เปลี่ยนเครือข่ายสังคมออนไลน์ของคุณให้เป็นรายได้ที่มั่นคง เพียงส่งลิงก์แนะนำเพื่อนให้เข้ามาร่วมสนุก
      <strong class="text-[#f2dc9a]">คุณจะได้รับค่าคอมมิชชั่นสูงถึง 0.8% จากทุกยอดการเล่นของเพื่อน</strong>
      ยิ่งชวนมาก ยิ่งรับทรัพย์มาก
      <strong class="text-[#f2dc9a]">ถือเป็นช่องทางการสร้างรายได้แบบ Passive Income ที่คุ้มค่าที่สุด</strong>
    </p>
  </ContentBoxSevenThree>

  <ContentBoxSevenThreePremium as="h3" title="โปรโมชั่น คืนยอดเสีย 0.3%">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นคืนยอดเสีย 0.3% ของ OCZPLUS ครึ่งซ้ายเป็นพื้นหลังสว่างโทนครีมที่มีลำแสงสีทองพาด ครึ่งขวาเป็นพื้นหลังสีดำอมกรมท่าที่มีบรรทัดโค้ดโปรแกรมและอนุภาคแสงสีทองลอยอยู่ มุมซ้ายบนเป็นโลโก้ OCZPLUS ตัวอักษร OCZ สีเงินโครเมียม เครื่องหมายบวกสีแดง และคำว่า PLUS สีทองเมทัลลิค ด้านซ้ายเป็นคำว่า โปรโมชั่น สีทอง บรรทัดถัดมาเขียนว่า คืนยอดเสีย สีดำ วางเหนือตัวเลข 0.3% ขนาดใหญ่สีทองเงาขอบแดง ตรงกลางเป็นหญิงสวมชุดสีแดงเข้มยื่นมือออกมาในท่าเชิญ ยืนคู่กับชายสวมสูทสีเทาที่ถือแท็บเล็ตแสดงกราฟขาขึ้นพร้อมตัวเลข 0.3%"
      class="mx-auto h-auto w-full rounded-2xl border border-[#8b939c]/45 shadow-[0_10px_30px_rgba(230,235,240,0.18)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#ccd6e6]">
      เล่นเสียไม่ต้องถอดใจ เพราะเรามีระบบซัพพอร์ตเงินทุนด้วยโปรโมชั่น
      <strong class="text-[#f2dc9a]">คืนยอดเสีย 0.3% ในทุกยอดการเล่น</strong>
      เพื่อให้คุณมีเครดิตสำรองกลับไปแก้มือและต่อยอดสร้างกำไรในเกมสล็อตได้อย่างต่อเนื่อง
      <strong class="text-[#f2dc9a]">กดรับสิทธิ์ได้ง่ายๆ ผ่านหน้าเว็บ</strong>
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBox3ThreePremium
    as="h2"
    title="ฝากถอน OCZPLUS บนมือถือได้ทุกธนาคารและวอลเลท"
    titleleft="ระบบอัตโนมัติเพื่อมือถือ"
    titlecenter="ทุกธนาคารและ TrueMoney Wallet"
    titleright="ไม่ต้องส่งสลิป ไม่มีขั้นต่ำ">
    <p slot="left" class="text-left text-base leading-relaxed text-[#ccd6e6]">
      มอบความสะดวกสบายสูงสุดด้วย
      <strong class="text-[#f2dc9a]">ระบบธุรกรรมการเงินแบบอัตโนมัติ (Auto)</strong>
      ที่ออกแบบมาเพื่อการใช้งานบนโทรศัพท์มือถือโดยเฉพาะ
    </p>
    <p slot="center" class="text-left text-base leading-relaxed text-[#ccd6e6]">
      <strong class="text-[#f2dc9a]">รองรับการทำรายการผ่านทุกธนาคารชั้นนำในประเทศไทย รวมถึง TrueMoney Wallet</strong>
      ฝากถอนง่าย รวดเร็วทันใจภายในไม่กี่วินาที
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#ccd6e6]">
      <strong class="text-[#f2dc9a]">ไม่ต้องส่งสลิปให้แอดมิน ไม่มีขั้นต่ำ</strong>
      ให้อิสระทางการเงินกับคุณตลอด 24 ชั่วโมง
    </p>
  </ContentBox3ThreePremium>

  <LoginRtpSection />

  <ContentBox as="h2" title="แอดมิน OCZPLUS ดูแลสมาชิกออนไลน์ตลอด 24 ชั่วโมง">
    <p class="text-left text-base leading-relaxed text-[#ccd6e6]">
      ยกระดับการบริการด้วยทีมงานดูแลลูกค้ามืออาชีพ ที่พร้อมสแตนด์บาย
      <strong class="text-[#f2dc9a]">ให้บริการและคำปรึกษาผ่านช่องทาง Line Official ตลอด 24 ชั่วโมง</strong>
      ไม่ว่าคุณจะมีข้อสงสัยเรื่องการรับโปรโมชั่น ติดปัญหาการทำธุรกรรม หรือต้องการคำแนะนำในการใช้งานเว็บไซต์
      <strong class="text-[#f2dc9a]">ทีมแอดมินของเราพร้อมดูแลเอาใจใส่และแก้ไขปัญหาให้อย่างรวดเร็ว ตรงจุด</strong>
      เพื่อให้ประสบการณ์การเดิมพันของคุณราบรื่นที่สุด
    </p>
  </ContentBox>

  <Faq2 as="h2" title="คำถามที่พบบ่อย (FAQ)" faqs={faqs} />

  <Navfoot />
</MainLayout>
