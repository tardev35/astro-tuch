---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement5 from "../components/Announcement5.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LatestWinners3 from "../components/LatestWinners3.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq4 from "../components/Faq4.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

const pageTitle = "UFASLOT รวมสล็อตสายลุย ปั่นง่าย แตกไว ค่ายแท้ดั้งเดิม ต้องมีโบนัสคืนยอดให้ 0.3% ทุกวัน";

const pageDescription =
  "UFASLOT รวมสล็อตสายลุย ครบทุกค่ายแท้ดั้งเดิม เข้าเล่นทุกวัน รับโบนัสคืนได้ทุกวัน 0.3% สมัครง่ายๆ บนมือถือและเบราว์เซอร์ได้ตลอด 24 ชั่วโมง พร้อมทีมงานคอยดูแล";

const cashbackPoints = [
  {
    icon: "💰",
    title: "รับโบนัสคืนยอดเสีย 0.3% ได้ทุกวัน",
    description: "สมาชิกที่มียอดเสียตามเงื่อนไขของโปรโมชั่นสามารถกดรับโบนัสคืนยอดเสีย 0.3% ได้ทุกวันตามรอบเวลาที่ UFASLOT กำหนดไว้",
    accent: "gold" as const,
  },
  {
    icon: "🔎",
    title: "ตรวจสอบยอดผ่านระบบสมาชิก",
    description: "ก่อนกดรับสิทธิ์สามารถตรวจสอบยอดและรายละเอียดการรับโบนัสได้ด้วยตนเองผ่านระบบสมาชิกของ UFASLOT",
    accent: "blue" as const,
  },
  {
    icon: "📋",
    title: "เงื่อนไขเป็นไปตามหน้าโปรโมชั่น",
    description: "ยอดที่นำมาคำนวณ รอบเวลา และเงื่อนไขการรับโบนัสจะเป็นไปตามข้อกำหนดที่แสดงบนหน้าโปรโมชั่นของ UFASLOT",
    accent: "gold" as const,
  },
];

const devicePoints = [
  {
    icon: "📱",
    title: "รองรับทั้ง Android และ iOS",
    description: "เล่นสล็อตบนมือถือได้ทั้งระบบ Android และ iOS รวมถึงแท็บเล็ตและคอมพิวเตอร์ในบัญชีสมาชิกเดียว",
    accent: "gold" as const,
  },
  {
    icon: "🌐",
    title: "เปิดผ่านเบราว์เซอร์ได้ทันที",
    description: "เปิดหน้าเว็บไซต์ผ่านเบราว์เซอร์แล้ว Login เข้าสู่บัญชีได้โดยตรง ไม่จำเป็นต้องติดตั้งโปรแกรมเพิ่มเติม",
    accent: "blue" as const,
  },
  {
    icon: "🖥️",
    title: "ปรับการแสดงผลตามขนาดหน้าจอ",
    description: "ระบบปรับการแสดงผลให้เหมาะกับหน้าจอที่ใช้ ค้นหาเกม ตรวจสอบเครดิต ฝากถอน และเข้าเล่นสล็อตได้สะดวกทุกช่วงเวลา",
    accent: "gold" as const,
  },
];

const faqs = [
  {
    q: "UFASLOT เข้าเล่นสล็อตผ่านมือถือได้หรือไม่?",
    a: "ได้ ระบบรองรับการใช้งานผ่านมือถือทั้ง Android และ iOS รวมถึงแท็บเล็ตและคอมพิวเตอร์ สามารถเข้าเว็บไซต์ผ่านเบราว์เซอร์ Login บัญชีสมาชิก และเลือกเกมสล็อตที่ต้องการได้โดยตรง",
  },
  {
    q: "โบนัสคืนยอดเสีย 0.3% รับได้ทุกวันหรือไม่?",
    a: "สมาชิกที่มียอดเสียและมีคุณสมบัติตรงตามข้อกำหนดสามารถรับโบนัสคืนยอดเสีย 0.3% ตามรอบที่กำหนดได้ แนะนำให้ตรวจสอบยอดคำนวณ เวลาในการกดรับ และเงื่อนไขล่าสุดบนหน้าโปรโมชั่นก่อนรับสิทธิ์ทุกครั้ง",
  },
  {
    q: "หากฝากถอนหรือเข้าสู่ระบบไม่ได้ต้องทำอย่างไร?",
    a: "แนะนำให้ตรวจสอบข้อมูลบัญชีและสถานะรายการก่อน หากยังไม่สามารถดำเนินการได้ สามารถติดต่อแอดมิน UFASLOT ตลอด 24 ชั่วโมง พร้อมแจ้งรายละเอียดของปัญหาเพื่อให้ทีมงานตรวจสอบและแนะนำวิธีดำเนินการต่อได้รวดเร็วยิ่งขึ้น",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement5
    message="UFASLOT รวมสล็อตสายลุย ปั่นง่ายแตกไวทุกเกม ค่ายแท้ดั้งเดิมลิขสิทธิ์แท้ • โบนัสคืนยอดเสีย 0.3% ทุกวันตามเงื่อนไข • แนะนำเพื่อนรับโบนัส 0.8% • เข้าเล่นผ่านมือถือและเบราว์เซอร์ได้ตลอด 24 ชั่วโมง • แอดมินพร้อมให้คำแนะนำทุกขั้นตอน"
  />

  <SmoothCarousel />

  <ContentBoxNeumorphism as="h1" title="UFASLOT รวมสล็อตสายลุย ปั่นง่ายแตกไวทุกเกม เข้าถึงแจ็คพอตได้ทุกชั่วโมง">
    <p class="text-left text-base leading-relaxed text-[#f2e6cd]">
      <strong class="text-[#f5c518]">UFASLOT</strong> พร้อมให้บริการสมาชิกที่ต้องการเล่นสล็อตออนไลน์ผ่านระบบที่ใช้งานง่าย มีเกมสล็อตจากหลากหลายค่ายให้เลือก
      พร้อมรองรับการเข้าเล่นผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ได้ตลอด 24 ชั่วโมง สมาชิกยังสามารถติดตามสิทธิพิเศษและโบนัสคืนยอดเสีย 0.3% ทุกวันตามเงื่อนไข หากมีปัญหาในการสมัคร ฝากถอน
      หรือเข้าเล่น สามารถสอบถามแอดมินเพื่อรับคำแนะนำได้ตลอดเวลา
    </p>
  </ContentBoxNeumorphism>

  <ContentBoxSevenThreeNeumorphism title="UFASLOT รวมสล็อตโบนัสหนัก ครบทุกค่ายแท้ดั้งเดิม ลิขสิทธิ์แท้ทุกเกม">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่น UFASLOT พื้นหลังสีดำ มีโลโก้ UFASLOT ตัวอักษรทองและเงิน ข้อความ โปรโมชั่น แนะนำเพื่อน รับโบนัส 0.8% พร้อมตัวเลข 0.8% สีทองขนาดใหญ่ หญิงสาวสวมชุดดำขลิบทอง ยืนข้างกองเหรียญทองและชิปคาสิโน"
      class="mx-auto h-auto w-full rounded-2xl border border-[#b6821d]/45 shadow-[0_10px_30px_rgba(245,197,24,0.18)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f2e6cd]">
      สมาชิก UFASLOT สามารถเลือกเล่นสล็อตจากหลากหลายค่ายภายในบัญชีเดียว มีทั้งเกมยอดนิยม เกมโบนัส เกมแจ็คพอต และเกมสล็อตที่อัปเดตเข้ามาใหม่อย่างต่อเนื่อง
      สามารถค้นหาและเลือกเกมตามสไตล์ที่ชอบได้สะดวก ก่อนเริ่มเล่นแนะนำให้ตรวจสอบกติกา ฟีเจอร์โบนัส และอัตราการจ่ายของแต่ละเกม เพื่อให้เข้าใจรายละเอียดก่อนวางเดิมพันจริง
    </p>
  </ContentBoxSevenThreeNeumorphism>

  <ProviderGrid />

  <ContentBoxSevenThree title="สิทธิพิเศษสำหรับสมาชิก UFASLOT รับโบนัสคืน 0.3% ทุกวัน">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่น UFASLOT พื้นหลังสีดำ มีโลโก้ UFASLOT ตัวอักษรทองและเงิน ข้อความ โปรโมชั่น คืนยอดเสีย รับโบนัส 0.3% พร้อมตัวเลข 0.3% สีทองขนาดใหญ่ หญิงสาวสวมชุดเดรสดำ-ทอง ยืนข้างกองชิปคาสิโนและเหรียญทอง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#b6821d]/45 shadow-[0_10px_30px_rgba(245,197,24,0.18)]"
    />
    <div slot="right">
      <p class="text-left text-base leading-relaxed text-[#f2e6cd]">
        สมาชิกที่มียอดเสียตามเงื่อนไขของโปรโมชั่นสามารถรับโบนัสคืนยอดเสีย 0.3% ได้ทุกวัน โดยสามารถตรวจสอบยอดและรายละเอียดการรับสิทธิ์ผ่านระบบสมาชิกก่อนกดรับ
        โปรโมชั่นนี้ช่วยเพิ่มสิทธิประโยชน์ให้กับผู้ที่เข้าเล่นสล็อตเป็นประจำ ทั้งนี้ ยอดที่นำมาคำนวณ รอบเวลา และเงื่อนไขการรับโบนัสจะเป็นไปตามข้อกำหนดที่แสดงบนหน้าโปรโมชั่นของ UFASLOT
      </p>
      <FeatureHighlights items={cashbackPoints} />
    </div>
  </ContentBoxSevenThree>

  <ContentBoxTwoNeumorphism titleleft="เข้าเล่น UFASLOT ผ่านมือถือและหน้าเว็บบนเบราว์เซอร์ ได้ตลอด 24 ชั่วโมง">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f2e6cd]">
      UFASLOT รองรับการเล่นสล็อตบนมือถือทั้ง Android และ iOS รวมถึงแท็บเล็ตและคอมพิวเตอร์ สมาชิกสามารถเปิดหน้าเว็บไซต์ผ่านเบราว์เซอร์และ Login เข้าสู่บัญชีได้โดยตรง
      ไม่จำเป็นต้องติดตั้งโปรแกรมเพิ่มเติม ระบบปรับการแสดงผลให้เหมาะกับขนาดหน้าจอ ช่วยให้การค้นหาเกม ตรวจสอบเครดิต ฝากถอน และเข้าเล่นสล็อตทำได้สะดวกทุกช่วงเวลา
    </p>
    <FeatureHighlights slot="right" items={devicePoints} />
  </ContentBoxTwoNeumorphism>

  <LoginRtpSection />

  <ContentBoxPremium as="h2" title="ปรึกษาแอดมิน UFASLOT ได้ตลอดเวลาทันที ไม่ต้องรอคิว">
    <div>
      <p class="text-left text-base leading-relaxed text-[#f2e6cd]">
        หากพบปัญหาเกี่ยวกับการสมัครสมาชิก การ Login เข้าสู่ระบบ การฝากถอน การกดรับโบนัสคืนยอดเสีย หรือการเข้าเล่นสล็อต สามารถติดต่อแอดมิน UFASLOT เพื่อขอคำแนะนำได้ตลอด 24
        ชั่วโมง ทีมงานพร้อมช่วยตรวจสอบข้อมูลและแนะนำขั้นตอนการใช้งาน เพื่อให้สมาชิกสามารถแก้ไขปัญหาและกลับมาใช้งานระบบได้อย่างต่อเนื่อง
      </p>
      <a
        href="/line"
        class="mt-6 inline-flex items-center justify-center gap-2 rounded-full bg-gradient-to-r from-[#00B900] to-[#009900] px-7 py-3 text-sm font-black text-white shadow-[0_10px_30px_rgba(0,185,0,0.24)] transition-transform duration-300 hover:-translate-y-0.5 hover:scale-105">
        <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE
      </a>
    </div>
  </ContentBoxPremium>

  <Faq4 title="คำถามที่พบบ่อยเกี่ยวกับ UFASLOT" faqs={faqs} />

  <LatestWinners3 />

  <ReviewCardSumo2 />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#fff2c3] via-[#f5c518] to-[#b6821d] px-4 py-3 text-sm font-black whitespace-nowrap text-[#2b1c05] shadow-[0_10px_30px_rgba(245,197,24,0.28)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(245,197,24,0.42)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#d3d3d3]/50 bg-gradient-to-r from-[#2a2a2a] to-[#0d0b06] px-4 py-3 text-sm font-black whitespace-nowrap text-[#d3d3d3] shadow-[0_10px_30px_rgba(211,211,211,0.16)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#f5c518]/60 hover:text-[#fff2c3] hover:shadow-[0_15px_40px_rgba(245,197,24,0.28)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>
  </div>

  <Navfoot />
</MainLayout>
