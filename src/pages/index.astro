---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement4.astro";
import LatestWinners from "../components/LatestWinners.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBox from "../components/ContentBox.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import ContentBox3ThreeNeumorphism from "../components/ContentBox3ThreeNeumorphism.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import Faq from "../components/Faq.astro";
import ReviewCardSumo from "../components/ReviewCardSumo.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import { pageGraph } from "../lib/schema";
import promoCashback from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";

// การหมุน variant รอบนี้ตัดสินไว้แล้วใน .claude/brand-spec-moobin168.md §3 —
// **ห้ามเลือกใหม่ที่นี่** แบรนด์ขาออก (สล็อต168) ถูกหมุนออกจากทุกตระกูลพร้อมกัน:
// Announcement4 แทน Announcement5 · LatestWinners (ฐาน) แทน LatestWinners2 ·
// Faq (ฐาน) แทน Faq3 · ReviewCardSumo (ฐาน) แทน ReviewCardSumo2 · และ shape-mix
// ของ ContentBox ทิ้งชุด Premium / TwoPremium / 3ThreeCyberCut / SevenThreePremium
// / SevenThreeCyberCut / Special / CyberCut ของรอบก่อนทั้งชุด ไปใช้
// Neumorphism / TwoNeumorphism / SevenThreeNeumorphism / SevenThree (ฐาน) /
// ContentBox (ฐาน) + FeatureHighlights / 3ThreeNeumorphism / FloatingBadge แทน
// — **ไม่ทับไฟล์เดิมแม้แต่ตัวเดียว** Navbar/Footer อยู่ที่ MainLayout
// (NavbarStyle11 -> NavbarStyle8, Footer ฐาน -> FooterStyle3) ไม่ใช่ที่ไฟล์นี้
//
// ⚠️⚠️ รอบนี้ **กลับทิศจากรอบก่อน 180 องศา: จากธีมมืด เป็นธีมสว่าง**
// พาเลต (brand-spec §2 ล็อกไว้ 14 ค่า ห้ามเดาเพิ่ม): พื้นเพจ #ffe5ff ชมพู
// พาสเทลสว่างมาก (bg.json) · การ์ด #ffffff · ผิวยก #fff0f8 · wash #ffeef7 ·
// เส้น #f7bcd9 / #ef8dbd · โครม #3b0b26 / #54123a / #7a2350 / #ffe9f5 ·
// หมึก #3b0b26 (= BRAND_TEXT) · หมึกรอง #7a4463 · **หัวข้อ + ไฮไลต์ #c2185b** ·
// หัวข้อเข้มสุด #8e0f41 · ฮิวนำชมพูสด #fa539c / #fb8cc0 / #fdc6c3 / #ffd1cd
// 🚨🚨 **ขาวบน #fa539c ได้แค่ 3.2:1 → ห้ามเด็ดขาด** พื้นถมที่รับหมึกขาวต้องเป็น
// #c2185b ลงไป · **#fa539c บนพื้นขาวก็ได้แค่ 3.2:1 → ห้ามเป็นสีตัวอักษร**
// `<strong>` ทุกตัวในไฟล์นี้จึงเป็น **#c2185b ค่าเดียว** (5.9:1 บนขาว ·
// 5.7:1 บนผิวยก #fff0f8) ไม่ใช่ #fa539c
// ⚠️ #f7bcd9 #ef8dbd #fdc6c3 #ffd1cd #fb8cc0 **ห้ามถือตัวอักษร** (เส้น/พื้นเท่านั้น)
// ⚠️⚠️ **ชมพูผ่านรีโปนี้มาแล้วหลายเจ้า "เจอชมพู ≠ เป็นของรอบนี้"** เทียบทีละค่า:
// f5469f 8c0f52 ff8dc6 (มีโชค168) · fa63b9 ffb3de (ถอนชัวร์168) · dd1b74 a4186b
// 4a0d35 2d0720 (มีทรัพย์168 — **ก็เป็นหมูการ์ตูนชมพูเหมือนกัน แต่เป็นหมูสวม
// หน้ากากโจรบนธีมแมเจนต้าพื้นมืด** รอบนี้คือหมูมีปีกนางฟ้าขาวบนธีมแคนดี้พื้นสว่าง) ·
// และชุดแดงเจล-มุกอุ่นบนดำอมแดงของ **สล็อต168 แบรนด์ขาออก = เสี่ยงหลงเหลือสูงสุด**
// (fb2e33 cb0b0d d81115 f0e6e4 c9b9b7 140000 1c0607 2a0c0d 551c1e) ซึ่งเคยอยู่
// ทั้งไฟล์นี้ — ออกครบทุกค่าแล้ว
// ⚠️ **รอบนี้ไม่มีทองสักเฉด ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง ไม่มีส้ม ไม่มีเขียว
// (ยกเว้น LINE green และเขียว success ของฟีดถอนเงินซึ่งอยู่ไฟล์อื่น) ไม่มีครีม/เบจ
// และไม่มีแรมป์เทาเย็น**
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep สะดุดที่คอมเมนต์นี้)
//
// ย่อหน้าในไฟล์นี้ไม่ถือคลาสสีหรือขนาดของตัวเอง — ทุก ContentBox* ในมิกซ์นี้ตั้ง
// `text-left text-base leading-relaxed text-[#3b0b26]` ไว้บน element ที่ถือ slot
// อยู่แล้ว และไม่มี `<p>` ไหนมี mx-auto / max-w-* (การ์ดคุมความกว้างเองแล้ว)
//
// ชื่อแบรนด์ไม่พิมพ์ตรง ๆ ในไฟล์นี้เลย — interpolate จาก ${BRAND_NAME} ทุกจุด
// รวมถึงใน alt ของสองสไลด์ ไม่มีโดเมนเขียนไว้ที่ไหน และไม่มี URL ที่ต่อด้วย `+`
// ⚠️ **ห้ามเขียน "MOOBIN168" / "moobin168" ตัวละตินที่ไหนทั้งสิ้น** — แบรนด์รอบนี้
// เป็นภาษาไทยล้วน
//
// <strong> ทุกตัวคร่อม "ก้อนที่คั่นด้วยช่องว่าง" ทั้งก้อน เพราะภาษาไทยไม่มีช่องว่าง
// ระหว่างคำ — ไฮไลต์ที่เริ่มหรือจบกลางคำจะถูก formatter ตัดบรรทัดในแท็กแล้วแทรก
// ช่องว่างกลางคำ อ่านคอปปี้โดยถอดแท็กออกต้องได้ข้อความของบรีฟเป๊ะ และไม่มี <strong>
// สองตัวติดกันโดยไม่มีข้อความธรรมดาคั่น
//
// บรีฟรอบนี้ **โฆษณาและกำกับในประโยคเดียวกัน** (brand-spec §5): หัวข้อของบรีฟเอง
// เขียนว่า เว็บตรงถูกลิขสิทธิ์ / ฝากรับโบนัสได้ทั้งวัน ไม่ต้องทำเทิร์น / ไม่จำกัด /
// ฝากถอนไม่มีขั้นต่ำ ขณะที่ย่อหน้าของบรีฟเองตอบกลับว่า ควรตรวจสอบจากข้อมูลผู้พัฒนา
// และหลักฐานการได้รับอนุญาตที่เชื่อถือได้ · ควรตรวจสอบว่าโบนัสประเภทใดได้รับการ
// ยกเว้นข้อกำหนดยอดเดิมพัน · เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจาก
// ทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งต่อไป · แม้จะมีข้อความว่าไม่จำกัด แต่ควร
// ยืนยันจำนวนบัญชีที่เข้าร่วมได้ — **ship ทั้งสองครึ่งตรงตามที่บรีฟเขียน ไม่ขยาย
// คำโฆษณาเป็นคำกล่าวอ้างใหม่ และทุกประโยคกำกับ ship ครบ ไม่ตัดเพราะฟังดูลบ**
// ตัวเลขบนหน้านี้มีแค่ของบรีฟเอง: **0.3% · 0.8% · 3 ขั้นตอน · 24ชม.** ไม่มี RTP
// ไม่มีจำนวนเกม/ค่าย ไม่มีปีก่อตั้ง ไม่มีจำนวนสมาชิก ไม่มียอดฝากขั้นต่ำเป็นตัวเลข
// และไม่มีอัตราจ่าย
// ⚠️ คำของ **สล็อต168 (รอบก่อนทันที)** ที่ห้ามเขียนกลับเข้ามา: ระบบสล็อตเว็บนอก ·
// ทางเข้าแท้ · ไม่ผ่านเอเย่นต์100% · ฐานเกมหลัก · ยอดเข้าบริษัทแม่โดยตรง ·
// จ่ายสูง โบนัสเพียบ — ไฟล์เดิมสร้างอยู่บนคำเหล่านี้ทั้งหน้า และไม่มีคำไหนอยู่ใน
// บรีฟรอบนี้เลย · ไม่มีคำหมวดหวยสักคำ (รอบนี้เป็นเว็บสล็อต)
//
// title/description = บรรทัด 1-2 ของบรีฟตรงตัว (src/assets/content.txt)
// description ยาวราว 121 ตัวอักษร — **ห้ามเติมให้ครบ 150** verify-build ยกเว้น
// เพดานล่างให้หน้าแรกไว้เพราะเหตุผลนี้โดยเฉพาะ
const pageTitle = `${BRAND_NAME} เกมสล็อตแท้ ฝากรับโบนัสทั้งวัน ไม่ต้องทำเทิร์น`;

const pageDescription = `${BRAND_NAME} เกมสล็อตแท้ เว็บตรงถูกลิขสิทธิ์ มีโปรโมชั่น ฝากรับโบนัสได้ทั้งวัน ไม่ต้องทำเทิร์น ฝากถอนไม่มีขั้นต่ำ ไม่จำกัดยอด`;

// บรรทัด 3 ของบรีฟเขียนชื่อแบรนด์ติดกับคำถัดไปโดยไม่มีช่องว่าง — คงไว้ตามบรีฟ
const pageH1 = `${BRAND_NAME}เกมสล็อตแท้ เว็บตรงถูกลิขสิทธิ์ เชื่อถือได้`;

// บรีฟรอบนี้มีชั้น H1 -> H2 -> H3 จริง จึง **ไม่** แบนเป็น H2 ล้วน H3 สองตัวแรก
// เป็นบรรทัด H3 ของบรีฟเอง (content.txt บรรทัด 7 และ 9) ส่วน H3 อีกสามตัวมาจาก
// ลิสต์ย่อย "ขั้นตอนที่ 1-3" ของ §5 (บรรทัด 13/15/17) ผ่าน FeatureHighlights
// ซึ่งเป็นแหล่ง H3 เพิ่มแหล่งเดียวที่ playbook อนุญาต
//
// checklist ตามลำดับเอกสาร (brand-spec §4) และตัวที่รับแต่ละข้อ:
//    1 H1  ${BRAND_NAME}เกมสล็อตแท้ เว็บตรงถูกลิขสิทธิ์ เชื่อถือได้
//          ContentBoxNeumorphism, ย่อหน้าบรรทัด 4
//    2 H2  ${BRAND_NAME} โปรโมชั่น ฝากรับโบนัสได้ทั้งวัน ไม่ต้องทำเทิร์น
//          ContentBoxTwoNeumorphism, บรรทัด 6 แบ่งสองซีก
//    3 H3  โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน
//          ContentBoxSevenThreeNeumorphism + slide1, บรรทัด 8 ซ้าย / ภาพขวา
//    4 H3  โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด
//          ContentBoxSevenThree (ฐาน) + slide2, บรรทัด 10 ซ้าย / ภาพขวา
//    5 H2  สมัครเล่นสล็อต ${BRAND_NAME} ง่ายๆ 3 ขั้นตอน
//          ContentBox (ฐาน), บรรทัด 12 + FeatureHighlights สามข้อ (บรรทัด 13-18)
//          ซึ่งปล่อย H3 ออกมาสามตัว: ขั้นตอนที่ 1 / 2 / 3
//    6 H2  ระบบฝากถอน ${BRAND_NAME} ได้ทุกธนาคารและทรูมันนี่
//          ContentBox3ThreeNeumorphism, บรรทัด 20 แบ่งสามส่วน
//    7 H2  ช่องทางติดต่อแอดมินเว็บ ${BRAND_NAME} ตลอด 24ชม.
//          ContentBoxFloatingBadge, บรรทัด 22
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ ${BRAND_NAME}
//          Faq (ฐาน) + prop faqs ชัดเจน, บรรทัด 24-29
// inventory ที่ต้องได้: **h1 ×1 · h2 ×5 · h3 ×5** — ตรงเป้าของ brand-spec §4
//
// ⚠️ จุดที่ชั้น heading รั่วได้ และกันไว้แล้วทุกจุด: ContentBoxTwoNeumorphism และ
// ContentBox3ThreeNeumorphism มีป้ายคอลัมน์ได้ แต่หน้านี้ **ไม่ส่งป้ายสักใบ**
// (ไม่มี titleleft/titlecenter/titleright) เพราะบรีฟไม่ได้ตั้งชื่อให้คอลัมน์ ·
// ContentBox3ThreeNeumorphism ยังมี prop `heading` ที่ทำให้ป้ายออกเป็น <p> ได้ถ้า
// รอบหน้าต้องใช้ · และ **ไม่ส่ง titleright ให้ SevenThree ทั้งสองบล็อก** คอลัมน์
// ภาพจึงไม่มี heading · คำถามใน Faq ฐานเป็น <p> ใน <summary> ไม่ใช่ <h3> แล้ว ·
// FeatureHighlights ส่ง heading ตามค่าปริยาย (true) **โดยตั้งใจ** เพราะสามข้อนั้น
// เป็นลิสต์ย่อยของบรีฟจริง
// grep `<h[1-6]` ในทุก component ที่ไฟล์นี้กับ MainLayout เรียกแล้วรอบนี้ — ไม่มี
// ตัวไหน hardcode heading ไว้เลย ทุกแท็ก heading บนหน้ามาจาก prop คือมาจากบรีฟ
//
// ทั้ง ContentBoxSevenThree* วาง md:grid-cols-[7fr_3fr] โดยให้ **คอลัมน์ข้อความ
// มาก่อน** ภาพจึงไปอยู่ slot="right" ทุกครั้ง: heading ลงบนเนื้อความไม่ใช่บนภาพ
// และบนมือถือคอลัมน์เดียวอ่านลำดับ หัวข้อ -> ข้อความ -> ภาพ ไม่ใช่เปิดด้วยรูป
// สองบล็อกนี้คือ **เพดาน 2 บล็อกของตระกูล SevenThree พอดี** และ **สไลด์ขึ้นได้
// เฉพาะในสองบล็อกนี้เท่านั้น**
// การจับคู่สไลด์อ่านจากตัวอักษรบนภาพเอง (เปิดรูปอ่านใหม่รอบนี้แล้ว): **slide1
// พิมพ์ โปรโมชั่น + แคปซูล คืนยอดเสีย + 0.3% -> §3** · **slide2 พิมพ์ โปรโมชั่น +
// แคปซูล แนะนำเพื่อน + 0.8% -> §4** — uploader เขียนทับไฟล์ทุกดรอป เลขในชื่อไฟล์
// จึงไม่มีความหมายข้ามแบรนด์ ต้องเปิดรูปอ่านแคปซูลใหม่ทุกครั้ง
// ⛔ **slide3.png / slide4.png / banner2.png / banner3.png เป็นอาร์ตเวิร์กของ
// แบรนด์อื่น ห้าม import เด็ดขาด** เพราะ eager import = emit ขึ้น dist ทุก build
// แม้ไม่มีหน้าไหน render — **รอบนี้จึงไม่มี "รูปประกอบบทความ" (banner2+) เลย**
// และนั่นถูกต้องตาม playbook
// ⚠️ **banner1 / banner1-mobile เป็น hero ของ MainLayout** (glob ปักชื่อไว้แล้ว)
// ห้าม import ที่ไฟล์นี้ · ไม่มีภาพไหนบนหน้านี้เป็น LCP จึง **ไม่มี
// loading="eager" / fetchpriority="high"** สักใบ สไลด์ทั้งสองอยู่ใต้ fold
// ⚠️ `widths`/`sizes` ของสองบล็อกนี้ **ต่างกันจริง** เพราะเรขาคณิตของการ์ดต่างกัน
// (§3 แคป max-w-[1400px] · md:p-10 · gap-8 · คอลัมน์ภาพจ่าย md:border-l + md:pl-8
// -> 343px / calc(30vw - 77px) ส่วน §4 แคป max-w-7xl · md:p-10 · gap-10 ·
// คอลัมน์ภาพจ่าย md:pl-6 ไม่มี border -> 314px / calc(30vw - 70px)) ที่มาของ
// ตัวเลขเขียนไว้ใน frontmatter ของแต่ละ component **ห้ามลอกข้ามไฟล์** · บิตแมปจริง
// ของสไลด์ทั้งคู่คือ **375x600** เพดาน candidate จึงเป็น 375 ห้าม upscale
//
// ที่เหลือบนหน้าเป็น chrome และไม่ออกแท็ก heading ที่ระดับไหนเลย: Announcement4,
// LatestWinners และ ReviewCardSumo ขึ้นชื่อหัวข้อเป็น <p>/<span> พร้อม aria-label
// บน <section> · ticker วางก่อน §1 และการ์ดรีวิว/Navfoot วางหลัง §8 ส่วน
// **ฟีดรับเครดิตวางต่อท้าย §6 (ระบบฝากถอน) โดยตั้งใจ** เพราะมันเป็นวิดเจ็ตที่สังกัด
// หัวข้อนั้นตรง ๆ ตาม playbook Phase 2 ไม่ใช่การแทรกมั่วระหว่างสองหัวข้อ
//
// <Announcement /> เรียกเปล่าโดยตั้งใจ: orchestrator ตั้ง default message ของ
// Announcement4 เป็นคอปปี้ของแบรนด์นี้ไว้แล้วใน P1 และหน้าย่อยก็เรียกเปล่า
// เหมือนกัน — ticker จึงตรงกันทั้งเว็บจากแหล่งเดียว

// ลิสต์ย่อยสามข้อของ docx §5 (content.txt บรรทัด 13-18) — ป้ายคือบรรทัด 13/15/17
// และคำอธิบายคือบรรทัด 14/16/18 ตรงตัว FeatureHighlights render ป้ายเป็น <h3>
// ซึ่งเป็น H3 เพิ่มที่ playbook อนุญาตแหล่งเดียว · ไอคอนเป็น *ขั้นตอน* ล้วน และ
// อยู่ในแผ่น aria-hidden="true" ที่เป็นพี่น้องของป้าย ไม่ใช่อักขระในข้อความ
// accent สลับ ชมพูนำ -> พีช -> ชมพูนำ ตามคู่วัสดุของอาร์ตเวิร์กรอบนี้
const registerSteps = [
  {
    icon: "🔎",
    title: "ขั้นตอนที่ 1 เข้าสู่หน้าสมัครสมาชิก",
    description: "ตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง จากนั้นเลือกเมนูสมัครสมาชิกและอ่านเงื่อนไขการเปิดบัญชี รวมถึงนโยบายการจัดเก็บข้อมูลส่วนบุคคลก่อนกรอกข้อมูล",
    accent: "pink" as const,
  },
  {
    icon: "📝",
    title: "ขั้นตอนที่ 2 กรอกข้อมูลและยืนยันบัญชี",
    description: "กรอกข้อมูลตามที่ระบบกำหนด ตรวจสอบความถูกต้องก่อนยืนยัน และตั้งรหัสผ่านที่คาดเดาได้ยาก ไม่ควรใช้ข้อมูลของบุคคลอื่นหรือเปิดเผยรหัส OTP ให้ใครทราบ",
    accent: "peach" as const,
  },
  {
    icon: "🎮",
    title: "ขั้นตอนที่ 3 เข้าสู่ระบบและตรวจสอบรายละเอียดเกม",
    description:
      "หลังลงทะเบียนเรียบร้อย สามารถศึกษารายชื่อเกมสล็อต กติกาการเล่น ยอดเดิมพันขั้นต่ำ และรายละเอียดโปรโมชั่นที่เปิดให้บริการ หากมีข้อสงสัยควรสอบถามเจ้าหน้าที่ผ่านช่องทางทางการก่อนทำรายการ",
    accent: "pink" as const,
  },
];

// อาร์เรย์เดียว ใช้ทั้งกับ <Faq> และโน้ด FAQPage — ไม่ใช้ default ของ component
// (Faq ตัวฐานตั้งใจ ship เป็นลิสต์ว่าง prop ที่ลืมส่งจึงได้ accordion เปล่า ไม่ใช่
// คำถามของแบรนด์ก่อน) สามคู่นี้คือบล็อก Q/A ของบรีฟเอง (content.txt บรรทัด 24-29)
// ตรงตัว ตัดเฉพาะหมายเลข "1." "2." "3." ออกเพราะ accordion เป็นตัวลิสต์อยู่แล้ว
// ทุกคำตอบคงประโยคกำกับของบรีฟไว้ครบ — เป็นเนื้อหาของบรีฟทั้งสองครึ่ง
const faqs = [
  {
    q: `${BRAND_NAME} มีโปรโมชั่นโบนัสไม่ต้องทำเทิร์นจริงหรือไม่?`,
    a: `ตามข้อมูลที่ระบุ ${BRAND_NAME} มีโปรโมชั่นโบนัสไม่ต้องทำเทิร์น แต่ควรตรวจสอบว่ารายการใดเข้าร่วม และมีเงื่อนไขเกี่ยวกับการถอนเงินหรือวงเงินโบนัสสูงสุดหรือไม่ก่อนรับสิทธิ์`,
  },
  {
    q: `${BRAND_NAME} มีโปรโมชั่นคืนยอดเสีย 0.3% ทุกวันหรือไม่?`,
    a: `โปรโมชั่นระบุสิทธิ์คืนยอดเสีย 0.3% รายวัน โดยควรตรวจสอบรอบคำนวณยอด วิธีรับเครดิต และประเภทเกมที่เข้าร่วมจากประกาศล่าสุดก่อนใช้สิทธิ์`,
  },
  {
    q: `${BRAND_NAME} ฝากถอนผ่านธนาคารและทรูมันนี่ได้หรือไม่?`,
    a: `เว็บไซต์ระบุว่ารองรับธนาคารและทรูมันนี่ โดยควรตรวจสอบรายชื่อบริการที่ใช้งานได้จริง ยอดขั้นต่ำ วงเงินถอน และชื่อบัญชีรับเงินก่อนทำรายการทุกครั้ง`,
  },
];

// ไม่มี breadcrumb: นี่คือหน้าแรก เส้นทางจาก root มาหาตัวเองจะเหลือครั้งเดียวที่ชี้ตัวเอง
// ทุก URL ในกราฟมาจาก pageGraph ที่ derive จาก site: — ไม่มีโดเมนพิมพ์ไว้ในไฟล์นี้
// ไม่มี URL ที่ต่อด้วย `+` และไม่ส่งโน้ด Review / AggregateRating / sameAs /
// address / email เข้าไปเลย
// `description` เป็นสตริงเดียวกับที่ MainLayout ได้รับ `name` เป็น H1 ของหน้า และ
// `faqs` เป็นอาร์เรย์ตัวเดียวกับที่ <Faq> ได้รับ
const graph = pageGraph(Astro, {
  name: pageH1,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxNeumorphism as="h1" title={pageH1}>
    <p>
      {BRAND_NAME} นำเสนอเกมสล็อตออนไลน์หลากหลายรูปแบบ
      <strong class="text-[#c2185b]">พร้อมข้อมูลค่ายเกม โปรโมชั่น และระบบบริการสมาชิกที่รวบรวมไว้ในเว็บไซต์เดียว</strong>
      ผู้ใช้งานสามารถศึกษากติกาเกม ตรวจสอบเงื่อนไขโบนัส และรายละเอียดฝากถอนก่อนใช้งานได้ ส่วนคำกล่าวอ้างเกี่ยวกับการเป็นเว็บตรงและเกมถูกลิขสิทธิ์
      <strong class="text-[#c2185b]">ควรตรวจสอบจากข้อมูลผู้พัฒนาและหลักฐานการได้รับอนุญาตที่เชื่อถือได้</strong>
      เพื่อประกอบการพิจารณาความน่าเชื่อถือของบริการ
    </p>
  </ContentBoxNeumorphism>

  <ContentBoxTwoNeumorphism as="h2" title={`${BRAND_NAME} โปรโมชั่น ฝากรับโบนัสได้ทั้งวัน ไม่ต้องทำเทิร์น`}>
    <p slot="left">
      {BRAND_NAME}
      <strong class="text-[#c2185b]">นำเสนอข้อมูลโปรโมชั่นที่ระบุว่าสามารถรับโบนัสจากการฝากเงินได้ตลอดวันโดยไม่ต้องทำเทิร์น</strong>
      ซึ่งผู้ใช้งานควรตรวจสอบรายละเอียดก่อนเข้าร่วมว่าโบนัสประเภทใดได้รับการยกเว้นข้อกำหนดยอดเดิมพัน
      <strong class="text-[#c2185b]">และมีเงื่อนไขเกี่ยวกับการถอนเงินหรือวงเงินโบนัสสูงสุดหรือไม่</strong>
    </p>
    <p slot="right">
      <strong class="text-[#c2185b]">นอกจากนี้ยังมีโปรโมชั่นคืนยอดเสียและแนะนำเพื่อนให้ตรวจสอบตามสิทธิ์ของสมาชิก</strong>
      โดยแต่ละรายการอาจมีหลักเกณฑ์แตกต่างกัน
      <strong class="text-[#c2185b]">จึงควรอ่านข้อกำหนดล่าสุดให้ครบถ้วน</strong>
    </p>
  </ContentBoxTwoNeumorphism>

  <ContentBoxSevenThreeNeumorphism as="h3" title="โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน">
    <p slot="left">
      โปรโมชั่นคืนยอดเสีย 0.3% เป็นรายการที่ระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขรายวัน
      <strong class="text-[#c2185b]">
        สมาชิกควรตรวจสอบว่าเกมสล็อตประเภทใดเข้าร่วมรายการ มีรอบสรุปยอดเวลาใด และต้องกดรับเครดิตด้วยตนเองหรือระบบดำเนินการให้อัตโนมัติ
      </strong>
      รวมถึงศึกษาข้อกำหนดการใช้เครดิตและการถอนเงินให้ครบถ้วน เพราะยอดเสียบางรายการอาจไม่เข้าเกณฑ์รับสิทธิ์ ทั้งนี้
      <strong class="text-[#c2185b]">เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งต่อไป</strong>
    </p>
    <Picture
      slot="right"
      src={promoCashback}
      loading="lazy"
      fetchpriority="low"
      widths={[172, 257, 343, 375]}
      sizes="(min-width: 1400px) 343px, (min-width: 768px) calc(30vw - 77px), (min-width: 473px) 375px, calc(100vw - 98px)"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={64}
      alt={`โปสเตอร์โปรโมชั่นของ ${BRAND_NAME} บนพื้นสตูดิโอสีขาวนวล ด้านหน้าเป็นผู้หญิงผมยาวสีน้ำตาลเข้ม ขยิบตาหนึ่งข้างและยิ้ม สวมคาร์ดิแกนถักสีชมพูอ่อนทับเสื้อกล้ามสีขาว มือขวาถือโทรศัพท์ที่จอแสดงตารางเกมสล็อตหกช่อง และใช้มือซ้ายชี้ไปที่จอ มุมบนซ้ายเป็นโลโก้ ${BRAND_NAME} ซึ่งเป็นลูกหมูการ์ตูนอ้วนกลมสีชมพูมีปีกนางฟ้าสีขาว คู่กับตัวอักษรบับเบิลชมพูสลับขาวที่มีหัวใจชมพูลอยประดับ ครึ่งล่างของภาพพิมพ์คำว่า โปรโมชั่น เป็นตัวอักษรบับเบิลชมพู-ขาวตัวโต ใต้ลงมาเป็นแคปซูลพื้นขาวขอบชมพูเขียนว่า คืนยอดเสีย แล้วตามด้วยเลข 0.3% ตัวบับเบิลตัวโต มีหัวใจชมพูทั้งแบบทึบและแบบเส้นขอบลอยรอบข้อความ และมีลูกหมูมีปีกตัวเล็กยืนอยู่ริมภาพด้านล่าง`}
      class="mx-auto h-auto w-full max-w-[375px] rounded-2xl border border-[#f7bcd9] shadow-[0_10px_24px_rgba(194,24,91,0.18)]"
    />
  </ContentBoxSevenThreeNeumorphism>

  <ContentBoxSevenThree as="h3" title="โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด">
    <p slot="left">
      โปรโมชั่นแนะนำเพื่อนโบนัส 0.8% เป็นรายการที่ระบุสิทธิ์สำหรับสมาชิกที่แนะนำผู้ใช้งานรายใหม่
      <strong class="text-[#c2185b]">โดยควรตรวจสอบวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และฐานยอดที่ใช้คำนวณโบนัสให้ชัดเจน</strong>
      แม้จะมีข้อความว่าไม่จำกัด แต่ควรยืนยันจำนวนบัญชีที่เข้าร่วมได้ รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุด
      <strong class="text-[#c2185b]">เพื่อป้องกันความเข้าใจคลาดเคลื่อนเกี่ยวกับจำนวนเครดิตที่มีสิทธิ์ได้รับ</strong>
    </p>
    <Picture
      slot="right"
      src={promoReferral}
      loading="lazy"
      fetchpriority="low"
      widths={[157, 236, 314, 375]}
      sizes="(min-width: 1280px) 314px, (min-width: 768px) calc(30vw - 70px), (min-width: 473px) 375px, calc(100vw - 98px)"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={64}
      alt={`โปสเตอร์โปรโมชั่นของ ${BRAND_NAME} บนพื้นสตูดิโอสีขาวนวล ด้านหน้าเป็นผู้หญิงผมยาวสีน้ำตาลเข้มคนเดิม ติดโบว์ชมพูที่ผมและขยิบตาหนึ่งข้าง สวมคาร์ดิแกนถักสีชมพูอ่อนทับเสื้อกล้ามสีขาว ยกโทรศัพท์ขึ้นด้วยมือซ้ายให้เห็นตารางเกมสล็อตหกช่องบนจอ และชี้นิ้วไปที่จอด้วยมือขวา มุมบนซ้ายเป็นโลโก้ ${BRAND_NAME} ซึ่งเป็นลูกหมูการ์ตูนอ้วนกลมสีชมพูมีปีกนางฟ้าสีขาว คู่กับตัวอักษรบับเบิลชมพูสลับขาวที่มีหัวใจชมพูลอยประดับ ครึ่งล่างของภาพพิมพ์คำว่า โปรโมชั่น เป็นตัวอักษรบับเบิลชมพู-ขาวตัวโต ใต้ลงมาเป็นแคปซูลพื้นขาวขอบชมพูเขียนว่า แนะนำเพื่อน แล้วตามด้วยเลข 0.8% ตัวบับเบิลตัวโต มีหัวใจชมพูลอยรอบข้อความ และมีลูกหมูมีปีกตัวเล็กยืนอยู่ริมภาพด้านล่าง`}
      class="mx-auto h-auto w-full max-w-[375px] rounded-2xl border border-[#f7bcd9] shadow-[0_10px_24px_rgba(194,24,91,0.16)]"
    />
  </ContentBoxSevenThree>

  <ContentBox as="h2" title={`สมัครเล่นสล็อต ${BRAND_NAME} ง่ายๆ 3 ขั้นตอน`}>
    <p>
      {BRAND_NAME} มีช่องทางสำหรับผู้ที่ต้องการศึกษาวิธีสมัครสมาชิกและเข้าสู่ระบบเกมสล็อตออนไลน์
      <strong class="text-[#c2185b]">โดยขั้นตอนทั่วไปประกอบด้วยการเข้าสู่หน้าสมัคร กรอกข้อมูล และยืนยันบัญชี</strong>
      ก่อนดำเนินการควรตรวจสอบคุณสมบัติผู้สมัคร ข้อกำหนดด้านอายุ และกฎหมายที่เกี่ยวข้อง
      <strong class="text-[#c2185b]">รวมถึงศึกษานโยบายความเป็นส่วนตัวเพื่อทำความเข้าใจวิธีจัดเก็บข้อมูลส่วนบุคคล</strong>
    </p>
  </ContentBox>

  <FeatureHighlights items={registerSteps} />

  <ContentBox3ThreeNeumorphism as="h2" title={`ระบบฝากถอน ${BRAND_NAME} ได้ทุกธนาคารและทรูมันนี่`}>
    <p slot="left">
      {BRAND_NAME}
      <strong class="text-[#c2185b]">ระบุช่องทางฝากถอนผ่านธนาคารและทรูมันนี่</strong>
      พร้อมข้อมูลเกี่ยวกับการทำรายการที่ผู้ใช้งานควรตรวจสอบก่อนใช้บริการ
    </p>
    <p slot="center">
      แม้จะมีข้อความระบุว่าฝากถอนไม่มีขั้นต่ำและไม่จำกัดยอด
      <strong class="text-[#c2185b]">แต่ควรศึกษาข้อกำหนดจริงเกี่ยวกับวงเงินต่อรายการ จำนวนครั้งในการถอน และขั้นตอนการยืนยันตัวตนให้ครบถ้วน</strong>
    </p>
    <p slot="right">
      <strong class="text-[#c2185b]">ก่อนโอนเงินควรตรวจสอบชื่อบัญชีปลายทางให้ตรงกับข้อมูลผู้ให้บริการที่ยืนยันได้</strong>
      หากพบความผิดปกติควรหยุดทำธุรกรรมและติดต่อธนาคารหรือผู้ให้บริการชำระเงินโดยเร็ว
    </p>
  </ContentBox3ThreeNeumorphism>

  <LatestWinners />

