---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import Faq from "../components/Faq3.astro";
import LatestWinners from "../components/LatestWinners4.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// IMAGE ROLES FOR THIS DROP (2026-09-23) — READ BEFORE REUSING THESE IMPORTS.
// Two files are referenced from this page and only two, both slides, both spent
// on a ContentBoxSevenThree* block — which is the family's hard cap of two per
// rebrand, so there is no third SevenThree here:
//   slide1.png — gold promo artwork reading "โปรโมชั่น แนะนำเพื่อน" over a giant
//     "0.8%", so it belongs to docx H3 #4 (แนะนำเพื่อน โบนัส 0.8%).
//   slide2.png — the same artwork reading "โปรโมชั่น คืนยอดเสีย" over "0.3%",
//     so it belongs to docx H3 #5 (คืนยอดเสีย โบนัส 0.3%).
// Both files are 600x333, so 600 is the top candidate width — nothing above it
// would be a real pixel. The alt text was written from the current artwork (gold
// coins, the two models in white-and-gold, the SA-gold / GAME-chrome / 66-gold
// logo), not carried over from the previous brand's red banners.
//
// Deliberately NOT imported, and all still on disk as inventory:
//   banner2.png (2026-09-22), banner3.png (2026-08-11), slide3.png
//   (2026-09-18), slide4.png (2026-08-13) — every one predates this drop and
//   carries a previous client's artwork. There is therefore NO usable banner2+
//   this round and NO single-column inline illustration, which is the expected
//   outcome, not a gap to fill with a stale file.
//   banner1.png and banner1-mobile.png belong to MainLayout's own pinned globs
//   and are never referenced from a page — the hero is the LCP element, so
//   nothing here gets loading="eager" fetchpriority="high".
//
// Rotated out of this round's mix and NOT deleted from disk (they are inventory
// for the next brand): Announcement3, ContentBoxPremium, ContentBoxCyberCut,
// ContentBoxSevenThreePremium, ContentBoxSevenThreeCyberCut, ContentBoxTwoPremium,
// Faq2, LatestWinners2 — and LottoGrid, which stays out for a reason rather than
// a rotation: the SAGAME66 brief is live casino / baccarat / roulette and never
// mentions lottery, so that grid would claim a category the brief does not have.
// The file stays on disk for the next lottery client.

// Title and description are the brief's own Title/Description lines, used
// verbatim. A brief-supplied description is never padded up to the 150-char
// floor and never topped up from the H1/H2 — this one is 133 characters.
const pageTitle = "SAGAME66 เว็บบาคาร่า รูเล็ต คาสิโน รวมครบทุกค่ายแท้";

const pageDescription = "SAGAME66 เว็บบาคาร่า รูเล็ต คาสิโน แหล่งรวมเกมเดิมพัน ค่ายมาตรฐานสากล ฝากถอนได้ทุกยอด ไม่มีขั้นต่ำ ครบทุกค่ายแท้ ไม่มีขีดจำกัดการเล่น";

// <Announcement /> runs bare: Announcement5's default message is already this
// brand's copy, and every sub-page calls it bare too — passing an override here
// is how the ticker ends up saying two different things on two pages.

// The docx has a real H1 -> H2 -> H3 hierarchy this round: "แนะนำเพื่อน โบนัส
// 0.8%" and "คืนยอดเสีย โบนัส 0.3%" are genuine H3 sub-points of the H2
// โปรโมชั่น section, so the page is NOT flattened to H2-only. They are the only
// <h3> here and they are carried by the two ContentBoxSevenThree* blocks.
// Everything else is chrome — ProviderGrid, LatestWinners4, LoginRtpSection and
// ReviewCardSumo2 all render their titles as <p>/<span> with an aria-label on
// the section, and Faq3's questions stay <p> inside <summary>, so none of them
// emits a heading tag.
//
// The docx checklist, in order, and what carries each one:
//   1 H1  SAGAME66 เว็บบาคาร่า รูเล็ต คาสิโน …        ContentBoxNeumorphism
//   2 H2  SAGAME66 แหล่งรวมเกมเดิมพัน ค่ายมาตรฐาน …    ContentBoxSpecial (+ ProviderGrid)
//   3 H2  โปรโมชั่นสูง กดรับหลังสมัคร SAGAME66 …       ContentBox
//   4 H3  แนะนำเพื่อน โบนัส 0.8%                      ContentBoxSevenThreeFloatingBadge + slide1
//   5 H3  คืนยอดเสีย โบนัส 0.3%                       ContentBoxSevenThreeNeumorphism  + slide2
//   6 H2  สมัคร SAGAME66 ด้วย 3 ขั้นตอนง่ายๆ บนมือถือ   ContentBoxFloatingBadge (+ <ol> ของ 3 ขั้นตอน)
//   7 H2  แอดมิน SAGAME66 ดูแลสมาชิกตลอด 24 ชั่วโมง    ContentBoxTwoNeumorphism
//   8 H2  คำถามที่พบบ่อย                              Faq3
// Final inventory for this page: h1 x1, h2 x5, h3 x2.
//
// ContentBoxSevenThreeFloatingBadge is passed `title` only (the floating badge)
// and ContentBoxTwoNeumorphism is passed `title` only — their titleleft/titleright
// props emit HeadingTag too, so passing them here would put three <h3>/<h2> on
// one section. ContentBoxSevenThreeNeumorphism has no badge, so its `title`
// falls through to the right column's single heading.

// One array, used by both <Faq> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last. The three pairs
// are the brief's own Q/A block, verbatim.
const faqs = [
  {
    q: "SAGAME66 มีเกมประเภทไหนให้เลือกบ้าง?",
    a: "ภายในระบบมีทั้งบาคาร่า รูเล็ต คาสิโนสด และเกมเดิมพันประเภทอื่นตามรายการที่เปิดให้บริการ ผู้ใช้งานสามารถตรวจสอบค่ายเกมและรายละเอียดของแต่ละเกมได้จากหน้ารวมเกมก่อนเลือกเข้าเล่น",
  },
  {
    q: "โปรโมชั่น SAGAME66 สมัครแล้วกดรับได้เลยหรือไม่?",
    a: "โปรโมชั่นบางรายการสามารถกดรับหลังสมัครได้ตามเงื่อนไขที่กำหนดโดยไม่ต้องทำรายการฝากก่อน ส่วนสิทธิ์อื่นอาจมีข้อกำหนดเพิ่มเติม ควรตรวจสอบรายละเอียดของแต่ละโปรโมชั่นก่อนกดรับทุกครั้ง",
  },
  {
    q: "สมัคร SAGAME66 ผ่านมือถือได้หรือไม่?",
    a: "สามารถสมัครผ่านมือถือได้โดยกรอกข้อมูล ตรวจสอบความถูกต้อง และยืนยันบัญชี เมื่อสมัครเสร็จสามารถเข้าสู่ระบบเพื่อเลือกบาคาร่า รูเล็ต คาสิโน หรือเกมอื่นที่เปิดให้บริการได้จากหน้าเว็บไซต์",
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// Two highlight colours, matching the logo and both slides: the chrome silver
// (#eef3f8) marks a claim the brief states outright, and the bright gold
// (#ffe9a3) is reserved for the two bonus figures, which is exactly how slide1
// and slide2 print them.

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb. Every URL in the graph is derived
// by pageGraph from `site:` — no domain is typed out in this file.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxNeumorphism as="h1" title="SAGAME66 เว็บบาคาร่า รูเล็ต คาสิโน รวมครบทุกค่ายแท้">
    <p class="text-left text-base leading-relaxed text-[#e3d8c0]">
      SAGAME66
      <strong class="text-[#eef3f8]">เว็บรวมเกมคาสิโนที่มีทั้งบาคาร่า รูเล็ต และเกมโต๊ะยอดนิยมจากหลายค่ายให้เลือกในระบบเดียว</strong>
      <strong class="text-[#eef3f8]">รองรับการใช้งานผ่านมือถือและคอมพิวเตอร์</strong>
      เมนูจัดหมวดหมู่ชัดเจน ช่วยให้ผู้ใช้งานค้นหาเกมที่ต้องการได้ง่าย
      <strong class="text-[#eef3f8]">พร้อมตัวเลือกการเดิมพันหลายระดับตามเงื่อนไขของแต่ละเกม</strong>
    </p>
  </ContentBoxNeumorphism>

  <ContentBoxSpecial as="h2" title="SAGAME66 แหล่งรวมเกมเดิมพัน ค่ายมาตรฐานสากล 2026" iconleft="🃏" iconright="🔎">
    <p slot="left" class="text-left text-base leading-relaxed text-[#e3d8c0]">
      SAGAME66
      <strong class="text-[#eef3f8]">รวมเกมเดิมพันจากหลายค่ายที่มีรูปแบบการเล่นแตกต่างกัน</strong>
      <strong class="text-[#eef3f8]">ทั้งบาคาร่า รูเล็ต คาสิโนสด และเกมยอดนิยมอื่น ๆ ภายในปี 2026</strong>
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#e3d8c0]">
      <strong class="text-[#eef3f8]">ระบบจัดหน้าเกมให้ค้นหาได้ง่าย</strong>
      <strong class="text-[#eef3f8]">สามารถตรวจสอบชื่อค่าย รายละเอียดเกม และระดับเดิมพันก่อนเข้าเล่น</strong>
      ช่วยให้เลือกเกมที่ตรงกับสไตล์ของตัวเองได้สะดวกขึ้น
    </p>
  </ContentBoxSpecial>

  <ProviderGrid />

  <ContentBox as="h2" title="โปรโมชั่นสูง กดรับหลังสมัคร SAGAME66 ฝากไม่จำเป็น">
    <p class="text-left text-base leading-relaxed text-[#e3d8c0]">
      โปรโมชั่น SAGAME66
      <strong class="text-[#eef3f8]">มีสิทธิ์ให้สมาชิกเลือกหลายรูปแบบตามเงื่อนไขของแต่ละรายการ</strong>
      <strong class="text-[#eef3f8]">โดยบางโปรโมชั่นสามารถตรวจสอบและกดรับหลังสมัครได้โดยไม่ต้องทำรายการฝากก่อน</strong>
      พร้อมสิทธิ์แนะนำเพื่อนและคืนยอดเสีย ซึ่งมีรายละเอียดให้ตรวจสอบก่อนกดรับจากหน้าโปรโมชั่นโดยตรง
    </p>
  </ContentBox>

  <ContentBoxSevenThreeFloatingBadge as="h3" title="แนะนำเพื่อน โบนัส 0.8%">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[340, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), 353px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่นพื้นทองเข้มโรยด้วยเหรียญทอง ด้านซ้ายเป็นหญิงสาวผมยาวสีเข้มสวมชุดขาว-ทองที่มีคำว่า SAGAME66 กำลังชี้นิ้วทั้งสองข้างเข้าหาข้อความ ด้านขวาเป็นชายหนุ่มผมสั้นสีเข้มสวมเสื้อกีฬาขาว-ทองที่มีคำว่า SAGAME66 ยืนกอดอก ด้านบนเป็นโลโก้ SAGAME66 ตัวอักษร SA สีทองสามมิติ GAME สีเงินโครเมียม และเลข 66 สีทอง ถัดลงมาเป็นข้อความสีขาวว่า โปรโมชั่น และ แนะนำเพื่อน ล่างสุดเป็นตัวเลขสีเงินโครเมียมขนาดใหญ่ว่า 0.8% รอบภาพมีไพ่เอซโพดำ ลูกฟุตบอลสีทอง และกองชิปคาสิโน"
      class="mx-auto h-auto w-full rounded-2xl border border-[#96671a]/55 shadow-[0_10px_30px_rgba(232,185,63,0.35)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#e3d8c0]">
      สมาชิก SAGAME66
      <strong class="text-[#eef3f8]">ที่แนะนำเพื่อนเข้ามาสมัครสามารถรับโบนัส</strong>
      <strong class="text-[#ffe9a3]">0.8%</strong>
      <strong class="text-[#eef3f8]">ตามเงื่อนไขของโปรโมชั่น</strong>
      ระบบจะแสดงรายละเอียดของยอดที่เข้าเกณฑ์และขั้นตอนรับสิทธิ์ให้ตรวจสอบ ช่วยให้ติดตามโบนัสจากกิจกรรมแนะนำเพื่อนได้สะดวกผ่านบัญชีสมาชิก
    </p>
  </ContentBoxSevenThreeFloatingBadge>

  <ContentBoxSevenThreeNeumorphism as="h3" title="คืนยอดเสีย โบนัส 0.3%">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[340, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), 391px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่นพื้นทองเข้มมีกองเหรียญทองและชิปคาสิโนวางซ้อนกันด้านล่าง ด้านซ้ายเป็นหญิงสาวผมยาวสีเข้มสวมชุดขาว-ทองที่มีคำว่า SAGAME66 กำลังชี้นิ้วทั้งสองข้าง ด้านขวาเป็นชายหนุ่มผมสั้นสีเข้มสวมเสื้อกีฬาขาว-ทองที่มีคำว่า SAGAME66 ยืนกอดอกข้างลูกฟุตบอลสีทอง ด้านบนเป็นโลโก้ SAGAME66 ตัวอักษร SA สีทองสามมิติ GAME สีเงินโครเมียม และเลข 66 สีทอง ถัดลงมาเป็นข้อความสีขาวว่า โปรโมชั่น และ คืนยอดเสีย ล่างสุดเป็นตัวเลขสีเงินโครเมียมขนาดใหญ่ว่า 0.3%"
      class="mx-auto h-auto w-full rounded-2xl border border-[#96671a]/55 shadow-[0_10px_30px_rgba(232,185,63,0.35)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#e3d8c0]">
      โปรโมชั่นคืนยอดเสียของ SAGAME66
      <strong class="text-[#eef3f8]">ให้โบนัส</strong>
      <strong class="text-[#ffe9a3]">0.3%</strong>
      <strong class="text-[#eef3f8]">ตามยอดและเงื่อนไขที่กำหนด</strong>
      สมาชิกสามารถตรวจสอบรอบคำนวณ ยอดที่เข้าเกณฑ์ และรายละเอียดก่อนกดรับสิทธิ์ได้ ช่วยให้ติดตามโบนัสในแต่ละรอบได้ชัดเจนและจัดการสิทธิ์ของตัวเองได้ง่ายขึ้น
    </p>
  </ContentBoxSevenThreeNeumorphism>

  <ContentBoxFloatingBadge as="h2" title="สมัคร SAGAME66 ด้วย 3 ขั้นตอนง่ายๆ บนมือถือ">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed text-[#e3d8c0]">
        การสมัคร SAGAME66
        <strong class="text-[#eef3f8]">สามารถทำผ่านมือถือได้ด้วยตัวเอง</strong>
        <strong class="text-[#eef3f8]">ขั้นตอนถูกจัดไว้ให้เข้าใจง่าย</strong>
        และหลังจากยืนยันบัญชีเรียบร้อยก็สามารถเข้าสู่ระบบเพื่อเลือกบาคาร่า รูเล็ต หรือคาสิโนที่ต้องการได้ทันที โดยมี 3 ขั้นตอนหลักดังนี้
      </p>
      <ol class="list-decimal space-y-2 pl-6 text-left text-base leading-relaxed text-[#e3d8c0] marker:font-black marker:text-[#e8b93f]">
        <li>เปิดหน้าสมัคร SAGAME66 บนมือถือ แล้วกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน</li>
        <li>ตรวจสอบข้อมูลและรายละเอียดบัญชีให้ถูกต้องก่อนกดยืนยัน</li>
        <li>ยืนยันการสมัครและเข้าสู่ระบบ จากนั้นเลือกบาคาร่า รูเล็ต คาสิโน หรือเกมที่ต้องการได้ทันที</li>
      </ol>
    </div>
  </ContentBoxFloatingBadge>

  <ContentBoxTwoNeumorphism as="h2" title="แอดมิน SAGAME66 ดูแลสมาชิกตลอด 24 ชั่วโมง">
    <p slot="left" class="text-left text-base leading-relaxed text-[#e3d8c0]">
      หากมีข้อสงสัยเกี่ยวกับการสมัคร โปรโมชั่น ทางเข้าเกม บาคาร่า รูเล็ต หรือการใช้งานบัญชี
      <strong class="text-[#eef3f8]">สามารถติดต่อแอดมิน SAGAME66 ได้ตลอด 24 ชั่วโมง</strong>
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#e3d8c0]">
      <strong class="text-[#eef3f8]">ทีมงานพร้อมช่วยตรวจสอบข้อมูลและแนะนำขั้นตอนตามปัญหาที่แจ้ง</strong>
      เพื่อให้สมาชิกใหม่และสมาชิกเดิมเข้าถึงข้อมูลได้สะดวกในทุกช่วงเวลา
    </p>
  </ContentBoxTwoNeumorphism>

  <Faq as="h2" title="คำถามที่พบบ่อย" faqs={faqs} />

  <LatestWinners />

  <LoginRtpSection />

  <ReviewCardSumo />

  <Navfoot />
</MainLayout>
