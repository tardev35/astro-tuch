---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ProviderGridPremium from "../components/ProviderGridPremium.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import Faq from "../components/Faq.astro";
import LatestWinners from "../components/LatestWinners4.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// Title and description are the brief's own Title/Description lines, used
// verbatim. A brief-supplied description is never padded up to the 150-char
// floor and never topped up from the H1/H2.
const pageTitle = "LUCKY88 สล็อตเครดิตฟรี จ่ายไม่อั้น ถอนได้สูง สมัครเล่นรับได้ทุกยูส";

const pageDescription = "LUCKY88 สล็อตเครดิตฟรี จ่ายไม่อั้น ถอนได้สูง ไม่จำกัดยอด สมาชิกรับ 0.8% ได้ทุกครั้งที่แชร์ลิ้งก์ แอดมินดูแลระบบหลังบ้าน 24 ชั่วโมง";

// The ticker copy is passed explicitly rather than relying on the component's
// default — every Announcement* variant's default belongs to whichever brand
// wired it in last. No emoji in this string: an emoji baked into a text prop
// cannot be given its own aria-hidden span, and this marquee prints the string
// twice.
const announcement =
  "LUCKY88 รวมเกมสล็อตออนไลน์จากหลากหลายค่ายไว้ในระบบเดียว • รองรับการเล่นบนมือถือ แท็บเล็ต และคอมพิวเตอร์ • มีทั้งสล็อตเบทต่ำ เกมฟรีสปิน เกมโบนัส และสล็อตแจ็กพอต • วงเงินถอนสูงสุดและจำนวนครั้งให้ยึดเงื่อนไขล่าสุดที่แสดงในหน้าฝากถอนเป็นหลัก • โปรโมชั่นแนะนำเพื่อนรับโบนัส 0.8% ทุกครั้งที่แชร์ลิงก์ตามข้อกำหนด • โปรโมชั่นคืนยอดเสียรับโบนัส 0.3% ตามรอบที่กำหนด • สมัคร LUCKY88 บนมือถือได้ด้วยตัวเองใน 3 ขั้นตอน • แอดมิน LUCKY88 ดูแลปัญหาระบบหลังบ้านตลอด 24 ชั่วโมง";

// One array, used by both <Faq> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last.
const faqs = [
  {
    q: "LUCKY88 เครดิตฟรีสามารถถอนได้เลยหรือไม่?",
    a: "ขึ้นอยู่กับเงื่อนไขของเครดิตฟรีหรือโบนัสแต่ละรายการ บางโปรโมชั่นอาจกำหนดยอดเดิมพันหรือข้อกำหนดก่อนถอน สมาชิกควรตรวจสอบรายละเอียดที่แสดงในหน้าโปรโมชั่นก่อนกดรับสิทธิ์",
  },
  {
    q: "โบนัสแนะนำเพื่อน LUCKY88 0.8% รับอย่างไร?",
    a: "สมาชิกแชร์ลิงก์แนะนำให้เพื่อนสมัคร และเมื่อรายการของผู้ถูกแนะนำตรงตามข้อกำหนด ระบบจะคำนวณโบนัส 0.8% ตามเงื่อนไข สามารถตรวจสอบยอดและสถานะโบนัสผ่านบัญชีสมาชิกได้",
  },
  {
    q: "หากฝากถอน LUCKY88 แล้วรายการไม่เข้าต้องทำอย่างไร?",
    a: "ตรวจสอบสถานะธุรกรรมในบัญชีก่อน หากเครดิตยังไม่เข้าหรือรายการถอนยังค้าง สามารถติดต่อแอดมิน LUCKY88 พร้อมแจ้งจำนวนเงิน เวลา และรายละเอียดรายการ เพื่อให้ทีมงานช่วยตรวจสอบได้ตลอด 24 ชั่วโมง",
  },
];

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb. Every URL in the graph is derived
// by pageGraph from `site:` — no domain is typed out in this file.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <ContentBoxCyberCut as="h1" title="LUCKY88 สล็อตเครดิตฟรี เว็บแท้ รวมค่ายชั้นนำ แบรนด์ดัง ครบ">
    <p class="text-left text-base leading-relaxed text-[#e8dadb]">
      <strong class="text-[#ff3b4d]">LUCKY88</strong> รวมเกมสล็อตออนไลน์จากหลากหลายค่ายไว้ให้สมาชิกเลือกผ่านระบบเดียว รองรับการเล่นบนมือถือ แท็บเล็ต และคอมพิวเตอร์ พร้อมโปรโมชั่นสำหรับสมาชิกทั้งโบนัสแนะนำเพื่อน
      <span class="font-black text-[#cfd4da]">0.8%</span> และคืนยอดเสีย <span class="font-black text-[#cfd4da]">0.3%</span> ตามเงื่อนไข สามารถสมัคร ตรวจสอบโปรโมชั่น ฝากถอน และเลือกเกมสล็อตได้จากบัญชีสมาชิก
      พร้อมมีแอดมินคอยดูแลปัญหาการใช้งานระบบหลังบ้านตลอด 24 ชั่วโมง
    </p>
  </ContentBoxCyberCut>

  <ProviderGridPremium />

  <ContentBoxNeumorphism as="h2" title="สล็อต LUCKY88 จ่ายไม่อั้น ถอนได้สูง ไม่จำกัดยอด">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e8dadb]">
        <strong class="text-[#ff3b4d]">LUCKY88</strong> มีเกมสล็อตหลายรูปแบบให้เลือก ทั้งสล็อตเบทต่ำ เกมฟรีสปิน เกมโบนัส สล็อตแจ็กพอต และเกมจากค่ายต่าง ๆ สมาชิกสามารถตรวจสอบช่วงเดิมพัน อัตราจ่าย Paytable
        และรายละเอียดฟีเจอร์ของแต่ละเกมก่อนเริ่มเล่น พร้อมจัดการเครดิตและส่งคำขอถอนผ่านระบบสมาชิกได้ด้วยตนเอง
      </p>
      <p class="text-left text-base leading-relaxed text-[#e8dadb]">
        สำหรับวงเงินถอนสูงสุด จำนวนครั้งในการถอน และข้อความว่าไม่จำกัดยอด ควรยึดเงื่อนไขล่าสุดที่แสดงในหน้าฝากถอนเป็นหลัก เนื่องจากวงเงินอาจแตกต่างกันตามช่องทางหรือข้อกำหนดของระบบ
        และเกมสล็อตไม่สามารถรับประกันผลกำไรหรือรางวัลได้
      </p>
    </div>
  </ContentBoxNeumorphism>

  <ContentBox as="h2" title="โปรสมาชิก LUCKY88 รับ 0.8% ได้ทุกครั้งที่แชร์">
    <p class="text-left text-base leading-relaxed text-[#e8dadb]">
      สมาชิกสามารถ Login <strong class="text-[#ff3b4d]">LUCKY88</strong> เพื่อตรวจสอบโปรโมชั่นที่บัญชีมีสิทธิ์รับ โดยมีทั้งโบนัสจากการแนะนำเพื่อนและโปรโมชั่นคืนยอดเสีย สมาชิกที่ต้องการใช้สิทธิ์ควรอ่านรายละเอียดเกี่ยวกับยอดที่นำมาคำนวณ
      รอบการรับ และข้อกำหนดของโบนัสก่อนกดรับทุกครั้ง
    </p>
  </ContentBox>

  <ContentBoxSevenThreeCyberCut as="h3" title="โปรโมชั่นแนะนำเพื่อน รับโบนัส 0.8%">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 28vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อนของ LUCKY88 พื้นหลังสีดำมีแสงสีแดงเป็นเส้นโค้งและชิปคาสิโนสีแดงกระจายอยู่ ด้านบนซ้ายเป็นโลโก้ตัวอักษร LUCKY88 สีแดงเงาสลับเงินโครเมียม ถัดลงมาเป็นข้อความสีขาวว่า โปรโมชั่น และคำว่า แนะนำเพื่อน สีแดง ใต้ลงมาเป็นตัวเลขสีแดงขนาดใหญ่ 0.8% ในกรอบสีดำขอบเงิน ด้านขวาเป็นนางแบบผมบลอนด์ยาวในชุดหนังสีดำแดงกำลังชี้นิ้วมาที่ตัวเลข ฉากหลังมีวงล้อรูเล็ต ไพ่เอซ และลูกเต๋าสีแดง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#c1121f]/55 shadow-[0_10px_30px_rgba(224,26,43,0.26)]"
    />
    <div slot="right" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e8dadb]">
        สมาชิกสามารถนำลิงก์แนะนำส่วนตัวไปแชร์ให้เพื่อน เมื่อเพื่อนสมัครและมียอดการใช้งานตรงตามข้อกำหนด ระบบจะคำนวณโบนัสแนะนำเพื่อน <span class="font-black text-[#ff3b4d]">0.8%</span> ตามเงื่อนไข สามารถตรวจสอบจำนวนเพื่อน
        ยอดที่เข้าเกณฑ์ และโบนัสที่มีสิทธิ์รับได้จากบัญชีสมาชิก
      </p>
      <p class="text-left text-base leading-relaxed text-[#e8dadb]">
        การแชร์ลิงก์เพียงอย่างเดียวอาจยังไม่ทำให้ได้รับโบนัส หากโปรโมชั่นกำหนดให้ผู้ถูกแนะนำต้องสมัคร ฝากเงิน หรือมียอดเล่นตามเกณฑ์ จึงควรตรวจสอบเงื่อนไขล่าสุดก่อนแชร์ทุกครั้ง
      </p>
    </div>
  </ContentBoxSevenThreeCyberCut>

  <ContentBoxSevenThreeCyberCut as="h3" title="โปรโมชั่นคืนยอดเสีย รับโบนัส 0.3%">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 28vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นคืนยอดเสียของ LUCKY88 พื้นหลังสีดำมีวงแสงสีแดงเรืองและชิปคาสิโนสีแดงลอยอยู่ ด้านบนเป็นโลโก้ตัวอักษร LUCKY88 สีแดงสลับเงินโครเมียม ถัดลงมาเป็นข้อความสีขาวว่า โปรโมชั่น และคำว่า คืนยอดเสีย ในกรอบสีดำขอบเงิน ใต้ลงมาเป็นตัวเลขสีแดงขนาดใหญ่ 0.3% ด้านขวาเป็นนางแบบผมบลอนด์ยาวในชุดรัดรูปสีดำแดงกำลังชี้นิ้วมาที่ตัวเลข ฉากหลังซ้ายเป็นวงล้อรูเล็ต สล็อต 777 และไพ่เอซ"
      class="mx-auto h-auto w-full rounded-2xl border border-[#c1121f]/55 shadow-[0_10px_30px_rgba(224,26,43,0.26)]"
    />
    <div slot="right" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e8dadb]">
        สมาชิกที่มียอดเสียตรงตามข้อกำหนดสามารถตรวจสอบสิทธิ์รับโบนัสคืนยอดเสีย <span class="font-black text-[#ff3b4d]">0.3%</span> ตามรอบที่ <strong class="text-[#ff3b4d]">LUCKY88</strong> กำหนด ระบบจะแสดงยอดที่ใช้คำนวณและโบนัสที่สามารถกดรับได้
      </p>
      <p class="text-left text-base leading-relaxed text-[#e8dadb]">
        ก่อนรับสิทธิ์ควรตรวจสอบประเภทเกมสล็อต รอบคำนวณ และข้อกำหนดเกี่ยวกับการถอนโบนัสให้ครบถ้วน เพราะแต่ละรอบอาจมีเงื่อนไขต่างจากครั้งก่อนหน้า
      </p>
    </div>
  </ContentBoxSevenThreeCyberCut>

  <ContentBoxCyberCut as="h2" title="สมัคร LUCKY88 บนมือถือ 3 ขั้นตอน">
    <div class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e8dadb]">
      <p>
        เริ่มต้นสมัคร <strong class="text-[#ff3b4d]">LUCKY88</strong> ผ่านมือถือได้ด้วยขั้นตอนที่ไม่ซับซ้อน ระบบรองรับการใช้งานผ่านเว็บเบราว์เซอร์โดยตรงทั้งบน Android และ iOS
      </p>
      <ol class="list-decimal space-y-2 pl-5 marker:font-black marker:text-[#ff3b4d]">
        <li>เปิดหน้าสมัครสมาชิก LUCKY88 และกรอกข้อมูลที่ระบบกำหนด</li>
        <li>Login เข้าบัญชี ตรวจสอบโปรโมชั่น และฝากเครดิตผ่านช่องทางที่รองรับ</li>
        <li>เลือกค่ายเกมสล็อต อ่านกติกาและรายละเอียดก่อนเริ่มเดิมพัน</li>
      </ol>
      <p>หลังสมัครเรียบร้อยสามารถตรวจสอบเครดิต โปรโมชั่น ประวัติการทำรายการ และสถานะฝากถอนผ่านบัญชีของตนเองได้ ควรตั้งรหัสผ่านที่คาดเดายากและไม่เปิดเผย OTP หรือรหัสผ่านให้บุคคลอื่น</p>
    </div>
  </ContentBoxCyberCut>

  <LoginRtpSection />

  <ContentBoxTwoCyberCut as="h2" title="แอดมิน LUCKY88 ให้บริการออนไลน์ 24 ชั่วโมง">
    <p slot="left" class="text-left text-base leading-relaxed text-[#e8dadb]">
      หากพบปัญหาเกี่ยวกับการสมัคร Login ไม่ได้ เครดิตฝากไม่เข้า ถอนเงินค้าง โปรโมชั่นไม่แสดง หรือเข้าเกมสล็อตไม่ได้ สามารถติดต่อแอดมิน <strong class="text-[#ff3b4d]">LUCKY88</strong>
      ได้ตลอด 24 ชั่วโมง พร้อมแจ้งเวลา จำนวนเงิน และรายละเอียดของรายการ เพื่อช่วยให้เจ้าหน้าที่ตรวจสอบปัญหาในระบบหลังบ้านได้ตรงจุด
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#e8dadb]">
      สมาชิกใหม่ยังสามารถสอบถามขั้นตอนฝากถอน วิธีตรวจสอบโปรโมชั่น หรือการใช้งานส่วนต่าง ๆ ของเว็บไซต์ได้ หากเป็นเรื่องธุรกรรมควรเก็บหลักฐานรายการไว้จนกว่าการตรวจสอบจะเสร็จสิ้น
    </p>
  </ContentBoxTwoCyberCut>

  <Faq title="คำถามที่พบบ่อยเกี่ยวกับ LUCKY88" faqs={faqs} />

  <LatestWinners />

  <ReviewCardSumo />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#ff3b4d] via-[#e01a2b] to-[#8e0407] px-4 py-3 text-sm font-black whitespace-nowrap text-[#f4f6f8] shadow-[0_10px_30px_rgba(224,26,43,0.32)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(224,26,43,0.46)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#7a1219]/90 bg-gradient-to-r from-[#3b0303] to-[#040202] px-4 py-3 text-sm font-black whitespace-nowrap text-[#cfd4da] shadow-[0_10px_30px_rgba(207,212,218,0.16)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#e01a2b]/80 hover:text-[#ff3b4d] hover:shadow-[0_15px_40px_rgba(224,26,43,0.32)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>
  </div>

  <Navfoot />
</MainLayout>
