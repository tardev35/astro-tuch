---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LatestWinnersCyber from "../components/LatestWinnersCyber.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

const pageTitle = "ZORO365 คาสิโนออนไลน์อัตราจ่ายสูง แนะนำเพื่อนรับโบนัส 0.8% ทุกวัน";

const pageDescription =
  "ZORO365 คาสิโนออนไลน์ รวมเกมจากค่ายชั้นนำ อัตราจ่ายน่าสนใจ โปรโมชั่นเงื่อนไขเข้าใจง่าย สมัครเดิมพันได้โดยไม่มีขั้นต่ำ พร้อมรับโบนัสแนะนำเพื่อน 0.8% ทุกวัน";

const onboardingSteps = [
  {
    icon: "📝",
    title: "สมัครสมาชิก",
    description: "กรอกข้อมูลตามที่ระบบกำหนดผ่านมือถือหรือคอมพิวเตอร์ ตรวจสอบความถูกต้อง แล้วยืนยันบัญชีได้ในไม่กี่นาที",
    accent: "gold" as const,
  },
  {
    icon: "💳",
    title: "ยืนยันบัญชีและฝากครั้งแรก",
    description: "ยืนยันบัญชีให้เรียบร้อยแล้วฝากเงินครั้งแรกเพื่อเริ่มเดิมพันตามเงื่อนไขของระบบ",
    accent: "blue" as const,
  },
  {
    icon: "🎰",
    title: "เลือกเกมและเริ่มเดิมพัน",
    description: "เลือกเกมคาสิโนจากค่ายที่สนใจผ่านมือถือหรือคอมพิวเตอร์ได้ทันทีหลังฝากเครดิตสำเร็จ",
    accent: "gold" as const,
  },
];

const faqs = [
  {
    q: "ZORO365 มีเกมคาสิโนประเภทใดให้เลือกเล่น?",
    a: "ZORO365 รวมเกมคาสิโนหลายประเภท เช่น บาคาร่า รูเล็ต เกมไพ่ และเกมคาสิโนสด โดยรายการเกมและค่ายที่เปิดให้บริการสามารถตรวจสอบได้จากหน้าเว็บไซต์",
  },
  {
    q: "โบนัสแนะนำเพื่อน 0.8% รับอย่างไร?",
    a: "สมาชิกต้องเข้าสู่ระบบเพื่อรับลิงก์แนะนำส่วนตัวและส่งให้เพื่อนสมัคร เมื่อเพื่อนมียอดเล่นตรงตามเงื่อนไข ระบบจะคำนวณโบนัสแนะนำ 0.8% ให้ตามรอบที่กำหนด",
  },
  {
    q: "หากฝากถอนหรือเข้าใช้งานไม่ได้ต้องทำอย่างไร?",
    a: "ควรตรวจสอบข้อมูลบัญชี การเชื่อมต่ออินเทอร์เน็ต และสถานะรายการก่อน หากปัญหายังไม่หาย สามารถติดต่อทีมงาน ZORO365 ผ่านช่องทางบริการลูกค้าอย่างเป็นทางการเพื่อให้ช่วยตรวจสอบได้",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message="ZORO365 คาสิโนออนไลน์อัตราจ่ายสูง รวมเกมเดิมพันครบทุกค่าย • คืนยอดเสียทุกวัน 0.3% • แนะนำเพื่อนรับโบนัส 0.8% ทุกวัน • สมัครเดิมพันได้โดยไม่มีขั้นต่ำ" />

  <ContentBoxFloatingBadge as="h1" title="ZORO365 คาสิโนออนไลน์อัตราจ่ายสูง รวมเกมเดิมพันครบทุกค่าย">
    <p class="text-left text-base leading-relaxed text-[#e9f7e6]">
      <strong class="text-[#4ade80]">ZORO365</strong> ให้บริการเกมคาสิโนออนไลน์จากค่ายชั้นนำภายในระบบเดียว รองรับการเข้าเล่นผ่านโทรศัพท์มือถือและเว็บเบราว์เซอร์
      พร้อมโปรโมชั่นสำหรับสมาชิกทั้งโบนัสแนะนำเพื่อนและคืนยอดเสียที่สามารถตรวจสอบสิทธิ์ได้ผ่านหน้าเว็บไซต์
    </p>
  </ContentBoxFloatingBadge>

  <SmoothCarousel />

  <ContentBox as="h2" title="คาสิโนออนไลน์ ZORO365 เรตอัตราจ่ายสูง เล่นได้ครบหลายรูปแบบ">
    <p class="text-left text-base leading-relaxed text-[#e9f7e6]">
      เลือกเล่นเกมคาสิโนกับ ZORO365 ได้หลากหลายประเภท ทั้งบาคาร่า รูเล็ต เกมไพ่ และเกมถ่ายทอดสดจากค่ายชั้นนำ ระบบรองรับการใช้งานผ่านมือถือ
      ช่วยให้สมาชิกเลือกโต๊ะและรูปแบบการเดิมพันที่สนใจได้อย่างสะดวก
    </p>
  </ContentBox>

  <ProviderGrid />

  <ContentBoxNeumorphism as="h2" title="โปรโมชั่น ZORO365 เงื่อนไขเข้าใจง่าย สมาชิกตรวจสอบสิทธิ์ได้ทันที">
    <p class="text-left text-base leading-relaxed text-[#e9f7e6]">
      ZORO365 จัดสิทธิพิเศษให้สมาชิกทั้งยอดคืนจากการเล่นและโบนัสแนะนำเพื่อน สามารถเข้าสู่ระบบเพื่อตรวจสอบยอด รายละเอียด และเงื่อนไขของแต่ละโปรโมชั่นได้ด้วยตนเอง
    </p>
  </ContentBoxNeumorphism>

  <ContentBoxSevenThreeCyberCut titleright="คืนยอดเสียทุกวัน รับโบนัส 0.3%">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="ภาพประกอบ ZORO365 คืนยอดเสียทุกวัน รับโบนัส 0.3% ธีมป่าลึกยามค่ำคืน โทนเขียว-ทอง มีไอคอนกระเป๋าเงินคืนยอดเสียแบบ CASHBACK หีบสมบัติทองคำเปิดอยู่เต็มไปด้วยเหรียญ และลูกเต๋า พร้อมป้ายรับโบนัส 0.3% ทุกวัน มั่นคงปลอดภัย 100% ฝาก-ถอนรวดเร็วทันใจ และบริการ 24 ชม."
      class="mx-auto h-auto w-full rounded-2xl border border-[#16a34a]/25 shadow-[0_10px_30px_rgba(22,163,74,0.18)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#e9f7e6]">
      สมาชิกที่มียอดเล่นเสียตรงตามเงื่อนไขสามารถรับยอดคืน 0.3% ได้ทุกวัน โดยเข้าสู่บัญชีสมาชิกและกดรับสิทธิ์ผ่านหน้าเว็บไซต์
    </p>
  </ContentBoxSevenThreeCyberCut>

  <ContentBoxSevenThreeCyberCut titleright="แนะนำเพื่อน รับโบนัส 0.8%">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="ภาพประกอบ ZORO365 แนะนำเพื่อน รับโบนัส 0.8% ธีมป่าลึกยามค่ำคืน โทนเขียว-ทอง มีเครื่องสล็อต 777 กองเหรียญทองคำ และชิปคาสิโนตรา ZORO365"
      class="mx-auto h-auto w-full rounded-2xl border border-[#16a34a]/25 shadow-[0_10px_30px_rgba(22,163,74,0.18)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#e9f7e6]">
      แชร์ลิงก์แนะนำให้เพื่อนสมัครสมาชิกกับ ZORO365 รับโบนัส 0.8% จากยอดเล่นของเพื่อนตามเงื่อนไข พร้อมตรวจสอบยอดโบนัสผ่านบัญชีสมาชิกได้ทุกวัน
    </p>
  </ContentBoxSevenThreeCyberCut>

  <ContentBox as="h2" title="สมัคร ZORO365 เริ่มเดิมพันได้โดยไม่มีขั้นต่ำ">
    <p class="text-left text-base leading-relaxed text-[#e9f7e6]">
      สมัครสมาชิก ZORO365 ผ่านโทรศัพท์มือถือได้ง่าย เพียงกรอกข้อมูลตามที่ระบบกำหนด ตรวจสอบความถูกต้อง และยืนยันบัญชี
      จากนั้นสามารถฝากเงินและเลือกเกมเดิมพันจากค่ายที่สนใจได้ตามเงื่อนไขของระบบ
    </p>
    <p class="mt-4 text-left text-base leading-relaxed text-[#e9f7e6]">
      เว็บไซต์รองรับการใช้งานทั้งโทรศัพท์ Android, iPhone, แท็บเล็ต และคอมพิวเตอร์ โดยเข้าเล่นผ่านเว็บเบราว์เซอร์ได้โดยตรง
    </p>
    <p class="mt-4 text-left text-lg font-black text-[#4ade80]">เริ่มต้นใช้งานได้ง่ายเพียง 3 ขั้นตอน</p>
    <FeatureHighlights items={onboardingSteps} heading={false} />
  </ContentBox>

  <LatestWinnersCyber />

  <ContentBoxNeumorphism as="h2" title="ชวนเพื่อนเล่น ZORO365 รับค่าแนะนำ 0.8% ทุกวัน">
    <p class="text-left text-base leading-relaxed text-[#e9f7e6]">
      สมาชิกสามารถรับลิงก์แนะนำส่วนตัวจากหน้าโปรไฟล์และส่งต่อให้เพื่อน เมื่อเพื่อนสมัครผ่านลิงก์และมียอดเล่นตรงตามเงื่อนไข ระบบจะคำนวณค่าแนะนำในอัตรา 0.8%
    </p>
    <p class="mt-4 text-left text-base leading-relaxed text-[#e9f7e6]">
      สมาชิกควรตรวจสอบรอบการคำนวณ ยอดขั้นต่ำ และเงื่อนไขการรับโบนัสจากหน้าโปรโมชั่นก่อนแชร์ลิงก์แนะนำทุกครั้ง
    </p>
  </ContentBoxNeumorphism>

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#4ade80] to-[#16a34a] px-4 py-3 text-sm font-black whitespace-nowrap text-[#04120a] shadow-[0_10px_30px_rgba(22,163,74,0.26)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(22,163,74,0.4)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>

    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#15803d]/70 bg-[#04120a]/85 px-4 py-3 text-sm font-black whitespace-nowrap text-[#e9f7e6] backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:border-[#16a34a] hover:bg-[#0a1f12]/85 hover:shadow-[0_15px_40px_rgba(74,222,128,0.35)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>
  </div>

  <Faq title="คำถามที่พบบ่อยเกี่ยวกับ ZORO365" faqs={faqs} />

  <ReviewCardSumo2 />

  <Navfoot />
</MainLayout>
