---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import LatestWinners from "../components/LatestWinnersPremium.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxTwo from "../components/ContentBoxTwo.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxTwoFloatingBadge from "../components/ContentBoxTwoFloatingBadge.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import Faq from "../components/Faq3.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import { pageGraph } from "../lib/schema";
import promoCashback from "../assets/slide2.png";
import promoReferral from "../assets/slide1.png";

// VARIANT ROTATION THIS ROUND, decided in .claude/brand-spec-ufalion168.md §3 and NOT
// re-picked here: Announcement3 replaces AnnouncementPremium, LatestWinnersPremium
// replaces LatestWinners4, Faq3 replaces Faq2, ReviewCardSumo2 replaces the base
// ReviewCardSumo, and the ContentBox shape-mix drops FloatingBadge / Neumorphism /
// TwoPremium / SevenThreePremium / the base SevenThree / TwoNeumorphism / the base
// ContentBox for Premium / CyberCut / the base ContentBoxTwo / SevenThreeNeumorphism /
// SevenThreeCyberCut / TwoFloatingBadge / Special — **zero overlap with the outgoing
// brand's mix**. NavbarStyle6 + FooterStyle2 are the layout's pair this round and the
// brand font moves google-sans -> kanit; all of that is the orchestrator's shared-chrome
// step, not this page's.
// ⚠️ ContentBox.astro (the base) is NOT in this round's index mix — it is still always-live
// shared chrome, because terms, privacy, 404, /promotion and the button pages all render
// through it, so the orchestrator rethemes it and **this page neither uses nor edits it**.
// An "is it used?" check has to match the bare filename rather than the components/ path,
// which is how a component reached only from another file got misread as inventory once.
// Every unused *Style / *Premium / *Cyber / *Huay / *CyberCut / *FloatingBadge sibling,
// the other Faq* and Announcement* files, the other LatestWinners* and the base
// ReviewCardSumo all stay on disk as inventory for the next brand — nothing was deleted,
// and the earlier brands' hues still inside them are expected drift.
//
// Four widgets this template usually offers are deliberately absent, and they are named
// without their file extension on purpose because the playbook's "is this component live?"
// check is a bare-filename grep: ProviderGrid is banned by brand-spec §6 because this brief
// names NO provider at all, GameRankingBoard has no ranking to carry, SmoothCarousel has no
// brief section asking for a carousel, and LoginRtpSection is out because its RTP table
// would put an RTP figure on the page while §6 allows only the brief's own four numbers
// (0.3%, 0.8%, 24ชม., 3 ขั้นตอน).
//
// <Announcement /> runs bare on purpose: Announcement3's default message is this brand's
// copy, written from this brief by the orchestrator, and every sub-page calls it bare too —
// so passing an override here is exactly how the ticker ends up saying two different things
// on two pages of the same site.
//
// PALETTE — TWO GOLDS PLUS A BRONZE ON PURE BLACK, WITH NO SECOND HUE FROM ANOTHER FAMILY
// (brand-spec §2). Read off the artwork: the logo is a GOLDEN LION'S HEAD in a pointed gold
// crown, ringed by splashing liquid-gold ribbons and gold star sparkles, over the word
// ufalion168 in thick 3-D glossy gold lettering — ufa and 168 in deep gold, lion in a
// lighter gold, with a small gold crown sitting inside the "o" of lion. The banner is a
// BLACK night-stadium scene with a silver-blonde man and woman in black-and-gold football
// kit, a silver Champions-League trophy, black-and-gold footballs, a black flag with gold
// football stars and a gold bar-chart-with-rising-arrow icon.
// ⚠️ The trap this round is that GOLD has led almost every brand through this repo, so
// finding "a gold" in a file proves NOTHING — compare by VALUE. This round's lead gold is
// #d4922c (R212 G146 B44) and ⚠️ TND168's dfa310 is the closest call (the tells are G146 vs
// G163 and B44 vs B16); it is clearly away from the outgoing f0bb4e (R240 G187) and from
// สมหวัง168's e3b23c (R227 G178). The bright gold is #fdfc71 and ⚠️ นินจา168's fef54b sits
// nearby (the tells are B113 vs B75 and G252 vs G245). The bronze #a25b24 has never been
// used by any brand in this repo and is NOT the outgoing d9701a copper (R217 G112 B26).
// ⚠️ The page background is PURE BLACK #000000 (bg.json), which happens to match the
// artwork's own scene, but bg.json is the only source of that value. The depth ramp is
// #33200a raised / #1f1304 mid / #0a0601 sunk. #5a3310 is the burnt-bronze shadow tier and
// #a25b24 the bronze fill tier — **neither ever carries text** (4.06:1 / 3.0:1, below AA on
// every surface); text on a bronze fill is #fbf6e3 (4.78:1).
// Body copy is #fbf6e3 (= BRAND_TEXT), 19.4:1 on the page and 14.3:1 on the raised surface.
// The ONE highlight colour a <strong> may take is #d4922c (7.94:1 on the page, 5.87:1 on the
// raised surface, 6.89:1 on the mid surface). #f6e3b4 is the secondary/label cream and
// #1a1000 is the only ink allowed on a solid gold, lemon or cream fill (7.10:1 on #d4922c,
// 17.3:1 on #fdfc71). Glow rgba is rgba(212,146,44,α), rgba(253,252,113,α),
// rgba(162,91,36,α) or rgba(246,227,180,α).
// ⚠️ **No red at all this round** — red was the outgoing brand's second hue and is gone —
// and no blue/azure/cyan, purple, green, silver/chrome, rose-gold, pink/fuchsia or vivid
// orange. Values that must not survive anywhere that renders: f0bb4e ffeccb e4021b d9701a
// 3b1b0e 260d04 0d0501 5c2a06 fff8ec 2b1400 (รวยเทพ168, last round) · fb1b32 ff8f9c 5c0410
// fcd45c 6b4a08 2b0711 1a040a 0c0205 fdeaec 1b0308 (มีเฮ168) · 039cfa c3ebfc 04366b f9a826
// 704504 0b2d52 071e38 030f1d (รวยแทร่168) · 32bcfb a9e9ff fef54b 6b5c10 (นินจา168) ·
// 2f9ff5 ffc82e 5c4a16 (สบายเบท168) · fa63b9 ffd84d (ถอนชัวร์168) · fcd434 f5469f ff8dc6
// (มีโชค168) · f7c92b f2bba5 c98a74 b3121b 8a5f12 (ขวัญใจ168) · f0b429 ffdc8c d30304
// 9a6c0c (รับตัง168) · fa0513 ff5a5f ffadaf e3b23c 8a6210 (สมหวัง168) · e5a81b ffe08a
// bb8410 8792a0 (UFA324) · dfa310 (TND168) · 2563eb
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
//
// IMAGE ROLES FOR THIS DROP (2026-10-20, brand-spec §5). Exactly TWO files are referenced
// from this page, both from this drop, and THE TEXT PRINTED ON THE ART is what decides the
// pairing — both bitmaps were read this round:
//   slide2.png -> §4, because its own plaque reads คืนยอดเสีย with 0.3% beside it
//   slide1.png -> §5, because its own plaque reads แนะนำเพื่อน with 0.8% beside it
// ⚠️ The uploader overwrites both files every drop, so the numbering carries no meaning
// across brands and the plaque has to be re-read each time — trusting an inherited pairing
// would have captioned each promotion with the other one's poster.
// Both alts below were written from THIS drop's bitmaps. The previous round's alts described
// a Chinese god-of-wealth mascot, a woman in a white-and-red outfit, red-and-white poker
// chips, a 777 slot cabinet, red hearts and red gift boxes — none of that is in this drop,
// which is a football scene. The phone in both slides is described as a football-betting
// site rather than by the operator name printed on it: §6 confines this page to the brief's
// own words and the brief names no third-party service.
// Deliberately NOT imported, and every file still on disk as inventory: banner2.png (10-08)
// and banner3.png (09-27) are previous brands' article art, and slide3.png / slide4.png
// (09-29) are **LOTTOPLUS lottery posters from a completely different brand**. An eager
// import IS an emit, rendered or not, so importing any of them would ship a competitor's
// picture into dist/ and turn verify-build red. There is therefore NO current-drop article
// illustration this round, and a slide is never substituted for one — the playbook pins
// slide* to ContentBoxSevenThree* blocks only, and these two are the round's full 2-block
// budget.
// banner1 and its mobile crop belong to MainLayout's own pinned globs and are never
// referenced from a page; og.png is the same, MainLayout owns it.
// ⚠️ Both slides are **600x600 SQUARES** on disk this round — last round's pair were
// 600x200 wide strips — so 600 is still the top real candidate (anything above it would not
// be a real pixel) and each picture carries max-w-[600px] so the art is never upscaled past
// its own bitmap. The two `sizes` lists are NOT interchangeable and NEITHER is inherited:
// each is the 3fr-column arithmetic from inside the variant that actually holds that
// picture, and both variants changed file this round. Tailwind's global border-box means a
// max-w-* caps the box INCLUDING padding and border:
//   §4 ContentBoxSevenThreeNeumorphism — max-w-7xl/1280 section, px-4 (32), border 1x2 (2),
//      md:p-10 (80), gap-10 (40), image column md:border-l (1) + md:pl-10 (40) = 41:
//        >= 1280px : (1280 - 32 - 2 - 80 - 40) x 0.3 - 41 = 1126 x 0.3 - 41 = 297px
//        md..1279  : (100vw - 154) x 0.3 - 41             = calc(30vw - 87px)
//        698..767  : 600px (one column at p-8 exceeds the bitmap, so it caps)
//        < 698     : calc(100vw - 98px)
//   §5 ContentBoxSevenThreeCyberCut — max-w-7xl/1280 section, px-4 (32), border 1x2 (2),
//      p-8 (64, no md: step), gap-8 (32), image column md:border-l (1) + md:pl-8 (32) = 33:
//        >= 1280px : (1280 - 32 - 2 - 64 - 32) x 0.3 - 33 = 1150 x 0.3 - 33 = 312px
//        md..1279  : (100vw - 130) x 0.3 - 33             = calc(30vw - 72px)
//        698..767  : 600px
//        < 698     : calc(100vw - 98px)
// Neither picture is the LCP element — MainLayout's hero banner is — so both are
// loading="lazy" fetchpriority="low" decoding="async" and neither ever takes
// fetchpriority="high". formats/fallbackFormat stay at the house values, and quality is
// still ONE number for both formats — tools/avif-quality-service.mjs rescales the AVIF side
// on its own (x0.65), so it must never be hand-tuned per format.
//
// quality={64}, not the usual 80, because both of this drop's slides are busy dark artwork
// with heavy fine grain (liquid-gold splashes, gold coin piles, bokeh sparkles, gradient 3-D
// lettering, satin and skin), which is the case AVIF handles worst. At 80 that is exactly
// the shape that comes out LARGER than its own WebP fallback at every emitted width, and
// verify-build.mjs fails the build on precisely that. 64 is the value already proven to win
// on this art style; the fix is always a LOWER quality, never a higher one. Same number on
// /promotion for the same two slides.
//
// VOCABULARY — brand-spec §6, the brief's own words only. ⚠️ This brand's axis is
// **แฟนเพจเว็บบอลยูฟ่า = a football/sports site. It is NOT a slot site and NOT a lottery
// site.** The outgoing brand รวยเทพ168 was a slot brand, so every slot word that used to be
// on this page is leftover and gone: เกมสล็อตรวยขั้นเทพ · เล่นสล็อต ยิงปลา ไฮโล แทงหวย ·
// ยิงปลา · ไฮโล · หวยออนไลน์ · แทงหวย · ครบในเว็บเดียว · สมัครเล่นสล็อต. Everything the
// copy says traces to src/assets/content.txt: ฟุตบอล, เว็บบอล, ยูฟ่า, แทงบอล, ทริคแทงบอล,
// ข่าวสารฟุตบอล, โปรแกรมแข่งขัน, ผลการแข่งขัน, แนวทางวิเคราะห์ก่อนเกม, ลีก, แมตช์, ราคาบอล,
// ค่าน้ำ, ราคาต่อรอง, อัตราจ่าย, ผลงานย้อนหลัง, สถิติการพบกัน, ความพร้อมของนักเตะ, โปรโมชั่น,
// คืนยอดเสีย 0.3%, แนะนำเพื่อน 0.8%, โบนัส, เครดิต, ยอดเสีย, รอบคำนวณยอด, รอบเวลารับเครดิต,
// ลิงก์แนะนำ, เชื่อมโยงบัญชี, สมัครสมาชิก, เข้าสู่ระบบ, ลงทะเบียน, ฝากถอน,
// ข้อมูลส่วนบุคคล, รหัสผ่าน, รหัส OTP, เจ้าหน้าที่, แอดมิน, 24ชม., ช่องทางทางการ,
// เว็บไซต์ทางการ.
// ⚠️ Also gone: มีเฮ168's เกมสล็อตเจนซี / ระบบเข้าทางคนรุ่นใหม่ / ใส่ใจทุกค่ายเกม /
// เดิมพันง่าย ไม่มีขั้นต่ำ · รวยแทร่168's สล็อตรวมเกมกำไรงาม / เล่นง่ายทุกค่าย /
// ได้เงินสูงทุกรอบ / ทุนน้อยก็เล่นได้ · นินจา168's สล็อตโปรแรงโบนัส0.8%ทุกวัน /
// แค่แนะนำง่ายๆ รับได้ไม่อั้น · ถอนชัวร์168's ถอนง่าย / ไม่มีรีวิวเสีย / หลักแสนยูสต่อวัน /
// การันตีเว็บแท้ · สบายเบท168's เว็บสล็อตทางการ / ผู้ให้บริการฐานเกมหลัก / เว็บแท้อันดับ1 /
// เว็บแท้100% · มีโชค168's เว็บสล็อตลิขสิทธิ์แท้ / นำเข้าตรงจากสิงคโปร์ / PG SOFT / JOKER /
// JILI. **This brief names NO game studio and no operator whatsoever**, so no such name
// appears anywhere on this page. There is no คาสิโน, บาคาร่า, รูเล็ต, สล็อต, ยิงปลา, ไฮโล,
// หวย/แนวทาง/ตรวจหวย, เว็บตรง or ไม่ผ่านเอเย่นต์ anywhere here. Nothing claims a licence
// number, a regulator, a legal-entity name, a named bank, an RTP figure, a deposit minimum,
// a member count or a founding year. The only figures on the page are the brief's own four:
// 0.3%, 0.8%, 24ชม. and 3 ขั้นตอน.
// ⚠️ This brief ADVERTISES AND HEDGES IN THE SAME BREATH: its own headings say
// การันตีค่าน้ำดี จ่ายสูงสุดในวงการ and รับได้ไม่จำกัดยูส while its own paragraphs answer
// that ค่าน้ำและอัตราจ่ายสามารถเปลี่ยนแปลงได้ตามช่วงเวลา จึงควรตรวจสอบราคาจริงก่อนทำรายการ,
// ไม่มีเทคนิคใดรับประกันผลการแข่งขันหรือผลกำไรจากการเดิมพัน and
// เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพัน. Both halves ship exactly
// as written: the advertising words appear ONLY inside the headings the brief itself wrote
// them into and are never expanded into new claims of this page's own, and EVERY hedging
// clause ships in full — they are brief content, not downbeat filler to be trimmed.
//
// The brief, the artwork and the operator's prompt all agree on the brand name. Even so the
// name is never typed on the page: it is interpolated from ${BRAND_NAME} so it can never
// drift from brandProfile, including inside the two alts. ⚠️ รวยเทพ168 is the OUTGOING brand
// and มีโชค168 / มีเฮ168 are other, unrelated brands that also came through this repo — all
// of them are different clients. No domain is written out anywhere here and no URL is built
// with `+`.
//
// Title and description are the brief's own Title / Description lines (content.txt lines
// 1-2) verbatim, with the brand name interpolated. The description is NOT padded up to 150
// characters — verify-build deliberately skips its 150-character floor on the home page for
// exactly this reason.
const pageTitle = `${BRAND_NAME} แฟนเพจเว็บบอลยูฟ่า แชร์ทริคแทงบอล ค่าน้ำดี จ่ายสูงที่สุด`;

const pageDescription = `${BRAND_NAME} แฟนเพจเว็บบอลยูฟ่า อัปเดตข้อมูลข่าวสารทุกแมตช์ แชร์ทริคแทงบอล พร้อมโปรโมชั่นฝากยอด การันตีค่าน้ำดี จ่ายสูงสุดในวงการ`;

// The brief has a real H2 -> H3 nesting this round, so the page is NOT flattened to H2-only.
// Five H3s, and all five are the brief's own lines: two promotion sub-points under §3's
// โปรโมชั่น…รับได้ไม่จำกัดยูส H2 (content.txt lines 9 and 11), plus the three ขั้นตอนที่ 1-3
// labels under §6's สมัครแทงบอล… H2 (lines 15, 17, 19). The three steps go through
// FeatureHighlights, which is the one place the playbook allows a docx sub-list to become
// h3s rather than hand-rolled icon cards. No component rendered here emits a hardcoded
// heading, so the printed h3 count stays at exactly 5.
//
// The checklist, in document order, and what carries each one:
//    1 H1  ${BRAND_NAME} แฟนเพจเว็บบอลยูฟ่า อัปเดตข้อมูลข่าวสารทุกแมตช์
//          ContentBoxPremium, brief paragraph on line 4
//    2 H2  ${BRAND_NAME} แชร์ทริคแทงบอล การันตีค่าน้ำดี จ่ายสูงสุดในวงการ
//          ContentBoxCyberCut, line 6
//    3 H2  โปรโมชั่น ${BRAND_NAME} รับได้ไม่จำกัดยูส
//          ContentBoxTwo (base), line 8 run one paragraph half per column
//    4 H3  โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสทุกวัน
//          ContentBoxSevenThreeNeumorphism + slide2, line 10 left / picture right
//    5 H3  โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด
//          ContentBoxSevenThreeCyberCut + slide1, line 12 left / picture right
//    6 H2  สมัครแทงบอล ${BRAND_NAME} ง่ายๆ 3 ขั้นตอน
//          ContentBoxTwoFloatingBadge, line 14 split across its two columns
//      H3  ขั้นตอนที่ 1-3, FeatureHighlights, lines 15-20 as label + description pairs
//    7 H2  ช่องทางติดต่อแอดมิน ${BRAND_NAME} ตลอด 24ชม.
//          ContentBoxSpecial, line 22 split across its two halves
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ ${BRAND_NAME}
//          Faq3 + faqs prop, lines 23-29
// Final inventory for this page: h1 x1, h2 x5, h3 x5 — brand-spec §4's target.
//
// Both ContentBoxSevenThree* variants lay out md:grid-cols-[7fr_3fr] with the TEXT column
// FIRST and fall `title` back to that left column, so each picture goes in slot="right": the
// heading always lands on the prose, never on the picture, and on a phone the single column
// reads heading, text, picture rather than opening with an image. Neither is passed a
// `titleright`, so neither image column carries a heading and each block emits exactly one.
// ContentBoxTwo and ContentBoxTwoFloatingBadge are passed no column labels either — the
// brief gives §3 and §6 one running paragraph each with no sub-labels, and inventing a pair
// here would be this page's own wording rather than the docx's. Each paragraph runs one half
// per slot, which keeps every clause and still gives the component both slots.
// ContentBoxSpecial is passed no `actions` slot, so its third slot renders nothing.
//
// Every brief paragraph ships in full — nothing merged, nothing summarised. §3, §6 and §7
// run one paragraph half per slot, and NO slot receives more than one element, so the house
// rule's "one element per slot" holds everywhere without a wrapper <div> being needed.
//
// Everything else on the page is chrome and emits no heading tag at any level:
// Announcement3, LatestWinnersPremium and ReviewCardSumo2 render their titles as <p>/<span>
// with an aria-label on the section, and Faq3's questions live inside <summary>. The
// non-brief widgets sit before section 1 (the ticker, then the member feed) and after
// section 8 (the review ledger, then Navfoot) — never spliced between two content sections.

// One array, used by both <Faq> and the FAQPage node — never the component's own defaults
// (Faq3 deliberately ships an empty list, so a forgotten prop renders an empty accordion
// rather than some previous brand's questions). The three pairs are the brief's own Q/A
// block (content.txt lines 24-29), verbatim; only the "1." / "2." / "3." list markers are
// dropped, since the accordion is the list.
const faqs = [
  {
    q: `${BRAND_NAME} มีข้อมูลข่าวฟุตบอลและวิเคราะห์ก่อนแข่งขันหรือไม่?`,
    a: `ตามรูปแบบบริการที่ระบุ ${BRAND_NAME} นำเสนอข่าวสารฟุตบอล โปรแกรมแข่งขัน และแนวทางวิเคราะห์ก่อนเกม โดยควรตรวจสอบความถูกต้องของข้อมูลจากแหล่งข่าวที่เชื่อถือได้เพิ่มเติม`,
  },
  {
    q: `โปรโมชั่นคืนยอดเสีย 0.3% ของ ${BRAND_NAME} รับได้ทุกวันหรือไม่?`,
    a: `โปรโมชั่นระบุการคืนยอดเสียรายวัน แต่สมาชิกควรตรวจสอบประเภทการเดิมพันที่ร่วมรายการ รอบคำนวณยอด และวิธีรับเครดิตจากประกาศล่าสุดก่อนเข้าร่วม`,
  },
  {
    q: `หากมีปัญหาเกี่ยวกับบัญชีหรือรายการฝากถอน ติดต่อเจ้าหน้าที่ได้อย่างไร?`,
    a: `สามารถตรวจสอบช่องทางติดต่อเจ้าหน้าที่จากหน้าเว็บไซต์ทางการของ ${BRAND_NAME} เพื่อแจ้งปัญหาพร้อมข้อมูลรายการที่จำเป็นสำหรับตรวจสอบ โดยไม่ส่งรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น`,
  },
];

// §6's three sub-points, lines 15-20 of the brief: each ขั้นตอนที่ N line is the item's own
// label and the line under it is its description, both verbatim. The icons are a sibling of
// the label inside FeatureHighlights' own aria-hidden="true" plate, never inside the text,
// and they are **football/sport glyphs, not slot machines** — brand-spec §6 puts this brand
// on the football axis, so a 🎰 here would contradict every word around it. They read as the
// step they mark: the stadium gate you walk in through, the shirt you are registered under,
// then the ball itself once you are inside studying the fixtures.
// The accents alternate gold/bronze/gold, so the three cards walk the lead gold against the
// third hue in the order the logo itself reads (deep-gold "ufa" first, the bronze shadow
// tone of the lion's mane second). ⚠️ The union is `"gold" | "bronze"` as of this round —
// FeatureHighlights accepted `"red"` for the outgoing brand's scarlet, and §2 has NO red at
// all this round, so the spelling was removed from the component rather than left
// accepted-but-recoloured. Text on the bronze plate is #fbf6e3 (4.78:1), never bronze on
// dark: §2 forbids #a25b24 from carrying a glyph on any surface.
const registerSteps = [
  {
    icon: "🏟️",
    title: "ขั้นตอนที่ 1 เข้าสู่หน้าสมัครสมาชิก",
    description: `ตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง จากนั้นเลือกเมนูสมัครสมาชิกและอ่านรายละเอียดเกี่ยวกับการเปิดบัญชี รวมถึงนโยบายการจัดเก็บข้อมูลส่วนบุคคล`,
    accent: "gold" as const,
  },
  {
    icon: "🎽",
    title: "ขั้นตอนที่ 2 กรอกข้อมูลและยืนยันบัญชี",
    description: `กรอกข้อมูลตามที่ระบบกำหนด ตรวจสอบความถูกต้องก่อนยืนยัน และตั้งรหัสผ่านที่ปลอดภัย ไม่ควรใช้ข้อมูลของบุคคลอื่นหรือเปิดเผยรหัส OTP ให้ใครทราบ`,
    accent: "bronze" as const,
  },
  {
    icon: "⚽",
    title: "ขั้นตอนที่ 3 เข้าสู่ระบบและศึกษาข้อมูลฟุตบอล",
    description: `หลังลงทะเบียนเรียบร้อย สามารถตรวจสอบโปรแกรมแข่งขัน ราคาบอล ประเภทการเดิมพัน และเงื่อนไขโปรโมชั่นก่อนใช้งาน หากมีข้อสงสัยควรติดต่อเจ้าหน้าที่ผ่านช่องทางทางการ`,
    accent: "gold" as const,
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own sentence. Thai
// has no inter-word space, so a highlight that starts or ends mid-word lets the formatter
// break the line inside the tag and render a space that splits the word — the copy must read
// identically with the tags removed. No two <strong> elements are adjacent either: every pair
// is separated by at least one run of plain text, so the whitespace between them can never
// collapse into a missing space.
// One highlight colour only: #d4922c (brand-spec §2 reserves the lead gold for exactly this
// job), against the inherited body colour #fbf6e3 (= BRAND_TEXT). ⚠️ The bronze #a25b24 is
// NOT available for this — it fails AA on every surface (4.06:1 page / 3.0:1 card) and §2
// confines it to fills, borders and icons; the same goes for the burnt bronze #5a3310. The
// paragraphs below carry no colour class of their own: every ContentBox* card in this mix
// already sets `text-left text-base leading-relaxed text-[#fbf6e3]` on the element holding
// the slot, so the prose inherits it and no page-level override can drift from the card. No
// paragraph carries mx-auto or max-w-* either — the cards cap their own width, and the only
// max-w-* on the page are the two capping the slides, which are images and not prose. No
// slot's copy names a colour.

// No breadcrumb: this is the homepage, so a trail from the root to itself would be a single
// self-referential crumb. Every URL in the graph is derived by pageGraph from `site:` — no
// domain is typed out in this file, no URL is built with `+`, and no Review / AggregateRating
// / sameAs / address / email node is passed. `description` is the exact same string MainLayout
// gets, and `faqs` is the exact same array <Faq> gets.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <LatestWinners />

  <ContentBoxPremium as="h1" title={`${BRAND_NAME} แฟนเพจเว็บบอลยูฟ่า อัปเดตข้อมูลข่าวสารทุกแมตช์`}>
    <p>
      {BRAND_NAME} นำเสนอช่องทางติดตามข่าวสารฟุตบอลสำหรับผู้ที่สนใจการแข่งขันจากลีกต่าง ๆ
      <strong class="text-[#d4922c]">พร้อมข้อมูลโปรแกรมแข่งขัน ผลการแข่งขัน และแนวทางวิเคราะห์ก่อนเกม</strong>
      ภายในเว็บไซต์ยังมีรายละเอียดเกี่ยวกับราคาบอล ค่าน้ำ โปรโมชั่น และช่องทางติดต่อเจ้าหน้าที่ เพื่อให้ผู้ใช้งานศึกษาข้อมูลประกอบการตัดสินใจได้สะดวก
      <strong class="text-[#d4922c]">โดยควรตรวจสอบความถูกต้องของข่าวสารและราคาที่เปลี่ยนแปลงก่อนการแข่งขันทุกครั้ง</strong>
    </p>
  </ContentBoxPremium>

  <ContentBoxCyberCut as="h2" title={`${BRAND_NAME} แชร์ทริคแทงบอล การันตีค่าน้ำดี จ่ายสูงสุดในวงการ`}>
    <p>
      {BRAND_NAME} นำเสนอข้อมูลเกี่ยวกับการวิเคราะห์ฟุตบอลและการเปรียบเทียบค่าน้ำ เพื่อให้ผู้ที่สนใจเข้าใจรูปแบบราคาบอลมากขึ้น
      <strong class="text-[#d4922c]">ไม่ว่าจะเป็นราคาต่อรอง ผลงานย้อนหลัง สถิติการพบกัน หรือความพร้อมของนักเตะก่อนแข่งขัน</strong>
      อย่างไรก็ตาม ค่าน้ำและอัตราจ่ายสามารถเปลี่ยนแปลงได้ตามช่วงเวลา จึงควรตรวจสอบราคาจริงก่อนทำรายการ ส่วนคำกล่าวอ้างเรื่องการจ่ายสูงสุดควรมีข้อมูลเปรียบเทียบที่ตรวจสอบได้
      <strong class="text-[#d4922c]">และไม่มีเทคนิคใดรับประกันผลการแข่งขันหรือผลกำไรจากการเดิมพัน</strong>
    </p>
  </ContentBoxCyberCut>

  <ContentBoxTwo as="h2" title={`โปรโมชั่น ${BRAND_NAME} รับได้ไม่จำกัดยูส`}>
    <p slot="left">
      {BRAND_NAME} นำเสนอข้อมูลโปรโมชั่นสำหรับสมาชิกที่สนใจสิทธิพิเศษจากการใช้บริการ
      <strong class="text-[#d4922c]">โดยมีรายการคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8%</strong>
      ซึ่งแต่ละโปรโมชั่นอาจมีเงื่อนไขเกี่ยวกับประเภทการเดิมพัน ยอดที่ใช้คำนวณ และรอบเวลารับเครดิตแตกต่างกัน
    </p>
    <p slot="right">
      สมาชิกควรศึกษาข้อกำหนดจากประกาศล่าสุดก่อนเข้าร่วม รวมถึงตรวจสอบว่าบัญชีใดมีสิทธิ์รับโปรโมชั่น และรายการใดสามารถใช้ร่วมกันได้
      <strong class="text-[#d4922c]">เพื่อให้เข้าใจรายละเอียดอย่างครบถ้วน</strong>
    </p>
  </ContentBoxTwo>

  <ContentBoxSevenThreeNeumorphism as="h3" title="โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสทุกวัน">
    <p slot="left">
      โปรโมชั่นคืนยอดเสีย 0.3% เป็นรายการที่ระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขในแต่ละวัน
      <strong class="text-[#d4922c]">
        ผู้ใช้งานควรตรวจสอบว่ารายการเดิมพันฟุตบอลประเภทใดเข้าร่วมรายการ มีรอบคำนวณยอดเวลาใด และเครดิตจะเข้าสู่บัญชีโดยอัตโนมัติหรือต้องกดรับด้วยตนเอง
      </strong>
      นอกจากนี้ควรอ่านเงื่อนไขการใช้เครดิตและการถอนเงินให้ครบถ้วนก่อนรับสิทธิ์
      <strong class="text-[#d4922c]">โดยเครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือช่วยรับประกันผลตอบแทนในอนาคต</strong>
    </p>
    <Picture
      slot="right"
      src={promoCashback}
      loading="lazy"
      fetchpriority="low"
      widths={[297, 480, 600]}
      sizes="(max-width: 697px) calc(100vw - 98px), (max-width: 767px) 600px, (max-width: 1279px) calc(30vw - 87px), 297px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={64}
      alt={`โปสเตอร์โปรโมชั่นรูปจัตุรัสของ ${BRAND_NAME} บนฉากพื้นดำ มุมซ้ายบนเป็นโลโก้ ${BRAND_NAME} รูปหัวสิงโตทองคำขนแผงฟูสวมมงกุฎทองแหลม กลางขวาเป็นหญิงสาวผมสั้นสีบลอนด์เงิน สวมชุดดำ-ทองประดับและโช้กเกอร์ทองจี้สิงโต ยกแขนขึ้นเหนือศีรษะ ด้านหลังมีมือถือที่เปิดหน้าเว็บไซต์แทงบอล ลูกฟุตบอลดำ-ทอง มงกุฎทอง และกองเหรียญทอง ด้านล่างเป็นคำว่า โปรโมชั่น ตัวอักษรไทยสามมิติสีทองตัวโต ใต้ลงมาเป็นแถบโค้งเขียนว่า คืนยอดเสีย สีขาว ต่อท้ายด้วยเลข 0.3% ตัวโตสีทอง รอบภาพมีริ้วทองเหลวสาดกระเซ็นและประกายดาวทองกระจายอยู่`}
      class="mx-auto h-auto w-full max-w-[600px] rounded-2xl border border-[#d4922c]/60 shadow-[0_0_28px_rgba(162,91,36,0.45)]"
    />
  </ContentBoxSevenThreeNeumorphism>

  <ContentBoxSevenThreeCyberCut as="h3" title="โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด">
    <p slot="left">
      โปรโมชั่นแนะนำเพื่อนโบนัส 0.8% เป็นรายการสำหรับสมาชิกที่ต้องการตรวจสอบสิทธิประโยชน์จากการแนะนำผู้ใช้งานรายใหม่
      <strong class="text-[#d4922c]">โดยควรศึกษาวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และหลักเกณฑ์การคำนวณโบนัสให้ชัดเจน</strong>
      แม้โปรโมชั่นจะระบุว่าไม่จำกัด แต่สมาชิกควรตรวจสอบจำนวนบัญชีที่เข้าร่วมได้ รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุด
      <strong class="text-[#d4922c]">เพื่อให้ทราบสิทธิ์ที่ได้รับตามข้อกำหนดจริงและหลีกเลี่ยงความเข้าใจคลาดเคลื่อน</strong>
    </p>
    <Picture
      slot="right"
      src={promoReferral}
      loading="lazy"
      fetchpriority="low"
      widths={[312, 480, 600]}
      sizes="(max-width: 697px) calc(100vw - 98px), (max-width: 767px) 600px, (max-width: 1279px) calc(30vw - 72px), 312px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={64}
      alt={`โปสเตอร์โปรโมชั่นรูปจัตุรัสของ ${BRAND_NAME} บนฉากพื้นดำ มุมซ้ายบนเป็นโลโก้ ${BRAND_NAME} รูปหัวสิงโตทองคำสวมมงกุฎทอง กลางขวาเป็นหญิงสาวผมสั้นสีบลอนด์เงิน สวมชุดดำ-ทองประดับและโช้กเกอร์ทองจี้สิงโต ยกแขนขึ้นเหนือศีรษะ ด้านหลังมีมือถือที่เปิดหน้าเว็บไซต์แทงบอล ลูกฟุตบอลดำ-ทอง มงกุฎทอง กองเหรียญทอง และกล่องของขวัญสีดำผูกโบว์ทอง ด้านล่างเป็นคำว่า โปรโมชั่น ตัวอักษรไทยสามมิติสีทองตัวโต ใต้ลงมาเป็นแถบโค้งเขียนว่า แนะนำเพื่อน สีขาว ต่อท้ายด้วยเลข 0.8% ตัวโตสีทอง รอบภาพมีริ้วทองเหลวสาดกระเซ็นและประกายดาวทองกระจายอยู่`}
      class="mx-auto h-auto w-full max-w-[600px] rounded-2xl border border-[#d4922c]/60 shadow-[0_0_28px_rgba(253,252,113,0.3)]"
    />
  </ContentBoxSevenThreeCyberCut>

  <ContentBoxTwoFloatingBadge as="h2" title={`สมัครแทงบอล ${BRAND_NAME} ง่ายๆ 3 ขั้นตอน`}>
    <p slot="left">
      ผู้ที่สนใจศึกษาวิธีสมัครสมาชิก {BRAND_NAME}
      <strong class="text-[#d4922c]">สามารถตรวจสอบขั้นตอนการลงทะเบียนจากเว็บไซต์ทางการ</strong>
    </p>
    <p slot="right">
      โดยควรอ่านข้อกำหนดเกี่ยวกับคุณสมบัติผู้สมัคร อายุที่ได้รับอนุญาต
      <strong class="text-[#d4922c]">และเงื่อนไขการใช้บริการก่อนดำเนินการ</strong>
    </p>
  </ContentBoxTwoFloatingBadge>

  <FeatureHighlights items={registerSteps} />

  <ContentBoxSpecial as="h2" title={`ช่องทางติดต่อแอดมิน ${BRAND_NAME} ตลอด 24ชม.`} iconleft="💬" iconright="🛡️">
    <p slot="left">
      {BRAND_NAME} ระบุช่องทางติดต่อเจ้าหน้าที่สำหรับผู้ใช้งานที่ต้องการสอบถามเกี่ยวกับการสมัครสมาชิก การเข้าสู่ระบบ ข้อมูลราคาบอล รายการฝากถอน และรายละเอียดโปรโมชั่น
      <strong class="text-[#d4922c]">โดยควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีหรือบุคคลที่แอบอ้างชื่อบริการ</strong>
    </p>
    <p slot="right">
      หากพบปัญหาในการทำรายการ ควรเตรียมข้อมูลและหลักฐานที่เกี่ยวข้องไว้สำหรับตรวจสอบ พร้อมแจ้งรายละเอียดให้ชัดเจน
      <strong class="text-[#d4922c]">โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP</strong>
      ทั้งนี้ ควรตรวจสอบเวลาการให้บริการและระยะเวลาตอบกลับล่าสุดอีกครั้ง
    </p>
  </ContentBoxSpecial>

  <Faq as="h2" title={`คำถามที่พบบ่อยเกี่ยวกับ ${BRAND_NAME}`} faqs={faqs} />

  <ReviewCardSumo />

  <Navfoot />
</MainLayout>
