---
import MainLayout from "../layouts/MainLayout.astro";
import AnnouncementCyber from "../components/AnnouncementCyber.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import Faq3 from "../components/Faq3.astro";
import LatestWinnersCyber from "../components/LatestWinnersCyber.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// Title and description are the brief's own Title/Description lines, verbatim.
// A docx-supplied description ships at whatever length it was written — it is
// not padded up to the 150-character floor.
const pageTitle = "JAIDEE928 สล็อตใจดีเว็บแท้ จ่ายตรง คอมสูง สมัครปั่นเกม ทำกำไรได้ทันที";

const pageDescription =
  "JAIDEE928 สล็อตใจดีเว็บแท้ ค่ายเกมฮิตสุดมันส์ครบทุกแบรนด์ คอมมิชชั่นสูงจ่ายตรง ฝากถอนเข้าไว สมัครทำกำไรกับเว็บตรง ถอนง่ายได้เงินชัวร์";

// The ticker copy is passed explicitly rather than relying on the component's
// default — every Announcement* variant's default belongs to whichever brand
// wired it in last.
const announcement =
  "JAIDEE928 สล็อตใจดีเว็บแท้ จ่ายตรง ไม่ผ่านเอเยนต์ รวมค่ายเกมฮิตครบทุกแบรนด์ในบัญชีเดียว • โปรโมชั่นคืนยอดเสีย รับโบนัสสูงสุด 0.3% ทุกวัน • แนะนำเพื่อนรับโบนัสสูงสุด 0.8% ถอนได้จริงไม่อั้น • ระบบฝากถอนอัตโนมัติเข้าไว พร้อมแอดมิน JAIDEE928 ดูแลตลอด 24 ชั่วโมง";

// The brief's "เริ่มต้นใช้งานง่ายเพียง 3 ขั้นตอน" sub-points. Each title is the
// brief's line verbatim, because FeatureHighlights renders them as the only
// <h3> tier on the page and a heading may only carry docx text.
const steps = [
  {
    icon: "📝",
    title: "สมัครสมาชิก JAIDEE928 และกรอกข้อมูลตามที่ระบบกำหนด",
    accent: "gold" as const,
  },
  {
    icon: "💳",
    title: "เข้าสู่บัญชีและฝากเครดิตผ่านระบบฝากถอนอัตโนมัติ",
    accent: "silver" as const,
  },
  {
    icon: "🎰",
    title: "ตรวจสอบโบนัส เลือกเกมสล็อต และศึกษากติกาก่อนเริ่มเดิมพัน",
    accent: "gold" as const,
  },
];

// One array, used by both <Faq3> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last.
const faqs = [
  {
    q: "JAIDEE928 มีเกมสล็อตจากค่ายไหนให้เลือกบ้าง?",
    a: "ภายในระบบมีเกมสล็อตจากหลากหลายผู้ให้บริการ โดยสมาชิกสามารถตรวจสอบรายชื่อค่าย เกมใหม่ และเกมที่เปิดให้บริการล่าสุดจากหน้าเกมสล็อตในบัญชีของตนเองได้โดยตรง",
  },
  {
    q: "โปรโมชั่นและคอมมิชชั่น JAIDEE928 รับอย่างไร?",
    a: "สมาชิกสามารถตรวจสอบโปรโมชั่นที่กำลังเปิดให้รับผ่านหน้าเว็บไซต์ แต่ละรายการอาจมีเปอร์เซ็นต์ วิธีคำนวณ และเงื่อนไขแตกต่างกัน จึงควรอ่านรายละเอียดให้ครบถ้วนก่อนกดรับโบนัสหรือคอมมิชชั่นทุกครั้ง",
  },
  {
    q: "หากฝากเงินหรือถอนเงิน JAIDEE928 ไม่สำเร็จต้องทำอย่างไร?",
    a: "ให้ตรวจสอบสถานะรายการและข้อมูลที่ใช้ทำธุรกรรมก่อน หากเครดิตยังไม่เข้าหรือรายการถอนยังค้าง สามารถติดต่อแอดมิน JAIDEE928 พร้อมแจ้งรายละเอียดและเวลาที่ทำรายการ เพื่อให้ทีมงานช่วยตรวจสอบและแนะนำขั้นตอนดำเนินการต่อได้",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <AnnouncementCyber message={announcement} />

  <SmoothCarousel />

  <ContentBoxCyberCut as="h1" title="JAIDEE928 สล็อตใจดีเว็บแท้ จ่ายตรง เข้าไว ถอนง่ายชัวร์">
    <p class="text-left text-base leading-relaxed text-[#e4d9f5]">
      <strong class="text-[#d8a7ff]">JAIDEE928</strong> พร้อมให้บริการสมาชิกที่ต้องการเล่นสล็อตออนไลน์ผ่านมือถือและคอมพิวเตอร์ รวมเกมสล็อตหลากหลายค่ายไว้ในระบบเดียว พร้อมโปรโมชั่น โบนัส
      และคอมมิชชั่นตามเงื่อนไขที่กำหนด ระบบฝากถอนอัตโนมัติช่วยให้ตรวจสอบและทำรายการได้สะดวก พร้อมมีแอดมินคอยให้คำแนะนำเกี่ยวกับการสมัคร ฝากถอน โปรโมชั่น และการใช้งานตลอด 24 ชั่วโมง
    </p>
  </ContentBoxCyberCut>

  <ContentBoxPremium as="h2" title="เว็บ JAIDEE928 สล็อตใจดีเว็บตรง รวมค่ายเกมฮิตสุดมันส์ครบทุกแบรนด์">
    <p class="text-left text-base leading-relaxed text-[#e4d9f5]">
      JAIDEE928 รวบรวมเกมสล็อตออนไลน์จากหลากหลายค่ายให้สมาชิกเลือกเล่นผ่านบัญชีเดียว มีทั้งเกมยอดนิยม เกมใหม่ เกมโบนัส และสล็อตแจ็คพอต พร้อมจัดหมวดหมู่ให้ค้นหาได้ง่าย รองรับการเล่นผ่านสมาร์ตโฟน แท็บเล็ต
      และคอมพิวเตอร์ ก่อนเริ่มเล่นสามารถตรวจสอบกติกา ฟีเจอร์ อัตราเดิมพัน และรายละเอียดของแต่ละเกม เพื่อเลือกเกมให้เหมาะกับรูปแบบการเล่นของตนเอง
    </p>
  </ContentBoxPremium>

  <ProviderGrid />

  <ContentBoxSevenThreeCyberCut titleright="JAIDEE928 จัดโปรโมชั่น เอาใจสายปั่น คอมมิชชั่นสูง ต่อยอดทำกำไรไม่จำกัด">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นพื้นหลังสีม่วงเข้ม ด้านบนเป็นโลโก้ JAIDEE928 ตัวอักษรสีเงินโครมตัดม่วง ถัดลงมาเป็นข้อความ โปรโมชั่น คืนยอดเสีย รับโบนัส พร้อมตัวเลข 0.3% ขนาดใหญ่ หญิงสาวสวมชุดสีม่วงดำยืนอยู่กลางภาพ รอบตัวมีชิปคาสิโน วงล้อสล็อตขึ้นเลข 777 และไพ่หลายใบ แถบด้านล่างเขียนว่า คืนยอดเสียทุกวัน รับโบนัสสูงสุด 0.3% ทำเทิร์นโอเวอร์น้อย ถอนได้ไว"
      class="mx-auto h-auto w-full rounded-2xl border border-[#a855f7]/45 shadow-[0_10px_30px_rgba(168,85,247,0.22)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#e4d9f5]">
      สมาชิกสามารถติดตามโปรโมชั่น JAIDEE928 และสิทธิ์คอมมิชชั่นที่เปิดให้รับตามเงื่อนไขของแต่ละกิจกรรม โดยระบบจะแสดงรายละเอียดเกี่ยวกับเปอร์เซ็นต์ วิธีคำนวณ รอบการรับ และข้อกำหนดที่เกี่ยวข้องให้ตรวจสอบก่อนเข้าร่วม ทั้งนี้
      โบนัสหรือคอมมิชชั่นช่วยเพิ่มสิทธิประโยชน์ในการใช้งาน แต่ไม่สามารถรับประกันผลกำไรจากการเดิมพันได้
    </p>
  </ContentBoxSevenThreeCyberCut>

  <ContentBoxSevenThreePremium title="สมัคร JAIDEE928 รับโบนัส เดิมพันได้ทันที">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นพื้นหลังสีม่วงเข้ม ด้านบนเป็นโลโก้ JAIDEE928 ตัวอักษรสีเงินโครมตัดม่วง ถัดลงมาเป็นข้อความ โปรโมชั่น แนะนำเพื่อน รับโบนัส พร้อมตัวเลข 0.8% ขนาดใหญ่ หญิงสาวสวมชุดสีม่วงยืนข้างตู้สล็อตที่ขึ้นคำว่า JACKPOT รอบตัวมีไพ่เอซและชิปคาสิโนสลักเลข 928 แถบด้านล่างเขียนว่า แนะนำเพื่อนได้เงิน รับโบนัสสูงสุด 0.8% ถอนได้จริงไม่อั้น ปลอดภัย มั่นใจ 100%"
      class="mx-auto h-auto w-full rounded-2xl border border-[#a855f7]/45 shadow-[0_10px_30px_rgba(168,85,247,0.22)]"
    />
    <div slot="right" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e4d9f5]">
        ผู้ใช้งานใหม่สามารถสมัคร JAIDEE928 ผ่านระบบออนไลน์ได้ง่าย หลังเปิดบัญชีเรียบร้อยแล้วสามารถ Login เพื่อตรวจสอบโปรโมชั่นสมาชิกใหม่และโบนัสที่กำลังเปิดให้รับ ก่อนเลือกใช้สิทธิ์ควรอ่านรายละเอียดเกี่ยวกับยอดฝาก
        ยอดที่ใช้คำนวณ และเงื่อนไขการถอนให้ครบถ้วน
      </p>
      <p class="text-left text-base leading-relaxed font-bold text-[#d8a7ff]">เริ่มต้นใช้งานง่ายเพียง 3 ขั้นตอน</p>
      <FeatureHighlights items={steps} />
    </div>
  </ContentBoxSevenThreePremium>

  <ContentBoxTwoNeumorphism titleleft="เว็บตรง JAIDEE928 มีแอดมินคอยบริการตลอดการเล่น">
    <p slot="left" class="text-left text-base leading-relaxed text-[#e4d9f5]">
      หากพบปัญหาเกี่ยวกับการสมัครสมาชิก การ Login เครดิตไม่เข้า ฝากถอนล่าช้า การรับโบนัส คอมมิชชั่น หรือการเข้าเกมสล็อต สามารถติดต่อแอดมิน JAIDEE928 ได้ตลอด 24 ชั่วโมง
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#e4d9f5]">
      ทีมงานพร้อมช่วยตรวจสอบรายการและแนะนำขั้นตอนการใช้งาน เพื่อให้สมาชิกสามารถแก้ไขปัญหาและกลับมาใช้งานระบบได้อย่างต่อเนื่อง
    </p>
  </ContentBoxTwoNeumorphism>

  <Faq3 title="คำถามที่พบบ่อยเกี่ยวกับ JAIDEE928" faqs={faqs} />

  <LatestWinnersCyber />

  <LoginRtpSection />

  <ReviewCardSumo2 />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#d8a7ff] via-[#a855f7] to-[#4c1095] px-4 py-3 text-sm font-black whitespace-nowrap text-[#060210] shadow-[0_10px_30px_rgba(168,85,247,0.28)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(168,85,247,0.42)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#a855f7]/50 bg-gradient-to-r from-[#0d0616] to-[#060210] px-4 py-3 text-sm font-black whitespace-nowrap text-[#d8a7ff] shadow-[0_10px_30px_rgba(168,85,247,0.16)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#d8a7ff]/70 hover:text-[#e6e8ec] hover:shadow-[0_15px_40px_rgba(230,232,236,0.28)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>
  </div>

  <Navfoot />
</MainLayout>
