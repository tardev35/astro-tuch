---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement4.astro";
import LatestWinners from "../components/LatestWinners3.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import Faq from "../components/Faq2.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import { pageGraph } from "../lib/schema";
import imgCashback from "../assets/slide1.png";
import imgReferral from "../assets/slide2.png";

// VARIANT ROTATION THIS ROUND (DUCK1688 -> FAH999), per brand-spec §3. Every
// family moves off the outgoing brand's pick: Announcement4 replaces
// Announcement6, LatestWinners3 replaces the base LatestWinners, Faq2 replaces
// Faq4, ReviewCardSumo2 replaces the base ReviewCardSumo, and the ContentBox
// shape-mix leaves CyberCut / TwoPremium / SevenThreePremium /
// SevenThreeCyberCut / Neumorphism / Special for FloatingBadge / TwoCyberCut /
// SevenThreeNeumorphism / SevenThree / Premium / TwoNeumorphism plus
// FeatureHighlights. NavbarStyle11 and the base Footer are the layout's pair
// this round (previously NavbarStyle7 / FooterPremiumSumo) and the brand font
// moves kanit -> google-sans; all three are the orchestrator's shared-chrome
// step, not this page's.
// Plain ContentBox is the one deliberate carry-over: it is the always-live box
// that terms, privacy, 404 and the button pages render through, so it cannot
// follow a rotation. Section 3 is the single docx section it carries here.
// ContentBoxTwo is also still live but is NOT imported here — it is reached only
// through LoginRtpSection, so an "is it used?" grep has to match the bare
// filename, not "components/ContentBoxTwo.astro".
// Every unused *Premium / *Cyber / *Huay / *Neumorphism / Style file, the other
// Faq* and Announcement* siblings, the base ReviewCardSumo and LatestWinners
// stay on disk as inventory for the next brand — none was deleted, and
// DUCK1688's duck gold and bill amber still inside them are expected drift, not
// a bug.
//
// <Announcement /> runs bare on purpose: Announcement4's default message is
// already this brand's copy, set by the orchestrator from this brief, and every
// sub-page calls it bare too — so passing an override here is exactly how the
// ticker ends up saying two different things on two pages of the same site.
//
// PALETTE OF THIS BRAND (brand-spec §2). FAH999 is a genuine TWO-COLOUR pair
// read straight off the artwork: hot pink #ff3fa4 LEADS (the 3-D FAH999
// lettering, the bunny ears, the glowing hearts, the chips) and gold #f5c53d is
// the second hue (the coins, the crowns, the 777 cabinets), over a page
// background that is DEEP PLUM-BLACK (bg.json = {"mode":"color","color":
// "#2e002c"}), so — unlike last round's pure black — a surface CAN sink below
// the page: #4a0b42 raised / #3a0534 mid / #2e002c page / #210220 deep.
// ⚠️ TWO TRAPS THIS ROUND. BPLAY639 was ALSO a pink brand, so "there is already
// pink here" proves nothing — its #f472b6 #fbcfe8 #e9d5f5 #7e22ce #fdf2f8 are
// not ours. And GOT777's gold #f5c518 differs from our #f5c53d by TWO
// CHARACTERS; do not eyeball it. DUCK1688's own set (#f3bb34 #fde464 #c8901a
// #8a5f08 #5c3f04 #f58b2a #ffc98a #a3510c #1a1203 #f6ecd9 #d8c69b #1f1709
// #171106 #0d0903) is gone from every rendered file, as is NAZA168's gold and
// chrome. THERE IS NO SILVER, NO ORANGE AND NO RED HUE AT ALL this round.
// Body copy is #fde8f3 (= BRAND_TEXT), 12.7:1 on the raised surface.
// Highlights below are #ff6cbb, which §2 pins to exactly this one job (5.7:1 on
// the raised surface) — unlike #ff3fa4 which is the border/accent/large-text
// pink, unlike #ffd1ea which is the gradient bright end and the hover colour,
// and unlike #e8b9d4 which is the muted secondary text. #b3006a, #7a0046,
// #4d002b and #9c6f08 never carry text at any size, and #2b0019 is the only ink
// allowed on a pink or gold fill — and never on #b3006a, where it is 2.8:1.
//
// IMAGE ROLES FOR THIS DROP (2026-10-11, brand-spec §4). Two files are
// referenced from this page and only two, and each pairing is read off the
// artwork itself — the percentage printed ON the slide has to match the heading
// the block carries, or the picture contradicts the section above it:
//   slide1.png — square 600x600 hot-pink-and-black scene. A silver-white-haired
//     bunny-girl with pink rabbit ears, heart earrings and a pink bow tie winks
//     and reaches a hand out to the left. Upper right the FAH999 logo medallion
//     (a brunette bunny-girl, two aces and a gold 777 reel above the 3-D pink
//     FAH999 lettering). Gold coins, playing cards and crowned pink-and-white
//     chips scattered around, a gold podium along the bottom. Across the middle
//     โปรโมชั่น in large 3-D pink type under a gold crown and, on a dark plate
//     under it, คืนยอดเสีย 0.3% between small pink hearts. The artwork prints
//     the offer itself, so it belongs to docx H3 #4. Imported as imgCashback.
//   slide2.png — the companion square. The same bunny-girl, arm extended, pink
//     ribbons of light sweeping behind her. Upper right the same FAH999 logo
//     medallion. Gold coins, an ace of spades and an ace of hearts at the right,
//     a crowned pink chip lower right, the gold podium below. Across the middle
//     โปรโมชั่น in the same 3-D pink type under a gold crown and, on a dark
//     plate under it, แนะนำเพื่อน โบนัส 0.8%. It belongs to docx H3 #5.
//     Imported as imgReferral.
// Both slides are 600x600 on disk, so 600 is the top real candidate — nothing
// above it would be a real pixel — and each picture carries max-w-[600px] so the
// art is never upscaled past its own bitmap.
// Each slide sits in a ContentBoxSevenThree* image+text block, which is that
// family's hard cap of two per rebrand, so there is no third SevenThree anywhere
// on the site and no slide appears outside those two blocks.
// Both blocks lay out md:grid-cols-[7fr_3fr] with the TEXT column first, so each
// picture goes in slot="right" and the heading always lands on the prose, never
// on the picture — and on a phone the single column reads heading, text, picture
// rather than opening with an image. Each `sizes` therefore describes its own
// 3fr column rather than the viewport. The two figures below were RECOMPUTED
// from the two variants this brand picked — they are NOT the numbers last round
// used, because SevenThreePremium/SevenThreeCyberCut capped at max-w-7xl (1280)
// while both of ours cap at max-w-[1400px] and pay different padding:
//   ContentBoxSevenThreeNeumorphism (section 4): section max-w-[1400px] +
//     px-4(32), card border(2) + p-8(64) [no md:p-10] + gap-8(32), image column
//     md:border-l(1) + md:pl-8(32) = 33
//       >= 1400px : (1400 - 32 - 2 - 64 - 32) x 0.3 - 33 = 381 - 33 = 348px
//       md..1399  : (100vw - 130) x 0.3 - 33             = calc(30vw - 72px)
//       698..767  : one column at p-8 exceeds 600, so max-w-[600px] binds = 600px
//       < 698     : one column at p-8                    = calc(100vw - 98px)
//   ContentBoxSevenThree (section 5): same section cap, but md:p-10(80) and
//     gap-8(32), image column md:pl-6(24) only — its md:border-r + md:pr-6 sit
//     on the TEXT column and come out of THAT track
//       >= 1400px : (1400 - 32 - 2 - 80 - 32) x 0.3 - 24 = 376.2 - 24 = 352px
//       md..1399  : (100vw - 146) x 0.3 - 24             = calc(30vw - 68px)
//       698..767  : capped by max-w-[600px]              = 600px
//       < 698     : one column at p-8 (no md:p-10)       = calc(100vw - 98px)
// Neither is the LCP element — MainLayout's hero banner is — so both are
// loading="lazy" fetchpriority="low" decoding="async" and neither takes
// fetchpriority="high". formats/fallbackFormat/quality are left at the house
// values: tools/avif-quality-service.mjs rescales AVIF quality on its own, so
// quality={80} must not be hand-tuned per format.
//
// The alt text was written from THIS drop's artwork, read off the files rather
// than carried over: the set is a hot-pink-and-black scene starring bunny-girl
// characters with pink rabbit ears, playing-card aces, crowned pink casino
// chips, glowing pink hearts, gold coins and gold 777 cabinets — NOT DUCK1688's
// gold-and-black SPACE scene with a crowned duck mascot, planets, a moon and
// duck-faced coins, and not NAZA168's astronaut helmet medallion. There is no
// planet, no moon, no duck and no space station on either file.
//
// Deliberately NOT imported, and every file still on disk:
//   banner2.png (10-08) is the previous brand's artwork, banner3.png (09-27) is
//   older still, and slide3.png / slide4.png (09-29) are a lottery brand's
//   posters — all previous brands' artwork. Importing any of them emits a
//   competitor's picture into dist/ (an eager import IS an emit, rendered or
//   not) and turns verify-build red. There is therefore NO current-drop article
//   illustration this round, and a slide is not substituted for one.
//   banner1.png and banner1-mobile.png belong to MainLayout's own pinned globs
//   and are never referenced from a page. og.png is the same: MainLayout owns it.
// Also deliberately unused (named without the file extension on purpose — the
// playbook's "is this component live?" check is a bare-filename grep, and a
// mention here would read as a render): ProviderGrid, GameRankingBoard and
// SmoothCarousel have no brief section asking for a provider wall, a ranking
// board or a carousel this round (the brief names no studio, so a provider wall
// would have to invent one); BankStrip already renders inside the active footer;
// and the three-column ContentBox3Three family has nothing to carry — every
// section in this brief is one or two running paragraphs, not a three-way split.
//
// Vocabulary (brand-spec §7): FAH999 is a ฟาสล็อตเว็บตรง and nothing else — a
// SLOT site, not a lottery site, not a casino-table site, not sport. The words
// this page may use are the brief's own: ฟาสล็อตเว็บตรง, เล่นสล็อตระบบแท้,
// Login ใช้งานง่าย, ออนไลน์ 24 ชั่วโมง, ทางเข้าหลัก, เล่นสล็อตได้ทุกค่าย,
// แตกง่ายทุกเกม, เว็บตรงในตำนาน, สล็อตคลาสสิก, เกมโบนัส, ฟรีสปิน,
// สล็อตวงล้อทั่วไป, ฟีเจอร์พิเศษ, ค่ายเกม, หมวดเกม, ตารางจ่าย,
// อัตราการคืนเงินผู้เล่น, ช่วงเดิมพัน, ข้อมูลบัญชี, ประวัติรายการ,
// คืนยอดเสีย 0.3%, เข้ายูส, รอบตัดยอด, รอบประจำวัน, ยอดที่เข้าเกณฑ์,
// แนะนำเพื่อน 0.8%, ลิงก์แนะนำ, สมัคร 3 ขั้นตอน, ยืนยันบัญชี,
// แอดมิน 24 ชั่วโมง, ช่องทางติดต่อหลัก, PIN, OTP, ผลการหมุนเป็นแบบสุ่ม.
// ⚠️ "แตกง่ายทุกเกม" is THIS brief's own H2 (content.txt line 5) and ships
// verbatim even though a near-identical phrase sat on an older brand's ban list
// — the ban covers invented copy, not a line the brief supplies. Same for
// "เว็บตรงในตำนาน" (line 8). The brief itself hedges แตกง่ายทุกเกม on the very
// next line, and that hedge ships with it rather than being trimmed as downbeat
// filler.
// DUCK1688's vocabulary is banned and gone (สล็อตพีจีเว็บเป็ด, เว็บเป็ด,
// ไม่ผ่านเว็บเอเย่นต์, เครือหลัก, เบทต่ำ, ทุนน้อยกำไรงาม,
// การันตีความน่าเชื่อถือ), as is every older brand's (เว็บสล็อตนาซ่า,
// ส่งตรงจากเมกา, ส่งตรงจากอเมริกา, ฐานเกมหลัก 100%, ไม่ผ่านม้า, บัญชีม้า,
// นิติบุคคล, เครือสล็อตฐานเว็บหลัก, ฐานเว็บสล็อตหลัก, เว็บตรงฐานสล็อตหลัก,
// ดับเบิ้ลโบนัส, จ่ายไว, ไม่มีขั้นต่ำ, ค่ายตรง, ส่งตรงจากเว็บแม่, การันตีเว็บแท้,
// รีวิวถอนจริง, ถูกลิขสิทธิ์, ไฮคลาส, VIP, บาคาร่า, รูเล็ต, ไฮโล, เสือมังกร,
// แบล็กแจ็ก, โต๊ะสด, คาสิโนไลฟ์, คาสิโนออนไลน์, บอล, กีฬา, ตลาดเดิมพัน) — the
// page is written straight from the brief rather than find-and-replaced over the
// old sentences. There is NO หวย anywhere on this site this round: it is a slot
// brand, the word appears nowhere, and /ตรวจหวย and /แนวทาง stay parked in
// src/pages-disabled/.
// Nothing here claims a licence, a regulator, an operator, a studio, a bank, an
// RTP figure, a deposit minimum, a member count or a founding year, because the
// brief names none. The only figures are the brief's own: 0.3%, 0.8%,
// 3 ขั้นตอน and 24 ชั่วโมง.
// The brief's own hedging ships with the copy — it states it five separate times
// (ควรตรวจสอบข้อมูลผู้ให้บริการและค่ายเกมที่เชื่อมต่อจริงก่อนใช้งาน ·
// ผลการหมุนเป็นแบบสุ่มและไม่มีเกมใดรับประกันว่าจะชนะทุกครั้ง ·
// ควรอ่านรายละเอียดก่อนกดรับทุกครั้ง · คำว่าไม่จำกัดควรระบุให้ชัด ·
// ไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP) and every one of those clauses is part of
// its paragraph, not trimmed as downbeat filler.
//
// The brief says FAH999 throughout and so does every piece of artwork in the
// drop and the operator's prompt — no conflict this round. Even so the brand
// name is never typed on the page: it is interpolated from ${BRAND_NAME} so it
// can never drift from brandProfile. No domain is written out anywhere here —
// note the real domain has a dash (per brand-spec §1) that the brand name does
// not, which is exactly the kind of thing a hand-typed URL gets wrong.
//
// Title and description are the brief's own Title/Description lines, used
// verbatim at ~109 characters and NOT padded up to 150 — verify-build
// deliberately skips its 150-character floor on the home page for exactly this
// reason. The only edit to the brief's line is the missing space in
// "Loginใช้งานง่าย" -> "Login ใช้งานง่าย".
const pageTitle = `${BRAND_NAME} ฟาสล็อตเว็บตรง เล่นสล็อตระบบแท้ ใช้งานง่าย ออนไลน์ 24 ชั่วโมง`;

const pageDescription = `${BRAND_NAME} ฟาสล็อตเว็บตรง ทางเข้าหลัก เล่นสล็อตระบบแท้ Login ใช้งานง่าย ปลอดภัย มีแอดมินคอยบริการออนไลน์ 24 ชั่วโมง`;

// The brief has a real H2 -> H3 nesting this round, so the page is NOT flattened
// to H2-only. There are five genuine H3s: the two promotion sub-points nested
// under section 3's โปรโมชั่น H2, and the three สมัคร steps nested under section
// 6 — the latter are the skill's ONE sanctioned H3 exception, a docx H2 whose
// body is a short labelled sub-list, carried by FeatureHighlights so the section
// keeps a single H2 and the three steps become real H3 children of it.
//
// The checklist, in document order, and what carries each one:
//    1 H1  FAH999 ฟาสล็อตเว็บตรง เล่นสล็อตระบบแท้ Login ใช้งานง่าย
//          ContentBoxFloatingBadge, brief paragraph on line 4
//    2 H2  FAH999 ทางเข้าหลัก เล่นสล็อตได้ทุกค่าย แตกง่ายทุกเกม
//          ContentBoxTwoCyberCut, line 6 left / line 7 right
//    3 H2  โปรโมชั่นเล่นสล็อต FAH999 เว็บตรงในตำนาน
//          ContentBox (the plain, always-live variant), line 9
//    4 H3  โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสทุกวัน
//          ContentBoxSevenThreeNeumorphism + slide1 (imgCashback), line 11
//    5 H3  โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด
//          ContentBoxSevenThree + slide2 (imgReferral), line 13
//    6 H2  สมัครเล่นสล็อต FAH999 ง่ายๆ 3 ขั้นตอน
//          ContentBoxPremium, line 15
//   6a H3  ขั้นตอนที่ 1 เข้าหน้าสมัครสมาชิก          FeatureHighlights, line 16
//   6b H3  ขั้นตอนที่ 2 กรอกข้อมูลและตั้งรหัสผ่าน      FeatureHighlights, line 17
//   6c H3  ขั้นตอนที่ 3 ยืนยันข้อมูลและ Login         FeatureHighlights, line 18
//    7 H2  แอดมิน FAH999 คอยให้บริการ 24 ชั่วโมง
//          ContentBoxTwoNeumorphism, line 20 left / line 21 right
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ FAH999
//          Faq2 + faqs prop, lines 23-28
// Final inventory for this page: h1 x1, h2 x5, h3 x5.
//
// Shape rhythm, top to bottom: floating pink BADGE plate with dark ink over a
// card gradient-filled from raised down to mid -> clipped-corner two-column card
// on the MID surface whose corner rules pair pink horizontals with gold
// verticals -> flat rounded card from the always-live plain box -> soft
// NEUMORPHIC 7:3 slab on the mid surface with a solid gold heading, picture
// right -> rounded 7:3 card on the DEEPEST surface (below the page) with a pale
// pink heading and a gold hairline, picture right -> rounded gradient card from
// raised to mid with a pink-to-gold spine beside the heading -> three icon-plate
// rows alternating pink and gold plates -> second NEUMORPHIC slab, this one on
// the brightest RAISED surface with the opposite light end -> clipped accordion
// rows on the mid surface inside a pink hairline frame.
// No shape repeats back to back; the two neumorphic slabs sit on different
// surfaces (#3a0534 mid vs #4a0b42 raised) and climb to different light ends
// (#b3006a vs #ff3fa4); the two SevenThree blocks differ in corner (soft slab vs
// rounded card), surface (mid vs deepest) AND heading treatment (solid gold vs
// solid pale pink with a three-stop bar); and every card's heading gradient runs
// a different order of the same hues, so no two cards read as the same card.
//
// ContentBoxSevenThreeNeumorphism and ContentBoxSevenThree both take the docx
// heading through `title`, which falls back to their wide (7fr) LEFT text
// column; neither is passed a `titleright`, so each block emits exactly one
// heading and the picture column never carries one.
//
// Every brief paragraph ships in full — all eleven of them, nothing merged or
// summarised. Sections 2 and 7 have two paragraphs each and both run one
// paragraph per column, so no slot there receives two siblings; sections 1, 3,
// 4, 5 and 6 have one paragraph each. No single-slot box on this page carries
// two paragraphs, so no wrapper <div> is needed in any slot this round.
// The column labels passed to ContentBoxTwoCyberCut and ContentBoxTwoNeumorphism
// are this page's own layout wording, not brief headings, and both variants
// render them as <p>.
// FeatureHighlights is a SIBLING of section 6's card, not a child of its slot —
// a ContentBox* slot takes exactly one element and no wrapper <div> may be
// re-added inside one.
//
// Everything else on the page is chrome and emits no heading tag at any level:
// Announcement4, LatestWinners3, LoginRtpSection and ReviewCardSumo2 render
// their titles as <p>/<span> with an aria-label on the section, and Faq2's
// questions live inside <summary> as <span>. The non-brief widgets sit before
// section 1 (the ticker, then the winners feed) and after section 8
// (LoginRtpSection, ReviewCardSumo2, Navfoot) — never spliced between two
// content sections.

// One array, used by both <Faq> and the FAQPage node — never the component's own
// defaults (Faq2 deliberately ships an empty list, so a forgotten prop renders
// an empty accordion rather than some previous brand's questions). The three
// pairs are the brief's own Q/A block (content.txt lines 23-28), verbatim.
const faqs = [
  {
    q: `${BRAND_NAME} สามารถ Login เข้าเล่นสล็อตผ่านมือถือได้หรือไม่?`,
    a: `${BRAND_NAME} นำเสนอระบบ Login สำหรับการใช้งานผ่านมือถือและคอมพิวเตอร์ สมาชิกควรตรวจสอบทางเข้าหลักก่อนกรอกข้อมูลบัญชี และเลือกเกมสล็อตจากหมวดที่เปิดให้บริการจริงบนเว็บไซต์`,
  },
  {
    q: `${BRAND_NAME} มีโปรโมชั่นอะไรให้สมาชิกเลือกบ้าง?`,
    a: `โปรโมชั่นหลักตามข้อมูลที่กำหนดมี คืนยอดเสีย 0.3% และ แนะนำเพื่อน 0.8% โดยแต่ละรายการมีวิธีคำนวณ รอบรับสิทธิ์ และเงื่อนไขแตกต่างกัน สมาชิกควรตรวจสอบรายละเอียดล่าสุดจากหน้าโปรโมชั่นก่อนกดรับโบนัส`,
  },
  {
    q: `สมัครสมาชิก ${BRAND_NAME} ต้องทำอย่างไร และติดต่อแอดมินได้ตอนไหน?`,
    a: `การสมัครแบ่งเป็น 3 ขั้นตอน ได้แก่ เข้าหน้าสมัคร กรอกข้อมูลบัญชี และยืนยันการสมัครก่อน Login ส่วนแอดมินระบุว่าเปิดให้บริการตลอด 24 ชั่วโมง โดยควรตรวจสอบช่องทางติดต่อหลักและเวลาตอบกลับจริงจากหน้าเว็บไซต์`,
  },
];

// Section 6's three sub-points, split at the brief's own label boundary: the
// `title` is the "ขั้นตอนที่ N ..." label (content.txt lines 16-18) and the
// `description` is the remainder of that same line, verbatim. FeatureHighlights
// renders each title as an <h3> under section 6's single H2.
// The icons are decorative and live inside an aria-hidden plate, so none of them
// is ever part of an accessible name. The accent alternates pink / gold / pink
// — the logo's own two-colour pair, not two brightnesses of one pink.
const signupSteps = [
  {
    icon: "🌐",
    title: "ขั้นตอนที่ 1 เข้าหน้าสมัครสมาชิก",
    description: `เลือกเมนูสมัครจากทางเข้าหลักของ ${BRAND_NAME} ตรวจสอบชื่อเว็บไซต์และช่องทางที่ใช้งานให้ถูกต้องก่อนดำเนินการต่อ`,
    accent: "pink" as const,
  },
  {
    icon: "📝",
    title: "ขั้นตอนที่ 2 กรอกข้อมูลและตั้งรหัสผ่าน",
    description: "ระบุข้อมูลตามแบบฟอร์มที่ระบบกำหนด พร้อมตั้งรหัสผ่านที่คาดเดายากและไม่ใช้ซ้ำกับบัญชีอื่น",
    accent: "gold" as const,
  },
  {
    icon: "✅",
    title: "ขั้นตอนที่ 3 ยืนยันข้อมูลและ Login",
    description:
      "ตรวจสอบรายละเอียดที่กรอก อ่านเงื่อนไขให้ครบถ้วน และยืนยันการสมัครตามขั้นตอนของเว็บไซต์ ก่อนเข้าสู่ระบบเพื่อดูหมวดเกมและข้อมูลบัญชีสมาชิก",
    accent: "pink" as const,
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// One highlight colour only: #ff6cbb, against the inherited body colour #fde8f3
// (BRAND_TEXT). The paragraphs below carry no colour class of their own: every
// ContentBox* card in this mix already sets
// `text-left text-base leading-relaxed text-[#fde8f3]` on the element holding
// the slot, so the prose inherits it and no page-level override can drift from
// the card. No paragraph carries mx-auto or max-w-* either — the cards cap their
// own width, and the only max-w-* on the page is the one capping each slide,
// which is an image and not prose.

// No breadcrumb: this is the homepage, so a trail from the root to itself would
// be a single self-referential crumb. Every URL in the graph is derived by
// pageGraph from `site:` — no domain is typed out in this file, no URL is built
// with `+`, and no Review / AggregateRating / sameAs / address / email node is
// passed. `description` is the exact same string MainLayout gets, and `faqs` is
// the exact same array <Faq> gets.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <LatestWinners />

  <ContentBoxFloatingBadge as="h1" title={`${BRAND_NAME} ฟาสล็อตเว็บตรง เล่นสล็อตระบบแท้ Login ใช้งานง่าย`}>
    <p>
      {BRAND_NAME}
      <strong class="text-[#ff6cbb]">ฟาสล็อตเว็บตรงที่นำเสนอทางเข้าเล่นสล็อตออนไลน์ผ่านระบบ Login ใช้งานง่าย</strong>
      รองรับทั้งมือถือและคอมพิวเตอร์ พร้อมรวมเกมสล็อตหลายแนวไว้ในแพลตฟอร์มเดียว
      <strong class="text-[#ff6cbb]">ไม่ว่าจะเป็นสล็อตคลาสสิก เกมโบนัส หรือฟรีสปิน</strong>
      สมาชิกสามารถเลือกค่าย ค้นหาเกม และตรวจสอบข้อมูลบัญชีได้สะดวกตลอดวัน ส่วนการยืนยันว่าเป็นสล็อตระบบแท้หรือเว็บตรง
      <strong class="text-[#ff6cbb]">ควรตรวจสอบข้อมูลผู้ให้บริการและค่ายเกมที่เชื่อมต่อจริงก่อนใช้งาน</strong>
    </p>
  </ContentBoxFloatingBadge>

  <ContentBoxTwoCyberCut
    as="h2"
    title={`${BRAND_NAME} ทางเข้าหลัก เล่นสล็อตได้ทุกค่าย แตกง่ายทุกเกม`}
    titleleft="ทางเข้าหลักและหมวดเกม"
    titleright="ก่อนเชื่อคำว่าแตกง่าย">
    <p slot="left">
      {BRAND_NAME}
      <strong class="text-[#ff6cbb]">ทางเข้าหลักสำหรับผู้ที่สนใจเกมสล็อตจากค่ายต่างๆ</strong>
      โดยเน้นการจัดหมวดหมู่ให้ค้นหาเกมได้สะดวก
      <strong class="text-[#ff6cbb]">มีทั้งสล็อตวงล้อทั่วไป เกมที่มีฟีเจอร์พิเศษ และเกมโบนัสให้เลือกตามความสนใจ</strong>
      ระบบ Login ช่วยให้สมาชิกเข้าถึงข้อมูลเครดิต ประวัติรายการ และหมวดเกมได้จากบัญชีเดียว
      <strong class="text-[#ff6cbb]">พร้อมรองรับการใช้งานผ่านหน้าจอมือถือโดยไม่ต้องสลับหลายเว็บไซต์</strong>
    </p>
    <p slot="right">
      สำหรับคำว่า สล็อตแตกง่ายทุกเกม
      <strong class="text-[#ff6cbb]">ควรพิจารณาจากรายละเอียดของเกมแต่ละรายการ</strong>
      <strong class="text-[#ff6cbb]">เพราะผลการหมุนเป็นแบบสุ่มและไม่มีเกมใดรับประกันว่าจะชนะทุกครั้ง</strong>
      สมาชิกสามารถตรวจสอบตารางจ่าย อัตราการคืนเงินผู้เล่น และช่วงเดิมพันก่อนเริ่มเล่น
      <strong class="text-[#ff6cbb]">ส่วนจำนวนค่ายที่เปิดให้บริการจริงควรอ้างอิงจากรายชื่อที่แสดงบนเว็บไซต์</strong>
    </p>
  </ContentBoxTwoCyberCut>

  <ContentBox as="h2" title={`โปรโมชั่นเล่นสล็อต ${BRAND_NAME} เว็บตรงในตำนาน`}>
    <p>
      โปรโมชั่นเล่นสล็อต {BRAND_NAME}
      <strong class="text-[#ff6cbb]">มีสิทธิพิเศษสำหรับสมาชิกตามกิจกรรมที่เปิดให้บริการ</strong>
      โดยเน้นโบนัสคืนยอดเสียและกิจกรรมแนะนำเพื่อน สมาชิกสามารถตรวจสอบรายการที่มีสิทธิ์รับ ยอดคำนวณ และสถานะโบนัสจากบัญชีตามระบบที่กำหนด
      <strong class="text-[#ff6cbb]">แต่ละโปรโมชั่นอาจมีเงื่อนไขเกี่ยวกับประเภทเกม รอบรับสิทธิ์ และการใช้โบนัสแตกต่างกัน</strong>
      จึงควรอ่านรายละเอียดก่อนกดรับทุกครั้ง
    </p>
  </ContentBox>

  <ContentBoxSevenThreeNeumorphism as="h3" title="โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสทุกวัน">
    <p slot="left">
      สมาชิก {BRAND_NAME} ที่มียอดเสียตรงตามข้อกำหนดสามารถตรวจสอบสิทธิ์รับ
      <strong class="text-[#ff6cbb]">โบนัสคืนยอดเสีย 0.3% ตามรอบประจำวันที่เว็บไซต์กำหนด</strong>
      ระบบจะคำนวณจากยอดที่เข้าเกณฑ์ก่อนแสดงจำนวนโบนัส หากรองรับการโอนโบนัสเข้ายูสอัตโนมัติ สมาชิกสามารถตรวจสอบยอดและประวัติการรับสิทธิ์ได้จากบัญชี
      <strong class="text-[#ff6cbb]">โดยควรตรวจสอบรอบตัดยอด ค่ายเกมที่ร่วมรายการ และเงื่อนไขการใช้โบนัสให้ครบถ้วน</strong>
    </p>
    <Picture
      slot="right"
      src={imgCashback}
      loading="lazy"
      fetchpriority="low"
      widths={[348, 480, 600]}
      sizes="(max-width: 697px) calc(100vw - 98px), (max-width: 767px) 600px, (max-width: 1399px) calc(30vw - 72px), 348px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt={`ภาพโปรโมชั่นคืนยอดเสียของ ${BRAND_NAME} เป็นงานอาร์ตสี่เหลี่ยมจัตุรัสโทนชมพูสดสลับดำ กลางภาพค่อนไปทางซ้ายเป็นสาวสวมหูกระต่ายชมพู ผมสีเงินขาว ใส่ต่างหูรูปหัวใจและหูกระต่ายผ้าซาติน ในชุดชมพูสลับขาวผูกโบว์ชมพู กำลังขยิบตาและยื่นมือออกมาทางซ้าย มุมขวาบนเป็นเหรียญตรา ${BRAND_NAME} ที่มีสาวผมน้ำตาลใส่หูกระต่าย ไพ่เอซสองใบ และวงล้อเลข 777 สีทอง อยู่เหนือตัวอักษร ${BRAND_NAME} สามมิติสีชมพูกลิตเตอร์ รอบภาพมีเหรียญทอง ไพ่เอซโพดำกับโพแดง และชิปคาสิโนชมพูสลับขาวที่มีมงกุฎทองลอยกระจายอยู่ ด้านล่างเป็นแท่นโพเดียมสีทอง กลางภาพเป็นคำว่า โปรโมชั่น ตัวอักษรชมพูสามมิติขนาดใหญ่ใต้มงกุฎทอง ถัดลงมาบนแผ่นป้ายสีเข้มขอบชมพูเป็นคำว่า คืนยอดเสีย คู่กับเลข 0.3% ขนาบด้วยรูปหัวใจชมพูดวงเล็ก`}
      class="mx-auto h-auto w-full max-w-[600px] rounded-2xl border border-[#ff3fa4]/55 shadow-[0_0_28px_rgba(255,63,164,0.3)]"
    />
  </ContentBoxSevenThreeNeumorphism>

  <ContentBoxSevenThree as="h3" title="โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด">
    <p slot="left">
      สมาชิกสามารถใช้ลิงก์แนะนำ {BRAND_NAME}
      <strong class="text-[#ff6cbb]">เพื่อเชิญเพื่อนเข้ามาสมัคร</strong>
      เมื่อเพื่อนมียอดใช้งานตรงตามเงื่อนไข ระบบจะคำนวณ
      <strong class="text-[#ff6cbb]">โบนัสแนะนำเพื่อน 0.8% จากยอดที่เข้าเกณฑ์</strong>
      พร้อมให้ตรวจสอบจำนวนเพื่อนและสถานะโบนัสผ่านบัญชี
      <strong class="text-[#ff6cbb]">ส่วนคำว่าไม่จำกัดควรระบุให้ชัดว่าหมายถึงจำนวนเพื่อนที่แนะนำ</strong>
      จำนวนครั้งในการรับสิทธิ์ หรือวงเงินโบนัส เพื่อให้สมาชิกเข้าใจข้อกำหนดตรงกัน
    </p>
    <Picture
      slot="right"
      src={imgReferral}
      loading="lazy"
      fetchpriority="low"
      widths={[352, 480, 600]}
      sizes="(max-width: 697px) calc(100vw - 98px), (max-width: 767px) 600px, (max-width: 1399px) calc(30vw - 68px), 352px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt={`ภาพโปรโมชั่นแนะนำเพื่อนของ ${BRAND_NAME} เป็นงานอาร์ตสี่เหลี่ยมจัตุรัสชุดเดียวกัน โทนชมพูสดสลับดำ กลางภาพเป็นสาวสวมหูกระต่ายชมพูคนเดิม ผมสีเงินขาว ใส่ต่างหูรูปหัวใจและโบว์ชมพู กำลังขยิบตาและเหยียดแขนออกมาทางซ้าย มีริบบิ้นชมพูเรืองแสงพลิ้วอยู่ด้านหลัง มุมขวาบนเป็นเหรียญตรา ${BRAND_NAME} ที่มีสาวผมน้ำตาลใส่หูกระต่าย ไพ่เอซ และวงล้อเลข 777 สีทอง อยู่เหนือตัวอักษร ${BRAND_NAME} สามมิติสีชมพูกลิตเตอร์ ด้านขวาเป็นไพ่เอซโพดำกับเอซโพแดง มุมขวาล่างเป็นชิปคาสิโนชมพูที่มีมงกุฎทอง รอบภาพมีเหรียญทองลอยกระจายและมีแท่นโพเดียมสีทองอยู่ด้านล่าง กลางภาพเป็นคำว่า โปรโมชั่น ตัวอักษรชมพูสามมิติขนาดใหญ่ใต้มงกุฎทอง ถัดลงมาบนแผ่นป้ายสีเข้มเป็นคำว่า แนะนำเพื่อน และ โบนัส คู่กับเลข 0.8% ขนาบด้วยรูปหัวใจชมพูดวงเล็ก`}
      class="mx-auto h-auto w-full max-w-[600px] rounded-2xl border border-[#f5c53d]/55 shadow-[0_0_28px_rgba(245,197,61,0.3)]"
    />
  </ContentBoxSevenThree>

  <ContentBoxPremium as="h2" title={`สมัครเล่นสล็อต ${BRAND_NAME} ง่ายๆ 3 ขั้นตอน`}>
    <p>
      การสมัครเล่นสล็อต {BRAND_NAME}
      <strong class="text-[#ff6cbb]">สามารถดำเนินการผ่านหน้าสมัครสมาชิกของเว็บไซต์ที่เปิดให้บริการ</strong>
      โดยมีขั้นตอนตั้งแต่กรอกข้อมูลจนถึงยืนยันบัญชี
      <strong class="text-[#ff6cbb]">ผู้สมัครควรตรวจสอบโดเมนหลักและข้อมูลผู้ให้บริการก่อนส่งข้อมูลส่วนตัว</strong>
      พร้อมอ่านข้อกำหนดการใช้งานและตรวจสอบอายุที่กฎหมายอนุญาตในพื้นที่ของตน
    </p>
  </ContentBoxPremium>

  <FeatureHighlights items={signupSteps} />

  <ContentBoxTwoNeumorphism
    as="h2"
    title={`แอดมิน ${BRAND_NAME} คอยให้บริการ 24 ชั่วโมง`}
    titleleft="ช่องทางติดต่อหลัก"
    titleright="แจ้งปัญหาอย่างไรให้ตรงประเด็น">
    <p slot="left">
      แอดมิน {BRAND_NAME}
      <strong class="text-[#ff6cbb]">มีช่องทางสำหรับสมาชิกที่ต้องการสอบถามเกี่ยวกับการสมัคร การเข้าสู่ระบบ Login ไม่สำเร็จ เกมไม่แสดง โปรโมชั่นไม่เข้าบัญชี หรือรายการธุรกรรมที่อยู่ระหว่างตรวจสอบ</strong>
      โดยระบุเวลาให้บริการตลอด 24 ชั่วโมง
      <strong class="text-[#ff6cbb]">สมาชิกสามารถแจ้งปัญหาผ่านช่องทางติดต่อหลักที่เว็บไซต์กำหนด</strong>
      พร้อมรายละเอียดที่เกี่ยวข้องเพื่อให้เจ้าหน้าที่ตรวจสอบได้ตรงประเด็น
    </p>
    <p slot="right">
      หากพบปัญหาเข้าสู่ระบบไม่ได้
      <strong class="text-[#ff6cbb]">ควรแจ้งข้อความแจ้งเตือนและเวลาที่เกิดเหตุ</strong>
      ส่วนปัญหาเกมสล็อตควรระบุชื่อเกมและค่ายที่ใช้งาน หากเป็นเรื่องโปรโมชั่นควรแจ้งชื่อกิจกรรมและรอบรับสิทธิ์ ทั้งนี้
      <strong class="text-[#ff6cbb]">ไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น</strong>
      แม้จะอ้างว่าเป็นเจ้าหน้าที่ของเว็บไซต์ก็ตาม
    </p>
  </ContentBoxTwoNeumorphism>

  <Faq as="h2" title={`คำถามที่พบบ่อยเกี่ยวกับ ${BRAND_NAME}`} faqs={faqs} />

  <LoginRtpSection />

  <ReviewCardSumo />

  <Navfoot />
</MainLayout>
