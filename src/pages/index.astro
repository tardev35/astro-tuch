---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ProviderGrid from "../components/ProviderGridPremium.astro";
import ReviewCardSumo from "../components/ReviewCardSumo.astro";
import LatestWinners from "../components/LatestWinnersPremium.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq3.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgPromo from "../assets/slide1.png";

const pageTitle = "LOBBYBKK คาสิโนระบบออโต้ โปรโมชั่นดีสุด ปลอดภัย เข้าเล่นได้ 24ชม.";

const pageDescription =
  "ทางเข้า LOBBYBKK คาสิโนเว็บตรงระบบออโต้ โปรดีมาแรง คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% หน้าเว็บปลอดภัยเชื่อถือได้ ฝากถอนอัตโนมัติรวดเร็ว ทีมงานดูแลตลอด 24 ชม.";

const onboardingSteps = [
  {
    icon: "📝",
    title: "สมัครสมาชิก",
    description: "กรอกข้อมูลสมัครสมาชิกผ่านระบบออนไลน์ให้ครบถ้วน ใช้เวลาไม่กี่นาทีก็พร้อมเริ่มใช้งาน",
    accent: "gold" as const,
  },
  {
    icon: "💳",
    title: "เข้าสู่ระบบและฝากเครดิต",
    description: "เข้าสู่ระบบแล้วฝากเครดิตผ่านระบบฝากถอนอัตโนมัติ ทำรายการได้เองตลอด 24 ชั่วโมง",
    accent: "blue" as const,
  },
  {
    icon: "🎮",
    title: "เลือกเกมเดิมพัน",
    description: "เลือกเล่นเกมที่ต้องการผ่านมือถือหรือคอมพิวเตอร์ได้ทันที ครบทั้งสล็อต คาสิโน และกีฬา",
    accent: "gold" as const,
  },
];

const faqs = [
  {
    q: "เข้าเล่น LOBBYBKK ผ่านมือถือต้องติดตั้งโปรแกรมเพิ่มหรือไม่",
    a: "ไม่ต้องติดตั้งโปรแกรมเพิ่มเติม สมาชิกเข้าใช้งาน LOBBYBKK ผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ได้โดยตรง รองรับทั้งระบบ Android และ iOS พร้อมปรับการแสดงผลให้เหมาะกับทุกขนาดหน้าจอโดยอัตโนมัติ ไม่ว่าจะอยู่ที่บ้าน ที่ทำงาน หรือระหว่างเดินทาง ก็เปิดเล่นต่อจากจุดเดิมได้ทันที",
  },
  {
    q: "LOBBYBKK รวมเกมเดิมพันประเภทไหนบ้าง",
    a: "LOBBYBKK รวบรวมเกมเดิมพันออนไลน์จากผู้ให้บริการชั้นนำไว้ในที่เดียว ทั้งเกมสล็อต คาสิโนสด กีฬา หวย และเกมยอดนิยมอื่น ๆ พร้อมอัปเดตเกมใหม่อย่างต่อเนื่อง สมาชิกเลือกใช้งานได้สะดวกผ่านระบบเดียว โดยไม่ต้องสลับหลายเว็บไซต์",
  },
  {
    q: "ก่อนเข้าเล่นควรตรวจอะไรให้ตรงทางเข้า LOBBYBKK",
    a: "ควรตรวจชื่อเว็บไซต์ การเชื่อมต่อ HTTPS โลโก้ และปลายทางของปุ่มเข้าสู่ระบบให้ตรงกันก่อนกรอกข้อมูล โดยเฉพาะลิงก์ที่ส่งมาจากข้อความส่วนตัว เพราะทางเข้า LOBBYBKK ที่แท้จริงมีมาตรฐานเดียวกันทุกช่องทาง หากมีคนขอรหัสผ่านหรือข้อมูลธนาคารผ่านแชตควรหยุดทันที",
  },
  {
    q: "ระบบฝากถอนของ LOBBYBKK ใช้เวลาเท่าไหร่",
    a: "ระบบฝากถอนอัตโนมัติเปิดให้บริการตลอด 24 ชั่วโมง รองรับทั้งบัญชีธนาคารและวอลเลท สมาชิกฝากเครดิต ถอนเงิน และตรวจสอบสถานะรายการได้ด้วยตนเองผ่านระบบ หากยอดยังไม่เข้าให้ตรวจประวัติรายการก่อนทำซ้ำ เพราะรายการแรกอาจอยู่ระหว่างประมวลผล",
  },
  {
    q: "สมัครสมาชิก LOBBYBKK เริ่มเล่นได้เร็วแค่ไหน",
    a: "เริ่มต้นใช้งานได้ง่ายเพียงสมัครสมาชิกผ่านระบบออนไลน์พร้อมกรอกข้อมูลให้ครบถ้วน จากนั้นเข้าสู่ระบบและฝากเครดิตผ่านระบบฝากถอนอัตโนมัติ ก็เลือกเล่นเกมที่ต้องการผ่านมือถือหรือคอมพิวเตอร์ได้ทันที หากพบปัญหาระหว่างสมัครสามารถติดต่อแอดมิน LOBBYBKK ได้ตลอด 24 ชั่วโมง",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxPremium as="h1" title="LOBBYBKK คาสิโนระบบเกมออโต้ ครบครันทุกเรื่องเดิมพัน">
    <p class="text-left text-base leading-relaxed text-[#f0e9fc]">
      <strong class="text-[#a78bfa]">LOBBYBKK</strong> พร้อมให้บริการสำหรับผู้ที่ต้องการเล่นเกมคาสิโนออนไลน์ผ่านระบบอัตโนมัติ รองรับการใช้งานทั้งมือถือและคอมพิวเตอร์
      เข้าใช้งานได้สะดวกทุกที่ทุกเวลา พร้อมระบบฝากถอนอัตโนมัติที่ช่วยให้การทำธุรกรรมรวดเร็ว และมีทีมงานคอยดูแลสมาชิกตลอด 24 ชั่วโมง เพื่อให้การใช้งานเป็นไปอย่างต่อเนื่อง
    </p>
  </ContentBoxPremium>

  <SmoothCarousel />

  <ContentBoxFloatingBadge as="h2" title="ทางเข้า LOBBYBKK คาสิโนเว็บตรง เดิมพันระบบออโต้">
    <p class="text-left text-base leading-relaxed text-[#f0e9fc]">
      สมาชิกสามารถเข้าสู่ระบบ LOBBYBKK ผ่านทางเข้าเว็บหลักที่รองรับทุกอุปกรณ์ ไม่ว่าจะเป็นสมาร์ตโฟน แท็บเล็ต หรือคอมพิวเตอร์ โดยไม่ต้องติดตั้งโปรแกรมเพิ่มเติม
      ระบบได้รับการพัฒนาให้มีความเสถียร โหลดรวดเร็ว และรองรับการใช้งานได้ตลอดทั้งวัน ช่วยให้เลือกเล่นเกมคาสิโนได้อย่างลื่นไหล
    </p>
  </ContentBoxFloatingBadge>

  <ProviderGrid />

  <ContentBoxSevenThreePremium title="คาสิโน LOBBYBKK โปรดีมาแรง คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8%">
    <Picture
      slot="left"
      src={imgPromo}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์ LOBBYBKK คืนยอดเสียทุกวัน รับโบนัส 0.3% พื้นหลังธีมคาสิโนสีม่วงนีออน พร้อมไพ่และชิปคาสิโน"
      class="mx-auto h-auto w-full rounded-2xl border border-[#7c3aed]/25 shadow-[0_10px_30px_rgba(124,58,237,0.18)]"
    />
    <div slot="right">
      <p class="text-left text-base leading-relaxed text-[#f0e9fc]">
        LOBBYBKK มีโปรโมชั่นสำหรับสมาชิกที่อัปเดตอย่างต่อเนื่อง เพื่อเพิ่มความคุ้มค่าในการใช้งาน โดยสมาชิกสามารถตรวจสอบรายละเอียดและเงื่อนไขของแต่ละรายการได้ผ่านหน้าเว็บไซต์
        เช่น โปรโมชั่นคืนยอดเสีย 0.3% และโปรโมชั่นแนะนำเพื่อนรับโบนัส 0.8% ตามเงื่อนไขที่กำหนด เพื่อให้เลือกใช้สิทธิ์ได้อย่างเหมาะสม
      </p>
    </div>
  </ContentBoxSevenThreePremium>

  <ContentBox as="h2" title="หน้าเว็บ LOBBYBKK เล่นง่าย ปลอดภัย เชื่อถือได้">
    <p class="text-left text-base leading-relaxed text-[#f0e9fc]">
      หน้าเว็บไซต์ได้รับการออกแบบให้ใช้งานง่าย รองรับทั้งผู้เล่นใหม่และสมาชิกปัจจุบัน สามารถจัดการข้อมูลบัญชี ฝากเครดิต ถอนเงิน และตรวจสอบประวัติการทำรายการได้ด้วยตนเองผ่านระบบอัตโนมัติ
      รองรับทั้งบัญชีธนาคารและวอลเลท เพื่อเพิ่มความสะดวกในการใช้งานในทุกช่วงเวลา
    </p>
  </ContentBox>

  <ContentBoxSpecial as="h2" title="Login LOBBYBKK เข้าเล่นได้ตลอด 24 ชม.">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f0e9fc]">
      สมาชิกสามารถเข้าสู่ระบบและใช้งานได้ตลอด 24 ชั่วโมง หากพบปัญหาเกี่ยวกับการสมัครสมาชิก การเข้าสู่ระบบ การฝากถอน การรับโปรโมชั่น หรือการใช้งานเกมคาสิโนออนไลน์
      สามารถติดต่อทีมงาน LOBBYBKK ได้ทุกเวลา
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#f0e9fc]">
      เจ้าหน้าที่พร้อมให้คำแนะนำ ตรวจสอบข้อมูล และช่วยแก้ไขปัญหาอย่างรวดเร็ว เพื่อให้สมาชิกใช้งานได้อย่างสะดวกและมั่นใจในทุกขั้นตอน
    </p>
  </ContentBoxSpecial>

  <LatestWinners />

  <ContentBox>
    <p class="text-left text-lg font-black text-[#a78bfa]">เริ่มต้นใช้งานได้ง่ายเพียง 3 ขั้นตอน</p>
    <FeatureHighlights items={onboardingSteps} />
    <p class="mt-6 text-left text-base leading-relaxed text-[#f0e9fc]">
      หากพบปัญหาเกี่ยวกับการสมัครสมาชิก การเข้าสู่ระบบ การฝากถอน การใช้งานเกม หรือมีข้อสงสัยเกี่ยวกับบริการต่าง ๆ ของเว็บไซต์ สามารถติดต่อแอดมิน LOBBYBKK ได้ตลอด 24 ชั่วโมง
      ทีมงานพร้อมให้คำแนะนำ ตรวจสอบข้อมูล และช่วยแก้ไขปัญหาอย่างรวดเร็ว เพื่อให้สมาชิกใช้งานได้อย่างต่อเนื่องและมั่นใจในทุกขั้นตอน
    </p>
  </ContentBox>

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#a78bfa] to-[#7c3aed] px-4 py-3 text-sm font-black whitespace-nowrap text-white shadow-[0_10px_30px_rgba(124,58,237,0.26)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(124,58,237,0.4)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>

    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#4c1d95]/70 bg-[#150c24]/85 px-4 py-3 text-sm font-black whitespace-nowrap text-[#e5e7eb] backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:border-[#7c3aed] hover:bg-[#1c1030]/85 hover:shadow-[0_15px_40px_rgba(156,163,175,0.35)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>
  </div>

  <Faq title="คำถามที่พบบ่อยเกี่ยวกับ LOBBYBKK" faqs={faqs} />

  <ReviewCardSumo />

  <Navfoot />
</MainLayout>
