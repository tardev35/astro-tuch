---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement6.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBox from "../components/ContentBox.astro";
import Faq from "../components/Faq.astro";
import LatestWinners3 from "../components/LatestWinners3.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// Title and description are the brief's own Title/Description lines, verbatim.
// A brief-supplied description ships at whatever length it was written — it is
// not padded up to the 150-character floor.
const pageTitle = "HENGDEE89 เว็บพนันออนไลน์ที่1 ในไทย รวมครบทุกการเดิมพัน";

const pageDescription = "HENGDEE89 เว็บพนันออนไลน์ที่1 ในไทย รวมเกมครบ จัดโปรมาแรง โบนัสแตกได้ทุกยูส สมัครเลือกเดิมตามต้องการได้เลย";

// The ticker copy is passed explicitly rather than relying on the component's
// default — every Announcement* variant's default belongs to whichever brand
// wired it in last. No emoji in this string: an emoji baked into a text prop
// cannot be given its own aria-hidden span.
const announcement =
  "HENGDEE89 เว็บพนันออนไลน์ที่1 ในไทย รวมเกมครบทั้งสล็อต บาคาร่า คาสิโนสด รูเล็ต เสือมังกร เกมไพ่ หวย และกีฬาไว้ในบัญชีเดียว • คืนยอดเสียทุกวัน 0.3% และแนะนำเพื่อนรับโบนัส 0.8% ตามเงื่อนไขของแต่ละโปรโมชั่น • ระบบฝากถอนอัตโนมัติ ทำรายการเองได้ตลอด 24 ชั่วโมง • แอดมิน HENGDEE89 พร้อมช่วยตรวจสอบรายการทุกวัน";

// The brief's three registration steps. They are list items in the docx, not
// headings, so they render as an <ol> — turning them into cards with their own
// titles would add an h3 tier the brief does not have.
const steps = [
  "สมัคร HENGDEE89 ผ่านหน้าเว็บไซต์และกรอกข้อมูลที่ระบบกำหนด",
  "Login เข้าสู่บัญชีและฝากเครดิตผ่านระบบฝากถอนอัตโนมัติ",
  "เลือกหมวดหมู่เกม ตรวจสอบรายละเอียด และเลือกเดิมพันตามความต้องการ",
];

// One array, used by both <Faq> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last.
const faqs = [
  {
    q: "HENGDEE89 มีเกมเดิมพันอะไรให้เลือกบ้าง?",
    a: "ระบบมีเกมหลายหมวดหมู่ เช่น สล็อต บาคาร่า คาสิโนสด รูเล็ต หวย และกีฬา รวมถึงเกมเดิมพันประเภทอื่น ๆ สมาชิกสามารถตรวจสอบเกมและค่ายที่เปิดให้บริการล่าสุดผ่านหน้าเว็บไซต์ได้โดยตรง",
  },
  {
    q: "โปรโมชั่นคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% รับอย่างไร?",
    a: "สมาชิกสามารถตรวจสอบสิทธิ์ผ่านหน้าโปรโมชั่น โดยคืนยอดเสีย 0.3% จะคำนวณจากยอดที่เข้าเงื่อนไข ส่วนโบนัสแนะนำเพื่อน 0.8% จะคำนวณตามกิจกรรมจากลิงก์แนะนำ ทั้งสองโปรโมชั่นควรตรวจสอบข้อกำหนดล่าสุดก่อนกดรับ",
  },
  {
    q: "หากฝากถอน HENGDEE89 แล้วรายการไม่เข้าต้องทำอย่างไร?",
    a: "ตรวจสอบสถานะธุรกรรมและข้อมูลบัญชีที่ใช้ทำรายการก่อน หากเครดิตยังไม่เข้าหรือรายการถอนยังค้าง สามารถติดต่อแอดมิน HENGDEE89 พร้อมแจ้งรายละเอียดและเวลาที่ทำรายการ เพื่อให้ทีมงานช่วยตรวจสอบได้ตลอด 24 ชั่วโมง",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <SmoothCarousel />

  <ContentBoxNeumorphism as="h1" title="HENGDEE89 เว็บพนันออนไลน์ที่1 ในไทย เซียนเดิมพันให้การยอมรับมากที่สุด">
    <p class="text-left text-base leading-relaxed text-[#f7e4dc]">
      <strong class="text-[#ffe98a]">HENGDEE89</strong> พร้อมให้บริการสมาชิกที่ต้องการเล่นเกมพนันออนไลน์ผ่านมือถือและคอมพิวเตอร์ โดยรวบรวมเกมเดิมพันหลายประเภทไว้ภายในบัญชีเดียว พร้อมโปรโมชั่นสำหรับสมาชิกทั้งคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8% ตามเงื่อนไข
      ระบบฝากถอนอัตโนมัติช่วยให้ทำรายการได้สะดวก และมีแอดมินคอยดูแลการใช้งานตลอด 24 ชั่วโมง
    </p>
  </ContentBoxNeumorphism>

  <ContentBoxFloatingBadge as="h2" title="เว็บพนัน HENGDEE89 รวมเกมครบทุกการเดิมพันออนไลน์">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f7e4dc]">
        สมาชิกสามารถเลือกเกมเดิมพันออนไลน์ได้หลากหลายหมวดหมู่ ไม่ว่าจะเป็นเกมสล็อต บาคาร่า คาสิโนสด รูเล็ต เสือมังกร เกมไพ่ หวย และการเดิมพันกีฬา โดยระบบจัดหมวดหมู่ให้ค้นหาได้ง่าย รองรับการเข้าใช้งานผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์
        ช่วยให้สมาชิกเลือกเดิมพันได้ตามความสนใจผ่านบัญชีเดียว
      </p>
      <p class="text-left text-base leading-relaxed text-[#f7e4dc]">ก่อนเริ่มเดิมพันควรตรวจสอบกติกา อัตราการจ่าย และเงื่อนไขของเกมแต่ละประเภท เนื่องจากรายละเอียดและรูปแบบการเดิมพันอาจแตกต่างกัน</p>
    </div>
  </ContentBoxFloatingBadge>

  <ProviderGrid />

  <ContentBoxPremium as="h2" title="HENGDEE89 จัดโปรเกมพนันมาแรง รับโบนัสได้ทุกยูส">
    <p class="text-left text-base leading-relaxed text-[#f7e4dc]">
      HENGDEE89 มีโปรโมชั่นสำหรับสมาชิกที่เข้าเงื่อนไข โดยสามารถตรวจสอบสิทธิ์และกดรับโบนัสผ่านระบบสมาชิก โปรโมชั่นแต่ละรายการจะแสดงรายละเอียดเกี่ยวกับเปอร์เซ็นต์ วิธีคำนวณ รอบรับโบนัส และข้อกำหนดที่เกี่ยวข้อง เพื่อให้สมาชิกตรวจสอบก่อนเข้าร่วม
    </p>
  </ContentBoxPremium>

  <ContentBoxSevenThreePremium as="h3" titleright="โปรโมชั่นคืนยอดเสียทุกวัน 0.3%">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นพื้นหลังสีขาวเทา ลายเส้นทแยงสีแดงและทอง มุมบนซ้ายเป็นโลโก้ HENGDEE89 สีทองตัดแดง ถัดลงมาเป็นข้อความ โปรโมชั่น คืนยอดเสีย และ รับโบนัส 0.3% ด้านขวาเป็นหญิงสาวสวมชุดสีแดงที่มีโลโก้ HENGDEE89 อยู่บนชุด แถบด้านล่างมีสามป้าย คืนยอดเสียทุกวัน ไม่ต้องทำเทิร์น มั่นคง ปลอดภัย จ่ายจริง 100% และ ทีมงานดูแล 24 ชม. บริการรวดเร็ว"
      class="mx-auto h-auto w-full rounded-2xl border border-[#fdd32d]/45 shadow-[0_10px_30px_rgba(253,211,45,0.22)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f7e4dc]">
      สมาชิกที่มียอดเสียตรงตามข้อกำหนดสามารถตรวจสอบสิทธิ์รับโบนัสคืนยอดเสีย 0.3% ตามรอบที่กำหนด ระบบจะแสดงยอดที่นำมาคำนวณและโบนัสที่สามารถรับได้ ก่อนกดรับควรตรวจสอบประเภทเกมที่ร่วมรายการและเงื่อนไขการถอนให้เรียบร้อย
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBoxSevenThreeNeumorphism as="h3" titleright="โปรโมชั่นแนะนำเพื่อน โบนัส 0.8%">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นพื้นหลังสีขาวเทา มีลายเส้นทแยงสีแดงพาดผ่าน มุมบนซ้ายเป็นโลโก้ HENGDEE89 ตัวอักษร HENG สีทองและ DEE สีแดง ถัดลงมาเป็นแถบสีแดงข้อความ โปรโมชั่น แนะนำเพื่อน และริบบิ้นสีทองข้อความ รับโบนัส 0.8% ด้านขวาเป็นหญิงสาวสวมเสื้อสายเดี่ยวสีแดงสลับเทา กำลังชี้มือมาที่ข้อความ"
      class="mx-auto h-auto w-full rounded-2xl border border-[#fdd32d]/45 shadow-[0_10px_30px_rgba(253,211,45,0.22)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f7e4dc]">
      สมาชิกสามารถคัดลอกลิงก์แนะนำของตนเองและแชร์ให้เพื่อนสมัคร HENGDEE89 เมื่อมียอดการใช้งานตรงตามเงื่อนไข ระบบจะคำนวณโบนัสแนะนำเพื่อน 0.8% โดยสมาชิกสามารถติดตามยอดและตรวจสอบสิทธิ์ผ่านบัญชีของตนเองได้
    </p>
  </ContentBoxSevenThreeNeumorphism>

  <ContentBoxTwoPremium as="h2" title="สมัครเล่น HENGDEE89 เลือกเดิมพันได้ตามต้องการ">
    <div slot="left" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f7e4dc]">เริ่มต้นสมัครสมาชิกและเข้าใช้งานได้ง่ายเพียง 3 ขั้นตอน</p>
      <p class="text-left text-base leading-relaxed text-[#f7e4dc]">
        ระบบรองรับการใช้งานผ่านมือถือและคอมพิวเตอร์ หลังสมัครเรียบร้อยสามารถตรวจสอบเกม โปรโมชั่น เครดิต และประวัติรายการต่าง ๆ ได้จากบัญชีสมาชิก โดยการเดิมพันมีความเสี่ยงและไม่สามารถรับประกันผลกำไรได้ ควรกำหนดงบประมาณก่อนเล่นทุกครั้ง
      </p>
    </div>
    <ol slot="right" class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f7e4dc]">
      {
        steps.map((step, i) => (
          <li class="flex items-start gap-3 rounded-2xl border border-[#a97a08]/45 bg-[#0d0303]/70 p-4">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-[#ffe98a] via-[#fdd32d] to-[#a97a08] text-sm font-black text-[#0d0303]">{i + 1}</span>
            <span>{step}</span>
          </li>
        ))
      }
    </ol>
  </ContentBoxTwoPremium>

  <ContentBox as="h2" title="ติดต่อแอดมินเว็บ HENGDEE89 ได้ตลอด 24 ชั่วโมง">
    <p class="text-left text-base leading-relaxed text-[#f7e4dc]">
      หากพบปัญหาเกี่ยวกับการสมัครสมาชิก การเข้าสู่ระบบ ฝากเงิน ถอนเงิน เครดิตไม่เข้า การรับโปรโมชั่น หรือการเข้าเล่นเกม สามารถติดต่อแอดมิน HENGDEE89 ได้ตลอด 24 ชั่วโมง ทีมงานพร้อมช่วยตรวจสอบรายการและแนะนำขั้นตอนการใช้งาน
      เพื่อให้สมาชิกแก้ไขปัญหาได้สะดวกและกลับมาใช้งานระบบได้อย่างต่อเนื่อง
    </p>
  </ContentBox>

  <Faq title="คำถามที่พบบ่อยเกี่ยวกับ HENGDEE89" faqs={faqs} />

  <LatestWinners3 />

  <LoginRtpSection />

  <ReviewCardSumo2 />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#ffe98a] via-[#fdd32d] to-[#a97a08] px-4 py-3 text-sm font-black whitespace-nowrap text-[#0d0303] shadow-[0_10px_30px_rgba(253,211,45,0.28)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(253,211,45,0.42)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#fdd32d]/50 bg-gradient-to-r from-[#2a0b0b] to-[#0d0303] px-4 py-3 text-sm font-black whitespace-nowrap text-[#ffe98a] shadow-[0_10px_30px_rgba(253,211,45,0.16)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#ffe98a]/70 hover:text-[#f5322e] hover:shadow-[0_15px_40px_rgba(211,20,17,0.28)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>
  </div>

  <Navfoot />
</MainLayout>
