import Announcement from "../components/Announcement5.astro";
import LatestWinners from "../components/LatestWinners4.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBox3Three from "../components/ContentBox3Three.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import ContentBoxTwo from "../components/ContentBoxTwo.astro";
import Faq from "../components/Faq3.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import { pageGraph } from "../lib/schema";
import promoCashback from "../assets/slide2.png";
import promoReferral from "../assets/slide1.png";

// VARIANT ROTATION THIS ROUND, decided in .claude/brand-spec-ruaythear168club.md §3
// and NOT re-picked here: the outgoing brand (เงินทอง168) is rotated out of every
// family at once — Announcement5 replaces Announcement2, LatestWinners4 replaces
// LatestWinners2, Faq3 replaces Faq2, ReviewCardSumo2 replaces the base
// ReviewCardSumo, and the ContentBox shape-mix drops FloatingBadge /
// 3ThreeCyberCut / Neumorphism / SevenThreeNeumorphism / SevenThree / ContentBox
// (base) / TwoCyberCut for Premium / 3Three / Special / SevenThreeFloatingBadge /
// SevenThreeCyberCut / CyberCut / Two — **zero file overlap with the outgoing
// brand's mix apart from FeatureHighlights.** NavbarStyle6 + FooterPremiumSumo are
// the layout's pair this round and the brand font moves google-sans -> kanit; all
// of that is the orchestrator's shared-chrome step, not this page's.
// ⚠️ ContentBox.astro (the base) is NOT in this round's homepage mix, but it is
// still always-live shared chrome — terms, privacy, 404, /promotion, /ทางเข้า and
// the button pages all render through it — so the orchestrator still owns and
// rethemes it. This page neither imports nor edits it.
// FeatureHighlights is the one repeat from last round, and for a structural
// reason: it is the only component in the library that carries the shape "one H2
// + three short sub-points", which this brief genuinely has (ขั้นตอนที่ 1/2/3).
// Every unused *Style / *Premium / *Cyber / *Huay / *CyberCut / *FloatingBadge
// sibling, the other Faq* and Announcement* files, the other LatestWinners* and
// ReviewCardSumo all stay on disk as inventory for the next brand — nothing was
// deleted, and the earlier brands' hues still inside them are expected drift.
//
// Eight widgets this template usually offers are deliberately absent, and they are
// named without their file extension on purpose because the playbook's "is this
// component live?" check is a bare-filename grep: ProviderGrid and
// ProviderGridPremium are out because this brief names NO game studio, bank,
// wallet or regulator at all — not one — GameRankingBoard has no ranking to carry,
// SmoothCarousel has no brief section asking for a carousel, LoginRtpSection is out
// because its RTP table would put a concrete RTP figure on the page while the brief
// only ever mentions ค่า RTP as a concept and immediately hedges it, and
// FeaturedGames / PopularGamesStrip / LottoGrid would all have to invent game or
// market names the brief never writes. BankStrip IS rendered, but only because
// FooterPremiumSumo imports it itself as part of that variant's shape; this page
// never pulls it in. This is NOT a lottery brand, so nothing here links to
// /ตรวจหวย or /แนวทาง either — both pages are parked in src/pages-disabled/.
//
// <Announcement /> runs bare on purpose: Announcement5's default message is this
// brand's copy, written from this brief by the orchestrator, and every sub-page
// calls it bare too — so passing an override here is exactly how the ticker ends up
// saying two different things on two pages of the same site.
//
// PALETTE — ⚠️⚠️ **THIS ROUND IS A LIGHT THEME, A 180-DEGREE FLIP FROM THE
// OUTGOING BRAND** (brand-spec §2). bg.json for this drop is
// {"mode":"color","color":"#dbe6ff"}, a pale periwinkle-blue page background, and
// bg.json is the ONLY source of that value: ⚠️ the outgoing round (เงินทอง168) was
// 29210f, a dark olive-brown, so anyone copying last round's direction gets dark
// brown cards floating on pale blue.
// Direction this round: **content = LIGHT cards + DARK ink**, chrome = DARK indigo.
// Every ContentBox* and FeatureHighlights on this page runs LIGHT surfaces
// (#ffffff raised / #eef4ff mid / #dce9fb inset / #f4e4d3 cream as the second
// material) with DARK ink #16294a (= BRAND_TEXT, 13.9:1 on white, 11.2:1 on the
// page). ⚠️ Head, foot and the two ledgers (NavbarStyle6, FooterPremiumSumo,
// Announcement5, Navfoot, BankStrip, **LatestWinners4 and ReviewCardSumo2**) run
// the CHROME ramp (#111a3f sunk / #202a66 mid / #31408a raised) with pale ink
// #e9f1ff / #adc0e4 and cyan edges. **Head and foot point the OPPOSITE way from
// the page body this round, and that is deliberate — do not "fix" either half
// towards the other.** ⚠️ ReviewCardSumo2's own header rail sits directly on the
// page background rather than inside its panel, so that one line is dark ink on
// the light page while the ledger rows below it are pale ink on chrome.
// Read off the artwork: the logo is a woven GOLD BASKET overflowing with gold
// coins, followed by the Thai word ร่ำรวย in glossy 3-D CYAN lettering and 168 in
// chrome silver. banner1 and both slides are a CREAM-IVORY LUXURY LIVING ROOM with
// soft window light, an elderly woman with short curled silver-white hair, dark
// sunglasses, red lipstick, an ivory satin suit, pearl jewellery and a gold watch,
// reclining on a cream fabric sofa.
// ⚠️ Her skin tone, the red lipstick, the white pearls and the cream sofa fabric
// are OBJECTS IN THE PICTURE, not brand colours — none is allowed into the UI.
// ⚠️⚠️ **THE GOLD IN THE ARTWORK IS AN OBJECT, NOT A UI COLOUR.** The coin basket,
// the watch and the belt buckle are gold, but gold has led nearly every brand in
// this repo including the one immediately before this, so §2 cuts gold/yellow out
// of the UI entirely. There is **not one gold or yellow value on this page.**
// ⚠️⚠️ **#18a5e2 IS ONLY 2.6:1 ON WHITE AND MAY NEVER HOLD TEXT ON A LIGHT
// SURFACE** — it is borders, fills, auras, icon plates and active states only. Ink
// on a light surface is #16294a or #0d6b9b; ink on a #18a5e2 fill is #111a3f, never
// white. On the dark chrome #18a5e2 reaches 6.1:1 and does hold text.
// ⚠️⚠️ **CYAN/BLUE HAS LED FIVE EARLIER BRANDS HERE** — สบาย168, รวยแทร่168,
// นินจา168, สบายเบท168 and TSDET911 — **so finding "a blue" in a file proves
// NOTHING; compare by VALUE, one at a time.** This round's cyan is #18a5e2 and its
// deep blue is #0d6b9b. ⚠️ The raw `vivid` of this drop's logo.webp is 6bddfb,
// which is **one unit** from สบาย168's 6bdcfb, which is exactly why this round does
// NOT use the raw value. Values that must not survive anywhere that renders:
// 2cc3fc 6bdcfb 0a7fbd 063a57 04293d 0a4f74 9ae0fa cdf2ff ccf7ff f2fbff dff4fd
// eafaff a9e3f9 0f3a4a 06293c fdcb0c fefb6b 8a6504 (สบาย168) · 039cfa 0494f5 c3ebfc
// 04366b e3f2fc 0b2d52 f9a826 704504 (รวยแทร่168) · 32bcfb a9e9ff 07335f 0c2a3d
// 071a28 030e16 fef54b 6b5c10 (นินจา168) · 2f9ff5 a8dcff d6ecff 0b3f78 e8f4ff
// ffc82e 5c4a16 (สบายเบท168) · 0360f3 0292fb 6ec8ff 4fb4ff cfdcec 9db4d4 dde8f7
// (TSDET911) · f5ba14 fcee52 b37c0b ecd5c4 d2b9a4 29210f 3d3016 332810 201906
// 2e2512 1b1407 4d3c15 (เงินทอง168 — **the outgoing brand, highest risk**) ·
// eeae12 fded41 9f600d e0e0df c0c0bf a1a09e f4ead6 d6c6a8 291d0f 3a2713 32200f
// 1f1308 (พักยก168) · c30303 8f0505 e81313 dcb95f b8862b 96681f 4a0f0f ffeee8
// fff1ef ffdbdb (รวยแท้168) · f0bb4e ffeccb e4021b d9701a 3b1b0e 260d04 5c2a06
// (รวยเทพ168) · d4922c fdfc71 f6e3b4 a25b24 5a3310 33200a 1f1304 0a0601 1a1000
// fbf6e3 (ufalion168) · and every purple-* violet-* fuchsia-* indigo-* utility
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// **LINE green #00B900 is LINE's own semantic colour, not ours — it stays exactly
// as it is**, as do the real bank logo colours in BankStrip/LatestWinners4 and the
// green success state in the winners feed.
//
// IMAGE ROLES FOR THIS DROP (2026-10-23, brand-spec §1 and §4). Exactly TWO files
// are referenced from this page, both from this drop, and THE TEXT PRINTED ON THE
// ART is what decides the pairing — both bitmaps were opened and read this round:
//   slide2.png -> §4, because its own capsule reads คืนยอดเสีย with 0.3%
//   slide1.png -> §5, because its own capsule reads แนะนำเพื่อน with 0.8%
// The uploader overwrites both files every drop, so the numbering carries no
// meaning across brands and the capsule has to be re-read each time; trusting an
// inherited pairing would have captioned each promotion with the other's poster.
// Both alts below were written from THIS drop's bitmaps: a cream-ivory luxury
// living room with soft window light, an elderly woman with short curled
// silver-white hair, dark sunglasses, red lipstick, an ivory satin blazer over a
// cream ribbed top, pearl earrings, rings and a gold watch, one hand at the edge of
// her sunglasses while reclining on a cream sofa (slide2) or both index fingers
// pointing at the viewer with a wide smile and a gold-buckled belt (slide1), the
// logo top right with the woven gold coin basket, ร่ำรวย in cyan and 168 in chrome,
// the word โปรโมชั่น as oversized 3-D cyan Thai lettering, and a rounded
// blue-edged capsule carrying the promotion's own wording and percentage.
// ⚠️ Nothing from any earlier drop (a gold vault room, a round brass safe door,
// shelves of gold bars, gold chandeliers, a black panther statue, fanned banknotes,
// a two-pan scales emblem, a gold crown, a laurel wreath, a dragon head, a gold
// lion, a ninja, pink sakura, a maneki-neko, a greenhouse, a red tractor, a
// floodlit football stadium) is in this artwork, and none of it may enter an alt.
// Deliberately NOT imported, and every file still on disk as inventory:
// banner2.png (mtime 10-08) and banner3.png (09-27) are previous brands' article
// art, and slide3.png / slide4.png (09-29) are an older lottery brand's posters. An
// eager import IS an emit, rendered or not, so importing any of them would ship a
// competitor's picture into dist/ and turn verify-build red. There is therefore NO
// current-drop article illustration this round, and a slide is never substituted
// for one — the playbook pins slide* to ContentBoxSevenThree* blocks only, and
// these two are the round's full 2-block budget.
// banner1 and its mobile crop belong to MainLayout's own pinned globs and are never
// referenced from a page; og.png is the same, MainLayout owns it, and logo.webp
// belongs to the navbar/footer globs.
// ⚠️⚠️ **BOTH SLIDES MEASURE 600x480 ON DISK THIS ROUND** (the drop before was
// 540x600 portrait — the file on disk wins, every round). So every picture here
// carries **max-w-[600px]** (the art is never upscaled past its own bitmap) and
// **no alt names an orientation at all** — describing the drawn content is both
// accurate and future-proof against the next drop flipping the aspect again.
// The two in-card `sizes` lists are NOT interchangeable and NEITHER is inherited
// from the previous round — the variants changed, so both were recomputed from the
// classes inside the variant that actually holds that picture. Tailwind's global
// border-box means a max-w-* caps the box INCLUDING padding and border, and this
// round the two variants put their cap in DIFFERENT PLACES (on the card vs on the
// section), so even the breakpoints differ:
//   §4 ContentBoxSevenThreeFloatingBadge — max-w-7xl on the CARD (so px-4 does NOT
//      come out of the 1280 cap once it binds), card border-2 (4), p-8 (64),
//      gap-10 (40), image column md:pl-10 (40) + md:border-l (1) = 41:
//        >= 1312px : (1280 - 4 - 64 - 40) x 0.3 - 41 = 1172 x 0.3 - 41 = 311px
//        md..1311  : (100vw - 140) x 0.3 - 41        = calc(30vw - 83px)
//        700..767  : 600px (one column at p-8 exceeds the bitmap, so it caps)
//        < 700     : calc(100vw - 100px)
//   §5 ContentBoxSevenThreeCyberCut — max-w-7xl/1280 + px-4 (32) on the SECTION,
//      card border 1x2 (2), p-8 (64), gap-8 (32), image column md:border-l (1) +
//      md:pl-8 (32) = 33:
//        >= 1280px : (1280 - 32 - 2 - 64 - 32) x 0.3 - 33 = 1150 x 0.3 - 33 = 312px
//        md..1279  : (100vw - 130) x 0.3 - 33             = calc(30vw - 72px)
//        698..767  : 600px
//        < 698     : calc(100vw - 98px)
// The 1x values differ by only 1px this round, but the calc() differs by 11px AND
// the breakpoints differ by one whole step (1311 vs 1279) and the mobile branch by
// 2px — they must never be copied across, and neither may be copied from last
// round's 344/314 pair.
// Neither picture is the LCP element — MainLayout's hero banner is — so all three
// <Picture>s are loading="lazy" fetchpriority="low" decoding="async" and none ever
// takes fetchpriority="high". formats/fallbackFormat stay at the house values, and
// quality is still ONE number for both formats — tools/avif-quality-service.mjs
// rescales the AVIF side on its own, so it must never be hand-tuned per format.
//
// quality={64}, not the usual 80, because both of this drop's slides are busy
// artwork with heavy fine grain (curled hair, satin weave, the ribbed knit top, a
// whole background of soft gradient window light and the 3-D lettering's specular
// highlights), which is the case AVIF handles worst. At 80 that is exactly the
// shape that comes out LARGER than its own WebP fallback at some emitted width, and
// verify-build.mjs fails the build on precisely that. **The fix is always a LOWER
// quality, never a higher one.**
//
// VOCABULARY — brand-spec §5, the brief's own words only. ⚠️ This brand's axis is
// an **ONLINE SLOT SITE**, and the brief names NOT ONE studio, bank, wallet,
// operator or regulator.
// ⚠️⚠️ **The OUTGOING brand เงินทอง168's words must never come back**: เงินดี ·
// สล็อตเงินดี · อัตราจ่ายสูง · ค่ายเกมลิขสิทธิ์แท้100% · ลิขสิทธิ์แท้100% ·
// สถานะลิขสิทธิ์ · หลักฐานการอนุญาต · รวมเกมกว่า 1,000 เกม · ค่ายมาตรฐานสากล ·
// สล็อตคลาสสิก · เกมแนวผจญภัย · ฟีเจอร์โบนัส · สัญลักษณ์พิเศษ — **not one of them
// is in this brief**, and neither is "1,000 เกม" nor "100%".
// ⚠️ **หวย / ตรวจหวย / แนวทาง / สลาก / เลขเด็ด / 2 ตัว 100 / 3 ตัว 1,000 / แทงหวย /
// หวยรัฐบาลไทย / หวยฮานอย / หวยลาว / ลาวพัฒนา / แทงบอล / ฟุตบอล / ราคาต่อรอง /
// ค่าน้ำ / บาคาร่า / เกมไพ่ / คาสิโน / ยิงปลา / ไฮโล / เว็บตรง100% appear NOWHERE in
// this brief and must not be added back, not even once** — and neither may
// เจ้าดัง / ไม่ผ่านม้า / บัญชีม้า / ค่ายแท้ / ทดลองเล่นฟรี / โหมดทดลองเล่น
// (พักยก168), เบทต่ำ / สบายเป๋า / ยอดเข้าบริษัทโดยตรง (สบาย168), สล็อตแท้โปรเด็ด /
// ค่ายตรงมาแรง / ปี 2026 (โปรดี168), ระบบดูแลการเงิน / ปลอดภัยไม่ผ่านม้า
// (มีทรัพย์168), ถอนง่าย / ไม่มีรีวิวเสีย (ถอนชัวร์168), เศรษฐีพนันมือ1 / สูตร /
// เทคนิค (ดวงเศรษฐี168), PG SOFT / JOKER / JILI (มีโชค168), บริษัทแม่ / เว็บแม่ /
// **รวยแท้** (รวยแท้168), **รวยเทพ**, **รวยแทร่**, CEO66, SUMOHENG or BRAVO168.
// ⚠️ **ทดลองเล่น survives only as the route name /ทดลองเล่น**, which is a page that
// exists; it is not a claim this brand's copy may make about its games.
// Everything the copy says traces to src/assets/content.txt: สล็อต, เกมสล็อต,
// เกมสล็อตออนไลน์, จ่ายแพง, ปรับเรท, แตกหนัก, อัตราจ่าย, ระดับการเดิมพัน,
// เดิมพันไม่มีขั้นต่ำ, ทุนน้อยเล่นได้, ไม่อั้นจ่าย, ไม่อั้นถอน, เงินเดิมพันเริ่มต้น,
// กติกา, ตารางจ่ายรางวัล, ค่า RTP, ผู้พัฒนา, ยอดฝากขั้นต่ำ, วงเงินถอน,
// เพดานธุรกรรม, ข้อกำหนดล่าสุด, โปรโมชั่น, คืนยอดเสีย 0.3%, แนะนำเพื่อน 0.8%,
// กดรับได้ไม่จำกัด, เครดิต, ยอดเสีย, รอบสรุปยอด, ลิงก์แนะนำ, เชื่อมโยงบัญชี,
// รอบจ่ายเครดิต, สมัครสมาชิก, เข้าสู่ระบบ, ยืนยันบัญชี, คุณสมบัติผู้สมัคร,
// ข้อกำหนดด้านอายุ, นโยบายความเป็นส่วนตัว, ข้อมูลส่วนบุคคล, รหัสผ่าน, รหัส OTP,
// แอดมิน, เจ้าหน้าที่, 24ชม., ช่องทางติดต่อ, เว็บไซต์ทางการ, ประกาศล่าสุด,
// บัญชีแอบอ้าง, ฝากถอน, หมายเลขรายการ, หลักฐาน, ธุรกรรม.
// **The only figures on the page are the brief's own: 0.3% · 0.8% · 3 ขั้นตอน ·
// 24ชม.** Nothing claims a legal-entity name, a founding year, a member count, a
// concrete RTP figure or a numeric deposit minimum.
// ⚠️ This brief ADVERTISES AND HEDGES IN THE SAME BREATH: its own headings say
// เกมสล็อตจ่ายแพง, ปรับเรทแตกหนักที่สุดในวงการ, ไม่อั้นจ่าย ไม่อั้นถอน and
// กดรับได้ไม่จำกัด while its own paragraphs answer that คำกล่าวอ้างเรื่องการปรับเรท
// แตกหนักที่สุดควรพิจารณาจากข้อมูลที่ตรวจสอบได้ เนื่องจากผลลัพธ์ของเกมสล็อตมีความ
// ไม่แน่นอน, that ก็ไม่ควรสรุปว่าไม่มีเพดานธุรกรรมโดยไม่ตรวจสอบข้อกำหนดล่าสุด, and
// that การคืนเครดิตไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือทำให้มี
// โอกาสชนะมากขึ้น. Both halves ship exactly as written: the advertising words
// appear ONLY inside the headings the brief itself wrote them into and are never
// expanded into new claims of this page's own, and EVERY hedging clause ships in
// full — they are brief content, not downbeat filler to be trimmed.
//
// The brand name is never typed on this page: it is interpolated from ${BRAND_NAME}
// so it can never drift from brandProfile, including inside the three alts. No
// domain is written out anywhere here and no URL is built with `+`.
//
// Title and description are the brief's own Title / Description lines (content.txt
// lines 1-2) verbatim, with the brand name interpolated — nothing reworded, and the
// description is NOT padded up to 150 characters, because verify-build deliberately
// skips its 150-character floor on the home page.
const pageTitle = `${BRAND_NAME} เกมสล็อตจ่ายแพง ปรับเรทแตกหนักที่สุดในวงการ`;

const pageDescription = `${BRAND_NAME} เกมสล็อตจ่ายแพง เดิมพันไม่มีขั้นต่ำ ทุนน้อยเล่นได้ ไม่อั้นจ่าย ไม่อั้นถอน ปรับเรทแตกหนักที่สุดในวงการ`;

// The brief has a real H1 -> H2 -> H3 nesting this round, so the page is NOT
// flattened to H2-only. Exactly five H3s: two are the brief's own H3 lines
// (content.txt lines 9 and 11 — the two promotion sub-sections under §3's H2) and
// three are the brief's own ขั้นตอนที่ 1/2/3 sub-list under §6's H2, carried by
// FeatureHighlights, which is the one sanctioned place a docx-driven page may add
// H3s. Every component rendered here was grepped for `<h[1-6]` this round and none
// emits a hardcoded heading — every heading tag on the page comes from a prop, i.e.
// from the brief — so the printed inventory stays at exactly h1 x1, h2 x5, h3 x5.
// ⚠️ ContentBox3Three would render its three column labels as headings if asked; it
// takes the level from `as` and this page passes heading={false} (its default) AND
// no labels, so §2 renders one <h2> and no column headings at all. ContentBoxTwo is
// passed no titleleft/titleright for the same reason.
//
// The checklist, in document order, and what carries each one:
//    1 H1  ${BRAND_NAME} เกมสล็อตจ่ายแพง ปรับเรทแตกหนักที่สุดในวงการ
//          ContentBoxPremium, brief paragraph on line 4
//    2 H2  ${BRAND_NAME} สล็อตเดิมพันไม่มีขั้นต่ำ ทุนน้อยเล่นได้ ไม่อั้นจ่าย ไม่อั้นถอน
//          ContentBox3Three, line 6 split across its three columns, no labels
//    3 H2  โปรโมชั่นสมาชิก ${BRAND_NAME} กดรับได้ไม่จำกัด
//          ContentBoxSpecial, line 8 split into two halves
//    4 H3  โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน
//          ContentBoxSevenThreeFloatingBadge + slide2, line 10 left / picture right
//    5 H3  โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด
//          ContentBoxSevenThreeCyberCut + slide1, line 12 left / picture right
//    6 H2  สมัครเล่นเกมสล็อต ${BRAND_NAME} ง่ายๆ 3 ขั้นตอน
//          ContentBoxCyberCut, line 14, immediately followed by FeatureHighlights
//   6a H3  ขั้นตอนที่ 1 เข้าสู่หน้าสมัครสมาชิก            FeatureHighlights item, line 16
//   6b H3  ขั้นตอนที่ 2 กรอกข้อมูลและยืนยันบัญชี          FeatureHighlights item, line 18
//   6c H3  ขั้นตอนที่ 3 เข้าสู่ระบบและตรวจสอบรายละเอียดเกม FeatureHighlights item, line 20
//    7 H2  ช่องทางติดต่อแอดมินเว็บสล็อต ${BRAND_NAME} ตลอด 24ชม.
//          ContentBoxTwo, line 22 split into two halves, no column labels
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ ${BRAND_NAME}
//          Faq3 + explicit faqs prop, lines 24-29
// Final inventory for this page: h1 x1, h2 x5, h3 x5 — brand-spec §4's target.
//
// Both ContentBoxSevenThree* variants lay out md:grid-cols-[7fr_3fr] with the TEXT
// column FIRST, so each picture goes in slot="right": the heading always lands on
// the prose, never on the picture, and on a phone the single column reads heading,
// text, picture rather than opening with an image. Neither is passed a
// `titleright`, so neither image column carries a heading and each block emits
// exactly one.
// ⚠️ ContentBoxSevenThreeFloatingBadge IS in this round's mix and it carries
// docx §4 inside an `absolute -top-6` badge. The badge has NO `whitespace-nowrap`
// (re-grepped), is width capped at w-[92%] max-w-2xl, puts `text-center` on the
// heading itself rather than on any ancestor, and its vertical clearance was
// **recomputed from this exact sentence** in that file's frontmatter: 2 wrapped
// lines at base width, bottom edge at 54px against pt-36/144px = 90px of daylight,
// and even a pessimistic 4-line budget still clears by 36px. **pt-36 was therefore
// kept, not shrunk.** See the arithmetic block in that component.
//
// Every brief paragraph ships in full — nothing merged, nothing summarised. §2 runs
// one third per column, §3 and §7 one half per column, and NO slot receives more
// than one element, so the house rule's "one element per slot" holds everywhere
// without a wrapper <div> being needed. FeatureHighlights is a SIBLING of §6's
// ContentBoxCyberCut, not a child of its slot, for the same reason.
//
// Everything else on the page is chrome and emits no heading tag at any level:
// Announcement5, LatestWinners4 and ReviewCardSumo2 render their titles as
// <p>/<span> with an aria-label on the section, and the FAQ's questions live inside
// <summary>. The non-brief widgets sit before section 1 (the ticker, then the two
// promo posters) and after section 8 (the winners feed, then the review ledger,
// then Navfoot) — never spliced between two content sections.

// One array, used by both <Faq> and the FAQPage node — never the component's own
// defaults (Faq3 deliberately ships an empty list, so a forgotten prop renders an
// empty accordion rather than some previous brand's questions). The three pairs are
// the brief's own Q/A block (content.txt lines 24-29), verbatim; only the "1." /
// "2." / "3." list markers are dropped, since the accordion is the list. Every
// answer keeps the brief's own hedge — both halves are brief content.
const faqs = [
  {
    q: `${BRAND_NAME} มีเกมสล็อตที่ใช้เงินเดิมพันเริ่มต้นต่ำหรือไม่?`,
    a: `ตามข้อมูลที่ระบุ ${BRAND_NAME} นำเสนอเกมสล็อตที่มีระดับการเดิมพันแตกต่างกัน โดยควรตรวจสอบยอดเดิมพันขั้นต่ำของแต่ละเกมและยอดฝากขั้นต่ำจากเว็บไซต์ก่อนทำรายการ`,
  },
  {
    q: `${BRAND_NAME} มีการปรับอัตราจ่ายให้ชนะง่ายขึ้นจริงหรือไม่?`,
    a: `ยังไม่สามารถยืนยันได้จากคำโฆษณาเพียงอย่างเดียว ควรตรวจสอบค่า RTP ตารางจ่ายรางวัล และข้อมูลจากผู้พัฒนาเกม โดยค่า RTP เป็นสถิติระยะยาว ไม่ใช่การรับประกันว่าจะชนะในแต่ละครั้ง`,
  },
  {
    q: `หากสมัครสมาชิกหรือฝากถอนมีปัญหา ควรติดต่อที่ไหน?`,
    a: `สามารถตรวจสอบช่องทางติดต่อเจ้าหน้าที่จากเว็บไซต์ทางการของ${BRAND_NAME} เพื่อแจ้งปัญหาพร้อมหลักฐานรายการที่เกี่ยวข้อง โดยไม่ส่งรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น`,
  },
];

// The brief's own three registration steps (content.txt lines 15-20), title = the
// ขั้นตอน line, description = the paragraph directly under it, both verbatim. The
// accents alternate the artwork's two materials — lead cyan / second warm cream —
// down the list; the icons track what each step actually asks the visitor to do:
// check the address and open the signup page, fill the form in and confirm the
// account, then log in and read the game details. ⚠️ The ⚖️ of the outgoing brand is
// not reusable here (this brand's emblem is a woven gold coin basket), and neither
// is 🐉 / 🎰 / 👑 / 🦁 / 🐰 / ⚽ / 🥬 / 🌽 / 🚜 or any lottery symbol — brand-spec §1
// lists all of them as previous brands' imagery that is absent from this artwork.
// These three are step icons rather than genre icons, which is what keeps them
// honest.
// ⚠️ `accent: "cyan"` — the union in FeatureHighlights was "gold" | "cream" when
// this round started, for the outgoing brand's gold plates. §2 has NO gold or
// yellow as a UI colour this round, so the gold branch was removed from the type as
// well as the implementation; "gold" no longer compiles here, which is the point.
const registrationSteps = [
  {
    icon: "🔎",
    title: "ขั้นตอนที่ 1 เข้าสู่หน้าสมัครสมาชิก",
    description: "ตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง จากนั้นเลือกเมนูสมัครสมาชิกและอ่านเงื่อนไขการเปิดบัญชี รวมถึงนโยบายการจัดเก็บข้อมูลส่วนบุคคลก่อนกรอกข้อมูล",
    accent: "cyan" as const,
  },
  {
    icon: "📝",
    title: "ขั้นตอนที่ 2 กรอกข้อมูลและยืนยันบัญชี",
    description: "กรอกข้อมูลตามที่ระบบกำหนด ตรวจสอบความถูกต้องก่อนยืนยัน และตั้งรหัสผ่านที่คาดเดาได้ยาก ไม่ควรใช้ข้อมูลของบุคคลอื่นหรือเปิดเผยรหัส OTP ให้ใครทราบ",
    accent: "cream" as const,
  },
  {
    icon: "🔑",
    title: "ขั้นตอนที่ 3 เข้าสู่ระบบและตรวจสอบรายละเอียดเกม",
    description: "หลังลงทะเบียนเรียบร้อย สามารถศึกษารายชื่อเกมสล็อต กติกาการเล่น ยอดเดิมพันขั้นต่ำ และรายละเอียดโปรโมชั่นที่เปิดให้บริการ หากมีข้อสงสัยควรสอบถามเจ้าหน้าที่ผ่านช่องทางทางการก่อนทำรายการ",
    accent: "cyan" as const,
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space that
// splits the word — the copy must read identically with the tags removed. No two
// <strong> elements are adjacent either: every pair is separated by at least one
// run of plain text, so the whitespace between them can never collapse.
// ONE highlight colour only: **#0d6b9b** (brand-spec §2 reserves the deep blue for
// headings, links and <strong>), against the inherited body colour #16294a
// (= BRAND_TEXT).
// ⚠️⚠️ **#18a5e2 may NEVER be used here — 2.6:1 on white.** #a9d7f2, #dce9fb,
// #eef4ff, #f4e4d3 and #e4cbb3 are surfaces and may never hold a glyph either.
// The paragraphs below carry no colour class of their own: every ContentBox* card
// in this mix already sets `text-left text-base leading-relaxed text-[#16294a]` on
// the element holding the slot, so the prose inherits it and no page-level override
// can drift from the card. No paragraph carries mx-auto or max-w-* either — the
// cards cap their own width, and the only max-w-* on the page are the three capping
// the slides, which are images and not prose. No slot's copy names a colour.

// No breadcrumb: this is the homepage, so a trail from the root to itself would be
// a single self-referential crumb. Every URL in the graph is derived by pageGraph
// from `site:` — no domain is typed out in this file, no URL is built with `+`, and
// no Review / AggregateRating / sameAs / address / email node is passed.
// `description` is the exact same string MainLayout gets, and `faqs` is the exact
// same array <Faq> gets.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <div class="mx-auto mb-10 grid w-full max-w-7xl grid-cols-2 gap-4 px-4">
    <Picture
      src={promoCashback}
      alt={`โปสเตอร์โปรโมชั่นคืนยอดเสีย 0.3% ของ ${BRAND_NAME} เป็นผู้หญิงสูงวัยผมสั้นดัดลอนสีขาวเงิน สวมแว่นกันแดดเลนส์ดำ ทาลิปสติกแดง ใส่สูทซาตินสีงาช้าง ยกมือขวาแตะขอบแว่น นั่งเอนบนโซฟาสีครีม มุมบนขวาเป็นโลโก้ตะกร้าสานทองคำใส่เหรียญทอง กลางภาพเป็นคำว่า โปรโมชั่น ตัวอักษรไทยสามมิติสีฟ้าไซยาน ใต้ลงมาเป็นแคปซูลมนขอบฟ้าเขียนว่า คืนยอดเสีย ต่อท้ายด้วยเลข 0.3% ตัวโต`}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 300, 450, 600]}
      sizes="(max-width: 1247px) calc(50vw - 24px), 600px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={64}
      class="mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#a9d7f2] object-contain shadow-[0_0_28px_rgba(24,165,226,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#18a5e2] hover:shadow-[0_0_40px_rgba(24,165,226,0.32)]"
    />

    <Picture
      src={promoReferral}
      alt={`โปสเตอร์โปรโมชั่นแนะนำเพื่อน โบนัส 0.8% ของ ${BRAND_NAME} เป็นผู้หญิงสูงวัยคนเดียวกัน ยิ้มกว้างและชี้นิ้วมาทางผู้ชมด้วยมือทั้งสองข้าง ใส่สูทซาตินสีงาช้างกับเข็มขัดหัวทอง นั่งบนโซฟาสีครีม มุมบนขวาเป็นโลโก้ตะกร้าสานทองคำใส่เหรียญทอง กลางภาพเป็นคำว่า โปรโมชั่น ตัวอักษรไทยสามมิติสีฟ้าไซยานพร้อมขีดประกายสีฟ้า ใต้ลงมาเป็นแคปซูลมนขอบฟ้าเขียนว่า แนะนำเพื่อน ต่อท้ายด้วยเลข 0.8% ตัวโต`}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 300, 450, 600]}
      sizes="(max-width: 1247px) calc(50vw - 24px), 600px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={64}
      class="mx-auto h-auto w-full max-w-[600px] rounded-xl border border-[#a9d7f2] object-contain shadow-[0_0_28px_rgba(24,165,226,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#18a5e2] hover:shadow-[0_0_40px_rgba(24,165,226,0.32)]"
    />
  </div>

  <ContentBoxPremium as="h1" title={`${BRAND_NAME} เกมสล็อตจ่ายแพง ปรับเรทแตกหนักที่สุดในวงการ`}>
    <p>
      {BRAND_NAME} นำเสนอเกมสล็อตออนไลน์หลายรูปแบบ
      <strong class="text-[#0d6b9b]">พร้อมข้อมูลอัตราจ่าย ระดับการเดิมพัน และโปรโมชั่นสำหรับสมาชิก</strong>
      ภายในเว็บไซต์มีรายละเอียดเกี่ยวกับการสมัครสมาชิก ช่องทางฝากถอน และการติดต่อเจ้าหน้าที่ให้ตรวจสอบก่อนใช้งาน ส่วนคำกล่าวอ้างเรื่องการปรับเรทแตกหนักที่สุดควรพิจารณาจากข้อมูลที่ตรวจสอบได้
      <strong class="text-[#0d6b9b]">เนื่องจากผลลัพธ์ของเกมสล็อตมีความไม่แน่นอน และไม่มีเว็บไซต์ใดสามารถรับประกันการชนะในแต่ละรอบได้</strong>
    </p>
  </ContentBoxPremium>

  <ContentBox3Three as="h2" title={`${BRAND_NAME} สล็อตเดิมพันไม่มีขั้นต่ำ ทุนน้อยเล่นได้ ไม่อั้นจ่าย ไม่อั้นถอน`}>
    <p slot="left">
      {BRAND_NAME} นำเสนอข้อมูลเกมสล็อตที่มีระดับการเดิมพันแตกต่างกัน
      <strong class="text-[#0d6b9b]">รวมถึงเกมที่กำหนดเงินเดิมพันเริ่มต้นในระดับต่ำ</strong>
    </p>
    <p slot="center">
      ผู้ใช้งานสามารถศึกษากติกา ตารางจ่ายรางวัล และค่า RTP ที่ผู้พัฒนาเปิดเผยก่อนเลือกเกมได้
      <strong class="text-[#0d6b9b]">โดยควรตรวจสอบยอดฝากขั้นต่ำและวงเงินถอนตามเงื่อนไขจริง</strong>
      เพราะแต่ละบริการอาจกำหนดข้อจำกัดแตกต่างกัน
    </p>
    <p slot="right">
      แม้จะมีข้อความระบุว่าไม่อั้นจ่ายหรือไม่อั้นถอน
      <strong class="text-[#0d6b9b]">ก็ไม่ควรสรุปว่าไม่มีเพดานธุรกรรมโดยไม่ตรวจสอบข้อกำหนดล่าสุด</strong>
    </p>
  </ContentBox3Three>

  <ContentBoxSpecial as="h2" title={`โปรโมชั่นสมาชิก ${BRAND_NAME} กดรับได้ไม่จำกัด`} iconleft="🎁" iconright="📋">
    <p slot="left">
      {BRAND_NAME} นำเสนอข้อมูลโปรโมชั่นสำหรับสมาชิก
      <strong class="text-[#0d6b9b]">โดยมีรายการคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8%</strong>
      ซึ่งแต่ละโปรโมชั่นอาจกำหนดประเภทเกมที่เข้าร่วม ยอดที่นำมาคำนวณ และรอบเวลารับเครดิตแตกต่างกัน
    </p>
    <p slot="right">
      แม้จะระบุว่าสามารถกดรับได้ไม่จำกัด
      <strong class="text-[#0d6b9b]">แต่ควรตรวจสอบจำนวนครั้งที่รับสิทธิ์ได้จริง</strong>
      รวมถึงเงื่อนไขการใช้โบนัสและการถอนเงินจากประกาศล่าสุด เพื่อให้เข้าใจรายละเอียดก่อนตัดสินใจเข้าร่วม
    </p>
  </ContentBoxSpecial>

  <ContentBoxSevenThreeFloatingBadge as="h3" title="โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน">
    <p slot="left">
      โปรโมชั่นคืนยอดเสีย 0.3% เป็นรายการที่ระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขรายวัน
      <strong class="text-[#0d6b9b]">สมาชิกควรตรวจสอบว่าเกมสล็อตประเภทใดเข้าร่วมรายการ มีรอบสรุปยอดเวลาใด และต้องกดรับเครดิตด้วยตนเองหรือระบบดำเนินการให้อัตโนมัติ</strong>
      รวมถึงศึกษาข้อกำหนดการใช้เครดิตและการถอนเงินให้ครบถ้วน เพราะยอดเสียบางรายการอาจไม่เข้าเกณฑ์รับสิทธิ์ ทั้งนี้
      <strong class="text-[#0d6b9b]">การคืนเครดิตไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือทำให้มีโอกาสชนะมากขึ้น</strong>
    </p>
    <Picture
      slot="right"
      src={promoCashback}
      loading="lazy"
      fetchpriority="low"
      widths={[311, 480, 600]}
      sizes="(max-width: 699px) calc(100vw - 100px), (max-width: 767px) 600px, (max-width: 1311px) calc(30vw - 83px), 311px"
      decoding="async"
      formats={["avif", "webp"]}
