---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBox from "../components/ContentBox.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import Faq from "../components/Faq2.astro";
import LatestWinners from "../components/LatestWinners3.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// Title and description are the brief's own Title/Description lines, used
// verbatim. A brief-supplied description is never padded up to the 150-char
// floor and never topped up from the H1/H2.
const pageTitle = "OSAKA198 แทงสล็อต1บาท ไม่จำกัดยอด เล่นได้ทุกค่าย ในเว็บเดียว";

const pageDescription = "OSAKA198 แทงสล็อต1บาท ไม่มีขั้นต่ำ ไม่อั้น ไม่จำกัดยอด เล่นได้ทุกค่าย พร้อมโปรโมชั่นสุดปัง รับได้เฉพาะสมาชิกเท่านั้น สมัครเลย";

// The ticker copy is passed explicitly rather than relying on the component's
// default — every Announcement* variant's default belongs to whichever brand
// wired it in last. No emoji in this string: an emoji baked into a text prop
// cannot be given its own aria-hidden span, and this marquee prints the string
// twice.
const announcement =
  "OSAKA198 แทงสล็อต1บาท ไม่มีขั้นต่ำ ไม่จำกัดจำนวนครั้ง เล่นได้ทุกค่าย ในเว็บเดียว • รวมเกมสล็อตจากหลายค่ายไว้ในบัญชีเดียว ทั้งเกมยอดนิยม เกมใหม่ เกมโบนัส ฟรีสปิน และสล็อตหลายรูปแบบ • รองรับการใช้งานผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ โดยไม่ต้องสมัครแยกหลายบัญชี • ขั้นต่ำจริงของแต่ละเกมขึ้นอยู่กับผู้ให้บริการ ควรตรวจสอบช่วงเดิมพันที่แสดงในเกมก่อนเริ่มเล่น • โปรโมชั่นแนะนำเพื่อน โบนัส 0.8% และโปรโมชั่นคืนยอดเสีย โบนัส 0.3% ตามเงื่อนไขที่กำหนด • สมัคร OSAKA198 ด้วย 3 ขั้นตอนง่าย ๆ ผ่านมือถือหรือคอมพิวเตอร์ • แอดมิน OSAKA198 ติดต่อสอบถามได้ตลอด 24 ชั่วโมง";

// One array, used by both <Faq> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last.
const faqs = [
  {
    q: "OSAKA198 มีเกมสล็อตเดิมพันเริ่มต้น 1 บาทหรือไม่?",
    a: "หากเกมที่เลือกเปิดช่วงเดิมพันเริ่มต้น 1 บาท สมาชิกสามารถเลือกเดิมพันในระดับดังกล่าวได้ แต่ขั้นต่ำจริงจะแตกต่างกันตามค่ายและเกม ควรตรวจสอบตัวเลขที่แสดงในเกมก่อนเริ่มเล่น",
  },
  {
    q: "โบนัส OSAKA198 0.8% และ 0.3% รับอย่างไร?",
    a: "โบนัส 0.8% เป็นโปรโมชั่นแนะนำเพื่อนสำหรับรายการที่ตรงตามเงื่อนไข ส่วนโบนัส 0.3% เป็นโปรโมชั่นคืนยอดเสียตามรอบที่กำหนด สมาชิกควรตรวจสอบวิธีคำนวณและเงื่อนไขล่าสุดก่อนกดรับทุกครั้ง",
  },
  {
    q: "หากฝากถอน OSAKA198 แล้วรายการไม่เข้าต้องทำอย่างไร?",
    a: "ตรวจสอบสถานะธุรกรรมในบัญชีก่อน หากเครดิตยังไม่เข้าหรือรายการถอนยังค้าง สามารถติดต่อแอดมิน OSAKA198 พร้อมแจ้งจำนวนเงิน เวลา และรายละเอียดรายการ เพื่อให้ทีมงานช่วยตรวจสอบได้ตลอด 24 ชั่วโมง",
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb. Every URL in the graph is derived
// by pageGraph from `site:` — no domain is typed out in this file.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <ContentBoxCyberCut as="h1" title="OSAKA198 แทงสล็อต1บาท ไม่มีขั้นต่ำ ไม่จำกัดจำนวนครั้ง">
    <p class="text-left text-base leading-relaxed text-[#e8ddc8]">
      <strong class="text-[#f7f1e4]">OSAKA198</strong> เปิดบริการสำหรับผู้ที่ต้องการเล่นสล็อตออนไลน์ผ่านมือถือและคอมพิวเตอร์ โดยมีเกมจากหลายค่ายให้เลือกในบัญชีเดียว
      <strong class="text-[#e4cc95]">พร้อมตัวเลือกเดิมพันเริ่มต้นระดับต่ำตามเงื่อนไขของแต่ละเกม</strong>
      สมาชิกสามารถตรวจสอบโปรโมชั่น ฝากถอน และประวัติการใช้งานได้ผ่านระบบ พร้อมแอดมินคอยให้คำแนะนำตลอด 24 ชั่วโมง เพื่อช่วยดูแลตั้งแต่ขั้นตอนสมัครไปจนถึงการใช้งานภายในเว็บไซต์
    </p>
  </ContentBoxCyberCut>

  <ProviderGrid />

  <ContentBoxTwoNeumorphism as="h2" title="OSAKA198 เล่นสล็อตไม่อั้น ไม่จำกัดยอด เล่นได้ทุกค่าย ในเว็บเดียว">
    <p slot="left" class="text-left text-base leading-relaxed text-[#e8ddc8]">
      สมาชิก <strong class="text-[#f7f1e4]">OSAKA198</strong> สามารถเลือกเล่นสล็อตจากหลากหลายค่ายผ่านระบบเดียว มีทั้งเกมยอดนิยม เกมใหม่ เกมโบนัส ฟรีสปิน และสล็อตหลายรูปแบบ รองรับการใช้งานผ่านสมาร์ตโฟน แท็บเล็ต
      และคอมพิวเตอร์ <strong class="text-[#e4cc95]">โดยไม่ต้องสมัครแยกหลายบัญชี</strong>
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#e8ddc8]">
      หากต้องการเล่นสล็อตเริ่มต้น 1 บาท ควรตรวจสอบช่วงเดิมพันของเกมนั้นก่อนเริ่มเล่น เนื่องจากขั้นต่ำจริงขึ้นอยู่กับผู้ให้บริการและแต่ละเกม ส่วนเงื่อนไข “ไม่จำกัดยอด” หรือ “ไม่อั้น”
      <strong class="text-[#e4cc95]">ควรยึดวงเงินที่ระบบแสดง ณ เวลาทำรายการเป็นหลัก</strong>
    </p>
  </ContentBoxTwoNeumorphism>

  <GameRankingBoard />

  <ContentBoxPremium as="h2" title="โปรโมชั่นสุดปัง OSAKA198 จัดพิเศษ เฉพาะสมาชิก">
    <p class="text-left text-base leading-relaxed text-[#e8ddc8]">
      สมาชิกสามารถ Login <strong class="text-[#f7f1e4]">OSAKA198</strong> เพื่อตรวจสอบโปรโมชั่นที่เปิดให้รับผ่านบัญชีของตนเอง โดยมีทั้งโบนัสแนะนำเพื่อนและโปรโมชั่นคืนยอดเสีย
      <strong class="text-[#e4cc95]">แต่ละรายการอาจกำหนดยอดที่ใช้คำนวณ รอบรับ และเงื่อนไขการถอนแตกต่างกัน</strong>
      ก่อนกดรับควรอ่านรายละเอียดล่าสุดให้ครบถ้วน
    </p>
  </ContentBoxPremium>

  <ContentBoxSevenThreeNeumorphism as="h3" title="โปรโมชั่นแนะนำเพื่อน โบนัส 0.8%">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อน 0.8% ของ OSAKA198 พื้นหลังดำเงาแบบแล็กเกอร์ประดับลายทองและเหรียญทอง ด้านบนเป็นโลโก้ OSAKA198 ตัวอักษร OSAKA สีทองเมทัลลิกต่อด้วยเลข 198 สีเงินแปรงขัด ถัดลงมาเป็นป้ายคำว่า โปรโมชั่น ตามด้วยข้อความว่า แนะนำเพื่อน วางเหนือตัวเลข 0.8% ขนาดใหญ่สีทองโครเมียม ตรงกลางเป็นผู้หญิงสวมชุดราตรีสีทองยกมือชี้ไปที่ตัวเลข ข้าง ๆ มีกล่องของขวัญ กองเหรียญทอง และวงล้อรูเล็ต ด้านล่างเป็นป้ายวงรีสามอันเขียนว่า ชวนเพื่อนง่าย รับโบนัสทันที กับ รับโบนัส จากยอดเพื่อนเล่น และ มั่นคง ปลอดภัย เชื่อถือได้ 100%"
      class="mx-auto h-auto w-full rounded-2xl border border-[#d1ae72]/40 shadow-[0_10px_30px_rgba(209,174,114,0.25)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#e8ddc8]">
      สมาชิกสามารถแชร์ลิงก์แนะนำส่วนตัวให้เพื่อน เมื่อเพื่อนสมัครและมียอดใช้งานตรงตามข้อกำหนด <strong class="text-[#e4cc95]">ระบบจะคำนวณโบนัสแนะนำเพื่อน 0.8%</strong> ตามเงื่อนไข สามารถตรวจสอบจำนวนการแนะนำ
      ยอดที่เข้าเกณฑ์ และโบนัสที่มีสิทธิ์รับผ่านบัญชีสมาชิกได้โดยตรง
    </p>
  </ContentBoxSevenThreeNeumorphism>

  <ContentBoxSevenThreeCyberCut as="h3" title="โปรโมชั่นคืนยอดเสีย โบนัส 0.3%">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นคืนยอดเสีย 0.3% ของ OSAKA198 พื้นหลังดำเงาแบบแล็กเกอร์ประดับลายทอง ด้านบนเป็นโลโก้ OSAKA198 ตัวอักษร OSAKA สีทองเมทัลลิกต่อด้วยเลข 198 สีเงินแปรงขัด ถัดลงมาเป็นป้ายคำว่า โปรโมชั่น ตามด้วยข้อความว่า คืนยอดเสีย วางเหนือตัวเลข 0.3% ขนาดใหญ่สีทอง ตรงกลางเป็นผู้หญิงสวมชุดราตรีสีทองยกมือชี้ไปที่ตัวเลข ข้าง ๆ มีกล่องของขวัญ วงล้อสล็อตขึ้นเลข 777 และกองเหรียญทอง ด้านล่างเป็นป้ายวงรีสามอันเขียนว่า คืนยอดเสียทุกวัน กดรับได้เอง กับ มั่นคง ปลอดภัย เชื่อถือได้ 100% และ สิทธิพิเศษมากมาย สำหรับสมาชิก"
      class="mx-auto h-auto w-full rounded-2xl border border-[#d1ae72]/40 shadow-[0_10px_30px_rgba(209,174,114,0.25)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#e8ddc8]">
      <strong class="text-[#e4cc95]">สมาชิกที่มียอดเสียตรงตามข้อกำหนดสามารถตรวจสอบสิทธิ์รับโบนัสคืนยอดเสีย 0.3%</strong> ตามรอบที่ <strong class="text-[#f7f1e4]">OSAKA198</strong> กำหนด ระบบจะแสดงยอดที่นำมาคำนวณและโบนัสที่สามารถรับได้
      ก่อนกดรับควรตรวจสอบประเภทเกม รอบเวลา และเงื่อนไขของโปรโมชั่นให้ครบถ้วน
    </p>
  </ContentBoxSevenThreeCyberCut>

  <ContentBox as="h2" title="สมัคร OSAKA198 ด้วย 3 ขั้นตอนง่าย ๆ">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e8ddc8]">
        เริ่มต้นสมัคร <strong class="text-[#f7f1e4]">OSAKA198</strong> ผ่านมือถือหรือคอมพิวเตอร์ได้ด้วยขั้นตอนที่ไม่ซับซ้อน
      </p>
      <ol class="ml-5 list-decimal space-y-2 text-left text-base leading-relaxed text-[#e8ddc8] marker:font-black marker:text-[#e4cc95]">
        <li>สมัครสมาชิก OSAKA198 และกรอกข้อมูลตามที่ระบบกำหนด</li>
        <li>Login เข้าสู่บัญชีและฝากเครดิตผ่านช่องทางที่เปิดให้บริการ</li>
        <li>ตรวจสอบโปรโมชั่น เลือกค่ายและเกมสล็อตที่ต้องการก่อนเริ่มเล่น</li>
      </ol>
      <p class="text-left text-base leading-relaxed text-[#e8ddc8]">
        หลังสมัครเรียบร้อยสามารถตรวจสอบเครดิต โปรโมชั่น ประวัติรายการ และสถานะฝากถอนผ่านบัญชีสมาชิกได้
        <strong class="text-[#e4cc95]">โดยควรตั้งรหัสผ่านที่คาดเดายากและไม่เปิดเผย OTP</strong> ให้บุคคลอื่น
      </p>
    </div>
  </ContentBox>

  <LoginRtpSection />

  <ContentBoxSpecial as="h2" title="แอดมิน OSAKA198 ติดต่อสอบถามได้ตลอด 24 ชั่วโมง" iconleft="🎧" iconright="🧾">
    <p slot="left" class="text-left text-base leading-relaxed text-[#e8ddc8]">
      หากพบปัญหาเกี่ยวกับการสมัคร Login ไม่ได้ ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง โปรโมชั่นไม่แสดง หรือเข้าเกมสล็อตไม่ได้ สามารถติดต่อแอดมิน
      <strong class="text-[#f7f1e4]">OSAKA198</strong> ได้ตลอด 24 ชั่วโมง พร้อมแจ้งรายละเอียด เวลา และข้อมูลรายการที่เกี่ยวข้อง เพื่อให้เจ้าหน้าที่ช่วยตรวจสอบปัญหาได้ตรงจุด
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#e8ddc8]">
      สมาชิกใหม่ยังสามารถสอบถามเกี่ยวกับการเลือกเกม การฝากถอน หรือวิธีรับโปรโมชั่นได้ โดยหากเป็นปัญหาเกี่ยวกับธุรกรรม
      <strong class="text-[#e4cc95]">ควรเก็บหลักฐานไว้จนกว่าการตรวจสอบจะเสร็จสิ้น</strong>
    </p>
  </ContentBoxSpecial>

  <Faq title="คำถามที่พบบ่อยเกี่ยวกับ OSAKA198" faqs={faqs} />

  <LatestWinners />

  <ReviewCardSumo2 />

  <Navfoot />
</MainLayout>
