---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ProviderGridPremium from "../components/ProviderGridPremium.astro";
import Faq3 from "../components/Faq3.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import LatestWinners from "../components/LatestWinnersPremium.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// Title and description are the brief's own Title/Description lines, verbatim.
// A brief-supplied description ships at whatever length it was written — it is
// not padded up to the 150-character floor.
const pageTitle = "PLUSPSG สล็อตแตกโคตรเก่ง ไม่กั๊กยูส เบทต่ำ จ่ายสูง ทุนน้อย เล่นได้สบาย";

const pageDescription = "PLUSPSG สล็อตแตกโคตรเก่ง ทางเข้าเล่น แตกง่ายทุกเกม ไม่มีกั๊กยูส สมัครรับโบนัสแรง แม้เบทต่ำ ทุนน้อยก็เล่นได้ สมัครเล่นสล็อตแตกไว ได้ทันทีตั้งแต่ฝากแรก";

// The ticker copy is passed explicitly rather than relying on the component's
// default — every Announcement* variant's default belongs to whichever brand
// wired it in last. The string matches the variant's current default on
// purpose, so the pages that call <Announcement /> bare show the same ticker.
// No emoji in this string: an emoji baked into a text prop cannot be given its
// own aria-hidden span, and this marquee prints the string twice.
const announcement =
  "PLUSPSG สล็อตแตกโคตรเก่ง เกมเดิมพันมาแรงที่สุดในตอนนี้ • ทางเข้าปั่นสล็อต แตกง่ายทุกเกม ไม่มีกั๊กยูส เลือกได้หลายค่ายและหลายระดับการเดิมพัน • โปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไข • สมัครผ่านมือถือเพียง 3 ขั้นตอน ตรวจสอบโบนัสฝากแรกได้ทันที • แอดมิน PLUSPSG ดูแลและแก้ไขปัญหาให้สมาชิกตลอด 24 ชั่วโมง";

// The docx's three registration steps. They are list items in the docx, not
// headings, so they render as an <ol> — turning them into cards with their own
// titles would add an h3 tier the brief does not have.
const steps = [
  "สมัครสมาชิก PLUSPSG และกรอกข้อมูลตามที่ระบบกำหนด",
  "Login เข้าสู่บัญชี ฝากเครดิต และตรวจสอบโบนัสฝากแรกที่มีสิทธิ์รับ",
  "เลือกเกมสล็อตและขนาดเดิมพันที่ต้องการ ศึกษากติกาก่อนเริ่มเล่น",
];

// One array, used by both <Faq3> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last.
const faqs = [
  {
    q: "PLUSPSG มีสล็อตเบทต่ำสำหรับคนทุนน้อยหรือไม่?",
    a: "ภายในระบบมีเกมสล็อตหลายระดับการเดิมพัน รวมถึงเกมที่รองรับการเดิมพันเริ่มต้นในจำนวนต่ำ โดยขั้นต่ำจะแตกต่างกันตามเกมและผู้ให้บริการ ควรตรวจสอบช่วงเดิมพันที่แสดงภายในเกมก่อนเริ่มเล่น",
  },
  {
    q: "โบนัส PLUSPSG 0.8% และ 0.3% รับอย่างไร?",
    a: "โบนัส 0.8% เป็นโปรโมชั่นแนะนำเพื่อนสำหรับรายการที่เข้าเงื่อนไข ส่วนโบนัส 0.3% เป็นโปรโมชั่นคืนยอดเสียตามรอบที่กำหนด สมาชิกสามารถตรวจสอบยอดและรายละเอียดของแต่ละโปรโมชั่นผ่านบัญชีก่อนกดรับสิทธิ์",
  },
  {
    q: "หากฝากถอน PLUSPSG แล้วรายการไม่เข้าต้องทำอย่างไร?",
    a: "ตรวจสอบสถานะธุรกรรมในบัญชีสมาชิกก่อน หากเครดิตยังไม่เข้าหรือรายการถอนยังค้าง สามารถติดต่อแอดมิน PLUSPSG พร้อมแจ้งรายละเอียดและเวลาที่ทำรายการ เพื่อให้ทีมงานช่วยตรวจสอบได้ตลอด 24 ชั่วโมง",
  },
];

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <SmoothCarousel />

  <ContentBoxFloatingBadge as="h1" title="PLUSPSG สล็อตแตกโคตรเก่ง เกมเดิมพันมาแรงที่สุดในตอนนี้">
    <p class="text-left text-base leading-relaxed text-[#e9d6ac]">
      <strong class="text-[#fff6e0]">PLUSPSG</strong> พร้อมให้บริการสมาชิกที่ต้องการเล่นสล็อตออนไลน์ผ่านมือถือและคอมพิวเตอร์ มีเกมให้เลือกหลายรูปแบบตั้งแต่สล็อตเบทต่ำไปจนถึงเกมที่มีฟีเจอร์โบนัส
      พร้อมโปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไข ระบบสมัครและฝากถอนออกแบบให้ใช้งานได้สะดวก พร้อมแอดมินคอยดูแลและช่วยแก้ไขปัญหาตลอด 24 ชั่วโมง
    </p>
  </ContentBoxFloatingBadge>

  <ContentBoxSpecial as="h2" title="ทางเข้าปั่นสล็อต PLUSPSG แตกง่ายทุกเกม ไม่มีกั๊กยูส">
    <p slot="left" class="text-left text-base leading-relaxed text-[#e9d6ac]">
      สมาชิกสามารถเข้าสู่ PLUSPSG เพื่อเลือกเล่นสล็อตจากหลากหลายค่ายและหลายระดับการเดิมพัน มีทั้งเกมเบทต่ำ เกมโบนัส สล็อตแจ็คพอต และเกมใหม่ที่อัปเดตเข้ามาอย่างต่อเนื่อง รองรับการเล่นผ่านมือถือ แท็บเล็ต
      และคอมพิวเตอร์ โดยสามารถตรวจสอบกติกา จำนวนเพย์ไลน์ ฟีเจอร์ และช่วงการเดิมพันของแต่ละเกมก่อนเริ่มเล่นได้
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#e9d6ac]">
      ผลรางวัลของเกมสล็อตมีความไม่แน่นอน จึงไม่มีเกมหรือบัญชีผู้เล่นใดที่สามารถรับประกันว่าแตกง่ายหรือทำกำไรได้ทุกครั้ง ควรเลือกขนาดเดิมพันให้เหมาะกับเงินทุนและงบประมาณของตนเอง
    </p>
  </ContentBoxSpecial>

  <ProviderGridPremium />

  <ContentBoxCyberCut as="h2" title="โปร PLUSPSG โบนัสแรง แม้เบทต่ำ เราก็จ่ายสูง">
    <p class="text-left text-base leading-relaxed text-[#e9d6ac]">
      PLUSPSG มีโปรโมชั่นสำหรับสมาชิกที่ต้องการเพิ่มสิทธิประโยชน์ระหว่างใช้งาน แม้เลือกเล่นสล็อตเบทต่ำก็สามารถตรวจสอบโปรโมชั่นที่บัญชีมีสิทธิ์รับได้ โดยโบนัสแต่ละรายการมีวิธีคำนวณ รอบรับ
      และข้อกำหนดแตกต่างกัน แนะนำให้อ่านเงื่อนไขเกี่ยวกับยอดที่เข้าร่วมและการถอนก่อนกดรับทุกครั้ง
    </p>
  </ContentBoxCyberCut>

  <ContentBoxSevenThreePremium as="h3" title="โปรโมชั่นแนะนำเพื่อน รับโบนัส 0.8%">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600, 800]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นทรงสี่เหลี่ยม พื้นหลังดำแดงประกายทอง มุมบนซ้ายเป็นโลโก้ PLUSPSG กลางภาพเขียนว่า โปรโมชั่นแนะนำเพื่อน 0.8% ด้านขวาเป็นเทพเจ้าแห่งโชคลาภถือทองคู่กับเสือน้อยและตู้สล็อตเลข 777 ป้าย JACKPOT"
      class="mx-auto h-auto w-full rounded-2xl border border-[#e2060a]/45 shadow-[0_10px_30px_rgba(226,6,10,0.24)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#e9d6ac]">
      สมาชิกสามารถแชร์ลิงก์แนะนำส่วนตัวให้เพื่อน เมื่อเพื่อนสมัครและมียอดใช้งานตรงตามข้อกำหนด ระบบจะคำนวณโบนัสแนะนำเพื่อน 0.8% ตามเงื่อนไข สามารถตรวจสอบจำนวนเพื่อนที่แนะนำ ยอดที่ใช้คำนวณ
      และโบนัสที่มีสิทธิ์รับผ่านบัญชีสมาชิกได้โดยตรง
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBoxSevenThree as="h3" title="โปรโมชั่นคืนยอดเสีย รับโบนัส 0.3%">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600, 800]}
      sizes="(max-width: 767px) 92vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นทรงสี่เหลี่ยม พื้นหลังดำแดงประกายทอง มุมบนซ้ายเป็นโลโก้ PLUSPSG กลางภาพเขียนว่า โปรโมชั่นคืนยอดเสีย 0.3% ด้านซ้ายเป็นเทพเจ้าแห่งโชคลาภและตู้สล็อตเลข 777 ด้านขวาเป็นเสือน้อยและทับทิมสีแดง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#fbbf14]/45 shadow-[0_10px_30px_rgba(250,226,30,0.2)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#e9d6ac]">
      สมาชิกที่มียอดเสียตรงตามข้อกำหนดสามารถตรวจสอบสิทธิ์รับโบนัสคืนยอดเสีย 0.3% ตามรอบที่กำหนด ระบบจะแสดงยอดที่นำมาคำนวณและโบนัสที่สามารถกดรับได้ ก่อนรับสิทธิ์ควรตรวจสอบประเภทเกม รอบเวลา
      และเงื่อนไขของโปรโมชั่นให้ครบถ้วน
    </p>
  </ContentBoxSevenThree>

  <ContentBoxTwoPremium as="h2" title="สมัคร PLUSPSG เล่นสล็อตแตกไว ได้ทันทีตั้งแต่ฝากแรก">
    <p slot="left" class="text-left text-base leading-relaxed text-[#e9d6ac]">
      ผู้ใช้งานใหม่สามารถสมัคร PLUSPSG ผ่านมือถือได้ด้วยขั้นตอนที่ไม่ซับซ้อน หลังเปิดบัญชีสามารถตรวจสอบโปรโมชั่นฝากแรกและเกมสล็อตที่เปิดให้บริการได้ทันที โดยเริ่มต้นเพียง 3 ขั้นตอน
    </p>

    <div slot="right" class="flex flex-col gap-4">
      <ol class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#e9d6ac]">
        {
          steps.map((step, i) => (
            <li class="flex items-start gap-3 rounded-2xl border border-[#7a0304]/60 bg-[#0b0402]/70 p-4">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-[#fae21e] via-[#fbbf14] to-[#e2060a] text-sm font-black text-[#0b0402]">{i + 1}</span>
              <span>{step}</span>
            </li>
          ))
        }
      </ol>

      <p class="text-left text-base leading-relaxed text-[#e9d6ac]">
        โบนัสฝากแรกขึ้นอยู่กับโปรโมชั่นที่เปิดให้บริการในขณะนั้น ส่วนผลของเกมไม่สามารถรับประกันว่าจะได้รับรางวัลทันทีหลังฝากเงิน จึงควรกำหนดงบประมาณก่อนเล่นทุกครั้ง
      </p>
    </div>
  </ContentBoxTwoPremium>

  <ContentBoxFloatingBadge as="h2" title="แอดมิน PLUSPSG แก้ไขปัญหาให้สมาชิกได้ตลอด 24 ชั่วโมง">
    <p class="text-left text-base leading-relaxed text-[#e9d6ac]">
      หากพบปัญหาเกี่ยวกับการสมัครสมาชิก Login ไม่ได้ ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินล่าช้า โปรโมชั่นไม่แสดง หรือไม่สามารถเข้าเกมสล็อตได้ สามารถติดต่อแอดมิน PLUSPSG ได้ตลอด 24 ชั่วโมง
      พร้อมแจ้งรายละเอียดและเวลาที่พบปัญหา เพื่อให้ทีมงานตรวจสอบรายการและแนะนำขั้นตอนแก้ไขได้ตรงจุด
    </p>
  </ContentBoxFloatingBadge>

  <Faq3 title="คำถามที่พบบ่อยเกี่ยวกับ PLUSPSG" faqs={faqs} />

  <LoginRtpSection />

  <LatestWinners />

  <ReviewCardSumo2 />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#fbbf14] via-[#ff4b18] to-[#e2060a] px-4 py-3 text-sm font-black whitespace-nowrap text-[#0b0402] shadow-[0_10px_30px_rgba(226,6,10,0.28)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(226,6,10,0.42)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#c2a878]/55 bg-gradient-to-r from-[#240803] to-[#0b0402] px-4 py-3 text-sm font-black whitespace-nowrap text-[#fff6e0] shadow-[0_10px_30px_rgba(226,6,10,0.16)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#fbbf14]/80 hover:text-[#fbbf14] hover:shadow-[0_15px_40px_rgba(226,6,10,0.3)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>
  </div>

  <Navfoot />
</MainLayout>
