---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import Faq4 from "../components/Faq4.astro";
import LatestWinners from "../components/LatestWinnersPremium.astro";
import ReviewCardSumo from "../components/ReviewCardSumo.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlide1 from "../assets/slide1.png";
import imgSlide2 from "../assets/slide2.png";

// Title and description are the brief's own Title/Description lines, used
// verbatim. A brief-supplied description is never padded up to the 150-char
// floor and never topped up from the H1/H2.
const pageTitle = "UFA168 ลิ้งก์ทางเข้าตรง เกมพนันเว็บแท้ ระบบหลักแน่นอน";

const pageDescription = "ลิ้งก์ทางเข้าตรง UFA168 เกมพนันเว็บแท้ ถูกลิขสิทธิ์จากค่าย การันตีความมั่นคง ปลอดภัย เชื่อถือได้100%";

// The ticker copy is passed explicitly rather than relying on the component's
// default — every Announcement* variant's default belongs to whichever brand
// wired it in last. No emoji in this string: an emoji baked into a text prop
// cannot be given its own aria-hidden span, and this marquee prints the string
// twice.
const announcement =
  "UFA168 ลิ้งก์ทางเข้าตรง รวมเกมเดิมพันออนไลน์ครบวงจรไว้ในบัญชีเดียว • เลือกได้ทั้งสล็อต บาคาร่า คาสิโนสด เกมไพ่ กีฬา และหวย จากหลายค่ายในระบบเดียว • โปรโมชั่นแนะนำเพื่อนรับโบนัส 0.8% ตามเงื่อนไขของกิจกรรม • โปรโมชั่นคืนยอดเสียรับโบนัส 0.3% ตามรอบที่กำหนด • สมัคร UFA168 ด้วยตัวเองผ่านมือถือหรือคอมพิวเตอร์ใน 3 ขั้นตอน • แอดมิน UFA168 ตรวจสอบรายการให้ตลอด 24 ชั่วโมง";

// One array, used by both <Faq4> and the FAQPage node — never the component's
// own defaults, which belong to whichever brand shipped last.
const faqs = [
  {
    q: "UFA168 มีเกมเดิมพันอะไรให้เลือกบ้าง?",
    a: "มีเกมหลายหมวดหมู่ เช่น สล็อต บาคาร่า คาสิโนสด กีฬา หวย และเกมเดิมพันประเภทอื่น ๆ โดยสมาชิกสามารถตรวจสอบรายชื่อค่ายและเกมที่เปิดให้บริการล่าสุดจากระบบก่อนเริ่มเล่นได้",
  },
  {
    q: "โปรโมชั่น UFA168 โบนัส 0.8% และ 0.3% รับอย่างไร?",
    a: "โบนัส 0.8% เป็นโปรโมชั่นแนะนำเพื่อนสำหรับรายการที่เข้าเงื่อนไข ส่วนโบนัส 0.3% เป็นโปรโมชั่นคืนยอดเสียตามรอบที่กำหนด ควรตรวจสอบวิธีคำนวณและข้อกำหนดของแต่ละโปรโมชั่นก่อนกดรับทุกครั้ง",
  },
  {
    q: "หากลิงก์ UFA168 เข้าไม่ได้หรือฝากถอนไม่สำเร็จต้องทำอย่างไร?",
    a: "ควรหลีกเลี่ยงการสุ่มเข้าลิงก์ที่ไม่ทราบแหล่งที่มา และติดต่อแอดมินผ่านช่องทางที่เชื่อถือได้เพื่อขอข้อมูลทางเข้าปัจจุบัน หากเป็นปัญหาฝากถอนให้แจ้งจำนวนเงิน เวลา และสถานะรายการ เพื่อให้เจ้าหน้าที่ช่วยตรวจสอบต่อไปได้",
  },
];

// No breadcrumb: this is the homepage, so a trail from the root to itself
// would be a single self-referential crumb. Every URL in the graph is derived
// by pageGraph from `site:` — no domain is typed out in this file.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <ContentBoxPremium as="h1" title="UFA168 ลิ้งก์ทางเข้าตรง รวมเกมเดิมพัน ครบวงจร">
    <p class="text-left text-base leading-relaxed text-[#e6dcc2]">
      <strong class="text-[#f3db5b]">UFA168</strong> เป็นช่องทางสำหรับผู้ที่ต้องการรวมเกมเดิมพันออนไลน์หลายประเภทไว้ในบัญชีเดียว รองรับการใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์
      สมาชิกสามารถเลือกเกม ตรวจสอบโปรโมชั่น ฝากถอน และจัดการข้อมูลผ่านระบบออนไลน์ พร้อมโปรโมชั่นแนะนำเพื่อน <span class="font-black text-[#d8dce2]">0.8%</span> และคืนยอดเสีย
      <span class="font-black text-[#d8dce2]">0.3%</span> ตามเงื่อนไข รวมถึงมีแอดมินคอยให้คำแนะนำและตรวจสอบปัญหาการใช้งานตลอด 24 ชั่วโมง
    </p>
  </ContentBoxPremium>

  <ProviderGrid />

  <ContentBox as="h2" title="UFA168 เกมพนันเว็บแท้ ลิขสิทธิ์ส่งตรงจากค่าย">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e6dcc2]">
        ภายใน <strong class="text-[#f3db5b]">UFA168</strong> มีเกมเดิมพันหลายหมวดหมู่ให้เลือก ไม่ว่าจะเป็นเกมสล็อต บาคาร่า คาสิโนสด เกมไพ่ กีฬา หวย และเกมออนไลน์ประเภทอื่น ๆ
        สมาชิกสามารถเลือกค่ายและเกมที่สนใจผ่านบัญชีเดียว พร้อมตรวจสอบกติกา อัตราจ่าย และรายละเอียดการเดิมพันก่อนเริ่มเล่น เพื่อให้เข้าใจเงื่อนไขของแต่ละเกมอย่างชัดเจน
      </p>
      <p class="text-left text-base leading-relaxed text-[#e6dcc2]">
        สำหรับข้อมูลเรื่องลิขสิทธิ์หรือผู้ให้บริการเกม ควรตรวจสอบจากข้อมูลของค่ายเกมที่แสดงอยู่ในระบบโดยตรง เนื่องจากแต่ละเกมอาจมาจากผู้พัฒนาหรือผู้ให้บริการแตกต่างกัน
      </p>
    </div>
  </ContentBox>

  <ContentBoxSpecial as="h2" title="โปรโมชั่น UFA168 ติดอันดับ สำหรับสมาชิก">
    <p slot="left" class="text-left text-base leading-relaxed text-[#e6dcc2]">
      สมาชิก <strong class="text-[#f3db5b]">UFA168</strong> สามารถตรวจสอบโปรโมชั่นที่เปิดให้รับผ่านหน้าเว็บไซต์ โดยมีทั้งกิจกรรมแนะนำเพื่อนและโบนัสคืนยอดเสีย
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#e6dcc2]">
      โปรโมชั่นแต่ละรายการจะมีวิธีคำนวณ รอบการรับ และข้อกำหนดแตกต่างกัน ก่อนกดรับจึงควรตรวจสอบรายละเอียดให้ครบถ้วน โดยเฉพาะยอดที่นำมาคำนวณ ประเภทเกมที่ร่วมรายการ และเงื่อนไขเกี่ยวกับการถอนโบนัส
    </p>
  </ContentBoxSpecial>

  <ContentBoxSevenThreePremium as="h3" title="โปรโมชั่นแนะนำเพื่อน รับโบนัส 0.8%">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 28vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นแนะนำเพื่อนของ UFA168 พื้นหลังสีดำมีวงโค้งแสงสีทองและเหรียญทองกระจายอยู่ ด้านบนซ้ายเป็นโลโก้ตัวอักษร UFA168 สีเงินโครเมียมขอบทอง ถัดลงมาเป็นข้อความสีขาวว่า โปรโมชั่น แนะนำเพื่อน และตัวเลขสีทองขนาดใหญ่ 0.8% ในกรอบสีดำขอบทอง ด้านขวาเป็นนางแบบผมบลอนด์ยาวในชุดสองชิ้นสีทองสลับเงินติดคำว่า UFA168 ที่เข็มขัด กำลังชี้นิ้วมาที่ตัวเลข ฉากหลังขวาเป็นไพ่โพดำ วงล้อรูเล็ต และกล่องของขวัญสีทองที่มุมบนซ้าย ด้านล่างเป็นแถบไอคอนสี่ช่องเขียนว่า แชร์ง่าย รับโบนัสทันที รับโบนัสจากยอดเพื่อน ระบบปลอดภัยมั่นคง 100% และ บริการตลอด 24 ชั่วโมง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#d4af37]/55 shadow-[0_10px_30px_rgba(243,219,91,0.26)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#e6dcc2]">
      สมาชิกสามารถคัดลอกลิงก์แนะนำส่วนตัวและแชร์ให้เพื่อน เมื่อเพื่อนสมัครและมียอดการใช้งานตรงตามข้อกำหนด ระบบจะคำนวณโบนัสแนะนำเพื่อน <span class="font-black text-[#f3db5b]">0.8%</span> ตามเงื่อนไข
      สมาชิกสามารถตรวจสอบจำนวนการแนะนำ ยอดที่ใช้คำนวณ และโบนัสที่มีสิทธิ์รับผ่านบัญชีของตนเองได้
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBoxSevenThree as="h3" title="โปรโมชั่นคืนยอดเสีย รับโบนัส 0.3%">
    <Picture
      slot="left"
      src={imgSlide2}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) 92vw, 28vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่นคืนยอดเสียของ UFA168 พื้นหลังสีดำมีแสงประกายสีทองและเหรียญทองปลิวอยู่ ด้านบนซ้ายเป็นโลโก้ตัวอักษร UFA168 สีเงินโครเมียมขอบทอง ถัดลงมาเป็นข้อความสีขาวว่า โปรโมชั่น และคำว่า คืนยอดเสีย สีเงินในกรอบขอบทอง ใต้ลงมาเป็นตัวเลขสีทองขนาดใหญ่ 0.3% ด้านขวาเป็นนางแบบผมบลอนด์ยาวในชุดรัดรูปสีทองสลับเงินติดคำว่า UFA168 ที่เข็มขัด กำลังชี้นิ้วลงมาที่ตัวเลข ฉากหลังเป็นวงล้อรูเล็ตและโทรศัพท์มือถือ มุมล่างซ้ายเป็นไพ่เอซโพดำสามใบ กองเหรียญทอง และชิปคาสิโนพิมพ์คำว่า UFA168 ด้านล่างเป็นแถบไอคอนสามช่องเขียนว่า ระบบมั่นคงปลอดภัย 100% ฝาก-ถอนออโต้รวดเร็ว และ บริการตลอด 24 ชั่วโมง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#d4af37]/55 shadow-[0_10px_30px_rgba(243,219,91,0.26)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#e6dcc2]">
      สำหรับสมาชิกที่มียอดเสียเข้าเงื่อนไข สามารถตรวจสอบสิทธิ์รับโบนัสคืนยอดเสีย <span class="font-black text-[#f3db5b]">0.3%</span> ตามรอบที่กำหนด โดยระบบจะแสดงยอดที่นำมาคำนวณและสิทธิ์ที่สามารถกดรับ
      ก่อนรับโบนัสควรตรวจสอบรอบเวลา ประเภทเกม และข้อกำหนดล่าสุดของโปรโมชั่นทุกครั้ง
    </p>
  </ContentBoxSevenThree>

  <ContentBoxPremium as="h2" title="สมัคร UFA168 ด้วย 3 ขั้นตอนง่าย ๆ">
    <div class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e6dcc2]">
      <p>
        เริ่มต้นสมัคร <strong class="text-[#f3db5b]">UFA168</strong> ผ่านมือถือหรือคอมพิวเตอร์ได้ด้วยขั้นตอนที่ไม่ซับซ้อน โดยหลังเปิดบัญชีเรียบร้อยสามารถตรวจสอบเกม โปรโมชั่น
        และช่องทางฝากถอนผ่านระบบสมาชิกได้ทันที
      </p>
      <ol class="list-decimal space-y-2 pl-5 marker:font-black marker:text-[#f3db5b]">
        <li>เข้าหน้าสมัคร UFA168 และกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน</li>
        <li>Login เข้าสู่บัญชีและทำรายการฝากเครดิตผ่านช่องทางที่เปิดให้บริการ</li>
        <li>ตรวจสอบโปรโมชั่น เลือกเกมที่ต้องการ และศึกษากติกาก่อนเริ่มเดิมพัน</li>
      </ol>
      <p>
        สมาชิกควรตั้งรหัสผ่านที่คาดเดาได้ยาก และไม่เปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น รวมถึงควรตรวจสอบว่ากำลังใช้งานช่องทางของผู้ให้บริการที่ถูกต้องก่อนทำธุรกรรม
      </p>
    </div>
  </ContentBoxPremium>

  <LoginRtpSection />

  <ContentBoxTwoPremium as="h2" title="แอดมินให้บริการ UFA168 ออนไลน์ ตลอด 24 ชั่วโมง">
    <p slot="left" class="text-left text-base leading-relaxed text-[#e6dcc2]">
      หากพบปัญหาเกี่ยวกับการสมัครสมาชิก Login ไม่ได้ เครดิตไม่เข้า ถอนเงินล่าช้า โปรโมชั่นไม่แสดง หรือเข้าเกมไม่ได้ สามารถติดต่อแอดมิน <strong class="text-[#f3db5b]">UFA168</strong>
      ได้ตลอด 24 ชั่วโมง พร้อมแจ้งรายละเอียดและเวลาที่เกิดรายการ เพื่อให้ทีมงานตรวจสอบข้อมูลและแนะนำขั้นตอนแก้ไขได้ตรงกับปัญหา
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#e6dcc2]">
      หากไม่แน่ใจว่าลิงก์ทางเข้าที่ได้รับเป็นช่องทางที่ถูกต้องหรือไม่ ควรสอบถามเจ้าหน้าที่ผ่านช่องทางติดต่อที่เชื่อถือได้ก่อน Login หรือทำรายการฝากเงิน
      และไม่ควรส่งข้อมูลบัญชีที่เป็นความลับให้บุคคลอื่น
    </p>
  </ContentBoxTwoPremium>

  <Faq4 title="คำถามที่พบบ่อยเกี่ยวกับ UFA168" faqs={faqs} />

  <LatestWinners />

  <ReviewCardSumo />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#fff3bf] via-[#f3db5b] to-[#a37c14] px-4 py-3 text-sm font-black whitespace-nowrap text-[#050403] shadow-[0_10px_30px_rgba(243,219,91,0.32)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(243,219,91,0.46)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#6b5316]/90 bg-gradient-to-r from-[#241a08] to-[#050403] px-4 py-3 text-sm font-black whitespace-nowrap text-[#d8dce2] shadow-[0_10px_30px_rgba(216,220,226,0.16)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#d4af37]/80 hover:text-[#f3db5b] hover:shadow-[0_15px_40px_rgba(243,219,91,0.32)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>
  </div>

  <Navfoot />
</MainLayout>
