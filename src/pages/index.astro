---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import LatestWinners from "../components/LatestWinnersHuay.astro";
import ContentBoxHuay from "../components/ContentBoxHuay.astro";
import ContentBoxTwoHuay from "../components/ContentBoxTwoHuay.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBox3ThreeHuay from "../components/ContentBox3ThreeHuay.astro";
import ContentBoxSevenThreeHuay from "../components/ContentBoxSevenThreeHuay.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import Faq from "../components/FaqHuay.astro";
import ReviewCardSumo from "../components/ReviewCardSumo.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import { pageGraph } from "../lib/schema";
import payout2Digit from "../assets/banner3.png";
import payout3Digit from "../assets/banner2.png";
import promoCashback from "../assets/slide2.png";
import promoReferral from "../assets/slide1.png";

// การหมุน variant รอบนี้ตัดสินไว้แล้วใน .claude/brand-spec-ruay168.md §3 —
// ห้ามเลือกใหม่ที่นี่ แบรนด์ขาออก (มาดาม168) ถูกหมุนออกจากทุกตระกูลพร้อมกัน:
// AnnouncementHuay แทน AnnouncementPremium · LatestWinnersHuay แทน
// LatestWinnersPremium · FaqHuay แทน Faq2 · ReviewCardSumo แทน ReviewCardSumo2 ·
// และ shape-mix ของ ContentBox ทิ้ง Premium / Two / 3ThreePremium / SevenThree /
// SevenThreeCyberCut / CyberCut / Special ไปใช้ Huay / TwoHuay / Neumorphism /
// 3ThreeHuay / SevenThreeHuay / SevenThreeNeumorphism / FloatingBadge /
// TwoNeumorphism แทน — **ไม่ทับไฟล์เดิมแม้แต่ตัวเดียว**
// Navbar/Footer อยู่ที่ MainLayout (NavbarStyle4Black -> NavbarHuay,
// FooterPremium -> FooterHuay) ไม่ใช่ที่ไฟล์นี้
// ⚠️ ตระกูล *Huay ถูกเลือกเพราะ **แบรนด์รอบนี้เป็นเว็บหวยจริง** ไม่ใช่เพราะสี —
// ไฟล์ชุดนั้นเคย ship เป็นแดง/ทอง และ **แดงถูกถอดออกหมดแล้วรอบนี้**
//
// พาเลตรอบนี้ (brand-spec §2 ล็อกค่าไว้แล้ว ห้ามเดาเพิ่ม): พื้นเพจ #000000 ดำสนิท
// (bg.json) · ผิวจม #070707 · การ์ด #121110 · ผิวยก #1c1a16 · เส้น #3d3425 ·
// หมึก #f3ece0 · ทองเป็นฮิวนำ #ffd94a / #e3a712 / #9d6f06 · โครเมียมเงินเป็น
// วัสดุที่สอง #e8eaee / #b4b9c2 / #6b7079 · หมึกรอง #bfb8aa · แพลทินัม #dde1e7
// ⚠️ #9d6f06 (4.7:1) กับ #6b7079 (4.2:1) **ห้ามถือตัวอักษร** — ไฮไลต์ในย่อหน้า
// ทั้งหมดจึงเป็น **#ffd94a ตัวเดียว** (13.8:1 บนผิวการ์ด)
// ⚠️⚠️ **ขาวบนทองได้แค่ ~1.2–2.2:1** — ทุกพื้นถมทองในหน้านี้ถือหมึกดำ #0a0a0a
// ย่อหน้าในไฟล์นี้ไม่ถือคลาสสีของตัวเอง — ทุก ContentBox* ในมิกซ์นี้ตั้ง
// `text-left text-base leading-relaxed text-[#f3ece0]` ไว้บน element ที่ถือ slot
// อยู่แล้ว และไม่มี `<p>` ไหนมี mx-auto / max-w-* (การ์ดคุมความกว้างเองแล้ว)
//
// ชื่อแบรนด์ไม่พิมพ์ตรง ๆ ในไฟล์นี้เลย — interpolate จาก ${BRAND_NAME} ทุกจุด
// รวมถึงใน alt ของสองแบนเนอร์และสองสไลด์ ไม่มีโดเมนเขียนไว้ที่ไหน และไม่มี URL
// ที่ต่อด้วย `+`
//
// <strong> ทุกตัวคร่อม "ก้อนที่คั่นด้วยช่องว่าง" ทั้งก้อน เพราะภาษาไทยไม่มีช่องว่าง
// ระหว่างคำ — ไฮไลต์ที่เริ่มหรือจบกลางคำจะถูก formatter ตัดบรรทัดในแท็กแล้วแทรก
// ช่องว่างกลางคำ อ่านคอปปี้โดยถอดแท็กออกต้องได้ข้อความเดิมเป๊ะ และไม่มี <strong>
// สองตัวติดกันโดยไม่มีข้อความธรรมดาคั่น
//
// บรีฟรอบนี้ **โฆษณาและกำกับในประโยคเดียวกัน** (brand-spec §5): หัวข้อของบรีฟเอง
// เขียนว่า บาทละ1,000 / 2 ตัว 100 / 3 ตัว 1,000 / ไม่จำกัด ขณะที่ย่อหน้าของบรีฟเอง
// ตอบว่า เลขเด็ดหรือสถิติย้อนหลังไม่สามารถรับประกันผลรางวัลในงวดถัดไปได้ ·
// ไม่ใช่ทุกรายการที่จะใช้อัตราจ่ายเดียวกัน · ผลการออกรางวัลมีความไม่แน่นอน ·
// เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกบิล — ship ทั้งสองครึ่ง
// ตรงตามที่บรีฟเขียน คำโฆษณาอยู่เฉพาะในหัวข้อที่บรีฟเขียนไว้เอง ไม่ขยายเป็นคำ
// กล่าวอ้างใหม่ และ **ทุกประโยคกำกับ ship ครบ ไม่ตัดเพราะฟังดูลบ**
// ตัวเลขบนหน้านี้มีแค่ของบรีฟเอง: บาทละ 1,000 · 2 ตัว 100 · 3 ตัว 1,000 · 0.3% ·
// 0.8% · 24ชม. ไม่มีจำนวนเกม ไม่มี RTP ไม่มี 100% ไม่มีปีก่อตั้ง ไม่มีจำนวนสมาชิก
// ไม่มี "3 ขั้นตอน" ไม่มียอดฝากขั้นต่ำเป็นตัวเลข และ **ไม่เขียนค่า 3.2 ของ
// วิ่ง/โต๊ด เป็นคำกล่าวอ้าง** — มันอยู่บนบิตแมป banner2/banner3 เท่านั้น
// ⚠️ รอบนี้เป็น **เว็บหวย** คำว่า "สล็อต" ห้ามเป็นคำนิยามตัวเอง และคำของแบรนด์
// ขาออก (มาดาม · เปย์แรง · จ่ายไม่มีอั้น · ไม่อั้น · เก็บโบนัสได้ทุกวัน ·
// เว็บสล็อต) ไม่มีในไฟล์นี้เลยสักคำ
//
// title/description = บรรทัด 1-2 ของบรีฟตรงตัว (src/assets/content.txt)
// description ยาวราว 110 ตัวอักษร — **ห้ามเติมให้ครบ 150** verify-build ยกเว้น
// เพดานล่างให้หน้าแรกไว้เพราะเหตุผลนี้ ส่วนเพดานบน 160 ยังผ่านสบาย
const pageTitle = `${BRAND_NAME} แทงหวยเว็บรวย รัฐบาลไทย ลาว ฮานอย ออมสิน บาทละ1,000`;

const pageDescription = `${BRAND_NAME} แทงหวยเว็บรวย รับแทงเลขออนไลน์ทุกประเภท รัฐบาลไทย ลาว ฮานอย ออมสิน บาทละ1,000 เลขเด็ด เลขดัง ทุกสำนัก`;

// บรีฟรอบนี้มีชั้น H1 -> H2 -> H3 จริง จึง **ไม่** แบนเป็น H2 ล้วน มี H3 สี่ตัวพอดี
// และทั้งสี่เป็นบรรทัด H3 ของบรีฟเอง (content.txt บรรทัด 7, 9, 13, 15)
// รอบนี้ไม่มี FeatureHighlights จึงไม่มีแหล่ง H3 ที่ห้า
//
// checklist ตามลำดับเอกสาร (brand-spec §4) และตัวที่รับแต่ละข้อ:
//    1 H1  ${BRAND_NAME} แทงหวยเว็บรวย รับแทงเลขออนไลน์ทุกประเภท
//          ContentBoxHuay, ย่อหน้าบรรทัด 4
//    2 H2  ${BRAND_NAME} รัฐบาลไทย ลาว ฮานอย ออมสิน บาทละ1,000
//          ContentBoxTwoHuay, บรรทัด 6 แบ่งสองครึ่ง
//    3 H3  อัตราจ่าย 2 ตัว 100
//          ContentBoxHuay + banner3 ในสล็อตเดียวกัน, บรรทัด 8
//    4 H3  อัตราจ่าย 3 ตัว 1,000
//          ContentBoxNeumorphism + banner2 ในสล็อตเดียวกัน, บรรทัด 10
//    5 H2  โปรโมชั่นสมาชิก ${BRAND_NAME} อัปเดตตลอดเดือน
//          ContentBox3ThreeHuay, บรรทัด 12 แบ่งสามส่วน
//    6 H3  โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน
//          ContentBoxSevenThreeHuay + slide2, บรรทัด 14 ซ้าย / ภาพขวา
//    7 H3  โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด
//          ContentBoxSevenThreeNeumorphism + slide1, บรรทัด 16 ซ้าย / ภาพขวา
//    8 H2  ระบบฝากถอน ${BRAND_NAME} ได้ทุกธนาคารและทรูมันนี่
//          ContentBoxFloatingBadge, บรรทัด 18
//    9 H2  ช่องทางติดต่อแอดมินแทงหวย ${BRAND_NAME} ตลอด 24ชม.
//          ContentBoxTwoNeumorphism, บรรทัด 20 แบ่งสองครึ่ง
//   10 H2  คำถามที่พบบ่อยเกี่ยวกับ ${BRAND_NAME}
//          FaqHuay + prop faqs ชัดเจน, บรรทัด 22-27
// inventory ที่ต้องได้: **h1 ×1 · h2 ×5 · h3 ×4** — ตรงเป้าของ brand-spec §4
//
// ⚠️ จุดที่ชั้น heading รั่วได้ และกันไว้แล้วทุกจุด: ContentBox3ThreeHuay กับ
// ContentBoxTwoHuay/ContentBoxTwoNeumorphism ปล่อยป้ายคอลัมน์เป็น <p> เสมอโดย
// รูปร่างของมันเอง (ไม่มี prop `heading` และ **ไม่ต้องส่ง** — `heading={false}`
// ใน brand-spec §4 เป็น prop ของ ContentBox3ThreePremium ที่รอบก่อนใช้ ไม่ใช่ของ
// ไฟล์รอบนี้ ส่งไปจะโดน astro check ตีตก) และ **ไม่ส่ง titleright ให้ SevenThree
// ทั้งสองบล็อก** คอลัมน์ภาพจึงไม่มี heading
// grep `<h[1-6]` ในทุก component ที่ไฟล์นี้กับ MainLayout เรียกแล้วรอบนี้ — ไม่มี
// ตัวไหน hardcode heading ไว้เลย ทุกแท็ก heading บนหน้ามาจาก prop คือมาจากบรีฟ
//
// ทั้ง ContentBoxSevenThree* วาง md:grid-cols-[7fr_3fr] โดยให้ **คอลัมน์ข้อความ
// มาก่อน** ภาพจึงไปอยู่ slot="right" ทุกครั้ง: heading ลงบนเนื้อความไม่ใช่บนภาพ
// และบนมือถือคอลัมน์เดียวอ่านลำดับ หัวข้อ -> ข้อความ -> ภาพ ไม่ใช่เปิดด้วยรูป
// สองบล็อกนี้คือ **เพดาน 2 บล็อกของตระกูล SevenThree พอดี** และ **สไลด์ขึ้นได้
// เฉพาะในสองบล็อกนี้เท่านั้น**
// การจับคู่สไลด์อ่านจากตัวอักษรบนภาพเอง (เปิดรูปอ่านใหม่รอบนี้แล้ว): slide2 เขียน
// โปรโมชั่น + คืนยอดเสีย 0.3% -> §6 · slide1 เขียน โปรโมชั่น + แนะนำเพื่อน 0.8%
// -> §7 — uploader เขียนทับไฟล์ทุกดรอป เลขในชื่อไฟล์จึงไม่มีความหมายข้ามแบรนด์
// ⛔ **slide3.png / slide4.png เป็นอาร์ตเวิร์ก 2026-09-29 ของแบรนด์อื่น ห้าม
// import เด็ดขาด** เพราะ eager import = emit ขึ้น dist ทุก build แม้ไม่มีหน้าไหน
// render — รอบนี้จึงเหลือสไลด์สองใบที่ไม่ได้ใช้ และนั่นถูกต้องตาม playbook
//
// banner2/banner3 เป็นของดรอปนี้จริง และเป็น **รูปประกอบบทความ** ตามกฎ playbook:
// อยู่ **ในการ์ด ContentBox คอลัมน์เดียวเท่านั้น** คุมความกว้างด้วย
// `mx-auto h-auto w-full max-w-2xl` ห้ามเต็มขอบ ห้ามเป็น hero ห้ามเป็นคอลัมน์ของ
// SevenThree · การจับคู่อ่านจากแผ่นป้ายตัวโตบนภาพเอง: banner3 เขียน "2 ตัว 100"
// -> §3 · banner2 เขียน "3 ตัว 1,000" -> §4 · ขนาดจริงบนดิสก์คือ **992x1586
// แนวตั้ง** (ไม่ใช่ 986x1621 อย่างที่ brand-spec §1 เขียน — **ไฟล์บนดิสก์ชนะ**)
// เพดาน candidate จึงเป็น 992 ซึ่งเป็นความกว้างจริงของบิตแมป ห้าม upscale
// ⚠️ **banner1 / banner1-mobile เป็น hero ของ MainLayout** (glob ปักชื่อไว้แล้ว)
// ห้าม import ที่ไฟล์นี้
//
// §3 และ §4 ส่ง **<div> ใบเดียว** เข้า slot ที่ห่อ <p> + <Picture> ไว้ด้วยกัน ตาม
// กฎ one-element-per-slot — component ไม่ได้ห่อให้ และห้ามไปเพิ่ม wrapper ใน
// component เพื่อ "แก้" เพราะทุก ContentBox* ถูก flatten ไว้แล้ว (isolate + -z-10)
//
// ที่เหลือบนหน้าเป็น chrome และไม่ออกแท็ก heading ที่ระดับไหนเลย: AnnouncementHuay,
// LatestWinnersHuay และ ReviewCardSumo ขึ้นชื่อหัวข้อเป็น <p>/<span> พร้อม
// aria-label บน <section> ส่วนคำถามของ FAQ อยู่ใน <summary> วิดเจ็ตที่ไม่ใช่ของ
// บรีฟวางไว้ก่อน §1 (ticker) และหลัง §10 (ฟีดถอนเงิน -> การ์ดรีวิว -> Navfoot)
// เท่านั้น ไม่แทรกกลางสองหัวข้อของบรีฟ
//
// <Announcement /> เรียกเปล่าโดยตั้งใจ: orchestrator ตั้ง default message ของ
// AnnouncementHuay เป็นคอปปี้ของแบรนด์นี้ไว้แล้วใน P1 และหน้าย่อยก็เรียกเปล่า
// เหมือนกัน — ticker จึงตรงกันทั้งเว็บจากแหล่งเดียว

// อาร์เรย์เดียว ใช้ทั้งกับ <Faq> และโน้ด FAQPage — ไม่ใช้ default ของ component
// (FaqHuay ตั้งใจ ship เป็นลิสต์ว่าง prop ที่ลืมส่งจึงได้ accordion เปล่า ไม่ใช่
// คำถามของแบรนด์ก่อน) สามคู่นี้คือบล็อก Q/A ของบรีฟเอง (content.txt บรรทัด 22-27)
// ตรงตัว ตัดเฉพาะหมายเลข "1." "2." "3." ออกเพราะ accordion เป็นตัวลิสต์อยู่แล้ว
// ทุกคำตอบคงประโยคกำกับของบรีฟไว้ครบ — เป็นเนื้อหาของบรีฟทั้งสองครึ่ง
const faqs = [
  {
    q: `${BRAND_NAME} มีหวยประเภทไหนให้เลือกบ้าง?`,
    a: `ตามข้อมูลที่ระบุ ${BRAND_NAME} นำเสนอหวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยออมสิน โดยควรตรวจสอบรายการที่เปิดให้บริการจริง รวมถึงรอบปิดรับและแหล่งอ้างอิงผลรางวัลก่อนทำรายการ`,
  },
  {
    q: `อัตราจ่ายหวย 2 ตัว 100 และ 3 ตัว 1,000 ใช้ได้กับหวยทุกประเภทหรือไม่?`,
    a: `ยังไม่สามารถยืนยันได้ว่าใช้อัตราเดียวกันกับหวยทุกประเภท ควรตรวจสอบตารางอัตราจ่าย ฐานเงินเดิมพัน และข้อจำกัดของแต่ละรายการจากข้อมูลล่าสุดก่อนยืนยันบิล`,
  },
  {
    q: `หากฝากถอนมีปัญหาหรือไม่ได้รับโบนัส ควรทำอย่างไร?`,
    a: `ควรตรวจสอบสถานะรายการและเงื่อนไขโปรโมชั่นก่อน จากนั้นติดต่อเจ้าหน้าที่ผ่านช่องทางทางการของ${BRAND_NAME} พร้อมหลักฐานที่เกี่ยวข้อง โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น`,
  },
];

// ไม่มี breadcrumb: นี่คือหน้าแรก เส้นทางจาก root มาหาตัวเองจะเหลือครั้งเดียวที่ชี้ตัวเอง
// ทุก URL ในกราฟมาจาก pageGraph ที่ derive จาก site: — ไม่มีโดเมนพิมพ์ไว้ในไฟล์นี้
// ไม่มี URL ที่ต่อด้วย `+` และไม่ส่งโน้ด Review / AggregateRating / sameAs /
// address / email เข้าไปเลย
// `description` เป็นสตริงเดียวกับที่ MainLayout ได้รับ และ `faqs` เป็นอาร์เรย์
// ตัวเดียวกับที่ <Faq> ได้รับ
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxHuay as="h1" title={`${BRAND_NAME} แทงหวยเว็บรวย รับแทงเลขออนไลน์ทุกประเภท`}>
    <p>
      {BRAND_NAME} นำเสนอข้อมูลหวยออนไลน์หลากหลายประเภท
      <strong class="text-[#ffd94a]">ทั้งหวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยออมสิน พร้อมรายละเอียดอัตราจ่ายและรอบประกาศผลที่แตกต่างกัน</strong>
      ผู้ใช้งานสามารถศึกษารูปแบบการเลือกหมายเลข ตรวจสอบเงื่อนไขการเดิมพัน และติดตามข้อมูลเลขดังจากแหล่งต่าง ๆ ได้ โดยควรตรวจสอบความถูกต้องของข้อมูลก่อนทำรายการ
      <strong class="text-[#ffd94a]">เพราะเลขเด็ดหรือสถิติย้อนหลังไม่สามารถรับประกันผลรางวัลในงวดถัดไปได้</strong>
    </p>
  </ContentBoxHuay>

  <ContentBoxTwoHuay as="h2" title={`${BRAND_NAME} รัฐบาลไทย ลาว ฮานอย ออมสิน บาทละ1,000`}>
    <p slot="left">
      {BRAND_NAME} รวบรวมข้อมูลหวยหลายประเภทไว้ในช่องทางเดียว
      <strong class="text-[#ffd94a]">ไม่ว่าจะเป็นหวยรัฐบาลไทยที่อ้างอิงผลสลากกินแบ่งรัฐบาล หวยลาว หวยฮานอย และรายการที่เกี่ยวข้องกับผลรางวัลออมสิน</strong>
      โดยแต่ละประเภทมีวันประกาศผลและรูปแบบการออกรางวัลแตกต่างกัน
    </p>
    <p slot="right">
      สำหรับอัตราจ่ายที่ระบุว่าบาทละ 1,000
      <strong class="text-[#ffd94a]">ควรตรวจสอบว่าใช้กับการเดิมพันประเภทใด รวมถึงฐานเงินเดิมพันและวงเงินจ่ายสูงสุด</strong>
      เพราะไม่ใช่ทุกรายการที่จะใช้อัตราจ่ายเดียวกัน
    </p>
  </ContentBoxTwoHuay>

  <ContentBoxHuay as="h3" title="อัตราจ่าย 2 ตัว 100">
    <div class="flex flex-col gap-6">
      <p>
        อัตราจ่ายหวย 2 ตัว 100 เป็นข้อมูลที่ระบุไว้สำหรับการเดิมพันหมายเลขสองหลัก
        <strong class="text-[#ffd94a]">โดยผู้ใช้งานควรตรวจสอบว่าอัตราดังกล่าวใช้กับเลขสองตัวบนหรือสองตัวล่าง และคำนวณจากเงินเดิมพันจำนวนเท่าใด</strong>
        เนื่องจากหวยแต่ละประเภทอาจกำหนดอัตราจ่ายแตกต่างกัน นอกจากนี้ควรตรวจสอบข้อจำกัดการรับหมายเลขและเงื่อนไขการจ่ายรางวัลก่อนยืนยันรายการ
        <strong class="text-[#ffd94a]">เพื่อให้เข้าใจจำนวนเงินที่มีสิทธิ์ได้รับตามข้อกำหนดจริง</strong>
      </p>
      <Picture
        src={payout2Digit}
        loading="lazy"
        fetchpriority="low"
        widths={[336, 504, 672, 992]}
        sizes="(min-width: 804px) 672px, (min-width: 768px) calc(100vw - 132px), (min-width: 764px) 672px, calc(100vw - 92px)"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={64}
        alt={`แผ่นป้ายอัตราจ่ายหวยของ ${BRAND_NAME} พื้นหลังสตูดิโอสีดำ ด้านซ้ายเป็นผู้หญิงผมสั้นดัดลอนสีขาวเงิน ใส่สูทดำทับชุดรัดรูปสีดำ คาดเข็มขัดหนัง ยิ้มและถือไม้ชี้ไปที่ตาราง ด้านขวาเป็นป้ายขอบทองเขียนหัวว่า อัตราจ่ายหวย มีตารางสี่แถวเรียงตามธงชาติ รัฐบาลไทย หวยลาว ฮานอย และออมสิน แต่ละแถวเขียนคอลัมน์ 2 ตัว เป็นเลข 100 สีทอง คอลัมน์ 3 ตัว เป็นเลข 900 และคอลัมน์ วิ่ง/โต๊ด เป็นเลข 3.2 ด้านล่างสุดเป็นแผ่นป้ายโตเขียนคำว่า 2 ตัว ด้วยตัวอักษรโครเมียมเงิน ต่อด้วยเลข 100 ตัวหนาสีทอง มุมบนขวาเป็นโลโก้ ${BRAND_NAME} ที่มีมงกุฎทองอยู่เหนือตัวอักษร`}
        class="mx-auto h-auto w-full max-w-2xl rounded-2xl border border-[#9d6f06] shadow-[0_10px_28px_rgba(0,0,0,0.6)]"
      />
    </div>
  </ContentBoxHuay>

  <ContentBoxNeumorphism as="h3" title="อัตราจ่าย 3 ตัว 1,000">
    <div class="flex flex-col gap-6">
      <p>
        อัตราจ่ายหวย 3 ตัว 1,000 เป็นข้อมูลสำหรับผู้ที่ต้องการศึกษาการจ่ายรางวัลหมายเลขสามหลัก
        <strong class="text-[#ffd94a]">โดยควรตรวจสอบว่าอัตราดังกล่าวใช้กับสามตัวตรง สามตัวโต๊ด หรือรูปแบบการเดิมพันประเภทใด รวมถึงฐานเงินเดิมพันและวงเงินจ่ายสูงสุดของแต่ละรอบ</strong>
        ก่อนยืนยันบิลควรตรวจสอบหมายเลขที่เลือกและรายละเอียดอัตราจ่ายให้ถูกต้อง
        <strong class="text-[#ffd94a]">เพราะผลการออกรางวัลมีความไม่แน่นอนและไม่สามารถคาดการณ์ได้อย่างแม่นยำจากเลขย้อนหลัง</strong>
      </p>
      <Picture
        src={payout3Digit}
        loading="lazy"
        fetchpriority="low"
        widths={[336, 504, 672, 992]}
        sizes="(min-width: 770px) 672px, calc(100vw - 98px)"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={64}
        alt={`แผ่นป้ายอัตราจ่ายหวยของ ${BRAND_NAME} พื้นหลังสตูดิโอสีดำ ด้านซ้ายเป็นผู้หญิงผมสั้นดัดลอนสีขาวเงินคนเดิม ใส่สูทดำทับชุดรัดรูปสีดำ คาดเข็มขัดหนัง ถือไม้ชี้ไปที่ตาราง ด้านขวาเป็นป้ายขอบทองเขียนหัวว่า อัตราจ่ายหวย มีตารางสี่แถวเรียงตามธงชาติ รัฐบาลไทย หวยลาว ฮานอย และออมสิน แต่ละแถวเขียนคอลัมน์ 3 ตัว เป็นเลข 1,000 สีทอง และคอลัมน์ วิ่ง/โต๊ด เป็นเลข 3.2 ด้านล่างสุดเป็นแผ่นป้ายโตสองชั้น ชั้นบนเขียนคำว่า 3 ตัว ด้วยตัวอักษรโครเมียมเงิน ชั้นล่างเป็นเลข 1,000 ตัวหนาสีทอง มุมบนขวาเป็นโลโก้ ${BRAND_NAME} ที่มีมงกุฎทองอยู่เหนือตัวอักษร`}
        class="mx-auto h-auto w-full max-w-2xl rounded-2xl border border-[#9d6f06] shadow-[0_10px_28px_rgba(0,0,0,0.6)]"
      />
    </div>
  </ContentBoxNeumorphism>

  <ContentBox3ThreeHuay as="h2" title={`โปรโมชั่นสมาชิก ${BRAND_NAME} อัปเดตตลอดเดือน`}>
    <p slot="left">
      {BRAND_NAME} นำเสนอข้อมูลโปรโมชั่นสำหรับสมาชิก
      <strong class="text-[#ffd94a]">โดยมีรายการคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8%</strong>
      ซึ่งแต่ละโปรโมชั่นอาจกำหนดประเภทหวยที่เข้าร่วม ยอดที่นำมาคำนวณ และรอบเวลารับเครดิตแตกต่างกัน
    </p>
    <p slot="center">ผู้ใช้งานควรติดตามประกาศโปรโมชั่นประจำเดือนและตรวจสอบเงื่อนไขก่อนรับสิทธิ์</p>
    <p slot="right">
      รวมถึงศึกษาข้อจำกัดการใช้โบนัสและการถอนเงินให้ครบถ้วน
      <strong class="text-[#ffd94a]">เพื่อให้เข้าใจรายละเอียดของแต่ละรายการอย่างถูกต้อง</strong>
    </p>
  </ContentBox3ThreeHuay>

  <ContentBoxSevenThreeHuay as="h3" titleleft="โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน">
    <p slot="left">
      โปรโมชั่นคืนยอดเสีย 0.3% เป็นรายการที่ระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขรายวัน
      <strong class="text-[#ffd94a]">สมาชิกควรตรวจสอบว่าหวยรัฐบาลไทย ลาว ฮานอย หรือหวยประเภทใดเข้าร่วมรายการ รวมถึงศึกษารอบเวลาคำนวณยอดและวิธีรับเครดิตให้ชัดเจน</strong>
      เพราะหวยแต่ละประเภทมีรอบประกาศผลแตกต่างกัน ก่อนเข้าร่วมควรอ่านข้อกำหนดการใช้โบนัสและการถอนเงินให้ครบถ้วน ทั้งนี้
      <strong class="text-[#ffd94a]">เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกบิลหรือรับประกันผลตอบแทนในงวดถัดไป</strong>
    </p>
    <Picture
      slot="right"
      src={promoCashback}
      loading="lazy"
      fetchpriority="low"
      widths={[176, 264, 352, 375]}
      sizes="(min-width: 1400px) 352px, (min-width: 768px) calc(30vw - 68px), (min-width: 473px) 375px, calc(100vw - 98px)"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={64}
      alt={`โปสเตอร์โปรโมชั่นของ ${BRAND_NAME} ฉากหลังสตูดิโอสีดำมีเสาโลหะเรียงเป็นแนว ด้านหน้าเป็นผู้หญิงผมสั้นดัดลอนสีขาวเงิน ทาลิปสติกแดง ใส่สูทดำทับชุดรัดรูปสีดำ คาดเข็มขัดหนัง ก้มมองและกดโทรศัพท์มือถือในมือ มุมบนซ้ายเป็นโลโก้ ${BRAND_NAME} ที่มีมงกุฎทองอยู่เหนือตัวอักษร ครึ่งล่างของภาพเป็นคำว่า โปรโมชั่น ตัวอักษรไทยสามมิติโครเมียมเงินตัดขอบทอง ใต้ลงมาเป็นแคปซูลพื้นดำขอบทองเขียนว่า คืนยอดเสีย ต่อท้ายด้วยเลข 0.3% ตัวโตสีทอง`}
      class="mx-auto h-auto w-full max-w-[375px] rounded-2xl border border-[#9d6f06] shadow-[0_10px_28px_rgba(0,0,0,0.6)]"
    />
  </ContentBoxSevenThreeHuay>

  <ContentBoxSevenThreeNeumorphism as="h3" title="โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด">
    <p slot="left">
      โปรโมชั่นแนะนำเพื่อนโบนัส 0.8% เป็นรายการที่ระบุสิทธิ์สำหรับสมาชิกที่แนะนำผู้ใช้งานรายใหม่
      <strong class="text-[#ffd94a]">โดยควรตรวจสอบวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และยอดที่ใช้คำนวณโบนัสให้ครบถ้วน</strong>
      แม้โปรโมชั่นจะระบุว่าไม่จำกัด แต่ควรยืนยันข้อกำหนดเกี่ยวกับจำนวนบัญชีที่เข้าร่วม รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุด
      <strong class="text-[#ffd94a]">เพื่อให้เข้าใจหลักเกณฑ์การรับสิทธิ์และหลีกเลี่ยงความคลาดเคลื่อนเกี่ยวกับยอดเครดิตที่ได้รับ</strong>
    </p>
    <Picture
      slot="right"
      src={promoReferral}
      loading="lazy"
      fetchpriority="low"
      widths={[172, 258, 343, 375]}
      sizes="(min-width: 1400px) 343px, (min-width: 768px) calc(30vw - 77px), (min-width: 473px) 375px, calc(100vw - 98px)"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={64}
      alt={`โปสเตอร์โปรโมชั่นของ ${BRAND_NAME} ฉากหลังสตูดิโอสีดำมีเสาโลหะเรียงเป็นแนวเดียวกัน ด้านหน้าเป็นผู้หญิงผมสั้นดัดลอนสีขาวเงินคนเดิม ทาลิปสติกแดง ใส่สูทดำทับชุดรัดรูปสีดำ ยกโทรศัพท์มือถือขึ้นด้วยมือซ้ายให้เห็นโลโก้ ${BRAND_NAME} บนจอ และชี้นิ้วไปที่จอด้วยมือขวา มุมบนซ้ายเป็นโลโก้ ${BRAND_NAME} ที่มีมงกุฎทองอยู่เหนือตัวอักษร ครึ่งล่างของภาพเป็นคำว่า โปรโมชั่น ตัวอักษรไทยสามมิติโครเมียมเงินตัดขอบทอง ใต้ลงมาเป็นแคปซูลพื้นดำขอบทองเขียนว่า แนะนำเพื่อน ต่อท้ายด้วยเลข 0.8% ตัวโตสีทอง`}
      class="mx-auto h-auto w-full max-w-[375px] rounded-2xl border border-[#9d6f06] shadow-[0_10px_28px_rgba(0,0,0,0.6)]"
    />
  </ContentBoxSevenThreeNeumorphism>

  <ContentBoxFloatingBadge as="h2" title={`ระบบฝากถอน ${BRAND_NAME} ได้ทุกธนาคารและทรูมันนี่`}>
    <p>
      {BRAND_NAME} ระบุช่องทางฝากถอนผ่านธนาคารและทรูมันนี่ เพื่อให้สมาชิกตรวจสอบวิธีทำรายการตามบริการที่เปิดใช้งานจริง
      <strong class="text-[#ffd94a]">ก่อนฝากเงินควรตรวจสอบรายชื่อธนาคารที่รองรับ ยอดขั้นต่ำ และชื่อบัญชีปลายทางให้ตรงกับข้อมูลผู้ให้บริการที่ยืนยันได้</strong>
      รวมถึงศึกษาระยะเวลาดำเนินการและข้อกำหนดการถอนเงินให้ครบถ้วน หากพบชื่อบัญชีไม่ตรงกับข้อมูลทางการหรือมีการแจ้งเปลี่ยนบัญชีอย่างผิดปกติ
      <strong class="text-[#ffd94a]">ควรหยุดทำรายการและติดต่อธนาคารหรือผู้ให้บริการชำระเงินเพื่อตรวจสอบก่อนโอนเงิน</strong>
    </p>
  </ContentBoxFloatingBadge>

  <ContentBoxTwoNeumorphism as="h2" title={`ช่องทางติดต่อแอดมินแทงหวย ${BRAND_NAME} ตลอด 24ชม.`}>
    <p slot="left">
