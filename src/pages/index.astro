---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ProviderGridPremium from "../components/ProviderGridPremium.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import Faq from "../components/Faq3.astro";
import LatestWinners from "../components/LatestWinnersCyber.astro";
import ReviewCardSumo from "../components/ReviewCardSumo.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import { pageGraph } from "../lib/schema";
import cashbackPoster from "../assets/slide1.png";
import referralPoster from "../assets/slide2.png";

// การหมุน variant รอบนี้ตัดสินไว้แล้วใน .claude/brand-spec-zoro365.md §3 —
// **ห้ามเลือกใหม่ที่นี่** แบรนด์ขาออก (TEVA69) ถูกหมุนออกจากทุกตระกูลพร้อมกัน:
// Announcement3 แทน AnnouncementPremium · Faq3 แทน Faq · LatestWinnersCyber แทน
// LatestWinnersPremium · ReviewCardSumo แทน ReviewCardSumo2 · ProviderGridPremium
// แทน ProviderGrid · และ shape-mix ของ ContentBox ทิ้งชุด FloatingBadge + CyberCut +
// ตัวฐาน + SevenThree + Special ของรอบก่อนทั้งชุด ไปใช้ **ชุด Neumorphism +
// Premium นำ + TwoCyberCut** แทน
// ไม่ลบไฟล์ที่ไม่ได้ใช้แม้แต่ตัวเดียว — มันคือ inventory ของแบรนด์ถัดไป
// Navbar/Footer อยู่ที่ MainLayout (NavbarCyber / FooterCyber) ไม่ใช่ที่ไฟล์นี้
// ❌ รอบนี้ **ไม่ใช้ BankStrip / FeatureHighlights / SmoothCarousel / LottoGrid /
// ContentBox3Three* / ตระกูล *Huay** — บรีฟรอบนี้ไม่มีหมวดฝากถอน ธนาคาร วอลเลท
// หรือออโต้เลยแม้แต่คำเดียว และไม่มีหมวดใดที่เป็นลิสต์ย่อย 2-4 ข้อแบบ
// FeatureHighlights
// ⚠️ `<Announcement />` ถูกเรียกแบบ **ไม่ส่ง message** โดยตั้งใจ — orchestrator ตั้ง
// ค่า default ของ Announcement3 เป็นคอปปี้ของแบรนด์รอบนี้ไว้แล้วใน P1 และหน้าย่อย
// ทุกหน้าก็เรียกแบบ bare เหมือนกัน ข้อความ ticker จึงตรงกันทั้งเว็บจากที่เดียว
//
// ⚠️⚠️ พาเลตรอบนี้ (brand-spec §2 ล็อกค่าไว้ ห้ามเดาเพิ่ม ห้ามดูดสีจากรูป):
// 🚨🚨 **กลับทิศ 180° จากรอบก่อน — รอบนี้มืดทั้งเว็บ** ทั้งเนื้อหาและโครมเป็นผิวเข้ม
// พื้นเพจ #002908 (bg.json) · การ์ด #073c1a · ชั้นยก #0e5424 · โครม #031b09 /
// #010d04 · เส้นบาง #1e7033 · ขอบ/ออรา #35a043 · หมึก #eef7f0 (= BRAND_TEXT) ·
// หมึกรอง #9dc2a5 · เงินโครเมียม #dfe6e3 · ทองอำพัน #e8c86a ·
// **หัวข้อ + <strong> = #3ddc4a** (6.9:1 บนการ์ด · 8.7:1 บนพื้นเพจ)
// 🚨🚨 **#35a043 (3.8:1) และ #1e7033 (2.1:1) ห้ามถือตัวอักษรเด็ดขาด** —
// เส้น/ขอบ/ออรา/พื้นถมเท่านั้น · ส่วน #eef7f0 #dfe6e3 #e8c86a #3ddc4a #9dc2a5
// ถือตัวอักษรบนผิวเข้มได้ทั้งหมด
// 🚨🚨 **รอบก่อน (TEVA69) ก็เป็นแบรนด์เขียว/เงินโครเมียม/ทองอำพันเหมือนกันเป๊ะ
// ต่างกันแค่กลับทิศสว่าง-มืด** → "เจอเขียว/เงิน/ทอง ≠ เป็นของรอบนี้" ต้องเทียบให้
// ตรงหกหลัก ค่าที่ห้ามเหลือ (เขียนแบบไม่มี # เพื่อไม่ให้ sweep สะดุดที่คอมเมนต์นี้):
// f0ffeb ffffff e6f7df d7f0cd b2dba3 3f7a2e 10280f 3c5b36 116018 0b4a12 1a7d24
// 8a6a0e 28c437 e3bb45 c6cfd2 0b2a12 15401d 051409 2d6b2f e8fbe4 b4d6ad (TEVA69
// ขาออกทันที เสี่ยงสูงสุด — **e8fbe4 ↔ eef7f0 · c6cfd2 ↔ dfe6e3 · e3bb45 ↔ e8c86a ·
// 28c437 ↔ 3ddc4a · b4d6ad ↔ 9dc2a5 · 15401d ↔ 0e5424**) · 0c3a16 0a5f1c 0b7d28
// 0f9b35 061f0c (สาธุ168 — **0c3a16 ↔ 073c1a ต่างหลักเดียว**) · 8ce023 e9f7d6 bde397
// 1a5c04 2f8c07 051400 0f2e05 06220a (KINGKONG555) · 1fae1c 0d2312 143a1c 07130a
// (888PARUAY — **143a1c ↔ 073c1a**) · 117a41 2bb061 2fbf6a (MEXICANOSLOT/KOON234) ·
// fff0f0 ffe4e6 ffd4d7 f5b9bd a8333f 25090f 6e3b44 b00718 c1071b 8a0412 8f6310
// d61023 ff2436 e9b53c c3ccd6 (LOTTO189) · 7a1bd6 2b3fd9 c2178b f23bb4 bb6dff
// 7aa7ff 5411c4 241046 190b3d 271257 100626 5b2f9e f3e8ff c0a6e8 (ZANE96) ·
// 2a1206 7a3a0c fff3e0 e0b784 c98a24 d13800 fa4903 e8a000 ff8a2b d8dde6 (ZNOVA168)
// ⚠️ รอบนี้ **ไม่มีม่วง ไม่มีฟ้า/ไซแอน ไม่มีชมพู/แมเจนต้า ไม่มีแดง ไม่มีส้มเพลิง**
// เป็นสี UI เลยสักเฉด · LINE green 00B900 กับเขียว success ของฟีดเป็นสีเชิงความหมาย
// **คงไว้ ห้ามกลืนเข้าพาเลตเขียวของรอบนี้ แม้รอบนี้แบรนด์จะเขียวก็ตาม**
//
// ย่อหน้าในไฟล์นี้ไม่ถือคลาสสีหรือขนาดของตัวเอง — ทุก ContentBox* ในมิกซ์นี้ตั้ง
// `text-left text-base leading-relaxed` + หมึก #eef7f0 ไว้บน element ที่ถือ slot
// อยู่แล้ว และไม่มี `<p>` ไหนมี mx-auto / max-w-* (การ์ดคุมความกว้างเองแล้ว)
// ข้อยกเว้นเดียวคือ **ป้าย "ขั้นตอนที่ 1/2/3" ใน §6** ซึ่งเป็นป้าย ไม่ใช่เนื้อความ
// จึงถือ font-bold + สีหัวข้อได้ และต้องเป็น <p> **ห้ามเป็น heading ทุกระดับ**
//
// ⚠️ ชื่อแบรนด์รอบนี้เป็น **ตัวละตินพิมพ์ใหญ่ + เลข ติดกัน ไม่มีเว้นวรรค ไม่มีขีด**
// (ต่างจากโดเมนที่มีขีด) แต่ยัง interpolate จาก `${BRAND_NAME}` ทุกจุดรวมถึงใน alt
// ของสไลด์ **ห้ามพิมพ์ชื่อแบรนด์เป็นตัวอักษรตรงๆ ที่ไหนเลย** ไม่มีโดเมนเขียนไว้
// ที่ไหน และไม่มี URL ที่ต่อด้วย `+`
//
// <strong> ทุกตัวคร่อม "ก้อนที่คั่นด้วยช่องว่าง" ทั้งก้อน เพราะภาษาไทยไม่มีช่องว่าง
// ระหว่างคำ — ไฮไลต์ที่เริ่มหรือจบกลางคำจะถูก formatter ตัดบรรทัดในแท็กแล้วแทรก
// ช่องว่างกลางคำ อ่านคอปปี้โดยถอดแท็กออกต้องได้ข้อความของบรีฟเป๊ะ และไม่มี <strong>
// สองตัวติดกันโดยไม่มีข้อความธรรมดาคั่น
//
// บรีฟรอบนี้ **โฆษณาและกำกับในประโยคเดียวกัน** (brand-spec §5): หัวข้อเขียนว่า
// เกมคาสิโนสายตรง · ถูกลิขสิทธิ์ · ไม่ผ่านเว็บตัวแทน · แทงได้เท่าไหร่ เว็บจ่ายเต็ม
// ไม่มีโกง · ไม่มีขั้นต่ำ ขณะที่ย่อหน้าของบรีฟเองตอบกลับว่า ควรตรวจสอบข้อมูลบริษัท
// และหลักฐานการได้รับอนุญาตจากแหล่งที่เชื่อถือได้ก่อนใช้งาน · ควรตรวจสอบหลักฐาน
// การดำเนินงานและเงื่อนไขการจ่ายรางวัลให้ชัดเจน เพราะไม่สามารถรับประกันความ
// น่าเชื่อถือหรือผลตอบแทนจากข้อความโฆษณาเพียงอย่างเดียว · โปรโมชั่นคืนยอดเสียไม่ได้
// รับประกันว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งถัดไป ·
// ควรตรวจสอบว่าข้อความไม่มีขั้นต่ำครอบคลุมเฉพาะการสมัครหรือรวมถึงการฝากเงินและ
// การเดิมพันด้วย — **ship ทั้งสองครึ่งตรงตามที่บรีฟเขียน ไม่ขยายคำโฆษณาเป็นคำ
// กล่าวอ้างใหม่ และทุกประโยคกำกับ ship ครบ ไม่ตัดเพราะฟังดูลบ**
// ตัวเลขบนหน้านี้มีแค่ของบรีฟเอง: **0.3% · 0.8% · 3 ขั้นตอน · 24ชม.**
// ❌ ไม่มีจำนวนสมาชิก ไม่มีปีก่อตั้ง ไม่มี 100% ไม่มีค่า RTP ไม่มีจำนวนค่าย/เกม
// ไม่มียอดฝากขั้นต่ำเป็นตัวเลข · บรีฟไม่มีหมวด **ฝากถอน/ธนาคาร/วอลเลท/ทรูมันนี่/
// ออโต้** เลย จึงไม่มีคำพวกนั้นบนหน้านี้
// ⚠️ `หวย` ใช้ได้เฉพาะในฐานะ **หนึ่งในห้าหมวดเกม** ตามที่บรีฟเขียน — ไม่มีเนื้อหา
// เฉพาะทางหวย (งวด · เลขเด็ด · สลาก · โพย · รอบปิดรับ · สองตัวบน-ล่าง ·
// สามตัวตรง-โต๊ด) บนหน้านี้เลย
// ❌ คำของแบรนด์ก่อนห้ามเขียนกลับเข้ามา: TEVA69 / เกมพนันเบอร์ต้นๆของไทย /
// ค่ายแท้ ถูกลิขสิทธิ์ / **เซิร์ฟนอก** / ปลอดภัยในไทย / สมัครเล่นไม่มีขั้นต่ำ
// (TEVA69 ขาออกทันที) · ZANE96 / สล็อตลิขสิทธิ์แท้ในไทย / **เว็บตรงไม่ผ่านเอเย่นต์** /
// แหล่งรวมเกมสล็อตแบรนด์ดัง / ยูสใหม่เล่น1บาทได้ (ZANE96 — เจ้าของเดิมของ
// NavbarCyber/FooterCyber) · LOTTO189 / แนะนำเว็บหวยลอตโต้ / แทงหวยจ่ายสด /
// รับทุกเลข ไม่มีอั้น / อัตราจ่าย 2 ตัว 100 / 3 ตัว 1,000 · ZNOVA168 / ZOLO99 /
// สล็อต1บาททรูวอลเลท / ฝากถอนธนาคารและวอลเลท / ฟรีสปิน / ค่า RTP / ความผันผวน ·
// MEXICANOSLOT / สล็อตเมกซิกัน / การันตีเว็บตรง / ยอดเข้าบริษัทแน่นอน ·
// okkub88 / KINGKONG555 / สาธุ168 / 888PARUAY / เว็บตรงแตกง่าย / เบทต่ำ /
// ไม่ทำเทิร์น / ถอนได้ไม่จำกัด / ไม่ผ่านเอเย่นต์100% / ไม่ผ่านม้า / เซิร์ฟไทย /
// ทรูวอลเลท / ทรูมันนี่
// ⚠️ **"ไม่ผ่านเว็บตัวแทน" คือถ้อยคำของบรีฟรอบนี้** และเป็นตัวแทนที่ถูกต้องของทั้ง
// "เซิร์ฟนอก" (TEVA69) และ "เว็บตรงไม่ผ่านเอเย่นต์" (ZANE96) — อย่าสลับกลับ
//
// title/description = บรรทัด 1-2 ของบรีฟ **verbatim** (src/assets/content.txt)
// ส่งที่นี่เพราะ pageGraph ต้องใช้สตริงเดียวกับที่ MainLayout ได้รับ
// **ห้ามต่อเติม** (description = 141 ตัวอักษร ตามที่บรีฟเขียนมาเอง และ
// verify-build ยกเว้นเพดานล่าง 150 ให้หน้าแรกไว้ด้วยเหตุผลนี้โดยเฉพาะ)
const pageTitle = `${BRAND_NAME} เกมคาสิโนสายตรง แทงได้เท่าไหร่ เว็บจ่ายเต็ม ไม่มีโกง`;

const pageDescription = `${BRAND_NAME} เกมคาสิโนสายตรง รวมเกมเดิมพันออนไลน์ ถูกลิขสิทธิ์ ไม่ผ่านเว็บตัวแทน บาคาร่า สล็อต หวย บอล ไฮโล แทงได้เท่าไหร่ เว็บจ่ายเต็ม ไม่มีโกง`;

// บรรทัด 3 ของบรีฟ ซึ่ง **ต่างจากบรรทัด 1 เล็กน้อย** — ใช้ตามบรีฟ ไม่ copy title
const pageH1 = `${BRAND_NAME} เกมคาสิโนสายตรง รวมเกมเดิมพันออนไลน์ ถูกลิขสิทธิ์`;

// บรีฟรอบนี้มีชั้น H1 -> H2 -> H3 จริง จึง **ไม่** แบนเป็น H2 ล้วน
//
// checklist ตามลำดับเอกสาร (brand-spec §4) และตัวที่รับแต่ละข้อ:
//    1 H1  <แบรนด์> เกมคาสิโนสายตรง รวมเกมเดิมพันออนไลน์ ถูกลิขสิทธิ์
//          ContentBoxNeumorphism, ย่อหน้าบรรทัด 4
//    2 H2  <แบรนด์> บาคาร่า สล็อต หวย บอล ไฮโล แทงได้เท่าไหร่ เว็บจ่ายเต็ม ไม่มีโกง
//          ContentBoxTwoNeumorphism, บรรทัด 6 แบ่งสองซีกโดยไม่ตกประโยคไหน
//          + ProviderGridPremium ต่อท้ายทันที (วิดเจ็ตหมวดเกมของหัวข้อนี้โดยตรง)
//    3 H2  โปรโมชั่น <แบรนด์> อัปเดตใหม่ตลอดสัปดาห์
//          ContentBoxPremium, บรรทัด 8
//    4 H3  โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน
//          ContentBoxSevenThreePremium + slide1 ในสล็อตขวา, บรรทัด 10
//    5 H3  โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด
//          ContentBoxSevenThreeNeumorphism + slide2 ในสล็อตขวา, บรรทัด 12
//    6 H2  สมัครเล่น <แบรนด์> คาสิโนไม่มีขั้นต่ำ 3 ขั้นตอน
//          ContentBoxPremium, intro (บรรทัด 14) + สามขั้นตอน (บรรทัด 15-20)
//          ห่อใน <div> เดียวตามกฎบ้าน "หนึ่งสล็อตรับ element เดียว"
//    7 H2  แอดมิน <แบรนด์> คาสิโนออนไลน์ตลอด 24ชม.
//          ContentBoxTwoCyberCut (**ส่ง as="h2" ชัดเจน** default ของมันเป็น "p"),
//          บรรทัด 22 แบ่งสองซีกโดยไม่ตกประโยคไหน
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ <แบรนด์>
//          Faq3 + prop faqs ชัดเจน, บรรทัด 24-29
// inventory ที่ต้องได้: **h1 ×1 · h2 ×5 · h3 ×2** — ตรงเป้าของ brand-spec §4
//
// ⚠️ จุดที่ชั้น heading รั่วได้ และกันไว้แล้วทุกจุด: บรรทัด 15/17/19 ของบรีฟ
// (ขั้นตอนที่ 1/2/3) **ไม่มี prefix H** จึง render เป็น <p class="font-bold">
// ในสล็อตของ §6 ไม่ใช่ป้ายคอลัมน์และไม่ใช่ heading · ContentBoxTwoNeumorphism
// **ไม่ส่ง titleleft/titleright** เพราะบรีฟไม่ได้ตั้งชื่อให้สองซีกนั้น การคิดป้าย
// ขึ้นมาเองจะเป็นถ้อยคำของหน้า ไม่ใช่ของบรีฟ · **ไม่ส่ง titleright ให้ SevenThree
// ทั้งสองใบ** คอลัมน์ภาพจึงไม่มี heading · ContentBoxTwoCyberCut ได้ as="h2" ชัดเจน
// แต่ไม่ได้รับป้ายสองคอลัมน์ · คำถามใน Faq3 เป็น <span> ใน <summary> ไม่ใช่ heading
// และหัวข้อของมันมาจาก prop
// grep `<h[1-6]` ในทุก component ที่ไฟล์นี้เรียกแล้วรอบนี้ — ไม่มีตัวไหน hardcode
// heading ไว้เลย ทุกแท็ก heading บนหน้ามาจาก prop คือมาจากบรีฟ
// chrome บนหน้านี้ (Announcement3 · ProviderGridPremium · LatestWinnersCyber ·
// ReviewCardSumo · Navfoot) ขึ้นป้ายเป็น <p>/<span> พร้อม aria-label บน <section>
// **ห้ามเลื่อน <p> พวกนั้นขึ้นเป็น h2 เพื่อ "แก้ชื่อที่ขาด"**
//
// ── รูปภาพ ────────────────────────────────────────────────────────────────
// รอบนี้ใช้ **สองใบ** และอยู่ในตระกูล SevenThree ทั้งคู่ (playbook ตรึง slide* ไว้
// กับตระกูลนี้ และเพดานคือ 2 บล็อก — รอบนี้ใช้ครบพอดี ไม่มีใบที่สาม)
// **ข้อความที่พิมพ์บนอาร์ตเวิร์กคือตัวตัดสินการจับคู่ ไม่ใช่ลำดับไฟล์**:
//   slide1.png พิมพ์ **คืนยอดเสีย 0.3%** -> §4 (ContentBoxSevenThreePremium)
//   slide2.png พิมพ์ **แนะนำเพื่อน 0.8%** -> §5 (ContentBoxSevenThreeNeumorphism)
// ⚠️⚠️ **กลับข้างจากรอบก่อน** (รอบก่อน slide2 = คืนยอดเสีย) — uploader เขียนทับ
// สองไฟล์นี้ทุกดรอป การจับคู่จึงไม่มีความหมายข้ามแบรนด์ **ห้ามลอกจากรอบก่อน**
// ⛔ **banner1 / banner1-mobile / og.png เป็นของ MainLayout** (glob ปักชื่อไว้แล้ว)
// และ **banner2.png / banner3.png (10-23) / slide3.png / slide4.png (09-29) เป็น
// อาร์ตเวิร์กของแบรนด์อื่น ห้าม import เด็ดขาด** เพราะ eager import = emit ขึ้น
// dist ทุก build แม้ไม่มีหน้าไหน render และ verify-build.mjs จะแดงถ้ามีรูปที่ไม่ได้
// ถูก render
// ⚠️ ไม่มีภาพไหนบนหน้านี้เป็น LCP (hero อยู่ที่ MainLayout) จึง **ไม่มี
// loading="eager" / fetchpriority="high"** สักใบ สไลด์ทั้งสองอยู่ใต้ fold
//
// `widths`/`sizes` คำนวณจากเรขาคณิตจริงของคอลัมน์ภาพ (3fr ฝั่งขวา) ของ **variant
// ที่ถือรูปใบนั้นจริง ๆ** — สองชุดนี้ **สลับกันไม่ได้** และ **ไม่ได้ลอกจากรอบก่อน**
// (รอบก่อนคิดจาก ContentBoxSevenThreeFloatingBadge + ContentBoxSevenThree ตัวฐาน
// ซึ่งเป็นคนละไฟล์กับรอบนี้ทั้งคู่) Tailwind เป็น border-box ทั่วโปรเจกต์ max-w/
// padding จึงนับรวมกัน · บิตแมปจริงของดรอปนี้ **375x600 ทั้งสองใบ** เพดานจึงเป็น
// **375 และห้ามมี candidate ไหนเกิน 375** เพราะเกินกว่านั้นคือการอัพสเกล
//
// §4 ContentBoxSevenThreePremium — **max-w-7xl อยู่ที่ <section>** px-4 จึงถูกหัก
// ออกจาก 1280 · border 1x2 = 2 · md:p-10 = 80 · gap-10 = 40 ·
// คอลัมน์ภาพจ่าย md:border-l (1) + md:pl-10 (40) = 41
//   >= 1280px : (1280 - 32 - 2 - 80 - 40) x 0.3 - 41 = 1126 x 0.3 - 41 = 297px
//   768-1279  : (100vw - 154) x 0.3 - 41             = calc(30vw - 87px)
//   473-767   : ยุบเหลือคอลัมน์เดียวที่การ์ด p-8 -> 100vw - 98 ซึ่ง >= 375 จึงติด
//               เพดานบิตแมป                          = 375px
//   < 473     : คอลัมน์เดียวที่ p-8                  = calc(100vw - 98px)
// candidate: 149 = ครึ่งของ 297 (และคลุมค่าต่ำสุดของแบนด์ md ที่ 768px = 143) ·
//   277 = 100vw-98 ที่จอ 375px · 297 = 1x ที่ >= 1280px · 375 = **เพดานบิตแมปจริง**
const cashbackWidths = [149, 277, 297, 375];
const cashbackSizes = "(min-width: 1280px) 297px, (min-width: 768px) calc(30vw - 87px), (min-width: 473px) 375px, calc(100vw - 98px)";

// §5 ContentBoxSevenThreeNeumorphism — **max-w-[1400px] อยู่ที่ <section>** px-4 จึง
// ถูกหักออกจาก 1400 · border 1x2 = 2 · md:p-10 = 80 · gap-8 = 32 ·
// คอลัมน์ภาพจ่าย md:border-l (1) + md:pl-8 (32) = 33
//   >= 1400px : (1400 - 32 - 2 - 80 - 32) x 0.3 - 33 = 1254 x 0.3 - 33 = 343px
//   768-1399  : (100vw - 146) x 0.3 - 33             = calc(30vw - 77px)
//   473-767   : คอลัมน์เดียวที่การ์ด p-8 -> 100vw - 98 ซึ่ง >= 375 จึงติดเพดาน = 375px
//   < 473     : คอลัมน์เดียวที่ p-8                  = calc(100vw - 98px)
// candidate: 154 = ค่าต่ำสุดของแบนด์ md (ที่ 768px) · 277 = 100vw-98 ที่จอ 375px ·
//   343 = 1x ที่ >= 1400px · 375 = **เพดานบิตแมปจริง**
const referralWidths = [154, 277, 343, 375];
const referralSizes = "(min-width: 1400px) 343px, (min-width: 768px) calc(30vw - 77px), (min-width: 473px) 375px, calc(100vw - 98px)";

// ⚠️ อาร์ตเวิร์กพิมพ์ชื่อแบรนด์ไว้บนรูปจริง แต่ alt บรรยาย **รูปทรงของเวิร์ดมาร์ก**
// แล้วอ้างชื่อด้วย ${BRAND_NAME} — ห้ามพิมพ์ตัวอักษรชื่อแบรนด์ลง alt ตรงๆ
// บรรยายจากบิตแมปจริงของดรอปนี้ (brand-spec §6) **ไม่ใช่คัดลอกของรอบก่อน**
// ภาษาภาพของ TEVA69 ที่ **ไม่มี** ในสองรูปนี้เลย — ห้องสีขาวครีมที่มีหน้าต่างบานสูง ·
// หญิงสาวสวมสูทขาวนั่งบนอาร์มแชร์ขาว · โน้ตบุ๊กเปิด · ชิปพิมพ์เลข 69 และ 6 ·
// ต้นไม้ใบเขียวในกระถาง · และของเก่ากว่านั้น ลูกบอลหวยขาว · โพยหวย · ปากกาทอง ·
// ตู้สล็อต 777 ม่วง · เชอร์รี่ชมพู · ซอมเบรโร · นักรบหญิงถือดาบเงิน
// ✅ **กิโมโนลายดอกไม้เขียว-ขาว กอไผ่ ดอกไม้ขาว ชิปคาสิโนเขียว-ขาว และมงกุฎทอง
// ดวงเล็กมีจริงในดรอปนี้** บรรยายได้ตามที่เห็น
const cashbackAlt = `โปสเตอร์แนวตั้งของ ${BRAND_NAME} มุมบนขวาเป็นโลโก้ ${BRAND_NAME} ซึ่งเป็นเวิร์ดมาร์กสามมิติที่ครึ่งแรกเป็นตัวอักษรละตินผิวโครเมียมเงินขัดเงา และครึ่งหลังเป็นตัวเลขผิวเขียวมรกตเคลือบเงาเรืองแสง ตัดขอบดำหนาทั้งชุด กลางภาพเป็นหญิงสาวผมยาวเกล้ามวยประดับดอกไม้ขาว สวมกิโมโนลายดอกไม้สีเขียวสลับขาว ยืนอยู่ในฉากกอไผ่และดอกไม้ขาว ครึ่งล่างพิมพ์คำว่า โปรโมชั่น ใต้ลงมาเป็นคำว่า คืนยอดเสีย แล้วตามด้วยตัวเลข 0.3% ตัวโต ทั้งสามบรรทัดเป็นตัวอักษรเขียวมรกตเคลือบเงาตัดขอบทอง ปิดท้ายด้วยแคปซูลพื้นดำขอบทองที่เขียนว่า สมัครสมาชิก พร้อมไอคอนรูปคนและเครื่องหมายลูกศรคู่`;

const referralAlt = `โปสเตอร์แนวตั้งของ ${BRAND_NAME} ในฉากกอไผ่เดียวกัน มุมบนซ้ายเป็นโลโก้ ${BRAND_NAME} แบบเวิร์ดมาร์กสามมิติ ครึ่งแรกเป็นตัวอักษรละตินผิวโครเมียมเงินขัดเงา ครึ่งหลังเป็นตัวเลขผิวเขียวมรกตเคลือบเงา ตัดขอบดำหนา กลางภาพเป็นหญิงสาวผมยาวเกล้ามวยประดับดอกไม้ สวมกิโมโนลายดอกไม้สีเขียวสลับขาว ล้อมด้วยกองชิปคาสิโนสีเขียวเข้มสลับขาวที่มีมงกุฎทองดวงเล็กวางอยู่ด้านบน ครึ่งล่างพิมพ์คำว่า โปรโมชั่น โดยมีมงกุฎทองดวงเล็กอีกดวงอยู่เหนือตัวอักษร ถัดลงมาเป็นคำว่า แนะนำเพื่อน แล้วตามด้วยตัวเลข 0.8% ตัวโต ทั้งชุดเป็นตัวอักษรเขียวมรกตเคลือบเงาตัดขอบทอง ปิดท้ายด้วยแคปซูลพื้นดำขอบทองที่เขียนว่า สมัครสมาชิก พร้อมไอคอนรูปคนและเครื่องหมายลูกศรคู่`;

// อาร์เรย์เดียว ใช้ทั้งกับ <Faq> และโน้ด FAQPage — ไม่ใช้ default ของ component
// (Faq3 ตั้งใจ ship เป็นลิสต์ว่าง prop ที่ลืมส่งจึงได้ accordion เปล่า ไม่ใช่
// คำถามของแบรนด์ก่อน) สามคู่นี้คือบล็อก Q/A ของบรีฟเอง (content.txt บรรทัด 24-29)
// ตรงตัว ตัดเฉพาะหมายเลข "1." "2." "3." ออกเพราะ accordion เป็นตัวลิสต์อยู่แล้ว
// ทุกคำตอบคงประโยคกำกับของบรีฟไว้ครบ — เป็นเนื้อหาของบรีฟทั้งสองครึ่ง
const faqs = [
  {
    q: `${BRAND_NAME} มีเกมคาสิโนประเภทไหนให้เลือกบ้าง?`,
    a: `ตามข้อมูลที่ระบุ ${BRAND_NAME} นำเสนอบาคาร่าสล็อต หวยออนไลน์ เดิมพันฟุตบอล และไฮโล โดยควรตรวจสอบรายชื่อเกมและผู้ให้บริการที่เปิดใช้งานจริงจากเว็บไซต์`,
  },
  {
    q: `${BRAND_NAME} มีโปรโมชั่นคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% หรือไม่?`,
    a: `ตามข้อมูลที่ระบุ มีโปรโมชั่นทั้งสองรายการ โดยควรตรวจสอบประเภทเกมที่เข้าร่วม รอบคำนวณยอด และเงื่อนไขการรับเครดิตจากประกาศล่าสุดก่อนใช้สิทธิ์`,
  },
  {
    q: `สามารถสมัครสมาชิก ${BRAND_NAME} โดยไม่มีขั้นต่ำได้หรือไม่?`,
    a: `เว็บไซต์ระบุว่าสมัครสมาชิกได้โดยไม่มีขั้นต่ำ แต่ควรตรวจสอบว่ายอดฝากและยอดเดิมพันขั้นต่ำของแต่ละเกมมีข้อกำหนดเพิ่มเติมหรือไม่ก่อนดำเนินการ`,
  },
];

// ไม่มี breadcrumb: นี่คือหน้าแรก เส้นทางจาก root มาหาตัวเองจะเหลือครั้งเดียวที่ชี้ตัวเอง
// ทุก URL ในกราฟมาจาก pageGraph ที่ derive จาก site: — ไม่มีโดเมนพิมพ์ไว้ในไฟล์นี้
// ไม่มี URL ที่ต่อด้วย `+` และไม่ส่งโน้ด Review / AggregateRating / sameAs /
// address / email เข้าไปเลย
// `description` เป็นสตริงเดียวกับที่ MainLayout ได้รับ `name` เป็น H1 ของหน้า และ
// `faqs` เป็นอาร์เรย์ตัวเดียวกับที่ <Faq> ได้รับ
const graph = pageGraph(Astro, {
  name: pageH1,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxNeumorphism as="h1" title={pageH1}>
    <p>
      {BRAND_NAME}
      <strong class="text-[#3ddc4a]">นำเสนอข้อมูลเกมคาสิโนออนไลน์หลากหลายประเภท</strong>
      ทั้งบาคาร่า สล็อตออนไลน์ หวยออนไลน์ เดิมพันฟุตบอล และไฮโล พร้อมรายละเอียดระบบสมาชิก โปรโมชั่น และช่องทางติดต่อเจ้าหน้าที่ ผู้ใช้งานสามารถศึกษากติกาเกมและเงื่อนไขการเดิมพันผ่านเว็บไซต์ได้
      <strong class="text-[#3ddc4a]">ส่วนคำกล่าวอ้างเกี่ยวกับการเป็นคาสิโนสายตรงหรือเกมถูกลิขสิทธิ์ ควรตรวจสอบข้อมูลบริษัทและหลักฐานการได้รับอนุญาตจากแหล่งที่เชื่อถือได้ก่อนใช้งาน</strong>
    </p>
  </ContentBoxNeumorphism>

  <ContentBoxTwoNeumorphism as="h2" title={`${BRAND_NAME} บาคาร่า สล็อต หวย บอล ไฮโล แทงได้เท่าไหร่ เว็บจ่ายเต็ม ไม่มีโกง`}>
    <p slot="left">
      {BRAND_NAME} รวบรวมข้อมูลเกมเดิมพันหลายหมวดหมู่
      <strong class="text-[#3ddc4a]">ได้แก่ บาคาร่าเกมสล็อต หวยออนไลน์ ฟุตบอล และไฮโล</strong>
      ซึ่งแต่ละประเภทมีรูปแบบการเดิมพันและอัตราจ่ายแตกต่างกัน
    </p>
    <p slot="right">
      ผู้ใช้งานควรตรวจสอบวงเงินเดิมพันขั้นต่ำและสูงสุด รวมถึงข้อกำหนดการถอนเงินก่อนทำรายการ
      <strong class="text-[#3ddc4a]">แม้เว็บไซต์จะระบุว่าจ่ายเต็มและไม่มีโกง แต่ควรตรวจสอบหลักฐานการดำเนินงานและเงื่อนไขการจ่ายรางวัลให้ชัดเจน</strong>
      เพราะไม่สามารถรับประกันความน่าเชื่อถือหรือผลตอบแทนจากข้อความโฆษณาเพียงอย่างเดียว
    </p>
  </ContentBoxTwoNeumorphism>

  <ProviderGridPremium />

  <ContentBoxPremium as="h2" title={`โปรโมชั่น ${BRAND_NAME} อัปเดตใหม่ตลอดสัปดาห์`}>
    <p>
      {BRAND_NAME} นำเสนอข้อมูลโปรโมชั่นสำหรับสมาชิก
      <strong class="text-[#3ddc4a]">โดยมีรายการคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8% เป็นสิทธิพิเศษที่ระบุไว้</strong>
      ผู้ใช้งานสามารถติดตามประกาศโปรโมชั่นประจำสัปดาห์เพื่อศึกษารอบรับเครดิตและเงื่อนไขการเข้าร่วม โดยแต่ละรายการอาจกำหนดประเภทเกม ยอดที่นำมาคำนวณ และข้อจำกัดการถอนเงินแตกต่างกัน
      <strong class="text-[#3ddc4a]">จึงควรตรวจสอบรายละเอียดล่าสุดก่อนรับสิทธิ์ทุกครั้ง</strong>
    </p>
  </ContentBoxPremium>

  <ContentBoxSevenThreePremium as="h3" title="โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน">
    <p slot="left">
      โปรโมชั่นคืนยอดเสีย 0.3%
      <strong class="text-[#3ddc4a]">เป็นรายการที่ระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขรายวัน</strong>
      สมาชิกควรตรวจสอบว่าบาคาร่าสล็อต หวย บอล หรือไฮโลประเภทใดเข้าร่วมรายการ รวมถึงรอบเวลาคำนวณยอดและวิธีรับเครดิตให้ครบถ้วน เพราะการเดิมพันบางรายการอาจไม่เข้าเกณฑ์รับสิทธิ์ นอกจากนี้ควรศึกษาข้อกำหนดการใช้โบนัสและการถอนเงินก่อนรับเครดิต
      <strong class="text-[#3ddc4a]">โดยโปรโมชั่นคืนยอดเสียไม่ได้รับประกันว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งถัดไป</strong>
    </p>

