---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import LatestWinners from "../components/LatestWinners3.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxTwoHuay from "../components/ContentBoxTwoHuay.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThreeHuay from "../components/ContentBoxSevenThreeHuay.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBox from "../components/ContentBox.astro";
import Faq from "../components/Faq4.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import { pageGraph } from "../lib/schema";
import imgTwoDigit from "../assets/slide2.png";
import imgThreeDigit from "../assets/slide1.png";

// VARIANT ROTATION THIS ROUND (หวย24 -> หวยดีใจ). Zero file reuse from the previous
// round: Announcement5 replaces Announcement3, LatestWinners3 replaces
// LatestWinnersPremium, Faq4 replaces Faq3, and the ContentBox shape-mix moves off
// FloatingBadge / TwoNeumorphism / CyberCut / SevenThreeNeumorphism /
// SevenThreeCyberCut / TwoCyberCut onto Premium / TwoHuay / Neumorphism /
// SevenThreePremium / SevenThreeHuay / TwoPremium. NavbarStyle8 and FooterPremium
// are the layout's pair this round (previously NavbarStyle10 / FooterStyle3) and
// the brand font moves google-sans -> kanit; all three are the orchestrator's
// shared-chrome step, not this page's.
// Plain ContentBox is the one deliberate carry-over: terms, privacy, 404 and every
// button page render their body through it by rule and cannot follow a rotation,
// so it is always-live and the orchestrator rethemes it in the shared step — this
// page only passes it props. ContentBoxNeumorphism is in the same shared set this
// round (a second page renders it), so section 3 passes props and nothing else.
// Every unused *Cyber / *CyberCut / *FloatingBadge / Style file, Faq3,
// Announcement3 and LatestWinnersPremium stay on disk as inventory for the next
// brand — none of them was deleted, and the previous brand's copy and colour still
// inside them is expected drift, not a bug. ReviewCardSumo2 is reused rather than
// rotated to ReviewCardSumo because this page owns it and rewrote every row from
// the new brief; the rotation rule is about shape families with live siblings, and
// the review ledger's only sibling is the shape this one replaced.
//
// <Announcement /> runs bare on purpose: Announcement5's default message is already
// this brand's copy and every sub-page calls it bare too, so passing an override
// here is exactly how the ticker ends up saying two different things on two pages
// of the same site.
//
// IMAGE ROLES FOR THIS DROP (2026-10-04). Two files are referenced from this page
// and only two, and each pairing is read off the artwork itself rather than copied
// from last round — the pairing is REVERSED from หวย24, which had slide1 on the
// 2-digit section:
//   slide2.png — white-and-silver draped backdrop crossed by red ribbon, model on
//     the LEFT in a metallic silver jacket, lottery balls 6 / 8 / 3 / 9 / 7 and
//     gold coins around her, and the plaque under the big gold อัตราการจ่าย
//     wordmark reads "2ตัว จ่าย100บาท", so it belongs to docx H3 #4. Imported as
//     imgTwoDigit.
//   slide1.png — same white-and-silver set, model on the RIGHT with both palms
//     open, balls 3 / 7 / 9 and gold coins bottom left, plaque reads
//     "3ตัว จ่าย1,000บาท", so it belongs to docx H3 #5. Imported as imgThreeDigit.
// Both files are 600x300, so 600 is the top real candidate — nothing above it
// would be a real pixel — and each picture carries max-w-[600px] so the art is
// never upscaled past its own bitmap. Each slide sits in a ContentBoxSevenThree*
// image+text block, which is that family's hard cap of two per rebrand, so there
// is no third SevenThree anywhere on the site.
// The two blocks mirror each other: SevenThreePremium lays out
// md:grid-cols-[3fr_7fr] so its picture goes in slot="left" while the paragraph
// keeps the wide column, and SevenThreeHuay lays out md:grid-cols-[7fr_3fr] so its
// picture goes in slot="right". The two pictures therefore alternate sides instead
// of stacking down the same edge, and each `sizes` describes its own 3fr column
// rather than the viewport. Both figures are copied from the arithmetic block in
// the component that owns the column — if a padding/gap/cap changes there, these
// move with it:
//   SevenThreePremium: max-w-7xl/1280px cap, px-4, p-8 (md:p-10), gap-10, and NO
//                      inner padding on the image column
//                      -> (1280 - 32 - 80 - 40) x 0.3 = 338px
//   SevenThreeHuay:    max-w-[1400px] cap, px-4, p-8 (md:p-10), gap-8, and the
//                      image column adds md:pl-6
//                      -> (1400 - 32 - 80 - 32) x 0.3 - 24 = 353px
// Below md both cards collapse to one column at p-8, so the drawn width is
// 100vw - 32 (section px-4) - 64 (card p-8) = 100vw - 96px, capped at 600px.
// Neither picture is the LCP element — MainLayout's hero banner is — so both are
// loading="lazy" fetchpriority="low".
//
// The alt text was written from THIS drop's artwork, not carried over: both slides
// are white/silver backgrounds crossed by red ribbon rather than the black-and-gold
// sets of the previous drop. slide2 has the model on the left in a metallic silver
// jacket, her right arm reaching forward and a lottery ball 8 held beside her face,
// with balls 6, 3, 9 and 7 and gold coins around her; slide1 has the model on the
// right in a short metallic silver dress with both palms open, and balls 3, 7 and 9
// over gold coins and ticket sheets in the lower left. Both carry the gold crown
// over the หวยดีใจ wordmark (chrome "หวย" + red "ดีใจ"), a large gold Thai
// อัตราการจ่าย wordmark under it, and that slide's own rate plaque beneath.
//
// Deliberately NOT imported, and every file still on disk:
//   banner2.png / banner3.png / slide3.png / slide4.png all predate this drop and
//   belong to previous brands — importing any of them would emit a competitor's
//   artwork into dist/, so there is no inline article illustration this round.
//   banner1.png and banner1-mobile.png belong to MainLayout's own pinned globs and
//   are never referenced from a page. og.png is the same: MainLayout owns it.
// Also deliberately unused: FeatureHighlights.astro (it renders sub-points as <h3>,
// and the brief's heading inventory allows exactly two H3s — sections 4 and 5 — so
// wiring it in would break the count), the ContentBox3Three* family (no brief
// section on this page is a three-way split; every section is one or two running
// paragraphs), and every *FloatingBadge variant (their badge clearance was derived
// against other pages' shorter titles).
//
// Vocabulary: หวยดีใจ is a pure lottery brand — a เว็บรับแทงหวยออนไลน์, not a
// casino. The words this page may use are the brief's own: แทงหวย, ส่งโพย, โพย,
// รอบ, รายการหวย, รัฐบาลไทย, หวยลาว, หวยฮานอย, หวยออมสิน, หวย ธ.ก.ส., เลข 2 ตัว,
// เลข 3 ตัว, เลขเด็ด, แนวทาง, สถิติย้อนหลัง, อัตราจ่าย, เรทจ่าย, ไม่อั้นจ่าย,
// ไม่มีลบโพย, วงเงินที่ระบบเปิดรับ, ผลรางวัล, ประวัติรายการ, สมัคร 3 ขั้นตอน,
// Login, แอดมิน 24 ชั่วโมง, PIN, OTP.
// The previous brand's angle (รับไม่อั้น/จ่ายเต็มทุกโพย as the headline promise,
// เลขดัง, วงเงินรับแทง, ประวัติโพย, and a market list that stopped at ลาว/ฮานอย/
// รัฐบาลไทย) is gone — the page was written from the new brief rather than
// find-and-replaced over the old sentences. Nothing here claims a licence, a
// regulator, an operator, a bank, a draw time, a lottery market beyond the brief's
// own five, a deposit minimum, a member count or a founding year, because the brief
// names none. The only figures are the brief's own: 2 ตัว, 3 ตัว, 100, 1,000,
// 3 ขั้นตอน, 24 ชั่วโมง. The brief's own hedging ships with the copy (แนวทางหวย
// เป็นข้อมูลประกอบ ไม่การันตีเลขเข้าทุกงวด · "ไม่อั้นจ่าย" ไม่ได้แปลว่าทุกเลขทุกรอบ
// ไม่มีวงเงินสูงสุด · "ไม่มีลบโพย" หมายถึงโพยที่ระบบยืนยันสมบูรณ์แล้ว · 2ตัว100 /
// 3ตัว1,000 ใช้กับรายการที่เข้าเงื่อนไข) — it is part of the paragraphs, not
// trimmed as downbeat.
//
// Title and description are the brief's own Title/Description lines, used verbatim
// and NOT padded up to 150: verify-build deliberately skips its 150-character floor
// on the home page for exactly this reason. The brand name is interpolated rather
// than typed so it can never drift from brandProfile, and no domain is written out
// anywhere in this file.
const pageTitle = `${BRAND_NAME} รับแทงหวยออนไลน์ พร้อมให้แนวทาง เลขเข้าทุกงวด`;

const pageDescription = `${BRAND_NAME} รับแทงหวยออนไลน์ ทุกตัวไม่อั้น รัฐบาลไทย ลาว ฮานอย ออมสิน ธกส. พร้อมให้แนวทางก่อนหวยออก การันตีเลขเข้าทุกงวด`;

// The brief has a real H2 -> H3 nesting this round, so the page is NOT flattened to
// H2-only. The two H3s are genuine headings — the two rate sub-points, both nested
// under the อัตราการจ่าย H2 — and they stay H3.
//
// The checklist, in document order, and what carries each one:
//    1 H1  หวยดีใจ รับแทงหวยออนไลน์ พร้อมให้แนวทาง เลขเข้าทุกงวดแน่นอน
//          ContentBoxPremium, brief paragraph on line 4
//    2 H2  เว็บ หวยดีใจ รับแทง รัฐบาลไทย ลาว ฮานอย ออมสิน ธกส ไม่อั้นจ่าย
//          ContentBoxTwoHuay, line 6 left / line 7 right
//    3 H2  อัตราการจ่ายเว็บ หวยดีใจ เรทจ่ายสูง ไม่มีลบโพย
//          ContentBoxNeumorphism, lines 9 + 10
//    4 H3  2ตัว จ่าย100บาท
//          ContentBoxSevenThreePremium + slide2 (imgTwoDigit), line 12
//    5 H3  3ตัว จ่าย1,000บาท
//          ContentBoxSevenThreeHuay + slide1 (imgThreeDigit), line 14
//    6 H2  สมัครแทง หวยดีใจ ง่ายๆ 3ขั้นตอน
//          ContentBoxTwoPremium, line 16 left / line 17 right
//    7 H2  ติดต่อแอดมิน หวยดีใจ เว็บแทงหวย ตลอด 24 ชั่วโมง
//          ContentBox + LINE / สมัครสมาชิก buttons, lines 19 + 20
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ หวยดีใจ
//          Faq4 + faqs prop, lines 22-27
// Final inventory for this page: h1 x1, h2 x5, h3 x2.
//
// Shape rhythm, top to bottom: gradient slab with a vertical rail -> two-column
// pair of bordered cards -> neumorphic raised panel -> 3:7 gradient slab ->
// 7:3 solid card -> two-column rail slab -> single-column rounded -> accordion.
// No shape repeats back to back, and the two SevenThree blocks differ at the border
// (red-black vs brand red) as well as in which side the picture takes.
//
// ContentBoxSevenThreePremium takes the docx heading through `title`, which falls
// back to its wide (7fr) RIGHT text column; its image column is passed no
// `titleleft`, so the block emits exactly one heading. ContentBoxSevenThreeHuay is
// the mirror and takes its heading through `titleleft`, the wide LEFT column, with
// no `titleright` on the picture.
//
// Every brief paragraph ships in full — all eleven of them, nothing merged or
// summarised. Sections 3 and 7 have two paragraphs each and stack inside one
// wrapper div so the slot still receives exactly one element; sections 2 and 6 have
// two each and run one per column; sections 1, 4 and 5 have one each. The column
// labels passed to the two two-column boxes are this page's own layout wording, not
// brief headings, and both variants render them as <p>.
//
// Everything else on the page is chrome and emits no heading tag at any level:
// Announcement5, LatestWinners3, LoginRtpSection and ReviewCardSumo2 render their
// titles as <p>/<span> with an aria-label on the section, and Faq4's questions live
// inside <summary> as <span>. The non-brief widgets sit before section 1 (the
// ticker, then the winners feed) and after section 8 (LoginRtpSection,
// ReviewCardSumo2, Navfoot) — never spliced between two content sections.

// One array, used by both <Faq> and the FAQPage node — never the component's own
// defaults, which belong to whichever brand shipped last. The three pairs are the
// brief's own Q/A block, verbatim.
const faqs = [
  {
    q: `${BRAND_NAME} มีหวยอะไรให้เลือกแทงบ้าง?`,
    a: "มีทั้งรัฐบาลไทย หวยลาว หวยฮานอย หวยออมสิน และหวย ธ.ก.ส. ตามรายการและรอบที่ระบบเปิดรับในแต่ละวัน สมาชิกควรตรวจสอบตารางเวลาและรายละเอียดก่อนส่งโพยทุกครั้ง",
  },
  {
    q: `แนวทาง ${BRAND_NAME} การันตีเลขเข้าทุกงวดหรือไม่?`,
    a: "ไม่สามารถการันตีเลขเข้าทุกงวดได้ แนวทาง เลขเด็ด และสถิติย้อนหลังสามารถใช้เป็นข้อมูลประกอบเท่านั้น ผลหวยในแต่ละรอบควรอ้างอิงประกาศอย่างเป็นทางการ และไม่มีแนวทางใดรับประกันผลล่วงหน้าได้แน่นอน",
  },
  {
    q: `${BRAND_NAME} 2 ตัวจ่าย 100 และ 3 ตัวจ่าย 1,000 ทุกหวยหรือไม่?`,
    a: "อัตรา 2 ตัว 100 บาท และ 3 ตัว 1,000 บาท ใช้กับรายการที่เข้าเงื่อนไข หวยแต่ละประเภทและรูปแบบการเดิมพันอาจมีเรทแตกต่างกัน จึงควรตรวจสอบอัตราล่าสุดบนหน้าส่งโพยก่อนยืนยันรายการ",
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space that
// splits the word — the copy must read identically with the tags removed.
// One highlight colour only: #f3c54e, the brand's gold accent (the crown above the
// logo), against the inherited body colour #edeaf0 (BRAND_TEXT). The paragraphs
// below carry no colour class of their own: every ContentBox* card in this mix
// already sets `text-left text-base leading-relaxed text-[#edeaf0]` on the element
// holding the slot, so the prose inherits it and no page-level override can drift
// from the card. No paragraph carries mx-auto or max-w-* either — the cards cap
// their own width.

// No breadcrumb: this is the homepage, so a trail from the root to itself would be a
// single self-referential crumb. Every URL in the graph is derived by pageGraph from
// `site:` — no domain is typed out in this file, and no Review / AggregateRating /
// sameAs / address / email node is passed.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <LatestWinners />

  <ContentBoxPremium as="h1" title={`${BRAND_NAME} รับแทงหวยออนไลน์ พร้อมให้แนวทาง เลขเข้าทุกงวดแน่นอน`}>
    <p>
      <strong class="text-[#f3c54e]">{BRAND_NAME} เว็บรับแทงหวยออนไลน์ที่รวมรายการยอดนิยมและแนวทางตัวเลขไว้ให้ติดตามก่อนหวยออก</strong>
      มีทั้งรัฐบาลไทย หวยลาว หวยฮานอย หวยออมสิน และหวย ธ.ก.ส.
      <strong class="text-[#f3c54e]">สมาชิกสามารถเลือกเลข ตรวจสอบรอบ อัตราจ่าย และส่งโพยผ่านมือถือได้จากบัญชีเดียว</strong>
      พร้อมดูแนวทางและสถิติประกอบการเลือกเลขในแต่ละรอบ อย่างไรก็ตาม แนวทางหวยเป็นข้อมูลประกอบเท่านั้น ไม่สามารถการันตีว่าเลขจะเข้าทุกงวดหรือรับประกันผลรางวัลล่วงหน้าได้
    </p>
  </ContentBoxPremium>

  <ContentBoxTwoHuay
    as="h2"
    title={`เว็บ ${BRAND_NAME} รับแทง รัฐบาลไทย ลาว ฮานอย ออมสิน ธกส ไม่อั้นจ่าย`}
    titleleft="รายการหวยที่เปิดรับตามรอบ"
    titleright="วงเงินที่ระบบเปิดรับ"
    iconleft="🎫"
    iconright="📊">
    <p slot="left">
      <strong class="text-[#f3c54e]">เว็บ {BRAND_NAME} รวบรวมหวยหลายประเภทไว้ให้เลือกตามรอบ</strong>
      ทั้งรัฐบาลไทยตามกำหนดออกรางวัล หวยลาว หวยฮานอย รวมถึงหวยออมสินและหวย ธ.ก.ส. ตามรายการที่เปิดให้บริการ
      <strong class="text-[#f3c54e]">สมาชิกสามารถตรวจสอบเวลาเปิดรับ เวลาปิดรับ เลขที่ต้องการ และยอดเดิมพันก่อนส่งโพย</strong>
      ช่วยให้ติดตามหลายรายการได้โดยไม่ต้องเปลี่ยนบัญชีไปมา
    </p>
    <p slot="right">
      หากเป็นเลขเด็ดหรือเลขที่มีผู้เลือกจำนวนมาก
      <strong class="text-[#f3c54e]">ควรตรวจสอบวงเงินที่ระบบเปิดรับก่อนยืนยัน</strong>
      เพราะคำว่า “ไม่อั้นจ่าย” ไม่ได้หมายความว่าทุกเลขหรือทุกรอบจะไม่มีวงเงินสูงสุด
      <strong class="text-[#f3c54e]">เงื่อนไขจริงควรยึดข้อมูลที่แสดงบนหน้าส่งโพยเป็นหลัก</strong>
    </p>
  </ContentBoxTwoHuay>

  <ContentBoxNeumorphism as="h2" title={`อัตราการจ่ายเว็บ ${BRAND_NAME} เรทจ่ายสูง ไม่มีลบโพย`}>
    <div class="flex flex-col gap-5">
      <p>
        อัตราการจ่ายเว็บ {BRAND_NAME} สำหรับรายการที่เข้าเงื่อนไขมีทั้ง
        <strong class="text-[#f3c54e]">2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท</strong>
        สมาชิกสามารถตรวจสอบเรทของหวยแต่ละรายการก่อนส่งโพย พร้อมดูเลข ยอดเดิมพัน และสถานะรายการให้ครบถ้วน
        <strong class="text-[#f3c54e]">หากโพยได้รับการยืนยันแล้วควรมีประวัติรายการให้สมาชิกกลับมาตรวจสอบได้</strong>
      </p>
      <p>
        <strong class="text-[#f3c54e]">คำว่า “ไม่มีลบโพย” ควรหมายถึงโพยที่ระบบรับและยืนยันอย่างสมบูรณ์ตามเงื่อนไขแล้ว</strong>
        ทั้งนี้กรณีรายการผิดพลาด เป็นโมฆะ หรือเหตุอื่นควรเป็นไปตามข้อกำหนดที่เว็บไซต์ประกาศไว้อย่างชัดเจน
      </p>
    </div>
  </ContentBoxNeumorphism>

  <ContentBoxSevenThreePremium as="h3" title="2ตัว จ่าย100บาท">
    <Picture
      slot="left"
      src={imgTwoDigit}
      loading="lazy"
      fetchpriority="low"
      widths={[338, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), (max-width: 1311px) calc(30vw - 46px), 338px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
