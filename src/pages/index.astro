---
import MainLayout from "../layouts/MainLayout.astro";
import AnnouncementHuay from "../components/AnnouncementHuay.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LatestWinnersHuay from "../components/LatestWinnersHuay.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import FaqHuay from "../components/FaqHuay.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgBanner2 from "../assets/banner2.png";
import imgBanner3 from "../assets/banner3.png";
import imgSlide1 from "../assets/slide1.png";

const pageTitle = "7LOTTO รับแทงหวยทุกประเภท เรท 2ตัว100 3ตัว1,000 ได้จริง ปล่อยยอดทันที";

const pageDescription = "7LOTTO เว็บแทงหวยครบทุกประเภท เรทจ่ายสูง 2ตัว100 3ตัว1,000 แทงถูก จ่ายจริง ปล่อยยอดให้ทันที ไม่จำกัดวงเงิน สมัครง่ายบนมือถือ พร้อมเจ้าหน้าที่ดูแลตลอด 24 ชม.";

const registerSteps = [
  {
    icon: "📝",
    title: "สมัครสมาชิก 7LOTTO และกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน",
    description: "",
    accent: "red" as const,
  },
  {
    icon: "🔐",
    title: "Login เข้าสู่บัญชีและทำรายการฝากเครดิตผ่านระบบอัตโนมัติ",
    description: "",
    accent: "silver" as const,
  },
  {
    icon: "🎯",
    title: "เลือกหวยและรอบที่ต้องการ ใส่เลข จำนวนเงิน ตรวจสอบโพย และกดยืนยันรายการ",
    description: "",
    accent: "red" as const,
  },
];

const faqs = [
  {
    q: "7LOTTO มีหวยประเภทไหนให้เลือกแทงบ้าง?",
    a: "ระบบมีหวยหลายประเภทให้เลือก เช่น หวยรัฐบาลไทย หวยออมสิน หวย ธ.ก.ส. หวยลาว หวยฮานอย และหวยหุ้น โดยแต่ละประเภทอาจมีรอบเปิดรับและเวลาปิดรับแตกต่างกัน ควรตรวจสอบข้อมูลในระบบก่อนส่งโพย",
  },
  {
    q: "เรท 2 ตัว 100 และ 3 ตัว 1,000 ใช้กับทุกโพยหรือไม่?",
    a: "อัตราจ่ายขึ้นอยู่กับประเภทหวย รูปแบบการเดิมพัน และเงื่อนไขที่กำหนดในแต่ละรอบ จึงควรตรวจสอบเรทที่แสดงในระบบก่อนยืนยันรายการทุกครั้ง เพื่อทราบอัตราจ่ายที่ใช้กับโพยนั้นอย่างชัดเจน",
  },
  {
    q: "ฝากเงินหรือถอนเงินแล้วรายการไม่เข้า ต้องทำอย่างไร?",
    a: "ให้ตรวจสอบสถานะธุรกรรมในบัญชีสมาชิกก่อน หากรายการยังไม่สำเร็จ สามารถติดต่อเจ้าหน้าที่ 7LOTTO พร้อมแจ้งรายละเอียดและเวลาที่ทำรายการ เพื่อให้ทีมงานช่วยตรวจสอบและแนะนำขั้นตอนดำเนินการต่อ",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <AnnouncementHuay
    message="7LOTTO รับแทงหวยทุกประเภท หวยรัฐบาลไทย หวยออมสิน หวย ธ.ก.ส. หวยลาว หวยฮานอย หวยหุ้น • เรทจ่าย 2 ตัว 100 3 ตัว 1,000 จ่ายเต็มจริง • ฝากถอนอัตโนมัติ ปล่อยยอดทันที ไม่ต้องรอ • ส่งโพยผ่านมือถือได้ตลอด 24 ชั่วโมง • เจ้าหน้าที่พร้อมช่วยตรวจสอบทุกรายการ"
  />

  <SmoothCarousel />

  <ContentBoxCyberCut as="h1" title="7LOTTO เว็บหวยครบทุกเรท เปิดให้แทงหวยได้ไม่อั้น ปล่อยยอดทันที ไม่ต้องรอ">
    <p class="text-left text-base leading-relaxed text-[#d8dae0]">
      <strong class="text-[#ff2a30]">7LOTTO</strong> พร้อมให้บริการลูกค้าที่ต้องการแทงหวยออนไลน์ผ่านมือถือและคอมพิวเตอร์ รวมหวยหลายประเภทไว้ให้เลือกในบัญชีเดียว พร้อมอัตราจ่าย 2 ตัว 100 และ 3 ตัว 1,000
      ตามเงื่อนไขที่กำหนด ระบบออกแบบให้เลือกเลข ส่งโพย และตรวจสอบรายการได้สะดวก พร้อมระบบฝากถอนอัตโนมัติและเจ้าหน้าที่คอยช่วยเหลือเมื่อพบปัญหาในการใช้งาน
    </p>
  </ContentBoxCyberCut>

  <ContentBoxPremium as="h2" title="7LOTTO บริการแทงหวยครบทุกรูปแบบ หวยรัฐบาลไทย หวยออมสิน หวย ธ.ก.ส. หวยลาว หวยฮานอย หวยหุ้น">
    <div>
      <p class="text-left text-base leading-relaxed text-[#d8dae0]">
        ลูกค้าสามารถเลือกแทงหวยได้หลากหลายประเภท ไม่ว่าจะเป็นหวยรัฐบาลไทย หวยออมสิน หวย ธ.ก.ส. หวยลาว หวยฮานอย และหวยหุ้น โดยสามารถตรวจสอบรอบที่เปิดรับ เลือกประเภทการเดิมพัน ใส่เลขและจำนวนเงิน
        จากนั้นตรวจสอบโพยก่อนยืนยันรายการ ระบบจัดหมวดหมู่หวยแต่ละประเภทให้ค้นหาได้ง่าย ช่วยให้ลูกค้าส่งโพยและติดตามรายการของตนเองได้ภายในบัญชีเดียว
      </p>
      <Picture
        src={imgBanner3}
        loading="lazy"
        fetchpriority="low"
        widths={[320, 640, 960]}
        sizes="(max-width: 768px) 100vw, 672px"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={72}
        alt="แบนเนอร์ 7LOTTO พื้นหลังดำลายวงจรสีแดง โลโก้ 7LOTTO เลข 7 สีแดงคู่ตัวอักษรโครเมียม ข้อความ รับแทงหวยทุกประเภท เรท 2ตัว 100 3ตัว 1,000 ได้จริง ปล่อยยอดทันที หญิงสาวผมสั้นสีเงินสวมชุดแดง สลากกินแบ่งรัฐบาล มือถือแสดงเมนู 2 ตัว 3 ตัว วิ่งบน วิ่งล่าง และแถบล่างเขียนว่า มั่นคง ปลอดภัย 100% จ่ายจริง ไม่อั้น บริการตลอด 24 ชม."
        class="mx-auto mt-6 h-auto w-full max-w-2xl rounded-2xl border border-[#a3060c]/45 shadow-[0_10px_30px_rgba(255,42,48,0.18)]"
      />
    </div>
  </ContentBoxPremium>

  <ProviderGrid />

  <ContentBox as="h2" title="7LOTTO ให้เรทจ่าย 2 ตัว 100 3 ตัว 1,000 จ่ายเต็มจริง การันตีได้">
    <div>
      <p class="text-left text-base leading-relaxed text-[#d8dae0]">
        7LOTTO กำหนดอัตราจ่ายสำหรับรายการที่เข้าเงื่อนไข โดยมีเรท 2 ตัว 100 และ 3 ตัว 1,000 ตามรายละเอียดที่แสดงในระบบ ลูกค้าควรตรวจสอบอัตราจ่าย วงเงินรับแทง
        และเงื่อนไขของหวยแต่ละประเภทก่อนยืนยันโพยทุกครั้ง หลังประกาศผลสามารถตรวจสอบรายการและยอดที่เกี่ยวข้องผ่านบัญชีสมาชิกได้โดยตรง เพื่อให้ติดตามข้อมูลได้อย่างสะดวก
      </p>
      <Picture
        src={imgBanner2}
        loading="lazy"
        fetchpriority="low"
        widths={[320, 640, 960]}
        sizes="(max-width: 768px) 100vw, 672px"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={72}
        alt="แบนเนอร์ 7LOTTO พื้นหลังดำลายวงจรสีแดง โลโก้ 7LOTTO เลข 7 สีแดงคู่ตัวอักษรโครเมียม ข้อความ เรทจ่าย 2 ตัว 100 3 ตัว 1,000 จ่ายเต็มจริง การันตีได้ หญิงสาวผมสั้นสีเงินสวมชุดสูทสีแดง มือถือแสดงตารางเลข 2 ตัว และ 3 ตัว ลูกบอลหวยเลข 7 3 9 สลากกินแบ่งรัฐบาล และกองเหรียญทอง"
        class="mx-auto mt-6 h-auto w-full max-w-2xl rounded-2xl border border-[#a3060c]/45 shadow-[0_10px_30px_rgba(255,42,48,0.18)]"
      />
    </div>
  </ContentBox>

  <LatestWinnersHuay />

  <ContentBoxSevenThree title="สมัครแทงหวย 7LOTTO บนมือถือด้วยขั้นตอนง่ายๆ">
    <Picture
      slot="left"
      src={imgSlide1}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="โปสเตอร์โปรโมชั่น 7LOTTO พื้นหลังดำลายวงจรสีแดง โลโก้ 7LOTTO เลข 7 สีแดงคู่ตัวอักษรโครเมียม ข้อความ โปรโมชั่น คืนยอดเสีย รับโบนัส 0.3% พร้อมตัวเลข 0.3% ขนาดใหญ่ หญิงสาวผมสั้นสีเงินสวมชุดหนังสีแดง ยืนข้างมือถือที่แสดงหน้าผลรางวัลหวย ลูกบอลหวยเลข 7 และ 3 กับกองเหรียญทอง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#a3060c]/45 shadow-[0_10px_30px_rgba(255,42,48,0.18)]"
    />
    <div slot="right">
      <p class="text-left text-base leading-relaxed text-[#d8dae0]">เริ่มต้นแทงหวยออนไลน์ผ่านมือถือได้ง่ายเพียง 3 ขั้นตอน</p>
      <FeatureHighlights items={registerSteps} />
      <p class="mt-6 text-left text-base leading-relaxed text-[#d8dae0]">
        ระบบรองรับการใช้งานผ่านเบราว์เซอร์บนมือถือ แท็บเล็ต และคอมพิวเตอร์ ทำให้สามารถตรวจสอบรอบหวย ส่งโพย และติดตามประวัติรายการได้จากอุปกรณ์ที่สะดวก
      </p>
    </div>
  </ContentBoxSevenThree>

  <LoginRtpSection />

  <ContentBoxSpecial as="h2" title="ติดต่อเจ้าหน้าที่ 7LOTTO ได้ทันที หากติดปัญหาการฝากหรือถอน">
    <div slot="left">
      <p class="text-left text-base leading-relaxed text-[#d8dae0]">
        หากพบปัญหาเกี่ยวกับการฝากเงิน ถอนเงิน เครดิตไม่เข้า รายการค้าง การสมัครสมาชิก หรือการส่งโพย สามารถติดต่อเจ้าหน้าที่ 7LOTTO เพื่อให้ช่วยตรวจสอบได้
        โดยควรเตรียมรายละเอียดรายการและเวลาที่ทำธุรกรรมไว้เพื่อช่วยให้เจ้าหน้าที่ตรวจสอบปัญหาได้รวดเร็วยิ่งขึ้น
      </p>
    </div>
    <div slot="right">
      <p class="text-left text-base leading-relaxed text-[#d8dae0]">
        แจ้งเลขบัญชีสมาชิก เวลาที่ทำรายการ และยอดเงิน มาพร้อมกันในข้อความเดียว เจ้าหน้าที่จะตรวจสอบสถานะรายการให้และแจ้งขั้นตอนที่ต้องทำต่อ
      </p>
      <a
        href="/line"
        class="mt-6 inline-flex items-center justify-center gap-2 rounded-full bg-gradient-to-r from-[#00B900] to-[#009900] px-7 py-3 text-sm font-black text-white shadow-[0_10px_30px_rgba(0,185,0,0.24)] transition-transform duration-300 hover:-translate-y-0.5 hover:scale-105">
        <span aria-hidden="true">💬</span> ติดต่อเจ้าหน้าที่ผ่าน LINE
      </a>
    </div>
  </ContentBoxSpecial>

  <FaqHuay title="คำถามที่พบบ่อยเกี่ยวกับ 7LOTTO" faqs={faqs} />

  <ReviewCardSumo2 />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#ff6b70] via-[#ff2a30] to-[#a3060c] px-4 py-3 text-sm font-black whitespace-nowrap text-[#2b070a] shadow-[0_10px_30px_rgba(255,42,48,0.28)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(255,42,48,0.42)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#d3d6db]/50 bg-gradient-to-r from-[#2a2a2e] to-[#0d0304] px-4 py-3 text-sm font-black whitespace-nowrap text-[#d3d6db] shadow-[0_10px_30px_rgba(211,214,219,0.16)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#ff2a30]/60 hover:text-[#ff6b70] hover:shadow-[0_15px_40px_rgba(255,42,48,0.28)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>
  </div>

  <Navfoot />
</MainLayout>
