---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import LatestWinners from "../components/LatestWinnersHuay.astro";
import ContentBoxHuay from "../components/ContentBoxHuay.astro";
import ContentBoxTwoHuay from "../components/ContentBoxTwoHuay.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxSevenThreeHuay from "../components/ContentBoxSevenThreeHuay.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBox from "../components/ContentBox.astro";
import Faq from "../components/FaqHuay.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgTwoDigit from "../assets/slide2.png";
import imgThreeDigit from "../assets/slide1.png";

// VARIANT ROTATION THIS ROUND (UP555 -> หวยคิง). Zero file reuse from the previous
// round: AnnouncementHuay replaces Announcement5, LatestWinnersHuay replaces
// LatestWinners2, FaqHuay replaces Faq4, ReviewCardSumo2 replaces ReviewCardSumo,
// and the ContentBox shape-mix moves off Neumorphism / TwoFloatingBadge /
// CyberCut / SevenThreeNeumorphism / SevenThreeCyberCut / TwoCyberCut onto
// Huay / TwoHuay / Premium / SevenThreeHuay / SevenThreePremium / TwoPremium.
// NavbarHuay and FooterHuay are the layout's pair this round (previously
// NavbarStyle7 / FooterPremium). The Huay family was picked on merit rather than
// just to rotate: this brand is an actual lottery site, not a slot/casino one.
// Plain ContentBox is the one deliberate carry-over: terms, privacy, 404 and
// every button page render their body through it by rule and cannot follow a
// rotation, so it is always-live and the orchestrator rethemes it in the shared
// step — this page only passes it props.
// Every Neumorphism / CyberCut / FloatingBadge / Style file, Faq4, Announcement5,
// LatestWinners2, ReviewCardSumo, NavbarStyle7 and FooterPremium stay on disk as
// inventory for the next brand — none of them was deleted, and the previous
// brand's copy and colour still inside them is expected drift, not a bug.
//
// <Announcement /> runs bare on purpose: AnnouncementHuay's default message is
// already this brand's copy and every sub-page calls it bare too, so passing an
// override here is exactly how the ticker ends up saying two different things on
// two pages of the same site.
//
// IMAGE ROLES FOR THIS DROP (2026-10-04). Two files are referenced from this page
// and only two, and each pairing is read off the artwork itself:
//   slide2.png — the model holds lottery ball 9, and the black gold-edged plaque
//     under the big gold อัตราการจ่าย wordmark reads "2ตัว จ่าย100บาท", so it
//     belongs to docx H3 #4. Imported as imgTwoDigit.
//   slide1.png — the same gold-on-black set, model holding ball 3, plaque reads
//     "3ตัว จ่าย1,000บาท", so it belongs to docx H3 #5. Imported as imgThreeDigit.
// Both files measure 600x600, so 600 is the top real candidate width — nothing
// above it would be a real pixel — and each picture carries max-w-[600px] so the
// art is never upscaled past its own bitmap. Each slide sits in a
// ContentBoxSevenThree* image+text block, which is that family's hard cap of two
// per rebrand, so there is no third SevenThree anywhere on the site.
// The two blocks mirror each other: SevenThreeHuay lays out md:grid-cols-[7fr_3fr]
// so its picture goes in slot="right" while the paragraph keeps the wide column,
// and SevenThreePremium lays out md:grid-cols-[3fr_7fr] so its picture goes in
// slot="left". The two pictures therefore alternate sides instead of stacking down
// the same edge, and each `sizes` describes its own 3fr column rather than the
// viewport. Both figures are copied from the arithmetic block in the component
// that owns the column — if a padding/gap/cap changes there, these move with it:
//   SevenThreeHuay:    max-w-[1400px] cap, px-4, md:p-10, gap-8, and the image
//                      column adds md:pl-6
//                      -> (1400 - 32 - 80 - 32) x 0.3 - 24 = 353px
//   SevenThreePremium: max-w-7xl/1280px cap, px-4, md:p-10, gap-10, no inner
//                      padding on the image column
//                      -> (1280 - 32 - 80 - 40) x 0.3 = 338px
// Below md both cards collapse to one column at p-8, so the drawn width is
// 100vw - 32 (section px-4) - 64 (card p-8) = 100vw - 96px, capped at 600px.
// Neither picture is the LCP element — MainLayout's hero banner is — so both are
// loading="lazy" fetchpriority="low".
//
// The alt text was written from THIS drop's artwork: both slides are 600x600
// portraits of a model in a white gold-trimmed dress against a black-and-gold set
// strewn with gold coins and numbered lottery balls, with the หวยคิง logo (a gold
// crown resting on a gold lottery ball marked 9, then three-dimensional gold Thai
// lettering) across the top, a large gold Thai อัตราการจ่าย wordmark under it, and
// that slide's own rate plaque beneath.
//
// Deliberately NOT imported, and every file still on disk:
//   banner2.png (2026-09-28) / banner3.png (2026-09-27) / slide3.png /
//   slide4.png (2026-09-29) all predate this drop and belong to previous brands —
//   importing any of them would emit a competitor's artwork into dist/, so there
//   is no inline article illustration this round.
//   banner1.png and banner1-mobile.png belong to MainLayout's own pinned globs
//   and are never referenced from a page. og.png is the same: MainLayout owns it.
//
// Vocabulary: หวยคิง is a pure lottery brand — a เว็บรับแทงหวย, not a casino. The
// words this page may use are the brief's own: แทงหวย, ส่งโพย, โพย, รอบ, รายการหวย,
// เลข 2 ตัว, เลข 3 ตัว, เลขเด็ด, เลขดัง, อัตราจ่าย, บาทละ 1,000, วงเงินรับแทง,
// ยอดสูงสุดที่ระบบเปิดรับ, เครดิต, วอลเลท, ธนาคาร, บัญชีบริษัท, ชื่อนิติบุคคล,
// สมัคร 3 ขั้นตอน, Login, ประวัติโพย, แอดมิน 24 ชั่วโมง, PIN, OTP.
// The previous brand's entire angle (คาสิโนอัปเดตล่าสุด, ทางเข้าเล่นใหม่, ระบบอัปเกรด,
// สล็อต, บาคาร่า, บอล/เดิมพันฟุตบอล, หมวดเกม, ค่ายเกม, คาสิโนสด, RTP, คืนยอดเสีย 0.3%,
// แนะนำเพื่อน 0.8%) is gone — the page was written from the brief rather than
// find-and-replaced over the old sentences. Nothing here claims a licence, a
// regulator, an operator, a bank, a lottery market name (ฮานอย/ลาวพัฒนา/หวยหุ้น), a
// draw time, a deposit minimum, a member count or a founding year, because the
// brief names none. The only figures are the brief's own: 2 ตัว, 3 ตัว, 100, 1,000,
// บาทละ 1,000, 3 ขั้นตอน, 24 ชั่วโมง. The brief's own hedging ships with the copy
// (ส่วนข้อความ "สูงที่สุดในวงการ" ควรมีข้อมูลเปรียบเทียบที่ตรวจสอบได้รองรับ · คำว่า
// "จ่ายไม่อั้น" ควรยึดวงเงินจริงที่เว็บไซต์แสดง · ควรแสดงชื่อนิติบุคคลและรายละเอียด
// บัญชีที่ตรวจสอบได้) — it is part of the paragraphs, not trimmed as downbeat.
//
// Title and description are the brief's own Title/Description lines, used
// verbatim and NOT padded up to 150: verify-build deliberately skips its
// 150-character floor on the home page for exactly this reason.
const pageTitle = "หวยคิง รับแทงหวย อัตราจ่ายบาทละ1,000 รับเลขเด็ด เลขดัง แทงไม่อั้น";

const pageDescription = "หวยคิง รับแทงหวย เว็บแม่ให้อัตราจ่ายบาทละ1,000 สูงที่สุดในวงการ รับแทงเลขเด็ด เลขดัง จ่ายไม่อั้น ฝากถอนวอลเลทและธนาคารชั้นนำ เข้าบริษัทโดยตรง";

// The brief has a real H2 -> H3 nesting this round, so the page is NOT flattened
// to H2-only. The two H3s are genuine headings — the two rate sub-points, both
// nested under the อัตราการจ่าย H2 — and they stay H3.
//
// The checklist, in document order, and what carries each one:
//    1 H1  หวยคิง รับแทงหวย เว็บแม่ให้อัตราจ่ายบาทละ1,000 สูงที่สุดในวงการ
//          ContentBoxHuay, brief paragraphs on lines 4 + 5
//    2 H2  เว็บ หวยคิง รับแทงเลขเด็ด เลขดัง จ่ายไม่อั้น ยอดเข้าบริษัทโดยตรง
//          ContentBoxTwoHuay, line 7 left / line 8 right
//    3 H2  อัตราการจ่าย หวยคิง 2ตัว จ่าย100บาท 3ตัว จ่าย1,000บาท
//          ContentBoxPremium, lines 10 + 11
//    4 H3  2ตัว จ่าย100บาท
//          ContentBoxSevenThreeHuay + slide2 (imgTwoDigit), line 13
//    5 H3  3ตัว จ่าย1,000บาท
//          ContentBoxSevenThreePremium + slide1 (imgThreeDigit), line 15
//    6 H2  สมัครแทง หวยคิง ง่ายๆ 3ขั้นตอน
//          ContentBoxTwoPremium, line 17 left / line 18 right
//    7 H2  ติดต่อแอดมินเว็บแทง หวยคิง ได้ ตลอด 24 ชั่วโมง
//          ContentBox + LINE / สมัครสมาชิก buttons, lines 20 + 21
//    8 H2  คำถามที่พบบ่อยเกี่ยวกับ หวยคิง
//          FaqHuay + faqs prop, lines 23-28
// Final inventory for this page: h1 x1, h2 x5, h3 x2.
//
// ContentBoxSevenThreePremium takes the docx heading through `title`, which it
// renders in its wide (7fr) text column; its image column is passed no
// `titleleft`, so the block emits exactly one heading. ContentBoxSevenThreeHuay
// is the mirror and takes the same heading through `titleleft`, its wide column.
//
// Every brief paragraph ships in full — all eleven of them, nothing merged or
// summarised. Sections 1, 3 and 7 have two paragraphs each and stack inside one
// wrapper div so the slot still receives exactly one element; sections 2 and 6
// have two each and run one per column. The column labels passed to the two
// two-column boxes are this page's own layout wording, not brief headings, and
// both variants render them as <p>.
//
// Everything else on the page is chrome and emits no heading tag at any level:
// AnnouncementHuay, LatestWinnersHuay, LoginRtpSection and ReviewCardSumo2 render
// their titles as <p>/<span> with an aria-label on the section, and FaqHuay's
// questions live inside <summary> as <p>. The non-brief widgets sit before
// section 1 (the ticker, then the winners feed) and after section 8
// (LoginRtpSection, ReviewCardSumo2, Navfoot) — never spliced between two content
// sections.

// One array, used by both <Faq> and the FAQPage node — never the component's own
// defaults, which belong to whichever brand shipped last. The three pairs are the
// brief's own Q/A block, verbatim.
const faqs = [
  {
    q: "หวยคิง รับแทงเลขเด็ดและเลขดังทุกตัวหรือไม่?",
    a: "สามารถเลือกเลขตามรายการที่ระบบเปิดรับ แต่เลขบางชุดอาจมีวงเงินแตกต่างกัน โดยเฉพาะเลขที่มียอดเดิมพันสูง ควรกรอกเลขและตรวจสอบยอดสูงสุดที่ระบบรับได้ก่อนส่งโพยทุกครั้ง",
  },
  {
    q: "หวยคิง 2 ตัวจ่าย 100 และ 3 ตัวจ่าย 1,000 จริงหรือไม่?",
    a: "หากรายการนั้นเข้าเงื่อนไข ระบบสามารถกำหนดอัตรา 2 ตัว 100 บาท และ 3 ตัว 1,000 บาท ได้ แต่อัตราจริงอาจขึ้นอยู่กับประเภทหวยและรูปแบบการเดิมพัน จึงควรตรวจสอบราคาบนหน้าส่งโพยก่อนยืนยัน",
  },
  {
    q: "หวยคิง ฝากเงินเข้าบัญชีบริษัทโดยตรงหรือไม่?",
    a: "หากเว็บไซต์ระบุว่าใช้บัญชีบริษัทโดยตรง ควรมีชื่อบัญชีและข้อมูลนิติบุคคลให้ตรวจสอบ สมาชิกควรเปรียบเทียบชื่อผู้รับกับข้อมูลที่เว็บไซต์ประกาศก่อนโอน และไม่ควรใช้ข้อความประชาสัมพันธ์เพียงอย่างเดียวเป็นหลักฐานว่าบัญชีนั้นเป็นบัญชีบริษัท",
  },
];

// Every <strong> below wraps a whole space-delimited chunk of the brief's own
// sentence. Thai has no inter-word space, so a highlight that starts or ends
// mid-word lets the formatter break the line inside the tag and render a space
// that splits the word — the copy must read identically with the tags removed.
// One highlight colour only: #fdeb7c, the brand's bright gold, against the
// inherited body colour #f5e7c8 (BRAND_TEXT). The paragraphs below carry no
// colour class of their own: every ContentBox* card in this mix already sets
// `text-left text-base leading-relaxed text-[#f5e7c8]` on the element holding
// the slot, so the prose inherits it and no page-level override can drift from
// the card.

// No breadcrumb: this is the homepage, so a trail from the root to itself would
// be a single self-referential crumb. Every URL in the graph is derived by
// pageGraph from `site:` — no domain is typed out in this file, and no Review /
// AggregateRating / sameAs / address node is passed.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <LatestWinners />

  <ContentBoxHuay as="h1" title="หวยคิง รับแทงหวย เว็บแม่ให้อัตราจ่ายบาทละ1,000 สูงที่สุดในวงการ">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#fdeb7c]">หวยคิง เว็บรับแทงหวยออนไลน์ที่เปิดให้สมาชิกเลือกเลขและส่งโพยผ่านระบบบนมือถือ</strong>
        มีทั้งเลข 2 ตัว เลข 3 ตัว รวมถึงรายการหวยตามรอบที่เว็บไซต์เปิดให้บริการ จุดเด่นคืออัตราจ่ายสำหรับรายการที่เข้าเงื่อนไข
        <strong class="text-[#fdeb7c]">โดยเลข 3 ตัวกำหนดไว้สูงสุดตามโปรโมชันที่บาทละ 1,000</strong>
        สมาชิกสามารถตรวจสอบเลข ยอดแทง อัตราจ่าย และสถานะโพยได้ก่อนยืนยัน พร้อมรองรับช่องทางจัดการเครดิตผ่านวอลเลทและธนาคารที่ระบบกำหนด
      </p>
      <p>
        ส่วนข้อความ “สูงที่สุดในวงการ”
        <strong class="text-[#fdeb7c]">ควรมีข้อมูลเปรียบเทียบที่ตรวจสอบได้รองรับ</strong>
        หากไม่มีหลักฐานดังกล่าว แนะนำใช้คำว่า “อัตราจ่ายสูง” จะเหมาะกับเนื้อหาเว็บไซต์มากกว่า
      </p>
    </div>
  </ContentBoxHuay>

  <ContentBoxTwoHuay
    as="h2"
    title="เว็บ หวยคิง รับแทงเลขเด็ด เลขดัง จ่ายไม่อั้น ยอดเข้าบริษัทโดยตรง"
    titleleft="เลขที่เปิดรับและการตรวจสอบโพย"
    titleright="วงเงินรับแทงและบัญชีปลายทาง">
    <p slot="left">
      <strong class="text-[#fdeb7c]">เว็บ หวยคิง เปิดรับตัวเลขตามรายการและรอบหวยที่ระบบกำหนด</strong>
      ไม่ว่าจะเป็นเลขที่เลือกเอง เลขเด็ด หรือเลขดังที่กำลังได้รับความสนใจ สมาชิกสามารถกรอกเลขและยอดที่ต้องการก่อนตรวจสอบสถานะการรับแทงจากระบบ
      <strong class="text-[#fdeb7c]">ช่วยให้ทราบวงเงินและรายละเอียดของโพยก่อนกดยืนยันรายการทุกครั้ง</strong>
    </p>
    <p slot="right">
      <strong class="text-[#fdeb7c]">สำหรับเลขที่มีผู้เลือกจำนวนมาก ระบบอาจกำหนดวงเงินรับแทงตามแต่ละรอบ</strong>
      ดังนั้นคำว่า “จ่ายไม่อั้น” ควรยึดวงเงินจริงที่เว็บไซต์แสดง ส่วนกรณีระบุว่ายอดฝากเข้าบริษัทโดยตรง ควรแสดงชื่อนิติบุคคลและรายละเอียดบัญชีที่ตรวจสอบได้
      <strong class="text-[#fdeb7c]">สมาชิกควรเช็กชื่อบัญชีปลายทางให้ตรงกับข้อมูลที่ประกาศก่อนทำธุรกรรม</strong>
    </p>
  </ContentBoxTwoHuay>

  <ContentBoxPremium as="h2" title="อัตราการจ่าย หวยคิง 2ตัว จ่าย100บาท 3ตัว จ่าย1,000บาท">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#fdeb7c]">อัตราการจ่าย หวยคิง สำหรับรายการที่เข้าเงื่อนไขแบ่งเป็น 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท</strong>
        สมาชิกสามารถตรวจสอบราคาของรายการที่ต้องการก่อนส่งโพย เพื่อให้ทราบว่าเลขและประเภทหวยที่เลือกใช้อัตราใด
        <strong class="text-[#fdeb7c]">รวมถึงตรวจสอบยอดสูงสุดที่ระบบเปิดรับในรอบนั้นก่อนยืนยัน</strong>
      </p>
      <p>
        <strong class="text-[#fdeb7c]">อัตราจ่ายอาจแตกต่างตามประเภทหวย รูปแบบการแทง หรือเงื่อนไขของแต่ละรอบ</strong>
        หากข้อมูลบนหน้าส่งโพยแตกต่างจากข้อความประชาสัมพันธ์
        <strong class="text-[#fdeb7c]">ควรยึดอัตราล่าสุดที่ระบบแสดงก่อนยืนยันรายการ</strong>
      </p>
    </div>
  </ContentBoxPremium>

  <ContentBoxSevenThreeHuay as="h3" titleleft="2ตัว จ่าย100บาท">
    <p slot="left">
      <strong class="text-[#fdeb7c]">รายการที่เข้าเงื่อนไข 2 ตัว จ่าย 100 บาท สามารถเลือกเลขและกำหนดยอดแทงตามวงเงินที่ระบบเปิดรับ</strong>
      ก่อนส่งโพยควรตรวจสอบเลขให้ครบทั้งสองหลัก รวมถึงดูประเภทการเดิมพัน อัตราจ่าย และยอดรวมให้เรียบร้อย
      <strong class="text-[#fdeb7c]">เพราะแต่ละรายการหวยอาจมีรายละเอียดในการคำนวณแตกต่างกัน</strong>
    </p>
    <Picture
      slot="right"
      src={imgTwoDigit}
      loading="lazy"
      fetchpriority="low"
      widths={[353, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), (max-width: 1399px) calc(30vw - 67px), 353px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
