---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ContentBoxHuay from "../components/ContentBoxHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็น "แนวทางและวิธีจัดโพย" ไม่ใช่การทำนายผล — เว็บไม่ประกาศผลรางวัลเองและไม่รับประกัน
// เลขใด ทุกการ์ดจึงพูดถึงสิ่งที่ตรวจสอบได้จริงก่อนกดยืนยัน (อัตราจ่าย วงเงิน เวลาปิดรับ
// ประเภทหวยที่เลือก) ไม่ใช่ "เลขเด่นงวดนี้"
//
// ข้อเท็จจริงทั้งหมดยึดตาม src/assets/content.txt เท่านั้น: เว็บตรงไม่ผ่านเอเย่นต์ ·
// เปิดรับหวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยหุ้น · อัตราจ่ายเลข 2 ตัวบน/ล่าง บาทละ 100
// และเลข 3 ตัวตรง บาทละ 1,000 · จ่ายเต็มทุกบิล ไม่หักเปอร์เซ็นต์ แม้เป็นเลขเด็ด เลขดัง
// หรือเลขอั้น · ระบบกระเป๋าเดียว Single Wallet ฝากครั้งเดียวเล่นได้ทั้งสล็อตและหวย ·
// ฝาก-ถอนออโต้ 24 ชม. ไม่มีขั้นต่ำ ทุน 1 บาทก็ฝากได้ ใช้เวลา 3-5 วินาที · ทุกธนาคาร
// ชั้นนำและ TrueMoney Wallet · ถอนเต็มจำนวน 100% ไม่มีอั้นยอดถอนต่อวัน · Line Official
// 24 ชม. ห้ามเพิ่มผลรางวัล วันที่ สถิติ เลขเด็ด หรือประเภทหวยที่บรีฟไม่ได้ระบุ
// (ออมสิน ฮานอย VIP ชื่อตลาดหุ้นรายตัว)
//
// การ์ดเหล่านี้เป็น chrome ไม่ใช่หัวข้อบทความ ชื่อการ์ดจึงเรนเดอร์เป็น span ไม่ใช่แท็กหัวข้อ
// และ label ของ grid ย้ายไปอยู่บน aria-label ของ section แทน
//
// ตระกูล Huay (ธีมแดง) เป็นข้อยกเว้นที่ playbook อนุญาตไว้ใน Phase 4.5 สำหรับหน้าหวย
// จึงไม่ถูกบังคับให้ใช้พาเลตต์ทองของแบรนด์หลัก — ยกเว้นเฉพาะธีม ชื่อแบรนด์ไม่ยกเว้น
const tips = [
  {
    title: "จัดโพยหวยรัฐบาลไทยแบบไม่ต้องรีบ",
    desc: "รอบรัฐบาลไทยเปิดรับแทงล่วงหน้าและปิดรับช้า จึงมีเวลาคัดเลขให้ครบ แล้วค่อยตรวจอัตราจ่ายกับเวลาปิดรับที่ระบบแสดงก่อนกดยืนยัน",
    type: "หวยรัฐบาลไทย",
    note: "ทุกวันที่ 1 และ 16",
  },
  {
    title: "วางเลขหวยลาวก่อนถึงรอบปิดรับ",
    desc: "แบ่งยอดออกเป็นหน่วยย่อยไว้ล่วงหน้าแทนการเทไปที่เลขเดียว แล้วเทียบยอดรวมในโพยกับงบที่ตั้งไว้ก่อนส่งรายการ",
    type: "หวยลาว",
    note: "ตามรอบที่เปิดรับ",
  },
  {
    title: "เลือกรอบหวยฮานอยให้ชัดก่อนคัดเลข",
    desc: "เปิดหน้าส่งโพยดูก่อนว่ารอบไหนกำลังเปิดรับอยู่ แล้วตรวจว่าโพยถูกส่งเข้ารอบที่ตั้งใจจริง ไม่ใช่รอบถัดไปที่ระบบเปิดค้างไว้",
    type: "หวยฮานอย",
    note: "ตามรอบที่เปิดรับ",
  },
  {
    title: "ดูหวยหุ้นให้เข้าใจก่อนยืนยันโพย",
    desc: "หวยหุ้นอิงผลจากตลาดหุ้นที่คนละตลาดเปิด-ปิดคนละเวลากัน ให้ยึดรอบและเวลาปิดรับที่ระบบแสดงของตลาดนั้นเป็นหลัก",
    type: "หวยหุ้น",
    note: "อิงเวลาของแต่ละตลาด",
  },
  {
    title: "คำนวณยอดตามเรทก่อนกดส่งโพย",
    desc: "คูณยอดแทงกับอัตราจ่ายที่ระบบแสดงของประเภทที่เลือก เพื่อให้เห็นยอดที่จะได้รับจริงก่อนยืนยัน ไม่ใช่คำนวณจากเรทที่จำมาจากรอบก่อน",
    type: "อัตราจ่าย",
    note: "จ่ายเต็มทุกบิล",
  },
  {
    title: "ตรวจโพยผ่านมือถือหลังผลประกาศ",
    desc: "ขั้นตอนเปิดดูบิลย้อนหลังได้เองจากบัญชีสมาชิก ดูสถานะรางวัลและยอดตามเรทที่ปล่อยเข้าบัญชีให้ถอนได้",
    type: "ตรวจโพย",
    note: "ทุกรอบ",
  },
];

// Passed explicitly rather than letting AnnouncementHuay's default render: a
// ticker default is the classic place a previous brand's slogan survives a
// rebrand unnoticed. No emoji in the string — the marquee prints it twice and a
// text prop cannot carry its own aria-hidden span.
const announcement =
  "ENTER55 เว็บตรงไม่ผ่านเอเย่นต์ เปิดรับแทงหวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยหุ้น ครบทุกแนวในทางเข้าเดียว เลือกประเภทหวย คัดเลข แล้วตรวจอัตราจ่าย วงเงิน และเวลาปิดรับที่ระบบแสดงให้ครบก่อนกดยืนยันโพยทุกครั้ง ถูกรางวัลจ่ายเต็มตามเรทในบิล เลข 2 ตัวบน/ล่าง บาทละ 100 เลข 3 ตัวตรง บาทละ 1,000 ไม่หักเปอร์เซ็นต์ แม้เป็นเลขเด็ด เลขดัง หรือเลขอั้น ระบบกระเป๋าเดียว Single Wallet ฝากครั้งเดียวเล่นได้ทั้งสล็อตและหวย ฝาก-ถอนออโต้ไม่มีขั้นต่ำ ทุน 1 บาทก็เริ่มได้ แอดมิน ENTER55 ดูแลผ่าน Line Official ตลอด 24 ชั่วโมง";

// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 158.
const pageDescription = "แนวทางหวย ENTER55 วิธีคัดเลขและจัดโพยให้พอดีกับงบ พร้อมจุดที่ต้องตรวจอัตราจ่าย วงเงิน และเวลาปิดรับที่ระบบแสดงก่อนกดยืนยันโพย จ่ายเต็มทุกบิล ไม่หักเปอร์เซ็นต์";

const graph = pageGraph(Astro, {
  name: "แนวทางหวย ENTER55 วิธีคัดเลขและจัดโพยก่อนรอบปิดรับ",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "แนวทาง", path: "/แนวทาง" },
  ],
});
---

<MainLayout title="แนวทางหวย ENTER55 วิธีคัดเลขและจัดโพยก่อนรอบปิดรับ" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <section class="mx-auto my-8 w-full max-w-7xl px-4">
    <div class="mb-10 flex flex-col items-center">
      <span aria-hidden="true" class="mb-2 text-4xl drop-shadow-[0_0_10px_rgba(226,53,58,0.8)]">🔮</span>
      <h1 class="bg-gradient-to-r from-[#ffe9ea] via-[#ff8a8d] to-[#c21e22] bg-clip-text text-center text-4xl font-black tracking-widest text-transparent uppercase">แนวทางหวย ENTER55</h1>
      <p class="mt-3 w-full text-left text-base leading-relaxed text-[#ded9da]">
        หน้านี้รวบรวมแนวทางการคัดเลขและจัดโพยของ <strong class="text-[#ff9a9d]">ENTER55</strong> ให้สมาชิกวางแผนได้ก่อนรอบปิดรับ ครอบคลุมหวยทุกประเภทที่เว็บเปิดรับ ทั้งหวยรัฐบาลไทยที่ออกรางวัลทุกวันที่ 1 และ 16 ของเดือน
        หวยลาว หวยฮานอย และหวยหุ้น โดยเวลาเปิด-ปิดรับ อัตราจ่าย และวงเงินของแต่ละประเภทแสดงอยู่บนหน้าส่งโพยของรอบนั้น จึงให้ยึดตัวเลขที่ระบบแสดงจริงเป็นหลักก่อนกดยืนยันทุกครั้ง
        เว็บไซต์ไม่ประกาศผลรางวัลเองและไม่ทำนายเลขใด ๆ
      </p>
    </div>

    <h2 class="mb-6 text-center text-2xl leading-normal font-black tracking-widest text-[#ff8a8d] uppercase">แนวทางแทงหวยแต่ละประเภทก่อนถึงรอบปิดรับ</h2>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3" aria-label="แนวทางหวยแยกตามประเภท">
      {
        tips.map((tip) => (
          <div class="group relative isolate flex flex-col overflow-hidden rounded-2xl border border-[#c21e22]/40 bg-[#3a0709]/90 p-6 shadow-lg backdrop-blur-sm transition-all duration-300 hover:-translate-y-2 hover:border-[#e2353a]/60 hover:shadow-[0_15px_30px_rgba(226,53,58,0.25)]">
            <div class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#7d1114]/60 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

            <div class="mb-4 flex items-center justify-between gap-3">
              <span class="rounded-full border border-[#c21e22]/55 bg-[#140a0c] px-3 py-1 text-xs font-bold text-[#ff8a8d]">{tip.type}</span>
              <span class="text-right text-xs font-medium text-[#bdb4b6]">{tip.note}</span>
            </div>

            <span class="mb-2 block text-xl font-bold text-[#ded9da] transition-colors group-hover:text-[#ff9a9d]">{tip.title}</span>

            <p class="mb-6 text-left text-base leading-relaxed text-[#bdb4b6]">{tip.desc}</p>

            <div class="mt-auto flex items-center gap-2 border-t border-[#c21e22]/30 pt-4 text-sm font-bold text-[#ff8a8d]">
              <span aria-hidden="true">💰</span>
              เลข 2 ตัว บาทละ 100 เลข 3 ตัวตรง บาทละ 1,000
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <ContentBoxHuay title="คัดเลขและคุมยอดให้ใช้งานได้จริงก่อนส่งโพย" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ded9da]">
        แนวทางที่ใช้ได้จริงคือแนวทางที่ตรวจสอบได้ก่อนกดยืนยัน ไม่ใช่การเดาผลล่วงหน้า สิ่งที่ควรเปิดดูให้ครบทุกครั้งคือ
        <strong class="text-[#ff9a9d]">ประเภทหวยและรอบที่เลือก อัตราจ่ายของประเภทนั้น วงเงินที่ระบบแสดง และเวลาปิดรับ</strong>
        เพราะสี่อย่างนี้เป็นตัวกำหนดว่ารายการจะคิดผลอย่างไรและยอดรวมในโพยจะออกมาเท่าไร ส่วนเลขที่คิดไว้ล่วงหน้าเป็นเพียงจุดตั้งต้น
        <strong class="text-[#ff9a9d]">ไม่มีเลขหรือสูตรใดรับประกันผลได้เสียล่วงหน้า</strong> การเดิมพันจึงมีความเสี่ยง ควรกำหนดงบประมาณให้เหมาะสมทุกครั้ง
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#ded9da]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ff8a8d]">🎯</span>
          <span><strong class="text-[#ff9a9d]">คัดเลขก่อน แล้วค่อยเลือกประเภท</strong> เลือกเลขที่มีในใจให้ครบก่อน จากนั้นเปิดหน้าส่งโพยดูว่ารอบนี้เปิดรับประเภทใด และเรทของประเภทที่เลือกแสดงไว้เท่าไร</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ff8a8d]">🎱</span>
          <span><strong class="text-[#ff9a9d]">กระจายยอด อย่ากระจุกตัวเดียว</strong> แบ่งยอดออกเป็นหน่วยย่อยไว้ล่วงหน้า แล้ววางต่อเลขให้อยู่ในระดับที่รับความผันผวนของรอบนั้นได้</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ff8a8d]">⏱️</span>
          <span><strong class="text-[#ff9a9d]">เผื่อเวลาก่อนรอบปิดรับ</strong> หวยแต่ละประเภทปิดรับคนละเวลา การส่งโพยชิดเวลาปิดทำให้ไม่เหลือจังหวะแก้ไขเมื่อกรอกผิด</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ff8a8d]">🧾</span>
          <span>
            <strong class="text-[#ff9a9d]">เก็บบิลไว้ทุกครั้ง</strong> เมื่อส่งโพยสำเร็จ ระบบบันทึกรอบ เลข ยอดแทง และอัตราจ่ายที่แสดงตอนยืนยันไว้ให้ เช็กประวัติรายการย้อนหลังได้เองจากบัญชีสมาชิก
          </span>
        </li>
      </ul>
    </div>
  </ContentBoxHuay>

  <ContentBoxHuay title="ENTER55 จ่ายเต็มทุกบิล ตามเรทที่ระบุไว้ในบิล ไม่หักเปอร์เซ็นต์" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ded9da]">
        สายหวยที่มีเลขในใจเข้ามาส่งโพยกับ ENTER55 ได้เลย ไม่ว่าจะเป็นเลขเด็ด เลขดัง หรือเลขอั้นที่บางรอบมีผู้เลือกเดิมพันจำนวนมาก เพราะนโยบายของเว็บคือ <strong class="text-[#ff9a9d]">จ่ายเต็มทุกบิล ไม่หักเปอร์เซ็นต์</strong>
        สมาชิกเลือกประเภทหวย เลือกเลข ส่งโพย และเช็กประวัติรายการได้ด้วยตัวเอง ระบบจะแสดงวงเงินและรายละเอียดของรายการก่อนยืนยัน ทำให้เห็นเลขและยอดเดิมพันอย่างชัดเจน เมื่อทำรายการสำเร็จก่อนระบบปิดรับโพยและถูกรางวัล
        จะได้รับเงินเต็มจำนวนตามเรทที่ระบุไว้ในบิล โดยไม่มีการหักเปอร์เซ็นต์ย้อนหลัง และบิลจะถูกเก็บไว้ในประวัติให้เทียบย้อนหลังได้เสมอ
      </p>

      <p class="text-left text-base leading-relaxed text-[#ded9da]">
        อัตราจ่ายที่กำหนดไว้คือ <strong class="text-[#ff9a9d]">เลข 2 ตัวบน/ล่าง บาทละ 100 และเลข 3 ตัวตรง บาทละ 1,000</strong> ใช้คำนวณยอดเบื้องต้นก่อนลงเลขได้ แต่ก่อนตัดสินใจให้เปิดดู
        <strong class="text-[#ff9a9d]">ตัวเลขที่ระบบแสดงจริงบนหน้าส่งโพย</strong> ของรอบนั้นก่อน แล้วคำนวณยอดตามเรทจากตัวเลขที่เห็นจริง ไม่ใช่จากเรทที่จำมาจากรอบก่อน เพราะเวลาเปิด-ปิดรับ วงเงินที่รับได้
        และรายละเอียดของแต่ละประเภทหวยต่างกันไปตามรอบ อัตราที่ใช้ตอนกดยืนยันจะถูกบันทึกไว้ในบิล จึงเปิดดูย้อนหลังได้เสมอว่ารายการนั้นคิดจากเรทเท่าไร
      </p>

      <p class="text-left text-base leading-relaxed text-[#ded9da]">
        เครดิตที่ใช้ส่งโพยอยู่ใน <strong class="text-[#ff9a9d]">ระบบกระเป๋าเดียว (Single Wallet)</strong> ฝากเพียงครั้งเดียวก็สลับไปแทงหวยหรือกลับไปเล่นเกมสล็อตได้ทันที ไม่ต้องกดย้ายเงินระหว่างค่ายเกม
        ระบบฝาก-ถอนเป็นออโต้ตลอด 24 ชั่วโมง ไม่มีขั้นต่ำ ทุน 1 บาทก็ฝากเข้ามาเดิมพันได้ ใช้เวลาเพียง 3-5 วินาที รองรับทุกธนาคารชั้นนำและ TrueMoney Wallet และเมื่อถูกรางวัลก็
        <strong class="text-[#ff9a9d]">ถอนได้เต็มจำนวน 100% ไม่มีอั้นยอดถอนต่อวัน</strong> แม้ยอดจะรวมกันถึงหลักล้าน
      </p>

      <p class="text-left text-base leading-relaxed text-[#ded9da]">
