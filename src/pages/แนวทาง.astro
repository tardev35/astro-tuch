---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBox3ThreeNeumorphism from "../components/ContentBox3ThreeNeumorphism.astro";
import Faq from "../components/FaqHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้คือ "แนวทางการตรวจสอบข้อมูลก่อนตัดสินใจ" ไม่ใช่การชี้นำผลรางวัล
// ⚠️ ห้ามเขียนเลขเด็ด เลขแนะนำ สถิติย้อนหลัง สูตรคำนวณ หรือการทำนายผลใด ๆ —
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีสิ่งเหล่านั้นเลยสักบรรทัด และเป็น
// คำกล่าวอ้างที่หน้านี้ไม่มีหลักฐานรองรับ รอบก่อนของไฟล์นี้เป็นแบรนด์หวยอีกเจ้าที่
// บรีฟของมันพูดเรื่องแนวทางตัวเลข/สถิติย้อนหลังเอง — รอบนี้ไม่ใช่ ห้ามสืบทอด
//
// ⚠️ ประโยคกำกับความเสี่ยงของบรีฟต้องขึ้นครบ ห้ามตัดเพราะฟังดูลบ (content.txt
// บรรทัด 6): "สำหรับคำกล่าวอ้างเรื่องการจ่ายเงินจริงหรือไม่มีประวัติร้องเรียน
// ควรพิจารณาหลักฐานการให้บริการและความคิดเห็นจากหลายแหล่งประกอบกัน" — รอบนี้มัน
// ถือหัวข้อ H2 ของตัวเองทั้งก้อน เฮดจ์คู่กันขนมาด้วย: ควรตรวจสอบวันเวลาเปิดรับ
// อัตราจ่าย และแหล่งอ้างอิงผลรางวัลให้ชัดเจนก่อนทำรายการ (บรรทัด 6) · ก่อนรับสิทธิ์
// ควรอ่านประกาศล่าสุดและตรวจสอบว่าโปรโมชั่นใช้ร่วมกันได้หรือไม่ (บรรทัด 8) ·
// การคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกบิลหรือรับประกันผลตอบแทนใน
// อนาคต (บรรทัด 10) · ข้อมูลบริษัทแม่และประวัติการจ่ายเงินควรตรวจสอบจากหลักฐานที่
// เชื่อถือได้ก่อนตัดสินใจ (บรรทัด 4)
//
// ข้อเท็จจริงอื่นยึดตามบรีฟรอบนี้เท่านั้น: ประเภทหวยสี่ชื่อ — หวยรัฐบาลไทยที่
// อ้างอิงผลสลากกินแบ่งรัฐบาล หวยฮานอยและหวยลาวที่มีรอบประกาศผลตามประเภท และ
// หวยหุ้นต่างประเทศที่อ้างอิงตัวเลขจากตลาดที่กำหนด (บรรทัด 4, 6) · คืนยอดเสีย
// 0.3% และแนะนำเพื่อน 0.8% มีเงื่อนไขเรื่องประเภทหวย ยอดที่นำมาคำนวณ รอบเวลารับ
// เครดิต และบัญชีที่เข้าร่วม (บรรทัด 8, 10, 12) · ฝากถอนผ่านธนาคารและวอลเลท ต้อง
// ดูยอดขั้นต่ำ ระยะเวลาดำเนินการ และชื่อบัญชีปลายทาง (บรรทัด 14) · บัญชีแอบอ้าง ·
// รหัสผ่าน · รหัส OTP · แอดมิน 24ชม. (บรรทัด 16)
//
// ⚠️ ห้ามเติมประเภทหวยอื่น (ออมสิน ธ.ก.ส. ยี่กี ลาวพัฒนา) ห้ามเติมใบอนุญาต ·
// หน่วยงานกำกับ · ชื่อธนาคาร · ชื่อค่ายเกม · นิติบุคคล · เวลาเป็นตัวเลข ·
// อัตราจ่ายเป็นตัวเลข · ยอดขั้นต่ำเป็นตัวเลข — ตัวเลขที่ขึ้นหน้าได้มีแค่ 0.3% /
// 0.8% / 24ชม. / 100% และห้ามใช้คำของแบรนด์เก่า (โพย · ไม่อั้นจ่าย · ไม่มีลบโพย ·
// เลขเด็ด · เลขดัง · มงกุฎ · หวยคิง · หวย365 · สล็อต · ไฮโล · ยิงปลา · บอล ·
// บาคาร่า · เว็บตรง · ไม่ผ่านเอเย่นต์ · ระบบดูแลการเงิน · ปลอดภัยไม่ผ่านม้า)
//
// CHROME: AnnouncementHuay · FaqHuay = ชุดเดียวกับทั้งเว็บรอบนี้ (เรียก
// <Announcement /> แบบ bare ให้ตกไปใช้ default message ของแบรนด์ปัจจุบัน ห้ามส่ง
// message prop · FaqHuay มี default faqs = [] จึงต้องส่ง prop faqs ทุกครั้ง)
//
// ธีม: ⚠️ ข้อยกเว้น "หน้าหวยคงธีม Huay แดง-ทอง" **ไม่ใช้รอบนี้** — รอบนี้ทั้งเว็บ
// เป็นเว็บหวยและใช้ชุด *Huay ทั้งหมดอยู่แล้ว หน้านี้จึงใช้พาเลตเขียวมรกตของ
// brand-spec §2 เหมือนทุกหน้า (ธีมสว่าง: พื้นเพจ #d8ffc7 จาก bg.json)
//   ผิวการ์ด #ffffff · อินเซ็ต #e9fbdd · เนื้อความ #0c3a16 (12.9:1)
//   หัวข้อ/ไฮไลต์ #0a5f1c (7.9:1) · ขอบ/ออรา/พื้นถมปุ่ม #0b7d28 (ขาวบนพื้นนี้ 5.3:1)
// ⚠️ ทองสัมฤทธิ์ #c9cb63 #aeb04a #9ba03c เป็นสีของโครมเท่านั้น (บนการ์ดขาวได้แค่
// 1.7–2.8:1) หน้านี้จึงไม่มีทองเลย และไม่มีเขียวใบตอง #0f9b35 ถือตัวอักษรหรือเป็น
// พื้นของตัวอักษร
//
// ย่อหน้าในกล่องไม่ถือคลาสสีของตัวเอง — ContentBox / ContentBoxNeumorphism ตั้ง
// `text-left text-base leading-relaxed text-[#0c3a16]` ไว้บนการ์ดแล้ว สีที่เขียนเอง
// มีแค่ไฮไลต์บน <strong> (= #0a5f1c สีเดียวทั้งเว็บ)
//
// การ์ดเหล่านี้เป็น chrome ไม่ใช่หัวข้อบทความ ชื่อการ์ดจึงเป็น <span> ไม่ใช่แท็ก
// หัวข้อ และชื่อของชุดการ์ดไปอยู่บน aria-label ของ <ul> ป้ายสามคอลัมน์ของ
// ContentBox3ThreeNeumorphism เป็นคำบรรยายที่หน้านี้ตั้งเอง ไม่ใช่หัวข้อย่อยของบรีฟ
// จึงส่ง heading={false} ให้ render เป็น <p>
const checks = [
  {
    title: "เลือกประเภทหวยให้ตรงกับรายการที่ต้องการ",
    desc: "ระบบรวมประเภทหวยไว้ในเว็บไซต์เดียว ทั้งหวยรัฐบาลไทย หวยฮานอย หวยลาว และหวยหุ้นต่างประเทศ ให้เลือกประเภทให้ชัดก่อน เพราะเงื่อนไขของแต่ละประเภทไม่เหมือนกัน",
    type: "ประเภทหวย",
    note: "ไทย · ฮานอย · ลาว · หุ้น",
  },
  {
    title: "อ่านรอบปิดรับและรอบประกาศผลของรายการนั้น",
    desc: "แต่ละรายการมีรอบปิดรับและรอบประกาศผลของตัวเอง ให้อ่านวันเวลาที่ระบบแสดงบนรายการนั้นก่อนทำรายการ เพราะรายการที่ปิดรับแล้วจะทำรายการเพิ่มไม่ได้",
    type: "รอบปิดรับ",
    note: "ตามที่ระบบแสดง",
  },
  {
    title: "ตรวจอัตราจ่ายและเงื่อนไขก่อนยืนยันรายการ",
    desc: "อัตราจ่ายและเงื่อนไขอาจต่างกันตามประเภทหวยและรูปแบบของรายการ ให้ยึดค่าที่ระบบแสดงบนหน้ารายการก่อนยืนยัน ไม่ใช่ค่าที่เคยเห็นจากรอบก่อน",
    type: "อัตราจ่าย",
    note: "ยึดค่าบนหน้ารายการ",
  },
  {
    title: "ตรวจแหล่งอ้างอิงผลรางวัลให้ชัดเจน",
    desc: "หวยรัฐบาลไทยอ้างอิงผลสลากกินแบ่งรัฐบาล ส่วนหวยหุ้นต่างประเทศอ้างอิงตัวเลขจากตลาดที่กำหนด จึงควรตรวจสอบแหล่งอ้างอิงผลรางวัลที่ระบุไว้บนรายการก่อนทำรายการ",
    type: "แหล่งอ้างอิงผลรางวัล",
    note: "ตรวจก่อนทำรายการ",
  },
  {
    title: "อ่านเงื่อนไขโปรโมชั่นจากประกาศล่าสุด",
    desc: "รายการคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% อาจมีเงื่อนไขเรื่องประเภทหวยที่เข้าร่วม ยอดที่นำมาคำนวณ รอบเวลารับเครดิต และบัญชีที่เข้าร่วมต่างกัน จึงควรอ่านก่อนรับสิทธิ์",
    type: "โปรโมชั่น",
    note: "คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8%",
  },
  {
    title: "ตรวจชื่อบัญชีปลายทางก่อนทำธุรกรรมฝากถอน",
    desc: "ก่อนทำธุรกรรมควรศึกษาช่องทางฝากถอนผ่านธนาคารและวอลเลทที่เปิดใช้งานจริง ยอดขั้นต่ำ ระยะเวลาดำเนินการ และตรวจชื่อบัญชีปลายทางให้ตรงกับข้อมูลที่ยืนยันได้",
    type: "ฝากถอน",
    note: "ธนาคาร · วอลเลท",
  },
];

const faqs = [
  {
    q: `แนวทางบน ${BRAND_NAME} บอกได้ไหมว่าผลรางวัลรอบถัดไปจะออกอะไร?`,
    a: "ไม่ได้ หน้านี้ไม่มีการชี้นำผลรางวัลและไม่มีการทำนายผลของรอบใด สิ่งที่ตรวจสอบได้จริงก่อนทำรายการคือประเภทหวย รอบปิดรับ รอบประกาศผล อัตราจ่าย เงื่อนไขของรายการ และแหล่งอ้างอิงผลรางวัลที่ระบุไว้",
  },
  {
    q: "ควรตรวจอะไรก่อนทำรายการทุกครั้ง?",
    a: "ควรตรวจสอบวันเวลาเปิดรับ อัตราจ่าย และแหล่งอ้างอิงผลรางวัลให้ชัดเจนก่อนทำรายการ เพราะหวยแต่ละประเภทมีรอบประกาศผลตามประเภทของตัวเอง และเงื่อนไขของแต่ละรายการอาจไม่เหมือนกัน",
  },
  {
    q: "โปรโมชั่นคืนยอดเสีย 0.3% ใช้ได้กับหวยทุกประเภทหรือไม่?",
    a: "ควรตรวจสอบเงื่อนไขจากประกาศล่าสุด เพราะหวยแต่ละประเภทอาจมีหลักเกณฑ์การคำนวณยอดเสียและรอบเวลารับเครดิตแตกต่างกัน และการคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกบิลหรือรับประกันผลตอบแทนในอนาคต",
  },
  {
    q: `จะตรวจสอบคำกล่าวอ้างเรื่องการจ่ายเงินของ ${BRAND_NAME} ได้อย่างไร?`,
    a: "สำหรับคำกล่าวอ้างเรื่องการจ่ายเงินจริงหรือไม่มีประวัติร้องเรียน ควรพิจารณาหลักฐานการให้บริการและความคิดเห็นจากหลายแหล่งประกอบกัน ส่วนข้อมูลเกี่ยวกับบริษัทแม่ควรตรวจสอบจากหลักฐานที่เชื่อถือได้ก่อนตัดสินใจ",
  },
  {
    q: `สอบถามเรื่องรอบปิดรับ อัตราจ่าย หรือเงื่อนไขกับ ${BRAND_NAME} ได้ที่ไหน?`,
    a: `ติดต่อเจ้าหน้าที่ผ่านช่องทางที่ระบุไว้บนเว็บไซต์ทางการได้ตลอด 24ชม. และควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความเพื่อหลีกเลี่ยงบัญชีแอบอ้าง โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น`,
  },
];

// 150–160 CHARACTERS (นับตัวอักษร ไม่ใช่ไบต์ — ห้ามใช้ wc -c) ปัจจุบัน 155 ตัวอักษร
const pageDescription = `แนวทาง ${BRAND_NAME} รวมสิ่งที่ควรตรวจก่อนทำรายการ ทั้งรอบปิดรับ รอบประกาศผล อัตราจ่าย เงื่อนไขของแต่ละรายการ และการอ่านประกาศล่าสุด เป็นข้อมูลประกอบก่อนตัดสินใจ`;

const pageHeading = `แนวทาง ${BRAND_NAME} ข้อมูลที่ควรตรวจสอบก่อนทำรายการหวยแต่ละประเภท`;

const graph = pageGraph(Astro, {
  name: pageHeading,
  description: pageDescription,
  faqs,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "แนวทาง", path: "/แนวทาง" },
  ],
});
---

<MainLayout title={`แนวทาง ${BRAND_NAME} ตรวจรอบปิดรับ อัตราจ่าย และเงื่อนไขก่อนทำรายการ`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#0a5f1c]">{BRAND_NAME}</strong> รวบรวมข้อมูลหวยหลายประเภทไว้ในเว็บไซต์เดียว ทั้งหวยรัฐบาลไทย หวยฮานอย หวยลาว และหวยหุ้นต่างประเทศ หน้านี้รวม
        <strong class="text-[#0a5f1c]">แนวทางการตรวจสอบข้อมูลก่อนตัดสินใจ</strong> ตั้งแต่การเลือกประเภทหวย การอ่านรอบปิดรับและรอบประกาศผล การตรวจอัตราจ่ายและเงื่อนไขของแต่ละรายการ
        ไปจนถึงการอ่านประกาศล่าสุดของเว็บไซต์ทางการก่อนรับสิทธิ์โปรโมชั่น
      </p>

      <p>
        <strong class="text-[#0a5f1c]">หน้านี้ไม่ได้ชี้นำผลรางวัล ไม่ได้ทำนายผลของรอบใด และไม่ได้บอกว่าควรเลือกตัวเลขใด</strong> สิ่งที่หน้านี้ทำได้คือบอกว่าข้อมูลชุดไหนตรวจสอบได้จริง
        และควรตรวจจากที่ใดก่อนทำรายการ เพราะหวยแต่ละประเภทมีรอบประกาศผลตามประเภทของตัวเอง และอัตราจ่ายกับเงื่อนไขของแต่ละรายการอาจไม่เหมือนกัน
      </p>

      <p>
        ก่อนทำรายการทุกครั้งควรตรวจสอบวันเวลาเปิดรับ อัตราจ่าย และแหล่งอ้างอิงผลรางวัลให้ชัดเจน ส่วนข้อมูลเกี่ยวกับบริษัทแม่และประวัติการจ่ายเงินควรตรวจสอบจากหลักฐานที่เชื่อถือได้ก่อนตัดสินใจ
        การใช้บริการมีความเสี่ยง ควรกำหนดงบประมาณให้เหมาะสมกับตัวเอง และตรวจสอบรายละเอียดของรายการให้ครบก่อนยืนยันทุกครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBoxNeumorphism as="h2" title="ข้อมูลบนหน้านี้เป็นข้อมูลประกอบ ไม่ใช่การชี้นำผลรางวัล">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#0a5f1c]">สำหรับคำกล่าวอ้างเรื่องการจ่ายเงินจริงหรือไม่มีประวัติร้องเรียน ควรพิจารณาหลักฐานการให้บริการและความคิดเห็นจากหลายแหล่งประกอบกัน</strong>
        เช่นเดียวกับข้อมูลเกี่ยวกับบริษัทแม่ ซึ่งควรตรวจสอบจากหลักฐานที่เชื่อถือได้ก่อนตัดสินใจ หน้านี้จึงไม่สรุปแทนผู้ใช้งานว่าควรเชื่อคำกล่าวอ้างใด
        แต่บอกว่าข้อมูลชุดใดเปิดดูได้จากระบบจริงและควรตรวจก่อนทำรายการ
      </p>

      <p>
        ในทางเดียวกัน <strong class="text-[#0a5f1c]">การคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกบิลหรือรับประกันผลตอบแทนในอนาคต</strong> รายการคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%
        เป็นรายการที่มีเงื่อนไขของตัวเอง ทั้งประเภทหวยที่เข้าร่วม ยอดที่นำมาคำนวณ รอบเวลารับเครดิต และข้อจำกัดของบัญชีที่เข้าร่วม ก่อนรับสิทธิ์ควรอ่านประกาศล่าสุดและตรวจสอบว่าโปรโมชั่นใช้ร่วมกันได้หรือไม่
      </p>

      <p>
        สิ่งที่หน้านี้ช่วยได้จึงเป็นการทำให้รายการของคุณตรวจสอบได้ มากกว่าการคาดการณ์ผล คือรู้ว่ารายการอยู่ในประเภทหวยและรอบไหน อัตราจ่ายเท่าไร เงื่อนไขของรายการเป็นอย่างไร
        และแหล่งอ้างอิงผลรางวัลของรอบนั้นคืออะไร เมื่อข้อมูลเหล่านี้ตรงกับที่ตั้งใจแล้วค่อยยืนยันรายการ จะตัดปัญหาการทำรายการผิดประเภทหรือผิดรอบออกไปได้เกือบทั้งหมด
      </p>
    </div>
  </ContentBoxNeumorphism>

  <ContentBox3ThreeNeumorphism
    as="h2"
    title="สิ่งที่ควรตรวจก่อนทำรายการ แยกตามประเภทหวยที่เปิดให้บริการ"
    heading={false}
    titleleft="หวยรัฐบาลไทย"
    titlecenter="หวยฮานอย และหวยลาว"
    titleright="หวยหุ้นต่างประเทศ">
    <p slot="left">
      หวยรัฐบาลไทยอ้างอิงผลสลากกินแบ่งรัฐบาล จึงควรอ่านรอบปิดรับที่ระบบแสดงให้ตรงกับรอบประกาศผลของสลากกินแบ่งรัฐบาล แล้วตรวจอัตราจ่ายกับเงื่อนไขของรายการอีกครั้งก่อนยืนยัน
    </p>
    <p slot="center">
      หวยฮานอยและหวยลาวมีรอบประกาศผลตามประเภทของตัวเอง ให้เลือกประเภทและรอบที่ต้องการให้ชัดก่อนทำรายการ เพราะรายการของทั้งสองประเภทอาจเปิดรับคนละช่วงกัน และอัตราจ่ายไม่จำเป็นต้องเท่ากัน
    </p>
    <p slot="right">
      หวยหุ้นต่างประเทศอ้างอิงตัวเลขจากตลาดที่กำหนด จึงควรตรวจสอบแหล่งอ้างอิงผลรางวัลที่ระบุไว้บนรายการนั้นให้ชัดเจน พร้อมอ่านรอบปิดรับและเงื่อนไขของรายการก่อนยืนยันทุกครั้ง
    </p>
  </ContentBox3ThreeNeumorphism>

  <ContentBox as="h2" title="จุดที่ตรวจสอบได้จริงก่อนทำรายการ รอบปิดรับ อัตราจ่าย และเงื่อนไขของรายการ">
    <div class="flex flex-col gap-6">
      <p>
        แนวทางที่ใช้ได้จริงคือแนวทางที่ตรวจสอบได้ก่อนยืนยัน ไม่ใช่การคาดการณ์ผลล่วงหน้า หกจุดด้านล่างเปิดดูได้จากหน้ารายการและประกาศล่าสุดทั้งหมด และเป็นตัวกำหนดว่ารายการจะคิดเงินรางวัลอย่างไร
        กับสิทธิ์ที่ได้รับจะเป็นไปตามเงื่อนไขของรายการหรือไม่
      </p>

      <ul class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3" aria-label="จุดที่ควรตรวจสอบก่อนทำรายการ">
        {
          checks.map((item) => (
            <li class="group relative isolate flex flex-col overflow-hidden rounded-2xl border border-[#0b7d28]/30 bg-[#e9fbdd] p-6 shadow-[0_8px_20px_rgba(12,58,22,0.1)] transition-all duration-300 hover:-translate-y-2 hover:border-[#0b7d28]/70 hover:shadow-[0_14px_28px_rgba(11,125,40,0.18)]">
              <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-white to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

              <div class="mb-4 flex items-center justify-between gap-3">
                <span class="rounded-full border border-[#0b7d28]/40 bg-white px-3 py-1 text-xs font-bold text-[#0a5f1c]">{item.type}</span>
                <span class="text-right text-xs font-medium text-[#0a5f1c]">{item.note}</span>
              </div>

              <span class="mb-2 block text-xl font-bold text-[#0a5f1c] transition-colors group-hover:text-[#0b7d28]">{item.title}</span>

              <p class="mb-6">{item.desc}</p>

              <div class="mt-auto flex items-center gap-2 border-t border-[#0b7d28]/30 pt-4 text-base font-bold text-[#0c3a16]">
                <span aria-hidden="true">🧾</span>
                ตรวจรอบปิดรับและอัตราจ่ายจากเว็บไซต์ทางการก่อนทำรายการ
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </ContentBox>

  <ContentBoxNeumorphism as="h2" title={`อ่านประกาศล่าสุดและติดต่อเจ้าหน้าที่ ${BRAND_NAME} ได้ตลอด 24ชม.`}>
    <div class="flex flex-col gap-6">
      <p>
        ประกาศล่าสุดของเว็บไซต์ทางการเป็นที่เดียวที่เงื่อนไขของรายการ รอบปิดรับ อัตราจ่าย และรายละเอียดโปรโมชั่นจะตรงกับที่เปิดใช้งานจริง จึงควรอ่านทุกครั้งก่อนรับสิทธิ์หรือทำรายการฝากถอน
        ส่วนช่องทางฝากถอนผ่านธนาคารและวอลเลท ควรศึกษายอดขั้นต่ำ ระยะเวลาดำเนินการ และตรวจ <strong class="text-[#0a5f1c]">ชื่อบัญชีปลายทาง</strong> ให้ตรงกับข้อมูลที่ยืนยันได้
        หากพบรายการผิดปกติควรหยุดทำธุรกรรมและติดต่อธนาคารหรือผู้ให้บริการชำระเงินเพื่อขอคำแนะนำทันที
      </p>

      <p>
        หากมีข้อสงสัยเกี่ยวกับประเภทหวย รอบปิดรับ อัตราจ่าย เงื่อนไขของรายการ หรือการใช้งานบัญชี ติดต่อเจ้าหน้าที่ผ่านช่องทางที่ระบุไว้บนเว็บไซต์ทางการได้ตลอด 24ชม.
        และควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความเพื่อหลีกเลี่ยงบัญชีแอบอ้าง พร้อมเก็บหมายเลขรายการและหลักฐานที่เกี่ยวข้องไว้สำหรับตรวจสอบ โดย
        <strong class="text-[#0a5f1c]">ไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น</strong>
      </p>

      <div class="flex flex-col gap-4 sm:flex-row sm:justify-center">
        <a
          href="/register"
          class="flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#0a5f1c] via-[#0b7d28] to-[#0a5f1c] px-8 py-4 font-black text-white shadow-[0_6px_18px_rgba(11,125,40,0.35)] transition-transform hover:scale-105">
          <span aria-hidden="true">⚡</span> สมัครสมาชิก {BRAND_NAME}
        </a>
        <a
          href="/ตรวจหวย"
          class="flex items-center justify-center gap-2 rounded-xl border border-[#0b7d28]/50 bg-white px-8 py-4 font-bold text-[#0a5f1c] shadow-[0_6px_18px_rgba(12,58,22,0.14)] transition-colors hover:bg-[#e9fbdd]">
          <span aria-hidden="true">🧾</span> ตรวจผลรางวัลและตรวจสอบรายการ
        </a>
      </div>
    </div>
  </ContentBoxNeumorphism>

  <Faq as="h2" title={`คำถามที่พบบ่อยเกี่ยวกับแนวทางการตรวจสอบข้อมูลของ ${BRAND_NAME}`} faqs={faqs} />

  <Navfoot />
</MainLayout>
