---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBox3ThreeNeumorphism from "../components/ContentBox3ThreeNeumorphism.astro";
import Faq from "../components/Faq3.astro";
import Navfoot from "../components/Navfoot.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็น "แนวทางหวยในฐานะข้อมูลประกอบ + จุดที่ตรวจสอบได้จริงก่อนส่งโพย"
// ไม่ใช่บริการทำนายผล — ไม่มีตัวเลขของรอบใด ไม่มีผลรางวัล ไม่มีสถิติย้อนหลัง
// และ **ห้ามบอกใบ้ว่าเลขใดมีโอกาสออกมากกว่ากัน**
//
// ⚠️ เฮดจ์ของบรีฟเอง (content.txt บรรทัด 7) ต้องอยู่บนหน้านี้เสมอ ห้ามตัดเพราะ
// ฟังดูลบ: "แนวทางหวยหรือเลขดังเป็นข้อมูลประกอบเท่านั้น ไม่สามารถรับประกันผล
// รางวัลของรอบถัดไปได้" — รอบนี้มันถือหัวข้อ H2 ของตัวเองทั้งก้อน
// เฮดจ์คู่กันที่บรรทัด 7 และ 10 ก็ขนมาด้วย: "รับไม่อั้น"/"จ่ายเต็มทุกโพย" ให้ยึด
// วงเงินและเงื่อนไขจริงที่ระบบแสดง · ถ้าไม่มีข้อมูลเปรียบเทียบที่ตรวจสอบได้
// คำว่า "เรทจ่ายสูง" เหมาะสมกว่า "เรทจ่ายสูงที่สุด"
//
// ข้อเท็จจริงทั้งหมดยึดตาม src/assets/content.txt ของรอบนี้เท่านั้น: รวมรายการและ
// แนวทางหวยให้ติดตามผ่านมือถือ ทั้งหวยลาว หวยฮานอย และรัฐบาลไทย (บรรทัด 4, 6) ·
// เลือกเลขเด็ด เลขดัง หรือชุดตัวเลขที่สนใจแล้วตรวจสอบรายละเอียดก่อนส่งโพย
// (บรรทัด 4) · ตรวจสอบวงเงินและส่งโพยผ่านระบบ ดูยอดเดิมพันและอัตราจ่ายก่อนยืนยัน
// (บรรทัด 6) · เลขที่มียอดเดิมพันสูงอาจมีวงเงินรับต่างจากเลขทั่วไป (บรรทัด 7) ·
// อัตราของรายการที่เข้าเงื่อนไขคือ 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท
// ซึ่งอาจต่างตามประเภทหวย รูปแบบการแทง และรอบ (บรรทัด 9, 12, 14, 27) · เลข 3 ตัว
// มีหลายรูปแบบและไม่ได้ใช้อัตราเดียวกันเสมอ (บรรทัด 14) · สมัคร 3 ขั้นตอน
// (บรรทัด 16) · แอดมิน 24 ชั่วโมง (บรรทัด 19) · PIN · OTP (บรรทัด 17, 20)
//
// ⚠️ บรีฟรอบนี้ระบุรายการหวยไว้สามชื่อเท่านั้น (ลาว · ฮานอย · รัฐบาลไทย) ห้ามเติม
// ตลาดอื่น (หวยลาวพัฒนา หวยหุ้น ยี่กี) และห้ามเติมสิ่งที่บรีฟไม่ได้ให้ไว้: เวลา
// ออกรางวัล · เวลาเปิด-ปิดรับของรอบ · ตารางสถิติ · ตัวเลขความแม่นยำ · ชื่อธนาคาร ·
// เลขใบอนุญาต · ยอดฝากขั้นต่ำ · จำนวนสมาชิก · ปีก่อตั้ง
// ตัวเลขที่อ้างได้มีแค่ 2 ตัว / 3 ตัว / 100 / 1,000 / 3 ขั้นตอน / 24 ชั่วโมง
//
// CHROME ROTATION (brand-spec §3): รอบนี้หน้านี้ย้ายออกจากตระกูล *Huay ทั้งหมด —
// แบรนด์ก่อน (หวยคิง) ก็เป็นเว็บหวยและใช้ *Huay ทุกจุด ถ้าใช้ซ้ำสองไคลเอนต์ที่ไม่
// เกี่ยวกันจะออกมาหน้าตาเดียวกัน จึงใช้ Announcement3 (เรียกแบบ bare ให้ตกไปใช้
// default message ของแบรนด์ปัจจุบัน) · Faq3 · ContentBox + ContentBoxNeumorphism +
// ContentBox3ThreeNeumorphism และธีมเป็นพาเลตต์หลักของ หวย24 ไม่ใช่ธีมแดง-ทอง
// "Huay" แยกหมวด ไฟล์ *Huay ยังอยู่บนดิสก์ครบ ไม่แตะ
//
// ค่าสีทุกจุดเป็นเลขจริงของ brand-spec §2 รอบนี้: แดงแบรนด์ #d20a0a · แดงสว่าง
// #ff5c5c · แดงลึก #7a0505 · ทองแบรนด์ #f5c33b · ทองสว่าง #ffd45e · ทองลึก
// #a9761a · พื้นลึกสุด #0a0303 · ผิวการ์ดอุ่น #230d0d · แดงเข้มสุด #2a0606 เป็น
// หมึกบนปุ่มทอง · glow rgba(210,10,10,α) / rgba(245,195,59,α)
// ชุดทองโลหะ + ครีมอมพีชของแบรนด์ก่อน (#cd9a2c #fdeb7c #ab7314 #fcd4c3 #f5e7c8
// #1c140b #0c0b0a #120a02 #5c3f12 rgba(205,154,44,*)) ออกครบแล้ว
//
// ย่อหน้าในกล่องไม่ถือคลาสสีของตัวเอง — ContentBox / ContentBoxNeumorphism ตั้ง
// `text-left text-base leading-relaxed text-[#f7e2d6]` ไว้บนการ์ดแล้ว
//
// การ์ดเหล่านี้เป็น chrome ไม่ใช่หัวข้อบทความ ชื่อการ์ดจึงเป็น <span> ไม่ใช่แท็ก
// หัวข้อ และชื่อของชุดการ์ดไปอยู่บน aria-label ของ <ul> ป้ายสามคอลัมน์ของ
// ContentBox3ThreeNeumorphism เป็นคำบรรยายที่หน้านี้ตั้งเอง ไม่ใช่หัวข้อย่อยของ
// บรีฟ จึงส่ง heading={false} ให้ render เป็น <p>
const tips = [
  {
    title: "รวมเลขเด็ดและเลขดังที่สนใจไว้ให้ครบก่อน",
    desc: "ระบบเปิดรับทั้งเลขเด็ด เลขดัง และชุดตัวเลขที่เลือกเอง ให้รวบรวมเลขที่สนใจไว้ก่อน แล้วค่อยเปิดหน้าส่งโพยทีเดียว จะได้ไม่ต้องตัดสินใจตอนกรอก",
    type: "เลือกเลข",
    note: "เลขเด็ด · เลขดัง",
  },
  {
    title: "เลือกรายการหวยและรอบเปิดรับให้ตรงกับเลขที่คิดไว้",
    desc: "หวยลาวเปิดรับตามรอบ หวยฮานอยมีหลายช่วงเวลา และรัฐบาลไทยตามกำหนดออกรางวัล ให้เลือกรายการให้ชัดก่อน แล้วจึงลงเลขในรอบของรายการนั้น",
    type: "รายการและรอบ",
    note: "ลาว · ฮานอย · รัฐบาลไทย",
  },
  {
    title: "อ่านอัตราจ่ายของรูปแบบที่เลือกบนหน้าส่งโพย",
    desc: "อัตราของรายการที่เข้าเงื่อนไขคือ 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท แต่อาจต่างตามประเภทหวย รูปแบบการแทง และรอบ ให้ยึดตัวเลขที่ระบบแสดงก่อนยืนยัน",
    type: "อัตราจ่าย",
    note: "2 ตัว 100 · 3 ตัว 1,000",
  },
  {
    title: "เลข 3 ตัวมีหลายรูปแบบ ตรวจรูปแบบก่อนยืนยัน",
    desc: "เลข 3 ตัวสามารถมีหลายรูปแบบและไม่ได้ใช้อัตราเดียวกันเสมอ จึงควรตรวจประเภทการเดิมพันที่เลือกไว้ให้ตรง ก่อนดูยอดรวมและกดยืนยันรายการ",
    type: "รูปแบบการแทง",
    note: "ตรวจก่อนยืนยัน",
  },
  {
    title: "ดูวงเงินรับแทงของเลขนั้นก่อนกำหนดยอด",
    desc: "เลขที่มียอดเดิมพันสูงอาจมีวงเงินรับแตกต่างจากเลขทั่วไป ให้กรอกเลขแล้วดูยอดสูงสุดที่ระบบเปิดรับก่อน จึงค่อยกำหนดยอดเดิมพันของเลขนั้นให้อยู่ในวงเงินจริง",
    type: "วงเงินรับแทง",
    note: "ยอดสูงสุดที่ระบบเปิดรับ",
  },
  {
    title: "กลับมาเปิดประวัติโพยทุกครั้งหลังส่ง",
    desc: "ระบบบันทึกรายการหวย รอบ เลขที่เลือก ยอดเดิมพัน และอัตราจ่ายที่แสดงตอนกดยืนยันไว้ให้ จึงเปิดประวัติโพยย้อนดูได้เองจากบัญชีสมาชิกว่าตรงกับที่ตั้งใจหรือไม่",
    type: "ประวัติโพย",
    note: "ตรวจได้ด้วยตัวเอง",
  },
];

const faqs = [
  {
    q: `แนวทางหวยบน ${BRAND_NAME} รับประกันผลรางวัลได้หรือไม่?`,
    a: "ไม่ได้ แนวทางหวยและเลขดังเป็นข้อมูลประกอบเท่านั้น ไม่สามารถรับประกันผลรางวัลของรอบถัดไปได้ สิ่งที่ตรวจสอบได้จริงก่อนกดยืนยันคือรายการหวย รอบเปิดรับ รูปแบบการแทง อัตราจ่าย และวงเงินรับแทงที่ระบบแสดงอยู่ตรงหน้า",
  },
  {
    q: "เลขดังคือเลขที่มีโอกาสออกมากกว่าหรือไม่?",
    a: "ไม่ใช่ เลขดังเป็นเพียงเลขที่กำลังได้รับความสนใจ ไม่ใช่สัญญาณของผลที่จะเกิดขึ้น และไม่มีเลขชุดใดมีโอกาสออกมากกว่าอีกชุดหนึ่ง เลขที่ได้รับความนิยมสูงยังอาจมีวงเงินรับแทงต่างจากเลขทั่วไปด้วย",
  },
  {
    q: `${BRAND_NAME} รับเลขเด็ดและเลขดังแบบไม่อั้นจริงหรือไม่?`,
    a: "สามารถเลือกเลขตามรายการที่เปิดรับได้ แต่วงเงินอาจแตกต่างกันตามหวย รอบ และยอดรวมของเลขนั้น คำว่า “รับไม่อั้น” และ “จ่ายเต็มทุกโพย” จึงควรยึดตามวงเงินและเงื่อนไขจริงที่ระบบแสดงก่อนยืนยันโพย",
  },
  {
    q: "อัตรา 2 ตัวจ่าย 100 และ 3 ตัวจ่าย 1,000 ใช้กับทุกประเภทหรือไม่?",
    a: "ใช้กับรายการที่เข้าเงื่อนไขเท่านั้น หวยแต่ละประเภทหรือรูปแบบการเดิมพันอาจมีเรทแตกต่างกัน โดยเฉพาะเลข 3 ตัวที่มีหลายรูปแบบ จึงควรตรวจสอบอัตราล่าสุดบนหน้าส่งโพยก่อนเดิมพันทุกครั้ง",
  },
  {
    q: `สอบถามเรื่องรอบ อัตราจ่าย หรือวงเงินกับ ${BRAND_NAME} ได้ที่ไหน?`,
    a: `ติดต่อแอดมิน ${BRAND_NAME} ผ่านช่องทางบริการที่เว็บไซต์กำหนดได้ตลอด 24 ชั่วโมง พร้อมแจ้งชื่อหวย รอบเวลา เลขที่เลือก และข้อมูลรายการเพื่อให้ตรวจสอบได้ตรงจุด โดยไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น`,
  },
];

// 150–160 CHARACTERS (นับตัวอักษร ไม่ใช่ไบต์ — ห้ามใช้ wc -c) ปัจจุบัน 157 ตัวอักษร
const pageDescription = `แนวทางหวย ${BRAND_NAME} รวมวิธีเลือกเลขเด็ด เลขดัง สำหรับหวยลาว หวยฮานอย รัฐบาลไทย พร้อมจุดที่ควรตรวจก่อนส่งโพย เป็นข้อมูลประกอบเท่านั้น ไม่รับประกันผลรางวัลรอบถัดไป`;

const pageHeading = `แนวทางหวย ${BRAND_NAME} เลขเด็ด เลขดัง ลาว ฮานอย รัฐบาลไทย เป็นข้อมูลประกอบ`;

const graph = pageGraph(Astro, {
  name: pageHeading,
  description: pageDescription,
  faqs,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "แนวทาง", path: "/แนวทาง" },
  ],
});
---

<MainLayout title={`แนวทางหวย ${BRAND_NAME} เลขเด็ด เลขดัง ลาว ฮานอย รัฐบาลไทย`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#ffd45e]">{BRAND_NAME}</strong> รวบรวมรายการและแนวทางหวยไว้ให้ติดตามผ่านมือถือ ทั้งหวยลาวตามรอบที่เปิดรับ หวยฮานอยหลายช่วงเวลา และรัฐบาลไทยตามกำหนดออกรางวัล หน้านี้รวมวิธีใช้ข้อมูลเหล่านั้นวางแผนก่อนส่งโพย
        ตั้งแต่การรวบรวมเลขเด็ด เลขดัง หรือชุดตัวเลขที่สนใจ ไปจนถึงการอ่านรอบเปิดรับ อัตราจ่าย และวงเงินรับแทงที่ระบบแสดงอยู่บนหน้าส่งโพย
      </p>

      <p>
        <strong class="text-[#ffd45e]">หน้านี้ไม่ทำนายเลข ไม่ชี้ว่าเลขใดมีโอกาสออกมากกว่ากัน และไม่รับประกันผลรางวัลของรอบใด</strong> สิ่งที่ตรวจสอบได้จริงก่อนกดยืนยันคือรายการหวย รอบเปิดรับ รูปแบบการแทง
        อัตราจ่ายของรูปแบบนั้น และวงเงินรับแทงที่ระบบเปิดรับของเลขนั้น ทั้งหมดทำได้จากบัญชีเดียวผ่านเบราว์เซอร์บนมือถือ
      </p>

      <p>
        <strong class="text-[#ffd45e]">อัตราจริงอาจแตกต่างตามประเภทหวย รูปแบบการแทง และรอบที่เลือก</strong> จึงควรยึดข้อมูลล่าสุดบนหน้าส่งโพยเป็นหลักทุกครั้ง การเดิมพันมีความเสี่ยง ควรกำหนดงบประมาณให้เหมาะสมกับตัวเอง
        และตรวจสอบเลขกับจำนวนเงินก่อนยืนยันทุกครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBoxNeumorphism as="h2" title="แนวทางหวยและเลขดังเป็นข้อมูลประกอบเท่านั้น ไม่รับประกันผลรางวัลรอบถัดไป">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#ffd45e]">แนวทางหวยหรือเลขดังเป็นข้อมูลประกอบเท่านั้น ไม่สามารถรับประกันผลรางวัลของรอบถัดไปได้</strong>
        เลขดังคือเลขที่กำลังได้รับความสนใจ ไม่ใช่สัญญาณของผลที่จะเกิดขึ้น และผลของแต่ละรอบไม่ได้ขึ้นกับรอบก่อนหน้า หน้านี้จึงไม่มีการชี้เลขและไม่มีการจัดอันดับว่าเลขใดน่าออกกว่ากัน
      </p>

      <p>
        ในทางเดียวกัน คำว่า <strong class="text-[#ffd45e]">“รับไม่อั้น” และ “จ่ายเต็มทุกโพย” ควรยึดตามวงเงินและเงื่อนไขจริงที่ระบบแสดง</strong> เนื่องจากเลขที่มียอดเดิมพันสูงอาจมีวงเงินรับแตกต่าง จากเลขทั่วไป
        ส่วนข้อความอย่าง “เรทจ่ายสูงที่สุด” ควรมีข้อมูลเปรียบเทียบที่ตรวจสอบได้ประกอบ หากไม่มีข้อมูลดังกล่าว การอ่านว่าเป็น “เรทจ่ายสูง” จะตรงกับความเป็นจริงมากกว่า
      </p>

      <p>
        สิ่งที่หน้านี้ช่วยได้จึงเป็นการทำให้โพยของคุณตรวจสอบได้ มากกว่าการชี้เลข คือรู้ว่าส่งเข้ารายการและรอบไหน รูปแบบใด อัตราจ่ายเท่าไร และวงเงินรับแทงของเลขนั้นอยู่ที่เท่าไร
        เมื่อข้อมูลเหล่านี้ตรงกับที่ตั้งใจแล้วค่อยกดยืนยัน จะตัดปัญหาการส่งผิดรายการหรือผิดรูปแบบออกไปได้เกือบทั้งหมด
      </p>
    </div>
  </ContentBoxNeumorphism>

  <ContentBox3ThreeNeumorphism as="h2" title="แนวทางหวยแยกตามรายการ หวยลาว หวยฮานอย และรัฐบาลไทย" heading={false} titleleft="หวยลาว" titlecenter="หวยฮานอย" titleright="หวยรัฐบาลไทย">
    <p slot="left">หวยลาวเปิดรับตามรอบที่ระบบกำหนด ให้เลือกรอบที่ตั้งใจแทงให้ชัดก่อนลงเลข เพราะเลขชุดเดียวกันส่งไว้ได้มากกว่าหนึ่งรอบ และอัตราจ่ายของแต่ละรอบไม่จำเป็นต้องเท่ากัน</p>
    <p slot="center">หวยฮานอยมีหลายช่วงเวลาให้เลือก ควรดูชื่อรายการและช่วงเวลาที่ระบบแสดงให้ตรงกับที่ตั้งใจก่อนกรอกเลข แล้วตรวจยอดเดิมพันกับอัตราจ่ายของช่วงเวลานั้นอีกครั้งก่อนยืนยัน</p>
    <p slot="right">หวยรัฐบาลไทยเปิดรับตามกำหนดออกรางวัลของรายการนั้น เลข 2 ตัวและเลข 3 ตัวใช้ตัดสินคนละรูปแบบกัน และเลข 3 ตัวยังมีหลายรูปแบบ จึงควรตรวจประเภทการเดิมพันก่อนส่งโพยทุกครั้ง</p>
  </ContentBox3ThreeNeumorphism>

  <ContentBox as="h2" title="จุดที่ตรวจสอบได้จริงก่อนส่งโพย รอบเปิดรับ อัตราจ่าย และวงเงินรับแทง">
    <div class="flex flex-col gap-6">
      <p>
        แนวทางที่ใช้ได้จริงคือแนวทางที่ตรวจสอบได้ก่อนกดยืนยัน ไม่ใช่การเดาผลล่วงหน้า หกจุดด้านล่างคือสิ่งที่เปิดดูได้จากหน้าส่งโพยทั้งหมด และเป็นตัวกำหนดว่ารายการจะคิดเงินรางวัลอย่างไร
        กับยอดรวมในโพยจะออกมาเท่าไร
      </p>

      <ul class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3" aria-label="แนวทางจัดโพยแยกตามจุดที่ต้องตรวจก่อนยืนยัน">
        {
          tips.map((tip) => (
            <li class="group relative isolate flex flex-col overflow-hidden rounded-2xl border border-[#d20a0a]/45 bg-[#0a0303]/80 p-6 shadow-lg backdrop-blur-sm transition-all duration-300 hover:-translate-y-2 hover:border-[#f5c33b]/60 hover:shadow-[0_15px_30px_rgba(210,10,10,0.22)]">
              <div
                aria-hidden="true"
                class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#230d0d] to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"
              />

              <div class="mb-4 flex items-center justify-between gap-3">
                <span class="rounded-full border border-[#d20a0a]/55 bg-[#230d0d] px-3 py-1 text-xs font-bold text-[#ffd45e]">{tip.type}</span>
                <span class="text-right text-xs font-medium text-[#f7e2d6]/80">{tip.note}</span>
              </div>

              <span class="mb-2 block text-xl font-bold text-[#ffd45e] transition-colors group-hover:text-[#ff5c5c]">{tip.title}</span>

              <p class="mb-6">{tip.desc}</p>

              <div class="mt-auto flex items-center gap-2 border-t border-[#7a0505] pt-4 text-base font-bold text-[#f5c33b]">
                <span aria-hidden="true">💰</span>
                ตรวจอัตราจ่ายและวงเงินที่ระบบแสดงก่อนยืนยันโพย
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </ContentBox>

  <ContentBoxNeumorphism as="h2" title={`ส่งโพยด้วยบัญชีเดียว สมัคร ${BRAND_NAME} ผ่านมือถือได้ใน 3 ขั้นตอน`}>
    <div class="flex flex-col gap-6">
      <p>
        ผู้ที่ยังไม่มีบัญชีสมัครเองได้ผ่านมือถือใน 3 ขั้นตอน คือ เข้าหน้าสมัครและกรอกข้อมูลตามที่ระบบกำหนด ยืนยันข้อมูลเพื่อสร้างบัญชีและ Login เข้าสู่ระบบ แล้วเลือกหวย รอบ และเลขที่ต้องการ
        พร้อมตรวจสอบอัตราจ่ายและยอดเดิมพันก่อนส่งโพย เมื่อสมัครเรียบร้อยสามารถใช้บัญชีเดียวติดตามหวยลาว หวยฮานอย รัฐบาลไทย แนวทางหวย ผลรางวัล และประวัติโพยได้ทั้งหมด
      </p>

      <p>
        ควรตรวจสอบเลขและจำนวนเงินก่อนยืนยันทุกครั้ง และ <strong class="text-[#ffd45e]">ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น</strong> หากมีข้อสงสัยเกี่ยวกับรอบเปิดรับ อัตราจ่าย วงเงินรับแทง หรือการใช้งานบัญชี
        ติดต่อแอดมิน {BRAND_NAME} ผ่านช่องทางบริการที่เว็บไซต์กำหนดได้ตลอด 24 ชั่วโมง แม้ระบบเว็บไซต์จะเข้าใช้งานได้ตลอดเวลา แต่เวลารับแทงจริงยังขึ้นอยู่กับ กำหนดเปิดและปิดของหวยแต่ละรอบ
      </p>

      <div class="flex flex-col gap-4 sm:flex-row sm:justify-center">
        <a
          href="/register"
          class="flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#a9761a] via-[#ffd45e] to-[#a9761a] px-8 py-4 font-black text-[#2a0606] shadow-[0_5px_15px_rgba(245,195,59,0.4)] transition-transform hover:scale-105">
          <span aria-hidden="true">⚡</span> สมัครสมาชิก {BRAND_NAME}
        </a>
        <a
          href="/ตรวจหวย"
          class="flex items-center justify-center gap-2 rounded-xl border border-[#d20a0a]/60 bg-[#0a0303] px-8 py-4 font-bold text-[#ffd45e] shadow-[0_5px_15px_rgba(0,0,0,0.6)] transition-colors hover:bg-[#230d0d]">
          <span aria-hidden="true">🧾</span> ตรวจผลรางวัลและประวัติโพย
        </a>
      </div>
    </div>
  </ContentBoxNeumorphism>

  <Faq as="h2" title={`คำถามที่พบบ่อยเกี่ยวกับแนวทางหวย ${BRAND_NAME}`} faqs={faqs} />

  <Navfoot />
</MainLayout>
