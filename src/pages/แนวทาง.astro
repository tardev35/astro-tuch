---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ContentBoxHuay from "../components/ContentBoxHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็น "แนวทางการเลือกเลขและส่งโพย กับจุดที่ตรวจสอบได้จริงก่อนยืนยัน"
// ไม่ใช่บริการทำนายผล — ไม่มีตัวเลขของรอบใด ไม่มีผลรางวัล ไม่มีสถิติย้อนหลัง
// และ **ห้ามบอกใบ้ว่าเลขใดมีโอกาสออกมากกว่ากัน** ต้องมีประโยคปฏิเสธการทำนาย
// อยู่บนหน้านี้เสมอ (เฮดจ์ของบรีฟเอง) ทุกการ์ดจึงพูดถึงสิ่งที่เปิดดูได้จริงบนหน้า
// ส่งโพย: รายการหวย รอบ รูปแบบการแทง อัตราจ่าย และวงเงินรับแทงของเลขนั้น
//
// ข้อเท็จจริงทั้งหมดยึดตาม src/assets/content.txt ของรอบนี้เท่านั้น: เปิดรับตัวเลข
// ตามรายการและรอบที่ระบบกำหนด ทั้งเลขที่เลือกเอง เลขเด็ด และเลขดัง · กรอกเลขและ
// ยอดก่อนตรวจสอบสถานะการรับแทงจากระบบ · เลขที่มีผู้เลือกจำนวนมาก ระบบอาจกำหนด
// วงเงินรับแทงตามแต่ละรอบ ดังนั้นคำว่า "จ่ายไม่อั้น" ควรยึดวงเงินจริงที่เว็บไซต์
// แสดง (L8) · อัตราของรายการที่เข้าเงื่อนไขคือ 2 ตัว จ่าย 100 บาท และ 3 ตัว
// จ่าย 1,000 บาท ซึ่งอาจแตกต่างตามประเภทหวย รูปแบบการแทง หรือเงื่อนไขของแต่ละรอบ
// (L10, L11) · สมัคร 3 ขั้นตอน · ประวัติโพย · แอดมิน 24 ชั่วโมง · PIN · OTP
//
// ⚠️ บรีฟรอบนี้ "ไม่ได้ระบุชื่อตลาดหวยแม้แต่ชื่อเดียว" — หวยรัฐบาลไทย หวยฮานอย
// หวยลาวพัฒนา หวยหุ้นต่างประเทศ ยี่กี เคยอยู่บนหน้านี้จากบรีฟของแบรนด์ก่อน และ
// ถูกถอดออกครบแล้ว ห้ามเติมกลับ เช่นเดียวกับ สถิติหวยย้อนหลัง · กลุ่มหวย ·
// แนวทางหวย ในฐานะฟีเจอร์ของเว็บ (บรีฟไม่ได้ให้ไว้) · เวลาเปิด-ปิดรับ ·
// ชื่อธนาคาร · เลขใบอนุญาต · ยอดฝากขั้นต่ำ · จำนวนสมาชิก · ปีก่อตั้ง
// ตัวเลขที่ใช้ได้มีแค่ 2 ตัว / 3 ตัว / 100 / 1,000 / บาทละ 1,000 / 3 ขั้นตอน /
// 24 ชั่วโมง
//
// หน้านี้คงตระกูล Huay + AnnouncementHuay ตาม brand-spec §3 — รอบนี้แบรนด์เป็น
// เว็บหวยจริง ธีมนี้จึงเป็นธีมของแบรนด์เอง และ AnnouncementHuay คือ ticker ของ
// ทุกหน้าในไซต์ (เรียกแบบ bare ให้ตกไปใช้ default message ของแบรนด์ปัจจุบัน)
// ชื่อแบรนด์มาจาก BRAND_NAME ไม่พิมพ์ทับ
//
// ค่าสีทุกจุดเป็นเลขจริงของ brand-spec §2 รอบนี้: ทองสว่าง #fdeb7c · ทองแบรนด์
// #cd9a2c · ทองลึก #ab7314 · ครีมอมพีช #fcd4c3 · เนื้อความ #f5e7c8 · ผิวการ์ดยก
// #1c140b · พื้นลึกสุด #0c0b0a · หมึกบนปุ่มทอง #120a02 · ขอบจาง #5c3f12 ·
// glow rgba(205,154,44,α) · เงาดำกลาง rgba(0,0,0,α)
// ชุดแดง-ทองของรอบก่อน (#dc0203 #f5282a #8c0402 #ffc93c #ffeab0 #c08a07 #f6e7e0
// #140203 #240406 #3a0a0c #1a0303 rgba(255,201,60,*) rgba(8,1,1,*)) ออกครบแล้ว
//
// ย่อหน้าในกล่องไม่ถือคลาสสีของตัวเอง — ContentBoxHuay ตั้ง
// `text-left text-base leading-relaxed text-[#f5e7c8]` ไว้บนการ์ดแล้ว
//
// การ์ดเหล่านี้เป็น chrome ไม่ใช่หัวข้อบทความ ชื่อการ์ดจึงเป็น <span> ไม่ใช่แท็ก
// หัวข้อ และชื่อของชุดการ์ดไปอยู่บน aria-label ของ <ul> (บทบาท list รับชื่อได้จริง
// ต่างจาก <div> เปล่าที่ aria-label ไม่ถูกประกาศ)
const tips = [
  {
    title: "รวมเลขเด็ดและเลขดังที่ตั้งใจไว้ให้ครบก่อน",
    desc: "เว็บไซต์เปิดรับทั้งเลขที่เลือกเอง เลขเด็ด และเลขดังที่กำลังได้รับความสนใจ ให้รวบรวมเลขที่มีในใจไว้ก่อน แล้วค่อยเปิดหน้าส่งโพยทีเดียว จะได้ไม่ต้องตัดสินใจตอนกรอก",
    type: "เลือกเลข",
    note: "เลขเด็ด · เลขดัง",
  },
  {
    title: "เลือกรายการหวยและรอบให้ตรงกับเลขที่คิดไว้",
    desc: "ระบบเปิดรับตัวเลขตามรายการและรอบที่กำหนด ให้เลือกรายการที่ตั้งใจแทงให้ชัดก่อน แล้วจึงลงเลขในรอบของรายการนั้น เพราะเลขชุดเดียวกันส่งไว้ได้มากกว่าหนึ่งรอบ",
    type: "รายการและรอบ",
    note: "ตามที่ระบบเปิดรับ",
  },
  {
    title: "อ่านอัตราจ่ายของรูปแบบที่เลือกบนหน้าส่งโพย",
    desc: "อัตราของรายการที่เข้าเงื่อนไขคือ 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท แต่อาจแตกต่างตามประเภทหวยและรูปแบบการแทง ให้ยึดตัวเลขที่ระบบแสดงของรอบนั้นก่อนยืนยัน",
    type: "อัตราจ่าย",
    note: "2 ตัว 100 · 3 ตัว 1,000",
  },
  {
    title: "ดูวงเงินรับแทงของเลขนั้นก่อนกำหนดยอด",
    desc: "เลขที่มีผู้เลือกจำนวนมาก ระบบอาจกำหนดวงเงินรับแทงตามแต่ละรอบ ให้กรอกเลขแล้วดูยอดสูงสุดที่ระบบเปิดรับก่อน จึงค่อยกำหนดยอดแทงของเลขนั้นให้อยู่ในวงเงินจริง",
    type: "วงเงินรับแทง",
    note: "ยอดสูงสุดที่ระบบเปิดรับ",
  },
  {
    title: "อ่านคำว่า “จ่ายไม่อั้น” คู่กับวงเงินจริงที่เว็บไซต์แสดง",
    desc: "ข้อความประชาสัมพันธ์อย่าง “จ่ายไม่อั้น” ควรยึดวงเงินจริงที่เว็บไซต์แสดงในรอบนั้นเป็นหลัก เพราะวงเงินรับแทงของแต่ละเลขและแต่ละรอบไม่จำเป็นต้องเท่ากัน",
    type: "เงื่อนไข",
    note: "ยึดตัวเลขที่ระบบแสดง",
  },
  {
    title: "กลับมาเปิดประวัติโพยทุกครั้งหลังส่ง",
    desc: "ระบบบันทึกรายการหวย รอบ เลขที่เลือก ยอดแทง และอัตราจ่ายที่แสดงตอนกดยืนยันไว้ให้ จึงเปิดประวัติโพยย้อนดูได้เองจากบัญชีสมาชิกว่ารายการที่ส่งตรงกับที่ตั้งใจหรือไม่",
    type: "ประวัติโพย",
    note: "ตรวจได้ด้วยตัวเอง",
  },
];

// 150–160 CHARACTERS (นับตัวอักษร ไม่ใช่ไบต์ — ห้ามใช้ wc -c) ปัจจุบัน 154 ตัวอักษร
const pageDescription = `แนวทางเลือกเลขและส่งโพยกับ ${BRAND_NAME} รวมจุดที่ควรตรวจก่อนยืนยัน ทั้งรายการหวย รอบ อัตราจ่าย และวงเงินรับแทงจริง เป็นข้อมูลประกอบการตัดสินใจ ไม่ใช่การทำนายเลข`;

const graph = pageGraph(Astro, {
  name: `แนวทางเลือกเลขและส่งโพยกับ ${BRAND_NAME} ข้อมูลประกอบการตัดสินใจ`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "แนวทาง", path: "/แนวทาง" },
  ],
});
---

<MainLayout title={`แนวทางเลือกเลขและส่งโพย ${BRAND_NAME} จุดที่ควรตรวจก่อนยืนยันรายการ`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxHuay title={`แนวทางเลือกเลขและส่งโพยกับ ${BRAND_NAME} ข้อมูลประกอบการตัดสินใจ`} as="h1">
    <div class="flex flex-col gap-6">
      <p>
        หน้านี้รวมแนวทางการเลือกเลขและจัดโพยกับ <strong class="text-[#fdeb7c]">{BRAND_NAME}</strong> ไว้ให้สมาชิกใช้วางแผนก่อนกดยืนยันรายการ ตั้งแต่การรวบรวมเลขที่ตั้งใจไว้
        เลือกรายการหวยและรอบที่ระบบเปิดรับ ไปจนถึงการอ่านอัตราจ่ายและวงเงินรับแทงที่แสดงอยู่บนหน้าส่งโพย ทั้งหมดทำได้จากบัญชีเดียวผ่านเบราว์เซอร์บนมือถือ
      </p>

      <p>
        <strong class="text-[#fdeb7c]">หน้านี้ไม่ทำนายเลข ไม่ชี้ว่าเลขใดมีโอกาสออกมากกว่ากัน และไม่รับประกันผลของรอบใด</strong> แนวทางเลือกเลขทุกรูปแบบเป็นเพียงข้อมูลประกอบการตัดสินใจ
        ส่วนสิ่งที่ตรวจสอบได้จริงก่อนยืนยันคือรายการหวย รอบ รูปแบบการแทง อัตราจ่าย และวงเงินรับแทงที่ระบบแสดงอยู่ตรงหน้า
      </p>

      <p>
        <strong class="text-[#fdeb7c]">อัตราจ่ายอาจแตกต่างตามประเภทหวย รูปแบบการแทง หรือเงื่อนไขของแต่ละรอบ</strong> จึงไม่ควรถือว่าทุกรายการใช้อัตราเดียวกัน
        ให้ยึดข้อมูลที่ระบบแสดงบนหน้าส่งโพยของรอบนั้นเป็นหลักทุกครั้ง การเดิมพันมีความเสี่ยง ควรกำหนดงบประมาณให้เหมาะสมกับตัวเอง
      </p>
    </div>
  </ContentBoxHuay>

  <ContentBoxHuay title="จุดที่ควรตรวจให้ครบก่อนกดยืนยันส่งโพย" as="h2">
    <ul class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3" aria-label="แนวทางจัดโพยแยกตามจุดที่ต้องตรวจ">
      {
        tips.map((tip) => (
          <li class="group relative isolate flex flex-col overflow-hidden rounded-2xl border border-[#cd9a2c]/45 bg-[#0c0b0a]/80 p-6 shadow-lg backdrop-blur-sm transition-all duration-300 hover:-translate-y-2 hover:border-[#fdeb7c]/60 hover:shadow-[0_15px_30px_rgba(205,154,44,0.22)]">
            <div
              aria-hidden="true"
              class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#1c140b] to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"
            />

            <div class="mb-4 flex items-center justify-between gap-3">
              <span class="rounded-full border border-[#cd9a2c]/55 bg-[#1c140b] px-3 py-1 text-xs font-bold text-[#fdeb7c]">{tip.type}</span>
              <span class="text-right text-xs font-medium text-[#fcd4c3]/80">{tip.note}</span>
            </div>

            <span class="mb-2 block text-xl font-bold text-[#fdeb7c] transition-colors group-hover:text-[#fcd4c3]">{tip.title}</span>

            <p class="mb-6">{tip.desc}</p>

            <div class="mt-auto flex items-center gap-2 border-t border-[#5c3f12] pt-4 text-base font-bold text-[#fdeb7c]">
              <span aria-hidden="true">💰</span>
              ตรวจอัตราจ่ายและวงเงินที่ระบบแสดงก่อนยืนยันโพย
            </div>
          </li>
        ))
      }
    </ul>
  </ContentBoxHuay>

  <ContentBoxHuay title="อ่านอัตราจ่ายและวงเงินรับแทงบนหน้าส่งโพยก่อนยืนยัน" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        แนวทางที่ใช้ได้จริงคือแนวทางที่ตรวจสอบได้ก่อนกดยืนยัน ไม่ใช่การเดาผลล่วงหน้า สิ่งที่ควรเปิดดูให้ครบทุกครั้งคือ
        <strong class="text-[#fdeb7c]">รายการหวยและรอบที่เลือก รูปแบบการแทง อัตราจ่ายของรูปแบบนั้น และวงเงินรับแทงที่ระบบเปิดรับของเลขนั้น</strong>
        เพราะทั้งหมดนี้เป็นตัวกำหนดว่ารายการจะคิดเงินรางวัลอย่างไร และยอดรวมในโพยจะออกมาเท่าไร
      </p>

      <ul class="flex flex-col gap-3">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fdeb7c]">🎯</span>
          <span>
            <strong class="text-[#fdeb7c]">คัดเลขก่อน แล้วค่อยเลือกรายการและรูปแบบ</strong> รวบรวมเลขเด็ดและเลขดังที่มีในใจให้ครบก่อน จากนั้นจึงเปิดดูว่ารอบนี้เปิดรับรายการใด และอัตราจ่ายของรูปแบบที่เลือกแสดงไว้เท่าไร
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fdeb7c]">🎱</span>
          <span>
            <strong class="text-[#fdeb7c]">กระจายยอด อย่ากระจุกที่เลขเดียว</strong> แบ่งยอดออกเป็นหน่วยย่อยไว้ล่วงหน้า แล้ววางต่อเลขให้อยู่ในวงเงินรับแทงที่ระบบเปิดรับของรอบนั้น และในระดับที่รับความเสี่ยงได้
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fdeb7c]">🧾</span>
          <span>
            <strong class="text-[#fdeb7c]">ไล่อ่านทั้งโพยก่อนกดยืนยัน</strong> ตรวจเลขให้ครบทุกหลัก แล้วดูรูปแบบการแทง อัตราจ่าย และยอดรวมอีกรอบ เพราะแต่ละรายการหวยอาจมีรายละเอียดในการคำนวณแตกต่างกัน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fdeb7c]">🔐</span>
          <span>
            <strong class="text-[#fdeb7c]">กลับมาตรวจประวัติโพยหลังส่งทุกครั้ง</strong> ระบบเก็บรายการหวย รอบ เลขที่เลือก ยอดแทง และอัตราจ่ายที่แสดงตอนยืนยันไว้ให้ เปิดย้อนดูได้เองจากบัญชีสมาชิก
          </span>
        </li>
      </ul>
    </div>
  </ContentBoxHuay>

  <ContentBoxHuay title={`${BRAND_NAME} ไม่ทำนายเลข และไม่มีเลขใดมีโอกาสออกมากกว่ากัน`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#fdeb7c]">{BRAND_NAME} ไม่ได้ให้บริการทำนายผล ไม่ชี้นำว่าเลขใดจะออก และไม่มีเลขชุดใดมีโอกาสออกมากกว่าอีกชุดหนึ่ง</strong>
        เลขเด็ดและเลขดังเป็นเพียงเลขที่กำลังได้รับความสนใจ ไม่ใช่สัญญาณของผลที่จะเกิดขึ้น และผลของแต่ละรอบไม่ได้ขึ้นกับรอบก่อนหน้า
      </p>

      <p>
