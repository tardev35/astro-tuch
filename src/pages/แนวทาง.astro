---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ContentBoxHuay from "../components/ContentBoxHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็น "แนวทางการจัดโพยและจุดที่ควรตรวจก่อนยืนยัน" ไม่ใช่บริการทำนายผล —
// ไม่มีเลขเด็ด ไม่มีเลขเด่นงวดนี้ ไม่มีวันที่งวด ไม่มีผลย้อนหลัง และไม่รับประกัน
// เลขใด ทุกการ์ดจึงพูดถึงสิ่งที่ตรวจสอบได้จริงก่อนกดยืนยันโพย (รายการหวย รอบที่
// เปิดรับ รูปแบบการเดิมพัน อัตราจ่ายที่ระบบแสดง เวลาปิดรับ)
//
// ข้อเท็จจริงทั้งหมดยึดตาม src/assets/content.txt ของรอบนี้เท่านั้น: รวมรายการ
// ยอดนิยม หวยลาว หวยฮานอย หวยรัฐบาลไทย และหวยหุ้น ไว้ให้เลือกในบัญชีเดียว ·
// เลือกเลข ส่งโพย ตรวจสอบรายการ และเช็คผลหลังประกาศผลของแต่ละรอบได้จากหน้าเว็บไซต์ ·
// ตรวจสอบเวลาเปิดรับ เวลาปิดรับ และอัตราจ่ายของแต่ละรายการก่อนเลือกเลขได้จากหน้าเดียว ·
// ฝากถอนผ่านวอลเลทและธนาคารที่ระบบรองรับ · อัตราจ่ายของรายการที่เข้าเงื่อนไขคือ
// 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท ซึ่ง "ไม่ควรถือว่าใช้กับทุกรายการ
// โดยอัตโนมัติ ควรตรวจสอบตัวเลขที่แสดงในหน้าส่งโพยก่อนยืนยันทุกครั้ง" (L9, L24)
// — เฮดจ์ประโยคนี้ต้องอยู่บนหน้านี้เสมอ · สมัคร 3 ขั้นตอน · แอดมิน 24 ชั่วโมง
// รายการย่อยของรอบก่อน (ลาวพัฒนา · ฮานอยปกติ/พิเศษ/วีไอพี · หวยหุ้นต่างประเทศ)
// เป็นคำของบรีฟรอบนั้น ไม่ใช่รอบนี้ จึงถูกย่อกลับมาตามบรีฟทั้งหน้า
// ห้ามเติมสถิติตัวเลขจริง ผลย้อนหลัง วันที่ เลขเด็ด เวลาออกรางวัลรายรายการ ชื่อ
// ธนาคาร เงื่อนไขฝาก-ถอน หรือตัวเลขอื่นนอกชุด 2 ตัว 100 / 3 ตัว 1,000 /
// 3 ขั้นตอน / 24 ชั่วโมง และห้ามใช้คำนอกหมวดหวยทุกคำ
//
// หน้านี้ใช้ข้อยกเว้น "หมวดหวยคงธีม Huay" ของ SKILL.md Phase 4.5 ข้อ 5: ธีม
// แดง-ทอง-ดำ ของ /ตรวจหวย กับ /แนวทาง เป็นของหมวดหวยโดยตั้งใจ และ "ไม่" ถูกดึงไป
// พาเลตต์แดงเข้ม-ทองของแบรนด์รอบนี้ ยกเว้นเฉพาะสีเท่านั้น — ชื่อแบรนด์และคำศัพท์
// ต้องเป็นของรอบปัจจุบันทั้งหมด ชื่อแบรนด์จึงมาจาก BRAND_NAME ไม่พิมพ์ทับ
// (ธีมนี้ใกล้เคียงกับ §2 แดงเข้ม-ทองของรอบนี้อยู่แล้ว จึงไม่มีสีไหนต้องขยับ)
//
// การ์ดเหล่านี้เป็น chrome ไม่ใช่หัวข้อบทความ ชื่อการ์ดจึงเป็น <span> ไม่ใช่แท็ก
// หัวข้อ และชื่อของชุดการ์ดไปอยู่บน aria-label ของ <ul> (บทบาท list รับชื่อได้จริง
// ต่างจาก <div> เปล่าที่ aria-label ไม่ถูกประกาศ)
const tips = [
  {
    title: "เปิดดูรอบที่เปิดรับก่อนคัดเลข",
    desc: "รายการที่เปิดรับและรอบของแต่ละวันอาจต่างกัน เพราะหวยแต่ละประเภทมีตารางเวลาเป็นของตัวเอง ให้เปิดดูจากหน้าเว็บไซต์ก่อนว่ารอบไหนกำลังเปิดรับ แล้วตรวจว่าโพยถูกส่งเข้ารอบที่ตั้งใจจริง",
    type: "รอบที่เปิดรับ",
    note: "ต่างกันตามรายการ",
  },
  {
    title: "เลือกรายการหวยให้ตรงกับเลขที่คิดไว้",
    desc: "บัญชีเดียวรวมหวยลาว หวยฮานอย หวยรัฐบาลไทย และหวยหุ้นไว้ด้วยกัน ให้เลือกรายการที่ตั้งใจแทงให้ชัดก่อน แล้วค่อยลงเลขในรอบของรายการนั้น",
    type: "รายการหวย",
    note: "ลาว · ฮานอย · รัฐบาลไทย · หุ้น",
  },
  {
    title: "อ่านอัตราจ่ายของรูปแบบที่เลือก",
    desc: "อัตราของรายการที่ร่วมเงื่อนไขคือ 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท แต่อัตราจริงขึ้นอยู่กับประเภทหวยและรูปแบบการเดิมพัน ให้ยึดตัวเลขที่ระบบแสดงในหน้าส่งโพยของรอบนั้น",
    type: "อัตราจ่าย",
    note: "ยึดตัวเลขที่ระบบแสดง",
  },
  {
    title: "ถือแนวทางเป็นข้อมูลประกอบ ไม่ใช่คำทำนาย",
    desc: "แนวทางเลือกเลขทุกรูปแบบเป็นเพียงข้อมูลประกอบการตัดสินใจ ผลของทุกรอบเป็นการสุ่มและไม่ขึ้นกับรอบก่อนหน้า จึงไม่มีแนวทางใดที่ใช้เป็นการรับประกันผลรอบถัดไปได้",
    type: "แนวทาง",
    note: "ไม่ใช่การรับประกัน",
  },
  {
    title: "เผื่อเวลาก่อนถึงเวลาปิดรับ",
    desc: "การส่งโพยชิดเวลาปิดทำให้ไม่เหลือจังหวะแก้ไขเมื่อกรอกผิด ให้ดูเวลาปิดรับที่ระบบแสดงของรอบนั้น แล้วเผื่อเวลาไว้ตรวจทานเลขและยอดอีกครั้ง",
    type: "เวลาปิดรับ",
    note: "ต่างกันตามรอบ",
  },
  {
    title: "ตรวจโพยย้อนหลังจากบัญชีสมาชิก",
    desc: "เปิดดูรายการย้อนหลังได้เองจากบัญชีสมาชิก ทั้งเลขที่ส่ง ยอดเดิมพัน อัตราจ่ายที่บันทึกไว้ และสถานะที่อัปเดตหลังระบบตรวจสอบเสร็จ",
    type: "ตรวจรายการ",
    note: "ทุกรอบ",
  },
];

// 150–160 CHARACTERS (นับตัวอักษร ไม่ใช่ไบต์ — ห้ามใช้ wc -c) ปัจจุบัน 159 ตัวอักษร
const pageDescription = `แนวทางหวย ${BRAND_NAME} รวมจุดที่ควรตรวจก่อนส่งโพย ทั้งรายการหวย รอบที่เปิดรับ รูปแบบเลข และอัตราจ่ายที่ระบบแสดง เป็นข้อมูลอ้างอิงประกอบการตัดสินใจ ไม่ใช่การทำนายผล`;

const graph = pageGraph(Astro, {
  name: `แนวทางหวย ${BRAND_NAME} ข้อมูลอ้างอิงประกอบการตัดสินใจก่อนส่งโพย`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "แนวทาง", path: "/แนวทาง" },
  ],
});
---

<MainLayout title={`แนวทางหวย ${BRAND_NAME} จุดที่ควรตรวจและอัตราจ่ายก่อนยืนยันโพย`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxHuay title={`แนวทางหวย ${BRAND_NAME} ข้อมูลอ้างอิงประกอบการตัดสินใจก่อนส่งโพย`} as="h1">
    <div class="flex flex-col gap-6">
      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        หน้านี้รวบรวมแนวทางจัดโพยและจุดที่ควรตรวจของ <strong class="text-[#fff4f4]">{BRAND_NAME}</strong> ไว้ให้สมาชิกใช้วางแผนก่อนถึงเวลาปิดรับ โดยบัญชีเดียวรวมหวยลาว หวยฮานอย
        หวยรัฐบาลไทย และหวยหุ้นไว้ด้วยกัน จึงเลือกรายการที่ต้องการ ส่งโพย ตรวจสอบรายการ และเช็คผลหลังประกาศผลของแต่ละรอบได้จากหน้าเว็บไซต์ผ่านเบราว์เซอร์บนมือถือ ส่วนเวลาเปิดรับ เวลาปิดรับ และอัตราจ่ายของแต่ละรายการจะแสดงอยู่ในหน้าส่งโพยของรอบนั้น
      </p>

      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        <strong class="text-[#fff4f4]">แนวทางบนหน้านี้เป็นข้อมูลอ้างอิงเท่านั้น ไม่ใช่การทำนายผลและไม่ใช่การรับประกันเลขใด</strong> ผลของทุกรอบเป็นการสุ่มและไม่ขึ้นกับรอบก่อนหน้า
      </p>

      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        <strong class="text-[#fff4f4]">อัตราจ่ายจริงขึ้นอยู่กับประเภทหวยและรูปแบบการเดิมพันที่ร่วมเงื่อนไข</strong> จึงควรยึดข้อมูลที่แสดงในหน้าส่งโพยของแต่ละรอบเป็นหลักทุกครั้ง การเดิมพันมีความเสี่ยง ควรกำหนดงบประมาณให้เหมาะสมกับตัวเอง
      </p>
    </div>
  </ContentBoxHuay>

  <ContentBoxHuay title="จุดที่ควรตรวจให้ครบก่อนถึงเวลาปิดรับ" as="h2">
    <ul class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3" aria-label="แนวทางจัดโพยแยกตามจุดที่ต้องตรวจ">
      {
        tips.map((tip) => (
          <li class="group relative isolate flex flex-col overflow-hidden rounded-2xl border border-[#8a6a0a]/45 bg-[#120b0c]/80 p-6 shadow-lg backdrop-blur-sm transition-all duration-300 hover:-translate-y-2 hover:border-[#f3c623]/60 hover:shadow-[0_15px_30px_rgba(243,198,35,0.22)]">
            <div
              aria-hidden="true"
              class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#2a0d0f]/80 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"
            />

            <div class="mb-4 flex items-center justify-between gap-3">
              <span class="rounded-full border border-[#8a6a0a]/55 bg-[#1f0a0c] px-3 py-1 text-xs font-bold text-[#f3c623]">{tip.type}</span>
              <span class="text-right text-xs font-medium text-[#f0e2e2]/70">{tip.note}</span>
            </div>

            <span class="mb-2 block text-xl font-bold text-[#fde79a] transition-colors group-hover:text-[#f3c623]">{tip.title}</span>

            <p class="mb-6 text-left text-base leading-relaxed text-[#f0e2e2]">{tip.desc}</p>

            <div class="mt-auto flex items-center gap-2 border-t border-[#2a0d0f] pt-4 text-base font-bold text-[#f3c623]">
              <span aria-hidden="true">💰</span>
              ตรวจอัตราจ่ายที่ระบบแสดงก่อนยืนยันโพย
            </div>
          </li>
        ))
      }
    </ul>
  </ContentBoxHuay>

  <ContentBoxHuay title="คัดเลขและคุมยอดให้ตรวจสอบได้จริงก่อนส่งโพย" as="h2">
    <div class="flex flex-col gap-6">
      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        แนวทางที่ใช้ได้จริงคือแนวทางที่ตรวจสอบได้ก่อนกดยืนยัน ไม่ใช่การเดาผลล่วงหน้า สิ่งที่ควรเปิดดูให้ครบทุกครั้งคือ
        <strong class="text-[#fff4f4]">รายการหวยและรอบที่เลือก รูปแบบการเดิมพัน อัตราจ่ายของรูปแบบนั้น และเวลาปิดรับ</strong>
        เพราะสี่อย่างนี้เป็นตัวกำหนดว่ารายการจะคำนวณผลอย่างไรและยอดรวมในโพยจะออกมาเท่าไร ส่วนเลขที่คิดไว้ล่วงหน้าเป็นเพียงจุดตั้งต้นของการตัดสินใจ
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f0e2e2]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f3c623]">🎯</span>
          <span>
            <strong class="text-[#fff4f4]">คัดเลขก่อน แล้วค่อยเลือกรายการและรูปแบบ</strong> รวบรวมเลขที่มีในใจให้ครบก่อน จากนั้นเปิดดูว่ารอบนี้เปิดรับรายการใด และอัตราจ่ายของรูปแบบที่เลือกแสดงไว้เท่าไร
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f3c623]">🎱</span>
          <span>
            <strong class="text-[#fff4f4]">กระจายยอด อย่ากระจุกตัวเดียว</strong> แบ่งยอดออกเป็นหน่วยย่อยไว้ล่วงหน้า แล้ววางต่อเลขให้อยู่ในระดับที่รับความผันผวนของรอบนั้นได้
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f3c623]">⏱️</span>
          <span>
            <strong class="text-[#fff4f4]">เผื่อเวลาก่อนถึงเวลาปิดรับ</strong> แต่ละรายการปิดรับคนละเวลา การส่งโพยชิดเวลาปิดทำให้ไม่เหลือจังหวะแก้ไขเมื่อกรอกผิด
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f3c623]">🧾</span>
          <span>
            <strong class="text-[#fff4f4]">กลับมาตรวจโพยทุกครั้งหลังส่ง</strong> ระบบบันทึกชื่อรายการ รอบ เลขที่เลือก ยอดเดิมพัน และอัตราจ่ายที่แสดงตอนยืนยันไว้ให้ เปิดดูประวัติย้อนหลังได้เองจากบัญชีสมาชิก
          </span>
        </li>
      </ul>
    </div>
  </ContentBoxHuay>

  <ContentBoxHuay title={`${BRAND_NAME} เปิดรับหวยลาว หวยฮานอย หวยรัฐบาลไทย และหวยหุ้น`} as="h2">
    <div class="flex flex-col gap-6">
      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        สมาชิกที่มีเลขในใจแล้วส่งโพยกับ {BRAND_NAME} ได้จากหน้าเว็บไซต์โดยตรง ทั้งหวยลาวตามรายการที่เปิดรับ หวยฮานอยหลายรอบ หวยรัฐบาลไทยตามกำหนดออกรางวัล และหวยหุ้นตามตลาดที่ระบบรองรับ
        ตรวจสอบเวลาเปิดรับ เวลาปิดรับ และอัตราจ่ายของแต่ละรายการก่อนเลือกเลขได้จากหน้าเดียว หลังส่งโพยแล้วควรตรวจสอบชื่อหวย รอบเวลา เลขที่เลือก และยอดเดิมพันให้ถูกต้อง
      </p>

      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        ก่อนตัดสินใจทุกครั้ง ให้เปิดดู <strong class="text-[#fff4f4]">ข้อมูลที่ระบบแสดงจริงในหน้าส่งโพย</strong> ของรอบนั้นก่อน แล้วคำนวณยอดจากอัตราที่เห็นจริง ไม่ใช่จากอัตราที่จำมาจากรอบก่อน อัตราของรายการที่ร่วมเงื่อนไขคือ
