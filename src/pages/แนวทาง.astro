---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import { pageGraph } from "../lib/schema";

const tips = [
  { title: "แนวทางเลขอั้น 2 ตัว งวดล่าสุด", desc: "รวมเลขเด่นและเลขรองของงวดนี้ พร้อมจุดที่ควรดูก่อนจัดโพยส่งเข้ารอบที่เปิดรับ", type: "เลขอั้น 2 ตัว", date: "วันนี้", hot: true },
  { title: "เจาะเลขอั้น 3 ตัว ก่อนปิดรับ", desc: "แนวทางเลข 3 ตัวที่คนแทงหนักในรอบนี้ พร้อมวิธีกระจายเลขไม่ให้ยอดกระจุกตัวเดียว", type: "เลขอั้น 3 ตัว", date: "วันนี้", hot: true },
  { title: "สถิติเลขท้าย 2 ตัวล่างที่ออกซ้ำ", desc: "สรุปเลขท้าย 2 ตัวล่างที่ออกซ้ำบ่อยในงวดย้อนหลัง ใช้เป็นฐานคัดเลขก่อนลงโพยจริง", type: "สถิติย้อนหลัง", date: "เมื่อวาน", hot: false },
  { title: "อ่านเลขอั้นให้เป็นก่อนส่งโพย", desc: "เลขอั้นคืออะไร ทำไมบางเลขถึงจำกัดยอด และควรตรวจอะไรก่อนกดยืนยันรายการทุกครั้ง", type: "พื้นฐานแทงหวย", date: "เมื่อวาน", hot: false },
  { title: "จัดโพยตามยอดแทงของแต่ละรอบ", desc: "วางเงินให้พอดีกับยอดที่แต่ละรอบเปิดรับ ลดปัญหาโพยไม่ผ่านเพราะเกินเงื่อนไขของรอบ", type: "วางแผนโพย", date: "2 วันที่แล้ว", hot: false },
  { title: "ตรวจโพยผ่านมือถือหลังประกาศผล", desc: "ขั้นตอนเปิดดูโพยย้อนหลังจากบัญชีสมาชิก ดูสถานะรางวัลและยอดที่ปล่อยเข้าบัญชี", type: "ตรวจโพย", date: "2 วันที่แล้ว", hot: false },
];
const pageDescription = "รวมแนวทางหวยและเลขเด่นก่อนส่งโพยบน HSOD ทั้งเลขอั้น 2 ตัว 3 ตัว สถิติงวดย้อนหลัง วิธีจัดยอดแทงตามเงื่อนไขของแต่ละรอบ และการตรวจโพยผ่านมือถือหลังประกาศผล";

const graph = pageGraph(Astro, {
  name: "แนวทางหวย HSOD เลขเด่น เลขอั้น ก่อนส่งโพย",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "แนวทาง", path: "/แนวทาง" },
  ],
});
---

<MainLayout title="แนวทางหวย HSOD เลขเด่น เลขอั้น 2 ตัว 3 ตัว อัปเดตทุกวัน" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <section class="mx-auto my-8 w-full max-w-7xl px-4">
    <div class="mb-10 flex flex-col items-center">
      <span aria-hidden="true" class="mb-2 text-4xl drop-shadow-[0_0_10px_rgba(232,18,29,0.8)]">🔮</span>
      <h1 class="bg-gradient-to-r from-[#ff4d55] via-[#e8121d] to-[#7c0207] bg-clip-text text-center text-4xl font-black tracking-widest text-transparent uppercase">แนวทางหวย HSOD</h1>
      <p class="mt-3 w-full text-left text-base leading-relaxed text-[#aeb6c2]">
        รวบรวมเลขเด่น เลขรอง และสถิติงวดย้อนหลัง ให้สมาชิก HSOD คัดเลขและวางแผนโพยได้ก่อนรอบปิดรับ ครอบคลุมทั้งเลขอั้น 2 ตัวและ 3 ตัว โดยรับยอดแทงตามเงื่อนไขของแต่ละรอบ ที่เรทจ่ายสูงสุด 1,000
        ตามประเภทหวยที่เลือกแทง
      </p>
    </div>

    <h2 class="mb-6 text-center text-2xl font-black tracking-widest text-[#e8121d] uppercase">รวมแนวทางหวยล่าสุด ก่อนถึงรอบปิดรับ</h2>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        tips.map((tip) => (
          <div class="group relative isolate flex flex-col overflow-hidden rounded-2xl border border-[#7c0207]/35 bg-[#170406]/85 p-6 shadow-lg backdrop-blur-sm transition-all duration-300 hover:-translate-y-2 hover:border-[#e8121d]/55 hover:shadow-[0_15px_30px_rgba(232,18,29,0.22)]">
            <div class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#7c0207]/25 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

            <div class="mb-4 flex items-center justify-between">
              <span class="rounded-full border border-[#7c0207]/50 bg-[#2a0508] px-3 py-1 text-xs font-bold text-[#ff4d55]">{tip.type}</span>
              {tip.hot && (
                <span class="flex animate-pulse items-center gap-1 text-xs font-black text-[#e8121d]">
                  <span aria-hidden="true">🔥</span> มาแรง
                </span>
              )}
              {!tip.hot && <span class="text-xs font-medium text-[#aeb6c2]">{tip.date}</span>}
            </div>

            <span class="mb-2 line-clamp-1 block text-xl font-bold text-white transition-colors group-hover:text-[#ff4d55]">{tip.title}</span>

            <p class="mb-6 line-clamp-2 text-left text-base leading-relaxed text-[#dfe3ea]">{tip.desc}</p>

            <div class="mt-auto flex items-center gap-2 border-t border-[#7c0207]/25 pt-4 text-sm font-bold text-[#ff4d55]">
              <span aria-hidden="true">💰</span>
              เรทจ่ายสูงสุด 1,000 ตามประเภทหวย
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <Navfoot />
</MainLayout>
