---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import { pageGraph } from "../lib/schema";

const tips = [
  { title: "แนวทางหวยรัฐบาลไทย งวดล่าสุด", desc: "รวมเลขเด่น เลขรอง พร้อมรอบปิดรับของงวดนี้ ตรวจเลขอั้นก่อนส่งโพยได้เลย", type: "หวยรัฐบาลไทย", date: "วันนี้", hot: true },
  { title: "เจาะเลขฮานอยพิเศษ", desc: "วิเคราะห์สถิติฮานอยย้อนหลัง เข้ามาแล้ว 3 งวดติด รีบส่งโพยก่อนเลขเต็ม", type: "หวยฮานอย", date: "วันนี้", hot: true },
  { title: "แนวทางหวยลาว แม่น้ำหนึ่ง", desc: "สรุปเลขธูปและเลขดังของงวดนี้ จดไว้ก่อนรอบปิดรับหวยลาว", type: "หวยลาว", date: "เมื่อวาน", hot: false },
  { title: "แนวทางหวยออมสิน งวดนี้", desc: "สรุปสถิติเลขท้าย 3 ตัว 2 ตัวของหวยออมสินย้อนหลัง พร้อมเลขเด่นที่ออกซ้ำบ่อย", type: "หวยออมสิน", date: "เมื่อวาน", hot: false },
  { title: "เจาะเลขหวย ธ.ก.ส. งวดล่าสุด", desc: "รวมเลขดังของหวย ธ.ก.ส. พร้อมรอบเปิดรับและเวลาปิดรับที่ต้องรู้ก่อนส่งโพย", type: "หวย ธ.ก.ส.", date: "2 วันที่แล้ว", hot: false },
  { title: "แนวทางหวยหุ้นนิเคอิ เช้า-บ่าย", desc: "วิเคราะห์กราฟหวยหุ้นต่างประเทศ พร้อมเลขเด่นรูด 19 ประตูของรอบเช้าและรอบบ่าย", type: "หวยหุ้น", date: "2 วันที่แล้ว", hot: false },
];
const pageDescription =
  "รวมแนวทางหวยและเลขเด็ดจากสำนักดังบน 7LOTTO ครบทั้งหวยรัฐบาลไทย หวยออมสิน หวย ธ.ก.ส. หวยลาว หวยฮานอย และหวยหุ้น พร้อมรอบปิดรับและเลขอั้นก่อนส่งโพยทุกงวด";

const graph = pageGraph(Astro, {
  name: "แนวทางหวย 7LOTTO เลขเด็ด เลขดัง ทุกตลาด",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "แนวทาง", path: "/แนวทาง" },
  ],
});
---

<MainLayout title="แนวทางหวย 7LOTTO เลขเด็ด เลขดัง ทุกตลาด อัปเดตทุกวัน" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <section class="mx-auto my-8 w-full max-w-7xl px-4 font-sans">
    <div class="mb-10 flex flex-col items-center">
      <span aria-hidden="true" class="mb-2 text-4xl drop-shadow-[0_0_10px_rgba(255,42,48,0.8)]">🔮</span>
      <h1 class="bg-gradient-to-r from-[#ff6b70] via-[#ff2a30] to-[#a3060c] bg-clip-text text-center text-4xl font-black tracking-widest text-transparent uppercase">แนวทางหวย 7LOTTO</h1>
      <p class="mt-3 w-full text-left text-base leading-relaxed text-[#9aa1ad]">
        รวบรวมเลขเด็ด เลขดัง จากทุกสำนักทั่วประเทศ พร้อมสถิติของหวยรัฐบาลไทย หวยออมสิน หวย ธ.ก.ส. หวยลาว หวยฮานอย และหวยหุ้น ให้สมาชิก 7LOTTO วางแผนโพยได้ก่อนรอบปิดรับของแต่ละตลาด ที่เรทจ่าย 2 ตัว 100
        และ 3 ตัว 1,000
      </p>
    </div>

    <h2 class="mb-6 text-center text-2xl font-black tracking-widest text-[#ff2a30] uppercase">รวมแนวทางหวยล่าสุด ครบทุกตลาดที่เปิดรับ</h2>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        tips.map((tip) => (
          <div class="group relative isolate flex flex-col overflow-hidden rounded-2xl border border-[#a3060c]/35 bg-[#0d0304]/85 p-6 shadow-lg backdrop-blur-sm transition-all duration-300 hover:-translate-y-2 hover:border-[#ff2a30]/55 hover:shadow-[0_15px_30px_rgba(255,42,48,0.22)]">
            <div class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#a3060c]/25 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

            <div class="mb-4 flex items-center justify-between">
              <span class="rounded-full border border-[#a3060c]/50 bg-[#150406] px-3 py-1 text-xs font-bold text-[#ff6b70]">{tip.type}</span>
              {tip.hot && (
                <span class="flex animate-pulse items-center gap-1 text-xs font-black text-[#ff2a30]">
                  <span aria-hidden="true">🔥</span> มาแรง
                </span>
              )}
              {!tip.hot && <span class="text-xs font-medium text-[#9aa1ad]">{tip.date}</span>}
            </div>

            <span class="mb-2 line-clamp-1 block text-xl font-bold text-white transition-colors group-hover:text-[#ff6b70]">{tip.title}</span>

            <p class="mb-6 line-clamp-2 text-left text-base leading-relaxed text-[#d8dae0]">{tip.desc}</p>

            <div class="mt-auto flex items-center gap-2 border-t border-[#a3060c]/25 pt-4 text-sm font-bold text-[#ff6b70]">
              <span aria-hidden="true">💰</span>
              เรทจ่าย 2 ตัว 100 · 3 ตัว 1,000
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <Navfoot />
</MainLayout>
<style>
  .font-sans {
    font-family: var(--font-sans);
  }
</style>
