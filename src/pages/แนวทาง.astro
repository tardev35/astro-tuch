---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ContentBoxHuay from "../components/ContentBoxHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็น "รูปแบบการดูสถิติและแนวทางเลือกเลข" ไม่ใช่บริการทำนายผล — เว็บไม่
// ประกาศผลรางวัลเอง ไม่มีเลขเด็ด ไม่รับประกันเลขใด และผลของทุกรายการเป็นการสุ่ม
// ทุกการ์ดจึงพูดถึงสิ่งที่ตรวจสอบได้จริงก่อนกดยืนยัน (รายการหวย รอบที่เปิดรับ
// ประเภทเลข อัตราจ่าย เวลาปิดรับ) ไม่ใช่ "เลขเด่นงวดนี้"
//
// ข้อเท็จจริงทั้งหมดยึดตาม src/assets/content.txt เท่านั้น: 888PARUAY รวมบริการ
// แทงหวยและตรวจหวยออนไลน์ไว้ในระบบเดียว รองรับรัฐบาลไทย ฮานอย ลาวพัฒนา และ
// หุ้นต่างประเทศ ได้ 24 ชั่วโมง · เลือกดูรอบที่เปิดรับ ตรวจสอบเลข และจัดการ
// รายการได้จากหน้าเดียว · แสดงอัตราจ่ายของแต่ละประเภทเลขก่อนยืนยัน เลข 2 ตัว
// จ่าย 100 เลข 3 ตัวจ่าย 1,000 ตามเงื่อนไขของแต่ละรายการ · สมัครเองบนมือถือได้
// ใน 3 ขั้นตอน · แอดมินออนไลน์ 24 ชั่วโมง
// ห้ามเติมสถิติตัวเลขจริง ผลย้อนหลัง วันที่ เลขเด็ด เวลาออกรางวัลรายตลาด หรือ
// เงื่อนไขฝาก-ถอนที่บรีฟรอบนี้ไม่ได้ระบุ
//
// การ์ดเหล่านี้เป็น chrome ไม่ใช่หัวข้อบทความ ชื่อการ์ดจึงเรนเดอร์เป็น span ไม่ใช่
// แท็กหัวข้อ และ label ของ grid ย้ายไปอยู่บน aria-label ของ container แทน
//
// ข้อยกเว้น "หน้าหวยคงธีม Huay" ของ Phase 4.5 มีผลกับหน้านี้: หน้านี้กับ
// /ตรวจหวย คงชุด AnnouncementHuay / ContentBoxHuay และธีมแดง-ทองของมันไว้ ไม่ถูก
// บังคับไปใช้พื้นเขียวของหน้าอื่น — แต่ "ชื่อแบรนด์ไม่ได้รับการยกเว้น" และค่าสี
// ทุกค่าถูกสร้างใหม่จากพาเลตต์ 888PARUAY (ทอง #fcdc2b / #fff6ae / #a87d0c ·
// แดง #cf1111 · พื้น #240808 / #140404 / #3a0f0f · เนื้อความ #e8e4c6 ·
// เนื้อความรอง #c3b98f) ชื่อ "หวยพยัคฆ์" ของแบรนด์เก่าและชุดกรมท่า #030b1c /
// #08152f / #0f2149 / #1c3566 / #dbe4f7 / #9fb0d0 / #e8eef8 / #fadb6c /
// #fdf5a4 / #ab6d13 ออกครบแล้ว
const tips = [
  {
    title: "เปิดดูรอบที่เปิดรับก่อนคัดเลข",
    desc: "รายการที่เปิดรับและช่วงเวลาของแต่ละรอบอาจแตกต่างกัน ให้เปิดหน้ารวมหวยดูก่อนว่ารอบไหนกำลังเปิดรับ แล้วตรวจว่าโพยถูกส่งเข้ารอบที่ตั้งใจจริง",
    type: "รอบที่เปิดรับ",
    note: "ต่างกันตามรอบ",
  },
  {
    title: "เลือกรายการหวยให้ตรงกับเลขที่คิดไว้",
    desc: "ระบบรวมรัฐบาลไทย ฮานอย ลาวพัฒนา และหุ้นต่างประเทศไว้ในที่เดียว เลือกรายการที่ตั้งใจแทงให้ชัดก่อน แล้วค่อยลงเลขในรอบของรายการนั้น",
    type: "รายการหวย",
    note: "ไทย · ฮานอย · ลาว · หุ้น",
  },
  {
    title: "อ่านอัตราจ่ายของประเภทที่เลือก",
    desc: "เลข 2 ตัวจ่าย 100 และเลข 3 ตัวจ่าย 1,000 ตามเงื่อนไขของแต่ละรายการ ให้เปิดดูอัตราที่ระบบแสดงของรอบนั้นก่อน แทนการใช้ตัวเลขที่จำมาจากรอบก่อน",
    type: "อัตราจ่าย",
    note: "บันทึกไว้ในบิลทุกครั้ง",
  },
  {
    title: "ดูสถิติเป็นข้อมูลประกอบ ไม่ใช่คำทำนาย",
    desc: "การไล่ดูเลขที่เคยออกของแต่ละรายการเป็นเพียงข้อมูลประกอบการตัดสินใจ ผลของทุกรอบเป็นการสุ่มและไม่ขึ้นกับรอบก่อนหน้า จึงไม่มีรูปแบบใดบอกผลรอบถัดไปได้",
    type: "ดูสถิติ",
    note: "ผลแต่ละรอบเป็นการสุ่ม",
  },
  {
    title: "เผื่อเวลาก่อนถึงเวลาปิดรับ",
    desc: "การส่งโพยชิดเวลาปิดทำให้ไม่เหลือจังหวะแก้ไขเมื่อกรอกผิด ให้ดูเวลาปิดรับที่ระบบแสดงของรอบนั้นแล้วเผื่อเวลาไว้ตรวจทานอีกรอบ",
    type: "เวลาปิดรับ",
    note: "ต่างกันตามรอบ",
  },
  {
    title: "ตรวจบิลย้อนหลังจากบัญชีสมาชิก",
    desc: "เปิดดูรายการย้อนหลังได้เองจากบัญชีสมาชิก ทั้งเลขที่ส่ง ยอดแทง อัตราจ่ายที่บันทึกไว้ และสถานะที่อัปเดตหลังระบบตรวจสอบเสร็จ",
    type: "ตรวจรายการ",
    note: "ทุกรอบ",
  },
];

// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). ปัจจุบัน 157 ตัวอักษร
const pageDescription = "แนวทางหวย 888PARUAY รูปแบบการดูสถิติและวิธีจัดโพยสำหรับรัฐบาลไทย ฮานอย ลาวพัฒนา พร้อมจุดที่ควรตรวจทั้งอัตราจ่าย รอบที่เปิดรับ และเวลาปิดรับก่อนกดยืนยันรายการ";

const graph = pageGraph(Astro, {
  name: "แนวทางหวย 888PARUAY รูปแบบการดูสถิติและวิธีจัดโพย",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "แนวทาง", path: "/แนวทาง" },
  ],
});
---

<MainLayout title="แนวทางหวย 888PARUAY วิธีจัดโพยและตรวจข้อมูลก่อนรอบปิดรับ" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <section class="mx-auto my-8 w-full max-w-7xl px-4">
    <div class="mb-10 flex flex-col items-center">
      <span aria-hidden="true" class="mb-2 text-4xl drop-shadow-[0_0_10px_rgba(252,220,43,0.8)]">📊</span>
      <h1 class="bg-gradient-to-r from-[#fff6ae] via-[#fcdc2b] to-[#cf1111] bg-clip-text text-center text-4xl font-black tracking-widest text-transparent uppercase">
        แนวทางหวย 888PARUAY ดูสถิติและจัดโพยก่อนรอบปิดรับ
      </h1>
      <p class="mt-3 w-full text-left text-base leading-relaxed text-[#e8e4c6]">
        หน้านี้รวบรวมรูปแบบการดูสถิติและแนวทางเลือกเลขของ <strong class="text-[#fcdc2b]">888PARUAY</strong> ให้สมาชิกวางแผนได้ก่อนรอบปิดรับ โดยระบบรวมบริการแทงหวยและตรวจหวยออนไลน์ไว้ในที่เดียว
        รองรับรายการยอดนิยมทั้งรัฐบาลไทย ฮานอย ลาวพัฒนา และหุ้นต่างประเทศ ได้ 24 ชั่วโมง จึงเลือกรายการที่ต้องการและติดตามหลายรอบได้จากหน้าเดียวโดยไม่ต้องสลับหลายเว็บไซต์ ส่วนรอบที่เปิดรับ
        เวลาปิดรับ อัตราจ่าย และรายละเอียดของแต่ละประเภทจะแสดงอยู่บนหน้ายืนยันรายการของรอบนั้น จึงให้ยึดตัวเลขที่ระบบแสดงจริงเป็นหลักก่อนกดยืนยันทุกครั้ง
        <strong class="text-[#fcdc2b]">หน้านี้ไม่ใช่บริการทำนายผลและไม่มีเลขเด็ด</strong> ผลของทุกรอบเป็นการสุ่ม เว็บไซต์ไม่ได้เป็นผู้ประกาศผลรางวัลเอง และไม่มีแนวทางใดรับประกันผลล่วงหน้าได้
      </p>
    </div>

    <h2 class="mb-6 text-center text-2xl leading-normal font-black tracking-widest text-[#fcdc2b] uppercase">จุดที่ควรตรวจให้ครบก่อนถึงรอบปิดรับ</h2>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3" aria-label="แนวทางจัดโพยแยกตามจุดที่ต้องตรวจ">
      {
        tips.map((tip) => (
          <div class="group relative isolate flex flex-col overflow-hidden rounded-2xl border border-[#a87d0c]/40 bg-[#240808]/90 p-6 shadow-lg backdrop-blur-sm transition-all duration-300 hover:-translate-y-2 hover:border-[#fcdc2b]/60 hover:shadow-[0_15px_30px_rgba(252,220,43,0.22)]">
            <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#3a0f0f]/70 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

            <div class="mb-4 flex items-center justify-between gap-3">
              <span class="rounded-full border border-[#a87d0c]/55 bg-[#140404] px-3 py-1 text-xs font-bold text-[#fcdc2b]">{tip.type}</span>
              <span class="text-right text-xs font-medium text-[#c3b98f]">{tip.note}</span>
            </div>

            <span class="mb-2 block text-xl font-bold text-[#fff6ae] transition-colors group-hover:text-[#fcdc2b]">{tip.title}</span>

            <p class="mb-6 text-left text-base leading-relaxed text-[#c3b98f]">{tip.desc}</p>

            <div class="mt-auto flex items-center gap-2 border-t border-[#3a0f0f] pt-4 text-sm font-bold text-[#fcdc2b]">
              <span aria-hidden="true">💰</span>
              ตรวจอัตราจ่ายที่ระบบแสดงก่อนยืนยัน
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <ContentBoxHuay title="คัดเลขและคุมยอดให้ตรวจสอบได้จริงก่อนส่งโพย" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e8e4c6]">
        แนวทางที่ใช้ได้จริงคือแนวทางที่ตรวจสอบได้ก่อนกดยืนยัน ไม่ใช่การเดาผลล่วงหน้า สิ่งที่ควรเปิดดูให้ครบทุกครั้งคือ
        <strong class="text-[#fcdc2b]">รายการหวยและรอบที่เลือก ประเภทเลขที่แทง อัตราจ่ายของประเภทนั้น และเวลาปิดรับ</strong>
        เพราะสี่อย่างนี้เป็นตัวกำหนดว่ารายการจะคิดผลอย่างไรและยอดรวมในโพยจะออกมาเท่าไร ส่วนเลขที่คิดไว้ล่วงหน้าหรือสถิติที่ไล่ดูย้อนหลังเป็นเพียงจุดตั้งต้น
        <strong class="text-[#fcdc2b]">ผลของแต่ละรอบเป็นการสุ่มและไม่ขึ้นกับรอบก่อนหน้า ไม่มีเลขหรือสูตรใดรับประกันผลได้เสียล่วงหน้า</strong> การเดิมพันจึงมีความเสี่ยง ควรกำหนดงบประมาณให้เหมาะสมทุกครั้ง
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#e8e4c6]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fcdc2b]">🎯</span>
          <span>
            <strong class="text-[#fcdc2b]">คัดเลขก่อน แล้วค่อยเลือกรายการและประเภท</strong> เลือกเลขที่มีในใจให้ครบก่อน จากนั้นเปิดหน้ารวมหวยดูว่ารอบนี้เปิดรับรายการใด
            และเรทของประเภทที่เลือกแสดงไว้เท่าไร
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fcdc2b]">🎱</span>
          <span>
            <strong class="text-[#fcdc2b]">กระจายยอด อย่ากระจุกตัวเดียว</strong> แบ่งยอดออกเป็นหน่วยย่อยไว้ล่วงหน้า แล้ววางต่อเลขให้อยู่ในระดับที่รับความผันผวนของรอบนั้นได้
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fcdc2b]">⏱️</span>
          <span>
            <strong class="text-[#fcdc2b]">เผื่อเวลาก่อนรอบปิดรับ</strong> แต่ละรายการปิดรับคนละเวลา การส่งโพยชิดเวลาปิดทำให้ไม่เหลือจังหวะแก้ไขเมื่อกรอกผิด
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fcdc2b]">🧾</span>
          <span>
            <strong class="text-[#fcdc2b]">เก็บบิลไว้ทุกครั้ง</strong> เมื่อส่งโพยสำเร็จ ระบบบันทึกรายการ รอบ เลข ยอดแทง และอัตราจ่ายที่แสดงตอนยืนยันไว้ให้
            เช็กประวัติย้อนหลังได้เองจากบัญชีสมาชิก
          </span>
        </li>
      </ul>
    </div>
  </ContentBoxHuay>

  <ContentBoxHuay title="888PARUAY เปิดรับรัฐบาลไทย ฮานอย ลาวพัฒนา และหุ้นต่างประเทศ" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e8e4c6]">
        สายหวยที่มีเลขในใจเข้ามาส่งโพยกับ 888PARUAY ได้จากเมนูรวมหวยของเว็บไซต์โดยตรง โดยแต่ละรายการถูกจัดหมวดหมู่ไว้อย่างชัดเจนทั้งรัฐบาลไทย ฮานอย ลาวพัฒนา และหุ้นต่างประเทศ
        ตามรอบที่เปิดให้บริการ สมาชิกเลือกรายการ เลือกประเภทเลข ส่งโพย และเช็กประวัติได้ด้วยตัวเอง ระบบจะแสดงรายละเอียดของรายการก่อนยืนยัน ทำให้เห็นเลขและยอดเดิมพันอย่างชัดเจนก่อนกดส่ง
        และบิลจะถูกเก็บไว้ในประวัติให้เทียบย้อนหลังได้เสมอ ระบบรองรับการใช้งานผ่านมือถือ จึงเหมาะกับคนที่ต้องการติดตามหวยหลายประเภทโดยไม่ต้องสลับหลายเว็บไซต์
      </p>

      <p class="text-left text-base leading-relaxed text-[#e8e4c6]">
        ก่อนตัดสินใจทุกครั้ง ให้เปิดดู <strong class="text-[#fcdc2b]">ตัวเลขที่ระบบแสดงจริงบนหน้ายืนยันรายการ</strong> ของรอบนั้นก่อน แล้วคำนวณยอดจากอัตราที่เห็นจริง ไม่ใช่จากเรทที่จำมาจากรอบก่อน
        ข้อมูลที่กำหนดไว้คือเลข 2 ตัวจ่าย 100 และเลข 3 ตัวจ่าย 1,000 ตามเงื่อนไขของแต่ละรายการ ส่วนเวลาเปิด-ปิดรับและรายละเอียดของแต่ละประเภทต่างกันไปตามรอบ
        อัตราที่ใช้ตอนกดยืนยันจะถูกบันทึกไว้ในบิล จึงเปิดดูย้อนหลังได้เสมอว่ารายการนั้นคิดจากเรทเท่าไร
      </p>

      <p class="text-left text-base leading-relaxed text-[#e8e4c6]">
        ผู้ที่ยังไม่มีบัญชีสมัครเองได้ผ่านมือถือใน <strong class="text-[#fcdc2b]">3 ขั้นตอน</strong> คือเปิดหน้าสมัครแล้วกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน ตรวจสอบข้อมูลส่วนตัวและรายละเอียดบัญชี
