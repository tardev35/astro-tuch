---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ContentBoxHuay from "../components/ContentBoxHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็น "แนวทางการจัดโพยและจุดที่ควรตรวจก่อนยืนยัน" ไม่ใช่บริการทำนายผล —
// ไม่มีเลขเด็ดของงวดใด ไม่มีเลขเด่นงวดนี้ ไม่มีวันที่งวด ไม่มีผลย้อนหลัง และ
// ไม่รับประกันเลขใด ทุกการ์ดจึงพูดถึงสิ่งที่ตรวจสอบได้จริงก่อนกดยืนยันโพย
// (รายการหวย รอบที่เปิดรับ รูปแบบการเดิมพัน อัตราจ่ายที่ระบบแสดง เวลาปิดรับ
// และวงเงินที่ระบบเปิดรับของเลขนั้น)
//
// ข้อเท็จจริงทั้งหมดยึดตาม src/assets/content.txt ของรอบนี้เท่านั้น: เปิดรับแทงหวย
// ออนไลน์ เลขเด็ด เลขดัง ผ่านบัญชีเดียว ครบทั้งหวยรัฐบาลไทย หวยฮานอย หวยลาว และ
// หวยหุ้นต่างประเทศ (ลำดับตามบรีฟ) · เลือกเลข ส่งโพย ตรวจสอบรายการ และเช็คผลของ
// แต่ละรอบได้จากหน้าเว็บไซต์ · ตรวจสอบตารางรอบ เวลาปิดรับ และอัตราจ่ายล่าสุดก่อน
// ส่งโพยได้จากหน้าเดียว · อัตราจ่ายของรายการที่เข้าเงื่อนไขคือ 2 ตัว จ่าย 100 บาท
// และ 3 ตัว จ่าย 1,000 บาท ซึ่ง "อาจแตกต่างกันตามประเภทหวยและรูปแบบการเดิมพัน
// ไม่ควรถือว่าใช้กับทุกรายการเหมือนกัน" (L11, L28) — เฮดจ์ประโยคนี้ต้องอยู่บน
// หน้านี้เสมอ เช่นเดียวกับเฮดจ์ของคำว่า "ไม่จำกัด / แทงได้ไม่อั้น" ที่ต้องอ้างอิง
// วงเงินที่ระบบเปิดรับจริงของแต่ละรอบ (L5) · สมัคร 3 ขั้นตอน · แอดมิน 24 ชั่วโมง
//
// รายการย่อยและมุมของบรีฟรอบก่อน (ลาวพัฒนา · ฮานอยปกติ/พิเศษ/วีไอพี ·
// "ฝากถอนวอลเลทและธนาคาร" · "เช็คผลทันที") ไม่ได้อยู่ในบรีฟรอบนี้ จึงไม่ปรากฏบน
// หน้านี้ ห้ามเติมสถิติตัวเลขจริง ผลย้อนหลัง วันที่ เลขเด็ดของงวดใด เวลาออกรางวัล
// รายรายการ ชื่อธนาคาร เงื่อนไขฝาก-ถอน หรือตัวเลขอื่นนอกชุด 2 ตัว 100 /
// 3 ตัว 1,000 / 3 ขั้นตอน / 24 ชั่วโมง และห้ามใช้คำนอกหมวดหวยทุกคำ
//
// หน้านี้ใช้ข้อยกเว้น "หมวดหวยคงธีม Huay" ของ SKILL.md Phase 4.5 ข้อ 5: รูปทรง
// แดง-ทอง-ดำ ของ /ตรวจหวย กับ /แนวทาง เป็นของหมวดหวยโดยตั้งใจ และยังใช้
// AnnouncementHuay ต่อ ไม่สลับไป Announcement2 เหมือนหน้าอื่น — ข้อยกเว้นครอบเฉพาะ
// ธีมเท่านั้น ชื่อแบรนด์และเนื้อหาต้องเป็นของรอบปัจจุบันทั้งหมด ชื่อแบรนด์จึงมาจาก
// BRAND_NAME ไม่พิมพ์ทับ และค่าสีถูกขยับมาใช้เลขจริงของ brand-spec §2 รอบนี้
// (#2b0909 / #1c0606 / #5c0a0a / #a8690c / #d99a10 / #f4bc5d / #ffefc2 /
// #dc2224 / #e43434 / #fbe3d4) แทนค่าใกล้เคียงของแบรนด์ก่อนหน้า
//
// การ์ดเหล่านี้เป็น chrome ไม่ใช่หัวข้อบทความ ชื่อการ์ดจึงเป็น <span> ไม่ใช่แท็ก
// หัวข้อ และชื่อของชุดการ์ดไปอยู่บน aria-label ของ <ul> (บทบาท list รับชื่อได้จริง
// ต่างจาก <div> เปล่าที่ aria-label ไม่ถูกประกาศ)
const tips = [
  {
    title: "เปิดดูรอบที่เปิดรับก่อนคัดเลข",
    desc: "รายการที่เปิดรับและรอบของแต่ละวันอาจต่างกัน เพราะหวยแต่ละประเภทมีตารางเวลาเป็นของตัวเอง ให้เปิดดูจากหน้าเว็บไซต์ก่อนว่ารอบไหนกำลังเปิดรับ แล้วตรวจว่าโพยถูกส่งเข้ารอบที่ตั้งใจจริง",
    type: "รอบที่เปิดรับ",
    note: "ต่างกันตามรายการ",
  },
  {
    title: "เลือกรายการหวยให้ตรงกับเลขที่คิดไว้",
    desc: "บัญชีเดียวรวมหวยรัฐบาลไทย หวยฮานอย หวยลาว และหวยหุ้นต่างประเทศไว้ด้วยกัน ให้เลือกรายการที่ตั้งใจแทงให้ชัดก่อน แล้วค่อยลงเลขในรอบของรายการนั้น",
    type: "รายการหวย",
    note: "รัฐบาลไทย · ฮานอย · ลาว · หุ้นต่างประเทศ",
  },
  {
    title: "อ่านอัตราจ่ายของรูปแบบที่เลือก",
    desc: "อัตราของรายการที่เข้าเงื่อนไขคือ 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท แต่อาจแตกต่างกันตามประเภทหวยและรูปแบบการเดิมพัน ให้ยึดอัตราที่ระบบแสดงในหน้าส่งโพยของรอบนั้น",
    type: "อัตราจ่าย",
    note: "ยึดตัวเลขที่ระบบแสดง",
  },
  {
    title: "เลขเด็ด เลขดัง ต้องดูวงเงินของเลขนั้นด้วย",
    desc: "เลือกเลขเด็ดหรือเลขดังที่ติดตามไว้ได้ตามรายการที่เปิดรับ แต่คำว่าไม่จำกัดและแทงได้ไม่อั้นให้อ้างอิงวงเงินที่ระบบเปิดรับจริง เพราะแต่ละประเภทหวย แต่ละเลข และแต่ละรอบอาจกำหนดวงเงินไม่เท่ากัน",
    type: "วงเงิน",
    note: "ต่างกันตามเลขและรอบ",
  },
  {
    title: "ถือแนวทางเป็นข้อมูลประกอบ ไม่ใช่คำทำนาย",
    desc: "แนวทางเลือกเลขทุกรูปแบบเป็นเพียงข้อมูลประกอบการตัดสินใจ ตัวเลขที่ติดตามกันไม่สามารถรับประกันผลรางวัลได้ และผลของแต่ละรอบไม่ขึ้นกับรอบก่อนหน้า",
    type: "แนวทาง",
    note: "ไม่ใช่การรับประกัน",
  },
  {
    title: "เผื่อเวลาก่อนถึงเวลาปิดรับ",
    desc: "การส่งโพยชิดเวลาปิดทำให้ไม่เหลือจังหวะแก้ไขเมื่อกรอกผิด ให้ดูเวลาปิดรับที่ระบบแสดงของรอบนั้น แล้วเผื่อเวลาไว้ตรวจทานเลขและยอดอีกครั้ง",
    type: "เวลาปิดรับ",
    note: "ต่างกันตามรอบ",
  },
  {
    title: "ตรวจโพยย้อนหลังจากบัญชีสมาชิก",
    desc: "เปิดดูรายการย้อนหลังได้เองจากบัญชีสมาชิก ทั้งเลขที่ส่ง ยอดเดิมพัน อัตราจ่ายที่บันทึกไว้ และสถานะที่อัปเดตหลังระบบตรวจสอบเสร็จ",
    type: "ตรวจรายการ",
    note: "ทุกรอบ",
  },
];

// 150–160 CHARACTERS (นับตัวอักษร ไม่ใช่ไบต์ — ห้ามใช้ wc -c) ปัจจุบัน 157 ตัวอักษร
const pageDescription = `แนวทางหวย ${BRAND_NAME} รวมจุดที่ควรตรวจก่อนส่งโพย รายการหวย รอบที่เปิดรับ รูปแบบเลข อัตราจ่าย และวงเงินที่ระบบเปิดรับ เป็นข้อมูลประกอบการตัดสินใจ ไม่ใช่คำทำนาย`;

const graph = pageGraph(Astro, {
  name: `แนวทางหวย ${BRAND_NAME} ข้อมูลอ้างอิงประกอบการตัดสินใจก่อนส่งโพย`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "แนวทาง", path: "/แนวทาง" },
  ],
});
---

<MainLayout title={`แนวทางหวย ${BRAND_NAME} จุดที่ควรตรวจและอัตราจ่ายก่อนยืนยันโพย`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxHuay title={`แนวทางหวย ${BRAND_NAME} ข้อมูลอ้างอิงประกอบการตัดสินใจก่อนส่งโพย`} as="h1">
    <div class="flex flex-col gap-6">
      <p class="text-left text-base leading-relaxed text-[#fbe3d4]">
        หน้านี้รวบรวมแนวทางจัดโพยและจุดที่ควรตรวจของ <strong class="text-[#ffefc2]">{BRAND_NAME}</strong> ไว้ให้สมาชิกใช้วางแผนก่อนถึงเวลาปิดรับ โดยบัญชีเดียวรวมหวยรัฐบาลไทย หวยฮานอย
        หวยลาว และหวยหุ้นต่างประเทศไว้ด้วยกัน จึงเลือกประเภทหวยที่ต้องการ ส่งโพย ตรวจสอบรายการ และเช็คผลของแต่ละรอบได้จากหน้าเว็บไซต์ผ่านเบราว์เซอร์บนมือถือ ส่วนตารางรอบ เวลาปิดรับ และอัตราจ่ายล่าสุดของแต่ละรายการจะแสดงอยู่ในหน้าส่งโพยของรอบนั้น
      </p>

      <p class="text-left text-base leading-relaxed text-[#fbe3d4]">
        <strong class="text-[#ffefc2]">แนวทางบนหน้านี้เป็นข้อมูลอ้างอิงเท่านั้น ไม่ใช่การทำนายผลและไม่ใช่การรับประกันเลขใด</strong> ผู้ที่ติดตามเลขเด็ดหรือเลขดังนำตัวเลขมาเลือกแทงตามรูปแบบที่ระบบเปิดรับได้
        แต่ตัวเลขดังกล่าวไม่สามารถรับประกันผลรางวัลได้ และผลของแต่ละรอบไม่ขึ้นกับรอบก่อนหน้า
      </p>

      <p class="text-left text-base leading-relaxed text-[#fbe3d4]">
        <strong class="text-[#ffefc2]">อัตราจ่ายอาจแตกต่างกันตามประเภทหวยและรูปแบบการเดิมพัน จึงไม่ควรถือว่าใช้กับทุกรายการเหมือนกัน</strong> ให้ยึดข้อมูลที่แสดงในหน้าส่งโพยของแต่ละรอบเป็นหลักทุกครั้ง
        ส่วนคำว่าไม่จำกัดและแทงได้ไม่อั้นให้อ้างอิงวงเงินที่ระบบเปิดรับจริง การเดิมพันมีความเสี่ยง ควรกำหนดงบประมาณให้เหมาะสมกับตัวเอง
      </p>
    </div>
  </ContentBoxHuay>

  <ContentBoxHuay title="จุดที่ควรตรวจให้ครบก่อนถึงเวลาปิดรับ" as="h2">
    <ul class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3" aria-label="แนวทางจัดโพยแยกตามจุดที่ต้องตรวจ">
      {
        tips.map((tip) => (
          <li class="group relative isolate flex flex-col overflow-hidden rounded-2xl border border-[#a8690c]/45 bg-[#1c0606]/80 p-6 shadow-lg backdrop-blur-sm transition-all duration-300 hover:-translate-y-2 hover:border-[#f4bc5d]/60 hover:shadow-[0_15px_30px_rgba(244,188,93,0.22)]">
            <div
              aria-hidden="true"
              class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#5c0a0a]/80 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"
            />

            <div class="mb-4 flex items-center justify-between gap-3">
              <span class="rounded-full border border-[#a8690c]/55 bg-[#2b0909] px-3 py-1 text-xs font-bold text-[#f4bc5d]">{tip.type}</span>
              <span class="text-right text-xs font-medium text-[#fbe3d4]/70">{tip.note}</span>
            </div>

            <span class="mb-2 block text-xl font-bold text-[#ffefc2] transition-colors group-hover:text-[#f4bc5d]">{tip.title}</span>

            <p class="mb-6 text-left text-base leading-relaxed text-[#fbe3d4]">{tip.desc}</p>

            <div class="mt-auto flex items-center gap-2 border-t border-[#5c0a0a] pt-4 text-base font-bold text-[#f4bc5d]">
              <span aria-hidden="true">💰</span>
              ตรวจอัตราจ่ายที่ระบบแสดงก่อนยืนยันโพย
            </div>
          </li>
        ))
      }
    </ul>
  </ContentBoxHuay>

  <ContentBoxHuay title="คัดเลขและคุมยอดให้ตรวจสอบได้จริงก่อนส่งโพย" as="h2">
    <div class="flex flex-col gap-6">
      <p class="text-left text-base leading-relaxed text-[#fbe3d4]">
        แนวทางที่ใช้ได้จริงคือแนวทางที่ตรวจสอบได้ก่อนกดยืนยัน ไม่ใช่การเดาผลล่วงหน้า สิ่งที่ควรเปิดดูให้ครบทุกครั้งคือ
        <strong class="text-[#ffefc2]">รายการหวยและรอบที่เลือก รูปแบบการเดิมพัน อัตราจ่ายของรูปแบบนั้น เวลาปิดรับ และวงเงินที่ระบบเปิดรับของเลขนั้น</strong>
        เพราะทั้งหมดนี้เป็นตัวกำหนดว่ารายการจะคำนวณผลอย่างไรและยอดรวมในโพยจะออกมาเท่าไร ส่วนเลขเด็ดหรือเลขดังที่คิดไว้ล่วงหน้าเป็นเพียงจุดตั้งต้นของการตัดสินใจ
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#fbe3d4]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f4bc5d]">🎯</span>
          <span>
            <strong class="text-[#ffefc2]">คัดเลขก่อน แล้วค่อยเลือกรายการและรูปแบบ</strong> รวบรวมเลขที่มีในใจให้ครบก่อน จากนั้นเปิดดูว่ารอบนี้เปิดรับรายการใด และอัตราจ่ายของรูปแบบที่เลือกแสดงไว้เท่าไร
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f4bc5d]">🎱</span>
          <span>
            <strong class="text-[#ffefc2]">กระจายยอด อย่ากระจุกตัวเดียว</strong> แบ่งยอดออกเป็นหน่วยย่อยไว้ล่วงหน้า แล้ววางต่อเลขให้อยู่ในวงเงินที่ระบบเปิดรับของรอบนั้นและในระดับที่รับความผันผวนได้
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f4bc5d]">⏱️</span>
          <span>
            <strong class="text-[#ffefc2]">เผื่อเวลาก่อนถึงเวลาปิดรับ</strong> แต่ละรายการปิดรับคนละเวลา การส่งโพยชิดเวลาปิดทำให้ไม่เหลือจังหวะแก้ไขเมื่อกรอกผิด
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f4bc5d]">🧾</span>
          <span>
            <strong class="text-[#ffefc2]">กลับมาตรวจโพยทุกครั้งหลังส่ง</strong> ระบบบันทึกชื่อรายการ รอบ เลขที่เลือก ยอดเดิมพัน และอัตราจ่ายที่แสดงตอนยืนยันไว้ให้ เปิดดูประวัติย้อนหลังได้เองจากบัญชีสมาชิก
          </span>
        </li>
      </ul>
    </div>
  </ContentBoxHuay>

  <ContentBoxHuay title={`${BRAND_NAME} เปิดรับหวยรัฐบาลไทย ฮานอย ลาว และหุ้นต่างประเทศ`} as="h2">
