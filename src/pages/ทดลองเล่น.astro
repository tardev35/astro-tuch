---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login,
// /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx
// ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บน
// ข้อเท็จจริงของ 1SS365 เท่านั้น (src/assets/content.txt)
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
//
// 1SS365 เป็น **สล็อตออนไลน์ เว็บตรงต่างประเทศ ไม่ผ่านเอเย่นต์** แง่มุมที่บรีฟระบุ
// ไว้มีเท่านี้: รวมเกมสล็อตหลายรูปแบบไว้เลือกผ่านบัญชีเดียว ทั้งสล็อตคลาสสิก ฟรีสปิน
// ตัวคูณ และเกมโบนัส · เข้าเล่นผ่านมือถือได้โดยไม่ต้องสลับหลายเว็บไซต์ · ตรวจสอบ
// ค่ายเกม เครดิต โปรโมชั่น และประวัติรายการได้จากระบบเดียว · ช่วงเดิมพันขั้นต่ำและ
// สูงสุดขึ้นกับค่ายและเกมที่เลือก · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · สมัคร
// 3 ขั้นตอน · แอดมิน 24 ชั่วโมง · PIN/OTP ห้ามเปิดเผย
//
// ⚠️ แบรนด์ก่อน (หวย365) เป็น **เว็บแทงหวยออนไลน์** คนละสินค้ากันทั้งหน้า — ย่อหน้า
// และรายการของหวย (รายการหวยรัฐบาลไทย ฮานอย ลาวพัฒนา หวยหุ้น เลือกเลข ส่งโพย โพย
// อัตราจ่าย 2 ตัว 100 บาท 3 ตัว 1,000 บาท งวด สถิติหวยย้อนหลัง แนวทางหวย กลุ่มหวย
// ตรวจหวย) ถูกถอดออกทั้งหมด ห้ามนำกลับมา และห้ามลิงก์ไป /ตรวจหวย หรือ /แนวทาง
// เพราะรอบนี้สองหน้านั้นอยู่ใน src/pages-disabled/ แล้ว = เราต์ตายและ build แดง
// ตัวเลขที่อ้างได้มีแค่ 0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง · 100% และห้ามเพิ่ม
// ใบอนุญาต ชื่อผู้ให้บริการ ชื่อธนาคาร ยอดฝากขั้นต่ำ จำนวนสมาชิก ปีที่ก่อตั้ง
// ค่า RTP หรือชื่อค่ายเกม/ชื่อเกม เพราะบรีฟไม่ได้เอ่ยไว้สักชื่อ
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามี "โหมดทดลอง" เครดิตทดลอง หรือเกมเดโมเป็นบริการของเว็บ —
// จึงห้ามสัญญาสินค้าตัวนั้น และห้ามดึง src/assets/gamedemo*.webp กลับมา (ไฟล์ชุดนั้น
// ลงวันที่ 2026-08-04 เป็นอินเวนทอรีเก่า ไม่ใช่อาร์ตเวิร์กของดรอปนี้)
// หน้านี้จึงพูดถึงเฉพาะสิ่งที่บรีฟระบุไว้ตรง ๆ ว่าควรทำก่อนเริ่มเล่น นั่นคือ
// "ควรเปิดข้อมูลเกมและตรวจสอบช่วงเดิมพันก่อนเริ่มเล่นทุกครั้ง" และ "ควรตรวจสอบ
// ขั้นต่ำและสูงสุดของเกมนั้นโดยตรง" = ไล่เปิดข้อมูลเกมให้ครบก่อนตั้งเดิมพันจริง
// ไม่ใช่การเล่นฟรี
//
// เฮดจ์ของบรีฟที่ห้ามตัดทิ้ง: คำว่าแตกง่ายหรือจ่ายไวเป็นลักษณะเชิงโฆษณา ไม่สามารถใช้
// รับประกันผลการเล่นหรือระยะเวลาของธุรกรรมได้ในทุกกรณี · แต่ละค่ายกำหนดช่วงเดิมพัน
// ต่างกัน จึงไม่ควรถือว่าทุกเกมไม่มีขั้นต่ำเหมือนกันทั้งหมด · การเป็นเว็บต่างประเทศ
// หรือไม่ผ่านเอเย่นต์เพียงอย่างเดียวไม่ได้รับประกันว่าปลอดภัย 100%
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: banner1/banner1-mobile/og.png เป็นของ glob ที่
// MainLayout ปักไว้ ห้ามอ้างจากหน้า · slide1/slide2 ของดรอปนี้เป็นของ index และ
// /promotion · slide3/slide4/banner2/banner3 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น AnnouncementPremium ทั้งเว็บ (รอบก่อน หวย365 ใช้
// AnnouncementHuay) — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ
// 1SS365 แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรง
// กันทั้งเว็บ
//
// พาเลตต์ 1SS365 (brand-spec §New palette) **ทองนำ เงินโครเมียมรอง บนดำ** เพราะ
// โลโก้เป็นสองโลหะจริง (เหรียญเลข 1 ทอง / ตัวอักษร 1SS เงิน / เลข 365 ทอง) บนพื้นดำ:
// ทองแบรนด์ #edbb23 (ขอบ จุด bullet marker หมึกเน้น) · ทองสว่าง #f7d458 (hover) ·
// ทองอ่อน #ffeeb4 (ต้นไล่เฉด หมึกเน้นใน strong ตัวอักษรปุ่มรอง) · ทองลึก #a87708
// (ขอบจาง ปลายไล่เฉดปุ่มหลัก) · เงินโครเมียม #c8cbce · พื้นลึก #050505 · พื้นการ์ด
// #121010 · พื้นอุ่น #1a1710 (ปุ่มรอง) · ขอบอุ่น #2a2115 · เนื้อความ #f0e6d2
// (BRAND_TEXT)
// ชุดแดง-ทองของ หวย365 (#dc0203 #f5282a #8c0402 #ffc93c #ffeab0 #c08a07 #240406
// #3a0a0c #1a0303 #f6e7e0 rgba(255,201,60,*) rgba(140,4,2,*)) ออกครบทุกจุดแล้ว
// กฎคอนทราสต์: พื้นทอง → หมึกดำ #050505 เสมอ และไล่เฉดปุ่มทองจบที่ #a87708 เท่านั้น
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// — การ์ดตั้งสีเนื้อความ #f0e6d2 ไว้ที่ตัวการ์ดแล้ว ย่อหน้าจึงไม่ใส่คลาสสีซ้ำ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 151
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่นสล็อต ${BRAND_NAME} ด้วยการเปิดข้อมูลเกม ไล่ดูค่ายเกม ช่วงเดิมพันขั้นต่ำและสูงสุด พร้อมโปรโมชั่นที่เข้าเกณฑ์ให้ครบก่อนเริ่มเล่นด้วยเครดิตจริงทุกครั้ง`;

const pageTitle = `ทดลองเล่นสล็อต ${BRAND_NAME} เปิดข้อมูลเกมและช่วงเดิมพันให้ครบก่อนเริ่มเล่นจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed">
        <strong class="text-[#ffeeb4]">{BRAND_NAME}</strong> รวมเกมสล็อตหลายรูปแบบไว้ให้เลือกผ่านบัญชีเดียว
        <strong class="text-[#ffeeb4]">ทั้งสล็อตคลาสสิก ฟรีสปิน ตัวคูณ และเกมโบนัส</strong>
        หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับการเล่นสล็อตออนไลน์ได้ไล่ดูระบบให้ครบหนึ่งรอบ ตั้งแต่การค้นหาเกมตามค่าย ไปจนถึงหน้าข้อมูลของเกมที่สนใจ ก่อนจะตั้งยอดเดิมพันด้วยเครดิตจริง
      </p>

      <p class="text-left text-base leading-relaxed">
        คำว่า ทดลองเล่น ที่หน้านี้พูดถึงจึงหมายถึง
        <strong class="text-[#ffeeb4]">การเปิดข้อมูลเกมและตรวจสอบช่วงเดิมพันก่อนเริ่มเล่นทุกครั้ง</strong>
        ตามที่เว็บไซต์แนะนำไว้เอง ไม่ใช่การรับประกันผลของรอบใดรอบหนึ่ง เมื่อ Login แล้วสมาชิกจะเลือกค่ายเกม เปิดดูเครดิต โปรโมชั่น และย้อนดูประวัติรายการได้จากระบบเดียวทั้งบนมือถือและคอมพิวเตอร์
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`ค่ายเกมและรูปแบบสล็อตของ ${BRAND_NAME} ที่ไล่ดูได้ก่อนเล่นจริง`} as="h2">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed">
        หลัง Login สามารถเลือกเกมสล็อตตามค่ายและช่วงเดิมพันที่ระบบรองรับได้จากบัญชีเดียว
        <strong class="text-[#ffeeb4]">มีทั้งเกมที่เริ่มต้นด้วยยอดต่ำและเกมที่ปรับระดับเดิมพันได้หลายช่วง</strong>
        การเปิดเทียบกันก่อนจึงช่วยให้เห็นว่าเกมแบบไหนเหมาะกับยอดที่ตั้งใจไว้ และควรเริ่มจากรูปแบบที่กติกาอ่านจบได้เร็วที่สุด
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#edbb23]">🎰</span>
          <span>
            <strong class="text-[#ffeeb4]">สล็อตคลาสสิก</strong> เป็นรูปแบบที่อ่านจบได้เร็วที่สุด จึงเหมาะกับการใช้ทำความคุ้นเคยกับหน้าเกม ปุ่มปรับเดิมพัน และตำแหน่งของข้อมูลเกมเป็นรายการแรก
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#edbb23]">🌀</span>
          <span>
            <strong class="text-[#ffeeb4]">ฟรีสปิน</strong> เป็นฟีเจอร์ที่แต่ละเกมกำหนดเงื่อนไขการเข้าถึงไม่เหมือนกัน ควรเปิดข้อมูลเกมอ่านว่ารอบนั้นเริ่มอย่างไรและนับจบอย่างไรก่อนเลือกเกม
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#edbb23]">✖️</span>
          <span>
            <strong class="text-[#ffeeb4]">ตัวคูณ</strong> มีค่าตามเกมและรอบที่กำลังเล่น ไม่ใช่ค่าคงที่ของทั้งเว็บไซต์ จึงควรดูจากหน้าข้อมูลของเกมนั้นโดยตรงแทนการเทียบจากเกมอื่น
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#edbb23]">🎁</span>
          <span>
            <strong class="text-[#ffeeb4]">เกมโบนัส</strong> มีรอบพิเศษที่แยกออกจากรอบปกติ รายละเอียดของรอบนั้นระบุไว้ในหน้าข้อมูลของเกม ควรอ่านให้จบก่อนตั้งยอดเดิมพันครั้งแรก
          </span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed">
        <strong class="text-[#ffeeb4]">แต่ละค่ายสามารถกำหนดช่วงเดิมพันแตกต่างกัน จึงไม่ควรถือว่าทุกเกมไม่มีขั้นต่ำเหมือนกันทั้งหมด</strong>
        หากเปลี่ยนไปเล่นเกมอื่นหรือค่ายอื่น ควรเปิดข้อมูลเกมอ่านซ้ำอีกครั้ง เพราะช่วงเดิมพันที่จำไว้จากเกมก่อนหน้าอาจไม่ใช่ช่วงเดียวกับเกมที่กำลังจะเปิด
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/about-us"
          aria-label={`อ่านหน้าเกี่ยวกับเราของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#a87708]/55 bg-[#1a1710] px-8 py-3 font-bold text-[#ffeeb4] transition-all hover:scale-105 hover:border-[#edbb23] hover:bg-[#121010] hover:text-[#f7d458]">
          อ่านเกี่ยวกับเรา
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="จุดที่ควรตรวจให้ครบก่อนเริ่มเล่นด้วยเครดิตจริง" as="h2">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed">
        การไล่ดูระบบมีประโยชน์ที่สุดเมื่อมองมันเหมือนการอ่านรายละเอียดของเกมนั้นให้จบก่อน
        <strong class="text-[#ffeeb4]">เป้าหมายคือรู้ช่วงเดิมพันและเงื่อนไขของเกมที่จะเล่นให้ครบก่อนที่เครดิตจริงจะเข้ามาเกี่ยวข้อง</strong>
        เรื่องด้านล่างคือสิ่งที่ควรเก็บข้อมูลไว้ระหว่างเปิดดู และควรตรวจซ้ำทุกครั้งที่เปลี่ยนไปเล่นเกมหรือค่ายอื่น
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#edbb23]">🎚️</span>
          <span>
            <strong class="text-[#ffeeb4]">ขั้นต่ำและสูงสุดของเกมนั้นโดยตรง</strong> เป็นสิ่งแรกที่ควรดู เพราะแต่ละค่ายกำหนดช่วงเดิมพันไว้ไม่เท่ากัน การอ่านผิดตรงนี้ทำให้ตั้งยอดไม่ตรงกับที่ตั้งใจไว้ตั้งแต่รอบแรก
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#edbb23]">📖</span>
          <span>
            <strong class="text-[#ffeeb4]">เงื่อนไขของฟีเจอร์ในเกม</strong> ทั้งฟรีสปิน ตัวคูณ และรอบเกมโบนัส ควรอ่านจากหน้าข้อมูลของเกมที่กำลังเปิดอยู่ ไม่ใช่เทียบเอาจากเกมอื่นที่เคยเล่นมาก่อน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#edbb23]">💸</span>
          <span>
            <strong class="text-[#ffeeb4]">โปรโมชั่นที่กำลังเปิดรับและยอดที่เข้าเกณฑ์</strong> ทั้งคืนยอดเสีย โบนัส 0.3% และแนะนำเพื่อน โบนัส 0.8% ควรดูรอบคำนวณ ค่ายเกมที่ร่วมรายการ และเงื่อนไขการใช้โบนัสจากบัญชีของตนเองก่อนกดรับ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#edbb23]">🧾</span>
          <span>
