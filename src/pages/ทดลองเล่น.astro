---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { pageGraph } from "../lib/schema";

// MHEEPOOH168 เป็นเว็บรวมคาสิโนเกมที่รวมบาคาร่า สล็อต หวย และบอลไว้ในระบบเดียว
// หน้านี้จึงเป็นหน้าทดลองเล่นแบบไม่ผูกกับค่ายใดค่ายหนึ่ง — บรีฟรอบนี้ไม่ได้ระบุ
// ชื่อค่ายเกมใดเลย จึงห้ามเอ่ยชื่อค่าย (PG SLOT / Pragmatic / Joker / JILI ของ
// แบรนด์ก่อน ๆ ถูกลบออกทั้งหมด) และห้ามอ้างเลขใบอนุญาต ปีที่ก่อตั้ง จำนวนสมาชิก
// ค่า RTP ชื่อเกมเฉพาะ อัตราจ่ายเป็นตัวเลข หรือการันตีว่าจะชนะ
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: แกลเลอรีเดโม 12 การ์ด (gamedemo7..18.webp) ยังอยู่
// บนดิสก์แต่ไม่ใช่ของกลาง — gamedemo7.webp มีโลโก้ "askmeslot" ของลูกค้าเจ้าอื่น
// พิมพ์ทับกลางรูป ห้ามนำกลับมา import เด็ดขาด (ห้ามลบไฟล์ เป็นอินเวนทอรี)
// ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง
//
// ข้อเท็จจริงทุกบรรทัดมาจาก src/assets/content.txt เท่านั้น:
// เว็บรวมคาสิโนเกมหลายรูปแบบในระบบเดียว ทั้งบาคาร่า สล็อต หวย บอล ·
// ใช้งานได้ทั้งบนมือถือและคอมพิวเตอร์ · ระบบจัดหมวดหมู่เกมชัดเจน แต่ละประเภท
// แยกเป็นเมนู · สลับรูปแบบการเล่นได้จากบัญชีเดียว · มีตัวเลือกจากหลายค่ายและ
// หลายตลาด · โปรโมชั่นสล็อตใช้ได้ทุกเกม ไม่จำกัด: คืนยอดเสีย 0.3% กับแนะนำเพื่อน
// 0.8% แต่ละรายการมีเงื่อนไขแยก ตรวจสอบสิทธิ์ก่อนรับ · รองรับช่องทางธนาคารและ
// วอลเลทที่กำหนดไว้ภายในเว็บไซต์ ตรวจสอบสถานะรายการเองได้ · แอดมิน 24 ชั่วโมง
//
// Announcement รอบนี้หมุนมาใช้ AnnouncementPremium ทั้งเว็บ — default message ของ
// ไฟล์นั้นเป็นข้อความของ MHEEPOOH168 อยู่แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message
//
// พาเลตต์ MHEEPOOH168: ทองสว่าง #fced74 เป็นสีเดียวที่ใช้กับ <strong> และสต็อปบน
// ของเกรเดียนต์ · ทองกลาง #f5b70a เป็นขอบ ไอคอน และตัวเลขลำดับ · ทองเข้ม #8a5a06
// เป็นสต็อปล่าง · แดงเลือดหมู #8f0505 กับแดงเข้ม #2b0101 เป็นผิวยกและตัวอักษรบน
// ปุ่มทอง · แดงลึก #540202 เป็นพื้นตอน hover · เนื้อความครีม #f1dccd
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 152
const pageDescription = "ทดลองเล่นเกมของ MHEEPOOH168 ด้วยเครดิตเสมือนก่อนใช้เครดิตจริง เปิดผ่านเว็บบราว์เซอร์บนมือถือได้ พร้อมวิธีเข้าโหมดทดลอง จุดที่ควรดู และขั้นตอนสมัครสมาชิก";

const graph = pageGraph(Astro, {
  name: "ทดลองเล่น MHEEPOOH168 ด้วยเครดิตเสมือนก่อนลงเครดิตจริง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title="ทดลองเล่น MHEEPOOH168 ฟรี เปิดเล่นบนมือถือ ก่อนใช้เครดิตจริง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่น MHEEPOOH168 ด้วยเครดิตเสมือนก่อนลงเครดิตจริง" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f1dccd]">
        <strong class="text-[#fced74]">MHEEPOOH168</strong> คือเว็บรวมคาสิโนเกมที่รวมความบันเทิงหลายรูปแบบไว้ในระบบเดียว ทั้งบาคาร่า สล็อต หวย และบอล และหน้านี้เปิดไว้ให้คนที่ยังไม่เคยใช้งานมาก่อนได้<strong
          class="text-[#fced74]">
          ลองเปิดเกมด้วยเครดิตเสมือนก่อนตัดสินใจใช้เครดิตจริง
        </strong>
        เพื่อทำความคุ้นเคยกับหน้าตาของเมนู วิธีเข้าแต่ละหมวด และจังหวะการเล่นของเกมที่สนใจ
      </p>

      <p class="text-left text-base leading-relaxed text-[#f1dccd]">
        เครดิตในโหมดทดลองเป็นเครดิตเสมือนสำหรับทำความรู้จักตัวเกมเท่านั้น
        <strong class="text-[#fced74]">ไม่ผูกกับยอดเครดิตจริงในบัญชีสมาชิก และถอนออกมาเป็นเงินจริงไม่ได้</strong>
        สิ่งที่ได้จากหน้านี้คือความเข้าใจในรูปแบบของแต่ละหมวดเกม ฟีเจอร์ที่มี และยอดเดิมพันที่เหมาะกับงบของคุณ ก่อนจะย้ายไปเล่นด้วยเครดิตจริง หากติดปัญหาระหว่างลองเล่น ทักแอดมิน MHEEPOOH168 ผ่าน Line Official
        ได้ตลอด 24 ชั่วโมง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="วิธีเข้าโหมดทดลองเล่น MHEEPOOH168 ทีละขั้นตอนบนมือถือ" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f1dccd]">
        การเข้าโหมดทดลองเล่นใช้เวลาไม่ถึงหนึ่งนาที และเป็นลำดับเดียวกันไม่ว่าคุณจะเปิดจากคอมพิวเตอร์หรือโทรศัพท์มือถือ เพราะระบบ<strong class="text-[#fced74]">
          ออกแบบให้เข้าถึงได้ง่ายทั้งสองอุปกรณ์ และทำงานบนเว็บบราว์เซอร์โดยไม่ต้องติดตั้งแอปพลิเคชัน
        </strong>
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#f1dccd]">
        <li class="flex gap-3">
          <span class="font-bold text-[#f5b70a]">1.</span>
          <span><strong class="text-[#fced74]">เปิดหน้าเว็บ MHEEPOOH168 แล้วดูแถบหมวดหมู่เกม</strong> ระบบจัดหมวดหมู่ไว้ชัดเจน ทั้งบาคาร่า สล็อต หวย และบอล แยกเป็นเมนูของตัวเอง</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#f5b70a]">2.</span>
          <span>
            <strong class="text-[#fced74]">เลือกหมวดที่อยากลองก่อน</strong> ถ้ายังไม่แน่ใจว่าถนัดแบบไหน ให้ไล่เปิดดูทีละหมวด เพราะแต่ละประเภทมีรูปแบบการเล่นและจังหวะต่างกันคนละแบบ
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#f5b70a]">3.</span>
          <span>
            <strong class="text-[#fced74]">เลือกเกมจากรายการที่เปิดให้ใช้งานในหมวดนั้น</strong> ภายในหมวดมีตัวเลือกจากหลายค่ายและหลายตลาด เปิดดูหลายรายการก่อนแล้วค่อยเลือกตัวที่ถูกใจ
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#f5b70a]">4.</span>
          <span>
            <strong class="text-[#fced74]">กดเข้าโหมดทดลองเล่นแล้วอ่านหน้ากติกาของเกมก่อนเริ่ม</strong> ทุกเกมมีหน้าสรุปสัญลักษณ์ ฟีเจอร์ และเงื่อนไขของตัวเอง เปิดดูให้ครบก่อนกดรอบแรก
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#f5b70a]">5.</span>
          <span><strong class="text-[#fced74]">ลองปรับยอดเดิมพันต่อรอบ</strong> ไล่จากยอดต่ำสุดขึ้นไป เพื่อดูว่าทุนเท่าไรอยู่ได้กี่รอบ แล้วค่อยนำจังหวะที่ถนัดไปใช้ตอนเล่นด้วยเครดิตจริง</span>
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#f1dccd]">
        <strong class="text-[#fced74]">รายการเกมที่เปิดให้ใช้งานเปลี่ยนแปลงได้ตามรอบอัปเดต จึงควรตรวจสอบรายการล่าสุดจากหน้าเกมของเว็บไซต์ทุกครั้งก่อนเริ่มเล่น</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title="จุดที่ควรสังเกตระหว่างทดลองเล่น" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f1dccd]">
        โหมดทดลองเล่นมีประโยชน์ที่สุดเมื่อคุณดูมันเหมือนการอ่านคู่มือ ไม่ใช่การลุ้นรางวัล
        <strong class="text-[#fced74]">เป้าหมายคือรู้จักระบบให้ครบก่อนที่เครดิตจริงจะเข้ามาเกี่ยวข้อง</strong> ห้าเรื่องด้านล่างคือสิ่งที่ควรเก็บข้อมูลไว้ระหว่างลองเล่น
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f1dccd]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f5b70a]">🗂️</span>
          <span><strong class="text-[#fced74]">โครงของเมนูและหมวดหมู่</strong> จำให้ได้ว่าหมวดไหนอยู่ตรงไหน และสลับระหว่างบาคาร่า สล็อต หวย และบอล ได้จากจุดใด จะได้ไม่ต้องหาใหม่ตอนเล่นจริง</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f5b70a]">📜</span>
          <span><strong class="text-[#fced74]">กติกาและเงื่อนไขของเกมที่เลือก</strong> แต่ละเกมมีหน้ากติกาของตัวเอง อ่านให้จบว่าตัดสินผลอย่างไร และฟีเจอร์พิเศษเข้าเงื่อนไขใด</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f5b70a]">🎁</span>
          <span>
            <strong class="text-[#fced74]">โปรโมชั่นที่จะได้ตอนเป็นสมาชิก</strong> เปิดหน้าโปรโมชั่นควบคู่ไปด้วย เพื่อดูว่ารายการคืนยอดเสียและแนะนำเพื่อนมีเงื่อนไขและรอบคำนวณอย่างไร
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f5b70a]">📱</span>
          <span><strong class="text-[#fced74]">ความลื่นไหลบนเครื่องของคุณเอง</strong> เปิดจากบราว์เซอร์บนมือถือเครื่องที่ใช้จริง แล้วดูว่าภาพและปุ่มตอบสนองดีไหม จะได้รู้ก่อนว่าเกมไหนเล่นถนัดมือ</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f5b70a]">💡</span>
          <span><strong class="text-[#fced74]">งบที่คุณรับความเสี่ยงได้</strong> ใช้เครดิตทดลองจำลองทุนก้อนที่ตั้งใจจะเติมจริง แล้วสังเกตว่ายอดเดิมพันระดับไหนทำให้เล่นได้นานพอจะสนุก</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#f1dccd]">
        <strong class="text-[#fced74]">ผลของโหมดทดลองเล่นไม่ใช่เครื่องบ่งชี้ผลของการเล่นด้วยเครดิตจริง</strong> เกมตัดสินผลแต่ละรอบแบบสุ่ม ไม่มีสูตร ไม่มีจังหวะ และไม่มีเวลาไหนที่รับประกันว่าจะชนะ ควรกำหนดงบล่วงหน้าและหยุดเมื่อถึงขีดที่ตั้งไว้เสมอ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="สมัครสมาชิก MHEEPOOH168 แล้วเล่นด้วยเครดิตจริงจากบัญชีเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f1dccd]">
        เมื่อคุ้นเคยกับระบบแล้วและอยากลงสนามจริง สมัครสมาชิกแล้วเข้าใช้งานได้ทันที จุดที่ต่างจากโหมดทดลองคือ
        <strong class="text-[#fced74]">สลับรูปแบบการเล่นได้จากบัญชีเดียว</strong> ไม่ต้องเปิดบัญชีแยกตามหมวด เข้าบาคาร่า สล็อต หวย หรือบอล ได้จากเมนูเดียวกันโดยใช้ข้อมูลเข้าใช้งานชุดเดิม
      </p>

      <p class="text-left text-base leading-relaxed text-[#f1dccd]">
        ฝั่งการจัดการเครดิต ระบบ<strong class="text-[#fced74]">รองรับช่องทางธนาคารและวอลเลทที่กำหนดไว้ภายในเว็บไซต์</strong>
        เลือกวิธีที่สะดวกได้ตามรายการที่เปิดให้ใช้งาน และ<strong class="text-[#fced74]">ตรวจสอบสถานะรายการกับยอดผ่านบัญชีของตัวเองได้</strong>
        โดยขั้นตอนถูกจัดวางให้เข้าใจง่าย เหมาะกับทั้งสมาชิกใหม่และผู้ที่ใช้งานเป็นประจำ
      </p>

      <p class="text-left text-base leading-relaxed text-[#f1dccd]">
        เมื่อเป็นสมาชิกแล้วจะกดรับโปรโมชั่นได้ด้วย ทั้ง<strong class="text-[#fced74]">โบนัสคืนยอดเสีย 0.3%</strong>
        ที่ตรวจสอบรอบคำนวณและขั้นตอนรับสิทธิ์ได้จากหน้าโปรโมชั่น และ<strong class="text-[#fced74]">โบนัสแนะนำเพื่อน 0.8%</strong>
        ที่ตรวจสอบข้อมูลโบนัสกับยอดสิทธิ์ได้จากบัญชีสมาชิก โดยแต่ละรายการมีเงื่อนไขแตกต่างกัน ควรตรวจสอบรายละเอียดก่อนกดรับสิทธิ์ทุกครั้ง
      </p>

      <p class="text-left text-base leading-relaxed text-[#f1dccd]">
        <strong class="text-[#fced74]">ตั้งรหัสผ่านที่คาดเดายาก ไม่ใช้รหัสเดียวกับบริการอื่น และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น</strong>
        รวมถึงตรวจสอบให้แน่ใจว่าเป็นบัญชี Line Official ที่ประกาศไว้บนเว็บไซต์ก่อนส่งข้อมูลใด ๆ หากเครดิตไม่เข้าหรือรายการค้าง ให้เปิดดูประวัติรายการในบัญชีก่อนแล้วแจ้งแอดมินพร้อมเวลาและจำนวนเงิน
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก MHEEPOOH168"
          class="flex items-center justify-center rounded-lg border border-[#fced74]/60 bg-gradient-to-r from-[#fced74] via-[#f5b70a] to-[#8a5a06] px-8 py-3 font-black text-[#2b0101] shadow-[0_0_15px_rgba(245,183,10,0.35)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
