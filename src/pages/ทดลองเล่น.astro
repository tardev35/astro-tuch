---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login, /register)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อของ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริง
// ของ SEXYGAME666 เท่านั้น
//
// รอบก่อน (PGW44) ขาย "ค่ายสล็อตย่อย" "เกมคลาสสิก/เกมโบนัส/เกมธีมใหม่" และ
// "สล็อตที่อัปเดตตามช่วงเวลา" ซึ่งบรีฟของ SEXYGAME666 ไม่ได้ระบุเลยสักคำ — ทั้งหมด
// ถูกถอดออกทั้งหน้า และเขียนใหม่บนข้อเท็จจริงของ SEXYGAME666 คือบาคาร่าไลฟ์สดและ
// เกมคาสิโนสดหลายรูปแบบจากผู้ให้บริการต่างประเทศ เมนูค้นหาง่าย และการตรวจรายละเอียด
// ของโต๊ะจากหน้าคาสิโนสดโดยตรง ห้าม find-and-replace ชื่อแบรนด์ทับของเดิม
// มันจะทำให้ SEXYGAME666 อ้างเรื่องค่ายสล็อต ซึ่งเป็นคำของแบรนด์ก่อนหน้า
//
// บรีฟไม่ได้ระบุว่ามีโหมดเดโมหรือเครดิตทดลองที่ถอนไม่ได้ สิ่งที่บรีฟระบุคือ
// "บาคาร่าไลฟ์สด" "โต๊ะเกมและรูปแบบการเดิมพันตามรายการที่เปิดให้บริการ"
// "เกมคาสิโนสดหลายรูปแบบ" "ระบบจัดเมนูให้ค้นหาได้ง่าย" "รองรับมือถือและคอมพิวเตอร์"
// "ตรวจสอบโต๊ะที่กำลังออนไลน์และรายละเอียดของแต่ละเกมได้จากหน้าคาสิโนสด" —
// หน้านี้จึงเขียนบนฐานนั้น คือการไล่ดูเมนู โต๊ะบาคาร่า และรายละเอียดของเกมให้ครบ
// ก่อนเดิมพันด้วยเงินจริง ห้ามอ้างกติกาของเครดิตทดลองหรือโหมดเล่นฟรี
//
// ข้อเท็จจริงทุกบรรทัดมาจากบรีฟรอบนี้เท่านั้น (brand-spec §4): บาคาร่าไลฟ์สด ·
// โต๊ะเกมและรูปแบบการเดิมพันตามรายการที่เปิดให้บริการ · เกมคาสิโนสดหลายรูปแบบ ·
// เมนูค้นหาง่าย · รองรับมือถือและคอมพิวเตอร์ · ตลอด 24 ชั่วโมงตามช่วงเวลาที่ระบบ
// รองรับ · เชื่อมต่อผู้ให้บริการต่างประเทศ · ข่าวสาร เกมใหม่ และโปรโมชั่นที่อัปเดต
// ตามช่วงเวลา · โบนัสแนะนำเพื่อน 0.8% · โบนัสคืนยอดเสีย 0.3% · ยอดที่เข้าเกณฑ์
// รอบรับสิทธิ์ รอบคำนวณ เงื่อนไข · บัญชีสมาชิก · สมัครเองได้ใน 3 ขั้นตอน ·
// ติดต่อเจ้าหน้าที่ 24 ชั่วโมง · บัญชีบริษัทโดยตรง
// — ห้ามอ้าง สล็อต ค่ายสล็อตย่อย หวย บอล เครดิตฟรี ฝากถอนออโต้ ชื่อค่าย/สตูดิโอ
// เจาะจง ชื่อโต๊ะเจาะจง ค่า RTP อัตราจ่าย เลขใบอนุญาต ปีที่ก่อตั้ง จำนวนสมาชิก
// ชื่อธนาคาร ช่องทางฝากถอน หรือการันตีว่าจะชนะ
//
// ศัพท์ช่องทางติดต่อ: บรีฟรอบนี้เขียนหัวข้อไว้ว่า "ติดต่อเจ้าหน้าที่ SEXYGAME666
// ได้ตลอด 24 ชั่วโมง" โดยไม่มีคำว่าไลน์ในหัวข้อ — เนื้อความจึงไม่สร้างข้อความขาย
// รอบคำว่าไลน์ ปุ่ม /line ที่อื่นยังเป็น chrome เดิมและคงป้ายของตัวเองไว้
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: แกลเลอรีเดโม 12 การ์ด (gamedemo7..18.webp) ยังอยู่
// บนดิสก์แต่เป็นของแบรนด์อื่น — gamedemo7.webp มีโลโก้ "askmeslot" และ
// gamedemo15.webp มีโลโก้ "askmebet" ของเว็บเจ้าอื่นพิมพ์ทับอยู่ในรูป ส่วน
// gamedemo13.webp เป็นการ์ด "Sexy Slot" ภาพโป๊เปลือย ห้ามนำกลับมา import เด็ดขาด
// (ห้ามลบไฟล์ เป็นอินเวนทอรี) ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ
// verify-build จะแดง
// slide1.png / slide2.png ของดรอปนี้เป็นของ index และ /promotion — ไม่ดึงมาใช้ซ้ำที่นี่
// banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า
// banner2/banner3/slide3/slide4 เป็นของค้างจากแบรนด์ก่อน ห้าม import
//
// Announcement รอบนี้หมุนจาก Announcement2 มาเป็น Announcement5 ทั้งเว็บ —
// default message ของไฟล์นั้นเป็นคอปปี้ของ SEXYGAME666 แล้ว จึงเรียกแบบ bare
// เหมือน index.astro ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ SEXYGAME666 เป็น **ชมพูบานเย็นนำ + ม่วงตาม บนพื้นเกือบดำอมม่วง** ตามโลโก้
// (SEXY ชมพูบานเย็น / GAME ไล่ไปม่วง / 666 กลับมาเป็นชมพู):
// พื้น #070109 · การ์ด #0f0518 · แผง/ปุ่มรอง #140722 · ขอบ #3d1180 ·
// ชมพูแบรนด์ #fa42b5 · ชมพูสว่าง #ffb3e2 · ชมพูเข้ม #ec3fae · ชมพูลึก #7d1550 ·
// ม่วงแบรนด์ #8b3df3 · ม่วงอ่อน #c9a4ff · ม่วงลึก #4a17a0 ·
// ตัวอักษรบนพื้นชมพู #12041c · เนื้อความ #f2dcee (BRAND_TEXT) · เน้นใน strong #fff2fb
// เลขลำดับใน <ol> และไอคอนใน <ul> สลับชมพู/ม่วงให้คู่สีของโลโก้อ่านออกจากหน้าเอง —
// ชุดทอง/เขียวของ PGW44 (#fde90e #fff89a #f5c518 #a86f02 #35d413 #5df53a #0c6d10
// #1f5a16 #0b1408 #101a0b #10160a #e9f0dd #fbffe8) ถูกแทนครบทุกจุดแล้ว
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลางที่ orchestrator รีธีมรอบนี้) — การ์ดตั้ง
// สีเนื้อความไว้ให้แล้ว ย้ำไว้บนย่อหน้าอีกชั้นเพื่อให้สีของ body copy อ่านออกจาก
// ตัวหน้าเอง และเน้นด้วย #fff2fb ในคำสำคัญ
//
// ไม่มีลิงก์ /ตรวจหวย หรือ /แนวทาง: SEXYGAME666 เป็นเว็บคาสิโนไลฟ์สด สองหน้านั้น
// อยู่ใน src/pages-disabled/ รอบนี้ href ที่ชี้ route ซึ่งไม่มีใน dist/ จะทำให้ build แดง
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 154
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "ทดลองเล่น SEXYGAME666 ไล่ดูโต๊ะบาคาร่าและเกมคาสิโนไลฟ์สดในระบบเดียวให้ครบ พร้อมตรวจรูปแบบการเดิมพันของแต่ละโต๊ะจากหน้าเกมก่อนเริ่มเล่นด้วยเงินจริงทุกครั้ง";

const pageTitle = "ทดลองเล่น SEXYGAME666 ไล่ดูโต๊ะบาคาร่าและเกมไลฟ์สดก่อนเริ่มจริง";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f2dcee]">
        <strong class="text-[#fff2fb]">SEXYGAME666</strong> คือเกมเซ็กซี่บาคาร่าออนไลน์ในรูปแบบไลฟ์สด หน้านี้จึงเปิดไว้ให้คนที่ยังไม่คุ้นกับระบบได้
        <strong class="text-[#fff2fb]">ไล่ดูเมนู โต๊ะบาคาร่า และรายละเอียดของเกมไลฟ์สดให้ครบก่อนเดิมพันด้วยเงินจริง</strong>
        ตั้งแต่โครงของเมนูที่ระบบจัดไว้ให้ค้นหาง่าย ไปจนถึงข้อมูลที่หน้าคาสิโนสดแสดงไว้ก่อนกดเข้าโต๊ะ
      </p>

      <p class="text-left text-base leading-relaxed text-[#f2dcee]">
        เพราะ<strong class="text-[#fff2fb]">ระบบจัดเมนูให้ค้นหาได้ง่ายและรองรับการใช้งานทั้งบนมือถือและคอมพิวเตอร์</strong>
        การเปิดดูให้ทั่วก่อนจึงช่วยให้เห็นว่าโต๊ะบาคาร่าและเกมคาสิโนสดรูปแบบอื่นอยู่ตรงไหน สลับไปยังโต๊ะที่สนใจได้จากจุดใด และต้องตรวจข้อมูลอะไรบ้างก่อนเริ่มเล่นรอบแรก
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ไล่ดูโต๊ะบาคาร่าและเกมคาสิโนสดของ SEXYGAME666 ให้ครบก่อนเลือกโต๊ะแรก" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f2dcee]">
        จุดที่ช่วยให้เริ่มต้นได้เร็วที่สุดคือ<strong class="text-[#fff2fb]">โต๊ะบาคาร่าและเกมคาสิโนสดหลายรูปแบบถูกเชื่อมต่อมาไว้ในระบบเดียว และระบบจัดเมนูให้ค้นหาได้ง่าย</strong>
        สมาชิกเลือกโต๊ะหรือรูปแบบเกมที่สนใจได้ตั้งแต่หน้าคาสิโนสด แล้วเปิดดูรายละเอียดของโต๊ะนั้นต่อได้ก่อนเริ่มเล่น ไม่ต้องเปลี่ยนไปเปิดหลายเว็บไซต์เพื่อไล่หาเกมที่อยากเล่น
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#f2dcee]">
        <li class="flex gap-3">
          <span class="font-bold text-[#fa42b5]">1.</span>
          <span><strong class="text-[#fff2fb]">เปิดหน้าคาสิโนสดของ SEXYGAME666 ก่อน</strong> ระบบจัดเมนูไว้ให้ค้นหาได้ง่ายตั้งแต่หน้าแรก จึงเห็นภาพรวมของโต๊ะที่กำลังออนไลน์และเกมที่เปิดให้เลือกได้ในหน้าเดียว</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#8b3df3]">2.</span>
          <span>
            <strong class="text-[#fff2fb]">ไล่ดูทีละรูปแบบให้ครบ</strong> ทั้งโต๊ะบาคาร่าไลฟ์สดและเกมคาสิโนสดรูปแบบอื่นที่เชื่อมต่อจากผู้ให้บริการต่างประเทศ แต่ละรายการมีรูปแบบการเดิมพันของตัวเองตามที่เปิดให้บริการ
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#fa42b5]">3.</span>
          <span>
            <strong class="text-[#fff2fb]">ตรวจสอบรายละเอียดของเกมจากหน้าคาสิโนสดโดยตรง</strong> แต่ละโต๊ะมีรูปแบบการเดิมพันและรายละเอียดแตกต่างกัน อ่านให้จบก่อนตัดสินใจว่าจะเริ่มจากโต๊ะไหน
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#8b3df3]">4.</span>
          <span>
            <strong class="text-[#fff2fb]">เปิดดูข่าวสาร เกมใหม่ และโปรโมชั่นที่อัปเดตไว้</strong> ทั้งโบนัสแนะนำเพื่อนและโบนัสคืนยอดเสียมีเงื่อนไขและรอบรับสิทธิ์ของตัวเอง ควรตรวจสอบรายละเอียดก่อนกดรับทุกครั้ง
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#fa42b5]">5.</span>
          <span>
            <strong class="text-[#fff2fb]">ลองเปิดจากเครื่องที่จะใช้จริงอีกครั้ง</strong> ระบบรองรับทั้งมือถือและคอมพิวเตอร์ เปิดโต๊ะเดียวกันเทียบกันดูก่อน แล้วเลือกอุปกรณ์ที่ใช้งานได้ถนัดกว่า
          </span>
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#f2dcee]">
        <strong class="text-[#fff2fb]">รายการโต๊ะและเกมที่เปิดให้บริการ เกมใหม่ และโปรโมชั่นที่เปิดรับสิทธิ์เปลี่ยนแปลงได้ตามช่วงเวลา จึงควรตรวจสอบรายละเอียดของเกมจากหน้าคาสิโนสดและข้อมูลจากช่องทางอย่างเป็นทางการของเว็บไซต์ทุกครั้งก่อนเริ่มเล่น</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title="จุดที่ควรตรวจให้ครบก่อนเดิมพันด้วยเงินจริง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f2dcee]">
        การไล่ดูระบบมีประโยชน์ที่สุดเมื่อมองมันเหมือนการอ่านคู่มือ ไม่ใช่การลุ้นรางวัล
        <strong class="text-[#fff2fb]">เป้าหมายคือรู้จักระบบให้ครบก่อนที่เงินจริงจะเข้ามาเกี่ยวข้อง</strong>
        หกเรื่องด้านล่างคือสิ่งที่ควรเก็บข้อมูลไว้ระหว่างเปิดดู
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f2dcee]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fa42b5]">🗂️</span>
          <span>
            <strong class="text-[#fff2fb]">โครงของเมนูที่ระบบจัดไว้ให้ค้นหาง่าย</strong> จำให้ได้ว่าโต๊ะบาคาร่าและเกมคาสิโนสดรูปแบบอื่นอยู่ตรงไหน จะได้ไม่ต้องไล่หาใหม่ทุกครั้งที่อยากเปลี่ยนโต๊ะ
          </span>
        </li>
        <li class="flex gap-3">
