---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";

import { Picture } from "astro:assets";
import { itemList, pageGraph, schemaCtx } from "../lib/schema";
import image1 from "../assets/gamedemo7.webp";
import image2 from "../assets/gamedemo8.webp";
import image3 from "../assets/gamedemo9.webp";
import image4 from "../assets/gamedemo10.webp";
import image5 from "../assets/gamedemo11.webp";
import image6 from "../assets/gamedemo12.webp";
import image7 from "../assets/gamedemo13.webp";
import image8 from "../assets/gamedemo14.webp";
import image9 from "../assets/gamedemo15.webp";
import image10 from "../assets/gamedemo16.webp";
import image11 from "../assets/gamedemo17.webp";
import image12 from "../assets/gamedemo18.webp";

// One list, two consumers: the gallery below and the ItemList in the JSON-LD.
// They used to be two hand-kept arrays that had to stay in the same order, and
// the name shown to a reader could drift from the name handed to a crawler.
// The thumbnails are generic stock demo art shared across brands — the alt text
// describes the picture, never its position in the grid.
const demoGames = [
  { name: "AskmeSlot", src: image1, alt: "แบนเนอร์ค่ายเกม askmeslot โลโก้โพดำสีเหลือง ตัวการ์ตูนเด็กชายสวมหมวกแดงกางแขน ฉากหลังเป็นถนนเมืองยุโรปและกังหันลม" },
  { name: "Popular Game", src: image2, alt: "แบนเนอร์ Popular Game ตัวอักษรสีทอง ตัวการ์ตูนกระต่ายกับแมวสวมแว่นกันแดด หีบสมบัติ ชิปและเหรียญทองกระจายรอบภาพ" },
  { name: "SlotXO", src: image3, alt: "แบนเนอร์ค่ายเกม SlotXO โลโก้รูปตู้สล็อตพร้อมเหรียญ ฉากหลังเป็นนักรบโรมันสวมชุดเกราะยืนหน้าโคลอสเซียม" },
  { name: "Skywind Group", src: image4, alt: "แบนเนอร์ค่ายเกม Skywind Group โลโก้วงกลมสี่สี ฉากหลังเป็นแมวกวักญี่ปุ่นสีขาว ถุงทอง และดอกซากุระ" },
  { name: "PG Soft", src: image5, alt: "แบนเนอร์ค่ายเกม PG Pocket Games Soft โลโก้ตัวอักษรพิกเซลหลากสี ฉากหลังเป็นหญิงสาวสวมเครื่องประดับทองและหมวกขนนก" },
  { name: "SBOBET", src: image6, alt: "แบนเนอร์ค่ายเกม SBOBET โลโก้สีขาวบนพื้นดำ ฉากหลังเป็นตัวการ์ตูนหญิงสาวผมบลอนด์ชุดสีชมพูถืออมยิ้ม" },
  { name: "Sexy Slot", src: image7, alt: "แบนเนอร์เกม Sexy Slot ตัวอักษรสีชมพูม่วง ฉากหลังเป็นตัวการ์ตูนหญิงสาวชุดสีน้ำเงินนั่งอยู่ในกรอบวงกลมพร้อมรูปหัวใจ" },
  { name: "JILI", src: image8, alt: "แบนเนอร์ค่ายเกม JILI ตัวอักษรสีทอง ฉากหลังเป็นตัวการ์ตูนนางเงือกผมสีแดงถือหอยสังข์อยู่ใต้ท้องทะเล" },
  { name: "Ask Me Bet", src: image9, alt: "แบนเนอร์ค่ายเกม ask me bet โลโก้สีเขียวเหลือง ฉากหลังเป็นหัวสิงโตเชิดสีแดงทองและโคมไฟจีน" },
  { name: "New Game", src: image10, alt: "แบนเนอร์ New Game ตัวอักษรสีขาวสามมิติ ตัวการ์ตูนฟักทองสวมหมวกและโครงกระดูกยืนสองข้าง พร้อมอัญมณีและชิปหลากสี" },
  { name: "JOKER", src: image11, alt: "แบนเนอร์ค่ายเกม JOKER ตัวอักษรสีขาวทอง ฉากหลังเป็นนักรบโรมันสวมหมวกเกราะยืนคู่กับสิงโตในสนามประลอง" },
  { name: "AFB Gaming", src: image12, alt: "แบนเนอร์ค่ายเกม AFB Gaming ตัวอักษรสีทอง ฉากหลังเป็นเทพเจ้าเคราขาวสวมมงกุฎใบไม้ยืนอยู่หน้าวิหารกรีก" },
];

// The URL each entry resolves to is schema.ts's problem, not this file's — an
// older version pasted a hand-built page URL onto all 12 and got the trailing
// slash and the Thai encoding wrong on every one of them.
const gameList = demoGames.map((game) => ({ name: game.name, imagePath: game.src.src }));

// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char).
const pageDescription =
  "ทดลองเล่นสล็อตฟรีกับ DARK168 เว็บดาร์คสล็อตเจ้าของเกมแท้ ค่ายหลักเว็บตรง ลองฟีเจอร์และอัตราเดิมพันบนมือถือ แท็บเล็ต และคอมพิวเตอร์ ก่อนสมัครและปั่นด้วยเงินจริง";

const ctx = schemaCtx(Astro);
const graph = pageGraph(Astro, {
  type: "CollectionPage",
  name: "ทดลองเล่นสล็อตฟรี DARK168 ลองระบบก่อนสมัครสมาชิก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
  extra: [
    itemList(ctx, {
      name: "รายการค่ายเกมสล็อตที่เปิดให้ทดลองเล่นบน DARK168",
      alternateName: "DARK168 โหมดทดลองเล่นสล็อตจากค่ายหลักเว็บตรง ก่อนสมัครสมาชิกและปั่นด้วยเครดิตจริง",
      itemType: "Game",
      items: gameList,
    }),
  ],
});
---

<MainLayout title="ทดลองเล่นสล็อตฟรี DARK168 ลองระบบค่ายหลักก่อนสมัครสมาชิก" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่นสล็อตฟรี DARK168 ลองระบบก่อนสมัครสมาชิก" as="h1">
    <p class="text-left text-base leading-relaxed text-[#ece3d1]">
      DARK168 เว็บดาร์คสล็อตเจ้าของเกมแท้ เปิดให้ลองเปิดหน้าเกมสล็อตจากค่ายหลักเว็บตรงได้ทั้งบนมือถือ แท็บเล็ต และคอมพิวเตอร์ ภายในบัญชีเดียว
      เพื่อดูหน้าตาเกม ฟีเจอร์พิเศษ อัตราเดิมพัน และความลื่นไหลของระบบก่อนตัดสินใจสมัครสมาชิกและฝากเครดิตปั่นด้วยเงินจริง สมาชิกที่เปิดบัญชีแล้วยังติดตามโปรโมชั่น
      แนะนำเพื่อนรับโบนัส 0.8% คืนยอดเสียทุกวัน 0.3% และสิทธิ์อื่นตามเงื่อนไขของแต่ละรายการได้ พร้อมระบบฝากถอนอัตโนมัติ การันตีไม่ล็อคยูส
      และแอดมิน DARK168 ดูแลตลอด 24 ชั่วโมง ตั้งแต่ขั้นตอนสมัครสมาชิกไปจนถึงการใช้งานภายในระบบ
    </p>
  </ContentBox>

  <ContentBox title="วิธีเข้าทดลองเล่นสล็อตกับ DARK168" as="h2">
    <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#ece3d1]">
      <li class="flex gap-3"><span class="font-bold text-[#f6dfa4]">1.</span> สมัครสมาชิก DARK168 และกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน</li>
      <li class="flex gap-3"><span class="font-bold text-[#f6dfa4]">2.</span> เลือกค่ายเกมสล็อตและหมวดหมู่เกมที่ต้องการจากรายการด้านล่าง</li>
      <li class="flex gap-3"><span class="font-bold text-[#f6dfa4]">3.</span> กดปุ่ม "เล่นเลย" เพื่อเปิดขั้นตอนสมัครสมาชิกแล้วเข้าเล่นเกมนั้นได้ทันที</li>
    </ol>
  </ContentBox>

  <ContentBox title="ค่ายเกมสล็อตหลักที่ DARK168 เปิดให้ทดลองเล่น" as="h2">
    <div class="grid grid-cols-2 gap-5 sm:grid-cols-2 md:grid-cols-4">
      {
        demoGames.map((game) => (
          <div class="group/game relative mx-auto w-full max-w-[400px] overflow-hidden rounded-xl">
            <Picture
              src={game.src}
              alt={game.alt}
              loading="lazy"
              fetchpriority="low"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 100vw, 25vw"
              class="block h-auto w-full object-cover shadow-[0_10px_30px_rgba(230,183,78,0.18)] transition-transform duration-300 group-hover/game:scale-105"
              decoding="async"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
            <a
              href="/register"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`สมัครสมาชิกเพื่อเล่น ${game.name} ที่ DARK168`}
              class="absolute inset-0 flex items-center justify-center bg-[#050505]/80 opacity-0 transition-opacity duration-300 group-hover/game:opacity-100 focus-visible:opacity-100">
              <span class="rounded-full border border-[#8a6320]/70 bg-gradient-to-r from-[#c8cfd8] via-[#f6dfa4] to-[#e6b74e] px-6 py-2 font-bold text-[#131009] shadow-[0_10px_30px_rgba(200,207,216,0.30)] transition-transform hover:scale-110">
                เล่นเลย
              </span>
            </a>
          </div>
        ))
      }
    </div>
  </ContentBox>

  <ContentBox title="ศึกษากติกาและกำหนดงบประมาณก่อนปั่นด้วยเครดิตจริง" as="h2">
    <ul class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#ece3d1]">
      <li class="flex gap-3"><span class="text-[#f6dfa4]" aria-hidden="true">•</span> โหมดทดลองใช้เครดิตทดลอง ไม่ใช่เงินจริง และถอนไม่ได้</li>
      <li class="flex gap-3">
        <span class="text-[#f6dfa4]" aria-hidden="true">•</span> การพนันมีความเสี่ยงและไม่สามารถรับประกันผลกำไรได้ ควรศึกษากติกา ฟีเจอร์ และอัตราเดิมพันของแต่ละเกม พร้อมกำหนดงบประมาณของตัวเองให้ชัดเจนก่อนเดิมพันทุกครั้ง
      </li>
      <li class="flex gap-3">
        <span class="text-[#f6dfa4]" aria-hidden="true">•</span> โบนัสแนะนำเพื่อน 0.8% และคืนยอดเสียทุกวัน 0.3% คำนวณตามยอดและเงื่อนไขของแต่ละรายการ ควรตรวจสอบเปอร์เซ็นต์ รอบคำนวณ และข้อกำหนดการถอนก่อนกดรับสิทธิ์
      </li>
      <li class="flex gap-3">
        <span class="text-[#f6dfa4]" aria-hidden="true">•</span> ฝากถอนผ่านระบบอัตโนมัติตามช่องทางที่เว็บไซต์เปิดให้บริการเท่านั้น ตรวจสอบชื่อบัญชีและรายละเอียดให้ถูกต้องก่อนยืนยันรายการ
      </li>
      <li class="flex gap-3"><span class="text-[#f6dfa4]" aria-hidden="true">•</span> เข้าใช้งานผ่านทางเข้าจริงของ DARK168 ที่เชื่อมต่อ HTTPS เท่านั้น และติดต่อแอดมินได้ตลอด 24 ชั่วโมงเมื่อพบปัญหา</li>
    </ul>
  </ContentBox>

  <Navfoot />
</MainLayout>
