---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { pageGraph } from "../lib/schema";

// HENG38 เป็นเว็บสล็อต ไม่ใช่เว็บหวย — บรีฟรอบนี้ (ดรอป 2026-09-22 "HENG38
// เว็บรวมสล็อตใหญ่ เกมแท้ค่ายดัง ส่งตรงจากบริษัทแม่") พูดถึงสล็อตอย่างเดียว
// ห้ามเอ่ยหวย รอบหวย ประเภทเลข หรืออัตราจ่ายต่อเลข 2 ตัว/3 ตัว และคอปปี้ของ
// แบรนด์รอบก่อน (หวยพยัคฆ์ "รัฐบาลไทย ฮานอย ลาวพัฒนา จ่ายเต็ม") ถูกเขียนใหม่
// ทั้งหน้าแล้ว ไม่เหลือประโยคเดิม
//
// บรีฟรอบนี้ไม่ได้ระบุว่ามี "เครดิตทดลอง" หรือโหมดเดโมที่ถอนไม่ได้ สิ่งที่บรีฟระบุคือ
// "เปิดเกมและสลับค่ายทำได้จากหน้าเดียว" กับ "ก่อนเข้าเล่นสามารถตรวจสอบชื่อค่าย
// รายละเอียดเกม และข้อมูลที่เกี่ยวข้องได้จากหน้าระบบ" และ "ตรวจสอบขั้นต่ำและ
// รายละเอียดเดิมพันของเกมที่สนใจก่อนเข้าเล่นได้จากหน้าเกมโดยตรง" — หน้านี้จึง
// เขียนบนฐานนั้น คือการไล่ดูระบบและรายละเอียดเกมก่อนเดิมพันด้วยเงินจริง
// ห้ามกลับไปอ้างกติกาของเครดิตทดลองหรือโหมดเล่นฟรี
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: แกลเลอรีเดโม 12 การ์ด (gamedemo7..18.webp) ยังอยู่
// บนดิสก์แต่เป็นของแบรนด์อื่น (mtime 2026-08-04 ไม่ใช่ดรอปรอบนี้) — gamedemo7.webp
// มีโลโก้ "askmeslot" และ gamedemo15.webp มีโลโก้ "askmebet" ของเว็บเจ้าอื่น
// พิมพ์ทับอยู่ในรูป ส่วน gamedemo13.webp เป็นการ์ด "Sexy Slot" ภาพโป๊เปลือย
// ห้ามนำกลับมา import เด็ดขาด (ห้ามลบไฟล์ เป็นอินเวนทอรี) ลำพังการ import ก็ทำให้
// ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง
// slide1.png / slide2.png ของดรอปนี้เป็นของ index และ /promotion — ไม่ดึงมาใช้ซ้ำที่นี่
//
// ข้อเท็จจริงทุกบรรทัดมาจากบรีฟรอบนี้เท่านั้น: รวมเกมแท้จากค่ายดังไว้ในระบบเดียว ·
// มีทั้งเกมยอดนิยม เกมใหม่ และสล็อตหลายรูปแบบ · เมนูจัดหมวดหมู่ชัดเจน ใช้งานได้
// ทั้งมือถือและคอมพิวเตอร์ · ระบบ API เชื่อมเกมจากค่ายตามที่เว็บไซต์ระบุ เปิดเกม
// และสลับค่ายได้จากหน้าเดียว ส่งตรงจากบริษัทแม่ · ตรวจสอบชื่อค่าย รายละเอียดเกม
// และข้อมูลที่เกี่ยวข้องได้จากหน้าระบบ · เกมแต่ละรายการรองรับเดิมพันเริ่มต้นต่างกัน
// ตามที่แต่ละค่ายกำหนด ตรวจสอบขั้นต่ำได้จากหน้าเกม · รายการเกมอาจอัปเดตตามช่วงเวลา ·
// โบนัสแนะนำเพื่อน 0.8% · โบนัสคืนยอดเสีย 0.3% · สมัครเองได้ใน 3 ขั้นตอน ·
// แอดมินออนไลน์ 24 ชั่วโมง
// — ห้ามอ้างชื่อค่ายที่บรีฟไม่ได้ระบุ เลขใบอนุญาต ปีที่ก่อตั้ง จำนวนสมาชิก ค่า RTP
// เปอร์เซ็นต์แตก "ปลอดภัย 100%" หรือการันตีว่าจะชนะ
//
// Announcement รอบนี้หมุนมาใช้ AnnouncementPremium ทั้งเว็บ — default message ของ
// ไฟล์นั้นเป็นข้อความของ HENG38 อยู่แล้ว จึงเรียกแบบ bare เหมือน index.astro
// ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ HENG38 (มรกต + ทอง แทนกรมท่า + ทองของ หวยพยัคฆ์):
// พื้น #03140a · การ์ด #061f0f · ผิวยก #0a2d16 · ขอบบรอนซ์ #a5761a ·
// ทองหลัก #f3cf63 ใช้กับเลขลำดับ ไอคอน และสต็อปกลางของเกรเดียนต์ ·
// ทองสว่าง #fbeeb0 เป็นสต็อปบน · เนื้อความ #e6e2d2 · <strong> #f3cf63 ·
// ตัวอักษรบนปุ่มทอง #03140a · เงาลึก rgba(3,20,10,α) · ออร่าทอง rgba(243,207,99,α)
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 157
const pageDescription = "ทดลองเล่น HENG38 ไล่ดูเมนูรวมเกมสล็อตจากค่ายดังก่อนเดิมพันจริง ทั้งวิธีเลือกค่าย การเปิดดูรายละเอียดเกม และการตรวจสอบเงื่อนไขเดิมพันเริ่มต้นของแต่ละเกมในระบบ";

const graph = pageGraph(Astro, {
  name: "ทดลองเล่น HENG38 ไล่ดูเกมสล็อตและค่ายดังก่อนเดิมพันจริง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title="ทดลองเล่น HENG38 ไล่ดูเกมสล็อตและค่ายดังก่อนเดิมพันจริง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่น HENG38 ไล่ดูเกมสล็อตและค่ายดังก่อนเดิมพันจริง" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e6e2d2]">
        <strong class="text-[#f3cf63]">HENG38</strong> รวมเกมแท้จากค่ายดังไว้ในระบบเดียว ทั้งเกมยอดนิยม เกมใหม่ และสล็อตหลายรูปแบบ หน้านี้จึงเปิดไว้ให้คนที่ยังไม่คุ้นกับระบบได้
        <strong class="text-[#f3cf63]">ไล่ดูค่ายที่เปิดให้ใช้งาน เปิดรายละเอียดของเกมที่สนใจ และตรวจสอบเงื่อนไขเดิมพันเริ่มต้นก่อนเข้าเล่นด้วยเงินจริง</strong>
        ตั้งแต่โครงของเมนูรวมเกม ไปจนถึงข้อมูลที่ระบบแสดงไว้ในแต่ละหน้าเกม
      </p>

      <p class="text-left text-base leading-relaxed text-[#e6e2d2]">
        เพราะ<strong class="text-[#f3cf63]">รายการเกมภายในระบบอาจอัปเดตตามช่วงเวลา</strong>
        การเปิดดูหน้ารวมเกมก่อนจึงช่วยให้เห็นว่าช่วงนั้นมีค่ายและเกมอะไรให้เลือกบ้าง และรู้ล่วงหน้าว่าต้องดูข้อมูลอะไรบ้างก่อนกดเข้าเล่นครั้งแรก
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ไล่ดูเกมสล็อตของ HENG38 ได้จากหน้าเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e6e2d2]">
        จุดที่ช่วยให้ไล่ดูเกมได้เร็วที่สุดคือ<strong class="text-[#f3cf63]">ทุกค่ายถูกรวมไว้ในระบบเดียว</strong>
        ระบบ API เชื่อมต่อเกมจากค่ายตามที่เว็บไซต์ระบุ การเปิดเกมและสลับค่ายจึงทำได้จากหน้าเดียว ไม่ต้องสลับหลายเว็บไซต์เพื่อไล่หาว่าเกมที่สนใจอยู่ที่ไหน และเมื่อเจอเกมที่ต้องการแล้วยังเปิดดูรายละเอียดกับเงื่อนไขเดิมพันได้จากจุดเดียวกัน
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#e6e2d2]">
        <li class="flex gap-3">
          <span class="font-bold text-[#f3cf63]">1.</span>
          <span><strong class="text-[#f3cf63]">เปิดหน้าเว็บของ HENG38 แล้วดูหน้ารวมเกม</strong> เกมทั้งหมดถูกจัดหมวดหมู่ไว้ในที่เดียว จึงเห็นภาพรวมของค่ายที่เปิดให้ใช้งานได้ทันที</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#f3cf63]">2.</span>
          <span>
            <strong class="text-[#f3cf63]">เลือกค่ายเกมที่สนใจ</strong> ภายในระบบมีทั้งเกมยอดนิยม เกมใหม่ และสล็อตหลายรูปแบบ ถ้ายังไม่แน่ใจว่าถนัดแนวไหน ให้ไล่เปิดดูทีละค่ายก่อน
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#f3cf63]">3.</span>
          <span>
            <strong class="text-[#f3cf63]">เปิดรายละเอียดของเกมที่เลือก</strong> ก่อนเข้าเล่นสามารถตรวจสอบชื่อค่าย รายละเอียดเกม และข้อมูลที่เกี่ยวข้องได้จากหน้าระบบ
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#f3cf63]">4.</span>
          <span>
            <strong class="text-[#f3cf63]">ตรวจสอบเงื่อนไขเดิมพันเริ่มต้นของเกมนั้น</strong> เกมแต่ละรายการรองรับการเดิมพันเริ่มต้นในระดับต่างกันตามที่แต่ละค่ายกำหนด ดูขั้นต่ำได้จากหน้าเกมโดยตรง
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#f3cf63]">5.</span>
          <span>
            <strong class="text-[#f3cf63]">ทวนข้อมูลอีกครั้งก่อนกดเข้าเล่นด้วยเงินจริง</strong> ทั้งค่าย ชื่อเกม และยอดเดิมพันที่ตั้งไว้ ขั้นตอนนี้คือจุดที่ลดความผิดพลาดได้มากที่สุด
          </span>
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#e6e2d2]">
        <strong class="text-[#f3cf63]">รายการเกมที่เปิดให้ใช้งานเปลี่ยนแปลงได้ตามช่วงเวลา จึงควรตรวจสอบค่ายและเกมล่าสุดจากหน้ารวมเกมของเว็บไซต์ทุกครั้งก่อนเข้าเล่น</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title="จุดที่ควรดูให้ครบก่อนเดิมพันด้วยเงินจริง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e6e2d2]">
        การไล่ดูระบบมีประโยชน์ที่สุดเมื่อมองมันเหมือนการอ่านคู่มือ ไม่ใช่การลุ้นรางวัล
        <strong class="text-[#f3cf63]">เป้าหมายคือรู้จักระบบให้ครบก่อนที่เงินจริงจะเข้ามาเกี่ยวข้อง</strong>
        ห้าเรื่องด้านล่างคือสิ่งที่ควรเก็บข้อมูลไว้ระหว่างเปิดดู
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#e6e2d2]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f3cf63]">🗂️</span>
          <span>
            <strong class="text-[#f3cf63]">โครงของเมนูและการจัดหมวดหมู่เกม</strong> จำให้ได้ว่าค่ายไหนอยู่ตรงไหน และสลับไปดูเกมของอีกค่ายได้จากจุดใด จะได้ไม่ต้องหาใหม่ทุกครั้งที่อยากเปลี่ยนเกม
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f3cf63]">🎰</span>
          <span>
            <strong class="text-[#f3cf63]">รายละเอียดของเกมที่สนใจ</strong> ก่อนเข้าเล่นสามารถตรวจสอบชื่อค่าย รายละเอียดเกม และข้อมูลที่เกี่ยวข้องได้จากหน้าระบบ เปิดดูให้ครบก่อนตัดสินใจ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f3cf63]">🎯</span>
          <span>
            <strong class="text-[#f3cf63]">เงื่อนไขเดิมพันเริ่มต้นของแต่ละเกม</strong> เกมหลายรายการรองรับการเดิมพันเริ่มต้นในระดับต่างกันตามที่แต่ละค่ายกำหนด ตรวจสอบขั้นต่ำจากหน้าเกมก่อนเสมอ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f3cf63]">🎁</span>
          <span>
            <strong class="text-[#f3cf63]">เงื่อนไขของโปรโมชั่นที่จะกดรับ</strong> ทั้งโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% มีเงื่อนไขและวิธีรับสิทธิ์ต่างกัน ควรเปิดดูรายละเอียดจากหน้าโปรโมชั่นก่อนกดรับ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f3cf63]">💡</span>
          <span><strong class="text-[#f3cf63]">งบที่คุณรับความเสี่ยงได้</strong> ตั้งวงเงินต่อรอบไว้ล่วงหน้า แล้วดูว่าระดับไหนทำให้เล่นได้โดยไม่กระทบค่าใช้จ่ายอื่น</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#e6e2d2]">
        <strong class="text-[#f3cf63]">ผลของเกมสล็อตตัดสินจากระบบของค่ายเกมนั้น ไม่มีสูตร ไม่มีเกมใด และไม่มีช่วงเวลาไหนที่รับประกันว่าจะชนะ</strong>
        ข้อมูลที่เก็บได้จากการเปิดดูระบบช่วยให้เลือกเกมและระดับเดิมพันที่เหมาะกับตัวเองเท่านั้น ไม่ได้ชี้ผลของรอบถัดไป จึงควรกำหนดงบล่วงหน้าและหยุดเมื่อถึงขีดที่ตั้งไว้เสมอ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="แอดมิน HENG38 ออนไลน์ 24 ชั่วโมง ติดต่อได้ทันที" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e6e2d2]">
        หากติดปัญหาระหว่างใช้งาน ไม่ว่าจะเป็น<strong class="text-[#f3cf63]">การสมัคร การเข้าเกม โปรโมชั่น ระบบเครดิต หรือการใช้งานภายในเว็บไซต์</strong>
        สามารถติดต่อแอดมิน HENG38 ได้ตลอด 24 ชั่วโมง ทีมงานพร้อมช่วยตรวจสอบข้อมูลและแนะนำขั้นตอนตามปัญหาที่แจ้ง
      </p>

      <p class="text-left text-base leading-relaxed text-[#e6e2d2]">
        เวลาแจ้งปัญหาเข้ามา ควรระบุชื่อค่ายและเกมที่เล่นอยู่ เวลาที่เกิดปัญหา และรายละเอียดของรายการให้ครบ เพื่อให้ทีมงานตรวจสอบตามข้อมูลที่แจ้งได้เร็วขึ้น
        <strong class="text-[#f3cf63]">และควรยึดตามยอดและสถานะที่ระบบแสดง ณ เวลาที่ทำรายการเป็นหลัก</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title="สมัคร HENG38 ได้เองใน 3 ขั้นตอน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e6e2d2]">
