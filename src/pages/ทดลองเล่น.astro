---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login,
// /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx
// ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บน
// ข้อเท็จจริงของ หวย24 เท่านั้น (src/assets/content.txt)
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก NavbarStyle10 (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// หวย24 เป็น **เว็บแทงหวยออนไลน์** แง่มุมที่บรีฟระบุไว้มีเท่านี้: รวมรายการและแนวทาง
// หวยไว้ให้ติดตามผ่านมือถือ ทั้งหวยลาว หวยฮานอย และรัฐบาลไทย · ข้อมูลรอบเปิดรับ
// อัตราจ่าย และผลรางวัล · เลือกเลขเด็ด เลขดัง หรือชุดตัวเลขที่สนใจแล้วตรวจสอบ
// รายละเอียดก่อนส่งโพย · ตรวจสอบวงเงินและส่งโพยผ่านระบบ ดูยอดเดิมพันและอัตราจ่าย
// ก่อนยืนยัน · อัตราของรายการที่เข้าเงื่อนไข 2 ตัว จ่าย 100 บาท / 3 ตัว จ่าย 1,000
// บาท ซึ่งอาจต่างตามประเภทหวย รูปแบบการแทง และรอบ · เลข 3 ตัวมีหลายรูปแบบและไม่ได้
// ใช้อัตราเดียวกันเสมอ · เลขที่มียอดเดิมพันสูงอาจมีวงเงินรับต่างจากเลขทั่วไป ·
// สมัคร 3 ขั้นตอน · ผลรางวัล · ประวัติโพย · แอดมิน 24 ชั่วโมง · PIN · OTP
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามี "โหมดทดลอง" เครดิตทดลอง หรือหวยเดโมเป็นบริการของเว็บ —
// จึงห้ามสัญญาสินค้าตัวนั้น และห้ามดึง src/assets/gamedemo*.webp กลับมา (ไฟล์ชุดนั้น
// เป็นอินเวนทอรีเก่า ไม่ใช่อาร์ตเวิร์กของดรอปนี้) หน้านี้จึงไม่มีรูปและไม่มีกริดเกม
// เดโม โดยตั้งใจ — ตัวหน้าเป็นบทความล้วน
// สิ่งที่บรีฟระบุไว้ตรง ๆ ว่าควรทำก่อนยืนยันคือ "ตรวจสอบรายละเอียดก่อนส่งโพย" และ
// "ดูยอดเดิมพันและอัตราจ่ายก่อนยืนยันรายการ" = ไล่เปิดหน้าส่งโพยให้ครบหนึ่งรอบก่อน
// เดิมพันจริง ไม่ใช่การเล่นฟรี
//
// ⚠️ แบรนด์ก่อนหน้าของหน้านี้คือ หวยคิง (เว็บหวยอีกเจ้าที่ไม่เกี่ยวกัน) คอปปี้ชุดนั้น
// เขียนบนบรีฟคนละฉบับ ข้อขายของมันไม่มีในบรีฟรอบนี้ จึงห้ามหลงเหลือ: "บาทละ 1,000" ·
// "เว็บแม่" · "จ่ายไม่อั้น" · "ยอดฝากเข้าบริษัทโดยตรง" · ชื่อนิติบุคคล · บัญชีบริษัท ·
// เครดิต/วอลเลท/ธนาคาร (บรีฟรอบนี้ไม่เอ่ยเรื่องธุรกรรมเลย พูดได้แค่ว่าปัญหาด้าน
// ธุรกรรมควรเก็บหลักฐาน เวลา และจำนวนเงินไว้ตรวจสอบ)
// ก่อนหน้า หวยคิง เคยเป็น UP555 ซึ่งเป็นคาสิโน คำชุดนั้นยิ่งห้ามโผล่: สล็อต บาคาร่า
// บอล ค่ายเกม คาสิโนสด หมวดเกม RTP ความผันผวน คืนยอดเสีย แนะนำเพื่อน เว็บตรง
// หน้านี้เขียนขึ้นใหม่จากบรีฟ ไม่ใช่ find-and-replace ทับประโยคเดิม
//
// ตัวเลขที่อ้างได้มีแค่ 2 ตัว / 3 ตัว / 100 / 1,000 / 3 ขั้นตอน / 24 ชั่วโมง
// รายการหวยที่เอ่ยได้มีสามชื่อ คือ ลาว · ฮานอย · รัฐบาลไทย ห้ามเติมตลาดอื่น
// (ลาวพัฒนา หวยหุ้น ยี่กี) ห้ามแต่งเวลาเปิด-ปิดรับของรอบ ชื่อธนาคาร เลขใบอนุญาต
// ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีที่ก่อตั้ง เพราะบรีฟไม่ได้เอ่ยไว้
//
// ประโยคกำกับของบรีฟที่ห้ามตัดทิ้ง: คำว่า "รับไม่อั้น" และ "จ่ายเต็มทุกโพย" ควรยึด
// วงเงินและเงื่อนไขจริงที่ระบบแสดง · แนวทางหวยและเลขดังเป็นข้อมูลประกอบ ไม่รับประกัน
// ผลรางวัลรอบถัดไป · ถ้าไม่มีข้อมูลเปรียบเทียบที่ตรวจสอบได้ คำว่า "เรทจ่ายสูง"
// เหมาะกว่า "เรทจ่ายสูงที่สุด" · เว็บไซต์เข้าใช้งานได้ 24 ชั่วโมง แต่เวลารับแทงจริง
// ขึ้นอยู่กับกำหนดเปิดและปิดของหวยแต่ละรอบ · ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: banner1/banner1-mobile/og.png เป็นของ glob ที่
// MainLayout ปักไว้ ห้ามอ้างจากหน้า · slide1/slide2 ของดรอปนี้เป็นของ index และ
// /promotion · slide3/slide4/banner2/banner3 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น Announcement3 ทั้งเว็บ (รอบก่อน หวยคิง ใช้ AnnouncementHuay)
// — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ หวย24 แล้ว จึงเรียก
// แบบ bare ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ หวย24 (brand-spec §2) **แดงแบรนด์เป็นสีหลัก ทองเป็นสีรอง บนดำอมแดง**
// เพราะโลโก้เป็นวงกลมแดงมีเลข 24 สีขาว กับตัวอักษร หวย24 ที่ "24" เป็นสีแดง และ
// แบนเนอร์เป็นผ้าไหมแดงบนพื้นดำกับเหรียญทอง: แดงแบรนด์ #d20a0a (ขอบ ปุ่มรอง glow) ·
// แดงสว่าง #ff5c5c (hover) · แดงลึก #7a0505 / #2a0606 (พื้นยก hover ของปุ่มรอง) ·
// ทองแบรนด์ #f5c33b (ไอคอน bullet marker) · ทองสว่าง #ffd45e (หมึก strong + กลาง
// ไล่เฉดปุ่มหลัก) · ทองลึก #a9761a (สองปลายไล่เฉดปุ่มหลัก) · พื้นลึกสุด #0a0303
// (ปุ่มรอง) · หมึกบนปุ่มทอง #1a0303 · เนื้อความ #f7e2d6 (BRAND_TEXT) ·
// glow เป็น rgba(210,10,10,α) / rgba(245,195,59,α)
// ชุดทองโลหะ + ครีมอมพีชของ หวยคิง (#cd9a2c #fdeb7c #ab7314 #fcd4c3 #fce2d4 #1c140b
// #0c0b0a #5c3f12 #120a02 #f5e7c8 rgba(205,154,44,*) rgba(12,11,10,*)) ออกครบทุกจุด
// แล้ว ทั้งคลาส Tailwind raw hex และ rgba()
// กฎคอนทราสต์: พื้นทองสว่าง → หมึก #1a0303 เสมอ และปุ่มรองเป็น "ขอบแดง/ทองบนพื้น
// ดำอมแดง" ไม่ใช่ถมทองอีกใบ
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// — การ์ดตั้ง text-left text-base leading-relaxed text-[#f7e2d6] ไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าจึงไม่ถือคลาสของตัวเอง ใส่สีเฉพาะที่ <strong>
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 156 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} ด้วยการไล่ดูขั้นตอนเลือกรายการหวยและรอบ กรอกเลขเด็ด เลขดัง แล้วอ่านอัตราจ่ายกับวงเงินรับแทงบนหน้าส่งโพยให้ครบก่อนยืนยัน พร้อมสมัคร 3 ขั้นตอน`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ไล่ดูขั้นตอนเลือกหวย รอบ และอัตราจ่ายก่อนส่งโพย`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#ffd45e]">{BRAND_NAME}</strong> รวบรวมรายการและแนวทางหวยไว้ให้ติดตามผ่านมือถือ
        <strong class="text-[#ffd45e]">ทั้งหวยลาวตามรอบที่เปิดรับ หวยฮานอยหลายช่วงเวลา และรัฐบาลไทยตามกำหนดออกรางวัล</strong>
        หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับระบบได้ไล่ดูหน้าจอให้ครบหนึ่งรอบ ตั้งแต่การเลือกรายการและรอบ ไปจนถึงหน้าส่งโพยที่แสดงอัตราจ่ายและวงเงินรับแทง ก่อนจะยืนยันรายการจริง
      </p>

      <p>
        คำว่า ทดลองเล่น ที่หน้านี้พูดถึงจึงหมายถึง
        <strong class="text-[#ffd45e]">การเลือกเลขเด็ด เลขดัง หรือชุดตัวเลขที่สนใจ แล้วตรวจสอบรายละเอียดของรายการนั้นให้ครบก่อนส่งโพย</strong>
        ซึ่งเป็นสิ่งที่ระบบเปิดให้ทำได้อยู่แล้ว ไม่ใช่การส่งโพยฟรี และไม่ใช่การรับประกันผลของรอบใดรอบหนึ่ง เมื่อ Login แล้วสมาชิกจะเปิดดูรอบเปิดรับ อัตราจ่าย ผลรางวัล และประวัติโพยได้จากบัญชีเดียว
      </p>

      <p>
        <strong class="text-[#ffd45e]">แม้ระบบเว็บไซต์จะเข้าใช้งานได้ 24 ชั่วโมง แต่เวลารับแทงจริงยังขึ้นอยู่กับกำหนดเปิดและปิดของหวยแต่ละรอบ</strong>
        การไล่ดูระบบจึงทำได้ตลอด แต่การส่งโพยต้องรอรอบที่ระบบเปิดรับอยู่จริง ควรดูเวลาที่ระบบแสดงของรายการนั้นก่อนทุกครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`ไล่ดูขั้นตอนเลือกรายการหวยและรอบของ ${BRAND_NAME}`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        หลัง Login ลำดับการใช้งานจะเป็นชุดเดียวกันทุกครั้ง
        <strong class="text-[#ffd45e]">เลือกรายการหวยและรอบ กรอกเลข กำหนดยอด แล้วอ่านหน้าส่งโพยก่อนยืนยัน</strong>
        การไล่ดูให้ครบรอบหนึ่งก่อนจึงช่วยให้รู้ว่าข้อมูลแต่ละอย่างอยู่ตรงไหนของหน้าจอ และควรเริ่มจากรายการที่อ่านรายละเอียดจบได้เร็วที่สุด
      </p>

      <ul class="flex flex-col gap-3" aria-label={`ลำดับการไล่ดูหน้าส่งโพยของ ${BRAND_NAME}`}>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f5c33b]">🗂️</span>
          <span>
            <strong class="text-[#ffd45e]">เลือกรายการหวยและรอบ</strong> หวยลาวเปิดรับตามรอบ หวยฮานอยมีหลายช่วงเวลา และรัฐบาลไทยไปตามกำหนดออกรางวัล จึงควรดูว่ารายการที่กำลังเปิดอยู่เป็นรอบใด เพราะแต่ละรายการอาจกำหนดรายละเอียดของรอบไม่เหมือนกัน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f5c33b]">🔢</span>
          <span>
            <strong class="text-[#ffd45e]">กรอกเลขที่ต้องการ</strong> ไม่ว่าจะเป็นเลขเด็ด เลขดัง หรือชุดตัวเลขที่เลือกเอง สำหรับเลข 2 ตัวควรตรวจให้ครบทั้งสองหลัก และสำหรับเลข 3 ตัวควรดูว่ากำลังเลือกรูปแบบการแทงแบบใด เพราะเลข 3 ตัวมีหลายรูปแบบ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f5c33b]">💰</span>
          <span>
            <strong class="text-[#ffd45e]">กำหนดยอดตามวงเงินที่ระบบเปิดรับ</strong> ยอดที่กรอกได้ขึ้นอยู่กับวงเงินรับแทงของเลขนั้นในรอบนั้น หากเลือกเลขที่มียอดเดิมพันสูง ระบบอาจแสดงยอดสูงสุดที่รับได้ต่างจากเลขทั่วไปในรอบเดียวกัน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f5c33b]">📨</span>
          <span>
            <strong class="text-[#ffd45e]">เปิดหน้าส่งโพยแล้วอ่านก่อนยืนยัน</strong> หน้านี้คือที่ที่ระบบแสดงเลข ยอดเดิมพัน และอัตราจ่ายพร้อมกัน จึงเป็นจุดสุดท้ายที่แก้ไขได้ก่อนรายการถูกบันทึกลงประวัติโพย
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#ffd45e]">เลขที่มียอดเดิมพันสูงอาจมีวงเงินรับแตกต่างจากเลขทั่วไป</strong>
        ดังนั้นค่าที่จำไว้จากรอบก่อนหน้าอาจไม่ใช่ชุดเดียวกับรอบที่กำลังจะส่งโพย ควรกรอกเลขและตรวจยอดสูงสุดที่ระบบเปิดรับใหม่ทุกครั้งแทนการอ้างจากความเคยชิน
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/แนวทาง"
          aria-label={`อ่านแนวทางหวยของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#d20a0a]/60 bg-[#0a0303] px-8 py-3 font-bold text-[#ffd45e] transition-all hover:scale-105 hover:border-[#ffd45e] hover:bg-[#2a0606] hover:text-[#ff5c5c]">
          อ่านแนวทางหวย
