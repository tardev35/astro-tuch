---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxCyberCut.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { pageGraph } from "../lib/schema";

// TTN69 เป็นเว็บสล็อตออโต้เกม รวมเกมสล็อตจากหลายแบรนด์ดังไว้ในบัญชีเดียว หน้านี้จึงหมายถึง
// การทำความรู้จักระบบก่อนเดิมพันด้วยเครดิตจริง: สมัครเองได้ 3 ขั้นตอน การเลือกแบรนด์และเกม
// การตรวจกติกา อัตราจ่าย และวงเงินเดิมพันของแต่ละเกม โปรโมชั่นที่ตรวจสอบได้หลัง Login
// และการดูประวัติรายการในบัญชีสมาชิก
//
// แบรนด์เก่าเคยวางแกลเลอรี 12 การ์ด (gamedemo7..18.webp) ไว้ที่หน้านี้ ถูกถอดออกไปตั้งแต่
// สิบรอบรีแบรนด์ก่อน และไม่มีการ import แล้ว — อย่านำกลับมา ลำพังการ import ก็ทำให้ไฟล์ถูก
// emit ลง dist/ และ verify-build จะแดงถ้ามีรูปที่ไม่มีใคร render ทั้งชุด
//
// ทุกข้อความอ้างอิงบรีฟของแบรนด์นี้เท่านั้น: รวมเกมสล็อตหลายแบรนด์ในบัญชีเดียว ระบบออโต้ ·
// Login แล้วเลือกแบรนด์และเกมที่ต้องการ พร้อมตรวจกติกา อัตราจ่าย และวงเงินก่อนทำรายการ ·
// โบนัสแนะนำเพื่อน 0.8% ตามเงื่อนไข · ฝากถอนผ่านธนาคารหรือวอลเลทตามช่องทางที่รองรับ
// ยึดยอดขั้นต่ำและวงเงินที่หน้าฝากถอนแสดง ณ เวลาทำรายการ · แอดมิน LINE OFFICIAL 24 ชม.
// บรีฟรอบนี้ไม่มี "คืนยอดเสีย 0.3%" และไม่มีข้ออ้าง "ไม่ผ่านเว็บตัวแทน" จึงไม่เขียนถึงทั้งคู่
// ไม่มีการอ้างใบอนุญาต การจดทะเบียน ปีที่ก่อตั้ง จำนวนสมาชิก การันตีผลกำไร
// หรือชื่อค่ายเกมรายใดที่บรีฟไม่ได้ระบุ
//
// Announcement หมุนมาใช้ AnnouncementPremium ตัวเดียวกับทั้งเว็บ — default message ของไฟล์นั้น
// เป็นข้อความของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ได้
//
// คำเตือนทุกจุดใช้สีเหลืองอำพัน #f5b93c โดยตั้งใจ ไม่ใช่เขียวแบรนด์
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 158
const pageDescription =
  "หน้าทดลองเล่น TTN69 แนะนำวิธีเริ่มใช้งานเว็บสล็อตออโต้เกม ตั้งแต่สมัครสมาชิก 3 ขั้นตอน ฝากผ่านธนาคารหรือวอลเลท จนถึงตรวจกติกาและวงเงินเดิมพันก่อนเริ่มเล่นจริง";

const graph = pageGraph(Astro, {
  name: "ทดลองเล่น TTN69 ทำความรู้จักระบบสล็อตออโต้เกมก่อนเดิมพันด้วยเครดิตจริง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title="ทดลองเล่น TTN69 ลองใช้ระบบสล็อตออโต้เกม รวมแบรนด์ดัง ขั้นต่ำ1บาท" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่น TTN69 ทำความรู้จักระบบสล็อตออโต้เกมก่อนเดิมพันด้วยเครดิตจริง" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d5e6da]">
        <strong class="text-[#f1faf4]">TTN69</strong> รวมเกมสล็อตจากหลายแบรนด์ไว้ในบัญชีเดียว ทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน
        และเกมรูปแบบใหม่ตามที่แต่ละแบรนด์เปิดให้บริการ รองรับการเข้าใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์
        หน้านี้จึงเปิดไว้ให้ผู้เริ่มต้นได้<strong class="text-[#f1faf4]">ทำความคุ้นเคยกับขั้นตอนใช้งาน ตรวจกติกา อัตราจ่าย และวงเงินเดิมพันของแต่ละเกม</strong>
        ก่อนเดิมพันด้วยเครดิตของตัวเอง เพราะรายละเอียดเหล่านี้ต่างกันไปตามแบรนด์และตามเกมที่เลือก
      </p>

      <p class="text-left text-base leading-relaxed text-[#d5e6da]">
        ขอให้เข้าใจตรงกันว่าการทดลองเล่นเป็นการทำความคุ้นเคยกับระบบเท่านั้น
        <strong class="text-[#f5b93c]">คำว่าแตกง่ายหรือแตกหนักรับประกันไม่ได้ เพราะผลของเกมสล็อตเป็นไปตามระบบและความผันผวนของแต่ละเกม</strong>
        ควรเลือกเกมจากกติกา รูปแบบการเดิมพัน และงบประมาณที่เหมาะสมกับตนเอง หากติดปัญหาระหว่างใช้งาน แจ้งแอดมิน TTN69 ผ่าน LINE OFFICIAL ได้ตลอด 24 ชั่วโมง
        พร้อมชื่อเกม เวลา จำนวนเงิน และรายละเอียดของรายการ เพื่อให้ตรวจสอบได้ตรงจุด
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="สมัครเล่น TTN69 สล็อตออโต้เกม ด้วยตัวเอง 3 ขั้นตอน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d5e6da]">
        ผู้ใช้งานใหม่สมัคร TTN69 ผ่านมือถือหรือคอมพิวเตอร์ได้ด้วยตัวเอง และสลับแบรนด์เกมผ่านบัญชีเดียวได้โดยไม่ต้องสมัครหลายครั้ง
        เริ่มต้นใช้งานได้ง่ายเพียง <strong class="text-[#f1faf4]">3 ขั้นตอน</strong> และเป็นลำดับเดียวกันไม่ว่าจะเลือกเล่นแบรนด์ไหน
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#d5e6da]">
        <li class="flex gap-3"><span class="font-bold text-[#02b961]">1.</span> เข้าหน้าสมัคร TTN69 และกรอกข้อมูลตามที่ระบบกำหนด ทำผ่านมือถือหรือคอมพิวเตอร์ได้โดยตรง</li>
        <li class="flex gap-3"><span class="font-bold text-[#02b961]">2.</span> Login เข้าสู่บัญชีและเลือกช่องทางฝากเครดิตผ่านบัญชีธนาคารหรือวอลเลทที่เปิดให้บริการ</li>
        <li class="flex gap-3"><span class="font-bold text-[#02b961]">3.</span> ตรวจสอบโปรโมชั่น เลือกแบรนด์และเกมสล็อตที่ต้องการ แล้วอ่านกติกากับวงเงินเดิมพันก่อนเริ่มเล่น</li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#d5e6da]">
        หลังสมัครเรียบร้อยสามารถตรวจสอบเครดิต ประวัติฝากถอน โปรโมชั่น และรายการใช้งานผ่านบัญชีสมาชิกได้โดยตรง
        ควรไล่ดูให้ครบก่อนใช้เครดิตจริง จะช่วยให้เห็นว่ารายการหนึ่งถูกบันทึกและคิดผลมาจากอะไรบ้าง
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ตรวจกติกา อัตราจ่าย และวงเงินเดิมพันของแต่ละเกมก่อนทำรายการ" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d5e6da]">
        ข้อมูลที่ควรเปิดดูให้ครบก่อนลงเดิมพันมีอยู่ไม่กี่อย่าง และระบบแสดงไว้ในหน้าเกมให้ตรวจสอบได้อยู่แล้ว
        <strong class="text-[#f1faf4]">ข้อมูลชุดนี้คือสิ่งที่กำหนดว่ารอบหนึ่งคิดผลอย่างไร</strong> จึงควรอ่านให้จบก่อนตัดสินใจว่าจะลงเท่าไร
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#d5e6da]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#02b961]">🎰</span>
          <span><strong class="text-[#f1faf4]">จำนวนวงล้อและเส้นรางวัล</strong> เป็นตัวกำหนดว่าสัญลักษณ์ชุดไหนนับเป็นรางวัล แต่ละเกมวางไว้ไม่เหมือนกันแม้อยู่แบรนด์เดียวกัน</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e4ece7]">🎁</span>
          <span><strong class="text-[#e4ece7]">รอบโบนัสและเงื่อนไขการเข้ารอบ</strong> หน้าอธิบายในตัวเกมบอกไว้ว่าต้องได้สัญลักษณ์ชุดใดจึงเปิดรอบพิเศษ และรอบนั้นคิดผลอย่างไร</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#02b961]">🌀</span>
          <span><strong class="text-[#f1faf4]">ฟรีสปินและตัวคูณ</strong> จำนวนสปินที่ได้รับกับวิธีคูณผลต่างกันไปตามเกม ควรดูให้ชัดก่อนว่าจะนับรวมกับเดิมพันปกติหรือไม่</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e4ece7]">💠</span>
          <span><strong class="text-[#e4ece7]">วงเงินเดิมพันต่อรอบ</strong> ที่มักพูดกันว่าขั้นต่ำ 1 บาททุกค่าย แต่ละเกมกำหนดยอดต่ำสุดและสูงสุดของตัวเอง ให้ยึดช่วงเดิมพันที่ระบบแสดงในหน้าเกมเป็นหลัก</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#d5e6da]">
        รายชื่อแบรนด์และเกมที่พร้อมใช้งานเปลี่ยนแปลงได้ ควรตรวจสอบรายการล่าสุดจากหน้าเลือกเกมในเว็บก่อนเข้าเล่น
        <strong class="text-[#f5b93c]">ส่วนยอดเดิมพันต่ำสุดจริงต่างกันไปตามค่าย จึงควรเปิดดูช่วงเดิมพันในตัวเกมก่อนทุกครั้ง</strong>
        และควรกำหนดยอดต่อรอบไว้ล่วงหน้าเสมอ
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ฝากถอนทุกธนาคารและวอลเลท เช็กโปรโมชั่น และดูแลความปลอดภัยบัญชี" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d5e6da]">
        สมาชิกจัดการเครดิตได้เองโดยเลือกใช้บัญชีธนาคารหรือวอลเลทจากช่องทางที่เว็บไซต์เปิดรองรับ
        <strong class="text-[#f1faf4]">ทำรายการฝาก ส่งคำขอถอน และตรวจสอบสถานะผ่านมือถือได้โดยตรง</strong>
        ช่วยลดขั้นตอนและไม่จำเป็นต้องแจ้งรายการกับเจ้าหน้าที่ทุกครั้ง ส่วนรายชื่อธนาคาร ชื่อบัญชี จำนวนเงิน ยอดขั้นต่ำ วงเงิน และสถานะของแต่ละช่องทาง
        ควรตรวจสอบก่อนทำธุรกรรมทุกครั้ง เนื่องจากช่องทางแต่ละประเภทเปิดปิดและกำหนดเงื่อนไขไม่เหมือนกัน
      </p>

      <ul class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#d5e6da]">
        <li class="flex gap-3">
          <span class="text-[#02b961]" aria-hidden="true">•</span> โปรโมชั่นแนะนำเพื่อน รับโบนัส 0.8% ตรวจสอบสิทธิ์ได้หลัง Login โดยดูจำนวนเพื่อนที่แนะนำ ยอดที่ระบบคำนวณได้ และโบนัสที่มีสิทธิ์รับจากบัญชีสมาชิก ควรอ่านรอบคำนวณ ประเภทเกมที่ร่วมรายการ และเงื่อนไขล่าสุดให้ครบก่อนกดรับ
        </li>
        <li class="flex gap-3">
          <span class="text-[#e4ece7]" aria-hidden="true">•</span> หน้านี้อธิบายการใช้งานและการทำความคุ้นเคยกับระบบเท่านั้น การเดิมพันจริงต้องสมัครสมาชิกและฝากเครดิตผ่านช่องทางที่เปิดให้บริการก่อน
        </li>
        <li class="flex gap-3">
          <span class="text-[#02b961]" aria-hidden="true">•</span> หากเครดิตไม่เข้า รายการถอนค้าง หรือสถานะธุรกรรมไม่อัปเดต ให้ตรวจสอบประวัติธุรกรรมในบัญชีก่อน และเก็บหลักฐานรายการไว้จนกว่าการตรวจสอบจะเสร็จสิ้น
        </li>
        <li class="flex gap-3">
          <span class="text-[#e4ece7]" aria-hidden="true">•</span>
          <strong class="text-[#f5b93c]">ตั้งรหัสผ่านที่คาดเดายาก ไม่ใช้รหัสเดียวกับบริการอื่น และไม่เปิดเผยรหัสผ่านหรือ OTP แก่บุคคลอื่น</strong> รวมถึงตรวจสอบให้แน่ใจว่าเป็นบัญชี LINE OFFICIAL ที่ประกาศไว้บนเว็บไซต์ก่อนส่งข้อมูลใด ๆ
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#d5e6da]">
        หากพบปัญหาสมัครสมาชิก Login ไม่ได้ เข้าเกมสล็อตไม่ได้ ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง หรือโปรโมชั่นไม่แสดง ติดต่อแอดมิน TTN69 ผ่าน LINE OFFICIAL ได้ตลอด 24 ชั่วโมง พร้อมแจ้งชื่อเกม เวลา จำนวนเงิน
        และช่องทางที่ใช้ทำรายการ <strong class="text-[#f5b93c]">การเดิมพันมีความเสี่ยง ควรกำหนดงบประมาณให้เหมาะสมทุกครั้ง</strong>
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก TTN69"
          class="flex items-center justify-center rounded-lg border border-[#046b3a]/70 bg-gradient-to-r from-[#4ce68f] via-[#02b961] to-[#046b3a] px-8 py-3 font-black text-[#020805] shadow-[0_0_15px_rgba(2,185,97,0.30)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ TTN69"
          class="flex items-center justify-center rounded-lg border border-[#e4ece7]/45 bg-transparent px-8 py-3 font-bold text-[#e4ece7] transition-all hover:scale-105 hover:border-[#e4ece7] hover:bg-[#0c2214]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>

  <Navfoot />
</MainLayout>
