---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { pageGraph } from "../lib/schema";

// LION991 เป็นคาสิโนออนไลน์ VIP หน้านี้จึงหมายถึงการทำความรู้จักระบบ
// คาสิโนสด/โต๊ะ Live ก่อนเดิมพันด้วยเครดิตจริง — ขั้นตอนสมัครและฝากเครดิต การเลือกโต๊ะ
// การตรวจกติกา อัตราจ่าย วงเงินขั้นต่ำและสูงสุดของแต่ละโต๊ะ โปรโมชั่นที่ตรวจสอบได้หลัง Login
// และการดูประวัติรายการในบัญชีสมาชิก
// (รอบรีแบรนด์ก่อนหน้าเป็นเว็บลอตเตอรี่ ซึ่งผิดหมวดสำหรับแบรนด์นี้ทั้งหมด
// หน้านี้จึงถูกเขียนใหม่ทั้งหน้า ไม่มีตารางอัตราจ่ายตายตัวหลงเหลือ)
//
// แบรนด์เก่าเคยวางแกลเลอรี 12 การ์ด (gamedemo7..18.webp) ไว้ที่หน้านี้ ถูกถอดออกไปตั้งแต่
// แปดรอบรีแบรนด์ก่อน และไม่มีการ import แล้ว — อย่านำกลับมา เหตุผลมีสองชั้น: ลำพังการ import
// ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดงถ้ามีรูปที่ไม่มีใคร render ทั้งชุด
// ยังเป็นภาพของ "askmeslot" ซึ่งเป็นโลโก้เว็บอื่น การนำกลับมาคือการโชว์แบรนด์คู่แข่ง
// บนหน้าเว็บของ LION991
//
// ทุกข้อความอ้างอิง src/assets/content.txt เท่านั้น: คาสิโนสด/โต๊ะ Live (บาคาร่า รูเล็ต
// เสือมังกร แบล็กแจ็ก และเกมคาสิโนสดประเภทอื่น) · กติกา อัตราจ่าย วงเงินขั้นต่ำ-สูงสุด
// ต่างกันตามเกมและผู้ให้บริการ · สมัครเอง 3 ขั้นตอนไม่ต้องผ่านแอดมิน · ฝากถอนและประวัติ
// รายการในบัญชีสมาชิก · แอดมิน 24 ชม. ไม่มีการอ้างใบอนุญาต การจดทะเบียน ปีที่ก่อตั้ง
// จำนวนสมาชิก การันตีผลกำไร หรือชื่อค่าย/สตูดิโอถ่ายทอดสดรายใด และไม่มีตารางอัตราจ่าย
//
// Announcement หมุนมาใช้ AnnouncementPremium ตัวเดียวกับ index — default message ของไฟล์นั้น
// เป็นข้อความของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ได้
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 153
const pageDescription = "หน้าทดลองเล่นของ LION991 แนะนำวิธีทำความคุ้นเคยกับระบบคาสิโนออนไลน์ ตั้งแต่สมัครสมาชิก ฝากเครดิต เลือกโต๊ะ Live ตรวจกติกาและวงเงิน ไปจนถึงดูประวัติรายการ";

const graph = pageGraph(Astro, {
  name: "ทดลองเล่น LION991 ทำความรู้จักระบบคาสิโนสดก่อนเดิมพันด้วยเครดิตจริง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title="ทดลองเล่น LION991 ลองใช้ระบบคาสิโนสด บาคาร่า รูเล็ต เสือมังกร แบล็กแจ็ก" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่น LION991 ทำความรู้จักระบบคาสิโนสดก่อนเดิมพันด้วยเครดิตจริง" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d6e2f5]">
        <strong class="text-[#e6ecf7]">LION991</strong> เปิดให้บริการสมาชิกที่ต้องการเล่นคาสิโนออนไลน์ผ่านมือถือและคอมพิวเตอร์
        โดยรวบรวมเกมเดิมพันหลายหมวดหมู่ไว้ในบัญชีเดียว พร้อมคาสิโนสดและโต๊ะ Live ตามที่ระบบเปิดให้บริการ
        หน้านี้จึงเปิดไว้ให้ผู้เริ่มต้นได้<strong class="text-[#8fc2ff]">ทำความคุ้นเคยกับขั้นตอนใช้งาน ตรวจกติกา อัตราจ่าย และวงเงินขั้นต่ำและสูงสุดของโต๊ะ</strong>
        ก่อนเดิมพันด้วยเครดิตของตัวเอง เพราะรายละเอียดเหล่านี้อาจแตกต่างกันตามเกมและผู้ให้บริการ
      </p>

      <p class="text-left text-base leading-relaxed text-[#d6e2f5]">
        ขอให้เข้าใจตรงกันว่าการทดลองเล่นเป็นการทำความคุ้นเคยกับระบบเท่านั้น
        <strong class="text-[#8fc2ff]">ผลของแต่ละตาไม่แน่นอน ไม่มีเกมหรือสูตรใดรับประกันผลได้เสียล่วงหน้า</strong>
        หากติดปัญหาระหว่างใช้งาน แจ้งแอดมิน LION991 ได้ตลอด 24 ชั่วโมง พร้อมชื่อเกม เวลา จำนวนเงิน และรายละเอียดของรายการ เพื่อให้ตรวจสอบได้ตรงจุด
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="ขั้นตอนเริ่มใช้งาน LION991 ตั้งแต่สมัครสมาชิกจนถึงเข้าโต๊ะ Live" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d6e2f5]">
        ผู้ใช้งานใหม่สมัคร LION991 ผ่านระบบออนไลน์ได้ด้วยตัวเอง โดยไม่ต้องส่งข้อมูลการสมัครผ่านเจ้าหน้าที่
        เริ่มต้นใช้งานได้ง่ายเพียง <strong class="text-[#8fc2ff]">3 ขั้นตอน</strong> และเป็นลำดับเดียวกันไม่ว่าจะเลือกเล่นเกมหมวดไหน
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#d6e2f5]">
        <li class="flex gap-3"><span class="font-bold text-[#8fc2ff]">1.</span> เปิดหน้าสมัคร LION991 และกรอกข้อมูลตามที่ระบบกำหนด ทำผ่านมือถือหรือคอมพิวเตอร์ได้โดยตรง</li>
        <li class="flex gap-3"><span class="font-bold text-[#8fc2ff]">2.</span> Login เข้าสู่บัญชีและเลือกช่องทางฝากเครดิตที่เปิดให้บริการ</li>
        <li class="flex gap-3"><span class="font-bold text-[#8fc2ff]">3.</span> ตรวจสอบโปรโมชั่น เลือกเกมคาสิโนหรือโต๊ะ Live และศึกษากติกาก่อนเริ่มเดิมพัน</li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#b7c6dd]">
        หลังสมัครเรียบร้อยสามารถตรวจสอบเครดิต ประวัติรายการ โปรโมชั่น และสถานะฝากถอนผ่านบัญชีสมาชิกได้โดยตรง
        ควรไล่ดูให้ครบก่อนใช้เครดิตจริง จะช่วยให้เห็นว่ารายการหนึ่งถูกบันทึกและคิดผลมาจากอะไรบ้าง
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ตรวจกติกา อัตราจ่าย และวงเงินของโต๊ะก่อนเริ่มเดิมพันทุกครั้ง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d6e2f5]">
        ข้อมูลที่ควรเปิดดูให้ครบก่อนลงเดิมพันมีอยู่ไม่กี่อย่าง และระบบแสดงไว้ให้ตรวจสอบได้จากบัญชีเดียวอยู่แล้ว
        <strong class="text-[#e6ecf7]">ข้อมูลชุดนี้คือสิ่งที่กำหนดว่ารายการหนึ่งคิดผลอย่างไร</strong> จึงควรอ่านให้จบก่อนตัดสินใจว่าจะลงเท่าไร
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#d6e2f5]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#8fc2ff]">🎯</span>
          <span><strong class="text-[#8fc2ff]">เกมและโต๊ะที่เลือก</strong> บาคาร่า รูเล็ต เสือมังกร แบล็กแจ็ก และเกมคาสิโนสดประเภทอื่น ๆ ใช้กติกาคนละชุด ควรอ่านของเกมที่กำลังจะเล่นเป็นหลัก</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#8fc2ff]">💹</span>
          <span>
            <strong class="text-[#8fc2ff]">อัตราจ่ายของโต๊ะนั้น</strong> อาจแตกต่างกันตามเกมและผู้ให้บริการ จึงให้ยึดตัวเลขที่แสดงจริงในเกม ณ เวลาที่กำลังจะเดิมพันเป็นหลัก
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#8fc2ff]">⏱️</span>
          <span><strong class="text-[#8fc2ff]">จังหวะเปิด-ปิดรับของแต่ละตา</strong> เดินตามการดำเนินเกมแบบเรียลไทม์ ควรเผื่อเวลาไว้ก่อนปิดรับ จะได้เหลือจังหวะแก้ไขเมื่อกดผิด</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#8fc2ff]">💰</span>
          <span><strong class="text-[#8fc2ff]">วงเงินขั้นต่ำและสูงสุด</strong> ของแต่ละโต๊ะไม่เท่ากัน ควรกำหนดยอดต่อตาไว้ล่วงหน้า เช่น มีทุน 1,000 บาท ให้คิด 1 หน่วยเท่ากับ 10 บาท แล้ววางยอดให้อยู่ในระดับที่รับได้</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#b7c6dd]">
        รายการโต๊ะและผู้ให้บริการที่พร้อมใช้งานเปลี่ยนแปลงได้ ควรตรวจสอบรายการล่าสุดจากหมวดคาสิโน Live ก่อนเข้าเล่น
        ส่วนข้อมูลเกี่ยวกับสตูดิโอหรือแหล่งถ่ายทอดสดให้ยึดข้อมูลที่แสดงในเกมโดยตรง
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ฝากถอน เช็กประวัติรายการ และดูแลความปลอดภัยของบัญชีสมาชิก" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d6e2f5]">
        สมาชิกจัดการเครดิตได้เองโดยเลือกช่องทางฝากถอนที่เว็บไซต์เปิดให้บริการ
        <strong class="text-[#8fc2ff]">ฝากเครดิต ส่งคำขอถอน และตรวจสอบสถานะรายการผ่านบัญชีของตนเองได้โดยตรง</strong>
        ก่อนทำธุรกรรมควรตรวจสอบชื่อบัญชี จำนวนเงิน ยอดขั้นต่ำ และวงเงินต่อรายการให้ถูกต้องทุกครั้ง ส่วนเครดิต ประวัติรายการ และโปรโมชั่นที่กดรับไว้จะแสดงอยู่ในบัญชีสมาชิกให้ย้อนดูได้
      </p>

      <ul class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#d6e2f5]">
        <li class="flex gap-3">
          <span class="text-[#8fc2ff]" aria-hidden="true">•</span> หน้านี้อธิบายการใช้งานและการทำความคุ้นเคยกับระบบเท่านั้น การเดิมพันจริงต้องสมัครสมาชิกและฝากเครดิตผ่านช่องทางที่เปิดให้บริการก่อน
        </li>
        <li class="flex gap-3">
          <span class="text-[#8fc2ff]" aria-hidden="true">•</span> หากเครดิตไม่เข้า รายการถอนค้าง หรือสถานะธุรกรรมไม่อัปเดต ให้เก็บข้อมูลและหลักฐานรายการไว้เพื่อใช้ประกอบการตรวจสอบกับเจ้าหน้าที่
        </li>
        <li class="flex gap-3">
          <span class="text-[#8fc2ff]" aria-hidden="true">•</span> ตั้งจุดหยุดเมื่อเสียและจุดที่จะพักเมื่อได้กำไรไว้ตั้งแต่ก่อนเริ่ม แล้วหยุดตามแผน ไม่เพิ่มยอดเดิมพันเพื่อไล่เอาเงินคืน
        </li>
        <li class="flex gap-3">
          <span class="text-[#8fc2ff]" aria-hidden="true">•</span>
          <strong class="text-[#e6ecf7]">ตั้งรหัสผ่านที่คาดเดายากและไม่เปิดเผย OTP แก่บุคคลอื่น</strong> ไม่ว่าจะเป็นการติดต่อจากช่องทางใดก็ตาม
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#d6e2f5]">
        หากพบปัญหาสมัครสมาชิก Login ไม่ได้ เข้าโต๊ะ Live ไม่ได้ ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง หรือโปรโมชั่นไม่แสดง ติดต่อแอดมิน LION991 ได้ตลอด 24 ชั่วโมง พร้อมแจ้งชื่อเกม เวลา จำนวนเงิน
        และรายละเอียดของรายการ <strong class="text-[#e6ecf7]">การเดิมพันมีความเสี่ยง ควรกำหนดงบประมาณให้เหมาะสมทุกครั้ง</strong>
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก LION991"
          class="flex items-center justify-center rounded-lg border border-[#b7c6dd]/70 bg-gradient-to-r from-[#e6ecf7] via-[#b7c6dd] to-[#7d90ad] px-8 py-3 font-black text-[#01041c] shadow-[0_0_15px_rgba(183,198,221,0.30)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ LION991"
          class="flex items-center justify-center rounded-lg border border-[#1046e0]/60 bg-transparent px-8 py-3 font-bold text-[#8fc2ff] transition-all hover:scale-105 hover:border-[#8fc2ff] hover:bg-[#0a3390]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>

  <Navfoot />
</MainLayout>
