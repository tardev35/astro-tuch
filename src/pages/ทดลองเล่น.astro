---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement4.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import popularGamesImage from "../assets/gamedemo8.webp";
import newGamesImage from "../assets/gamedemo16.webp";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริง
// ของบรีฟรอบนี้เท่านั้น (src/assets/content.txt) ไม่ใช่แก้ทับประโยคของแบรนด์ก่อน
// — ย่อหน้าเก่าทั้งย่อหน้าตั้งอยู่บนคำที่ brand-spec §7 สั่งห้าม จึงต้องเขียนใหม่
// ไม่ใช่ find-and-replace
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// ดรอปนี้ (2026-10-11) คือ **FAH999 ฟาสล็อตเว็บตรง** เป็นเว็บสล็อตล้วน ไม่ใช่เว็บ
// ของหมวดอื่น (รายการหมวดที่ห้ามเอ่ยอยู่ใน brand-spec §7 — สองหน้าของหมวดนั้นจอด
// อยู่ใน src/pages-disabled/ ไม่มี route ห้ามลิงก์ไปหา เป็น href ตายที่ทำให้ build
// แดง) แง่มุมที่บรีฟระบุไว้มีเท่านี้: รวมเกมสล็อตหลายแนวในแพลตฟอร์มเดียว ·
// สล็อตคลาสสิก เกมโบนัส ฟรีสปิน สล็อตวงล้อทั่วไป เกมที่มีฟีเจอร์พิเศษ · Login
// ใช้งานง่าย รองรับทั้งมือถือและคอมพิวเตอร์ · เลือกค่ายเกม ค้นหาเกม ตรวจสอบข้อมูล
// บัญชีและประวัติรายการจากบัญชีเดียว · ตารางจ่าย อัตราการคืนเงินผู้เล่น ช่วงเดิมพัน ·
// ผลการหมุนเป็นแบบสุ่ม · คืนยอดเสีย 0.3% เข้ายูส รอบประจำวัน รอบตัดยอด ยอดที่เข้าเกณฑ์ ·
// แนะนำเพื่อน ลิงก์แนะนำ โบนัส 0.8% · สมัคร 3 ขั้นตอน ยืนยันบัญชี · แอดมิน 24 ชั่วโมง ·
// ช่องทางติดต่อหลัก · รหัสผ่าน PIN OTP
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามี "โหมดทดลอง" เครดิตทดลอง หรือเดโมฟรีเป็นบริการของเว็บ —
// จึงห้ามสัญญาสินค้าตัวนั้น คำว่า "ทดลองเล่น" บนหน้านี้จึงหมายถึงสิ่งที่บรีฟระบุไว้
// ตรงๆ ว่าทำได้: เปิดเว็บไล่ดูหมวดเกมและเมนูให้ครบหนึ่งรอบ ค้นหาเกม เลือกช่วงเดิมพัน
// อ่านตารางจ่ายกับรายละเอียดโปรโมชั่น แล้วจึงเริ่มเล่นจริง
//
// ⚠️ บรีฟรอบนี้ไม่ได้พูดถึงระบบฝากถอน ธนาคาร บัญชีปลายทาง หรือยอดฝากขั้นต่ำเลย
// (เอ่ยแค่ว่ามี "รายการธุรกรรมที่อยู่ระหว่างตรวจสอบ" ให้สอบถามแอดมินได้) จึงห้าม
// เขียนส่วนฝากถอนขึ้นมาเอง และห้ามใช้คำขายของของแบรนด์ก่อนที่เคยอยู่ตรงนั้น
//
// ⚠️ รูปในหน้านี้ใช้ได้แค่ gamedemo8 กับ gamedemo16 เท่านั้น — เป็นอาร์ตสต็อกกลาง
// ของเทมเพลต (mtime 2026-08-04) ไม่ใช่อาร์ตเวิร์กของแบรนด์นี้ จึงอยู่ต่อได้ แต่ alt
// ต้องบรรยายภาพจริง และห้ามเอ่ยชื่อแบรนด์ใด เพราะไม่มีชื่อแบรนด์ไหนปรากฏอยู่บนรูป
// ทั้งสองใบ ส่วน gamedemo7/9/10/11/12/14/15/17/18 มีโลโก้หรือชื่อของผู้ให้บริการ
// เจ้าอื่นพิมพ์ทับอยู่กลางรูป และ gamedemo13 เป็นภาพล่อแหลม — ห้ามนำกลับมาใช้
// เพราะเท่ากับอ้างชื่อที่บรีฟไม่ได้เอ่ย ไฟล์ยังอยู่บนดิสก์ ห้ามลบ เป็นอินเวนทอรี
// gamedemo8 ("POPULAR GAME" 600x379) กับ gamedemo16 ("New Game" 650x411) ความกว้าง
// ที่วาดจริงสูงสุด ~600px ต่อใบ (กริดสองคอลัมน์ในการ์ด) จึงไม่ขยายเกินต้นฉบับ
// quality={62} ของสองใบนี้ตั้งไว้ต่ำกว่าค่าปกติ 80 มาตั้งแต่รอบก่อน เพราะอาร์ตมีเกรน
// ละเอียดจนไฟล์ AVIF เคยโตกว่า WebP ของตัวเอง (verify-build จะแดง) ห้ามดันกลับขึ้น
//
// ⚠️ คำที่ห้ามหลงเหลือ: ศัพท์ของหมวดอื่นที่ไม่ใช่สล็อต และคำขายของของแบรนด์ก่อนๆ
// ที่บรีฟรอบนี้ไม่ได้เอ่ย — รายการเต็มอยู่ใน brand-spec §7 ไม่พิมพ์ซ้ำที่นี่ เพื่อ
// ไม่ให้ grep หาคำต้องห้ามเจอ false positive รายการตรวจก่อนเริ่มเล่น (<ol> ด้านล่าง)
// รอบนี้เขียนใหม่ทั้งสี่ข้อให้อ้างเฉพาะสิ่งที่บรีฟพูดถึงจริง
//
// ⚠️ ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง
// ห้ามเติมเลขใบอนุญาต หน่วยงานกำกับ ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP ยอดฝากขั้นต่ำ
// จำนวนสมาชิก หรือปีที่ก่อตั้ง เพราะบรีฟไม่ได้เอ่ยไว้สักอย่าง — คำว่า "อัตราการ
// คืนเงินผู้เล่น" ใช้ได้เพราะเป็นคำของบรีฟเอง แต่ห้ามใส่ตัวเลขกำกับ
//
// ประโยคกำกับของบรีฟที่ห้ามตัดทิ้ง (เป็นส่วนหนึ่งของคอปปี้ ไม่ใช่ filler):
// ควรตรวจสอบข้อมูลผู้ให้บริการและค่ายเกมที่เชื่อมต่อจริงก่อนใช้งาน ·
// ผลการหมุนเป็นแบบสุ่มและไม่มีเกมใดรับประกันว่าจะชนะทุกครั้ง ·
// ควรอ่านรายละเอียดก่อนกดรับทุกครั้ง · คำว่าไม่จำกัดควรระบุให้ชัดว่าหมายถึงจำนวน
// เพื่อนที่แนะนำ จำนวนครั้งในการรับสิทธิ์ หรือวงเงินโบนัส · ไม่ควรเปิดเผยรหัสผ่าน
// PIN หรือ OTP ให้บุคคลอื่น · ควรอ่านข้อกำหนดการใช้งานและตรวจสอบอายุที่กฎหมาย
// อนุญาตในพื้นที่ของตน
//
// banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion · banner2/banner3 และ
// slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import (ลำพังการ import ก็ทำให้
// ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น Announcement4 ทั้งเว็บ (รอบก่อนใช้ Announcement6 —
// brand-spec §3 หมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้
// ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่ง
// จะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ชมพูบานเย็น นำ ทอง รอง บนพื้นพลัมเกือบดำ**
// พลิกทิศจากคู่ "ทองเป็ด-ส้มอำพัน บนพื้นดำสนิท" ของแบรนด์ก่อน ซึ่งออกครบทุกจุดแล้ว
// ทั้งคลาส Tailwind raw hex และ rgba() (ค่าเดิมอยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive) รอบนี้ไม่มีส้มอำพันเป็นฮิวเลย
// ลำดับปุ่มสื่อด้วยขั้ว "ชมพูถม vs ผิวยกขอบชมพู": ปุ่มหลักถมชมพูไล่เฉด #ffd1ea →
// #ff6cbb → #ff3fa4 ขอบ #b3006a หมึกพลัมเกือบดำ #2b0019 · ปุ่มรองและปุ่มลิงก์ภายใน
// เป็นผิวยก #4a0b42 → #210220 ขอบชมพู #ff3fa4/50 ตัวอักษรชมพูอ่อน #ffd1ea
// · ขอบรูปใช้ชมพูแบบโปร่ง · marker ของลำดับเลขใช้ชมพูแบรนด์ #ff3fa4
// ⚠️ ห้ามกลับด้าน: พื้นถมชมพูต้องใช้หมึกเข้มเสมอ ห้ามขาวหรือชมพูอ่อน และห้ามให้
// ไล่เฉดชมพูที่รองหมึกจบเข้มกว่า #ff3fa4 — #b3006a / #7a0046 / #4d002b เป็นเส้น
// ขอบ และออราเท่านั้น ห้ามถือตัวอักษรทุกขนาด
// ⚠️ "ชมพู" ไม่ใช่ตัวบอกว่าถูกแบรนด์: มีแบรนด์ก่อนหน้าที่เป็นแบรนด์ชมพูเหมือนกัน
// และเจ็ดในแปดแบรนด์หลังสุดก็มีทอง ให้เทียบเป็นค่าทีละตัวกับตารางใน brand-spec §2
// (ค่าเดิมไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive)
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #fde8f3)
// ไว้ที่ตัวการ์ดแล้ว ข้อความในหน้านี้จึงไม่ประกาศสีของตัวเองเลย ปล่อยให้สืบทอดลงมา
// — มีแค่ปุ่ม ขอบรูป และ marker ของลำดับเลขที่ประกาศสี เพราะเป็นพื้น/เส้น ไม่ใช่
// เนื้อความ ส่วน <strong> ใช้น้ำหนักตัวอักษรเป็นไฮไลต์ ไม่ประกาศสี และแต่ละ
// <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ
// ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 157 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} ฟาสล็อตเว็บตรง ไล่ดูสล็อตคลาสสิก เกมโบนัส ฟรีสปิน ค้นหาเกมจากหมวดเกม เลือกช่วงเดิมพัน แล้วอ่านตารางจ่ายกับเงื่อนไขโปรโมชั่นก่อนเริ่มเล่นจริง`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ฟาสล็อตเว็บตรง ไล่ดูหมวดเกมและเมนูก่อนเริ่มเล่นจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong>{BRAND_NAME}</strong> คือฟาสล็อตเว็บตรงที่รวมเกมสล็อตหลายแนวไว้ในแพลตฟอร์มเดียว
        <strong>ทั้งสล็อตคลาสสิก สล็อตวงล้อทั่วไป เกมโบนัส ฟรีสปิน และเกมที่มีฟีเจอร์พิเศษ โดยใช้ระบบ Login ใช้งานง่าย รองรับทั้งมือถือและคอมพิวเตอร์</strong>
        หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับระบบได้ไล่ดูให้ครบหนึ่งรอบ ตั้งแต่เมนูค้นหาเกมและหมวดเกมที่เว็บไซต์จัดไว้ ไปจนถึงช่วงเดิมพันและตารางจ่ายของแต่ละเกม ก่อนจะเริ่มเล่นจริง
      </p>

      <p>
        คำว่า ทดลองเล่น ที่หน้านี้พูดถึงจึงหมายถึง
        <strong>การเปิดเว็บไซต์ไล่ดูหมวดเกมที่จัดไว้ ค้นหาเกมจากเมนู เลือกช่วงเดิมพัน แล้วอ่านรายละเอียดของแต่ละค่ายเกมกับโปรโมชั่นที่เปิดอยู่ให้จบ</strong>
        ซึ่งเป็นสิ่งที่ระบบเปิดให้ทำได้อยู่แล้ว ไม่ใช่การแจกเครดิตทดลอง ไม่ใช่การหมุนฟรี และไม่ใช่การรับประกันผลของเกมใดเกมหนึ่ง เพราะผลการหมุนเป็นแบบสุ่มและไม่มีเกมใดรับประกันว่าจะชนะทุกครั้ง
      </p>

      <p>
        อีกเรื่องที่ควรไล่ดูไปพร้อมกันคือขอบเขตของสิ่งที่เปิดให้บริการจริง
        <strong>เพราะการยืนยันว่าเป็นสล็อตระบบแท้หรือเว็บตรง ควรตรวจสอบข้อมูลผู้ให้บริการและค่ายเกมที่เชื่อมต่อจริงก่อนใช้งาน</strong>
        ส่วนจำนวนค่ายเกมที่เปิดให้บริการจริงควรอ้างอิงจากรายชื่อที่แสดงบนเว็บไซต์ ซึ่งเปลี่ยนแปลงได้ตามช่วงเวลา การไล่ดูด้วยตัวเองหนึ่งรอบจึงให้ข้อมูลตรงกว่าค่าที่จำไว้จากรอบก่อนหน้า
      </p>
    </div>
  </ContentBox>

