---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import popularGamesImage from "../assets/gamedemo8.webp";
import newGamesImage from "../assets/gamedemo16.webp";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ (src/assets/content.txt) ไม่มีหมวด "ทดลองเล่น" และไม่มี
// ส่วน SUB-PAGES เลย ทั้งหน้าจึงเขียนขึ้นใหม่จากคลังคำของบรีฟรอบนี้ ไม่ใช่แก้ทับ
// ประโยคของแบรนด์ก่อน
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// ⚠️ **ความต่างที่สำคัญที่สุดของรอบนี้กับรอบก่อน**: บรีฟรอบก่อน (มีเฮ168) เป็น
// **สล็อตล้วน** ส่วนบรีฟรอบนี้ **ระบุหมวดเกมไว้สี่หมวดจริงๆ**: เกมสล็อต · ยิงปลา ·
// ไฮโล · หวยออนไลน์/แทงหวย (content.txt บรรทัด 4, 6, 20, 25) คำสามคำหลังจึง
// **ใช้ได้รอบนี้** ไม่ใช่คำค้างของแบรนด์เก่า — แต่แกนของแบรนด์ยังเป็น **เกมสล็อต**
// และ ⚠️ **นี่ไม่ใช่เว็บหวย** หวยออนไลน์เป็นหนึ่งในสี่หมวดเกมเท่านั้น
// /ตรวจหวย กับ /แนวทาง จอดอยู่ใน src/pages-disabled/ ไม่มี route ห้ามลิงก์ไปหา
// เป็น href ตายที่ทำให้ build แดง route ที่มีจริงรอบนี้คือ
// / · /about-us · /contact-us · /login · /register · /privacy · /promotion ·
// /terms · /ทดลองเล่น · /ทางเข้า · /404 · /line
//
// ⚠️ แบรนด์ก่อนหน้าทันที (มีเฮ168) ก็เป็นแบรนด์สล็อตเหมือนกัน คอปปี้เดิมจึง
// "ดูเข้าเค้า" ทั้งที่กรอบของบรีฟคนละอัน — **ห้าม find-and-replace ทับประโยคเดิม**
// วลีแกนของรอบก่อนถูกถอดออกหมดทั้งไฟล์แล้ว โดยเฉพาะคำว่า **"ค่ายเกม"** ซึ่งเป็น
// คำแกนของรอบก่อนและ **บรีฟรอบนี้ไม่ได้ใช้เลยสักครั้ง** — รอบนี้ใช้คำของบรีฟเอง
// คือ "ประเภทเกม" · "รายชื่อเกม" · "ข้อมูลผู้ให้บริการ" แทน และคำว่า
// "วอลเลทและธนาคารชั้นนำ" ก็เป็นคำของรอบก่อนที่บรีฟรอบนี้ไม่ได้เอ่ย จึงเหลือแค่
// "ฝากถอน" ตามบรีฟ
// กรอบของบรีฟรอบนี้คือ **รวมเกมสล็อต ยิงปลา ไฮโล และหวยออนไลน์ พร้อมเมนูสมัคร
// สมาชิก เข้าสู่ระบบ ฝากถอน และตรวจสอบโปรโมชั่น ไว้ในเว็บไซต์เดียว — ผู้ใช้งาน
// ศึกษากติกา อัตราจ่าย อัตราเดิมพัน เงื่อนไขการเดิมพัน และข้อมูลผู้ให้บริการ
// ก่อนเริ่มใช้งานทุกครั้ง** บวกโปรโมชั่นคืนยอดเสีย 0.3% กับแนะนำเพื่อน 0.8%
// และช่องทางติดต่อเจ้าหน้าที่ 24ชม.
// (คำต้องห้ามไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive
// ในคอมเมนต์ของไฟล์นี้เอง — เต็มอยู่ใน brand-spec §6)
//
// 🚨 **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกม/ค่ายผู้พัฒนาแม้แต่รายเดียว** จึงห้ามเขียน
// ชื่อผู้ให้บริการเกมใดๆ ลงหน้าเว็บ
//
// ⚠️ บรีฟรอบนี้ **ไม่ได้เอ่ยถึงใบอนุญาต ผู้กำกับดูแล นิติบุคคล ชื่อธนาคารเฉพาะราย
// ค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีก่อตั้ง** จึงห้ามพูดถึงทั้งหมด
// รายการเต็มอยู่ใน brand-spec §6 สิ่งที่บรีฟให้มาและอ้างได้คือ: ประเภทเกมทั้งสี่ ·
// ธีมและฟีเจอร์ของเกมสล็อต · การเลือกเป้าหมายของเกมยิงปลา · ผลการทอยลูกเต๋าของไฮโล ·
// รูปแบบการเลือกหมายเลขของหวยออนไลน์ · กติกา · อัตราจ่าย · อัตราเดิมพัน ·
// เงื่อนไขการเดิมพัน · ข้อมูลผู้ให้บริการ · ยอดที่ใช้คำนวณโบนัส · รอบเวลารับเครดิต ·
// วิธีรับเครดิต · ลิงก์แนะนำและการเชื่อมโยงบัญชี · การสมัครสมาชิกและข้อมูลส่วนบุคคล ·
// รายการฝากถอน · หลักฐานสำหรับการตรวจสอบ · ช่องทางทางการ
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามีโหมดทดลอง เครดิตทดลอง หรือเดโมฟรีเป็นบริการของเว็บ —
// จึงห้ามสัญญาสินค้าตัวนั้น คำว่า "ทดลองเล่น" บนหน้านี้จึงหมายถึงสิ่งที่บรีฟระบุไว้
// ตรงๆ ว่าทำได้: ไล่ดูประเภทเกมที่เปิดให้บริการและขั้นตอนการใช้งานให้ครบหนึ่งรอบ
// ศึกษาเงื่อนไขของแต่ละโปรโมชั่น และสอบถามเจ้าหน้าที่ ก่อนเข้าใช้งานจริง
//
// ⚠️ คำว่า "รับได้ไม่จำกัด" และ "รวยขั้นเทพ" อยู่ได้เฉพาะในหัวข้อที่บรีฟเขียนไว้เอง
// (= หัวข้อของ index.astro) หน้านี้จึงไม่หยิบมาเป็นหัวข้อ เพราะย่อหน้าของบรีฟเอง
// หักล้างทันทีว่าเกมเหล่านี้มีความเสี่ยงต่อการสูญเสียเงิน และไม่มีรูปแบบใดรับประกัน
// ผลกำไรจากการเดิมพัน
//
// ⚠️ รูปในหน้านี้ใช้ได้แค่ gamedemo8 กับ gamedemo16 เท่านั้น — เป็นอาร์ตสต็อกกลาง
// ของเทมเพลต (mtime 2026-08-04) ไม่ใช่อาร์ตเวิร์กของแบรนด์นี้ จึงอยู่ต่อได้ แต่ alt
// ต้องบรรยายภาพจริง และห้ามเอ่ยชื่อแบรนด์ใด เพราะไม่มีชื่อแบรนด์ไหนปรากฏอยู่บนรูป
// ทั้งสองใบ (สีที่ alt บรรยายคือสีที่วาดอยู่บนอาร์ตสต็อกจริง ไม่ใช่สีของพาเลตต์
// รอบนี้ — ห้าม "แก้สี" ใน alt ให้เข้าแบรนด์ เพราะนั่นทำให้ alt บรรยายผิด เปิดอ่าน
// บิตแมปทั้งสองใบซ้ำแล้วรอบนี้ ข้อความ alt ยังตรงกับภาพจริงทุกองค์ประกอบ)
// ส่วน gamedemo7/9/10/11/12/14/15/17/18 มีโลโก้หรือชื่อของผู้ให้บริการ
// เจ้าอื่นพิมพ์ทับอยู่กลางรูป และ gamedemo13 เป็นภาพล่อแหลม — ห้ามนำกลับมาใช้
// เพราะเท่ากับอ้างชื่อที่บรีฟไม่ได้เอ่ย ไฟล์ยังอยู่บนดิสก์ ห้ามลบ เป็นอินเวนทอรี
// gamedemo8 ("POPULAR GAME" 600x379) กับ gamedemo16 ("New Game" 650x411)
// ความกว้างที่วาดจริงสูงสุด ~600px ต่อใบ (กริดสองคอลัมน์ในการ์ด) จึงไม่ขยายเกิน
// ต้นฉบับ quality={62} ของสองใบนี้ตั้งไว้ต่ำกว่าค่าปกติ 80 มาตั้งแต่รอบก่อน เพราะ
// อาร์ตมีเกรนละเอียดจนไฟล์ AVIF เคยโตกว่า WebP ของตัวเอง (verify-build จะแดง)
// ห้ามดันกลับขึ้น — เป็นค่าต่อรูป ไม่ใช่การจูนต่อฟอร์แมต
// ⚠️ slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion ห้ามอ้างจากหน้านี้ ·
// banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ · banner2/banner3
// และ slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน (slide3 เป็นโปสเตอร์หวยของ LOTTOPLUS)
// ห้าม import (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// ⚠️ ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 24ชม. · 3 ขั้นตอน ส่วนตัวเลข
// และชื่อเฉพาะที่ห้ามแต่งขึ้นเองอยู่ครบใน brand-spec §6
//
// 🚨 ประโยคกำกับความเสี่ยงของบรีฟที่ห้ามตัดทิ้ง (เป็นเนื้อหาของบรีฟ ไม่ใช่ filler)
// และห้ามเขียนเสริมให้กลายเป็นคำโฆษณาที่บรีฟกำลังเตือนเรื่องนั้นอยู่:
// ควรตรวจสอบกติกา เงื่อนไขการเดิมพัน และข้อมูลผู้ให้บริการก่อนเริ่มใช้งานทุกครั้ง ·
// เกมเหล่านี้มีความเสี่ยงต่อการสูญเสียเงิน และไม่มีรูปแบบใดรับประกันผลกำไรจากการ
// เดิมพัน · เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือ
// รับประกันผลตอบแทนในอนาคต · แม้โปรโมชั่นจะระบุว่าไม่จำกัด แต่ควรตรวจสอบข้อกำหนด
// เกี่ยวกับจำนวนผู้เข้าร่วม ยอดที่นำมาคำนวณ รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัส ·
// ตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีหรือ
// บุคคลที่แอบอ้างชื่อบริการ · ไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น ·
// ควรตรวจสอบเวลาการให้บริการและระยะเวลาตอบกลับล่าสุดจากช่องทางทางการอีกครั้ง
//
// Announcement รอบนี้หมุนมาเป็น AnnouncementPremium ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ Announcement5 จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็น
// คอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นข้อความ
// ตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ทองจักรพรรดินำ · แดงชาดรอง · ทองแดงที่สาม ·
// บรอนซ์ลึก/น้ำตาลไหม้ไม่เคยถือตัวอักษร · บนพื้นดำสนิท**
// ⚠️ **รอบนี้กลับขั้วจากรอบก่อน** (มีเฮ168 แดงนำ ทองเนยรอง) มาเป็นทองนำ แดงรอง
// **แต่ทองเคยนำมาแล้วเกือบทุกแบรนด์ และแดงเคยนำมาแล้วสี่แบรนด์** "มีทองอยู่" หรือ
// "มีแดงอยู่" จึงไม่ใช่ตัวบอกว่าถูกแบรนด์ ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน
// brand-spec §2 (ค่าเดิมไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ
// false positive) ทองรอบนี้คือ **#f0bb4e** (+#ffeccb ครีมทอง +#d9701a ทองแดง
// +#5c2a06 บรอนซ์ลึก) และแดงรอบนี้คือ **แดงชาด #e4021b**
// ลำดับความลึก: #3b1b0e ผิวยก (= การ์ด) / #260d04 กลาง / #0d0501 จม / #000000 พื้นเพจ
// ลำดับปุ่มสื่อด้วยขั้ว "พื้นทองตัน vs กรอบทองโปร่ง vs ผิวจมขอบแดงชาด":
// ปุ่มสมัครสมาชิกถมไล่เฉด #ffeccb → #f0bb4e ขอบ #d9701a หมึก #2b1400
// (15.1:1 บนปลายครีม · 9.9:1 บนปลายทอง) · ปุ่มเข้าสู่ระบบเป็นกรอบทองโปร่ง
// พื้นผิวจม #260d04 → #0d0501 ขอบ #f0bb4e/80 ตัวอักษร #f0bb4e (11.5:1 บนผิวจม) ·
// ปุ่มลิงก์ภายในเป็นผิวจมขอบแดงชาด #e4021b/70 ตัวอักษร #fff8ec และ hover ยกขอบ
// เป็นทอง · ขอบรูปใช้ทองแบรนด์ #f0bb4e โปร่ง (ฮิวนำต้องเห็นจริงบนหน้า) ·
// marker ของลำดับเลขใช้ครีมทอง #ffeccb (13.4:1 บนผิวการ์ด — เป็นตัวอักษร จึงใช้
// แดงชาดไม่ได้เด็ดขาด และ #f0bb4e สงวนไว้ให้ <strong> เท่านั้น)
// 🚨 **แดงชาด #e4021b ได้แค่ 3.2:1 บนผิวการ์ด (4.3:1 บนพื้นดำ) = ตก AA ทุกพื้น**
// จึงเป็น **สีขอบ/พื้นถม/ไอคอนเท่านั้น ห้ามถือตัวอักษรทุกขนาด** ถ้าต้องมีตัวอักษร
// บนแดง ให้ถมแดงเป็นพื้นแล้ววาง #fff8ec ทับ (4.6:1 ผ่าน AA)
// ⚠️ ห้ามกลับด้าน: พื้นถมทอง/ครีมต้องใช้หมึกเข้ม #2b1400 เสมอ ห้ามขาวหรือครีม และ
// #5c2a06 #2b1400 เป็นเส้น ขอบ ออรา และพื้นถมเท่านั้น ห้ามถือตัวอักษรบนพื้นเข้ม
// ออราในไฟล์นี้ใช้ rgba(240,187,78,α) · rgba(228,2,27,α) เท่านั้น · รอบนี้ไม่มี
// ฟ้า/น้ำเงิน ไม่มีม่วง ไม่มีเขียว (นอกจาก LINE) ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์
// ไม่มีเหลืองมะนาว และไม่มีชมพู/ฟูเชีย ส้มตัวเดียวที่อนุญาตคือทองแดง #d9701a
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #fff8ec)
// ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง ปล่อยให้สืบทอดลงมา
// และไม่ใส่ mx-auto / max-w-* บน <p> — มีแค่ปุ่ม ขอบรูป marker ของลำดับเลข และ
// <strong> ที่ประกาศสี โดย <strong> ใช้ทองน้ำผึ้ง #f0bb4e ตัวเดียว (8.8:1 บนผิว
// การ์ด) และแต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทย
// ไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง
// และห้ามวาง <strong> สองอันติดกัน
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 156 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} หน้ารวมวิธีไล่ดูเกมสล็อต ยิงปลา ไฮโล และหวยออนไลน์ พร้อมกติกา อัตราจ่าย และเงื่อนไขการเดิมพัน ให้ครบก่อนตัดสินใจสมัครสมาชิกและใช้งานจริง`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ไล่ดูเกมสล็อต ยิงปลา ไฮโล และหวยออนไลน์ก่อนเข้าใช้งานจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#f0bb4e]">{BRAND_NAME} รวบรวมเกมสล็อต ยิงปลา ไฮโล และหวยออนไลน์ ไว้ในเว็บไซต์เดียว</strong>
        พร้อมเมนูสมัครสมาชิก เข้าสู่ระบบ ฝากถอน และตรวจสอบโปรโมชั่น หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับระบบได้ไล่ดูให้ครบหนึ่งรอบก่อนเข้าใช้งานจริง ตั้งแต่ประเภทเกมที่เปิดให้บริการ กติกาและอัตราจ่ายของแต่ละเกม
        ไปจนถึงขั้นตอนลงทะเบียนและเงื่อนไขของโปรโมชั่นที่เปิดให้เข้าร่วม
      </p>

      <p>
        คำว่า ทดลองเล่น ที่หน้านี้พูดถึงจึงหมายถึง
        <strong class="text-[#f0bb4e]">การศึกษารายละเอียดของเกมและเงื่อนไขบริการก่อนเริ่มต้นทำรายการ</strong>
        ไม่ใช่การแจกเครดิตทดลอง และไม่ใช่การรับประกันผลของรายการใดรายการหนึ่ง หากพบข้อสงสัยระหว่างใช้งานสามารถสอบถามเจ้าหน้าที่ผ่านช่องทางทางการได้
      </p>

      <p>
        อีกเรื่องที่ควรไล่ดูไปพร้อมกันคือข้อกำหนดการเปิดบัญชีสมาชิกและการใช้ข้อมูลส่วนบุคคล รวมถึงรายละเอียดของโปรโมชั่นที่กำลังสนใจ
        <strong class="text-[#f0bb4e]">เพราะเกมเหล่านี้มีความเสี่ยงต่อการสูญเสียเงิน และไม่มีรูปแบบใดรับประกันผลกำไรจากการเดิมพัน</strong>
        การอ่านให้ครบตั้งแต่ก่อนเริ่มจึงช่วยให้ทราบว่าแต่ละรายการมีเงื่อนไขอย่างไร และจะได้รับเครดิตในรอบเวลาใด
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ไล่ดูประเภทเกมและกติกาให้ครบก่อนเลือกเกมที่สนใจ" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        หลังเข้าสู่ระบบ ลำดับการไล่ดูจะเป็นชุดเดียวกันทุกครั้ง
        <strong class="text-[#f0bb4e]">เปิดรายชื่อเกมที่เปิดให้บริการจริง ลองเปิดเกมที่สนใจดูว่าแสดงผลบนหน้าจอที่ใช้งานได้ตามปกติไหม แล้วจึงอ่านกติกาและอัตราจ่ายของเกมนั้นต่อ</strong>
        เกมสล็อตมีธีมและฟีเจอร์แตกต่างกัน เกมยิงปลาเน้นการเลือกเป้าหมาย ไฮโลใช้ผลการทอยลูกเต๋า ส่วนหวยออนไลน์มีรูปแบบการเลือกหมายเลขของตัวเอง การไล่ดูให้ครบหนึ่งรอบก่อนจึงช่วยให้สอบถามเจ้าหน้าที่ได้ตรงประเด็นเมื่อมีข้อสงสัย
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={popularGamesImage}
          alt="ภาพการ์ดหมวดเกมยอดนิยม พื้นหลังโทนทองเข้มมีแสงไฟเมืองและชิปวงกลมหลากสีลอยกระจาย กลางภาพเป็นข้อความ POPULAR GAME ตัวอักษรสามมิติสีทอง ด้านซ้ายเป็นกระต่ายการ์ตูนสวมเสื้อแจ็กเก็ตยีนส์ยืนข้างหีบสมบัติที่มีเหรียญทองล้นออกมา ด้านขวาเป็นแมวการ์ตูนสวมแว่นกันแดดและหูฟัง และกลางล่างเป็นชิปทองสลักสัญลักษณ์โพดำ"
          loading="lazy"
          fetchpriority="low"
          decoding="async"
          widths={[300, 600]}
          sizes="(max-width: 639px) 100vw, 600px"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={62}
          class="mx-auto block h-auto w-full max-w-[600px] rounded-2xl border border-[#f0bb4e]/55"
        />

        <Picture
          src={newGamesImage}
          alt="ภาพการ์ดหมวดเกมเปิดใหม่ พื้นหลังสีน้ำเงินสดและลานกระเบื้องเรืองแสงสีชมพู-ฟ้า กลางภาพเป็นข้อความ New Game ตัวอักษรสามมิติสีขาวขอบฟ้า ด้านซ้ายเป็นตัวการ์ตูนหัวฟักทองเรืองแสงสวมหมวกปีกกว้าง ด้านขวาเป็นโครงกระดูกการ์ตูนยิ้มชูแขน รอบภาพมีดาวสีเหลือง ชิป และบล็อกสีสดลอยอยู่"
          loading="lazy"
          fetchpriority="low"
          decoding="async"
          widths={[300, 600]}
          sizes="(max-width: 639px) 100vw, 600px"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={62}
          class="mx-auto block h-auto w-full max-w-[600px] rounded-2xl border border-[#f0bb4e]/55"
        />
      </div>

      <ul class="flex flex-col gap-3" aria-label="จุดที่ควรไล่ดูให้ครบก่อนเข้าใช้งานจริง">
        <li class="flex gap-3">
          <span aria-hidden="true">🎰</span>
          <span>
            <strong class="text-[#f0bb4e]">รายชื่อเกมและประเภทการเดิมพันที่เปิดให้บริการ</strong> ควรเปิดดูจากหน้าเว็บไซต์ทางการว่ามีเกมใดเปิดให้บริการจริงบ้าง เนื่องจากรายการเกมที่เปิดอยู่อาจเปลี่ยนแปลงได้ตามการให้บริการของแต่ละช่วงเวลา
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">📖</span>
          <span>
            <strong class="text-[#f0bb4e]">กติกาและอัตราจ่ายของแต่ละเกม</strong> ควรเปิดอ่านเป็นรายเกมก่อนเข้าใช้งาน เพราะแต่ละประเภทกำหนดกติกาและข้อกำหนดการจ่ายไว้ไม่เหมือนกัน และควรลองเปิดบนหน้าจอที่ใช้งานจริงว่าแสดงผลได้ตามปกติไหม
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">💠</span>
          <span>
            <strong class="text-[#f0bb4e]">อัตราเดิมพันและเงื่อนไขการเดิมพัน</strong> ควรดูควบคู่กับงบประมาณที่ตั้งไว้ เพื่อให้ทราบว่าเกมที่กำลังสนใจเหมาะกับที่วางแผนไว้หรือไม่ เพราะเกมแต่ละประเภทอาจกำหนดอัตราเดิมพันแตกต่างกัน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">💬</span>
          <span>
            <strong class="text-[#f0bb4e]">ข้อมูลผู้ให้บริการและช่องทางติดต่อเจ้าหน้าที่</strong> ควรรู้ไว้ตั้งแต่ก่อนเริ่มว่าช่องทางทางการที่เว็บไซต์ระบุไว้อยู่ตรงไหน และควรตรวจสอบเวลาการให้บริการกับระยะเวลาตอบกลับล่าสุดอีกครั้ง
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#f0bb4e]">สิ่งที่การไล่ดูช่วยได้คือทำให้รู้ว่าเกมและเงื่อนไขอยู่ตรงไหนเท่านั้น</strong>
        ไม่ได้เป็นการรับประกันผลของรายการหรือยอดเครดิตที่จะได้รับ รายละเอียดที่เว็บไซต์แสดงอยู่ขณะใช้งานจึงเป็นสิ่งที่ควรยึดเป็นหลัก และควรเปิดดูซ้ำทุกครั้งที่กลับเข้ามาใหม่
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/about-us"
          aria-label={`อ่านหน้าเกี่ยวกับเราของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#e4021b]/70 bg-gradient-to-b from-[#260d04] to-[#0d0501] px-8 py-3 font-bold text-[#fff8ec] shadow-[0_0_12px_rgba(228,2,27,0.45)] transition-all hover:scale-105 hover:border-[#f0bb4e] hover:shadow-[0_0_18px_rgba(240,187,78,0.4)]">
          อ่านเกี่ยวกับเรา
        </a>

        <a
          href="/promotion"
          aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#e4021b]/70 bg-gradient-to-b from-[#260d04] to-[#0d0501] px-8 py-3 font-bold text-[#fff8ec] shadow-[0_0_12px_rgba(228,2,27,0.45)] transition-all hover:scale-105 hover:border-[#f0bb4e] hover:shadow-[0_0_18px_rgba(240,187,78,0.4)]">
          ดูภาพโปรโมชั่น
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="สิ่งที่ควรตรวจสอบให้ครบก่อนสมัครสมาชิกและเข้าสู่ระบบ" as="h2">
    <div class="flex flex-col gap-5">
      <p>
        การไล่ดูระบบมีประโยชน์ที่สุดเมื่อมองว่าเป็นการอ่านรายละเอียดให้จบก่อน
        <strong class="text-[#f0bb4e]">เป้าหมายคือรู้ว่าเว็บไซต์รวบรวมอะไรไว้ให้ศึกษาบ้าง แต่ละรายการมีเงื่อนไขอย่างไร และสอบถามเจ้าหน้าที่ได้ทางไหนเมื่อมีข้อสงสัย</strong>
        รายการด้านล่างคือชุดที่ควรตรวจก่อนลงทะเบียน และควรตรวจซ้ำทุกครั้งที่กลับเข้ามาใหม่ เพราะเงื่อนไขปรับเปลี่ยนได้ตามที่เว็บไซต์กำหนด
      </p>

      <ol class="ml-6 list-decimal space-y-3 marker:font-black marker:text-[#ffeccb]">
        <li>
          <strong class="text-[#f0bb4e]">ที่อยู่เว็บไซต์ทางการ</strong> ควรตรวจสอบให้ถูกต้องก่อนเลือกเมนูสมัครสมาชิกหรือกรอกข้อมูลใด ๆ ไม่ใช่เปิดจากลิงก์ที่ส่งต่อกันมา และควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ
          เพื่อหลีกเลี่ยงบัญชีหรือบุคคลที่แอบอ้างชื่อบริการ
        </li>
        <li>
          <strong class="text-[#f0bb4e]">ข้อกำหนดการเปิดบัญชีสมาชิก</strong> ควรอ่านให้ครบถ้วนก่อนสมัคร ทั้งคุณสมบัติผู้สมัครและนโยบายข้อมูลส่วนบุคคล แล้วจึงกรอกข้อมูลตามที่ระบบกำหนดและตรวจสอบความถูกต้องก่อนยืนยันการลงทะเบียน
        </li>
        <li>
          <strong class="text-[#f0bb4e]">กติกาและข้อมูลผู้ให้บริการ</strong> ควรเปิดอ่านเป็นรายเกมก่อนเข้าใช้งาน เพราะเกมสล็อต ยิงปลา ไฮโล และหวยออนไลน์ มีรูปแบบการเล่นและอัตราเดิมพันต่างกัน และควรอ่านอัตราจ่ายไปพร้อมกัน
        </li>
        <li>
          <strong class="text-[#f0bb4e]">เมนูฝากถอนและรายการที่ทำได้จริง</strong> ควรเปิดดูขั้นตอนทำรายการฝากถอนที่เว็บไซต์ระบุไว้ รวมถึงระยะเวลาดำเนินการ ก่อนเริ่มทำรายการจริงครั้งแรก
        </li>
        <li>
          <strong class="text-[#f0bb4e]">ข้อมูลที่จะส่งให้เจ้าหน้าที่ตรวจสอบ</strong> ควรตั้งรหัสผ่านที่ปลอดภัย ไม่ใช้ข้อมูลของบุคคลอื่นในการลงทะเบียน และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น แม้จะอ้างว่าเป็นเจ้าหน้าที่ก็ตาม
        </li>
      </ol>

      <p>
        <strong class="text-[#f0bb4e]">การอ่านให้ครบตั้งแต่ก่อนเริ่มช่วยให้แจ้งเรื่องได้ตรงประเด็นเมื่อเกิดปัญหาขึ้นจริง</strong>
        หากพบปัญหาในการทำรายการ ควรเตรียมข้อมูลและหลักฐานที่เกี่ยวข้องไว้สำหรับการตรวจสอบ พร้อมแจ้งรายละเอียดให้ชัดเจนเมื่อติดต่อเจ้าหน้าที่ผ่านช่องทางทางการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`โปรโมชั่นและช่องทางติดต่อแอดมิน ${BRAND_NAME} ตลอด 24ชม.`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        เมื่อคุ้นเคยกับขั้นตอนการใช้งานแล้ว เรื่องถัดไปคือรายการโปรโมชั่นที่เว็บไซต์ระบุไว้ ซึ่งมีทั้ง
        <strong class="text-[#f0bb4e]">คืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อน โบนัส 0.8% ไม่จำกัด</strong>
        โดยรายการแรกระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขในแต่ละวัน จึงควรตรวจสอบว่าเกมประเภทใดเข้าร่วมรายการบ้าง มีรอบเวลาคำนวณยอดเมื่อใด และรับเครดิตด้วยวิธีใด รวมถึงอ่านข้อกำหนดเกี่ยวกับการใช้โบนัสและการถอนเงินให้ครบถ้วน
        ทั้งนี้ เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือรับประกันผลตอบแทนในอนาคต
      </p>

      <p>
        ส่วนรายการแนะนำเพื่อนควรศึกษาวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และหลักเกณฑ์การคำนวณโบนัสให้ครบถ้วนก่อนเข้าร่วม แม้โปรโมชั่นจะระบุว่าไม่จำกัด
        แต่ควรตรวจสอบข้อกำหนดเกี่ยวกับจำนวนผู้เข้าร่วม ยอดที่นำมาคำนวณ รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสให้ชัดเจน
        <strong class="text-[#f0bb4e]">หากมีข้อสงสัยสามารถติดต่อเจ้าหน้าที่ผ่านช่องทางทางการเพื่อสอบถามรายละเอียดเพิ่มเติมได้</strong>
        โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่นไม่ว่ากรณีใด
      </p>

