---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";

import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login, /register)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริง
// ของ LOTTOPLUS เท่านั้น
//
// LOTTOPLUS เป็น **เว็บหวยออนไลน์** ส่วนแบรนด์ก่อนหน้าเป็นเว็บคาสิโน ทั้งหน้า
// เดิมพูดเรื่องบาคาร่า สล็อต เกมไพ่ ค่ายเกม — คำชุดนั้นถูกถอดออกทั้งหมด ห้าม
// find-and-replace ชื่อแบรนด์ทับประโยคเดิม มิฉะนั้นเว็บหวยจะไปอ้างสินค้าคนละตัว
// ที่ไม่มีอยู่ในบรีฟรอบนี้เลยสักคำ (คำห้าม: คาสิโน บาคาร่า สล็อต เกมไพ่ ค่ายเกม
// RTP ผู้ให้บริการเกม เดิมพันกีฬา/บอล เว็บตรง ใบอนุญาต)
//
// บรีฟไม่ได้ระบุว่ามีโหมดเดโม เครดิตทดลอง หรือเครดิตฟรี — จึงห้ามสัญญาสินค้าตัวนั้น
// "ทดลองเล่น" ที่หน้านี้หมายถึงการเปิดใช้งานจริงผ่านเบราว์เซอร์โดยไม่ติดตั้งแอป
// ไล่ดูประเภทหวยที่เปิดรับ รอบและอัตราจ่าย แล้วตรวจโพยให้ครบก่อนกดยืนยัน
//
// ข้อเท็จจริงทุกบรรทัดมาจาก src/assets/content.txt เท่านั้น: ให้บริการหวยออนไลน์
// ผ่านหน้าเว็บไซต์ สมัคร/เข้าใช้งานผ่านเบราว์เซอร์บนมือถือได้โดยไม่ต้องติดตั้งแอป ·
// รวมหวยรัฐบาลไทย ลาวพัฒนา ฮานอย หวยหุ้น ไว้ในบัญชีเดียว · เลือกเลข ส่งโพย
// ตรวจสอบรายการ ตรวจผลหวย ฝากถอน · หวยหุ้นมีรอบเดิมพันต่างกันในแต่ละวัน ·
// ตรวจเวลาปิดรับก่อนส่งโพย · หลังส่งควรตรวจโพย เลขที่เลือก ยอดเดิมพัน สถานะรายการ ·
// ตรวจผลอ้างอิงผลอย่างเป็นทางการของหวยแต่ละประเภท · อัตราจ่าย 2 ตัว 100 และ
// 3 ตัว 1,000 ขึ้นกับประเภทหวย รูปแบบการแทง และรอบที่เปิดรับ · คืนยอดเสีย 0.3% ·
// แนะนำเพื่อน 0.8% · ฝากเข้าบัญชีบริษัทตรง ไม่ผ่านตัวแทน · แอดมิน 24 ชั่วโมง ·
// ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP
// — ตัวเลขที่อ้างได้มีเท่านี้ ห้ามเพิ่มชื่อธนาคาร ขั้นต่ำฝาก เลขใบอนุญาต หรือจำนวน
// ขั้นตอนที่บรีฟไม่ได้นับไว้
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: banner1/banner1-mobile/og.png เป็นของ glob ที่
// MainLayout ปักไว้ ห้ามอ้างจากหน้า · slide1/slide4 ของดรอปนี้เป็นของ index และ
// /promotion · slide2/slide3/banner2/banner3 ห้าม import (ลำพังการ import ก็ทำให้
// ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น AnnouncementHuay ทั้งเว็บ — default message ของไฟล์นั้น
// เป็นคอปปี้ของ LOTTOPLUS แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้น
// ข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ LOTTOPLUS เป็น **แดงนำ ทองรอง บนดำ** ตามโลโก้ (ตัวอักษรขาวบนบล็อกแดง
// #dc020e) กับแบนเนอร์พื้นดำที่มีลูกหวยแดง-ขาวและเหรียญทอง: แดงสว่าง #ff2d38 ·
// แดงแบรนด์ #dc020e · แดงลึก #6b0207 · ทองอ่อน #fde79a · ทองรอง #f3c623 ·
// ทองลึก #8a6a0a · ผิวการ์ด #120b0c · ผิวการ์ดอุ่น #1f0a0c · แผง #2a0d0f ·
// เนื้อความ #f0e2e2 (BRAND_TEXT) · เน้นใน strong #fff4f4 · หมึกบนพื้นทอง #1a0203
// ชุดทอง-ดำของแบรนด์ก่อน (#fcc403 #fdda04 #e0a800 #8a6502 #fff0a8 #e9e4d6 #fffbea
// #120d02 #101010 #191712 rgba(252,196,3,*)) ออกครบทุกจุดแล้ว ทั้งคลาส Tailwind
// raw hex และ rgba() ที่ใช้ทำแสงเรือง
// กฎคอนทราสต์: พื้นทอง → หมึกเข้ม #1a0203 · พื้นแดง → ตัวอักษรขาว · เลขลำดับและ
// ไอคอนในลิสต์ใช้ #ff2d38 สลับ #f3c623 (แดงแบรนด์ #dc020e บนการ์ดดำได้แค่ 3.8:1)
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลางที่ orchestrator รีธีมรอบนี้) — การ์ดตั้ง
// สีเนื้อความไว้ให้แล้ว ย้ำไว้บนย่อหน้าอีกชั้นเพื่อให้สีของ body copy อ่านออกจาก
// ตัวหน้าเอง
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 157
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription =
  "ทดลองเล่น LOTTOPLUS ผ่านเว็บเบราว์เซอร์บนมือถือโดยไม่ต้องติดตั้งแอป ไล่ดูประเภทหวย รอบที่เปิดรับ และอัตราจ่าย พร้อมตรวจโพยให้ครบทุกจุดก่อนยืนยันส่งรายการจริง";

const pageTitle = "ทดลองเล่น LOTTOPLUS เปิดผ่านเบราว์เซอร์ ลองเลือกหวยก่อนส่งโพย";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        <strong class="text-[#fff4f4]">LOTTOPLUS</strong> ให้บริการหวยออนไลน์ผ่านหน้าเว็บไซต์ จึง
        <strong class="text-[#fff4f4]">สมัครและเข้าใช้งานผ่านเบราว์เซอร์บนมือถือได้โดยไม่จำเป็นต้องติดตั้งแอป</strong>
        หน้านี้เปิดไว้ให้คนที่ยังไม่คุ้นกับระบบได้ลองเปิดใช้งานจริงหนึ่งรอบ ตั้งแต่หน้าเลือกประเภทหวย ไปจนถึงหน้าส่งโพยและหน้าตรวจผล ก่อนจะลงเงินกับรอบไหนจริง
      </p>

      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        คำว่า “ทดลองเล่น” ที่หน้านี้พูดถึงจึงหมายถึง<strong class="text-[#fff4f4]">การเดินให้ครบทุกขั้นของการใช้งาน ตั้งแต่ Login เลือกประเภทหวย ดูรอบที่เปิดรับ ไปจนถึงตรวจสอบรายการและตรวจผลหวย</strong>
        ไม่ใช่เครดิตทดลองหรือโหมดจำลองผลรางวัล เพราะเมื่อรู้ว่าแต่ละหน้าจอแสดงข้อมูลอะไรไว้ การส่งโพยจริงรอบแรกจะเหลือแค่การตัดสินใจเรื่องเลขและยอดเดิมพัน
      </p>
    </div>
  </ContentBox>

  <ContentBox title="เปิด LOTTOPLUS ผ่านเบราว์เซอร์บนมือถือ ไม่ต้องติดตั้งแอป" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        จุดที่ช่วยให้เริ่มต้นได้เร็วที่สุดคือ<strong class="text-[#fff4f4]">หวยหลายประเภทถูกรวมไว้ในบัญชีเดียว และสลับรายการได้จากหน้าเดิม</strong>
        สมาชิกเปิดเว็บไซต์จากเบราว์เซอร์บนมือถือแล้วใช้งานต่อได้ทันที ไม่ต้องดาวน์โหลดแอปเพิ่มและไม่ต้องสลับเว็บไซต์ไปมาเวลาอยากเปลี่ยนประเภทหวย
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#f0e2e2]">
        <li class="flex gap-3">
          <span class="font-bold text-[#ff2d38]">1.</span>
          <span><strong class="text-[#fff4f4]">เปิดเว็บไซต์ LOTTOPLUS จากช่องทางหลักก่อน</strong> การเข้าผ่านช่องทางที่เว็บไซต์ประกาศไว้จริงช่วยหลีกเลี่ยงเว็บไซต์ที่ไม่เกี่ยวข้อง แล้วบันทึกทางเข้านั้นไว้ใช้รอบถัดไป</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#f3c623]">2.</span>
          <span>
            <strong class="text-[#fff4f4]">สมัครและยืนยันบัญชีตามที่ระบบกำหนด แล้ว Login</strong> ขั้นตอนทั้งหมดทำผ่านหน้าเว็บบนมือถือได้ หลังเข้าสู่ระบบจะเห็นเครดิต ประวัติโพย และโปรโมชั่นของบัญชีตัวเอง
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#ff2d38]">3.</span>
          <span>
            <strong class="text-[#fff4f4]">เลือกประเภทหวยที่ระบบเปิดรับในขณะนั้น</strong> ทั้งรัฐบาลไทย ลาวพัฒนา ฮานอย และหวยหุ้น รายการที่เปิดรับเปลี่ยนไปในแต่ละวัน จึงควรดูจากหน้าเว็บไซต์เป็นหลัก
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#f3c623]">4.</span>
          <span>
            <strong class="text-[#fff4f4]">ดูเวลาปิดรับและอัตราจ่ายของรอบนั้นให้ครบ</strong> ก่อนเลือกเลข เพราะหวยแต่ละรายการใช้อัตราจ่ายไม่เท่ากัน และรอบที่ปิดรับแล้วจะส่งโพยเข้าไปไม่ได้
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#ff2d38]">5.</span>
          <span>
            <strong class="text-[#fff4f4]">ลองกรอกโพยแล้วอ่านหน้าสรุปก่อนกดยืนยัน</strong> ขั้นนี้คือขั้นที่ควรทำช้าที่สุด เพราะเป็นหน้าจอสุดท้ายที่ยังแก้เลขและยอดเดิมพันได้ก่อนรายการจะถูกบันทึก
          </span>
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        <strong class="text-[#fff4f4]">รายการหวยที่เปิดรับ เวลาปิดรับ และเงื่อนไขของโปรโมชั่นเปลี่ยนแปลงได้ตามช่วงเวลา จึงควรตรวจสอบข้อมูลจากช่องทางอย่างเป็นทางการของเว็บไซต์ทุกครั้งก่อนทำรายการ</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title="เลือกประเภทหวย รัฐบาลไทย ลาวพัฒนา ฮานอย หวยหุ้น จากบัญชีเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        ระหว่างไล่ดูระบบ สิ่งที่ควรจำให้ได้คือ<strong class="text-[#fff4f4]">หวยแต่ละแนวมีรอบและรูปแบบเลขของตัวเอง</strong>
        ไม่ได้ใช้เวลาปิดรับหรืออัตราจ่ายชุดเดียวกันทั้งหมด การรู้ว่าแนวไหนเปิดรับตอนไหนช่วยให้เลือกรอบที่เหมาะกับเวลาของตัวเองได้เร็วขึ้น
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f0e2e2]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ff2d38]">🏛️</span>
          <span>
            <strong class="text-[#fff4f4]">หวยรัฐบาลไทย</strong> เปิดรับตามรอบออกรางวัล จึงเป็นแนวที่รอบชัดที่สุดสำหรับคนเริ่มต้น ลองดูว่าหน้าเว็บไซต์แสดงรอบถัดไปและเวลาปิดรับของรอบนั้นไว้ตรงไหน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f3c623]">🎫</span>
          <span>
            <strong class="text-[#fff4f4]">หวยลาวพัฒนาและหวยฮานอย</strong> เปิดรับตามรายการที่ระบบประกาศในแต่ละวัน บางวันมีหลายรายการ ควรอ่านชื่อรายการให้ตรงกับรอบที่ต้องการก่อนเลือกเลข
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ff2d38]">📈</span>
          <span>
            <strong class="text-[#fff4f4]">หวยหุ้นมีรอบเดิมพันแตกต่างกันในแต่ละวัน</strong> จึงเป็นแนวที่ต้องดูเวลาปิดรับละเอียดที่สุด หากมีหลายรอบต่อวันควรตรวจชื่อรายการและเวลาของรอบให้ตรงกันก่อนส่งโพย
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f3c623]">🔢</span>
          <span>
            <strong class="text-[#fff4f4]">รูปแบบเลข 2 ตัวและ 3 ตัวของแต่ละรายการ</strong> เลือกประเภทเลขจากหน้าส่งโพยได้เอง และอัตราจ่ายที่ใช้กับรูปแบบนั้นจะแสดงอยู่ในรอบนั้น ไม่ใช่ตัวเลขชุดเดียวกันทุกรายการ
          </span>
        </li>
      </ul>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/ตรวจหวย"
          aria-label="เปิดหน้าตรวจผลหวยของ LOTTOPLUS"
          class="flex items-center justify-center rounded-lg border border-[#dc020e]/80 bg-[#2a0d0f] px-8 py-3 font-bold text-[#f0e2e2] shadow-[0_0_15px_rgba(220,2,14,0.22)] transition-all hover:scale-105 hover:border-[#ff2d38] hover:bg-[#1f0a0c] hover:text-[#ff2d38]">
          ไปหน้าตรวจผลหวย
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="จุดที่ควรตรวจให้ครบก่อนยืนยันส่งโพย" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        การไล่ดูระบบมีประโยชน์ที่สุดเมื่อมองมันเหมือนการอ่านคู่มือ ไม่ใช่การลุ้นรางวัล
        <strong class="text-[#fff4f4]">เป้าหมายคือรู้จักหน้าจอทุกหน้าให้ครบก่อนที่เงินจริงจะเข้ามาเกี่ยวข้อง</strong>
