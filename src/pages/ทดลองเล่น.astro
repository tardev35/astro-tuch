---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import popularGamesImage from "../assets/gamedemo8.webp";
import newGamesImage from "../assets/gamedemo16.webp";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริง
// ของบรีฟรอบนี้เท่านั้น (src/assets/content.txt) ไม่ใช่แก้ทับประโยคของแบรนด์ก่อน
// — ของเดิมเป็นคอปปี้ "เว็บหลักรวมทุกหมวด" ของแบรนด์ก่อนหน้า ซึ่งขัดกับแบรนด์รอบนี้
// ทั้งหน้า และย่อหน้าเก่าทั้งย่อหน้าตั้งอยู่บนคำที่ brand-spec §6 สั่งห้าม จึงต้อง
// เขียนใหม่ ไม่ใช่ find-and-replace
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// ดรอปนี้ (2026-10-09) คือ **เว็บเล่นสล็อตออโต้ รวมเกมจากค่ายหลักไว้ในแพลตฟอร์ม
// เดียว** ไม่ใช่เว็บรวมทุกหมวดแบบรอบก่อน และรอบนี้ไม่มีหมวดลอตเตอรีเลย (สองหน้าของ
// หมวดนั้นจอดอยู่ใน src/pages-disabled/ ไม่มี route จึงห้ามลิงก์ไปหา มิฉะนั้นเป็น href ตาย
// ที่ทำให้ build แดง) แง่มุมที่บรีฟระบุไว้มีเท่านี้: รวมเกมสล็อตหลายรูปแบบไว้ใน
// แพลตฟอร์มเดียว (สล็อตคลาสสิก เกมโบนัส ฟรีสปิน ตัวคูณ เกมรูปแบบใหม่) · เล่นผ่าน
// มือถือได้โดยไม่ต้องติดตั้งโปรแกรมเพิ่มเติม · เลือกค่าย ค้นหาเกม ตรวจสอบเครดิต
// ติดตามรายการจากบัญชีเดียว · บางเกมเบทเริ่มต้น 1 บาทตามช่วงเดิมพันที่ค่ายกำหนด ·
// ตารางจ่ายและอัตราการคืนเงินผู้เล่น · คืนยอดเสีย 0.3% เข้ายูส · แนะนำเพื่อน 0.8%
// แชร์ลิงก์ · ยอดที่เข้าเกณฑ์ · รอบคำนวณ · ฝากถอนเข้าบริษัทโดยตรง บัญชีปลายทาง
// นิติบุคคล หลักฐานธุรกรรม · แอดมิน 24 ชั่วโมง · รหัสผ่าน PIN OTP
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามี "โหมดทดลอง" เครดิตทดลอง หรือเดโมฟรีเป็นบริการของเว็บ —
// จึงห้ามสัญญาสินค้าตัวนั้น คำว่า "ทดลองเล่น" บนหน้านี้จึงหมายถึงสิ่งที่บรีฟระบุไว้
// ตรงๆ ว่าทำได้: เปิดเว็บไล่ดูหมวดเกมและเมนูให้ครบหนึ่งรอบ ดูช่วงเดิมพันกับตารางจ่าย
// ของเกม อ่านเงื่อนไขของโปรโมชั่น และตรวจสอบเครดิตกับรายการต่างๆ ก่อนจะเริ่มเล่นจริง
//
// ⚠️ รูปในหน้านี้ใช้ได้แค่ gamedemo8 กับ gamedemo16 เท่านั้น — เป็นอาร์ตสต็อกกลาง
// ของเทมเพลต ไม่ใช่อาร์ตเวิร์กของแบรนด์นี้ จึงอยู่ต่อได้ แต่ alt ต้องบรรยายภาพจริง
// (รอบนี้เปิดรูปอ่านซ้ำแล้ว ไม่ได้ลอก alt มาเฉยๆ) และห้ามเอ่ยชื่อแบรนด์ใด
// ส่วน gamedemo7/9/10/11/12/14/15/17/18 มีโลโก้หรือชื่อของผู้ให้บริการเจ้าอื่น
// พิมพ์ทับอยู่กลางรูป และ gamedemo13 เป็นภาพล่อแหลม — ห้ามนำกลับมาใช้ เพราะเท่ากับ
// อ้างชื่อที่บรีฟไม่ได้เอ่ย ไฟล์ยังอยู่บนดิสก์ ห้ามลบ เป็นอินเวนทอรี
// gamedemo8 ("POPULAR GAME" 600x379) กับ gamedemo16 ("New Game" 650x411) ไม่มี
// ชื่อแบรนด์ใดปรากฏ ความกว้างที่วาดจริงสูงสุด ~600px ต่อใบ (กริดสองคอลัมน์ในการ์ด)
// จึงไม่ขยายเกินต้นฉบับ
//
// ⚠️ คำที่ห้ามหลงเหลือ: ศัพท์ของหมวดอื่นที่ไม่ใช่สล็อต และคำขายของของแบรนด์ก่อนๆ
// ที่บรีฟรอบนี้ไม่ได้เอ่ย — รายการเต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อ
// ไม่ให้ grep หาคำต้องห้ามเจอ false positive รายการตรวจก่อนเริ่มเล่น (<ol> ด้านล่าง)
// รอบนี้เขียนใหม่ทั้งสี่ข้อให้อ้างเฉพาะสิ่งที่บรีฟพูดถึงจริง ของเดิมสองข้ออ้าง
// คำขายที่ถูกแบน
//
// ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 1 บาท · 0.3% · 0.8% · 24 ชั่วโมง
// ห้ามเติมเลขใบอนุญาต หน่วยงานกำกับ ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP ยอดฝากขั้นต่ำ
// จำนวนสมาชิก หรือปีที่ก่อตั้ง เพราะบรีฟไม่ได้เอ่ยไว้สักอย่าง
//
// ประโยคกำกับของบรีฟที่ห้ามตัดทิ้ง (เป็นส่วนหนึ่งของคอปปี้ ไม่ใช่ filler):
// จำนวนค่ายและเกมจริงตรวจได้จากหน้าเว็บไซต์ · แตกง่าย/ไม่มีขั้นต่ำควรพิจารณาจาก
// ข้อมูลเกมจริง เพราะผลการหมุนสล็อตเป็นแบบสุ่ม ไม่มีเกมใดรับประกัน · ควรอ่าน
// รายละเอียดก่อนรับสิทธิ์ · คำว่าไม่จำกัดควรตรวจสอบว่าหมายถึงอะไร · ชื่อบัญชีบริษัท
// อย่างเดียวไม่ได้รับประกันความปลอดภัย · ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP แม้ผู้นั้น
// จะอ้างว่าเป็นเจ้าหน้าที่
//
// banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion · banner2/banner3 และ
// slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import (ลำพังการ import ก็ทำให้
// ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น Announcement5 ทั้งเว็บ (รอบก่อนใช้ AnnouncementCyber —
// brand-spec §3 หมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้
// ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่ง
// จะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ม่วงนีออน x ทองอาร์เขต บนครามเกือบดำ**
// พลิกจากคู่แดงแล็กเกอร์-ทองของแบรนด์ก่อน ซึ่งออกครบทุกจุดแล้ว ทั้งคลาส Tailwind
// raw hex และ rgba() (ค่าเดิมอยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้
// grep หาสีแบรนด์เก่าเจอ false positive)
// ลำดับปุ่มสื่อด้วย "ทองถม vs ม่วงโปร่ง": ปุ่มหลักถมทองไล่ #ffd23d → #c98a05
// ขอบ #c98a05 หมึกม่วงเกือบดำ #190633 (11.0:1 บน #ffd23d) · ปุ่มรองและปุ่มลิงก์
// ภายในเป็นผิวการ์ด #1e0a3c → #110321 ขอบม่วง #a435f0/55 หมึกม่วงอ่อน #d2a6ff
// (7.4:1) · ขอบรูปใช้ม่วงแบรนด์แบบโปร่ง · marker ของลำดับเลขใช้ทองอุ่น #ffd23d
// ⚠️ ห้ามกลับด้าน: พื้นถมทองต้องใช้หมึกเข้มเสมอ ห้ามครีมหรือขาว (เหลือ ~1.3:1)
// และห้ามวางตัวอักษรสว่างบนม่วงสด #a435f0 (3.1:1 — brand-spec §2 ห้ามโดยตรง)
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #ece2ff)
// ไว้ที่ตัวการ์ดแล้ว ข้อความในหน้านี้จึงไม่ประกาศสีของตัวเองเลย ปล่อยให้สืบทอดลงมา
// — มีแค่ปุ่ม ขอบรูป และ marker ของลำดับเลขที่ประกาศสี เพราะเป็นพื้น/เส้น ไม่ใช่
// เนื้อความ ส่วนไฮไลต์ในเนื้อความใช้ทองสว่าง #fbe455 ที่ <strong> เท่านั้น และแต่ละ
// <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ
// ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 159 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} ด้วยการไล่ดูหมวดเกมสล็อตและเมนูในระบบจริงให้ครบ ทั้งการเลือกค่าย ตรวจสอบเครดิต ประวัติรายการ และเงื่อนไขโปรโมชั่น ก่อนเริ่มเล่นจริงทุกครั้ง`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ไล่ดูหมวดเกมสล็อตและเมนูในระบบก่อนเริ่มเล่นจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong>{BRAND_NAME}</strong> เล่นสล็อตออโต้ผ่านระบบออนไลน์ที่รวบรวมเกมสล็อตจากค่ายหลักไว้ในแพลตฟอร์มเดียว
        <strong>ทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน ตัวคูณ และเกมรูปแบบใหม่ โดยรองรับการใช้งานผ่านมือถือโดยไม่ต้องติดตั้งโปรแกรมเพิ่มเติม</strong>
        หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับระบบได้ไล่ดูให้ครบหนึ่งรอบ ตั้งแต่เมนูเลือกค่ายและการค้นหาเกม ไปจนถึงการตรวจสอบเครดิต การติดตามรายการต่างๆ และเงื่อนไขของโปรโมชั่น ก่อนจะเริ่มเล่นจริง
      </p>

      <p>
        คำว่า ทดลองเล่น ที่หน้านี้พูดถึงจึงหมายถึง
        <strong>การเปิดเว็บไซต์ไล่ดูหมวดเกมสล็อตที่เปิดให้เลือก ดูช่วงเดิมพันกับตารางจ่ายของแต่ละเกม อ่านเงื่อนไขของโปรโมชั่นที่เปิดอยู่ และดูว่าข้อมูลแต่ละอย่างแสดงไว้ตรงไหนของหน้าจอ</strong>
        ซึ่งเป็นสิ่งที่ระบบเปิดให้ทำได้อยู่แล้ว ไม่ใช่การแจกเครดิตทดลอง ไม่ใช่การหมุนฟรี และไม่ใช่การรับประกันผลของเกมใดเกมหนึ่ง เมื่อเข้าสู่ระบบแล้ว สมาชิกจะเลือกค่าย ค้นหาเกม ตรวจสอบเครดิต และติดตามรายการต่างๆ ได้จากบัญชีเดียว
      </p>

      <p>
        อีกเรื่องที่ควรไล่ดูไปพร้อมกันคือขอบเขตของสิ่งที่เปิดให้บริการจริง
        <strong>จำนวนค่ายและเกมที่เปิดให้บริการจริงสามารถตรวจสอบได้จากหน้าเว็บไซต์</strong>
        เพราะรายชื่อที่เปิดอยู่เปลี่ยนแปลงได้ตามช่วงเวลา การไล่ดูด้วยตัวเองหนึ่งรอบจึงให้ข้อมูลตรงกว่าถ้อยคำบนหน้าประชาสัมพันธ์ และใช้ตัดสินใจได้จริงกว่าค่าที่จำไว้จากรอบก่อนหน้า
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`หมวดเกมสล็อตและเมนูที่ ${BRAND_NAME} เปิดให้ไล่ดูจากบัญชีเดียว`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        หลังเข้าสู่ระบบ ลำดับการใช้งานจะเป็นชุดเดียวกันทุกครั้ง
        <strong>เปิดเมนูเลือกค่าย ค้นหาเกมสล็อตที่สนใจ ตรวจสอบเครดิตของตัวเอง อ่านรายการโปรโมชั่นที่เปิดอยู่ แล้วจึงติดตามรายการต่างๆ ย้อนหลัง</strong>
        การไล่ดูให้ครบรอบหนึ่งก่อนจึงช่วยให้รู้ว่าข้อมูลแต่ละอย่างอยู่ตรงไหนของหน้าจอ และหาเมนูที่ต้องใช้จริงได้เร็วขึ้นในครั้งถัดไป
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={popularGamesImage}
