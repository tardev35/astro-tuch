---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { pageGraph } from "../lib/schema";

// หวยกินดี365 เป็นเว็บหวยออนไลน์ ไม่ใช่คาสิโน/สล็อต หน้านี้จึงหมายถึงการทำความรู้จัก
// ระบบส่งโพย ประเภทหวยและรอบ เลข 2 ตัว/3 ตัว อัตราจ่าย และการเช็กบิลย้อนหลัง
// ก่อนแทงด้วยเครดิตจริง — ห้ามเขียนถึงเกมสล็อต/คาสิโนทดลองเล่นในหน้านี้
//
// แบรนด์เก่าเคยวางแกลเลอรี 12 การ์ด (gamedemo7..18.webp) ไว้ที่หน้านี้ ถูกถอดออกไปตั้งแต่
// เจ็ดรอบรีแบรนด์ก่อน และไม่มีการ import แล้ว — อย่านำกลับมา เหตุผลมีสองชั้น: ลำพังการ import
// ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดงถ้ามีรูปที่ไม่มีใคร render ทั้งชุด
// ยังเป็นภาพของ "askmeslot" ซึ่งเป็นโลโก้เว็บอื่น การนำกลับมาคือการโชว์แบรนด์คู่แข่ง
// บนหน้าเว็บของ หวยกินดี365
//
// ทุกข้อความอ้างอิง src/assets/content.txt เท่านั้น ไม่มีการอ้างใบอนุญาต การจดทะเบียน
// ปีที่ก่อตั้ง รางวัล จำนวนสมาชิก หรือการันตีผลกำไร
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 154
const pageDescription = "หน้าทดลองเล่นของ หวยกินดี365 แนะนำวิธีคุ้นเคยกับระบบส่งโพย ตั้งแต่เลือกประเภทหวยและรอบ เลือกเลข 2 ตัว 3 ตัว ตรวจอัตราจ่าย จนถึงเช็กบิลย้อนหลัง ก่อนแทงจริง";

const graph = pageGraph(Astro, {
  name: "ทดลองเล่น หวยกินดี365 ทำความรู้จักระบบส่งโพยก่อนแทงด้วยเครดิตจริง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title="ทดลองเล่น หวยกินดี365 ลองใช้ระบบส่งโพยหวยออนไลน์ก่อนแทงด้วยเครดิตจริง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่น หวยกินดี365 ทำความรู้จักระบบส่งโพยก่อนแทงด้วยเครดิตจริง" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dce7fb]">
        <strong class="text-[#fbe473]">หวยกินดี365</strong> เป็นเว็บแทงหวยออนไลน์ที่รวมหวยรัฐบาลไทย ลาวพัฒนา ฮานอย 3 รูปแบบ และหุ้นต่างประเทศไว้ในบัญชีเดียว
        รองรับทั้งสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ หน้านี้จึงเปิดไว้ให้ผู้เริ่มต้นได้<strong class="text-[#fbe473]">ทำความคุ้นเคยกับขั้นตอนส่งโพย ตรวจอัตราจ่าย และดูเวลาเปิด-ปิดรับ</strong>
        ก่อนยืนยันการแทงด้วยเครดิตของตัวเอง เพราะหวยแต่ละประเภทและแต่ละรอบกำหนดเงื่อนไขไว้ไม่เหมือนกัน
      </p>

      <p class="text-left text-base leading-relaxed text-[#dce7fb]">
        ขอให้เข้าใจตรงกันว่าการทดลองเล่นเป็นการทำความคุ้นเคยกับระบบเท่านั้น
        <strong class="text-[#fbe473]">ผลของหวยแต่ละรอบไม่แน่นอน ไม่มีเลขหรือสูตรใดรับประกันผลได้เสียล่วงหน้า</strong>
        หากติดปัญหาระหว่างใช้งาน แจ้งเจ้าหน้าที่ หวยกินดี365 ได้ตลอด 24 ชั่วโมง พร้อมประเภทหวย รอบเดิมพัน เวลา และรายละเอียดของรายการ เพื่อให้ตรวจสอบได้ตรงจุด
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="ขั้นตอนส่งโพยของ หวยกินดี365 ตั้งแต่เลือกรอบจนถึงยืนยันโพย" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dce7fb]">
        ลำดับการใช้งานจริงมีอยู่ไม่กี่ขั้น และเป็นลำดับเดียวกันทุกประเภทหวย ลองไล่ดูให้ครบก่อนใช้เครดิตจริง จะช่วยให้เห็นว่ารายการหนึ่งถูกคิดผลมาจากอะไรบ้าง
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#dce7fb]">
        <li class="flex gap-3"><span class="font-bold text-[#f6db6b]">1.</span> เปิดหน้าสมัคร หวยกินดี365 และกรอกข้อมูลตามที่ระบบกำหนด ทำผ่านมือถือหรือคอมพิวเตอร์ได้โดยตรง</li>
        <li class="flex gap-3"><span class="font-bold text-[#f6db6b]">2.</span> เข้าสู่ระบบ แล้วฝากเครดิตผ่านระบบออโต้ ทั้งธนาคารหรือวอลเลทที่ระบบเปิดรองรับ</li>
        <li class="flex gap-3"><span class="font-bold text-[#f6db6b]">3.</span> เลือกประเภทหวยและรอบที่ต้องการ ทั้งรัฐบาลไทย ลาวพัฒนา ฮานอย 3 รูปแบบ หรือหุ้นต่างประเทศ</li>
        <li class="flex gap-3"><span class="font-bold text-[#f6db6b]">4.</span> เลือกเลข 2 ตัวหรือ 3 ตัวจากหน้าส่งโพย แล้วตรวจอัตราจ่ายกับเวลาปิดรับของรอบนั้น</li>
        <li class="flex gap-3"><span class="font-bold text-[#f6db6b]">5.</span> ระบุยอดเดิมพันที่รับได้ ยืนยันโพย แล้วเก็บบิลไว้เช็กย้อนหลังเมื่อผลออก</li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#93a8ce]">
        ก่อนกดยืนยันควรทวนอีกครั้งว่าเลือกประเภทหวยและรอบถูกต้อง เพราะเป็นจุดที่ผิดพลาดได้ง่ายที่สุดเมื่อหลายตลาดเปิดรับพร้อมกัน
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ตรวจอัตราจ่ายและเวลาเปิด-ปิดรับก่อนระบุยอดเดิมพัน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dce7fb]">
        อัตราจ่ายที่กำหนดไว้คือ <strong class="text-[#fbe473]">เลข 2 ตัว บาทละ 100</strong> และ<strong class="text-[#fbe473]">เลข 3 ตัว บาทละ 1,000</strong>
        ตัวเลขชุดนี้คือสิ่งที่ใช้คำนวณยอดตามเรท จึงควรเปิดดูให้ครบพร้อมกับเวลาปิดรับของรอบ ก่อนตัดสินใจว่าจะลงเท่าไร
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#dce7fb]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f6db6b]">2️⃣</span>
          <span><strong class="text-[#fbe473]">เลข 2 ตัว</strong> ลง 10 บาทด้วยเรท 1 ต่อ 100 หากผลตรงตามเงื่อนไข ยอดตามเรทจะเท่ากับ 1,000 บาท</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f6db6b]">3️⃣</span>
          <span><strong class="text-[#fbe473]">เลข 3 ตัว</strong> ลง 10 บาทด้วยเรท 1 ต่อ 1,000 หากผลตรงตามเงื่อนไข ยอดตามเรทจะเท่ากับ 10,000 บาท</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f6db6b]">⏰</span>
          <span><strong class="text-[#fbe473]">เวลาเปิด-ปิดรับ</strong> ต่างกันตามประเภทหวยและรอบ ตลาดหุ้นต่างประเทศกับฮานอยไม่ได้ปิดรับพร้อมหวยรัฐบาลไทย</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f6db6b]">💰</span>
          <span><strong class="text-[#fbe473]">ยอดเดิมพัน</strong> ควรกำหนดล่วงหน้าเป็นหน่วยย่อย เช่น มีทุน 1,000 บาท ให้คิด 1 หน่วยเท่ากับ 10 บาท แล้ววางยอดต่อเลขให้อยู่ในระดับที่รับได้</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#93a8ce]">
        เวลาเปิด-ปิด อัตราจ่าย และเงื่อนไขต่างกันตามประเภทหวยและรอบ ให้ยึดข้อมูลที่ระบบแสดงบนหน้าส่งโพย ณ เวลานั้นเป็นหลัก ไม่ใช่ตัวเลขที่จำมาจากรอบก่อน
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="เช็กบิลย้อนหลังและดูแลความปลอดภัยของบัญชีสมาชิก" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dce7fb]">
        เมื่อส่งโพยสำเร็จ ระบบจะเก็บรายการไว้ในประวัติของบัญชีสมาชิก ทำให้<strong class="text-[#fbe473]">เช็กบิลย้อนหลังได้ด้วยตัวเอง</strong>
        ทั้งประเภทหวย รอบ เลขที่เลือก ยอดที่ลง และอัตราจ่ายที่ใช้ตอนนั้น ควรเก็บข้อมูลบิลไว้จนกว่าจะตรวจผลเสร็จ เผื่อต้องใช้เป็นข้อมูลให้เจ้าหน้าที่ตรวจสอบ
      </p>

      <ul class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#dce7fb]">
        <li class="flex gap-3">
          <span class="text-[#f6db6b]" aria-hidden="true">•</span> หน้านี้อธิบายการใช้งานและการลองเลือกเลขเท่านั้น การแทงจริงต้องสมัครสมาชิกและฝากเครดิตผ่านช่องทางที่เปิดให้บริการก่อน
        </li>
        <li class="flex gap-3">
          <span class="text-[#f6db6b]" aria-hidden="true">•</span> ตรวจสอบช่องทางฝากเงิน ยอดขั้นต่ำ และวงเงินต่อรายการล่าสุดบนหน้าฝากถอนก่อนยืนยันธุรกรรมทุกครั้ง
        </li>
        <li class="flex gap-3">
          <span class="text-[#f6db6b]" aria-hidden="true">•</span> ตั้งจุดหยุดเมื่อเสียและจุดที่จะพักเมื่อได้กำไรไว้ตั้งแต่ก่อนเริ่ม แล้วหยุดตามแผน ไม่เพิ่มยอดแทงเพื่อไล่เอาเงินคืน
        </li>
        <li class="flex gap-3">
          <span class="text-[#f6db6b]" aria-hidden="true">•</span> <strong class="text-[#fbe473]">ไม่ควรเปิดเผยรหัสผ่านหรือ OTP แก่บุคคลอื่น</strong> ไม่ว่าจะเป็นการติดต่อจากช่องทางใดก็ตาม
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#dce7fb]">
        หากส่งโพยไม่สำเร็จ ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง เข้าสู่ระบบไม่ได้ หรือพบยอดในบิลไม่ตรงกับรายการ แจ้งเจ้าหน้าที่ หวยกินดี365 พร้อมประเภทหวย รอบเดิมพัน เวลา และจำนวนเงินได้ตลอด 24 ชั่วโมง
        <strong class="text-[#fbe473]">การเดิมพันมีความเสี่ยง ควรกำหนดงบประมาณให้เหมาะสมทุกครั้ง</strong>
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก หวยกินดี365"
          class="flex items-center justify-center rounded-lg border border-[#f6db6b]/70 bg-gradient-to-r from-[#fbe473] via-[#f6db6b] to-[#c9a23a] px-8 py-3 font-black text-[#03153b] shadow-[0_0_15px_rgba(246,219,107,0.30)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ หวยกินดี365"
          class="flex items-center justify-center rounded-lg border border-[#f6db6b]/60 bg-transparent px-8 py-3 font-bold text-[#fbe473] transition-all hover:scale-105 hover:border-[#fbe473] hover:bg-[#062a6b]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>

  <Navfoot />
</MainLayout>
