---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";

import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login, /register)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริง
// ของ หวย365 เท่านั้น (src/assets/content.txt)
//
// หวย365 เป็น **เว็บแทงหวยออนไลน์** ที่รวมข้อมูลและรายการหวยไว้ในหน้าเดียว แง่มุมที่
// บรีฟระบุไว้มีเท่านี้: แนวทางหวย · กลุ่มหวย · สถิติหวยย้อนหลัง · ผลหวยตามรอบที่
// ประกาศ · รัฐบาลไทย / ฮานอยหลายรอบ / ลาวพัฒนา / หุ้นต่างประเทศตามตลาดที่เปิด ·
// บัญชีเดียวครบทุกประเภทหวย · เลือกเลข ส่งโพย ตรวจเวลาเปิดรับ-ปิดรับและอัตราจ่าย
// ก่อนยืนยัน · รองรับมือถือ · สมัคร 3 ขั้นตอน · แอดมิน 24 ชั่วโมง ·
// 2 ตัว จ่าย 100 บาท · 3 ตัว จ่าย 1,000 บาท
//
// แบรนด์ก่อนหน้า (หวยเฮง789 / หวยเฮง24) เป็นเว็บหวยเหมือนกันแต่คนละบรีฟ — "เลขเด็ด"
// "เลขดัง" "ไม่จำกัด" "แทงได้ไม่อั้น" "ฮานอยปกติ/พิเศษ/วีไอพี" "ฝากถอนวอลเลท" และ
// "หวยลาว" เฉย ๆ เป็นของบรีฟรอบก่อน รอบนี้ไม่ได้ระบุไว้เลยจึงถอดออกทั้งชุด
// ห้าม find-and-replace ชื่อแบรนด์ทับประโยคเดิม มิฉะนั้นเว็บจะไปอ้างสินค้าที่ไม่มีอยู่จริง
// บรีฟรอบนี้สะกดว่า **ลาวพัฒนา** ไม่ใช่ "ลาว"
// (คำห้ามจาก brand-spec §6: สล็อต ฟรีสปิน RTP บาคาร่า คาสิโน บอล ค่าน้ำ
// อัตราต่อรอง ลีก)
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามี "โหมดทดลอง" เครดิตทดลอง หรือเกมเดโมเป็นบริการของเว็บ —
// จึงห้ามสัญญาสินค้าตัวนั้น และห้ามดึง src/assets/gamedemo*.webp กลับมาเด็ดขาด
// เพราะเป็นอาร์ตสล็อต/คาสิโนทั่วไปของเทมเพลตที่ไม่เกี่ยวกับแบรนด์หวยรายนี้เลย
// หน้านี้จึงพูดถึงเฉพาะสิ่งที่ผู้เข้าชม "ดูได้จริง" ก่อนส่งโพยแรกตามที่บรีฟระบุไว้:
// เลือกประเภทหวยและรอบ เลือกเลขเอง ดูเวลาเปิดรับ-ปิดรับ ตรวจอัตราจ่าย เปิดดูแนวทาง
// กลุ่มหวย สถิติย้อนหลัง และผลหวย แล้วตรวจรายละเอียดโพยก่อนยืนยัน ทั้งหมดผ่านมือถือได้
//
// ตัวเลขที่อ้างได้มีแค่ 100 บาท · 1,000 บาท · 3 ขั้นตอน · 24 ชั่วโมง
// ห้ามเพิ่มชื่อผู้ให้บริการ ชื่อธนาคาร ขั้นต่ำฝากถอน เลขใบอนุญาต ปีที่ก่อตั้ง
// จำนวนสมาชิก ความเร็วฝากถอน หรือ "อันดับ 1" ที่บรีฟไม่ได้ระบุ · บรีฟรอบนี้ไม่มี
// โปรโมชั่น/โบนัสเลยสักรายการ
//
// hedge ของบรีฟที่ห้ามตัดทิ้ง: สถิติย้อนหลังและแนวทางหวยเป็นข้อมูลประกอบ ไม่รับประกัน
// ผลของงวดถัดไป · อัตราจ่ายและวงเงินต่างกันตามประเภทหวยและรอบ · ให้ยึดรายละเอียด
// ล่าสุดในหน้าส่งโพย · ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: banner1/banner1-mobile/og.png เป็นของ glob ที่
// MainLayout ปักไว้ ห้ามอ้างจากหน้า · slide1/slide2 ของดรอปนี้เป็นของ index และ
// /promotion · slide3/slide4/banner2/banner3 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น AnnouncementCyber ทั้งเว็บ (รอบก่อน หวยเฮง789 ใช้
// Announcement2) — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ หวย365
// แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ หวย365 (brand-spec §2) **แดงสดนำ ทองรอง**: แดงแบรนด์ #dc0203 ·
// แดงสว่าง #f5282a · แดงลึก #9c0201 · ทอง #ffc93c · ทองอ่อน (หมึกเน้น) #ffeab0 ·
// ทองลึก (ขอบ/ปลายไล่เฉด) #c08a07 · การ์ด #240406 · แถบบาร์ #180303 ·
// เนื้อความ #f6e7e0 (BRAND_TEXT) · หมึกบนพื้นทอง #1a0303
// เรืองแสง: แดง rgba(220,2,3,*) · ทอง rgba(255,201,60,*) · เงา rgba(8,1,1,*)
// ชุดของ หวยเฮง789 (#dc2224 #f4bc5d #ffefc2 #fbe3d4 #2b0909 #1c0606 #e43434
// #a8690c #d99a10 rgba(244,188,93,*) rgba(220,34,36,*)) ออกครบทุกจุดแล้ว
// กฎคอนทราสต์: พื้นทอง → หมึกเข้ม #1a0303 · ห้ามวางขาวบนทอง · ห้ามวางหมึกเข้มบนแดง
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลางที่ orchestrator รีธีมรอบนี้) — การ์ดตั้ง
// สีเนื้อความไว้ให้แล้ว ย้ำไว้บนย่อหน้าอีกชั้นเพื่อให้สีของ body copy อ่านออกจาก
// ตัวหน้าเอง
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 157
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "ทดลองเล่น หวย365 ด้วยการไล่ดูระบบจริงให้ครบก่อนส่งโพยใบแรก ตั้งแต่เลือกประเภทหวยและรอบ อ่านแนวทางและสถิติย้อนหลัง ดูเวลาปิดรับ ไปจนถึงตรวจอัตราจ่ายก่อนยืนยัน";

const pageTitle = "ทดลองเล่น หวย365 ไล่ดูรายการหวย แนวทาง และสถิติย้อนหลังก่อนส่งโพยจริง";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f6e7e0]">
        <strong class="text-[#ffeab0]">หวย365</strong> เป็นเว็บแทงหวยออนไลน์ที่รวมข้อมูลและรายการหวยไว้ในหน้าเดียว
        <strong class="text-[#ffeab0]">ทั้งแนวทางหวย กลุ่มหวย สถิติหวยย้อนหลัง และผลหวยตามรอบที่ประกาศ</strong> หน้านี้เปิดไว้ให้คนที่ยังไม่คุ้นกับระบบได้ลองเปิดใช้งานจริงหนึ่งรอบ ตั้งแต่หน้ารายการหวยที่เปิดรับ
        ไปจนถึงหน้าสรุปโพยที่แสดงเลขที่เลือกและอัตราจ่าย ก่อนจะยืนยันโพยใบแรก
      </p>

      <p class="text-left text-base leading-relaxed text-[#f6e7e0]">
        คำว่า “ทดลองเล่น” ที่หน้านี้พูดถึงจึงหมายถึง<strong class="text-[#ffeab0]">
          การเดินให้ครบทุกขั้นของการใช้งาน ตั้งแต่ Login เลือกประเภทหวยและรอบ เลือกตัวเลขเอง ดูเวลาเปิดรับและเวลาปิดรับ อ่านอัตราจ่าย ไปจนถึงตรวจสอบรายละเอียดโพยก่อนยืนยันรายการ
        </strong>
        ระบบรองรับการใช้งานผ่านมือถือ จึงติดตามรอบหวย ส่งโพย และตรวจสอบผลได้จากหน้าเว็บไซต์ ซึ่งเป็นสิ่งที่ผู้เข้าชมไล่ดูได้ทั้งหมดก่อนส่งโพยจริงรอบแรก
      </p>
    </div>
  </ContentBox>

  <ContentBox title="เปิด หวย365 บนมือถือแล้วไล่ดูรอบหวยได้จากบัญชีเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f6e7e0]">
        จุดที่ช่วยให้เริ่มต้นได้เร็วที่สุดคือ<strong class="text-[#ffeab0]">รายการหวยหลายประเภทถูกรวมไว้ในบัญชีเดียว และสลับประเภทได้จากระบบเดิม</strong>
        สมาชิกจึงไม่ต้องสลับใช้งานหลายบัญชี และไล่ดูรอบที่สนใจได้จากหน้าเว็บไซต์เดียว
      </p>

      <ol class="ml-6 list-decimal space-y-3 text-left text-base leading-relaxed text-[#f6e7e0] marker:font-black marker:text-[#ffc93c]">
        <li>
          <strong class="text-[#ffeab0]">เปิดเว็บไซต์ หวย365 จากช่องทางหลักก่อน</strong> การเข้าผ่านช่องทางที่เว็บไซต์ประกาศไว้จริงช่วยหลีกเลี่ยงเว็บไซต์ที่ไม่เกี่ยวข้อง แล้วบันทึกทางเข้านั้นไว้ใช้รอบถัดไป
        </li>
        <li>
          <strong class="text-[#ffeab0]">สมัครและยืนยันข้อมูลตามที่ระบบกำหนด แล้ว Login</strong> ทั้งหมดทำผ่านมือถือได้ หลังเข้าสู่ระบบจะเห็นรายการหวยที่เปิดรับและประวัติรายการของบัญชีตัวเอง
        </li>
        <li>
          <strong class="text-[#ffeab0]">ไล่ดูประเภทหวยและรอบที่ระบบเปิดรับในขณะนั้น</strong> ทั้งรัฐบาลไทย ฮานอย ลาวพัฒนา และหวยหุ้นต่างประเทศ รายการที่เปิดรับจริงในแต่ละวันขึ้นอยู่กับตารางรอบของหวยแต่ละประเภท
          จึงควรดูจากรายการที่ระบบแสดงไว้เป็นหลัก
        </li>
        <li>
          <strong class="text-[#ffeab0]">เปิดดูเวลาเปิดรับ เวลาปิดรับ และอัตราจ่ายของรอบนั้นให้ครบ</strong> เพราะหวยแต่ละประเภทมีรอบของตัวเอง และอัตราจ่ายอาจไม่ได้ใช้เหมือนกันทุกประเภท
        </li>
        <li>
          <strong class="text-[#ffeab0]">ลองเลือกตัวเลขเองแล้วอ่านหน้าสรุปโพยก่อนกดยืนยัน</strong> ขั้นนี้คือขั้นที่ควรทำช้าที่สุด เพราะเป็นหน้าจอสุดท้ายที่ยังแก้รายการได้ก่อนโพยจะถูกบันทึก
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#f6e7e0]">
        <strong class="text-[#ffeab0]">ตารางรอบและเงื่อนไขของแต่ละรอบเปลี่ยนแปลงได้ตามช่วงเวลา จึงควรยึดรายละเอียดล่าสุดในหน้าส่งโพยของรอบนั้นทุกครั้งก่อนยืนยัน</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ประเภทหวยที่ลองไล่ดูได้ใน หวย365" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f6e7e0]">
        ระหว่างไล่ดูระบบ สิ่งที่ควรจำให้ได้คือ<strong class="text-[#ffeab0]">หวยแต่ละประเภทมีรอบและเวลาปิดรับของตัวเอง</strong>
        ไม่ได้ใช้เงื่อนไขชุดเดียวกันทั้งหมด การรู้ว่าแต่ละประเภททำงานอย่างไรช่วยให้เลือกรอบที่เหมาะกับจังหวะของตัวเองได้เร็วขึ้น
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f6e7e0]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ffc93c]">🏛️</span>
          <span>
            <strong class="text-[#ffeab0]">หวยรัฐบาลไทย</strong> เปิดรับตามกำหนดออกรางวัลของแต่ละงวด เป็นกลุ่มที่อ่านตารางได้ง่ายที่สุดสำหรับคนเริ่มต้น ลองดูว่าหน้าส่งโพยแสดงเวลาปิดรับของงวดนั้นไว้อย่างไร
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ffc93c]">🕒</span>
          <span>
            <strong class="text-[#ffeab0]">หวยฮานอย</strong> เปิดรับหลายรอบในแต่ละวัน จึงเป็นกลุ่มที่ควรอ่านชื่อหวยและรอบเวลาให้ละเอียดที่สุดก่อนยืนยัน เพื่อไม่ให้ส่งโพยผิดรอบ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ffc93c]">🎫</span>
          <span>
            <strong class="text-[#ffeab0]">หวยลาวพัฒนา</strong> เปิดรับตามรอบที่ระบบกำหนดเช่นกัน ลองเปิดดูสักรอบเพื่อให้เห็นว่าชื่อหวยและเวลาปิดรับถูกแสดงไว้ตรงไหนของหน้าส่งโพย
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ffc93c]">📈</span>
          <span>
            <strong class="text-[#ffeab0]">หวยหุ้นต่างประเทศ</strong> เปิดรับตามตลาดที่เปิดให้บริการ จำนวนรายการที่เลือกได้ในแต่ละวันจึงขึ้นอยู่กับตลาดที่เปิดในรอบนั้น
          </span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#f6e7e0]">
        แต่ละประเภทยังมีหมวดแนวทางหวย กลุ่มพูดคุย และสถิติย้อนหลังแยกไว้ให้เปิดดูคู่กัน
        <strong class="text-[#ffeab0]">ข้อมูลเหล่านี้เป็นข้อมูลประกอบเท่านั้น ไม่ได้เพิ่มความแน่นอนในการทายผลหวยรอบถัดไป</strong>
        และอัตราจ่ายกับวงเงินของแต่ละรายการก็อาจต่างกัน จึงควรยึดรายละเอียดล่าสุดที่หน้าส่งโพยแสดงไว้เป็นหลัก
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/แนวทาง"
          aria-label="เปิดหน้าแนวทางหวยของ หวย365"
