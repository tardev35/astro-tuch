---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import popularGamesImage from "../assets/gamedemo8.webp";
import newGamesImage from "../assets/gamedemo16.webp";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริง
// ของบรีฟรอบนี้เท่านั้น (src/assets/content.txt) ไม่ใช่แก้ทับประโยคของแบรนด์ก่อน
// — ของเดิมเป็นคอปปี้ "ฐานเล่นหลักรวมทุกหมวด" ของ KOON234 ซึ่งขัดกับแบรนด์รอบนี้ทั้งหน้า
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// ดรอปนี้ (2026-10-09) คือ **ฐานเข้าเล่นสล็อตเว็บหลัก — สล็อตล้วน** ไม่ใช่เว็บรวม
// ทุกหมวดแบบรอบก่อน แง่มุมที่บรีฟระบุไว้มีเท่านี้: รวมเกมสล็อตหลายรูปแบบไว้ในระบบ
// เดียว (สล็อตคลาสสิก เกมโบนัส ฟรีสปิน ตัวคูณ เกมใหม่) · เล่นผ่านมือถือได้สะดวก ·
// เมนูเลือกค่าย ตรวจสอบเครดิต ประวัติรายการ บัญชีสมาชิกเดียว · ถอนยอดส่งคำขอได้
// 24 ชั่วโมง แต่เวลาเงินเข้าแตกต่างกัน · ยอดขั้นต่ำ เงื่อนไขการถอน สถานะรายการ ·
// คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · ยอดที่เข้าเกณฑ์ · รอบคำนวณ · รอบตัดยอด ·
// สมัคร 3 ขั้นตอน · ยืนยันบัญชี · ช่องทางหลัก · เว็บไซต์เลียนแบบ ·
// แอดมิน 24 ชั่วโมง · รหัสผ่าน PIN OTP
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามี "โหมดทดลอง" เครดิตทดลอง หรือเดโมฟรีเป็นบริการของเว็บ —
// จึงห้ามสัญญาสินค้าตัวนั้น คำว่า "ทดลองเล่น" บนหน้านี้จึงหมายถึงสิ่งที่บรีฟระบุไว้
// ตรง ๆ ว่าทำได้: เปิดเว็บไล่ดูหมวดเกมและเมนูให้ครบหนึ่งรอบ อ่านเงื่อนไขของ
// โปรโมชั่น และตรวจสอบเครดิตกับประวัติรายการ ก่อนจะเริ่มเล่นจริง
//
// ⚠️ รูปในหน้านี้ใช้ได้แค่ gamedemo8 กับ gamedemo16 เท่านั้น — เป็นอาร์ตสต็อกกลาง
// ของเทมเพลต ไม่ใช่อาร์ตเวิร์กของแบรนด์นี้ จึงอยู่ต่อได้ แต่ alt ต้องบรรยายภาพจริง
// (รอบนี้เปิดรูปอ่านซ้ำแล้ว ไม่ได้ลอก alt ของรอบก่อน) และห้ามเอ่ยชื่อแบรนด์ใด
// ส่วน gamedemo7/9/10/11/12/14/15/17/18 มีโลโก้หรือชื่อของผู้ให้บริการเจ้าอื่น
// พิมพ์ทับอยู่กลางรูป และ gamedemo13 เป็นภาพล่อแหลม — ห้ามนำกลับมาใช้ เพราะเท่ากับ
// อ้างชื่อที่บรีฟไม่ได้เอ่ย ไฟล์ยังอยู่บนดิสก์ ห้ามลบ เป็นอินเวนทอรี
// gamedemo8 ("POPULAR GAME" 600x379) กับ gamedemo16 ("New Game" 650x411) ไม่มี
// ชื่อแบรนด์ใดปรากฏ ความกว้างที่วาดจริงสูงสุด ~600px ต่อใบ (กริดสองคอลัมน์ในการ์ด)
// จึงไม่ขยายเกินต้นฉบับ
//
// ⚠️ คำที่ห้ามหลงเหลือ: ศัพท์ของหมวดอื่นที่ไม่ใช่สล็อตซึ่งมาจากแบรนด์ก่อนๆ
// (เป็นของอินเวนทอรีที่จอดไว้) รวมถึงคำขายของที่บรีฟรอบนี้ไม่ได้เอ่ย —
// รายการเต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำต้องห้าม
// เจอ false positive · สองหน้าหมวดลอตเตอรียังจอดอยู่ใน src/pages-disabled/
//
// ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 24 ชั่วโมง · 3 ขั้นตอน
// ห้ามเติมเลขใบอนุญาต หน่วยงานกำกับ ชื่อผู้ดำเนินงาน ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP
// ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีที่ก่อตั้ง เพราะบรีฟไม่ได้เอ่ยไว้สักอย่าง
//
// ประโยคกำกับของบรีฟที่ห้ามตัดทิ้ง (เป็นส่วนหนึ่งของคอปปี้ ไม่ใช่ filler):
// ควรมีข้อมูลผู้ให้บริการและรายชื่อค่ายเกมที่ตรวจสอบได้ · ระยะเวลาที่เงินเข้าบัญชี
// อาจแตกต่างกัน · ควรอ่านรายละเอียดก่อนรับสิทธิ์ · คำว่าไม่จำกัดควรตรวจสอบ
// รายละเอียด · ไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP แม้ผู้นั้นจะอ้างว่าเป็นเจ้าหน้าที่
//
// banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion · banner2/banner3 และ
// slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import (ลำพังการ import ก็ทำให้
// ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น AnnouncementCyber ทั้งเว็บ (รอบก่อน KOON234 ใช้
// AnnouncementPremium ที่หน้าย่อย — brand-spec §3 หมุนออก) orchestrator ตั้ง
// default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare
// ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **แดงแล็กเกอร์ x ทอง บนแดงเกือบดำ** แบบตรุษจีน
// พลิกจากคู่มรกต-ทองบนเขียวเกือบดำของ KOON234 ซึ่งออกครบทุกจุดแล้ว ทั้งคลาส
// Tailwind raw hex และ rgba() (ค่าเดิมอยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive)
// ลำดับปุ่มสื่อด้วย "ทองถม vs ทองโปร่ง":
// ปุ่มหลักถมทองไล่ #ffd87a → #f5b61d → #b07a06 ขอบ #b07a06 หมึกแดงเกือบดำ #1c0503
// (10.7:1 บน #f5b61d) · ปุ่มรองและปุ่มลิงก์ภายในเป็นผิวการ์ด #2a0806 → #120302
// ขอบทอง #f5b61d/55 หมึกทองสว่าง #ffd87a (13.5:1) · ขอบรูปและ marker ของลำดับเลข
// ใช้ทองแบรนด์
// ⚠️ ห้ามกลับด้าน: พื้นถมทองต้องใช้หมึกเข้มเสมอ ห้ามครีมหรือขาว (เหลือ ~1.3:1)
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #fdeedd)
// ไว้ที่ตัวการ์ดแล้ว ข้อความในหน้านี้จึงไม่ประกาศสีของตัวเองเลย ปล่อยให้สืบทอดลงมา
// — มีแค่ปุ่ม ขอบรูป และ marker ของลำดับเลขที่ประกาศสี เพราะเป็นพื้น/เส้น ไม่ใช่เนื้อความ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 155 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} ด้วยการไล่ดูหมวดเกมสล็อตและเมนูในระบบจริงให้ครบ ทั้งการเลือกค่าย ตรวจสอบเครดิต ประวัติรายการ และเงื่อนไขโปรโมชั่น ก่อนเริ่มเล่นจริงทุกครั้ง`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ไล่ดูหมวดเกมสล็อตและเมนูในระบบก่อนเริ่มเล่นจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong>{BRAND_NAME}</strong> เป็นฐานเข้าเล่นสล็อตเว็บหลักที่รวบรวมเกมสล็อตหลากหลายรูปแบบไว้ในระบบเดียว
        <strong>ทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน ตัวคูณ และเกมใหม่จากค่ายที่เปิดให้บริการ โดยรองรับการเข้าเล่นผ่านมือถือได้สะดวก</strong>
        หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับระบบได้ไล่ดูให้ครบหนึ่งรอบ ตั้งแต่เมนูเลือกค่ายและหมวดเกม ไปจนถึงการตรวจสอบเครดิต ประวัติรายการ และเงื่อนไขของโปรโมชั่น ก่อนจะเริ่มเล่นจริง
      </p>

      <p>
        คำว่า ทดลองเล่น ที่หน้านี้พูดถึงจึงหมายถึง
        <strong>การเปิดเว็บไซต์ไล่ดูหมวดเกมสล็อตที่เปิดให้เลือก อ่านเงื่อนไขของโปรโมชั่นที่เปิดอยู่ และดูว่าข้อมูลแต่ละอย่างแสดงไว้ตรงไหนของหน้าจอ</strong>
        ซึ่งเป็นสิ่งที่ระบบเปิดให้ทำได้อยู่แล้ว ไม่ใช่การแจกเครดิตทดลอง ไม่ใช่การหมุนฟรี และไม่ใช่การรับประกันผลของเกมใดเกมหนึ่ง เมื่อเข้าสู่ระบบแล้ว สมาชิกจะตรวจสอบเครดิต โปรโมชั่น และประวัติรายการได้จากบัญชีสมาชิกเดียว
      </p>

      <p>
        อีกเรื่องที่ควรไล่ดูไปพร้อมกันคือที่มาของเว็บไซต์เอง
        <strong>การระบุว่าเป็นศูนย์รวมเกมสล็อตค่ายแท้ ไม่ผ่านเว็บตัวแทน ควรมีข้อมูลผู้ให้บริการและรายชื่อค่ายเกมที่ตรวจสอบได้</strong>
        เพื่อให้สมาชิกทราบรายละเอียดของแพลตฟอร์มก่อนใช้งาน ไม่ใช่ดูจากข้อความโฆษณาบนหน้าประชาสัมพันธ์เพียงอย่างเดียว
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`หมวดเกมสล็อตและเมนูที่ ${BRAND_NAME} เปิดให้ไล่ดูจากบัญชีเดียว`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        หลังเข้าสู่ระบบ ลำดับการใช้งานจะเป็นชุดเดียวกันทุกครั้ง
        <strong>เปิดเมนูเลือกค่าย ไล่ดูหมวดเกมสล็อตที่สนใจ ตรวจสอบเครดิตของตัวเอง อ่านรายการโปรโมชั่นที่เปิดอยู่ แล้วจึงดูประวัติรายการย้อนหลัง</strong>
        การไล่ดูให้ครบรอบหนึ่งก่อนจึงช่วยให้รู้ว่าข้อมูลแต่ละอย่างอยู่ตรงไหนของหน้าจอ และหาเมนูที่ต้องใช้จริงได้เร็วขึ้นในครั้งถัดไป
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={popularGamesImage}
          alt="ภาพการ์ดหมวดเกมยอดนิยม พื้นหลังโทนทองเข้มมีแสงไฟเมืองและชิปวงกลมหลากสีลอยกระจาย กลางภาพเป็นข้อความ POPULAR GAME ตัวอักษรสามมิติสีทอง ด้านซ้ายเป็นกระต่ายการ์ตูนสวมเสื้อแจ็กเก็ตยีนส์ยืนข้างหีบสมบัติที่มีเหรียญทองล้นออกมา ด้านขวาเป็นแมวการ์ตูนสวมแว่นกันแดดและหูฟัง และกลางล่างเป็นชิปทองสลักสัญลักษณ์โพดำ"
          loading="lazy"
          fetchpriority="low"
          decoding="async"
          widths={[300, 600]}
          sizes="(max-width: 639px) 100vw, 600px"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={62}
          class="mx-auto block h-auto w-full max-w-[600px] rounded-2xl border border-[#f5b61d]/30"
        />

        <Picture
          src={newGamesImage}
          alt="ภาพการ์ดหมวดเกมเปิดใหม่ พื้นหลังสีน้ำเงินสดและลานกระเบื้องเรืองแสงสีชมพู-ฟ้า กลางภาพเป็นข้อความ New Game ตัวอักษรสามมิติสีขาวขอบฟ้า ด้านซ้ายเป็นตัวการ์ตูนหัวฟักทองเรืองแสงสวมหมวกปีกกว้าง ด้านขวาเป็นโครงกระดูกการ์ตูนยิ้มชูแขน รอบภาพมีดาวสีเหลือง ลูกเต๋า ชิป และบล็อกสีสดลอยอยู่"
          loading="lazy"
          fetchpriority="low"
          decoding="async"
          widths={[300, 600]}
          sizes="(max-width: 639px) 100vw, 600px"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={62}
          class="mx-auto block h-auto w-full max-w-[600px] rounded-2xl border border-[#f5b61d]/30"
        />
      </div>

      <ul class="flex flex-col gap-3" aria-label="เมนูที่เปิดให้ตรวจสอบได้จากบัญชีเดียว">
        <li class="flex gap-3">
          <span aria-hidden="true">🎰</span>
          <span>
