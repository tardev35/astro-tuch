---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { pageGraph } from "../lib/schema";

// WIN8S เป็นเว็บสล็อตออนไลน์เว็บตรง ไม่ใช่เว็บคาสิโนครบวงจรและไม่ใช่เว็บหวย
// หน้านี้จึงหมายถึงการทำความรู้จักระบบสล็อตก่อนเดิมพันด้วยเครดิตจริง — ขั้นตอนสมัครและ
// ฝากเครดิต การเลือกเกมจากหลายค่าย การตรวจช่วงเดิมพัน รอบโบนัสและฟรีสปินของแต่ละเกม
// โปรโมชั่นที่ตรวจสอบได้หลัง Login และการดูประวัติรายการในบัญชีสมาชิก
// (รอบรีแบรนด์ก่อนหน้าเป็นเว็บคาสิโนสี่หมวด เนื้อหาเดิมจึงถูกเขียนใหม่ทั้งหน้าเป็นสล็อตล้วน)
//
// แบรนด์เก่าเคยวางแกลเลอรี 12 การ์ด (gamedemo7..18.webp) ไว้ที่หน้านี้ ถูกถอดออกไปตั้งแต่
// สิบรอบรีแบรนด์ก่อน และไม่มีการ import แล้ว — อย่านำกลับมา เหตุผลมีสองชั้น: ลำพังการ import
// ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดงถ้ามีรูปที่ไม่มีใคร render ทั้งชุด
// ยังเป็นภาพของ "askmeslot" ซึ่งเป็นโลโก้เว็บอื่น การนำกลับมาคือการโชว์แบรนด์คู่แข่ง
// บนหน้าเว็บของ WIN8S
//
// ทุกข้อความอ้างอิงบรีฟของแบรนด์นี้เท่านั้น: รวมเกมสล็อตจากหลายค่ายในบัญชีเดียว ·
// สล็อตคลาสสิก สล็อตวิดีโอ เกมโบนัส ฟรีสปิน · ปรับระดับเดิมพันได้ตามช่วงที่แต่ละเกมกำหนด
// และเริ่มต้น 1 บาทได้เมื่อเกมนั้นเปิดช่วงนั้นไว้ · ไม่มีเกมใดรับประกันว่า "แตกง่าย" ·
// โบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไข · ฝากถอนผ่านวอลเลทหรือธนาคารตาม
// ช่องทางที่รองรับ ตรวจขั้นต่ำและวงเงินล่าสุดในหน้าฝากถอน · แอดมิน 24 ชม.
// ไม่มีการอ้างใบอนุญาต การจดทะเบียน ปีที่ก่อตั้ง จำนวนสมาชิก การันตีผลกำไร ชื่อค่ายเกมรายใด
// หรือตาราง RTP ตายตัว
//
// Announcement หมุนมาใช้ Announcement5 ตัวเดียวกับ index — default message ของไฟล์นั้น
// เป็นข้อความของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ได้
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 157
const pageDescription =
  "หน้าทดลองเล่นของ WIN8S แนะนำวิธีทำความคุ้นเคยกับระบบสล็อตออนไลน์ ตั้งแต่สมัครสมาชิก ฝากเครดิตผ่านวอลเลท เลือกเกมจากหลายค่าย จนถึงตรวจช่วงเดิมพันก่อนเริ่มเล่น";

const graph = pageGraph(Astro, {
  name: "ทดลองเล่น WIN8S ทำความรู้จักระบบสล็อตออนไลน์ก่อนเดิมพันด้วยเครดิตจริง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title="ทดลองเล่น WIN8S ลองใช้ระบบสล็อตออนไลน์เว็บตรง รวมเกมหลายค่ายในที่เดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่น WIN8S ทำความรู้จักระบบสล็อตออนไลน์ก่อนเดิมพันด้วยเครดิตจริง" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f6e4d6]">
        <strong class="text-[#fff2e6]">WIN8S</strong> รวมเกมสล็อตออนไลน์จากหลายค่ายไว้ในบัญชีเดียว ทั้งสล็อตคลาสสิก สล็อตวิดีโอ เกมโบนัส
        ฟรีสปิน และเกมธีมต่าง ๆ รองรับการเล่นผ่านมือถือโดยไม่ต้องติดตั้งหลายระบบ
        หน้านี้จึงเปิดไว้ให้ผู้เริ่มต้นได้<strong class="text-[#fd9a1e]">ทำความคุ้นเคยกับขั้นตอนใช้งาน ตรวจช่วงเดิมพัน รอบโบนัส และฟีเจอร์ของแต่ละเกม</strong>
        ก่อนเดิมพันด้วยเครดิตของตัวเอง เพราะรายละเอียดเหล่านี้ต่างกันไปตามค่ายและตามเกมที่เลือก
      </p>

      <p class="text-left text-base leading-relaxed text-[#f6e4d6]">
        ขอให้เข้าใจตรงกันว่าการทดลองเล่นเป็นการทำความคุ้นเคยกับระบบเท่านั้น
        <strong class="text-[#fd9a1e]">เกมสล็อตมีผลลัพธ์ไม่แน่นอน จึงไม่มีเกมใดรับประกันว่า “แตกง่าย” หรือสร้างกำไรได้ทุกครั้ง</strong>
        ควรเลือกเกมจากกติกา รูปแบบการเดิมพัน และงบประมาณที่เหมาะสมกับตนเอง หากติดปัญหาระหว่างใช้งาน แจ้งแอดมิน WIN8S ได้ตลอด 24 ชั่วโมง
        พร้อมชื่อเกม เวลา จำนวนเงิน และรายละเอียดของรายการ เพื่อให้ตรวจสอบได้ตรงจุด
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="ขั้นตอนเริ่มใช้งาน WIN8S ตั้งแต่สมัครสมาชิกจนถึงเข้าเล่นเกมสล็อต" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f6e4d6]">
        ผู้ใช้งานใหม่สมัคร WIN8S ผ่านมือถือหรือคอมพิวเตอร์ได้ด้วยตัวเอง และสลับค่ายเกมผ่านบัญชีเดียวได้โดยไม่ต้องสมัครหลายครั้ง
        เริ่มต้นใช้งานได้ง่ายเพียง <strong class="text-[#fd9a1e]">3 ขั้นตอน</strong> และเป็นลำดับเดียวกันไม่ว่าจะเลือกเล่นเกมของค่ายไหน
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#f6e4d6]">
        <li class="flex gap-3"><span class="font-bold text-[#fd9a1e]">1.</span> เข้าหน้าสมัคร WIN8S และกรอกข้อมูลตามที่ระบบกำหนด ทำผ่านมือถือหรือคอมพิวเตอร์ได้โดยตรง</li>
        <li class="flex gap-3"><span class="font-bold text-[#fd9a1e]">2.</span> Login เข้าสู่บัญชีและเลือกช่องทางฝากเครดิตผ่านวอลเลทหรือธนาคารที่เปิดให้บริการ</li>
        <li class="flex gap-3"><span class="font-bold text-[#fd9a1e]">3.</span> ตรวจสอบโปรโมชั่น เลือกค่ายและเกมสล็อตที่ต้องการ แล้วอ่านช่วงเดิมพันก่อนเริ่มหมุน</li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#ffc98a]">
        หลังสมัครเรียบร้อยสามารถตรวจสอบเครดิต ประวัติรายการ โปรโมชั่น และสถานะฝากถอนผ่านบัญชีสมาชิกได้โดยตรง
        ควรไล่ดูให้ครบก่อนใช้เครดิตจริง จะช่วยให้เห็นว่ารายการหนึ่งถูกบันทึกและคิดผลมาจากอะไรบ้าง
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ตรวจช่วงเดิมพัน รอบโบนัส และฟีเจอร์ของแต่ละเกมก่อนกดหมุน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f6e4d6]">
        ข้อมูลที่ควรเปิดดูให้ครบก่อนลงเดิมพันมีอยู่ไม่กี่อย่าง และระบบแสดงไว้ในหน้าเกมให้ตรวจสอบได้อยู่แล้ว
        <strong class="text-[#fff2e6]">ข้อมูลชุดนี้คือสิ่งที่กำหนดว่ารอบหนึ่งคิดผลอย่างไร</strong> จึงควรอ่านให้จบก่อนตัดสินใจว่าจะลงเท่าไร
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f6e4d6]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fd9a1e]">🪙</span>
          <span><strong class="text-[#fd9a1e]">ช่วงเดิมพันของเกมนั้น</strong> หากต้องการเริ่มที่ 1 บาท ให้ดูตัวเลขขั้นต่ำในตัวเกมก่อนทุกครั้ง เพราะขั้นต่ำจริงต่างกันตามค่ายและตามเกม</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e3e7ec]">🎰</span>
          <span><strong class="text-[#e3e7ec]">จำนวนวงล้อและเส้นรางวัล</strong> สล็อตคลาสสิกกับสล็อตวิดีโอนับผลไม่เหมือนกัน หน้าอธิบายในเกมบอกไว้ว่าสัญลักษณ์ชุดไหนจ่ายอย่างไร</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fd9a1e]">🎁</span>
          <span><strong class="text-[#fd9a1e]">รอบโบนัสและฟรีสปิน</strong> เข้าเงื่อนไขไม่เหมือนกันในแต่ละเกม ควรอ่านก่อนว่าฟีเจอร์ไหนทำงานตอนไหน และนับจากอะไร</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e3e7ec]">📱</span>
          <span><strong class="text-[#e3e7ec]">การเล่นผ่านมือถือ</strong> ใช้บัญชีเดิมเข้าเล่นได้จากทุกอุปกรณ์ เครดิตและประวัติรายการเป็นชุดเดียวกัน ไม่ต้องติดตั้งหลายระบบ</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#ffc98a]">
        รายการเกมและค่ายที่พร้อมใช้งานเปลี่ยนแปลงได้ ควรตรวจสอบรายการล่าสุดจากหน้าเกมในเว็บก่อนเข้าเล่น
        ส่วนรายละเอียดฟีเจอร์และเงื่อนไขของเกมให้ยึดข้อมูลที่แสดงในตัวเกมโดยตรง และควรกำหนดยอดต่อรอบไว้ล่วงหน้าทุกครั้ง
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ฝากถอนวอลเลท เช็กโปรโมชั่น และดูแลความปลอดภัยของบัญชีสมาชิก" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f6e4d6]">
        สมาชิกจัดการเครดิตได้เองโดยเลือกใช้วอลเลทหรือธนาคารจากช่องทางที่เว็บไซต์เปิดรองรับ
        <strong class="text-[#fd9a1e]">ฝากเครดิต ส่งคำขอถอน และตรวจสอบสถานะรายการผ่านมือถือได้โดยตรง</strong>
        ช่วยลดขั้นตอนและไม่จำเป็นต้องแจ้งรายการกับเจ้าหน้าที่ทุกครั้ง ส่วนขั้นต่ำ วงเงินสูงสุด และข้อกำหนดของแต่ละช่องทาง
        ควรตรวจสอบข้อมูลล่าสุดในหน้าฝากถอนก่อนทำรายการ เนื่องจากแต่ละช่องทางอาจกำหนดไว้ไม่เท่ากัน
      </p>

      <ul class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#f6e4d6]">
        <li class="flex gap-3">
          <span class="text-[#fd9a1e]" aria-hidden="true">•</span> โปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตรวจสอบสิทธิ์ได้หลัง Login แต่ละรายการอาจกำหนดยอดที่ใช้คำนวณ รอบรับโบนัส เกมที่เข้าร่วม และเงื่อนไขการถอนต่างกัน ควรอ่านรายละเอียดให้ครบก่อนกดรับ
        </li>
        <li class="flex gap-3">
          <span class="text-[#e3e7ec]" aria-hidden="true">•</span> หน้านี้อธิบายการใช้งานและการทำความคุ้นเคยกับระบบเท่านั้น การเดิมพันจริงต้องสมัครสมาชิกและฝากเครดิตผ่านช่องทางที่เปิดให้บริการก่อน
        </li>
        <li class="flex gap-3">
          <span class="text-[#fd9a1e]" aria-hidden="true">•</span> หากเครดิตไม่เข้า รายการถอนค้าง หรือสถานะธุรกรรมไม่อัปเดต ให้เก็บหลักฐานรายการไว้จนกว่าการตรวจสอบจะเสร็จสิ้น
        </li>
        <li class="flex gap-3">
          <span class="text-[#e3e7ec]" aria-hidden="true">•</span>
          <strong class="text-[#fff2e6]">ตั้งรหัสผ่านที่คาดเดายากและไม่เปิดเผยรหัสผ่านหรือ OTP แก่บุคคลอื่น</strong> ไม่ว่าจะเป็นการติดต่อจากช่องทางใดก็ตาม
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#f6e4d6]">
        หากพบปัญหาสมัครสมาชิก Login ไม่ได้ เข้าเกมสล็อตไม่ได้ ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง หรือโปรโมชั่นไม่แสดง ติดต่อแอดมิน WIN8S ได้ตลอด 24 ชั่วโมง พร้อมแจ้งชื่อเกม เวลา จำนวนเงิน
        และรายละเอียดของรายการ <strong class="text-[#fff2e6]">การเดิมพันมีความเสี่ยง ควรกำหนดงบประมาณให้เหมาะสมทุกครั้ง</strong>
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก WIN8S"
          class="flex items-center justify-center rounded-lg border border-[#f36403]/70 bg-gradient-to-r from-[#fff2e6] via-[#fd9a1e] to-[#8a3103] px-8 py-3 font-black text-[#050201] shadow-[0_0_15px_rgba(243,100,3,0.30)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ WIN8S"
          class="flex items-center justify-center rounded-lg border border-[#e3e7ec]/45 bg-transparent px-8 py-3 font-bold text-[#e3e7ec] transition-all hover:scale-105 hover:border-[#e3e7ec] hover:bg-[#1c0a02]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>

  <Navfoot />
</MainLayout>
