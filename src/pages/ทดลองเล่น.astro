---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { Picture } from "astro:assets";

import popularGamesImage from "../assets/gamedemo8.webp";
import newGamesImage from "../assets/gamedemo16.webp";

import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login,
// /register หรือหน้าภาพแบบ /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง
// ไม่ได้มาจากเช็กลิสต์หัวข้อของบรีฟที่ใช้กับ index.astro — บรีฟรอบนี้
// (src/assets/content.txt, 29 บรรทัด) ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่
// จากข้อเท็จจริงและคลังคำของบรีฟรอบนี้เท่านั้น (.claude/brand-spec-win8s.md §4-§5)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x4 · h3x0
//   h1  ทดลองเล่น <แบรนด์> ศึกษากติกาบาคาร่าออนไลน์ คาสิโนสด และสล็อตก่อนเดิมพันจริง
//   h2  บาคาร่าออนไลน์ คาสิโนสด และสล็อต สามหมวดที่กติกาและอัตราจ่ายไม่เหมือนกัน
//   h2  ลิขสิทธิ์แท้จากเมกา และเซิร์ฟนอก จุดที่ควรตรวจก่อนเปิดบัญชี
//   h2  สมัครสมาชิก 3 ขั้นตอน และโปรโมชั่นที่ควรอ่านเงื่อนไขก่อนรับสิทธิ์
//   h2  สิ่งที่ควรตรวจซ้ำทุกครั้งก่อนเดิมพันด้วยเงินจริง
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// **การ์ดรูปสองใบอยู่ใน h2 ใบแรก ไม่ได้แยกเป็นหัวข้อของตัวเอง** เพื่อคงผัง h2x4
// ป้ายกำกับของการ์ดรูปอยู่ในตัวภาพเอง (alt) ไม่มีป้ายข้อความใดเป็น heading
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
// ⚠️ **ห้ามให้หน้านี้กลายเป็นสำเนาของ index.astro** — index เล่าตามลำดับของบรีฟ
// (การันตีลิขสิทธิ์ โปรโมชั่น สมัครสมาชิก แอดมิน) ส่วนหน้านี้เล่า **สิ่งที่ควรอ่าน
// และตรวจสอบก่อนลงเงินจริง** คนละแกนกัน
//
// 🚨🚨 รอบนี้เป็น **คาสิโนเล่นบาคาร่า** ที่บรีฟระบุหมวดเกมไว้ **สามหมวดเท่านั้น**
// (บาคาร่าออนไลน์ · คาสิโนสด · สล็อต — content.txt บรรทัด 4, 13, 25)
// → อ้างชื่อหมวดได้ตรงๆ **รอบก่อนมีเจ็ดหมวด ห้ามสืบทอดจำนวนหมวดข้ามแบรนด์**
// 🚨🚨 **อีกสี่หมวดที่รอบก่อนมี บวกหมวดสลากกินแบ่ง ไม่มีในบรีฟรอบนี้เลยสักคำ
// ห้ามโผล่ที่ไหนบนหน้านี้** (ลิสต์ชื่อหมวดที่ห้ามอยู่ครบใน brand-spec §5 —
// ไม่พิมพ์ซ้ำที่นี่ เพื่อให้ sweep ของรอบถัดไปไม่เจอ false positive ในคอมเมนต์นี้เอง)
// และ **ห้ามเขียนเนื้อหาหมวดสลากกินแบ่งทุกรูปแบบ** สองหน้าของหมวดนั้นยังอยู่ใน
// src/pages-disabled/ ตามเดิม (ชื่อไฟล์อยู่ใน brand-spec §7)
// **ห้ามลิงก์ไปหาเด็ดขาด** href ที่ตายจะทำให้ build แดง
// 🚨🚨 **คำว่า "ทดลองเล่น" อยู่ได้เฉพาะเพราะเป็นชื่อ route /ทดลองเล่น และชื่อเมนู
// จริง** (ใช้ใน h1 · title · description · breadcrumb) แต่ **บรีฟรอบนี้ไม่ได้
// พูดถึงโหมดเล่นโดยไม่ใช้เงินจริงเลยแม้แต่ประโยคเดียว** → **ห้ามอ้างว่าเว็บมี
// โหมดนั้นให้** ห้ามอ้างจำนวนเกม/ค่าย ห้ามอ้างค่า RTP หรือความผันผวนเป็นตัวเลข
// และห้ามอ้างว่าสถิติย้อนหลังคาดการณ์ผลรอบถัดไปได้
// ⚠️ และมีหนึ่งประโยคที่พูดตรงๆ ว่าบรีฟไม่ได้ระบุโหมดนั้นไว้ เพื่อไม่ให้ผู้อ่าน
// อนุมานเอาจากชื่อเมนู — **ห้ามถอดประโยคนั้นออก**
// แกนของหน้าจึงเป็น **"สิ่งที่ควรศึกษาและตรวจสอบก่อนเดิมพันด้วยเงินจริง"** ตามที่
// บรีฟมีจริง (บรรทัด 4, 6, 14, 20, 22): กติกาบาคาร่าสด รูปแบบการเดิมพัน และเงื่อนไข
// ของแต่ละเกม · ควรตรวจสอบรายชื่อผู้ให้บริการเกมและความน่าเชื่อถือของแพลตฟอร์ม ·
// ควรตรวจสอบหลักฐานการได้รับอนุญาต ชื่อบริษัทผู้ให้บริการ และกติกาการคิดค่าธรรมเนียม ·
// บาคาร่าแต่ละรูปแบบอาจมีอัตราจ่ายหรือค่าคอมมิชชันแตกต่างกัน · ขั้นตอนสมัคร 3 ขั้นตอน ·
// ไม่เปิดเผยรหัสผ่านและรหัส OTP · แอดมินออนไลน์ตลอด 24ชม.
// ⚠️ บรีฟรอบนี้ **โฆษณาและกำกับในย่อหน้าเดียวกัน** คำโฆษณาอยู่ได้เฉพาะในขอบเขตที่
// บรีฟเขียนไว้เอง ห้ามขยายเป็นคำกล่าวอ้างใหม่ และทุกประโยคกำกับต้อง ship ครบ
// ห้ามตัดเพราะฟังดูลบ — โดยเฉพาะ **"การใช้เซิร์ฟเวอร์ต่างประเทศไม่ได้รับประกัน
// ความปลอดภัยของข้อมูลหรือความถูกต้องตามกฎหมายในไทย"** (บรรทัด 6)
// 🚨🚨 **สามคำที่ spec รอบก่อนๆ ห้ามไว้ แต่รอบนี้เป็นคำของบรีฟเอง**: เซิร์ฟนอก ·
// ปลอดภัย100% · ลิขสิทธิ์แท้จากเมกา **ห้ามลบออกเพราะอ่านคอมเมนต์เก่าแล้วเข้าใจผิด**
// 🚨🚨 ส่วนคำนิยามตัวเองของแบรนด์ขาออกทั้งชุด **ห้ามหลงเหลือ** (ลิสต์เต็มอยู่ใน
// brand-spec §5 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive
// ในคอมเมนต์ของไฟล์นี้เอง)
//
// ⚠️⚠️ ชื่อแบรนด์รอบนี้เป็น **ตัวละตินพิมพ์ใหญ่ + ตัวเลข + ตัวละตินพิมพ์ใหญ่ เขียน
// ติดกันเป็นคำเดียว ไม่มีเว้นวรรคและไม่มีขีดกลาง ยาว 5 อักขระ** (brand-spec §1)
// ทุกจุด interpolate จาก BRAND_NAME เพื่อไม่ให้ค้างเป็นชื่อแบรนด์ก่อนหน้าตอน
// รีแบรนด์รอบถัดไป **ห้ามพิมพ์ชื่อแบรนด์เป็น literal ในไฟล์นี้**
// 🚨🚨 **บรีฟรอบนี้ไม่มีหมวดฝากถอน/ธนาคาร/วอลเลทเป็นบริการของเว็บเลยแม้แต่คำเดียว**
// — ห้ามเขียนหัวข้อทำนองนั้น ห้ามอ้างว่าเว็บให้บริการฝาก-ถอน ห้ามเอ่ยชื่อธนาคาร
// หรือวอลเล็ต ห้ามฟีเจอร์ออโต้ และห้ามยอดขั้นต่ำ-สูงสุดที่เป็นตัวเลข
// ⚠️⚠️ **แต่ประโยคกำกับของบรีฟเองที่มีคำว่า "ถอนเงิน" ต้อง ship ตามที่บรีฟเขียน
// ห้ามเลี่ยงคำ** (บรรทัด 8 ข้อกำหนดการถอนเงิน · บรรทัด 10 ข้อกำหนดการใช้โบนัสและ
// การถอนเงิน · บรรทัด 12 เงื่อนไขการถอนเงิน) สามจุดนั้นเป็น **คำเตือนผู้บริโภคที่
// บรีฟเขียนถึงตัวเอง** ซึ่งตรงข้ามกับคำโฆษณา การเลี่ยงไปใช้ "การทำรายการ" หรือ
// "ข้อจำกัดในการใช้เครดิต" **ทำให้ความหมายเพี้ยน**
//
// route ที่มีจริงรอบนี้: / · /about-us · /contact-us · /promotion · /ทดลองเล่น ·
// /ทางเข้า · /login · /register · /terms · /privacy · 404 · /line
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกม ชื่อผู้ให้บริการ หน่วยงานกำกับ ใบอนุญาต
// ปีก่อตั้ง จำนวนสมาชิก จำนวนเกม/ค่าย หรือยอดเดิมพันขั้นต่ำเป็นตัวเลข แม้แต่
// รายการเดียว** จึงห้ามเขียนลงหน้าเว็บ
// ตัวเลขที่ขึ้นหน้าได้มีแค่ของบรีฟเอง: **0.3% · 0.8% · 100% · 3 ขั้นตอน · 24ชม.**
//
// 🚨 **รูปในหน้านี้ใช้ได้แค่ gamedemo8 กับ gamedemo16 เท่านั้น** — เป็นอาร์ตสต็อก
// กลางของเทมเพลต (mtime 2026-08-04) **ไม่ใช่อาร์ตเวิร์กของดรอปนี้ และไม่ใช่ของ
// แบรนด์ไหน** จึงใช้เป็นภาพประกอบตกแต่งได้ แต่ **ห้ามใช้แทนอาร์ตเวิร์กแบรนด์**
// gamedemo8 (600x379) กับ gamedemo16 (650x411) ไม่มีโลโก้หรือชื่อผู้ให้บริการ
// เจ้าอื่นพิมพ์ทับอยู่ ส่วน gamedemo7/9/10/11/12/14/15/17/18 มีโลโก้หรือชื่อของ
// ผู้ให้บริการเจ้าอื่นพิมพ์ทับอยู่กลางรูป และ gamedemo13 เป็นภาพล่อแหลม —
// **ห้ามนำกลับมาใช้**
// ⚠️⚠️ **ทั้งสองใบพิมพ์คำว่า POPULAR GAME / New Game ไว้บนภาพจริง** ซึ่งเป็น
// ข้อเท็จจริงของรูป alt จึงบอกตามนั้น · รูปคู่นี้เป็น **ภาพประกอบตกแต่ง** ไม่ใช่
// ภาพหน้าเกมจริงของเว็บ และไม่มีชื่อแบรนด์ใดพิมพ์อยู่บนรูป alt จึงไม่เอ่ยชื่อแบรนด์
// ⚠️ alt บรรยายสิ่งที่เห็นจริง (กระต่ายกับแมวใส่แว่นกันแดดและหูฟังขนาบหีบสมบัติ /
// ตัวละครหัวฟักทองกับโครงกระดูกบนลานเรืองแสง) **ไม่ใช่ตัวนับแบบ "ภาพที่ 1"**
// ⚠️ ทั้งสองใบวาดกว้างสุด 600px (กริดสองคอลัมน์ตั้งแต่ sm ขึ้นไป) widths/sizes
// จึงตั้งตามนั้น ไม่ใช่ตามขนาดไฟล์ต้นฉบับ
// 🚨 **ห้าม import อาร์ตเวิร์กของแบรนด์อื่นจากหน้านี้เด็ดขาด**: แบนเนอร์ใบที่สอง
// และสาม (2026-10-23) กับสไลด์ใบที่สามและสี่ (2026-09-29) เป็นของแบรนด์อื่น
// (ชื่อไฟล์เต็มอยู่ใน brand-spec §6) · สไลด์สองใบของดรอปนี้ถูกตรึงไว้กับ
// index §4-§5 กับ /promotion · banner1 / banner1-mobile / og.png เป็นของ glob ที่
// MainLayout ปักไว้ **ห้ามอ้างจากหน้านี้**
// · ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ ทุก build และ verify-build จะแดง
// · ไฟล์เก่าทั้งหมดยังอยู่บนดิสก์ **ห้ามลบ** เป็นอินเวนทอรีของแบรนด์ถัดไป
//
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) **กลับทิศ 180° จากรอบก่อน: รอบนี้มืดทั้งเว็บ**
// bg.json ของดรอปนี้คือ {"mode":"color","color":"#1e0101"} = **ดำอมเลือดหมู**
// (รอบก่อนเป็นชมพูบลัชจาง ซึ่งอยู่คนละปลายของสเกล) **ห้ามเดาว่าเท่าเดิม และ
// ห้าม "แก้" การ์ด/ปุ่มกลับไปเป็นผิวสว่าง** — ผิวสว่างบนหมึก #fdf0e6 = ตัวอักษร
// หายไปเลย ไม่ใช่แค่จางลง
// ค่าที่ใช้ได้ในไฟล์นี้: `<strong>` ส้มเพลิง **#f27a1a** (6.6:1 บนการ์ดเข้ม) ·
// ทองอำพัน **#e5a92b** (8.8:1) เป็นคู่สีที่สอง · marker ของลำดับเลขและปุ่ม outline
// เป็น #f27a1a · หมึกรอง #e0bda4 (10.5:1) · เงินโครเมียม #c9d2dc (12.0:1) ·
// พื้นไล่เฉดปุ่มหลัก #f0a21e -> #f27a1a -> #e8620e (**พื้นถม** + หมึกดำ #1e0101
// 9.3 / 7.1 / 5.8:1 ต่อ stop) · ปุ่มรองเป็นผิว #2a0a04 หมึก #f0a21e ขอบ #8a3a12 ·
// ผิวการ์ด #2a0a04 · ชั้นยก/ชิป #3b130b · เส้นบาง #5a2410 · ขอบตกแต่ง #8a3a12
// (**สองค่าหลังห้ามถือตัวอักษร** ใช้เป็นขอบการ์ดรูป/ขอบปุ่มได้)
// หมึกเนื้อความคือ #fdf0e6 (= BRAND_TEXT) ซึ่ง **ไม่ประกาศในไฟล์นี้** การ์ด
// ContentBox ตั้งไว้ให้แล้วและย่อหน้าสืบทอดลงมา
// 🚨🚨 **#5a2410 · #8a3a12 ห้ามเป็นสีตัวอักษร** และ **ห้ามใช้หมึกขาวบนไล่เฉดปุ่มหลัก**
// (ขาวบนเฉดส้ม-ทองเหลือ 2.8:1) และ **ห้ามลากปลายเฉดเข้มกว่า #e8620e** เพราะหมึกดำ
// บนนั้นเหลือ 5.8:1 และเข้มกว่านั้นตกต่ำกว่า 4.5:1 ทันที
// ออราที่อนุญาต: rgba(242,122,26,α) · rgba(229,169,43,α) · rgba(138,58,18,α) ·
// rgba(30,1,1,α) · rgba(20,3,2,α)
// 🚨🚨 **แดงชาด-ชมพูบลัชคือฮิวของรอบก่อน รอบนี้กลับทิศเป็นส้มเพลิง-ทองอำพันบนดำ**
// ที่ห้ามคือ **ค่าเฮกซ์ของแบรนด์เก่าแบบตรงหกหลัก** ไม่ใช่ "สีส้ม" ในฐานะตระกูลสี —
// มีแบรนด์ส้ม/ทองมาแล้วหลายเจ้า การเจอทองในไฟล์จึงไม่พิสูจน์อะไร ต้องเทียบหกหลัก
// กับตาราง brand-spec §2 (คู่ที่ใกล้จนต้องสงสัยว่าพิมพ์ผิดก่อนเสมอถูกลิสต์ไว้ใน
// ไฟล์นั้นแล้ว และเขียนแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep สะดุด)
// (ค่าของ 123BET รอบก่อนทันทีที่ต้องไม่หลงเหลือ เขียนแบบไม่มี # โดยตั้งใจ:
//  a30d1a c21325 8a1420 ef4a5e dca53a 7a4a0c d2d7dd 36080f 6b2b33 fdf5f6 f7e4e9
//  f7dfe4 eec3cc d98fa0)
// ⚠️ ข้อยกเว้นสีเชิงความหมาย: **LINE green #00B900** (ไฟล์นี้ไม่มีปุ่ม LINE)
// ⚠️⚠️ เหรียญทองในรูป gamedemo8 กับอัญมณี/ลูกบาศก์ชมพูในรูป gamedemo16 เป็น
// **วัตถุในภาพ ไม่ใช่สี UI** เช่นเดียวกับกิโมโนแดง-ดำ ปิ่นซากุระแดง-ขาว ผนังห้อง
// สีขาวงาช้าง และผิวโครเมียมเงินของเวิร์ดมาร์กในอาร์ตเวิร์กของดรอปนี้
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง และไม่ใส่ mx-auto / max-w-* บน <p>
// เพราะการ์ดคุมความกว้างเองแล้ว — ที่ประกาศสีได้มีแค่ปุ่ม ชิปไอคอน marker ของ
// ลำดับเลข ขอบการ์ดรูป และ <strong> · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วย
// ช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ
// บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง และห้ามวาง <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังในข้อความของ prop และต้องเป็นไอคอนหมวดเกมของรอบนี้
// slot ของ ContentBox รับ **หนึ่ง element** เท่านั้น จึงห่อด้วย <div> ชั้นเดียว
//
// Announcement รอบนี้หมุนมาเป็นตัวท้ายชื่อ Premium ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ตัวท้ายชื่อเลขห้าจึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้น
// เป็นคอปปี้ของแบรนด์นี้แล้ว จึงเรียกแบบ bare **ห้ามส่ง prop message** มิฉะนั้น
// ข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -c บนเชลล์นี้
// ก็นับเป็นไบต์ ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับตัวนับ
// ของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 155 อักขระ (ชื่อแบรนด์รอบนี้ 5 อักขระ) เป็นประโยคเดียวที่บอกว่า
// หน้านี้มีไว้ทำอะไร แล้วหยุด **ต้องนับใหม่ทุกรอบ** ห้ามสืบทอดความยาว
// (Google ตัดราว 160 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนๆ ยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} หน้ารวมสิ่งที่ควรศึกษาก่อนเดิมพันจริง ทั้งกติกาและอัตราจ่ายของบาคาร่าออนไลน์ คาสิโนสด และสล็อต พร้อมเงื่อนไขการใช้บริการที่ควรอ่านก่อนเริ่ม`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ศึกษากติกาบาคาร่าออนไลน์ คาสิโนสด และสล็อตก่อนเดิมพันจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});

// คลาสปุ่มสามขั้วของหน้านี้ ประกาศครั้งเดียวแล้วใช้ซ้ำ เพื่อไม่ให้สองปุ่มที่ทำ
// หน้าที่เดียวกันหลุดไปคนละเฉดตอนรีแบรนด์รอบหน้า
const ctaPrimary =
  "flex items-center justify-center rounded-full border border-[#8a3a12] bg-gradient-to-b from-[#f0a21e] via-[#f27a1a] to-[#e8620e] px-8 py-3 font-black text-[#1e0101] shadow-[0_6px_18px_rgba(242,122,26,0.32)] transition-transform hover:scale-105";

const ctaSecondary =
  "flex items-center justify-center rounded-full border border-[#8a3a12] bg-[#2a0a04] px-8 py-3 font-bold text-[#f0a21e] shadow-[0_6px_18px_rgba(20,3,2,0.5)] transition-transform hover:scale-105";

const ctaQuiet =
  "flex items-center justify-center rounded-full border-2 border-[#f27a1a] bg-[#2a0a04] px-8 py-3 font-bold text-[#f27a1a] shadow-[0_4px_14px_rgba(20,3,2,0.45)] transition-all hover:scale-105 hover:bg-[#3b130b] hover:shadow-[0_6px_18px_rgba(242,122,26,0.22)]";

const listChip = "mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#5a2410] bg-[#3b130b] text-sm";

const gameCard = "mx-auto block h-auto w-full max-w-[600px] rounded-2xl border border-[#8a3a12]";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#f27a1a]">{BRAND_NAME} นำเสนอข้อมูลคาสิโนออนไลน์ที่รวบรวมเกมบาคาร่าออนไลน์ เกมคาสิโนสด และเกมสล็อตจากค่ายต่าง ๆ ไว้ในเว็บไซต์เดียว</strong>
        หน้านี้ไม่ได้ทำหน้าที่ไล่เรียงรายการเกม แต่รวบรวมไว้ว่าควรอ่านอะไรก่อนกดเริ่มเกมสักเกม และควรตรวจอะไรซ้ำทุกครั้งที่กลับเข้ามาใหม่
      </p>

      <p>
        เว็บไซต์ระบุตัวเองไว้ว่าเป็นคาสิโนเล่นบาคาร่า ทางเข้าเล่น เกมเดิมพันสด ทุกค่ายดัง การันตีลิขสิทธิ์แท้จากเมกา เล่นง่าย ไม่หักเปอร์เซ็นต์ เซิร์ฟนอก ปลอดภัย100% ขณะเดียวกัน
        <strong class="text-[#f27a1a]">ผู้ใช้งานควรตรวจสอบหลักฐานการได้รับอนุญาต ชื่อบริษัทผู้ให้บริการ และกติกาการคิดค่าธรรมเนียมให้ชัดเจนก่อนใช้งาน</strong>
        เพราะข้อความโฆษณาเพียงอย่างเดียวยังไม่ใช่หลักฐาน
      </p>

      <p>
        <strong class="text-[#f27a1a]">ข้อมูลที่เว็บไซต์ระบุไว้ไม่ได้กล่าวถึงการเปิดให้เล่นโดยไม่ใช้เงินจริงไว้แต่อย่างใด</strong>
        หน้านี้จึงไม่ยืนยันว่ามีรูปแบบนั้นให้ใช้งาน และควรตรวจสอบจากประกาศล่าสุดของเว็บไซต์ทางการเองว่าเกมใดเปิดให้ศึกษาได้ในลักษณะใด เนื้อหาด้านล่างเขียนไว้ประกอบการใช้งานเท่านั้น ไม่ได้ใช้แทนเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้บริการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="บาคาร่าออนไลน์ คาสิโนสด และสล็อต สามหมวดที่กติกาและอัตราจ่ายไม่เหมือนกัน" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        สามหมวดที่เว็บไซต์ระบุไว้ไม่ได้เล่นแบบเดียวกัน
        <strong class="text-[#f27a1a]">บาคาร่าสดมีกติกาและรูปแบบการเดิมพันของตัวเอง เกมคาสิโนสดถ่ายทอดจากโต๊ะจริงที่มีกติกาต่อโต๊ะ ส่วนเกมสล็อตคิดรางวัลจากฟีเจอร์ของแต่ละเกม</strong>
        การย้ายจากหมวดหนึ่งไปอีกหมวดจึงเท่ากับเริ่มอ่านกติกาใหม่ทั้งชุด ไม่ใช่เปลี่ยนแค่หน้าจอ รายการด้านล่างสรุปไว้ว่าควรมองหาอะไรก่อนเริ่ม โดยไม่ระบุจำนวนเกมหรือชื่อค่าย เพราะข้อมูลนั้นต้องดูจากหน้ารายการจริงของเว็บไซต์เท่านั้น
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={popularGamesImage}
          alt="การ์ดภาพประกอบตกแต่ง เป็นภาพกระต่ายการ์ตูนกับแมวการ์ตูนสวมแว่นกันแดดและหูฟัง ยืนขนาบข้างหีบสมบัติที่มีเหรียญทองล้นออกมา มีเหรียญกลมลายโพดำลอยอยู่รอบ ฉากหลังเป็นวงแหวนเรืองแสง และมีข้อความ POPULAR GAME ตัวหนาสีทองอยู่กลางภาพ"
          loading="lazy"
          fetchpriority="low"
          decoding="async"
          widths={[300, 600]}
          sizes="(max-width: 639px) 100vw, 600px"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={62}
          class={gameCard}
        />

        <Picture
          src={newGamesImage}
          alt="การ์ดภาพประกอบตกแต่ง เป็นภาพตัวละครหัวฟักทองสวมหมวกปีกกว้างกับโครงกระดูกการ์ตูนยืนขนาบข้างบนลานกระเบื้องเรืองแสง มีอัญมณีสีสด ดาวสีเหลือง และลูกบาศก์สีชมพูกระจายอยู่ และมีข้อความ New Game ตัวหนาสีขาวอยู่กลางภาพ"
          loading="lazy"
          fetchpriority="low"
          decoding="async"
          widths={[300, 600]}
          sizes="(max-width: 639px) 100vw, 600px"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={62}
          class={gameCard}
        />
      </div>

      <ul class="flex flex-col gap-4" aria-label="สิ่งที่ควรอ่านก่อนเริ่มเกมแต่ละหมวด">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🃏</span>
          <span>
            <strong class="text-[#f27a1a]">กติกาบาคาร่าสดและรูปแบบการเดิมพันของโต๊ะนั้น</strong> คือจุดแรกที่ควรอ่าน เพราะบาคาร่าแต่ละรูปแบบอาจมีอัตราจ่ายหรือค่าคอมมิชชันแตกต่างกัน ตัวเลขที่ใช้จริงจึงอยู่บนหน้าของโต๊ะที่กำลังเปิดอยู่
            ไม่ใช่ข้อความสรุปที่หน้าแรก
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎥</span>
          <span>
            <strong class="text-[#f27a1a]">เงื่อนไขของห้องคาสิโนสดที่กำลังเข้าอยู่</strong> ควรดูให้ครบก่อนลงเดิมพัน ทั้งรูปแบบการวางเดิมพันที่ห้องนั้นเปิดรับและวิธีคิดผลของแต่ละช่อง เพราะแต่ละห้องกำหนดไว้ไม่เหมือนกัน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎰</span>
          <span>
            <strong class="text-[#f27a1a]">ฟีเจอร์และเงื่อนไขการคิดรางวัลของเกมสล็อตเกมนั้น</strong> ควรอ่านจากหน้าของเกมเอง เพราะข้อความรวมที่หน้าแรกเป็นคำอธิบายภาพรวม ไม่ได้แทนรายละเอียดของเกมที่เปิดอยู่จริง
          </span>
        </li>
      </ul>
    </div>
  </ContentBox>

  <ContentBox title="ลิขสิทธิ์แท้จากเมกา และเซิร์ฟนอก จุดที่ควรตรวจก่อนเปิดบัญชี" as="h2">
    <div class="flex flex-col gap-5">
      <p>
        เว็บไซต์ระบุว่าให้บริการเกมคาสิโนผ่านระบบเซิร์ฟเวอร์ต่างประเทศ พร้อมนำเสนอข้อมูลเกี่ยวกับลิขสิทธิ์เกมจากสหรัฐอเมริกาและรูปแบบการเดิมพันที่ไม่หักเปอร์เซ็นต์ อย่างไรก็ตาม
        <strong class="text-[#f27a1a]">
          ผู้ใช้งานควรตรวจสอบหลักฐานการได้รับอนุญาต ชื่อบริษัทผู้ให้บริการ และกติกาการคิดค่าธรรมเนียมให้ชัดเจน โดยเฉพาะบาคาร่าแต่ละรูปแบบที่อาจมีอัตราจ่ายหรือค่าคอมมิชชันแตกต่างกัน
        </strong>
        หน้านี้จึงไม่ระบุชื่อค่ายหรือจำนวนผู้ให้บริการไว้เอง เพราะข้อมูลที่ให้มาไม่ได้บอกไว้ และสิ่งที่เปิดใช้งานจริงต้องอ่านจากหน้ารายการของเว็บไซต์ในขณะนั้น
      </p>

      <p>
        เหตุผลตรงไปตรงมา คือ
        <strong class="text-[#f27a1a]">การใช้เซิร์ฟเวอร์ต่างประเทศไม่ได้รับประกันความปลอดภัยของข้อมูลหรือความถูกต้องตามกฎหมายในไทย</strong>
        จึงควรตรวจสอบรายชื่อผู้ให้บริการเกมและความน่าเชื่อถือของแพลตฟอร์มก่อนใช้งาน แล้วถือเอาสิ่งที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้บริการเป็นข้อมูลที่ใช้จริง ไม่ใช่สิ่งที่จำไว้จากครั้งก่อน
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/about-us" aria-label={`อ่านข้อมูลเกี่ยวกับ ${BRAND_NAME}`} class={ctaQuiet}>อ่านข้อมูลเกี่ยวกับเรา</a>

        <a href="/terms" aria-label={`อ่านเงื่อนไขและข้อตกลงของ ${BRAND_NAME}`} class={ctaQuiet}>อ่านเงื่อนไขและข้อตกลง</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="สมัครสมาชิก 3 ขั้นตอน และโปรโมชั่นที่ควรอ่านเงื่อนไขก่อนรับสิทธิ์" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        เว็บไซต์ระบุขั้นตอนลงทะเบียนไว้เป็น 3 ขั้นตอน ผ่านอุปกรณ์ที่เชื่อมต่ออินเทอร์เน็ต และระบุโปรโมชั่นไว้สองรายการคือคืนยอดเสีย 0.3% กับแนะนำเพื่อน 0.8%
        <strong class="text-[#f27a1a]">ก่อนดำเนินการควรตรวจสอบข้อกำหนดด้านอายุ กฎหมายที่เกี่ยวข้อง และนโยบายความเป็นส่วนตัว เพื่อให้เข้าใจเงื่อนไขการใช้บริการและการจัดเก็บข้อมูลส่วนบุคคล</strong>
        รายการด้านล่างคือลำดับที่เปิดอ่านได้เร็วที่สุดก่อนเริ่มใช้งานครั้งแรก
      </p>

      <ol class="ml-6 list-decimal space-y-3 marker:font-black marker:text-[#f27a1a]">
        <li>
          <strong class="text-[#f27a1a]">ตรวจที่อยู่เว็บไซต์ก่อนเปิดหน้าลงทะเบียน</strong> เปิดเว็บไซต์ผ่านเบราว์เซอร์บนมือถือ ตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง แล้วอ่านข้อกำหนดการเปิดบัญชีและรายละเอียดการใช้บริการก่อนดำเนินการ
        </li>
        <li>
          <strong class="text-[#f27a1a]">กรอกข้อมูลและยืนยันบัญชีด้วยข้อมูลของตัวเองเท่านั้น</strong> ตรวจสอบความถูกต้องก่อนยืนยัน และตั้งรหัสผ่านที่คาดเดาได้ยาก ไม่ควรใช้ข้อมูลของบุคคลอื่นหรือเปิดเผยรหัสผ่านและรหัส
          OTP ให้ใครทราบ
        </li>
        <li>
          <strong class="text-[#f27a1a]">อ่านหมวดหมู่เกมและเงื่อนไขก่อนเริ่มใช้งาน</strong> หลังลงทะเบียนเรียบร้อย สามารถศึกษาหมวดหมู่บาคาร่าและเกมสล็อต กติกาการเล่น อัตราจ่าย และเงื่อนไขโปรโมชั่นที่เปิดให้บริการ
          หากมีข้อสงสัยควรสอบถามเจ้าหน้าที่ผ่านช่องทางทางการก่อนทำรายการ
        </li>
        <li>
          <strong class="text-[#f27a1a]">อ่านเงื่อนไขของโปรโมชั่นที่กำลังเปิดอยู่ให้จบก่อนรับสิทธิ์</strong> ทั้งประเภทเกมที่เข้าร่วม ยอดที่นำมาคำนวณ รอบเวลารับเครดิต และข้อกำหนดการถอนเงิน เพราะแม้เว็บไซต์จะใช้ข้อความว่าโบนัสไม่อั้น
          แต่ควรศึกษาวงเงินสูงสุดและเงื่อนไขจากประกาศล่าสุดก่อนรับสิทธิ์
        </li>
      </ol>

