---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import popularGamesImage from "../assets/gamedemo8.webp";
import newGamesImage from "../assets/gamedemo16.webp";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริง
// ของบรีฟรอบนี้เท่านั้น (src/assets/content.txt) ไม่ใช่แก้ทับประโยคของแบรนด์ก่อน
// — ย่อหน้าเก่าทั้งหน้าตั้งอยู่บนคำที่ brand-spec §7 สั่งห้าม (เป็นคอปปี้ของเว็บ
// เดิมพันกีฬา) จึงต้องเขียนใหม่ ไม่ใช่ find-and-replace
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// ดรอปนี้ (2026-10-11) คือ **TIGERWIN369 เกมคาสิโนรวม** — บาคาร่า สล็อต บอลออนไลน์
// ไฮโล ยิงปลา **ไม่ใช่เว็บเดิมพันกีฬา** แบบแบรนด์ก่อน ไม่ใช่เว็บสล็อตล้วน และไม่ใช่
// เว็บของหมวดลอตเตอรี (สองหน้าของหมวดนั้นจอดอยู่ใน src/pages-disabled/ ไม่มี route
// ห้ามลิงก์ไปหา เป็น href ตายที่ทำให้ build แดง) แง่มุมที่บรีฟระบุไว้มีเท่านี้:
// ครบวงจรในแพลตฟอร์มเดียว · หมวดเกมจัดเรียงให้ค้นหาได้สะดวก · รองรับมือถือและ
// คอมพิวเตอร์ · บาคาร่าเป็นเกมไพ่ยอดนิยม · สล็อตมีทั้งฟรีสปินและฟีเจอร์โบนัส ·
// บอลออนไลน์แสดงคู่แข่งขันพร้อมอัตราต่อรอง · ไฮโลใช้ผลจากลูกเต๋า · ยิงปลามีรูปแบบ
// การเล่นแตกต่างจากเกมโต๊ะทั่วไป · ศึกษากติกา ตารางจ่าย และช่วงเดิมพันก่อนตัดสินใจ ·
// คืนยอดเสีย 0.3% เข้ายูสทุกวัน รอบคำนวณ เวลาตัดยอด ยอดที่เข้าเกณฑ์ · แนะนำเพื่อน
// ลิงก์แนะนำ โบนัส 0.8% · สมัคร 3 ขั้นตอน ยืนยันบัญชี · แอดมิน 24 ชั่วโมง ·
// ช่องทางติดต่อหลัก · หมายเลขรายการ · รหัสผ่าน PIN OTP
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามี "โหมดทดลอง" เครดิตทดลอง หรือเดโมฟรีเป็นบริการของเว็บ —
// จึงห้ามสัญญาสินค้าตัวนั้น คำว่า "ทดลองเล่น" บนหน้านี้จึงหมายถึงสิ่งที่บรีฟระบุไว้
// ตรงๆ ว่าทำได้: เปิดเว็บไล่ดูหมวดเกมให้ครบหนึ่งรอบ เลือกเกมที่สนใจ อ่านกติกา
// ตารางจ่าย และช่วงเดิมพันของประเภทนั้นให้จบ แล้วจึงเริ่มเดิมพันจริง
//
// ⚠️ รูปในหน้านี้ใช้ได้แค่ gamedemo8 กับ gamedemo16 เท่านั้น — เป็นอาร์ตสต็อกกลาง
// ของเทมเพลต (mtime 2026-08-04) ไม่ใช่อาร์ตเวิร์กของแบรนด์นี้ จึงอยู่ต่อได้ แต่ alt
// ต้องบรรยายภาพจริง และห้ามเอ่ยชื่อแบรนด์ใด เพราะไม่มีชื่อแบรนด์ไหนปรากฏอยู่บนรูป
// ทั้งสองใบ ส่วน gamedemo7/9/10/11/12/14/15/17/18 มีโลโก้หรือชื่อของผู้ให้บริการ
// เจ้าอื่นพิมพ์ทับอยู่กลางรูป และ gamedemo13 เป็นภาพล่อแหลม — ห้ามนำกลับมาใช้
// เพราะเท่ากับอ้างชื่อที่บรีฟไม่ได้เอ่ย ไฟล์ยังอยู่บนดิสก์ ห้ามลบ เป็นอินเวนทอรี
// gamedemo8 ("POPULAR GAME" 600x379) กับ gamedemo16 ("New Game" 650x411) ความกว้าง
// ที่วาดจริงสูงสุด ~600px ต่อใบ (กริดสองคอลัมน์ในการ์ด) จึงไม่ขยายเกินต้นฉบับ
// quality={62} ของสองใบนี้ตั้งไว้ต่ำกว่าค่าปกติ 80 มาตั้งแต่รอบก่อน เพราะอาร์ตมีเกรน
// ละเอียดจนไฟล์ AVIF เคยโตกว่า WebP ของตัวเอง (verify-build จะแดง) ห้ามดันกลับขึ้น
//
// ⚠️ คำที่ห้ามหลงเหลือ: คำขายของของแบรนด์ก่อนๆ ศัพท์เว็บเดิมพันกีฬา และศัพท์เว็บ
// สล็อตล้วนที่บรีฟรอบนี้ไม่ได้เอ่ย — รายการเต็มอยู่ใน brand-spec §7 ไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาคำต้องห้ามเจอ false positive รายการตรวจก่อนเริ่มเดิมพัน (<ol>
// ด้านล่าง) รอบนี้เขียนใหม่ทั้งสี่ข้อให้อ้างเฉพาะสิ่งที่บรีฟพูดถึงจริง
//
// ⚠️ ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง
// ห้ามเติมเลขใบอนุญาต หน่วยงานกำกับ ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP ยอดฝากขั้นต่ำ
// จำนวนสมาชิก หรือปีที่ก่อตั้ง เพราะบรีฟไม่ได้เอ่ยไว้สักอย่าง
//
// ประโยคกำกับของบรีฟที่ห้ามตัดทิ้ง (เป็นส่วนหนึ่งของคอปปี้ ไม่ใช่ filler):
// แต่ละเกมมีเงื่อนไขและยอดขั้นต่ำแตกต่างกัน จึงควรตรวจสอบรายละเอียดในระบบก่อน
// ทำรายการ · จำนวนเกมและค่ายที่เปิดให้บริการจริงขึ้นอยู่กับระบบ · ความนิยมและความ
// น่าเชื่อถือไม่สามารถยืนยันจากข้อความโฆษณาเพียงอย่างเดียว · เบทต่ำหรือไม่มีขั้นต่ำ
// ควรตรวจสอบข้อกำหนดของแต่ละเกม เนื่องจากอาจมีวงเงินเริ่มต้นไม่เท่ากัน · คำว่า
// ไม่จำกัดควรระบุให้ชัดว่าหมายถึงอะไร · ควรตรวจสอบชื่อโดเมนและข้อกำหนดก่อนส่งข้อมูล
// ส่วนตัว · ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น แม้จะอ้างว่าเป็นเจ้าหน้าที่
//
// banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion · banner2/banner3 และ
// slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import (ลำพังการ import ก็ทำให้
// ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น Announcement5 ทั้งเว็บ (รอบก่อนใช้ Announcement2 —
// brand-spec §3 หมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้
// ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่ง
// จะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ทองอำพันเสือบนพื้นดำสนิท ไม่มีเงิน ไม่มีเทา**
// พลิกจากคู่ "ทองแชมเปี้ยน-เงินโครเมียม" ของแบรนด์ก่อน ซึ่งออกครบทุกจุดแล้วทั้งคลาส
// Tailwind raw hex และ rgba() (ค่าเดิมอยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำที่นี่ เพื่อ
// ไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive) รอบนี้ไม่มีฮิวเย็นเลย และ bg.json
// เป็น {"mode":"color","color":"#000000"} จึง **ไม่มีชั้นที่ลึกกว่าพื้นเพจ**
// ลำดับปุ่มสื่อด้วยขั้ว "ทองถม vs ผิวจมขอบทอง": ปุ่มหลักถมทองไล่เฉด #ffd98a →
// #f7b733 → #d98324 ขอบ #8a5214 หมึกดำอมน้ำตาล #1a0d02 · ปุ่มรองและปุ่มลิงก์ภายใน
// เป็นผิวจม #1c1206 → #0f0903 ขอบทอง #d98324/50 ตัวอักษรทองสว่าง #f7b733
// · ขอบรูปใช้ทองแบบโปร่ง · marker ของลำดับเลขใช้ทองอำพัน #d98324 (5.6:1 บนผิวการ์ด)
// ⚠️ ห้ามกลับด้าน: พื้นถมทองต้องใช้หมึกเข้มเสมอ ห้ามขาวหรือทองอ่อน และห้ามให้
// ไล่เฉดทองที่รองหมึกจบเข้มกว่า #d98324 (#1a0d02 บน #d98324 = 6.6:1 ผ่าน แต่บน
// #8a5214 = 3.0:1 ตก AA) — #8a5214 / #4a2a08 เป็นเส้น ขอบ และออราเท่านั้น
// ⚠️ "ทอง" ไม่ใช่ตัวบอกว่าถูกแบรนด์: แปดในสิบแบรนด์หลังสุดก็มีทอง ให้เทียบเป็นค่า
// ทีละตัวกับตารางใน brand-spec §2 (ทองของรอบนี้ส้มกว่าทุกรอบที่ผ่านมา G=131 และ
// ค่าเดิมไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive)
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #f7e4c0)
// ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง ปล่อยให้สืบทอดลงมา
// — มีแค่ปุ่ม ขอบรูป marker ของลำดับเลข และ <strong> ที่ประกาศสี โดย <strong>
// ใช้ทองซีด #ffd98a ตัวเดียว (12.3:1 บนผิวการ์ด) และแต่ละ <strong> ครอบ
// "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิด
// แท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 155 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} ไล่ดูหมวดบาคาร่า สล็อต บอลออนไลน์ ไฮโล และยิงปลาให้ครบหนึ่งรอบ พร้อมอ่านกติกา ตารางจ่าย และช่วงเดิมพันของแต่ละเกมก่อนเริ่มเดิมพันจริง`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} เกมคาสิโนรวม ไล่ดูหมวดเกมก่อนเริ่มเดิมพันจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#ffd98a]">{BRAND_NAME}</strong> คือเกมคาสิโนรวมที่นำเสนอทางเลือกการเดิมพันครบวงจรไว้ในแพลตฟอร์มเดียว
        <strong class="text-[#ffd98a]">ทั้งบาคาร่า สล็อต บอลออนไลน์ ไฮโล และเกมยิงปลา พร้อมหมวดเกมที่จัดเรียงให้ค้นหาได้สะดวก รองรับการใช้งานผ่านมือถือและคอมพิวเตอร์</strong>
        หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับระบบได้ไล่ดูให้ครบหนึ่งรอบ ตั้งแต่การเลือกหมวดเกมและเปิดรายละเอียดของเกมที่สนใจ ไปจนถึงเมนูจัดการบัญชีและการติดตามรายการ ก่อนจะเริ่มเดิมพันจริง
      </p>

      <p>
        คำว่า ทดลองเล่น ที่หน้านี้พูดถึงจึงหมายถึง
        <strong class="text-[#ffd98a]">การเปิดเว็บไซต์ไล่ดูหมวดเกมที่จัดไว้ เลือกเกมที่สนใจ แล้วอ่านกติกา ตารางจ่าย และช่วงเดิมพันของประเภทนั้นให้จบ</strong>
        ซึ่งเป็นสิ่งที่ระบบเปิดให้ทำได้อยู่แล้ว ไม่ใช่การแจกเครดิตทดลอง และไม่ใช่การรับประกันผลของรายการใดรายการหนึ่ง เพราะแต่ละเกมมีเงื่อนไขและยอดขั้นต่ำแตกต่างกัน จึงควรตรวจสอบรายละเอียดในระบบก่อนทำรายการ
      </p>

      <p>
        อีกเรื่องที่ควรไล่ดูไปพร้อมกันคือขอบเขตของสิ่งที่เปิดให้บริการจริง
        <strong class="text-[#ffd98a]">เพราะภาพลักษณ์เว็บดังของแท้ในตำนาน ควรมีข้อมูลประวัติการเปิดให้บริการ รายชื่อผู้ให้บริการเกม และรายละเอียดผู้ดำเนินงานที่ตรวจสอบได้ประกอบ</strong>
        เพราะความนิยมและความน่าเชื่อถือไม่สามารถยืนยันจากข้อความโฆษณาเพียงอย่างเดียว ส่วนจำนวนเกมและค่ายที่เปิดให้บริการจริงขึ้นอยู่กับระบบ การไล่ดูด้วยตัวเองหนึ่งรอบจึงให้ข้อมูลตรงกว่าค่าที่จำไว้จากรอบก่อนหน้า
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`หมวดเกมที่ ${BRAND_NAME} รวมไว้ในแพลตฟอร์มเดียว`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
