---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import popularGamesImage from "../assets/gamedemo8.webp";
import newGamesImage from "../assets/gamedemo16.webp";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริง
// ของบรีฟรอบนี้เท่านั้น (src/assets/content.txt) ไม่ใช่แก้ทับประโยคของแบรนด์ก่อน
// — ย่อหน้าเก่าทั้งย่อหน้าตั้งอยู่บนคำที่ brand-spec §6 สั่งห้าม จึงต้องเขียนใหม่
// ไม่ใช่ find-and-replace
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// ดรอปนี้ (2026-10-10) คือ **เว็บตรงฐานสล็อตหลัก ไม่ผ่านเอเย่นต์ ไม่ผ่านม้า**
// อัปเดตระบบเข้าเล่นใหม่ปี 2026 เป็นเว็บสล็อตล้วน ไม่ใช่เว็บหวยและไม่ใช่เว็บรวม
// ทุกหมวด (สองหน้าของหมวดหวยจอดอยู่ใน src/pages-disabled/ ไม่มี route จึงห้ามลิงก์
// ไปหา มิฉะนั้นเป็น href ตายที่ทำให้ build แดง) แง่มุมที่บรีฟระบุไว้มีเท่านี้:
// รองรับมือถือและคอมพิวเตอร์ · รวมเกมสล็อตหลายประเภทไว้ในบัญชีเดียว · สล็อตคลาสสิก
// เกมฟรีสปิน โบนัสตัวคูณ เกมใหม่จากค่ายที่เปิดให้บริการ · ค้นหาเกม ตรวจสอบเครดิต
// โปรโมชั่น และประวัติรายการ · จัดหมวดเกมให้เลือกใช้งานง่าย · หน้าเข้าสู่ระบบ
// เมนูเลือกเกม ส่วนจัดการบัญชี · ตรวจสอบช่องทางหลักก่อน Login ทุกครั้ง ·
// ข้อมูลผู้ดำเนินงานและรายชื่อค่ายเกมที่ตรวจสอบได้ · คืนยอดเสีย 0.3% เข้ายูสทุกวัน ·
// แนะนำเพื่อน แชร์ลิงก์ 0.8% · ยอดที่เข้าเกณฑ์ รอบคำนวณ รอบตัดยอด · ฝากถอนเข้าบัญชี
// บริษัทโดยตรง บัญชีปลายทาง นิติบุคคล หลักฐานธุรกรรม · แอดมิน 24 ชั่วโมง ·
// ช่องทางติดต่อหลัก · รหัสผ่าน PIN OTP
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามี "โหมดทดลอง" เครดิตทดลอง หรือเดโมฟรีเป็นบริการของเว็บ —
// จึงห้ามสัญญาสินค้าตัวนั้น คำว่า "ทดลองเล่น" บนหน้านี้จึงหมายถึงสิ่งที่บรีฟระบุไว้
// ตรงๆ ว่าทำได้: เปิดเว็บไล่ดูหมวดเกมและเมนูให้ครบหนึ่งรอบ ค้นหาเกม ตรวจสอบเครดิต
// อ่านรายละเอียดโปรโมชั่นกับประวัติรายการ แล้วจึงเริ่มเล่นจริง
//
// ⚠️ รูปในหน้านี้ใช้ได้แค่ gamedemo8 กับ gamedemo16 เท่านั้น — เป็นอาร์ตสต็อกกลาง
// ของเทมเพลต ไม่ใช่อาร์ตเวิร์กของแบรนด์นี้ จึงอยู่ต่อได้ แต่ alt ต้องบรรยายภาพจริง
// (รอบนี้เปิดรูปอ่านซ้ำแล้ว ไม่ได้ลอก alt มาเฉยๆ) และห้ามเอ่ยชื่อแบรนด์ใด
// ส่วน gamedemo7/9/10/11/12/14/15/17/18 มีโลโก้หรือชื่อของผู้ให้บริการเจ้าอื่น
// พิมพ์ทับอยู่กลางรูป และ gamedemo13 เป็นภาพล่อแหลม — ห้ามนำกลับมาใช้ เพราะเท่ากับ
// อ้างชื่อที่บรีฟไม่ได้เอ่ย ไฟล์ยังอยู่บนดิสก์ ห้ามลบ เป็นอินเวนทอรี
// gamedemo8 ("POPULAR GAME" 600x379) กับ gamedemo16 ("New Game" 650x411) ไม่มี
// ชื่อแบรนด์ใดปรากฏ ความกว้างที่วาดจริงสูงสุด ~600px ต่อใบ (กริดสองคอลัมน์ในการ์ด)
// จึงไม่ขยายเกินต้นฉบับ
//
// ⚠️ คำที่ห้ามหลงเหลือ: ศัพท์ของหมวดอื่นที่ไม่ใช่สล็อต และคำขายของของแบรนด์ก่อนๆ
// ที่บรีฟรอบนี้ไม่ได้เอ่ย — รายการเต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อ
// ไม่ให้ grep หาคำต้องห้ามเจอ false positive รายการตรวจก่อนเริ่มเล่น (<ol> ด้านล่าง)
// รอบนี้เขียนใหม่ทั้งสี่ข้อให้อ้างเฉพาะสิ่งที่บรีฟพูดถึงจริง
//
// ⚠️ ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 24 ชั่วโมง · 100% · 2026
// ห้ามเติมเลขใบอนุญาต หน่วยงานกำกับ ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP ยอดฝากขั้นต่ำ
// จำนวนสมาชิก หรือปีที่ก่อตั้ง เพราะบรีฟไม่ได้เอ่ยไว้สักอย่าง
//
// ประโยคกำกับของบรีฟที่ห้ามตัดทิ้ง (เป็นส่วนหนึ่งของคอปปี้ ไม่ใช่ filler):
// ไม่ควรใช้คำโฆษณาเพียงอย่างเดียวเป็นหลักฐานว่าเว็บเชื่อมต่อกับค่ายเกมโดยตรง ·
// คำว่าไม่จำกัดควรระบุให้ชัดว่าหมายถึงจำนวนเพื่อน จำนวนครั้ง หรือวงเงิน ·
// ชื่อบัญชีบริษัทเพียงอย่างเดียวไม่ได้รับประกันว่าธุรกรรมจะไม่มีความเสี่ยง ·
// ไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น แม้จะอ้างว่าเป็นเจ้าหน้าที่
//
// banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion · banner2/banner3 และ
// slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import (ลำพังการ import ก็ทำให้
// ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น Announcement5 ทั้งเว็บ (รอบก่อนใช้ Announcement2 —
// brand-spec §3 หมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้
// ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่ง
// จะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ทองสายฟ้า บนแดงเลือดนก** พลิกทิศจากคู่
// "แดงนำ-ทองรอง บนน้ำตาลถ่านเกือบดำ" ของแบรนด์ก่อน ซึ่งออกครบทุกจุดแล้ว ทั้งคลาส
// Tailwind raw hex และ rgba() (ค่าเดิมอยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำที่นี่ เพื่อ
// ไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive)
// ลำดับปุ่มสื่อด้วยขั้วสว่าง-เข้ม: ปุ่มหลักถมทองไล่เฉด #ffdd73 → #f5c518 → #b8860f
// ขอบ #b8860f หมึกน้ำตาลเกือบดำ #2a0300 · ปุ่มรองและปุ่มลิงก์ภายในเป็นผิวจม
// #6d0804 → #430000 ขอบทอง #f5c518/50 หมึกครีมอุ่น #f8d2bb · ขอบรูปใช้ทองแบบโปร่ง ·
// marker ของลำดับเลขใช้ทองสายฟ้า #f5c518
// ⚠️ ห้ามกลับด้าน: พื้นถมทองต้องใช้หมึกเข้มเสมอ ห้ามครีมหรือขาว และห้ามวาง
// ตัวอักษรเนื้อความบนแดงสายฟ้า #ff3b14 (3.6:1 บนผิวการ์ด) — เป็นสีของออรา เงา และ
// ปลายไล่เฉดของหัวข้อเท่านั้น ส่วน #8a6208 เป็นเงา/ออรา ไม่ถือตัวอักษรเช่นกัน
// ⚠️ แดงหรือทองไม่ใช่ตัวบอกว่าถูกแบรนด์: แบรนด์ก่อนก็เป็นคู่แดง-ทอง แต่คนละค่า
// ให้เทียบเป็นตัวๆ กับตารางใน brand-spec §2
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #fdf0e2)
// ไว้ที่ตัวการ์ดแล้ว ข้อความในหน้านี้จึงไม่ประกาศสีของตัวเองเลย ปล่อยให้สืบทอดลงมา
// — มีแค่ปุ่ม ขอบรูป และ marker ของลำดับเลขที่ประกาศสี เพราะเป็นพื้น/เส้น ไม่ใช่
// เนื้อความ ส่วน <strong> ใช้น้ำหนักตัวอักษรเป็นไฮไลต์ ไม่ประกาศสี และแต่ละ
// <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ
// ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 159 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} เว็บตรงฐานสล็อตหลัก ด้วยการไล่ดูหมวดเกมสล็อตและเมนูในระบบจริง ทั้งสล็อตคลาสสิก เกมฟรีสปิน โบนัสตัวคูณ และเงื่อนไขโปรโมชั่น ก่อนเริ่มเล่นจริง`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ไล่ดูหมวดเกมสล็อตและเมนูในระบบก่อนเริ่มเล่นจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong>{BRAND_NAME}</strong> เป็นเว็บตรงฐานสล็อตหลักที่นำเสนอระบบเข้าเล่นสล็อตออนไลน์รูปแบบใหม่ในปี 2026
        <strong>รองรับการใช้งานผ่านมือถือและคอมพิวเตอร์ พร้อมรวบรวมเกมสล็อตหลายประเภทไว้ในบัญชีเดียว</strong>
        หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับระบบได้ไล่ดูให้ครบหนึ่งรอบ ตั้งแต่เมนูเลือกเกมและหมวดที่เว็บไซต์จัดไว้ ไปจนถึงรายละเอียดโปรโมชั่นและส่วนจัดการบัญชี ก่อนจะเริ่มเล่นจริง
      </p>

      <p>
        คำว่า ทดลองเล่น ที่หน้านี้พูดถึงจึงหมายถึง
        <strong>การเปิดเว็บไซต์ไล่ดูหมวดเกมสล็อตที่จัดไว้ ค้นหาเกมจากเมนูเลือกเกม ตรวจสอบเครดิตและประวัติรายการ แล้วอ่านรายละเอียดโปรโมชั่นที่เปิดอยู่ให้จบ</strong>
        ซึ่งเป็นสิ่งที่ระบบเปิดให้ทำได้อยู่แล้ว ไม่ใช่การแจกเครดิตทดลอง ไม่ใช่การหมุนฟรี และไม่ใช่การรับประกันผลของเกมใดเกมหนึ่ง เมื่อเข้าสู่ระบบแล้ว สมาชิกจะเลือกหมวดเกมที่สนใจและตรวจสอบสถานะของรายการต่างๆ ได้จากบัญชีเดียว
      </p>

      <p>
        อีกเรื่องที่ควรไล่ดูไปพร้อมกันคือขอบเขตของสิ่งที่เปิดให้บริการจริง
        <strong>เพราะการยืนยันว่าเป็นเว็บตรงไม่ผ่านเอเย่นต์ ควรมีข้อมูลผู้ดำเนินงานและรายชื่อค่ายเกมที่ตรวจสอบได้รองรับ ไม่ควรใช้คำโฆษณาเพียงอย่างเดียวเป็นหลักฐาน</strong>
        และรายชื่อค่ายกับเกมที่เปิดอยู่ก็เปลี่ยนแปลงได้ตามช่วงเวลา การไล่ดูด้วยตัวเองหนึ่งรอบจึงให้ข้อมูลตรงกว่าถ้อยคำบนหน้าประชาสัมพันธ์ และใช้ตัดสินใจได้จริงกว่าค่าที่จำไว้จากรอบก่อนหน้า
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`หมวดเกมสล็อตที่ ${BRAND_NAME} จัดไว้ให้ค้นหาจากบัญชีเดียว`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        หลังเข้าสู่ระบบ ลำดับการใช้งานจะเป็นชุดเดียวกันทุกครั้ง
        <strong>เปิดเมนูเลือกเกม ไล่ดูสล็อตคลาสสิก เกมฟรีสปิน โบนัสตัวคูณ และเกมใหม่จากค่ายที่เปิดให้บริการ แล้วจึงอ่านรายการโปรโมชั่นที่เปิดอยู่</strong>
        เว็บไซต์เน้นการจัดหมวดเกมให้เลือกใช้งานได้ง่าย การไล่ดูให้ครบรอบหนึ่งก่อนจึงช่วยให้รู้ว่าข้อมูลแต่ละอย่างอยู่ตรงไหนของหน้าจอ และหาเมนูที่ต้องใช้จริงได้เร็วขึ้นในครั้งถัดไป
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={popularGamesImage}
