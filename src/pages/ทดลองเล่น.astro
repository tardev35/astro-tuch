---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { Picture } from "astro:assets";

import popularGamesImage from "../assets/gamedemo8.webp";
import newGamesImage from "../assets/gamedemo16.webp";

import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login,
// /register หรือหน้าภาพแบบ /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง
// ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้
// (src/assets/content.txt) ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่จาก
// ข้อเท็จจริงและคลังคำของบรีฟรอบนี้เท่านั้น (.claude/brand-spec-zane96.md §4-§5)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x4 · h3x0
//   h1  ทดลองเล่น <แบรนด์> ศึกษากติกาเกมสล็อตก่อนเดิมพันด้วยเงินจริง
//   h2  สล็อตคลาสสิก ฟีเจอร์ฟรีสปิน และเกมโบนัส ต่างกันที่รายละเอียดใด
//   h2  ยอดเดิมพันเริ่มต้น 1 บาท กับยอดขั้นต่ำที่แต่ละเกมกำหนดไม่เท่ากัน
//   h2  ตารางจ่ายรางวัลและกติกาของเกม สองจุดที่ควรเปิดอ่านก่อนตั้งยอดเดิมพัน
//   h2  ค่า RTP และความผันผวนของเกม ใช้ทำความเข้าใจความเสี่ยง ไม่ใช่การรับประกันผล
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// **การ์ดรูปสองใบอยู่ใน h2 ใบแรก ไม่ได้แยกเป็นหัวข้อของตัวเอง** เพื่อคงผัง h2x4
// ป้ายกำกับของการ์ดรูปอยู่ในตัวภาพเอง (alt) ไม่มีป้ายข้อความใดเป็น heading
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// 🚨🚨 **คำว่า "ทดลองเล่น" อยู่ได้เฉพาะเพราะเป็นชื่อ route /ทดลองเล่น และชื่อเมนู
// จริง** (ใช้ใน h1 · title · description · breadcrumb) แต่ **บรีฟรอบนี้ไม่ได้
// พูดถึงโหมดเล่นโดยไม่ใช้เงินจริงเลยแม้แต่ประโยคเดียว** → **ห้ามอ้างว่าเว็บมี
// โหมดนั้นให้** ห้ามอ้างจำนวนเกมที่เล่นได้ ห้ามอ้างค่า RTP เป็นตัวเลข และห้ามอ้าง
// ว่าผลที่ออกในการลองสะท้อนผลจริง แกนของหน้าจึงเป็น **"สิ่งที่ควรศึกษาและตรวจสอบ
// เกี่ยวกับเกมที่ระบุไว้ ก่อนเดิมพันด้วยเงินจริง"** ตามที่บรีฟมีจริง (บรรทัด 6):
// สล็อตคลาสสิก · เกมที่มีฟีเจอร์ฟรีสปิน · เกมโบนัสที่มีกติกาแตกต่างกัน ·
// เดิมพันเริ่มต้น 1 บาทสำหรับบางรายการตามที่ระบุ · ยอดเดิมพันขั้นต่ำของแต่ละเกม
// อาจไม่เท่ากัน · ตารางจ่ายรางวัลและกติกาของแต่ละเกม · **ค่า RTP และความผันผวน
// ของเกม เพื่อทำความเข้าใจความเสี่ยงโดยไม่คาดหวังผลรางวัลที่แน่นอน**
// ⚠️ และมีหนึ่งประโยคที่พูดตรงๆ ว่าบรีฟไม่ได้ระบุโหมดนั้นไว้ เพื่อไม่ให้ผู้อ่าน
// อนุมานเอาจากชื่อเมนู — **ห้ามถอดประโยคนั้นออก**
// ⚠️ บรีฟรอบนี้ **โฆษณาและกำกับในประโยคเดียวกัน** คำโฆษณาอยู่ได้เฉพาะในขอบเขตที่
// บรีฟเขียนไว้เอง ห้ามขยายเป็นคำกล่าวอ้างใหม่ และทุกประโยคกำกับต้อง ship ครบ
// ห้ามตัดเพราะฟังดูลบ
//
// ⚠️⚠️ ชื่อแบรนด์รอบนี้เป็น **ตัวละตินพิมพ์ใหญ่ + เลข เขียนติดกัน ไม่มีเว้นวรรค**
// (brand-spec §1) ทุกจุดยัง interpolate จาก BRAND_NAME เหมือนเดิม เพื่อไม่ให้ค้าง
// เป็นชื่อแบรนด์ก่อนหน้าตอนรีแบรนด์รอบถัดไป ห้ามพิมพ์ชื่อตรงๆ
// ⚠️⚠️ คำนิยามตัวเองของแบรนด์ขาออกเป็น **คำค้างข้ามแบรนด์** ห้ามหลุดกลับมา
// **รายการคำต้องห้ามเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่** เพื่อไม่ให้
// sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// 🚨 **สองคู่ที่ต่างกันคำเดียวและพลาดง่ายที่สุด**: บรีฟรอบนี้เขียนว่าโปรโมชั่น
// อัปเดตใหม่ "**ทุก**สัปดาห์" และสมัคร "ด้วย**มือถือ**" 3 ขั้นตอน
// 🚨🚨 **บรีฟรอบนี้ไม่พูดถึงธนาคาร วอลเลท หรือการฝากถอนเลยแม้แต่คำเดียว** —
// หัวข้อ "ฝากถอน" ทั้งหัวข้อที่เคยอยู่บนหน้านี้ตอนรอบก่อนๆ **ถูกตัดออกทั้งบล็อก**
// และชื่อวอลเล็ตของแบรนด์เก่าคือคำที่พลาดง่ายที่สุด (ไม่พิมพ์ซ้ำที่นี่)
//
// ⚠️ **รอบนี้สองหน้าหมวดลอตเตอรียังถูกปิด** (อยู่ใน src/pages-disabled/ เพราะรอบนี้
// เป็นเว็บสล็อต) ลิงก์ไปสอง route นั้นจากหน้านี้จึงไม่มี — verify-build จะแดงถ้า
// href ชี้ไป route ที่ไม่มีจริง และห้ามใช้คำศัพท์หมวดลอตเตอรีในเนื้อหา
// route ที่มีจริงรอบนี้: / · /about-us · /contact-us · /promotion · /ทดลองเล่น ·
// /ทางเข้า · /login · /register · /terms · /privacy · 404 · /line
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกม ชื่อผู้ให้บริการ หน่วยงานกำกับ ใบอนุญาต
// ปีก่อตั้ง จำนวนสมาชิก จำนวนเกม จำนวนค่าย ตัวเลข RTP อัตราจ่ายที่เป็นตัวเลข
// หรือยอดขั้นต่ำอื่น แม้แต่รายการเดียว** จึงห้ามเขียนลงหน้าเว็บ ·
// ตัวเลขที่ขึ้นหน้าได้มีแค่ของบรีฟเอง: **1 บาท · 0.3% · 0.8% · 3 ขั้นตอน · 24ชม.**
// และหน้านี้หยิบมาใช้แค่ **1 บาท** ตัวเดียว เพราะเป็นตัวเดียวที่เกี่ยวกับแกนของหน้า
//
// 🚨 **รูปในหน้านี้ใช้ได้แค่ gamedemo8 กับ gamedemo16 เท่านั้น** — เป็นอาร์ตสต็อก
// (mtime 2026-08-04) ไม่ใช่อาร์ตเวิร์กของดรอปนี้ จึงใช้เป็นภาพประกอบหมวดเกมได้
// แต่ **ห้ามใช้แทนอาร์ตเวิร์กแบรนด์** gamedemo8 ("POPULAR GAME" 600x379) กับ
// gamedemo16 ("New Game" 650x411) ไม่มีโลโก้หรือชื่อค่ายเกมเจ้าอื่นพิมพ์ทับอยู่
// ส่วน gamedemo7/9/10/11/12/14/15/17/18 มีโลโก้หรือชื่อของผู้ให้บริการ/ค่ายเกม
// เจ้าอื่นพิมพ์ทับอยู่กลางรูป และ gamedemo13 เป็นภาพล่อแหลม — **ห้ามนำกลับมาใช้**
// ⚠️ เปิดรูปจริงทั้งสองใบรอบนี้แล้ว · alt บรรยายสิ่งที่เห็นจริง (กระต่ายกับแมวใส่
// แว่นกันแดดและหูฟัง / ฟักทองหัวโตกับโครงกระดูก) **ไม่ใช่ตัวนับแบบ "เกมที่ 3"**
// และไม่เอ่ยชื่อแบรนด์ เพราะไม่มีชื่อแบรนด์ใดพิมพ์อยู่บนรูป
// ⚠️ ทั้งสองใบวาดกว้างสุด 600px (กริดสองคอลัมน์ตั้งแต่ sm ขึ้นไป) widths/sizes
// จึงตั้งตามนั้น ไม่ใช่ตามขนาดไฟล์ต้นฉบับ
// 🚨 **ห้าม import อาร์ตเวิร์กของแบรนด์อื่นจากหน้านี้เด็ดขาด**: banner2/banner3
// และ slide3/slide4 เป็นของแบรนด์อื่น · slide1/slide2 ถูกตรึงไว้กับ index §4
// ข้อ 4-5 กับ /promotion · banner1 / banner1-mobile / og.png เป็นของ glob ที่
// MainLayout ปักไว้ **ห้ามอ้างจากหน้านี้** · ลำพังการ import ก็ทำให้ไฟล์ถูก emit
// ลง dist/ ทุก build และ verify-build จะแดง · ไฟล์เก่าทั้งหมดยังอยู่บนดิสก์
// **ห้ามลบ** เป็นอินเวนทอรีของแบรนด์ถัดไป
//
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) **เนื้อหายังเป็นธีมสว่างและโครมยังเข้มเหมือน
// รอบก่อน แต่ฮิวคนละตระกูลสิ้นเชิง** bg.json ของดรอปนี้คือ
// {"mode":"color","color":"#f8e6f9"} = **ไลแลคอมชมพูจาง** (รอบก่อนเป็นขาวอมชมพู
// ที่จางกว่านี้) **ห้ามเดาว่าเท่าเดิม และห้าม "แก้" การ์ด/ปุ่มให้เป็นพื้นมืดตาม
// โครม** — พื้นมืดบนหมึก #241046 = ตัวอักษรหายไปเลย ไม่ใช่แค่จางลง
// ค่าที่ใช้ได้ในไฟล์นี้: หัวข้อ/`<strong>`/marker ของลำดับเลข **#5411c4**
// (9.3:1 บนการ์ดขาว) · เข้มสุด #241046 (16.8:1) · หมึกรอง #6b4a86 (7.1:1) ·
// ฮิวนำ #7a1bd6 (7.1:1) · ฟ้าอิเล็กทริก #2b3fd9 (7.5:1) · แมเจนต้า #c2178b
// (5.6:1) · พื้นไล่เฉดปุ่มหลัก #5411c4 -> #8e14b8 -> #c2178b (**พื้นถม** +
// หมึกขาว #ffffff) · ปุ่มรองเป็นผิวสว่าง #ffffff -> #ece0fb คู่กับหมึก #241046 ·
// ผิวยก #f6edfe · wash #ece0fb · เส้นอ่อน #dcc6f4 · เส้นเข้ม #9a6fd0
// (**ทั้งคู่ห้ามถือตัวอักษร** ใช้เป็นขอบการ์ดรูปได้)
// หมึกเนื้อความคือ #241046 (= BRAND_TEXT) ซึ่ง **ไม่ประกาศในไฟล์นี้** การ์ด
// ContentBox ตั้งไว้ให้แล้วและย่อหน้าสืบทอดลงมา
// 🚨🚨 **#f23bb4 บนพื้นขาวได้แค่ 3.5:1 และ #bb6dff ได้ 3.1:1 — ห้ามเป็นสี
// ตัวอักษร** และ **ขาวบนสองค่านั้นได้ 2.6 / 2.0:1** พื้นที่รับหมึกขาวได้ต้องเป็น
// **#c2178b (5.6:1) ขึ้นไปหาเข้ม** เท่านั้น · #7aa7ff #f8e6f9 #f6edfe #ece0fb
// #dcc6f4 ก็ห้ามถือตัวอักษร และ #9a6fd0 เป็นเส้น/ขอบเท่านั้น
// 🚨🚨 **#190b3d #271257 #100626 #5b2f9e #f3e8ff #c0a6e8 เป็นค่าของผิวโครมเข้ม
// เท่านั้น ห้ามหลุดเข้ามาในไฟล์นี้**
// ออราที่อนุญาต: rgba(84,17,196,α) · rgba(122,27,214,α) · rgba(194,23,139,α) ·
// rgba(242,59,180,α) · rgba(36,16,70,α) · rgba(220,198,244,α)
// ⚠️⚠️ **รอบนี้ไม่มีแดง ไม่มีทอง/เหลือง/ส้ม ไม่มีครีม/เบจ ไม่มีเทาเงิน และไม่มี
// เขียวแบรนด์เลยสักเฉด** — เหรียญในรูป gamedemo8 กับดาวในรูป gamedemo16
// เป็น **วัตถุในภาพ ไม่ใช่สี UI** เช่นเดียวกับตู้สล็อต 777 ผิวแก้วม่วง ชิป
// คาสิโนแมเจนต้า เชอร์รี่ชมพู เพชรม่วง ชุดเมทัลลิกโฮโลแกรม และสีผิวนักแสดงใน
// อาร์ตเวิร์กของแบรนด์
// ⚠️⚠️ **ไล่เฉดฟ้า→ม่วง→แมเจนต้าของอาร์ตเวิร์กคร่อมสามตระกูลที่เคยเป็นฮิวนำของ
// แบรนด์ก่อนๆ พร้อมกัน การเจอม่วง/ชมพู/ฟ้าในไฟล์จึงไม่พิสูจน์อะไร** — ห้ามเทียบ
// ด้วยวงศ์สี ต้องเทียบทีละค่ากับตาราง brand-spec §2 (ค่าที่ใกล้จนต้องสงสัยว่า
// พิมพ์ผิดก่อนเสมอถูกลิสต์ไว้ในไฟล์นั้นแล้ว และเขียนแบบไม่มี # โดยตั้งใจ
// เพื่อไม่ให้ sweep สะดุด)
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง และไม่ใส่ mx-auto / max-w-* บน <p>
// เพราะการ์ดคุมความกว้างเองแล้ว — ที่ประกาศสีได้มีแค่ปุ่ม ชิปไอคอน marker ของ
// ลำดับเลข ขอบการ์ดรูป และ <strong> · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วย
// ช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ
// บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง และห้ามวาง <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังในข้อความของ prop และต้องเป็นไอคอนหมวดสล็อต ไม่ใช่ไอคอนหมวดลอตเตอรี
// slot ของ ContentBox รับ **หนึ่ง element** เท่านั้น จึงห่อด้วย <div> ชั้นเดียว
//
// Announcement รอบนี้หมุนมาเป็นตัวเลข 2 ของตระกูล ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ตัวเลข 5 จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็น
// คอปปี้ของแบรนด์นี้แล้ว จึงเรียกแบบ bare **ห้ามส่ง prop message** มิฉะนั้นข้อความ
// ตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -c บนเชลล์นี้
// ก็นับเป็นไบต์ ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับตัวนับ
// ของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 155 อักขระ (ชื่อแบรนด์รอบนี้ 6 อักขระ) เป็นประโยคเดียวที่บอกว่า
// หน้านี้มีไว้ทำอะไร แล้วหยุด
// (Google ตัดราว 160 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนๆ ยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} รวมสิ่งที่ควรศึกษาก่อนเดิมพันด้วยเงินจริง ทั้งประเภทเกมสล็อต ยอดเดิมพันเริ่มต้น 1 บาท ตารางจ่ายรางวัล และแนวคิดค่า RTP กับความผันผวนของเกม`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ศึกษากติกาเกมสล็อตก่อนเดิมพันด้วยเงินจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});

// คลาสปุ่มสามขั้วของหน้านี้ ประกาศครั้งเดียวแล้วใช้ซ้ำ เพื่อไม่ให้สองปุ่มที่ทำ
// หน้าที่เดียวกันหลุดไปคนละเฉดตอนรีแบรนด์รอบหน้า
const ctaPrimary =
  "flex items-center justify-center rounded-full border border-[#5411c4] bg-gradient-to-b from-[#5411c4] via-[#8e14b8] to-[#c2178b] px-8 py-3 font-black text-white shadow-[0_6px_18px_rgba(84,17,196,0.3)] transition-transform hover:scale-105";

const ctaSecondary =
  "flex items-center justify-center rounded-full border border-[#9a6fd0] bg-gradient-to-b from-[#ffffff] to-[#ece0fb] px-8 py-3 font-bold text-[#241046] shadow-[0_6px_18px_rgba(220,198,244,0.45)] transition-transform hover:scale-105";

const ctaQuiet =
  "flex items-center justify-center rounded-full border-2 border-[#5411c4] bg-[#ffffff] px-8 py-3 font-bold text-[#5411c4] shadow-[0_4px_14px_rgba(84,17,196,0.2)] transition-all hover:scale-105 hover:bg-[#f6edfe] hover:shadow-[0_6px_18px_rgba(122,27,214,0.2)]";

const listChip = "mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#dcc6f4] bg-[#f6edfe] text-sm";

const gameCard = "mx-auto block h-auto w-full max-w-[600px] rounded-2xl border border-[#9a6fd0]";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#5411c4]">{BRAND_NAME} นำเสนอเกมสล็อตออนไลน์จากค่ายเกมหลากหลายแบรนด์ พร้อมระบบสมาชิกที่ออกแบบให้ใช้งานผ่านมือถือได้สะดวก</strong>
        หน้านี้รวบรวมไว้ว่าควรศึกษาอะไรเกี่ยวกับเกมที่ระบุไว้ และควรตรวจอะไรซ้ำทุกครั้งที่กลับเข้ามาใหม่ ก่อนตัดสินใจเดิมพันด้วยเงินจริง
      </p>

      <p>
        ภายในเว็บไซต์รวบรวมข้อมูลเกมสล็อต โปรโมชั่น และช่องทางติดต่อเจ้าหน้าที่ไว้ในที่เดียว ผู้ใช้งานจึงศึกษารายละเอียดเกมและเงื่อนไขต่าง ๆ ก่อนใช้งานได้จากช่องทางเดียว ส่วน
        <strong class="text-[#5411c4]">คำกล่าวอ้างเกี่ยวกับลิขสิทธิ์เกมและการเป็นเว็บตรงไม่ผ่านเอเย่นต์ ควรตรวจสอบข้อมูลบริษัทและหลักฐานการได้รับอนุญาตจากแหล่งที่เชื่อถือได้</strong>
        ไม่ใช่ยืนยันจากข้อความโฆษณาเพียงอย่างเดียว
      </p>

      <p>
        <strong class="text-[#5411c4]">ข้อมูลที่เว็บไซต์ระบุไว้ไม่ได้กล่าวถึงการเปิดให้หมุนเกมโดยไม่ใช้เงินจริงไว้แต่อย่างใด</strong>
        หน้านี้จึงไม่ยืนยันว่ามีรูปแบบนั้นให้ใช้งาน และควรตรวจสอบจากประกาศล่าสุดของเว็บไซต์ทางการเองว่าเกมใดเปิดให้ศึกษาได้ในลักษณะใด เนื้อหาด้านล่างเขียนไว้ประกอบการใช้งานเท่านั้น ไม่ได้ใช้แทนเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้บริการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="สล็อตคลาสสิก ฟีเจอร์ฟรีสปิน และเกมโบนัส ต่างกันที่รายละเอียดใด" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        เว็บไซต์ระบุรูปแบบเกมสล็อตไว้สามกลุ่ม และ
        <strong class="text-[#5411c4]">แต่ละกลุ่มมีจุดที่ต้องเปิดอ่านคนละจุดก่อนเริ่มเดิมพันจริง</strong>
        รายการด้านล่างสรุปไว้ว่าควรมองหาอะไรในแต่ละกลุ่ม โดยไม่ได้ระบุจำนวนเกมหรือจำนวนค่ายใดเพิ่มเติม เพราะข้อมูลนั้นต้องดูจากหน้าเกมจริงของเว็บไซต์เท่านั้น
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={popularGamesImage}
          alt="การ์ดหมวดเกมยอดนิยม เป็นภาพกระต่ายการ์ตูนกับแมวการ์ตูนสวมแว่นกันแดดและหูฟัง ยืนขนาบข้างหีบสมบัติที่มีเหรียญล้นออกมา มีชิปคาสิโนลายโพดำลอยอยู่รอบ และมีข้อความ POPULAR GAME ตัวหนาอยู่กลางภาพ"
          loading="lazy"
          fetchpriority="low"
          decoding="async"
          widths={[300, 600]}
          sizes="(max-width: 639px) 100vw, 600px"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={62}
          class={gameCard}
        />

        <Picture
          src={newGamesImage}
          alt="การ์ดหมวดเกมเปิดใหม่ เป็นภาพตัวละครหัวฟักทองสวมหมวกปีกกว้างกับโครงกระดูกการ์ตูนยืนขนาบข้างบนลานกระเบื้องเรืองแสง มีอัญมณีสีสดและดาวกระจายอยู่ และมีข้อความ New Game ตัวหนาอยู่กลางภาพ"
          loading="lazy"
          fetchpriority="low"
          decoding="async"
          widths={[300, 600]}
          sizes="(max-width: 639px) 100vw, 600px"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={62}
          class={gameCard}
        />
      </div>

      <ul class="flex flex-col gap-4" aria-label="รูปแบบเกมสล็อตที่เว็บไซต์ระบุไว้">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🍒</span>
          <span>
            <strong class="text-[#5411c4]">สล็อตคลาสสิก</strong> เป็นกลุ่มที่โครงเกมเรียบที่สุด จุดที่ควรอ่านก่อนคือรูปแบบการนับผลของหนึ่งรอบ และเงื่อนไขที่เกมใช้ตัดสินว่ารอบนั้นเข้าเกณฑ์จ่ายหรือไม่
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🌀</span>
          <span>
            <strong class="text-[#5411c4]">เกมที่มีฟีเจอร์ฟรีสปิน</strong> มีรอบพิเศษที่เข้าสู่รอบนั้นด้วยเงื่อนไขเฉพาะ ควรอ่านให้ชัดว่าต้องเกิดอะไรจึงเข้ารอบได้ และรอบนั้นคิดผลด้วยกติกาเดียวกับรอบปกติหรือไม่
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎁</span>
          <span>
            <strong class="text-[#5411c4]">เกมโบนัสที่มีกติกาแตกต่างกัน</strong> คือกลุ่มที่กติกาต่างกันมากที่สุดระหว่างเกมต่อเกม การเปิดหน้ากติกาของเกมนั้นโดยเฉพาะจึงจำเป็นกว่ากลุ่มอื่น ไม่ควรเทียบเอาจากเกมที่เคยเล่นมาก่อน
          </span>
        </li>
      </ul>
    </div>
  </ContentBox>

  <ContentBox title="ยอดเดิมพันเริ่มต้น 1 บาท กับยอดขั้นต่ำที่แต่ละเกมกำหนดไม่เท่ากัน" as="h2">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#5411c4]">เว็บไซต์ระบุข้อมูลการเดิมพันเริ่มต้น 1 บาทสำหรับบางรายการตามที่ระบุไว้</strong>
        ซึ่งเป็นข้อมูลที่ผูกกับรายการนั้นโดยเฉพาะ ไม่ใช่ค่ากลางที่ใช้ได้กับทุกเกมในเว็บไซต์ สมาชิกใหม่จึงควรเปิดดูยอดเดิมพันขั้นต่ำของเกมที่จะเล่นจากหน้าเกมนั้นเองก่อนทุกครั้ง
      </p>

      <p>
        เหตุผลตรงไปตรงมา คือ
        <strong class="text-[#5411c4]">เกมสล็อตแต่ละประเภทอาจกำหนดวงเงินเดิมพันไม่เท่ากัน</strong>
        การเห็นยอดเริ่มต้นของเกมหนึ่งแล้วอนุมานไปถึงเกมอื่นจึงคลาดเคลื่อนได้ตั้งแต่รอบแรก และค่าที่แสดงอยู่บนหน้าเกมในขณะใช้บริการคือค่าที่ใช้จริง ไม่ใช่ค่าที่จำไว้จากครั้งก่อน
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/promotion" aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`} class={ctaQuiet}>ดูภาพโปรโมชั่น</a>

        <a href="/about-us" aria-label={`อ่านหน้าเกี่ยวกับเราของ ${BRAND_NAME}`} class={ctaQuiet}>อ่านเกี่ยวกับเรา</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="ตารางจ่ายรางวัลและกติกาของเกม สองจุดที่ควรเปิดอ่านก่อนตั้งยอดเดิมพัน" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#5411c4]">การอ่านกติกาของเกมที่จะเล่นจากหน้ากติกาของเกมนั้นเอง ตรงกว่าการเทียบจากหน้าตาของวงล้อเพียงอย่างเดียว</strong>
        เพราะแต่ละเกมกำหนดรูปแบบการคิดผลไว้คนละชุด รายการด้านล่างคือลำดับที่เปิดอ่านได้เร็วที่สุดก่อนตั้งยอดเดิมพันรอบแรก
      </p>

      <ol class="ml-6 list-decimal space-y-3 marker:font-black marker:text-[#5411c4]">
        <li>
          <strong class="text-[#5411c4]">ตารางจ่ายรางวัลของเกมนั้น</strong> เป็นข้อมูลที่บอกเงื่อนไขการจ่ายของเกมตามที่ผู้ให้บริการกำหนด ไม่ใช่สิ่งที่คาดเดาจากภาพหน้าเกมได้ จึงควรเปิดดูควบคู่กับกติกาเสมอ
        </li>
        <li>
          <strong class="text-[#5411c4]">กติกาของแต่ละเกมก่อนใช้งาน</strong> คือจุดที่บอกว่าหนึ่งรอบคิดผลอย่างไรและนับยอดจากอะไร ซึ่งต่างกันได้มากระหว่างเกมที่หน้าตาคล้ายกัน
        </li>
        <li>
          <strong class="text-[#5411c4]">ข้อกำหนดการใช้บริการของเว็บไซต์</strong> ควรศึกษาให้ครบก่อนเริ่มใช้งาน เพราะเป็นเอกสารที่ใช้ประกอบการพิจารณาความน่าเชื่อถือร่วมกับข้อมูลผู้ให้บริการเกม
        </li>
        <li>
          <strong class="text-[#5411c4]">ประกาศล่าสุดของเว็บไซต์ทางการ</strong> คือจุดที่เงื่อนไขจริงถูกอัปเดต ทั้งเกมที่เปิดให้บริการและรายการโปรโมชั่น การเปิดดูก่อนทุกครั้งจึงตรงกว่าการจำไว้จากครั้งก่อน
        </li>
      </ol>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/register" aria-label={`สมัครสมาชิก ${BRAND_NAME}`} class={ctaPrimary}>สมัครสมาชิก</a>

        <a href="/login" aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`} class={ctaSecondary}>เข้าสู่ระบบ</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="ค่า RTP และความผันผวนของเกม ใช้ทำความเข้าใจความเสี่ยง ไม่ใช่การรับประกันผล" as="h2">
    <div class="flex flex-col gap-5">
      <p>
        นอกจากกติกาและตารางจ่ายรางวัลแล้ว
        <strong class="text-[#5411c4]">ควรศึกษาค่า RTP และความผันผวนของเกม เพื่อทำความเข้าใจความเสี่ยงโดยไม่คาดหวังผลรางวัลที่แน่นอน</strong>
        สองค่านี้อธิบายลักษณะของเกมในระยะยาวเท่านั้น ไม่ได้บอกว่ารอบถัดไปจะออกอย่างไร และหน้านี้ไม่ระบุตัวเลขของเกมใด เพราะค่าที่ใช้จริงต้องอ่านจากหน้าข้อมูลของเกมนั้นเอง
      </p>

      <p>
        เกมสล็อตมีผลลัพธ์ที่ไม่แน่นอนในแต่ละรอบโดยตัวของมันเอง
        <strong class="text-[#5411c4]">ผลที่ออกในรอบก่อนจึงไม่ใช่สถิติที่นำมาคาดการณ์รอบถัดไปได้</strong>
        และการศึกษากติกาช่วยให้เข้าใจว่าเกมคำนวณผลอย่างไรเท่านั้น ไม่ได้เพิ่มโอกาสชนะในรอบใด หากมีข้อสงสัยเกี่ยวกับระบบสมาชิกหรือรายละเอียดเกม ควรสอบถามเจ้าหน้าที่ผ่านช่องทางทางการก่อนทำรายการ โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้ใครทราบ
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact-us" aria-label={`ดูช่องทางติดต่อทีมงาน ${BRAND_NAME} ทั้งหมด`} class={ctaQuiet}>ช่องทางติดต่อทั้งหมด</a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
