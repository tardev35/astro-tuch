---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import popularGamesImage from "../assets/gamedemo8.webp";
import newGamesImage from "../assets/gamedemo16.webp";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion,
// /login, /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์
// หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้า
// ขึ้นใหม่บนข้อเท็จจริงของบรีฟรอบนี้เท่านั้น (src/assets/content.txt)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// ดรอปนี้คือ **เว็บคาสิโนไลฟ์ 24 ชม. + สล็อต + บอล** ไม่ใช่เว็บหวย และไม่ใช่เว็บ
// สล็อตเบทต่ำแบบรอบก่อน แง่มุมที่บรีฟระบุไว้มีเท่านี้: รวมเกมเดิมพันหลายรูปแบบไว้ใน
// ระบบเดียว · บาคาร่า รูเล็ต ไฮโล สล็อต บอล · เข้าเล่นผ่านมือถือและคอมพิวเตอร์ ·
// เลือกโต๊ะสดหรือหมวดเกมจากบัญชีเดียว · ระบบจัดหมวดหมู่ชัดเจน สลับระหว่างคาสิโน
// สล็อต และกีฬาได้สะดวก · สล็อตมีเกมโบนัส ฟรีสปิน ตัวคูณ · บอลเลือกคู่แข่งขันและ
// ตลาดเดิมพันตามช่วงเวลาที่ระบบเปิดรับ · Login ดูเครดิต โปรโมชั่น ประวัติรายการจาก
// บัญชีเดียว · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · สมัคร 3 ขั้นตอน ·
// แอดมิน 24 ชั่วโมง · PIN รหัสผ่าน OTP
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามี "โหมดทดลอง" เครดิตทดลอง หรือเดโมฟรีเป็นบริการของเว็บ —
// จึงห้ามสัญญาสินค้าตัวนั้น คำว่า "ทดลองเล่น" บนหน้านี้จึงหมายถึงสิ่งที่บรีฟระบุไว้
// ตรง ๆ ว่าทำได้: เลือกหมวดเกม เปิดดูโต๊ะที่เปิดบริการ ตรวจสถานะของโต๊ะหรือรายการ
// และดู Limit ของเกมก่อนยืนยันการเดิมพัน = ไล่ดูระบบให้ครบหนึ่งรอบ
//
// ⚠️ รูปในหน้านี้ใช้ได้แค่ gamedemo8 กับ gamedemo16 เท่านั้น — ตรวจไฟล์ทั้ง 12 ใบ
// ด้วยตาแล้ว อีก 10 ใบมีโลโก้/ชื่อของผู้ให้บริการหรือค่ายเกมเจ้าอื่นพิมพ์ทับอยู่กลางรูป
// (gamedemo7 askmeslot · 9 SLOTXO · 10 Skywind Group · 11 PG Pocket Games Soft ·
// 12 SBOBET · 14 JILI · 15 askmebet · 17 JOKER · 18 AFB777 Gaming · 13 เป็นภาพ
// ล่อแหลม) การนำกลับมาเท่ากับเอาชื่อค่ายเกมและแบรนด์ของลูกค้าเจ้าอื่นขึ้นหน้าเว็บนี้
// ซึ่งขัดกับ brand-spec §2 โดยตรง (ห้ามอ้างชื่อผู้ให้บริการ/ค่ายเกมที่บรีฟไม่ได้เอ่ย)
// ไฟล์ยังอยู่บนดิสก์ ห้ามลบ เป็นอินเวนทอรี
// ส่วน gamedemo8 ("POPULAR GAME" 600x379) กับ gamedemo16 ("New Game" 650x411)
// เป็นอาร์ตกลางที่ไม่มีชื่อแบรนด์ใดปรากฏ จึงใช้ประกอบหัวข้อหมวดเกมยอดนิยม/เกมเปิดใหม่ได้
// ความกว้างที่วาดจริงสูงสุด ~600px ต่อใบ (กริดสองคอลัมน์ในการ์ด) จึงไม่ขยายเกินต้นฉบับ
//
// ⚠️ คำที่ห้ามหลงเหลือ: ศัพท์หมวดลอตเตอรีทั้งชุด (เป็นของอินเวนทอรี *Huay ที่จอดไว้)
// และคำขายของของแบรนด์ก่อนที่บรีฟรอบนี้ไม่ได้เอ่ย — รายการเต็มอยู่ใน brand-spec §2
// ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำต้องห้ามเจอ false positive
// สองหน้าของหมวดนั้นจอดอยู่ใน src/pages-disabled/ จึงไม่มีปลายทางให้ลิงก์รอบนี้
//
// ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 24 ชั่วโมง · 3 ขั้นตอน
// ห้ามเติมเลขใบอนุญาต หน่วยงานกำกับ ชื่อผู้ให้บริการ ชื่อค่ายเกม ชื่อธนาคาร
// ค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีที่ก่อตั้ง เพราะบรีฟไม่ได้เอ่ยไว้
//
// ประโยคกำกับของบรีฟที่ห้ามตัดทิ้ง: "ไม่มีขั้นต่ำทุกรูปแบบเกม" ควรอ้างอิงวงเงินจริง
// ภายในระบบ · "คาสิโนไม่จำกัดยอด" ควรพิจารณาจากวงเงินของโต๊ะและเกมจริง ตรวจ Limit
// ก่อนเดิมพัน · โต๊ะคาสิโนไลฟ์และการแข่งขันกีฬาบางรายการมีช่วงเวลาให้บริการต่างกัน
//
// banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// slide1/slide2 ของดรอปนี้เป็นของ index และ /promotion · slide3/slide4/banner2/
// banner3 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import (ลำพังการ import ก็ทำให้ไฟล์ถูก
// emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น Announcement3 ทั้งเว็บ (รอบก่อนใช้ตัว *Premium —
// brand-spec §5 หมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ
// แบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะ
// ไม่ตรงกันทั้งเว็บ
//
// พาเลตต์รอบนี้ (brand-spec §3) เป็นแบรนด์ **สามสี: แดงนำ / เขียวมรกตรอง / ทองคั่น**
// บนพื้นเกือบดำอมแดง — พลิกฮิวจากทอง-เงินโครเมียมของรอบก่อน ชุดเดิมออกครบทุกจุดแล้ว
// ทั้งคลาส Tailwind raw hex และ rgba() (ค่าเดิมอยู่ใน brand-spec §3 ไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive)
// ปุ่มหลักถมแดงไล่ #e0201f → #c41115 → #7a0505 ตัวอักษรขาว ขอบทองลึก #8c6410 ·
// ปุ่มรองถมเขียวมรกต #0b7a33 → #063f1c ตัวอักษรขาว ขอบเขียวสว่าง #2bbf63/60
// (เขียวสว่างใช้เป็นเส้นเท่านั้น ห้ามถมเป็นพื้นของตัวอักษรขาว) · ปุ่มลิงก์ภายในเป็น
// ผิวการ์ด #1d0b08 → #090302 ขอบทองแบรนด์ #d9a521/60 ตัวอักษรทองอ่อน #ffdf91 ·
// ขอบรูปและ marker ของลำดับเลขใช้ทองแบรนด์ #d9a521
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #f6e3cf)
// ไว้ที่ตัวการ์ดแล้ว ข้อความในหน้านี้จึงไม่ประกาศสีของตัวเองเลย ปล่อยให้สืบทอดลงมา
// — มีแค่ปุ่ม ขอบรูป และ marker ของลำดับเลขที่ประกาศสี เพราะเป็นพื้น/เส้น ไม่ใช่เนื้อความ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 151 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} ด้วยการไล่ดูระบบจริงให้ครบ ตั้งแต่เลือกหมวดเกม เปิดโต๊ะบาคาร่า รูเล็ต ไฮโล สล็อต บอล และตรวจ Limit ของแต่ละโต๊ะ ก่อนเริ่มเดิมพันจริง`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ไล่ดูโต๊ะคาสิโนไลฟ์และหมวดเกมก่อนเริ่มจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong>{BRAND_NAME}</strong> เป็นเว็บคาสิโนไลฟ์ที่รวมเกมเดิมพันหลายรูปแบบไว้ในระบบเดียว
        <strong>ทั้งบาคาร่า รูเล็ต ไฮโล สล็อต และบอล เลือกโต๊ะสดหรือหมวดเกมที่สนใจได้จากบัญชีเดียว</strong>
        หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับระบบได้ไล่ดูให้ครบหนึ่งรอบ ตั้งแต่การเลือกหมวดเกมและเปิดโต๊ะที่เปิดบริการ ไปจนถึงรายละเอียดที่ระบบแสดงไว้ ก่อนจะเริ่มเดิมพันด้วยเครดิตจริง
      </p>

      <p>
        คำว่า ทดลองเล่น ที่หน้านี้พูดถึงจึงหมายถึง
        <strong>การเปิดดูหมวดเกม สถานะของโต๊ะ ช่วงเดิมพัน และรายละเอียดของแต่ละรายการก่อนเริ่ม</strong>
        ซึ่งเป็นสิ่งที่ระบบเปิดให้ทำได้อยู่แล้ว ไม่ใช่เครดิตทดลอง ไม่ใช่การเดิมพันฟรี และไม่ใช่การรับประกันผลของเกมใดเกมหนึ่ง เมื่อ Login แล้วสมาชิกจะเปิดดูเครดิต โปรโมชั่น และประวัติรายการได้จากบัญชีเดียว
      </p>

      <p>
        <strong>เว็บไซต์เข้าใช้งานได้ตลอดวัน แต่โต๊ะคาสิโนไลฟ์หรือการแข่งขันกีฬาบางรายการอาจมีช่วงเวลาให้บริการแตกต่างกัน</strong>
        การไล่ดูระบบจึงทำได้ตลอด แต่ควรตรวจสอบสถานะของโต๊ะหรือรายการจากระบบก่อนเริ่มเดิมพันเสมอ เพราะจำนวนโต๊ะและรายการสดเปลี่ยนแปลงได้ตามช่วงเวลา
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`ไล่ดูขั้นตอนเลือกหมวดเกมและเปิดโต๊ะของ ${BRAND_NAME}`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        หลัง Login ลำดับการใช้งานจะเป็นชุดเดียวกันทุกครั้ง
        <strong>เลือกหมวดเกม เปิดรายการที่ต้องการ อ่านรายละเอียดของโต๊ะหรือเกมนั้น แล้วจึงกำหนดยอดก่อนยืนยันการเดิมพัน</strong>
        การไล่ดูให้ครบรอบหนึ่งก่อนจึงช่วยให้รู้ว่าข้อมูลแต่ละอย่างอยู่ตรงไหนของหน้าจอ และเลือกรายการที่ช่วงเดิมพันตรงกับงบที่ตั้งไว้ได้เร็วขึ้น
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={popularGamesImage}
          alt="การ์ดหมวดเกมยอดนิยม เป็นภาพตัวละครกระต่ายกับแมวการ์ตูนยืนขนาบข้างหีบสมบัติและกองเหรียญทอง มีชิปคาสิโนลายโพดำกระจายอยู่รอบ และมีข้อความ POPULAR GAME ตัวหนาสีทองอยู่กลางภาพ"
          loading="lazy"
          fetchpriority="low"
          decoding="async"
          widths={[300, 600]}
          sizes="(max-width: 639px) 100vw, 600px"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={62}
          class="mx-auto block h-auto w-full max-w-[600px] rounded-2xl border border-[#d9a521]/30"
        />

        <Picture
          src={newGamesImage}
          alt="การ์ดหมวดเกมเปิดใหม่ เป็นภาพตัวละครฟักทองสวมหมวกกับโครงกระดูกการ์ตูนยืนขนาบข้างบนลานกระเบื้องเรืองแสง มีชิปและดาวสีสดกระจายอยู่ และมีข้อความ New Game ตัวหนาสีขาวอยู่กลางภาพ"
          loading="lazy"
          fetchpriority="low"
          decoding="async"
          widths={[300, 600]}
          sizes="(max-width: 639px) 100vw, 600px"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={62}
          class="mx-auto block h-auto w-full max-w-[600px] rounded-2xl border border-[#d9a521]/30"
        />
      </div>

      <ol class="ml-6 list-decimal space-y-3 marker:font-black marker:text-[#d9a521]">
        <li>
          <strong>เลือกหมวดที่ต้องการก่อน</strong> ระบบจัดหมวดหมู่คาสิโน สล็อต และกีฬาไว้ชัดเจน จึงสลับไปมาได้จากบัญชีเดิมโดยไม่ต้องสมัครใหม่ ควรเริ่มจากหมวดที่คุ้นที่สุดแล้วค่อยไล่ดูหมวดอื่นทีหลัง
        </li>
        <li>
          <strong>เปิดรายการที่เปิดให้บริการอยู่จริง</strong> บาคาร่าและรูเล็ตมีโต๊ะให้เลือกตามรายการที่เปิดในช่วงนั้น ส่วนบอลเลือกคู่แข่งขันและตลาดเดิมพันได้ตามช่วงเวลาที่ระบบเปิดรับ จึงควรยึดรายการล่าสุดที่ระบบแสดง ไม่ใช่รายการที่จำไว้จากรอบก่อน
        </li>
        <li>
          <strong>อ่านรายละเอียดของโต๊ะหรือเกมก่อนเริ่ม</strong> ไฮโลเน้นรูปแบบการเดิมพันที่เข้าใจง่าย ขณะที่สล็อตมีทั้งเกมโบนัส ฟรีสปิน และตัวคูณที่เปิดไว้ไม่เท่ากัน ขั้นนี้คือขั้นที่ช่วยให้เลือกรายการตรงกับงบและความสนใจได้ง่ายขึ้น
        </li>
        <li>
