---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import popularGamesImage from "../assets/gamedemo8.webp";
import newGamesImage from "../assets/gamedemo16.webp";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion,
// /login, /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์
// หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้า
// ขึ้นใหม่บนข้อเท็จจริงของ BOOM369 เท่านั้น (src/assets/content.txt)
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก NavbarCyber (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// BOOM369 เป็น **เว็บสล็อตเบทต่ำ** ไม่ใช่เว็บหวย แง่มุมที่บรีฟระบุไว้มีเท่านี้:
// รวมเกมหลายรูปแบบไว้ในระบบเดียว · เริ่มจากยอดเดิมพันไม่สูง · เกมคลาสสิก ฟรีสปิน
// โบนัส ตัวคูณ สล็อตเปิดใหม่ · เข้าเล่นผ่านมือถือสะดวก · เลือกเกมตามช่วงเดิมพัน ·
// ทุนน้อยแบ่งงบเล่นเป็นรอบ · ตรวจสอบตารางจ่าย ฟีเจอร์โบนัส ฟรีสปิน ก่อนเริ่ม ·
// Login ดูเครดิต โปรโมชั่น ประวัติรายการจากบัญชีเดียว · คืนยอดเสีย 0.3% ·
// แนะนำเพื่อน 0.8% · สมัคร 3 ขั้นตอน · แอดมิน 24 ชั่วโมง · PIN รหัสผ่าน OTP
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามี "โหมดทดลอง" เครดิตทดลอง หรือเดโมฟรีเป็นบริการของเว็บ —
// จึงห้ามสัญญาสินค้าตัวนั้น คำว่า "ทดลองเล่น" บนหน้านี้จึงหมายถึงสิ่งที่บรีฟระบุ
// ไว้ตรง ๆ ว่าทำได้: เลือกเกมจากยอดเดิมพันขั้นต่ำที่ระบบกำหนด และตรวจสอบตารางจ่าย
// ฟีเจอร์โบนัส ฟรีสปิน กับรายละเอียดของแต่ละเกมก่อนเริ่ม = ไล่ดูระบบให้ครบหนึ่งรอบ
//
// ⚠️ รูปในหน้านี้ใช้ได้แค่ gamedemo8 กับ gamedemo16 เท่านั้น — ตรวจไฟล์ทั้ง 12 ใบ
// ด้วยตาแล้ว อีก 10 ใบมีโลโก้/ชื่อของผู้ให้บริการหรือค่ายเกมเจ้าอื่นพิมพ์ทับอยู่กลางรูป
// (gamedemo7 askmeslot · 9 SLOTXO · 10 Skywind Group · 11 PG Pocket Games Soft ·
// 12 SBOBET · 14 JILI · 15 askmebet · 17 JOKER · 18 AFB777 Gaming · 13 เป็นภาพ
// ล่อแหลม) การนำกลับมาเท่ากับเอาชื่อค่ายเกมและแบรนด์ของลูกค้าเจ้าอื่นขึ้นหน้าเว็บ
// BOOM369 ซึ่งขัดกับ brand-spec §4 โดยตรง (ห้ามอ้างชื่อผู้ให้บริการ/ค่ายเกมที่บรีฟ
// ไม่ได้เอ่ย) ไฟล์ยังอยู่บนดิสก์ ห้ามลบ เป็นอินเวนทอรี
// ส่วน gamedemo8 ("POPULAR GAME" 600x379) กับ gamedemo16 ("New Game" 650x411)
// เป็นอาร์ตกลางที่ไม่มีชื่อแบรนด์ใดปรากฏ จึงใช้ประกอบหัวข้อสล็อตยอดนิยม/เกมเปิดใหม่ได้
// ความกว้างที่วาดจริงสูงสุด ~600px ต่อใบ (กริดสองคอลัมน์ในการ์ด) จึงไม่ขยายเกินต้นฉบับ
//
// ⚠️ แบรนด์ก่อน (HI59) ทิ้งคำพวกนี้ไว้และห้ามหลงเหลือ: ไฮคลาส · VIP ·
// ส่งตรงจากเว็บแม่ · ยอดเข้าบริษัทตรง · ไม่ผ่านบัญชีม้า · ค่ายเกมพรีเมียม
// และคำหมวดหวยทั้งชุด (หวย โพย เลขเด็ด แนวทาง งวด อัตราจ่าย) ก็ห้ามเช่นกัน
// ลิงก์ /แนวทาง กับ /ตรวจหวย ไม่มีปลายทางรอบนี้ (อยู่ใน src/pages-disabled/)
//
// ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 100% · 24 ชั่วโมง · 3 ขั้นตอน
// ห้ามเติมเลขใบอนุญาต หน่วยงานกำกับ ชื่อผู้ให้บริการ ชื่อค่ายเกม ชื่อธนาคาร
// ค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีที่ก่อตั้ง เพราะบรีฟไม่ได้เอ่ยไว้
//
// ประโยคกำกับของบรีฟที่ห้ามตัดทิ้ง: เกมค่ายตรง/ถูกลิขสิทธิ์ ควรมีรายชื่อผู้ให้บริการ
// หรือข้อมูลสิทธิ์การให้บริการที่ตรวจสอบได้ประกอบ · "ไม่มีขั้นต่ำ" ควรอ้างอิงจากเกม
// ที่เปิดให้บริการจริง · "เล่นสล็อตไม่จำกัดยอด" ควรอ้างอิงวงเงินของแต่ละเกม
//
// banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// slide1/slide2 ของดรอปนี้เป็นของ index และ /promotion · slide3/slide4/banner2/
// banner3 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import (ลำพังการ import ก็ทำให้ไฟล์ถูก
// emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น AnnouncementCyber ทั้งเว็บ (รอบก่อน HI59 ใช้ Announcement2)
// — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ BOOM369 แล้ว จึงเรียก
// แบบ bare ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ BOOM369 (brand-spec §2) **เขียวนีออนบนพื้นดำ** — กลับขั้วจาก HI59
// ชุดผิวฟ้าอ่อน หมึกกรมท่า ลิงก์ฟ้า และทองของรอบก่อนออกครบทุกจุดแล้ว ทั้งคลาส
// Tailwind raw hex และ rgba() (ค่าเดิมอยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive)
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT) ไว้ที่
// ตัวการ์ดแล้ว ข้อความในหน้านี้จึงไม่ประกาศสีของตัวเองเลย ปล่อยให้สืบทอดลงมา
// — มีแค่ปุ่ม ขอบรูป และ marker ของลำดับเลขที่ประกาศสี เพราะเป็นพื้น/เส้น ไม่ใช่เนื้อความ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 157 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} ด้วยการไล่ดูระบบจริงให้ครบ ตั้งแต่เลือกค่ายเกม ค้นหาสล็อตเบทต่ำ อ่านตารางจ่าย ฟรีสปิน และช่วงเดิมพันของแต่ละเกม ก่อนเริ่มเล่นด้วยเครดิตจริง`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ไล่ดูเกมสล็อตเบทต่ำก่อนเริ่มเล่นจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong>{BRAND_NAME}</strong> เป็นเว็บสล็อตเบทต่ำที่รวบรวมเกมหลายรูปแบบไว้ในระบบเดียว
        <strong>ทั้งเกมคลาสสิก ฟรีสปิน โบนัส ตัวคูณ และสล็อตเปิดใหม่จากค่ายที่ระบบรองรับ</strong>
        หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับระบบได้ไล่ดูให้ครบหนึ่งรอบ ตั้งแต่การเลือกค่ายและค้นหาเกม ไปจนถึงรายละเอียดของเกมที่ระบบแสดงไว้ ก่อนจะเริ่มเล่นด้วยเครดิตจริง
      </p>

      <p>
        คำว่า ทดลองเล่น ที่หน้านี้พูดถึงจึงหมายถึง
        <strong>การเปิดดูตารางจ่าย ฟีเจอร์โบนัส ฟรีสปิน และรายละเอียดของแต่ละเกมก่อนเริ่ม</strong>
        ซึ่งเป็นสิ่งที่ระบบเปิดให้ทำได้อยู่แล้ว ไม่ใช่เครดิตทดลอง ไม่ใช่การหมุนวงล้อฟรี และไม่ใช่การรับประกันผลของเกมใดเกมหนึ่ง เมื่อ Login แล้วสมาชิกจะเปิดดูเครดิต โปรโมชั่น และประวัติรายการได้จากบัญชีเดียว
      </p>

      <p>
        <strong>การระบุว่าเป็นเกมค่ายตรงและถูกลิขสิทธิ์ ควรมีรายชื่อผู้ให้บริการหรือข้อมูลสิทธิ์การให้บริการที่สามารถตรวจสอบได้ประกอบ</strong>
        การไล่ดูระบบจึงทำได้ตลอด แต่ไม่ควรใช้แทนการอ่านรายละเอียดของเกมและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้า เพราะรายชื่อค่ายและจำนวนเกมอาจมีการอัปเดตได้ตลอดเวลา
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`ไล่ดูขั้นตอนเลือกค่ายและค้นหาเกมสล็อตของ ${BRAND_NAME}`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        หลัง Login ลำดับการใช้งานจะเป็นชุดเดียวกันทุกครั้ง
        <strong>เลือกค่าย ค้นหาเกม เปิดอ่านรายละเอียดของเกมนั้น แล้วจึงกำหนดเดิมพันก่อนเริ่มหมุนวงล้อ</strong>
        การไล่ดูให้ครบรอบหนึ่งก่อนจึงช่วยให้รู้ว่าข้อมูลแต่ละอย่างอยู่ตรงไหนของหน้าจอ และเลือกเกมที่ช่วงเดิมพันตรงกับงบที่ตั้งไว้ได้เร็วขึ้น
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={popularGamesImage}
          alt="การ์ดหมวดเกมสล็อตยอดนิยม เป็นภาพตัวละครกระต่ายกับแมวการ์ตูนยืนขนาบข้างหีบสมบัติและกองเหรียญทอง มีข้อความ POPULAR GAME ตัวหนาสีทองอยู่กลางภาพ"
          loading="lazy"
          fetchpriority="low"
          decoding="async"
          widths={[300, 600]}
          sizes="(max-width: 639px) 100vw, 600px"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={62}
          class="mx-auto block h-auto w-full max-w-[600px] rounded-2xl border border-[#42fb5a]/30"
        />

        <Picture
          src={newGamesImage}
          alt="การ์ดหมวดเกมสล็อตเปิดใหม่ เป็นภาพตัวละครฟักทองกับโครงกระดูกการ์ตูนบนลานกระเบื้องเรืองแสง มีข้อความ New Game ตัวหนาสีขาวอยู่กลางภาพ"
          loading="lazy"
          fetchpriority="low"
          decoding="async"
          widths={[300, 600]}
          sizes="(max-width: 639px) 100vw, 600px"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={62}
          class="mx-auto block h-auto w-full max-w-[600px] rounded-2xl border border-[#42fb5a]/30"
        />
      </div>

      <ol class="ml-6 list-decimal space-y-3 marker:font-black marker:text-[#42fb5a]">
        <li>
          <strong>เลือกค่ายเกมที่ต้องการก่อน</strong> เว็บไซต์รวมเกมค่ายตรงไว้ให้เลือกหลายสไตล์ และสลับค่ายได้จากบัญชีเดิมโดยไม่ต้องสมัครใหม่หลายครั้ง จึงควรเริ่มจากค่ายที่คุ้นที่สุดแล้วค่อยไล่ดูค่ายอื่นทีหลัง
        </li>
        <li>
          <strong>ค้นหาเกมจากในระบบ</strong> ทั้งสล็อตยอดนิยมและเกมเปิดใหม่อยู่ในหน้าเกมสล็อตของเว็บไซต์ รายชื่อค่ายและจำนวนเกมอาจมีการอัปเดต จึงควรยึดรายการล่าสุดที่ระบบแสดง ไม่ใช่รายการที่จำไว้จากรอบก่อน
        </li>
        <li>
          <strong>เปิดอ่านตารางจ่ายและรายละเอียดของเกมก่อนเริ่ม</strong> แต่ละเกมมีทั้งรูปแบบวงล้อ ฟีเจอร์โบนัส ฟรีสปิน และช่วงเดิมพันแตกต่างกัน ขั้นนี้คือขั้นที่ช่วยให้เลือกเกมที่ตรงกับงบและความสนใจได้ง่ายขึ้น
        </li>
        <li>
          <strong>ตรวจสอบเครดิตในบัญชีก่อนกำหนดเดิมพัน</strong> ยอดที่ตั้งได้ขึ้นอยู่กับช่วงเดิมพันของเกมนั้นและเครดิตที่มีอยู่ จึงเป็นจุดสุดท้ายที่ควรอ่านซ้ำก่อนเริ่มหมุนวงล้อด้วยเครดิตจริง
        </li>
      </ol>

      <p>
        <strong>เกมที่อยู่คนละค่ายไม่จำเป็นต้องเปิดฟีเจอร์หรือช่วงเดิมพันชุดเดียวกัน</strong>
        ค่าที่จำไว้จากเกมก่อนหน้าจึงอาจไม่ตรงกับเกมที่กำลังจะเปิด ควรอ่านรายละเอียดของเกมนั้นใหม่ทุกครั้งแทนการอ้างจากความเคยชิน
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/about-us"
          aria-label={`อ่านหน้าเกี่ยวกับเราของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#42fb5a]/60 bg-gradient-to-b from-[#0b231b] to-[#041109] px-8 py-3 font-bold text-[#cfe9d7] shadow-[0_0_12px_rgba(66,251,90,0.25)] transition-all hover:scale-105 hover:border-[#42fb5a] hover:shadow-[0_0_18px_rgba(66,251,90,0.40)]">
          อ่านเกี่ยวกับเรา
        </a>

        <a
          href="/promotion"
          aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#42fb5a]/60 bg-gradient-to-b from-[#0b231b] to-[#041109] px-8 py-3 font-bold text-[#cfe9d7] shadow-[0_0_12px_rgba(66,251,90,0.25)] transition-all hover:scale-105 hover:border-[#42fb5a] hover:shadow-[0_0_18px_rgba(66,251,90,0.40)]">
          ดูภาพโปรโมชั่น
        </a>
      </div>
    </div>
  </ContentBox>

