---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import popularGamesImage from "../assets/gamedemo8.webp";
import newGamesImage from "../assets/gamedemo16.webp";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริง
// ของบรีฟรอบนี้เท่านั้น (src/assets/content.txt) ไม่ใช่แก้ทับประโยคของแบรนด์ก่อน
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0 (ผังเดิมของหน้า คงไว้)
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// ⚠️ ดรอปนี้ (2026-10-13, TKB55) คือ **คาสิโน + กีฬา — บาคาร่า ไฮโล บอล และ
// สล็อต** เท่านั้น **ไม่ใช่เว็บสล็อตล้วน ไม่ใช่เว็บกีฬาล้วน** และหมวดเกมอื่นที่
// บรีฟรอบก่อนเคยมี **บรีฟรอบนี้ไม่ได้เอ่ยไว้เลย จึงห้ามเขียนถึง** (ไม่พิมพ์ชื่อหมวด
// เหล่านั้นซ้ำที่นี่ เพื่อไม่ให้ grep หาคำต้องห้ามเจอ false positive) — คำของแบรนด์
// ก่อน (TSDET911) หลายคำอยู่ในลิสต์ห้ามของ brand-spec §7 จึงต้องเขียนประโยคขึ้นใหม่
// ไม่ใช่ find-and-replace ทับของเดิม และไม่ใช่เว็บหมวดลอตเตอรี — สองหน้าของหมวดนั้น
// จอดอยู่ใน src/pages-disabled/ ไม่มี route ห้ามลิงก์ไปหา เป็น href ตายที่ทำให้
// build แดง
//
// ⚠️ รอบก่อนบรีฟอ้างว่า "เว็บลิขสิทธิ์ไทยแท้ + เซิร์ฟเวอร์ในประเทศไทย 100%"
// **รอบนี้กลับด้าน**: บรีฟระบุว่าใช้ **เซิร์ฟเวอร์ต่างประเทศ** และไม่ได้เอ่ย
// เรื่องลิขสิทธิ์หรือใบอนุญาตไว้เลย จึงห้ามพูดถึงใบอนุญาต หน่วยงานกำกับ หรือ
// เซิร์ฟเวอร์ในประเทศ และห้ามอ้างเลข 100% ที่ไม่มีในบรีฟรอบนี้ · คำว่า
// "ไม่มีขั้นต่ำ" ก็ไม่มีในบรีฟรอบนี้ — ที่บรีฟให้คือ "ยอดเดิมพันขั้นต่ำ" ซึ่งเป็น
// สิ่งที่สมาชิก "ควรตรวจสอบ" ไม่ใช่สิ่งที่เว็บประกาศว่าไม่มี · คำว่า "แทงบอล"
// ของรอบก่อนไม่อยู่ในคลังคำรอบนี้ ให้ใช้ **บอล / บอลออนไลน์ / ฟุตบอล** ตามบรีฟ
//
// แง่มุมที่บรีฟรอบนี้รองรับให้หน้าทดลองเล่นพูดถึงมีเท่านี้: ระบบเดิมพันออนไลน์ผ่าน
// แพลตฟอร์มเดียว · รวมเกมคาสิโนและกีฬาหลายประเภท · รองรับการใช้งานผ่านมือถือและ
// คอมพิวเตอร์ · ค้นหาเกม ตรวจสอบเครดิต และติดตามรายการต่างๆ ผ่านบัญชีเดียว ·
// เซิร์ฟเวอร์ต่างประเทศ · บาคาร่าเป็นเกมไพ่ที่มีตัวเลือกการเดิมพันตามกติกา ·
// ไฮโลใช้ผลจากลูกเต๋าในการตัดสิน · บอลออนไลน์มีรายการแข่งขันและอัตราต่อรอง ·
// สล็อตมีเกมวงล้อทั่วไป ฟรีสปิน และฟีเจอร์โบนัสจากค่ายที่เปิดให้บริการ ·
// กติกา ตารางจ่าย ยอดเดิมพันขั้นต่ำ วิธีตัดสินผล · อัตราต่อรองเปลี่ยนตามช่วงเวลา ·
// คืนยอดเสีย 0.3% เข้ายูสทุกวัน รอบประจำวัน เวลาตัดยอด ยอดที่เข้าเกณฑ์ ·
// แนะนำเพื่อน โบนัส 0.8% ลิงก์แนะนำ ไม่จำกัด · หลักฐานธุรกรรม ·
// แอดมิน 24 ชั่วโมง ช่องทางหลัก ชื่อเกม ค่าย คู่แข่งขัน หมายเลขรายการ PIN OTP
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามี "โหมดทดลอง" เครดิตทดลอง หรือเดโมฟรีเป็นบริการของเว็บ —
// จึงห้ามสัญญาสินค้าตัวนั้น คำว่า "ทดลองเล่น" บนหน้านี้จึงหมายถึงสิ่งที่บรีฟระบุไว้
// ตรงๆ ว่าทำได้: เข้าสู่ระบบแล้วไล่ดูหมวดเกมให้ครบหนึ่งรอบ เลือกเกมที่สนใจ อ่านกติกา
// ตารางจ่าย และวิธีตัดสินผลของเกมนั้นให้จบ แล้วจึงเริ่มเดิมพันด้วยเงินจริง
//
// ⚠️ รูปในหน้านี้ใช้ได้แค่ gamedemo8 กับ gamedemo16 เท่านั้น — เป็นอาร์ตสต็อกกลาง
// ของเทมเพลต (mtime 2026-08-04) ไม่ใช่อาร์ตเวิร์กของแบรนด์นี้ จึงอยู่ต่อได้ แต่ alt
// ต้องบรรยายภาพจริง และห้ามเอ่ยชื่อแบรนด์ใด เพราะไม่มีชื่อแบรนด์ไหนปรากฏอยู่บนรูป
// ทั้งสองใบ (สีที่ alt บรรยายคือสีที่วาดอยู่บนอาร์ตสต็อกจริง ไม่ใช่สีของพาเลตต์
// รอบนี้ — ห้าม "แก้สี" ใน alt ให้เข้าแบรนด์ เพราะนั่นทำให้ alt บรรยายผิด)
// ส่วน gamedemo7/9/10/11/12/14/15/17/18 มีโลโก้หรือชื่อของผู้ให้บริการ
// เจ้าอื่นพิมพ์ทับอยู่กลางรูป และ gamedemo13 เป็นภาพล่อแหลม — ห้ามนำกลับมาใช้
// เพราะเท่ากับอ้างชื่อที่บรีฟไม่ได้เอ่ย ไฟล์ยังอยู่บนดิสก์ ห้ามลบ เป็นอินเวนทอรี
// gamedemo8 ("POPULAR GAME" 600x379) กับ gamedemo16 ("New Game" 650x411)
// ความกว้างที่วาดจริงสูงสุด ~600px ต่อใบ (กริดสองคอลัมน์ในการ์ด) จึงไม่ขยายเกิน
// ต้นฉบับ quality={62} ของสองใบนี้ตั้งไว้ต่ำกว่าค่าปกติ 80 มาตั้งแต่รอบก่อน เพราะ
// อาร์ตมีเกรนละเอียดจนไฟล์ AVIF เคยโตกว่า WebP ของตัวเอง (verify-build จะแดง)
// ห้ามดันกลับขึ้น — เป็นค่าต่อรูป ไม่ใช่การจูนต่อฟอร์แมต
//
// ⚠️ คำที่ห้ามหลงเหลือ: คำขายของของแบรนด์ก่อนๆ ศัพท์เว็บสล็อตล้วนของรอบก่อน
// และศัพท์หมวดลอตเตอรีทุกคำ — รายการเต็มอยู่ใน brand-spec §7 ไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาคำต้องห้ามเจอ false positive
//
// ⚠️ ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 24 ชั่วโมง
// **รอบนี้ไม่มีปี ไม่มีเลข 100% และไม่มีจำนวนข้อ/จำนวนขั้นตอนบนหน้านี้**
// และห้ามเติมเลขใบอนุญาต หน่วยงานกำกับ ชื่อผู้ดำเนินงาน ชื่อค่ายเกม ชื่อธนาคาร
// ค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีที่ก่อตั้ง เพราะบรีฟไม่ได้เอ่ยไว้สักอย่าง
//
// ประโยคกำกับของบรีฟที่ห้ามตัดทิ้ง (เป็นส่วนหนึ่งของคอปปี้ ไม่ใช่ filler):
// ส่วนความปลอดภัยและตำแหน่งเซิร์ฟเวอร์จริงควรมีข้อมูลทางเทคนิคและรายละเอียด
// ผู้ให้บริการที่สามารถตรวจสอบได้ประกอบ · ไม่มีเกมใดรับประกันว่าจะได้รับกำไรทุกครั้ง ·
// ควรตรวจสอบว่าโปรโมชั่นครอบคลุมบาคาร่า ไฮโล บอล หรือสล็อตประเภทใดบ้าง ·
// ควรอ่านรายละเอียดประเภทเกมที่ร่วมรายการ เวลาตัดยอด และเงื่อนไขการใช้โบนัสก่อนรับ ·
// คำว่าไม่จำกัดควรระบุให้ชัด · ไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น
//
// banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion · banner2/banner3 และ
// slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import (ลำพังการ import ก็ทำให้
// ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น Announcement5 ทั้งเว็บ (รอบก่อนใช้ Announcement3 —
// brand-spec §3 หมุนเข้า) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้
// ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่ง
// จะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **แดงเลือดนกนำ เงินโครเมียมรอง บนดำสนิท**
// พลิกออกจากชุดน้ำเงินไฟฟ้านำ-เงินโครเมียมรองของรอบก่อน ซึ่งออกครบทุกจุดแล้ว ทั้ง
// คลาส Tailwind raw hex และ rgba() (ค่าเดิมอยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive) รอบนี้ไม่มีทอง ไม่มีม่วง
// ไม่มีชมพู ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว และไม่มีส้มเลย มีแค่แดงกับเงินโครเมียม
// ลำดับปุ่มสื่อด้วยขั้ว "แดงถม vs ผิวจมขอบแดง": ปุ่มหลักถมแดงไล่เฉด #ff8a8f →
// #fb131b ขอบ #c40304 หมึก #1a0304 (8.7:1 บนปลายสว่าง / 4.9:1 บนปลายเข้ม) ·
// ปุ่มรองและปุ่มลิงก์ภายในเป็นผิวจม #1a0708 → #0d0304 ขอบ #fb131b/55 ตัวอักษร
// #f2e4e5 · ขอบรูปใช้แดงแบรนด์แบบโปร่ง · marker ของลำดับเลขใช้แดงสว่าง #ff4d55
// (5.6:1 บนผิวการ์ด — เป็นตัวอักษร จึงใช้แดงแบรนด์ไม่ได้ และ #ff8a8f สงวนไว้ให้
// <strong> เท่านั้น)
// ⚠️ ห้ามกลับด้าน: พื้นถมแดงต้องใช้หมึกเข้มเสมอ ห้ามขาวหรือแดงอ่อน และ #fb131b
// #c40304 #8a0206 #53050a เป็นเส้น ขอบ ออรา และพื้นถมเท่านั้น ห้ามถือตัวอักษร
// ทุกขนาด ออราในไฟล์นี้ใช้ rgba(251,19,27,α) และ rgba(255,138,143,α) เท่านั้น
// ⚠️ "มีแดงอยู่" ไม่ใช่ตัวบอกว่าถูกแบรนด์ — โค้ดเบสนี้เคยมีแบรนด์แดงมาก่อนหลายเจ้า
// ให้เทียบเป็นค่าทีละตัวกับตารางใน brand-spec §2 ไม่ใช่เทียบด้วยตาหรือด้วยตระกูลสี
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #f2e4e5)
// ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง ปล่อยให้สืบทอดลงมา
// — มีแค่ปุ่ม ขอบรูป marker ของลำดับเลข และ <strong> ที่ประกาศสี โดย <strong>
// ใช้แดงอ่อน #ff8a8f ตัวเดียว (7.8:1 บนผิวการ์ด) และแต่ละ <strong> ครอบ
// "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิด
// แท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 159 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} ไล่ดูหมวดเกมบาคาร่า ไฮโล บอล และสล็อตให้ครบหนึ่งรอบ พร้อมอ่านกติกา ตารางจ่าย ยอดเดิมพันขั้นต่ำ และอัตราต่อรองของแต่ละรายการก่อนเริ่มเดิมพันจริง`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ไล่ดูหมวดเกมคาสิโนและกีฬาก่อนเริ่มเดิมพันจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#ff8a8f]">{BRAND_NAME}</strong> เป็นเว็บพนันคาสิโนไทยที่นำเสนอระบบเดิมพันออนไลน์ผ่านแพลตฟอร์มเดียว
        <strong class="text-[#ff8a8f]">พร้อมรวมเกมคาสิโนและกีฬาไว้หลายประเภท ทั้งบาคาร่า ไฮโล บอล และสล็อต รองรับการใช้งานผ่านมือถือและคอมพิวเตอร์</strong>
        หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับระบบได้ไล่ดูให้ครบหนึ่งรอบ ตั้งแต่การค้นหาเกมและเปิดรายละเอียดของรายการที่สนใจ ไปจนถึงเมนูตรวจสอบเครดิตและการติดตามรายการต่างๆ ก่อนจะเริ่มเดิมพันจริง
      </p>

      <p>
        คำว่า ทดลองเล่น ที่หน้านี้พูดถึงจึงหมายถึง
        <strong class="text-[#ff8a8f]">การไล่ดูหมวดเกมที่จัดไว้ เลือกรายการที่สนใจ แล้วอ่านกติกา ตารางจ่าย และวิธีตัดสินผลของเกมนั้นให้จบก่อนเริ่มเดิมพันด้วยเงินจริง</strong>
        ซึ่งเป็นสิ่งที่ระบบเปิดให้ทำได้อยู่แล้ว ไม่ใช่การแจกเครดิตทดลอง และไม่ใช่การรับประกันผลของรายการใดรายการหนึ่ง เพราะเกมคาสิโนมีผลลัพธ์ตามกติกาของแต่ละประเภท และไม่มีเกมใดรับประกันว่าจะได้รับกำไรทุกครั้ง
      </p>

      <p>
        อีกเรื่องที่ควรไล่ดูไปพร้อมกันคือขอบเขตของข้อมูลที่เว็บไซต์แจ้งไว้ โดยเว็บไซต์ระบุว่าใช้เซิร์ฟเวอร์ต่างประเทศเพื่อรองรับการเข้าใช้งาน
        <strong class="text-[#ff8a8f]">ส่วนความปลอดภัยและตำแหน่งเซิร์ฟเวอร์จริงควรมีข้อมูลทางเทคนิคและรายละเอียดผู้ให้บริการที่สามารถตรวจสอบได้ประกอบ</strong>
        ไม่ใช่ยึดจากชื่อแบรนด์หรือข้อความโฆษณาเพียงอย่างเดียว ส่วนการรวมหมวดเกมไว้ในที่เดียวก็ช่วยให้ค้นหาได้สะดวกขึ้นเท่านั้น ไม่ได้เปลี่ยนกติกาของเกมหรือผลของรายการแต่อย่างใด
      </p>
    </div>
  </ContentBox>

