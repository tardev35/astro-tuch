---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion,
// /login, /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์
// หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้า
// ขึ้นใหม่บนข้อเท็จจริงของ หวยดีใจ เท่านั้น (src/assets/content.txt)
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก NavbarStyle8 (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// หวยดีใจ เป็น **เว็บรับแทงหวยออนไลน์** ไม่ใช่คาสิโน/สล็อต แง่มุมที่บรีฟระบุไว้มี
// เท่านี้: รวมรายการยอดนิยมและแนวทางตัวเลขไว้ให้ติดตามก่อนหวยออก ทั้งรัฐบาลไทย
// หวยลาว หวยฮานอย หวยออมสิน และหวย ธ.ก.ส. · เลือกเลข ตรวจสอบรอบ อัตราจ่าย และ
// ส่งโพยผ่านมือถือจากบัญชีเดียว · ตรวจเวลาเปิดรับ เวลาปิดรับ เลข และยอดเดิมพัน
// ก่อนส่งโพย · อัตราของรายการที่เข้าเงื่อนไข 2 ตัว จ่าย 100 บาท / 3 ตัว จ่าย 1,000
// บาท ซึ่งแต่ละประเภทและรูปแบบการเดิมพันอาจมีเรทต่างกัน · เลข 3 ตัวมีหลายรูปแบบ ·
// วงเงินที่ระบบเปิดรับ · แนวทางและสถิติย้อนหลัง · สมัคร 3 ขั้นตอน · ผลรางวัล ·
// ประวัติรายการ · แอดมิน 24 ชั่วโมง · PIN · OTP
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามี "โหมดทดลอง" เครดิตทดลอง หรือหวยเดโมเป็นบริการของเว็บ —
// จึงห้ามสัญญาสินค้าตัวนั้น และห้ามดึง src/assets/gamedemo*.webp กลับมา (ไฟล์ชุดนั้น
// เป็นอินเวนทอรีเก่าของแบรนด์คาสิโน ไม่ใช่อาร์ตเวิร์กของดรอปนี้) หน้านี้จึงไม่มีรูป
// และไม่มีกริดเกมเดโมโดยตั้งใจ — ตัวหน้าเป็นบทความล้วน
// สิ่งที่บรีฟระบุไว้ตรง ๆ ว่าควรทำก่อนยืนยันคือ "ตรวจสอบเวลาเปิดรับ เวลาปิดรับ
// เลขที่ต้องการ และยอดเดิมพันก่อนส่งโพย" และ "ตรวจสอบเรทของหวยแต่ละรายการก่อน
// ส่งโพย" = ไล่เปิดขั้นตอนเลือกเลขและหน้าส่งโพยให้ครบหนึ่งรอบ บวกกับอ่านแนวทาง/
// สถิติประกอบ ก่อนเดิมพันด้วยเงินจริง ไม่ใช่การเล่นฟรี
//
// ⚠️ แบรนด์ก่อนหน้าของหน้านี้คือ หวย24 (เว็บหวยอีกเจ้าที่ไม่เกี่ยวกัน) เขียนบนบรีฟ
// คนละฉบับ ข้อขายของมันไม่มีในบรีฟรอบนี้ จึงห้ามหลงเหลือ: "เลขดัง" · "รับไม่อั้น" ·
// "จ่ายเต็มทุกโพย" · "วงเงินรับแทง" · การถกว่า "เรทจ่ายสูงที่สุด" เหมาะหรือไม่
// ก่อนหน้านั้นหน้านี้เคยเป็นคาสิโน คำชุดนั้นยิ่งห้ามโผล่: สล็อต บาคาร่า บอล
// ค่ายเกม คาสิโนสด RTP ความผันผวน คืนยอดเสีย เว็บตรง ทดลองเล่นสล็อต —
// เขียนใหม่จากบรีฟ ไม่ใช่ find-and-replace ทับประโยคเดิม
//
// ตัวเลขที่อ้างได้มีแค่ 2 ตัว / 3 ตัว / 100 / 1,000 / 3 ขั้นตอน / 24 ชั่วโมง
// รายการหวยที่เอ่ยได้มีห้าชื่อ: รัฐบาลไทย · หวยลาว · หวยฮานอย · หวยออมสิน ·
// หวย ธ.ก.ส. ห้ามเติมตลาดอื่น (หวยหุ้น ยี่กี ลาวพัฒนา) ห้ามแต่งเวลาเปิด-ปิดรับ
// เป็นตัวเลข ชื่อธนาคาร เลขใบอนุญาต หน่วยงานกำกับ ยอดฝากขั้นต่ำ จำนวนสมาชิก
// หรือปีที่ก่อตั้ง เพราะบรีฟไม่ได้เอ่ยไว้
//
// ประโยคกำกับของบรีฟที่ห้ามตัดทิ้ง: แนวทาง เลขเด็ด และสถิติย้อนหลังเป็นข้อมูล
// ประกอบ ไม่การันตีเลขเข้าทุกงวดและไม่รับประกันผลล่วงหน้า · "ไม่อั้นจ่าย" ไม่ได้
// แปลว่าทุกเลขหรือทุกรอบไม่มีวงเงินสูงสุด ให้ยึดหน้าส่งโพย · "ไม่มีลบโพย" หมายถึง
// โพยที่ระบบรับและยืนยันสมบูรณ์ตามเงื่อนไขที่ประกาศไว้ · อัตรา 2ตัว100 /
// 3ตัว1,000 ใช้กับรายการที่เข้าเงื่อนไข ไม่ใช่ทุกหวย · ผลหวยแต่ละรอบควรอ้างอิง
// ประกาศอย่างเป็นทางการ
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: banner1/banner1-mobile/og.png เป็นของ glob ที่
// MainLayout ปักไว้ ห้ามอ้างจากหน้า · slide1/slide2 ของดรอปนี้เป็นของ index และ
// /promotion · slide3/slide4/banner2/banner3 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น Announcement5 ทั้งเว็บ (รอบก่อน หวย24 ใช้ Announcement3)
// — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ หวยดีใจ แล้ว จึงเรียก
// แบบ bare ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ หวยดีใจ (brand-spec §2) **แดงแบรนด์ + เงินโครเมียม บนดำอมแดง ทองเป็น
// สีรอง** — โลโก้คือคำว่า "หวย" สีโครเมียม + "ดีใจ" สีแดง + มงกุฎทอง: แดงแบรนด์
// #dc0409 (ไล่เฉดปุ่มหลัก) · แดงสว่าง #f5363d (hover, marker) · แดงเข้ม #8e0206
// (ขอบและปลายไล่เฉดปุ่มหลัก) · เงินสว่าง #eef0f4 (หมึกบนปุ่ม) · เงินกลาง #c3c7d1
// (ขอบปุ่มรอง ไอคอน) · ทอง #f3c54e (หมึก strong ทั้งหน้า + hover ปุ่มรอง) ·
// พื้นลึกสุด #0d0407 (ปุ่มรอง) · พื้นยก #211016 (hover ปุ่มรอง)
// ชุดแดง+ทองของ หวย24 (#d20a0a #f5c33b #ffd45e #a9761a #f7e2d6 #0a0303 #1a0303
// #2a0606 #7a0505 #ff5c5c rgba(210,10,10,*) rgba(245,195,59,*)) ออกครบทุกจุดแล้ว
// ทั้งคลาส Tailwind raw hex และ rgba()
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// — การ์ดตั้ง text-left text-base leading-relaxed text-[#edeaf0] ไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าจึงไม่ถือคลาสสีของตัวเอง ใส่สีเฉพาะที่ <strong>
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 158 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} ด้วยการไล่ดูขั้นตอนเลือกประเภทหวยและรอบ กรอกเลข 2 ตัว 3 ตัว แล้วอ่านอัตราจ่ายกับวงเงินที่ระบบเปิดรับบนหน้าส่งโพยให้ครบก่อนยืนยันด้วยเงินจริง`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ไล่ดูขั้นตอนเลือกเลข รอบ และอัตราจ่ายก่อนส่งโพย`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#f3c54e]">{BRAND_NAME}</strong> เป็นเว็บรับแทงหวยออนไลน์ที่รวมรายการยอดนิยมและแนวทางตัวเลขไว้ให้ติดตามก่อนหวยออก
        <strong class="text-[#f3c54e]">ทั้งรัฐบาลไทยตามกำหนดออกรางวัล หวยลาว หวยฮานอย หวยออมสิน และหวย ธ.ก.ส. ตามรายการที่เปิดให้บริการ</strong>
        หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับระบบได้ไล่ดูขั้นตอนให้ครบหนึ่งรอบ ตั้งแต่การเลือกประเภทหวยและรอบ ไปจนถึงหน้าส่งโพยที่แสดงอัตราจ่ายและวงเงินที่ระบบเปิดรับ ก่อนจะยืนยันรายการด้วยเงินจริง
      </p>

      <p>
        คำว่า ทดลองเล่น ที่หน้านี้พูดถึงจึงหมายถึง
        <strong class="text-[#f3c54e]">การเลือกเลขที่สนใจหรือเลขเด็ดจากแนวทาง แล้วตรวจสอบเวลาเปิดรับ เวลาปิดรับ เลข และยอดเดิมพันให้ครบก่อนส่งโพย</strong>
        ซึ่งเป็นสิ่งที่ระบบเปิดให้ทำได้อยู่แล้ว ไม่ใช่การส่งโพยฟรี ไม่ใช่เครดิตทดลอง และไม่ใช่การรับประกันผลของรอบใดรอบหนึ่ง เมื่อ Login แล้วสมาชิกจะเปิดดูรอบ อัตราจ่าย ผลหวย และประวัติรายการได้จากบัญชีเดียว
      </p>

      <p>
        <strong class="text-[#f3c54e]">แนวทาง เลขเด็ด และสถิติย้อนหลังใช้เป็นข้อมูลประกอบได้เท่านั้น ไม่สามารถการันตีเลขเข้าทุกงวดหรือรับประกันผลล่วงหน้าได้</strong>
        การไล่ดูระบบจึงทำได้ตลอด แต่การส่งโพยต้องอยู่ในรอบที่ระบบเปิดรับอยู่จริง และผลหวยในแต่ละรอบควรอ้างอิงประกาศอย่างเป็นทางการเสมอ
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`ไล่ดูขั้นตอนเลือกประเภทหวยและรอบของ ${BRAND_NAME}`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        หลัง Login ลำดับการใช้งานจะเป็นชุดเดียวกันทุกครั้ง
        <strong class="text-[#f3c54e]">เลือกประเภทหวยและรอบ กรอกเลข กำหนดยอด แล้วอ่านหน้าส่งโพยก่อนยืนยัน</strong>
        การไล่ดูให้ครบรอบหนึ่งก่อนจึงช่วยให้รู้ว่าข้อมูลแต่ละอย่างอยู่ตรงไหนของหน้าจอ และควรเริ่มจากรายการที่อ่านรายละเอียดจบได้เร็วที่สุด
      </p>

      <ul class="flex flex-col gap-3" aria-label={`ลำดับการไล่ดูขั้นตอนส่งโพยของ ${BRAND_NAME}`}>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#c3c7d1]">🗂️</span>
          <span>
            <strong class="text-[#f3c54e]">เลือกประเภทหวยและรอบ</strong> รัฐบาลไทยไปตามกำหนดออกรางวัล ส่วนหวยลาว หวยฮานอย หวยออมสิน และหวย ธ.ก.ส. เปิดรับตามรายการที่ให้บริการ จึงควรดูว่ารายการที่กำลังเปิดอยู่เป็นรอบใด
            เพราะแต่ละรายการอาจมีรายละเอียดของรอบไม่เหมือนกัน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#c3c7d1]">🔢</span>
          <span>
            <strong class="text-[#f3c54e]">กรอกเลขที่ต้องการ</strong> ไม่ว่าจะเป็นเลขที่เลือกเองหรือเลขเด็ดที่ได้จากแนวทาง สำหรับเลข 2 ตัวควรตรวจให้ครบทั้งสองหลัก และสำหรับเลข 3 ตัวควรดูว่ากำลังเลือกรูปแบบใด
            เพราะการเดิมพันเลข 3 ตัวมีได้หลายประเภท
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#c3c7d1]">💰</span>
          <span>
            <strong class="text-[#f3c54e]">กำหนดยอดตามวงเงินที่ระบบเปิดรับ</strong> ยอดที่กรอกได้ขึ้นอยู่กับวงเงินของเลขนั้นในรอบนั้น หากเป็นเลขเด็ดหรือเลขที่มีผู้เลือกจำนวนมาก ระบบอาจแสดงยอดสูงสุดที่รับได้ต่างจากเลขอื่นในรอบเดียวกัน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#c3c7d1]">📨</span>
          <span>
            <strong class="text-[#f3c54e]">เปิดหน้าส่งโพยแล้วอ่านก่อนยืนยัน</strong> หน้านี้คือที่ที่ระบบแสดงเลข ยอดเดิมพัน อัตราจ่าย และสถานะรายการพร้อมกัน จึงเป็นจุดสุดท้ายที่แก้ไขได้ก่อนรายการถูกบันทึกลงประวัติรายการ
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#f3c54e]">คำว่าไม่อั้นจ่ายไม่ได้หมายความว่าทุกเลขหรือทุกรอบจะไม่มีวงเงินสูงสุด</strong>
        ดังนั้นค่าที่จำไว้จากรอบก่อนหน้าอาจไม่ใช่ชุดเดียวกับรอบที่กำลังจะส่งโพย ควรกรอกเลขและตรวจวงเงินที่ระบบเปิดรับใหม่ทุกครั้งแทนการอ้างจากความเคยชิน
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/แนวทาง"
          aria-label={`อ่านแนวทางหวยของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#c3c7d1]/45 bg-[#0d0407] px-8 py-3 font-bold text-[#eef0f4] transition-all hover:scale-105 hover:border-[#f5363d] hover:bg-[#211016] hover:text-[#f3c54e]">
          อ่านแนวทางหวย
        </a>

        <a
          href="/about-us"
          aria-label={`อ่านหน้าเกี่ยวกับเราของ ${BRAND_NAME}`}
