---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { pageGraph } from "../lib/schema";

// ABM96 เป็นเว็บเดิมพันออนไลน์ที่รวมหลายประเภทเกม ไม่ใช่เว็บสล็อตอย่างเดียว —
// บรีฟรอบนี้ (ดรอป 2026-09-22 "ABM96 เว็บเดิมพันออนไลน์เจ้าของเดิม อัปเดตระบบใหม่
// ความปลอดภัยสูงขึ้น") ระบุเกมไว้ 5 ประเภทคือ บาคาร่า สล็อต หวย ไฮโล และบอล
// คอปปี้ของแบรนด์รอบก่อน ("เว็บรวมสล็อตใหญ่ เกมแท้ค่ายดัง ส่งตรงจาก
// บริษัทแม่" + "ระบบ API 100%") ถูกเขียนใหม่ทั้งหน้าแล้ว ไม่เหลือประโยคเดิม
// และไม่เหลือกรอบคิดแบบสล็อตอย่างเดียว
//
// บรีฟรอบนี้ไม่ได้ระบุว่ามี "เครดิตทดลอง" หรือโหมดเดโมที่ถอนไม่ได้ สิ่งที่บรีฟระบุคือ
// "เลือกหมวดที่สนใจได้จากหน้าเมนูหลัก พร้อมสลับระหว่างเกมแต่ละประเภทได้สะดวก",
// "ระบบจัดหมวดหมู่ชัดเจน ช่วยให้ค้นหาเกมหรือรายการที่ต้องการได้ง่าย" และ
// "ตรวจสอบรายการที่เปิดให้บริการได้จากหน้ารวมเกม" — หน้านี้จึงเขียนบนฐานนั้น
// คือการไล่ดูระบบและรายละเอียดก่อนเดิมพันด้วยเงินจริง
// ห้ามกลับไปอ้างกติกาของเครดิตทดลองหรือโหมดเล่นฟรี
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: แกลเลอรีเดโม 12 การ์ด (gamedemo7..18.webp) ยังอยู่
// บนดิสก์แต่เป็นของแบรนด์อื่น (mtime 2026-08-04 ไม่ใช่ดรอปรอบนี้) — gamedemo7.webp
// มีโลโก้ "askmeslot" และ gamedemo15.webp มีโลโก้ "askmebet" ของเว็บเจ้าอื่น
// พิมพ์ทับอยู่ในรูป ส่วน gamedemo13.webp เป็นการ์ด "Sexy Slot" ภาพโป๊เปลือย
// ห้ามนำกลับมา import เด็ดขาด (ห้ามลบไฟล์ เป็นอินเวนทอรี) ลำพังการ import ก็ทำให้
// ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง
// slide1.png / slide2.png ของดรอปนี้เป็นของ index และ /promotion — ไม่ดึงมาใช้ซ้ำที่นี่
//
// ข้อเท็จจริงทุกบรรทัดมาจากบรีฟรอบนี้เท่านั้น: เว็บเดิมพันออนไลน์เจ้าของเดิมที่
// อัปเดตทางเข้าและปรับระบบใหม่ · หน้าเกม เมนูสมาชิก และการเข้าถึงผ่านมือถือ
// ใช้งานสะดวกขึ้น · รวมบาคาร่า สล็อต หวย ไฮโล บอล ไว้ในบัญชีเดียว · เลือกหมวด
// จากหน้าเมนูหลักและสลับระหว่างเกมได้สะดวก · ระบบจัดหมวดหมู่ชัดเจน ไม่ต้อง
// เปลี่ยนหลายเว็บไซต์ · มีเกมจากหลายค่ายให้เลือกตามหมวดหมู่ ตรวจสอบรายการที่
// เปิดให้บริการได้จากหน้ารวมเกม · โบนัสแนะนำเพื่อน 0.8% · โบนัสคืนยอดเสีย 0.3% ·
// ตรวจสอบรอบรับสิทธิ์ ยอดที่เข้าเกณฑ์ และข้อกำหนดก่อนกดรับจากหน้าโปรโมชั่น ·
// สมัครเองได้ผ่านหน้าเว็บไซต์ใน 3 ขั้นตอน
// — ห้ามอ้างชื่อค่ายเกม เลขใบอนุญาต ปีที่ก่อตั้ง จำนวนสมาชิก ค่า RTP อัตราจ่าย
// ขั้นต่ำการเดิมพัน "ฝากถอนออโต้ไม่มีขั้นต่ำ" "ตลอด 24 ชั่วโมง" "ปลอดภัย 100%"
// หรือการันตีว่าจะชนะ (หัวข้อ "แอดมินออนไลน์ 24 ชั่วโมง" ของรอบก่อนถูกถอดทิ้ง
// ด้วยเหตุผลนี้ และข้อความเรื่อง "เดิมพันเริ่มต้น/ขั้นต่ำของแต่ละค่าย" ก็เช่นกัน)
//
// Announcement รอบนี้หมุนมาใช้ Announcement3 ทั้งเว็บ — default message ของ
// ไฟล์นั้นเป็นข้อความของ ABM96 อยู่แล้ว จึงเรียกแบบ bare เหมือน index.astro
// ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ ABM96 (ชมพูบับเบิ้ลกัม + เหลืองโลโก้ แทนมรกต + ทองของแบรนด์รอบก่อน):
// พื้น #12030a · การ์ด #1d0611 · ผิวยก #2a0a1a · ขอบชมพูเข้ม #b8325f ·
// ชมพูหลัก #fd6494 ใช้กับ <strong> และสต็อปกลางของเกรเดียนต์ ·
// ชมพูอ่อน #ffc9dc เป็นสต็อปบน · เหลืองโลโก้ #feda2a ใช้กับเลขลำดับและไอคอน ·
// เนื้อความ #fbe3ee · ตัวอักษรบนปุ่มชมพู #12030a · ออร่าชมพู rgba(253,100,148,α)
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 156
const pageDescription = "ทดลองเล่น ABM96 ไล่ดูเมนูรวมเกมทั้งบาคาร่า สล็อต หวย ไฮโล และบอลก่อนเดิมพันด้วยเงินจริง ทั้งวิธีเลือกหมวดเกม การเปิดดูรายละเอียด และการตรวจสอบเงื่อนไขในระบบ";

const graph = pageGraph(Astro, {
  name: "ทดลองเล่น ABM96 ไล่ดูเกมในระบบก่อนเดิมพันด้วยเงินจริง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title="ทดลองเล่น ABM96 ไล่ดูเกมในระบบก่อนเดิมพันด้วยเงินจริง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่น ABM96 ไล่ดูเกมในระบบก่อนเดิมพันด้วยเงินจริง" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#fbe3ee]">
        <strong class="text-[#fd6494]">ABM96</strong> รวมเกมเดิมพันหลายประเภทไว้ในบัญชีเดียว ทั้งบาคาร่า สล็อต หวย ไฮโล และบอล หน้านี้จึงเปิดไว้ให้คนที่ยังไม่คุ้นกับระบบได้
        <strong class="text-[#fd6494]">ไล่ดูหมวดเกมที่เปิดให้ใช้งาน เปิดรายละเอียดของรายการที่สนใจ และทำความเข้าใจเมนูให้ครบก่อนเข้าเล่นด้วยเงินจริง</strong>
        ตั้งแต่โครงของหน้าเมนูหลัก ไปจนถึงข้อมูลที่ระบบแสดงไว้ในแต่ละหมวด
      </p>

      <p class="text-left text-base leading-relaxed text-[#fbe3ee]">
        เพราะทางเข้าและระบบการใช้งานของรอบนี้<strong class="text-[#fd6494]">ถูกปรับใหม่ทั้งหน้าเกม เมนูสมาชิก และการเข้าถึงผ่านมือถือ</strong>
        การเปิดดูให้ทั่วก่อนจึงช่วยให้เห็นว่าหมวดไหนอยู่ตรงไหน และรู้ล่วงหน้าว่าต้องดูข้อมูลอะไรบ้างก่อนกดเข้าเล่นครั้งแรก
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ไล่ดูเกมของ ABM96 ได้จากบัญชีเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#fbe3ee]">
        จุดที่ช่วยให้ไล่ดูเกมได้เร็วที่สุดคือ<strong class="text-[#fd6494]">ทุกประเภทเกมถูกรวมไว้ในบัญชีเดียว</strong>
        ผู้ใช้งานเลือกหมวดที่สนใจได้จากหน้าเมนูหลัก และสลับระหว่างเกมแต่ละประเภทได้สะดวก ไม่ต้องเปลี่ยนไปใช้หลายเว็บไซต์เพื่อไล่หาว่ารายการที่อยากเล่นอยู่ที่ไหน
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#fbe3ee]">
        <li class="flex gap-3">
          <span class="font-bold text-[#feda2a]">1.</span>
          <span><strong class="text-[#fd6494]">เปิดหน้าเว็บของ ABM96 แล้วดูหน้าเมนูหลัก</strong> ระบบจัดหมวดหมู่ไว้ชัดเจน จึงเห็นภาพรวมของประเภทเกมที่เปิดให้เลือกได้ทันที</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#feda2a]">2.</span>
          <span>
            <strong class="text-[#fd6494]">เลือกหมวดที่สนใจ</strong> ภายในระบบมีทั้งบาคาร่า สล็อต หวย ไฮโล และบอล ถ้ายังไม่แน่ใจว่าถนัดแนวไหน ให้ไล่เปิดดูทีละหมวดก่อน
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#feda2a]">3.</span>
          <span>
            <strong class="text-[#fd6494]">เปิดดูรายการภายในหมวดนั้นจากหน้ารวมเกม</strong> ภายในมีเกมจากหลายค่ายที่เปิดให้เลือกตามหมวดหมู่ ตรวจสอบรายการที่เปิดให้บริการอยู่ได้จากหน้านี้
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#feda2a]">4.</span>
          <span>
            <strong class="text-[#fd6494]">ลองสลับไปดูหมวดอื่นด้วยบัญชีเดิม</strong> การสลับระหว่างเกมแต่ละประเภททำได้จากเมนูเดียวกัน จึงไม่ต้องออกไปเปิดเว็บไซต์อื่นระหว่างเปรียบเทียบ
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#feda2a]">5.</span>
          <span>
            <strong class="text-[#fd6494]">ทวนข้อมูลอีกครั้งก่อนกดเข้าเล่นด้วยเงินจริง</strong> ทั้งหมวด ชื่อรายการ และยอดเดิมพันที่ตั้งไว้ ขั้นตอนนี้คือจุดที่ลดความผิดพลาดได้มากที่สุด
          </span>
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#fbe3ee]">
        <strong class="text-[#fd6494]">รายการที่เปิดให้บริการเปลี่ยนแปลงได้ตามช่วงเวลา จึงควรตรวจสอบหมวดและรายการล่าสุดจากหน้ารวมเกมของเว็บไซต์ทุกครั้งก่อนเข้าเล่น</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title="จุดที่ควรดูให้ครบก่อนเดิมพันด้วยเงินจริง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#fbe3ee]">
        การไล่ดูระบบมีประโยชน์ที่สุดเมื่อมองมันเหมือนการอ่านคู่มือ ไม่ใช่การลุ้นรางวัล
        <strong class="text-[#fd6494]">เป้าหมายคือรู้จักระบบให้ครบก่อนที่เงินจริงจะเข้ามาเกี่ยวข้อง</strong>
        ห้าเรื่องด้านล่างคือสิ่งที่ควรเก็บข้อมูลไว้ระหว่างเปิดดู
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#fbe3ee]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#feda2a]">🗂️</span>
          <span>
            <strong class="text-[#fd6494]">โครงของเมนูหลักและการจัดหมวดหมู่</strong> จำให้ได้ว่าหมวดไหนอยู่ตรงไหน และสลับไปดูเกมอีกประเภทได้จากจุดใด จะได้ไม่ต้องหาใหม่ทุกครั้งที่อยากเปลี่ยนเกม
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#feda2a]">🃏</span>
          <span>
            <strong class="text-[#fd6494]">ประเภทเกมที่มีให้เลือกในบัญชีเดียว</strong> ทั้งบาคาร่า สล็อต หวย ไฮโล และบอล ลองเปิดดูให้ครบทุกหมวดก่อน จะได้รู้ว่าแนวไหนเหมาะกับตัวเองที่สุด
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#feda2a]">📋</span>
          <span>
            <strong class="text-[#fd6494]">รายการที่เปิดให้บริการจริงในช่วงนั้น</strong> ภายในมีเกมจากหลายค่ายที่เปิดให้เลือกตามหมวดหมู่ ตรวจสอบรายการล่าสุดได้จากหน้ารวมเกมก่อนตัดสินใจ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#feda2a]">🎁</span>
          <span>
            <strong class="text-[#fd6494]">เงื่อนไขของโปรโมชั่นที่จะกดรับ</strong> ทั้งโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% มีรอบรับสิทธิ์และข้อกำหนดต่างกัน ควรเปิดดูรายละเอียดจากหน้าโปรโมชั่นก่อนกดรับ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#feda2a]">💡</span>
          <span><strong class="text-[#fd6494]">งบที่คุณรับความเสี่ยงได้</strong> ตั้งวงเงินต่อรอบไว้ล่วงหน้า แล้วดูว่าระดับไหนทำให้เล่นได้โดยไม่กระทบค่าใช้จ่ายอื่น</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#fbe3ee]">
        <strong class="text-[#fd6494]">ผลของเกมเดิมพันทุกประเภทตัดสินจากระบบของเกมนั้น ไม่มีสูตร ไม่มีเกมใด และไม่มีช่วงเวลาไหนที่รับประกันว่าจะชนะ</strong>
        ข้อมูลที่เก็บได้จากการเปิดดูระบบช่วยให้เลือกหมวดและระดับเดิมพันที่เหมาะกับตัวเองเท่านั้น ไม่ได้ชี้ผลของรอบถัดไป จึงควรกำหนดงบล่วงหน้าและหยุดเมื่อถึงขีดที่ตั้งไว้เสมอ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="สมัคร ABM96 ได้เองใน 3 ขั้นตอน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#fbe3ee]">
        เมื่อคุ้นเคยกับระบบแล้วและอยากลงสนามจริง <strong class="text-[#fd6494]">สมัครผ่านหน้าเว็บไซต์ได้ด้วยตัวเอง ขั้นตอนถูกจัดไว้ให้เข้าใจง่าย</strong>
        เริ่มจากกรอกข้อมูลที่ระบบกำหนดในหน้าสมัคร ตรวจสอบข้อมูลและรายละเอียดบัญชีให้ถูกต้อง แล้วยืนยันการสมัคร จากนั้นเข้าสู่ระบบเพื่อเลือกสล็อต บาคาร่า หวย ไฮโล หรือบอลที่ต้องการได้ทันที
      </p>

      <p class="text-left text-base leading-relaxed text-[#fbe3ee]">
