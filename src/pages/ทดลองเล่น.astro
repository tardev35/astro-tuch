---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";

import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion,
// /login, /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์
// หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ (src/assets/content.txt) ไม่มี
// หมวด "ทดลองเล่น" และไม่มีส่วน SUB-PAGES เลย ทั้งหน้าจึงเขียนขึ้นใหม่จาก
// ข้อเท็จจริงและคลังคำของบรีฟรอบนี้ (.claude/brand-spec-satu168.md §6)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
//   h1  ทดลองเล่น <แบรนด์> ไล่ดูรูปแบบการแทงและประเภทหวยก่อนใช้งานจริง
//   h2  ไล่ดูประเภทหวยและรูปแบบการแทงที่เปิดให้บริการ
//   h2  ตรวจรอบปิดรับ อัตราจ่าย และแหล่งอ้างอิงผลรางวัลก่อนทำรายการ
//   h2  ศึกษาเงื่อนไขฝากถอนและโปรโมชั่นก่อนทำรายการจริง
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// 🚨 แกนของดรอปนี้ (2026-10-21) คือ **เว็บหวยล้วน** — เว็บที่รวบรวมหวยหลาย
// ประเภทไว้ที่เดียว: **หวยรัฐบาลไทย (อ้างอิงผลสลากกินแบ่งรัฐบาล) · หวยฮานอย ·
// หวยลาว · หวยหุ้นต่างประเทศ** พร้อมเมนูตรวจสอบรายการ เลือกประเภทหวย และ
// รายละเอียดการฝากถอน **ไม่ใช่เว็บเกมคาสิโนและไม่ใช่เว็บระบบการเงิน**
// ⚠️ หมวดเกมของแบรนด์ก่อนหน้า (รายการเต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง)
// **ไม่มีในบรีฟรอบนี้เลยแม้แต่คำเดียว ห้ามเติมกลับเข้ามา** ทั้งหน้าเขียนใหม่หมด
// ไม่ใช่ find-and-replace ทับประโยคเดิม
//
// route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ทดลองเล่น · /about-us · /contact-us · /ตรวจหวย · /แนวทาง · /terms ·
// /privacy · /line  (รอบนี้เป็นเว็บหวย → /ตรวจหวย กับ /แนวทาง เปิดอยู่จริง
// ตาม brand-spec §7 ลิงก์ไปได้)
//
// ⚠️ **บรีฟไม่ได้ประกาศว่ามีโหมดทดลอง เครดิตทดลอง หรือเดโมฟรีเป็นบริการของเว็บ**
// จึงห้ามสัญญาสินค้าตัวนั้น คำว่า "ทดลองเล่น" บนหน้านี้จึงหมายถึงสิ่งที่บรีฟระบุ
// ไว้ตรงๆ ว่าทำได้: ไล่ดูประเภทหวยและรูปแบบการแทง ตรวจรอบปิดรับ อัตราจ่าย
// แหล่งอ้างอิงผลรางวัล และศึกษาเงื่อนไขฝากถอน/โปรโมชั่นให้ครบหนึ่งรอบ
// แล้วสอบถามเจ้าหน้าที่ ก่อนทำรายการจริง
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกม ชื่อธนาคาร ผู้ให้บริการ ใบอนุญาต
// นิติบุคคล ปีก่อตั้ง จำนวนสมาชิก หรือค่าอัตราคืนของเกม แม้แต่รายการเดียว** จึงห้ามเขียน
// ลงหน้าเว็บ · ตัวเลขที่ขึ้นหน้าได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 24ชม.
//
// คลังคำที่บรีฟรอบนี้ให้มาและใช้ได้เท่านี้ (brand-spec §6): หวยออนไลน์ ·
// หวยรัฐบาลไทย · สลากกินแบ่งรัฐบาล · หวยฮานอย · หวยลาว · หวยหุ้นต่างประเทศ ·
// ระบบแทงหวย · ทางเข้า · บริษัทแม่ · รอบปิดรับ · รอบประกาศผล · อัตราจ่าย ·
// แหล่งอ้างอิงผลรางวัล · ตรวจสอบรายการ · ประเภทหวย · บิลหวย · หมายเลขรายการ ·
// ฝากถอน · ธนาคาร · วอลเลท · ยอดขั้นต่ำ · ระยะเวลาดำเนินการ · ชื่อบัญชีปลายทาง ·
// บัญชีแอบอ้าง · รายการผิดปกติ · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · โบนัส ·
// เครดิต · ยอดเสีย · รอบเวลารับเครดิต · ลิงก์แนะนำ · เชื่อมโยงบัญชี ·
// ไม่จำกัดยูส · เจ้าหน้าที่ · แอดมิน · 24ชม. · เว็บไซต์ทางการ · ประกาศล่าสุด ·
// รหัสผ่าน · รหัส OTP · หลักฐานที่เชื่อถือได้
//
// ⚠️ คำโฆษณาของบรีฟ ("จ่ายจริงไม่โกง" · "ไม่มีประวัติโกง" · "รับได้ไม่จำกัดยูส")
// อยู่ได้เฉพาะในหัวข้อที่บรีฟเขียนไว้เอง (= หัวข้อของ index.astro) ห้ามขยายเป็น
// คำกล่าวอ้างใหม่ของหน้านี้
//
// 🚨 ประโยคกำกับความเสี่ยงของบรีฟที่ต้องขึ้นครบ (เป็นเนื้อหาของบรีฟ ไม่ใช่
// filler ให้ตัดทิ้ง):
// 1) ควรตรวจสอบอัตราจ่าย รอบปิดรับ และเงื่อนไขของแต่ละรายการก่อนใช้งาน ·
//    ข้อมูลเกี่ยวกับบริษัทแม่และประวัติการจ่ายเงินควรตรวจสอบจากหลักฐานที่
//    เชื่อถือได้ก่อนตัดสินใจ (h1)
// 2) ควรตรวจสอบวันเวลาเปิดรับ อัตราจ่าย และแหล่งอ้างอิงผลรางวัลให้ชัดเจน
//    ก่อนทำรายการ · สำหรับคำกล่าวอ้างเรื่องการจ่ายเงินจริงหรือไม่มีประวัติ
//    ร้องเรียน ควรพิจารณาหลักฐานการให้บริการและความคิดเห็นจากหลายแหล่ง
//    ประกอบกัน (h2 #2)
// 3) ตรวจสอบชื่อบัญชีปลายทางให้ตรงกับข้อมูลผู้ให้บริการที่ยืนยันได้ · หากพบ
//    รายการผิดปกติควรหยุดทำธุรกรรมและติดต่อธนาคารหรือผู้ให้บริการชำระเงินทันที ·
//    การคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกบิลหรือรับประกัน
//    ผลตอบแทนในอนาคต · แม้ระบุว่าไม่จำกัด แต่ควรยืนยันข้อกำหนดเกี่ยวกับจำนวน
//    บัญชีที่เข้าร่วม รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุด ·
//    ตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ · ไม่เปิดเผยรหัสผ่าน
//    หรือรหัส OTP ให้บุคคลอื่น · ควรตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุด
//    อีกครั้ง (h2 #3)
//
// 🚨 **รอบนี้หน้านี้ไม่มีรูปเลย และนั่นตั้งใจ** — ดรอปนี้ (brand-spec §5) ไม่มี
// article illustration (banner2/banner3 เป็นอาร์ตเวิร์กของแบรนด์คนละราย เก่า
// ทั้งคู่) และ slide1/slide2 ถูกตรึงไว้กับ index กับ /promotion เท่านั้น ส่วน
// gamedemo*.webp ที่ยังอยู่บนดิสก์ (gamedemo7–18) เป็น **อาร์ตสต็อกเกมของ
// เทมเพลตในหมวดอื่น** ซึ่งขัดทั้งแกนแบรนด์ (รอบนี้เป็นเว็บหวยล้วน)
// และพาเลตของรอบนี้ จึงไม่ import **ไฟล์ยังอยู่บนดิสก์ ห้ามลบ เป็นอินเวนทอรี
// ของแบรนด์หมวดนั้นรอบถัดไป** — แค่ห้าม import (ลำพังการ import ก็ทำให้ไฟล์ถูก
// emit ลง dist/ และ verify-build จะแดงถ้าไม่ถูก render) · banner1 /
// banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// slide3/slide4 เป็นโปสเตอร์หวยของอีกแบรนด์ ห้าม import
//
// 🚨 พาเลตรอบนี้ (brand-spec §2) เป็น **ธีมสว่าง** bg.json ของดรอปนี้คือ
// {"mode":"color","color":"#d8ffc7"} = เขียวมิ้นต์สว่าง ไม่ใช่ดำ
// **ห้าม "แก้" กลับไปเป็นพื้นเข้มเพราะรอบก่อนๆ เป็นแบบนั้น**
// ค่าที่ใช้ได้ในไฟล์นี้: เขียวเข้ม #0a5f1c (หัวข้อ/<strong>/marker — 7.9:1 บนผิว
// การ์ดขาว) · หมึกเขียวป่า #0c3a16 (เนื้อความ = BRAND_TEXT, 12.9:1) ·
// เขียวมรกต #0b7d28 (พื้นถม/ขอบ/ออรา — ขาวบนพื้นนี้ได้ 5.3:1) · ขาว #ffffff
// (ตัวอักษรบนพื้นถมเขียว) · อินเซ็ต #e9fbdd / พื้นเพจ #d8ffc7
// 🚨 **เขียวใบตอง 0f9b35 ห้ามถือตัวอักษรและห้ามเป็นพื้นของตัวอักษร** (3.7:1)
// เป็น stop ของไล่เฉด/ออราได้อย่างเดียว · สีไฮไลต์ <strong> ในเนื้อความมีตัวเดียว
// คือ #0a5f1c
// 🚨 **#d8ffc7 และ #e9fbdd ห้ามถือตัวอักษรบนพื้นขาว** เป็นสีพื้น/ขอบเท่านั้น
// 🚨 **ทองสัมฤทธิ์ของรอบนี้ (c9cb63 aeb04a 9ba03c) ห้ามใช้ในไฟล์นี้เลยสักจุด**
// — บนผิวการ์ดขาวได้แค่ 1.7–2.8:1 ทองเป็นสีของโครม (navbar/footer/ticker) เท่านั้น
// ออราที่อนุญาต: rgba(11,125,40,α) · rgba(10,95,28,α) · rgba(12,58,22,α)
// ⚠️ ห้ามกลับด้าน: พื้นถมเขียวมรกต #0b7d28 ต้องใช้ตัวอักษรขาวเสมอ ห้ามหมึกเข้ม
// · รอบนี้ไม่มีชมพู ไม่มีแดงชาด ไม่มีบรอนซ์ส้ม ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง
// ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์ · เขียวของแบรนด์ LINE ไม่ปรากฏในไฟล์นี้
// (ปุ่ม LINE อยู่บน /about-us กับ /contact-us) ปุ่มในไฟล์นี้จึงมีสามขั้ว:
// พื้นถมเขียวมรกต vs พื้นถมไล่เฉดเขียวเข้ม vs อินเซ็ตขอบเขียวโปร่ง
// marker ของลำดับเลขใช้เขียวเข้ม #0a5f1c (เป็นตัวอักษร) และชิปไอคอนใช้เขียวมรกต
// เป็น **เส้นขอบ** บนอินเซ็ต #e9fbdd ไม่ถือตัวอักษร
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT
// #0c3a16, 12.9:1 บนผิวการ์ดขาว) ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่
// ประกาศสีของตัวเอง ปล่อยให้สืบทอดลงมา และไม่ใส่ mx-auto / max-w-* บน <p> เพราะ
// การ์ดคุมความกว้างเองแล้ว — มีแค่ปุ่ม ชิปไอคอน marker ของลำดับเลข และ <strong>
// ที่ประกาศสี โดย <strong> ใช้เขียวเข้ม #0a5f1c ตัวเดียวตาม brand-spec §2
// และแต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่
// เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง
// และห้ามวาง <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังในข้อความของ prop
//
// Announcement รอบนี้หมุนมาเป็น AnnouncementHuay ทั้งเว็บ (brand-spec §3)
// orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว
// จึงเรียกแบบ bare **ห้ามส่ง prop message** มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 153 อักขระ เป็นประโยคเดียวที่บอกว่าหน้านี้มีไว้ทำอะไร แล้วหยุด
// (Google ตัดราว 155 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} หน้ารวมวิธีไล่ดูรูปแบบการแทงและประเภทหวยก่อนใช้งานจริง พร้อมจุดที่ควรตรวจทั้งรอบปิดรับ อัตราจ่าย แหล่งอ้างอิงผลรางวัล และเงื่อนไขฝากถอน`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ไล่ดูรูปแบบการแทงและประเภทหวยก่อนใช้งานจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#0a5f1c]">{BRAND_NAME} รวบรวมข้อมูลหวยหลายประเภทไว้ในเว็บไซต์เดียว</strong>
        ทั้งหวยรัฐบาลไทย หวยฮานอย หวยลาว และหวยหุ้นต่างประเทศ พร้อมเมนูตรวจสอบรายการ เลือกประเภทหวย และรายละเอียดการฝากถอน หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับระบบแทงหวยได้ไล่ดูให้ครบหนึ่งรอบก่อนใช้งานจริง
