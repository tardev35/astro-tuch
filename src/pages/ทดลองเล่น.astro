---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";

import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login,
// /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx
// ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บน
// ข้อเท็จจริงของ หวยคิง เท่านั้น (src/assets/content.txt)
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
//
// หวยคิง เป็น **เว็บรับแทงหวยออนไลน์** แง่มุมที่บรีฟระบุไว้มีเท่านี้: เลือกเลขและ
// ส่งโพยผ่านระบบบนมือถือ · มีทั้งเลข 2 ตัว เลข 3 ตัว และรายการหวยตามรอบที่เว็บไซต์
// เปิดให้บริการ · อัตราจ่ายรายการที่เข้าเงื่อนไข 2 ตัว จ่าย 100 บาท / 3 ตัว จ่าย
// 1,000 บาท (เลข 3 ตัวสูงสุดตามโปรโมชันที่บาทละ 1,000) · กรอกเลขและยอดที่ต้องการ
// ก่อนตรวจสอบสถานะการรับแทงจากระบบ · ตรวจสอบเลข ยอดแทง อัตราจ่าย และสถานะโพยได้
// ก่อนยืนยัน · วงเงินรับแทง/ยอดสูงสุดที่ระบบเปิดรับต่างกันตามรอบ · เครดิตผ่าน
// วอลเลทและธนาคารที่ระบบกำหนด · สมัคร 3 ขั้นตอน · ประวัติโพย · แอดมิน 24 ชั่วโมง ·
// ห้ามเปิดเผยรหัสผ่าน PIN หรือ OTP
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามี "โหมดทดลอง" เครดิตทดลอง หรือหวยเดโมเป็นบริการของเว็บ —
// จึงห้ามสัญญาสินค้าตัวนั้น และห้ามดึง src/assets/gamedemo*.webp กลับมา (ไฟล์ชุดนั้น
// เป็นอินเวนทอรีเก่า ไม่ใช่อาร์ตเวิร์กของดรอปนี้) หน้านี้จึงไม่มีรูปและไม่มีกริดเกม
// เดโม โดยตั้งใจ — ตัวหน้าเป็นบทความล้วน
// สิ่งที่บรีฟระบุไว้ตรง ๆ ว่าควรทำก่อนยืนยันคือ "ตรวจสอบเลข ยอดแทง อัตราจ่าย และ
// สถานะโพยได้ก่อนยืนยัน" = ไล่เปิดหน้าส่งโพยให้ครบหนึ่งรอบก่อนเดิมพันด้วยเครดิตจริง
// ไม่ใช่การเล่นฟรี
//
// ⚠️ แบรนด์ก่อน (UP555) เป็นคาสิโน คำชุดนั้นห้ามหลงเหลือเด็ดขาด: สล็อต บาคาร่า
// บอล/เดิมพันฟุตบอล ค่ายเกม คาสิโนสด หมวดเกม RTP ความผันผวน ทางเข้าเล่นใหม่
// ระบบอัปเกรด คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% เว็บตรงต่างประเทศ บัญชีบริษัทแท้ 100%
// หน้านี้เขียนขึ้นใหม่จากบรีฟ ไม่ใช่ find-and-replace ทับประโยคคาสิโนเดิม
//
// ตัวเลขที่อ้างได้มีแค่ 100 / 1,000 / 2 ตัว / 3 ตัว / 3 ขั้นตอน / 24 ชั่วโมง
// ห้ามแต่งชื่อตลาดหวย (ฮานอย ลาวพัฒนา หวยหุ้น ยี่กี) เวลาเปิด-ปิดรับ ชื่อธนาคาร
// เลขใบอนุญาต ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีที่ก่อตั้ง เพราะบรีฟไม่ได้เอ่ยไว้
//
// ประโยคกำกับของบรีฟที่ห้ามตัดทิ้ง: อัตราจ่ายอาจแตกต่างตามประเภทหวย รูปแบบการแทง
// หรือเงื่อนไขของแต่ละรอบ หากข้อมูลบนหน้าส่งโพยต่างจากข้อความประชาสัมพันธ์ ควรยึด
// อัตราล่าสุดที่ระบบแสดงก่อนยืนยัน · สำหรับเลขที่มีผู้เลือกจำนวนมาก ระบบอาจกำหนด
// วงเงินรับแทงตามแต่ละรอบ จึงให้ยึดวงเงินจริงที่เว็บไซต์แสดง · ไม่เปิดเผยรหัสผ่าน
// PIN หรือ OTP ให้บุคคลอื่น
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: banner1/banner1-mobile/og.png เป็นของ glob ที่
// MainLayout ปักไว้ ห้ามอ้างจากหน้า · slide1/slide2 ของดรอปนี้เป็นของ index และ
// /promotion · slide3/slide4/banner2/banner3 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น AnnouncementHuay ทั้งเว็บ (รอบก่อน UP555 ใช้ Announcement5)
// — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ หวยคิง แล้ว จึงเรียก
// แบบ bare ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ หวยคิง (brand-spec §2) **ทองโลหะบนดำอมน้ำตาล คู่สีรองเป็นครีมอมพีช**
// เพราะโลโก้เป็นมงกุฎทองบนลูกบอลหวยเลข 9 กับตัวอักษรไทยสามมิติสีทอง และครีมอมพีช
// มาจากชุดขาวของนางแบบใน slide1/slide2 (ไม่ใช่เงินโครเมียมแบบ UP555):
// ทองแบรนด์ #cd9a2c (ขอบ ไอคอน bullet marker ปุ่มรอง) · ทองสว่าง #fdeb7c (หมึก
// strong + ต้นไล่เฉดปุ่มหลัก) · ทองลึก #ab7314 (ปลายไล่เฉดปุ่มหลัก, ขอบ) ·
// ครีมอมพีช #fcd4c3 / ครีมอ่อน #fce2d4 (สีรอง, ปุ่มรองคู่ /login) · ผิวการ์ดยก
// #1c140b · พื้นลึกสุด #0c0b0a (ปุ่มรอง) · ขอบจาง #5c3f12 · หมึกบนปุ่มทอง #120a02 ·
// เนื้อความ #f5e7c8 (BRAND_TEXT) · glow เป็น rgba(205,154,44,α)
// ชุดทอง + เงินโครเมียมของ UP555 (#ebbb54 #fce675 #ab6d24 #d6a53a #d5d4d3 #f3f3f2
// #130b03 #241705 #0c0502 #160d02 #f8eed9 rgba(235,187,84,*) rgba(12,5,2,*)) ออกครบ
// ทุกจุดแล้ว ทั้งคลาส Tailwind raw hex และ rgba()
// กฎคอนทราสต์: พื้นทองสว่าง → หมึก #120a02 เสมอ และปุ่มรองเป็น "ขอบทอง/ครีมบนพื้นดำ
// อมน้ำตาล" ไม่ใช่ถมทองอีกใบ
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// — การ์ดตั้งสีเนื้อความ #f5e7c8 ไว้ที่ตัวการ์ดแล้ว ย่อหน้าจึงไม่ใส่คลาสสีซ้ำ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 156
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} ด้วยการไล่ดูขั้นตอนเลือกรายการหวยและรอบ กรอกเลขกับยอดแทง แล้วอ่านอัตราจ่ายและวงเงินรับแทงบนหน้าส่งโพยให้ครบก่อนยืนยันด้วยเครดิตจริงทุกครั้ง`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ไล่ดูขั้นตอนเลือกรายการหวยและอ่านอัตราจ่ายก่อนส่งโพย`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed">
        <strong class="text-[#fdeb7c]">{BRAND_NAME}</strong> เปิดให้สมาชิกเลือกเลขและส่งโพยผ่านระบบบนมือถือ
        <strong class="text-[#fdeb7c]">ทั้งเลข 2 ตัว เลข 3 ตัว และรายการหวยตามรอบที่เว็บไซต์เปิดให้บริการ</strong>
        หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับระบบได้ไล่ดูหน้าจอให้ครบหนึ่งรอบ ตั้งแต่การเลือกรายการและรอบ ไปจนถึงหน้าส่งโพยที่แสดงอัตราจ่ายและวงเงินรับแทง ก่อนจะยืนยันรายการด้วยเครดิตจริง
      </p>

      <p class="text-left text-base leading-relaxed">
        คำว่า ทดลองเล่น ที่หน้านี้พูดถึงจึงหมายถึง
        <strong class="text-[#fdeb7c]">การกรอกเลขและยอดที่ต้องการ แล้วตรวจสอบเลข ยอดแทง อัตราจ่าย และสถานะโพยให้ครบก่อนยืนยัน</strong>
        ตามที่เว็บไซต์แนะนำไว้เอง ไม่ใช่การรับประกันผลของรอบใดรอบหนึ่ง และไม่ใช่เครดิตทดลองหรือการส่งโพยฟรี เมื่อ Login แล้วสมาชิกจะตรวจสอบรายการหวย อัตราจ่าย เครดิต และประวัติโพยได้จากบัญชีของตนเอง
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`ไล่ดูขั้นตอนเลือกรายการหวยและรอบของ ${BRAND_NAME}`} as="h2">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed">
        หลัง Login ลำดับการใช้งานจะเป็นชุดเดียวกันทุกครั้ง
        <strong class="text-[#fdeb7c]">เลือกรายการหวยและรอบ กรอกเลข กำหนดยอด แล้วอ่านหน้าส่งโพยก่อนยืนยัน</strong>
        การไล่ดูให้ครบรอบหนึ่งก่อนจึงช่วยให้รู้ว่าข้อมูลแต่ละอย่างอยู่ตรงไหนของหน้าจอ และควรเริ่มจากรายการที่อ่านรายละเอียดจบได้เร็วที่สุด
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#cd9a2c]">🗂️</span>
          <span>
            <strong class="text-[#fdeb7c]">เลือกรายการหวยและรอบ</strong> ระบบเปิดรับตัวเลขตามรายการและรอบที่กำหนด จึงควรดูว่ารายการที่กำลังเปิดอยู่เป็นรอบใด เพราะเงื่อนไขและวงเงินของแต่ละรอบไม่จำเป็นต้องเหมือนกัน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#cd9a2c]">🔢</span>
          <span>
            <strong class="text-[#fdeb7c]">กรอกเลขที่ต้องการ</strong> ไม่ว่าจะเป็นเลขที่เลือกเอง เลขเด็ด หรือเลขดังที่กำลังได้รับความสนใจ สำหรับเลข 2 ตัวควรตรวจให้ครบทั้งสองหลัก และสำหรับเลข 3 ตัวควรดูว่ากำลังเลือกรูปแบบการแทงแบบใด
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#cd9a2c]">💰</span>
          <span>
            <strong class="text-[#fdeb7c]">กำหนดยอดแทงตามวงเงินที่ระบบเปิดรับ</strong> ยอดที่กรอกได้ขึ้นอยู่กับวงเงินรับแทงของรายการนั้นในรอบนั้น หากเลือกเลขที่มียอดสูง ระบบอาจแสดงยอดสูงสุดที่รับได้ต่างจากเลขอื่นในรอบเดียวกัน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#cd9a2c]">📨</span>
          <span>
            <strong class="text-[#fdeb7c]">เปิดหน้าส่งโพยแล้วอ่านก่อนยืนยัน</strong> หน้านี้คือที่ที่ระบบแสดงเลข ยอดแทง อัตราจ่าย และสถานะโพยพร้อมกัน จึงเป็นจุดสุดท้ายที่แก้ไขได้ก่อนรายการถูกบันทึก
          </span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed">
        <strong class="text-[#fdeb7c]">สำหรับเลขที่มีผู้เลือกจำนวนมาก ระบบอาจกำหนดวงเงินรับแทงตามแต่ละรอบ</strong>
        ดังนั้นค่าที่จำไว้จากรอบก่อนหน้าอาจไม่ใช่ชุดเดียวกับรอบที่กำลังจะส่งโพย ควรกรอกเลขและตรวจสอบยอดสูงสุดที่ระบบรับได้ใหม่ทุกครั้งแทนการอ้างจากความเคยชิน
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/about-us"
          aria-label={`อ่านหน้าเกี่ยวกับเราของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#cd9a2c]/60 bg-[#0c0b0a] px-8 py-3 font-bold text-[#fdeb7c] transition-all hover:scale-105 hover:border-[#fdeb7c] hover:bg-[#1c140b] hover:text-[#fce2d4]">
          อ่านเกี่ยวกับเรา
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="จุดที่ควรอ่านบนหน้าส่งโพยก่อนยืนยันด้วยเครดิตจริง" as="h2">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed">
        การไล่ดูระบบมีประโยชน์ที่สุดเมื่อมองว่าเป็นการอ่านหน้าส่งโพยให้จบก่อน
        <strong class="text-[#fdeb7c]">เป้าหมายคือรู้อัตราจ่ายและวงเงินรับแทงของรายการที่จะส่งให้ครบ ก่อนที่เครดิตจริงจะเข้ามาเกี่ยวข้อง</strong>
        เรื่องด้านล่างคือสิ่งที่ควรเก็บข้อมูลไว้ระหว่างเปิดดู และควรตรวจซ้ำทุกครั้งที่เปลี่ยนรายการหรือเปลี่ยนรอบ
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#cd9a2c]">🎯</span>
          <span>
            <strong class="text-[#fdeb7c]">อัตราจ่ายของรายการนั้นโดยตรง</strong> รายการที่เข้าเงื่อนไขกำหนดไว้ที่ 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท แต่อัตราจริงอาจขึ้นอยู่กับประเภทหวยและรูปแบบการเดิมพัน จึงควรอ่านราคาที่หน้าส่งโพยแสดง ไม่ใช่เทียบจากรายการอื่นที่เคยส่ง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#cd9a2c]">📊</span>
          <span>
