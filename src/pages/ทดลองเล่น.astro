---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login, /register)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริง
// ของ GOT777 เท่านั้น
//
// GOT777 เป็น **เว็บเกมสล็อตออนไลน์** ส่วนแบรนด์ก่อนหน้า (LOTTOPLUS) เป็นเว็บหวย
// ทั้งหน้าเดิมพูดเรื่องหวยรัฐบาลไทย ลาวพัฒนา ฮานอย หวยหุ้น โพย งวด อัตราจ่าย
// 2 ตัว/3 ตัว — คำชุดนั้นถูกถอดออกทั้งหมด ห้าม find-and-replace ชื่อแบรนด์ทับ
// ประโยคเดิม มิฉะนั้นเว็บสล็อตจะไปอ้างสินค้าคนละตัวที่ไม่มีอยู่ในบรีฟรอบนี้เลยสักคำ
// (คำห้าม: หวย โพย แทงหวย ตรวจหวย รัฐบาลไทย ลาวพัฒนา ฮานอย หวยหุ้น
// อัตราจ่าย 2 ตัว/3 ตัว รอบออกรางวัล ส่งโพย งวด เลขเด็ด แนวทางหวย)
//
// บรีฟไม่ได้ประกาศว่ามี "เครดิตทดลอง" หรือโหมดเดโมเป็นบริการของเว็บ — จึงห้าม
// สัญญาสินค้าตัวนั้น หน้านี้พูดถึงโหมดทดลองหมุนวงล้อแบบ hedge ตามแพตเทิร์นของบรีฟ
// ("ขึ้นอยู่กับเกมและค่ายที่ระบบเปิดให้บริการ") ควบคู่กับการไล่ดูระบบจริงให้ครบ
// ตั้งแต่ Login เลือกเกม ดูกติกาและช่วงเดิมพัน ก่อนยืนยันเดิมพันจริงรอบแรก
//
// ข้อเท็จจริงทุกบรรทัดมาจาก src/assets/content.txt เท่านั้น: รวมเกมสล็อตหลาย
// รูปแบบจากแพลตฟอร์มค่ายใหญ่ไว้ในบัญชีเดียว · สล็อตคลาสสิก เกมโบนัส ฟรีสปิน
// ตัวคูณ เกมแจ็กพอต · เกมวงล้อแบบดั้งเดิม สล็อตธีมเอเชีย เกมผจญภัย ·
// รองรับมือถือ แท็บเล็ต คอมพิวเตอร์ · เลือกเกม ตรวจสอบเครดิต โปรโมชั่น และ
// ประวัติรายการจากระบบเดียว · ผลลัพธ์เป็นแบบสุ่ม ไม่รับประกันว่าจะชนะ ·
// จำนวนเกมและแจ็กพอตขึ้นกับแต่ละค่าย ควรตรวจกติกา ช่วงเดิมพัน ฟีเจอร์โบนัส
// และเงื่อนไขแจ็กพอตในเกมก่อนเดิมพัน · ยอดเดิมพันขั้นต่ำต่างกันตามผู้ให้บริการ ·
// คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · แอดมิน 24 ชั่วโมง · ไม่เปิดเผยรหัสผ่าน
// PIN หรือ OTP
// — ตัวเลขที่อ้างได้มีเท่านี้ ห้ามเพิ่มชื่อค่ายเกม ชื่อธนาคาร ขั้นต่ำฝาก RTP
// เลขใบอนุญาต หรือจำนวนขั้นตอนที่บรีฟไม่ได้นับไว้
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: banner1/banner1-mobile/og.png เป็นของ glob ที่
// MainLayout ปักไว้ ห้ามอ้างจากหน้า · slide1/slide2 ของดรอปนี้เป็นของ index และ
// /promotion · slide3/slide4/banner2/banner3 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
// gamedemo7–gamedemo18.webp **ใช้ไม่ได้**: ตรวจไฟล์จริงแล้วทุกใบมีลายน้ำแบรนด์อื่น
// ฝังอยู่ในภาพ (askmeslot) และบางใบมีชื่อค่ายเกม (JILI) ซึ่ง brand-spec §1 ห้าม
// เอ่ยชื่อค่ายบนเว็บนี้ จึงห้ามนำมาขึ้นหน้าใด ๆ ของ GOT777
//
// Announcement รอบนี้เป็น Announcement3 ทั้งเว็บ — orchestrator ตั้ง default
// message ของไฟล์นั้นเป็นคอปปี้ของ GOT777 แล้ว จึงเรียกแบบ bare ห้ามส่ง prop
// message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ GOT777 เป็น **ทองนำ แดงเลือดหมูรอง บนดำ** ตามโลโก้ (ตัวอักษร GOT ทอง
// เลข 777 แดง อัญมณีแดงกลางตัว O) กับแบนเนอร์พื้นดำที่มีชิปคาสิโนดำแดงและเหรียญทอง:
// ทองหลัก #f5c518 · ทองอ่อน #ffe9a8 · ทองลึก #96690f · แดงรอง #d21622 ·
// แดงลึก #7b0304 · แดงมืดสุด #4c0301 · พื้นเพจ #0a0503 · ผิวยก #160b06 ·
// ผิวยก 2 #241108 · เนื้อความ #ece0cb (BRAND_TEXT) · เนื้อความรอง #bdae92 ·
// เน้นใน strong #fff6dd · หมึกบนพื้นทอง #0a0503
// ชุดแดงของ LOTTOPLUS (#dc020e #ff2d38 #6b0207 #f3c623 #fde79a #8a6a0a #f0e2e2
// #fff4f4 #120b0c #1f0a0c #2a0d0f #1a0203 rgba(220,2,14,*) rgba(243,198,35,*))
// ออกครบทุกจุดแล้ว ทั้งคลาส Tailwind raw hex และ rgba() ที่ใช้ทำแสงเรือง
// กฎคอนทราสต์: พื้นทอง → หมึกเข้ม #0a0503 (12.3:1) · พื้นแดง #d21622 → ตัวอักษร
// ขาว (5.4:1) · ส่วนตัวอักษรบนการ์ดดำใช้ทอง #f5c518 หรือ #ffe9a8 เท่านั้น
// เพราะแดงรอง #d21622 บนการ์ดดำได้แค่ ~3.5:1 — แดงจึงใช้เป็น "พื้น/ขอบ" ไม่ใช่หมึก
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลางที่ orchestrator รีธีมรอบนี้) — การ์ดตั้ง
// สีเนื้อความไว้ให้แล้ว ย้ำไว้บนย่อหน้าอีกชั้นเพื่อให้สีของ body copy อ่านออกจาก
// ตัวหน้าเอง
//
// รอบนี้ /ตรวจหวย และ /แนวทาง ถูกย้ายออกไป src/pages-disabled/ (GOT777 ไม่ใช่
// เว็บหวย) ลิงก์เดิมที่หน้านี้เคยชี้ไปหน้าตรวจผลหวยจึงถูกถอดออก เหลือลิงก์ภายใน
// ที่มี route จริงเท่านั้น: /promotion /register /login
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 156
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "ทดลองเล่นสล็อต GOT777 ผ่านเบราว์เซอร์บนมือถือ ไล่ดูเกมจากค่ายใหญ่ ฟรีสปิน ตัวคูณ และเกมโบนัส พร้อมตรวจกติกาและช่วงเดิมพันที่แสดงในเกมให้ครบก่อนยืนยันเดิมพัน";

const pageTitle = "ทดลองเล่นสล็อต GOT777 ไล่ดูเกมจากค่ายใหญ่ก่อนเดิมพันจริง";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ece0cb]">
        <strong class="text-[#fff6dd]">GOT777</strong> ให้บริการเกมสล็อตออนไลน์ที่รวบรวมเกมหลากหลายรูปแบบจาก
        <strong class="text-[#fff6dd]">แพลตฟอร์มค่ายใหญ่ไว้ในบัญชีเดียว</strong> รองรับการเข้าเล่นผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ หน้านี้เปิดไว้ให้คนที่ยังไม่คุ้นกับระบบได้ลองเปิดใช้งานจริงหนึ่งรอบ ตั้งแต่หน้าเลือกเกม
        ไปจนถึงหน้ากติกาและช่วงเดิมพันของเกมนั้น ก่อนจะลงเดิมพันกับเกมไหนจริง
      </p>

      <p class="text-left text-base leading-relaxed text-[#ece0cb]">
        คำว่า “ทดลองเล่น” ที่หน้านี้พูดถึงจึงหมายถึง<strong class="text-[#fff6dd]">
          การเดินให้ครบทุกขั้นของการใช้งาน ตั้งแต่ Login เลือกเกมสล็อต อ่านกติกา ดูช่วงเดิมพัน ไปจนถึงตรวจสอบเครดิตและประวัติรายการ
        </strong>
        ส่วนโหมดทดลองหมุนวงล้อภายในเกมนั้นมีหรือไม่ขึ้นอยู่กับเกมและค่ายที่ระบบเปิดให้บริการในขณะนั้น และไม่ว่าจะหมุนในโหมดไหน เกมสล็อตก็ยังเป็นเกมที่มีผลลัพธ์แบบสุ่ม จึงไม่สามารถรับประกันว่าจะชนะหรือทำกำไรได้ตลอดเกม
      </p>
    </div>
  </ContentBox>

  <ContentBox title="เปิด GOT777 เล่นได้ทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ece0cb]">
        จุดที่ช่วยให้เริ่มต้นได้เร็วที่สุดคือ<strong class="text-[#fff6dd]">เกมสล็อตจากหลายค่ายถูกรวมไว้ในบัญชีเดียว และสลับเกมได้จากหน้าเดิม</strong>
        สมาชิกจึงไม่ต้องสมัครหลายบัญชีเพื่อไล่ดูเกมของแต่ละค่าย และค้นหาเกมใหม่หรือเกมยอดนิยมได้จากหน้าเกมสล็อตหน้าเดียว
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#ece0cb]">
        <li class="flex gap-3">
          <span class="font-bold text-[#f5c518]">1.</span>
          <span>
            <strong class="text-[#fff6dd]">เปิดเว็บไซต์ GOT777 จากช่องทางหลักก่อน</strong> การเข้าผ่านช่องทางที่เว็บไซต์ประกาศไว้จริงช่วยหลีกเลี่ยงเว็บไซต์ที่ไม่เกี่ยวข้อง แล้วบันทึกทางเข้านั้นไว้ใช้รอบถัดไป
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#ffe9a8]">2.</span>
          <span>
            <strong class="text-[#fff6dd]">สมัครและยืนยันข้อมูลตามที่ระบบกำหนด แล้ว Login</strong> ขั้นตอนทั้งหมดทำผ่านระบบออนไลน์บนมือถือได้ หลังเข้าสู่ระบบจะเห็นเครดิต โปรโมชั่น และประวัติรายการของบัญชีตัวเอง
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#f5c518]">3.</span>
          <span>
            <strong class="text-[#fff6dd]">ไล่ดูเกมสล็อตจากค่ายที่ระบบเปิดให้บริการในขณะนั้น</strong> ทั้งเกมวงล้อแบบดั้งเดิม สล็อตธีมเอเชีย เกมผจญภัย เกมที่มีฟรีสปินและตัวคูณ รายการเกมที่เปิดให้เล่นจริงขึ้นอยู่กับแต่ละค่าย
            จึงควรดูจากหน้าเกมสล็อตเป็นหลัก
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#ffe9a8]">4.</span>
          <span>
            <strong class="text-[#fff6dd]">เปิดกติกาและช่วงเดิมพันของเกมนั้นให้ครบก่อนหมุน</strong> เพราะเกมแต่ละเกมใช้ช่วงเดิมพันและฟีเจอร์โบนัสไม่เหมือนกัน และยอดเดิมพันขั้นต่ำอาจแตกต่างกันตามผู้ให้บริการ
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#f5c518]">5.</span>
          <span>
            <strong class="text-[#fff6dd]">ลองปรับยอดเดิมพันแล้วอ่านหน้าสรุปก่อนกดยืนยัน</strong> ขั้นนี้คือขั้นที่ควรทำช้าที่สุด เพราะเป็นหน้าจอสุดท้ายที่ยังแก้ยอดเดิมพันได้ก่อนรายการจะถูกบันทึก
          </span>
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#ece0cb]">
        <strong class="text-[#fff6dd]">
          รายการเกมที่เปิดให้เล่น เงื่อนไขของแจ็กพอต และเงื่อนไขของโปรโมชั่นเปลี่ยนแปลงได้ตามช่วงเวลา จึงควรตรวจสอบข้อมูลจากช่องทางอย่างเป็นทางการของเว็บไซต์ทุกครั้งก่อนเดิมพัน
        </strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ประเภทเกมสล็อตที่ลองไล่ดูได้ใน GOT777" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ece0cb]">
        ระหว่างไล่ดูระบบ สิ่งที่ควรจำให้ได้คือ<strong class="text-[#fff6dd]">เกมสล็อตแต่ละแบบมีจังหวะและฟีเจอร์ของตัวเอง</strong>
        ไม่ได้ใช้ช่วงเดิมพันหรือรูปแบบโบนัสชุดเดียวกันทั้งหมด การรู้ว่าแบบไหนเล่นอย่างไรช่วยให้เลือกเกมที่เหมาะกับสไตล์ของตัวเองได้เร็วขึ้น
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#ece0cb]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f5c518]">🎰</span>
          <span>
            <strong class="text-[#fff6dd]">สล็อตคลาสสิกและเกมวงล้อแบบดั้งเดิม</strong> เป็นแบบที่อ่านง่ายที่สุดสำหรับคนเริ่มต้น เพราะเส้นรางวัลและสัญลักษณ์มีไม่มาก ลองดูว่าหน้ากติกาของเกมอธิบายเส้นรางวัลไว้อย่างไรก่อนหมุนรอบแรก
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ffe9a8]">🀄</span>
          <span>
            <strong class="text-[#fff6dd]">สล็อตธีมเอเชียและเกมผจญภัย</strong> มักมีสัญลักษณ์พิเศษและฉากโบนัสเป็นของตัวเอง ควรอ่านว่าสัญลักษณ์ตัวไหนเป็นตัวเปิดฟีเจอร์ก่อน จะได้รู้ว่ากำลังลุ้นอะไรอยู่ระหว่างหมุน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f5c518]">🎁</span>
          <span>
