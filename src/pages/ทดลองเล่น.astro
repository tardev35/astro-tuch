---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login, /register)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริง
// ของ หวยเฮง24 เท่านั้น
//
// หวยเฮง24 เป็น **เว็บเล่นหวยออนไลน์** ที่รวมรายการยอดนิยมไว้ให้เลือกในบัญชีเดียว
// ทั้งหวยลาว หวยฮานอย หวยรัฐบาลไทย และหวยหุ้น — แบรนด์ก่อนหน้า (หวยเต็ง) เป็นเว็บหวย
// เหมือนกันแต่คนละบรีฟ รายละเอียด "ลาวพัฒนา" "ฮานอยปกติ/พิเศษ/วีไอพี" และ
// "หวยหุ้นต่างประเทศ" เป็นของบรีฟรอบก่อน รอบนี้ไม่ได้ระบุไว้จึงถอดออก และเพิ่ม
// สิ่งที่บรีฟรอบนี้ระบุแทนคือ ฝากถอนผ่านวอลเลทและธนาคารที่ระบบรองรับ กับการเช็คผล
// หลังประกาศผลของแต่ละรอบ · ก่อนหน้านั้น (BRAVO168) เป็นเว็บแทงบอล และก่อนหน้านั้น
// อีก (CK268) เป็นเว็บสล็อต ซึ่งบรีฟรอบนี้ไม่ได้พูดถึงเลยสักคำ ห้าม
// find-and-replace ชื่อแบรนด์ทับประโยคเดิม มิฉะนั้นเว็บจะไปอ้างสินค้าที่ไม่มีอยู่จริง
// (คำห้ามจาก brand-spec §6: สล็อต ฟรีสปิน ตัวคูณ ค่ายเกม RTP แตกง่าย เว็บตรง บอล
// ค่าน้ำ อัตราต่อรอง ลีก บิลสเต็ป แฮนดิแคป คาสิโน บาคาร่า)
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามี "โหมดทดลอง" หรือเครดิตทดลองเป็นบริการของเว็บ — จึงห้าม
// สัญญาสินค้าตัวนั้น หน้านี้จึงพูดถึงเฉพาะสิ่งที่ผู้เข้าชม "ดูได้จริง" ก่อนส่งโพยแรก
// ตามที่บรีฟระบุไว้: เลือกเลข ส่งโพย ตรวจสอบรายการ และเช็คผลหลังประกาศผลของแต่ละ
// รอบได้จากหน้าเว็บไซต์ รองรับการใช้งานผ่านมือถือ
//
// ข้อเท็จจริงทุกบรรทัดมาจาก content.txt เท่านั้น: รวมรายการยอดนิยมในบัญชีเดียว ·
// หวยลาวตามรายการที่เปิดรับ หวยฮานอยหลายรอบ หวยรัฐบาลไทยตามกำหนดออกรางวัล
// หวยหุ้นตามตลาดที่ระบบรองรับ · ตรวจสอบเวลาเปิดรับ เวลาปิดรับ และอัตราจ่ายของแต่ละ
// รายการก่อนเลือกเลขได้จากหน้าเดียว · หลังส่งโพยตรวจชื่อหวย รอบเวลา เลขที่เลือก
// และยอดเดิมพัน · ฝากถอนผ่านวอลเลทและธนาคารที่ระบบรองรับ · 2 ตัว จ่าย 100 บาท ·
// 3 ตัว จ่าย 1,000 บาท · สมัคร 3 ขั้นตอน · แอดมิน 24 ชั่วโมง
// — ตัวเลขที่อ้างได้มีแค่ 100 บาท 1,000 บาท 3 ขั้นตอน และ 24 ชั่วโมง
// ห้ามเพิ่มชื่อผู้ให้บริการ ชื่อธนาคาร ขั้นต่ำฝากถอน เลขใบอนุญาต ปีที่ก่อตั้ง
// หรือจำนวนสมาชิกที่บรีฟไม่ได้ระบุ · บรีฟรอบนี้ไม่มีโปรโมชั่น/โบนัสเลยสักรายการ
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: banner1/banner1-mobile/og.png เป็นของ glob ที่
// MainLayout ปักไว้ ห้ามอ้างจากหน้า · slide1/slide2 ของดรอปนี้เป็นของ index และ
// /promotion · slide3/slide4/banner2/banner3 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
// ส่วน gamedemo7–18.webp ที่ยังค้างใน src/assets เป็นภาพหน้าจอเกมสล็อตของแบรนด์เก่า
// ไม่มีโค้ดไหน import แล้ว และห้ามนำกลับมาใช้บนเว็บหวย
//
// Announcement รอบนี้เป็น Announcement5 ทั้งเว็บ (รอบก่อน หวยเต็ง ใช้ Announcement3)
// — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ หวยเฮง24 แล้ว จึง
// เรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ หวยเฮง24 เป็น **แดงเข้ม + ทอง** ตามโลโก้ (คำว่า "หวย" แดงเลือดนกเงาวาว
// ขอบทอง คู่กับ "เฮง24" ทองไล่เฉด) และแบนเนอร์ฉากผ้าซาตินแดงที่มีเงาปราสาททอง
// เหรียญทอง และลูกหวยแดง-ขาว: พื้นเพจ #1a0505 · การ์ด #2e0707 · ผิวยก #3d0808 ·
// แดงเข้ม #5a0202 · แดงกลาง #720202 · แดงแบรนด์ #8b0302 · แดงสว่าง #c01616 ·
// ทองเข้ม #7a4a02 · ทองมืด #a46304 · ทองกลาง #bd7c13 · ทองแบรนด์ #e0a52a ·
// ทองสว่าง #fbdc64 · ทองอ่อน #fdea83 · เนื้อความ #f6e6cf (BRAND_TEXT) ·
// หมึกบนพื้นทอง #2a0606
// เรืองแสง: ทอง rgba(224,165,42,0.40) · แดง rgba(192,22,22,0.35)
// ชุดเขียวป่า-ทองของ หวยเต็ง (#03150a #062a12 #0b3d18 #024a0f #026314 #0bb42f
// #e5c04f #fae474 #bd8d2d #d8ead9 #0a1a0c rgba(229,192,79,*) rgba(2,99,20,*))
// ออกครบทุกจุดแล้ว ทั้งคลาส Tailwind raw hex และ rgba()
// กฎคอนทราสต์: พื้นทอง → หมึกเข้ม #2a0606 · ตัวอักษรบนการ์ดแดงใช้ #f6e6cf #fdea83
// #fbdc64 #e0a52a เท่านั้น ส่วน #8b0302 / #5a0202 / #3d0808 / #bd7c13 ใช้เป็นพื้นและขอบ
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลางที่ orchestrator รีธีมรอบนี้) — การ์ดตั้ง
// สีเนื้อความไว้ให้แล้ว ย้ำไว้บนย่อหน้าอีกชั้นเพื่อให้สีของ body copy อ่านออกจาก
// ตัวหน้าเอง
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 155
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "ทดลองเล่น หวยเฮง24 ด้วยการไล่ดูระบบจริงให้ครบก่อนส่งโพย ตั้งแต่เลือกประเภทหวยและรอบเวลา อ่านอัตราจ่าย ดูเวลาปิดรับ ไปจนถึงตรวจรายละเอียดโพยก่อนกดยืนยันจริง";

const pageTitle = "ทดลองเล่น หวยเฮง24 ไล่ดูรายการหวยและอัตราจ่ายก่อนส่งโพยจริง";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f6e6cf]">
        <strong class="text-[#fdea83]">หวยเฮง24</strong> รวมรายการหวยยอดนิยม
        <strong class="text-[#fdea83]">ไว้ให้เลือกในบัญชีเดียว</strong> ทั้งหวยลาว หวยฮานอย หวยรัฐบาลไทย และหวยหุ้น หน้านี้เปิดไว้ให้คนที่ยังไม่คุ้นกับระบบได้ลองเปิดใช้งานจริงหนึ่งรอบ ตั้งแต่หน้ารายการหวยที่เปิดรับ
        ไปจนถึงหน้าสรุปโพยที่แสดงเลขที่เลือกและอัตราจ่าย ก่อนจะยืนยันโพยใบแรก
      </p>

      <p class="text-left text-base leading-relaxed text-[#f6e6cf]">
        คำว่า “ทดลองเล่น” ที่หน้านี้พูดถึงจึงหมายถึง<strong class="text-[#fdea83]">
          การเดินให้ครบทุกขั้นของการใช้งาน ตั้งแต่ Login เลือกประเภทหวยและรอบ เลือกเลข อ่านอัตราจ่าย ดูเวลาปิดรับ ไปจนถึงตรวจรายละเอียดโพยและเช็คผลหลังประกาศผล
        </strong>
        เว็บไซต์ระบุไว้ว่าสมาชิกสามารถเลือกเลข ส่งโพย ตรวจสอบรายการ และเช็คผลหลังประกาศผลของแต่ละรอบได้จากหน้าเว็บไซต์บนมือถือ ซึ่งเป็นสิ่งที่ผู้เข้าชมไล่ดูได้ทั้งหมดก่อนส่งโพยจริงรอบแรก
      </p>
    </div>
  </ContentBox>

  <ContentBox title="เปิด หวยเฮง24 ดูรายการหวยและรอบเวลาได้จากมือถือ" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f6e6cf]">
        จุดที่ช่วยให้เริ่มต้นได้เร็วที่สุดคือ<strong class="text-[#fdea83]">รายการหวยหลายประเภทถูกรวมไว้ในบัญชีเดียว และสลับประเภทได้จากระบบเดิม</strong>
        สมาชิกจึงไม่ต้องเปิดบัญชีแยกกันไปตามแต่ละรายการ และไล่ดูรอบที่สนใจได้จากหน้าเดียวโดยไม่ต้องสลับหลายเว็บไซต์
      </p>

      <ol class="ml-6 list-decimal space-y-3 text-left text-base leading-relaxed text-[#f6e6cf] marker:font-black marker:text-[#e0a52a]">
        <li>
          <strong class="text-[#fdea83]">เปิดเว็บไซต์ หวยเฮง24 จากช่องทางหลักก่อน</strong> การเข้าผ่านช่องทางที่เว็บไซต์ประกาศไว้จริงช่วยหลีกเลี่ยงเว็บไซต์ที่ไม่เกี่ยวข้อง แล้วบันทึกทางเข้านั้นไว้ใช้รอบถัดไป
        </li>
        <li>
          <strong class="text-[#fdea83]">สมัครและยืนยันข้อมูลตามที่ระบบกำหนด แล้ว Login</strong> ทั้งหมดทำผ่านมือถือได้ หลังเข้าสู่ระบบจะเห็นรายการหวยที่เปิดรับและประวัติโพยของบัญชีตัวเอง
        </li>
        <li>
          <strong class="text-[#fdea83]">ไล่ดูประเภทหวยและรอบที่ระบบเปิดรับในขณะนั้น</strong> ทั้งหวยลาว หวยฮานอย หวยรัฐบาลไทย และหวยหุ้น รายการที่เปิดรับจริงในแต่ละวันขึ้นอยู่กับตารางของหวยแต่ละประเภท
          จึงควรดูจากรายการที่ระบบแสดงไว้เป็นหลัก
        </li>
        <li>
          <strong class="text-[#fdea83]">เปิดดูเวลาเปิดรับ เวลาปิดรับ และอัตราจ่ายของรอบนั้นให้ครบ</strong> เพราะหวยแต่ละประเภทมีตารางเวลาและเงื่อนไขของตัวเอง อัตราจ่ายจึงไม่จำเป็นต้องเหมือนกันทุกรายการ
        </li>
        <li>
          <strong class="text-[#fdea83]">ลองเลือกเลขแล้วอ่านหน้าสรุปโพยก่อนกดยืนยัน</strong> ขั้นนี้คือขั้นที่ควรทำช้าที่สุด เพราะเป็นหน้าจอสุดท้ายที่ยังแก้รายการได้ก่อนโพยจะถูกบันทึก
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#f6e6cf]">
        <strong class="text-[#fdea83]">ตารางเวลาและเงื่อนไขของแต่ละรอบเปลี่ยนแปลงได้ตามช่วงเวลา จึงควรตรวจสอบข้อมูลจากหน้าส่งโพยของรอบนั้นทุกครั้งก่อนยืนยัน</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ประเภทหวยที่ลองไล่ดูได้ใน หวยเฮง24" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f6e6cf]">
        ระหว่างไล่ดูระบบ สิ่งที่ควรจำให้ได้คือ<strong class="text-[#fdea83]">หวยแต่ละประเภทมีรอบและเวลาปิดรับของตัวเอง</strong>
        ไม่ได้ใช้เงื่อนไขชุดเดียวกันทั้งหมด การรู้ว่าแต่ละประเภททำงานอย่างไรช่วยให้เลือกรอบที่เหมาะกับจังหวะของตัวเองได้เร็วขึ้น
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f6e6cf]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e0a52a]">🏛️</span>
          <span>
            <strong class="text-[#fdea83]">หวยรัฐบาลไทย</strong> เปิดรับตามกำหนดออกรางวัลของแต่ละงวด เป็นกลุ่มที่อ่านตารางได้ง่ายที่สุดสำหรับคนเริ่มต้น ลองดูว่าหน้าส่งโพยแสดงเวลาปิดรับของงวดนั้นไว้อย่างไร
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fbdc64]">🎫</span>
          <span>
            <strong class="text-[#fdea83]">หวยลาว</strong> เปิดรับตามรายการที่ระบบประกาศไว้ ลองเปิดดูสักรอบเพื่อให้เห็นว่าชื่อหวยและเวลาปิดรับถูกแสดงไว้ตรงไหนของหน้าส่งโพย
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e0a52a]">🕒</span>
          <span>
            <strong class="text-[#fdea83]">หวยฮานอย</strong> เปิดรับหลายรอบในวันเดียว จึงเป็นกลุ่มที่ควรอ่านชื่อหวยและรอบเวลาให้ละเอียดที่สุดก่อนยืนยัน เพื่อไม่ให้ส่งโพยผิดรอบ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fbdc64]">📈</span>
          <span>
            <strong class="text-[#fdea83]">หวยหุ้น</strong> เปิดรับตามตลาดที่ระบบรองรับและรอบเวลาที่กำหนด จำนวนรายการที่เลือกได้ในแต่ละวันจึงขึ้นอยู่กับตลาดที่เปิดในรอบนั้น
          </span>
        </li>
      </ul>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/promotion"
          aria-label="ดูภาพอัตราจ่ายทั้งหมดของ หวยเฮง24"
