---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { pageGraph } from "../lib/schema";

// HIX168 เป็นเว็บสล็อตออนไลน์ ไม่ใช่คาสิโนครบวงจร — หน้านี้จึงหมายถึงการทำความรู้จัก
// เกมสล็อตและระบบก่อนใช้เครดิตจริง อ่านกติกา ดูช่วงเดิมพัน และรายละเอียดของแต่ละเกม
// ตามที่บรีฟระบุไว้
// แบรนด์เก่าเคยวางแกลเลอรี 12 การ์ด (gamedemo7..18.webp) ไว้ที่หน้านี้ ตอนนี้ไม่มีการ
// import แล้ว — อย่านำกลับมา เพราะลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/
// และ verify-build จะแดงถ้ามีรูปที่ไม่มีใคร render
//
// ทุกข้อความอ้างอิง src/assets/content.txt เท่านั้น ไม่มีการอ้างใบอนุญาต การจดทะเบียน
// ปีที่ก่อตั้ง รางวัล จำนวนสมาชิก หรือการันตีผลกำไร
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 157
const pageDescription = "หน้าทดลองเล่นของ HIX168 แนะนำวิธีทำความรู้จักเกมสล็อตแต่ละแบบ ตรวจสอบกติกา ช่วงเดิมพัน และรายละเอียดของเกม ก่อนเปลี่ยนมาเล่นด้วยเครดิตจริงผ่านระบบฝากถอนออโต้";

const graph = pageGraph(Astro, {
  name: "ทดลองเล่น HIX168 ทำความรู้จักเกมสล็อตก่อนเดิมพันด้วยเครดิตจริง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title="ทดลองเล่น HIX168 ลองเกมสล็อตและทำความเข้าใจระบบก่อนเดิมพันจริง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่น HIX168 ทำความรู้จักเกมสล็อตก่อนเดิมพันด้วยเครดิตจริง" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d6e2f5]">
        <strong class="text-[#8ec5ff]">HIX168</strong> รวมเกมสล็อตออนไลน์หลายรูปแบบไว้ให้เลือกผ่านบัญชีเดียว รองรับการใช้งานผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ หน้านี้จึงเปิดไว้ให้ผู้เริ่มต้นได้
        <strong class="text-[#8ec5ff]">ทำความรู้จักเกมแต่ละตัว อ่านกติกา ตรวจสอบช่วงเดิมพัน และดูรายละเอียดของรายการ</strong>
        ก่อนยืนยันการเล่นด้วยเครดิตของตัวเอง เพราะเกมแต่ละค่ายกำหนดกลไกและเงื่อนไขไว้ไม่เหมือนกัน
      </p>

      <p class="text-left text-base leading-relaxed text-[#d6e2f5]">
        ขอให้เข้าใจตรงกันว่าการทดลองเล่นเป็นการทำความคุ้นเคยกับเกมและระบบเท่านั้น
        <strong class="text-[#8ec5ff]">เกมสล็อตมีผลลัพธ์ที่ไม่แน่นอน คำว่าแตกไวหรือกำไรดีไม่สามารถรับประกันผลการเล่นได้</strong>
        หากติดปัญหาระหว่างใช้งาน สามารถแจ้งแอดมิน HIX168 ได้ตลอด 24 ชั่วโมง พร้อมเวลาและรายละเอียดของรายการ เพื่อให้เจ้าหน้าที่ตรวจสอบระบบหลังบ้านได้ตรงจุด
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="เกมสล็อต HIX168 ที่ควรลองทำความรู้จักก่อนเริ่มเล่น" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d6e2f5]">
        HIX168 จัดหมวดหมู่เกมสล็อตไว้ให้ค้นหาได้ง่าย สิ่งที่ควรเปิดดูให้ครบก่อนเริ่มคือ
        <strong class="text-[#8ec5ff]">กติกาของเกม ค่า RTP และช่วงเดิมพันที่เกมรองรับ</strong>
        เพราะข้อมูลชุดนี้บอกว่ารายการนั้นคิดผลอย่างไรและต้องวางเดิมพันแบบไหน แทนที่จะเลือกจากคำว่าแตกง่ายเพียงอย่างเดียว
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#d6e2f5]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#6fb4ff]">🎰</span>
          <span><strong class="text-[#8ec5ff]">เกมสล็อตรอบปกติ</strong> เหมาะกับการทำความคุ้นเคยรอบแรก ควรเปิดดูตารางรางวัลและช่วงเดิมพันของเกมก่อนหมุนจริง</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#6fb4ff]">⚡</span>
          <span><strong class="text-[#8ec5ff]">เกมที่มีฟีเจอร์พิเศษ</strong> มีกลไกเพิ่มเติมของตัวเอง จึงควรอ่านเงื่อนไขการเข้าฟีเจอร์ให้เข้าใจก่อนเลือกเล่น</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#6fb4ff]">🔍</span>
          <span><strong class="text-[#8ec5ff]">ระบบค้นหาเกมและเลือกค่าย</strong> ช่วยให้เปรียบเทียบเกมหลายตัวได้เร็วขึ้น ก่อนตัดสินใจว่าจะเริ่มจากรายการไหน</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#6fb4ff]">🧾</span>
          <span><strong class="text-[#8ec5ff]">หน้าเครดิตและประวัติรายการ</strong> ใช้ตรวจสอบยอดคงเหลือและรายการย้อนหลังของตัวเองได้ตลอดเวลา</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#cfd8e6]">
        ส่วนเรื่อง<strong class="text-[#cfd8e6]">ช่วงเดิมพันขั้นต่ำ</strong> ตัวเลขจริงขึ้นอยู่กับกลไกของเกมและค่ายผู้ให้บริการแต่ละราย จึงควรตรวจสอบตัวเลขบนหน้าเกมก่อนยืนยันรายการทุกครั้ง
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ขั้นตอนเริ่มใช้งาน HIX168 และลองเลือกเกมด้วยตัวเอง" as="h2">
    <div class="flex flex-col gap-4">
      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#d6e2f5]">
        <li class="flex gap-3"><span class="font-bold text-[#6fb4ff]">1.</span> เปิดหน้าสมัคร HIX168 และกรอกข้อมูลตามที่ระบบกำหนด ทำผ่านมือถือหรือคอมพิวเตอร์ได้โดยตรง</li>
        <li class="flex gap-3"><span class="font-bold text-[#6fb4ff]">2.</span> Login เข้าบัญชี ฝากเครดิตผ่านระบบฝากถอนออโต้ และตรวจสอบโปรโมชั่นที่มีสิทธิ์รับ</li>
        <li class="flex gap-3"><span class="font-bold text-[#6fb4ff]">3.</span> เลือกค่ายและค้นหาเกมสล็อตที่สนใจ แล้วเปิดดูกติกาของเกมก่อนเริ่มหมุน</li>
        <li class="flex gap-3"><span class="font-bold text-[#6fb4ff]">4.</span> ดูตารางรางวัลและช่วงเดิมพันที่เกมรองรับ เพื่อให้เข้าใจว่าผลคิดจากอะไร</li>
        <li class="flex gap-3"><span class="font-bold text-[#6fb4ff]">5.</span> กำหนดงบประมาณและขนาดเดิมพันที่รับได้ ก่อนเปลี่ยนมาเล่นด้วยเครดิตจริง</li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#d6e2f5]">
        ก่อนเริ่มเดิมพันจริงควรแบ่งงบออกเป็นหน่วยย่อยไว้ล่วงหน้า เช่น มีทุน 1,000 บาท ให้คิด 1 หน่วยเท่ากับ 10 บาท แล้ววางขนาดเดิมพันให้อยู่ในระดับที่รับความผันผวนได้ วิธีนี้
        <strong class="text-[#8ec5ff]">ไม่ได้ทำให้เกมจ่ายรางวัลมากขึ้น แต่ช่วยให้รู้ล่วงหน้าว่าแต่ละรอบใช้เงินได้เท่าไร</strong>
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="สิ่งที่ควรตรวจสอบก่อนเปลี่ยนมาเดิมพันด้วยเครดิตจริง" as="h2">
    <div class="flex flex-col gap-4">
      <ul class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#d6e2f5]">
        <li class="flex gap-3">
          <span class="text-[#6fb4ff]" aria-hidden="true">•</span> หน้านี้อธิบายการใช้งานและการลองเลือกเกมเท่านั้น การเล่นจริงต้องสมัครสมาชิกและฝากเครดิตผ่านช่องทางที่เปิดให้บริการก่อน
        </li>
        <li class="flex gap-3">
          <span class="text-[#6fb4ff]" aria-hidden="true">•</span> เปิดอ่านกติกา ค่า RTP และช่วงเดิมพันของเกมให้ครบ เพราะเกมแต่ละตัวและแต่ละค่ายไม่ได้ใช้เงื่อนไขเดียวกัน
        </li>
        <li class="flex gap-3">
          <span class="text-[#6fb4ff]" aria-hidden="true">•</span> ตรวจสอบช่องทางฝากเงิน ยอดขั้นต่ำ และวงเงินต่อรายการล่าสุดบนหน้าเว็บไซต์ก่อนยืนยันธุรกรรมทุกครั้ง
        </li>
        <li class="flex gap-3">
          <span class="text-[#6fb4ff]" aria-hidden="true">•</span> ตั้งจุดหยุดเมื่อเสียและจุดที่จะพักเมื่อได้กำไรไว้ตั้งแต่ก่อนเริ่ม แล้วหยุดตามแผน ไม่เพิ่มเดิมพันเพื่อไล่เอาเงินคืน
        </li>
        <li class="flex gap-3">
          <span class="text-[#6fb4ff]" aria-hidden="true">•</span> อ่านเงื่อนไขโปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ก่อนกดรับทุกครั้ง และไม่เปิดเผยรหัสผ่านหรือ OTP ให้ผู้อื่น
        </li>
        <li class="flex gap-3">
          <span class="text-[#6fb4ff]" aria-hidden="true">•</span> เรื่องรอบรับโบนัสและยอดที่ใช้คำนวณ ให้ยึดเงื่อนไขล่าสุดที่แสดงในหน้าโปรโมชั่นเป็นหลัก เพราะแต่ละรายการกำหนดไว้ไม่เท่ากัน
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#d6e2f5]">
        หากพบปัญหาเรื่องการสมัคร Login ไม่ได้ ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง โปรโมชั่นไม่แสดง หรือเข้าเกมสล็อตไม่ได้ แจ้งแอดมิน HIX168 พร้อมเวลา จำนวนเงิน และรายละเอียดของรายการได้ตลอด 24
        ชั่วโมง และหากเป็นเรื่องธุรกรรมควรเก็บหลักฐานรายการไว้จนกว่าการตรวจสอบจะเสร็จสิ้น โดย
        <strong class="text-[#8ec5ff]">การเดิมพันมีความเสี่ยง ควรกำหนดงบประมาณให้เหมาะสมทุกครั้ง</strong>
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก HIX168"
          class="flex items-center justify-center rounded-lg border border-[#1e7bf5]/70 bg-gradient-to-r from-[#cfe4ff] via-[#1e7bf5] to-[#0a3fa8] px-8 py-3 font-black text-[#02060f] shadow-[0_0_15px_rgba(30,123,245,0.4)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ HIX168"
          class="flex items-center justify-center rounded-lg border border-[#1e7bf5]/60 bg-transparent px-8 py-3 font-bold text-[#8ec5ff] transition-all hover:scale-105 hover:border-[#6fb4ff] hover:bg-[#0d1730]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>

  <Navfoot />
</MainLayout>
