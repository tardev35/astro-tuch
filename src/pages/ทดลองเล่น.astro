---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";

import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login,
// /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx
// ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บน
// ข้อเท็จจริงของ หวย365 เท่านั้น (src/assets/content.txt)
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
//
// หวย365 เป็น **เว็บแทงหวยออนไลน์** แง่มุมที่บรีฟระบุไว้มีเท่านี้: รวมแนวทางหวย
// กลุ่มหวย สถิติหวยย้อนหลัง และผลหวยตามรอบที่ประกาศไว้ในหน้าเดียว · รายการหวยคือ
// รัฐบาลไทย ฮานอยหลายรอบ ลาวพัฒนา และหวยหุ้นต่างประเทศตามตลาดที่เปิดให้บริการ ·
// ตรวจสอบเวลาเปิดรับ เวลาปิดรับ อัตราจ่าย และผลของแต่ละรายการได้ก่อนเลือกแทง ·
// เลือกเลข ส่งโพย ตรวจสอบรายการผ่านมือถือ · 2 ตัว จ่าย 100 บาท · 3 ตัว จ่าย
// 1,000 บาท · สมัคร 3 ขั้นตอน · แอดมิน 24 ชั่วโมง · PIN/OTP ห้ามเปิดเผย
//
// ⚠️ แบรนด์ก่อน (NATO168) เป็น **เว็บสล็อต/พีจี** คนละสินค้ากันทั้งหน้า — ย่อหน้าและ
// รายการของสล็อต (สล็อตพีจี ค่ายเกม วงล้อ ฟรีสปิน ตัวคูณ ปั่น หมวดโบนัสไทม์ คืนยอด
// เสีย 0.3% แนะนำเพื่อน 0.8% รับโบนัสทุกยูส/ไม่มีล็อคยูส) ถูกถอดออกทั้งหมด ห้ามนำ
// กลับมา ตัวเลขที่อ้างได้มีแค่ 2 ตัว จ่าย 100 บาท · 3 ตัว จ่าย 1,000 บาท ·
// 3 ขั้นตอน · 24 ชั่วโมง และห้ามเพิ่มใบอนุญาต ชื่อผู้ให้บริการ ชื่อธนาคาร
// ยอดฝากขั้นต่ำ จำนวนสมาชิก ปีที่ก่อตั้ง หรือเวลาออกรางวัลที่บรีฟไม่ได้ระบุ
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามี "โหมดทดลอง" เครดิตทดลอง โพยทดลอง หรือเกมเดโมเป็นบริการ
// ของเว็บ — จึงห้ามสัญญาสินค้าตัวนั้น และห้ามดึง src/assets/gamedemo*.webp กลับมา
// (ไฟล์ชุดนั้นลงวันที่ 2026-08-04 เป็นอินเวนทอรีเก่า ไม่ใช่อาร์ตเวิร์กของดรอปนี้
// และเป็นภาพเกมสล็อตซึ่งไม่เข้ากับเว็บหวยอยู่แล้ว)
// หน้านี้จึงพูดถึงเฉพาะสิ่งที่บรีฟระบุไว้ตรง ๆ ว่าควรทำก่อนยืนยันรายการ นั่นคือ
// "ตรวจสอบเวลาเปิดรับ เวลาปิดรับ อัตราจ่าย และผลของแต่ละรายการก่อนเลือกแทง" และ
// "ควรยึดรายละเอียดล่าสุดในหน้าส่งโพยก่อนยืนยันรายการ" = ไล่ดูระบบให้ครบก่อนส่งโพย
// รอบจริง ไม่ใช่การแทงฟรี
//
// เฮดจ์ของบรีฟที่ห้ามตัดทิ้ง: ข้อมูลสถิติช่วยย้อนดูผลรอบที่ผ่านมา แต่ไม่สามารถใช้
// ยืนยันหรือรับประกันเลขที่จะออกในงวดถัดไปได้ · แนวทางหรือสถิติย้อนหลังเป็นเพียง
// ข้อมูลประกอบ ไม่ได้เพิ่มความแน่นอนในการทายผลหวยรอบถัดไป · แต่ละรายการอาจกำหนด
// อัตราจ่ายหรือวงเงินแตกต่างกัน · ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: banner1/banner1-mobile/og.png เป็นของ glob ที่
// MainLayout ปักไว้ ห้ามอ้างจากหน้า · slide1/slide2 ของดรอปนี้เป็นของ index และ
// /promotion · slide3/slide4/banner2/banner3 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น AnnouncementHuay ทั้งเว็บ (รอบก่อน NATO168 ใช้
// Announcement5) — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ
// หวย365 แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรง
// กันทั้งเว็บ
//
// พาเลตต์ หวย365 (brand-spec §2) **แดงสด-ทอง-ดำ** เพราะเวิร์ดมาร์กเป็นคำว่า หวย
// สีแดงสดคู่กับเลข 365 สีดำ บนฉากผ้าซาตินแดงและเหรียญทอง: แดงแบรนด์ #dc0203
// (ขอบ แถบ) · แดงสว่าง #f5282a (active/hover) · แดงลึก #8c0402 (เงา) · ทองอ่อน
// #ffeab0 (ต้นไล่เฉด ตัวอักษรปุ่มรอง) · ทองแบรนด์ #ffc93c (จุด bullet marker
// หมึกเน้น) · ทองลึก #c08a07 (ขอบ ปลายไล่เฉดปุ่มหลัก) · พื้นยกระดับ #3a0a0c ·
// พื้นการ์ด #240406 · หมึกบนพื้นทอง #1a0303 · เนื้อความ #f6e7e0 (BRAND_TEXT)
// ชุดทอง-เงินของ NATO168 (#edb543 #fde8a8 #a9761f #e6e6e6 #101010 #17120a #1a1203
// #f4ead3 rgba(237,181,67,*) rgba(4,3,0,*)) ออกครบทุกจุดแล้ว
// กฎคอนทราสต์: พื้นทอง → หมึกเข้ม #1a0303 เสมอ ไล่เฉดปุ่มทองจบที่ #c08a07 เท่านั้น
// และห้ามวางหมึกทองอ่อนบนพื้นแดง
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// — การ์ดตั้งสีเนื้อความ #f6e7e0 ไว้ที่ตัวการ์ดแล้ว ย่อหน้าจึงไม่ใส่คลาสสีซ้ำ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 152
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่นหวย ${BRAND_NAME} ด้วยการไล่ดูรายการหวยที่เปิดรับ เวลาเปิดรับ เวลาปิดรับ และอัตราจ่ายให้ครบก่อนส่งโพยรอบจริง พร้อมจุดที่ควรตรวจในหน้าส่งโพยได้ทุกครั้ง`;

const pageTitle = `ทดลองเล่นหวย ${BRAND_NAME} ไล่ดูรายการหวย เวลาปิดรับ และอัตราจ่ายก่อนส่งโพยรอบจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed">
        <strong class="text-[#ffc93c]">{BRAND_NAME}</strong> รวมข้อมูลและรายการหวยไว้ในหน้าเดียว
        <strong class="text-[#ffc93c]">ทั้งแนวทางหวย กลุ่มหวย สถิติหวยย้อนหลัง และผลหวยตามรอบที่ประกาศ</strong>
        หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับการแทงหวยออนไลน์ได้ไล่ดูระบบให้ครบหนึ่งรอบ ตั้งแต่ตารางรายการที่เปิดรับ ไปจนถึงหน้าส่งโพยของรอบที่สนใจ ก่อนจะยืนยันรายการจริง
      </p>

      <p class="text-left text-base leading-relaxed">
        คำว่า ทดลองเล่น ที่หน้านี้พูดถึงจึงหมายถึง
        <strong class="text-[#ffc93c]">การตรวจสอบเวลาเปิดรับ เวลาปิดรับ อัตราจ่าย และผลของแต่ละรายการให้ครบก่อนเลือกแทง</strong>
        ตามที่เว็บไซต์แนะนำไว้เอง ไม่ใช่การลุ้นผลรางวัล เมื่อ Login แล้วสามารถเลือกประเภทหวย เลือกรอบ เลือกเลข และตรวจสอบรายการที่ส่งไว้จากบัญชีเดียวได้ทั้งบนมือถือและคอมพิวเตอร์
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`รายการหวยของ ${BRAND_NAME} ที่ไล่ดูได้ก่อนส่งโพยรอบจริง`} as="h2">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed">
        หลัง Login สามารถเลือกรายการหวยที่ระบบเปิดรับในแต่ละวันได้จากบัญชีเดียว
        <strong class="text-[#ffc93c]">รายการในระบบมีหลายประเภทและแต่ละประเภทก็ไม่ได้ใช้รอบเวลาหรืออัตราจ่ายชุดเดียวกัน</strong>
        การเปิดเทียบกันก่อนจึงช่วยให้เห็นว่ารอบไหนกำลังเปิดรับอยู่ และเหมาะกับการเริ่มจากรายการที่ติดตามเวลาได้ง่ายที่สุด
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ffc93c]">🏛️</span>
          <span>
            <strong class="text-[#ffc93c]">หวยรัฐบาลไทย</strong> เปิดรับตามกำหนดออกรางวัลของแต่ละงวด เป็นรายการที่รอบเวลาคาดเดาได้ชัดที่สุด จึงเหมาะกับการใช้ทำความคุ้นเคยกับหน้าส่งโพยเป็นรายการแรก
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ffc93c]">🕒</span>
          <span>
            <strong class="text-[#ffc93c]">หวยฮานอย</strong> มีให้ติดตามหลายรอบในหนึ่งวัน เวลาเปิดรับและเวลาปิดรับของแต่ละรอบจึงไม่เท่ากัน ควรดูจากตารางที่ระบบแสดงไว้ทุกครั้งก่อนเลือกเลข
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ffc93c]">🎫</span>
          <span>
            <strong class="text-[#ffc93c]">หวยลาวพัฒนา</strong> เปิดรับตามรอบที่ประกาศ สมาชิกตรวจสอบเวลาเปิดรับ เวลาปิดรับ และผลของรอบนั้นได้จากหน้าเว็บไซต์โดยตรงก่อนตัดสินใจ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ffc93c]">📈</span>
          <span>
            <strong class="text-[#ffc93c]">หวยหุ้นต่างประเทศ</strong> ขึ้นอยู่กับตลาดที่เปิดให้บริการในแต่ละวัน เป็นกลุ่มที่รายการเปลี่ยนไปตามรอบมากที่สุด จึงควรเช็กว่ารอบที่สนใจยังเปิดรับอยู่หรือไม่
          </span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed">
        <strong class="text-[#ffc93c]">รายการที่เปิดรับและรอบเวลาของแต่ละวันไม่ได้เหมือนกันเสมอ</strong>
        ก่อนแทงจึงควรตรวจสอบว่ารายการที่สนใจยังเปิดรับอยู่หรือไม่ และหากมีรายการเพิ่มเข้ามาระหว่างวัน ให้ดูจากตารางหวยและผลของแต่ละรอบที่ระบบแสดงไว้เป็นหลัก
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/ตรวจหวย"
          aria-label={`เปิดหน้าตรวจผลหวยของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#dc0203]/55 bg-[#3a0a0c] px-8 py-3 font-bold text-[#ffeab0] transition-all hover:scale-105 hover:border-[#f5282a] hover:bg-[#240406] hover:text-[#ffc93c]">
          ไปหน้าตรวจผลหวย
        </a>

        <a
          href="/แนวทาง"
          aria-label={`เปิดหน้าแนวทางหวยของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#dc0203]/55 bg-[#3a0a0c] px-8 py-3 font-bold text-[#ffeab0] transition-all hover:scale-105 hover:border-[#f5282a] hover:bg-[#240406] hover:text-[#ffc93c]">
          ไปหน้าแนวทางหวย
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="จุดที่ควรตรวจให้ครบก่อนยืนยันโพยรอบจริง" as="h2">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed">
        การไล่ดูระบบมีประโยชน์ที่สุดเมื่อมองมันเหมือนการอ่านรายละเอียดของรอบนั้นให้จบก่อน
        <strong class="text-[#ffc93c]">เป้าหมายคือรู้เวลาปิดรับและอัตราจ่ายของรายการที่จะแทงให้ครบก่อนที่เงินจริงจะเข้ามาเกี่ยวข้อง</strong>
        เรื่องด้านล่างคือสิ่งที่ควรเก็บข้อมูลไว้ระหว่างเปิดดู และควรตรวจซ้ำทุกครั้งที่เปลี่ยนไปแทงรายการอื่น
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ffc93c]">⏰</span>
          <span>
            <strong class="text-[#ffc93c]">เวลาเปิดรับและเวลาปิดรับของรอบนั้น</strong> เป็นสิ่งแรกที่ควรดู เพราะแต่ละประเภทหวยและแต่ละรอบไม่ได้ปิดรับพร้อมกัน การอ่านผิดตรงนี้ทำให้ส่งโพยไม่ทันรอบที่ตั้งใจไว้
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ffc93c]">💵</span>
          <span>
            <strong class="text-[#ffc93c]">อัตราจ่ายของรายการที่กำลังจะแทง</strong> ควรดูให้ชัดก่อนเลือกเลข อัตรา 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท ใช้กับรายการที่เข้าเงื่อนไข เนื่องจากบางรายการอาจกำหนดอัตราหรือวงเงินแตกต่างกัน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ffc93c]">📝</span>
          <span>
            <strong class="text-[#ffc93c]">เลขที่เลือก ยอดเดิมพัน และรอบหวยในโพย</strong> ควรไล่ตรวจอีกครั้งก่อนกดยืนยัน เพราะเป็นสามจุดที่แก้ไม่ได้หลังส่งรายการไปแล้ว และเป็นข้อมูลที่ต้องใช้เวลาแจ้งแอดมินด้วย
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ffc93c]">📊</span>
          <span>
