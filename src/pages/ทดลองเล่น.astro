---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login, /register)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อของ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริง
// ของ PKG44 เท่านั้น
//
// รอบก่อน (BRAZIL999) เป็นแบรนด์คาสิโน บรีฟของมันระบุ "คาสิโนแท้จากบริษัทโดยตรง"
// และ "ไม่มีประวัติโกง ตรวจสอบได้" ไว้ ซึ่งบรีฟของ PKG44 ไม่ได้ระบุเลยสักคำ —
// ทั้งหมดถูกถอดออกทั้งหน้า และเขียนใหม่บนข้อเท็จจริงของ PKG44 คือ เกมปั่นสล็อต
// จากหลายค่ายในระบบเดียว รูปแบบการเชื่อมต่อ API และข้อมูลลิขสิทธิ์จากเจ้าของ
// ห้าม find-and-replace ชื่อแบรนด์ทับของเดิม มันจะทำให้ PKG44 อ้างว่าเป็นคาสิโน
// และอ้าง "ไม่มีประวัติโกง" ซึ่งเป็นคำของแบรนด์ก่อนหน้า
//
// บรีฟไม่ได้ระบุว่ามีโหมดเดโมหรือเครดิตทดลองที่ถอนไม่ได้ สิ่งที่บรีฟระบุคือ
// "รวมเกมปั่นสล็อตจากหลายค่ายไว้ในระบบเดียว" "เมนูแบ่งหมวดหมู่ชัดเจน" "เลือกเกม
// ได้หลายแนว ทั้งสล็อตยอดนิยม เกมโบนัส และเกมใหม่ที่อัปเดตตามช่วงเวลา" "ตรวจสอบ
// ชื่อค่าย รายละเอียดเกม และข้อมูลที่เกี่ยวข้องก่อนเริ่มเล่น" "รองรับมือถือและ
// คอมพิวเตอร์" — หน้านี้จึงเขียนบนฐานนั้น คือการไล่ดูเมนู ค่าย และรายละเอียดเกม
// ให้ครบก่อนเดิมพันด้วยเงินจริง ห้ามอ้างกติกาของเครดิตทดลองหรือโหมดเล่นฟรี
//
// ข้อเท็จจริงทุกบรรทัดมาจากบรีฟรอบนี้เท่านั้น (brand-spec §4/§5): เกมปั่นสล็อต ·
// สล็อตหลายค่ายในระบบเดียว · รูปแบบการเชื่อมต่อ API · ข้อมูลลิขสิทธิ์จากเจ้าของ/
// ผู้ให้บริการ · สล็อตยอดนิยม เกมโบนัส เกมใหม่ที่อัปเดตตามช่วงเวลา · เมนูแบ่ง
// หมวดหมู่ชัดเจน · บัญชีเดียว · มือถือและคอมพิวเตอร์ · ตรวจสอบชื่อค่ายและ
// รายละเอียดเกมก่อนเริ่มเล่น · ระบบบัญชีสมาชิก · โบนัสแนะนำเพื่อน 0.8% ·
// โบนัสคืนยอดเสีย 0.3% · ยอดที่เข้าเกณฑ์ รอบรับสิทธิ์ รอบคำนวณ เงื่อนไข ·
// สมัครเองได้ใน 3 ขั้นตอน · ติดต่อเจ้าหน้าที่ได้ตลอด 24 ชั่วโมง
// — ห้ามอ้าง บาคาร่า คาสิโนสด เกมโต๊ะ รูเล็ต ไฮโล หวย บอล เครดิตฟรี ชื่อค่าย/
// สตูดิโอเจาะจง ชื่อเกมเจาะจง ค่า RTP เลขใบอนุญาต ปีที่ก่อตั้ง จำนวนสมาชิก
// ชื่อธนาคาร "ฝากถอนออโต้/ไม่มีขั้นต่ำ" หรือการันตีว่าจะชนะ
//
// ศัพท์ช่องทางติดต่อ: บรีฟรอบนี้พูดแค่ "ติดต่อเจ้าหน้าที่ PKG44" เฉย ๆ ไม่ได้ระบุไลน์
// → ในเนื้อความห้ามเขียนว่า "ผ่านช่องทางไลน์/ไลน์แอด/LINE OFFICIAL"
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: แกลเลอรีเดโม 12 การ์ด (gamedemo7..18.webp) ยังอยู่
// บนดิสก์แต่เป็นของแบรนด์อื่น — gamedemo7.webp มีโลโก้ "askmeslot" และ
// gamedemo15.webp มีโลโก้ "askmebet" ของเว็บเจ้าอื่นพิมพ์ทับอยู่ในรูป ส่วน
// gamedemo13.webp เป็นการ์ด "Sexy Slot" ภาพโป๊เปลือย ห้ามนำกลับมา import เด็ดขาด
// (ห้ามลบไฟล์ เป็นอินเวนทอรี) ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ
// verify-build จะแดง
// slide1.png / slide2.png ของดรอปนี้เป็นของ index และ /promotion — ไม่ดึงมาใช้ซ้ำที่นี่
// banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า
// และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กค้างของลูกค้าเจ้าอื่น ห้าม import
//
// Announcement รอบนี้หมุนจาก Announcement2 มาเป็น AnnouncementPremium ทั้งเว็บ —
// default message ของไฟล์นั้นเป็นคอปปี้ของ PKG44 แล้ว จึงเรียกแบบ bare เหมือน
// index.astro ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ PKG44 เป็น **ทองเมทัลลิก + เงินโครเมียม บนพื้นดำ** ตามโลโก้ (P G 44 ทอง /
// K เงินโครเมียม):
// พื้น #080602 · การ์ด #12100a · ผิวยก #2a2110 · ขอบลึก #4a3a12 ·
// ทองแบรนด์ #fdd32a · ทองสว่าง #ffe27a · ทองอ่อนสุด #ffeeb8 · ทองลึก #c8920a ·
// ทองเข้มสุด (ตัวอักษรบนพื้นทอง) #15110a · เงินกลาง #c2c8d0 · เงินสว่าง #f2f4f7 ·
// เงินหม่น #8a9099 · เนื้อความ #efe6d2 (BRAND_TEXT) · เน้นใน strong #fff8e1
// เลขลำดับใน <ol> และไอคอนใน <ul> สลับทอง/เงินให้คู่สีอ่านออกจากหน้าเอง —
// ชุดเขียวมรกตของ BRAZIL999 (#22c55e #7cf25c #b6ff9c #0a6b18 #04380c #0a1a0c
// #123a18 #1c5a26 #040a05 #aab4bf #f1f5f9 #dfeadd #f4fbf2) ถูกแทนครบทุกจุดแล้ว
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลางที่ orchestrator รีธีมรอบนี้) — การ์ดตั้ง
// สีเนื้อความไว้ให้แล้ว ย้ำไว้บนย่อหน้าอีกชั้นเพื่อให้สีของ body copy อ่านออกจาก
// ตัวหน้าเอง และเน้นด้วย #fff8e1 ในคำสำคัญ
//
// ไม่มีลิงก์ /ตรวจหวย หรือ /แนวทาง: PKG44 เป็นเว็บสล็อต สองหน้านั้นอยู่ใน
// src/pages-disabled/ รอบนี้ href ที่ชี้ route ซึ่งไม่มีใน dist/ จะทำให้ build แดง
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 158
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "ทดลองเล่น PKG44 ไล่ดูเกมปั่นสล็อตจากหลายค่ายในระบบเดียว ทั้งสล็อตยอดนิยม เกมโบนัส และเกมใหม่ พร้อมตรวจสอบชื่อค่ายและรายละเอียดเกมให้ครบก่อนเดิมพันด้วยเงินจริง";

const pageTitle = "ทดลองเล่น PKG44 ไล่ดูค่ายสล็อตและรายละเอียดเกมก่อนเดิมพันจริง";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#efe6d2]">
        <strong class="text-[#fff8e1]">PKG44</strong> รวมเกมปั่นสล็อตจากหลายค่ายไว้ในระบบเดียว พร้อมรูปแบบการเชื่อมต่อ API และข้อมูลลิขสิทธิ์ตามที่เว็บไซต์ระบุ หน้านี้จึงเปิดไว้ให้คนที่ยังไม่คุ้นกับระบบได้
        <strong class="text-[#fff8e1]">ไล่ดูเมนู ชื่อค่าย และรายละเอียดเกมให้ครบก่อนเดิมพันด้วยเงินจริง</strong>
        ตั้งแต่โครงของเมนูที่แบ่งหมวดหมู่ไว้ ไปจนถึงข้อมูลที่ระบบแสดงไว้ก่อนกดเข้าเกม
      </p>

      <p class="text-left text-base leading-relaxed text-[#efe6d2]">
        เพราะ<strong class="text-[#fff8e1]">เมนูถูกแบ่งหมวดหมู่ไว้ชัดเจนและรองรับการใช้งานทั้งบนมือถือและคอมพิวเตอร์จากบัญชีเดียว</strong>
        การเปิดดูให้ทั่วก่อนจึงช่วยให้เห็นว่าสล็อตยอดนิยม เกมโบนัส และเกมใหม่ที่อัปเดตตามช่วงเวลาอยู่ตรงไหน สลับไปยังค่ายที่สนใจได้จากจุดใด และต้องตรวจข้อมูลอะไรบ้างก่อนเริ่มเล่นรอบแรก
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ไล่ดูค่ายสล็อตและหมวดเกมของ PKG44 ให้ครบก่อนเลือกเกมแรก" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#efe6d2]">
        จุดที่ช่วยให้เริ่มต้นได้เร็วที่สุดคือ<strong class="text-[#fff8e1]">เกมสล็อตจากหลายค่ายถูกรวมไว้ให้เลือกจากบัญชีเดียว และเมนูแบ่งหมวดหมู่ไว้ชัดเจน</strong>
        สมาชิกเลือกค่ายหรือหมวดที่สนใจได้ตั้งแต่หน้ารวมเกม แล้วเปิดดูรายละเอียดของเกมนั้นต่อได้ก่อนเริ่มเล่น ไม่ต้องไล่หาว่าเกมที่อยากปั่นอยู่ตรงไหน
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#efe6d2]">
        <li class="flex gap-3">
          <span class="font-bold text-[#ffe27a]">1.</span>
          <span><strong class="text-[#fff8e1]">เปิดหน้ารวมเกมของ PKG44 ก่อน</strong> เมนูแบ่งหมวดหมู่ไว้ชัดเจนตั้งแต่หน้าแรก จึงเห็นภาพรวมของค่ายและหมวดที่เปิดให้เลือกได้ในหน้าเดียว</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#c2c8d0]">2.</span>
          <span>
            <strong class="text-[#fff8e1]">ไล่ดูทีละหมวดให้ครบ</strong> ทั้งสล็อตยอดนิยม เกมโบนัส และเกมใหม่ที่อัปเดตตามช่วงเวลา แต่ละหมวดมีรายการและรูปแบบของตัวเองตามที่เว็บไซต์แสดงไว้
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#ffe27a]">3.</span>
          <span>
            <strong class="text-[#fff8e1]">ตรวจสอบชื่อค่ายและรายละเอียดเกมก่อนเริ่มเล่น</strong> ข้อมูลชุดนี้ระบบแสดงไว้ให้ดูตั้งแต่ก่อนกดเข้าเกม อ่านให้จบก่อนตัดสินใจว่าจะเลือกเกมไหนของค่ายไหน
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#c2c8d0]">4.</span>
          <span>
            <strong class="text-[#fff8e1]">เปิดดูโปรโมชั่นที่เว็บไซต์อัปเดตไว้</strong> ทั้งโบนัสแนะนำเพื่อนและโบนัสคืนยอดเสียมีเงื่อนไขและรอบรับสิทธิ์ของตัวเอง ควรตรวจสอบรายละเอียดก่อนกดรับทุกครั้ง
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#ffe27a]">5.</span>
          <span>
            <strong class="text-[#fff8e1]">ลองเปิดจากเครื่องที่จะใช้จริงอีกครั้ง</strong> ระบบรองรับทั้งมือถือและคอมพิวเตอร์จากบัญชีเดียว เปิดเกมเดียวกันเทียบกันดูก่อน แล้วเลือกอุปกรณ์ที่ใช้งานได้ถนัดกว่า
          </span>
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#efe6d2]">
        <strong class="text-[#fff8e1]">รายชื่อค่ายที่เปิดให้บริการ เกมใหม่ และโปรโมชั่นที่เปิดรับสิทธิ์เปลี่ยนแปลงได้ตามช่วงเวลา จึงควรตรวจสอบรายละเอียดเกมและข้อมูลที่เกี่ยวข้องจากช่องทางอย่างเป็นทางการของเว็บไซต์ทุกครั้งก่อนเริ่มเล่น</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title="จุดที่ควรตรวจให้ครบก่อนเดิมพันด้วยเงินจริง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#efe6d2]">
        การไล่ดูระบบมีประโยชน์ที่สุดเมื่อมองมันเหมือนการอ่านคู่มือ ไม่ใช่การลุ้นรางวัล
        <strong class="text-[#fff8e1]">เป้าหมายคือรู้จักระบบให้ครบก่อนที่เงินจริงจะเข้ามาเกี่ยวข้อง</strong>
        หกเรื่องด้านล่างคือสิ่งที่ควรเก็บข้อมูลไว้ระหว่างเปิดดู
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#efe6d2]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ffe27a]">🗂️</span>
          <span>
            <strong class="text-[#fff8e1]">โครงของเมนูและหมวดหมู่ที่แบ่งไว้</strong> จำให้ได้ว่าสล็อตยอดนิยม เกมโบนัส และเกมใหม่อยู่ตรงไหน และสลับระหว่างค่ายได้จากจุดใด จะได้ไม่ต้องค้นหาใหม่ทุกครั้งที่อยากเปลี่ยนเกม
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#c2c8d0]">🎰</span>
          <span>
            <strong class="text-[#fff8e1]">ชื่อค่ายและรายละเอียดของเกมที่สนใจ</strong> ระบบแสดงข้อมูลชุดนี้ไว้ก่อนเริ่มเล่น เปิดอ่านเทียบกันหลายเกมดูก่อน จะได้เห็นว่ารูปแบบไหนตรงกับที่ตัวเองสนใจ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ffe27a]">📜</span>
          <span>
