---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อของ docx
// ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่
// บนข้อเท็จจริงของ 888PARUAY เท่านั้น
//
// บรีฟรอบนี้ (ดรอป 2026-09-24) คือ "888PARUAY แทงหวย ตรวจหวย เว็บตรงอันดับ1" —
// แบรนด์นี้เป็น **เว็บหวยล้วน** ไม่มีสล็อต ไม่มีบาคาร่า ไม่มีกีฬา คอปปี้ของแบรนด์
// รอบก่อน (ที่พูดถึงบาคาร่า ไพ่ สล็อต และโบนัส 0.8%/0.3%) ถูกเขียนใหม่
// ทั้งหน้าแล้ว ห้ามใช้ find-and-replace กับหน้านี้ มันจะทำให้ 888PARUAY อ้างบริการ
// ที่บรีฟไม่เคยระบุ
//
// บรีฟไม่ได้ระบุว่ามี "เครดิตทดลอง" หรือโหมดเดโมที่ถอนไม่ได้ สิ่งที่บรีฟระบุคือ
// "ระบบจัดหมวดหมู่ชัดเจนและรองรับการใช้งานผ่านมือถือ" กับ "ตรวจสอบตัวเลข ประเภทหวย
// รอบเวลา และอัตราจ่ายได้อีกครั้งก่อนส่งรายการ" — หน้านี้จึงเขียนบนฐานนั้น คือการ
// ไล่ดูรูปแบบการแทงและอัตราจ่ายให้ครบก่อนแทงด้วยเงินจริง ห้ามกลับไปอ้างกติกาของ
// เครดิตทดลองหรือโหมดเล่นฟรี
//
// ข้อเท็จจริงทุกบรรทัดมาจากบรีฟรอบนี้เท่านั้น: หวยรัฐบาลไทย · หวยฮานอย ·
// ลาวพัฒนา · หุ้นต่างประเทศ · ช่วงเวลาเปิดและปิดรับต่างกันตามรอบ · แสดงรอบเปิดรับ
// และข้อมูลผลหวยให้ตรวจสอบได้ · เลือกประเภทหวยและรอบจากหน้าตรวจผล · เลข 2 ตัว
// อัตราจ่าย 100 · เลข 3 ตัวอัตราจ่าย 1,000 · ตรวจสอบตัวเลข ประเภทหวย รอบเวลา และ
// อัตราจ่ายก่อนกดยืนยัน · ระบบจัดหมวดหมู่ชัดเจน · รองรับการใช้งานผ่านมือถือ ·
// สมัครผ่านมือถือ 3 ขั้นตอน · แอดมินออนไลน์ตลอด 24 ชั่วโมง
// — ห้ามอ้างชื่อค่ายเกม เลขใบอนุญาต ปีที่ก่อตั้ง จำนวนสมาชิก อัตราจ่ายอื่นนอกจาก
// 100/1,000 ขั้นต่ำการเดิมพัน "ฝากถอนไม่มีขั้นต่ำ" "ปลอดภัย 100%" หรือการันตีว่า
// จะถูกรางวัล
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: แกลเลอรีเดโม 12 การ์ด (gamedemo7..18.webp) ยังอยู่
// บนดิสก์แต่เป็นของแบรนด์อื่น (mtime 2026-08-04 ไม่ใช่ดรอปรอบนี้) — gamedemo7.webp
// มีโลโก้ "askmeslot" และ gamedemo15.webp มีโลโก้ "askmebet" ของเว็บเจ้าอื่น
// พิมพ์ทับอยู่ในรูป ส่วน gamedemo13.webp เป็นการ์ด "Sexy Slot" ภาพโป๊เปลือย
// ทั้งชุดยังเป็นภาพสล็อตซึ่งไม่ตรงกับแบรนด์หวยล้วนรอบนี้ด้วย ห้ามนำกลับมา import
// เด็ดขาด (ห้ามลบไฟล์ เป็นอินเวนทอรี) ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/
// และ verify-build จะแดง
// slide1.png / slide2.png ของดรอปนี้เป็นของ index และ /promotion — ไม่ดึงมาใช้ซ้ำที่นี่
// banner1/banner1-mobile เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า และ
// banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กค้างของลูกค้าเจ้าอื่น ห้าม import
//
// Announcement รอบนี้หมุนมาใช้ Announcement3 ทั้งเว็บ — default message ของ
// ไฟล์นั้นถูกตั้งเป็นคอปปี้ของ 888PARUAY แล้ว จึงเรียกแบบ bare เหมือน index.astro
// ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ 888PARUAY (ทอง + เขียวเข้ม + แดง): พื้น #07130a · การ์ด #0d2312 ·
// การ์ดยก #143a1c · ทองหลัก #fcdc2b · ทองสว่าง #fff6ae · ทองลึก #a87d0c ·
// เขียวสด #1fae1c · เขียวลึก #0c4402 · แดงสด #cf1111 · แดงลึก #8a0303 ·
// เนื้อความ #e8e4c6 (BRAND_TEXT) — พาเลตต์แดง-ทอง-เงินของแบรนด์รอบก่อนถูกถอด
// ออกครบแล้ว ห้ามนำกลับมา
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลางที่ orchestrator รีธีมรอบนี้) — เนื้อความ
// ในการ์ดจึงไม่ระบุสีของตัวเองเลย ให้สืบทอดสีจากการ์ด มีเพียงปุ่ม หมายเลขลำดับ และ
// ไอคอนเท่านั้นที่ถือสีของพาเลตต์
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 151
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "ทดลองแทงหวย 888PARUAY ไล่ดูรูปแบบการแทง รอบเปิดรับของรัฐบาลไทย ฮานอย ลาวพัฒนา หุ้นต่างประเทศ และอัตราจ่าย 2 ตัว 100 กับ 3 ตัว 1,000 ก่อนแทงด้วยเงินจริง";

const pageTitle = "ทดลองแทงหวย 888PARUAY ดูรูปแบบการแทงและอัตราจ่ายก่อนเล่นจริง";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        <strong>888PARUAY</strong> รวมรายการหวยหลายประเภทไว้ในระบบเดียว ทั้งรัฐบาลไทย หวยฮานอย ลาวพัฒนา และหุ้นต่างประเทศ หน้านี้จึงเปิดไว้ให้คนที่ยังไม่คุ้นกับระบบได้
        <strong>ไล่ดูรูปแบบการแทง รอบเปิดรับของแต่ละประเภท และอัตราจ่ายที่ระบบระบุไว้ให้ครบก่อนแทงด้วยเงินจริง</strong>
        ตั้งแต่โครงของหน้าหลัก ไปจนถึงข้อมูลที่ระบบแสดงไว้ในแต่ละรายการ
      </p>

      <p class="text-left text-base leading-relaxed">
        เพราะระบบ<strong>จัดหมวดหมู่ไว้ชัดเจนและรองรับการใช้งานผ่านมือถือ</strong>
        การเปิดดูให้ทั่วก่อนจึงช่วยให้เห็นว่าหวยแต่ละประเภทอยู่ตรงไหน และรู้ล่วงหน้าว่าต้องตรวจข้อมูลอะไรบ้างก่อนกดยืนยันบิลครั้งแรก
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ไล่ดูรายการหวยและรอบเปิดรับของแต่ละประเภท" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        จุดที่ช่วยให้เริ่มต้นได้เร็วที่สุดคือ<strong>ทุกประเภทหวยถูกรวมไว้ในบัญชีเดียว</strong>
        สมาชิกเลือกประเภทที่สนใจได้จากหน้ารวมหวย ดูรอบที่กำลังเปิดรับ แล้วเปิดรายละเอียดของรายการนั้นต่อได้ทันที ไม่ต้องเปลี่ยนไปใช้หลายเว็บไซต์เพื่อไล่หาว่ารายการที่อยากแทงอยู่ที่ไหน
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed">
        <li class="flex gap-3">
          <span class="font-bold text-[#fcdc2b]">1.</span>
          <span><strong>เปิดหน้าหลักของ 888PARUAY ก่อน</strong> ระบบจัดหมวดหมู่ไว้ให้เลือกจากหน้าเดียว จึงเห็นภาพรวมของรายการที่เปิดให้เลือกได้ตั้งแต่หน้าแรก</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#fcdc2b]">2.</span>
          <span>
            <strong>ไล่ดูรายการหวยที่เปิดรับในรอบนั้น</strong> ทั้งรัฐบาลไทย หวยฮานอย ลาวพัฒนา และหุ้นต่างประเทศ แต่ละประเภทมีช่วงเวลาเปิดและปิดรับต่างกันตามรอบที่ระบบกำหนด
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#fcdc2b]">3.</span>
          <span>
            <strong>เปิดดูอัตราจ่ายของประเภทที่สนใจ</strong> ระบบระบุเลข 2 ตัวไว้ที่ 100 และเลข 3 ตัวไว้ที่ 1,000 ตามเงื่อนไขของรายการ อ่านให้จบก่อนตัดสินใจว่าจะแทงแบบไหน
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#fcdc2b]">4.</span>
          <span>
            <strong>ลองเลือกชุดตัวเลขดูก่อนหนึ่งรอบ</strong> ไล่ดูว่าหน้าจอแสดงตัวเลขที่เลือก ประเภทหวย และรอบเวลาไว้ตรงไหนบ้าง จะได้รู้ว่าต้องมองจุดใดตอนทวนบิลจริง
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#fcdc2b]">5.</span>
          <span>
            <strong>ทวนข้อมูลอีกครั้งก่อนยืนยันด้วยเงินจริง</strong> ทั้งประเภทหวย ชุดตัวเลขที่กรอก รอบเวลาของรายการ และอัตราจ่ายที่ระบุไว้ ขั้นตอนนี้คือจุดที่ลดความผิดพลาดได้มากที่สุด
          </span>
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed">
        <strong>รอบที่เปิดรับและรายการที่ใช้งานได้เปลี่ยนแปลงตามช่วงเวลา จึงควรตรวจสอบประเภทหวย รอบเวลา และรายการล่าสุดจากหน้าเว็บไซต์ทุกครั้งก่อนทำรายการ</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title="จุดที่ควรดูให้ครบก่อนแทงหวยด้วยเงินจริง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        การไล่ดูระบบมีประโยชน์ที่สุดเมื่อมองมันเหมือนการอ่านคู่มือ ไม่ใช่การลุ้นรางวัล
        <strong>เป้าหมายคือรู้จักระบบให้ครบก่อนที่เงินจริงจะเข้ามาเกี่ยวข้อง</strong>
        ห้าเรื่องด้านล่างคือสิ่งที่ควรเก็บข้อมูลไว้ระหว่างเปิดดู
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fcdc2b]">🗂️</span>
          <span>
            <strong>โครงของหน้าหลักและตำแหน่งของแต่ละหมวดในเมนู</strong> จำให้ได้ว่าหน้ารวมหวยอยู่ตรงไหน หน้าตรวจผลอยู่ตรงไหน และสลับระหว่างกันได้จากจุดใด จะได้ไม่ต้องหาใหม่ทุกครั้งที่อยากเปลี่ยนรายการ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fcdc2b]">🎫</span>
          <span>
            <strong>รอบเปิดรับของหวยแต่ละประเภท</strong> รัฐบาลไทย หวยฮานอย ลาวพัฒนา และหุ้นต่างประเทศมีช่วงเวลาเปิดและปิดรับต่างกัน ลองเปิดดูให้ครบก่อนว่ารอบไหนเปิดเวลาใด จะได้วางแผนได้ว่าจะติดตามประเภทไหนบ้างในแต่ละวัน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fcdc2b]">💰</span>
          <span>
            <strong>อัตราจ่ายของเลขแต่ละแบบ</strong> ระบบระบุเลข 2 ตัวไว้ที่ 100 และเลข 3 ตัวไว้ที่ 1,000 ตามเงื่อนไขของรายการ ควรเปิดดูของรอบที่กำลังเปิดรับอีกครั้งก่อนตัดสินใจว่าจะแทงรูปแบบใด
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fcdc2b]">🔍</span>
          <span>
            <strong>วิธีตรวจผลของรายการที่ติดตามอยู่</strong> หน้าตรวจผลให้เลือกประเภทหวยและรอบที่ต้องการ ลองเปิดดูไว้ก่อนสักครั้ง จะได้รู้ว่าต้องเลือกอะไรบ้างเมื่อถึงเวลาที่ผลออกจริง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fcdc2b]">📱</span>
          <span><strong>อุปกรณ์ที่จะใช้ทำรายการจริง</strong> ระบบรองรับการใช้งานผ่านมือถือ ลองเปิดหน้ารวมหวยรายการเดียวกันจากเครื่องที่จะใช้จริงดูก่อน แล้วเลือกอุปกรณ์ที่กรอกเลขและตรวจบิลได้ถนัดกว่า</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed">
        <strong>ผลของหวยทุกประเภทตัดสินจากผลรางวัลของรายการนั้น ไม่มีสูตร ไม่มีชุดเลข และไม่มีช่วงเวลาไหนที่รับประกันว่าจะถูกรางวัล</strong>
        ข้อมูลที่เก็บได้จากการเปิดดูระบบช่วยให้เลือกประเภทและวงเงินที่เหมาะกับตัวเองเท่านั้น ไม่ได้ชี้ผลของรอบถัดไป จึงควรกำหนดงบล่วงหน้าและหยุดเมื่อถึงขีดที่ตั้งไว้เสมอ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="สมัครแทงหวย 888PARUAY ผ่านมือถือ 3 ขั้นตอน แล้วเริ่มแทงได้ทันที" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        เมื่อคุ้นเคยกับระบบแล้วและอยากลงสนามจริง <strong>สมัครผ่านมือถือได้ด้วยตัวเอง ขั้นตอนถูกจัดไว้ให้เข้าใจง่ายและใช้เวลาไม่นาน</strong>
