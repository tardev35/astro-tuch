---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";

import { pageGraph } from "../lib/schema";

// HUAY928 is a lottery site, so "ทดลองเล่น" here means walking through the system
// before spending anything: pick a หวย type, pick the รอบ, build a โพย, read the
// อัตราจ่าย/เลขอั้น, and learn the ฝากถอน flow. An older brand rendered a 12-card
// slot provider gallery (gamedemo7..18.webp) on this page — those assets belong to
// a slot brand and are not imported anywhere any more. Do not bring them back: an
// import alone emits the file into dist/, and verify-build fails an image that
// nothing renders.
//
// Every claim below traces to src/assets/content.txt — nothing invented.
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 157.
const pageDescription =
  "หน้าทดลองเล่น HUAY928 สำหรับสมาชิกใหม่ ดูวิธีเลือกประเภทหวยรัฐบาลไทย ลาว ฮานอย ยี่กี่ หุ้น เลือกรอบที่เปิดรับ กรอกเลข และตรวจสอบอัตราจ่ายกับเลขอั้นก่อนส่งโพย";

const graph = pageGraph(Astro, {
  name: "ทดลองเล่น HUAY928 ดูขั้นตอนแทงหวยออนไลน์ก่อนใช้งานจริง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title="ทดลองเล่น HUAY928 ดูวิธีส่งโพยและตรวจอัตราจ่ายก่อนแทงหวยจริง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่น HUAY928 ดูขั้นตอนแทงหวยออนไลน์ก่อนใช้งานจริง" as="h1">
    <div>
      <p class="mb-6 text-left text-base leading-relaxed text-[#d5e3f7]">
        <strong class="text-[#f7d979]">HUAY928</strong> เปิดให้บริการแทงหวยออนไลน์หลายประเภทผ่านระบบเดียว ทั้งหวยรัฐบาลไทย หวยลาว หวยฮานอย หวยยี่กี่ และหวยหุ้น หน้านี้เปิดไว้ให้สมาชิกใหม่ที่ยังไม่คุ้นเคยกับระบบได้
        <strong class="text-[#f7d979]">ดูวิธีเลือกประเภทหวย วิธีส่งโพย และจุดที่ต้องตรวจสอบก่อนยืนยันรายการ</strong> ก่อนเริ่มใช้งานจริงด้วยเครดิตของตัวเอง โดยเลือกเลข ตรวจสอบเรท และส่งโพยผ่านมือถือได้ด้วยตัวเอง
      </p>

      <p class="mb-2 text-left text-base leading-relaxed text-[#d5e3f7]">
        ขอให้เข้าใจตรงกันว่าขั้นตอนในหน้านี้เป็นการอธิบายการใช้งานระบบเท่านั้น
        <strong class="text-[#f7d979]">ไม่ใช่การรับประกันผลรางวัลและไม่สามารถใช้ทำนายผลของรอบใดได้</strong>
        หากติดปัญหาระหว่างใช้งาน สามารถแจ้งแอดมิน HUAY928 พร้อมรายละเอียดและเวลาที่เกิดรายการ เพื่อให้เจ้าหน้าที่ตรวจสอบได้ตรงจุดตลอด 24 ชั่วโมง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ประเภทหวยที่ HUAY928 เปิดรับ และการเลือกรอบก่อนส่งโพย" as="h2">
    <div>
      <p class="mb-4 text-left text-base leading-relaxed text-[#d5e3f7]">
        HUAY928 รวมหวยหลายประเภทไว้ให้เลือกตามรอบที่เปิดรับ ไม่ว่าจะเป็น <strong class="text-[#8fc3ec]">หวยรัฐบาลไทย หวยลาว หวยฮานอย หวยยี่กี่ หรือหวยหุ้น</strong> สมาชิกเลือกประเภทหวยและรอบที่ต้องการ จากนั้นกรอกเลขกับยอดเดิมพันผ่านระบบได้โดยตรง
        รองรับการเดิมพันเลข 2 ตัวและ 3 ตัวตามอัตราจ่ายที่กำหนดของแต่ละรอบ
      </p>

      <p class="mb-2 text-left text-base leading-relaxed text-[#d5e3f7]">
        เนื่องจากรายละเอียดของหวยแต่ละประเภทและแต่ละรอบอาจแตกต่างกัน ก่อนส่งโพยจึงควรดู <strong class="text-[#f7d979]">เวลาเปิด-ปิด อัตราจ่าย เลขอั้น และวงเงินที่ระบบแสดง</strong> ให้ครบเสียก่อน
        ส่วนข้อความว่าไม่จำกัดยอด ให้ยึดวงเงินที่หน้าแทงแสดง ณ เวลาทำรายการเป็นหลัก เพราะเลขบางรายการอาจมีการกำหนดวงเงินเฉพาะ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ขั้นตอนทดลองใช้งานระบบ HUAY928 ด้วยตัวเอง" as="h2">
    <div>
      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#d5e3f7]">
        <li class="flex gap-3"><span class="font-bold text-[#8fc3ec]">1.</span> สมัครสมาชิก HUAY928 และกรอกข้อมูลตามที่ระบบกำหนด โดยทำได้ด้วยตัวเองผ่านมือถือ ไม่ต้องผ่านเจ้ามือ</li>
        <li class="flex gap-3"><span class="font-bold text-[#8fc3ec]">2.</span> Login เข้าบัญชีและฝากเครดิตผ่านช่องทางที่เปิดให้บริการ</li>
        <li class="flex gap-3"><span class="font-bold text-[#8fc3ec]">3.</span> เลือกประเภทหวยและรอบที่ต้องการ ทั้งหวยรัฐบาลไทย ลาว ฮานอย ยี่กี่ และหุ้น แล้วดูรอบที่ยังเปิดให้ส่งโพยอยู่</li>
        <li class="flex gap-3"><span class="font-bold text-[#8fc3ec]">4.</span> กรอกเลขกับยอดเดิมพัน ตรวจสอบเรทที่ระบบแสดง แล้วจึงยืนยันโพย</li>
        <li class="flex gap-3"><span class="font-bold text-[#8fc3ec]">5.</span> หลังส่งโพยกลับมาตรวจสอบเลข ยอดเดิมพัน สถานะรายการ และประวัติโพยได้จากบัญชีสมาชิก</li>
      </ol>

      <p class="mt-4 mb-2 text-left text-base leading-relaxed text-[#d5e3f7]">
        ควรตรวจสอบข้อมูลให้เรียบร้อยก่อนกดยืนยัน เนื่องจาก <strong class="text-[#f7d979]">รายการที่ส่งสำเร็จแล้วอาจไม่สามารถแก้ไขได้ตามเงื่อนไขของระบบ</strong>
        ตัวอย่างการคำนวณตามเรทที่กำหนดไว้คือ 2 ตัวจ่าย 100 และ 3 ตัวจ่าย 1,000 เช่น แทงเลข 2 ตัว 10 บาท เมื่อถูกรางวัลตามเงื่อนไขจะคำนวณเป็น 10 × 100 = 1,000 บาท
      </p>
    </div>
  </ContentBox>

  <ContentBox title="สิ่งที่ควรตรวจสอบก่อนยืนยันโพยด้วยเครดิตจริง" as="h2">
    <div>
      <ul class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#d5e3f7]">
        <li class="flex gap-3">
          <span class="text-[#dfb455]" aria-hidden="true">•</span> หน้านี้อธิบายการใช้งานระบบเท่านั้น การแทงหวยจริงต้องสมัครสมาชิกและฝากเครดิตผ่านช่องทางที่เปิดให้บริการก่อน
        </li>
        <li class="flex gap-3">
          <span class="text-[#dfb455]" aria-hidden="true">•</span> เวลาเปิด-ปิดรับแทงของหวยแต่ละประเภทไม่เท่ากัน ควรดูรอบที่ระบบแสดงอยู่ก่อนเริ่มเลือกเลข
        </li>
        <li class="flex gap-3">
          <span class="text-[#dfb455]" aria-hidden="true">•</span> อัตราจ่าย เลขอั้น และวงเงินรับแทงอาจต่างกันในแต่ละรอบ ให้ยึดตัวเลขที่ระบบ HUAY928 แสดงก่อนยืนยันโพยเป็นหลัก
        </li>
        <li class="flex gap-3">
          <span class="text-[#dfb455]" aria-hidden="true">•</span> ตรวจสอบเลข จำนวนเงิน และรูปแบบการแทงในโพยให้ครบก่อนกดยืนยัน เพราะรายการที่ยืนยันแล้วจะเข้าสู่รอบทันที
        </li>
        <li class="flex gap-3">
          <span class="text-[#dfb455]" aria-hidden="true">•</span> ก่อนฝากถอนควรตรวจชื่อบัญชี จำนวนเงิน และช่องทางให้ถูกต้อง และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
        </li>
        <li class="flex gap-3">
          <span class="text-[#dfb455]" aria-hidden="true">•</span> หาก Login ไม่ได้ ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง หรือส่งโพยไม่สำเร็จ ให้แจ้งแอดมิน HUAY928 พร้อมเวลาและรายละเอียดของรายการ
        </li>
      </ul>

      <p class="mt-4 mb-6 text-left text-base leading-relaxed text-[#d5e3f7]">
        สมาชิกใหม่สอบถามเรื่องรอบหวย เวลาเปิดรับ อัตราจ่าย และวิธีใช้งานระบบก่อนส่งโพยกับแอดมิน HUAY928 ได้ตลอด 24 ชั่วโมง โดย
        <strong class="text-[#f7d979]">การเดิมพันมีความเสี่ยง ควรกำหนดงบประมาณให้เหมาะสมทุกครั้ง</strong>
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก HUAY928"
          class="flex items-center justify-center rounded-lg bg-gradient-to-r from-[#f7d979] via-[#dfb455] to-[#a87a1e] px-8 py-3 font-black text-[#01091b] shadow-[0_0_15px_rgba(168,122,30,0.32)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ HUAY928"
          class="flex items-center justify-center rounded-lg border border-[#a87a1e]/70 bg-transparent px-8 py-3 font-bold text-[#d5e3f7] transition-all hover:scale-105 hover:border-[#dfb455] hover:bg-[#061733]/70">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
