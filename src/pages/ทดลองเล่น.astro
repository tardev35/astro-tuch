---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";

import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login, /register)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อของ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริง
// ของ LOTTO24 เท่านั้น
//
// สองรอบก่อน (PGW44 = สล็อต, SEXYGAME666 = บาคาร่าไลฟ์สด) ขาย "ค่ายสล็อตย่อย"
// "โต๊ะบาคาร่าไลฟ์สด" "เกมคาสิโนสดจากผู้ให้บริการต่างประเทศ" "RTP" — บรีฟของ
// LOTTO24 ไม่ได้ระบุเลยสักคำ ทั้งหมดถูกถอดออกทั้งหน้า และเขียนใหม่บนข้อเท็จจริงของ
// LOTTO24 คือเว็บแทงหวยออนไลน์ ห้าม find-and-replace ชื่อแบรนด์ทับของเดิม
// มันจะทำให้เว็บหวยอ้างเรื่องโต๊ะบาคาร่าและค่ายสล็อต ซึ่งเป็นคำของแบรนด์ก่อนหน้า
//
// บรีฟไม่ได้ระบุว่ามีโหมดเดโม เครดิตทดลอง หรือโพยฟรีที่ถอนไม่ได้ — จึงห้ามสัญญา
// สินค้าตัวนั้น "ทดลองเล่น" ที่หน้านี้หมายถึงการไล่ดูขั้นตอนทำโพย รอบหวยที่เปิดรับ
// และอัตราจ่ายให้ครบก่อนลงเงินจริง ไม่ใช่การหมุนสล็อตเดโมหรือเล่นบาคาร่าฟรี
//
// ข้อเท็จจริงทุกบรรทัดมาจากบรีฟรอบนี้เท่านั้น (brand-spec + content.txt):
// รวมบริการแทงหวยออนไลน์หลายประเภทไว้ในระบบเดียว · อัตราจ่ายระบุชัดเจนทั้งเลข
// 2 ตัวและ 3 ตัว · เลข 3 ตัวสูงสุด 1,000 และเลข 2 ตัว 100 ตามเงื่อนไขของแต่ละ
// รายการ · ไม่ลดเรทตามเงื่อนไขที่กำหนด · ยอดเข้าบัญชีบริษัทโดยตรง ไม่ผ่านม้า ·
// รองรับวอลเลทตามรายการที่ระบบเปิดให้ใช้งาน · ตรวจสอบรายละเอียดบิลก่อนยืนยัน ·
// ระบบสมาชิกติดตามยอด รายการย้อนหลัง และข้อมูลการแทงหวยจากหน้าเดียว ·
// โบนัสแนะนำเพื่อน 0.8% · โบนัสคืนยอดเสีย 0.3% · ยอดที่เข้าเกณฑ์ รอบคำนวณ
// รอบรับสิทธิ์ · สมัครเองผ่านหน้าเว็บได้ 3 ขั้นตอน · ไลน์ 24 ชั่วโมง
// — ห้ามอ้าง สล็อต ค่ายเกม ค่ายสล็อตย่อย RTP บาคาร่า ไลฟ์สด เกมยิงปลา โต๊ะเกม
// เครดิตฟรี ฝากถอนออโต้ ชื่อหวยเจาะจง เวลาปิดรับเจาะจง เลขใบอนุญาต ปีที่ก่อตั้ง
// จำนวนสมาชิก ชื่อธนาคาร หรือการันตีว่าจะถูกรางวัล
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: banner1/banner1-mobile/og.png เป็นของ glob ที่
// MainLayout ปักไว้ ห้ามอ้างจากหน้า · slide1.png/slide2.png ของดรอปนี้เป็นของ index
// และ /promotion ไม่ดึงมาใช้ซ้ำที่นี่ · banner2.png เป็นภาพประกอบบทความของ index
// · banner3/slide3/slide4 เป็นของค้างจากแบรนด์ก่อน ห้าม import (ลำพังการ import
// ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้หมุนจาก Announcement5 มาเป็น AnnouncementHuay ทั้งเว็บ —
// default message ของไฟล์นั้นเป็นคอปปี้ของ LOTTO24 แล้ว จึงเรียกแบบ bare
// เหมือน index.astro ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ LOTTO24 เป็น **แดงนำ + ทองตาม บนพื้นดำ** (หวยไทยคลาสสิก):
// พื้น #000000 · การ์ดแดงเกือบดำ #2a0405 · ผิวแดงเข้ม #7f1d1d · ขอบแดงลึก #b40102 ·
// แดงแบรนด์ #dc2626 · แดงสว่าง #fc2b2c · ทองแบรนด์ #fbbf24 · ทองอ่อน #fde68a ·
// ทองลึก #a16207 · เนื้อความ #f6e2e2 (BRAND_TEXT) · เน้นใน strong #fde68a
// เลขลำดับใน <ol> และไอคอนใน <ul> สลับแดง/ทองให้คู่สีของแบรนด์อ่านออกจากหน้าเอง —
// ชุดชมพู/ม่วงของ SEXYGAME666 (#fa42b5 #ffb3e2 #ec3fae #7d1550 #8b3df3 #c9a4ff
// #4a17a0 #3d1180 #140722 #0f0518 #070109 #12041c #f2dcee #fff2fb
// rgba(250,66,181,*) rgba(139,61,243,*) rgba(4,1,8,*)) ถูกแทนครบทุกจุดแล้ว
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลางที่ orchestrator รีธีมรอบนี้) — การ์ดตั้ง
// สีเนื้อความไว้ให้แล้ว ย้ำไว้บนย่อหน้าอีกชั้นเพื่อให้สีของ body copy อ่านออกจาก
// ตัวหน้าเอง และเน้นด้วย #fde68a ในคำสำคัญ
//
// ไม่มีลิงก์ /ตรวจหวย หรือ /แนวทาง: รอบนี้สองหน้านั้นยังจอดอยู่ใน
// src/pages-disabled/ ตามสวิตช์ของ operator — href ที่ชี้ route ซึ่งไม่มีใน dist/
// จะทำให้ build แดง แม้ LOTTO24 จะเป็นเว็บหวยก็ห้ามลิงก์ไป
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 150
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "ทดลองเล่น LOTTO24 ไล่ดูรอบหวยที่เปิดรับ อัตราจ่ายเลข 2 ตัว 3 ตัว และขั้นตอนทำโพยให้ครบก่อนลงเงินจริง พร้อมจุดที่ควรตรวจในบิลทุกครั้งก่อนกดยืนยันส่งโพย";

const pageTitle = "ทดลองเล่น LOTTO24 ไล่ดูรอบหวยและอัตราจ่ายก่อนส่งโพยจริง";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f6e2e2]">
        <strong class="text-[#fde68a]">LOTTO24</strong> รวมบริการแทงหวยออนไลน์หลายประเภทไว้ในระบบเดียว หน้านี้จึงเปิดไว้ให้คนที่ยังไม่คุ้นกับระบบได้
        <strong class="text-[#fde68a]">ไล่ดูรอบหวยที่เปิดรับ อัตราจ่ายของเลข 2 ตัวและ 3 ตัว และขั้นตอนทำโพยให้ครบก่อนลงเงินจริง</strong>
        ตั้งแต่โครงของเมนูไปจนถึงรายละเอียดที่บิลแสดงไว้ก่อนกดยืนยัน
      </p>

      <p class="text-left text-base leading-relaxed text-[#f6e2e2]">
        คำว่า “ทดลองเล่น” ที่หน้านี้พูดถึงจึงเป็น<strong class="text-[#fde68a]">การเดินให้ครบทุกขั้นของการแทงหวยหนึ่งบิล ตั้งแต่เลือกรอบหวย ใส่เลข ไปจนถึงหน้าสรุปก่อนยืนยัน</strong>
        ไม่ใช่การเล่นเอารางวัล เพราะเมื่อรู้ว่าแต่ละหน้าจอแสดงข้อมูลอะไรไว้แล้ว การส่งโพยจริงรอบแรกจะเหลือแค่การตัดสินใจเรื่องเลขและวงเงิน
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ไล่ดูรอบหวยและอัตราจ่ายของ LOTTO24 ให้ครบก่อนส่งโพยแรก" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f6e2e2]">
        จุดที่ช่วยให้เริ่มต้นได้เร็วที่สุดคือ<strong class="text-[#fde68a]">หวยหลายประเภทถูกรวมไว้ในระบบเดียว และอัตราจ่ายของเลข 2 ตัวกับ 3 ตัวถูกระบุไว้ชัดเจน</strong>
        สมาชิกเลือกรอบหวยที่สนใจได้จากหน้าเดียว แล้วเปิดดูอัตราจ่ายกับเงื่อนไขของรายการนั้นต่อได้ก่อนลงเลข ไม่ต้องไปไล่ถามยอดจ่ายจากคนกลาง
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#f6e2e2]">
        <li class="flex gap-3">
          <span class="font-bold text-[#fc2b2c]">1.</span>
          <span><strong class="text-[#fde68a]">เปิดดูรายการหวยที่ LOTTO24 เปิดรับอยู่ก่อน</strong> ระบบรวมหวยหลายประเภทไว้ที่เดียว จึงเห็นภาพรวมได้ว่ารอบไหนกำลังเปิดรับ และรอบไหนปิดไปแล้วในหน้าเดียว</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#fbbf24]">2.</span>
          <span>
            <strong class="text-[#fde68a]">อ่านอัตราจ่ายของรอบนั้นให้จบ</strong> ตามข้อมูลที่เว็บไซต์กำหนด เลข 3 ตัวจ่ายสูงสุด 1,000 และเลข 2 ตัวจ่าย 100 โดยอัตราจริงและเงื่อนไขอาจแตกต่างกันตามประเภทหวยและรอบที่เปิดรับ
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#fc2b2c]">3.</span>
          <span>
            <strong class="text-[#fde68a]">ลองใส่เลขที่คิดไว้ลงในโพยดูก่อน</strong> ทั้งเลข 2 ตัวและ 3 ตัว เพื่อดูว่าระบบสรุปยอดและอัตราจ่ายของแต่ละรายการออกมาอย่างไร ก่อนตัดสินใจว่าจะลงเท่าไร
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#fbbf24]">4.</span>
          <span>
            <strong class="text-[#fde68a]">ตรวจสอบรายละเอียดบิลทั้งใบก่อนกดยืนยัน</strong> ตัวเลข รอบหวย และยอดรวมอยู่บนหน้าสรุปให้อ่านซ้ำได้ ขั้นตอนนี้คือขั้นที่ควรทำช้าที่สุด เพราะบิลที่ยืนยันแล้วอ้างอิงตามเงื่อนไขของรายการนั้น
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#fc2b2c]">5.</span>
          <span>
            <strong class="text-[#fde68a]">เปิดดูหน้าโปรโมชั่นและบัญชีสมาชิกต่ออีกที</strong> ทั้งโบนัสแนะนำเพื่อนและโบนัสคืนยอดเสียมีเงื่อนไขและรอบรับสิทธิ์ของตัวเอง ควรตรวจสอบรายละเอียดก่อนกดรับทุกครั้ง
          </span>
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#f6e2e2]">
        <strong class="text-[#fde68a]">รอบหวยที่เปิดรับ อัตราจ่ายจริงของแต่ละรายการ และเงื่อนไขของโปรโมชั่นเปลี่ยนแปลงได้ตามช่วงเวลา จึงควรตรวจสอบข้อมูลจากช่องทางอย่างเป็นทางการของเว็บไซต์ทุกครั้งก่อนยืนยันบิล</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title="จุดที่ควรตรวจให้ครบในบิลก่อนกดยืนยัน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f6e2e2]">
        การไล่ดูระบบมีประโยชน์ที่สุดเมื่อมองมันเหมือนการอ่านคู่มือ ไม่ใช่การลุ้นรางวัล
        <strong class="text-[#fde68a]">เป้าหมายคือรู้จักระบบให้ครบก่อนที่เงินจริงจะเข้ามาเกี่ยวข้อง</strong>
        หกเรื่องด้านล่างคือสิ่งที่ควรเก็บข้อมูลไว้ระหว่างเปิดดู
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f6e2e2]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fc2b2c]">🗂️</span>
          <span>
            <strong class="text-[#fde68a]">รอบหวยที่กำลังเปิดรับอยู่</strong> จำให้ได้ว่าแต่ละประเภทอยู่ตรงไหนในเมนู จะได้ไม่ต้องไล่หาใหม่ทุกครั้งที่อยากเปลี่ยนไปลงอีกรอบ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fbbf24]">💰</span>
          <span>
            <strong class="text-[#fde68a]">อัตราจ่ายของเลข 2 ตัวและ 3 ตัวในรอบนั้น</strong> ข้อมูลที่เว็บไซต์กำหนดคือ 3 ตัวสูงสุด 1,000 และ 2 ตัว 100 แต่อัตราจริงและเงื่อนไขต่างกันไปตามประเภทหวยและรอบที่เปิดรับ ควรอ่านของรอบที่จะลงจริงเสมอ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fc2b2c]">🧾</span>
          <span>
            <strong class="text-[#fde68a]">หน้าสรุปบิลก่อนยืนยัน</strong> ทั้งตัวเลขที่ลง รอบหวยที่เลือก และยอดรวม อ่านให้จบก่อนกดยืนยันทุกครั้ง เพราะนี่คือหน้าจอสุดท้ายที่ยังแก้ได้
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fbbf24]">🏦</span>
          <span>
            <strong class="text-[#fde68a]">ช่องทางทำรายการที่ระบบเปิดให้ใช้งาน</strong> ยอดเข้าบัญชีบริษัทโดยตรงโดยไม่ต้องผ่านช่องทางบุคคลอื่น และรองรับวอลเลทตามรายการที่ระบบกำหนด ควรตรวจสอบชื่อบัญชีและรายละเอียดจากช่องทางอย่างเป็นทางการก่อนทำรายการทุกครั้ง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fc2b2c]">🎁</span>
          <span>
            <strong class="text-[#fde68a]">เงื่อนไขของโปรโมชั่นที่กำลังเปิดรับสิทธิ์</strong> ทั้งโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% มีรายละเอียดยอดที่เข้าเกณฑ์ รอบคำนวณ และรอบรับสิทธิ์ให้ตรวจสอบผ่านบัญชีสมาชิกก่อนกดรับทุกครั้ง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fbbf24]">📱</span>
