import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion,
// /login, /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์
// หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ (src/assets/content.txt) ไม่มี
// หมวด "ทดลองเล่น" และไม่มีส่วน SUB-PAGES เลย ทั้งหน้าจึงเขียนจากข้อเท็จจริงและ
// คลังคำของบรีฟรอบนี้ (.claude/brand-spec-ufabet168.md §6)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
//   h1  ทดลองเล่น <แบรนด์> ไล่ดูแทงบอล สล็อต และบาคาร่าก่อนใช้งานจริง
//   h2  ไล่ดูราคาต่อรองฟุตบอล ธีมสล็อต และกติกาบาคาร่าก่อนเริ่ม
//   h2  ตรวจอัตราจ่ายและเงื่อนไขการเดิมพันก่อนทำรายการ
//   h2  ศึกษาเงื่อนไขโปรโมชั่นและช่องทางสอบถามก่อนใช้งานจริง
