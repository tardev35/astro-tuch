---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import popularGamesImage from "../assets/gamedemo8.webp";
import newGamesImage from "../assets/gamedemo16.webp";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริง
// ของบรีฟรอบนี้เท่านั้น (src/assets/content.txt) ไม่ใช่แก้ทับประโยคของแบรนด์ก่อน
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0 (ผังเดิมของหน้า คงไว้)
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// ⚠️ ดรอปนี้ (2026-10-17) คือ **เว็บเกมสล็อตล้วน** ไม่ใช่หมวดอื่นใดทั้งสิ้น
// หน้าเดิมทั้งหน้าเขียนบนกรอบหมวดเกมคนละชุดของแบรนด์ก่อน ซึ่ง **บรีฟรอบนี้ไม่เอ่ยไว้
// เลยสักคำ** หมวดเกมทั้งชุดของรอบก่อนจึงถูกถอดทิ้ง และเขียนประโยคขึ้นใหม่จากบรีฟ
// ไม่ใช่ find-and-replace ทับของเดิม (คำต้องห้ามไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep
// หาคำต้องห้ามเจอ false positive — รายการเต็มอยู่ใน brand-spec §7) · สองหน้าของ
// หมวดที่แบรนด์ก่อนๆ เคยเปิดจอดอยู่ใน src/pages-disabled/ ไม่มี route ห้ามลิงก์ไปหา
// เป็น href ตายที่ทำให้ build แดง
//
// ⚠️ บรีฟรอบนี้ **ไม่ได้เอ่ยถึงโครงสร้างพื้นฐาน เอกสารรับรอง ผู้พัฒนาเกม สถาบัน
// การเงิน หรือยอดขั้นต่ำใดๆ** จึงห้ามพูดถึงทั้งหมด สิ่งที่บรีฟให้มาคือ "ควรตรวจสอบ
// ชื่อโดเมนและข้อมูลผู้ให้บริการ" กับ "ควรตรวจสอบข้อมูลติดต่อจากช่องทางหลัก" เท่านั้น
//
// แง่มุมที่บรีฟรอบนี้รองรับให้หน้าทดลองเล่นพูดถึงมีเท่านี้: เว็บเกมสล็อต ·
// เกมสล็อตสั่งได้ · การเข้าสู่ระบบ · การตรวจสอบบัญชี · การใช้งานเกม · เกมไม่แสดงผล ·
// รายการเครดิตไม่ตรง · ระบบสมาชิก · แจ้งรายละเอียดปัญหา เวลาที่เกิดเหตุ
// ข้อความแจ้งเตือน · ติดตามสถานะการแก้ไขปัญหา · เวลาตอบกลับจริง · หลักฐานประกอบ ·
// ปิดบังข้อมูลสำคัญ · รหัสผ่าน PIN OTP · คืนยอดเสีย 0.3% รอบประจำวัน รอบคำนวณ
// เวลาตัดยอด ยอดที่เข้าเกณฑ์ เกมที่ร่วมรายการ การใช้โบนัส วิธีรับสิทธิ์ ·
// แนะนำเพื่อน 0.8% ไม่จำกัด ลิงก์แนะนำ · ชื่อโดเมน ข้อมูลผู้ให้บริการ
// รหัสผ่านที่คาดเดายาก ยืนยันบัญชี ข้อกำหนด · LINE Official แอดมิน 24 ชั่วโมง ·
// บัญชีปลอม ฝ่ายบริการลูกค้า
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามี "โหมดทดลอง" เครดิตทดลอง หรือเดโมฟรีเป็นบริการของเว็บ —
// จึงห้ามสัญญาสินค้าตัวนั้น คำว่า "ทดลองเล่น" บนหน้านี้จึงหมายถึงสิ่งที่บรีฟระบุไว้
// ตรงๆ ว่าทำได้: เข้าสู่ระบบแล้วไล่ดูเมนูในระบบสมาชิกให้ครบหนึ่งรอบ เปิดเกมสล็อตดูว่า
// แสดงผลปกติไหม ตรวจสอบบัญชีกับรายการเครดิต อ่านเงื่อนไขโปรโมชั่น และรู้ว่าจะแจ้ง
// ปัญหาได้ที่ไหน ก่อนเริ่มใช้งานจริง
//
// ⚠️ รูปในหน้านี้ใช้ได้แค่ gamedemo8 กับ gamedemo16 เท่านั้น — เป็นอาร์ตสต็อกกลาง
// ของเทมเพลต (mtime 2026-08-04) ไม่ใช่อาร์ตเวิร์กของแบรนด์นี้ จึงอยู่ต่อได้ แต่ alt
// ต้องบรรยายภาพจริง และห้ามเอ่ยชื่อแบรนด์ใด เพราะไม่มีชื่อแบรนด์ไหนปรากฏอยู่บนรูป
// ทั้งสองใบ (สีที่ alt บรรยายคือสีที่วาดอยู่บนอาร์ตสต็อกจริง ไม่ใช่สีของพาเลตต์
// รอบนี้ — ห้าม "แก้สี" ใน alt ให้เข้าแบรนด์ เพราะนั่นทำให้ alt บรรยายผิด)
// ส่วน gamedemo7/9/10/11/12/14/15/17/18 มีโลโก้หรือชื่อของผู้ให้บริการ
// เจ้าอื่นพิมพ์ทับอยู่กลางรูป และ gamedemo13 เป็นภาพล่อแหลม — ห้ามนำกลับมาใช้
// เพราะเท่ากับอ้างชื่อที่บรีฟไม่ได้เอ่ย ไฟล์ยังอยู่บนดิสก์ ห้ามลบ เป็นอินเวนทอรี
// gamedemo8 ("POPULAR GAME" 600x379) กับ gamedemo16 ("New Game" 650x411)
// ความกว้างที่วาดจริงสูงสุด ~600px ต่อใบ (กริดสองคอลัมน์ในการ์ด) จึงไม่ขยายเกิน
// ต้นฉบับ quality={62} ของสองใบนี้ตั้งไว้ต่ำกว่าค่าปกติ 80 มาตั้งแต่รอบก่อน เพราะ
// อาร์ตมีเกรนละเอียดจนไฟล์ AVIF เคยโตกว่า WebP ของตัวเอง (verify-build จะแดง)
// ห้ามดันกลับขึ้น — เป็นค่าต่อรูป ไม่ใช่การจูนต่อฟอร์แมต
//
// ⚠️ ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 24 ชั่วโมง ส่วนรายการตัวเลข
// และชื่อเฉพาะที่ห้ามแต่งขึ้นเองอยู่ครบใน brand-spec §7 (ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้
// การ sweep หาคำต้องห้ามของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง)
//
// ประโยคกำกับของบรีฟที่ห้ามตัดทิ้ง (เป็นส่วนหนึ่งของคอปปี้ ไม่ใช่ filler):
// ควรตรวจสอบข้อมูลติดต่อจากช่องทางหลักก่อนส่งข้อมูลส่วนตัวทุกครั้ง · ควรตรวจสอบ
// ช่องทางติดต่อและเวลาตอบกลับจริงจากหน้าเว็บไซต์ · หากต้องส่งหลักฐานประกอบ ควรปิดบัง
// ข้อมูลสำคัญที่ไม่จำเป็น · ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น ·
// ควรอ่านเงื่อนไขให้ครบก่อนเข้าร่วม · คำว่าไม่จำกัดควรตรวจสอบรายละเอียดให้ชัดเจน ·
// ควรตรวจสอบชื่อโดเมนและข้อมูลผู้ให้บริการให้ถูกต้องก่อนกรอกข้อมูลส่วนตัว
//
// banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// slide1 ของดรอปนี้เป็นของ index กับ /promotion · banner2/banner3 และ
// slide2/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import (ลำพังการ import
// ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น Announcement3 ทั้งเว็บ (brand-spec §3) orchestrator ตั้ง
// default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare
// ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **แดงมังกรนำ ทองไทยรอง บนพื้นดำอมแดง**
// ⚠️ สองแบรนด์ก่อนหน้าก็เป็นแดงเหมือนกัน และแดงของทั้งคู่ต่างจากรอบนี้แค่หลักเดียว
// "มีแดงอยู่" จึงไม่ใช่ตัวบอกว่าถูกแบรนด์ ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน
// brand-spec §2 (ค่าเดิมไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ
// false positive) สิ่งที่ทำให้รอบนี้ต่างจริงคือ **ทองไทย** กับพื้นดำอมแดง
// ลำดับความลึก: #2c1413 ผิวยก (= การ์ด) / #1f0d0c กลาง / #140706 จม / #290f0f พื้นเพจ
// ลำดับปุ่มสื่อด้วยขั้ว "แดงถม vs ผิวจมขอบแดง": ปุ่มหลักถมแดงไล่เฉด #ff5a5f →
// #fa0513 ขอบ #b90203 หมึก #170504 (4.8:1 บนปลายเข้ม สูงกว่านั้นบนปลายสว่าง) ·
// ปุ่มรองและปุ่มลิงก์ภายในเป็นผิวจม #1f0d0c → #140706 ขอบ #fa0513/55 ตัวอักษร
// #f4ecea · ขอบรูปใช้ทองไทย #e3b23c โปร่ง (ทองเป็นสีขอบที่ §2 อนุญาต และเป็นตัวที่
// แยกรอบนี้ออกจากสองแบรนด์แดงก่อนหน้า) · marker ของลำดับเลขใช้ทองไทย #e3b23c
// (8.9:1 บนผิวการ์ด — เป็นตัวอักษร จึงใช้แดงแบรนด์ไม่ได้ และ #ffadaf สงวนไว้ให้
// <strong> เท่านั้น)
// ⚠️ ห้ามกลับด้าน: พื้นถมแดงต้องใช้หมึกเข้มเสมอ ห้ามขาวหรือแดงอ่อน และ #fa0513
// #b90203 #8c0204 #5b0203 #3c0303 #8a6210 เป็นเส้น ขอบ ออรา และพื้นถมเท่านั้น
// ห้ามถือตัวอักษรทุกขนาด ออราในไฟล์นี้ใช้ rgba(250,5,19,α) และ rgba(227,178,60,α)
// เท่านั้น · รอบนี้ไม่มีโครเมียม ไม่มีม่วง ไม่มีชมพู ไม่มีน้ำเงิน ไม่มีฟ้า
// ไม่มีเขียว ไม่มีส้ม
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #f4ecea)
// ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง ปล่อยให้สืบทอดลงมา
// — มีแค่ปุ่ม ขอบรูป marker ของลำดับเลข และ <strong> ที่ประกาศสี โดย <strong>
// ใช้แดงอ่อน #ffadaf ตัวเดียว (9.8:1 บนผิวการ์ด) และแต่ละ <strong> ครอบ
// "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิด
// แท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 153 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} ไล่ดูระบบเกมสล็อตให้ครบหนึ่งรอบ ตั้งแต่เมนูในระบบสมาชิก การตรวจสอบบัญชีและรายการเครดิต ไปจนถึงเงื่อนไขโปรโมชั่นและช่องทางติดต่อแอดมิน`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ไล่ดูระบบเกมสล็อตให้ครบก่อนเริ่มใช้งานจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#ffadaf]">{BRAND_NAME} เป็นเว็บเกมสล็อตที่เปิดช่องทางติดต่อผู้ให้บริการไว้ให้สอบถามข้อมูลและขอความช่วยเหลือเกี่ยวกับการใช้งาน</strong>
        หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับระบบได้ไล่ดูให้ครบหนึ่งรอบ ตั้งแต่การเข้าสู่ระบบและเมนูในระบบสมาชิก ไปจนถึงการตรวจสอบบัญชี รายการเครดิต และการเปิดดูเงื่อนไขของโปรโมชั่นที่เปิดอยู่
      </p>

      <p>
        คำว่า ทดลองเล่น ที่หน้านี้พูดถึงจึงหมายถึง
        <strong class="text-[#ffadaf]">การไล่ดูว่าเมนูแต่ละอย่างอยู่ตรงไหนและเงื่อนไขของแต่ละรายการเขียนไว้ว่าอย่างไร ก่อนจะเริ่มใช้งานจริง</strong>
        ซึ่งเป็นสิ่งที่ระบบเปิดให้ทำได้อยู่แล้ว ไม่ใช่การแจกเครดิตทดลอง และไม่ใช่การรับประกันผลของรายการใดรายการหนึ่ง
      </p>

      <p>
        อีกเรื่องที่ควรไล่ดูไปพร้อมกันคือขอบเขตของข้อมูลที่เว็บไซต์แจ้งไว้
        <strong class="text-[#ffadaf]">โดยควรตรวจสอบข้อมูลติดต่อจากช่องทางหลักก่อนส่งข้อมูลส่วนตัวทุกครั้ง</strong>
        ไม่ใช่ยึดจากชื่อแบรนด์หรือข้อความที่ส่งต่อกันมาเพียงอย่างเดียว ส่วนการรวมเมนูไว้ในระบบสมาชิกเดียวก็ช่วยให้ตรวจสอบรายการได้สะดวกขึ้นเท่านั้น ไม่ได้เปลี่ยนเงื่อนไขของรายการแต่อย่างใด
      </p>
    </div>
  </ContentBox>

