---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { pageGraph } from "../lib/schema";

// OCZPLUS เป็นแบรนด์ "เกมสล็อต" — ไม่ใช่เว็บรวมหลายหมวดแบบบาคาร่า/ไพ่/หวย/บอล
// อย่างแบรนด์ก่อนหน้า หน้านี้จึงหมายถึงการทำความรู้จักระบบและตัวเกมสล็อตก่อนเดิมพัน
// ด้วยเครดิตจริง: ขั้นตอนเริ่มใช้งาน การตรวจกติกาและช่วงเดิมพันของแต่ละเกม
// โปรโมชั่นที่กดรับสิทธิ์เองได้ผ่านหน้าเว็บ และการติดต่อแอดมินเมื่อติดปัญหา
//
// แบรนด์เก่าเคยวางแกลเลอรี 12 การ์ด (gamedemo7..18.webp) ไว้ที่หน้านี้ ถูกถอดออกไปตั้งแต่
// สิบรอบรีแบรนด์ก่อน และไม่มีการ import แล้ว — อย่านำกลับมา ลำพังการ import ก็ทำให้ไฟล์ถูก
// emit ลง dist/ และ verify-build จะแดงถ้ามีรูปที่ไม่มีใคร render ทั้งชุด
//
// ทุกข้อความอ้างอิงบรีฟของแบรนด์นี้เท่านั้น: ระบบนิเวศการเดิมพันแบบ Portal & Privilege ·
// อินเทอร์เฟซโทนกรมท่าตัดทองเมทัลลิค กราฟิกเกมระดับ Cinematic Lighting ·
// การันตียอดถอนทุกวัน จ่ายเต็มจำนวน ไร้ประวัติการโกง ·
// แจกโบนัสทุกยูสเซอร์แบบไม่ล็อคยูส เกมลิขสิทธิ์แท้ควบคุมด้วยระบบสุ่ม RNG 100% ·
// โปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ·
// ฝาก-ถอนอัตโนมัติภายใน 3-5 วินาที ทุกธนาคารชั้นนำและ TrueMoney Wallet ไม่ต้องส่งสลิป
// ไม่มีขั้นต่ำ ถอนได้ 24 ชั่วโมง ไม่จำกัดจำนวนครั้งและยอดถอนต่อวัน ·
// แพลตฟอร์ม Optimize มาแล้ว เล่นลื่นไม่สะดุด รองรับสมาร์ทโฟนทุกรุ่นทั้ง iOS และ Android ·
// แอดมิน Line Official 24 ชั่วโมง
// ไม่มีการอ้างใบอนุญาต การจดทะเบียน ปีที่ก่อตั้ง จำนวนสมาชิก ตัวเลข RTP การันตีผลกำไร
// หรือชื่อค่ายเกมรายใดที่บรีฟไม่ได้ระบุ
//
// Announcement รอบนี้หมุนมาใช้ Announcement3 ทั้งเว็บ — default message ของไฟล์นั้น
// เป็นข้อความของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ได้
//
// คำเตือนทุกจุดใช้สีแดง #dd3a3f (สีของเครื่องหมายบวกในโลโก้) ไม่ใช่ทอง #d9b45e
// เพื่อให้คำเตือนยังอ่านออกว่าเป็นคำเตือน ไม่ใช่ accent ปกติของแบรนด์
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 156
const pageDescription =
  "หน้าทดลองเล่น OCZPLUS แนะนำวิธีเริ่มใช้งานตั้งแต่สมัครสมาชิก ฝากเครดิตอัตโนมัติ เลือกเกมสล็อตที่ชอบ จนถึงตรวจกติกาและช่วงเดิมพันของแต่ละเกมก่อนลงเดิมพันจริง";

const graph = pageGraph(Astro, {
  name: "ทดลองเล่น OCZPLUS ทำความรู้จักระบบและเกมสล็อตก่อนเดิมพันจริง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title="ทดลองเล่น OCZPLUS ลองใช้ระบบก่อนเดิมพัน เกมสล็อตลิขสิทธิ์แท้ RNG 100%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่น OCZPLUS ทำความรู้จักระบบและเกมสล็อตก่อนเดิมพันจริง" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ccd6e6]">
        <strong class="text-[#f2dc9a]">OCZPLUS</strong> พัฒนาระบบนิเวศการเดิมพันในรูปแบบ Portal &amp; Privilege
        ที่รวมทั้งหน้าอินเทอร์เฟซโทนสีกรมท่าตัดกับสีทองเมทัลลิค และกราฟิกเกมสล็อตที่จัดแสงเงาระดับ Cinematic Lighting ไว้ในบัญชีเดียว
        เกมทุกเกมเป็นเกมลิขสิทธิ์แท้ที่ควบคุมผลด้วยระบบสุ่ม RNG 100% หน้านี้จึงเปิดไว้ให้ผู้เริ่มต้นได้
        <strong class="text-[#f2dc9a]">ทำความคุ้นเคยกับขั้นตอนใช้งาน และตรวจกติกา รอบพิเศษ กับช่วงเดิมพันของแต่ละเกม</strong>
        ก่อนเดิมพันด้วยเครดิตของตัวเอง เพราะรายละเอียดเหล่านี้ต่างกันไปตามเกมและรูปแบบการเดิมพันที่เลือก
      </p>

      <p class="text-left text-base leading-relaxed text-[#ccd6e6]">
        ขอให้เข้าใจตรงกันว่าการทดลองเล่นเป็นการทำความคุ้นเคยกับระบบเท่านั้น
        <strong class="text-[#dd3a3f]">ผลลัพธ์ของเกมไม่สามารถรับประกันกำไรหรือผลชนะได้ทุกครั้ง</strong>
        ควรเลือกเกมจากกติกา รูปแบบการเดิมพัน และงบประมาณที่เหมาะสมกับตนเอง หากติดปัญหาระหว่างใช้งาน แจ้งแอดมิน OCZPLUS ผ่าน Line Official ได้ตลอด 24 ชั่วโมง
        พร้อมชื่อเกม เวลา จำนวนเงิน และรายละเอียดของรายการ เพื่อให้ตรวจสอบได้ตรงจุด
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="เริ่มใช้งาน OCZPLUS ด้วยตัวเองได้ใน 3 ขั้นตอน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ccd6e6]">
        ผู้ใช้งานใหม่เปิดบัญชี OCZPLUS ผ่านระบบอัตโนมัติได้ด้วยตัวเอง ทำผ่านมือถือ แท็บเล็ต หรือคอมพิวเตอร์ก็ได้
        และใช้บัญชีเดียวเข้าเล่นเกมสล็อตบนแพลตฟอร์มได้โดยไม่ต้องสมัครหลายบัญชี เริ่มต้นใช้งานได้เพียง
        <strong class="text-[#f2dc9a]">3 ขั้นตอน</strong> และเป็นลำดับเดียวกันไม่ว่าจะเลือกเล่นเกมไหน
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#ccd6e6]">
        <li class="flex gap-3"><span class="font-bold text-[#d9b45e]">1.</span> สมัครสมาชิกผ่านหน้าเว็บด้วยตัวเอง กรอกข้อมูลตามที่ระบบกำหนดให้ครบและตรงกับบัญชีธนาคารที่จะใช้ทำรายการ เพื่อให้ระบบฝาก-ถอนออโต้ทำงานได้ทันที</li>
        <li class="flex gap-3"><span class="font-bold text-[#d9b45e]">2.</span> เติมเครดิตผ่านระบบธุรกรรมอัตโนมัติที่ประมวลผลภายใน 3-5 วินาที รองรับทุกธนาคารชั้นนำและ TrueMoney Wallet ไม่ต้องส่งสลิปให้แอดมิน และไม่มีขั้นต่ำ</li>
        <li class="flex gap-3"><span class="font-bold text-[#d9b45e]">3.</span> เข้าสู่ระบบหน้า Portal หลัก เลือกเกมสล็อตที่สนใจ ตรวจค่าเดิมพันที่ตั้งไว้ในเกม แล้วเริ่มเข้าเล่นได้ทันที</li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#ccd6e6]">
        หลังเปิดบัญชีเรียบร้อยสามารถตรวจสอบเครดิต ประวัติฝากถอน โปรโมชั่น และรายการใช้งานผ่านหน้าเว็บไซต์ได้โดยตรง
        ควรไล่ดูให้ครบก่อนใช้เครดิตจริง จะช่วยให้เห็นว่ารายการหนึ่งถูกบันทึกและคิดผลมาจากอะไรบ้าง
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ตรวจกติกา อัตราการชนะ และช่วงเดิมพันของแต่ละเกมก่อนยืนยัน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ccd6e6]">
        ข้อมูลที่ควรเปิดดูให้ครบก่อนลงเดิมพันมีอยู่ไม่กี่อย่าง และระบบแสดงไว้ในหน้าเกมให้ตรวจสอบได้อยู่แล้ว
        <strong class="text-[#f2dc9a]">ข้อมูลชุดนี้คือสิ่งที่กำหนดว่ารอบหนึ่งคิดผลอย่างไร</strong> จึงควรอ่านให้จบก่อนตัดสินใจว่าจะลงเท่าไร
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#ccd6e6]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#d9b45e]">🎰</span>
          <span><strong class="text-[#f2dc9a]">กติกาและรอบพิเศษของแต่ละเกมสล็อต</strong> หน้าอธิบายในตัวเกมบอกไว้ว่าสัญลักษณ์ชุดใดนับเป็นรางวัล และรอบพิเศษเปิดเมื่อใด ควรอ่านก่อนเลือกเกม</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#c0202b]">📊</span>
          <span><strong class="text-[#f2dc9a]">อัตราการชนะคุมด้วยระบบสุ่ม RNG 100%</strong> OCZPLUS ใช้เกมลิขสิทธิ์แท้และไม่ปรับลดอัตราการชนะ ไม่มีการล็อคยูสเซอร์ ทั้งลูกค้าเก่าและลูกค้าใหม่มีโอกาสชนะและรับแจ็คพอตเท่าเทียมกัน</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#d9b45e]">🎯</span>
          <span><strong class="text-[#f2dc9a]">ช่วงเดิมพันต่อสปินและวงเงินสูงสุด</strong> แต่ละเกมกำหนดตัวเลขไว้ไม่เท่ากัน ตรวจค่าที่ตั้งอยู่ในเกมก่อนกดยืนยันทุกครั้ง</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#c0202b]">📱</span>
          <span><strong class="text-[#f2dc9a]">กราฟิกระดับพรีเมียมที่ยังเล่นลื่น</strong> แพลตฟอร์มถูกปรับแต่ง (Optimize) มาแล้ว แม้ตัวเกมจะจัดเต็มด้วยเอฟเฟกต์และแสงเงาระดับ Cinematic Lighting ก็เล่นได้ไหลลื่นไม่สะดุด รองรับสมาร์ทโฟนทุกรุ่นทั้ง iOS และ Android</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#ccd6e6]">
        รายชื่อเกมที่พร้อมให้บริการเปลี่ยนแปลงได้ ควรตรวจสอบรายการล่าสุดจากหน้าเลือกเกมในเว็บก่อนเข้าเล่น
        <strong class="text-[#dd3a3f]">ส่วนเงื่อนไข “ไม่มีขั้นต่ำ” หมายถึงการทำรายการฝาก-ถอน ไม่ใช่ช่วงเดิมพันของตัวเกม ซึ่งแต่ละเกมกำหนดค่าต่ำสุด-สูงสุดต่อสปินไว้ต่างกัน จึงควรตรวจสอบตัวเลขเดิมพันที่แสดงในเกมก่อนยืนยันทุกครั้ง</strong>
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ฝาก-ถอนออโต้ กดรับโปรโมชั่นเอง และดูแลความปลอดภัยของบัญชี" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ccd6e6]">
        สมาชิกเติมเครดิตได้เองผ่านระบบฝาก-ถอนอัตโนมัติที่ประมวลผลภายใน 3-5 วินาที รองรับทุกธนาคารชั้นนำและ TrueMoney Wallet และไม่กำหนดขั้นต่ำในการทำรายการ
        <strong class="text-[#f2dc9a]">ทำรายการฝาก ส่งคำขอถอน และตรวจสอบสถานะรายการผ่านบัญชีของตนเองได้โดยตรง</strong>
        ถอนได้ตลอด 24 ชั่วโมงโดยไม่จำกัดจำนวนครั้งและไม่จำกัดยอดถอนสูงสุดต่อวัน ไม่ต้องส่งสลิปให้แอดมิน โดยให้ยึดตัวเลขที่ระบบแสดง ณ เวลาทำรายการเป็นหลัก
      </p>

      <ul class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#ccd6e6]">
        <li class="flex gap-3">
          <span class="text-[#d9b45e]" aria-hidden="true">•</span> โปรโมชั่นแนะนำเพื่อน รับค่าคอมมิชชั่นสูงถึง 0.8% จากทุกยอดการเล่นของเพื่อน เพียงส่งลิงก์แนะนำส่วนตัวให้เพื่อนเข้ามาร่วมสนุก ตรวจสอบจำนวนเพื่อน ยอดที่นำมาคำนวณ และโบนัสที่มีสิทธิ์รับได้หลัง Login
        </li>
        <li class="flex gap-3">
          <span class="text-[#c0202b]" aria-hidden="true">•</span> โปรโมชั่นคืนยอดเสีย 0.3% ในทุกยอดการเล่น ให้เป็นเครดิตสำรองกลับไปแก้มือได้ต่อเนื่อง กดรับสิทธิ์ได้ง่าย ๆ ผ่านหน้าเว็บ จึงควรอ่านวิธีคำนวณและเงื่อนไขล่าสุดก่อนกดรับ
        </li>
        <li class="flex gap-3">
          <span class="text-[#d9b45e]" aria-hidden="true">•</span> หากเครดิตไม่เข้า รายการถอนค้าง หรือสถานะรายการไม่อัปเดต ให้ตรวจสอบประวัติรายการในบัญชีก่อน และเก็บหลักฐานรายการไว้จนกว่าการตรวจสอบจะเสร็จสิ้น
        </li>
        <li class="flex gap-3">
          <span class="text-[#c0202b]" aria-hidden="true">•</span>
          <strong class="text-[#dd3a3f]">ตั้งรหัสผ่านที่คาดเดายาก ไม่ใช้รหัสเดียวกับบริการอื่น และไม่เปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น</strong> รวมถึงตรวจสอบให้แน่ใจว่าเป็นบัญชี LINE OFFICIAL ที่ประกาศไว้บนเว็บไซต์ก่อนส่งข้อมูลใด ๆ
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#ccd6e6]">
        หากพบปัญหาเกี่ยวกับการสมัครสมาชิก Login ไม่ได้ ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง เข้าเกมไม่ได้ หรือโปรโมชั่นไม่แสดง ติดต่อแอดมิน OCZPLUS ผ่าน Line Official ได้ตลอด 24 ชั่วโมง โดยแจ้งรายละเอียดของปัญหา เวลา จำนวนเงิน
        และข้อมูลรายการที่เกี่ยวข้อง <strong class="text-[#dd3a3f]">การเดิมพันมีความเสี่ยง ควรกำหนดงบประมาณให้เหมาะสมทุกครั้ง</strong>
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก OCZPLUS"
