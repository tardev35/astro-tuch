---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion,
// /login, /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์
// หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ (src/assets/content.txt) ไม่มี
// ส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่จากข้อเท็จจริงและคลังคำของบรีฟรอบนี้
// เท่านั้น (.claude/brand-spec-madum168.md §5)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
//   h1  ทดลองเล่น <แบรนด์> ศึกษากติกาเกมและเงื่อนไขโปรโมชั่นก่อนใช้บริการ
//   h2  กติกาเกมสล็อตออนไลน์และข้อกำหนดการรับโบนัสที่ควรเปิดอ่านก่อน
//   h2  โปรโมชั่นคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% มีเงื่อนไขต่างกัน
//   h2  ระบบฝากถอนและช่องทางติดต่อแอดมินที่ควรตรวจก่อนทำรายการ
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// 🚨🚨 **คำว่า "ทดลองเล่น" รอบนี้เหลือรอดได้ที่เดียวคือชื่อ route /ทดลองเล่น**
// (ใช้ใน <h1> · <title> · description · breadcrumb เพื่อบอกว่าหน้านี้คือหน้าไหน)
// บรีฟรอบนี้ **ไม่ได้พูดถึงการเล่นแบบไม่ใช้เงินจริงเลยแม้แต่ประโยคเดียว**
// คำคู่ที่ขึ้นต้นด้วยชื่อ route นี้แล้วลงท้ายด้วย ฟรี / โหมด~ เป็นคำของแบรนด์เก่า
// (คำเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ
// false positive ในคอมเมนต์ของไฟล์นี้เอง) — **ห้ามเขียนกลับเข้ามา**
// แกนของหน้า = **สิ่งที่ควรเปิดอ่านก่อนใช้บริการ** ตามที่บรีฟมีจริง:
// กติกาเกม · ข้อกำหนดการรับโบนัส · เงื่อนไขโปรโมชั่น · ระบบฝากถอน ·
// ช่องทางติดต่อแอดมิน · ประกาศล่าสุด
//
// 🚨 แกนของดรอปนี้คือ **เว็บเกมสล็อตออนไลน์ที่ขายโปรโมชั่นรายวัน** บรีฟเขียนถึง
// ตัวเองว่า เกมสล็อตเปย์แรง · แจกโบนัสสมาชิกทุกวัน ไม่อั้น · ฝากถอนง่าย จ่ายเร็ว ·
// โปรโมชั่นประจำเดือน · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% ·
// ระบบฝากถอนได้ทุกธนาคารและทรูมันนี่ · แอดมิน 24ชม.
// ⚠️⚠️ คำขายของแบรนด์ขาออกและของรอบก่อนหน้านั้น **ห้ามหลงเหลือ** — รายการคำ
// ต้องห้ามเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่แม้แต่คำเดียว เพื่อไม่ให้
// sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// ⚠️⚠️ **ห้ามเขียนชื่อแบรนด์ด้วยตัวละตินเด็ดขาด** (ดู brand-spec §0) — รอบนี้
// สะกดได้แบบเดียวคือค่าใน BRAND_NAME ซึ่งเป็นภาษาไทยผสมเลข ห้ามพิมพ์ตรงๆ
//
// ⚠️⚠️ **สองหน้าหมวดลอตเตอรียังจอดอยู่ใน src/pages-disabled/** → ลิงก์ไปสอง route
// นั้นจะทำให้ build แดง ห้ามเขียนกลับมา
// route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ทดลองเล่น · /about-us · /contact-us · /terms · /privacy · /line
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกม ชื่อธนาคาร ชื่อวอลเล็ต ชื่อผู้ให้บริการ
// หน่วยงานกำกับ ใบอนุญาต ปีก่อตั้ง จำนวนสมาชิก จำนวนเกม ค่าสถิติของเกมที่เป็น
// ตัวเลข หรือยอดขั้นต่ำที่เป็นตัวเลข แม้แต่รายการเดียว** จึงห้ามเขียนลงหน้าเว็บ ·
// ตัวเลขที่ขึ้นหน้าได้มีแค่ของบรีฟเอง: **0.3% · 0.8% · 24ชม.**
// ⚠️ **ไม่มีจำนวนขั้นตอนที่นับเป็นข้อ ไม่มีจำนวนเกม และไม่มีเปอร์เซ็นต์เต็มร้อย
// ในบรีฟรอบนี้**
//
// 🚨 **ข้อกำกับของบรีฟที่ต้อง ship ครบบนหน้านี้** (ไม่ใช่ filler ให้ตัดทิ้ง):
// 1) โปรโมชั่นไม่ได้รับประกันว่าจะได้รับผลกำไรจากการเดิมพัน
// 2) ไม่สามารถรับประกันระยะเวลาหรือจำนวนเงินที่ถอนได้จากข้อความโฆษณาเพียงอย่างเดียว
// 3) การคืนเครดิตไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาส
//    ชนะในครั้งต่อไป · แม้รายการแนะนำเพื่อนจะระบุว่าไม่จำกัด แต่ควรยืนยันจำนวน
//    บัญชีที่เข้าร่วมได้ รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุด
// 4) หากพบชื่อบัญชีไม่ตรงกับข้อมูลทางการหรือมีการแจ้งเปลี่ยนบัญชีอย่างผิดปกติ
//    ควรหยุดทำรายการและติดต่อธนาคารหรือผู้ให้บริการชำระเงินเพื่อตรวจสอบก่อนโอนเงิน
// 5) ไม่เปิดเผยรหัสผ่านหรือรหัส OTP · ควรตรวจสอบเวลาการให้บริการจริงจากประกาศ
//    ล่าสุดอีกครั้ง
// ⚠️ บรีฟไม่ได้การันตีผลลัพธ์ใดๆ — คอปปี้หน้านี้จึงไม่สัญญากำไรและไม่สัญญาว่า
// ถอนได้ชัวร์ · บรีฟรอบนี้ **โฆษณาและกำกับในประโยคเดียวกัน** คำโฆษณา (เปย์แรง ·
// จ่ายไม่มีอั้น · ไม่จำกัด) อยู่ได้เฉพาะในหัวข้อที่บรีฟเขียนไว้เอง ห้ามขยายเป็น
// คำกล่าวอ้างใหม่ และทุกประโยคกำกับต้อง ship ครบ ห้ามตัดเพราะฟังดูลบ
//
// 🚨 **ไม่มีรูปในหน้านี้โดยตั้งใจ** ดรอปนี้ไม่มี article illustration เลย
// (banner2 mtime 10-08 / banner3 mtime 09-27 เป็นของแบรนด์คนละราย) และอาร์ตสต็อก
// gamedemo* ทั้งชุดเป็นฉากโทนทอง-เหรียญ-หีบสมบัติ กับฉากนีออนชมพู ซึ่งเป็นฮิวที่
// brand-spec §2 **ตัดออกจากรอบนี้ทั้งหมดโดยตั้งใจ** ดรอปนี้เป็นแดงคริมสัน +
// น้ำเงินอะซัวร์ บนน้ำเงินเที่ยงคืนเกือบดำ · ไฟล์ gamedemo* ยังอยู่บนดิสก์
// **ห้ามลบ** เป็นอินเวนทอรีของแบรนด์ถัดไป — แต่ห้าม import กลับเข้ามารอบนี้
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/)
// ⚠️ รูปอื่นทั้งหมดห้ามอ้างจากหน้านี้เช่นกัน: slide3/slide4 (600x334 mtime 09-29)
// เป็นอาร์ตเวิร์กของแบรนด์คนละราย · slide1/slide2 ถูกตรึงไว้กับ index กับ
// /promotion · banner1 / banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักไว้
//
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) **ยังเป็นธีมมืดเหมือนรอบก่อน แต่คนละฮิวสิ้นเชิง**
// bg.json ของดรอปนี้คือ {"mode":"color","color":"#00091f"} = น้ำเงินเที่ยงคืนเกือบดำ
// (รอบก่อนเป็น 0d1017 = ถ่านอมน้ำเงินที่เทากว่านี้มาก)
// **ห้ามเดาว่าเท่าเดิม และห้าม "แก้" การ์ดให้สว่าง**
// ค่าที่ใช้ได้ในไฟล์นี้: แดงคริมสัน #ff2e52 (<strong> + marker + ตัวอักษรปุ่ม
// outline — 4.9:1 บนผิวการ์ด ถือตัวอักษรได้) · แดงพื้นปุ่ม #e01238 และแดงลึก
// #c9102f (**ปลายไล่เฉดของปุ่มหลัก ห้ามถือตัวอักษร**) · น้ำเงินอะซัวร์ #0e68cc ->
// #0a4ea8 (**พื้นถมของปุ่มรองเท่านั้น ห้ามถือตัวอักษร**) · #1177e8 (ขอบ/ออรา
// เท่านั้น) · ผิวจม #050e26 และผิวยก #16234a (พื้นปุ่ม/ชิป) · ขอบ #2a3c70
// (**ห้ามถือตัวอักษร**) · ขาว #ffffff (หมึกบนปุ่มหลักและปุ่มรอง)
// หมึกเนื้อความคือ #f4eef1 (= BRAND_TEXT) ซึ่ง **ไม่ประกาศในไฟล์นี้** การ์ด
// ContentBox ตั้งไว้ให้แล้วและย่อหน้าสืบทอดลงมา
// 🚨🚨 **ห้ามใส่หมึกขาวบน #ff2e52 ล้วน** (3.6:1) ไล่เฉดของปุ่มหลักจึงต้องลงไปถึง
// #e01238 / #c9102f ซึ่งเป็นช่วงที่หมึกขาวตกอยู่จริงเกือบทั้งปุ่ม
// ออราที่อนุญาต: rgba(255,46,82,α) · rgba(224,18,56,α) · rgba(201,16,47,α) ·
// rgba(17,119,232,α) · rgba(14,104,204,α) · rgba(10,78,168,α) ·
// rgba(217,223,233,α) · rgba(0,9,31,α) · rgba(0,0,0,α)
// ⚠️ รอบนี้ไม่มีทอง ไม่มีเหลือง ไม่มีส้ม ไม่มีชมพู ไม่มีม่วง ไม่มีน้ำตาล ไม่มีครีม
// ไม่มีเบจ ไม่มีเขียว และ **ไม่มีแรมป์เทาเงิน** (แพลทินัม #d9dfe9 ตัวเดียวที่มี
// เป็นค่าใหม่ของรอบนี้) · ปุ่ม LINE อยู่บน /about-us กับ /contact-us ไม่ใช่หน้านี้
// ⚠️⚠️ **ผมสีขาวเงิน สูทขาวครีม สูทดำ โซฟาหนัง พื้นหินขัด และสีผิวนักแสดงใน
// อาร์ตเวิร์กเป็นวัตถุในภาพ ไม่ใช่สี UI**
// ⚠️⚠️ **ฟ้า/ไซยานผ่านรีโปนี้มาแล้วเจ็ดเจ้า และรอบก่อนหน้าทันทีก็ฟ้านำ** การเจอฟ้า
// ในไฟล์จึงไม่พิสูจน์อะไร — ห้ามเทียบด้วยวงศ์สี ต้องเทียบทีละค่ากับ brand-spec §2
// **แดงก็ผ่านรีโปนี้มาหลายเจ้าเช่นกัน** แดงรอบนี้คือ #ff2e52 / #e01238 / #c9102f
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง และไม่ใส่ mx-auto / max-w-* บน <p>
// เพราะการ์ดคุมความกว้างเองแล้ว — ที่ประกาศสีได้มีแค่ปุ่ม ชิปไอคอน marker ของ
// ลำดับเลข และ <strong> · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง
// เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำ
// จะขาดครึ่ง และห้ามวาง <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังในข้อความของ prop และต้องไม่ใช่สัญลักษณ์ของอาร์ตเวิร์กแบรนด์เก่า
// (กล่องของขวัญ ถุงเงิน มงกุฎ เหรียญทอง หีบสมบัติ ตราชั่ง ธนบัตร ฯลฯ)
//
// Announcement รอบนี้หมุนมาเป็น AnnouncementPremium ทั้งเว็บ (brand-spec §3 —
// รอบก่อนใช้ AnnouncementCyber จึงหมุนออก) orchestrator ตั้ง default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว จึงเรียกแบบ bare **ห้ามส่ง prop message**
// มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 154 อักขระ (ชื่อแบรนด์รอบนี้ 8 ตัวอักษร) เป็นประโยคเดียวที่บอกว่า
// หน้านี้มีไว้ทำอะไร แล้วหยุด
// (Google ตัดราว 155 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนๆ ยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} รวมสิ่งที่ควรเปิดอ่านก่อนใช้บริการ ทั้งกติกาเกมสล็อตออนไลน์ ข้อกำหนดการรับโบนัส เงื่อนไขโปรโมชั่นสมาชิก และขั้นตอนฝากถอนจากประกาศล่าสุด`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ศึกษากติกาเกมและเงื่อนไขโปรโมชั่นก่อนใช้บริการ`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});

// คลาสปุ่มสี่แบบของหน้านี้ ประกาศครั้งเดียวแล้วใช้ซ้ำ เพื่อไม่ให้สองปุ่มที่ทำ
// หน้าที่เดียวกันหลุดไปคนละเฉดตอนรีแบรนด์รอบหน้า
const ctaPrimary =
  "flex items-center justify-center rounded-lg border border-[#c9102f] bg-gradient-to-b from-[#ff2e52] via-[#e01238] to-[#c9102f] px-8 py-3 font-black text-[#ffffff] shadow-[0_6px_18px_rgba(224,18,56,0.35)] transition-transform hover:scale-105";

const ctaSecondary =
  "flex items-center justify-center rounded-lg border border-[#0a4ea8] bg-gradient-to-b from-[#0e68cc] to-[#0a4ea8] px-8 py-3 font-bold text-[#ffffff] shadow-[0_6px_18px_rgba(14,104,204,0.35)] transition-transform hover:scale-105";

const ctaQuiet =
  "flex items-center justify-center rounded-lg border border-[#2a3c70] bg-[#050e26] px-8 py-3 font-bold text-[#ff2e52] shadow-[0_4px_14px_rgba(0,0,0,0.35)] transition-all hover:scale-105 hover:border-[#ff2e52] hover:shadow-[0_6px_18px_rgba(255,46,82,0.25)]";

const ctaOutline =
  "flex items-center justify-center rounded-lg border-2 border-[#ff2e52] bg-[#050e26] px-8 py-3 font-bold text-[#ff2e52] shadow-[0_4px_14px_rgba(255,46,82,0.2)] transition-all hover:scale-105 hover:bg-[#16234a]";

const listChip = "mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#1177e8]/50 bg-[#16234a] text-sm";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#ff2e52]">{BRAND_NAME} นำเสนอเกมสล็อตออนไลน์พร้อมข้อมูลโปรโมชั่นสำหรับสมาชิกที่ต้องการติดตามสิทธิพิเศษในแต่ละวัน</strong>
        ภายในเว็บไซต์มีรายละเอียดเกี่ยวกับเกม การสมัครสมาชิก และช่องทางฝากถอนให้ตรวจสอบก่อนใช้งาน หน้านี้รวบรวมไว้ว่าควรเปิดอ่านอะไรบ้างก่อนตัดสินใจ
      </p>

      <p>
        ผู้ใช้งานควรศึกษากติกาเกมและข้อกำหนดการรับโบนัสให้ครบถ้วน รวมถึงอ่านเงื่อนไขของโปรโมชั่นแต่ละรายการก่อนเข้าร่วม
        <strong class="text-[#ff2e52]">เพราะโปรโมชั่นไม่ได้รับประกันว่าจะได้รับผลกำไรจากการเดิมพัน</strong>
        เนื้อหาในหน้านี้จึงเขียนไว้ประกอบการใช้งานเท่านั้น ไม่ได้ใช้แทนเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้บริการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="กติกาเกมสล็อตออนไลน์และข้อกำหนดการรับโบนัสที่ควรเปิดอ่านก่อน" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#ff2e52]">รายละเอียดเกมและข้อกำหนดการรับโบนัสเป็นสองชุดข้อมูลที่ควรไล่อ่านให้ครบก่อนเลือกเกม</strong>
        เพราะแต่ละรายการระบุเงื่อนไขของตัวเองไว้ไม่เหมือนกัน รายการด้านล่างคือสิ่งที่ควรเปิดดูจากหน้าของเกมนั้นโดยตรง ไม่ใช่สรุปจากเกมอื่นที่เคยเปิดไว้
      </p>

      <ul class="flex flex-col gap-4" aria-label="สิ่งที่ควรเปิดอ่านก่อนเลือกเกมสล็อตออนไลน์">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎰</span>
          <span>
            <strong class="text-[#ff2e52]">กติกาเกมของแต่ละรายการ</strong> เป็นตัวกำหนดว่าผลของแต่ละรอบนับอย่างไร และเงื่อนไขไหนที่ต้องเกิดขึ้นก่อนจึงจะมีผลตามที่ระบุไว้
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📋</span>
          <span>
            <strong class="text-[#ff2e52]">ข้อกำหนดการรับโบนัส</strong> ระบุว่ายอดแบบไหนนำมาคำนวณได้ ต้องกดรับเครดิตด้วยตนเองหรือไม่ และเครดิตที่ได้รับมีเงื่อนไขการใช้งานอย่างไร
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🗓️</span>
          <span>
            <strong class="text-[#ff2e52]">ประเภทเกมที่เข้าร่วมและรอบสรุปยอด</strong> ของแต่ละโปรโมชั่นกำหนดไว้ไม่เท่ากัน จึงควรอ่านเป็นรายรายการก่อนเริ่มเล่นเกมที่ตั้งใจจะนำยอดไปใช้สิทธิ์
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📣</span>
          <span>
            <strong class="text-[#ff2e52]">ประกาศล่าสุดของเว็บไซต์ทางการ</strong> คือจุดที่เงื่อนไขจริงถูกอัปเดต การเปิดดูก่อนทุกครั้งจึงตรงกว่าการจำไว้จากรอบก่อน
          </span>
        </li>
      </ul>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/about-us" aria-label={`อ่านหน้าเกี่ยวกับเราของ ${BRAND_NAME}`} class={ctaQuiet}>อ่านเกี่ยวกับเรา</a>

        <a href="/ทางเข้า" aria-label={`เปิดหน้าทางเข้าของ ${BRAND_NAME}`} class={ctaQuiet}>ไปหน้าทางเข้า</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="โปรโมชั่นคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% มีเงื่อนไขต่างกัน" as="h2">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#ff2e52]">โปรโมชั่นคืนยอดเสีย 0.3% เป็นรายการที่ระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขรายวัน</strong>
        สมาชิกควรตรวจสอบว่าเกมสล็อตประเภทใดเข้าร่วมรายการ มีรอบสรุปยอดเวลาใด และต้องกดรับเครดิตด้วยตนเองหรือระบบดำเนินการให้ รวมถึงศึกษาเงื่อนไขการใช้เครดิตและการถอนเงินให้ครบถ้วน เพราะยอดเสียบางรายการอาจไม่เข้าเกณฑ์รับสิทธิ์
      </p>

      <p>
        <strong class="text-[#ff2e52]">ทั้งนี้ การคืนเครดิตไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งต่อไป</strong>
        ตัวเลขที่ระบุไว้บนภาพโปรโมชั่นเป็นอัตราของรายการนั้น ไม่ใช่ผลลัพธ์ที่รับประกันได้
      </p>

      <p>
        ส่วนโปรโมชั่นแนะนำเพื่อนโบนัส 0.8% เป็นรายการที่ระบุสิทธิ์สำหรับสมาชิกที่แนะนำผู้ใช้งานรายใหม่ โดยควรตรวจสอบวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และฐานยอดที่ใช้คำนวณโบนัสให้ชัดเจน
        <strong class="text-[#ff2e52]">แม้จะมีข้อความว่าไม่จำกัด แต่ควรยืนยันจำนวนบัญชีที่เข้าร่วมได้ รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุด</strong>
        เพื่อป้องกันความเข้าใจคลาดเคลื่อนเกี่ยวกับจำนวนเครดิตที่มีสิทธิ์ได้รับ
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/promotion" aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`} class={ctaOutline}>ดูภาพโปรโมชั่น</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="ระบบฝากถอนและช่องทางติดต่อแอดมินที่ควรตรวจก่อนทำรายการ" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        เมื่ออ่านกติกาเกมและเงื่อนไขโปรโมชั่นครบแล้ว
        <strong class="text-[#ff2e52]">ขั้นถัดไปคือการตรวจระบบฝากถอนและช่องทางติดต่อให้ครบก่อนทำธุรกรรมครั้งแรก</strong>
        รายการด้านล่างควรตรวจซ้ำทุกครั้งที่กลับเข้ามาใหม่ เพราะเงื่อนไขปรับเปลี่ยนได้ตามที่ผู้ให้บริการกำหนด
      </p>

      <ol class="ml-6 list-decimal space-y-3 marker:font-black marker:text-[#ff2e52]">
        <li>
          <strong class="text-[#ff2e52]">รายชื่อธนาคารที่รองรับและทรูมันนี่</strong> ควรดูจากบริการที่เปิดใช้งานอยู่จริง พร้อมตรวจยอดฝากขั้นต่ำ วงเงินถอนสูงสุด และระยะเวลาดำเนินการให้ครบก่อนทำรายการ
        </li>
        <li>
          <strong class="text-[#ff2e52]">ข้อกำหนดการยืนยันตัวตน</strong> ควรอ่านให้จบก่อนฝากเงินครั้งแรก เพราะรายการที่มียอดสูงอาจต้องผ่านขั้นตอนตรวจสอบเพิ่มเติมก่อนทำรายการถอนได้
        </li>
        <li>
          <strong class="text-[#ff2e52]">ชื่อบัญชีปลายทางของผู้ให้บริการ</strong> ควรตรงกับข้อมูลที่ยืนยันได้จากเว็บไซต์ทางการ นี่คือจุดที่ใช้แยกรายการจริงออกจากบัญชีแอบอ้าง
        </li>
        <li>
          <strong class="text-[#ff2e52]">ช่องทางติดต่อแอดมินตลอด 24ชม.</strong> ควรตรวจสอบจากเว็บไซต์ทางการก่อนส่งข้อความ และควรเก็บหมายเลขรายการกับหลักฐานที่เกี่ยวข้องไว้ทุกครั้งที่แจ้งปัญหาเรื่องธุรกรรม
        </li>
        <li>
          <strong class="text-[#ff2e52]">ความปลอดภัยของข้อมูลที่ใช้เข้าสู่ระบบ</strong> ควรตั้งรหัสผ่านที่คาดเดาได้ยาก และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้ใครทราบ แม้จะอ้างว่าเป็นเจ้าหน้าที่ก็ตาม
        </li>
      </ol>

      <p>
        <strong class="text-[#ff2e52]">แม้จะมีข้อความโฆษณาว่าจ่ายเร็วหรือถอนได้ไม่จำกัด แต่ไม่สามารถรับประกันระยะเวลาหรือจำนวนเงินที่ถอนได้จากข้อความโฆษณาเพียงอย่างเดียว</strong>
        จึงควรตรวจสอบเงื่อนไขจริงจากผู้ให้บริการก่อนทุกครั้ง และหากพบชื่อบัญชีไม่ตรงกับข้อมูลทางการหรือมีการแจ้งเปลี่ยนบัญชีอย่างผิดปกติ ควรหยุดทำรายการและติดต่อธนาคารหรือผู้ให้บริการชำระเงินเพื่อตรวจสอบก่อนโอนเงิน
      </p>

      <p>
        หากมีข้อสงสัย สามารถสอบถามเจ้าหน้าที่ผ่านช่องทางทางการของเว็บไซต์ได้ โดยแจ้งรายละเอียดปัญหาให้ชัดเจนพร้อมหลักฐานที่เกี่ยวข้อง
        <strong class="text-[#ff2e52]">ทั้งนี้ ควรตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุดอีกครั้ง</strong>
        เพราะช่วงเวลาที่เจ้าหน้าที่รับเรื่องอาจปรับเปลี่ยนได้ตามที่ผู้ให้บริการกำหนด
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/register" aria-label={`สมัครสมาชิก ${BRAND_NAME}`} class={ctaPrimary}>สมัครสมาชิก</a>

        <a href="/login" aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`} class={ctaSecondary}>เข้าสู่ระบบ</a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
