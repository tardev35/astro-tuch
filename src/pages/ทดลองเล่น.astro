// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} หน้ารวมวิธีไล่ดูรูปแบบเกมสล็อตและฟีเจอร์พิเศษก่อนใช้งานจริง พร้อมจุดที่ควรตรวจทั้งกติกาการเล่น ตารางจ่ายรางวัล และเงื่อนไขการเดิมพัน`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ไล่ดูรูปแบบเกมสล็อตและเงื่อนไขก่อนใช้งานจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#9b0a0c]">{BRAND_NAME} รวบรวมข้อมูลเกมสล็อตออนไลน์หลากหลายรูปแบบไว้ในเว็บไซต์เดียว</strong>
        พร้อมข้อมูลค่ายเกม โปรโมชั่น และบริการสมาชิก หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับเกมสล็อตออนไลน์ได้ไล่ดูให้ครบหนึ่งรอบก่อนใช้งานจริง ตั้งแต่รูปแบบเกมและฟีเจอร์พิเศษของแต่ละรายการ
        ไปจนถึงกติกาการเล่นและเงื่อนไขการเดิมพันที่เว็บไซต์ระบุไว้
      </p>

      <p>
        คำว่า ทดลองเล่น ที่หน้านี้พูดถึงจึงหมายถึง
        <strong class="text-[#9b0a0c]">การไล่อ่านรูปแบบเกม ตารางจ่ายรางวัล และเงื่อนไขบริการให้ครบก่อนใช้งานจริง</strong>
        ไม่ใช่การแจกเครดิตทดลอง ผู้ใช้งานสามารถเลือกศึกษารายละเอียดเกมสล็อตที่สนใจและตรวจสอบกติกาได้ก่อนตัดสินใจ และหากพบข้อสงสัยระหว่างใช้งานสามารถสอบถามเจ้าหน้าที่ผ่านช่องทางทางการได้
      </p>

      <p>
        เนื้อหาในหน้านี้เขียนไว้ประกอบการใช้งานเท่านั้น ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้บริการ
        <strong class="text-[#9b0a0c]">โดยควรตรวจสอบสถานะลิขสิทธิ์ของเกมและข้อมูลผู้ให้บริการจากหลักฐานทางการก่อนใช้งาน</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ไล่ดูรูปแบบเกมและฟีเจอร์พิเศษที่เปิดให้ศึกษา" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        ลำดับการไล่ดูจะเป็นชุดเดียวกันทุกครั้ง
        <strong class="text-[#9b0a0c]">เปิดเกมสล็อตที่สนใจ อ่านรูปแบบเกมและกติกาการเล่นที่รายการนั้นวางไว้ แล้วจึงดูฟีเจอร์พิเศษที่เกมนั้นเปิดไว้ต่อ</strong>
        จากนั้นค่อยอ่านตารางจ่ายรางวัลและช่วงเดิมพันขั้นต่ำประกอบ การไล่ดูให้ครบหนึ่งรอบก่อนจึงช่วยให้สอบถามเจ้าหน้าที่ได้ตรงประเด็นเมื่อมีข้อสงสัย
      </p>

      <ul class="flex flex-col gap-4" aria-label="สิ่งที่ควรไล่ดูให้ครบก่อนใช้งานจริง">
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#eb0305]/50 bg-[#fff4ea] text-sm">🎰</span>
          <span>
            <strong class="text-[#9b0a0c]">รูปแบบเกมและกติกาการเล่น</strong> ควรอ่านว่ารายการที่เลือกเล่นด้วยรูปแบบใด และกำหนดกติกาไว้อย่างไร ก่อนเริ่มใช้งาน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#eb0305]/50 bg-[#fff4ea] text-sm">✨</span>
          <span>
            <strong class="text-[#9b0a0c]">ฟีเจอร์พิเศษของแต่ละเกม</strong> ควรดูว่าเกมนั้นเปิดฟีเจอร์อะไรไว้ และมีเงื่อนไขการเข้าถึงฟีเจอร์นั้นหรือไม่
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#eb0305]/50 bg-[#fff4ea] text-sm">📋</span>
          <span>
            <strong class="text-[#9b0a0c]">ตารางจ่ายรางวัลของรายการนั้น</strong> ควรอ่านควบคู่กับรูปแบบเกมเสมอ เพราะเป็นข้อมูลที่เกมแต่ละรายการกำหนดไว้ของตัวเอง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#eb0305]/50 bg-[#fff4ea] text-sm">📑</span>
          <span>
            <strong class="text-[#9b0a0c]">เงื่อนไขการเดิมพันและช่วงเดิมพันขั้นต่ำ</strong> ควรตรวจสอบให้ชัดเจนก่อนเริ่ม เพื่อให้ทราบล่วงหน้าว่าเกมนั้นกำหนดอะไรไว้
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#9b0a0c]">สิ่งที่การไล่ดูช่วยได้คือทำให้รู้ว่ารูปแบบเกมและเงื่อนไขอยู่ตรงไหนเท่านั้น</strong>
        ไม่ได้เป็นการรับประกันผลจากการใช้บริการ และรายชื่อค่ายเกมกับรายการที่เปิดให้บริการอาจเปลี่ยนแปลงได้ จึงควรตรวจสอบข้อมูลล่าสุด รวมถึงหลักฐานการได้รับอนุญาตจากเจ้าของเกมก่อนตัดสินใจ
        และควรกำหนดงบไว้ล่วงหน้าก่อนเริ่มทุกครั้ง
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/about-us"
          aria-label={`อ่านหน้าเกี่ยวกับเราของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#eb0305]/45 bg-[#fff4ea] px-8 py-3 font-bold text-[#401107] shadow-[0_4px_14px_rgba(64,17,7,0.15)] transition-all hover:scale-105 hover:border-[#eb0305] hover:shadow-[0_6px_18px_rgba(235,3,5,0.3)]">
          อ่านเกี่ยวกับเรา
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="ตรวจตารางจ่ายรางวัลและเงื่อนไขการเดิมพันก่อนทำรายการ" as="h2">
    <div class="flex flex-col gap-5">
      <p>
        การไล่ดูระบบมีประโยชน์ที่สุดเมื่อมองว่าเป็นการอ่านรายละเอียดให้จบก่อน
        <strong class="text-[#9b0a0c]">เป้าหมายคือรู้ว่าเกมแต่ละรายการวางกติกาไว้อย่างไร จ่ายรางวัลตามตารางแบบใด กำหนดช่วงเดิมพันขั้นต่ำเท่าใด และสอบถามเจ้าหน้าที่ได้ทางไหนเมื่อมีข้อสงสัย</strong>
        รายการด้านล่างคือชุดที่ควรตรวจก่อนใช้งานครั้งแรก และควรตรวจซ้ำทุกครั้งที่กลับเข้ามาใหม่ เพราะเงื่อนไขปรับเปลี่ยนได้ตามที่เว็บไซต์กำหนด
      </p>

      <ol class="ml-6 list-decimal space-y-3 marker:font-black marker:text-[#9b0a0c]">
        <li>
          <strong class="text-[#9b0a0c]">ที่อยู่เว็บไซต์ทางการและทางเข้าที่ใช้</strong> ควรตรวจสอบให้ถูกต้องก่อนเลือกเมนูใดหรือกรอกข้อมูลใด ไม่ใช่เปิดจากลิงก์ที่ส่งต่อกันมา และควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ
          เพื่อหลีกเลี่ยงบุคคลที่แอบอ้างชื่อบริการ
        </li>
        <li>
          <strong class="text-[#9b0a0c]">กติกาการเล่นและเงื่อนไขการเดิมพันของเกมที่เลือก</strong> ควรดูให้ชัดเจนก่อนเริ่ม เพราะเกมสล็อตแต่ละรายการกำหนดไว้ไม่เหมือนกัน และไม่ได้ใช้ชุดเงื่อนไขเดียวกันทั้งหมด
        </li>
        <li>
          <strong class="text-[#9b0a0c]">ตารางจ่ายรางวัลและช่วงเดิมพันขั้นต่ำ</strong> ควรอ่านเป็นรายเกม ไม่ควรเทียบค่าของเกมหนึ่งไปใช้กับอีกเกมหนึ่ง และควรดูว่าฟีเจอร์พิเศษของเกมนั้นมีเงื่อนไขเพิ่มเติมหรือไม่
        </li>
        <li>
          <strong class="text-[#9b0a0c]">ข้อมูลที่จะใช้สมัครและเข้าใช้งาน</strong> ควรกรอกข้อมูลที่ถูกต้อง ตั้งรหัสผ่านที่ปลอดภัย ไม่ใช้ข้อมูลของบุคคลอื่น และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้ใครทราบ
          แม้จะอ้างว่าเป็นเจ้าหน้าที่ก็ตาม
        </li>
      </ol>

      <p>
        <strong class="text-[#9b0a0c]">หากพบข้อสงสัยควรติดต่อเจ้าหน้าที่ผ่านช่องทางทางการก่อนทำรายการ</strong>
        เพราะรายละเอียดที่เว็บไซต์แสดงอยู่ขณะใช้งานคือสิ่งที่ควรยึดเป็นหลัก และหน้านี้ไม่ได้ยืนยันเงื่อนไขแทนประกาศของผู้ให้บริการ
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/ทางเข้า"
          aria-label={`เปิดหน้าทางเข้าของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#eb0305]/45 bg-[#fff4ea] px-8 py-3 font-bold text-[#401107] shadow-[0_4px_14px_rgba(64,17,7,0.15)] transition-all hover:scale-105 hover:border-[#eb0305] hover:shadow-[0_6px_18px_rgba(235,3,5,0.3)]">
          ไปหน้าทางเข้า
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="ศึกษาเงื่อนไขโปรโมชั่นและช่องทางสอบถามก่อนใช้งานจริง" as="h2">
    <div class="flex flex-col gap-5">
      <p>
        เมื่อคุ้นเคยกับรายละเอียดของเกมแล้ว เรื่องถัดไปคือรายการโปรโมชั่นที่เว็บไซต์ระบุไว้ ซึ่งมีทั้ง
        <strong class="text-[#9b0a0c]">คืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อน โบนัส 0.8% ไม่จำกัด</strong>
        โดยรายการแรกระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขในแต่ละวัน จึงควรตรวจสอบว่าเกมสล็อตประเภทใดเข้าร่วมรายการ มีรอบสรุปยอดเวลาใด และเครดิตจะเข้าสู่บัญชีโดยอัตโนมัติหรือต้องกดรับด้วยตนเอง ทั้งนี้
        เครดิตคืนยอดเสียไม่ได้รับประกันว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือทำกำไรได้ในครั้งต่อไป
      </p>

      <p>
        ส่วนรายการแนะนำเพื่อนควรศึกษาขั้นตอนการรับลิงก์แนะนำ วิธีเชื่อมโยงบัญชี และยอดที่ใช้คำนวณโบนัสให้ครบถ้วนก่อนเข้าร่วม แม้จะมีการระบุว่าไม่จำกัด แต่ควรยืนยันข้อกำหนดเกี่ยวกับจำนวนบัญชีที่เข้าร่วม
        รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุดให้ชัดเจน
        <strong class="text-[#9b0a0c]">รวมถึงตรวจสอบว่าโปรโมชั่นแต่ละรายการรับสิทธิ์ร่วมกันได้หรือไม่</strong>
        เพราะบางรายการอาจมีข้อจำกัดในการรับสิทธิ์ร่วมกัน
      </p>

      <p>
        หากต้องการสอบถามรายละเอียดเพิ่มเติม สามารถติดต่อเจ้าหน้าที่ผ่านช่องทางทางการของเว็บไซต์ได้
        <strong class="text-[#9b0a0c]">โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่นไม่ว่ากรณีใด</strong>
        และควรตรวจสอบเวลาการให้บริการกับระยะเวลาตอบกลับล่าสุดจากประกาศทางการอีกครั้ง
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/promotion"
          aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#eb0305]/45 bg-[#fff4ea] px-8 py-3 font-bold text-[#401107] shadow-[0_4px_14px_rgba(64,17,7,0.15)] transition-all hover:scale-105 hover:border-[#eb0305] hover:shadow-[0_6px_18px_rgba(235,3,5,0.3)]">
          ดูภาพโปรโมชั่น
        </a>

        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#9b0a0c] bg-gradient-to-b from-[#eb0305] via-[#c20305] to-[#9b0a0c] px-8 py-3 font-black text-white shadow-[0_0_14px_rgba(235,3,5,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#7a2f03] bg-gradient-to-b from-[#b44c06] to-[#7a2f03] px-8 py-3 font-bold text-white shadow-[0_0_12px_rgba(122,47,3,0.4)] transition-transform hover:scale-105">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
