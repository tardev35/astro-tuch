---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import popularGamesImage from "../assets/gamedemo8.webp";
import newGamesImage from "../assets/gamedemo16.webp";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริง
// ของบรีฟรอบนี้เท่านั้น (src/assets/content.txt) ไม่ใช่แก้ทับประโยคของแบรนด์ก่อน
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// ⚠️ ดรอปนี้ (2026-10-18) คือ **เว็บเกมสล็อตล้วน** ไม่ใช่หมวดอื่นใดทั้งสิ้น
// สองหน้าของหมวดที่แบรนด์ก่อนๆ เคยเปิดจอดอยู่ใน src/pages-disabled/ ไม่มี route
// ห้ามลิงก์ไปหา เป็น href ตายที่ทำให้ build แดง
//
// ⚠️ แบรนด์ก่อนหน้าก็เป็นแบรนด์สล็อตเหมือนกัน คอปปี้เดิมจึง "ดูเข้าเค้า" ทั้งที่
// กรอบของบรีฟคนละอัน — **ห้าม find-and-replace ทับประโยคเดิม** กรอบของบรีฟรอบนี้คือ
// "ช่องทางรับบริการจาก ผู้ให้บริการเว็บตรง ลิขสิทธิ์แท้ ฐานหลักเกมสล็อตออนไลน์ 100%"
// โดยมีบริการสี่อย่างเป็นแกน: เข้าเล่น · ฝากถอน · ติดต่อ · รับโปรโมชั่น
// (คำต้องห้ามไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำต้องห้ามเจอ false positive —
// รายการเต็มอยู่ใน brand-spec §7)
//
// ⚠️ บรีฟรอบนี้ **ไม่ได้เอ่ยถึงโครงสร้างพื้นฐาน เอกสารรับรอง ผู้พัฒนาเกม สถาบัน
// การเงิน หรือยอดขั้นต่ำใดๆ** จึงห้ามพูดถึงทั้งหมด สิ่งที่บรีฟให้มาคือ "ขอคำแนะนำ
// เกี่ยวกับขั้นตอนการใช้งาน" "ตรวจสอบรายละเอียดบริการ" "อ่านข้อกำหนดของเว็บไซต์"
// และ "ตรวจสอบว่าเป็นเว็บไซต์หรือช่องทางทางการก่อนกรอกข้อมูล" เท่านั้น
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามี "โหมดทดลอง" เครดิตทดลอง หรือเดโมฟรีเป็นบริการของเว็บ —
// จึงห้ามสัญญาสินค้าตัวนั้น คำว่า "ทดลองเล่น" บนหน้านี้จึงหมายถึงสิ่งที่บรีฟระบุไว้
// ตรงๆ ว่าทำได้: ไล่ดูเกมสล็อตออนไลน์และขั้นตอนการใช้งานให้ครบหนึ่งรอบ ขอคำแนะนำ
// เกี่ยวกับขั้นตอนการใช้งาน และตรวจสอบรายละเอียดบริการจากเจ้าหน้าที่ ก่อนเข้าเล่นจริง
//
// ⚠️ รูปในหน้านี้ใช้ได้แค่ gamedemo8 กับ gamedemo16 เท่านั้น — เป็นอาร์ตสต็อกกลาง
// ของเทมเพลต (mtime 2026-08-04) ไม่ใช่อาร์ตเวิร์กของแบรนด์นี้ จึงอยู่ต่อได้ แต่ alt
// ต้องบรรยายภาพจริง และห้ามเอ่ยชื่อแบรนด์ใด เพราะไม่มีชื่อแบรนด์ไหนปรากฏอยู่บนรูป
// ทั้งสองใบ (สีที่ alt บรรยายคือสีที่วาดอยู่บนอาร์ตสต็อกจริง ไม่ใช่สีของพาเลตต์
// รอบนี้ — ห้าม "แก้สี" ใน alt ให้เข้าแบรนด์ เพราะนั่นทำให้ alt บรรยายผิด)
// ส่วน gamedemo7/9/10/11/12/14/15/17/18 มีโลโก้หรือชื่อของผู้ให้บริการ
// เจ้าอื่นพิมพ์ทับอยู่กลางรูป และ gamedemo13 เป็นภาพล่อแหลม — ห้ามนำกลับมาใช้
// เพราะเท่ากับอ้างชื่อที่บรีฟไม่ได้เอ่ย ไฟล์ยังอยู่บนดิสก์ ห้ามลบ เป็นอินเวนทอรี
// gamedemo8 ("POPULAR GAME" 600x379) กับ gamedemo16 ("New Game" 650x411)
// ความกว้างที่วาดจริงสูงสุด ~600px ต่อใบ (กริดสองคอลัมน์ในการ์ด) จึงไม่ขยายเกิน
// ต้นฉบับ quality={62} ของสองใบนี้ตั้งไว้ต่ำกว่าค่าปกติ 80 มาตั้งแต่รอบก่อน เพราะ
// อาร์ตมีเกรนละเอียดจนไฟล์ AVIF เคยโตกว่า WebP ของตัวเอง (verify-build จะแดง)
// ห้ามดันกลับขึ้น — เป็นค่าต่อรูป ไม่ใช่การจูนต่อฟอร์แมต
//
// ⚠️ ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 24 ชั่วโมง ส่วนรายการตัวเลข
// และชื่อเฉพาะที่ห้ามแต่งขึ้นเองอยู่ครบใน brand-spec §7 (ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้
// การ sweep หาคำต้องห้ามของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง)
//
// ประโยคกำกับของบรีฟที่ห้ามตัดทิ้ง (เป็นส่วนหนึ่งของคอปปี้ ไม่ใช่ filler):
// ควรอ่านเงื่อนไขของแต่ละรายการก่อนดำเนินการทุกครั้ง · ควรตรวจสอบข้อมูลบัญชีและ
// รายละเอียดที่เกี่ยวข้องให้ถูกต้อง รวมถึงอ่านข้อกำหนดของเว็บไซต์ · สิทธิ์ที่ได้รับ
// อาจขึ้นอยู่กับประเภทบัญชี ยอดเดิมพัน ระยะเวลาของแคมเปญ · การได้รับเครดิตคืน
// ไม่ได้เป็นการรับประกันผลการเดิมพันในครั้งต่อไป · ควรใช้ข้อมูลของตนเองเท่านั้น
// เก็บรหัสผ่านไว้เป็นความลับ และไม่ส่งรหัสยืนยันหรือข้อมูลสำคัญให้บุคคลอื่น ·
// ควรตรวจสอบเวลาตอบกลับและเงื่อนไขบริการจากประกาศล่าสุดอีกครั้ง
//
// banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// slide1 ของดรอปนี้เป็นของ index กับ /promotion · banner2/banner3 และ
// slide2/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import (ลำพังการ import
// ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น AnnouncementPremium ทั้งเว็บ (brand-spec §3) orchestrator
// ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare
// ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ทองไทยนำ แดงมังกรรอง บนพื้นดำอมแดง**
// ⚠️ สามแบรนด์ก่อนหน้าเป็นแดงทั้งหมด "มีแดงอยู่" จึงไม่ใช่ตัวบอกว่าถูกแบรนด์
// ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน brand-spec §2 (ค่าเดิมไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive) สิ่งที่ทำให้รอบนี้ต่างจริงคือ
// **ทองนำ** กับพื้นดำอมแดง
// ลำดับความลึก: #2b100f ผิวยก (= การ์ด) / #200a09 กลาง / #140505 จม / #1a0505 พื้นเพจ
// ลำดับปุ่มสื่อด้วยขั้ว "ทองถม vs ผิวจมขอบแดง": ปุ่มหลักถมทองไล่เฉด #ffdc8c →
// #f0b429 ขอบ #9a6c0c หมึก #1a0505 (9.7:1 บนปลายเข้ม และ 13:1 บนปลายสว่าง) ·
// ปุ่มรองและปุ่มลิงก์ภายในเป็นผิวจม #200a09 → #140505 ขอบ #d30304/55 ตัวอักษร
// #f5ece0 · ขอบรูปใช้ทองแบรนด์ #f0b429 โปร่ง · marker ของลำดับเลขใช้ทองแบรนด์
// #f0b429 (8.5:1 บนผิวการ์ด — เป็นตัวอักษร จึงใช้แดงแบรนด์ไม่ได้ และ #ffdc8c
// สงวนไว้ให้ <strong> เท่านั้น)
// ⚠️ ห้ามกลับด้าน: พื้นถมทองต้องใช้หมึกเข้มเสมอ ห้ามขาวหรือทองอ่อน และ #d30304
// #a00203 #4a0202 #9a6c0c เป็นเส้น ขอบ ออรา และพื้นถมเท่านั้น ห้ามถือตัวอักษร
// ทุกขนาด ออราในไฟล์นี้ใช้ rgba(211,3,4,α) และ rgba(240,180,41,α) เท่านั้น ·
// รอบนี้ไม่มีม่วง ไม่มีชมพู ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว ไม่มีส้ม (เงินอมฟ้า
// #cfd9e6 เป็นสีตัวอักษรรองเท่านั้น ไม่ใช่สีระบบ และหน้านี้ไม่ได้ใช้)
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #f5ece0)
// ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง ปล่อยให้สืบทอดลงมา
// — มีแค่ปุ่ม ขอบรูป marker ของลำดับเลข และ <strong> ที่ประกาศสี โดย <strong>
// ใช้ทองสว่าง #ffdc8c ตัวเดียว (12:1 บนผิวการ์ด) และแต่ละ <strong> ครอบ
// "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิด
// แท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 157 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} ไล่ดูเกมสล็อตออนไลน์และขั้นตอนการใช้งานก่อนเข้าเล่นจริง พร้อมขอคำแนะนำเรื่องฝากถอน และตรวจสอบรายละเอียดบริการจากเจ้าหน้าที่ได้ 24 ชั่วโมง`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ไล่ดูเกมสล็อตออนไลน์ก่อนเข้าเล่นจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#ffdc8c]">{BRAND_NAME} เป็นช่องทางรับบริการจาก ผู้ให้บริการเว็บตรง ลิขสิทธิ์แท้ ฐานหลักเกมสล็อตออนไลน์ 100%</strong>
        หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับระบบได้ไล่ดูให้ครบหนึ่งรอบก่อนเข้าเล่นจริง ตั้งแต่หมวดเกมสล็อตออนไลน์ที่เว็บไซต์จัดไว้ ไปจนถึงขั้นตอนฝากถอนและรายละเอียดโปรโมชั่นที่เปิดอยู่
      </p>

      <p>
        คำว่า ทดลองเล่น ที่หน้านี้พูดถึงจึงหมายถึง
        <strong class="text-[#ffdc8c]">การขอคำแนะนำเกี่ยวกับขั้นตอนการใช้งานและตรวจสอบรายละเอียดบริการให้ครบก่อนเข้าเล่น</strong>
        ซึ่งเป็นสิ่งที่เว็บไซต์ระบุว่าติดต่อเจ้าหน้าที่สอบถามได้ตลอด 24 ชั่วโมง ไม่ใช่การแจกเครดิตทดลอง และไม่ได้เป็นการรับประกันผลของรายการใดรายการหนึ่ง
      </p>

      <p>
        อีกเรื่องที่ควรไล่ดูไปพร้อมกันคือข้อกำหนดของเว็บไซต์ที่เกี่ยวกับบัญชี การฝากถอน และการใช้งาน
        <strong class="text-[#ffdc8c]">โดยควรอ่านเงื่อนไขของแต่ละรายการก่อนดำเนินการทุกครั้ง</strong>
        เพื่อให้เข้าใจขั้นตอนและเงื่อนไขการให้บริการอย่างชัดเจน ไม่ใช่ยึดจากข้อความที่ส่งต่อกันมาเพียงอย่างเดียว
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ไล่ดูเกมสล็อตออนไลน์และขั้นตอนการใช้งานให้ครบหนึ่งรอบ" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        หลังเข้าสู่ระบบ ลำดับการใช้งานจะเป็นชุดเดียวกันทุกครั้ง
        <strong class="text-[#ffdc8c]">เปิดดูหมวดเกมสล็อตออนไลน์ที่เว็บไซต์จัดไว้ ลองเปิดเกมที่สนใจดูว่าแสดงผลได้ตามปกติไหม แล้วจึงไล่ดูเมนูฝากถอนและรายการโปรโมชั่นต่อ</strong>
        การไล่ดูให้ครบหนึ่งรอบก่อนช่วยให้รู้ว่าข้อมูลแต่ละอย่างอยู่ตรงไหนของหน้าจอ และสอบถามเจ้าหน้าที่ได้ตรงประเด็นขึ้นเมื่อมีข้อสงสัยเกี่ยวกับขั้นตอนการใช้งาน
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={popularGamesImage}
