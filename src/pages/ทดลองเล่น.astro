---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { Picture } from "astro:assets";

import popularGamesImage from "../assets/gamedemo8.webp";
import newGamesImage from "../assets/gamedemo16.webp";

import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login,
// /register หรือหน้าภาพแบบ /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง
// ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้
// (src/assets/content.txt) ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่จาก
// ข้อเท็จจริงและคลังคำของบรีฟรอบนี้เท่านั้น (.claude/brand-spec-okkub88.md §4-§5)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x4 · h3x0
//   h1  ทดลองเล่น <แบรนด์> ศึกษากติกาเกมสล็อตก่อนเดิมพันด้วยเงินจริง
//   h2  กติกาเกมและรายละเอียดค่ายเกมที่ควรศึกษาก่อนเดิมพันจริง
//   h2  เงื่อนไขโบนัส คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ที่ควรตรวจก่อนรับสิทธิ์
//   h2  สมัครสมาชิก <แบรนด์> เพียง 3 ขั้นตอน ก่อนเข้าตรวจรายละเอียดเกม
//   h2  ฝากถอนทุกธนาคารและทรูวอลเลท กับช่องทางติดต่อแอดมิน 24ชม.
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// **การ์ดรูปสองใบอยู่ใน h2 ใบแรก ไม่ได้แยกเป็นหัวข้อของตัวเอง** เพื่อคงผัง h2x4
// ป้ายกำกับของการ์ดรูปอยู่ในตัวภาพเอง (alt) ไม่มีป้ายข้อความใดเป็น heading
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// 🚨🚨 **คำว่า "ทดลองเล่น" อยู่ได้เฉพาะเพราะเป็นชื่อ route /ทดลองเล่น และชื่อเมนู
// จริง** (ใช้ใน h1 · title · description · breadcrumb) แต่ **บรีฟรอบนี้ไม่ได้
// พูดถึงโหมดเล่นโดยไม่ใช้เงินจริงเลยแม้แต่ประโยคเดียว** → **ห้ามอ้างว่าเว็บมี
// โหมดนั้นให้** ห้ามอ้างจำนวนเกมที่เล่นได้ ห้ามอ้างค่า RTP และห้ามอ้างว่าผลที่
// ออกในการลองสะท้อนผลจริง แกนของหน้าจึงเป็น **"สิ่งที่ควรศึกษาและตรวจสอบ
// เกี่ยวกับเกมที่ระบุไว้ ก่อนเดิมพันด้วยเงินจริง"** ตามที่บรีฟมีจริง: ศึกษากติกาเกม ·
// ตรวจสอบเงื่อนไขโบนัส · เลือกดูรายละเอียดค่ายเกมที่สนใจ · ผลลัพธ์ที่ไม่แน่นอน
// ในแต่ละรอบ · 3 ขั้นตอนสมัครสมาชิก · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% ·
// ฝากถอนไม่มีขั้นต่ำ ทุกธนาคารและทรูวอลเลท · แอดมิน 24ชม. · ประกาศล่าสุด
// ⚠️ และมีหนึ่งประโยคที่พูดตรงๆ ว่าบรีฟไม่ได้ระบุโหมดนั้นไว้ เพื่อไม่ให้ผู้อ่าน
// อนุมานเอาจากชื่อเมนู — **ห้ามถอดประโยคนั้นออก**
//
// ⚠️⚠️ ชื่อแบรนด์รอบนี้เป็น **ตัวละตินพิมพ์เล็กล้วน** กลับทิศจากรอบก่อนที่ห้าม
// เขียนละติน (brand-spec §1) ทุกจุดยัง interpolate จาก BRAND_NAME เหมือนเดิม
// เพื่อไม่ให้ค้างเป็นชื่อแบรนด์ก่อนหน้าตอนรีแบรนด์รอบถัดไป ห้ามพิมพ์ตัวใหญ่
// ⚠️⚠️ คำนิยามตัวเองของแบรนด์ขาออกเป็น **คำค้างข้ามแบรนด์** ห้ามหลุดกลับมา
// **รายการคำต้องห้ามเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่** เพื่อไม่ให้
// sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// ⚠️⚠️ ชื่อกระเป๋าเงินรอบนี้คือ **ทรูวอลเลท** เท่านั้น (รอบก่อนเป็นอีกคำ) —
// เป็นคำที่พลาดง่ายที่สุดของรอบนี้ ห้ามสลับกลับ
//
// ⚠️ **รอบนี้สองหน้าหมวดลอตเตอรีถูกปิด** (อยู่ใน src/pages-disabled/ เพราะรอบนี้
// เป็นเว็บสล็อต) ลิงก์ไปสอง route นั้นจากหน้านี้จึงไม่มี — verify-build จะแดงถ้า
// href ชี้ไป route ที่ไม่มีจริง และห้ามใช้คำศัพท์หมวดลอตเตอรีในเนื้อหา
// route ที่มีจริงรอบนี้: / · /about-us · /contact-us · /promotion · /ทดลองเล่น ·
// /ทางเข้า · /login · /register · /terms · /privacy · 404 · /line
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกม ชื่อธนาคารรายตัว ชื่อผู้ให้บริการ
// หน่วยงานกำกับ ใบอนุญาต ปีก่อตั้ง จำนวนสมาชิก จำนวนเกม จำนวนค่าย ตัวเลข RTP
// อัตราจ่าย หรือยอดขั้นต่ำที่เป็นตัวเลข แม้แต่รายการเดียว** จึงห้ามเขียนลงหน้าเว็บ ·
// ตัวเลขที่ขึ้นหน้าได้มีแค่ของบรีฟเอง: **0.3% · 0.8% · 3 ขั้นตอน · 24ชม.**
//
// 🚨 **ข้อกำกับของบรีฟที่ต้อง ship ครบบนหน้านี้** (ไม่ใช่ filler ให้ตัดทิ้ง):
// 1) คำกล่าวอ้างว่ายูสใหม่แตกไวไม่สามารถใช้รับประกันผลรางวัลได้ เพราะเกมสล็อต
//    มีผลลัพธ์ที่ไม่แน่นอนในแต่ละรอบ
// 2) ควรตรวจสอบเงื่อนไขของแต่ละโปรโมชั่นก่อนรับโบนัส โดยเฉพาะจำนวนครั้งที่
//    รับสิทธิ์ได้ ยอดที่ใช้คำนวณเครดิต และข้อกำหนดการถอนเงิน
// 3) การคืนเครดิตไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่ม
//    โอกาสชนะในครั้งต่อไป
// 4) แม้ระบุว่าไม่จำกัด แต่ควรยืนยันจำนวนบัญชีที่เข้าร่วมได้และรอบจ่ายเครดิต
// 5) ควรตรวจสอบรายชื่อธนาคารที่รองรับ ยอดขั้นต่ำ ชื่อบัญชีปลายทาง ระยะเวลา
//    ดำเนินการ และข้อกำหนดการถอนเงิน · แม้ระบุว่าฝากถอนไม่มีขั้นต่ำ ควรตรวจ
//    วงเงินต่อรายการ · พบข้อมูลบัญชีผิดปกติให้หยุดทำธุรกรรมและติดต่อผู้ให้บริการ
//    ชำระเงิน
// 6) ตรวจช่องทางติดต่อจากเว็บไซต์ทางการเพื่อเลี่ยงบัญชีแอบอ้าง · เก็บหมายเลข
//    รายการไว้เป็นหลักฐาน · ไม่เปิดเผยรหัสผ่านหรือรหัส OTP · ตรวจสอบเวลาการ
//    ให้บริการจริงจากประกาศล่าสุด
// ⚠️ บรีฟรอบนี้ **โฆษณาและกำกับในประโยคเดียวกัน** คำโฆษณาอยู่ได้เฉพาะในขอบเขตที่
// บรีฟเขียนไว้เอง ห้ามขยายเป็นคำกล่าวอ้างใหม่ และทุกประโยคกำกับต้อง ship ครบ
// ห้ามตัดเพราะฟังดูลบ
//
// 🚨 **รูปในหน้านี้ใช้ได้แค่ gamedemo8 กับ gamedemo16 เท่านั้น** — เป็นอาร์ตสต็อก
// (mtime 2026-08-04) ไม่ใช่อาร์ตเวิร์กของดรอปนี้ จึงใช้เป็นภาพประกอบหมวดเกมได้
// แต่ **ห้ามใช้แทนอาร์ตเวิร์กแบรนด์** gamedemo8 ("POPULAR GAME" 600x379) กับ
// gamedemo16 ("New Game" 650x411) ไม่มีโลโก้หรือชื่อค่ายเกมเจ้าอื่นพิมพ์ทับอยู่
// ส่วน gamedemo7/9/10/11/12/14/15/17/18 มีโลโก้หรือชื่อของผู้ให้บริการ/ค่ายเกม
// เจ้าอื่นพิมพ์ทับอยู่กลางรูป และ gamedemo13 เป็นภาพล่อแหลม — **ห้ามนำกลับมาใช้**
// ⚠️ ทั้งสองใบวาดกว้างสุด 600px (กริดสองคอลัมน์ตั้งแต่ sm ขึ้นไป) widths/sizes
// จึงตั้งตามนั้น ไม่ใช่ตามขนาดไฟล์ต้นฉบับ
// 🚨 **ห้าม import อาร์ตเวิร์กของแบรนด์อื่นจากหน้านี้เด็ดขาด**: banner2/banner3
// และ slide3/slide4 เป็นของแบรนด์อื่น · slide1/slide2 ถูกตรึงไว้กับ index §4
// ข้อ 5-6 กับ /promotion · banner1 / banner1-mobile / og.png เป็นของ glob ที่
// MainLayout ปักไว้ **ห้ามอ้างจากหน้านี้** · ลำพังการ import ก็ทำให้ไฟล์ถูก emit
// ลง dist/ ทุก build และ verify-build จะแดง · ไฟล์เก่าทั้งหมดยังอยู่บนดิสก์
// **ห้ามลบ** เป็นอินเวนทอรีของแบรนด์ถัดไป
//
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) **ยังเป็นธีมสว่างเหมือนรอบก่อน แต่คนละฮิว
// สิ้นเชิง** bg.json ของดรอปนี้คือ {"mode":"color","color":"#ffd6fa"} =
// **ชมพูบับเบิลกัมพาสเทล** (รอบก่อนเป็น 00bfff = ฟ้าสกายอิ่มตัว)
// **ห้ามเดาว่าเท่าเดิม และห้าม "แก้" การ์ด/ปุ่มกลับไปเป็นพื้นมืด** — พื้นมืดบน
// หมึก #6a0f3c = ตัวอักษรหายไปเลย ไม่ใช่แค่จางลง
// ค่าที่ใช้ได้ในไฟล์นี้: หัวข้อ/`<strong>`/marker ของลำดับเลข **#9c0f55**
// (8.1:1 บนการ์ดขาว) · เข้มสุด #6a0f3c (12.1:1) · พื้นไล่เฉดปุ่มหลัก
// #d91a73 -> #b01160 -> #85094a (**พื้นถม** + หมึกขาว #ffffff) · ปุ่มรองเป็น
// ผิวสว่าง #ffffff -> #ffe3f5 คู่กับหมึกเบอร์รีเข้ม #6a0f3c ·
// ผิวยก #fff4fb · wash #ffe3f5 · เส้น #f9b2d9 · เส้นเข้ม #f479b9
// (**ทั้งคู่ห้ามถือตัวอักษร** ใช้เป็นขอบการ์ดรูปได้)
// หมึกเนื้อความคือ #6a0f3c (= BRAND_TEXT) ซึ่ง **ไม่ประกาศในไฟล์นี้** การ์ด
// ContentBox ตั้งไว้ให้แล้วและย่อหน้าสืบทอดลงมา
// 🚨🚨 **#fb439b บนพื้นขาวได้แค่ 3.3:1 — ห้ามเป็นสีตัวอักษร** และ **ห้ามถมพื้น
// #fb439b หรือ #ffd6fa แล้ววางหมึกขาว** (3.2 / 1.2:1) พื้นชมพูที่รับหมึกขาวได้
// ต้องเป็น **#d91a73 ลงไป** เท่านั้น
// ออราที่อนุญาต: rgba(251,67,155,α) · rgba(255,194,226,α) · rgba(156,15,85,α) ·
// rgba(106,15,60,α) · rgba(249,178,217,α)
// ⚠️⚠️ **รอบนี้ไม่มีฟ้า ไม่มีไซแอน ไม่มีน้ำเงินเลยสักค่า** (ทั้งชุดคือพาเลตของ
// แบรนด์ขาออก) · ไม่มีทอง/เหลือง ไม่มีม่วง ไม่มีเขียวมิ้นต์ ไม่มีครีม/เบจ/น้ำตาล
// ไม่มีเทาเงิน · ปุ่ม LINE อยู่บน /about-us กับ /contact-us ไม่ใช่หน้านี้
// ⚠️⚠️ **รอบนี้เป็นแบรนด์ชมพูจริง และ หมูบิน168 (สองรอบก่อน) ก็ชมพู การเจอชมพู
// ในไฟล์จึงไม่พิสูจน์อะไร** — ห้ามเทียบด้วยวงศ์สี ต้องเทียบทีละค่ากับตาราง
// brand-spec §2 (fb8cc0 มี R=fb ตรงกับ #fb439b เป๊ะ · f7bcd9 มี B=d9 ตรงกับ
// #f9b2d9 เป๊ะ · ffe9f5 ต่างจาก #ffe9f7 แค่ไบต์สุดท้าย · b00d11 ตรงกับ #b01160
// สี่ตัวแรก b01 — เจอที่ไหนแปลว่าพิมพ์ผิด
// เฮกซ์ของแบรนด์เก่าในคอมเมนต์เขียนแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep สะดุด)
// ⚠️⚠️ **เหรียญทอง หีบสมบัติ ดาวเหลือง นีออนในการ์ดรูป หมูการ์ตูนชมพู พื้นสตูดิโอ
// ขาว และสีผิวนักแสดงในอาร์ตเวิร์ก เป็นวัตถุในภาพ ไม่ใช่สี UI**
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง และไม่ใส่ mx-auto / max-w-* บน <p>
// เพราะการ์ดคุมความกว้างเองแล้ว — ที่ประกาศสีได้มีแค่ปุ่ม ชิปไอคอน marker ของ
// ลำดับเลข ขอบการ์ดรูป และ <strong> · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วย
// ช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ
// บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง และห้ามวาง <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังในข้อความของ prop และต้องเป็นไอคอนหมวดสล็อต ไม่ใช่ไอคอนหมวดลอตเตอรี
// slot ของ ContentBox รับ **หนึ่ง element** เท่านั้น จึงห่อด้วย <div> ชั้นเดียว
//
// Announcement รอบนี้หมุนมาเป็น Announcement3 ทั้งเว็บ (brand-spec §3 — รอบก่อนใช้
// ตัวฐานจึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ
// แบรนด์นี้แล้ว จึงเรียกแบบ bare **ห้ามส่ง prop message** มิฉะนั้นข้อความตัววิ่ง
// จะไม่ตรงกันทั้งเว็บ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -c บนเชลล์นี้
// ก็นับเป็นไบต์ ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับตัวนับ
// ของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 153 อักขระ (ชื่อแบรนด์รอบนี้ 7 อักขระ) เป็นประโยคเดียวที่บอกว่า
// หน้านี้มีไว้ทำอะไร แล้วหยุด
// (Google ตัดราว 160 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนๆ ยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} รวมสิ่งที่ควรศึกษาก่อนเดิมพันจริง ทั้งกติกาเกมสล็อต รายละเอียดค่ายเกม เงื่อนไขโบนัสแจกทั้งวัน คืนยอดเสีย 0.3% และขั้นตอนฝากถอนทุกธนาคาร`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ศึกษากติกาเกมสล็อตก่อนเดิมพันด้วยเงินจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});

// คลาสปุ่มสามขั้วของหน้านี้ ประกาศครั้งเดียวแล้วใช้ซ้ำ เพื่อไม่ให้สองปุ่มที่ทำ
// หน้าที่เดียวกันหลุดไปคนละเฉดตอนรีแบรนด์รอบหน้า
const ctaPrimary =
  "flex items-center justify-center rounded-full border border-[#85094a] bg-gradient-to-b from-[#d91a73] via-[#b01160] to-[#85094a] px-8 py-3 font-black text-white shadow-[0_6px_18px_rgba(156,15,85,0.3)] transition-transform hover:scale-105";

const ctaSecondary =
  "flex items-center justify-center rounded-full border border-[#f479b9] bg-gradient-to-b from-[#ffffff] to-[#ffe3f5] px-8 py-3 font-bold text-[#6a0f3c] shadow-[0_6px_18px_rgba(249,178,217,0.45)] transition-transform hover:scale-105";

const ctaQuiet =
  "flex items-center justify-center rounded-full border-2 border-[#9c0f55] bg-[#ffffff] px-8 py-3 font-bold text-[#9c0f55] shadow-[0_4px_14px_rgba(251,67,155,0.2)] transition-all hover:scale-105 hover:bg-[#fff4fb] hover:shadow-[0_6px_18px_rgba(156,15,85,0.2)]";

const listChip = "mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#f9b2d9] bg-[#ffe3f5] text-sm";

const gameCard = "mx-auto block h-auto w-full max-w-[600px] rounded-2xl border border-[#f479b9]";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#9c0f55]">{BRAND_NAME} นำเสนอเกมสล็อตออนไลน์หลากหลายรูปแบบ พร้อมระบบสมาชิกที่รวบรวมข้อมูลเกม โปรโมชั่น และช่องทางฝากถอนไว้ในเว็บไซต์เดียว</strong>
        หน้านี้รวบรวมไว้ว่าควรศึกษาอะไรเกี่ยวกับเกมที่ระบุไว้ และควรตรวจอะไรซ้ำทุกครั้งที่กลับเข้ามาใหม่ ก่อนตัดสินใจเดิมพันด้วยเงินจริง
      </p>

      <p>
        ภายในเว็บไซต์ผู้ใช้งานสามารถศึกษากติกาเกม ตรวจสอบเงื่อนไขโบนัส และเลือกดูรายละเอียดค่ายเกมที่สนใจได้ โดยเฉพาะสมาชิกใหม่ที่ควรทำความเข้าใจระบบก่อนใช้งาน ส่วน
        <strong class="text-[#9c0f55]">คำกล่าวอ้างว่ายูสใหม่แตกไวไม่สามารถใช้รับประกันผลรางวัลได้ เพราะเกมสล็อตมีผลลัพธ์ที่ไม่แน่นอนในแต่ละรอบ</strong>
      </p>

      <p>
        <strong class="text-[#9c0f55]">ข้อมูลที่เว็บไซต์ระบุไว้ไม่ได้กล่าวถึงการเปิดให้หมุนเกมโดยไม่ใช้เงินจริงไว้แต่อย่างใด</strong>
        หน้านี้จึงไม่ยืนยันว่ามีรูปแบบนั้นให้ใช้งาน และควรตรวจสอบจากประกาศล่าสุดของเว็บไซต์ทางการเองว่าเกมใดเปิดให้ศึกษาได้ในลักษณะใด เนื้อหาด้านล่างเขียนไว้ประกอบการใช้งานเท่านั้น ไม่ได้ใช้แทนเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้บริการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="กติกาเกมและรายละเอียดค่ายเกมที่ควรศึกษาก่อนเดิมพันจริง" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#9c0f55]">การอ่านกติกาของเกมที่จะเล่นจากหน้ากติกาของเกมนั้นเอง ตรงกว่าการเทียบจากหน้าตาของวงล้อเพียงอย่างเดียว</strong>
        เพราะแต่ละเกมกำหนดรูปแบบการคิดผลไว้คนละชุด การไล่ดูรายละเอียดค่ายเกมทีละหมวดก่อนจึงช่วยให้เลือกได้ว่าจะเปิดอ่านกติกาของเกมแบบไหนก่อน
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={popularGamesImage}
          alt="การ์ดหมวดเกมยอดนิยม เป็นภาพตัวละครกระต่ายกับแมวการ์ตูนยืนขนาบข้างหีบสมบัติและกองเหรียญทอง มีชิปคาสิโนลายโพดำกระจายอยู่รอบ และมีข้อความ POPULAR GAME ตัวหนาสีทองอยู่กลางภาพ"
          loading="lazy"
          fetchpriority="low"
          decoding="async"
          widths={[300, 600]}
          sizes="(max-width: 639px) 100vw, 600px"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={62}
          class={gameCard}
        />

        <Picture
          src={newGamesImage}
          alt="การ์ดหมวดเกมเปิดใหม่ เป็นภาพตัวละครฟักทองสวมหมวกกับโครงกระดูกการ์ตูนยืนขนาบข้างบนลานกระเบื้องเรืองแสง มีชิปและดาวสีสดกระจายอยู่ และมีข้อความ New Game ตัวหนาสีขาวอยู่กลางภาพ"
          loading="lazy"
          fetchpriority="low"
          decoding="async"
          widths={[300, 600]}
          sizes="(max-width: 639px) 100vw, 600px"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={62}
          class={gameCard}
        />
      </div>

      <ul class="flex flex-col gap-4" aria-label="สิ่งที่ควรศึกษาในเกมสล็อตก่อนเดิมพันจริง">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎰</span>
          <span>
            <strong class="text-[#9c0f55]">กติกาของเกมที่เลือกไว้</strong> ควรอ่านจากหน้ากติกาของเกมนั้นก่อนตั้งยอดเดิมพัน เพราะเป็นจุดที่บอกว่าหนึ่งรอบคิดผลอย่างไรและนับยอดจากอะไร
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🗂️</span>
          <span>
            <strong class="text-[#9c0f55]">รายละเอียดค่ายเกมที่สนใจ</strong> สามารถเลือกดูได้จากระบบสมาชิกที่เว็บไซต์รวบรวมไว้ ซึ่งช่วยให้เทียบได้ว่าแต่ละหมวดเปิดให้ศึกษาข้อมูลส่วนใดบ้าง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎁</span>
          <span>
            <strong class="text-[#9c0f55]">เงื่อนไขโบนัสที่ผูกกับเกมนั้น</strong> ควรตรวจสอบก่อนเข้าร่วมรายการใด เพราะเกมที่เข้าร่วมและยอดที่นำมาคำนวณอาจกำหนดไว้เฉพาะบางหมวด
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📣</span>
          <span>
            <strong class="text-[#9c0f55]">ประกาศล่าสุดของเว็บไซต์ทางการ</strong> คือจุดที่เงื่อนไขจริงถูกอัปเดต ทั้งเกมที่เปิดให้บริการ รายการโปรโมชั่น และช่องทางฝากถอน การเปิดดูก่อนทุกครั้งจึงตรงกว่าการจำไว้จากครั้งก่อน
          </span>
        </li>
      </ul>

      <p>
        เกมสล็อตมีผลลัพธ์ที่ไม่แน่นอนในแต่ละรอบโดยตัวของมันเอง
        <strong class="text-[#9c0f55]">ผลที่ออกในรอบก่อนจึงไม่ใช่สถิติที่นำมาคาดการณ์รอบถัดไปได้</strong>
        และการศึกษากติกาช่วยให้เข้าใจว่าเกมคำนวณผลอย่างไรเท่านั้น ไม่ได้เพิ่มโอกาสชนะในรอบใด
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/promotion" aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`} class={ctaQuiet}>ดูภาพโปรโมชั่น</a>

        <a href="/about-us" aria-label={`อ่านหน้าเกี่ยวกับเราของ ${BRAND_NAME}`} class={ctaQuiet}>อ่านเกี่ยวกับเรา</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="เงื่อนไขโบนัส คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ที่ควรตรวจก่อนรับสิทธิ์" as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} นำเสนอข้อมูลโปรโมชั่นสำหรับสมาชิกใหม่และสมาชิกปัจจุบัน พร้อมสิทธิพิเศษที่เว็บไซต์ประกาศไว้
        <strong class="text-[#9c0f55]">ซึ่งสมาชิกควรตรวจสอบเงื่อนไขของแต่ละโปรโมชั่นก่อนรับโบนัส โดยเฉพาะจำนวนครั้งที่รับสิทธิ์ได้ ยอดที่ใช้คำนวณเครดิต และข้อกำหนดการถอนเงิน</strong>
        เพราะแม้จะมีข้อความระบุว่าแจกโบนัสทั้งวันไม่จำกัด แต่รายละเอียดสิทธิ์ที่ได้รับจริงต้องยืนยันจากประกาศล่าสุดของเว็บไซต์ทางการ
      </p>

      <p>
        รายการคืนยอดเสีย 0.3% ระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขรายวัน สมาชิกควรตรวจสอบว่าเกมสล็อตประเภทใดเข้าร่วมรายการ มีรอบสรุปยอดเวลาใด และต้องกดรับเครดิตด้วยตนเองหรือระบบดำเนินการให้อัตโนมัติ
        <strong class="text-[#9c0f55]">ทั้งนี้ การคืนเครดิตไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งต่อไป</strong>
        เพราะยอดเสียบางรายการอาจไม่เข้าเกณฑ์รับสิทธิ์ตั้งแต่ต้น
      </p>

      <p>
        รายการแนะนำเพื่อนโบนัส 0.8% ระบุสิทธิ์ไว้สำหรับสมาชิกที่แนะนำผู้ใช้งานรายใหม่ โดยควรตรวจสอบวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และฐานยอดที่ใช้คำนวณโบนัสให้ชัดเจน
        <strong class="text-[#9c0f55]">แม้จะมีข้อความว่าไม่จำกัด แต่ควรยืนยันจำนวนบัญชีที่เข้าร่วมได้ รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุด</strong>
        เพื่อป้องกันความเข้าใจคลาดเคลื่อนเกี่ยวกับจำนวนเครดิตที่มีสิทธิ์ได้รับ
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME} เพียง 3 ขั้นตอน ก่อนเข้าตรวจรายละเอียดเกม`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#9c0f55]">การสมัครสมาชิก {BRAND_NAME} สามารถศึกษาขั้นตอนทั่วไปได้จากเมนูลงทะเบียนของเว็บไซต์</strong>
        ก่อนดำเนินการควรตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง อ่านเงื่อนไขการใช้บริการ และตรวจสอบข้อกำหนดด้านอายุกับกฎหมายที่เกี่ยวข้อง รวมถึงศึกษานโยบายการจัดเก็บข้อมูลส่วนบุคคล
      </p>

      <ol class="ml-6 list-decimal space-y-3 marker:font-black marker:text-[#9c0f55]">
        <li>
          <strong class="text-[#9c0f55]">เข้าสู่หน้าสมัครสมาชิก</strong> เปิดเว็บไซต์ผ่านช่องทางที่ตรวจสอบได้ จากนั้นเลือกเมนูสมัครสมาชิกและศึกษาข้อกำหนดการเปิดบัญชี รวมถึงนโยบายการจัดเก็บข้อมูลส่วนบุคคลก่อนกรอกข้อมูล
        </li>
        <li>
          <strong class="text-[#9c0f55]">กรอกข้อมูลและยืนยันบัญชี</strong> กรอกข้อมูลตามที่ระบบกำหนด ตรวจสอบความถูกต้องก่อนยืนยัน และตั้งรหัสผ่านที่ปลอดภัย ไม่ควรใช้ข้อมูลของบุคคลอื่นหรือเปิดเผยรหัส
          OTP ให้ใครทราบ
        </li>
        <li>
          <strong class="text-[#9c0f55]">เข้าสู่ระบบและตรวจสอบโปรโมชั่น</strong> หลังลงทะเบียนเรียบร้อย สามารถศึกษารายชื่อเกมสล็อต กติกาการเล่น และรายละเอียดโปรโมชั่นสำหรับสมาชิกใหม่
          หากมีข้อสงสัยเกี่ยวกับเงื่อนไขโบนัสควรสอบถามเจ้าหน้าที่ผ่านช่องทางทางการก่อนทำรายการ
        </li>
      </ol>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/register" aria-label={`สมัครสมาชิก ${BRAND_NAME}`} class={ctaPrimary}>สมัครสมาชิก</a>

        <a href="/login" aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`} class={ctaSecondary}>เข้าสู่ระบบ</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="ฝากถอนทุกธนาคารและทรูวอลเลท กับช่องทางติดต่อแอดมิน 24ชม." as="h2">
    <div class="flex flex-col gap-6">
      <p>
        เมื่ออ่านกติกาเกมและข้อกำหนดของโปรโมชั่นครบแล้ว
        <strong class="text-[#9c0f55]">ขั้นถัดไปคือการตรวจระบบฝากถอนและช่องทางติดต่อให้ครบก่อนทำธุรกรรมครั้งแรก</strong>
