---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";
import { itemList, pageGraph, schemaCtx } from "../lib/schema";
import image1 from "../assets/gamedemo7.webp";
import image2 from "../assets/gamedemo8.webp";
import image3 from "../assets/gamedemo9.webp";
import image4 from "../assets/gamedemo10.webp";
import image5 from "../assets/gamedemo11.webp";
import image6 from "../assets/gamedemo12.webp";
import image7 from "../assets/gamedemo13.webp";
import image8 from "../assets/gamedemo14.webp";
import image9 from "../assets/gamedemo15.webp";
import image10 from "../assets/gamedemo16.webp";
import image11 from "../assets/gamedemo17.webp";
import image12 from "../assets/gamedemo18.webp";

// One list, two consumers: the gallery below and the ItemList in the JSON-LD.
// They used to be two hand-kept arrays that had to stay in the same order, and
// the name shown to a reader could drift from the name handed to a crawler.
// The thumbnails are generic stock demo art shared across brands — the alt text
// describes the picture, never its position in the grid.
const demoGames = [
  { name: "AskmeSlot", src: image1, alt: "แบนเนอร์ค่ายเกม askmeslot โลโก้โพดำสีเหลือง ตัวการ์ตูนเด็กชายสวมหมวกแดงกางแขน ฉากหลังเป็นถนนเมืองยุโรปและกังหันลม" },
  { name: "Popular Game", src: image2, alt: "แบนเนอร์ Popular Game ตัวอักษรสีทอง ตัวการ์ตูนกระต่ายกับแมวสวมแว่นกันแดด หีบสมบัติ ชิปและเหรียญทองกระจายรอบภาพ" },
  { name: "SlotXO", src: image3, alt: "แบนเนอร์ค่ายเกม SlotXO โลโก้รูปตู้สล็อตพร้อมเหรียญ ฉากหลังเป็นนักรบโรมันสวมชุดเกราะยืนหน้าโคลอสเซียม" },
  { name: "Skywind Group", src: image4, alt: "แบนเนอร์ค่ายเกม Skywind Group โลโก้วงกลมสี่สี ฉากหลังเป็นแมวกวักญี่ปุ่นสีขาว ถุงทอง และดอกซากุระ" },
  { name: "PG Soft", src: image5, alt: "แบนเนอร์ค่ายเกม PG Pocket Games Soft โลโก้ตัวอักษรพิกเซลหลากสี ฉากหลังเป็นหญิงสาวสวมเครื่องประดับทองและหมวกขนนก" },
  { name: "SBOBET", src: image6, alt: "แบนเนอร์ค่ายเกม SBOBET โลโก้สีขาวบนพื้นดำ ฉากหลังเป็นตัวการ์ตูนหญิงสาวผมบลอนด์ชุดสีชมพูถืออมยิ้ม" },
  { name: "Sexy Slot", src: image7, alt: "แบนเนอร์เกม Sexy Slot ตัวอักษรสีชมพูม่วง ฉากหลังเป็นตัวการ์ตูนหญิงสาวชุดสีน้ำเงินนั่งอยู่ในกรอบวงกลมพร้อมรูปหัวใจ" },
  { name: "JILI", src: image8, alt: "แบนเนอร์ค่ายเกม JILI ตัวอักษรสีทอง ฉากหลังเป็นตัวการ์ตูนนางเงือกผมสีแดงถือหอยสังข์อยู่ใต้ท้องทะเล" },
  { name: "Ask Me Bet", src: image9, alt: "แบนเนอร์ค่ายเกม ask me bet โลโก้สีเขียวเหลือง ฉากหลังเป็นหัวสิงโตเชิดสีแดงทองและโคมไฟจีน" },
  { name: "New Game", src: image10, alt: "แบนเนอร์ New Game ตัวอักษรสีขาวสามมิติ ตัวการ์ตูนฟักทองสวมหมวกและโครงกระดูกยืนสองข้าง พร้อมอัญมณีและชิปหลากสี" },
  { name: "JOKER", src: image11, alt: "แบนเนอร์ค่ายเกม JOKER ตัวอักษรสีขาวทอง ฉากหลังเป็นนักรบโรมันสวมหมวกเกราะยืนคู่กับสิงโตในสนามประลอง" },
  { name: "AFB Gaming", src: image12, alt: "แบนเนอร์ค่ายเกม AFB Gaming ตัวอักษรสีทอง ฉากหลังเป็นเทพเจ้าเคราขาวสวมมงกุฎใบไม้ยืนอยู่หน้าวิหารกรีก" },
];

// The URL each entry resolves to is schema.ts's problem, not this file's — an
// older version pasted a hand-built page URL onto all 12 and got the trailing
// slash and the Thai encoding wrong on every one of them.
const gameList = demoGames.map((game) => ({ name: game.name, imagePath: game.src.src }));

// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char).
const pageDescription =
  "หน้าทดลองเล่นสล็อต PLUSPSG สำหรับเลือกเกมและลองหมุนด้วยเครดิตทดลอง ดูจำนวนเพย์ไลน์ ฟีเจอร์โบนัส และช่วงการเดิมพันของแต่ละเกม ก่อนสมัครและเล่นด้วยเครดิตจริง";

const ctx = schemaCtx(Astro);
const graph = pageGraph(Astro, {
  type: "CollectionPage",
  name: "ทดลองเล่นสล็อต PLUSPSG ลองหมุนด้วยเครดิตทดลองก่อนเล่นจริง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
  extra: [
    itemList(ctx, {
      name: "รายการค่ายเกมสล็อตทดลองที่เปิดให้ลองเปิดดูบน PLUSPSG",
      alternateName: "PLUSPSG โหมดทดลองสำหรับดูรูปแบบเกมก่อนสมัครสมาชิกและเดิมพันด้วยเครดิตจริง",
      itemType: "Game",
      items: gameList,
    }),
  ],
});
---

<MainLayout title="ทดลองเล่นสล็อต PLUSPSG ลองหมุนด้วยเครดิตทดลองก่อนเล่นจริง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่นสล็อต PLUSPSG ลองหมุนก่อนเดิมพันจริง" as="h1">
    <p class="mb-6 text-left text-base leading-relaxed text-[#e9d6ac]">
      <strong class="text-[#ff4b18]">PLUSPSG</strong> รวมเกมสล็อตออนไลน์จากหลายค่ายไว้ในบัญชีเดียว ตั้งแต่สล็อตเบทต่ำสำหรับทุนน้อย
      ไปจนถึงเกมที่มีฟีเจอร์โบนัสและแจ็คพอต หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นเคยได้
      <strong class="text-[#ff4b18]">เลือกเกมและลองหมุนด้วยเครดิตทดลอง</strong> เพื่อดูหน้าตาเกม จังหวะการหมุน และรูปแบบฟีเจอร์
      ก่อนตัดสินใจสมัครสมาชิก ฝากเครดิต และเดิมพันด้วยเงินจริง
    </p>

    <p class="mb-2 text-left text-base leading-relaxed text-[#e9d6ac]">
      ขอให้เข้าใจตรงกันว่าโหมดทดลองเป็นเพียงการลองใช้งานระบบเท่านั้น
      <strong class="text-[#ff4b18]">ผลที่ได้จากเครดิตทดลองไม่สามารถใช้ทำนายผลของการเดิมพันจริงได้</strong>
      ผลรางวัลของเกมสล็อตมีความไม่แน่นอน และไม่มีเกมใดรับประกันว่าจะแตกทุกครั้ง หากติดปัญหาระหว่างใช้งาน สามารถแจ้งแอดมิน PLUSPSG
      พร้อมรายละเอียดและเวลาที่พบปัญหา เพื่อให้ทีมงานช่วยตรวจสอบได้ตลอด 24 ชั่วโมง
    </p>
  </ContentBox>

  <ContentBox title="วิธีทดลองเล่นสล็อต PLUSPSG ด้วยตัวเอง 3 ขั้นตอน" as="h2">
    <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#e9d6ac]">
      <li class="flex gap-3"><span class="font-bold text-[#fbbf14]">1.</span> เลือกเกมสล็อตที่สนใจจากค่ายเกมด้านล่าง แล้วเปิดดูหน้าจอและรูปแบบการเล่นของเกมนั้น</li>
      <li class="flex gap-3"><span class="font-bold text-[#fbbf14]">2.</span> ลองหมุนด้วยเครดิตทดลอง เพื่อดูจังหวะเกม สัญลักษณ์ และฟีเจอร์โบนัสที่เกมมีให้</li>
      <li class="flex gap-3">
        <span class="font-bold text-[#fbbf14]">3.</span> ตรวจสอบจำนวนเพย์ไลน์ กติกา และช่วงการเดิมพันของเกม ก่อนสมัครสมาชิกและเล่นด้วยเครดิตจริง
      </li>
    </ol>

    <p class="mt-4 mb-2 text-left text-base leading-relaxed text-[#e9d6ac]">
      หลังสมัครเรียบร้อย สมาชิกสามารถตรวจสอบเครดิต ประวัติการเล่น โปรโมชั่นที่มีสิทธิ์รับ และรายการฝากถอนได้จากบัญชีเดียว ทั้งบนมือถือ แท็บเล็ต และคอมพิวเตอร์
    </p>
  </ContentBox>

  <ContentBox title="ค่ายเกมสล็อตในระบบ PLUSPSG ที่เปิดให้ลองเปิดดู" as="h2">
    <p class="mb-6 text-left text-base leading-relaxed text-[#e9d6ac]">
      ระบบรวมเกมสล็อตจากหลายค่ายไว้ให้เลือก ตั้งแต่เกมยอดนิยม เกมโบนัส ไปจนถึงเกมใหม่ที่อัปเดตเข้ามาอย่างต่อเนื่อง ตามภาพด้านล่าง
      <strong class="text-[#ff4b18]">รูปแบบเกม จำนวนเพย์ไลน์ และช่วงเดิมพันขั้นต่ำของแต่ละค่ายไม่เหมือนกัน</strong>
      ควรอ่านรายละเอียดที่แสดงในหน้าเกมก่อนเริ่มเล่นทุกครั้ง
    </p>

    <div class="grid grid-cols-2 gap-5 sm:grid-cols-2 md:grid-cols-4">
      {
        demoGames.map((game) => (
          <div class="group/game relative mx-auto w-full max-w-[400px] overflow-hidden rounded-xl">
            <Picture
              src={game.src}
              alt={game.alt}
              loading="lazy"
              fetchpriority="low"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 100vw, 25vw"
              class="block h-auto w-full object-cover shadow-[0_10px_30px_rgba(226,6,10,0.20)] transition-transform duration-300 group-hover/game:scale-105"
              decoding="async"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
            <a
              href="/register"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`สมัครสมาชิก PLUSPSG เพื่อเปิดใช้งานเกมทดลอง ${game.name}`}
              class="absolute inset-0 flex items-center justify-center bg-[#0b0402]/85 opacity-0 transition-opacity duration-300 group-hover/game:opacity-100 focus-visible:opacity-100">
              <span class="rounded-full border border-[#ff4b18]/70 bg-gradient-to-r from-[#ff4b18] via-[#e2060a] to-[#7a0304] px-6 py-2 font-bold text-[#fff6e0] shadow-[0_10px_30px_rgba(226,6,10,0.30)] transition-transform hover:scale-110">
                เปิดดู
              </span>
            </a>
          </div>
        ))
      }
    </div>
  </ContentBox>

  <ContentBox title="ตรวจเพย์ไลน์ ฟีเจอร์ และช่วงเดิมพันก่อนเล่นด้วยเครดิตจริง" as="h2">
    <ul class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#e9d6ac]">
      <li class="flex gap-3">
        <span class="text-[#fbbf14]" aria-hidden="true">•</span> หน้านี้เป็นการลองใช้งานระบบเท่านั้น การเล่นด้วยเงินจริงต้องสมัครสมาชิกและฝากเครดิตผ่านระบบก่อน
      </li>
      <li class="flex gap-3">
        <span class="text-[#fbbf14]" aria-hidden="true">•</span> ก่อนเริ่มเล่นแต่ละเกม ควรดูกติกา จำนวนเพย์ไลน์ ฟีเจอร์โบนัส และช่วงการเดิมพันที่เกมนั้นรองรับให้ครบ
      </li>
      <li class="flex gap-3">
        <span class="text-[#fbbf14]" aria-hidden="true">•</span> เดิมพันขั้นต่ำแตกต่างกันตามเกมและผู้ให้บริการ ผู้ที่ทุนน้อยสามารถเลือกเกมสล็อตเบทต่ำที่ระบบเปิดให้บริการได้
      </li>
      <li class="flex gap-3">
        <span class="text-[#fbbf14]" aria-hidden="true">•</span> ผลของเกมสล็อตไม่แน่นอน ไม่มีเกมหรือบัญชีใดรับประกันว่าแตกง่ายทุกครั้ง ควรเลือกขนาดเดิมพันให้เหมาะกับเงินทุนของตัวเอง
      </li>
      <li class="flex gap-3">
        <span class="text-[#fbbf14]" aria-hidden="true">•</span> หากสมัครสมาชิกไม่ได้ Login ไม่ผ่าน เครดิตไม่เข้า ถอนไม่สำเร็จ หรือเข้าเกมไม่ได้ ให้แจ้งแอดมิน PLUSPSG
        พร้อมรายละเอียดและเวลาที่ทำรายการ
      </li>
    </ul>
  </ContentBox>

  <Navfoot />
</MainLayout>
