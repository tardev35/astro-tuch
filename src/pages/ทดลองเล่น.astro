---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import popularGamesImage from "../assets/gamedemo8.webp";
import newGamesImage from "../assets/gamedemo16.webp";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริง
// ของบรีฟรอบนี้เท่านั้น (src/assets/content.txt) ไม่ใช่แก้ทับประโยคของแบรนด์ก่อน
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// ดรอปนี้ (2026-10-08) คือ **เว็บสล็อตออนไลน์ล้วน** ไม่ใช่คาสิโนรวมหมวดแบบ
// 789BETTING รอบก่อน และไม่ใช่เว็บหวย แง่มุมที่บรีฟระบุไว้มีเท่านี้:
// รวบรวมเกมเดิมพันหลายรูปแบบไว้ในระบบเดียว · สล็อตคลาสสิก เกมโบนัส ฟรีสปิน ตัวคูณ
// และเกมเปิดใหม่ตามรายการที่ให้บริการ · รองรับการเข้าเล่นผ่านมือถือ · เลือกเกม
// ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการจากบัญชีเดียว · เกมที่รองรับยอดต่ำเลือก
// เล่นตามงบได้ · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · ยอดที่เข้าเกณฑ์ · รอบตัดยอด ·
// รอบการรับสิทธิ์ · แอดมิน 24 ชั่วโมง · ฝากถอน · PIN · OTP · หลักฐานธุรกรรม
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามี "โหมดทดลอง" เครดิตทดลอง หรือเดโมฟรีเป็นบริการของเว็บ —
// จึงห้ามสัญญาสินค้าตัวนั้น คำว่า "ทดลองเล่น" บนหน้านี้จึงหมายถึงสิ่งที่บรีฟระบุไว้
// ตรง ๆ ว่าทำได้: เปิดดูรายการเกมที่ให้บริการ อ่านฟีเจอร์ของเกม และตรวจวงเงินจริง
// ของแต่ละเกมก่อนเริ่มเดิมพัน = ไล่ดูระบบให้ครบหนึ่งรอบ
//
// ⚠️ รูปในหน้านี้ใช้ได้แค่ gamedemo8 กับ gamedemo16 เท่านั้น — เป็นอาร์ตสต็อกกลาง
// ของเทมเพลต ไม่ใช่อาร์ตเวิร์กของแบรนด์นี้ จึงอยู่ต่อได้ แต่ alt ต้องบรรยายภาพจริง
// และห้ามเอ่ยชื่อแบรนด์ใดทั้งของรอบนี้และรอบก่อน
// ส่วน gamedemo7/9/10/11/12/14/15/17/18 มีโลโก้หรือชื่อของผู้ให้บริการ/ค่ายเกม
// เจ้าอื่นพิมพ์ทับอยู่กลางรูป และ gamedemo13 เป็นภาพล่อแหลม — ห้ามนำกลับมาใช้
// เพราะเท่ากับอ้างชื่อค่ายเกมที่บรีฟไม่ได้เอ่ย ไฟล์ยังอยู่บนดิสก์ ห้ามลบ เป็นอินเวนทอรี
// gamedemo8 ("POPULAR GAME" 600x379) กับ gamedemo16 ("New Game" 650x411) ไม่มี
// ชื่อแบรนด์ใดปรากฏ ความกว้างที่วาดจริงสูงสุด ~600px ต่อใบ (กริดสองคอลัมน์ในการ์ด)
// จึงไม่ขยายเกินต้นฉบับ
//
// ⚠️ คำที่ห้ามหลงเหลือ: ศัพท์หมวดคาสิโนไลฟ์ หมวดกีฬา และหมวดลอตเตอรีของแบรนด์ก่อน
// (เป็นของอินเวนทอรีที่จอดไว้) รวมถึงคำขายของที่บรีฟรอบนี้ไม่ได้เอ่ย — รายการเต็ม
// อยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำต้องห้ามเจอ false positive
// สองหน้าหมวดลอตเตอรีจอดอยู่ใน src/pages-disabled/ จึงไม่มีปลายทางให้ลิงก์รอบนี้
//
// ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 24 ชั่วโมง
// ห้ามเติมเลขใบอนุญาต หน่วยงานกำกับ ชื่อผู้ให้บริการ ชื่อค่ายเกม ชื่อธนาคาร
// ค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก จำนวนขั้นตอนการสมัคร หรือปีที่ก่อตั้ง
// เพราะบรีฟไม่ได้เอ่ยไว้
//
// ประโยคกำกับของบรีฟที่ห้ามตัดทิ้ง (เป็นส่วนหนึ่งของคอปปี้ ไม่ใช่ filler):
// คำว่า "ไม่มีขั้นต่ำ" ควรตรวจสอบวงเงินจริงของแต่ละเกม · การระบุว่าเกมสล็อต
// "ถูกลิขสิทธิ์" ควรมีข้อมูลค่ายหรือผู้ให้บริการที่ตรวจสอบได้รองรับ ·
// โบนัสที่ได้รับจริงควรยึดรายละเอียดล่าสุดจากระบบเป็นหลัก
//
// banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// banner2 เป็นของ index.astro · slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion ·
// slide3/slide4/banner3 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import (ลำพังการ import ก็ทำให้
// ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น Announcement3 ทั้งเว็บ (รอบก่อน 789BETTING ใช้
// Announcement5 — brand-spec §3 หมุนออก) orchestrator ตั้ง default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message
// มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **คู่สีสดบนพื้นกรมท่าเกือบดำ** — พลิกจาก
// ทองเมทัลลิกฮิวเดียวบนดำสนิทของรอบก่อน โลโก้คือคำว่า แตกดี สีเหลืองมะนาววางเหนือ
// เลข 168 สีฟ้าสด จึงมีสองฮิวจริง ไม่ใช่ปลายสว่าง/เข้มของโลหะเดียว
// ชุดทองเดิมออกครบทุกจุดแล้ว ทั้งคลาส Tailwind raw hex และ rgba() (ค่าเดิมอยู่ใน
// brand-spec §2 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive)
// ลำดับปุ่มสื่อด้วย "ฮิวที่สองถม vs ฮิวหลักโปร่ง":
// ปุ่มหลักถมเหลืองไล่ #fff48a → #fce604 → #c9a703 ขอบ #c9a703 หมึกกรมท่า #031018
// (15.0:1 บน #fce604 และ 8.7:1 บนปลายเข้มสุด #c9a703) · ปุ่มรองและปุ่มลิงก์ภายใน
// เป็นผิวการ์ด #0a1726 → #040b14 ขอบฟ้าแบรนด์ #0193fb/55 หมึกฟ้าอ่อน #7bcffb
// (10.5:1) · ขอบรูปและ marker ของลำดับเลขใช้ฟ้าแบรนด์กับเหลืองมะนาว
// ⚠️ ห้ามกลับด้าน: พื้นถมเหลืองต้องใช้หมึกเข้มเสมอ ห้ามครีมหรือขาว (เหลือ ~1.2:1)
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #dbeafe)
// ไว้ที่ตัวการ์ดแล้ว ข้อความในหน้านี้จึงไม่ประกาศสีของตัวเองเลย ปล่อยให้สืบทอดลงมา
// — มีแค่ปุ่ม ขอบรูป และ marker ของลำดับเลขที่ประกาศสี เพราะเป็นพื้น/เส้น ไม่ใช่เนื้อความ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 157 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} ด้วยการไล่ดูเกมสล็อตในระบบจริงให้ครบ ทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน ตัวคูณ และเกมเปิดใหม่ พร้อมตรวจสอบวงเงินของแต่ละเกมก่อนเริ่มเดิมพัน`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ไล่ดูเกมสล็อตและรายละเอียดก่อนเริ่มเดิมพัน`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong>{BRAND_NAME}</strong> เป็นเว็บสล็อตออนไลน์ที่รวบรวมเกมเดิมพันหลายรูปแบบไว้ในระบบเดียว
        <strong>มีทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน ตัวคูณ และเกมเปิดใหม่ตามรายการที่ให้บริการ</strong>
        หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับระบบได้ไล่ดูให้ครบหนึ่งรอบ ตั้งแต่การเปิดรายการเกมที่ให้บริการอยู่ ไปจนถึงรายละเอียดที่ระบบแสดงไว้ในแต่ละเกม ก่อนจะเริ่มเดิมพันด้วยเครดิตจริง
      </p>

      <p>
        คำว่า ทดลองเล่น ที่หน้านี้พูดถึงจึงหมายถึง
        <strong>การเปิดดูรายการเกม อ่านฟีเจอร์ที่เกมนั้นเปิดไว้ และดูช่วงเดิมพันที่ระบบแสดงก่อนเริ่ม</strong>
        ซึ่งเป็นสิ่งที่ระบบเปิดให้ทำได้อยู่แล้ว ไม่ใช่เครดิตทดลอง ไม่ใช่การเดิมพันฟรี และไม่ใช่การรับประกันผลของเกมใดเกมหนึ่ง เมื่อ Login แล้วสมาชิกจะเปิดดูเครดิต โปรโมชั่น และประวัติรายการได้จากบัญชีเดียว โดยระบบรองรับการเข้าเล่นผ่านมือถือ
      </p>

      <p>
        สำหรับเกมที่รองรับการเดิมพันยอดต่ำ สมาชิกเลือกเล่นตามงบที่ตั้งไว้ได้
        <strong>แต่คำว่าไม่มีขั้นต่ำควรตรวจสอบวงเงินจริงของแต่ละเกมก่อนเสมอ เพราะแต่ละเกมและแต่ละค่ายกำหนดช่วงเดิมพันไว้ไม่เท่ากัน</strong>
        ส่วนการระบุว่าเกมสล็อตถูกลิขสิทธิ์ ควรมีข้อมูลค่ายหรือผู้ให้บริการที่ตรวจสอบได้รองรับ ไม่ใช่ดูจากข้อความบนหน้าประชาสัมพันธ์เพียงอย่างเดียว
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`เกมสล็อตที่ ${BRAND_NAME} เปิดให้เลือก ทั้งเกมคลาสสิก เกมโบนัส ฟรีสปิน และตัวคูณ`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        หลัง Login ลำดับการใช้งานจะเป็นชุดเดียวกันทุกครั้ง
        <strong>เปิดรายการเกม เลือกเกมที่ต้องการ อ่านฟีเจอร์และช่วงเดิมพันของเกมนั้น แล้วจึงกำหนดยอดก่อนเริ่มหมุน</strong>
        การไล่ดูให้ครบรอบหนึ่งก่อนจึงช่วยให้รู้ว่าข้อมูลแต่ละอย่างอยู่ตรงไหนของหน้าจอ และเลือกเกมที่ช่วงเดิมพันตรงกับงบที่ตั้งไว้ได้เร็วขึ้น
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={popularGamesImage}
          alt="การ์ดหมวดเกมยอดนิยม เป็นภาพตัวละครกระต่ายกับแมวการ์ตูนยืนขนาบข้างหีบสมบัติและกองเหรียญทอง มีชิปคาสิโนลายโพดำกระจายอยู่รอบ และมีข้อความ POPULAR GAME ตัวหนาสีทองอยู่กลางภาพ"
          loading="lazy"
          fetchpriority="low"
          decoding="async"
          widths={[300, 600]}
          sizes="(max-width: 639px) 100vw, 600px"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={62}
          class="mx-auto block h-auto w-full max-w-[600px] rounded-2xl border border-[#0193fb]/30"
        />

        <Picture
          src={newGamesImage}
          alt="การ์ดหมวดเกมเปิดใหม่ เป็นภาพตัวละครฟักทองสวมหมวกกับโครงกระดูกการ์ตูนยืนขนาบข้างบนลานกระเบื้องเรืองแสง มีชิปและดาวสีสดกระจายอยู่ และมีข้อความ New Game ตัวหนาสีขาวอยู่กลางภาพ"
          loading="lazy"
          fetchpriority="low"
          decoding="async"
          widths={[300, 600]}
          sizes="(max-width: 639px) 100vw, 600px"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={62}
          class="mx-auto block h-auto w-full max-w-[600px] rounded-2xl border border-[#0193fb]/30"
        />
      </div>

      <ul class="flex flex-col gap-3" aria-label="รูปแบบของเกมสล็อตที่เปิดให้เลือกในระบบ">
        <li class="flex gap-3">
          <span aria-hidden="true">🎰</span>
          <span>
            <strong>สล็อตคลาสสิก</strong> เป็นรูปแบบที่อ่านง่ายที่สุด จำนวนวงล้อและเส้นรางวัลไม่ซับซ้อน เหมาะกับการไล่ดูระบบรอบแรก เพราะเห็นได้ชัดว่ายอดเดิมพันที่ตั้งไว้ถูกคิดอย่างไรในแต่ละตา
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">🎁</span>
          <span>
            <strong>เกมโบนัส</strong> มีรอบพิเศษที่เปิดเพิ่มจากเกมหลัก แต่ละเกมกำหนดเงื่อนไขการเข้าสู่รอบนั้นไว้ไม่เหมือนกัน จึงควรอ่านรายละเอียดภายในเกมก่อนว่าจะเข้ารอบโบนัสได้ด้วยวิธีใด
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">🌀</span>
          <span>
