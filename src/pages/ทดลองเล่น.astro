---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { pageGraph } from "../lib/schema";

// UFA168 รวมเกมหลายหมวดไว้ในบัญชีเดียว หน้านี้จึงหมายถึงการลองเกมในโหมดทดลองเล่น
// เพื่ออ่านกติกา อัตราจ่าย และรายละเอียดการเดิมพันก่อนใช้เครดิตจริง
// แบรนด์เก่าเคยวางแกลเลอรี 12 การ์ด (gamedemo7..18.webp) ไว้ที่หน้านี้ ตอนนี้ไม่มีการ
// import แล้ว — อย่านำกลับมา เพราะลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/
// และ verify-build จะแดงถ้ามีรูปที่ไม่มีใคร render
//
// ทุกข้อความอ้างอิง src/assets/content.txt เท่านั้น ไม่มีการอ้างใบอนุญาตหรือการันตีผล
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 153
const pageDescription =
  "หน้าทดลองเล่นของ UFA168 แนะนำวิธีลองเกมสล็อตและคาสิโนในโหมดเดโม ตรวจสอบกติกา อัตราจ่าย และรายละเอียดการเดิมพัน พร้อมวางงบและจุดหยุดก่อนเล่นด้วยเครดิตจริง";

const graph = pageGraph(Astro, {
  name: "ทดลองเล่นเกมกับ UFA168 ก่อนเดิมพันด้วยเครดิตจริง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title="ทดลองเล่น UFA168 ลองเกมสล็อตและคาสิโนก่อนเดิมพันด้วยเครดิตจริง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่นเกมกับ UFA168 ก่อนเดิมพันด้วยเครดิตจริง" as="h1">
    <div>
      <p class="mb-6 text-left text-base leading-relaxed text-[#e6dcc2]">
        <strong class="text-[#f3db5b]">UFA168</strong> รวมเกมเดิมพันหลายหมวดไว้ในบัญชีเดียว ทั้งสล็อต บาคาร่า คาสิโนสด เกมไพ่ กีฬา และหวย
        หน้านี้จึงเปิดไว้ให้ผู้เริ่มต้นได้<strong class="text-[#f3db5b]">ลองเล่นในโหมดทดลอง อ่านกติกา และดูอัตราจ่ายของแต่ละเกม</strong>
        ก่อนเริ่มใช้งานจริงด้วยเครดิตของตัวเอง เพราะแต่ละเกมมีเงื่อนไขการเดิมพันไม่เหมือนกัน การรู้ว่าเกมจ่ายรางวัลอย่างไรช่วยให้เลือกขนาดเดิมพันได้เหมาะกับเงินทุนมากกว่าเดิม
      </p>

      <p class="mb-2 text-left text-base leading-relaxed text-[#e6dcc2]">
        ขอให้เข้าใจตรงกันว่าการทดลองเล่นเป็นการทำความคุ้นเคยกับเกมและระบบเท่านั้น
        <strong class="text-[#f3db5b]">ไม่ใช่การรับประกันผลรางวัลและไม่สามารถใช้ทำนายผลของรอบถัดไปได้</strong>
        หากติดปัญหาระหว่างใช้งาน สามารถแจ้งแอดมิน UFA168 ได้ตลอด 24 ชั่วโมง พร้อมรายละเอียดและเวลาที่เกิดรายการ เพื่อให้เจ้าหน้าที่ตรวจสอบได้ตรงจุด
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="โหมดทดลองเล่นของ UFA168 ดูอะไรได้บ้าง" as="h2">
    <div>
      <p class="mb-4 text-left text-base leading-relaxed text-[#e6dcc2]">
        สิ่งที่ควรเปิดดูให้ครบระหว่างทดลองเล่นคือ
        <strong class="text-[#f3db5b]">กติกาของเกม อัตราจ่าย รูปแบบการวางเดิมพัน และรายละเอียดของฟีเจอร์หรือรอบพิเศษ</strong>
        เพราะข้อมูลชุดนี้บอกว่าเกมจ่ายรางวัลจากอะไรและต้องเดิมพันแบบไหนถึงเข้าเงื่อนไข แทนที่จะเลือกเกมจากคำบอกเล่าเพียงอย่างเดียว
      </p>

      <p class="mb-2 text-left text-base leading-relaxed text-[#e6dcc2]">
        อีกจุดที่ควรดูประกอบกันคือ<strong class="text-[#d8dce2]">ค่ายเกมที่เป็นเจ้าของเกมนั้น</strong>
        เนื่องจากแต่ละเกมอาจมาจากผู้พัฒนาหรือผู้ให้บริการแตกต่างกัน จึงควรตรวจสอบรายละเอียดจากข้อมูลของค่ายที่แสดงอยู่ในระบบโดยตรง
        และเลือกเกมให้เหมาะกับเงินทุนและระยะเวลาที่ตั้งใจเล่น โดยผลของรอบก่อนหน้าไม่ได้ยืนยันผลของรอบถัดไป
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ขั้นตอนเริ่มใช้งาน UFA168 และลองเกมด้วยตัวเอง" as="h2">
    <div>
      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#e6dcc2]">
        <li class="flex gap-3"><span class="font-bold text-[#d4af37]">1.</span> เข้าหน้าสมัคร UFA168 และกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน ทำผ่านมือถือ แท็บเล็ต หรือคอมพิวเตอร์ก็ได้</li>
        <li class="flex gap-3"><span class="font-bold text-[#d4af37]">2.</span> Login เข้าสู่บัญชี ตรวจสอบช่องทางฝากถอนและรายละเอียดโปรโมชั่นให้เรียบร้อย</li>
        <li class="flex gap-3"><span class="font-bold text-[#d4af37]">3.</span> เลือกหมวดเกมที่สนใจ ทั้งสล็อต บาคาร่า คาสิโนสด กีฬา หรือหวย แล้วเปิดอ่านกติกาและอัตราจ่ายของเกมนั้น</li>
        <li class="flex gap-3"><span class="font-bold text-[#d4af37]">4.</span> ลองเล่นในโหมดทดลองเพื่อดูจังหวะของเกม รูปแบบการวางเดิมพัน และการทำงานของฟีเจอร์ต่าง ๆ</li>
        <li class="flex gap-3"><span class="font-bold text-[#d4af37]">5.</span> กำหนดงบประมาณและขนาดเดิมพันที่รับได้ ก่อนเปลี่ยนมาเล่นด้วยเครดิตจริง</li>
      </ol>

      <p class="mt-4 mb-2 text-left text-base leading-relaxed text-[#e6dcc2]">
        ก่อนเริ่มเดิมพันจริงควรแบ่งงบออกเป็นหน่วยย่อยไว้ล่วงหน้า เช่น มีทุน 1,000 บาท ให้คิด 1 หน่วยเท่ากับ 10 บาท แล้ววางขนาดเดิมพันให้อยู่ในระดับที่รับความผันผวนได้
        วิธีนี้<strong class="text-[#f3db5b]">ไม่ได้ทำให้เกมจ่ายรางวัลมากขึ้น แต่ช่วยให้รู้ล่วงหน้าว่าแต่ละรอบใช้เงินได้เท่าไร</strong>
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="สิ่งที่ควรตรวจสอบก่อนเปลี่ยนมาเดิมพันด้วยเครดิตจริง" as="h2">
    <div>
      <ul class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#e6dcc2]">
        <li class="flex gap-3">
          <span class="text-[#f3db5b]" aria-hidden="true">•</span> หน้านี้อธิบายการใช้งานและการลองเกมเท่านั้น การเดิมพันจริงต้องสมัครสมาชิกและฝากเครดิตผ่านช่องทางที่เปิดให้บริการก่อน
        </li>
        <li class="flex gap-3">
          <span class="text-[#f3db5b]" aria-hidden="true">•</span> เปิดอ่านกติกา อัตราจ่าย และรายละเอียดการเดิมพันให้ครบ เพราะแต่ละเกมและแต่ละค่ายไม่ได้ใช้เงื่อนไขเดียวกัน
        </li>
        <li class="flex gap-3">
          <span class="text-[#f3db5b]" aria-hidden="true">•</span> เลือกเกมให้เหมาะกับเงินทุนและเวลาที่ตั้งใจเล่น ไม่ใช่เลือกจากคำบอกว่าเกมกำลังแตกหรือถึงรอบจ่าย
        </li>
        <li class="flex gap-3">
          <span class="text-[#f3db5b]" aria-hidden="true">•</span> ตั้งจุดหยุดเมื่อเสียและจุดที่จะพักเมื่อได้กำไรไว้ตั้งแต่ก่อนเริ่ม แล้วหยุดตามแผน ไม่เพิ่มเดิมพันเพื่อไล่เอาเงินคืน
        </li>
        <li class="flex gap-3">
          <span class="text-[#f3db5b]" aria-hidden="true">•</span> อ่านเงื่อนไขโปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ก่อนกดรับทุกครั้ง และไม่เปิดเผยรหัสผ่านหรือ OTP ให้ผู้อื่น
        </li>
        <li class="flex gap-3">
          <span class="text-[#f3db5b]" aria-hidden="true">•</span> ตรวจสอบว่ากำลังใช้งานลิงก์ทางเข้าของผู้ให้บริการที่ถูกต้อง หากไม่แน่ใจให้สอบถามแอดมินก่อน Login หรือฝากเงิน
        </li>
      </ul>

      <p class="mt-4 mb-6 text-left text-base leading-relaxed text-[#e6dcc2]">
        หากพบปัญหาเรื่องการสมัคร Login ไม่ได้ เครดิตไม่เข้า ถอนเงินล่าช้า โปรโมชั่นไม่แสดง หรือเข้าเกมไม่ได้ แจ้งแอดมิน UFA168 พร้อมเวลาและรายละเอียดของรายการได้ตลอด 24 ชั่วโมง โดย
        <strong class="text-[#f3db5b]">การเดิมพันมีความเสี่ยง ควรกำหนดงบประมาณให้เหมาะสมทุกครั้ง</strong>
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก UFA168"
          class="flex items-center justify-center rounded-lg bg-gradient-to-r from-[#fff3bf] via-[#f3db5b] to-[#a37c14] px-8 py-3 font-black text-[#050403] shadow-[0_0_15px_rgba(243,219,91,0.35)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ UFA168"
          class="flex items-center justify-center rounded-lg border border-[#6b5316]/80 bg-transparent px-8 py-3 font-bold text-[#d8dce2] transition-all hover:scale-105 hover:border-[#f3db5b] hover:bg-[#241a08]/70">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>

  <Navfoot />
</MainLayout>
