---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { pageGraph } from "../lib/schema";

// SUPERMAX168 เป็นเว็บคาสิโนออนไลน์เว็บตรงที่เปิดครบห้าหมวด — บาคาร่า สล็อต บอล หวย ไฮโล
// หน้านี้จึงหมายถึงการทำความรู้จักระบบก่อนเดิมพันด้วยเครดิตจริง: ขั้นตอนสมัครและฝากเครดิต
// การเลือกหมวดเกม การตรวจกติกา อัตราจ่าย และวงเงินเดิมพันของแต่ละหมวด โปรโมชั่นที่ตรวจสอบ
// ได้หลัง Login และการดูประวัติรายการในบัญชีสมาชิก
// (รอบรีแบรนด์ก่อนหน้าเป็นเว็บสล็อตล้วน เนื้อหาเดิมจึงถูกเขียนใหม่ทั้งหน้าให้ครบห้าหมวด)
//
// แบรนด์เก่าเคยวางแกลเลอรี 12 การ์ด (gamedemo7..18.webp) ไว้ที่หน้านี้ ถูกถอดออกไปตั้งแต่
// สิบรอบรีแบรนด์ก่อน และไม่มีการ import แล้ว — อย่านำกลับมา ลำพังการ import ก็ทำให้ไฟล์ถูก
// emit ลง dist/ และ verify-build จะแดงถ้ามีรูปที่ไม่มีใคร render ทั้งชุด
//
// ทุกข้อความอ้างอิงบรีฟของแบรนด์นี้เท่านั้น: รวมบาคาร่า สล็อต บอล หวย ไฮโล ในบัญชีเดียว ·
// Login แล้วเลือกเกมที่ต้องการ พร้อมตรวจกติกา อัตราจ่าย และวงเงินก่อนทำรายการ ·
// โบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไข · ฝากถอนผ่านวอลเลทหรือธนาคารตาม
// ช่องทางที่รองรับ ตรวจชื่อบัญชี ยอดขั้นต่ำ และวงเงินก่อนทำธุรกรรม · แอดมิน 24 ชม.
// ไม่มีการอ้างใบอนุญาต การจดทะเบียน ปีที่ก่อตั้ง จำนวนสมาชิก การันตีผลกำไร ชื่อค่ายเกมรายใด
// หรือตาราง RTP ตายตัว
//
// Announcement หมุนมาใช้ AnnouncementPremium ตัวเดียวกับ index — default message ของไฟล์นั้น
// เป็นข้อความของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ได้
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 157
const pageDescription =
  "หน้าทดลองเล่น SUPERMAX168 แนะนำวิธีเริ่มใช้งานคาสิโนออนไลน์ ตั้งแต่สมัครสมาชิก ฝากเครดิตผ่านวอลเลท เลือกหมวดบาคาร่า สล็อต บอล หวย ไฮโล จนถึงตรวจกติกาก่อนเล่น";

const graph = pageGraph(Astro, {
  name: "ทดลองเล่น SUPERMAX168 ทำความรู้จักระบบคาสิโนออนไลน์ก่อนเดิมพันด้วยเครดิตจริง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title="ทดลองเล่น SUPERMAX168 ลองใช้ระบบคาสิโนเว็บตรง บาคาร่า สล็อต บอล หวย ไฮโล" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่น SUPERMAX168 ทำความรู้จักระบบคาสิโนออนไลน์ก่อนเดิมพันด้วยเครดิตจริง" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f3e6c8]">
        <strong class="text-[#fff8e2]">SUPERMAX168</strong> รวมหมวดเกมหลักไว้ในบัญชีเดียว ทั้งบาคาร่าออนไลน์ สล็อตออนไลน์จากหลายค่าย
        เดิมพันฟุตบอลตามรายการแข่งขัน หวยออนไลน์ตามรอบที่เปิดรับ และไฮโลในหมวดคาสิโน รองรับการเข้าใช้งานผ่านมือถือและคอมพิวเตอร์
        หน้านี้จึงเปิดไว้ให้ผู้เริ่มต้นได้<strong class="text-[#ecc964]">ทำความคุ้นเคยกับขั้นตอนใช้งาน ตรวจกติกา อัตราจ่าย และวงเงินเดิมพันของแต่ละหมวด</strong>
        ก่อนเดิมพันด้วยเครดิตของตัวเอง เพราะรายละเอียดเหล่านี้ต่างกันไปตามหมวดและตามเกมที่เลือก
      </p>

      <p class="text-left text-base leading-relaxed text-[#f3e6c8]">
        ขอให้เข้าใจตรงกันว่าการทดลองเล่นเป็นการทำความคุ้นเคยกับระบบเท่านั้น
        <strong class="text-[#ecc964]">ผลของแต่ละรอบไม่แน่นอน จึงไม่มีเกมหรือหมวดใดรับประกันว่าจะสร้างกำไรได้ทุกครั้ง</strong>
        ควรเลือกเกมจากกติกา รูปแบบการเดิมพัน และงบประมาณที่เหมาะสมกับตนเอง หากติดปัญหาระหว่างใช้งาน แจ้งแอดมิน SUPERMAX168 ได้ตลอด 24 ชั่วโมง
        พร้อมชื่อเกม เวลา จำนวนเงิน และรายละเอียดของรายการ เพื่อให้ตรวจสอบได้ตรงจุด
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="ขั้นตอนเริ่มใช้งาน SUPERMAX168 ตั้งแต่สมัครสมาชิกจนถึงเข้าเล่นเกม" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f3e6c8]">
        ผู้ใช้งานใหม่สมัคร SUPERMAX168 ผ่านมือถือหรือคอมพิวเตอร์ได้ด้วยตัวเอง และสลับหมวดเกมผ่านบัญชีเดียวได้โดยไม่ต้องสมัครหลายครั้ง
        เริ่มต้นใช้งานได้ง่ายเพียง <strong class="text-[#ecc964]">3 ขั้นตอน</strong> และเป็นลำดับเดียวกันไม่ว่าจะเลือกเล่นหมวดไหน
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#f3e6c8]">
        <li class="flex gap-3"><span class="font-bold text-[#ecc964]">1.</span> เข้าหน้าสมัคร SUPERMAX168 และกรอกข้อมูลตามที่ระบบกำหนด ทำผ่านมือถือหรือคอมพิวเตอร์ได้โดยตรง</li>
        <li class="flex gap-3"><span class="font-bold text-[#ecc964]">2.</span> Login เข้าสู่บัญชีและเลือกช่องทางฝากเครดิตผ่านวอลเลทหรือบัญชีธนาคารที่เปิดให้บริการ</li>
        <li class="flex gap-3"><span class="font-bold text-[#ecc964]">3.</span> ตรวจสอบโปรโมชั่น เลือกหมวดและเกมที่ต้องการ แล้วอ่านกติกากับวงเงินเดิมพันก่อนเริ่มเล่น</li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#f3e6c8]">
        หลังสมัครเรียบร้อยสามารถตรวจสอบเครดิต ประวัติรายการ โปรโมชั่น และสถานะฝากถอนผ่านบัญชีสมาชิกได้โดยตรง
        ควรไล่ดูให้ครบก่อนใช้เครดิตจริง จะช่วยให้เห็นว่ารายการหนึ่งถูกบันทึกและคิดผลมาจากอะไรบ้าง
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ตรวจกติกา อัตราจ่าย และวงเงินเดิมพันของแต่ละหมวดก่อนทำรายการ" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f3e6c8]">
        ข้อมูลที่ควรเปิดดูให้ครบก่อนลงเดิมพันมีอยู่ไม่กี่อย่าง และระบบแสดงไว้ในหน้าเกมให้ตรวจสอบได้อยู่แล้ว
        <strong class="text-[#fff8e2]">ข้อมูลชุดนี้คือสิ่งที่กำหนดว่ารอบหนึ่งคิดผลอย่างไร</strong> จึงควรอ่านให้จบก่อนตัดสินใจว่าจะลงเท่าไร
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f3e6c8]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ecc964]">🃏</span>
          <span><strong class="text-[#ecc964]">บาคาร่าและไฮโล</strong> ดูวิธีนับผลกับอัตราจ่ายของแต่ละประตูหรือแต่ละฝั่งก่อน เพราะแต่ละโต๊ะกำหนดวงเงินต่อรอบไว้ไม่เท่ากัน</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e3e3e4]">🎰</span>
          <span><strong class="text-[#e3e3e4]">สล็อตออนไลน์</strong> ต่างกันที่จำนวนวงล้อ เส้นรางวัล และรอบโบนัส หน้าอธิบายในเกมบอกไว้ว่าสัญลักษณ์ชุดไหนจ่ายอย่างไร</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ecc964]">⚽</span>
          <span><strong class="text-[#ecc964]">เดิมพันฟุตบอล</strong> รูปแบบบิลและอัตราต่อรองเปลี่ยนตามคู่ที่เปิดรับ ควรตรวจสอบรายการแข่งขันกับเวลาปิดรับก่อนยืนยันบิล</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e3e3e4]">🎫</span>
          <span><strong class="text-[#e3e3e4]">หวยออนไลน์</strong> เปิดรับเป็นรอบ แต่ละรอบมีเวลาปิดรับและวงเงินต่อบิลของตัวเอง ให้ยึดข้อมูลที่ระบบแสดงในหน้าแทงเป็นหลัก</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#f3e6c8]">
        รายการเกมและหมวดที่พร้อมใช้งานเปลี่ยนแปลงได้ ควรตรวจสอบรายการล่าสุดจากหน้าเกมในเว็บก่อนเข้าเล่น
        ส่วนรายละเอียดกติกาและเงื่อนไขให้ยึดข้อมูลที่แสดงในตัวเกมโดยตรง และควรกำหนดยอดต่อรอบไว้ล่วงหน้าทุกครั้ง
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ฝากถอนวอลเลท เช็กโปรโมชั่น และดูแลความปลอดภัยของบัญชีสมาชิก" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f3e6c8]">
        สมาชิกจัดการเครดิตได้เองโดยเลือกใช้วอลเลทหรือบัญชีธนาคารจากช่องทางที่เว็บไซต์เปิดรองรับ
        <strong class="text-[#ecc964]">ทำรายการฝาก ส่งคำขอถอน และติดตามสถานะผ่านมือถือได้โดยตรง</strong>
        ช่วยลดขั้นตอนและไม่จำเป็นต้องแจ้งรายการกับเจ้าหน้าที่ทุกครั้ง ส่วนชื่อบัญชี จำนวนเงิน ยอดขั้นต่ำ และวงเงินของแต่ละช่องทาง
        ควรตรวจสอบก่อนทำธุรกรรมทุกครั้ง เนื่องจากธนาคารหรือวอลเลทแต่ละประเภทอาจมีเงื่อนไขแตกต่างกัน
      </p>

      <ul class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#f3e6c8]">
        <li class="flex gap-3">
          <span class="text-[#ecc964]" aria-hidden="true">•</span> โปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตรวจสอบสิทธิ์ได้หลัง Login แต่ละรายการอาจกำหนดยอดที่ใช้คำนวณ รอบรับโบนัส เกมที่เข้าร่วม และเงื่อนไขการถอนต่างกัน ควรอ่านรายละเอียดให้ครบก่อนกดรับ
        </li>
        <li class="flex gap-3">
          <span class="text-[#e3e3e4]" aria-hidden="true">•</span> หน้านี้อธิบายการใช้งานและการทำความคุ้นเคยกับระบบเท่านั้น การเดิมพันจริงต้องสมัครสมาชิกและฝากเครดิตผ่านช่องทางที่เปิดให้บริการก่อน
        </li>
        <li class="flex gap-3">
          <span class="text-[#ecc964]" aria-hidden="true">•</span> หากเครดิตไม่เข้า รายการถอนค้าง หรือสถานะธุรกรรมไม่อัปเดต ให้ตรวจสอบประวัติธุรกรรมในบัญชีก่อน และเก็บหลักฐานรายการไว้จนกว่าการตรวจสอบจะเสร็จสิ้น
        </li>
        <li class="flex gap-3">
          <span class="text-[#e3e3e4]" aria-hidden="true">•</span>
          <strong class="text-[#fff8e2]">ตั้งรหัสผ่านที่คาดเดายากและไม่เปิดเผยรหัสผ่านหรือ OTP แก่บุคคลอื่น</strong> ไม่ว่าจะเป็นการติดต่อจากช่องทางใดก็ตาม
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#f3e6c8]">
        หากพบปัญหาสมัครสมาชิก Login ไม่ได้ เข้าเกมไม่ได้ ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง หรือโปรโมชั่นไม่แสดง ติดต่อแอดมิน SUPERMAX168 ได้ตลอด 24 ชั่วโมง พร้อมแจ้งชื่อเกม เวลา จำนวนเงิน
        และช่องทางที่ใช้ทำรายการ <strong class="text-[#ecc964]">การเดิมพันมีความเสี่ยง ควรกำหนดงบประมาณให้เหมาะสมทุกครั้ง</strong>
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก SUPERMAX168"
          class="flex items-center justify-center rounded-lg border border-[#d2a43b]/70 bg-gradient-to-r from-[#f9e38b] via-[#ecc964] to-[#ba8219] px-8 py-3 font-black text-[#030201] shadow-[0_0_15px_rgba(236,201,100,0.30)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ SUPERMAX168"
          class="flex items-center justify-center rounded-lg border border-[#e3e3e4]/45 bg-transparent px-8 py-3 font-bold text-[#e3e3e4] transition-all hover:scale-105 hover:border-[#e3e3e4] hover:bg-[#1b140b]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>

  <Navfoot />
</MainLayout>
