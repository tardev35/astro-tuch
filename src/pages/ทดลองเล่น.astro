---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { pageGraph } from "../lib/schema";

// NEXT55 เป็นคาสิโนออนไลน์เว็บตรงครบวงจรแบบ One-Stop Service ครบห้าหมวด —
// บาคาร่าและคาสิโนสด · สล็อต · ยิงปลา · หวยรัฐบาล ลาว ฮานอย · แทงบอลและกีฬา
// หน้านี้จึงหมายถึงการทำความรู้จักระบบและตัวเกมก่อนเดิมพันด้วยเครดิตจริง:
// ขั้นตอนเริ่มใช้งานบนมือถือ การตรวจกติกาและช่วงเดิมพันของแต่ละเกม
// โปรโมชั่นที่กดรับสิทธิ์เองได้ผ่านหน้าเว็บ และการติดต่อแอดมินเมื่อติดปัญหา
// (หวยเป็นเพียงหนึ่งในห้าหมวด ไม่ใช่เว็บหวย — ห้ามใส่ลิงก์ /ตรวจหวย หรือ /แนวทาง
// สองหน้านั้นปิดอยู่ใน src/pages-disabled/ สำหรับแบรนด์คาสิโน)
//
// แบรนด์เก่าเคยวางแกลเลอรี 12 การ์ด (gamedemo7..18.webp) ไว้ที่หน้านี้ ถูกถอดออกไปตั้งแต่
// สิบรอบรีแบรนด์ก่อน และไม่มีการ import แล้ว — อย่านำกลับมา ลำพังการ import ก็ทำให้ไฟล์ถูก
// emit ลง dist/ และ verify-build จะแดงถ้ามีรูปที่ไม่มีใคร render ทั้งชุด
//
// ทุกข้อความอ้างอิงบรีฟของแบรนด์นี้เท่านั้น: เว็บตรง 100% ไม่ผ่านเอเย่นต์ ·
// บาคาร่าและคาสิโนสดถ่ายทอดสดระดับ Full HD · สล็อตลิขสิทธิ์แท้ · เกมยิงปลา ·
// หวยรัฐบาล ลาว ฮานอย จ่ายเต็มไม่มีเลขอั้น · แทงบอลทุกลีก ค่าน้ำดี ·
// เดิมพันเริ่มต้นเพียง 1 บาท · โปรโมชั่นแจกทุกยูสทุกวัน แนะนำเพื่อน 0.8%
// ถอนเป็นเงินสดได้ · คืนยอดเสีย 0.3% ทุกยอดการเล่น ·
// สมัคร 3 ขั้นตอน (OTP · ผูกบัญชีธนาคารหรือ TrueMoney Wallet ชื่อเดียวกับผู้สมัคร ·
// ตั้งรหัสผ่าน) · ฝาก-ถอนออโต้ภายใน 5 วินาที ไม่มีขั้นต่ำ ทุกธนาคารและวอลเลท
// ทำรายการเองได้ตลอด 24 ชั่วโมง · รองรับมือถือ iOS/Android แท็บเล็ต พีซี
// ผ่านเบราว์เซอร์โดยไม่ต้องโหลดแอปพลิเคชัน · แอดมิน Line Official 24 ชั่วโมง
// ไม่มีการอ้างเลขใบอนุญาต ปีที่ก่อตั้ง จำนวนสมาชิก ตัวเลข RTP การันตีผลกำไร
// หรือชื่อค่ายเกมรายใดที่บรีฟไม่ได้ระบุ
//
// Announcement รอบนี้หมุนมาใช้ Announcement3 ทั้งเว็บ — default message ของไฟล์นั้น
// เป็นข้อความของ NEXT55 อยู่แล้ว จึงเรียกแบบ bare ได้ ห้ามส่ง prop message
//
// พาเลตต์ NEXT55 ไม่มีสีน้ำเงิน ฟ้า หรือทองเลย — แดงโลโก้ #cd1437 นำโครงสร้าง
// แดงสว่าง #f0435f สำหรับ hover ไอคอน และข้อควรระวัง ชมพูอ่อน #ffb3bf ใช้กับ
// <strong> ในเนื้อความ พื้นการ์ดกราไฟต์ #17181c เนื้อความ #d5dae2
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 153
const pageDescription = "หน้าทดลองเล่น NEXT55 แนะนำวิธีเริ่มใช้งานตั้งแต่สมัครสมาชิกบนมือถือ ฝากถอนออโต้ไม่มีขั้นต่ำ เลือกเกมบาคาร่า สล็อต ยิงปลา หวย บอล จนถึงตรวจกติกาก่อนลงเงิน";

const graph = pageGraph(Astro, {
  name: "ทดลองเล่น NEXT55 ทำความรู้จักระบบและเกมทุกหมวดก่อนเดิมพันจริง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title="ทดลองเล่น NEXT55 ลองใช้ระบบก่อนเดิมพัน เริ่มต้น 1 บาท ทุกเกม" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่น NEXT55 ทำความรู้จักระบบและเกมทุกหมวดก่อนเดิมพันจริง" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d5dae2]">
        <strong class="text-[#ffb3bf]">NEXT55</strong> คือคาสิโนออนไลน์เว็บตรง 100% ไม่ผ่านเอเย่นต์ ที่รวมเกมลิขสิทธิ์แท้จากทุกค่ายดังไว้ในบัญชีเดียว ทั้งบาคาร่าและคาสิโนสดระดับ Full HD สล็อตออนไลน์ เกมยิงปลา
        หวยรัฐบาล หวยลาว หวยฮานอย ไปจนถึงแทงบอลและกีฬาทุกลีกดัง หน้านี้จึงเปิดไว้ให้ผู้เริ่มต้นได้
        <strong class="text-[#ffb3bf]">ทำความคุ้นเคยกับขั้นตอนใช้งาน และตรวจกติกา อัตราจ่าย กับช่วงเดิมพันของแต่ละเกม</strong>
        ก่อนเดิมพันด้วยเครดิตของตัวเอง เพราะรายละเอียดเหล่านี้ต่างกันไปตามหมวดเกมและรูปแบบการเดิมพันที่เลือก
      </p>

      <p class="text-left text-base leading-relaxed text-[#d5dae2]">
        ขอให้เข้าใจตรงกันว่าการทดลองเล่นเป็นการทำความคุ้นเคยกับระบบเท่านั้น
        <strong class="text-[#f0435f]">ผลลัพธ์ของเกมไม่สามารถรับประกันกำไรหรือผลชนะได้ทุกครั้ง</strong>
        ควรเลือกเกมจากกติกา รูปแบบการเดิมพัน และงบประมาณที่เหมาะสมกับตนเอง หากติดปัญหาระหว่างใช้งาน แจ้งแอดมิน NEXT55 ผ่าน Line Official ได้ตลอด 24 ชั่วโมง พร้อมชื่อเกม เวลา จำนวนเงิน และรายละเอียดของรายการ
        เพื่อให้ตรวจสอบได้ตรงจุด
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="เริ่มใช้งาน NEXT55 บนมือถือด้วยตัวเองใน 3 ขั้นตอน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d5dae2]">
        ผู้ใช้งานใหม่เปิดบัญชี NEXT55 ผ่านระบบสมัครสมาชิกอัตโนมัติได้ด้วยตัวเอง ระบบออกแบบมาให้ใช้งานบนโทรศัพท์มือถือได้อย่างสมบูรณ์แบบ และใช้บัญชีเดียวเข้าเล่นได้ครบทุกหมวดเกมโดยไม่ต้องสมัครหลายบัญชี
        ใช้เวลาไม่ถึง 1 นาทีด้วย
        <strong class="text-[#ffb3bf]">3 ขั้นตอน</strong> และเป็นลำดับเดียวกันไม่ว่าจะเลือกเล่นเกมไหน
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#d5dae2]">
        <li class="flex gap-3">
          <span class="font-bold text-[#f0435f]">1.</span>
          <span><strong class="text-[#ffb3bf]">กรอกเบอร์โทรศัพท์</strong> ระบุเบอร์มือถือของคุณเพื่อรับรหัส OTP สำหรับยืนยันตัวตนและรักษาความปลอดภัยของบัญชี</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#f0435f]">2.</span>
          <span>
            <strong class="text-[#ffb3bf]">ผูกบัญชีธนาคารหรือวอลเลท</strong> เลือกธนาคารหรือ TrueMoney Wallet พร้อมกรอกเลขบัญชี โดยชื่อ-นามสกุลต้องตรงกับข้อมูลที่ใช้สมัครเท่านั้น เพื่อให้ระบบฝาก-ถอนออโต้ทำงานได้ทันที
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#f0435f]">3.</span>
          <span><strong class="text-[#ffb3bf]">ตั้งรหัสผ่าน</strong> กำหนด Username และ Password จากนั้นล็อคอินเข้าสู่ระบบ ฝากเงินแบบไม่มีขั้นต่ำ ทุน 1 บาท เลือกเกมที่สนใจ แล้วเริ่มสนุกได้ทันที</span>
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#d5dae2]">
        หลังเปิดบัญชีเรียบร้อยสามารถตรวจสอบเครดิต ประวัติฝากถอน โปรโมชั่น และรายการใช้งานผ่านหน้าเว็บไซต์ได้โดยตรง ควรไล่ดูให้ครบก่อนใช้เครดิตจริง
        จะช่วยให้เห็นว่ารายการหนึ่งถูกบันทึกและคิดผลมาจากอะไรบ้าง
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ตรวจกติกา อัตราจ่าย และช่วงเดิมพันของแต่ละเกมก่อนยืนยัน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d5dae2]">
        ข้อมูลที่ควรเปิดดูให้ครบก่อนลงเดิมพันมีอยู่ไม่กี่อย่าง และระบบแสดงไว้ในหน้าเกมให้ตรวจสอบได้อยู่แล้ว
        <strong class="text-[#ffb3bf]">ข้อมูลชุดนี้คือสิ่งที่กำหนดว่ารอบหนึ่งคิดผลอย่างไร</strong> จึงควรอ่านให้จบก่อนตัดสินใจว่าจะลงเท่าไร
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#d5dae2]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f0435f]">🃏</span>
          <span>
            <strong class="text-[#ffb3bf]">กติกาโต๊ะบาคาร่าและคาสิโนสด</strong> เป็นการถ่ายทอดสัญญาณภาพสดจากคาสิโนชั้นนำที่ภาพคมชัดระดับ Full HD แต่ละโต๊ะกำหนดรูปแบบการวางเดิมพันและวงเงินต่อตาไว้ไม่เท่ากัน
            ตรวจที่หน้าโต๊ะก่อนเข้าเล่น
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#cd1437]">🎰</span>
          <span>
            <strong class="text-[#ffb3bf]">กติกาและรอบพิเศษของเกมสล็อต</strong> หน้าอธิบายในตัวเกมบอกไว้ว่าสัญลักษณ์ชุดใดนับเป็นรางวัล และฟีเจอร์รอบพิเศษเปิดเมื่อใด เป็นเกมลิขสิทธิ์แท้ทุกค่าย ควรอ่านก่อนเลือกเกม
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f0435f]">🐟</span>
          <span>
            <strong class="text-[#ffb3bf]">ระดับกระสุนและโต๊ะของเกมยิงปลา</strong> แต่ละโต๊ะกำหนดค่ากระสุนต่อนัดและชนิดปลาไว้ต่างกัน เลือกโต๊ะที่ค่ากระสุนเหมาะกับงบของตัวเองก่อนเข้าเล่น
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#cd1437]">🎫</span>
          <span>
            <strong class="text-[#ffb3bf]">ประเภทหวยและอัตราจ่าย</strong> รับแทงทั้งหวยรัฐบาล หวยลาว และหวยฮานอย จ่ายเต็มไม่มีเลขอั้น แต่ละประเภทมีรอบปิดรับของตัวเอง ควรดูรอบที่เปิดรับล่าสุดก่อนส่งโพย
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f0435f]">⚽</span>
          <span>
            <strong class="text-[#ffb3bf]">ราคาค่าน้ำของบอลและกีฬา</strong> เปิดรับทุกลีกดังทั่วโลกพร้อมรูปแบบการแทงที่หลากหลาย ราคาขยับได้ตามสถานการณ์จริงของแต่ละแมตช์ ให้ยึดราคาที่ระบบแสดง ณ เวลาที่ยืนยันเดิมพันเป็นหลัก
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#cd1437]">🎯</span>
          <span>
            <strong class="text-[#ffb3bf]">ช่วงเดิมพันต่ำสุดและวงเงินสูงสุด</strong> NEXT55 เปิดให้เดิมพันด้วยเงินทุนเริ่มต้นเพียง 1 บาท แต่ตัวเลขต่ำสุด-สูงสุดของแต่ละเกมกำหนดไว้ไม่เท่ากัน ตรวจค่าที่ตั้งอยู่ในเกมก่อนกดยืนยันทุกครั้ง
          </span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#d5dae2]">
        รายชื่อเกมและตารางการแข่งขันที่พร้อมให้บริการเปลี่ยนแปลงได้ ควรตรวจสอบรายการล่าสุดจากหน้าเลือกเกมในเว็บก่อนเข้าเล่น
        <strong class="text-[#f0435f]">ทุกเกมเป็นเกมลิขสิทธิ์แท้ที่ผลของแต่ละรอบไม่แน่นอน ไม่มีเกมใดรับประกันผลล่วงหน้า และช่วงเดิมพันของตัวเกมเป็นคนละเรื่องกับรายการฝาก-ถอนที่ไม่มีขั้นต่ำ</strong>
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ฝาก-ถอนออโต้ กดรับโปรโมชั่นเอง และดูแลความปลอดภัยของบัญชี" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d5dae2]">
        สมาชิกเติมเครดิตได้เองผ่าน<strong class="text-[#ffb3bf]">ระบบฝาก-ถอนเงินอัตโนมัติ (Auto)</strong> ที่ทำรายการเสร็จสิ้น
        <strong class="text-[#f0435f]">ภายใน 5 วินาที</strong> ไม่มีขั้นต่ำทั้งฝากและถอน รองรับทุกธนาคารชั้นนำรวมถึง TrueMoney Wallet ทำรายการฝาก ส่งคำขอถอน และตรวจสอบสถานะรายการผ่านบัญชีของตนเองได้โดยตรงตลอด
        24 ชั่วโมง โดยให้ยึดตัวเลขและสถานะที่ระบบแสดง ณ เวลาทำรายการเป็นหลัก
      </p>

      <ul class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#d5dae2]">
        <li class="flex gap-3">
          <span class="text-[#f0435f]" aria-hidden="true">•</span> โปรโมชั่นแนะนำเพื่อน รับค่าคอมมิชชั่นสูงถึง 0.8% จากทุกยอดการเล่นของเพื่อน เพียงนำลิงก์ส่วนตัวไปแชร์ให้เพื่อนสมัครและเข้าเล่น เป็นรายได้เสริมแบบ
          Passive Income ที่ถอนเป็นเงินสดได้ ตรวจสอบยอดที่นำมาคำนวณได้หลัง Login
        </li>
        <li class="flex gap-3">
