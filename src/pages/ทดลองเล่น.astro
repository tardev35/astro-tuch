---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { pageGraph } from "../lib/schema";

// PREMSUK365 เป็นเว็บหวยออนไลน์ ไม่ใช่คาสิโน/สล็อต หน้านี้จึงหมายถึงการทำความรู้จัก
// ระบบส่งโพย ประเภทเลข วงเงินที่ระบบเปิดรับ และอัตราจ่าย ก่อนแทงด้วยเครดิตจริง
//
// แบรนด์เก่าเคยวางแกลเลอรี 12 การ์ด (gamedemo7..18.webp) ไว้ที่หน้านี้ ถูกถอดออกไปตั้งแต่
// เจ็ดรอบรีแบรนด์ก่อน และไม่มีการ import แล้ว — อย่านำกลับมา เหตุผลมีสองชั้น: ลำพังการ import
// ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดงถ้ามีรูปที่ไม่มีใคร render ทั้งชุด
// ยังเป็นภาพของ "askmeslot" ซึ่งเป็นโลโก้เว็บอื่น การนำกลับมาคือการโชว์แบรนด์คู่แข่ง
// บนหน้าเว็บของ PREMSUK365
//
// ทุกข้อความอ้างอิง src/assets/content.txt เท่านั้น ไม่มีการอ้างใบอนุญาต การจดทะเบียน
// ปีที่ก่อตั้ง รางวัล จำนวนสมาชิก หรือการันตีผลกำไร
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 153
const pageDescription = "หน้าทดลองเล่นของ PREMSUK365 แนะนำวิธีทำความรู้จักระบบแทงหวยออนไลน์ ตั้งแต่เลือกเลข ดูวงเงินที่ระบบเปิดรับ ตรวจอัตราจ่าย และเช็กบิลย้อนหลัง ก่อนส่งโพยจริง";

const graph = pageGraph(Astro, {
  name: "ทดลองเล่น PREMSUK365 ทำความรู้จักระบบส่งโพยก่อนแทงด้วยเครดิตจริง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title="ทดลองเล่น PREMSUK365 ลองใช้ระบบส่งโพยหวยออนไลน์ก่อนแทงด้วยเครดิตจริง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่น PREMSUK365 ทำความรู้จักระบบส่งโพยก่อนแทงด้วยเครดิตจริง" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e4e7d8]">
        <strong class="text-[#f7e8b4]">PREMSUK365</strong> เป็นเว็บแทงหวยออนไลน์ที่ออกแบบให้ใช้งานง่ายจากบัญชีเดียว รองรับทั้งสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์
        หน้านี้จึงเปิดไว้ให้ผู้เริ่มต้นได้<strong class="text-[#f7e8b4]">ทำความรู้จักขั้นตอนส่งโพย ดูวงเงินที่ระบบเปิดรับ และตรวจสอบอัตราจ่าย</strong>
        ก่อนยืนยันการแทงด้วยเครดิตของตัวเอง เพราะหวยแต่ละประเภทและแต่ละรอบกำหนดเงื่อนไขไว้ไม่เหมือนกัน
      </p>

      <p class="text-left text-base leading-relaxed text-[#e4e7d8]">
        ขอให้เข้าใจตรงกันว่าการทดลองเล่นเป็นการทำความคุ้นเคยกับระบบเท่านั้น
        <strong class="text-[#f7e8b4]">ผลของหวยแต่ละรอบไม่แน่นอน ไม่มีเลขหรือสูตรใดรับประกันผลได้เสียล่วงหน้า</strong>
        หากติดปัญหาระหว่างใช้งาน สามารถแจ้งแอดมิน PREMSUK365 ได้ทันที พร้อมประเภทหวย รอบเดิมพัน เวลา และรายละเอียดของรายการ เพื่อให้เจ้าหน้าที่ตรวจสอบได้ตรงจุด
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="เลขที่ PREMSUK365 เปิดรับ และวงเงินที่ระบบแสดงก่อนยืนยัน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e4e7d8]">
        PREMSUK365 ให้ตรวจสอบการรับแทงได้ตั้งแต่ก่อนส่งโพย สิ่งที่ควรเปิดดูให้ครบคือ
        <strong class="text-[#f7e8b4]">เลขที่รอบนั้นเปิดรับ วงเงินที่ระบบรับได้ และอัตราจ่ายของประเภทหวยที่เลือก</strong>
        เพราะข้อมูลชุดนี้บอกว่ารายการคิดผลอย่างไรและแทงได้สูงสุดเท่าไร แทนที่จะเลือกจากคำว่าเลขมาแรงเพียงอย่างเดียว
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#e4e7d8]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e3c56a]">🎯</span>
          <span><strong class="text-[#f7e8b4]">เลขดังและเลขกระแส</strong> เป็นเลขที่บางรอบมีผู้เลือกเดิมพันจำนวนมาก ควรดูว่ารอบนั้นยังรับเลขที่ต้องการอยู่หรือไม่ก่อนกดยืนยัน</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e3c56a]">🎱</span>
          <span><strong class="text-[#f7e8b4]">เลขอั้น</strong> ตรวจสอบได้จากหน้าส่งโพยเช่นกัน หากเลขใดมีข้อจำกัด ระบบควรแสดงรายละเอียดก่อนสมาชิกยืนยันรายการ</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e3c56a]">💰</span>
          <span><strong class="text-[#f7e8b4]">วงเงินที่ระบบเปิดรับ</strong> เป็นตัวเลขเฉพาะรอบ ให้ยึดข้อมูลที่ระบบแสดง ณ เวลาที่ส่งโพย ไม่ใช่ตัวเลขที่จำมาจากรอบก่อน</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e3c56a]">🧾</span>
          <span><strong class="text-[#f7e8b4]">ประวัติบิล</strong> เมื่อส่งโพยสำเร็จควรเก็บบิลไว้ตรวจผลและยอดรางวัลภายหลัง เพราะเช็กย้อนหลังได้เองจากบัญชีสมาชิก</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#a9bda9]">
        ส่วนเรื่อง<strong class="text-[#a9bda9]">ยอดแทงขั้นต่ำและวงเงินสูงสุด</strong> ตัวเลขจริงขึ้นอยู่กับประเภทหวยและรอบเดิมพัน จึงควรตรวจสอบตัวเลขบนหน้าส่งโพยก่อนยืนยันรายการทุกครั้ง
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ขั้นตอนเริ่มใช้งาน PREMSUK365 ตั้งแต่สมัครจนถึงส่งโพย" as="h2">
    <div class="flex flex-col gap-4">
      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#e4e7d8]">
        <li class="flex gap-3"><span class="font-bold text-[#e3c56a]">1.</span> เปิดหน้าสมัคร PREMSUK365 และกรอกข้อมูลตามที่ระบบกำหนด ทำผ่านมือถือหรือคอมพิวเตอร์ได้โดยตรง</li>
        <li class="flex gap-3"><span class="font-bold text-[#e3c56a]">2.</span> Login เข้าบัญชี แล้วฝากเครดิตผ่านระบบฝากถอนออโต้ด้วยวอลเลทหรือธนาคารที่ระบบรองรับ</li>
        <li class="flex gap-3"><span class="font-bold text-[#e3c56a]">3.</span> เลือกประเภทหวยและรอบที่ต้องการ แล้วเลือกเลขที่มีในใจจากหน้าส่งโพย</li>
        <li class="flex gap-3"><span class="font-bold text-[#e3c56a]">4.</span> ดูวงเงินที่ระบบเปิดรับของเลขนั้น พร้อมอัตราจ่าย เพื่อให้เห็นว่ายอดตามเรทคิดมาจากอะไร</li>
        <li class="flex gap-3"><span class="font-bold text-[#e3c56a]">5.</span> กำหนดยอดแทงที่รับได้ ยืนยันส่งโพย แล้วเก็บบิลไว้เช็กย้อนหลังเมื่อผลออก</li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#e4e7d8]">
        ก่อนแทงจริงควรแบ่งงบออกเป็นหน่วยย่อยไว้ล่วงหน้า เช่น มีทุน 1,000 บาท ให้คิด 1 หน่วยเท่ากับ 10 บาท แล้ววางยอดแทงต่อเลขให้อยู่ในระดับที่รับความผันผวนได้ วิธีนี้
        <strong class="text-[#f7e8b4]">ไม่ได้ทำให้โอกาสถูกรางวัลเพิ่มขึ้น แต่ช่วยให้รู้ล่วงหน้าว่าแต่ละรอบใช้เงินได้เท่าไร</strong>
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="สิ่งที่ควรตรวจสอบก่อนเปลี่ยนมาแทงด้วยเครดิตจริง" as="h2">
    <div class="flex flex-col gap-4">
      <ul class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#e4e7d8]">
        <li class="flex gap-3">
          <span class="text-[#e3c56a]" aria-hidden="true">•</span> หน้านี้อธิบายการใช้งานและการลองเลือกเลขเท่านั้น การแทงจริงต้องสมัครสมาชิกและฝากเครดิตผ่านช่องทางที่เปิดให้บริการก่อน
        </li>
        <li class="flex gap-3">
          <span class="text-[#e3c56a]" aria-hidden="true">•</span> ตรวจอัตราจ่ายบนหน้าส่งโพยให้ครบ เรทที่กำหนดคือเลข 2 ตัวบาทละ 100 และเลข 3 ตัวบาทละ 1,000 แต่บางรอบหรือบางประเภทอาจมีเงื่อนไขเฉพาะ
        </li>
        <li class="flex gap-3">
          <span class="text-[#e3c56a]" aria-hidden="true">•</span> ดูวงเงินที่ระบบเปิดรับของเลขที่เลือกก่อนกดยืนยัน เพราะเลขดังและเลขอั้นแต่ละตัวรับได้ไม่เท่ากันในแต่ละรอบ
        </li>
        <li class="flex gap-3">
          <span class="text-[#e3c56a]" aria-hidden="true">•</span> ตรวจสอบช่องทางฝากเงิน ยอดขั้นต่ำ และวงเงินต่อรายการล่าสุดบนหน้าฝากถอนก่อนยืนยันธุรกรรมทุกครั้ง
        </li>
        <li class="flex gap-3">
          <span class="text-[#e3c56a]" aria-hidden="true">•</span> ตั้งจุดหยุดเมื่อเสียและจุดที่จะพักเมื่อได้กำไรไว้ตั้งแต่ก่อนเริ่ม แล้วหยุดตามแผน ไม่เพิ่มยอดแทงเพื่อไล่เอาเงินคืน
        </li>
        <li class="flex gap-3">
          <span class="text-[#e3c56a]" aria-hidden="true">•</span> เก็บบิลและหลักฐานธุรกรรมไว้เสมอ เพราะเช็กบิลย้อนหลังได้เอง และใช้เป็นข้อมูลให้แอดมินตรวจสอบเมื่อรายการมีปัญหา
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#e4e7d8]">
        หากส่งโพยไม่สำเร็จ เลขที่ต้องการแทงไม่แสดง ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง หรือพบยอดในบิลไม่ตรงกับรายการ แจ้งแอดมิน PREMSUK365 พร้อมประเภทหวย รอบเดิมพัน เวลา และจำนวนเงินได้ทันที
        และควรเก็บข้อมูลบิลไว้จนกว่าการตรวจสอบจะเสร็จสิ้น โดยไม่เปิดเผยรหัสผ่านหรือ OTP แก่บุคคลอื่น
        <strong class="text-[#f7e8b4]">การเดิมพันมีความเสี่ยง ควรกำหนดงบประมาณให้เหมาะสมทุกครั้ง</strong>
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก PREMSUK365"
          class="flex items-center justify-center rounded-lg border border-[#e3c56a]/70 bg-gradient-to-r from-[#f7e8b4] via-[#e3c56a] to-[#8a6a26] px-8 py-3 font-black text-[#020c06] shadow-[0_0_15px_rgba(227,197,106,0.4)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ PREMSUK365"
          class="flex items-center justify-center rounded-lg border border-[#e3c56a]/60 bg-transparent px-8 py-3 font-bold text-[#f7e8b4] transition-all hover:scale-105 hover:border-[#f7e8b4] hover:bg-[#0d3a22]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>

  <Navfoot />
</MainLayout>
