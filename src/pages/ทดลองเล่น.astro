---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";

import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login, /register)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อของ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริง
// ของ BRAZIL999 เท่านั้น
//
// รอบก่อน (แบรนด์ก่อนหน้า) บรีฟระบุ "เกมสด" "เกมโต๊ะ" "หมวดเกมยอดนิยม" และ "ระบบจัดแยก
// แต่ละค่ายให้ค้นหาได้ง่าย" ไว้ ซึ่งบรีฟของ BRAZIL999 ไม่ได้ระบุเลยสักคำ — ทั้งหมดถูก
// ถอดออกทั้งหน้า และแทนด้วย "เกมหลายประเภทจากบัญชีเดียว" กับ "ตรวจสอบรายละเอียดเกม
// โปรโมชั่น และข้อมูลการใช้งานก่อนเริ่มเล่น" ที่บรีฟรอบนี้ระบุจริง
// ห้าม find-and-replace ชื่อแบรนด์ทับของเดิม มันจะทำให้ BRAZIL999 อ้างหมวดเกมและ
// ระบบแยกค่ายที่บรีฟไม่เคยระบุ
//
// บรีฟไม่ได้ระบุว่ามีโหมดเดโมที่ถอนไม่ได้ สิ่งที่บรีฟระบุคือ "รวมเกมหลายประเภทไว้ให้
// เลือกจากบัญชีเดียว" "ตรวจสอบรายละเอียดเกม โปรโมชั่น และข้อมูลการใช้งานก่อนเริ่มเล่น"
// "เข้าถึงแต่ละเมนูได้ง่ายทั้งบนมือถือและคอมพิวเตอร์" — หน้านี้จึงเขียนบนฐานนั้น คือ
// การไล่ดูเมนูและรายละเอียดให้ครบก่อนเดิมพันด้วยเงินจริง ห้ามอ้างกติกาของเครดิตทดลอง
// หรือโหมดเล่นฟรีที่บรีฟไม่ได้พูดถึง
//
// ข้อเท็จจริงทุกบรรทัดมาจากบรีฟรอบนี้เท่านั้น: คาสิโนแท้จากบริษัทโดยตรง ·
// ไม่มีประวัติโกง ตรวจสอบได้ · รวมเกมหลายประเภทไว้ให้เลือกจากบัญชีเดียว ·
// ตรวจสอบรายละเอียดเกม โปรโมชั่น และข้อมูลการใช้งานก่อนเริ่มเล่น ·
// เข้าถึงแต่ละเมนูได้ง่ายทั้งมือถือและคอมพิวเตอร์ · ระบบบัญชีและการจัดการข้อมูลสมาชิก ·
// เข้าสู่ระบบและจัดการรายการผ่านบัญชีส่วนตัว · ตรวจสอบข้อมูล เงื่อนไข และช่องทาง
// อย่างเป็นทางการก่อนทำรายการทุกครั้ง · โบนัสแนะนำเพื่อน 0.8% · โบนัสคืนยอดเสีย 0.3% ·
// ตรวจสอบยอดที่เข้าเกณฑ์ รอบคำนวณ และวิธีรับสิทธิ์ก่อนกดรับ · สมัครเองได้ใน 3 ขั้นตอน ·
// ติดต่อผ่านช่องทางไลน์ได้ 24 ชั่วโมง
// — ห้ามอ้าง บาคาร่า สล็อต หวย บอล เกมสด เกมโต๊ะ เครดิตฟรี ชื่อค่ายเกม ชื่อสตูดิโอ
// ชื่อเกมเฉพาะ เลขใบอนุญาต ปีที่ก่อตั้ง จำนวนสมาชิก ค่า RTP ขั้นต่ำการเดิมพัน
// ชื่อธนาคาร "ฝากถอนไม่มีขั้นต่ำ" "ออโต้ 10 วินาที" หรือการันตีว่าจะชนะ
//
// ศัพท์ของบรีฟรอบนี้คือ **ไลน์ / ช่องทางไลน์** ไม่ใช่ "ไลน์แอด" และไม่ใช่
// "LINE OFFICIAL" ซึ่งเป็นศัพท์ของสองแบรนด์ก่อนหน้า
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: แกลเลอรีเดโม 12 การ์ด (gamedemo7..18.webp) ยังอยู่
// บนดิสก์แต่เป็นของแบรนด์อื่น — gamedemo7.webp มีโลโก้ "askmeslot" และ
// gamedemo15.webp มีโลโก้ "askmebet" ของเว็บเจ้าอื่นพิมพ์ทับอยู่ในรูป ส่วน
// gamedemo13.webp เป็นการ์ด "Sexy Slot" ภาพโป๊เปลือย ห้ามนำกลับมา import เด็ดขาด
// (ห้ามลบไฟล์ เป็นอินเวนทอรี) ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ
// verify-build จะแดง
// slide1.png / slide2.png ของดรอปนี้เป็นของ index และ /promotion — ไม่ดึงมาใช้ซ้ำที่นี่
// banner1/banner1-mobile เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า และ
// banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กค้างของลูกค้าเจ้าอื่น ห้าม import
//
// Announcement รอบนี้หมุนจาก Announcement5 มาเป็น Announcement2 ทั้งเว็บ —
// default message ของไฟล์นั้นเป็นคอปปี้ของ BRAZIL999 แล้ว จึงเรียกแบบ bare เหมือน
// index.astro ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ BRAZIL999 เป็น **เขียว + เงินโครเมียม** ตามโลโก้ (BRAZIL เงินขัดเงา /
// 999 เขียวสด) ทองเป็นแอ็กเซนต์ที่สามเท่านั้น ห้ามใช้นำหน้า:
// พื้น #040a05 · การ์ด #0a1a0c · ผิวยก #123a18 · ขอบลึก #1c5a26 ·
// เขียวแบรนด์ #22c55e · เขียวลึก #0a6b18 · เขียวสว่าง #7cf25c · เขียวอ่อนสุด #b6ff9c ·
// เงินกลาง #aab4bf · เงินสว่าง #f1f5f9 · เงินหม่น #6b7580 ·
// เนื้อความ #dfeadd (BRAND_TEXT) · เน้นใน strong #f4fbf2
// เลขลำดับใน <ol> และไอคอนใน <ul> สลับเขียว/เงินให้คู่สีอ่านออกจากหน้าเอง —
// ชุดทอง/เงินอุ่นของแบรนด์ก่อนหน้าถูกแทนครบทุกจุดแล้ว แบรนด์นี้ไม่มีทองเป็นสีหลักเลย
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลางที่ orchestrator รีธีมรอบนี้) — การ์ดตั้ง
// สีเนื้อความไว้ให้แล้ว ย้ำไว้บนย่อหน้าอีกชั้นเพื่อให้สีของ body copy อ่านออกจาก
// ตัวหน้าเอง และเน้นด้วย #f4fbf2 ในคำสำคัญ
//
// ไม่มีลิงก์ /ตรวจหวย หรือ /แนวทาง: BRAZIL999 เป็นแบรนด์คาสิโน สองหน้านั้นอยู่ใน
// src/pages-disabled/ รอบนี้ href ที่ชี้ route ซึ่งไม่มีใน dist/ จะทำให้ build แดง
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 157
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "ทดลองเล่น BRAZIL999 ไล่ดูเมนูและเกมหลายประเภทที่รวมไว้ในบัญชีเดียว พร้อมตรวจสอบรายละเอียดเกม โปรโมชั่น และข้อมูลการใช้งานให้ครบก่อนเริ่มเดิมพันด้วยเงินจริง";

const pageTitle = "ทดลองเล่น BRAZIL999 ไล่ดูเกมและรายละเอียดให้ครบก่อนเดิมพันจริง";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dfeadd]">
        <strong class="text-[#f4fbf2]">BRAZIL999</strong> นำเสนอระบบคาสิโนออนไลน์ที่เชื่อมต่อจากบริษัทโดยตรงตามข้อมูลของเว็บไซต์ พร้อมรวมเกมหลายประเภทไว้ให้เลือกจากบัญชีเดียว หน้านี้จึงเปิดไว้ให้คนที่ยังไม่คุ้นกับระบบได้
        <strong class="text-[#f4fbf2]">ไล่ดูเมนู รายละเอียดเกม และข้อมูลการใช้งานให้ครบก่อนเดิมพันด้วยเงินจริง</strong>
        ตั้งแต่โครงของเมนูหน้าแรก ไปจนถึงข้อมูลที่ระบบแสดงไว้ก่อนเริ่มเล่น
      </p>

      <p class="text-left text-base leading-relaxed text-[#dfeadd]">
        เพราะ<strong class="text-[#f4fbf2]">แต่ละเมนูถูกจัดไว้ให้เข้าถึงได้ง่ายทั้งบนมือถือและคอมพิวเตอร์</strong>
        การเปิดดูให้ทั่วก่อนจึงช่วยให้เห็นว่าเกมแต่ละประเภทอยู่ตรงไหน สลับไปยังรายการที่สนใจได้จากจุดใด และรู้ล่วงหน้าว่าต้องตรวจข้อมูลอะไรบ้างก่อนกดเข้าเล่นครั้งแรกจากบัญชีเดียว
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ไล่ดูเมนูและเกมของ BRAZIL999 ให้ครบก่อนเลือกเกมแรก" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dfeadd]">
        จุดที่ช่วยให้เริ่มต้นได้เร็วที่สุดคือ<strong class="text-[#f4fbf2]">เกมหลายประเภทถูกรวมไว้ให้เลือกจากบัญชีเดียว และมีเมนูจัดไว้ให้เข้าถึงได้ง่าย</strong>
        สมาชิกเลือกรายการที่สนใจได้จากหน้าแรก ดูรายละเอียดของเกมนั้นต่อได้ก่อนเริ่มเล่น ไม่ต้องไล่หาว่าเกมที่อยากเล่นอยู่ตรงไหน
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#dfeadd]">
        <li class="flex gap-3">
          <span class="font-bold text-[#7cf25c]">1.</span>
          <span><strong class="text-[#f4fbf2]">เปิดหน้าแรกของ BRAZIL999 ก่อน</strong> เมนูถูกจัดไว้ให้เข้าถึงได้ง่ายตั้งแต่หน้าแรก จึงเห็นภาพรวมของสิ่งที่เปิดให้เลือกได้ในหน้าเดียว</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#aab4bf]">2.</span>
          <span>
            <strong class="text-[#f4fbf2]">ไล่ดูเกมแต่ละประเภทให้ครบ</strong> ระบบรวมเกมหลายประเภทไว้ให้เลือกจากบัญชีเดียว แต่ละรายการมีรูปแบบและรายละเอียดของตัวเองตามที่เว็บไซต์แสดงไว้
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#7cf25c]">3.</span>
          <span>
            <strong class="text-[#f4fbf2]">อ่านรายละเอียดเกมก่อนเริ่มเล่น</strong> ข้อมูลชุดนี้ระบบแสดงไว้ให้ดูตั้งแต่ก่อนกดเข้าเกม อ่านให้จบก่อนตัดสินใจว่าจะเลือกรายการไหน
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#aab4bf]">4.</span>
          <span>
            <strong class="text-[#f4fbf2]">เปิดดูโปรโมชั่นที่เว็บไซต์อัปเดตไว้</strong> ทั้งโบนัสแนะนำเพื่อนและโบนัสคืนยอดเสียมีเงื่อนไขและรอบรับสิทธิ์ของตัวเอง ควรตรวจสอบรายละเอียดก่อนกดรับทุกครั้ง
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#7cf25c]">5.</span>
          <span>
            <strong class="text-[#f4fbf2]">ลองเปิดจากเครื่องที่จะใช้จริงอีกครั้ง</strong> ระบบเข้าถึงได้ทั้งมือถือและคอมพิวเตอร์จากบัญชีเดียว เปิดรายการเดียวกันเทียบกันดูก่อน แล้วเลือกอุปกรณ์ที่ใช้งานได้ถนัดกว่า
          </span>
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#dfeadd]">
        <strong class="text-[#f4fbf2]">รายการที่เปิดให้บริการและโปรโมชั่นที่เปิดรับสิทธิ์เปลี่ยนแปลงได้ตามช่วงเวลา จึงควรตรวจสอบรายละเอียดเกมและข้อมูลการใช้งานจากช่องทางอย่างเป็นทางการของเว็บไซต์ทุกครั้งก่อนเริ่มเล่น</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title="จุดที่ควรตรวจให้ครบก่อนเดิมพันด้วยเงินจริง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dfeadd]">
        การไล่ดูระบบมีประโยชน์ที่สุดเมื่อมองมันเหมือนการอ่านคู่มือ ไม่ใช่การลุ้นรางวัล
        <strong class="text-[#f4fbf2]">เป้าหมายคือรู้จักระบบให้ครบก่อนที่เงินจริงจะเข้ามาเกี่ยวข้อง</strong>
        หกเรื่องด้านล่างคือสิ่งที่ควรเก็บข้อมูลไว้ระหว่างเปิดดู
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#dfeadd]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#7cf25c]">🗂️</span>
          <span>
            <strong class="text-[#f4fbf2]">โครงของเมนูและตำแหน่งของแต่ละรายการ</strong> จำให้ได้ว่าเกมแต่ละประเภทอยู่ตรงไหน และสลับระหว่างกันได้จากจุดใด จะได้ไม่ต้องค้นหาใหม่ทุกครั้งที่อยากเปลี่ยนเกม
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#aab4bf]">🎲</span>
          <span>
            <strong class="text-[#f4fbf2]">รายละเอียดของรายการที่สนใจ</strong> ระบบแสดงข้อมูลชุดนี้ไว้ก่อนเริ่มเล่น เปิดอ่านเทียบกันหลายรายการดูก่อน จะได้เห็นว่ารูปแบบไหนตรงกับที่ตัวเองสนใจ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#7cf25c]">🔐</span>
          <span>
