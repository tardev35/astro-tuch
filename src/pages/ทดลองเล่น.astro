---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login, /register)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อของ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริง
// ของ WIN999 เท่านั้น
//
// แบรนด์ก่อนหน้าเป็นเว็บล็อตเตอรีออนไลน์ ทั้งหน้าพูดเรื่องรอบจับรางวัล อัตราจ่าย
// ตัวเลข ใบแทง และคำว่าไม่ผ่านคนกลาง — WIN999 เป็น **เว็บคาสิโนออนไลน์** คำชุดนั้น
// ถูกถอดออกทั้งหมด ห้าม find-and-replace ชื่อแบรนด์ทับประโยคเดิม มิฉะนั้นเว็บคาสิโน
// จะไปอ้างสินค้าคนละตัวที่ไม่มีอยู่ในบรีฟรอบนี้เลยสักคำ
//
// บรีฟไม่ได้ระบุว่ามีโหมดเดโม เครดิตทดลอง หรือเครดิตฟรีที่ถอนไม่ได้ — จึงห้ามสัญญา
// สินค้าตัวนั้น "ทดลองเล่น" ที่หน้านี้หมายถึงการไล่ดูหมวดเกม หน้าเครดิต ประวัติรายการ
// และขั้นตอนฝากถอนให้ครบก่อนลงเงินจริง ไม่ใช่การหมุนสล็อตเดโมหรือเล่นบาคาร่าฟรี
//
// ข้อเท็จจริงทุกบรรทัดมาจากบรีฟรอบนี้เท่านั้น (brand-spec + content.txt): รวมเกม
// คาสิโนออนไลน์หลายรูปแบบ ทั้งบาคาร่า สล็อต เกมไพ่ และเกมอื่นตามค่ายที่ระบบรองรับ ·
// Login ผ่านเว็บเบราว์เซอร์ เลือกหมวดเดิมพันจากบัญชีเดียว · ตรวจสอบเครดิต ประวัติ
// รายการ และรายละเอียดเกมได้ด้วยตัวเอง · รองรับมือถือ แท็บเล็ต คอมพิวเตอร์ ·
// ฝากถอนผ่านระบบบัญชีบริษัท ตรวจชื่อบัญชี จำนวนเงิน ข้อมูลปลายทางก่อนโอน ·
// รายการถอนควรตรวจสถานะและเก็บหลักฐานไว้ · บันทึกทางเข้าล่าสุดจากช่องทางหลัก ·
// บางค่ายอาจปิดปรับปรุงชั่วคราว · สมัครเอง 3 ขั้นตอน · โบนัสคืนยอดเสีย 0.3% ·
// โบนัสแนะนำเพื่อน 0.8% · แอดมินตอบแชท 24 ชั่วโมง
// — ห้ามอ้างคำชุดล็อตเตอรีทั้งหมด (ดูรายการเต็มใน brand-spec §8) รวมถึงชื่อค่ายเกม
// เจาะจง RTP เกมยิงปลา เครดิตฟรี เลขใบอนุญาต ปีที่ก่อตั้ง จำนวนสมาชิก ชื่อธนาคาร
// หรือการันตีว่าจะชนะ
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: banner1/banner1-mobile/og.png เป็นของ glob ที่
// MainLayout ปักไว้ ห้ามอ้างจากหน้า · slide1.png/slide2.png ของดรอปนี้เป็นของ index
// และ /promotion ไม่ดึงมาใช้ซ้ำที่นี่ · banner2/banner3/slide3/slide4 เป็นของค้างจาก
// แบรนด์ก่อน ห้าม import (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ
// verify-build จะแดง)
//
// Announcement รอบนี้หมุนจากตัวของแบรนด์ก่อนมาเป็น AnnouncementPremium ทั้งเว็บ —
// default message ของไฟล์นั้นเป็นคอปปี้ของ WIN999 แล้ว จึงเรียกแบบ bare
// เหมือน index.astro ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ WIN999 เป็น **ทองบนดำ** ตามโลโก้ (WIN ทอง / 999 ขาว):
// พื้นเพจ #050505 · ผิวการ์ด #101010 · ผิวการ์ดอุ่น #191712 · ทองสว่าง #fdda04 ·
// ทองแบรนด์ #fcc403 · ทองกลาง #e0a800 · ทองลึก #8a6502 · เนื้อความ #e9e4d6
// (BRAND_TEXT) · เน้นใน strong #fffbea · ตัวอักษรบนพื้นทอง #120d02 ·
// แสงเรือง rgba(252,196,3,*) — เลขลำดับใน <ol> และไอคอนใน <ul> สลับทองแบรนด์กับ
// ทองสว่างให้คู่สีของแบรนด์อ่านออกจากหน้าเอง
// ชุดแดง-ทองบนพื้นแดงเกือบดำของแบรนด์ก่อน (รายการ hex เต็มอยู่ใน brand-spec §2)
// ถูกแทนครบทุกจุดแล้ว ทั้งคลาส Tailwind, raw hex และ rgba() ที่ใช้ทำแสงเรือง
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลางที่ orchestrator รีธีมรอบนี้) — การ์ดตั้ง
// สีเนื้อความไว้ให้แล้ว ย้ำไว้บนย่อหน้าอีกชั้นเพื่อให้สีของ body copy อ่านออกจาก
// ตัวหน้าเอง และเน้นด้วย #fffbea ในคำสำคัญ
//
// หน้านี้ไม่ลิงก์ไปสองหน้าล็อตเตอรีที่จอดอยู่ใน src/pages-disabled/ เพราะรอบนี้เป็น
// แบรนด์คาสิโน — href ที่ชี้ route ซึ่งไม่มีใน dist/ จะทำให้ build แดง
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 157
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "ทดลองเล่น WIN999 ไล่ดูหมวดบาคาร่า สล็อต และเกมไพ่ตามค่ายที่ระบบรองรับ ตรวจเครดิต โปรโมชั่น และขั้นตอนฝากถอนผ่านบัญชีบริษัทให้ครบ ก่อนเริ่มเดิมพันด้วยเงินจริง";

const pageTitle = "ทดลองเล่น WIN999 ไล่ดูหมวดเกมคาสิโนและระบบก่อนเดิมพันจริง";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e9e4d6]">
        <strong class="text-[#fffbea]">WIN999</strong> รวมเกมคาสิโนออนไลน์หลายรูปแบบไว้ในระบบเดียว หน้านี้จึงเปิดไว้ให้คนที่ยังไม่คุ้นกับระบบได้
        <strong class="text-[#fffbea]">ไล่ดูหมวดบาคาร่า สล็อต เกมไพ่ หน้าเครดิต และขั้นตอนฝากถอนให้ครบก่อนลงเงินจริง</strong>
        ตั้งแต่โครงของเมนูไปจนถึงรายละเอียดที่หน้าสรุปรายการแสดงไว้ก่อนกดยืนยัน
      </p>

      <p class="text-left text-base leading-relaxed text-[#e9e4d6]">
        คำว่า “ทดลองเล่น” ที่หน้านี้พูดถึงจึงเป็น<strong class="text-[#fffbea]">การเดินให้ครบทุกขั้นของการใช้งานหนึ่งรอบ ตั้งแต่ Login เลือกหมวดเกม ไปจนถึงหน้าตรวจเครดิตและประวัติรายการ</strong>
        ไม่ใช่การเล่นเอารางวัล เพราะเมื่อรู้ว่าแต่ละหน้าจอแสดงข้อมูลอะไรไว้แล้ว การเดิมพันจริงรอบแรกจะเหลือแค่การตัดสินใจเรื่องเกมและวงเงิน
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ไล่ดูหมวดเกมและเครดิตของ WIN999 ให้ครบก่อนเดิมพันรอบแรก" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e9e4d6]">
        จุดที่ช่วยให้เริ่มต้นได้เร็วที่สุดคือ<strong class="text-[#fffbea]">เกมหลายรูปแบบถูกรวมไว้ในบัญชีเดียว และสลับหมวดเดิมพันได้จากหน้าเดิม</strong>
        สมาชิก Login ผ่านเว็บเบราว์เซอร์แล้วเลือกหมวดที่สนใจได้ทันที จากนั้นเปิดดูรายละเอียดของเกมกับเงื่อนไขของรายการนั้นต่อได้ก่อนเริ่มเดิมพัน ไม่ต้องสลับเว็บไซต์ไปมา
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#e9e4d6]">
        <li class="flex gap-3">
          <span class="font-bold text-[#fcc403]">1.</span>
          <span><strong class="text-[#fffbea]">เปิดดูหมวดเกมที่ WIN999 เปิดให้บริการอยู่ก่อน</strong> ระบบรวมบาคาร่า สล็อต เกมไพ่ และเกมอื่นตามค่ายที่รองรับไว้ที่เดียว จึงเห็นภาพรวมได้จากหน้าเดียวว่าหมวดไหนเข้าเล่นได้บ้างในขณะนั้น</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#fdda04]">2.</span>
          <span>
            <strong class="text-[#fffbea]">อ่านรายละเอียดของเกมที่สนใจให้จบ</strong> ทั้งรูปแบบการเดิมพันและเงื่อนไขที่หน้าเกมแสดงไว้ เพราะแต่ละค่ายกำหนดรายละเอียดของตัวเอง และบางค่ายอาจปิดปรับปรุงชั่วคราวจนเข้าเล่นไม่ได้
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#fcc403]">3.</span>
          <span>
            <strong class="text-[#fffbea]">เปิดหน้าเครดิตและประวัติรายการดูก่อน</strong> เพื่อให้รู้ว่าระบบสรุปยอดคงเหลือและรายการย้อนหลังไว้ตรงไหน ก่อนตัดสินใจว่าจะเริ่มด้วยวงเงินเท่าไร
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#fdda04]">4.</span>
          <span>
            <strong class="text-[#fffbea]">ไล่ดูขั้นตอนฝากถอนให้ครบก่อนโอนจริง</strong> ทั้งชื่อบัญชีปลายทาง จำนวนเงิน และข้อมูลที่เว็บไซต์แสดงไว้ ขั้นตอนนี้คือขั้นที่ควรทำช้าที่สุด เพราะเป็นหน้าจอสุดท้ายที่ยังตรวจทานได้ก่อนเงินออกจากบัญชี
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#fcc403]">5.</span>
          <span>
            <strong class="text-[#fffbea]">เปิดดูหน้าโปรโมชั่นและบัญชีสมาชิกต่ออีกที</strong> ทั้งโบนัสคืนยอดเสียและโบนัสแนะนำเพื่อนมีรอบตัดยอดและเงื่อนไขของตัวเอง ควรตรวจสอบรายละเอียดล่าสุดก่อนกดรับทุกครั้ง
          </span>
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#e9e4d6]">
        <strong class="text-[#fffbea]">หมวดเกมที่เปิดให้เล่น สถานะของค่ายเกม และเงื่อนไขของโปรโมชั่นเปลี่ยนแปลงได้ตามช่วงเวลา จึงควรตรวจสอบข้อมูลจากช่องทางอย่างเป็นทางการของเว็บไซต์ทุกครั้งก่อนทำธุรกรรม</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title="จุดที่ควรตรวจให้ครบก่อนกดยืนยันเดิมพัน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e9e4d6]">
        การไล่ดูระบบมีประโยชน์ที่สุดเมื่อมองมันเหมือนการอ่านคู่มือ ไม่ใช่การลุ้นรางวัล
        <strong class="text-[#fffbea]">เป้าหมายคือรู้จักระบบให้ครบก่อนที่เงินจริงจะเข้ามาเกี่ยวข้อง</strong>
        หกเรื่องด้านล่างคือสิ่งที่ควรเก็บข้อมูลไว้ระหว่างเปิดดู
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#e9e4d6]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fcc403]">🗂️</span>
          <span>
            <strong class="text-[#fffbea]">หมวดเกมที่กำลังเปิดให้บริการ</strong> จำให้ได้ว่าบาคาร่า สล็อต และเกมไพ่อยู่ตรงไหนในเมนู จะได้ไม่ต้องไล่หาใหม่ทุกครั้งที่อยากเปลี่ยนหมวด
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fdda04]">🎰</span>
          <span>
            <strong class="text-[#fffbea]">รายละเอียดของเกมในค่ายที่ระบบรองรับ</strong> รูปแบบการเดิมพันและเงื่อนไขของแต่ละค่ายไม่เหมือนกัน และบางค่ายอาจปิดปรับปรุงจนเข้าเล่นไม่ได้ชั่วคราว ควรอ่านของเกมที่จะลงจริงเสมอ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fcc403]">💳</span>
          <span>
            <strong class="text-[#fffbea]">หน้าเครดิตและประวัติรายการ</strong> ทั้งยอดคงเหลือ รายการที่ทำไปแล้ว และสถานะของรายการถอน อ่านให้จบก่อนตัดสินใจรอบต่อไป เพราะเป็นข้อมูลชุดเดียวกับที่ใช้แจ้งแอดมินเวลามีปัญหา
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fdda04]">🏦</span>
          <span>
            <strong class="text-[#fffbea]">ช่องทางฝากถอนผ่านระบบบัญชีบริษัท</strong> ก่อนฝากควรตรวจชื่อบัญชี จำนวนเงิน และข้อมูลปลายทางให้ตรงกับที่เว็บไซต์แสดงไว้ ส่วนรายการถอนควรตรวจสถานะผ่านระบบและเก็บหลักฐานไว้จนดำเนินการเสร็จสมบูรณ์
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fcc403]">🎁</span>
          <span>
            <strong class="text-[#fffbea]">เงื่อนไขของโปรโมชั่นที่กำลังเปิดให้รับ</strong> ทั้งโบนัสคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8% มีรอบตัดยอด ประเภทเกมที่นับ และยอดที่เข้าเกณฑ์ให้ตรวจสอบผ่านบัญชีสมาชิกก่อนกดรับทุกครั้ง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fdda04]">📱</span>
