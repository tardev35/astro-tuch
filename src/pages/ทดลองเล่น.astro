---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import popularGamesImage from "../assets/gamedemo8.webp";
import newGamesImage from "../assets/gamedemo16.webp";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริง
// ของบรีฟรอบนี้เท่านั้น (src/assets/content.txt) ไม่ใช่แก้ทับประโยคของแบรนด์ก่อน
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0 (ผังเดิมของหน้า คงไว้)
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// ⚠️ ดรอปนี้ (2026-10-12) คือ **คาสิโนออนไลน์รวมทุกหมวด** — บาคาร่า สล็อต รูเล็ต
// ไฮโล แทงบอล พร้อมหมวดคาสิโนไลฟ์สด **ไม่ใช่เว็บสล็อตล้วน** แบบแบรนด์ก่อน
// (คำของแบรนด์ก่อนเกือบทุกคำอยู่ในลิสต์ห้ามของ brand-spec §6 จึงต้องเขียนประโยค
// ขึ้นใหม่ ไม่ใช่ find-and-replace ทับของเดิม) และไม่ใช่เว็บหมวดลอตเตอรี —
// สองหน้าของหมวดนั้นจอดอยู่ใน src/pages-disabled/ ไม่มี route ห้ามลิงก์ไปหา
// เป็น href ตายที่ทำให้ build แดง
//
// แง่มุมที่บรีฟรอบนี้รองรับให้หน้าทดลองเล่นพูดถึงมีเท่านี้: เกมเดิมพันหลายประเภท
// ในแพลตฟอร์มเดียว · หมวดคาสิโนไลฟ์สดที่ถ่ายทอดสดจากโต๊ะจริง · รองรับมือถือและ
// คอมพิวเตอร์ · Login เพื่อค้นหาเกม ตรวจสอบเครดิต และติดตามรายการ · บาคาร่าเป็น
// เกมไพ่ที่มีตัวเลือกการเดิมพันตามกติกา · สล็อตมีทั้งเกมวงล้อทั่วไป ฟรีสปิน และ
// ฟีเจอร์ตัวคูณ · รูเล็ตกับไฮโลต่างกันที่รูปแบบการทายผล · แทงบอลมีข้อมูลคู่แข่งขัน
// และอัตราต่อรองให้ตรวจสอบก่อนทำรายการ · การไล่ดูก่อนเดิมพันคือการอ่านกติกา
// ตารางจ่าย และยอดเดิมพันของเกมให้จบ · "มีโบนัสทุกเกม" ต้องตรวจว่าหมายถึงฟีเจอร์
// โบนัสในเกมหรือโปรโมชั่นของเว็บไซต์ · ไม่มีเกมประเภทใดรับประกันผลตอบแทน ·
// โต๊ะไลฟ์สดที่ระบุ 24 ชั่วโมงยังมีตารางเปิดโต๊ะและช่วงปิดปรับปรุงของแต่ละค่าย ·
// คืนยอดเสีย 0.3% เข้ายูสทุกวัน · แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด · สมัคร
// 3 ขั้นตอน · ยืนยันบัญชี · แอดมิน 24 ชั่วโมง · ช่องทางหลัก · หมายเลขรายการ ·
// PIN · OTP · โดเมนหลัก · ข้อมูลผู้ดำเนินงาน
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามี "โหมดทดลอง" เครดิตทดลอง หรือเดโมฟรีเป็นบริการของเว็บ —
// จึงห้ามสัญญาสินค้าตัวนั้น คำว่า "ทดลองเล่น" บนหน้านี้จึงหมายถึงสิ่งที่บรีฟระบุไว้
// ตรงๆ ว่าทำได้: Login แล้วไล่ดูหมวดเกมให้ครบหนึ่งรอบ เลือกเกมที่สนใจ อ่านกติกา
// ตารางจ่าย และยอดเดิมพันของเกมนั้นให้จบ แล้วจึงเริ่มเดิมพันด้วยเงินจริง
//
// ⚠️ ที่ตั้งเซิร์ฟเวอร์ในประเทศไทยเป็นสิ่งที่บรีฟสั่งให้ "ตรวจสอบจากข้อมูลผู้ให้
// บริการจริง" ห้ามเขียนเป็นคำยืนยันของเว็บ ให้ทวนประโยคกำกับเท่านั้น เช่นเดียวกับ
// จำนวนค่ายที่เปิดให้บริการ
//
// ⚠️ รูปในหน้านี้ใช้ได้แค่ gamedemo8 กับ gamedemo16 เท่านั้น — เป็นอาร์ตสต็อกกลาง
// ของเทมเพลต (mtime 2026-08-04) ไม่ใช่อาร์ตเวิร์กของแบรนด์นี้ จึงอยู่ต่อได้ แต่ alt
// ต้องบรรยายภาพจริง และห้ามเอ่ยชื่อแบรนด์ใด เพราะไม่มีชื่อแบรนด์ไหนปรากฏอยู่บนรูป
// ทั้งสองใบ (เปิดอ่านซ้ำแล้วรอบนี้) ส่วน gamedemo7/9/10/11/12/14/15/17/18 มีโลโก้
// หรือชื่อของผู้ให้บริการเจ้าอื่นพิมพ์ทับอยู่กลางรูป และ gamedemo13 เป็นภาพล่อแหลม
// — ห้ามนำกลับมาใช้ เพราะเท่ากับอ้างชื่อที่บรีฟไม่ได้เอ่ย ไฟล์ยังอยู่บนดิสก์
// ห้ามลบ เป็นอินเวนทอรี gamedemo8 ("POPULAR GAME" 600x379) กับ gamedemo16
// ("New Game" 650x411) ความกว้างที่วาดจริงสูงสุด ~600px ต่อใบ (กริดสองคอลัมน์
// ในการ์ด) จึงไม่ขยายเกินต้นฉบับ quality={62} ของสองใบนี้ตั้งไว้ต่ำกว่าค่าปกติ 80
// มาตั้งแต่รอบก่อน เพราะอาร์ตมีเกรนละเอียดจนไฟล์ AVIF เคยโตกว่า WebP ของตัวเอง
// (verify-build จะแดง) ห้ามดันกลับขึ้น — เป็นค่าต่อรูป ไม่ใช่การจูนต่อฟอร์แมต
//
// ⚠️ คำที่ห้ามหลงเหลือ: คำขายของของแบรนด์ก่อนๆ ศัพท์เว็บสล็อตล้วนของรอบก่อน
// และศัพท์หมวดลอตเตอรีทุกคำ — รายการเต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาคำต้องห้ามเจอ false positive
//
// ⚠️ ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง
// **รอบนี้ไม่มี "2026"** เพราะบรีฟไม่ได้เอ่ยไว้ และห้ามเติมเลขใบอนุญาต หน่วยงาน
// กำกับ ชื่อผู้ดำเนินงาน ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก
// หรือปีที่ก่อตั้ง เพราะบรีฟไม่ได้เอ่ยไว้สักอย่าง
//
// ประโยคกำกับของบรีฟที่ห้ามตัดทิ้ง (เป็นส่วนหนึ่งของคอปปี้ ไม่ใช่ filler):
// ส่วนจำนวนค่ายที่เปิดให้บริการและที่ตั้งเซิร์ฟเวอร์ในประเทศไทยควรตรวจสอบจากข้อมูล
// ผู้ให้บริการจริง · สำหรับคำว่า มีโบนัสทุกเกม ควรตรวจสอบว่าหมายถึงฟีเจอร์โบนัส
// ภายในเกมหรือโปรโมชั่นของเว็บไซต์ · ไม่มีเกมประเภทใดรับประกันผลตอบแทน ·
// ควรตรวจสอบว่าโปรโมชั่นครอบคลุมเกมประเภทใดบ้าง · ควรอ่านรายละเอียดประเภทเกมที่
// ร่วมรายการ เวลาตัดยอด และเงื่อนไขการใช้โบนัสก่อนรับ · คำว่าไม่จำกัดควรระบุให้ชัด
// ว่าหมายถึงจำนวนเพื่อน จำนวนครั้งในการรับสิทธิ์ หรือยอดโบนัสสูงสุด · ผู้สมัครควร
// ตรวจสอบโดเมนหลัก ข้อมูลผู้ดำเนินงาน และข้อกำหนดการใช้งานก่อนส่งข้อมูลส่วนตัว ·
// บางเกมอาจมีช่วงปิดปรับปรุงหรือเปลี่ยนรอบถ่ายทอดสด · ไม่ควรเปิดเผยรหัสผ่าน PIN
// หรือ OTP ให้บุคคลอื่น
//
// banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion · banner2/banner3 และ
// slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import (ลำพังการ import ก็ทำให้
// ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น AnnouncementPremium ทั้งเว็บ (รอบก่อนใช้ Announcement3 —
// brand-spec §3 หมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้
// ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่ง
// จะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ทองมังกรบนดำสนิท ฮิวเดียวล้วน** พลิกออกจาก
// ชุดชมพูฮอตพิงก์-ทองบนพลัมของรอบก่อน ซึ่งออกครบทุกจุดแล้ว ทั้งคลาส Tailwind
// raw hex และ rgba() (ค่าเดิมอยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้
// grep หาสีแบรนด์เก่าเจอ false positive) รอบนี้ไม่มีชมพู ไม่มีม่วง/พลัม ไม่มีเขียว
// ไม่มีน้ำเงิน ไม่มีเทา/เงิน ไม่มีส้ม และไม่มีแดงเลย
// ลำดับปุ่มสื่อด้วยขั้ว "ทองถม vs ผิวจมขอบทอง": ปุ่มหลักถมทองไล่เฉด #ffe4a3 →
// #dfa310 ขอบ #8a5c09 หมึก #140d02 · ปุ่มรอง (เข้าสู่ระบบ) เป็นผิวจม #120c04 →
// #070502 ขอบ #dfa310/55 ตัวอักษรเนื้อความ #f0e9dc · ปุ่มลิงก์ภายในเป็นผิวจม
// เดียวกัน ขอบ #dfa310/50 ตัวอักษรทองสว่าง #ffe4a3 · ขอบรูปใช้ทองหลักแบบโปร่ง
// · marker ของลำดับเลขใช้ทองหลัก #dfa310 (7.6:1 บนผิวการ์ด)
// ⚠️ ห้ามกลับด้าน: พื้นถมทองต้องใช้หมึกเข้มเสมอ ห้ามขาวหรือทองอ่อน และ #8a5c09
// กับ #43240b เป็นเส้น ขอบ และออราเท่านั้น ห้ามถือตัวอักษรทุกขนาด ออราในไฟล์นี้
// ใช้ rgba(223,163,16,α) และ rgba(255,228,163,α) เท่านั้น
// ⚠️ "มีทองอยู่" ไม่ใช่ตัวบอกว่าถูกแบรนด์ — ทองออกมาแล้วเก้าในสิบเอ็ดรอบหลังสุด
// ให้เทียบเป็นค่าทีละตัวกับตารางใน brand-spec §2 ไม่ใช่เทียบด้วยตาหรือด้วยตระกูลสี
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #f0e9dc)
// ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง ปล่อยให้สืบทอดลงมา
// — มีแค่ปุ่ม ขอบรูป marker ของลำดับเลข และ <strong> ที่ประกาศสี โดย <strong>
// ใช้ทองไฮไลต์ #ffc93d ตัวเดียว (10.2:1 บนผิวการ์ด) และแต่ละ <strong> ครอบ
// "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิด
// แท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 158 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} ไล่ดูหมวดบาคาร่า สล็อต รูเล็ต ไฮโล แทงบอล และคาสิโนไลฟ์สดให้ครบหนึ่งรอบ พร้อมอ่านกติกา ตารางจ่าย และยอดเดิมพันของแต่ละเกมก่อนเริ่มเดิมพันจริง`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ไล่ดูหมวดเกมคาสิโนก่อนเริ่มเดิมพันจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#ffc93d]">{BRAND_NAME}</strong> เป็นแบรนด์คาสิโนเซิร์ฟไทยที่นำเสนอเกมเดิมพันออนไลน์หลายประเภทไว้ในแพลตฟอร์มเดียว
        <strong class="text-[#ffc93d]">ทั้งบาคาร่า สล็อต รูเล็ต ไฮโล และแทงบอล พร้อมหมวดคาสิโนไลฟ์สดสำหรับผู้ที่สนใจเกมถ่ายทอดสดจากโต๊ะจริง รองรับการใช้งานผ่านมือถือและคอมพิวเตอร์</strong>
        หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับระบบได้ไล่ดูให้ครบหนึ่งรอบ ตั้งแต่การ Login เพื่อค้นหาเกมและเปิดรายละเอียดของเกมที่สนใจ ไปจนถึงเมนูตรวจสอบเครดิตและการติดตามรายการต่างๆ ก่อนจะเริ่มเดิมพันจริง
      </p>

      <p>
        คำว่า ทดลองเล่น ที่หน้านี้พูดถึงจึงหมายถึง
