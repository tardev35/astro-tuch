---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import popularGamesImage from "../assets/gamedemo8.webp";
import newGamesImage from "../assets/gamedemo16.webp";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ (src/assets/content.txt) ไม่มีหมวด "ทดลองเล่น" และไม่มี
// ส่วน SUB-PAGES เลย ทั้งหน้าจึงเขียนขึ้นใหม่จากคลังคำของบรีฟรอบนี้ ไม่ใช่แก้ทับ
// ประโยคของแบรนด์ก่อน
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// ⚠️ ดรอปนี้ (2026-10-19) คือ **เว็บสล็อตล้วน** ไม่ใช่คาสิโน ไม่มีกีฬา และไม่ใช่
// เว็บหวย สองหน้าของหมวดลอตเตอรีที่แบรนด์ก่อนๆ เคยเปิดจอดอยู่ใน src/pages-disabled/
// ไม่มี route ห้ามลิงก์ไปหา เป็น href ตายที่ทำให้ build แดง route ที่มีจริงรอบนี้คือ
// / · /about-us · /contact-us · /login · /register · /privacy · /promotion ·
// /terms · /ทดลองเล่น · /ทางเข้า · /line
//
// ⚠️ แบรนด์ก่อนหน้าทันที (นินจา168) ก็เป็นแบรนด์สล็อตเหมือนกัน คอปปี้เดิมจึง
// "ดูเข้าเค้า" ทั้งที่กรอบของบรีฟคนละอัน — **ห้าม find-and-replace ทับประโยคเดิม**
// วลีแกนของรอบก่อน (ช่องทางชำระเงินเป็นหัวข้อหลัก + คำกล่าวอ้างเรื่องอันดับและความ
// เป็นเว็บหลัก) ถูกถอดออกหมดแล้วทั้งไฟล์ กรอบของบรีฟรอบนี้คือ **การศึกษาระบบเกม
// สล็อตของแต่ละค่ายเกมตามงบประมาณของตัวเอง — กติกา อัตราเดิมพัน เงื่อนไขการจ่าย
// รางวัล ตารางจ่ายรางวัล ความผันผวน ช่วงเดิมพันขั้นต่ำ — พร้อมโปรโมชั่นคืนยอดเสีย
// 0.3% กับแนะนำเพื่อน 0.8% และช่องทางติดต่อเจ้าหน้าที่ 24ชม.**
// (คำต้องห้ามไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive
// ในคอมเมนต์ของไฟล์นี้เอง — เต็มอยู่ใน brand-spec §6)
//
// 🚨 **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกมแม้แต่ค่ายเดียว** จึงห้ามเขียนชื่อค่ายใดๆ
// ลงหน้าเว็บ ให้ใช้คำกลางว่า "ค่ายเกม" ตาม brand-spec §6
//
// ⚠️ บรีฟรอบนี้ **ไม่ได้เอ่ยถึงชื่อผู้กำกับดูแล นิติบุคคล ผู้รับชำระเงินรายใด
// ค่าตัวเลขของเกม ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีก่อตั้ง** จึงห้ามพูดถึงทั้งหมด
// รายการเต็มอยู่ใน brand-spec §6 สิ่งที่บรีฟให้มา
// และอ้างได้คือ: รายชื่อค่ายเกม · กติกา · อัตราเดิมพัน · เงื่อนไขการจ่ายรางวัล ·
// ตารางจ่ายรางวัล · ความผันผวน · ช่วงเดิมพันขั้นต่ำ · งบประมาณที่ยอมรับการสูญเสียได้ ·
// ประเภทเกมที่ร่วมรายการ · รอบสรุปยอดและรอบจ่ายโบนัส · วิธีรับเครดิต (อัตโนมัติ
// หรือกดรับเอง) · ลิงก์แนะนำและการเชื่อมโยงบัญชี · การสมัครสมาชิกและข้อมูลส่วนบุคคล ·
// รายการฝากถอน · หลักฐานสำหรับการตรวจสอบ · ช่องทางทางการ
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามีโหมดทดลอง เครดิตทดลอง หรือเดโมฟรีเป็นบริการของเว็บ —
// จึงห้ามสัญญาสินค้าตัวนั้น คำว่า "ทดลองเล่น" บนหน้านี้จึงหมายถึงสิ่งที่บรีฟระบุไว้
// ตรงๆ ว่าทำได้: ไล่ดูเกมสล็อตของค่ายเกมที่เปิดให้บริการและขั้นตอนการใช้งานให้ครบ
// หนึ่งรอบ ศึกษาเงื่อนไขของแต่ละโปรโมชั่น และสอบถามเจ้าหน้าที่ ก่อนเข้าใช้งานจริง
//
// ⚠️ คำว่า "ไม่มีขั้นต่ำ" และ "การันตีได้เงินสูงทุกรอบ" อยู่ได้เฉพาะในหัวข้อที่บรีฟ
// เขียนไว้เอง (= หัวข้อของ index.astro) หน้านี้จึงไม่หยิบมาใช้เลย เพราะย่อหน้าของ
// บรีฟเองหักล้างทันทีว่าไม่มีระบบใดรับประกันว่าจะได้รับเงินรางวัลสูงทุกรอบ
//
// ⚠️ รูปในหน้านี้ใช้ได้แค่ gamedemo8 กับ gamedemo16 เท่านั้น — เป็นอาร์ตสต็อกกลาง
// ของเทมเพลต (mtime 2026-08-04) ไม่ใช่อาร์ตเวิร์กของแบรนด์นี้ จึงอยู่ต่อได้ แต่ alt
// ต้องบรรยายภาพจริง และห้ามเอ่ยชื่อแบรนด์ใด เพราะไม่มีชื่อแบรนด์ไหนปรากฏอยู่บนรูป
// ทั้งสองใบ (สีที่ alt บรรยายคือสีที่วาดอยู่บนอาร์ตสต็อกจริง ไม่ใช่สีของพาเลตต์
// รอบนี้ — ห้าม "แก้สี" ใน alt ให้เข้าแบรนด์ เพราะนั่นทำให้ alt บรรยายผิด เปิดอ่าน
// บิตแมปทั้งสองใบซ้ำแล้วรอบนี้ ข้อความ alt ยังตรงกับภาพจริงทุกองค์ประกอบ)
// ส่วน gamedemo7/9/10/11/12/14/15/17/18 มีโลโก้หรือชื่อของผู้ให้บริการ
// เจ้าอื่นพิมพ์ทับอยู่กลางรูป และ gamedemo13 เป็นภาพล่อแหลม — ห้ามนำกลับมาใช้
// เพราะเท่ากับอ้างชื่อที่บรีฟไม่ได้เอ่ย ไฟล์ยังอยู่บนดิสก์ ห้ามลบ เป็นอินเวนทอรี
// gamedemo8 ("POPULAR GAME" 600x379) กับ gamedemo16 ("New Game" 650x411)
// ความกว้างที่วาดจริงสูงสุด ~600px ต่อใบ (กริดสองคอลัมน์ในการ์ด) จึงไม่ขยายเกิน
// ต้นฉบับ quality={62} ของสองใบนี้ตั้งไว้ต่ำกว่าค่าปกติ 80 มาตั้งแต่รอบก่อน เพราะ
// อาร์ตมีเกรนละเอียดจนไฟล์ AVIF เคยโตกว่า WebP ของตัวเอง (verify-build จะแดง)
// ห้ามดันกลับขึ้น — เป็นค่าต่อรูป ไม่ใช่การจูนต่อฟอร์แมต
//
// ⚠️ ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 24ชม. ส่วนตัวเลขและชื่อเฉพาะ
// ที่ห้ามแต่งขึ้นเองอยู่ครบใน brand-spec §6
//
// 🚨 ประโยค hedge ของบรีฟที่ห้ามตัดทิ้ง (เป็นเนื้อหาของบรีฟ ไม่ใช่ filler) และ
// ห้ามเขียนเสริมให้กลายเป็นคำโฆษณาที่บรีฟกำลังเตือนเรื่องนั้นอยู่:
// เกมสล็อตมีความเสี่ยงและไม่สามารถรับประกันผลตอบแทนได้ · เงื่อนไขขั้นต่ำอาจแตกต่าง
// กันในแต่ละเกม และไม่มีระบบใดรับประกันว่าจะได้รับเงินรางวัลสูงทุกรอบ · ควรอ่าน
// ตารางจ่ายรางวัล ทำความเข้าใจความผันผวนของเกม และกำหนดงบประมาณที่ยอมรับการสูญเสีย
// ได้ก่อนเริ่มเล่น · เครดิตคืนยอดเสียไม่ใช่การรับประกันว่าจะได้เงินคืนจากทุกการเดิมพัน ·
// แม้จะมีการระบุว่าไม่จำกัด แต่ควรศึกษาข้อกำหนดเกี่ยวกับจำนวนผู้เข้าร่วม รอบจ่าย
// โบนัส และเงื่อนไขการใช้เครดิตให้ชัดเจน · ไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคล
// อื่น · ควรตรวจสอบเวลาการให้บริการและระยะเวลาตอบกลับล่าสุดจากประกาศทางการอีกครั้ง
//
// banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion · banner2/banner3 และ
// slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import (ลำพังการ import ก็ทำให้ไฟล์
// ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้หมุนมาเป็น Announcement3 ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ Announcement5 จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็น
// คอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นข้อความ
// ตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ฟ้าอะซัวร์นำ · ทองอำพันรอง · น้ำเงินลึก
// ไม่เคยถือตัวอักษร · บนพื้นดำสนิท**
// ⚠️ สองรอบที่แล้ว (นินจา168 ฟ้าไซยาน+เหลืองมะนาว · สบายเบท168 ฟ้าท้องฟ้า+ทองอำพัน)
// ก็เป็นฟ้านำ + สีเหลือง/ทองรองเหมือนกันทั้งชุด "มีฟ้าอยู่" หรือ "มีทองอยู่" จึงไม่ใช่
// ตัวบอกว่าถูกแบรนด์ ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน brand-spec §2 (ค่าเดิม
// ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive) ฟ้ารอบนี้คือ
// **#039cfa** (+#c3ebfc +#04366b) และทองรอบนี้คือ **#f9a826** (ทองอำพัน)
// ลำดับความลึก: #0b2d52 ผิวยก (= การ์ด) / #071e38 กลาง / #030f1d จม / #000000 พื้นเพจ
// ลำดับปุ่มสื่อด้วยขั้ว "พื้นฟ้าตัน vs กรอบทองโปร่ง vs ผิวจมขอบน้ำเงิน" ตามคู่ปุ่ม
// ของ Navfoot: ปุ่มสมัครสมาชิกถมไล่เฉด #c3ebfc → #039cfa ขอบ #04366b หมึก #031320
// (15.8:1 บนปลายฟ้าน้ำแข็ง · 6.2:1 บนปลายฟ้าแบรนด์) · ปุ่มเข้าสู่ระบบเป็นกรอบทอง
// โปร่ง พื้นผิวจม #071e38 → #030f1d ขอบ #f9a826/80 ตัวอักษร #f9a826 (11.4:1 บนผิวจม) ·
// ปุ่มลิงก์ภายในเป็นผิวจมขอบน้ำเงินลึก ตัวอักษร #e3f2fc และ hover ยกขอบเป็นฟ้า
// แบรนด์ #039cfa · ขอบรูปใช้ฟ้าแบรนด์ #039cfa โปร่ง (ฮิวนำต้องเห็นจริงบนหน้า) ·
// marker ของลำดับเลขใช้ฟ้าน้ำแข็ง #c3ebfc (10.8:1 บนผิวการ์ด — เป็นตัวอักษร จึงใช้
// น้ำเงินลึกไม่ได้ และ #f9a826 สงวนไว้ให้ <strong> เท่านั้น)
// ⚠️ ห้ามกลับด้าน: พื้นถมฟ้าต้องใช้หมึกเข้มเสมอ ห้ามขาวหรือฟ้าอ่อน และ
// #04366b #704504 เป็นเส้น ขอบ ออรา และพื้นถมเท่านั้น ห้ามถือตัวอักษรทุกขนาด
// ออราในไฟล์นี้ใช้ rgba(4,54,107,α) · rgba(249,168,38,α) · rgba(3,156,250,α)
// เท่านั้น · รอบนี้ไม่มีชมพู ไม่มีม่วง ไม่มีเขียว ไม่มีส้ม ไม่มีเงิน/โครเมียม
// ไม่มีโรสโกลด์ ไม่มีแดง และไม่มีเหลืองมะนาว
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #e3f2fc)
// ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง ปล่อยให้สืบทอดลงมา
// และไม่ใส่ mx-auto / max-w-* บน <p> — มีแค่ปุ่ม ขอบรูป marker ของลำดับเลข และ
// <strong> ที่ประกาศสี โดย <strong> ใช้ทองอำพัน #f9a826 ตัวเดียว (6.9:1 บนผิว
// การ์ด) และแต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทย
// ไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง
// และห้ามวาง <strong> สองอันติดกัน
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 157 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} หน้ารวมวิธีไล่ดูเกมสล็อตของแต่ละค่ายเกม กติกา อัตราเดิมพัน ตารางจ่ายรางวัล ให้ครบหนึ่งรอบก่อนตัดสินใจสมัครสมาชิกและเข้าสู่ระบบใช้งานจริง`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ไล่ดูเกมสล็อตและกติกาของค่ายเกมก่อนเข้าใช้งานจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#f9a826]">{BRAND_NAME} รวบรวมข้อมูลเกมสล็อตออนไลน์และขั้นตอนการใช้งานไว้ในเว็บไซต์เดียว</strong>
        หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับระบบได้ไล่ดูให้ครบหนึ่งรอบก่อนเข้าใช้งานจริง ตั้งแต่รายชื่อค่ายเกมที่เปิดให้บริการ กติกาและอัตราเดิมพันของแต่ละเกม ไปจนถึงขั้นตอนสมัครสมาชิก การเข้าสู่ระบบ และเงื่อนไขของโปรโมชั่นที่เปิดให้เข้าร่วม
      </p>

      <p>
        คำว่า ทดลองเล่น ที่หน้านี้พูดถึงจึงหมายถึง
        <strong class="text-[#f9a826]">การศึกษารายละเอียดของเกมและเงื่อนไขบริการก่อนเริ่มต้นทำรายการ</strong>
        ไม่ใช่การแจกเครดิตทดลอง และไม่ใช่การรับประกันผลของรายการใดรายการหนึ่ง หากพบข้อสงสัยระหว่างใช้งานสามารถสอบถามเจ้าหน้าที่ผ่านช่องทางทางการได้
      </p>

      <p>
        อีกเรื่องที่ควรไล่ดูไปพร้อมกันคือข้อกำหนดการเปิดบัญชีสมาชิกและการใช้ข้อมูลส่วนบุคคล รวมถึงรายละเอียดของโปรโมชั่นที่กำลังสนใจ
        <strong class="text-[#f9a826]">เพราะแต่ละรายการมีเงื่อนไขการรับสิทธิ์ต่างกัน และควรเข้าใจว่าเกมสล็อตมีความเสี่ยงและไม่สามารถรับประกันผลตอบแทนได้</strong>
        การอ่านให้ครบตั้งแต่ก่อนเริ่มจึงช่วยให้ทราบว่าจะได้รับเครดิตเมื่อใดและต้องปฏิบัติตามเงื่อนไขใดบ้าง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ไล่ดูเกมสล็อตและกติกาของค่ายเกมก่อนเลือกเกมที่สนใจ" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        หลังเข้าสู่ระบบ ลำดับการไล่ดูจะเป็นชุดเดียวกันทุกครั้ง
        <strong class="text-[#f9a826]">เปิดรายชื่อค่ายเกมที่เปิดให้บริการ ลองเปิดเกมที่สนใจดูว่าแสดงผลได้ตามปกติไหม แล้วจึงอ่านกติกาและอัตราเดิมพันของเกมนั้นต่อ</strong>
        การไล่ดูให้ครบหนึ่งรอบก่อนช่วยให้เลือกเกมที่ตรงกับรูปแบบที่สนใจได้ชัดเจนขึ้น และสอบถามเจ้าหน้าที่ได้ตรงประเด็นเมื่อมีข้อสงสัยเกี่ยวกับขั้นตอนใดขั้นตอนหนึ่ง
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={popularGamesImage}
          alt="ภาพการ์ดหมวดเกมยอดนิยม พื้นหลังโทนทองเข้มมีแสงไฟเมืองและชิปวงกลมหลากสีลอยกระจาย กลางภาพเป็นข้อความ POPULAR GAME ตัวอักษรสามมิติสีทอง ด้านซ้ายเป็นกระต่ายการ์ตูนสวมเสื้อแจ็กเก็ตยีนส์ยืนข้างหีบสมบัติที่มีเหรียญทองล้นออกมา ด้านขวาเป็นแมวการ์ตูนสวมแว่นกันแดดและหูฟัง และกลางล่างเป็นชิปทองสลักสัญลักษณ์โพดำ"
          loading="lazy"
          fetchpriority="low"
          decoding="async"
          widths={[300, 600]}
          sizes="(max-width: 639px) 100vw, 600px"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={62}
          class="mx-auto block h-auto w-full max-w-[600px] rounded-2xl border border-[#039cfa]/50"
        />

        <Picture
          src={newGamesImage}
          alt="ภาพการ์ดหมวดเกมเปิดใหม่ พื้นหลังสีน้ำเงินสดและลานกระเบื้องเรืองแสงสีชมพู-ฟ้า กลางภาพเป็นข้อความ New Game ตัวอักษรสามมิติสีขาวขอบฟ้า ด้านซ้ายเป็นตัวการ์ตูนหัวฟักทองเรืองแสงสวมหมวกปีกกว้าง ด้านขวาเป็นโครงกระดูกการ์ตูนยิ้มชูแขน รอบภาพมีดาวสีเหลือง ชิป และบล็อกสีสดลอยอยู่"
          loading="lazy"
          fetchpriority="low"
          decoding="async"
          widths={[300, 600]}
          sizes="(max-width: 639px) 100vw, 600px"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={62}
          class="mx-auto block h-auto w-full max-w-[600px] rounded-2xl border border-[#039cfa]/50"
        />
      </div>

      <ul class="flex flex-col gap-3" aria-label="จุดที่ควรไล่ดูให้ครบก่อนเข้าใช้งานจริง">
        <li class="flex gap-3">
          <span aria-hidden="true">🎰</span>
          <span>
            <strong class="text-[#f9a826]">รายชื่อค่ายเกมที่เปิดให้บริการ</strong> ควรเปิดดูจากหน้าเว็บไซต์ทางการว่ามีค่ายเกมใดบ้างที่เปิดให้บริการจริง เนื่องจากรายการเกมที่เปิดอยู่อาจเปลี่ยนแปลงได้ตามการให้บริการของแต่ละช่วงเวลา
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">📖</span>
          <span>
            <strong class="text-[#f9a826]">กติกาและเงื่อนไขการจ่ายรางวัล</strong> ควรเปิดอ่านเป็นรายเกมก่อนเข้าใช้งาน เพราะแต่ละเกมกำหนดกติกาและตารางจ่ายรางวัลไว้ไม่เหมือนกัน และควรลองเปิดบนหน้าจอที่ใช้งานจริงว่าแสดงผลได้ตามปกติไหม
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">📈</span>
          <span>
            <strong class="text-[#f9a826]">อัตราเดิมพันและความผันผวนของเกม</strong> ควรดูควบคู่กับช่วงเดิมพันขั้นต่ำ เพื่อให้ทราบว่ารูปแบบของเกมที่กำลังสนใจเหมาะกับงบประมาณที่ตั้งไว้หรือไม่ และไม่จำเป็นต้องเลือกเกมที่ใช้เงินเดิมพันสูงเสมอไป
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">💬</span>
          <span>
            <strong class="text-[#f9a826]">ช่องทางติดต่อเจ้าหน้าที่</strong> ควรรู้ไว้ตั้งแต่ก่อนเริ่มว่าช่องทางทางการที่เว็บไซต์ระบุไว้อยู่ตรงไหน และควรตรวจสอบเวลาการให้บริการกับระยะเวลาตอบกลับล่าสุดจากประกาศทางการอีกครั้ง
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#f9a826]">สิ่งที่การไล่ดูช่วยได้คือทำให้รู้ว่าเกมและเงื่อนไขอยู่ตรงไหนเท่านั้น</strong>
        ไม่ได้เป็นการรับประกันผลของรายการหรือยอดเครดิตที่จะได้รับ รายละเอียดที่เว็บไซต์แสดงอยู่ขณะใช้งานจึงเป็นสิ่งที่ควรยึดเป็นหลัก และควรเปิดดูซ้ำทุกครั้งที่กลับเข้ามาใหม่
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/about-us"
          aria-label={`อ่านหน้าเกี่ยวกับเราของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#04366b] bg-gradient-to-b from-[#071e38] to-[#030f1d] px-8 py-3 font-bold text-[#e3f2fc] shadow-[0_0_12px_rgba(4,54,107,0.45)] transition-all hover:scale-105 hover:border-[#039cfa] hover:shadow-[0_0_18px_rgba(3,156,250,0.4)]">
          อ่านเกี่ยวกับเรา
        </a>

        <a
          href="/promotion"
          aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#04366b] bg-gradient-to-b from-[#071e38] to-[#030f1d] px-8 py-3 font-bold text-[#e3f2fc] shadow-[0_0_12px_rgba(4,54,107,0.45)] transition-all hover:scale-105 hover:border-[#039cfa] hover:shadow-[0_0_18px_rgba(3,156,250,0.4)]">
          ดูภาพโปรโมชั่น
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="สิ่งที่ควรตรวจสอบให้ครบก่อนสมัครสมาชิกและเข้าสู่ระบบ" as="h2">
    <div class="flex flex-col gap-5">
      <p>
        การไล่ดูระบบมีประโยชน์ที่สุดเมื่อมองว่าเป็นการอ่านรายละเอียดให้จบก่อน
        <strong class="text-[#f9a826]">เป้าหมายคือรู้ว่าเว็บไซต์รวบรวมอะไรไว้ให้ศึกษาบ้าง แต่ละรายการมีเงื่อนไขอย่างไร และสอบถามเจ้าหน้าที่ได้ทางไหนเมื่อมีข้อสงสัย</strong>
        รายการด้านล่างคือชุดที่ควรตรวจก่อนลงทะเบียน และควรตรวจซ้ำทุกครั้งที่กลับเข้ามาใหม่ เพราะเงื่อนไขปรับเปลี่ยนได้ตามที่เว็บไซต์กำหนด
      </p>

      <ol class="ml-6 list-decimal space-y-3 marker:font-black marker:text-[#c3ebfc]">
        <li>
          <strong class="text-[#f9a826]">ที่อยู่เว็บไซต์ทางการ</strong> ควรตรวจสอบให้ถูกต้องก่อนเลือกเมนูสมัครสมาชิกหรือกรอกข้อมูลใด ๆ ไม่ใช่เปิดจากลิงก์ที่ส่งต่อกันมา และควรตรวจสอบช่องทางติดต่อจากหน้าเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีหรือบุคคลที่แอบอ้างชื่อบริการ
        </li>
        <li>
          <strong class="text-[#f9a826]">ข้อกำหนดการเปิดบัญชีสมาชิก</strong> ควรอ่านให้ครบถ้วนก่อนสมัคร ทั้งคุณสมบัติผู้สมัครและการใช้ข้อมูลส่วนบุคคล แล้วจึงกรอกข้อมูลตามที่ระบบกำหนดและตรวจสอบความถูกต้องก่อนยืนยัน
        </li>
        <li>
          <strong class="text-[#f9a826]">กติกาของเกมและรายชื่อค่ายเกม</strong> ควรเปิดอ่านเป็นรายเกมก่อนเข้าใช้งาน เพราะแต่ละค่ายเกมมีรูปแบบการเดิมพันต่างกัน และควรอ่านตารางจ่ายรางวัลกับทำความเข้าใจความผันผวนของเกมไปพร้อมกัน
        </li>
        <li>
          <strong class="text-[#f9a826]">เงื่อนไขของโปรโมชั่นที่กำลังสนใจ</strong> ควรตรวจสอบประเภทเกมที่ร่วมรายการ ยอดที่นำมาคำนวณ รอบคำนวณและรอบจ่ายโบนัส รวมถึงวิธีรับเครดิตว่าระบบเพิ่มให้อัตโนมัติหรือต้องกดรับด้วยตนเอง
        </li>
        <li>
          <strong class="text-[#f9a826]">ข้อมูลที่จะส่งให้เจ้าหน้าที่ตรวจสอบ</strong> ควรตั้งรหัสผ่านที่ปลอดภัย ไม่ใช้ข้อมูลของบุคคลอื่นในการลงทะเบียน และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น แม้จะอ้างว่าเป็นเจ้าหน้าที่ก็ตาม
        </li>
      </ol>

      <p>
        <strong class="text-[#f9a826]">การอ่านให้ครบตั้งแต่ก่อนเริ่มช่วยให้แจ้งเรื่องได้ตรงประเด็นเมื่อเกิดปัญหาขึ้นจริง</strong>
        หากพบปัญหาในการทำรายการ ควรเตรียมข้อมูลและหลักฐานที่เกี่ยวข้องให้พร้อมสำหรับการตรวจสอบ พร้อมอธิบายรายละเอียดให้ชัดเจนเมื่อติดต่อเจ้าหน้าที่ผ่านช่องทางทางการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`โปรโมชั่นและช่องทางติดต่อแอดมิน ${BRAND_NAME} ตลอด 24ชม.`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        เมื่อคุ้นเคยกับขั้นตอนการใช้งานแล้ว เรื่องถัดไปคือรายการโปรโมชั่นที่เว็บไซต์ระบุไว้ ซึ่งมีทั้ง
        <strong class="text-[#f9a826]">คืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อน โบนัส 0.8% ไม่จำกัด</strong>
        โดยรายการแรกระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขในแต่ละวัน จึงควรตรวจสอบว่าระบบใช้ยอดเสียจากเกมประเภทใด มีรอบสรุปยอดเวลาใด และต้องกดรับเครดิตด้วยตนเองหรือไม่ รวมถึงอ่านข้อกำหนดเกี่ยวกับการใช้เครดิตและการถอนเงินให้ครบถ้วน ทั้งนี้ เครดิตคืนยอดเสียไม่ใช่การรับประกันว่าจะได้เงินคืนจากทุกการเดิมพัน
      </p>

      <p>
        ส่วนรายการแนะนำเพื่อนควรตรวจสอบขั้นตอนการรับลิงก์แนะนำ วิธีเชื่อมโยงบัญชี และยอดที่นำมาคำนวณโบนัสก่อนเข้าร่วม แม้จะมีการระบุว่าไม่จำกัด แต่ควรศึกษาข้อกำหนดเกี่ยวกับจำนวนผู้เข้าร่วม รอบจ่ายโบนัส และเงื่อนไขการใช้เครดิตให้ชัดเจน
        <strong class="text-[#f9a826]">หากมีข้อสงสัยสามารถติดต่อเจ้าหน้าที่ผ่านช่องทางทางการเพื่อสอบถามรายละเอียดเพิ่มเติมได้</strong>
        โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่นไม่ว่ากรณีใด
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#04366b] bg-gradient-to-b from-[#c3ebfc] to-[#039cfa] px-8 py-3 font-black text-[#031320] shadow-[0_0_14px_rgba(3,156,250,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#f9a826]/80 bg-gradient-to-b from-[#071e38] to-[#030f1d] px-8 py-3 font-bold text-[#f9a826] shadow-[0_0_12px_rgba(249,168,38,0.4)] transition-all hover:scale-105 hover:border-[#f9a826]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
