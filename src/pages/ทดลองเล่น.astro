---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion,
// /login, /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์
// หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ (src/assets/content.txt) ไม่มี
// หมวด "ทดลองเล่น" และไม่มีส่วน SUB-PAGES เลย ทั้งหน้าจึงเขียนจากข้อเท็จจริงและ
// คลังคำของบรีฟรอบนี้ (.claude/brand-spec-ruaythear168vip.md §6)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
//   h1  ทดลองเล่น <แบรนด์> ไล่ดูรูปแบบการเดิมพันและประเภทหวยก่อนใช้งานจริง
//   h2  ไล่ดูประเภทหวยและรูปแบบการเดิมพันที่เปิดให้บริการ
//   h2  ตรวจรอบเปิดรับ อัตราจ่าย และแหล่งอ้างอิงผลรางวัลก่อนทำรายการ
//   h2  ศึกษาเงื่อนไขฝากถอนและโปรโมชั่นก่อนทำรายการจริง
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// 🚨 แกนของดรอปนี้ (2026-10-21) คือ **เว็บหวยล้วน** — เว็บที่รวบรวมหวยหลาย
// ประเภทไว้ที่เดียว: **หวยรัฐบาลไทย (อ้างอิงผลสลากกินแบ่งรัฐบาล) · หวยลาวพัฒนา ·
// หวยฮานอย · หวยหุ้นต่างประเทศ** พร้อมอัตราจ่าย โปรโมชั่น และระบบฝากถอน
// **ไม่ใช่เว็บเกมคาสิโนและไม่ใช่เว็บระบบการเงิน**
// ⚠️ หมวดเกมของแบรนด์ก่อนหน้า (รายการเต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง)
// **ไม่มีในบรีฟรอบนี้เลยแม้แต่คำเดียว ห้ามเติมกลับเข้ามา**
//
// route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ทดลองเล่น · /about-us · /contact-us · /ตรวจหวย · /แนวทาง · /terms ·
// /privacy · /line  (รอบนี้เป็นเว็บหวย → /ตรวจหวย กับ /แนวทาง เปิดอยู่จริง
// ตาม brand-spec §4 ลิงก์ไปได้)
//
// ⚠️ **บรีฟไม่ได้ประกาศว่ามีโหมดทดลอง เครดิตทดลอง หรือเดโมฟรีเป็นบริการของเว็บ**
// จึงห้ามสัญญาสินค้าตัวนั้น คำว่า "ทดลองเล่น" บนหน้านี้จึงหมายถึงสิ่งที่บรีฟระบุ
// ไว้ตรงๆ ว่าทำได้: ไล่ดูประเภทหวยและรูปแบบการเดิมพัน ตรวจรอบเปิดรับ รอบปิดรับ
// อัตราจ่าย แหล่งอ้างอิงผลรางวัล และศึกษาเงื่อนไขฝากถอน/โปรโมชั่นให้ครบหนึ่งรอบ
// แล้วสอบถามเจ้าหน้าที่ ก่อนทำรายการจริง
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อผู้ผลิตเกม ชื่อธนาคาร ผู้ให้บริการ ใบอนุญาต
// นิติบุคคล ปีก่อตั้ง จำนวนสมาชิก หรือยอดฝากขั้นต่ำ แม้แต่รายการเดียว** จึงห้าม
// เขียนลงหน้าเว็บ · ตัวเลขที่ขึ้นหน้าได้มีแค่ของบรีฟเอง: 2 ตัว 100 · 3 ตัว 1,000 ·
// 0.3% · 0.8% · 24ชม.
//
// คลังคำที่บรีฟรอบนี้ให้มาและใช้ได้เท่านี้ (brand-spec §6): หวยออนไลน์ ·
// ช่องทางเล่นหวย · หวยรัฐบาลไทย · สลากกินแบ่งรัฐบาล · หวยลาวพัฒนา · หวยฮานอย ·
// หวยหุ้นต่างประเทศ · ระบบจริงจากเว็บแม่ · บริษัทแม่ · รอบเปิดรับ · รอบปิดรับ ·
// รอบประกาศผล · อัตราจ่าย · แหล่งอ้างอิงผลรางวัล · ตารางอัตราจ่าย · เลข 2 ตัว ·
// เลข 3 ตัว · สองตัวบน · สองตัวล่าง · สามตัวตรง · สามตัวโต๊ด · เลขอั้น ·
// การจำกัดยอดรับ · วงเงินจ่ายสูงสุด · ฐานเงินเดิมพัน · บิลหวย · หมายเลขรายการ ·
// ฝากถอน · ธนาคาร · วอลเลท · ยอดขั้นต่ำ · ระยะเวลาดำเนินการ · ชื่อบัญชีปลายทาง ·
// บัญชีแอบอ้าง · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · โบนัส · เครดิต · ยอดเสีย ·
// รอบรับเครดิต · ลิงก์แนะนำ · เชื่อมโยงบัญชี · ไม่จำกัดยูส · เจ้าหน้าที่ · แอดมิน ·
// 24ชม. · เว็บไซต์ทางการ · ประกาศล่าสุด · รหัสผ่าน · รหัส OTP ·
// หลักฐานที่เชื่อถือได้
//
// ⚠️ คำโฆษณาของบรีฟ ("จ่ายสูงไม่อั้น" · "ไม่มีประวัติโกง" · "รับได้ไม่จำกัดยูส")
// อยู่ได้เฉพาะในหัวข้อที่บรีฟเขียนไว้เอง (= หัวข้อของ index.astro) ห้ามขยายเป็น
// คำกล่าวอ้างใหม่ของหน้านี้
//
// 🚨 ประโยคกำกับความเสี่ยงของบรีฟที่ต้องขึ้นครบ (เป็นเนื้อหาของบรีฟ ไม่ใช่
// filler ให้ตัดทิ้ง):
// 1) ผู้ใช้งานสามารถตรวจสอบรอบเปิดรับและเงื่อนไขของแต่ละรายการก่อนทำธุรกรรม ·
//    ข้อมูลเกี่ยวกับบริษัทแม่และประวัติการให้บริการควรตรวจสอบจากหลักฐานที่
//    เชื่อถือได้ (h1)
// 2) อัตราจ่ายจริงอาจขึ้นอยู่กับประเภทหวย รูปแบบการเดิมพัน และเงื่อนไขของแต่ละ
//    รอบ · ควรตรวจสอบตารางอัตราจ่ายล่าสุด เลขอั้น การจำกัดยอดรับ และวงเงินจ่าย
//    สูงสุด · ผลรางวัลไม่สามารถคาดการณ์หรือรับประกันได้ (h2 #1 / h2 #2)
// 3) ควรตรวจสอบวันเวลาเปิดรับ อัตราจ่าย แหล่งอ้างอิงผลรางวัล และข้อกำหนดของแต่ละ
//    ประเภทก่อนทำรายการ เพื่อป้องกันความเข้าใจคลาดเคลื่อน · ไม่เปิดเผยรหัสผ่าน
//    หรือรหัส OTP (h2 #2)
// 4) ตรวจสอบชื่อบัญชีปลายทางให้ตรงกับข้อมูลผู้ให้บริการที่ยืนยันได้ · เก็บหลักฐาน
//    การทำรายการและติดต่อผู้ให้บริการชำระเงินโดยเร็ว · ไม่โอนเงินซ้ำโดยไม่ได้
//    ตรวจสอบสถานะรายการเดิม · เครดิตคืนยอดเสียไม่ได้รับประกันผลตอบแทนจากการ
//    เดิมพันครั้งต่อไป · แม้ระบุว่าไม่จำกัด แต่ควรยืนยันจำนวนบัญชีที่เข้าร่วม
//    รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุด · ควรตรวจสอบเวลาการให้
//    บริการจริงจากประกาศล่าสุดอีกครั้ง (h2 #3)
//
// 🚨 **รอบนี้หน้านี้ไม่มีรูปเลย และนั่นตั้งใจ** — ดรอปนี้ (brand-spec §5) ไม่มี
// article illustration (banner2/banner3 เป็นอาร์ตเวิร์กของแบรนด์คนละราย เก่า
// ทั้งคู่) และ slide1/slide2 ถูกตรึงไว้กับ index กับ /promotion เท่านั้น ส่วน
// gamedemo*.webp ที่ยังอยู่บนดิสก์ (gamedemo7–18) เป็น **อาร์ตสต็อกเกมของ
// เทมเพลตในหมวดอื่น** ซึ่งขัดทั้งแกนแบรนด์ (รอบนี้เป็นเว็บหวยล้วน)
// และพาเลตของรอบนี้ จึงไม่ import **ไฟล์ยังอยู่บนดิสก์ ห้ามลบ เป็นอินเวนทอรี
// ของแบรนด์หมวดนั้นรอบถัดไป** — แค่ห้าม import (ลำพังการ import ก็ทำให้ไฟล์ถูก
// emit ลง dist/ และ verify-build จะแดงถ้าไม่ถูก render) · banner1 /
// banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// slide3/slide4 เป็นโปสเตอร์หวยของอีกแบรนด์ ห้าม import
//
// 🚨 พาเลตรอบนี้ (brand-spec §2) เป็น **ธีมสว่าง** bg.json ของดรอปนี้คือ
// {"mode":"color","color":"#ffdbdb"} = ชมพูกุหลาบสว่าง ไม่ใช่ดำ
// **ห้าม "แก้" กลับไปเป็นพื้นเข้มเพราะรอบก่อนๆ เป็นแบบนั้น**
// ค่าที่ใช้ได้ในไฟล์นี้: แดงเข้ม #8f0505 (<strong>/marker — 9.6:1 บนผิวการ์ดขาว) ·
// หมึกแดงเลือดหมู #4a0f0f (เนื้อความ = BRAND_TEXT, 15.4:1) · แดงสด #c30303
// (พื้นถม/ขอบ/ออรา — ขาวบนพื้นนี้ได้ 6.3:1) · ขาว #ffffff (ตัวอักษรบนพื้นถมแดง) ·
// อินเซ็ต #fff1ef / พื้นเพจ #ffdbdb
// 🚨 **แดงชาดสด e81313 ห้ามถือตัวอักษรและห้ามเป็นพื้นของตัวอักษร** เป็น stop ของ
// ไล่เฉด/ออราได้อย่างเดียว · สีไฮไลต์ <strong> ในเนื้อความมีตัวเดียวคือ #8f0505
// 🚨 **#ffdbdb และ #fff1ef ห้ามถือตัวอักษรบนพื้นขาว** เป็นสีพื้น/ขอบเท่านั้น
// 🚨 **ทองโบราณของรอบนี้ (dcb95f b8862b 96681f) ห้ามใช้ในไฟล์นี้เลยสักจุด**
// — บนผิวการ์ดขาวได้แค่ 1.9–3.5:1 ทองเป็นสีของโครม (navbar/footer/ticker) เท่านั้น
// ออราที่อนุญาต: rgba(195,3,3,α) · rgba(143,5,5,α) · rgba(74,15,15,α)
// ⚠️ ห้ามกลับด้าน: พื้นถมแดงสด #c30303 ต้องใช้ตัวอักษรขาวเสมอ ห้ามหมึกเข้ม
// · รอบนี้ไม่มีเขียว ไม่มีชมพูบานเย็น ไม่มีบรอนซ์ส้ม ไม่มีฟ้า/น้ำเงิน/ไซยาน
// ไม่มีม่วง ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์ · เขียวของแบรนด์ LINE ไม่ปรากฏใน
// ไฟล์นี้ (ปุ่ม LINE อยู่บน /about-us กับ /contact-us) ปุ่มในไฟล์นี้จึงมีสามขั้ว:
// พื้นถมแดงสด vs พื้นถมไล่เฉดแดงเข้ม vs อินเซ็ตขอบแดงโปร่ง
// marker ของลำดับเลขใช้แดงเข้ม #8f0505 (เป็นตัวอักษร) และชิปไอคอนใช้แดงสด
// เป็น **เส้นขอบ** บนอินเซ็ต #fff1ef ไม่ถือตัวอักษร
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT
// #4a0f0f, 15.4:1 บนผิวการ์ดขาว) ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่
// ประกาศสีของตัวเอง ปล่อยให้สืบทอดลงมา และไม่ใส่ mx-auto / max-w-* บน <p> เพราะ
// การ์ดคุมความกว้างเองแล้ว — มีแค่ปุ่ม ชิปไอคอน marker ของลำดับเลข และ <strong>
// ที่ประกาศสี โดย <strong> ใช้แดงเข้ม #8f0505 ตัวเดียวตาม brand-spec §2
// และแต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่
// เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง
// และห้ามวาง <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังในข้อความของ prop
//
// Announcement รอบนี้หมุนมาเป็น Announcement5 ทั้งเว็บ (brand-spec §3) ยกเว้น
// สองหน้าหวย (/ตรวจหวย · /แนวทาง) ที่คง AnnouncementHuay ไว้เป็นซับธีม —
// orchestrator ตั้ง default message ของ Announcement5 เป็นคอปปี้ของแบรนด์นี้แล้ว
// จึงเรียกแบบ bare **ห้ามส่ง prop message** มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 159 อักขระ เป็นประโยคเดียวที่บอกว่าหน้านี้มีไว้ทำอะไร แล้วหยุด
// (Google ตัดราว 155 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} หน้ารวมวิธีไล่ดูประเภทหวยและรูปแบบการเดิมพันก่อนใช้งานจริง พร้อมจุดที่ควรตรวจทั้งรอบปิดรับ อัตราจ่าย แหล่งอ้างอิงผลรางวัล และเงื่อนไขฝากถอน`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ไล่ดูรูปแบบการเดิมพันและประเภทหวยก่อนใช้งานจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#8f0505]">{BRAND_NAME} รวบรวมข้อมูลหวยออนไลน์หลายประเภทไว้ในเว็บไซต์เดียว</strong>
        ทั้งหวยรัฐบาลไทย หวยลาวพัฒนา หวยฮานอย และหวยหุ้นต่างประเทศ พร้อมรายละเอียดอัตราจ่าย โปรโมชั่น และระบบฝากถอนสำหรับสมาชิก หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับการเล่นหวยออนไลน์ได้ไล่ดูให้ครบหนึ่งรอบก่อนใช้งานจริง
        ตั้งแต่รูปแบบการเดิมพันของแต่ละประเภทหวย ไปจนถึงเงื่อนไขของการฝากถอนและการรับโปรโมชั่น
      </p>

      <p>
        คำว่า ทดลองเล่น ที่หน้านี้พูดถึงจึงหมายถึง
        <strong class="text-[#8f0505]">การไล่อ่านรูปแบบการเดิมพัน อัตราจ่าย และเงื่อนไขบริการให้ครบก่อนทำรายการจริง</strong>
        ไม่ใช่การแจกเครดิตทดลอง ผู้ใช้งานสามารถตรวจสอบรอบเปิดรับและเงื่อนไขของแต่ละรายการได้ก่อนทำธุรกรรม และหากพบข้อสงสัยระหว่างใช้งานสามารถสอบถามเจ้าหน้าที่ผ่านช่องทางทางการได้
      </p>

      <p>
        เนื้อหาในหน้านี้เขียนไว้ประกอบการใช้งานเท่านั้น ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะทำรายการ
        <strong class="text-[#8f0505]">ส่วนข้อมูลเกี่ยวกับบริษัทแม่และประวัติการให้บริการควรตรวจสอบจากหลักฐานที่เชื่อถือได้</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ไล่ดูประเภทหวยและรูปแบบการเดิมพันที่เปิดให้บริการ" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        ลำดับการไล่ดูจะเป็นชุดเดียวกันทุกครั้ง
        <strong class="text-[#8f0505]">เปิดประเภทหวยที่สนใจ อ่านรูปแบบการเดิมพันที่รายการนั้นเปิดไว้ แล้วจึงดูตารางอัตราจ่ายของแต่ละรูปแบบต่อ</strong>
        จากนั้นค่อยอ่านเลขอั้น การจำกัดยอดรับ และวงเงินจ่ายสูงสุดที่เว็บไซต์ระบุไว้ประกอบ การไล่ดูให้ครบหนึ่งรอบก่อนจึงช่วยให้สอบถามเจ้าหน้าที่ได้ตรงประเด็นเมื่อมีข้อสงสัย
      </p>

      <ul class="flex flex-col gap-4" aria-label="ประเภทหวยที่ควรไล่ดูให้ครบก่อนใช้งานจริง">
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#c30303]/50 bg-[#fff1ef] text-sm">🎫</span>
          <span>
            <strong class="text-[#8f0505]">หวยรัฐบาลไทยที่อ้างอิงผลสลากกินแบ่งรัฐบาล</strong> ควรอ่านว่ารายการนั้นรับรูปแบบใดไว้ และรอบปิดรับของงวดนั้นอยู่เวลาใด
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#c30303]/50 bg-[#fff1ef] text-sm">🗓️</span>
          <span>
            <strong class="text-[#8f0505]">หวยลาวพัฒนาที่มีรอบประกาศผลของตัวเอง</strong> ควรแยกอ่านเป็นรายประเภท ไม่ควรเทียบรอบของประเภทหนึ่งไปใช้กับอีกประเภทหนึ่ง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#c30303]/50 bg-[#fff1ef] text-sm">🕐</span>
          <span>
            <strong class="text-[#8f0505]">หวยฮานอยที่มีรอบประกาศผลตามประเภท</strong> ควรดูให้ชัดเจนว่ารายการที่เลือกใช้รอบใด เพราะแต่ละรอบปิดรับไม่พร้อมกัน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#c30303]/50 bg-[#fff1ef] text-sm">📈</span>
          <span>
            <strong class="text-[#8f0505]">หวยหุ้นต่างประเทศที่มีรอบประกาศผลแตกต่างออกไป</strong> ควรอ่านว่ารายการนั้นใช้ตัวเลขชุดใดเป็นผล และอ้างอิงจากแหล่งใด
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#8f0505]">สิ่งที่การไล่ดูช่วยได้คือทำให้รู้ว่ารูปแบบการเดิมพันและเงื่อนไขอยู่ตรงไหนเท่านั้น</strong>
        ไม่ได้เป็นการรับประกันยอดเครดิตที่จะได้รับ เนื่องจากผลรางวัลไม่สามารถคาดการณ์หรือรับประกันได้ รายละเอียดที่เว็บไซต์แสดงอยู่ขณะใช้งานจึงเป็นสิ่งที่ควรยึดเป็นหลัก และควรกำหนดงบไว้ล่วงหน้าก่อนเริ่มทุกครั้ง
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/about-us"
          aria-label={`อ่านหน้าเกี่ยวกับเราของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#c30303]/45 bg-[#fff1ef] px-8 py-3 font-bold text-[#4a0f0f] shadow-[0_4px_14px_rgba(74,15,15,0.15)] transition-all hover:scale-105 hover:border-[#c30303] hover:shadow-[0_6px_18px_rgba(195,3,3,0.3)]">
          อ่านเกี่ยวกับเรา
        </a>

        <a
          href="/แนวทาง"
          aria-label={`เปิดหน้าแนวทางของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#c30303]/45 bg-[#fff1ef] px-8 py-3 font-bold text-[#4a0f0f] shadow-[0_4px_14px_rgba(74,15,15,0.15)] transition-all hover:scale-105 hover:border-[#c30303] hover:shadow-[0_6px_18px_rgba(195,3,3,0.3)]">
          ไปหน้าแนวทาง
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="ตรวจรอบเปิดรับ อัตราจ่าย และแหล่งอ้างอิงผลรางวัลก่อนทำรายการ" as="h2">
    <div class="flex flex-col gap-5">
      <p>
        การไล่ดูระบบมีประโยชน์ที่สุดเมื่อมองว่าเป็นการอ่านรายละเอียดให้จบก่อน
        <strong class="text-[#8f0505]">เป้าหมายคือรู้ว่าแต่ละประเภทหวยปิดรับเวลาใด จ่ายในอัตราเท่าใด อ้างอิงผลรางวัลจากแหล่งใด และสอบถามเจ้าหน้าที่ได้ทางไหนเมื่อมีข้อสงสัย</strong>
        รายการด้านล่างคือชุดที่ควรตรวจก่อนทำรายการครั้งแรก และควรตรวจซ้ำทุกครั้งที่กลับเข้ามาใหม่ เพราะเงื่อนไขปรับเปลี่ยนได้ตามที่เว็บไซต์กำหนด
      </p>

      <ol class="ml-6 list-decimal space-y-3 marker:font-black marker:text-[#8f0505]">
        <li>
          <strong class="text-[#8f0505]">ที่อยู่เว็บไซต์ทางการและทางเข้าที่ใช้</strong> ควรตรวจสอบให้ถูกต้องก่อนเลือกเมนูใดหรือกรอกข้อมูลใด ไม่ใช่เปิดจากลิงก์ที่ส่งต่อกันมา และควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ
          เพื่อหลีกเลี่ยงบัญชีแอบอ้าง
        </li>
        <li>
          <strong class="text-[#8f0505]">วันเวลาเปิดรับและรอบปิดรับของประเภทที่เลือก</strong> ควรดูให้ชัดเจนก่อนส่งรายการ เพราะหวยแต่ละประเภทปิดรับไม่พร้อมกัน และรายการที่ส่งหลังรอบปิดรับจะไม่อยู่ในงวดที่ต้องการ
        </li>
        <li>
          <strong class="text-[#8f0505]">ตารางอัตราจ่ายและแหล่งอ้างอิงผลรางวัล</strong> ข้อมูลโปรโมชั่นระบุตัวอย่างไว้ที่เลข 2 ตัว 100 และเลข 3 ตัว 1,000 จึงควรอ่านต่อว่าอัตรานั้นคิดต่อฐานเงินเดิมพันเท่าใด
          ครอบคลุมสองตัวบน สองตัวล่าง สามตัวตรง หรือสามตัวโต๊ด และอ้างอิงผลจากแหล่งเดียวกับที่เว็บไซต์ระบุไว้หรือไม่
        </li>
        <li>
          <strong class="text-[#8f0505]">บิลหวยและหมายเลขรายการที่ได้รับ</strong> ควรตรวจสอบรายการทันทีหลังส่งว่าตรงกับที่ต้องการ และเก็บหมายเลขรายการไว้สำหรับใช้อ้างอิงเมื่อต้องสอบถามเจ้าหน้าที่
        </li>
        <li>
          <strong class="text-[#8f0505]">ข้อมูลที่จะใช้สมัครและเข้าใช้งาน</strong> ควรกรอกข้อมูลที่ถูกต้อง ตั้งรหัสผ่านที่ปลอดภัย ไม่ใช้ข้อมูลของบุคคลอื่น และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น
          แม้จะอ้างว่าเป็นเจ้าหน้าที่ก็ตาม
        </li>
      </ol>

      <p>
        ผู้ใช้งานควรตรวจสอบวันเวลาเปิดรับ อัตราจ่าย แหล่งอ้างอิงผลรางวัล และข้อกำหนดของแต่ละประเภทก่อนทำรายการ
        <strong class="text-[#8f0505]">เพื่อป้องกันความเข้าใจคลาดเคลื่อนเกี่ยวกับรอบหวยและผลการตรวจรางวัล</strong>
        เพราะอัตราจ่ายจริงอาจขึ้นอยู่กับประเภทหวย รูปแบบการเดิมพัน และเงื่อนไขของแต่ละรอบ
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/ตรวจหวย"
          aria-label={`เปิดหน้าตรวจหวยของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#c30303]/45 bg-[#fff1ef] px-8 py-3 font-bold text-[#4a0f0f] shadow-[0_4px_14px_rgba(74,15,15,0.15)] transition-all hover:scale-105 hover:border-[#c30303] hover:shadow-[0_6px_18px_rgba(195,3,3,0.3)]">
          ไปหน้าตรวจหวย
        </a>

        <a
          href="/ทางเข้า"
          aria-label={`เปิดหน้าทางเข้าของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#c30303]/45 bg-[#fff1ef] px-8 py-3 font-bold text-[#4a0f0f] shadow-[0_4px_14px_rgba(74,15,15,0.15)] transition-all hover:scale-105 hover:border-[#c30303] hover:shadow-[0_6px_18px_rgba(195,3,3,0.3)]">
          ไปหน้าทางเข้า
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="ศึกษาเงื่อนไขฝากถอนและโปรโมชั่นก่อนทำรายการจริง" as="h2">
    <div class="flex flex-col gap-5">
      <p>
        เมื่อคุ้นเคยกับขั้นตอนการใช้งานแล้ว เรื่องถัดไปคือเงื่อนไขของการฝากถอน
        <strong class="text-[#8f0505]">ควรศึกษาช่องทางธนาคารและวอลเลทที่เปิดใช้งานจริง ยอดขั้นต่ำ ระยะเวลาดำเนินการ และเงื่อนไขการถอนเงินให้ครบถ้วน</strong>
        รวมถึงตรวจสอบชื่อบัญชีปลายทางให้ตรงกับข้อมูลผู้ให้บริการที่ยืนยันได้ หากพบธุรกรรมล่าช้าหรือข้อมูลบัญชีผิดปกติ ควรเก็บหลักฐานการทำรายการและติดต่อผู้ให้บริการชำระเงินโดยเร็ว และไม่โอนเงินซ้ำโดยไม่ได้ตรวจสอบสถานะรายการเดิม
      </p>

      <p>
        ถัดมาคือรายการโปรโมชั่นที่เว็บไซต์ระบุไว้ ซึ่งมีทั้ง
        <strong class="text-[#8f0505]">คืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อน โบนัส 0.8% ไม่จำกัด</strong>
        โดยรายการแรกระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขในแต่ละวัน จึงควรตรวจสอบว่าหวยรัฐบาลไทย หวยลาวพัฒนา หวยฮานอย หรือหวยหุ้นต่างประเทศประเภทใดเข้าร่วมรายการ รวมถึงรอบคำนวณยอดและวิธีรับเครดิต ทั้งนี้
        เครดิตคืนยอดเสียไม่ได้รับประกันผลตอบแทนจากการเดิมพันครั้งต่อไป
      </p>

      <p>
        ส่วนรายการแนะนำเพื่อนควรศึกษาวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และยอดที่ใช้คำนวณโบนัสให้ครบถ้วนก่อนเข้าร่วม แม้จะมีการระบุว่าไม่จำกัด แต่ควรยืนยันข้อกำหนดเกี่ยวกับจำนวนบัญชีที่เข้าร่วม
        รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุดให้ชัดเจน
        <strong class="text-[#8f0505]">หากมีข้อสงสัยสามารถติดต่อเจ้าหน้าที่ผ่านช่องทางทางการเพื่อสอบถามรายละเอียดเพิ่มเติมได้</strong>
        โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่นไม่ว่ากรณีใด และควรตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุดอีกครั้ง
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/promotion"
          aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#c30303]/45 bg-[#fff1ef] px-8 py-3 font-bold text-[#4a0f0f] shadow-[0_4px_14px_rgba(74,15,15,0.15)] transition-all hover:scale-105 hover:border-[#c30303] hover:shadow-[0_6px_18px_rgba(195,3,3,0.3)]">
          ดูภาพโปรโมชั่น
        </a>

        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#8f0505] bg-[#c30303] px-8 py-3 font-black text-white shadow-[0_0_14px_rgba(195,3,3,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#8f0505] bg-gradient-to-b from-[#c30303] to-[#8f0505] px-8 py-3 font-bold text-white shadow-[0_0_12px_rgba(143,5,5,0.4)] transition-transform hover:scale-105">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
