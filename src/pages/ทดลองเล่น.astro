---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";

import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion,
// /login, /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์
// หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้า
// ขึ้นใหม่บนข้อเท็จจริงของ HI59 เท่านั้น (src/assets/content.txt)
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก NavbarStyle6 (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// HI59 เป็น **เว็บสล็อตออนไลน์** ไม่ใช่เว็บหวย แง่มุมที่บรีฟระบุไว้มีเท่านี้:
// สล็อตไฮคลาสเน้นรูปแบบการใช้งานสไตล์ VIP · รวมเกมสล็อตจากหลายค่ายไว้ในบัญชีเดียว ·
// สล็อตยอดนิยม เกมเปิดใหม่ ฟรีสปิน ตัวคูณ ฟีเจอร์โบนัส · รองรับมือถือและคอมพิวเตอร์ ·
// เลือกค่าย ค้นหาเกม ตรวจสอบเครดิต โปรโมชั่น ประวัติรายการ · สลับเกมและค่ายผ่าน
// บัญชีเดียวโดยไม่ต้องสมัครใหม่หลายครั้ง · แต่ละเกมมีรูปแบบวงล้อ ฟีเจอร์โบนัส
// ฟรีสปิน และช่วงเดิมพันแตกต่างกัน · ตรวจสอบรายละเอียดเกมก่อนเริ่มเล่น ·
// คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · ฝากถอนตามช่องทางที่ระบบเปิดให้บริการ ·
// แอดมิน 24 ชั่วโมง · PIN รหัสผ่าน OTP
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามี "โหมดทดลอง" เครดิตทดลอง หรือเดโมฟรีเป็นบริการของเว็บ —
// จึงห้ามสัญญาสินค้าตัวนั้น คำว่า "ทดลองเล่น" บนหน้านี้จึงหมายถึงสิ่งที่บรีฟระบุ
// ไว้ตรง ๆ ว่าทำได้: "เลือกค่าย ค้นหาเกม" และ "ตรวจสอบรายละเอียดเกมก่อนเริ่มเล่น
// เพื่อเลือกประเภทที่ตรงกับความสนใจ" = ไล่ดูระบบให้ครบหนึ่งรอบก่อนลงเครดิตจริง
//
// ⚠️ ห้าม import src/assets/gamedemo7–18.webp กลับมาเด็ดขาด — ตรวจไฟล์จริงแล้ว
// ไม่ใช่อาร์ตเดโมกลาง แต่เป็นภาพโปรโมตที่มีโลโก้ของผู้ให้บริการเจ้าอื่นพิมพ์ทับอยู่
// กลางรูป (gamedemo7 = askmeslot · gamedemo12 = SBOBET · gamedemo18 = AFB777 Gaming)
// การนำกลับมาจะเท่ากับเอาชื่อค่ายเกมและชื่อแบรนด์ของลูกค้าเจ้าอื่นขึ้นหน้าเว็บ HI59
// ซึ่งขัดกับ brand-spec §7 โดยตรง (ห้ามอ้างชื่อผู้ให้บริการ/ค่ายเกมที่บรีฟไม่ได้เอ่ย)
// ไฟล์ยังอยู่บนดิสก์ ห้ามลบ เป็นอินเวนทอรี
//
// ⚠️ แบรนด์ก่อนหน้าของหน้านี้คือ หวยดีใจ (เว็บรับแทงหวย) และก่อนหน้านั้นคือ หวย24
// คำชุดหวยทั้งหมดจึงห้ามหลงเหลือ: หวย แทงหวย ส่งโพย โพย เลข 2 ตัว เลข 3 ตัว
// เลขเด็ด แนวทาง หวยลาว หวยฮานอย หวยออมสิน ธ.ก.ส. อัตราจ่าย เรทจ่าย ไม่อั้นจ่าย
// ไม่มีลบโพย งวด ผลรางวัล — เขียนใหม่จากบรีฟ ไม่ใช่ find-and-replace ทับประโยคเดิม
// ลิงก์ /แนวทาง กับ /ตรวจหวย ถูกย้ายไป src/pages-disabled/ รอบนี้ จึงถอดออกจากหน้า
// ด้วย (ลิงก์ที่ไม่มีปลายทางจริงทำให้ verify-build แดง)
//
// ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 100% · 24 ชั่วโมง
// ห้ามเติมเลขใบอนุญาต หน่วยงานกำกับ ชื่อผู้ให้บริการ ชื่อค่ายเกม ชื่อธนาคาร
// ค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีที่ก่อตั้ง เพราะบรีฟไม่ได้เอ่ยไว้
//
// ประโยคกำกับของบรีฟที่ห้ามตัดทิ้ง: เว็บตรง/ลิขสิทธิ์แท้ ควรมีข้อมูลผู้ให้บริการ
// ที่ตรวจสอบได้รองรับ · "ส่งตรงจากเว็บแม่" ควรมีรายชื่อผู้ให้บริการหรือข้อมูลการ
// เชื่อมต่อที่ตรวจสอบได้ · "ปลอดภัย 100%" ไม่ควรใช้เป็นการรับประกันโดยไม่มีหลักฐาน ·
// "โบนัสสูง ให้เยอะกว่าใคร" ควรมีข้อมูลเปรียบเทียบรองรับ · รายชื่อค่ายและจำนวนเกม
// อาจมีการอัปเดต ควรยึดรายการล่าสุดจากหน้าเกมสล็อตของเว็บไซต์
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: banner1/banner1-mobile/og.png เป็นของ glob ที่
// MainLayout ปักไว้ ห้ามอ้างจากหน้า · slide1/slide2 ของดรอปนี้เป็นของ index และ
// /promotion · slide3/slide4/banner2/banner3 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น Announcement2 ทั้งเว็บ (รอบก่อน หวยดีใจ ใช้ Announcement5)
// — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ HI59 แล้ว จึงเรียก
// แบบ bare ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ HI59 (brand-spec §2) **ฟ้าสว่าง + ทอง VIP บนการ์ดกระจกน้ำแข็ง** —
// เนื้อความกรมท่า #0d2744 (= BRAND_TEXT ที่การ์ดตั้งไว้ให้) · หมึก strong บนการ์ด
// สว่าง #065a9c (ฟ้าแบรนด์ #0a84e0 ได้แค่ 4.0:1 จึงใช้เป็นขอบ/เรืองแสงเท่านั้น) ·
// ไอคอนและ marker ทองเข้ม #c88a02 · ปุ่มหลักทองตัน #ffe27a → #fdbc04 → #c88a02
// หมึกกรมท่า #04203f · ปุ่มรองฟ้าเข้ม #065a9c → #044b80 → #033f70 หมึก #eaf5ff ·
// ปุ่มเส้นขอบผิว #e7f2fd ขอบ #0a84e0 หมึก #065a9c
// ชุดแดงแบรนด์+เงินโครเมียมของ หวยดีใจ (#dc0409 #f5363d #8e0206 #eef0f4 #c3c7d1
// #f3c54e #0d0407 #211016) ออกครบทุกจุดแล้ว ทั้งคลาส Tailwind raw hex และ rgba()
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// — การ์ดตั้ง text-left text-base leading-relaxed text-[#0d2744] ไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าจึงไม่ถือคลาสสีของตัวเอง ใส่สีเฉพาะที่ <strong> กับไอคอน
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 159 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} ด้วยการไล่ดูระบบจริงให้ครบ ตั้งแต่เลือกค่ายเกม ค้นหาเกมสล็อต และตรวจสอบรายละเอียดวงล้อ ฟรีสปิน ตัวคูณ กับช่วงเดิมพัน ก่อนเริ่มเล่นด้วยเครดิตจริง`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ไล่ดูค่ายเกมและรายละเอียดสล็อตก่อนเริ่มเล่นจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#065a9c]">{BRAND_NAME}</strong> เป็นเว็บสล็อตไฮคลาสที่เน้นรูปแบบการใช้งานสไตล์ VIP
        <strong class="text-[#065a9c]">พร้อมรวบรวมเกมสล็อตจากหลายค่ายไว้ในบัญชีเดียว ทั้งสล็อตยอดนิยม เกมเปิดใหม่ ฟรีสปิน ตัวคูณ และฟีเจอร์โบนัสหลากหลายรูปแบบ</strong>
        หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับระบบได้ไล่ดูให้ครบหนึ่งรอบ ตั้งแต่การเลือกค่ายและค้นหาเกม ไปจนถึงรายละเอียดของเกมที่ระบบแสดงไว้ ก่อนจะเริ่มเล่นด้วยเครดิตจริง
      </p>

      <p>
        คำว่า ทดลองเล่น ที่หน้านี้พูดถึงจึงหมายถึง
        <strong class="text-[#065a9c]">การเปิดดูรายละเอียดของเกมก่อนเริ่มเล่น เพื่อเลือกประเภทที่ตรงกับความสนใจได้ง่ายขึ้น</strong>
        ซึ่งเป็นสิ่งที่ระบบเปิดให้ทำได้อยู่แล้ว ไม่ใช่เครดิตทดลอง ไม่ใช่การหมุนวงล้อฟรี และไม่ใช่การรับประกันผลของเกมใดเกมหนึ่ง เมื่อ Login แล้วสมาชิกจะเปิดดูเครดิต โปรโมชั่น และประวัติรายการได้จากบัญชีเดียว
      </p>

      <p>
        <strong class="text-[#065a9c]">การระบุว่าเป็นเว็บตรงหรือใช้เกมลิขสิทธิ์แท้ ควรมีข้อมูลผู้ให้บริการที่ตรวจสอบได้รองรับอย่างชัดเจน</strong>
        การไล่ดูระบบจึงทำได้ตลอด แต่ไม่ควรใช้แทนการอ่านรายละเอียดของเกมและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้า เพราะรายชื่อค่ายและจำนวนเกมอาจมีการอัปเดตได้ตลอดเวลา
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`ไล่ดูขั้นตอนเลือกค่ายและค้นหาเกมสล็อตของ ${BRAND_NAME}`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        หลัง Login ลำดับการใช้งานจะเป็นชุดเดียวกันทุกครั้ง
        <strong class="text-[#065a9c]">เลือกค่าย ค้นหาเกม เปิดอ่านรายละเอียดของเกมนั้น แล้วจึงกำหนดเดิมพันก่อนเริ่มหมุนวงล้อ</strong>
        การไล่ดูให้ครบรอบหนึ่งก่อนจึงช่วยให้รู้ว่าข้อมูลแต่ละอย่างอยู่ตรงไหนของหน้าจอ ทั้งบนมือถือและคอมพิวเตอร์ซึ่งระบบรองรับทั้งสองทาง
      </p>

      <ol class="ml-6 list-decimal space-y-3 marker:font-black marker:text-[#c88a02]">
        <li>
          <strong class="text-[#065a9c]">เลือกค่ายเกมที่ต้องการก่อน</strong> เว็บไซต์รวมค่ายเกมพรีเมียมไว้ให้เลือกหลายสไตล์ และสลับค่ายได้จากบัญชีเดิมโดยไม่ต้องสมัครใหม่หลายครั้ง จึงควรเริ่มจากค่ายที่คุ้นที่สุดแล้วค่อยไล่ดูค่ายอื่นทีหลัง
        </li>
        <li>
          <strong class="text-[#065a9c]">ค้นหาเกมจากในระบบ</strong> ทั้งสล็อตยอดนิยมและเกมเปิดใหม่อยู่ในหน้าเกมสล็อตของเว็บไซต์ รายชื่อค่ายและจำนวนเกมอาจมีการอัปเดต จึงควรยึดรายการล่าสุดที่ระบบแสดง ไม่ใช่รายการที่จำไว้จากรอบก่อน
        </li>
        <li>
          <strong class="text-[#065a9c]">เปิดอ่านรายละเอียดของเกมก่อนเริ่มเล่น</strong> แต่ละเกมมีทั้งรูปแบบวงล้อ ฟีเจอร์โบนัส ฟรีสปิน และช่วงเดิมพันแตกต่างกัน ขั้นนี้คือขั้นที่ช่วยให้เลือกประเภทที่ตรงกับความสนใจได้ง่ายขึ้น
        </li>
        <li>
          <strong class="text-[#065a9c]">ตรวจสอบเครดิตในบัญชีก่อนกำหนดเดิมพัน</strong> ยอดที่ตั้งได้ขึ้นอยู่กับช่วงเดิมพันของเกมนั้นและเครดิตที่มีอยู่ จึงเป็นจุดสุดท้ายที่ควรอ่านซ้ำก่อนเริ่มหมุนวงล้อด้วยเครดิตจริง
        </li>
      </ol>

      <p>
        <strong class="text-[#065a9c]">เกมที่อยู่คนละค่ายไม่จำเป็นต้องเปิดฟีเจอร์ชุดเดียวกัน</strong>
        ค่าที่จำไว้จากเกมก่อนหน้าจึงอาจไม่ตรงกับเกมที่กำลังจะเปิด ควรอ่านรายละเอียดของเกมนั้นใหม่ทุกครั้งแทนการอ้างจากความเคยชิน
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/about-us"
          aria-label={`อ่านหน้าเกี่ยวกับเราของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#0a84e0]/70 bg-[#e7f2fd] px-8 py-3 font-bold text-[#065a9c] transition-all hover:scale-105 hover:border-[#065a9c] hover:bg-[#d3e7fa]">
          อ่านเกี่ยวกับเรา
        </a>

        <a
          href="/promotion"
          aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#0a84e0]/70 bg-[#e7f2fd] px-8 py-3 font-bold text-[#065a9c] transition-all hover:scale-105 hover:border-[#065a9c] hover:bg-[#d3e7fa]">
          ดูภาพโปรโมชั่น
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="จุดที่ควรอ่านในรายละเอียดเกมก่อนเริ่มหมุนวงล้อ" as="h2">
    <div class="flex flex-col gap-5">
      <p>
        การไล่ดูระบบมีประโยชน์ที่สุดเมื่อมองว่าเป็นการอ่านรายละเอียดของเกมให้จบก่อน
