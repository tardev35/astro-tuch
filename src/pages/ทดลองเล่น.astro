---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { Picture } from "astro:assets";

import popularGamesImage from "../assets/gamedemo8.webp";
import newGamesImage from "../assets/gamedemo16.webp";

import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login,
// /register หรือหน้าภาพแบบ /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง
// ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้
// (src/assets/content.txt) ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่จาก
// ข้อเท็จจริงและคลังคำของบรีฟรอบนี้เท่านั้น (.claude/brand-spec-teva69.md §4-§5)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x4 · h3x0
//   h1  ทดลองเล่น <แบรนด์> ศึกษากติกาและรูปแบบการเดิมพันก่อนใช้เงินจริง
//   h2  ประเภทเกมเดิมพันที่เว็บไซต์ระบุไว้ ต่างกันที่กติกาและรูปแบบการเดิมพัน
//   h2  ค่ายผู้พัฒนาและระบบเซิร์ฟเวอร์ต่างประเทศ จุดที่ควรตรวจก่อนเริ่มใช้งาน
//   h2  ข้อความสมัครเล่นไม่มีขั้นต่ำ ครอบคลุมถึงอะไรและควรตรวจอะไรเพิ่ม
//   h2  สิ่งที่ควรตรวจซ้ำทุกครั้งก่อนเดิมพันด้วยเงินจริง
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// **การ์ดรูปสองใบอยู่ใน h2 ใบแรก ไม่ได้แยกเป็นหัวข้อของตัวเอง** เพื่อคงผัง h2x4
// ป้ายกำกับของการ์ดรูปอยู่ในตัวภาพเอง (alt) ไม่มีป้ายข้อความใดเป็น heading
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// 🚨🚨 **รอบนี้กลับทิศจากรอบก่อน: แบรนด์ขาออกอยู่คนละหมวดกับรอบนี้** (ชื่อแบรนด์
// และคลังคำของมันอยู่ใน brand-spec §5 — **ไม่พิมพ์ซ้ำที่นี่** เพื่อไม่ให้ sweep
// ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง) รอบนี้เป็น **เว็บเกมพนัน/
// คาสิโนออนไลน์** คอปปี้ทั้งหน้าจึงถูกเขียนใหม่ให้พูดถึง **กติกาของเกม ค่าย
// ผู้พัฒนา ขอบเขตของข้อความไม่มีขั้นต่ำ และเงื่อนไขการใช้บริการ** และ
// **คำหมวดของแบรนด์ขาออกทั้งชุดถูกตัดออกจากหน้านี้แล้ว**
// 🚨🚨 **คำว่า "ทดลองเล่น" อยู่ได้เฉพาะเพราะเป็นชื่อ route /ทดลองเล่น และชื่อเมนู
// จริง** (ใช้ใน h1 · title · description · breadcrumb) แต่ **บรีฟรอบนี้ไม่ได้
// พูดถึงโหมดเล่นโดยไม่ใช้เงินจริงเลยแม้แต่ประโยคเดียว** → **ห้ามอ้างว่าเว็บมี
// โหมดนั้นให้** ห้ามอ้างจำนวนเกม/ค่าย ห้ามอ้างอัตราจ่ายคืนหรือความผันผวนเป็นตัวเลข
// และห้ามอ้างว่าสถิติย้อนหลังคาดการณ์ผลรอบถัดไปได้
// แกนของหน้าจึงเป็น **"สิ่งที่ควรศึกษาและตรวจสอบก่อนเดิมพันด้วยเงินจริง"** ตามที่
// บรีฟมีจริง (บรรทัด 4, 6, 14, 22): เกมเดิมพันออนไลน์หลากหลายประเภท · ข้อมูลเกม
// จากค่ายต่าง ๆ ให้ศึกษากติกา รูปแบบการเดิมพัน และเงื่อนไขการใช้บริการ ·
// ระบบเซิร์ฟเวอร์ต่างประเทศ · **คำกล่าวอ้างเรื่องลิขสิทธิ์และความปลอดภัยยืนยัน
// ไม่ได้จากข้อความโฆษณาเพียงอย่างเดียว** · **ควรตรวจว่าข้อความไม่มีขั้นต่ำครอบคลุม
// เฉพาะการสมัครสมาชิกหรือรวมถึงการฝากเงินและการเดิมพันด้วย** · แอดมิน 24ชม. ·
// ไม่เปิดเผยรหัสผ่านหรือรหัส OTP
// ⚠️ และมีหนึ่งประโยคที่พูดตรงๆ ว่าบรีฟไม่ได้ระบุโหมดนั้นไว้ เพื่อไม่ให้ผู้อ่าน
// อนุมานเอาจากชื่อเมนู — **ห้ามถอดประโยคนั้นออก**
// ⚠️ บรีฟรอบนี้ **โฆษณาและกำกับในประโยคเดียวกัน** คำโฆษณาอยู่ได้เฉพาะในขอบเขตที่
// บรีฟเขียนไว้เอง ห้ามขยายเป็นคำกล่าวอ้างใหม่ และทุกประโยคกำกับต้อง ship ครบ
// ห้ามตัดเพราะฟังดูลบ
//
// ⚠️⚠️ ชื่อแบรนด์รอบนี้เป็น **ตัวละตินพิมพ์ใหญ่ + เลข เขียนติดกัน ไม่มีเว้นวรรค
// และไม่มีขีดกลาง** (brand-spec §1 — โดเมนมีขีด ชื่อแบรนด์ไม่มี) ทุกจุดยัง
// interpolate จาก BRAND_NAME เหมือนเดิม เพื่อไม่ให้ค้างเป็นชื่อแบรนด์ก่อนหน้า
// ตอนรีแบรนด์รอบถัดไป ห้ามพิมพ์ชื่อตรงๆ
// 🚨🚨 **บรีฟรอบนี้ไม่พูดถึงธนาคาร วอลเลท หรือการฝากถอนเป็นหมวดของเว็บเลยแม้แต่
// คำเดียว** — ห้ามเขียนหัวข้อ "ฝากถอน" หรือชื่อวอลเล็ต/ธนาคารกลับเข้ามา
// (คำว่า "การฝากเงิน" ปรากฏได้เฉพาะในประโยคกำกับของบรีฟเอง ที่ถามว่าข้อความ
// ไม่มีขั้นต่ำครอบคลุมถึงการฝากเงินและการเดิมพันด้วยหรือไม่)
// ⚠️ **0.3% กับ 0.8% เป็นเนื้อหาของบรีฟรอบนี้จริง** (กลับทิศจากรอบก่อนที่ห้าม)
// แต่เป็นเนื้อหาของ index §3-§5 กับ /promotion — **หน้านี้ไม่หยิบมาใช้โดยตั้งใจ**
// เพราะแกนของหน้าเป็นการศึกษากติกา ไม่ใช่การประกาศสิทธิประโยชน์
//
// ⚠️ **รอบนี้สองหน้าหมวดของแบรนด์ขาออกถูกปิดใช้งาน** (orchestrator ย้ายไป
// src/pages-disabled/ เพราะรอบนี้เป็นเว็บเกมพนัน คนละหมวดกับรอบก่อน — ชื่อไฟล์
// อยู่ใน brand-spec §1) → **ลิงก์ไปสองหน้านั้นจากหน้านี้ทำไม่ได้ และคู่ปุ่มที่เคย
// ชี้ไปที่นั้นถูกเปลี่ยนเป้าแล้วรอบนี้**
// route ที่มีจริงรอบนี้: / · /about-us · /contact-us · /promotion · /ทดลองเล่น ·
// /ทางเข้า · /login · /register · /terms · /privacy · 404 · /line
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกม ชื่อผู้ให้บริการ หน่วยงานกำกับ ใบอนุญาต
// ปีก่อตั้ง จำนวนสมาชิก จำนวนเกม/ค่าย หรือยอดเดิมพันขั้นต่ำเป็นตัวเลข แม้แต่
// รายการเดียว** จึงห้ามเขียนลงหน้าเว็บ ·
// ตัวเลขที่ขึ้นหน้าได้มีแค่ของบรีฟเอง: **0.3% · 0.8% · 3 ขั้นตอน · 24ชม.**
// และหน้านี้หยิบมาใช้แค่ **24ชม.** ค่าเดียว เพราะเป็นค่าเดียวที่เกี่ยวกับแกนของหน้า
//
// 🚨 **รูปในหน้านี้ใช้ได้แค่ gamedemo8 กับ gamedemo16 เท่านั้น** — เป็นอาร์ตสต็อก
// กลางของเทมเพลต (mtime 2026-08-04) **ไม่ใช่อาร์ตเวิร์กของดรอปนี้ และไม่ใช่ของ
// แบรนด์ไหน** จึงใช้เป็นภาพประกอบตกแต่งได้ แต่ **ห้ามใช้แทนอาร์ตเวิร์กแบรนด์**
// gamedemo8 (600x379) กับ gamedemo16 (650x411) ไม่มีโลโก้หรือชื่อผู้ให้บริการ
// เจ้าอื่นพิมพ์ทับอยู่ ส่วน gamedemo7/9/10/11/12/14/15/17/18 มีโลโก้หรือชื่อของ
// ผู้ให้บริการเจ้าอื่นพิมพ์ทับอยู่กลางรูป และ gamedemo13 เป็นภาพล่อแหลม —
// **ห้ามนำกลับมาใช้**
// ⚠️⚠️ **ทั้งสองใบพิมพ์คำว่า POPULAR GAME / New Game ไว้บนภาพจริง** ซึ่งเป็น
// ข้อเท็จจริงของรูป alt จึงบอกตามนั้น · รอบนี้แบรนด์เป็นเว็บเกมพนันจริง จึงอ้างถึง
// หมวดเกมในคอปปี้ได้ **แต่ยังห้ามระบุชื่อค่ายหรือจำนวนเกม** และรูปคู่นี้ยังเป็น
// **ภาพประกอบตกแต่ง** ไม่ใช่ภาพหน้าเกมจริงของเว็บ
// ⚠️ alt บรรยายสิ่งที่เห็นจริง (กระต่ายกับแมวใส่แว่นกันแดดและหูฟังขนาบหีบสมบัติ /
// ตัวละครหัวฟักทองกับโครงกระดูกบนลานเรืองแสง) **ไม่ใช่ตัวนับแบบ "ภาพที่ 1"**
// และไม่เอ่ยชื่อแบรนด์ เพราะไม่มีชื่อแบรนด์ใดพิมพ์อยู่บนรูป
// ⚠️ ทั้งสองใบวาดกว้างสุด 600px (กริดสองคอลัมน์ตั้งแต่ sm ขึ้นไป) widths/sizes
// จึงตั้งตามนั้น ไม่ใช่ตามขนาดไฟล์ต้นฉบับ
// 🚨 **ห้าม import อาร์ตเวิร์กของแบรนด์อื่นจากหน้านี้เด็ดขาด**: แบนเนอร์ใบที่สอง
// และสาม (2026-10-23) กับสไลด์ใบที่สามและสี่ (2026-09-29) เป็นของแบรนด์อื่น
// (ชื่อไฟล์เต็มอยู่ใน brand-spec §6) · สไลด์สองใบของดรอปนี้ถูกตรึงไว้กับ
// index §4-§5 กับ /promotion · banner1 / banner1-mobile / og.png เป็นของ glob ที่
// MainLayout ปักไว้ **ห้ามอ้างจากหน้านี้**
// · ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ ทุก build และ verify-build จะแดง
// · ไฟล์เก่าทั้งหมดยังอยู่บนดิสก์ **ห้ามลบ** เป็นอินเวนทอรีของแบรนด์ถัดไป
//
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) **เนื้อหาเป็นธีมสว่าง โครมเป็นผิวเข้ม**
// bg.json ของดรอปนี้คือ {"mode":"color","color":"#f0ffeb"} = **ขาวอมมิ้นต์จาง**
// (รอบก่อนเป็นขาวอมชมพูจาง คนละค่า) **ห้ามเดาว่าเท่าเดิม และห้าม "แก้" การ์ด/ปุ่ม
// ให้เป็นพื้นมืดตามโครม** — พื้นมืดบนหมึก #10280f = ตัวอักษรหายไปเลย
// ค่าที่ใช้ได้ในไฟล์นี้: หัวข้อ/`<strong>`/marker ของลำดับเลข **#116018**
// (7.8:1 บนการ์ดขาว) · เข้มสุด #10280f (15.8:1) · หมึกรอง #3c5b36 (7.7:1) ·
// เขียวลึก #0b4a12 (10.5:1) · เขียวแบรนด์ #1a7d24 (5.3:1) · ทองเข้ม #8a6a0e
// (5.1:1) · พื้นไล่เฉดปุ่มหลัก #0b4a12 -> #116018 -> #1a7d24 (**พื้นถม** +
// หมึกขาว #ffffff) · ปุ่มรองเป็นผิวสว่าง #ffffff -> #e6f7df คู่กับหมึก #10280f ·
// ผิวยก #e6f7df · wash #d7f0cd · เส้นอ่อน #b2dba3 · เส้นเข้ม #3f7a2e
// (**ทั้งคู่ห้ามถือตัวอักษร** ใช้เป็นขอบการ์ดรูปได้)
// หมึกเนื้อความคือ #10280f (= BRAND_TEXT) ซึ่ง **ไม่ประกาศในไฟล์นี้** การ์ด
// ContentBox ตั้งไว้ให้แล้วและย่อหน้าสืบทอดลงมา
// 🚨🚨 **#28c437 บนพื้นขาวได้แค่ 2.3:1 และ #e3bb45 ได้ 2.0:1 — ห้ามเป็นสี
// ตัวอักษร** และ **ขาวบนสองค่านั้นก็ตก AA** พื้นที่รับหมึกขาวได้ต้องเป็น
// **#1a7d24 (5.3:1) ขึ้นไปหาเข้ม** เท่านั้น · #f0ffeb #e6f7df #d7f0cd #b2dba3
// #c6cfd2 ก็ห้ามถือตัวอักษร และ #3f7a2e เป็นเส้น/ขอบเท่านั้น
// 🚨🚨 **#0b2a12 #15401d #051409 #2d6b2f #e8fbe4 #b4d6ad เป็นค่าของผิวโครมเข้ม
// เท่านั้น ห้ามหลุดเข้ามาในไฟล์นี้**
// ออราที่อนุญาต: rgba(17,96,24,α) · rgba(11,74,18,α) · rgba(26,125,36,α) ·
// rgba(40,196,55,α) · rgba(16,40,15,α) · rgba(178,219,163,α)
// ⚠️⚠️ **รอบนี้ไม่มีม่วง ไม่มีฟ้า/ไซแอน ไม่มีแมเจนต้า ไม่มีส้มเพลิง และไม่มีแดง
// เป็นสี UI เลยสักเฉด** — เหรียญทองในรูป gamedemo8 กับอัญมณีในรูป gamedemo16
// เป็น **วัตถุในภาพ ไม่ใช่สี UI** เช่นเดียวกับสูทขาว ชิปคาสิโนเขียวเข้ม
// มงกุฎทองดวงเล็ก ต้นไม้ในกระถาง และผิวโครเมียมเงินของเวิร์ดมาร์ก
// ⚠️⚠️ **เขียวเคยเป็นฮิวนำของแบรนด์เก่ามาแล้วหลายเจ้า และเป็นฮิวที่ตาแยกค่าได้
// ยากที่สุด การเจอเขียวในไฟล์จึงไม่พิสูจน์อะไร** — ห้ามเทียบด้วยวงศ์สี ต้องเทียบ
// ทีละค่ากับตาราง brand-spec §2 (ค่าที่ใกล้จนต้องสงสัยว่าพิมพ์ผิดก่อนเสมอถูก
// ลิสต์ไว้ในไฟล์นั้นแล้ว และเขียนแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep สะดุด)
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง และไม่ใส่ mx-auto / max-w-* บน <p>
// เพราะการ์ดคุมความกว้างเองแล้ว — ที่ประกาศสีได้มีแค่ปุ่ม ชิปไอคอน marker ของ
// ลำดับเลข ขอบการ์ดรูป และ <strong> · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วย
// ช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ
// บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง และห้ามวาง <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังในข้อความของ prop และต้องเป็นไอคอนหมวดเกมพนัน ไม่ใช่ของหมวดแบรนด์ขาออก
// slot ของ ContentBox รับ **หนึ่ง element** เท่านั้น จึงห่อด้วย <div> ชั้นเดียว
//
// Announcement รอบนี้หมุนมาเป็นตัวท้ายชื่อ Premium ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ตัวท้ายชื่อ Huay จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้น
// เป็นคอปปี้ของแบรนด์นี้แล้ว จึงเรียกแบบ bare **ห้ามส่ง prop message** มิฉะนั้น
// ข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -c บนเชลล์นี้
// ก็นับเป็นไบต์ ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับตัวนับ
// ของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 151 อักขระ (ชื่อแบรนด์รอบนี้ 6 อักขระ) เป็นประโยคเดียวที่บอกว่า
// หน้านี้มีไว้ทำอะไร แล้วหยุด
// (Google ตัดราว 160 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนๆ ยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} รวมสิ่งที่ควรศึกษาก่อนเดิมพันด้วยเงินจริง ทั้งกติกาของแต่ละเกม ข้อมูลค่ายผู้พัฒนา ขอบเขตของข้อความไม่มีขั้นต่ำ และเงื่อนไขการใช้บริการ`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ศึกษากติกาและรูปแบบการเดิมพันก่อนใช้เงินจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});

// คลาสปุ่มสามขั้วของหน้านี้ ประกาศครั้งเดียวแล้วใช้ซ้ำ เพื่อไม่ให้สองปุ่มที่ทำ
// หน้าที่เดียวกันหลุดไปคนละเฉดตอนรีแบรนด์รอบหน้า
const ctaPrimary =
  "flex items-center justify-center rounded-full border border-[#0b4a12] bg-gradient-to-b from-[#0b4a12] via-[#116018] to-[#1a7d24] px-8 py-3 font-black text-white shadow-[0_6px_18px_rgba(11,74,18,0.3)] transition-transform hover:scale-105";

const ctaSecondary =
  "flex items-center justify-center rounded-full border border-[#3f7a2e] bg-gradient-to-b from-[#ffffff] to-[#e6f7df] px-8 py-3 font-bold text-[#10280f] shadow-[0_6px_18px_rgba(178,219,163,0.45)] transition-transform hover:scale-105";

const ctaQuiet =
  "flex items-center justify-center rounded-full border-2 border-[#116018] bg-[#ffffff] px-8 py-3 font-bold text-[#116018] shadow-[0_4px_14px_rgba(11,74,18,0.2)] transition-all hover:scale-105 hover:bg-[#e6f7df] hover:shadow-[0_6px_18px_rgba(17,96,24,0.2)]";

const listChip = "mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#b2dba3] bg-[#e6f7df] text-sm";

const gameCard = "mx-auto block h-auto w-full max-w-[600px] rounded-2xl border border-[#3f7a2e]";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#116018]">{BRAND_NAME} นำเสนอข้อมูลเกมเดิมพันออนไลน์หลากหลายประเภท พร้อมรายละเอียดระบบสมาชิก โปรโมชั่น และช่องทางติดต่อเจ้าหน้าที่</strong>
        หน้านี้รวบรวมไว้ว่าควรศึกษาอะไรเกี่ยวกับข้อมูลที่ระบุไว้ และควรตรวจอะไรซ้ำทุกครั้งที่กลับเข้ามาใหม่ ก่อนเดิมพันด้วยเงินจริง
      </p>

      <p>
        ภายในเว็บไซต์มีข้อมูลเกมจากค่ายต่าง ๆ ให้ผู้ใช้งานศึกษากติกา รูปแบบการเดิมพัน และเงื่อนไขการใช้บริการได้จากที่เดียว ส่วน
        <strong class="text-[#116018]">ข้อกำหนดเกี่ยวกับยอดฝากและยอดเดิมพันของแต่ละเกม รวมถึงความน่าเชื่อถือของผู้ให้บริการ ควรตรวจสอบก่อนใช้งานทุกครั้ง</strong>
        ไม่ใช่สิ่งที่สรุปจากข้อความโฆษณาเพียงอย่างเดียว
      </p>

      <p>
        <strong class="text-[#116018]">ข้อมูลที่เว็บไซต์ระบุไว้ไม่ได้กล่าวถึงการเปิดให้เล่นโดยไม่ใช้เงินจริงไว้แต่อย่างใด</strong>
        หน้านี้จึงไม่ยืนยันว่ามีรูปแบบนั้นให้ใช้งาน และควรตรวจสอบจากประกาศล่าสุดของเว็บไซต์ทางการเองว่าเกมใดเปิดให้ศึกษาได้ในลักษณะใด เนื้อหาด้านล่างเขียนไว้ประกอบการใช้งานเท่านั้น ไม่ได้ใช้แทนเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้บริการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ประเภทเกมเดิมพันที่เว็บไซต์ระบุไว้ ต่างกันที่กติกาและรูปแบบการเดิมพัน" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        เว็บไซต์ระบุว่ามีเกมเดิมพันออนไลน์หลายประเภท และ
        <strong class="text-[#116018]">แต่ละประเภทมีกติกาและรูปแบบการเดิมพันที่ไม่เหมือนกัน</strong>
        รายการด้านล่างสรุปไว้ว่าควรมองหาอะไรก่อนเริ่มเกมใด โดยไม่ได้ระบุจำนวนเกมหรือชื่อค่ายเพิ่มเติม เพราะข้อมูลนั้นต้องดูจากหน้ารายการจริงของเว็บไซต์เท่านั้น
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={popularGamesImage}
          alt="การ์ดภาพประกอบตกแต่ง เป็นภาพกระต่ายการ์ตูนกับแมวการ์ตูนสวมแว่นกันแดดและหูฟัง ยืนขนาบข้างหีบสมบัติที่มีเหรียญทองล้นออกมา มีเหรียญกลมลายโพดำลอยอยู่รอบ ฉากหลังเป็นวงแหวนเรืองแสง และมีข้อความ POPULAR GAME ตัวหนาสีทองอยู่กลางภาพ"
          loading="lazy"
          fetchpriority="low"
          decoding="async"
          widths={[300, 600]}
          sizes="(max-width: 639px) 100vw, 600px"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={62}
          class={gameCard}
        />

        <Picture
          src={newGamesImage}
          alt="การ์ดภาพประกอบตกแต่ง เป็นภาพตัวละครหัวฟักทองสวมหมวกปีกกว้างกับโครงกระดูกการ์ตูนยืนขนาบข้างบนลานกระเบื้องเรืองแสง มีอัญมณีสีสด ดาวสีเหลือง และลูกบาศก์สีชมพูกระจายอยู่ และมีข้อความ New Game ตัวหนาสีขาวอยู่กลางภาพ"
          loading="lazy"
          fetchpriority="low"
          decoding="async"
          widths={[300, 600]}
          sizes="(max-width: 639px) 100vw, 600px"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={62}
          class={gameCard}
        />
      </div>

      <ul class="flex flex-col gap-4" aria-label="สิ่งที่ควรอ่านก่อนเริ่มเกมแต่ละประเภท">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎲</span>
          <span>
            <strong class="text-[#116018]">กติกาและรูปแบบการเดิมพันของเกมนั้น</strong> คือจุดแรกที่ควรอ่าน เพราะเป็นข้อมูลที่ผูกกับเกมนั้นโดยเฉพาะ ไม่ใช่ค่ากลางที่ใช้ได้กับทุกประเภทในเว็บไซต์
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🏷️</span>
          <span>
            <strong class="text-[#116018]">ข้อมูลค่ายผู้พัฒนาและผู้ให้บริการ</strong> ควรตรวจสอบให้ชัดว่าเกมที่กำลังจะเล่นมาจากผู้พัฒนารายใด และเว็บไซต์ระบุข้อมูลบริษัทผู้ให้บริการไว้ครบถ้วนหรือไม่
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📜</span>
          <span>
            <strong class="text-[#116018]">เงื่อนไขการใช้บริการของเว็บไซต์</strong> คือเอกสารที่ใช้ประกอบการพิจารณาร่วมกับกติกาของเกม จึงควรอ่านให้จบก่อน ไม่ใช่อ่านตอนเกิดข้อสงสัยแล้ว
          </span>
        </li>
      </ul>
    </div>
  </ContentBox>

  <ContentBox title="ค่ายผู้พัฒนาและระบบเซิร์ฟเวอร์ต่างประเทศ จุดที่ควรตรวจก่อนเริ่มใช้งาน" as="h2">
    <div class="flex flex-col gap-5">
      <p>
        เว็บไซต์ระบุการใช้งานระบบเซิร์ฟเวอร์ต่างประเทศและการเชื่อมต่อเกมผ่านแพลตฟอร์มออนไลน์ ผู้ใช้งานจึง
        <strong class="text-[#116018]">ควรตรวจสอบรายชื่อค่ายเกม ข้อมูลบริษัทผู้ให้บริการ และหลักฐานการได้รับอนุญาตอย่างชัดเจน</strong>
        ก่อนตัดสินใจเปิดบัญชีหรือเริ่มเดิมพัน
      </p>

      <p>
        เหตุผลตรงไปตรงมา คือ
        <strong class="text-[#116018]">คำกล่าวอ้างว่าเป็นเกมถูกลิขสิทธิ์หรือมีความปลอดภัยในไทยไม่สามารถยืนยันได้จากข้อความโฆษณาเพียงอย่างเดียว</strong>
        นอกจากนี้ควรตรวจสอบนโยบายคุ้มครองข้อมูลส่วนบุคคลและข้อกำหนดทางกฎหมายที่เกี่ยวข้องก่อนใช้งาน และถือเอาสิ่งที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้บริการเป็นข้อมูลที่ใช้จริง ไม่ใช่สิ่งที่จำไว้จากครั้งก่อน
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/about-us" aria-label={`อ่านข้อมูลเกี่ยวกับ ${BRAND_NAME}`} class={ctaQuiet}>อ่านข้อมูลเกี่ยวกับเรา</a>

        <a href="/terms" aria-label={`อ่านเงื่อนไขและข้อตกลงของ ${BRAND_NAME}`} class={ctaQuiet}>อ่านเงื่อนไขและข้อตกลง</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="ข้อความสมัครเล่นไม่มีขั้นต่ำ ครอบคลุมถึงอะไรและควรตรวจอะไรเพิ่ม" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#116018]">การอ่านเงื่อนไขจากหน้าของเกมนั้นเอง ตรงกว่าการจำข้อความรวมจากหน้าแรก</strong>
        เพราะแต่ละเกมอาจกำหนดยอดฝากและยอดเดิมพันไว้คนละชุด รายการด้านล่างคือลำดับที่เปิดอ่านได้เร็วที่สุดก่อนเริ่มใช้งานครั้งแรก
      </p>

      <ol class="ml-6 list-decimal space-y-3 marker:font-black marker:text-[#116018]">
        <li>
          <strong class="text-[#116018]">ขอบเขตของข้อความไม่มีขั้นต่ำ</strong> ควรตรวจสอบว่าครอบคลุมเฉพาะการสมัครสมาชิกหรือรวมถึงการฝากเงินและการเดิมพันด้วย เพราะแต่ละเกมอาจกำหนดยอดขั้นต่ำแตกต่างกัน
        </li>
        <li>
          <strong class="text-[#116018]">ข้อกำหนดด้านอายุและกฎหมายที่เกี่ยวข้อง</strong> ควรอ่านก่อนดำเนินการสมัคร พร้อมกับนโยบายความเป็นส่วนตัวของเว็บไซต์ ไม่ใช่อ่านย้อนหลังหลังเปิดบัญชีแล้ว
        </li>
        <li>
          <strong class="text-[#116018]">เงื่อนไขของโปรโมชั่นที่กำลังเปิดอยู่</strong> อาจกำหนดประเภทเกม ยอดที่นำมาคำนวณ และข้อจำกัดการถอนเงินแตกต่างกัน จึงควรตรวจสอบประกาศล่าสุดก่อนเข้าร่วม
        </li>
        <li>
          <strong class="text-[#116018]">ประกาศล่าสุดของเว็บไซต์ทางการ</strong> คือจุดที่เงื่อนไขจริงถูกอัปเดต ทั้งรายการเกมที่เปิดให้บริการและสิทธิ์ของสมาชิก การเปิดดูก่อนทุกครั้งจึงตรงกว่าการจำไว้จากครั้งก่อน
        </li>
      </ol>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/register" aria-label={`สมัครสมาชิก ${BRAND_NAME}`} class={ctaPrimary}>สมัครสมาชิก</a>

        <a href="/login" aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`} class={ctaSecondary}>เข้าสู่ระบบ</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="สิ่งที่ควรตรวจซ้ำทุกครั้งก่อนเดิมพันด้วยเงินจริง" as="h2">
    <div class="flex flex-col gap-5">
      <p>
        นอกจากกติกาของเกมและเงื่อนไขการใช้บริการแล้ว
        <strong class="text-[#116018]">ก่อนเดิมพันด้วยเงินจริงควรตรวจสอบประเภทเกม ยอดเดิมพันที่กรอกไว้ และเงื่อนไขโปรโมชั่นที่เลือกรับให้ถูกต้องครบถ้วน</strong>
        การอ่านกติกาดูก่อนช่วยให้เห็นว่าเกมคิดผลอย่างไร แต่ไม่ได้บอกว่ารอบถัดไปจะออกอย่างไร และหน้านี้ไม่ระบุตัวเลขของเกมใด เพราะค่าที่ใช้จริงต้องอ่านจากหน้าของเกมนั้นเอง
      </p>

      <p>
