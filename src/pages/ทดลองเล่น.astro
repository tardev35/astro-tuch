---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { pageGraph } from "../lib/schema";

// GPSS789 เป็นเว็บคาสิโนตรงที่รวมหลายหมวดเกม — บาคาร่า/คาสิโนสด แทงบอล สล็อตหลายค่าย
// และหวยออนไลน์ หน้านี้จึงหมายถึงการทำความรู้จักเกมแต่ละหมวดและระบบก่อนใช้เครดิตจริง
// อ่านกติกา ดูอัตราจ่าย และช่วงเดิมพันตามที่บรีฟระบุไว้
//
// แบรนด์เก่าเคยวางแกลเลอรี 12 การ์ด (gamedemo7..18.webp) ไว้ที่หน้านี้ ถูกถอดออกไปตั้งแต่
// เจ็ดรอบรีแบรนด์ก่อน และไม่มีการ import แล้ว — อย่านำกลับมา เหตุผลมีสองชั้น: ลำพังการ import
// ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดงถ้ามีรูปที่ไม่มีใคร render ทั้งชุด
// ยังเป็นภาพของ "askmeslot" ซึ่งเป็นโลโก้เว็บอื่น การนำกลับมาคือการโชว์แบรนด์คู่แข่ง
// บนหน้าเว็บของ GPSS789
//
// ทุกข้อความอ้างอิง src/assets/content.txt เท่านั้น ไม่มีการอ้างใบอนุญาต การจดทะเบียน
// ปีที่ก่อตั้ง รางวัล จำนวนสมาชิก หรือการันตีผลกำไร
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 152
const pageDescription = "หน้าทดลองเล่นของ GPSS789 แนะนำวิธีทำความรู้จักบาคาร่า แทงบอล สล็อต และหวยออนไลน์ ตรวจสอบกติกา อัตราจ่าย และช่วงเดิมพันของแต่ละเกม ก่อนเล่นด้วยเครดิตจริง";

const graph = pageGraph(Astro, {
  name: "ทดลองเล่น GPSS789 ทำความรู้จักเกมทุกหมวดก่อนเดิมพันด้วยเครดิตจริง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title="ทดลองเล่น GPSS789 ลองเกมคาสิโน บอล สล็อต หวย ก่อนเดิมพันด้วยเครดิตจริง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่น GPSS789 ทำความรู้จักเกมทุกหมวดก่อนเดิมพันด้วยเครดิตจริง" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e8dcc4]">
        <strong class="text-[#f5d98a]">GPSS789</strong> เป็นเว็บคาสิโนตรงที่รวมเกมเดิมพันออนไลน์หลายประเภทไว้ในบัญชีเดียว ทั้งบาคาร่าและคาสิโนสด แทงบอล สล็อตออนไลน์จากหลายค่าย และหวยออนไลน์
        รองรับการใช้งานผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ หน้านี้จึงเปิดไว้ให้ผู้เริ่มต้นได้
        <strong class="text-[#f5d98a]">ทำความรู้จักเกมแต่ละหมวด อ่านกติกา ตรวจสอบอัตราจ่าย และดูช่วงเดิมพันที่รองรับ</strong>
        ก่อนยืนยันการเล่นด้วยเครดิตของตัวเอง เพราะแต่ละหมวดและแต่ละค่ายกำหนดกลไกกับเงื่อนไขไว้ไม่เหมือนกัน
      </p>

      <p class="text-left text-base leading-relaxed text-[#e8dcc4]">
        ขอให้เข้าใจตรงกันว่าการทดลองเล่นเป็นการทำความคุ้นเคยกับเกมและระบบเท่านั้น
        <strong class="text-[#f5d98a]">ทุกเกมมีความเสี่ยงและผลลัพธ์ที่ไม่แน่นอน ไม่มีสูตรหรือรูปแบบการเดิมพันใดรับประกันผลได้เสียล่วงหน้า</strong>
        หากติดปัญหาระหว่างใช้งาน สามารถแจ้งแอดมิน GPSS789 ได้ตลอด 24 ชั่วโมง พร้อมเวลาและรายละเอียดของรายการ เพื่อให้เจ้าหน้าที่ตรวจสอบระบบหลังบ้านได้ตรงจุด
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="เกมของ GPSS789 ที่ควรลองทำความรู้จักก่อนเริ่มเดิมพัน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e8dcc4]">
        GPSS789 จัดหมวดหมู่เกมไว้ให้ค้นหาได้ง่ายจากบัญชีเดียว สิ่งที่ควรเปิดดูให้ครบก่อนเริ่มคือ
        <strong class="text-[#f5d98a]">กติกาของเกม อัตราจ่าย และช่วงเดิมพันที่รายการนั้นรองรับ</strong>
        เพราะข้อมูลชุดนี้บอกว่ารายการคิดผลอย่างไรและต้องวางเดิมพันแบบไหน แทนที่จะเลือกจากคำว่าแตกง่ายหรือได้เงินไวเพียงอย่างเดียว
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#e8dcc4]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f2c14e]">🃏</span>
          <span><strong class="text-[#f5d98a]">บาคาร่าและคาสิโนสด</strong> เป็นเกมโต๊ะที่เดินเกมเร็ว ควรดูกติกาของโต๊ะ ประเภทเดิมพันที่เปิดรับ และช่วงเดิมพันขั้นต่ำ–สูงสุดของโต๊ะนั้นก่อนลงมือ</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f2c14e]">⚽</span>
          <span><strong class="text-[#f5d98a]">แทงบอล</strong> มีตลาดเดิมพันหลายแบบในหนึ่งคู่ ควรอ่านให้ชัดว่ารายการที่เลือกตัดสินผลจากอะไร และอัตราจ่ายที่เห็นเป็นตัวเลขล่าสุดหรือยัง</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f2c14e]">🎰</span>
          <span><strong class="text-[#f5d98a]">สล็อตออนไลน์หลายค่าย</strong> ทั้งเกมรอบปกติและเกมที่มีฟีเจอร์พิเศษ ควรเปิดตารางรางวัลและเงื่อนไขการเข้าฟีเจอร์ก่อนหมุนจริง</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f2c14e]">🎟️</span>
          <span><strong class="text-[#f5d98a]">หวยออนไลน์ตามรอบที่กำหนด</strong> แต่ละรอบมีเวลาปิดรับ ประเภทโพย และอัตราจ่ายของตัวเอง ควรตรวจสอบรายละเอียดของรอบก่อนส่งโพย</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#c2cad3]">
        ส่วนเรื่อง<strong class="text-[#c2cad3]">ช่วงเดิมพันขั้นต่ำ</strong> ตัวเลขจริงขึ้นอยู่กับหมวดเกมและค่ายผู้ให้บริการแต่ละราย จึงควรตรวจสอบตัวเลขบนหน้าเกมก่อนยืนยันรายการทุกครั้ง
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ขั้นตอนเริ่มใช้งาน GPSS789 และลองเลือกเกมด้วยตัวเอง" as="h2">
    <div class="flex flex-col gap-4">
      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#e8dcc4]">
        <li class="flex gap-3"><span class="font-bold text-[#f2c14e]">1.</span> เปิดหน้าสมัคร GPSS789 และกรอกข้อมูลตามที่ระบบกำหนด ทำผ่านมือถือหรือคอมพิวเตอร์ได้โดยตรง</li>
        <li class="flex gap-3"><span class="font-bold text-[#f2c14e]">2.</span> Login เข้าบัญชี ฝากเครดิตผ่านระบบฝากถอนออโต้ และตรวจสอบโปรโมชั่นที่มีสิทธิ์รับ</li>
        <li class="flex gap-3"><span class="font-bold text-[#f2c14e]">3.</span> เลือกหมวดเกมที่สนใจ ทั้งบาคาร่า แทงบอล สล็อต หรือหวย แล้วเปิดดูกติกาของรายการนั้นก่อนเริ่ม</li>
        <li class="flex gap-3"><span class="font-bold text-[#f2c14e]">4.</span> ดูอัตราจ่ายและช่วงเดิมพันที่เกมรองรับ เพื่อให้เข้าใจว่าผลของรายการคิดมาจากอะไร</li>
        <li class="flex gap-3"><span class="font-bold text-[#f2c14e]">5.</span> กำหนดงบประมาณและขนาดเดิมพันที่รับได้ ก่อนเปลี่ยนมาเล่นด้วยเครดิตจริง</li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#e8dcc4]">
        ก่อนเริ่มเดิมพันจริงควรแบ่งงบออกเป็นหน่วยย่อยไว้ล่วงหน้า เช่น มีทุน 1,000 บาท ให้คิด 1 หน่วยเท่ากับ 10 บาท แล้ววางขนาดเดิมพันให้อยู่ในระดับที่รับความผันผวนได้ วิธีนี้
        <strong class="text-[#f5d98a]">ไม่ได้ทำให้เกมจ่ายรางวัลมากขึ้น แต่ช่วยให้รู้ล่วงหน้าว่าแต่ละรอบใช้เงินได้เท่าไร</strong>
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="สิ่งที่ควรตรวจสอบก่อนเปลี่ยนมาเดิมพันด้วยเครดิตจริง" as="h2">
    <div class="flex flex-col gap-4">
      <ul class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#e8dcc4]">
        <li class="flex gap-3">
          <span class="text-[#f2c14e]" aria-hidden="true">•</span> หน้านี้อธิบายการใช้งานและการลองเลือกเกมเท่านั้น การเล่นจริงต้องสมัครสมาชิกและฝากเครดิตผ่านช่องทางที่เปิดให้บริการก่อน
        </li>
        <li class="flex gap-3">
          <span class="text-[#f2c14e]" aria-hidden="true">•</span> เปิดอ่านกติกา อัตราจ่าย และช่วงเดิมพันของรายการให้ครบ เพราะเกมโต๊ะ กีฬา สล็อต และหวย ไม่ได้ใช้เงื่อนไขชุดเดียวกัน
        </li>
        <li class="flex gap-3">
          <span class="text-[#f2c14e]" aria-hidden="true">•</span> ตรวจสอบช่องทางฝากเงิน ยอดขั้นต่ำ และวงเงินต่อรายการล่าสุดบนหน้าฝากถอนก่อนยืนยันธุรกรรมทุกครั้ง
        </li>
        <li class="flex gap-3">
          <span class="text-[#f2c14e]" aria-hidden="true">•</span> ตั้งจุดหยุดเมื่อเสียและจุดที่จะพักเมื่อได้กำไรไว้ตั้งแต่ก่อนเริ่ม แล้วหยุดตามแผน ไม่เพิ่มเดิมพันเพื่อไล่เอาเงินคืน
        </li>
        <li class="flex gap-3">
          <span class="text-[#f2c14e]" aria-hidden="true">•</span> อ่านเงื่อนไขโปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ก่อนกดรับทุกครั้ง และไม่เปิดเผยรหัสผ่านหรือ OTP ให้ผู้อื่น
        </li>
        <li class="flex gap-3">
          <span class="text-[#f2c14e]" aria-hidden="true">•</span> เรื่องรอบรับโบนัสและยอดที่ใช้คำนวณ ให้ยึดเงื่อนไขล่าสุดที่แสดงในหน้าโปรโมชั่นเป็นหลัก เพราะแต่ละรายการกำหนดไว้ไม่เท่ากัน
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#e8dcc4]">
        หากพบปัญหาเรื่องการสมัคร Login ไม่ได้ ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง โปรโมชั่นไม่แสดง หรือเข้าเกมไม่ได้ แจ้งแอดมิน GPSS789 พร้อมเวลา จำนวนเงิน และรายละเอียดของรายการได้ตลอด 24
        ชั่วโมง และหากเป็นเรื่องธุรกรรมควรเก็บหลักฐานรายการไว้จนกว่าการตรวจสอบจะเสร็จสิ้น โดย
        <strong class="text-[#f5d98a]">การเดิมพันมีความเสี่ยง ควรกำหนดงบประมาณให้เหมาะสมทุกครั้ง</strong>
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก GPSS789"
          class="flex items-center justify-center rounded-lg border border-[#d9a441]/70 bg-gradient-to-r from-[#ffeec2] via-[#d9a441] to-[#7a5312] px-8 py-3 font-black text-[#0a0704] shadow-[0_0_15px_rgba(217,164,65,0.4)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ GPSS789"
          class="flex items-center justify-center rounded-lg border border-[#d9a441]/60 bg-transparent px-8 py-3 font-bold text-[#f5d98a] transition-all hover:scale-105 hover:border-[#f2c14e] hover:bg-[#221a0e]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>

  <Navfoot />
</MainLayout>
