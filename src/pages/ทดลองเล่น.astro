---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login, /register)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริง
// ของ BRAVO168 เท่านั้น
//
// BRAVO168 เป็น **เว็บแทงบอลออนไลน์ / สปอร์ตบุ๊ก** ที่รวมตลาดฟุตบอลจากหลายรายการ
// แข่งขันไว้ผ่านบัญชีเดียว ส่วนแบรนด์ก่อนหน้า (CK268) เป็นเว็บเกมสล็อต และก่อนหน้านั้น
// เป็นเว็บหวย ซึ่งบรีฟรอบนี้ไม่ได้พูดถึงเลยสักคำ จึงถอดออกทั้งชุด ห้าม
// find-and-replace ชื่อแบรนด์ทับประโยคเดิม มิฉะนั้นเว็บจะไปอ้างสินค้าที่ไม่มีอยู่จริง
// (คำห้ามจาก brand-spec §1: สล็อต วงล้อ ฟรีสปิน ตัวคูณ ค่ายเกม RTP เกมแตก หวย
// เลขเด็ด ตรวจหวย แนวทาง ยี่กี บาคาร่า)
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามี "โหมดทดลอง" หรือเครดิตทดลองเป็นบริการของเว็บ — จึงห้าม
// สัญญาสินค้าตัวนั้น หน้านี้จึงพูดถึงเฉพาะสิ่งที่ผู้เข้าชม "ดูได้จริง" ก่อนลงบิลแรก
// ตามที่บรีฟระบุไว้: ตรวจสอบคู่บอล ราคา อัตราต่อรอง เวลาปิดรับ และรายละเอียดบิล
// ผ่านมือถือได้ก่อนยืนยันการเดิมพัน
//
// ข้อเท็จจริงทุกบรรทัดมาจาก content.txt เท่านั้น: รวมตลาดฟุตบอลหลายรายการผ่านบัญชีเดียว ·
// บอลเดี่ยว บอลสเต็ป บอลสด · บอลสเต็ปรวมหลายคู่ในบิลเดียว · บอลสดเปิดตัวเลือก
// ระหว่างการแข่งขันตามตลาดที่ระบบรองรับ · รายการลีกและแมตช์ที่เปิดรับจริงขึ้นอยู่กับ
// ตารางแข่งขันและผู้ให้บริการ · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · สมัคร 3 ขั้นตอน ·
// แอดมิน 24 ชั่วโมง
// — ตัวเลขที่อ้างได้มีแค่ 0.3% 0.8% 3 ขั้นตอน 24 ชั่วโมง และ 168 ในชื่อแบรนด์
// ห้ามเพิ่มชื่อผู้ให้บริการ ชื่อธนาคาร ขั้นต่ำฝากถอน เลขใบอนุญาต ปีที่ก่อตั้ง
// หรือจำนวนสมาชิกที่บรีฟไม่ได้ระบุ
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: banner1/banner1-mobile/og.png เป็นของ glob ที่
// MainLayout ปักไว้ ห้ามอ้างจากหน้า · slide1/slide2 ของดรอปนี้เป็นของ index และ
// /promotion · slide3/slide4/banner2/banner3 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น AnnouncementPremium ทั้งเว็บ — orchestrator ตั้ง default
// message ของไฟล์นั้นเป็นคอปปี้ของ BRAVO168 แล้ว จึงเรียกแบบ bare ห้ามส่ง prop
// message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ BRAVO168 เป็น **น้ำเงินรอยัล + ทอง บนกรมท่าสนามกลางคืน** ตามโลโก้ (ตัวอักษร
// BRAVO โครเมียมน้ำเงิน คู่เลข 168 ทองตัน) และแบนเนอร์สนามกลางคืนที่มีริ้วแสงทอง
// เหรียญทอง และลูกฟุตบอลทอง-กรมท่า: พื้นเข้มสุด #02081a · การ์ด #04142f ·
// ผิวยก #072247 · เส้น/ขอบ #0e3f8f · น้ำเงินรอยัล #1558c4 · น้ำเงินสว่าง #2f86f0 ·
// ทองหลัก #f4cb69 · ทองอ่อน #ffe39a · ทองเข้ม #c9922e · เนื้อความ #dbe5f5
// (BRAND_TEXT) · หมึกบนพื้นทอง #0a1020
// เรืองแสง: ทอง rgba(244,203,105,0.30) · น้ำเงิน rgba(21,88,196,0.35)
// ชุดเขียวนีออนของ CK268 (#8bfc13 #c9ff8f #1a7a08 #12a008 #e8f0e6 #d5e6cd #eaffd6
// #030703 #071007 #0f1b0e rgba(139,252,19,*) rgba(30,193,13,*)) ออกครบทุกจุดแล้ว
// ทั้งคลาส Tailwind raw hex และ rgba() ที่ใช้ทำแสงเรือง
// กฎคอนทราสต์: พื้นทอง → หมึกเข้ม #0a1020 · ตัวอักษรบนการ์ดกรมท่าใช้ #dbe5f5 #ffe39a
// #f4cb69 #2f86f0 เท่านั้น ส่วน #1558c4 / #0e3f8f / #c9922e ใช้เป็นพื้นและขอบ
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลางที่ orchestrator รีธีมรอบนี้) — การ์ดตั้ง
// สีเนื้อความไว้ให้แล้ว ย้ำไว้บนย่อหน้าอีกชั้นเพื่อให้สีของ body copy อ่านออกจาก
// ตัวหน้าเอง
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 153
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "ทดลองเล่น BRAVO168 ด้วยการไล่ดูระบบจริงให้ครบก่อนแทงบอล ตั้งแต่เลือกลีกและคู่แข่งขัน อ่านราคา อัตราต่อรอง เวลาปิดรับ ไปจนถึงตรวจรายละเอียดบิลก่อนกดยืนยัน";

const pageTitle = "ทดลองเล่น BRAVO168 ไล่ดูราคาและคู่แข่งขันก่อนแทงบอลจริง";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dbe5f5]">
        <strong class="text-[#ffe39a]">BRAVO168</strong> รวมตลาดฟุตบอลจาก
        <strong class="text-[#ffe39a]">หลายรายการแข่งขันไว้ให้เลือกผ่านบัญชีเดียว</strong> ทั้งบอลเดี่ยว บอลสเต็ป และบอลสด หน้านี้เปิดไว้ให้คนที่ยังไม่คุ้นกับระบบได้ลองเปิดใช้งานจริงหนึ่งรอบ
        ตั้งแต่หน้ารายการคู่แข่งขัน ไปจนถึงหน้าสรุปบิลที่แสดงราคาและอัตราต่อรอง ก่อนจะยืนยันการเดิมพันรายการแรก
      </p>

      <p class="text-left text-base leading-relaxed text-[#dbe5f5]">
        คำว่า “ทดลองเล่น” ที่หน้านี้พูดถึงจึงหมายถึง<strong class="text-[#ffe39a]">
          การเดินให้ครบทุกขั้นของการใช้งาน ตั้งแต่ Login เลือกลีกและคู่แข่งขัน อ่านราคา ดูเวลาปิดรับ ไปจนถึงตรวจรายละเอียดบิลและประวัติรายการ
        </strong>
        เว็บไซต์ระบุไว้ว่าสมาชิกสามารถตรวจสอบคู่บอล ราคา อัตราต่อรอง และรายละเอียดบิลผ่านมือถือได้ก่อนยืนยันการเดิมพัน ซึ่งเป็นสิ่งที่ผู้เข้าชมไล่ดูได้ทั้งหมดก่อนลงบิลจริงรอบแรก
      </p>
    </div>
  </ContentBox>

  <ContentBox title="เปิด BRAVO168 ดูคู่แข่งขันและราคาได้จากมือถือ" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dbe5f5]">
        จุดที่ช่วยให้เริ่มต้นได้เร็วที่สุดคือ<strong class="text-[#ffe39a]">ตลาดฟุตบอลจากหลายรายการแข่งขันถูกรวมไว้ในบัญชีเดียว และสลับลีกได้จากระบบเดิม</strong>
        สมาชิกจึงไม่ต้องเปิดบัญชีแยกกันไปตามแต่ละรายการ และไล่ดูคู่แข่งขันที่สนใจได้จากระบบเดียว
      </p>

      <ol class="ml-6 list-decimal space-y-3 text-left text-base leading-relaxed text-[#dbe5f5] marker:font-black marker:text-[#f4cb69]">
        <li>
          <strong class="text-[#ffe39a]">เปิดเว็บไซต์ BRAVO168 จากช่องทางหลักก่อน</strong> การเข้าผ่านช่องทางที่เว็บไซต์ประกาศไว้จริงช่วยหลีกเลี่ยงเว็บไซต์ที่ไม่เกี่ยวข้อง แล้วบันทึกทางเข้านั้นไว้ใช้รอบถัดไป
        </li>
        <li>
          <strong class="text-[#ffe39a]">สมัครและยืนยันข้อมูลตามที่ระบบกำหนด แล้ว Login</strong> ทั้งหมดทำผ่านระบบออนไลน์บนมือถือได้ หลังเข้าสู่ระบบจะเห็นโปรโมชั่นและประวัติบิลของบัญชีตัวเอง
        </li>
        <li>
          <strong class="text-[#ffe39a]">ไล่ดูลีกและคู่แข่งขันที่ระบบเปิดรับในขณะนั้น</strong> ทั้งบอลเดี่ยว บอลสเต็ป และบอลสด รายการลีกและแมตช์ที่เปิดรับจริงขึ้นอยู่กับตารางแข่งขันและผู้ให้บริการ
          จึงควรดูจากรายการที่ระบบแสดงไว้เป็นหลัก
        </li>
        <li>
          <strong class="text-[#ffe39a]">เปิดดูราคา อัตราต่อรอง และเวลาปิดรับของคู่นั้นให้ครบ</strong> เพราะแต่ละตลาดมีกติกาและเวลาปิดรับของตัวเอง โดยเฉพาะบอลสดที่ราคาและตลาดสามารถเปลี่ยนได้ระหว่างการแข่งขัน
        </li>
        <li>
          <strong class="text-[#ffe39a]">ลองใส่ยอดเดิมพันแล้วอ่านหน้าสรุปบิลก่อนกดยืนยัน</strong> ขั้นนี้คือขั้นที่ควรทำช้าที่สุด เพราะเป็นหน้าจอสุดท้ายที่ยังแก้รายการได้ก่อนบิลจะถูกบันทึก
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#dbe5f5]">
        <strong class="text-[#ffe39a]">รายการลีกที่เปิดรับและเงื่อนไขของโปรโมชั่นเปลี่ยนแปลงได้ตามช่วงเวลา จึงควรตรวจสอบข้อมูลจากช่องทางอย่างเป็นทางการของเว็บไซต์ทุกครั้งก่อนยืนยันบิล</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title="รูปแบบเดิมพันที่ลองไล่ดูได้ใน BRAVO168" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dbe5f5]">
        ระหว่างไล่ดูระบบ สิ่งที่ควรจำให้ได้คือ<strong class="text-[#ffe39a]">การเดิมพันแต่ละรูปแบบมีจังหวะและเวลาปิดรับของตัวเอง</strong>
        ไม่ได้ใช้เงื่อนไขชุดเดียวกันทั้งหมด การรู้ว่าแบบไหนทำงานอย่างไรช่วยให้เลือกรูปแบบที่เหมาะกับสไตล์ของตัวเองได้เร็วขึ้น
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#dbe5f5]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f4cb69]">⚽</span>
          <span>
            <strong class="text-[#ffe39a]">บอลเดี่ยว</strong> เป็นแบบที่อ่านง่ายที่สุดสำหรับคนเริ่มต้น เพราะทั้งบิลผูกอยู่กับคู่แข่งขันเดียว ลองดูว่าหน้าสรุปบิลแสดงราคาและอัตราต่อรองไว้อย่างไรก่อนยืนยันรอบแรก
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#2f86f0]">🧾</span>
          <span>
            <strong class="text-[#ffe39a]">บอลสเต็ป</strong> รวมหลายคู่ไว้ในบิลเดียว จึงควรไล่ดูราคาและเวลาปิดรับของทุกคู่ในบิลก่อนกดยืนยัน เพราะแต่ละคู่เริ่มแข่งไม่พร้อมกัน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f4cb69]">⏱️</span>
          <span>
            <strong class="text-[#ffe39a]">บอลสด</strong> เปิดตัวเลือกการเดิมพันระหว่างการแข่งขันตามตลาดที่ระบบรองรับ ลองเปิดดูสักคู่ระหว่างเกมเพื่อให้เห็นว่าราคาขยับเร็วแค่ไหนก่อนจะลงเดิมพันจริง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#2f86f0]">🗓️</span>
          <span>
            <strong class="text-[#ffe39a]">รายการตามฤดูกาล</strong> ทยอยเปิดตลาดตามช่วงเวลาที่กำหนด จำนวนลีกและแมตช์ที่เลือกได้ในแต่ละวันจึงขึ้นอยู่กับตารางแข่งขันและผู้ให้บริการในรอบนั้น
          </span>
        </li>
      </ul>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/promotion"
          aria-label="ดูภาพโปรโมชั่นทั้งหมดของ BRAVO168"
          class="flex items-center justify-center rounded-lg border border-[#0e3f8f] bg-[#072247] px-8 py-3 font-bold text-[#dbe5f5] shadow-[0_0_15px_rgba(21,88,196,0.35)] transition-all hover:scale-105 hover:border-[#f4cb69] hover:bg-[#04142f] hover:text-[#f4cb69]">
          ดูโปรโมชั่นทั้งหมด
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="จุดที่ควรตรวจให้ครบก่อนยืนยันบิล" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dbe5f5]">
        การไล่ดูระบบมีประโยชน์ที่สุดเมื่อมองมันเหมือนการอ่านคู่มือ ไม่ใช่การลุ้นผลการแข่งขัน
        <strong class="text-[#ffe39a]">เป้าหมายคือรู้จักหน้าจอทุกหน้าให้ครบก่อนที่เงินจริงจะเข้ามาเกี่ยวข้อง</strong>
        เรื่องด้านล่างคือสิ่งที่ควรเก็บข้อมูลไว้ระหว่างเปิดดู และควรตรวจซ้ำทุกครั้งที่เดิมพันจริง
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#dbe5f5]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f4cb69]">💹</span>
          <span>
