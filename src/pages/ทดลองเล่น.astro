---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";

import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login, /register)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อของ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริง
// ของ PGW44 เท่านั้น
//
// รอบก่อน (PKG44) ขาย "เกมปั่นสล็อตหลายค่าย" + "รูปแบบการเชื่อมต่อ API" +
// "ข้อมูลลิขสิทธิ์จากเจ้าของเกม" ซึ่งบรีฟของ PGW44 ไม่ได้ระบุเลยสักคำ — ทั้งหมด
// ถูกถอดออกทั้งหน้า และเขียนใหม่บนข้อเท็จจริงของ PGW44 คือการรวบรวมค่ายสล็อตย่อย
// และเกมหลายแนวไว้ในระบบเดียว เมนูจัดหมวดหมู่ชัดเจน และการตรวจรายละเอียดของเกม
// จากหน้าเกมโดยตรง ห้าม find-and-replace ชื่อแบรนด์ทับของเดิม มันจะทำให้ PGW44
// อ้างเรื่อง API และลิขสิทธิ์ ซึ่งเป็นคำของแบรนด์ก่อนหน้า
//
// บรีฟไม่ได้ระบุว่ามีโหมดเดโมหรือเครดิตทดลองที่ถอนไม่ได้ สิ่งที่บรีฟระบุคือ
// "รวบรวมค่ายสล็อตย่อยและเกมหลายแนวไว้ให้เลือกจากระบบเดียว" "เมนูจัดหมวดหมู่ชัดเจน"
// "เกมคลาสสิก เกมโบนัส เกมธีมใหม่ และสล็อตที่อัปเดตตามช่วงเวลา" "แต่ละเกมมีระดับ
// เดิมพันและรูปแบบการเล่นแตกต่างกัน ตรวจสอบรายละเอียดก่อนเริ่มใช้งานได้จากหน้าเกม
// โดยตรง" "รองรับมือถือและคอมพิวเตอร์" — หน้านี้จึงเขียนบนฐานนั้น คือการไล่ดูเมนู
// ค่ายสล็อตย่อย และรายละเอียดของเกมให้ครบก่อนเดิมพันด้วยเงินจริง
// ห้ามอ้างกติกาของเครดิตทดลองหรือโหมดเล่นฟรี
//
// ข้อเท็จจริงทุกบรรทัดมาจากบรีฟรอบนี้เท่านั้น (brand-spec §4): ค่ายสล็อตย่อยและเกม
// หลายแนวในระบบเดียว · เกมคลาสสิก เกมโบนัส เกมธีมใหม่ และสล็อตที่อัปเดตตามช่วงเวลา ·
// เมนูจัดหมวดหมู่ชัดเจน · รองรับมือถือและคอมพิวเตอร์ · ค้นหาเกมได้โดยไม่ต้องเปลี่ยน
// หลายเว็บไซต์ · เข้าดูและเลือกเกมได้ตลอดทั้งวันตามรายการที่ระบบเปิดให้บริการ ·
// ระดับเดิมพันและรูปแบบการเล่นต่างกัน ตรวจสอบจากหน้าเกมโดยตรง · ข่าวสาร เกมใหม่
// และโปรโมชั่นที่อัปเดตตามช่วงเวลา · โบนัสแนะนำเพื่อน 0.8% · โบนัสคืนยอดเสีย 0.3% ·
// ยอดที่เข้าเกณฑ์ ขั้นตอนรับสิทธิ์ รอบคำนวณ เงื่อนไข · บัญชีสมาชิก · สมัครเองได้ใน
// 3 ขั้นตอน · ติดต่อเจ้าหน้าที่ผ่านช่องทางไลน์ได้ตลอด 24 ชั่วโมง
// — ห้ามอ้าง บาคาร่า คาสิโนสด เกมโต๊ะ รูเล็ต ไฮโล หวย บอล เครดิตฟรี ฝากถอนออโต้
// ชื่อค่าย/สตูดิโอเจาะจง ชื่อเกมเจาะจง ค่า RTP เลขใบอนุญาต ปีที่ก่อตั้ง จำนวนสมาชิก
// ชื่อธนาคาร การเชื่อมต่อ API/ลิขสิทธิ์ หรือการันตีว่าจะชนะ
//
// ศัพท์ช่องทางติดต่อ: บรีฟรอบนี้ระบุ "ติดต่อเจ้าหน้าที่ผ่านช่องทางไลน์ได้ตลอด
// 24 ชั่วโมง" ไว้ตรงๆ (H2 ที่ 7) ต่างจากรอบก่อน — เนื้อความจึงเขียนคำว่าไลน์ได้
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: แกลเลอรีเดโม 12 การ์ด (gamedemo7..18.webp) ยังอยู่
// บนดิสก์แต่เป็นของแบรนด์อื่น — gamedemo7.webp มีโลโก้ "askmeslot" และ
// gamedemo15.webp มีโลโก้ "askmebet" ของเว็บเจ้าอื่นพิมพ์ทับอยู่ในรูป ส่วน
// gamedemo13.webp เป็นการ์ด "Sexy Slot" ภาพโป๊เปลือย ห้ามนำกลับมา import เด็ดขาด
// (ห้ามลบไฟล์ เป็นอินเวนทอรี) ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ
// verify-build จะแดง
// slide1.png / slide2.png ของดรอปนี้เป็นของ index และ /promotion — ไม่ดึงมาใช้ซ้ำที่นี่
// banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า
// banner3.png เป็นโลโก้ซ้ำ ส่วน banner2/slide3/slide4 เป็นของค้างจากแบรนด์ก่อน ห้าม import
//
// Announcement รอบนี้หมุนจาก AnnouncementPremium มาเป็น Announcement2 ทั้งเว็บ —
// default message ของไฟล์นั้นเป็นคอปปี้ของ PGW44 แล้ว จึงเรียกแบบ bare เหมือน
// index.astro ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ PGW44 เป็น **ทองนำ + เขียวตาม บนพื้นดำอมเขียว** ตามโลโก้ (P ดำขอบทอง /
// G ทอง / W เขียว / 44 ไล่ทองไปเขียว):
// พื้น #050803 · การ์ด #0b1408 · แผง/ปุ่มรอง #101a0b · ขอบ #1f5a16 ·
// ทองแบรนด์ #fde90e · ทองสว่าง #fff89a · ทองกลาง #f5c518 · ทองลึก #a86f02 ·
// เขียวแบรนด์ #35d413 · เขียวสว่าง #5df53a · เขียวลึก #0c6d10 ·
// ตัวอักษรบนพื้นทอง #10160a · เนื้อความ #e9f0dd (BRAND_TEXT) · เน้นใน strong #fbffe8
// เลขลำดับใน <ol> และไอคอนใน <ul> สลับทอง/เขียวให้คู่สีของโลโก้อ่านออกจากหน้าเอง —
// ชุดทอง/เงินโครเมียมของ PKG44 (#fdd32a #ffe27a #ffeeb8 #c8920a #15110a #c2c8d0
// #f2f4f7 #8a9099 #efe6d2 #fff8e1 #080602 #12100a #2a2110 #4a3a12) ถูกแทนครบทุกจุดแล้ว
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลางที่ orchestrator รีธีมรอบนี้) — การ์ดตั้ง
// สีเนื้อความไว้ให้แล้ว ย้ำไว้บนย่อหน้าอีกชั้นเพื่อให้สีของ body copy อ่านออกจาก
// ตัวหน้าเอง และเน้นด้วย #fbffe8 ในคำสำคัญ
//
// ไม่มีลิงก์ /ตรวจหวย หรือ /แนวทาง: PGW44 เป็นเว็บสล็อต สองหน้านั้นอยู่ใน
// src/pages-disabled/ รอบนี้ href ที่ชี้ route ซึ่งไม่มีใน dist/ จะทำให้ build แดง
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 157
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "ทดลองเล่น PGW44 ไล่ดูค่ายสล็อตย่อยและเกมแต่ละแนวในระบบเดียวให้ครบ ทั้งเกมคลาสสิก เกมโบนัส เกมธีมใหม่ พร้อมตรวจระดับเดิมพันจากหน้าเกมก่อนเริ่มเล่นด้วยเงินจริง";

const pageTitle = "ทดลองเล่น PGW44 ไล่ดูค่ายสล็อตย่อยและรายละเอียดเกมก่อนเริ่มจริง";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e9f0dd]">
        <strong class="text-[#fbffe8]">PGW44</strong> รวบรวมค่ายสล็อตย่อยและเกมหลายแนวไว้ให้เลือกจากระบบเดียว หน้านี้จึงเปิดไว้ให้คนที่ยังไม่คุ้นกับระบบได้
        <strong class="text-[#fbffe8]">ไล่ดูเมนู ค่ายสล็อตย่อย และรายละเอียดของเกมให้ครบก่อนเดิมพันด้วยเงินจริง</strong>
        ตั้งแต่โครงของเมนูที่จัดหมวดหมู่ไว้ ไปจนถึงข้อมูลที่หน้าเกมแสดงไว้ก่อนกดเริ่ม
      </p>

      <p class="text-left text-base leading-relaxed text-[#e9f0dd]">
        เพราะ<strong class="text-[#fbffe8]">เมนูจัดหมวดหมู่ไว้ชัดเจนและรองรับการใช้งานทั้งบนมือถือและคอมพิวเตอร์</strong>
        การเปิดดูให้ทั่วก่อนจึงช่วยให้เห็นว่าเกมคลาสสิก เกมโบนัส เกมธีมใหม่ และสล็อตที่อัปเดตตามช่วงเวลาอยู่ตรงไหน สลับไปยังค่ายที่สนใจได้จากจุดใด และต้องตรวจข้อมูลอะไรบ้างก่อนเริ่มเล่นรอบแรก
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ไล่ดูค่ายสล็อตย่อยและหมวดเกมของ PGW44 ให้ครบก่อนเลือกเกมแรก" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e9f0dd]">
        จุดที่ช่วยให้เริ่มต้นได้เร็วที่สุดคือ<strong class="text-[#fbffe8]">ค่ายสล็อตย่อยและเกมหลายแนวถูกมัดรวมไว้ให้เลือกจากระบบเดียว และเมนูจัดหมวดหมู่ไว้ชัดเจน</strong>
        สมาชิกเลือกค่ายหรือหมวดที่สนใจได้ตั้งแต่หน้ารวมเกม แล้วเปิดดูรายละเอียดของเกมนั้นต่อได้ก่อนเริ่มเล่น ไม่ต้องเปลี่ยนไปเปิดหลายเว็บไซต์เพื่อไล่หาเกมที่อยากเล่น
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#e9f0dd]">
        <li class="flex gap-3">
          <span class="font-bold text-[#fde90e]">1.</span>
          <span><strong class="text-[#fbffe8]">เปิดหน้ารวมเกมของ PGW44 ก่อน</strong> เมนูจัดหมวดหมู่ไว้ชัดเจนตั้งแต่หน้าแรก จึงเห็นภาพรวมของค่ายสล็อตย่อยและหมวดที่เปิดให้เลือกได้ในหน้าเดียว</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#35d413]">2.</span>
          <span>
            <strong class="text-[#fbffe8]">ไล่ดูทีละหมวดให้ครบ</strong> ทั้งเกมคลาสสิก เกมโบนัส เกมธีมใหม่ และสล็อตที่อัปเดตตามช่วงเวลา แต่ละหมวดมีรายการและรูปแบบของตัวเองตามที่ระบบเปิดให้บริการ
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#fde90e]">3.</span>
          <span>
            <strong class="text-[#fbffe8]">ตรวจสอบรายละเอียดของเกมจากหน้าเกมโดยตรง</strong> แต่ละเกมมีระดับเดิมพันและรูปแบบการเล่นแตกต่างกัน อ่านให้จบก่อนตัดสินใจว่าจะเริ่มจากเกมไหนของค่ายไหน
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#35d413]">4.</span>
          <span>
            <strong class="text-[#fbffe8]">เปิดดูข่าวสาร เกมใหม่ และโปรโมชั่นที่อัปเดตไว้</strong> ทั้งโบนัสแนะนำเพื่อนและโบนัสคืนยอดเสียมีเงื่อนไขและรอบรับสิทธิ์ของตัวเอง ควรตรวจสอบรายละเอียดก่อนกดรับทุกครั้ง
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#fde90e]">5.</span>
          <span>
            <strong class="text-[#fbffe8]">ลองเปิดจากเครื่องที่จะใช้จริงอีกครั้ง</strong> ระบบรองรับทั้งมือถือและคอมพิวเตอร์ เปิดเกมเดียวกันเทียบกันดูก่อน แล้วเลือกอุปกรณ์ที่ใช้งานได้ถนัดกว่า
          </span>
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#e9f0dd]">
        <strong class="text-[#fbffe8]">รายการค่ายและเกมที่ระบบเปิดให้บริการ เกมใหม่ และโปรโมชั่นที่เปิดรับสิทธิ์เปลี่ยนแปลงได้ตามช่วงเวลา จึงควรตรวจสอบรายละเอียดของเกมจากหน้าเกมและข้อมูลจากช่องทางอย่างเป็นทางการของเว็บไซต์ทุกครั้งก่อนเริ่มเล่น</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title="จุดที่ควรตรวจให้ครบก่อนเดิมพันด้วยเงินจริง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e9f0dd]">
        การไล่ดูระบบมีประโยชน์ที่สุดเมื่อมองมันเหมือนการอ่านคู่มือ ไม่ใช่การลุ้นรางวัล
        <strong class="text-[#fbffe8]">เป้าหมายคือรู้จักระบบให้ครบก่อนที่เงินจริงจะเข้ามาเกี่ยวข้อง</strong>
        หกเรื่องด้านล่างคือสิ่งที่ควรเก็บข้อมูลไว้ระหว่างเปิดดู
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#e9f0dd]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fde90e]">🗂️</span>
          <span>
            <strong class="text-[#fbffe8]">โครงของเมนูและหมวดหมู่ที่จัดไว้</strong> จำให้ได้ว่าเกมคลาสสิก เกมโบนัส เกมธีมใหม่ และสล็อตที่อัปเดตตามช่วงเวลาอยู่ตรงไหน จะได้ไม่ต้องไล่หาใหม่ทุกครั้งที่อยากเปลี่ยนเกม
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#35d413]">🎰</span>
          <span>
