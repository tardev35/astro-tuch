---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import popularGamesImage from "../assets/gamedemo8.webp";
import newGamesImage from "../assets/gamedemo16.webp";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ (src/assets/content.txt) ไม่มีหมวด "ทดลองเล่น" และไม่มี
// ส่วน SUB-PAGES เลย ทั้งหน้าจึงเขียนขึ้นใหม่จากคลังคำของบรีฟรอบนี้ ไม่ใช่แก้ทับ
// ประโยคของแบรนด์ก่อน
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// ⚠️ ดรอปนี้ (2026-10-18) คือ **เว็บสล็อตล้วน** ไม่ใช่หมวดอื่นใดทั้งสิ้น
// สองหน้าของหมวดที่แบรนด์ก่อนๆ เคยเปิดจอดอยู่ใน src/pages-disabled/ ไม่มี route
// ห้ามลิงก์ไปหา เป็น href ตายที่ทำให้ build แดง route ที่มีจริงรอบนี้คือ
// / · /about-us · /contact-us · /login · /register · /privacy · /promotion ·
// /terms · /ทดลองเล่น · /ทางเข้า · /line
//
// ⚠️ แบรนด์ก่อนหน้าก็เป็นแบรนด์สล็อตเหมือนกัน คอปปี้เดิมจึง "ดูเข้าเค้า" ทั้งที่
// กรอบของบรีฟคนละอัน — **ห้าม find-and-replace ทับประโยคเดิม** วลีแกนของแบรนด์ก่อน
// ("ศูนย์บริการ/ศูนย์รวมช่องทาง") ถูกถอดออกหมดแล้วทั้งไฟล์ กรอบของบรีฟรอบนี้คือ
// **ฐานหลักเว็บสล็อตลิขสิทธิ์แท้ นำเข้าตรงจากสิงคโปร์** ที่รวม **3 ค่ายหลัก
// PG SOFT · JOKER · JILI** ไว้ในเว็บไซต์เดียว (คำต้องห้ามไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้
// sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง — เต็มอยู่ใน
// brand-spec §6)
//
// ⚠️ บรีฟรอบนี้ **ไม่ได้เอ่ยถึงโครงสร้างพื้นฐาน เอกสารรับรอง สถาบันการเงิน
// หรือตัวเลขเชิงสถิติใดๆ ของเว็บ** จึงห้ามพูดถึงทั้งหมด และค่ายเกมที่เอ่ยได้มีแค่
// สามค่ายข้างบนเท่านั้น สิ่งที่บรีฟให้มาคือ "ศึกษารายละเอียดของแต่ละค่ายก่อนเลือก
// เกมที่สนใจ" "ศึกษากติกา ตารางการจ่ายรางวัล และคุณสมบัติของเกมก่อนเข้าใช้งาน"
// "ตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง" "ติดต่อเจ้าหน้าที่เพื่อสอบถามบริการเพิ่มเติม"
// และ "ข้อมูลลิขสิทธิ์/แหล่งที่มาของระบบควรตรวจสอบจากหลักฐานของผู้ให้บริการโดยตรง"
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามีโหมดทดลอง เครดิตทดลอง หรือเดโมฟรีเป็นบริการของเว็บ —
// จึงห้ามสัญญาสินค้าตัวนั้น คำว่า "ทดลองเล่น" บนหน้านี้จึงหมายถึงสิ่งที่บรีฟระบุไว้
// ตรงๆ ว่าทำได้: ไล่ดูเกมสล็อตของ 3 ค่ายและขั้นตอนการใช้งานให้ครบหนึ่งรอบ
// ศึกษากติกากับเงื่อนไข และสอบถามเจ้าหน้าที่ ก่อนเข้าใช้งานจริง
//
// ⚠️ รูปในหน้านี้ใช้ได้แค่ gamedemo8 กับ gamedemo16 เท่านั้น — เป็นอาร์ตสต็อกกลาง
// ของเทมเพลต (mtime 2026-08-04) ไม่ใช่อาร์ตเวิร์กของแบรนด์นี้ จึงอยู่ต่อได้ แต่ alt
// ต้องบรรยายภาพจริง และห้ามเอ่ยชื่อแบรนด์ใด เพราะไม่มีชื่อแบรนด์ไหนปรากฏอยู่บนรูป
// ทั้งสองใบ (สีที่ alt บรรยายคือสีที่วาดอยู่บนอาร์ตสต็อกจริง ไม่ใช่สีของพาเลตต์
// รอบนี้ — ห้าม "แก้สี" ใน alt ให้เข้าแบรนด์ เพราะนั่นทำให้ alt บรรยายผิด เปิดอ่าน
// บิตแมปทั้งสองใบซ้ำแล้วรอบนี้ ข้อความ alt ยังตรงกับภาพจริงทุกองค์ประกอบ)
// ส่วน gamedemo7/9/10/11/12/14/15/17/18 มีโลโก้หรือชื่อของผู้ให้บริการ
// เจ้าอื่นพิมพ์ทับอยู่กลางรูป และ gamedemo13 เป็นภาพล่อแหลม — ห้ามนำกลับมาใช้
// เพราะเท่ากับอ้างชื่อที่บรีฟไม่ได้เอ่ย ไฟล์ยังอยู่บนดิสก์ ห้ามลบ เป็นอินเวนทอรี
// gamedemo8 ("POPULAR GAME" 600x379) กับ gamedemo16 ("New Game" 650x411)
// ความกว้างที่วาดจริงสูงสุด ~600px ต่อใบ (กริดสองคอลัมน์ในการ์ด) จึงไม่ขยายเกิน
// ต้นฉบับ quality={62} ของสองใบนี้ตั้งไว้ต่ำกว่าค่าปกติ 80 มาตั้งแต่รอบก่อน เพราะ
// อาร์ตมีเกรนละเอียดจนไฟล์ AVIF เคยโตกว่า WebP ของตัวเอง (verify-build จะแดง)
// ห้ามดันกลับขึ้น — เป็นค่าต่อรูป ไม่ใช่การจูนต่อฟอร์แมต
//
// ⚠️ ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 100% · 3 ขั้นตอน · 3 ค่าย ·
// 24 ชั่วโมง ส่วนตัวเลขและชื่อเฉพาะที่ห้ามแต่งขึ้นเองอยู่ครบใน brand-spec §6
//
// ประโยคกำกับของบรีฟที่ห้ามตัดทิ้ง (เป็นส่วนหนึ่งของคอปปี้ ไม่ใช่ filler):
// ข้อมูลเกี่ยวกับลิขสิทธิ์และแหล่งที่มาของระบบควรตรวจสอบจากหลักฐานของผู้ให้บริการ
// โดยตรง · ข้อมูลการเชื่อมต่อระบบจากสิงคโปร์และสถานะลิขสิทธิ์ควรตรวจสอบกับ
// ผู้ให้บริการโดยตรง · ก่อนเข้าร่วมควรตรวจสอบระยะเวลาของแคมเปญ เงื่อนไขยอดเดิมพัน
// และวิธีรับเครดิต · เครดิตคืนยอดเสียไม่ได้รับประกันผลตอบแทนจากการเล่นครั้งต่อไป ·
// ควรอ่านข้อกำหนดเกี่ยวกับอายุผู้ใช้งานและเงื่อนไขบริการก่อนสมัคร · ไม่ใช้ข้อมูล
// ของผู้อื่นหรือเปิดเผยรหัสยืนยันให้บุคคลภายนอก · ควรตรวจสอบลิงก์หรือ QR Code จาก
// เว็บไซต์ทางการก่อนเพิ่มเพื่อน เพื่อหลีกเลี่ยงบัญชีแอบอ้าง · ไม่เปิดเผยรหัสผ่าน
// หรือรหัส OTP ให้บุคคลอื่น · ควรตรวจสอบเวลาการให้บริการและระยะเวลาตอบกลับล่าสุด
//
// banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion · banner2/banner3 และ
// slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import (ลำพังการ import ก็ทำให้ไฟล์
// ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้หมุนมาเป็น Announcement3 ทั้งเว็บ (brand-spec §3)
// orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียก
// แบบ bare ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ทองนำ ชมพูบานเย็นเป็นฮิวที่สองจริง
// พลัมเข้มเป็นเงาที่ไม่เคยถือตัวอักษร บนดำสนิท**
// ⚠️ แบรนด์ก่อนๆ มีทองแทบทุกราย "มีทองอยู่" จึงไม่ใช่ตัวบอกว่าถูกแบรนด์ ให้เทียบ
// เป็น "ค่า" ทีละตัวกับตารางใน brand-spec §2 (ค่าเดิมไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้
// grep หาสีแบรนด์เก่าเจอ false positive) สิ่งที่ทำให้รอบนี้ต่างจริงคือ
// **ชมพูบานเย็น #f5469f**
// ลำดับความลึก: #24101c ผิวยก (= การ์ด) / #160a12 กลาง / #0b0509 จม / #000000 พื้นเพจ
// ลำดับปุ่มสื่อด้วยขั้ว "ทองถม vs ผิวจมขอบพลัม": ปุ่มหลักถมทองไล่เฉด #ffeaa0 →
// #fcd434 ขอบ #7a5508 หมึก #1a0612 (13.5:1 บนปลายทองแบรนด์) · ปุ่มรองและปุ่มลิงก์
// ภายในเป็นผิวจม #160a12 → #0b0509 ขอบ #8c0f52/60 ตัวอักษร #f6e4ee และ hover ยกขอบ
// เป็นชมพูบานเย็น #f5469f · ขอบรูปใช้ชมพูบานเย็น #f5469f โปร่ง (ฮิวที่สองต้องเห็นจริง
// บนหน้า) · marker ของลำดับเลขใช้ชมพูอ่อน #ff8dc6 (8.6:1 บนผิวการ์ด — เป็นตัวอักษร
// จึงใช้พลัมเข้มไม่ได้ และ #ffeaa0 สงวนไว้ให้ <strong> เท่านั้น)
// ⚠️ ห้ามกลับด้าน: พื้นถมทองต้องใช้หมึกเข้มเสมอ ห้ามขาวหรือทองอ่อน และ #8c0f52
// #7a5508 เป็นเส้น ขอบ ออรา และพื้นถมเท่านั้น ห้ามถือตัวอักษรทุกขนาด
// ออราในไฟล์นี้ใช้ rgba(140,15,82,α) · rgba(252,212,52,α) · rgba(245,70,159,α)
// เท่านั้น · รอบนี้ไม่มีม่วง ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว ไม่มีส้ม ไม่มีเงิน/
// โครเมียมอมฟ้า ไม่มีโรสโกลด์ และไม่มีแดงชาด (#00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์
// LINE ไม่ใช่สีของเว็บ จึงคงไว้ตาม §2)
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #f6e4ee)
// ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง ปล่อยให้สืบทอดลงมา
// และไม่ใส่ mx-auto / max-w-* บน <p> — มีแค่ปุ่ม ขอบรูป marker ของลำดับเลข และ
// <strong> ที่ประกาศสี โดย <strong> ใช้ทองสว่าง #ffeaa0 ตัวเดียว (15.2:1 บนผิว
// การ์ด) และแต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทย
// ไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 155 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} หน้ารวมวิธีไล่ดูเกมสล็อตจาก PG SOFT JOKER JILI ศึกษากติกา ตารางการจ่ายรางวัล และเงื่อนไขโปรโมชั่นให้ครบก่อนสมัครสมาชิกและเข้าสู่ระบบจริง`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ไล่ดูเกมสล็อตจาก PG SOFT JOKER JILI ก่อนเข้าใช้งานจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#ffeaa0]">{BRAND_NAME} เป็นฐานหลักเว็บสล็อตลิขสิทธิ์แท้ ที่รวมเกมสล็อตออนไลน์จาก 3 ค่ายหลัก PG SOFT JOKER และ JILI ไว้ในเว็บไซต์เดียว</strong>
        หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับระบบได้ไล่ดูให้ครบหนึ่งรอบก่อนเข้าใช้งานจริง ตั้งแต่แนวเกมของแต่ละค่าย ไปจนถึงขั้นตอนสมัครสมาชิกและเงื่อนไขของโปรโมชั่นที่เปิดให้เข้าร่วม
      </p>

      <p>
        คำว่า ทดลองเล่น ที่หน้านี้พูดถึงจึงหมายถึง
        <strong class="text-[#ffeaa0]">การศึกษากติกา ตารางการจ่ายรางวัล และคุณสมบัติของเกมก่อนเข้าใช้งาน</strong>
        ไม่ใช่การแจกเครดิตทดลอง และไม่ใช่การรับประกันผลของรายการใดรายการหนึ่ง หากติดขัดระหว่างใช้งานสามารถติดต่อเจ้าหน้าที่เพื่อสอบถามบริการเพิ่มเติมได้ตลอด 24 ชั่วโมง
      </p>

      <p>
        อีกเรื่องที่ควรไล่ดูไปพร้อมกันคือข้อกำหนดบริการของเว็บไซต์ ทั้งอายุผู้ใช้งาน เงื่อนไขการเปิดบัญชี และรายการฝากถอน
        <strong class="text-[#ffeaa0]">ทั้งนี้ ข้อมูลเกี่ยวกับลิขสิทธิ์และแหล่งที่มาของระบบควรตรวจสอบจากหลักฐานของผู้ให้บริการโดยตรง</strong>
