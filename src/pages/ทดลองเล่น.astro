---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement.astro";

import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login,
// /register หรือหน้าภาพแบบ /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง
// ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้
// (src/assets/content.txt) ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่จาก
// ข้อเท็จจริงและคลังคำของบรีฟรอบนี้เท่านั้น (.claude/brand-spec-bohba168.md §4-§5)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x4 · h3x0
//   h1  ทดลองเล่น <แบรนด์> ศึกษากติกาเกมสล็อตก่อนเดิมพันด้วยเงินจริง
//   h2  กติกาเกมสล็อต แนวจ่ายรางวัล และรอบโบนัสที่ควรอ่านก่อนลงเงิน
//   h2  เงื่อนไขโบนัสฝาก คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ที่ควรตรวจก่อนรับสิทธิ์
//   h2  สมัครสมาชิก <แบรนด์> ก่อนเข้าตรวจรายละเอียดเกมและยอดเดิมพัน
//   h2  ฝากถอนทุกธนาคารและทรูมันนี่ กับช่องทางติดต่อแอดมิน 24ชม.
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// 🚨🚨 **คำว่า "ทดลองเล่น" อยู่ได้เฉพาะเพราะเป็นชื่อ route /ทดลองเล่น และชื่อเมนู
// จริง** (ใช้ใน h1 · title · description · breadcrumb) แต่ **บรีฟรอบนี้ไม่ได้
// พูดถึงโหมดเล่นโดยไม่ใช้เงินจริงเลยแม้แต่ประโยคเดียว** → **ห้ามอ้างว่าเว็บมี
// โหมดนั้นให้** ห้ามอ้างจำนวนเกมที่เล่นได้ ห้ามอ้างค่า RTP เป็นตัวเลข และห้ามอ้างว่า
// ผลที่ออกในการลองสะท้อนผลจริง แกนของหน้าจึงเป็น **"สิ่งที่ควรศึกษาและตรวจสอบ
// เกี่ยวกับเกมที่ระบุไว้ ก่อนเดิมพันด้วยเงินจริง"** ตามที่บรีฟมีจริง: กติกาเกม ·
// แนวการเรียงสัญลักษณ์ · พฤติกรรมของรอบโบนัส · ยอดเดิมพันขั้นต่ำ · ตารางจ่ายรางวัล ·
// ค่า RTP จากผู้พัฒนาเกม · เบทเริ่มต้น 1 บาท · เงื่อนไขโบนัสไม่ต้องทำเทิร์น ·
// คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · ฝากถอนธนาคารและทรูมันนี่ · แอดมิน 24ชม. ·
// ประกาศล่าสุด
// ⚠️ และมีหนึ่งประโยคที่พูดตรงๆ ว่าบรีฟไม่ได้ระบุโหมดนั้นไว้ เพื่อไม่ให้ผู้อ่าน
// อนุมานเอาจากชื่อเมนู — **ห้ามถอดประโยคนั้นออก**
//
// ⚠️⚠️ **ห้ามเขียนชื่อแบรนด์ด้วยตัวละตินเด็ดขาด** (brand-spec §1) — รอบนี้สะกดได้
// แบบเดียวคือค่าใน BRAND_NAME ซึ่งเป็นภาษาไทยผสมเลข ห้ามพิมพ์ตรงๆ
// ⚠️⚠️ คำนิยามตัวเองของแบรนด์ขาออกเป็น **คำค้างข้ามแบรนด์** ห้ามหลุดกลับมา
// **รายการคำต้องห้ามเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่** เพื่อไม่ให้
// sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
//
// ⚠️ **รอบนี้สองหน้าหมวดลอตเตอรีถูกปิด** (อยู่ใน src/pages-disabled/ เพราะรอบนี้
// เป็นเว็บสล็อต) ลิงก์ไปสอง route นั้นจากหน้านี้จึงไม่มี — verify-build จะแดงถ้า
// href ชี้ไป route ที่ไม่มีจริง
// route ที่มีจริงรอบนี้: / · /about-us · /contact-us · /promotion · /ทดลองเล่น ·
// /ทางเข้า · /login · /register · /terms · /privacy · 404 · /line
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกม ชื่อธนาคารรายตัว ชื่อผู้ให้บริการ
// หน่วยงานกำกับ ใบอนุญาต ปีก่อตั้ง จำนวนสมาชิก จำนวนเกม ตัวเลข RTP อัตราจ่าย
// หรือยอดขั้นต่ำที่เป็นตัวเลขอื่น แม้แต่รายการเดียว** จึงห้ามเขียนลงหน้าเว็บ ·
// ตัวเลขที่ขึ้นหน้าได้มีแค่ของบรีฟเอง: **0.3% · 0.8% · 1 บาท · 24ชม.**
//
// 🚨 **ข้อกำกับของบรีฟที่ต้อง ship ครบบนหน้านี้** (ไม่ใช่ filler ให้ตัดทิ้ง):
// 1) ควรตรวจสอบยอดเดิมพันขั้นต่ำ ตารางจ่ายรางวัล และค่า RTP จากผู้พัฒนาเกม
//    ก่อนใช้งาน
// 2) คำกล่าวอ้างว่าแตกง่ายหรือถอนได้ไม่จำกัด ควรพิจารณาจากข้อมูลและเงื่อนไขจริง
//    เพราะเกมสล็อตไม่สามารถรับประกันผลรางวัล และการถอนเงินอาจมีข้อจำกัดตาม
//    ผู้ให้บริการ
// 3) ควรตรวจสอบว่าโปรโมชั่นใดได้รับการยกเว้นข้อกำหนดยอดเดิมพัน และมีเงื่อนไข
//    เรื่องจำนวนครั้งที่รับสิทธิ์ วงเงินโบนัสสูงสุด หรือการถอนเงินหรือไม่ ·
//    การไม่ต้องทำเทิร์นไม่ได้หมายความว่าไม่มีข้อจำกัดทุกประเภท
// 4) เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่ม
//    โอกาสชนะในครั้งต่อไป
// 5) แม้ระบุว่าไม่จำกัด แต่ควรยืนยันจำนวนบัญชีที่เข้าร่วมได้และรอบจ่ายเครดิต
// 6) ควรตรวจสอบรายชื่อธนาคารที่รองรับ ยอดขั้นต่ำ ชื่อบัญชีปลายทาง ระยะเวลา
//    ดำเนินการ และข้อกำหนดการถอนเงิน · พบความผิดปกติให้หยุดทำรายการและติดต่อ
//    ธนาคารหรือผู้ให้บริการชำระเงินก่อนโอนเงิน
// 7) ตรวจช่องทางติดต่อจากเว็บไซต์ทางการเพื่อเลี่ยงบัญชีแอบอ้าง · เก็บหมายเลข
//    รายการไว้เป็นหลักฐาน · ไม่เปิดเผยรหัสผ่านหรือรหัส OTP · ตรวจสอบเวลาการ
//    ให้บริการจริงจากประกาศล่าสุด
// ⚠️ บรีฟรอบนี้ **โฆษณาและกำกับในประโยคเดียวกัน** คำโฆษณาอยู่ได้เฉพาะในขอบเขตที่
// บรีฟเขียนไว้เอง ห้ามขยายเป็นคำกล่าวอ้างใหม่ และทุกประโยคกำกับต้อง ship ครบ
// ห้ามตัดเพราะฟังดูลบ
//
// 🚨 **ไม่มีรูปในหน้านี้โดยตั้งใจ** รอบนี้ไม่มี "รูปประกอบบทความ" เลย
// (banner2/banner3 และ slide3/slide4 เป็นอาร์ตเวิร์กของแบรนด์อื่น —
// **ห้าม import ทั้งสี่ไฟล์** ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/
// ทุก build) · slide1/slide2 ถูกตรึงไว้กับ index §4 ข้อ 4-5 กับ /promotion ·
// banner1 / banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักไว้
// **ห้ามอ้างจากหน้านี้** · ไฟล์เก่าทั้งหมดยังอยู่บนดิสก์ **ห้ามลบ**
// เป็นอินเวนทอรีของแบรนด์ถัดไป
//
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) **ยังเป็นธีมสว่างเหมือนรอบก่อน แต่คนละฮิว
// สิ้นเชิง** bg.json ของดรอปนี้คือ {"mode":"color","color":"#00bfff"} =
// **ฟ้าสกายอิ่มตัว** (รอบก่อนเป็น ffe5ff = ชมพูพาสเทล)
// **ห้ามเดาว่าเท่าเดิม และห้าม "แก้" การ์ด/ปุ่มกลับไปเป็นพื้นมืด** — พื้นมืดบน
// หมึก #06283f = ตัวอักษรหายไปเลย ไม่ใช่แค่จางลง
// ค่าที่ใช้ได้ในไฟล์นี้: หัวข้อ/`<strong>`/marker ของลำดับเลข **#0f5684**
// (7.8:1 บนการ์ดขาว) · เข้มสุด #06283f (15.2:1) · พื้นไล่เฉดปุ่มหลัก
// #1a6ea8 -> #0f5684 -> #06283f (**พื้นถม** + หมึกขาว #ffffff) · ปุ่มรองเป็น
// ผิวสว่าง #ffffff -> #e4f6fb คู่กับหมึกน้ำเงินเข้ม #06283f ·
// ผิวยก #f0faff · wash #e4f6fb · เส้น #7fcbe8 · เส้นเข้ม #4fb8ea
// (**ทั้งคู่ห้ามถือตัวอักษร**)
// หมึกเนื้อความคือ #06283f (= BRAND_TEXT) ซึ่ง **ไม่ประกาศในไฟล์นี้** การ์ด
// ContentBox ตั้งไว้ให้แล้วและย่อหน้าสืบทอดลงมา
// 🚨🚨 **#12b4ef บนพื้นขาวได้แค่ 2.4:1 — ห้ามเป็นสีตัวอักษร** และ **ห้ามถมพื้น
// #12b4ef หรือ #00bfff แล้ววางหมึกขาว** (2.4 / 2.1:1) พื้นฟ้าที่รับหมึกขาวได้
// ต้องเป็น **#1a6ea8 ลงไป** เท่านั้น
// ออราที่อนุญาต: rgba(18,180,239,α) · rgba(182,227,240,α) · rgba(15,86,132,α) ·
// rgba(6,40,63,α) · rgba(127,203,232,α)
// ⚠️⚠️ **รอบนี้ไม่มีชมพู ไม่มีแมเจนต้า ไม่มีพลัมเลยสักค่า** (ทั้งชุดคือพาเลตของ
// แบรนด์ขาออก) · ไม่มีทอง/เหลือง ไม่มีแดง ไม่มีม่วง ไม่มีครีม/เบจ/น้ำตาล
// ไม่มีเทาเงิน · ปุ่ม LINE อยู่บน /about-us กับ /contact-us ไม่ใช่หน้านี้
// ⚠️⚠️ **รอบนี้เป็นแบรนด์ฟ้าจริง การเจอฟ้าในไฟล์จึงไม่พิสูจน์อะไร** — ห้ามเทียบ
// ด้วยวงศ์สี ต้องเทียบทีละค่ากับตาราง brand-spec §2 (18a5e2 ห่างจาก #12b4ef แค่
// R6/G15/B13 · 063a57 มี R=06 ตรงกับ #06283f เป๊ะ · 07335f ใกล้ #06283f ที่ R ·
// 0a4ea8 ใกล้ #0b4a73 ที่ G — เจอที่ไหนแปลว่าพิมพ์ผิด
// เฮกซ์ของแบรนด์เก่าในคอมเมนต์เขียนแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep สะดุด)
// ⚠️⚠️ **เสื้อคลุมถักฟ้าอ่อน พื้นสตูดิโอขาว ดาวเหลือง เหรียญทอง และสีผิวนักแสดง
// ในอาร์ตเวิร์กเป็นวัตถุในภาพ ไม่ใช่สี UI**
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง และไม่ใส่ mx-auto / max-w-* บน <p>
// เพราะการ์ดคุมความกว้างเองแล้ว — ที่ประกาศสีได้มีแค่ปุ่ม ชิปไอคอน marker ของ
// ลำดับเลข และ <strong> · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง
// เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำ
// จะขาดครึ่ง และห้ามวาง <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังในข้อความของ prop และต้องเป็นไอคอนหมวดสล็อต ไม่ใช่ไอคอนหมวดลอตเตอรี
// slot ของ ContentBox รับ **หนึ่ง element** เท่านั้น จึงห่อด้วย <div> ชั้นเดียว
//
// Announcement รอบนี้หมุนมาเป็น Announcement ตัวฐานทั้งเว็บ (brand-spec §3 —
// รอบก่อนใช้ Announcement4 จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้น
// เป็นคอปปี้ของแบรนด์นี้แล้ว จึงเรียกแบบ bare **ห้ามส่ง prop message** มิฉะนั้น
// ข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -c บนเชลล์นี้
// ก็นับเป็นไบต์ ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับตัวนับ
// ของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 157 อักขระ (ชื่อแบรนด์รอบนี้ 10 อักขระ) เป็นประโยคเดียวที่บอกว่า
// หน้านี้มีไว้ทำอะไร แล้วหยุด
// (Google ตัดราว 160 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนๆ ยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} รวมสิ่งที่ควรศึกษาก่อนเดิมพันจริง ทั้งกติกาเกมสล็อต แนวจ่ายรางวัล รอบโบนัส เงื่อนไขโบนัสไม่ต้องทำเทิร์น คืนยอดเสีย 0.3% และขั้นตอนฝากถอน`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ศึกษากติกาเกมสล็อตก่อนเดิมพันด้วยเงินจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});

// คลาสปุ่มสามขั้วของหน้านี้ ประกาศครั้งเดียวแล้วใช้ซ้ำ เพื่อไม่ให้สองปุ่มที่ทำ
// หน้าที่เดียวกันหลุดไปคนละเฉดตอนรีแบรนด์รอบหน้า
const ctaPrimary =
  "flex items-center justify-center rounded-full border border-[#06283f] bg-gradient-to-b from-[#1a6ea8] via-[#0f5684] to-[#06283f] px-8 py-3 font-black text-white shadow-[0_6px_18px_rgba(15,86,132,0.3)] transition-transform hover:scale-105";

const ctaSecondary =
  "flex items-center justify-center rounded-full border border-[#4fb8ea] bg-gradient-to-b from-[#ffffff] to-[#e4f6fb] px-8 py-3 font-bold text-[#06283f] shadow-[0_6px_18px_rgba(127,203,232,0.35)] transition-transform hover:scale-105";

const ctaQuiet =
  "flex items-center justify-center rounded-full border-2 border-[#4fb8ea] bg-[#ffffff] px-8 py-3 font-bold text-[#0f5684] shadow-[0_4px_14px_rgba(18,180,239,0.2)] transition-all hover:scale-105 hover:bg-[#f0faff] hover:shadow-[0_6px_18px_rgba(15,86,132,0.2)]";

const listChip = "mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#7fcbe8] bg-[#e4f6fb] text-sm";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#0f5684]">{BRAND_NAME} นำเสนอเกมสล็อตออนไลน์หลากหลายรูปแบบ ทั้งเกมคลาสสิก เกมโบนัส และเกมสล็อตจากค่ายต่าง ๆ</strong>
        หน้านี้รวบรวมไว้ว่าควรศึกษาอะไรเกี่ยวกับเกมที่ระบุไว้ และควรตรวจอะไรซ้ำทุกครั้งที่กลับเข้ามาใหม่ ก่อนตัดสินใจเดิมพันด้วยเงินจริง
      </p>

      <p>
        ภายในเว็บไซต์ผู้ใช้งานสามารถศึกษากติกาเกม ตรวจสอบเงื่อนไขโบนัส และดูรายละเอียดฝากถอนก่อนใช้งานได้ ส่วนคำกล่าวอ้างว่าแตกง่ายหรือถอนได้ไม่จำกัด
        <strong class="text-[#0f5684]">ควรพิจารณาจากข้อมูลและเงื่อนไขจริง เพราะเกมสล็อตไม่สามารถรับประกันผลรางวัล และการถอนเงินอาจมีข้อจำกัดตามผู้ให้บริการ</strong>
      </p>

      <p>
        <strong class="text-[#0f5684]">ข้อมูลที่เว็บไซต์ระบุไว้ไม่ได้กล่าวถึงการเปิดให้หมุนเกมโดยไม่ใช้เงินจริงไว้แต่อย่างใด</strong>
        หน้านี้จึงไม่ยืนยันว่ามีรูปแบบนั้นให้ใช้งาน และควรตรวจสอบจากประกาศล่าสุดของเว็บไซต์ทางการเองว่าเกมใดเปิดให้ศึกษาได้ในลักษณะใด เนื้อหาด้านล่างเขียนไว้ประกอบการใช้งานเท่านั้น ไม่ได้ใช้แทนเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้บริการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="กติกาเกมสล็อต แนวจ่ายรางวัล และรอบโบนัสที่ควรอ่านก่อนลงเงิน" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#0f5684]">การอ่านกติกาของเกมที่จะเล่นจากหน้ากติกาของเกมนั้นเอง ตรงกว่าการเทียบจากหน้าตาของวงล้อเพียงอย่างเดียว</strong>
        เพราะแต่ละเกมกำหนดรูปแบบการจ่ายรางวัลไว้คนละชุด รายการด้านล่างคือสิ่งที่ควรไล่อ่านให้ครบก่อนตั้งยอดเดิมพัน
      </p>

      <ul class="flex flex-col gap-4" aria-label="สิ่งที่ควรศึกษาในเกมสล็อตก่อนเดิมพันจริง">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎰</span>
          <span>
            <strong class="text-[#0f5684]">แนวการเรียงสัญลักษณ์ที่เกมนั้นใช้นับผล</strong> ควรดูว่าเปิดใช้งานกี่แนวและปรับได้หรือไม่ ก่อนตั้งยอดเดิมพันต่อรอบ เพราะเป็นตัวกำหนดว่าหนึ่งรอบคิดเป็นยอดเท่าไร
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📊</span>
          <span>
            <strong class="text-[#0f5684]">ยอดเดิมพันขั้นต่ำ ตารางจ่ายรางวัล และค่า RTP จากผู้พัฒนาเกม</strong> ควรตรวจสอบก่อนใช้งานทุกครั้ง เพราะข้อมูลที่ระบุว่ามีเกมเบทเริ่มต้น 1 บาท ไม่ได้แปลว่าทุกเกมกำหนดระดับการเดิมพันไว้เท่ากัน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎁</span>
          <span>
            <strong class="text-[#0f5684]">พฤติกรรมของรอบโบนัส</strong> ควรอ่านว่ารอบนั้นเริ่มจากเงื่อนไขอะไรและคำนวณผลด้วยวิธีใด ก่อนตั้งวงเงินที่จะใช้ในรอบนั้น
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📣</span>
          <span>
            <strong class="text-[#0f5684]">ประกาศล่าสุดของเว็บไซต์ทางการ</strong> คือจุดที่เงื่อนไขจริงถูกอัปเดต ทั้งเกมที่เปิดให้บริการ รายการโปรโมชั่น และช่องทางฝากถอน การเปิดดูก่อนทุกครั้งจึงตรงกว่าการจำไว้จากครั้งก่อน
          </span>
        </li>
      </ul>

      <p>
        ผลของเกมสล็อตมีความไม่แน่นอนโดยตัวของมันเอง
        <strong class="text-[#0f5684]">ผลที่ออกในรอบก่อนจึงไม่ใช่สถิติที่นำมาคาดการณ์รอบถัดไปได้</strong>
        และการศึกษากติกาช่วยให้เข้าใจว่าเกมคำนวณผลอย่างไรเท่านั้น ไม่ได้เพิ่มโอกาสชนะในรอบใด
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/promotion" aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`} class={ctaQuiet}>ดูภาพโปรโมชั่น</a>

        <a href="/about-us" aria-label={`อ่านหน้าเกี่ยวกับเราของ ${BRAND_NAME}`} class={ctaQuiet}>อ่านเกี่ยวกับเรา</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="เงื่อนไขโบนัสฝาก คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ที่ควรตรวจก่อนรับสิทธิ์" as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} นำเสนอข้อมูลโปรโมชั่นที่ระบุว่าสามารถรับโบนัสจากการฝากเงินได้ตลอดวันโดยไม่ต้องทำเทิร์น
        <strong class="text-[#0f5684]">
          ซึ่งผู้ใช้งานควรตรวจสอบก่อนว่าโปรโมชั่นใดได้รับการยกเว้นข้อกำหนดยอดเดิมพัน และมีเงื่อนไขเกี่ยวกับจำนวนครั้งที่รับสิทธิ์ วงเงินโบนัสสูงสุด หรือการถอนเงินหรือไม่
        </strong>
        เพราะการไม่ต้องทำเทิร์นไม่ได้หมายความว่าไม่มีข้อจำกัดทุกประเภท นอกจากนี้ยังมีรายการคืนยอดเสียและแนะนำเพื่อนให้ศึกษาตามสิทธิ์สมาชิก โดยควรอ่านรายละเอียดล่าสุดให้ครบถ้วนก่อนเข้าร่วม
      </p>

      <p>
        รายการคืนยอดเสีย 0.3% ระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขรายวัน สมาชิกควรตรวจสอบว่าเกมสล็อตประเภทใดเข้าร่วมรายการ มีรอบสรุปยอดเวลาใด และต้องกดรับเครดิตด้วยตนเองหรือระบบดำเนินการให้อัตโนมัติ
        <strong class="text-[#0f5684]">ทั้งนี้ เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งต่อไป</strong>
        เพราะยอดเสียบางรายการอาจไม่เข้าเกณฑ์รับสิทธิ์ตั้งแต่ต้น
      </p>

      <p>
        รายการแนะนำเพื่อนโบนัส 0.8% ระบุสิทธิ์ไว้สำหรับสมาชิกที่แนะนำผู้ใช้งานรายใหม่ โดยควรตรวจสอบวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และฐานยอดที่ใช้คำนวณโบนัสให้ชัดเจน
        <strong class="text-[#0f5684]">แม้จะมีข้อความว่าไม่จำกัด แต่ควรยืนยันจำนวนบัญชีที่เข้าร่วมได้ รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุด</strong>
        เพื่อป้องกันความเข้าใจคลาดเคลื่อนเกี่ยวกับจำนวนเครดิตที่มีสิทธิ์ได้รับ
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME} ก่อนเข้าตรวจรายละเอียดเกมและยอดเดิมพัน`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#0f5684]">{BRAND_NAME} มีช่องทางสำหรับผู้ที่ต้องการศึกษาวิธีสมัครสมาชิกและเข้าสู่ระบบเกมสล็อตออนไลน์</strong>
        ก่อนดำเนินการควรตรวจสอบคุณสมบัติผู้สมัคร ข้อกำหนดด้านอายุ และกฎหมายที่เกี่ยวข้อง รวมถึงศึกษานโยบายความเป็นส่วนตัวเพื่อทำความเข้าใจวิธีจัดเก็บข้อมูลส่วนบุคคล
      </p>

      <ol class="ml-6 list-decimal space-y-3 marker:font-black marker:text-[#0f5684]">
        <li>
          <strong class="text-[#0f5684]">เข้าสู่หน้าสมัครสมาชิก</strong> ตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง จากนั้นเลือกเมนูสมัครสมาชิกและอ่านเงื่อนไขการเปิดบัญชี รวมถึงนโยบายการจัดเก็บข้อมูลส่วนบุคคลก่อนกรอกข้อมูล
        </li>
        <li>
          <strong class="text-[#0f5684]">กรอกข้อมูลและยืนยันบัญชี</strong> กรอกข้อมูลตามที่ระบบกำหนด ตรวจสอบความถูกต้องก่อนยืนยัน และตั้งรหัสผ่านที่คาดเดาได้ยาก ไม่ควรใช้ข้อมูลของบุคคลอื่นหรือเปิดเผยรหัส
          OTP ให้ใครทราบ
        </li>
        <li>
          <strong class="text-[#0f5684]">เข้าสู่ระบบและตรวจสอบรายละเอียดเกม</strong> หลังลงทะเบียนเรียบร้อย สามารถศึกษารายชื่อเกมสล็อต กติกาการเล่น ยอดเดิมพันขั้นต่ำ และรายละเอียดโปรโมชั่นที่เปิดให้บริการ
          หากมีข้อสงสัยควรสอบถามเจ้าหน้าที่ผ่านช่องทางทางการก่อนทำรายการ
        </li>
      </ol>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/register" aria-label={`สมัครสมาชิก ${BRAND_NAME}`} class={ctaPrimary}>สมัครสมาชิก</a>

        <a href="/login" aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`} class={ctaSecondary}>เข้าสู่ระบบ</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="ฝากถอนทุกธนาคารและทรูมันนี่ กับช่องทางติดต่อแอดมิน 24ชม." as="h2">
    <div class="flex flex-col gap-6">
      <p>
        เมื่ออ่านกติกาเกมและข้อกำหนดของโปรโมชั่นครบแล้ว
        <strong class="text-[#0f5684]">ขั้นถัดไปคือการตรวจระบบฝากถอนและช่องทางติดต่อให้ครบก่อนทำธุรกรรมครั้งแรก</strong>
        {BRAND_NAME} ระบุช่องทางฝากถอนผ่านธนาคารและทรูมันนี่ไว้ และรายการด้านล่างควรตรวจซ้ำทุกครั้งที่กลับเข้ามาใหม่ เพราะเงื่อนไขปรับเปลี่ยนได้ตามที่ผู้ให้บริการกำหนด
      </p>

      <ol class="ml-6 list-decimal space-y-3 marker:font-black marker:text-[#0f5684]">
        <li>
          <strong class="text-[#0f5684]">รายชื่อธนาคารที่รองรับ ยอดขั้นต่ำ และระยะเวลาดำเนินการ</strong> ควรตรวจสอบก่อนฝากเงิน พร้อมศึกษาข้อกำหนดการถอนเงินให้ครบ แม้จะมีข้อความระบุว่าถอนได้ไม่จำกัด และดูขั้นตอนการยืนยันตัวตนที่ระบบกำหนดไว้
        </li>
        <li>
          <strong class="text-[#0f5684]">ชื่อบัญชีปลายทาง</strong> ควรตรวจสอบให้ตรงกับข้อมูลผู้ให้บริการที่ยืนยันได้ก่อนโอนเงิน นี่คือจุดที่ใช้แยกรายการตามปกติออกจากบัญชีแอบอ้างได้เร็วที่สุด
        </li>
        <li>
          <strong class="text-[#0f5684]">หมายเลขรายการและหลักฐานการทำธุรกรรม</strong> ควรเก็บไว้ทุกครั้งหลังฝากหรือถอน เพื่อใช้ตรวจสอบย้อนหลังหากยอดไม่เข้าตามที่ระบุ
        </li>
        <li>
          <strong class="text-[#0f5684]">ช่องทางติดต่อแอดมิน 24ชม.</strong> ควรตรวจสอบจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีแอบอ้างที่ใช้ชื่อคล้ายกัน และควรตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุดอีกครั้ง
        </li>
        <li>
          <strong class="text-[#0f5684]">ความปลอดภัยของข้อมูลที่ใช้เข้าสู่ระบบ</strong> ควรตั้งรหัสผ่านที่คาดเดาได้ยาก และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้ใครทราบ แม้จะอ้างว่าเป็นเจ้าหน้าที่ก็ตาม
        </li>
      </ol>

      <p>
        <strong class="text-[#0f5684]">หากพบชื่อบัญชีไม่ตรงกับข้อมูลทางการหรือมีการแจ้งเปลี่ยนบัญชีอย่างผิดปกติ ควรหยุดทำรายการและติดต่อธนาคารหรือผู้ให้บริการชำระเงินเพื่อตรวจสอบก่อนโอนเงิน</strong>
        แล้วค่อยกลับมาทำรายการใหม่เมื่อตรวจสอบข้อมูลปลายทางได้ครบถ้วน และเมื่อแจ้งปัญหา ควรระบุรายละเอียดให้ชัดเจนพร้อมหลักฐานที่เกี่ยวข้อง โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact-us" aria-label={`ดูช่องทางติดต่อทีมงาน ${BRAND_NAME} ทั้งหมด`} class={ctaQuiet}>ช่องทางติดต่อทั้งหมด</a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
