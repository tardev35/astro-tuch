---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { Picture } from "astro:assets";

import popularGamesImage from "../assets/gamedemo8.webp";
import newGamesImage from "../assets/gamedemo16.webp";

import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login,
// /register หรือหน้าภาพแบบ /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง
// ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้
// (src/assets/content.txt) ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่จาก
// ข้อเท็จจริงและคลังคำของบรีฟรอบนี้เท่านั้น (.claude/brand-spec-zoro365.md §4-§5)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x4 · h3x0
//   h1  ทดลองเล่น <แบรนด์> ศึกษากติกาและรูปแบบการเดิมพันก่อนใช้เงินจริง
//   h2  บาคาร่า สล็อต หวย บอล ไฮโล ห้าหมวดที่ต่างกันทั้งกติกาและอัตราจ่าย
//   h2  ข้อมูลค่ายผู้พัฒนาและผู้ให้บริการ จุดที่ควรตรวจก่อนเปิดบัญชี
//   h2  ข้อความไม่มีขั้นต่ำ ครอบคลุมถึงอะไร และควรอ่านอะไรเพิ่ม
//   h2  สิ่งที่ควรตรวจซ้ำทุกครั้งก่อนเดิมพันด้วยเงินจริง
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// **การ์ดรูปสองใบอยู่ใน h2 ใบแรก ไม่ได้แยกเป็นหัวข้อของตัวเอง** เพื่อคงผัง h2x4
// ป้ายกำกับของการ์ดรูปอยู่ในตัวภาพเอง (alt) ไม่มีป้ายข้อความใดเป็น heading
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
// ⚠️ **ห้ามให้หน้านี้กลายเป็นสำเนาของ index.astro** — index เล่าห้าหมวดเกม
// โปรโมชั่น 0.3%/0.8% ขั้นตอนสมัคร และแอดมิน ส่วนหน้านี้เล่า **สิ่งที่ควรอ่าน
// และตรวจสอบก่อนลงเงินจริง** คนละแกนกัน
//
// 🚨🚨 รอบนี้เป็น **เว็บเกมคาสิโน/เดิมพันออนไลน์** ที่บรีฟระบุห้าหมวดไว้เอง
// (บาคาร่า · สล็อต · หวย · บอล · ไฮโล) → อ้างชื่อหมวดได้ตรงๆ
// ⚠️⚠️ **"หวย" ใช้ได้ในฐานะชื่อหมวดเกมหนึ่งในห้าเท่านั้น** ห้ามเขียนเนื้อหา
// เฉพาะทางหวย (งวด เลขเด็ด สลาก โพย รอบปิดรับ สองตัวบน-ล่าง สามตัวตรง-โต๊ด
// หวยรัฐบาล/ลาว/ฮานอย/หุ้น) และ **ห้ามลิงก์ไปสองหน้าหวยที่ยังปิดอยู่**
// (ชื่อไฟล์อยู่ใน brand-spec §7 — ทั้งคู่อยู่ใน src/pages-disabled/ ตามเดิม
// href ที่ตายจะทำให้ build แดง)
// 🚨🚨 **คำว่า "ทดลองเล่น" อยู่ได้เฉพาะเพราะเป็นชื่อ route /ทดลองเล่น และชื่อเมนู
// จริง** (ใช้ใน h1 · title · description · breadcrumb) แต่ **บรีฟรอบนี้ไม่ได้
// พูดถึงโหมดเล่นโดยไม่ใช้เงินจริงเลยแม้แต่ประโยคเดียว** → **ห้ามอ้างว่าเว็บมี
// โหมดนั้นให้** ห้ามอ้างจำนวนเกม/ค่าย ห้ามอ้างอัตราจ่ายคืนหรือความผันผวนเป็นตัวเลข
// และห้ามอ้างว่าสถิติย้อนหลังคาดการณ์ผลรอบถัดไปได้
// แกนของหน้าจึงเป็น **"สิ่งที่ควรศึกษาและตรวจสอบก่อนเดิมพันด้วยเงินจริง"** ตามที่
// บรีฟมีจริง (บรรทัด 4, 6, 14, 22): เกมเดิมพันออนไลน์หลากหลายประเภท · แต่ละ
// ประเภทมีรูปแบบการเดิมพันและอัตราจ่ายแตกต่างกัน · ควรตรวจสอบวงเงินเดิมพันขั้นต่ำ
// และสูงสุด · **คำกล่าวอ้างเรื่องคาสิโนสายตรงและเกมถูกลิขสิทธิ์ควรตรวจสอบข้อมูล
// บริษัทและหลักฐานการได้รับอนุญาตจากแหล่งที่เชื่อถือได้ก่อนใช้งาน** · **ควรตรวจว่า
// ข้อความไม่มีขั้นต่ำครอบคลุมเฉพาะการสมัครหรือรวมถึงการฝากเงินและการเดิมพันด้วย** ·
// แอดมิน 24ชม. · ไม่เปิดเผยรหัสผ่านหรือรหัส OTP
// ⚠️ และมีหนึ่งประโยคที่พูดตรงๆ ว่าบรีฟไม่ได้ระบุโหมดนั้นไว้ เพื่อไม่ให้ผู้อ่าน
// อนุมานเอาจากชื่อเมนู — **ห้ามถอดประโยคนั้นออก**
// ⚠️ บรีฟรอบนี้ **โฆษณาและกำกับในประโยคเดียวกัน** คำโฆษณาอยู่ได้เฉพาะในขอบเขตที่
// บรีฟเขียนไว้เอง ห้ามขยายเป็นคำกล่าวอ้างใหม่ และทุกประโยคกำกับต้อง ship ครบ
// ห้ามตัดเพราะฟังดูลบ
//
// ⚠️⚠️ ชื่อแบรนด์รอบนี้เป็น **ตัวละตินพิมพ์ใหญ่ + เลข เขียนติดกัน ไม่มีเว้นวรรค
// และไม่มีขีดกลาง** (brand-spec §0 — โดเมนมีขีด ชื่อแบรนด์ไม่มี) ทุกจุดยัง
// interpolate จาก BRAND_NAME เหมือนเดิม เพื่อไม่ให้ค้างเป็นชื่อแบรนด์ก่อนหน้า
// ตอนรีแบรนด์รอบถัดไป ห้ามพิมพ์ชื่อตรงๆ
// 🚨🚨 **บรีฟรอบนี้ไม่พูดถึงธนาคาร วอลเลท หรือการฝากถอนเป็นหมวดของเว็บเลยแม้แต่
// คำเดียว** — ห้ามเขียนหัวข้อ "ฝากถอน" หรือชื่อวอลเล็ต/ธนาคารกลับเข้ามา
// (คำว่า "การฝากเงิน" ปรากฏได้เฉพาะในประโยคกำกับของบรีฟเอง ที่ถามว่าข้อความ
// ไม่มีขั้นต่ำครอบคลุมถึงการฝากเงินและการเดิมพันด้วยหรือไม่)
// ⚠️ **0.3% กับ 0.8% เป็นเนื้อหาของบรีฟรอบนี้จริง** แต่เป็นเนื้อหาของ index §4-§5
// กับ /promotion — **หน้านี้ไม่หยิบมาใช้โดยตั้งใจ** เพราะแกนของหน้าเป็นการศึกษา
// กติกา ไม่ใช่การประกาศสิทธิประโยชน์
// ⚠️ วลีของเว็บรอบนี้คือ **"ไม่ผ่านเว็บตัวแทน"** ตามบรีฟบรรทัด 2 — ห้ามใช้วลี
// ทำนองเดียวกันของแบรนด์เก่าแทน (ลิสต์อยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่)
//
// route ที่มีจริงรอบนี้: / · /about-us · /contact-us · /promotion · /ทดลองเล่น ·
// /ทางเข้า · /login · /register · /terms · /privacy · 404 · /line
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกม ชื่อผู้ให้บริการ หน่วยงานกำกับ ใบอนุญาต
// ปีก่อตั้ง จำนวนสมาชิก จำนวนเกม/ค่าย หรือยอดเดิมพันขั้นต่ำเป็นตัวเลข แม้แต่
// รายการเดียว** จึงห้ามเขียนลงหน้าเว็บ ·
// ตัวเลขที่ขึ้นหน้าได้มีแค่ของบรีฟเอง: **0.3% · 0.8% · 3 ขั้นตอน · 24ชม.**
// และหน้านี้หยิบมาใช้แค่ **24ชม.** ค่าเดียว เพราะเป็นค่าเดียวที่เกี่ยวกับแกนของหน้า
//
// 🚨 **รูปในหน้านี้ใช้ได้แค่ gamedemo8 กับ gamedemo16 เท่านั้น** — เป็นอาร์ตสต็อก
// กลางของเทมเพลต (mtime 2026-08-04) **ไม่ใช่อาร์ตเวิร์กของดรอปนี้ และไม่ใช่ของ
// แบรนด์ไหน** จึงใช้เป็นภาพประกอบตกแต่งได้ แต่ **ห้ามใช้แทนอาร์ตเวิร์กแบรนด์**
// gamedemo8 (600x379) กับ gamedemo16 (650x411) ไม่มีโลโก้หรือชื่อผู้ให้บริการ
// เจ้าอื่นพิมพ์ทับอยู่ ส่วน gamedemo7/9/10/11/12/14/15/17/18 มีโลโก้หรือชื่อของ
// ผู้ให้บริการเจ้าอื่นพิมพ์ทับอยู่กลางรูป และ gamedemo13 เป็นภาพล่อแหลม —
// **ห้ามนำกลับมาใช้**
// ⚠️⚠️ **ทั้งสองใบพิมพ์คำว่า POPULAR GAME / New Game ไว้บนภาพจริง** ซึ่งเป็น
// ข้อเท็จจริงของรูป alt จึงบอกตามนั้น · รูปคู่นี้เป็น **ภาพประกอบตกแต่ง** ไม่ใช่
// ภาพหน้าเกมจริงของเว็บ และไม่มีชื่อแบรนด์ใดพิมพ์อยู่บนรูป alt จึงไม่เอ่ยชื่อแบรนด์
// ⚠️ alt บรรยายสิ่งที่เห็นจริง (กระต่ายกับแมวใส่แว่นกันแดดและหูฟังขนาบหีบสมบัติ /
// ตัวละครหัวฟักทองกับโครงกระดูกบนลานเรืองแสง) **ไม่ใช่ตัวนับแบบ "ภาพที่ 1"**
// ⚠️ ทั้งสองใบวาดกว้างสุด 600px (กริดสองคอลัมน์ตั้งแต่ sm ขึ้นไป) widths/sizes
// จึงตั้งตามนั้น ไม่ใช่ตามขนาดไฟล์ต้นฉบับ
// 🚨 **ห้าม import อาร์ตเวิร์กของแบรนด์อื่นจากหน้านี้เด็ดขาด**: แบนเนอร์ใบที่สอง
// และสาม (2026-10-23) กับสไลด์ใบที่สามและสี่ (2026-09-29) เป็นของแบรนด์อื่น
// (ชื่อไฟล์เต็มอยู่ใน brand-spec §6) · สไลด์สองใบของดรอปนี้ถูกตรึงไว้กับ
// index §4-§5 กับ /promotion · banner1 / banner1-mobile / og.png เป็นของ glob ที่
// MainLayout ปักไว้ **ห้ามอ้างจากหน้านี้**
// · ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ ทุก build และ verify-build จะแดง
// · ไฟล์เก่าทั้งหมดยังอยู่บนดิสก์ **ห้ามลบ** เป็นอินเวนทอรีของแบรนด์ถัดไป
//
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) **กลับทิศ 180° จากรอบก่อน: มืดทั้งเว็บ**
// bg.json ของดรอปนี้คือ {"mode":"color","color":"#002908"} = **เขียวป่าจมเกือบดำ**
// (รอบก่อนเป็นขาวอมมิ้นต์จาง ซึ่งอยู่คนละปลายของสเกล) **ห้ามเดาว่าเท่าเดิม และ
// ห้าม "แก้" การ์ด/ปุ่มกลับไปเป็นพื้นขาว** — พื้นขาวบนหมึก #eef7f0 = ตัวอักษร
// หายไปเลย ไม่ใช่แค่จางลง
// ค่าที่ใช้ได้ในไฟล์นี้: `<strong>` ทองอำพัน **#e8c86a** (8.0:1 บนการ์ดเข้ม) ·
// marker ของลำดับเลขและปุ่ม outline เขียวมรกต **#3ddc4a** (6.9:1) · หมึกรอง
// #9dc2a5 (6.3:1) · เงินโครเมียม #dfe6e3 (9.9:1) · พื้นไล่เฉดปุ่มหลัก
// #0e5424 -> #1e7033 -> #23823a (**พื้นถม** + หมึกขาว #ffffff) · ปุ่มรองเป็น
// #0e5424 -> #073c1a คู่กับหมึก #eef7f0 · ผิวจม #031b09 · ชั้นยก/ชิป #0e5424 ·
// เส้นบาง #1e7033 · ขอบตกแต่ง #35a043 (**สองค่าหลังห้ามถือตัวอักษร** ใช้เป็น
// ขอบการ์ดรูป/ขอบปุ่มได้)
// หมึกเนื้อความคือ #eef7f0 (= BRAND_TEXT) ซึ่ง **ไม่ประกาศในไฟล์นี้** การ์ด
// ContentBox ตั้งไว้ให้แล้วและย่อหน้าสืบทอดลงมา
// 🚨🚨 **#35a043 บนการ์ด #073c1a ได้แค่ 3.8:1 และ #1e7033 ได้ 2.1:1 — ห้ามเป็นสี
// ตัวอักษร** และ **ขาวบน #35a043 กับ #3ddc4a ก็ตก AA** พื้นที่รับหมึกขาวได้ต้อง
// หยุดที่ **#23823a (4.9:1) ลงไปหาเข้ม** เท่านั้น
// ออราที่อนุญาต: rgba(61,220,74,α) · rgba(53,160,67,α) · rgba(30,112,51,α) ·
// rgba(232,200,106,α) · rgba(223,230,227,α) · rgba(1,13,4,α)
// ⚠️⚠️ **รอบนี้ไม่มีม่วง ไม่มีฟ้า/ไซแอน ไม่มีแมเจนต้า ไม่มีส้มเพลิง และไม่มีแดง
// เป็นสี UI เลยสักเฉด** — เหรียญทองในรูป gamedemo8 กับอัญมณี/ลูกบาศก์ชมพูในรูป
// gamedemo16 เป็น **วัตถุในภาพ ไม่ใช่สี UI** เช่นเดียวกับกิโมโน ดาบคาทานะ
// ชิปคาสิโนเขียว-ขาว กอไผ่ และผิวโครเมียมเงินของเวิร์ดมาร์ก
// ⚠️⚠️ **รอบก่อนหน้าทันทีก็เป็นแบรนด์เขียว + เงินโครเมียม + ทองอำพันเหมือนกันเป๊ะ
// ต่างกันแค่กลับทิศสว่าง-มืด** การเจอเขียวในไฟล์จึงไม่พิสูจน์อะไร — ห้ามเทียบด้วย
// วงศ์สี ต้องเทียบหกหลักกับตาราง brand-spec §2 (ค่าที่ใกล้จนต้องสงสัยว่าพิมพ์ผิด
// ก่อนเสมอถูกลิสต์ไว้ในไฟล์นั้นแล้ว และเขียนแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้
// sweep สะดุด)
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง และไม่ใส่ mx-auto / max-w-* บน <p>
// เพราะการ์ดคุมความกว้างเองแล้ว — ที่ประกาศสีได้มีแค่ปุ่ม ชิปไอคอน marker ของ
// ลำดับเลข ขอบการ์ดรูป และ <strong> · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วย
// ช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ
// บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง และห้ามวาง <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังในข้อความของ prop และต้องเป็นไอคอนหมวดเกมพนัน
// slot ของ ContentBox รับ **หนึ่ง element** เท่านั้น จึงห่อด้วย <div> ชั้นเดียว
//
// Announcement รอบนี้หมุนมาเป็นตัวท้ายชื่อเลข 3 ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ตัวท้ายชื่อ Premium จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้น
// เป็นคอปปี้ของแบรนด์นี้แล้ว จึงเรียกแบบ bare **ห้ามส่ง prop message** มิฉะนั้น
// ข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -c บนเชลล์นี้
// ก็นับเป็นไบต์ ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับตัวนับ
// ของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 151 อักขระ (ชื่อแบรนด์รอบนี้ 7 อักขระ ส่วนที่เหลือ 144 → รับชื่อ
// แบรนด์ได้ 6–16 อักขระ) เป็นประโยคเดียวที่บอกว่าหน้านี้มีไว้ทำอะไร แล้วหยุด
// (Google ตัดราว 160 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนๆ ยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} รวมสิ่งที่ควรศึกษาก่อนเดิมพันด้วยเงินจริง ทั้งกติกาของบาคาร่า สล็อต หวย บอล ไฮโล ขอบเขตของข้อความไม่มีขั้นต่ำ และเงื่อนไขการใช้บริการ`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ศึกษากติกาและรูปแบบการเดิมพันก่อนใช้เงินจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});

// คลาสปุ่มสามขั้วของหน้านี้ ประกาศครั้งเดียวแล้วใช้ซ้ำ เพื่อไม่ให้สองปุ่มที่ทำ
// หน้าที่เดียวกันหลุดไปคนละเฉดตอนรีแบรนด์รอบหน้า
const ctaPrimary =
  "flex items-center justify-center rounded-full border border-[#35a043] bg-gradient-to-b from-[#0e5424] via-[#1e7033] to-[#23823a] px-8 py-3 font-black text-white shadow-[0_6px_18px_rgba(1,13,4,0.5)] transition-transform hover:scale-105";

const ctaSecondary =
  "flex items-center justify-center rounded-full border border-[#35a043] bg-gradient-to-b from-[#0e5424] to-[#073c1a] px-8 py-3 font-bold text-[#eef7f0] shadow-[0_6px_18px_rgba(1,13,4,0.45)] transition-transform hover:scale-105";

const ctaQuiet =
  "flex items-center justify-center rounded-full border-2 border-[#3ddc4a] bg-[#031b09] px-8 py-3 font-bold text-[#3ddc4a] shadow-[0_4px_14px_rgba(1,13,4,0.45)] transition-all hover:scale-105 hover:bg-[#073c1a] hover:shadow-[0_6px_18px_rgba(61,220,74,0.25)]";

const listChip = "mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#1e7033] bg-[#0e5424] text-sm";

const gameCard = "mx-auto block h-auto w-full max-w-[600px] rounded-2xl border border-[#1e7033]";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#e8c86a]">{BRAND_NAME} นำเสนอข้อมูลเกมคาสิโนออนไลน์หลากหลายประเภท ทั้งบาคาร่า สล็อตออนไลน์ หวยออนไลน์ เดิมพันฟุตบอล และไฮโล</strong>
        หน้านี้ไม่ได้ทำหน้าที่ไล่เรียงรายการเกม แต่รวบรวมไว้ว่าควรอ่านอะไรก่อนกดเริ่มเกมสักเกม และควรตรวจอะไรซ้ำทุกครั้งที่กลับเข้ามาใหม่
      </p>

      <p>
        เว็บไซต์ระบุตัวเองว่าเป็นเกมคาสิโนสายตรง รวมเกมเดิมพันออนไลน์ ถูกลิขสิทธิ์ และไม่ผ่านเว็บตัวแทน ขณะเดียวกัน
        <strong class="text-[#e8c86a]">คำกล่าวอ้างเกี่ยวกับการเป็นคาสิโนสายตรงหรือเกมถูกลิขสิทธิ์ ควรตรวจสอบข้อมูลบริษัทและหลักฐานการได้รับอนุญาตจากแหล่งที่เชื่อถือได้ก่อนใช้งาน</strong>
        เพราะข้อความโฆษณาเพียงอย่างเดียวยังไม่ใช่หลักฐาน
      </p>

      <p>
        <strong class="text-[#e8c86a]">ข้อมูลที่เว็บไซต์ระบุไว้ไม่ได้กล่าวถึงการเปิดให้เล่นโดยไม่ใช้เงินจริงไว้แต่อย่างใด</strong>
        หน้านี้จึงไม่ยืนยันว่ามีรูปแบบนั้นให้ใช้งาน และควรตรวจสอบจากประกาศล่าสุดของเว็บไซต์ทางการเองว่าเกมใดเปิดให้ศึกษาได้ในลักษณะใด เนื้อหาด้านล่างเขียนไว้ประกอบการใช้งานเท่านั้น ไม่ได้ใช้แทนเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้บริการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="บาคาร่า สล็อต หวย บอล ไฮโล ห้าหมวดที่ต่างกันทั้งกติกาและอัตราจ่าย" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        ห้าหมวดที่เว็บไซต์ระบุไว้ไม่ได้เล่นแบบเดียวกัน
        <strong class="text-[#e8c86a]">แต่ละประเภทมีรูปแบบการเดิมพันและอัตราจ่ายแตกต่างกัน</strong>
        การย้ายจากหมวดหนึ่งไปอีกหมวดจึงเท่ากับเริ่มอ่านกติกาใหม่ทั้งชุด ไม่ใช่เปลี่ยนแค่หน้าจอ รายการด้านล่างสรุปไว้ว่าควรมองหาอะไรก่อนเริ่ม โดยไม่ระบุจำนวนเกมหรือชื่อค่าย เพราะข้อมูลนั้นต้องดูจากหน้ารายการจริงของเว็บไซต์เท่านั้น
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={popularGamesImage}
          alt="การ์ดภาพประกอบตกแต่ง เป็นภาพกระต่ายการ์ตูนกับแมวการ์ตูนสวมแว่นกันแดดและหูฟัง ยืนขนาบข้างหีบสมบัติที่มีเหรียญทองล้นออกมา มีเหรียญกลมลายโพดำลอยอยู่รอบ ฉากหลังเป็นวงแหวนเรืองแสง และมีข้อความ POPULAR GAME ตัวหนาสีทองอยู่กลางภาพ"
          loading="lazy"
          fetchpriority="low"
          decoding="async"
          widths={[300, 600]}
          sizes="(max-width: 639px) 100vw, 600px"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={62}
          class={gameCard}
        />

        <Picture
          src={newGamesImage}
          alt="การ์ดภาพประกอบตกแต่ง เป็นภาพตัวละครหัวฟักทองสวมหมวกปีกกว้างกับโครงกระดูกการ์ตูนยืนขนาบข้างบนลานกระเบื้องเรืองแสง มีอัญมณีสีสด ดาวสีเหลือง และลูกบาศก์สีชมพูกระจายอยู่ และมีข้อความ New Game ตัวหนาสีขาวอยู่กลางภาพ"
          loading="lazy"
          fetchpriority="low"
          decoding="async"
          widths={[300, 600]}
          sizes="(max-width: 639px) 100vw, 600px"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={62}
          class={gameCard}
        />
      </div>

      <ul class="flex flex-col gap-4" aria-label="สิ่งที่ควรอ่านก่อนเริ่มเกมแต่ละหมวด">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🃏</span>
          <span>
            <strong class="text-[#e8c86a]">กติกาและรูปแบบการเดิมพันของหมวดนั้น</strong> คือจุดแรกที่ควรอ่าน บาคาร่ากับไฮโลตัดสินผลคนละแบบ สล็อตนับรอบคนละแบบ ส่วนบอลและหวยผูกกับรายการที่เปิดรับคนละชุด ไม่มีกติกากลางที่ใช้ได้กับทั้งห้าหมวด
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎯</span>
          <span>
            <strong class="text-[#e8c86a]">วงเงินเดิมพันขั้นต่ำและสูงสุดของเกมนั้น</strong> ควรตรวจก่อนกดยืนยันทุกครั้ง เพราะเป็นค่าที่ผูกกับเกมแต่ละเกม ไม่ใช่ค่ากลางของทั้งเว็บไซต์ และอาจเปลี่ยนได้ตามประกาศ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📜</span>
          <span>
            <strong class="text-[#e8c86a]">ข้อกำหนดการถอนเงินและเงื่อนไขการใช้บริการ</strong> คือเอกสารที่ใช้ประกอบการพิจารณาร่วมกับกติกาของเกม จึงควรอ่านให้จบก่อนทำรายการ ไม่ใช่อ่านตอนเกิดข้อสงสัยแล้ว
          </span>
        </li>
      </ul>
    </div>
  </ContentBox>

  <ContentBox title="ข้อมูลค่ายผู้พัฒนาและผู้ให้บริการ จุดที่ควรตรวจก่อนเปิดบัญชี" as="h2">
    <div class="flex flex-col gap-5">
      <p>
        ก่อนเปิดบัญชีหรือเริ่มเดิมพัน
        <strong class="text-[#e8c86a]">ควรตรวจสอบว่าเกมที่กำลังจะเล่นมาจากผู้พัฒนารายใด และเว็บไซต์ระบุข้อมูลบริษัทผู้ให้บริการไว้ครบถ้วนหรือไม่</strong>
        หน้านี้ไม่ได้ระบุชื่อค่ายหรือจำนวนผู้ให้บริการไว้เอง เพราะข้อมูลที่ระบุมาไม่ได้บอกไว้ และสิ่งที่เปิดใช้งานจริงต้องอ่านจากหน้ารายการของเว็บไซต์ในขณะนั้น
      </p>

      <p>
        เหตุผลตรงไปตรงมา คือ
        <strong class="text-[#e8c86a]">แม้เว็บไซต์จะระบุว่าจ่ายเต็มและไม่มีโกง แต่ควรตรวจสอบหลักฐานการดำเนินงานและเงื่อนไขการจ่ายรางวัลให้ชัดเจน เพราะไม่สามารถรับประกันความน่าเชื่อถือหรือผลตอบแทนจากข้อความโฆษณาเพียงอย่างเดียว</strong>
        นอกจากนี้ควรอ่านนโยบายคุ้มครองข้อมูลส่วนบุคคลและข้อกำหนดทางกฎหมายที่เกี่ยวข้องก่อนใช้งาน แล้วถือเอาสิ่งที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้บริการเป็นข้อมูลที่ใช้จริง ไม่ใช่สิ่งที่จำไว้จากครั้งก่อน
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/about-us" aria-label={`อ่านข้อมูลเกี่ยวกับ ${BRAND_NAME}`} class={ctaQuiet}>อ่านข้อมูลเกี่ยวกับเรา</a>

        <a href="/terms" aria-label={`อ่านเงื่อนไขและข้อตกลงของ ${BRAND_NAME}`} class={ctaQuiet}>อ่านเงื่อนไขและข้อตกลง</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="ข้อความไม่มีขั้นต่ำ ครอบคลุมถึงอะไร และควรอ่านอะไรเพิ่ม" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        เว็บไซต์ระบุว่าสมัครสมาชิกได้โดยไม่มีขั้นต่ำ และอธิบายการเปิดบัญชีไว้เป็น 3 ขั้นตอน สิ่งที่ข้อความนั้นยังไม่ได้ตอบคือขอบเขตของคำว่าไม่มีขั้นต่ำ
        <strong class="text-[#e8c86a]">ควรตรวจสอบว่าข้อความไม่มีขั้นต่ำครอบคลุมเฉพาะการสมัครหรือรวมถึงการฝากเงินและการเดิมพันด้วย</strong>
        รายการด้านล่างคือลำดับที่เปิดอ่านได้เร็วที่สุดก่อนเริ่มใช้งานครั้งแรก
      </p>

      <ol class="ml-6 list-decimal space-y-3 marker:font-black marker:text-[#3ddc4a]">
        <li>
          <strong class="text-[#e8c86a]">ขอบเขตของข้อความไม่มีขั้นต่ำ</strong> อ่านจากหน้าของเกมนั้นเองตรงกว่าการจำข้อความรวมจากหน้าแรก เพราะแต่ละเกมอาจกำหนดยอดที่รับไว้คนละชุด
        </li>
        <li>
          <strong class="text-[#e8c86a]">ข้อกำหนดด้านอายุและกฎหมายที่เกี่ยวข้อง</strong> ควรอ่านก่อนดำเนินการสมัคร พร้อมกับนโยบายความเป็นส่วนตัวของเว็บไซต์ ไม่ใช่อ่านย้อนหลังหลังเปิดบัญชีแล้ว
        </li>
        <li>
          <strong class="text-[#e8c86a]">ความปลอดภัยของบัญชีตั้งแต่วันแรก</strong> ตั้งรหัสผ่านที่คาดเดาได้ยาก ไม่ใช้ข้อมูลของบุคคลอื่นเปิดบัญชี และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้ใครทราบไม่ว่ากรณีใด
        </li>
        <li>
          <strong class="text-[#e8c86a]">เงื่อนไขของโปรโมชั่นที่กำลังเปิดอยู่</strong> อาจกำหนดประเภทเกม ยอดที่นำมาคำนวณ และข้อจำกัดการถอนเงินแตกต่างกัน จึงควรตรวจสอบประกาศล่าสุดก่อนเข้าร่วมทุกครั้ง
        </li>
      </ol>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/register" aria-label={`สมัครสมาชิก ${BRAND_NAME}`} class={ctaPrimary}>สมัครสมาชิก</a>

        <a href="/login" aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`} class={ctaSecondary}>เข้าสู่ระบบ</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="สิ่งที่ควรตรวจซ้ำทุกครั้งก่อนเดิมพันด้วยเงินจริง" as="h2">
    <div class="flex flex-col gap-5">
      <p>
        นอกจากกติกาของเกมและเงื่อนไขการใช้บริการแล้ว
