---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import popularGamesImage from "../assets/gamedemo8.webp";
import newGamesImage from "../assets/gamedemo16.webp";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริง
// ของบรีฟรอบนี้เท่านั้น (src/assets/content.txt) ไม่ใช่แก้ทับประโยคของแบรนด์ก่อน
// — ย่อหน้าเก่าทั้งหน้าตั้งอยู่บนคำที่ brand-spec §7 สั่งห้าม (เป็นคอปปี้ของเว็บ
// สล็อตล้วน) จึงต้องเขียนใหม่ ไม่ใช่ find-and-replace
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// ดรอปนี้ (2026-10-11) คือ **UFA324 เว็บเล่นเกมกีฬาออนไลน์** — ฟุตบอล มวย และ
// เกมคาสิโน (เกมไพ่ เกมโต๊ะ สล็อต) **ไม่ใช่เว็บสล็อตล้วน** แบบแบรนด์ก่อน และไม่ใช่
// เว็บของหมวดลอตเตอรี (สองหน้าของหมวดนั้นจอดอยู่ใน src/pages-disabled/ ไม่มี route ห้ามลิงก์ไปหา
// เป็น href ตายที่ทำให้ build แดง) แง่มุมที่บรีฟระบุไว้มีเท่านี้:
// รวมหมวดเดิมพันกีฬาและเกมคาสิโนไว้ในระบบเดียว · ฟุตบอลมีข้อมูลคู่แข่งขัน ประเภท
// การเดิมพัน และอัตราต่อรอง · มวยมีรายการแข่งขันและรูปแบบการเดิมพันตามที่ผู้ให้บริการ
// เปิดให้บริการ · หมวดเกมคาสิโนมีเกมไพ่ เกมโต๊ะ และสล็อตจากค่ายต่างๆ โดยจำนวนรายการ
// จริงขึ้นอยู่กับระบบที่เปิดใช้งาน · ควรตรวจสอบกติกา อัตราจ่าย และเงื่อนไขการตัดสินผล ·
// อัตราต่อรองอาจเปลี่ยนแปลงตามช่วงเวลา · ไม่มีการเดิมพันประเภทใดรับประกันผลตอบแทน ·
// เมนูจัดการบัญชีและติดตามรายการ · คืนยอดเสีย 0.3% เข้ายูสทุกวัน รอบคำนวณ เวลาตัดรอบ ·
// แนะนำเพื่อน ลิงก์แนะนำ โบนัส 0.8% · ฝากถอน ช่องทางชำระเงิน สถานะรายการ ชื่อบัญชี
// ผู้รับเงิน ระยะเวลาดำเนินการ · แอดมิน 24 ชั่วโมง ช่องทางติดต่อหลัก · หมายเลขรายการ ·
// รหัสผ่าน PIN OTP
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามี "โหมดทดลอง" เครดิตทดลอง หรือเดโมฟรีเป็นบริการของเว็บ —
// จึงห้ามสัญญาสินค้าตัวนั้น คำว่า "ทดลองเล่น" บนหน้านี้จึงหมายถึงสิ่งที่บรีฟระบุไว้
// ตรงๆ ว่าทำได้: เปิดเว็บไล่ดูหมวดกีฬาและหมวดเกมคาสิโนให้ครบหนึ่งรอบ ค้นหาประเภท
// กีฬา ตรวจสอบรายละเอียดการแข่งขัน อ่านกติกากับอัตราจ่าย แล้วจึงเริ่มเดิมพันจริง
//
// ⚠️ รูปในหน้านี้ใช้ได้แค่ gamedemo8 กับ gamedemo16 เท่านั้น — เป็นอาร์ตสต็อกกลาง
// ของเทมเพลต (mtime 2026-08-04) ไม่ใช่อาร์ตเวิร์กของแบรนด์นี้ จึงอยู่ต่อได้ แต่ alt
// ต้องบรรยายภาพจริง และห้ามเอ่ยชื่อแบรนด์ใด เพราะไม่มีชื่อแบรนด์ไหนปรากฏอยู่บนรูป
// ทั้งสองใบ ส่วน gamedemo7/9/10/11/12/14/15/17/18 มีโลโก้หรือชื่อของผู้ให้บริการ
// เจ้าอื่นพิมพ์ทับอยู่กลางรูป และ gamedemo13 เป็นภาพล่อแหลม — ห้ามนำกลับมาใช้
// เพราะเท่ากับอ้างชื่อที่บรีฟไม่ได้เอ่ย ไฟล์ยังอยู่บนดิสก์ ห้ามลบ เป็นอินเวนทอรี
// gamedemo8 ("POPULAR GAME" 600x379) กับ gamedemo16 ("New Game" 650x411) ความกว้าง
// ที่วาดจริงสูงสุด ~600px ต่อใบ (กริดสองคอลัมน์ในการ์ด) จึงไม่ขยายเกินต้นฉบับ
// quality={62} ของสองใบนี้ตั้งไว้ต่ำกว่าค่าปกติ 80 มาตั้งแต่รอบก่อน เพราะอาร์ตมีเกรน
// ละเอียดจนไฟล์ AVIF เคยโตกว่า WebP ของตัวเอง (verify-build จะแดง) ห้ามดันกลับขึ้น
//
// ⚠️ คำที่ห้ามหลงเหลือ: คำขายของของแบรนด์ก่อนๆ และศัพท์เว็บสล็อตล้วนที่บรีฟรอบนี้
// ไม่ได้เอ่ย — รายการเต็มอยู่ใน brand-spec §7 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หา
// คำต้องห้ามเจอ false positive รายการตรวจก่อนเริ่มเดิมพัน (<ol> ด้านล่าง) รอบนี้
// เขียนใหม่ทั้งสี่ข้อให้อ้างเฉพาะสิ่งที่บรีฟพูดถึงจริง
//
// ⚠️ ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 24 ชั่วโมง
// ห้ามเติมเลขใบอนุญาต หน่วยงานกำกับ ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP ยอดฝากขั้นต่ำ
// จำนวนสมาชิก ปีที่ก่อตั้ง หรือชื่อลีก/ทีม/นักมวย เพราะบรีฟไม่ได้เอ่ยไว้สักอย่าง
//
// ประโยคกำกับของบรีฟที่ห้ามตัดทิ้ง (เป็นส่วนหนึ่งของคอปปี้ ไม่ใช่ filler):
// ควรมีข้อมูลผู้ให้บริการและระบบเกมที่สามารถตรวจสอบได้ เพื่อประกอบการพิจารณา ·
// อัตราต่อรองอาจเปลี่ยนแปลงตามช่วงเวลา · ไม่มีการเดิมพันประเภทใดรับประกันผลตอบแทน
// จึงควรกำหนดวงเงินและพิจารณาความเสี่ยง · ควรตรวจสอบว่าโปรโมชั่นครอบคลุมเฉพาะ
// เกมสล็อตหรือรวมกีฬาและคาสิโนด้วย · คำว่าไม่จำกัดควรระบุให้ชัดว่าหมายถึงอะไร ·
// ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น แม้จะอ้างว่าเป็นเจ้าหน้าที่
//
// banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion · banner2/banner3 และ
// slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import (ลำพังการ import ก็ทำให้
// ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น Announcement2 ทั้งเว็บ (รอบก่อนใช้ Announcement4 —
// brand-spec §3 หมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้
// ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่ง
// จะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ทองแชมเปี้ยน นำ เงินโครเมียม รอง บนพื้นดำสนิท**
// พลิกทิศจากคู่ "ชมพูบานเย็น-ทอง บนพื้นม่วงพลัม" ของแบรนด์ก่อน ซึ่งออกครบทุกจุดแล้ว
// ทั้งคลาส Tailwind raw hex และ rgba() (ค่าเดิมอยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive) รอบนี้ไม่มีชมพูเป็นฮิวเลย และ
// bg.json เป็น {"mode":"color","color":"#000000"} จึง **ไม่มีชั้นที่ลึกกว่าพื้นเพจ**
// ลำดับปุ่มสื่อด้วยขั้ว "ทองถม vs ผิวจมขอบทอง": ปุ่มหลักถมทองไล่เฉด #ffe08a →
// #e5a81b → #bb8410 ขอบ #7d5a07 หมึกดำน้ำตาล #140d01 · ปุ่มรองและปุ่มลิงก์ภายใน
// เป็นผิวจม #17130a → #0d0b06 ขอบทอง #e5a81b/50 ตัวอักษรทองแบรนด์ #e5a81b
// · ขอบรูปใช้ทองแบบโปร่ง · marker ของลำดับเลขใช้ทองแบรนด์ #e5a81b
// ⚠️ ห้ามกลับด้าน: พื้นถมทองต้องใช้หมึกเข้มเสมอ ห้ามขาวหรือทองอ่อน และห้ามให้
// ไล่เฉดทองที่รองหมึกจบเข้มกว่า #bb8410 — #7d5a07 / #43300a / #464f5a เป็นเส้น
// ขอบ และออราเท่านั้น ห้ามถือตัวอักษรทุกขนาด
// ⚠️ "ทอง" ไม่ใช่ตัวบอกว่าถูกแบรนด์: เจ็ดในสิบแบรนด์หลังสุดก็มีทอง ให้เทียบเป็นค่า
// ทีละตัวกับตารางใน brand-spec §2 (ค่าเดิมไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสี
// แบรนด์เก่าเจอ false positive)
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #f0e8d4)
// ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง ปล่อยให้สืบทอดลงมา
// — มีแค่ปุ่ม ขอบรูป marker ของลำดับเลข และ <strong> ที่ประกาศสี โดย <strong>
// ใช้ทองไฮไลต์ #ffcf5e ตัวเดียว (11.6:1 บนผิวการ์ด) และแต่ละ <strong> ครอบ
// "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิด
// แท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 158 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} ไล่ดูหมวดเดิมพันฟุตบอล มวย และเกมคาสิโนให้ครบหนึ่งรอบ ตรวจสอบกติกา อัตราต่อรอง อัตราจ่าย และเงื่อนไขการตัดสินผลของแต่ละรายการก่อนเริ่มเดิมพัน`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} เว็บเล่นเกมกีฬาออนไลน์ ไล่ดูหมวดเดิมพันก่อนเริ่มเล่นจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#ffcf5e]">{BRAND_NAME}</strong> คือเว็บเล่นเกมกีฬาออนไลน์ที่นำเสนอทางเข้าเดิมพันหลายประเภทไว้ในแพลตฟอร์มเดียว
        <strong class="text-[#ffcf5e]">ทั้งฟุตบอล มวย และเกมคาสิโน โดยเข้าใช้งานได้ทั้งจากมือถือและคอมพิวเตอร์</strong>
        หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับระบบได้ไล่ดูให้ครบหนึ่งรอบ ตั้งแต่การค้นหาประเภทกีฬาและตรวจสอบรายละเอียดการแข่งขัน ไปจนถึงเมนูจัดการบัญชีและการติดตามรายการต่างๆ ก่อนจะเริ่มเดิมพันจริง
      </p>

      <p>
        คำว่า ทดลองเล่น ที่หน้านี้พูดถึงจึงหมายถึง
        <strong class="text-[#ffcf5e]">การเปิดเว็บไซต์ไล่ดูหมวดกีฬาและหมวดเกมคาสิโนที่จัดไว้ เลือกคู่แข่งขันที่สนใจ แล้วอ่านประเภทการเดิมพัน อัตราต่อรอง และเงื่อนไขการตัดสินผลให้จบ</strong>
        ซึ่งเป็นสิ่งที่ระบบเปิดให้ทำได้อยู่แล้ว ไม่ใช่การแจกเครดิตทดลอง และไม่ใช่การรับประกันผลของรายการใดรายการหนึ่ง เพราะไม่มีการเดิมพันประเภทใดรับประกันผลตอบแทน
      </p>

      <p>
        อีกเรื่องที่ควรไล่ดูไปพร้อมกันคือขอบเขตของสิ่งที่เปิดให้บริการจริง
        <strong class="text-[#ffcf5e]">เพราะการระบุว่าเป็นฐานเกมแท้ ควรมีข้อมูลผู้ให้บริการและระบบเกมที่สามารถตรวจสอบได้ เพื่อประกอบการพิจารณาก่อนใช้งาน</strong>
        ส่วนจำนวนรายการที่เปิดให้บริการจริงขึ้นอยู่กับระบบที่เปิดใช้งานและเปลี่ยนแปลงได้ตามช่วงเวลา การไล่ดูด้วยตัวเองหนึ่งรอบจึงให้ข้อมูลตรงกว่าค่าที่จำไว้จากรอบก่อนหน้า
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`หมวดเดิมพันที่ ${BRAND_NAME} รวมไว้ในระบบเดียว`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        หลังเข้าสู่ระบบ ลำดับการใช้งานจะเป็นชุดเดียวกันทุกครั้ง
        <strong class="text-[#ffcf5e]">
