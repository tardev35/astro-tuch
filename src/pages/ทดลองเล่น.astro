---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login, /register)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อของ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริง
// ของ MAHAGAME66 เท่านั้น
//
// รอบก่อน (888PARUAY) เป็น **เว็บหวยล้วน** คอปปี้เดิมทั้งหน้าพูดถึงหวยรัฐบาลไทย
// ฮานอย ลาวพัฒนา หุ้นต่างประเทศ และอัตราจ่าย 2 ตัว 100 / 3 ตัว 1,000 ซึ่งบรีฟรอบนี้
// ไม่ได้ระบุไว้เลย — หน้านี้จึงถูกเขียนใหม่ทั้งหน้า ห้าม find-and-replace ชื่อแบรนด์
// ทับของเดิม มันจะทำให้ MAHAGAME66 อ้างอัตราจ่ายและรายการหวยที่บรีฟไม่เคยระบุ
//
// บรีฟไม่ได้ระบุว่ามี "เครดิตทดลอง" หรือโหมดเดโมที่ถอนไม่ได้ สิ่งที่บรีฟระบุคือ
// "เมนูจัดหมวดหมู่ชัดเจน" "รองรับมือถือและคอมพิวเตอร์" และ "ตรวจสอบค่ายเกม
// รายละเอียดโต๊ะ และรูปแบบเดิมพันก่อนเข้าเล่น" — หน้านี้จึงเขียนบนฐานนั้น คือการ
// ไล่ดูหมวดเกมและรูปแบบเดิมพันให้ครบก่อนเดิมพันด้วยเงินจริง ห้ามอ้างกติกาของเครดิต
// ทดลองหรือโหมดเล่นฟรี
//
// ข้อเท็จจริงทุกบรรทัดมาจาก brand-spec §4 เท่านั้น: บาคาร่า · สล็อต · หวย · บอล ·
// รูเล็ต · หมวดเกมไลฟ์สด · เชื่อมต่อจากผู้ให้บริการตามข้อมูลของเว็บไซต์ · ตรวจสอบ
// ค่ายเกม รายละเอียดโต๊ะ รูปแบบเดิมพันก่อนเข้าเล่น · โบนัสแนะนำเพื่อน 0.8% ·
// โบนัสคืนยอดเสีย 0.3% · ตรวจสอบยอดที่เข้าเกณฑ์ รอบรับสิทธิ์ และเงื่อนไขก่อนกดรับ ·
// ฝากถอนผ่านวอลเลทและธนาคาร · ตรวจสอบยอดและสถานะรายการผ่านบัญชี · รองรับมือถือและ
// คอมพิวเตอร์ · เมนูจัดหมวดหมู่ชัดเจน · บัญชีเดียว · แอดมิน 24 ชั่วโมง
// — ห้ามอ้างชื่อค่ายเกม ชื่อเกมเฉพาะ เลขใบอนุญาต ปีที่ก่อตั้ง จำนวนสมาชิก ค่า RTP
// ขั้นต่ำการเดิมพัน ชื่อธนาคารเจาะจง "ฝากถอนไม่มีขั้นต่ำ" "ออโต้ 10 วินาที" หรือ
// การันตีว่าจะชนะ
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: แกลเลอรีเดโม 12 การ์ด (gamedemo7..18.webp) ยังอยู่
// บนดิสก์แต่เป็นของแบรนด์อื่น (mtime 2026-08-04 ไม่ใช่ดรอปรอบนี้) — gamedemo7.webp
// มีโลโก้ "askmeslot" และ gamedemo15.webp มีโลโก้ "askmebet" ของเว็บเจ้าอื่น
// พิมพ์ทับอยู่ในรูป ส่วน gamedemo13.webp เป็นการ์ด "Sexy Slot" ภาพโป๊เปลือย
// ห้ามนำกลับมา import เด็ดขาด (ห้ามลบไฟล์ เป็นอินเวนทอรี) ลำพังการ import ก็ทำให้
// ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง
// slide1.png / slide2.png ของดรอปนี้เป็นของ index และ /promotion — ไม่ดึงมาใช้ซ้ำที่นี่
// banner1/banner1-mobile เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า และ
// banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กค้างของลูกค้าเจ้าอื่น ห้าม import
//
// Announcement รอบนี้หมุนจาก Announcement3 มาเป็น Announcement5 ทั้งเว็บ —
// default message ของไฟล์นั้นถูกตั้งเป็นคอปปี้ของ MAHAGAME66 แล้ว จึงเรียกแบบ bare
// เหมือน index.astro ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ MAHAGAME66 (แดง + ดำ + เงินโครเมียม): พื้น #080506 · การ์ด #16090a ·
// การ์ดยก #26100f · แดงแบรนด์ #de161d · แดงสว่าง #ff4d52 · แดงลึก #7a0a0e ·
// เงินโครเมียม #e2e8ef · เงินหม่น #9ba3ad · เนื้อความ #e8e3e1 (BRAND_TEXT) ·
// เน้นใน strong #fff6f5 — ชุดทอง-เขียว-ครีมของ 888PARUAY (#fcdc2b #fff6ae #a87d0c
// #1fae1c #0c4402 #07130a #0d2312 #143a1c #cf1111 #8a0303 #e8e4c6 #fffdf0)
// ออกครบทุกจุดแล้ว ห้ามนำกลับมา
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลางที่ orchestrator รีธีมรอบนี้) — เนื้อความ
// ในการ์ดจึงไม่ระบุสีของตัวเองเลย ให้สืบทอดสีจากการ์ด มีเพียงปุ่ม หมายเลขลำดับ และ
// ไอคอนเท่านั้นที่ถือสีของพาเลตต์
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 159
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "ทดลองเล่น MAHAGAME66 ไล่ดูหมวดบาคาร่า สล็อต หวย บอล รูเล็ต และเกมไลฟ์สด ตรวจสอบค่ายเกม รายละเอียดโต๊ะ และรูปแบบเดิมพันจากบัญชีเดียวก่อนเริ่มเดิมพันด้วยเงินจริง";

const pageTitle = "ทดลองเล่น MAHAGAME66 ไล่ดูหมวดเกมและรูปแบบเดิมพันก่อนเล่นจริง";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        <strong>MAHAGAME66</strong> รวมเกมพนันออนไลน์หลายประเภทไว้ในระบบเดียว ทั้งบาคาร่า สล็อต หวย บอล และรูเล็ต พร้อมหมวดเกมไลฟ์สดตามรายการที่เปิดให้บริการ หน้านี้จึงเปิดไว้ให้คนที่ยังไม่คุ้นกับระบบได้
        <strong>ไล่ดูหมวดเกม ค่ายเกมที่รองรับ รายละเอียดโต๊ะ และรูปแบบเดิมพันให้ครบก่อนเดิมพันด้วยเงินจริง</strong>
        ตั้งแต่โครงของเมนูหน้าแรก ไปจนถึงข้อมูลที่ระบบแสดงไว้ในแต่ละรายการ
      </p>

      <p class="text-left text-base leading-relaxed">
        เพราะ<strong>เมนูถูกจัดหมวดหมู่ไว้ชัดเจนและรองรับการใช้งานทั้งบนมือถือและคอมพิวเตอร์</strong>
        การเปิดดูให้ทั่วก่อนจึงช่วยให้เห็นว่าเกมแต่ละประเภทอยู่ตรงไหน และรู้ล่วงหน้าว่าต้องตรวจข้อมูลอะไรบ้างก่อนกดเข้าเล่นครั้งแรกจากบัญชีเดียว
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ไล่ดูหมวดเกมของ MAHAGAME66 ให้ครบก่อนเลือกโต๊ะแรก" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        จุดที่ช่วยให้เริ่มต้นได้เร็วที่สุดคือ<strong>ทุกประเภทเกมถูกรวมไว้ในบัญชีเดียว</strong>
        สมาชิกเลือกหมวดที่สนใจได้จากเมนูหน้าแรก ดูรายการที่เปิดให้บริการอยู่ แล้วเปิดรายละเอียดของเกมนั้นต่อได้ทันที ไม่ต้องสลับไปใช้หลายเว็บไซต์เพื่อไล่หาว่าเกมที่อยากเล่นอยู่ที่ไหน
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed">
        <li class="flex gap-3">
          <span class="font-bold text-[#de161d]">1.</span>
          <span><strong>เปิดหน้าแรกของ MAHAGAME66 ก่อน</strong> เมนูจัดหมวดหมู่ไว้ให้เลือกจากหน้าเดียว จึงเห็นภาพรวมของรายการที่เปิดให้เลือกได้ตั้งแต่หน้าแรก</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#de161d]">2.</span>
          <span>
            <strong>ไล่ดูหมวดหลักให้ครบทั้งห้าประเภท</strong> ทั้งบาคาร่า สล็อต หวย บอล และรูเล็ต แต่ละหมวดมีรูปแบบเดิมพันและรายละเอียดของตัวเองตามที่ระบบแสดงไว้
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#de161d]">3.</span>
          <span>
            <strong>เปิดหมวดเกมไลฟ์สดดูเพิ่ม</strong> หมวดนี้เชื่อมต่อจากผู้ให้บริการตามข้อมูลของเว็บไซต์ รายการที่เปิดอยู่จึงเป็นคนละชุดกับเกมในหมวดปกติ ควรเปิดดูไว้ก่อนสักรอบ
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#de161d]">4.</span>
          <span>
            <strong>ตรวจสอบค่ายเกม รายละเอียดโต๊ะ และรูปแบบเดิมพันก่อนเข้าเล่น</strong> ข้อมูลชุดนี้ถูกแสดงไว้ให้ดูตั้งแต่ก่อนกดเข้าเกม อ่านให้จบก่อนตัดสินใจว่าจะเลือกโต๊ะหรือรายการไหน
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#de161d]">5.</span>
          <span>
            <strong>ลองเปิดจากเครื่องที่จะใช้จริงอีกครั้ง</strong> ระบบรองรับทั้งมือถือและคอมพิวเตอร์จากบัญชีเดียว เปิดรายการเดียวกันเทียบกันดูก่อน แล้วเลือกอุปกรณ์ที่ใช้งานได้ถนัดกว่า
          </span>
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed">
        <strong>รายการที่เปิดให้บริการและค่ายเกมที่รองรับเปลี่ยนแปลงได้ตามช่วงเวลา จึงควรตรวจสอบหมวดเกม รายละเอียดโต๊ะ และรูปแบบเดิมพันจากหน้าเว็บไซต์ทุกครั้งก่อนเข้าเล่น</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title="จุดที่ควรดูให้ครบก่อนเดิมพันด้วยเงินจริง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        การไล่ดูระบบมีประโยชน์ที่สุดเมื่อมองมันเหมือนการอ่านคู่มือ ไม่ใช่การลุ้นรางวัล
        <strong>เป้าหมายคือรู้จักระบบให้ครบก่อนที่เงินจริงจะเข้ามาเกี่ยวข้อง</strong>
        หกเรื่องด้านล่างคือสิ่งที่ควรเก็บข้อมูลไว้ระหว่างเปิดดู
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ff4d52]">🗂️</span>
          <span>
            <strong>โครงของเมนูและตำแหน่งของแต่ละหมวด</strong> จำให้ได้ว่าหมวดบาคาร่า สล็อต หวย บอล และรูเล็ตอยู่ตรงไหน และสลับระหว่างกันได้จากจุดใด จะได้ไม่ต้องหาใหม่ทุกครั้งที่อยากเปลี่ยนเกม
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ff4d52]">🃏</span>
          <span>
            <strong>รายละเอียดโต๊ะและรูปแบบเดิมพันของแต่ละรายการ</strong> ระบบแสดงข้อมูลชุดนี้ไว้ก่อนเข้าเล่น เปิดอ่านเทียบกันหลายรายการดูก่อน จะได้เห็นว่ารูปแบบไหนตรงกับที่ตัวเองสนใจ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ff4d52]">📺</span>
          <span>
            <strong>หมวดเกมไลฟ์สดที่เปิดอยู่ในรอบนั้น</strong> หมวดนี้เชื่อมต่อจากผู้ให้บริการตามข้อมูลของเว็บไซต์ รายการจึงไม่เท่ากันทุกช่วงเวลา ควรเปิดตรวจสอบอีกครั้งก่อนเลือกเข้าโต๊ะ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ff4d52]">🎁</span>
          <span>
            <strong>เงื่อนไขของโปรโมชั่นที่กำลังเปิดรับสิทธิ์</strong> ทั้งโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% ระบบแสดงยอดที่เข้าเกณฑ์ รอบรับสิทธิ์ และเงื่อนไขไว้ให้ตรวจสอบก่อนกดรับทุกครั้ง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ff4d52]">💳</span>
          <span>
            <strong>ช่องทางฝากถอนที่จะใช้จริง</strong> ระบบรองรับวอลเลทและธนาคารตามรายการที่เว็บไซต์เปิดให้ใช้งาน ลองเปิดดูไว้ก่อนว่าตรวจสอบยอดและสถานะรายการผ่านบัญชีได้จากหน้าไหน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ff4d52]">📱</span>
          <span><strong>อุปกรณ์ที่จะใช้ทำรายการจริง</strong> ระบบรองรับทั้งมือถือและคอมพิวเตอร์ ลองเปิดรายการเดียวกันจากเครื่องที่จะใช้จริงดูก่อน แล้วเลือกอุปกรณ์ที่กดเดิมพันและตรวจยอดได้ถนัดกว่า</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed">
        <strong>ผลของเกมทุกประเภทตัดสินจากรอบนั้น ไม่มีสูตร ไม่มีโต๊ะ และไม่มีช่วงเวลาไหนที่รับประกันว่าจะชนะ</strong>
