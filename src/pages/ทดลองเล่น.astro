---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement4.astro";

import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login,
// /register หรือหน้าภาพแบบ /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง
// ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้
// (src/assets/content.txt) ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่จาก
// ข้อเท็จจริงและคลังคำของบรีฟรอบนี้เท่านั้น (.claude/brand-spec-moobin168.md §4-§5)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x4 · h3x0
//   h1  ทดลองเล่น <แบรนด์> ศึกษากติกาเกมสล็อตก่อนเดิมพันด้วยเงินจริง
//   h2  กติกาเกมสล็อต แนวจ่ายรางวัล และรอบโบนัสที่ควรอ่านก่อนลงเงิน
//   h2  เงื่อนไขโบนัสฝาก คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ที่ควรตรวจก่อนรับสิทธิ์
//   h2  สมัครสมาชิก <แบรนด์> 3 ขั้นตอน ก่อนเข้าตรวจรายละเอียดเกม
//   h2  ฝากถอนทุกธนาคารและทรูมันนี่ กับช่องทางติดต่อแอดมิน 24ชม.
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// 🚨🚨 **คำว่า "ทดลองเล่น" อยู่ได้เฉพาะเพราะเป็นชื่อ route /ทดลองเล่น และชื่อเมนู
// จริง** (ใช้ใน h1 · title · description · breadcrumb) แต่ **บรีฟรอบนี้ไม่ได้
// พูดถึงโหมดเล่นโดยไม่ใช้เงินจริงเลยแม้แต่ประโยคเดียว** → **ห้ามอ้างว่าเว็บมี
// โหมดนั้นให้** ห้ามอ้างจำนวนเกมที่เล่นได้ ห้ามอ้างค่า RTP และห้ามอ้างว่าผลที่ออก
// ในการลองสะท้อนผลจริง แกนของหน้าจึงเป็น **"สิ่งที่ควรศึกษาและตรวจสอบเกี่ยวกับ
// เกมที่ระบุไว้ ก่อนเดิมพันด้วยเงินจริง"** ตามที่บรีฟมีจริง: กติกาเกม ·
// แนวการเรียงสัญลักษณ์ · พฤติกรรมของรอบโบนัส · ยอดเดิมพันขั้นต่ำ ·
// เงื่อนไขโบนัสไม่ต้องทำเทิร์น · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% ·
// สมัคร 3 ขั้นตอน · ฝากถอนธนาคารและทรูมันนี่ · แอดมิน 24ชม. · ประกาศล่าสุด
// ⚠️ และมีหนึ่งประโยคที่พูดตรงๆ ว่าบรีฟไม่ได้ระบุโหมดนั้นไว้ เพื่อไม่ให้ผู้อ่าน
// อนุมานเอาจากชื่อเมนู — **ห้ามถอดประโยคนั้นออก**
//
// ⚠️⚠️ **ห้ามเขียนชื่อแบรนด์ด้วยตัวละตินเด็ดขาด** (brand-spec §1) — รอบนี้สะกดได้
// แบบเดียวคือค่าใน BRAND_NAME ซึ่งเป็นภาษาไทยผสมเลข ห้ามพิมพ์ตรงๆ
// ⚠️⚠️ คำนิยามตัวเองของแบรนด์ขาออกเป็น **คำค้างข้ามแบรนด์** ห้ามหลุดกลับมา
// **รายการคำต้องห้ามเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่** เพื่อไม่ให้
// sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
//
// ⚠️ **รอบนี้สองหน้าหมวดเลข/สลากถูกปิด** (อยู่ใน src/pages-disabled/ เพราะรอบนี้
// เป็นเว็บสล็อต) ลิงก์ไปสอง route นั้นจากหน้านี้จึงไม่มี — verify-build จะแดงถ้า
// href ชี้ไป route ที่ไม่มีจริง
// route ที่มีจริงรอบนี้: / · /about-us · /contact-us · /promotion · /ทดลองเล่น ·
// /ทางเข้า · /login · /register · /terms · /privacy · 404 · /line
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกม ชื่อธนาคารรายตัว ชื่อผู้ให้บริการ
// หน่วยงานกำกับ ใบอนุญาต ปีก่อตั้ง จำนวนสมาชิก จำนวนเกม ค่า RTP อัตราจ่าย
// หรือยอดขั้นต่ำที่เป็นตัวเลข แม้แต่รายการเดียว** จึงห้ามเขียนลงหน้าเว็บ ·
// ตัวเลขที่ขึ้นหน้าได้มีแค่ของบรีฟเอง: **0.3% · 0.8% · 3 ขั้นตอน · 24ชม.**
//
// 🚨 **ข้อกำกับของบรีฟที่ต้อง ship ครบบนหน้านี้** (ไม่ใช่ filler ให้ตัดทิ้ง):
// 1) คำกล่าวอ้างเรื่องเว็บตรงและเกมถูกลิขสิทธิ์ ควรตรวจสอบจากข้อมูลผู้พัฒนาและ
//    หลักฐานการได้รับอนุญาตที่เชื่อถือได้
// 2) ควรตรวจสอบว่าโบนัสประเภทใดได้รับการยกเว้นข้อกำหนดยอดเดิมพัน และมีเงื่อนไข
//    เรื่องการถอนเงินหรือวงเงินโบนัสสูงสุดหรือไม่
// 3) เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่ม
//    โอกาสชนะในครั้งต่อไป
// 4) แม้ระบุว่าไม่จำกัด แต่ควรยืนยันจำนวนบัญชีที่เข้าร่วมได้และรอบจ่ายเครดิต
// 5) ควรตรวจสอบคุณสมบัติผู้สมัคร ข้อกำหนดด้านอายุ กฎหมายที่เกี่ยวข้อง และ
//    นโยบายความเป็นส่วนตัว · ไม่ใช้ข้อมูลของบุคคลอื่น ไม่เปิดเผยรหัส OTP
// 6) ควรศึกษาวงเงินต่อรายการ จำนวนครั้งในการถอน และขั้นตอนยืนยันตัวตน ·
//    ตรวจชื่อบัญชีปลายทางก่อนโอน · พบความผิดปกติให้หยุดทำธุรกรรมและติดต่อธนาคาร
//    หรือผู้ให้บริการชำระเงินโดยเร็ว
// 7) ตรวจช่องทางติดต่อจากเว็บไซต์ทางการเพื่อเลี่ยงบัญชีแอบอ้าง · เก็บหมายเลข
//    รายการไว้เป็นหลักฐาน · ไม่เปิดเผยรหัสผ่านหรือรหัส OTP · ตรวจสอบเวลาการ
//    ให้บริการจริงจากประกาศล่าสุด
// ⚠️ บรีฟรอบนี้ **โฆษณาและกำกับในประโยคเดียวกัน** คำโฆษณาอยู่ได้เฉพาะในขอบเขตที่
// บรีฟเขียนไว้เอง ห้ามขยายเป็นคำกล่าวอ้างใหม่ และทุกประโยคกำกับต้อง ship ครบ
// ห้ามตัดเพราะฟังดูลบ
//
// 🚨 **ไม่มีรูปในหน้านี้โดยตั้งใจ** รอบนี้ไม่มี "รูปประกอบบทความ" เลย
// (banner2/banner3 เป็นอาร์ตเวิร์ก รวย168 · slide3/slide4 เป็นของอีกแบรนด์ —
// **ห้าม import ทั้งสี่ไฟล์** ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/
// ทุก build) · slide1/slide2 ถูกตรึงไว้กับ index §3-§4 กับ /promotion ·
// banner1 / banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักไว้
// **ห้ามอ้างจากหน้านี้** · ไฟล์เก่าทั้งหมดยังอยู่บนดิสก์ **ห้ามลบ**
// เป็นอินเวนทอรีของแบรนด์ถัดไป
//
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) **กลับทิศจากรอบก่อนทั้งเว็บ: จากธีมมืด
// เป็นธีมสว่าง** bg.json ของดรอปนี้คือ {"mode":"color","color":"#ffe5ff"} =
// **ชมพูพาสเทลสว่างมาก** (รอบก่อนเป็น 140000 = ดำอมแดง)
// **ห้ามเดาว่าเท่าเดิม และห้าม "แก้" การ์ด/ปุ่มกลับไปเป็นพื้นมืด** — พื้นมืดบน
// หมึก #3b0b26 = ตัวอักษรหายไปเลย ไม่ใช่แค่จางลง
// ค่าที่ใช้ได้ในไฟล์นี้: หัวข้อ/`<strong>`/marker ของลำดับเลข **#c2185b**
// (5.9:1 บนการ์ดขาว) · เข้มสุด #8e0f41 (9.2:1) · พื้นไล่เฉดปุ่มหลัก
// #c2185b -> #8e0f41 (**พื้นถม** + หมึกขาว #ffffff) · ชมพูสด #fa539c และ
// ชมพูอ่อน #fb8cc0 (**พื้นถมของปุ่มรองเท่านั้น** คู่กับหมึกพลัม #3b0b26 — 5.3:1) ·
// ผิวยก #fff0f8 · wash #ffeef7 · เส้น #f7bcd9 · เส้นเข้ม #ef8dbd
// (**ทั้งคู่ห้ามถือตัวอักษร**)
// หมึกเนื้อความคือ #3b0b26 (= BRAND_TEXT) ซึ่ง **ไม่ประกาศในไฟล์นี้** การ์ด
// ContentBox ตั้งไว้ให้แล้วและย่อหน้าสืบทอดลงมา
// 🚨🚨 **หมึกขาวบน #fa539c ได้แค่ 3.2:1 — ห้ามถมพื้น #fa539c แล้ววางหมึกขาว**
// และ **#fa539c บนพื้นขาวก็ได้แค่ 3.2:1 จึงห้ามเป็นสีตัวอักษร** พื้นชมพูที่รับ
// หมึกขาวได้ต้องเป็น **#c2185b ลงไป** เท่านั้น
// ออราที่อนุญาต: rgba(250,83,156,α) · rgba(251,140,192,α) · rgba(194,24,91,α) ·
// rgba(59,11,38,α) · rgba(253,198,195,α)
// ⚠️⚠️ **รอบนี้ไม่มีแดงเจล ไม่มีมุกอุ่น ไม่มีผิวดำอมแดงเลยสักค่า** (ทั้งสามชุด
// คือพาเลตของแบรนด์ขาออก) · ไม่มีทอง/เหลือง ไม่มีน้ำเงิน/ฟ้า ไม่มีม่วง
// ไม่มีครีม/เบจ/น้ำตาล ไม่มีเทาโครเมียม · ปุ่ม LINE อยู่บน /about-us กับ
// /contact-us ไม่ใช่หน้านี้
// ⚠️⚠️ **รอบนี้เป็นแบรนด์ชมพูจริง การเจอชมพูในไฟล์จึงไม่พิสูจน์อะไร** — ห้ามเทียบ
// ด้วยวงศ์สี ต้องเทียบทีละค่ากับตาราง brand-spec §2 (f5469f ห่างจาก #fa539c แค่
// R5/G13/B3 · fa63b9 มี R=fa ตรงกันเป๊ะ · a4186b มี 18 อยู่กลางค่าเหมือน
// #c2185b · 8c0f52 ห่างจาก #8e0f41 แค่ R2/B17 — เจอที่ไหนแปลว่าพิมพ์ผิด
// เฮกซ์ของแบรนด์เก่าในคอมเมนต์เขียนแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep สะดุด)
// ⚠️⚠️ **มีทรัพย์168 ก็เป็นแบรนด์ "หมูการ์ตูนชมพู" เหมือนรอบนี้** ตัวแยกคือหมูของ
// เขาสวมหน้ากากโจรบนแมเจนต้าพื้นมืด ส่วนรอบนี้คือ **หมูมีปีกนางฟ้าขาวบนแคนดี้
// พื้นสว่าง** → ห้ามใส่หน้ากาก/โจร/ถุงเงิน
// ⚠️⚠️ **คาร์ดิแกนชมพู พื้นสตูดิโอขาว และสีผิวนักแสดงในอาร์ตเวิร์กเป็นวัตถุในภาพ
// ไม่ใช่สี UI**
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง และไม่ใส่ mx-auto / max-w-* บน <p>
// เพราะการ์ดคุมความกว้างเองแล้ว — ที่ประกาศสีได้มีแค่ปุ่ม ชิปไอคอน marker ของ
// ลำดับเลข และ <strong> · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง
// เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำ
// จะขาดครึ่ง และห้ามวาง <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังในข้อความของ prop และต้องเป็นไอคอนหมวดสล็อต ไม่ใช่ไอคอนหมวดเลข/สลาก
// slot ของ ContentBox รับ **หนึ่ง element** เท่านั้น จึงห่อด้วย <div> ชั้นเดียว
//
// Announcement รอบนี้หมุนมาเป็น Announcement4 ทั้งเว็บ (brand-spec §3 — รอบก่อนใช้
// Announcement5 จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็น
// คอปปี้ของแบรนด์นี้แล้ว จึงเรียกแบบ bare **ห้ามส่ง prop message** มิฉะนั้นข้อความ
// ตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -c บนเชลล์นี้
// ก็นับเป็นไบต์ ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับตัวนับ
// ของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 156 อักขระ (ชื่อแบรนด์รอบนี้ 9 อักขระ) เป็นประโยคเดียวที่บอกว่า
// หน้านี้มีไว้ทำอะไร แล้วหยุด
// (Google ตัดราว 160 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนๆ ยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} รวมสิ่งที่ควรศึกษาก่อนเดิมพันจริง ทั้งกติกาเกมสล็อต แนวจ่ายรางวัล รอบโบนัส เงื่อนไขโบนัสไม่ต้องทำเทิร์น คืนยอดเสีย 0.3% และขั้นตอนฝากถอน`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ศึกษากติกาเกมสล็อตก่อนเดิมพันด้วยเงินจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});

// คลาสปุ่มสามขั้วของหน้านี้ ประกาศครั้งเดียวแล้วใช้ซ้ำ เพื่อไม่ให้สองปุ่มที่ทำ
// หน้าที่เดียวกันหลุดไปคนละเฉดตอนรีแบรนด์รอบหน้า
const ctaPrimary =
  "flex items-center justify-center rounded-full border border-[#8e0f41] bg-gradient-to-b from-[#c2185b] to-[#8e0f41] px-8 py-3 font-black text-white shadow-[0_6px_18px_rgba(194,24,91,0.3)] transition-transform hover:scale-105";

const ctaSecondary =
  "flex items-center justify-center rounded-full border border-[#ef8dbd] bg-gradient-to-b from-[#fb8cc0] to-[#fa539c] px-8 py-3 font-bold text-[#3b0b26] shadow-[0_6px_18px_rgba(250,83,156,0.3)] transition-transform hover:scale-105";

const ctaQuiet =
  "flex items-center justify-center rounded-full border-2 border-[#ef8dbd] bg-[#fff0f8] px-8 py-3 font-bold text-[#c2185b] shadow-[0_4px_14px_rgba(251,140,192,0.3)] transition-all hover:scale-105 hover:bg-[#ffeef7] hover:shadow-[0_6px_18px_rgba(194,24,91,0.2)]";

const listChip = "mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#f7bcd9] bg-[#ffeef7] text-sm";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#c2185b]">{BRAND_NAME} นำเสนอเกมสล็อตออนไลน์หลากหลายรูปแบบ พร้อมข้อมูลค่ายเกม โปรโมชั่น และระบบบริการสมาชิก</strong>
        หน้านี้รวบรวมไว้ว่าควรศึกษาอะไรเกี่ยวกับเกมที่ระบุไว้ และควรตรวจอะไรซ้ำทุกครั้งที่กลับเข้ามาใหม่ ก่อนตัดสินใจเดิมพันด้วยเงินจริง
      </p>

      <p>
        ภายในเว็บไซต์ผู้ใช้งานสามารถศึกษากติกาเกม ตรวจสอบเงื่อนไขโบนัส และดูรายละเอียดฝากถอนก่อนใช้งานได้ ส่วนคำกล่าวอ้างเกี่ยวกับการเป็นเว็บตรงและเกมถูกลิขสิทธิ์
        <strong class="text-[#c2185b]">ควรตรวจสอบจากข้อมูลผู้พัฒนาและหลักฐานการได้รับอนุญาตที่เชื่อถือได้</strong>
        เพื่อประกอบการพิจารณาความน่าเชื่อถือของบริการ
      </p>

      <p>
        <strong class="text-[#c2185b]">ข้อมูลที่เว็บไซต์ระบุไว้ไม่ได้กล่าวถึงการเปิดให้หมุนเกมโดยไม่ใช้เงินจริงไว้แต่อย่างใด</strong>
        หน้านี้จึงไม่ยืนยันว่ามีรูปแบบนั้นให้ใช้งาน และควรตรวจสอบจากประกาศล่าสุดของเว็บไซต์ทางการเองว่าเกมใดเปิดให้ศึกษาได้ในลักษณะใด เนื้อหาด้านล่างเขียนไว้ประกอบการใช้งานเท่านั้น ไม่ได้ใช้แทนเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้บริการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="กติกาเกมสล็อต แนวจ่ายรางวัล และรอบโบนัสที่ควรอ่านก่อนลงเงิน" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#c2185b]">การอ่านกติกาของเกมที่จะเล่นจากหน้ากติกาของเกมนั้นเอง ตรงกว่าการเทียบจากหน้าตาของวงล้อเพียงอย่างเดียว</strong>
        เพราะแต่ละเกมกำหนดรูปแบบการจ่ายรางวัลไว้คนละชุด รายการด้านล่างคือสิ่งที่ควรไล่อ่านให้ครบก่อนตั้งยอดเดิมพัน
      </p>

      <ul class="flex flex-col gap-4" aria-label="สิ่งที่ควรศึกษาในเกมสล็อตก่อนเดิมพันจริง">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎰</span>
          <span>
            <strong class="text-[#c2185b]">แนวการเรียงสัญลักษณ์ที่เกมนั้นใช้นับผล</strong> ควรดูว่าเปิดใช้งานกี่แนวและปรับได้หรือไม่ ก่อนตั้งยอดเดิมพันต่อรอบ เพราะเป็นตัวกำหนดว่าหนึ่งรอบคิดเป็นยอดเท่าไร
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>✨</span>
          <span>
            <strong class="text-[#c2185b]">บทบาทของสัญลักษณ์พิเศษในการจ่ายรางวัล</strong> กำหนดไว้ในกติกาของเกมเอง จึงควรเปิดอ่านจากหน้ากติกา ไม่ใช่สรุปจากเกมอื่นที่เคยเล่นมาก่อน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎁</span>
          <span>
            <strong class="text-[#c2185b]">พฤติกรรมของรอบโบนัส</strong> ควรอ่านว่ารอบนั้นเริ่มจากเงื่อนไขอะไรและคำนวณผลด้วยวิธีใด ก่อนตั้งวงเงินที่จะใช้ในรอบนั้น
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📣</span>
          <span>
            <strong class="text-[#c2185b]">ประกาศล่าสุดของเว็บไซต์ทางการ</strong> คือจุดที่เงื่อนไขจริงถูกอัปเดต ทั้งเกมที่เปิดให้บริการ รายการโปรโมชั่น และช่องทางฝากถอน การเปิดดูก่อนทุกครั้งจึงตรงกว่าการจำไว้จากครั้งก่อน
          </span>
        </li>
      </ul>

      <p>
        ผลของเกมสล็อตมีความไม่แน่นอนโดยตัวของมันเอง
        <strong class="text-[#c2185b]">ผลที่ออกในรอบก่อนจึงไม่ใช่สถิติที่นำมาคาดการณ์รอบถัดไปได้</strong>
        และการศึกษากติกาช่วยให้เข้าใจว่าเกมคำนวณผลอย่างไรเท่านั้น ไม่ได้เพิ่มโอกาสชนะในรอบใด
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/promotion" aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`} class={ctaQuiet}>ดูภาพโปรโมชั่น</a>

        <a href="/about-us" aria-label={`อ่านหน้าเกี่ยวกับเราของ ${BRAND_NAME}`} class={ctaQuiet}>อ่านเกี่ยวกับเรา</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="เงื่อนไขโบนัสฝาก คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ที่ควรตรวจก่อนรับสิทธิ์" as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} นำเสนอข้อมูลโปรโมชั่นที่ระบุว่าสามารถรับโบนัสจากการฝากเงินได้ตลอดวันโดยไม่ต้องทำเทิร์น
        <strong class="text-[#c2185b]">
          ซึ่งผู้ใช้งานควรตรวจสอบรายละเอียดก่อนเข้าร่วมว่าโบนัสประเภทใดได้รับการยกเว้นข้อกำหนดยอดเดิมพัน และมีเงื่อนไขเกี่ยวกับการถอนเงินหรือวงเงินโบนัสสูงสุดหรือไม่
        </strong>
        นอกจากนี้ยังมีรายการคืนยอดเสียและแนะนำเพื่อนให้ตรวจสอบตามสิทธิ์ของสมาชิก โดยแต่ละรายการอาจมีหลักเกณฑ์แตกต่างกัน จึงควรอ่านข้อกำหนดล่าสุดให้ครบถ้วน
      </p>

      <p>
        รายการคืนยอดเสีย 0.3% ระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขรายวัน สมาชิกควรตรวจสอบว่าเกมสล็อตประเภทใดเข้าร่วมรายการ มีรอบสรุปยอดเวลาใด และต้องกดรับเครดิตด้วยตนเองหรือระบบดำเนินการให้อัตโนมัติ
        <strong class="text-[#c2185b]">ทั้งนี้ เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งต่อไป</strong>
        เพราะยอดเสียบางรายการอาจไม่เข้าเกณฑ์รับสิทธิ์ตั้งแต่ต้น
      </p>

      <p>
        รายการแนะนำเพื่อนโบนัส 0.8% ระบุสิทธิ์ไว้สำหรับสมาชิกที่แนะนำผู้ใช้งานรายใหม่ โดยควรตรวจสอบวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และฐานยอดที่ใช้คำนวณโบนัสให้ชัดเจน
        <strong class="text-[#c2185b]">แม้จะมีข้อความว่าไม่จำกัด แต่ควรยืนยันจำนวนบัญชีที่เข้าร่วมได้ รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุด</strong>
        เพื่อป้องกันความเข้าใจคลาดเคลื่อนเกี่ยวกับจำนวนเครดิตที่มีสิทธิ์ได้รับ
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME} 3 ขั้นตอน ก่อนเข้าตรวจรายละเอียดเกม`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#c2185b]">{BRAND_NAME} มีช่องทางสำหรับผู้ที่ต้องการศึกษาวิธีสมัครสมาชิกและเข้าสู่ระบบเกมสล็อตออนไลน์</strong>
        ก่อนดำเนินการควรตรวจสอบคุณสมบัติผู้สมัคร ข้อกำหนดด้านอายุ และกฎหมายที่เกี่ยวข้อง รวมถึงศึกษานโยบายความเป็นส่วนตัวเพื่อทำความเข้าใจวิธีจัดเก็บข้อมูลส่วนบุคคล
      </p>

      <ol class="ml-6 list-decimal space-y-3 marker:font-black marker:text-[#c2185b]">
        <li>
          <strong class="text-[#c2185b]">เข้าสู่หน้าสมัครสมาชิก</strong> ตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง จากนั้นเลือกเมนูสมัครสมาชิกและอ่านเงื่อนไขการเปิดบัญชี รวมถึงนโยบายการจัดเก็บข้อมูลส่วนบุคคลก่อนกรอกข้อมูล
        </li>
        <li>
          <strong class="text-[#c2185b]">กรอกข้อมูลและยืนยันบัญชี</strong> กรอกข้อมูลตามที่ระบบกำหนด ตรวจสอบความถูกต้องก่อนยืนยัน และตั้งรหัสผ่านที่คาดเดาได้ยาก ไม่ควรใช้ข้อมูลของบุคคลอื่นหรือเปิดเผยรหัส
          OTP ให้ใครทราบ
        </li>
        <li>
          <strong class="text-[#c2185b]">เข้าสู่ระบบและตรวจสอบรายละเอียดเกม</strong> หลังลงทะเบียนเรียบร้อย สามารถศึกษารายชื่อเกมสล็อต กติกาการเล่น ยอดเดิมพันขั้นต่ำ และรายละเอียดโปรโมชั่นที่เปิดให้บริการ
          หากมีข้อสงสัยควรสอบถามเจ้าหน้าที่ผ่านช่องทางทางการก่อนทำรายการ
        </li>
      </ol>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/register" aria-label={`สมัครสมาชิก ${BRAND_NAME}`} class={ctaPrimary}>สมัครสมาชิก</a>

        <a href="/login" aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`} class={ctaSecondary}>เข้าสู่ระบบ</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="ฝากถอนทุกธนาคารและทรูมันนี่ กับช่องทางติดต่อแอดมิน 24ชม." as="h2">
    <div class="flex flex-col gap-6">
      <p>
        เมื่ออ่านกติกาเกมและข้อกำหนดของโปรโมชั่นครบแล้ว
        <strong class="text-[#c2185b]">ขั้นถัดไปคือการตรวจระบบฝากถอนและช่องทางติดต่อให้ครบก่อนทำธุรกรรมครั้งแรก</strong>
        {BRAND_NAME} ระบุช่องทางฝากถอนผ่านธนาคารและทรูมันนี่ไว้ และรายการด้านล่างควรตรวจซ้ำทุกครั้งที่กลับเข้ามาใหม่ เพราะเงื่อนไขปรับเปลี่ยนได้ตามที่ผู้ให้บริการกำหนด
      </p>

      <ol class="ml-6 list-decimal space-y-3 marker:font-black marker:text-[#c2185b]">
        <li>
          <strong class="text-[#c2185b]">วงเงินต่อรายการและจำนวนครั้งในการถอน</strong> ควรศึกษาข้อกำหนดจริงให้ครบ แม้จะมีข้อความระบุว่าฝากถอนไม่มีขั้นต่ำและไม่จำกัดยอด พร้อมดูขั้นตอนการยืนยันตัวตนที่ระบบกำหนดไว้
        </li>
        <li>
          <strong class="text-[#c2185b]">ชื่อบัญชีปลายทาง</strong> ควรตรวจสอบให้ตรงกับข้อมูลผู้ให้บริการที่ยืนยันได้ก่อนโอนเงิน นี่คือจุดที่ใช้แยกรายการตามปกติออกจากบัญชีแอบอ้างได้เร็วที่สุด
        </li>
        <li>
          <strong class="text-[#c2185b]">หมายเลขรายการและหลักฐานการทำธุรกรรม</strong> ควรเก็บไว้ทุกครั้งหลังฝากหรือถอน เพื่อใช้ตรวจสอบย้อนหลังหากยอดไม่เข้าตามที่ระบุ
        </li>
        <li>
          <strong class="text-[#c2185b]">ช่องทางติดต่อแอดมิน 24ชม.</strong> ควรตรวจสอบจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีแอบอ้างที่ใช้ชื่อคล้ายกัน และควรตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุดอีกครั้ง
        </li>
        <li>
          <strong class="text-[#c2185b]">ความปลอดภัยของข้อมูลที่ใช้เข้าสู่ระบบ</strong> ควรตั้งรหัสผ่านที่คาดเดาได้ยาก และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้ใครทราบ แม้จะอ้างว่าเป็นเจ้าหน้าที่ก็ตาม
        </li>
      </ol>

      <p>
        <strong class="text-[#c2185b]">หากพบความผิดปกติควรหยุดทำธุรกรรมและติดต่อธนาคารหรือผู้ให้บริการชำระเงินโดยเร็ว</strong>
        แล้วค่อยกลับมาทำรายการใหม่เมื่อตรวจสอบข้อมูลปลายทางได้ครบถ้วน และเมื่อแจ้งปัญหา ควรระบุรายละเอียดให้ชัดเจนพร้อมหลักฐานที่เกี่ยวข้อง โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact-us" aria-label={`ดูช่องทางติดต่อทีมงาน ${BRAND_NAME} ทั้งหมด`} class={ctaQuiet}>ช่องทางติดต่อทั้งหมด</a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
