---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import popularGamesImage from "../assets/gamedemo8.webp";
import newGamesImage from "../assets/gamedemo16.webp";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ (src/assets/content.txt) ไม่มีหมวด "ทดลองเล่น" และไม่มี
// ส่วน SUB-PAGES เลย ทั้งหน้าจึงเขียนขึ้นใหม่จากคลังคำของบรีฟรอบนี้ ไม่ใช่แก้ทับ
// ประโยคของแบรนด์ก่อน
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// ⚠️ ดรอปนี้ (2026-10-19) คือ **เว็บสล็อตล้วน** ไม่ใช่หมวดอื่นใดทั้งสิ้น
// สองหน้าของหมวดที่แบรนด์ก่อนๆ เคยเปิดจอดอยู่ใน src/pages-disabled/ ไม่มี route
// ห้ามลิงก์ไปหา เป็น href ตายที่ทำให้ build แดง route ที่มีจริงรอบนี้คือ
// / · /about-us · /contact-us · /login · /register · /privacy · /promotion ·
// /terms · /ทดลองเล่น · /ทางเข้า · /line
//
// ⚠️ แบรนด์ก่อนหน้าก็เป็นแบรนด์สล็อตเหมือนกัน คอปปี้เดิมจึง "ดูเข้าเค้า" ทั้งที่
// กรอบของบรีฟคนละอัน — **ห้าม find-and-replace ทับประโยคเดิม** วลีแกนของแบรนด์ก่อน
// (ความง่ายในการถอนเงิน + ตัวเลขจำนวนผู้ใช้งานต่อวัน + การไม่มีรีวิวเชิงลบ) ถูกถอด
// ออกหมดแล้วทั้งไฟล์ กรอบของบรีฟรอบนี้คือ **เว็บสล็อตทางการที่นำเสนอตัวเองว่าเป็น
// ผู้ให้บริการฐานเกมหลัก และรวบรวมข้อมูลสมัคร/เข้าสู่ระบบ/ฝากถอน/โปรโมชั่นไว้ที่เดียว**
// (คำต้องห้ามไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive
// ในคอมเมนต์ของไฟล์นี้เอง — เต็มอยู่ใน brand-spec §6)
//
// 🚨 **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกมแม้แต่ค่ายเดียว** จึงห้ามเขียนชื่อค่ายใดๆ
// ลงหน้าเว็บ ให้ใช้คำกลางว่า "ค่ายเกม" ตามบรีฟ
//
// ⚠️ บรีฟรอบนี้ **ไม่ได้เอ่ยถึงโครงสร้างพื้นฐาน เอกสารรับรอง สถาบันการเงิน
// หรือตัวเลขเชิงสถิติใดๆ ของเว็บ** จึงห้ามพูดถึงทั้งหมด สิ่งที่บรีฟให้มาคือ
// "ศึกษารายละเอียดของเกมและเงื่อนไขบริการก่อนเริ่มต้น" "ศึกษารายชื่อค่ายเกม กติกา
// และเงื่อนไขการทำรายการผ่านช่องทางที่เว็บไซต์จัดเตรียมไว้" "อ่านข้อกำหนดการเปิดบัญชี
// และตรวจสอบรายชื่อค่ายเกมที่เปิดให้บริการจริงก่อนดำเนินการ" "ตั้งรหัสผ่านที่ปลอดภัย"
// และ "สอบถามเจ้าหน้าที่ก่อนทำรายการเมื่อพบข้อสงสัย"
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามีโหมดทดลอง เครดิตทดลอง หรือเดโมฟรีเป็นบริการของเว็บ —
// จึงห้ามสัญญาสินค้าตัวนั้น คำว่า "ทดลองเล่น" บนหน้านี้จึงหมายถึงสิ่งที่บรีฟระบุไว้
// ตรงๆ ว่าทำได้: ไล่ดูเกมสล็อตของค่ายเกมที่เปิดให้บริการและขั้นตอนการใช้งานให้ครบ
// หนึ่งรอบ ศึกษากติกากับเงื่อนไขบริการ และสอบถามเจ้าหน้าที่ ก่อนเข้าใช้งานจริง
//
// ⚠️ รูปในหน้านี้ใช้ได้แค่ gamedemo8 กับ gamedemo16 เท่านั้น — เป็นอาร์ตสต็อกกลาง
// ของเทมเพลต (mtime 2026-08-04) ไม่ใช่อาร์ตเวิร์กของแบรนด์นี้ จึงอยู่ต่อได้ แต่ alt
// ต้องบรรยายภาพจริง และห้ามเอ่ยชื่อแบรนด์ใด เพราะไม่มีชื่อแบรนด์ไหนปรากฏอยู่บนรูป
// ทั้งสองใบ (สีที่ alt บรรยายคือสีที่วาดอยู่บนอาร์ตสต็อกจริง ไม่ใช่สีของพาเลตต์
// รอบนี้ — ห้าม "แก้สี" ใน alt ให้เข้าแบรนด์ เพราะนั่นทำให้ alt บรรยายผิด เปิดอ่าน
// บิตแมปทั้งสองใบซ้ำแล้วรอบนี้ ข้อความ alt ยังตรงกับภาพจริงทุกองค์ประกอบ)
// ส่วน gamedemo7/9/10/11/12/14/15/17/18 มีโลโก้หรือชื่อของผู้ให้บริการ
// เจ้าอื่นพิมพ์ทับอยู่กลางรูป และ gamedemo13 เป็นภาพล่อแหลม — ห้ามนำกลับมาใช้
// เพราะเท่ากับอ้างชื่อที่บรีฟไม่ได้เอ่ย ไฟล์ยังอยู่บนดิสก์ ห้ามลบ เป็นอินเวนทอรี
// gamedemo8 ("POPULAR GAME" 600x379) กับ gamedemo16 ("New Game" 650x411)
// ความกว้างที่วาดจริงสูงสุด ~600px ต่อใบ (กริดสองคอลัมน์ในการ์ด) จึงไม่ขยายเกิน
// ต้นฉบับ quality={62} ของสองใบนี้ตั้งไว้ต่ำกว่าค่าปกติ 80 มาตั้งแต่รอบก่อน เพราะ
// อาร์ตมีเกรนละเอียดจนไฟล์ AVIF เคยโตกว่า WebP ของตัวเอง (verify-build จะแดง)
// ห้ามดันกลับขึ้น — เป็นค่าต่อรูป ไม่ใช่การจูนต่อฟอร์แมต
//
// ⚠️ ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 100% · 3 ขั้นตอน · 24ชม. ·
// อันดับ1 ส่วนตัวเลขและชื่อเฉพาะที่ห้ามแต่งขึ้นเองอยู่ครบใน brand-spec §6
//
// 🚨 ประโยค hedge ของบรีฟที่ห้ามตัดทิ้ง (เป็นเนื้อหาของบรีฟ ไม่ใช่ filler) และ
// ห้ามเขียนเสริมให้กลายเป็นคำโฆษณาที่บรีฟกำลังเตือนเรื่องนั้นอยู่:
// ควรตรวจสอบข้อมูลผู้ให้บริการและความน่าเชื่อถือจากหลักฐานที่ตรวจสอบได้ก่อนใช้งาน ·
// คำกล่าวอ้างเกี่ยวกับการเป็นเว็บหลักหรือเว็บอันดับหนึ่ง ควรพิจารณาร่วมกับข้อมูล
// ผู้ให้บริการ หลักฐานการอนุญาต และความคิดเห็นจากผู้ใช้งานหลายแหล่ง ·
// จำนวนค่ายเกมและรายการเกมอาจเปลี่ยนแปลงได้ตามการให้บริการของแต่ละช่วงเวลา ·
// เครดิตคืนยอดเสียไม่ใช่การรับประกันผลตอบแทนจากการเดิมพัน · แม้โปรโมชั่นแนะนำเพื่อน
// จะระบุว่าไม่จำกัด แต่ควรยืนยันรายละเอียดจากประกาศล่าสุด · ควรเพิ่มเพื่อนผ่านลิงก์
// หรือ QR Code จากเว็บไซต์ทางการเท่านั้น เพื่อหลีกเลี่ยงบัญชีที่แอบอ้างชื่อบริการ ·
// ไม่เปิดเผยรหัสผ่านหรือรหัส OTP · ควรตรวจสอบเวลาการให้บริการและระยะเวลาตอบกลับ
// ล่าสุดอีกครั้ง
//
// banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion · banner2/banner3 และ
// slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import (ลำพังการ import ก็ทำให้ไฟล์
// ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้หมุนมาเป็น Announcement2 ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ Announcement6 จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็น
// คอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นข้อความ
// ตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ฟ้าบับเบิลนำ ทองเป็นฮิวที่สอง น้ำเงินลึก
// ไม่เคยถือตัวอักษร บนดำสนิท** — เปลี่ยนตระกูลสีทั้งชุดจากรอบก่อนที่ชมพูเป็นตัวนำ
// ⚠️ แบรนด์ก่อนๆ มีทองแทบทุกราย และเคยมีแบรนด์ฟ้า/น้ำเงินผ่านเทมเพลตนี้มาแล้วด้วย
// "มีทองอยู่" หรือ "มีฟ้าอยู่" จึงไม่ใช่ตัวบอกว่าถูกแบรนด์ ให้เทียบเป็น "ค่า" ทีละตัว
// กับตารางใน brand-spec §2 (ค่าเดิมไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีแบรนด์เก่า
// เจอ false positive) ฟ้ารอบนี้คือ **#2f9ff5** (+#a8dcff +#0b3f78) และทองรอบนี้
// คือ **#ffc82e**
// ลำดับความลึก: #0e2238 ผิวยก (= การ์ด) / #081726 กลาง / #040d16 จม / #000000 พื้นเพจ
// ลำดับปุ่มสื่อด้วยขั้ว "พื้นฟ้าตัน vs กรอบทองโปร่ง vs ผิวจมขอบน้ำเงิน" ตามคู่ปุ่ม
// ของ Navfoot: ปุ่มสมัครสมาชิกถมไล่เฉด #a8dcff → #2f9ff5 ขอบ #0b3f78 หมึก #04121f
// (11.6:1 บนปลายฟ้าอ่อน · 6.9:1 บนปลายฟ้าแบรนด์) · ปุ่มเข้าสู่ระบบเป็นกรอบทองโปร่ง
// พื้นผิวจม #081726 → #040d16 ขอบ #ffc82e/80 ตัวอักษร #ffc82e (12.1:1 บนผิวจม) ·
// ปุ่มลิงก์ภายในเป็นผิวจมขอบน้ำเงินลึก ตัวอักษร #e8f4ff และ hover ยกขอบเป็นฟ้า
// แบรนด์ #2f9ff5 · ขอบรูปใช้ฟ้าแบรนด์ #2f9ff5 โปร่ง (ฮิวนำต้องเห็นจริงบนหน้า) ·
// marker ของลำดับเลขใช้ฟ้าอ่อน #a8dcff (11.6:1 บนผิวการ์ด — เป็นตัวอักษร จึงใช้
// น้ำเงินลึกไม่ได้ และ #ffc82e สงวนไว้ให้ <strong> เท่านั้น)
// ⚠️ ห้ามกลับด้าน: พื้นถมฟ้าต้องใช้หมึกเข้มเสมอ ห้ามขาวหรือฟ้าอ่อน และ
// #0b3f78 #5c4a16 เป็นเส้น ขอบ ออรา และพื้นถมเท่านั้น ห้ามถือตัวอักษรทุกขนาด
// ออราในไฟล์นี้ใช้ rgba(11,63,120,α) · rgba(255,200,46,α) · rgba(47,159,245,α)
// เท่านั้น · รอบนี้ไม่มีชมพู ไม่มีม่วง ไม่มีเขียว ไม่มีส้ม ไม่มีเงิน/โครเมียม
// ไม่มีโรสโกลด์ และไม่มีแดง (#00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE
// ไม่ใช่สีของเว็บ จึงคงไว้ตาม §2)
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #e8f4ff)
// ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง ปล่อยให้สืบทอดลงมา
// และไม่ใส่ mx-auto / max-w-* บน <p> — มีแค่ปุ่ม ขอบรูป marker ของลำดับเลข และ
// <strong> ที่ประกาศสี โดย <strong> ใช้ทอง #ffc82e ตัวเดียว (11.3:1 บนผิวการ์ด)
// และแต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรค
// ระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง และห้ามวาง
// <strong> สองอันติดกัน
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 156 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} หน้ารวมวิธีไล่ดูเกมสล็อตออนไลน์ รายชื่อค่ายเกม กติกาของแต่ละเกม และเงื่อนไขฝากถอน ให้ครบหนึ่งรอบก่อนสมัครสมาชิกและเข้าสู่ระบบใช้งานจริง`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ไล่ดูเกมสล็อตและกติกาของค่ายเกมก่อนเข้าใช้งานจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#ffc82e]">{BRAND_NAME} เว็บสล็อตทางการ นำเสนอช่องทางเข้าใช้งานเกมสล็อตออนไลน์ไว้ในเว็บไซต์เดียว</strong>
