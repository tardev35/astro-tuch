---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion,
// /login, /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์
// หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ (src/assets/content.txt) ไม่มี
// ส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่จากข้อเท็จจริงและคลังคำของบรีฟรอบนี้
// เท่านั้น (.claude/brand-spec-slot168.md §4-§5)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
//   h1  ทดลองเล่น <แบรนด์> ศึกษาระบบเกมและเงื่อนไขก่อนใช้บริการ
//   h2  โหมดทดลองใช้ทำอะไรได้ และข้อจำกัดที่ควรรู้ก่อนเดิมพันจริง
//   h2  รูปแบบเกมสล็อต ค่ายผู้พัฒนาเกม และเงื่อนไขที่ควรตรวจก่อนใช้งาน
//   h2  ระบบฝากถอน โปรโมชั่น และช่องทางติดต่อแอดมินที่ควรตรวจก่อนทำรายการ
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// 🚨🚨 **รอบนี้ <แบรนด์> เป็นเว็บสล็อต ไม่ใช่เว็บหวย** (brand-spec §1, §5) —
// เป็นการ **กลับทิศ** จากรอบก่อน ไม่ใช่สถานะที่สืบทอดมา คำนิยามตัวเองของแบรนด์
// ขาออกทั้งชุดจึงเป็นคำค้างข้ามแบรนด์ที่ห้ามหลุดกลับมา **รายการคำต้องห้ามเต็มอยู่ใน
// brand-spec §5 ไม่พิมพ์ซ้ำที่นี่** เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive
// ในคอมเมนต์ของไฟล์นี้เอง
// ⚠️ **คำว่า "ทดลองเล่น" ยังอยู่ได้** เพราะเป็นชื่อ route /ทดลองเล่น และเป็นชื่อ
// เมนูจริง (ใช้ใน h1 · title · description · breadcrumb) แต่บรีฟรอบนี้
// **ไม่ได้พูดถึงโหมดทดลองเลยแม้แต่ประโยคเดียว** ดังนั้นคอปปี้ของหน้านี้พูดถึง
// โหมดทดลองได้แบบ **เป็นกลางและมีเงื่อนไขเท่านั้น** ("หากผู้ให้บริการเปิดไว้...")
// ห้ามอ้างว่ามีกี่เกม ห้ามอ้างว่าเล่นฟรีได้เท่าไร ห้ามอ้างค่า RTP และห้ามอ้างว่า
// ผลจากโหมดทดลองสะท้อนผลจริง
// แกนของหน้า = **สิ่งที่ควรเปิดอ่านก่อนใช้บริการ** ตามที่บรีฟมีจริง:
// รูปแบบเกม (สล็อตคลาสสิก · รอบโบนัส · สัญลักษณ์พิเศษ) · ค่ายผู้พัฒนาเกม ·
// เงื่อนไขการเดิมพัน · เงื่อนไขโปรโมชั่น · ระบบฝากถอน (ธนาคารและทรูมันนี่) ·
// ช่องทางติดต่อแอดมิน 24ชม. · ประกาศล่าสุด
//
// ⚠️⚠️ **ห้ามเขียนชื่อแบรนด์ด้วยตัวละตินเด็ดขาด** (brand-spec §1) — รอบนี้สะกดได้
// แบบเดียวคือค่าใน BRAND_NAME ซึ่งเป็นภาษาไทยผสมเลข ห้ามพิมพ์ตรงๆ
//
// ⚠️ **รอบนี้สองหน้าหมวดหวยถูกปิด** (/ตรวจหวย · /แนวทาง ย้ายไป src/pages-disabled/
// แล้วใน P1 เพราะรอบนี้เป็นเว็บสล็อต) ลิงก์ไปสอง route นั้นจากหน้านี้จึงถูกถอดออก
// ทั้งคู่ — verify-build จะแดงถ้า href ชี้ไป route ที่ไม่มีจริง
// route ที่มีจริงรอบนี้: / · /about-us · /contact-us · /promotion · /ทดลองเล่น ·
// /ทางเข้า · /login · /register · /terms · /privacy · 404 · /line
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกม ชื่อธนาคารรายตัว ชื่อผู้ให้บริการ
// หน่วยงานกำกับ ใบอนุญาต ปีก่อตั้ง จำนวนสมาชิก จำนวนเกม ค่า RTP หรือยอดขั้นต่ำที่
// เป็นตัวเลข แม้แต่รายการเดียว** จึงห้ามเขียนลงหน้าเว็บ · ตัวเลขที่ขึ้นหน้าได้มีแค่
// ของบรีฟเอง: **0.3% · 0.8% · 100% (เฉพาะในวลี ไม่ผ่านเอเย่นต์100%) · 24ชม.**
//
// 🚨 **ข้อกำกับของบรีฟที่ต้อง ship ครบบนหน้านี้** (ไม่ใช่ filler ให้ตัดทิ้ง):
// 1) ควรตรวจสอบข้อมูลผู้ให้บริการและหลักฐานความเกี่ยวข้องกับค่ายเกมโดยตรงก่อนใช้งาน
// 2) คำกล่าวอ้างว่าเป็นเกมลิขสิทธิ์แท้หรือยอดเงินเข้าบริษัทแม่โดยตรง ไม่สามารถ
//    ยืนยันได้จากข้อความโฆษณาเพียงอย่างเดียว
// 3) ไม่ควรตีความข้อความว่าจ่ายสูงเป็นการรับประกันผลกำไรจากเกมสล็อต
// 4) เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพัน
// 5) หากพบชื่อบัญชีไม่ตรงกับข้อมูลทางการหรือมีการแจ้งเปลี่ยนบัญชีอย่างผิดปกติ
//    ควรหยุดทำรายการและติดต่อธนาคารหรือผู้ให้บริการชำระเงินเพื่อตรวจสอบก่อนโอนเงิน
// 6) ไม่เปิดเผยรหัสผ่านหรือรหัส OTP · ควรตรวจสอบเวลาการให้บริการจริงจากประกาศ
//    ล่าสุดอีกครั้ง
// ⚠️ บรีฟรอบนี้ **โฆษณาและกำกับในประโยคเดียวกัน** คำโฆษณาอยู่ได้เฉพาะในขอบเขตที่
// บรีฟเขียนไว้เอง ห้ามขยายเป็นคำกล่าวอ้างใหม่ และทุกประโยคกำกับต้อง ship ครบ
// ห้ามตัดเพราะฟังดูลบ
//
// 🚨 **ไม่มีรูปในหน้านี้โดยตั้งใจ** รอบนี้ไม่มี "รูปประกอบบทความ" เลย
// (banner2/banner3 mtime 18:43 เป็นรูปประกอบบทความของรอบก่อน · slide3/slide4
// mtime 2026-09-29 เป็นอาร์ตเวิร์กของอีกแบรนด์ — **ห้าม import ทั้งสี่ไฟล์**
// ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ ทุก build) · slide1/slide2 ถูกตรึง
// ไว้กับ index §4-§5 กับ /promotion · banner1 / banner1-mobile / og.png เป็นของ
// glob ที่ MainLayout ปักไว้ **ห้ามอ้างจากหน้านี้** · ไฟล์เก่าทั้งหมดยังอยู่บน
// ดิสก์ **ห้ามลบ** เป็นอินเวนทอรีของแบรนด์ถัดไป
//
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) เป็น **ธีมมืด แดงเจลมันวาวนำ + มุกอุ่นรอง**
// bg.json ของดรอปนี้คือ {"mode":"color","color":"#140000"} = **ดำอมแดงเข้มมาก**
// **ห้ามเดาว่าเท่าเดิม และห้าม "แก้" การ์ดให้สว่าง**
// ค่าที่ใช้ได้ในไฟล์นี้: แดงสด #fb2e33 (<strong> + marker ของลำดับเลข + ขอบและ
// ตัวอักษรปุ่ม outline — 5.1:1 บนผิวการ์ด ถือตัวอักษรได้) · แดงพื้นถม #d81115 →
// #b00d11 → #8a0608 (**ไล่เฉดของปุ่มหลัก** ถือหมึกขาว #ffffff ได้ทั้งสาม stop) ·
// มุกอุ่น #f0e6e4 → #c9b9b7 (**พื้นถมของปุ่มรองเท่านั้น** คู่กับหมึกดำ #0a0a0a) ·
// ขอบ #551c1e · #cb0b0d · #7d6f6e (**ห้ามถือตัวอักษรทั้งสามค่า**) ·
// ผิวจม #0b0000 และผิวยก #2a0c0d (พื้นปุ่ม outline / ชิปไอคอน)
// หมึกเนื้อความคือ #f0e6e4 (= BRAND_TEXT) ซึ่ง **ไม่ประกาศในไฟล์นี้** การ์ด
// ContentBox ตั้งไว้ให้แล้วและย่อหน้าสืบทอดลงมา
// 🚨🚨 **ขาวบนแดงสด #fb2e33 ได้แค่ 3.8:1 — ห้ามถมพื้น #fb2e33 แล้ววางหมึกขาว**
// พื้นแดงที่ถือหมึกขาวได้ต้องเป็น **#d81115 ลงไป** เท่านั้น และพื้นมุกสว่างต้องคู่
// กับหมึกดำเสมอ ห้ามกลับด้าน
// ออราที่อนุญาต: rgba(251,46,51,α) · rgba(203,11,13,α) · rgba(138,6,8,α) ·
// rgba(240,230,228,α) · rgba(227,214,212,α) · rgba(0,0,0,α)
// ⚠️⚠️ **รอบนี้ไม่มีทองเลยสักเฉด** — ทองคือฮิวนำของแบรนด์ขาออกทันที การปล่อยทองไว้
// = ทั้งผิดพาเลตและหลงเหลือข้ามแบรนด์พร้อมกัน · และ **วัสดุที่สองรอบนี้เป็นมุกอุ่น
// (R>G>B) ไม่ใช่เงินเย็น** · ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีม่วง ไม่มีเขียว ไม่มีส้ม
// ไม่มีครีม ไม่มีน้ำตาล · ปุ่ม LINE อยู่บน /about-us กับ /contact-us ไม่ใช่หน้านี้
// ⚠️⚠️ **คาร์ดิแกนแดง เสื้อกล้ามขาว พื้นสตูดิโอขาว และสีผิวนักแสดงในอาร์ตเวิร์ก
// เป็นวัตถุในภาพ ไม่ใช่สี UI**
// ⚠️⚠️ **รอบนี้เป็นแบรนด์แดงจริง การเจอแดงในไฟล์จึงไม่พิสูจน์อะไร** — ห้ามเทียบ
// ด้วยวงศ์สี ต้องเทียบทีละค่ากับตาราง brand-spec §2 (fb141b ของ GT66B ห่างจาก
// #fb2e33 แค่ G/B และ 8a0609 ห่างจาก #8a0608 แค่ B1 — เจอที่ไหนแปลว่าพิมพ์ผิด
// เฮกซ์ของแบรนด์เก่าในคอมเมนต์เขียนแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep สะดุด)
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง และไม่ใส่ mx-auto / max-w-* บน <p>
// เพราะการ์ดคุมความกว้างเองแล้ว — ที่ประกาศสีได้มีแค่ปุ่ม ชิปไอคอน marker ของ
// ลำดับเลข และ <strong> · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง
// เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำ
// จะขาดครึ่ง และห้ามวาง <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังในข้อความของ prop และต้องเป็นไอคอนหมวดสล็อต ไม่ใช่ไอคอนหมวดหวย
// slot ของ ContentBox รับ **หนึ่ง element** เท่านั้น จึงห่อด้วย <div> ชั้นเดียว
//
// Announcement รอบนี้หมุนมาเป็น Announcement5 ทั้งเว็บ (brand-spec §3 — รอบก่อนใช้
// AnnouncementHuay จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็น
// คอปปี้ของแบรนด์นี้แล้ว จึงเรียกแบบ bare **ห้ามส่ง prop message** มิฉะนั้นข้อความ
// ตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 157 อักขระ (ชื่อแบรนด์รอบนี้ 8 อักขระ) เป็นประโยคเดียวที่บอกว่า
// หน้านี้มีไว้ทำอะไร แล้วหยุด
// (Google ตัดราว 155 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนๆ ยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} รวมสิ่งที่ควรอ่านก่อนใช้บริการ ทั้งข้อจำกัดของโหมดทดลอง รูปแบบเกมสล็อต เงื่อนไขโปรโมชั่น และขั้นตอนฝากถอนธนาคารและทรูมันนี่จากประกาศล่าสุด`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ศึกษาระบบเกมและเงื่อนไขก่อนใช้บริการ`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});

// คลาสปุ่มสามขั้วของหน้านี้ ประกาศครั้งเดียวแล้วใช้ซ้ำ เพื่อไม่ให้สองปุ่มที่ทำ
// หน้าที่เดียวกันหลุดไปคนละเฉดตอนรีแบรนด์รอบหน้า
const ctaPrimary =
  "flex items-center justify-center rounded-lg border border-[#cb0b0d] bg-gradient-to-b from-[#d81115] via-[#b00d11] to-[#8a0608] px-8 py-3 font-black text-[#ffffff] shadow-[0_6px_18px_rgba(203,11,13,0.35)] transition-transform hover:scale-105";

const ctaSecondary =
  "flex items-center justify-center rounded-lg border border-[#7d6f6e] bg-gradient-to-b from-[#f0e6e4] to-[#c9b9b7] px-8 py-3 font-bold text-[#0a0a0a] shadow-[0_6px_18px_rgba(240,230,228,0.25)] transition-transform hover:scale-105";

const ctaQuiet =
  "flex items-center justify-center rounded-lg border-2 border-[#fb2e33] bg-[#0b0000] px-8 py-3 font-bold text-[#fb2e33] shadow-[0_4px_14px_rgba(0,0,0,0.35)] transition-all hover:scale-105 hover:bg-[#2a0c0d] hover:shadow-[0_6px_18px_rgba(203,11,13,0.25)]";

const listChip = "mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#551c1e] bg-[#2a0c0d] text-sm";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#fb2e33]">{BRAND_NAME} นำเสนอข้อมูลเกมสล็อตออนไลน์จากค่ายต่างประเทศ พร้อมรายละเอียดระบบเกม โปรโมชั่น และช่องทางฝากถอนสำหรับสมาชิก</strong>
        หน้านี้รวบรวมไว้ว่าควรเปิดอ่านอะไรบ้างก่อนตัดสินใจใช้บริการ และควรตรวจอะไรซ้ำทุกครั้งที่กลับเข้ามาใหม่
      </p>

      <p>
        ภายในเว็บไซต์มีเมนูสำหรับศึกษากติกาเกม ตรวจสอบเงื่อนไขการเดิมพัน และเลือกดูข้อมูลค่ายเกมที่สนใจ ส่วนคำกล่าวอ้างเกี่ยวกับการเป็นทางเข้าเล่นฐานเกมหลักหรือไม่ผ่านเอเย่นต์100%
        <strong class="text-[#fb2e33]">ควรตรวจสอบข้อมูลผู้ให้บริการและหลักฐานความเกี่ยวข้องกับค่ายเกมโดยตรงก่อนใช้งาน</strong>
        เนื้อหาในหน้านี้จึงเขียนไว้ประกอบการใช้งานเท่านั้น ไม่ได้ใช้แทนเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้บริการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="โหมดทดลองใช้ทำอะไรได้ และข้อจำกัดที่ควรรู้ก่อนเดิมพันจริง" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#fb2e33]">หากผู้ให้บริการเปิดโหมดทดลองไว้ในเกมใด โหมดนั้นมีประโยชน์ในแง่การทำความคุ้นเคยกับหน้าจอเท่านั้น</strong>
        เช่น ตำแหน่งของปุ่มหมุนวงล้อ วิธีเลือกจำนวนไลน์และยอดเดิมพันต่อรอบ และลำดับขั้นก่อนถึงหน้ายืนยัน รายการด้านล่างคือข้อจำกัดที่ควรรู้ก่อนเทียบกับการใช้งานจริง
      </p>

      <ul class="flex flex-col gap-4" aria-label="ข้อจำกัดของโหมดทดลองที่ควรรู้">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎰</span>
          <span>
            <strong class="text-[#fb2e33]">รอบที่หมุนในโหมดทดลองไม่ใช่การเดิมพันจริง</strong> จึงไม่มีผลต่อการจ่ายรางวัล ไม่นับเป็นยอดของโปรโมชั่น และไม่ใช่หลักฐานในการตรวจสอบรายการภายหลัง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📱</span>
          <span>
            <strong class="text-[#fb2e33]">หน้าจอและเงื่อนไขที่เห็นในโหมดทดลองอาจไม่ตรงกับที่เปิดให้บริการจริง</strong> ก่อนลงเงินจึงควรกลับไปดูเงื่อนไขของเกมนั้นจากประกาศล่าสุดอีกครั้ง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📊</span>
          <span>
            <strong class="text-[#fb2e33]">ผลที่ออกในโหมดทดลองไม่ได้สะท้อนผลของการเดิมพันครั้งถัดไป</strong> และไม่ใช่สถิติที่นำมาคาดการณ์ได้ ผลของเกมสล็อตมีความไม่แน่นอนโดยตัวของมันเอง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📣</span>
          <span>
            <strong class="text-[#fb2e33]">ประกาศล่าสุดของเว็บไซต์ทางการ</strong> คือจุดที่เงื่อนไขจริงถูกอัปเดต ไม่ว่าจะเป็นเกมที่เปิดให้บริการ รายการโปรโมชั่น หรือช่องทางฝากถอน การเปิดดูก่อนทุกครั้งจึงตรงกว่าการจำไว้จากครั้งก่อน
          </span>
        </li>
      </ul>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/promotion" aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`} class={ctaQuiet}>ดูภาพโปรโมชั่น</a>

        <a href="/about-us" aria-label={`อ่านหน้าเกี่ยวกับเราของ ${BRAND_NAME}`} class={ctaQuiet}>อ่านเกี่ยวกับเรา</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="รูปแบบเกมสล็อต ค่ายผู้พัฒนาเกม และเงื่อนไขที่ควรตรวจก่อนใช้งาน" as="h2">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#fb2e33]">{BRAND_NAME} นำเสนอเกมสล็อตจากค่ายต่าง ๆ ที่มีรูปแบบการเล่นและฟีเจอร์แตกต่างกัน</strong>
        ทั้งสล็อตคลาสสิก เกมที่มีรอบโบนัส และเกมที่ใช้สัญลักษณ์พิเศษในการจ่ายรางวัล การอ่านกติกาของแต่ละเกมก่อนลงเงินจึงตรงกว่าการเทียบจากหน้าตาของวงล้อเพียงอย่างเดียว
      </p>

      <p>
        ก่อนใช้บริการควรตรวจสอบรายชื่อค่ายผู้พัฒนาเกมและหลักฐานการได้รับอนุญาตให้บริการเกม รวมถึงตรวจสอบข้อมูลบริษัทและชื่อบัญชีรับเงินก่อนทำธุรกรรม
        <strong class="text-[#fb2e33]">เพราะคำกล่าวอ้างว่าเป็นค่ายแท้ถูกลิขสิทธิ์หรือฝากถอนยอดเข้าบริษัทแม่โดยตรง ไม่สามารถยืนยันได้จากข้อความโฆษณาเพียงอย่างเดียว</strong>
        จุดที่ตรวจได้จริงคือข้อมูลผู้ให้บริการและเงื่อนไขที่แสดงอยู่บนเว็บไซต์ทางการในขณะนั้น
      </p>

      <p>
        ส่วนโปรโมชั่นที่ระบุไว้มีรายการคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8% ซึ่งแต่ละรายการอาจกำหนดประเภทเกมที่เข้าร่วม ยอดที่นำมาคำนวณ รอบเวลารับเครดิต และเงื่อนไขการถอนเงินแตกต่างกัน
        <strong class="text-[#fb2e33]">ทั้งนี้ ไม่ควรตีความข้อความว่าจ่ายสูงเป็นการรับประกันผลกำไรจากเกมสล็อต</strong>
        และเครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพัน แม้โปรโมชั่นจะระบุว่าไม่จำกัด แต่ควรยืนยันข้อกำหนดจากประกาศล่าสุดก่อนเข้าร่วมทุกครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ระบบฝากถอน โปรโมชั่น และช่องทางติดต่อแอดมินที่ควรตรวจก่อนทำรายการ" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        เมื่ออ่านรูปแบบเกม เงื่อนไขการเดิมพัน และข้อกำหนดของโปรโมชั่นครบแล้ว
        <strong class="text-[#fb2e33]">ขั้นถัดไปคือการตรวจระบบฝากถอนและช่องทางติดต่อให้ครบก่อนทำธุรกรรมครั้งแรก</strong>
        รายการด้านล่างควรตรวจซ้ำทุกครั้งที่กลับเข้ามาใหม่ เพราะเงื่อนไขปรับเปลี่ยนได้ตามที่ผู้ให้บริการกำหนด
      </p>

      <ol class="ml-6 list-decimal space-y-3 marker:font-black marker:text-[#fb2e33]">
        <li>
          <strong class="text-[#fb2e33]">รายชื่อธนาคารที่รองรับและทรูมันนี่</strong> ควรดูจากบริการที่เปิดใช้งานอยู่จริง พร้อมตรวจยอดขั้นต่ำ ระยะเวลาดำเนินการ และข้อกำหนดการถอนเงินให้ครบก่อนทำรายการ
        </li>
        <li>
          <strong class="text-[#fb2e33]">ชื่อบัญชีปลายทางของผู้ให้บริการ</strong> ควรตรงกับข้อมูลที่ยืนยันได้จากเว็บไซต์ทางการ นี่คือจุดที่ใช้แยกรายการจริงออกจากบัญชีแอบอ้าง
        </li>
        <li>
          <strong class="text-[#fb2e33]">หมายเลขรายการและหลักฐานการทำธุรกรรม</strong> ควรเก็บไว้ทุกครั้งหลังฝากหรือถอน เพื่อใช้ตรวจสอบย้อนหลังหากยอดไม่เข้าตามที่ระบุ
        </li>
        <li>
          <strong class="text-[#fb2e33]">ช่องทางติดต่อแอดมิน 24ชม.</strong> ควรตรวจสอบจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีแอบอ้างที่ใช้ชื่อคล้ายกัน
        </li>
        <li>
          <strong class="text-[#fb2e33]">ความปลอดภัยของข้อมูลที่ใช้เข้าสู่ระบบ</strong> ควรตั้งรหัสผ่านที่คาดเดาได้ยาก และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้ใครทราบ แม้จะอ้างว่าเป็นเจ้าหน้าที่ก็ตาม
        </li>
      </ol>

      <p>
        <strong class="text-[#fb2e33]">หากพบชื่อบัญชีไม่ตรงกับข้อมูลทางการหรือมีการแจ้งเปลี่ยนบัญชีอย่างผิดปกติ ควรหยุดทำรายการทันที</strong>
        แล้วติดต่อธนาคารหรือผู้ให้บริการชำระเงินเพื่อตรวจสอบก่อนโอนเงิน และเมื่อแจ้งปัญหา ควรระบุรายละเอียดให้ชัดเจนพร้อมหลักฐานที่เกี่ยวข้อง
      </p>

      <p>
        หากมีข้อสงสัยเกี่ยวกับการเข้าสู่ระบบ รายชื่อค่ายเกม รายการฝากถอน หรือรายละเอียดโปรโมชั่น สามารถสอบถามเจ้าหน้าที่ผ่านช่องทางทางการของเว็บไซต์ได้
        <strong class="text-[#fb2e33]">ทั้งนี้ ควรตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุดอีกครั้ง</strong>
        เพราะช่วงเวลาที่เจ้าหน้าที่รับเรื่องอาจปรับเปลี่ยนได้ตามที่ผู้ให้บริการกำหนด
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/register" aria-label={`สมัครสมาชิก ${BRAND_NAME}`} class={ctaPrimary}>สมัครสมาชิก</a>

        <a href="/login" aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`} class={ctaSecondary}>เข้าสู่ระบบ</a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
