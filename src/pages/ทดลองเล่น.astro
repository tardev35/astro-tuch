---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login,
// /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx
// ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บน
// ข้อเท็จจริงของ NAZA99 เท่านั้น (src/assets/content.txt)
//
// NAZA99 เป็น **เว็บสล็อตออนไลน์** แง่มุมที่บรีฟระบุไว้มีเท่านี้: รวมเกมสล็อตหลาย
// สไตล์จากค่ายยอดนิยมไว้ในระบบเดียว · เกมโบนัส ฟรีสปิน ตัวคูณ ฟีเจอร์ใหม่ ·
// รองรับมือถือและคอมพิวเตอร์ · บัญชีเดียวเลือกเกม ตรวจโปรโมชั่น ติดตามรายการ ·
// สามเกมแนะนำ Mahjong Ways 2 (ไพ่นกกระจอก ตัวคูณ+ฟรีสปิน) / Fortune Tiger
// (เสือนำโชค วงล้อเข้าใจง่าย) / Sweet Bonanza (ขนม-ผลไม้ จ่ายแบบกลุ่มสัญลักษณ์
// + ฟรีสปิน + ตัวคูณ) · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · สมัคร 3 ขั้นตอน ·
// แอดมิน 24 ชั่วโมง · PIN/OTP ห้ามเปิดเผย
//
// แบรนด์ก่อนหน้าในไฟล์นี้เป็น **เว็บหวย** (หวย365 / หวยเฮง789) คนละสินค้ากันหมด —
// ย่อหน้าที่พูดถึงประเภทหวย รอบ/งวด โพย เลขที่เลือก อัตราจ่าย 2 ตัว 100 บาท
// 3 ตัว 1,000 บาท แนวทางหวย และสถิติย้อนหลัง ถูกถอดออก **ทั้งย่อหน้า** ไม่ใช่
// find-and-replace ทับประโยคเดิม · ลิงก์ที่ชี้ไปหน้าหวยของรอบก่อนถูกถอดออกด้วย
// เพราะหน้านั้นย้ายไป src/pages-disabled/ แล้วใน P1 (href ไปหน้าที่ไม่มีอยู่ = build แดง)
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามี "โหมดทดลอง" เครดิตทดลอง หรือเกมเดโมเป็นบริการของเว็บ —
// จึงห้ามสัญญาสินค้าตัวนั้น และห้ามดึง src/assets/gamedemo*.webp กลับมาเด็ดขาด
// หน้านี้จึงพูดถึงเฉพาะสิ่งที่บรีฟระบุไว้ตรงๆ ว่าควรทำก่อนเริ่มเล่น นั่นคือ
// "ตรวจสอบกติกา ช่วงเดิมพัน และรายละเอียดฟีเจอร์ของแต่ละเกมก่อนเริ่มเล่น"
// = ไล่ดูเกมและฟีเจอร์ในระบบให้ครบก่อนปั่นรอบจริง ไม่ใช่การเล่นฟรี
//
// ตัวเลขที่อ้างได้มีแค่ 0.3% · 0.8% · 3 เกม · 3 ขั้นตอน · 24 ชั่วโมง
// ห้ามเพิ่มใบอนุญาต ชื่อค่าย/ผู้ให้บริการนอกจากสามเกมข้างบน ชื่อธนาคาร
// ยอดฝากขั้นต่ำ จำนวนสมาชิก ปีที่ก่อตั้ง หรือความเร็วฝาก-ถอน ที่บรีฟไม่ได้ระบุ
//
// hedge ของบรีฟที่ห้ามตัดทิ้ง: "แตกหนัก"/"ปั่นแตกง่ายที่สุด" ใช้รับประกันผลลัพธ์
// ไม่ได้เพราะเกมสล็อตให้ผลลัพธ์แบบสุ่ม · แต่ละรายการโปรโมชั่นอาจกำหนดค่ายเกมและ
// เงื่อนไขต่างกัน ควรอ่านก่อนกดรับ · จำนวนเกมและช่วงอัปเดตขึ้นอยู่กับค่ายและ
// ผู้ให้บริการ · ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: banner1/banner1-mobile/og.png เป็นของ glob ที่
// MainLayout ปักไว้ ห้ามอ้างจากหน้า · slide1/slide2 ของดรอปนี้เป็นของ index และ
// /promotion · slide3/slide4/banner2/banner3 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น AnnouncementPremium ทั้งเว็บ (รอบก่อนหน้าย่อยใช้ตัว
// Cyber) — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ
// NAZA99 แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่
// ตรงกันทั้งเว็บ
//
// พาเลตต์ NAZA99 (brand-spec §2) **ทองล้วนบนดำ ไม่มีฮิวที่สอง** ความต่างสร้างจาก
// ระดับความสว่างของทอง: ทองอ่อน/แชมเปญ #fdf2ac (หมึกเน้น) · ทองแบรนด์ #e4b34d
// (ขอบ จุด bullet marker) · ทองเข้ม #c08f2b (ปลายเกรเดียนต์ปุ่ม) · ทองลึก #8a5f12
// (ขอบปุ่มหลัก) · ผิวการ์ด #140c02 · ผิวยกระดับ #241404 (ปุ่ม secondary) ·
// หมึกบนพื้นทอง #1a1000 · เนื้อความ #f3e8cf (BRAND_TEXT)
// ชุดแดงสด-ทองของ หวย365 (#dc0203 #f5282a #9c0201 #ffc93c #ffeab0 #c08a07 #240406
// #180303 #f6e7e0 #1a0303 rgba(255,201,60,*) rgba(220,2,3,*)) ออกครบทุกจุดแล้ว
// กฎคอนทราสต์: พื้นทอง → หมึกเข้ม #1a1000 เสมอ ห้ามวางหมึกอ่อนบนพื้นทอง
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// — การ์ดตั้งสีเนื้อความไว้แล้ว ย้ำบนย่อหน้าอีกชั้นเพื่อให้สี body copy อ่านออกจาก
// ตัวหน้าเอง
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 157
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "ทดลองเล่นสล็อต NAZA99 ด้วยการไล่ดูกติกา ช่วงเดิมพัน และรายละเอียดฟีเจอร์ของแต่ละเกมให้ครบก่อนเริ่มเล่นจริง พร้อมสามเกมแนะนำประจำหมวดและข้อควรรู้เรื่องผลลัพธ์";

const pageTitle = "ทดลองเล่นสล็อต NAZA99 ไล่ดูกติกา ฟีเจอร์ และช่วงเดิมพันก่อนเริ่มเล่นจริง";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed text-[#f3e8cf]">
        <strong class="text-[#fdf2ac]">NAZA99</strong> เป็นเว็บสล็อตที่รวบรวมเกมสล็อตหลายสไตล์จากค่ายยอดนิยมไว้ในระบบเดียว
        <strong class="text-[#fdf2ac]">ทั้งเกมโบนัส ฟรีสปิน ตัวคูณ และฟีเจอร์ใหม่ที่ช่วยเพิ่มรูปแบบการเล่นให้หลากหลาย</strong>
        หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับเกมสล็อตได้ไล่ดูระบบให้ครบหนึ่งรอบ ตั้งแต่หมวดเกมที่เปิดให้เลือก ไปจนถึงหน้ารายละเอียดของเกมที่สนใจ ก่อนจะเริ่มปั่นรอบจริง
      </p>

      <p class="text-left text-base leading-relaxed text-[#f3e8cf]">
        คำว่า “ทดลองเล่น” ที่หน้านี้พูดถึงจึงหมายถึง<strong class="text-[#fdf2ac]">การตรวจสอบกติกา ช่วงเดิมพัน และรายละเอียดฟีเจอร์ของแต่ละเกมให้ครบก่อนเริ่มเล่น</strong>
        ตามที่เว็บไซต์แนะนำไว้เอง ไม่ใช่การลุ้นผลรางวัล ระบบรองรับการเข้าใช้งานผ่านมือถือและคอมพิวเตอร์ จึงเลือกเกม ตรวจสอบโปรโมชั่น และติดตามรายการจากบัญชีเดียวได้สะดวก
      </p>
    </div>
  </ContentBox>

  <ContentBox title="3 เกมสล็อตแนะนำของ NAZA99 และฟีเจอร์ที่ควรไล่ดูก่อนปั่น" as="h2">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed text-[#f3e8cf]">
        NAZA99 มีเกมสล็อตหลายรูปแบบให้เลือก โดย<strong class="text-[#fdf2ac]">3 เกมที่เว็บไซต์หยิบมาจัดหมวดแนะนำมีฟีเจอร์และรูปแบบการเล่นต่างกันชัดเจน</strong>
        จึงเป็นชุดที่เหมาะกับการเปิดดูเทียบกันก่อน เพราะช่วยให้เห็นว่าสล็อตแต่ละแบบนับการจ่ายและให้จังหวะโบนัสไม่เหมือนกัน
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f3e8cf]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e4b34d]">🀄</span>
          <span>
            <strong class="text-[#fdf2ac]">Mahjong Ways 2</strong> มาในธีมไพ่นกกระจอก จุดเด่นอยู่ที่ระบบตัวคูณและฟีเจอร์ฟรีสปิน แต่ละรอบจึงมีรายละเอียดให้ติดตามมากกว่าเกมสล็อตพื้นฐาน ก่อนเริ่มควรไล่ดูว่าตัวคูณทำงานตอนไหนและฟรีสปินเข้าเงื่อนไขอย่างไร
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e4b34d]">🐯</span>
          <span>
            <strong class="text-[#fdf2ac]">Fortune Tiger</strong> ใช้ธีมเสือนำโชคและรูปแบบวงล้อที่เข้าใจง่าย มีฟีเจอร์ภายในเกมที่ช่วยเพิ่มจังหวะการเล่น จึงเป็นเกมที่อ่านหน้าจอได้เร็วที่สุดในชุดนี้สำหรับผู้ที่เพิ่งเริ่มต้น
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e4b34d]">🍬</span>
          <span>
            <strong class="text-[#fdf2ac]">Sweet Bonanza</strong> มาในธีมขนมและผลไม้ ใช้ระบบจ่ายแบบกลุ่มสัญลักษณ์ พร้อมฟรีสปินและตัวคูณเป็นองค์ประกอบหลัก การจ่ายจึงนับจากกลุ่มสัญลักษณ์ที่ออก ไม่ใช่แนวเรียงแบบที่หลายคนคุ้นเคย
          </span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#f3e8cf]">
        <strong class="text-[#fdf2ac]">จำนวนเกมและช่วงเวลาอัปเดตขึ้นอยู่กับค่ายและผู้ให้บริการ</strong>
        ก่อนเล่นจึงควรตรวจสอบว่าเกมที่สนใจเปิดให้บริการอยู่ในระบบหรือไม่ และหากมีเกมใหม่เพิ่มเข้ามาระหว่างเดือน สามารถดูรายการล่าสุดจากหมวดเกมใหม่หรือประกาศบนเว็บไซต์ได้โดยตรง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="จุดที่ควรตรวจให้ครบก่อนเริ่มเล่นสล็อตรอบจริง" as="h2">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed text-[#f3e8cf]">
        การไล่ดูระบบมีประโยชน์ที่สุดเมื่อมองมันเหมือนการอ่านคู่มือของเกม
        <strong class="text-[#fdf2ac]">เป้าหมายคือรู้จักกติกาและฟีเจอร์ของเกมให้ครบก่อนที่เงินจริงจะเข้ามาเกี่ยวข้อง</strong>
        เรื่องด้านล่างคือสิ่งที่ควรเก็บข้อมูลไว้ระหว่างเปิดดู และควรตรวจซ้ำทุกครั้งที่เปลี่ยนไปเล่นเกมอื่น
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f3e8cf]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e4b34d]">📜</span>
          <span>
            <strong class="text-[#fdf2ac]">กติกาและรูปแบบการจ่ายของเกมนั้น</strong> เป็นสิ่งแรกที่ควรอ่าน เพราะสล็อตบางเกมนับการจ่ายเป็นแนวเรียง บางเกมนับเป็นกลุ่มสัญลักษณ์ การเข้าใจผิดตรงนี้ทำให้อ่านผลของแต่ละรอบคลาดเคลื่อนทั้งเกม
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e4b34d]">🎚️</span>
          <span>
            <strong class="text-[#fdf2ac]">ช่วงเดิมพันที่เกมเปิดให้เลือก</strong> ควรดูให้ครบก่อนกดปั่นรอบแรก เพราะแต่ละเกมไม่ได้กำหนดช่วงไว้เท่ากัน และเป็นค่าที่ควรตั้งให้สอดคล้องกับงบที่วางไว้ล่วงหน้า
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e4b34d]">🎁</span>
          <span>
            <strong class="text-[#fdf2ac]">รายละเอียดฟีเจอร์ภายในเกม</strong> ทั้งเกมโบนัส ฟรีสปิน และตัวคูณ ควรรู้ว่าแต่ละอย่างเข้าเงื่อนไขตอนไหนและทำงานอย่างไร เพราะเป็นส่วนที่ทำให้จังหวะของแต่ละรอบต่างกันมากที่สุด
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e4b34d]">📋</span>
          <span>
            <strong class="text-[#fdf2ac]">เงื่อนไขของโปรโมชั่นที่กำลังใช้อยู่</strong> ทั้งคืนยอดเสีย โบนัส 0.3% และแนะนำเพื่อน โบนัส 0.8% แต่ละรายการอาจกำหนดค่ายเกมและเงื่อนไขแตกต่างกัน จึงควรอ่านรายละเอียดก่อนกดรับ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e4b34d]">🗂️</span>
          <span>
            <strong class="text-[#fdf2ac]">ประวัติรายการและเครดิตในบัญชีของตัวเอง</strong> ควรกลับมาตรวจสอบให้เรียบร้อยหลังเล่นทุกครั้ง แทนการอ้างจากความจำของรอบก่อนหน้า เพราะทั้งหมดดูย้อนหลังได้จากบัญชีเดียว
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e4b34d]">🔐</span>
          <span>
