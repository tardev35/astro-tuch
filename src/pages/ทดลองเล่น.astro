---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxHuay.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";

import { pageGraph } from "../lib/schema";

// LOTTOKA เป็นเว็บแทงหวยออนไลน์ล้วนๆ ไม่มีสล็อต บาคาร่า ยิงปลา หรือกีฬา —
// หน้านี้จึงไม่ใช่ "ทดลองเล่นสล็อต" อีกต่อไป แต่คือการพาผู้เริ่มต้นดูว่า
// การแทงหวยที่นี่ทำงานอย่างไรตั้งแต่เลือกตลาดจนถึงเช็กบิลย้อนหลัง
// ก่อนตัดสินใจเติมเครดิตจริง (เนื้อหาคาสิโนของแบรนด์ก่อนหน้าถูกเขียนใหม่ทั้งหน้ารอบนี้)
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: แบรนด์เก่าเคยวางแกลเลอรีเดโมสล็อต 12 การ์ด
// (gamedemo7..18.webp) ไว้ที่นี่ ถูกถอด import ออกไปหลายรอบรีแบรนด์แล้ว และ
// เว็บหวยไม่มีเกมให้เดโมจึงไม่มีอะไรให้ภาพชุดนั้นอธิบาย — อย่านำกลับมา
// ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง
// ถ้ามีรูปที่ไม่มีใคร render ทั้งชุด (ไฟล์ยังอยู่บนดิสก์ ห้ามลบ เป็นอินเวนทอรี)
//
// ข้อเท็จจริงทุกบรรทัดมาจาก src/assets/content.txt เท่านั้น:
// แพลตฟอร์มหลักเว็บตรง ไม่ผ่านเอเย่นต์ · ยอดฝาก-ถอนเข้าบัญชีของบริษัทโดยตรง
// ไม่ใช้บัญชีม้า เข้าเต็ม 100% ไม่หักค่าธรรมเนียม · หวยรัฐบาลไทยออกวันที่ 1 และ 16 ·
// หวยลาวพัฒนาออกจันทร์ พุธ ศุกร์ · หวยออมสินอ้างอิงผลสลากออมสิน ·
// หวยฮานอยออกทุกวัน มีปกติ/พิเศษ/VIP · หวยหุ้นไทยและต่างประเทศ นิเคอิ ดาวโจนส์
// ฮั่งเส็ง · 2 ตัวบาทละ 100 · 3 ตัวตรงบาทละ 1,000 · จ่ายเต็มทุกบิล ไม่หักเปอร์เซ็นต์ ·
// รับแทงทุกเลข ไม่มีเลขอั้น จ่ายตามเรทในบิล ไม่หักย้อนหลัง · สมัครออโต้ 3 ขั้นตอน
// (OTP · ผูกบัญชีธนาคารหรือ TrueMoney Wallet ชื่อตรงกับผู้สมัคร · ตั้งรหัสผ่าน) ·
// ทุกธนาคารและวอลเลท ระบบออโต้ ไม่มีขั้นต่ำในการฝาก · แอดมิน Line Official 24 ชั่วโมง
// — ห้ามอ้างเลขใบอนุญาต ปีที่ก่อตั้ง จำนวนสมาชิก หรือการันตีว่าถูกรางวัล
//
// Announcement รอบนี้หมุนมาใช้ AnnouncementHuay ทั้งเว็บ — default message ของ
// ไฟล์นั้นเป็นข้อความของ LOTTOKA อยู่แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message
//
// พาเลตต์ LOTTOKA: แดงโลโก้ #c21e22 นำโครงสร้าง แดงสว่าง #e2353a สำหรับ hover
// ไอคอน และข้อควรระวัง ชมพูอ่อน #ff9a9d เป็นสีเดียวที่ใช้กับ <strong>
// ครีม #ffe9ea บนปุ่มแดง เนื้อความ #ded9da — ไม่มีทองหรือน้ำเงิน
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 156
const pageDescription = "ทดลองเล่น LOTTOKA ทำความรู้จักวิธีแทงหวยออนไลน์ทีละขั้นตอน ตั้งแต่เลือกประเภทหวย เลือกเลข ตรวจอัตราจ่ายที่ระบบแสดง ยืนยันโพย ไปจนถึงสมัครสมาชิกด้วยระบบออโต้";

const graph = pageGraph(Astro, {
  name: "ทดลองเล่น LOTTOKA ทำความรู้จักวิธีแทงหวยก่อนลงเงินจริง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title="ทดลองเล่น LOTTOKA เรียนรู้วิธีแทงหวยออนไลน์ก่อนลงเงินจริง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่น LOTTOKA ทำความรู้จักวิธีแทงหวยก่อนลงเงินจริง" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ded9da]">
        <strong class="text-[#ff9a9d]">LOTTOKA</strong> คือเว็บแทงหวยออนไลน์ที่เป็นแพลตฟอร์มหลักเว็บตรง ไม่ผ่านเอเย่นต์ เปิดรับครบทั้งหวยรัฐบาลไทย หวยลาวพัฒนา หวยออมสิน หวยฮานอย และหวยหุ้นไทยกับต่างประเทศ
        หน้านี้เปิดไว้ให้คนที่ยังไม่เคยแทงหวยออนไลน์ได้<strong class="text-[#ff9a9d]">เห็นภาพรวมทั้งกระบวนการก่อนเติมเครดิตจริง</strong>
        ตั้งแต่เลือกตลาดหวย เลือกเลข อ่านอัตราจ่ายที่ระบบแสดง ยืนยันโพย ไปจนถึงย้อนกลับมาเช็กบิลของตัวเองได้ทุกเมื่อ
      </p>

      <p class="text-left text-base leading-relaxed text-[#ded9da]">
        ขอให้เข้าใจตรงกันว่าการอ่านหน้านี้เป็นการทำความคุ้นเคยกับระบบเท่านั้น
        <strong class="text-[#e2353a]">ผลรางวัลของแต่ละงวดไม่แน่นอน และไม่มีเลขใดรับประกันว่าจะถูกรางวัล</strong>
        สิ่งที่เรารับประกันได้คืออัตราจ่ายตามเรทในบิลและยอดเงินที่เข้าเต็มจำนวน หากติดปัญหาระหว่างใช้งาน แจ้งแอดมิน LOTTOKA ผ่าน Line Official ได้ตลอด 24 ชั่วโมง
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="วิธีแทงหวยกับ LOTTOKA ทีละขั้นตอนตั้งแต่เลือกเลขจนถึงเช็กบิล" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ded9da]">
        ขั้นตอนการส่งโพยหนึ่งใบใช้เวลาไม่ถึงหนึ่งนาที และเป็นลำดับเดียวกันไม่ว่าคุณจะเลือกตลาดหวยแบบไหน
        <strong class="text-[#ff9a9d]">ตัวเลขทุกอย่างที่ใช้ตัดสินใจจะถูกแสดงบนหน้าจอก่อนกดยืนยันเสมอ</strong> ให้อ่านให้ครบก่อนตัดสินใจว่าจะลงเท่าไร
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#ded9da]">
        <li class="flex gap-3">
          <span class="font-bold text-[#e2353a]">1.</span>
          <span><strong class="text-[#ff9a9d]">เลือกประเภทหวย</strong> เปิดรายการตลาดหวยที่ยังเปิดรับอยู่ในรอบนั้น แล้วเลือกงวดที่ต้องการ ระบบจะแสดงเวลาปิดรับโพยของงวดนั้นไว้ให้เห็นชัดเจน</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#e2353a]">2.</span>
          <span>
            <strong class="text-[#ff9a9d]">เลือกเลขและประเภทการแทง</strong> ระบุตัวเลขที่ต้องการ พร้อมเลือกว่าจะแทงแบบ 2 ตัวบน 2 ตัวล่าง หรือ 3 ตัวตรง แล้วใส่ยอดเงินที่จะลงในแต่ละเลข
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#e2353a]">3.</span>
          <span>
            <strong class="text-[#ff9a9d]">ตรวจอัตราจ่ายและวงเงินที่ระบบแสดง</strong> ก่อนยืนยัน ระบบจะสรุปเรทที่ใช้กับเลขแต่ละตัวและยอดรวมทั้งโพยให้ดู ให้ยึดตัวเลขชุดนี้เป็นหลัก เพราะเป็นเรทที่ผูกกับบิลใบนั้นจริง
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#e2353a]">4.</span>
          <span>
            <strong class="text-[#ff9a9d]">ยืนยันโพย</strong> เมื่อกดยืนยันและระบบบันทึกสำเร็จก่อนเวลาปิดรับ ถือว่าโพยใบนั้นสมบูรณ์ หากถูกรางวัล เราจ่ายเต็มจำนวนตามเรทที่กำหนดไว้ในบิล โดยไม่หักเปอร์เซ็นต์ย้อนหลัง
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#e2353a]">5.</span>
          <span><strong class="text-[#ff9a9d]">เช็กบิลย้อนหลังได้เอง</strong> โพยทุกใบถูกเก็บไว้ในบัญชีของคุณ เปิดดูเลขที่แทง เรทที่ได้ และผลของงวดนั้นย้อนหลังได้เองโดยไม่ต้องถามแอดมิน</span>
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#ded9da]">
        <strong class="text-[#e2353a]">รอบที่เปิดรับและเวลาปิดรับโพยเปลี่ยนไปตามงวดของแต่ละตลาด จึงควรตรวจรอบล่าสุดในหน้าเลือกหวยก่อนส่งโพยทุกครั้ง</strong>
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ตลาดหวยที่ LOTTOKA เปิดรับและวันออกรางวัลของแต่ละแบบ" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ded9da]">
        สิ่งแรกที่ควรรู้ก่อนลองแทงคือแต่ละตลาดหวยออกรางวัลคนละวันกัน คนที่อยากลุ้นทุกวันกับคนที่รอลุ้นเดือนละสองครั้งจึงเลือกตลาดไม่เหมือนกัน
        <strong class="text-[#ff9a9d]">LOTTOKA เปิดรับครบทุกแนวในเว็บเดียว</strong> ใช้บัญชีเดียวสลับไปมาระหว่างตลาดได้ทันที
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#ded9da]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e2353a]">🏛️</span>
          <span><strong class="text-[#ff9a9d]">หวยรัฐบาลไทย</strong> ออกรางวัลวันที่ 1 และ 16 ของเดือน เปิดรับแทงล่วงหน้า ปิดรับช้า ให้เวลาคุณหาเลขเด็ดได้อย่างเต็มที่</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ff8a8d]">🌏</span>
          <span><strong class="text-[#ff9a9d]">หวยลาว (ลาวพัฒนา)</strong> หวยยอดฮิตฝั่งโขง ออกรางวัลทุกวันจันทร์ พุธ และศุกร์ ลุ้นง่าย จ่ายหนัก เหมาะกับคนที่อยากมีงวดให้ลุ้นกลางสัปดาห์</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e2353a]">🏦</span>
          <span><strong class="text-[#ff9a9d]">หวยออมสิน</strong> อีกหนึ่งทางเลือกสำหรับคนชอบหวยไทย อ้างอิงผลสลากออมสิน จึงตรวจผลย้อนกลับได้และมั่นใจได้ในความโปร่งใส</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ff8a8d]">🕐</span>
          <span><strong class="text-[#ff9a9d]">หวยฮานอย (เวียดนาม)</strong> ลุ้นสนุกได้ทุกวันไม่มีวันหยุด มีทั้งฮานอยปกติ ฮานอยพิเศษ และฮานอย VIP ให้เลือกรอบที่ถนัด</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e2353a]">📈</span>
          <span><strong class="text-[#ff9a9d]">หวยหุ้นต่างประเทศและหุ้นไทย</strong> ตอบสนองสายวิเคราะห์ด้วยหวยหุ้นชั้นนำ เช่น นิเคอิ ดาวโจนส์ ฮั่งเส็ง และอื่นๆ อีกมากมาย</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#ded9da]">
        เรื่องอัตราจ่ายไม่ต้องคิดเผื่อ ทุกตลาดยึดหลักเดียวกันคือ<strong class="text-[#ff9a9d]">2 ตัวบนและ 2 ตัวล่างสูงสุดบาทละ 100 ส่วน 3 ตัวตรงสูงสุดบาทละ 1,000</strong>
        จ่ายเต็มทุกบิล ไม่หักเปอร์เซ็นต์ และรับแทงทุกเลข ไม่มีปิดกั้นเลขอั้น
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="สมัคร LOTTOKA ด้วยระบบออโต้ 3 ขั้นตอน แล้วเริ่มแทงหวยได้ทันที" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ded9da]">
        เมื่อเห็นภาพรวมแล้วและอยากลงสนามจริง เริ่มต้นได้ง่ายๆ ผ่าน<strong class="text-[#ff9a9d]">ระบบสมัครสมาชิกอัตโนมัติ (Auto)</strong> ที่ใช้เวลาเพียงไม่กี่วินาที
        ทำเองได้ทั้งหมดบนโทรศัพท์มือถือ ไม่ต้องรอแอดมินเปิดบัญชีให้
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#ded9da]">
        <li class="flex gap-3">
          <span class="font-bold text-[#e2353a]">1.</span>
          <span><strong class="text-[#ff9a9d]">กรอกเบอร์โทรศัพท์</strong> ระบุเบอร์มือถือที่ใช้งานจริง เพื่อรับรหัส OTP สำหรับการยืนยันตัวตนและความปลอดภัยของข้อมูล</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#e2353a]">2.</span>
          <span>
            <strong class="text-[#ff9a9d]">ผูกบัญชีธนาคารหรือวอลเลท</strong> เลือกธนาคารหรือ TrueMoney Wallet แล้วระบุเลขบัญชี โดยชื่อ-นามสกุลต้องตรงกับชื่อที่สมัคร เพื่อให้ระบบโอนยอดเข้า-ออกบริษัทโดยตรงได้อย่างถูกต้อง
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#e2353a]">3.</span>
          <span><strong class="text-[#ff9a9d]">ตั้งรหัสผ่าน</strong> กำหนดรหัสผ่านที่รัดกุม ล็อคอินเข้าสู่ระบบ เติมเงินฝากเครดิต แล้วเริ่มแทงหวยได้ทันที</span>
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#ded9da]">
        การฝากและถอนรองรับทุกธนาคารชั้นนำในประเทศไทยรวมถึง TrueMoney Wallet ทำงานด้วยระบบออโต้ที่รวดเร็วทันใจ และ<strong class="text-[#ff9a9d]">ไม่มีขั้นต่ำในการฝากเงิน</strong>
        ทุกยอดวิ่งเข้าบัญชีของบริษัทโดยตรง ไม่ผ่านบัญชีม้า จึงรับเงินเข้าเต็ม 100% ไม่มีหักค่าธรรมเนียม
      </p>

      <p class="text-left text-base leading-relaxed text-[#ded9da]">
        <strong class="text-[#e2353a]">ตั้งรหัสผ่านที่คาดเดายาก ไม่ใช้รหัสเดียวกับบริการอื่น และไม่เปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น</strong>
