---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login, /register)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริง
// ของ หวยเต็ง เท่านั้น
//
// หวยเต็ง เป็น **เว็บแทงหวยออนไลน์** ที่รวมรายการหวยยอดนิยมไว้ให้เลือกผ่านบัญชีเดียว
// ส่วนแบรนด์ก่อนหน้า (BRAVO168) เป็นเว็บแทงบอล/สปอร์ตบุ๊ก และก่อนหน้านั้น (CK268)
// เป็นเว็บเกมสล็อต ซึ่งบรีฟรอบนี้ไม่ได้พูดถึงเลยสักคำ จึงถอดออกทั้งชุด ห้าม
// find-and-replace ชื่อแบรนด์ทับประโยคเดิม มิฉะนั้นเว็บจะไปอ้างสินค้าที่ไม่มีอยู่จริง
// (คำห้ามจาก brand-spec §1: บอล ฟุตบอล บอลเดี่ยว บอลสเต็ป บอลสด ค่าน้ำ อัตราต่อรอง
// ลีก คู่แข่งขัน แมตช์ บิล แฮนดิแคป สล็อต ฟรีสปิน แจ็กพอต บาคาร่า รูเล็ต คาสิโน RTP)
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามี "โหมดทดลอง" หรือเครดิตทดลองเป็นบริการของเว็บ — จึงห้าม
// สัญญาสินค้าตัวนั้น หน้านี้จึงพูดถึงเฉพาะสิ่งที่ผู้เข้าชม "ดูได้จริง" ก่อนส่งโพยแรก
// ตามที่บรีฟระบุไว้: เลือกเลข ส่งโพย ตรวจสอบรายการ อัตราจ่าย และผลหวยตามรอบที่เปิด
// ให้บริการได้จากระบบเดียว ผ่านมือถือโดยไม่ต้องสลับหลายเว็บไซต์
//
// ข้อเท็จจริงทุกบรรทัดมาจาก content.txt เท่านั้น: รวมรายการหวยยอดนิยมผ่านบัญชีเดียว ·
// รัฐบาลไทย ลาวพัฒนา ฮานอยปกติ ฮานอยพิเศษ ฮานอยวีไอพี หวยหุ้นต่างประเทศ ·
// หวยแต่ละประเภทมีตารางเวลาและเงื่อนไขแตกต่างกัน · ก่อนส่งโพยตรวจชื่อรายการ
// เลขที่เลือก ยอดเดิมพัน เวลาปิดรับ และอัตราจ่ายของรอบนั้น · 2 ตัว จ่าย 100 บาท ·
// 3 ตัว จ่าย 1,000 บาท · สมัคร 3 ขั้นตอน · แอดมิน 24 ชั่วโมง
// — ตัวเลขที่อ้างได้มีแค่ 100 บาท 1,000 บาท 3 ขั้นตอน และ 24 ชั่วโมง
// ห้ามเพิ่มชื่อผู้ให้บริการ ชื่อธนาคาร ขั้นต่ำฝากถอน เลขใบอนุญาต ปีที่ก่อตั้ง
// หรือจำนวนสมาชิกที่บรีฟไม่ได้ระบุ · บรีฟรอบนี้ไม่มีโปรโมชั่น/โบนัสเลยสักรายการ
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: banner1/banner1-mobile/og.png เป็นของ glob ที่
// MainLayout ปักไว้ ห้ามอ้างจากหน้า · slide1/slide2 ของดรอปนี้เป็นของ index และ
// /promotion · slide3/slide4/banner2/banner3 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
// ส่วน gamedemo7–18.webp ที่ยังค้างใน src/assets เป็นภาพหน้าจอเกมสล็อตของแบรนด์เก่า
// ไม่มีโค้ดไหน import แล้ว และห้ามนำกลับมาใช้บนเว็บหวย
//
// Announcement รอบนี้เป็น Announcement3 ทั้งเว็บ — orchestrator ตั้ง default message
// ของไฟล์นั้นเป็นคอปปี้ของ หวยเต็ง แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message
// มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ หวยเต็ง เป็น **เขียวป่า + ทอง** ตามโลโก้ (คำว่า "หวย" เขียวมรกต คู่กับ
// "เต็ง" ทองตัน) และแบนเนอร์ฉากคืนสีเขียวป่าที่มีริ้วแสงทอง เหรียญทอง ลูกหวยทอง
// และเงาวัดสีทอง: พื้นเข้มสุด #03150a · การ์ด #062a12 · ผิวยก #0b3d18 ·
// เส้น/ขอบ #024a0f · เขียวแบรนด์ #026314 · เขียวสว่าง #0bb42f · ทองหลัก #e5c04f ·
// ทองอ่อน #fae474 · ทองเข้ม #bd8d2d · เนื้อความ #d8ead9 (BRAND_TEXT) ·
// หมึกบนพื้นทอง #0a1a0c
// เรืองแสง: ทอง rgba(229,192,79,0.30) · เขียว rgba(2,99,20,0.35)
// ชุดน้ำเงินรอยัล-ทองของ BRAVO168 (#02081a #04142f #072247 #0e3f8f #1558c4 #2f86f0
// #f4cb69 #ffe39a #c9922e #e8f1ff #a8bedd #dbe5f5 #0a1020 rgba(244,203,105,*)
// rgba(21,88,196,*)) ออกครบทุกจุดแล้ว ทั้งคลาส Tailwind raw hex และ rgba()
// กฎคอนทราสต์: พื้นทอง → หมึกเข้ม #0a1a0c · ตัวอักษรบนการ์ดเขียวใช้ #d8ead9 #fae474
// #e5c04f #0bb42f เท่านั้น ส่วน #026314 / #024a0f / #bd8d2d ใช้เป็นพื้นและขอบ
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลางที่ orchestrator รีธีมรอบนี้) — การ์ดตั้ง
// สีเนื้อความไว้ให้แล้ว ย้ำไว้บนย่อหน้าอีกชั้นเพื่อให้สีของ body copy อ่านออกจาก
// ตัวหน้าเอง
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 154
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "ทดลองเล่น หวยเต็ง ด้วยการไล่ดูระบบจริงให้ครบก่อนส่งโพย ตั้งแต่เลือกประเภทหวยและรอบเวลา อ่านอัตราจ่าย ดูเวลาปิดรับ ไปจนถึงตรวจรายละเอียดโพยก่อนกดยืนยันจริง";

const pageTitle = "ทดลองเล่น หวยเต็ง ไล่ดูรายการหวยและอัตราจ่ายก่อนส่งโพยจริง";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d8ead9]">
        <strong class="text-[#fae474]">หวยเต็ง</strong> รวมรายการหวยยอดนิยม
        <strong class="text-[#fae474]">ไว้ให้เลือกผ่านบัญชีเดียว</strong> ทั้งหวยรัฐบาลไทย ลาวพัฒนา ฮานอย และหวยหุ้นต่างประเทศ หน้านี้เปิดไว้ให้คนที่ยังไม่คุ้นกับระบบได้ลองเปิดใช้งานจริงหนึ่งรอบ ตั้งแต่หน้ารายการหวยที่เปิดรับ
        ไปจนถึงหน้าสรุปโพยที่แสดงเลขที่เลือกและอัตราจ่าย ก่อนจะยืนยันโพยใบแรก
      </p>

      <p class="text-left text-base leading-relaxed text-[#d8ead9]">
        คำว่า “ทดลองเล่น” ที่หน้านี้พูดถึงจึงหมายถึง<strong class="text-[#fae474]">
          การเดินให้ครบทุกขั้นของการใช้งาน ตั้งแต่ Login เลือกประเภทหวยและรอบ เลือกเลข อ่านอัตราจ่าย ดูเวลาปิดรับ ไปจนถึงตรวจรายละเอียดโพยและประวัติรายการ
        </strong>
        เว็บไซต์ระบุไว้ว่าสมาชิกสามารถเลือกเลข ส่งโพย ตรวจสอบรายการ อัตราจ่าย และผลหวยตามรอบที่เปิดให้บริการได้จากระบบเดียวบนมือถือ ซึ่งเป็นสิ่งที่ผู้เข้าชมไล่ดูได้ทั้งหมดก่อนส่งโพยจริงรอบแรก
      </p>
    </div>
  </ContentBox>

  <ContentBox title="เปิด หวยเต็ง ดูรายการหวยและรอบเวลาได้จากมือถือ" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d8ead9]">
        จุดที่ช่วยให้เริ่มต้นได้เร็วที่สุดคือ<strong class="text-[#fae474]">รายการหวยหลายประเภทถูกรวมไว้ในบัญชีเดียว และสลับประเภทได้จากระบบเดิม</strong>
        สมาชิกจึงไม่ต้องเปิดบัญชีแยกกันไปตามแต่ละรายการ และไล่ดูรอบที่สนใจได้จากระบบเดียวโดยไม่ต้องสลับหลายเว็บไซต์
      </p>

      <ol class="ml-6 list-decimal space-y-3 text-left text-base leading-relaxed text-[#d8ead9] marker:font-black marker:text-[#e5c04f]">
        <li>
          <strong class="text-[#fae474]">เปิดเว็บไซต์ หวยเต็ง จากช่องทางหลักก่อน</strong> การเข้าผ่านช่องทางที่เว็บไซต์ประกาศไว้จริงช่วยหลีกเลี่ยงเว็บไซต์ที่ไม่เกี่ยวข้อง แล้วบันทึกทางเข้านั้นไว้ใช้รอบถัดไป
        </li>
        <li>
          <strong class="text-[#fae474]">สมัครและยืนยันข้อมูลตามที่ระบบกำหนด แล้ว Login</strong> ทั้งหมดทำผ่านมือถือได้ หลังเข้าสู่ระบบจะเห็นรายการหวยที่เปิดรับและประวัติโพยของบัญชีตัวเอง
        </li>
        <li>
          <strong class="text-[#fae474]">ไล่ดูประเภทหวยและรอบที่ระบบเปิดรับในขณะนั้น</strong> ทั้งรัฐบาลไทย ลาวพัฒนา ฮานอยปกติ ฮานอยพิเศษ ฮานอยวีไอพี และหวยหุ้นต่างประเทศ รายการที่เปิดรับจริงในแต่ละวันขึ้นอยู่กับตารางของหวยแต่ละประเภท
          จึงควรดูจากรายการที่ระบบแสดงไว้เป็นหลัก
        </li>
        <li>
          <strong class="text-[#fae474]">เปิดดูอัตราจ่ายและเวลาปิดรับของรอบนั้นให้ครบ</strong> เพราะหวยแต่ละประเภทมีตารางเวลาและเงื่อนไขของตัวเอง อัตราจ่ายจึงไม่จำเป็นต้องเหมือนกันทุกรายการ
        </li>
        <li>
          <strong class="text-[#fae474]">ลองเลือกเลขแล้วอ่านหน้าสรุปโพยก่อนกดยืนยัน</strong> ขั้นนี้คือขั้นที่ควรทำช้าที่สุด เพราะเป็นหน้าจอสุดท้ายที่ยังแก้รายการได้ก่อนโพยจะถูกบันทึก
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#d8ead9]">
        <strong class="text-[#fae474]">ตารางเวลาและเงื่อนไขของแต่ละรอบเปลี่ยนแปลงได้ตามช่วงเวลา จึงควรตรวจสอบข้อมูลจากหน้าส่งโพยของรอบนั้นทุกครั้งก่อนยืนยัน</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ประเภทหวยที่ลองไล่ดูได้ใน หวยเต็ง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d8ead9]">
        ระหว่างไล่ดูระบบ สิ่งที่ควรจำให้ได้คือ<strong class="text-[#fae474]">หวยแต่ละประเภทมีรอบและเวลาปิดรับของตัวเอง</strong>
        ไม่ได้ใช้เงื่อนไขชุดเดียวกันทั้งหมด การรู้ว่าแต่ละประเภททำงานอย่างไรช่วยให้เลือกรอบที่เหมาะกับจังหวะของตัวเองได้เร็วขึ้น
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#d8ead9]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e5c04f]">🏛️</span>
          <span>
            <strong class="text-[#fae474]">หวยรัฐบาลไทย</strong> เปิดรับตามกำหนดออกรางวัลของแต่ละงวด เป็นกลุ่มที่อ่านตารางได้ง่ายที่สุดสำหรับคนเริ่มต้น ลองดูว่าหน้าส่งโพยแสดงเวลาปิดรับของงวดนั้นไว้อย่างไร
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#0bb42f]">🎫</span>
          <span>
            <strong class="text-[#fae474]">หวยลาวพัฒนา</strong> เปิดรับตามรอบของตัวเอง ลองเปิดดูสักรอบเพื่อให้เห็นว่าชื่อรายการและเวลาปิดรับถูกแสดงไว้ตรงไหนของหน้าส่งโพย
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e5c04f]">🕒</span>
          <span>
            <strong class="text-[#fae474]">หวยฮานอย ปกติ พิเศษ และวีไอพี</strong> แยกเป็นคนละรอบกันในวันเดียว จึงเป็นกลุ่มที่ควรอ่านชื่อรายการให้ละเอียดที่สุดก่อนยืนยัน เพื่อไม่ให้ส่งโพยผิดรอบ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#0bb42f]">📈</span>
          <span>
            <strong class="text-[#fae474]">หวยหุ้นต่างประเทศ</strong> เปิดรับตามตลาดและรอบเวลาที่ระบบกำหนด จำนวนรายการที่เลือกได้ในแต่ละวันจึงขึ้นอยู่กับตลาดที่เปิดในรอบนั้น
          </span>
        </li>
      </ul>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/promotion"
          aria-label="ดูภาพโปรโมชั่นทั้งหมดของ หวยเต็ง"
          class="flex items-center justify-center rounded-lg border border-[#024a0f] bg-[#0b3d18] px-8 py-3 font-bold text-[#d8ead9] shadow-[0_0_15px_rgba(2,99,20,0.35)] transition-all hover:scale-105 hover:border-[#e5c04f] hover:bg-[#062a12] hover:text-[#e5c04f]">
          ดูโปรโมชั่นทั้งหมด
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="จุดที่ควรตรวจให้ครบก่อนยืนยันโพย" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d8ead9]">
        การไล่ดูระบบมีประโยชน์ที่สุดเมื่อมองมันเหมือนการอ่านคู่มือ ไม่ใช่การลุ้นผลรางวัล
