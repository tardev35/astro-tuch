---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";

import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login, /register)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริง
// ของ หวยเฮง789 เท่านั้น (src/assets/content.txt)
//
// หวยเฮง789 เป็น **เว็บแทงหวยออนไลน์** ที่เปิดให้เลือกแทงหลายประเภทผ่านบัญชีเดียว
// แง่มุมที่บรีฟระบุไว้มีเท่านี้: รัฐบาลไทย / ฮานอย / ลาว / หุ้นต่างประเทศ ·
// เลขเด็ด เลขดัง · ไม่จำกัด แทงได้ไม่อั้น (ต้องมีคำกำกับเรื่องวงเงินของบรีฟติดไปด้วย) ·
// บัญชีเดียวครบทุกประเภท · เลือกเลขเอง ส่งโพย ตรวจอัตราจ่ายก่อนยืนยัน ·
// รองรับมือถือ · สมัคร 3 ขั้นตอน · แอดมิน 24 ชั่วโมง · 2 ตัว จ่าย 100 บาท ·
// 3 ตัว จ่าย 1,000 บาท
//
// แบรนด์ก่อนหน้า (หวยเฮง24) เป็นเว็บหวยเหมือนกันแต่คนละบรีฟ — "ลาวพัฒนา"
// "ฮานอยปกติ/พิเศษ/วีไอพี" "ฝากถอนวอลเลทและธนาคาร" และ "เช็คผลทันที" เป็นของบรีฟ
// รอบก่อน รอบนี้ไม่ได้ระบุไว้เลยจึงถอดออกทั้งชุด ห้าม find-and-replace ชื่อแบรนด์
// ทับประโยคเดิม มิฉะนั้นเว็บจะไปอ้างสินค้าที่ไม่มีอยู่จริง
// (คำห้ามจาก brand-spec §6: สล็อต ฟรีสปิน ตัวคูณ ค่ายเกม RTP แตกง่าย เว็บตรง บอล
// ค่าน้ำ อัตราต่อรอง ลีก บิลสเต็ป แฮนดิแคป คาสิโน บาคาร่า ไพ่ เกมยิงปลา)
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามี "โหมดทดลอง" หรือเครดิตทดลองเป็นบริการของเว็บ — จึงห้าม
// สัญญาสินค้าตัวนั้น หน้านี้จึงพูดถึงเฉพาะสิ่งที่ผู้เข้าชม "ดูได้จริง" ก่อนส่งโพยแรก
// ตามที่บรีฟระบุไว้: เลือกประเภทหวยและรอบ เลือกเลขเอง ดูเวลาปิดรับ ตรวจอัตราจ่าย
// และรายละเอียดโพยก่อนยืนยันรายการ ทั้งหมดผ่านมือถือได้
//
// ตัวเลขที่อ้างได้มีแค่ 100 บาท · 1,000 บาท · 3 ขั้นตอน · 24 ชั่วโมง
// ห้ามเพิ่มชื่อผู้ให้บริการ ชื่อธนาคาร ขั้นต่ำฝากถอน เลขใบอนุญาต ปีที่ก่อตั้ง
// จำนวนสมาชิก หรือ "อันดับ 1" ที่บรีฟไม่ได้ระบุ · บรีฟรอบนี้ไม่มีโปรโมชั่น/โบนัส
// เลยสักรายการ
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: banner1/banner1-mobile/og.png เป็นของ glob ที่
// MainLayout ปักไว้ ห้ามอ้างจากหน้า · slide1/slide2 ของดรอปนี้เป็นของ index และ
// /promotion · slide3/slide4/banner2/banner3 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น Announcement2 ทั้งเว็บ (รอบก่อน หวยเฮง24 ใช้ Announcement5)
// — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ หวยเฮง789 แล้ว จึง
// เรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ หวยเฮง789 เป็น **แดงนำ ทองรอง** (brand-spec §2) กลับด้านจากรอบก่อนที่
// ทองเป็นสีนำ: แดงสว่าง #e43434 · แดงแบรนด์ #dc2224 · แดงเข้ม #ab0204 ·
// ขอบแดงเข้มสุด #5c0a0a · ทองอ่อน (หมึกเน้น) #ffefc2 · ทองรอง #f4bc5d ·
// ทองเข้ม (ปลายไล่เฉดใต้หมึกเข้ม) #d99a10 · ทองเข้มสุด (ขอบ/เส้นเท่านั้น) #a8690c ·
// การ์ด #2b0909 · พื้นเซคชัน #1c0606 · เนื้อความ #fbe3d4 (BRAND_TEXT)
// เรืองแสง: แดง rgba(220,34,36,*) · ทอง rgba(244,188,93,*)
// ชุดทองนำของ หวยเฮง24 (#e0a52a #fdea83 #fbdc64 #bd7c13 #2a0606 #1a0505 #f6e6cf
// #3d0808 #2e0707 rgba(224,165,42,*) rgba(192,22,22,*)) ออกครบทุกจุดแล้ว
// กฎคอนทราสต์: พื้นทอง → หมึกเข้ม #1c0606 และไล่เฉดต้องไม่จบเข้มกว่า #d99a10 ·
// ห้ามวางหมึกเข้มบนแดง #dc2224 (3.4:1 ตก) พื้นแดงใช้หมึกขาว
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลางที่ orchestrator รีธีมรอบนี้) — การ์ดตั้ง
// สีเนื้อความไว้ให้แล้ว ย้ำไว้บนย่อหน้าอีกชั้นเพื่อให้สีของ body copy อ่านออกจาก
// ตัวหน้าเอง
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 151
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "ทดลองเล่น หวยเฮง789 ด้วยการไล่ดูระบบจริงให้ครบก่อนส่งโพยใบแรก ตั้งแต่เลือกประเภทหวยและรอบ อ่านอัตราจ่าย ดูเวลาปิดรับ ไปจนถึงตรวจรายละเอียดโพยก่อนยืนยัน";

const pageTitle = "ทดลองเล่น หวยเฮง789 ไล่ดูรายการหวยและอัตราจ่ายก่อนส่งโพยจริง";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#fbe3d4]">
        <strong class="text-[#ffefc2]">หวยเฮง789</strong> เปิดให้เลือกแทงหวยออนไลน์หลายประเภท
        <strong class="text-[#ffefc2]">ผ่านบัญชีเดียว</strong> ทั้งหวยรัฐบาลไทย หวยฮานอย หวยลาว และหวยหุ้นต่างประเทศ หน้านี้เปิดไว้ให้คนที่ยังไม่คุ้นกับระบบได้ลองเปิดใช้งานจริงหนึ่งรอบ
        ตั้งแต่หน้ารายการหวยที่เปิดรับ ไปจนถึงหน้าสรุปโพยที่แสดงตัวเลขที่เลือกและอัตราจ่าย ก่อนจะยืนยันโพยใบแรก
      </p>

      <p class="text-left text-base leading-relaxed text-[#fbe3d4]">
        คำว่า “ทดลองเล่น” ที่หน้านี้พูดถึงจึงหมายถึง<strong class="text-[#ffefc2]">
          การเดินให้ครบทุกขั้นของการใช้งาน ตั้งแต่ Login เลือกประเภทหวยและรอบ เลือกตัวเลขเอง อ่านอัตราจ่าย ดูเวลาปิดรับ ไปจนถึงตรวจสอบรายละเอียดโพยก่อนยืนยันรายการ
        </strong>
        ระบบรองรับการใช้งานผ่านมือถือ จึงติดตามรอบหวย ส่งโพย และตรวจสอบผลได้จากหน้าเว็บไซต์ ซึ่งเป็นสิ่งที่ผู้เข้าชมไล่ดูได้ทั้งหมดก่อนส่งโพยจริงรอบแรก
      </p>
    </div>
  </ContentBox>

  <ContentBox title="เปิด หวยเฮง789 บนมือถือแล้วไล่ดูรอบหวยได้จากบัญชีเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#fbe3d4]">
        จุดที่ช่วยให้เริ่มต้นได้เร็วที่สุดคือ<strong class="text-[#ffefc2]">รายการหวยหลายประเภทถูกรวมไว้ในบัญชีเดียว และสลับประเภทได้จากระบบเดิม</strong>
        สมาชิกจึงไม่ต้องสลับใช้งานหลายบัญชี และไล่ดูรอบที่สนใจได้จากหน้าเว็บไซต์เดียว
      </p>

      <ol class="ml-6 list-decimal space-y-3 text-left text-base leading-relaxed text-[#fbe3d4] marker:font-black marker:text-[#f4bc5d]">
        <li>
          <strong class="text-[#ffefc2]">เปิดเว็บไซต์ หวยเฮง789 จากช่องทางหลักก่อน</strong> การเข้าผ่านช่องทางที่เว็บไซต์ประกาศไว้จริงช่วยหลีกเลี่ยงเว็บไซต์ที่ไม่เกี่ยวข้อง แล้วบันทึกทางเข้านั้นไว้ใช้รอบถัดไป
        </li>
        <li>
          <strong class="text-[#ffefc2]">สมัครและยืนยันข้อมูลตามที่ระบบกำหนด แล้ว Login</strong> ทั้งหมดทำผ่านมือถือได้ หลังเข้าสู่ระบบจะเห็นรายการหวยที่เปิดรับและประวัติรายการของบัญชีตัวเอง
        </li>
        <li>
          <strong class="text-[#ffefc2]">ไล่ดูประเภทหวยและรอบที่ระบบเปิดรับในขณะนั้น</strong> ทั้งรัฐบาลไทย ฮานอย ลาว และหุ้นต่างประเทศ รายการที่เปิดรับจริงในแต่ละวันขึ้นอยู่กับตารางรอบของหวยแต่ละประเภท
          จึงควรดูจากรายการที่ระบบแสดงไว้เป็นหลัก
        </li>
        <li>
          <strong class="text-[#ffefc2]">เปิดดูเวลาปิดรับและอัตราจ่ายของรอบนั้นให้ครบ</strong> เพราะหวยแต่ละประเภทมีรอบของตัวเอง และอัตราจ่ายอาจไม่ได้ใช้เหมือนกันทุกประเภท
        </li>
        <li>
          <strong class="text-[#ffefc2]">ลองเลือกตัวเลขเองแล้วอ่านหน้าสรุปโพยก่อนกดยืนยัน</strong> ขั้นนี้คือขั้นที่ควรทำช้าที่สุด เพราะเป็นหน้าจอสุดท้ายที่ยังแก้รายการได้ก่อนโพยจะถูกบันทึก
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#fbe3d4]">
        <strong class="text-[#ffefc2]">ตารางรอบและเงื่อนไขของแต่ละรอบเปลี่ยนแปลงได้ตามช่วงเวลา จึงควรตรวจสอบข้อมูลจากหน้าส่งโพยของรอบนั้นทุกครั้งก่อนยืนยัน</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ประเภทหวยที่ลองไล่ดูได้ใน หวยเฮง789" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#fbe3d4]">
        ระหว่างไล่ดูระบบ สิ่งที่ควรจำให้ได้คือ<strong class="text-[#ffefc2]">หวยแต่ละประเภทมีรอบและเวลาปิดรับของตัวเอง</strong>
        ไม่ได้ใช้เงื่อนไขชุดเดียวกันทั้งหมด การรู้ว่าแต่ละประเภททำงานอย่างไรช่วยให้เลือกรอบที่เหมาะกับจังหวะของตัวเองได้เร็วขึ้น
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#fbe3d4]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f4bc5d]">🏛️</span>
          <span>
            <strong class="text-[#ffefc2]">หวยรัฐบาลไทย</strong> เปิดรับตามกำหนดออกรางวัลของแต่ละงวด เป็นกลุ่มที่อ่านตารางได้ง่ายที่สุดสำหรับคนเริ่มต้น ลองดูว่าหน้าส่งโพยแสดงเวลาปิดรับของงวดนั้นไว้อย่างไร
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f4bc5d]">🕒</span>
          <span>
            <strong class="text-[#ffefc2]">หวยฮานอย</strong> เปิดรับตามรอบที่ระบบเปิดรับ จึงเป็นกลุ่มที่ควรอ่านชื่อหวยและรอบเวลาให้ละเอียดที่สุดก่อนยืนยัน เพื่อไม่ให้ส่งโพยผิดรอบ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f4bc5d]">🎫</span>
          <span>
            <strong class="text-[#ffefc2]">หวยลาว</strong> เปิดรับตามรอบที่ระบบเปิดรับเช่นกัน ลองเปิดดูสักรอบเพื่อให้เห็นว่าชื่อหวยและเวลาปิดรับถูกแสดงไว้ตรงไหนของหน้าส่งโพย
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f4bc5d]">📈</span>
          <span>
            <strong class="text-[#ffefc2]">หวยหุ้นต่างประเทศ</strong> เปิดรับตามตลาดที่ระบบรองรับ จำนวนรายการที่เลือกได้ในแต่ละวันจึงขึ้นอยู่กับตลาดที่เปิดในรอบนั้น
          </span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#fbe3d4]">
        ผู้ที่ติดตามเลขเด็ดหรือเลขดังนำตัวเลขมาเลือกแทงตามรูปแบบที่ระบบเปิดรับได้
        <strong class="text-[#ffefc2]">แต่ตัวเลขดังกล่าวไม่สามารถรับประกันผลรางวัลได้</strong>
        และคำว่า “ไม่จำกัด” หรือ “แทงได้ไม่อั้น” ควรอ้างอิงวงเงินที่ระบบเปิดรับจริง เพราะหวยแต่ละประเภท เลขแต่ละชุด และแต่ละรอบอาจกำหนดวงเงินแตกต่างกัน
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/promotion"
          aria-label="ดูภาพอัตราจ่ายของ หวยเฮง789"
          class="flex items-center justify-center rounded-lg border border-[#f4bc5d]/35 bg-[#2b0909] px-8 py-3 font-bold text-[#fbe3d4] shadow-[0_0_15px_rgba(220,34,36,0.35)] transition-all hover:scale-105 hover:border-[#f4bc5d] hover:bg-[#1c0606] hover:text-[#ffefc2]">
          ดูภาพอัตราจ่าย
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="จุดที่ควรตรวจให้ครบก่อนยืนยันโพย" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#fbe3d4]">
        การไล่ดูระบบมีประโยชน์ที่สุดเมื่อมองมันเหมือนการอ่านคู่มือ ไม่ใช่การลุ้นผลรางวัล
