---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { Picture } from "astro:assets";

import popularGamesImage from "../assets/gamedemo8.webp";
import newGamesImage from "../assets/gamedemo16.webp";

import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login,
// /register หรือหน้าภาพแบบ /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง
// ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้
// (src/assets/content.txt) ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่จาก
// ข้อเท็จจริงและคลังคำของบรีฟรอบนี้เท่านั้น (.claude/brand-spec-mexicanoslot.md §4-§5)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x5 · h3x0
//   h1  ทดลองเล่น <แบรนด์> ศึกษากติกาเกมสล็อตก่อนเดิมพันด้วยเงินจริง
//   h2  กติกาเกม อัตราการจ่ายรางวัล และข้อกำหนดการใช้งานที่ควรศึกษาก่อน
//   h2  สล็อตคลาสสิก เกมโบนัส และเกมที่มีฟีเจอร์พิเศษ ต่างกันที่รายละเอียดใด
//   h2  เงื่อนไขโปรโมชั่น คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ที่ควรตรวจก่อนรับสิทธิ์
//   h2  สมัครสมาชิก <แบรนด์> ด้วยตัวเอง 3 ขั้นตอน ก่อนเข้าตรวจรายละเอียดเกม
//   h2  แอดมินออนไลน์ตลอด 24ชม. กับการตรวจสอบช่องทางทางการก่อนส่งข้อความ
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// **การ์ดรูปสองใบอยู่ใน h2 ใบแรก ไม่ได้แยกเป็นหัวข้อของตัวเอง** เพื่อคงผัง h2x5
// ป้ายกำกับของการ์ดรูปอยู่ในตัวภาพเอง (alt) ไม่มีป้ายข้อความใดเป็น heading
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// 🚨🚨 **คำว่า "ทดลองเล่น" อยู่ได้เฉพาะเพราะเป็นชื่อ route /ทดลองเล่น และชื่อเมนู
// จริง** (ใช้ใน h1 · title · description · breadcrumb) แต่ **บรีฟรอบนี้ไม่ได้
// พูดถึงโหมดเล่นโดยไม่ใช้เงินจริงเลยแม้แต่ประโยคเดียว** → **ห้ามอ้างว่าเว็บมี
// โหมดนั้นให้** ห้ามอ้างจำนวนเกมที่เล่นได้ ห้ามอ้างค่า RTP และห้ามอ้างว่าผลที่
// ออกในการลองสะท้อนผลจริง แกนของหน้าจึงเป็น **"สิ่งที่ควรศึกษาและตรวจสอบ
// เกี่ยวกับเกมที่ระบุไว้ ก่อนเดิมพันด้วยเงินจริง"** ตามที่บรีฟมีจริง: สล็อตคลาสสิก ·
// เกมโบนัส · เกมที่มีฟีเจอร์พิเศษ · ศึกษารายละเอียดเกม กติกา และโปรโมชั่นผ่าน
// เว็บไซต์ได้ในช่องทางเดียว · กติกาเกม อัตราการจ่ายรางวัล ข้อกำหนดการใช้งาน ·
// คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · สมัคร 3 ขั้นตอน · แอดมิน 24ชม. · ประกาศล่าสุด
// ⚠️ และมีหนึ่งประโยคที่พูดตรงๆ ว่าบรีฟไม่ได้ระบุโหมดนั้นไว้ เพื่อไม่ให้ผู้อ่าน
// อนุมานเอาจากชื่อเมนู — **ห้ามถอดประโยคนั้นออก**
//
// ⚠️⚠️ ชื่อแบรนด์รอบนี้เป็น **ตัวละตินพิมพ์ใหญ่ล้วน** กลับทิศจากรอบก่อนที่เป็น
// พิมพ์เล็กล้วน (brand-spec §1) ทุกจุดยัง interpolate จาก BRAND_NAME เหมือนเดิม
// เพื่อไม่ให้ค้างเป็นชื่อแบรนด์ก่อนหน้าตอนรีแบรนด์รอบถัดไป ห้ามพิมพ์ชื่อตรงๆ
// ⚠️⚠️ คำนิยามตัวเองของแบรนด์ขาออกเป็น **คำค้างข้ามแบรนด์** ห้ามหลุดกลับมา
// **รายการคำต้องห้ามเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่** เพื่อไม่ให้
// sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// 🚨🚨 **บรีฟรอบนี้ไม่พูดถึงธนาคาร วอลเลท หรือการฝากถอนเลยแม้แต่คำเดียว** —
// หัวข้อ "ฝากถอน" ทั้งหัวข้อที่เคยอยู่บนหน้านี้ตอนรอบก่อน **ถูกตัดออกทั้งบล็อก**
// และชื่อวอลเล็ตของแบรนด์ขาออกคือคำที่พลาดง่ายที่สุดของรอบนี้ (ไม่พิมพ์ซ้ำที่นี่)
//
// ⚠️ **รอบนี้สองหน้าหมวดลอตเตอรียังถูกปิด** (อยู่ใน src/pages-disabled/ เพราะรอบนี้
// เป็นเว็บสล็อต) ลิงก์ไปสอง route นั้นจากหน้านี้จึงไม่มี — verify-build จะแดงถ้า
// href ชี้ไป route ที่ไม่มีจริง และห้ามใช้คำศัพท์หมวดลอตเตอรีในเนื้อหา
// route ที่มีจริงรอบนี้: / · /about-us · /contact-us · /promotion · /ทดลองเล่น ·
// /ทางเข้า · /login · /register · /terms · /privacy · 404 · /line
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกม ชื่อผู้ให้บริการ หน่วยงานกำกับ ใบอนุญาต
// ปีก่อตั้ง จำนวนสมาชิก จำนวนเกม จำนวนค่าย ตัวเลข RTP อัตราจ่ายที่เป็นตัวเลข
// หรือยอดขั้นต่ำ แม้แต่รายการเดียว** จึงห้ามเขียนลงหน้าเว็บ ·
// ตัวเลขที่ขึ้นหน้าได้มีแค่ของบรีฟเอง: **0.3% · 0.8% · 3 ขั้นตอน · 24ชม.**
//
// 🚨 **ข้อกำกับของบรีฟที่ต้อง ship ครบบนหน้านี้** (ไม่ใช่ filler ให้ตัดทิ้ง):
// 1) ข้อมูลเกี่ยวกับการส่งตรงจากเม็กซิโกควรตรวจสอบแหล่งที่มาของเกมและผู้ให้บริการ
//    ก่อนใช้งาน
// 2) คำกล่าวอ้างว่าไม่ผ่านเอเย่นต์หรือยอดเงินเข้าบริษัทโดยตรง จำเป็นต้องมีข้อมูล
//    ที่ตรวจสอบได้ประกอบ
// 3) เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่ม
//    โอกาสชนะในครั้งต่อไป
// 4) แม้จะมีข้อความว่าไม่จำกัด แต่ควรยืนยันจำนวนบัญชีที่เข้าร่วมได้ รอบจ่ายเครดิต
// 5) ควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการเพื่อหลีกเลี่ยงบัญชีแอบอ้าง ·
//    เก็บหมายเลขรายการและหลักฐานที่เกี่ยวข้อง · ไม่เปิดเผยรหัสผ่านหรือรหัส OTP ·
//    ตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุดอีกครั้ง
// ⚠️ บรีฟรอบนี้ **โฆษณาและกำกับในประโยคเดียวกัน** คำโฆษณาอยู่ได้เฉพาะในขอบเขตที่
// บรีฟเขียนไว้เอง ห้ามขยายเป็นคำกล่าวอ้างใหม่ และทุกประโยคกำกับต้อง ship ครบ
// ห้ามตัดเพราะฟังดูลบ
//
// 🚨 **รูปในหน้านี้ใช้ได้แค่ gamedemo8 กับ gamedemo16 เท่านั้น** — เป็นอาร์ตสต็อก
// (mtime 2026-08-04) ไม่ใช่อาร์ตเวิร์กของดรอปนี้ จึงใช้เป็นภาพประกอบหมวดเกมได้
// แต่ **ห้ามใช้แทนอาร์ตเวิร์กแบรนด์** gamedemo8 ("POPULAR GAME" 600x379) กับ
// gamedemo16 ("New Game" 650x411) ไม่มีโลโก้หรือชื่อค่ายเกมเจ้าอื่นพิมพ์ทับอยู่
// ส่วน gamedemo7/9/10/11/12/14/15/17/18 มีโลโก้หรือชื่อของผู้ให้บริการ/ค่ายเกม
// เจ้าอื่นพิมพ์ทับอยู่กลางรูป และ gamedemo13 เป็นภาพล่อแหลม — **ห้ามนำกลับมาใช้**
// ⚠️ เปิดรูปจริงทั้งสองใบรอบนี้แล้ว · alt บรรยายสิ่งที่เห็นจริง (กระต่ายกับแมวใส่
// แว่นกันแดดและหูฟัง / ฟักทองหัวโตกับโครงกระดูก) **ไม่ใช่ตัวนับแบบ "เกมที่ 3"**
// และไม่เอ่ยชื่อแบรนด์ เพราะไม่มีชื่อแบรนด์ใดพิมพ์อยู่บนรูป
// ⚠️ ทั้งสองใบวาดกว้างสุด 600px (กริดสองคอลัมน์ตั้งแต่ sm ขึ้นไป) widths/sizes
// จึงตั้งตามนั้น ไม่ใช่ตามขนาดไฟล์ต้นฉบับ
// 🚨 **ห้าม import อาร์ตเวิร์กของแบรนด์อื่นจากหน้านี้เด็ดขาด**: banner2/banner3
// และ slide3/slide4 เป็นของแบรนด์อื่น · slide1/slide2 ถูกตรึงไว้กับ index §4
// ข้อ 4-5 กับ /promotion · banner1 / banner1-mobile / og.png เป็นของ glob ที่
// MainLayout ปักไว้ **ห้ามอ้างจากหน้านี้** · ลำพังการ import ก็ทำให้ไฟล์ถูก emit
// ลง dist/ ทุก build และ verify-build จะแดง · ไฟล์เก่าทั้งหมดยังอยู่บนดิสก์
// **ห้ามลบ** เป็นอินเวนทอรีของแบรนด์ถัดไป
//
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) **เนื้อหายังเป็นธีมสว่าง แต่โครมกลับทิศเป็น
// ผิวเข้ม และฮิวคนละตระกูลสิ้นเชิง** bg.json ของดรอปนี้คือ
// {"mode":"color","color":"#fef6fb"} = **ขาวอมชมพูจาง** (รอบก่อนเป็น ffd6fa =
// ชมพูบับเบิลกัมที่อิ่มกว่านี้มาก) **ห้ามเดาว่าเท่าเดิม และห้าม "แก้" การ์ด/ปุ่ม
// ให้เป็นพื้นมืดตามโครม** — พื้นมืดบนหมึก #3f130d = ตัวอักษรหายไปเลย ไม่ใช่แค่จางลง
// ค่าที่ใช้ได้ในไฟล์นี้: หัวข้อ/`<strong>`/marker ของลำดับเลข **#a81410**
// (7.6:1 บนการ์ดขาว) · เข้มสุด #3f130d (14.9:1) · หมึกรอง #80453a (6.6:1) ·
// เขียวเม็กซิกัน #117a41 (5.4:1) · พื้นไล่เฉดปุ่มหลัก #c81e12 -> #9d140c ->
// #6f0e08 (**พื้นถม** + หมึกขาว #ffffff) · ปุ่มรองเป็นผิวสว่าง #ffffff ->
// #fde4d3 คู่กับหมึก #3f130d · ผิวยก #fff3ea · wash #fde4d3 · เส้น #f6c4a4 ·
// เส้นเข้ม #e2855c (**ทั้งคู่ห้ามถือตัวอักษร** ใช้เป็นขอบการ์ดรูปได้)
// หมึกเนื้อความคือ #3f130d (= BRAND_TEXT) ซึ่ง **ไม่ประกาศในไฟล์นี้** การ์ด
// ContentBox ตั้งไว้ให้แล้วและย่อหน้าสืบทอดลงมา
// 🚨🚨 **#de2b1e บนพื้นขาวได้แค่ 4.0:1 — ห้ามเป็นสีตัวอักษร** และ **ขาวบน #de2b1e
// ได้ 4.7:1 ซึ่งเฉียดเกินไปสำหรับปุ่มจริง** พื้นแดงที่รับหมึกขาวได้ต้องเป็น
// **#c81e12 ลงไป** เท่านั้น · #f2a033 #fed7b5 #fec28d #fef6fb ก็ห้ามถือตัวอักษร
// 🚨🚨 **#f2543f (3.5:1) และ #2bb061 (2.9:1) เป็นสีของผิวโครมเข้มเท่านั้น
// ห้ามหลุดเข้ามาในไฟล์นี้**
// ออราที่อนุญาต: rgba(222,43,30,α) · rgba(242,160,51,α) · rgba(168,20,16,α) ·
// rgba(63,19,13,α) · rgba(246,196,164,α) · rgba(254,215,181,α)
// ⚠️⚠️ **รอบนี้ไม่มีชมพู/แมเจนต้าเลยสักเฉด** (ทั้งชุดคือพาเลตของแบรนด์ขาออก) ·
// ไม่มีฟ้า/ไซแอน/น้ำเงิน · ไม่มีม่วง · ไม่มีเทาเงิน · **แต่ทองกับเขียวรอบนี้
// มีจริง** (#f2a033 เป็น fill · #117a41 ถือตัวอักษรได้) เพราะมาจากอาร์ตเวิร์ก
// โดยตรง: เหรียญทอง/ขอบแคปซูล และกระบองเพชร/แถบธงชาติเขียว-ขาว-แดง
// ⚠️⚠️ **รอบนี้เป็นแบรนด์แดงจริง และแบรนด์แดงผ่านรีโปนี้มาแล้วอย่างน้อยหกเจ้า
// การเจอแดงในไฟล์จึงไม่พิสูจน์อะไร** — ห้ามเทียบด้วยวงศ์สี ต้องเทียบทีละค่ากับ
// ตาราง brand-spec §2 (fb2e33 ของสล็อต168 ห่างจาก #de2b1e แค่ R/B · d9212a ของ
// ดวงเศรษฐี168 ใกล้กว่านั้นอีก · cb0b0d / b00d11 ใกล้ #c81e12 / #a81410 มาก ·
// f0b46a / f0c878 ต่างจาก #f2a033 แค่ไบต์แรก — เจอที่ไหนแปลว่าพิมพ์ผิด
// เฮกซ์ของแบรนด์เก่าในคอมเมนต์เขียนแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep สะดุด)
// 🚨 **"SLOT" สีน้ำเงินไล่ฟ้าในเวิร์ดมาร์กเป็นอาร์ตเวิร์กของโลโก้ ไม่ใช่สี UI**
// ⚠️⚠️ **ซอมเบรโรฟาง ปอนโช กีตาร์ เหรียญทอง มาราคัส พริกแดง ฉากสตูดิโอขาว และ
// สีผิวนักแสดงในอาร์ตเวิร์ก เป็นวัตถุในภาพ ไม่ใช่สี UI**
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง และไม่ใส่ mx-auto / max-w-* บน <p>
// เพราะการ์ดคุมความกว้างเองแล้ว — ที่ประกาศสีได้มีแค่ปุ่ม ชิปไอคอน marker ของ
// ลำดับเลข ขอบการ์ดรูป และ <strong> · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วย
// ช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ
// บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง และห้ามวาง <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังในข้อความของ prop และต้องเป็นไอคอนหมวดสล็อต ไม่ใช่ไอคอนหมวดลอตเตอรี
// slot ของ ContentBox รับ **หนึ่ง element** เท่านั้น จึงห่อด้วย <div> ชั้นเดียว
//
// Announcement รอบนี้หมุนมาเป็น Announcement5 ทั้งเว็บ (brand-spec §3 — รอบก่อนใช้
// Announcement3 จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็น
// คอปปี้ของแบรนด์นี้แล้ว จึงเรียกแบบ bare **ห้ามส่ง prop message** มิฉะนั้นข้อความ
// ตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -c บนเชลล์นี้
// ก็นับเป็นไบต์ ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับตัวนับ
// ของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 158 อักขระ (ชื่อแบรนด์รอบนี้ 12 อักขระ) เป็นประโยคเดียวที่บอกว่า
// หน้านี้มีไว้ทำอะไร แล้วหยุด
// (Google ตัดราว 160 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนๆ ยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} รวมสิ่งที่ควรศึกษาก่อนเดิมพันจริง ทั้งกติกาเกมสล็อต อัตราการจ่ายรางวัล เงื่อนไขโปรโมชั่นคืนยอดเสีย 0.3% และขั้นตอนสมัครสมาชิก 3 ขั้นตอน`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ศึกษากติกาเกมสล็อตก่อนเดิมพันด้วยเงินจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});

// คลาสปุ่มสามขั้วของหน้านี้ ประกาศครั้งเดียวแล้วใช้ซ้ำ เพื่อไม่ให้สองปุ่มที่ทำ
// หน้าที่เดียวกันหลุดไปคนละเฉดตอนรีแบรนด์รอบหน้า
const ctaPrimary =
  "flex items-center justify-center rounded-full border border-[#6f0e08] bg-gradient-to-b from-[#c81e12] via-[#9d140c] to-[#6f0e08] px-8 py-3 font-black text-white shadow-[0_6px_18px_rgba(168,20,16,0.3)] transition-transform hover:scale-105";

const ctaSecondary =
  "flex items-center justify-center rounded-full border border-[#e2855c] bg-gradient-to-b from-[#ffffff] to-[#fde4d3] px-8 py-3 font-bold text-[#3f130d] shadow-[0_6px_18px_rgba(246,196,164,0.45)] transition-transform hover:scale-105";

const ctaQuiet =
  "flex items-center justify-center rounded-full border-2 border-[#a81410] bg-[#ffffff] px-8 py-3 font-bold text-[#a81410] shadow-[0_4px_14px_rgba(222,43,30,0.2)] transition-all hover:scale-105 hover:bg-[#fff3ea] hover:shadow-[0_6px_18px_rgba(168,20,16,0.2)]";

const listChip = "mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#f6c4a4] bg-[#fff3ea] text-sm";

const gameCard = "mx-auto block h-auto w-full max-w-[600px] rounded-2xl border border-[#e2855c]";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#a81410]">{BRAND_NAME} นำเสนอเกมสล็อตออนไลน์ภายใต้คอนเซปต์สล็อตเมกซิกัน ที่เน้นบรรยากาศสนุกสนานและรูปแบบเกมหลากหลาย</strong>
        ทั้งสล็อตคลาสสิก เกมโบนัส และเกมที่มีฟีเจอร์พิเศษ หน้านี้รวบรวมไว้ว่าควรศึกษาอะไรเกี่ยวกับเกมที่ระบุไว้ และควรตรวจอะไรซ้ำทุกครั้งที่กลับเข้ามาใหม่ ก่อนตัดสินใจเดิมพันด้วยเงินจริง
      </p>

      <p>
        ภายในเว็บไซต์ผู้ใช้งานสามารถศึกษารายละเอียดเกม กติกา และโปรโมชั่นได้ในช่องทางเดียว ซึ่งช่วยให้สมาชิกใหม่ทำความเข้าใจระบบก่อนใช้งานจริงได้สะดวกขึ้น ส่วน
        <strong class="text-[#a81410]">ข้อมูลเกี่ยวกับการส่งตรงจากเม็กซิโกควรตรวจสอบแหล่งที่มาของเกมและผู้ให้บริการก่อนใช้งาน</strong>
        เพื่อให้เข้าใจรายละเอียดของแพลตฟอร์มอย่างถูกต้อง
      </p>

      <p>
        <strong class="text-[#a81410]">ข้อมูลที่เว็บไซต์ระบุไว้ไม่ได้กล่าวถึงการเปิดให้หมุนเกมโดยไม่ใช้เงินจริงไว้แต่อย่างใด</strong>
        หน้านี้จึงไม่ยืนยันว่ามีรูปแบบนั้นให้ใช้งาน และควรตรวจสอบจากประกาศล่าสุดของเว็บไซต์ทางการเองว่าเกมใดเปิดให้ศึกษาได้ในลักษณะใด เนื้อหาด้านล่างเขียนไว้ประกอบการใช้งานเท่านั้น ไม่ได้ใช้แทนเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้บริการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="กติกาเกม อัตราการจ่ายรางวัล และข้อกำหนดการใช้งานที่ควรศึกษาก่อน" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#a81410]">การอ่านกติกาของเกมที่จะเล่นจากหน้ากติกาของเกมนั้นเอง ตรงกว่าการเทียบจากหน้าตาของวงล้อเพียงอย่างเดียว</strong>
        เพราะแต่ละเกมกำหนดรูปแบบการคิดผลไว้คนละชุด การไล่ดูรายละเอียดของเกมทีละหมวดก่อนจึงช่วยให้เลือกได้ว่าจะเปิดอ่านกติกาของเกมแบบไหนก่อน
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={popularGamesImage}
          alt="การ์ดหมวดเกมยอดนิยม เป็นภาพกระต่ายการ์ตูนกับแมวการ์ตูนสวมแว่นกันแดดและหูฟัง ยืนขนาบข้างหีบสมบัติที่มีเหรียญทองล้น มีชิปคาสิโนลายโพดำลอยอยู่รอบ และมีข้อความ POPULAR GAME ตัวหนาสีทองอยู่กลางภาพ"
          loading="lazy"
          fetchpriority="low"
          decoding="async"
          widths={[300, 600]}
          sizes="(max-width: 639px) 100vw, 600px"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={62}
          class={gameCard}
        />

        <Picture
          src={newGamesImage}
          alt="การ์ดหมวดเกมเปิดใหม่ เป็นภาพตัวละครหัวฟักทองสวมหมวกปีกกว้างกับโครงกระดูกการ์ตูนยืนขนาบข้างบนลานกระเบื้องเรืองแสง มีอัญมณีสีสดและดาวสีเหลืองกระจายอยู่ และมีข้อความ New Game ตัวหนาสีขาวอยู่กลางภาพ"
          loading="lazy"
          fetchpriority="low"
          decoding="async"
          widths={[300, 600]}
          sizes="(max-width: 639px) 100vw, 600px"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={62}
          class={gameCard}
        />
      </div>

      <ul class="flex flex-col gap-4" aria-label="สิ่งที่ควรศึกษาในเกมสล็อตก่อนเดิมพันจริง">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎰</span>
          <span>
            <strong class="text-[#a81410]">กติกาเกมของเกมที่เลือกไว้</strong> ควรอ่านจากหน้ากติกาของเกมนั้นก่อนตั้งยอดเดิมพัน เพราะเป็นจุดที่บอกว่าหนึ่งรอบคิดผลอย่างไรและนับยอดจากอะไร
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📊</span>
          <span>
            <strong class="text-[#a81410]">อัตราการจ่ายรางวัลที่เว็บไซต์ระบุไว้</strong> ควรเปิดดูประกอบกับกติกาเสมอ เพราะเป็นข้อมูลที่บอกเงื่อนไขการจ่ายของเกมนั้นตามที่ผู้ให้บริการกำหนด ไม่ใช่สิ่งที่คาดเดาจากภาพหน้าเกมได้
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📑</span>
          <span>
            <strong class="text-[#a81410]">ข้อกำหนดการใช้งานของเว็บไซต์</strong> ควรศึกษาให้ครบก่อนเริ่มใช้บริการ เพราะเป็นเอกสารที่ใช้ประกอบการพิจารณาความน่าเชื่อถือของเว็บไซต์ร่วมกับข้อมูลผู้ให้บริการเกม
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📣</span>
          <span>
            <strong class="text-[#a81410]">ประกาศล่าสุดของเว็บไซต์ทางการ</strong> คือจุดที่เงื่อนไขจริงถูกอัปเดต ทั้งเกมที่เปิดให้บริการและรายการโปรโมชั่น การเปิดดูก่อนทุกครั้งจึงตรงกว่าการจำไว้จากครั้งก่อน
          </span>
        </li>
      </ul>

      <p>
        {BRAND_NAME} ระบุรูปแบบการให้บริการที่เชื่อมต่อกับระบบเกมโดยตรง ผู้ใช้งานจึงควรตรวจสอบชื่อบริษัท รายละเอียดผู้ให้บริการเกม และหลักฐานความเกี่ยวข้องกับค่ายเกมก่อนสมัครสมาชิก
        <strong class="text-[#a81410]">โดยเฉพาะคำกล่าวอ้างว่าไม่ผ่านเอเย่นต์หรือยอดเงินเข้าบริษัทโดยตรง ซึ่งจำเป็นต้องมีข้อมูลที่ตรวจสอบได้ประกอบ</strong>
        ไม่ใช่ยืนยันจากข้อความโฆษณาเพียงอย่างเดียว
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/promotion" aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`} class={ctaQuiet}>ดูภาพโปรโมชั่น</a>

        <a href="/about-us" aria-label={`อ่านหน้าเกี่ยวกับเราของ ${BRAND_NAME}`} class={ctaQuiet}>อ่านเกี่ยวกับเรา</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="สล็อตคลาสสิก เกมโบนัส และเกมที่มีฟีเจอร์พิเศษ ต่างกันที่รายละเอียดใด" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        บรีฟของเว็บไซต์ระบุรูปแบบเกมไว้สามกลุ่ม และ
        <strong class="text-[#a81410]">แต่ละกลุ่มมีจุดที่ต้องเปิดอ่านคนละจุดก่อนเริ่มเดิมพันจริง</strong>
        รายการด้านล่างสรุปไว้ว่าควรมองหาอะไรในแต่ละกลุ่ม โดยไม่ได้ระบุจำนวนเกมหรือจำนวนค่ายใดเพิ่มเติม เพราะข้อมูลนั้นต้องดูจากหน้าเกมจริงของเว็บไซต์เท่านั้น
      </p>

      <ul class="flex flex-col gap-4" aria-label="รูปแบบเกมสล็อตที่เว็บไซต์ระบุไว้">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🍒</span>
          <span>
            <strong class="text-[#a81410]">สล็อตคลาสสิก</strong> เป็นกลุ่มที่โครงเกมเรียบที่สุด จุดที่ควรอ่านก่อนคือรูปแบบการนับผลของหนึ่งรอบ และเงื่อนไขที่เกมใช้ตัดสินว่ารอบนั้นเข้าเกณฑ์จ่ายหรือไม่
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎁</span>
          <span>
            <strong class="text-[#a81410]">เกมโบนัส</strong> มีชั้นเงื่อนไขเพิ่มเข้ามาจากรอบปกติ จึงควรอ่านให้ชัดว่าเข้าสู่รอบโบนัสด้วยเงื่อนไขใด และรอบโบนัสนั้นคิดผลด้วยกติกาเดียวกับรอบปกติหรือไม่
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>⚙️</span>
          <span>
            <strong class="text-[#a81410]">เกมที่มีฟีเจอร์พิเศษ</strong> คือกลุ่มที่กติกาต่างกันมากที่สุดระหว่างเกมต่อเกม การเปิดหน้ากติกาของเกมนั้นโดยเฉพาะจึงจำเป็นกว่ากลุ่มอื่น ไม่ควรเทียบเอาจากเกมที่เคยเล่นมาก่อน
          </span>
        </li>
      </ul>

      <p>
        เกมสล็อตมีผลลัพธ์ที่ไม่แน่นอนในแต่ละรอบโดยตัวของมันเอง
        <strong class="text-[#a81410]">ผลที่ออกในรอบก่อนจึงไม่ใช่สถิติที่นำมาคาดการณ์รอบถัดไปได้</strong>
        และการศึกษากติกาช่วยให้เข้าใจว่าเกมคำนวณผลอย่างไรเท่านั้น ไม่ได้เพิ่มโอกาสชนะในรอบใด
      </p>
    </div>
  </ContentBox>

  <ContentBox title="เงื่อนไขโปรโมชั่น คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ที่ควรตรวจก่อนรับสิทธิ์" as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} นำเสนอข้อมูลโปรโมชั่นสำหรับสมาชิก โดยมีรายการคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8% เป็นสิทธิพิเศษที่ระบุไว้ และอัปเดตใหม่ตลอดสัปดาห์
        <strong class="text-[#a81410]">ทั้งนี้ แต่ละรายการอาจกำหนดประเภทเกม ยอดที่นำมาคำนวณ และเงื่อนไขการถอนเงินแตกต่างกัน จึงควรตรวจสอบประกาศล่าสุดก่อนเข้าร่วมทุกครั้ง</strong>
      </p>

      <p>
        รายการคืนยอดเสีย 0.3% ระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขรายวัน สมาชิกควรตรวจสอบว่าเกมสล็อตประเภทใดเข้าร่วมรายการ มีรอบสรุปยอดเวลาใด และต้องกดรับเครดิตด้วยตนเองหรือระบบดำเนินการให้อัตโนมัติ
