---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login, /register)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อของ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริง
// ของ MIRACLE55 เท่านั้น
//
// รอบก่อน (KINGDOM66) บรีฟระบุ "บาคาร่า" "หวย" "บอล" "เครดิตฟรี" และ "ไลฟ์สดจาก
// ผู้ให้บริการต่างประเทศ" ไว้ ซึ่งบรีฟของ MIRACLE55 ไม่ได้ระบุเลยสักคำ — ทั้งหมดถูก
// ถอดออกทั้งหน้า และแทนด้วย "เกมสด" "เกมโต๊ะ" "หมวดเกมยอดนิยม" กับ "ระบบจัดแยก
// แต่ละค่าย" ที่บรีฟรอบนี้ระบุจริง ห้าม find-and-replace ชื่อแบรนด์ทับของเดิม
// มันจะทำให้ MIRACLE55 อ้างหมวดเกมที่บรีฟไม่เคยระบุ
//
// บรีฟไม่ได้ระบุว่ามีโหมดเดโมที่ถอนไม่ได้ สิ่งที่บรีฟระบุคือ "ระบบจัดแยกแต่ละค่ายให้
// ค้นหาได้ง่าย" "พร้อมรายละเอียดเกมก่อนเข้าใช้งาน" "ตรวจสอบค่ายและรายละเอียดของ
// แต่ละเกมได้จากหน้ารวมเกม" และ "รองรับการใช้งานผ่านมือถือและคอมพิวเตอร์" —
// หน้านี้จึงเขียนบนฐานนั้น คือการไล่ดูหมวดเกมและรายละเอียดให้ครบก่อนเดิมพันด้วย
// เงินจริง ห้ามอ้างกติกาของเครดิตทดลองหรือโหมดเล่นฟรีที่บรีฟไม่ได้พูดถึง
//
// ข้อเท็จจริงทุกบรรทัดมาจาก src/assets/content.txt เท่านั้น: คาสิโนฐานหลัก ·
// รวมเกมจากหลายแบรนด์ไว้ในระบบเดียว · เข้าเล่นผ่านระบบบริษัทตรง/บริษัทแม่โดยตรง ·
// เกมสด · เกมโต๊ะ · หมวดเกมยอดนิยม · ระบบจัดแยกแต่ละค่ายให้ค้นหาได้ง่าย ·
// ตรวจสอบค่ายและรายละเอียดของแต่ละเกมจากหน้ารวมเกมก่อนเข้าใช้งาน ·
// จัดการบัญชีผ่านระบบเดียว · รองรับมือถือและคอมพิวเตอร์ · โบนัสแนะนำเพื่อน 0.8% ·
// โบนัสคืนยอดเสีย 0.3% · ตรวจสอบยอดที่เข้าเกณฑ์ รอบคำนวณ และวิธีรับสิทธิ์จาก
// หน้าโปรโมชั่นก่อนกดรับ · สมัครเองได้ใน 3 ขั้นตอน · ไลน์แอด 24 ชั่วโมง
// — ห้ามอ้าง บาคาร่า หวย บอล เครดิตฟรี ชื่อค่ายเกม ชื่อสตูดิโอ ชื่อเกมเฉพาะ
// เลขใบอนุญาต ปีที่ก่อตั้ง จำนวนสมาชิก ค่า RTP ขั้นต่ำการเดิมพัน ชื่อธนาคาร
// "ฝากถอนไม่มีขั้นต่ำ" "ออโต้ 10 วินาที" หรือการันตีว่าจะชนะ
//
// ศัพท์ของบรีฟรอบนี้คือ **ไลน์แอด** ไม่ใช่ "LINE OFFICIAL" ที่ KINGDOM66 ใช้
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: แกลเลอรีเดโม 12 การ์ด (gamedemo7..18.webp) ยังอยู่
// บนดิสก์แต่เป็นของแบรนด์อื่น — gamedemo7.webp มีโลโก้ "askmeslot" และ
// gamedemo15.webp มีโลโก้ "askmebet" ของเว็บเจ้าอื่นพิมพ์ทับอยู่ในรูป ส่วน
// gamedemo13.webp เป็นการ์ด "Sexy Slot" ภาพโป๊เปลือย ห้ามนำกลับมา import เด็ดขาด
// (ห้ามลบไฟล์ เป็นอินเวนทอรี) ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ
// verify-build จะแดง
// slide1.png / slide2.png ของดรอปนี้เป็นของ index และ /promotion — ไม่ดึงมาใช้ซ้ำที่นี่
// banner1/banner1-mobile เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า และ
// banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กค้างของลูกค้าเจ้าอื่น ห้าม import
//
// Announcement รอบนี้หมุนจาก AnnouncementCyber มาเป็น Announcement5 ทั้งเว็บ —
// default message ของไฟล์นั้นเป็นคอปปี้ของ MIRACLE55 แล้ว จึงเรียกแบบ bare เหมือน
// index.astro ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ MIRACLE55 เป็น **สองโลหะ** ตามโลโก้ (MI ทอง / RACLE เงินโครเมียม /
// 55 ทอง) จึงต้องใช้เงินเป็นแอ็กเซนต์ที่สองจริง ๆ ไม่ใช่หน้าทองล้วน:
// พื้น #050403 · การ์ด #14100a · การ์ดยก #1b140b · ตัวอักษรบนพื้นทอง #0d0a06 ·
// ทองสว่าง #fee47b · ทองแบรนด์ #fcda65 · ทองเข้ม #d9a62b · ทองลึก #8c5f14 ·
// เงินไฮไลต์ #fcfcfc · เงินกลาง #eaeaea · เงินเส้นขอบ #d2d3d4 · เงินหม่น #a8acb1 ·
// เนื้อความ #e8e6e1 (BRAND_TEXT) · เน้นใน strong #fcfcfc
// เลขลำดับใน <ol> และไอคอนใน <ul> สลับทอง/เงินให้คู่โลหะอ่านออกจากหน้าเอง —
// ชุดทองครีมอุ่นของ KINGDOM66 ถูกแทนครบทุกจุดแล้ว แบรนด์นั้นไม่มีสีเงินอยู่เลย
// (ตารางแมป old→new ดูที่ .rebrand-spec-MIRACLE55.md §2 — ห้ามพิมพ์ฮิวเก่าซ้ำไว้ใน
// ไฟล์นี้ เพราะสคริปต์แมปพาเลตต์จะไล่แทนค่าในคอมเมนต์ด้วย)
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลางที่ orchestrator รีธีมรอบนี้) — การ์ดตั้ง
// สีเนื้อความไว้ให้แล้ว ย้ำไว้บนย่อหน้าอีกชั้นเพื่อให้สีของ body copy อ่านออกจาก
// ตัวหน้าเอง และเน้นด้วย #fcfcfc ในคำสำคัญ
//
// ไม่มีลิงก์ /ตรวจหวย หรือ /แนวทาง: MIRACLE55 เป็นแบรนด์คาสิโน สองหน้านั้นอยู่ใน
// src/pages-disabled/ รอบนี้ href ที่ชี้ route ซึ่งไม่มีใน dist/ จะทำให้ build แดง
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 155
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "ทดลองเล่น MIRACLE55 ไล่ดูเกมสด เกมโต๊ะ และหมวดยอดนิยมจากหลายค่ายในระบบเดียว พร้อมตรวจสอบรายละเอียดเกมและเงื่อนไขโปรโมชั่นให้ครบก่อนเริ่มเดิมพันด้วยเงินจริง";

const pageTitle = "ทดลองเล่น MIRACLE55 ไล่ดูเกมทุกค่ายและรายละเอียดก่อนเดิมพันจริง";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e8e6e1]">
        <strong class="text-[#fcfcfc]">MIRACLE55</strong> เป็นคาสิโนฐานหลักที่รวมเกมจากหลายแบรนด์ไว้ในระบบเดียว ทั้งเกมสด เกมโต๊ะ และหมวดเกมยอดนิยม โดยเข้าเล่นผ่านระบบบริษัทแม่โดยตรง หน้านี้จึงเปิดไว้ให้คนที่ยังไม่คุ้นกับระบบได้
        <strong class="text-[#fcfcfc]">ไล่ดูหมวดเกม ค่ายที่ให้บริการ และรายละเอียดของแต่ละรายการให้ครบก่อนเดิมพันด้วยเงินจริง</strong>
        ตั้งแต่โครงของเมนูหน้าแรก ไปจนถึงข้อมูลที่ระบบแสดงไว้ในหน้ารวมเกม
      </p>

      <p class="text-left text-base leading-relaxed text-[#e8e6e1]">
        เพราะ<strong class="text-[#fcfcfc]">ระบบจัดแยกแต่ละค่ายไว้ให้ค้นหาได้ง่าย และรองรับการใช้งานทั้งบนมือถือและคอมพิวเตอร์</strong>
        การเปิดดูให้ทั่วก่อนจึงช่วยให้เห็นว่าเกมแต่ละหมวดอยู่ตรงไหน สลับไปหมวดที่สนใจได้จากจุดใด และรู้ล่วงหน้าว่าต้องตรวจข้อมูลอะไรบ้างก่อนกดเข้าเล่นครั้งแรกจากระบบเดียว
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ไล่ดูหมวดเกมของ MIRACLE55 ให้ครบก่อนเลือกเกมแรก" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e8e6e1]">
        จุดที่ช่วยให้เริ่มต้นได้เร็วที่สุดคือ<strong class="text-[#fcfcfc]">ทุกหมวดเกมถูกรวมไว้ในระบบเดียวและมีเมนูจัดไว้ชัดเจน</strong>
        สมาชิกเลือกหมวดที่สนใจได้จากหน้าแรก ดูรายการที่เปิดให้บริการอยู่ แล้วเปิดรายละเอียดของเกมนั้นต่อได้จากหน้ารวมเกม ไม่ต้องไล่หาว่าเกมที่อยากเล่นอยู่ตรงไหน
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#e8e6e1]">
        <li class="flex gap-3">
          <span class="font-bold text-[#fee47b]">1.</span>
          <span><strong class="text-[#fcfcfc]">เปิดหน้าแรกของ MIRACLE55 ก่อน</strong> เมนูถูกจัดไว้ชัดเจนตั้งแต่หน้าแรก จึงเห็นภาพรวมของหมวดที่เปิดให้เลือกได้ในหน้าเดียว</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#d2d3d4]">2.</span>
          <span>
            <strong class="text-[#fcfcfc]">ไล่ดูหมวดหลักให้ครบ</strong> ทั้งเกมสด เกมโต๊ะ และหมวดที่ได้รับความนิยม แต่ละหมวดมีรูปแบบและรายละเอียดของตัวเองตามที่ระบบแสดงไว้
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#fee47b]">3.</span>
          <span>
            <strong class="text-[#fcfcfc]">ดูว่าระบบแยกค่ายไว้อย่างไร</strong> แต่ละค่ายถูกจัดแยกไว้ให้ค้นหาได้ง่าย เปิดเทียบดูสักรอบจะเห็นว่าค่ายไหนเปิดรายการแบบใดไว้บ้าง
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#d2d3d4]">4.</span>
          <span>
            <strong class="text-[#fcfcfc]">ตรวจสอบค่ายและรายละเอียดของแต่ละเกมก่อนเข้าใช้งาน</strong> ข้อมูลชุดนี้ระบบแสดงไว้ให้ดูตั้งแต่ก่อนกดเข้าเกม อ่านให้จบก่อนตัดสินใจว่าจะเลือกรายการไหน
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#fee47b]">5.</span>
          <span>
            <strong class="text-[#fcfcfc]">ลองเปิดจากเครื่องที่จะใช้จริงอีกครั้ง</strong> ระบบรองรับทั้งมือถือและคอมพิวเตอร์จากบัญชีเดียว เปิดรายการเดียวกันเทียบกันดูก่อน แล้วเลือกอุปกรณ์ที่ใช้งานได้ถนัดกว่า
          </span>
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#e8e6e1]">
        <strong class="text-[#fcfcfc]">รายการที่เปิดให้บริการและค่ายที่รองรับในแต่ละหมวดเปลี่ยนแปลงได้ตามช่วงเวลา จึงควรตรวจสอบหมวดเกมและรายละเอียดที่เกี่ยวข้องจากหน้ารวมเกมทุกครั้งก่อนเข้าใช้งาน</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title="จุดที่ควรตรวจให้ครบก่อนเดิมพันด้วยเงินจริง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e8e6e1]">
        การไล่ดูระบบมีประโยชน์ที่สุดเมื่อมองมันเหมือนการอ่านคู่มือ ไม่ใช่การลุ้นรางวัล
        <strong class="text-[#fcfcfc]">เป้าหมายคือรู้จักระบบให้ครบก่อนที่เงินจริงจะเข้ามาเกี่ยวข้อง</strong>
        หกเรื่องด้านล่างคือสิ่งที่ควรเก็บข้อมูลไว้ระหว่างเปิดดู
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#e8e6e1]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fee47b]">🗂️</span>
          <span>
            <strong class="text-[#fcfcfc]">โครงของเมนูและตำแหน่งของแต่ละหมวด</strong> จำให้ได้ว่าเกมสด เกมโต๊ะ และหมวดยอดนิยมอยู่ตรงไหน และสลับระหว่างกันได้จากจุดใด จะได้ไม่ต้องค้นหาใหม่ทุกครั้งที่อยากเปลี่ยนเกม
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#d2d3d4]">🎲</span>
          <span>
            <strong class="text-[#fcfcfc]">รายละเอียดของรายการที่สนใจ</strong> ระบบแสดงข้อมูลชุดนี้ไว้ก่อนเข้าใช้งาน เปิดอ่านเทียบกันหลายรายการดูก่อน จะได้เห็นว่ารูปแบบไหนตรงกับที่ตัวเองสนใจ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fee47b]">🎥</span>
          <span>
            <strong class="text-[#fcfcfc]">ค่ายที่เปิดให้บริการในหมวดเกมสด</strong> ระบบจัดแยกแต่ละค่ายไว้ให้ค้นหาได้ง่าย แต่รายการที่เปิดอยู่ไม่เท่ากันทุกช่วงเวลา ควรเปิดตรวจสอบอีกครั้งก่อนเลือกเข้าใช้งาน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#d2d3d4]">🎁</span>
          <span>
