---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";

import { pageGraph } from "../lib/schema";

// THE88 เป็นผู้ให้บริการระบบพนันออนไลน์ที่รวมเกมหลายประเภทไว้ในระบบเดียว —
// บรีฟรอบนี้ (ดรอป 2026-09-23 "THE88 ผู้ให้บริการระบบพนันออนไลน์ จากบริษัทหลัก
// โดยตรง") ระบุหมวดไว้ชัดว่า บาคาร่า สล็อต หวย บอล และไฮโล เลือกได้จากบัญชีเดียว
// คอปปี้ของแบรนด์รอบก่อน (WY88 "ทางเข้าเล่นรูปแบบ VIP สำหรับยูสไทย" + คำว่าเกมสด)
// ถูกเขียนใหม่ทั้งหน้าแล้ว ไม่เหลือประโยคเดิมและไม่เหลือชื่อแบรนด์เก่าแม้แต่จุดเดียว
//
// บรีฟรอบนี้ไม่ได้ระบุว่ามี "เครดิตทดลอง" หรือโหมดเดโมที่ถอนไม่ได้ สิ่งที่บรีฟระบุคือ
// "แบ่งหมวดหมู่ให้เลือกอย่างชัดเจน", "เมนูที่จัดหมวดหมู่ชัดเจนและเข้าถึงง่าย",
// "ตรวจสอบรายละเอียดเกมและค่ายที่เปิดให้บริการก่อนเข้าเล่น" และ "รองรับการใช้งาน
// บนมือถือและคอมพิวเตอร์" — หน้านี้จึงเขียนบนฐานนั้น คือการไล่ดูระบบและรายละเอียด
// ก่อนเดิมพันด้วยเงินจริง ห้ามกลับไปอ้างกติกาของเครดิตทดลองหรือโหมดเล่นฟรี
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: แกลเลอรีเดโม 12 การ์ด (gamedemo7..18.webp) ยังอยู่
// บนดิสก์แต่เป็นของแบรนด์อื่น (mtime 2026-08-04 ไม่ใช่ดรอปรอบนี้) — gamedemo7.webp
// มีโลโก้ "askmeslot" และ gamedemo15.webp มีโลโก้ "askmebet" ของเว็บเจ้าอื่น
// พิมพ์ทับอยู่ในรูป ส่วน gamedemo13.webp เป็นการ์ด "Sexy Slot" ภาพโป๊เปลือย
// ห้ามนำกลับมา import เด็ดขาด (ห้ามลบไฟล์ เป็นอินเวนทอรี) ลำพังการ import ก็ทำให้
// ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง
// slide1.png / slide2.png ของดรอปนี้เป็นของ index และ /promotion — ไม่ดึงมาใช้ซ้ำที่นี่
// banner1/banner1-mobile เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า และ
// banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กค้างของลูกค้าเจ้าอื่น ห้าม import
//
// ข้อเท็จจริงทุกบรรทัดมาจากบรีฟรอบนี้เท่านั้น: ผู้ให้บริการระบบพนันออนไลน์ที่รวมเกม
// หลายประเภทไว้ในระบบเดียว · เชื่อมต่อจากบริษัทหลักตามข้อมูลของเว็บไซต์ · บาคาร่า
// สล็อต หวย บอล ไฮโล ผ่านบัญชีเดียว · แบ่งหมวดหมู่ให้เลือกอย่างชัดเจน เมนูเข้าถึงง่าย ·
// รองรับทั้งมือถือและคอมพิวเตอร์ · ตรวจสอบรายละเอียดเกมและค่ายที่เปิดให้บริการก่อน
// เข้าเล่นได้ · โบนัสแนะนำเพื่อน 0.8% · โบนัสคืนยอดเสีย 0.3% · ตรวจสอบรอบคำนวณ
// ยอดที่เข้าเกณฑ์ และเงื่อนไขก่อนกดรับ · ฝากถอนผ่านวอลเลทและธนาคารที่เว็บไซต์กำหนด
// ตรวจยอดเครดิตและสถานะรายการได้จากบัญชีตัวเอง · แอดมินดูแลตลอด 24 ชั่วโมง
// — ห้ามอ้างชื่อค่ายเกม เลขใบอนุญาต ปีที่ก่อตั้ง จำนวนสมาชิก ค่า RTP อัตราจ่าย
// ขั้นต่ำการเดิมพัน "ฝากถอนออโต้ไม่มีขั้นต่ำ" "ปลอดภัย 100%" หรือการันตีว่าจะชนะ
//
// ไม่มีลิงก์ไป /ตรวจหวย หรือ /แนวทาง เด็ดขาด — รอบนี้สองหน้านั้นถูกพักไว้ใน
// src/pages-disabled/ การลิงก์ไปเส้นทางที่ไม่มีจริงทำให้ verify-build แดง
// (หวยในหน้านี้เป็นชื่อหมวดเกมในข้อความเท่านั้น ไม่ใช่ลิงก์)
//
// Announcement รอบนี้หมุนมาใช้ Announcement2 ทั้งเว็บ — default message ของ
// ไฟล์นั้นเป็นข้อความของ THE88 อยู่แล้ว จึงเรียกแบบ bare เหมือน index.astro
// ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ THE88 (แดงจีน + ทองหรู แทนชมพูมาเจนตา + ทองของแบรนด์รอบก่อน):
// พื้นเกือบดำแดง #1c0504 · การ์ด #2d0908 · ขอบแดงหลัก #a40201 · แดงสว่าง #dd0503 ·
// แดงลึก #6b0302 · ทองหลัก #f2c14e ใช้กับ <strong> · ทองสว่าง #ffe7a6 ใช้กับชื่อ
// แบรนด์ เลขลำดับ และไอคอน · ทองเข้ม #8a6524 เป็นสต็อปปลายของเกรเดียนต์ ·
// เนื้อความ #f7e3dd (BRAND_TEXT) · ตัวอักษรบนปุ่มไล่สี #1c0504 · ออร่าทอง
// rgba(242,193,78,α) — ข้อความเน้นใช้ทองไม่ใช้แดง เพราะแดงบนพื้นแดงเข้มอ่านไม่ออก
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 156
const pageDescription = "ทดลองเล่น THE88 ไล่ดูเมนูและหมวดเกมทั้งบาคาร่า สล็อต หวย บอล ไฮโล ก่อนเดิมพันด้วยเงินจริง ทั้งวิธีเลือกจากบัญชีเดียว การใช้งานบนมือถือ และการตรวจสอบเงื่อนไข";

const graph = pageGraph(Astro, {
  name: "ทดลองเล่น THE88 ไล่ดูหมวดเกมและเมนูในระบบก่อนเดิมพันด้วยเงินจริง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title="ทดลองเล่น THE88 ไล่ดูหมวดเกมและเมนูในระบบก่อนเดิมพันด้วยเงินจริง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่น THE88 ไล่ดูหมวดเกมและเมนูในระบบก่อนเดิมพันด้วยเงินจริง" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f7e3dd]">
        <strong class="text-[#ffe7a6]">THE88</strong> รวมบาคาร่า สล็อต หวย บอล และไฮโล ไว้ในบัญชีเดียว หน้านี้จึงเปิดไว้ให้คนที่ยังไม่คุ้นกับระบบได้
        <strong class="text-[#f2c14e]">ไล่ดูหมวดที่เปิดให้ใช้งาน เปิดรายละเอียดของเกมและค่ายที่สนใจ และทำความเข้าใจเมนูให้ครบก่อนเข้าเล่นด้วยเงินจริง</strong>
        ตั้งแต่โครงของหน้าหลัก ไปจนถึงข้อมูลที่ระบบแสดงไว้ในแต่ละหมวด
      </p>

      <p class="text-left text-base leading-relaxed text-[#f7e3dd]">
        เพราะเมนูของระบบ<strong class="text-[#f2c14e]">ถูกจัดหมวดหมู่ไว้ชัดเจนและเข้าถึงง่าย</strong>
        การเปิดดูให้ทั่วก่อนจึงช่วยให้เห็นว่าหมวดไหนอยู่ตรงไหน และรู้ล่วงหน้าว่าต้องดูข้อมูลอะไรบ้างก่อนกดเข้าเล่นครั้งแรก ทั้งเมื่อเปิดจากมือถือและจากคอมพิวเตอร์
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ไล่ดูบาคาร่า สล็อต หวย บอล ไฮโล ของ THE88 ได้จากบัญชีเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f7e3dd]">
        จุดที่ช่วยให้ไล่ดูเกมได้เร็วที่สุดคือ<strong class="text-[#f2c14e]">ทุกหมวดถูกรวมไว้ในบัญชีเดียว</strong>
        สมาชิกเลือกหมวดที่สนใจได้จากเมนูเกม และสลับไปดูอีกหมวดได้จากจุดเดียวกัน ไม่ต้องสมัครแยกหรือเปลี่ยนไปใช้หลายเว็บไซต์เพื่อไล่หาว่ารายการที่อยากเล่นอยู่ที่ไหน
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#f7e3dd]">
        <li class="flex gap-3">
          <span class="font-bold text-[#ffe7a6]">1.</span>
          <span><strong class="text-[#f2c14e]">เปิดหน้าหลักของ THE88 ก่อน</strong> เมนูถูกแบ่งหมวดหมู่ไว้ชัดเจน จึงเห็นภาพรวมของหมวดที่เปิดให้เลือกได้ตั้งแต่หน้าแรก</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#ffe7a6]">2.</span>
          <span>
            <strong class="text-[#f2c14e]">เลือกหมวดที่สนใจจากเมนูเกม</strong> ถ้ายังไม่แน่ใจว่าถนัดแนวไหน ให้ไล่เปิดดูทีละหมวดทั้งบาคาร่า สล็อต หวย บอล และไฮโล แล้วค่อยกลับมาเลือกทีหลัง
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#ffe7a6]">3.</span>
          <span>
            <strong class="text-[#f2c14e]">ตรวจสอบรายละเอียดเกมและค่ายที่เปิดให้บริการในหมวดนั้น</strong> ระบบแสดงข้อมูลของแต่ละรายการไว้ให้ดูก่อน อ่านให้จบก่อนตัดสินใจว่าจะเข้าเล่นรายการไหน
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#ffe7a6]">4.</span>
          <span>
            <strong class="text-[#f2c14e]">ลองสลับไปดูหมวดอื่นด้วยบัญชีเดิม</strong> การสลับหมวดทำได้จากเมนูเดียวกัน จึงไม่ต้องออกไปเปิดเว็บไซต์อื่นระหว่างเปรียบเทียบ
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#ffe7a6]">5.</span>
          <span>
            <strong class="text-[#f2c14e]">ทวนข้อมูลอีกครั้งก่อนกดเข้าเล่นด้วยเงินจริง</strong> ทั้งหมวด ชื่อรายการ และยอดเดิมพันที่ตั้งไว้ ขั้นตอนนี้คือจุดที่ลดความผิดพลาดได้มากที่สุด
          </span>
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#f7e3dd]">
        <strong class="text-[#f2c14e]">รายการที่เปิดให้ใช้งานเปลี่ยนแปลงได้ตามช่วงเวลา จึงควรตรวจสอบหมวดและรายการล่าสุดจากหน้าเว็บไซต์ทุกครั้งก่อนเข้าเล่น</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title="จุดที่ควรดูให้ครบก่อนเดิมพันด้วยเงินจริง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f7e3dd]">
        การไล่ดูระบบมีประโยชน์ที่สุดเมื่อมองมันเหมือนการอ่านคู่มือ ไม่ใช่การลุ้นรางวัล
        <strong class="text-[#f2c14e]">เป้าหมายคือรู้จักระบบให้ครบก่อนที่เงินจริงจะเข้ามาเกี่ยวข้อง</strong>
        ห้าเรื่องด้านล่างคือสิ่งที่ควรเก็บข้อมูลไว้ระหว่างเปิดดู
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f7e3dd]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f2c14e]">🗂️</span>
          <span>
            <strong class="text-[#f2c14e]">โครงของหน้าหลักและการจัดหมวดหมู่ของเมนู</strong> จำให้ได้ว่าหมวดไหนอยู่ตรงไหน และสลับไปดูหมวดอื่นได้จากจุดใด จะได้ไม่ต้องหาใหม่ทุกครั้งที่อยากเปลี่ยนเกม
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f2c14e]">🎲</span>
          <span>
            <strong class="text-[#f2c14e]">หมวดเกมทั้งห้าที่เลือกได้จากบัญชีเดียว</strong> ทั้งบาคาร่า สล็อต หวย บอล และไฮโล ลองเปิดดูให้ครบก่อน จะได้รู้ว่าแนวไหนเหมาะกับตัวเองที่สุดโดยไม่ต้องสมัครเพิ่ม
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f2c14e]">📱</span>
          <span>
            <strong class="text-[#f2c14e]">อุปกรณ์ที่จะใช้เล่นจริง</strong> ระบบรองรับทั้งมือถือและคอมพิวเตอร์ ลองเปิดหมวดเดียวกันจากทั้งสองเครื่องดูก่อน แล้วเลือกอุปกรณ์ที่ใช้งานถนัดกว่า
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f2c14e]">🎁</span>
          <span>
            <strong class="text-[#f2c14e]">เงื่อนไขของโปรโมชั่นที่จะกดรับ</strong> ทั้งโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% มีรอบคำนวณและข้อกำหนดต่างกัน ควรเปิดดูรายละเอียดของแต่ละรายการก่อนกดรับ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f2c14e]">💡</span>
          <span><strong class="text-[#f2c14e]">งบที่คุณรับความเสี่ยงได้</strong> ตั้งวงเงินต่อรอบไว้ล่วงหน้า แล้วดูว่าระดับไหนทำให้เล่นได้โดยไม่กระทบค่าใช้จ่ายอื่น</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#f7e3dd]">
        <strong class="text-[#f2c14e]">ผลของเกมเดิมพันทุกประเภทตัดสินจากระบบของเกมนั้น ไม่มีสูตร ไม่มีเกมใด และไม่มีช่วงเวลาไหนที่รับประกันว่าจะชนะ</strong>
        ข้อมูลที่เก็บได้จากการเปิดดูระบบช่วยให้เลือกหมวดและระดับเดิมพันที่เหมาะกับตัวเองเท่านั้น ไม่ได้ชี้ผลของรอบถัดไป จึงควรกำหนดงบล่วงหน้าและหยุดเมื่อถึงขีดที่ตั้งไว้เสมอ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="สมัคร THE88 ได้เองใน 3 ขั้นตอน แล้วเข้าเล่นได้ทันที" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f7e3dd]">
