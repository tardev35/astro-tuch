---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { pageGraph } from "../lib/schema";

// SAGAME66 เป็นเว็บคาสิโนที่รวมเกมเดิมพันหลายค่ายไว้ในระบบเดียว — บรีฟรอบนี้
// (ดรอป 2026-09-23 "SAGAME66 เว็บบาคาร่า รูเล็ต คาสิโน รวมครบทุกค่ายแท้")
// ระบุหมวดไว้ว่า บาคาร่า รูเล็ต คาสิโนสด และเกมโต๊ะ/เกมยอดนิยมอื่นตามรายการที่
// เปิดให้บริการ เลือกได้จากระบบเดียว แบรนด์นี้นำด้วยคาสิโนสด
//
// คอปปี้ของแบรนด์รอบก่อน (UFAGOOL ที่นำด้วย "การเดิมพันกีฬา" และ "สล็อต")
// ถูกเขียนใหม่ทั้งหน้าแล้ว เพราะบรีฟของ SAGAME66 ไม่ได้ระบุหมวดกีฬาหรือสล็อตเลย
// ห้ามใช้ find-and-replace กับหน้านี้ ห้ามพูดถึงการเดิมพันกีฬาหรือสล็อต และห้าม
// เขียนคำไทยที่แปลว่าลอตเตอรีที่ใดในหน้านี้
//
// บรีฟรอบนี้ไม่ได้ระบุว่ามี "เครดิตทดลอง" หรือโหมดเดโมที่ถอนไม่ได้ สิ่งที่บรีฟระบุคือ
// "เมนูจัดหมวดหมู่ชัดเจน ช่วยให้ค้นหาเกมที่ต้องการได้ง่าย", "ตรวจสอบชื่อค่าย
// รายละเอียดเกม และระดับเดิมพันก่อนเข้าเล่น" และ "รองรับการใช้งานผ่านมือถือและ
// คอมพิวเตอร์" — หน้านี้จึงเขียนบนฐานนั้น คือการไล่ดูระบบและรายละเอียดก่อน
// เดิมพันด้วยเงินจริง ห้ามกลับไปอ้างกติกาของเครดิตทดลองหรือโหมดเล่นฟรี
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: แกลเลอรีเดโม 12 การ์ด (gamedemo7..18.webp) ยังอยู่
// บนดิสก์แต่เป็นของแบรนด์อื่น (mtime 2026-08-04 ไม่ใช่ดรอปรอบนี้) — gamedemo7.webp
// มีโลโก้ "askmeslot" และ gamedemo15.webp มีโลโก้ "askmebet" ของเว็บเจ้าอื่น
// พิมพ์ทับอยู่ในรูป ส่วน gamedemo13.webp เป็นการ์ด "Sexy Slot" ภาพโป๊เปลือย
// ห้ามนำกลับมา import เด็ดขาด (ห้ามลบไฟล์ เป็นอินเวนทอรี) ลำพังการ import ก็ทำให้
// ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง
// slide1.png / slide2.png ของดรอปนี้เป็นของ index และ /promotion — ไม่ดึงมาใช้ซ้ำที่นี่
// banner1/banner1-mobile เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า และ
// banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กค้างของลูกค้าเจ้าอื่น ห้าม import
//
// ข้อเท็จจริงทุกบรรทัดมาจากบรีฟรอบนี้เท่านั้น: บาคาร่า · รูเล็ต · คาสิโนสด ·
// เกมโต๊ะและเกมยอดนิยมอื่นตามรายการที่เปิดให้บริการ · หลายค่ายในระบบเดียว ·
// เมนูจัดหมวดหมู่ชัดเจน ค้นหาเกมได้ง่าย · ตรวจสอบชื่อค่าย รายละเอียดเกม และ
// ระดับเดิมพันก่อนเข้าเล่น · ตัวเลือกการเดิมพันหลายระดับตามเงื่อนไขของแต่ละเกม ·
// ใช้งานได้ทั้งมือถือและคอมพิวเตอร์ · โปรโมชั่นบางรายการกดรับหลังสมัครได้โดยไม่
// ต้องฝาก · โบนัสแนะนำเพื่อน 0.8% · โบนัสคืนยอดเสีย 0.3% · สมัครผ่านมือถือ
// 3 ขั้นตอน · แอดมินดูแลตลอด 24 ชั่วโมง
// — ห้ามอ้างชื่อค่ายเกม เลขใบอนุญาต ปีที่ก่อตั้ง จำนวนสมาชิก ค่า RTP อัตราจ่าย
// ขั้นต่ำการเดิมพัน "ฝากถอนออโต้ไม่มีขั้นต่ำ" "ปลอดภัย 100%" หรือการันตีว่าจะชนะ
//
// ห้ามลิงก์ไปสองหน้าลอตเตอรีที่ถูกพักไว้ใน src/pages-disabled/ เด็ดขาด
// การลิงก์ไปเส้นทางที่ไม่มีจริงทำให้ verify-build แดง
//
// Announcement รอบนี้หมุนมาใช้ Announcement5 ทั้งเว็บ — default message ของ
// ไฟล์นั้นเป็นข้อความของ SAGAME66 อยู่แล้ว จึงเรียกแบบ bare เหมือน index.astro
// ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ SAGAME66 (ทอง + เงินโครเมียม บนน้ำตาลเกือบดำ แทนแดงคริมสัน + เงินเย็น
// ของ UFAGOOL รอบก่อน): พื้นเกือบดำ #0d0903 · การ์ด #171006 · การ์ดยก #2a1d0b ·
// ทองหลัก #e8b93f · ทองสว่าง #ffe9a3 · ทองลึกปลายเกรเดียนต์ #96671a ·
// เงินโครเมียม #eef3f8 ใช้กับชื่อแบรนด์และข้อความเน้น · เงินกลาง #b6c1cd ใช้กับ
// ป้ายเลขลำดับและไอคอน · เนื้อความ #e3d8c0 (BRAND_TEXT) · ตัวอักษรบนปุ่มไล่สีทอง
// เป็นหมึกเกือบดำ #0d0903 · ตัวเลขโบนัส 0.8%/0.3% ใช้ #ffe9a3 เท่านั้น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 159
const pageDescription = "ทดลองเล่น SAGAME66 ไล่ดูเมนูและหมวดเกมทั้งบาคาร่า รูเล็ต และคาสิโนสด ก่อนเดิมพันด้วยเงินจริง ทั้งวิธีเลือกจากบัญชีเดียว การใช้งานบนมือถือ และการตรวจสอบเงื่อนไข";

const graph = pageGraph(Astro, {
  name: "ทดลองเล่น SAGAME66 ไล่ดูหมวดบาคาร่า รูเล็ต และคาสิโนสดก่อนเดิมพันด้วยเงินจริง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title="ทดลองเล่น SAGAME66 ไล่ดูหมวดบาคาร่า รูเล็ต และคาสิโนสดก่อนเดิมพันด้วยเงินจริง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่น SAGAME66 ไล่ดูหมวดบาคาร่า รูเล็ต และคาสิโนสดก่อนเดิมพันด้วยเงินจริง" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e3d8c0]">
        <strong class="text-[#eef3f8]">SAGAME66</strong> รวมบาคาร่า รูเล็ต คาสิโนสด และเกมโต๊ะยอดนิยมจากหลายค่ายไว้ในระบบเดียว หน้านี้จึงเปิดไว้ให้คนที่ยังไม่คุ้นกับระบบได้
        <strong class="text-[#eef3f8]">ไล่ดูหมวดที่เปิดให้ใช้งาน เปิดดูชื่อค่ายและรายละเอียดของแต่ละเกม และทำความเข้าใจเมนูให้ครบก่อนเข้าเล่นด้วยเงินจริง</strong>
        ตั้งแต่โครงของหน้าหลัก ไปจนถึงข้อมูลที่ระบบแสดงไว้ในแต่ละหมวด
      </p>

      <p class="text-left text-base leading-relaxed text-[#e3d8c0]">
        เพราะเมนู<strong class="text-[#eef3f8]">จัดหมวดหมู่ไว้ชัดเจนและรวมทุกค่ายให้เลือกจากระบบเดียว</strong>
        การเปิดดูให้ทั่วก่อนจึงช่วยให้เห็นว่าหมวดไหนอยู่ตรงไหน และรู้ล่วงหน้าว่าต้องดูข้อมูลอะไรบ้างก่อนกดเข้าเล่นครั้งแรก ทั้งเมื่อเปิดจากมือถือและจากคอมพิวเตอร์
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ไล่ดูบาคาร่า รูเล็ต และคาสิโนสดของ SAGAME66 ได้จากบัญชีเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e3d8c0]">
        จุดที่ช่วยให้ไล่ดูเกมได้เร็วที่สุดคือ<strong class="text-[#eef3f8]">ทุกค่ายและทุกหมวดถูกรวมไว้ในบัญชีเดียว</strong>
        สมาชิกเลือกหมวดที่สนใจได้จากเมนูเกม และสลับไปดูอีกหมวดได้จากจุดเดียวกัน ไม่ต้องสมัครแยกหรือเปลี่ยนไปใช้หลายเว็บไซต์เพื่อไล่หาว่ารายการที่อยากเล่นอยู่ที่ไหน
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#e3d8c0]">
        <li class="flex gap-3">
          <span class="font-bold text-[#b6c1cd]">1.</span>
          <span><strong class="text-[#eef3f8]">เปิดหน้าหลักของ SAGAME66 ก่อน</strong> เมนูจัดหมวดหมู่ไว้ให้เลือกจากหน้าเดียว จึงเห็นภาพรวมของหมวดที่เปิดให้เลือกได้ตั้งแต่หน้าแรก</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#b6c1cd]">2.</span>
          <span>
            <strong class="text-[#eef3f8]">เลือกหมวดที่สนใจจากเมนูเกม</strong> ถ้ายังไม่แน่ใจว่าถนัดแนวไหน ให้ไล่เปิดดูทีละหมวดทั้งบาคาร่า รูเล็ต คาสิโนสด และเกมโต๊ะอื่น แล้วค่อยกลับมาเลือกทีหลัง
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#b6c1cd]">3.</span>
          <span>
            <strong class="text-[#eef3f8]">ตรวจสอบชื่อค่าย รายละเอียดเกม และระดับเดิมพันของรายการนั้น</strong> ระบบแสดงข้อมูลไว้ให้ดูก่อน อ่านให้จบก่อนตัดสินใจว่าจะเข้าเล่นรายการไหน
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#b6c1cd]">4.</span>
          <span>
            <strong class="text-[#eef3f8]">ลองสลับไปดูค่ายอื่นด้วยบัญชีเดิม</strong> การสลับหมวดและค่ายทำได้จากเมนูเดียวกัน จึงไม่ต้องออกไปเปิดเว็บไซต์อื่นระหว่างเปรียบเทียบ
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#b6c1cd]">5.</span>
          <span>
            <strong class="text-[#eef3f8]">ทวนข้อมูลอีกครั้งก่อนกดเข้าเล่นด้วยเงินจริง</strong> ทั้งหมวด ชื่อค่าย ชื่อเกม และระดับเดิมพันที่ตั้งไว้ ขั้นตอนนี้คือจุดที่ลดความผิดพลาดได้มากที่สุด
          </span>
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#e3d8c0]">
        <strong class="text-[#eef3f8]">รายการที่เปิดให้ใช้งานเปลี่ยนแปลงได้ตามช่วงเวลา จึงควรตรวจสอบหมวด ค่าย และรายการล่าสุดจากหน้าเว็บไซต์ทุกครั้งก่อนเข้าเล่น</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title="จุดที่ควรดูให้ครบก่อนเดิมพันด้วยเงินจริง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e3d8c0]">
        การไล่ดูระบบมีประโยชน์ที่สุดเมื่อมองมันเหมือนการอ่านคู่มือ ไม่ใช่การลุ้นรางวัล
        <strong class="text-[#eef3f8]">เป้าหมายคือรู้จักระบบให้ครบก่อนที่เงินจริงจะเข้ามาเกี่ยวข้อง</strong>
        ห้าเรื่องด้านล่างคือสิ่งที่ควรเก็บข้อมูลไว้ระหว่างเปิดดู
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#e3d8c0]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#b6c1cd]">🗂️</span>
          <span>
            <strong class="text-[#eef3f8]">โครงของหน้าหลักและตำแหน่งของแต่ละหมวดในเมนู</strong> จำให้ได้ว่าหมวดไหนอยู่ตรงไหน และสลับไปดูหมวดอื่นได้จากจุดใด จะได้ไม่ต้องหาใหม่ทุกครั้งที่อยากเปลี่ยนเกม
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#b6c1cd]">🎲</span>
          <span>
            <strong class="text-[#eef3f8]">หมวดเกมที่เลือกได้จากบัญชีเดียว</strong> ทั้งบาคาร่า รูเล็ต คาสิโนสด และเกมโต๊ะยอดนิยมอื่นตามรายการที่เปิดให้บริการ ลองเปิดดูให้ครบก่อน จะได้รู้ว่าแนวไหนเหมาะกับตัวเองที่สุดโดยไม่ต้องสมัครเพิ่ม
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#b6c1cd]">📱</span>
          <span>
            <strong class="text-[#eef3f8]">อุปกรณ์ที่จะใช้เล่นจริง</strong> บัญชีเดียวใช้ได้ทั้งบนมือถือและคอมพิวเตอร์ ลองเปิดหมวดเดียวกันจากทั้งสองเครื่องดูก่อน แล้วเลือกอุปกรณ์ที่ใช้งานถนัดกว่า
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#b6c1cd]">🎁</span>
          <span>
            <strong class="text-[#eef3f8]">เงื่อนไขของโปรโมชั่นที่จะกดรับ</strong> ทั้งโบนัสแนะนำเพื่อน <strong class="text-[#ffe9a3]">0.8%</strong> และโบนัสคืนยอดเสีย <strong class="text-[#ffe9a3]">0.3%</strong>
            มีรอบคำนวณและข้อกำหนดต่างกัน ควรเปิดดูรายละเอียดของแต่ละรายการจากหน้าโปรโมชั่นก่อนกดรับ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#b6c1cd]">💡</span>
          <span><strong class="text-[#eef3f8]">งบที่คุณรับความเสี่ยงได้</strong> ระบบมีตัวเลือกการเดิมพันหลายระดับตามเงื่อนไขของแต่ละเกม ตั้งวงเงินต่อรอบไว้ล่วงหน้า แล้วดูว่าระดับไหนทำให้เล่นได้โดยไม่กระทบค่าใช้จ่ายอื่น</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#e3d8c0]">
        <strong class="text-[#eef3f8]">ผลของเกมเดิมพันทุกประเภทตัดสินจากระบบของเกมนั้น ไม่มีสูตร ไม่มีเกมใด และไม่มีช่วงเวลาไหนที่รับประกันว่าจะชนะ</strong>
