---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { pageGraph } from "../lib/schema";

// PAOTUNG (เป๋าตุง) เป็นเว็บรวมเกมออนไลน์แบบ One-Stop Service ครบสี่หมวด —
// สล็อต · บาคาร่าและคาสิโนสด · หวยรัฐบาล ลาว ฮานอย · กีฬา มวย ฟุตบอล
// หน้านี้จึงหมายถึงการทำความรู้จักระบบและตัวเกมก่อนเดิมพันด้วยเครดิตจริง:
// ขั้นตอนเริ่มใช้งานบนมือถือ การตรวจกติกาและช่วงเดิมพันของแต่ละเกม
// โปรโมชั่นที่กดรับสิทธิ์เองได้ผ่านหน้าเว็บ และการติดต่อแอดมินเมื่อติดปัญหา
// (หวยเป็นเพียงหนึ่งในสี่หมวด ไม่ใช่เว็บหวย — ห้ามใส่ลิงก์ /ตรวจหวย หรือ /แนวทาง)
//
// แบรนด์เก่าเคยวางแกลเลอรี 12 การ์ด (gamedemo7..18.webp) ไว้ที่หน้านี้ ถูกถอดออกไปตั้งแต่
// สิบรอบรีแบรนด์ก่อน และไม่มีการ import แล้ว — อย่านำกลับมา ลำพังการ import ก็ทำให้ไฟล์ถูก
// emit ลง dist/ และ verify-build จะแดงถ้ามีรูปที่ไม่มีใคร render ทั้งชุด
//
// ทุกข้อความอ้างอิงบรีฟของแบรนด์นี้เท่านั้น: แพลตฟอร์มแบบ Portal & Privilege
// อินเทอร์เฟซโทนกรมท่าตัดทองเมทัลลิค กราฟิกสล็อตระดับ Cinematic Lighting ·
// เดิมพันเริ่มต้นเพียง 1 บาท ทุกค่ายเกม · เกมลิขสิทธิ์แท้ครบทุกค่าย ·
// โปรโมชั่นแจกทุกยูสผ่านระบบอัตโนมัติ 100% ไม่ล็อคยูส เท่าเทียมกันทุกคน ·
// แนะนำเพื่อน 0.8% ถอนเป็นเงินสดได้ · คืนยอดเสีย 0.3% ทุกยอดการเล่น ·
// สมัครบนมือถือ 3 ขั้นตอน (OTP · ผูกบัญชีธนาคารชื่อเดียวกับผู้สมัคร · ตั้งรหัสผ่าน)
// เติมเงิน 1 บาทก็เริ่มเล่นได้ · ฝาก-ถอนอัตโนมัติ 3-5 วินาที ทุกธนาคารชั้นนำ
// ทำรายการเองได้ตลอด 24 ชั่วโมง · รองรับมือถือ iOS/Android แท็บเล็ต พีซี
// โดยไม่ต้องโหลดแอปพลิเคชัน · แอดมิน Line Official 24 ชั่วโมง
// ไม่มีการอ้างใบอนุญาต การจดทะเบียน ปีที่ก่อตั้ง จำนวนสมาชิก ตัวเลข RTP การันตีผลกำไร
// หรือชื่อค่ายเกมรายใดที่บรีฟไม่ได้ระบุ
//
// Announcement รอบนี้หมุนมาใช้ Announcement5 ทั้งเว็บ — default message ของไฟล์นั้น
// เป็นข้อความของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ได้
//
// พาเลตต์ PAOTUNG ไม่มีสีแดงเลย — น้ำเงินโลโก้ #226ca9 นำโครงสร้าง ฟ้าสว่าง
// #3b9ddd / #7fc4f0 สำหรับ hover ไอคอน และข้อควรระวัง ทองเมทัลลิค #e0bd72 กับ
// ทองอ่อน #f5e3b3 ใช้กับ <strong> ในเนื้อความและปุ่มสมัคร เนื้อความ #cfdeed
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 157
const pageDescription = "หน้าทดลองเล่น PAOTUNG แนะนำวิธีเริ่มใช้งานตั้งแต่สมัครสมาชิกบนมือถือ ฝากเครดิตอัตโนมัติ เลือกเกมสล็อต บาคาร่า หวย กีฬา จนถึงตรวจกติกาและช่วงเดิมพันก่อนลงเงิน";

const graph = pageGraph(Astro, {
  name: "ทดลองเล่น PAOTUNG ทำความรู้จักระบบและเกมทุกหมวดก่อนเดิมพันจริง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title="ทดลองเล่น PAOTUNG ลองใช้ระบบก่อนเดิมพัน เริ่มต้น 1 บาท ทุกเกม" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่น PAOTUNG ทำความรู้จักระบบและเกมทุกหมวดก่อนเดิมพันจริง" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#cfdeed]">
        <strong class="text-[#f5e3b3]">PAOTUNG (เป๋าตุง)</strong> ออกแบบแพลตฟอร์มในรูปแบบ Portal &amp; Privilege ที่รวมอินเทอร์เฟซโทนสีกรมท่าตัดกับลวดลายสีทองเมทัลลิค และเกมลิขสิทธิ์แท้ครบทุกค่ายไว้ในบัญชีเดียว
        ทั้งสล็อตออนไลน์ บาคาร่าและคาสิโนสด หวยรัฐบาล หวยลาว หวยฮานอย ไปจนถึงเดิมพันกีฬา มวย และฟุตบอล หน้านี้จึงเปิดไว้ให้ผู้เริ่มต้นได้
        <strong class="text-[#f5e3b3]">ทำความคุ้นเคยกับขั้นตอนใช้งาน และตรวจกติกา อัตราจ่าย กับช่วงเดิมพันของแต่ละเกม</strong>
        ก่อนเดิมพันด้วยเครดิตของตัวเอง เพราะรายละเอียดเหล่านี้ต่างกันไปตามหมวดเกมและรูปแบบการเดิมพันที่เลือก
      </p>

      <p class="text-left text-base leading-relaxed text-[#cfdeed]">
        ขอให้เข้าใจตรงกันว่าการทดลองเล่นเป็นการทำความคุ้นเคยกับระบบเท่านั้น
        <strong class="text-[#7fc4f0]">ผลลัพธ์ของเกมไม่สามารถรับประกันกำไรหรือผลชนะได้ทุกครั้ง</strong>
        ควรเลือกเกมจากกติกา รูปแบบการเดิมพัน และงบประมาณที่เหมาะสมกับตนเอง หากติดปัญหาระหว่างใช้งาน แจ้งแอดมิน PAOTUNG ผ่าน Line Official ได้ตลอด 24 ชั่วโมง พร้อมชื่อเกม เวลา จำนวนเงิน และรายละเอียดของรายการ
        เพื่อให้ตรวจสอบได้ตรงจุด
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="เริ่มใช้งาน PAOTUNG บนมือถือด้วยตัวเองใน 3 ขั้นตอน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#cfdeed]">
        ผู้ใช้งานใหม่เปิดบัญชี PAOTUNG ผ่านระบบสมัครสมาชิกอัตโนมัติได้ด้วยตัวเอง ระบบออกแบบมาให้ใช้งานบนโทรศัพท์มือถือได้อย่างสมบูรณ์แบบ
        และใช้บัญชีเดียวเข้าเล่นได้ครบทุกหมวดเกมโดยไม่ต้องสมัครหลายบัญชี ใช้เวลาเพียงไม่กี่วินาทีด้วย
        <strong class="text-[#f5e3b3]">3 ขั้นตอน</strong> และเป็นลำดับเดียวกันไม่ว่าจะเลือกเล่นเกมไหน
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#cfdeed]">
        <li class="flex gap-3">
          <span class="font-bold text-[#7fc4f0]">1.</span>
          <span><strong class="text-[#f5e3b3]">กรอกเบอร์โทรศัพท์</strong> ระบุเบอร์มือถือของคุณเพื่อรับรหัส OTP สำหรับยืนยันตัวตนและรักษาความปลอดภัยของบัญชี</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#7fc4f0]">2.</span>
          <span>
            <strong class="text-[#f5e3b3]">ผูกบัญชีธนาคาร</strong> เลือกธนาคารและกรอกเลขบัญชีที่ต้องการใช้ทำรายการฝาก-ถอน โดยชื่อ-นามสกุลต้องตรงกับชื่อบัญชีที่สมัครเท่านั้น เพื่อให้ระบบฝาก-ถอนออโต้ทำงานได้ทันที
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#7fc4f0]">3.</span>
          <span><strong class="text-[#f5e3b3]">ตั้งรหัสผ่าน</strong> กำหนด Username และ Password จากนั้นล็อคอินเข้าสู่ระบบ เติมเงินเพียง 1 บาท เลือกเกมที่สนใจ แล้วเริ่มสนุกได้ทันที</span>
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#cfdeed]">
        หลังเปิดบัญชีเรียบร้อยสามารถตรวจสอบเครดิต ประวัติฝากถอน โปรโมชั่น และรายการใช้งานผ่านหน้าเว็บไซต์ได้โดยตรง ควรไล่ดูให้ครบก่อนใช้เครดิตจริง
        จะช่วยให้เห็นว่ารายการหนึ่งถูกบันทึกและคิดผลมาจากอะไรบ้าง
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ตรวจกติกา อัตราจ่าย และช่วงเดิมพันของแต่ละเกมก่อนยืนยัน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#cfdeed]">
        ข้อมูลที่ควรเปิดดูให้ครบก่อนลงเดิมพันมีอยู่ไม่กี่อย่าง และระบบแสดงไว้ในหน้าเกมให้ตรวจสอบได้อยู่แล้ว
        <strong class="text-[#f5e3b3]">ข้อมูลชุดนี้คือสิ่งที่กำหนดว่ารอบหนึ่งคิดผลอย่างไร</strong> จึงควรอ่านให้จบก่อนตัดสินใจว่าจะลงเท่าไร
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#cfdeed]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#7fc4f0]">🎰</span>
          <span>
            <strong class="text-[#f5e3b3]">กติกาและรอบพิเศษของเกมสล็อต</strong> หน้าอธิบายในตัวเกมบอกไว้ว่าสัญลักษณ์ชุดใดนับเป็นรางวัล และรอบพิเศษเปิดเมื่อใด ภาพกราฟิกคมชัดพร้อมแสงเงาแบบ Cinematic Lighting
            ควรอ่านก่อนเลือกเกม
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#3b9ddd]">🃏</span>
          <span>
            <strong class="text-[#f5e3b3]">กติกาโต๊ะบาคาร่าและคาสิโนสด</strong> เป็นการถ่ายทอดสัญญาณภาพสดจากคาสิโนชั้นนำ แต่ละโต๊ะกำหนดรูปแบบการวางเดิมพันและวงเงินต่อตาไว้ไม่เท่ากัน ตรวจที่หน้าโต๊ะก่อนเข้าเล่น
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#7fc4f0]">🎫</span>
          <span>
            <strong class="text-[#f5e3b3]">ประเภทหวยและอัตราจ่าย</strong> รับแทงทั้งหวยรัฐบาล หวยลาว และหวยฮานอย แต่ละประเภทมีรอบปิดรับและอัตราจ่ายของตัวเอง ควรดูรอบที่เปิดรับล่าสุดก่อนส่งโพย
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#3b9ddd]">🥊</span>
          <span><strong class="text-[#f5e3b3]">ราคาค่าน้ำของกีฬา มวย และฟุตบอล</strong> ราคาขยับได้ตามสถานการณ์จริงของแต่ละแมตช์ ให้ยึดราคาที่ระบบแสดง ณ เวลาที่ยืนยันเดิมพันเป็นหลัก</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#7fc4f0]">🎯</span>
          <span>
            <strong class="text-[#f5e3b3]">ช่วงเดิมพันต่ำสุดและวงเงินสูงสุด</strong> PAOTUNG เปิดให้เดิมพันเริ่มต้นเพียง 1 บาท ทุกค่ายเกม แต่ตัวเลขต่ำสุด-สูงสุดของแต่ละเกมกำหนดไว้ไม่เท่ากัน ตรวจค่าที่ตั้งอยู่ในเกมก่อนกดยืนยันทุกครั้ง
          </span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#cfdeed]">
        รายชื่อเกมและตารางการแข่งขันที่พร้อมให้บริการเปลี่ยนแปลงได้ ควรตรวจสอบรายการล่าสุดจากหน้าเลือกเกมในเว็บก่อนเข้าเล่น
        <strong class="text-[#7fc4f0]">ทุกเกมเป็นเกมลิขสิทธิ์แท้ที่ผลของแต่ละรอบไม่แน่นอน ไม่มีเกมใดรับประกันผลล่วงหน้า และช่วงเดิมพันของตัวเกมเป็นคนละเรื่องกับขั้นต่ำของรายการฝาก-ถอน</strong>
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ฝาก-ถอนออโต้ กดรับโปรโมชั่นเอง และดูแลความปลอดภัยของบัญชี" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#cfdeed]">
        สมาชิกเติมเครดิตได้เองผ่าน<strong class="text-[#f5e3b3]">ระบบฝาก-ถอนเงินอัตโนมัติ (Auto)</strong> ที่ทำรายการเสร็จสิ้นภายใน
        <strong class="text-[#e0bd72]">3-5 วินาที</strong> รองรับทุกธนาคารชั้นนำ ทำรายการฝาก ส่งคำขอถอน และตรวจสอบสถานะรายการผ่านบัญชีของตนเองได้โดยตรงตลอด 24 ชั่วโมง โดยให้ยึดตัวเลขและสถานะที่ระบบแสดง
        ณ เวลาทำรายการเป็นหลัก
      </p>

      <ul class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#cfdeed]">
        <li class="flex gap-3">
          <span class="text-[#7fc4f0]" aria-hidden="true">•</span> โปรโมชั่นแนะนำเพื่อน รับค่าคอมมิชชั่นสูงถึง 0.8% จากทุกยอดการเดิมพันของเพื่อน เพียงคัดลอกลิงก์ส่วนตัวส่งให้เพื่อนสมัครและเข้าเล่น เป็นรายได้เสริมแบบ
          Passive Income ที่ถอนเป็นเงินสดได้ ตรวจสอบยอดที่นำมาคำนวณได้หลัง Login
        </li>
        <li class="flex gap-3">
          <span class="text-[#3b9ddd]" aria-hidden="true">•</span> โปรโมชั่นคืนยอดเสีย 0.3% ในทุกยอดการเล่น ให้เป็นเครดิตสำรองกลับไปต่อยอดในรอบถัดไป กดรับสิทธิ์ได้ง่ายๆ ผ่านหน้าเว็บ จึงควรอ่านวิธีคำนวณและเงื่อนไขล่าสุดก่อนกดรับ
        </li>
        <li class="flex gap-3">
          <span class="text-[#7fc4f0]" aria-hidden="true">•</span> ทุกโปรโมชั่นแจกให้ทุกยูสเซอร์อย่างเท่าเทียมผ่านระบบอัตโนมัติ 100% การันตีไม่มีการล็อคยูส หากเครดิตไม่เข้า รายการถอนค้าง หรือสถานะรายการไม่อัปเดต
          ให้ตรวจสอบประวัติรายการในบัญชีก่อน และเก็บหลักฐานไว้จนกว่าการตรวจสอบจะเสร็จสิ้น
        </li>
