---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";

import { pageGraph } from "../lib/schema";

// หวยพยัคฆ์ เป็นเว็บหวย ไม่ใช่เว็บสล็อตและไม่ใช่คาสิโน — บรีฟรอบนี้ (ดรอป
// 2026-09-22 "หวยพยัคฆ์ แทงหวย อันดับ1 รัฐบาลไทย ฮานอย ลาวพัฒนา จ่ายเต็ม")
// พูดถึงหวยอย่างเดียว ห้ามเอ่ยสล็อต บาคาร่า หรือบอล และคอปปี้ของแบรนด์รอบก่อน
// (HENG35 "สล็อตยูสใหม่ ไม่ล็อค / คืนยอดเสีย 0.3% / แนะนำเพื่อน 0.8%") ถูกเขียน
// ใหม่ทั้งหน้าแล้ว ไม่เหลือประโยคเดิม
//
// บรีฟรอบนี้ไม่ได้ระบุว่ามี "เครดิตทดลอง" หรือโหมดเดโมที่ถอนไม่ได้ สิ่งที่บรีฟระบุคือ
// "เลือกดูรอบที่เปิดรับ ตรวจสอบเลขที่ต้องการ และจัดการรายการได้จากหน้าเดียว" กับ
// "ตรวจสอบอัตรา รอบหวย และประเภทบิลได้จากหน้าเดียวก่อนยืนยัน" — หน้านี้จึงเขียนบน
// ฐานนั้น คือการไล่ดูระบบก่อนยืนยันบิลจริง ห้ามกลับไปอ้างกติกาของเครดิตทดลอง
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: แกลเลอรีเดโม 12 การ์ด (gamedemo7..18.webp) ยังอยู่
// บนดิสก์แต่เป็นของแบรนด์อื่น (mtime 2026-08-04 ไม่ใช่ดรอปรอบนี้) — gamedemo7.webp
// มีโลโก้ "askmeslot" ของลูกค้าเจ้าอื่นพิมพ์ทับกลางรูป และทั้งชุดเป็นรูปเกมสล็อต
// ซึ่งไม่เกี่ยวกับเว็บหวย ห้ามนำกลับมา import เด็ดขาด (ห้ามลบไฟล์ เป็นอินเวนทอรี)
// ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง
// slide1.png ของดรอปนี้เป็นของหน้า /promotion และ index — ไม่ดึงมาใช้ซ้ำที่นี่
//
// ข้อเท็จจริงทุกบรรทัดมาจากบรีฟรอบนี้เท่านั้น: รวมรัฐบาลไทย ฮานอย ลาวพัฒนา และ
// หวยหุ้นต่างประเทศไว้ในระบบเดียว · เลือกดูรอบที่เปิดรับ ตรวจสอบเลข จัดการรายการ
// ได้จากหน้าเดียว · เปิดรับเลขเด็ดเลขดังตามรอบที่ระบบกำหนด ไม่อั้นเลข จ่ายเต็ม ·
// แสดงอัตราจ่ายของแต่ละประเภทเลขก่อนยืนยันรายการ · เลข 2 ตัวจ่าย 100 · เลข 3 ตัว
// จ่าย 1,000 · สมัครเองได้ใน 3 ขั้นตอน · แอดมินออนไลน์ 24 ชั่วโมง · รายการที่
// เปิดรับต่างกันตามวันและช่วงเวลา
// — ห้ามอ้างชื่อเจ้ามือ เลขใบอนุญาต ปีที่ก่อตั้ง จำนวนสมาชิก อัตราจ่ายอื่นนอกจาก
// 100/1,000 "ปลอดภัย 100%" หรือการันตีว่าจะถูกรางวัล
//
// Announcement รอบนี้หมุนมาใช้ AnnouncementHuay ทั้งเว็บ — default message ของ
// ไฟล์นั้นเป็นข้อความของ หวยพยัคฆ์ อยู่แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message
//
// พาเลตต์ หวยพยัคฆ์ (กรมท่า + ทอง แทนดำ + ทองของ HENG35):
// พื้น #030b1c · การ์ด #08152f · ผิวยก #0f2149 · ขอบบรอนซ์ #ab6d13 ·
// ทองหลัก #fadb6c ใช้กับเลขลำดับ ไอคอน และสต็อปกลางของเกรเดียนต์ ·
// ทองสว่าง #fdf5a4 เป็นสต็อปบน · เนื้อความ #dbe4f7 · <strong> #fadb6c ·
// ตัวอักษรบนปุ่มทอง #030b1c · เงาลึก rgba(3,11,28,α) · ออร่าทอง rgba(250,219,108,α)
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 152
const pageDescription = "ทดลองเล่นหวยพยัคฆ์ ไล่ดูเมนูรายการหวยรัฐบาลไทย ฮานอย ลาวพัฒนา และหวยหุ้นต่างประเทศ พร้อมวิธีเลือกเลขและตรวจสอบอัตราจ่ายกับรอบที่เปิดรับก่อนยืนยันบิลจริง";

const graph = pageGraph(Astro, {
  name: "ทดลองเล่น หวยพยัคฆ์ ไล่ดูรายการหวยและอัตราจ่ายก่อนยืนยันบิล",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title="ทดลองเล่น หวยพยัคฆ์ ไล่ดูรายการหวยและอัตราจ่ายก่อนยืนยันบิล" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่น หวยพยัคฆ์ ไล่ดูรายการหวยและอัตราจ่ายก่อนยืนยันบิล" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dbe4f7]">
        <strong class="text-[#fadb6c]">หวยพยัคฆ์</strong> รวมรายการแทงหวยหลายประเภทไว้ในระบบเดียว
        ทั้งรัฐบาลไทย ฮานอย ลาวพัฒนา และหวยหุ้นต่างประเทศ หน้านี้จึงเปิดไว้ให้คนที่ยังไม่คุ้นกับระบบได้
        <strong class="text-[#fadb6c]">ไล่ดูรอบที่เปิดรับ ตรวจสอบเลขที่ต้องการ และดูอัตราจ่ายของแต่ละประเภทเลขก่อนยืนยันบิลจริง</strong>
        ตั้งแต่โครงของเมนูรายการหวย ไปจนถึงประเภทบิลที่แต่ละรอบเปิดให้เลือก
      </p>

      <p class="text-left text-base leading-relaxed text-[#dbe4f7]">
        เพราะ<strong class="text-[#fadb6c]">รายการที่เปิดรับอาจแตกต่างกันตามวันและช่วงเวลา</strong>
        การเปิดดูข้อมูลของแต่ละตลาดก่อนจึงช่วยให้เลือกรอบที่เหมาะกับเลขที่ติดตามอยู่ได้ง่ายขึ้น
        และรู้ล่วงหน้าว่าต้องกรอกอะไรบ้างก่อนกดยืนยันครั้งแรก
      </p>
    </div>
  </ContentBox>

  <ContentBox title="เลือกดูรายการหวยของ หวยพยัคฆ์ ได้จากหน้าเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dbe4f7]">
        จุดที่ช่วยให้ไล่ดูรายการได้เร็วที่สุดคือ<strong class="text-[#fadb6c]">ทุกตลาดถูกรวมไว้ในระบบเดียว</strong>
        คนที่ต้องการดูว่ารอบไหนยังเปิดรับอยู่จึงทำได้จากหน้าเดียว ไม่ต้องสลับหลายเว็บไซต์เพื่อไล่หาว่ารายการที่ติดตามปิดรับเวลาใด
        และเมื่อเจอรอบที่ต้องการแล้วยังตรวจสอบอัตราจ่ายกับประเภทบิลได้จากจุดเดียวกัน
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#dbe4f7]">
        <li class="flex gap-3">
          <span class="font-bold text-[#fadb6c]">1.</span>
          <span><strong class="text-[#fadb6c]">เปิดหน้าเว็บของ หวยพยัคฆ์ แล้วดูหน้ารวมหวย</strong> รายการทั้งหมดถูกจัดไว้ในที่เดียว จึงเห็นภาพรวมของตลาดที่เปิดรับได้ทันที</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#fadb6c]">2.</span>
          <span>
            <strong class="text-[#fadb6c]">เลือกประเภทหวยที่ติดตามอยู่</strong> ภายในระบบมีทั้งรัฐบาลไทย ฮานอย ลาวพัฒนา และหวยหุ้นต่างประเทศ ถ้ายังไม่แน่ใจว่าถนัดตลาดไหน ให้ไล่เปิดดูทีละรายการก่อน
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#fadb6c]">3.</span>
          <span>
            <strong class="text-[#fadb6c]">ดูรอบที่เปิดรับและเวลาปิดรับของรายการนั้น</strong> รายการที่เปิดรับแตกต่างกันตามวันและช่วงเวลา จึงควรเช็กรอบล่าสุดก่อนทุกครั้ง
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#fadb6c]">4.</span>
          <span>
            <strong class="text-[#fadb6c]">ตรวจสอบอัตราจ่ายและประเภทบิลก่อนเลือกเลข</strong> ระบบแสดงอัตราของแต่ละประเภทเลขไว้ให้ดูก่อน ทั้งเลข 2 ตัวและเลข 3 ตัว
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#fadb6c]">5.</span>
          <span>
            <strong class="text-[#fadb6c]">ทวนเลข รอบเวลา และรายละเอียดของบิลอีกครั้งก่อนยืนยัน</strong> ขั้นตอนนี้คือจุดที่ลดความผิดพลาดได้มากที่สุดก่อนส่งรายการ
          </span>
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#dbe4f7]">
        <strong class="text-[#fadb6c]">รายการที่เปิดรับเปลี่ยนแปลงได้ตามวันและช่วงเวลา จึงควรตรวจสอบรอบล่าสุดจากหน้ารวมหวยของเว็บไซต์ทุกครั้งก่อนทำรายการ</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title="จุดที่ควรดูให้ครบก่อนยืนยันบิลจริง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dbe4f7]">
        การไล่ดูระบบมีประโยชน์ที่สุดเมื่อมองมันเหมือนการอ่านคู่มือ ไม่ใช่การลุ้นรางวัล
        <strong class="text-[#fadb6c]">เป้าหมายคือรู้จักระบบให้ครบก่อนที่เงินจริงจะเข้ามาเกี่ยวข้อง</strong>
        ห้าเรื่องด้านล่างคือสิ่งที่ควรเก็บข้อมูลไว้ระหว่างเปิดดู
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#dbe4f7]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fadb6c]">🗂️</span>
          <span><strong class="text-[#fadb6c]">โครงของเมนูและรายการหวย</strong> จำให้ได้ว่าตลาดไหนอยู่ตรงไหน และสลับไปดูรายการของอีกตลาดได้จากจุดใด จะได้ไม่ต้องหาใหม่ตอนใกล้ปิดรับ</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fadb6c]">🕒</span>
          <span>
            <strong class="text-[#fadb6c]">รอบเวลาของรายการที่ติดตาม</strong> แต่ละตลาดมีรอบเปิดรับของตัวเอง และรายการที่เปิดรับต่างกันตามวัน จึงควรเช็กรอบล่าสุดก่อนเลือกเลขทุกครั้ง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fadb6c]">🎟️</span>
          <span>
            <strong class="text-[#fadb6c]">อัตราจ่ายของประเภทเลขที่จะแทง</strong> ระบบระบุไว้ว่าเลข 2 ตัวจ่าย 100 และเลข 3 ตัวจ่าย 1,000 ตามเงื่อนไขของแต่ละรายการ เปิดดูให้ชัดก่อนยืนยัน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fadb6c]">🧾</span>
          <span>
            <strong class="text-[#fadb6c]">รายละเอียดของบิลก่อนกดยืนยัน</strong> ทวนเลขที่กรอก ประเภทบิล และรอบเวลาอีกครั้ง เพราะบิลที่ส่งไปแล้วจะยึดตามที่ระบบบันทึกไว้
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fadb6c]">💡</span>
          <span><strong class="text-[#fadb6c]">งบที่คุณรับความเสี่ยงได้</strong> ตั้งวงเงินต่อรอบไว้ล่วงหน้า แล้วดูว่าระดับไหนทำให้ติดตามผลได้โดยไม่กระทบค่าใช้จ่ายอื่น</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#dbe4f7]">
        <strong class="text-[#fadb6c]">ผลรางวัลตัดสินจากการออกรางวัลของแต่ละตลาด ไม่มีสูตร ไม่มีเลขชุดใด และไม่มีช่วงเวลาไหนที่รับประกันว่าจะถูกรางวัล</strong>
        ข้อมูลที่เก็บได้จากการเปิดดูระบบช่วยให้เลือกรอบและประเภทบิลที่เหมาะกับตัวเองเท่านั้น ไม่ได้ชี้ผลของรอบถัดไป
        จึงควรกำหนดงบล่วงหน้าและหยุดเมื่อถึงขีดที่ตั้งไว้เสมอ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="แอดมิน หวยพยัคฆ์ ออนไลน์ 24 ชั่วโมง ติดต่อได้ทันที" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dbe4f7]">
        หากติดปัญหาระหว่างใช้งาน ไม่ว่าจะเป็น<strong class="text-[#fadb6c]">การสมัคร รอบหวย อัตราจ่าย วิธีเลือกเลข หรือการใช้งานเมนูภายในเว็บไซต์</strong>
        สามารถติดต่อแอดมิน หวยพยัคฆ์ ได้ตลอด 24 ชั่วโมง ทีมงานพร้อมช่วยให้ข้อมูลและตรวจสอบปัญหาตามรายละเอียดที่แจ้ง
      </p>

      <p class="text-left text-base leading-relaxed text-[#dbe4f7]">
        เวลาแจ้งปัญหาเข้ามา ควรระบุรอบหวย เวลาที่ทำรายการ และเลขที่ส่งไปให้ครบ
        เพื่อให้ทีมงานตรวจสอบตามข้อมูลที่แจ้งได้เร็วขึ้น
        <strong class="text-[#fadb6c]">และควรยึดสถานะของบิลที่ระบบแสดง ณ เวลาที่ทำรายการเป็นหลัก</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title="สมัครแทงหวย หวยพยัคฆ์ ได้เองใน 3 ขั้นตอน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dbe4f7]">
        เมื่อคุ้นเคยกับระบบแล้วและอยากลงสนามจริง <strong class="text-[#fadb6c]">สมัครผ่านหน้าเว็บไซต์ได้ด้วยตัวเอง ขั้นตอนไม่ซับซ้อน</strong>
        เริ่มจากกรอกข้อมูลในหน้าสมัคร ตรวจสอบรายละเอียดให้ถูกต้อง แล้วกดยืนยันบัญชี
        เมื่อสมัครเสร็จสามารถเข้าสู่ระบบเพื่อเลือกรายการหวย รอบที่เปิดรับ และเลขที่ต้องการได้จากหน้าเว็บไซต์ทันที
      </p>

      <p class="text-left text-base leading-relaxed text-[#dbe4f7]">
