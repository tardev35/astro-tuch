---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";

import { pageGraph } from "../lib/schema";

// KINDEE365 เป็นเว็บหวย/ลอตเตอรี่ออนไลน์ ไม่ใช่คาสิโน หน้านี้จึงหมายถึงการทำความรู้จัก
// ระบบส่งโพยก่อนแทงด้วยเครดิตจริง — ประเภทหวยที่เปิดรับ อัตราจ่าย เวลาเปิด-ปิดรับ
// วงเงินของรอบ ระบบฝากถอนออโต้ธนาคาร/วอลเลท และการเช็กประวัติรายการในบัญชีสมาชิก
// (รอบก่อนหน้านี้หน้านี้ยังพูดถึงบาคาร่า/สล็อต/ฟุตบอลของแบรนด์เดิม ซึ่งผิดหมวดสำหรับแบรนด์นี้)
//
// แบรนด์เก่าเคยวางแกลเลอรี 12 การ์ด (gamedemo7..18.webp) ไว้ที่หน้านี้ ถูกถอดออกไปตั้งแต่
// เจ็ดรอบรีแบรนด์ก่อน และไม่มีการ import แล้ว — อย่านำกลับมา เหตุผลมีสองชั้น: ลำพังการ import
// ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดงถ้ามีรูปที่ไม่มีใคร render ทั้งชุด
// ยังเป็นภาพของ "askmeslot" ซึ่งเป็นโลโก้เว็บอื่น การนำกลับมาคือการโชว์แบรนด์คู่แข่ง
// บนหน้าเว็บของ KINDEE365
//
// ทุกข้อความอ้างอิง src/assets/content.txt เท่านั้น: หวย 4 ประเภท (รัฐบาลไทย / ลาวพัฒนา /
// ฮานอย / หุ้นต่างประเทศ) · เรท 3 ตัวบาทละ 1,000 และ 2 ตัวบาทละ 100 พร้อมคำเตือนให้ยึด
// ตัวเลขที่ระบบแสดงจริง ณ เวลาส่งโพย · ฝากถอนออโต้ธนาคาร/วอลเลท · เจ้าหน้าที่ 24 ชม.
// ไม่มีการอ้างใบอนุญาต การจดทะเบียน ปีที่ก่อตั้ง จำนวนสมาชิก หรือการันตีผลกำไร
//
// Announcement ใช้ Announcement2 ตัวเดียวกับ index — default message ของไฟล์นั้น
// เป็นข้อความของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ได้
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 158
const pageDescription = "หน้าทดลองเล่นของ KINDEE365 แนะนำวิธีทำความคุ้นเคยกับระบบหวยออนไลน์ ตั้งแต่สมัครสมาชิก ฝากถอนออโต้ เลือกประเภทหวย ตรวจอัตราจ่าย ไปจนถึงส่งโพยและดูประวัติรายการ";

const graph = pageGraph(Astro, {
  name: "ทดลองเล่น KINDEE365 ทำความรู้จักระบบส่งโพยก่อนแทงด้วยเครดิตจริง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title="ทดลองเล่น KINDEE365 ลองใช้ระบบส่งโพยหวยรัฐบาลไทย ลาว ฮานอย และหุ้นต่างประเทศ" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่น KINDEE365 ทำความรู้จักระบบส่งโพยก่อนแทงด้วยเครดิตจริง" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#cfe3f7]">
        <strong class="text-[#f8dc8c]">KINDEE365</strong> เปิดบริการสำหรับผู้ที่ต้องการแทงหวยออนไลน์ผ่านระบบที่ใช้งานง่ายบนมือถือและคอมพิวเตอร์ มีทั้งหวยรัฐบาลไทย หวยลาวพัฒนา หวยฮานอย และหวยหุ้นต่างประเทศตามรอบที่เปิดบริการ
        หน้านี้จึงเปิดไว้ให้ผู้เริ่มต้นได้<strong class="text-[#f8dc8c]">ทำความคุ้นเคยกับขั้นตอนใช้งาน ตรวจเรท ดูเวลาเปิด-ปิดรับ และวงเงินของรอบ</strong>
        ก่อนยืนยันโพยด้วยเครดิตของตัวเอง เพราะหวยแต่ละประเภทและแต่ละรอบกำหนดเงื่อนไขไว้ไม่เหมือนกัน
      </p>

      <p class="text-left text-base leading-relaxed text-[#cfe3f7]">
        ขอให้เข้าใจตรงกันว่าการทดลองเล่นเป็นการทำความคุ้นเคยกับระบบเท่านั้น
        <strong class="text-[#f8dc8c]">ผลของแต่ละรอบไม่แน่นอน ไม่มีเลขหรือสูตรใดรับประกันผลได้เสียล่วงหน้า</strong>
        หากติดปัญหาระหว่างใช้งาน แจ้งเจ้าหน้าที่ KINDEE365 ได้ตลอด 24 ชั่วโมง พร้อมประเภทหวย รอบเดิมพัน เวลา จำนวนเงิน และรายละเอียดของรายการ เพื่อให้ตรวจสอบได้ตรงจุด
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="ขั้นตอนเริ่มใช้งาน KINDEE365 ตั้งแต่สมัครสมาชิกจนถึงส่งโพย" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#cfe3f7]">
        ลำดับการใช้งานจริงมีอยู่ไม่กี่ขั้น และเป็นลำดับเดียวกันทุกประเภทหวย ลองไล่ดูให้ครบก่อนใช้เครดิตจริง จะช่วยให้เห็นว่ารายการหนึ่งถูกบันทึกและคิดผลมาจากอะไรบ้าง
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#cfe3f7]">
        <li class="flex gap-3"><span class="font-bold text-[#e8bb4a]">1.</span> เข้าหน้าสมัครสมาชิก KINDEE365 และกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน ทำผ่านมือถือหรือคอมพิวเตอร์ได้โดยตรง</li>
        <li class="flex gap-3"><span class="font-bold text-[#e8bb4a]">2.</span> Login เข้าบัญชี แล้วฝากเครดิตผ่านระบบออโต้ โดยเลือกธนาคารหรือวอลเลทตามช่องทางที่เว็บไซต์เปิดรองรับ</li>
        <li class="flex gap-3"><span class="font-bold text-[#e8bb4a]">3.</span> เลือกประเภทหวยที่ต้องการ ทั้งหวยรัฐบาลไทย หวยลาวพัฒนา หวยฮานอย หรือหวยหุ้นต่างประเทศ ตามรอบที่เปิดบริการอยู่</li>
        <li class="flex gap-3"><span class="font-bold text-[#e8bb4a]">4.</span> เลือกเลขและจำนวนเงินเดิมพัน แล้วเปิดดูอัตราจ่าย เลขอั้น วงเงิน และเวลาปิดรับของรอบนั้นให้ครบก่อนตัดสินใจ</li>
        <li class="flex gap-3"><span class="font-bold text-[#e8bb4a]">5.</span> ยืนยันโพย แล้วเก็บข้อมูลบิลไว้เทียบกับประวัติรายการที่เปิดดูย้อนหลังได้เองจากบัญชีสมาชิก</li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#8fb3d9]">
        ก่อนกดยืนยันควรทวนอีกครั้งว่าเลือกประเภทหวย เลข และยอดแทงถูกต้อง เพราะเป็นจุดที่ผิดพลาดได้ง่ายที่สุดเมื่อสลับไปมาระหว่างหลายประเภทหวยในบัญชีเดียว
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ตรวจอัตราจ่ายและเงื่อนไขของรอบก่อนยืนยันโพยทุกครั้ง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#cfe3f7]">
        ข้อมูลที่ควรเปิดดูให้ครบก่อนส่งโพยมีอยู่ไม่กี่อย่าง และระบบแสดงไว้ให้ตรวจสอบได้จากบัญชีเดียวอยู่แล้ว
        <strong class="text-[#f8dc8c]">ตัวเลขชุดนี้คือสิ่งที่ใช้คิดยอดตามเรทของรายการ</strong> จึงควรอ่านให้จบก่อนตัดสินใจว่าจะลงเท่าไร
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#cfe3f7]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e8bb4a]">🎯</span>
          <span><strong class="text-[#f8dc8c]">ประเภทหวยที่เลือก</strong> หวยรัฐบาลไทย ลาวพัฒนา ฮานอย และหุ้นต่างประเทศ ใช้รอบและเงื่อนไขคนละชุด ควรอ่านของประเภทที่กำลังจะแทงเป็นหลัก</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e8bb4a]">💹</span>
          <span>
            <strong class="text-[#f8dc8c]">อัตราจ่าย</strong> ที่กำหนดไว้สำหรับหน้านี้คือ เลข 3 ตัว บาทละ 1,000 และเลข 2 ตัว บาทละ 100 ใช้คำนวณยอดเบื้องต้นได้ แต่ให้ยึดตัวเลขที่แสดงจริงในระบบ ณ เวลาส่งโพยเป็นหลัก
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e8bb4a]">⏰</span>
          <span><strong class="text-[#f8dc8c]">เวลาเปิด-ปิดรับและเลขอั้น</strong> ต่างกันตามประเภทหวยและรอบ ควรเผื่อเวลาไว้ก่อนรอบปิดรับ จะได้เหลือจังหวะแก้ไขเมื่อกรอกผิด</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e8bb4a]">💰</span>
          <span><strong class="text-[#f8dc8c]">วงเงินและยอดแทง</strong> ควรกำหนดล่วงหน้าเป็นหน่วยย่อย เช่น มีทุน 1,000 บาท ให้คิด 1 หน่วยเท่ากับ 10 บาท แล้ววางยอดต่อเลขให้อยู่ในระดับที่รับได้</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#8fb3d9]">
        สำหรับข้อความว่า “รับทุกเลข” หรือ “จ่ายไม่อั้น” ให้ยึดวงเงินและเงื่อนไขที่ระบบแสดง ณ เวลาส่งโพยเป็นหลัก เนื่องจากบางเลขหรือบางรอบอาจมีข้อกำหนดเฉพาะ
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ฝากถอนออโต้ เช็กประวัติโพย และดูแลความปลอดภัยของบัญชีสมาชิก" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#cfe3f7]">
        สมาชิกจัดการเครดิตผ่านระบบฝากถอนออโต้ได้เอง โดยเลือกใช้ธนาคารหรือวอลเลทตามช่องทางที่เว็บไซต์เปิดรองรับ
        <strong class="text-[#f8dc8c]">ฝากเครดิต ส่งคำขอถอน และตรวจสอบสถานะรายการผ่านบัญชีของตนเองได้โดยตรง</strong>
        ก่อนทำธุรกรรมควรตรวจสอบชื่อบัญชี จำนวนเงิน ยอดขั้นต่ำ และวงเงินต่อรายการให้ถูกต้องทุกครั้ง เมื่อส่งโพยสำเร็จ ระบบจะเก็บรอบ เลข ยอดแทง และอัตราจ่ายที่แสดงตอนยืนยันไว้ในประวัติของบัญชี
      </p>

      <ul class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#cfe3f7]">
        <li class="flex gap-3">
          <span class="text-[#e8bb4a]" aria-hidden="true">•</span> หน้านี้อธิบายการใช้งานและการทำความคุ้นเคยกับระบบเท่านั้น การแทงจริงต้องสมัครสมาชิกและฝากเครดิตผ่านช่องทางที่เปิดให้บริการก่อน
        </li>
        <li class="flex gap-3">
          <span class="text-[#e8bb4a]" aria-hidden="true">•</span> หากเครดิตไม่เข้า รายการถอนค้าง หรือสถานะธุรกรรมไม่อัปเดต ให้เก็บข้อมูลและหลักฐานรายการไว้เพื่อใช้ประกอบการตรวจสอบกับเจ้าหน้าที่
        </li>
        <li class="flex gap-3">
          <span class="text-[#e8bb4a]" aria-hidden="true">•</span> ตั้งจุดหยุดเมื่อเสียและจุดที่จะพักเมื่อได้กำไรไว้ตั้งแต่ก่อนเริ่ม แล้วหยุดตามแผน ไม่เพิ่มยอดเดิมพันเพื่อไล่เอาเงินคืน
        </li>
        <li class="flex gap-3">
          <span class="text-[#e8bb4a]" aria-hidden="true">•</span>
          <strong class="text-[#f8dc8c]">ตั้งรหัสผ่านที่คาดเดายากและไม่เปิดเผย OTP แก่บุคคลอื่น</strong> ไม่ว่าจะเป็นการติดต่อจากช่องทางใดก็ตาม
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#cfe3f7]">
        หากพบปัญหาสมัครสมาชิก Login ไม่ได้ ส่งโพยไม่สำเร็จ ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง หรือข้อมูลในบัญชีไม่ตรง ติดต่อเจ้าหน้าที่ KINDEE365 ได้ตลอด 24 ชั่วโมง พร้อมแจ้งเวลา จำนวนเงิน ประเภทหวย
        และรายละเอียดของรายการ <strong class="text-[#f8dc8c]">การเดิมพันมีความเสี่ยง ควรกำหนดงบประมาณให้เหมาะสมทุกครั้ง</strong>
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก KINDEE365"
          class="flex items-center justify-center rounded-lg border border-[#e8bb4a]/70 bg-gradient-to-r from-[#f8dc8c] via-[#e8bb4a] to-[#b98213] px-8 py-3 font-black text-[#010b26] shadow-[0_0_15px_rgba(232,187,74,0.30)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ KINDEE365"
          class="flex items-center justify-center rounded-lg border border-[#2b8ae9]/60 bg-transparent px-8 py-3 font-bold text-[#a3dbfb] transition-all hover:scale-105 hover:border-[#a3dbfb] hover:bg-[#083163]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>

  <Navfoot />
</MainLayout>
