---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login,
// /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx
// ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บน
// ข้อเท็จจริงของ NATO168 เท่านั้น (src/assets/content.txt)
//
// NATO168 เป็น **เว็บสล็อตออนไลน์ / พีจีเว็บตรง** แง่มุมที่บรีฟระบุไว้มีเท่านี้:
// รวมเกมสล็อตออนไลน์สำหรับผู้เริ่มต้น ระบบใช้งานไม่ซับซ้อน · มีทั้งสล็อตพีจีและเกม
// จากค่ายที่เว็บไซต์เปิดรองรับ · เข้าเล่นผ่านมือถือได้โดยไม่ต้องสลับหลายแพลตฟอร์ม ·
// หมวดโบนัสไทม์สำหรับติดตามเกมและกิจกรรมที่เปิดสิทธิ์ในแต่ละช่วง · เกมหลายรูปแบบ
// ตั้งแต่สล็อตวงล้อทั่วไป ฟรีสปิน ตัวคูณ ไปจนถึงเกมที่มีฟีเจอร์โบนัส · ตรวจสอบโบนัส
// เกมยอดนิยม เครดิต และรายละเอียดโปรโมชั่นผ่านบัญชีของตนเอง · คืนยอดเสีย 0.3% ·
// แนะนำเพื่อน 0.8% · สมัคร 3 ขั้นตอน · แอดมิน 24 ชั่วโมง · PIN/OTP ห้ามเปิดเผย
//
// ⚠️ บรีฟรอบนี้ **ไม่ได้เอ่ยชื่อเกมใดเลย** — ชื่อเกมของรอบก่อน (Mahjong Ways 2 /
// Fortune Tiger / Sweet Bonanza) และคำว่า "3 เกมแนะนำ" ถูกถอดออกทั้งหมด ห้ามนำกลับ
// มา ตัวเลขที่อ้างได้มีแค่ 0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง และห้ามเพิ่ม
// ใบอนุญาต ชื่อค่าย/ผู้ให้บริการ ชื่อธนาคาร ยอดฝากขั้นต่ำ จำนวนสมาชิก ปีที่ก่อตั้ง
// ค่า RTP หรือความเร็วฝาก-ถอน ที่บรีฟไม่ได้ระบุ
//
// แบรนด์ก่อนๆ ในไฟล์นี้เคยเป็น **เว็บหวย** (หวย365 / หวยเฮง789) คนละสินค้ากันหมด —
// คำว่า หวย โพย งวด เลขเด็ด อัตราจ่าย ฮานอย ลาว หุ้น บอล ค่าน้ำ ลีก คาสิโนสด
// บาคาร่า ห้ามปรากฏ และห้ามลิงก์ไป /ตรวจหวย หรือ /แนวทาง ซึ่งจอดอยู่ที่
// src/pages-disabled/ (href ไปหน้าที่ไม่มีอยู่ = build แดง)
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามี "โหมดทดลอง" เครดิตทดลอง หรือเกมเดโมเป็นบริการของเว็บ —
// จึงห้ามสัญญาสินค้าตัวนั้น และห้ามดึง src/assets/gamedemo*.webp กลับมา (ไฟล์ชุดนั้น
// ลงวันที่ 2026-08-04 เป็นอินเวนทอรีเก่า ไม่ใช่อาร์ตเวิร์กของดรอปนี้)
// หน้านี้จึงพูดถึงเฉพาะสิ่งที่บรีฟระบุไว้ตรงๆ ว่าควรทำก่อนเริ่มเล่น นั่นคือ
// "ควรอ่านกติกา ฟีเจอร์ และช่วงเดิมพันของแต่ละเกม รวมถึงกำหนดงบก่อนเริ่มทุกครั้ง"
// = ไล่ดูเกมและฟีเจอร์ในระบบให้ครบก่อนปั่นรอบจริง ไม่ใช่การเล่นฟรี
//
// hedge ของบรีฟที่ห้ามตัดทิ้ง: "รับโบนัสทุกยูส"/"ไม่มีล็อคยูส" ควรอ้างอิงเงื่อนไขจริง
// ของเว็บไซต์ เพราะบางโปรโมชั่นอาจกำหนดประเภทสมาชิก เกมที่ร่วมรายการ หรือยอดที่ใช้
// คำนวณต่างกัน · แต่ละรายการโปรโมชั่นอาจมีเงื่อนไขเรื่องค่ายเกม รอบคำนวณ หรือยอดที่
// นำมาคิดโบนัสต่างกัน ควรตรวจสอบก่อนกดรับทุกครั้ง · ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: banner1/banner1-mobile/og.png เป็นของ glob ที่
// MainLayout ปักไว้ ห้ามอ้างจากหน้า · slide1/slide2 ของดรอปนี้เป็นของ index และ
// /promotion · slide3/slide4/banner2/banner3 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น Announcement5 ทั้งเว็บ (รอบก่อน NAZA99 ใช้ตัว Premium) —
// orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ NATO168 แล้ว จึงเรียก
// แบบ bare ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ NATO168 (brand-spec §2) **ทอง-เงิน-ดำ สองโทนจริง ไม่ใช่ทองล้วน** เพราะ
// เวิร์ดมาร์กเป็นคำว่า NATO สีเงินเมทัลลิกคู่กับเลข 168 สีทอง: ทองอ่อน #fde8a8
// (หมึกเน้น) · ทองแบรนด์ #edb543 (จุด bullet marker ขอบ) · ทองลึก #a9761f
// (ขอบ/ปลายเกรเดียนต์ปุ่มหลัก) · เงิน #e6e6e6 (แอ็กเซนต์รองจริง — กรอบและตัวอักษร
// ของปุ่มรอง) · ผิวการ์ด #101010 · ผิวอุ่น #17120a · หมึกบนพื้นทอง #1a1203 ·
// เนื้อความ #f4ead3 (BRAND_TEXT)
// ชุดทองล้วนของ NAZA99 (#fdf2ac #e4b34d #c08f2b #8a5f12 #140c02 #241404 #0a0501
// #1a1000 #f3e8cf rgba(228,179,77,*) rgba(10,5,1,*)) ออกครบทุกจุดแล้ว
// กฎคอนทราสต์: พื้นทอง → หมึกเข้ม #1a1203 เสมอ ห้ามวางหมึกอ่อนบนพื้นทอง
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// — การ์ดตั้งสีเนื้อความไว้แล้ว ย้ำบนย่อหน้าอีกชั้นเพื่อให้สี body copy อ่านออกจาก
// ตัวหน้าเอง
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 152
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "ทดลองเล่นสล็อต NATO168 ด้วยการไล่ดูกติกา ฟีเจอร์ และช่วงเดิมพันของแต่ละเกมให้ครบก่อนปั่นรอบจริง พร้อมจุดที่ควรตรวจในหมวดสล็อตพีจีและโบนัสไทม์ของเว็บไซต์";

const pageTitle = "ทดลองเล่นสล็อต NATO168 ไล่ดูกติกา ฟีเจอร์ และช่วงเดิมพันก่อนปั่นรอบจริง";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed text-[#f4ead3]">
        <strong class="text-[#fde8a8]">NATO168</strong> รวมเกมสล็อตออนไลน์ไว้ในระบบที่ใช้งานไม่ซับซ้อน
        <strong class="text-[#fde8a8]">มีทั้งสล็อตพีจีและเกมจากค่ายที่เว็บไซต์เปิดรองรับ เข้าเล่นผ่านมือถือได้โดยไม่ต้องสลับหลายแพลตฟอร์ม</strong>
        หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับเกมสล็อตได้ไล่ดูระบบให้ครบหนึ่งรอบ ตั้งแต่หมวดเกมที่เปิดให้เลือก ไปจนถึงหน้ารายละเอียดของเกมที่สนใจ ก่อนจะเริ่มปั่นรอบจริง
      </p>

      <p class="text-left text-base leading-relaxed text-[#f4ead3]">
        คำว่า “ทดลองเล่น” ที่หน้านี้พูดถึงจึงหมายถึง<strong class="text-[#fde8a8]">การอ่านกติกา ฟีเจอร์ และช่วงเดิมพันของแต่ละเกมให้ครบก่อนเริ่มเล่น รวมถึงกำหนดงบไว้ล่วงหน้า</strong>
        ตามที่เว็บไซต์แนะนำไว้เอง ไม่ใช่การลุ้นผลรางวัล เมื่อ Login แล้วสามารถเลือกเกม ตรวจสอบโบนัส เครดิต และรายละเอียดโปรโมชั่นจากบัญชีเดียวได้ทั้งบนมือถือและคอมพิวเตอร์
      </p>
    </div>
  </ContentBox>

  <ContentBox title="สล็อตพีจีและค่ายเกมของ NATO168 มีฟีเจอร์แบบไหนให้ไล่ดูบ้าง" as="h2">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed text-[#f4ead3]">
        หลัง Login สามารถเลือกสล็อตพีจีรวมถึงเกมสล็อตจากค่ายอื่นที่เปิดให้บริการได้จากบัญชีเดียว
        <strong class="text-[#fde8a8]">เกมในระบบมีหลายรูปแบบ ตั้งแต่สล็อตวงล้อทั่วไป ไปจนถึงเกมที่มีฟีเจอร์โบนัสของตัวเอง</strong>
        การเปิดเทียบกันก่อนจึงช่วยให้เห็นว่าสล็อตแต่ละแบบนับการจ่ายและให้จังหวะโบนัสไม่เหมือนกัน และเหมาะกับการเริ่มจากเกมที่มีกติกาไม่ซับซ้อน
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f4ead3]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#edb543]">🎰</span>
          <span>
            <strong class="text-[#fde8a8]">สล็อตวงล้อทั่วไป</strong> เป็นรูปแบบพื้นฐานที่อ่านหน้าจอได้เร็วที่สุด เหมาะกับการเริ่มต้นเพราะกติกาไม่ซับซ้อน ควรดูให้ชัดว่าเกมนับการจ่ายจากสัญลักษณ์แบบใดก่อนกดปั่นรอบแรก
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#edb543]">🌀</span>
          <span>
            <strong class="text-[#fde8a8]">ฟรีสปิน</strong> เป็นรอบพิเศษที่เกมให้เพิ่มเมื่อเข้าเงื่อนไขของตัวเกมเอง แต่ละเกมกำหนดเงื่อนไขและจำนวนรอบไว้ไม่เท่ากัน จึงควรอ่านจากหน้ารายละเอียดของเกมนั้นโดยตรง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#edb543]">✖️</span>
          <span>
            <strong class="text-[#fde8a8]">ตัวคูณ</strong> คือส่วนที่ทำให้ผลของแต่ละรอบต่างกันมากที่สุด ก่อนเริ่มควรรู้ว่าตัวคูณทำงานตอนไหน คูณกับอะไร และทำงานร่วมกับฟรีสปินของเกมนั้นอย่างไร
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#edb543]">⏰</span>
          <span>
            <strong class="text-[#fde8a8]">หมวดโบนัสไทม์</strong> เป็นที่สำหรับติดตามเกมและกิจกรรมที่เปิดสิทธิ์ในแต่ละช่วง เปิดดูไว้ก่อนเริ่มเล่นจะช่วยให้เห็นว่ารอบนี้มีรายการใดเปิดอยู่บ้าง
          </span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#f4ead3]">
        <strong class="text-[#fde8a8]">จำนวนเกมและช่วงเวลาอัปเดตขึ้นอยู่กับค่ายและผู้ให้บริการ</strong>
        ก่อนเล่นจึงควรตรวจสอบว่าเกมที่สนใจเปิดให้บริการอยู่ในระบบหรือไม่ และหากมีเกมใหม่เพิ่มเข้ามาระหว่างเดือน สามารถดูรายการล่าสุดจากหมวดเกมใหม่หรือหมวดเกมยอดนิยมผ่านบัญชีสมาชิกได้โดยตรง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="จุดที่ควรตรวจให้ครบก่อนเริ่มเล่นสล็อตรอบจริง" as="h2">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed text-[#f4ead3]">
        การไล่ดูระบบมีประโยชน์ที่สุดเมื่อมองมันเหมือนการอ่านคู่มือของเกม
        <strong class="text-[#fde8a8]">เป้าหมายคือรู้จักกติกาและฟีเจอร์ของเกมให้ครบก่อนที่เงินจริงจะเข้ามาเกี่ยวข้อง</strong>
        เรื่องด้านล่างคือสิ่งที่ควรเก็บข้อมูลไว้ระหว่างเปิดดู และควรตรวจซ้ำทุกครั้งที่เปลี่ยนไปเล่นเกมอื่น
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f4ead3]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#edb543]">📜</span>
          <span>
            <strong class="text-[#fde8a8]">กติกาและรูปแบบการจ่ายของเกมนั้น</strong> เป็นสิ่งแรกที่ควรอ่าน เพราะสล็อตบางเกมนับการจ่ายเป็นแนวเรียง บางเกมนับเป็นกลุ่มสัญลักษณ์ การเข้าใจผิดตรงนี้ทำให้อ่านผลของแต่ละรอบคลาดเคลื่อนทั้งเกม
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#edb543]">🎚️</span>
          <span>
            <strong class="text-[#fde8a8]">ช่วงเดิมพันที่เกมเปิดให้เลือก</strong> ควรดูให้ครบก่อนกดปั่นรอบแรก เพราะแต่ละเกมไม่ได้กำหนดช่วงไว้เท่ากัน และเป็นค่าที่ควรตั้งให้สอดคล้องกับงบที่วางไว้ล่วงหน้า
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#edb543]">📋</span>
          <span>
            <strong class="text-[#fde8a8]">เงื่อนไขของโปรโมชั่นที่กำลังใช้อยู่</strong> ทั้งคืนยอดเสีย โบนัส 0.3% และแนะนำเพื่อน โบนัส 0.8% แต่ละรายการอาจมีเงื่อนไขเรื่องค่ายเกม รอบคำนวณ หรือยอดที่นำมาคิดโบนัสต่างกัน จึงควรตรวจสอบรายละเอียดก่อนกดรับ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#edb543]">📣</span>
