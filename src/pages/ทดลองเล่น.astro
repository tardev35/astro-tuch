---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { pageGraph } from "../lib/schema";

// UFAGOOL เป็นกีฬาคาสิโนเว็บตรงที่รวมเกมพนันออนไลน์หลายประเภทไว้ในระบบเดียว —
// บรีฟรอบนี้ (ดรอป 2026-09-23 "UFAGOOL กีฬาคาสิโนเว็บตรง รวมพนันออนไลน์
// ในเครือลิขสิทธิ์แท้") ระบุหมวดไว้ว่า การเดิมพันกีฬา คาสิโนสด สล็อต และ
// เกมออนไลน์ประเภทอื่นตามรายการที่เปิดให้บริการ เลือกได้จากบัญชีเดียว
// แบรนด์นี้นำด้วยกีฬา (โลโก้และแบนเนอร์เป็นฟุตบอล)
//
// คอปปี้ของแบรนด์รอบก่อน (เว็บรวมพนันที่อ้างหมวดบาคาร่า ลอตเตอรี บอล ไฮโล
// และหัวข้อฝากถอนวอลเลท) ถูกเขียนใหม่ทั้งหน้าแล้ว เพราะบรีฟของ UFAGOOL ไม่ได้
// ระบุหมวดเหล่านั้นเลย ห้ามใช้ find-and-replace กับหน้านี้ และห้ามเขียนคำไทย
// ที่แปลว่าลอตเตอรีที่ใดในหน้านี้ ส่วนบาคาร่า/ไฮโลให้พูดรวมเป็น "คาสิโนสด" เท่านั้น
//
// บรีฟรอบนี้ไม่ได้ระบุว่ามี "เครดิตทดลอง" หรือโหมดเดโมที่ถอนไม่ได้ สิ่งที่บรีฟระบุคือ
// "รวมเกมพนันหลายหมวดให้เลือกจากหน้าเดียว", "ตรวจสอบหมวดเกมและค่ายที่รองรับได้
// จากหน้าเว็บไซต์ก่อนเข้าใช้งาน" และ "เข้าถึงเกมได้สะดวกผ่านบัญชีเดียวทั้งบนมือถือ
// และคอมพิวเตอร์" — หน้านี้จึงเขียนบนฐานนั้น คือการไล่ดูระบบและรายละเอียด
// ก่อนเดิมพันด้วยเงินจริง ห้ามกลับไปอ้างกติกาของเครดิตทดลองหรือโหมดเล่นฟรี
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: แกลเลอรีเดโม 12 การ์ด (gamedemo7..18.webp) ยังอยู่
// บนดิสก์แต่เป็นของแบรนด์อื่น (mtime 2026-08-04 ไม่ใช่ดรอปรอบนี้) — gamedemo7.webp
// มีโลโก้ "askmeslot" และ gamedemo15.webp มีโลโก้ "askmebet" ของเว็บเจ้าอื่น
// พิมพ์ทับอยู่ในรูป ส่วน gamedemo13.webp เป็นการ์ด "Sexy Slot" ภาพโป๊เปลือย
// ห้ามนำกลับมา import เด็ดขาด (ห้ามลบไฟล์ เป็นอินเวนทอรี) ลำพังการ import ก็ทำให้
// ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง
// slide1.png / slide2.png ของดรอปนี้เป็นของ index และ /promotion — ไม่ดึงมาใช้ซ้ำที่นี่
// banner1/banner1-mobile เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า และ
// banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กค้างของลูกค้าเจ้าอื่น ห้าม import
//
// ข้อเท็จจริงทุกบรรทัดมาจากบรีฟรอบนี้เท่านั้น: กีฬา · คาสิโนสด · สล็อต ·
// เกมออนไลน์ประเภทอื่นตามรายการที่เปิดให้บริการ · เครือตรงแบรนด์ลิขสิทธิ์แท้
// ไม่ผ่านเอเย่นต์ · บัญชีเดียวใช้ได้ทั้งมือถือและคอมพิวเตอร์ · ตรวจสอบหมวดเกม
// และค่ายที่รองรับได้ก่อนเข้าใช้งาน · โปรโมชั่นบางรายการกดรับหลังสมัครได้
// โดยไม่ต้องฝาก · โบนัสแนะนำเพื่อน 0.8% · โบนัสคืนยอดเสีย 0.3% · สมัครผ่าน
// มือถือ 3 ขั้นตอน · แอดมินดูแลตลอด 24 ชั่วโมง
// — ห้ามอ้างชื่อค่ายเกม เลขใบอนุญาต ปีที่ก่อตั้ง จำนวนสมาชิก ค่า RTP อัตราจ่าย
// ขั้นต่ำการเดิมพัน "ฝากถอนออโต้ไม่มีขั้นต่ำ" "ปลอดภัย 100%" หรือการันตีว่าจะชนะ
//
// ห้ามลิงก์ไปสองหน้าลอตเตอรีที่ถูกพักไว้ใน src/pages-disabled/ เด็ดขาด
// การลิงก์ไปเส้นทางที่ไม่มีจริงทำให้ verify-build แดง
//
// Announcement รอบนี้หมุนมาใช้ Announcement3 ทั้งเว็บ — default message ของ
// ไฟล์นั้นเป็นข้อความของ UFAGOOL อยู่แล้ว จึงเรียกแบบ bare เหมือน index.astro
// ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ UFAGOOL (แดงคริมสัน + เงินโครเมียม บนพื้นเกือบดำ แทนแดง + ทองของรอบก่อน):
// พื้นเกือบดำ #0a0708 · การ์ด #16100f · การ์ดยก #241a1a · ขอบแดงลึก #5e0507 ·
// แดงหลัก #c50d12 · แดงสว่าง #ef1f25 · แดงลึกปลายเกรเดียนต์ #7a0103 ·
// ขาวเงิน #f4f7fa ใช้กับชื่อแบรนด์และข้อความเน้น · เงินกลาง #b8c3cf ใช้กับป้าย
// เลขลำดับและไอคอน · เนื้อความ #cdd5dd (BRAND_TEXT) · ตัวอักษรบนปุ่มไล่สีแดง
// #f4f7fa · ตัวเลขโบนัส 0.8%/0.3% ใช้ #ff5a5f เท่านั้น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 154
const pageDescription = "ทดลองเล่น UFAGOOL ไล่ดูเมนูและหมวดเกมทั้งกีฬา คาสิโนสด และสล็อต ก่อนเดิมพันด้วยเงินจริง ทั้งวิธีเลือกจากบัญชีเดียว การใช้งานบนมือถือ และการตรวจสอบเงื่อนไข";

const graph = pageGraph(Astro, {
  name: "ทดลองเล่น UFAGOOL ไล่ดูหมวดกีฬา คาสิโนสด และสล็อตก่อนเดิมพันด้วยเงินจริง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title="ทดลองเล่น UFAGOOL ไล่ดูหมวดกีฬา คาสิโนสด และสล็อตก่อนเดิมพันด้วยเงินจริง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่น UFAGOOL ไล่ดูหมวดกีฬา คาสิโนสด และสล็อตก่อนเดิมพันด้วยเงินจริง" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#cdd5dd]">
        <strong class="text-[#f4f7fa]">UFAGOOL</strong> รวมการเดิมพันกีฬา คาสิโนสด สล็อต และเกมรูปแบบอื่นตามรายการที่เปิดให้บริการไว้ในบัญชีเดียว หน้านี้จึงเปิดไว้ให้คนที่ยังไม่คุ้นกับระบบได้
        <strong class="text-[#f4f7fa]">ไล่ดูหมวดที่เปิดให้ใช้งาน เปิดรายละเอียดของเกมและค่ายที่รองรับ และทำความเข้าใจเมนูให้ครบก่อนเข้าเล่นด้วยเงินจริง</strong>
        ตั้งแต่โครงของหน้าหลัก ไปจนถึงข้อมูลที่ระบบแสดงไว้ในแต่ละหมวด
      </p>

      <p class="text-left text-base leading-relaxed text-[#cdd5dd]">
        เพราะทุกหมวด<strong class="text-[#f4f7fa]">ถูกรวมให้เลือกจากหน้าเดียว</strong>
        การเปิดดูให้ทั่วก่อนจึงช่วยให้เห็นว่าหมวดไหนอยู่ตรงไหน และรู้ล่วงหน้าว่าต้องดูข้อมูลอะไรบ้างก่อนกดเข้าเล่นครั้งแรก ทั้งเมื่อเปิดจากมือถือและจากคอมพิวเตอร์
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ไล่ดูกีฬา คาสิโนสด และสล็อตของ UFAGOOL ได้จากบัญชีเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#cdd5dd]">
        จุดที่ช่วยให้ไล่ดูเกมได้เร็วที่สุดคือ<strong class="text-[#f4f7fa]">ทุกหมวดถูกรวมไว้ในบัญชีเดียว</strong>
        สมาชิกเลือกหมวดที่สนใจได้จากเมนูเกม และสลับไปดูอีกหมวดได้จากจุดเดียวกัน ไม่ต้องสมัครแยกหรือเปลี่ยนไปใช้หลายเว็บไซต์เพื่อไล่หาว่ารายการที่อยากเล่นอยู่ที่ไหน
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#cdd5dd]">
        <li class="flex gap-3">
          <span class="font-bold text-[#b8c3cf]">1.</span>
          <span><strong class="text-[#f4f7fa]">เปิดหน้าหลักของ UFAGOOL ก่อน</strong> เมนูรวมทุกหมวดไว้ให้เลือกจากหน้าเดียว จึงเห็นภาพรวมของหมวดที่เปิดให้เลือกได้ตั้งแต่หน้าแรก</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#b8c3cf]">2.</span>
          <span>
            <strong class="text-[#f4f7fa]">เลือกหมวดที่สนใจจากเมนูเกม</strong> ถ้ายังไม่แน่ใจว่าถนัดแนวไหน ให้ไล่เปิดดูทีละหมวดทั้งการเดิมพันกีฬา คาสิโนสด และสล็อต แล้วค่อยกลับมาเลือกทีหลัง
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#b8c3cf]">3.</span>
          <span>
            <strong class="text-[#f4f7fa]">ตรวจสอบหมวดเกมและค่ายที่รองรับในหมวดนั้น</strong> ระบบแสดงข้อมูลของแต่ละรายการไว้ให้ดูก่อน อ่านให้จบก่อนตัดสินใจว่าจะเข้าเล่นรายการไหน
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#b8c3cf]">4.</span>
          <span>
            <strong class="text-[#f4f7fa]">ลองสลับไปดูหมวดอื่นด้วยบัญชีเดิม</strong> การสลับหมวดทำได้จากเมนูเดียวกัน จึงไม่ต้องออกไปเปิดเว็บไซต์อื่นระหว่างเปรียบเทียบ
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#b8c3cf]">5.</span>
          <span>
            <strong class="text-[#f4f7fa]">ทวนข้อมูลอีกครั้งก่อนกดเข้าเล่นด้วยเงินจริง</strong> ทั้งหมวด ชื่อรายการ และยอดเดิมพันที่ตั้งไว้ ขั้นตอนนี้คือจุดที่ลดความผิดพลาดได้มากที่สุด
          </span>
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#cdd5dd]">
        <strong class="text-[#f4f7fa]">รายการที่เปิดให้ใช้งานเปลี่ยนแปลงได้ตามช่วงเวลา จึงควรตรวจสอบหมวดและรายการล่าสุดจากหน้าเว็บไซต์ทุกครั้งก่อนเข้าเล่น</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title="จุดที่ควรดูให้ครบก่อนเดิมพันด้วยเงินจริง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#cdd5dd]">
        การไล่ดูระบบมีประโยชน์ที่สุดเมื่อมองมันเหมือนการอ่านคู่มือ ไม่ใช่การลุ้นรางวัล
        <strong class="text-[#f4f7fa]">เป้าหมายคือรู้จักระบบให้ครบก่อนที่เงินจริงจะเข้ามาเกี่ยวข้อง</strong>
        ห้าเรื่องด้านล่างคือสิ่งที่ควรเก็บข้อมูลไว้ระหว่างเปิดดู
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#cdd5dd]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#b8c3cf]">🗂️</span>
          <span>
            <strong class="text-[#f4f7fa]">โครงของหน้าหลักและตำแหน่งของแต่ละหมวดในเมนู</strong> จำให้ได้ว่าหมวดไหนอยู่ตรงไหน และสลับไปดูหมวดอื่นได้จากจุดใด จะได้ไม่ต้องหาใหม่ทุกครั้งที่อยากเปลี่ยนเกม
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#b8c3cf]">⚽</span>
          <span>
            <strong class="text-[#f4f7fa]">หมวดเกมที่เลือกได้จากบัญชีเดียว</strong> ทั้งการเดิมพันกีฬา คาสิโนสด สล็อต และเกมรูปแบบอื่นตามรายการที่เปิดให้บริการ ลองเปิดดูให้ครบก่อน จะได้รู้ว่าแนวไหนเหมาะกับตัวเองที่สุดโดยไม่ต้องสมัครเพิ่ม
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#b8c3cf]">📱</span>
          <span>
            <strong class="text-[#f4f7fa]">อุปกรณ์ที่จะใช้เล่นจริง</strong> บัญชีเดียวใช้ได้ทั้งบนมือถือและคอมพิวเตอร์ ลองเปิดหมวดเดียวกันจากทั้งสองเครื่องดูก่อน แล้วเลือกอุปกรณ์ที่ใช้งานถนัดกว่า
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#b8c3cf]">🎁</span>
          <span>
            <strong class="text-[#f4f7fa]">เงื่อนไขของโปรโมชั่นที่จะกดรับ</strong> ทั้งโบนัสแนะนำเพื่อน <strong class="text-[#ff5a5f]">0.8%</strong> และโบนัสคืนยอดเสีย <strong class="text-[#ff5a5f]">0.3%</strong>
            มีรอบคำนวณและข้อกำหนดต่างกัน ควรเปิดดูรายละเอียดของแต่ละรายการจากหน้าโปรโมชั่นก่อนกดรับ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#b8c3cf]">💡</span>
          <span><strong class="text-[#f4f7fa]">งบที่คุณรับความเสี่ยงได้</strong> ตั้งวงเงินต่อรอบไว้ล่วงหน้า แล้วดูว่าระดับไหนทำให้เล่นได้โดยไม่กระทบค่าใช้จ่ายอื่น</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#cdd5dd]">
        <strong class="text-[#f4f7fa]">ผลของเกมเดิมพันทุกประเภทตัดสินจากระบบของเกมนั้น ไม่มีสูตร ไม่มีเกมใด และไม่มีช่วงเวลาไหนที่รับประกันว่าจะชนะ</strong>
        ข้อมูลที่เก็บได้จากการเปิดดูระบบช่วยให้เลือกหมวดและระดับเดิมพันที่เหมาะกับตัวเองเท่านั้น ไม่ได้ชี้ผลของรอบถัดไป จึงควรกำหนดงบล่วงหน้าและหยุดเมื่อถึงขีดที่ตั้งไว้เสมอ
      </p>
    </div>
  </ContentBox>

