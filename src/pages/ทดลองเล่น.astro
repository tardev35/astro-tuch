---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login,
// /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx
// ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บน
// ข้อเท็จจริงของ DM899 เท่านั้น (src/assets/content.txt)
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
//
// DM899 เป็น **สล็อตคาสิโนเว็บตรงต่างประเทศ บัญชีบริษัทแท้ 100%** แง่มุมที่บรีฟระบุ
// ไว้มีเท่านี้: รวมเกมเดิมพันหลายรูปแบบไว้ในระบบเดียว ทั้งเกมสล็อต เกมคาสิโนสด และ
// หมวดเกมอื่นตามผู้ให้บริการที่เชื่อมต่อกับระบบ · เข้าเล่นผ่านเว็บเบราว์เซอร์บนมือถือ ·
// สลับหมวดเกม ตรวจสอบเครดิต และดูประวัติรายการได้จากบัญชีเดียวโดยไม่ต้องสมัครใหม่
// แยกตามค่าย · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · สมัครบนมือถือ 3 ขั้นตอน ·
// แอดมิน 24 ชั่วโมง · PIN/OTP และรหัสผ่านห้ามเปิดเผย
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามี "โหมดทดลอง" เครดิตทดลอง หรือเกมเดโมเป็นบริการของเว็บ —
// จึงห้ามสัญญาสินค้าตัวนั้น และห้ามดึง src/assets/gamedemo*.webp กลับมา (ไฟล์ชุดนั้น
// เป็นอินเวนทอรีเก่า ไม่ใช่อาร์ตเวิร์กของดรอปนี้)
// หน้านี้จึงพูดถึงเฉพาะสิ่งที่บรีฟระบุไว้ตรง ๆ ว่าควรทำก่อนเริ่มใช้งาน นั่นคือ
// "เลือกประเภทเกมที่ต้องการ พร้อมตรวจสอบโปรโมชั่นและรายละเอียดการเดิมพันก่อนเริ่ม
// ใช้งาน" = ไล่เปิดข้อมูลเกมและเงื่อนไขให้ครบก่อนเล่นด้วยเครดิตจริง ไม่ใช่การเล่นฟรี
//
// ⚠️ บรีฟรอบนี้ **ไม่ได้** เอ่ยถึง สล็อตคลาสสิก ฟรีสปิน ตัวคูณ เกมโบนัส หรือช่วง
// เดิมพันขั้นต่ำ/สูงสุด (นั่นเป็นของบรีฟ 1SS365 รอบก่อน) จึงห้ามอ้างฟีเจอร์ชุดนั้น
// สิ่งที่อ้างได้คือหมวดเกมสามหมวดตามบรีฟ และคำว่า "รายละเอียดการเดิมพัน" ที่บรีฟใช้เอง
//
// คำหมวดหวยของแบรนด์เก่ากว่า (หวย แทงหวย ส่งโพย โพย เลือกเลข 2 ตัว 3 ตัว อัตราจ่าย
// งวด รัฐบาลไทย ฮานอย ลาวพัฒนา หวยหุ้น ตรวจหวย แนวทางหวย) ห้ามหลงเหลือ และห้ามลิงก์
// ไป /ตรวจหวย หรือ /แนวทาง เพราะสองหน้านั้นอยู่ใน src/pages-disabled/ = เราต์ตาย
// และทำให้ build แดง
// ตัวเลขที่อ้างได้มีแค่ 0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง · 100% และห้ามเพิ่ม
// ใบอนุญาต ชื่อผู้ให้บริการ ชื่อธนาคาร ยอดฝากขั้นต่ำ จำนวนสมาชิก ปีที่ก่อตั้ง
// ค่า RTP หรือชื่อค่ายเกม/ชื่อเกม เพราะบรีฟไม่ได้เอ่ยไว้สักชื่อ
//
// ประโยคกำกับของบรีฟที่ห้ามตัดทิ้ง: คำว่า "บัญชีบริษัทแท้ 100%" ควรมีชื่อนิติบุคคล
// และข้อมูลที่ตรวจสอบได้รองรับก่อนนำมาใช้ยืนยันด้านความปลอดภัย · คำว่า "การันตีระบบ
// เกมมาตรฐาน" ควรระบุมาตรฐาน ใบอนุญาต หรือหน่วยงานที่ตรวจสอบได้อย่างชัดเจน เพราะการ
// เป็นแพลตฟอร์มต่างประเทศไม่ได้ยืนยันมาตรฐานหรือความปลอดภัยของระบบโดยอัตโนมัติ ·
// จำนวนค่ายและเกมสามารถเพิ่มหรือลดได้ตามช่วงเวลา
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: banner1/banner1-mobile/og.png เป็นของ glob ที่
// MainLayout ปักไว้ ห้ามอ้างจากหน้า · slide1/slide2 ของดรอปนี้เป็นของ index และ
// /promotion · slide3/slide4/banner2/banner3 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น Announcement3 ทั้งเว็บ (รอบก่อน 1SS365 ใช้
// AnnouncementPremium) — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ
// DM899 แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรง
// กันทั้งเว็บ
//
// พาเลตต์ DM899 (brand-spec §2) **เขียวมรกตนำ แดงสดรอง ทองเสริม บนดำอมเขียว** เพราะ
// โลโก้เป็นตัว D เขียวซ้อนตัว M แดง ตามด้วยเลข 899 โครเมียมเงิน บนแบนเนอร์พื้นดำ
// อมเขียว: เขียวแบรนด์ #01a326 (ขอบ ออรา) · เขียวสว่าง #12c23a (ไอคอน bullet) ·
// #4ade6b (ต้นไล่เฉดปุ่มหลัก, hover) · #01841b (ปลายไล่เฉดปุ่มหลัก) · แดงแบรนด์
// #fb252b (ออรามุมตรงข้าม) · ทองอ่อน #ffe9a8 (หมึก strong ทั้งเว็บ + ตัวอักษรปุ่มรอง) ·
// ทองแบรนด์ #f2b422 (ขอบปุ่มรอง, marker) · พื้นการ์ด #0a1a0e · พื้นยกระดับ #102a16 ·
// หมึกบนพื้นสว่าง #06140a · เนื้อความ #e4f2e4 (BRAND_TEXT)
// ชุดทอง-เงินโครเมียมของ 1SS365 (#edbb23 #ffeeb4 #a87708 #c8cbce #f1f2f3 #121010
// #f0e6d2 #050505 #2a2115 #f7d458 #1a1710 และ rgba(237,187,35,*)) ออกครบทุกจุดแล้ว
// กฎคอนทราสต์: พื้นเขียวสว่าง → หมึก #06140a เสมอ และปุ่มรองเป็น "ขอบทองบนพื้นดำ
// อมเขียว" ไม่ใช่ถมทองอีกใบ
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// — การ์ดตั้งสีเนื้อความ #e4f2e4 ไว้ที่ตัวการ์ดแล้ว ย่อหน้าจึงไม่ใส่คลาสสีซ้ำ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 154
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} ด้วยการไล่เปิดข้อมูลเกมในแต่ละหมวด ตรวจสอบรายละเอียดการเดิมพัน เงื่อนไขโปรโมชั่น และเครดิตในบัญชีให้ครบก่อนเริ่มเล่นด้วยเครดิตจริงทุกครั้ง`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ไล่เปิดข้อมูลเกมและรายละเอียดการเดิมพันก่อนเริ่มเล่นจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed">
        <strong class="text-[#ffe9a8]">{BRAND_NAME}</strong> รวบรวมเกมเดิมพันหลายรูปแบบไว้ในระบบเดียว
        <strong class="text-[#ffe9a8]">ทั้งเกมสล็อต เกมคาสิโนสด และหมวดเกมอื่นตามผู้ให้บริการที่เชื่อมต่อกับระบบ</strong>
        หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับการเดิมพันออนไลน์ได้ไล่ดูระบบให้ครบหนึ่งรอบ ตั้งแต่การเลือกหมวดเกม ไปจนถึงหน้าข้อมูลของเกมที่สนใจ ก่อนจะเริ่มใช้งานด้วยเครดิตจริง
      </p>

      <p class="text-left text-base leading-relaxed">
        คำว่า ทดลองเล่น ที่หน้านี้พูดถึงจึงหมายถึง
        <strong class="text-[#ffe9a8]">การเลือกประเภทเกมที่ต้องการ พร้อมตรวจสอบโปรโมชั่นและรายละเอียดการเดิมพันก่อนเริ่มใช้งาน</strong>
        ตามที่เว็บไซต์แนะนำไว้เอง ไม่ใช่การรับประกันผลของรอบใดรอบหนึ่ง เมื่อ Login แล้วสมาชิกจะสลับหมวดเกม ตรวจสอบเครดิต และดูประวัติรายการได้จากบัญชีเดียว ทั้งบนเว็บเบราว์เซอร์ของมือถือและคอมพิวเตอร์
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`หมวดเกมของ ${BRAND_NAME} ที่ไล่ดูได้ก่อนเริ่มเล่นจริง`} as="h2">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed">
        หลัง Login สามารถเลือกประเภทการเดิมพันได้จากบัญชีเดียว
        <strong class="text-[#ffe9a8]">ตามหมวดเกมและผู้ให้บริการที่เชื่อมต่อกับระบบในขณะนั้น</strong>
        การเปิดเทียบกันก่อนจึงช่วยให้เห็นว่าหมวดไหนเหมาะกับรูปแบบที่ตั้งใจไว้ และควรเริ่มจากหมวดที่หน้าเกมอ่านจบได้เร็วที่สุด
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#12c23a]">🎰</span>
          <span>
            <strong class="text-[#ffe9a8]">เกมสล็อต</strong> เป็นหมวดที่หน้าเกมอ่านจบได้เร็วที่สุด จึงเหมาะกับการใช้ทำความคุ้นเคยกับการค้นหาเกมและตำแหน่งของข้อมูลเกมเป็นรายการแรก
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#12c23a]">🃏</span>
          <span>
            <strong class="text-[#ffe9a8]">เกมคาสิโนสด</strong> เล่นผ่านโต๊ะถ่ายทอดสด เงื่อนไขของแต่ละโต๊ะระบุไว้ในหน้าของโต๊ะนั้นเอง จึงควรเปิดอ่านรายละเอียดการเดิมพันก่อนเข้าร่วมทุกครั้ง ไม่ใช่เทียบเอาจากโต๊ะอื่น
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#12c23a]">🎲</span>
          <span>
            <strong class="text-[#ffe9a8]">หมวดเกมอื่นตามที่เว็บไซต์เปิดให้บริการ</strong> จะปรากฏตามผู้ให้บริการที่เชื่อมต่อกับระบบในช่วงเวลานั้น ควรดูรายการล่าสุดจากหน้าเกมแทนการอ้างจากรายการที่จำไว้
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#12c23a]">🔁</span>
          <span>
            <strong class="text-[#ffe9a8]">การสลับหมวดเกมจากบัญชีเดียว</strong> ทำได้โดยไม่ต้องสมัครบัญชีใหม่แยกตามค่าย ช่วงไล่ดูระบบจึงเป็นจังหวะที่ดีในการจำว่าเมนูสลับหมวด เครดิต และประวัติรายการอยู่ตรงไหน
          </span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed">
        <strong class="text-[#ffe9a8]">จำนวนค่ายและเกมสามารถมีการเพิ่มหรือลดได้ตามช่วงเวลา</strong>
        หากเปลี่ยนไปเล่นเกมอื่นหรือค่ายอื่น ควรเปิดข้อมูลเกมอ่านซ้ำอีกครั้ง เพราะเงื่อนไขที่จำไว้จากเกมก่อนหน้าอาจไม่ใช่ชุดเดียวกับเกมที่กำลังจะเปิด
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/about-us"
          aria-label={`อ่านหน้าเกี่ยวกับเราของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#f2b422]/60 bg-[#102a16] px-8 py-3 font-bold text-[#ffe9a8] transition-all hover:scale-105 hover:border-[#4ade6b] hover:bg-[#0a1a0e] hover:text-[#4ade6b]">
          อ่านเกี่ยวกับเรา
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="จุดที่ควรตรวจให้ครบก่อนเริ่มเล่นด้วยเครดิตจริง" as="h2">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed">
        การไล่ดูระบบมีประโยชน์ที่สุดเมื่อมองมันเหมือนการอ่านรายละเอียดของเกมนั้นให้จบก่อน
        <strong class="text-[#ffe9a8]">เป้าหมายคือรู้เงื่อนไขและรายละเอียดการเดิมพันของเกมที่จะเล่นให้ครบก่อนที่เครดิตจริงจะเข้ามาเกี่ยวข้อง</strong>
        เรื่องด้านล่างคือสิ่งที่ควรเก็บข้อมูลไว้ระหว่างเปิดดู และควรตรวจซ้ำทุกครั้งที่เปลี่ยนไปเล่นเกมหรือค่ายอื่น
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#12c23a]">📖</span>
          <span>
            <strong class="text-[#ffe9a8]">รายละเอียดการเดิมพันของเกมนั้นโดยตรง</strong> เป็นสิ่งแรกที่ควรดู เพราะเงื่อนไขระบุไว้ในหน้าข้อมูลของเกมหรือของโต๊ะที่กำลังเปิดอยู่ ไม่ใช่สิ่งที่เทียบเอาจากเกมอื่นที่เคยเล่นมาก่อน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#12c23a]">💸</span>
          <span>
