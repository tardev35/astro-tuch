---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { pageGraph } from "../lib/schema";

// WY88 เป็นเว็บรวมเกมออนไลน์/คาสิโนที่เน้นทางเข้าเล่นรูปแบบ VIP สำหรับยูสไทย —
// บรีฟรอบนี้ (ดรอป 2026-09-23 "WY88 เว็บเล่นพนันอันดับ1ในไทย เข้าเล่นเกมสดแบบ VIP
// ได้ทันที") ระบุไว้ว่ามีทั้งเกมสดและหมวดเกมอื่นเลือกได้จากบัญชีเดียว
// คอปปี้ของแบรนด์รอบก่อน ("เว็บเดิมพันออนไลน์เจ้าของเดิม อัปเดตระบบใหม่"
// + หมวด บาคาร่า/สล็อต/หวย/ไฮโล/บอล) ถูกเขียนใหม่ทั้งหน้าแล้ว ไม่เหลือประโยคเดิม
// และไม่เหลือชื่อแบรนด์เก่าแม้แต่จุดเดียว
//
// บรีฟรอบนี้ไม่ได้ระบุว่ามี "เครดิตทดลอง" หรือโหมดเดโมที่ถอนไม่ได้ สิ่งที่บรีฟระบุคือ
// "ปรับหน้าระบบและเมนูให้ใช้งานสะดวกกว่าเดิม", "เลือกเกมสดและหมวดเกมที่สนใจได้จาก
// บัญชีเดียว", "ค้นหาเกมและสลับหมวดได้ง่ายกว่าเดิม" และ "รองรับทั้งมือถือและ
// คอมพิวเตอร์" — หน้านี้จึงเขียนบนฐานนั้น คือการไล่ดูระบบและรายละเอียดก่อนเดิมพัน
// ด้วยเงินจริง ห้ามกลับไปอ้างกติกาของเครดิตทดลองหรือโหมดเล่นฟรี
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: แกลเลอรีเดโม 12 การ์ด (gamedemo7..18.webp) ยังอยู่
// บนดิสก์แต่เป็นของแบรนด์อื่น (mtime 2026-08-04 ไม่ใช่ดรอปรอบนี้) — gamedemo7.webp
// มีโลโก้ "askmeslot" และ gamedemo15.webp มีโลโก้ "askmebet" ของเว็บเจ้าอื่น
// พิมพ์ทับอยู่ในรูป ส่วน gamedemo13.webp เป็นการ์ด "Sexy Slot" ภาพโป๊เปลือย
// ห้ามนำกลับมา import เด็ดขาด (ห้ามลบไฟล์ เป็นอินเวนทอรี) ลำพังการ import ก็ทำให้
// ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง
// slide1.png / slide2.png ของดรอปนี้เป็นของ index และ /promotion — ไม่ดึงมาใช้ซ้ำที่นี่
// banner1/banner1-mobile เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า และ
// banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กค้างของลูกค้าเจ้าอื่น ห้าม import
//
// ข้อเท็จจริงทุกบรรทัดมาจากบรีฟรอบนี้เท่านั้น: เว็บรวมเกมออนไลน์ที่เน้นทางเข้าเล่น
// รูปแบบ VIP สำหรับยูสไทย · ปรับหน้าหลัก เมนูเกม และระบบสมาชิกให้ทันสมัยขึ้น ·
// ค้นหาเกมและสลับหมวดได้ง่ายกว่าเดิม · จัดองค์ประกอบการใช้งานให้เป็นระเบียบ ·
// รองรับทั้งมือถือและคอมพิวเตอร์ · เลือกเกมสดและหมวดเกมที่สนใจได้จากบัญชีเดียว ·
// โบนัสแนะนำเพื่อน 0.8% · โบนัสคืนยอดเสีย 0.3% · ตรวจสอบรอบรับสิทธิ์ ยอดที่เข้าเกณฑ์
// และข้อกำหนดก่อนกดรับได้ · สมัครเองผ่านหน้าเว็บไซต์ใน 3 ขั้นตอน · สอบถามแอดมิน
// คาสิโนผ่าน Line Official ได้ตลอด 24 ชั่วโมง
// — ห้ามอ้างชื่อค่ายเกม เลขใบอนุญาต ปีที่ก่อตั้ง จำนวนสมาชิก ค่า RTP อัตราจ่าย
// ขั้นต่ำการเดิมพัน "ฝากถอนออโต้ไม่มีขั้นต่ำ" "ปลอดภัย 100%" หรือการันตีว่าจะชนะ
//
// Announcement รอบนี้หมุนมาใช้ Announcement5 ทั้งเว็บ — default message ของ
// ไฟล์นั้นเป็นข้อความของ WY88 อยู่แล้ว จึงเรียกแบบ bare เหมือน index.astro
// ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ WY88 (ชมพูมาเจนตา + ทองรวย แทนชมพูบับเบิลกัม + เหลืองมะนาวของแบรนด์รอบก่อน):
// พื้นเกือบดำ #170411 · การ์ด #24081a · ขอบมาเจนตาเข้ม #a3145a ·
// มาเจนตาหลัก #ec2b84 ใช้กับ <strong> · ชมพูกุหลาบ #f9a8cd เป็นสต็อปบน ·
// ทองหลัก #e8b33a ใช้กับเลขลำดับและไอคอน และเป็นสต็อปปลายของเกรเดียนต์ ·
// เนื้อความ #fce9f3 (BRAND_TEXT) · ตัวอักษรบนปุ่มไล่สี #170411 ·
// ออร่ามาเจนตา rgba(236,43,132,α)
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 159
const pageDescription = "ทดลองเล่น WY88 ไล่ดูเมนูเกมสดและหมวดเกมในระบบก่อนเดิมพันด้วยเงินจริง ทั้งวิธีเลือกหมวดจากบัญชีเดียว การใช้งานบนมือถือและคอมพิวเตอร์ และการตรวจสอบเงื่อนไขสิทธิ์";

const graph = pageGraph(Astro, {
  name: "ทดลองเล่น WY88 ไล่ดูเกมสดและเมนู VIP ก่อนเดิมพันด้วยเงินจริง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title="ทดลองเล่น WY88 ไล่ดูเกมสดและเมนู VIP ก่อนเดิมพันด้วยเงินจริง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่น WY88 ไล่ดูเกมสดและเมนู VIP ก่อนเดิมพันด้วยเงินจริง" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#fce9f3]">
        <strong class="text-[#ec2b84]">WY88</strong> รวมเกมสดและหมวดเกมอื่นไว้ในบัญชีเดียว หน้านี้จึงเปิดไว้ให้คนที่ยังไม่คุ้นกับระบบได้
        <strong class="text-[#ec2b84]">ไล่ดูหมวดที่เปิดให้ใช้งาน เปิดรายละเอียดของรายการที่สนใจ และทำความเข้าใจเมนูให้ครบก่อนเข้าเล่นด้วยเงินจริง</strong>
        ตั้งแต่โครงของหน้าหลัก ไปจนถึงข้อมูลที่ระบบแสดงไว้ในแต่ละหมวด
      </p>

      <p class="text-left text-base leading-relaxed text-[#fce9f3]">
        เพราะทางเข้าเล่นรอบนี้<strong class="text-[#ec2b84]">ถูกปรับใหม่ทั้งหน้าหลัก เมนูเกม และระบบสมาชิก</strong>
        การเปิดดูให้ทั่วก่อนจึงช่วยให้เห็นว่าหมวดไหนอยู่ตรงไหน และรู้ล่วงหน้าว่าต้องดูข้อมูลอะไรบ้างก่อนกดเข้าเล่นครั้งแรก ทั้งเมื่อเปิดจากมือถือและจากคอมพิวเตอร์
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ไล่ดูเกมสดและหมวดเกมของ WY88 ได้จากบัญชีเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#fce9f3]">
        จุดที่ช่วยให้ไล่ดูเกมได้เร็วที่สุดคือ<strong class="text-[#ec2b84]">ทุกหมวดถูกรวมไว้ในบัญชีเดียว</strong>
        ผู้ใช้งานเลือกหมวดที่สนใจได้จากเมนูเกม และสลับไปดูอีกหมวดได้จากจุดเดียวกัน ไม่ต้องสมัครแยกหรือเปลี่ยนไปใช้หลายเว็บไซต์เพื่อไล่หาว่ารายการที่อยากเล่นอยู่ที่ไหน
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#fce9f3]">
        <li class="flex gap-3">
          <span class="font-bold text-[#e8b33a]">1.</span>
          <span><strong class="text-[#ec2b84]">เปิดทางเข้าเล่น WY88 แล้วดูหน้าหลักก่อน</strong> เมนูรอบนี้ถูกจัดองค์ประกอบใหม่ให้เป็นระเบียบ จึงเห็นภาพรวมของหมวดที่เปิดให้เลือกได้ตั้งแต่หน้าแรก</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#e8b33a]">2.</span>
          <span>
            <strong class="text-[#ec2b84]">เลือกหมวดที่สนใจจากเมนูเกม</strong> ถ้ายังไม่แน่ใจว่าถนัดแนวไหน ให้ไล่เปิดดูทีละหมวดก่อน แล้วค่อยกลับมาเลือกทีหลัง
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#e8b33a]">3.</span>
          <span>
            <strong class="text-[#ec2b84]">เปิดดูรายการภายในหมวดนั้นให้ครบ</strong> ทั้งเกมสดและหมวดอื่นแสดงรายละเอียดไว้ในหน้าของตัวเอง อ่านให้จบก่อนตัดสินใจว่าจะเข้าเล่นรายการไหน
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#e8b33a]">4.</span>
          <span>
            <strong class="text-[#ec2b84]">ลองสลับไปดูหมวดอื่นด้วยบัญชีเดิม</strong> การสลับหมวดทำได้จากเมนูเดียวกัน จึงไม่ต้องออกไปเปิดเว็บไซต์อื่นระหว่างเปรียบเทียบ
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#e8b33a]">5.</span>
          <span>
            <strong class="text-[#ec2b84]">ทวนข้อมูลอีกครั้งก่อนกดเข้าเล่นด้วยเงินจริง</strong> ทั้งหมวด ชื่อรายการ และยอดเดิมพันที่ตั้งไว้ ขั้นตอนนี้คือจุดที่ลดความผิดพลาดได้มากที่สุด
          </span>
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#fce9f3]">
        <strong class="text-[#ec2b84]">รายการที่เปิดให้ใช้งานเปลี่ยนแปลงได้ตามช่วงเวลา จึงควรตรวจสอบหมวดและรายการล่าสุดจากทางเข้าเล่นที่เว็บไซต์ประกาศไว้ทุกครั้งก่อนเข้าเล่น</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title="จุดที่ควรดูให้ครบก่อนเดิมพันด้วยเงินจริง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#fce9f3]">
        การไล่ดูระบบมีประโยชน์ที่สุดเมื่อมองมันเหมือนการอ่านคู่มือ ไม่ใช่การลุ้นรางวัล
        <strong class="text-[#ec2b84]">เป้าหมายคือรู้จักระบบให้ครบก่อนที่เงินจริงจะเข้ามาเกี่ยวข้อง</strong>
        ห้าเรื่องด้านล่างคือสิ่งที่ควรเก็บข้อมูลไว้ระหว่างเปิดดู
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#fce9f3]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e8b33a]">🗂️</span>
          <span>
            <strong class="text-[#ec2b84]">โครงของหน้าหลักและการจัดเมนู</strong> จำให้ได้ว่าหมวดไหนอยู่ตรงไหน และสลับไปดูหมวดอื่นได้จากจุดใด จะได้ไม่ต้องหาใหม่ทุกครั้งที่อยากเปลี่ยนเกม
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e8b33a]">🎥</span>
          <span>
            <strong class="text-[#ec2b84]">หมวดเกมสดและหมวดอื่นที่เลือกได้จากบัญชีเดียว</strong> ลองเปิดดูให้ครบทุกหมวดก่อน จะได้รู้ว่าแนวไหนเหมาะกับตัวเองที่สุดโดยไม่ต้องสมัครเพิ่ม
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e8b33a]">📱</span>
          <span>
            <strong class="text-[#ec2b84]">อุปกรณ์ที่จะใช้เล่นจริง</strong> ระบบรองรับทั้งมือถือและคอมพิวเตอร์ ลองเปิดหมวดเดียวกันจากทั้งสองเครื่องดูก่อน แล้วเลือกอุปกรณ์ที่ใช้งานถนัดกว่า
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e8b33a]">🎁</span>
          <span>
            <strong class="text-[#ec2b84]">เงื่อนไขของโปรโมชั่นที่จะกดรับ</strong> ทั้งโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% มีรอบรับสิทธิ์และข้อกำหนดต่างกัน ควรเปิดดูรายละเอียดของแต่ละรายการก่อนกดรับ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e8b33a]">💡</span>
          <span><strong class="text-[#ec2b84]">งบที่คุณรับความเสี่ยงได้</strong> ตั้งวงเงินต่อรอบไว้ล่วงหน้า แล้วดูว่าระดับไหนทำให้เล่นได้โดยไม่กระทบค่าใช้จ่ายอื่น</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#fce9f3]">
        <strong class="text-[#ec2b84]">ผลของเกมเดิมพันทุกประเภทตัดสินจากระบบของเกมนั้น ไม่มีสูตร ไม่มีเกมใด และไม่มีช่วงเวลาไหนที่รับประกันว่าจะชนะ</strong>
        ข้อมูลที่เก็บได้จากการเปิดดูระบบช่วยให้เลือกหมวดและระดับเดิมพันที่เหมาะกับตัวเองเท่านั้น ไม่ได้ชี้ผลของรอบถัดไป จึงควรกำหนดงบล่วงหน้าและหยุดเมื่อถึงขีดที่ตั้งไว้เสมอ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="สมัคร WY88 ได้เองใน 3 ขั้นตอน แล้วเข้าเล่นเกมสดได้ทันที" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#fce9f3]">
        เมื่อคุ้นเคยกับระบบแล้วและอยากลงสนามจริง <strong class="text-[#ec2b84]">สมัครผ่านหน้าเว็บไซต์ได้ด้วยตัวเอง ใช้ขั้นตอนไม่ซับซ้อน</strong>
        เริ่มจากกรอกข้อมูลที่ระบบกำหนดในหน้าสมัคร ตรวจสอบข้อมูลและรายละเอียดบัญชีให้ถูกต้องก่อนกดยืนยัน แล้วเข้าสู่ระบบเพื่อเลือกสล็อต เกมสด หรือหมวดที่ต้องการได้ทันที
      </p>

      <p class="text-left text-base leading-relaxed text-[#fce9f3]">
        หลังเข้าสู่ระบบแล้วจะ<strong class="text-[#ec2b84]">เลือกเกมสดและหมวดเกมที่สนใจได้จากบัญชีเดียว</strong>
