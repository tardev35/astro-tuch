---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { pageGraph } from "../lib/schema";

// UVO88 เป็นเว็บพนันออนไลน์ที่รวมหลายหมวดเกมไว้ในบัญชีเดียว — บาคาร่า เกมไพ่ สล็อตออนไลน์
// หวย และฟุตบอล ไม่ใช่เว็บสล็อตอย่างเดียว หน้านี้จึงหมายถึงการทำความรู้จักระบบก่อนเดิมพัน
// ด้วยเครดิตจริง: สมัครเองได้ตามขั้นตอนที่ระบบกำหนด การเลือกหมวดเกม การตรวจกติกา
// อัตราจ่าย ช่วงเดิมพัน และวงเงินของแต่ละเกม โปรโมชั่นที่ตรวจสอบสิทธิ์ได้หลัง Login
// และการดูประวัติรายการในบัญชีสมาชิก
//
// แบรนด์เก่าเคยวางแกลเลอรี 12 การ์ด (gamedemo7..18.webp) ไว้ที่หน้านี้ ถูกถอดออกไปตั้งแต่
// สิบรอบรีแบรนด์ก่อน และไม่มีการ import แล้ว — อย่านำกลับมา ลำพังการ import ก็ทำให้ไฟล์ถูก
// emit ลง dist/ และ verify-build จะแดงถ้ามีรูปที่ไม่มีใคร render ทั้งชุด
//
// ทุกข้อความอ้างอิงบรีฟของแบรนด์นี้เท่านั้น: หลายหมวดเกมผ่านบัญชีเดียว ·
// รองรับมือถือ แท็บเล็ต คอมพิวเตอร์ · ต้องตรวจกติกา อัตราจ่าย ช่วงเดิมพัน และวงเงินก่อนเดิมพัน ·
// โบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามรอบและเงื่อนไขที่กำหนด ·
// ฝากถอนผ่านช่องทางที่ระบบเปิดรองรับ ยึดตัวเลขที่ระบบแสดง ณ เวลาทำรายการ ·
// แอดมินช่วยเหลือ 24 ชั่วโมง
// ไม่มีการอ้างใบอนุญาต การจดทะเบียน ปีที่ก่อตั้ง จำนวนสมาชิก การันตีผลกำไร
// หรือชื่อค่ายเกมรายใดที่บรีฟไม่ได้ระบุ
//
// Announcement รอบนี้หมุนมาใช้ AnnouncementPremium ทั้งเว็บ — default message ของไฟล์นั้น
// เป็นข้อความของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ได้
//
// คำเตือนทุกจุดใช้สีทองอ่อน #ffd76a โดยตั้งใจ ไม่ใช่เขียวแบรนด์
// ส่วน #f2c230 คือทองจากโลโก้และเหรียญบนอาร์ตเวิร์ก ใช้เป็น accent รองคู่กับเขียวมรกต #0f9d47
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 158
const pageDescription =
  "หน้าทดลองเล่น UVO88 แนะนำวิธีเริ่มใช้งานตั้งแต่สมัครสมาชิก ฝากเครดิต เลือกหมวดเกมบาคาร่า ไพ่ สล็อต หวย บอล จนถึงตรวจกติกา อัตราจ่าย และช่วงเดิมพันก่อนเล่นจริง";

const graph = pageGraph(Astro, {
  name: "ทดลองเล่น UVO88 ทำความรู้จักระบบก่อนเดิมพันด้วยเครดิตจริง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title="ทดลองเล่น UVO88 ลองใช้ระบบก่อนเดิมพัน บาคาร่า ไพ่ สล็อต หวย บอล" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่น UVO88 ทำความรู้จักระบบก่อนเดิมพันด้วยเครดิตจริง" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#c8e3d0]">
        <strong class="text-[#f3fbf5]">UVO88</strong> รวมเกมเดิมพันออนไลน์หลายประเภทไว้ในบัญชีเดียว ทั้งบาคาร่า เกมไพ่ในหมวดคาสิโน
        สล็อตออนไลน์จากหลายค่าย หวยออนไลน์ตามรอบที่เปิดรับ และการเดิมพันฟุตบอลตามรายการแข่งขัน
        รองรับการใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ หน้านี้จึงเปิดไว้ให้ผู้เริ่มต้นได้
        <strong class="text-[#f3fbf5]">ทำความคุ้นเคยกับขั้นตอนใช้งาน และตรวจกติกา อัตราจ่าย ช่วงเดิมพัน กับวงเงินของแต่ละเกม</strong>
        ก่อนเดิมพันด้วยเครดิตของตัวเอง เพราะรายละเอียดเหล่านี้ต่างกันไปตามผู้ให้บริการและประเภทการเดิมพันที่เลือก
      </p>

      <p class="text-left text-base leading-relaxed text-[#c8e3d0]">
        ขอให้เข้าใจตรงกันว่าการทดลองเล่นเป็นการทำความคุ้นเคยกับระบบเท่านั้น
        <strong class="text-[#ffd76a]">ผลลัพธ์ของเกมไม่สามารถรับประกันกำไรหรือผลชนะได้ทุกครั้ง</strong>
        ควรเลือกเกมจากกติกา รูปแบบการเดิมพัน และงบประมาณที่เหมาะสมกับตนเอง หากติดปัญหาระหว่างใช้งาน แจ้งแอดมิน UVO88 ได้ตลอด 24 ชั่วโมง
        พร้อมชื่อเกม เวลา จำนวนเงิน และรายละเอียดของรายการ เพื่อให้ตรวจสอบได้ตรงจุด
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="สมัคร UVO88 ด้วยตัวเอง แล้วเริ่มใช้งานได้ 3 ขั้นตอน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#c8e3d0]">
        ผู้ใช้งานใหม่สมัคร UVO88 ผ่านระบบออนไลน์ได้ด้วยตัวเอง ทำผ่านมือถือ แท็บเล็ต หรือคอมพิวเตอร์ก็ได้
        และสลับหมวดเกมผ่านบัญชีเดียวได้โดยไม่ต้องสมัครหลายบัญชี เริ่มต้นใช้งานได้เพียง
        <strong class="text-[#f3fbf5]">3 ขั้นตอน</strong> และเป็นลำดับเดียวกันไม่ว่าจะเลือกเล่นหมวดไหน
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#c8e3d0]">
        <li class="flex gap-3"><span class="font-bold text-[#0f9d47]">1.</span> เข้าหน้าสมัคร UVO88 แล้วกรอกข้อมูลตามที่เว็บไซต์กำหนดสำหรับเปิดบัญชี</li>
        <li class="flex gap-3"><span class="font-bold text-[#0f9d47]">2.</span> Login เข้าบัญชี แล้วเลือกช่องทางฝากเครดิตจากช่องทางที่ระบบเปิดรองรับ</li>
        <li class="flex gap-3"><span class="font-bold text-[#0f9d47]">3.</span> ตรวจสอบโปรโมชั่น เลือกหมวดเกมที่สนใจ แล้วอ่านกติกากับช่วงเดิมพันก่อนเริ่มเล่น</li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#c8e3d0]">
        หลังเปิดบัญชีเรียบร้อยสามารถตรวจสอบเครดิต ประวัติฝากถอน โปรโมชั่น และรายการใช้งานผ่านหน้าเว็บไซต์ได้โดยตรง
        ควรไล่ดูให้ครบก่อนใช้เครดิตจริง จะช่วยให้เห็นว่ารายการหนึ่งถูกบันทึกและคิดผลมาจากอะไรบ้าง
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ตรวจกติกา อัตราจ่าย ช่วงเดิมพัน และวงเงินของแต่ละเกมก่อนยืนยัน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#c8e3d0]">
        ข้อมูลที่ควรเปิดดูให้ครบก่อนลงเดิมพันมีอยู่ไม่กี่อย่าง และระบบแสดงไว้ในหน้าเกมให้ตรวจสอบได้อยู่แล้ว
        <strong class="text-[#f3fbf5]">ข้อมูลชุดนี้คือสิ่งที่กำหนดว่ารอบหนึ่งคิดผลอย่างไร</strong> จึงควรอ่านให้จบก่อนตัดสินใจว่าจะลงเท่าไร
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#c8e3d0]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#0f9d47]">🃏</span>
          <span><strong class="text-[#f3fbf5]">กติกาของบาคาร่าและเกมไพ่</strong> แต่ละโต๊ะระบุรูปแบบการเดิมพันและวิธีนับผลไว้ในหน้าเกม ควรอ่านก่อนเลือกโต๊ะ</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f2c230]">🎰</span>
          <span><strong class="text-[#f2c230]">อัตราจ่ายและรอบพิเศษของสล็อตออนไลน์</strong> หน้าอธิบายในตัวเกมบอกไว้ว่าสัญลักษณ์ชุดใดนับเป็นรางวัลและรอบพิเศษเปิดเมื่อใด</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#0f9d47]">🎫</span>
          <span><strong class="text-[#f3fbf5]">รอบที่เปิดรับของหวยออนไลน์</strong> ตรวจรอบที่ยังเปิดรับและรายละเอียดของรายการนั้นก่อนยืนยันทุกครั้ง</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f2c230]">⚽</span>
          <span><strong class="text-[#f2c230]">รายการแข่งขันของการเดิมพันฟุตบอล</strong> รายการที่เปิดรับและตัวเลขที่แสดงเปลี่ยนแปลงได้ตามตารางแข่งในแต่ละช่วง</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#c8e3d0]">
        หมวดเกมและรายการที่พร้อมใช้งานเปลี่ยนแปลงได้ ควรตรวจสอบรายการล่าสุดจากหน้าเลือกเกมในเว็บก่อนเข้าเล่น
        <strong class="text-[#ffd76a]">ส่วนเงื่อนไข “ไม่มีขั้นต่ำ” ขึ้นอยู่กับช่วงเดิมพันที่แต่ละเกมกำหนด บางเกมอาจเปิดให้เริ่มด้วยยอดต่ำ ขณะที่บางเกมอาจมีขั้นต่ำแตกต่างกัน จึงควรตรวจสอบตัวเลขเดิมพันที่แสดงในเกมก่อนยืนยันทุกครั้ง</strong>
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ฝากถอน ตรวจสอบโปรโมชั่น และดูแลความปลอดภัยของบัญชี" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#c8e3d0]">
        สมาชิกเติมเครดิตได้เองผ่านช่องทางฝากเงินที่ระบบเปิดรองรับ
        <strong class="text-[#f3fbf5]">ทำรายการฝาก ส่งคำขอถอน และตรวจสอบสถานะรายการผ่านบัญชีของตนเองได้โดยตรง</strong>
        ช่วยลดขั้นตอนและไม่จำเป็นต้องแจ้งรายการกับเจ้าหน้าที่ทุกครั้ง หากต้องการทำรายการจำนวนมาก
        ควรตรวจสอบยอดขั้นต่ำและสูงสุดของช่องทางที่เลือกก่อนยืนยัน เนื่องจากข้อกำหนดอาจแตกต่างกันตามช่องทางฝากถอน
      </p>

      <ul class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#c8e3d0]">
        <li class="flex gap-3">
          <span class="text-[#0f9d47]" aria-hidden="true">•</span> โปรโมชั่นแนะนำเพื่อน รับโบนัส 0.8% ใช้ลิงก์แนะนำส่วนตัวชวนเพื่อนสมัคร เมื่อบัญชีที่แนะนำมียอดใช้งานตรงตามข้อกำหนด ระบบจะนำยอดที่เข้าเงื่อนไขมาคำนวณ ตรวจสอบจำนวนเพื่อน ยอดคำนวณ และโบนัสที่มีสิทธิ์รับได้หลัง Login
        </li>
        <li class="flex gap-3">
          <span class="text-[#f2c230]" aria-hidden="true">•</span> โปรโมชั่นคืนยอดเสีย รับโบนัส 0.3% สำหรับสมาชิกที่มียอดเสียตรงตามเงื่อนไข ตามรอบที่ UVO88 กำหนด ระบบจะแสดงยอดที่เข้าเกณฑ์และจำนวนโบนัสที่กดรับได้จากบัญชีสมาชิก จึงควรอ่านวิธีคำนวณและเงื่อนไขการถอนก่อนกดรับ
        </li>
        <li class="flex gap-3">
          <span class="text-[#0f9d47]" aria-hidden="true">•</span> หากเครดิตไม่เข้า รายการถอนค้าง หรือสถานะรายการไม่อัปเดต ให้ตรวจสอบประวัติรายการในบัญชีก่อน และเก็บหลักฐานรายการไว้จนกว่าการตรวจสอบจะเสร็จสิ้น
        </li>
        <li class="flex gap-3">
          <span class="text-[#f2c230]" aria-hidden="true">•</span>
          <strong class="text-[#ffd76a]">ตั้งรหัสผ่านที่คาดเดายาก ไม่ใช้รหัสเดียวกับบริการอื่น และไม่เปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น</strong> รวมถึงตรวจสอบให้แน่ใจว่าเป็นบัญชี LINE OFFICIAL ที่ประกาศไว้บนเว็บไซต์ก่อนส่งข้อมูลใด ๆ
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#c8e3d0]">
        หากพบปัญหาเกี่ยวกับการสมัครสมาชิก Login ไม่ได้ ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง เข้าเกมไม่ได้ หรือโปรโมชั่นไม่แสดง ติดต่อแอดมิน UVO88 ได้ตลอด 24 ชั่วโมง โดยแจ้งรายละเอียดของปัญหา เวลา จำนวนเงิน
        และข้อมูลรายการที่เกี่ยวข้อง <strong class="text-[#ffd76a]">การเดิมพันมีความเสี่ยง ควรกำหนดงบประมาณให้เหมาะสมทุกครั้ง</strong>
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก UVO88"
          class="flex items-center justify-center rounded-lg border border-[#116330]/70 bg-gradient-to-r from-[#57dd8f] via-[#0f9d47] to-[#116330] px-8 py-3 font-black text-[#03110a] shadow-[0_0_15px_rgba(15,157,71,0.30)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ UVO88"
          class="flex items-center justify-center rounded-lg border border-[#f2c230]/45 bg-transparent px-8 py-3 font-bold text-[#f2c230] transition-all hover:scale-105 hover:border-[#f2c230] hover:bg-[#0a3b1c]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>

  <Navfoot />
</MainLayout>
