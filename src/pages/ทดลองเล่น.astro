---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";

import { Picture } from "astro:assets";
import { itemList, pageGraph, schemaCtx } from "../lib/schema";
import image1 from "../assets/gamedemo7.webp";
import image2 from "../assets/gamedemo8.webp";
import image3 from "../assets/gamedemo9.webp";
import image4 from "../assets/gamedemo10.webp";
import image5 from "../assets/gamedemo11.webp";
import image6 from "../assets/gamedemo12.webp";
import image7 from "../assets/gamedemo13.webp";
import image8 from "../assets/gamedemo14.webp";
import image9 from "../assets/gamedemo15.webp";
import image10 from "../assets/gamedemo16.webp";
import image11 from "../assets/gamedemo17.webp";
import image12 from "../assets/gamedemo18.webp";

// One list, two consumers: the gallery below and the ItemList in the JSON-LD.
// They used to be two hand-kept arrays that had to stay in the same order, and
// the name shown to a reader could drift from the name handed to a crawler.
const demoGames = [
  { name: "AskmeSlot", src: image1, alt: "แบนเนอร์ค่ายเกม askmeslot โลโก้โพดำสีเหลือง ตัวการ์ตูนเด็กชายสวมหมวกแดงกางแขน ฉากหลังเป็นถนนเมืองยุโรปและกังหันลม" },
  { name: "Popular Game", src: image2, alt: "แบนเนอร์ Popular Game ตัวอักษรสีทอง ตัวการ์ตูนกระต่ายกับแมวสวมแว่นกันแดด หีบสมบัติ ชิปและเหรียญทองกระจายรอบภาพ" },
  { name: "SlotXO", src: image3, alt: "แบนเนอร์ค่ายเกม SlotXO โลโก้รูปตู้สล็อตพร้อมเหรียญ ฉากหลังเป็นนักรบโรมันสวมชุดเกราะยืนหน้าโคลอสเซียม" },
  { name: "Skywind Group", src: image4, alt: "แบนเนอร์ค่ายเกม Skywind Group โลโก้วงกลมสี่สี ฉากหลังเป็นแมวกวักญี่ปุ่นสีขาว ถุงทอง และดอกซากุระ" },
  { name: "PG Soft", src: image5, alt: "แบนเนอร์ค่ายเกม PG Pocket Games Soft โลโก้ตัวอักษรพิกเซลหลากสี ฉากหลังเป็นหญิงสาวสวมเครื่องประดับทองและหมวกขนนก" },
  { name: "SBOBET", src: image6, alt: "แบนเนอร์ค่ายเกม SBOBET โลโก้สีขาวบนพื้นดำ ฉากหลังเป็นตัวการ์ตูนหญิงสาวผมบลอนด์ชุดสีชมพูถืออมยิ้ม" },
  { name: "Sexy Slot", src: image7, alt: "แบนเนอร์เกม Sexy Slot ตัวอักษรสีชมพูม่วง ฉากหลังเป็นตัวการ์ตูนหญิงสาวชุดสีน้ำเงินนั่งอยู่ในกรอบวงกลมพร้อมรูปหัวใจ" },
  { name: "JILI", src: image8, alt: "แบนเนอร์ค่ายเกม JILI ตัวอักษรสีทอง ฉากหลังเป็นตัวการ์ตูนนางเงือกผมสีแดงถือหอยสังข์อยู่ใต้ท้องทะเล" },
  { name: "Ask Me Bet", src: image9, alt: "แบนเนอร์ค่ายเกม ask me bet โลโก้สีเขียวเหลือง ฉากหลังเป็นหัวสิงโตเชิดสีแดงทองและโคมไฟจีน" },
  { name: "New Game", src: image10, alt: "แบนเนอร์ New Game ตัวอักษรสีขาวสามมิติ ตัวการ์ตูนฟักทองสวมหมวกและโครงกระดูกยืนสองข้าง พร้อมอัญมณีและชิปหลากสี" },
  { name: "JOKER", src: image11, alt: "แบนเนอร์ค่ายเกม JOKER ตัวอักษรสีขาวทอง ฉากหลังเป็นนักรบโรมันสวมหมวกเกราะยืนคู่กับสิงโตในสนามประลอง" },
  { name: "AFB Gaming", src: image12, alt: "แบนเนอร์ค่ายเกม AFB Gaming ตัวอักษรสีทอง ฉากหลังเป็นเทพเจ้าเคราขาวสวมมงกุฎใบไม้ยืนอยู่หน้าวิหารกรีก" },
];

// The URL each entry resolves to is schema.ts's problem, not this file's — an
// older version pasted a hand-built page URL onto all 12 and got the trailing
// slash and the Thai encoding wrong on every one of them.
const gameList = demoGames.map((game) => ({ name: game.name, imagePath: game.src.src }));

const pageDescription = "ทดลองเล่นเกมกับ 7LOTTO เปิดดูหน้าเกมจากค่ายชั้นนำและลองใช้ระบบบนมือถือก่อนสมัครสมาชิก ฝากเครดิต และส่งโพยหวยจริง พร้อมอ่านกติกาของแต่ละเกมให้ครบก่อนเดิมพัน";

const ctx = schemaCtx(Astro);
const graph = pageGraph(Astro, {
  type: "CollectionPage",
  name: "ทดลองเล่นเกม 7LOTTO ลองระบบก่อนสมัครและส่งโพย",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
  extra: [
    itemList(ctx, {
      name: "รายการค่ายเกมที่เปิดให้ทดลองเล่นบน 7LOTTO",
      alternateName: "7LOTTO โหมดทดลองเล่นเกมจากค่ายชั้นนำบนมือถือ ก่อนสมัครสมาชิกและส่งโพยหวยด้วยเครดิตจริง",
      itemType: "Game",
      items: gameList,
    }),
  ],
});
---

<MainLayout title="ทดลองเล่น 7LOTTO ลองระบบเว็บหวยและเกมค่ายชั้นนำก่อนสมัคร" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่นเกม 7LOTTO ลองระบบก่อนสมัครและส่งโพย" as="h1">
    <div>
      <h2 class="mb-4 bg-gradient-to-r from-[#ff2a30] via-[#ff6b70] to-[#d3d6db] bg-clip-text text-2xl leading-normal font-bold text-transparent">วิธีเข้าทดลองเล่นกับ 7LOTTO</h2>

      <ol class="mb-8 flex flex-col gap-2 text-left text-base leading-relaxed text-[#d8dae0]">
        <li class="flex gap-3"><span class="font-bold text-[#ff2a30]">1.</span> สมัครสมาชิก 7LOTTO และกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน</li>
        <li class="flex gap-3"><span class="font-bold text-[#ff2a30]">2.</span> เลือกค่ายเกมที่ต้องการจากรายการด้านล่าง</li>
        <li class="flex gap-3"><span class="font-bold text-[#ff2a30]">3.</span> กดปุ่ม "เล่นเลย" เพื่อเปิดหน้าเกมและเริ่มทดลองเล่นทันที</li>
      </ol>

      <div class="mb-5 grid grid-cols-2 gap-5 sm:grid-cols-2 md:grid-cols-4">
        {
          demoGames.map((game) => (
            <div class="group/game relative mx-auto w-full max-w-[400px] overflow-hidden rounded-xl">
              <Picture
                src={game.src}
                alt={game.alt}
                loading="lazy"
                fetchpriority="low"
                widths={[200, 400, 600]}
                sizes="(max-width: 768px) 100vw, 25vw"
                class="block h-auto w-full object-cover shadow-[0_10px_30px_rgba(255,42,48,0.18)] transition-transform duration-300 group-hover/game:scale-105"
                decoding="async"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                quality={60}
              />
              <a
                href="/register"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`สมัครสมาชิกเพื่อเล่น ${game.name} ที่ 7LOTTO`}
                class="absolute inset-0 flex items-center justify-center bg-[#0d0304]/80 opacity-0 transition-opacity duration-300 group-hover/game:opacity-100 focus-visible:opacity-100">
                <span class="rounded-full border border-[#5c0203]/70 bg-gradient-to-r from-[#ff6b70] via-[#ff2a30] to-[#a3060c] px-6 py-2 font-bold text-[#1a0405] shadow-[0_10px_30px_rgba(255,42,48,0.30)] transition-transform hover:scale-110">
                  เล่นเลย
                </span>
              </a>
            </div>
          ))
        }
      </div>

      <h2 class="mt-8 mb-4 bg-gradient-to-r from-[#ff2a30] via-[#ff6b70] to-[#d3d6db] bg-clip-text text-2xl leading-normal font-bold text-transparent">เงื่อนไขก่อนเริ่มเล่นจริง</h2>

      <ul class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#d8dae0]">
        <li class="flex gap-3"><span class="text-[#ff2a30]" aria-hidden="true">•</span> โหมดทดลองใช้เครดิตทดลอง ไม่ใช่เงินจริง และถอนไม่ได้</li>
        <li class="flex gap-3"><span class="text-[#ff2a30]" aria-hidden="true">•</span> ควรอ่านกติกาและเงื่อนไขของแต่ละเกมให้ครบก่อนเดิมพันด้วยเครดิตจริง</li>
        <li class="flex gap-3">
          <span class="text-[#ff2a30]" aria-hidden="true">•</span> หากต้องการแทงหวย ให้เข้าเมนูหวยในบัญชีสมาชิก เลือกประเภทและรอบที่เปิดรับ ใส่เลขและจำนวนเงิน ตรวจสอบโพย แล้วจึงกดยืนยันรายการ
        </li>
        <li class="flex gap-3"><span class="text-[#ff2a30]" aria-hidden="true">•</span> เข้าใช้งานผ่านทางเข้าจริงของ 7LOTTO ที่เชื่อมต่อ HTTPS เท่านั้น</li>
      </ul>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
