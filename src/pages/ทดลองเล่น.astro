---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login, /register)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อของ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริง
// ของ UWIN33 เท่านั้น
//
// รอบก่อน (MAHAGAME66) บรีฟมีหมวด "เกมไลฟ์สด" และ "ฝากถอนผ่านวอลเลทและธนาคาร"
// ซึ่งบรีฟของ UWIN33 ไม่ได้ระบุไว้เลย — ทั้งสองเรื่องจึงถูกตัดออกทั้งหน้า ห้าม
// find-and-replace ชื่อแบรนด์ทับของเดิม มันจะทำให้ UWIN33 อ้างหมวดเกมและช่องทาง
// ธุรกรรมที่บรีฟไม่เคยระบุ ด้วยเหตุผลเดียวกันคำว่า "โต๊ะ" ก็ไม่มีในบรีฟรอบนี้
//
// บรีฟไม่ได้ระบุว่ามี "เครดิตทดลอง" หรือโหมดเดโมที่ถอนไม่ได้ สิ่งที่บรีฟระบุคือ
// "เมนูแบ่งหมวดชัดเจน" "รองรับมือถือและคอมพิวเตอร์" และ "เลือกดูเกมตามประเภท
// ตรวจสอบรายละเอียด และสลับไปยังหมวดที่สนใจ" — หน้านี้จึงเขียนบนฐานนั้น คือการ
// ไล่ดูหมวดเกมและรายละเอียดให้ครบก่อนเดิมพันด้วยเงินจริง ห้ามอ้างกติกาของเครดิต
// ทดลองหรือโหมดเล่นฟรี
//
// ข้อเท็จจริงทุกบรรทัดมาจาก brand-spec §4 เท่านั้น: บาคาร่า · รูเล็ต · ไฮโล · สล็อต ·
// บอล · หวย · รวมครบในระบบเดียว ใช้บัญชีเดียว · เมนูแบ่งหมวดชัดเจนและอ่านชัด ·
// รองรับมือถือและคอมพิวเตอร์ · เลือกดูเกมตามประเภท ตรวจสอบรายละเอียด สลับหมวดได้ง่าย ·
// ไม่ต้องสลับใช้งานหลายเว็บไซต์ · รายการจากหลายค่ายตามหมวดที่เว็บไซต์เปิดให้บริการ ·
// ตรวจสอบเกมและรายละเอียดที่เกี่ยวข้องได้จากหน้ารวมเกมก่อนเข้าใช้งาน · โบนัสแนะนำ
// เพื่อน 0.8% · โบนัสคืนยอดเสีย 0.3% · ตรวจสอบยอดที่เข้าเงื่อนไข รอบคำนวณ และวิธี
// รับสิทธิ์จากหน้าโปรโมชั่นก่อนกดรับ · สมัครเองได้ใน 3 ขั้นตอน · LINE OFFICIAL 24 ชั่วโมง
// — ห้ามอ้างชื่อค่ายเกม ชื่อเกมเฉพาะ เลขใบอนุญาต ปีที่ก่อตั้ง จำนวนสมาชิก ค่า RTP
// ขั้นต่ำการเดิมพัน ชื่อธนาคารเจาะจง "ฝากถอนไม่มีขั้นต่ำ" "ออโต้ 10 วินาที" หรือ
// การันตีว่าจะชนะ
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: แกลเลอรีเดโม 12 การ์ด (gamedemo7..18.webp) ยังอยู่
// บนดิสก์แต่เป็นของแบรนด์อื่น (mtime 2026-08-04 ไม่ใช่ดรอปรอบนี้) — gamedemo7.webp
// มีโลโก้ "askmeslot" และ gamedemo15.webp มีโลโก้ "askmebet" ของเว็บเจ้าอื่น
// พิมพ์ทับอยู่ในรูป ส่วน gamedemo13.webp เป็นการ์ด "Sexy Slot" ภาพโป๊เปลือย
// ห้ามนำกลับมา import เด็ดขาด (ห้ามลบไฟล์ เป็นอินเวนทอรี) ลำพังการ import ก็ทำให้
// ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง
// slide1.png / slide2.png ของดรอปนี้เป็นของ index และ /promotion — ไม่ดึงมาใช้ซ้ำที่นี่
// banner1/banner1-mobile เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า และ
// banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กค้างของลูกค้าเจ้าอื่น ห้าม import
//
// Announcement รอบนี้หมุนจาก Announcement5 มาเป็น AnnouncementPremium ทั้งเว็บ —
// default message ของไฟล์นั้นถูกตั้งเป็นคอปปี้ของ UWIN33 แล้ว จึงเรียกแบบ bare
// เหมือน index.astro ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ UWIN33 (ทอง + โครเมียม + ดำ): พื้น #080602 · การ์ด #161106 ·
// การ์ดยก #26200e · ทองแบรนด์ #e0b429 · ทองสว่าง #fbd564 · ทองอ่อน #fde9a3 ·
// บรอนซ์ลึก #7a5407 · เงินโครเมียม #dfe4ec · เนื้อความ #ece6d8 (BRAND_TEXT) ·
// เน้นใน strong #fff8e6 — ชุดแดง-เงินของ MAHAGAME66 (#de161d #ff4d52 #7a0a0e
// #5e0507 #e2e8ef #9ba3ad #16090a #26100f #3a1413 #080506 #e8e3e1 #fff6f5)
// ออกครบทุกจุดแล้ว ห้ามนำกลับมา
// ตัวหนังสือที่วางบนพื้นทองต้องเป็นสีเกือบดำ #161106 เสมอ ห้ามใช้ขาว
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลางที่ orchestrator รีธีมรอบนี้) — การ์ดตั้ง
// สีเนื้อความไว้ให้แล้ว ย้ำไว้บนย่อหน้าอีกชั้นเพื่อให้สีของ body copy อ่านออกจาก
// ตัวหน้าเอง และเน้นด้วย #fff8e6 ในคำสำคัญ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 152
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "ทดลองเล่น UWIN33 ไล่ดูหมวดบาคาร่า รูเล็ต ไฮโล สล็อต บอล และหวย พร้อมตรวจสอบรายละเอียดของแต่ละหมวดจากบัญชีเดียวให้ครบก่อนตัดสินใจเริ่มเดิมพันด้วยเงินจริง";

const pageTitle = "ทดลองเล่น UWIN33 ไล่ดูหมวดเกมและรายละเอียดก่อนเดิมพันจริง";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ece6d8]">
        <strong class="text-[#fff8e6]">UWIN33</strong> รวมเกมเดิมพันหลายประเภทไว้ในระบบเดียว ทั้งบาคาร่า รูเล็ต ไฮโล สล็อต บอล และหวย ตามหมวดที่เว็บไซต์เปิดให้บริการ หน้านี้จึงเปิดไว้ให้คนที่ยังไม่คุ้นกับระบบได้
        <strong class="text-[#fff8e6]">ไล่ดูหมวดเกม รายการที่เปิดอยู่ และรายละเอียดของแต่ละเกมให้ครบก่อนเดิมพันด้วยเงินจริง</strong>
        ตั้งแต่โครงของเมนูหน้าแรก ไปจนถึงข้อมูลที่ระบบแสดงไว้ในหน้ารวมเกม
      </p>

      <p class="text-left text-base leading-relaxed text-[#ece6d8]">
        เพราะ<strong class="text-[#fff8e6]">เมนูถูกแบ่งหมวดไว้ชัดเจน อ่านง่าย และรองรับการใช้งานทั้งบนมือถือและคอมพิวเตอร์</strong>
        การเปิดดูให้ทั่วก่อนจึงช่วยให้เห็นว่าเกมแต่ละประเภทอยู่ตรงไหน สลับไปหมวดที่สนใจได้จากจุดใด และรู้ล่วงหน้าว่าต้องตรวจข้อมูลอะไรบ้างก่อนกดเข้าเล่นครั้งแรกจากบัญชีเดียว
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ไล่ดูหมวดเกมของ UWIN33 ให้ครบก่อนเลือกเกมแรก" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ece6d8]">
        จุดที่ช่วยให้เริ่มต้นได้เร็วที่สุดคือ<strong class="text-[#fff8e6]">ทุกประเภทเกมถูกรวมไว้ในบัญชีเดียว</strong>
        สมาชิกเลือกหมวดที่สนใจได้จากเมนูหน้าแรก ดูรายการที่เปิดให้บริการอยู่ แล้วเปิดรายละเอียดของเกมนั้นต่อได้ทันที ไม่ต้องสลับไปใช้งานหลายเว็บไซต์เพื่อไล่หาว่าเกมที่อยากเล่นอยู่ที่ไหน
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#ece6d8]">
        <li class="flex gap-3">
          <span class="font-bold text-[#e0b429]">1.</span>
          <span><strong class="text-[#fff8e6]">เปิดหน้าแรกของ UWIN33 ก่อน</strong> เมนูแบ่งหมวดไว้ให้เลือกจากหน้าเดียว จึงเห็นภาพรวมของรายการที่เปิดให้เลือกได้ตั้งแต่หน้าแรก</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#e0b429]">2.</span>
          <span>
            <strong class="text-[#fff8e6]">ไล่ดูหมวดหลักให้ครบทั้งหกประเภท</strong> ทั้งบาคาร่า รูเล็ต ไฮโล สล็อต บอล และหวย แต่ละหมวดมีรูปแบบการเล่นและรายละเอียดของตัวเองตามที่ระบบแสดงไว้
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#e0b429]">3.</span>
          <span>
            <strong class="text-[#fff8e6]">เปิดหน้ารวมเกมดูรายการที่เปิดอยู่จริง</strong> ในแต่ละหมวดมีรายการจากหลายค่ายตามที่เว็บไซต์เปิดให้บริการ จึงควรเปิดดูไว้ก่อนสักรอบว่ามีอะไรให้เลือกบ้าง
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#e0b429]">4.</span>
          <span>
            <strong class="text-[#fff8e6]">ตรวจสอบเกมและรายละเอียดที่เกี่ยวข้องก่อนเข้าใช้งาน</strong> ข้อมูลชุดนี้ถูกแสดงไว้ให้ดูตั้งแต่ก่อนกดเข้าเกม อ่านให้จบก่อนตัดสินใจว่าจะเลือกรายการไหน
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#e0b429]">5.</span>
          <span>
            <strong class="text-[#fff8e6]">ลองเปิดจากเครื่องที่จะใช้จริงอีกครั้ง</strong> ระบบรองรับทั้งมือถือและคอมพิวเตอร์จากบัญชีเดียว เปิดรายการเดียวกันเทียบกันดูก่อน แล้วเลือกอุปกรณ์ที่ใช้งานได้ถนัดกว่า
          </span>
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#ece6d8]">
        <strong class="text-[#fff8e6]">รายการที่เปิดให้บริการและค่ายที่รองรับในแต่ละหมวดเปลี่ยนแปลงได้ตามช่วงเวลา จึงควรตรวจสอบหมวดเกมและรายละเอียดที่เกี่ยวข้องจากหน้ารวมเกมทุกครั้งก่อนเข้าใช้งาน</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title="จุดที่ควรตรวจให้ครบก่อนเดิมพันด้วยเงินจริง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ece6d8]">
        การไล่ดูระบบมีประโยชน์ที่สุดเมื่อมองมันเหมือนการอ่านคู่มือ ไม่ใช่การลุ้นรางวัล
        <strong class="text-[#fff8e6]">เป้าหมายคือรู้จักระบบให้ครบก่อนที่เงินจริงจะเข้ามาเกี่ยวข้อง</strong>
        หกเรื่องด้านล่างคือสิ่งที่ควรเก็บข้อมูลไว้ระหว่างเปิดดู
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#ece6d8]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fbd564]">🗂️</span>
          <span>
            <strong class="text-[#fff8e6]">โครงของเมนูและตำแหน่งของแต่ละหมวด</strong> จำให้ได้ว่าหมวดบาคาร่า รูเล็ต ไฮโล สล็อต บอล และหวยอยู่ตรงไหน และสลับระหว่างกันได้จากจุดใด จะได้ไม่ต้องหาใหม่ทุกครั้งที่อยากเปลี่ยนเกม
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fbd564]">🃏</span>
          <span>
            <strong class="text-[#fff8e6]">รายละเอียดของแต่ละรายการในหมวดที่สนใจ</strong> ระบบแสดงข้อมูลชุดนี้ไว้ก่อนเข้าใช้งาน เปิดอ่านเทียบกันหลายรายการดูก่อน จะได้เห็นว่ารูปแบบไหนตรงกับที่ตัวเองสนใจ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fbd564]">🎰</span>
          <span>
            <strong class="text-[#fff8e6]">รายการจากค่ายต่าง ๆ ที่เปิดอยู่ในรอบนั้น</strong> แต่ละหมวดรวมรายการจากหลายค่ายตามที่เว็บไซต์เปิดให้บริการ รายการจึงไม่เท่ากันทุกช่วงเวลา ควรเปิดตรวจสอบอีกครั้งก่อนเลือกเข้าเล่น
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fbd564]">🎁</span>
          <span>
            <strong class="text-[#fff8e6]">เงื่อนไขของโปรโมชั่นที่กำลังเปิดรับสิทธิ์</strong> ทั้งโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% หน้าโปรโมชั่นแสดงยอดที่เข้าเงื่อนไข รอบคำนวณ และวิธีรับสิทธิ์ไว้ให้ตรวจสอบก่อนกดรับทุกครั้ง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fbd564]">💬</span>
          <span>
            <strong class="text-[#fff8e6]">ช่องทางติดต่อเจ้าหน้าที่เมื่อติดปัญหา</strong> สอบถามเรื่องการสมัคร โปรโมชั่น ทางเข้าเกม หรือการใช้งานบัญชีผ่าน LINE OFFICIAL ได้ตลอด 24 ชั่วโมง ลองเปิดดูไว้ก่อนว่าเข้าถึงได้จากหน้าไหน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fbd564]">📱</span>
