---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import popularGamesImage from "../assets/gamedemo8.webp";
import newGamesImage from "../assets/gamedemo16.webp";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion,
// /login, /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์
// หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้า
// ขึ้นใหม่บนข้อเท็จจริงของบรีฟรอบนี้เท่านั้น (src/assets/content.txt)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// ดรอปนี้คือ **คาสิโนฐานเข้าหลัก** ที่รวมช่องทางเดิมพันหลายประเภทไว้ในระบบเดียว
// ไม่ใช่เว็บหวย (หวยเป็นเพียงหนึ่งหมวดที่บรีฟลิสต์ไว้) และไม่ใช่เว็บสล็อตเบทต่ำ
// แบบรอบก่อนๆ แง่มุมที่บรีฟระบุไว้มีเท่านี้: รวมบาคาร่า รูเล็ต บอล หวย สล็อต และ
// เกมคาสิโนตามรายการที่เปิดให้บริการ · บาคาร่าและรูเล็ตมีโต๊ะตามรายการที่เปิด ·
// สล็อตมีเกมคลาสสิก ฟรีสปิน โบนัส ตัวคูณ · บอลเลือกคู่แข่งขันและตลาดเดิมพันตาม
// ช่วงเวลา · หวยแบ่งรอบเปิดรับตามประเภท · เกมแต่ละประเภทมีกติกา ช่วงเดิมพัน และ
// เวลาเปิดรับต่างกัน · ควรตรวจสอบราคา วงเงิน เวลาเปิด-ปิด และรายละเอียดที่แสดงใน
// ระบบก่อนยืนยัน · Login ดูเครดิต โปรโมชั่น ยอดที่เข้าเกณฑ์ ประวัติการเดิมพันจาก
// บัญชีเดียว · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · แอดมิน 24 ชั่วโมง · PIN · OTP
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามี "โหมดทดลอง" เครดิตทดลอง หรือเดโมฟรีเป็นบริการของเว็บ —
// จึงห้ามสัญญาสินค้าตัวนั้น คำว่า "ทดลองเล่น" บนหน้านี้จึงหมายถึงสิ่งที่บรีฟระบุไว้
// ตรง ๆ ว่าทำได้: เลือกหมวดเกม เปิดดูโต๊ะและรายการที่เปิดให้บริการ และอ่านราคา
// วงเงิน เวลาเปิด-ปิด ที่ระบบแสดงก่อนยืนยัน = ไล่ดูระบบให้ครบหนึ่งรอบ
//
// ⚠️ รูปในหน้านี้ใช้ได้แค่ gamedemo8 กับ gamedemo16 เท่านั้น — เป็นอาร์ตสต็อกกลาง
// ของเทมเพลต ไม่ใช่อาร์ตเวิร์กของแบรนด์นี้ จึงอยู่ต่อได้ แต่ alt ต้องบรรยายภาพจริง
// และห้ามเอ่ยชื่อแบรนด์ใดทั้งของรอบนี้และรอบก่อน
// ส่วน gamedemo7/9/10/11/12/14/15/17/18 มีโลโก้หรือชื่อของผู้ให้บริการ/ค่ายเกม
// เจ้าอื่นพิมพ์ทับอยู่กลางรูป และ gamedemo13 เป็นภาพล่อแหลม — ห้ามนำกลับมาใช้
// เพราะเท่ากับอ้างชื่อค่ายเกมที่บรีฟไม่ได้เอ่ย (ขัด brand-spec §4 โดยตรง)
// ไฟล์ยังอยู่บนดิสก์ ห้ามลบ เป็นอินเวนทอรี
// gamedemo8 ("POPULAR GAME" 600x379) กับ gamedemo16 ("New Game" 650x411) ไม่มี
// ชื่อแบรนด์ใดปรากฏ ความกว้างที่วาดจริงสูงสุด ~600px ต่อใบ (กริดสองคอลัมน์ในการ์ด)
// จึงไม่ขยายเกินต้นฉบับ
//
// ⚠️ คำที่ห้ามหลงเหลือ: ศัพท์หมวดลอตเตอรีเชิงทำนาย (เป็นของอินเวนทอรี *Huay ที่
// จอดไว้) และคำขายของของแบรนด์ก่อนที่บรีฟรอบนี้ไม่ได้เอ่ย — รายการเต็มอยู่ใน
// brand-spec §4 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำต้องห้ามเจอ false positive
// สองหน้าของหมวดนั้นจอดอยู่ใน src/pages-disabled/ จึงไม่มีปลายทางให้ลิงก์รอบนี้
// หวยบนหน้านี้ปรากฏได้เฉพาะในฐานะ "หนึ่งหมวดเดิมพันที่มีรอบเปิดรับ" ตามที่บรีฟว่า
// ห้ามเขียนเป็นบริการทำนายผล
//
// ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 100% · 24 ชั่วโมง
// ห้ามเติมเลขใบอนุญาต หน่วยงานกำกับ ชื่อผู้ให้บริการ ชื่อค่ายเกม ชื่อธนาคาร
// ค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก จำนวนขั้นตอนการสมัคร หรือปีที่ก่อตั้ง
// เพราะบรีฟไม่ได้เอ่ยไว้
//
// ประโยคกำกับของบรีฟที่ห้ามตัดทิ้ง (เป็นส่วนหนึ่งของคอปปี้ ไม่ใช่ filler):
// ข้อความ "เดิมพันตรงกับบริษัท 100%" ควรมีชื่อบริษัทหรือนิติบุคคลที่ตรวจสอบได้ ·
// "ฝากถอนได้ทุกช่องทาง" ควรหมายถึงช่องทางที่ระบบรองรับจริงในขณะทำรายการ ·
// ควรเปรียบเทียบชื่อบัญชีปลายทางกับข้อมูลจากช่องทางหลักก่อนทำรายการ
//
// banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// slide1/slide2 ของดรอปนี้เป็นของ index และ /promotion · slide3/slide4/banner2/
// banner3 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import (ลำพังการ import ก็ทำให้ไฟล์ถูก
// emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น Announcement5 ทั้งเว็บ (รอบก่อน GUCCI168 ใช้
// Announcement3 — brand-spec §3 หมุนออก) orchestrator ตั้ง default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message
// มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็นแบรนด์ **ทองเมทัลลิกฮิวเดียวบนดำสนิท ไม่มีสี
// ที่สองเลย** — พลิกจากชุดตรุษจีนสามสี (แดงนำ เขียวมรกตรอง ทองคั่น) ของรอบก่อน
// ปลายลึกของทอง (บรอนซ์ #c9881f / ทองลึก #8a6410) จึงรับบทที่เขียวมรกตเคยเล่น
// ชุดเดิมออกครบทุกจุดแล้ว ทั้งคลาส Tailwind raw hex และ rgba() (ค่าเดิมอยู่ใน
// brand-spec §2 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive)
// ลำดับปุ่มสื่อด้วย "ถม vs โปร่ง" เพราะไม่มีฮิวที่สอง:
// ปุ่มหลักถมทองไล่ #ffe79a → #fad354 → #ddab33 ขอบทองลึก #8a6410 หมึกเข้ม #0a0802
// (13.5:1) · ปุ่มรองและปุ่มลิงก์ภายในเป็นผิวการ์ด #17130a → #060402 ขอบทองแบรนด์
// #fad354/55 หมึกทองแชมเปญ #ffe79a · ขอบรูปและ marker ของลำดับเลขใช้ทอง #fad354
// ⚠️ ห้ามกลับด้าน: พื้นถมทองต้องใช้หมึกเข้มเสมอ ห้ามครีมหรือขาว
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #f3e7cd)
// ไว้ที่ตัวการ์ดแล้ว ข้อความในหน้านี้จึงไม่ประกาศสีของตัวเองเลย ปล่อยให้สืบทอดลงมา
// — มีแค่ปุ่ม ขอบรูป และ marker ของลำดับเลขที่ประกาศสี เพราะเป็นพื้น/เส้น ไม่ใช่เนื้อความ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 155 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} ด้วยการไล่ดูระบบจริงให้ครบ ตั้งแต่เลือกหมวดเกมบาคาร่า รูเล็ต บอล หวย สล็อต ไปจนถึงตรวจราคา วงเงิน และเวลาเปิด-ปิด ก่อนยืนยันการเดิมพัน`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ไล่ดูหมวดเกมและรายละเอียดก่อนเริ่มเดิมพัน`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong>{BRAND_NAME}</strong> เป็นคาสิโนฐานเข้าหลักที่รวมช่องทางเดิมพันหลายประเภทไว้ในระบบเดียว
        <strong>รองรับทั้งบาคาร่า รูเล็ต บอล หวย สล็อต และเกมคาสิโนตามรายการที่เปิดให้บริการ</strong>
        หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับระบบได้ไล่ดูให้ครบหนึ่งรอบ ตั้งแต่การเลือกหมวดเกมและเปิดรายการที่ให้บริการอยู่ ไปจนถึงรายละเอียดที่ระบบแสดงไว้ ก่อนจะเริ่มเดิมพันด้วยเครดิตจริง
      </p>

      <p>
        คำว่า ทดลองเล่น ที่หน้านี้พูดถึงจึงหมายถึง
        <strong>การเปิดดูหมวดเกม สถานะของโต๊ะหรือรายการ ช่วงเดิมพัน และรายละเอียดของแต่ละรายการก่อนเริ่ม</strong>
        ซึ่งเป็นสิ่งที่ระบบเปิดให้ทำได้อยู่แล้ว ไม่ใช่เครดิตทดลอง ไม่ใช่การเดิมพันฟรี และไม่ใช่การรับประกันผลของเกมใดเกมหนึ่ง เมื่อ Login แล้วสมาชิกจะเปิดดูเครดิต โปรโมชั่น และประวัติการเดิมพันได้จากบัญชีเดียว
      </p>

      <p>
        <strong>เกมแต่ละประเภทมีกติกา ช่วงเดิมพัน และเวลาเปิดรับแตกต่างกัน โดยเฉพาะบอลและหวยที่อ้างอิงตามตารางของแต่ละรายการ</strong>
        การไล่ดูระบบจึงทำได้ตลอด แต่ก่อนยืนยันการเดิมพันควรตรวจสอบราคา วงเงิน เวลาเปิด-ปิด และรายละเอียดที่แสดงในระบบทุกครั้ง เพราะจำนวนโต๊ะและรายการที่เปิดรับเปลี่ยนแปลงได้ตามช่วงเวลา
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`หมวดเกมที่ ${BRAND_NAME} เปิดให้เลือก บาคาร่า รูเล็ต บอล หวย สล็อต`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        หลัง Login ลำดับการใช้งานจะเป็นชุดเดียวกันทุกครั้ง
        <strong>เลือกหมวดเกม เปิดรายการที่ต้องการ อ่านรายละเอียดของโต๊ะหรือเกมนั้น แล้วจึงกำหนดยอดก่อนยืนยันการเดิมพัน</strong>
        การไล่ดูให้ครบรอบหนึ่งก่อนจึงช่วยให้รู้ว่าข้อมูลแต่ละอย่างอยู่ตรงไหนของหน้าจอ และเลือกรายการที่ช่วงเดิมพันตรงกับงบที่ตั้งไว้ได้เร็วขึ้น
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={popularGamesImage}
          alt="การ์ดหมวดเกมยอดนิยม เป็นภาพตัวละครกระต่ายกับแมวการ์ตูนยืนขนาบข้างหีบสมบัติและกองเหรียญทอง มีชิปคาสิโนลายโพดำกระจายอยู่รอบ และมีข้อความ POPULAR GAME ตัวหนาสีทองอยู่กลางภาพ"
          loading="lazy"
          fetchpriority="low"
          decoding="async"
          widths={[300, 600]}
          sizes="(max-width: 639px) 100vw, 600px"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={62}
          class="mx-auto block h-auto w-full max-w-[600px] rounded-2xl border border-[#fad354]/30"
        />

        <Picture
          src={newGamesImage}
          alt="การ์ดหมวดเกมเปิดใหม่ เป็นภาพตัวละครฟักทองสวมหมวกกับโครงกระดูกการ์ตูนยืนขนาบข้างบนลานกระเบื้องเรืองแสง มีชิปและดาวสีสดกระจายอยู่ และมีข้อความ New Game ตัวหนาสีขาวอยู่กลางภาพ"
          loading="lazy"
          fetchpriority="low"
          decoding="async"
          widths={[300, 600]}
          sizes="(max-width: 639px) 100vw, 600px"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={62}
          class="mx-auto block h-auto w-full max-w-[600px] rounded-2xl border border-[#fad354]/30"
        />
      </div>

      <ul class="flex flex-col gap-3" aria-label="หมวดเกมที่เปิดให้เลือกในระบบ">
        <li class="flex gap-3">
          <span aria-hidden="true">🃏</span>
          <span>
            <strong>บาคาร่าและรูเล็ต</strong> มีโต๊ะให้เลือกตามรายการที่เปิดให้บริการในช่วงนั้น จำนวนโต๊ะจึงไม่เท่ากันทุกช่วงเวลา ควรยึดรายการที่ระบบแสดงอยู่ ไม่ใช่โต๊ะที่จำไว้จากรอบก่อน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">🎰</span>
          <span>
            <strong>สล็อต</strong> มีทั้งเกมคลาสสิก ฟรีสปิน โบนัส และตัวคูณ แต่ละเกมเปิดไว้ไม่เท่ากัน บางเกมมีครบ บางเกมมีเพียงบางอย่าง การอ่านรายละเอียดก่อนจึงช่วยให้เลือกได้ตรงกับที่ตั้งใจ
          </span>
        </li>
        <li class="flex gap-3">
