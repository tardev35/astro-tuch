---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { pageGraph } from "../lib/schema";

// OSAKA198 เป็นเว็บสล็อตออนไลน์ หน้านี้จึงหมายถึงการทำความรู้จักระบบสล็อตก่อนเดิมพัน
// ด้วยเครดิตจริง — ขั้นตอนสมัครและฝากเครดิต การเลือกค่ายและเกม การตรวจช่วงเดิมพัน
// ขั้นต่ำ-สูงสุดของแต่ละเกม โปรโมชั่นที่ตรวจสอบได้หลัง Login และการดูประวัติรายการ
// ในบัญชีสมาชิก (รอบรีแบรนด์ก่อนหน้าเป็นคาสิโนสด/โต๊ะ Live ซึ่งผิดหมวดสำหรับแบรนด์นี้
// ทั้งหมด หน้านี้จึงถูกเขียนใหม่ทั้งหน้า ไม่มีบาคาร่า/รูเล็ต/โต๊ะไลฟ์หลงเหลือ)
//
// แบรนด์เก่าเคยวางแกลเลอรี 12 การ์ด (gamedemo7..18.webp) ไว้ที่หน้านี้ ถูกถอดออกไปตั้งแต่
// เก้ารอบรีแบรนด์ก่อน และไม่มีการ import แล้ว — อย่านำกลับมา เหตุผลมีสองชั้น: ลำพังการ import
// ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดงถ้ามีรูปที่ไม่มีใคร render ทั้งชุด
// ยังเป็นภาพของ "askmeslot" ซึ่งเป็นโลโก้เว็บอื่น การนำกลับมาคือการโชว์แบรนด์คู่แข่ง
// บนหน้าเว็บของ OSAKA198
//
// ทุกข้อความอ้างอิง src/assets/content.txt เท่านั้น: สล็อตหลายค่ายในบัญชีเดียว (เกมยอดนิยม
// เกมใหม่ เกมโบนัส ฟรีสปิน) · เดิมพันเริ่มต้น 1 บาทขึ้นกับช่วงเดิมพันของแต่ละเกมและค่าย ·
// "ไม่จำกัดยอด/ไม่อั้น" ให้ยึดวงเงินที่ระบบแสดง ณ เวลาทำรายการ · สมัครเอง 3 ขั้นตอน ·
// โบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไข · ฝากถอนและประวัติรายการในบัญชี
// สมาชิก · แอดมิน 24 ชม. ไม่มีการอ้างใบอนุญาต การจดทะเบียน ปีที่ก่อตั้ง จำนวนสมาชิก
// การันตีผลกำไร หรือชื่อค่ายเกมรายใด และไม่มีตาราง RTP/อัตราจ่ายตายตัว
//
// Announcement หมุนมาใช้ Announcement5 ตัวเดียวกับ index — default message ของไฟล์นั้น
// เป็นข้อความของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ได้
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 160
const pageDescription = "หน้าทดลองเล่นของ OSAKA198 แนะนำวิธีทำความคุ้นเคยกับระบบสล็อตออนไลน์ ตั้งแต่สมัครสมาชิก ฝากเครดิต เลือกค่ายและเกม ตรวจช่วงเดิมพันและวงเงิน ไปจนถึงดูประวัติรายการ";

const graph = pageGraph(Astro, {
  name: "ทดลองเล่น OSAKA198 ทำความรู้จักระบบสล็อตก่อนเดิมพันด้วยเครดิตจริง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title="ทดลองเล่น OSAKA198 ลองใช้ระบบสล็อตออนไลน์ เล่นได้ทุกค่าย ในเว็บเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่น OSAKA198 ทำความรู้จักระบบสล็อตก่อนเดิมพันด้วยเครดิตจริง" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e8ddc8]">
        <strong class="text-[#f7f1e4]">OSAKA198</strong> เปิดให้บริการสมาชิกที่ต้องการเล่นสล็อตออนไลน์ผ่านมือถือและคอมพิวเตอร์
        โดยรวบรวมเกมจากหลายค่ายไว้ในบัญชีเดียว มีทั้งเกมยอดนิยม เกมใหม่ เกมโบนัส และฟรีสปิน ตามที่ระบบเปิดให้บริการ
        หน้านี้จึงเปิดไว้ให้ผู้เริ่มต้นได้<strong class="text-[#e4cc95]">ทำความคุ้นเคยกับขั้นตอนใช้งาน ตรวจช่วงเดิมพัน และวงเงินขั้นต่ำและสูงสุดของแต่ละเกม</strong>
        ก่อนเดิมพันด้วยเครดิตของตัวเอง เพราะรายละเอียดเหล่านี้อาจแตกต่างกันตามค่ายและตามเกมที่เลือก
      </p>

      <p class="text-left text-base leading-relaxed text-[#e8ddc8]">
        ขอให้เข้าใจตรงกันว่าการทดลองเล่นเป็นการทำความคุ้นเคยกับระบบเท่านั้น
        <strong class="text-[#e4cc95]">ผลของแต่ละสปินไม่แน่นอน ไม่มีเกมหรือสูตรใดรับประกันผลได้เสียล่วงหน้า</strong>
        หากติดปัญหาระหว่างใช้งาน แจ้งแอดมิน OSAKA198 ได้ตลอด 24 ชั่วโมง พร้อมชื่อเกม เวลา จำนวนเงิน และรายละเอียดของรายการ เพื่อให้ตรวจสอบได้ตรงจุด
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="ขั้นตอนเริ่มใช้งาน OSAKA198 ตั้งแต่สมัครสมาชิกจนถึงเข้าเกมสล็อต" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e8ddc8]">
        ผู้ใช้งานใหม่สมัคร OSAKA198 ผ่านระบบออนไลน์ได้ด้วยตัวเอง โดยไม่ต้องสมัครแยกหลายบัญชีสำหรับแต่ละค่าย
        เริ่มต้นใช้งานได้ง่ายเพียง <strong class="text-[#e4cc95]">3 ขั้นตอน</strong> และเป็นลำดับเดียวกันไม่ว่าจะเลือกเล่นเกมของค่ายไหน
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#e8ddc8]">
        <li class="flex gap-3"><span class="font-bold text-[#e4cc95]">1.</span> สมัครสมาชิก OSAKA198 และกรอกข้อมูลตามที่ระบบกำหนด ทำผ่านมือถือหรือคอมพิวเตอร์ได้โดยตรง</li>
        <li class="flex gap-3"><span class="font-bold text-[#e4cc95]">2.</span> Login เข้าสู่บัญชีและฝากเครดิตผ่านช่องทางที่เปิดให้บริการ</li>
        <li class="flex gap-3"><span class="font-bold text-[#e4cc95]">3.</span> ตรวจสอบโปรโมชั่น เลือกค่ายและเกมสล็อตที่ต้องการ แล้วศึกษาช่วงเดิมพันก่อนเริ่มเล่น</li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#c7b895]">
        หลังสมัครเรียบร้อยสามารถตรวจสอบเครดิต ประวัติรายการ โปรโมชั่น และสถานะฝากถอนผ่านบัญชีสมาชิกได้โดยตรง
        ควรไล่ดูให้ครบก่อนใช้เครดิตจริง จะช่วยให้เห็นว่ารายการหนึ่งถูกบันทึกและคิดผลมาจากอะไรบ้าง
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ตรวจช่วงเดิมพัน วงเงิน และเงื่อนไขของเกมก่อนเริ่มหมุนทุกครั้ง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e8ddc8]">
        ข้อมูลที่ควรเปิดดูให้ครบก่อนลงเดิมพันมีอยู่ไม่กี่อย่าง และระบบแสดงไว้ให้ตรวจสอบได้จากบัญชีเดียวอยู่แล้ว
        <strong class="text-[#f7f1e4]">ข้อมูลชุดนี้คือสิ่งที่กำหนดว่ารายการหนึ่งคิดผลอย่างไร</strong> จึงควรอ่านให้จบก่อนตัดสินใจว่าจะลงเท่าไร
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#e8ddc8]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e4cc95]">🎰</span>
          <span><strong class="text-[#e4cc95]">ค่ายและเกมที่เลือก</strong> เกมยอดนิยม เกมใหม่ เกมโบนัส และเกมฟรีสปิน ใช้กติกาคนละชุด ควรอ่านของเกมที่กำลังจะเล่นเป็นหลัก</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e4cc95]">💹</span>
          <span>
            <strong class="text-[#e4cc95]">ช่วงเดิมพันเริ่มต้น 1 บาท</strong> ใช้ได้เมื่อเกมนั้นเปิดช่วงเดิมพันระดับดังกล่าว ขั้นต่ำจริงต่างกันตามผู้ให้บริการและแต่ละเกม จึงให้ยึดตัวเลขที่แสดงในเกมก่อนเริ่มเล่น
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e4cc95]">🔁</span>
          <span><strong class="text-[#e4cc95]">รอบโบนัสและฟรีสปิน</strong> ของแต่ละเกมเข้าเงื่อนไขไม่เหมือนกัน ควรอ่านหน้าอธิบายในตัวเกมก่อน จะได้รู้ว่าฟีเจอร์ไหนทำงานตอนไหน</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e4cc95]">💰</span>
          <span><strong class="text-[#e4cc95]">วงเงินขั้นต่ำและสูงสุด</strong> ของแต่ละเกมไม่เท่ากัน ส่วนเงื่อนไข “ไม่จำกัดยอด” หรือ “ไม่อั้น” ให้ยึดวงเงินที่ระบบแสดง ณ เวลาทำรายการเป็นหลัก และควรกำหนดยอดต่อสปินไว้ล่วงหน้า</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#c7b895]">
        รายการค่ายและเกมที่พร้อมใช้งานเปลี่ยนแปลงได้ ควรตรวจสอบรายการล่าสุดจากหมวดสล็อตในเว็บก่อนเข้าเล่น
        ส่วนรายละเอียดฟีเจอร์และเงื่อนไขของเกมให้ยึดข้อมูลที่แสดงในตัวเกมโดยตรง
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ฝากถอน เช็กโปรโมชั่น และดูแลความปลอดภัยของบัญชีสมาชิก" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e8ddc8]">
        สมาชิกจัดการเครดิตได้เองโดยเลือกช่องทางฝากถอนที่เว็บไซต์เปิดให้บริการ
        <strong class="text-[#e4cc95]">ฝากเครดิต ส่งคำขอถอน และตรวจสอบสถานะรายการผ่านบัญชีของตนเองได้โดยตรง</strong>
        ก่อนทำธุรกรรมควรตรวจสอบชื่อบัญชี จำนวนเงิน ยอดขั้นต่ำ และวงเงินต่อรายการให้ถูกต้องทุกครั้ง ส่วนเครดิต ประวัติรายการ และโปรโมชั่นที่กดรับไว้จะแสดงอยู่ในบัญชีสมาชิกให้ย้อนดูได้
      </p>

      <ul class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#e8ddc8]">
        <li class="flex gap-3">
          <span class="text-[#e4cc95]" aria-hidden="true">•</span> โปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตรวจสอบสิทธิ์ได้หลัง Login แต่ละรายการมียอดที่ใช้คำนวณ รอบรับ และเงื่อนไขการถอนต่างกัน ควรอ่านรายละเอียดล่าสุดก่อนกดรับ
        </li>
        <li class="flex gap-3">
          <span class="text-[#e4cc95]" aria-hidden="true">•</span> หน้านี้อธิบายการใช้งานและการทำความคุ้นเคยกับระบบเท่านั้น การเดิมพันจริงต้องสมัครสมาชิกและฝากเครดิตผ่านช่องทางที่เปิดให้บริการก่อน
        </li>
        <li class="flex gap-3">
          <span class="text-[#e4cc95]" aria-hidden="true">•</span> หากเครดิตไม่เข้า รายการถอนค้าง หรือสถานะธุรกรรมไม่อัปเดต ให้เก็บข้อมูลและหลักฐานรายการไว้จนกว่าการตรวจสอบจะเสร็จสิ้น
        </li>
        <li class="flex gap-3">
          <span class="text-[#e4cc95]" aria-hidden="true">•</span>
          <strong class="text-[#f7f1e4]">ตั้งรหัสผ่านที่คาดเดายากและไม่เปิดเผย OTP แก่บุคคลอื่น</strong> ไม่ว่าจะเป็นการติดต่อจากช่องทางใดก็ตาม
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#e8ddc8]">
        หากพบปัญหาสมัครสมาชิก Login ไม่ได้ เข้าเกมสล็อตไม่ได้ ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง หรือโปรโมชั่นไม่แสดง ติดต่อแอดมิน OSAKA198 ได้ตลอด 24 ชั่วโมง พร้อมแจ้งชื่อเกม เวลา จำนวนเงิน
        และรายละเอียดของรายการ <strong class="text-[#f7f1e4]">การเดิมพันมีความเสี่ยง ควรกำหนดงบประมาณให้เหมาะสมทุกครั้ง</strong>
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก OSAKA198"
          class="flex items-center justify-center rounded-lg border border-[#d1ae72]/70 bg-gradient-to-r from-[#f7f1e4] via-[#e4cc95] to-[#a37c4b] px-8 py-3 font-black text-[#0b0906] shadow-[0_0_15px_rgba(209,174,114,0.30)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ OSAKA198"
          class="flex items-center justify-center rounded-lg border border-[#a37c4b]/60 bg-transparent px-8 py-3 font-bold text-[#e4cc95] transition-all hover:scale-105 hover:border-[#e4cc95] hover:bg-[#2c2214]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>

  <Navfoot />
</MainLayout>
