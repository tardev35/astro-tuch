---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";

import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion,
// /login, /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์
// หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ (src/assets/content.txt) ไม่มี
// ส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่จากข้อเท็จจริงและคลังคำของบรีฟรอบนี้
// เท่านั้น (.claude/brand-spec-naza168.md §5)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
//   h1  ทดลองเล่น <แบรนด์> ศึกษากติกาเกม ฟีเจอร์ และระดับการเดิมพันก่อนใช้บริการ
//   h2  เมนูภาษาไทยและรายละเอียดเกมที่ควรเปิดอ่านก่อนเลือกเกมสล็อต
//   h2  รูปแบบการจ่ายรางวัลและระดับการเดิมพันที่ต่างกันในแต่ละเกม
//   h2  เงื่อนไขการทำรายการและประกาศล่าสุดที่ควรตรวจก่อนใช้บริการ
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// 🚨🚨 **คำว่า "ทดลองเล่น" รอบนี้เหลือรอดได้ที่เดียวคือชื่อ route /ทดลองเล่น**
// (ใช้ใน <h1> · <title> · description · breadcrumb เพื่อบอกว่าหน้านี้คือหน้าไหน)
// บรีฟรอบนี้ **ไม่ได้พูดถึงการเล่นแบบไม่ใช้เงินจริงเลยแม้แต่ประโยคเดียว**
// คำคู่ที่ขึ้นต้นด้วยชื่อ route นี้แล้วลงท้ายด้วย ฟรี / โหมด~ เป็นคำของแบรนด์เก่า
// (คำเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ
// false positive ในคอมเมนต์ของไฟล์นี้เอง) — **ห้ามเขียนกลับเข้ามา**
// แกนของหน้า = **การศึกษารายละเอียดเกมก่อนใช้บริการ** ตามที่บรีฟมีจริง:
// เมนูสำหรับศึกษารายละเอียดเกม · กติกาเกม · ฟีเจอร์ · รูปแบบการจ่ายรางวัล ·
// ระดับการเดิมพัน · เงื่อนไขการทำรายการ · ประกาศล่าสุด
//
// 🚨 แกนของดรอปนี้คือ **เว็บสล็อตออนไลน์ธีมอวกาศ** ที่บรีฟเขียนถึงตัวเองว่า
// ระบบเล่นง่าย · รองรับภาษาไทย · ลิขสิทธิ์แท้จากอเมริกา · ฝากถอนเข้าบริษัทตรง
// ไม่ผ่านม้า · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · กดรับได้ไม่จำกัด · แอดมิน 24ชม.
// ⚠️⚠️ คำขายของแบรนด์ขาออกและของรอบก่อนหน้านั้น **ห้ามหลงเหลือ** —
// รายการคำต้องห้ามเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep
// ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// ⚠️⚠️ **รีโปนี้เคยมีลูกค้าชื่อเดียวกันแต่สะกดด้วยตัวละติน** (ดู brand-spec §0) —
// รอบนี้สะกดได้แบบเดียวคือค่าใน BRAND_NAME ซึ่งเป็นภาษาไทยล้วน ห้ามพิมพ์ตรงๆ
//
// ⚠️⚠️ **สองหน้าหมวดลอตเตอรียังจอดอยู่ใน src/pages-disabled/** → ลิงก์ไปสอง route
// นั้นจะทำให้ build แดง ห้ามเขียนกลับมา
// route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ทดลองเล่น · /about-us · /contact-us · /terms · /privacy · /line
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกม ชื่อธนาคาร ชื่อวอลเล็ต ชื่อผู้ให้บริการ
// หน่วยงานกำกับ ใบอนุญาต ปีก่อตั้ง จำนวนสมาชิก จำนวนเกม ค่าสถิติของเกมที่เป็น
// ตัวเลข หรือยอดขั้นต่ำที่เป็นตัวเลข แม้แต่รายการเดียว** จึงห้ามเขียนลงหน้าเว็บ ·
// ตัวเลขที่ขึ้นหน้าได้มีแค่ของบรีฟเอง: **0.3% · 0.8% · 24ชม.**
// ⚠️ **ไม่มีจำนวนขั้นตอนที่นับเป็นข้อ ไม่มีจำนวนเกม และไม่มีเปอร์เซ็นต์เต็มร้อย
// ในบรีฟรอบนี้**
//
// 🚨 **ข้อกำกับของบรีฟที่ต้อง ship ครบบนหน้านี้** (ไม่ใช่ filler ให้ตัดทิ้ง):
// 1) การรองรับภาษาไทยไม่ได้เป็นหลักฐานยืนยันแหล่งที่มาหรือสถานะลิขสิทธิ์ของเกม
//    ควรตรวจสอบชื่อผู้พัฒนาเกม ประเทศที่จดทะเบียน และหลักฐานการอนุญาต
// 2) เกมสล็อตแต่ละประเภทอาจมีรูปแบบการจ่ายรางวัลและระดับการเดิมพันแตกต่างกัน
// 3) การคืนเครดิตไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือทำให้มีโอกาส
//    ชนะมากขึ้น · แม้ระบุว่ากดรับได้ไม่จำกัด แต่ควรตรวจสอบจำนวนครั้งที่รับสิทธิ์
//    ได้จริงจากประกาศล่าสุด
// 4) ควรตรวจสอบชื่อบัญชีปลายทางและข้อมูลนิติบุคคลจากหลักฐานที่เชื่อถือได้ เพื่อ
//    หลีกเลี่ยงความเสี่ยงจากบัญชีแอบอ้าง
// 5) ไม่เปิดเผยรหัสผ่านหรือรหัส OTP · ควรตรวจสอบเวลาการให้บริการจริงจากประกาศ
//    ล่าสุดอีกครั้ง
// ⚠️ บรีฟไม่ได้การันตีผลลัพธ์ใดๆ — คอปปี้หน้านี้จึงไม่สัญญากำไรและไม่สัญญาว่า
// ถอนได้ชัวร์
//
// 🚨 **ไม่มีรูปในหน้านี้โดยตั้งใจ (รอบนี้ถอด gamedemo8/gamedemo16 ออก)**
// ดรอปนี้ไม่มี article illustration เลย และอาร์ตสต็อก gamedemo ทั้งชุดเป็นฉาก
// โทนทอง-เหรียญ-หีบสมบัติ กับฉากนีออนชมพู ซึ่งเป็นสองฮิวที่ brand-spec §2
// **ตัดออกจากรอบนี้ทั้งหมดโดยตั้งใจ** (ทองคือฮิวที่ผ่านรีโปนี้มากว่า 20 เจ้า
// รวมถึงเจ้าที่ชื่อซ้ำกับรอบนี้ ดู §0) ดรอปนี้เป็นธีมอวกาศฟ้าไซยานบนพื้นเกือบดำ
// ไฟล์ gamedemo* ยังอยู่บนดิสก์ **ห้ามลบ** เป็นอินเวนทอรีของแบรนด์ถัดไป —
// แต่ห้าม import กลับเข้ามารอบนี้ (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/)
// ⚠️ รูปอื่นทั้งหมดห้ามอ้างจากหน้านี้เช่นกัน: banner2/banner3 กับ slide3/slide4
// เป็นอาร์ตเวิร์กของแบรนด์คนละราย · slide1/slide2 ถูกตรึงไว้กับ index กับ
// /promotion · banner1 / banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักไว้
//
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) **กลับทิศจากรอบก่อน 180 องศา — รอบนี้เป็น
// "ธีมมืด"** bg.json ของดรอปนี้คือ {"mode":"color","color":"#0d1017"} =
// ถ่านเกือบดำอมน้ำเงิน (รอบก่อนเป็น dbe6ff = ฟ้าเพอริวิงเคิลอ่อน = ธีมสว่าง)
// **ห้ามเดาว่าเท่าเดิม และห้าม "แก้" การ์ดให้สว่างเพราะรอบก่อนทำแบบนั้น**
// ค่าที่ใช้ได้ในไฟล์นี้: ฟ้าไซยาน #1fd8f0 (<strong> + marker + ตัวอักษรปุ่มรอง —
// 9.1:1 บนผิวการ์ด ถือตัวอักษรได้) · น้ำเงินอุลตรามารีน #1d4fd8 -> #143aa0
// (**พื้นถมของปุ่มหลักเท่านั้น 2.4:1 บนการ์ด ห้ามถือตัวอักษร**) · ผิวจม #121722
// และผิวยก #273449 (พื้นปุ่ม/ชิป) · ขอบ #33455f (**ห้ามถือตัวอักษร**) ·
// ขาว #ffffff (หมึกบนปุ่มหลัก) · พื้นเพจ #0d1017 (หมึกบนปุ่มเน้นฟ้าไซยาน)
// หมึกเนื้อความคือ #e6edf8 (= BRAND_TEXT) ซึ่ง **ไม่ประกาศในไฟล์นี้** การ์ด
// ContentBox ตั้งไว้ให้แล้วและย่อหน้าสืบทอดลงมา
// 🚨🚨 **ห้ามใช้ตัวอักษรขาวบนพื้นถม #1fd8f0** (1.7:1) ปุ่มเน้นใช้หมึก #0d1017 เสมอ
// ส่วนปุ่มหลัก (ไล่ #1d4fd8 -> #143aa0) ใช้หมึกขาวเท่านั้น
// ออราที่อนุญาต: rgba(31,216,240,α) · rgba(29,79,216,α) · rgba(143,217,236,α) ·
// rgba(11,182,212,α) · rgba(13,16,23,α) · rgba(0,0,0,α)
// ⚠️ รอบนี้ไม่มีทอง ไม่มีเหลือง ไม่มีส้ม ไม่มีแดง ไม่มีชมพู ไม่มีม่วง ไม่มีน้ำตาล
// ไม่มีเขียว และ **ไม่มีแรมป์เทาเงิน** · ปุ่ม LINE อยู่บน /about-us กับ
// /contact-us ไม่ใช่หน้านี้
// ⚠️⚠️ **ฟ้า/ไซยานผ่านรีโปนี้มาแล้วหกเจ้า และรอบก่อนหน้าทันทีก็ฟ้านำ** การเจอฟ้า
// ในไฟล์จึงไม่พิสูจน์อะไร — ห้ามเทียบด้วยวงศ์สี ต้องเทียบทีละค่ากับ brand-spec §2
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง และไม่ใส่ mx-auto / max-w-* บน <p>
// เพราะการ์ดคุมความกว้างเองแล้ว — ที่ประกาศสีได้มีแค่ปุ่ม ชิปไอคอน marker ของ
// ลำดับเลข และ <strong> · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง
// เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำ
// จะขาดครึ่ง และห้ามวาง <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังในข้อความของ prop และต้องไม่ใช่สัญลักษณ์ของอาร์ตเวิร์กแบรนด์เก่า
// (กล่องของขวัญ ถุงเงิน มงกุฎ เหรียญทอง หีบสมบัติ ตราชั่ง ธนบัตร ฯลฯ)
//
// Announcement รอบนี้หมุนมาเป็น AnnouncementCyber ทั้งเว็บ (brand-spec §3 —
// รอบก่อนใช้ Announcement5 จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์
// นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว จึงเรียกแบบ bare **ห้ามส่ง prop message**
// มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 152 อักขระ (ชื่อแบรนด์รอบนี้ 8 ตัวอักษร) เป็นประโยคเดียวที่บอกว่า
// หน้านี้มีไว้ทำอะไร แล้วหยุด
// (Google ตัดราว 155 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนๆ ยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} รวมสิ่งที่ควรเปิดอ่านก่อนใช้บริการ ทั้งเมนูภาษาไทย กติกาเกม รูปแบบการจ่ายรางวัล ระดับการเดิมพัน และเงื่อนไขการทำรายการจากประกาศล่าสุด`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ศึกษากติกาเกม ฟีเจอร์ และระดับการเดิมพันก่อนใช้บริการ`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});

// คลาสปุ่มสี่แบบของหน้านี้ ประกาศครั้งเดียวแล้วใช้ซ้ำ เพื่อไม่ให้สองปุ่มที่ทำ
// หน้าที่เดียวกันหลุดไปคนละเฉดตอนรีแบรนด์รอบหน้า
const ctaPrimary =
  "flex items-center justify-center rounded-lg border border-[#143aa0] bg-gradient-to-b from-[#1d4fd8] to-[#143aa0] px-8 py-3 font-black text-[#ffffff] shadow-[0_6px_18px_rgba(29,79,216,0.35)] transition-transform hover:scale-105";

const ctaSecondary =
  "flex items-center justify-center rounded-lg border-2 border-[#1fd8f0] bg-[#121722] px-8 py-3 font-bold text-[#1fd8f0] shadow-[0_4px_14px_rgba(0,0,0,0.35)] transition-all hover:scale-105 hover:bg-[#273449]";

const ctaQuiet =
  "flex items-center justify-center rounded-lg border border-[#33455f] bg-[#121722] px-8 py-3 font-bold text-[#1fd8f0] shadow-[0_4px_14px_rgba(0,0,0,0.3)] transition-all hover:scale-105 hover:border-[#1fd8f0] hover:shadow-[0_6px_18px_rgba(31,216,240,0.25)]";

const ctaAccent =
  "flex items-center justify-center rounded-lg border border-[#1fd8f0] bg-[#1fd8f0] px-8 py-3 font-bold text-[#0d1017] shadow-[0_4px_14px_rgba(31,216,240,0.3)] transition-transform hover:scale-105";

const listChip = "mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#1fd8f0]/50 bg-[#273449] text-sm";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#1fd8f0]">{BRAND_NAME} นำเสนอเกมสล็อตออนไลน์ที่เน้นรูปแบบการใช้งานภาษาไทย มีเมนูสำหรับศึกษารายละเอียดเกม โปรโมชั่น และช่องทางฝากถอนในเว็บไซต์เดียว</strong>
        หน้านี้รวบรวมไว้ว่าควรเปิดอ่านอะไรบ้างก่อนใช้บริการ ตั้งแต่ชื่อเมนูและกติกาเกม ไปจนถึงเงื่อนไขการทำรายการที่ต้องอ่านให้ครบก่อนตัดสินใจ
      </p>

      <p>
        <strong class="text-[#1fd8f0]">ผู้ใช้งานสามารถตรวจสอบกติกาเกมและเงื่อนไขการทำรายการก่อนใช้บริการได้</strong>
        การไล่อ่านข้อมูลเหล่านี้ก่อนช่วยให้เข้าใจว่าแต่ละเกมกำหนดรูปแบบการจ่ายรางวัลและระดับการเดิมพันไว้อย่างไร ก่อนที่จะต้องตัดสินใจด้วยเงินของตัวเอง
      </p>

      <p>
        ส่วนคำกล่าวอ้างเรื่องลิขสิทธิ์แท้จากอเมริกา ควรตรวจสอบชื่อผู้พัฒนาเกม ประเทศที่จดทะเบียน และหลักฐานการอนุญาตจากเจ้าของลิขสิทธิ์โดยตรง
        <strong class="text-[#1fd8f0]">เพราะการรองรับภาษาไทยไม่ได้เป็นหลักฐานยืนยันแหล่งที่มาหรือสถานะลิขสิทธิ์ของเกม</strong>
        เนื้อหาในหน้านี้จึงเขียนไว้ประกอบการใช้งานเท่านั้น ไม่ได้ใช้แทนเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้บริการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="เมนูภาษาไทยและรายละเอียดเกมที่ควรเปิดอ่านก่อนเลือกเกมสล็อต" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#1fd8f0]">{BRAND_NAME} นำเสนอข้อมูลเกมสล็อตที่รองรับการใช้งานภาษาไทย</strong>
        ช่วยให้ผู้ใช้งานศึกษาชื่อเมนู กติกาเกม และรายละเอียดฟีเจอร์ต่างๆ ได้สะดวกขึ้น รายการด้านล่างคือสิ่งที่ควรไล่อ่านให้ครบก่อนเลือกเกม
      </p>

      <ul class="flex flex-col gap-4" aria-label="สิ่งที่ควรเปิดอ่านก่อนเลือกเกมสล็อต">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🌐</span>
          <span>
            <strong class="text-[#1fd8f0]">ชื่อเมนูในภาษาไทย</strong> เป็นจุดเริ่มที่อ่านได้เร็วที่สุด เพราะบอกว่าข้อมูลแต่ละชุดอยู่ตรงไหน ก่อนจะเปิดเข้าไปอ่านรายละเอียดของเกมเป็นรายเกม
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📘</span>
          <span>
            <strong class="text-[#1fd8f0]">กติกาเกมของแต่ละรายการ</strong> เป็นตัวกำหนดว่าผลของแต่ละรอบนับอย่างไร และเงื่อนไขไหนที่ต้องเกิดขึ้นก่อนจึงจะมีผลรางวัลตามที่ระบุไว้
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎰</span>
          <span>
            <strong class="text-[#1fd8f0]">ฟีเจอร์ที่เกมนั้นเปิดไว้</strong> กำหนดไม่เหมือนกันในแต่ละเกม จึงควรอ่านจากหน้ารายละเอียดของเกมนั้นโดยตรง ไม่ใช่สรุปจากเกมอื่นที่เคยเปิดดูไว้
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📜</span>
          <span>
            <strong class="text-[#1fd8f0]">ชื่อผู้พัฒนาเกมและประเทศที่จดทะเบียน</strong> คือข้อมูลที่ใช้ตรวจสถานะลิขสิทธิ์ได้ตรงที่สุด ควรดูคู่กับหลักฐานการอนุญาตจากเจ้าของลิขสิทธิ์
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#1fd8f0]">รายการเกมที่เปิดให้บริการจริงปรับเปลี่ยนได้ตามประกาศล่าสุดของเว็บไซต์</strong>
        การเปิดดูหน้ารายการเกมก่อนทุกครั้งจึงตรงกว่าการจำไว้จากรอบก่อน และช่วยให้เห็นเงื่อนไขของเกมที่ตรงกับช่วงเวลาที่กำลังใช้งานอยู่จริง
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/about-us" aria-label={`อ่านหน้าเกี่ยวกับเราของ ${BRAND_NAME}`} class={ctaQuiet}>อ่านเกี่ยวกับเรา</a>

        <a href="/ทางเข้า" aria-label={`เปิดหน้าทางเข้าของ ${BRAND_NAME}`} class={ctaQuiet}>ไปหน้าทางเข้า</a>
