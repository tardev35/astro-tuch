---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { pageGraph } from "../lib/schema";

// MEPAY77 เป็นเว็บคาสิโนออนไลน์ (บาคาร่า / สล็อต / หวย / บอล) ไม่ใช่เว็บสล็อตอย่างเดียว
// และไม่ใช่เว็บหวย หน้านี้จึงหมายถึงการทำความรู้จักระบบทุกหมวดเกมก่อนเดิมพันด้วยเครดิตจริง
// — ขั้นตอนสมัครและฝากเครดิต การเลือกหมวดเกม การตรวจกติกา อัตราจ่าย และวงเงินของแต่ละเกม
// โปรโมชั่นที่ตรวจสอบได้หลัง Login และการดูประวัติรายการในบัญชีสมาชิก
// (รอบรีแบรนด์ก่อนหน้าเป็นเว็บสล็อตล้วน เนื้อหาเดิมจึงถูกเขียนใหม่ทั้งหน้า)
//
// แบรนด์เก่าเคยวางแกลเลอรี 12 การ์ด (gamedemo7..18.webp) ไว้ที่หน้านี้ ถูกถอดออกไปตั้งแต่
// สิบรอบรีแบรนด์ก่อน และไม่มีการ import แล้ว — อย่านำกลับมา เหตุผลมีสองชั้น: ลำพังการ import
// ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดงถ้ามีรูปที่ไม่มีใคร render ทั้งชุด
// ยังเป็นภาพของ "askmeslot" ซึ่งเป็นโลโก้เว็บอื่น การนำกลับมาคือการโชว์แบรนด์คู่แข่ง
// บนหน้าเว็บของ MEPAY77
//
// ทุกข้อความอ้างอิง src/assets/content.txt เท่านั้น: บาคาร่าและคาสิโนสด สล็อตออนไลน์หลายค่าย
// หวยออนไลน์ตามรอบที่เปิดให้บริการ และเดิมพันฟุตบอลตามรายการแข่งขัน · สลับหมวดเกมผ่านบัญชีเดียว ·
// ตรวจกติกา อัตราจ่าย และวงเงินของแต่ละเกมก่อนยืนยันเดิมพัน · ไม่มีเกมใดรับประกันว่า "แตกง่าย" ·
// โบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไข · ฝากถอนผ่านวอลเลทหรือธนาคารตามช่องทาง
// ที่รองรับ ตรวจขั้นต่ำและวงเงินล่าสุดในหน้าฝากถอน · แอดมิน 24 ชม. ไม่มีการอ้างใบอนุญาต
// การจดทะเบียน ปีที่ก่อตั้ง จำนวนสมาชิก การันตีผลกำไร ชื่อค่ายเกมรายใด หรือตาราง RTP ตายตัว
//
// Announcement หมุนมาใช้ Announcement3 ตัวเดียวกับ index — default message ของไฟล์นั้น
// เป็นข้อความของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ได้
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 160
const pageDescription = "หน้าทดลองเล่นของ MEPAY77 แนะนำวิธีทำความคุ้นเคยกับระบบคาสิโนออนไลน์ ทั้งบาคาร่า สล็อต หวย และบอล ตั้งแต่สมัครสมาชิก ฝากเครดิต เลือกเกม ไปจนถึงตรวจกติกาและวงเงิน";

const graph = pageGraph(Astro, {
  name: "ทดลองเล่น MEPAY77 ทำความรู้จักระบบคาสิโนออนไลน์ก่อนเดิมพันด้วยเครดิตจริง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title="ทดลองเล่น MEPAY77 ลองใช้ระบบคาสิโนออนไลน์ บาคาร่า สล็อต หวย บอล ในเว็บเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่น MEPAY77 ทำความรู้จักระบบคาสิโนออนไลน์ก่อนเดิมพันด้วยเครดิตจริง" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f1e5cd]">
        <strong class="text-[#fff6e0]">MEPAY77</strong> ให้บริการเกมคาสิโนออนไลน์หลายหมวดหมู่ผ่านระบบเดียว ทั้งบาคาร่าและคาสิโนสด สล็อตออนไลน์จากหลายค่าย
        หวยออนไลน์ตามรอบที่เปิดให้บริการ และการเดิมพันฟุตบอลตามรายการแข่งขัน รองรับการใช้งานทั้งบนมือถือและคอมพิวเตอร์
        หน้านี้จึงเปิดไว้ให้ผู้เริ่มต้นได้<strong class="text-[#fdcc5c]">ทำความคุ้นเคยกับขั้นตอนใช้งาน ตรวจกติกา อัตราจ่าย และวงเงินของแต่ละเกม</strong>
        ก่อนเดิมพันด้วยเครดิตของตัวเอง เพราะรายละเอียดเหล่านี้ต่างกันไปตามหมวดเกมและตามเกมที่เลือก
      </p>

      <p class="text-left text-base leading-relaxed text-[#f1e5cd]">
        ขอให้เข้าใจตรงกันว่าการทดลองเล่นเป็นการทำความคุ้นเคยกับระบบเท่านั้น
        <strong class="text-[#fdcc5c]">เกมสล็อตและเกมคาสิโนมีผลลัพธ์ไม่แน่นอน จึงไม่มีเกมใดรับประกันว่า “แตกง่าย” หรือสร้างกำไรได้ทุกครั้ง</strong>
        ควรเลือกเกมจากกติกา รูปแบบการเดิมพัน และงบประมาณที่เหมาะสมกับตนเอง หากติดปัญหาระหว่างใช้งาน แจ้งแอดมิน MEPAY77 ได้ตลอด 24 ชั่วโมง
        พร้อมชื่อเกม เวลา จำนวนเงิน และรายละเอียดของรายการ เพื่อให้ตรวจสอบได้ตรงจุด
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="ขั้นตอนเริ่มใช้งาน MEPAY77 ตั้งแต่สมัครสมาชิกจนถึงเข้าเล่นเกม" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f1e5cd]">
        ผู้ใช้งานใหม่สมัคร MEPAY77 ผ่านระบบออนไลน์ได้ด้วยตัวเอง และสลับหมวดเกมผ่านบัญชีเดียวได้โดยไม่ต้องสมัครหลายครั้ง
        เริ่มต้นใช้งานได้ง่ายเพียง <strong class="text-[#fdcc5c]">3 ขั้นตอน</strong> และเป็นลำดับเดียวกันไม่ว่าจะเลือกเล่นหมวดไหน
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#f1e5cd]">
        <li class="flex gap-3"><span class="font-bold text-[#fdcc5c]">1.</span> สมัครสมาชิก MEPAY77 และกรอกข้อมูลตามที่ระบบกำหนด ทำผ่านมือถือหรือคอมพิวเตอร์ได้โดยตรง</li>
        <li class="flex gap-3"><span class="font-bold text-[#fdcc5c]">2.</span> Login เข้าสู่บัญชีและฝากเครดิตผ่านวอลเลทหรือธนาคารตามช่องทางที่เปิดรองรับ</li>
        <li class="flex gap-3"><span class="font-bold text-[#fdcc5c]">3.</span> ตรวจสอบโปรโมชั่น เลือกหมวดเกมและเกมที่ต้องการ แล้วอ่านกติกากับวงเงินก่อนเริ่มเดิมพัน</li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#cdb98a]">
        หลังสมัครเรียบร้อยสามารถตรวจสอบเครดิต ประวัติรายการ โปรโมชั่น และสถานะฝากถอนผ่านบัญชีสมาชิกได้โดยตรง
        ควรไล่ดูให้ครบก่อนใช้เครดิตจริง จะช่วยให้เห็นว่ารายการหนึ่งถูกบันทึกและคิดผลมาจากอะไรบ้าง
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ตรวจกติกา อัตราจ่าย และวงเงินของแต่ละหมวดเกมก่อนยืนยันเดิมพัน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f1e5cd]">
        ข้อมูลที่ควรเปิดดูให้ครบก่อนลงเดิมพันมีอยู่ไม่กี่อย่าง และระบบแสดงไว้ให้ตรวจสอบได้จากบัญชีเดียวอยู่แล้ว
        <strong class="text-[#fff6e0]">ข้อมูลชุดนี้คือสิ่งที่กำหนดว่ารายการหนึ่งคิดผลอย่างไร</strong> จึงควรอ่านให้จบก่อนตัดสินใจว่าจะลงเท่าไร
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f1e5cd]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fdcc5c]">🃏</span>
          <span><strong class="text-[#fdcc5c]">บาคาร่าและคาสิโนสด</strong> แต่ละโต๊ะใช้กติกาและวงเงินต่อตาไม่เท่ากัน ควรอ่านของโต๊ะที่กำลังจะเข้าเล่นเป็นหลักก่อนยืนยันเดิมพัน</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#dfe3e8]">🎰</span>
          <span><strong class="text-[#dfe3e8]">สล็อตออนไลน์หลายค่าย</strong> รอบโบนัสและฟรีสปินของแต่ละเกมเข้าเงื่อนไขไม่เหมือนกัน ควรอ่านหน้าอธิบายในตัวเกมก่อน จะได้รู้ว่าฟีเจอร์ไหนทำงานตอนไหน</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fdcc5c]">🎫</span>
          <span><strong class="text-[#fdcc5c]">หวยออนไลน์</strong> เปิดตามรอบที่ระบบให้บริการ ควรตรวจรอบที่เปิดรับ เวลาปิดรับ และอัตราจ่ายที่แสดงอยู่ในหน้านั้นก่อนส่งรายการ</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#dfe3e8]">⚽</span>
          <span><strong class="text-[#dfe3e8]">เดิมพันฟุตบอล</strong> เปิดตามรายการแข่งขัน ควรตรวจรูปแบบการเดิมพัน อัตราจ่าย และวงเงินขั้นต่ำกับสูงสุดของบิลนั้นก่อนกดยืนยัน</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#cdb98a]">
        รายการเกมและหมวดที่พร้อมใช้งานเปลี่ยนแปลงได้ ควรตรวจสอบรายการล่าสุดจากหน้าเกมในเว็บก่อนเข้าเล่น
        ส่วนรายละเอียดฟีเจอร์และเงื่อนไขของเกมให้ยึดข้อมูลที่แสดงในตัวเกมโดยตรง และควรกำหนดยอดต่อรายการไว้ล่วงหน้าทุกครั้ง
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ฝากถอนวอลเลท เช็กโปรโมชั่น และดูแลความปลอดภัยของบัญชีสมาชิก" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f1e5cd]">
        สมาชิกจัดการเครดิตได้เองโดยเลือกใช้วอลเลทหรือธนาคารจากช่องทางที่เว็บไซต์เปิดรองรับ
        <strong class="text-[#fdcc5c]">ฝากเครดิต ส่งคำขอถอน และตรวจสอบสถานะรายการผ่านมือถือได้โดยตรง</strong>
        ช่วยลดขั้นตอนและไม่จำเป็นต้องแจ้งรายการกับเจ้าหน้าที่ทุกครั้ง สำหรับเงื่อนไข ไม่มีขั้นต่ำ และ รองรับทุกธนาคาร
        ควรตรวจสอบข้อมูลล่าสุดในหน้าฝากถอนก่อนทำรายการ เนื่องจากแต่ละช่องทางอาจมีขั้นต่ำ วงเงินสูงสุด หรือข้อกำหนดแตกต่างกัน
      </p>

      <ul class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#f1e5cd]">
        <li class="flex gap-3">
          <span class="text-[#fdcc5c]" aria-hidden="true">•</span> โปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตรวจสอบสิทธิ์ได้หลัง Login แต่ละรายการอาจกำหนดยอดที่ใช้คำนวณ รอบรับโบนัส ประเภทเกม และเงื่อนไขต่างกัน ควรอ่านรายละเอียดให้ครบก่อนกดรับ
        </li>
        <li class="flex gap-3">
          <span class="text-[#dfe3e8]" aria-hidden="true">•</span> หน้านี้อธิบายการใช้งานและการทำความคุ้นเคยกับระบบเท่านั้น การเดิมพันจริงต้องสมัครสมาชิกและฝากเครดิตผ่านช่องทางที่เปิดให้บริการก่อน
        </li>
        <li class="flex gap-3">
          <span class="text-[#fdcc5c]" aria-hidden="true">•</span> หากเครดิตไม่เข้า รายการถอนค้าง หรือสถานะธุรกรรมไม่อัปเดต ให้เก็บหลักฐานรายการไว้จนกว่าการตรวจสอบจะเสร็จสิ้น
        </li>
        <li class="flex gap-3">
          <span class="text-[#dfe3e8]" aria-hidden="true">•</span>
          <strong class="text-[#fff6e0]">ตั้งรหัสผ่านที่คาดเดายากและไม่เปิดเผยรหัสผ่านหรือ OTP แก่บุคคลอื่น</strong> ไม่ว่าจะเป็นการติดต่อจากช่องทางใดก็ตาม
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#f1e5cd]">
        หากพบปัญหาสมัครสมาชิก Login ไม่ได้ เข้าเกมไม่ได้ ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง หรือโปรโมชั่นไม่แสดง ติดต่อแอดมิน MEPAY77 ได้ตลอด 24 ชั่วโมง พร้อมแจ้งชื่อเกม เวลา จำนวนเงิน
        และรายละเอียดของรายการ <strong class="text-[#fff6e0]">การเดิมพันมีความเสี่ยง ควรกำหนดงบประมาณให้เหมาะสมทุกครั้ง</strong>
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก MEPAY77"
          class="flex items-center justify-center rounded-lg border border-[#f2ae35]/70 bg-gradient-to-r from-[#fff6e0] via-[#fdcc5c] to-[#a3701c] px-8 py-3 font-black text-[#130c01] shadow-[0_0_15px_rgba(242,174,53,0.30)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ MEPAY77"
          class="flex items-center justify-center rounded-lg border border-[#dfe3e8]/45 bg-transparent px-8 py-3 font-bold text-[#dfe3e8] transition-all hover:scale-105 hover:border-[#dfe3e8] hover:bg-[#241503]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>

  <Navfoot />
</MainLayout>
