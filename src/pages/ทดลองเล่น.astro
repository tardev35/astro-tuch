---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import popularGamesImage from "../assets/gamedemo8.webp";
import newGamesImage from "../assets/gamedemo16.webp";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion,
// /login, /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์
// หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ (src/assets/content.txt) ไม่มี
// ส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่จากข้อเท็จจริงและคลังคำของบรีฟรอบนี้
// เท่านั้น (.claude/brand-spec-ruaythear168club.md §5)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
//   h1  ทดลองเล่น <แบรนด์> ศึกษากติกา ตารางจ่ายรางวัล และระดับการเดิมพันก่อนเลือกเกมสล็อต
//   h2  ระดับการเดิมพันและเงินเดิมพันเริ่มต้นที่ต่างกันในแต่ละเกม
//   h2  กติกา ตารางจ่ายรางวัล และค่า RTP ที่ควรอ่านก่อนเลือกเกม
//   h2  ยอดฝากขั้นต่ำ วงเงินถอน และข้อกำหนดล่าสุดที่ควรตรวจก่อนทำรายการ
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// 🚨🚨 **คำว่า "ทดลองเล่น" รอบนี้เหลือรอดได้ที่เดียวคือชื่อ route /ทดลองเล่น**
// (ใช้ใน <h1> · <title> · description · breadcrumb เพื่อบอกว่าหน้านี้คือหน้าไหน)
// บรีฟรอบนี้ **ไม่ได้พูดถึงการเล่นแบบไม่ใช้เงินจริงเลยแม้แต่ประโยคเดียว**
// คำคู่ที่ขึ้นต้นด้วยชื่อ route นี้แล้วลงท้ายด้วย ฟรี / โหมด~ เป็นคำของแบรนด์เก่า
// (คำเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ
// false positive ในคอมเมนต์ของไฟล์นี้เอง) — **ห้ามเขียนกลับเข้ามา**
// แกนของหน้า = **การศึกษาข้อมูลเกมก่อนเริ่มเล่น** ตามที่บรีฟมีจริง:
// ระดับการเดิมพันที่แตกต่างกัน · เงินเดิมพันเริ่มต้นในระดับต่ำ · กติกา ·
// ตารางจ่ายรางวัล · ค่า RTP ที่ผู้พัฒนาเปิดเผย · ยอดฝากขั้นต่ำ · วงเงินถอน ·
// เพดานธุรกรรม · ข้อกำหนดล่าสุด
//
// 🚨 แกนของดรอปนี้คือ **เว็บสล็อตออนไลน์** ที่บรีฟเรียกตัวเองว่า
// "เกมสล็อตจ่ายแพง ปรับเรทแตกหนักที่สุดในวงการ" พร้อม เดิมพันไม่มีขั้นต่ำ ·
// ทุนน้อยเล่นได้ · ไม่อั้นจ่าย ไม่อั้นถอน · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% ·
// สมัคร 3 ขั้นตอน · แอดมิน 24ชม.
// ⚠️⚠️ คำขายของของแบรนด์ขาออก (เงินทอง168) และของรอบก่อนหน้านั้น **ห้ามหลงเหลือ**
// — รายการคำต้องห้ามเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep
// ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
//
// ⚠️⚠️ **สองหน้าหมวดลอตเตอรียังจอดอยู่ใน src/pages-disabled/** → ลิงก์ไปสอง route
// นั้นจะทำให้ build แดง ห้ามเขียนกลับมา
// route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ทดลองเล่น · /about-us · /contact-us · /terms · /privacy · /line
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกม ชื่อธนาคาร ชื่อวอลเล็ต ชื่อผู้ให้บริการ
// หน่วยงานกำกับ ใบอนุญาต ปีก่อตั้ง จำนวนสมาชิก ค่า RTP ที่เป็นตัวเลข จำนวนเกม
// หรือยอดฝากขั้นต่ำที่เป็นตัวเลข แม้แต่รายการเดียว** จึงห้ามเขียนลงหน้าเว็บ ·
// ตัวเลขที่ขึ้นหน้าได้มีแค่ของบรีฟเอง: **0.3% · 0.8% · 3 ขั้นตอน · 24ชม.**
// ⚠️ **ไม่มี "1,000 เกม" และไม่มี "100%" ในบรีฟรอบนี้** สองค่านั้นเป็นของแบรนด์ขาออก
//
// 🚨 **ข้อกำกับของบรีฟที่ต้อง ship ครบบนหน้านี้** (ไม่ใช่ filler ให้ตัดทิ้ง):
// 1) คำกล่าวอ้างเรื่องการปรับเรทแตกหนักที่สุดควรพิจารณาจากข้อมูลที่ตรวจสอบได้
//    เนื่องจากผลลัพธ์ของเกมสล็อตมีความไม่แน่นอน และไม่มีเว็บไซต์ใดรับประกันการชนะได้
// 2) แม้จะมีข้อความว่าไม่อั้นจ่ายหรือไม่อั้นถอน ก็ไม่ควรสรุปว่าไม่มีเพดานธุรกรรม
//    โดยไม่ตรวจสอบข้อกำหนดล่าสุด
// 3) **ค่า RTP เป็นสถิติระยะยาว ไม่ใช่การรับประกันว่าจะชนะในแต่ละครั้ง**
// 4) การคืนเครดิตไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือทำให้มีโอกาส
//    ชนะมากขึ้น · แม้ระบุว่ากดรับได้ไม่จำกัด แต่ควรตรวจสอบจำนวนครั้งที่รับสิทธิ์
//    ได้จริงจากประกาศล่าสุด
// 5) ไม่เปิดเผยรหัสผ่านหรือรหัส OTP · ควรตรวจสอบเวลาการให้บริการจริงจากประกาศ
//    ล่าสุดอีกครั้ง
// ⚠️ บรีฟไม่ได้การันตีผลลัพธ์ใดๆ — คอปปี้หน้านี้จึงไม่สัญญากำไรและไม่สัญญาว่า
// ถอนได้ชัวร์
//
// 🚨 **รูปในหน้านี้ใช้ได้แค่ gamedemo8 กับ gamedemo16 เท่านั้น** — เป็นอาร์ตสต็อก
// กลางของเทมเพลต ไม่ใช่อาร์ตเวิร์กของแบรนด์ไหน จึงอยู่ต่อข้ามรอบได้ alt บรรยาย
// ภาพจริงและผูกกับหน้านี้ด้วย BRAND_NAME ที่ interpolate เข้ามา ห้ามเอ่ยชื่อค่ายเกม
// ส่วน gamedemo7/9/10/11/12/14/15/17/18 มีโลโก้หรือชื่อของผู้ให้บริการ/ค่ายเกม
// เจ้าอื่นพิมพ์ทับอยู่กลางรูป และ gamedemo13 เป็นภาพล่อแหลม — **ห้ามนำกลับมาใช้**
// เพราะเท่ากับอ้างชื่อค่ายเกมที่บรีฟรอบนี้ไม่ได้เอ่ย (ขัด brand-spec §5 โดยตรง)
// ไฟล์ยังอยู่บนดิสก์ ห้ามลบ เป็นอินเวนทอรี
// gamedemo8 ("POPULAR GAME" 600x379) กับ gamedemo16 ("New Game" 650x411) ไม่มีชื่อ
// แบรนด์ใดปรากฏ ความกว้างที่วาดจริงสูงสุด ~600px ต่อใบ (กริดสองคอลัมน์ในการ์ด)
// จึงไม่ขยายเกินต้นฉบับ
// ⚠️ รูปอื่นทั้งหมดห้ามอ้างจากหน้านี้: banner2/banner3 กับ slide3/slide4 เป็น
// อาร์ตเวิร์กของแบรนด์คนละราย · slide1/slide2 ถูกตรึงไว้กับ index กับ /promotion ·
// banner1 / banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักไว้ (ลำพังการ
// import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดงถ้าไม่มีหน้าไหน render)
//
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) **กลับทิศจากรอบก่อน 180 องศา — รอบนี้เป็น
// "ธีมสว่าง"** bg.json ของดรอปนี้คือ {"mode":"color","color":"#dbe6ff"} =
// ฟ้าเพอริวิงเคิลอ่อน (รอบก่อนเป็น 29210f = น้ำตาลโอลีฟเข้ม) **ห้ามเดาว่าเท่าเดิม**
// ค่าที่ใช้ได้ในไฟล์นี้: ฟ้าเข้ม #0d6b9b (<strong> + marker + ปุ่มรอง — 5.6:1 บน
// ผิวการ์ดขาว) · ฟ้าลึก #0a5176 (ปลายไล่เฉดของปุ่มหลัก) · ฟ้าไซยาน #18a5e2
// (**2.6:1 บนผิวสว่าง ห้ามถือตัวอักษร** ใช้เป็นพื้นถมของปุ่มเน้นกับขอบ) ·
// ฟ้าอ่อน #a9d7f2 (ขอบ **ห้ามถือตัวอักษร**) · ผิวการ์ดกลาง #eef4ff (พื้นชิปไอคอน)
// · ขาว #ffffff (พื้นปุ่มรอง + หมึกบนปุ่มหลัก) · โครมจม #111a3f (หมึกบนปุ่มเน้น)
// หมึกเนื้อความคือ #16294a (= BRAND_TEXT) ซึ่ง **ไม่ประกาศในไฟล์นี้** การ์ด
// ContentBox ตั้งไว้ให้แล้วและย่อหน้าสืบทอดลงมา
// 🚨🚨 **ห้ามใช้ตัวอักษรขาวบนพื้นถม #18a5e2** (2.6:1) ปุ่มเน้นใช้หมึก #111a3f เสมอ
// ส่วนปุ่มหลัก (ไล่ #0d6b9b -> #0a5176) ใช้หมึกขาวเท่านั้น
// ออราที่อนุญาต: rgba(24,165,226,α) · rgba(13,107,155,α) · rgba(22,41,74,α) ·
// rgba(0,0,0,α)
// ⚠️ รอบนี้ไม่มีทอง ไม่มีแดง ไม่มีชมพู ไม่มีม่วง ไม่มีส้ม ไม่มีน้ำตาล ไม่มีเขียว
// และ **ไม่มีแรมป์เทาเงิน** — วัสดุที่สองรอบนี้คือครีมอุ่น #f4e4d3 (ไม่ได้ใช้ในไฟล์นี้)
// · ปุ่ม LINE อยู่บน /about-us กับ /contact-us ไม่ใช่หน้านี้
// ⚠️⚠️ **ฟ้าผ่านรีโปนี้มาแล้วห้าเจ้า** (สบาย168 · รวยแทร่168 · นินจา168 ·
// สบายเบท168 · TSDET911) การเจอฟ้าในไฟล์จึงไม่พิสูจน์อะไร — ห้ามเทียบด้วยวงศ์สี
// ต้องเทียบทีละค่ากับตาราง brand-spec §2
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง และไม่ใส่ mx-auto / max-w-* บน <p>
// เพราะการ์ดคุมความกว้างเองแล้ว — ที่ประกาศสีได้มีแค่ปุ่ม ชิปไอคอน marker ของ
// ลำดับเลข ขอบรูป และ <strong> · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง"
// ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัด
// ในแท็กและคำจะขาดครึ่ง และห้ามวาง <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังในข้อความของ prop และต้องไม่ใช่สัญลักษณ์ของอาร์ตเวิร์กแบรนด์เก่า
// (กล่องของขวัญ ถุงเงิน มงกุฎ ตราชั่ง ธนบัตร เสือ มังกร แมวกวัก ฯลฯ ตาม §1)
//
// Announcement รอบนี้หมุนมาเป็น Announcement5 ทั้งเว็บ (brand-spec §3 — รอบก่อนใช้
// Announcement2 จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็น
// คอปปี้ของแบรนด์นี้แล้ว จึงเรียกแบบ bare **ห้ามส่ง prop message**
// มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — ส่วนที่ไม่ใช่ชื่อแบรนด์ยาว 148 อักขระ จึงรับชื่อแบรนด์ได้ตั้งแต่ 2 ถึง 12
// ตัวอักษร รอบนี้ชื่อยาว 9 ตัวอักษร รวมเป็น 157 เป็นประโยคเดียวที่บอกว่าหน้านี้
// มีไว้ทำอะไร แล้วหยุด
// (Google ตัดราว 155 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนๆ ยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} รวมสิ่งที่ควรอ่านก่อนเลือกเกมสล็อต ทั้งระดับการเดิมพัน กติกา ตารางจ่ายรางวัล ค่า RTP ยอดฝากขั้นต่ำ วงเงินถอน และข้อกำหนดล่าสุดของเว็บไซต์`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ศึกษากติกา ตารางจ่ายรางวัล และระดับการเดิมพันก่อนเลือกเกมสล็อต`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#0d6b9b]">{BRAND_NAME} นำเสนอเกมสล็อตออนไลน์หลายรูปแบบ พร้อมข้อมูลอัตราจ่าย ระดับการเดิมพัน และโปรโมชั่นสำหรับสมาชิก</strong>
        หน้านี้รวบรวมไว้ว่าควรเปิดอ่านอะไรบ้างก่อนเลือกเกม ตั้งแต่ระดับการเดิมพันของแต่ละเกม ไปจนถึงกติกาและเงื่อนไขที่ต้องอ่านให้ครบก่อนทำรายการ
      </p>

      <p>
        ภายในเว็บไซต์มีรายละเอียดเกี่ยวกับการสมัครสมาชิก ช่องทางฝากถอน และการติดต่อเจ้าหน้าที่ให้ตรวจสอบก่อนใช้งาน
        <strong class="text-[#0d6b9b]">การไล่อ่านข้อมูลเหล่านี้ก่อนช่วยให้เข้าใจว่าแต่ละเกมกำหนดผลรางวัลและระดับการเดิมพันไว้อย่างไร</strong>
        ก่อนที่จะต้องตัดสินใจด้วยเงินของตัวเอง
      </p>

      <p>
        <strong class="text-[#0d6b9b]">ส่วนคำกล่าวอ้างเรื่องการปรับเรทแตกหนักที่สุดควรพิจารณาจากข้อมูลที่ตรวจสอบได้</strong>
        เนื่องจากผลลัพธ์ของเกมสล็อตมีความไม่แน่นอน และไม่มีเว็บไซต์ใดสามารถรับประกันการชนะในแต่ละรอบได้ เนื้อหาในหน้านี้จึงเขียนไว้ประกอบการใช้งานเท่านั้น
        ไม่ได้ใช้แทนเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้บริการ
      </p>
    </div>
