---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";

import { pageGraph } from "../lib/schema";

// MGM9 เป็นคาสิโนออนไลน์ครบวงจร (บาคาร่า / สล็อต / ฟุตบอล / หวย) หน้านี้จึงหมายถึง
// การทำความรู้จักระบบก่อนเดิมพันด้วยเครดิตจริง — หมวดเกม กติกา อัตราจ่าย ช่วงเดิมพัน
// ระบบฝากถอนวอลเลท/ธนาคาร และการเช็กประวัติรายการย้อนหลังในบัญชีสมาชิก
//
// แบรนด์เก่าเคยวางแกลเลอรี 12 การ์ด (gamedemo7..18.webp) ไว้ที่หน้านี้ ถูกถอดออกไปตั้งแต่
// เจ็ดรอบรีแบรนด์ก่อน และไม่มีการ import แล้ว — อย่านำกลับมา เหตุผลมีสองชั้น: ลำพังการ import
// ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดงถ้ามีรูปที่ไม่มีใคร render ทั้งชุด
// ยังเป็นภาพของ "askmeslot" ซึ่งเป็นโลโก้เว็บอื่น การนำกลับมาคือการโชว์แบรนด์คู่แข่ง
// บนหน้าเว็บของ MGM9
//
// ทุกข้อความอ้างอิง src/assets/content.txt เท่านั้น ไม่มีการอ้างใบอนุญาต การจดทะเบียน
// ปีที่ก่อตั้ง รางวัล จำนวนสมาชิก หรือการันตีผลกำไร
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 158
const pageDescription = "หน้าทดลองเล่นของ MGM9 แนะนำวิธีทำความคุ้นเคยกับระบบ ตั้งแต่สมัครสมาชิก ฝากถอน เลือกบาคาร่า สล็อต บอล หวย ไปจนถึงตรวจกติกาและอัตราจ่ายก่อนเดิมพันด้วยเครดิตจริง";

const graph = pageGraph(Astro, {
  name: "ทดลองเล่น MGM9 ทำความรู้จักระบบก่อนเดิมพันด้วยเครดิตจริง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title="ทดลองเล่น MGM9 ลองใช้ระบบบาคาร่า สล็อต บอล หวย ก่อนเดิมพันด้วยเครดิตจริง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่น MGM9 ทำความรู้จักระบบก่อนเดิมพันด้วยเครดิตจริง" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d3e6ff]">
        <strong class="text-[#9ad4ff]">MGM9</strong> รวมเกมเดิมพันออนไลน์หลายประเภทไว้ในระบบเดียว ทั้งบาคาร่า สล็อต ฟุตบอล และหวย
        รองรับทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์ หน้านี้จึงเปิดไว้ให้ผู้เริ่มต้นได้<strong class="text-[#9ad4ff]">ทำความคุ้นเคยกับขั้นตอนใช้งาน ตรวจกติกา อัตราจ่าย และช่วงเดิมพัน</strong>
        ก่อนยืนยันรายการด้วยเครดิตของตัวเอง เพราะเกม โต๊ะ และประเภทการเดิมพันแต่ละรายการกำหนดเงื่อนไขไว้ไม่เหมือนกัน
      </p>

      <p class="text-left text-base leading-relaxed text-[#d3e6ff]">
        ขอให้เข้าใจตรงกันว่าการทดลองเล่นเป็นการทำความคุ้นเคยกับระบบเท่านั้น
        <strong class="text-[#9ad4ff]">ผลของแต่ละรอบไม่แน่นอน ไม่มีเกมหรือสูตรใดรับประกันผลได้เสียล่วงหน้า</strong>
        หากติดปัญหาระหว่างใช้งาน แจ้งแอดมิน MGM9 ได้ตลอด 24 ชั่วโมง พร้อมชื่อเกม เวลา จำนวนเงิน และรายละเอียดของรายการ เพื่อให้ตรวจสอบได้ตรงจุด
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="ขั้นตอนเริ่มใช้งาน MGM9 ตั้งแต่สมัครสมาชิกจนถึงเลือกเกม" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d3e6ff]">
        ลำดับการใช้งานจริงมีอยู่ไม่กี่ขั้น และเป็นลำดับเดียวกันทุกหมวดเกม ลองไล่ดูให้ครบก่อนใช้เครดิตจริง จะช่วยให้เห็นว่ารายการหนึ่งถูกคิดผลมาจากอะไรบ้าง
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#d3e6ff]">
        <li class="flex gap-3"><span class="font-bold text-[#4aa4f4]">1.</span> เข้าหน้าสมัคร MGM9 และกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน ทำผ่านมือถือหรือคอมพิวเตอร์ได้โดยตรง</li>
        <li class="flex gap-3"><span class="font-bold text-[#4aa4f4]">2.</span> Login เข้าบัญชี แล้วเลือกช่องทางฝากเครดิตผ่านธนาคารหรือวอลเลทที่ระบบรองรับ</li>
        <li class="flex gap-3"><span class="font-bold text-[#4aa4f4]">3.</span> เลือกหมวดเกมที่ต้องการ ทั้งบาคาร่า เกมคาสิโนสด สล็อต ฟุตบอล หรือหวยออนไลน์</li>
        <li class="flex gap-3"><span class="font-bold text-[#4aa4f4]">4.</span> เปิดดูกติกา อัตราจ่าย และช่วงเดิมพันของเกมหรือโต๊ะนั้นก่อนตัดสินใจ</li>
        <li class="flex gap-3"><span class="font-bold text-[#4aa4f4]">5.</span> ระบุยอดเดิมพันที่รับได้ ยืนยันรายการ แล้วเก็บข้อมูลบิลไว้เช็กย้อนหลังในบัญชีสมาชิก</li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#a8c8ea]">
        ก่อนกดยืนยันควรทวนอีกครั้งว่าเลือกเกมและรายการเดิมพันถูกต้อง เพราะเป็นจุดที่ผิดพลาดได้ง่ายที่สุดเมื่อสลับไปมาระหว่างหลายหมวดเกมในบัญชีเดียว
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ตรวจกติกา อัตราจ่าย และช่วงเดิมพันก่อนยืนยันรายการ" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d3e6ff]">
        ข้อมูลที่ควรเปิดดูให้ครบก่อนลงเดิมพันมีอยู่ไม่กี่อย่าง และระบบแสดงไว้ให้ตรวจสอบได้จากบัญชีเดียวอยู่แล้ว
        <strong class="text-[#9ad4ff]">ตัวเลขชุดนี้คือสิ่งที่ใช้คิดผลของรายการ</strong> จึงควรอ่านให้จบก่อนตัดสินใจว่าจะลงเท่าไร
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#d3e6ff]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#4aa4f4]">📋</span>
          <span><strong class="text-[#9ad4ff]">กติกาของเกม</strong> บาคาร่า สล็อต ฟุตบอล และหวย ใช้กติกาคนละชุด ควรอ่านของหมวดที่กำลังจะเล่นเป็นหลัก</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#4aa4f4]">💹</span>
          <span><strong class="text-[#9ad4ff]">อัตราจ่าย</strong> ต่างกันตามรูปแบบเดิมพันที่เลือก ระบบแสดงไว้ก่อนยืนยันรายการเสมอ ให้ยึดค่าที่เห็นตอนนั้น</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#4aa4f4]">⏰</span>
          <span><strong class="text-[#9ad4ff]">ช่วงเดิมพันและเวลาเปิดรับ</strong> ต่างกันตามเกมและรายการ หวยออนไลน์กับฟุตบอลไม่ได้ปิดรับพร้อมโต๊ะคาสิโนสด</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#4aa4f4]">💰</span>
          <span><strong class="text-[#9ad4ff]">ยอดเดิมพัน</strong> ควรกำหนดล่วงหน้าเป็นหน่วยย่อย เช่น มีทุน 1,000 บาท ให้คิด 1 หน่วยเท่ากับ 10 บาท แล้ววางยอดต่อรายการให้อยู่ในระดับที่รับได้</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#a8c8ea]">
        สำหรับเงื่อนไข “ไม่อั้นจ่าย” และ “ไม่มีขั้นต่ำ” ให้ยึดวงเงินและข้อกำหนดที่ระบบแสดง ณ เวลาทำรายการเป็นหลัก
        เนื่องจากเกม โต๊ะ หรือประเภทการเดิมพันแต่ละรายการอาจกำหนดวงเงินแตกต่างกัน
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="เช็กประวัติรายการย้อนหลังและดูแลความปลอดภัยของบัญชีสมาชิก" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d3e6ff]">
        เมื่อยืนยันรายการสำเร็จ ระบบจะเก็บไว้ในประวัติของบัญชีสมาชิก ทำให้<strong class="text-[#9ad4ff]">ตรวจสอบเครดิต ประวัติธุรกรรม โปรโมชั่น และรายการเดิมพันย้อนหลังได้ด้วยตัวเอง</strong>
        ทั้งเกมที่เล่น ยอดที่ลง และอัตราจ่ายที่ใช้ตอนนั้น ควรเก็บข้อมูลไว้จนกว่าการตรวจสอบจะเสร็จสิ้น เผื่อต้องใช้เป็นหลักฐานให้เจ้าหน้าที่
      </p>

      <ul class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#d3e6ff]">
        <li class="flex gap-3">
          <span class="text-[#4aa4f4]" aria-hidden="true">•</span> หน้านี้อธิบายการใช้งานและการทำความคุ้นเคยกับระบบเท่านั้น การเดิมพันจริงต้องสมัครสมาชิกและฝากเครดิตผ่านช่องทางที่เปิดให้บริการก่อน
        </li>
        <li class="flex gap-3">
          <span class="text-[#4aa4f4]" aria-hidden="true">•</span> ตรวจสอบช่องทางวอลเลทและธนาคาร ยอดขั้นต่ำ และวงเงินต่อรายการล่าสุดบนหน้าฝากถอนก่อนยืนยันธุรกรรมทุกครั้ง
        </li>
        <li class="flex gap-3">
          <span class="text-[#4aa4f4]" aria-hidden="true">•</span> ตั้งจุดหยุดเมื่อเสียและจุดที่จะพักเมื่อได้กำไรไว้ตั้งแต่ก่อนเริ่ม แล้วหยุดตามแผน ไม่เพิ่มยอดเดิมพันเพื่อไล่เอาเงินคืน
        </li>
        <li class="flex gap-3">
          <span class="text-[#4aa4f4]" aria-hidden="true">•</span> <strong class="text-[#9ad4ff]">ตั้งรหัสผ่านที่คาดเดายากและไม่เปิดเผย OTP แก่บุคคลอื่น</strong> ไม่ว่าจะเป็นการติดต่อจากช่องทางใดก็ตาม
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#d3e6ff]">
        หากพบปัญหาสมัครสมาชิก Login ไม่ได้ ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง โปรโมชั่นไม่แสดง หรือเข้าเกมไม่ได้
        แจ้งแอดมิน MGM9 พร้อมเวลา จำนวนเงิน และรายละเอียดของรายการได้ตลอด 24 ชั่วโมง
        <strong class="text-[#9ad4ff]">การเดิมพันมีความเสี่ยง ควรกำหนดงบประมาณให้เหมาะสมทุกครั้ง</strong>
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก MGM9"
          class="flex items-center justify-center rounded-lg border border-[#4aa4f4]/70 bg-gradient-to-r from-[#9ad4ff] via-[#4aa4f4] to-[#1f74d6] px-8 py-3 font-black text-[#01102e] shadow-[0_0_15px_rgba(74,164,244,0.30)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ MGM9"
          class="flex items-center justify-center rounded-lg border border-[#4aa4f4]/60 bg-transparent px-8 py-3 font-bold text-[#9ad4ff] transition-all hover:scale-105 hover:border-[#9ad4ff] hover:bg-[#062a72]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>

  <Navfoot />
</MainLayout>
