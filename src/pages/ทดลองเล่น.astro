---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ (src/assets/content.txt) ไม่มีหมวด "ทดลองเล่น" และไม่มี
// ส่วน SUB-PAGES เลย ทั้งหน้าจึงเขียนขึ้นใหม่จากคลังคำของบรีฟรอบนี้ ไม่ใช่แก้ทับ
// ประโยคของแบรนด์ก่อน
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// 🚨 **ความต่างที่สำคัญที่สุดของรอบนี้กับรอบก่อน**: บรีฟรอบก่อนเป็นแบรนด์คนละหมวด
// โดยสิ้นเชิง และระบุหมวดเกมของตัวเองไว้สี่หมวด ส่วนบรีฟรอบนี้คือ **แฟนเพจเว็บบอล
// ยูฟ่า = เว็บกีฬา/ฟุตบอลล้วน** ศัพท์หมวดเกมทั้งสี่ของรอบก่อนจึงเป็น **คำค้างที่ต้อง
// ไม่เหลือแม้แต่คำเดียว** (รายการเต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้
// sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง) ทั้งหน้านี้เขียนใหม่หมด
// ไม่ใช่ find-and-replace ทับประโยคเดิม (ประโยคเดิม "ดูเข้าเค้า" เพราะโครงเหมือนกัน
// แต่กรอบของบรีฟคนละอันโดยสิ้นเชิง) และ ⚠️ **นี่ไม่ใช่เว็บหวยด้วย**
// สองหน้าหมวดลอตเตอรีจอดอยู่ใน src/pages-disabled/ ไม่มี route ห้ามลิงก์ไปหา
// เป็น href ตายที่ทำให้ build แดง route ที่มีจริงรอบนี้คือ
// / · /about-us · /contact-us · /login · /register · /privacy · /promotion ·
// /terms · /ทดลองเล่น · /ทางเข้า · /404 · /line
//
// กรอบของบรีฟรอบนี้คือ **อัปเดตข่าวสารฟุตบอล โปรแกรมแข่งขัน ผลการแข่งขัน และ
// แนวทางวิเคราะห์ก่อนเกม พร้อมรายละเอียดราคาบอล ค่าน้ำ โปรโมชั่น และช่องทางติดต่อ
// เจ้าหน้าที่ ไว้ในเว็บไซต์เดียว — ผู้ใช้งานควรตรวจสอบความถูกต้องของข่าวสารและ
// ราคาที่เปลี่ยนแปลงก่อนการแข่งขันทุกครั้ง** บวกโปรโมชั่นคืนยอดเสีย 0.3% กับ
// แนะนำเพื่อน 0.8% และช่องทางติดต่อเจ้าหน้าที่ 24ชม.
// (คำต้องห้ามไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive
// ในคอมเมนต์ของไฟล์นี้เอง — เต็มอยู่ใน brand-spec §6)
//
// 🚨 **บรีฟรอบนี้ไม่ได้ระบุชื่อผู้ให้บริการ/ค่ายใดแม้แต่รายเดียว** จึงห้ามเขียนชื่อใดๆ
// ⚠️ บรีฟรอบนี้ **ไม่ได้เอ่ยถึงใบอนุญาต ผู้กำกับดูแล นิติบุคคล ชื่อธนาคารเฉพาะราย
// ค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีก่อตั้ง** จึงห้ามพูดถึงทั้งหมด
// รายการเต็มอยู่ใน brand-spec §6 สิ่งที่บรีฟให้มาและอ้างได้คือ: ข่าวสารฟุตบอล ·
// ลีกและแมตช์ · โปรแกรมแข่งขัน · ผลการแข่งขัน · แนวทางวิเคราะห์ก่อนเกม · ราคาบอล ·
// ค่าน้ำ · ราคาต่อรอง · อัตราจ่าย · ผลงานย้อนหลัง · สถิติการพบกัน · ความพร้อมของ
// นักเตะ · ประเภทการเดิมพัน · ยอดที่ใช้คำนวณ · รอบคำนวณยอด · รอบเวลารับเครดิต ·
// วิธีรับเครดิต · ลิงก์แนะนำและการเชื่อมโยงบัญชี · การสมัครสมาชิกและข้อมูลส่วนบุคคล ·
// รหัสผ่าน · รหัส OTP · รายการฝากถอน · หลักฐานสำหรับการตรวจสอบ · ช่องทางทางการ
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามีโหมดทดลอง เครดิตทดลอง หรือเดโมฟรีเป็นบริการของเว็บ —
// จึงห้ามสัญญาสินค้าตัวนั้น คำว่า "ทดลองเล่น" บนหน้านี้จึงหมายถึงสิ่งที่บรีฟระบุไว้
// ตรงๆ ว่าทำได้: ไล่ดูข้อมูลฟุตบอลและขั้นตอนการใช้งานให้ครบหนึ่งรอบ ศึกษาเงื่อนไข
// ของแต่ละโปรโมชั่น และสอบถามเจ้าหน้าที่ ก่อนเข้าใช้งานจริง
//
// ⚠️ คำโฆษณาของบรีฟ ("การันตีค่าน้ำดี จ่ายสูงสุดในวงการ" · "รับได้ไม่จำกัดยูส")
// อยู่ได้เฉพาะในหัวข้อที่บรีฟเขียนไว้เอง (= หัวข้อของ index.astro) หน้านี้จึงไม่หยิบ
// มาเป็นหัวข้อ เพราะย่อหน้าของบรีฟเองหักล้างทันทีว่าค่าน้ำและอัตราจ่ายเปลี่ยนแปลงได้
// ตามช่วงเวลา และไม่มีเทคนิคใดรับประกันผลการแข่งขันหรือผลกำไรจากการเดิมพัน
//
// 🚨 **รอบนี้หน้านี้ไม่มีรูปเลย และนั่นตั้งใจ** — ดรอปนี้ (brand-spec §5) ไม่มี
// article illustration (ไม่มี banner2+) และ slide1/slide2 ถูกตรึงไว้กับ index กับ
// /promotion เท่านั้น ส่วน gamedemo*.webp ที่รอบก่อนใช้สองใบเป็น **อาร์ตสต็อกของ
// เทมเพลตในหมวดอื่น** (ตัวการ์ตูน ชิปวงกลม สัญลักษณ์ไพ่ ลานนีออนชมพู-ฟ้า) ซึ่งขัด
// ทั้งแกนแบรนด์ฟุตบอลของรอบนี้และพาเลตต์ทอง-ดำ จึงถอด import ออกทั้งสองใบ
// **ไฟล์ยังอยู่บนดิสก์ ห้ามลบ เป็นอินเวนทอรีของแบรนด์หมวดนั้นรอบถัดไป** — แค่ห้าม
// import (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดงถ้า
// ไม่ถูก render) banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ·
// banner2/banner3 และ slide3/slide4 เป็นอาร์ตเวิร์กของแบรนด์คนละราย (slide3/slide4
// เป็นโปสเตอร์ของ LOTTOPLUS) ห้าม import
//
// ⚠️ ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 24ชม. · 3 ขั้นตอน ส่วนตัวเลข
// และชื่อเฉพาะที่ห้ามแต่งขึ้นเองอยู่ครบใน brand-spec §6
//
// 🚨 ประโยคกำกับความเสี่ยงของบรีฟที่ห้ามตัดทิ้ง (เป็นเนื้อหาของบรีฟ ไม่ใช่ filler)
// และห้ามเขียนเสริมให้กลายเป็นคำโฆษณาที่บรีฟกำลังเตือนเรื่องนั้นอยู่:
// ควรตรวจสอบความถูกต้องของข่าวสารและราคาที่เปลี่ยนแปลงก่อนการแข่งขันทุกครั้ง ·
// ค่าน้ำและอัตราจ่ายสามารถเปลี่ยนแปลงได้ตามช่วงเวลา จึงควรตรวจสอบราคาจริงก่อนทำ
// รายการ · ไม่มีเทคนิคใดรับประกันผลการแข่งขันหรือผลกำไรจากการเดิมพัน ·
// เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือช่วยรับประกัน
// ผลตอบแทนในอนาคต · แม้โปรโมชั่นจะระบุว่าไม่จำกัด แต่ควรตรวจสอบจำนวนบัญชีที่เข้าร่วมได้
// รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุด · ตรวจสอบช่องทางติดต่อจาก
// เว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีหรือบุคคลที่แอบอ้างชื่อบริการ ·
// ไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น · ควรตรวจสอบเวลาการให้บริการและ
// ระยะเวลาตอบกลับล่าสุดจากช่องทางทางการอีกครั้ง
//
// Announcement รอบนี้หมุนมาเป็น Announcement3 ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ AnnouncementPremium จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้น
// เป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นข้อความ
// ตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ทองสองเฉดนำ (อำพันน้ำผึ้ง + เลมอนสว่าง) ·
// บรอนซ์เป็นฮิวที่สาม · เงาบรอนซ์ไหม้ไม่เคยถือตัวอักษร · บนพื้นดำสนิท** และรอบนี้
// **ไม่มีสีที่สองที่เป็นคนละวงศ์เลย** (รอบก่อนแดงเป็นฮิวที่สอง — รอบนี้ไม่มีแดง)
// ⚠️ **ทองเคยนำมาแล้วเกือบทุกแบรนด์** "มีทองอยู่" จึงไม่ใช่ตัวบอกว่าถูกแบรนด์
// ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน brand-spec §2 (ค่าเดิมไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive) ทองรอบนี้คือ **#d4922c**
// (+#fdfc71 เลมอน +#f6e3b4 ครีมทอง +#a25b24 บรอนซ์ +#5a3310 เงาบรอนซ์ไหม้)
// ลำดับความลึก: #33200a ผิวยก (= การ์ด) / #1f1304 กลาง / #0a0601 จม / #000000 พื้นเพจ
// ลำดับปุ่มสื่อด้วยขั้ว "พื้นทองตัน vs กรอบทองโปร่ง vs ผิวจมขอบบรอนซ์":
// ปุ่มสมัครสมาชิกถมไล่เฉด #fdfc71 → #d4922c ขอบ #a25b24 หมึก #1a1000
// (17.3:1 บนปลายเลมอน · 7.1:1 บนปลายทอง) · ปุ่มเข้าสู่ระบบเป็นกรอบทองโปร่ง
// พื้นผิวจม #1f1304 → #0a0601 ขอบ #d4922c/80 ตัวอักษร #d4922c (7.6:1 บนผิวจม) ·
// ปุ่มลิงก์ภายในเป็นผิวจมขอบบรอนซ์ #a25b24/70 ตัวอักษร #fbf6e3 และ hover ยกขอบ
// เป็นทอง · marker ของลำดับเลขใช้ครีมทอง #f6e3b4 (12.3:1 บนผิวการ์ด — เป็นตัวอักษร
// จึงใช้บรอนซ์ไม่ได้เด็ดขาด และ #d4922c สงวนไว้ให้ <strong> เท่านั้น)
// 🚨 **บรอนซ์ #a25b24 ได้แค่ 3.0:1 บนผิวการ์ด (4.06:1 บนพื้นดำ) = ตก AA ทุกพื้น**
// จึงเป็น **สีขอบ/พื้นถม/ไอคอนเท่านั้น ห้ามถือตัวอักษรทุกขนาด** ถ้าต้องมีตัวอักษร
// บนบรอนซ์ ให้ถมบรอนซ์เป็นพื้นแล้ววาง #fbf6e3 ทับ (4.78:1 ผ่าน AA)
// ⚠️ ห้ามกลับด้าน: พื้นถมทอง/เลมอนต้องใช้หมึกเข้ม #1a1000 เสมอ ห้ามขาวหรือครีม และ
// #5a3310 #1a1000 เป็นเส้น ขอบ ออรา และพื้นถมเท่านั้น ห้ามถือตัวอักษรบนพื้นเข้ม
// ออราในไฟล์นี้ใช้ rgba(212,146,44,α) · rgba(253,252,113,α) เท่านั้น · รอบนี้ไม่มี
// แดง ไม่มีฟ้า/น้ำเงิน ไม่มีม่วง ไม่มีเขียว (นอกจาก LINE) ไม่มีเงิน/โครเมียม
// ไม่มีโรสโกลด์ ไม่มีชมพู/ฟูเชีย และไม่มีส้มสด — บรอนซ์ #a25b24 เป็นเฉดเงาของทอง
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #fbf6e3)
// ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง ปล่อยให้สืบทอดลงมา
// และไม่ใส่ mx-auto / max-w-* บน <p> — มีแค่ปุ่ม marker ของลำดับเลข และ <strong>
// ที่ประกาศสี โดย <strong> ใช้ทองอำพัน #d4922c ตัวเดียว (5.87:1 บนผิวการ์ด)
// และแต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรค
// ระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง
// และห้ามวาง <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังในข้อความของป้ายชื่อ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 154 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} หน้ารวมวิธีไล่ดูข้อมูลโปรแกรมแข่งขัน ผลการแข่งขัน ราคาบอล และค่าน้ำ พร้อมเงื่อนไขโปรโมชั่น ให้ครบก่อนตัดสินใจสมัครสมาชิกและใช้งานจริง`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ไล่ดูโปรแกรมแข่งขัน ราคาบอล และค่าน้ำก่อนเข้าใช้งานจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#d4922c]">{BRAND_NAME} รวบรวมข่าวสารฟุตบอล โปรแกรมแข่งขัน ผลการแข่งขัน และแนวทางวิเคราะห์ก่อนเกม ไว้ในเว็บไซต์เดียว</strong>
        พร้อมเมนูสมัครสมาชิก เข้าสู่ระบบ ฝากถอน และตรวจสอบโปรโมชั่น หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับระบบได้ไล่ดูให้ครบหนึ่งรอบก่อนเข้าใช้งานจริง ตั้งแต่ลีกและแมตช์ที่เปิดให้ติดตาม
        ไปจนถึงราคาบอล ค่าน้ำ และอัตราจ่ายของแต่ละรายการ
      </p>

      <p>
        คำว่า ทดลองเล่น ที่หน้านี้พูดถึงจึงหมายถึง
        <strong class="text-[#d4922c]">การศึกษาข้อมูลฟุตบอลและเงื่อนไขบริการก่อนเริ่มต้นทำรายการ</strong>
        ไม่ใช่การแจกเครดิตทดลอง และไม่มีเทคนิคใดรับประกันผลการแข่งขันหรือผลกำไรจากการเดิมพัน หากพบข้อสงสัยระหว่างใช้งานสามารถสอบถามเจ้าหน้าที่ผ่านช่องทางทางการได้
      </p>

      <p>
        อีกเรื่องที่ควรไล่ดูไปพร้อมกันคือข้อกำหนดการเปิดบัญชีสมาชิกและการใช้ข้อมูลส่วนบุคคล รวมถึงรายละเอียดของโปรโมชั่นที่กำลังสนใจ
        <strong class="text-[#d4922c]">เพราะค่าน้ำและอัตราจ่ายสามารถเปลี่ยนแปลงได้ตามช่วงเวลา จึงควรตรวจสอบราคาจริงก่อนทำรายการทุกครั้ง</strong>
        การอ่านให้ครบตั้งแต่ก่อนเริ่มจึงช่วยให้ทราบว่าแต่ละรายการมีเงื่อนไขอย่างไร และจะได้รับเครดิตในรอบเวลาใด
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ไล่ดูโปรแกรมแข่งขัน ราคาบอล และค่าน้ำให้ครบก่อนเลือกแมตช์ที่สนใจ" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        หลังเข้าสู่ระบบ ลำดับการไล่ดูจะเป็นชุดเดียวกันทุกครั้ง
        <strong class="text-[#d4922c]">เปิดโปรแกรมแข่งขันของลีกที่สนใจ ดูว่าแมตช์นั้นเปิดให้ติดตามจริงไหม แล้วจึงอ่านราคาบอล ค่าน้ำ และอัตราจ่ายของคู่นั้นต่อ</strong>
        จากนั้นค่อยไล่ดูผลการแข่งขันย้อนหลังกับแนวทางวิเคราะห์ก่อนเกมประกอบ ทั้งผลงานย้อนหลัง สถิติการพบกัน และความพร้อมของนักเตะ การไล่ดูให้ครบหนึ่งรอบก่อนจึงช่วยให้สอบถามเจ้าหน้าที่ได้ตรงประเด็นเมื่อมีข้อสงสัย
      </p>

      <ul class="flex flex-col gap-3" aria-label="จุดที่ควรไล่ดูให้ครบก่อนเข้าใช้งานจริง">
        <li class="flex gap-3">
          <span aria-hidden="true">⚽</span>
          <span>
            <strong class="text-[#d4922c]">โปรแกรมแข่งขันและลีกที่เปิดให้ติดตาม</strong> ควรเปิดดูจากหน้าเว็บไซต์ทางการว่าช่วงเวลานั้นมีแมตช์ใดเปิดให้ติดตามบ้าง เนื่องจากรายการแข่งขันในแต่ละสัปดาห์เปลี่ยนแปลงได้ตามปฏิทินของแต่ละลีก
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">📊</span>
          <span>
            <strong class="text-[#d4922c]">ราคาบอล ค่าน้ำ และอัตราจ่าย</strong> ควรเปิดอ่านเป็นรายแมตช์ก่อนทำรายการ เพราะราคาต่อรองของแต่ละคู่กำหนดไว้ไม่เหมือนกัน และค่าน้ำกับอัตราจ่ายสามารถเปลี่ยนแปลงได้ตามช่วงเวลา จึงควรตรวจสอบราคาจริงอีกครั้งก่อนยืนยัน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">📅</span>
          <span>
            <strong class="text-[#d4922c]">ผลการแข่งขันและแนวทางวิเคราะห์ก่อนเกม</strong> ควรดูควบคู่กับผลงานย้อนหลัง สถิติการพบกัน และความพร้อมของนักเตะ เพื่อให้เข้าใจที่มาของราคาบอลมากขึ้น โดยข้อมูลเหล่านี้เป็นข้อมูลประกอบการตัดสินใจ ไม่ใช่สิ่งที่รับประกันผลการแข่งขัน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">💬</span>
          <span>
            <strong class="text-[#d4922c]">ข้อมูลช่องทางติดต่อเจ้าหน้าที่</strong> ควรรู้ไว้ตั้งแต่ก่อนเริ่มว่าช่องทางทางการที่เว็บไซต์ระบุไว้อยู่ตรงไหน และควรตรวจสอบเวลาการให้บริการกับระยะเวลาตอบกลับล่าสุดอีกครั้ง
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#d4922c]">สิ่งที่การไล่ดูช่วยได้คือทำให้รู้ว่าข้อมูลและเงื่อนไขอยู่ตรงไหนเท่านั้น</strong>
        ไม่ได้เป็นการรับประกันผลการแข่งขันหรือยอดเครดิตที่จะได้รับ รายละเอียดที่เว็บไซต์แสดงอยู่ขณะใช้งานจึงเป็นสิ่งที่ควรยึดเป็นหลัก และควรตรวจสอบความถูกต้องของข่าวสารกับราคาที่เปลี่ยนแปลงก่อนการแข่งขันทุกครั้ง
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/about-us"
          aria-label={`อ่านหน้าเกี่ยวกับเราของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#a25b24]/70 bg-gradient-to-b from-[#1f1304] to-[#0a0601] px-8 py-3 font-bold text-[#fbf6e3] shadow-[0_0_12px_rgba(162,91,36,0.45)] transition-all hover:scale-105 hover:border-[#d4922c] hover:shadow-[0_0_18px_rgba(212,146,44,0.4)]">
          อ่านเกี่ยวกับเรา
        </a>

        <a
          href="/promotion"
          aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#a25b24]/70 bg-gradient-to-b from-[#1f1304] to-[#0a0601] px-8 py-3 font-bold text-[#fbf6e3] shadow-[0_0_12px_rgba(162,91,36,0.45)] transition-all hover:scale-105 hover:border-[#d4922c] hover:shadow-[0_0_18px_rgba(212,146,44,0.4)]">
          ดูภาพโปรโมชั่น
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="สิ่งที่ควรตรวจสอบให้ครบก่อนสมัครสมาชิกและเข้าสู่ระบบ" as="h2">
    <div class="flex flex-col gap-5">
      <p>
        การไล่ดูระบบมีประโยชน์ที่สุดเมื่อมองว่าเป็นการอ่านรายละเอียดให้จบก่อน
        <strong class="text-[#d4922c]">เป้าหมายคือรู้ว่าเว็บไซต์รวบรวมอะไรไว้ให้ศึกษาบ้าง แต่ละรายการมีเงื่อนไขอย่างไร และสอบถามเจ้าหน้าที่ได้ทางไหนเมื่อมีข้อสงสัย</strong>
        รายการด้านล่างคือชุดที่ควรตรวจก่อนลงทะเบียน และควรตรวจซ้ำทุกครั้งที่กลับเข้ามาใหม่ เพราะเงื่อนไขปรับเปลี่ยนได้ตามที่เว็บไซต์กำหนด
      </p>

      <ol class="ml-6 list-decimal space-y-3 marker:font-black marker:text-[#f6e3b4]">
        <li>
          <strong class="text-[#d4922c]">ที่อยู่เว็บไซต์ทางการ</strong> ควรตรวจสอบให้ถูกต้องก่อนเลือกเมนูสมัครสมาชิกหรือกรอกข้อมูลใด ๆ ไม่ใช่เปิดจากลิงก์ที่ส่งต่อกันมา และควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ
          เพื่อหลีกเลี่ยงบัญชีหรือบุคคลที่แอบอ้างชื่อบริการ
        </li>
        <li>
          <strong class="text-[#d4922c]">ข้อกำหนดการเปิดบัญชีสมาชิก</strong> ควรอ่านให้ครบถ้วนก่อนสมัคร ทั้งคุณสมบัติผู้สมัคร อายุที่ได้รับอนุญาต และนโยบายการจัดเก็บข้อมูลส่วนบุคคล แล้วจึงกรอกข้อมูลตามที่ระบบกำหนดและตรวจสอบความถูกต้องก่อนยืนยันการลงทะเบียน
        </li>
        <li>
          <strong class="text-[#d4922c]">ราคาบอลและประเภทการเดิมพันที่เปิดให้ใช้งาน</strong> ควรเปิดอ่านเป็นรายแมตช์ก่อนเข้าใช้งาน เพราะแต่ละคู่กำหนดราคาต่อรองและอัตราจ่ายไว้ไม่เหมือนกัน และควรอ่านค่าน้ำไปพร้อมกัน
        </li>
        <li>
          <strong class="text-[#d4922c]">เมนูฝากถอนและรายการที่ทำได้จริง</strong> ควรเปิดดูขั้นตอนทำรายการฝากถอนที่เว็บไซต์ระบุไว้ รวมถึงระยะเวลาดำเนินการ ก่อนเริ่มทำรายการจริงครั้งแรก
        </li>
        <li>
          <strong class="text-[#d4922c]">ข้อมูลที่จะส่งให้เจ้าหน้าที่ตรวจสอบ</strong> ควรตั้งรหัสผ่านที่ปลอดภัย ไม่ใช้ข้อมูลของบุคคลอื่นในการลงทะเบียน และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น แม้จะอ้างว่าเป็นเจ้าหน้าที่ก็ตาม
        </li>
      </ol>

      <p>
        <strong class="text-[#d4922c]">การอ่านให้ครบตั้งแต่ก่อนเริ่มช่วยให้แจ้งเรื่องได้ตรงประเด็นเมื่อเกิดปัญหาขึ้นจริง</strong>
        หากพบปัญหาในการทำรายการ ควรเตรียมข้อมูลและหลักฐานที่เกี่ยวข้องไว้สำหรับการตรวจสอบ พร้อมแจ้งรายละเอียดให้ชัดเจนเมื่อติดต่อเจ้าหน้าที่ผ่านช่องทางทางการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`โปรโมชั่นและช่องทางติดต่อแอดมิน ${BRAND_NAME} ตลอด 24ชม.`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        เมื่อคุ้นเคยกับขั้นตอนการใช้งานแล้ว เรื่องถัดไปคือรายการโปรโมชั่นที่เว็บไซต์ระบุไว้ ซึ่งมีทั้ง
        <strong class="text-[#d4922c]">คืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อน โบนัส 0.8% ไม่จำกัด</strong>
        โดยรายการแรกระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขในแต่ละวัน จึงควรตรวจสอบว่ารายการเดิมพันฟุตบอลประเภทใดเข้าร่วมรายการบ้าง มีรอบคำนวณยอดเมื่อใด และเครดิตจะเข้าบัญชีอัตโนมัติหรือต้องกดรับเอง รวมถึงอ่านเงื่อนไขการใช้เครดิตและการถอนเงินให้ครบถ้วน
        ทั้งนี้ เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือช่วยรับประกันผลตอบแทนในอนาคต
      </p>

      <p>
        ส่วนรายการแนะนำเพื่อนควรศึกษาวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และหลักเกณฑ์การคำนวณโบนัสให้ครบถ้วนก่อนเข้าร่วม แม้โปรโมชั่นจะระบุว่าไม่จำกัด
        แต่ควรตรวจสอบจำนวนบัญชีที่เข้าร่วมได้ รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุดให้ชัดเจน
        <strong class="text-[#d4922c]">หากมีข้อสงสัยสามารถติดต่อเจ้าหน้าที่ผ่านช่องทางทางการเพื่อสอบถามรายละเอียดเพิ่มเติมได้</strong>
        โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่นไม่ว่ากรณีใด
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#a25b24] bg-gradient-to-b from-[#fdfc71] to-[#d4922c] px-8 py-3 font-black text-[#1a1000] shadow-[0_0_14px_rgba(212,146,44,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#d4922c]/80 bg-gradient-to-b from-[#1f1304] to-[#0a0601] px-8 py-3 font-bold text-[#d4922c] shadow-[0_0_12px_rgba(212,146,44,0.4)] transition-all hover:scale-105 hover:border-[#fdfc71]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
