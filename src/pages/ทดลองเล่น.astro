---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";

import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อของ docx
// ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่
// บนข้อเท็จจริงของ 365LOTTO เท่านั้น
//
// บรีฟรอบนี้ (ดรอป 2026-09-24) คือ "365LOTTO หวยคาสิโนในเว็บเดียว หวย บาคาร่า
// ไพ่ สล็อต เดิมพันครบวงจร" — แบรนด์นี้นำด้วย **หวย** แล้วมีคาสิโนอยู่ในระบบเดียวกัน
// คอปปี้ของแบรนด์รอบก่อน (SAGAME66 ที่นำด้วย "บาคาร่า รูเล็ต คาสิโนสด" และพูดถึง
// "หลายค่ายในระบบเดียว") ถูกเขียนใหม่ทั้งหน้าแล้ว เพราะบรีฟของ 365LOTTO ไม่ได้
// พูดถึงรูเล็ต ไม่ได้พูดถึงชื่อค่าย และมีหวยเป็นบริการหลัก ห้ามใช้ find-and-replace
// กับหน้านี้ มันจะทำให้ 365LOTTO อ้างเกมที่บรีฟไม่เคยระบุ
//
// บรีฟไม่ได้ระบุว่ามี "เครดิตทดลอง" หรือโหมดเดโมที่ถอนไม่ได้ สิ่งที่บรีฟระบุคือ
// "เมนูที่จัดหมวดชัดเจน ช่วยให้เข้าถึงรายการต่าง ๆ ได้สะดวกมากขึ้น" และ
// "ตรวจสอบเลข รอบเวลา และรายละเอียดของรายการก่อนยืนยัน" — หน้านี้จึงเขียนบนฐานนั้น
// คือการไล่ดูระบบและรายละเอียดให้ครบก่อนเดิมพันด้วยเงินจริง ห้ามกลับไปอ้างกติกา
// ของเครดิตทดลองหรือโหมดเล่นฟรี
//
// ข้อเท็จจริงทุกบรรทัดมาจากบรีฟรอบนี้เท่านั้น: หวยรัฐบาลไทย · หวยฮานอย ·
// ลาวพัฒนา · แยกรอบเปิดรับของแต่ละประเภทชัดเจน · ตรวจสอบเลข รอบเวลา และ
// รายละเอียดก่อนยืนยัน · เลข 2 ตัวอัตราจ่าย 100 · เลข 3 ตัวอัตราจ่าย 1,000 ·
// บาคาร่า ไพ่ สล็อต และเกมรูปแบบอื่นตามรายการที่เปิดให้บริการ · บัญชีเดียว ·
// เมนูจัดหมวดชัดเจน · รองรับทั้งมือถือและคอมพิวเตอร์ · โบนัสแนะนำเพื่อน 0.8% ·
// โบนัสคืนยอดเสีย 0.3% · สมัครผ่านมือถือ 3 ขั้นตอน · แอดมินดูแลตลอด 24 ชั่วโมง
// — ห้ามอ้างชื่อค่ายเกม เลขใบอนุญาต ปีที่ก่อตั้ง จำนวนสมาชิก ค่า RTP อัตราจ่าย
// อื่นนอกจาก 100/1,000 ขั้นต่ำการเดิมพัน "ฝากถอนออโต้ไม่มีขั้นต่ำ" "ปลอดภัย 100%"
// หรือการันตีว่าจะถูกรางวัล
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: แกลเลอรีเดโม 12 การ์ด (gamedemo7..18.webp) ยังอยู่
// บนดิสก์แต่เป็นของแบรนด์อื่น (mtime 2026-08-04 ไม่ใช่ดรอปรอบนี้) — gamedemo7.webp
// มีโลโก้ "askmeslot" และ gamedemo15.webp มีโลโก้ "askmebet" ของเว็บเจ้าอื่น
// พิมพ์ทับอยู่ในรูป ส่วน gamedemo13.webp เป็นการ์ด "Sexy Slot" ภาพโป๊เปลือย
// ห้ามนำกลับมา import เด็ดขาด (ห้ามลบไฟล์ เป็นอินเวนทอรี) ลำพังการ import ก็ทำให้
// ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง
// slide1.png / slide2.png ของดรอปนี้เป็นของ index และ /promotion — ไม่ดึงมาใช้ซ้ำที่นี่
// banner1/banner1-mobile เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า และ
// banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กค้างของลูกค้าเจ้าอื่น ห้าม import
//
// ห้ามลิงก์ไป /ตรวจหวย หรือ /แนวทาง รอบนี้ทั้งสองหน้าถูกพักไว้ใน src/pages-disabled/
// การลิงก์ไปเส้นทางที่ไม่มีจริงทำให้ verify-build แดง
//
// Announcement รอบนี้หมุนมาใช้ AnnouncementHuay ทั้งเว็บ — default message ของ
// ไฟล์นั้นเป็นคอปปี้ของ 365LOTTO อยู่แล้ว จึงเรียกแบบ bare เหมือน index.astro
// ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ 365LOTTO (แดงเข้ม + ทองสว่าง + เงินโครเมียม บนพื้นแดงเกือบดำ แทนทองอุ่น-
// น้ำตาลของ SAGAME66 รอบก่อน): พื้นเกือบดำ #120406 · การ์ด #1a0709 · การ์ดยก
// #33100f · ทองลึก #9c6a12 · ทองหลัก #fadc64 · ทองสว่าง #ffe9a3 · แดงสด #e01f26 ·
// เงินโครเมียม #f3f6fa ใช้กับชื่อแบรนด์และข้อความเน้น · เนื้อความ #f0ddc4
// (BRAND_TEXT) · ตัวอักษรบนปุ่มไล่สีทองใช้หมึก #120406 เพื่อให้อ่านออก ·
// ตัวเลข (100 / 1,000 / 0.8% / 0.3%) ใช้ทองสว่าง #ffe9a3 เท่านั้น
// — ทองอุ่นและน้ำตาลของแบรนด์รอบก่อน (#e8b93f/#96671a/#0d0903/#171006/#2a1d0b/
// #e3d8c0/#eef3f8) รวมถึงเงินกลาง #b6c1cd ถูกถอดออกหมดแล้ว ห้ามนำกลับมา
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 156
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "ทดลองเล่น 365LOTTO ไล่ดูเมนูหวยรัฐบาลไทย ฮานอย ลาวพัฒนา พร้อมบาคาร่า ไพ่ สล็อต และวิธีตรวจสอบรอบเวลา อัตราจ่าย และรายละเอียดบิลให้ครบก่อนเดิมพันด้วยเงินจริง";

const pageTitle = "ทดลองเล่น 365LOTTO ไล่ดูหวยและเกมคาสิโนทั้งระบบก่อนเดิมพันด้วยเงินจริง";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f0ddc4]">
        <strong class="text-[#f3f6fa]">365LOTTO</strong> รวมหวยรัฐบาลไทย หวยฮานอย ลาวพัฒนา พร้อมบาคาร่า ไพ่ สล็อต และเกมรูปแบบอื่นตามรายการที่เปิดให้บริการไว้ในระบบเดียว หน้านี้จึงเปิดไว้ให้คนที่ยังไม่คุ้นกับระบบได้
        <strong class="text-[#f3f6fa]">ไล่ดูหมวดที่เปิดให้ใช้งาน เปิดดูรอบเวลาและรายละเอียดของแต่ละรายการ และทำความเข้าใจเมนูให้ครบก่อนเดิมพันด้วยเงินจริง</strong>
        ตั้งแต่โครงของหน้าหลัก ไปจนถึงข้อมูลที่ระบบแสดงไว้ในแต่ละหมวด
      </p>

      <p class="text-left text-base leading-relaxed text-[#f0ddc4]">
        เพราะเมนู<strong class="text-[#f3f6fa]">จัดหมวดหมู่ไว้ชัดเจนและเลือกได้จากบัญชีเดียว</strong>
        การเปิดดูให้ทั่วก่อนจึงช่วยให้เห็นว่าหมวดไหนอยู่ตรงไหน และรู้ล่วงหน้าว่าต้องดูข้อมูลอะไรบ้างก่อนกดยืนยันบิลหรือเข้าเล่นครั้งแรก ทั้งเมื่อเปิดจากมือถือและจากคอมพิวเตอร์
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ไล่ดูหวยรัฐบาลไทย ฮานอย ลาวพัฒนา และเกมคาสิโนได้จากบัญชีเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f0ddc4]">
        จุดที่ช่วยให้ไล่ดูรายการได้เร็วที่สุดคือ<strong class="text-[#f3f6fa]">ทั้งหวยและหมวดเกมถูกรวมไว้ในบัญชีเดียว</strong>
        สมาชิกเลือกประเภทหวยที่สนใจได้จากหน้ารวมหวย และสลับไปดูบาคาร่า ไพ่ หรือสล็อตได้จากเมนูเดียวกัน ไม่ต้องสมัครแยกหรือเปลี่ยนไปใช้หลายเว็บไซต์เพื่อไล่หาว่ารายการที่อยากเล่นอยู่ที่ไหน
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#f0ddc4]">
        <li class="flex gap-3">
          <span class="font-bold text-[#fadc64]">1.</span>
          <span><strong class="text-[#f3f6fa]">เปิดหน้าหลักของ 365LOTTO ก่อน</strong> เมนูจัดหมวดหมู่ไว้ให้เลือกจากหน้าเดียว จึงเห็นภาพรวมของหมวดที่เปิดให้เลือกได้ตั้งแต่หน้าแรก</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#fadc64]">2.</span>
          <span>
            <strong class="text-[#f3f6fa]">ไล่ดูรายการหวยที่เปิดรับในรอบนั้น</strong> ทั้งรัฐบาลไทย หวยฮานอย และลาวพัฒนา แต่ละประเภทแยกรอบเปิดรับไว้ชัดเจน จึงดูได้ตั้งแต่ต้นว่ารอบไหนกำลังเปิดอยู่
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#fadc64]">3.</span>
          <span>
            <strong class="text-[#f3f6fa]">เปิดดูอัตราจ่ายของประเภทที่สนใจ</strong> ระบบระบุเลข 2 ตัวไว้ที่ <span class="text-[#ffe9a3]">100</span> และเลข 3 ตัวไว้ที่ <span class="text-[#ffe9a3]">1,000</span> ตามเงื่อนไขของรายการ อ่านให้จบก่อนตัดสินใจว่าจะซื้อแบบไหน
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#fadc64]">4.</span>
          <span>
            <strong class="text-[#f3f6fa]">ลองสลับไปดูหมวดเกมอื่นด้วยบัญชีเดิม</strong> ทั้งบาคาร่า ไพ่ สล็อต และเกมรูปแบบอื่นตามรายการที่เปิดให้บริการ การสลับหมวดทำได้จากเมนูเดียวกัน จึงไม่ต้องออกไปเปิดเว็บไซต์อื่นระหว่างเปรียบเทียบ
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#fadc64]">5.</span>
          <span>
            <strong class="text-[#f3f6fa]">ทวนข้อมูลอีกครั้งก่อนยืนยันด้วยเงินจริง</strong> ทั้งประเภทหวย ชุดตัวเลขที่กรอก รอบเวลาของรายการ และรายละเอียดของบิล ขั้นตอนนี้คือจุดที่ลดความผิดพลาดได้มากที่สุด
          </span>
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#f0ddc4]">
        <strong class="text-[#f3f6fa]">รอบที่เปิดรับและรายการเกมที่ใช้งานได้เปลี่ยนแปลงตามช่วงเวลา จึงควรตรวจสอบประเภทหวย รอบเวลา และรายการล่าสุดจากหน้าเว็บไซต์ทุกครั้งก่อนทำรายการ</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title="จุดที่ควรดูให้ครบก่อนเดิมพันด้วยเงินจริง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f0ddc4]">
        การไล่ดูระบบมีประโยชน์ที่สุดเมื่อมองมันเหมือนการอ่านคู่มือ ไม่ใช่การลุ้นรางวัล
        <strong class="text-[#f3f6fa]">เป้าหมายคือรู้จักระบบให้ครบก่อนที่เงินจริงจะเข้ามาเกี่ยวข้อง</strong>
        ห้าเรื่องด้านล่างคือสิ่งที่ควรเก็บข้อมูลไว้ระหว่างเปิดดู
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f0ddc4]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fadc64]">🗂️</span>
          <span>
            <strong class="text-[#f3f6fa]">โครงของหน้าหลักและตำแหน่งของแต่ละหมวดในเมนู</strong> จำให้ได้ว่าหน้ารวมหวยอยู่ตรงไหน หมวดเกมอยู่ตรงไหน และสลับระหว่างกันได้จากจุดใด จะได้ไม่ต้องหาใหม่ทุกครั้งที่อยากเปลี่ยนรายการ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fadc64]">🎫</span>
          <span>
            <strong class="text-[#f3f6fa]">รอบเปิดรับของหวยแต่ละประเภท</strong> รัฐบาลไทย หวยฮานอย และลาวพัฒนาแยกรอบของตัวเองไว้ชัดเจน ลองเปิดดูให้ครบก่อนว่ารอบไหนเปิดเวลาใด จะได้วางแผนได้ว่าจะติดตามประเภทไหนบ้างในแต่ละวัน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fadc64]">🎴</span>
          <span>
            <strong class="text-[#f3f6fa]">หมวดเกมที่เลือกได้จากบัญชีเดียวกับหวย</strong> ทั้งบาคาร่า ไพ่ สล็อต และเกมรูปแบบอื่นตามรายการที่เปิดให้บริการ ลองเปิดดูให้ครบก่อน จะได้รู้ว่าแนวไหนเหมาะกับตัวเองที่สุดโดยไม่ต้องสมัครเพิ่ม
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fadc64]">🎁</span>
          <span>
            <strong class="text-[#f3f6fa]">เงื่อนไขของโปรโมชั่นที่จะกดรับ</strong> ทั้งโบนัสแนะนำเพื่อน <strong class="text-[#ffe9a3]">0.8%</strong> และโบนัสคืนยอดเสีย <strong class="text-[#ffe9a3]">0.3%</strong>
            มีรอบคำนวณและข้อกำหนดต่างกัน ควรเปิดดูรายละเอียดของแต่ละรายการจากหน้าโปรโมชั่นก่อนกดรับ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fadc64]">📱</span>
