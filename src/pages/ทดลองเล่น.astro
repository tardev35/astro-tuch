---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login, /register)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริง
// ของ CK268 เท่านั้น
//
// CK268 เป็น **เว็บเกมสล็อตออนไลน์** ที่รวมเกมจากหลายค่ายไว้ผ่านบัญชีเดียว
// ส่วนแบรนด์ก่อนหน้า (GOT777) ขายเกมแจ็กพอต สล็อตธีมเอเชีย และเกมผจญภัย ซึ่ง
// บรีฟรอบนี้ไม่ได้พูดถึงเลยสักคำ จึงถอดออกทั้งชุด ห้าม find-and-replace ชื่อแบรนด์
// ทับประโยคเดิม มิฉะนั้นเว็บจะไปอ้างสินค้าที่ไม่มีอยู่ในบรีฟรอบนี้
// (คำห้ามจาก brand-spec §1: หวย โพย แทงหวย ตรวจหวย แนวทางหวย รัฐบาลไทย ลาวพัฒนา
// ฮานอย หวยหุ้น งวด เลขเด็ด อัตราจ่าย 2 ตัว/3 ตัว บาคาร่า คาสิโนสด แทงบอล)
//
// บรีฟไม่ได้ประกาศว่ามี "เครดิตทดลอง" หรือโหมดเดโมเป็นบริการของเว็บ — จึงห้าม
// สัญญาสินค้าตัวนั้น หน้านี้พูดถึงโหมดทดลองหมุนวงล้อแบบ hedge ตามแพตเทิร์นของบรีฟ
// ("ขึ้นอยู่กับเกมและค่ายที่ระบบเปิดให้บริการ") ควบคู่กับการไล่ดูระบบจริงให้ครบ
// ตั้งแต่ Login เลือกเกม ดูกติกาและช่วงเดิมพัน ก่อนยืนยันเดิมพันจริงรอบแรก
//
// ข้อเท็จจริงทุกบรรทัดมาจาก brand-spec §5 เท่านั้น: รวมเกมสล็อตจากหลายค่ายผ่าน
// บัญชีเดียว · เกมยอดนิยม สล็อตเปิดใหม่ ฟรีสปิน ตัวคูณ ฟีเจอร์โบนัสหลายรูปแบบ ·
// อัปเดตรายการเกมใหม่ตลอดสัปดาห์ตามค่ายที่เปิดให้บริการ · รองรับมือถือ แท็บเล็ต
// คอมพิวเตอร์ · ค้นหาเกม ตรวจสอบเครดิต โปรโมชั่น ประวัติรายการจากระบบเดียว ·
// เกมวงล้อแบบคลาสสิก สล็อตโบนัส เกมฟรีสปิน เกมรูปแบบใหม่ · บางเกมรองรับเดิมพัน
// เริ่มต้น 1 บาท (ช่วงเดิมพันจริงดูจากในเกม) · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% ·
// สมัคร 3 ขั้นตอน · แอดมิน 24 ชั่วโมง
// — ตัวเลขที่อ้างได้มีแค่ 0.3% 0.8% 1 บาท 3 ขั้นตอน 24 ชั่วโมง และ 268 ในชื่อแบรนด์
// ห้ามเพิ่มชื่อค่ายเกม ชื่อธนาคาร ขั้นต่ำฝาก %RTP เลขใบอนุญาต ปีที่ก่อตั้ง
// จำนวนสมาชิก หรือรางวัลที่บรีฟไม่ได้ระบุ
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: banner1/banner1-mobile/og.png เป็นของ glob ที่
// MainLayout ปักไว้ ห้ามอ้างจากหน้า · slide1/slide2 ของดรอปนี้เป็นของ index และ
// /promotion · slide3/slide4/banner2/banner3 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
// gamedemo7–gamedemo18.webp **ใช้ไม่ได้**: ทุกใบมีลายน้ำแบรนด์อื่นฝังอยู่ในภาพ
// และบางใบมีชื่อค่ายเกม ซึ่ง brand-spec §1 ห้ามเอ่ยชื่อค่ายบนเว็บนี้
//
// Announcement รอบนี้เป็น Announcement5 ทั้งเว็บ — orchestrator ตั้ง default
// message ของไฟล์นั้นเป็นคอปปี้ของ CK268 แล้ว จึงเรียกแบบ bare ห้ามส่ง prop
// message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ CK268 เป็น **เขียวนีออนนำ โครเมียมขาว-เงินรอง บนดำ** ตามโลโก้ (ตัว C กับ
// เลข 68 โครเมียม ตัว K กับเลข 2 เขียวนีออน) และแบนเนอร์พื้นดำสนิทที่มีริ้วแสง
// เขียวนีออนกับชิปคาสิโนเขียว-ดำ: เขียวนีออน #8bfc13 · เขียวอ่อน #c9ff8f ·
// เขียวลึก #1a7a08 · เขียวรอง #12a008 · โครเมียม #e8f0e6 · พื้นเข้มสุด #030703 ·
// ผิวยก #071007 · ผิวยก 2 #0f1b0e · เนื้อความ #d5e6cd (BRAND_TEXT) ·
// เน้นใน strong #eaffd6 · หมึกบนพื้นเขียว #030703
// ชุดทอง-แดงของ GOT777 (#f5c518 #ffe9a8 #96690f #d21622 #fff6dd #ece0cb #0a0503
// #160b06 #241108 rgba(245,197,24,*) rgba(210,22,34,*)) ออกครบทุกจุดแล้ว
// ทั้งคลาส Tailwind raw hex และ rgba() ที่ใช้ทำแสงเรือง ส่วน #00B900 เป็นสีประจำ
// แบรนด์ LINE ไม่ใช่สีของเว็บ
// กฎคอนทราสต์: พื้นเขียวนีออน → หมึกเข้ม #030703 · ตัวอักษรบนการ์ดดำใช้ #d5e6cd
// #eaffd6 #8bfc13 #c9ff8f เท่านั้น เขียวลึก #1a7a08 / #12a008 ใช้เป็นพื้นและขอบ
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลางที่ orchestrator รีธีมรอบนี้) — การ์ดตั้ง
// สีเนื้อความไว้ให้แล้ว ย้ำไว้บนย่อหน้าอีกชั้นเพื่อให้สีของ body copy อ่านออกจาก
// ตัวหน้าเอง
//
// รอบนี้ /ตรวจหวย และ /แนวทาง อยู่ใน src/pages-disabled/ (CK268 ไม่ใช่เว็บหวย)
// ลิงก์ภายในของหน้านี้จึงเหลือเฉพาะที่มี route จริง: /promotion /register /login
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 156
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "ทดลองเล่นสล็อต CK268 ด้วยการไล่ดูระบบจริงให้ครบก่อนเดิมพัน ตั้งแต่เลือกเกมจากหลายค่าย อ่านกติกา ตรวจช่วงเดิมพันที่แสดงในเกม ไปจนถึงตรวจสอบเครดิตและโปรโมชั่น";

const pageTitle = "ทดลองเล่นสล็อต CK268 ไล่ดูเกมจากหลายค่ายก่อนเดิมพันจริง";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d5e6cd]">
        <strong class="text-[#eaffd6]">CK268</strong> รวมเกมสล็อตออนไลน์จาก
        <strong class="text-[#eaffd6]">หลายค่ายไว้ให้เลือกผ่านบัญชีเดียว</strong> รองรับการเข้าเล่นผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ หน้านี้เปิดไว้ให้คนที่ยังไม่คุ้นกับระบบได้ลองเปิดใช้งานจริงหนึ่งรอบ
        ตั้งแต่หน้าค้นหาเกม ไปจนถึงหน้ากติกาและช่วงเดิมพันของเกมนั้น ก่อนจะลงเดิมพันกับเกมไหนจริง
      </p>

      <p class="text-left text-base leading-relaxed text-[#d5e6cd]">
        คำว่า “ทดลองเล่น” ที่หน้านี้พูดถึงจึงหมายถึง<strong class="text-[#eaffd6]">
          การเดินให้ครบทุกขั้นของการใช้งาน ตั้งแต่ Login เลือกเกมสล็อต อ่านกติกา ดูช่วงเดิมพัน ไปจนถึงตรวจสอบเครดิตและประวัติรายการ
        </strong>
        ส่วนโหมดทดลองหมุนวงล้อภายในเกมนั้นมีหรือไม่ ขึ้นอยู่กับเกมและค่ายที่ระบบเปิดให้บริการในขณะนั้น จึงควรดูจากรายละเอียดที่แสดงอยู่ในเกมเป็นหลัก
      </p>
    </div>
  </ContentBox>

  <ContentBox title="เปิด CK268 เล่นได้ทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d5e6cd]">
        จุดที่ช่วยให้เริ่มต้นได้เร็วที่สุดคือ<strong class="text-[#eaffd6]">เกมสล็อตจากหลายค่ายถูกรวมไว้ในบัญชีเดียว และสลับค่ายได้จากระบบเดิม</strong>
        สมาชิกจึงไม่ต้องเปิดบัญชีแยกกันไปตามแต่ละค่าย และค้นหาเกมยอดนิยมหรือสล็อตเปิดใหม่ได้จากระบบเดียว
      </p>

      <ol class="ml-6 list-decimal space-y-3 text-left text-base leading-relaxed text-[#d5e6cd] marker:font-black marker:text-[#8bfc13]">
        <li>
          <strong class="text-[#eaffd6]">เปิดเว็บไซต์ CK268 จากช่องทางหลักก่อน</strong> การเข้าผ่านช่องทางที่เว็บไซต์ประกาศไว้จริงช่วยหลีกเลี่ยงเว็บไซต์ที่ไม่เกี่ยวข้อง แล้วบันทึกทางเข้านั้นไว้ใช้รอบถัดไป
        </li>
        <li>
          <strong class="text-[#eaffd6]">สมัครและยืนยันข้อมูลตามที่ระบบกำหนด แล้ว Login</strong> ทั้งหมดทำผ่านระบบออนไลน์บนมือถือได้ หลังเข้าสู่ระบบจะเห็นเครดิต โปรโมชั่น และประวัติรายการของบัญชีตัวเอง
        </li>
        <li>
          <strong class="text-[#eaffd6]">ไล่ดูเกมสล็อตจากค่ายที่ระบบเปิดให้บริการในขณะนั้น</strong> ทั้งเกมวงล้อแบบคลาสสิก สล็อตโบนัส เกมฟรีสปิน และเกมรูปแบบใหม่ที่ทยอยเพิ่มเข้ามา รายการเกมที่เปิดให้เล่นจริง
          ขึ้นอยู่กับแต่ละค่าย จึงควรดูจากหน้าเกมสล็อตเป็นหลัก
        </li>
        <li>
          <strong class="text-[#eaffd6]">เปิดกติกาและช่วงเดิมพันของเกมนั้นให้ครบก่อนหมุน</strong> เพราะแต่ละเกมใช้ช่วงเดิมพันและฟีเจอร์โบนัสไม่เหมือนกัน และแต่ละค่ายกำหนดยอดเดิมพันขั้นต่ำกับสูงสุดต่างกัน
        </li>
        <li>
          <strong class="text-[#eaffd6]">ลองปรับยอดเดิมพันแล้วอ่านหน้าสรุปก่อนกดยืนยัน</strong> ขั้นนี้คือขั้นที่ควรทำช้าที่สุด เพราะเป็นหน้าจอสุดท้ายที่ยังแก้ยอดเดิมพันได้ก่อนรายการจะถูกบันทึก
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#d5e6cd]">
        <strong class="text-[#eaffd6]">รายการเกมที่เปิดให้เล่นและเงื่อนไขของโปรโมชั่นเปลี่ยนแปลงได้ตามช่วงเวลา จึงควรตรวจสอบข้อมูลจากช่องทางอย่างเป็นทางการของเว็บไซต์ทุกครั้งก่อนเดิมพัน</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ประเภทเกมสล็อตที่ลองไล่ดูได้ใน CK268" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d5e6cd]">
        ระหว่างไล่ดูระบบ สิ่งที่ควรจำให้ได้คือ<strong class="text-[#eaffd6]">เกมสล็อตแต่ละแบบมีจังหวะและฟีเจอร์ของตัวเอง</strong>
        ไม่ได้ใช้ช่วงเดิมพันหรือรูปแบบโบนัสชุดเดียวกันทั้งหมด การรู้ว่าแบบไหนเล่นอย่างไรช่วยให้เลือกเกมที่เหมาะกับสไตล์ของตัวเองได้เร็วขึ้น
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#d5e6cd]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#8bfc13]">🎰</span>
          <span>
            <strong class="text-[#eaffd6]">เกมวงล้อแบบคลาสสิก</strong> เป็นแบบที่อ่านง่ายที่สุดสำหรับคนเริ่มต้น เพราะเส้นรางวัลและสัญลักษณ์มีไม่มาก ลองดูว่าหน้ากติกาของเกมอธิบายเส้นรางวัลไว้อย่างไรก่อนหมุนรอบแรก
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#c9ff8f]">🎁</span>
          <span>
            <strong class="text-[#eaffd6]">สล็อตโบนัสและเกมฟรีสปิน</strong> เป็นฟีเจอร์ที่เงื่อนไขต่างกันมากในแต่ละเกม ทั้งจำนวนรอบที่ได้และวิธีเข้าสู่ฟีเจอร์ จึงควรอ่านจากหน้าข้อมูลของเกมนั้นโดยตรง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#8bfc13]">✖️</span>
          <span>
            <strong class="text-[#eaffd6]">เกมที่มีตัวคูณ</strong> วิธีคิดตัวคูณและเงื่อนไขที่ทำให้ตัวคูณทำงานไม่เหมือนกันทุกเกม ลองเปิดดูตัวอย่างในหน้าข้อมูลของเกมก่อน จะได้รู้ว่ากำลังลุ้นอะไรอยู่ระหว่างหมุน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#c9ff8f]">🆕</span>
          <span>
            <strong class="text-[#eaffd6]">สล็อตเปิดใหม่และเกมรูปแบบใหม่</strong> อัปเดตเข้ามาตลอดสัปดาห์ตามค่ายที่เปิดให้บริการ จำนวนเกมและช่วงเวลาที่เพิ่มเข้าระบบจึงขึ้นอยู่กับการอัปเดตของแต่ละค่าย
          </span>
        </li>
      </ul>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/promotion"
          aria-label="ดูภาพโปรโมชั่นทั้งหมดของ CK268"
