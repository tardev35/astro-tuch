---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";

import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion,
// /login, /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์
// หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ (src/assets/content.txt) ไม่มี
// ส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่จากข้อเท็จจริงและคลังคำของบรีฟรอบนี้
// เท่านั้น (.claude/brand-spec-ruay168.md §4-§5)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
//   h1  ทดลองเล่น <แบรนด์> ศึกษาเงื่อนไขและอัตราจ่ายก่อนใช้บริการ
//   h2  โหมดทดลองใช้ทำอะไรได้ และข้อจำกัดที่ควรรู้ก่อนยืนยันบิลจริง
//   h2  ประเภทหวย รอบปิดรับ และอัตราจ่ายที่ควรตรวจก่อนยืนยันบิล
//   h2  ระบบฝากถอนและช่องทางติดต่อแอดมินที่ควรตรวจก่อนทำรายการ
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// 🚨🚨 **รอบนี้ <แบรนด์> เป็นเว็บหวย ไม่ใช่เว็บหมวดเกม** (brand-spec §0, §5)
// หน้านี้จึง **ห้ามนิยามแบรนด์ด้วยชื่อหมวดเกมใดๆ** คำนิยามตัวเองของแบรนด์ขาออก
// ทั้งชุด (ชื่อหมวดเกม คำโฆษณาแบบจ่ายแบบไม่มีเพดาน คำโบนัสรายวัน) เป็นคำค้างข้ามแบรนด์
// **รายการคำต้องห้ามเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่** เพื่อไม่ให้ sweep
// ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// ⚠️ **คำว่า "ทดลองเล่น" ยังอยู่ได้** เพราะเป็นชื่อ route /ทดลองเล่น และเป็นชื่อ
// เมนูจริง (ใช้ใน h1 · title · description · breadcrumb) แต่บรีฟรอบนี้
// **ไม่ได้พูดถึงโหมดทดลองเลยแม้แต่ประโยคเดียว** ดังนั้นคอปปี้ของหน้านี้พูดถึง
// โหมดทดลองได้แบบ **เป็นกลางและมีเงื่อนไขเท่านั้น** ("หากผู้ให้บริการเปิดไว้...")
// ห้ามอ้างว่ามีกี่รายการ ห้ามอ้างว่าเล่นฟรีได้เท่าไร และห้ามอ้างว่าผลจากโหมด
// ทดลองสะท้อนผลจริง
// แกนของหน้า = **สิ่งที่ควรเปิดอ่านก่อนใช้บริการ** ตามที่บรีฟมีจริง:
// ประเภทหวย · รอบปิดรับ · อัตราจ่าย · การยืนยันบิล · เงื่อนไขโปรโมชั่น ·
// ระบบฝากถอน · ช่องทางติดต่อแอดมิน · ประกาศล่าสุด
//
// ⚠️⚠️ **ห้ามเขียนชื่อแบรนด์ด้วยตัวละตินเด็ดขาด** (ดู brand-spec §0) — รอบนี้
// สะกดได้แบบเดียวคือค่าใน BRAND_NAME ซึ่งเป็นภาษาไทยผสมเลข ห้ามพิมพ์ตรงๆ
//
// ⚠️ **รอบนี้สองหน้าหมวดหวยเปิดอยู่** (/ตรวจหวย · /แนวทาง ย้ายเข้า src/pages/
// แล้วใน P1) ลิงก์ไปสอง route นั้นจากหน้านี้จึงถูกต้อง
// route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ทดลองเล่น · /ตรวจหวย · /แนวทาง · /about-us · /contact-us · /terms ·
// /privacy · /line
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อสำนักหวย ชื่อธนาคารรายตัว ชื่อผู้ให้บริการ
// หน่วยงานกำกับ ใบอนุญาต ปีก่อตั้ง จำนวนสมาชิก จำนวนรายการ หรือยอดขั้นต่ำที่เป็น
// ตัวเลข แม้แต่รายการเดียว** จึงห้ามเขียนลงหน้าเว็บ · ตัวเลขที่ขึ้นหน้าได้มีแค่ของ
// บรีฟเอง: **บาทละ 1,000 · 2 ตัว 100 · 3 ตัว 1,000 · 0.3% · 0.8% · 24ชม.**
// ⚠️ อัตรา 3.2 (วิ่ง/โต๊ด) อยู่ **บนภาพแบนเนอร์เท่านั้น** ห้ามเขียนเป็นคำกล่าวอ้าง
// และไม่มีเปอร์เซ็นต์เต็มร้อย ไม่มีจำนวนขั้นตอนที่นับเป็นข้อ
//
// 🚨 **ข้อกำกับของบรีฟที่ต้อง ship ครบบนหน้านี้** (ไม่ใช่ filler ให้ตัดทิ้ง):
// 1) เลขเด็ดหรือสถิติย้อนหลังไม่สามารถรับประกันผลรางวัลในงวดถัดไปได้
// 2) ยังไม่สามารถยืนยันได้ว่าใช้อัตราเดียวกันกับหวยทุกประเภท ควรตรวจสอบตาราง
//    อัตราจ่าย ฐานเงินเดิมพัน และข้อจำกัดของแต่ละรายการก่อนยืนยันบิล
// 3) เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกบิลหรือรับประกัน
//    ผลตอบแทนในงวดถัดไป · แม้โปรโมชั่นจะระบุว่าไม่จำกัด แต่ควรยืนยันข้อกำหนด
//    จากประกาศล่าสุด
// 4) หากพบชื่อบัญชีไม่ตรงกับข้อมูลทางการหรือมีการแจ้งเปลี่ยนบัญชีอย่างผิดปกติ
//    ควรหยุดทำรายการและติดต่อธนาคารหรือผู้ให้บริการชำระเงินเพื่อตรวจสอบก่อนโอนเงิน
// 5) ไม่เปิดเผยรหัสผ่านหรือรหัส OTP · ควรตรวจสอบเวลาการให้บริการจริงจากประกาศ
//    ล่าสุดอีกครั้ง
// ⚠️ บรีฟไม่ได้การันตีผลลัพธ์ใดๆ — คอปปี้หน้านี้จึงไม่สัญญากำไรและไม่สัญญาว่า
// ถอนได้ชัวร์ · บรีฟรอบนี้ **โฆษณาและกำกับในประโยคเดียวกัน** คำโฆษณาอยู่ได้เฉพาะ
// ในขอบเขตที่บรีฟเขียนไว้เอง ห้ามขยายเป็นคำกล่าวอ้างใหม่ และทุกประโยคกำกับต้อง
// ship ครบ ห้ามตัดเพราะฟังดูลบ
//
// 🚨 **ไม่มีรูปในหน้านี้โดยตั้งใจ** อาร์ตสต็อก gamedemo* (mtime 2026-08-04) เป็น
// ฉากหมวดเกมของแบรนด์เก่า **ไม่ใช่ของดรอปนี้ (2026-10-23)** และเป็นฮิวที่
// brand-spec §2 ตัดออกจากรอบนี้ · ยิ่งกว่านั้นการขึ้นอาร์ตหมวดเกมบนหน้านี้คือ
// การนิยามแบรนด์หวยด้วยภาพของอีกหมวดโดยตรง · ไฟล์ gamedemo* ยังอยู่บนดิสก์
// **ห้ามลบ** เป็นอินเวนทอรีของแบรนด์ถัดไป — แต่ห้าม import กลับเข้ามารอบนี้
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
// ⚠️ รูปอื่นทั้งหมดห้ามอ้างจากหน้านี้เช่นกัน: slide3/slide4 (mtime 2026-09-29)
// เป็นอาร์ตเวิร์กของอีกแบรนด์ · slide1/slide2 ถูกตรึงไว้กับ index §6-§7 กับ
// /promotion · banner2/banner3 เป็นรูปประกอบบทความของ index §3-§4 ·
// banner1 / banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักไว้
//
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) เป็น **ธีมมืด ทอง x โครเมียมเงิน บนดำสนิท**
// bg.json ของดรอปนี้คือ {"mode":"color","color":"#000000"} = ดำสนิท
// **ห้ามเดาว่าเท่าเดิม และห้าม "แก้" การ์ดให้สว่าง**
// ค่าที่ใช้ได้ในไฟล์นี้: ทอง #ffd94a (<strong> + marker ของลำดับเลข + ตัวอักษรปุ่ม
// outline — 13.8:1 บนผิวการ์ด ถือตัวอักษรได้) · ทองพื้นถม #e3a712 และ #b07d08
// (**ปลายไล่เฉดของปุ่มหลัก**) · #9d6f06 (**ขอบ/ออราเท่านั้น ห้ามถือตัวอักษร**) ·
// โครเมียมเงิน #e8eaee -> #b4b9c2 (**พื้นถมของปุ่มรองเท่านั้น**) · ขอบ #6b7079
// และ #3d3425 (**ห้ามถือตัวอักษร**) · ผิวจม #070707 และผิวยก #1c1a16 (พื้นปุ่ม/ชิป)
// หมึกเนื้อความคือ #f3ece0 (= BRAND_TEXT) ซึ่ง **ไม่ประกาศในไฟล์นี้** การ์ด
// ContentBox ตั้งไว้ให้แล้วและย่อหน้าสืบทอดลงมา
// 🚨🚨 **ขาวบนทองได้แค่ ~1.2-2.2:1 — ห้ามใส่หมึกขาวบนพื้นทองเด็ดขาด** ปุ่มทองและ
// ปุ่มโครเมียมใช้ **หมึกดำ #0a0a0a** ทั้งคู่
// ออราที่อนุญาต: rgba(255,217,74,α) · rgba(227,167,18,α) · rgba(176,125,8,α) ·
// rgba(232,234,238,α) · rgba(221,225,231,α) · rgba(0,0,0,α)
// ⚠️⚠️ **รอบนี้ไม่มีแดงเลยสักเฉด** — แดงคือสีนำของแบรนด์ขาออก การปล่อยแดงไว้ =
// ทั้งผิดพาเลตและหลงเหลือข้ามแบรนด์พร้อมกัน · ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีม่วง
// ไม่มีชมพู ไม่มีส้ม ไม่มีครีม ไม่มีพีช ไม่มีน้ำตาลกาแฟ ไม่มีเขียว ·
// ปุ่ม LINE อยู่บน /about-us กับ /contact-us ไม่ใช่หน้านี้
// ⚠️⚠️ **ผมสีขาวเงิน สูทขาว ลิปสติกแดง และสีผิวนักแสดงในอาร์ตเวิร์กเป็นวัตถุใน
// ภาพ ไม่ใช่สี UI**
// ⚠️⚠️ **ทอง/เหลืองผ่านรีโปนี้มาแล้วเกือบทุกเจ้า** การเจอทองในไฟล์จึงไม่พิสูจน์
// อะไร — ห้ามเทียบด้วยวงศ์สี ต้องเทียบทีละค่ากับตาราง brand-spec §2
// (ffd84d ของแบรนด์เก่าห่างจาก #ffd94a ของรอบนี้แค่ G1 — เจอที่ไหนแปลว่าพิมพ์ผิด
// เฮกซ์ของแบรนด์เก่าในคอมเมนต์เขียนแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep สะดุด)
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง และไม่ใส่ mx-auto / max-w-* บน <p>
// เพราะการ์ดคุมความกว้างเองแล้ว — ที่ประกาศสีได้มีแค่ปุ่ม ชิปไอคอน marker ของ
// ลำดับเลข และ <strong> · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง
// เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำ
// จะขาดครึ่ง และห้ามวาง <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังในข้อความของ prop และต้องเป็นไอคอนหมวดหวย ไม่ใช่ไอคอนหมวดเกม
//
// Announcement รอบนี้หมุนมาเป็น AnnouncementHuay ทั้งเว็บ (brand-spec §3 —
// รอบก่อนใช้ AnnouncementPremium จึงหมุนออก) orchestrator ตั้ง default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว จึงเรียกแบบ bare **ห้ามส่ง prop message**
// มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 158 อักขระ (ชื่อแบรนด์รอบนี้ 6 ตัวอักษร) เป็นประโยคเดียวที่บอกว่า
// หน้านี้มีไว้ทำอะไร แล้วหยุด
// (Google ตัดราว 155 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนๆ ยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} รวมสิ่งที่ควรเปิดอ่านก่อนใช้บริการ ทั้งโหมดทดลองแต่ละรายการ ประเภทหวยและรอบปิดรับ อัตราจ่าย เงื่อนไขโปรโมชั่น และขั้นตอนฝากถอนจากประกาศล่าสุด`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ศึกษาเงื่อนไขและอัตราจ่ายก่อนใช้บริการ`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});

// คลาสปุ่มสามขั้วของหน้านี้ ประกาศครั้งเดียวแล้วใช้ซ้ำ เพื่อไม่ให้สองปุ่มที่ทำ
// หน้าที่เดียวกันหลุดไปคนละเฉดตอนรีแบรนด์รอบหน้า
const ctaPrimary =
  "flex items-center justify-center rounded-lg border border-[#9d6f06] bg-gradient-to-b from-[#ffd94a] via-[#e3a712] to-[#b07d08] px-8 py-3 font-black text-[#0a0a0a] shadow-[0_6px_18px_rgba(227,167,18,0.35)] transition-transform hover:scale-105";

const ctaSecondary =
  "flex items-center justify-center rounded-lg border border-[#6b7079] bg-gradient-to-b from-[#e8eaee] to-[#b4b9c2] px-8 py-3 font-bold text-[#0a0a0a] shadow-[0_6px_18px_rgba(232,234,238,0.25)] transition-transform hover:scale-105";

const ctaQuiet =
  "flex items-center justify-center rounded-lg border-2 border-[#ffd94a] bg-[#070707] px-8 py-3 font-bold text-[#ffd94a] shadow-[0_4px_14px_rgba(0,0,0,0.35)] transition-all hover:scale-105 hover:bg-[#1c1a16] hover:shadow-[0_6px_18px_rgba(227,167,18,0.25)]";

const listChip = "mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#3d3425] bg-[#1c1a16] text-sm";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#ffd94a]">{BRAND_NAME} นำเสนอข้อมูลหวยออนไลน์หลากหลายประเภท ทั้งหวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยออมสิน</strong>
        พร้อมรายละเอียดอัตราจ่ายและรอบประกาศผลที่แตกต่างกัน หน้านี้รวบรวมไว้ว่าควรเปิดอ่านอะไรบ้างก่อนตัดสินใจ และควรตรวจอะไรซ้ำทุกครั้งก่อนกดยืนยันบิล
      </p>

      <p>
        ผู้ใช้งานสามารถศึกษารูปแบบการเลือกหมายเลข ตรวจสอบเงื่อนไขการเดิมพัน และติดตามข้อมูลเลขดังจากแหล่งต่าง ๆ ได้ โดยควรตรวจสอบความถูกต้องของข้อมูลก่อนทำรายการ
        <strong class="text-[#ffd94a]">เพราะเลขเด็ดหรือสถิติย้อนหลังไม่สามารถรับประกันผลรางวัลในงวดถัดไปได้</strong>
        เนื้อหาในหน้านี้จึงเขียนไว้ประกอบการใช้งานเท่านั้น ไม่ได้ใช้แทนเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้บริการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="โหมดทดลองใช้ทำอะไรได้ และข้อจำกัดที่ควรรู้ก่อนยืนยันบิลจริง" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#ffd94a]">หากผู้ให้บริการเปิดโหมดทดลองไว้ในรายการใด โหมดนั้นมีประโยชน์ในแง่การทำความคุ้นเคยกับหน้าจอเท่านั้น</strong>
        เช่น ตำแหน่งของช่องกรอกหมายเลข วิธีเลือกประเภทการเดิมพัน และลำดับขั้นก่อนถึงหน้ายืนยันบิล รายการด้านล่างคือข้อจำกัดที่ควรรู้ก่อนเทียบกับการใช้งานจริง
      </p>

      <ul class="flex flex-col gap-4" aria-label="ข้อจำกัดของโหมดทดลองที่ควรรู้">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🧾</span>
          <span>
            <strong class="text-[#ffd94a]">บิลที่เกิดขึ้นในโหมดทดลองไม่ใช่บิลจริง</strong> จึงไม่มีผลต่อการจ่ายรางวัล ไม่นับเป็นยอดของโปรโมชั่น และไม่ใช่หลักฐานในการตรวจบิลภายหลัง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🗓️</span>
          <span>
            <strong class="text-[#ffd94a]">รอบปิดรับและงวดที่เห็นในโหมดทดลองอาจไม่ตรงกับรอบจริง</strong> ก่อนลงเงินจึงควรกลับไปดูรอบของประเภทหวยนั้นจากประกาศล่าสุดอีกครั้ง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📊</span>
          <span>
            <strong class="text-[#ffd94a]">ผลที่ออกในโหมดทดลองไม่ได้สะท้อนผลของงวดถัดไป</strong> และไม่ใช่สถิติที่นำมาคาดการณ์ได้ ผลการออกรางวัลมีความไม่แน่นอนโดยตัวของมันเอง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📣</span>
          <span>
            <strong class="text-[#ffd94a]">ประกาศล่าสุดของเว็บไซต์ทางการ</strong> คือจุดที่เงื่อนไขจริงถูกอัปเดต ไม่ว่าจะเป็นประเภทที่เปิดรับ อัตราจ่าย หรือรอบปิดรับ การเปิดดูก่อนทุกครั้งจึงตรงกว่าการจำไว้จากงวดก่อน
          </span>
        </li>
      </ul>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/แนวทาง" aria-label={`เปิดหน้าแนวทางของ ${BRAND_NAME}`} class={ctaQuiet}>ไปหน้าแนวทาง</a>

        <a href="/ตรวจหวย" aria-label={`เปิดหน้าตรวจหวยของ ${BRAND_NAME}`} class={ctaQuiet}>ไปหน้าตรวจหวย</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="ประเภทหวย รอบปิดรับ และอัตราจ่ายที่ควรตรวจก่อนยืนยันบิล" as="h2">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#ffd94a]">{BRAND_NAME} รวบรวมข้อมูลหวยหลายประเภทไว้ในช่องทางเดียว</strong>
        ทั้งหวยรัฐบาลไทยที่อ้างอิงผลสลากกินแบ่งรัฐบาล หวยลาว หวยฮานอย และรายการที่เกี่ยวข้องกับผลรางวัลออมสิน โดยแต่ละประเภทมีวันประกาศผลและรูปแบบการออกรางวัลแตกต่างกัน
      </p>

      <p>
        สำหรับอัตราจ่ายที่ระบุว่าบาทละ 1,000 รวมถึง 2 ตัว 100 และ 3 ตัว 1,000 ควรตรวจสอบว่าใช้กับการเดิมพันประเภทใด เป็นเลขสองตัวบนหรือสองตัวล่าง เป็นสามตัวตรงหรือสามตัวโต๊ด รวมถึงฐานเงินเดิมพันและวงเงินจ่ายสูงสุดของแต่ละรอบ
        <strong class="text-[#ffd94a]">เพราะยังไม่สามารถยืนยันได้ว่าใช้อัตราเดียวกันกับหวยทุกประเภท</strong>
        จึงควรตรวจสอบตารางอัตราจ่ายและข้อจำกัดของแต่ละรายการจากข้อมูลล่าสุดก่อนยืนยันบิล
      </p>

      <p>
        ส่วนโปรโมชั่นที่ระบุไว้มีรายการคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8% ซึ่งแต่ละรายการอาจกำหนดประเภทหวยที่เข้าร่วม ยอดที่นำมาคำนวณ และรอบเวลารับเครดิตแตกต่างกัน
        <strong class="text-[#ffd94a]">ทั้งนี้ เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกบิลหรือรับประกันผลตอบแทนในงวดถัดไป</strong>
        และแม้โปรโมชั่นจะระบุว่าไม่จำกัด แต่ควรยืนยันข้อกำหนดเกี่ยวกับจำนวนบัญชีที่เข้าร่วม รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุด
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/promotion" aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`} class={ctaQuiet}>ดูภาพโปรโมชั่น</a>

        <a href="/about-us" aria-label={`อ่านหน้าเกี่ยวกับเราของ ${BRAND_NAME}`} class={ctaQuiet}>อ่านเกี่ยวกับเรา</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="ระบบฝากถอนและช่องทางติดต่อแอดมินที่ควรตรวจก่อนทำรายการ" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        เมื่ออ่านประเภทหวย รอบปิดรับ และอัตราจ่ายครบแล้ว
        <strong class="text-[#ffd94a]">ขั้นถัดไปคือการตรวจระบบฝากถอนและช่องทางติดต่อให้ครบก่อนทำธุรกรรมครั้งแรก</strong>
        รายการด้านล่างควรตรวจซ้ำทุกครั้งที่กลับเข้ามาใหม่ เพราะเงื่อนไขปรับเปลี่ยนได้ตามที่ผู้ให้บริการกำหนด
      </p>

      <ol class="ml-6 list-decimal space-y-3 marker:font-black marker:text-[#ffd94a]">
        <li>
          <strong class="text-[#ffd94a]">รายชื่อธนาคารที่รองรับและทรูมันนี่</strong> ควรดูจากบริการที่เปิดใช้งานอยู่จริง พร้อมตรวจยอดขั้นต่ำ ระยะเวลาดำเนินการ และข้อกำหนดการถอนเงินให้ครบก่อนทำรายการ
        </li>
        <li>
          <strong class="text-[#ffd94a]">ชื่อบัญชีปลายทางของผู้ให้บริการ</strong> ควรตรงกับข้อมูลที่ยืนยันได้จากเว็บไซต์ทางการ นี่คือจุดที่ใช้แยกรายการจริงออกจากบัญชีแอบอ้าง
        </li>
        <li>
          <strong class="text-[#ffd94a]">การตรวจบิลและหมายเลขรายการ</strong> ควรเปิดดูทุกครั้งหลังยืนยันบิล และเก็บหลักฐานที่เกี่ยวข้องไว้สำหรับตรวจสอบย้อนหลังเมื่อผลรางวัลประกาศแล้ว
        </li>
        <li>
          <strong class="text-[#ffd94a]">ช่องทางติดต่อแอดมินตลอด 24ชม.</strong> ควรตรวจสอบจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีแอบอ้างที่ใช้ชื่อคล้ายกัน
        </li>
        <li>
          <strong class="text-[#ffd94a]">ความปลอดภัยของข้อมูลที่ใช้เข้าสู่ระบบ</strong> ควรตั้งรหัสผ่านที่คาดเดาได้ยาก และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้ใครทราบ แม้จะอ้างว่าเป็นเจ้าหน้าที่ก็ตาม
        </li>
      </ol>

      <p>
        <strong class="text-[#ffd94a]">หากพบชื่อบัญชีไม่ตรงกับข้อมูลทางการหรือมีการแจ้งเปลี่ยนบัญชีอย่างผิดปกติ ควรหยุดทำรายการทันที</strong>
        แล้วติดต่อธนาคารหรือผู้ให้บริการชำระเงินเพื่อตรวจสอบก่อนโอนเงิน และเมื่อแจ้งปัญหา ควรระบุรายละเอียดให้ชัดเจนพร้อมหลักฐานที่เกี่ยวข้อง
      </p>

      <p>
        หากมีข้อสงสัยเกี่ยวกับประเภทหวย รอบปิดรับ อัตราจ่าย หรือรายการฝากถอน สามารถสอบถามเจ้าหน้าที่ผ่านช่องทางทางการของเว็บไซต์ได้
        <strong class="text-[#ffd94a]">ทั้งนี้ ควรตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุดอีกครั้ง</strong>
        เพราะช่วงเวลาที่เจ้าหน้าที่รับเรื่องอาจปรับเปลี่ยนได้ตามที่ผู้ให้บริการกำหนด
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/register" aria-label={`สมัครสมาชิก ${BRAND_NAME}`} class={ctaPrimary}>สมัครสมาชิก</a>

        <a href="/login" aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`} class={ctaSecondary}>เข้าสู่ระบบ</a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
