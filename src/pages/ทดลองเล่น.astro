---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";
import { itemList, pageGraph, schemaCtx } from "../lib/schema";
import image1 from "../assets/gamedemo7.webp";
import image2 from "../assets/gamedemo8.webp";
import image3 from "../assets/gamedemo9.webp";
import image4 from "../assets/gamedemo10.webp";
import image5 from "../assets/gamedemo11.webp";
import image6 from "../assets/gamedemo12.webp";
import image7 from "../assets/gamedemo13.webp";
import image8 from "../assets/gamedemo14.webp";
import image9 from "../assets/gamedemo15.webp";
import image10 from "../assets/gamedemo16.webp";
import image11 from "../assets/gamedemo17.webp";
import image12 from "../assets/gamedemo18.webp";

// One list, two consumers: the gallery below and the ItemList in the JSON-LD.
// They used to be two hand-kept arrays that had to stay in the same order, and
// the name shown to a reader could drift from the name handed to a crawler.
const demoGames = [
  { name: "AskmeSlot", src: image1, alt: "แบนเนอร์เกมสล็อตค่าย AskmeSlot ที่เปิดให้ทดลองเล่นบน ZORO365" },
  { name: "Popular Game", src: image2, alt: "แบนเนอร์รวมเกมยอดนิยม Popular Game พร้อมกองชิปและเหรียญทอง" },
  { name: "SlotXO", src: image3, alt: "แบนเนอร์เกมสล็อตค่าย SlotXO ที่เปิดให้ทดลองเล่นบน ZORO365" },
  { name: "Skywind Group", src: image4, alt: "แบนเนอร์เกมสล็อตค่าย Skywind Group ที่เปิดให้ทดลองเล่นบน ZORO365" },
  { name: "PG Soft", src: image5, alt: "แบนเนอร์เกมสล็อตค่าย PG Soft ที่เปิดให้ทดลองเล่นบน ZORO365" },
  { name: "SBOBET", src: image6, alt: "แบนเนอร์ค่ายเกม SBOBET พร้อมตัวละครการ์ตูนถือลูกอม" },
  { name: "Sexy Slot", src: image7, alt: "แบนเนอร์เกมสล็อตค่าย Sexy Slot ที่เปิดให้ทดลองเล่นบน ZORO365" },
  { name: "JILI", src: image8, alt: "แบนเนอร์เกมสล็อตค่าย JILI ที่เปิดให้ทดลองเล่นบน ZORO365" },
  { name: "Ask Me Bet", src: image9, alt: "แบนเนอร์ค่ายเกม Ask Me Bet ที่เปิดให้ทดลองเล่นบน ZORO365" },
  { name: "New Game", src: image10, alt: "แบนเนอร์เกมออกใหม่ New Game พร้อมตัวการ์ตูนฟักทองและโครงกระดูก" },
  { name: "JOKER", src: image11, alt: "แบนเนอร์เกมสล็อตค่าย JOKER ที่เปิดให้ทดลองเล่นบน ZORO365" },
  { name: "AFB Gaming", src: image12, alt: "แบนเนอร์ค่ายเกม AFB Gaming ที่เปิดให้ทดลองเล่นบน ZORO365" },
];

// The URL each entry resolves to is schema.ts's problem, not this file's — an
// older version pasted a hand-built page URL onto all 12 and got the trailing
// slash and the Thai encoding wrong on every one of them.
const gameList = demoGames.map((game) => ({ name: game.name, imagePath: game.src.src }));

const pageDescription =
  "ทดลองเล่นเกมของ ZORO365 เปิดดูหน้าสล็อตและคาสิโนหลายค่ายก่อนใช้เครดิตจริง พร้อมจุดที่ควรดูทั้งเดิมพันเริ่มต้น 1–10 บาทต่อรอบ ฟีเจอร์โบนัส และความผันผวน";

const ctx = schemaCtx(Astro);
const graph = pageGraph(Astro, {
  type: "CollectionPage",
  name: "ทดลองเล่นเกมของ ZORO365 ลองระบบก่อนเล่นด้วยเงินจริง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
  extra: [
    itemList(ctx, {
      name: "ทดลองเล่นเกมสล็อตและคาสิโนของ ZORO365",
      alternateName: "ZORO365 โหมดทดลองเล่นสล็อตหลายค่ายบนมือถือก่อนเล่นด้วยเงินจริง",
      itemType: "Game",
      items: gameList,
    }),
  ],
});
---

<MainLayout title="ทดลองเล่น ZORO365 ลองสล็อต PG และคาสิโนสดก่อนเล่นจริง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่นเกมของ ZORO365 ลองระบบก่อนเล่นด้วยเงินจริง">
    <div>
      <h2 class="mb-4 bg-gradient-to-r from-[#4ade80] to-[#fbbf24] bg-clip-text text-2xl leading-normal font-bold text-transparent">วิธีเข้าเล่นทดลอง ZORO365</h2>

      <ol class="mb-8 flex flex-col gap-2 text-left text-base leading-relaxed text-[#e9f7e6]">
        <li class="flex gap-3"><span class="font-bold text-[#4ade80]">1.</span> สมัครสมาชิกกับ ZORO365</li>
        <li class="flex gap-3"><span class="font-bold text-[#4ade80]">2.</span> เลือกเกมที่ต้องการจากรายการด้านล่าง</li>
        <li class="flex gap-3"><span class="font-bold text-[#4ade80]">3.</span> กดปุ่ม "เล่นเลย" เพื่อเริ่มทดลองเล่นทันที</li>
      </ol>

      <div class="mb-5 grid grid-cols-2 gap-5 sm:grid-cols-2 md:grid-cols-4">
        {
          demoGames.map((game) => (
            <div class="group/game relative mx-auto w-full max-w-[400px] overflow-hidden rounded-xl">
              <Picture
                src={game.src}
                alt={game.alt}
                loading="lazy"
                fetchpriority="low"
                widths={[200, 400, 600]}
                sizes="(max-width: 768px) 100vw, 25vw"
                class="block h-auto w-full object-cover shadow-[0_10px_30px_rgba(34,197,94,0.18)] transition-transform duration-300 group-hover/game:scale-105"
                decoding="async"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                quality={60}
              />
              <a
                href="/register"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`สมัครสมาชิกเพื่อเล่น ${game.name} ที่ ZORO365`}
                class="absolute inset-0 flex items-center justify-center bg-[#04120a]/75 opacity-0 transition-opacity duration-300 group-hover/game:opacity-100 focus-visible:opacity-100">
                <span class="rounded-full border border-[#16a34a]/60 bg-gradient-to-r from-[#22c55e] to-[#16a34a] px-6 py-2 font-bold text-white shadow-[0_10px_30px_rgba(22,163,74,0.30)] transition-transform hover:scale-110">เล่นเลย</span>
              </a>
            </div>
          ))
        }
      </div>

      <h2 class="mt-8 mb-4 bg-gradient-to-r from-[#4ade80] to-[#fbbf24] bg-clip-text text-2xl leading-normal font-bold text-transparent">เงื่อนไขก่อนเล่น</h2>

      <ul class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#e9f7e6]">
        <li class="flex gap-3"><span class="text-[#4ade80]">•</span> โหมดทดลองใช้เครดิตทดลอง ไม่ใช่เงินจริง และถอนไม่ได้</li>
        <li class="flex gap-3"><span class="text-[#4ade80]">•</span> คาสิโนสดไม่มีโหมดทดลอง ต้องเล่นด้วยเงินจริงเท่านั้น</li>
        <li class="flex gap-3"><span class="text-[#4ade80]">•</span> เข้าเล่นผ่านทางเข้าจริงของ ZORO365 ที่เชื่อมต่อ HTTPS เท่านั้น</li>
      </ul>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
