---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxCyberCut.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";

import { pageGraph } from "../lib/schema";

// HERO1688 เป็นเว็บสล็อตออโต้เว็บตรง รวมเกมสล็อตจากหลายค่ายไว้ในบัญชีเดียว ค่ายแท้
// ไม่ผ่านเว็บตัวแทน หน้านี้จึงหมายถึงการทำความรู้จักระบบก่อนเดิมพันด้วยเครดิตจริง:
// ขั้นตอนสมัครและฝากเครดิต การเลือกค่ายและเกมสล็อต การตรวจกติกา อัตราจ่าย และวงเงิน
// เดิมพันของแต่ละเกม โปรโมชั่นที่ตรวจสอบได้หลัง Login และการดูประวัติรายการในบัญชีสมาชิก
// (รอบรีแบรนด์ก่อนหน้าเป็นเว็บคาสิโนครบห้าหมวด เนื้อหาเดิมจึงถูกเขียนใหม่ทั้งหน้าให้เป็นสล็อตล้วน)
//
// แบรนด์เก่าเคยวางแกลเลอรี 12 การ์ด (gamedemo7..18.webp) ไว้ที่หน้านี้ ถูกถอดออกไปตั้งแต่
// สิบรอบรีแบรนด์ก่อน และไม่มีการ import แล้ว — อย่านำกลับมา ลำพังการ import ก็ทำให้ไฟล์ถูก
// emit ลง dist/ และ verify-build จะแดงถ้ามีรูปที่ไม่มีใคร render ทั้งชุด
//
// ทุกข้อความอ้างอิงบรีฟของแบรนด์นี้เท่านั้น: รวมเกมสล็อตหลายค่ายในบัญชีเดียว ค่ายแท้
// ไม่ผ่านเว็บตัวแทน · Login แล้วเลือกค่ายและเกมที่ต้องการ พร้อมตรวจกติกา อัตราจ่าย และวงเงิน
// ก่อนทำรายการ · โบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไข · ฝากถอนผ่านวอลเลท
// หรือธนาคารตามช่องทางที่รองรับ ยึดยอดขั้นต่ำและวงเงินที่หน้าฝากถอนแสดง ณ เวลาทำรายการ ·
// แอดมิน 24 ชม. ไม่มีการอ้างใบอนุญาต การจดทะเบียน ปีที่ก่อตั้ง จำนวนสมาชิก การันตีผลกำไร
// ชื่อค่ายเกมรายใด หรือตาราง RTP ตายตัว
//
// Announcement หมุนมาใช้ AnnouncementCyber ตัวเดียวกับ index — default message ของไฟล์นั้น
// เป็นข้อความของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ได้
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 154
const pageDescription =
  "หน้าทดลองเล่น HERO1688 แนะนำวิธีเริ่มใช้งานเว็บสล็อตออโต้ ตั้งแต่สมัครสมาชิก ฝากเครดิตผ่านวอลเลท เลือกค่ายเกมสล็อต จนถึงตรวจกติกาและอัตราจ่ายก่อนเริ่มเล่น";

const graph = pageGraph(Astro, {
  name: "ทดลองเล่น HERO1688 ทำความรู้จักระบบสล็อตออโต้ก่อนเดิมพันด้วยเครดิตจริง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title="ทดลองเล่น HERO1688 ลองใช้ระบบสล็อตออโต้เว็บตรง ค่ายแท้ ไม่ผ่านตัวแทน" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่น HERO1688 ทำความรู้จักระบบสล็อตออโต้ก่อนเดิมพันด้วยเครดิตจริง" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dbe1ea]">
        <strong class="text-[#f4f7fb]">HERO1688</strong> รวมเกมสล็อตจากหลายค่ายไว้ในบัญชีเดียว ทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน
        และเกมรูปแบบใหม่ตามที่แต่ละค่ายเปิดให้บริการ รองรับการเข้าใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์
        หน้านี้จึงเปิดไว้ให้ผู้เริ่มต้นได้<strong class="text-[#f4f7fb]">ทำความคุ้นเคยกับขั้นตอนใช้งาน ตรวจกติกา อัตราจ่าย และวงเงินเดิมพันของแต่ละเกม</strong>
        ก่อนเดิมพันด้วยเครดิตของตัวเอง เพราะรายละเอียดเหล่านี้ต่างกันไปตามค่ายและตามเกมที่เลือก
      </p>

      <p class="text-left text-base leading-relaxed text-[#dbe1ea]">
        ขอให้เข้าใจตรงกันว่าการทดลองเล่นเป็นการทำความคุ้นเคยกับระบบเท่านั้น
        <strong class="text-[#ff5a5d]">ผลลัพธ์ของเกมสล็อตเป็นไปตามระบบของแต่ละเกม จึงไม่สามารถรับประกันว่าเกมใดจะแตกไวหรือสร้างกำไรได้ทุกครั้ง</strong>
        ควรเลือกเกมจากกติกา รูปแบบการเดิมพัน และงบประมาณที่เหมาะสมกับตนเอง หากติดปัญหาระหว่างใช้งาน แจ้งแอดมิน HERO1688 ได้ตลอด 24 ชั่วโมง
        พร้อมชื่อเกม เวลา จำนวนเงิน และรายละเอียดของรายการ เพื่อให้ตรวจสอบได้ตรงจุด
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="ขั้นตอนเริ่มใช้งาน HERO1688 ตั้งแต่สมัครสมาชิกจนถึงเข้าเล่นเกมสล็อต" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dbe1ea]">
        ผู้ใช้งานใหม่สมัคร HERO1688 ผ่านมือถือหรือคอมพิวเตอร์ได้ด้วยตัวเอง และสลับค่ายเกมผ่านบัญชีเดียวได้โดยไม่ต้องสมัครหลายครั้ง
        เริ่มต้นใช้งานได้ง่ายเพียง <strong class="text-[#f4f7fb]">3 ขั้นตอน</strong> และเป็นลำดับเดียวกันไม่ว่าจะเลือกเล่นค่ายไหน
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#dbe1ea]">
        <li class="flex gap-3"><span class="font-bold text-[#ff5a5d]">1.</span> เข้าหน้าสมัคร HERO1688 และกรอกข้อมูลตามที่ระบบกำหนด ทำผ่านมือถือหรือคอมพิวเตอร์ได้โดยตรง</li>
        <li class="flex gap-3"><span class="font-bold text-[#ff5a5d]">2.</span> Login เข้าสู่บัญชีและเลือกช่องทางฝากเครดิตผ่านวอลเลทหรือบัญชีธนาคารที่เปิดให้บริการ</li>
        <li class="flex gap-3"><span class="font-bold text-[#ff5a5d]">3.</span> ตรวจสอบโปรโมชั่น เลือกค่ายและเกมสล็อตที่ต้องการ แล้วอ่านกติกากับวงเงินเดิมพันก่อนเริ่มเล่น</li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#dbe1ea]">
        หลังสมัครเรียบร้อยสามารถตรวจสอบเครดิต ประวัติฝากถอน โปรโมชั่น และรายการใช้งานผ่านบัญชีสมาชิกได้โดยตรง
        ควรไล่ดูให้ครบก่อนใช้เครดิตจริง จะช่วยให้เห็นว่ารายการหนึ่งถูกบันทึกและคิดผลมาจากอะไรบ้าง
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ตรวจกติกา อัตราจ่าย และวงเงินเดิมพันของแต่ละเกมสล็อตก่อนทำรายการ" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dbe1ea]">
        ข้อมูลที่ควรเปิดดูให้ครบก่อนลงเดิมพันมีอยู่ไม่กี่อย่าง และระบบแสดงไว้ในหน้าเกมให้ตรวจสอบได้อยู่แล้ว
        <strong class="text-[#f4f7fb]">ข้อมูลชุดนี้คือสิ่งที่กำหนดว่ารอบหนึ่งคิดผลอย่างไร</strong> จึงควรอ่านให้จบก่อนตัดสินใจว่าจะลงเท่าไร
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#dbe1ea]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ff5a5d]">🎰</span>
          <span><strong class="text-[#f4f7fb]">จำนวนวงล้อและเส้นรางวัล</strong> เป็นตัวกำหนดว่าสัญลักษณ์ชุดไหนนับเป็นรางวัล แต่ละเกมวางไว้ไม่เหมือนกันแม้อยู่ค่ายเดียวกัน</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e3e7ec]">🎁</span>
          <span><strong class="text-[#e3e7ec]">รอบโบนัสและเงื่อนไขการเข้ารอบ</strong> หน้าอธิบายในตัวเกมบอกไว้ว่าต้องได้สัญลักษณ์ชุดใดจึงเปิดรอบพิเศษ และรอบนั้นคิดผลอย่างไร</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ff5a5d]">🌀</span>
          <span><strong class="text-[#f4f7fb]">ฟรีสปินและตัวคูณ</strong> จำนวนสปินที่ได้รับกับวิธีคูณผลต่างกันไปตามเกม ควรดูให้ชัดก่อนว่าจะนับรวมกับเดิมพันปกติหรือไม่</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e3e7ec]">💠</span>
          <span><strong class="text-[#e3e7ec]">วงเงินเดิมพันต่อรอบ</strong> แต่ละเกมกำหนดยอดต่ำสุดและสูงสุดของตัวเอง ให้ยึดข้อมูลที่ระบบแสดงในหน้าเกมเป็นหลัก</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#dbe1ea]">
        รายชื่อค่ายและเกมที่พร้อมใช้งานเปลี่ยนแปลงได้ ควรตรวจสอบรายการล่าสุดจากหน้าเลือกเกมในเว็บก่อนเข้าเล่น
        ส่วนรายละเอียดกติกาและเงื่อนไขให้ยึดข้อมูลที่แสดงในตัวเกมโดยตรง และควรกำหนดยอดต่อรอบไว้ล่วงหน้าทุกครั้ง
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ฝากถอนวอลเลท เช็กโปรโมชั่น และดูแลความปลอดภัยของบัญชีสมาชิก" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dbe1ea]">
        สมาชิกจัดการเครดิตได้เองโดยเลือกใช้วอลเลทหรือบัญชีธนาคารจากช่องทางที่เว็บไซต์เปิดรองรับ
        <strong class="text-[#f4f7fb]">ทำรายการฝาก ส่งคำขอถอน และตรวจสอบสถานะผ่านมือถือได้โดยตรง</strong>
        ช่วยลดขั้นตอนและไม่จำเป็นต้องแจ้งรายการกับเจ้าหน้าที่ทุกครั้ง ส่วนชื่อบัญชี จำนวนเงิน ยอดขั้นต่ำ และวงเงินของแต่ละช่องทาง
        ควรตรวจสอบก่อนทำธุรกรรมทุกครั้ง เนื่องจากช่องทางแต่ละประเภทอาจกำหนดเงื่อนไขแตกต่างกัน
      </p>

      <ul class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#dbe1ea]">
        <li class="flex gap-3">
          <span class="text-[#ff5a5d]" aria-hidden="true">•</span> โปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตรวจสอบสิทธิ์ได้หลัง Login แต่ละรายการอาจกำหนดยอดที่ใช้คำนวณ รอบรับโบนัส เกมที่เข้าร่วม และเงื่อนไขการถอนต่างกัน ควรอ่านรายละเอียดให้ครบก่อนกดรับ
        </li>
        <li class="flex gap-3">
          <span class="text-[#e3e7ec]" aria-hidden="true">•</span> หน้านี้อธิบายการใช้งานและการทำความคุ้นเคยกับระบบเท่านั้น การเดิมพันจริงต้องสมัครสมาชิกและฝากเครดิตผ่านช่องทางที่เปิดให้บริการก่อน
        </li>
        <li class="flex gap-3">
          <span class="text-[#ff5a5d]" aria-hidden="true">•</span> หากเครดิตไม่เข้า รายการถอนค้าง หรือสถานะธุรกรรมไม่อัปเดต ให้ตรวจสอบประวัติธุรกรรมในบัญชีก่อน และเก็บหลักฐานรายการไว้จนกว่าการตรวจสอบจะเสร็จสิ้น
        </li>
        <li class="flex gap-3">
          <span class="text-[#e3e7ec]" aria-hidden="true">•</span>
          <strong class="text-[#f4f7fb]">ตั้งรหัสผ่านที่คาดเดายาก ไม่ใช้รหัสเดียวกับบริการอื่น และไม่เปิดเผยรหัสผ่านหรือ OTP แก่บุคคลอื่น</strong> ไม่ว่าจะเป็นการติดต่อจากช่องทางใดก็ตาม
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#dbe1ea]">
        หากพบปัญหาสมัครสมาชิก Login ไม่ได้ เข้าเกมสล็อตไม่ได้ ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง หรือโปรโมชั่นไม่แสดง ติดต่อแอดมิน HERO1688 ได้ตลอด 24 ชั่วโมง พร้อมแจ้งชื่อเกม เวลา จำนวนเงิน
        และช่องทางที่ใช้ทำรายการ <strong class="text-[#ff5a5d]">การเดิมพันมีความเสี่ยง ควรกำหนดงบประมาณให้เหมาะสมทุกครั้ง</strong>
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก HERO1688"
          class="flex items-center justify-center rounded-lg border border-[#7d0507]/70 bg-gradient-to-r from-[#ff5a5d] via-[#e11015] to-[#7d0507] px-8 py-3 font-black text-[#010207] shadow-[0_0_15px_rgba(225,16,21,0.30)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ HERO1688"
          class="flex items-center justify-center rounded-lg border border-[#e3e7ec]/45 bg-transparent px-8 py-3 font-bold text-[#e3e7ec] transition-all hover:scale-105 hover:border-[#e3e7ec] hover:bg-[#1a0509]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>

  <Navfoot />
</MainLayout>
