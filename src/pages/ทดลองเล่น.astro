---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { pageGraph } from "../lib/schema";

// HENG35 เป็นเว็บสล็อต ไม่ใช่เว็บหวยและไม่ใช่เว็บรวมคาสิโนหลายหมวด — บรีฟรอบนี้
// (ดรอป 2026-09-21 "HENG35 สมัครสล็อตยูสใหม่ ไม่ล็อค โบนัสฝากแรก ไม่อั้น")
// พูดถึงสล็อตอย่างเดียว ห้ามเอ่ยบาคาร่า หวย หรือบอล และคอปปี้ของแบรนด์รอบก่อน
// ("สล็อตออโต้Top3 / เว็บตรง / ระบบออโต้") ถูกเขียนใหม่ทั้งหน้าแล้ว
//
// บรีฟรอบนี้ไม่ได้ระบุว่ามี "เครดิตเสมือน" หรือโหมดเดโมที่ถอนไม่ได้ สิ่งที่บรีฟระบุคือ
// "เลือกเกมจากหลายค่ายและตรวจสอบเงื่อนไขก่อนเข้าเล่นได้จากหน้าเดียว ระบบจัดหมวดเกม
// ชัดเจน พร้อมตัวเลือกการเดิมพันที่หลากหลายตามแต่ละเกม" — หน้านี้จึงเขียนบนฐานนั้น
// ห้ามกลับไปอ้างกติกาของเครดิตทดลองที่บรีฟไม่ได้พูดถึง
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: แกลเลอรีเดโม 12 การ์ด (gamedemo7..18.webp) ยังอยู่
// บนดิสก์แต่เป็นของแบรนด์อื่น (mtime 2026-08-04 ไม่ใช่ดรอปรอบนี้) — gamedemo7.webp
// มีโลโก้ "askmeslot" ของลูกค้าเจ้าอื่นพิมพ์ทับกลางรูป ห้ามนำกลับมา import
// เด็ดขาด (ห้ามลบไฟล์ เป็นอินเวนทอรี) ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง
// dist/ และ verify-build จะแดง ดรอป 2026-09-21 ไม่มีรูปเกมมาด้วย
//
// ข้อเท็จจริงทุกบรรทัดมาจากบรีฟรอบนี้เท่านั้น: ไม่ล็อคยูส · โบนัสฝากแรกตามเงื่อนไข ·
// มีเกมจากหลายค่ายให้เลือก · ระบบจัดหมวดเกมชัดเจน ค้นหาเกมที่ต้องการได้จากหน้าเดียว ·
// ตรวจสอบเงื่อนไขของแต่ละเกมก่อนเข้าเล่น · ตัวเลือกการเดิมพันหลากหลายตามแต่ละเกม ·
// รองรับทั้งมือถือและคอมพิวเตอร์ · ระบบบัญชีจัดการได้สะดวก · โบนัสคืนยอดเสีย 0.3%
// และแนะนำเพื่อน 0.8% ตรวจสอบก่อนกดรับได้จากหน้าโปรโมชั่น · รองรับธนาคารและวอลเลท
// ตามรายการที่เปิดให้ใช้งาน ตรวจสอบยอดและสถานะฝากถอนจากบัญชีได้โดยตรง ·
// ฝากถอนไม่จำกัด ไม่จำกัดยอดเดิมพัน · แอดมินพร้อมให้บริการตลอด 24 ชั่วโมง
// — ห้ามอ้างชื่อค่ายเกม ชื่อเกมเฉพาะ ค่า RTP อัตราจ่ายเป็นตัวเลข เลขใบอนุญาต
// ปีที่ก่อตั้ง จำนวนสมาชิก "ปลอดภัย 100%" หรือการันตีว่าจะชนะ
//
// Announcement รอบนี้หมุนมาใช้ AnnouncementPremium ทั้งเว็บ — default message ของ
// ไฟล์นั้นเป็นข้อความของ HENG35 รอบนี้อยู่แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message
//
// พาเลตต์ HENG35 รอบ 2026-09-21 (ดำ + ทอง แทนม่วงรอยัล + ทองของรอบก่อน):
// ทองหลัก #ecc55c ใช้กับเลขลำดับ ไอคอน ขอบ และสต็อปกลางของเกรเดียนต์ ·
// ทองสว่าง #fefac4 เป็นสต็อปบน · ทองบรอนซ์ #a3732c เป็นสต็อปล่างและขอบรอง ·
// ทองอ่อน #ffdf8a เป็นสี <strong> · ผิวยกระดับ #1c1710 / การ์ด #12100b ·
// ตัวอักษรบนปุ่มทอง #0d0b0a · เนื้อความ #ece1cb
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 151
const pageDescription = "ทดลองเล่นสล็อต HENG35 ไล่ดูเกมจากหลายค่ายและตรวจสอบเงื่อนไขก่อนเข้าเล่น ระบบจัดหมวดเกมชัดเจนค้นหาจากหน้าเดียว ไม่ล็อคยูส รองรับทั้งมือถือและคอมพิวเตอร์";

const graph = pageGraph(Astro, {
  name: "ทดลองเล่นสล็อต HENG35 ไล่ดูเกมและเงื่อนไขก่อนเข้าเล่นจริง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title="ทดลองเล่นสล็อต HENG35 ไล่ดูเกมและเงื่อนไขก่อนเข้าเล่นจริง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่นสล็อต HENG35 ไล่ดูเกมและเงื่อนไขก่อนเข้าเล่นจริง" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ece1cb]">
        <strong class="text-[#ffdf8a]">HENG35</strong> เปิดรับสมาชิกใหม่ที่ต้องการเริ่มเล่นสล็อตผ่านระบบที่ใช้งานง่าย ไม่ล็อคยูส
        หน้านี้จึงเปิดไว้ให้คนที่ยังไม่คุ้นกับระบบได้<strong class="text-[#ffdf8a]">ไล่ดูเกมจากหลายค่ายและตรวจสอบเงื่อนไขของแต่ละเกมก่อนเข้าเล่นจริง</strong>
        ตั้งแต่โครงของหมวดหมู่ ไปจนถึงตัวเลือกการเดิมพันที่เกมนั้นเปิดให้เลือก
      </p>

      <p class="text-left text-base leading-relaxed text-[#ece1cb]">
        ภายในระบบ<strong class="text-[#ffdf8a]">มีเกมจากหลายค่ายให้เลือก และแต่ละเกมมีเงื่อนไขกับตัวเลือกการเดิมพันไม่เหมือนกัน</strong>
        การเปิดดูข้อมูลของเกมก่อนจึงช่วยให้เลือกเกมที่เหมาะกับสไตล์ของตัวเองได้ง่ายขึ้น
        และรู้ล่วงหน้าว่าเกมนั้นเล่นอย่างไรก่อนกดรอบแรก
      </p>
    </div>
  </ContentBox>

  <ContentBox title="เลือกดูเกมตามหมวดหมู่ของ HENG35 จากหน้าเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ece1cb]">
        จุดที่ช่วยให้ไล่ดูเกมได้เร็วที่สุดคือ<strong class="text-[#ffdf8a]">ระบบจัดหมวดเกมไว้อย่างชัดเจน</strong>
        คนที่ต้องการค้นหาเกมที่สนใจจึงทำได้จากหน้าเดียว ไม่ต้องไล่เปิดทีละหน้าเพื่อหาว่าค่ายหรือแนวเกมที่ต้องการอยู่ตรงไหน
        และเมื่อเจอเกมที่ต้องการแล้วยังตรวจสอบเงื่อนไขของเกมนั้นได้จากจุดเดียวกัน
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#ece1cb]">
        <li class="flex gap-3">
          <span class="font-bold text-[#ecc55c]">1.</span>
          <span><strong class="text-[#ffdf8a]">เปิดหน้าเว็บของ HENG35 แล้วดูแถบหมวดหมู่เกม</strong> ระบบจัดหมวดไว้ชัดเจนตั้งแต่หน้าแรก จึงเห็นภาพรวมของเกมทั้งหมดได้ทันที</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#ecc55c]">2.</span>
          <span>
            <strong class="text-[#ffdf8a]">เลือกหมวดที่อยากลองก่อน</strong> ภายในระบบมีเกมจากหลายค่ายให้เลือก ถ้ายังไม่แน่ใจว่าถนัดแบบไหน ให้ไล่เปิดดูทีละหมวดเพราะแต่ละค่ายวางฟีเจอร์และจังหวะเกมต่างกัน
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#ecc55c]">3.</span>
          <span>
            <strong class="text-[#ffdf8a]">เปิดดูข้อมูลของเกมที่สนใจก่อนเลือกเล่น</strong> แต่ละเกมมีหน้าข้อมูลของตัวเอง เปิดดูหลายรายการเทียบกันก่อนแล้วค่อยเลือกตัวที่ถูกใจได้
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#ecc55c]">4.</span>
          <span>
            <strong class="text-[#ffdf8a]">ตรวจสอบเงื่อนไขของเกมนั้นให้ครบก่อนเข้าเล่น</strong> ดูว่าฟีเจอร์และรอบพิเศษของเกมเข้าเงื่อนไขอย่างไร ก่อนจะเริ่มเล่นจริง
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#ecc55c]">5.</span>
          <span>
            <strong class="text-[#ffdf8a]">ดูตัวเลือกการเดิมพันที่เกมเปิดให้เลือก</strong> แต่ละเกมมีตัวเลือกไม่เท่ากัน เทียบจากยอดต่ำสุดขึ้นไปเพื่อดูว่าระดับไหนเหมาะกับงบที่ตั้งไว้
          </span>
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#ece1cb]">
        <strong class="text-[#ffdf8a]">รายการเกมที่เปิดให้ใช้งานเปลี่ยนแปลงได้ตามรอบอัปเดตของระบบ จึงควรตรวจสอบรายการล่าสุดจากหน้าเกมของเว็บไซต์ทุกครั้งก่อนเริ่มเล่น</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title="จุดที่ควรดูให้ครบก่อนเลือกเกมที่จะเล่นจริง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ece1cb]">
        การไล่ดูเกมมีประโยชน์ที่สุดเมื่อมองมันเหมือนการอ่านคู่มือ ไม่ใช่การลุ้นรางวัล
        <strong class="text-[#ffdf8a]">เป้าหมายคือรู้จักระบบให้ครบก่อนที่เครดิตจริงจะเข้ามาเกี่ยวข้อง</strong>
        ห้าเรื่องด้านล่างคือสิ่งที่ควรเก็บข้อมูลไว้ระหว่างเปิดดู
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#ece1cb]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ecc55c]">🗂️</span>
          <span><strong class="text-[#ffdf8a]">โครงของเมนูและหมวดหมู่เกม</strong> จำให้ได้ว่าหมวดไหนอยู่ตรงไหน และสลับไปดูเกมของอีกค่ายได้จากจุดใด จะได้ไม่ต้องหาใหม่ตอนเล่นจริง</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ecc55c]">🎰</span>
          <span>
            <strong class="text-[#ffdf8a]">เงื่อนไขของเกมที่เลือก</strong> แต่ละเกมมีรายละเอียดของตัวเองในหน้าเกม อ่านให้จบว่าฟีเจอร์พิเศษเข้าเงื่อนไขใดก่อนเริ่มเล่น
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ecc55c]">🎁</span>
          <span>
            <strong class="text-[#ffdf8a]">โปรโมชั่นที่ระบบกำหนดไว้</strong> เปิดหน้าโปรโมชั่นควบคู่ไปด้วย เพื่อดูว่ารายการคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% มียอดที่เข้าเกณฑ์ รอบรับสิทธิ์ และเงื่อนไขอย่างไร
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ecc55c]">📱</span>
          <span>
            <strong class="text-[#ffdf8a]">ความลื่นไหลบนเครื่องของคุณเอง</strong> ระบบรองรับทั้งมือถือและคอมพิวเตอร์ ลองเปิดจากเครื่องที่ใช้จริงแล้วดูว่าภาพและปุ่มตอบสนองดีไหม
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ecc55c]">💡</span>
          <span><strong class="text-[#ffdf8a]">งบที่คุณรับความเสี่ยงได้</strong> เทียบตัวเลือกการเดิมพันของเกมกับทุนก้อนที่ตั้งใจจะเติมจริง แล้วดูว่าระดับไหนทำให้เล่นได้นานพอจะสนุก</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#ece1cb]">
        <strong class="text-[#ffdf8a]">เกมสล็อตตัดสินผลแต่ละรอบแบบสุ่ม ไม่มีสูตร ไม่มีจังหวะ และไม่มีเวลาไหนที่รับประกันว่าจะชนะ</strong>
        ข้อมูลที่เก็บได้จากการเปิดดูเกมช่วยให้เลือกเกมที่เหมาะกับสไตล์ตัวเองเท่านั้น ไม่ได้ชี้ผลของรอบถัดไป
        จึงควรกำหนดงบล่วงหน้าและหยุดเมื่อถึงขีดที่ตั้งไว้เสมอ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="HENG35 ใช้งานได้ทั้งบนมือถือและคอมพิวเตอร์ ฝากถอนไม่จำกัด" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ece1cb]">
        ไม่ว่าจะเปิดจากคอมพิวเตอร์หรือโทรศัพท์มือถือ ลำดับการใช้งานก็เหมือนกัน เพราะ<strong class="text-[#ffdf8a]">ระบบของ HENG35 รองรับทั้งมือถือและคอมพิวเตอร์ พร้อมระบบบัญชีที่จัดการได้สะดวก</strong>
        และทำงานผ่านเว็บเบราว์เซอร์ จึงไม่ต้องติดตั้งโปรแกรมเพิ่มก่อนเริ่มใช้งาน
      </p>

      <p class="text-left text-base leading-relaxed text-[#ece1cb]">
        เมื่อพร้อมเล่นจริงแล้ว ฝั่งการจัดการเครดิต ระบบ<strong class="text-[#ffdf8a]">รองรับช่องทางธนาคารและวอลเลทตามรายการที่เว็บไซต์เปิดให้ใช้งาน</strong>
        เลือกช่องทางที่เหมาะกับตัวเองได้ตามรายการนั้น และ<strong class="text-[#ffdf8a]">ตรวจสอบยอดกับสถานะฝากถอนจากบัญชีได้โดยตรง</strong>
        โดยขั้นตอนถูกจัดให้เข้าใจง่าย และรองรับการทำรายการตามวงเงินและเงื่อนไขที่ระบบกำหนด
      </p>

      <p class="text-left text-base leading-relaxed text-[#ece1cb]">
        หากติดปัญหาระหว่างใช้งาน ไม่ว่าจะเป็น<strong class="text-[#ffdf8a]">การสมัคร โบนัสฝากแรก โปรโมชั่น การเข้าเกม หรือระบบฝากถอน</strong>
        สามารถติดต่อแอดมิน HENG35 ได้ตลอด 24 ชั่วโมง ทีมงานพร้อมช่วยตรวจสอบข้อมูลและแนะนำขั้นตอนใช้งานตามปัญหาที่แจ้ง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="สมัครสมาชิก HENG35 ยูสใหม่ ไม่ล็อคยูส รับโบนัสฝากแรก" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ece1cb]">
