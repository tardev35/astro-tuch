---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import popularGamesImage from "../assets/gamedemo8.webp";
import newGamesImage from "../assets/gamedemo16.webp";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริง
// ของบรีฟรอบนี้เท่านั้น (src/assets/content.txt) ไม่ใช่แก้ทับประโยคของแบรนด์ก่อน
// — ย่อหน้าเก่าทั้งย่อหน้าตั้งอยู่บนคำที่ brand-spec §6 สั่งห้าม จึงต้องเขียนใหม่
// ไม่ใช่ find-and-replace
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// ดรอปนี้ (2026-10-09) คือ **ฐานเว็บสล็อตหลักที่รวบรวมเกมสล็อตหลายรูปแบบไว้ใน
// แพลตฟอร์มเดียว** ธีมป่ากับกอริลลาสวมมงกุฎ ไม่ใช่เว็บลอตเตอรีและไม่ใช่เว็บรวมทุกหมวด
// (สองหน้าของหมวดลอตเตอรีจอดอยู่ใน src/pages-disabled/ ไม่มี route จึงห้ามลิงก์ไปหา
// มิฉะนั้นเป็น href ตายที่ทำให้ build แดง) แง่มุมที่บรีฟระบุไว้มีเท่านี้:
// รวมเกมสล็อตหลายรูปแบบในแพลตฟอร์มเดียว (เกมคลาสสิก ฟรีสปิน โบนัส ตัวคูณ
// สล็อตวงล้อทั่วไป เกมที่มีฟีเจอร์พิเศษ) · เดิมพันเริ่มต้น 1 บาทในเกมที่กำหนด
// ตามช่วงเดิมพันที่ผู้ให้บริการกำหนด · สล็อตเบทต่ำ ทุนน้อยก็เล่นได้ · ทางเข้าเล่น
// ผ่านมือถือได้ตลอด 24 ชั่วโมง · เลือกค่าย ตรวจสอบเครดิต ติดตามรายการจากบัญชีเดียว ·
// ตารางจ่ายและรายละเอียดเกมตรวจได้ก่อนเริ่มเล่น · คืนยอดเสีย 0.3% เข้ายูส ·
// แนะนำเพื่อน 0.8% แชร์ลิงก์ · ยอดที่เข้าเกณฑ์ · รอบคำนวณ · รอบตัดยอด · ฝากถอน
// เข้าบริษัทโดยตรง บัญชีปลายทาง นิติบุคคล หลักฐานธุรกรรม · แอดมิน 24 ชั่วโมง ·
// รหัสผ่าน PIN OTP
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามี "โหมดทดลอง" เครดิตทดลอง หรือเดโมฟรีเป็นบริการของเว็บ —
// จึงห้ามสัญญาสินค้าตัวนั้น คำว่า "ทดลองเล่น" บนหน้านี้จึงหมายถึงสิ่งที่บรีฟระบุไว้
// ตรงๆ ว่าทำได้: เปิดเว็บไล่ดูหมวดเกมและเมนูให้ครบหนึ่งรอบ ดูช่วงเดิมพันกับตารางจ่าย
// ของเกม อ่านเงื่อนไขของโปรโมชั่น และตรวจสอบเครดิตกับรายการต่างๆ ก่อนจะเริ่มเล่นจริง
//
// ⚠️ รูปในหน้านี้ใช้ได้แค่ gamedemo8 กับ gamedemo16 เท่านั้น — เป็นอาร์ตสต็อกกลาง
// ของเทมเพลต ไม่ใช่อาร์ตเวิร์กของแบรนด์นี้ จึงอยู่ต่อได้ แต่ alt ต้องบรรยายภาพจริง
// (รอบนี้เปิดรูปอ่านซ้ำแล้ว ไม่ได้ลอก alt มาเฉยๆ) และห้ามเอ่ยชื่อแบรนด์ใด
// ส่วน gamedemo7/9/10/11/12/14/15/17/18 มีโลโก้หรือชื่อของผู้ให้บริการเจ้าอื่น
// พิมพ์ทับอยู่กลางรูป และ gamedemo13 เป็นภาพล่อแหลม — ห้ามนำกลับมาใช้ เพราะเท่ากับ
// อ้างชื่อที่บรีฟไม่ได้เอ่ย ไฟล์ยังอยู่บนดิสก์ ห้ามลบ เป็นอินเวนทอรี
// gamedemo8 ("POPULAR GAME" 600x379) กับ gamedemo16 ("New Game" 650x411) ไม่มี
// ชื่อแบรนด์ใดปรากฏ ความกว้างที่วาดจริงสูงสุด ~600px ต่อใบ (กริดสองคอลัมน์ในการ์ด)
// จึงไม่ขยายเกินต้นฉบับ
//
// ⚠️ คำที่ห้ามหลงเหลือ: ศัพท์ของหมวดอื่นที่ไม่ใช่สล็อต และคำขายของของแบรนด์ก่อนๆ
// ที่บรีฟรอบนี้ไม่ได้เอ่ย — รายการเต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อ
// ไม่ให้ grep หาคำต้องห้ามเจอ false positive รายการตรวจก่อนเริ่มเล่น (<ol> ด้านล่าง)
// รอบนี้เขียนใหม่ทั้งสี่ข้อให้อ้างเฉพาะสิ่งที่บรีฟพูดถึงจริง
//
// ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 1 บาท · 0.3% · 0.8% · 24 ชั่วโมง
// ห้ามเติมเลขใบอนุญาต หน่วยงานกำกับ ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP ยอดฝากขั้นต่ำ
// จำนวนสมาชิก หรือปีที่ก่อตั้ง เพราะบรีฟไม่ได้เอ่ยไว้สักอย่าง
//
// ประโยคกำกับของบรีฟที่ห้ามตัดทิ้ง (เป็นส่วนหนึ่งของคอปปี้ ไม่ใช่ filler):
// การยืนยันว่าเป็นเว็บแท้และปลอดภัยควรมีข้อมูลผู้ให้บริการที่ตรวจสอบได้รองรับ ·
// เบทต่ำไม่ได้แปลว่าโอกาสชนะมากกว่า เพราะผลการหมุนเป็นแบบสุ่ม และแต่ละเกมกำหนด
// ยอดขั้นต่ำต่างกัน · ควรอ่านเงื่อนไขก่อนรับสิทธิ์ · คำว่าไม่จำกัดควรตรวจสอบว่า
// หมายถึงอะไร · ชื่อบัญชีบริษัทอย่างเดียวไม่สามารถรับประกันความปลอดภัยของธุรกรรม
// ได้ทั้งหมด · ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP แม้ผู้นั้นจะอ้างว่าเป็นเจ้าหน้าที่
//
// banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion · banner2/banner3 และ
// slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import (ลำพังการ import ก็ทำให้
// ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น Announcement3 ทั้งเว็บ (รอบก่อนใช้ Announcement5 —
// brand-spec §3 หมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้
// ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่ง
// จะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **เขียวนีออนป่า x ทองมงกุฎ บนเขียวป่าเกือบดำ**
// พลิกจากคู่ม่วงนีออน-ทองของแบรนด์ก่อน ซึ่งออกครบทุกจุดแล้ว ทั้งคลาส Tailwind
// raw hex และ rgba() (ค่าเดิมอยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้
// grep หาสีแบรนด์เก่าเจอ false positive)
// ลำดับปุ่มสื่อด้วย "ทองถม vs เขียวโปร่ง": ปุ่มหลักถมทองไล่ #f2c230 → #a87a08
// ขอบ #a87a08 หมึกเขียวเกือบดำ #06220a · ปุ่มรองและปุ่มลิงก์ภายในเป็นผิวการ์ด
// #14380a → #0f2e05 ขอบเขียว #5cc211/55 หมึกเขียวอ่อน #bde397 · ขอบรูปใช้เขียว
// แบรนด์แบบโปร่ง · marker ของลำดับเลขใช้ทองมงกุฎ #f2c230
// ⚠️ ห้ามกลับด้าน: พื้นถมทองต้องใช้หมึกเข้มเสมอ ห้ามครีมหรือขาว และห้ามวาง
// ตัวอักษรสว่างบนเขียวสด #5cc211 หรือเขียวกลาง #2f8c07 — ทั้งคู่เป็นสีของขอบและเงา
// ⚠️ ทองไม่ใช่ตัวบอกว่าถูกแบรนด์: ทองของรอบก่อนๆ เป็นคนละค่ากับ #f2c230 ของรอบนี้
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #e9f7d6)
// ไว้ที่ตัวการ์ดแล้ว ข้อความในหน้านี้จึงไม่ประกาศสีของตัวเองเลย ปล่อยให้สืบทอดลงมา
// — มีแค่ปุ่ม ขอบรูป และ marker ของลำดับเลขที่ประกาศสี เพราะเป็นพื้น/เส้น ไม่ใช่
// เนื้อความ ส่วน <strong> ใช้น้ำหนักตัวอักษรเป็นไฮไลต์ ไม่ประกาศสี และแต่ละ
// <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ
// ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 158 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} ด้วยการไล่ดูหมวดเกมสล็อตและเมนูในระบบจริง ทั้งการเลือกค่าย ช่วงเดิมพันเริ่มต้น 1 บาท ตารางจ่าย เครดิต และเงื่อนไขโปรโมชั่น ก่อนเริ่มเล่น`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ไล่ดูหมวดเกมสล็อตและเมนูในระบบก่อนเริ่มเล่นจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong>{BRAND_NAME}</strong> เป็นฐานเว็บสล็อตหลักที่รวบรวมเกมสล็อตหลายรูปแบบไว้ในแพลตฟอร์มเดียว
        <strong>ทั้งเกมคลาสสิก ฟรีสปิน โบนัส และตัวคูณ พร้อมทางเข้าเล่นผ่านมือถือได้ตลอด 24 ชั่วโมง</strong>
        หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับระบบได้ไล่ดูให้ครบหนึ่งรอบ ตั้งแต่เมนูเลือกค่ายและหมวดเกม ไปจนถึงการตรวจสอบเครดิต การติดตามรายการต่างๆ และเงื่อนไขของโปรโมชั่น ก่อนจะเริ่มเล่นจริง
      </p>

      <p>
        คำว่า ทดลองเล่น ที่หน้านี้พูดถึงจึงหมายถึง
        <strong>การเปิดเว็บไซต์ไล่ดูหมวดเกมสล็อตที่เปิดให้เลือก ดูช่วงเดิมพันกับตารางจ่ายของแต่ละเกม อ่านเงื่อนไขของโปรโมชั่นที่เปิดอยู่ และดูว่าข้อมูลแต่ละอย่างแสดงไว้ตรงไหนของหน้าจอ</strong>
        ซึ่งเป็นสิ่งที่ระบบเปิดให้ทำได้อยู่แล้ว ไม่ใช่การแจกเครดิตทดลอง ไม่ใช่การหมุนฟรี และไม่ใช่การรับประกันผลของเกมใดเกมหนึ่ง เมื่อเข้าสู่ระบบแล้ว สมาชิกจะเลือกค่าย ตรวจสอบเครดิต และติดตามรายการต่างๆ ได้จากบัญชีเดียว
      </p>

      <p>
        อีกเรื่องที่ควรไล่ดูไปพร้อมกันคือขอบเขตของสิ่งที่เปิดให้บริการจริง
        <strong>เพราะการยืนยันว่าเป็นเว็บแท้และปลอดภัยควรมีข้อมูลผู้ให้บริการที่ตรวจสอบได้รองรับ</strong>
        และรายชื่อค่ายกับเกมที่เปิดอยู่ก็เปลี่ยนแปลงได้ตามช่วงเวลา การไล่ดูด้วยตัวเองหนึ่งรอบจึงให้ข้อมูลตรงกว่าถ้อยคำบนหน้าประชาสัมพันธ์ และใช้ตัดสินใจได้จริงกว่าค่าที่จำไว้จากรอบก่อนหน้า
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`หมวดเกมสล็อตและเมนูที่ ${BRAND_NAME} เปิดให้ไล่ดูจากบัญชีเดียว`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        หลังเข้าสู่ระบบ ลำดับการใช้งานจะเป็นชุดเดียวกันทุกครั้ง
        <strong>เปิดเมนูเลือกค่าย ไล่ดูหมวดเกมสล็อตที่สนใจ ตรวจสอบเครดิตของตัวเอง อ่านรายการโปรโมชั่นที่เปิดอยู่ แล้วจึงติดตามรายการต่างๆ ย้อนหลัง</strong>
        การไล่ดูให้ครบรอบหนึ่งก่อนจึงช่วยให้รู้ว่าข้อมูลแต่ละอย่างอยู่ตรงไหนของหน้าจอ และหาเมนูที่ต้องใช้จริงได้เร็วขึ้นในครั้งถัดไป
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={popularGamesImage}
