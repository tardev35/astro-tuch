---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement4.astro";

import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion,
// /login, /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์
// หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ (src/assets/content.txt) ไม่มี
// หมวด "ทดลองเล่น" และไม่มีส่วน SUB-PAGES เลย ทั้งหน้าจึงเขียนขึ้นใหม่จาก
// ข้อเท็จจริงและคลังคำของบรีฟรอบนี้ (brand-spec §6) ไม่ใช่แก้ทับประโยคของแบรนด์ก่อน
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
//   h1  ทดลองเล่น <แบรนด์> ไล่ดูกติกาและเงื่อนไขฝากถอนให้ครบก่อนเดิมพันจริง
//   h2  ไล่ดูกติกา อัตราจ่าย และประเภทการเดิมพันของแต่ละเกมก่อนเริ่ม
//   h2  สิ่งที่ควรตรวจสอบให้ครบก่อนสมัครสมาชิกและทำรายการฝากถอน
//   h2  โปรโมชั่นและช่องทางติดต่อแอดมิน <แบรนด์> ตลอด 24ชม.
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// 🚨 **ความต่างที่สำคัญที่สุดของรอบนี้กับรอบก่อน**: รอบก่อนอยู่คนละหมวดโดย
// สิ้นเชิง ส่วนรอบนี้คือ **ระบบดูแลการเงิน** = ช่องทางฝากถอนผ่านธนาคารชั้นนำ
// และวอลเลท พร้อมข้อมูลเกมห้าประเภท (สล็อต ไฮโล ยิงปลา หวย บอล) และจุดขายที่
// บรีฟย้ำซ้ำที่สุดคือ **ความปลอดภัยของบัญชีรับเงิน / ไม่ผ่านบัญชีม้า**
// ศัพท์หมวดของรอบก่อนจึงเป็น **คำค้างที่ต้องไม่เหลือแม้แต่คำเดียว**
// (รายการเต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบ
// ถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง) ทั้งหน้าเขียนใหม่หมด
// ไม่ใช่ find-and-replace ทับประโยคเดิม
// ⚠️ บรีฟรอบนี้มีเกม **ห้าหมวดเท่านั้น ไม่ใช่หก** ห้ามเติมหมวดที่หกเข้ามาเอง
// ⚠️ และ **นี่ไม่ใช่เว็บหวยด้วย** หวยเป็นเพียง 1 ใน 5 ประเภทเกมที่บรีฟเอ่ยถึง
// สองหน้าหมวดลอตเตอรีจอดอยู่ใน src/pages-disabled/ ไม่มี route ห้ามลิงก์ไปหา
// เป็น href ตายที่ทำให้ build แดง route ที่มีจริงรอบนี้คือ / · /about-us ·
// /contact-us · /login · /privacy · /promotion · /register · /terms ·
// /ทดลองเล่น · /ทางเข้า · /line
//
// กรอบของบรีฟรอบนี้คือ **รวบรวมช่องทางฝากถอนและข้อมูลเกมออนไลน์ไว้ในเว็บไซต์
// เดียว พร้อมให้ตรวจสอบรายละเอียดธุรกรรมและติดต่อเจ้าหน้าที่เมื่อพบปัญหา** บวก
// โปรโมชั่นคืนยอดเสีย 0.3% กับแนะนำเพื่อน 0.8% และช่องทางติดต่อเจ้าหน้าที่ 24ชม.
//
// 🚨 **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกม ชื่อธนาคาร หรือผู้ให้บริการแม้แต่รายเดียว**
// จึงห้ามเขียนชื่อใดๆ ลงหน้าเว็บ · ⚠️ บรีฟรอบนี้ **ไม่ได้เอ่ยถึงใบอนุญาต
// ผู้กำกับดูแล นิติบุคคล ค่า RTP ยอดฝากขั้นต่ำเป็นตัวเลข จำนวนสมาชิก หรือปีก่อตั้ง**
// จึงห้ามพูดถึงทั้งหมด และห้ามใช้คำว่า เว็บตรง / ไม่ผ่านเอเย่นต์ / คาสิโนสด / รูเล็ต
// สิ่งที่บรีฟให้มาและอ้างได้คือ: ระบบดูแลการเงิน · ฝากถอน · ธนาคารชั้นนำ ·
// วอลเลท · ปลอดภัยไม่ผ่านม้า · บัญชีม้า · บัญชีแอบอ้าง · ชื่อบัญชีผู้รับเงิน ·
// ชื่อบัญชีปลายทาง · หลักฐานความน่าเชื่อถือ · ธุรกรรม · รายการผิดปกติ ·
// ยอดขั้นต่ำ · ระยะเวลาดำเนินการ · หลักฐานการโอนเงิน · สถานะธุรกรรม · กติกา ·
// สัญลักษณ์ · ผลการทอยลูกเต๋า · ระบบคะแนน · ราคาต่อรอง · อัตราจ่าย ·
// ประเภทการเดิมพัน · ยอดที่นำมาคำนวณ · รอบเวลารับเครดิต · ลิงก์แนะนำ ·
// เชื่อมโยงบัญชี · สมัครสมาชิก · เข้าสู่ระบบ · รหัสผ่าน · รหัส OTP ·
// เจ้าหน้าที่ · เว็บไซต์ทางการ · ประกาศล่าสุด · ข้อกำหนดล่าสุด
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามีโหมดทดลอง เครดิตทดลอง หรือเดโมฟรีเป็นบริการของเว็บ —
// จึงห้ามสัญญาสินค้าตัวนั้น คำว่า "ทดลองเล่น" บนหน้านี้จึงหมายถึงสิ่งที่บรีฟระบุ
// ไว้ตรงๆ ว่าทำได้: ไล่อ่านกติกา อัตราจ่าย ประเภทการเดิมพัน เงื่อนไขฝากถอน และ
// เงื่อนไขของแต่ละโปรโมชั่นให้ครบหนึ่งรอบ และสอบถามเจ้าหน้าที่ ก่อนเริ่มเดิมพันจริง
//
// ⚠️ คำโฆษณาของบรีฟ ("ปลอดภัยไม่ผ่านม้า" · "รับได้ไม่จำกัดยูส" · "ตลอด 24ชม.")
// อยู่ได้เฉพาะในหัวข้อที่บรีฟเขียนไว้เอง (= หัวข้อของ index.astro) ห้ามขยายเป็น
// คำกล่าวอ้างใหม่ เพราะย่อหน้าของบรีฟเองหักล้างทันทีว่าไม่มีรูปแบบใดรับประกันผลกำไร
//
// 🚨 ประโยคกำกับความเสี่ยงของบรีฟที่ห้ามตัดทิ้ง (เป็นเนื้อหาของบรีฟ ไม่ใช่
// filler) และห้ามเขียนเสริมให้กลายเป็นคำโฆษณาที่บรีฟกำลังเตือนเรื่องนั้นอยู่:
// เกมเดิมพันทุกประเภทมีความเสี่ยงต่อการสูญเสียเงิน และไม่มีรูปแบบใดสามารถ
// รับประกันผลกำไรได้ · ควรตรวจสอบชื่อบัญชีผู้รับเงิน ข้อมูลผู้ให้บริการ และ
// หลักฐานความน่าเชื่อถือก่อนโอนเงินทุกครั้ง เพื่อหลีกเลี่ยงบัญชีแอบอ้างหรือ
// บัญชีม้า · หากพบรายการผิดปกติควรหยุดทำธุรกรรมและติดต่อธนาคารหรือผู้ให้บริการ
// ชำระเงินทันที · เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการ
// เดิมพันหรือรับประกันผลตอบแทนในอนาคต · แม้โปรโมชั่นจะระบุว่าไม่จำกัด แต่ควร
// ยืนยันข้อกำหนดเกี่ยวกับจำนวนบัญชีที่เข้าร่วม รอบจ่ายเครดิต และเงื่อนไขการใช้
// โบนัสจากประกาศล่าสุด · ตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ
// เพื่อหลีกเลี่ยงบัญชีที่แอบอ้างชื่อบริการ · ไม่เปิดเผยรหัสผ่านหรือรหัส OTP
// ให้บุคคลอื่น · ควรตรวจสอบเวลาการให้บริการและระยะเวลาตอบกลับล่าสุดอีกครั้ง
//
// 🚨 **รอบนี้หน้านี้ไม่มีรูปเลย และนั่นตั้งใจ** — ดรอปนี้ (brand-spec §5) ไม่มี
// article illustration (ไม่มี banner2+) และ slide1/slide2 ถูกตรึงไว้กับ index
// กับ /promotion เท่านั้น ส่วน gamedemo*.webp ที่แบรนด์เก่ากว่าเคยใช้เป็น
// **อาร์ตสต็อกของเทมเพลตในหมวดอื่น** ซึ่งขัดทั้งแกนแบรนด์และพาเลตของรอบนี้
// จึงไม่ import **ไฟล์ยังอยู่บนดิสก์ ห้ามลบ เป็นอินเวนทอรีของแบรนด์หมวดนั้น
// รอบถัดไป** — แค่ห้าม import (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/
// และ verify-build จะแดงถ้าไม่ถูก render) banner1/banner1-mobile/og.png เป็นของ
// glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า · banner2/banner3 และ slide3/slide4
// เป็นอาร์ตเวิร์กของแบรนด์คนละราย (slide3/slide4 เป็นโปสเตอร์หวยของอีกแบรนด์)
// ห้าม import
//
// ⚠️ ตัวเลขที่อ้างได้มีแค่สามตัวของบรีฟเอง: 0.3% · 0.8% · 24ชม.
// (บรีฟรอบนี้ไม่มีรายการ sub-list แบบนับเป็นขั้นตอนให้ใช้เลย)
//
// Announcement รอบนี้หมุนมาเป็น Announcement4 ทั้งเว็บ (brand-spec §3)
// orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว
// จึงเรียกแบบ bare **ห้ามส่ง prop message** มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// 🚨 พาเลตรอบนี้ (brand-spec §2) เป็น **ธีมสว่างแบรนด์แรกของรีโปนี้ — กลับทิศจาก
// ทุกรอบก่อนหน้า** bg.json ของดรอปนี้คือ {"mode":"color","color":"#f0ccf5"} =
// ชมพูอมม่วงสว่าง ไม่ใช่ดำ **ห้าม "แก้" กลับไปเป็นพื้นเข้มเพราะรอบก่อนๆ เป็นแบบนั้น**
// ⚠️ **ชมพูเคยนำมาแล้วสามแบรนด์** (ถอนชัวร์168 · มีโชค168 · มีเฮ168) "มีชมพูอยู่"
// จึงไม่ใช่ตัวบอกว่าถูกแบรนด์ ให้เทียบเป็น **"ค่า"** ทีละตัวกับตารางใน
// brand-spec §2 ไม่ใช่ด้วยตา (ค่าของแบรนด์เก่าไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep
// หาสีแบรนด์เก่าเจอ false positive ในไฟล์นี้เอง)
// ค่าที่ใช้ได้ในไฟล์นี้: โรสเข้ม #a4186b (หัวข้อ/<strong>/marker — 7.2:1 บนผิว
// การ์ดขาว) · หมึกพลัม #4a0d35 (เนื้อความ = BRAND_TEXT, 14.9:1) ·
// ชมพูบานเย็น #dd1b74 (พื้นถม/ขอบ/ออรา) · ขาว #ffffff (ตัวอักษรบนพื้นถมชมพู) ·
// อินเซ็ต #f7dcf6 / พื้นเพจ #f0ccf5
// 🚨 **#dd1b74 ได้ 4.67:1 บนผิวการ์ดขาว — ผ่าน AA เฉียดฉิว** จึงเป็น
// **พื้นถม / ขอบ / ออรา** เท่านั้น และ **ห้ามเป็นสีไฮไลต์ <strong> ในเนื้อความ**
// สีไฮไลต์ <strong> มีตัวเดียวคือโรสเข้ม #a4186b · ถ้าต้องการตัวอักษรที่อ่านว่า
// "ชมพูสด" ให้ถม #dd1b74 เป็นพื้นแล้ววาง #ffffff ทับ — ปุ่มสมัครสมาชิกทำแบบนั้น
// 🚨 **#f0ccf5 และ #f7dcf6 ห้ามถือตัวอักษรบนพื้นขาว** เป็นสีพื้น/ขอบเท่านั้น
// ออราที่อนุญาต: rgba(221,27,116,α) · rgba(164,24,107,α) · rgba(74,13,53,α)
// ⚠️ ห้ามกลับด้าน: พื้นถมชมพู #dd1b74 ต้องใช้ตัวอักษรขาวเสมอ ห้ามหมึกเข้ม
// · รอบนี้ไม่มีทอง/เหลือง ไม่มีแดงชาด ไม่มีบรอนซ์ ไม่มีฟ้า/น้ำเงิน ไม่มีเขียว
// ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์ ไม่มีส้ม · #00B900 ไม่ปรากฏในไฟล์นี้
// (ปุ่ม LINE อยู่บน /about-us กับ /contact-us) ปุ่มในไฟล์นี้จึงมีสามขั้ว:
// พื้นถมชมพู vs พื้นถมโรส-พลัม vs อินเซ็ตขอบชมพูโปร่ง
// marker ของลำดับเลขใช้โรสเข้ม #a4186b (เป็นตัวอักษร จึงใช้ #dd1b74 ไม่ได้)
// และชิปไอคอนใช้ชมพูบานเย็นเป็น **เส้นขอบ** บนอินเซ็ต #f7dcf6 ไม่ถือตัวอักษร
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT
// #4a0d35, 14.9:1 บนผิวการ์ดขาว) ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่
// ประกาศสีของตัวเอง ปล่อยให้สืบทอดลงมา และไม่ใส่ mx-auto / max-w-* บน <p> เพราะ
// การ์ดคุมความกว้างเองแล้ว — มีแค่ปุ่ม ชิปไอคอน marker ของลำดับเลข และ <strong>
// ที่ประกาศสี โดย <strong> ใช้โรสเข้ม #a4186b ตัวเดียวตาม brand-spec §2
// และแต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่
// เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง
// และห้ามวาง <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังในข้อความของ prop
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 151 อักขระ เป็นประโยคเดียวที่บอกว่าหน้านี้มีไว้ทำอะไร แล้วหยุด
// (Google ตัดราว 155 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนยาวเกิน)
//
// ห้ามให้สตริงนี้มีชื่อของสองหน้าหมวดลอตเตอรีที่จอดอยู่ใน src/pages-disabled/
// (ชื่อไฟล์ทั้งสองอยู่ใน brand-spec §7) เพราะ sweep ของรอบถัดไปจะอ่านเป็น
// false positive ว่ายังมีลิงก์ไปหน้าที่ไม่มี route
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} หน้ารวมวิธีไล่ดูกติกา อัตราจ่าย และประเภทการเดิมพันของแต่ละเกม พร้อมสิ่งที่ควรตรวจสอบก่อนสมัครสมาชิกและก่อนทำรายการฝากถอนทุกครั้ง`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ไล่ดูกติกาและเงื่อนไขฝากถอนให้ครบก่อนเดิมพันจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#a4186b]">{BRAND_NAME} รวบรวมช่องทางฝากถอนและข้อมูลเกมออนไลน์หลายประเภทไว้ในเว็บไซต์เดียว</strong>
        ทั้งสล็อต ไฮโล ยิงปลา หวย และฟุตบอล พร้อมเมนูสมัครสมาชิก เข้าสู่ระบบ และตรวจสอบโปรโมชั่น หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับระบบได้ไล่ดูให้ครบหนึ่งรอบก่อนเริ่มใช้งานจริง
        ตั้งแต่กติกาและอัตราจ่ายของแต่ละเกม ไปจนถึงเงื่อนไขของการฝากถอนและการรับโปรโมชั่น
      </p>

      <p>
        คำว่า ทดลองเล่น ที่หน้านี้พูดถึงจึงหมายถึง
        <strong class="text-[#a4186b]">การไล่อ่านกติกา อัตราจ่าย และเงื่อนไขบริการให้ครบก่อนเริ่มเดิมพันจริง</strong>
        ไม่ใช่การแจกเครดิตทดลอง และเกมเดิมพันทุกประเภทมีความเสี่ยงต่อการสูญเสียเงิน ไม่มีรูปแบบใดสามารถรับประกันผลกำไรได้ หากพบข้อสงสัยระหว่างใช้งานสามารถสอบถามเจ้าหน้าที่ผ่านช่องทางทางการได้
      </p>

      <p>
        อีกเรื่องที่ควรไล่ดูไปพร้อมกันคือรายละเอียดของบัญชีที่ใช้รับเงิน และรายละเอียดของโปรโมชั่นที่กำลังสนใจ
        <strong class="text-[#a4186b]">เพราะควรตรวจสอบชื่อบัญชีผู้รับเงิน ข้อมูลผู้ให้บริการ และหลักฐานความน่าเชื่อถือก่อนโอนเงินทุกครั้ง</strong>
        เพื่อหลีกเลี่ยงความเสี่ยงจากบัญชีแอบอ้างหรือบัญชีม้า และเพื่อให้ทราบว่าแต่ละโปรโมชั่นให้สิทธิ์ในรอบเวลาใด
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ไล่ดูกติกา อัตราจ่าย และประเภทการเดิมพันของแต่ละเกมก่อนเริ่ม" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        ลำดับการไล่ดูจะเป็นชุดเดียวกันทุกครั้ง
        <strong class="text-[#a4186b]">เปิดหัวข้อของเกมที่สนใจ อ่านกติกาพื้นฐาน แล้วจึงดูประเภทการเดิมพันและอัตราจ่ายของเกมนั้นต่อ</strong>
        จากนั้นค่อยอ่านเงื่อนไขและข้อจำกัดที่เว็บไซต์ระบุไว้ประกอบ การไล่ดูให้ครบหนึ่งรอบก่อนจึงช่วยให้สอบถามเจ้าหน้าที่ได้ตรงประเด็นเมื่อมีข้อสงสัย
      </p>

      <ul class="flex flex-col gap-4" aria-label="จุดที่ควรไล่ดูให้ครบก่อนเริ่มเดิมพันจริง">
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#dd1b74]/50 bg-[#f7dcf6] text-sm">🎰</span>
          <span>
            <strong class="text-[#a4186b]">สัญลักษณ์และอัตราจ่ายของเกมสล็อต</strong> ควรอ่านเป็นรายเกมก่อนเริ่ม เพราะแต่ละเกมมีรูปแบบและฟีเจอร์แตกต่างกัน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#dd1b74]/50 bg-[#f7dcf6] text-sm">🎲</span>
          <span>
            <strong class="text-[#a4186b]">กติกาของไฮโลที่ใช้ผลการทอยลูกเต๋า</strong> ควรอ่านควบคู่กับประเภทการเดิมพันแต่ละแบบ เพื่อให้เห็นว่าอัตราจ่ายที่ระบุไว้มาจากเงื่อนไขอะไร
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#dd1b74]/50 bg-[#f7dcf6] text-sm">🐟</span>
          <span>
            <strong class="text-[#a4186b]">ระบบคะแนนของเกมยิงปลา</strong> ควรแยกศึกษาเป็นรายเกม เพราะวิธีคิดผลไม่เหมือนเกมประเภทอื่นที่อยู่ในเว็บไซต์เดียวกัน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#dd1b74]/50 bg-[#f7dcf6] text-sm">⚽</span>
          <span>
            <strong class="text-[#a4186b]">ราคาต่อรองของฟุตบอลและประเภทการเดิมพันของหวยออนไลน์</strong> ควรอ่านให้ชัดเจนก่อนทำรายการ และตรวจสอบเงื่อนไขที่เว็บไซต์แสดงอยู่ขณะใช้งานอีกครั้ง
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#a4186b]">สิ่งที่การไล่ดูช่วยได้คือทำให้รู้ว่ากติกาและเงื่อนไขอยู่ตรงไหนเท่านั้น</strong>
        ไม่ได้เป็นการรับประกันผลของการเดิมพันหรือยอดเครดิตที่จะได้รับ รายละเอียดที่เว็บไซต์แสดงอยู่ขณะใช้งานจึงเป็นสิ่งที่ควรยึดเป็นหลัก และควรกำหนดงบไว้ล่วงหน้าก่อนเริ่มทุกครั้ง
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/about-us"
          aria-label={`อ่านหน้าเกี่ยวกับเราของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#dd1b74]/45 bg-[#f7dcf6] px-8 py-3 font-bold text-[#4a0d35] shadow-[0_4px_14px_rgba(74,13,53,0.15)] transition-all hover:scale-105 hover:border-[#dd1b74] hover:shadow-[0_6px_18px_rgba(221,27,116,0.3)]">
          อ่านเกี่ยวกับเรา
        </a>

        <a
          href="/promotion"
          aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#dd1b74]/45 bg-[#f7dcf6] px-8 py-3 font-bold text-[#4a0d35] shadow-[0_4px_14px_rgba(74,13,53,0.15)] transition-all hover:scale-105 hover:border-[#dd1b74] hover:shadow-[0_6px_18px_rgba(221,27,116,0.3)]">
          ดูภาพโปรโมชั่น
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="สิ่งที่ควรตรวจสอบให้ครบก่อนสมัครสมาชิกและทำรายการฝากถอน" as="h2">
    <div class="flex flex-col gap-5">
      <p>
        การไล่ดูระบบมีประโยชน์ที่สุดเมื่อมองว่าเป็นการอ่านรายละเอียดให้จบก่อน
        <strong class="text-[#a4186b]">เป้าหมายคือรู้ว่าเว็บไซต์เปิดช่องทางฝากถอนทางใดไว้บ้าง แต่ละรายการมีเงื่อนไขอย่างไร และสอบถามเจ้าหน้าที่ได้ทางไหนเมื่อมีข้อสงสัย</strong>
        รายการด้านล่างคือชุดที่ควรตรวจก่อนสมัครสมาชิก และควรตรวจซ้ำทุกครั้งที่กลับเข้ามาใหม่ เพราะเงื่อนไขปรับเปลี่ยนได้ตามที่เว็บไซต์กำหนด
      </p>

      <ol class="ml-6 list-decimal space-y-3 marker:font-black marker:text-[#a4186b]">
        <li>
          <strong class="text-[#a4186b]">ที่อยู่เว็บไซต์ทางการ</strong> ควรตรวจสอบให้ถูกต้องก่อนเลือกเมนูสมัครสมาชิกหรือกรอกข้อมูลใด ๆ ไม่ใช่เปิดจากลิงก์ที่ส่งต่อกันมา และควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ
          เพื่อหลีกเลี่ยงบัญชีหรือบุคคลที่แอบอ้างชื่อบริการ
        </li>
        <li>
          <strong class="text-[#a4186b]">ชื่อบัญชีปลายทางและรายละเอียดผู้รับเงิน</strong> ควรเทียบกับข้อมูลทางการให้ตรงกันก่อนโอนทุกครั้ง และไม่โอนเงินไปยังบัญชีบุคคลอื่นที่ไม่สามารถยืนยันความเกี่ยวข้องกับผู้ให้บริการได้
          หากสงสัยควรติดต่อธนาคารเพื่อขอคำแนะนำก่อนโอนเงิน
        </li>
        <li>
          <strong class="text-[#a4186b]">เงื่อนไขของการถอนเงิน</strong> ควรศึกษายอดขั้นต่ำ ระยะเวลาดำเนินการ และข้อกำหนดที่เกี่ยวข้องให้ครบถ้วน รวมถึงรายชื่อบริการธนาคารและวอลเลทที่รองรับจริงตามประกาศล่าสุด
        </li>
        <li>
          <strong class="text-[#a4186b]">เงื่อนไขของโปรโมชั่นที่กำลังสนใจ</strong> ควรเปิดอ่านจากข้อกำหนดล่าสุด ทั้งประเภทเกมที่ร่วมรายการ ยอดที่นำมาคำนวณ รอบเวลารับเครดิต และจำนวนบัญชีที่มีสิทธิ์รับโปรโมชั่น
        </li>
        <li>
          <strong class="text-[#a4186b]">ข้อมูลที่จะส่งให้เจ้าหน้าที่ตรวจสอบ</strong> ควรกรอกข้อมูลที่ถูกต้อง ตั้งรหัสผ่านที่ปลอดภัย ไม่ใช้ข้อมูลของบุคคลอื่นในการสมัครสมาชิก และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น แม้จะอ้างว่าเป็นเจ้าหน้าที่ก็ตาม
        </li>
      </ol>

      <p>
        <strong class="text-[#a4186b]">การอ่านให้ครบตั้งแต่ก่อนเริ่มช่วยให้แจ้งเรื่องได้ตรงประเด็นเมื่อเกิดปัญหาขึ้นจริง</strong>
        หากฝากเงินแล้วยอดไม่เข้าระบบ ควรเก็บหลักฐานการโอนเงิน ตรวจสอบสถานะธุรกรรม แล้วติดต่อช่องทางบริการทางการ และหากพบรายการผิดปกติควรหยุดทำธุรกรรมและติดต่อธนาคารหรือผู้ให้บริการชำระเงินทันที
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`โปรโมชั่นและช่องทางติดต่อแอดมิน ${BRAND_NAME} ตลอด 24ชม.`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        เมื่อคุ้นเคยกับขั้นตอนการใช้งานแล้ว เรื่องถัดไปคือรายการโปรโมชั่นที่เว็บไซต์ระบุไว้ ซึ่งมีทั้ง
        <strong class="text-[#a4186b]">คืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อน โบนัส 0.8% ไม่จำกัด</strong>
        โดยรายการแรกระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขในแต่ละวัน จึงควรตรวจสอบว่าเกมสล็อต ไฮโล ยิงปลา หวย หรือฟุตบอลประเภทใดเข้าร่วมรายการบ้าง รวมถึงรอบเวลาคำนวณยอดและวิธีรับเครดิต
        ทั้งนี้ เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือรับประกันผลตอบแทนในอนาคต
      </p>

      <p>
        ส่วนรายการแนะนำเพื่อนควรศึกษาวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และยอดที่ใช้คำนวณโบนัสให้ครบถ้วนก่อนเข้าร่วม แม้โปรโมชั่นจะระบุว่าไม่จำกัด
        แต่ควรยืนยันข้อกำหนดเกี่ยวกับจำนวนบัญชีที่เข้าร่วม รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุดให้ชัดเจน
        <strong class="text-[#a4186b]">หากมีข้อสงสัยสามารถติดต่อเจ้าหน้าที่ผ่านช่องทางทางการเพื่อสอบถามรายละเอียดเพิ่มเติมได้</strong>
        โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่นไม่ว่ากรณีใด และควรตรวจสอบเวลาการให้บริการและระยะเวลาตอบกลับล่าสุดอีกครั้ง
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#a4186b] bg-[#dd1b74] px-8 py-3 font-black text-white shadow-[0_0_14px_rgba(221,27,116,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#4a0d35] bg-gradient-to-b from-[#a4186b] to-[#4a0d35] px-8 py-3 font-bold text-white shadow-[0_0_12px_rgba(164,24,107,0.4)] transition-transform hover:scale-105">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
