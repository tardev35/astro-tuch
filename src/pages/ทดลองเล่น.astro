---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { pageGraph } from "../lib/schema";

// TIGER88 เป็นเว็บสล็อต หน้านี้จึงหมายถึงการลองเกมสล็อตในโหมดทดลองเล่น เพื่ออ่าน
// กติกา ช่วงเดิมพัน อัตราจ่าย Paytable และฟีเจอร์ของแต่ละเกมก่อนใช้เครดิตจริง
// แบรนด์เก่าเคยวางแกลเลอรี 12 การ์ด (gamedemo7..18.webp) ไว้ที่หน้านี้ ตอนนี้ไม่มีการ
// import แล้ว — อย่านำกลับมา เพราะลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/
// และ verify-build จะแดงถ้ามีรูปที่ไม่มีใคร render
//
// ทุกข้อความอ้างอิง src/assets/content.txt เท่านั้น ไม่มีการอ้างใบอนุญาตหรือการันตีผล
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 153
const pageDescription =
  "หน้าทดลองเล่นของ TIGER88 แนะนำวิธีลองเกมสล็อตในโหมดเดโม ตรวจสอบกติกา ช่วงเดิมพัน อัตราจ่าย Paytable และฟีเจอร์ของแต่ละเกม ก่อนเปลี่ยนมาเล่นด้วยเครดิตจริง";

const graph = pageGraph(Astro, {
  name: "ทดลองเล่นสล็อตกับ TIGER88 ก่อนเดิมพันด้วยเครดิตจริง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title="ทดลองเล่น TIGER88 ลองเกมสล็อตทุกค่ายก่อนเดิมพันด้วยเครดิตจริง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่นสล็อตกับ TIGER88 ก่อนเดิมพันด้วยเครดิตจริง" as="h1">
    <div>
      <p class="mb-6 text-left text-base leading-relaxed text-[#f2e3c9]">
        <strong class="text-[#fdd121]">TIGER88</strong> รวมเกมสล็อตออนไลน์จากหลายค่ายไว้ให้เลือกผ่านระบบเดียว ทั้งสล็อตธีมยอดนิยม เกมฟรีสปิน เกมโบนัส และเกมที่รองรับการเดิมพันเริ่มต้นระดับต่ำ
        หน้านี้จึงเปิดไว้ให้ผู้เริ่มต้นได้<strong class="text-[#fdd121]">ลองเล่นในโหมดทดลอง อ่านกติกา และดูอัตราจ่ายของแต่ละเกม</strong>
        ก่อนเริ่มใช้งานจริงด้วยเครดิตของตัวเอง เพราะแต่ละเกมมีช่วงเดิมพันและเงื่อนไขฟีเจอร์ไม่เหมือนกัน การรู้ว่าเกมจ่ายรางวัลจากอะไรช่วยให้เลือกขนาดเดิมพันได้เหมาะกับเงินทุนมากกว่าเดิม
      </p>

      <p class="mb-2 text-left text-base leading-relaxed text-[#f2e3c9]">
        ขอให้เข้าใจตรงกันว่าการทดลองเล่นเป็นการทำความคุ้นเคยกับเกมและระบบเท่านั้น
        <strong class="text-[#fdd121]">เกมสล็อตไม่สามารถรับประกันผลกำไรหรือรางวัล และผลของรอบก่อนหน้าใช้ทำนายรอบถัดไปไม่ได้</strong>
        หากติดปัญหาระหว่างใช้งาน สามารถแจ้งแอดมิน TIGER88 ได้ตลอด 24 ชั่วโมง พร้อมเวลาและรายละเอียดของรายการ เพื่อให้เจ้าหน้าที่ตรวจสอบระบบหลังบ้านได้ตรงจุด
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="โหมดทดลองเล่นสล็อตของ TIGER88 ดูอะไรได้บ้าง" as="h2">
    <div>
      <p class="mb-4 text-left text-base leading-relaxed text-[#f2e3c9]">
        สิ่งที่ควรเปิดดูให้ครบระหว่างทดลองเล่นคือ
        <strong class="text-[#fdd121]">กติกาของเกม ช่วงเดิมพัน อัตราจ่าย Paytable และรายละเอียดของฟีเจอร์หรือรอบพิเศษ</strong>
        เพราะข้อมูลชุดนี้บอกว่าเกมจ่ายรางวัลจากสัญลักษณ์ใดและต้องวางเดิมพันแบบไหนถึงเข้าเงื่อนไขของฟรีสปินหรือรอบโบนัส แทนที่จะเลือกเกมจากคำว่าแตกง่ายเพียงอย่างเดียว
      </p>

      <p class="mb-2 text-left text-base leading-relaxed text-[#f2e3c9]">
        อีกจุดที่ควรดูประกอบกันคือ<strong class="text-[#d6bf95]">ค่ายเกมที่เป็นเจ้าของเกมนั้น</strong>
        เนื่องจากเกมอย่าง Fortune Tiger, Mahjong Ways 2, Lucky Neko และ Wild Bandito มาจากผู้พัฒนาต่างรายและใช้กลไกโบนัสคนละแบบ จึงควรตรวจสอบรายละเอียดจากข้อมูลของค่ายที่แสดงอยู่ในระบบโดยตรง
        แล้วเลือกเกมให้เหมาะกับเงินทุนและระยะเวลาที่ตั้งใจเล่น
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ขั้นตอนเริ่มใช้งาน TIGER88 และลองเกมสล็อตด้วยตัวเอง" as="h2">
    <div>
      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#f2e3c9]">
        <li class="flex gap-3"><span class="font-bold text-[#ff2a36]">1.</span> เปิดหน้าสมัครสมาชิก TIGER88 และกรอกข้อมูลที่ระบบกำหนด ทำผ่านเว็บเบราว์เซอร์บน Android หรือ iOS ได้โดยตรง</li>
        <li class="flex gap-3"><span class="font-bold text-[#ff2a36]">2.</span> Login เข้าบัญชี ตรวจสอบโปรโมชั่นที่มีสิทธิ์รับ และฝากเครดิตผ่านช่องทางที่รองรับ</li>
        <li class="flex gap-3"><span class="font-bold text-[#ff2a36]">3.</span> เลือกค่ายเกมสล็อตที่สนใจ แล้วเปิดอ่านกติกา ช่วงเดิมพัน และอัตราจ่ายของเกมนั้นก่อนเริ่มเดิมพัน</li>
        <li class="flex gap-3"><span class="font-bold text-[#ff2a36]">4.</span> ลองเล่นในโหมดทดลองเพื่อดูจังหวะของเกม รูปแบบการวางเดิมพัน และการทำงานของฟีเจอร์ต่าง ๆ</li>
        <li class="flex gap-3"><span class="font-bold text-[#ff2a36]">5.</span> กำหนดงบประมาณและขนาดเดิมพันที่รับได้ ก่อนเปลี่ยนมาเล่นด้วยเครดิตจริง</li>
      </ol>

      <p class="mt-4 mb-2 text-left text-base leading-relaxed text-[#f2e3c9]">
        ก่อนเริ่มเดิมพันจริงควรแบ่งงบออกเป็นหน่วยย่อยไว้ล่วงหน้า เช่น มีทุน 1,000 บาท ให้คิด 1 หน่วยเท่ากับ 10 บาท แล้ววางขนาดเดิมพันให้อยู่ในระดับที่รับความผันผวนได้
        วิธีนี้<strong class="text-[#fdd121]">ไม่ได้ทำให้เกมจ่ายรางวัลมากขึ้น แต่ช่วยให้รู้ล่วงหน้าว่าแต่ละรอบใช้เงินได้เท่าไร</strong>
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="สิ่งที่ควรตรวจสอบก่อนเปลี่ยนมาเดิมพันด้วยเครดิตจริง" as="h2">
    <div>
      <ul class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#f2e3c9]">
        <li class="flex gap-3">
          <span class="text-[#ff2a36]" aria-hidden="true">•</span> หน้านี้อธิบายการใช้งานและการลองเกมเท่านั้น การเดิมพันจริงต้องสมัครสมาชิกและฝากเครดิตผ่านช่องทางที่เปิดให้บริการก่อน
        </li>
        <li class="flex gap-3">
          <span class="text-[#ff2a36]" aria-hidden="true">•</span> เปิดอ่านกติกา ช่วงเดิมพัน และอัตราจ่าย Paytable ให้ครบ เพราะแต่ละเกมและแต่ละค่ายไม่ได้ใช้เงื่อนไขเดียวกัน
        </li>
        <li class="flex gap-3">
          <span class="text-[#ff2a36]" aria-hidden="true">•</span> หากต้องการเล่นสล็อตขั้นต่ำ 1 บาท ให้ตรวจสอบตัวเลขเดิมพันจริงบนหน้าเกมก่อนกด Spin เพราะขั้นต่ำต่างกันตามเกมและผู้ให้บริการแต่ละราย
        </li>
        <li class="flex gap-3">
          <span class="text-[#ff2a36]" aria-hidden="true">•</span> ตั้งจุดหยุดเมื่อเสียและจุดที่จะพักเมื่อได้กำไรไว้ตั้งแต่ก่อนเริ่ม แล้วหยุดตามแผน ไม่เพิ่มเดิมพันเพื่อไล่เอาเงินคืน
        </li>
        <li class="flex gap-3">
          <span class="text-[#ff2a36]" aria-hidden="true">•</span> อ่านเงื่อนไขโปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ก่อนกดรับทุกครั้ง และไม่เปิดเผยรหัสผ่านหรือ OTP ให้ผู้อื่น
        </li>
        <li class="flex gap-3">
          <span class="text-[#ff2a36]" aria-hidden="true">•</span> สำหรับวงเงินถอนสูงสุดและจำนวนครั้งในการถอน ให้ยึดเงื่อนไขล่าสุดที่แสดงในหน้าฝากถอนเป็นหลัก เพราะอาจต่างกันตามช่องทาง
        </li>
      </ul>

      <p class="mt-4 mb-6 text-left text-base leading-relaxed text-[#f2e3c9]">
        หากพบปัญหาเรื่องการสมัคร Login ไม่ได้ เครดิตฝากไม่เข้า ถอนเงินค้าง โปรโมชั่นไม่แสดง หรือเข้าเกมสล็อตไม่ได้ แจ้งแอดมิน TIGER88 พร้อมเวลา จำนวนเงิน และรายละเอียดของรายการได้ตลอด 24 ชั่วโมง
        และหากเป็นเรื่องธุรกรรมควรเก็บหลักฐานรายการไว้จนกว่าการตรวจสอบจะเสร็จสิ้น โดย
        <strong class="text-[#fdd121]">การเดิมพันมีความเสี่ยง ควรกำหนดงบประมาณให้เหมาะสมทุกครั้ง</strong>
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก TIGER88"
          class="flex items-center justify-center rounded-lg bg-gradient-to-r from-[#ff2a36] via-[#ef1622] to-[#5e0505] px-8 py-3 font-black text-[#f2e3c9] shadow-[0_0_15px_rgba(239,22,34,0.4)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ TIGER88"
          class="flex items-center justify-center rounded-lg border border-[#fdd121]/70 bg-transparent px-8 py-3 font-bold text-[#fdd121] transition-all hover:scale-105 hover:border-[#ffe98a] hover:bg-[#1c0606]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>

  <Navfoot />
</MainLayout>
