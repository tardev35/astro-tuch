---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import popularGamesImage from "../assets/gamedemo8.webp";
import newGamesImage from "../assets/gamedemo16.webp";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริง
// ของบรีฟรอบนี้เท่านั้น (src/assets/content.txt) ไม่ใช่แก้ทับประโยคของแบรนด์ก่อน
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0 (ผังเดิมของหน้า คงไว้)
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// ⚠️ ดรอปนี้ (2026-10-13, TSDET911) คือ **คาสิโน + กีฬา — บาคาร่า ไฮโล สล็อต และ
// แทงบอล** เท่านั้น **ไม่ใช่เว็บสล็อตล้วน ไม่ใช่เว็บกีฬาล้วน** และหมวดเกมอื่นที่
// บรีฟรอบก่อนเคยมี **บรีฟรอบนี้ไม่ได้เอ่ยไว้เลย จึงห้ามเขียนถึง** (ไม่พิมพ์ชื่อหมวด
// เหล่านั้นซ้ำที่นี่ เพื่อไม่ให้ grep หาคำต้องห้ามเจอ false positive) — คำของแบรนด์
// ก่อน (KMD88) เกือบทุกคำอยู่ในลิสต์ห้ามของ brand-spec §7 จึงต้องเขียนประโยคขึ้นใหม่
// ไม่ใช่ find-and-replace ทับของเดิม และไม่ใช่เว็บหมวดลอตเตอรี — สองหน้าของหมวดนั้น
// จอดอยู่ใน src/pages-disabled/ ไม่มี route ห้ามลิงก์ไปหา เป็น href ตายที่ทำให้
// build แดง
//
// แง่มุมที่บรีฟรอบนี้รองรับให้หน้าทดลองเล่นพูดถึงมีเท่านี้: ระบบเข้าเดิมพันผ่าน
// เว็บไซต์ · จัดหมวดเกมให้เลือกใช้งานผ่านมือถือและคอมพิวเตอร์ · ตรวจสอบข้อมูลเกม
// ยอดเดิมพัน และรายการต่างๆ ผ่านบัญชีเดียว · บาคาร่าเป็นเกมไพ่ที่มีตัวเลือกการ
// เดิมพันตามกติกา · ไฮโลใช้ผลจากลูกเต๋าเป็นตัวตัดสิน · สล็อตมีทั้งเกมวงล้อทั่วไป
// และเกมที่มีฟีเจอร์โบนัส · แทงบอลมีรายการแข่งขันพร้อมข้อมูลอัตราต่อรอง ·
// ไม่มีขั้นต่ำกับวงเงินเริ่มต้นที่ต่างกันต่อเกม · กติกา ตารางจ่าย เงื่อนไขการตัดสินผล ·
// คืนยอดเสีย 0.3% เข้ายูสทุกวัน รอบประจำวัน เวลาตัดยอด ยอดที่เข้าเกณฑ์ ·
// แนะนำเพื่อน โบนัส 0.8% ลิงก์แนะนำ · แอดมิน 24 ชั่วโมง ช่องทางหลัก ชื่อเกม ค่าย
// คู่แข่งขัน หมายเลขรายการ PIN OTP
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามี "โหมดทดลอง" เครดิตทดลอง หรือเดโมฟรีเป็นบริการของเว็บ —
// จึงห้ามสัญญาสินค้าตัวนั้น คำว่า "ทดลองเล่น" บนหน้านี้จึงหมายถึงสิ่งที่บรีฟระบุไว้
// ตรงๆ ว่าทำได้: เข้าสู่ระบบแล้วไล่ดูหมวดเกมให้ครบหนึ่งรอบ เลือกเกมที่สนใจ อ่านกติกา
// ตารางจ่าย และเงื่อนไขการตัดสินผลของเกมนั้นให้จบ แล้วจึงเริ่มเดิมพันด้วยเงินจริง
//
// ⚠️ บรีฟรอบนี้ไม่ได้ให้ระบบฝากถอนหรือบัญชีรับเงินไว้เลย (รอบก่อนมี รอบนี้ไม่มี)
// จึงห้ามเขียนขั้นตอนหรือเงื่อนไขการฝากถอนขึ้นเอง หัวข้อสุดท้ายของหน้าจึงพูดถึง
// โปรโมชั่นและแอดมิน ซึ่งเป็นสิ่งที่บรีฟระบุไว้จริง
//
// ⚠️ รูปในหน้านี้ใช้ได้แค่ gamedemo8 กับ gamedemo16 เท่านั้น — เป็นอาร์ตสต็อกกลาง
// ของเทมเพลต (mtime 2026-08-04) ไม่ใช่อาร์ตเวิร์กของแบรนด์นี้ จึงอยู่ต่อได้ แต่ alt
// ต้องบรรยายภาพจริง และห้ามเอ่ยชื่อแบรนด์ใด เพราะไม่มีชื่อแบรนด์ไหนปรากฏอยู่บนรูป
// ทั้งสองใบ ส่วน gamedemo7/9/10/11/12/14/15/17/18 มีโลโก้หรือชื่อของผู้ให้บริการ
// เจ้าอื่นพิมพ์ทับอยู่กลางรูป และ gamedemo13 เป็นภาพล่อแหลม — ห้ามนำกลับมาใช้
// เพราะเท่ากับอ้างชื่อที่บรีฟไม่ได้เอ่ย ไฟล์ยังอยู่บนดิสก์ ห้ามลบ เป็นอินเวนทอรี
// gamedemo8 ("POPULAR GAME" 600x379) กับ gamedemo16 ("New Game" 650x411)
// ความกว้างที่วาดจริงสูงสุด ~600px ต่อใบ (กริดสองคอลัมน์ในการ์ด) จึงไม่ขยายเกิน
// ต้นฉบับ quality={62} ของสองใบนี้ตั้งไว้ต่ำกว่าค่าปกติ 80 มาตั้งแต่รอบก่อน เพราะ
// อาร์ตมีเกรนละเอียดจนไฟล์ AVIF เคยโตกว่า WebP ของตัวเอง (verify-build จะแดง)
// ห้ามดันกลับขึ้น — เป็นค่าต่อรูป ไม่ใช่การจูนต่อฟอร์แมต
//
// ⚠️ คำที่ห้ามหลงเหลือ: คำขายของของแบรนด์ก่อนๆ ศัพท์เว็บสล็อตล้วนของรอบก่อน
// และศัพท์หมวดลอตเตอรีทุกคำ — รายการเต็มอยู่ใน brand-spec §7 ไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาคำต้องห้ามเจอ false positive
//
// ⚠️ ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 24 ชั่วโมง (บวก 100% ที่บรีฟ
// เขียนไว้เองคู่กับ "ผ่านเซิร์ฟไทย") **รอบนี้ไม่มีปี ไม่มีจำนวนขั้นตอนบนหน้านี้**
// และห้ามเติมเลขใบอนุญาต หน่วยงานกำกับ ชื่อผู้ดำเนินงาน ชื่อค่ายเกม ชื่อธนาคาร
// ค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีที่ก่อตั้ง เพราะบรีฟไม่ได้เอ่ยไว้สักอย่าง
//
// ประโยคกำกับของบรีฟที่ห้ามตัดทิ้ง (เป็นส่วนหนึ่งของคอปปี้ ไม่ใช่ filler):
// ส่วนการกล่าวอ้างว่าเป็นเว็บลิขสิทธิ์ไทยแท้และใช้เซิร์ฟเวอร์ในประเทศไทย 100%
// ควรมีข้อมูลใบอนุญาตและผู้ให้บริการระบบที่ตรวจสอบได้ประกอบ · การเดิมพันทุกประเภท
// มีความเสี่ยงและไม่มีระบบใดรับประกันว่าจะได้รับกำไร · ควรตรวจสอบว่าโปรโมชั่น
// ครอบคลุมบาคาร่า ไฮโล สล็อต หรือแทงบอลประเภทใดบ้าง · ควรอ่านรายละเอียดประเภทเกม
// ที่ร่วมรายการ เวลาตัดยอด และเงื่อนไขการใช้โบนัสก่อนรับ · คำว่าไม่จำกัดควรระบุ
// ให้ชัด · ไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น
//
// banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion · banner2/banner3 และ
// slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import (ลำพังการ import ก็ทำให้
// ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น Announcement3 ทั้งเว็บ (รอบก่อนใช้ Announcement5 —
// brand-spec §3 หมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้
// ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่ง
// จะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **น้ำเงินไฟฟ้านำ เงินโครเมียมรอง บนกรมเกือบดำ**
// พลิกออกจากชุดม่วงนำ-ทองรองของรอบก่อน ซึ่งออกครบทุกจุดแล้ว ทั้งคลาส Tailwind
// raw hex และ rgba() (ค่าเดิมอยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep
// หาสีแบรนด์เก่าเจอ false positive) รอบนี้ไม่มีทอง ไม่มีม่วง ไม่มีชมพู ไม่มีเขียว
// ไม่มีส้ม และไม่มีแดงเลย มีแค่น้ำเงินไฟฟ้ากับเงินโครเมียม
// ลำดับปุ่มสื่อด้วยขั้ว "ฟ้าถม vs ผิวจมขอบน้ำเงิน": ปุ่มหลักถมฟ้าไล่เฉด #6ec8ff →
// #0292fb ขอบ #032dad หมึก #021026 (9.8:1 บนปลายสว่าง / 6.0:1 บนปลายเข้ม) ·
// ปุ่มรองและปุ่มลิงก์ภายในเป็นผิวจม #0a1c42 → #040e26 ขอบ #0360f3/55 ตัวอักษร
// #dde8f7 · ขอบรูปใช้น้ำเงินแบรนด์แบบโปร่ง · marker ของลำดับเลขใช้ฟ้าอ่อน #4fb4ff
// (6.0:1 บนผิวการ์ด — เป็นตัวอักษร จึงใช้น้ำเงินแบรนด์ไม่ได้)
// ⚠️ ห้ามกลับด้าน: พื้นถมฟ้าต้องใช้หมึกเข้มเสมอ ห้ามขาวหรือฟ้าอ่อน และ #0360f3
// #0292fb #032dad #04186e #041a43 เป็นเส้น ขอบ ออรา และพื้นถมเท่านั้น ห้ามถือ
// ตัวอักษรทุกขนาด ออราในไฟล์นี้ใช้ rgba(3,96,243,α) และ rgba(2,146,251,α) เท่านั้น
// ⚠️ "มีน้ำเงินอยู่" ไม่ใช่ตัวบอกว่าถูกแบรนด์ — ไฟล์อินเวนทอรีหลายตัวเคยเป็นของ
// แบรนด์ฟ้ามาก่อน ให้เทียบเป็นค่าทีละตัวกับตารางใน brand-spec §2 ไม่ใช่เทียบด้วยตา
// หรือด้วยตระกูลสี
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #dde8f7)
// ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง ปล่อยให้สืบทอดลงมา
// — มีแค่ปุ่ม ขอบรูป marker ของลำดับเลข และ <strong> ที่ประกาศสี โดย <strong>
// ใช้ฟ้าไฮไลต์ #6ec8ff ตัวเดียว (7.4:1 บนผิวการ์ด) และแต่ละ <strong> ครอบ
// "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิด
// แท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 152 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} ไล่ดูหมวดบาคาร่า ไฮโล สล็อต และแทงบอลให้ครบหนึ่งรอบ พร้อมอ่านกติกา ตารางจ่าย และอัตราต่อรองของแต่ละรายการก่อนเริ่มเดิมพันด้วยเงินจริง`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ไล่ดูหมวดเกมคาสิโนและกีฬาก่อนเริ่มเดิมพันจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#6ec8ff]">{BRAND_NAME}</strong> เป็นเว็บพนันออนไลน์ที่นำเสนอระบบเข้าเดิมพันผ่านเว็บไซต์
        <strong class="text-[#6ec8ff]">รองรับเกมหลายประเภททั้งบาคาร่า ไฮโล สล็อต และแทงบอล พร้อมจัดหมวดเกมให้เลือกใช้งานผ่านมือถือและคอมพิวเตอร์ได้สะดวก</strong>
        หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับระบบได้ไล่ดูให้ครบหนึ่งรอบ ตั้งแต่การเข้าสู่ระบบเพื่อค้นหาเกมและเปิดรายละเอียดของรายการที่สนใจ ไปจนถึงเมนูตรวจสอบยอดเดิมพันและการติดตามรายการ ก่อนจะเริ่มเดิมพันจริง
      </p>

      <p>
        คำว่า ทดลองเล่น ที่หน้านี้พูดถึงจึงหมายถึง
        <strong class="text-[#6ec8ff]">การไล่ดูหมวดเกมที่จัดไว้ เลือกรายการที่สนใจ แล้วอ่านกติกา ตารางจ่าย และเงื่อนไขการตัดสินผลของเกมนั้นให้จบก่อนเริ่มเดิมพันด้วยเงินจริง</strong>
        ซึ่งเป็นสิ่งที่ระบบเปิดให้ทำได้อยู่แล้ว ไม่ใช่การแจกเครดิตทดลอง และไม่ใช่การรับประกันผลของรายการใดรายการหนึ่ง เพราะการเดิมพันทุกประเภทมีความเสี่ยงและไม่มีระบบใดรับประกันว่าจะได้รับกำไร
      </p>

      <p>
        อีกเรื่องที่ควรไล่ดูไปพร้อมกันคือขอบเขตของข้อมูลที่เว็บไซต์แจ้งไว้
        <strong class="text-[#6ec8ff]">เพราะการกล่าวอ้างว่าเป็นเว็บลิขสิทธิ์ไทยแท้และใช้เซิร์ฟเวอร์ในประเทศไทย 100% ควรมีข้อมูลใบอนุญาตและผู้ให้บริการระบบที่ตรวจสอบได้ประกอบ</strong>
        ไม่ใช่ยึดจากชื่อแบรนด์หรือข้อความโฆษณาเพียงอย่างเดียว ส่วนการจัดหมวดเกมไว้ในที่เดียวก็ช่วยให้ค้นหาได้สะดวกขึ้นเท่านั้น ไม่ได้เปลี่ยนกติกาของเกมหรือผลของรายการแต่อย่างใด
      </p>
    </div>
  </ContentBox>

