---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import popularGamesImage from "../assets/gamedemo8.webp";
import newGamesImage from "../assets/gamedemo16.webp";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ (src/assets/content.txt) ไม่มีหมวด "ทดลองเล่น" เลย
// ทั้งหน้าจึงเขียนขึ้นใหม่จากคลังคำของบรีฟรอบนี้ ไม่ใช่แก้ทับประโยคของแบรนด์ก่อน
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// ⚠️ ดรอปนี้ (2026-10-18) คือ **เว็บเกมสล็อตล้วน** ไม่ใช่หมวดอื่นใดทั้งสิ้น
// สองหน้าของหมวดที่แบรนด์ก่อนๆ เคยเปิดจอดอยู่ใน src/pages-disabled/ ไม่มี route
// ห้ามลิงก์ไปหา เป็น href ตายที่ทำให้ build แดง route ที่มีจริงรอบนี้คือ
// / · /about-us · /contact-us · /login · /register · /privacy · /promotion ·
// /terms · /ทดลองเล่น · /ทางเข้า · /line
//
// ⚠️ แบรนด์ก่อนหน้าก็เป็นแบรนด์สล็อตเหมือนกัน คอปปี้เดิมจึง "ดูเข้าเค้า" ทั้งที่
// กรอบของบรีฟคนละอัน — **ห้าม find-and-replace ทับประโยคเดิม** วลีแกนของแบรนด์ก่อน
// ถูกถอดออกหมดแล้วทั้งไฟล์ กรอบของบรีฟรอบนี้คือ "ศูนย์รวมช่องทางบริการเกมสล็อต
// ออนไลน์" ที่จัดเมนูสี่อย่างไว้ที่เดียว: สมัครสมาชิก · เข้าเล่น · ฝากถอน ·
// ติดต่อเจ้าหน้าที่ (คำต้องห้ามไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ
// false positive ในคอมเมนต์ของไฟล์นี้เอง — รายการเต็มอยู่ใน brand-spec §6)
//
// ⚠️ บรีฟรอบนี้ **ไม่ได้เอ่ยถึงโครงสร้างพื้นฐาน เอกสารรับรอง ผู้พัฒนาเกม สถาบัน
// การเงิน หรือตัวเลขเชิงสถิติใดๆ ของเว็บ** จึงห้ามพูดถึงทั้งหมด
// สิ่งที่บรีฟให้มาคือ "ค้นหาข้อมูลที่ต้องการได้สะดวก" "ศึกษาขั้นตอนและเงื่อนไข"
// "สอบถามเจ้าหน้าที่ผ่านช่องทางติดต่อที่เว็บไซต์ประกาศไว้" "ตรวจสอบลิงก์ทางการ
// ก่อนกรอกข้อมูล" และ "ตรวจสอบข้อมูลผู้ให้บริการและสถานะลิขสิทธิ์จากหลักฐานทางการ"
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามีโหมดทดลอง เครดิตทดลอง หรือเดโมฟรีเป็นบริการของเว็บ —
// จึงห้ามสัญญาสินค้าตัวนั้น คำว่า "ทดลองเล่น" บนหน้านี้จึงหมายถึงสิ่งที่บรีฟระบุไว้
// ตรงๆ ว่าทำได้: ไล่ดูเมนูเกมสล็อตออนไลน์และขั้นตอนการใช้งานให้ครบหนึ่งรอบ
// ศึกษารายละเอียดกับเงื่อนไข และสอบถามเจ้าหน้าที่ ก่อนเข้าเล่นจริง
//
// ⚠️ รูปในหน้านี้ใช้ได้แค่ gamedemo8 กับ gamedemo16 เท่านั้น — เป็นอาร์ตสต็อกกลาง
// ของเทมเพลต (mtime 2026-08-04) ไม่ใช่อาร์ตเวิร์กของแบรนด์นี้ จึงอยู่ต่อได้ แต่ alt
// ต้องบรรยายภาพจริง และห้ามเอ่ยชื่อแบรนด์ใด เพราะไม่มีชื่อแบรนด์ไหนปรากฏอยู่บนรูป
// ทั้งสองใบ (สีที่ alt บรรยายคือสีที่วาดอยู่บนอาร์ตสต็อกจริง ไม่ใช่สีของพาเลตต์
// รอบนี้ — ห้าม "แก้สี" ใน alt ให้เข้าแบรนด์ เพราะนั่นทำให้ alt บรรยายผิด)
// ส่วน gamedemo7/9/10/11/12/14/15/17/18 มีโลโก้หรือชื่อของผู้ให้บริการ
// เจ้าอื่นพิมพ์ทับอยู่กลางรูป และ gamedemo13 เป็นภาพล่อแหลม — ห้ามนำกลับมาใช้
// เพราะเท่ากับอ้างชื่อที่บรีฟไม่ได้เอ่ย ไฟล์ยังอยู่บนดิสก์ ห้ามลบ เป็นอินเวนทอรี
// gamedemo8 ("POPULAR GAME" 600x379) กับ gamedemo16 ("New Game" 650x411)
// ความกว้างที่วาดจริงสูงสุด ~600px ต่อใบ (กริดสองคอลัมน์ในการ์ด) จึงไม่ขยายเกิน
// ต้นฉบับ quality={62} ของสองใบนี้ตั้งไว้ต่ำกว่าค่าปกติ 80 มาตั้งแต่รอบก่อน เพราะ
// อาร์ตมีเกรนละเอียดจนไฟล์ AVIF เคยโตกว่า WebP ของตัวเอง (verify-build จะแดง)
// ห้ามดันกลับขึ้น — เป็นค่าต่อรูป ไม่ใช่การจูนต่อฟอร์แมต
//
// ⚠️ ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 24 ชั่วโมง · 100% · 3 ขั้นตอน
// ส่วนตัวเลขและชื่อเฉพาะที่ห้ามแต่งขึ้นเองอยู่ครบใน brand-spec §6
//
// ประโยคกำกับของบรีฟที่ห้ามตัดทิ้ง (เป็นส่วนหนึ่งของคอปปี้ ไม่ใช่ filler):
// ควรตรวจสอบข้อมูลผู้ให้บริการและสถานะลิขสิทธิ์จากหลักฐานทางการก่อนใช้งาน ·
// แต่ละเมนูควรมีรายละเอียดขั้นตอนและเงื่อนไขให้ศึกษาอย่างชัดเจน · ควรอ่าน
// รายละเอียดเกี่ยวกับยอดที่นำมาคำนวณ ระยะเวลารับสิทธิ์ และเงื่อนไขการใช้โบนัส ·
// เครดิตคืนยอดเสียไม่ใช่การรับประกันว่าจะได้รับผลตอบแทนจากการเดิมพัน ·
// ควรเพิ่มเพื่อนผ่านลิงก์หรือ QR Code ที่แสดงอยู่บนเว็บไซต์ทางการเท่านั้น ·
// ไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น · ระยะเวลาตอบกลับขึ้นอยู่กับ
// การให้บริการจริงของเจ้าหน้าที่
//
// banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion · banner2/banner3 และ
// slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import (ลำพังการ import ก็ทำให้ไฟล์
// ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้หมุนมาเป็น Announcement5 ทั้งเว็บ (brand-spec §3)
// orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียก
// แบบ bare ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ทองนำ โรสโกลด์เป็นฮิวที่สอง แดงชาดเป็น
// สำเนียงลึกที่ไม่เคยนำ บนดำสนิท**
// ⚠️ สามแบรนด์ก่อนหน้ามีทองทั้งหมด "มีทองอยู่" จึงไม่ใช่ตัวบอกว่าถูกแบรนด์
// ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน brand-spec §2 (ค่าเดิมไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive) สิ่งที่ทำให้รอบนี้ต่างจริงคือ
// **โรสโกลด์ #f2bba5** ซึ่งเป็น vivid อันดับหนึ่งที่วัดได้จากทั้งโลโก้และแบนเนอร์
// ลำดับความลึก: #241509 ผิวยก (= การ์ด) / #160d06 กลาง / #0b0603 จม / #000000 พื้นเพจ
// ลำดับปุ่มสื่อด้วยขั้ว "ทองถม vs ผิวจมขอบแดงชาด": ปุ่มหลักถมทองไล่เฉด #ffe6a3 →
// #f7c92b ขอบ #8a5f12 หมึก #140c06 (7.9:1 บนปลายเข้ม และ 15.6:1 บนปลายสว่าง) ·
// ปุ่มรองและปุ่มลิงก์ภายในเป็นผิวจม #160d06 → #0b0603 ขอบ #b3121b/55 ตัวอักษร
// #eadfce และ hover ยกขอบเป็นโรสโกลด์ #f2bba5 · ขอบรูปใช้ทองแบรนด์ #f7c92b โปร่ง ·
// marker ของลำดับเลขใช้โรสโกลด์ #f2bba5 (10.4:1 บนผิวการ์ด — เป็นตัวอักษร จึงใช้
// แดงชาดไม่ได้ และ #ffe6a3 สงวนไว้ให้ <strong> เท่านั้น)
// ⚠️ ห้ามกลับด้าน: พื้นถมทองต้องใช้หมึกเข้มเสมอ ห้ามขาวหรือทองอ่อน และ #b3121b
// #5a0a0e #8a5f12 เป็นเส้น ขอบ ออรา และพื้นถมเท่านั้น ห้ามถือตัวอักษรทุกขนาด
// ออราในไฟล์นี้ใช้ rgba(179,18,27,α) · rgba(247,201,43,α) · rgba(242,187,165,α)
// เท่านั้น · รอบนี้ไม่มีม่วง ไม่มีชมพูบานเย็น ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว
// ไม่มีส้ม และไม่มีเงิน/โครเมียมอมฟ้า (#00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE
// ไม่ใช่สีของเว็บ จึงคงไว้ตาม §2)
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #eadfce)
// ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง ปล่อยให้สืบทอดลงมา
// — มีแค่ปุ่ม ขอบรูป marker ของลำดับเลข และ <strong> ที่ประกาศสี โดย <strong>
// ใช้ทองสว่าง #ffe6a3 ตัวเดียว (14.5:1 บนผิวการ์ด) และแต่ละ <strong> ครอบ
// "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิด
// แท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 152 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} หน้ารวมวิธีไล่ดูเมนูเกมสล็อตออนไลน์ ขั้นตอนฝากถอน และเงื่อนไขโปรโมชั่นให้ครบก่อนเข้าสู่ระบบจริง พร้อมติดต่อเจ้าหน้าที่ได้ 24 ชั่วโมง`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ไล่ดูเมนูเกมสล็อตออนไลน์ก่อนเข้าเล่นจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#ffe6a3]">{BRAND_NAME} เป็นศูนย์รวมช่องทางบริการเกมสล็อตออนไลน์ที่จัดเมนูสมัครสมาชิก เข้าเล่น ฝากถอน และติดต่อเจ้าหน้าที่ไว้ในเว็บไซต์เดียว</strong>
        หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับระบบได้ไล่ดูให้ครบหนึ่งรอบก่อนเข้าเล่นจริง ตั้งแต่เมนูเกมสล็อตออนไลน์ที่เว็บไซต์จัดเตรียมไว้ ไปจนถึงรายการฝากถอนและรายละเอียดโปรโมชั่นที่เปิดให้เข้าร่วม
      </p>

      <p>
        คำว่า ทดลองเล่น ที่หน้านี้พูดถึงจึงหมายถึง
        <strong class="text-[#ffe6a3]">การศึกษาขั้นตอนและเงื่อนไขของแต่ละเมนูให้ครบก่อนเข้าสู่ระบบจริง</strong>
        ไม่ใช่การแจกเครดิตทดลอง และไม่ใช่การรับประกันผลของรายการใดรายการหนึ่ง หากติดขัดระหว่างใช้งานสามารถสอบถามเจ้าหน้าที่ผ่านช่องทางติดต่อที่เว็บไซต์ประกาศไว้ได้ตลอด 24 ชั่วโมง
      </p>

      <p>
        อีกเรื่องที่ควรไล่ดูไปพร้อมกันคือข้อกำหนดของเว็บไซต์ที่เกี่ยวกับการเปิดบัญชี รายการฝากถอน และการใช้งานทั่วไป
        <strong class="text-[#ffe6a3]">ทั้งนี้ ควรตรวจสอบข้อมูลผู้ให้บริการและสถานะลิขสิทธิ์จากหลักฐานทางการก่อนใช้งาน</strong>
        เพื่อให้เข้าใจรายละเอียดตามที่เว็บไซต์ระบุไว้จริง ไม่ใช่ยึดจากข้อความที่ส่งต่อกันมาเพียงอย่างเดียว
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ไล่ดูเมนูเกมสล็อตออนไลน์และขั้นตอนการใช้งานให้ครบหนึ่งรอบ" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        หลังเข้าสู่ระบบ ลำดับการใช้งานจะเป็นชุดเดียวกันทุกครั้ง
