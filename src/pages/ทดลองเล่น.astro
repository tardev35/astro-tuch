---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { Picture } from "astro:assets";

import popularGamesImage from "../assets/gamedemo8.webp";
import newGamesImage from "../assets/gamedemo16.webp";

import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login,
// /register หรือหน้าภาพแบบ /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง
// ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้
// (src/assets/content.txt) ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่จาก
// ข้อเท็จจริงและคลังคำของบรีฟรอบนี้เท่านั้น (.claude/brand-spec-lotto189.md §4-§5)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x4 · h3x0
//   h1  ทดลองเล่น <แบรนด์> ศึกษารูปแบบรายการหวยก่อนยืนยันบิล
//   h2  ประเภทหวยที่เปิดให้บริการ ต่างกันที่รอบประกาศผลและรูปแบบการเดิมพัน
//   h2  รอบปิดรับและรอบประกาศผล สองจุดที่ควรตรวจก่อนเลือกหมายเลข
//   h2  อัตราจ่าย 2 ตัว 100 และ 3 ตัว 1,000 ใช้กับการเดิมพันรูปแบบใด
//   h2  ทดลองเลือกหมายเลขก่อนยืนยันบิล และสิ่งที่ควรตรวจซ้ำทุกครั้ง
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// **การ์ดรูปสองใบอยู่ใน h2 ใบแรก ไม่ได้แยกเป็นหัวข้อของตัวเอง** เพื่อคงผัง h2x4
// ป้ายกำกับของการ์ดรูปอยู่ในตัวภาพเอง (alt) ไม่มีป้ายข้อความใดเป็น heading
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// 🚨🚨 **รอบนี้กลับทิศจากรอบก่อน: จากเว็บสล็อต (ZNOVA168) มาเป็นเว็บหวย/ลอตโต้**
// คอปปี้ทั้งหน้าจึงถูกเขียนใหม่ให้พูดถึง **รูปแบบรายการหวย รอบปิดรับ อัตราจ่าย
// และการทดลองเลือกหมายเลขก่อนยืนยันบิล** แทนการเล่นเกม
// 🚨🚨 **คำว่า "ทดลองเล่น" อยู่ได้เฉพาะเพราะเป็นชื่อ route /ทดลองเล่น และชื่อเมนู
// จริง** (ใช้ใน h1 · title · description · breadcrumb) แต่ **บรีฟรอบนี้ไม่ได้
// พูดถึงโหมดวางบิลโดยไม่ใช้เงินจริงเลยแม้แต่ประโยคเดียว** → **ห้ามอ้างว่าเว็บมี
// โหมดนั้นให้** ห้ามอ้างจำนวนรายการที่เปิดรับ ห้ามอ้างเวลาเปิด-ปิดรับเป็นตัวเลข
// และห้ามอ้างว่าสถิติหรือเลขย้อนหลังคาดการณ์ผลรอบถัดไปได้
// แกนของหน้าจึงเป็น **"สิ่งที่ควรศึกษาและตรวจสอบเกี่ยวกับรายการหวยที่ระบุไว้
// ก่อนยืนยันบิลด้วยเงินจริง"** ตามที่บรีฟมีจริง (บรรทัด 4, 6, 8, 20):
// หวยรัฐบาลไทย · หวยลาว · หวยฮานอย · หวยหุ้นต่างประเทศ · รอบประกาศผลที่แตกต่างกัน ·
// รอบปิดรับ · อัตราจ่าย 2 ตัว 100 และ 3 ตัว 1,000 · สองตัวบน/สองตัวล่าง ·
// สามตัวตรง/สามตัวโต๊ด · วงเงินจ่ายสูงสุด · **ผลการออกรางวัลไม่สามารถรับประกันได้
// จากสถิติหรือเลขย้อนหลัง**
// ⚠️ และมีหนึ่งประโยคที่พูดตรงๆ ว่าบรีฟไม่ได้ระบุโหมดนั้นไว้ เพื่อไม่ให้ผู้อ่าน
// อนุมานเอาจากชื่อเมนู — **ห้ามถอดประโยคนั้นออก**
// ⚠️ บรีฟรอบนี้ **โฆษณาและกำกับในประโยคเดียวกัน** คำโฆษณาอยู่ได้เฉพาะในขอบเขตที่
// บรีฟเขียนไว้เอง ห้ามขยายเป็นคำกล่าวอ้างใหม่ และทุกประโยคกำกับต้อง ship ครบ
// ห้ามตัดเพราะฟังดูลบ
//
// ⚠️⚠️ ชื่อแบรนด์รอบนี้เป็น **ตัวละตินพิมพ์ใหญ่ + เลข เขียนติดกัน ไม่มีเว้นวรรค**
// (brand-spec §0) ทุกจุดยัง interpolate จาก BRAND_NAME เหมือนเดิม เพื่อไม่ให้ค้าง
// เป็นชื่อแบรนด์ก่อนหน้าตอนรีแบรนด์รอบถัดไป ห้ามพิมพ์ชื่อตรงๆ
// ⚠️⚠️ ศัพท์หมวดสล็อตของแบรนด์ขาออกเป็น **คำค้างข้ามแบรนด์** ห้ามหลุดกลับมา
// **รายการคำต้องห้ามเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่** เพื่อไม่ให้
// sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// 🚨🚨 **บรีฟรอบนี้ไม่พูดถึงธนาคาร วอลเลท การฝากถอน หรือโปรโมชั่นเลยแม้แต่คำเดียว**
// — หัวข้อ "ฝากถอน" และหัวข้อโปรโมชั่นที่เคยอยู่บนหน้านี้ตอนรอบก่อนๆ
// **ถูกตัดออกทั้งบล็อก** และ **0.3% / 0.8% ห้ามหลุดเข้าหน้านี้** (เขียนได้เฉพาะ
// ใน alt ของ /promotion ซึ่งโปสเตอร์พิมพ์ไว้จริง)
//
// ⚠️ **รอบนี้สองหน้าหมวดหวยถูกเปิดใช้งาน** (orchestrator ย้ายกลับเข้า src/pages/
// เพราะรอบนี้เป็นเว็บหวย) → ลิงก์ไป /ตรวจหวย และ /แนวทาง จากหน้านี้ **ทำได้**
// route ที่มีจริงรอบนี้: / · /about-us · /contact-us · /promotion · /ทดลองเล่น ·
// /ทางเข้า · /ตรวจหวย · /แนวทาง · /login · /register · /terms · /privacy ·
// 404 · /line
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อผู้ให้บริการ หน่วยงานกำกับ ใบอนุญาต ปีก่อตั้ง
// จำนวนสมาชิก จำนวนรายการที่เปิดรับ เวลาเปิด-ปิดรับเป็นตัวเลข หรือยอดเดิมพัน
// ขั้นต่ำ แม้แต่รายการเดียว** จึงห้ามเขียนลงหน้าเว็บ ·
// ตัวเลขที่ขึ้นหน้าได้มีแค่ของบรีฟเอง: **2 ตัว 100 · 3 ตัว 1,000 · 3 ขั้นตอน ·
// 24ชม.** และหน้านี้หยิบมาใช้แค่ **2 ตัว 100 กับ 3 ตัว 1,000** เพราะเป็นสองค่า
// ที่เกี่ยวกับแกนของหน้า
//
// 🚨 **รูปในหน้านี้ใช้ได้แค่ gamedemo8 กับ gamedemo16 เท่านั้น** — เป็นอาร์ตสต็อก
// กลางของเทมเพลต (mtime 2026-08-04) **ไม่ใช่อาร์ตเวิร์กของดรอปนี้ และไม่ใช่ของ
// แบรนด์ไหน** จึงใช้เป็นภาพประกอบตกแต่งได้ แต่ **ห้ามใช้แทนอาร์ตเวิร์กแบรนด์**
// gamedemo8 (600x379) กับ gamedemo16 (650x411) ไม่มีโลโก้หรือชื่อผู้ให้บริการ
// เจ้าอื่นพิมพ์ทับอยู่ ส่วน gamedemo7/9/10/11/12/14/15/17/18 มีโลโก้หรือชื่อของ
// ผู้ให้บริการเจ้าอื่นพิมพ์ทับอยู่กลางรูป และ gamedemo13 เป็นภาพล่อแหลม —
// **ห้ามนำกลับมาใช้**
// ⚠️⚠️ **ทั้งสองใบพิมพ์คำว่า POPULAR GAME / New Game ไว้บนภาพจริง** ซึ่งเป็น
// ข้อเท็จจริงของรูป alt จึงบอกตามนั้น **แต่คอปปี้ของหน้าห้ามอ้างว่าเว็บมีหมวด
// "เกม" ใดๆ** รูปคู่นี้เป็น **ภาพประกอบตกแต่ง** เท่านั้นในรอบหวยนี้
// ⚠️ เปิดรูปจริงทั้งสองใบรอบนี้แล้ว · alt บรรยายสิ่งที่เห็นจริง (กระต่ายกับแมวใส่
// แว่นกันแดดและหูฟังขนาบหีบสมบัติ / ตัวละครหัวฟักทองกับโครงกระดูกบนลานเรืองแสง)
// **ไม่ใช่ตัวนับแบบ "ภาพที่ 1"** และไม่เอ่ยชื่อแบรนด์ เพราะไม่มีชื่อแบรนด์ใด
// พิมพ์อยู่บนรูป
// ⚠️ ทั้งสองใบวาดกว้างสุด 600px (กริดสองคอลัมน์ตั้งแต่ sm ขึ้นไป) widths/sizes
// จึงตั้งตามนั้น ไม่ใช่ตามขนาดไฟล์ต้นฉบับ
// 🚨 **ห้าม import อาร์ตเวิร์กของแบรนด์อื่นจากหน้านี้เด็ดขาด**: แบนเนอร์ใบที่สอง
// และสาม (2026-10-23) กับสไลด์ใบที่สามและสี่ (2026-09-29) เป็นของแบรนด์อื่น
// (ชื่อไฟล์เต็มอยู่ใน brand-spec §6) · สไลด์สองใบของดรอปนี้ถูกตรึงไว้กับ
// index §4 กับ /promotion · banner1 /
// banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักไว้ **ห้ามอ้างจากหน้านี้**
// · ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ ทุก build และ verify-build จะแดง
// · ไฟล์เก่าทั้งหมดยังอยู่บนดิสก์ **ห้ามลบ** เป็นอินเวนทอรีของแบรนด์ถัดไป
//
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) **เนื้อหาเป็นธีมสว่าง โครมเป็นผิวเข้ม**
// bg.json ของดรอปนี้คือ {"mode":"color","color":"#fff0f0"} = **ขาวอมชมพูจาง**
// (รอบก่อนเป็นครีมอมงาช้างอุ่น คนละค่า) **ห้ามเดาว่าเท่าเดิม และห้าม "แก้" การ์ด/ปุ่ม
// ให้เป็นพื้นมืดตามโครม** — พื้นมืดบนหมึก #25090f = ตัวอักษรหายไปเลย
// ค่าที่ใช้ได้ในไฟล์นี้: หัวข้อ/`<strong>`/marker ของลำดับเลข **#b00718**
// (7.3:1 บนการ์ดขาว) · เข้มสุด #25090f (18.7:1) · หมึกรอง #6e3b44 (8.8:1) ·
// แดงแบรนด์ #c1071b (6.6:1) · แดงลึก #8a0412 (10.4:1) · ทองเข้ม #8f6310
// (5.3:1) · พื้นไล่เฉดปุ่มหลัก #8a0412 -> #b00718 -> #d61023 (**พื้นถม** +
// หมึกขาว #ffffff) · ปุ่มรองเป็นผิวสว่าง #ffffff -> #ffe4e6 คู่กับหมึก #25090f ·
// ผิวยก #ffe4e6 · wash #ffd4d7 · เส้นอ่อน #f5b9bd · เส้นเข้ม #a8333f
// (**ทั้งคู่ห้ามถือตัวอักษร** ใช้เป็นขอบการ์ดรูปได้)
// หมึกเนื้อความคือ #25090f (= BRAND_TEXT) ซึ่ง **ไม่ประกาศในไฟล์นี้** การ์ด
// ContentBox ตั้งไว้ให้แล้วและย่อหน้าสืบทอดลงมา
// 🚨🚨 **#ff2436 บนพื้นขาวได้แค่ 3.9:1 และ #e9b53c ได้ 2.0:1 — ห้ามเป็นสี
// ตัวอักษร** และ **ขาวบนสองค่านั้นก็ตก AA** พื้นที่รับหมึกขาวได้ต้องเป็น
// **#d61023 (5.3:1) ขึ้นไปหาเข้ม** เท่านั้น · #fff0f0 #ffe4e6 #ffd4d7 #f5b9bd
// #c3ccd6 ก็ห้ามถือตัวอักษร และ #a8333f เป็นเส้น/ขอบเท่านั้น
// 🚨🚨 **#24060c #3d0d16 #120307 #7e1221 #ffeaea #f0bcbc เป็นค่าของผิวโครมเข้ม
// เท่านั้น ห้ามหลุดเข้ามาในไฟล์นี้**
// ออราที่อนุญาต: rgba(138,4,18,α) · rgba(176,7,24,α) · rgba(193,7,27,α) ·
// rgba(214,16,35,α) · rgba(37,9,15,α) · rgba(245,185,189,α)
// ⚠️⚠️ **รอบนี้ไม่มีม่วง ไม่มีฟ้า/ไซแอน ไม่มีแมเจนต้า ไม่มีส้มเพลิง และไม่มี
// เขียวแบรนด์เลยสักเฉด** — เหรียญทองในรูป gamedemo8 กับอัญมณีในรูป gamedemo16
// เป็น **วัตถุในภาพ ไม่ใช่สี UI** เช่นเดียวกับสูทขาว เก้าอี้อาร์มแชร์ขอบทอง
// ลูกบอลหวย โพยหวย และสีผิวนักแสดงในอาร์ตเวิร์กของแบรนด์
// ⚠️⚠️ **แดง/ทอง/ครีมเป็นตระกูลที่ผ่าน template นี้มาแล้วสิบกว่าเจ้า การเจอแดง
// หรือทองในไฟล์จึงไม่พิสูจน์อะไร** — ห้ามเทียบด้วยวงศ์สี ต้องเทียบทีละค่ากับ
// ตาราง brand-spec §2 (ค่าที่ใกล้จนต้องสงสัยว่าพิมพ์ผิดก่อนเสมอถูกลิสต์ไว้ใน
// ไฟล์นั้นแล้ว และเขียนแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep สะดุด)
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง และไม่ใส่ mx-auto / max-w-* บน <p>
// เพราะการ์ดคุมความกว้างเองแล้ว — ที่ประกาศสีได้มีแค่ปุ่ม ชิปไอคอน marker ของ
// ลำดับเลข ขอบการ์ดรูป และ <strong> · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วย
// ช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ
// บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง และห้ามวาง <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังในข้อความของ prop และต้องเป็นไอคอนหมวดหวย ไม่ใช่ไอคอนหมวดสล็อต
// slot ของ ContentBox รับ **หนึ่ง element** เท่านั้น จึงห่อด้วย <div> ชั้นเดียว
//
// Announcement รอบนี้หมุนมาเป็น AnnouncementHuay ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ตัวเลข 2 ของตระกูลจึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้น
// เป็นคอปปี้ของแบรนด์นี้แล้ว จึงเรียกแบบ bare **ห้ามส่ง prop message** มิฉะนั้น
// ข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -c บนเชลล์นี้
// ก็นับเป็นไบต์ ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับตัวนับ
// ของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 153 อักขระ (ชื่อแบรนด์รอบนี้ 8 อักขระ) เป็นประโยคเดียวที่บอกว่า
// หน้านี้มีไว้ทำอะไร แล้วหยุด
// (Google ตัดราว 160 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนๆ ยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} รวมสิ่งที่ควรศึกษาก่อนยืนยันบิล ทั้งประเภทหวยที่เปิดรับ รอบปิดรับ รอบประกาศผล อัตราจ่ายของแต่ละรายการ และวิธีตรวจทานหมายเลขที่เลือกไว้`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ศึกษารูปแบบรายการหวยก่อนยืนยันบิล`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});

// คลาสปุ่มสามขั้วของหน้านี้ ประกาศครั้งเดียวแล้วใช้ซ้ำ เพื่อไม่ให้สองปุ่มที่ทำ
// หน้าที่เดียวกันหลุดไปคนละเฉดตอนรีแบรนด์รอบหน้า
const ctaPrimary =
  "flex items-center justify-center rounded-full border border-[#8a0412] bg-gradient-to-b from-[#8a0412] via-[#b00718] to-[#d61023] px-8 py-3 font-black text-white shadow-[0_6px_18px_rgba(138,4,18,0.3)] transition-transform hover:scale-105";

const ctaSecondary =
  "flex items-center justify-center rounded-full border border-[#a8333f] bg-gradient-to-b from-[#ffffff] to-[#ffe4e6] px-8 py-3 font-bold text-[#25090f] shadow-[0_6px_18px_rgba(245,185,189,0.45)] transition-transform hover:scale-105";

const ctaQuiet =
  "flex items-center justify-center rounded-full border-2 border-[#b00718] bg-[#ffffff] px-8 py-3 font-bold text-[#b00718] shadow-[0_4px_14px_rgba(138,4,18,0.2)] transition-all hover:scale-105 hover:bg-[#ffe4e6] hover:shadow-[0_6px_18px_rgba(176,7,24,0.2)]";

const listChip = "mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#f5b9bd] bg-[#ffe4e6] text-sm";

const gameCard = "mx-auto block h-auto w-full max-w-[600px] rounded-2xl border border-[#a8333f]";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#b00718]">{BRAND_NAME} นำเสนอข้อมูลหวยออนไลน์หลายประเภท พร้อมรายละเอียดอัตราจ่ายและรอบประกาศผลที่แตกต่างกัน</strong>
        หน้านี้รวบรวมไว้ว่าควรศึกษาอะไรเกี่ยวกับรายการที่ระบุไว้ และควรตรวจอะไรซ้ำทุกครั้งที่กลับเข้ามาใหม่ ก่อนยืนยันบิลด้วยเงินจริง
      </p>

      <p>
        ภายในเว็บไซต์รวบรวมรายการหวย รอบปิดรับ และช่องทางติดต่อเจ้าหน้าที่ไว้ในช่องทางเดียว ผู้ใช้งานจึงศึกษารูปแบบการเลือกหมายเลขและเงื่อนไขการเดิมพันได้จากที่เดียว ส่วน
        <strong class="text-[#b00718]">ความถูกต้องของข้อมูลและข้อกำหนดควรตรวจสอบก่อนทำรายการทุกครั้ง เนื่องจากผลการออกรางวัลมีความไม่แน่นอนและไม่สามารถคาดการณ์ได้อย่างแม่นยำ</strong>
        ไม่ใช่สิ่งที่สรุปจากข้อความโฆษณาเพียงอย่างเดียว
      </p>

      <p>
        <strong class="text-[#b00718]">ข้อมูลที่เว็บไซต์ระบุไว้ไม่ได้กล่าวถึงการเปิดให้วางบิลโดยไม่ใช้เงินจริงไว้แต่อย่างใด</strong>
        หน้านี้จึงไม่ยืนยันว่ามีรูปแบบนั้นให้ใช้งาน และควรตรวจสอบจากประกาศล่าสุดของเว็บไซต์ทางการเองว่ารายการใดเปิดให้ศึกษาได้ในลักษณะใด เนื้อหาด้านล่างเขียนไว้ประกอบการใช้งานเท่านั้น ไม่ได้ใช้แทนเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้บริการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ประเภทหวยที่เปิดให้บริการ ต่างกันที่รอบประกาศผลและรูปแบบการเดิมพัน" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        เว็บไซต์ระบุประเภทหวยไว้หลายกลุ่ม และ
        <strong class="text-[#b00718]">แต่ละกลุ่มมีวันประกาศผลและรูปแบบการเดิมพันแตกต่างกัน</strong>
        รายการด้านล่างสรุปไว้ว่าควรมองหาอะไรในแต่ละกลุ่ม โดยไม่ได้ระบุจำนวนรายการหรือเวลาเปิดรับเพิ่มเติม เพราะข้อมูลนั้นต้องดูจากหน้ารายการจริงของเว็บไซต์เท่านั้น
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={popularGamesImage}
          alt="การ์ดภาพประกอบตกแต่ง เป็นภาพกระต่ายการ์ตูนกับแมวการ์ตูนสวมแว่นกันแดดและหูฟัง ยืนขนาบข้างหีบสมบัติที่มีเหรียญทองล้นออกมา มีเหรียญกลมลายโพดำลอยอยู่รอบ ฉากหลังเป็นวงแหวนเรืองแสง และมีข้อความ POPULAR GAME ตัวหนาสีทองอยู่กลางภาพ"
          loading="lazy"
          fetchpriority="low"
          decoding="async"
          widths={[300, 600]}
          sizes="(max-width: 639px) 100vw, 600px"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={62}
          class={gameCard}
        />

        <Picture
          src={newGamesImage}
          alt="การ์ดภาพประกอบตกแต่ง เป็นภาพตัวละครหัวฟักทองสวมหมวกปีกกว้างกับโครงกระดูกการ์ตูนยืนขนาบข้างบนลานกระเบื้องเรืองแสง มีอัญมณีสีสด ดาวสีเหลือง และลูกบาศก์สีชมพูกระจายอยู่ และมีข้อความ New Game ตัวหนาสีขาวอยู่กลางภาพ"
          loading="lazy"
          fetchpriority="low"
          decoding="async"
          widths={[300, 600]}
          sizes="(max-width: 639px) 100vw, 600px"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={62}
          class={gameCard}
        />
      </div>

      <ul class="flex flex-col gap-4" aria-label="ประเภทหวยที่เว็บไซต์ระบุไว้">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🏛️</span>
          <span>
            <strong class="text-[#b00718]">หวยรัฐบาลไทย</strong> เป็นกลุ่มที่รอบประกาศผลห่างที่สุด จุดที่ควรอ่านก่อนคือรอบปิดรับของเว็บไซต์เทียบกับรอบออกรางวัลจริง และรูปแบบการเดิมพันที่รายการนั้นเปิดรับ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🗓️</span>
          <span>
            <strong class="text-[#b00718]">หวยลาว และหวยฮานอย</strong> มีรอบประกาศผลถี่กว่า ควรอ่านให้ชัดว่ารอบที่กำลังจะแทงคือรอบใด และรอบนั้นคิดผลด้วยเงื่อนไขเดียวกับรอบก่อนหน้าหรือไม่
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📈</span>
          <span>
            <strong class="text-[#b00718]">หวยหุ้นต่างประเทศ</strong> คือกลุ่มที่แหล่งอ้างอิงผลต่างกันมากที่สุดระหว่างรายการต่อรายการ การเปิดหน้าเงื่อนไขของรายการนั้นโดยเฉพาะจึงจำเป็นกว่ากลุ่มอื่น ไม่ควรเทียบเอาจากรายการที่เคยแทงมาก่อน
          </span>
        </li>
      </ul>
    </div>
  </ContentBox>

  <ContentBox title="รอบปิดรับและรอบประกาศผล สองจุดที่ควรตรวจก่อนเลือกหมายเลข" as="h2">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#b00718]">รอบปิดรับของเว็บไซต์กับรอบประกาศผลของรายการเป็นคนละค่ากัน</strong>
        และเป็นข้อมูลที่ผูกกับรายการนั้นโดยเฉพาะ ไม่ใช่ค่ากลางที่ใช้ได้กับทุกประเภทในเว็บไซต์ สมาชิกใหม่จึงควรเปิดดูรอบปิดรับของรายการที่จะแทงจากหน้ารายการนั้นเองก่อนทุกครั้ง
      </p>

      <p>
        เหตุผลตรงไปตรงมา คือ
        <strong class="text-[#b00718]">หวยแต่ละประเภทมีวันประกาศผลและรูปแบบการเดิมพันแตกต่างกัน</strong>
        การเห็นรอบของรายการหนึ่งแล้วอนุมานไปถึงรายการอื่นจึงคลาดเคลื่อนได้ตั้งแต่บิลแรก และค่าที่แสดงอยู่บนหน้ารายการในขณะใช้บริการคือค่าที่ใช้จริง ไม่ใช่ค่าที่จำไว้จากครั้งก่อน
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/ตรวจหวย" aria-label={`เปิดหน้าตรวจหวยของ ${BRAND_NAME}`} class={ctaQuiet}>ไปหน้าตรวจหวย</a>

        <a href="/แนวทาง" aria-label={`เปิดหน้าแนวทางของ ${BRAND_NAME}`} class={ctaQuiet}>ไปหน้าแนวทาง</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="อัตราจ่าย 2 ตัว 100 และ 3 ตัว 1,000 ใช้กับการเดิมพันรูปแบบใด" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#b00718]">การอ่านอัตราจ่ายจากตารางของรายการนั้นเอง ตรงกว่าการจำตัวเลขรวมจากหน้าแรก</strong>
        เพราะแต่ละประเภทกำหนดฐานเงินเดิมพันและวงเงินจ่ายสูงสุดไว้คนละชุด รายการด้านล่างคือลำดับที่เปิดอ่านได้เร็วที่สุดก่อนกรอกยอดเดิมพันบิลแรก
      </p>

      <ol class="ml-6 list-decimal space-y-3 marker:font-black marker:text-[#b00718]">
        <li>
          <strong class="text-[#b00718]">อัตราจ่าย 2 ตัว 100</strong> ควรตรวจสอบว่าใช้กับเลขสองตัวบนหรือสองตัวล่าง และคำนวณจากเงินเดิมพันจำนวนเท่าใด เพราะแต่ละประเภทอาจกำหนดอัตราจ่ายไม่เท่ากัน
        </li>
        <li>
          <strong class="text-[#b00718]">อัตราจ่าย 3 ตัว 1,000</strong> ควรตรวจสอบว่าใช้กับสามตัวตรง สามตัวโต๊ด หรือการเดิมพันรูปแบบใด รวมถึงฐานเงินเดิมพันและวงเงินจ่ายสูงสุดของแต่ละรายการ
        </li>
        <li>
          <strong class="text-[#b00718]">ข้อกำหนดการใช้บริการของเว็บไซต์</strong> ควรศึกษาให้ครบก่อนเริ่มใช้งาน เพราะเป็นเอกสารที่ใช้ประกอบการพิจารณาร่วมกับเงื่อนไขการจ่ายรางวัลของแต่ละรายการ
        </li>
        <li>
          <strong class="text-[#b00718]">ประกาศล่าสุดของเว็บไซต์ทางการ</strong> คือจุดที่เงื่อนไขจริงถูกอัปเดต ทั้งรายการที่เปิดรับและตารางอัตราจ่าย การเปิดดูก่อนทุกครั้งจึงตรงกว่าการจำไว้จากครั้งก่อน
        </li>
      </ol>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/register" aria-label={`สมัครสมาชิก ${BRAND_NAME}`} class={ctaPrimary}>สมัครสมาชิก</a>

        <a href="/login" aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`} class={ctaSecondary}>เข้าสู่ระบบ</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="ทดลองเลือกหมายเลขก่อนยืนยันบิล และสิ่งที่ควรตรวจซ้ำทุกครั้ง" as="h2">
    <div class="flex flex-col gap-5">
      <p>
        นอกจากรอบปิดรับและตารางอัตราจ่ายแล้ว
        <strong class="text-[#b00718]">ก่อนยืนยันบิลควรตรวจสอบหมายเลขที่เลือก ประเภทหวย และรอบประกาศผลให้ถูกต้องครบถ้วน</strong>
        การลองจัดหมายเลขดูก่อนช่วยให้เห็นว่าบิลจะถูกบันทึกเป็นรูปแบบใด แต่ไม่ได้บอกว่ารอบถัดไปจะออกอย่างไร และหน้านี้ไม่ระบุตัวเลขของรายการใด เพราะค่าที่ใช้จริงต้องอ่านจากหน้ารายการนั้นเอง
      </p>

      <p>
        ผลการออกรางวัลมีความไม่แน่นอนโดยตัวของมันเอง
        <strong class="text-[#b00718]">ผลการออกรางวัลจึงไม่สามารถรับประกันได้จากสถิติหรือเลขย้อนหลัง</strong>
        และการศึกษาเงื่อนไขช่วยให้เข้าใจว่ารายการคิดผลอย่างไรเท่านั้น ไม่ได้เพิ่มโอกาสถูกรางวัลในรอบใด หากมีข้อสงสัยเกี่ยวกับระบบสมาชิกหรือรายละเอียดบิลหวย ควรสอบถามเจ้าหน้าที่ผ่านช่องทางทางการก่อนทำรายการ โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้ใครทราบ
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/promotion" aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`} class={ctaQuiet}>ดูภาพโปรโมชั่น</a>

        <a href="/contact-us" aria-label={`ดูช่องทางติดต่อทีมงาน ${BRAND_NAME} ทั้งหมด`} class={ctaQuiet}>ช่องทางติดต่อทั้งหมด</a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
