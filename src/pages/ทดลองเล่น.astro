---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import popularGamesImage from "../assets/gamedemo8.webp";
import newGamesImage from "../assets/gamedemo16.webp";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ (src/assets/content.txt) ไม่มีหมวด "ทดลองเล่น" และไม่มี
// ส่วน SUB-PAGES เลย ทั้งหน้าจึงเขียนขึ้นใหม่จากคลังคำของบรีฟรอบนี้ ไม่ใช่แก้ทับ
// ประโยคของแบรนด์ก่อน
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// ⚠️ ดรอปนี้ (2026-10-19) คือ **เว็บสล็อตล้วน** ไม่ใช่หมวดอื่นใดทั้งสิ้น
// สองหน้าของหมวดที่แบรนด์ก่อนๆ เคยเปิดจอดอยู่ใน src/pages-disabled/ ไม่มี route
// ห้ามลิงก์ไปหา เป็น href ตายที่ทำให้ build แดง route ที่มีจริงรอบนี้คือ
// / · /about-us · /contact-us · /login · /register · /privacy · /promotion ·
// /terms · /ทดลองเล่น · /ทางเข้า · /line
//
// ⚠️ แบรนด์ก่อนหน้าก็เป็นแบรนด์สล็อตเหมือนกัน คอปปี้เดิมจึง "ดูเข้าเค้า" ทั้งที่
// กรอบของบรีฟคนละอัน — **ห้าม find-and-replace ทับประโยคเดิม** วลีแกนของรอบก่อน
// (การประกาศตัวเป็นผู้ให้บริการฐานเกม + คำกล่าวอ้างเรื่องอันดับและความเป็นเว็บหลัก
// + ขั้นตอนนับจำนวน) ถูกถอดออกหมดแล้วทั้งไฟล์ กรอบของบรีฟรอบนี้คือ
// **โปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% บนเว็บสล็อต พร้อมระบบฝากถอน
// ผ่านธนาคารและวอลเลท และช่องทาง LINE Official**
// (คำต้องห้ามไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive
// ในคอมเมนต์ของไฟล์นี้เอง — เต็มอยู่ใน brand-spec §6)
//
// 🚨 **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกมแม้แต่ค่ายเดียว** จึงห้ามเขียนชื่อค่ายใดๆ
// ลงหน้าเว็บ ให้ใช้คำกลางว่า "ค่ายเกม" ตาม brand-spec §6
//
// ⚠️ บรีฟรอบนี้ **ไม่ได้เอ่ยถึงใบอนุญาต หน่วยกำกับ นิติบุคคล ชื่อธนาคาร ค่า RTP
// ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีก่อตั้ง** จึงห้ามพูดถึงทั้งหมด สิ่งที่บรีฟให้มา
// และอ้างได้คือ: วิธีรับลิงก์/รหัสแนะนำ · ขั้นตอนการเชื่อมโยงบัญชี · ยอดที่นำมา
// คำนวณโบนัส · รอบคำนวณและรอบจ่ายโบนัส · ประเภทเกมที่ร่วมรายการ · วิธีรับเครดิต
// (อัตโนมัติหรือกดรับเอง) · ยอดขั้นต่ำ ระยะเวลาดำเนินการ และเงื่อนไขการถอนเงิน ·
// หลักฐานการทำรายการ · LINE Official และ QR Code จากเว็บไซต์ทางการ
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามีโหมดทดลอง เครดิตทดลอง หรือเดโมฟรีเป็นบริการของเว็บ —
// จึงห้ามสัญญาสินค้าตัวนั้น คำว่า "ทดลองเล่น" บนหน้านี้จึงหมายถึงสิ่งที่บรีฟระบุไว้
// ตรงๆ ว่าทำได้: ไล่ดูเกมสล็อตของค่ายเกมที่เปิดให้บริการและขั้นตอนการใช้งานให้ครบ
// หนึ่งรอบ ศึกษาเงื่อนไขของแต่ละโปรโมชั่น และสอบถามเจ้าหน้าที่ ก่อนเข้าใช้งานจริง
//
// ⚠️ รูปในหน้านี้ใช้ได้แค่ gamedemo8 กับ gamedemo16 เท่านั้น — เป็นอาร์ตสต็อกกลาง
// ของเทมเพลต (mtime 2026-08-04) ไม่ใช่อาร์ตเวิร์กของแบรนด์นี้ จึงอยู่ต่อได้ แต่ alt
// ต้องบรรยายภาพจริง และห้ามเอ่ยชื่อแบรนด์ใด เพราะไม่มีชื่อแบรนด์ไหนปรากฏอยู่บนรูป
// ทั้งสองใบ (สีที่ alt บรรยายคือสีที่วาดอยู่บนอาร์ตสต็อกจริง ไม่ใช่สีของพาเลตต์
// รอบนี้ — ห้าม "แก้สี" ใน alt ให้เข้าแบรนด์ เพราะนั่นทำให้ alt บรรยายผิด เปิดอ่าน
// บิตแมปทั้งสองใบซ้ำแล้วรอบนี้ ข้อความ alt ยังตรงกับภาพจริงทุกองค์ประกอบ)
// ส่วน gamedemo7/9/10/11/12/14/15/17/18 มีโลโก้หรือชื่อของผู้ให้บริการ
// เจ้าอื่นพิมพ์ทับอยู่กลางรูป และ gamedemo13 เป็นภาพล่อแหลม — ห้ามนำกลับมาใช้
// เพราะเท่ากับอ้างชื่อที่บรีฟไม่ได้เอ่ย ไฟล์ยังอยู่บนดิสก์ ห้ามลบ เป็นอินเวนทอรี
// gamedemo8 ("POPULAR GAME" 600x379) กับ gamedemo16 ("New Game" 650x411)
// ความกว้างที่วาดจริงสูงสุด ~600px ต่อใบ (กริดสองคอลัมน์ในการ์ด) จึงไม่ขยายเกิน
// ต้นฉบับ quality={62} ของสองใบนี้ตั้งไว้ต่ำกว่าค่าปกติ 80 มาตั้งแต่รอบก่อน เพราะ
// อาร์ตมีเกรนละเอียดจนไฟล์ AVIF เคยโตกว่า WebP ของตัวเอง (verify-build จะแดง)
// ห้ามดันกลับขึ้น — เป็นค่าต่อรูป ไม่ใช่การจูนต่อฟอร์แมต
//
// ⚠️ ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 24ชม. ส่วนตัวเลขและชื่อเฉพาะ
// ที่ห้ามแต่งขึ้นเองอยู่ครบใน brand-spec §6
//
// 🚨 ประโยค hedge ของบรีฟที่ห้ามตัดทิ้ง (เป็นเนื้อหาของบรีฟ ไม่ใช่ filler) และ
// ห้ามเขียนเสริมให้กลายเป็นคำโฆษณาที่บรีฟกำลังเตือนเรื่องนั้นอยู่:
// ก่อนเข้าร่วมควรตรวจสอบวิธีคำนวณโบนัสและข้อจำกัดของแต่ละรายการให้ครบถ้วน ·
// แม้โปรโมชั่นจะระบุว่ารับได้ไม่อั้น แต่ควรยืนยันรอบการจ่ายโบนัสและข้อจำกัด
// ที่เกี่ยวข้องก่อนเข้าร่วม · เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจาก
// ทุกรายการหรือรับประกันผลตอบแทนจากการเดิมพัน · หากพบรายการล่าช้าหรือสถานะไม่ถูกต้อง
// ควรเก็บหลักฐานการทำรายการและติดต่อเจ้าหน้าที่ผ่านช่องทางทางการ · ควรตรวจสอบลิงก์
// หรือ QR Code จากเว็บไซต์ทางการก่อนเพิ่มเพื่อน เพื่อหลีกเลี่ยงบัญชีที่แอบอ้าง
// ชื่อบริการ · ไม่ส่งรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น · ควรยืนยันเวลาให้บริการ
// และระยะเวลาตอบกลับล่าสุดจากช่องทางทางการอีกครั้ง
//
// banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion · banner2/banner3 และ
// slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import (ลำพังการ import ก็ทำให้ไฟล์
// ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้หมุนมาเป็น Announcement5 ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ Announcement2 จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็น
// คอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นข้อความ
// ตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ฟ้าไซยานนำ · เหลืองมะนาวรอง · น้ำเงินลึก
// ไม่เคยถือตัวอักษร · บนพื้นดำสนิท**
// ⚠️ รอบที่แล้ว (สบายเบท168) ก็เป็นฟ้านำ + ทองรองเหมือนกันทั้งชุด และแบรนด์เกือบ
// ทุกรายที่ผ่านเทมเพลตนี้มีทอง "มีฟ้าอยู่" หรือ "มีทองอยู่" จึงไม่ใช่ตัวบอกว่าถูก
// แบรนด์ ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน brand-spec §2 (ค่าเดิมไม่พิมพ์ซ้ำ
// ที่นี่ เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive) ฟ้ารอบนี้คือ **#32bcfb**
// (+#a9e9ff +#07335f) และเหลืองรอบนี้คือ **#fef54b** (เหลืองมะนาว ไม่ใช่ทองอำพัน)
// ลำดับความลึก: #0c2a3d ผิวยก (= การ์ด) / #071a28 กลาง / #030e16 จม / #000000 พื้นเพจ
// ลำดับปุ่มสื่อด้วยขั้ว "พื้นฟ้าตัน vs กรอบเหลืองโปร่ง vs ผิวจมขอบน้ำเงิน" ตามคู่ปุ่ม
// ของ Navfoot: ปุ่มสมัครสมาชิกถมไล่เฉด #a9e9ff → #32bcfb ขอบ #07335f หมึก #041019
// (13.2:1 บนปลายฟ้าน้ำแข็ง · 8.9:1 บนปลายฟ้าแบรนด์) · ปุ่มเข้าสู่ระบบเป็นกรอบเหลือง
// โปร่ง พื้นผิวจม #071a28 → #030e16 ขอบ #fef54b/80 ตัวอักษร #fef54b (14.6:1 บนผิวจม) ·
// ปุ่มลิงก์ภายในเป็นผิวจมขอบน้ำเงินลึก ตัวอักษร #dceefc และ hover ยกขอบเป็นฟ้า
// แบรนด์ #32bcfb · ขอบรูปใช้ฟ้าแบรนด์ #32bcfb โปร่ง (ฮิวนำต้องเห็นจริงบนหน้า) ·
// marker ของลำดับเลขใช้ฟ้าน้ำแข็ง #a9e9ff (11.3:1 บนผิวการ์ด — เป็นตัวอักษร จึงใช้
// น้ำเงินลึกไม่ได้ และ #fef54b สงวนไว้ให้ <strong> เท่านั้น)
// ⚠️ ห้ามกลับด้าน: พื้นถมฟ้าต้องใช้หมึกเข้มเสมอ ห้ามขาวหรือฟ้าอ่อน และ
// #07335f #6b5c10 เป็นเส้น ขอบ ออรา และพื้นถมเท่านั้น ห้ามถือตัวอักษรทุกขนาด
// ออราในไฟล์นี้ใช้ rgba(7,51,95,α) · rgba(254,245,75,α) · rgba(50,188,251,α)
// เท่านั้น · รอบนี้ไม่มีชมพู ไม่มีม่วง ไม่มีเขียว ไม่มีส้ม ไม่มีเงิน/โครเมียม
// ไม่มีโรสโกลด์ และไม่มีแดง
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #dceefc)
// ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง ปล่อยให้สืบทอดลงมา
// และไม่ใส่ mx-auto / max-w-* บน <p> — มีแค่ปุ่ม ขอบรูป marker ของลำดับเลข และ
// <strong> ที่ประกาศสี โดย <strong> ใช้เหลืองมะนาว #fef54b ตัวเดียว (12.7:1 บนผิว
// การ์ด) และแต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทย
// ไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง
// และห้ามวาง <strong> สองอันติดกัน
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 154 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} หน้ารวมวิธีไล่ดูเกมสล็อตออนไลน์ รายชื่อค่ายเกม กติกาของแต่ละเกม และเงื่อนไขฝากถอน ให้ครบหนึ่งรอบก่อนสมัครสมาชิกและเข้าสู่ระบบใช้งานจริง`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ไล่ดูเกมสล็อตและกติกาของค่ายเกมก่อนเข้าใช้งานจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#fef54b]">{BRAND_NAME} รวบรวมข้อมูลเกมสล็อตออนไลน์และขั้นตอนการใช้งานไว้ในเว็บไซต์เดียว</strong>
        หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับระบบได้ไล่ดูให้ครบหนึ่งรอบก่อนเข้าใช้งานจริง ตั้งแต่รายชื่อค่ายเกมที่เปิดให้บริการ ไปจนถึงขั้นตอนสมัครสมาชิก การเข้าสู่ระบบ การฝากถอนผ่านธนาคารและวอลเลท และเงื่อนไขของโปรโมชั่นที่เปิดให้เข้าร่วม
      </p>

      <p>
        คำว่า ทดลองเล่น ที่หน้านี้พูดถึงจึงหมายถึง
