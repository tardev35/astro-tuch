---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import popularGamesImage from "../assets/gamedemo8.webp";
import newGamesImage from "../assets/gamedemo16.webp";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ (src/assets/content.txt) ไม่มีหมวด "ทดลองเล่น" และไม่มี
// ส่วน SUB-PAGES เลย ทั้งหน้าจึงเขียนขึ้นใหม่จากคลังคำของบรีฟรอบนี้ ไม่ใช่แก้ทับ
// ประโยคของแบรนด์ก่อน
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// ⚠️ ดรอปนี้ (2026-10-18) คือ **เว็บสล็อตล้วน** ไม่ใช่หมวดอื่นใดทั้งสิ้น
// สองหน้าของหมวดที่แบรนด์ก่อนๆ เคยเปิดจอดอยู่ใน src/pages-disabled/ ไม่มี route
// ห้ามลิงก์ไปหา เป็น href ตายที่ทำให้ build แดง route ที่มีจริงรอบนี้คือ
// / · /about-us · /contact-us · /login · /register · /privacy · /promotion ·
// /terms · /ทดลองเล่น · /ทางเข้า · /line
//
// ⚠️ แบรนด์ก่อนหน้าก็เป็นแบรนด์สล็อตเหมือนกัน คอปปี้เดิมจึง "ดูเข้าเค้า" ทั้งที่
// กรอบของบรีฟคนละอัน — **ห้าม find-and-replace ทับประโยคเดิม** วลีแกนของแบรนด์ก่อน
// (แหล่งที่มาของระบบจากต่างประเทศ + รวมค่ายเกมชื่อดังสามค่าย) ถูกถอด
// ออกหมดแล้วทั้งไฟล์ กรอบของบรีฟรอบนี้คือ **เว็บสล็อตฐานหลักที่ขายความง่ายใน
// การถอนเงิน** (คำต้องห้ามไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ
// false positive ในคอมเมนต์ของไฟล์นี้เอง — เต็มอยู่ใน brand-spec §6)
//
// 🚨 **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกมแม้แต่ค่ายเดียว** จึงห้ามเขียนชื่อค่ายใดๆ
// ลงหน้าเว็บ ให้ใช้คำกลางว่า "ค่ายเกม" ตามบรีฟ
//
// ⚠️ บรีฟรอบนี้ **ไม่ได้เอ่ยถึงโครงสร้างพื้นฐาน เอกสารรับรอง สถาบันการเงิน
// หรือตัวเลขเชิงสถิติใดๆ ของเว็บ** จึงห้ามพูดถึงทั้งหมด สิ่งที่บรีฟให้มาคือ
// "ศึกษารายชื่อค่ายเกมสล็อตที่เปิดให้บริการ กติกาของแต่ละเกม และเงื่อนไขฝากถอน
// ก่อนทำรายการ" "ตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง" "ศึกษาขั้นตอนทำรายการและ
// เงื่อนไขการถอนเงินก่อนเริ่มใช้งาน" "สอบถามเจ้าหน้าที่เมื่อพบปัญหา" และ
// "ควรตรวจสอบจากหลักฐานและรีวิวหลายแหล่งก่อนตัดสินใจ"
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามีโหมดทดลอง เครดิตทดลอง หรือเดโมฟรีเป็นบริการของเว็บ —
// จึงห้ามสัญญาสินค้าตัวนั้น คำว่า "ทดลองเล่น" บนหน้านี้จึงหมายถึงสิ่งที่บรีฟระบุไว้
// ตรงๆ ว่าทำได้: ไล่ดูเกมสล็อตของค่ายเกมที่เปิดให้บริการและขั้นตอนการใช้งานให้ครบ
// หนึ่งรอบ ศึกษากติกากับเงื่อนไขการถอนเงิน และสอบถามเจ้าหน้าที่ ก่อนเข้าใช้งานจริง
//
// ⚠️ รูปในหน้านี้ใช้ได้แค่ gamedemo8 กับ gamedemo16 เท่านั้น — เป็นอาร์ตสต็อกกลาง
// ของเทมเพลต (mtime 2026-08-04) ไม่ใช่อาร์ตเวิร์กของแบรนด์นี้ จึงอยู่ต่อได้ แต่ alt
// ต้องบรรยายภาพจริง และห้ามเอ่ยชื่อแบรนด์ใด เพราะไม่มีชื่อแบรนด์ไหนปรากฏอยู่บนรูป
// ทั้งสองใบ (สีที่ alt บรรยายคือสีที่วาดอยู่บนอาร์ตสต็อกจริง ไม่ใช่สีของพาเลตต์
// รอบนี้ — ห้าม "แก้สี" ใน alt ให้เข้าแบรนด์ เพราะนั่นทำให้ alt บรรยายผิด เปิดอ่าน
// บิตแมปทั้งสองใบซ้ำแล้วรอบนี้ ข้อความ alt ยังตรงกับภาพจริงทุกองค์ประกอบ)
// ส่วน gamedemo7/9/10/11/12/14/15/17/18 มีโลโก้หรือชื่อของผู้ให้บริการ
// เจ้าอื่นพิมพ์ทับอยู่กลางรูป และ gamedemo13 เป็นภาพล่อแหลม — ห้ามนำกลับมาใช้
// เพราะเท่ากับอ้างชื่อที่บรีฟไม่ได้เอ่ย ไฟล์ยังอยู่บนดิสก์ ห้ามลบ เป็นอินเวนทอรี
// gamedemo8 ("POPULAR GAME" 600x379) กับ gamedemo16 ("New Game" 650x411)
// ความกว้างที่วาดจริงสูงสุด ~600px ต่อใบ (กริดสองคอลัมน์ในการ์ด) จึงไม่ขยายเกิน
// ต้นฉบับ quality={62} ของสองใบนี้ตั้งไว้ต่ำกว่าค่าปกติ 80 มาตั้งแต่รอบก่อน เพราะ
// อาร์ตมีเกรนละเอียดจนไฟล์ AVIF เคยโตกว่า WebP ของตัวเอง (verify-build จะแดง)
// ห้ามดันกลับขึ้น — เป็นค่าต่อรูป ไม่ใช่การจูนต่อฟอร์แมต
//
// ⚠️ ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 100% · 3 ขั้นตอน · 24 ชม. ·
// หลักแสนยูสต่อวัน ส่วนตัวเลขและชื่อเฉพาะที่ห้ามแต่งขึ้นเองอยู่ครบใน brand-spec §6
//
// 🚨 ประโยค hedge ของบรีฟที่ห้ามตัดทิ้ง (เป็นเนื้อหาของบรีฟ ไม่ใช่ filler) และ
// ห้ามเขียนเสริมให้กลายเป็นคำโฆษณาที่บรีฟกำลังเตือนเรื่องนั้นอยู่:
// ควรตรวจสอบจากหลักฐานและรีวิวหลายแหล่งก่อนตัดสินใจ · ไม่ควรอาศัยคำโฆษณาว่า
// ถอนได้จริงหรือถอนได้ทุกครั้งเพียงอย่างเดียว · ข้อมูลที่ระบุว่ามีผู้ใช้งาน
// หลักแสนบัญชีต่อวันหรือไม่มีรีวิวเชิงลบ ยังต้องอาศัยหลักฐานที่ตรวจสอบได้ ·
// เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือรับประกัน
// ผลการเล่นในอนาคต · ควรเพิ่มเพื่อนผ่านลิงก์หรือ QR Code จากหน้าเว็บไซต์ทางการ
// เท่านั้น เพื่อป้องกันการติดต่อบัญชีแอบอ้าง · ไม่เปิดเผยรหัสผ่านหรือรหัส OTP ·
// ควรยืนยันเวลาให้บริการและระยะเวลาตอบกลับจริงจากช่องทางทางการอีกครั้ง
//
// banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion · banner2/banner3 และ
// slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import (ลำพังการ import ก็ทำให้ไฟล์
// ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้หมุนมาเป็น Announcement6 ทั้งเว็บ (brand-spec §3)
// orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียก
// แบบ bare ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ชมพูบับเบิลกัมนำ ทองเนยเป็นฮิวที่สอง
// พลัมเข้มไม่เคยถือตัวอักษร บนดำสนิท** — กลับด้านกับรอบก่อนที่ทองเป็นตัวนำ
// ⚠️ แบรนด์ก่อนๆ มีทองแทบทุกราย และรอบที่แล้วก็มีทั้งทองและชมพู "มีทองอยู่" หรือ
// "มีชมพูอยู่" จึงไม่ใช่ตัวบอกว่าถูกแบรนด์ ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน
// brand-spec §2 (ค่าเดิมไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ
// false positive) ชมพูรอบนี้คือ **#fa63b9** และทองรอบนี้คือ **#ffd84d**
// ลำดับความลึก: #2b0f20 ผิวยก (= การ์ด) / #1a0914 กลาง / #0d040a จม / #000000 พื้นเพจ
// ลำดับปุ่มสื่อด้วยขั้ว "ไล่เฉดทอง→ชมพู vs ผิวจมขอบพลัม": ปุ่มหลักถมไล่เฉด #ffd84d
// → #fa63b9 ขอบ #6b4708 หมึก #2a0617 (13.4:1 บนปลายทอง · 7.0:1 บนปลายชมพู) ·
// ปุ่มรองและปุ่มลิงก์ภายในเป็นผิวจม #1a0914 → #0d040a ขอบ #6d0b3f/60 ตัวอักษร
// #fdeaf5 และ hover ยกขอบเป็นชมพูบับเบิลกัม #fa63b9 · ขอบรูปใช้ชมพูบับเบิลกัม
// #fa63b9 โปร่ง (ฮิวนำต้องเห็นจริงบนหน้า) · marker ของลำดับเลขใช้ชมพูอ่อน #ffb3de
// (10.7:1 บนผิวการ์ด — เป็นตัวอักษร จึงใช้พลัมเข้มไม่ได้ และ #ffd84d สงวนไว้ให้
// <strong> เท่านั้น)
// ⚠️ ห้ามกลับด้าน: พื้นถมทอง/ชมพูต้องใช้หมึกเข้มเสมอ ห้ามขาวหรือทองอ่อน และ
// #6d0b3f #6b4708 เป็นเส้น ขอบ ออรา และพื้นถมเท่านั้น ห้ามถือตัวอักษรทุกขนาด
// ออราในไฟล์นี้ใช้ rgba(109,11,63,α) · rgba(255,216,77,α) · rgba(250,99,185,α)
// เท่านั้น · รอบนี้ไม่มีม่วง ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว ไม่มีส้ม ไม่มีเงิน/
// โครเมียม ไม่มีโรสโกลด์ และไม่มีแดงชาด (#00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์
// LINE ไม่ใช่สีของเว็บ จึงคงไว้ตาม §2)
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #fdeaf5)
// ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง ปล่อยให้สืบทอดลงมา
// และไม่ใส่ mx-auto / max-w-* บน <p> — มีแค่ปุ่ม ขอบรูป marker ของลำดับเลข และ
// <strong> ที่ประกาศสี โดย <strong> ใช้ทองเนย #ffd84d ตัวเดียว (12.7:1 บนผิว
// การ์ด) และแต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทย
// ไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง
// และห้ามวาง <strong> สองอันติดกัน
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 155 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} หน้ารวมวิธีไล่ดูเกมสล็อตออนไลน์ ศึกษากติกาของค่ายเกม เงื่อนไขการถอนเงิน และรายละเอียดโปรโมชั่นให้ครบก่อนสมัครสมาชิกและเข้าสู่ระบบจริง`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ไล่ดูเกมสล็อตและเงื่อนไขการถอนเงินก่อนเข้าใช้งานจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#ffd84d]">{BRAND_NAME} เป็นเว็บสล็อตฐานหลักที่นำเสนอช่องทางเข้าใช้งานเกมสล็อตออนไลน์ไว้ในเว็บไซต์เดียว</strong>
        หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับระบบได้ไล่ดูให้ครบหนึ่งรอบก่อนเข้าใช้งานจริง ตั้งแต่รายชื่อค่ายเกมสล็อตที่เปิดให้บริการ ไปจนถึงขั้นตอนสมัครสมาชิก เงื่อนไขฝากถอน และรายละเอียดของโปรโมชั่นที่เปิดให้เข้าร่วม
      </p>

      <p>
        คำว่า ทดลองเล่น ที่หน้านี้พูดถึงจึงหมายถึง
        <strong class="text-[#ffd84d]">การศึกษากติกาของแต่ละเกมและเงื่อนไขการถอนเงินก่อนทำรายการ</strong>
        ไม่ใช่การแจกเครดิตทดลอง และไม่ใช่การรับประกันผลของรายการใดรายการหนึ่ง หากพบปัญหาระหว่างใช้งานสามารถสอบถามเจ้าหน้าที่ผ่านช่องทางทางการได้
      </p>

      <p>
