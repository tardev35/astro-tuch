---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import popularGamesImage from "../assets/gamedemo8.webp";
import newGamesImage from "../assets/gamedemo16.webp";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริง
// ของบรีฟรอบนี้เท่านั้น (src/assets/content.txt) ไม่ใช่แก้ทับประโยคของแบรนด์ก่อน
// — ย่อหน้าเก่าทั้งหน้าตั้งอยู่บนคำที่ brand-spec §6 สั่งห้าม (เป็นคอปปี้ของเว็บ
// เกมรวมหลายหมวด) จึงต้องเขียนใหม่ ไม่ใช่ find-and-replace
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0 (ผังเดิมของหน้า คงไว้)
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// ดรอปนี้ (2026-10-12) คือ **เว็บเล่นสล็อตออนไลน์ล้วน** (บรีฟเรียกตัวเอง
// ว่า สล็อตปันโปรในตำนาน) **ไม่ใช่เว็บเกมรวมหลายหมวด** แบบแบรนด์ก่อน ไม่ใช่เว็บกีฬา
// และไม่ใช่เว็บของหมวดลอตเตอรี (สองหน้าของหมวดนั้นจอดอยู่ใน src/pages-disabled/
// ไม่มี route ห้ามลิงก์ไปหา เป็น href ตายที่ทำให้ build แดง) หน้านี้เป็นหน้าทดลอง
// เล่นเกมสล็อต ซึ่งตรงกับแบรนด์สล็อตรอบนี้พอดี แง่มุมที่บรีฟระบุไว้มีเท่านี้:
// รวมเกมสล็อตหลายรูปแบบในระบบเดียว · สล็อตคลาสสิก · เกมวงล้อแบบดั้งเดิม · สล็อต
// ภาพสมัยใหม่ · เกมโบนัส · ฟรีสปิน · ฟีเจอร์โบนัสให้ศึกษาก่อนเล่น · หมวดเกมรวมใน
// หน้าเดียว · เมนูตรวจสอบเครดิต · ข้อมูลบัญชีสมาชิก · ยอดเดิมพัน · ตารางจ่าย ·
// รองรับมือถือและคอมพิวเตอร์ · ทางเข้าเล่นใหม่ปี 2026 · เว็บไซต์เลียนแบบ ·
// คืนยอดเสีย 0.3% เข้ายูสทุกวัน (รอบประจำวัน เวลาตัดรอบ ยอดที่เข้าเกณฑ์) ·
// แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด ผ่านลิงก์แนะนำส่วนตัว · สมัคร 3 ขั้นตอน ·
// ยืนยันบัญชี · แอดมิน 24 ชั่วโมง · ช่องทางหลัก · PIN · OTP
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามี "โหมดทดลอง" เครดิตทดลอง หรือเดโมฟรีเป็นบริการของเว็บ —
// จึงห้ามสัญญาสินค้าตัวนั้น คำว่า "ทดลองเล่น" บนหน้านี้จึงหมายถึงสิ่งที่บรีฟระบุไว้
// ตรงๆ ว่าทำได้: เปิดเว็บไล่ดูหมวดเกมสล็อตให้ครบหนึ่งรอบ เลือกเกมที่สนใจ อ่านกติกา
// ตารางจ่าย และช่วงเดิมพันของเกมนั้นให้จบ แล้วจึงเริ่มเดิมพันจริง
//
// ⚠️ รูปในหน้านี้ใช้ได้แค่ gamedemo8 กับ gamedemo16 เท่านั้น — เป็นอาร์ตสต็อกกลาง
// ของเทมเพลต (mtime 2026-08-04) ไม่ใช่อาร์ตเวิร์กของแบรนด์นี้ จึงอยู่ต่อได้ แต่ alt
// ต้องบรรยายภาพจริง และห้ามเอ่ยชื่อแบรนด์ใด เพราะไม่มีชื่อแบรนด์ไหนปรากฏอยู่บนรูป
// ทั้งสองใบ (เปิดอ่านซ้ำแล้วรอบนี้) ส่วน gamedemo7/9/10/11/12/14/15/17/18 มีโลโก้
// หรือชื่อของผู้ให้บริการเจ้าอื่นพิมพ์ทับอยู่กลางรูป และ gamedemo13 เป็นภาพล่อแหลม
// — ห้ามนำกลับมาใช้ เพราะเท่ากับอ้างชื่อที่บรีฟไม่ได้เอ่ย ไฟล์ยังอยู่บนดิสก์
// ห้ามลบ เป็นอินเวนทอรี gamedemo8 ("POPULAR GAME" 600x379) กับ gamedemo16
// ("New Game" 650x411) ความกว้างที่วาดจริงสูงสุด ~600px ต่อใบ (กริดสองคอลัมน์
// ในการ์ด) จึงไม่ขยายเกินต้นฉบับ quality={62} ของสองใบนี้ตั้งไว้ต่ำกว่าค่าปกติ 80
// มาตั้งแต่รอบก่อน เพราะอาร์ตมีเกรนละเอียดจนไฟล์ AVIF เคยโตกว่า WebP ของตัวเอง
// (verify-build จะแดง) ห้ามดันกลับขึ้น
//
// ⚠️ คำที่ห้ามหลงเหลือ: คำขายของของแบรนด์ก่อนๆ ศัพท์หมวดเกมรวม ศัพท์เว็บเดิมพันกีฬา
// และศัพท์หมวดลอตเตอรีทุกคำ — รายการเต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาคำต้องห้ามเจอ false positive รายการตรวจก่อนเริ่มเดิมพัน (<ol>
// ด้านล่าง) รอบนี้เขียนใหม่ทั้งสี่ข้อให้อ้างเฉพาะสิ่งที่บรีฟพูดถึงจริง
//
// ⚠️ ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง · ปี 2026
// ห้ามเติมเลขใบอนุญาต หน่วยงานกำกับ ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP ยอดฝากขั้นต่ำ
// จำนวนสมาชิก หรือปีที่ก่อตั้ง เพราะบรีฟไม่ได้เอ่ยไว้สักอย่าง
//
// ประโยคกำกับของบรีฟที่ห้ามตัดทิ้ง (เป็นส่วนหนึ่งของคอปปี้ ไม่ใช่ filler):
// ควรตรวจสอบช่องทางเข้าเล่นล่าสุดและรายละเอียดค่ายเกมจากเว็บไซต์หลักก่อนใช้งาน
// เพื่อหลีกเลี่ยงการเข้าสู่เว็บไซต์เลียนแบบ · จำนวนปีที่เปิดเว็บไซต์และความนิยม
// ไม่สามารถยืนยันได้จากชื่อแบรนด์เพียงอย่างเดียว · ควรตรวจสอบโดเมนหลักและข้อมูล
// ผู้ให้บริการให้ชัดเจนก่อนสมัครสมาชิก · แต่ละกิจกรรมอาจกำหนดรอบรับสิทธิ์ ประเภทเกม
// และเงื่อนไขการใช้โบนัสแตกต่างกัน · ควรตรวจสอบเวลาตัดรอบ เกมที่ร่วมรายการ และ
// ข้อกำหนดการใช้โบนัสก่อนรับทุกครั้ง · คำว่าไม่จำกัดควรตรวจสอบว่าหมายถึงจำนวนเพื่อน
// จำนวนครั้งในการรับสิทธิ์ หรือวงเงินโบนัส · ผู้สมัครควรตรวจสอบชื่อโดเมนและ
// รายละเอียดผู้ให้บริการก่อนส่งข้อมูลส่วนตัว พร้อมอ่านข้อกำหนดการใช้งานและตรวจสอบ
// อายุที่กฎหมายอนุญาต · ไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น
//
// banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion · banner2/banner3 และ
// slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import (ลำพังการ import ก็ทำให้
// ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น Announcement3 ทั้งเว็บ (รอบก่อนใช้ Announcement5 —
// brand-spec §3 หมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้
// ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่ง
// จะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ชมพูฮอตพิงก์นำ ทองสว่างรอง บนพื้นพลัมเข้ม
// อมม่วง #2e0022** พลิกออกจากสาย "ทองบนดำ" ของแปดรอบหลังสุด ซึ่งออกครบทุกจุดแล้ว
// ทั้งคลาส Tailwind raw hex และ rgba() (ค่าเดิมอยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำ
// ที่นี่ เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive) รอบนี้ไม่มีเขียว
// ไม่มีน้ำเงิน ไม่มีเทา/เงิน และไม่มีส้มอิฐเลย และเพราะพื้นเพจ **ไม่ใช่ดำสนิท**
// รอบนี้จึงมีชั้นที่ลึกกว่าพื้นเพจได้จริง (#1c0014)
// ลำดับปุ่มสื่อด้วยขั้ว "ทองถม vs ผิวจมขอบชมพู": ปุ่มหลักถมทองไล่เฉด #fce343 →
// #ffc554 ขอบ #8a0a45 หมึก #2a0012 · ปุ่มรอง (เข้าสู่ระบบ) เป็นผิวจม #3a0a2a →
// #1c0014 ขอบ #f41571/55 ตัวอักษรเนื้อความ #fde7f2 · ปุ่มลิงก์ภายในเป็นผิวจม
// เดียวกัน ขอบ #f41571/50 ตัวอักษรชมพูสว่าง #ff5ca8 · ขอบรูปใช้ชมพูแบบโปร่ง
// · marker ของลำดับเลขใช้ชมพูสว่าง #ff5ca8 (5.2:1 บนผิวการ์ด)
// ⚠️ ห้ามกลับด้าน: พื้นถมทองต้องใช้หมึกเข้มเสมอ ห้ามขาวหรือทองอ่อน และห้ามให้
// ไล่เฉดทองที่รองหมึกจบเข้มกว่า #ffc554 — #8a0a45 / #4a0426 เป็นเส้น ขอบ และ
// ออราเท่านั้น ออราในไฟล์นี้ใช้ rgba(244,21,113,α) และ rgba(252,227,67,α) เท่านั้น
// ⚠️ "ชมพู" และ "ทอง" ไม่ใช่ตัวบอกว่าถูกแบรนด์: ชมพูของแบรนด์เก่ารอบหนึ่งใกล้กันมากแต่คนละค่า
// และแปดในสิบแบรนด์หลังสุดก็มีทอง ให้เทียบเป็นค่าทีละตัวกับตารางใน brand-spec §2
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #fde7f2)
// ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง ปล่อยให้สืบทอดลงมา
// — มีแค่ปุ่ม ขอบรูป marker ของลำดับเลข และ <strong> ที่ประกาศสี โดย <strong>
// ใช้ทองไฮไลต์ #ffd94a ตัวเดียว (10.8:1 บนผิวการ์ด) และแต่ละ <strong> ครอบ
// "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิด
// แท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 156 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} ไล่ดูหมวดสล็อตคลาสสิก สล็อตภาพสมัยใหม่ เกมโบนัส และฟรีสปินให้ครบหนึ่งรอบ พร้อมอ่านตารางจ่ายและช่วงเดิมพันของแต่ละเกมก่อนเริ่มเดิมพันจริง`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ไล่ดูหมวดเกมสล็อตก่อนเริ่มเดิมพันจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#ffd94a]">{BRAND_NAME}</strong> คือเว็บเล่นสล็อตออนไลน์ที่รวมเกมสล็อตหลายรูปแบบไว้ให้เลือกในระบบเดียว
        <strong class="text-[#ffd94a]">ทั้งสล็อตคลาสสิก เกมโบนัส และฟรีสปิน พร้อมเมนูตรวจสอบเครดิต โปรโมชั่น และข้อมูลบัญชีสมาชิก รองรับการใช้งานผ่านมือถือและคอมพิวเตอร์</strong>
        หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับระบบได้ไล่ดูให้ครบหนึ่งรอบ ตั้งแต่การเลือกหมวดเกมและเปิดรายละเอียดของเกมที่สนใจ ไปจนถึงเมนูจัดการบัญชีและการติดตามรายการ ก่อนจะเริ่มเดิมพันจริง
      </p>

      <p>
        คำว่า ทดลองเล่น ที่หน้านี้พูดถึงจึงหมายถึง
        <strong class="text-[#ffd94a]">การเปิดเว็บไซต์ไล่ดูหมวดเกมที่จัดไว้ เลือกเกมสล็อตที่สนใจ แล้วอ่านกติกา ตารางจ่าย และช่วงเดิมพันของเกมนั้นให้จบ</strong>
        ซึ่งเป็นสิ่งที่ระบบเปิดให้ทำได้อยู่แล้ว ไม่ใช่การแจกเครดิตทดลอง และไม่ใช่การรับประกันผลของรายการใดรายการหนึ่ง เพราะเงื่อนไขของแต่ละเกมไม่เหมือนกัน จึงควรตรวจสอบรายละเอียดในระบบก่อนทำรายการ
      </p>

      <p>
        อีกเรื่องที่ควรไล่ดูไปพร้อมกันคือขอบเขตของสิ่งที่เปิดให้บริการจริง
