---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxCyberCut.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { pageGraph } from "../lib/schema";

// YADOM168 เป็นเว็บสล็อต รวมเกมจากหลายค่ายไว้ในบัญชีเดียว หน้านี้จึงหมายถึงการทำความ
// รู้จักระบบก่อนเดิมพันด้วยเครดิตจริง: สมัครเองได้ 3 ขั้นตอน การเลือกค่ายและเกม
// การตรวจกติกา อัตราจ่าย และช่วงเดิมพันของแต่ละเกม โปรโมชั่นที่ตรวจสอบได้หลัง Login
// และการดูประวัติรายการในบัญชีสมาชิก
//
// แบรนด์เก่าเคยวางแกลเลอรี 12 การ์ด (gamedemo7..18.webp) ไว้ที่หน้านี้ ถูกถอดออกไปตั้งแต่
// สิบรอบรีแบรนด์ก่อน และไม่มีการ import แล้ว — อย่านำกลับมา ลำพังการ import ก็ทำให้ไฟล์ถูก
// emit ลง dist/ และ verify-build จะแดงถ้ามีรูปที่ไม่มีใคร render ทั้งชุด
//
// ทุกข้อความอ้างอิงบรีฟของแบรนด์นี้เท่านั้น: รวมเกมสล็อตจากหลายค่ายในบัญชีเดียว ระบบออโต้ ·
// เกมที่รองรับเบทต่ำ 1 บาทมีให้เลือก แต่ต้องตรวจขั้นต่ำในเกมก่อนกด Spin ·
// โบนัสแนะนำเพื่อน 0.8% ตามเงื่อนไข · ฝากถอนผ่านช่องทางที่ระบบเปิดรองรับ ยึดวงเงินขั้นต่ำ
// และสูงสุดที่ช่องทางนั้นแสดง ณ เวลาทำรายการ · แอดมินช่วยเหลือ 24 ชั่วโมง
// บรีฟรอบนี้ไม่มี "คืนยอดเสีย 0.3%" จึงไม่เขียนถึง และไม่มีการอ้างใบอนุญาต การจดทะเบียน
// ปีที่ก่อตั้ง จำนวนสมาชิก การันตีผลกำไร หรือชื่อค่ายเกมรายใดที่บรีฟไม่ได้ระบุ
//
// Announcement รอบนี้หมุนมาใช้ Announcement5 ทั้งเว็บ — default message ของไฟล์นั้น
// เป็นข้อความของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ได้
//
// คำเตือนทุกจุดใช้สีเหลืองอำพัน #f0b93a โดยตั้งใจ ไม่ใช่เขียวแบรนด์
// ส่วน #e6bd5c คือทองจากเหรียญบนอาร์ตเวิร์ก ใช้เป็น accent รองคู่กับเขียว #5cc23f
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 158
const pageDescription =
  "หน้าทดลองเล่น YADOM168 แนะนำวิธีเริ่มใช้งานเว็บสล็อตออโต้ ตั้งแต่สมัครสมาชิก 3 ขั้นตอน ฝากผ่านธนาคารหรือวอลเลท จนถึงตรวจกติกาและวงเงินเดิมพันก่อนเริ่มเล่นจริง";

const graph = pageGraph(Astro, {
  name: "ทดลองเล่น YADOM168 ทำความรู้จักระบบสล็อตออโต้ก่อนเดิมพันด้วยเครดิตจริง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title="ทดลองเล่น YADOM168 ลองใช้ระบบสล็อตออโต้ รวมเกมค่ายดัง เบทต่ำ1บาท" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่น YADOM168 ทำความรู้จักระบบสล็อตออโต้ก่อนเดิมพันด้วยเครดิตจริง" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d4e8cb]">
        <strong class="text-[#f2fbef]">YADOM168</strong> รวมเกมสล็อตจากหลายค่ายไว้ในบัญชีเดียว ทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน แจ็กพอต
        และเกมธีมใหม่ ๆ ตามที่แต่ละค่ายเปิดให้บริการ รองรับการใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์
        หน้านี้จึงเปิดไว้ให้ผู้เริ่มต้นได้<strong class="text-[#f2fbef]">ทำความคุ้นเคยกับขั้นตอนใช้งาน ตรวจกติกา อัตราจ่าย และช่วงเดิมพันของแต่ละเกม</strong>
        ก่อนเดิมพันด้วยเครดิตของตัวเอง เพราะรายละเอียดเหล่านี้ต่างกันไปตามค่ายและตามเกมที่เลือก
      </p>

      <p class="text-left text-base leading-relaxed text-[#d4e8cb]">
        ขอให้เข้าใจตรงกันว่าการทดลองเล่นเป็นการทำความคุ้นเคยกับระบบเท่านั้น
        <strong class="text-[#f0b93a]">ผลลัพธ์ของเกมสล็อตไม่สามารถรับประกันได้ว่าเกมใดจะแตกง่ายหรือทำกำไรได้ทุกครั้ง</strong>
        ควรเลือกเกมจากกติกา รูปแบบการเดิมพัน และงบประมาณที่เหมาะสมกับตนเอง หากติดปัญหาระหว่างใช้งาน แจ้งแอดมิน YADOM168 ได้ตลอด 24 ชั่วโมง
        พร้อมชื่อเกม เวลา จำนวนเงิน และรายละเอียดของรายการ เพื่อให้ตรวจสอบได้ตรงจุด
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="สมัคร YADOM168 เล่นสล็อตออโต้ ด้วยตัวเอง 3 ขั้นตอน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d4e8cb]">
        ผู้ใช้งานใหม่สมัคร YADOM168 ผ่านระบบออนไลน์ได้ด้วยตัวเอง ทำผ่านมือถือหรือคอมพิวเตอร์ก็ได้ และสลับค่ายเกมผ่านบัญชีเดียวได้โดยไม่ต้องสมัครหลายเว็บไซต์
        เริ่มต้นใช้งานได้ง่ายเพียง <strong class="text-[#f2fbef]">3 ขั้นตอน</strong> และเป็นลำดับเดียวกันไม่ว่าจะเลือกเล่นค่ายไหน
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#d4e8cb]">
        <li class="flex gap-3"><span class="font-bold text-[#5cc23f]">1.</span> เข้าหน้าสมัคร YADOM168 และกรอกข้อมูลที่จำเป็นสำหรับเปิดบัญชีตามที่ระบบกำหนด</li>
        <li class="flex gap-3"><span class="font-bold text-[#5cc23f]">2.</span> Login เข้าสู่บัญชี แล้วเลือกช่องทางเติมเครดิตจากช่องทางที่ระบบเปิดรองรับ</li>
        <li class="flex gap-3"><span class="font-bold text-[#5cc23f]">3.</span> ตรวจสอบโปรโมชั่น เลือกค่ายและเกมสล็อตที่สนใจ แล้วอ่านกติกากับช่วงเดิมพันก่อนเริ่มเล่น</li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#d4e8cb]">
        หลังเปิดบัญชีเรียบร้อยสามารถตรวจสอบเครดิต ประวัติฝากถอน โปรโมชั่น และรายการใช้งานผ่านมือถือได้โดยตรง
        ควรไล่ดูให้ครบก่อนใช้เครดิตจริง จะช่วยให้เห็นว่ารายการหนึ่งถูกบันทึกและคิดผลมาจากอะไรบ้าง
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ตรวจกติกา อัตราจ่าย และช่วงเดิมพันของแต่ละเกมก่อนกด Spin" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d4e8cb]">
        ข้อมูลที่ควรเปิดดูให้ครบก่อนลงเดิมพันมีอยู่ไม่กี่อย่าง และระบบแสดงไว้ในหน้าเกมให้ตรวจสอบได้อยู่แล้ว
        <strong class="text-[#f2fbef]">ข้อมูลชุดนี้คือสิ่งที่กำหนดว่ารอบหนึ่งคิดผลอย่างไร</strong> จึงควรอ่านให้จบก่อนตัดสินใจว่าจะลงเท่าไร
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#d4e8cb]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#5cc23f]">🎰</span>
          <span><strong class="text-[#f2fbef]">จำนวนวงล้อและเส้นรางวัล</strong> เป็นตัวกำหนดว่าสัญลักษณ์ชุดไหนนับเป็นรางวัล แต่ละเกมวางไว้ไม่เหมือนกันแม้อยู่ค่ายเดียวกัน</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e6bd5c]">🎁</span>
          <span><strong class="text-[#e6bd5c]">รอบโบนัสและเงื่อนไขการเข้ารอบ</strong> หน้าอธิบายในตัวเกมบอกไว้ว่าต้องได้สัญลักษณ์ชุดใดจึงเปิดรอบพิเศษ และรอบนั้นคิดผลอย่างไร</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#5cc23f]">🌀</span>
          <span><strong class="text-[#f2fbef]">ฟรีสปินและตัวคูณ</strong> จำนวนสปินที่ได้รับกับวิธีคูณผลต่างกันไปตามเกม ควรดูให้ชัดก่อนว่าจะนับรวมกับเดิมพันปกติหรือไม่</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e6bd5c]">💠</span>
          <span><strong class="text-[#e6bd5c]">ช่วงเดิมพันต่อรอบ</strong> เกมที่รองรับเบทต่ำ 1 บาทมีให้เลือก แต่ไม่ใช่ทุกเกมจะกำหนดขั้นต่ำเท่ากัน ให้ยึดราคาต่อ Spin ที่ระบบแสดงในหน้าเกมเป็นหลัก</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#d4e8cb]">
        รายชื่อค่ายและเกมที่พร้อมใช้งานเปลี่ยนแปลงได้ ควรตรวจสอบรายการล่าสุดจากหน้าเลือกเกมในเว็บก่อนเข้าเล่น
        <strong class="text-[#f0b93a]">ส่วนยอดเดิมพันต่ำสุดจริงต่างกันไปตามค่าย จึงควรเปิดดูช่วงเดิมพันในตัวเกมก่อนกด Spin ทุกครั้ง</strong>
        และควรกำหนดยอดต่อรอบไว้ล่วงหน้าเสมอ
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ฝากถอนออโต้ ตรวจสอบโปรโมชั่น และดูแลความปลอดภัยของบัญชี" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d4e8cb]">
        สมาชิกเติมเครดิตได้เองผ่านช่องทางฝากเงินที่ระบบเปิดรองรับ
        <strong class="text-[#f2fbef]">ทำรายการฝาก ส่งคำขอถอน และตรวจสอบสถานะรายการผ่านบัญชีของตนเองได้โดยตรง</strong>
        ช่วยลดขั้นตอนและไม่จำเป็นต้องแจ้งรายการกับเจ้าหน้าที่ทุกครั้ง หากต้องการทำรายการจำนวนมาก
        ควรตรวจสอบวงเงินขั้นต่ำและสูงสุดของช่องทางที่เลือกก่อนยืนยัน เนื่องจากข้อกำหนดอาจแตกต่างกันตามธนาคารหรือช่องทางชำระเงิน
      </p>

      <ul class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#d4e8cb]">
        <li class="flex gap-3">
          <span class="text-[#5cc23f]" aria-hidden="true">•</span> โปรโมชั่นแนะนำเพื่อน รับโบนัส 0.8% ใช้ลิงก์แนะนำส่วนตัวชวนเพื่อนสมัคร เมื่อบัญชีที่แนะนำมียอดใช้งานตรงตามข้อกำหนด ระบบจะนำยอดที่เข้าเกณฑ์มาคำนวณ ตรวจสอบจำนวนเพื่อน ยอดคำนวณ และโบนัสที่มีสิทธิ์รับได้หลัง Login
        </li>
        <li class="flex gap-3">
          <span class="text-[#e6bd5c]" aria-hidden="true">•</span> สิทธิ์โบนัสที่ได้รับในแต่ละวันขึ้นอยู่กับกิจกรรมและเงื่อนไขของโปรโมชั่นในช่วงนั้น ทั้งยอดที่ใช้คำนวณ รอบรับโบนัส และประเภทเกมที่เข้าร่วมรายการ จึงควรอ่านรายละเอียดล่าสุดก่อนกดรับ
        </li>
        <li class="flex gap-3">
          <span class="text-[#5cc23f]" aria-hidden="true">•</span> หากเครดิตไม่เข้า รายการถอนค้าง หรือสถานะรายการไม่อัปเดต ให้ตรวจสอบประวัติรายการในบัญชีก่อน และเก็บหลักฐานรายการไว้จนกว่าการตรวจสอบจะเสร็จสิ้น
        </li>
        <li class="flex gap-3">
          <span class="text-[#e6bd5c]" aria-hidden="true">•</span>
          <strong class="text-[#f0b93a]">ตั้งรหัสผ่านที่คาดเดายาก ไม่ใช้รหัสเดียวกับบริการอื่น และไม่ส่งรหัสผ่านหรือ OTP ให้บุคคลอื่น</strong> รวมถึงตรวจสอบให้แน่ใจว่าเป็นบัญชี LINE OFFICIAL ที่ประกาศไว้บนเว็บไซต์ก่อนส่งข้อมูลใด ๆ
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#d4e8cb]">
        หากพบปัญหาเกี่ยวกับการสมัคร Login เข้าเกมไม่ได้ เครดิตไม่อัปเดต ฝากถอนค้าง หรือโปรโมชั่นไม่แสดง ติดต่อแอดมิน YADOM168 ได้ตลอด 24 ชั่วโมง โดยแจ้งรายละเอียดของปัญหา เวลา จำนวนเงิน
        และข้อมูลรายการที่เกี่ยวข้อง <strong class="text-[#f0b93a]">การเดิมพันมีความเสี่ยง ควรกำหนดงบประมาณให้เหมาะสมทุกครั้ง</strong>
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก YADOM168"
          class="flex items-center justify-center rounded-lg border border-[#1d6b18]/70 bg-gradient-to-r from-[#8fe06f] via-[#5cc23f] to-[#1d6b18] px-8 py-3 font-black text-[#040d04] shadow-[0_0_15px_rgba(92,194,63,0.30)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ YADOM168"
          class="flex items-center justify-center rounded-lg border border-[#e6bd5c]/45 bg-transparent px-8 py-3 font-bold text-[#e6bd5c] transition-all hover:scale-105 hover:border-[#e6bd5c] hover:bg-[#0f3d0d]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>

  <Navfoot />
</MainLayout>
