---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { pageGraph } from "../lib/schema";

// LEKDED is a lottery site, so "ทดลองเล่น" here means walking through the system
// before spending anything: pick a หวย type, build a โพย, read the อัตราจ่าย,
// and learn the ฝากถอน flow. The previous brand rendered a 12-card slot
// provider gallery (gamedemo7..18.webp) on this page — those assets belong to a
// slot brand and are not imported anywhere any more. Do not bring them back: an
// import alone emits the file into dist/, and verify-build fails an image that
// nothing renders.
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 158.
const pageDescription =
  "หน้าทดลองเล่น LEKDED สำหรับสมาชิกใหม่ ดูวิธีเลือกประเภทหวยรัฐบาลไทย ลาว ฮานอย หุ้น ขั้นตอนส่งโพย การตรวจสอบอัตราจ่ายและเลขอั้น รวมถึงขั้นตอนฝากถอนก่อนซื้อจริง";

const graph = pageGraph(Astro, {
  name: "ทดลองเล่น LEKDED ดูขั้นตอนซื้อหวยออนไลน์ก่อนใช้งานจริง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title="ทดลองเล่น LEKDED ดูวิธีส่งโพยและตรวจอัตราจ่ายก่อนซื้อหวยจริง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่น LEKDED ดูขั้นตอนซื้อหวยออนไลน์ก่อนใช้งานจริง" as="h1">
    <p class="mb-6 text-left text-base leading-relaxed text-[#ecdfb4]">
      <strong class="text-[#fbe479]">LEKDED</strong> รวมหวยหลายประเภทไว้ในบัญชีเดียว ทั้งหวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยหุ้น หน้านี้เปิดไว้ให้สมาชิกใหม่ที่ยังไม่คุ้นเคยกับระบบได้
      <strong class="text-[#fbe479]">ดูวิธีเลือกประเภทหวย วิธีส่งโพย และจุดที่ต้องตรวจสอบก่อนยืนยันรายการ</strong> ก่อนเริ่มใช้งานจริงด้วยเครดิตของตัวเอง เปิดผ่านเบราว์เซอร์ได้ทั้งบนมือถือ แท็บเล็ต และคอมพิวเตอร์
    </p>

    <p class="mb-2 text-left text-base leading-relaxed text-[#ecdfb4]">
      ขอให้เข้าใจตรงกันว่าขั้นตอนในหน้านี้เป็นการอธิบายการใช้งานระบบเท่านั้น
      <strong class="text-[#fbe479]">ไม่ใช่การรับประกันผลรางวัลและไม่สามารถใช้ทำนายผลของรอบใดได้</strong>
      หากติดปัญหาระหว่างใช้งาน สามารถแจ้งแอดมิน LEKDED พร้อมรายละเอียดและเวลาที่พบปัญหา เพื่อให้ทีมงานค้นหารายการและตรวจสอบได้ตรงจุด
    </p>
  </ContentBox>

  <ContentBox title="ขั้นตอนทดลองใช้งานระบบ LEKDED ด้วยตัวเอง" as="h2">
    <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#ecdfb4]">
      <li class="flex gap-3"><span class="font-bold text-[#efd591]">1.</span> เลือกประเภทหวยที่สนใจจากหมวดหมู่ในระบบ ทั้งหวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยหุ้น แล้วดูรอบที่เปิดให้ส่งโพยอยู่</li>
      <li class="flex gap-3"><span class="font-bold text-[#efd591]">2.</span> เลือกรูปแบบการแทงและเลขที่ต้องการ กรอกจำนวนเงิน แล้วดูรายการที่ระบบสรุปไว้ในโพยก่อนยืนยัน</li>
      <li class="flex gap-3"><span class="font-bold text-[#efd591]">3.</span> ตรวจสอบอัตราจ่าย เลขอั้น และวงเงินรับแทงของรอบนั้น ว่าตรงกับที่ตั้งใจซื้อหรือไม่</li>
      <li class="flex gap-3"><span class="font-bold text-[#efd591]">4.</span> ทำความเข้าใจขั้นตอนฝากถอนออโต้ผ่านบัญชีของตนเอง ก่อนเริ่มส่งโพยด้วยเครดิตจริง</li>
    </ol>

    <p class="mt-4 mb-2 text-left text-base leading-relaxed text-[#ecdfb4]">
      หลังเปิดบัญชีเรียบร้อย สมาชิกสามารถตรวจสอบเครดิต ประวัติโพย และสถานะฝากถอนผ่านบัญชีของตนเองได้ รวมถึงโปรโมชั่นที่มีสิทธิ์รับตามรอบวันที่
      <strong class="text-[#efd591]">1</strong> และ <strong class="text-[#efd591]">16</strong> ของเดือน ตามเงื่อนไขของแต่ละกิจกรรม ทั้งบนมือถือ แท็บเล็ต และคอมพิวเตอร์
    </p>
  </ContentBox>

  <ContentBox title="สิ่งที่ควรตรวจสอบก่อนยืนยันโพยด้วยเครดิตจริง" as="h2">
    <ul class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#ecdfb4]">
      <li class="flex gap-3">
        <span class="text-[#fbe479]" aria-hidden="true">•</span> หน้านี้อธิบายการใช้งานระบบเท่านั้น การซื้อหวยจริงต้องสมัครสมาชิกและฝากเครดิตผ่านระบบออโต้ก่อน
      </li>
      <li class="flex gap-3">
        <span class="text-[#fbe479]" aria-hidden="true">•</span> เวลาเปิด-ปิดรับแทงของหวยแต่ละประเภทไม่เท่ากัน ควรดูรอบที่ระบบแสดงอยู่ก่อนเริ่มเลือกเลข
      </li>
      <li class="flex gap-3">
        <span class="text-[#fbe479]" aria-hidden="true">•</span> อัตราจ่าย เลขอั้น และวงเงินรับแทงอาจต่างกันในแต่ละรอบ ให้ยึดข้อมูลที่ระบบแสดงในรอบนั้นเป็นหลัก
      </li>
      <li class="flex gap-3">
        <span class="text-[#fbe479]" aria-hidden="true">•</span> ตรวจสอบเลข จำนวนเงิน และรูปแบบการแทงในโพยให้ครบก่อนกดยืนยัน เพราะรายการที่ยืนยันแล้วจะเข้าสู่รอบทันที
      </li>
      <li class="flex gap-3">
        <span class="text-[#fbe479]" aria-hidden="true">•</span> ก่อนฝากถอนควรตรวจชื่อบัญชี จำนวนเงิน และช่องทางให้ถูกต้อง และไม่เปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      </li>
      <li class="flex gap-3">
        <span class="text-[#fbe479]" aria-hidden="true">•</span> หาก Login ไม่ได้ เครดิตไม่เข้า ถอนเงินค้าง หรือส่งโพยไม่สำเร็จ ให้แจ้งแอดมิน LEKDED พร้อมเวลาและรายละเอียดของรายการ
      </li>
    </ul>

    <p class="mt-4 mb-6 text-left text-base leading-relaxed text-[#ecdfb4]">
      สมาชิกใหม่สอบถามวิธีเลือกประเภทหวย วิธีส่งโพย การตรวจสอบอัตราจ่าย หรือขั้นตอนการฝากถอนกับแอดมิน LEKDED ได้ตลอด 24 ชั่วโมง โดย
      <strong class="text-[#fbe479]">การเดิมพันมีความเสี่ยง ควรกำหนดงบประมาณให้เหมาะสมทุกครั้ง</strong>
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก LEKDED"
        class="flex items-center justify-center rounded-lg bg-gradient-to-r from-[#fbe479] via-[#e2c466] to-[#b5811e] px-8 py-3 font-black text-[#030803] shadow-[0_0_15px_rgba(181,129,30,0.32)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ LEKDED"
        class="flex items-center justify-center rounded-lg border border-[#b5811e]/70 bg-transparent px-8 py-3 font-bold text-[#ecdfb4] transition-all hover:scale-105 hover:border-[#e2c466] hover:bg-[#0b1405]/70">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
