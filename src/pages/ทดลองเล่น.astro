---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import popularGamesImage from "../assets/gamedemo8.webp";
import newGamesImage from "../assets/gamedemo16.webp";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion,
// /login, /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์
// หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ (src/assets/content.txt) ไม่มี
// ส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่จากข้อเท็จจริงและคลังคำของบรีฟรอบนี้
// เท่านั้น (.claude/brand-spec-ngernthong168.md §5)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
//   h1  ทดลองเล่น <แบรนด์> ศึกษารูปแบบเกมสล็อต ตารางจ่ายรางวัล และค่า RTP ก่อนเริ่มเล่น
//   h2  รูปแบบเกมสล็อตที่รวบรวมไว้มากกว่า 1,000 เกม
//   h2  ตารางจ่ายรางวัลและค่า RTP ที่ผู้พัฒนาเปิดเผย
//   h2  กติกาและเงื่อนไขการเดิมพันที่ควรตรวจสอบก่อนเริ่มเล่น
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// 🚨🚨 **หน้านี้ถูกเล็งใหม่ทั้งหน้าในรอบ 2026-10-22** รอบก่อน (พักยก168) สร้างหน้านี้
// ขึ้นรอบ "คำคู่ที่ขึ้นต้นด้วยชื่อ route แล้วลงท้ายด้วย ฟรี / โหมด~" ซึ่งเป็น
// **คำกล่าวอ้างเกี่ยวกับเกมของแบรนด์นั้น** (คำเต็มอยู่ใน brand-spec §5 ไม่พิมพ์
// ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ไฟล์นี้เอง)
// — **บรีฟรอบนี้ไม่ได้กล่าวอ้างแบบนั้นเลยแม้แต่ประโยคเดียว**
// คำว่า "ทดลองเล่น" รอบนี้จึงเหลือรอดได้ที่เดียวคือ **ชื่อ route /ทดลองเล่น**
// (ใช้ใน <h1> · <title> · description · breadcrumb เพื่อบอกว่าหน้านี้คือหน้าไหน)
// **ห้ามเขียนในเนื้อความว่าเกมของเว็บนี้เปิดให้เล่นแบบไม่ใช้เงินจริง**
// แกนใหม่ของหน้า = **การศึกษาคลังเกมก่อนเริ่มเล่น** ตามที่บรีฟมีจริง:
// เกมสล็อตมากกว่า 1,000 เกม จากค่ายมาตรฐานสากล · สล็อตคลาสสิก · เกมแนวผจญภัย ·
// ฟีเจอร์โบนัส · สัญลักษณ์พิเศษ · ตารางจ่ายรางวัล · ค่า RTP · กติกาและเงื่อนไข
// การเดิมพัน
//
// 🚨 แกนของดรอปนี้คือ **เว็บสล็อตออนไลน์** ที่บรีฟเรียกตัวเองว่า
// "สล็อตเงินดี อัตราจ่ายสูง ค่ายเกมลิขสิทธิ์แท้100%" พร้อม คืนยอดเสีย 0.3% ·
// แนะนำเพื่อน 0.8% · สมัคร 3 ขั้นตอน · แอดมิน 24ชม.
// ⚠️⚠️ คำขายของของแบรนด์ขาออก (พักยก168) และของรอบก่อนหน้านั้น **ห้ามหลงเหลือ**
// — รายการคำต้องห้ามเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep
// ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
//
// ⚠️⚠️ **สองหน้าหมวดลอตเตอรียังจอดอยู่ใน src/pages-disabled/** → ลิงก์ไปสอง route
// นั้นจะทำให้ build แดง ห้ามเขียนกลับมา
// route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ทดลองเล่น · /about-us · /contact-us · /terms · /privacy · /line
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกม ชื่อธนาคาร ชื่อวอลเล็ต ชื่อผู้ให้บริการ
// หน่วยงานกำกับ ใบอนุญาต ปีก่อตั้ง จำนวนสมาชิก ค่า RTP ที่เป็นตัวเลข หรือยอดฝาก
// ขั้นต่ำ แม้แต่รายการเดียว** — พูดแค่ "ค่ายมาตรฐานสากล" แล้วจบ จึงห้ามเขียนลง
// หน้าเว็บ · ตัวเลขที่ขึ้นหน้าได้มีแค่ของบรีฟเอง:
// **1,000 เกม · 0.3% · 0.8% · 24ชม. · 3 ขั้นตอน · 100%**
//
// 🚨 **ข้อกำกับของบรีฟที่ต้อง ship ครบบนหน้านี้** (ไม่ใช่ filler ให้ตัดทิ้ง):
// 1) จำนวนเกมที่เปิดให้บริการจริงอาจเปลี่ยนแปลงได้ ควรตรวจสอบรายชื่อค่ายเกมรวมถึง
//    สถานะลิขสิทธิ์จากข้อมูลทางการ
// 2) **ค่า RTP เป็นค่าทางสถิติระยะยาว ไม่ใช่การรับประกันผลตอบแทนของการเล่นแต่ละครั้ง**
// 3) คำกล่าวอ้างเรื่องอัตราจ่ายสูงและลิขสิทธิ์เกม ควรตรวจสอบจากข้อมูลผู้พัฒนาและ
//    หลักฐานการอนุญาตที่เชื่อถือได้ก่อนใช้งาน
// 4) เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือรับประกัน
//    ผลกำไรในอนาคต · แม้ระบุว่ากดรับได้ไม่จำกัด แต่ควรตรวจสอบจำนวนครั้งที่รับ
//    สิทธิ์ได้จริงจากประกาศล่าสุด
// 5) ไม่เปิดเผยรหัสผ่านหรือรหัส OTP · ควรตรวจสอบเวลาการให้บริการจริงจากประกาศ
//    ล่าสุดอีกครั้ง
// ⚠️ บรีฟไม่ได้การันตีผลลัพธ์ใดๆ — คอปปี้หน้านี้จึงไม่สัญญากำไรและไม่สัญญาว่า
// ถอนได้ชัวร์
//
// 🚨 **รูปในหน้านี้ใช้ได้แค่ gamedemo8 กับ gamedemo16 เท่านั้น** — เป็นอาร์ตสต็อก
// กลางของเทมเพลต ไม่ใช่อาร์ตเวิร์กของแบรนด์ไหน จึงอยู่ต่อข้ามรอบได้ แต่ alt ต้อง
// บรรยายภาพจริง และห้ามเอ่ยชื่อแบรนด์หรือชื่อค่ายเกมใดทั้งของรอบนี้และรอบก่อน
// ส่วน gamedemo7/9/10/11/12/14/15/17/18 มีโลโก้หรือชื่อของผู้ให้บริการ/ค่ายเกม
// เจ้าอื่นพิมพ์ทับอยู่กลางรูป และ gamedemo13 เป็นภาพล่อแหลม — **ห้ามนำกลับมาใช้**
// เพราะเท่ากับอ้างชื่อค่ายเกมที่บรีฟรอบนี้ไม่ได้เอ่ย (ขัด brand-spec §5 โดยตรง)
// ไฟล์ยังอยู่บนดิสก์ ห้ามลบ เป็นอินเวนทอรี
// gamedemo8 ("POPULAR GAME" 600x379) กับ gamedemo16 ("New Game" 650x411) ไม่มีชื่อ
// แบรนด์ใดปรากฏ ความกว้างที่วาดจริงสูงสุด ~600px ต่อใบ (กริดสองคอลัมน์ในการ์ด)
// จึงไม่ขยายเกินต้นฉบับ
// ⚠️ รูปอื่นทั้งหมดห้ามอ้างจากหน้านี้: banner2/banner3 เป็นอาร์ตเวิร์กของแบรนด์
// คนละราย · slide1/slide2 ถูกตรึงไว้กับ index กับ /promotion · slide3/slide4 เป็น
// โปสเตอร์ของอีกแบรนด์ · banner1 / banner1-mobile / og.png เป็นของ glob ที่
// MainLayout ปักไว้ (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build
// จะแดงถ้าไม่มีหน้าไหน render)
//
// 🚨 พาเลตรอบนี้ (brand-spec §2) **ยังเป็นธีมมืดเหมือนรอบก่อน แต่คนละค่า**
// bg.json ของดรอปนี้คือ {"mode":"color","color":"#29210f"} = น้ำตาลโอลีฟเข้ม
// (รอบก่อนเป็น 291d0f ต่างกันที่เขียว 4 หน่วย) **ห้ามเดาว่าเท่าเดิม**
// ค่าที่ใช้ได้ในไฟล์นี้: ทองสว่าง #fcee52 (<strong> + หัวข้อ — 10.7:1 บนการ์ด) ·
// ทองแกน #f5ba14 (ขอบ · ออรา · marker · stop กลางของปุ่มหลัก · 7.3:1 ถือตัวอักษรได้) ·
// ทองลึก #b37c0b (**2.0:1 — พื้นถม/ขอบ/ออราเท่านั้น ห้ามถือตัวอักษร**) ·
// โครมกลาง #2e2512 (พื้นปุ่มรอง) · อินเซ็ตการ์ด #201906 (ชิปไอคอน + หมึกบนพื้นถมทอง)
// หมึกเนื้อความคือ #ecd5c4 (= BRAND_TEXT) ซึ่ง **ไม่ประกาศในไฟล์นี้** การ์ด
// ContentBox ตั้งไว้ให้แล้วและย่อหน้าสืบทอดลงมา
// 🚨 **ห้ามใช้ตัวอักษรขาวบนพื้นถมทอง** ปุ่มหลักใช้หมึก #201906 เสมอ
// ออราที่อนุญาต: rgba(245,186,20,α) · rgba(0,0,0,α)
// ⚠️ รอบนี้ไม่มีฟ้า/น้ำเงิน ไม่มีแดง ไม่มีชมพู ไม่มีม่วง ไม่มีส้ม ไม่มีเขียว
// และ **ไม่มีแรมป์เทาเงิน** (ซึ่งเป็นวัสดุที่สองของรอบก่อน) — วัสดุที่สองรอบนี้คือ
// ครีมอุ่น #ecd5c4 · ปุ่ม LINE อยู่บน /about-us กับ /contact-us ไม่ใช่หน้านี้
// ⚠️ **ทองผ่านรีโปนี้มาแล้วเกือบทุกเจ้า และรอบนี้เป็นทองนำสองรอบติดกัน** การเจอทอง
// ในไฟล์จึงไม่พิสูจน์อะไร — ห้ามเทียบด้วยวงศ์สี ต้องเทียบทีละค่ากับตาราง brand-spec §2
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง และไม่ใส่ mx-auto / max-w-* บน <p>
// เพราะการ์ดคุมความกว้างเองแล้ว — ที่ประกาศสีได้มีแค่ปุ่ม ชิปไอคอน marker ของ
// ลำดับเลข ขอบรูป และ <strong> · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง"
// ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัด
// ในแท็กและคำจะขาดครึ่ง และห้ามวาง <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังในข้อความของ prop และต้องไม่ใช่สัญลักษณ์ของอาร์ตเวิร์กแบรนด์เก่า
//
// Announcement รอบนี้หมุนมาเป็น Announcement2 ทั้งเว็บ (brand-spec §3 — รอบก่อนใช้
// AnnouncementPremium จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็น
// คอปปี้ของแบรนด์นี้แล้ว จึงเรียกแบบ bare **ห้ามส่ง prop message**
// มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 157 อักขระ (ชื่อแบรนด์รอบนี้ 10 ตัวอักษร) เป็นประโยคเดียวที่บอกว่า
// หน้านี้มีไว้ทำอะไร แล้วหยุด
// (Google ตัดราว 155 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} รวมวิธีศึกษารูปแบบเกมสล็อตมากกว่า 1,000 เกม จากค่ายมาตรฐานสากล พร้อมตารางจ่ายรางวัล ค่า RTP และเงื่อนไขการเดิมพันที่ควรอ่านก่อนเริ่มเล่น`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ศึกษารูปแบบเกมสล็อต ตารางจ่ายรางวัล และค่า RTP ก่อนเริ่มเล่น`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#fcee52]">{BRAND_NAME} นำเสนอเกมสล็อตออนไลน์หลากหลายรูปแบบ พร้อมข้อมูลค่ายเกม อัตราจ่าย และโปรโมชั่นสำหรับสมาชิก</strong>
        หน้านี้รวบรวมไว้ว่าควรเปิดดูอะไรบ้างก่อนเลือกเกม ตั้งแต่รูปแบบของตัวเกม ตารางจ่ายรางวัล ไปจนถึงกติกาและเงื่อนไขการเดิมพันที่ต้องอ่านให้ครบก่อนเริ่มเล่น
      </p>

      <p>
        ภายในเว็บไซต์มีเมนูสำหรับเลือกศึกษาเกมที่สนใจ ตรวจสอบกติกาและเงื่อนไขการเดิมพัน รวมถึงรายละเอียดการสมัครสมาชิกและช่องทางติดต่อเจ้าหน้าที่
        <strong class="text-[#fcee52]">การไล่อ่านข้อมูลเหล่านี้ก่อนช่วยให้เข้าใจว่าเกมแต่ละแบบกำหนดผลรางวัลไว้อย่างไร</strong>
        ก่อนที่จะต้องตัดสินใจด้วยเงินของตัวเอง
      </p>

      <p>
