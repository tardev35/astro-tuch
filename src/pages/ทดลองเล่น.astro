---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import popularGamesImage from "../assets/gamedemo8.webp";
import newGamesImage from "../assets/gamedemo16.webp";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริง
// ของบรีฟรอบนี้เท่านั้น (src/assets/content.txt) ไม่ใช่แก้ทับประโยคของแบรนด์ก่อน
// — ย่อหน้าเก่าทั้งย่อหน้าตั้งอยู่บนคำที่ brand-spec §6 สั่งห้าม จึงต้องเขียนใหม่
// ไม่ใช่ find-and-replace
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// ดรอปนี้ (2026-10-10) คือ **เว็บสล็อตนาซ่า ส่งตรงจากเมกา ฐานเกมหลัก 100%**
// เป็นเว็บสล็อตล้วน ไม่ใช่เว็บหวยและไม่ใช่เว็บรวมทุกหมวด (สองหน้าของหมวดหวยจอดอยู่ใน
// src/pages-disabled/ ไม่มี route จึงห้ามลิงก์ไปหา มิฉะนั้นเป็น href ตายที่ทำให้
// build แดง) แง่มุมที่บรีฟระบุไว้มีเท่านี้: รองรับมือถือและคอมพิวเตอร์ · รวมเกมสล็อต
// หลายประเภทไว้ในแพลตฟอร์มเดียว · สล็อตคลาสสิก เกมฟรีสปิน โบนัสตัวคูณ และเกมยอดนิยม
// จากค่ายที่เปิดให้บริการ · รวมค่ายฮิตระดับประเทศ ระบบเดิมพันใหม่ล่าสุด มาตรฐานสากล ·
// ค้นหาเกม ตรวจสอบเครดิต ติดตามโปรโมชั่น · จัดหมวดหมู่เกม · ยอดเดิมพันและตารางจ่าย ·
// คืนยอดเสีย 0.3% เข้ายูสทุกวัน · แนะนำเพื่อน แชร์ลิงก์ 0.8% · ยอดที่เข้าเกณฑ์
// รอบคำนวณ รอบตัดยอด · ฝากถอนเข้าบัญชีบริษัทโดยตรง ไม่ผ่านม้า บัญชีปลายทาง นิติบุคคล
// หลักฐานธุรกรรม · แอดมิน 24 ชั่วโมง · ช่องทางติดต่อหลัก · รหัสผ่าน PIN OTP
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามี "โหมดทดลอง" เครดิตทดลอง หรือเดโมฟรีเป็นบริการของเว็บ —
// จึงห้ามสัญญาสินค้าตัวนั้น คำว่า "ทดลองเล่น" บนหน้านี้จึงหมายถึงสิ่งที่บรีฟระบุไว้
// ตรงๆ ว่าทำได้: เปิดเว็บไล่ดูหมวดหมู่เกมและเมนูให้ครบหนึ่งรอบ ค้นหาเกม ตรวจสอบเครดิต
// อ่านตารางจ่ายกับรายละเอียดโปรโมชั่น แล้วจึงเริ่มเล่นจริง
//
// ⚠️ รูปในหน้านี้ใช้ได้แค่ gamedemo8 กับ gamedemo16 เท่านั้น — เป็นอาร์ตสต็อกกลาง
// ของเทมเพลต (mtime 2026-08-04) ไม่ใช่อาร์ตเวิร์กของแบรนด์นี้ จึงอยู่ต่อได้ แต่ alt
// ต้องบรรยายภาพจริง (รอบนี้เปิดรูปอ่านซ้ำแล้ว ไม่ได้ลอก alt มาเฉยๆ) และห้ามเอ่ยชื่อ
// แบรนด์ใด เพราะไม่มีชื่อแบรนด์ไหนปรากฏอยู่บนรูปทั้งสองใบ
// ส่วน gamedemo7/9/10/11/12/14/15/17/18 มีโลโก้หรือชื่อของผู้ให้บริการเจ้าอื่น
// พิมพ์ทับอยู่กลางรูป และ gamedemo13 เป็นภาพล่อแหลม — ห้ามนำกลับมาใช้ เพราะเท่ากับ
// อ้างชื่อที่บรีฟไม่ได้เอ่ย ไฟล์ยังอยู่บนดิสก์ ห้ามลบ เป็นอินเวนทอรี
// gamedemo8 ("POPULAR GAME" 600x379) กับ gamedemo16 ("New Game" 650x411) ความกว้าง
// ที่วาดจริงสูงสุด ~600px ต่อใบ (กริดสองคอลัมน์ในการ์ด) จึงไม่ขยายเกินต้นฉบับ
// quality={62} ของสองใบนี้ตั้งไว้ต่ำกว่าค่าปกติ 80 มาตั้งแต่รอบก่อน เพราะอาร์ตมีเกรน
// ละเอียดจนไฟล์ AVIF เคยโตกว่า WebP ของตัวเอง (verify-build จะแดง) ห้ามดันกลับขึ้น
//
// ⚠️ คำที่ห้ามหลงเหลือ: ศัพท์ของหมวดอื่นที่ไม่ใช่สล็อต และคำขายของของแบรนด์ก่อนๆ
// ที่บรีฟรอบนี้ไม่ได้เอ่ย — รายการเต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อ
// ไม่ให้ grep หาคำต้องห้ามเจอ false positive รายการตรวจก่อนเริ่มเล่น (<ol> ด้านล่าง)
// รอบนี้เขียนใหม่ทั้งสี่ข้อให้อ้างเฉพาะสิ่งที่บรีฟพูดถึงจริง
//
// ⚠️ ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 24 ชั่วโมง · 100%
// ห้ามเติมเลขใบอนุญาต หน่วยงานกำกับ ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP ยอดฝากขั้นต่ำ
// จำนวนสมาชิก หรือปีที่ก่อตั้ง เพราะบรีฟไม่ได้เอ่ยไว้สักอย่าง
//
// ประโยคกำกับของบรีฟที่ห้ามตัดทิ้ง (เป็นส่วนหนึ่งของคอปปี้ ไม่ใช่ filler):
// ข้อความส่งตรงจากอเมริกาและฐานเกมหลัก 100% ควรมีข้อมูลผู้ให้บริการที่ตรวจสอบได้
// รองรับ · การระบุว่าโปรโมชั่นครอบคลุมทุกค่ายควรตรวจสอบรายชื่อเกมที่ร่วมรายการ ·
// คำว่าไม่จำกัดควรระบุให้ชัดว่าหมายถึงจำนวนเพื่อน จำนวนครั้ง หรือวงเงิน ·
// ชื่อบัญชีบริษัทเพียงอย่างเดียวไม่สามารถรับประกันว่าธุรกรรมจะไม่มีความเสี่ยง ·
// ไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น แม้จะอ้างว่าเป็นเจ้าหน้าที่
//
// banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion · banner2/banner3 และ
// slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import (ลำพังการ import ก็ทำให้
// ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น AnnouncementPremium ทั้งเว็บ (รอบก่อนใช้ Announcement5 —
// brand-spec §3 หมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้
// ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่ง
// จะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ทองอวกาศ นำ เงินโครเมียม รอง บนน้ำตาลไหม้**
// พลิกทิศจากคู่ "ทองสายฟ้า-แดงเลือดนก บนพื้นแดง" ของแบรนด์ก่อน ซึ่งออกครบทุกจุดแล้ว
// ทั้งคลาส Tailwind raw hex และ rgba() (ค่าเดิมอยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive) รอบนี้ไม่มีสีแดงเป็นฮิวเลย
// ลำดับปุ่มสื่อด้วยขั้ว "ทองถม vs ผิวจมขอบทอง": ปุ่มหลักถมทองไล่เฉด #ffe87a →
// #fbc134 → #cf9a18 ขอบ #cf9a18 หมึกน้ำตาลเกือบดำ #231500 · ปุ่มรองและปุ่มลิงก์ภายใน
// เป็นผิวจม #432b03 → #241700 ขอบทอง #fbc134/50 ตัวอักษรเงินโครเมียม #cfd6e3 ซึ่ง
// เป็นฮิวที่สองจริงของแบรนด์ (เลข 168 บนโลโก้) · ขอบรูปใช้ทองแบบโปร่ง · marker ของ
// ลำดับเลขใช้ทองแบรนด์ #fbc134
// ⚠️ ห้ามกลับด้าน: พื้นถมทองต้องใช้หมึกเข้มเสมอ ห้ามครีมหรือขาว และห้ามให้ไล่เฉดทอง
// ที่รองหมึกจบเข้มกว่า #cf9a18 — #96690a / #6b4a05 / #3f4859 เป็นเส้นและออราเท่านั้น
// ห้ามถือตัวอักษรทุกขนาด
// ⚠️ "ทอง" ไม่ใช่ตัวบอกว่าถูกแบรนด์: หกในเจ็ดแบรนด์หลังสุดก็มีทอง แต่คนละค่า
// ให้เทียบเป็นตัวๆ กับตารางใน brand-spec §2
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #fdf3df)
// ไว้ที่ตัวการ์ดแล้ว ข้อความในหน้านี้จึงไม่ประกาศสีของตัวเองเลย ปล่อยให้สืบทอดลงมา
// — มีแค่ปุ่ม ขอบรูป และ marker ของลำดับเลขที่ประกาศสี เพราะเป็นพื้น/เส้น ไม่ใช่
// เนื้อความ ส่วน <strong> ใช้น้ำหนักตัวอักษรเป็นไฮไลต์ ไม่ประกาศสี และแต่ละ
// <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ
// ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 155 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} เว็บสล็อตนาซ่า ไล่ดูหมวดเกมสล็อตคลาสสิก เกมฟรีสปิน โบนัสตัวคูณ ค้นหาเกม ตรวจสอบเครดิต และอ่านเงื่อนไขโปรโมชั่นในระบบจริงก่อนเริ่มเล่นจริง`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} เว็บสล็อตนาซ่า ไล่ดูหมวดหมู่เกมและเมนูก่อนเริ่มเล่นจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong>{BRAND_NAME}</strong> คือเว็บสล็อตนาซ่าที่นำเสนอทางเข้าเล่นสล็อตออนไลน์ภายใต้แนวคิดฐานเกมหลักจากเมกา
        <strong>รองรับการใช้งานผ่านมือถือและคอมพิวเตอร์ พร้อมรวบรวมเกมสล็อตหลายประเภทไว้ในแพลตฟอร์มเดียว</strong>
        หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับระบบได้ไล่ดูให้ครบหนึ่งรอบ ตั้งแต่เมนูเลือกเกมและหมวดหมู่ที่เว็บไซต์จัดไว้ ไปจนถึงตารางจ่ายและรายละเอียดโปรโมชั่น ก่อนจะเริ่มเล่นจริง
      </p>

      <p>
        คำว่า ทดลองเล่น ที่หน้านี้พูดถึงจึงหมายถึง
        <strong>การเปิดเว็บไซต์ไล่ดูหมวดหมู่เกมที่จัดไว้ ค้นหาเกมจากเมนู ตรวจสอบเครดิต แล้วติดตามโปรโมชั่นที่เปิดอยู่ให้จบ</strong>
        ซึ่งเป็นสิ่งที่ระบบเปิดให้ทำได้อยู่แล้ว ไม่ใช่การแจกเครดิตทดลอง ไม่ใช่การหมุนฟรี และไม่ใช่การรับประกันผลของเกมใดเกมหนึ่ง เมื่อเข้าสู่ระบบแล้ว สมาชิกจะเลือกหมวดเกมที่สนใจและตรวจสอบยอดเดิมพันกับตารางจ่ายของแต่ละเกมได้ก่อนเริ่มเล่น
      </p>

      <p>
        อีกเรื่องที่ควรไล่ดูไปพร้อมกันคือขอบเขตของสิ่งที่เปิดให้บริการจริง
        <strong>เพราะการระบุว่าส่งตรงจากอเมริกาและเป็นฐานเกมหลัก 100% ควรมีข้อมูลผู้ให้บริการที่สามารถตรวจสอบได้รองรับ</strong>
        และรายชื่อค่ายกับเกมที่เปิดอยู่ก็เปลี่ยนแปลงได้ตามช่วงเวลา การไล่ดูด้วยตัวเองหนึ่งรอบจึงให้ข้อมูลตรงกว่าถ้อยคำบนหน้าประชาสัมพันธ์ และใช้ตัดสินใจได้จริงกว่าค่าที่จำไว้จากรอบก่อนหน้า
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`หมวดหมู่เกมสล็อตที่ ${BRAND_NAME} จัดไว้ให้ค้นหาจากแพลตฟอร์มเดียว`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        หลังเข้าสู่ระบบ ลำดับการใช้งานจะเป็นชุดเดียวกันทุกครั้ง
        <strong>เปิดเมนูเลือกเกม ไล่ดูสล็อตคลาสสิก เกมฟรีสปิน โบนัสตัวคูณ และเกมยอดนิยมจากค่ายที่เปิดให้บริการ แล้วจึงอ่านรายการโปรโมชั่นที่เปิดอยู่</strong>
