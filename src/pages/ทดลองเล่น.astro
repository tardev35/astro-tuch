---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import popularGamesImage from "../assets/gamedemo8.webp";
import newGamesImage from "../assets/gamedemo16.webp";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริง
// ของบรีฟรอบนี้เท่านั้น (src/assets/content.txt) ไม่ใช่แก้ทับประโยคของแบรนด์ก่อน
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0 (ผังเดิมของหน้า คงไว้)
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// ⚠️ ดรอปนี้ (2026-10-13) คือ **คาสิโนรวมเกม — บาคาร่า สล็อต และบอลออนไลน์**
// เท่านั้น **ไม่ใช่เว็บสล็อตล้วน ไม่ใช่เว็บกีฬาล้วน** และหมวดเกมอื่นที่บรีฟรอบก่อน
// เคยมี **บรีฟรอบนี้ไม่ได้เอ่ยไว้เลย จึงห้ามเขียนถึง** (ไม่พิมพ์ชื่อหมวดเหล่านั้น
// ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำต้องห้ามเจอ false positive) —
// คำของแบรนด์ก่อนเกือบทุกคำอยู่ในลิสต์ห้ามของ brand-spec §1 จึงต้องเขียนประโยค
// ขึ้นใหม่ ไม่ใช่ find-and-replace ทับของเดิม และไม่ใช่เว็บหมวดลอตเตอรี —
// สองหน้าของหมวดนั้นจอดอยู่ใน src/pages-disabled/ ไม่มี route ห้ามลิงก์ไปหา
// เป็น href ตายที่ทำให้ build แดง
//
// แง่มุมที่บรีฟรอบนี้รองรับให้หน้าทดลองเล่นพูดถึงมีเท่านี้: ระบบเดิมพันออโต้ ·
// รวมหมวดเกมไว้ในแพลตฟอร์มเดียว · เมนูจัดการบัญชี ตรวจสอบเครดิต ติดตามรายการ ·
// ใช้งานผ่านมือถือหรือคอมพิวเตอร์ · บาคาร่าเป็นเกมไพ่ที่มีตัวเลือกการเดิมพันตาม
// กติกา · สล็อตมีทั้งเกมวงล้อทั่วไป ฟรีสปิน และฟีเจอร์โบนัส · บอลออนไลน์มีข้อมูล
// คู่แข่งขัน ประเภทการเดิมพัน และอัตราต่อรอง · ขั้นตอนยืนยันรายการ ยอดเครดิต
// ประวัติธุรกรรม · ตารางจ่ายและเงื่อนไขของแต่ละเกม · คืนยอดเสีย 0.3% เข้ายูสทุกวัน ·
// แนะนำเพื่อน โบนัส 0.8% · ฝากถอนเข้าบริษัทเจ้าของโดยตรง ชื่อบัญชีปลายทาง
// หลักฐานธุรกรรม · แอดมิน 24 ชั่วโมง ช่องทางหลัก หมายเลขรายการ PIN OTP
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามี "โหมดทดลอง" เครดิตทดลอง หรือเดโมฟรีเป็นบริการของเว็บ —
// จึงห้ามสัญญาสินค้าตัวนั้น คำว่า "ทดลองเล่น" บนหน้านี้จึงหมายถึงสิ่งที่บรีฟระบุไว้
// ตรงๆ ว่าทำได้: เข้าสู่ระบบแล้วไล่ดูหมวดเกมให้ครบหนึ่งรอบ เลือกเกมที่สนใจ อ่านกติกา
// ตารางจ่าย และเงื่อนไขของเกมนั้นให้จบ แล้วจึงเริ่มเดิมพันด้วยเงินจริง
//
// ⚠️ บรีฟรอบนี้ไม่ได้ให้ขั้นตอนการสมัครไว้เลย (รอบก่อนมีจำนวนขั้นตอนระบุไว้ รอบนี้
// ไม่มี) จึงห้ามเขียนลำดับขั้นการสมัครขึ้นเอง หัวข้อสุดท้ายของหน้าจึงพูดถึงระบบ
// ฝากถอน โปรโมชั่น และแอดมิน ซึ่งเป็นสิ่งที่บรีฟระบุไว้จริง
//
// ⚠️ รูปในหน้านี้ใช้ได้แค่ gamedemo8 กับ gamedemo16 เท่านั้น — เป็นอาร์ตสต็อกกลาง
// ของเทมเพลต (mtime 2026-08-04) ไม่ใช่อาร์ตเวิร์กของแบรนด์นี้ จึงอยู่ต่อได้ แต่ alt
// ต้องบรรยายภาพจริง และห้ามเอ่ยชื่อแบรนด์ใด เพราะไม่มีชื่อแบรนด์ไหนปรากฏอยู่บนรูป
// ทั้งสองใบ ส่วน gamedemo7/9/10/11/12/14/15/17/18 มีโลโก้หรือชื่อของผู้ให้บริการ
// เจ้าอื่นพิมพ์ทับอยู่กลางรูป และ gamedemo13 เป็นภาพล่อแหลม — ห้ามนำกลับมาใช้
// เพราะเท่ากับอ้างชื่อที่บรีฟไม่ได้เอ่ย ไฟล์ยังอยู่บนดิสก์ ห้ามลบ เป็นอินเวนทอรี
// gamedemo8 ("POPULAR GAME" 600x379) กับ gamedemo16 ("New Game" 650x411)
// ความกว้างที่วาดจริงสูงสุด ~600px ต่อใบ (กริดสองคอลัมน์ในการ์ด) จึงไม่ขยายเกิน
// ต้นฉบับ quality={62} ของสองใบนี้ตั้งไว้ต่ำกว่าค่าปกติ 80 มาตั้งแต่รอบก่อน เพราะ
// อาร์ตมีเกรนละเอียดจนไฟล์ AVIF เคยโตกว่า WebP ของตัวเอง (verify-build จะแดง)
// ห้ามดันกลับขึ้น — เป็นค่าต่อรูป ไม่ใช่การจูนต่อฟอร์แมต
//
// ⚠️ คำที่ห้ามหลงเหลือ: คำขายของของแบรนด์ก่อนๆ ศัพท์เว็บสล็อตล้วนของรอบก่อน
// และศัพท์หมวดลอตเตอรีทุกคำ — รายการเต็มอยู่ใน brand-spec §1 ไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาคำต้องห้ามเจอ false positive
//
// ⚠️ ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 24 ชั่วโมง
// **รอบนี้ไม่มีปี ไม่มีจำนวนขั้นตอน** เพราะบรีฟไม่ได้เอ่ยไว้ และห้ามเติมเลข
// ใบอนุญาต หน่วยงานกำกับ ชื่อผู้ดำเนินงาน ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP
// ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีที่ก่อตั้ง เพราะบรีฟไม่ได้เอ่ยไว้สักอย่าง
//
// ประโยคกำกับของบรีฟที่ห้ามตัดทิ้ง (เป็นส่วนหนึ่งของคอปปี้ ไม่ใช่ filler):
// ส่วนการระบุว่าเป็นเว็บลิขสิทธิ์ไทยแท้ควรมีข้อมูลใบอนุญาตและหน่วยงานที่ออก
// ใบอนุญาตให้ตรวจสอบได้ · ไม่มีเกมประเภทใดรับประกันผลกำไร · การเดิมพันทุกประเภท
// มีความเสี่ยงต่อการสูญเสียเงิน · ควรตรวจสอบว่าโปรโมชั่นครอบคลุมบาคาร่า สล็อต
// หรือบอลออนไลน์ประเภทใดบ้าง · ควรอ่านรายละเอียดประเภทเกมที่ร่วมรายการ เวลาตัดยอด
// และข้อกำหนดการใช้โบนัสก่อนรับ · คำว่าไม่จำกัดควรระบุให้ชัด · หากมีการใช้บัญชี
// บริษัทเจ้าของโดยตรง ควรแสดงชื่อบริษัทหรือนิติบุคคลที่เกี่ยวข้องให้ตรวจสอบได้ ·
// การใช้บัญชีบริษัทไม่ได้รับประกันความปลอดภัยของธุรกรรมทั้งหมด · ไม่ควรเปิดเผย
// รหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น
//
// banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion · banner2/banner3 และ
// slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import (ลำพังการ import ก็ทำให้
// ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น Announcement5 ทั้งเว็บ (รอบก่อนใช้ AnnouncementPremium —
// brand-spec §3 หมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้
// ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่ง
// จะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ม่วงนำ ทองรอง บนดำสนิท — สองฮิวจริง**
// พลิกออกจากชุดทองมังกรบนดำฮิวเดียวของรอบก่อน ซึ่งออกครบทุกจุดแล้ว ทั้งคลาส
// Tailwind raw hex และ rgba() (ค่าเดิมอยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive) รอบนี้ไม่มีชมพู ไม่มีเขียว
// ไม่มีน้ำเงิน ไม่มีเทา/เงิน ไม่มีส้ม และไม่มีแดงเลย มีแค่ม่วงกับทอง
// ลำดับปุ่มสื่อด้วยขั้ว "ทองถม vs ผิวจมขอบม่วง": ปุ่มหลักถมทองไล่เฉด #ffdf8c →
// #e2b33f ขอบ #7a5a0a หมึก #1a0526 · ปุ่มรอง (เข้าสู่ระบบ) เป็นผิวจม #140522 →
// #0a0213 ขอบ #7505cc/60 ตัวอักษรเนื้อความ #ece2f8 · ปุ่มลิงก์ภายในเป็นผิวจม
// เดียวกัน ขอบ #7505cc/55 ตัวอักษรม่วงอ่อน #d9b8ff (8.6:1) · ขอบรูปใช้ม่วงแบรนด์
// แบบโปร่ง · marker ของลำดับเลขใช้ทองแบรนด์ #e2b33f (8.1:1 บนผิวการ์ด)
// ⚠️ ห้ามกลับด้าน: พื้นถมทองต้องใช้หมึกเข้มเสมอ ห้ามขาวหรือทองอ่อน และ #7505cc
// #b453ff #3a0565 #2c0349 #7a5a0a เป็นเส้น ขอบ และออราเท่านั้น ห้ามถือตัวอักษร
// ทุกขนาด ออราในไฟล์นี้ใช้ rgba(117,5,204,α) และ rgba(226,179,63,α) เท่านั้น
// ⚠️ "มีทองอยู่" หรือ "มีม่วงอยู่" ไม่ใช่ตัวบอกว่าถูกแบรนด์ — ทองออกมาแล้วเก้าใน
// สิบสองรอบหลังสุด และม่วงเพิ่งมาสองรอบ ให้เทียบเป็นค่าทีละตัวกับตารางใน
// brand-spec §2 ไม่ใช่เทียบด้วยตาหรือด้วยตระกูลสี
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #ece2f8)
// ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง ปล่อยให้สืบทอดลงมา
// — มีแค่ปุ่ม ขอบรูป marker ของลำดับเลข และ <strong> ที่ประกาศสี โดย <strong>
// ใช้ทองไฮไลต์ #ffd45e ตัวเดียว (11.1:1 บนผิวการ์ด) และแต่ละ <strong> ครอบ
// "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิด
// แท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 156 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} ไล่ดูหมวดบาคาร่า สล็อต และบอลออนไลน์ให้ครบหนึ่งรอบ พร้อมอ่านกติกา ตารางจ่าย และอัตราต่อรองของแต่ละรายการก่อนเริ่มเดิมพันด้วยเงินจริงทุกครั้ง`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ไล่ดูหมวดเกมคาสิโนก่อนเริ่มเดิมพันจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#ffd45e]">{BRAND_NAME}</strong> เป็นเว็บคาสิโนออนไลน์ที่นำเสนอระบบเดิมพันออโต้สำหรับผู้สนใจเกมหลายประเภท
        <strong class="text-[#ffd45e]">ทั้งบาคาร่า สล็อต และบอลออนไลน์ รวมหมวดเกมไว้ในแพลตฟอร์มเดียว พร้อมเมนูจัดการบัญชี ตรวจสอบเครดิต และติดตามรายการต่างๆ ผ่านมือถือหรือคอมพิวเตอร์</strong>
        หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับระบบได้ไล่ดูให้ครบหนึ่งรอบ ตั้งแต่การเข้าสู่ระบบเพื่อค้นหาเกมและเปิดรายละเอียดของรายการที่สนใจ ไปจนถึงเมนูตรวจสอบเครดิตและการติดตามรายการ ก่อนจะเริ่มเดิมพันจริง
      </p>

      <p>
        คำว่า ทดลองเล่น ที่หน้านี้พูดถึงจึงหมายถึง
        <strong class="text-[#ffd45e]">การไล่ดูหมวดเกมที่จัดไว้ เลือกรายการที่สนใจ แล้วอ่านกติกา ตารางจ่าย และเงื่อนไขของเกมนั้นให้จบก่อนเริ่มเดิมพันด้วยเงินจริง</strong>
        ซึ่งเป็นสิ่งที่ระบบเปิดให้ทำได้อยู่แล้ว ไม่ใช่การแจกเครดิตทดลอง และไม่ใช่การรับประกันผลของรายการใดรายการหนึ่ง เพราะไม่มีเกมประเภทใดรับประกันผลกำไร และการเดิมพันทุกประเภทมีความเสี่ยงต่อการสูญเสียเงิน
      </p>

      <p>
