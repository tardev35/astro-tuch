---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็น **บทความจริง** (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login,
// /register หรือหน้าภาพแบบ /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง
// ไม่ใช่เช็กลิสต์หัวข้อของบรีฟที่ใช้กับ index.astro — บรีฟรอบนี้
// (src/assets/content.txt, 29 บรรทัด) ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าใหม่จาก
// ข้อเท็จจริงและคลังคำของบรีฟรอบนี้เท่านั้น (.claude/brand-spec-abm96.md §4-§5)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x4 · h3x0
//   h1  ทดลองเล่น <แบรนด์> เว็บเอเอ็มบีคาสิโน ศึกษากติกาเกมก่อนเดิมพันด้วยเงินจริง
//   h2  รูปแบบการเดิมพันของบาคาร่า สล็อต รูเล็ต และไฮโล ต่างกันอย่างไร
//   h2  อ่านอัตราจ่ายและวงเงินเดิมพันก่อนลงเงินจริงตั้งแต่ 1 บาท
//   h2  คาสิโนสดกับตารางเวลาเปิดโต๊ะ ไลฟ์เดิมพัน 24 ชั่วโมง
//   h2  สิ่งที่ควรตรวจสอบทุกครั้งก่อนยืนยันการเดิมพันด้วยเงินจริง
// รายการในกล่องเป็น <ul> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// ป้ายกำกับของ <ul> อยู่ใน aria-label **ห้ามเลื่อนเป็น heading**
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// 🚨🚨 ดรอปนี้ (2026-10-29) **แบรนด์ขาออกอยู่คนละแกนธุรกิจ** — รอบก่อน LOTTOPLUS
// เป็น **เว็บหวย** และไฟล์นี้เคยเป็นบทความเรื่องรูปแบบการแทงหวยทั้งหน้า พร้อม
// ตารางอัตราจ่ายของหมายเลขสองหลัก/สามหลัก รอบนี้เป็น **เว็บคาสิโนออนไลน์**
// เนื้อหาทั้งหน้าจึงถูก **เขียนใหม่ทั้งหน้า** ไม่ใช่แค่เปลี่ยนชื่อแบรนด์และสี
// บรีฟรอบนี้เรียกตัวเองว่า "เว็บเอเอ็มบีคาสิโน แหล่งเดิมพันเกมออนไลน์" และระบุ
// หมวดเกมไว้ **ห้าหมวด** (บาคาร่า · สล็อตออนไลน์ · รูเล็ต · ไฮโล · คาสิโนสด) ·
// เริ่มต้นเดิมพัน 1 บาท · ไลฟ์เดิมพัน 24 ชั่วโมง · คืนยอดเสีย 0.3% ·
// แนะนำเพื่อน 0.8% · สมัคร 3 ขั้นตอน · แอดมินออนไลน์ตลอด 24ชม.
// 🚨🚨 **ศัพท์หมวดธุรกิจของแบรนด์ขาออกเป็นคำค้างข้ามแบรนด์ ห้ามหลุดกลับมาแม้แต่คำ
// เดียวบนหน้านี้** — **รายการคำต้องห้ามเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่**
// เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// 🚨 กลับกัน **"บาคาร่า" / "สล็อต" / "รูเล็ต" / "ไฮโล" / "คาสิโนสด" /
// "คืนยอดเสีย 0.3%" / "แนะนำเพื่อน 0.8%" / "โบนัสไม่อั้น" เคยเป็นคำต้องห้ามของ
// รอบก่อน แต่รอบนี้เป็นถ้อยคำของบรีฟเอง — ห้ามลบออกเพราะอ่านคอมเมนต์เก่าใน
// ไฟล์ inventory แล้วเข้าใจผิด**
// ⚠️⚠️ ชื่อแบรนด์รอบนี้เป็น **ตัวละตินพิมพ์ใหญ่ติดเลข ยาว 5 อักขระ** ทุกจุด
// interpolate จาก BRAND_NAME (รวม alt= และ aria-label) **ห้ามพิมพ์ชื่อแบรนด์เป็น
// literal** และห้ามพิมพ์โดเมน — URL ของหน้ามาจาก pageGraph() เท่านั้น
//
// 🚨🚨 **คำว่า "ทดลองเล่น" อยู่ได้เฉพาะเพราะเป็นชื่อ route /ทดลองเล่น และชื่อเมนู
// จริง** (ใช้ใน h1 · title · description · breadcrumb) แต่ **บรีฟรอบนี้ไม่ได้พูดถึง
// โหมดเล่นโดยไม่ใช้เงินจริงเลยแม้แต่ประโยคเดียว** → **ห้ามอ้างว่าเว็บมีโหมดนั้นให้**
// ⚠️ และมีหนึ่งประโยคที่พูดตรงๆ ว่าบรีฟไม่ได้ระบุโหมดนั้นไว้ เพื่อไม่ให้ผู้อ่าน
// อนุมานเอาจากชื่อเมนู — **ห้ามถอดประโยคนั้นออก**
// 🚨 แกนของหน้าจึงเป็น **"ศึกษากติกา รูปแบบการเดิมพัน อัตราจ่าย และวงเงินของแต่ละ
// เกม ก่อนเดิมพันด้วยเงินจริง"** และ **ห้ามเขียนให้การศึกษากติกาดูเหมือนช่วย
// คาดการณ์หรือปรับผลของเกมถัดไป** — ประโยคของบรีฟที่ว่า "เกมเดิมพันมีความเสี่ยง
// และไม่สามารถรับประกันผลรางวัลได้" คือสิ่งที่กันข้อนั้น **ห้ามตัดออก**
//
// ⚠️ หัวข้อของหน้านี้ **ตั้งใจไม่ให้ซ้ำกับ /about-us และ index.astro** —
// index เล่าตามลำดับหัวข้อของบรีฟ · about-us เล่าว่า "เว็บไซต์ระบุอะไรไว้ และ
// ตรวจสอบได้จากที่ไหน" · **หน้านี้เล่า "กติกาและรูปแบบการเดิมพันของแต่ละเกม
// ต่างกันอย่างไร และต้องอ่านอะไรก่อนลงเงินจริง"** คนละแกนกัน ถ้ารอบหน้าคัดลอก
// หัวข้อของสองหน้านั้นมาวางที่นี่ จะได้หน้าที่แข่งกันเองใน index
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกม ชื่อผู้ให้บริการ หน่วยงานกำกับ เลขใบอนุญาต
// ปีก่อตั้ง จำนวนสมาชิก ค่า RTP จำนวนเกม หรือยอดฝากขั้นต่ำเป็นตัวเลข
// แม้แต่รายการเดียว** จึงห้ามเขียนลงหน้าเว็บ · ตัวเลขที่ขึ้นหน้าได้มีแค่ของบรีฟเอง:
// **1 บาท · 0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง / 24ชม.**
//
// 🚨 **บรีฟรอบนี้โฆษณาแล้วกำกับตัวเองในย่อหน้าเดียวกันแทบทุกย่อหน้า** — ทั้งสอง
// ครึ่งต้อง ship ครบ ประโยคกำกับไม่ใช่ filler ให้ตัดทิ้ง:
// 1) เกมเดิมพันมีความเสี่ยงและไม่สามารถรับประกันผลรางวัลได้ ·
//    ควรตรวจสอบรายชื่อผู้ให้บริการเกม เงื่อนไขการใช้งาน และความน่าเชื่อถือของ
//    แพลตฟอร์มก่อนทำรายการ (บรีฟบรรทัด 4 — รับที่ h1 และ h2 #4)
// 2) ยอดขั้นต่ำอาจแตกต่างกันตามประเภทเกมและค่ายผู้ให้บริการ ·
//    ควรตรวจสอบตารางเวลาเปิดโต๊ะและข้อกำหนดการใช้งานจริง
//    (บรีฟบรรทัด 6, 27 — รับที่ h2 #2 และ #3)
// 3) แม้เว็บไซต์จะใช้ข้อความว่าโบนัสไม่อั้น แต่ควรตรวจสอบว่ามีวงเงินสูงสุดหรือ
//    ข้อกำหนดเพิ่มเติมหรือไม่ (บรีฟบรรทัด 8 — รับที่ h2 #2)
// 4) **โปรโมชั่นคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือ
//    เพิ่มโอกาสชนะในครั้งถัดไป** (บรีฟบรรทัด 10 — รับที่ h2 #2)
// 5) ควรตรวจสอบข้อกำหนดด้านอายุ กฎหมายที่เกี่ยวข้อง และนโยบายความเป็นส่วนตัว ·
//    ไม่ควรเปิดเผยรหัสผ่านและรหัส OTP (บรีฟบรรทัด 14, 18 — รับที่ h2 #4)
// 6) ควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการเพื่อหลีกเลี่ยงบัญชีแอบอ้าง ·
//    เก็บหมายเลขรายการและหลักฐานไว้ · ตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุด
//    (บรีฟบรรทัด 22 — รับที่ h2 #4)
//
// ⚠️ route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ทดลองเล่น · /about-us · /contact-us · /terms · /privacy · /line
// 🚨🚨 **รอบนี้หน้าหวยสองหน้าถูกย้ายไป src/pages-disabled/ แล้ว** (แบรนด์นี้เป็น
// คาสิโน บรีฟไม่มีคำว่าหวยเลยสักคำ) — ไฟล์นี้เคยมีปุ่ม outline สองใบลิงก์ไป
// สองหน้านั้นในกล่องที่สาม **ถอดออกทั้งคู่แล้ว ห้ามเขียนกลับมา และห้ามเปลี่ยนไป
// ชี้ route ที่กุขึ้นมาใหม่** เพราะ href ชี้ route ที่ไม่มีจริงใน dist/ =
// verify-build แดง
//
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) **ทิศความสว่างเหมือนรอบก่อน แต่คนละตระกูลสี
// ทั้งชุด: เนื้อหาสว่าง โครมเข้ม** bg.json ของดรอปนี้คือ
// {"mode":"color","color":"#f8b9f0"} = **ชมพูพาสเทลอิ่มตัว**
// (รอบก่อนเป็น e1fef3 เขียวมินต์จาง — เปิด bg.json อ่านทุกรอบ ห้ามสืบทอด)
// **ห้าม "แก้" การ์ด/ปุ่มกลับไปเป็นผิวเข้ม** — ผิวเข้มบนหมึก #3d0a2c =
// ตัวอักษรหายไปเลย ไม่ใช่แค่จางลง
// ค่าที่ใช้ได้ในไฟล์นี้: `<strong>`/marker/ลิงก์ **#a30d63** (7.5:1 บนการ์ด #ffffff) ·
// เนื้อความ #3d0a2c (16.4:1) · หมึกรอง #7a4263 (7.5:1) · ทองเข้ม #6e4705 (8.2:1) ·
// พื้นไล่เฉดปุ่มหลัก #d11a7e -> #a30d63 -> #7a0449 (**พื้นถม** + หมึกขาว #ffffff —
// 5.0 / 7.5 / 10.8:1 ต่อ stop) · ปุ่มรองเป็นผิว #ffffff หมึก #a30d63 ขอบ #e0509f ·
// ปุ่ม outline ขอบ #f3a7d3 ตัวอักษร #a30d63 บนผิว #ffffff hover ยกเป็น #fff5fb ·
// ชั้นยก/ชิป #fcd9ee · เส้นบาง #f3a7d3 · ขอบตกแต่ง/ออรา #e0509f · ออราสว่าง #ff7ac2
// (**สี่ค่าท้ายห้ามถือตัวอักษร** — #e0509f ได้แค่ 3.6:1 บนการ์ดขาว)
// หมึกเนื้อความคือ #3d0a2c (= BRAND_TEXT) ซึ่ง **ไม่ประกาศในไฟล์นี้** การ์ด
// ContentBox ตั้งไว้ให้แล้วและย่อหน้าสืบทอดลงมา
// 🚨🚨 **#f3a7d3 · #fcd9ee · #e0509f · #ff7ac2 — ห้ามเป็นสีตัวอักษร** เป็นเส้น/ขอบ/
// ออรา/พื้นถมเท่านั้น · **#f2c14e ได้แค่ 1.7:1 บนการ์ดขาว ห้ามถือตัวอักษรเช่นกัน**
// บนการ์ดสว่างให้ใช้ #6e4705 แทนเมื่อต้องการโทนทอง · และตัวอักษรขาวบนพื้นเพจ
// #f8b9f0 ได้แค่ 1.6:1 **ห้ามเด็ดขาด**
// และ **ห้ามใช้หมึกเข้ม #3d0a2c บนไล่เฉดปุ่มหลัก** (บน #7a0449 ได้ 1.5:1)
// **ห้ามลากปลายอ่อนของไล่เฉดให้อ่อนกว่า #d11a7e** (ขาวบน #e0509f เหลือ 3.6:1)
// ออราที่อนุญาต: rgba(163,13,99,α) · rgba(224,80,159,α) · rgba(255,122,194,α) ·
// rgba(209,26,126,α) · rgba(61,10,44,α) · rgba(68,13,49,α) · rgba(43,6,32,α)
// ⚠️⚠️ **เงาบนการ์ดสว่างต้องเบา** — ค่า alpha ของรอบก่อนถูกสำหรับการ์ดเข้ม แต่บน
// ผิวขาวจะกลายเป็นคราบเทาหนา **ห้ามลอก alpha ของรอบก่อนมา**
// 🚨🚨 **เขียวมรกต-ทองอำพันบนผิวสว่างคือฮิวของรอบก่อน รอบนี้เป็นชมพูบานเย็น-พลัม**
// ที่ห้ามคือ **ค่าเฮกซ์ของแบรนด์เก่าแบบตรงหกหลัก** ไม่ใช่ "สีชมพู" ในฐานะตระกูลสี
// เพราะมีแบรนด์ชมพูมาแล้วหลายเจ้า (okkub88 ชมพูบานเย็น · ถอนชัวร์168 ชมพูบับเบิลกัม ·
// 123BET แดงชาด-ชมพูบลัช · ZANE96 แมเจนต้า-ไวโอเลต) ต้องเทียบ **ทีละค่าให้ตรงหกหลัก**
// กับตาราง brand-spec §2 (คู่ที่พิมพ์ผิดง่ายสุดลิสต์ไว้ในนั้นแล้ว และเขียนแบบไม่มี #
// โดยตั้งใจ เพื่อไม่ให้ sweep สะดุด)
// ค่าของ LOTTOPLUS รอบก่อนทันทีที่ต้องไม่หลงเหลือ เขียนแบบไม่มี #:
//  e1fef3 f0fdf7 d2f3e4 a3ddc3 19a97c 2fd49b 0d3326 3f6f5c 046c4e 0c7c58 03543c
//  8a6508 e2b32a c8d4d0
//  + rgba(4,108,78) rgba(25,169,124) rgba(47,212,155) rgba(226,179,42) rgba(13,51,38)
// ⚠️ ข้อยกเว้นสีเชิงความหมาย: **LINE green #00B900** (ไฟล์นี้ไม่มีปุ่ม LINE —
// ปุ่มนั้นอยู่ที่ /about-us, /contact-us และ footer)
//
// ลำดับปุ่มในไฟล์นี้สื่อด้วยพื้นถมสามขั้ว (ตรงกับคู่ปุ่มที่ล็อกไว้ใน brand-spec §2):
// · ปุ่มหลัก (สมัครสมาชิก) ไล่เฉด #d11a7e -> #a30d63 -> #7a0449 หมึกขาว #ffffff
// · ปุ่มรอง (เข้าสู่ระบบ) ผิว #ffffff หมึก #a30d63 ขอบหนา #e0509f
// · ปุ่มลิงก์ภายในเป็นปุ่ม outline ขอบบาง #f3a7d3 ตัวอักษร #a30d63 บนผิว #ffffff
//   hover ยกพื้นขึ้นเป็นการ์ดสำรอง #fff5fb
// · ชิปไอคอนของรายการใช้ขอบ #f3a7d3 บนพื้นถมอ่อน #fcd9ee ไม่ถือตัวอักษร
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง และไม่ใส่ mx-auto / max-w-* บน <p>
// เพราะการ์ดคุมความกว้างเองแล้ว — ที่ประกาศสีได้มีแค่ปุ่ม ชิปไอคอน และ <strong>
// · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรค
// ระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง (ลบแท็ก
// <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิม) และห้ามวาง <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังในข้อความของ prop และรอบนี้ต้องเป็นไอคอนหมวดเกมคาสิโน ไม่ใช่ไอคอน
// ลูกบอลหวย/โพย/ธงประเทศของรอบก่อน
// slot ของ ContentBox รับ **หนึ่ง element** เท่านั้น จึงห่อด้วย <div> ชั้นเดียว
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: รูปของดรอปนี้ถูกตรึงไว้ที่อื่นครบทุกไฟล์ —
// สไลด์สองใบของดรอปถูกตรึงไว้กับ index และ /promotion · banner1 /
// banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// แบนเนอร์ใบที่สองและสาม (2026-10-23) กับสไลด์ใบที่สามและสี่ (2026-09-29)
// เป็นอาร์ตเวิร์กของแบรนด์อื่น **ห้าม import ทั้งสี่ไฟล์** (ชื่อไฟล์เต็มอยู่ใน
// brand-spec §6) (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ ทุก build และ
// verify-build จะแดง) — ไฟล์ทั้งหมดยังอยู่บนดิสก์ **ห้ามลบ** เป็นอินเวนทอรี
// ของแบรนด์ถัดไป
//
// Announcement รอบนี้หมุนมาเป็นตัวเลขห้า ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ตัวท้ายชื่อหวยจึงหมุนออก · เขียนชื่อ variant แบบไม่มีเครื่องหมายคำพูด
// โดยตั้งใจ เพราะ tools/gen-tw-sources.mjs นับ literal ที่มีเครื่องหมายคำพูดว่าเป็น
// การ import จริง) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์
// นี้แล้ว จึงเรียกแบบ bare **ห้ามส่ง prop message** มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกัน
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -c บนเชลล์นี้
// ก็นับเป็นไบต์ ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับตัวนับ
// ของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 155 อักขระ (ชื่อแบรนด์รอบนี้ 5 อักขระ) เป็นประโยคเดียวที่บอกว่า
// หน้านี้มีไว้ทำอะไร แล้วหยุด **ต้องนับใหม่ทุกรอบ** ห้ามสืบทอดความยาว
// (Google ตัดราว 160 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนๆ ยาวเกิน
// — หน้าย่อยไม่ได้รับการยกเว้นเพดานล่าง 150 มีแค่หน้าแรกที่ได้)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} เว็บเอเอ็มบีคาสิโน หน้าศึกษากติกา รูปแบบการเดิมพัน อัตราจ่าย และวงเงินของบาคาร่า สล็อต รูเล็ต ไฮโล และคาสิโนสด ก่อนเริ่มเดิมพันด้วยเงินจริง`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} เว็บเอเอ็มบีคาสิโน ศึกษากติกาเกมก่อนเดิมพันด้วยเงินจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});

// คลาสปุ่มสามขั้วของหน้านี้ ประกาศครั้งเดียวแล้วใช้ซ้ำ เพื่อไม่ให้สองปุ่มที่ทำ
// หน้าที่เดียวกันหลุดไปคนละเฉดตอนรีแบรนด์รอบหน้า
const ctaPrimary =
  "flex items-center justify-center rounded-full border border-[#e0509f] bg-gradient-to-b from-[#d11a7e] via-[#a30d63] to-[#7a0449] px-8 py-3 font-black text-[#ffffff] shadow-[0_6px_18px_rgba(163,13,99,0.28)] transition-transform hover:scale-105";

const ctaSecondary =
  "flex items-center justify-center rounded-full border-2 border-[#e0509f] bg-[#ffffff] px-8 py-3 font-bold text-[#a30d63] shadow-[0_6px_18px_rgba(61,10,44,0.10)] transition-transform hover:scale-105";

const ctaQuiet =
  "flex items-center justify-center rounded-full border border-[#f3a7d3] bg-[#ffffff] px-8 py-3 font-bold text-[#a30d63] shadow-[0_4px_14px_rgba(61,10,44,0.10)] transition-all hover:scale-105 hover:border-[#e0509f] hover:bg-[#fff5fb] hover:shadow-[0_6px_18px_rgba(163,13,99,0.18)]";

const listChip = "mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#f3a7d3] bg-[#fcd9ee] text-sm";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#a30d63]">
          หน้านี้รวบรวมไว้ว่าควรศึกษากติกา รูปแบบการเดิมพัน อัตราจ่าย และวงเงินของเกมแต่ละหมวดอย่างไร ก่อนเริ่มเดิมพันด้วยเงินจริง
        </strong>
        {BRAND_NAME} เว็บเอเอ็มบีคาสิโน ระบุหมวดเกมไว้ตั้งแต่บาคาร่า สล็อตออนไลน์ รูเล็ต ไฮโล ไปจนถึงคาสิโนสดในที่เดียวแบบครบวงจร ผู้ใช้งานจึงเลือกได้ว่าจะเริ่มไล่อ่านเงื่อนไขจากหมวดใดก่อน
      </p>

      <p>
        <strong class="text-[#a30d63]">ข้อมูลที่เว็บไซต์ระบุไว้ไม่ได้กล่าวถึงโหมดเล่นโดยไม่ใช้เงินจริงไว้แต่อย่างใด</strong>
        ชื่อเมนูของหน้านี้จึงไม่ได้ยืนยันว่ามีรูปแบบนั้นให้ใช้งาน และควรตรวจสอบจากประกาศล่าสุดของเว็บไซต์ทางการเองว่าเปิดให้ศึกษารายการใดได้ในลักษณะใด
      </p>

      <p>
        ผู้ใช้งานสามารถศึกษากติกา รูปแบบการเดิมพัน และอัตราจ่ายของแต่ละเกมผ่านโทรศัพท์มือถือหรือคอมพิวเตอร์ได้
        <strong class="text-[#a30d63]">
          โดยควรตรวจสอบรายชื่อผู้ให้บริการเกม เงื่อนไขการใช้งาน และความน่าเชื่อถือของแพลตฟอร์มก่อนทำรายการ เนื่องจากเกมเดิมพันมีความเสี่ยงและไม่สามารถรับประกันผลรางวัลได้
        </strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title="รูปแบบการเดิมพันของบาคาร่า สล็อต รูเล็ต และไฮโล ต่างกันอย่างไร" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#a30d63]">แต่ละหมวดเกมใช้กติกา รูปแบบการเดิมพัน และอัตราจ่ายของตัวเอง</strong>
        การย้ายจากเกมหนึ่งไปอีกเกมหนึ่งจึงเท่ากับเริ่มอ่านเงื่อนไขชุดใหม่ ไม่ใช่เปลี่ยนแค่หน้าจอที่เห็น รายการด้านล่างคือสิ่งที่ควรดูให้ชัดก่อนลงเงินจริงในแต่ละหมวด
      </p>

      <ul class="flex flex-col gap-4" aria-label="กติกาและรูปแบบการเดิมพันของแต่ละหมวดเกมที่เว็บไซต์ระบุไว้">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🃏</span>
          <span>
            <strong class="text-[#a30d63]">บาคาร่าออนไลน์</strong> มีตัวเลือกเดิมพันตามกติกาของเกมมากกว่าหนึ่งแบบ และแต่ละแบบคิดอัตราจ่ายไม่เท่ากัน จึงควรอ่านกติกาของโต๊ะนั้นให้จบก่อนวางเดิมพันตาแรก
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎰</span>
          <span>
            <strong class="text-[#a30d63]">สล็อตออนไลน์</strong> มีธีมและฟีเจอร์แตกต่างกันในแต่ละเกม ทั้งเงื่อนไขการเข้าฟีเจอร์และวงเงินเดิมพันต่อรอบจึงเป็นของเกมนั้นเอง ไม่ใช่ค่ากลางของทั้งหมวด
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎡</span>
          <span>
            <strong class="text-[#a30d63]">รูเล็ต</strong> ใช้การหมุนวงล้อเป็นตัวตัดสินผล รูปแบบการวางเดิมพันที่โต๊ะรองรับและอัตราจ่ายของแต่ละรูปแบบจึงเป็นสองเรื่องที่ต้องอ่านคู่กันทุกครั้ง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎲</span>
          <span>
            <strong class="text-[#a30d63]">ไฮโล</strong> อ้างอิงผลจากลูกเต๋า มีรูปแบบการเดิมพันและอัตราจ่ายเป็นของตัวเอง ควรอ่านแยกจากเกมอื่นที่อยู่ในหน้าเดียวกัน แม้จะนั่งอยู่ในหมวดใกล้กันก็ตาม
          </span>
        </li>
      </ul>

      <p>
        การไล่อ่านทีละหมวดจึงช่วยให้เห็นว่าเงื่อนไขของเกมที่เลือกเขียนไว้อย่างไร
        <strong class="text-[#a30d63]">ไม่ใช่ช่วยคาดเดาผลที่จะออกในรอบถัดไป</strong>
        และสิ่งที่ยืนยันได้จริงคือกติกาที่แสดงอยู่บนหน้าเกมในขณะใช้บริการ ไม่ใช่ข้อความสรุปที่เขียนไว้ล่วงหน้า
      </p>
    </div>
  </ContentBox>

  <ContentBox title="อ่านอัตราจ่ายและวงเงินเดิมพันก่อนลงเงินจริงตั้งแต่ 1 บาท" as="h2">
    <div class="flex flex-col gap-5">
      <p>
        เว็บไซต์ระบุว่าสามารถเริ่มต้นเดิมพันได้ตั้งแต่ 1 บาท
        <strong class="text-[#a30d63]">แต่ยอดขั้นต่ำอาจแตกต่างกันตามประเภทเกมและค่ายผู้ให้บริการ</strong>
        จึงควรตรวจสอบเงื่อนไขของเกมที่ต้องการก่อนทำรายการ และดูวงเงินเดิมพันของโต๊ะหรือเกมนั้นจากหน้ารายละเอียดของมันเอง
      </p>

      <p>
        อัตราจ่ายที่แสดงอยู่มักผูกกับตัวเลือกเดิมพันตัวใดตัวหนึ่งเท่านั้น ก่อนลงเงินจริงจึงควรตรวจสอบว่าอัตรานั้นใช้กับตัวเลือกใด คิดจากวงเงินเดิมพันเท่าใด และมีข้อกำหนดอะไรกำกับอยู่
        <strong class="text-[#a30d63]">เพราะเกมแต่ละประเภทเขียนเงื่อนไขการจ่ายรางวัลไว้ไม่เหมือนกัน</strong>
      </p>

      <p>
        ด้านโปรโมชั่น เว็บไซต์ระบุรายการสำหรับสมาชิกไว้สองรายการ คือ
        <strong class="text-[#a30d63]">คืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน และแนะนำเพื่อน โบนัส 0.8% ไม่จำกัด</strong>
        ก่อนรับสิทธิ์ควรศึกษาประเภทเกมที่เข้าร่วม รอบเวลาคำนวณเครดิต และเงื่อนไขการถอนเงินให้ครบถ้วน
      </p>

      <p>
        <strong class="text-[#a30d63]">แม้เว็บไซต์จะใช้ข้อความว่าโบนัสไม่อั้น แต่ควรตรวจสอบว่ามีวงเงินสูงสุดหรือข้อกำหนดเพิ่มเติมหรือไม่</strong>
        และควรเข้าใจไว้ด้วยว่า
        <strong class="text-[#a30d63]">โปรโมชั่นคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งถัดไป</strong>
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/promotion" aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`} class={ctaQuiet}>ดูภาพโปรโมชั่น</a>

        <a href="/about-us" aria-label={`อ่านข้อมูลเกี่ยวกับ ${BRAND_NAME}`} class={ctaQuiet}>อ่านข้อมูลเกี่ยวกับเรา</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="คาสิโนสดกับตารางเวลาเปิดโต๊ะ ไลฟ์เดิมพัน 24 ชั่วโมง" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        คาสิโนสดมีการถ่ายทอดเกมจากโต๊ะเดิมพันแบบเรียลไทม์ จึงเป็นหมวดที่เงื่อนไขเวลาเข้ามาเกี่ยวข้องมากที่สุด เว็บไซต์ระบุว่ามีเกมไลฟ์ให้บริการตลอด 24 ชั่วโมง อย่างไรก็ตาม
        <strong class="text-[#a30d63]">
          ควรตรวจสอบตารางเวลาเปิดโต๊ะ วงเงินเดิมพัน และข้อกำหนดการใช้งานจริง เนื่องจากเกมบางประเภทอาจมีวงเงินและช่วงเวลาให้บริการแตกต่างกัน
        </strong>
      </p>

      <ul class="flex flex-col gap-4" aria-label="สิ่งที่ควรดูจากตารางโต๊ะเดิมพันของคาสิโนสด">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📺</span>
          <span>
            <strong class="text-[#a30d63]">โต๊ะที่เปิดอยู่จริงในขณะนั้น</strong> ไม่ใช่ทุกโต๊ะที่เปิดพร้อมกัน จึงควรดูจากรายการโต๊ะที่แสดงอยู่ตรงหน้า ไม่ใช่เทียบเอาจากครั้งก่อนที่เคยเข้าใช้งาน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>⏱️</span>
          <span>
            <strong class="text-[#a30d63]">ช่วงเวลาที่โต๊ะเปิดให้วางเดิมพันในแต่ละตา</strong> มีจำกัดตามจังหวะของเกมสด การอ่านกติกาไว้ก่อนจึงช่วยให้ไม่ต้องตัดสินใจทุกอย่างภายในช่วงเวลานั้น
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🪙</span>
          <span>
            <strong class="text-[#a30d63]">วงเงินเดิมพันต่อตาของโต๊ะที่เลือก</strong> ควรอ่านจากหน้ารายละเอียดของโต๊ะนั้นเอง เพราะเกมเดียวกันที่อยู่ต่างโต๊ะอาจกำหนดวงเงินไว้ไม่เท่ากัน
          </span>
        </li>
      </ul>
    </div>
  </ContentBox>

  <ContentBox title="สิ่งที่ควรตรวจสอบทุกครั้งก่อนยืนยันการเดิมพันด้วยเงินจริง" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        เว็บไซต์ระบุขั้นตอนสมัครสมาชิกไว้ 3 ขั้นตอน ผ่านโทรศัพท์มือถือและอุปกรณ์ที่เชื่อมต่ออินเทอร์เน็ต ก่อนดำเนินการควรตรวจสอบข้อกำหนดด้านอายุ กฎหมายที่เกี่ยวข้อง และนโยบายความเป็นส่วนตัว
        <strong class="text-[#a30d63]">รวมถึงตั้งรหัสผ่านที่คาดเดาได้ยาก และไม่ควรเปิดเผยรหัสผ่านและรหัส OTP ให้ใครทราบ</strong>
      </p>

      <ul class="flex flex-col gap-4" aria-label="รายการที่ควรตรวจสอบก่อนและหลังยืนยันการเดิมพัน">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🧾</span>
          <span>
            <strong class="text-[#a30d63]">ตรวจสอบรายการเดิมพันก่อนกดยืนยัน</strong> ทั้งเกมที่เลือก ตัวเลือกเดิมพัน ยอดเดิมพัน และอัตราจ่ายที่ระบบแสดงไว้ เพื่อให้เข้าใจเงื่อนไขของรายการนั้นก่อนลงเงินจริง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📂</span>
          <span>
            <strong class="text-[#a30d63]">เก็บหมายเลขรายการและหลักฐานที่เกี่ยวข้องไว้</strong> หากพบปัญหาเกี่ยวกับบัญชีสมาชิกหรือธุรกรรม จะใช้แจ้งรายละเอียดปัญหาให้ชัดเจนได้ทันที โดยไม่ต้องเปิดเผยข้อมูลบัญชีส่วนอื่น
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>💬</span>
          <span>
            <strong class="text-[#a30d63]">ช่องทางติดต่อแอดมินออนไลน์ตลอด 24ชม.</strong> ควรตรวจสอบจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง และควรตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุดอีกครั้ง
          </span>
        </li>
      </ul>

      <p>
        การอ่านกติกาและเงื่อนไขไว้ก่อนช่วยให้เห็นว่าระบบคิดอัตราจ่ายอย่างไร แต่ไม่ได้ช่วยคาดการณ์หรือปรับผลของเกมถัดไป
        <strong class="text-[#a30d63]">เพราะเกมเดิมพันมีความเสี่ยงและไม่สามารถรับประกันผลรางวัลได้</strong>
        เนื้อหาในหน้านี้จึงเขียนไว้ประกอบการใช้งานเท่านั้น ไม่ได้ใช้แทนเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้บริการ
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/register" aria-label={`สมัครสมาชิก ${BRAND_NAME}`} class={ctaPrimary}>สมัครสมาชิก</a>

        <a href="/login" aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`} class={ctaSecondary}>เข้าสู่ระบบ</a>
      </div>
    </div>
  </ContentBox>

