---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion,
// /login, /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์
// หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ (src/assets/content.txt) ไม่มี
// หมวด "ทดลองเล่น" และไม่มีส่วน SUB-PAGES เลย ทั้งหน้าจึงเขียนขึ้นใหม่จาก
// ข้อเท็จจริงและคลังคำของบรีฟรอบนี้ (brand-spec §6) ไม่ใช่แก้ทับประโยคของแบรนด์ก่อน
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
//   h1  ทดลองเล่น <แบรนด์> ไล่ดูบทเรียนและกติกาของแต่ละเกมก่อนเดิมพันจริง
//   h2  ไล่ดูกติกา สัญลักษณ์ และอัตราจ่ายของแต่ละเกมให้ครบก่อนเลือกหัวข้อที่สนใจ
//   h2  สิ่งที่ควรตรวจสอบให้ครบก่อนสมัครสมาชิกและลงทะเบียนเรียน
//   h2  โปรโมชั่นและช่องทางติดต่อแอดมิน <แบรนด์> ตลอด 24ชม.
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// 🚨 **ความต่างที่สำคัญที่สุดของรอบนี้กับรอบก่อน**: รอบก่อนเป็นแบรนด์หมวดกีฬา
// (เว็บติดตามการแข่งขันและราคาของคู่แข่ง) ส่วนรอบนี้คือ **เว็บสอนเล่นเกมเดิมพัน
// ออนไลน์หลายประเภท** = สล็อต บาคาร่า ยิงปลา ไฮโล บอล หวยออนไลน์ รวมสูตรและ
// เทคนิคเป็นบทเรียน ศัพท์แวดล้อมของเว็บกีฬารอบก่อนจึงเป็น **คำค้างที่ต้องไม่เหลือ
// แม้แต่คำเดียว** (รายการเต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้
// sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง) ทั้งหน้าเขียนใหม่หมด
// ไม่ใช่ find-and-replace ทับประโยคเดิม (ประโยคเดิม "ดูเข้าเค้า" เพราะใช้สล็อต
// เดียวกัน แต่กรอบของบรีฟคนละอันโดยสิ้นเชิง) · คำว่า `บอล`/`ฟุตบอล` ยังใช้ได้
// เพราะบรีฟรอบนี้ระบุเอง แต่คำแวดล้อมของเว็บกีฬารอบก่อนใช้ไม่ได้
// ⚠️ และ **นี่ไม่ใช่เว็บหวยด้วย** หวยเป็นเพียง 1 ใน 6 ประเภทเกมที่บรีฟเอ่ยถึง
// สองหน้าหมวดลอตเตอรีจอดอยู่ใน src/pages-disabled/ ไม่มี route ห้ามลิงก์ไปหา
// เป็น href ตายที่ทำให้ build แดง route ที่มีจริงรอบนี้คือ / · /about-us ·
// /contact-us · /login · /privacy · /promotion · /register · /terms ·
// /ทดลองเล่น · /ทางเข้า · /line
//
// กรอบของบรีฟรอบนี้คือ **รวบรวมคำอธิบายกติกา รูปแบบการเดิมพัน และแนวทางศึกษา
// ความเสี่ยงของเกมหลายประเภทไว้ในที่เดียว จากเศรษฐีพนันมือ1** บวกโปรโมชั่น
// คืนยอดเสีย 0.3% กับแนะนำเพื่อน 0.8% และช่องทางติดต่อเจ้าหน้าที่ 24ชม.
//
// 🚨 **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกมหรือผู้ให้บริการแม้แต่รายเดียว** จึงห้าม
// เขียนชื่อใดๆ ลงหน้าเว็บ · ⚠️ บรีฟรอบนี้ **ไม่ได้เอ่ยถึงใบอนุญาต ผู้กำกับดูแล
// นิติบุคคล ชื่อธนาคาร ค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีก่อตั้ง** จึงห้าม
// พูดถึงทั้งหมด และห้ามใช้คำว่า เว็บตรง / ไม่ผ่านเอเย่นต์ / คาสิโนสด / รูเล็ต
// สิ่งที่บรีฟให้มาและอ้างได้คือ: กติกา · สัญลักษณ์ · ตารางจ่ายรางวัล ·
// ความน่าจะเป็น · ประเภทการเดิมพัน · อัตราจ่าย · สูตรและเทคนิค · บทเรียน ·
// หลักสูตร · หัวข้อเรียน · ผู้สอน · ยอดที่ใช้คำนวณเครดิต · รอบคำนวณยอด ·
// ช่วงเวลารับสิทธิ์ · ลิงก์แนะนำและการเชื่อมโยงบัญชี · การสมัครสมาชิกและ
// ข้อมูลส่วนบุคคล · ค่าใช้จ่ายที่อาจเกี่ยวข้อง · รหัสผ่าน · รหัส OTP ·
// เจ้าหน้าที่ · ช่องทางทางการ · เว็บไซต์ทางการ · ประกาศล่าสุด
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามีโหมดทดลอง เครดิตทดลอง หรือเดโมฟรีเป็นบริการของเว็บ —
// จึงห้ามสัญญาสินค้าตัวนั้น คำว่า "ทดลองเล่น" บนหน้านี้จึงหมายถึงสิ่งที่บรีฟระบุ
// ไว้ตรงๆ ว่าทำได้: ไล่อ่านบทเรียน กติกา ความน่าจะเป็น และเงื่อนไขของแต่ละ
// โปรโมชั่นให้ครบหนึ่งรอบ และสอบถามเจ้าหน้าที่ ก่อนเริ่มเดิมพันจริง
//
// ⚠️ คำโฆษณาของบรีฟ ("รับได้ไม่จำกัดยูส" · "จากเศรษฐีพนันมือ1") อยู่ได้เฉพาะใน
// หัวข้อที่บรีฟเขียนไว้เอง (= หัวข้อของ index.astro) ห้ามขยายเป็นคำกล่าวอ้างใหม่
// เพราะย่อหน้าของบรีฟเองหักล้างทันทีว่าเทคนิคไม่ใช่สูตรรับประกันชัยชนะ
//
// 🚨 ประโยคกำกับความเสี่ยงของบรีฟที่ห้ามตัดทิ้ง (เป็นเนื้อหาของบรีฟ ไม่ใช่
// filler) และห้ามเขียนเสริมให้กลายเป็นคำโฆษณาที่บรีฟกำลังเตือนเรื่องนั้นอยู่:
// เทคนิคต่าง ๆ ควรใช้เพื่อทำความเข้าใจเกม ไม่ใช่สูตรรับประกันชัยชนะ ·
// ผลการเดิมพันมีความไม่แน่นอนและอาจทำให้สูญเสียเงินได้ · คำกล่าวอ้างเกี่ยวกับ
// ผู้สอนระดับมือหนึ่งควรตรวจสอบประสบการณ์และผลงานจากหลักฐานที่เชื่อถือได้ ·
// การคืนยอดเสียไม่ได้รับประกันว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือช่วยลด
// ความเสี่ยงทั้งหมด · แม้โปรโมชั่นจะระบุว่าไม่จำกัด แต่ควรยืนยันข้อกำหนด
// เกี่ยวกับจำนวนบัญชีที่เข้าร่วม รอบจ่ายเครดิต และเงื่อนไขการใช้งานจากประกาศ
// ล่าสุด · ตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยง
// บัญชีแอบอ้าง · ไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น ·
// ไม่ควรเชื่อคำโฆษณาที่รับประกันผลกำไรจากการเดิมพัน
//
// 🚨 **รอบนี้หน้านี้ไม่มีรูปเลย และนั่นตั้งใจ** — ดรอปนี้ (brand-spec §5) ไม่มี
// article illustration (ไม่มี banner2+) และ slide1/slide2 ถูกตรึงไว้กับ index
// กับ /promotion เท่านั้น ส่วน gamedemo*.webp ที่แบรนด์เก่ากว่าเคยใช้เป็น
// **อาร์ตสต็อกของเทมเพลตในหมวดอื่น** (ตัวการ์ตูน ลานนีออนชมพู-ฟ้า) ซึ่งขัดทั้ง
// แกนแบรนด์และพาเลตทอง-แดง-ดำของรอบนี้ จึงไม่ import **ไฟล์ยังอยู่บนดิสก์
// ห้ามลบ เป็นอินเวนทอรีของแบรนด์หมวดนั้นรอบถัดไป** — แค่ห้าม import (ลำพังการ
// import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดงถ้าไม่ถูก render)
// banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจาก
// หน้า · banner2/banner3 และ slide3/slide4 เป็นอาร์ตเวิร์กของแบรนด์คนละราย
// (slide3/slide4 เป็นโปสเตอร์หวยของอีกแบรนด์) ห้าม import
//
// ⚠️ ตัวเลขที่อ้างได้มีแค่สี่ตัวของบรีฟเอง: 0.3% · 0.8% · 24ชม. · 3 ขั้นตอน
//
// Announcement รอบนี้หมุนมาเป็น Announcement5 ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ Announcement3 จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็น
// คอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare **ห้ามส่ง prop message** มิฉะนั้น
// ข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตรอบนี้ (brand-spec §2) เป็น **ทองน้ำผึ้งนำสำหรับตัวอักษร + แดงชาดจีนเป็น
// สีอัตลักษณ์ที่ใช้ถมพื้น บนพื้นดำสนิท**
// ⚠️ **ทองเคยนำมาแล้วเกือบทุกแบรนด์ และแดงเคยนำมาแล้วหลายแบรนด์** "มีทองหรือมี
// แดงอยู่" จึงไม่ใช่ตัวบอกว่าถูกแบรนด์ ให้เทียบเป็น **"ค่า"** ทีละตัวกับตารางใน
// brand-spec §2 ไม่ใช่ด้วยตา (ค่าของแบรนด์เก่าไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep
// หาสีแบรนด์เก่าเจอ false positive ในไฟล์นี้เอง)
// ค่าที่ใช้ได้ในไฟล์นี้: ทองน้ำผึ้ง #f0c878 (หัวข้อ/<strong>/marker/พื้นถม CTA) ·
// งาช้าง #fff8d8 (เนื้อความ = BRAND_TEXT) · หมึก #2a0608 (ตัวอักษรบนพื้นถมทอง) ·
// แดงชาดจีน #d9212a และแดงเลือดหมู #8e1a16 · ผิวการ์ด #4e2120 / ชั้นกลาง #300605 /
// ชั้นจม #150303 / พื้นเพจ #000000
// 🚨 **แดงทั้งสองเฉดห้ามถือตัวอักษรทุกขนาด** (d9212a ได้ 2.69:1 บนผิวการ์ดและ
// 4.20:1 บนพื้นเพจ · 8e1a16 ต่ำกว่านั้นทุกพื้น) ทั้งคู่เป็น **พื้นถม / ขอบ /
// ออรา / ไอคอนเท่านั้น** ถ้าต้องการตัวอักษรที่อ่านว่า "แดง" ให้ถมแดง #d9212a
// เป็นพื้นแล้ววางงาช้าง #fff8d8 ทับ (4.68:1 ผ่าน AA — ปลายเข้ม #8e1a16 ของไล่เฉด
// เดียวกันได้ 8.5:1) ปุ่มเข้าสู่ระบบในไฟล์นี้ทำแบบนั้น
// ออราที่อนุญาต: rgba(240,200,120,α) · rgba(217,33,42,α) · rgba(142,26,22,α)
// ⚠️ ห้ามกลับด้าน: พื้นถมทอง #f0c878 ต้องใช้หมึกเข้ม #2a0608 เสมอ (11.74:1)
// ห้ามขาวหรือครีม · รอบนี้ไม่มีฟ้า/น้ำเงิน ไม่มีม่วง ไม่มีเขียว (นอกจาก LINE)
// ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์ ไม่มีชมพู/ฟูเชีย ไม่มีส้มสด และ **ไม่มีบรอนซ์**
// (บรอนซ์เป็นสีที่สามของรอบก่อน) — แดงรอบนี้เป็นแดงชาดจีน ไม่ใช่ส้มและไม่ใช่
// โรสโกลด์ · #00B900 ไม่ปรากฏในไฟล์นี้ (ปุ่ม LINE อยู่บน /about-us กับ
// /contact-us) ปุ่มในไฟล์นี้จึงมีสามขั้ว: พื้นถมทอง vs พื้นถมแดง vs ผิวจม
// ขอบทองโปร่ง
// marker ของลำดับเลขใช้ทองน้ำผึ้ง #f0c878 (8.47:1 บนผิวการ์ด — เป็นตัวอักษร
// จึงใช้แดงไม่ได้เด็ดขาด) และชิปไอคอนใช้แดงเลือดหมูเป็น **เส้นขอบ** บนชั้นกลาง
// #300605 ไม่ถือตัวอักษร
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT
// #fff8d8, 12.59:1 บนผิวยก #4e2120) ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่
// ประกาศสีของตัวเอง ปล่อยให้สืบทอดลงมา และไม่ใส่ mx-auto / max-w-* บน <p> เพราะ
// การ์ดคุมความกว้างเองแล้ว — มีแค่ปุ่ม ชิปไอคอน marker ของลำดับเลข และ <strong>
// ที่ประกาศสี โดย <strong> ใช้ทองน้ำผึ้ง #f0c878 ตัวเดียวตาม brand-spec §2
// และแต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่
// เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง
// และห้ามวาง <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังในข้อความของ prop
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 154 อักขระ เป็นประโยคเดียวที่บอกว่าหน้านี้มีไว้ทำอะไร แล้วหยุด
// (Google ตัดราว 155 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนยาวเกิน)
//
// ห้ามให้สตริงนี้มีชื่อของสองหน้าหมวดลอตเตอรีที่จอดอยู่ใน src/pages-disabled/
// (ชื่อไฟล์ทั้งสองอยู่ใน brand-spec §7) เพราะ sweep ของรอบถัดไปจะอ่านเป็น
// false positive ว่ายังมีลิงก์ไปหน้าที่ไม่มี route
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} เว็บสอนเล่นเกมออนไลน์ หน้ารวมวิธีไล่ดูกติกา สัญลักษณ์ ตารางจ่ายรางวัล และอัตราจ่ายของแต่ละเกม ก่อนตัดสินใจสมัครสมาชิกและเดิมพันจริง`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ไล่ดูบทเรียนและกติกาของแต่ละเกมก่อนเดิมพันจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#f0c878]">{BRAND_NAME} รวบรวมคำอธิบายกติกา รูปแบบการเดิมพัน และแนวทางศึกษาความเสี่ยงของเกมเดิมพันออนไลน์หลายประเภทไว้ในที่เดียว</strong>
        ทั้งสล็อต บาคาร่า ยิงปลา ไฮโล บอล และหวยออนไลน์ พร้อมเมนูสมัครสมาชิก ลงทะเบียน และตรวจสอบโปรโมชั่น หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับระบบได้ไล่ดูให้ครบหนึ่งรอบก่อนเริ่มใช้งานจริง
        ตั้งแต่หัวข้อบทเรียนที่เปิดให้ศึกษา ไปจนถึงประเภทการเดิมพันและอัตราจ่ายของแต่ละเกม
      </p>

      <p>
        คำว่า ทดลองเล่น ที่หน้านี้พูดถึงจึงหมายถึง
        <strong class="text-[#f0c878]">การไล่อ่านบทเรียน กติกา และเงื่อนไขบริการให้ครบก่อนเริ่มเดิมพันจริง</strong>
        ไม่ใช่การแจกเครดิตทดลอง และเทคนิคที่อธิบายไว้ควรใช้เพื่อทำความเข้าใจเกม ไม่ใช่สูตรรับประกันชัยชนะ หากพบข้อสงสัยระหว่างใช้งานสามารถสอบถามเจ้าหน้าที่ผ่านช่องทางทางการได้
      </p>

      <p>
        อีกเรื่องที่ควรไล่ดูไปพร้อมกันคือข้อกำหนดการเปิดบัญชีสมาชิกและการใช้ข้อมูลส่วนบุคคล รวมถึงรายละเอียดของโปรโมชั่นที่กำลังสนใจ
        <strong class="text-[#f0c878]">เพราะผลการเดิมพันมีความไม่แน่นอนและอาจทำให้สูญเสียเงินได้</strong>
        การอ่านให้ครบตั้งแต่ก่อนเริ่มจึงช่วยให้ทราบว่าแต่ละเกมมีกติกาอย่างไร และแต่ละโปรโมชั่นให้สิทธิ์ในรอบเวลาใด
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ไล่ดูกติกา สัญลักษณ์ และอัตราจ่ายของแต่ละเกมให้ครบก่อนเลือกหัวข้อที่สนใจ" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        ลำดับการไล่ดูจะเป็นชุดเดียวกันทุกครั้ง
        <strong class="text-[#f0c878]">เปิดหัวข้อของเกมที่สนใจ อ่านกติกาพื้นฐาน แล้วจึงดูสัญลักษณ์ ตารางจ่ายรางวัล ประเภทการเดิมพัน และอัตราจ่ายของเกมนั้นต่อ</strong>
        จากนั้นค่อยอ่านส่วนความน่าจะเป็นและข้อจำกัดของเกมประกอบ การไล่ดูให้ครบหนึ่งรอบก่อนจึงช่วยให้สอบถามเจ้าหน้าที่ได้ตรงประเด็นเมื่อมีข้อสงสัย
      </p>

      <ul class="flex flex-col gap-4" aria-label="จุดที่ควรไล่ดูให้ครบก่อนเริ่มเดิมพันจริง">
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#8e1a16] bg-[#300605] text-sm">🎰</span>
          <span>
            <strong class="text-[#f0c878]">สัญลักษณ์และตารางจ่ายรางวัลของเกมสล็อต</strong> ควรอ่านเป็นรายเกมก่อนเริ่ม เพราะแต่ละเกมกำหนดสัญลักษณ์และวิธีคิดรางวัลไว้ไม่เหมือนกัน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#8e1a16] bg-[#300605] text-sm">🃏</span>
          <span>
            <strong class="text-[#f0c878]">กติกาและความน่าจะเป็นของบาคาร่า</strong> ควรอ่านควบคู่กับประเภทการเดิมพันแต่ละแบบ เพื่อให้เห็นว่าอัตราจ่ายที่ระบุไว้มาจากเงื่อนไขอะไร
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#8e1a16] bg-[#300605] text-sm">🎲</span>
          <span>
            <strong class="text-[#f0c878]">รูปแบบการเล่นของยิงปลาและไฮโล</strong> ควรแยกศึกษาเป็นรายเกม เพราะวิธีเดิมพันและการนับผลของสองเกมนี้ไม่เหมือนกัน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#8e1a16] bg-[#300605] text-sm">🎯</span>
          <span>
            <strong class="text-[#f0c878]">ประเภทการเดิมพันและอัตราจ่ายของบอลและหวยออนไลน์</strong> ควรอ่านให้ชัดเจนก่อนทำรายการ และตรวจสอบเงื่อนไขที่เว็บไซต์แสดงอยู่ขณะใช้งานอีกครั้ง
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#f0c878]">สิ่งที่การไล่ดูช่วยได้คือทำให้รู้ว่าบทเรียนและเงื่อนไขอยู่ตรงไหนเท่านั้น</strong>
        ไม่ได้เป็นการรับประกันผลของการเดิมพันหรือยอดเครดิตที่จะได้รับ รายละเอียดที่เว็บไซต์แสดงอยู่ขณะใช้งานจึงเป็นสิ่งที่ควรยึดเป็นหลัก และควรกำหนดงบไว้ล่วงหน้าก่อนเริ่มทุกครั้ง
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/about-us"
          aria-label={`อ่านหน้าเกี่ยวกับเราของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#f0c878]/45 bg-[#150303] px-8 py-3 font-bold text-[#fff8d8] shadow-[0_0_12px_rgba(142,26,22,0.5)] transition-all hover:scale-105 hover:border-[#f0c878] hover:shadow-[0_0_18px_rgba(240,200,120,0.4)]">
          อ่านเกี่ยวกับเรา
        </a>

        <a
          href="/promotion"
          aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#f0c878]/45 bg-[#150303] px-8 py-3 font-bold text-[#fff8d8] shadow-[0_0_12px_rgba(142,26,22,0.5)] transition-all hover:scale-105 hover:border-[#f0c878] hover:shadow-[0_0_18px_rgba(240,200,120,0.4)]">
          ดูภาพโปรโมชั่น
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="สิ่งที่ควรตรวจสอบให้ครบก่อนสมัครสมาชิกและลงทะเบียนเรียน" as="h2">
    <div class="flex flex-col gap-5">
      <p>
        การไล่ดูระบบมีประโยชน์ที่สุดเมื่อมองว่าเป็นการอ่านรายละเอียดให้จบก่อน
        <strong class="text-[#f0c878]">เป้าหมายคือรู้ว่าเว็บไซต์รวบรวมบทเรียนอะไรไว้ให้ศึกษาบ้าง แต่ละรายการมีเงื่อนไขอย่างไร และสอบถามเจ้าหน้าที่ได้ทางไหนเมื่อมีข้อสงสัย</strong>
        รายการด้านล่างคือชุดที่ควรตรวจก่อนลงทะเบียน และควรตรวจซ้ำทุกครั้งที่กลับเข้ามาใหม่ เพราะเงื่อนไขปรับเปลี่ยนได้ตามที่เว็บไซต์กำหนด
      </p>

      <ol class="ml-6 list-decimal space-y-3 marker:font-black marker:text-[#f0c878]">
        <li>
          <strong class="text-[#f0c878]">ที่อยู่เว็บไซต์ทางการ</strong> ควรตรวจสอบให้ถูกต้องก่อนเลือกเมนูสมัครสมาชิกหรือกรอกข้อมูลใด ๆ ไม่ใช่เปิดจากลิงก์ที่ส่งต่อกันมา และควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ
          เพื่อหลีกเลี่ยงบัญชีแอบอ้าง
        </li>
        <li>
          <strong class="text-[#f0c878]">เนื้อหาการสอนและรายละเอียดผู้จัดทำ</strong> ควรค้นหาข้อมูลเกี่ยวกับรูปแบบบทเรียน หัวข้อเรียน และผู้สอน ก่อนเลือกหัวข้อที่สนใจ เพราะคำกล่าวอ้างเกี่ยวกับผู้สอนระดับมือหนึ่งควรตรวจสอบประสบการณ์และผลงานจากหลักฐานที่เชื่อถือได้
        </li>
        <li>
          <strong class="text-[#f0c878]">ข้อกำหนดการสมัครและค่าใช้จ่ายที่อาจเกี่ยวข้อง</strong> ควรอ่านให้ครบถ้วนก่อนลงทะเบียน ทั้งคุณสมบัติผู้สมัคร อายุที่ได้รับอนุญาต นโยบายการใช้ข้อมูลส่วนบุคคล และค่าใช้จ่ายที่ระบุไว้
        </li>
        <li>
          <strong class="text-[#f0c878]">เงื่อนไขของโปรโมชั่นที่กำลังสนใจ</strong> ควรเปิดอ่านจากประกาศล่าสุด ทั้งประเภทเกมที่ร่วมรายการ ยอดที่ใช้คำนวณเครดิต รอบคำนวณยอด และช่วงเวลารับสิทธิ์
        </li>
        <li>
          <strong class="text-[#f0c878]">ข้อมูลที่จะส่งให้เจ้าหน้าที่ตรวจสอบ</strong> ควรกรอกข้อมูลที่ถูกต้อง ตั้งรหัสผ่านที่ปลอดภัย ไม่ใช้ข้อมูลของบุคคลอื่นในการลงทะเบียน และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น แม้จะอ้างว่าเป็นเจ้าหน้าที่ก็ตาม
        </li>
      </ol>

      <p>
        <strong class="text-[#f0c878]">การอ่านให้ครบตั้งแต่ก่อนเริ่มช่วยให้แจ้งเรื่องได้ตรงประเด็นเมื่อเกิดปัญหาขึ้นจริง</strong>
        หากพบปัญหาระหว่างใช้งาน ควรเตรียมข้อมูลและหลักฐานที่เกี่ยวข้องไว้สำหรับการตรวจสอบ พร้อมแจ้งรายละเอียดให้ชัดเจนเมื่อติดต่อเจ้าหน้าที่ผ่านช่องทางทางการ
        และไม่ควรเชื่อคำโฆษณาที่รับประกันผลกำไรจากการเดิมพัน
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`โปรโมชั่นและช่องทางติดต่อแอดมิน ${BRAND_NAME} ตลอด 24ชม.`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        เมื่อคุ้นเคยกับบทเรียนและขั้นตอนการใช้งานแล้ว เรื่องถัดไปคือรายการโปรโมชั่นที่เว็บไซต์ระบุไว้ ซึ่งมีทั้ง
        <strong class="text-[#f0c878]">คืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อน โบนัส 0.8% ไม่จำกัด</strong>
        โดยรายการแรกระบุการคืนเครดิตตามยอดเสียที่เข้าเงื่อนไขในแต่ละวัน จึงควรตรวจสอบว่าเกมประเภทใดร่วมรายการ มีรอบคำนวณยอดเมื่อใด และต้องกดรับเครดิตด้วยตนเองหรือไม่
        รวมถึงอ่านข้อกำหนดเกี่ยวกับการนำเครดิตไปใช้และการถอนเงินให้ครบถ้วน ทั้งนี้ การคืนยอดเสียไม่ได้รับประกันว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือช่วยลดความเสี่ยงทั้งหมด
      </p>

      <p>
        ส่วนรายการแนะนำเพื่อนควรศึกษาวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และยอดที่ใช้คำนวณโบนัสให้ครบถ้วนก่อนเข้าร่วม แม้โปรโมชั่นจะระบุว่าไม่จำกัด
        แต่ควรยืนยันข้อกำหนดเกี่ยวกับจำนวนบัญชีที่เข้าร่วม รอบจ่ายเครดิต และเงื่อนไขการใช้งานจากประกาศล่าสุดให้ชัดเจน
        <strong class="text-[#f0c878]">หากมีข้อสงสัยสามารถติดต่อเจ้าหน้าที่ผ่านช่องทางทางการเพื่อสอบถามรายละเอียดเพิ่มเติมได้</strong>
        โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่นไม่ว่ากรณีใด
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#8e1a16] bg-[#f0c878] px-8 py-3 font-black text-[#2a0608] shadow-[0_0_14px_rgba(240,200,120,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#f0c878]/45 bg-gradient-to-b from-[#d9212a] to-[#8e1a16] px-8 py-3 font-bold text-[#fff8d8] shadow-[0_0_12px_rgba(217,33,42,0.45)] transition-transform hover:scale-105">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
