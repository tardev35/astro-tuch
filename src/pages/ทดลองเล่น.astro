---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login,
// /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx
// ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บน
// ข้อเท็จจริงของ UP555 เท่านั้น (src/assets/content.txt)
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
//
// UP555 เป็น **คาสิโนอัปเดตล่าสุด ปรับปรุงทางเข้าเล่นเกมคาสิโนใหม่** แง่มุมที่บรีฟ
// ระบุไว้มีเท่านี้: ปรับทางเข้าใหม่ให้รองรับมือถือได้สะดวกขึ้น · รวมเกมหลายประเภทไว้
// ในบัญชีเดียว ทั้งสล็อต บาคาร่า บอล (เดิมพันฟุตบอล) และหวย · เลือกหมวดเกม ตรวจสอบ
// เครดิต โปรโมชั่น และประวัติรายการผ่านระบบเดียว · สลับประเภทเกมได้โดยไม่ต้องสมัคร
// ใหม่หลายครั้ง · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · สมัครบนมือถือ 3 ขั้นตอน ·
// แอดมิน 24 ชั่วโมง · PIN/OTP และรหัสผ่านห้ามเปิดเผย
//
// ⚠️ บรีฟไม่ได้ประกาศว่ามี "โหมดทดลอง" เครดิตทดลอง หรือเกมเดโมเป็นบริการของเว็บ —
// จึงห้ามสัญญาสินค้าตัวนั้น และห้ามดึง src/assets/gamedemo*.webp กลับมา (ไฟล์ชุดนั้น
// เป็นอินเวนทอรีเก่า ไม่ใช่อาร์ตเวิร์กของดรอปนี้) หน้านี้จึงไม่มีรูปและไม่มีกริดเกม
// เดโม โดยตั้งใจ — ตัวหน้าเป็นบทความล้วน
// สิ่งที่บรีฟระบุไว้ตรง ๆ ว่าควรทำก่อนเริ่มใช้งานคือ "เลือกสล็อต บาคาร่า บอล หวย
// หรือเกมที่ต้องการ พร้อมตรวจสอบรายละเอียดและโปรโมชั่นก่อนเริ่มใช้งาน" = ไล่เปิด
// ข้อมูลเกมและเงื่อนไขให้ครบก่อนเล่นด้วยเครดิตจริง ไม่ใช่การเล่นฟรี
//
// ⚠️ บรีฟรอบนี้ **ไม่ได้** เอ่ยถึง "เว็บตรงต่างประเทศ" "บัญชีบริษัทแท้ 100%"
// "ไม่ผ่านเอเย่นต์" "การันตีระบบเกมมาตรฐาน" "เกมคาสิโนสด" หรือ "จำนวนค่าย"
// (ของ DM899 รอบก่อน) และไม่ได้เอ่ยถึงฟรีสปิน ตัวคูณ เกมโบนัส หรือเดิมพันขั้นต่ำ/
// สูงสุด (ของ 1SS365 ก่อนนั้น) จึงห้ามอ้างชุดคำเหล่านั้น
//
// ถึงหวยจะเป็นหมวดเกมที่บรีฟระบุไว้จริง ก็ **ห้ามลิงก์ไป /ตรวจหวย หรือ /แนวทาง**
// เพราะสองหน้านั้นอยู่ใน src/pages-disabled/ = เราต์ตายและทำให้ build แดง
// ตัวเลขที่อ้างได้มีแค่ 0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง และห้ามเพิ่มใบอนุญาต
// ชื่อหน่วยงานกำกับ ชื่อค่ายเกม ชื่อธนาคาร ยอดฝากขั้นต่ำ จำนวนสมาชิก ปีที่ก่อตั้ง
// หรือค่า RTP เพราะบรีฟไม่ได้เอ่ยไว้สักชื่อ
//
// ประโยคกำกับของบรีฟที่ห้ามตัดทิ้ง: ผลการเดิมพันมีความไม่แน่นอน จึงไม่สามารถ
// รับประกันผลกำไรหรือเงินรางวัลจากการเล่นได้ · ความปลอดภัยควรพิจารณาจากมาตรการที่
// ตรวจสอบได้ เช่น การรักษาความปลอดภัยของบัญชี ระบบยืนยันตัวตน และข้อมูลผู้ดำเนินงาน
// จึงไม่ควรใช้คำว่า "ปลอดภัยแน่นอน" เป็นการรับประกันโดยไม่มีข้อมูลดังกล่าวรองรับ ·
// รายการเกมและผู้ให้บริการอาจอัปเดตหรือเปลี่ยนแปลงตามช่วงเวลา
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: banner1/banner1-mobile/og.png เป็นของ glob ที่
// MainLayout ปักไว้ ห้ามอ้างจากหน้า · slide1/slide2 ของดรอปนี้เป็นของ index และ
// /promotion · slide3/slide4/banner2/banner3 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น Announcement5 ทั้งเว็บ (รอบก่อน DM899 ใช้ Announcement3)
// — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ UP555 แล้ว จึงเรียก
// แบบ bare ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ UP555 (brand-spec §2) **ทองนำ เงินโครเมียมรอง บนดำอมน้ำตาล** เพราะโลโก้
// เป็นตัว U/UP สีเงินโครเมียมคู่กับเลข 555 สีทองเมทัลลิก บนแบนเนอร์พื้นดำอมน้ำตาล:
// ทองแบรนด์ #ebbb54 (ขอบ ออรา marker ปุ่มรอง) · ทองสว่าง #fce675 (หมึก strong +
// ต้นไล่เฉดปุ่มหลัก) · ทองเข้ม #ab6d24 (ปลายไล่เฉดปุ่มหลัก, ขอบ) · ทองกลาง #d6a53a
// (ไอคอน bullet) · เงินสว่าง #f3f3f2 (hover ปุ่มรอง) · พื้นการ์ด #130b03 ·
// พื้นชิป/ป้าย #241705 · พื้นลึกสุด #0c0502 · หมึกบนพื้นทอง #160d02 ·
// เนื้อความ #f8eed9 (BRAND_TEXT)
// ชุดเขียวมรกต-แดง-ทองของ DM899 (#01a326 #4ade6b #12c23a #01841b #fb252b #ffe9a8
// #f2b422 #0a1a0e #102a16 #06140a #e4f2e4 rgba(1,163,38,*) rgba(3,10,5,*)) ออกครบ
// ทุกจุดแล้ว ทั้งคลาส Tailwind raw hex และ rgba()
// กฎคอนทราสต์: พื้นทองสว่าง → หมึก #160d02 เสมอ และปุ่มรองเป็น "ขอบทองบนพื้นดำ
// อมน้ำตาล" ไม่ใช่ถมทองอีกใบ
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// — การ์ดตั้งสีเนื้อความ #f8eed9 ไว้ที่ตัวการ์ดแล้ว ย่อหน้าจึงไม่ใส่คลาสสีซ้ำ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 152
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} ด้วยการไล่เปิดข้อมูลเกมสล็อต บาคาร่า บอล หวย ตรวจสอบเงื่อนไขโปรโมชั่น เครดิต และประวัติรายการในบัญชีให้ครบก่อนเริ่มเดิมพันด้วยเครดิตจริง`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} ไล่เปิดข้อมูลเกมและรายละเอียดการเดิมพันก่อนเริ่มเล่นจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed">
        <strong class="text-[#fce675]">{BRAND_NAME}</strong> รวมเกมเดิมพันหลายรูปแบบไว้ในบัญชีเดียว
        <strong class="text-[#fce675]">ทั้งสล็อต บาคาร่า บอล และหวยตามรายการที่ระบบเปิดให้บริการ</strong>
        หน้านี้เปิดไว้ให้ผู้ที่ยังไม่คุ้นกับทางเข้าเล่นใหม่ได้ไล่ดูระบบให้ครบหนึ่งรอบ ตั้งแต่การเลือกหมวดเกม ไปจนถึงหน้าข้อมูลของเกมที่สนใจ ก่อนจะเริ่มใช้งานด้วยเครดิตจริง
      </p>

      <p class="text-left text-base leading-relaxed">
        คำว่า ทดลองเล่น ที่หน้านี้พูดถึงจึงหมายถึง
        <strong class="text-[#fce675]">การเลือกสล็อต บาคาร่า บอล หวย หรือเกมที่ต้องการ พร้อมตรวจสอบรายละเอียดและโปรโมชั่นก่อนเริ่มใช้งาน</strong>
        ตามที่เว็บไซต์แนะนำไว้เอง ไม่ใช่การรับประกันผลของรอบใดรอบหนึ่ง เมื่อ Login แล้วสมาชิกจะเลือกหมวดเกม ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการได้ผ่านระบบเดียว ทั้งบนมือถือและคอมพิวเตอร์
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`หมวดเกมของ ${BRAND_NAME} ที่ไล่ดูได้ก่อนเริ่มเล่นจริง`} as="h2">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed">
        หลัง Login สามารถเลือกประเภทการเดิมพันได้จากบัญชีเดียว
        <strong class="text-[#fce675]">สลับประเภทเกมได้โดยไม่ต้องสมัครใหม่หลายครั้ง</strong>
        การเปิดเทียบกันก่อนจึงช่วยให้เห็นว่าหมวดไหนเหมาะกับรูปแบบที่ตั้งใจไว้ และควรเริ่มจากหมวดที่หน้าข้อมูลเกมอ่านจบได้เร็วที่สุด
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#d6a53a]">🎰</span>
          <span>
            <strong class="text-[#fce675]">สล็อต</strong> เป็นหมวดที่มีธีมและฟีเจอร์แตกต่างกันในแต่ละเกม จึงเหมาะกับการใช้ทำความคุ้นเคยกับการค้นหาเกมและตำแหน่งของข้อมูลเกมเป็นรายการแรก
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#d6a53a]">🃏</span>
          <span>
            <strong class="text-[#fce675]">บาคาร่าออนไลน์</strong> มีเงื่อนไขของแต่ละโต๊ะระบุไว้ในหน้าของโต๊ะนั้นเอง จึงควรเปิดอ่านรายละเอียดการเดิมพันก่อนเข้าร่วมทุกครั้ง ไม่ใช่เทียบเอาจากโต๊ะอื่น
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#d6a53a]">⚽</span>
          <span>
            <strong class="text-[#fce675]">บอล หรือตลาดเดิมพันฟุตบอล</strong> เปิดตามรายการที่ระบบมีให้ในช่วงเวลานั้น ควรดูรายการล่าสุดจากหน้าเกมแทนการอ้างจากรายการที่จำไว้จากครั้งก่อน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#d6a53a]">🎫</span>
          <span>
            <strong class="text-[#fce675]">หวยตามรายการที่ระบบเปิดให้บริการ</strong> อยู่ในบัญชีเดียวกับหมวดอื่น ช่วงไล่ดูระบบจึงเป็นจังหวะที่ดีในการจำว่าเมนูสลับหมวด เครดิต และประวัติรายการอยู่ตรงไหน
          </span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed">
        <strong class="text-[#fce675]">รายการเกมและผู้ให้บริการอาจมีการอัปเดตหรือเปลี่ยนแปลงตามช่วงเวลา</strong>
        หากเปลี่ยนไปเล่นเกมอื่นหรือหมวดอื่น ควรเปิดข้อมูลเกมอ่านซ้ำอีกครั้ง เพราะเงื่อนไขที่จำไว้จากเกมก่อนหน้าอาจไม่ใช่ชุดเดียวกับเกมที่กำลังจะเปิด
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/about-us"
          aria-label={`อ่านหน้าเกี่ยวกับเราของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#ebbb54]/60 bg-[#241705] px-8 py-3 font-bold text-[#fce675] transition-all hover:scale-105 hover:border-[#fce675] hover:bg-[#130b03] hover:text-[#f3f3f2]">
          อ่านเกี่ยวกับเรา
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="จุดที่ควรตรวจให้ครบก่อนเริ่มเล่นด้วยเครดิตจริง" as="h2">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed">
        การไล่ดูระบบมีประโยชน์ที่สุดเมื่อมองมันเหมือนการอ่านรายละเอียดของเกมนั้นให้จบก่อน
        <strong class="text-[#fce675]">เป้าหมายคือรู้เงื่อนไขและรายละเอียดการเดิมพันของเกมที่จะเล่นให้ครบก่อนที่เครดิตจริงจะเข้ามาเกี่ยวข้อง</strong>
        เรื่องด้านล่างคือสิ่งที่ควรเก็บข้อมูลไว้ระหว่างเปิดดู และควรตรวจซ้ำทุกครั้งที่เปลี่ยนไปเล่นเกมหรือหมวดอื่น
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#d6a53a]">📖</span>
          <span>
            <strong class="text-[#fce675]">รายละเอียดการเดิมพันของเกมนั้นโดยตรง</strong> เป็นสิ่งแรกที่ควรดู เพราะเงื่อนไขระบุไว้ในหน้าข้อมูลของเกมหรือของโต๊ะที่กำลังเปิดอยู่ ไม่ใช่สิ่งที่เทียบเอาจากเกมอื่นที่เคยเล่นมาก่อน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#d6a53a]">💸</span>
          <span>
            <strong class="text-[#fce675]">โปรโมชั่นที่บัญชีมีสิทธิ์รับและยอดที่เข้าเกณฑ์</strong> ทั้งคืนยอดเสีย โบนัส 0.3% และแนะนำเพื่อน โบนัส 0.8% ควรดูประเภทเกมที่ร่วมรายการ ยอดที่ใช้คำนวณ รอบตัดยอด และระยะเวลารับโบนัสจากบัญชีของตนเองก่อนกดรับ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#d6a53a]">🧾</span>
          <span>
