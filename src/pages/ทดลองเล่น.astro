---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";

import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login, /register)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อของ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริง
// ของ KINGDOM66 เท่านั้น
//
// รอบก่อน (UWIN33) บรีฟระบุหมวด "รูเล็ต" และ "ไฮโล" ไว้ ซึ่งบรีฟของ KINGDOM66
// ไม่ได้ระบุเลย — สองคำนั้นจึงถูกถอดออกทั้งหน้า และแทนด้วย "ไพ่" กับ "เกมไลฟ์สด
// จากผู้ให้บริการต่างประเทศ" ที่บรีฟรอบนี้ระบุจริง ห้าม find-and-replace ชื่อแบรนด์
// ทับของเดิม มันจะทำให้ KINGDOM66 อ้างหมวดเกมที่บรีฟไม่เคยระบุ
//
// บรีฟไม่ได้ระบุว่ามีโหมดเดโมที่ถอนไม่ได้ สิ่งที่บรีฟระบุคือ "ระบบจัดหมวดหมู่ให้
// ค้นหาได้ง่าย" "ตรวจสอบรายละเอียดเกม ค่ายที่ให้บริการ และรูปแบบเดิมพันก่อนเข้าเล่น
// ได้จากหน้าเดียว" และ "รองรับการใช้งานทั้งบนมือถือและคอมพิวเตอร์" — หน้านี้จึงเขียน
// บนฐานนั้น คือการไล่ดูหมวดเกมและรายละเอียดให้ครบก่อนเดิมพันด้วยเงินจริง ห้ามอ้าง
// กติกาของเครดิตทดลองหรือโหมดเล่นฟรีที่บรีฟไม่ได้พูดถึง
//
// ข้อเท็จจริงทุกบรรทัดมาจาก src/assets/content.txt เท่านั้น: บาคาร่า · ไพ่ · สล็อต ·
// หวย · บอล · เกมไลฟ์สดจากผู้ให้บริการต่างประเทศตามรายการที่เปิดให้บริการ ·
// รวมไว้ในระบบเดียว เลือกหมวดได้จากบัญชีเดียว · ระบบจัดหมวดหมู่ให้ค้นหาได้ง่าย ·
// ตรวจสอบรายละเอียดเกม ค่ายที่ให้บริการ และรูปแบบเดิมพันก่อนเข้าเล่นได้จากหน้าเดียว ·
// สิทธิ์เครดิตฟรีและโปรโมชั่นตามเงื่อนไขที่กำหนด · รองรับมือถือและคอมพิวเตอร์ ·
// โบนัสแนะนำเพื่อน 0.8% · โบนัสคืนยอดเสีย 0.3% · ตรวจสอบยอดที่เข้าเกณฑ์ รอบรับสิทธิ์
// และข้อกำหนดจากหน้าโปรโมชั่นก่อนกดรับ · สมัครเองได้ใน 3 ขั้นตอน ·
// LINE OFFICIAL 24 ชั่วโมง
// — ห้ามอ้างชื่อค่ายเกม ชื่อสตูดิโอ ชื่อเกมเฉพาะ เลขใบอนุญาต ปีที่ก่อตั้ง จำนวนสมาชิก
// ค่า RTP ขั้นต่ำการเดิมพัน ชื่อธนาคารเจาะจง "ฝากถอนไม่มีขั้นต่ำ" "ออโต้ 10 วินาที"
// หรือการันตีว่าจะชนะ
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: แกลเลอรีเดโม 12 การ์ด (gamedemo7..18.webp) ยังอยู่
// บนดิสก์แต่เป็นของแบรนด์อื่น (mtime 2026-08-04 ไม่ใช่ดรอปรอบนี้) — gamedemo7.webp
// มีโลโก้ "askmeslot" และ gamedemo15.webp มีโลโก้ "askmebet" ของเว็บเจ้าอื่น
// พิมพ์ทับอยู่ในรูป ส่วน gamedemo13.webp เป็นการ์ด "Sexy Slot" ภาพโป๊เปลือย
// ห้ามนำกลับมา import เด็ดขาด (ห้ามลบไฟล์ เป็นอินเวนทอรี) ลำพังการ import ก็ทำให้
// ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง
// slide1.png / slide2.png ของดรอปนี้เป็นของ index และ /promotion — ไม่ดึงมาใช้ซ้ำที่นี่
// banner1/banner1-mobile เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า และ
// banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กค้างของลูกค้าเจ้าอื่น ห้าม import
//
// Announcement รอบนี้หมุนจาก AnnouncementPremium มาเป็น AnnouncementCyber ทั้งเว็บ —
// default message ของไฟล์นั้นเป็นคอปปี้ของ KINGDOM66 แล้ว จึงเรียกแบบ bare เหมือน
// index.astro ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ KINGDOM66 (ทองราชสำนักบนดำ): พื้น #050403 · การ์ด #151109 ·
// การ์ดยก #241c13 · ทองแบรนด์ #e6bf4e · ทองสว่าง #f2d683 · ทองอ่อน #f5e196 ·
// ทองลึก #5c4113 · แพลทินัมครีม #efe6cf · เนื้อความ #ebe3d3 (BRAND_TEXT) ·
// เน้นใน strong #fdf6e0 — ชุดทอง-โครเมียมเย็นของ UWIN33 ถูกแทนครบทุกจุดแล้ว
// (ตารางแมป old→new ดูที่ .rebrand-spec.md §2 — ห้ามพิมพ์ฮิวเก่าซ้ำไว้ในไฟล์นี้
// เพราะสคริปต์แมปพาเลตต์จะไล่แทนค่าในคอมเมนต์ด้วย) รอบนี้ไม่มีฮิวเงินเย็นเลย
// ตัวหนังสือที่วางบนพื้นทองต้องเป็นสีเกือบดำ #1a1206 เสมอ ห้ามใช้ขาว
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลางที่ orchestrator รีธีมรอบนี้) — การ์ดตั้ง
// สีเนื้อความไว้ให้แล้ว ย้ำไว้บนย่อหน้าอีกชั้นเพื่อให้สีของ body copy อ่านออกจาก
// ตัวหน้าเอง และเน้นด้วย #fdf6e0 ในคำสำคัญ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 159
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "ทดลองเล่น KINGDOM66 ไล่ดูหมวดบาคาร่า ไพ่ สล็อต หวย บอล และเกมไลฟ์สด พร้อมตรวจสอบค่ายที่ให้บริการและรูปแบบเดิมพันจากบัญชีเดียวให้ครบก่อนเริ่มเดิมพันด้วยเงินจริง";

const pageTitle = "ทดลองเล่น KINGDOM66 ไล่ดูหมวดเกมและรายละเอียดก่อนเดิมพันจริง";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ebe3d3]">
        <strong class="text-[#fdf6e0]">KINGDOM66</strong> รวมเกมคาสิโนหลายรูปแบบไว้ในระบบเดียว ทั้งบาคาร่า ไพ่ สล็อต หวย บอล และเกมไลฟ์สดจากผู้ให้บริการต่างประเทศตามรายการที่เปิดให้บริการ หน้านี้จึงเปิดไว้ให้คนที่ยังไม่คุ้นกับระบบได้
        <strong class="text-[#fdf6e0]">ไล่ดูหมวดเกม ค่ายที่ให้บริการ และรูปแบบเดิมพันของแต่ละรายการให้ครบก่อนเดิมพันด้วยเงินจริง</strong>
        ตั้งแต่โครงของเมนูหน้าแรก ไปจนถึงข้อมูลที่ระบบแสดงไว้ในหน้ารวมเกม
      </p>

      <p class="text-left text-base leading-relaxed text-[#ebe3d3]">
        เพราะ<strong class="text-[#fdf6e0]">ระบบจัดหมวดหมู่ไว้ให้ค้นหาได้ง่าย และรองรับการใช้งานทั้งบนมือถือและคอมพิวเตอร์</strong>
        การเปิดดูให้ทั่วก่อนจึงช่วยให้เห็นว่าเกมแต่ละหมวดอยู่ตรงไหน สลับไปหมวดที่สนใจได้จากจุดใด และรู้ล่วงหน้าว่าต้องตรวจข้อมูลอะไรบ้างก่อนกดเข้าเล่นครั้งแรกจากบัญชีเดียว
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ไล่ดูหมวดเกมของ KINGDOM66 ให้ครบก่อนเลือกเกมแรก" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ebe3d3]">
        จุดที่ช่วยให้เริ่มต้นได้เร็วที่สุดคือ<strong class="text-[#fdf6e0]">ทุกหมวดเกมถูกรวมไว้ในบัญชีเดียว</strong>
        สมาชิกเลือกหมวดที่สนใจได้จากเมนูหน้าแรก ดูรายการที่เปิดให้บริการอยู่ แล้วเปิดรายละเอียดของเกมนั้นต่อได้จากหน้าเดียว ไม่ต้องไล่หาว่าเกมที่อยากเล่นอยู่ตรงไหน
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#ebe3d3]">
        <li class="flex gap-3">
          <span class="font-bold text-[#e6bf4e]">1.</span>
          <span><strong class="text-[#fdf6e0]">เปิดหน้าแรกของ KINGDOM66 ก่อน</strong> ระบบจัดหมวดหมู่ไว้ให้เลือกจากหน้าเดียว จึงเห็นภาพรวมของรายการที่เปิดให้เลือกได้ตั้งแต่หน้าแรก</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#e6bf4e]">2.</span>
          <span>
            <strong class="text-[#fdf6e0]">ไล่ดูหมวดหลักให้ครบ</strong> ทั้งบาคาร่า ไพ่ สล็อต หวย และบอล แต่ละหมวดมีรูปแบบเดิมพันและรายละเอียดของตัวเองตามที่ระบบแสดงไว้
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#e6bf4e]">3.</span>
          <span>
            <strong class="text-[#fdf6e0]">แวะดูหมวดคาสิโนไลฟ์สดด้วย</strong> เกมไลฟ์สดถ่ายทอดมาจากผู้ให้บริการต่างประเทศตามรายการที่เปิดให้บริการ รูปแบบการวางเดิมพันจึงต่างจากเกมในหมวดอื่น ควรเปิดดูไว้ก่อนสักรอบ
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#e6bf4e]">4.</span>
          <span>
            <strong class="text-[#fdf6e0]">ตรวจสอบรายละเอียดเกม ค่ายที่ให้บริการ และรูปแบบเดิมพันก่อนเข้าเล่น</strong> ข้อมูลชุดนี้ถูกแสดงไว้ให้ดูตั้งแต่ก่อนกดเข้าเกม อ่านให้จบก่อนตัดสินใจว่าจะเลือกรายการไหน
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#e6bf4e]">5.</span>
          <span>
            <strong class="text-[#fdf6e0]">ลองเปิดจากเครื่องที่จะใช้จริงอีกครั้ง</strong> ระบบรองรับทั้งมือถือและคอมพิวเตอร์จากบัญชีเดียว เปิดรายการเดียวกันเทียบกันดูก่อน แล้วเลือกอุปกรณ์ที่ใช้งานได้ถนัดกว่า
          </span>
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#ebe3d3]">
        <strong class="text-[#fdf6e0]">รายการที่เปิดให้บริการและค่ายที่รองรับในแต่ละหมวดเปลี่ยนแปลงได้ตามช่วงเวลา จึงควรตรวจสอบหมวดเกมและรายละเอียดที่เกี่ยวข้องจากหน้ารวมเกมทุกครั้งก่อนเข้าใช้งาน</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title="จุดที่ควรตรวจให้ครบก่อนเดิมพันด้วยเงินจริง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ebe3d3]">
        การไล่ดูระบบมีประโยชน์ที่สุดเมื่อมองมันเหมือนการอ่านคู่มือ ไม่ใช่การลุ้นรางวัล
        <strong class="text-[#fdf6e0]">เป้าหมายคือรู้จักระบบให้ครบก่อนที่เงินจริงจะเข้ามาเกี่ยวข้อง</strong>
        หกเรื่องด้านล่างคือสิ่งที่ควรเก็บข้อมูลไว้ระหว่างเปิดดู
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#ebe3d3]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f2d683]">🗂️</span>
          <span>
            <strong class="text-[#fdf6e0]">โครงของหมวดหมู่และตำแหน่งของแต่ละหมวด</strong> จำให้ได้ว่าหมวดบาคาร่า ไพ่ สล็อต หวย และบอลอยู่ตรงไหน และสลับระหว่างกันได้จากจุดใด จะได้ไม่ต้องค้นหาใหม่ทุกครั้งที่อยากเปลี่ยนเกม
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f2d683]">🃏</span>
          <span>
            <strong class="text-[#fdf6e0]">รายละเอียดเกมและรูปแบบเดิมพันของรายการที่สนใจ</strong> ระบบแสดงข้อมูลชุดนี้ไว้ก่อนเข้าเล่น เปิดอ่านเทียบกันหลายรายการดูก่อน จะได้เห็นว่ารูปแบบไหนตรงกับที่ตัวเองสนใจ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f2d683]">📡</span>
          <span>
            <strong class="text-[#fdf6e0]">ค่ายที่ให้บริการในหมวดไลฟ์สด</strong> เกมไลฟ์สดถ่ายทอดมาจากผู้ให้บริการต่างประเทศ รายการที่เปิดให้บริการจึงไม่เท่ากันทุกช่วงเวลา ควรเปิดตรวจสอบอีกครั้งก่อนเลือกเข้าเล่น
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f2d683]">🎁</span>
          <span>
            <strong class="text-[#fdf6e0]">เงื่อนไขของเครดิตฟรีและโปรโมชั่นที่กำลังเปิดรับสิทธิ์</strong> ทั้งโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% หน้าโปรโมชั่นแสดงยอดที่เข้าเกณฑ์ รอบรับสิทธิ์ และข้อกำหนดไว้ให้ตรวจสอบก่อนกดรับทุกครั้ง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f2d683]">💬</span>
          <span>
