---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";

import { pageGraph } from "../lib/schema";

// CASINO888 เป็นเว็บคาสิโนครบวงจร (บาคาร่า / สล็อต / หวย / บอล) ไม่ใช่เว็บสล็อตอย่างเดียว
// หน้านี้จึงหมายถึงการทำความรู้จักเกมแต่ละหมวดก่อนใช้เครดิตจริง — อ่านกติกา อัตราจ่าย
// และขั้นต่ำของการเดิมพัน ตามที่บรีฟระบุไว้
// แบรนด์เก่าเคยวางแกลเลอรี 12 การ์ด (gamedemo7..18.webp) ไว้ที่หน้านี้ ตอนนี้ไม่มีการ
// import แล้ว — อย่านำกลับมา เพราะลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/
// และ verify-build จะแดงถ้ามีรูปที่ไม่มีใคร render
//
// ทุกข้อความอ้างอิง src/assets/content.txt เท่านั้น ไม่มีการอ้างใบอนุญาตหรือการันตีผล
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ) หน้านี้ยาว 155
const pageDescription =
  "หน้าทดลองเล่นของ CASINO888 แนะนำวิธีทำความรู้จักเกมบาคาร่า สล็อต หวย และบอล ตรวจสอบกติกา อัตราจ่าย และขั้นต่ำของแต่ละเกม ก่อนเปลี่ยนมาเดิมพันด้วยเครดิตจริง";

const graph = pageGraph(Astro, {
  name: "ทดลองเล่น CASINO888 ทำความรู้จักเกมก่อนเดิมพันด้วยเครดิตจริง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title="ทดลองเล่น CASINO888 ลองเกมบาคาร่า สล็อต หวย บอล ก่อนเดิมพันจริง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่น CASINO888 ทำความรู้จักเกมก่อนเดิมพันด้วยเครดิตจริง" as="h1">
    <div>
      <p class="mb-6 text-left text-base leading-relaxed text-[#e9ddc4]">
        <strong class="text-[#e4c25a]">CASINO888</strong> รวมเกมเดิมพันออนไลน์หลายประเภทไว้ให้เลือกผ่านบัญชีเดียว ทั้งบาคาร่าและคาสิโนสด สล็อตออนไลน์ หวยออนไลน์หลายประเภท
        รวมถึงการเดิมพันฟุตบอลตามรายการที่เปิดให้บริการ รองรับการใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ หน้านี้จึงเปิดไว้ให้ผู้เริ่มต้นได้<strong class="text-[#e4c25a]"
            >ทำความรู้จักเกมแต่ละหมวด อ่านกติกา ตรวจสอบอัตราจ่าย และดูขั้นต่ำของการเดิมพัน</strong
          >
        ก่อนยืนยันรายการด้วยเครดิตของตัวเอง เพราะแต่ละหมวดและแต่ละค่ายกำหนดเงื่อนไขไว้ไม่เหมือนกัน
      </p>

      <p class="mb-2 text-left text-base leading-relaxed text-[#e9ddc4]">
        ขอให้เข้าใจตรงกันว่าการทดลองเล่นเป็นการทำความคุ้นเคยกับเกมและระบบเท่านั้น
        <strong class="text-[#e4c25a]">การเดิมพันไม่สามารถรับประกันผลกำไรหรือรางวัล และผลของรอบก่อนหน้าใช้ทำนายรอบถัดไปไม่ได้</strong>
        หากติดปัญหาระหว่างใช้งาน สามารถแจ้งแอดมิน CASINO888 ได้ตลอด 24 ชั่วโมง พร้อมเวลาและรายละเอียดของรายการ เพื่อให้เจ้าหน้าที่ตรวจสอบระบบหลังบ้านได้ตรงจุด
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="หมวดเกมของ CASINO888 ที่ควรลองทำความรู้จักก่อนเดิมพัน" as="h2">
    <div>
      <p class="mb-4 text-left text-base leading-relaxed text-[#e9ddc4]">
        CASINO888 จัดหมวดหมู่เกมเดิมพันไว้ให้ค้นหาได้ง่าย สิ่งที่ควรเปิดดูให้ครบก่อนเริ่มคือ
        <strong class="text-[#e4c25a]">กติกาของเกม อัตราจ่าย และขั้นต่ำของการเดิมพัน</strong>
        เพราะข้อมูลชุดนี้บอกว่ารายการนั้นคิดผลอย่างไรและต้องวางเดิมพันแบบไหนถึงเข้าเงื่อนไข แทนที่จะเลือกจากคำว่าแตกง่ายเพียงอย่างเดียว
      </p>

      <ul class="mb-4 flex flex-col gap-3 text-left text-base leading-relaxed text-[#e9ddc4]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e4c25a]">🃏</span>
          <span><strong class="text-[#e4c25a]">บาคาร่าและเกมคาสิโนสด</strong> เป็นรายการที่เปิดผลตามรอบ ควรดูอัตราจ่ายของแต่ละฝั่งและขั้นต่ำของโต๊ะที่เลือกก่อนยืนยันรายการ</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e4c25a]">🎰</span>
          <span><strong class="text-[#e4c25a]">สล็อตออนไลน์</strong> มีทั้งเกมรอบปกติและเกมที่มีฟีเจอร์พิเศษ ควรเปิดดูตารางอัตราจ่ายและช่วงเดิมพันที่เกมรองรับก่อนเริ่มเล่น</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e4c25a]">🔢</span>
          <span><strong class="text-[#e4c25a]">หวยออนไลน์</strong> มีหลายประเภทให้เลือก แต่ละประเภทใช้รอบออกผลและอัตราจ่ายต่างกัน จึงควรตรวจสอบรายละเอียดของรอบนั้นก่อนแทง</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e4c25a]">⚽</span>
          <span><strong class="text-[#e4c25a]">ฟุตบอล</strong> เปิดให้เดิมพันตามรายการที่ระบบเปิดให้บริการ ควรดูรูปแบบการเดิมพัน อัตราจ่าย และขั้นต่ำของบิลก่อนยืนยัน</span>
        </li>
      </ul>

      <p class="mb-2 text-left text-base leading-relaxed text-[#c9c9c9]">
        ส่วนเรื่อง<strong class="text-[#c9c9c9]">ยอดเดิมพันขั้นต่ำ</strong> บางเกมรองรับการเดิมพันเริ่มต้นประมาณ 1 บาท แต่ขั้นต่ำจริงขึ้นอยู่กับประเภทการเดิมพันและผู้ให้บริการแต่ละราย
        จึงควรตรวจสอบตัวเลขบนหน้าเกมก่อนยืนยันรายการทุกครั้ง
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ขั้นตอนเริ่มใช้งาน CASINO888 และลองเลือกเกมด้วยตัวเอง" as="h2">
    <div>
      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#e9ddc4]">
        <li class="flex gap-3"><span class="font-bold text-[#e4c25a]">1.</span> เปิดหน้าสมัคร CASINO888 และกรอกข้อมูลตามที่ระบบกำหนด ทำผ่านมือถือหรือคอมพิวเตอร์ได้โดยตรง</li>
        <li class="flex gap-3"><span class="font-bold text-[#e4c25a]">2.</span> Login เข้าบัญชี ฝากเครดิต และตรวจสอบโปรโมชั่นที่มีสิทธิ์รับ</li>
        <li class="flex gap-3"><span class="font-bold text-[#e4c25a]">3.</span> เลือกบาคาร่า สล็อต หวย หรือฟุตบอล ตรวจสอบขั้นต่ำและกติกาก่อนเดิมพัน</li>
        <li class="flex gap-3"><span class="font-bold text-[#e4c25a]">4.</span> เปิดดูอัตราจ่ายและรูปแบบการเดิมพันของรายการนั้น เพื่อให้เข้าใจว่าผลคิดจากอะไร</li>
        <li class="flex gap-3"><span class="font-bold text-[#e4c25a]">5.</span> กำหนดงบประมาณและขนาดเดิมพันที่รับได้ ก่อนเปลี่ยนมาเล่นด้วยเครดิตจริง</li>
      </ol>

      <p class="mt-4 mb-2 text-left text-base leading-relaxed text-[#e9ddc4]">
        ก่อนเริ่มเดิมพันจริงควรแบ่งงบออกเป็นหน่วยย่อยไว้ล่วงหน้า เช่น มีทุน 1,000 บาท ให้คิด 1 หน่วยเท่ากับ 10 บาท แล้ววางขนาดเดิมพันให้อยู่ในระดับที่รับความผันผวนได้
        วิธีนี้<strong class="text-[#e4c25a]">ไม่ได้ทำให้เกมจ่ายรางวัลมากขึ้น แต่ช่วยให้รู้ล่วงหน้าว่าแต่ละรอบใช้เงินได้เท่าไร</strong>
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="สิ่งที่ควรตรวจสอบก่อนเปลี่ยนมาเดิมพันด้วยเครดิตจริง" as="h2">
    <div>
      <ul class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#e9ddc4]">
        <li class="flex gap-3">
          <span class="text-[#e4c25a]" aria-hidden="true">•</span> หน้านี้อธิบายการใช้งานและการลองเลือกเกมเท่านั้น การเดิมพันจริงต้องสมัครสมาชิกและฝากเครดิตผ่านช่องทางที่เปิดให้บริการก่อน
        </li>
        <li class="flex gap-3">
          <span class="text-[#e4c25a]" aria-hidden="true">•</span> เปิดอ่านกติกา อัตราจ่าย และขั้นต่ำของการเดิมพันให้ครบ เพราะแต่ละหมวดและแต่ละค่ายไม่ได้ใช้เงื่อนไขเดียวกัน
        </li>
        <li class="flex gap-3">
          <span class="text-[#e4c25a]" aria-hidden="true">•</span> หากต้องการเริ่มเดิมพันเพียง 1 บาท ให้ตรวจสอบขั้นต่ำจริงของเกมหรือประเภทการเดิมพันนั้นก่อนทำรายการทุกครั้ง
        </li>
        <li class="flex gap-3">
          <span class="text-[#e4c25a]" aria-hidden="true">•</span> ตั้งจุดหยุดเมื่อเสียและจุดที่จะพักเมื่อได้กำไรไว้ตั้งแต่ก่อนเริ่ม แล้วหยุดตามแผน ไม่เพิ่มเดิมพันเพื่อไล่เอาเงินคืน
        </li>
        <li class="flex gap-3">
          <span class="text-[#e4c25a]" aria-hidden="true">•</span> อ่านเงื่อนไขโปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ก่อนกดรับทุกครั้ง และไม่เปิดเผยรหัสผ่านหรือ OTP ให้ผู้อื่น
        </li>
        <li class="flex gap-3">
          <span class="text-[#e4c25a]" aria-hidden="true">•</span> เรื่องรอบรับโบนัสและยอดที่ใช้คำนวณ ให้ยึดเงื่อนไขล่าสุดที่แสดงในหน้าโปรโมชั่นเป็นหลัก เพราะแต่ละรายการกำหนดไว้ไม่เท่ากัน
        </li>
      </ul>

      <p class="mt-4 mb-6 text-left text-base leading-relaxed text-[#e9ddc4]">
        หากพบปัญหาเรื่องการสมัคร Login ไม่ได้ ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง โปรโมชั่นไม่แสดง หรือเข้าเกมไม่ได้ แจ้งแอดมิน CASINO888 พร้อมเวลา จำนวนเงิน และรายละเอียดของรายการได้ตลอด 24 ชั่วโมง
        และหากเป็นเรื่องธุรกรรมควรเก็บหลักฐานรายการไว้จนกว่าการตรวจสอบจะเสร็จสิ้น โดย
        <strong class="text-[#e4c25a]">การเดิมพันมีความเสี่ยง ควรกำหนดงบประมาณให้เหมาะสมทุกครั้ง</strong>
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก CASINO888"
          class="flex items-center justify-center rounded-lg border border-[#e4c25a]/70 bg-gradient-to-r from-[#fdf49c] via-[#e4c25a] to-[#b28a2a] px-8 py-3 font-black text-[#050403] shadow-[0_0_15px_rgba(228,194,90,0.4)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ CASINO888"
          class="flex items-center justify-center rounded-lg border border-[#e4c25a]/60 bg-transparent px-8 py-3 font-bold text-[#e4c25a] transition-all hover:scale-105 hover:border-[#fdf49c] hover:bg-[#17120a]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>

  <Navfoot />
</MainLayout>
