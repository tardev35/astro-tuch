---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";
import popularGamesImage from "../assets/gamedemo8.webp";
import newGamesImage from "../assets/gamedemo16.webp";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion,
// /login, /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์
// หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ (src/assets/content.txt) ไม่มี
// ส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่จากข้อเท็จจริงและคลังคำของบรีฟรอบนี้
// เท่านั้น (.claude/brand-spec-pakyok168.md §5)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
//   h1  ทดลองเล่น <แบรนด์> โหมดทดลองเล่นฟรี ศึกษากติกาเกมก่อนเดิมพันจริง
//   h2  โหมดทดลองเล่นฟรีของเกมสล็อตช่วยอะไรได้บ้าง
//   h2  ไล่ดูรูปแบบเกมสล็อตที่เปิดให้ทดลองเล่นฟรี
//   h2  สิ่งที่ควรตรวจสอบก่อนเปลี่ยนจากโหมดทดลองเล่นไปเดิมพันจริง
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// หน้านี้ลิงก์จาก navbar (ทดลองเล่น) จึงเปิดใช้งานอยู่
//
// 🚨 แกนของดรอปนี้ (2026-10-22) คือ **เว็บสล็อตออนไลน์** ที่นำเสนอเกมสล็อตจาก
// ค่ายต่าง ๆ — เกมแนวคลาสสิก เกมที่มีฟีเจอร์โบนัส และเกมที่ใช้สัญลักษณ์พิเศษ
// ในการกำหนดผลรางวัล พร้อม **โหมดทดลองเล่นฟรี** · คืนยอดเสีย 0.3% ·
// แนะนำเพื่อน 0.8% · สมัคร 3 ขั้นตอน · แอดมิน 24ชม.
// ⚠️⚠️ **ต่างจากรอบก่อน (สบาย168) ตรงที่บรีฟรอบนี้ระบุ "โหมดทดลองเล่นฟรี" ไว้
// ตรงๆ** (content.txt บรรทัด 6 และคำถามข้อ 1) หน้านี้จึงพูดถึงโหมดทดลองเล่นได้
// จริง แต่ต้องส่งออกข้อกำกับของบรีฟครบทุกประโยค ดูรายการด้านล่าง
// ⚠️⚠️ คำขายของของแบรนด์ขาออก (สบาย168) และของรอบก่อนหน้านั้น (เว็บพนัน
// ครบวงจร/ลอตเตอรี) **ห้ามหลงเหลือ** — รายการคำต้องห้ามเต็มอยู่ใน brand-spec §5
// ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์
// ของไฟล์นี้เอง · `ไม่ผ่านม้า` กับ `บัญชีม้า` เป็นคำของบรีฟรอบนี้เอง ใช้ได้
//
// ⚠️⚠️ **สองหน้าหมวดลอตเตอรียังจอดอยู่ใน src/pages-disabled/** → ลิงก์ไปสอง route
// นั้นจะทำให้ build แดง ห้ามเขียนกลับมา
// route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ทดลองเล่น · /about-us · /contact-us · /terms · /privacy · /line
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกม ชื่อธนาคาร ชื่อผู้ให้บริการ ใบอนุญาต
// ปีก่อตั้ง จำนวนสมาชิก ค่า RTP หรือยอดฝากขั้นต่ำ แม้แต่รายการเดียว** จึงห้าม
// เขียนลงหน้าเว็บ · ตัวเลขที่ขึ้นหน้าได้มีแค่ของบรีฟเอง:
// **0.3% · 0.8% · 24ชม. · 3 ขั้นตอน · 100%**
//
// 🚨 **ข้อกำกับของบรีฟที่ต้อง ship ครบบนหน้านี้** (ไม่ใช่ filler ให้ตัดทิ้ง):
// 1) ควรตรวจสอบว่ามีโหมดทดลองเล่นฟรีให้ใช้งานหรือไม่ **เนื่องจากบางเกมอาจไม่มี
//    โหมดดังกล่าว**
// 2) **ผลจากการทดลองเล่นไม่ได้บ่งบอกถึงผลลัพธ์เมื่อเดิมพันจริง**
// 3) ควรตรวจสอบสถานะลิขสิทธิ์เกมจากข้อมูลทางการของค่ายผู้พัฒนา
// 4) เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือรับประกัน
//    ผลกำไรในอนาคต · แม้ระบุว่ากดรับได้ไม่จำกัด แต่ควรตรวจสอบจำนวนครั้งที่รับ
//    สิทธิ์ได้จริงจากประกาศล่าสุด
// 5) ไม่เปิดเผยรหัสผ่านหรือรหัส OTP · ควรตรวจสอบเวลาการให้บริการจริงจากประกาศ
//    ล่าสุดอีกครั้ง
// ⚠️ บรีฟไม่ได้การันตีผลลัพธ์ใดๆ — คอปปี้หน้านี้จึงไม่สัญญากำไรและไม่สัญญาว่า
// ถอนได้ชัวร์
//
// 🚨 **รูปในหน้านี้ใช้ได้แค่ gamedemo8 กับ gamedemo16 เท่านั้น** — เป็นอาร์ตสต็อก
// กลางของเทมเพลต ไม่ใช่อาร์ตเวิร์กของแบรนด์ไหน จึงอยู่ต่อข้ามรอบได้ แต่ alt ต้อง
// บรรยายภาพจริง และห้ามเอ่ยชื่อแบรนด์ใดทั้งของรอบนี้และรอบก่อน
// ส่วน gamedemo7/9/10/11/12/14/15/17/18 มีโลโก้หรือชื่อของผู้ให้บริการ/ค่ายเกม
// เจ้าอื่นพิมพ์ทับอยู่กลางรูป และ gamedemo13 เป็นภาพล่อแหลม — **ห้ามนำกลับมาใช้**
// เพราะเท่ากับอ้างชื่อค่ายเกมที่บรีฟรอบนี้ไม่ได้เอ่ย (ขัด brand-spec §5 โดยตรง)
// ไฟล์ยังอยู่บนดิสก์ ห้ามลบ เป็นอินเวนทอรี
// gamedemo8 ("POPULAR GAME" 600x379) กับ gamedemo16 ("New Game" 650x411) ไม่มีชื่อ
// แบรนด์ใดปรากฏ ความกว้างที่วาดจริงสูงสุด ~600px ต่อใบ (กริดสองคอลัมน์ในการ์ด)
// จึงไม่ขยายเกินต้นฉบับ
// ⚠️ รูปอื่นทั้งหมดห้ามอ้างจากหน้านี้: banner2/banner3 เป็นอาร์ตเวิร์กของแบรนด์
// คนละราย · slide1/slide2 ถูกตรึงไว้กับ index กับ /promotion · slide3/slide4 เป็น
// โปสเตอร์ของอีกแบรนด์ · banner1 / banner1-mobile / og.png เป็นของ glob ที่
// MainLayout ปักไว้ (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build
// จะแดงถ้าไม่มีหน้าไหน render)
//
// 🚨 พาเลตรอบนี้ (brand-spec §2) **กลับมาเป็นธีมมืด** หลังรอบก่อนเป็นฟ้าพาสเทล
// สว่าง bg.json ของดรอปนี้คือ {"mode":"color","color":"#291d0f"} = น้ำตาลกาแฟเข้ม
// **ห้าม "แก้" กลับไปเป็นพื้นสว่างเพราะรอบก่อนเป็นแบบนั้น**
// ค่าที่ใช้ได้ในไฟล์นี้: ทองสว่าง #fded41 (<strong> + ตัวอักษรบนพื้นเข้ม 11.7:1
// บนการ์ด — สีไฮไลต์ของเนื้อความ) · ทองแกน #eeae12 (ขอบ · ออรา · marker ·
// stop กลางของปุ่มหลัก 7.2:1) · ทองลึก #9f600d (**2.8:1 — พื้นถม/ขอบเท่านั้น
// ห้ามถือตัวอักษร**) · โครมกลาง #2f1e0f และอินเซ็ต #1f1308 (พื้นผิว) ·
// หมึกบนพื้นถมทอง #1f0f04 (9.5:1 บน #eeae12 · 15.4:1 บน #fded41)
// หมึกเนื้อความคือ #f4ead6 (= BRAND_TEXT) ซึ่ง **ไม่ประกาศในไฟล์นี้** การ์ด
// ContentBox ตั้งไว้ให้แล้วและย่อหน้าสืบทอดลงมา
// 🚨 **ห้ามใช้ตัวอักษรขาวบนพื้นถมทอง** ปุ่มหลักใช้หมึก #1f0f04 เสมอ
// ออราที่อนุญาต: rgba(238,174,18,α) · rgba(253,237,65,α) · rgba(224,224,223,α) ·
// rgba(31,15,4,α) · rgba(0,0,0,α)
// ⚠️ รอบนี้ไม่มีฟ้า/น้ำเงิน (สีนำของรอบก่อน) ไม่มีแดง ไม่มีชมพู ไม่มีม่วง
// ไม่มีส้ม ไม่มีเขียว · ปุ่ม LINE อยู่บน /about-us กับ /contact-us ไม่ใช่หน้านี้
// ⚠️ **ทองผ่านรีโปนี้มาแล้วเกือบทุกเจ้า** การเจอทองในไฟล์จึงไม่พิสูจน์อะไร —
// ห้ามเทียบด้วยวงศ์สี ต้องเทียบทีละค่ากับตาราง brand-spec §2
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง และไม่ใส่ mx-auto / max-w-* บน <p>
// เพราะการ์ดคุมความกว้างเองแล้ว — ที่ประกาศสีได้มีแค่ปุ่ม ชิปไอคอน marker ของ
// ลำดับเลข ขอบรูป และ <strong> · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง"
// ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัด
// ในแท็กและคำจะขาดครึ่ง และห้ามวาง <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังในข้อความของ prop และต้องไม่ใช่สัญลักษณ์ของอาร์ตเวิร์กแบรนด์เก่า
// (รายการที่ห้ามอยู่ใน brand-spec §1)
//
// Announcement รอบนี้หมุนมาเป็น AnnouncementPremium ทั้งเว็บ (brand-spec §3 —
// รอบก่อนใช้ Announcement6 จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์
// นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว จึงเรียกแบบ bare **ห้ามส่ง prop message**
// มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 154 อักขระ (ชื่อแบรนด์รอบนี้ 8 ตัวอักษร) เป็นประโยคเดียวที่บอกว่า
// หน้านี้มีไว้ทำอะไร แล้วหยุด
// (Google ตัดราว 155 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `ทดลองเล่น ${BRAND_NAME} รวมวิธีตรวจสอบว่าเกมสล็อตใดมีโหมดทดลองเล่นฟรี เพื่อศึกษากติกาและฟีเจอร์โบนัสโดยไม่ต้องใช้เงินจริง พร้อมสิ่งที่ควรตรวจสอบก่อนเดิมพันจริง`;

const pageTitle = `ทดลองเล่น ${BRAND_NAME} โหมดทดลองเล่นฟรี ศึกษากติกาเกมก่อนเดิมพันจริง`;

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#fded41]">{BRAND_NAME} นำเสนอข้อมูลเกมสล็อตจากค่ายต่าง ๆ พร้อมระบบทดลองเล่นสำหรับผู้ที่ต้องการศึกษารูปแบบเกมก่อนใช้งานจริง</strong>
        หน้านี้รวบรวมไว้ว่าโหมดทดลองเล่นฟรีใช้ทำอะไรได้บ้าง ควรเปิดดูอะไรก่อน และมีจุดใดที่ต้องตรวจสอบเพิ่มเติมก่อนเปลี่ยนไปเดิมพันจริง
      </p>

      <p>
        สำหรับผู้ที่ต้องการศึกษารูปแบบเกม
        <strong class="text-[#fded41]">สามารถตรวจสอบว่าเกมที่สนใจมีโหมดทดลองเล่นฟรีให้ใช้งานหรือไม่ เนื่องจากบางเกมอาจไม่มีโหมดดังกล่าว</strong>
        ซึ่งโหมดนี้ช่วยให้เข้าใจกติกาเกมและการทำงานของฟีเจอร์ต่าง ๆ โดยไม่ต้องใช้เงินจริง จึงเหมาะกับการทำความคุ้นเคยกับเกมก่อนตัดสินใจ
      </p>

      <p>
        <strong class="text-[#fded41]">ทั้งนี้ ผลจากการทดลองเล่นไม่ได้บ่งบอกถึงผลลัพธ์เมื่อเดิมพันจริง</strong>
        และควรตรวจสอบสถานะลิขสิทธิ์เกมจากข้อมูลทางการของค่ายผู้พัฒนา เนื้อหาในหน้านี้เขียนไว้ประกอบการใช้งานเท่านั้น ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้บริการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="โหมดทดลองเล่นฟรีของเกมสล็อตช่วยอะไรได้บ้าง" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        โหมดทดลองเล่นฟรีเปิดให้หมุนเกมได้โดยไม่ต้องใช้เงินจริง
        <strong class="text-[#fded41]">ประโยชน์ของมันคือทำให้เห็นว่ากติกาเกมวางไว้อย่างไร และฟีเจอร์แต่ละตัวทำงานเมื่อไร</strong>
        ก่อนที่จะต้องตัดสินใจด้วยเงินของตัวเอง รายการด้านล่างคือสิ่งที่ควรเปิดดูทีละอย่างระหว่างอยู่ในโหมดนี้
      </p>

      <ul class="flex flex-col gap-4" aria-label="สิ่งที่ควรดูระหว่างอยู่ในโหมดทดลองเล่นฟรี">
        <li class="flex gap-3">
