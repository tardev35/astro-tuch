---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";
import { itemList, pageGraph, schemaCtx } from "../lib/schema";
import image1 from "../assets/gamedemo7.webp";
import image2 from "../assets/gamedemo8.webp";
import image3 from "../assets/gamedemo9.webp";
import image4 from "../assets/gamedemo10.webp";
import image5 from "../assets/gamedemo11.webp";
import image6 from "../assets/gamedemo12.webp";
import image7 from "../assets/gamedemo13.webp";
import image8 from "../assets/gamedemo14.webp";
import image9 from "../assets/gamedemo15.webp";
import image10 from "../assets/gamedemo16.webp";
import image11 from "../assets/gamedemo17.webp";
import image12 from "../assets/gamedemo18.webp";

// One list, two consumers: the gallery below and the ItemList in the JSON-LD.
// They used to be two hand-kept arrays that had to stay in the same order, and
// the name shown to a reader could drift from the name handed to a crawler.
// The thumbnails are generic stock demo art shared across brands — the alt text
// describes the picture, never its position in the grid.
const demoGames = [
  { name: "AskmeSlot", src: image1, alt: "แบนเนอร์ค่ายเกม askmeslot โลโก้โพดำสีเหลือง ตัวการ์ตูนเด็กชายสวมหมวกแดงกางแขน ฉากหลังเป็นถนนเมืองยุโรปและกังหันลม" },
  { name: "Popular Game", src: image2, alt: "แบนเนอร์ Popular Game ตัวอักษรสีทอง ตัวการ์ตูนกระต่ายกับแมวสวมแว่นกันแดด หีบสมบัติ ชิปและเหรียญทองกระจายรอบภาพ" },
  { name: "SlotXO", src: image3, alt: "แบนเนอร์ค่ายเกม SlotXO โลโก้รูปตู้สล็อตพร้อมเหรียญ ฉากหลังเป็นนักรบโรมันสวมชุดเกราะยืนหน้าโคลอสเซียม" },
  { name: "Skywind Group", src: image4, alt: "แบนเนอร์ค่ายเกม Skywind Group โลโก้วงกลมสี่สี ฉากหลังเป็นแมวกวักญี่ปุ่นสีขาว ถุงทอง และดอกซากุระ" },
  { name: "PG Soft", src: image5, alt: "แบนเนอร์ค่ายเกม PG Pocket Games Soft โลโก้ตัวอักษรพิกเซลหลากสี ฉากหลังเป็นหญิงสาวสวมเครื่องประดับทองและหมวกขนนก" },
  { name: "SBOBET", src: image6, alt: "แบนเนอร์ค่ายเกม SBOBET โลโก้สีขาวบนพื้นดำ ฉากหลังเป็นตัวการ์ตูนหญิงสาวผมบลอนด์ชุดสีชมพูถืออมยิ้ม" },
  { name: "Sexy Slot", src: image7, alt: "แบนเนอร์เกม Sexy Slot ตัวอักษรสีชมพูม่วง ฉากหลังเป็นตัวการ์ตูนหญิงสาวชุดสีน้ำเงินนั่งอยู่ในกรอบวงกลมพร้อมรูปหัวใจ" },
  { name: "JILI", src: image8, alt: "แบนเนอร์ค่ายเกม JILI ตัวอักษรสีทอง ฉากหลังเป็นตัวการ์ตูนนางเงือกผมสีแดงถือหอยสังข์อยู่ใต้ท้องทะเล" },
  { name: "Ask Me Bet", src: image9, alt: "แบนเนอร์ค่ายเกม ask me bet โลโก้สีเขียวเหลือง ฉากหลังเป็นหัวสิงโตเชิดสีแดงทองและโคมไฟจีน" },
  { name: "New Game", src: image10, alt: "แบนเนอร์ New Game ตัวอักษรสีขาวสามมิติ ตัวการ์ตูนฟักทองสวมหมวกและโครงกระดูกยืนสองข้าง พร้อมอัญมณีและชิปหลากสี" },
  { name: "JOKER", src: image11, alt: "แบนเนอร์ค่ายเกม JOKER ตัวอักษรสีขาวทอง ฉากหลังเป็นนักรบโรมันสวมหมวกเกราะยืนคู่กับสิงโตในสนามประลอง" },
  { name: "AFB Gaming", src: image12, alt: "แบนเนอร์ค่ายเกม AFB Gaming ตัวอักษรสีทอง ฉากหลังเป็นเทพเจ้าเคราขาวสวมมงกุฎใบไม้ยืนอยู่หน้าวิหารกรีก" },
];

// The URL each entry resolves to is schema.ts's problem, not this file's — an
// older version pasted a hand-built page URL onto all 12 and got the trailing
// slash and the Thai encoding wrong on every one of them.
const gameList = demoGames.map((game) => ({ name: game.name, imagePath: game.src.src }));

// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char).
const pageDescription = "ทดลองเล่นเกมคาสิโน 12PLAY เปิดหน้าเกมจากค่ายชั้นนำ ทั้งบาคาร่า รูเล็ต เสือมังกร แบล็กแจ็ก สล็อต ลองระบบบนมือถือและคอมพิวเตอร์ก่อนสมัครสมาชิกและฝากเครดิตเล่นจริง";

const ctx = schemaCtx(Astro);
const graph = pageGraph(Astro, {
  type: "CollectionPage",
  name: "ทดลองเล่นเกมคาสิโน 12PLAY ลองระบบก่อนสมัครสมาชิก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
  extra: [
    itemList(ctx, {
      name: "รายการค่ายเกมคาสิโนที่เปิดให้ทดลองเล่นบน 12PLAY",
      alternateName: "12PLAY โหมดทดลองเล่นบาคาร่า รูเล็ต เสือมังกร แบล็กแจ็ก และสล็อตจากค่ายชั้นนำ ก่อนสมัครสมาชิกและเดิมพันด้วยเครดิตจริง",
      itemType: "Game",
      items: gameList,
    }),
  ],
});
---

<MainLayout title="ทดลองเล่น 12PLAY ลองระบบเกมคาสิโนและสล็อตก่อนสมัคร" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่นเกมคาสิโน 12PLAY ลองระบบก่อนสมัครสมาชิก" as="h1">
    <p>
      12PLAY เปิดให้ลองเปิดหน้าเกมคาสิโนออนไลน์จากค่ายชั้นนำได้ทั้งบนมือถือ แท็บเล็ต และคอมพิวเตอร์ ทั้งบาคาร่า รูเล็ต เสือมังกร แบล็กแจ็ก สล็อต และเกมเดิมพันยอดนิยมอื่น ๆ
      ภายในบัญชีเดียว เพื่อดูหน้าตาเกม อัตราจ่าย และความลื่นไหลของระบบก่อนตัดสินใจสมัครสมาชิกและฝากเครดิตเดิมพันด้วยเงินจริง สมาชิกที่เปิดบัญชีแล้วยังเข้าร่วมกิจกรรมแนะนำเพื่อน
      เพื่อรับโบนัสตามเงื่อนไขของแต่ละโปรโมชั่นได้ และมีแอดมิน 12PLAY ดูแลตลอด 24 ชั่วโมง ตั้งแต่ขั้นตอนสมัครสมาชิกไปจนถึงการใช้งานภายในระบบ
    </p>
  </ContentBox>

  <ContentBox title="วิธีเข้าทดลองเล่นเกมคาสิโนกับ 12PLAY" as="h2">
    <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#e0d7d8]">
      <li class="flex gap-3"><span class="font-bold text-[#ff5a63]">1.</span> สมัครสมาชิก 12PLAY และกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน</li>
      <li class="flex gap-3"><span class="font-bold text-[#ff5a63]">2.</span> เลือกหมวดหมู่และค่ายเกมที่ต้องการจากรายการด้านล่าง</li>
      <li class="flex gap-3"><span class="font-bold text-[#ff5a63]">3.</span> กดปุ่ม "เล่นเลย" เพื่อเปิดหน้าเกมและเริ่มทดลองเล่นทันที</li>
    </ol>
  </ContentBox>

  <ContentBox title="ค่ายเกมคาสิโนและสล็อตที่เปิดให้ทดลองเล่น" as="h2">
    <div class="grid grid-cols-2 gap-5 sm:grid-cols-2 md:grid-cols-4">
      {
        demoGames.map((game) => (
          <div class="group/game relative mx-auto w-full max-w-[400px] overflow-hidden rounded-xl">
            <Picture
              src={game.src}
              alt={game.alt}
              loading="lazy"
              fetchpriority="low"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 100vw, 25vw"
              class="block h-auto w-full object-cover shadow-[0_10px_30px_rgba(224,16,32,0.18)] transition-transform duration-300 group-hover/game:scale-105"
              decoding="async"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
            <a
              href="/register"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`สมัครสมาชิกเพื่อเล่น ${game.name} ที่ 12PLAY`}
              class="absolute inset-0 flex items-center justify-center bg-[#0a0102]/80 opacity-0 transition-opacity duration-300 group-hover/game:opacity-100 focus-visible:opacity-100">
              <span class="rounded-full border border-[#8a0710]/70 bg-gradient-to-r from-[#f4eff0] via-[#ff5a63] to-[#e01020] px-6 py-2 font-bold text-[#1a0304] shadow-[0_10px_30px_rgba(244,239,240,0.30)] transition-transform hover:scale-110">
                เล่นเลย
              </span>
            </a>
          </div>
        ))
      }
    </div>
  </ContentBox>

  <ContentBox title="ศึกษากติกาและกำหนดงบประมาณก่อนเดิมพันด้วยเครดิตจริง" as="h2">
    <ul class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#e0d7d8]">
      <li class="flex gap-3"><span class="text-[#ff5a63]" aria-hidden="true">•</span> โหมดทดลองใช้เครดิตทดลอง ไม่ใช่เงินจริง และถอนไม่ได้</li>
      <li class="flex gap-3">
        <span class="text-[#ff5a63]" aria-hidden="true">•</span> การพนันมีความเสี่ยงและไม่มีระบบหรือเทคนิคใดรับประกันผลกำไร ควรอ่านกติกา อัตราจ่าย และกำหนดงบประมาณของตัวเองให้ชัดเจนก่อนเดิมพันทุกครั้ง
      </li>
      <li class="flex gap-3">
        <span class="text-[#ff5a63]" aria-hidden="true">•</span> โบนัสค่าแนะนำเพื่อนและโปรโมชั่นอื่นมีเงื่อนไขยอดเดิมพันและรอบการรับของตัวเอง ควรตรวจสอบยอดคำนวณและเงื่อนไขการถอนก่อนกดรับสิทธิ์ทุกครั้ง
      </li>
      <li class="flex gap-3">
        <span class="text-[#ff5a63]" aria-hidden="true">•</span> ฝากถอนอัตโนมัติผ่านช่องทางธนาคารที่เว็บไซต์เปิดให้บริการเท่านั้น ตรวจสอบชื่อบัญชีและรายละเอียดให้ถูกต้องก่อนยืนยันรายการ
      </li>
      <li class="flex gap-3"><span class="text-[#ff5a63]" aria-hidden="true">•</span> เข้าใช้งานผ่านทางเข้าจริงของ 12PLAY ที่เชื่อมต่อ HTTPS เท่านั้น และติดต่อแอดมินได้ตลอด 24 ชั่วโมงเมื่อพบปัญหา</li>
    </ul>
  </ContentBox>

  <Navfoot />
</MainLayout>
