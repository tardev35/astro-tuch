---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import { BRAND_NAME } from "../lib/brandProfile";
import { pageGraph } from "../lib/schema";

// ยาว 150–160 ตัวอักษรตามเกทของ verify-build ส่วนที่ไม่ใช่ชื่อแบรนด์ยาว 147 ตัว
// จึงรับชื่อแบรนด์ได้ตั้งแต่ 3 ถึง 13 ตัวอักษร — ช่วงเดียวกับ privacy.astro
//
// KINDEE365 ยาว 9 ตัว รวมแล้วได้ 156 ตัว ผ่านเกท ถ้ารีแบรนด์ครั้งหน้าใช้ชื่อยาวกว่า
// 13 ตัวอักษร ต้องตัดข้อความส่วนที่ไม่ใช่ชื่อแบรนด์ให้สั้นลงด้วย ไม่ใช่ปล่อยผ่าน
// เพราะไฟล์นี้เป็นหน้าถาวรที่ไม่มีใครเปิดอ่านตอนรีแบรนด์
const pageDescription = `เงื่อนไขและข้อตกลงการใช้งานเว็บไซต์ ${BRAND_NAME} ครอบคลุมขอบเขตของข้อมูล การจำกัดอายุผู้ใช้ ลิงก์ไปยังผู้ให้บริการภายนอก ข้อจำกัดความรับผิด และการแก้ไขเงื่อนไข`;

const graph = pageGraph(Astro, {
  name: `เงื่อนไขและข้อตกลง ${BRAND_NAME}`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เงื่อนไขและข้อตกลง", path: "/terms" },
  ],
});

const sections = [
  {
    h: "ขอบเขตของเว็บไซต์นี้",
    p: [
      `${BRAND_NAME} บนหน้านี้ทำหน้าที่เป็นเว็บไซต์ให้ข้อมูลและรีวิวเท่านั้น เนื้อหาทั้งหมดจัดทำขึ้นเพื่ออธิบายรูปแบบการใช้งาน ตลาดเดิมพัน ขั้นตอนสมัครสมาชิก และจุดที่ควรตรวจสอบก่อนตัดสินใจ`,
      "เว็บไซต์นี้ไม่ได้รับเดิมพัน ไม่ได้เก็บรักษายอดเงิน และไม่ได้ดำเนินการฝากหรือถอนใด ๆ ด้วยตัวเอง เมื่อกดปุ่มสมัครสมาชิกหรือเข้าสู่ระบบ ระบบจะพาไปยังเว็บไซต์ของผู้ให้บริการภายนอก ซึ่งมีเงื่อนไข นโยบาย และผู้รับผิดชอบเป็นของตนเองแยกจากหน้านี้",
    ],
  },
  {
    h: "ผู้มีสิทธิ์ใช้งาน",
    p: [
      "ผู้เข้าชมควรมีอายุครบ 20 ปีบริบูรณ์ขึ้นไป และควรตรวจสอบว่ากฎหมายในพื้นที่ที่ตนอาศัยอยู่อนุญาตให้เข้าถึงเนื้อหาลักษณะนี้หรือไม่ก่อนใช้งานต่อ",
      "หากท่านอายุไม่ถึงเกณฑ์ หรืออยู่ในเขตอำนาจที่ไม่อนุญาต ขอให้ปิดหน้านี้และไม่ใช้งานต่อ",
    ],
  },
  {
    h: "ความถูกต้องของข้อมูล",
    p: [
      "ข้อมูลบนหน้านี้จัดทำจากสิ่งที่ปรากฏบนเว็บไซต์ต้นทางในช่วงเวลาที่เขียน ซึ่งอาจเปลี่ยนแปลงได้ตลอดเวลาโดยไม่แจ้งล่วงหน้า ทั้งรายละเอียดโปรโมชั่น เงื่อนไขการรับสิทธิ์ ตลาดเดิมพันที่เปิด และช่องทางติดต่อ",
      "ก่อนตัดสินใจใด ๆ ควรอ่านเงื่อนไขฉบับจริงจากผู้ให้บริการโดยตรงเสมอ ข้อความบนหน้านี้ใช้ประกอบการพิจารณาเท่านั้น และไม่ถือเป็นคำแนะนำทางการเงิน กฎหมาย หรือการลงทุน",
    ],
  },
  {
    h: "ข้อจำกัดความรับผิด",
    p: [
      "เว็บไซต์นี้ไม่รับประกันผลตอบแทน ไม่รับประกันว่าจะชนะ และไม่รับผิดชอบต่อความเสียหายที่เกิดจากการตัดสินใจของผู้ใช้งาน ไม่ว่าจะเป็นการสูญเสียเงิน เวลา หรือโอกาส",
      "การเดิมพันมีความเสี่ยง ควรใช้เฉพาะเงินที่รับความสูญเสียได้ กำหนดวงเงินและเวลาไว้ล่วงหน้า และหยุดเมื่อถึงขีดที่ตั้งไว้ หากรู้สึกว่าควบคุมไม่ได้ ขอให้หยุดและปรึกษาผู้ที่ไว้ใจได้",
    ],
  },
  {
    h: "ลิงก์ไปยังเว็บไซต์ภายนอก",
    p: [
      "หน้านี้มีลิงก์ที่พาไปยังเว็บไซต์ซึ่งอยู่นอกการควบคุมของเรา เนื้อหา ความปลอดภัย และการเก็บข้อมูลของปลายทางเป็นความรับผิดชอบของผู้ดูแลเว็บไซต์นั้น",
      "ควรตรวจชื่อโดเมนและการเชื่อมต่อ HTTPS ทุกครั้งก่อนกรอกข้อมูลใด ๆ และไม่ควรส่งรหัสผ่านหรือรหัส OTP ให้บุคคลอื่นไม่ว่ากรณีใด",
    ],
  },
  {
    h: "การเปลี่ยนแปลงเงื่อนไข",
    p: ["เงื่อนไขนี้อาจปรับปรุงได้เมื่อเนื้อหาหรือโครงสร้างของเว็บไซต์เปลี่ยนไป การใช้งานต่อหลังจากมีการปรับปรุงถือว่ารับทราบเงื่อนไขฉบับที่แสดงอยู่ ณ เวลานั้น"],
  },
];
---

<MainLayout title={`เงื่อนไขและข้อตกลง ${BRAND_NAME}`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <ContentBox as="h1" title={`เงื่อนไขและข้อตกลง ${BRAND_NAME}`}>
    <p class="text-left">กรุณาอ่านเงื่อนไขด้านล่างก่อนใช้งานเว็บไซต์ การเข้าชมและใช้งานต่อถือว่าท่านรับทราบและยอมรับข้อกำหนดทั้งหมดนี้</p>
  </ContentBox>

  {
    sections.map((section) => (
      <ContentBox as="h2" title={section.h}>
        {section.p.map((text, i) => (
          <p class={i === 0 ? "text-left" : "mt-3 text-left"}>{text}</p>
        ))}
      </ContentBox>
    ))
  }

  <ContentBox>
    <p class="text-left">
      อ่านเพิ่มเติมได้ที่ <a href="/privacy/" class="font-bold underline underline-offset-4">นโยบายความเป็นส่วนตัว</a> หรือ <a href="/contact-us/" class="font-bold underline underline-offset-4">
        ติดต่อทีมงาน
      </a>
    </p>
  </ContentBox>
</MainLayout>
