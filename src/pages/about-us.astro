---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "รู้จัก FUN24 เว็บเกมเดิมพันออนไลน์ครบทุกหมวด รวมเกมจากค่ายชั้นนำในระบบเดียว รองรับมือถือและคอมพิวเตอร์ ฝากถอนอัตโนมัติ พร้อมทีมงานดูแลสมาชิกตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ FUN24 คาสิโนออนไลน์อัตราจ่ายสูง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา FUN24 คาสิโนออนไลน์อัตราจ่ายสูง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ FUN24" as="h1">
    <p class="mb-6 text-left text-base leading-relaxed text-[#fbe6d8]">
      <strong class="text-[#fb923c]">FUN24</strong> คือคาสิโนออนไลน์อัตราจ่ายสูงที่รวมเกมจากค่ายชั้นนำไว้ในระบบเดียว ครอบคลุมบาคาร่า รูเล็ต เกมไพ่ และเกมคาสิโนสด รองรับการเข้าใช้งานผ่านโทรศัพท์มือถือและคอมพิวเตอร์ได้โดยตรงผ่านเว็บเบราว์เซอร์ ไม่ต้องติดตั้งโปรแกรมเพิ่มเติม
    </p>

    <p class="mb-8 text-left text-base leading-relaxed text-[#fbe6d8]">
      ด้านการเงิน ระบบฝากถอนอัตโนมัติเปิดให้ทำรายการได้ด้วยตนเองตลอด 24 ชั่วโมงโดยไม่ต้องรอเจ้าหน้าที่ทีละราย และมีทีมงานคอยดูแลให้คำแนะนำตลอดการเดิมพัน เพื่อให้สมาชิกทุกคนใช้งาน FUN24 ได้อย่างมั่นใจในทุกขั้นตอน
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก"
        class="flex items-center justify-center rounded-lg border border-[#f97316]/60 bg-gradient-to-b from-[#fb923c] to-[#f97316] px-8 py-3 font-bold text-white shadow-[0_10px_30px_rgba(249,115,22,0.18)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(194,65,12,0.30)]">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ"
        class="flex items-center justify-center rounded-lg border border-[#f97316]/60 bg-[#170a03] px-8 py-3 font-extrabold text-[#fbe6d8] shadow-[0_4px_14px_rgba(249,115,22,0.18)] transition-transform hover:scale-105 hover:bg-[#2a1206]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
