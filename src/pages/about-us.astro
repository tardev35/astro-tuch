---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";

const pageDescription = "รู้จัก 7LOTTO เว็บแทงหวยออนไลน์รวมหวยรัฐบาลไทย หวยออมสิน หวย ธ.ก.ส. หวยลาว หวยฮานอย หวยหุ้น ในบัญชีเดียว เรท 2 ตัว 100 3 ตัว 1,000 ฝากถอนอัตโนมัติ ดูแล 24 ชม.";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ 7LOTTO เว็บแทงหวยออนไลน์ครบทุกประเภท",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา 7LOTTO เว็บแทงหวยออนไลน์ครบทุกประเภท เรทจ่ายสูง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ 7LOTTO" as="h1">
    <p class="mb-6 text-left text-base leading-relaxed text-[#d8dae0]">
      <strong class="text-[#ff2a30]">7LOTTO</strong> เป็นเว็บแทงหวยออนไลน์ที่เปิดให้สมาชิกเข้าใช้งานผ่านเว็บเบราว์เซอร์บนมือถือ แท็บเล็ต และคอมพิวเตอร์ได้โดยตรง ไม่ต้องติดตั้งโปรแกรมเพิ่มเติม ภายในบัญชีเดียวรวมหวยไว้หลายประเภท
      ทั้งหวยรัฐบาลไทย หวยออมสิน หวย ธ.ก.ส. หวยลาว หวยฮานอย และหวยหุ้น ระบบจัดหมวดหมู่หวยแต่ละประเภทให้ค้นหารอบที่เปิดรับได้ง่าย เลือกรูปแบบการเดิมพัน ใส่เลขและจำนวนเงิน ตรวจสอบโพยก่อนกดยืนยันรายการ แล้วย้อนดูประวัติรายการของตนเองได้ตลอด
      24 ชั่วโมง
    </p>

    <p class="mb-8 text-left text-base leading-relaxed text-[#d8dae0]">
      ด้านอัตราจ่าย 7LOTTO กำหนดเรท 2 ตัว 100 และ 3 ตัว 1,000 สำหรับรายการที่เข้าเงื่อนไขตามรายละเอียดที่แสดงในระบบ สมาชิกควรตรวจสอบอัตราจ่าย วงเงินรับแทง
      และเงื่อนไขของหวยแต่ละประเภทก่อนยืนยันโพยทุกครั้ง การฝากและถอนทำผ่านระบบอัตโนมัติ และหลังประกาศผลสามารถตรวจสอบรายการกับยอดที่เกี่ยวข้องผ่านบัญชีสมาชิกได้โดยตรง หากพบปัญหาเรื่องการสมัครสมาชิก
      การเข้าสู่ระบบ เครดิตไม่เข้า รายการค้าง หรือการส่งโพย สามารถติดต่อเจ้าหน้าที่ 7LOTTO เพื่อให้ช่วยตรวจสอบได้ตลอดเวลา
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก 7LOTTO"
        class="flex items-center justify-center rounded-lg bg-gradient-to-r from-[#ff6b70] via-[#ff2a30] to-[#a3060c] px-8 py-3 font-black text-[#1a0405] shadow-[0_0_15px_rgba(255,42,48,0.45)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ 7LOTTO"
        class="flex items-center justify-center rounded-lg border border-[#d3d6db]/70 bg-transparent px-8 py-3 font-bold text-[#d8dae0] transition-all hover:scale-105 hover:border-[#ff2a30] hover:bg-[#150406]/70">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
