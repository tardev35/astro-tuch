---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// VAK88 เป็นเว็บสล็อตเว็บตรง ไม่ใช่เว็บรวมหลายหมวดเกมแบบแบรนด์ก่อนหน้า —
// ไม่มีบาคาร่า เกมไพ่ หวย หรือฟุตบอลในเนื้อหาหน้านี้
// เนื้อหาทั้งหน้าอ้างอิงบรีฟของแบรนด์นี้เท่านั้น: เกมสล็อตเว็บตรงเจ้าแรก ·
// ช่องทางเข้าเล่นหลักอย่างเป็นทางการ ไม่ผ่านตัวแทนหรือเอเย่นต์ · ทุกค่ายได้รับ
// อนุญาตจากลิขสิทธิ์แท้ 100% (Certified API) · RTP มาตรฐานสากล · โปรแนะนำเพื่อน
// 0.8% และคืนยอดเสีย 0.3% ไม่ล็อคยูส · ฝาก-ถอนออโต้ 3-5 วินาที ไม่มีขั้นต่ำ ·
// รองรับ PC/แท็บเล็ต/iOS/Android ผ่านเบราว์เซอร์ ไม่ต้องโหลดแอป ·
// แอดมิน Line Official 24 ชม.
// — ไม่มีการอ้างใบอนุญาต การจดทะเบียนบริษัท ปีที่ก่อตั้ง จำนวนสมาชิก การันตีผลกำไร
// หรือชื่อค่ายเกมรายใด เพราะบรีฟไม่ได้ระบุไว้
//
// Announcement รอบนี้หมุนมาใช้ Announcement5 ทั้งเว็บ — default message ของไฟล์นั้น
// เป็นคอปปี้ของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ไม่ต้องส่ง prop
//
// โลโก้ VAK88 เป็นนกฟีนิกซ์แดง-ทองเหนือเวิร์ดมาร์ก VAK88 บนพื้นดำอมกรมท่า
// สีของหน้านี้จึงเป็น navy-black #060913 + ทองเมทัลลิค #e6b23c + แดงเลือดนก #cf2027
// เนื้อความใช้ #ded8ca หัวข้อ/คำกล่าวอ้างใช้ #fff4dd
// คำเตือนทุกจุดใช้สีส้มอำพัน #ffb36b โดยตั้งใจ — คำเตือนที่ทาสีแบรนด์จะไม่อ่านเป็นคำเตือน
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 152
const pageDescription =
  "เกี่ยวกับ VAK88 เกมสล็อตเว็บตรงเจ้าแรก ช่องทางเข้าเล่นหลักที่ไม่ผ่านตัวแทน ทุกค่ายอนุญาตจากลิขสิทธิ์แท้ 100% ฝาก-ถอนออโต้ พร้อมแอดมินดูแลตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ VAK88 เกมสล็อตเว็บตรงเจ้าแรก แพลตฟอร์มหลักในไทย",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา VAK88 เกมสล็อตเว็บตรงเจ้าแรก แพลตฟอร์มหลักในไทย" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ VAK88 เกมสล็อตเว็บตรงเจ้าแรก แพลตฟอร์มหลักในไทย" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ded8ca]">
        <strong class="text-[#fff4dd]">VAK88</strong> ให้บริการ<strong class="text-[#fff4dd]">เกมสล็อตออนไลน์ในรูปแบบเว็บตรง</strong>
        ผ่านช่องทางเข้าเล่นหลักอย่างเป็นทางการ โดยไม่ต้องผ่านตัวแทนหรือเอเย่นต์
        สมาชิกสามารถสมัคร เข้าสู่ระบบ ตรวจสอบเครดิต ฝากถอน รับโปรโมชั่น และจัดการบัญชีได้จากหน้าเว็บไซต์โดยตรง
        ใช้งานผ่านเว็บเบราว์เซอร์ได้ทั้งบนคอมพิวเตอร์ แท็บเล็ต และสมาร์ตโฟนทั้ง iOS และ Android โดยไม่ต้องดาวน์โหลดแอปพลิเคชัน
      </p>

      <p class="text-left text-base leading-relaxed text-[#ded8ca]">
        หน้านี้รวบรวมไว้ว่าเว็บไซต์เปิดให้ทำอะไรได้บ้าง ตั้งแต่ช่องทางเข้าเล่นและที่มาของเกม การจัดการบัญชีด้วยตัวเอง
        ไปจนถึงโปรโมชั่นที่ตรวจสอบสิทธิ์ได้จากบัญชีสมาชิก
        <strong class="text-[#ffb36b]">สำหรับคำว่า “เว็บตรงเจ้าแรก” และ “แพลตฟอร์มหลัก” ควรมีข้อมูลผู้ให้บริการหรือหลักฐานที่ตรวจสอบได้บนเว็บไซต์ เพื่อให้คำกล่าวอ้างมีความชัดเจนและสร้างความน่าเชื่อถือได้มากขึ้น</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="ช่องทางเข้าเล่น VAK88 หลัก ไม่ผ่านตัวแทนหรือเอเย่นต์" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ded8ca]">
        VAK88 ให้บริการผ่านช่องทางเข้าเล่นหลักของเว็บไซต์เอง ช่วยให้สมาชิก
        <strong class="text-[#fff4dd]">ทำรายการกับระบบกลางโดยตรงโดยไม่ต้องผ่านตัวแทนหรือเอเย่นต์</strong>
        และตรวจสอบเครดิตกับประวัติรายการทั้งหมดได้จากบัญชีเดียวกัน
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#ded8ca]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e6b23c]">🎰</span>
          <span><strong class="text-[#fff4dd]">เกมสล็อตจากหลายค่ายในระบบเดียว</strong> จัดไว้เป็นหมวดหมู่ให้ค้นหาเกมและสลับค่ายผ่านบัญชีเดียว</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ee3a34]">🔐</span>
          <span><strong class="text-[#e6b23c]">ทุกค่ายได้รับอนุญาตจากลิขสิทธิ์แท้ 100% (Certified API)</strong> เชื่อมต่อกับผู้พัฒนาเกมผ่านระบบที่ผ่านการตรวจสอบแล้ว</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e6b23c]">📊</span>
          <span><strong class="text-[#fff4dd]">อัตราการชนะ (RTP) เป็นไปตามมาตรฐานสากล</strong> ไม่มีการดัดแปลงเปอร์เซ็นต์การชนะจากฝั่งเว็บไซต์</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ee3a34]">📱</span>
          <span><strong class="text-[#e6b23c]">เข้าเล่นผ่านเว็บเบราว์เซอร์ได้ทุกอุปกรณ์</strong> ทั้งคอมพิวเตอร์ แท็บเล็ต และสมาร์ตโฟน iOS กับ Android โดยไม่ต้องดาวน์โหลดแอป</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#ded8ca]">
        <strong class="text-[#ffb36b]">ก่อนเริ่มเดิมพันควรตรวจสอบกติกา อัตราจ่าย ช่วงเดิมพัน และวงเงินของแต่ละเกมให้ครบถ้วน เนื่องจากรายละเอียดอาจแตกต่างกันตามค่ายเกมและประเภทการเดิมพัน รวมถึงค่า RTP เป็นค่าเฉลี่ยระยะยาวที่ไม่รับประกันกำไรหรือผลชนะในแต่ละรอบ</strong>
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="สมัครและจัดการบัญชี VAK88 ด้วยตัวเอง พร้อมฝาก-ถอนออโต้" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ded8ca]">
        ผู้ใช้งานใหม่สามารถ<strong class="text-[#fff4dd]">สมัคร VAK88 ผ่านระบบอัตโนมัติได้ด้วยตัวเองใน 3 ขั้นตอน</strong>
        เริ่มจากยืนยันเบอร์โทรศัพท์ด้วยรหัส OTP จากนั้นผูกบัญชีธนาคารโดยกรอกชื่อ-นามสกุลและเลขบัญชีให้ตรงกัน
        แล้วตั้งรหัสผ่าน เข้าสู่ระบบ เติมเครดิต และเลือกเกมที่ต้องการได้ทันที
      </p>

      <p class="text-left text-base leading-relaxed text-[#ded8ca]">
        หลังเปิดบัญชี สมาชิกสามารถ<strong class="text-[#fff4dd]">ตรวจสอบเครดิต ฝากถอน โปรโมชั่น และประวัติรายการผ่านหน้าเว็บไซต์ได้</strong>
        โดยระบบฝาก-ถอนอัตโนมัติประมวลผลภายใน <strong class="text-[#e6b23c]">3-5 วินาที</strong> รองรับธนาคารชั้นนำ และไม่กำหนดขั้นต่ำในการทำรายการ
        ทำให้เห็นได้ด้วยตัวเองว่ารายการหนึ่งถูกบันทึกไว้อย่างไรและอยู่ในสถานะใด โดยไม่ต้องแจ้งรายการกับเจ้าหน้าที่ทุกครั้ง
      </p>

      <p class="text-left text-base leading-relaxed text-[#ded8ca]">
        <strong class="text-[#ffb36b]">สำหรับเงื่อนไขไม่มีขั้นต่ำและความเร็วของรายการ ควรยึดตัวเลขและสถานะที่ระบบแสดง ณ เวลาทำรายการ เนื่องจากเวลาประมวลผลอาจขึ้นกับธนาคารต้นทางปลายทาง และช่วงเดิมพันของเกมแต่ละเกมอาจไม่เท่ากัน</strong>
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="โปรโมชั่น VAK88 แนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ded8ca]">
        สมาชิกสามารถนำลิงก์แนะนำส่วนตัวไปแชร์ให้เพื่อน เมื่อเพื่อนสมัคร VAK88 และมียอดการเล่นตรงตามข้อกำหนด
        ระบบจะคำนวณ<strong class="text-[#e6b23c]">ค่าคอมมิชชั่นแนะนำเพื่อนสูงถึง 0.8%</strong> จากยอดที่เข้าเงื่อนไข
        สามารถตรวจสอบจำนวนเพื่อน ยอดคำนวณ และโบนัสที่มีสิทธิ์รับผ่านบัญชีสมาชิกได้โดยตรง
        <strong class="text-[#ffb36b]">ก่อนรับโบนัสควรตรวจสอบรอบคำนวณ ประเภทเกมที่ร่วมรายการ และเงื่อนไขของโปรโมชั่นล่าสุดให้ครบถ้วน</strong>
      </p>

      <p class="text-left text-base leading-relaxed text-[#ded8ca]">
        สมาชิกที่มียอดเสียตรงตามเงื่อนไขสามารถตรวจสอบสิทธิ์รับ<strong class="text-[#e6b23c]">โบนัสคืนยอดเสีย 0.3%</strong>
        ในทุกรอบบิลตามที่ VAK88 กำหนด ระบบจะแสดงยอดที่เข้าเกณฑ์และจำนวนโบนัสที่กดรับได้จากบัญชีสมาชิก
        โดยโปรโมชั่นเปิดให้ทั้งสมาชิกใหม่และยูสเซอร์เดิม <strong class="text-[#fff4dd]">ไม่มีการล็อคยูสเซอร์</strong>
        <strong class="text-[#ffb36b]">ก่อนกดรับควรตรวจสอบประเภทเกม รอบเวลา วิธีคำนวณ และเงื่อนไขการถอนของโปรโมชั่น เพื่อให้ใช้งานโบนัสได้ตรงตามข้อกำหนด</strong>
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="แอดมิน VAK88 บริการผ่าน Line Official ตลอด 24 ชั่วโมง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ded8ca]">
        หากพบปัญหาเกี่ยวกับการสมัครสมาชิก เข้าสู่ระบบไม่ได้ ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง เข้าเกมไม่ได้ หรือโปรโมชั่นไม่แสดง สามารถ
        <strong class="text-[#fff4dd]">ติดต่อแอดมิน VAK88 ผ่าน Line Official ได้ตลอด 24 ชั่วโมง</strong>
        พร้อมแจ้งรายละเอียด เวลา จำนวนเงิน หรือข้อมูลรายการที่เกี่ยวข้อง เพื่อช่วยให้เจ้าหน้าที่ตรวจสอบปัญหาได้ตรงจุด
      </p>

      <p class="text-left text-base leading-relaxed text-[#ded8ca]">
        สมาชิกใหม่ยังสามารถสอบถามเกี่ยวกับขั้นตอนสมัคร วิธีฝากถอน การรับโปรโมชั่น หรือการเข้าใช้งานเกมแต่ละค่ายได้
        <strong class="text-[#ffb36b]">โดยไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่นระหว่างการติดต่อเจ้าหน้าที่</strong>
      </p>

      <p class="text-left text-base leading-relaxed text-[#ded8ca]">
        <strong class="text-[#ffb36b]">การเดิมพันมีความเสี่ยงและผลของแต่ละรอบไม่แน่นอน ไม่มีเกมใดรับประกันผลล่วงหน้า</strong>
        สมาชิกจึงควรกำหนดงบประมาณก่อนเริ่มเล่นทุกครั้ง
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก VAK88"
          class="flex items-center justify-center rounded-lg border border-[#ee3a34]/60 bg-gradient-to-r from-[#ee3a34] via-[#cf2027] to-[#6b0d11] px-8 py-3 font-black text-[#fff4dd] shadow-[0_0_15px_rgba(207,32,39,0.35)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ VAK88"
          class="flex items-center justify-center rounded-lg border border-[#e6b23c]/55 bg-transparent px-8 py-3 font-bold text-[#e6b23c] transition-all hover:scale-105 hover:border-[#ffd873] hover:bg-[#121a2e]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
