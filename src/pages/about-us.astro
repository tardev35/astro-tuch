---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึงเขียนขึ้นใหม่
// บนข้อเท็จจริงของบรีฟรอบนี้เท่านั้น (src/assets/content.txt) ไม่ใช่แก้ทับประโยคเดิม
// ของแบรนด์ก่อน — ของเดิมเป็นคอปปี้ "เว็บหลักรวมทุกหมวด" ของแบรนด์ก่อนหน้า
// ซึ่งขัดกับแบรนด์รอบนี้ทั้งหน้า จึงถูกเขียนใหม่ทั้งหมด ไม่ใช่แทนที่ชื่อแบรนด์
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) จึงเปิดใช้งานอยู่ และรอบนี้ operator สั่งให้
// คงไว้ ไม่ได้ park ลง src/pages-disabled/
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// ตัวที่ routing จริงคือไฟล์นี้ ตัวที่จอดไว้เป็นอินเวนทอรี ห้ามแก้และห้ามลบ
//
// ดรอปนี้ (2026-10-09) คือ **เว็บเล่นสล็อตออโต้ รวมเกมจากค่ายหลักไว้ในแพลตฟอร์ม
// เดียว** ไม่ใช่เว็บรวมทุกหมวดแบบรอบก่อน และรอบนี้ไม่มีหมวดลอตเตอรีเลย (สองหน้าของ
// หมวดนั้นจอดอยู่ใน src/pages-disabled/ ไม่มี route จึงห้ามลิงก์ไปหา มิฉะนั้นเป็น href ตาย
// ที่ทำให้ build แดง) แง่มุมที่บรีฟระบุไว้มีเท่านี้: รวมเกมสล็อตหลายรูปแบบไว้ใน
// แพลตฟอร์มเดียว (สล็อตคลาสสิก เกมโบนัส ฟรีสปิน ตัวคูณ เกมรูปแบบใหม่) · เล่นผ่าน
// มือถือได้โดยไม่ต้องติดตั้งโปรแกรมเพิ่มเติม · เลือกค่าย ค้นหาเกม ตรวจสอบเครดิต
// ติดตามรายการจากบัญชีเดียว · บางเกมเบทเริ่มต้น 1 บาทตามช่วงเดิมพันที่ค่ายกำหนด ·
// ตารางจ่ายและอัตราการคืนเงินผู้เล่นตรวจได้ก่อนเริ่มเล่น · คืนยอดเสีย 0.3% เข้ายูส
// ตามรอบ · แนะนำเพื่อนแชร์ลิงก์ 0.8% จากยอดที่เข้าเกณฑ์ · ฝากถอนเข้าบริษัทโดยตรง
// ตรวจชื่อบัญชีปลายทางและข้อมูลนิติบุคคล · แอดมิน 24 ชั่วโมง · PIN/OTP
//
// ⚠️ คำที่ห้ามหลงเหลือ: ศัพท์ของหมวดอื่นที่ไม่ใช่สล็อต และคำขายของของแบรนด์ก่อนๆ
// ที่บรีฟรอบนี้ไม่ได้เอ่ย — รายการเต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อ
// ไม่ให้ grep หาคำต้องห้ามเจอ false positive รอบนี้เขียนใหม่จากบรีฟ ไม่ได้
// find-and-replace ทับประโยคเก่า เพราะประโยคเก่าทั้งย่อหน้าตั้งอยู่บนคำเหล่านั้น
//
// ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 1 บาท · 0.3% · 0.8% · 24 ชั่วโมง
// ห้ามเติมเลขใบอนุญาต หน่วยงานกำกับ ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP ยอดฝากขั้นต่ำ
// จำนวนสมาชิก หรือปีที่ก่อตั้ง เพราะบรีฟไม่ได้เอ่ยไว้สักอย่าง
//
// ประโยคกำกับที่บรีฟเขียนไว้เองและห้ามตัดทิ้งเพราะฟังดูไม่ขายของ: จำนวนค่ายและเกม
// จริงตรวจได้จากหน้าเว็บไซต์ · แตกง่าย/ไม่มีขั้นต่ำควรพิจารณาจากข้อมูลเกมจริง
// เพราะผลการหมุนสล็อตเป็นแบบสุ่ม · แต่ละโปรโมชั่นกำหนดค่ายเกม ระยะเวลา และเงื่อนไข
// ต่างกัน ควรอ่านก่อนรับสิทธิ์ · คำว่าไม่จำกัดควรตรวจสอบว่าหมายถึงอะไร · ชื่อบัญชี
// บริษัทอย่างเดียวไม่ได้รับประกันว่าธุรกรรมไม่มีความเสี่ยง · ไม่เปิดเผยรหัสผ่าน
// PIN หรือ OTP แม้ผู้นั้นจะอ้างว่าเป็นเจ้าหน้าที่
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ม่วงนีออน x ทองอาร์เขต บนครามเกือบดำ**
// พลิกจากคู่แดงแล็กเกอร์-ทองของแบรนด์ก่อน ซึ่งออกครบทุกจุดแล้ว ทั้งคลาส Tailwind
// raw hex และ rgba() (ค่าเดิมอยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้
// grep หาสีแบรนด์เก่าเจอ false positive)
// ลำดับปุ่มสื่อด้วย "ทองถม vs ม่วงโปร่ง": ปุ่มหลัก (สมัครสมาชิก) ถมทองไล่ #ffd23d
// → #c98a05 ขอบ #c98a05 หมึกม่วงเกือบดำ #190633 (11.0:1 บน #ffd23d) — ห้ามพลิกเป็น
// หมึกสว่าง · ปุ่มรองและปุ่มลิงก์ภายในเป็นผิวการ์ด #1e0a3c → #110321 ขอบม่วง
// #a435f0/55 ตัวอักษรม่วงอ่อน #d2a6ff (7.4:1) · #00B900 บนปุ่ม LINE เป็นสีประจำ
// แบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้
// ⚠️ ม่วงสด #a435f0 ห้ามถือตัวอักษรสว่าง (3.1:1 — brand-spec §2 ระบุห้ามโดยตรง)
// จึงใช้เป็นขอบ เงา และออราเท่านั้น
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #ece2ff)
// ไว้ที่ตัวการ์ดแล้ว ข้อความในหน้านี้จึงไม่ประกาศสีของตัวเองเลย ปล่อยให้สืบทอดลงมา
// — มีแค่ปุ่มที่ประกาศสีได้ เพราะปุ่มถมพื้นของตัวเองจึงต้องกำหนดหมึกของตัวเอง
// ส่วนไฮไลต์ในเนื้อความใช้ทองสว่าง #fbe455 ที่ <strong> เท่านั้น และแต่ละ <strong>
// ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้า
// เปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้าง
// จากหน้า และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น Announcement5 ทั้งเว็บ (รอบก่อนใช้ AnnouncementCyber —
// brand-spec §3 หมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้
// ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูด
// คนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 159 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} เว็บเล่นสล็อตออโต้ที่รวมเกมจากค่ายหลักไว้ในแพลตฟอร์มเดียว พร้อมคืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% ฝากถอนเข้าบริษัทโดยตรง แอดมิน 24 ชั่วโมง`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} เล่นสล็อตออโต้ทุกค่าย รวมเกมจากค่ายหลักในแพลตฟอร์มเดียว`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong>{BRAND_NAME} คือเว็บเล่นสล็อตออโต้ที่รวบรวมเกมสล็อตจากค่ายหลักไว้ในแพลตฟอร์มเดียว</strong>
        มีทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน ตัวคูณ และเกมรูปแบบใหม่ให้เลือกตามความสนใจ รองรับการใช้งานผ่านมือถือโดยไม่ต้องติดตั้งโปรแกรมเพิ่มเติม สมาชิกเลือกค่าย ค้นหาเกม ตรวจสอบเครดิต และติดตามรายการต่างๆ ได้จากบัญชีเดียว
      </p>

      <p>
        หน้านี้สรุปไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่เมนูเลือกค่ายและหมวดเกมสล็อต
        <strong>ไปจนถึงการตรวจสอบเครดิต ประวัติรายการ โปรโมชั่นที่เปิดให้รับในแต่ละช่วง และช่องทางติดต่อแอดมินที่ดูแลตลอด 24 ชั่วโมง</strong>
        เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดดูอะไรตรงไหน แล้วจึงค่อยลงรายละเอียดของรายการที่สนใจเป็นรายรายการ
      </p>

      <p>
        <strong>ส่วนจำนวนค่ายและเกมที่เปิดให้บริการจริงสามารถตรวจสอบได้จากหน้าเว็บไซต์</strong>
        เพราะรายชื่อที่เปิดอยู่เปลี่ยนแปลงได้ตามช่วงเวลา ข้อมูลในหน้านี้จึงเขียนไว้เพื่อบอกว่าระบบมีอะไรให้ใช้และควรตรวจอะไรก่อนตัดสินใจ ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้งาน
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`เกมสล็อตและเมนูที่ ${BRAND_NAME} รวมไว้ในบัญชีเดียว`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} รวมเมนูที่สมาชิกต้องใช้ไว้หลังการเข้าสู่ระบบครั้งเดียว
        <strong>ตั้งแต่การเลือกค่ายและค้นหาเกมสล็อต ไปจนถึงการตรวจสอบเครดิตและติดตามรายการต่างๆ จากบัญชีเดิม</strong>
        เมนูแต่ละส่วนทำหน้าที่คนละอย่างและแสดงข้อมูลคนละชุด จึงควรเปิดดูให้ครบตั้งแต่ครั้งแรก เพื่อให้รู้ว่าข้อมูลที่ต้องใช้จริงอยู่ตรงไหน สิ่งที่แต่ละเมนูดูแลแบ่งออกได้ประมาณนี้
      </p>

      <ul class="flex flex-col gap-3" aria-label={`เมนูฝั่งสมาชิกบนเว็บ ${BRAND_NAME}`}>
        <li class="flex gap-3">
          <span aria-hidden="true">🎰</span>
          <span>
            <strong>เมนูเลือกค่ายและค้นหาเกม</strong> ใช้ไล่ดูรายชื่อค่ายหลักและหมวดเกมสล็อตที่ระบบเปิดให้บริการ ทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน ตัวคูณ และเกมรูปแบบใหม่ โดยจำนวนค่ายและเกมอาจเปลี่ยนแปลงตามช่วงเวลา
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">🪙</span>
          <span>
            <strong>ช่วงเดิมพันของแต่ละเกม</strong> บางเกมรองรับการเดิมพันเริ่มต้น 1 บาท ตามช่วงเดิมพันที่ค่ายกำหนด จึงควรเปิดดูช่วงเดิมพันที่แสดงภายในเกมก่อนเริ่มเล่น เพื่อวางแผนจำนวนเงินต่อรอบให้เหมาะกับงบที่ตั้งไว้
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">💳</span>
          <span>
            <strong>การตรวจสอบเครดิต</strong> แสดงยอดล่าสุดของบัญชีที่ระบบบันทึกไว้ เป็นค่าที่ควรยึดก่อนเลือกเกม แทนตัวเลขที่จำไว้จากรอบก่อนหน้า
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">📋</span>
          <span>
            <strong>การติดตามรายการต่างๆ</strong> ใช้ไล่ดูรายการย้อนหลังของบัญชีตัวเองและสถานะของรายการที่ส่งไว้ เป็นที่เดียวกับที่ใช้อ้างอิงวันเวลาเวลาจะแจ้งปัญหาให้เจ้าหน้าที่ตรวจสอบ
          </span>
        </li>
      </ul>

      <p>
        ก่อนเริ่มเล่นสามารถเปิดดูตารางจ่ายและอัตราการคืนเงินผู้เล่นของแต่ละเกมได้จากในเกมเอง
        <strong>สำหรับคำว่า แตกง่ายและไม่มีขั้นต่ำ ควรพิจารณาจากข้อมูลเกมจริง เพราะแต่ละค่ายกำหนดยอดเดิมพันต่ำสุดไม่เท่ากัน</strong>
        และผลการหมุนสล็อตเป็นแบบสุ่ม ไม่มีเกมใดรับประกันว่าจะได้รับโบนัสหรือกำไรทุกครั้ง จึงควรตรวจสอบช่วงเดิมพันและกำหนดวงเงินของตัวเองก่อนเริ่มเล่น
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/ทดลองเล่น"
          aria-label={`เปิดหน้าทดลองเล่นของ ${BRAND_NAME}`}
