---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login, /register,
// /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx
// ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึง
// เขียนขึ้นใหม่บนข้อเท็จจริงของบรีฟรอบนี้เท่านั้น (src/assets/content.txt)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา 🐯) จึงเปิดใช้งานอยู่ และรอบนี้ operator สั่งให้
// คงไว้ ไม่ได้ park ลง src/pages-disabled/
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// ตัวที่ routing จริงคือไฟล์นี้ Astro ไม่อ่านโฟลเดอร์นั้นเลย ห้ามแก้และห้ามลบ
//
// ⚠️ ดรอปนี้ (2026-10-11) คือ **TIGERWIN369 เกมคาสิโนรวม** — บาคาร่า สล็อต
// บอลออนไลน์ ไฮโล และยิงปลา **ไม่ใช่เว็บหมวดกีฬา** แบบแบรนด์ก่อน ซึ่งกรอบเล่าเรื่อง
// ทั้งหมดเป็นศัพท์ที่ brand-spec §7 สั่งห้ามรอบนี้ (ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep
// หาคำต้องห้ามเจอ false positive) และไม่ใช่เว็บลอตเตอรี (สองหน้าของหมวดนั้นจอดอยู่ใน
// src/pages-disabled/ ไม่มี route ห้ามลิงก์ไปหา เป็น href ตายที่ทำให้ build แดง)
// หน้าเดิมทั้งหน้าใช้กรอบนั้น จึงเขียนใหม่ทั้งหน้า ไม่ใช่ find-and-replace ทับประโยคเดิม
//
// แง่มุมที่บรีฟรอบนี้ระบุไว้มีเท่านี้ (ห้ามเติมอย่างอื่น): เกมคาสิโนรวมครบวงจรใน
// แพลตฟอร์มเดียว · บาคาร่าเกมไพ่ยอดนิยม · สล็อตที่มีฟรีสปินและฟีเจอร์โบนัส ·
// บอลออนไลน์ที่แสดงคู่แข่งขันพร้อมอัตราต่อรอง · ไฮโลที่ใช้ผลจากลูกเต๋า · ยิงปลาที่มี
// รูปแบบต่างจากเกมโต๊ะ · หมวดเกมจัดเรียงให้ค้นหาสะดวก · รองรับมือถือและคอมพิวเตอร์ ·
// กติกา ตารางจ่าย ช่วงเดิมพัน · คืนยอดเสีย 0.3% เข้ายูสทุกวัน (รอบคำนวณ เวลาตัดยอด
// ยอดที่เข้าเกณฑ์) · แนะนำเพื่อน โบนัส 0.8% ผ่านลิงก์แนะนำ · สมัครสมาชิก 3 ขั้นตอน
// (เข้าหน้าสมัคร / กรอกข้อมูลบัญชี / ยืนยันบัญชี) · แอดมิน 24 ชั่วโมง ·
// ช่องทางติดต่อหลัก · หมายเลขรายการ · PIN · OTP
//
// ⚠️ คำที่ห้ามหลงเหลือ: ศัพท์กรอบ "เว็บกีฬา" ของแบรนด์ก่อน ศัพท์ขายของของแบรนด์เก่าๆ
// และศัพท์หมวดลอตเตอรีทุกคำ — รายการเต็มอยู่ใน brand-spec §7 ไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาคำต้องห้ามเจอ false positive
// หมายเหตุ: `บอลออนไลน์` กับ `คู่แข่งขัน` เป็นคำของบรีฟรอบนี้เอง (บรรทัด 6 และ 24)
// ขนมาได้ตามปกติ — ที่ห้ามคือกรอบเล่าเรื่องแบบเว็บกีฬา ไม่ใช่ตัวคำนาม
//
// ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง
// ห้ามเติมเลขใบอนุญาต หน่วยงานกำกับ ชื่อค่ายเกม ชื่อธนาคาร ชื่อลีก/ทีม ค่า RTP
// ยอดฝากถอนขั้นต่ำเป็นตัวเลข จำนวนสมาชิก หรือปีที่ก่อตั้ง เพราะบรีฟไม่ได้เอ่ยไว้สักอย่าง
//
// ประโยคกำกับที่บรีฟเขียนไว้เองและห้ามตัดทิ้งเพราะฟังดูไม่ขายของ — ขนมาครบทั้งเจ็ด:
// ควรตรวจสอบรายละเอียดในระบบก่อนทำรายการ (h1 ย่อหน้า 1) · จำนวนเกมขึ้นอยู่กับระบบ
// (h2 #1 ย่อหน้าท้าย) · ความนิยมและความน่าเชื่อถือไม่สามารถยืนยันจากข้อความโฆษณา
// เพียงอย่างเดียว (h1 ย่อหน้า 3) · ควรตรวจสอบข้อกำหนดของแต่ละเกม เนื่องจากอาจมี
// วงเงินเริ่มต้นไม่เท่ากัน (h2 #1 ย่อหน้าท้าย) · คำว่าไม่จำกัดควรระบุให้ชัด
// (h2 #2 รายการที่สอง) · ควรตรวจสอบชื่อโดเมนและข้อกำหนดก่อนส่งข้อมูลส่วนตัว
// (h2 #3 ย่อหน้า 1) · ไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP (h2 #3 ย่อหน้าท้าย)
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ทองอำพันเสือบนดำสนิท #000000** รอบนี้
// **ไม่มีเงิน ไม่มีเทา ไม่มีฮิวเย็นเลย** พลิกจากคู่ "ทองแชมเปี้ยน-เงินโครเมียม" ของ
// แบรนด์ก่อน (ค่าเดิมอยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีแบรนด์
// เก่าเจอ false positive) และเพราะพื้นเพจเป็นดำสนิท จึง **ไม่มีชั้นที่ลึกกว่าพื้นเพจ**
// ได้อีก ทุกผิวต้องสว่างขึ้นจาก #000000 เท่านั้น
//
// ลำดับปุ่มสื่อด้วย "ทองถม vs ผิวจมขอบทอง" — คู่พื้น-หมึกคำนวณไว้แล้ว:
// · ปุ่มหลัก (สมัครสมาชิก) ถมทองไล่ #ffd98a → #f7b733 → #d98324 ขอบ #8a5214
//   หมึกเข้ม #1a0d02 (ปลายเข้มสุด #d98324 ได้ 6.6:1)
//   ⚠️ ไล่เฉดต้องหยุดที่ #d98324 ห้ามไล่ลงไปถึง #8a5214 ใต้ตัวอักษร
// · ปุ่มรอง (เข้าสู่ระบบ) ชั้นจม #1c1206 → #0f0903 ขอบทองสว่าง #f7b733/55
//   ตัวอักษรเนื้อความ #f7e4c0
// · ปุ่มลิงก์ภายในเป็นชั้นจมเดียวกัน แต่ขอบทองอำพัน #d98324/50 ตัวอักษรทอง #d98324
// · #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้
// ⚠️ #8a5214 · #4a2a08 ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่เส้นขอบ ออรา และเงา —
// ออราในไฟล์นี้ใช้ rgba(217,131,36,α) และ rgba(247,183,51,α) เท่านั้น นอกจากเงาดำล้วน
// ⚠️ "ทอง" ไม่ใช่ตัวบอกว่าถูกแบรนด์: รอบนี้เป็นทองรอบที่แปดในสิบรอบ ให้เทียบเป็น
// "ค่า" กับตารางแบนใน brand-spec §2 — ทองรอบนี้ #d98324 ส้มกว่าทุกตัวในลิสต์ (G=131)
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #f7e4c0,
// 13.3:1 บนผิวยก #2d1c0a) ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง
// ปล่อยให้สืบทอดลงมา และไม่ใส่ mx-auto / max-w-* บน <p> เพราะการ์ดคุมความกว้างเองแล้ว
// — ที่ประกาศสีได้มีแค่ปุ่ม (ถมพื้นของตัวเองจึงต้องกำหนดหมึกของตัวเอง) และ <strong>
// ซึ่ง brand-spec §2 กำหนดให้ใช้ทองซีด #ffd98a (12.3:1 บนผิวการ์ด) เป็นสีไฮไลต์ใน
// เนื้อความโดยเฉพาะ · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะ
// ภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง
// (ลบแท็ก <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิมเป๊ะ)
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้าง
// จากหน้า และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้หมุนมาเป็น Announcement5 ทั้งเว็บ (ตัวที่แบรนด์ก่อนใช้ถูกหมุนออก
// ตาม brand-spec §3) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ
// แบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูดคนละเรื่อง
// กับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 155
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} เกมคาสิโนรวม รวมบาคาร่า สล็อต บอลออนไลน์ ไฮโล ยิงปลาไว้ในแพลตฟอร์มเดียว พร้อมคืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% และแอดมิน 24 ชั่วโมง`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} เกมคาสิโนรวม ครบวงจรในแพลตฟอร์มเดียว`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#ffd98a]">{BRAND_NAME} เป็นเกมคาสิโนรวมที่นำเสนอทางเลือกการเดิมพันครบวงจรในแพลตฟอร์มเดียว</strong>
        ทั้งบาคาร่า สล็อต บอลออนไลน์ ไฮโล และเกมยิงปลา พร้อมหมวดเกมที่จัดเรียงให้ค้นหาได้สะดวก รองรับการใช้งานผ่านมือถือและคอมพิวเตอร์ โดยแต่ละเกมมีเงื่อนไขและยอดขั้นต่ำแตกต่างกัน จึงควรตรวจสอบรายละเอียดในระบบก่อนทำรายการ
      </p>

      <p>
        หน้านี้สรุปไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่หมวดเกมที่จัดไว้ให้เลือกตามความสนใจ
        <strong class="text-[#ffd98a]">ไปจนถึงรายการโปรโมชั่นที่ตรวจสอบเงื่อนไขได้ ขั้นตอนสมัครสมาชิก และช่องทางติดต่อแอดมินที่ระบุเวลาให้บริการตลอด 24 ชั่วโมง</strong>
        เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดดูอะไรตรงไหน แล้วจึงค่อยลงรายละเอียดของรายการที่สนใจเป็นรายรายการ
      </p>

      <p>
        <strong class="text-[#ffd98a]">ส่วนภาพลักษณ์เว็บดังของแท้ในตำนาน ควรมีข้อมูลประวัติการเปิดให้บริการ รายชื่อผู้ให้บริการเกม และรายละเอียดผู้ดำเนินงานที่ตรวจสอบได้ประกอบ เพราะความนิยมและความน่าเชื่อถือไม่สามารถยืนยันจากข้อความโฆษณาเพียงอย่างเดียว</strong>
        ข้อมูลในหน้านี้จึงเขียนไว้เพื่อบอกว่าระบบมีอะไรให้ใช้และควรตรวจอะไรก่อนตัดสินใจ ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้งาน ซึ่งเป็นค่าที่ควรยึดเป็นหลักเสมอ
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`หมวดเกมที่ ${BRAND_NAME} รวมไว้ในระบบเดียว`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} รวบรวมเกมคาสิโนหลายแนวไว้ให้เลือกตามความสนใจ ค้นหาจากหมวดเกมที่จัดเรียงไว้หรือไล่ดูทีละประเภทก็ได้
        <strong class="text-[#ffd98a]">ระบบจัดเมนูให้ตรวจสอบรายละเอียดของเกม ข้อมูลบัญชี และรายการที่ทำไว้ได้จากที่เดียว</strong>
        พร้อมรองรับการใช้งานผ่านหน้าจอมือถือและคอมพิวเตอร์ ประเภทเกมที่เว็บไซต์ระบุไว้แบ่งออกได้ประมาณนี้
      </p>

      <ul class="flex flex-col gap-3" aria-label={`หมวดเกมคาสิโนบนเว็บ ${BRAND_NAME}`}>
        <li class="flex gap-3">
          <span aria-hidden="true">🃏</span>
          <span>
            <strong class="text-[#ffd98a]">บาคาร่า</strong> เกมไพ่ยอดนิยมที่มีกติกาและวิธีคำนวณผลของตัวเอง เป็นหมวดที่ควรอ่านกติกาและช่วงเดิมพันของโต๊ะก่อนลงมือ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">🎰</span>
          <span>
            <strong class="text-[#ffd98a]">สล็อต</strong> มีทั้งฟรีสปินและฟีเจอร์โบนัสในตัวเกม แต่ละเกมมีตารางจ่ายและเงื่อนไขของฟีเจอร์ไม่เหมือนกัน จึงควรเปิดอ่านก่อนเริ่ม
          </span>
