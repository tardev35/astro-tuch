---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login, /register,
// /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx
// ที่ใช้กับ index.astro — บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES
// ที่ให้ body มา ทั้งหน้าจึงเขียนขึ้นใหม่จากข้อเท็จจริงและคลังคำของบรีฟรอบนี้เท่านั้น
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x4 · h3x0
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) จึงเปิดใช้งานอยู่
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// ตัวที่ routing จริงคือไฟล์นี้ Astro ไม่อ่านโฟลเดอร์นั้นเลย ห้ามแก้และห้ามลบ
//
// ⚠️ ดรอปนี้ (2026-10-20) คือ **แฟนเพจเว็บบอลยูฟ่า = เว็บกีฬา/ฟุตบอล** บรีฟเรียก
// ตัวเองว่า "แฟนเพจเว็บบอลยูฟ่า" และพูดถึงข่าวสารฟุตบอล โปรแกรมแข่งขัน
// ผลการแข่งขัน แนวทางวิเคราะห์ก่อนเกม ราคาบอล ค่าน้ำ ราคาต่อรอง สถิติการพบกัน
// และความพร้อมของนักเตะ — **ไม่ใช่เว็บสล็อตและไม่ใช่เว็บหวย** สองหน้าหมวดลอตเตอรี
// ที่แบรนด์ก่อนๆ เคยเปิด จอดอยู่ใน src/pages-disabled/ ไม่มี route ห้ามลิงก์ไปหา
// เป็น href ตายที่ทำให้ build แดง route ที่มีจริงรอบนี้คือ / · /about-us ·
// /contact-us · /login · /privacy · /promotion · /register · /terms ·
// /ทดลองเล่น · /ทางเข้า · /line
//
// ⚠️ แบรนด์ก่อนหน้าทันที (รวยเทพ168 ที่ถูกแทนที่รอบนี้ — โดเมนเดิมไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ sweep ของรอบถัดไปสะดุดที่คอมเมนต์ของไฟล์นี้เอง) เป็นแบรนด์ **สล็อต**
// คอปปี้และโครงหัวข้อเดิมจึงว่าด้วยหมวดเกมสี่หมวดซึ่งรอบนี้ **ไม่มีอยู่เลย** —
// **ห้าม find-and-replace ทับประโยคเดิม** ทั้งหน้าถูกเขียนใหม่รอบกรอบของบรีฟรอบนี้
// ซึ่งว่าด้วย **การติดตามข่าวสารฟุตบอล ราคาบอล ค่าน้ำ และโปรโมชั่นสองรายการ**
// (คำต้องห้ามไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive —
// รายการเต็มอยู่ใน brand-spec §6 โดยหัวข้อหลักคือคำหมวดสล็อต/ยิงปลา/ไฮโล/หวย
// ทุกคำเป็นของค้าง ไม่ใช่ของรอบนี้)
//
// 🚨 **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกม ชื่อลีก หรือชื่อทีมแม้แต่ชื่อเดียว** จึงห้าม
// เขียนลงหน้าเว็บ และห้ามอ้างใบอนุญาต หน่วยงานกำกับ ชื่อนิติบุคคล ชื่อธนาคารเฉพาะราย
// ค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีก่อตั้ง · ห้ามใช้คำว่า เว็บตรง /
// ไม่ผ่านเอเย่นต์ / ลิขสิทธิ์แท้
//
// คลังคำที่บรีฟรอบนี้ให้มา และใช้ได้เท่านี้ (brand-spec §6): ฟุตบอล · เว็บบอล ·
// ยูฟ่า · แทงบอล · ทริคแทงบอล · ข่าวสารฟุตบอล · โปรแกรมแข่งขัน · ผลการแข่งขัน ·
// แนวทางวิเคราะห์ก่อนเกม · ลีก · แมตช์ · ราคาบอล · ค่าน้ำ · ราคาต่อรอง ·
// อัตราจ่าย · ผลงานย้อนหลัง · สถิติการพบกัน · ความพร้อมของนักเตะ · โปรโมชั่น ·
// คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · โบนัส · เครดิต · ยอดเสีย · รอบคำนวณยอด ·
// รอบเวลารับเครดิต · ลิงก์แนะนำ · เชื่อมโยงบัญชี · สมัครสมาชิก · เข้าสู่ระบบ ·
// ลงทะเบียน · ฝากถอน · ข้อมูลส่วนบุคคล · รหัสผ่าน · รหัส OTP · เจ้าหน้าที่ ·
// แอดมิน · 24ชม. · ช่องทางทางการ · เว็บไซต์ทางการ
//
// ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 24ชม. · 3 ขั้นตอน
//
// ⚠️ คำว่า "การันตีค่าน้ำดี จ่ายสูงสุดในวงการ" และ "รับได้ไม่จำกัดยูส" อยู่ได้เฉพาะ
// ในหัวข้อที่บรีฟเขียนไว้เอง (= หัวข้อของ index.astro) หน้านี้จึงไม่หยิบมาเป็นหัวข้อ
// เพราะย่อหน้าของบรีฟเองหักล้างทันทีว่าค่าน้ำและอัตราจ่ายเปลี่ยนแปลงได้ตามช่วงเวลา
//
// 🚨 บรีฟรอบนี้ **โฆษณากับกำกับความเสี่ยงอยู่ในย่อหน้าเดียวกัน** และประโยคกำกับ
// ทุกประโยคต้องขึ้นครบ เป็นเนื้อหาของบรีฟ ไม่ใช่ filler ให้ตัดทิ้ง:
// 1) ควรตรวจสอบความถูกต้องของข่าวสารและราคาที่เปลี่ยนแปลงก่อนการแข่งขันทุกครั้ง (h1)
// 2) ค่าน้ำและอัตราจ่ายสามารถเปลี่ยนแปลงได้ตามช่วงเวลา จึงควรตรวจสอบราคาจริงก่อน
//    ทำรายการ · คำกล่าวอ้างเรื่องการจ่ายสูงสุดควรมีข้อมูลเปรียบเทียบที่ตรวจสอบได้ ·
//    ไม่มีเทคนิคใดรับประกันผลการแข่งขันหรือผลกำไรจากการเดิมพัน (h1, h2 #1)
// 3) เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือช่วย
//    รับประกันผลตอบแทนในอนาคต (h2 #2)
// 4) แม้โปรโมชั่นจะระบุว่าไม่จำกัด แต่ควรตรวจสอบจำนวนบัญชีที่เข้าร่วมได้
//    รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุด (h2 #2)
// 5) ไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น (h2 #3, #4)
// 6) ควรตรวจสอบเวลาการให้บริการและระยะเวลาตอบกลับล่าสุดอีกครั้ง (h2 #4)
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ทองสองเฉด + บรอนซ์ บนดำสนิท ไม่มีสีที่สอง
// ที่เป็นคนละวงศ์**
// ⚠️ รอบก่อนเป็นทองนำ + **แดงชาด**รอง รอบนี้ **ไม่มีแดงเลย** แต่ทองเคยนำมาแล้ว
// เกือบทุกแบรนด์ "เจอทองอยู่แล้ว" จึงไม่ใช่ตัวบอกว่าถูกแบรนด์ ให้เทียบเป็น "ค่า"
// ทีละตัวกับตารางใน brand-spec §2 (ค่าเดิมไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสี
// แบรนด์เก่าเจอ false positive ในไฟล์นี้)
// ทองนำรอบนี้คือ **#d4922c** (R212 G146 B44 อำพันน้ำผึ้ง) ทองสว่าง **#fdfc71**
// ครีมทอง **#f6e3b4** และฮิวที่สามคือ **บรอนซ์ #a25b24** (R162 G91 B36)
// ลำดับความลึก: #33200a ผิวยก (= การ์ด) / #1f1304 กลาง / #0a0601 จม / #000000 พื้นเพจ
//
// ⚠️ **บรอนซ์ #a25b24 ได้แค่ 3.0:1 บนผิวการ์ด จึงห้ามถือตัวอักษรทุกขนาด** ใช้ได้แค่
// เส้นขอบ ไอคอน ออรา และพื้นถม เช่นเดียวกับบรอนซ์ไหม้ #5a3310 ที่เป็นเส้นและออรา
// เท่านั้น — ออราในไฟล์นี้ใช้ rgba(212,146,44,α) · rgba(162,91,36,α) เท่านั้น
// และรอบนี้ไม่มีแดง ไม่มีฟ้า/น้ำเงิน ไม่มีม่วง ไม่มีเขียว (นอกจาก LINE) ไม่มีเงิน/
// โครเมียม ไม่มีโรสโกลด์ ไม่มีชมพู/ฟูเชีย และไม่มีส้มสด — บรอนซ์เป็นฮิวที่สามที่
// อ่านจาก logo.webp จริง ไม่ใช่ส้มอิสระ
//
// ลำดับปุ่มสื่อด้วย "พื้นถมทอง vs ผิวจมขอบบรอนซ์" — คู่พื้น-หมึกคำนวณไว้แล้ว:
// · ปุ่มหลัก (สมัครสมาชิก) ถมไล่เฉด #f6e3b4 → #d4922c ขอบ #a25b24 หมึก #1a1000
//   (14.8:1 บนปลายครีม และ 7.1:1 บนปลายทอง ผ่าน AA ทั้งเส้น)
// · ปุ่มรอง/ปุ่มลิงก์ภายในเป็นชั้นจม #1f1304 → #0a0601 ขอบ #a25b24
//   ตัวอักษร #fbf6e3 (17.6:1–19.2:1) — hover ยกขอบเป็นทอง #d4922c (ตรงกับ hover
//   ของการ์ด ContentBox)
// · ชิปไอคอนของรายการข้อมูลฟุตบอลใช้บรอนซ์เป็น **เส้นขอบ** บนผิวกลาง #1f1304 —
//   ไม่ถือตัวอักษร
// · marker ของลำดับเลขใช้ครีมทอง #f6e3b4 (12.3:1 บนผิวการ์ด — เป็นตัวอักษร จึงใช้
//   บรอนซ์ไม่ได้ และ #d4922c สงวนไว้ให้ <strong> เท่านั้น)
// · #00B900 บนปุ่ม LINE เป็นสีประจำแพลตฟอร์ม LINE ไม่ใช่สีของเว็บ จึงคงไว้
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #fbf6e3,
// 14.3:1 บนผิวยก #33200a) ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง
// ปล่อยให้สืบทอดลงมา และไม่ใส่ mx-auto / max-w-* บน <p> เพราะการ์ดคุมความกว้างเองแล้ว
// — ที่ประกาศสีได้มีแค่ปุ่ม (ถมพื้นของตัวเองจึงต้องกำหนดหมึกของตัวเอง) ชิปไอคอน
// marker ของลำดับเลข และ <strong> ซึ่ง brand-spec §2 สงวน #d4922c (5.9:1 บนผิว
// การ์ด) ไว้เป็นสีไฮไลต์ในเนื้อความโดยเฉพาะ และไม่ใช้สีอื่นเลย · แต่ละ <strong>
// ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/
// ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง (ลบแท็ก <strong> ออกแล้วคอปปี้ต้อง
// อ่านได้เหมือนเดิม) และห้ามวาง <strong> สองอันติดกัน
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้าง
// จากหน้า และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้หมุนมาเป็น Announcement3 ทั้งเว็บ (brand-spec §3 —
// รอบก่อนใช้ AnnouncementPremium จึงหมุนออก) orchestrator ตั้ง default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message
// มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 159 อักขระ
//
// ห้ามให้สตริงนี้มีชื่อของสองหน้าหมวดลอตเตอรีที่จอดอยู่ใน src/pages-disabled/
// (ชื่อไฟล์ทั้งสองอยู่ใน brand-spec §7) เพราะ sweep ของรอบถัดไปจะอ่านเป็น
// false positive ว่ายังมีลิงก์ไปหน้าที่ไม่มี route
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} แฟนเพจเว็บบอลยูฟ่า รวมข้อมูลข่าวสารฟุตบอล โปรแกรมแข่งขัน ราคาบอล โปรโมชั่นคืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% และช่องทางติดต่อแอดมิน 24ชม.`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} แฟนเพจเว็บบอลยูฟ่า อัปเดตข่าวสารทุกแมตช์`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#d4922c]">{BRAND_NAME} นำเสนอช่องทางติดตามข่าวสารฟุตบอลสำหรับผู้ที่สนใจการแข่งขันจากลีกต่าง ๆ</strong>
        พร้อมข้อมูลโปรแกรมแข่งขัน ผลการแข่งขัน และแนวทางวิเคราะห์ก่อนเกม ภายในเว็บไซต์ยังมีรายละเอียดเกี่ยวกับราคาบอล ค่าน้ำ โปรโมชั่น และช่องทางติดต่อเจ้าหน้าที่ หน้านี้รวบรวมไว้ว่าเว็บไซต์ระบุอะไรไว้บ้าง
