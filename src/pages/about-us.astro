---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็น **บทความจริง** (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login,
// /register หรือหน้าภาพแบบ /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง
// ไม่ใช่เช็กลิสต์หัวข้อของบรีฟที่ใช้กับ index.astro — บรีฟรอบนี้
// (src/assets/content.txt, 29 บรรทัด) ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าใหม่จาก
// ข้อเท็จจริงและคลังคำของบรีฟรอบนี้เท่านั้น (.claude/brand-spec-lottoplus.md §4-§5)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x5 · h3x0
//   h1  เกี่ยวกับเรา <แบรนด์> หวยพลัสลอตโต้ แหล่งข้อมูลแทงหวยออนไลน์
//   h2  หวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยหุ้น สี่ประเภทที่ <แบรนด์> รวบรวมไว้
//   h2  สิ่งที่ควรตรวจสอบเองก่อนเชื่อคำกล่าวอ้างว่าเป็นทางเข้าเว็บแม่
//   h2  ระบบสมาชิกของ <แบรนด์> และการสมัคร 3 ขั้นตอน
//   h2  อัตราจ่าย 2 ตัว 100 และ 3 ตัว 1,000 กับสิ่งที่ควรอ่านก่อนยืนยันบิล
//   h2  แอดมิน <แบรนด์> แทงหวยออนไลน์ตลอด 24ชม.
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) และจาก footer จึงเปิดใช้งานอยู่
// ⚠️ หัวข้อของหน้านี้ **ตั้งใจไม่ให้ซ้ำกับหัวข้อของ index.astro** — index เล่าว่า
// เว็บไซต์ "ระบุอะไรไว้" ตามลำดับของบรีฟ ส่วนหน้านี้เล่าว่า "ตรวจสอบอะไรได้จากที่ไหน"
// ถ้ารอบหน้าคัดลอกหัวข้อของ index มาวางที่นี่ จะได้สองหน้าที่แข่งกันเองใน index
//
// 🚨🚨 ดรอปนี้ (2026-10-28) แบรนด์ขาออกอยู่หมวดธุรกิจเดียวกัน (เว็บเดิมพันออนไลน์)
// แต่ **คนละคำนิยามตัวเองทั้งชุด** เนื้อหาทั้งหน้าจึงถูก **เขียนใหม่ทั้งหน้า** ไม่ใช่
// แค่เปลี่ยนชื่อแบรนด์ บรีฟรอบนี้เรียกตัวเองว่า "หวยพลัสลอตโต้ ทางเข้าเว็บแม่
// แทงหวยออนไลน์ รัฐบาลไทย ลาว ฮานอย หุ้น อัตราจ่ายสูง จ่ายเต็ม โอนไว" และระบุ
// ประเภทหวยไว้ **สี่ประเภท** (หวยรัฐบาลไทย · หวยลาว · หวยฮานอย · หวยหุ้น) ·
// อัตราจ่าย 2 ตัว 100 · 3 ตัว 1,000 · สมัคร 3 ขั้นตอน · แอดมินตลอด 24ชม.
// 🚨🚨 **รอบก่อนเป็นคาสิโน/บาคาร่า — ห้ามสืบทอดหมวดหมู่ข้ามแบรนด์เด็ดขาด**
// 🚨🚨 **สล็อต บาคาร่า คาสิโนสด ไฮโล รูเล็ต ยิงปลา และเดิมพันฟุตบอล ไม่มีในบรีฟ
// รอบนี้เลยสักคำ ห้ามโผล่ที่ไหนบนหน้านี้** (ลิสต์เต็มอยู่ใน brand-spec §5)
// ⚠️⚠️ ศัพท์หมวดธุรกิจของแบรนด์ขาออกเป็น **คำค้างข้ามแบรนด์** ห้ามหลุดกลับมา
// **รายการคำต้องห้ามเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่** เพื่อไม่ให้
// sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// 🚨🚨 **LOTTO189 เป็นกับดักที่แหลมที่สุดรอบนี้ เพราะเป็นแบรนด์หวยเหมือนกัน** —
// "แนะนำเว็บหวยลอตโต้" / "จ่ายเต็ม จ่ายสด" / "รับทุกเลข ไม่มีอั้นเลข" **ไม่ได้อยู่
// ในบรีฟรอบนี้** บรีฟรอบนี้เขียนว่า **"จ่ายเต็ม โอนไว"** ต่างกันคำเดียวและเป็นคนละ
// แบรนด์ · และบรีฟรอบนี้พูดถึง **เลขอั้น** ในฐานะสิ่งที่ "ควรตรวจสอบ" ไม่ใช่สิ่งที่
// เว็บประกาศว่าไม่มี — **ห้ามกลับขั้วประโยคนี้**
// ⚠️⚠️ ชื่อแบรนด์รอบนี้เป็น **ตัวละตินพิมพ์ใหญ่คำเดียวติดกัน ยาว 9 อักขระ** ทุกจุด
// interpolate จาก BRAND_NAME เพื่อไม่ให้ค้างเป็นชื่อแบรนด์ก่อนหน้าตอนรีแบรนด์รอบ
// ถัดไป **ห้ามพิมพ์ชื่อแบรนด์เป็น literal**
//
// ⚠️ route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ตรวจหวย · /แนวทาง · /ทดลองเล่น · /about-us · /contact-us · /terms · /privacy ·
// /line — **รอบนี้ /ตรวจหวย และ /แนวทาง เปิดอยู่** (แบรนด์หวย) ลิงก์ไปได้
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกม ชื่อผู้ให้บริการ หน่วยงานกำกับ เลขใบอนุญาต
// ปีก่อตั้ง จำนวนสมาชิก ค่า RTP ยอดขั้นต่ำ หรือเปอร์เซ็นต์คืนยอดเสีย/แนะนำเพื่อน
// แม้แต่รายการเดียว** จึงห้ามเขียนลงหน้าเว็บ · ตัวเลขที่ขึ้นหน้าได้มีแค่ของบรีฟเอง:
// **100 · 1,000 · 2 ตัว · 3 ตัว · 3 ขั้นตอน · 24ชม.**
//
// 🚨 **บรีฟรอบนี้โฆษณาแล้วกำกับตัวเองในย่อหน้าเดียวกันแทบทุกย่อหน้า** — ทั้งสอง
// ครึ่งต้อง ship ครบ ประโยคกำกับไม่ใช่ filler ให้ตัดทิ้ง:
// 1) คำกล่าวอ้างว่าเป็นเว็บแม่จำเป็นต้องมีหลักฐานที่ตรวจสอบได้
//    (บรีฟบรรทัด 4 — รับที่ h1 และ h2 #2)
// 2) ความรวดเร็วในการโอนอาจขึ้นอยู่กับสถานะระบบและผู้ให้บริการชำระเงิน
//    (บรีฟบรรทัด 6 — รับที่ h2 #1)
// 3) ควรตรวจสอบฐานเงินเดิมพันที่ใช้คำนวณอัตราจ่าย และประเภทหวยที่ใช้อัตรานั้น
//    (บรีฟบรรทัด 8, 10 — รับที่ h2 #4)
// 4) **ผลการออกรางวัลมีความไม่แน่นอนและไม่สามารถรับประกันได้จากสถิติหรือเลขย้อนหลัง**
//    (บรีฟบรรทัด 12 — รับที่ h2 #4)
// 5) ควรตรวจสอบข้อกำหนดด้านอายุ กฎหมายที่เกี่ยวข้อง และนโยบายความเป็นส่วนตัว ·
//    ไม่ควรเปิดเผยรหัสผ่านและรหัส OTP (บรีฟบรรทัด 14, 18 — รับที่ h2 #3)
// 6) ควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการเพื่อหลีกเลี่ยงบัญชีแอบอ้าง ·
//    เก็บหมายเลขรายการและหลักฐานไว้ · ตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุด
//    (บรีฟบรรทัด 22 — รับที่ h2 #5)
//
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) **กลับทิศ 180° จากรอบก่อน: รอบนี้เนื้อหาสว่าง**
// bg.json ของดรอปนี้คือ {"mode":"color","color":"#e1fef3"} = **เขียวมินต์จางเกือบขาว**
// (รอบก่อนเป็นดำอมเลือดหมู ซึ่งอยู่คนละปลายของสเกล — เปิด bg.json อ่านทุกรอบ
// ห้ามสืบทอด) **ห้าม "แก้" การ์ด/ปุ่มกลับไปเป็นผิวเข้ม** — ผิวเข้มบนหมึก
// #0d3326 = ตัวอักษรหายไปเลย ไม่ใช่แค่จางลง
// ค่าที่ใช้ได้ในไฟล์นี้: `<strong>`/marker/ลิงก์ **#046c4e** (6.7:1 บนการ์ด #ffffff) ·
// เนื้อความ #0d3326 (13.8:1) · หมึกรอง #3f6f5c (6.0:1) · ทองเข้ม #8a6508 (5.4:1) ·
// พื้นไล่เฉดปุ่มหลัก #0c7c58 -> #046c4e -> #03543c (**พื้นถม** + หมึกขาว #ffffff —
// 5.2 / 6.7 / 9.2:1 ต่อ stop) · ปุ่มรองเป็นผิว #d2f3e4 หมึก #046c4e ขอบ #19a97c ·
// ปุ่ม outline ขอบ #19a97c ตัวอักษร #046c4e บนผิว #ffffff hover ยกเป็น #f0fdf7 ·
// ชั้นยก/ชิป #d2f3e4 · เส้นบาง #a3ddc3 · ขอบตกแต่ง/ออรา #19a97c · ออราสว่าง #2fd49b
// (**สี่ค่าท้ายห้ามถือตัวอักษร**)
// หมึกเนื้อความคือ #0d3326 (= BRAND_TEXT) ซึ่ง **ไม่ประกาศในไฟล์นี้** การ์ด
// ContentBox ตั้งไว้ให้แล้วและย่อหน้าสืบทอดลงมา
// 🚨🚨 **#a3ddc3 · #d2f3e4 · #19a97c · #2fd49b — ห้ามเป็นสีตัวอักษร** เป็นเส้น/ขอบ/
// ออรา/พื้นถมเท่านั้น · **#e2b32a ได้แค่ 2.0:1 บนการ์ดขาว ห้ามถือตัวอักษรเช่นกัน**
// บนการ์ดสว่างให้ใช้ #8a6508 แทนเมื่อต้องการโทนทอง
// และ **ห้ามใช้หมึกเข้ม #0d3326 บนไล่เฉดปุ่มหลัก** (ตกทุก stop) ปุ่มหลักใช้หมึกขาว
// **ห้ามดันปลายอ่อนของไล่เฉดขึ้นไปถึง #19a97c** (ขาวบนค่านั้นเหลือ 3.0:1)
// ออราที่อนุญาต: rgba(4,108,78,α) · rgba(25,169,124,α) · rgba(47,212,155,α) ·
// rgba(226,179,42,α) · rgba(13,51,38,α) · rgba(5,46,34,α)
// ⚠️⚠️ **เงาบนการ์ดสว่างต้องเบา** — ค่า alpha ของรอบก่อน (0.45-0.55) ถูกสำหรับ
// การ์ดเข้ม แต่บนผิวขาวจะกลายเป็นคราบเทาหนา **ห้ามลอก alpha ของรอบก่อนมา**
// 🚨🚨 **ส้มเพลิง-ทองอำพันบนดำคือฮิวของรอบก่อน รอบนี้กลับทิศเป็นเขียวมรกตบนผิวสว่าง**
// ที่ห้ามคือ **ค่าเฮกซ์ของแบรนด์เก่าแบบตรงหกหลัก** ไม่ใช่ "สีเขียว" ในฐานะตระกูลสี
// เพราะมีแบรนด์เขียวมาแล้วหลายเจ้า (สาธุ168 เขียวมรกต/ทอง · TEVA69 · ZORO365)
// ต้องเทียบ **ทีละค่า** กับตาราง brand-spec §2 (คู่ที่พิมพ์ผิดง่ายสุดลิสต์ไว้ในนั้น
// แล้ว และเขียนแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep สะดุด)
// ค่าของ WIN8S รอบก่อนทันทีที่ต้องไม่หลงเหลือ เขียนแบบไม่มี #:
//  1e0101 2a0a04 3b130b 5a2410 8a3a12 250604 140302 f27a1a e8620e f0a21e e5a92b
//  c9d2dc fdf0e6 e0bda4
// และค่าของตระกูล Huay (เจ้าของเดิมของคอมโพเนนต์ที่หมุนเข้ามารอบนี้ แดง/ทอง):
//  8a0412 b00718 c1071b a30d1a dde1e7 ffd94a e3a712 d4922c
// ⚠️ ข้อยกเว้นสีเชิงความหมาย: **LINE green #00B900** บนปุ่ม LINE (ต้องเป็นพื้นถม
// ของค่านั้น + ตัวอักษรขาว) **ห้ามกลืนเข้าเขียวมรกตของพาเลตรอบนี้ และห้ามเอามาใช้
// เป็นสีแบรนด์** — รอบนี้สับสนง่ายที่สุดเพราะแบรนด์ก็เป็นเขียว
// ⚠️ ชุดไทยเขียวมรกต/ทองครีม เครื่องประดับทองฝังพลอยเขียว ยอดปรางค์ทอง
// ดอกลีลาวดีขาว ลูกบอลหวยเขียว-ขาว ใบโคลเวอร์สี่แฉก และสีผิวนางแบบในอาร์ตเวิร์ก
// เป็น **วัตถุในภาพ ไม่ใช่สี UI** · และ **เวิร์ดมาร์กโครเมียมเงิน-เขียวมรกตก็เป็น
// อาร์ตเวิร์ก ไม่ใช่สี UI**
//
// ลำดับปุ่มในไฟล์นี้สื่อด้วยพื้นถมสามขั้ว (ตรงกับคู่ปุ่มที่ล็อกไว้ใน brand-spec §2):
// · ปุ่มหลัก (สมัครสมาชิก) ไล่เฉด #0c7c58 -> #046c4e -> #03543c หมึกขาว #ffffff
// · ปุ่มรอง (เข้าสู่ระบบ) ผิว #d2f3e4 หมึก #046c4e ขอบ #19a97c
// · ปุ่มลิงก์ภายในเป็นปุ่ม outline ขอบ #19a97c ตัวอักษร #046c4e บนผิว #ffffff
//   hover ยกพื้นขึ้นเป็นการ์ดสำรอง #f0fdf7
// · ชิปไอคอนของรายการใช้ขอบ #a3ddc3 บนพื้นถมอ่อน #d2f3e4 ไม่ถือตัวอักษร
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง และไม่ใส่ mx-auto / max-w-* บน <p>
// เพราะการ์ดคุมความกว้างเองแล้ว — ที่ประกาศสีได้มีแค่ปุ่ม ชิปไอคอน marker ของ
// ลำดับเลข และ <strong> · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง
// เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำ
// จะขาดครึ่ง (ลบแท็ก <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิม) และห้ามวาง
// <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังใน prop ที่เป็นข้อความ และต้องเป็นไอคอนหมวดหวยของรอบนี้ ไม่ใช่ไอคอน
// ไพ่/ชิป/วงล้อของรอบก่อน
// slot ของ ContentBox รับ **หนึ่ง element** เท่านั้น จึงห่อด้วย <div> ชั้นเดียว
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: รูปของดรอปนี้ถูกตรึงไว้ที่อื่นครบทุกไฟล์ —
// สไลด์สองใบของดรอปถูกตรึงไว้กับ index และ /promotion · banner1 /
// banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// แบนเนอร์ใบที่สองและสาม (2026-10-23) กับสไลด์ใบที่สามและสี่ (2026-09-29)
// เป็นอาร์ตเวิร์กของแบรนด์อื่น **ห้าม import ทั้งสี่ไฟล์**
// (ชื่อไฟล์เต็มอยู่ใน brand-spec §6) (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง
// dist/ และ verify-build จะแดง) — ไฟล์ทั้งหมดยังอยู่บนดิสก์ **ห้ามลบ**
// เป็นอินเวนทอรีของแบรนด์ถัดไป
//
// Announcement รอบนี้หมุนมาเป็นตัวท้ายชื่อหวย ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ตัวท้ายชื่อพรีเมียมจึงหมุนออก · เขียนชื่อ variant แบบไม่มีเครื่องหมายคำพูด
// โดยตั้งใจ เพราะ tools/gen-tw-sources.mjs นับ literal ที่มีเครื่องหมายคำพูดว่าเป็น
// การ import จริง) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์
// นี้แล้ว จึงเรียกแบบ bare **ห้ามส่ง prop message** มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกัน
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -c บนเชลล์นี้
// ก็นับเป็นไบต์ ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับตัวนับ
// ของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 156 อักขระ (ชื่อแบรนด์รอบนี้ 9 อักขระ) เป็นประโยคเดียวที่บอกว่า
// หน้านี้มีอะไร แล้วหยุด **ต้องนับใหม่ทุกรอบ** ห้ามสืบทอดความยาว
// (Google ตัดราว 160 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนๆ ยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} หวยพลัสลอตโต้ หน้ารวมข้อมูลหวยรัฐบาลไทย หวยลาว หวยฮานอย หวยหุ้น อัตราจ่าย 2 ตัว 3 ตัว ระบบสมาชิก และสิ่งที่ควรตรวจสอบเองก่อนใช้บริการ`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} หวยพลัสลอตโต้ แหล่งข้อมูลแทงหวยออนไลน์`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

// คลาสปุ่มสามขั้วของหน้านี้ ประกาศครั้งเดียวแล้วใช้ซ้ำ เพื่อไม่ให้สองปุ่มที่ทำ
// หน้าที่เดียวกันหลุดไปคนละเฉดตอนรีแบรนด์รอบหน้า
const ctaPrimary =
  "flex items-center justify-center rounded-full border border-[#19a97c] bg-gradient-to-b from-[#0c7c58] via-[#046c4e] to-[#03543c] px-8 py-3 font-black text-[#ffffff] shadow-[0_6px_18px_rgba(4,108,78,0.28)] transition-transform hover:scale-105";

const ctaSecondary =
  "flex items-center justify-center rounded-full border border-[#19a97c] bg-[#d2f3e4] px-8 py-3 font-bold text-[#046c4e] shadow-[0_6px_18px_rgba(13,51,38,0.10)] transition-transform hover:scale-105";

const ctaQuiet =
  "flex items-center justify-center rounded-full border-2 border-[#19a97c] bg-[#ffffff] px-8 py-3 font-bold text-[#046c4e] shadow-[0_4px_14px_rgba(13,51,38,0.10)] transition-all hover:scale-105 hover:bg-[#f0fdf7] hover:shadow-[0_6px_18px_rgba(4,108,78,0.18)]";

const listChip = "mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#a3ddc3] bg-[#d2f3e4] text-sm";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#046c4e]">
          {BRAND_NAME} หวยพลัสลอตโต้ นำเสนอข้อมูลหวยออนไลน์หลากหลายประเภท ทั้งหวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยหุ้นต่างประเทศ พร้อมรายละเอียดอัตราจ่ายและรอบประกาศผลที่แตกต่างกัน
        </strong>
        หน้านี้สรุปไว้ว่าเว็บไซต์ระบุอะไรไว้บ้าง และควรเปิดอ่านรายละเอียดส่วนไหนก่อน เพื่อให้เห็นภาพรวมก่อนไล่อ่านเงื่อนไขของหวยแต่ละประเภทเป็นรายข้อ
      </p>

      <p>
        ผู้ใช้งานสามารถศึกษารูปแบบการเดิมพัน ตรวจสอบหมายเลข และติดตามข้อมูลผลรางวัลได้ผ่านเว็บไซต์ โดยควรตรวจสอบความถูกต้องของช่องทางเข้าใช้งาน รวมถึงข้อมูลผู้ให้บริการก่อนทำรายการ
        <strong class="text-[#046c4e]">เพราะคำกล่าวอ้างว่าเป็นเว็บแม่จำเป็นต้องมีหลักฐานที่ตรวจสอบได้</strong>
      </p>

      <p>
        เนื้อหาในหน้านี้จึงเขียนไว้ประกอบการใช้งานเท่านั้น ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้บริการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`หวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยหุ้น สี่ประเภทที่ ${BRAND_NAME} รวบรวมไว้`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#046c4e]">
          {BRAND_NAME} รวบรวมข้อมูลหวยหลายประเภทไว้ในแพลตฟอร์มเดียว โดยแต่ละรายการมีรอบปิดรับและเวลาออกผลแตกต่างกัน
        </strong>
        รายการด้านล่างคือประเภทที่เว็บไซต์ระบุไว้ และเป็นจุดเริ่มต้นสำหรับคนที่ยังไม่แน่ใจว่าควรเปิดอ่านเงื่อนไขของรายการไหนก่อน
      </p>

      <ul class="flex flex-col gap-4" aria-label="ประเภทหวยที่เว็บไซต์ระบุไว้">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🇹🇭</span>
          <span>
            <strong class="text-[#046c4e]">หวยรัฐบาลไทย</strong> อ้างอิงผลสลากกินแบ่งรัฐบาล จึงมีรอบประกาศผลตามปฏิทินของงวดนั้น ก่อนยืนยันบิลควรตรวจสอบรอบปิดรับของเว็บไซต์ ซึ่งไม่จำเป็นต้องตรงกับเวลาประกาศผล
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎫</span>
          <span>
            <strong class="text-[#046c4e]">หวยลาว</strong> มีรอบปิดรับและเวลาออกผลเป็นของตัวเอง จึงควรดูตารางรอบของรายการนี้แยกจากหวยรัฐบาลไทย ไม่ใช่เทียบเอาจากรายการที่คุ้นเคยอยู่แล้ว
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🏮</span>
          <span>
            <strong class="text-[#046c4e]">หวยฮานอย</strong> เป็นอีกรายการที่กำหนดรอบปิดรับและรอบประกาศผลไว้ของตัวเอง และอาจมีข้อกำหนดเรื่องเลขอั้นและวงเงินเดิมพันต่างจากรายการอื่นในหน้าเดียวกัน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📈</span>
          <span>
            <strong class="text-[#046c4e]">หวยหุ้น</strong> อ้างอิงดัชนีตลาดหลักทรัพย์ รอบของรายการนี้จึงผูกกับเวลาทำการของตลาดที่อ้างอิง และควรตรวจสอบว่าใช้ตัวเลขช่วงใดเป็นผลก่อนยืนยันบิล
          </span>
        </li>
      </ul>

      <p>
        เว็บไซต์ระบุว่ามีอัตราจ่ายสูงและระบบโอนเงินรวดเร็ว อย่างไรก็ตาม
        <strong class="text-[#046c4e]">
          ควรตรวจสอบตารางอัตราจ่าย วงเงินรับรางวัล และเงื่อนไขการถอนเงินให้ครบถ้วน เพราะความรวดเร็วในการโอนอาจขึ้นอยู่กับสถานะระบบและผู้ให้บริการชำระเงิน
        </strong>
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/ตรวจหวย" aria-label={`เปิดหน้าตรวจหวยของ ${BRAND_NAME}`} class={ctaQuiet}>ไปหน้าตรวจหวย</a>

        <a href="/ทดลองเล่น" aria-label={`เปิดหน้าทดลองเล่นของ ${BRAND_NAME}`} class={ctaQuiet}>ไปหน้าทดลองเล่น</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="สิ่งที่ควรตรวจสอบเองก่อนเชื่อคำกล่าวอ้างว่าเป็นทางเข้าเว็บแม่" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        เว็บไซต์อธิบายตัวเองไว้ว่าเป็นทางเข้าเว็บแม่สำหรับแทงหวยออนไลน์ ซึ่งเป็นถ้อยคำของเว็บไซต์เอง ไม่ใช่ข้อสรุปของหน้านี้ หัวข้อนี้จึงแยกให้ชัดระหว่างสิ่งที่เว็บไซต์ระบุไว้
        กับสิ่งที่ผู้ใช้งานตรวจสอบเองได้จากหน้ารายละเอียดจริง
      </p>

      <ul class="flex flex-col gap-4" aria-label="สิ่งที่ควรตรวจสอบด้วยตัวเองก่อนใช้งาน">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🔎</span>
          <span>
            <strong class="text-[#046c4e]">ความถูกต้องของช่องทางเข้าใช้งาน</strong> ควรตรวจสอบก่อนทำรายการทุกครั้ง เพราะคำกล่าวอ้างว่าเป็นเว็บแม่จำเป็นต้องมีหลักฐานที่ตรวจสอบได้
            ไม่ใช่ยืนยันจากข้อความบนหน้าเว็บอย่างเดียว
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🏢</span>
          <span>
            <strong class="text-[#046c4e]">ข้อมูลผู้ให้บริการที่อยู่เบื้องหลังเว็บไซต์</strong> ควรอ่านให้ครบก่อนเปิดบัญชี พร้อมกับนโยบายความเป็นส่วนตัวและข้อกำหนดการใช้บริการที่เว็บไซต์แสดงไว้
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📄</span>
          <span>
            <strong class="text-[#046c4e]">ตารางอัตราจ่าย วงเงินรับรางวัล และเงื่อนไขการถอนเงิน</strong> ควรดูจากหน้ารายละเอียดในขณะใช้บริการ แทนที่จะอ่านจากข้อความสรุปที่เขียนไว้ล่วงหน้า
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#046c4e]">หน้านี้จึงชี้ว่าควรอ่านอะไรและเปิดดูจากที่ไหน แทนที่จะยืนยันแทนเว็บไซต์</strong>
        เพราะสิ่งที่ยืนยันได้จริงคือเอกสารและเงื่อนไขที่แสดงอยู่บนหน้ารายละเอียดในขณะใช้บริการ ไม่ใช่ข้อความสรุปที่เขียนไว้ล่วงหน้า
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`ระบบสมาชิกของ ${BRAND_NAME} และการสมัคร 3 ขั้นตอน`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#046c4e]">
          {BRAND_NAME} ระบุช่องทางสมัครสมาชิกผ่านโทรศัพท์มือถือและอุปกรณ์ที่เชื่อมต่ออินเทอร์เน็ต โดยมีขั้นตอนลงทะเบียน 3 ขั้นตอน
        </strong>
        ก่อนดำเนินการควรตรวจสอบขั้นตอนลงทะเบียน ข้อกำหนดด้านอายุ กฎหมายที่เกี่ยวข้อง และนโยบายความเป็นส่วนตัว เพื่อให้เข้าใจเงื่อนไขการใช้บริการและการจัดเก็บข้อมูลส่วนบุคคล
      </p>

      <ol class="ml-6 list-decimal space-y-3 marker:font-black marker:text-[#046c4e]">
        <li>
          <strong class="text-[#046c4e]">เข้าสู่หน้าสมัครสมาชิก</strong> เปิดเว็บไซต์ผ่านเบราว์เซอร์บนมือถือ ตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง จากนั้นเลือกเมนูสมัครสมาชิกและอ่านข้อกำหนดการเปิดบัญชี
          รวมถึงนโยบายการจัดเก็บข้อมูลส่วนบุคคลก่อนดำเนินการ
        </li>
        <li>
          <strong class="text-[#046c4e]">กรอกข้อมูลและยืนยันบัญชี</strong> กรอกข้อมูลตามที่เว็บไซต์กำหนด ตรวจสอบความถูกต้องก่อนยืนยัน และตั้งรหัสผ่านที่คาดเดาได้ยาก ไม่ควรใช้ข้อมูลของบุคคลอื่นหรือเปิดเผยรหัสผ่านและรหัส
          OTP ให้ใครทราบ
        </li>
        <li>
          <strong class="text-[#046c4e]">เข้าสู่ระบบและตรวจสอบประเภทหวย</strong> หลังลงทะเบียนเรียบร้อย สามารถศึกษารายการหวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยหุ้น พร้อมตรวจสอบอัตราจ่ายและรอบปิดรับของแต่ละประเภท
          หากมีข้อสงสัยเกี่ยวกับระบบสมาชิกควรสอบถามเจ้าหน้าที่ผ่านช่องทางทางการก่อนทำรายการ
        </li>
      </ol>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/register" aria-label={`สมัครสมาชิก ${BRAND_NAME}`} class={ctaPrimary}>สมัครสมาชิก</a>

        <a href="/login" aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`} class={ctaSecondary}>เข้าสู่ระบบ</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="อัตราจ่าย 2 ตัว 100 และ 3 ตัว 1,000 กับสิ่งที่ควรอ่านก่อนยืนยันบิล" as="h2">
    <div class="flex flex-col gap-5">
      <p>
        เว็บไซต์ระบุอัตราจ่ายหวยออนไลน์สำหรับหมายเลข 2 ตัวและ 3 ตัว โดยมีข้อมูล
        <strong class="text-[#046c4e]">อัตราจ่าย 2 ตัว 100 และ 3 ตัว 1,000</strong>
        ซึ่งเป็นรายละเอียดสำคัญสำหรับผู้ที่ต้องการเปรียบเทียบรูปแบบการเดิมพัน ก่อนทำรายการควรตรวจสอบว่าอัตราดังกล่าวคำนวณจากเงินเดิมพันจำนวนเท่าใด และใช้กับหวยประเภทใดบ้าง
