---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login, /register,
// /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx
// ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึง
// เขียนขึ้นใหม่บนข้อเท็จจริงของบรีฟรอบนี้เท่านั้น (src/assets/content.txt)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x4 · h3x0
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) จึงเปิดใช้งานอยู่ และรอบนี้ brand-spec §1
// สั่งให้คงไว้ ไม่ได้ park ลง src/pages-disabled/
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// ตัวที่ routing จริงคือไฟล์นี้ Astro ไม่อ่านโฟลเดอร์นั้นเลย ห้ามแก้และห้ามลบ
//
// ⚠️ ดรอปนี้ (2026-10-13, TKB55) คือ **คาสิโน + กีฬา: บาคาร่า · ไฮโล · บอล ·
// สล็อต** ไม่ใช่เว็บสล็อตล้วน ไม่ใช่เว็บกีฬาล้วน และไม่ใช่เว็บหมวดลอตเตอรี
// (สองหน้าของหมวดนั้นจอดอยู่ใน src/pages-disabled/ ไม่มี route ห้ามลิงก์ไปหา
// เป็น href ตายที่ทำให้ build แดง) หน้าเดิมทั้งหน้าเขียนบนกรอบของแบรนด์ก่อน
// (TSDET911) ซึ่งอ้าง "ลิขสิทธิ์ไทยแท้ / เซิร์ฟเวอร์ในประเทศไทย 100%" —
// บรีฟรอบนี้กลับขั้วเป็น **เซิร์ฟเวอร์ต่างประเทศ** จึงเขียนใหม่ทั้งหน้า ไม่ใช่
// find-and-replace ทับประโยคเดิม คำที่ brand-spec §7 ห้ามไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาคำต้องห้ามเจอ false positive
//
// แง่มุมที่บรีฟรอบนี้ระบุไว้มีเท่านี้ (ห้ามเติมอย่างอื่น): เว็บคาสิโนไทย ·
// ระบบเดิมพันออนไลน์ผ่านแพลตฟอร์มเดียว · รวมเกมคาสิโนและกีฬาหลายประเภท ทั้งบาคาร่า
// ไฮโล บอล และสล็อต · รองรับการใช้งานผ่านมือถือและคอมพิวเตอร์ · ค้นหาเกม
// ตรวจสอบเครดิต และติดตามรายการต่างๆ · ใช้เซิร์ฟเวอร์ต่างประเทศเพื่อรองรับการเข้า
// ใช้งาน · บาคาร่าเป็นเกมไพ่ที่มีตัวเลือกการเดิมพันตามกติกา · ไฮโลใช้ผลจากลูกเต๋า
// ในการตัดสิน · บอลออนไลน์มีรายการแข่งขันและอัตราต่อรอง · สล็อตมีทั้งเกมวงล้อทั่วไป
// ฟรีสปิน และฟีเจอร์โบนัส · บัญชีเดียว · กติกา ตารางจ่าย ยอดเดิมพันขั้นต่ำ
// วิธีตัดสินผล · คืนยอดเสีย 0.3% เข้ายูสทุกวัน · รอบประจำวัน เวลาตัดยอด
// ยอดที่เข้าเกณฑ์ · แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด · ลิงก์แนะนำ · ฝากถอน
// ทุกธนาคาร · ยอดเข้าบริษัทโดยตรง · ชื่อนิติบุคคล · ชื่อบัญชีรับเงิน ·
// หลักฐานธุรกรรม · แอดมิน 24 ชั่วโมง ช่องทางหลัก · ชื่อเกม ค่าย เวลาที่เกิดเหตุ ·
// ชื่อคู่แข่งขัน หมายเลขรายการ · รหัสผ่าน · PIN · OTP
//
// ตัวเลขที่อ้างได้มีสามตัวของบรีฟเอง: 0.3% · 0.8% · 24 ชั่วโมง ห้ามเติมเลข
// ใบอนุญาต หน่วยงานกำกับ ชื่อนิติบุคคลจริง ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP
// ยอดฝากขั้นต่ำเป็นตัวเลข จำนวนสมาชิก ปีที่ก่อตั้ง หรือตำแหน่งเซิร์ฟเวอร์ที่
// เจาะจงกว่าคำว่า "ต่างประเทศ"
//
// ประโยคกำกับ (hedge) ที่บรีฟเขียนไว้เองและห้ามตัดทิ้งเพราะฟังดูไม่ขายของ — ขนมาครบ:
// ส่วนความปลอดภัยและตำแหน่งเซิร์ฟเวอร์จริงควรมีข้อมูลทางเทคนิคและรายละเอียดผู้ให้
// บริการที่สามารถตรวจสอบได้ประกอบ (h1 ย่อหน้าท้าย) · ไม่มีเกมใดรับประกันว่าจะได้รับ
// กำไรทุกครั้ง (h2 #1 ย่อหน้าท้าย) · ควรตรวจสอบว่าโปรโมชั่นครอบคลุมบาคาร่า ไฮโล
// บอล หรือสล็อตประเภทใดบ้าง (h2 #2 ย่อหน้า 1) · ควรอ่านรายละเอียดประเภทเกม
// ที่ร่วมรายการ เวลาตัดยอด และเงื่อนไขการใช้โบนัสก่อนรับทุกครั้ง (h2 #2 รายการแรก) ·
// ส่วนคำว่าไม่จำกัดควรระบุให้ชัด (h2 #2 รายการที่สอง) · ควรแสดงชื่อนิติบุคคลที่
// สามารถตรวจสอบได้ และการโอนเงินเข้าบัญชีบริษัทไม่ได้รับประกันความปลอดภัยทั้งหมด
// (h2 #3) · ไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น (h2 #4 ย่อหน้าท้าย)
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **แดงเลือดนกนำ เงินโครเมียมรอง บนดำสนิท**
// พลิกออกจากชุดน้ำเงินไฟฟ้า-เงินโครเมียมบนกรมเกือบดำของรอบก่อน (ค่าเดิมอยู่ใน
// brand-spec §2 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive)
// พื้นเพจเป็นดำสนิท #000000 (bg.json) จึงไม่มีชั้นที่ลึกกว่าพื้นเพจได้จริง
// ลำดับความลึก: #2a0d0f ผิวยก (= การ์ด) / #1a0708 กลาง / #0d0304 จมสุด / #000000 พื้น
//
// ลำดับปุ่มสื่อด้วย "แดงถม vs ผิวจมขอบแดง" — คู่พื้น-หมึกคำนวณไว้แล้ว:
// · ปุ่มหลัก (สมัครสมาชิก) ถมแดงไล่ #ff8a8f → #fb131b ขอบ #c40304 หมึก #1a0304
//   (8.7:1 บนปลายสว่าง และ 4.9:1 บนปลายเข้ม) ⚠️ ไล่เฉดต้องหยุดที่ #fb131b
//   ห้ามไล่ลงไปเข้มกว่านั้นใต้ตัวอักษร (#c40304 ได้ 2.6:1 · #8a0206 ได้ 1.6:1)
// · ปุ่มรอง/ปุ่มลิงก์ภายในเป็นชั้นจม #1a0708 → #0d0304 ขอบ #fb131b/55
//   ตัวอักษร #f2e4e5 — hover ยกขอบเป็นแดงสว่าง #ff4d55
// · #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้
// ⚠️ #fb131b · #c40304 · #8a0206 · #53050a ห้ามถือตัวอักษรทุกขนาด ใช้ได้
// แค่เส้นขอบ ออรา เงา และพื้นถม — ออราในไฟล์นี้ใช้ rgba(251,19,27,α) เท่านั้น
// ⚠️ กับดักรอบนี้คือ **แดง**: โค้ดเบสนี้เคยมีแบรนด์แดงมาแล้วหลายเจ้า "มีแดงอยู่"
// จึงไม่ใช่ตัวบอกว่าถูกแบรนด์ ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน brand-spec §2
// ไม่ใช่เทียบด้วยตาหรือด้วยตระกูลสี และรอบนี้ไม่มีทอง ไม่มีม่วง ไม่มีชมพู
// ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว ไม่มีส้ม
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #f2e4e5,
// 14.5:1 บนผิวยก #2a0d0f) ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง
// ปล่อยให้สืบทอดลงมา และไม่ใส่ mx-auto / max-w-* บน <p> เพราะการ์ดคุมความกว้างเองแล้ว
// — ที่ประกาศสีได้มีแค่ปุ่ม (ถมพื้นของตัวเองจึงต้องกำหนดหมึกของตัวเอง) และ <strong>
// ซึ่ง brand-spec §2 สงวน #ff8a8f (7.8:1 บนผิวการ์ด) ไว้เป็นสีไฮไลต์ในเนื้อความ
// โดยเฉพาะ และไม่ใช้สีอื่นเลย · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง
// เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาด
// ครึ่ง (ลบแท็ก <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิมเป๊ะ)
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้าง
// จากหน้า และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้หมุนมาเป็น Announcement5 ทั้งเว็บ (รอบก่อน TSDET911 ใช้
// Announcement3 — brand-spec §3 หมุนออก) orchestrator ตั้ง default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message
// มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 151
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} เว็บคาสิโนไทยเซิร์ฟต่างประเทศ รวมบาคาร่า ไฮโล บอล และสล็อตไว้ในบัญชีเดียว พร้อมคืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% และแอดมิน 24 ชั่วโมง`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} เว็บคาสิโนไทย รวมเกมคาสิโนและกีฬาไว้ในบัญชีเดียว`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#ff8a8f]">{BRAND_NAME} คือเว็บพนันคาสิโนไทยที่นำเสนอระบบเดิมพันออนไลน์ผ่านแพลตฟอร์มเดียว</strong>
        พร้อมรวมเกมคาสิโนและกีฬาไว้หลายประเภท ทั้งบาคาร่า ไฮโล บอล และสล็อต รองรับการใช้งานผ่านมือถือและคอมพิวเตอร์ ผู้ใช้งานจึงค้นหาประเภทเกมที่สนใจได้โดยไม่ต้องสลับหลายหน้าเว็บไซต์
      </p>

      <p>
        หน้านี้สรุปไว้ว่าภายในระบบมีอะไรให้ใช้งานบ้าง ตั้งแต่หมวดเกมที่จัดไว้ให้เลือก ไปจนถึงรายการโปรโมชั่น ระบบฝากถอน และช่องทางติดต่อแอดมิน
        <strong class="text-[#ff8a8f]">สมาชิกสามารถค้นหาเกม ตรวจสอบเครดิต และติดตามรายการต่างๆ ได้สะดวกผ่านบัญชีเดียว</strong>
        เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดดูอะไรตรงไหน แล้วจึงค่อยลงรายละเอียดของรายการที่สนใจเป็นรายรายการ
      </p>

      <p>
        โดยเว็บไซต์ระบุว่าใช้เซิร์ฟเวอร์ต่างประเทศเพื่อรองรับการเข้าใช้งาน
        <strong class="text-[#ff8a8f]">ส่วนความปลอดภัยและตำแหน่งเซิร์ฟเวอร์จริงควรมีข้อมูลทางเทคนิคและรายละเอียดผู้ให้บริการที่สามารถตรวจสอบได้ประกอบ</strong>
        เช่นเดียวกับชื่อโดเมนและช่องทางหลักที่ควรตรวจสอบให้ชัดเจนก่อนส่งข้อมูลส่วนตัว ข้อมูลในหน้านี้จึงเขียนไว้เพื่อบอกว่าระบบมีอะไรให้ใช้และควรตรวจอะไรก่อนตัดสินใจ
        ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้งาน
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`หมวดเกมที่ ${BRAND_NAME} รวมไว้ในแพลตฟอร์มเดียว`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        เว็บคาสิโน {BRAND_NAME} รวบรวมเกมเดิมพันหลายประเภทไว้ให้เลือกตามความสนใจ
        <strong class="text-[#ff8a8f]">การรวมหมวดเกมไว้ในระบบเดียวช่วยให้ค้นหาประเภทเกมและศึกษารายละเอียดได้สะดวกขึ้น</strong>
        ทั้งบนหน้าจอมือถือและคอมพิวเตอร์ ประเภทการเดิมพันที่เว็บไซต์ระบุไว้แบ่งออกได้ประมาณนี้
      </p>

      <ul class="flex flex-col gap-3" aria-label={`หมวดเกมเดิมพันบนแพลตฟอร์มของ ${BRAND_NAME}`}>
        <li class="flex gap-3">
          <span aria-hidden="true">🃏</span>
          <span>
