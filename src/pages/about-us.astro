---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char, so a byte count reads
// ~3x too long). One string, reused by MainLayout's meta and the WebPage node.
const pageDescription =
  "รู้จัก JUMBOBET เว็บพนันออนไลน์ครบวงจร รวมสล็อต บาคาร่า คาสิโนสด รูเล็ต เสือมังกร เกมไพ่ และหวยไว้ในบัญชีเดียว พร้อมคืนยอดเสีย 0.3% ฝากถอนอัตโนมัติ 24 ชม.";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ JUMBOBET เว็บพนันออนไลน์ รวมเกมทุกหมวดไว้ในบัญชีเดียว",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา JUMBOBET เว็บพนันออนไลน์ รวมเกมครบในบัญชีเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ JUMBOBET" as="h1">
    <p class="mb-6 text-left text-base leading-relaxed text-[#d5e8d0]">
      <strong class="text-[#6ef25a]">JUMBOBET</strong> คือเว็บพนันออนไลน์ที่เปิดให้สมาชิกเข้าเล่นผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ได้โดยตรง
      ภายในบัญชีเดียวมีเกมเดิมพันให้เลือกหลายประเภท ทั้ง <strong class="text-[#6ef25a]">สล็อต บาคาร่า คาสิโนสด รูเล็ต เสือมังกร เกมไพ่ และหวย</strong>
      พร้อมโปรโมชั่นคืนยอดเสีย 0.3% ตามเงื่อนไข ระบบฝากถอนอัตโนมัติช่วยให้สมาชิกจัดการธุรกรรมได้สะดวกตลอดทั้งวัน
      และสามารถสมัครสมาชิกเพื่อตรวจสอบโปรโมชั่นหรือเกมที่เปิดให้บริการได้ทุกวัน
    </p>

    <p class="mb-2 text-left text-base leading-relaxed text-[#d5e8d0]">
      สิ่งที่ JUMBOBET ให้ความสำคัญคือความชัดเจนของข้อมูล รายละเอียดของโบนัส ยอดที่นำมาคำนวณ และรอบการรับสิทธิ์จะแสดงอยู่ในระบบสมาชิกก่อนกดรับเสมอ
      สมาชิกควรอ่านเงื่อนไขตรงจุดนั้นทุกครั้ง เพราะข้อกำหนดของแต่ละโปรโมชั่นไม่เท่ากัน และมีทีมงานคอยให้คำแนะนำเมื่อพบปัญหาในการใช้งาน
    </p>
  </ContentBox>

  <ContentBoxPlain title="คาสิโน JUMBOBET รวมเกมพนันออนไลน์ครบวงจรในบัญชีเดียว" as="h2">
    <p class="mb-2 text-left text-base leading-relaxed text-[#d5e8d0]">
      สมาชิกสามารถเลือกเล่นเกมพนันออนไลน์ได้หลายหมวดหมู่ภายในบัญชีเดียว ทั้ง <strong class="text-[#6ef25a]">เกมสล็อต บาคาร่า คาสิโนสด รูเล็ต เสือมังกร เกมไพ่ หวย</strong>
      และการเดิมพันประเภทอื่น ๆ ระบบจัดหมวดหมู่เกมของ JUMBOBET ให้ค้นหาได้สะดวก พร้อมรองรับการเข้าใช้งานผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์
      ช่วยให้เลือกเกมที่สนใจได้โดยไม่ต้องสลับใช้งานหลายบัญชี และแนะนำให้อ่านกติกากับรายละเอียดของแต่ละเกมก่อนเริ่มเดิมพันทุกครั้ง
    </p>
  </ContentBoxPlain>

  <ContentBoxPlain title="โบนัสคืนยอดเสีย 0.3% และโปรโมชั่นสมาชิกของ JUMBOBET" as="h2">
    <p class="mb-2 text-left text-base leading-relaxed text-[#d5e8d0]">
      สมาชิกที่มียอดเสียตามข้อกำหนดสามารถตรวจสอบสิทธิ์รับ <strong class="text-[#6ef25a]">โบนัสคืนยอดเสีย 0.3% ไม่จำกัด</strong> ได้ตามรอบที่เว็บไซต์กำหนด
      โดยระบบจะแสดงยอดที่เข้าเงื่อนไขและรายละเอียดสำหรับกดรับโบนัสไว้ในบัญชีสมาชิก สมาชิกควรตรวจสอบประเภทเกมที่ร่วมรายการ รอบคำนวณ
      และเงื่อนไขการถอนก่อนรับสิทธิ์ทุกครั้ง เพื่อให้ทราบรายละเอียดของโปรโมชั่นอย่างครบถ้วน
    </p>

    <p class="mt-3 mb-2 text-left text-base leading-relaxed text-[#d5e8d0]">
      ผู้ใช้งานใหม่สามารถสมัครสมาชิก JUMBOBET ผ่านระบบออนไลน์ได้ทุกวัน หลังเปิดบัญชีเรียบร้อยแล้วสามารถเข้าสู่ระบบเพื่อตรวจสอบโปรโมชั่นสำหรับสมาชิกใหม่ที่กำลังเปิดให้รับ
      โดยโบนัสและสิทธิพิเศษจะแตกต่างกันตามเงื่อนไขของแต่ละรายการ สมาชิกควรอ่านรายละเอียดเกี่ยวกับยอดฝากขั้นต่ำ ยอดเทิร์น และเงื่อนไขการถอนให้ครบถ้วนก่อนกดรับโบนัส
    </p>
  </ContentBoxPlain>

  <ContentBoxPlain title="ระบบฝากถอนอัตโนมัติ และทีมงาน JUMBOBET ดูแลตลอด 24 ชั่วโมง" as="h2">
    <p class="mb-6 text-left text-base leading-relaxed text-[#d5e8d0]">
      <strong class="text-[#6ef25a]">ระบบฝากถอนอัตโนมัติของ JUMBOBET</strong> รองรับช่องทางการทำธุรกรรมตามที่เว็บไซต์เปิดให้บริการ สมาชิกฝากเครดิต ส่งคำขอถอน
      และตรวจสอบสถานะรายการได้ด้วยตนเองตลอด 24 ชั่วโมง โดยวงเงินและข้อกำหนดของแต่ละช่องทางให้ยึดข้อมูลที่แสดงในระบบ ณ เวลาทำรายการ
      หากเครดิตไม่เข้า ถอนเงินไม่ได้ หรือรายการล่าช้า ไม่ว่าจะเป็นปัญหาการสมัครสมาชิก การเข้าสู่ระบบ การรับโบนัสคืนยอดเสีย หรือการเข้าเล่นเกม มี
      <strong class="text-[#6ef25a]">ทีมงานดูแลตลอดทั้งวันทั้งคืน</strong> ให้ติดต่อเข้ามาช่วยตรวจสอบได้ทันที ทั้งนี้ การพนันมีความเสี่ยง
      ไม่มีระบบหรือเทคนิคใดรับประกันผลกำไร ผู้เล่นควรศึกษากติกาและกำหนดงบประมาณก่อนเดิมพันทุกครั้ง
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก JUMBOBET"
        class="flex items-center justify-center rounded-lg bg-gradient-to-r from-[#6ef25a] via-[#25cb0e] to-[#0b7a06] px-8 py-3 font-black text-[#031204] shadow-[0_0_15px_rgba(37,203,14,0.45)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ JUMBOBET"
        class="flex items-center justify-center rounded-lg border border-[#25cb0e]/70 bg-transparent px-8 py-3 font-bold text-[#d5e8d0] transition-all hover:scale-105 hover:border-[#6ef25a] hover:bg-[#031204]/70">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
