---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็น **บทความจริง** (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login,
// /register หรือหน้าภาพแบบ /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง
// ไม่ใช่เช็กลิสต์หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้
// (src/assets/content.txt) ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าใหม่จากข้อเท็จจริง
// และคลังคำของบรีฟรอบนี้เท่านั้น (.claude/brand-spec-mexicanoslot.md §4-§5)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x5 · h3x0
//   h1  เกี่ยวกับเรา <แบรนด์> สล็อตเมกซิกัน เดิมพันออนไลน์ เว็บแท้ที่นี่ที่เดียว
//   h2  รูปแบบเกมที่ <แบรนด์> นำเสนอ ทั้งสล็อตคลาสสิก เกมโบนัส และเกมฟีเจอร์พิเศษ
//   h2  <แบรนด์> การันตีเว็บตรง ยอดเข้าบริษัทไม่ผ่านเอเย่นต์ และสิ่งที่ควรตรวจสอบ
//   h2  โปรโมชั่น <แบรนด์> คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%
//   h2  สมัครสมาชิก <แบรนด์> ด้วยตัวเอง 3 ขั้นตอน
//   h2  แอดมินออนไลน์ตลอด 24ชม. และช่องทางติดต่อของ <แบรนด์>
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) และจาก footer จึงเปิดใช้งานอยู่
//
// มีสำเนาชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro (ของแบรนด์เก่ามาก)
// ตัวที่ routing จริงคือไฟล์นี้ Astro ไม่อ่านโฟลเดอร์นั้นเลย **ห้ามแก้ ห้ามลบ
// และห้ามสลับมาแทนไฟล์นี้**
//
// 🚨🚨 ดรอปนี้ (2026-10-24) ยังเป็น **เว็บสล็อต** เหมือนรอบก่อน แต่ **คนละคำนิยาม
// ตัวเอง** บรีฟรอบนี้เรียกตัวเองว่า "สล็อตเมกซิกัน เดิมพันออนไลน์ สดส่งตรงจาก
// เมกซิกัน เว็บแท้ที่นี่ที่เดียว" และระบุ การันตีเว็บตรง · ยอดเข้าบริษัทไม่ผ่าน
// เอเย่นต์ · สล็อตคลาสสิก เกมโบนัส เกมที่มีฟีเจอร์พิเศษ · โปรโมชั่นอัปเดตใหม่
// ตลอดสัปดาห์ · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · สมัครด้วยตัวเอง 3 ขั้นตอน ·
// แอดมินออนไลน์ตลอด 24ชม.
// ⚠️⚠️ คำนิยามตัวเองของแบรนด์ขาออกเป็น **คำค้างข้ามแบรนด์** ห้ามหลุดกลับมา
// **รายการคำต้องห้ามเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่** เพื่อไม่ให้
// sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// 🚨🚨 **บรีฟรอบนี้ไม่พูดถึงธนาคาร วอลเลท หรือการฝากถอนเลยแม้แต่คำเดียว** —
// รอบก่อนหน้านี้มีทั้งหัวข้อ "ระบบฝากถอน" และชื่อวอลเล็ตอยู่บนหน้านี้
// **ทั้งหมดถูกตัดออกรอบนี้ และห้ามเขียนกลับเข้ามา** ชื่อวอลเล็ตของแบรนด์ขาออก
// คือคำที่พลาดง่ายที่สุดของรอบนี้ (ค่าเต็มอยู่ใน brand-spec §5)
// ⚠️⚠️ ชื่อแบรนด์รอบนี้เป็น **ตัวละตินพิมพ์ใหญ่ล้วน** กลับทิศจากรอบก่อนที่เป็น
// พิมพ์เล็กล้วน (brand-spec §1) ทุกจุดยัง interpolate จาก BRAND_NAME เหมือนเดิม
// เพื่อไม่ให้ค้างเป็นชื่อแบรนด์ก่อนหน้าตอนรีแบรนด์รอบถัดไป
//
// ⚠️ **รอบนี้สองหน้าหมวดลอตเตอรีถูกปิด** (อยู่ใน src/pages-disabled/)
// **ห้ามลิงก์ไปสอง route นั้นจากหน้านี้** และห้ามใช้คำศัพท์หมวดลอตเตอรีเลย
// route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ทดลองเล่น · /about-us · /contact-us · /terms · /privacy · /line
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกมรายตัว ชื่อธนาคารรายตัว จำนวนเกม จำนวนค่าย
// ตัวเลข RTP อัตราจ่าย ชื่อผู้ให้บริการ หน่วยงานกำกับ เลขใบอนุญาต ปีก่อตั้ง
// จำนวนสมาชิก หรือยอดฝากขั้นต่ำที่เป็นตัวเลข แม้แต่รายการเดียว** จึงห้ามเขียน
// ลงหน้าเว็บ · ตัวเลขที่ขึ้นหน้าได้มีแค่ของบรีฟเอง:
// **0.3% · 0.8% · 3 ขั้นตอน · 24ชม.**
//
// 🚨 **บรีฟรอบนี้โฆษณาแล้วกำกับตัวเองในย่อหน้าเดียวกันแทบทุกย่อหน้า** — ทั้งสอง
// ครึ่งต้อง ship ครบ ประโยคกำกับไม่ใช่ filler ให้ตัดทิ้ง:
// 1) ข้อมูลเกี่ยวกับการส่งตรงจากเม็กซิโกควรตรวจสอบแหล่งที่มาของเกมและผู้ให้บริการ
//    ก่อนใช้งาน เพื่อให้เข้าใจรายละเอียดของแพลตฟอร์มอย่างถูกต้อง (h1)
// 2) ควรศึกษากติกาเกมและอัตราการจ่ายรางวัลจากหน้าเกมโดยตรง (h2 #1)
// 3) คำกล่าวอ้างว่าไม่ผ่านเอเย่นต์หรือยอดเงินเข้าบริษัทโดยตรง จำเป็นต้องมีข้อมูล
//    ที่ตรวจสอบได้ประกอบ (h2 #2)
// 4) เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่ม
//    โอกาสชนะในครั้งต่อไป · แม้ระบุว่าไม่จำกัด ควรยืนยันจำนวนบัญชีที่เข้าร่วมได้
//    และรอบจ่ายเครดิต (h2 #3)
// 5) ควรตรวจสอบคุณสมบัติผู้สมัคร ข้อกำหนดด้านอายุ กฎหมายที่เกี่ยวข้อง และนโยบาย
//    ความเป็นส่วนตัว · ไม่เปิดเผยรหัสผ่านและรหัส OTP ให้ใครทราบ (h2 #4)
// 6) ควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชี
//    แอบอ้าง · เก็บหมายเลขรายการและหลักฐานไว้ · ตรวจสอบเวลาการให้บริการจริงจาก
//    ประกาศล่าสุดอีกครั้ง (h2 #5)
//
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) **เนื้อหายังเป็นธีมสว่างเหมือนรอบก่อน แต่โครม
// กลับทิศเป็นผิวเข้ม และฮิวคนละตระกูลสิ้นเชิง** bg.json ของดรอปนี้คือ
// {"mode":"color","color":"#fef6fb"} = **ขาวอมชมพูจาง** (รอบก่อนเป็นชมพู
// บับเบิลกัมที่อิ่มกว่ามาก)
// **ห้าม "แก้" การ์ด/ปุ่มกลับไปเป็นพื้นมืด** — พื้นมืดบนหมึก #3f130d =
// ตัวอักษรหายไปเลย ไม่ใช่แค่จางลง
// ค่าที่ใช้ได้ในไฟล์นี้: หัวข้อ/`<strong>`/marker **#a81410** (7.6:1 บนการ์ดขาว) ·
// เข้มสุด #3f130d (14.9:1) · หมึกรอง #80453a (6.6:1) · เขียวเม็กซิกัน #117a41
// (5.4:1) · พื้นไล่เฉดปุ่มหลัก #c81e12 -> #9d140c -> #6f0e08 (**พื้นถม** + หมึกขาว
// #ffffff — 5.7 / 8.3 / 11.4:1 ต่อ stop) · ปุ่มรองเป็น #ffffff -> #fde4d3 คู่กับ
// หมึก #3f130d · ผิวยก #fff3ea · wash #fde4d3 · เส้น #f6c4a4 · เส้นเข้ม #e2855c
// (**ทั้งคู่ห้ามถือตัวอักษร**)
// หมึกเนื้อความคือ #3f130d (= BRAND_TEXT) ซึ่ง **ไม่ประกาศในไฟล์นี้** การ์ด
// ContentBox ตั้งไว้ให้แล้วและย่อหน้าสืบทอดลงมา
// 🚨🚨 **#de2b1e บนพื้นขาวได้แค่ 4.0:1 — ห้ามเป็นสีตัวอักษร** และ **ขาวบน #de2b1e
// ได้ 4.7:1 ซึ่งเฉียดเกินไป** ปุ่มหลักจึงเริ่มไล่เฉดที่ #c81e12 ไม่ใช่ #de2b1e
// 🚨🚨 **#f2543f และ #2bb061 เป็นสีของ "โครมเข้ม" เท่านั้น ห้ามหลุดเข้ามาในไฟล์นี้**
// (บนการ์ดขาวได้ 3.5:1 และ 2.9:1)
// ออราที่อนุญาต: rgba(222,43,30,α) · rgba(242,160,51,α) · rgba(168,20,16,α) ·
// rgba(63,19,13,α) · rgba(246,196,164,α) · rgba(254,215,181,α)
// ⚠️⚠️ **รอบนี้ไม่มีชมพู/แมเจนต้าเลยสักค่า** (ทั้งชุดคือพาเลตของแบรนด์ขาออก) ·
// ไม่มีฟ้า/ไซแอน/น้ำเงิน ไม่มีม่วง ไม่มีเทาเงิน ยกเว้น **LINE green #00B900**
// บนปุ่ม LINE ซึ่งเป็นสีประจำแพลตฟอร์ม (บนผิวขาวต้องเป็นพื้นถม bg-[#00B900] +
// ตัวอักษรขาว ไม่ใช่ตัวอักษรสีเขียว)
// ⚠️⚠️ **รอบนี้เป็นแบรนด์แดงจริง และแบรนด์เก่าอย่างน้อยหกเจ้าก็แดง จึงห้ามเทียบ
// ด้วยวงศ์สี** ต้องเทียบ **ทีละค่า** กับตาราง brand-spec §2
// เฮกซ์ของแบรนด์เก่าในคอมเมนต์เขียนแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep สะดุด
// ⚠️ ซอมเบรโรฟาง ปอนโชลายทอ กีตาร์ มาราคัส กระบองเพชร เหรียญทอง ฉากอะโดบีครีม
// และสีผิวนักแสดงในอาร์ตเวิร์กเป็น **วัตถุในภาพ ไม่ใช่สี UI** · และ **"SLOT"
// สีน้ำเงินไล่ฟ้าในเวิร์ดมาร์กก็เป็นอาร์ตเวิร์ก ไม่ใช่สี UI** — ฟ้าคือฮิวของ
// แบรนด์เมื่อสองรอบก่อน ห้ามดึงเข้ามาเด็ดขาด
//
// ลำดับปุ่มในไฟล์นี้สื่อด้วยพื้นถมสามขั้ว (ตรงกับคู่ปุ่มที่ล็อกไว้ใน brand-spec §2):
// · ปุ่มหลัก (สมัครสมาชิก) ไล่เฉด #c81e12 -> #9d140c -> #6f0e08 หมึกขาว #ffffff
// · ปุ่มรอง (เข้าสู่ระบบ) ไล่เฉดผิวสว่าง #ffffff -> #fde4d3 หมึกเอสเพรสโซ #3f130d
// · ปุ่มลิงก์ภายในเป็นปุ่ม outline ขอบ #a81410 ตัวอักษร #a81410 บนการ์ดขาว
//   hover ยกพื้นขึ้นเป็นผิวยก #fff3ea
// · ชิปไอคอนของรายการใช้ขอบ #f6c4a4 บน wash #fde4d3 ไม่ถือตัวอักษร
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง และไม่ใส่ mx-auto / max-w-* บน <p>
// เพราะการ์ดคุมความกว้างเองแล้ว — ที่ประกาศสีได้มีแค่ปุ่ม ชิปไอคอน marker ของ
// ลำดับเลข และ <strong> · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง
// เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำ
// จะขาดครึ่ง (ลบแท็ก <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิม) และห้ามวาง
// <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังใน prop ที่เป็นข้อความ และต้องเป็นไอคอนหมวดสล็อต ไม่ใช่ไอคอนหมวดลอตเตอรี
// slot ของ ContentBox รับ **หนึ่ง element** เท่านั้น จึงห่อด้วย <div> ชั้นเดียว
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: รูปของดรอปนี้ถูกตรึงไว้ที่อื่นครบทุกไฟล์ —
// slide1/slide2 ถูกตรึงไว้กับ index §4 ข้อ 4-5 กับ /promotion · banner1 /
// banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// banner2/banner3 และ slide3/slide4 เป็นอาร์ตเวิร์กของแบรนด์อื่น
// **ห้าม import ทั้งสี่ไฟล์** (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/
// และ verify-build จะแดง) — ไฟล์ทั้งหมดยังอยู่บนดิสก์ **ห้ามลบ** เป็นอินเวนทอรี
// ของแบรนด์ถัดไป · อาร์ตสต็อก gamedemo8/gamedemo16 ถูกตรึงไว้กับ /ทดลองเล่น
//
// Announcement รอบนี้หมุนมาเป็น Announcement5 ทั้งเว็บ (brand-spec §3 — รอบก่อนใช้
// Announcement3 จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้
// ของแบรนด์นี้แล้ว จึงเรียกแบบ bare **ห้ามส่ง prop message** มิฉะนั้นตัววิ่งจะพูด
// คนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -c บนเชลล์นี้
// ก็นับเป็นไบต์ ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับตัวนับ
// ของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 154 อักขระ (ชื่อแบรนด์รอบนี้ 12 อักขระ) เป็นประโยคเดียวที่บอกว่า
// หน้านี้มีอะไร แล้วหยุด
// (Google ตัดราว 160 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนๆ ยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} สล็อตเมกซิกัน รวมข้อมูลรูปแบบเกม การันตีเว็บตรง โปรโมชั่นคืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% และวิธีสมัครสมาชิกด้วยตัวเอง 3 ขั้นตอน`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} สล็อตเมกซิกัน เดิมพันออนไลน์ เว็บแท้ที่นี่ที่เดียว`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

// คลาสปุ่มสามขั้วของหน้านี้ ประกาศครั้งเดียวแล้วใช้ซ้ำ เพื่อไม่ให้สองปุ่มที่ทำ
// หน้าที่เดียวกันหลุดไปคนละเฉดตอนรีแบรนด์รอบหน้า
const ctaPrimary =
  "flex items-center justify-center rounded-full border border-[#6f0e08] bg-gradient-to-b from-[#c81e12] via-[#9d140c] to-[#6f0e08] px-8 py-3 font-black text-white shadow-[0_6px_18px_rgba(168,20,16,0.3)] transition-transform hover:scale-105";

const ctaSecondary =
  "flex items-center justify-center rounded-full border border-[#e2855c] bg-gradient-to-b from-[#ffffff] to-[#fde4d3] px-8 py-3 font-bold text-[#3f130d] shadow-[0_6px_18px_rgba(246,196,164,0.45)] transition-transform hover:scale-105";

const ctaQuiet =
  "flex items-center justify-center rounded-full border-2 border-[#a81410] bg-[#ffffff] px-8 py-3 font-bold text-[#a81410] shadow-[0_4px_14px_rgba(222,43,30,0.2)] transition-all hover:scale-105 hover:bg-[#fff3ea] hover:shadow-[0_6px_18px_rgba(168,20,16,0.2)]";

const listChip = "mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#f6c4a4] bg-[#fde4d3] text-sm";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#a81410]">{BRAND_NAME} นำเสนอเกมสล็อตออนไลน์ภายใต้คอนเซปต์สล็อตเมกซิกัน ที่เน้นบรรยากาศสนุกสนานและรูปแบบเกมหลากหลาย</strong>
        หน้านี้สรุปไว้ว่าเว็บไซต์ระบุอะไรไว้บ้าง และควรเปิดอ่านรายละเอียดส่วนไหนก่อน เพื่อให้เห็นภาพรวมก่อนไล่อ่านเงื่อนไขของแต่ละรายการเป็นรายข้อ
      </p>

      <p>
        ผู้ใช้งานสามารถศึกษารายละเอียดเกม กติกา และโปรโมชั่นผ่านเว็บไซต์ได้ในช่องทางเดียว
        <strong class="text-[#a81410]">โดยเฉพาะผู้ที่เพิ่งเริ่มต้นและต้องการทำความเข้าใจระบบก่อนใช้งาน</strong>
        เพราะข้อมูลแต่ละชุดถูกแยกไว้คนละหน้า และแต่ละชุดก็มีเงื่อนไขของตัวเองที่ไม่ได้เหมือนกันทั้งหมด
      </p>

      <p>
        <strong class="text-[#a81410]">ข้อมูลเกี่ยวกับการส่งตรงจากเม็กซิโกควรตรวจสอบแหล่งที่มาของเกมและผู้ให้บริการก่อนใช้งาน</strong>
        เพื่อให้เข้าใจรายละเอียดของแพลตฟอร์มอย่างถูกต้อง เนื้อหาในหน้านี้จึงเขียนไว้ประกอบการใช้งานเท่านั้น ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้บริการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`รูปแบบเกมที่ ${BRAND_NAME} นำเสนอ ทั้งสล็อตคลาสสิก เกมโบนัส และเกมที่มีฟีเจอร์พิเศษ`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#a81410]">{BRAND_NAME} ระบุรูปแบบเกมไว้ภายใต้คอนเซปต์สล็อตเมกซิกัน ที่เน้นบรรยากาศสนุกสนานและรูปแบบเกมหลากหลาย</strong>
        รายการด้านล่างคือกลุ่มเกมที่เว็บไซต์ระบุไว้ และเป็นจุดเริ่มต้นสำหรับคนที่ยังไม่แน่ใจว่าควรเปิดอ่านรายละเอียดของเกมแบบไหนก่อน
      </p>

      <ul class="flex flex-col gap-4" aria-label="กลุ่มเกมที่เว็บไซต์ระบุไว้">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎰</span>
          <span>
            <strong class="text-[#a81410]">สล็อตคลาสสิก</strong> คือกลุ่มที่โครงสร้างการเล่นตรงไปตรงมาที่สุด เหมาะกับการทำความเข้าใจกติกาพื้นฐานก่อนขยับไปดูเกมกลุ่มอื่น
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎁</span>
          <span>
            <strong class="text-[#a81410]">เกมโบนัส</strong> คือกลุ่มที่มีรอบพิเศษของตัวเอง ซึ่งเงื่อนไขการเข้ารอบและการคิดรางวัลระบุไว้ในหน้าเกมแต่ละเกม ไม่ใช่ที่หน้ารวม
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>✨</span>
          <span>
            <strong class="text-[#a81410]">เกมที่มีฟีเจอร์พิเศษ</strong> คือกลุ่มที่มีกลไกเพิ่มเข้ามานอกเหนือจากการหมุนปกติ จึงเป็นกลุ่มที่ควรอ่านกติกาให้จบก่อนเริ่มเล่นมากที่สุด
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#a81410]">ควรศึกษากติกาเกมและอัตราการจ่ายรางวัลจากหน้าเกมโดยตรงทุกครั้ง</strong>
        เพราะธีมและบรรยากาศของเกมเป็นเรื่องของงานภาพ ไม่ได้บอกเงื่อนไขการเล่นจริง และเกมที่อยู่ในกลุ่มเดียวกันก็ไม่จำเป็นต้องใช้กติกาชุดเดียวกัน
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/ทดลองเล่น" aria-label={`เปิดหน้าทดลองเล่นของ ${BRAND_NAME}`} class={ctaQuiet}>ไปหน้าทดลองเล่น</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`${BRAND_NAME} การันตีเว็บตรง ยอดเข้าบริษัทไม่ผ่านเอเย่นต์ และสิ่งที่ควรตรวจสอบ`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#a81410]">{BRAND_NAME} ระบุรูปแบบการให้บริการที่เชื่อมต่อกับระบบเกมโดยตรง พร้อมข้อมูลเกี่ยวกับการทำธุรกรรมผ่านผู้ให้บริการหลัก</strong>
        รายการด้านล่างคือสิ่งที่ผู้ใช้งานควรตรวจสอบก่อนสมัครสมาชิก เพราะเป็นข้อมูลที่ยืนยันได้จากแหล่งที่มา ไม่ใช่จากตัวข้อความโฆษณาเอง
      </p>

      <ul class="flex flex-col gap-4" aria-label="สิ่งที่ควรตรวจสอบก่อนสมัครสมาชิก">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🏷️</span>
          <span>
            <strong class="text-[#a81410]">ชื่อบริษัทผู้ให้บริการ</strong> ควรตรวจสอบให้ตรงกับข้อมูลที่เว็บไซต์แสดงไว้ และควรหาข้อมูลประกอบจากแหล่งที่เชื่อถือได้ก่อนตัดสินใจ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📑</span>
          <span>
            <strong class="text-[#a81410]">รายละเอียดผู้ให้บริการเกมและหลักฐานความเกี่ยวข้องกับค่ายเกม</strong> คือสองจุดที่บรีฟของเว็บไซต์ระบุให้ตรวจก่อนเสมอ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📘</span>
          <span>
            <strong class="text-[#a81410]">กติกาเกม อัตราการจ่ายรางวัล และข้อกำหนดการใช้งาน</strong> ควรอ่านให้ครบ เพื่อประกอบการพิจารณาความน่าเชื่อถือของเว็บไซต์
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#a81410]">คำกล่าวอ้างว่าไม่ผ่านเอเย่นต์หรือยอดเงินเข้าบริษัทโดยตรง จำเป็นต้องมีข้อมูลที่ตรวจสอบได้ประกอบ</strong>
        หน้านี้จึงชี้ว่าควรอ่านอะไรและหาข้อมูลจากที่ไหน แทนที่จะยืนยันแทนเว็บไซต์ เพราะสิ่งที่ยืนยันได้จริงคือเอกสารและข้อมูลที่เปิดให้ตรวจสอบ ไม่ใช่ข้อความบนหน้าโฆษณา
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} นำเสนอข้อมูลโปรโมชั่นสำหรับสมาชิกไว้สองรายการหลัก คือ
        <strong class="text-[#a81410]">คืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน และแนะนำเพื่อนรับโบนัส 0.8% ไม่จำกัด</strong>
        โดยเว็บไซต์ระบุว่าโปรโมชั่นอัปเดตใหม่ตลอดสัปดาห์ สมาชิกจึงควรติดตามรายละเอียดประจำสัปดาห์เพื่อศึกษาข้อกำหนดและช่วงเวลาที่เปิดให้รับสิทธิ์
      </p>

      <p>
        รายการคืนยอดเสียระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขรายวัน
        <strong class="text-[#a81410]">สมาชิกควรตรวจสอบว่าเกมสล็อตประเภทใดเข้าร่วมรายการ มีรอบสรุปยอดเวลาใด และต้องกดรับเครดิตด้วยตนเองหรือระบบดำเนินการให้อัตโนมัติ</strong>
        รวมถึงศึกษาข้อกำหนดการใช้เครดิตให้ครบถ้วน เพราะยอดเสียบางรายการอาจไม่เข้าเกณฑ์รับสิทธิ์ ทั้งนี้ เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งต่อไป
      </p>

      <p>
        ส่วนรายการแนะนำเพื่อนระบุสิทธิ์ไว้สำหรับสมาชิกที่แนะนำผู้ใช้งานรายใหม่ โดยควรตรวจสอบวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และฐานยอดที่ใช้คำนวณโบนัสให้ชัดเจน
        <strong class="text-[#a81410]">แม้จะมีข้อความว่าไม่จำกัด แต่ควรยืนยันจำนวนบัญชีที่เข้าร่วมได้ รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุด</strong>
        เพื่อป้องกันความเข้าใจคลาดเคลื่อนเกี่ยวกับจำนวนเครดิตที่มีสิทธิ์ได้รับ
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/promotion" aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`} class={ctaQuiet}>ดูภาพโปรโมชั่น</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME} ด้วยตัวเอง 3 ขั้นตอน`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#a81410]">{BRAND_NAME} มีข้อมูลการสมัครสมาชิกสำหรับผู้ที่ต้องการศึกษาวิธีลงทะเบียนและเข้าสู่ระบบ</strong>
        ก่อนดำเนินการควรตรวจสอบคุณสมบัติผู้สมัคร ข้อกำหนดด้านอายุ กฎหมายที่เกี่ยวข้อง และนโยบายความเป็นส่วนตัวให้ครบถ้วน ลำดับด้านล่างเรียงตามที่เว็บไซต์ระบุไว้
      </p>

      <ol class="ml-6 list-decimal space-y-3 marker:font-black marker:text-[#a81410]">
        <li>
          <strong class="text-[#a81410]">เข้าสู่หน้าสมัครสมาชิก</strong> ตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง จากนั้นเลือกเมนูสมัครสมาชิกและอ่านข้อกำหนดการเปิดบัญชี รวมถึงนโยบายการจัดเก็บข้อมูลส่วนบุคคลก่อนกรอกข้อมูลลงในระบบ
        </li>
        <li>
          <strong class="text-[#a81410]">กรอกข้อมูลและยืนยันบัญชี</strong> กรอกข้อมูลตามที่เว็บไซต์กำหนด ตรวจสอบความถูกต้องก่อนยืนยัน และตั้งรหัสผ่านที่คาดเดาได้ยาก ไม่ควรใช้ข้อมูลของบุคคลอื่นหรือเปิดเผยรหัสผ่านและรหัส
          OTP ให้ใครทราบ
        </li>
        <li>
          <strong class="text-[#a81410]">เข้าสู่ระบบและตรวจสอบรายละเอียดเกม</strong> หลังลงทะเบียนเรียบร้อย สามารถศึกษารายชื่อเกมสล็อต กติกาการเล่น และเงื่อนไขโปรโมชั่นที่เปิดให้บริการ
          หากมีข้อสงสัยเกี่ยวกับระบบสมาชิกควรสอบถามเจ้าหน้าที่ผ่านช่องทางทางการก่อนทำรายการ
        </li>
      </ol>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/register" aria-label={`สมัครสมาชิก ${BRAND_NAME}`} class={ctaPrimary}>สมัครสมาชิก</a>

        <a href="/login" aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`} class={ctaSecondary}>เข้าสู่ระบบ</a>

        <a href="/ทางเข้า" aria-label={`เปิดหน้าทางเข้าของ ${BRAND_NAME}`} class={ctaQuiet}>ไปหน้าทางเข้า</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`แอดมินออนไลน์ตลอด 24ชม. และช่องทางติดต่อของ ${BRAND_NAME}`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} ระบุช่องทางติดต่อเจ้าหน้าที่สำหรับผู้ใช้งานที่ต้องการสอบถามเกี่ยวกับการสมัครสมาชิก การเข้าสู่ระบบ รายชื่อเกมสล็อต และรายละเอียดโปรโมชั่น
        <strong class="text-[#a81410]">โดยควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง</strong>
      </p>

      <p>
