---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่ม) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง
// ไม่ได้มาจากเช็กลิสต์หัวข้อของ docx ที่ใช้กับ index.astro
//
// บรีฟรอบนี้ (ดรอป 2026-09-22) คือ "ABM96 เว็บเดิมพันออนไลน์เจ้าของเดิม
// อัปเดตระบบใหม่ ความปลอดภัยสูงขึ้น" — เป็นเว็บเดิมพันที่รวมหลายประเภทเกม
// ไม่ใช่เว็บสล็อตอย่างเดียว คอปปี้ของแบรนด์รอบก่อน ("เว็บรวมสล็อตใหญ่
// เกมแท้ค่ายดัง ส่งตรงจากบริษัทแม่" / "ระบบ API 100%") ถูกเขียนใหม่ทั้งหน้าแล้ว
// ไม่เหลือประโยคเดิมและไม่เหลือข้อความเรื่อง API หรือบริษัทแม่แม้แต่จุดเดียว
//
// ข้อเท็จจริงทุกบรรทัดมาจากบรีฟรอบนี้เท่านั้น: เว็บเดิมพันออนไลน์เจ้าของเดิม ·
// ปรับระบบใหม่ให้ใช้งานสะดวกขึ้นทั้งหน้าเกม เมนูสมาชิก และการเข้าถึงผ่านมือถือ ·
// ยกระดับการดูแลข้อมูลและระบบหลังบ้านให้เป็นระบบมากกว่าเดิม · อัปเกรดโครงสร้าง
// เว็บไซต์ให้เสถียรและเป็นขั้นตอน · จัดการสิทธิ์บัญชีและข้อมูลภายในระบบอย่างเหมาะสม ·
// ปรับทางเข้าให้ทันสมัย ลดความเสี่ยงจากการเข้าถึงข้อมูลโดยไม่ได้รับอนุญาต ·
// รวมบาคาร่า สล็อต หวย ไฮโล บอล ไว้ในบัญชีเดียว เลือกหมวดจากเมนูหลัก สลับเกมสะดวก
// ระบบจัดหมวดหมู่ชัดเจน ไม่ต้องเปลี่ยนหลายเว็บไซต์ · มีเกมจากหลายค่ายให้เลือก
// ตามหมวดหมู่ ตรวจสอบรายการที่เปิดให้บริการได้จากหน้ารวมเกม · โบนัสแนะนำเพื่อน 0.8% ·
// โบนัสคืนยอดเสีย 0.3% · ตรวจสอบรอบรับสิทธิ์ ยอดที่เข้าเกณฑ์ และข้อกำหนดก่อนกดรับ
// จากหน้าโปรโมชั่น · สมัครเองได้ผ่านหน้าเว็บไซต์ใน 3 ขั้นตอน
// — ห้ามอ้างเลขใบอนุญาต ปีที่ก่อตั้ง เลขทะเบียนบริษัท จำนวนสมาชิก ชื่อค่ายเกม
// อัตราจ่าย ขั้นต่ำการเดิมพัน "ฝากถอนออโต้ไม่มีขั้นต่ำ" "ตลอด 24 ชั่วโมง"
// "ปลอดภัย 100%" หรือการันตีว่าจะชนะ เพราะบรีฟไม่ได้ระบุไว้
// (หัวข้อ "แอดมินออนไลน์ 24 ชั่วโมง" ของรอบก่อนถูกถอดทิ้งด้วยเหตุผลนี้)
//
// Announcement รอบนี้หมุนมาใช้ Announcement3 ทั้งเว็บ — default message ของไฟล์นั้น
// เป็นคอปปี้ของ ABM96 อยู่แล้ว จึงเรียกแบบ bare เหมือน index.astro
// ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ ABM96 (ชมพูบับเบิ้ลกัม + เหลืองโลโก้ แทนมรกต + ทองของแบรนด์รอบก่อน):
// พื้น #12030a · การ์ด #1d0611 · ผิวยก #2a0a1a · ขอบชมพูเข้ม #b8325f ·
// ชมพูหลัก #fd6494 · ชมพูอ่อน #ffc9dc · เหลืองโลโก้ #feda2a (เลขลำดับ/ไอคอน) ·
// เนื้อความ #fbe3ee · <strong> #fd6494 · ตัวอักษรบนปุ่มชมพู #12030a ·
// ออร่าชมพู rgba(253,100,148,α)
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index และ
// /promotion ส่วนแกลเลอรี gamedemo7..18.webp เป็นของแบรนด์อื่น (mtime
// 2026-08-04) และสองใบในชุดมีโลโก้เว็บเจ้าอื่นพิมพ์ทับอยู่ ห้าม import
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 159
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "เกี่ยวกับ ABM96 เว็บเดิมพันออนไลน์เจ้าของเดิม อัปเดตทางเข้าและอัปเกรดระบบใหม่ รวมบาคาร่า สล็อต หวย ไฮโล บอล ไว้ในบัญชีเดียว พร้อมโปรโมชั่นที่ตรวจสอบเงื่อนไขได้";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับเรา ABM96 เว็บเดิมพันออนไลน์เจ้าของเดิม อัปเดตระบบใหม่",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา ABM96 เว็บเดิมพันออนไลน์เจ้าของเดิม อัปเดตระบบใหม่" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับเรา ABM96 เว็บเดิมพันออนไลน์เจ้าของเดิม อัปเดตระบบใหม่" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#fbe3ee]">
        <strong class="text-[#fd6494]">ABM96</strong> คือเว็บเดิมพันออนไลน์<strong class="text-[#fd6494]">เจ้าของเดิมที่ปรับระบบใหม่ให้ใช้งานได้สะดวกขึ้น</strong>
        ทั้งหน้าเกม เมนูสมาชิก และการเข้าถึงผ่านมือถือ พร้อมยกระดับการดูแลข้อมูลและระบบหลังบ้านให้มีความเป็นระบบมากกว่าเดิม จึงเหมาะกับผู้ใช้งานที่ต้องการทางเข้าใหม่ แต่ยังคงรูปแบบบริการจากแบรนด์เดิมที่คุ้นเคยอยู่แล้ว
      </p>

      <p class="text-left text-base leading-relaxed text-[#fbe3ee]">
        หน้านี้รวบรวมไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่สิ่งที่ปรับใหม่ในรอบนี้ การจัดการข้อมูลและสิทธิ์บัญชีภายในระบบ ประเภทเกมที่เปิดให้เลือกในบัญชีเดียว
        รายการโปรโมชั่นที่เปิดให้สมาชิกตรวจสอบเงื่อนไขก่อนกดรับ ไปจนถึงขั้นตอนการสมัครสมาชิกสำหรับคนที่เพิ่งเข้ามาใช้งานครั้งแรก
      </p>

      <p class="text-left text-base leading-relaxed text-[#fbe3ee]">
        <strong class="text-[#fd6494]">รายการเกมที่เปิดให้บริการอาจมีการอัปเดตตามช่วงเวลา</strong>
        รายละเอียดทั้งหมดจึงยึดตามหมวดหมู่และรายการที่ระบบแสดงไว้จริงในช่วงนั้นเป็นหลัก และควรตรวจสอบรายการล่าสุดได้จากหน้ารวมเกมก่อนเข้าเล่นทุกครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ABM96 อัปเกรดระบบการใช้งานและการดูแลข้อมูลหลังบ้าน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#fbe3ee]">
        สิ่งที่เปลี่ยนไปชัดที่สุดในรอบนี้คือ<strong class="text-[#fd6494]">การอัปเกรดโครงสร้างเว็บไซต์และระบบหลังบ้าน</strong>
        เพื่อให้การใช้งานมีความเสถียรและเป็นขั้นตอนมากขึ้น ทั้งการเปิดหน้าเกม การเข้าเมนูสมาชิก และการใช้งานผ่านมือถือ ซึ่งเป็นจุดที่ผู้ใช้งานสัมผัสได้ก่อนส่วนอื่นของระบบ
      </p>

      <p class="text-left text-base leading-relaxed text-[#fbe3ee]">
        ภายในระบบมี<strong class="text-[#fd6494]">การจัดการสิทธิ์บัญชีและข้อมูลอย่างเหมาะสม</strong>
        พร้อมปรับทางเข้าให้ทันสมัยขึ้น ช่วยลดความเสี่ยงจากการเข้าถึงข้อมูลโดยไม่ได้รับอนุญาต และเพิ่มความมั่นใจในการใช้งานแต่ละส่วน โดยยังคงรูปแบบบริการเดิมที่สมาชิกใช้งานกันอยู่
      </p>

      <p class="text-left text-base leading-relaxed text-[#fbe3ee]">
        <strong class="text-[#fd6494]">ตั้งรหัสผ่านที่คาดเดายาก ไม่ใช้รหัสเดียวกับบริการอื่น และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น</strong>
        รวมถึงตรวจสอบให้แน่ใจว่าเป็นช่องทางติดต่อที่ประกาศไว้บนเว็บไซต์ก่อนส่งข้อมูลใด ๆ เพราะการดูแลฝั่งผู้ใช้งานเองคือส่วนที่ระบบทำแทนให้ไม่ได้
      </p>
    </div>
  </ContentBox>

  <ContentBox title="รูปแบบเกมของ ABM96 ครบทั้งบาคาร่า สล็อต หวย ไฮโล บอล" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#fbe3ee]">
        ภายใน ABM96 <strong class="text-[#fd6494]">รวมเกมเดิมพันหลายประเภทไว้ในบัญชีเดียว ทั้งบาคาร่า สล็อต หวย ไฮโล และบอล</strong>
        ผู้ใช้งานสามารถเลือกหมวดที่สนใจได้จากหน้าเมนูหลัก และสลับระหว่างเกมแต่ละประเภทได้สะดวกโดยไม่ต้องเปลี่ยนไปใช้หลายเว็บไซต์ให้ยุ่งยาก
      </p>

      <p class="text-left text-base leading-relaxed text-[#fbe3ee]">
        <strong class="text-[#fd6494]">ระบบจัดหมวดหมู่ไว้ชัดเจน</strong>
        การค้นหาเกมหรือรายการที่ต้องการจึงทำได้ง่าย ภายในยังมีเกมจากหลายค่ายที่เปิดให้เลือกตามหมวดหมู่ และสามารถตรวจสอบรายการที่เปิดให้บริการอยู่ได้จากหน้ารวมเกมก่อนตัดสินใจเข้าเล่น
      </p>
    </div>
  </ContentBox>

  <ContentBox title="โปรโมชั่น ABM96 แนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#fbe3ee]">
        โปรโมชั่นของ ABM96 มีสิทธิ์ให้สมาชิกเลือกตามเงื่อนไขของแต่ละรายการ โดยเน้นรายการที่
        <strong class="text-[#fd6494]">ตรวจสอบรายละเอียดก่อนกดรับได้จากหน้าโปรโมชั่นโดยตรง</strong>
        ช่วยให้รู้ทั้งรอบรับสิทธิ์ ยอดที่เข้าเกณฑ์ และข้อกำหนดที่เกี่ยวข้องก่อนนำโบนัสไปใช้งาน
      </p>

      <p class="text-left text-base leading-relaxed text-[#fbe3ee]">
        สมาชิกที่แนะนำเพื่อนเข้ามาสมัครสามารถรับ<strong class="text-[#fd6494]">โบนัสแนะนำเพื่อน 0.8%</strong>
        ตามเงื่อนไขที่กำหนด ระบบมีข้อมูลให้ตรวจสอบทั้งยอดที่เข้าเกณฑ์และรายละเอียดสิทธิ์ ช่วยให้ติดตามโบนัสจากกิจกรรมแนะนำเพื่อนได้สะดวก และตรวจสอบรายการผ่านบัญชีสมาชิกได้โดยตรง
      </p>

      <p class="text-left text-base leading-relaxed text-[#fbe3ee]">
        ส่วนโปรโมชั่นคืนยอดเสียให้<strong class="text-[#fd6494]">โบนัส 0.3%</strong> ตามยอดและเงื่อนไขของระบบ สมาชิกสามารถตรวจสอบรอบคำนวณและยอดที่เข้าเกณฑ์ก่อนกดรับได้
        ช่วยให้ติดตามสิทธิ์ของตัวเองในแต่ละรอบได้ง่ายขึ้น พร้อมดูรายละเอียดของโปรโมชั่นก่อนนำโบนัสไปใช้งาน
      </p>
    </div>
  </ContentBox>

  <ContentBox title="สมัคร ABM96 ทำเองได้ผ่านหน้าเว็บไซต์ใน 3 ขั้นตอน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#fbe3ee]">
        การสมัคร ABM96 สามารถทำผ่านหน้าเว็บไซต์ได้ด้วยตัวเอง ขั้นตอนถูกจัดไว้ให้เข้าใจง่าย หลังสมัครเรียบร้อยสามารถ<strong class="text-[#fd6494]">
          เข้าสู่ระบบเพื่อเลือกเกมคาสิโนประเภทอื่นที่ต้องการได้ทันที
        </strong>
        โดยมี 3 ขั้นตอนหลักดังนี้
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#fbe3ee]">
        <li class="flex gap-3">
          <span class="font-bold text-[#feda2a]">1.</span>
          <span>เปิดหน้าสมัคร ABM96 แล้วกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#feda2a]">2.</span>
          <span>ตรวจสอบข้อมูลและรายละเอียดบัญชีให้ถูกต้องก่อนยืนยัน</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#feda2a]">3.</span>
          <span>ยืนยันการสมัครและเข้าสู่ระบบ จากนั้นเลือกสล็อต บาคาร่า หวย ไฮโล หรือบอลที่ต้องการได้ทันที</span>
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#fbe3ee]">
        <strong class="text-[#fd6494]">ผลของเกมเดิมพันทุกประเภทตัดสินจากระบบของเกมนั้น ไม่มีสูตรหรือช่วงเวลาใดรับประกันผล</strong>
        จึงควรกำหนดงบประมาณก่อนเข้าเล่นทุกครั้ง และหยุดเมื่อถึงขีดที่ตั้งไว้
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก ABM96"
          class="flex items-center justify-center rounded-lg border border-[#ffc9dc]/60 bg-gradient-to-r from-[#ffc9dc] via-[#fd6494] to-[#b8325f] px-8 py-3 font-black text-[#12030a] shadow-[0_0_15px_rgba(253,100,148,0.42)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ ABM96"
