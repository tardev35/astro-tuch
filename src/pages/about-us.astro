---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่ม) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง
// รอบก่อนหน้านี้เป็นบทความของแบรนด์ขาออก ("เว็บรวมคาสิโนเกม บาคาร่า สล็อต หวย
// บอล") ซึ่งเป็นคนละแบรนด์และคนละประเภทเว็บ — รอบนี้เขียนใหม่ทั้งหน้า ไม่เหลือ
// ประโยคเดิมแม้แต่บรรทัดเดียว
//
// FAH999 เป็นเว็บ "สล็อต" ไม่ใช่เว็บหวยและไม่ใช่เว็บรวมคาสิโนหลายหมวด
// ข้อเท็จจริงทุกบรรทัดมาจาก src/assets/content.txt เท่านั้น (ชื่อแบรนด์ที่บรีฟ
// เขียนไว้ถูกแทนด้วย FAH999 ทุกประโยคตามคำสั่งผู้ว่าจ้าง):
// เปิดรับสมาชิกใหม่ที่ต้องการเริ่มเล่นสล็อตผ่านระบบที่ใช้งานง่าย ไม่ล็อคยูส ·
// สิทธิ์โบนัสฝากแรกตามเงื่อนไขที่กำหนด · รองรับทั้งมือถือและคอมพิวเตอร์ ·
// มีเกมจากหลายค่ายให้เลือก · ระบบบัญชีจัดการได้สะดวก · สิทธิพิเศษเฉพาะสมาชิก
// ทั้งยูสใหม่และยูสเดิม · ระบบจัดหมวดเกมชัดเจน ค้นหาเกมได้ง่าย · ตัวเลือกการ
// เดิมพันหลากหลายตามแต่ละเกม · โบนัสคืนยอดเสีย 0.3% · โบนัสแนะนำเพื่อน 0.8% ·
// ตรวจสอบรายละเอียดก่อนกดรับได้จากหน้าโปรโมชั่น · รองรับช่องทางธนาคารและวอลเลท
// ตามรายการที่เว็บไซต์เปิดให้ใช้งาน ตรวจสอบยอดและสถานะฝากถอนจากบัญชีได้โดยตรง ·
// แอดมินให้บริการตลอด 24 ชั่วโมง
// — ห้ามอ้างเลขใบอนุญาต ปีที่ก่อตั้ง เลขทะเบียนบริษัท จำนวนสมาชิก รางวัล ที่อยู่
// บริษัท ชื่อค่ายเกม อัตราจ่ายเป็นตัวเลข หรือการันตีผลกำไร เพราะบรีฟไม่ได้ระบุไว้
//
// Announcement รอบนี้หมุนมาใช้ Announcement5 ทั้งเว็บ — default message ของ
// ไฟล์นั้นเป็นคอปปี้ของ FAH999 อยู่แล้ว จึงเรียกแบบ bare ไม่ต้องส่ง prop
//
// พาเลตต์ FAH999 (ทองบนดำ สีเดียว แยกชิ้นส่วนด้วยความสว่าง ไม่ใช่ด้วยสีที่สอง):
// ทองประกาย #f7e7a8 เป็นสี <strong> และสต็อปบนของเกรเดียนต์ · ทองหลัก #e8c25a
// เป็นขอบ ไอคอน และสต็อปกลาง · ทองบรอนซ์ #a3732c เป็นสต็อปล่าง · บรอนซ์เข้ม
// #6b4a18 เป็นขอบรอง · ผิวยก #1c160e · ตัวอักษรบนปุ่มทอง #140f06 · เนื้อความ
// ครีม #e7dcc4 — ไม่มีแดงของแบรนด์ก่อนหน้าหลงเหลือในไฟล์นี้
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 153
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "เกี่ยวกับ FAH999 เว็บสล็อตสำหรับยูสใหม่ที่ใช้งานแบบไม่ล็อคยูส มีเกมจากหลายค่ายให้เลือก โบนัสฝากแรก คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% รองรับธนาคารและวอลเลท";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ FAH999 เว็บสล็อตยูสใหม่ ไม่ล็อคยูส รับโบนัสฝากแรก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา FAH999 เว็บสล็อตยูสใหม่ ไม่ล็อคยูส รับโบนัสฝากแรก" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ FAH999 เว็บสล็อตยูสใหม่ ไม่ล็อคยูส รับโบนัสฝากแรก" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e7dcc4]">
        <strong class="text-[#f7e7a8]">FAH999</strong> เปิดรับสมาชิกใหม่ที่ต้องการเริ่มเล่นสล็อตผ่านระบบที่ใช้งานง่าย
        <strong class="text-[#f7e7a8]">ไม่ล็อคยูส</strong> พร้อมสิทธิ์โบนัสฝากแรกตามเงื่อนไขที่กำหนด
        ตัวเว็บไซต์รองรับทั้งมือถือและคอมพิวเตอร์ จึงเปิดเล่นจากเครื่องไหนก็ได้โดยไม่ต้องติดตั้งโปรแกรมเพิ่ม และมีเกมจากหลายค่ายให้เลือกอยู่ในระบบเดียวกัน
      </p>

      <p class="text-left text-base leading-relaxed text-[#e7dcc4]">
        หน้านี้รวบรวมไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่รูปแบบของเกมและการจัดหมวดหมู่ โปรโมชั่นที่กำหนดไว้ในระบบ
        ช่องทางธนาคารและวอลเลทที่รองรับ ไปจนถึงวิธีติดต่อทีมงานเมื่อมีข้อสงสัยระหว่างใช้งาน
        <strong class="text-[#f7e7a8]">รายละเอียดทั้งหมดยึดตามรายการที่เว็บไซต์เปิดให้ใช้งานจริงในช่วงนั้นเป็นหลัก</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title="สล็อต FAH999 เลือกได้จากหลายค่าย ไม่มีล็อคยูส" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e7dcc4]">
        สล็อต FAH999 มีสิทธิพิเศษสำหรับสมาชิก<strong class="text-[#f7e7a8]">ทั้งยูสใหม่และยูสเดิม</strong>
        โดยจุดที่ระบบเน้นคือการใช้งานแบบไม่มีล็อคยูส สมาชิกจึงเลือกเกมและค่ายที่ต้องการได้ตามรายการที่รองรับ
        ไม่ถูกบังคับให้อยู่กับเกมใดเกมหนึ่ง และสลับไปลองเกมอื่นภายในบัญชีเดียวกันได้
      </p>

      <p class="text-left text-base leading-relaxed text-[#e7dcc4]">
        <strong class="text-[#f7e7a8]">ระบบจัดหมวดเกมไว้ชัดเจน</strong> ช่วยให้ค้นหาเกมที่ต้องการได้ง่ายจากหน้าเดียว
        ไม่ต้องไล่เปิดทีละหน้าเพื่อหาว่าค่ายที่สนใจอยู่ตรงไหน และเมื่อเจอเกมที่ต้องการแล้วยังตรวจสอบเงื่อนไขของเกมนั้นก่อนเข้าเล่นได้จากหน้าเดียวกัน
      </p>

      <p class="text-left text-base leading-relaxed text-[#e7dcc4]">
        แต่ละเกมมี<strong class="text-[#f7e7a8]">ตัวเลือกการเดิมพันที่หลากหลายต่างกันไป</strong>
        สมาชิกจึงเลือกระดับที่เหมาะกับงบของตัวเองได้ ส่วนรายการเกมที่เปิดให้ใช้งานเปลี่ยนแปลงได้ตามรอบอัปเดตของระบบ
        จึงควรตรวจสอบจากหน้าเกมของเว็บไซต์ทุกครั้งก่อนเริ่มเล่น
      </p>
    </div>
  </ContentBox>

  <ContentBox title="โปรโมชั่น FAH999 คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e7dcc4]">
        โปรโมชั่นสล็อตของ FAH999 มีสิทธิ์ให้เลือกหลายรูปแบบตามเงื่อนไขของระบบ และ<strong class="text-[#f7e7a8]">รับได้ทุกฝากไม่จำกัด</strong>
        สองรายการหลักคือโบนัสคืนยอดเสียและโบนัสแนะนำเพื่อน สมาชิกสามารถตรวจสอบรายละเอียดก่อนกดรับได้จากหน้าโปรโมชั่น
        เพื่อดูยอดที่เข้าเกณฑ์ รอบรับสิทธิ์ และเงื่อนไขของแต่ละรายการก่อนนำไปใช้งาน
      </p>

      <p class="text-left text-base leading-relaxed text-[#e7dcc4]">
        <strong class="text-[#f7e7a8]">โบนัสคืนยอดเสีย 0.3%</strong> คำนวณตามยอดและเงื่อนไขที่กำหนด
        โดยระบบจะแสดงรายละเอียดของรอบคำนวณและยอดที่เข้าเกณฑ์ให้ตรวจสอบก่อนรับสิทธิ์
        ทำให้ติดตามโบนัสของตัวเองได้ง่ายขึ้น และวางแผนการใช้เครดิตในแต่ละรอบได้อย่างชัดเจนว่ารอบไหนเข้าเกณฑ์แล้วบ้าง
      </p>

      <p class="text-left text-base leading-relaxed text-[#e7dcc4]">
        <strong class="text-[#f7e7a8]">โบนัสแนะนำเพื่อน 0.8%</strong> ให้ตามเงื่อนไขของกิจกรรม
        สมาชิกสามารถชวนคนรู้จักเข้ามาสมัครผ่านช่องทางที่ระบบรองรับ แล้วตรวจสอบยอดสิทธิ์และรายละเอียดของโบนัสได้จากบัญชีสมาชิก
        จึงเห็นผลของการแนะนำเพื่อนแต่ละครั้งได้จากที่เดียวโดยไม่ต้องสอบถามทุกรอบ
      </p>

      <p class="text-left text-base leading-relaxed text-[#e7dcc4]">
        <strong class="text-[#f7e7a8]">แต่ละรายการมีเงื่อนไขและรอบคำนวณต่างกัน ควรตรวจสอบรายละเอียดก่อนกดรับสิทธิ์ทุกครั้ง</strong>
        และยึดยอดกับสถานะที่ระบบแสดง ณ เวลาที่ทำรายการเป็นหลัก
      </p>
    </div>
  </ContentBox>

  <ContentBox title="FAH999 รับทุกธนาคารและวอลเลท ฝากถอนไม่จำกัด" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e7dcc4]">
        ระบบของ FAH999 <strong class="text-[#f7e7a8]">รองรับช่องทางธนาคารและวอลเลทตามรายการที่เว็บไซต์เปิดให้ใช้งาน</strong>
        สมาชิกจึงเลือกช่องทางที่เหมาะกับตัวเองได้ ไม่ต้องเปิดบัญชีธนาคารเพิ่มเพียงเพื่อทำรายการ
        และขั้นตอนถูกจัดวางให้เข้าใจง่ายตั้งแต่ครั้งแรก เหมาะกับทั้งสมาชิกใหม่และผู้ที่ใช้งานเป็นประจำ
      </p>

      <p class="text-left text-base leading-relaxed text-[#e7dcc4]">
        หลังทำรายการแล้ว <strong class="text-[#f7e7a8]">ตรวจสอบยอดและสถานะฝากถอนจากบัญชีของตัวเองได้โดยตรง</strong>
        จึงไม่ต้องรอให้ใครยืนยันแทนก่อนจะรู้ว่ารายการเดินถึงขั้นไหน หากยอดหรือสถานะไม่ตรงกับที่ทำไว้
        ให้เปิดดูประวัติรายการในบัญชีก่อน แล้วแจ้งทีมงานพร้อมเวลาและจำนวนเงินที่ทำรายการ
      </p>

      <p class="text-left text-base leading-relaxed text-[#e7dcc4]">
        การทำรายการรองรับ<strong class="text-[#f7e7a8]">ตามวงเงินและเงื่อนไขที่ระบบกำหนด</strong>
        ส่วนรายการช่องทางที่เปิดให้ใช้งานเปลี่ยนแปลงได้ จึงควรตรวจสอบรายการล่าสุดจากหน้าทำรายการก่อนทุกครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ติดต่อแอดมิน FAH999 พร้อมให้บริการ 24 ชั่วโมง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e7dcc4]">
        หากมีข้อสงสัยเกี่ยวกับ<strong class="text-[#f7e7a8]">การสมัคร โบนัสฝากแรก โปรโมชั่น การเข้าเกม หรือระบบฝากถอน</strong>
        สามารถติดต่อแอดมิน FAH999 ได้ตลอด 24 ชั่วโมง ทีมงานพร้อมช่วยตรวจสอบข้อมูลและแนะนำขั้นตอนใช้งานตามปัญหาที่แจ้ง
        ช่วยให้ทั้งสมาชิกใหม่และสมาชิกเดิมเข้าถึงข้อมูลได้สะดวกทุกช่วงเวลา ไม่ต้องรอรอบทำการของวันถัดไป
      </p>

      <p class="text-left text-base leading-relaxed text-[#e7dcc4]">
        เวลาแจ้งปัญหาเข้ามา ควรระบุเวลาทำรายการ จำนวนเงิน และชื่อผู้ใช้ให้ครบ เพื่อให้ทีมงานตรวจสอบตามข้อมูลที่แจ้งได้เร็วขึ้น
        <strong class="text-[#f7e7a8]">และไม่ควรเปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่นไม่ว่ากรณีใด</strong>
        รวมถึงตรวจสอบให้แน่ใจว่าเป็นบัญชี Line Official ที่ประกาศไว้บนเว็บไซต์ก่อนส่งข้อมูลใด ๆ
      </p>

      <p class="text-left text-base leading-relaxed text-[#e7dcc4]">
        <strong class="text-[#f7e7a8]">เกมสล็อตตัดสินผลแต่ละรอบแบบสุ่ม ไม่มีสูตรใดรับประกันผล</strong>
        สมาชิกจึงควรกำหนดงบประมาณก่อนเริ่มเล่นทุกครั้ง และหยุดเมื่อถึงขีดที่ตั้งไว้
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก FAH999"
          class="flex items-center justify-center rounded-lg border border-[#f7e7a8] bg-gradient-to-r from-[#f7e7a8] via-[#e8c25a] to-[#a3732c] px-8 py-3 font-black text-[#140f06] shadow-[0_0_15px_rgba(232,194,90,0.42)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ FAH999"
          class="flex items-center justify-center rounded-lg border border-[#6b4a18] bg-[#1c160e] px-8 py-3 font-bold text-[#e7dcc4] transition-all hover:scale-105 hover:border-[#e8c25a] hover:bg-[#12100b] hover:text-[#f7e7a8]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
