---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion,
// /login, /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์
// หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา
// ทั้งหน้าจึงเขียนขึ้นใหม่บนข้อเท็จจริงของบรีฟรอบนี้เท่านั้น (src/assets/content.txt)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) จึงเปิดใช้งานอยู่
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// ตัวที่ routing จริงคือไฟล์นี้ ตัวที่จอดไว้เป็นอินเวนทอรี ห้ามแก้และห้ามลบ
//
// ดรอปนี้ (2026-10-08) คือ **เว็บคาสิโนไลฟ์ 24 ชม. + สล็อต + บอล** ไม่ใช่เว็บหวย
// และไม่ใช่เว็บสล็อตเบทต่ำแบบรอบก่อน แง่มุมที่บรีฟระบุไว้มีเท่านี้: รวมเกมเดิมพัน
// หลายรูปแบบไว้ในระบบเดียว · บาคาร่า รูเล็ต ไฮโล สล็อต บอล · เข้าเล่นผ่านมือถือและ
// คอมพิวเตอร์ · เลือกโต๊ะสดหรือหมวดเกมจากบัญชีเดียว · ระบบจัดหมวดหมู่ชัดเจน สลับ
// ระหว่างคาสิโน สล็อต และกีฬาได้สะดวก · เกมไลฟ์และการแข่งขันบางรายการมีเวลาเปิดให้
// เดิมพันต่างกัน · สล็อตมีเกมโบนัส ฟรีสปิน ตัวคูณ · บอลเลือกคู่แข่งขันและตลาดเดิมพัน
// ตามช่วงเวลาที่ระบบเปิดรับ · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · สมัคร 3 ขั้นตอน ·
// บัญชีเดียวดูเครดิต โปรโมชั่น ประวัติรายการ · แอดมิน 24 ชั่วโมง · PIN รหัสผ่าน OTP
//
// ⚠️ คำที่ห้ามหลงเหลือ: ศัพท์หมวดลอตเตอรีทั้งชุด (เป็นของอินเวนทอรี *Huay ที่จอดไว้
// ไม่ใช่ของแบรนด์นี้) และคำขายของของแบรนด์ก่อนที่บรีฟรอบนี้ไม่ได้เอ่ย — รายการเต็ม
// อยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำต้องห้ามเจอ false positive
// สองหน้าของหมวดนั้นจอดอยู่ใน src/pages-disabled/ จึงไม่มีปลายทางให้ลิงก์รอบนี้
//
// ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 24 ชั่วโมง · 3 ขั้นตอน
// ห้ามเติมเลขใบอนุญาต หน่วยงานกำกับ ชื่อผู้ให้บริการ ชื่อค่ายเกม ชื่อธนาคาร
// ค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีที่ก่อตั้ง เพราะบรีฟไม่ได้เอ่ยไว้สักอย่าง
//
// ประโยคกำกับที่บรีฟเขียนไว้เองและห้ามตัดทิ้งเพราะฟังดูไม่ขายของ: "ไม่มีขั้นต่ำ
// ทุกรูปแบบเกม" ควรอ้างอิงวงเงินจริงภายในระบบ · "คาสิโนไม่จำกัดยอด" ควรพิจารณาจาก
// วงเงินของโต๊ะและเกมจริง ตรวจ Limit ก่อนเดิมพัน · โต๊ะคาสิโนไลฟ์และการแข่งขันกีฬา
// บางรายการมีช่วงเวลาให้บริการต่างกัน ควรตรวจสถานะจากระบบก่อนเริ่ม
//
// พาเลตต์รอบนี้ (brand-spec §3) เป็นแบรนด์ **สามสี: แดงนำ / เขียวมรกตรอง / ทองคั่น**
// บนพื้นเกือบดำอมแดง — พลิกฮิวจากทอง-เงินโครเมียมของรอบก่อน ชุดเดิมออกครบทุกจุดแล้ว
// ทั้งคลาส Tailwind raw hex และ rgba() (ค่าเดิมอยู่ใน brand-spec §3 ไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive)
// ปุ่มหลักถมแดงไล่ #e0201f → #c41115 → #7a0505 ตัวอักษรขาว (6.1:1 บน #c41115 และ
// 4.8:1 บน #e0201f พอดี AA — ห้ามดันปลายสว่างให้สว่างกว่านี้) ขอบเป็นทองลึก #8c6410
// ปุ่มรองถมเขียวมรกต #0b7a33 → #063f1c ตัวอักษรขาว (5.5:1) ขอบเขียวสว่าง #2bbf63/60
// — เขียวสว่างใช้ได้แค่เป็นเส้น/ออรา ห้ามถมเป็นพื้นของตัวอักษรขาว (2.3:1)
// ปุ่มลิงก์ภายในเป็นผิวการ์ด #1d0b08 → #090302 ขอบทองแบรนด์ #d9a521/60 ตัวอักษร
// ทองอ่อน #ffdf91 · #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #f6e3cf)
// ไว้ที่ตัวการ์ดแล้ว ข้อความในหน้านี้จึงไม่ประกาศสีของตัวเองเลย ปล่อยให้สืบทอดลงมา
// — มีแค่ปุ่มที่ประกาศสีได้ เพราะปุ่มถมพื้นของตัวเองจึงต้องกำหนดหมึกของตัวเอง
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจาก
// หน้า และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น Announcement3 ทั้งเว็บ (รอบก่อนใช้ตัว *Premium —
// brand-spec §5 หมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ
// แบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูดคนละเรื่อง
// กับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 155 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} เว็บคาสิโนไลฟ์ที่รวมบาคาร่า รูเล็ต ไฮโล สล็อต และบอลไว้ในบัญชีเดียว พร้อมโปรโมชั่น การสมัคร 3 ขั้นตอน และแอดมินที่ดูแลตลอด 24 ชั่วโมง`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} เว็บคาสิโนไลฟ์ บาคาร่า รูเล็ต ไฮโล สล็อต บอล`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong>{BRAND_NAME} คือเว็บคาสิโนไลฟ์ที่รวมเกมเดิมพันหลายรูปแบบไว้ในระบบเดียว</strong>
        มีทั้งบาคาร่า รูเล็ต ไฮโล สล็อต และบอล รองรับการเข้าเล่นผ่านมือถือและคอมพิวเตอร์ เลือกโต๊ะสดหรือหมวดเกมที่สนใจได้จากบัญชีเดียว และระบบจัดหมวดหมู่ไว้ชัดเจนจึงสลับระหว่างคาสิโน สล็อต และกีฬาได้สะดวก
      </p>

      <p>
        หน้านี้สรุปไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่การเลือกหมวดเกมและเปิดโต๊ะคาสิโนไลฟ์
        <strong>ไปจนถึงโปรโมชั่นคืนยอดเสียกับแนะนำเพื่อน การสมัครใน 3 ขั้นตอน และการติดต่อแอดมินที่ดูแลตลอด 24 ชั่วโมง</strong>
        เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดดูอะไรตรงไหน แล้วจึงค่อยลงรายละเอียดของเกมหรือแคมเปญที่สนใจเป็นรายรายการ
      </p>

      <p>
        สิ่งที่ควรอ่านไปพร้อมกันคือเรื่องเวลาเปิดให้บริการ
        <strong>เว็บไซต์เข้าใช้งานได้ตลอดวัน แต่โต๊ะคาสิโนไลฟ์และการแข่งขันกีฬาบางรายการมีช่วงเวลาให้บริการแตกต่างกัน</strong>
        จึงควรตรวจสอบสถานะของโต๊ะหรือรายการจากระบบก่อนเริ่มเดิมพันทุกครั้ง ข้อมูลในหน้านี้เขียนไว้เพื่อบอกว่าระบบมีอะไรให้ใช้และควรตรวจอะไรก่อนตัดสินใจ ไม่ได้ใช้แทนการอ่านเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้า
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`${BRAND_NAME} รวมโต๊ะคาสิโนไลฟ์ สล็อต และบอลไว้ในบัญชีเดียว`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        เว็บคาสิโน {BRAND_NAME} รวมเกมยอดนิยมไว้หลายแนว
        <strong>เลือกหมวดที่ต้องการแล้วเข้าเล่นต่อได้จากบัญชีเดิม โดยไม่ต้องเปิดบัญชีใหม่แยกตามประเภทเกม</strong>
        แต่ละหมวดไม่ได้ทำงานเหมือนกันทั้งหมด จึงควรเปิดดูรายละเอียดก่อนเริ่มเดิมพัน เพื่อเลือกรายการที่ตรงกับงบและความสนใจได้ง่ายขึ้น สิ่งที่ต่างกันในแต่ละหมวดแบ่งออกได้ประมาณนี้
      </p>

      <ul class="flex flex-col gap-3" aria-label={`ความแตกต่างของแต่ละหมวดเกมบนเว็บ ${BRAND_NAME}`}>
        <li class="flex gap-3">
          <span aria-hidden="true">🃏</span>
          <span>
            <strong>บาคาร่าและรูเล็ต</strong> มีโต๊ะให้เลือกตามรายการที่เปิดบริการในแต่ละช่วง จำนวนโต๊ะและรายการสดจึงเปลี่ยนแปลงได้ตามเวลา ควรดูรายการล่าสุดที่ระบบแสดงแทนการจำจากรอบก่อน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">🎲</span>
          <span>
            <strong>ไฮโล</strong> เน้นรูปแบบการเดิมพันที่เข้าใจง่าย จึงเป็นหมวดที่ไล่ดูได้เร็วกว่าเมื่อยังไม่คุ้นกับหน้าจอโต๊ะสด แต่ยังควรอ่านช่วงเดิมพันของโต๊ะนั้นก่อนยืนยันรายการ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">🎰</span>
          <span>
            <strong>สล็อต</strong> มีทั้งเกมโบนัส ฟรีสปิน และตัวคูณ ซึ่งแต่ละเกมเปิดฟีเจอร์ไว้ไม่เท่ากัน บางเกมมีครบ บางเกมมีเพียงบางอย่าง จึงควรอ่านรายละเอียดของเกมนั้นโดยตรง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">⚽</span>
          <span>
            <strong>แทงบอล</strong> เลือกคู่แข่งขันและตลาดเดิมพันได้ตามช่วงเวลาที่ระบบเปิดรับ รายการที่ยังไม่เปิดหรือปิดรับไปแล้วจะไม่แสดงเป็นตัวเลือก จึงควรตรวจสถานะของรายการก่อนทุกครั้ง
          </span>
        </li>
      </ul>

      <p>
        <strong>สำหรับคำว่าไม่มีขั้นต่ำทุกรูปแบบเกม ควรอ้างอิงวงเงินจริงภายในระบบ</strong>
        เพราะบาคาร่า รูเล็ต ไฮโล สล็อต และบอลสามารถกำหนดยอดเดิมพันขั้นต่ำแตกต่างกันตามโต๊ะ เกม หรือผู้ให้บริการ หากต้องการเริ่มจากยอดต่ำ ควรตรวจสอบช่วงเดิมพันของรายการนั้นก่อนยืนยันทุกครั้ง
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/ทดลองเล่น"
          aria-label={`เปิดหน้าทดลองเล่นของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#d9a521]/60 bg-gradient-to-b from-[#1d0b08] to-[#090302] px-8 py-3 font-bold text-[#ffdf91] shadow-[0_0_12px_rgba(217,165,33,0.25)] transition-all hover:scale-105 hover:border-[#d9a521] hover:shadow-[0_0_18px_rgba(255,223,145,0.40)]">
          ไปหน้าทดลองเล่น
        </a>

        <a
          href="/promotion"
          aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#d9a521]/60 bg-gradient-to-b from-[#1d0b08] to-[#090302] px-8 py-3 font-bold text-[#ffdf91] shadow-[0_0_12px_rgba(217,165,33,0.25)] transition-all hover:scale-105 hover:border-[#d9a521] hover:shadow-[0_0_18px_rgba(255,223,145,0.40)]">
          ดูภาพโปรโมชั่น
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`โปรโมชั่นของ ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        โปรโมชั่น {BRAND_NAME} มีสิทธิ์ให้สมาชิกตามแคมเปญที่เปิดในแต่ละช่วง ครอบคลุมเกมตามเงื่อนไขของรายการ
        <strong>ตรวจสอบโบนัส ยอดที่เข้าเกณฑ์ และสถานะการรับสิทธิ์ผ่านบัญชีสมาชิกได้โดยตรง</strong>
        โดยกิจกรรมที่เว็บไซต์ระบุไว้มีสองรายการหลัก ซึ่งคำนวณจากยอดคนละชุดกันและอาจมีรอบตัดยอดกับประเภทเกมที่ร่วมรายการต่างกัน
      </p>

