---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// WIN8S เป็นเว็บ "สล็อตออนไลน์เว็บตรง" ไม่ใช่เว็บคาสิโนครบวงจรและไม่ใช่เว็บหวย
// เนื้อหาทั้งหน้าจึงพูดเรื่องสล็อตล้วน: รวมเกมจากหลายค่ายในบัญชีเดียว เดิมพันเริ่ม 1 บาท
// ฝากถอนวอลเลท โปรโมชั่นแนะนำเพื่อน 0.8% คืนยอดเสีย 0.3% และแอดมิน 24 ชั่วโมง
// — ไม่มีการอ้างใบอนุญาต การจดทะเบียนบริษัท ปีที่ก่อตั้ง จำนวนสมาชิก การันตีผลกำไร
// ชื่อค่ายเกมรายใด หรือตาราง RTP ตายตัว
//
// รอบรีแบรนด์ก่อนหน้าเป็นเว็บคาสิโนสี่หมวด (บาคาร่า/สล็อต/หวย/บอล) หน้านี้จึงถูกเขียนใหม่
// ทั้งหน้าให้เป็นเนื้อหาสล็อตล้วน และตัดการอ้างถึงหวยกับบอลออกทั้งหมด
//
// Announcement หมุนมาใช้ Announcement5 ตัวเดียวกับ index — default message ของไฟล์นั้น
// เป็นคอปปี้ของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ไม่ต้องส่ง prop
//
// โลโก้ WIN8S เป็นสองโทน (WIN ส้ม / 8S เงินโครเมียม) เงิน #e3e7ec จึงถูกใช้เป็น
// accent รองจริงในหน้านี้ ทั้งไอคอนสลับสีในลิสต์และปุ่มเข้าสู่ระบบ ไม่ใช่ส้มจางลง
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 159
const pageDescription =
  "เกี่ยวกับ WIN8S เว็บสล็อตออนไลน์ที่รวมเกมจากหลายค่ายไว้ในบัญชีเดียว ตรวจสอบโปรโมชั่น ฝากถอนวอลเลท และจัดการเครดิตเองได้ พร้อมแอดมินดูแลการใช้งานตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ WIN8S เว็บสล็อตออนไลน์ รวมเกมจากหลายค่ายในบัญชีเดียว",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา WIN8S เว็บสล็อตออนไลน์ รวมเกมจากหลายค่ายในที่เดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ WIN8S เว็บสล็อตออนไลน์ รวมเกมจากหลายค่ายในบัญชีเดียว" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f6e4d6]">
        <strong class="text-[#fff2e6]">WIN8S</strong> เปิดให้บริการ<strong class="text-[#fd9a1e]">เกมสล็อตออนไลน์จากหลายค่ายผ่านบัญชีเดียว</strong>
        สมาชิกเข้าใช้งานได้ทั้งบนมือถือ แท็บเล็ต และคอมพิวเตอร์ โดยไม่ต้องติดตั้งหลายระบบ
        หน้าเว็บไซต์รวมส่วนเลือกเกม ฝากถอน ตรวจสอบโปรโมชั่น และจัดการเครดิตไว้ที่เดียว พร้อมช่องทางวอลเลทและธนาคารตามที่ระบบเปิดรองรับ
      </p>

      <p class="text-left text-base leading-relaxed text-[#f6e4d6]">
        นอกจากหมวดเกมแล้ว ยังมี<strong class="text-[#e3e7ec]">โปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไข</strong>
        รวมถึงทีมงานคอยดูแลปัญหาการใช้งานตลอด 24 ชั่วโมง
        สมาชิกจึงตรวจสอบสิทธิ์ เงื่อนไข และสถานะรายการของตนเองได้จากบัญชีเดียวโดยไม่ต้องสมัครหลายครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="WIN8S รวมเกมสล็อตหลายค่าย เลือกเล่นได้จากบัญชีเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f6e4d6]">
        WIN8S จัดหมวดเกมสล็อตจากหลายค่ายไว้ให้เลือกตามรูปแบบที่สนใจ สมาชิกสามารถ<strong class="text-[#fd9a1e]">สลับเกมและสลับค่ายผ่านบัญชีเดียวได้โดยไม่ต้องสมัครใหม่</strong>
        พร้อมปรับระดับเดิมพันได้ตามช่วงที่แต่ละเกมกำหนดก่อนกดหมุน
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f6e4d6]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fd9a1e]">🎰</span>
          <span><strong class="text-[#fd9a1e]">สล็อตคลาสสิกและสล็อตวิดีโอ</strong> ต่างกันที่จำนวนวงล้อและเส้นรางวัล ควรอ่านหน้าอธิบายในตัวเกมก่อนว่านับผลอย่างไร</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e3e7ec]">🎁</span>
          <span><strong class="text-[#e3e7ec]">เกมโบนัสและฟรีสปิน</strong> เข้าเงื่อนไขไม่เหมือนกันในแต่ละเกม บางเกมนับจากสัญลักษณ์ บางเกมนับจากรอบที่หมุน</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fd9a1e]">🪙</span>
          <span><strong class="text-[#fd9a1e]">ช่วงเดิมพันของแต่ละเกม</strong> ระบบแสดงไว้ในหน้าเกมโดยตรง ตัวเลขขั้นต่ำและสูงสุดต่างกันไปตามค่ายและตามเกม</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e3e7ec]">📱</span>
          <span><strong class="text-[#e3e7ec]">เล่นผ่านมือถือได้โดยตรง</strong> ใช้บัญชีเดิมเข้าเล่นได้จากทุกอุปกรณ์ เครดิตและประวัติรายการเป็นชุดเดียวกัน</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#ffc98a]">
        เกมสล็อตมีผลลัพธ์ไม่แน่นอน จึงไม่มีเกมใดรับประกันว่า “แตกง่าย” หรือสร้างกำไรได้ทุกครั้ง
        ควรเลือกเกมจากกติกา รูปแบบการเดิมพัน และงบประมาณที่เหมาะสมกับตนเอง
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="โปรโมชั่น WIN8S แนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f6e4d6]">
        สมาชิกที่มีบัญชี WIN8S สามารถ <strong class="text-[#fd9a1e]">Login เพื่อตรวจสอบโปรโมชั่นที่เปิดให้รับในแต่ละช่วง</strong>
        โดยมีทั้งกิจกรรมแนะนำเพื่อนและโบนัสคืนยอดเสีย สิทธิ์แต่ละรายการอาจกำหนดยอดที่ใช้คำนวณ รอบรับโบนัส เกมที่เข้าร่วม
        และเงื่อนไขการถอนแตกต่างกัน จึงควรอ่านรายละเอียดให้ครบก่อนกดรับโปรโมชั่น
      </p>

      <p class="text-left text-base leading-relaxed text-[#f6e4d6]">
        โปรโมชั่นแนะนำเพื่อนให้สมาชิกแชร์ลิงก์แนะนำส่วนตัวให้เพื่อน เมื่อเพื่อนสมัครและมียอดใช้งานตรงตามเงื่อนไข ระบบจะคำนวณโบนัส
        <strong class="text-[#e3e7ec]">แนะนำเพื่อน 0.8%</strong> ตามยอดที่เข้าเกณฑ์ และตรวจสอบจำนวนเพื่อน ยอดคำนวณ และโบนัสที่มีสิทธิ์รับผ่านบัญชีสมาชิกได้ด้วยตัวเอง
        ส่วนสมาชิกที่มียอดเสียตรงตามข้อกำหนดสามารถตรวจสอบสิทธิ์รับ<strong class="text-[#e3e7ec]">โบนัสคืนยอดเสีย 0.3%</strong>
        ตามรอบที่ WIN8S กำหนด โดยระบบจะแสดงยอดที่เข้าเงื่อนไขและจำนวนโบนัสที่สามารถกดรับได้
      </p>

      <p class="text-left text-base leading-relaxed text-[#ffc98a]">
        ก่อนรับสิทธิ์ทุกครั้งควรตรวจสอบ<strong class="text-[#fff2e6]">ประเภทเกม รอบคำนวณ และเงื่อนไขของโปรโมชั่น</strong>ให้เรียบร้อย
        เพราะวิธีคำนวณและข้อกำหนดล่าสุดของแต่ละรายการไม่เหมือนกัน
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ระบบ WIN8S ฝากถอนวอลเลท เล่นเริ่มต้นที่ 1 บาท" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f6e4d6]">
        WIN8S มีระบบฝากถอนที่<strong class="text-[#fd9a1e]">ช่วยให้สมาชิกจัดการเครดิตผ่านบัญชีของตนเอง</strong>
        สามารถเลือกใช้วอลเลทหรือธนาคารจากช่องทางที่เว็บไซต์เปิดรองรับ ฝากเครดิต ส่งคำขอถอน
        และตรวจสอบสถานะรายการผ่านมือถือได้โดยตรง ช่วยลดขั้นตอนและไม่จำเป็นต้องแจ้งรายการกับเจ้าหน้าที่ทุกครั้ง
      </p>

      <p class="text-left text-base leading-relaxed text-[#ffc98a]">
        สำหรับการเล่นด้วยเดิมพันเริ่มต้น <strong class="text-[#fff2e6]">1 บาท</strong> ควรตรวจสอบช่วงเดิมพันในเกมก่อนทุกครั้ง
        เนื่องจากขั้นต่ำจริงอาจแตกต่างกันตามค่ายและตามเกม เช่นเดียวกับเงื่อนไขฝากถอนที่แต่ละช่องทางอาจมีขั้นต่ำ วงเงินสูงสุด
        หรือข้อกำหนดต่างกัน ให้ยึดข้อมูลที่ระบบแสดง ณ เวลาทำรายการเป็นหลัก
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ติดต่อสอบถามแอดมิน WIN8S ได้ตลอด 24 ชั่วโมง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f6e4d6]">
        หากสมาชิกพบปัญหา Login ไม่ได้ ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง เข้าเกมสล็อตไม่ได้ หรือโปรโมชั่นไม่แสดง สามารถ
        <strong class="text-[#fd9a1e]">ติดต่อแอดมิน WIN8S ได้ตลอด 24 ชั่วโมง</strong>
        พร้อมแจ้งเวลา จำนวนเงิน และรายละเอียดของรายการ เพื่อช่วยให้เจ้าหน้าที่ตรวจสอบข้อมูลในระบบได้ตรงจุด
      </p>

      <p class="text-left text-base leading-relaxed text-[#f6e4d6]">
        สมาชิกใหม่ยังสามารถสอบถามวิธีใช้งาน ขั้นตอนฝากถอน วิธีรับโปรโมชั่น หรือการเข้าใช้งานเกมของแต่ละค่ายได้
        หากเป็นปัญหาด้านธุรกรรมควรเก็บหลักฐานรายการไว้จนกว่าการตรวจสอบจะเสร็จสิ้น
        และ<strong class="text-[#e3e7ec]">ไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น</strong>
      </p>

      <p class="text-left text-base leading-relaxed text-[#ffc98a]">
        การเดิมพันมีความเสี่ยงและผลของแต่ละรอบไม่แน่นอน ไม่มีเกมหรือรูปแบบใดรับประกันผลล่วงหน้า
        สมาชิกจึงควรกำหนดงบประมาณก่อนเริ่มเล่นทุกครั้ง
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก WIN8S"
          class="flex items-center justify-center rounded-lg border border-[#f36403]/60 bg-gradient-to-r from-[#fff2e6] via-[#fd9a1e] to-[#8a3103] px-8 py-3 font-black text-[#050201] shadow-[0_0_15px_rgba(243,100,3,0.35)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ WIN8S"
          class="flex items-center justify-center rounded-lg border border-[#e3e7ec]/55 bg-transparent px-8 py-3 font-bold text-[#e3e7ec] transition-all hover:scale-105 hover:border-[#e3e7ec] hover:bg-[#1c0a02]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
