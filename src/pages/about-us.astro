---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "รู้จัก HSOD เว็บแทงหวยออนไลน์ รับหวยเลขอั้นทั้ง 2 ตัว 3 ตัว รองรับยอดแทงตามเงื่อนไขแต่ละรอบ เรทจ่ายสูงสุด 1,000 ตรวจโพยผ่านมือถือ ฝากถอนออโต้ แอดมิน 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ HSOD เว็บแทงหวยออนไลน์ รับหวยเลขอั้น 2 ตัว 3 ตัว",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา HSOD เว็บแทงหวยออนไลน์ รับหวยเลขอั้น 2 ตัว 3 ตัว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ HSOD" as="h1">
    <p class="mb-6 text-left text-base leading-relaxed text-[#dfe3ea]">
      <strong class="text-[#e8121d]">HSOD</strong> คือเว็บแทงหวยออนไลน์ที่เปิดให้สมาชิกเข้าใช้งานผ่านเว็บเบราว์เซอร์บนมือถือ แท็บเล็ต และคอมพิวเตอร์ได้โดยตรง ไม่ต้องติดตั้งโปรแกรมเพิ่ม
      จุดที่ทำให้เว็บนี้ต่างจากที่อื่นคือ <strong class="text-[#e8121d]">รับหวยเลขอั้นทั้ง 2 ตัว และ 3 ตัว</strong> เลขที่หลายเจ้าปิดรับหรือตัดจ่าย ที่นี่ยังส่งโพยได้ตามปกติ
      โดยรองรับยอดแทงตามเงื่อนไขที่ประกาศไว้ของแต่ละรอบ สมาชิกจึงวางแผนเลขและจำนวนเงินได้ก่อนกดยืนยันรายการ
    </p>

    <p class="mb-2 text-left text-base leading-relaxed text-[#dfe3ea]">
      ด้านอัตราจ่าย HSOD ให้เรทจ่าย <strong class="text-[#e8121d]">สูงสุด 1,000</strong> ตามประเภทหวยและรูปแบบการแทงที่เลือก ซึ่งอัตราจ่ายกับวงเงินรับแทงของแต่ละรอบจะแสดงอยู่ในระบบก่อนยืนยันโพยเสมอ
      สมาชิกควรอ่านรายละเอียดตรงจุดนั้นทุกครั้ง เพราะเงื่อนไขของหวยแต่ละประเภทไม่เท่ากัน และรายการที่ยืนยันแล้วจะถูกบันทึกไว้ในประวัติของบัญชีให้ย้อนดูได้
    </p>
  </ContentBox>

  <ContentBoxPlain title="การใช้งานและการดูแลสมาชิกของ HSOD" as="h2">
    <p class="mb-6 text-left text-base leading-relaxed text-[#dfe3ea]">
      หลังส่งโพยแล้ว สมาชิกตรวจโพยของตัวเองได้จากมือถือโดยตรง ไม่ต้องเก็บกระดาษหรือรอให้ใครสรุปยอดให้ ทั้งรายการที่แทงไว้ ผลของแต่ละรอบ และยอดที่เกี่ยวข้องอยู่ในบัญชีสมาชิกเดียวกัน
      ส่วนการฝากและถอนทำผ่าน <strong class="text-[#e8121d]">ระบบอัตโนมัติ</strong> จึงทำรายการได้เองตลอดเวลาโดยไม่ต้องรอรอบทำการ และหากพบปัญหาเรื่องการสมัครสมาชิก การเข้าสู่ระบบ เครดิตไม่เข้า
      รายการค้าง หรือการส่งโพย มี <strong class="text-[#e8121d]">แอดมินดูแลตลอด 24 ชั่วโมง</strong> ให้ติดต่อเข้ามาตรวจสอบได้ทันที
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก HSOD"
        class="flex items-center justify-center rounded-lg bg-gradient-to-r from-[#ff4d55] via-[#e8121d] to-[#7c0207] px-8 py-3 font-black text-[#1a0204] shadow-[0_0_15px_rgba(232,18,29,0.45)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ HSOD"
        class="flex items-center justify-center rounded-lg border border-[#c2c9d4]/70 bg-transparent px-8 py-3 font-bold text-[#dfe3ea] transition-all hover:scale-105 hover:border-[#e8121d] hover:bg-[#2a0508]/70">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
