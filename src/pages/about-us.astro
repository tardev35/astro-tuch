---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่ม) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง
// ไม่ได้มาจากเช็กลิสต์หัวข้อของ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน
// SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริงของ WY88 เท่านั้น
//
// บรีฟรอบนี้ (ดรอป 2026-09-23) คือ "WY88 เว็บเล่นพนันอันดับ1ในไทย เข้าเล่นเกมสด
// แบบ VIP ได้ทันที" — เว็บรวมเกมออนไลน์/คาสิโนที่เน้นทางเข้าเล่นรูปแบบ VIP
// สำหรับยูสไทย คอปปี้ของแบรนด์รอบก่อน ("เว็บเดิมพันออนไลน์เจ้าของเดิม อัปเดต
// ระบบใหม่ ความปลอดภัยสูงขึ้น" + หมวด บาคาร่า/สล็อต/หวย/ไฮโล/บอล) ถูกเขียนใหม่
// ทั้งหน้าแล้ว ไม่เหลือประโยคเดิมและไม่เหลือชื่อแบรนด์เก่าแม้แต่จุดเดียว
//
// ข้อเท็จจริงทุกบรรทัดมาจากบรีฟรอบนี้เท่านั้น: เว็บรวมเกมออนไลน์ที่เน้นทางเข้าเล่น
// รูปแบบ VIP สำหรับยูสไทย · ปรับหน้าระบบและเมนูให้ใช้งานสะดวกกว่าเดิม · รองรับ
// ทั้งมือถือและคอมพิวเตอร์ · เลือกเกมสดและหมวดเกมที่สนใจได้จากบัญชีเดียว ·
// ทางเข้าเวอร์ชันใหม่ปรับทั้งหน้าหลัก เมนูเกม และระบบสมาชิก ค้นหาเกมและสลับหมวด
// ได้ง่ายกว่าเดิม จัดองค์ประกอบการใช้งานให้เป็นระเบียบ · โปรโมชั่นมีทั้งสมาชิกใหม่
// และสมาชิกเดิม เลือกตามเงื่อนไขของแต่ละรายการ บางประเภทกดรับหลังสมัครได้ตามที่
// ระบบกำหนด · โบนัสแนะนำเพื่อน 0.8% · โบนัสคืนยอดเสีย 0.3% · ตรวจสอบรอบรับสิทธิ์
// ยอดที่เข้าเกณฑ์ และข้อกำหนดก่อนกดรับได้ · สมัครเองผ่านหน้าเว็บไซต์ใน 3 ขั้นตอน ·
// สอบถามแอดมินคาสิโนผ่าน Line Official ได้ตลอด 24 ชั่วโมง
// — ห้ามอ้างเลขใบอนุญาต ปีที่ก่อตั้ง เลขทะเบียนบริษัท จำนวนสมาชิก ชื่อค่ายเกม
// ค่า RTP อัตราจ่าย ขั้นต่ำการเดิมพัน "ฝากถอนออโต้ไม่มีขั้นต่ำ" "ปลอดภัย 100%"
// "เร็วที่สุด/ปลอดภัยที่สุดในไทย" หรือการันตีว่าจะชนะ เพราะบรีฟไม่ได้ระบุไว้
//
// Announcement รอบนี้หมุนมาใช้ Announcement5 ทั้งเว็บ — default message ของไฟล์นั้น
// เป็นคอปปี้ของ WY88 อยู่แล้ว จึงเรียกแบบ bare เหมือน index.astro
// ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ WY88 (ชมพูมาเจนตา + ทองรวย แทนชมพูบับเบิลกัม + เหลืองมะนาวของแบรนด์รอบก่อน):
// พื้นเกือบดำ #170411 · การ์ด #24081a · ขอบมาเจนตาเข้ม #a3145a ·
// มาเจนตาหลัก #ec2b84 ใช้กับ <strong> · ชมพูกุหลาบ #f9a8cd เป็นสต็อปบน ·
// ทองหลัก #e8b33a ใช้กับเลขลำดับ/ไอคอน และเป็นสต็อปปลายของเกรเดียนต์ (ตรงกับ
// เลข 88 สีทองในโลโก้) · ทองประกาย #fced94 · เนื้อความ #fce9f3 (BRAND_TEXT) ·
// ตัวอักษรบนปุ่มไล่สี #170411 · ออร่ามาเจนตา rgba(236,43,132,α)
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index และ /promotion
// ส่วน banner1/banner1-mobile เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า
// และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กค้างของลูกค้าเจ้าอื่น ห้าม import
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 152
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "เกี่ยวกับ WY88 เว็บเล่นพนันออนไลน์ที่เปิดทางเข้าเล่นรูปแบบ VIP สำหรับยูสไทย รวมเกมสดและหมวดเกมไว้ในบัญชีเดียว พร้อมโปรโมชั่นและขั้นตอนสมัครที่ตรวจสอบได้";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับเรา WY88 เว็บเล่นพนันออนไลน์ ทางเข้าเล่นรูปแบบ VIP สำหรับยูสไทย",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา WY88 เว็บเล่นพนันออนไลน์ ทางเข้าเล่นรูปแบบ VIP สำหรับยูสไทย" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับเรา WY88 เว็บเล่นพนันออนไลน์ ทางเข้าเล่นรูปแบบ VIP สำหรับยูสไทย" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#fce9f3]">
        <strong class="text-[#ec2b84]">WY88</strong> คือเว็บรวมเกมออนไลน์ที่
        <strong class="text-[#ec2b84]">เน้นทางเข้าเล่นรูปแบบ VIP สำหรับยูสไทย</strong>
        โดยปรับหน้าระบบและเมนูให้ใช้งานสะดวกกว่าเดิม รองรับทั้งมือถือและคอมพิวเตอร์ ผู้ใช้งานจึงเลือกเกมสดและหมวดเกมที่สนใจได้จากบัญชีเดียว พร้อมสิทธิ์สำหรับสมาชิกตามเงื่อนไขที่เว็บไซต์กำหนด
      </p>

      <p class="text-left text-base leading-relaxed text-[#fce9f3]">
        หน้านี้รวบรวมไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่สิ่งที่ปรับใหม่ในทางเข้าเวอร์ชันนี้ รูปแบบเกมที่เปิดให้เลือกจากบัญชีเดียว รายการโปรโมชั่นที่สมาชิกตรวจสอบเงื่อนไขก่อนกดรับได้
        ขั้นตอนการสมัครสำหรับคนที่เพิ่งเข้ามาใช้งานครั้งแรก ไปจนถึงช่องทางสอบถามแอดมินเมื่อไม่แน่ใจในขั้นตอนใด
      </p>

      <p class="text-left text-base leading-relaxed text-[#fce9f3]">
        <strong class="text-[#ec2b84]">รายการเกมและสิทธิ์ที่เปิดให้ใช้งานอาจมีการอัปเดตตามช่วงเวลา</strong>
        รายละเอียดทั้งหมดจึงยึดตามหมวดหมู่และเงื่อนไขที่ระบบแสดงไว้จริงในช่วงนั้นเป็นหลัก และควรตรวจสอบรายการล่าสุดจากหน้าเว็บไซต์ก่อนเข้าเล่นทุกครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ทางเข้าเล่น WY88 รูปแบบ VIP อัปเกรดหน้าระบบและเมนูใหม่" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#fce9f3]">
        สิ่งที่เปลี่ยนไปชัดที่สุดในรอบนี้คือ<strong class="text-[#ec2b84]">ทางเข้าเล่นเวอร์ชันใหม่ที่ปรับรูปแบบให้ทันสมัยขึ้น</strong>
        ทั้งหน้าหลัก เมนูเกม และระบบสมาชิก ช่วยให้ค้นหาเกมและสลับหมวดได้ง่ายกว่าเดิม ไม่ต้องไล่หาว่ารายการที่อยากเล่นถูกจัดไว้ตรงไหนของหน้า
      </p>

      <p class="text-left text-base leading-relaxed text-[#fce9f3]">
        <strong class="text-[#ec2b84]">รูปแบบ VIP คือการจัดองค์ประกอบการใช้งานให้เป็นระเบียบ</strong>
        ทั้งลำดับของเมนู การแยกหมวดเกม และจุดที่ใช้บ่อยบนหน้าจอ จึงรองรับยูสไทยที่ต้องการเข้าถึงเกมผ่านมือถือได้อย่างคล่องตัว และใช้งานบนคอมพิวเตอร์ได้ในโครงหน้าเดียวกัน
      </p>

      <p class="text-left text-base leading-relaxed text-[#fce9f3]">
        <strong class="text-[#ec2b84]">ตั้งรหัสผ่านที่คาดเดายาก ไม่ใช้รหัสเดียวกับบริการอื่น และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น</strong>
        รวมถึงตรวจสอบให้แน่ใจว่าเป็นทางเข้าและช่องทางติดต่อที่ประกาศไว้บนเว็บไซต์ก่อนส่งข้อมูลใด ๆ เพราะการดูแลฝั่งผู้ใช้งานเองคือส่วนที่ระบบทำแทนให้ไม่ได้
      </p>
    </div>
  </ContentBox>

  <ContentBox title="เกมสดและหมวดเกมของ WY88 เลือกได้จากบัญชีเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#fce9f3]">
        ภายใน WY88 <strong class="text-[#ec2b84]">รวมเกมสดและหมวดเกมอื่นไว้ในบัญชีเดียว</strong>
        ผู้ใช้งานเลือกหมวดที่สนใจได้จากเมนูเกม และสลับไปดูอีกหมวดได้จากจุดเดียวกัน โดยไม่ต้องสมัครแยกหรือเปลี่ยนไปใช้หลายเว็บไซต์ให้ยุ่งยาก
      </p>

      <p class="text-left text-base leading-relaxed text-[#fce9f3]">
        เพราะเมนูถูกจัดใหม่ให้เป็นระเบียบ <strong class="text-[#ec2b84]">การค้นหาเกมหรือรายการที่ต้องการจึงทำได้ง่ายกว่าเดิม</strong>
        และเนื่องจากระบบรองรับทั้งมือถือและคอมพิวเตอร์ การเปิดดูหมวดเดียวกันจากคนละอุปกรณ์จึงเห็นโครงหน้าแบบเดียวกัน ไม่ต้องเรียนรู้เมนูใหม่เมื่อเปลี่ยนเครื่อง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="โปรโมชั่น WY88 แนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#fce9f3]">
        WY88 มีโปรโมชั่นสำหรับทั้งสมาชิกใหม่และสมาชิกเดิมให้เลือกตามเงื่อนไขของแต่ละรายการ โดยสิทธิ์บางประเภท
        <strong class="text-[#ec2b84]">ตรวจสอบและกดรับหลังสมัครได้ตามที่ระบบกำหนด</strong>
        ทำให้เลือกสิทธิ์ที่เหมาะกับรูปแบบการใช้งานของตัวเองได้ง่ายขึ้น แทนที่จะต้องกดรับทุกอย่างไว้ก่อน
      </p>

      <p class="text-left text-base leading-relaxed text-[#fce9f3]">
        สมาชิกที่แนะนำเพื่อนเข้ามาสมัครสามารถรับ<strong class="text-[#ec2b84]">โบนัสแนะนำเพื่อน 0.8%</strong>
        ตามเงื่อนไขของโปรโมชั่น ระบบมีรายละเอียดให้ตรวจสอบทั้งยอดที่เข้าเกณฑ์และรอบรับสิทธิ์ ช่วยให้ติดตามโบนัสจากกิจกรรมแนะนำเพื่อนได้สะดวกผ่านบัญชีสมาชิก
      </p>

      <p class="text-left text-base leading-relaxed text-[#fce9f3]">
        ส่วนโปรโมชั่นคืนยอดเสียให้<strong class="text-[#ec2b84]">โบนัส 0.3%</strong> ตามยอดและเงื่อนไขที่ระบบกำหนด สมาชิกตรวจสอบรอบคำนวณและยอดที่เข้าเกณฑ์ก่อนกดรับได้
        จึงติดตามสิทธิ์ของตัวเองในแต่ละรอบได้ง่าย และรู้รายละเอียดก่อนนำโบนัสไปใช้งาน
      </p>
    </div>
  </ContentBox>

  <ContentBox title="สมัคร WY88 เล่นเว็บพนันออนไลน์ด้วยตัวเอง 3 ขั้นตอน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#fce9f3]">
        การสมัคร WY88 ทำผ่านหน้าเว็บไซต์ได้ด้วยตัวเอง ใช้ขั้นตอนไม่ซับซ้อน และหลังยืนยันบัญชีเรียบร้อยสามารถ<strong class="text-[#ec2b84]">
          เข้าสู่ระบบเพื่อเลือกเกมสล็อตหรือเกมสดที่ต้องการได้ทันที
        </strong>
        โดยมี 3 ขั้นตอนหลักดังนี้
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#fce9f3]">
        <li class="flex gap-3">
          <span class="font-bold text-[#e8b33a]">1.</span>
          <span>เปิดหน้าสมัคร WY88 แล้วกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#e8b33a]">2.</span>
          <span>ตรวจสอบข้อมูลและรายละเอียดบัญชีให้ถูกต้องก่อนกดยืนยัน</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#e8b33a]">3.</span>
          <span>ยืนยันการสมัครและเข้าสู่ระบบ จากนั้นเลือกสล็อต เกมสด หรือหมวดที่ต้องการได้ทันที</span>
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#fce9f3]">
        <strong class="text-[#ec2b84]">ผลของเกมเดิมพันทุกประเภทตัดสินจากระบบของเกมนั้น ไม่มีสูตรหรือช่วงเวลาใดรับประกันผล</strong>
        จึงควรกำหนดงบประมาณก่อนเข้าเล่นทุกครั้ง และหยุดเมื่อถึงขีดที่ตั้งไว้
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก WY88"
          class="flex items-center justify-center rounded-lg border border-[#f9a8cd]/60 bg-gradient-to-r from-[#f9a8cd] via-[#ec2b84] to-[#e8b33a] px-8 py-3 font-black text-[#170411] shadow-[0_0_15px_rgba(236,43,132,0.42)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ WY88"
