---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login,
// /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx
// ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึง
// เขียนขึ้นใหม่บนข้อเท็จจริงของ หวย24 เท่านั้น (src/assets/content.txt)
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก NavbarStyle10 (เกี่ยวกับเรา) จึงเปิดใช้งานอยู่
//
// ดรอปนี้ (2026-10-04) คือ หวย24 **เว็บแทงหวยออนไลน์** ไม่ใช่คาสิโน แง่มุมที่บรีฟ
// ระบุไว้มีเท่านี้: รวมรายการและแนวทางหวยไว้ให้ติดตามผ่านมือถือ ทั้งหวยลาว หวยฮานอย
// และรัฐบาลไทย · ข้อมูลรอบเปิดรับ อัตราจ่าย และผลรางวัล · เลือกเลขเด็ด เลขดัง หรือ
// ชุดตัวเลขที่สนใจแล้วตรวจสอบรายละเอียดก่อนส่งโพย · รวมหลายรายการไว้ในบัญชีเดียว ·
// ตรวจสอบวงเงินและส่งโพยผ่านระบบ ดูยอดเดิมพันและอัตราจ่ายก่อนยืนยัน · อัตราของรายการ
// ที่เข้าเงื่อนไข 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท · เลข 3 ตัวมีหลายรูปแบบ
// และไม่ได้ใช้อัตราเดียวกันเสมอ · สมัคร 3 ขั้นตอน · ผลรางวัลและประวัติโพย ·
// แอดมิน 24 ชั่วโมง · ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP
//
// ⚠️ แบรนด์ก่อนหน้าของหน้านี้คือ หวยคิง (เว็บหวยอีกเจ้าที่ไม่เกี่ยวกัน) คอปปี้ชุดนั้น
// เขียนบนบรีฟคนละฉบับ และข้อขายของมันไม่มีอยู่ในบรีฟรอบนี้ จึงห้ามหลงเหลือเด็ดขาด:
// "บาทละ 1,000" · "เว็บแม่" · "จ่ายไม่อั้น" · "ยอดฝากเข้าบริษัทโดยตรง" · ชื่อนิติบุคคล ·
// บัญชีบริษัท · เครดิต/วอลเลท/ธนาคาร (บรีฟรอบนี้ไม่เอ่ยเรื่องธุรกรรมเลย พูดได้แค่ว่า
// ปัญหาด้านธุรกรรมควรเก็บหลักฐาน เวลา และจำนวนเงินไว้ตรวจสอบ)
// ก่อนหน้า หวยคิง เคยเป็น UP555 ซึ่งเป็นคาสิโน คำชุดนั้นยิ่งห้ามโผล่: สล็อต บาคาร่า
// บอล ค่ายเกม คาสิโนสด หมวดเกม RTP ความผันผวน คืนยอดเสีย แนะนำเพื่อน เว็บตรง
// หน้านี้เขียนขึ้นใหม่จากบรีฟ ไม่ใช่ find-and-replace ทับประโยคเดิม
//
// ตัวเลขที่อ้างได้มีแค่ 2 ตัว / 3 ตัว / 100 / 1,000 / 3 ขั้นตอน / 24 ชั่วโมง
// รายการหวยที่เอ่ยได้มีสามชื่อ คือ ลาว · ฮานอย · รัฐบาลไทย ห้ามเติมตลาดอื่น
// (ลาวพัฒนา หวยหุ้น ยี่กี) ห้ามแต่งเวลาเปิด-ปิดรับของรอบ ชื่อธนาคาร เลขใบอนุญาต
// ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีที่ก่อตั้ง เพราะบรีฟไม่ได้เอ่ยไว้สักอย่าง
//
// ประโยคกำกับที่บรีฟเขียนไว้เองและห้ามตัดทิ้งเพราะฟังดูไม่ขายของ: คำว่า "รับไม่อั้น"
// และ "จ่ายเต็มทุกโพย" ควรยึดวงเงินและเงื่อนไขจริงที่ระบบแสดง · แนวทางหวยและเลขดัง
// เป็นข้อมูลประกอบ ไม่รับประกันผลรางวัลรอบถัดไป · ถ้าไม่มีข้อมูลเปรียบเทียบที่ตรวจสอบ
// ได้ คำว่า "เรทจ่ายสูง" เหมาะกว่า "เรทจ่ายสูงที่สุด" · เว็บไซต์เข้าใช้งานได้ 24 ชั่วโมง
// แต่เวลารับแทงจริงขึ้นอยู่กับกำหนดเปิดและปิดของหวยแต่ละรอบ
//
// พาเลตต์ หวย24 (brand-spec §2) **แดงแบรนด์เป็นสีหลัก ทองเป็นสีรอง บนดำอมแดง** —
// โลโก้คือวงกลมแดงมีเลข 24 สีขาว กับตัวอักษร หวย24 ที่ "24" เป็นสีแดง และแบนเนอร์
// เป็นผ้าไหมแดงบนพื้นดำกับเหรียญทอง: แดงแบรนด์ #d20a0a (ขอบ ปุ่มรอง glow) ·
// แดงสว่าง #ff5c5c (hover) · แดงลึก #7a0505 / #2a0606 (พื้นยก hover ของปุ่มรอง) ·
// ทองแบรนด์ #f5c33b (ไอคอน bullet marker) · ทองสว่าง #ffd45e (หมึก strong ทั้งหน้า
// + กลางไล่เฉดปุ่มหลัก) · ทองลึก #a9761a (สองปลายไล่เฉดปุ่มหลัก) · พื้นลึกสุด
// #0a0303 (ปุ่มรอง) · หมึกบนปุ่มทอง #1a0303 · เนื้อความ #f7e2d6 (BRAND_TEXT) ·
// glow เป็น rgba(210,10,10,α) / rgba(245,195,59,α)
// ชุดทองโลหะ + ครีมอมพีชของ หวยคิง (#cd9a2c #fdeb7c #ab7314 #fcd4c3 #fce2d4 #1c140b
// #0c0b0a #5c3f12 #120a02 #f5e7c8 rgba(205,154,44,*)) ออกครบทุกจุดแล้ว
// #00B900/#009900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้
// กฎคอนทราสต์: พื้นทองสว่าง → หมึก #1a0303 เสมอ และปุ่มรองเป็น "ขอบแดง/ทองบนพื้น
// ดำอมแดง" ไม่ใช่ถมทองอีกใบ
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// — การ์ดตั้ง text-left text-base leading-relaxed text-[#f7e2d6] ไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าจึงไม่ถือคลาสของตัวเอง ใส่สีเฉพาะที่ <strong>
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจาก
// หน้า และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น Announcement3 ทั้งเว็บ (รอบก่อน หวยคิง ใช้ AnnouncementHuay)
// — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ หวย24 แล้ว จึงเรียก
// แบบ bare ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 156 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} เว็บแทงหวยออนไลน์ หน้านี้สรุปรายการหวยลาว หวยฮานอย รัฐบาลไทย รอบเปิดรับ อัตราจ่าย 2 ตัว 3 ตัว แนวทางหวย สมัคร 3 ขั้นตอน แอดมิน 24 ชั่วโมง`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} เว็บแทงหวยออนไลน์ 24 ชั่วโมง ลาว ฮานอย รัฐบาลไทย`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#ffd45e]">{BRAND_NAME} คือเว็บแทงหวยออนไลน์ที่รวมรายการและแนวทางหวยไว้ให้ติดตามผ่านมือถือ</strong>
        มีทั้งหวยลาวตามรอบที่เปิดรับ หวยฮานอยหลายช่วงเวลา และรัฐบาลไทยตามกำหนดออกรางวัล พร้อมข้อมูลรอบเปิดรับ อัตราจ่าย และผลรางวัลให้เปิดดูได้จากบัญชีเดียว
      </p>

      <p>
        หน้านี้สรุปไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่รายการหวยและรอบที่ระบบเปิดรับ
        <strong class="text-[#ffd45e]">ไปจนถึงอัตราจ่ายของเลข 2 ตัวและเลข 3 ตัว การสมัครบนมือถือแบบ 3 ขั้นตอน และช่องทางติดต่อแอดมินที่ดูแลตลอด 24 ชั่วโมง</strong>
        สมาชิกเลือกเลขเด็ด เลขดัง หรือชุดตัวเลขที่สนใจเองได้ แล้วตรวจสอบรายละเอียดของรายการนั้นก่อนส่งโพยทุกครั้ง
      </p>

      <p>
        สิ่งที่ควรอ่านไปพร้อมกันคือเงื่อนไขเวลา
        <strong class="text-[#ffd45e]">แม้ระบบเว็บไซต์จะเข้าใช้งานได้ 24 ชั่วโมง แต่เวลารับแทงจริงยังขึ้นอยู่กับกำหนดเปิดและปิดของหวยแต่ละรอบ</strong>
        ข้อมูลในหน้านี้จึงเขียนไว้เพื่อบอกว่าระบบมีอะไรให้ใช้และควรตรวจอะไรก่อนส่งโพย ไม่ได้ใช้แทนการอ่านรอบเปิดรับ อัตราจ่าย และวงเงินรับแทงที่ระบบแสดงอยู่ตรงหน้า
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`รายการหวยและอัตราจ่ายที่ ${BRAND_NAME} เปิดให้ส่งโพย`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        เว็บ {BRAND_NAME} รวบรวมหวยยอดนิยมหลายรายการไว้ในบัญชีเดียว และเปิดรับตัวเลขตามรายการกับรอบที่ระบบกำหนด ไม่ว่าจะเป็นเลขที่เลือกเอง เลขเด็ด หรือเลขดังที่กำลังได้รับความสนใจ
        <strong class="text-[#ffd45e]">สมาชิกนำเลขและยอดที่ต้องการมาตรวจสอบวงเงินผ่านระบบได้ก่อนส่งโพย</strong>
        จึงเห็นยอดเดิมพันและอัตราจ่ายก่อนกดยืนยันรายการทุกครั้ง อัตราของรายการที่เข้าเงื่อนไขแบ่งออกได้ประมาณนี้
      </p>

      <ul class="flex flex-col gap-3" aria-label={`อัตราจ่ายและรายการหวยที่ ${BRAND_NAME} เปิดรับ`}>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f5c33b]">🔢</span>
          <span>
            <strong class="text-[#ffd45e]">เลข 2 ตัว จ่าย 100 บาท</strong> สำหรับรายการที่กำหนดอัตรานี้ เลือกเลขและกำหนดยอดได้ตามวงเงินที่ระบบเปิดรับ ก่อนส่งโพยควรตรวจเลขให้ครบทั้งสองหลัก รวมถึงดูประเภทการเดิมพันและอัตราจ่ายให้เรียบร้อย
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f5c33b]">🎯</span>
          <span>
            <strong class="text-[#ffd45e]">เลข 3 ตัว จ่าย 1,000 บาท</strong> ควรตรวจประเภทการเดิมพันก่อนยืนยัน เนื่องจากเลข 3 ตัวสามารถมีหลายรูปแบบและไม่ได้ใช้อัตราเดียวกันเสมอ หากเป็นเลขดังหรือเลขที่มียอดสูง ควรตรวจวงเงินรับแทงเพิ่มเติมจากระบบ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f5c33b]">🧾</span>
          <span>
            <strong class="text-[#ffd45e]">หวยลาว หวยฮานอย และรัฐบาลไทย</strong> แต่ละรายการอาจกำหนดรายละเอียดของแต่ละรอบแตกต่างกัน จึงควรเปิดอ่านรอบของรายการที่ต้องการก่อนส่งโพย เพื่อให้ทราบว่าเลขและรูปแบบที่เลือกใช้อัตราใด
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#ffd45e]">อัตราจริงอาจแตกต่างตามประเภทหวย รูปแบบการแทง และรอบที่เลือก</strong>
        จึงควรยึดข้อมูลล่าสุดบนหน้าส่งโพยเป็นหลัก และหากใช้ข้อความว่าเรทจ่ายสูงที่สุด ก็ควรมีข้อมูลเปรียบเทียบกับผู้ให้บริการรายอื่นที่ตรวจสอบได้ หากไม่มีข้อมูลดังกล่าว การอ่านว่าเป็นเรทจ่ายสูงจะเหมาะสมกว่า
      </p>

      <p>
        ในทางเดียวกัน คำว่า
        <strong class="text-[#ffd45e]">รับไม่อั้น และ จ่ายเต็มทุกโพย ควรยึดตามวงเงินและเงื่อนไขจริงที่ระบบแสดง</strong>
        เนื่องจากเลขที่มียอดเดิมพันสูงอาจมีวงเงินรับแตกต่างจากเลขทั่วไป ส่วนแนวทางหวยหรือเลขดังเป็นข้อมูลประกอบเท่านั้น ไม่สามารถรับประกันผลรางวัลของรอบถัดไปได้
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/promotion"
          aria-label={`ดูภาพอัตราการจ่ายของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#d20a0a]/60 bg-[#0a0303] px-8 py-3 font-bold text-[#ffd45e] transition-all hover:scale-105 hover:border-[#ffd45e] hover:bg-[#2a0606] hover:text-[#ff5c5c]">
          ดูภาพอัตราการจ่าย
        </a>

        <a
          href="/แนวทาง"
          aria-label={`อ่านแนวทางหวยของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#d20a0a]/60 bg-[#0a0303] px-8 py-3 font-bold text-[#ffd45e] transition-all hover:scale-105 hover:border-[#ffd45e] hover:bg-[#2a0606] hover:text-[#ff5c5c]">
          อ่านแนวทางหวย
        </a>

        <a
          href="/ทดลองเล่น"
          aria-label={`เปิดหน้าทดลองเล่นของ ${BRAND_NAME}`}
