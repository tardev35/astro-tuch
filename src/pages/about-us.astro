---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login, /register)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อของ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึงเขียนขึ้นใหม่
// บนข้อเท็จจริงของ SEXYGAME666 เท่านั้น
//
// รอบนี้ (ดรอป 2026-09-28) คือ SEXYGAME666 **เกมเซ็กซี่บาคาร่าออนไลน์ ไลฟ์สด
// 24 ชั่วโมง** ไม่ใช่เว็บสล็อตและไม่ใช่เว็บหวย คอปปี้รอบก่อนเป็นของ PGW44 ซึ่งขาย
// "ค่ายสล็อตย่อย" "เกมคลาสสิก/เกมโบนัส/เกมธีมใหม่" และ "สล็อตที่อัปเดตตามช่วงเวลา"
// — บรีฟของ SEXYGAME666 **ไม่ได้ระบุสักคำ** ทั้งหน้าจึงถูกเขียนใหม่ทั้งบท ไม่ใช่
// แทนชื่อแบรนด์ทับประโยคเดิม หัวข้อเรื่องค่ายสล็อตย่อยของรอบก่อนถูกถอดออก แทนด้วย
// หัวข้อเรื่องบาคาร่าไลฟ์สดจากผู้ให้บริการต่างประเทศ เมนูค้นหาง่าย และการเข้าเล่น
// ได้ตลอด 24 ชั่วโมง ซึ่งเป็นสิ่งที่บรีฟรอบนี้พูดถึงจริง
//
// ข้อเท็จจริงทุกบรรทัดมาจากบรีฟรอบนี้เท่านั้น (brand-spec §4): บาคาร่าไลฟ์สด ·
// โต๊ะเกมและรูปแบบการเดิมพันตามรายการที่เปิดให้บริการ · รองรับมือถือและคอมพิวเตอร์ ·
// ตลอด 24 ชั่วโมงตามช่วงเวลาที่ระบบรองรับ · เชื่อมต่อผู้ให้บริการต่างประเทศ ·
// เกมคาสิโนสดหลายรูปแบบ · เมนูค้นหาง่าย · ข่าวสาร เกมใหม่ และโปรโมชั่นที่อัปเดต
// ตามช่วงเวลา · โบนัสแนะนำเพื่อน 0.8% · โบนัสคืนยอดเสีย 0.3% · ยอดที่เข้าเกณฑ์ /
// รอบรับสิทธิ์ / รอบคำนวณ / เงื่อนไข · บัญชีสมาชิก · สมัครเองผ่านหน้าเว็บ 3 ขั้นตอน ·
// ติดต่อเจ้าหน้าที่ 24 ชั่วโมง · บัญชีบริษัทโดยตรง
// — ห้ามอ้าง ชื่อค่าย/สตูดิโอเจาะจง ชื่อโต๊ะเจาะจง ค่า RTP อัตราจ่าย เลขใบอนุญาต
// ปีที่ก่อตั้ง เลขทะเบียนบริษัท จำนวนสมาชิก ชื่อธนาคาร ช่องทางฝากถอน ฝากถอนออโต้
// เครดิตฟรี สล็อต หวย บอล/กีฬา "ไม่มีประวัติโกง" หรือการันตีว่าจะชนะ
// เพราะบรีฟรอบนี้ไม่ได้ระบุไว้
//
// ศัพท์ช่องทางติดต่อ: บรีฟรอบนี้เขียนหัวข้อไว้ว่า "ติดต่อเจ้าหน้าที่ SEXYGAME666
// ได้ตลอด 24 ชั่วโมง" โดย **ไม่มีคำว่าไลน์ในหัวข้อ** ต่างจากรอบก่อน — หัวข้อและ
// เนื้อความจึงไม่สร้างข้อความขายรอบคำว่าไลน์ ปุ่ม /line ยังเป็น chrome เดิมและ
// คงป้ายของตัวเองไว้ตามที่มี
//
// พาเลตต์ SEXYGAME666 เป็น **ชมพูบานเย็นนำ + ม่วงตาม บนพื้นเกือบดำอมม่วง** ตามโลโก้
// (SEXY ชมพูบานเย็น / GAME ไล่ไปม่วง / 666 กลับมาเป็นชมพู) ตารางแมปอยู่ที่ brand-spec §2:
// ผิวการ์ด #0f0518 · ผิวแผง/ปุ่มรอง #140722 · ชมพูแบรนด์ #fa42b5 · ชมพูสว่าง #ffb3e2 ·
// ชมพูเข้ม #ec3fae · ชมพูลึก #7d1550 · ม่วงแบรนด์ #8b3df3 · ม่วงอ่อน #c9a4ff ·
// ม่วงลึก #4a17a0 · ขอบ #3d1180 · เนื้อความ #f2dcee (BRAND_TEXT) ·
// เน้นใน strong #fff2fb · ตัวอักษรบนพื้นชมพู #12041c
// ปุ่มหลักไล่ชมพู → ชมพูเข้ม → ม่วง ตามลำดับตัวอักษรในโลโก้ ส่วนปุ่มรองใช้ขอบม่วง
// ชุดทอง/เขียวของ PGW44 (#fde90e #fff89a #f5c518 #a86f02 #35d413 #5df53a #0c6d10
// #1f5a16 #0b1408 #101a0b #10160a #e9f0dd #fbffe8) ถูกแทนครบทุกจุดแล้ว
// ส่วน #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ตามเดิม
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลางที่ไม่หมุนตามรอบรีแบรนด์ และรอบนี้
// orchestrator เป็นคนรีธีม) — สีเนื้อความจึงตรงกับที่การ์ดกำหนดไว้อยู่แล้ว
//
// ไม่มีลิงก์ /ตรวจหวย หรือ /แนวทาง ในหน้านี้: SEXYGAME666 เป็นแบรนด์คาสิโนไลฟ์สด
// ไม่ใช่เว็บหวย สองหน้านั้นไม่มี route รอบนี้ href ที่ชี้ route ซึ่งไม่มีใน dist/
// จะทำให้ verify-build แดง
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index และ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า
// และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กค้างของแบรนด์ก่อน ห้าม import
//
// Announcement รอบนี้หมุนจาก Announcement2 มาเป็น Announcement5 ทั้งเว็บ —
// default message ของไฟล์นั้นเป็นคอปปี้ของ SEXYGAME666 แล้ว จึงเรียกแบบ bare
// เหมือน index.astro ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 157
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "เกี่ยวกับ SEXYGAME666 เกมเซ็กซี่บาคาร่าไลฟ์สดจากผู้ให้บริการต่างประเทศ เมนูค้นหาง่าย รองรับมือถือและคอมพิวเตอร์ พร้อมโบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%";

const pageTitle = "เกี่ยวกับเรา SEXYGAME666 เกมเซ็กซี่บาคาร่าออนไลน์ เล่นสด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f2dcee]">
        <strong class="text-[#fff2fb]">SEXYGAME666</strong> คือเว็บ<strong class="text-[#fff2fb]">เกมเซ็กซี่บาคาร่าออนไลน์ในรูปแบบไลฟ์สด</strong>
        ที่เชื่อมต่อเกมบาคาร่าและคาสิโนสดจากผู้ให้บริการต่างประเทศตามข้อมูลที่เว็บไซต์ระบุ มีโต๊ะเกมและรูปแบบการเดิมพันให้เลือกตามรายการที่เปิดให้บริการ และใช้งานได้ทั้งบนมือถือและคอมพิวเตอร์
      </p>

      <p class="text-left text-base leading-relaxed text-[#f2dcee]">
        หน้านี้รวบรวมไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่รายการโต๊ะบาคาร่าและเกมคาสิโนสดที่ระบบจัดเมนูไว้ให้ค้นหาง่าย ช่วงเวลาที่เข้าเล่นได้ ไปจนถึงข่าวสารและโปรโมชั่นที่ตรวจสอบเงื่อนไขได้จากหน้าโปรโมชั่น
        ขั้นตอนการสมัครสมาชิก และช่องทางสอบถามเจ้าหน้าที่เมื่อไม่แน่ใจในขั้นตอนใด
      </p>

      <p class="text-left text-base leading-relaxed text-[#f2dcee]">
        <strong class="text-[#fff2fb]">รายการโต๊ะเกมและเงื่อนไขของโปรโมชั่นอาจเปลี่ยนแปลงตามช่วงเวลา</strong>
        รายละเอียดทั้งหมดจึงยึดตามข้อมูลที่เว็บไซต์แสดงไว้จริงในขณะนั้นเป็นหลัก และควรตรวจสอบรายการล่าสุดจากช่องทางอย่างเป็นทางการของเว็บไซต์ก่อนทำรายการทุกครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="SEXYGAME666 เกมเซ็กซี่บาคาร่าไลฟ์สด ส่งตรงจากผู้ให้บริการต่างประเทศ" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f2dcee]">
        สิ่งที่เว็บไซต์ระบุไว้เป็นตัวตนของ SEXYGAME666 คือ <strong class="text-[#fff2fb]">การเชื่อมต่อเกมบาคาร่าไลฟ์สดจากผู้ให้บริการต่างประเทศมาไว้ในระบบเดียว</strong>
        สมาชิกจึงเลือกได้ทั้งโต๊ะบาคาร่าและเกมคาสิโนสดหลายรูปแบบตามรายการที่เปิดให้บริการ โดยไม่ต้องสลับไปเปิดหลายเว็บไซต์
      </p>

      <p class="text-left text-base leading-relaxed text-[#f2dcee]">
        เพราะเป็นเกมไลฟ์สด <strong class="text-[#fff2fb]">ภาพและจังหวะการเดิมพันจึงเดินไปพร้อมกับรอบที่กำลังเปิดอยู่จริง</strong>
        รายการโต๊ะและรูปแบบการเดิมพันที่แสดงยึดตามสิ่งที่ผู้ให้บริการเปิดให้ใช้งานอยู่ในขณะนั้น และเปลี่ยนแปลงได้ตามช่วงเวลาที่เว็บไซต์อัปเดต
      </p>
    </div>
  </ContentBox>

  <ContentBox title="เมนูค้นหาง่าย ใช้งานได้ทั้งมือถือและคอมพิวเตอร์" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f2dcee]">
        รายการทั้งหมดถูกจัดไว้ใน<strong class="text-[#fff2fb]">เมนูที่ระบบจัดให้ค้นหาได้ง่าย</strong>
        สมาชิกเห็นภาพรวมของโต๊ะบาคาร่าและเกมคาสิโนสดที่เปิดให้เลือกได้ก่อน แล้วเปิดเข้าไปดูรายละเอียดของโต๊ะที่สนใจต่อได้ทันที จึงหาเกมที่ต้องการได้เร็วกว่าการไล่เปิดทีละเว็บไซต์
      </p>

      <p class="text-left text-base leading-relaxed text-[#f2dcee]">
        ตัวเว็บไซต์<strong class="text-[#fff2fb]">รองรับการใช้งานผ่านทั้งมือถือและคอมพิวเตอร์</strong>
        การเปิดดูรายการเกมและเลือกโต๊ะจึงทำได้จากเครื่องที่ถนัด และสลับอุปกรณ์ระหว่างวันได้โดยยังเห็นเมนูชุดเดียวกัน
      </p>
    </div>
  </ContentBox>

  <ContentBox title="เข้าเล่นบาคาร่าไลฟ์สด SEXYGAME666 ได้ตลอด 24 ชั่วโมง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f2dcee]">
        สมาชิก<strong class="text-[#fff2fb]">เข้าดูและเลือกเกมไลฟ์สดได้ตลอด 24 ชั่วโมงตามช่วงเวลาที่ระบบรองรับ</strong>
        จึงไม่ต้องรอรอบเวลาใดเป็นพิเศษก่อนเปิดเข้าไปดูว่าตอนนี้มีโต๊ะและเกมคาสิโนสดอะไรออนไลน์อยู่บ้าง
      </p>

      <p class="text-left text-base leading-relaxed text-[#f2dcee]">
        สิ่งที่ควรทำก่อนเริ่มใช้งานคือ <strong class="text-[#fff2fb]">แต่ละโต๊ะมีรูปแบบการเดิมพันและรายละเอียดของตัวเอง สามารถตรวจสอบได้จากหน้าคาสิโนสดโดยตรง</strong>
        การอ่านให้จบก่อนกดเข้าโต๊ะช่วยให้เลือกเกมและวงเงินที่เหมาะกับตัวเองได้ตรงกว่า
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ข่าวสาร เกมใหม่ และโปรโมชั่น SEXYGAME666 แนะนำเพื่อน 0.8% คืนยอดเสีย 0.3%" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f2dcee]">
        สมาชิก SEXYGAME666 <strong class="text-[#fff2fb]">ติดตามข่าวสาร เกมใหม่ และโปรโมชั่นที่อัปเดตตามช่วงเวลาได้จากหน้าเว็บไซต์</strong>
        โดยโปรโมชั่นหลักตามข้อมูลที่กำหนดมีโบนัสแนะนำเพื่อน 0.8% ตามเงื่อนไขของโปรโมชั่น และโบนัสคืนยอดเสีย 0.3% ตามยอดและเงื่อนไขที่ระบบกำหนด
      </p>

      <p class="text-left text-base leading-relaxed text-[#f2dcee]">
        ทั้งสองรายการมี<strong class="text-[#fff2fb]">รายละเอียดยอดที่เข้าเกณฑ์ รอบรับสิทธิ์ และรอบคำนวณให้ตรวจสอบ</strong>
        สมาชิกดูรายละเอียดของตัวเองได้ผ่านบัญชีสมาชิก และควรอ่านเงื่อนไขของรายการที่สนใจให้ครบก่อนกดรับสิทธิ์ทุกครั้ง เพราะแต่ละรายการมีรอบและเงื่อนไขไม่เหมือนกัน
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/promotion"
          aria-label="ดูภาพโปรโมชั่นทั้งหมดของ SEXYGAME666"
          class="flex items-center justify-center rounded-lg border border-[#fa42b5] bg-[#140722] px-8 py-3 font-bold text-[#f2dcee] transition-all hover:scale-105 hover:border-[#c9a4ff] hover:bg-[#0f0518] hover:text-[#fff2fb]">
          ดูโปรโมชั่นทั้งหมด
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="สมัคร SEXYGAME666 ด้วยตัวเองแค่ 3 ขั้นตอน" as="h2">
