---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login, /register,
// /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx
// ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึง
// เขียนขึ้นใหม่บนข้อเท็จจริงของบรีฟรอบนี้เท่านั้น (src/assets/content.txt)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) จึงเปิดใช้งานอยู่ และรอบนี้ operator สั่งให้
// คงไว้ ไม่ได้ park ลง src/pages-disabled/
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// ตัวที่ routing จริงคือไฟล์นี้ Astro ไม่อ่านโฟลเดอร์นั้นเลย ห้ามแก้และห้ามลบ
//
// ⚠️ ดรอปนี้ (2026-10-13, KMD88) คือ **คาสิโนรวมเกม: บาคาร่า · สล็อต · บอลออนไลน์**
// ไม่ใช่เว็บสล็อตล้วน ไม่ใช่เว็บกีฬาล้วน และไม่ใช่เว็บหมวดลอตเตอรี (สองหน้าของหมวดนั้น
// จอดอยู่ใน src/pages-disabled/ ไม่มี route ห้ามลิงก์ไปหา เป็น href ตายที่ทำให้
// build แดง) หน้าเดิมทั้งหน้าเขียนบนกรอบของแบรนด์ก่อน ซึ่งเกือบทุกคำนามเป็นศัพท์ที่
// brand-spec §1/§6 สั่งห้ามรอบนี้ (ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำต้องห้ามเจอ
// false positive) จึงเขียนใหม่ทั้งหน้า ไม่ใช่ find-and-replace ทับประโยคเดิม
//
// แง่มุมที่บรีฟรอบนี้ระบุไว้มีเท่านี้ (ห้ามเติมอย่างอื่น): เว็บลิขสิทธิ์ไทยแท้ ·
// ระบบเดิมพันออนไลน์ ออโต้ทุกประเภท · คาสิโนรวมเกมในแพลตฟอร์มเดียว · เมนูจัดการบัญชี ·
// ตรวจสอบเครดิต · ติดตามรายการผ่านมือถือหรือคอมพิวเตอร์ · บาคาร่าเป็นเกมไพ่ที่มี
// ตัวเลือกการเดิมพันตามกติกา · สล็อตมีเกมวงล้อทั่วไป ฟรีสปิน และฟีเจอร์โบนัส ·
// บอลออนไลน์มีข้อมูลคู่แข่งขัน ประเภทการเดิมพัน และอัตราต่อรอง · ขั้นตอนยืนยันรายการ ·
// ยอดเครดิต · ประวัติธุรกรรม · ตารางจ่าย · กติกา · คืนยอดเสีย 0.3% เข้ายูสทุกวัน ·
// รอบประจำวัน · เวลาตัดยอด · ยอดที่เข้าเกณฑ์ · แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด ·
// ลิงก์แนะนำ · ฝากถอนเข้าบริษัทเจ้าของโดยตรง · บัญชีบริษัท · นิติบุคคล ·
// ชื่อบัญชีปลายทาง · หลักฐานธุรกรรม · แอดมิน 24 ชั่วโมง · ช่องทางหลัก ·
// หมายเลขรายการ · PIN · OTP
//
// ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 24 ชั่วโมง
// **รอบนี้ไม่มี "3 ขั้นตอน" และไม่มีปีใดๆ** เพราะบรีฟไม่ได้เอ่ยถึงเลย ห้ามเติมเลข
// ใบอนุญาต หน่วยงานกำกับ ชื่อผู้ดำเนินงาน ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP ยอดฝาก
// ขั้นต่ำ จำนวนสมาชิก หรือปีที่ก่อตั้ง
//
// ประโยคกำกับที่บรีฟเขียนไว้เองและห้ามตัดทิ้งเพราะฟังดูไม่ขายของ — ขนมาครบ:
// ส่วนการระบุว่าเป็นเว็บลิขสิทธิ์ไทยแท้ควรมีข้อมูลใบอนุญาตและหน่วยงานที่ออกใบอนุญาต
// ให้ตรวจสอบได้ (h1 ย่อหน้าท้าย) · ไม่มีเกมประเภทใดรับประกันผลกำไร และการเดิมพัน
// ทุกประเภทมีความเสี่ยงต่อการสูญเสียเงิน (h2 #1 ย่อหน้าท้าย) · ควรตรวจสอบว่า
// โปรโมชั่นครอบคลุมบาคาร่า สล็อต หรือบอลออนไลน์ประเภทใดบ้าง (h2 #2 ย่อหน้า 1) ·
// ควรอ่านรายละเอียดประเภทเกมที่ร่วมรายการ เวลาตัดยอด และข้อกำหนดการใช้โบนัสก่อนรับ
// ทุกครั้ง (h2 #2 รายการแรก) · ส่วนคำว่าไม่จำกัดควรระบุให้ชัด (h2 #2 รายการที่สอง) ·
// หากมีการใช้บัญชีบริษัทเจ้าของโดยตรง ควรแสดงชื่อบริษัทหรือนิติบุคคลที่เกี่ยวข้อง
// ให้ตรวจสอบได้ + การใช้บัญชีบริษัทไม่ได้รับประกันความปลอดภัยของธุรกรรมทั้งหมด
// (h2 #3 ย่อหน้า 1–2) · ไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP (h2 #3 ย่อหน้าท้าย)
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **สองฮิวจริง: ม่วงนำ ทองรอง บนดำสนิท** พลิก
// ออกจากชุดทองล้วนบนดำของรอบก่อน (ค่าเดิมอยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive)
// พื้นเพจเป็นดำสนิท (bg.json) จึงไม่มีชั้นที่ลึกกว่าพื้นเพจได้จริง
// ลำดับความลึก: #1d0832 ผิวยก (= การ์ด) / #140522 กลาง / #0a0213 จมสุด / #000000 พื้น
//
// ลำดับปุ่มสื่อด้วย "ทองถม vs ผิวจมขอบม่วง" — คู่พื้น-หมึกคำนวณไว้แล้ว:
// · ปุ่มหลัก (สมัครสมาชิก) ถมทองไล่ #ffdf8c → #e2b33f ขอบ #7a5a0a หมึก #1a0526
//   ⚠️ ไล่เฉดต้องหยุดที่ #e2b33f ห้ามไล่ลงไปเข้มกว่านั้นใต้ตัวอักษร
// · ปุ่มรอง/ปุ่มลิงก์ภายในเป็นชั้นจม #140522 → #0a0213 ขอบ #7505cc/55
//   ตัวอักษร #ece2f8 — hover ยกขอบเป็นม่วงสว่าง #b453ff
// · #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้
// ⚠️ #7505cc · #b453ff · #3a0565 · #2c0349 · #7a5a0a ห้ามถือตัวอักษรทุกขนาด ใช้ได้
// แค่เส้นขอบ ออรา และเงา — ออราในไฟล์นี้ใช้ rgba(117,5,204,α) และ rgba(226,179,63,α)
// เท่านั้น
// ⚠️ กับดักรอบนี้คือ **ทั้งสองฮิว**: ทองออกมาแล้วเก้าในสิบสองรอบหลังสุด และม่วงก็
// เพิ่งออกสองรอบ "มีทองหรือมีม่วงอยู่" จึงไม่ใช่ตัวบอกว่าถูกแบรนด์ ให้เทียบเป็น "ค่า"
// ทีละตัวกับตารางใน brand-spec §2 ไม่ใช่เทียบด้วยตาหรือด้วยตระกูลสี
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #ece2f8,
// 12.6:1 บนผิวยก #1d0832) ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง
// ปล่อยให้สืบทอดลงมา และไม่ใส่ mx-auto / max-w-* บน <p> เพราะการ์ดคุมความกว้างเองแล้ว
// — ที่ประกาศสีได้มีแค่ปุ่ม (ถมพื้นของตัวเองจึงต้องกำหนดหมึกของตัวเอง) และ <strong>
// ซึ่ง brand-spec §2 สงวน #ffd45e (11.1:1 บนผิวการ์ด) ไว้ให้เป็นสีไฮไลต์ในเนื้อความ
// โดยเฉพาะ และไม่ใช้สีอื่นเลย · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง
// เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาด
// ครึ่ง (ลบแท็ก <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิมเป๊ะ)
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้าง
// จากหน้า และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้หมุนมาเป็น Announcement5 ทั้งเว็บ (รอบก่อนใช้
// AnnouncementPremium — brand-spec §3 หมุนออก) orchestrator ตั้ง default message
// ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message
// มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 152
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} เว็บลิขสิทธิ์ไทยแท้ คาสิโนรวมเกม บาคาร่า สล็อต บอลออนไลน์ ในแพลตฟอร์มเดียว พร้อมคืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% และแอดมิน 24 ชั่วโมง`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} เว็บลิขสิทธิ์ไทยแท้ คาสิโนรวมเกมในแพลตฟอร์มเดียว`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#ffd45e]">{BRAND_NAME} คือเว็บคาสิโนออนไลน์ที่นำเสนอระบบเดิมพันแบบออโต้ทุกประเภทไว้ในแพลตฟอร์มเดียว</strong>
        ทั้งบาคาร่า สล็อต และบอลออนไลน์ รวมหมวดเกมไว้ในระบบเดียว พร้อมเมนูจัดการบัญชี ตรวจสอบเครดิต และติดตามรายการต่างๆ ผ่านมือถือหรือคอมพิวเตอร์ได้สะดวก
      </p>

      <p>
        หน้านี้สรุปไว้ว่าภายในระบบมีอะไรให้ใช้งานบ้าง ตั้งแต่หมวดเกมที่จัดไว้ให้เลือกตามความสนใจ ไปจนถึงรายการโปรโมชั่น ระบบฝากถอน และช่องทางติดต่อแอดมิน
        <strong class="text-[#ffd45e]">ระบบอัตโนมัติช่วยลดขั้นตอนการทำรายการตามรูปแบบที่เว็บไซต์เปิดให้บริการ</strong>
        เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดดูอะไรตรงไหน แล้วจึงค่อยลงรายละเอียดของรายการที่สนใจเป็นรายรายการ
      </p>

      <p>
        <strong class="text-[#ffd45e]">ส่วนการระบุว่าเป็นเว็บลิขสิทธิ์ไทยแท้ควรมีข้อมูลใบอนุญาตและหน่วยงานที่ออกใบอนุญาตให้ตรวจสอบได้</strong>
        เช่นเดียวกับโดเมนหลักและข้อมูลผู้ดำเนินงานที่ควรตรวจสอบให้ชัดเจนก่อนส่งข้อมูลส่วนตัว ข้อมูลในหน้านี้จึงเขียนไว้เพื่อบอกว่าระบบมีอะไรให้ใช้และควรตรวจอะไรก่อนตัดสินใจ
        ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้งาน
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`หมวดเกมที่ ${BRAND_NAME} รวมไว้ในแพลตฟอร์มเดียว`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} คาสิโนรวมเกมเดิมพันหลายรูปแบบไว้สำหรับผู้ที่สนใจทั้งเกมคาสิโนและกีฬา
        <strong class="text-[#ffd45e]">การรวมหมวดเกมไว้ในระบบเดียวช่วยให้ค้นหาประเภทเกมและศึกษารายละเอียดได้สะดวกขึ้น</strong>
        ทั้งบนหน้าจอมือถือและคอมพิวเตอร์ ประเภทการเดิมพันที่เว็บไซต์ระบุไว้แบ่งออกได้ประมาณนี้
      </p>

      <ul class="flex flex-col gap-3" aria-label={`หมวดเกมเดิมพันบนแพลตฟอร์มของ ${BRAND_NAME}`}>
        <li class="flex gap-3">
          <span aria-hidden="true">🃏</span>
          <span>
            <strong class="text-[#ffd45e]">บาคาร่า</strong> เป็นเกมไพ่ที่มีตัวเลือกการเดิมพันตามกติกา จึงควรอ่านกติกาและตัวเลือกเดิมพันของโต๊ะที่เลือกให้เข้าใจก่อนเป็นอันดับแรก
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">🎰</span>
          <span>
            <strong class="text-[#ffd45e]">สล็อต</strong> มีทั้งเกมวงล้อทั่วไป ฟรีสปิน และฟีเจอร์โบนัส แต่ละเกมมีตารางจ่ายและช่วงยอดเดิมพันของตัวเอง จึงควรเปิดอ่านก่อนเริ่มเล่น
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">⚽</span>
          <span>
