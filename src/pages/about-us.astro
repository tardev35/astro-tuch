---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login,
// /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx
// ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึง
// เขียนขึ้นใหม่บนข้อเท็จจริงของ NAZA99 เท่านั้น (src/assets/content.txt)
//
// ดรอปนี้ (2026-10-02) คือ NAZA99 **เว็บสล็อตออนไลน์** แง่มุมที่บรีฟระบุไว้มีเท่านี้:
// รวมเกมสล็อตหลายสไตล์จากค่ายยอดนิยมไว้ในระบบเดียว · เกมโบนัส ฟรีสปิน ตัวคูณ
// และฟีเจอร์ใหม่ · รองรับมือถือและคอมพิวเตอร์ · บัญชีเดียวเลือกเกม ตรวจโปรโมชั่น
// และติดตามรายการได้ · สามเกมแนะนำประจำหมวด Mahjong Ways 2 / Fortune Tiger /
// Sweet Bonanza · คืนยอดเสีย โบนัส 0.3% · แนะนำเพื่อน โบนัส 0.8% ·
// สมัคร 3 ขั้นตอน · แอดมิน 24 ชั่วโมง · PIN/OTP ห้ามเปิดเผย
//
// แบรนด์ก่อนหน้าในไฟล์นี้เป็น **เว็บหวย** (หวย365 / หวยเฮง789) คนละสินค้ากันทั้งหมด
// — ย่อหน้าที่พูดถึงหวยรัฐบาล/ฮานอย/ลาวพัฒนา/หวยหุ้น โพย งวด เลขเด็ด อัตราจ่าย
// 2 ตัว 100 บาท 3 ตัว 1,000 บาท แนวทางหวย กลุ่มหวย และสถิติย้อนหลัง ถูกถอดออก
// **ทั้งย่อหน้า** ไม่ใช่ find-and-replace ทับประโยคเดิม มิฉะนั้นเว็บสล็อตจะไปอ้าง
// สินค้าที่ไม่มีอยู่ · ลิงก์ที่ชี้ไปหน้าหวยสองหน้าของรอบก่อนถูกถอดออกด้วย เพราะทั้งคู่
// ย้ายไป src/pages-disabled/ แล้วใน P1 (href ไปหน้าที่ไม่มีอยู่ = build แดง)
//
// ตัวเลขที่อ้างได้มีแค่ 0.3% · 0.8% · 3 เกม · 3 ขั้นตอน · 24 ชั่วโมง
// ห้ามเพิ่มใบอนุญาต ชื่อค่าย/ผู้ให้บริการนอกจากสามเกมข้างบน ชื่อธนาคาร
// ยอดฝากขั้นต่ำ จำนวนสมาชิก ปีที่ก่อตั้ง หรือความเร็วฝาก-ถอน ที่บรีฟไม่ได้ระบุ
//
// ประโยค hedge ที่บรีฟเขียนกำกับไว้เองและห้ามตัดทิ้งเพราะฟังดูลบ: "แตกหนัก"/
// "ปั่นแตกง่ายที่สุด" ใช้รับประกันผลลัพธ์ไม่ได้เพราะเกมสล็อตให้ผลลัพธ์แบบสุ่ม ·
// แต่ละรายการโปรโมชั่นอาจกำหนดค่ายเกมและเงื่อนไขต่างกัน ควรอ่านก่อนกดรับ ·
// จำนวนเกมและช่วงอัปเดตขึ้นอยู่กับค่ายและผู้ให้บริการ · ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP
//
// พาเลตต์ NAZA99 (brand-spec §2) **ทองล้วนบนดำ ไม่มีฮิวที่สอง** ความต่างสร้างจาก
// ระดับความสว่างของทอง: ทองอ่อน/แชมเปญ #fdf2ac (หมึกเน้น) · ทองแบรนด์ #e4b34d
// (ขอบ จุด bullet ออรา) · ทองเข้ม #c08f2b (ปลายเกรเดียนต์ปุ่ม) · ทองลึก #8a5f12
// (ขอบปุ่มหลัก) · ผิวการ์ด #140c02 · ผิวยกระดับ #241404 (ปุ่ม secondary) ·
// หมึกบนพื้นทอง #1a1000 · เนื้อความ #f3e8cf (BRAND_TEXT)
// เรืองแสง: ทอง rgba(228,179,77,*) · ชุดแดงสด-ทองของ หวย365 (#dc0203 #f5282a
// #9c0201 #ffc93c #ffeab0 #c08a07 #240406 #180303 #f6e7e0 #1a0303
// rgba(255,201,60,*) rgba(220,2,3,*)) ออกครบทุกจุดแล้ว
// #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ตามเดิม
// กฎคอนทราสต์: พื้นทอง → หมึกเข้ม #1a1000 เสมอ (16.2:1 บน #fdf2ac, 11.0:1 บน
// #e4b34d, 7.0:1 บน #c08f2b) ห้ามกลับด้านเอาหมึกอ่อนไปวางบนทอง
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// — การ์ดตั้งสีเนื้อความไว้แล้ว ย้ำบนย่อหน้าอีกชั้นเพื่อให้สี body copy อ่านออกจาก
// ตัวหน้าเอง
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index และ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า
// และ slide3/slide4/banner2/banner3 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import (ลำพัง
// การ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น AnnouncementPremium ทั้งเว็บ (รอบก่อนหน้าย่อยใช้ตัว
// Cyber) — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ
// NAZA99 แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูดคนละเรื่อง
// กับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 159
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "เกี่ยวกับเรา NAZA99 เว็บสล็อตที่รวมเกมหลายสไตล์จากค่ายยอดนิยมไว้ในระบบเดียว หน้านี้สรุปว่าในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่ฟีเจอร์เกม โปรโมชั่น จนถึงแอดมิน";

const pageTitle = "เกี่ยวกับเรา NAZA99 เว็บสล็อตรวมเกมหลายสไตล์จากค่ายยอดนิยมไว้ในระบบเดียว";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed text-[#f3e8cf]">
        <strong class="text-[#fdf2ac]">NAZA99</strong> คือ<strong class="text-[#fdf2ac]">เว็บสล็อตที่รวบรวมเกมสล็อตหลายสไตล์จากค่ายยอดนิยมไว้ในระบบเดียว</strong>
        มีทั้งเกมโบนัส ฟรีสปิน ตัวคูณ และฟีเจอร์ใหม่ที่ช่วยเพิ่มรูปแบบการเล่นให้หลากหลาย รองรับการเข้าใช้งานผ่านมือถือและคอมพิวเตอร์ สมาชิกจึงเลือกเกม ตรวจสอบโปรโมชั่น และติดตามรายการผ่านบัญชีเดียวได้สะดวก
      </p>

      <p class="text-left text-base leading-relaxed text-[#f3e8cf]">
        หน้านี้สรุปไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่หมวดเกมสล็อตและฟีเจอร์ที่แต่ละเกมมี โปรโมชั่นคืนยอดเสีย โบนัส 0.3% และกิจกรรมแนะนำเพื่อน โบนัส 0.8% ขั้นตอนสมัครแบบ 3 ขั้นตอน
        ไปจนถึงช่องทางติดต่อแอดมินที่ดูแลตลอด 24 ชั่วโมงเมื่อไม่แน่ใจในขั้นตอนใด
      </p>

      <p class="text-left text-base leading-relaxed text-[#f3e8cf]">
        <strong class="text-[#fdf2ac]">คำว่า “แตกหนัก” หรือ “ปั่นแตกง่ายที่สุด” ไม่สามารถใช้รับประกันผลลัพธ์ได้</strong>
        เนื่องจากเกมสล็อตให้ผลลัพธ์แบบสุ่ม ก่อนเริ่มเล่นจึงควรตรวจสอบกติกา ช่วงเดิมพัน และรายละเอียดฟีเจอร์ของแต่ละเกมให้ครบทุกครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="NAZA99 รวมเกมสล็อตหลายสไตล์และฟีเจอร์การเล่นไว้ในระบบเดียว" as="h2">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed text-[#f3e8cf]">
        สิ่งที่เว็บไซต์ระบุไว้เป็นตัวตนของ NAZA99 คือ<strong class="text-[#fdf2ac]">การรวมเกมสล็อตหลายรูปแบบไว้ให้เลือกจากระบบเดียว</strong>
        สมาชิกจึงสลับสไตล์เกมได้จากบัญชีเดิม ไม่ว่าจะเน้นตัวคูณ ฟรีสปิน หรือรูปแบบการจ่ายที่มีจังหวะโบนัสระหว่างเกม โดย 3 เกมที่เว็บไซต์หยิบมาจัดหมวดแนะนำมีจุดเด่นต่างกันชัดเจน
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f3e8cf]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e4b34d]">🀄</span>
          <span>
            <strong class="text-[#fdf2ac]">Mahjong Ways 2</strong> มาในธีมไพ่นกกระจอก จุดเด่นอยู่ที่ระบบตัวคูณและฟีเจอร์ฟรีสปิน ทำให้แต่ละรอบมีรายละเอียดให้ติดตามมากกว่าเกมสล็อตพื้นฐาน เหมาะกับผู้ที่ชอบธีมเอเชียและระบบโบนัสหลายจังหวะ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e4b34d]">🐯</span>
          <span>
            <strong class="text-[#fdf2ac]">Fortune Tiger</strong> ใช้ธีมเสือนำโชคและรูปแบบวงล้อที่เข้าใจง่าย มีฟีเจอร์ภายในเกมที่ช่วยเพิ่มจังหวะการเล่น จึงเป็นเกมที่อ่านหน้าจอได้เร็วสำหรับผู้ที่เพิ่งเริ่มต้น
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e4b34d]">🍬</span>
          <span>
            <strong class="text-[#fdf2ac]">Sweet Bonanza</strong> มาในธีมขนมและผลไม้ ใช้ระบบจ่ายแบบกลุ่มสัญลักษณ์ พร้อมฟรีสปินและตัวคูณเป็นองค์ประกอบหลัก รูปแบบการจ่ายจึงต่างจากสล็อตที่นับเป็นแนวเรียงตามปกติ
          </span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#f3e8cf]">
        <strong class="text-[#fdf2ac]">จำนวนเกมและช่วงเวลาอัปเดตขึ้นอยู่กับค่ายและผู้ให้บริการ</strong>
        หากมีการเพิ่มเกมใหม่ระหว่างเดือน สมาชิกตรวจสอบรายการล่าสุดได้จากหมวดเกมใหม่หรือประกาศบนเว็บไซต์โดยตรง จึงควรดูจากรายการที่ระบบแสดงไว้เป็นหลักก่อนเลือกเกม
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/ทดลองเล่น"
          aria-label="เปิดหน้าทดลองเล่นสล็อตของ NAZA99"
          class="flex items-center justify-center rounded-lg border border-[#e4b34d]/35 bg-[#241404] px-8 py-3 font-bold text-[#f3e8cf] transition-all hover:scale-105 hover:border-[#e4b34d] hover:bg-[#140c02] hover:text-[#fdf2ac]">
          ไปหน้าทดลองเล่นสล็อต
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="โปรโมชั่น NAZA99 คืนยอดเสีย โบนัส 0.3% และแนะนำเพื่อน โบนัส 0.8%" as="h2">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed text-[#f3e8cf]">
        โปรโมชั่น NAZA99 <strong class="text-[#fdf2ac]">มีสิทธิ์สำหรับสมาชิกให้เลือกตามแคมเปญที่เปิดในแต่ละเดือน</strong>
        ทั้งโบนัสคืนยอดเสียและกิจกรรมแนะนำเพื่อน สมาชิกสามารถ Login เพื่อตรวจสอบยอดที่เข้าเกณฑ์ รอบคำนวณ และจำนวนโบนัสจากบัญชีของตัวเองได้โดยตรง
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f3e8cf]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e4b34d]">💰</span>
          <span>
            <strong class="text-[#fdf2ac]">คืนยอดเสีย โบนัส 0.3%</strong> สำหรับสมาชิกที่มียอดเสียตรงตามเงื่อนไขตามรอบที่กำหนด ระบบจะคำนวณจากยอดที่เข้าเกณฑ์และแสดงจำนวนโบนัสที่รับได้ ควรตรวจสอบรอบตัดยอดและเกมที่ร่วมรายการก่อนรับสิทธิ์
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e4b34d]">🤝</span>
          <span>
            <strong class="text-[#fdf2ac]">แนะนำเพื่อน โบนัส 0.8%</strong> เมื่อแชร์ลิงก์แนะนำแล้วเพื่อนสมัครและมียอดใช้งานตรงตามข้อกำหนด ระบบจะคำนวณโบนัสจากยอดที่เข้าเกณฑ์ ติดตามจำนวนเพื่อน ยอดคำนวณ และโบนัสที่มีสิทธิ์รับได้จากบัญชีสมาชิก
          </span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#f3e8cf]">
        <strong class="text-[#fdf2ac]">แต่ละรายการอาจกำหนดค่ายเกมและเงื่อนไขแตกต่างกัน จึงควรอ่านรายละเอียดก่อนกดรับทุกครั้ง</strong>
        หากข้อมูลที่แสดงในบัญชีสมาชิกต่างจากข้อความประชาสัมพันธ์ ให้ยึดเงื่อนไขล่าสุดที่ระบบแสดงไว้ในหน้าโปรโมชั่นนั้นเป็นหลัก
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/promotion"
          aria-label="ดูภาพโปรโมชั่นของ NAZA99"
          class="flex items-center justify-center rounded-lg border border-[#e4b34d]/35 bg-[#241404] px-8 py-3 font-bold text-[#f3e8cf] transition-all hover:scale-105 hover:border-[#e4b34d] hover:bg-[#140c02] hover:text-[#fdf2ac]">
          ดูภาพโปรโมชั่น
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="สมัครเล่นสล็อต NAZA99 ง่ายๆ 3 ขั้นตอน แล้วจัดการจากบัญชีเดียว" as="h2">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed text-[#f3e8cf]">
        <strong class="text-[#fdf2ac]">การสมัคร NAZA99 สามารถทำผ่านมือถือได้ด้วย 3 ขั้นตอน</strong>
