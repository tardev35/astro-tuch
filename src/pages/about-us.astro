---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login, /register)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึงเขียนขึ้นใหม่
// บนข้อเท็จจริงของ BRAVO168 เท่านั้น
//
// รอบนี้ (ดรอป 2026-09-30) คือ BRAVO168 **เว็บแทงบอลออนไลน์ / สปอร์ตบุ๊ก** — รวมตลาด
// ฟุตบอลจากหลายรายการแข่งขันไว้ผ่านบัญชีเดียว มีบอลเดี่ยว บอลสเต็ป และบอลสด
// ส่วนแบรนด์ก่อนหน้า (CK268) เป็นเว็บเกมสล็อต และก่อนหน้านั้นเป็นเว็บหวย ซึ่งบรีฟ
// รอบนี้ไม่ได้พูดถึงเลย จึงถอดออกทั้งชุด ห้าม find-and-replace ชื่อแบรนด์ทับประโยคเดิม
// มิฉะนั้นเว็บจะไปอ้างสินค้าที่ไม่มีอยู่ในบรีฟรอบนี้
// (คำห้ามจาก brand-spec §1: สล็อต วงล้อ ฟรีสปิน ตัวคูณ ค่ายเกม RTP เกมแตก หวย
// เลขเด็ด ตรวจหวย แนวทาง ยี่กี บาคาร่า)
//
// ข้อเท็จจริงทุกบรรทัดมาจาก content.txt เท่านั้น: รวมตลาดฟุตบอลหลายรายการผ่านบัญชีเดียว ·
// บอลเดี่ยว บอลสเต็ป บอลสด · ตรวจสอบคู่บอล ราคา อัตราต่อรอง และรายละเอียดบิลผ่าน
// มือถือก่อนยืนยัน · บอลสเต็ปรวมหลายคู่ในบิลเดียว · บอลสดเปิดตัวเลือกระหว่างแข่ง ·
// คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · สมัคร 3 ขั้นตอน · แอดมิน 24 ชั่วโมง
// — ตัวเลขที่อ้างได้มีแค่ 0.3% 0.8% 3 ขั้นตอน 24 ชั่วโมง และ 168 ในชื่อแบรนด์
// ห้ามเพิ่มชื่อผู้ให้บริการ ชื่อธนาคาร ขั้นต่ำฝากถอน เลขใบอนุญาต ปีที่ก่อตั้ง
// หรือจำนวนสมาชิกที่บรีฟไม่ได้ระบุ
//
// บรีฟใส่ประโยค hedge กำกับไว้เองและห้ามตัดทิ้ง: ค่าน้ำและอัตราต่อรองเปลี่ยนแปลงได้
// ตามตลาด เวลา และคู่แข่งขัน · รายการลีกและแมตช์ที่เปิดรับจริงขึ้นอยู่กับตารางแข่งขัน
// และผู้ให้บริการ · โปรโมชั่นแต่ละรายการมีรอบคำนวณและเงื่อนไขของตัวเอง ·
// ห้ามเปิดเผยรหัสผ่าน PIN OTP
//
// พาเลตต์ BRAVO168 เป็น **น้ำเงินรอยัล + ทอง บนกรมท่าสนามกลางคืน** ตามโลโก้ (ตัวอักษร
// BRAVO โครเมียมน้ำเงิน คู่เลข 168 ทองตัน) และแบนเนอร์สนามกลางคืนที่มีริ้วแสงทอง
// เหรียญทอง และลูกฟุตบอลทอง-กรมท่า ตารางแมปอยู่ที่ brand-spec §2: พื้นเข้มสุด #02081a ·
// การ์ด #04142f · ผิวยก #072247 · เส้น/ขอบ #0e3f8f · น้ำเงินรอยัล #1558c4 ·
// น้ำเงินสว่าง #2f86f0 · ทองหลัก #f4cb69 · ทองอ่อน #ffe39a · ทองเข้ม #c9922e ·
// เนื้อความ #dbe5f5 (BRAND_TEXT) · หมึกบนพื้นทอง #0a1020
// เรืองแสง: ทอง rgba(244,203,105,0.30) · น้ำเงิน rgba(21,88,196,0.35)
// ชุดเขียวนีออนของ CK268 (#8bfc13 #c9ff8f #1a7a08 #12a008 #e8f0e6 #d5e6cd #eaffd6
// #030703 #071007 #0f1b0e rgba(139,252,19,*) rgba(30,193,13,*)) ออกครบทุกจุดแล้ว
// ทั้งคลาส Tailwind raw hex และ rgba() ที่ใช้ทำแสงเรือง
// ส่วน #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ตามเดิม
// กฎคอนทราสต์: พื้นทอง → หมึกเข้ม #0a1020 · ตัวอักษรบนการ์ดกรมท่าใช้ #dbe5f5 #ffe39a
// #f4cb69 #2f86f0 เท่านั้น ส่วน #1558c4 / #0e3f8f / #c9922e ใช้เป็นพื้นและขอบ ไม่ใช่หมึก
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลางที่ไม่หมุนตามรอบรีแบรนด์ และรอบนี้
// orchestrator เป็นคนรีธีม) — สีเนื้อความจึงตรงกับที่การ์ดกำหนดไว้อยู่แล้ว
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index และ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า
// และ slide3/slide4/banner2/banner3 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import (ลำพัง
// การ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น AnnouncementPremium ทั้งเว็บ — orchestrator ตั้ง default
// message ของไฟล์นั้นเป็นคอปปี้ของ BRAVO168 แล้ว จึงเรียกแบบ bare เหมือน index.astro
// ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 160
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "เกี่ยวกับ BRAVO168 เว็บแทงบอลออนไลน์ที่รวมตลาดฟุตบอลหลายลีกไว้ในบัญชีเดียว หน้านี้สรุปว่าภายในเว็บมีอะไรให้ใช้งานบ้าง ตั้งแต่รูปแบบเดิมพัน โปรโมชั่น จนถึงแอดมิน";

const pageTitle = "เกี่ยวกับเรา BRAVO168 เว็บแทงบอลรวมทุกลีกในบัญชีเดียว";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dbe5f5]">
        <strong class="text-[#ffe39a]">BRAVO168</strong> คือ<strong class="text-[#ffe39a]">เว็บเดิมพันฟุตบอลออนไลน์ที่รวมตลาดจากหลายรายการแข่งขันไว้ให้เลือกผ่านบัญชีเดียว</strong>
        มีทั้งบอลเดี่ยว บอลสเต็ป และบอลสด พร้อมรายการแข่งขันตามฤดูกาลที่ระบบเปิดรับ สำหรับผู้ที่ต้องการติดตามคู่แข่งขันจากหลายลีกโดยไม่ต้องสลับไปมาหลายบัญชี
      </p>

      <p class="text-left text-base leading-relaxed text-[#dbe5f5]">
        หน้านี้รวบรวมไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่รูปแบบการเดิมพันที่เปิดให้เลือก โปรโมชั่นของสมาชิก ระบบบัญชีที่ใช้ตรวจสอบราคา อัตราต่อรอง และประวัติบิล ขั้นตอนการสมัคร
        ไปจนถึงช่องทางสอบถามแอดมินเมื่อไม่แน่ใจในขั้นตอนใด
      </p>

      <p class="text-left text-base leading-relaxed text-[#dbe5f5]">
        <strong class="text-[#ffe39a]">ส่วนคำว่า “ค่าน้ำดีที่สุด” ควรอ้างอิงราคาที่แสดงจริงในขณะนั้น เนื่องจากค่าน้ำและอัตราต่อรองสามารถเปลี่ยนแปลงได้ตามตลาด เวลา และคู่แข่งขัน</strong>
        เช่นเดียวกับรายการลีกและเงื่อนไขของโปรโมชั่นที่เปลี่ยนแปลงได้ตามช่วงเวลา รายละเอียดทั้งหมดจึงยึดตามข้อมูลที่เว็บไซต์แสดงไว้บนบิลจริงในขณะนั้นเป็นหลัก
      </p>
    </div>
  </ContentBox>

  <ContentBox title="BRAVO168 รวมตลาดฟุตบอลหลายรายการไว้ให้เลือกผ่านบัญชีเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dbe5f5]">
        สิ่งที่เว็บไซต์ระบุไว้เป็นตัวตนของ BRAVO168 คือ <strong class="text-[#ffe39a]">การรวมตลาดฟุตบอลจากหลายรายการแข่งขันไว้ให้เลือกผ่านบัญชีเดียว</strong>
        สมาชิกจึงเลือกคู่บอลจากคนละลีกได้จากบัญชีเดิม ไม่ต้องเปิดบัญชีแยกกันไปตามแต่ละรายการ และไล่ดูราคาของแต่ละคู่ได้จากระบบเดียว
      </p>

      <p class="text-left text-base leading-relaxed text-[#dbe5f5]">
        ถัดจากการเลือกคู่แข่งขันคือ<strong class="text-[#ffe39a]">หน้าบัญชีสมาชิกที่รวมอัตราต่อรอง โปรโมชั่น และประวัติบิลไว้ให้ตรวจสอบได้ด้วยตัวเอง</strong>
        หลังปิดบิลแล้วจึงกลับมาตรวจผลเดิมพันและรายการย้อนหลังให้เรียบร้อยได้จากที่เดียว ไม่ต้องจดแยกไว้เองหรือย้อนถามทีละรายการ
      </p>

      <p class="text-left text-base leading-relaxed text-[#dbe5f5]">
        ส่วนรายการลีกและแมตช์ที่เปิดรับจริงนั้น<strong class="text-[#ffe39a]">ขึ้นอยู่กับตารางแข่งขันและผู้ให้บริการในขณะนั้น</strong>
        จึงควรตรวจสอบเวลาปิดรับ อัตราต่อรอง และรายละเอียดบิลก่อนกดยืนยันทุกครั้ง โดยเฉพาะบอลสดที่ราคาและตลาดสามารถเปลี่ยนได้ระหว่างการแข่งขัน
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/ทดลองเล่น"
          aria-label="เปิดหน้าทดลองเล่นของ BRAVO168"
          class="flex items-center justify-center rounded-lg border border-[#0e3f8f] bg-[#072247] px-8 py-3 font-bold text-[#dbe5f5] transition-all hover:scale-105 hover:border-[#f4cb69] hover:bg-[#04142f] hover:text-[#f4cb69]">
          ไปหน้าทดลองเล่น
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="รูปแบบการเดิมพันใน BRAVO168 บอลเดี่ยว บอลสเต็ป และบอลสด" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dbe5f5]">
        ตลาดที่เปิดให้เลือกแบ่งได้เป็นไม่กี่กลุ่มใหญ่ และแต่ละกลุ่ม<strong class="text-[#ffe39a]">มีจังหวะการตัดสินใจและเวลาปิดรับเป็นของตัวเอง</strong>
        ไม่ได้ใช้เงื่อนไขชุดเดียวกันทั้งหมด การรู้ว่าแต่ละกลุ่มต่างกันตรงไหนช่วยให้เลือกรูปแบบที่ตรงกับสไตล์การเดิมพันของตัวเองได้เร็วขึ้น
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#dbe5f5]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f4cb69]">⚽</span>
          <span>
            <strong class="text-[#ffe39a]">บอลเดี่ยว</strong> เหมาะกับผู้ที่ต้องการเลือกผลจากคู่ใดคู่หนึ่ง เป็นรูปแบบที่อ่านราคาและเงื่อนไขได้เร็วที่สุด เพราะทั้งบิลผูกอยู่กับคู่แข่งขันเดียว
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#2f86f0]">🧾</span>
          <span>
            <strong class="text-[#ffe39a]">บอลสเต็ป</strong> รวมหลายคู่ไว้ในบิลเดียว จึงควรไล่ดูราคาและเวลาปิดรับของทุกคู่ในบิลก่อนยืนยัน เพราะแต่ละคู่มีเวลาเริ่มแข่งไม่พร้อมกัน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f4cb69]">⏱️</span>
          <span>
            <strong class="text-[#ffe39a]">บอลสด</strong> เปิดตัวเลือกการเดิมพันระหว่างการแข่งขันตามตลาดที่ระบบรองรับ ราคาและตลาดสามารถเปลี่ยนได้ระหว่างเกม จึงเป็นกลุ่มที่ต้องอ่านหน้าสรุปบิลให้ไวที่สุด
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#2f86f0]">🗓️</span>
          <span>
            <strong class="text-[#ffe39a]">รายการตามฤดูกาล</strong> ทยอยเปิดตลาดตามช่วงเวลาที่กำหนด จำนวนลีกและแมตช์ที่เลือกได้ในแต่ละวันจึงขึ้นอยู่กับตารางแข่งขันและผู้ให้บริการในรอบนั้น
          </span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#dbe5f5]">
        <strong class="text-[#ffe39a]">ค่าน้ำของแต่ละลีกและแต่ละคู่ไม่จำเป็นต้องเท่ากัน</strong>
        เพราะค่าน้ำและอัตราต่อรองสามารถเปลี่ยนตามลีก คู่แข่งขัน ตลาด และช่วงเวลา ก่อนกดยืนยันการเดิมพันจึงควรตรวจสอบราคาล่าสุดที่แสดงบนบิลทุกครั้ง แทนการอ้างจากราคาที่เห็นก่อนหน้านี้
      </p>
    </div>
  </ContentBox>

  <ContentBox title="โปรโมชั่น BRAVO168 คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dbe5f5]">
        สมาชิก BRAVO168 สามารถ <strong class="text-[#ffe39a]">Login เพื่อตรวจสอบโปรโมชั่นที่เปิดให้รับในแต่ละช่วงฤดูกาลจากบัญชีของตนเอง</strong>
        มีทั้งกิจกรรมคืนยอดเสียและโบนัสแนะนำเพื่อน โดยแต่ละรายการอาจกำหนดประเภทการเดิมพัน ลีก ยอดที่เข้าเกณฑ์ และรอบคำนวณแตกต่างกัน ก่อนรับโบนัสจึงควรอ่านเงื่อนไขล่าสุดให้ครบถ้วน
      </p>

      <p class="text-left text-base leading-relaxed text-[#dbe5f5]">
        รายการแรกคือ <strong class="text-[#ffe39a]">โบนัสคืนยอดเสีย 0.3%</strong>
