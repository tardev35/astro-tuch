---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login,
// /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx
// ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึง
// เขียนขึ้นใหม่บนข้อเท็จจริงของ หวย365 เท่านั้น (src/assets/content.txt)
// ผังหัวข้อของหน้านี้: h1x1 · h2x4 · h3x0
//
// ดรอปนี้ (2026-10-03) คือ หวย365 **เว็บแทงหวยออนไลน์** แง่มุมที่บรีฟระบุไว้มีเท่านี้:
// รวมแนวทางหวย กลุ่มหวย สถิติหวยย้อนหลัง และผลหวยตามรอบที่ประกาศไว้ในหน้าเดียว ·
// รายการหวยคือ รัฐบาลไทย ฮานอย ลาวพัฒนา และหวยหุ้นต่างประเทศตามตลาดที่เปิดให้บริการ ·
// ตรวจสอบเวลาเปิดรับ เวลาปิดรับ อัตราจ่าย และผลของแต่ละรายการได้ก่อนเลือกแทง ·
// เลือกเลข ส่งโพย และตรวจสอบรายการผ่านมือถือ · 2 ตัว จ่าย 100 บาท · 3 ตัว จ่าย
// 1,000 บาท · สมัครผ่านมือถือ 3 ขั้นตอน · แอดมิน 24 ชั่วโมง · ไม่เปิดเผยรหัสผ่าน
// PIN หรือ OTP
//
// แบรนด์ก่อนหน้า (NATO168) เป็น **เว็บสล็อต/พีจี** คนละสินค้ากันทั้งหน้า — ย่อหน้าและ
// รายการของสล็อต (สล็อตพีจี ค่ายเกม ฟรีสปิน ตัวคูณ วงล้อ หมวดโบนัสไทม์ คืนยอดเสีย
// 0.3% แนะนำเพื่อน 0.8% รับโบนัสทุกยูส/ไม่มีล็อคยูส) ถูกถอดออก **ทั้งก้อน** แล้วเขียน
// ใหม่เป็นเรื่องของการแทงหวยตามที่บรีฟรอบนี้ระบุจริง ไม่ใช่ find-and-replace ทับ
// ประโยคเดิม เพราะการคงโครงประโยคเดิมไว้แล้วสลับแต่ชื่อแบรนด์ คือวิธีที่ทำให้เว็บใหม่
// ไปอ้างสินค้าที่บรีฟของตัวเองไม่ได้ให้มา
//
// ตัวเลขที่อ้างได้มีแค่ 2 ตัว จ่าย 100 บาท · 3 ตัว จ่าย 1,000 บาท · 3 ขั้นตอน ·
// 24 ชั่วโมง ห้ามเพิ่มใบอนุญาต ชื่อผู้ให้บริการ ชื่อธนาคาร ยอดฝากขั้นต่ำ จำนวนสมาชิก
// ปีที่ก่อตั้ง หรือเวลาออกรางวัลที่บรีฟไม่ได้ระบุ
//
// ประโยคเฮดจ์ที่บรีฟเขียนกำกับไว้เองและห้ามตัดทิ้งเพราะฟังดูไม่ขายของ: ข้อมูลสถิติ
// ช่วยย้อนดูผลรอบที่ผ่านมา แต่ไม่สามารถใช้ยืนยันหรือรับประกันเลขที่จะออกในงวดถัดไปได้ ·
// แนวทางหรือสถิติย้อนหลังเป็นเพียงข้อมูลประกอบ ไม่ได้เพิ่มความแน่นอนในการทายผล ·
// แต่ละรายการอาจกำหนดอัตราจ่ายหรือวงเงินแตกต่างกัน จึงควรยึดรายละเอียดล่าสุดใน
// หน้าส่งโพยก่อนยืนยันรายการ
//
// พาเลตต์ หวย365 (brand-spec §2) **แดงสดนำ ทองรอง บนดำ** — แดงคือสีตัวตนจริง ไม่ใช่
// ทองอีกเฉด: แดงแบรนด์ #dc0203 (ขอบ แถบ) · แดงสว่าง #f5282a (active/hover) ·
// แดงลึก #8c0402 (เงา ปลายไล่เฉดแดง) · ทองอ่อน #ffeab0 (ต้นไล่เฉด ตัวอักษรปุ่มรอง) ·
// ทองแบรนด์ #ffc93c (จุด bullet, marker, หมึกเน้น) · ทองลึก #c08a07 (ขอบ ปลายไล่เฉด
// ปุ่มหลัก) · พื้นยกระดับ #3a0a0c (ปุ่มรอง) · พื้นการ์ด #240406 · หมึกบนพื้นทอง
// #1a0303 · เนื้อความ #f6e7e0 (BRAND_TEXT)
// ชุดทอง-เงินของ NATO168 (#edb543 #fde8a8 #a9761f #e6e6e6 #101010 #17120a #241a09
// #1a1203 #f4ead3 rgba(237,181,67,*) rgba(4,3,0,*)) ออกครบทุกจุดแล้ว
// #00B900/#009900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้
// กฎคอนทราสต์: พื้นทอง → หมึกเข้ม #1a0303 เสมอ และไล่เฉดปุ่มทองจบที่ #c08a07 เท่านั้น
// ห้ามวางหมึกทองอ่อนบนพื้นแดง ปุ่มรองจึงเป็น "ขอบแดงบนพื้นดำอมแดง" ไม่ใช่ถมทองอีกใบ
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// — การ์ดตั้งสีเนื้อความ #f6e7e0 ไว้ที่ตัวการ์ดแล้ว ย่อหน้าจึงไม่ใส่คลาสสีซ้ำ
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจาก
// หน้า และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น AnnouncementHuay ทั้งเว็บ (รอบก่อน NATO168 ใช้
// Announcement5) — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ
// หวย365 แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูดคนละเรื่อง
// กับหน้าอื่น
//
// รอบนี้สองเราต์หวย /ตรวจหวย กับ /แนวทาง อยู่ใน src/pages/ จริง (เว็บหวย) จึงลิงก์ได้
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 154
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} เว็บแทงหวยออนไลน์ที่รวมแนวทางหวย กลุ่มหวย สถิติหวยย้อนหลัง และผลหวยตามรอบไว้ในหน้าเดียว หน้านี้สรุปว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} เว็บแทงหวยออนไลน์ รวมแนวทางหวย กลุ่มหวย สถิติหวย และผลหวยไว้ในหน้าเดียว`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed">
        <strong class="text-[#ffc93c]">{BRAND_NAME} คือเว็บแทงหวยออนไลน์ที่รวมข้อมูลและรายการหวยไว้ในหน้าเดียว</strong>
        ทั้งแนวทางหวย กลุ่มหวย สถิติหวยย้อนหลัง และผลหวยตามรอบที่ประกาศ จุดตั้งต้นของเว็บไซต์คือผู้ที่ต้องการติดตามหลายรายการจากบัญชีเดียว จึงเลือกเลข ส่งโพย และตรวจสอบรายการผ่านมือถือได้สะดวกโดยไม่ต้องเปิดหลายหน้าพร้อมกัน
      </p>

      <p class="text-left text-base leading-relaxed">
        หน้านี้สรุปไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่รายการหวยที่เปิดรับในแต่ละวัน
        <strong class="text-[#ffc93c]">ทั้งรัฐบาลไทย ฮานอย ลาวพัฒนา และหวยหุ้นต่างประเทศตามตลาดที่เปิดให้บริการ</strong>
        อัตราจ่ายของรายการที่เข้าเงื่อนไข ขั้นตอนสมัครแบบ 3 ขั้นตอน ไปจนถึงช่องทางติดต่อแอดมินที่ดูแลตลอด 24 ชั่วโมงเมื่อไม่แน่ใจในขั้นตอนใด
      </p>

      <p class="text-left text-base leading-relaxed">
        สมาชิกย้อนดูผลของรอบที่ผ่านมาและรูปแบบตัวเลขที่เคยออกได้จากหมวดสถิติหวยย้อนหลัง
        <strong class="text-[#ffc93c]">แต่ข้อมูลสถิติไม่สามารถใช้ยืนยันหรือรับประกันเลขที่จะออกในงวดถัดไปได้</strong>
        เพราะผลการออกรางวัลของแต่ละรอบไม่ได้ยืนยันจากสถิติที่ผ่านมา ส่วนแนวทางหวยและกลุ่มหวยเป็นข้อมูลประกอบจากแหล่งหรือกลุ่มต่าง ๆ เท่านั้น
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`รายการหวยที่ ${BRAND_NAME} เปิดรับ และสิ่งที่ควรตรวจก่อนเลือกแทง`} as="h2">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed">
        เว็บ {BRAND_NAME}
        <strong class="text-[#ffc93c]">รวบรวมรายการหวยหลายประเภทสำหรับผู้ที่ต้องการติดตามหลายรอบในบัญชีเดียว</strong>
        หลัง Login จึงเลือกรายการที่ระบบเปิดรับในแต่ละวันได้จากที่เดิม โดยรายการที่เว็บไซต์เปิดให้ติดตามแบ่งออกได้ประมาณนี้
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ffc93c]">🏛️</span>
          <span>
            <strong class="text-[#ffc93c]">หวยรัฐบาลไทย</strong> เปิดรับตามกำหนดออกรางวัลของแต่ละงวด เป็นรายการที่สมาชิกส่วนใหญ่ใช้เป็นหลักในการติดตามผล และควรดูเวลาปิดรับของงวดนั้นให้ชัดก่อนส่งโพย
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ffc93c]">🕒</span>
          <span>
            <strong class="text-[#ffc93c]">หวยฮานอย</strong> มีให้ติดตามหลายรอบ จึงเป็นรายการที่เวลาเปิดรับและเวลาปิดรับต่างกันในแต่ละรอบมากที่สุด ควรตรวจรอบที่กำลังเปิดอยู่ก่อนเลือกเลขทุกครั้ง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ffc93c]">🎫</span>
          <span>
            <strong class="text-[#ffc93c]">หวยลาวพัฒนา</strong> เป็นอีกรายการที่ระบบเปิดรับตามรอบที่ประกาศ สมาชิกตรวจสอบเวลาเปิดรับ เวลาปิดรับ และผลของรอบนั้นได้จากหน้าเว็บไซต์โดยตรง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ffc93c]">📈</span>
          <span>
            <strong class="text-[#ffc93c]">หวยหุ้นต่างประเทศ</strong> เปิดรับตามตลาดที่ให้บริการในแต่ละวัน รายการกลุ่มนี้จึงขึ้นอยู่กับว่าตลาดใดเปิดอยู่ในรอบนั้น ควรดูจากตารางที่ระบบแสดงไว้เป็นหลัก
          </span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed">
        <strong class="text-[#ffc93c]">สมาชิกสามารถตรวจสอบเวลาเปิดรับ เวลาปิดรับ อัตราจ่าย และผลของแต่ละรายการได้ก่อนเลือกแทง</strong>
        นอกจากรายการหวยแล้ว ยังจัดหมวดแนวทางหวย กลุ่มพูดคุย และสถิติย้อนหลังแยกตามประเภทไว้ให้ค้นหาได้ง่ายขึ้น อย่างไรก็ตาม แนวทางหรือสถิติย้อนหลังเป็นเพียงข้อมูลประกอบ ไม่ได้เพิ่มความแน่นอนในการทายผลหวยรอบถัดไป
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/ตรวจหวย"
          aria-label={`เปิดหน้าตรวจผลหวยของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#dc0203]/55 bg-[#3a0a0c] px-8 py-3 font-bold text-[#ffeab0] transition-all hover:scale-105 hover:border-[#f5282a] hover:bg-[#240406] hover:text-[#ffc93c]">
          ไปหน้าตรวจผลหวย
        </a>

        <a
          href="/แนวทาง"
          aria-label={`เปิดหน้าแนวทางหวยของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#dc0203]/55 bg-[#3a0a0c] px-8 py-3 font-bold text-[#ffeab0] transition-all hover:scale-105 hover:border-[#f5282a] hover:bg-[#240406] hover:text-[#ffc93c]">
          ไปหน้าแนวทางหวย
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`อัตราจ่ายของ ${BRAND_NAME} 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท`} as="h2">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed">
        {BRAND_NAME}
        <strong class="text-[#ffc93c]">มีอัตราจ่ายสำหรับรายการที่เข้าเงื่อนไขอยู่สองแบบให้สมาชิกตรวจสอบก่อนส่งโพย</strong>
        โดยกำหนดตามประเภทหวยและรูปแบบการเดิมพันที่เปิดรับในรอบนั้น ก่อนยืนยันโพยควรตรวจสอบอัตราที่แสดงในระบบ รวมถึงเลขที่เลือก ยอดเดิมพัน และรอบหวยให้ถูกต้องทุกครั้ง
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ffc93c]">💵</span>
          <span>
            <strong class="text-[#ffc93c]">2 ตัว จ่าย 100 บาท</strong> ใช้กับรายการที่กำหนดอัตรานี้ไว้ เลือกเลขและยอดได้ตามวงเงินที่ระบบเปิดรับ ก่อนยืนยันโพยควรตรวจสอบว่าราคาดังกล่าวใช้กับหวยประเภทและรูปแบบใด เนื่องจากรัฐบาลไทย ฮานอย ลาวพัฒนา หรือหวยหุ้นอาจไม่ได้ใช้อัตราเดียวกันในทุกรอบ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ffc93c]">💰</span>
          <span>
