---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่ม) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง
//
// บรีฟรอบนี้ (ดรอป 2026-09-21) เปลี่ยนเป็น "สล็อตออโต้Top3 เว็บตรง ติดอันดับมาแรง"
// คอปปี้รอบก่อน ("ไม่ล็อคยูส / โบนัสฝากแรก / ยูสใหม่") เป็นของบรีฟเก่า ถูกเขียนใหม่
// ทั้งหน้าแล้ว ไม่เหลือประโยคเดิม
//
// FAH999 เป็นเว็บ "สล็อต" ไม่ใช่เว็บหวยและไม่ใช่เว็บรวมคาสิโนหลายหมวด
// ข้อเท็จจริงทุกบรรทัดมาจากบรีฟรอบนี้เท่านั้น: สล็อตออโต้Top3 · เว็บตรง ·
// รวมเกมสล็อตจากหลายค่ายไว้ในระบบเดียว · จัดหมวดเกมไว้อย่างชัดเจน ค้นหาจากหน้าเดียว ·
// ระบบออโต้ จัดการบัญชีและเข้าเล่นสะดวก · รองรับทั้งมือถือและคอมพิวเตอร์ ·
// เกมยอดนิยมหลายสไตล์ ทั้งสล็อตโบนัส เกมฟีเจอร์ และเกมแจ็คพอต · เปิดดูข้อมูลของ
// แต่ละเกม รอบโบนัส และระดับเดิมพันก่อนเลือกเล่น · โบนัสคืนยอดเสีย 0.3% ·
// โบนัสแนะนำเพื่อน 0.8% · ตรวจสอบรายละเอียดก่อนกดรับได้จากหน้าโปรโมชั่น ·
// รองรับช่องทางธนาคารและวอลเลทตามรายการที่เว็บไซต์เปิดให้ใช้งาน ตรวจสอบสถานะ
// ฝากถอนและยอดเครดิตจากบัญชีได้โดยตรง · ติดต่อแอดมินเมื่อพบปัญหา
// — ห้ามอ้างเลขใบอนุญาต ปีที่ก่อตั้ง เลขทะเบียนบริษัท จำนวนสมาชิก จำนวนทีมงาน
// รางวัล ที่อยู่บริษัท ชื่อค่ายเกม อัตราจ่ายเป็นตัวเลข "ปลอดภัย 100%" หรือการันตี
// ผลกำไร เพราะบรีฟไม่ได้ระบุไว้ (รวมถึง "บริการ 24 ชั่วโมง" ซึ่งเป็นของบรีฟรอบก่อน)
//
// Announcement รอบนี้หมุนมาใช้ Announcement3 ทั้งเว็บ — default message ของไฟล์นั้น
// เป็นคอปปี้ของ FAH999 รอบนี้อยู่แล้ว จึงเรียกแบบ bare ไม่ต้องส่ง prop
//
// พาเลตต์ FAH999 รอบ 2026-09-21 (ม่วงรอยัล + ทอง แทนดำ+ทองของรอบก่อน):
// ทองสว่าง #fef354 / ทองหลัก #fbbf13 เป็นเกรเดียนต์ ขอบ และออร่า · ทองอ่อน #ffdf6b
// เป็นสี <strong> · ผิวการ์ดม่วง #180430 / #1f0639 / #2a0a4d · ขอบรองม่วงกลาง
// #7c2fd4 · ตัวอักษรบนปุ่มทอง #1f0639 · เนื้อความ #ecdcff
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 158
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "เกี่ยวกับ FAH999 สล็อตออโต้Top3 เว็บตรงที่รวมเกมหลายค่ายไว้ในระบบเดียว จัดหมวดเกมชัดเจน พร้อมระบบออโต้ โปรโมชั่นคืนยอดเสียและแนะนำเพื่อน รองรับธนาคารและวอลเลท";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับเรา FAH999 สล็อตออโต้Top3 เว็บตรง รวมเกมหลายค่ายในระบบเดียว",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา FAH999 สล็อตออโต้Top3 เว็บตรง รวมเกมหลายค่ายในระบบเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับเรา FAH999 สล็อตออโต้Top3 เว็บตรง รวมเกมหลายค่ายในระบบเดียว" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ecdcff]">
        <strong class="text-[#ffdf6b]">FAH999</strong> คือสล็อตออโต้Top3 ที่รวมเกมสล็อตจากหลายค่ายไว้ในระบบเดียว
        เน้น<strong class="text-[#ffdf6b]">ทางเข้าเว็บตรง</strong> ใช้งานง่าย และจัดหมวดเกมไว้อย่างชัดเจน
        จึงเหมาะกับคนที่ต้องการค้นหาเกมยอดนิยมจากหน้าเดียวโดยไม่ต้องไล่เปิดหลายหน้าเพื่อหาว่าค่ายที่สนใจอยู่ตรงไหน
      </p>

      <p class="text-left text-base leading-relaxed text-[#ecdcff]">
        ตัวระบบมา<strong class="text-[#ffdf6b]">พร้อมระบบออโต้ที่ช่วยให้จัดการบัญชีและเข้าเล่นได้สะดวกมากขึ้นบนทั้งมือถือและคอมพิวเตอร์</strong>
        เปิดใช้งานผ่านเว็บเบราว์เซอร์ได้จากเครื่องที่ถนัด หน้านี้รวบรวมไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง
        ตั้งแต่รูปแบบของเกมและการจัดหมวดหมู่ โปรโมชั่นที่กำหนดไว้ในระบบ ช่องทางธนาคารและวอลเลทที่รองรับ
        ไปจนถึงวิธีติดต่อทีมงานเมื่อมีข้อสงสัยระหว่างใช้งาน
      </p>

      <p class="text-left text-base leading-relaxed text-[#ecdcff]">
        <strong class="text-[#ffdf6b]">รายละเอียดทั้งหมดยึดตามรายการที่เว็บไซต์เปิดให้ใช้งานจริงในช่วงนั้นเป็นหลัก</strong>
        เพราะทั้งรายการเกม รายการโปรโมชั่น และช่องทางทำรายการเปลี่ยนแปลงได้ตามรอบอัปเดตของระบบ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="เกมยอดนิยม แตกง่าย แจ็คพอตเข้าไว ของ FAH999" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ecdcff]">
        FAH999 รวบรวม<strong class="text-[#ffdf6b]">เกมยอดนิยมหลายสไตล์ ทั้งสล็อตโบนัส เกมฟีเจอร์ และเกมแจ็คพอตจากหลายค่าย</strong>
        ไว้ในระบบเดียวกัน สมาชิกจึงเลือกได้ว่าอยากเล่นเกมแนวไหนในรอบนั้น แล้วสลับไปลองเกมอื่นภายในบัญชีเดียวกันได้
        โดยไม่ต้องย้ายไปเปิดหน้าอื่น
      </p>

      <p class="text-left text-base leading-relaxed text-[#ecdcff]">
        ก่อนเลือกเล่น <strong class="text-[#ffdf6b]">สมาชิกสามารถเปิดดูข้อมูลของแต่ละเกมได้ก่อน</strong>
        พร้อมตรวจสอบรายละเอียดของรอบโบนัสและระดับเดิมพันได้จากหน้าเกมโดยตรง
        ช่วยให้เลือกเกมที่เหมาะกับสไตล์ของตัวเองได้ง่ายขึ้น และรู้ล่วงหน้าว่าเกมนั้นเล่นอย่างไรก่อนกดรอบแรก
      </p>

      <p class="text-left text-base leading-relaxed text-[#ecdcff]">
        รายการเกมที่เปิดให้ใช้งาน<strong class="text-[#ffdf6b]">เปลี่ยนแปลงได้ตามรอบอัปเดตของระบบ</strong>
        จึงควรตรวจสอบจากหน้าเกมของเว็บไซต์ทุกครั้งก่อนเริ่มเล่น และดูเงื่อนไขของเกมที่สนใจให้ครบก่อนตัดสินใจ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="โปรโมชั่น FAH999 คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ecdcff]">
        โปรโมชั่นสล็อต FAH999 มีสิทธิ์ให้สมาชิกเลือกตามเงื่อนไขของแต่ละรายการ และ<strong class="text-[#ffdf6b]">กดรับได้ทุกฝาก ไม่จำกัด</strong>
        สองรายการหลักคือโบนัสคืนยอดเสียและโบนัสแนะนำเพื่อน โดยสามารถตรวจสอบรายละเอียดก่อนกดรับได้จากหน้าโปรโมชั่น
        ช่วยให้รู้เงื่อนไข ยอดที่เข้าเกณฑ์ และรอบรับสิทธิ์ได้ชัดเจนก่อนใช้งานจริง
      </p>

      <p class="text-left text-base leading-relaxed text-[#ecdcff]">
        <strong class="text-[#ffdf6b]">โบนัสคืนยอดเสีย 0.3%</strong> ให้ตามยอดและเงื่อนไขที่ระบบกำหนด
        โดยสามารถตรวจสอบรอบคำนวณและรายละเอียดของยอดที่เข้าเกณฑ์ได้ก่อนรับสิทธิ์
        ช่วยให้ติดตามโบนัสในแต่ละรอบได้ง่ายและวางแผนการใช้งานเครดิตได้เป็นระบบมากขึ้น
      </p>

      <p class="text-left text-base leading-relaxed text-[#ecdcff]">
        <strong class="text-[#ffdf6b]">โบนัสแนะนำเพื่อน 0.8%</strong> ให้ตามเงื่อนไขที่กำหนด
        สมาชิกสามารถชวนคนรู้จักเข้ามาสมัครผ่านช่องทางที่ระบบรองรับ พร้อมตรวจสอบยอดสิทธิ์และรายละเอียดของโบนัสจากบัญชีสมาชิกได้
        จึงเห็นผลของกิจกรรมแนะนำเพื่อนแต่ละครั้งได้จากที่เดียวโดยไม่ต้องสอบถามทุกรอบ
      </p>

      <p class="text-left text-base leading-relaxed text-[#ecdcff]">
        <strong class="text-[#ffdf6b]">แต่ละรายการมีเงื่อนไขและรอบคำนวณต่างกัน ควรตรวจสอบรายละเอียดก่อนกดรับสิทธิ์ทุกครั้ง</strong>
        และยึดยอดกับสถานะที่ระบบแสดง ณ เวลาที่ทำรายการเป็นหลัก
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ช่องทางธนาคารและวอลเลทที่ระบบ FAH999 รองรับ" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ecdcff]">
        ระบบของ FAH999 <strong class="text-[#ffdf6b]">รองรับช่องทางธนาคารและวอลเลทตามรายการที่เว็บไซต์เปิดให้ใช้งาน</strong>
        สมาชิกจึงเลือกช่องทางที่เหมาะกับตัวเองได้ ไม่ต้องเปิดบัญชีเพิ่มเพียงเพื่อทำรายการ
        และขั้นตอนถูกออกแบบให้ใช้งานง่าย ลดความซับซ้อนในการจัดการรายการแต่ละครั้ง
      </p>

      <p class="text-left text-base leading-relaxed text-[#ecdcff]">
        หลังทำรายการแล้ว <strong class="text-[#ffdf6b]">ตรวจสอบสถานะฝากถอนและยอดเครดิตจากบัญชีของตัวเองได้โดยตรง</strong>
        จึงไม่ต้องรอให้ใครยืนยันแทนก่อนจะรู้ว่ารายการเดินถึงขั้นไหน หากยอดหรือสถานะไม่ตรงกับที่ทำไว้
        ให้เปิดดูประวัติรายการในบัญชีก่อน แล้วแจ้งทีมงานพร้อมเวลาและจำนวนเงินที่ทำรายการ
      </p>

      <p class="text-left text-base leading-relaxed text-[#ecdcff]">
        รายการช่องทางที่เปิดให้ใช้งาน<strong class="text-[#ffdf6b]">เปลี่ยนแปลงได้ตามที่ระบบกำหนด</strong>
        จึงควรตรวจสอบรายการล่าสุดจากหน้าทำรายการก่อนทุกครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ช่องทางติดต่อแอดมินสล็อต FAH999 เมื่อพบปัญหา" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ecdcff]">
        หากพบปัญหาเกี่ยวกับ<strong class="text-[#ffdf6b]">การสมัคร ทางเข้าเว็บ โปรโมชั่น เกม หรือระบบฝากถอน</strong>
        สามารถติดต่อแอดมินสล็อต FAH999 เพื่อสอบถามข้อมูลได้โดยตรง ทีมงานพร้อมช่วยตรวจสอบรายละเอียดและแนะนำขั้นตอนใช้งานตามปัญหาที่แจ้ง
        ช่วยให้ทั้งสมาชิกใหม่และสมาชิกเดิมเข้าถึงข้อมูลได้สะดวกขึ้น
      </p>

      <p class="text-left text-base leading-relaxed text-[#ecdcff]">
        เวลาแจ้งปัญหาเข้ามา ควรระบุเวลาทำรายการ จำนวนเงิน และชื่อผู้ใช้ให้ครบ เพื่อให้ทีมงานตรวจสอบตามข้อมูลที่แจ้งได้เร็วขึ้น
        <strong class="text-[#ffdf6b]">และไม่ควรเปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่นไม่ว่ากรณีใด</strong>
        รวมถึงตรวจสอบให้แน่ใจว่าเป็นช่องทางติดต่อที่ประกาศไว้บนเว็บไซต์ก่อนส่งข้อมูลใด ๆ
      </p>

      <p class="text-left text-base leading-relaxed text-[#ecdcff]">
        <strong class="text-[#ffdf6b]">เกมสล็อตตัดสินผลแต่ละรอบแบบสุ่ม ไม่มีสูตรใดรับประกันผล</strong>
        สมาชิกจึงควรกำหนดงบประมาณก่อนเริ่มเล่นทุกครั้ง และหยุดเมื่อถึงขีดที่ตั้งไว้
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก FAH999"
          class="flex items-center justify-center rounded-lg border border-[#ffdf6b] bg-gradient-to-r from-[#fef354] via-[#fbbf13] to-[#ffdf6b] px-8 py-3 font-black text-[#1f0639] shadow-[0_0_15px_rgba(251,191,19,0.42)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ FAH999"
          class="flex items-center justify-center rounded-lg border border-[#7c2fd4] bg-[#2a0a4d] px-8 py-3 font-bold text-[#ecdcff] transition-all hover:scale-105 hover:border-[#fbbf13] hover:bg-[#1f0639] hover:text-[#ffdf6b]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
