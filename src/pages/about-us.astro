---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login, /register,
// /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx
// ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึง
// เขียนขึ้นใหม่บนข้อเท็จจริงของบรีฟรอบนี้เท่านั้น (src/assets/content.txt)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) จึงเปิดใช้งานอยู่ และรอบนี้ operator สั่งให้
// คงไว้ ไม่ได้ park ลง src/pages-disabled/
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// ตัวที่ routing จริงคือไฟล์นี้ Astro ไม่อ่านโฟลเดอร์นั้นเลย ห้ามแก้และห้ามลบ
//
// ⚠️ ดรอปนี้ (2026-10-12) คือ **คาสิโนออนไลน์รวมทุกหมวด** — บาคาร่า สล็อต รูเล็ต
// ไฮโล แทงบอล บวกหมวดคาสิโนไลฟ์สด **ไม่ใช่เว็บสล็อตล้วน** แบบแบรนด์ก่อน และไม่ใช่
// เว็บลอตเตอรี (สองหน้าของหมวดนั้นจอดอยู่ใน src/pages-disabled/ ไม่มี route ห้าม
// ลิงก์ไปหา เป็น href ตายที่ทำให้ build แดง) หน้าเดิมทั้งหน้าเขียนบนกรอบ "เว็บสล็อต
// ล้วน" ของแบรนด์ก่อน ซึ่งเกือบทุกคำนามเป็นศัพท์ที่ brand-spec §6 สั่งห้ามรอบนี้
// (ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำต้องห้ามเจอ false positive) จึงเขียนใหม่
// ทั้งหน้า ไม่ใช่ find-and-replace ทับประโยคเดิม
//
// แง่มุมที่บรีฟรอบนี้ระบุไว้มีเท่านี้ (ห้ามเติมอย่างอื่น): แบรนด์ที่รวมเกมเดิมพัน
// หลายประเภทไว้ในแพลตฟอร์มเดียว · หมวดคาสิโนไลฟ์สดสำหรับเกมถ่ายทอดสดจากโต๊ะจริง ·
// รองรับมือถือและคอมพิวเตอร์ · Login เพื่อค้นหาเกม ตรวจสอบเครดิต ติดตามรายการ ·
// บาคาร่าเป็นเกมไพ่ที่มีตัวเลือกการเดิมพันตามกติกา · สล็อตมีเกมวงล้อทั่วไป ฟรีสปิน
// ฟีเจอร์ตัวคูณ · รูเล็ตกับไฮโลต่างกันที่รูปแบบการทายผล · แทงบอลมีข้อมูลคู่แข่งขัน
// และอัตราต่อรองให้ตรวจสอบก่อนทำรายการ · คืนยอดเสีย 0.3% เข้ายูสทุกวัน คำนวณจากยอด
// ที่เข้าเกณฑ์ · แนะนำเพื่อน โบนัส 0.8% จากยอดที่เข้าเกณฑ์ ผ่านลิงก์แนะนำ ·
// สมัครสมาชิก 3 ขั้นตอน · ยืนยันบัญชี · ตารางเปิดโต๊ะ/รอบถ่ายทอดสด · แอดมิน
// 24 ชั่วโมง · ช่องทางหลัก · หมายเลขรายการ · PIN · OTP
//
// ⚠️ คำที่ห้ามหลงเหลือ: ศัพท์กรอบ "เว็บสล็อตล้วน" ของแบรนด์ก่อน คำขายของของแบรนด์
// เก่าๆ และศัพท์หมวดลอตเตอรีทุกคำ — รายการเต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาคำต้องห้ามเจอ false positive
//
// ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง
// **รอบนี้ไม่มี "2026"** เพราะบรีฟไม่ได้เอ่ยถึงเลย ห้ามเติมเลขใบอนุญาต หน่วยงาน
// กำกับ ชื่อผู้ดำเนินงาน ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก
// หรือปีที่ก่อตั้ง และ **ห้ามอ้างว่าเซิร์ฟเวอร์อยู่ไทย** — บรีฟบอกเองว่าที่ตั้ง
// เซิร์ฟเวอร์ควรตรวจสอบจากข้อมูลผู้ให้บริการจริง ให้ขนประโยคกำกับนั้นมา ไม่ใช่ขนคำอ้าง
//
// ประโยคกำกับที่บรีฟเขียนไว้เองและห้ามตัดทิ้งเพราะฟังดูไม่ขายของ — ขนมาครบ:
// ส่วนจำนวนค่ายที่เปิดให้บริการและที่ตั้งเซิร์ฟเวอร์ในประเทศไทยควรตรวจสอบจากข้อมูล
// ผู้ให้บริการจริง (h1 ย่อหน้า 3) · สำหรับคำว่ามีโบนัสทุกเกม ควรตรวจสอบว่าหมายถึง
// ฟีเจอร์โบนัสภายในเกมหรือโปรโมชั่นของเว็บไซต์ + บางเกมอาจไม่มีรอบโบนัส + ไม่มีเกม
// ประเภทใดรับประกันผลตอบแทน (h2 #1 ย่อหน้าท้าย) · ควรตรวจสอบว่าโปรโมชั่นครอบคลุม
// ประเภทใดบ้าง (h2 #2 ย่อหน้า 1) · ควรอ่านรายละเอียดประเภทเกมที่ร่วมรายการ เวลาตัดยอด
// และเงื่อนไขการใช้โบนัสก่อนรับทุกครั้ง (h2 #2 รายการแรก) · ส่วนคำว่าไม่จำกัดควรระบุ
// ให้ชัดว่าหมายถึงจำนวนเพื่อน จำนวนครั้งในการรับสิทธิ์ หรือยอดโบนัสสูงสุด (h2 #2
// รายการที่สอง) · ผู้สมัครควรตรวจสอบโดเมนหลัก ข้อมูลผู้ดำเนินงาน และข้อกำหนดการใช้งาน
// ก่อนส่งข้อมูลส่วนตัว รวมถึงตรวจสอบอายุและข้อกฎหมายที่เกี่ยวข้อง (h2 #3 ย่อหน้า 1) ·
// บางเกมอาจมีช่วงปิดปรับปรุงหรือเปลี่ยนรอบถ่ายทอดสด (h2 #3 ย่อหน้า 2) ·
// ไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP (h2 #3 ย่อหน้าท้าย)
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ทองมังกรฮิวเดียวล้วนบนดำสนิท** พลิกออกจาก
// ชุดชมพูฮอตพิงก์-ทองบนพลัมของรอบก่อน (ค่าเดิมอยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive) รอบนี้ **ไม่มีสีที่สองเลย**
// พื้นเพจเป็นดำสนิท (bg.json) จึงไม่มีชั้นที่ลึกกว่าพื้นเพจได้จริง
// ลำดับความลึก: #1b1307 ผิวยก / #120c04 กลาง / #070502 จมสุด / #000000 พื้นเพจ
//
// ลำดับปุ่มสื่อด้วย "ทองถม vs ผิวจมขอบทอง" — คู่พื้น-หมึกคำนวณไว้แล้ว:
// · ปุ่มหลัก (สมัครสมาชิก) ถมทองไล่ #ffe4a3 → #ffc93d ขอบ #8a5c09 หมึก #140d02
//   ⚠️ ไล่เฉดต้องหยุดที่ #ffc93d ห้ามไล่ลงไปเข้มกว่านั้นใต้ตัวอักษร
// · ปุ่มรอง/ปุ่มลิงก์ภายในเป็นชั้นจม #120c04 → #070502 ขอบ #dfa310/50 ตัวอักษร #ffe4a3
// · #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้
// ⚠️ #8a5c09 · #43240b ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่เส้นขอบ ออรา และเงา —
// ออราในไฟล์นี้ใช้ rgba(223,163,16,α) และ rgba(255,201,61,α) เท่านั้น
// ⚠️ "มีทองอยู่" ไม่ใช่ตัวบอกว่าถูกแบรนด์: ทองออกมาแล้วเก้าในสิบเอ็ดรอบหลังสุด
// ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน brand-spec §2 ไม่ใช่เทียบด้วยตาหรือด้วยตระกูลสี
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #f0e9dc,
// 15.3:1 บนผิวยก #1b1307) ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง
// ปล่อยให้สืบทอดลงมา และไม่ใส่ mx-auto / max-w-* บน <p> เพราะการ์ดคุมความกว้างเองแล้ว
// — ที่ประกาศสีได้มีแค่ปุ่ม (ถมพื้นของตัวเองจึงต้องกำหนดหมึกของตัวเอง) และ <strong>
// ซึ่ง brand-spec §2 กำหนดให้ใช้ #ffc93d (10.2:1 บนผิวการ์ด) เป็นสีไฮไลต์ในเนื้อความ
// โดยเฉพาะ และไม่ใช้สีอื่นเลย · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง
// เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาด
// ครึ่ง (ลบแท็ก <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิมเป๊ะ)
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้าง
// จากหน้า และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้หมุนมาเป็น AnnouncementPremium ทั้งเว็บ (รอบก่อนใช้
// Announcement3 — brand-spec §3 หมุนออก) orchestrator ตั้ง default message ของไฟล์
// นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้น
// ตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 153 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} แบรนด์คาสิโนเซิร์ฟไทย รวมบาคาร่า สล็อต รูเล็ต ไฮโล แทงบอล และคาสิโนไลฟ์สดไว้ในแพลตฟอร์มเดียว พร้อมคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} แบรนด์คาสิโนเซิร์ฟไทย รวมเกมเดิมพันไว้ในแพลตฟอร์มเดียว`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#ffc93d]">{BRAND_NAME} คือแบรนด์คาสิโนเซิร์ฟไทยที่นำเสนอเกมเดิมพันออนไลน์หลายประเภทไว้ในแพลตฟอร์มเดียว</strong>
        ทั้งบาคาร่า สล็อต รูเล็ต ไฮโล และแทงบอล พร้อมหมวดคาสิโนไลฟ์สดสำหรับผู้ที่สนใจเกมถ่ายทอดสดจากโต๊ะจริง รองรับการใช้งานผ่านมือถือและคอมพิวเตอร์
      </p>

      <p>
        หน้านี้สรุปไว้ว่าภายในระบบมีอะไรให้ใช้งานบ้าง ตั้งแต่หมวดเกมที่จัดไว้ให้เลือกตามความสนใจ
        <strong class="text-[#ffc93d]">ไปจนถึงเมนู Login เพื่อค้นหาเกม ตรวจสอบเครดิต และติดตามรายการต่างๆ ได้สะดวก</strong>
        เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดดูอะไรตรงไหน แล้วจึงค่อยลงรายละเอียดของรายการที่สนใจเป็นรายรายการ
      </p>

      <p>
        <strong class="text-[#ffc93d]">ส่วนจำนวนค่ายที่เปิดให้บริการและที่ตั้งเซิร์ฟเวอร์ในประเทศไทยควรตรวจสอบจากข้อมูลผู้ให้บริการจริง</strong>
        เช่นเดียวกับโดเมนหลักและข้อมูลผู้ดำเนินงานที่ควรตรวจสอบให้ชัดเจนก่อนส่งข้อมูลส่วนตัว ข้อมูลในหน้านี้จึงเขียนไว้เพื่อบอกว่าระบบมีอะไรให้ใช้และควรตรวจอะไรก่อนตัดสินใจ
        ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้งาน
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`หมวดเกมเดิมพันที่ ${BRAND_NAME} รวมไว้ในแพลตฟอร์มเดียว`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} รวบรวมเกมคาสิโนและการเดิมพันกีฬาไว้หลายรูปแบบ จุดเด่นอยู่ที่การรวมหมวดเกมและข้อมูลสมาชิกไว้ในแพลตฟอร์มเดียว
        <strong class="text-[#ffc93d]">ช่วยให้ค้นหาเกมที่สนใจ ตรวจสอบเครดิต และติดตามรายการต่างๆ ได้สะดวกผ่านอุปกรณ์ที่ใช้งานอยู่</strong>
        ทั้งบนหน้าจอมือถือและคอมพิวเตอร์ ประเภทเกมที่เว็บไซต์ระบุไว้แบ่งออกได้ประมาณนี้
      </p>

      <ul class="flex flex-col gap-3" aria-label={`หมวดเกมเดิมพันบนแพลตฟอร์มของ ${BRAND_NAME}`}>
        <li class="flex gap-3">
          <span aria-hidden="true">🃏</span>
          <span>
