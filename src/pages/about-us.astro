---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็น **บทความจริง** (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login,
// /register หรือหน้าภาพแบบ /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง
// ไม่ใช่เช็กลิสต์หัวข้อของบรีฟที่ใช้กับ index.astro — บรีฟรอบนี้
// (src/assets/content.txt, 29 บรรทัด) ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าใหม่จาก
// ข้อเท็จจริงและคลังคำของบรีฟรอบนี้เท่านั้น (.claude/brand-spec-zoro365.md §4-§5)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x5 · h3x0
//   h1  เกี่ยวกับเรา <แบรนด์> เว็บเกมคาสิโนออนไลน์ ไม่ผ่านเว็บตัวแทน
//   h2  บาคาร่า สล็อต หวย บอล ไฮโล ห้าหมวดเกมที่ <แบรนด์> รวบรวมไว้
//   h2  ข้อมูลที่ควรตรวจสอบก่อนเชื่อคำกล่าวอ้างบนหน้าเว็บ
//   h2  ระบบสมาชิกของ <แบรนด์> และการสมัครที่ระบุว่าไม่มีขั้นต่ำ
//   h2  โปรโมชั่นที่ <แบรนด์> ระบุไว้ คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%
//   h2  แอดมิน <แบรนด์> และช่องทางติดต่อตลอด 24ชม.
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) และจาก footer จึงเปิดใช้งานอยู่
// ⚠️ หัวข้อของหน้านี้ **ตั้งใจไม่ให้ซ้ำกับหัวข้อของ index.astro** — index เล่าว่า
// เว็บไซต์ "ระบุอะไรไว้" ตามลำดับของบรีฟ ส่วนหน้านี้เล่าว่า "ตรวจสอบอะไรได้จากที่ไหน"
// ถ้ารอบหน้าคัดลอกหัวข้อของ index มาวางที่นี่ จะได้สองหน้าที่แข่งกันเองใน index
//
// 🚨🚨 ดรอปนี้ (2026-10-28) แบรนด์ขาออกอยู่หมวดธุรกิจเดียวกัน (เว็บเดิมพันออนไลน์)
// แต่ **คนละคำนิยามตัวเองทั้งชุด** เนื้อหาทั้งหน้าจึงถูก **เขียนใหม่** ไม่ใช่แค่
// เปลี่ยนชื่อแบรนด์ บรีฟรอบนี้เรียกตัวเองว่า "เกมคาสิโนสายตรง รวมเกมเดิมพันออนไลน์
// ถูกลิขสิทธิ์ ไม่ผ่านเว็บตัวแทน" และระบุ ห้าหมวดเกม (บาคาร่า สล็อต หวย บอล ไฮโล) ·
// แทงได้เท่าไหร่ เว็บจ่ายเต็ม ไม่มีโกง · ระบบสมาชิก · โปรโมชั่นอัปเดตใหม่ตลอดสัปดาห์ ·
// คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · สมัคร 3 ขั้นตอน · แอดมินตลอด 24ชม.
// 🚨🚨 **คำที่พลาดง่ายที่สุดสองคำของรอบนี้ — ตัวเต็มอยู่ใน brand-spec §5 เท่านั้น
//   ไม่พิมพ์ที่นี่ เพื่อให้ grep หาคำของแบรนด์เก่าใน src/ ได้คำตอบว่างจริงๆ**:
//   วลีย่อของแบรนด์ขาออกที่หมายถึงเซิร์ฟเวอร์ต่างประเทศ และวลีของอีกแบรนด์ที่
//   พูดถึงการไม่ผ่านตัวกลาง — **รอบนี้ใช้คำว่า "ไม่ผ่านเว็บตัวแทน" แทนทั้งคู่**
// ⚠️⚠️ ศัพท์หมวดธุรกิจของแบรนด์ขาออกเป็น **คำค้างข้ามแบรนด์** ห้ามหลุดกลับมา
// **รายการคำต้องห้ามเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่** เพื่อไม่ให้
// sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// 🚨🚨 **บรีฟรอบนี้ไม่พูดถึงธนาคาร วอลเลท หรือการฝากถอนเลยแม้แต่คำเดียว**
// — รอบก่อนๆ เคยมีหัวข้อ "ระบบฝากถอน" อยู่บนหน้านี้ **ถูกตัดออกและห้ามเขียนกลับ**
// ข้อยกเว้นเดียวคือ **ประโยคกำกับของบรีฟเอง** (บรรทัด 14) ที่บอกให้ตรวจสอบว่า
// "ไม่มีขั้นต่ำ" ครอบคลุมเฉพาะการสมัครหรือรวมถึงการฝากเงินและการเดิมพันด้วย —
// นั่นคือคำของบรีฟ ไม่ใช่การเปิดหมวดฝากถอน
// ⚠️⚠️ **หวย รอบนี้ใช้ได้ในฐานะ "หนึ่งในห้าหมวดเกม" เท่านั้น** ห้ามเขียนเนื้อหา
// เฉพาะทางหวย (รายการคำเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ที่นี่)
// และ **สองหน้าหมวดหวยยังอยู่ใน src/pages-disabled/ (ชื่อไฟล์อยู่ใน brand-spec §7)
// ห้ามลิงก์ไปหาเด็ดขาด** ลิงก์ตาย = build แดง
// ⚠️⚠️ ชื่อแบรนด์รอบนี้เป็น **ตัวละตินพิมพ์ใหญ่ + เลข เขียนติดกันไม่มีเว้นวรรค**
// ทุกจุด interpolate จาก BRAND_NAME เพื่อไม่ให้ค้างเป็นชื่อแบรนด์ก่อนหน้าตอน
// รีแบรนด์รอบถัดไป **ห้ามพิมพ์ชื่อแบรนด์เป็น literal ในไฟล์นี้**
//
// ⚠️ route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ทดลองเล่น · /about-us · /contact-us · /terms · /privacy · /line
// ⚠️ toggle cta เปิดอยู่ → /register และ /login เป็นเมนู navbar เองแล้ว และ
// /ทางเข้า ถูกถอดออกจากเมนูด้วยเหตุผลว่ามันเป็นลิงก์ที่สามไปยังสองที่เดิม —
// หน้านี้จึงไม่วางปุ่ม "ไปหน้าทางเข้า" ซ้ำอีก (หน้ายัง route + index อยู่ตามปกติ
// และ footer ยังลิงก์ไปหาได้)
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกม ชื่อผู้ให้บริการ หน่วยงานกำกับ เลขใบอนุญาต
// ปีก่อตั้ง จำนวนสมาชิก จำนวนเกม ค่า RTP หรือยอดขั้นต่ำที่เป็นตัวเลข แม้แต่
// รายการเดียว** จึงห้ามเขียนลงหน้าเว็บ · ตัวเลขที่ขึ้นหน้าได้มีแค่ของบรีฟเอง:
// **0.3% · 0.8% · 3 ขั้นตอน · 24ชม.**
//
// 🚨 **บรีฟรอบนี้โฆษณาแล้วกำกับตัวเองในย่อหน้าเดียวกันแทบทุกย่อหน้า** — ทั้งสอง
// ครึ่งต้อง ship ครบ ประโยคกำกับไม่ใช่ filler ให้ตัดทิ้ง:
// 1) ควรตรวจสอบข้อมูลบริษัทและหลักฐานการได้รับอนุญาตจากแหล่งที่เชื่อถือได้ก่อนใช้งาน
//    (บรีฟบรรทัด 4 — รับที่ h1 และ h2 #2)
// 2) ควรตรวจสอบวงเงินเดิมพันขั้นต่ำและสูงสุด รวมถึงข้อกำหนดการถอนเงินก่อนทำรายการ ·
//    แม้เว็บไซต์จะระบุว่าจ่ายเต็มและไม่มีโกง แต่ควรตรวจสอบหลักฐานการดำเนินงานและ
//    เงื่อนไขการจ่ายรางวัลให้ชัดเจน เพราะไม่สามารถรับประกันความน่าเชื่อถือหรือ
//    ผลตอบแทนจากข้อความโฆษณาเพียงอย่างเดียว (บรีฟบรรทัด 6 — รับที่ h2 #1 และ #2)
// 3) ควรตรวจสอบข้อกำหนดด้านอายุ กฎหมายที่เกี่ยวข้อง และนโยบายความเป็นส่วนตัว ·
//    ควรตรวจสอบว่าข้อความไม่มีขั้นต่ำครอบคลุมเฉพาะการสมัครหรือรวมถึงการฝากเงิน
//    และการเดิมพันด้วย · ไม่เปิดเผยรหัสผ่านและรหัส OTP ให้ใครทราบ
//    (บรีฟบรรทัด 14, 18 — รับที่ h2 #3)
// 4) โปรโมชั่นแต่ละรายการอาจกำหนดประเภทเกม ยอดที่นำมาคำนวณ และข้อจำกัดการถอนเงิน
//    แตกต่างกัน · โปรโมชั่นคืนยอดเสียไม่ได้รับประกันว่าจะได้รับเงินคืนจากทุกการ
//    เดิมพันหรือเพิ่มโอกาสชนะในครั้งถัดไป · แม้ระบุว่าไม่จำกัด แต่ควรตรวจสอบว่ามี
//    ข้อกำหนดเกี่ยวกับจำนวนบัญชี วงเงินโบนัส หรือเงื่อนไขการถอนเงินหรือไม่
//    (บรีฟบรรทัด 8, 10, 12 — รับที่ h2 #4)
// 5) ควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชี
//    แอบอ้าง · เก็บหมายเลขรายการและหลักฐานไว้ · ตรวจสอบเวลาการให้บริการจริงจาก
//    ประกาศล่าสุดอีกครั้ง (บรีฟบรรทัด 22 — รับที่ h2 #5)
//
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) **กลับทิศ 180° จากรอบก่อน: รอบนี้มืดทั้งเว็บ**
// bg.json ของดรอปนี้คือ {"mode":"color","color":"#002908"} = **เขียวป่าจมเกือบดำ**
// (รอบก่อนเป็นขาวอมมิ้นต์จาง ซึ่งอยู่คนละปลายของสเกล — เปิด bg.json อ่านทุกรอบ
// ห้ามสืบทอด)
// **ห้าม "แก้" การ์ด/ปุ่มกลับไปเป็นพื้นขาว** — พื้นขาวบนหมึก #eef7f0 =
// ตัวอักษรหายไปเลย ไม่ใช่แค่จางลง
// ค่าที่ใช้ได้ในไฟล์นี้: `<strong>`/marker **#3ddc4a** (6.9:1 บนการ์ด #073c1a) ·
// เนื้อความ #eef7f0 (12.0:1) · หมึกรอง #9dc2a5 (6.3:1) · เงินโครเมียม #dfe6e3
// (9.9:1) · ทองอำพัน #e8c86a (8.0:1) · พื้นไล่เฉดปุ่มหลัก #0e5424 -> #1e7033 ->
// #23823a (**พื้นถม** + หมึกขาว #ffffff — 8.4 / 6.1 / 4.9:1 ต่อ stop) · ปุ่มรอง
// เป็น #073c1a -> #0e5424 คู่กับหมึก #eef7f0 · ปุ่ม outline ขอบ+ตัวอักษร #3ddc4a
// บนผิว #031b09 · ชั้นยก/ชิป #0e5424 · เส้นบาง #1e7033 · ขอบตกแต่ง #35a043
// (**สองค่าท้ายห้ามถือตัวอักษร**)
// หมึกเนื้อความคือ #eef7f0 (= BRAND_TEXT) ซึ่ง **ไม่ประกาศในไฟล์นี้** การ์ด
// ContentBox ตั้งไว้ให้แล้วและย่อหน้าสืบทอดลงมา
// 🚨🚨 **#35a043 บนการ์ดได้แค่ 3.8:1 และ #1e7033 ได้ 2.1:1 — ห้ามเป็นสีตัวอักษร**
// สองค่านั้นเป็นเส้น/ขอบ/ออรา/พื้นถมเท่านั้น ปุ่มหลักจึงจบไล่เฉดที่ #23823a
// ออราที่อนุญาต: rgba(61,220,74,α) · rgba(1,13,4,α) · rgba(232,200,106,α) ·
// rgba(223,230,227,α)
// ⚠️⚠️ **รอบนี้ไม่มีม่วง/ฟ้า/ไซแอน/แมเจนต้า/ส้มเพลิง/แดงเป็นสี UI เลยสักค่า**
// (ทั้งชุดคือพาเลตของแบรนด์ก่อนๆ) ยกเว้น **LINE green #00B900** บนปุ่ม LINE
// ซึ่งเป็นสีประจำแพลตฟอร์ม (ต้องเป็นพื้นถม bg ของค่านั้น + ตัวอักษรขาว)
// ⚠️⚠️ **รอบนี้เป็นแบรนด์เขียว/เงินโครเมียม/ทองอำพัน และรอบก่อนทันทีก็เป็น
// เขียว/เงินโครเมียม/ทองอำพันเหมือนกันเป๊ะ ต่างแค่กลับทิศสว่าง-มืด** จึงห้ามเทียบ
// ด้วยวงศ์สี ต้องเทียบ **ทีละค่า** กับตาราง brand-spec §2 เฮกซ์ของแบรนด์เก่าใน
// คอมเมนต์เขียนแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep สะดุด (คู่ที่พิมพ์ผิดง่ายสุด:
// e8fbe4 ↔ eef7f0 · c6cfd2 ↔ dfe6e3 · e3bb45 ↔ e8c86a · 28c437 ↔ 3ddc4a ·
// b4d6ad ↔ 9dc2a5 · 15401d ↔ 0e5424 · 0c3a16 ↔ 073c1a)
// ⚠️ กิโมโนลายดอกไม้เขียว-ขาว ดาบคาทานะ ชิปคาสิโนเขียว มงกุฎทอง กอไผ่ ดอกไม้ขาว
// และสีผิวนักแสดงในอาร์ตเวิร์กเป็น **วัตถุในภาพ ไม่ใช่สี UI**
// · และ **เวิร์ดมาร์กโครเมียมเงิน-เขียวมรกตก็เป็นอาร์ตเวิร์ก ไม่ใช่สี UI**
//
// ลำดับปุ่มในไฟล์นี้สื่อด้วยพื้นถมสามขั้ว (ตรงกับคู่ปุ่มที่ล็อกไว้ใน brand-spec §2):
// · ปุ่มหลัก (สมัครสมาชิก) ไล่เฉด #0e5424 -> #1e7033 -> #23823a หมึกขาว #ffffff
// · ปุ่มรอง (เข้าสู่ระบบ) ไล่เฉด #073c1a -> #0e5424 หมึก #eef7f0 ขอบ #35a043
// · ปุ่มลิงก์ภายในเป็นปุ่ม outline ขอบ #3ddc4a ตัวอักษร #3ddc4a บนผิว #031b09
//   hover ยกพื้นขึ้นเป็นชั้นยก #0e5424
// · ชิปไอคอนของรายการใช้ขอบ #1e7033 บนชั้นยก #0e5424 ไม่ถือตัวอักษร
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง และไม่ใส่ mx-auto / max-w-* บน <p>
// เพราะการ์ดคุมความกว้างเองแล้ว — ที่ประกาศสีได้มีแค่ปุ่ม ชิปไอคอน marker ของ
// ลำดับเลข และ <strong> · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง
// เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำ
// จะขาดครึ่ง (ลบแท็ก <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิม) และห้ามวาง
// <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังใน prop ที่เป็นข้อความ และต้องเป็นไอคอนหมวดเกมคาสิโนของรอบนี้
// slot ของ ContentBox รับ **หนึ่ง element** เท่านั้น จึงห่อด้วย <div> ชั้นเดียว
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: รูปของดรอปนี้ถูกตรึงไว้ที่อื่นครบทุกไฟล์ —
// สไลด์สองใบของดรอปถูกตรึงไว้กับ index และ /promotion · banner1 /
// banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// แบนเนอร์ใบที่สองและสาม (2026-10-23) กับสไลด์ใบที่สามและสี่ (2026-09-29)
// เป็นอาร์ตเวิร์กของแบรนด์อื่น **ห้าม import ทั้งสี่ไฟล์**
// (ชื่อไฟล์เต็มอยู่ใน brand-spec §6) (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง
// dist/ และ verify-build จะแดง) — ไฟล์ทั้งหมดยังอยู่บนดิสก์ **ห้ามลบ**
// เป็นอินเวนทอรีของแบรนด์ถัดไป · อาร์ตสต็อก gamedemo8/gamedemo16 ถูกตรึงไว้กับ
// /ทดลองเล่น
//
// Announcement รอบนี้หมุนมาเป็นตัวท้ายชื่อเลขสาม ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ตัวท้ายชื่อ Premium จึงหมุนออก · เขียนชื่อไฟล์แบบไม่มีเครื่องหมายคำพูดโดยตั้งใจ
// เพราะ tools/gen-tw-sources.mjs นับ literal ที่มีเครื่องหมายคำพูดว่าเป็นการ import
// จริง) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว
// จึงเรียกแบบ bare **ห้ามส่ง prop message** มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -c บนเชลล์นี้
// ก็นับเป็นไบต์ ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับตัวนับ
// ของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 155 อักขระ (ชื่อแบรนด์รอบนี้ 7 อักขระ) เป็นประโยคเดียวที่บอกว่า
// หน้านี้มีอะไร แล้วหยุด
// (Google ตัดราว 155 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนๆ ยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} เว็บเกมคาสิโนที่รวมบาคาร่า สล็อต หวย บอล ไฮโล พร้อมข้อมูลระบบสมาชิก โปรโมชั่นคืนยอดเสียและแนะนำเพื่อน และช่องทางติดต่อแอดมินตลอด 24ชม.`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} เว็บเกมคาสิโนออนไลน์ ไม่ผ่านเว็บตัวแทน`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

// คลาสปุ่มสามขั้วของหน้านี้ ประกาศครั้งเดียวแล้วใช้ซ้ำ เพื่อไม่ให้สองปุ่มที่ทำ
// หน้าที่เดียวกันหลุดไปคนละเฉดตอนรีแบรนด์รอบหน้า
const ctaPrimary =
  "flex items-center justify-center rounded-full border border-[#35a043] bg-gradient-to-b from-[#0e5424] via-[#1e7033] to-[#23823a] px-8 py-3 font-black text-white shadow-[0_6px_18px_rgba(1,13,4,0.45)] transition-transform hover:scale-105";

const ctaSecondary =
  "flex items-center justify-center rounded-full border border-[#35a043] bg-gradient-to-b from-[#073c1a] to-[#0e5424] px-8 py-3 font-bold text-[#eef7f0] shadow-[0_6px_18px_rgba(1,13,4,0.4)] transition-transform hover:scale-105";

const ctaQuiet =
  "flex items-center justify-center rounded-full border-2 border-[#3ddc4a] bg-[#031b09] px-8 py-3 font-bold text-[#3ddc4a] shadow-[0_4px_14px_rgba(1,13,4,0.4)] transition-all hover:scale-105 hover:bg-[#0e5424] hover:shadow-[0_6px_18px_rgba(61,220,74,0.28)]";

const listChip = "mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#1e7033] bg-[#0e5424] text-sm";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#3ddc4a]">{BRAND_NAME} นำเสนอข้อมูลเกมคาสิโนออนไลน์หลากหลายประเภท พร้อมรายละเอียดระบบสมาชิก โปรโมชั่น และช่องทางติดต่อเจ้าหน้าที่</strong>
        หน้านี้สรุปไว้ว่าเว็บไซต์ระบุอะไรไว้บ้าง และควรเปิดอ่านรายละเอียดส่วนไหนก่อน เพื่อให้เห็นภาพรวมก่อนไล่อ่านเงื่อนไขของแต่ละรายการเป็นรายข้อ
      </p>

      <p>
        เว็บไซต์อธิบายตัวเองไว้ว่าเป็นเกมคาสิโนสายตรงที่รวมเกมเดิมพันออนไลน์ไว้ในที่เดียว เป็นเกมถูกลิขสิทธิ์ และ
        <strong class="text-[#3ddc4a]">ไม่ผ่านเว็บตัวแทน</strong>
        ซึ่งทั้งหมดนั้นเป็นข้อความที่เว็บไซต์แจ้งไว้ ไม่ใช่ข้อสรุปของหน้านี้ เพราะข้อมูลแต่ละชุดถูกแยกไว้คนละหน้า และแต่ละเกมก็มีเงื่อนไขของตัวเองที่ไม่ได้เหมือนกันทั้งหมด
      </p>

      <p>
        <strong class="text-[#3ddc4a]">ส่วนคำกล่าวอ้างเกี่ยวกับการเป็นคาสิโนสายตรงหรือเกมถูกลิขสิทธิ์ ควรตรวจสอบข้อมูลบริษัทและหลักฐานการได้รับอนุญาตจากแหล่งที่เชื่อถือได้ก่อนใช้งาน</strong>
        เนื้อหาในหน้านี้จึงเขียนไว้ประกอบการใช้งานเท่านั้น ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้บริการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`บาคาร่า สล็อต หวย บอล ไฮโล ห้าหมวดเกมที่ ${BRAND_NAME} รวบรวมไว้`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#3ddc4a]">{BRAND_NAME} รวบรวมข้อมูลเกมเดิมพันไว้ห้าหมวด ซึ่งแต่ละหมวดมีรูปแบบการเดิมพันและอัตราจ่ายแตกต่างกัน</strong>
        รายการด้านล่างคือหมวดที่เว็บไซต์ระบุไว้ และเป็นจุดเริ่มต้นสำหรับคนที่ยังไม่แน่ใจว่าควรเปิดอ่านกติกาของส่วนไหนก่อน
      </p>

      <ul class="flex flex-col gap-4" aria-label="หมวดเกมเดิมพันที่เว็บไซต์ระบุไว้">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🃏</span>
          <span>
            <strong class="text-[#3ddc4a]">บาคาร่า</strong> เป็นเกมไพ่ที่คิดผลจากแต้มของสองฝั่ง รูปแบบการวางเดิมพันและอัตราจ่ายของแต่ละช่องไม่เท่ากัน จึงควรอ่านกติกาของโต๊ะที่กำลังเปิดอยู่ก่อนลงเดิมพัน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎰</span>
          <span>
            <strong class="text-[#3ddc4a]">สล็อต</strong> เป็นเกมหมุนวงล้อที่แต่ละเกมมีเงื่อนไขการคิดรางวัลของตัวเอง ข้อความรวมที่หน้าแรกเป็นคำอธิบายภาพรวม ไม่ได้แทนรายละเอียดของเกมที่เปิดอยู่จริง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎫</span>
          <span>
            <strong class="text-[#3ddc4a]">หวย</strong> เป็นหนึ่งในหมวดที่เว็บไซต์ระบุไว้ โดยรายละเอียดรอบที่เปิดรับและเงื่อนไขการรับรางวัลให้ดูจากหน้าของหมวดนั้นในขณะใช้บริการ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>⚽</span>
          <span>
            <strong class="text-[#3ddc4a]">บอล</strong> เป็นการเดิมพันผลการแข่งขัน ซึ่งมีรูปแบบการคิดผลหลายแบบในแต่ละคู่ จึงควรอ่านเงื่อนไขของบิลที่กำลังทำรายการให้ครบก่อนยืนยัน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎲</span>
          <span>
            <strong class="text-[#3ddc4a]">ไฮโล</strong> เป็นเกมทอยลูกเต๋าที่แต่ละช่องเดิมพันมีอัตราจ่ายต่างกัน จึงควรดูตารางอัตราจ่ายของโต๊ะนั้นก่อนเลือกช่องที่จะลง
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#3ddc4a]">ผู้ใช้งานควรตรวจสอบวงเงินเดิมพันขั้นต่ำและสูงสุด รวมถึงข้อกำหนดการถอนเงินก่อนทำรายการ</strong>
        เพราะเกมแต่ละหมวดอาจกำหนดไว้ไม่เหมือนกัน และรายการที่เปิดให้บริการในแต่ละช่วงก็ไม่ได้ครบทุกหมวดเสมอไป
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/ทดลองเล่น" aria-label={`เปิดหน้าทดลองเล่นของ ${BRAND_NAME}`} class={ctaQuiet}>ไปหน้าทดลองเล่น</a>

        <a href="/promotion" aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`} class={ctaQuiet}>ดูภาพโปรโมชั่น</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="ข้อมูลที่ควรตรวจสอบก่อนเชื่อคำกล่าวอ้างบนหน้าเว็บ" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        หัวข้อบนหน้าเว็บระบุไว้ว่า
        <strong class="text-[#3ddc4a]">แทงได้เท่าไหร่ เว็บจ่ายเต็ม ไม่มีโกง</strong>
        ซึ่งเป็นถ้อยคำโฆษณาของเว็บไซต์เอง หัวข้อนี้จึงแยกให้ชัดระหว่างสิ่งที่เว็บไซต์ระบุไว้ กับสิ่งที่ผู้ใช้งานตรวจสอบเองได้จากหน้ารายละเอียดจริง
      </p>

      <ul class="flex flex-col gap-4" aria-label="สิ่งที่ควรตรวจสอบด้วยตัวเองก่อนใช้งาน">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🏢</span>
          <span>
            <strong class="text-[#3ddc4a]">ข้อมูลบริษัทและหลักฐานการได้รับอนุญาต</strong> ควรตรวจสอบจากแหล่งที่เชื่อถือได้ก่อนใช้งาน เพราะคำกล่าวอ้างเรื่องการเป็นคาสิโนสายตรงหรือเกมถูกลิขสิทธิ์ยืนยันจากข้อความบนหน้าเว็บอย่างเดียวไม่ได้
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🧾</span>
          <span>
            <strong class="text-[#3ddc4a]">หลักฐานการดำเนินงานและเงื่อนไขการจ่ายรางวัล</strong> ควรตรวจสอบให้ชัดเจน เพราะไม่สามารถรับประกันความน่าเชื่อถือหรือผลตอบแทนจากข้อความโฆษณาเพียงอย่างเดียว
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📄</span>
          <span>
            <strong class="text-[#3ddc4a]">รายชื่อเกมและผู้ให้บริการที่เปิดใช้งานจริง</strong> ควรดูจากหน้ารายละเอียดในขณะใช้บริการ ว่าตรงกับหมวดที่ประกาศไว้หรือไม่ แทนที่จะอ่านจากข้อความสรุปที่เขียนไว้ล่วงหน้า
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#3ddc4a]">หน้านี้จึงชี้ว่าควรอ่านอะไรและเปิดดูจากที่ไหน แทนที่จะยืนยันแทนเว็บไซต์</strong>
        เพราะสิ่งที่ยืนยันได้จริงคือเอกสารและเงื่อนไขที่แสดงอยู่บนหน้ารายละเอียดในขณะใช้บริการ ไม่ใช่ข้อความสรุปที่เขียนไว้ล่วงหน้า
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`ระบบสมาชิกของ ${BRAND_NAME} และการสมัครที่ระบุว่าไม่มีขั้นต่ำ`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#3ddc4a]">{BRAND_NAME} ระบุช่องทางสมัครสมาชิกผ่านโทรศัพท์มือถือและอุปกรณ์ที่เชื่อมต่ออินเทอร์เน็ต โดยขั้นตอนทั่วไปมีสามขั้นตอน คือเข้าสู่หน้าลงทะเบียน กรอกข้อมูล และยืนยันบัญชี</strong>
        ก่อนดำเนินการควรตรวจสอบข้อกำหนดด้านอายุ กฎหมายที่เกี่ยวข้อง และนโยบายความเป็นส่วนตัวของเว็บไซต์ให้ครบ
      </p>

      <ol class="ml-6 list-decimal space-y-3 marker:font-black marker:text-[#3ddc4a]">
        <li>
          <strong class="text-[#3ddc4a]">เข้าสู่หน้าสมัครสมาชิก</strong> เปิดเว็บไซต์ผ่านเบราว์เซอร์บนมือถือ ตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง จากนั้นเลือกเมนูสมัครสมาชิกและอ่านข้อกำหนดการเปิดบัญชี รวมถึงรายละเอียดการใช้บริการก่อนดำเนินการ
        </li>
        <li>
          <strong class="text-[#3ddc4a]">กรอกข้อมูลและยืนยันบัญชี</strong> กรอกข้อมูลตามที่เว็บไซต์กำหนด ตรวจสอบความถูกต้องก่อนยืนยัน และตั้งรหัสผ่านที่คาดเดาได้ยาก ไม่ควรใช้ข้อมูลของบุคคลอื่นหรือเปิดเผยรหัสผ่านและรหัส
          OTP ให้ใครทราบ
        </li>
        <li>
