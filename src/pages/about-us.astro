---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxCyberCut.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// YADOM168 เป็นเว็บสล็อต — รวมเกมสล็อตจากหลายค่ายไว้ในบัญชีเดียว ระบบออโต้
// เนื้อหาทั้งหน้าเขียนตามบรีฟของแบรนด์นี้เท่านั้น: หลายค่ายในบัญชีเดียว · เกมที่รองรับ
// เบทต่ำ 1 บาทตามช่วงเดิมพันของแต่ละเกม (พร้อมคำเตือนให้ตรวจขั้นต่ำก่อนกด Spin)
// · ระบบออโต้จัดการเครดิต ฝากถอน ตรวจสอบรายการ · โปรแนะนำเพื่อน โบนัส 0.8%
// · สมัครเองได้ผ่านระบบออนไลน์ · แอดมินดูแลตลอด 24 ชั่วโมง
// — บรีฟรอบนี้ไม่มี "คืนยอดเสีย 0.3%" จึงไม่เขียนถึง (สไลด์ที่พิมพ์ 0.3% อยู่บนภาพ
// เป็นของ index.astro และห้ามยกมาเป็นข้อความบนหน้านี้)
// — ไม่มีการอ้างใบอนุญาต การจดทะเบียนบริษัท ปีที่ก่อตั้ง จำนวนสมาชิก การันตีผลกำไร
// หรือชื่อค่ายเกมรายใด เพราะบรีฟไม่ได้ระบุไว้
//
// Announcement หมุนมาใช้ Announcement5 ตัวเดียวกับทั้งเว็บ — default message ของไฟล์นั้น
// เป็นคอปปี้ของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ไม่ต้องส่ง prop
//
// โลโก้ YADOM168 เป็นตัวอักษรขาวโครเมียมเหนือเลข 168 สีเขียว บนฉากดำเขียวที่มีเหรียญทอง
// สีรองของหน้านี้จึงเป็นทองเหรียญ #e6bd5c คู่กับเขียวหลัก #5cc23f
// คำเตือนทุกจุดใช้สีเหลืองอำพัน #f0b93a โดยตั้งใจ — คำเตือนที่ทาสีแบรนด์จะไม่อ่านเป็นคำเตือน
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 157
const pageDescription =
  "เกี่ยวกับ YADOM168 เว็บสล็อตออนไลน์ที่รวมเกมหลายค่ายไว้ในบัญชีเดียว รองรับมือถือและคอมพิวเตอร์ มีระบบออโต้ฝากถอน โปรแนะนำเพื่อน 0.8% และแอดมินดูแล 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ YADOM168 เว็บสล็อตออนไลน์ รวมเกมหลายค่ายในบัญชีเดียว",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา YADOM168 สล็อตเกมแตกง่าย เบทต่ำ1บาท เดิมพันออโต้" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ YADOM168 เว็บสล็อตออนไลน์ รวมเกมหลายค่ายในบัญชีเดียว" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d4e8cb]">
        <strong class="text-[#f2fbef]">YADOM168</strong> ให้บริการ<strong class="text-[#f2fbef]">เกมสล็อตออนไลน์ที่รวมเกมจากหลายค่ายไว้ในบัญชีเดียว</strong>
        รองรับการใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ หน้าเว็บไซต์รวมส่วนเลือกเกม ฝากถอน
        ตรวจสอบโปรโมชั่น และจัดการเครดิตไว้ที่เดียว สมาชิกจึงเลือกเกม รับโปรโมชั่น
        และติดตามสถานะบัญชีของตนเองได้โดยไม่ต้องสมัครหลายเว็บไซต์
      </p>

      <p class="text-left text-base leading-relaxed text-[#d4e8cb]">
        นอกจากหมวดเกมสล็อตแล้ว ยังมี<strong class="text-[#e6bd5c]">โปรโมชั่นแนะนำเพื่อน รับโบนัส 0.8% ตามเงื่อนไข</strong>
        และแอดมินคอยช่วยเหลือด้านการใช้งานตลอด 24 ชั่วโมง สมาชิกจึงตรวจสอบสิทธิ์ เงื่อนไข
        และสถานะรายการของตนเองได้จากบัญชีเดียว
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="เกมสล็อต YADOM168 รวมหลายค่าย เลือกเบทต่ำ 1 บาทได้ตามเงื่อนไขของเกม" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d4e8cb]">
        YADOM168 รวบรวมเกมสล็อตจากหลายผู้ให้บริการไว้เป็นหมวดหมู่ สมาชิกสามารถ<strong class="text-[#f2fbef]">ค้นหาเกมที่ต้องการและสลับค่ายเกมผ่านบัญชีเดียวได้โดยไม่ต้องสมัครใหม่</strong>
        พร้อมตรวจสอบกติกา อัตราจ่าย และช่วงเดิมพันของแต่ละเกมก่อนทำรายการได้ด้วยตัวเอง
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#d4e8cb]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#5cc23f]">🎰</span>
          <span><strong class="text-[#f2fbef]">สล็อตคลาสสิก</strong> รูปแบบวงล้อและเส้นรางวัลไม่ซับซ้อน เหมาะกับผู้เริ่มต้นที่อยากเห็นวิธีนับผลของแต่ละรอบให้ชัดก่อน</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e6bd5c]">🎁</span>
          <span><strong class="text-[#e6bd5c]">เกมโบนัส</strong> มีรอบพิเศษที่เข้าเงื่อนไขแล้วจึงเปิด หน้าอธิบายในตัวเกมระบุไว้ว่าสัญลักษณ์ชุดใดพาเข้ารอบโบนัส</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#5cc23f]">🌀</span>
          <span><strong class="text-[#f2fbef]">ฟรีสปินและแจ็กพอต</strong> จำนวนสปินและตัวคูณต่างกันไปตามเกม ควรดูเงื่อนไขการรับและการนับผลของแต่ละเกมก่อนเริ่ม</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e6bd5c]">🕹️</span>
          <span><strong class="text-[#e6bd5c]">เกมธีมใหม่ตามที่แต่ละค่ายเปิดให้บริการ</strong> รายชื่อค่ายและเกมที่พร้อมใช้งานเปลี่ยนแปลงได้ ให้ยึดหน้าเลือกเกมล่าสุดเป็นหลัก</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#d4e8cb]">
        สำหรับผู้ที่ต้องการเล่นสล็อตเบทต่ำ 1 บาท สามารถเลือกเกมที่รองรับช่วงเดิมพันดังกล่าวได้
        <strong class="text-[#f0b93a]">แต่ควรตรวจสอบขั้นต่ำภายในเกมก่อนกด Spin ทุกครั้ง เพราะแต่ละค่ายอาจกำหนดช่วงเดิมพันไม่เท่ากัน และผลลัพธ์ของเกมสล็อตไม่สามารถรับประกันว่าเกมใดจะแตกง่ายหรือทำกำไรได้ทุกครั้ง</strong>
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ระบบออโต้ YADOM168 จัดการเครดิต ฝากถอน และตรวจสอบรายการด้วยตัวเอง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d4e8cb]">
        สมาชิก YADOM168 สามารถ<strong class="text-[#f2fbef]">เติมเครดิตผ่านช่องทางฝากเงินที่ระบบเปิดรองรับ และตรวจสอบสถานะรายการผ่านบัญชีของตนเองได้</strong>
        โดยระบบออโต้ช่วยจัดการเครดิต ฝากถอน และตรวจสอบรายการต่าง ๆ ผ่านมือถือได้โดยตรง
        ลดขั้นตอนและไม่จำเป็นต้องแจ้งรายการกับเจ้าหน้าที่ทุกครั้ง
      </p>

      <p class="text-left text-base leading-relaxed text-[#d4e8cb]">
        หากต้องการทำรายการจำนวนมาก
        <strong class="text-[#f0b93a]">ควรตรวจสอบวงเงินขั้นต่ำและสูงสุดของช่องทางที่เลือกก่อนยืนยัน เนื่องจากข้อกำหนดอาจแตกต่างกันตามธนาคารหรือช่องทางชำระเงิน</strong>
        และสำหรับคำว่า “ไม่มีขั้นต่ำ” ให้ยึดเงื่อนไขที่แสดงในหน้าฝากถอน ณ เวลาทำรายการเป็นหลัก
      </p>

      <p class="text-left text-base leading-relaxed text-[#d4e8cb]">
        ในส่วนของโปรโมชั่น สมาชิกสามารถ <strong class="text-[#f2fbef]">Login เพื่อตรวจสอบโบนัสที่มีสิทธิ์รับในแต่ละวันได้</strong>
        โดยสิทธิ์จริงขึ้นอยู่กับกิจกรรมและเงื่อนไขของโปรโมชั่นในช่วงนั้น ไม่ว่าจะเป็นยอดที่ใช้คำนวณ
        รอบรับโบนัส หรือประเภทเกมที่เข้าร่วมรายการ
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="โปรโมชั่นแนะนำเพื่อน YADOM168 รับโบนัส 0.8% จากยอดที่เข้าเงื่อนไข" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d4e8cb]">
        สมาชิกสามารถใช้ลิงก์แนะนำส่วนตัวเพื่อชวนเพื่อนสมัคร YADOM168 เมื่อบัญชีที่แนะนำมียอดใช้งานตรงตามข้อกำหนด
        ระบบจะคำนวณ<strong class="text-[#e6bd5c]">โบนัสแนะนำเพื่อน 0.8%</strong> จากยอดที่เข้าเงื่อนไข
        พร้อมให้ตรวจสอบจำนวนเพื่อน ยอดคำนวณ และโบนัสที่มีสิทธิ์รับผ่านบัญชีสมาชิกได้ด้วยตัวเอง
      </p>

      <p class="text-left text-base leading-relaxed text-[#d4e8cb]">
        ก่อนใช้โปรโมชั่นควรตรวจสอบ<strong class="text-[#f0b93a]">รอบคำนวณ วิธีรับโบนัส และข้อกำหนดล่าสุดให้ครบถ้วน เนื่องจากรายละเอียดของกิจกรรมอาจมีการเปลี่ยนแปลงตามช่วงเวลาที่เว็บไซต์กำหนด</strong>
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ติดต่อแอดมิน YADOM168 ปรึกษาปัญหาการใช้งานได้ตลอด 24 ชั่วโมง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d4e8cb]">
        หากพบปัญหาเกี่ยวกับการสมัคร Login เข้าเกมไม่ได้ เครดิตไม่อัปเดต ฝากถอนค้าง หรือโปรโมชั่นไม่แสดง สามารถ
        <strong class="text-[#f2fbef]">ติดต่อแอดมิน YADOM168 ได้ตลอด 24 ชั่วโมง</strong>
        โดยควรแจ้งรายละเอียดของปัญหา เวลา จำนวนเงิน และข้อมูลรายการที่เกี่ยวข้อง เพื่อช่วยให้เจ้าหน้าที่ตรวจสอบได้ตรงจุด
      </p>

      <p class="text-left text-base leading-relaxed text-[#d4e8cb]">
        สมาชิกใหม่ยังสามารถสอบถามเกี่ยวกับขั้นตอนใช้งาน ระบบฝากถอน วิธีรับโปรโมชั่น
        หรือการเข้าเกมสล็อตแต่ละค่ายได้ และ<strong class="text-[#f0b93a]">ไม่ควรส่งรหัสผ่านหรือ OTP ให้บุคคลอื่นในระหว่างการติดต่อเจ้าหน้าที่</strong>
      </p>

      <p class="text-left text-base leading-relaxed text-[#d4e8cb]">
        <strong class="text-[#f0b93a]">การเดิมพันมีความเสี่ยงและผลของแต่ละรอบไม่แน่นอน ไม่มีเกมใดรับประกันผลล่วงหน้า</strong>
        สมาชิกจึงควรกำหนดงบประมาณก่อนเริ่มเล่นทุกครั้ง
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก YADOM168"
          class="flex items-center justify-center rounded-lg border border-[#1d6b18]/60 bg-gradient-to-r from-[#8fe06f] via-[#5cc23f] to-[#1d6b18] px-8 py-3 font-black text-[#040d04] shadow-[0_0_15px_rgba(92,194,63,0.35)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ YADOM168"
          class="flex items-center justify-center rounded-lg border border-[#e6bd5c]/55 bg-transparent px-8 py-3 font-bold text-[#e6bd5c] transition-all hover:scale-105 hover:border-[#e6bd5c] hover:bg-[#0f3d0d]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
