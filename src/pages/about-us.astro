---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char, so a byte count reads
// ~3x too long). One string, reused by MainLayout's meta and the WebPage node.
const pageDescription =
  "รู้จัก PLUSPSG เว็บสล็อตออนไลน์ที่รวมเกมหลายค่ายไว้ในบัญชีเดียว ทั้งสล็อตเบทต่ำและเกมฟีเจอร์โบนัส พร้อมโปรโมชั่นตามเงื่อนไข และแอดมินดูแลสมาชิกตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ PLUSPSG เว็บสล็อตออนไลน์ที่รวมเกมหลายค่ายไว้ในบัญชีเดียว",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา PLUSPSG สล็อตแตกโคตรเก่ง ไม่กั๊กยูส เบทต่ำจ่ายสูง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ PLUSPSG" as="h1">
    <p class="mb-6 text-left text-base leading-relaxed text-[#e9d6ac]">
      <strong class="text-[#ff4b18]">PLUSPSG</strong> คือ <strong class="text-[#ff4b18]">เว็บสล็อตออนไลน์</strong>
      ที่ให้บริการสมาชิกซึ่งต้องการเล่นสล็อตผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ ภายในระบบรวมเกมจากหลายค่ายและหลายระดับการเดิมพัน
      ตั้งแต่สล็อตเบทต่ำสำหรับคนทุนน้อย ไปจนถึงเกมที่มีฟีเจอร์โบนัสและสล็อตแจ็คพอต โดยออกแบบหน้าจอให้ใช้งานง่ายบนมือถือเป็นหลัก
    </p>

    <p class="mb-2 text-left text-base leading-relaxed text-[#e9d6ac]">
      สมาชิกจัดการทุกอย่างได้จากบัญชีเดียว ทั้งสมัครสมาชิก ฝากเครดิต เลือกเกม ตรวจสอบโปรโมชั่นที่มีสิทธิ์รับ ดูประวัติการเล่น และถอนเงิน พร้อม
      <strong class="text-[#ff4b18]">แอดมิน PLUSPSG คอยช่วยตรวจสอบรายการและให้คำแนะนำด้านการใช้งาน</strong>
      ทั้งนี้กติกา จำนวนเพย์ไลน์ ฟีเจอร์ และช่วงการเดิมพันของแต่ละเกมแตกต่างกัน สมาชิกจึงควรตรวจสอบรายละเอียดที่แสดงในหน้าเกมก่อนเริ่มเล่นทุกครั้ง
    </p>
  </ContentBox>

  <ContentBoxPlain title="บริการที่ PLUSPSG เปิดให้สมาชิกใช้งานบนเว็บสล็อตออนไลน์" as="h2">
    <p class="mb-2 text-left text-base leading-relaxed text-[#e9d6ac]">
      PLUSPSG รองรับการเล่นสล็อตจาก <strong class="text-[#ff4b18]">หลายค่ายและหลายระดับการเดิมพัน</strong> มีทั้งเกมเบทต่ำ เกมโบนัส
      สล็อตแจ็คพอต และเกมใหม่ที่อัปเดตเข้ามาอย่างต่อเนื่อง สมาชิกสามารถเลือกเกม ปรับขนาดเดิมพัน และดูสถานะเครดิตของตนเองได้จากบัญชีเดียว
      ไม่ต้องโยกเงินไปมาระหว่างหลายบัญชี
    </p>

    <p class="mt-3 mb-2 text-left text-base leading-relaxed text-[#e9d6ac]">
      ก่อนเริ่มเล่น แนะนำให้ตรวจสอบกติกา จำนวนเพย์ไลน์ ฟีเจอร์ และช่วงการเดิมพันของเกมนั้นให้เรียบร้อย เนื่องจาก
      <strong class="text-[#ff4b18]">ผลรางวัลของเกมสล็อตมีความไม่แน่นอน</strong> จึงไม่มีเกมหรือบัญชีผู้เล่นใดที่รับประกันว่าแตกง่ายหรือทำกำไรได้ทุกครั้ง
      ควรเลือกขนาดเดิมพันให้เหมาะกับเงินทุนและงบประมาณของตัวเอง
    </p>
  </ContentBoxPlain>

  <ContentBoxPlain title="โปรโมชั่นและเงื่อนไขที่ PLUSPSG แจ้งไว้ให้ตรวจสอบ" as="h2">
    <p class="mb-2 text-left text-base leading-relaxed text-[#e9d6ac]">
      PLUSPSG มีโปรโมชั่นสำหรับสมาชิกที่ต้องการเพิ่มสิทธิประโยชน์ระหว่างใช้งาน แม้เลือกเล่นสล็อตเบทต่ำก็สามารถตรวจสอบโปรโมชั่นที่บัญชีมีสิทธิ์รับได้
      รายการหลักคือ <strong class="text-[#ff4b18]">โปรโมชั่นแนะนำเพื่อน รับโบนัส 0.8%</strong> สำหรับรายการที่เข้าเงื่อนไข และ
      <strong class="text-[#ff4b18]">โปรโมชั่นคืนยอดเสีย รับโบนัส 0.3%</strong> ตามรอบที่กำหนด
    </p>

    <p class="mt-3 mb-2 text-left text-base leading-relaxed text-[#e9d6ac]">
      โบนัสแต่ละรายการมีวิธีคำนวณ รอบรับ และข้อกำหนดแตกต่างกัน ระบบจะแสดงยอดที่นำมาคำนวณและโบนัสที่กดรับได้ผ่านบัญชีสมาชิก
      แนะนำให้อ่านเงื่อนไขเกี่ยวกับประเภทเกม รอบเวลา ยอดที่เข้าร่วม และการถอนให้ครบถ้วนก่อนกดรับสิทธิ์ทุกครั้ง
    </p>
  </ContentBoxPlain>

  <ContentBoxPlain title="การเริ่มใช้งานและการดูแลสมาชิกของทีมงาน PLUSPSG" as="h2">
    <p class="mb-4 text-left text-base leading-relaxed text-[#e9d6ac]">
      เริ่มต้นใช้งาน PLUSPSG ผ่านมือถือได้ง่ายเพียง <strong class="text-[#ff4b18]">3 ขั้นตอน</strong> คือสมัครสมาชิกและกรอกข้อมูลตามที่ระบบกำหนด จากนั้น Login
      เข้าสู่บัญชี ฝากเครดิต และตรวจสอบโบนัสฝากแรกที่มีสิทธิ์รับ แล้วจึงเลือกเกมสล็อตและขนาดเดิมพันที่ต้องการ ศึกษากติกาก่อนเริ่มเล่น
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#e9d6ac]">
      หลังสมัครเรียบร้อย สมาชิกสามารถตรวจสอบเครดิต ประวัติการเล่น โปรโมชั่น และรายการฝากถอนได้จากบัญชีของตนเอง หากพบปัญหาสมัครสมาชิกไม่ได้ Login ไม่ผ่าน
      ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินล่าช้า โปรโมชั่นไม่แสดง หรือเข้าเกมสล็อตไม่ได้ สามารถแจ้ง <strong class="text-[#ff4b18]">แอดมิน PLUSPSG</strong>
      พร้อมรายละเอียดและเวลาที่พบปัญหา เพื่อให้ทีมงานตรวจสอบรายการและแนะนำขั้นตอนแก้ไขได้ตรงจุดตลอด 24 ชั่วโมง
    </p>

    <p class="mb-6 text-left text-base leading-relaxed text-[#e9d6ac]">
      ทั้งนี้ <strong class="text-[#ff4b18]">การเดิมพันมีความเสี่ยงและไม่มีรูปแบบใดรับประกันผลรางวัลได้</strong> โบนัสฝากแรกขึ้นอยู่กับโปรโมชั่นที่เปิดให้บริการในขณะนั้น
      ผู้เล่นจึงควรกำหนดงบประมาณของตัวเองก่อนเล่นทุกครั้ง และเล่นเท่าที่รับความเสี่ยงไหว
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก PLUSPSG"
        class="flex items-center justify-center rounded-lg bg-gradient-to-r from-[#ff4b18] via-[#e2060a] to-[#7a0304] px-8 py-3 font-black text-[#fff6e0] shadow-[0_0_15px_rgba(226,6,10,0.32)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ PLUSPSG"
        class="flex items-center justify-center rounded-lg border border-[#e2060a]/70 bg-transparent px-8 py-3 font-bold text-[#e9d6ac] transition-all hover:scale-105 hover:border-[#ff4b18] hover:bg-[#240803]/70">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
