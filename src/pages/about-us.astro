---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement4.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login,
// /register, /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจาก
// เช็กลิสต์หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ (src/assets/content.txt)
// ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึงเขียนขึ้นใหม่จากข้อเท็จจริงและ
// คลังคำของบรีฟรอบนี้เท่านั้น (brand-spec §6) ไม่ใช่การแก้ทับประโยคของแบรนด์ก่อน
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x4 · h3x0
//   h1  เกี่ยวกับเรา <แบรนด์> ระบบดูแลการเงิน ฝากถอนทุกช่องทาง ปลอดภัยไม่ผ่านม้า
//   h2  ระบบดูแลการเงินของ <แบรนด์> ฝากถอนผ่านธนาคารชั้นนำและวอลเลท
//   h2  ประเภทเกมที่ <แบรนด์> รวบรวมข้อมูลไว้ สล็อต ไฮโล ยิงปลา หวย บอล
//   h2  โปรโมชั่น <แบรนด์> คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%
//   h2  ช่องทางติดต่อแอดมิน <แบรนด์> ตลอด 24ชม.
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) จึงเปิดใช้งานอยู่
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// ตัวที่ routing จริงคือไฟล์นี้ Astro ไม่อ่านโฟลเดอร์นั้นเลย ห้ามแก้และห้ามลบ
//
// 🚨 แกนของดรอปนี้ (2026-10-21) คือ **ระบบดูแลการเงิน** — เว็บที่นำเสนอช่องทาง
// ฝากถอนผ่านธนาคารชั้นนำและวอลเลท พร้อมข้อมูลเกมหลายประเภท (สล็อต ไฮโล ยิงปลา
// หวย บอล — **ห้าหมวด ไม่ใช่หก**) จุดขายที่บรีฟย้ำซ้ำที่สุดคือ **ความปลอดภัยของ
// บัญชีรับเงิน / ไม่ผ่านบัญชีม้า** · **ไม่ใช่เว็บหวย** (หวยเป็นเพียง 1 ใน 5
// ประเภทเกมที่เอ่ยถึง) สองหน้าหมวดลอตเตอรีที่แบรนด์ก่อนๆ เคยเปิด จอดอยู่ใน
// src/pages-disabled/ ไม่มี route ห้ามลิงก์ไปหา เป็น href ตายที่ทำให้ build แดง
// route ที่มีจริงรอบนี้คือ / · /about-us · /contact-us · /login · /privacy ·
// /promotion · /register · /terms · /ทดลองเล่น · /ทางเข้า · /line
//
// ⚠️ แบรนด์ก่อนหน้าทันทีอยู่คนละหมวดโดยสิ้นเชิง (ชื่อแบรนด์และคำแวดล้อมของมัน
// ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์
// ของไฟล์นี้เอง — รายการเต็มอยู่ใน brand-spec §6) โครงหัวข้อ "ดูเข้าเค้า"
// เพราะใช้สล็อตเดียวกัน แต่กรอบเนื้อหาคนละอันโดยสิ้นเชิง จึงเขียนใหม่ทั้งหน้า
// **ห้าม find-and-replace ทับประโยคเดิม** · บรีฟรอบนี้มีเกม **ห้าหมวดเท่านั้น**
// (สล็อต ไฮโล ยิงปลา หวย บอล) **ห้ามเติมหมวดที่หกเข้ามาเอง**
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกม ชื่อธนาคาร หรือผู้ให้บริการแม้แต่รายเดียว**
// จึงห้ามเขียนลงหน้าเว็บ และห้ามอ้างใบอนุญาต หน่วยงานกำกับ ชื่อนิติบุคคล
// ค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีก่อตั้ง · ห้ามใช้คำว่า เว็บตรง /
// ไม่ผ่านเอเย่นต์ / คาสิโนสด / รูเล็ต
//
// คลังคำที่บรีฟรอบนี้ให้มาและใช้ได้เท่านี้ (brand-spec §6): ระบบดูแลการเงิน ·
// ฝากถอน · ทุกช่องทาง · ธนาคารชั้นนำ · วอลเลท · ปลอดภัยไม่ผ่านม้า · บัญชีม้า ·
// บัญชีแอบอ้าง · ชื่อบัญชีผู้รับเงิน · ชื่อบัญชีปลายทาง · หลักฐานความน่าเชื่อถือ ·
// ธุรกรรม · รายการผิดปกติ · ยอดขั้นต่ำ · ระยะเวลาดำเนินการ · หลักฐานการโอนเงิน ·
// สถานะธุรกรรม · สล็อต · ไฮโล · ยิงปลา · หวยออนไลน์ · ฟุตบอล/บอล · สัญลักษณ์ ·
// ผลการทอยลูกเต๋า · ระบบคะแนน · ราคาต่อรอง · กติกา · อัตราจ่าย ·
// ประเภทการเดิมพัน · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · โบนัส · เครดิต ·
// ยอดเสีย · รอบเวลารับเครดิต · ลิงก์แนะนำ · เชื่อมโยงบัญชี · สมัครสมาชิก ·
// เข้าสู่ระบบ · รหัสผ่าน · รหัส OTP · เจ้าหน้าที่ · แอดมิน · 24ชม. ·
// เว็บไซต์ทางการ · ประกาศล่าสุด · ข้อกำหนดล่าสุด
//
// ตัวเลขที่อ้างได้มีแค่สามตัวของบรีฟเอง: 0.3% · 0.8% · 24ชม.
// (บรีฟรอบนี้ไม่มีรายการ sub-list แบบนับเป็นขั้นตอนให้ใช้เลย)
//
// ⚠️ คำโฆษณาของบรีฟ ("ปลอดภัยไม่ผ่านม้า" · "รับได้ไม่จำกัดยูส" · "ตลอด 24ชม.")
// อยู่ได้เฉพาะในหัวข้อที่บรีฟเขียนไว้เอง ห้ามขยายเป็นคำกล่าวอ้างใหม่
//
// 🚨 บรีฟรอบนี้ **โฆษณากับกำกับความเสี่ยงอยู่ในย่อหน้าเดียวกัน** ประโยคกำกับ
// ทุกประโยคต้องขึ้นครบ เป็นเนื้อหาของบรีฟ ไม่ใช่ filler ให้ตัดทิ้ง:
// 1) ควรตรวจสอบชื่อบัญชีผู้รับเงิน ข้อมูลผู้ให้บริการ และหลักฐานความน่าเชื่อถือ
//    ก่อนโอนเงินทุกครั้ง เพื่อหลีกเลี่ยงความเสี่ยงจากบัญชีแอบอ้างหรือบัญชีม้า (h1)
// 2) เกมเดิมพันทุกประเภทมีความเสี่ยงต่อการสูญเสียเงิน และไม่มีรูปแบบใดสามารถ
//    รับประกันผลกำไรได้ (h2 #2)
// 3) เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือ
//    รับประกันผลตอบแทนในอนาคต (h2 #3)
// 4) แม้โปรโมชั่นจะระบุว่าไม่จำกัด แต่ควรยืนยันข้อกำหนดเกี่ยวกับจำนวนบัญชีที่
//    เข้าร่วม รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุด (h2 #3)
// 5) หากพบรายการผิดปกติควรหยุดทำธุรกรรมและติดต่อธนาคารหรือผู้ให้บริการชำระเงิน
//    ทันที (h2 #1)
// 6) ตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ · ไม่เปิดเผยรหัสผ่าน
//    หรือรหัส OTP ให้บุคคลอื่น · ควรตรวจสอบเวลาการให้บริการและระยะเวลาตอบกลับ
//    ล่าสุดอีกครั้ง (h2 #4)
//
// 🚨 พาเลตรอบนี้ (brand-spec §2) เป็น **ธีมสว่างแบรนด์แรกของรีโปนี้ — กลับทิศจาก
// ทุกรอบก่อนหน้า** bg.json ของดรอปนี้คือ {"mode":"color","color":"#f0ccf5"} =
// ชมพูอมม่วงสว่าง ไม่ใช่ดำ **ห้าม "แก้" กลับไปเป็นพื้นเข้มเพราะรอบก่อนๆ เป็นแบบนั้น**
// ⚠️ **ชมพูเคยนำมาแล้วสามแบรนด์** (ถอนชัวร์168 · มีโชค168 · มีเฮ168) "เจอชมพู
// อยู่แล้ว" จึงไม่ใช่ตัวบอกว่าถูกแบรนด์ ให้เทียบเป็น **"ค่า"** ทีละตัวกับตารางใน
// brand-spec §2 ไม่ใช่ด้วยตา (ค่าของแบรนด์เก่าไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep
// หาสีแบรนด์เก่าเจอ false positive ในไฟล์นี้เอง)
// ค่าที่ใช้ได้ในไฟล์นี้: โรสเข้ม #a4186b (หัวข้อ/<strong>/marker — 7.2:1 บนผิว
// การ์ดขาว) · หมึกพลัม #4a0d35 (เนื้อความ = BRAND_TEXT, 14.9:1) ·
// ชมพูบานเย็น #dd1b74 (พื้นถม/ขอบ/ออรา) · ขาว #ffffff (ตัวอักษรบนพื้นถมชมพู) ·
// อินเซ็ต #f7dcf6 / พื้นเพจ #f0ccf5
// 🚨 **#dd1b74 ได้ 4.67:1 บนผิวการ์ดขาว — ผ่าน AA เฉียดฉิว** จึงสงวนไว้เป็น
// **พื้นถม / ขอบ / ออรา** และ **ห้ามเป็นสีไฮไลต์ <strong> ในเนื้อความ**
// สีไฮไลต์ <strong> มีตัวเดียวคือโรสเข้ม #a4186b · ถ้าต้องการตัวอักษรที่อ่านว่า
// "ชมพูสด" ให้ถม #dd1b74 เป็นพื้นแล้ววาง #ffffff ทับ — ปุ่มสมัครสมาชิกทำแบบนั้น
// 🚨 **#f0ccf5 และ #f7dcf6 ห้ามถือตัวอักษรบนพื้นขาว** เป็นสีพื้น/ขอบเท่านั้น
// ออราที่อนุญาต: rgba(221,27,116,α) · rgba(164,24,107,α) · rgba(74,13,53,α)
// ⚠️ รอบนี้ไม่มีทอง/เหลือง ไม่มีแดงชาด ไม่มีบรอนซ์ ไม่มีฟ้า/น้ำเงิน ไม่มีเขียว
// (นอกจาก LINE) ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์ ไม่มีส้ม · #00B900 บนปุ่ม LINE
// เป็นสีประจำแพลตฟอร์ม ไม่ใช่สีของเว็บ
//
// ลำดับปุ่มในไฟล์นี้สื่อด้วย "พื้นถมชมพู vs พื้นถมโรส-พลัม vs อินเซ็ตขอบชมพู":
// · ปุ่มหลัก (สมัครสมาชิก) ถมชมพู #dd1b74 ตัวอักษรขาว (4.67:1) ขอบ #a4186b
// · ปุ่มรอง (เข้าสู่ระบบ) ถมไล่เฉด #a4186b → #4a0d35 ตัวอักษรขาว (7.2:1 / 14.9:1)
// · ปุ่มลิงก์ภายในเป็นอินเซ็ต #f7dcf6 ขอบชมพูโปร่ง ตัวอักษรหมึกพลัม (12.6:1)
//   hover ยกขอบเป็นชมพูทึบ (ตรงกับ hover ของการ์ด ContentBox)
// · ชิปไอคอนของรายการใช้ชมพูบานเย็นเป็น **เส้นขอบ** บนอินเซ็ต #f7dcf6
//   ไม่ถือตัวอักษร
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT
// #4a0d35, 14.9:1 บนผิวการ์ดขาว) ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่
// ประกาศสีของตัวเอง ปล่อยให้สืบทอดลงมา และไม่ใส่ mx-auto / max-w-* บน <p> เพราะ
// การ์ดคุมความกว้างเองแล้ว (เพิ่มไปจะเหมือนย่อหน้าเยื้อง) — ที่ประกาศสีได้มีแค่
// ปุ่ม (ถมพื้นของตัวเองจึงต้องกำหนดหมึกของตัวเอง) ชิปไอคอน marker ของลำดับเลข
// และ <strong> ซึ่ง brand-spec §2 สงวนโรสเข้ม #a4186b ไว้เป็นสีไฮไลต์ในเนื้อความ
// เพียงสีเดียว · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะ
// ภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะ
// ขาดครึ่ง (ลบแท็ก <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิม) และห้ามวาง
// <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังใน prop ที่เป็นข้อความ
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: ดรอปนี้ (brand-spec §5) ไม่มี article illustration
// เลย ส่วน slide1/slide2 ถูกตรึงไว้กับ index กับ /promotion และ banner1 /
// banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// banner2/banner3 และ slide3/slide4 เป็นอาร์ตเวิร์กของแบรนด์คนละราย ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้หมุนมาเป็น Announcement4 ทั้งเว็บ (brand-spec §3)
// orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว
// จึงเรียกแบบ bare **ห้ามส่ง prop message** มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 156 อักขระ เป็นประโยคเดียวที่บอกว่าหน้านี้มีอะไร แล้วหยุด
// (Google ตัดราว 155 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนยาวเกิน)
//
// ห้ามให้สตริงนี้มีชื่อของสองหน้าหมวดลอตเตอรีที่จอดอยู่ใน src/pages-disabled/
// (ชื่อไฟล์ทั้งสองอยู่ใน brand-spec §7) เพราะ sweep ของรอบถัดไปจะอ่านเป็น
// false positive ว่ายังมีลิงก์ไปหน้าที่ไม่มี route
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} ระบบดูแลการเงิน หน้ารวมช่องทางฝากถอนผ่านธนาคารชั้นนำและวอลเลท ประเภทเกมที่เปิดให้บริการ โปรโมชั่น และช่องทางติดต่อเจ้าหน้าที่ 24ชม.`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} ระบบดูแลการเงิน ฝากถอนทุกช่องทาง ปลอดภัยไม่ผ่านม้า`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#a4186b]">{BRAND_NAME} นำเสนอระบบบริการสมาชิกที่รวบรวมช่องทางฝากถอนและข้อมูลเกมออนไลน์ไว้ในเว็บไซต์เดียว</strong>
        ทั้งเกมสล็อต ไฮโล ยิงปลา หวย และฟุตบอล พร้อมช่องทางทำรายการผ่านธนาคารและวอลเลทตามที่เปิดให้บริการ หน้านี้รวบรวมไว้ว่าเว็บไซต์ระบุอะไรไว้บ้าง
        เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดอ่านอะไรตรงไหน แล้วจึงค่อยไล่อ่านรายละเอียดของแต่ละหัวข้อเป็นรายข้อ
      </p>

      <p>
        ผู้ใช้งานสามารถตรวจสอบรายละเอียดธุรกรรมและติดต่อเจ้าหน้าที่เมื่อพบปัญหาได้
        <strong class="text-[#a4186b]">โดยควรตรวจสอบชื่อบัญชีผู้รับเงิน ข้อมูลผู้ให้บริการ และหลักฐานความน่าเชื่อถือก่อนโอนเงินทุกครั้ง</strong>
        เพื่อหลีกเลี่ยงความเสี่ยงจากบัญชีแอบอ้างหรือบัญชีม้า ซึ่งเป็นจุดที่บรีฟของเว็บไซต์ย้ำไว้ซ้ำที่สุด
      </p>

      <p>
        เนื้อหาในหน้านี้เขียนไว้ประกอบการใช้งานเท่านั้น ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะทำรายการ
        <strong class="text-[#a4186b]">และเกมเดิมพันทุกประเภทมีความเสี่ยงต่อการสูญเสียเงิน ไม่มีรูปแบบใดสามารถรับประกันผลกำไรได้</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`ระบบดูแลการเงินของ ${BRAND_NAME} ฝากถอนผ่านธนาคารชั้นนำและวอลเลท`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} ระบุช่องทางฝากถอนผ่านธนาคารชั้นนำและวอลเลท เพื่อให้สมาชิกเลือกตรวจสอบวิธีทำรายการที่เหมาะกับบริการที่ใช้งานจริง
        <strong class="text-[#a4186b]">โดยสิ่งที่ควรตรวจก่อนทุกครั้งคือชื่อบัญชีปลายทางและรายละเอียดผู้รับเงินว่าตรงกับข้อมูลทางการหรือไม่</strong>
        และไม่โอนเงินไปยังบัญชีบุคคลอื่นที่ไม่สามารถยืนยันความเกี่ยวข้องกับผู้ให้บริการได้
      </p>

      <ol class="ml-6 list-decimal space-y-3 marker:font-black marker:text-[#a4186b]">
        <li>
          <strong class="text-[#a4186b]">ตรวจชื่อบัญชีผู้รับเงินก่อนโอน</strong> เทียบชื่อบัญชีปลายทางกับข้อมูลผู้ให้บริการที่ยืนยันได้ และหลีกเลี่ยงการโอนเงินเข้าบัญชีที่มีชื่อไม่ตรงหรือมีการเปลี่ยนแปลงโดยไม่มีคำอธิบาย
        </li>
        <li>
          <strong class="text-[#a4186b]">อ่านเงื่อนไขของการถอนเงินให้ครบ</strong> ทั้งยอดขั้นต่ำ ระยะเวลาดำเนินการ และข้อกำหนดที่เกี่ยวข้อง เพื่อให้ทราบล่วงหน้าว่าแต่ละรายการใช้เวลาประมาณเท่าใด
        </li>
        <li>
          <strong class="text-[#a4186b]">เก็บหลักฐานการโอนเงินไว้ทุกครั้ง</strong> หากฝากแล้วยอดไม่เข้าระบบ ควรตรวจสอบสถานะธุรกรรมและติดต่อช่องทางบริการทางการพร้อมหลักฐานที่เกี่ยวข้อง
        </li>
        <li>
          <strong class="text-[#a4186b]">หยุดทำธุรกรรมทันทีเมื่อพบรายการผิดปกติ</strong> แล้วติดต่อธนาคารหรือผู้ให้บริการชำระเงินโดยเร็ว ไม่ทำรายการต่อเพื่อรอดูผล
        </li>
      </ol>

      <p>
        ทั้งนี้ ควรตรวจสอบรายชื่อบริการที่รองรับจริง ยอดขั้นต่ำ และเงื่อนไขการทำรายการจากประกาศล่าสุดก่อนดำเนินการทุกครั้ง
        <strong class="text-[#a4186b]">เพราะช่องทางที่เปิดให้บริการและระยะเวลาดำเนินการอาจปรับเปลี่ยนได้ตามที่ผู้ให้บริการกำหนด</strong>
        และหากสงสัยเกี่ยวกับบัญชีรับเงิน ควรติดต่อธนาคารเพื่อขอคำแนะนำก่อนโอนเงิน
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`ประเภทเกมที่ ${BRAND_NAME} รวบรวมข้อมูลไว้ สล็อต ไฮโล ยิงปลา หวย บอล`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} รวบรวมข้อมูลเกมเดิมพันออนไลน์หลายประเภทไว้ในช่องทางเดียว
        <strong class="text-[#a4186b]">โดยแต่ละประเภทใช้คนละกติกาและคนละชุดข้อมูลในการทำความเข้าใจ</strong>
        จึงควรดูว่าหัวข้อที่สนใจอธิบายอะไรไว้แล้ว และต้องตรวจสอบส่วนใดเพิ่มเติมจากเงื่อนไขที่เว็บไซต์แสดงอยู่
      </p>

      <ul class="flex flex-col gap-4" aria-label="ประเภทเกมที่เว็บไซต์ระบุไว้">
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#dd1b74]/50 bg-[#f7dcf6] text-sm">🎰</span>
          <span>
            <strong class="text-[#a4186b]">สล็อต</strong> มีรูปแบบและฟีเจอร์แตกต่างกันในแต่ละเกม จึงควรอ่านสัญลักษณ์และอัตราจ่ายของเกมนั้นเองก่อนทำรายการทุกครั้ง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#dd1b74]/50 bg-[#f7dcf6] text-sm">🎲</span>
          <span>
            <strong class="text-[#a4186b]">ไฮโล</strong> ใช้ผลการทอยลูกเต๋าเป็นตัวตัดสิน จึงควรศึกษากติกาและประเภทการเดิมพันแต่ละแบบให้ชัดเจนก่อนเริ่ม
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#dd1b74]/50 bg-[#f7dcf6] text-sm">🐟</span>
          <span>
            <strong class="text-[#a4186b]">ยิงปลา</strong> มีระบบคะแนนเป็นของตัวเอง วิธีคิดผลจึงไม่เหมือนเกมประเภทอื่น ไม่ควรนำวิธีของเกมหนึ่งไปใช้กับอีกเกมหนึ่ง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#dd1b74]/50 bg-[#f7dcf6] text-sm">🎟️</span>
          <span>
            <strong class="text-[#a4186b]">หวยออนไลน์</strong> เลือกหมายเลขตามประเภทการเดิมพัน ซึ่งแต่ละประเภทกำหนดอัตราจ่ายและเงื่อนไขไว้คนละแบบ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#dd1b74]/50 bg-[#f7dcf6] text-sm">⚽</span>
          <span>
            <strong class="text-[#a4186b]">ฟุตบอล</strong> มีราคาต่อรองหลากหลาย จึงควรอ่านกติกาและเงื่อนไขของรายการที่สนใจให้ครบก่อนทำรายการ
          </span>
        </li>
      </ul>

      <p>
        ผู้ใช้งานควรศึกษากติกา อัตราจ่าย และเงื่อนไขของแต่ละเกมก่อนทำรายการ
        <strong class="text-[#a4186b]">เพราะเกมเดิมพันทุกประเภทมีความเสี่ยงต่อการสูญเสียเงิน และไม่มีรูปแบบใดสามารถรับประกันผลกำไรได้</strong>
        รายละเอียดที่เว็บไซต์แสดงอยู่ขณะใช้งานจึงเป็นสิ่งที่ควรยึดเป็นหลัก
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} นำเสนอข้อมูลโปรโมชั่นสำหรับสมาชิกที่สนใจสิทธิพิเศษจากการใช้บริการ โดยรายการหลักที่ระบุไว้ประกอบด้วย
        <strong class="text-[#a4186b]">รายการคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8%</strong>
        ซึ่งแต่ละโปรโมชั่นอาจมีเงื่อนไขเกี่ยวกับประเภทเกม ยอดที่นำมาคำนวณ และรอบเวลารับเครดิตแตกต่างกัน ก่อนเข้าร่วมจึงควรอ่านข้อกำหนดล่าสุดให้ครบถ้วน รวมถึงตรวจสอบจำนวนบัญชีที่มีสิทธิ์รับโปรโมชั่นและเงื่อนไขการใช้โบนัส
      </p>

      <p>
        รายการคืนยอดเสียระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขในแต่ละวัน
        <strong class="text-[#a4186b]">สมาชิกควรตรวจสอบว่าเกมสล็อต ไฮโล ยิงปลา หวย หรือฟุตบอลประเภทใดเข้าร่วมรายการบ้าง รวมถึงรอบเวลาคำนวณยอดและวิธีรับเครดิต</strong>
        หากไม่แน่ใจสามารถสอบถามเจ้าหน้าที่เพิ่มเติมได้ ทั้งนี้ เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือรับประกันผลตอบแทนในอนาคต
      </p>

      <p>
        ส่วนรายการแนะนำเพื่อนระบุสิทธิ์ไว้สำหรับสมาชิกที่แนะนำผู้ใช้งานรายใหม่ โดยควรตรวจสอบวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และยอดที่ใช้คำนวณโบนัสให้ครบถ้วน
        <strong class="text-[#a4186b]">แม้โปรโมชั่นจะระบุว่าไม่จำกัด แต่ควรยืนยันข้อกำหนดเกี่ยวกับจำนวนบัญชีที่เข้าร่วม รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุด</strong>
        เพื่อให้เข้าใจหลักเกณฑ์การรับสิทธิ์ และหลีกเลี่ยงความคลาดเคลื่อนเกี่ยวกับยอดโบนัสที่จะได้รับ
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/promotion"
          aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#dd1b74]/45 bg-[#f7dcf6] px-8 py-3 font-bold text-[#4a0d35] shadow-[0_4px_14px_rgba(74,13,53,0.15)] transition-all hover:scale-105 hover:border-[#dd1b74] hover:shadow-[0_6px_18px_rgba(221,27,116,0.3)]">
          ดูภาพโปรโมชั่น
        </a>

        <a
          href="/ทดลองเล่น"
          aria-label={`เปิดหน้าทดลองเล่นของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#dd1b74]/45 bg-[#f7dcf6] px-8 py-3 font-bold text-[#4a0d35] shadow-[0_4px_14px_rgba(74,13,53,0.15)] transition-all hover:scale-105 hover:border-[#dd1b74] hover:shadow-[0_6px_18px_rgba(221,27,116,0.3)]">
          ไปหน้าทดลองเล่น
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`ช่องทางติดต่อแอดมิน ${BRAND_NAME} ตลอด 24ชม.`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} ระบุช่องทางติดต่อเจ้าหน้าที่สำหรับผู้ใช้งานที่ต้องการสอบถามเกี่ยวกับการสมัครสมาชิก การเข้าสู่ระบบ รายการฝากถอน และรายละเอียดโปรโมชั่น
        <strong class="text-[#a4186b]">โดยควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีหรือบุคคลที่แอบอ้างชื่อบริการ</strong>
        หากพบปัญหาเกี่ยวกับธุรกรรม ควรเตรียมข้อมูลรายการและหลักฐานที่เกี่ยวข้องไว้สำหรับตรวจสอบ โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น
      </p>

      <p>
        <strong class="text-[#a4186b]">ทั้งนี้ ควรตรวจสอบเวลาการให้บริการและระยะเวลาตอบกลับล่าสุดอีกครั้ง</strong>
        เพราะช่วงเวลาที่เจ้าหน้าที่รับเรื่องและระยะเวลาตอบกลับอาจปรับเปลี่ยนได้ตามที่ผู้ให้บริการกำหนด
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/line"
          aria-label={`ติดต่อเจ้าหน้าที่ ${BRAND_NAME} ผ่าน Line Official`}
          class="flex items-center justify-center gap-2 rounded-lg border border-[#00B900] bg-[#00B900] px-8 py-3 font-black text-white shadow-[0_0_15px_rgba(0,185,0,0.35)] transition-transform hover:scale-105">
          <span aria-hidden="true">💬</span>
          ติดต่อผ่าน Line Official
        </a>

        <a
          href="/contact-us"
          aria-label={`ดูช่องทางติดต่อทีมงาน ${BRAND_NAME} ทั้งหมด`}
          class="flex items-center justify-center rounded-lg border border-[#dd1b74]/45 bg-[#f7dcf6] px-8 py-3 font-bold text-[#4a0d35] shadow-[0_4px_14px_rgba(74,13,53,0.15)] transition-all hover:scale-105 hover:border-[#dd1b74] hover:shadow-[0_6px_18px_rgba(221,27,116,0.3)]">
