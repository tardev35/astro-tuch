---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

// UVO88 เป็นเว็บพนันออนไลน์รวมหลายหมวดเกมในบัญชีเดียว — บาคาร่า เกมไพ่ สล็อตออนไลน์
// หวย และฟุตบอล ไม่ใช่เว็บสล็อตอย่างเดียว
// เนื้อหาทั้งหน้าอ้างอิงบรีฟของแบรนด์นี้เท่านั้น: หลายหมวดเกมผ่านบัญชีเดียว ·
// รองรับมือถือ แท็บเล็ต คอมพิวเตอร์ · เลือกเกม ตรวจเครดิต ฝากถอน รับโปรโมชั่น
// จัดการบัญชีได้เอง · โปรแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% พร้อมคำเตือนให้ตรวจ
// เงื่อนไขและรอบคำนวณก่อนกดรับ · แอดมินดูแลตลอด 24 ชั่วโมง
// — ไม่มีการอ้างใบอนุญาต การจดทะเบียนบริษัท ปีที่ก่อตั้ง จำนวนสมาชิก การันตีผลกำไร
// หรือชื่อค่ายเกมรายใด เพราะบรีฟไม่ได้ระบุไว้
//
// Announcement รอบนี้หมุนมาใช้ AnnouncementPremium ทั้งเว็บ — default message ของไฟล์นั้น
// เป็นคอปปี้ของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ไม่ต้องส่ง prop
//
// โลโก้ UVO88 เป็นตัวอักษรทองบนชิปโป๊กเกอร์เขียวมรกต คู่กับเลข 88 สีทอง
// สีหลักของหน้านี้จึงเป็นเขียวมรกต #0f9d47 คู่กับทอง #f2c230
// คำเตือนทุกจุดใช้สีทองอ่อน #ffd76a โดยตั้งใจ — คำเตือนที่ทาสีแบรนด์จะไม่อ่านเป็นคำเตือน
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 156
const pageDescription =
  "เกี่ยวกับ UVO88 เว็บพนันออนไลน์ที่รวมบาคาร่า เกมไพ่ สล็อต หวย และฟุตบอลไว้ในบัญชีเดียว รองรับมือถือและคอมพิวเตอร์ พร้อมโปรโมชั่นและแอดมินดูแลตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ UVO88 เว็บพนันออนไลน์ รวมทุกหมวดเกมไว้ในบัญชีเดียว",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา UVO88 เว็บพนันออนไลน์ บาคาร่า ไพ่ สล็อต หวย บอล" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ UVO88 เว็บพนันออนไลน์ รวมทุกหมวดเกมไว้ในบัญชีเดียว" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#c8e3d0]">
        <strong class="text-[#f3fbf5]">UVO88</strong> ให้บริการ<strong class="text-[#f3fbf5]">เกมเดิมพันออนไลน์หลายประเภทผ่านบัญชีเดียว</strong>
        มีทั้งบาคาร่า เกมไพ่ สล็อตออนไลน์ หวย และฟุตบอล รองรับการใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์
        สมาชิกสามารถเลือกเกม ตรวจสอบเครดิต ฝากถอน รับโปรโมชั่น และจัดการบัญชีได้จากหน้าเว็บไซต์
        พร้อมระบบช่วยเหลือสำหรับผู้ใช้งานตลอด 24 ชั่วโมง เพื่อให้การใช้งานแต่ละส่วนเป็นไปอย่างสะดวกและไม่ซับซ้อน
      </p>

      <p class="text-left text-base leading-relaxed text-[#c8e3d0]">
        หน้านี้รวบรวมไว้ว่าเว็บไซต์เปิดให้ทำอะไรได้บ้าง ตั้งแต่หมวดเกมที่เปิดให้บริการ การจัดการบัญชีด้วยตัวเอง
        ไปจนถึงโปรโมชั่นที่ตรวจสอบสิทธิ์ได้จากบัญชีสมาชิก
        <strong class="text-[#ffd76a]">สำหรับคำว่า “การันตีจากเจ้าของแท้” และ “น่าเชื่อที่สุด” ควรมีข้อมูลผู้ให้บริการหรือหลักฐานที่ตรวจสอบได้บนเว็บไซต์ เพื่อให้คำกล่าวอ้างมีความชัดเจนและสร้างความน่าเชื่อถือได้มากขึ้น</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="หมวดเกมของ UVO88 บาคาร่า เกมไพ่ สล็อตออนไลน์ หวย และฟุตบอล" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#c8e3d0]">
        UVO88 รวมหมวดเกมเดิมพันยอดนิยมไว้ให้สมาชิกเลือกใช้งานผ่านระบบเดียว ช่วยให้
        <strong class="text-[#f3fbf5]">สลับประเภทเกมได้โดยไม่ต้องสมัครหลายบัญชี</strong>
        และตรวจสอบเครดิตกับประวัติรายการของทุกหมวดได้จากที่เดียวกัน
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#c8e3d0]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#0f9d47]">🃏</span>
          <span><strong class="text-[#f3fbf5]">บาคาร่าออนไลน์และเกมไพ่ในหมวดคาสิโน</strong> เลือกโต๊ะและรูปแบบการเดิมพันได้ตามที่ระบบเปิดให้บริการ</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f2c230]">🎰</span>
          <span><strong class="text-[#f2c230]">สล็อตออนไลน์จากหลายค่าย</strong> จัดไว้เป็นหมวดหมู่ให้ค้นหาเกมและสลับค่ายผ่านบัญชีเดียว</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#0f9d47]">🎫</span>
          <span><strong class="text-[#f3fbf5]">หวยออนไลน์ตามรอบที่เปิดรับ</strong> ตรวจสอบรอบที่ยังเปิดรับและรายละเอียดของแต่ละรายการได้ก่อนทำรายการ</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f2c230]">⚽</span>
          <span><strong class="text-[#f2c230]">การเดิมพันฟุตบอลตามรายการแข่งขัน</strong> รายการที่เปิดรับเปลี่ยนแปลงได้ตามตารางแข่งในแต่ละช่วง</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#c8e3d0]">
        <strong class="text-[#ffd76a]">ก่อนเริ่มเดิมพันควรตรวจสอบกติกา อัตราจ่าย ช่วงเดิมพัน และวงเงินของแต่ละเกมให้ครบถ้วน เนื่องจากรายละเอียดอาจแตกต่างกันตามผู้ให้บริการและประเภทการเดิมพัน รวมถึงผลลัพธ์ของเกมไม่สามารถรับประกันกำไรหรือผลชนะได้ทุกครั้ง</strong>
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="จัดการบัญชี UVO88 ด้วยตัวเอง ทั้งเครดิต ฝากถอน และโปรโมชั่น" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#c8e3d0]">
        ผู้ใช้งานใหม่สามารถ<strong class="text-[#f3fbf5]">สมัคร UVO88 ผ่านระบบออนไลน์ได้ด้วยตัวเอง</strong>
        เริ่มจากกรอกข้อมูลตามที่เว็บไซต์กำหนด จากนั้น Login เข้าบัญชี เลือกช่องทางฝากเครดิตที่เปิดรองรับ
        ตรวจสอบโปรโมชั่น และเลือกหมวดเกมที่ต้องการได้ทันที ใช้งานผ่านเว็บเบราว์เซอร์ได้ทั้งบนสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์
      </p>

      <p class="text-left text-base leading-relaxed text-[#c8e3d0]">
        หลังเปิดบัญชี สมาชิกสามารถ<strong class="text-[#f3fbf5]">ตรวจสอบเครดิต ฝากถอน โปรโมชั่น และประวัติรายการผ่านหน้าเว็บไซต์ได้</strong>
        ทำให้เห็นได้ด้วยตัวเองว่ารายการหนึ่งถูกบันทึกไว้อย่างไรและอยู่ในสถานะใด โดยไม่ต้องแจ้งรายการกับเจ้าหน้าที่ทุกครั้ง
      </p>

      <p class="text-left text-base leading-relaxed text-[#c8e3d0]">
        <strong class="text-[#ffd76a]">สำหรับเงื่อนไขการเดิมพันไม่มีขั้นต่ำ ควรยึดตัวเลขที่เกมหรือระบบแสดง ณ เวลาทำรายการ เนื่องจากเกมแต่ละประเภทอาจมีช่วงเดิมพันแตกต่างกัน และยอดขั้นต่ำของช่องทางฝากถอนก็อาจไม่เท่ากัน</strong>
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="โปรโมชั่น UVO88 แนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#c8e3d0]">
        สมาชิกสามารถนำลิงก์แนะนำส่วนตัวไปแชร์ให้เพื่อน เมื่อเพื่อนสมัคร UVO88 และมียอดใช้งานตรงตามข้อกำหนด
        ระบบจะคำนวณ<strong class="text-[#f2c230]">โบนัสแนะนำเพื่อน 0.8%</strong> จากยอดที่เข้าเงื่อนไข
        สามารถตรวจสอบจำนวนเพื่อน ยอดคำนวณ และโบนัสที่มีสิทธิ์รับผ่านบัญชีสมาชิกได้โดยตรง
        <strong class="text-[#ffd76a]">ก่อนรับโบนัสควรตรวจสอบรอบคำนวณ ประเภทเกมที่ร่วมรายการ และเงื่อนไขของโปรโมชั่นล่าสุดให้ครบถ้วน</strong>
      </p>

      <p class="text-left text-base leading-relaxed text-[#c8e3d0]">
        สมาชิกที่มียอดเสียตรงตามเงื่อนไขสามารถตรวจสอบสิทธิ์รับ<strong class="text-[#f2c230]">โบนัสคืนยอดเสีย 0.3%</strong>
        ตามรอบที่ UVO88 กำหนด ระบบจะแสดงยอดที่เข้าเกณฑ์และจำนวนโบนัสที่สามารถกดรับได้จากบัญชีสมาชิก
        <strong class="text-[#ffd76a]">ก่อนกดรับควรตรวจสอบประเภทเกม รอบเวลา วิธีคำนวณ และเงื่อนไขการถอนของโปรโมชั่น เพื่อให้ใช้งานโบนัสได้ตรงตามข้อกำหนด</strong>
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="แอดมิน UVO88 คอยให้บริการและสอบถามได้ 24 ชั่วโมง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#c8e3d0]">
        หากพบปัญหาเกี่ยวกับการสมัครสมาชิก Login ไม่ได้ ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง เข้าเกมไม่ได้ หรือโปรโมชั่นไม่แสดง สามารถ
        <strong class="text-[#f3fbf5]">ติดต่อแอดมิน UVO88 ได้ตลอด 24 ชั่วโมง</strong>
        พร้อมแจ้งรายละเอียด เวลา จำนวนเงิน หรือข้อมูลรายการที่เกี่ยวข้อง เพื่อช่วยให้เจ้าหน้าที่ตรวจสอบปัญหาได้ตรงจุด
      </p>

      <p class="text-left text-base leading-relaxed text-[#c8e3d0]">
        สมาชิกใหม่ยังสามารถสอบถามเกี่ยวกับขั้นตอนสมัคร วิธีฝากถอน การรับโปรโมชั่น หรือการเข้าใช้งานเกมแต่ละประเภทได้
        <strong class="text-[#ffd76a]">โดยไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่นระหว่างการติดต่อเจ้าหน้าที่</strong>
      </p>

      <p class="text-left text-base leading-relaxed text-[#c8e3d0]">
        <strong class="text-[#ffd76a]">การเดิมพันมีความเสี่ยงและผลของแต่ละรอบไม่แน่นอน ไม่มีเกมใดรับประกันผลล่วงหน้า</strong>
        สมาชิกจึงควรกำหนดงบประมาณก่อนเริ่มเล่นทุกครั้ง
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก UVO88"
          class="flex items-center justify-center rounded-lg border border-[#116330]/60 bg-gradient-to-r from-[#57dd8f] via-[#0f9d47] to-[#116330] px-8 py-3 font-black text-[#03110a] shadow-[0_0_15px_rgba(15,157,71,0.35)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ UVO88"
          class="flex items-center justify-center rounded-lg border border-[#f2c230]/55 bg-transparent px-8 py-3 font-bold text-[#f2c230] transition-all hover:scale-105 hover:border-[#f2c230] hover:bg-[#0a3b1c]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
