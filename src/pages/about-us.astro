---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "รู้จัก RUAYHENG289 คาสิโนออนไลน์ระบบออโต้ รองรับมือถือและคอมพิวเตอร์ เข้าใช้งานได้ทุกที่ทุกเวลา ฝากถอนอัตโนมัติรวดเร็ว พร้อมทีมงานดูแลสมาชิกตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ RUAYHENG289 คาสิโนออนไลน์ระบบออโต้",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา RUAYHENG289 คาสิโนออนไลน์ระบบออโต้" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ RUAYHENG289" as="h1">
    <p class="mb-6 text-left text-base leading-relaxed text-[#dfeacf]">
      <strong class="text-[#dfeacf]">RUAYHENG289</strong> คือคาสิโนออนไลน์ระบบออโต้ที่รวมเกมเดิมพันจากค่ายมาตรฐานไว้ในบัญชีเดียว รองรับการใช้งานผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ เข้าใช้งานได้สะดวกทุกที่ทุกเวลาโดยไม่ต้องติดตั้งโปรแกรมเพิ่มเติม ด้วยระบบที่ออกแบบมาให้ใช้งานง่าย เสถียร และโหลดรวดเร็ว
    </p>

    <p class="mb-8 text-left text-base leading-relaxed text-[#dfeacf]">
      ด้านการเงิน ระบบฝากถอนอัตโนมัติของ RUAYHENG289 เปิดให้ทำรายการได้ด้วยตนเองตลอด 24 ชั่วโมงโดยไม่ต้องรอเจ้าหน้าที่ทีละราย พร้อมรับอนุญาตจากเจ้าของแบรนด์ต้นฉบับโดยตรง ทำให้มั่นใจได้ในความปลอดภัยของข้อมูลสมาชิกและประวัติการทำรายการ และมีทีมงานคอยดูแลให้คำแนะนำตลอดการเดิมพัน เพื่อให้สมาชิกทุกคนใช้งาน RUAYHENG289 ได้อย่างมั่นใจในทุกขั้นตอน
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก"
        class="flex items-center justify-center rounded-lg border border-[#3fa316]/60 bg-gradient-to-b from-[#a4e254] to-[#3fa316] px-8 py-3 font-bold text-white shadow-[0_10px_30px_rgba(63,163,22,0.18)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(47,107,15,0.30)]">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ"
        class="flex items-center justify-center rounded-lg border border-[#3fa316]/60 bg-[#0a1207] px-8 py-3 font-extrabold text-[#dfeacf] shadow-[0_4px_14px_rgba(63,163,22,0.18)] transition-transform hover:scale-105 hover:bg-[#122008]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
