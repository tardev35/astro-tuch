---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่ม) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง
// ไม่ได้มาจากเช็กลิสต์หัวข้อของ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน
// SUB-PAGES ที่ให้ body จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริงของ UWIN33 เท่านั้น
//
// รอบนี้ (ดรอป 2026-09-24) คือ "UWIN33 พนันเว็บตรงยอดนิยมอันดับ1" เป็น **เว็บรวม
// เกมเดิมพัน** (บาคาร่า รูเล็ต ไฮโล สล็อต บอล หวย) ส่วนคอปปี้รอบก่อนเป็นของ
// MAHAGAME66 ซึ่งบรีฟระบุ "หมวดเกมไลฟ์สด" และ "ระบบฝากถอนวอลเลท/ธนาคาร" ไว้ —
// บรีฟของ UWIN33 **ไม่ได้ระบุทั้งสองอย่าง** ทั้งหน้าจึงถูกเขียนใหม่ และหัวข้อ
// "ระบบฝากถอน" ของรอบก่อนถูกถอดออก แทนที่ด้วยหัวข้อ "สมัคร 3 ขั้นตอน" ซึ่งบรีฟ
// รอบนี้ระบุไว้จริง ห้าม find-and-replace ชื่อแบรนด์ทับของเก่าเด็ดขาด
//
// ข้อเท็จจริงทุกบรรทัดมาจาก brand-spec §4 เท่านั้น: บาคาร่า · รูเล็ต · ไฮโล ·
// สล็อต · บอล · หวย · รวมทุกหมวดไว้ในบัญชีเดียว · เมนูแบ่งหมวดชัดเจน อ่านง่าย ·
// รองรับมือถือและคอมพิวเตอร์ · เลือกเกมตามประเภทและสลับหมวดได้ง่าย ·
// โบนัสแนะนำเพื่อน 0.8% · โบนัสคืนยอดเสีย 0.3% · ตรวจสอบยอดที่เข้าเกณฑ์ รอบคำนวณ
// และเงื่อนไขก่อนกดรับ · สมัครเองผ่านหน้าเว็บได้ใน 3 ขั้นตอน ·
// LINE OFFICIAL 24 ชั่วโมง
// — ห้ามอ้างชื่อค่ายเกม/ชื่อเกมเฉพาะ เลขใบอนุญาต ปีที่ก่อตั้ง เลขทะเบียนบริษัท
// จำนวนสมาชิก ค่า RTP ช่องทางฝากถอนเจาะจง "ไม่มีขั้นต่ำ" "ออโต้ 10 วินาที"
// ชื่อธนาคาร หรือการันตีว่าจะชนะ เพราะบรีฟรอบนี้ไม่ได้ระบุไว้
//
// Announcement รอบนี้หมุนมาใช้ AnnouncementPremium ทั้งเว็บ — default message ของ
// ไฟล์นั้นถูกตั้งเป็นคอปปี้ของ UWIN33 แล้ว จึงเรียกแบบ bare เหมือน index.astro
// ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ UWIN33 (ทอง + โครเมียม + ดำ ตามโลโก้ที่ U กับ 33 เป็นทองสามมิติ ส่วน
// WIN เป็นเงินโครเมียม): พื้นเพจ #080602 · ผิวการ์ด #161106 · ผิวการ์ดยก #26200e ·
// ทองแบรนด์ #e0b429 · ทองสว่าง #fbd564 · ทองอ่อน #fde9a3 · บรอนซ์ลึก #7a5407 ·
// เงินโครเมียม #dfe4ec · เนื้อความ #ece6d8 (BRAND_TEXT) · เน้นใน strong #fff8e6
// — พาเลตต์แดง-เงินของ MAHAGAME66 (#de161d #ff4d52 #7a0a0e #e2e8ef #9ba3ad
// #16090a #26100f #e8e3e1 #fff6f5 #080506) ถูกแทนครบทุกจุดแล้ว ห้ามนำกลับมา
// ไล่สีของปุ่มหลักและหัวข้อเดินตามโลโก้: เงินโครเมียม → ทองสว่าง → ทองแบรนด์
// ตัวอักษรบนพื้นทองต้องเป็นดำ #161106 เสมอ ห้ามใช้สีขาว
// ส่วน #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ตามเดิม
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลางที่ไม่หมุนตามรอบรีแบรนด์ และรอบนี้
// orchestrator เป็นคนรีธีม) — สีเนื้อความจึงตรงกับที่การ์ดกำหนดไว้อยู่แล้ว
//
// ไม่มีลิงก์ /ตรวจหวย หรือ /แนวทาง ในหน้านี้: UWIN33 ไม่ใช่เว็บหวยเฉพาะทาง สองหน้า
// นั้นไม่มีอยู่ใน src/pages/ รอบนี้ href ที่ชี้ route ซึ่งไม่มีใน dist/ จะทำให้
// verify-build แดง
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index และ /promotion
// ส่วน banner1/banner1-mobile เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า
// และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กค้างของลูกค้าเจ้าอื่น ห้าม import
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 158
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "เกี่ยวกับ UWIN33 เว็บรวมเกมเดิมพันทั้งบาคาร่า รูเล็ต ไฮโล สล็อต บอล และหวยในบัญชีเดียว พร้อมโปรโมชั่นแนะนำเพื่อน 0.8% คืนยอดเสีย 0.3% และแอดมินดูแล 24 ชั่วโมง";

const pageTitle = "เกี่ยวกับเรา UWIN33 เว็บตรง บาคาร่า รูเล็ต ไฮโล สล็อต บอล หวย ครบในบัญชีเดียว";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ece6d8]">
        <strong class="text-[#fff8e6]">UWIN33</strong> คือเว็บที่<strong class="text-[#fff8e6]">รวมเกมเดิมพันหลายประเภทไว้ในระบบเดียว</strong>
        ทั้งบาคาร่า รูเล็ต ไฮโล สล็อต บอล และหวย พร้อมเมนูที่แบ่งหมวดไว้ชัดเจน รองรับการเข้าใช้งานผ่านมือถือและคอมพิวเตอร์ ช่วยให้เลือกเกมที่สนใจและจัดการบัญชีได้สะดวกโดยไม่ต้องสลับใช้งานหลายเว็บไซต์
      </p>

      <p class="text-left text-base leading-relaxed text-[#ece6d8]">
        หน้านี้รวบรวมไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่หมวดเกมที่เปิดให้เลือก โปรโมชั่นที่ตรวจสอบรายละเอียดได้จากหน้าโปรโมชั่น ขั้นตอนการสมัครสมาชิก
        ไปจนถึงช่องทางสอบถามเจ้าหน้าที่เมื่อไม่แน่ใจในขั้นตอนใด
      </p>

      <p class="text-left text-base leading-relaxed text-[#ece6d8]">
        <strong class="text-[#fff8e6]">รายการเกมและเงื่อนไขของโปรโมชั่นอาจเปลี่ยนแปลงตามช่วงเวลา</strong>
        รายละเอียดทั้งหมดจึงยึดตามข้อมูลที่เว็บไซต์แสดงไว้จริงในขณะนั้นเป็นหลัก และควรตรวจสอบรายการล่าสุดจากหน้าเว็บไซต์ก่อนทำรายการทุกครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="UWIN33 รวมบาคาร่า รูเล็ต ไฮโล สล็อต บอล และหวยไว้ในเว็บเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ece6d8]">
        บริการหลักของ UWIN33 คือ <strong class="text-[#fff8e6]">ตัวเลือกเกมครบทั้งบาคาร่า รูเล็ต ไฮโล สล็อต บอล และหวย</strong>
        โดยรวบรวมแต่ละหมวดไว้ในบัญชีเดียว สมาชิกจึงเลือกหมวดที่ต้องการได้จากที่เดียว ไม่ต้องสลับไปเปิดหลายเว็บไซต์เพื่อดูว่ามีอะไรให้เล่นบ้าง
      </p>

      <p class="text-left text-base leading-relaxed text-[#ece6d8]">
        ก่อนเข้าเล่น สมาชิกสามารถ<strong class="text-[#fff8e6]">เลือกดูเกมตามประเภทและตรวจสอบรายละเอียดของแต่ละรายการได้</strong>
        แล้วสลับไปยังหมวดที่สนใจต่อได้ง่าย ระบบออกแบบให้เมนูอ่านชัด จึงหาหมวดที่ต้องการได้เร็วทั้งบนมือถือและคอมพิวเตอร์
      </p>
    </div>
  </ContentBox>

  <ContentBox title="โปรโมชั่น UWIN33 แนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ece6d8]">
        โปรโมชั่นของ UWIN33 <strong class="text-[#fff8e6]">จัดสิทธิ์ให้สมาชิกตามรายการและช่วงเวลาที่กำหนด</strong>
        โดยมีทั้งโบนัสแนะนำเพื่อน 0.8% สำหรับสมาชิกที่แนะนำเพื่อนเข้ามาสมัคร และโบนัสคืนยอดเสีย 0.3% ตามยอดและเงื่อนไขที่ระบบกำหนดไว้ในแต่ละรอบ
      </p>

      <p class="text-left text-base leading-relaxed text-[#ece6d8]">
        ระบบ<strong class="text-[#fff8e6]">แสดงยอดที่เข้าเกณฑ์ รอบคำนวณ และวิธีรับสิทธิ์ไว้ให้ตรวจสอบ</strong>
        สมาชิกจึงติดตามโบนัสของตัวเองในแต่ละรอบได้จากบัญชีสมาชิกโดยตรง และควรอ่านเงื่อนไขของรายการที่สนใจให้ครบก่อนกดรับทุกครั้ง เพราะแต่ละรายการมีรอบคำนวณไม่เหมือนกัน
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/promotion"
          aria-label="ดูภาพโปรโมชั่นทั้งหมดของ UWIN33"
          class="flex items-center justify-center rounded-lg border border-[#e0b429] bg-[#161106] px-8 py-3 font-bold text-[#ece6d8] transition-all hover:scale-105 hover:border-[#fbd564] hover:bg-[#26200e] hover:text-[#fff8e6]">
          ดูโปรโมชั่นทั้งหมด
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="สมัครสมาชิก UWIN33 ด้วยตัวเองใน 3 ขั้นตอน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ece6d8]">
        การสมัคร UWIN33 <strong class="text-[#fff8e6]">ทำผ่านหน้าเว็บไซต์ได้ด้วยตัวเอง ใช้ขั้นตอนไม่ซับซ้อน</strong>
        หลังยืนยันบัญชีเรียบร้อยสามารถเข้าสู่ระบบเพื่อเลือกเกมและตรวจสอบโปรโมชั่นที่เปิดให้รับได้ทันที โดยมีขั้นตอนหลักเพียง 3 ขั้นตอนดังนี้
      </p>

      <ol class="ml-6 list-decimal space-y-2 text-left text-base leading-relaxed text-[#ece6d8] marker:font-black marker:text-[#e0b429]">
        <li>เปิดหน้าสมัคร UWIN33 แล้วกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน</li>
        <li>ตรวจสอบข้อมูลส่วนตัวและรายละเอียดบัญชีให้ถูกต้องก่อนกดยืนยัน</li>
        <li>ยืนยันการสมัครและเข้าสู่ระบบ จากนั้นเลือกเกมและตรวจสอบโปรโมชั่นที่เปิดให้สมาชิกได้ทันที</li>
      </ol>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก UWIN33"
          class="flex items-center justify-center rounded-lg border border-[#fbd564]/60 bg-gradient-to-r from-[#dfe4ec] via-[#fbd564] to-[#e0b429] px-8 py-3 font-black text-[#161106] shadow-[0_0_15px_rgba(224,180,41,0.50)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ UWIN33"
          class="flex items-center justify-center rounded-lg border border-[#e0b429] bg-[#161106] px-8 py-3 font-bold text-[#ece6d8] transition-all hover:scale-105 hover:border-[#fbd564] hover:bg-[#26200e] hover:text-[#fff8e6]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="ใช้งาน UWIN33 ได้ทั้งมือถือและคอมพิวเตอร์จากบัญชีเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ece6d8]">
        UWIN33 <strong class="text-[#fff8e6]">รองรับการเข้าใช้งานผ่านมือถือและคอมพิวเตอร์</strong>
        เมนูแบ่งหมวดชัดเจนและอ่านง่าย ช่วยให้สมาชิกเลือกเกมที่สนใจได้สะดวกจากบัญชีเดียว ไม่ต้องจำหลายบัญชีเมื่อสลับอุปกรณ์ระหว่างวัน
      </p>

      <p class="text-left text-base leading-relaxed text-[#ece6d8]">
        หลังเข้าสู่ระบบ สมาชิกสามารถเปิดดูหมวดเกม ตรวจสอบรายละเอียดของแต่ละรายการ ดูเงื่อนไขของโปรโมชั่นที่เปิดให้กดรับ ไปจนถึง<strong class="text-[#fff8e6]">
          ติดตามยอดที่เข้าเกณฑ์และรอบรับสิทธิ์ได้จากบัญชีเดียวกัน
        </strong>
      </p>

      <p class="text-left text-base leading-relaxed text-[#ece6d8]">
        <strong class="text-[#fff8e6]">ผลของเกมทุกประเภทตัดสินจากผลของรอบนั้น ไม่มีสูตรหรือรูปแบบเดิมพันใดรับประกันผล</strong>
        จึงควรกำหนดงบประมาณก่อนทำรายการทุกครั้ง และหยุดเมื่อถึงขีดที่ตั้งไว้
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ติดต่อเจ้าหน้าที่ UWIN33 ผ่าน LINE OFFICIAL 24 ชั่วโมง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ece6d8]">
        หากมีข้อสงสัยเกี่ยวกับการสมัคร โปรโมชั่น ทางเข้าเกม หรือการใช้งานบัญชี สามารถ
        <strong class="text-[#fff8e6]">ติดต่อเจ้าหน้าที่ UWIN33 ผ่าน LINE OFFICIAL ได้ตลอด 24 ชั่วโมง</strong>
        ทีมงานพร้อมช่วยให้ข้อมูลเกี่ยวกับบาคาร่า รูเล็ต ไฮโล สล็อต บอล หวย และตรวจสอบปัญหาการใช้งานตามรายละเอียดที่สมาชิกแจ้งเข้ามา
      </p>

      <p class="text-left text-base leading-relaxed text-[#ece6d8]">
