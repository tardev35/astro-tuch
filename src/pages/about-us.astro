---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

// SUPERMAX168 เป็นเว็บ "คาสิโนออนไลน์เว็บตรง" ที่เปิดครบห้าหมวด — บาคาร่า สล็อต บอล หวย
// และไฮโล ไม่ใช่เว็บสล็อตล้วนแบบรอบรีแบรนด์ก่อนหน้า เนื้อหาทั้งหน้าจึงถูกเขียนใหม่ให้พูดถึง
// ทั้งห้าหมวดตามบรีฟ: รวมทุกรูปแบบการเดิมพันในบัญชีเดียว ตรวจกติกา อัตราจ่าย และวงเงินก่อน
// ทำรายการ โปรโมชั่นแนะนำเพื่อน 0.8% คืนยอดเสีย 0.3% ฝากถอนวอลเลท/ธนาคาร และแอดมิน 24 ชม.
// — ไม่มีการอ้างใบอนุญาต การจดทะเบียนบริษัท ปีที่ก่อตั้ง จำนวนสมาชิก การันตีผลกำไร
// ชื่อค่ายเกมรายใด หรือตาราง RTP ตายตัว
//
// Announcement หมุนมาใช้ AnnouncementPremium ตัวเดียวกับ index — default message ของไฟล์นั้น
// เป็นคอปปี้ของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ไม่ต้องส่ง prop
//
// โลโก้ SUPERMAX168 เป็นสองโทน (SUPER ทอง / MAX-168 เงินโครเมียม) เงิน #e3e3e4 จึงถูกใช้เป็น
// accent รองจริงในหน้านี้ ทั้งไอคอนสลับสีในลิสต์และปุ่มเข้าสู่ระบบ ไม่ใช่ทองจางลง
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 152
const pageDescription =
  "เกี่ยวกับ SUPERMAX168 คาสิโนออนไลน์เว็บตรงที่รวมบาคาร่า สล็อต บอล หวย และไฮโล ไว้ในบัญชีเดียว พร้อมระบบฝากถอนวอลเลทและแอดมินคอยดูแลสมาชิกตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ SUPERMAX168 คาสิโนเว็บตรง100% รวมทุกรูปแบบการเดิมพันในบัญชีเดียว",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา SUPERMAX168 คาสิโนเว็บตรง100% บาคาร่า สล็อต บอล หวย ไฮโล" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ SUPERMAX168 คาสิโนเว็บตรง100% รวมทุกรูปแบบการเดิมพันในบัญชีเดียว" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f3e6c8]">
        <strong class="text-[#fff8e2]">SUPERMAX168</strong> เปิดบริการ<strong class="text-[#ecc964]">เกมคาสิโนออนไลน์หลายรูปแบบผ่านบัญชีเดียว</strong>
        ทั้งบาคาร่า สล็อต บอล หวย และไฮโล รองรับการเข้าใช้งานผ่านมือถือและคอมพิวเตอร์ตลอด 24 ชั่วโมง
        หน้าเว็บไซต์รวมส่วนเลือกเกม ฝากถอน ตรวจสอบโปรโมชั่น และจัดการเครดิตไว้ที่เดียว พร้อมช่องทางวอลเลทและธนาคารตามที่ระบบเปิดรองรับ
      </p>

      <p class="text-left text-base leading-relaxed text-[#f3e6c8]">
        นอกจากหมวดเกมแล้ว ยังมี<strong class="text-[#e3e3e4]">โปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไข</strong>
        รวมถึงทีมงานคอยดูแลปัญหาการใช้งานตลอด 24 ชั่วโมง
        สมาชิกจึงตรวจสอบสิทธิ์ เงื่อนไข และสถานะรายการของตนเองได้จากบัญชีเดียวโดยไม่ต้องสมัครหลายครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="SUPERMAX168 รวมบาคาร่า สล็อต บอล หวย และไฮโล เลือกเล่นได้จากบัญชีเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f3e6c8]">
        SUPERMAX168 จัดหมวดเกมหลักไว้ให้เลือกตามความต้องการ สมาชิกสามารถ<strong class="text-[#ecc964]">สลับหมวดและสลับเกมผ่านบัญชีเดียวได้โดยไม่ต้องสมัครใหม่</strong>
        พร้อมตรวจสอบกติกา อัตราจ่าย และวงเงินเดิมพันของแต่ละหมวดก่อนทำรายการได้ด้วยตัวเอง
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f3e6c8]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ecc964]">🃏</span>
          <span><strong class="text-[#ecc964]">บาคาร่าออนไลน์</strong> สำหรับผู้ที่ชอบเกมไพ่ ควรอ่านกติกาการนับแต้มและอัตราจ่ายของแต่ละโต๊ะก่อนวางเดิมพัน</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e3e3e4]">🎰</span>
          <span><strong class="text-[#e3e3e4]">สล็อตออนไลน์จากหลายค่าย</strong> ต่างกันที่จำนวนวงล้อ เส้นรางวัล และรอบโบนัส หน้าอธิบายในตัวเกมบอกไว้ว่านับผลอย่างไร</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ecc964]">⚽</span>
          <span><strong class="text-[#ecc964]">เดิมพันฟุตบอลตามรายการแข่งขัน</strong> รูปแบบบิลและอัตราต่อรองเปลี่ยนไปตามคู่ที่เปิดรับ ควรตรวจสอบก่อนยืนยันบิล</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e3e3e4]">🎫</span>
          <span><strong class="text-[#e3e3e4]">หวยออนไลน์ตามรอบที่เปิดรับ</strong> แต่ละรอบมีเวลาปิดรับและวงเงินต่อบิลของตัวเอง ให้ยึดข้อมูลที่ระบบแสดงในหน้าแทงเป็นหลัก</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ecc964]">🎲</span>
          <span><strong class="text-[#ecc964]">ไฮโลในหมวดคาสิโน</strong> นับผลจากแต้มลูกเต๋าตามที่โต๊ะกำหนด ควรดูอัตราจ่ายของแต่ละประตูก่อนลงเดิมพันทุกครั้ง</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#f3e6c8]">
        <strong class="text-[#ecc964]">ผลของแต่ละรอบไม่แน่นอน จึงไม่มีเกมหรือหมวดใดรับประกันว่าจะสร้างกำไรได้ทุกครั้ง</strong>
        ควรเลือกเกมจากกติกา รูปแบบการเดิมพัน และงบประมาณที่เหมาะสมกับตนเอง
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="โปรโมชั่น SUPERMAX168 แนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f3e6c8]">
        สมาชิกที่มีบัญชี SUPERMAX168 สามารถ <strong class="text-[#ecc964]">Login เพื่อตรวจสอบโปรโมชั่นที่เปิดให้รับในแต่ละช่วง</strong>
        โดยมีทั้งกิจกรรมแนะนำเพื่อนและโบนัสคืนยอดเสีย สิทธิ์แต่ละรายการอาจกำหนดยอดที่ใช้คำนวณ รอบรับโบนัส เกมที่เข้าร่วม
        และเงื่อนไขการถอนแตกต่างกัน จึงควรอ่านรายละเอียดให้ครบก่อนกดรับโปรโมชั่น
      </p>

      <p class="text-left text-base leading-relaxed text-[#f3e6c8]">
        โปรโมชั่นแนะนำเพื่อนให้สมาชิกแชร์ลิงก์แนะนำส่วนตัวให้เพื่อน เมื่อเพื่อนสมัครและมีรายการตรงตามเงื่อนไข ระบบจะคำนวณโบนัส
        <strong class="text-[#e3e3e4]">แนะนำเพื่อน 0.8%</strong> ตามยอดที่เข้าเกณฑ์ และตรวจสอบจำนวนเพื่อน ยอดคำนวณ และโบนัสที่มีสิทธิ์รับผ่านบัญชีสมาชิกได้ด้วยตัวเอง
        ส่วนสมาชิกที่มียอดเสียตรงตามข้อกำหนดสามารถตรวจสอบสิทธิ์รับ<strong class="text-[#e3e3e4]">โบนัสคืนยอดเสีย 0.3%</strong>
        ตามรอบที่ SUPERMAX168 กำหนด โดยระบบจะแสดงยอดที่เข้าเงื่อนไขและจำนวนโบนัสที่สามารถกดรับได้
      </p>

      <p class="text-left text-base leading-relaxed text-[#f3e6c8]">
        ก่อนรับสิทธิ์ทุกครั้งควรตรวจสอบ<strong class="text-[#ecc964]">ประเภทเกม รอบคำนวณ และเงื่อนไขของโปรโมชั่น</strong>ให้เรียบร้อย
        เพราะวิธีคำนวณและข้อกำหนดล่าสุดของแต่ละรายการไม่เหมือนกัน
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ระบบฝากถอน SUPERMAX168 รองรับวอลเลทและธนาคารชั้นนำ" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f3e6c8]">
        SUPERMAX168 มีระบบฝากถอนที่<strong class="text-[#ecc964]">ช่วยให้สมาชิกจัดการเครดิตผ่านบัญชีของตนเอง</strong>
        สามารถเลือกใช้วอลเลทหรือบัญชีธนาคารจากช่องทางที่เว็บไซต์เปิดรองรับ ทำรายการฝาก ส่งคำขอถอน
        และติดตามสถานะรายการผ่านมือถือได้โดยตรง ช่วยลดขั้นตอนและไม่จำเป็นต้องแจ้งรายการกับเจ้าหน้าที่ทุกครั้ง
      </p>

      <p class="text-left text-base leading-relaxed text-[#f3e6c8]">
        ก่อนทำธุรกรรมทุกครั้งควรตรวจสอบ<strong class="text-[#ecc964]">ชื่อบัญชี จำนวนเงิน ยอดขั้นต่ำ และวงเงินของช่องทางที่เลือก</strong>
        เนื่องจากธนาคารหรือวอลเลทแต่ละประเภทอาจมีเงื่อนไขแตกต่างกัน ให้ยึดข้อมูลที่ระบบแสดง ณ เวลาทำรายการเป็นหลัก
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ติดต่อสอบถามแอดมิน SUPERMAX168 ได้ตลอด 24 ชั่วโมง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f3e6c8]">
        หากสมาชิกพบปัญหาเกี่ยวกับการสมัคร Login เข้าเกมไม่ได้ ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง หรือโปรโมชั่นไม่แสดง สามารถ
        <strong class="text-[#ecc964]">ติดต่อแอดมิน SUPERMAX168 ได้ตลอด 24 ชั่วโมง</strong>
        โดยควรแจ้งเวลา จำนวนเงิน และรายละเอียดของรายการให้ครบ เพื่อช่วยให้เจ้าหน้าที่ตรวจสอบปัญหาได้รวดเร็วและตรงจุด
      </p>

      <p class="text-left text-base leading-relaxed text-[#f3e6c8]">
        สมาชิกใหม่ยังสามารถสอบถามขั้นตอนการใช้งาน วิธีฝากถอน การรับโปรโมชั่น หรือรายละเอียดเกมแต่ละประเภทได้
        หากเป็นปัญหาด้านธุรกรรมควรเก็บหลักฐานรายการไว้จนกว่าการตรวจสอบจะเสร็จสิ้น
        และ<strong class="text-[#e3e3e4]">ไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น</strong>
      </p>

      <p class="text-left text-base leading-relaxed text-[#f3e6c8]">
        <strong class="text-[#ecc964]">การเดิมพันมีความเสี่ยงและผลของแต่ละรอบไม่แน่นอน ไม่มีเกมหรือรูปแบบใดรับประกันผลล่วงหน้า</strong>
        สมาชิกจึงควรกำหนดงบประมาณก่อนเริ่มเล่นทุกครั้ง
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก SUPERMAX168"
          class="flex items-center justify-center rounded-lg border border-[#d2a43b]/60 bg-gradient-to-r from-[#f9e38b] via-[#ecc964] to-[#ba8219] px-8 py-3 font-black text-[#030201] shadow-[0_0_15px_rgba(236,201,100,0.35)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ SUPERMAX168"
          class="flex items-center justify-center rounded-lg border border-[#e3e3e4]/55 bg-transparent px-8 py-3 font-bold text-[#e3e3e4] transition-all hover:scale-105 hover:border-[#e3e3e4] hover:bg-[#1b140b]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
