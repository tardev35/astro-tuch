---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login, /register,
// /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx
// ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึง
// เขียนขึ้นใหม่บนข้อเท็จจริงของบรีฟรอบนี้เท่านั้น (src/assets/content.txt)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x4 · h3x0
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) จึงเปิดใช้งานอยู่ และ brand-spec §10 สั่งให้
// คงไว้ ไม่ได้ park ลง src/pages-disabled/
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// ตัวที่ routing จริงคือไฟล์นี้ Astro ไม่อ่านโฟลเดอร์นั้นเลย ห้ามแก้และห้ามลบ
//
// ⚠️ ดรอปนี้ (2026-10-17) คือ **เว็บเกมสล็อตล้วน** ไม่ใช่หมวดอื่นใดทั้งสิ้น
// (สองหน้าของหมวดที่แบรนด์ก่อนๆ เคยเปิดจอดอยู่ใน src/pages-disabled/ ไม่มี route
// ห้ามลิงก์ไปหา เป็น href ตายที่ทำให้ build แดง) หน้าเดิมทั้งหน้าเขียนบนกรอบของ
// แบรนด์ก่อน ซึ่งขายตัวเองเป็นหมวดเกมคนละชุดกับรอบนี้ — **บรีฟรอบนี้ไม่มีกรอบนั้น
// เลยสักคำ** จึงเขียนใหม่ทั้งหน้า ไม่ใช่ find-and-replace ทับประโยคเดิม หัวข้อ
// หมวดเกมของรอบก่อนถูกถอดทั้งหัวข้อ แทนที่ด้วยหัวข้อ "เรื่องที่ติดต่อขอความช่วยเหลือ
// ได้" ซึ่งเป็นสิ่งที่บรีฟรอบนี้มีจริง (content.txt บรรทัด 4 + 6 + 7)
// คำที่ brand-spec §7 ห้ามไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำต้องห้ามเจอ
// false positive
//
// แง่มุมที่บรีฟรอบนี้ระบุไว้มีเท่านี้ (ห้ามเติมอย่างอื่น): ช่องทางติดต่อผู้ให้บริการ ·
// เว็บเกมสล็อต · เกมสล็อตสั่งได้ · สอบถามข้อมูลและขอความช่วยเหลือ · ปัญหาการเข้าสู่ระบบ ·
// การตรวจสอบบัญชี · การใช้งานเกม · เกมไม่แสดงผล · รายการเครดิตไม่ตรง · การสอบถาม
// โปรโมชั่น · แจ้งรายละเอียดปัญหา เวลาที่เกิดเหตุ ข้อความแจ้งเตือน · ติดตามสถานะ
// การแก้ไขปัญหา · เวลาตอบกลับจริง · หลักฐานประกอบ · ปิดบังข้อมูลสำคัญ · รหัสผ่าน PIN
// OTP · คืนยอดเสีย 0.3% รอบประจำวัน เวลาตัดยอด ยอดที่เข้าเกณฑ์ เกมที่ร่วมรายการ
// การใช้โบนัส · แนะนำเพื่อน 0.8% ไม่จำกัด ลิงก์แนะนำ ระบบสมาชิก · สมัครสมาชิก
// 3 ขั้นตอน ชื่อโดเมน ข้อมูลผู้ให้บริการ รหัสผ่านที่คาดเดายาก ยืนยันบัญชี ข้อกำหนด ·
// LINE Official แอดมิน 24 ชั่วโมง บัญชีปลอม ฝ่ายบริการลูกค้า
//
// ตัวเลขที่อ้างได้มีสามตัวของบรีฟเอง: 0.3% · 0.8% · 24 ชั่วโมง ส่วนรายการตัวเลข
// และชื่อเฉพาะที่ห้ามแต่งขึ้นเองอยู่ครบใน brand-spec §7 (ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้
// การ sweep หาคำต้องห้ามของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง)
//
// ประโยคกำกับ (hedge) ที่บรีฟเขียนไว้เองและห้ามตัดทิ้งเพราะฟังดูไม่ขายของ — ขนมาครบ
// ตาม brand-spec §5/§7:
// 1) ควรตรวจสอบข้อมูลติดต่อจากช่องทางหลักก่อนส่งข้อมูลส่วนตัวทุกครั้ง (h1 ย่อหน้าท้าย)
// 2) ควรตรวจสอบช่องทางติดต่อและเวลาตอบกลับจริงจากหน้าเว็บไซต์ · หากต้องส่งหลักฐาน
//    ประกอบ ควรปิดบังข้อมูลสำคัญที่ไม่จำเป็น (h2 #1 ย่อหน้าท้าย)
// 3) ควรอ่านเงื่อนไขให้ครบก่อนเข้าร่วม · คำว่าไม่จำกัดควรตรวจสอบให้ชัด (h2 #2)
// 4) ควรตรวจสอบชื่อโดเมนและข้อมูลผู้ให้บริการให้ถูกต้องก่อนกรอกข้อมูลส่วนตัว (h2 #3)
// 5) ควรเลือกบัญชี LINE ที่เชื่อมโยงจากแหล่งข้อมูลทางการโดยตรง เพื่อหลีกเลี่ยงบัญชี
//    ปลอม · ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP (h2 #4 ย่อหน้าท้าย)
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **แดงมังกรนำ ทองไทยรอง บนพื้นดำอมแดง**
// ⚠️ สองแบรนด์ก่อนหน้าก็เป็นแดงเหมือนกัน และแดงของทั้งคู่ต่างจากรอบนี้แค่หลักเดียว
// "มีแดงอยู่" จึงไม่ใช่ตัวบอกว่าถูกแบรนด์ ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน
// brand-spec §2 (ค่าเดิมไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ
// false positive) สิ่งที่ทำให้รอบนี้ต่างจริงคือ **ทองไทย** กับพื้นดำอมแดง
// ลำดับความลึก: #2c1413 ผิวยก (= การ์ด) / #1f0d0c กลาง / #140706 จม / #290f0f พื้นเพจ
//
// ลำดับปุ่มสื่อด้วย "แดงถม vs ผิวจมขอบแดง" — คู่พื้น-หมึกคำนวณไว้แล้ว:
// · ปุ่มหลัก (สมัครสมาชิก) ถมแดงไล่ #ff5a5f → #fa0513 ขอบ #b90203 หมึก #170504
//   (4.8:1 บนปลายเข้ม และสูงกว่านั้นบนปลายสว่าง) ⚠️ ไล่เฉดต้องหยุดที่ #fa0513
//   ห้ามไล่ลงไปเข้มกว่านั้นใต้ตัวอักษร
// · ปุ่มรอง/ปุ่มลิงก์ภายในเป็นชั้นจม #1f0d0c → #140706 ขอบ #fa0513/55
//   ตัวอักษร #f4ecea — hover ยกขอบเป็นแดงสว่าง #ff5a5f
// · marker ของลำดับเลขใช้ทองไทย #e3b23c (8.9:1 บนผิวการ์ด — เป็นตัวอักษร จึงใช้
//   แดงแบรนด์ไม่ได้ และ #ffadaf สงวนไว้ให้ <strong> เท่านั้น)
// · #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ (§8)
// ⚠️ #fa0513 · #b90203 · #8c0204 · #5b0203 · #3c0303 · #8a6210 ห้ามถือตัวอักษร
// ทุกขนาด ใช้ได้แค่เส้นขอบ ออรา เงา และพื้นถม — ออราในไฟล์นี้ใช้ rgba(250,5,19,α)
// เท่านั้น และรอบนี้ไม่มีโครเมียม ไม่มีม่วง ไม่มีชมพู ไม่มีน้ำเงิน ไม่มีฟ้า
// ไม่มีเขียว ไม่มีส้ม
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #f4ecea,
// 14.9:1 บนผิวยก #2c1413) ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง
// ปล่อยให้สืบทอดลงมา และไม่ใส่ mx-auto / max-w-* บน <p> เพราะการ์ดคุมความกว้างเองแล้ว
// — ที่ประกาศสีได้มีแค่ปุ่ม (ถมพื้นของตัวเองจึงต้องกำหนดหมึกของตัวเอง) marker ของ
// ลำดับเลข และ <strong> ซึ่ง brand-spec §2 สงวน #ffadaf (9.8:1 บนผิวการ์ด) ไว้เป็น
// สีไฮไลต์ในเนื้อความโดยเฉพาะ และไม่ใช้สีอื่นเลย · แต่ละ <strong> ครอบ "ช่วงที่คั่น
// ด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ
// บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง (ลบแท็ก <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิม)
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1 ของดรอปนี้เป็นของ index กับ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้าง
// จากหน้า และ banner2/banner3/slide2/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน
// ห้าม import (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้หมุนมาเป็น Announcement3 ทั้งเว็บ (brand-spec §3)
// orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียก
// แบบ bare ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 155
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} เว็บเกมสล็อตที่รวมช่องทางติดต่อผู้ให้บริการไว้ในที่เดียว ทั้งการขอความช่วยเหลือเรื่องบัญชีและเกม เงื่อนไขโปรโมชั่น และการสมัครสมาชิก`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} เว็บเกมสล็อตและช่องทางติดต่อผู้ให้บริการ`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#ffadaf]">{BRAND_NAME} คือเว็บเกมสล็อตที่เปิดช่องทางติดต่อผู้ให้บริการไว้สำหรับผู้ที่ต้องการสอบถามข้อมูลและขอความช่วยเหลือเกี่ยวกับการใช้งาน</strong>
        ไม่ว่าจะเป็นปัญหาการเข้าสู่ระบบ การตรวจสอบบัญชี การใช้งานเกม หรือการสอบถามโปรโมชั่น ผู้เล่นสามารถติดต่อผ่านช่องทางที่เว็บไซต์กำหนด เพื่อแจ้งรายละเอียดและติดตามสถานะการแก้ไขปัญหาได้สะดวก
      </p>

      <p>
        หน้านี้สรุปไว้ว่าเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่เรื่องที่ติดต่อขอความช่วยเหลือได้ ไปจนถึงรายการโปรโมชั่น ขั้นตอนการสมัครสมาชิก และช่องทางติดต่อแอดมิน
        <strong class="text-[#ffadaf]">เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดดูอะไรตรงไหน</strong>
        แล้วจึงค่อยลงรายละเอียดของรายการที่สนใจเป็นรายรายการจากหน้าเว็บไซต์เอง
      </p>

      <p>
        <strong class="text-[#ffadaf]">โดยควรตรวจสอบข้อมูลติดต่อจากช่องทางหลักก่อนส่งข้อมูลส่วนตัวทุกครั้ง</strong>
        ไม่ใช่ยึดจากข้อความที่ส่งต่อกันมาเพียงอย่างเดียว ข้อมูลในหน้านี้จึงเขียนไว้เพื่อบอกว่าเว็บไซต์มีอะไรให้ใช้และควรตรวจอะไรก่อนตัดสินใจ
        ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้งาน
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`เรื่องที่ติดต่อขอความช่วยเหลือจาก ${BRAND_NAME} ได้ตลอด 24 ชั่วโมง`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        ผู้เล่นที่ใช้งาน {BRAND_NAME} สามารถติดต่อสอบถามเกี่ยวกับการใช้งานบัญชีและระบบเกมสล็อตได้ตามช่องทางบริการที่เว็บไซต์เปิดให้บริการ
        <strong class="text-[#ffadaf]">การแจ้งรายละเอียดปัญหาให้ชัดเจน เช่น เวลาที่เกิดเหตุและข้อความแจ้งเตือน จะช่วยให้เจ้าหน้าที่ตรวจสอบข้อมูลได้ตรงประเด็นมากขึ้น</strong>
        เรื่องที่เว็บไซต์ระบุว่าสอบถามได้แบ่งออกได้ประมาณนี้
      </p>

      <ul class="flex flex-col gap-3" aria-label={`เรื่องที่ติดต่อขอความช่วยเหลือจากผู้ให้บริการ ${BRAND_NAME} ได้`}>
        <li class="flex gap-3">
          <span aria-hidden="true">🔑</span>
          <span>
            <strong class="text-[#ffadaf]">การเข้าสู่ระบบ</strong> กรณีเข้าสู่ระบบไม่ได้ ควรแจ้งเวลาที่เกิดเหตุและข้อความแจ้งเตือนที่หน้าจอแสดงไว้ เพื่อให้เจ้าหน้าที่ตรวจสอบตรงกับรายการที่เกิดขึ้นจริง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">🎰</span>
          <span>
