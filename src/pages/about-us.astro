---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

// TIGER88 เป็นเว็บ "สล็อต" ไม่ใช่เว็บรวมหลายหมวดและไม่ใช่หวย — ทุกข้อความด้านล่าง
// อ้างอิง src/assets/content.txt เท่านั้น ไม่มีการอ้างใบอนุญาต รางวัล
// หรือการันตีผลกำไร (ตัวบรีฟเองก็ระบุว่าเกมสล็อตรับประกันผลรางวัลไม่ได้
// และขั้นต่ำจริงต่างกันไปตามแต่ละเกม)
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 159
const pageDescription =
  "รู้จัก TIGER88 เว็บสล็อตออนไลน์รวมเกมค่ายจริงไว้ในระบบเดียว เดิมพันเริ่มต้นประมาณ 1 บาท พร้อมโปรโมชั่นแนะนำเพื่อน 0.8% คืนยอดเสีย 0.3% และแอดมินดูแล 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ TIGER88 เว็บสล็อตออนไลน์รวมเกมจากค่ายจริงในระบบเดียว",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา TIGER88 สล็อตไทเกอร์แท้ รวมเกมจากค่ายจริงไว้ในระบบเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ TIGER88" as="h1">
    <div>
      <p class="mb-6 text-left text-base leading-relaxed text-[#f2e3c9]">
        <strong class="text-[#fdd121]">TIGER88</strong> เป็นช่องทางสำหรับผู้ที่ต้องการ<strong class="text-[#fdd121]">เล่นเกมสล็อตออนไลน์จากค่ายจริงผ่านระบบเดียว</strong>
        รองรับการใช้งานบนมือถือ แท็บเล็ต และคอมพิวเตอร์ ภายในเว็บมีทั้งสล็อตธีมยอดนิยม เกมโบนัส ฟรีสปิน และเกมที่รองรับการเดิมพันเริ่มต้นระดับต่ำ
        สมาชิกเลือกเกม ตรวจสอบโปรโมชั่น ฝากถอน และจัดการเครดิตของตนเองได้จากบัญชีเดียว โดยไม่ต้องเปิดบัญชีแยกตามค่ายเกมที่อยากลอง
      </p>

      <p class="mb-2 text-left text-base leading-relaxed text-[#f2e3c9]">
        นอกจากตัวเกมแล้ว สมาชิกยังตรวจสอบสิทธิ์โปรโมชั่นได้จากหน้าเว็บไซต์โดยตรง ทั้ง<strong class="text-[#ff2a36]">แนะนำเพื่อนรับโบนัส 0.8%</strong>
        และ<strong class="text-[#ff2a36]">คืนยอดเสีย 0.3%</strong> ตามเงื่อนไขของแต่ละรายการ พร้อมมีแอดมินคอยดูแลปัญหาการใช้งานตลอด 24 ชั่วโมง
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="เกมสล็อต TIGER88 จากค่ายจริง เลือกเล่นได้จากบัญชีเดียว" as="h2">
    <div>
      <p class="mb-4 text-left text-base leading-relaxed text-[#f2e3c9]">
        สมาชิกที่กำลังมองหาเกมน่าสนใจ สามารถเริ่มดูจากเกมยอดนิยมที่มีกติกาและฟีเจอร์แตกต่างกัน โดยควรเลือกจาก
        <strong class="text-[#fdd121]">รูปแบบเกม ค่า RTP ความผันผวน และขนาดเดิมพันที่เหมาะกับเงินทุน</strong> มากกว่าตัดสินจากคำว่าแตกง่าย
        เพราะไม่มีเกมสล็อตใดรับประกันผลรางวัลหรือจังหวะการจ่ายได้
      </p>

      <ul class="mb-4 flex flex-col gap-3 text-left text-base leading-relaxed text-[#f2e3c9]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fdd121]">🐯</span>
          <span><strong class="text-[#fdd121]">Fortune Tiger</strong> สล็อตธีมเสือมงคล หน้าจอเข้าใจง่าย เหมาะกับผู้ที่ไม่ต้องการเริ่มจากเกมที่มีระบบซับซ้อน ก่อนเล่นควรเปิด Paytable ดูสัญลักษณ์และช่วงเดิมพันที่เกมรองรับ</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fdd121]">🀄</span>
          <span><strong class="text-[#fdd121]">Mahjong Ways 2</strong> ธีมไพ่นกกระจอก มีระบบ Free Spins และตัวคูณตามกลไกของเกม ควรทำความเข้าใจวิธีเกิดชุดรางวัลและเงื่อนไขเข้าสู่รอบโบนัสก่อนเดิมพัน</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fdd121]">🐱</span>
          <span><strong class="text-[#fdd121]">Lucky Neko</strong> ธีมแมวกวักนำโชคแบบญี่ปุ่น มีทั้งรอบปกติและฟีเจอร์โบนัสภายในเกม ตรวจสอบ Paytable, Free Spins และช่วงการเดิมพันก่อนเริ่มเล่นได้</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fdd121]">🌵</span>
          <span><strong class="text-[#fdd121]">Wild Bandito</strong> ธีมเม็กซิกันที่ภาพต่างจากสล็อตเอเชีย พร้อมกลไกโบนัสตามกติกาของเกม เหมาะกับคนที่ต้องการสลับบรรยากาศจากเกมยอดนิยมทั่วไป</span>
        </li>
      </ul>

      <p class="mb-2 text-left text-base leading-relaxed text-[#d6bf95]">
        ส่วนเรื่อง<strong class="text-[#d6bf95]">ยอดเดิมพันขั้นต่ำ</strong> เกมสล็อตหลายเกมรองรับการเดิมพันเริ่มต้นประมาณ 1 บาท แต่ขั้นต่ำจริงขึ้นอยู่กับเกมและผู้ให้บริการแต่ละราย
        จึงควรตรวจสอบตัวเลขเดิมพันบนหน้าเกมก่อนกด Spin ทุกครั้ง และผลของรอบก่อนหน้าไม่ได้บอกว่ารอบถัดไปจะจ่ายหรือไม่
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="โปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ของ TIGER88" as="h2">
    <div>
      <p class="mb-2 text-left text-base leading-relaxed text-[#f2e3c9]">
        กิจกรรม<strong class="text-[#fdd121]">แนะนำเพื่อน</strong> เริ่มจากการนำลิงก์แนะนำส่วนตัวไปแชร์ให้เพื่อน เมื่อเพื่อนสมัครและมีรายการตรงตามเงื่อนไข
        ระบบจะคำนวณโบนัสแนะนำเพื่อน 0.8% โดยสมาชิกตรวจสอบจำนวนการแนะนำ ยอดที่นำมาคำนวณ และโบนัสที่มีสิทธิ์รับได้ผ่านบัญชีของตนเอง
        ทั้งนี้การแชร์ลิงก์เพียงอย่างเดียวอาจยังไม่ทำให้ได้รับโบนัส หากโปรโมชั่นกำหนดให้ผู้ถูกแนะนำต้องสมัคร ฝากเงิน หรือมียอดเล่นตามเกณฑ์
      </p>

      <p class="mt-3 mb-2 text-left text-base leading-relaxed text-[#f2e3c9]">
        ส่วนสมาชิกที่มียอดเสียตรงตามข้อกำหนด สามารถตรวจสอบสิทธิ์รับ<strong class="text-[#fdd121]">โบนัสคืนยอดเสีย 0.3%</strong> ตามรอบที่ TIGER88 กำหนด
        ก่อนกดรับควรตรวจสอบประเภทเกมที่ร่วมรายการ ยอดที่ใช้คำนวณ และเงื่อนไขของโปรโมชั่นให้ครบถ้วน
        โดยโบนัสคืนยอดเสียไม่ได้รับประกันว่าจะชดเชยเงินที่เสียจากการเดิมพันทั้งหมด
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="สมัคร TIGER88 ด้วยตัวเอง 3 ขั้นตอน และแอดมินดูแลตลอด 24 ชั่วโมง" as="h2">
    <div>
      <p class="mb-4 text-left text-base leading-relaxed text-[#f2e3c9]">
        เริ่มต้นใช้งาน TIGER88 ผ่านมือถือหรือคอมพิวเตอร์ได้ด้วยขั้นตอนที่ไม่ซับซ้อน ระบบรองรับการใช้งานผ่านเว็บเบราว์เซอร์โดยตรงทั้งบน Android และ iOS
        หลังเปิดบัญชีเรียบร้อยสามารถตรวจสอบเครดิต โปรโมชั่น ประวัติการทำรายการ และสถานะฝากถอนผ่านบัญชีของตนเองได้ทันที
      </p>

      <ol class="mb-4 flex flex-col gap-2 text-left text-base leading-relaxed text-[#f2e3c9]">
        <li class="flex gap-3"><span class="font-bold text-[#fdd121]">1.</span> สมัครสมาชิก TIGER88 และกรอกข้อมูลตามที่ระบบกำหนด</li>
        <li class="flex gap-3"><span class="font-bold text-[#fdd121]">2.</span> Login เข้าบัญชีและฝากเครดิตผ่านช่องทางที่เปิดให้บริการ</li>
        <li class="flex gap-3"><span class="font-bold text-[#fdd121]">3.</span> เลือกเกมสล็อต ตรวจสอบขั้นต่ำและกติกา แล้วกำหนดงบประมาณก่อนเดิมพัน</li>
      </ol>

      <p class="mb-4 text-left text-base leading-relaxed text-[#f2e3c9]">
        สมาชิกควรตั้งรหัสผ่านที่คาดเดายาก และ<strong class="text-[#ff2a36]">ไม่เปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น</strong>
        รวมถึงควรตรวจสอบว่ากำลังใช้งานช่องทางของผู้ให้บริการที่ถูกต้องก่อนทำธุรกรรมทุกครั้ง
      </p>

      <p class="mb-6 text-left text-base leading-relaxed text-[#f2e3c9]">
        หากพบปัญหาเกี่ยวกับการสมัคร Login ไม่ได้ ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง โปรโมชั่นไม่แสดง หรือเข้าเกมสล็อตไม่ได้ สามารถ
        <strong class="text-[#fdd121]">ติดต่อแอดมิน TIGER88 ได้ตลอด 24 ชั่วโมง</strong> พร้อมแจ้งเวลา จำนวนเงิน และรายละเอียดของรายการ
        เพื่อช่วยให้เจ้าหน้าที่ตรวจสอบปัญหาได้ตรงจุด รวมถึงสอบถามข้อมูลเกี่ยวกับกติกา โปรโมชั่น และขั้นตอนการใช้งานสำหรับสมาชิกใหม่ได้
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก TIGER88"
          class="flex items-center justify-center rounded-lg border border-[#fdd121]/50 bg-gradient-to-r from-[#ff2a36] via-[#ef1622] to-[#b00a12] px-8 py-3 font-black text-[#f2e3c9] shadow-[0_0_15px_rgba(239,22,34,0.4)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ TIGER88"
          class="flex items-center justify-center rounded-lg border border-[#fdd121]/60 bg-transparent px-8 py-3 font-bold text-[#fdd121] transition-all hover:scale-105 hover:border-[#ffe98a] hover:bg-[#5e0505]/70">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
