---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion,
// /login, /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์
// หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา
// ทั้งหน้าจึงเขียนขึ้นใหม่บนข้อเท็จจริงของ HI59 เท่านั้น (src/assets/content.txt)
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก NavbarStyle6 (เกี่ยวกับเรา) จึงเปิดใช้งานอยู่
//
// ดรอปนี้ (2026-10-07) คือ HI59 **เว็บสล็อตออนไลน์** ไม่ใช่เว็บหวย แง่มุมที่บรีฟ
// ระบุไว้มีเท่านี้: สล็อตไฮคลาสเน้นรูปแบบการใช้งานสไตล์ VIP · รวมเกมสล็อตจาก
// หลายค่ายไว้ในบัญชีเดียว · สล็อตยอดนิยม เกมเปิดใหม่ ฟรีสปิน ตัวคูณ ฟีเจอร์โบนัส ·
// รองรับมือถือและคอมพิวเตอร์ · เลือกค่าย ค้นหาเกม ตรวจสอบเครดิต โปรโมชั่น และ
// ประวัติรายการ · สลับเกมและค่ายผ่านบัญชีเดียวโดยไม่ต้องสมัครใหม่หลายครั้ง ·
// แต่ละเกมมีรูปแบบวงล้อ ฟีเจอร์โบนัส ฟรีสปิน และช่วงเดิมพันต่างกัน ·
// ตรวจสอบรายละเอียดเกมก่อนเริ่มเล่น · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% ·
// Login เพื่อตรวจสอบโบนัส ยอดที่เข้าเกณฑ์ และรอบรับสิทธิ์ · ฝากถอนตามช่องทางที่
// ระบบเปิดให้บริการ · ยอดเข้าบริษัทตรง ไม่ผ่านบัญชีม้า · แอดมิน 24 ชั่วโมง ·
// PIN รหัสผ่าน OTP
//
// ⚠️ แบรนด์ก่อนหน้าของหน้านี้คือ หวยดีใจ (เว็บรับแทงหวย) และก่อนหน้านั้นคือ หวย24
// คำชุดหวยทั้งหมดจึงห้ามหลงเหลือ: หวย แทงหวย ส่งโพย โพย เลข 2 ตัว เลข 3 ตัว
// เลขเด็ด แนวทาง หวยลาว หวยฮานอย หวยออมสิน ธ.ก.ส. อัตราจ่าย เรทจ่าย ไม่อั้นจ่าย
// ไม่มีลบโพย งวด ผลรางวัล — เขียนใหม่จากบรีฟ ไม่ใช่ find-and-replace ทับประโยคเดิม
// ลิงก์ /แนวทาง กับ /ตรวจหวย ถูกย้ายไป src/pages-disabled/ รอบนี้ จึงถอดออกจากหน้า
// ด้วย (ลิงก์ที่ไม่มีปลายทางจริงทำให้ verify-build แดง)
//
// ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 100% · 24 ชั่วโมง
// ห้ามเติมเลขใบอนุญาต หน่วยงานกำกับ ชื่อผู้ให้บริการ ชื่อค่ายเกม ชื่อธนาคาร
// ค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีที่ก่อตั้ง เพราะบรีฟไม่ได้เอ่ยไว้สักอย่าง
//
// ประโยคกำกับที่บรีฟเขียนไว้เองและห้ามตัดทิ้งเพราะฟังดูไม่ขายของ: การระบุว่าเป็น
// เว็บตรงหรือใช้เกมลิขสิทธิ์แท้ควรมีข้อมูลผู้ให้บริการที่ตรวจสอบได้รองรับ ·
// "ส่งตรงจากเว็บแม่" ควรมีรายชื่อผู้ให้บริการหรือข้อมูลการเชื่อมต่อที่ตรวจสอบได้ ·
// "ปลอดภัย 100%" ไม่ควรใช้เป็นการรับประกันโดยไม่มีหลักฐาน · "โบนัสสูง ให้เยอะ
// กว่าใคร" ควรมีข้อมูลเปรียบเทียบรองรับ · "ฝากถอนได้ทุกช่องทาง" ควรหมายถึงเฉพาะ
// ช่องทางที่ระบบรองรับจริง · "ไม่ผ่านบัญชีม้า" ควรมีข้อมูลบัญชีและนิติบุคคลรองรับ
//
// พาเลตต์ HI59 (brand-spec §2) **ฟ้าสว่าง + ทอง VIP บนการ์ดกระจกน้ำแข็ง** —
// รอบนี้กลับขั้วจากทุกแบรนด์ก่อนหน้า การ์ดสว่าง ไม่ใช่การ์ดมืด: เนื้อความกรมท่า
// #0d2744 (= BRAND_TEXT ที่การ์ดตั้งไว้ให้) · หมึก strong และลิงก์บนการ์ดสว่าง
// #065a9c (ฟ้าแบรนด์ #0a84e0 ได้แค่ 4.0:1 จึงใช้เป็นขอบ/เรืองแสงเท่านั้น) ·
// ไอคอนและ marker ทองเข้ม #c88a02 (ทองสว่างบนพื้นขาวอ่านไม่ออก) · ปุ่มหลักเป็น
// ทองตัน #ffe27a → #fdbc04 → #c88a02 หมึกกรมท่า #04203f · ปุ่มรองเป็นฟ้าเข้ม
// #065a9c → #044b80 → #033f70 หมึก #eaf5ff · ปุ่มเส้นขอบเป็นผิว #e7f2fd ขอบ
// #0a84e0 หมึก #065a9c
// ชุดแดงแบรนด์+เงินโครเมียมของ หวยดีใจ (#dc0409 #f5363d #8e0206 #eef0f4 #c3c7d1
// #f3c54e #0d0407 #211016) ออกครบทุกจุดแล้ว ทั้งคลาส Tailwind raw hex และ rgba()
// #00B900/#009900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// — การ์ดตั้ง text-left text-base leading-relaxed text-[#0d2744] ไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าจึงไม่ถือคลาสสีของตัวเอง ใส่สีเฉพาะที่ <strong> กับไอคอน
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจาก
// หน้า และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น Announcement2 ทั้งเว็บ (รอบก่อน หวยดีใจ ใช้ Announcement5)
// — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ HI59 แล้ว จึงเรียก
// แบบ bare ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 159 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} สล็อตไฮคลาสสไตล์ VIP ที่รวมค่ายเกมพรีเมียมไว้ในบัญชีเดียว ทั้งสล็อตยอดนิยม เกมเปิดใหม่ ฟรีสปิน ตัวคูณ ฟีเจอร์โบนัส พร้อมโปรโมชั่นและการฝากถอน`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} สล็อตไฮคลาส รวมค่ายเกมพรีเมียมไว้ในบัญชีเดียว`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#065a9c]">{BRAND_NAME} คือเว็บสล็อตไฮคลาสที่เน้นรูปแบบการใช้งานสไตล์ VIP และรวบรวมเกมสล็อตจากหลายค่ายไว้ในบัญชีเดียว</strong>
        มีทั้งสล็อตยอดนิยม เกมเปิดใหม่ ฟรีสปิน ตัวคูณ และฟีเจอร์โบนัสหลากหลายรูปแบบ รองรับการเข้าเล่นผ่านมือถือและคอมพิวเตอร์ โดยสมาชิกเลือกค่าย ค้นหาเกม ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการได้จากที่เดียว
      </p>

      <p>
        หน้านี้สรุปไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่การสลับค่ายและเลือกเกม
        <strong class="text-[#065a9c]">ไปจนถึงโปรโมชั่นคืนยอดเสียและแนะนำเพื่อน ช่องทางฝากถอนที่ระบบเปิดให้บริการ และการติดต่อแอดมินที่ดูแลตลอด 24 ชั่วโมง</strong>
        เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดดูอะไรตรงไหน แล้วจึงค่อยลงรายละเอียดของเกมหรือแคมเปญที่สนใจเป็นรายรายการ
      </p>

      <p>
        สิ่งที่ควรอ่านไปพร้อมกันคือข้อจำกัดของข้อความประชาสัมพันธ์
        <strong class="text-[#065a9c]">การระบุว่าเป็นเว็บตรงหรือใช้เกมลิขสิทธิ์แท้ ควรมีข้อมูลผู้ให้บริการที่ตรวจสอบได้รองรับอย่างชัดเจน</strong>
        ข้อมูลในหน้านี้จึงเขียนไว้เพื่อบอกว่าระบบมีอะไรให้ใช้และควรตรวจอะไรก่อนตัดสินใจ ไม่ได้ใช้แทนการอ่านเงื่อนไขและรายละเอียดที่เว็บไซต์แสดงอยู่ตรงหน้า
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`${BRAND_NAME} รวมค่ายเกมพรีเมียม สลับเกมได้จากบัญชีเดียวโดยไม่ต้องสมัครใหม่`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        เว็บ {BRAND_NAME} รวมค่ายเกมพรีเมียมไว้ให้เลือกหลายสไตล์
        <strong class="text-[#065a9c]">ช่วยให้สมาชิกสลับเกมและค่ายผ่านบัญชีเดียวได้โดยไม่ต้องสมัครใหม่หลายครั้ง</strong>
        เกมแต่ละตัวไม่ได้ทำงานเหมือนกันทั้งหมด จึงควรเปิดดูรายละเอียดก่อนเริ่มเล่น เพื่อเลือกประเภทที่ตรงกับความสนใจได้ง่ายขึ้น สิ่งที่ต่างกันในแต่ละเกมแบ่งออกได้ประมาณนี้
      </p>

      <ul class="flex flex-col gap-3" aria-label={`สิ่งที่แตกต่างกันในเกมสล็อตแต่ละตัวบนเว็บ ${BRAND_NAME}`}>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#c88a02]">🎰</span>
          <span>
            <strong class="text-[#065a9c]">รูปแบบวงล้อ</strong> เป็นโครงของเกมที่ทำให้สล็อตคลาสสิกกับเกมเปิดใหม่เล่นไม่เหมือนกัน การเปิดดูรูปแบบวงล้อก่อนจึงช่วยให้รู้ว่าเกมนั้นเป็นแนวที่กำลังมองหาหรือไม่
            ก่อนจะลงเครดิตจริง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#c88a02]">✨</span>
          <span>
            <strong class="text-[#065a9c]">ฟีเจอร์โบนัส ฟรีสปิน และตัวคูณ</strong> มีไม่เท่ากันในแต่ละเกม บางเกมมีครบ บางเกมมีเพียงบางอย่าง จึงควรอ่านรายละเอียดของเกมนั้นโดยตรง มากกว่าจะเทียบจากเกมอื่นที่เคยเล่นมาก่อน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#c88a02]">💠</span>
          <span>
            <strong class="text-[#065a9c]">ช่วงเดิมพันของแต่ละเกม</strong> เป็นตัวบอกว่าเกมนั้นเหมาะกับงบที่ตั้งไว้หรือไม่ ควรตรวจสอบก่อนเริ่มเล่นทุกครั้ง เพราะค่ายและเกมที่ต่างกันไม่จำเป็นต้องเปิดช่วงเดิมพันชุดเดียวกัน
          </span>
        </li>
      </ul>

      <p>
        ส่วนคำโฆษณาที่มักเห็นคู่กัน ควรอ่านอย่างมีเงื่อนไข
        <strong class="text-[#065a9c]">หากระบุว่าเกมส่งตรงจากเว็บแม่ ควรมีรายชื่อผู้ให้บริการหรือข้อมูลการเชื่อมต่อที่สามารถตรวจสอบได้</strong>
        และคำว่าปลอดภัย 100% ไม่ควรใช้เป็นการรับประกันโดยไม่มีหลักฐานด้านระบบ ความปลอดภัย หรือข้อมูลผู้ดำเนินงานประกอบ รายชื่อค่ายและจำนวนเกมเองก็อาจมีการอัปเดต จึงควรยึดรายการล่าสุดจากหน้าเกมสล็อตของเว็บไซต์
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/ทดลองเล่น"
          aria-label={`เปิดหน้าทดลองเล่นของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#0a84e0]/70 bg-[#e7f2fd] px-8 py-3 font-bold text-[#065a9c] transition-all hover:scale-105 hover:border-[#065a9c] hover:bg-[#d3e7fa]">
          ไปหน้าทดลองเล่น
        </a>

        <a
          href="/promotion"
          aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#0a84e0]/70 bg-[#e7f2fd] px-8 py-3 font-bold text-[#065a9c] transition-all hover:scale-105 hover:border-[#065a9c] hover:bg-[#d3e7fa]">
          ดูภาพโปรโมชั่น
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`โปรโมชั่นของ ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        โปรโมชั่นเล่นสล็อต {BRAND_NAME} มีสิทธิ์สำหรับสมาชิกตามแคมเปญที่เปิดในแต่ละช่วง
        <strong class="text-[#065a9c]">สามารถ Login เพื่อตรวจสอบโบนัส ยอดที่เข้าเกณฑ์ และรอบรับสิทธิ์ผ่านบัญชีของตัวเองได้</strong>
        โดยกิจกรรมที่บรรยายไว้บนเว็บไซต์มีสองรายการหลัก ซึ่งคำนวณจากยอดคนละชุดกันและอาจมีรอบตัดยอดกับค่ายเกมที่ร่วมรายการต่างกัน
      </p>

