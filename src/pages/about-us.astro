---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login, /register,
// /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx
// ที่ใช้กับ index.astro — บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES
// ที่ให้ body มา ทั้งหน้าจึงเขียนขึ้นใหม่จากข้อเท็จจริงและคลังคำของบรีฟรอบนี้เท่านั้น
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x4 · h3x0
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) จึงเปิดใช้งานอยู่
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// ตัวที่ routing จริงคือไฟล์นี้ Astro ไม่อ่านโฟลเดอร์นั้นเลย ห้ามแก้และห้ามลบ
//
// ⚠️ ดรอปนี้ (2026-10-19) คือ **เว็บสล็อตล้วน** ไม่ใช่คาสิโน ไม่มีกีฬา และไม่ใช่
// เว็บหวย สองหน้าของหมวดลอตเตอรีที่แบรนด์ก่อนๆ เคยเปิด จอดอยู่ใน src/pages-disabled/
// ไม่มี route ห้ามลิงก์ไปหา เป็น href ตายที่ทำให้ build แดง route ที่มีจริงรอบนี้คือ
// / · /about-us · /contact-us · /login · /register · /privacy · /promotion ·
// /terms · /ทดลองเล่น · /ทางเข้า · /line
//
// ⚠️ แบรนด์ก่อนหน้าทันที (รวยแทร่168 ที่ถูกแทนที่รอบนี้) ก็เป็นแบรนด์สล็อตเหมือนกัน
// คอปปี้และโครงหัวข้อเดิมจึง "ดูเข้าเค้า" ทั้งที่กรอบของบรีฟคนละอัน —
// **ห้าม find-and-replace ทับประโยคเดิม** ทั้งหน้าถูกเขียนใหม่รอบกรอบของบรีฟรอบนี้
// ซึ่งว่าด้วย **เกมสล็อตสำหรับคนรุ่นใหม่ที่เน้นใช้งานบนมือถือ เข้าถึงเมนูได้ง่าย
// เลือกศึกษาตามงบประมาณของตนเอง มีช่องทางฝากถอนผ่านวอลเลทและธนาคารชั้นนำ และมี
// โปรโมชั่นสองรายการคือคืนยอดเสีย 0.3% กับแนะนำเพื่อน 0.8%** ไม่ใช่กรอบของรอบก่อน
// ซึ่งยกความผันผวนของเกมขึ้นเป็นหัวข้อหลัก และมีคำกล่าวอ้างเรื่องกำไร
// (คำต้องห้ามไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive —
// รายการเต็มอยู่ใน brand-spec §6)
//
// 🚨 **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกมแม้แต่ค่ายเดียว** จึงห้ามเขียนชื่อค่ายใดๆ
// ลงหน้าเว็บ ให้ใช้คำกลางว่า "ค่ายเกม" ตามบรีฟ
//
// คลังคำที่บรีฟรอบนี้ให้มา และใช้ได้เท่านี้ (brand-spec §6): สล็อต ·
// เกมสล็อตออนไลน์ · คนรุ่นใหม่ · เจนซี · ระบบทางเข้า · ค่ายเกม · กติกา ·
// อัตราเดิมพัน · เดิมพันขั้นต่ำ · ไม่มีขั้นต่ำ · งบประมาณ · ตารางจ่ายรางวัล ·
// เงื่อนไขบริการ · โปรโมชั่น · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · โบนัส ·
// เครดิต · ยอดเสีย · รอบสรุปยอด · รอบจ่ายเครดิต · ลิงก์แนะนำ · เชื่อมโยงบัญชี ·
// สมัครสมาชิก · เข้าสู่ระบบ · ลงทะเบียน · ข้อมูลส่วนบุคคล · รหัสผ่าน · รหัส OTP ·
// ฝากถอน · วอลเลทและธนาคารชั้นนำ · เจ้าหน้าที่ · แอดมิน · 24ชม. · ช่องทางทางการ ·
// มือถือ
//
// ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 24ชม. · 3 ขั้นตอน ส่วนตัวเลขและ
// ชื่อเฉพาะที่ห้ามแต่งขึ้นเองอยู่ครบใน brand-spec §6 (เลขใบอนุญาต · หน่วยงานกำกับ ·
// ชื่อนิติบุคคล · ชื่อธนาคารเฉพาะราย · ค่า RTP · ยอดฝากขั้นต่ำ · จำนวนสมาชิก ·
// ปีก่อตั้ง · ชื่อค่ายเกม)
//
// ⚠️ คำว่า "ไม่มีขั้นต่ำ" และ "รับได้ไม่จำกัด" อยู่ได้เฉพาะในหัวข้อที่บรีฟเขียนไว้เอง
// (= หัวข้อของ index.astro) หน้านี้จึงไม่หยิบมาเป็นหัวข้อ เพราะย่อหน้าของบรีฟเอง
// หักล้างทันทีว่าบางค่ายอาจกำหนดอัตราเดิมพันแตกต่างกัน และไม่มีเกมสล็อตใดรับประกัน
// ผลกำไรหรือเงินรางวัลในทุกรอบ
//
// 🚨 บรีฟรอบนี้ **โฆษณากับกำกับความเสี่ยงอยู่ในย่อหน้าเดียวกัน** และประโยคกำกับ
// ทุกประโยคต้องขึ้นครบ เป็นเนื้อหาของบรีฟ ไม่ใช่ filler ให้ตัดทิ้ง:
// 1) ควรตรวจสอบกติกา อัตราเดิมพัน และเงื่อนไขบริการก่อนเริ่มใช้งานทุกครั้ง (h1)
// 2) บางค่ายอาจกำหนดอัตราเดิมพันแตกต่างกัน · ไม่มีเกมสล็อตใดรับประกันผลกำไรหรือ
//    เงินรางวัลในทุกรอบ (h2 #1)
// 3) เครดิตคืนยอดเสียไม่ใช่การรับประกันผลตอบแทนจากการเดิมพันครั้งต่อไป (h2 #2)
// 4) แม้โปรโมชั่นจะระบุว่าไม่จำกัด แต่ควรตรวจสอบรายละเอียดเกี่ยวกับจำนวนผู้เข้าร่วม
//    รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสให้ชัดเจน (h2 #2)
// 5) ไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น (h2 #3, #4)
// 6) ควรยืนยันเวลาการให้บริการและระยะเวลาตอบกลับล่าสุดอีกครั้ง (h2 #4)
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **แดงชาดนำ ทองเนยรอง บนดำสนิท**
// ⚠️ สามรอบก่อนเป็นฟ้านำ+ทอง/เหลืองรอง รอบนี้หลุดออกจากฟ้า **แต่แดงเองก็เคยถูกใช้
// มาแล้วสามแบรนด์** (สมหวัง168 · รับตัง168 · ขวัญใจ168) และแทบทุกแบรนด์ที่ผ่านรีโป
// นี้มีทอง "เจอแดงอยู่แล้ว" หรือ "เจอทองอยู่แล้ว" จึงไม่ใช่ตัวบอกว่าถูกแบรนด์ ให้
// เทียบเป็น "ค่า" ทีละตัวกับตารางใน brand-spec §2 (ค่าเดิมไม่พิมพ์ซ้ำที่นี่ เพื่อ
// ไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive ในไฟล์นี้)
// แดงรอบนี้คือ **#fb1b32** (R251 G27 B50 — ชาดอมชมพู) ชมพูบลัช **#ff8f9c** และ
// ฮิวที่สองคือ **ทองเนย #fcd45c** (R252 G212 B92)
// ลำดับความลึก: #2b0711 ผิวยก (= การ์ด) / #1a040a กลาง / #0c0205 จม / #000000 พื้นเพจ
//
// ลำดับปุ่มสื่อด้วย "พื้นถมแดง vs ผิวจมขอบแดงลึก" — คู่พื้น-หมึกคำนวณไว้แล้ว:
// · ปุ่มหลัก (สมัครสมาชิก) ถมไล่เฉด #ff8f9c → #fb1b32 ขอบ #5c0410 หมึก #1b0308
//   (9.1:1 บนปลายชมพูบลัช · 5.0:1 บนปลายแดงแบรนด์ ผ่าน AA ทั้งเส้น)
// · ปุ่มรอง/ปุ่มลิงก์ภายในเป็นชั้นจม #1a040a → #0c0205 ขอบ #5c0410
//   ตัวอักษร #fdeaec — hover ยกขอบเป็นทองเนย #fcd45c (ตรงกับ hover ของการ์ด
//   ContentBox ซึ่งใช้ #fcd45c/70 เป็นขอบ hover เหมือนกัน)
// · marker ของลำดับเลขใช้ชมพูบลัช #ff8f9c (8.5:1 บนผิวการ์ด — เป็นตัวอักษร จึงใช้
//   แดงลึกไม่ได้ และ #fcd45c สงวนไว้ให้ <strong> เท่านั้น)
// · #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ (§2.3)
// ⚠️ #5c0410 · #6b4a08 ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่เส้นขอบ ออรา เงา และพื้นถม
// — ออราในไฟล์นี้ใช้ rgba(92,4,16,α) · rgba(251,27,50,α) · rgba(252,212,92,α)
// เท่านั้น และรอบนี้ไม่มีฟ้า/น้ำเงิน ไม่มีม่วง ไม่มีเขียว (นอกจาก LINE) ไม่มีส้ม
// ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์ ไม่มีเหลืองมะนาว และไม่มีชมพูฟูเชีย
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #fdeaec,
// 15.0:1 บนผิวยก #2b0711) ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง
// ปล่อยให้สืบทอดลงมา และไม่ใส่ mx-auto / max-w-* บน <p> เพราะการ์ดคุมความกว้างเองแล้ว
// — ที่ประกาศสีได้มีแค่ปุ่ม (ถมพื้นของตัวเองจึงต้องกำหนดหมึกของตัวเอง) marker ของ
// ลำดับเลข และ <strong> ซึ่ง brand-spec §2 สงวน #fcd45c (12.9:1 บนผิวการ์ด) ไว้เป็น
// สีไฮไลต์ในเนื้อความโดยเฉพาะ และไม่ใช้สีอื่นเลย · แต่ละ <strong> ครอบ "ช่วงที่คั่น
// ด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ
// บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง (ลบแท็ก <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิม)
// และห้ามวาง <strong> สองอันติดกัน
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้าง
// จากหน้า และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้หมุนมาเป็น Announcement5 ทั้งเว็บ (brand-spec §3 —
// รอบก่อนใช้ Announcement3 จึงหมุนออก) orchestrator ตั้ง default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message
// มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 155 อักขระ
//
// ห้ามให้สตริงนี้มีชื่อของสองหน้าหมวดลอตเตอรีที่จอดอยู่ใน src/pages-disabled/
// (ชื่อไฟล์ทั้งสองอยู่ใน brand-spec §1) เพราะ sweep ของรอบถัดไปจะอ่านเป็น
// false positive ว่ายังมีลิงก์ไปหน้าที่ไม่มี route
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} รวมข้อมูลเกมสล็อตออนไลน์สำหรับคนรุ่นใหม่ ทั้งกติกา อัตราเดิมพัน โปรโมชั่นคืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% และช่องทางติดต่อแอดมิน 24ชม.`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} เกมสล็อตออนไลน์สำหรับคนรุ่นใหม่ ใช้งานง่ายบนมือถือ`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#fcd45c]">{BRAND_NAME} นำเสนอเกมสล็อตออนไลน์สำหรับคนรุ่นใหม่ที่ชอบความสะดวกและต้องการเข้าถึงเมนูต่างๆ ได้ง่าย</strong>
        ทั้งการสมัครสมาชิก เลือกเกม ตรวจสอบโปรโมชั่น และทำรายการฝากถอนผ่านช่องทางที่รองรับ หน้านี้รวบรวมไว้ว่าเว็บไซต์ระบุอะไรไว้บ้าง เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดดูอะไรตรงไหน แล้วจึงค่อยอ่านรายละเอียดของแต่ละเรื่องเป็นรายข้อ
      </p>

      <p>
        รูปแบบการใช้งานที่เว็บไซต์เน้นไว้คือการใช้งานบนมือถือ พร้อมข้อมูลเกมจากหลายค่ายเกมให้เลือกศึกษา
        <strong class="text-[#fcd45c]">โดยผู้เล่นควรตรวจสอบกติกา อัตราเดิมพัน และเงื่อนไขบริการก่อนเริ่มใช้งานทุกครั้ง</strong>
        ซึ่งเป็นลำดับที่ช่วยให้ทราบว่าแต่ละเกมกำหนดอะไรไว้บ้าง และต้องเตรียมข้อมูลอะไรก่อนดำเนินการต่อในขั้นตอนถัดไป
      </p>

      <p>
