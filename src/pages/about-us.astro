---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion,
// /login, /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์
// หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ (src/assets/content.txt) ไม่มี
// ส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่จากข้อเท็จจริงและคลังคำของบรีฟรอบนี้
// เท่านั้น (.claude/brand-spec-naza168.md §5)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x4 · h3x0
//   h1  เกี่ยวกับเรา <แบรนด์> เว็บเกมสล็อตออนไลน์และข้อมูลที่หน้านี้รวบรวมไว้
//   h2  ระบบเล่นง่าย รองรับภาษาไทย และการตรวจสอบสถานะลิขสิทธิ์ของเกม
//   h2  โปรโมชั่นสมาชิก <แบรนด์> คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%
//   h2  ฝากถอนเข้าบริษัทตรง ไม่ผ่านม้า และการตรวจชื่อบัญชีปลายทาง
//   h2  ช่องทางติดต่อแอดมิน <แบรนด์> ตลอด 24ชม.
// รายการในกล่องเป็น <ul> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) และจาก footer จึงเปิดใช้งานอยู่
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// เป็นของแบรนด์เก่ามาก ตัวที่ routing จริงคือไฟล์นี้ Astro ไม่อ่านโฟลเดอร์นั้นเลย
// **ห้ามแก้ ห้ามลบ และห้ามสลับมาแทนไฟล์นี้**
//
// 🚨 แกนของดรอปนี้ (2026-10-23) คือ **เว็บสล็อตออนไลน์ธีมอวกาศ** ที่บรีฟเขียนถึง
// ตัวเองว่า: ระบบเล่นง่าย · รองรับภาษาไทย · ลิขสิทธิ์แท้จากอเมริกา ·
// ฝากถอนเข้าบริษัทตรง ไม่ผ่านม้า · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% ·
// กดรับได้ไม่จำกัด · ธนาคารและทรูมันนี่ · แอดมิน 24ชม.
// ⚠️⚠️ **แบรนด์ขาออกขายจุดยืนคนละแบบกับรอบนี้** คำขายของกลุ่มนั้นที่เคยอยู่ใน
// ไฟล์นี้จึงเป็นคำค้างของแบรนด์ขาออก **ไม่ใช่ของรอบนี้** (ทั้งกลุ่มคำสถิติของเกม
// กลุ่มคำขีดจำกัดของการทำรายการ และกลุ่มคำขั้นตอนสมัครที่นับเป็นข้อ ซึ่งบรีฟรอบนี้
// ไม่มีสักคำ) **รายการคำต้องห้ามเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่**
// เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// ⚠️⚠️ **รีโปนี้เคยมีลูกค้าชื่อเดียวกันแต่สะกดด้วยตัวละติน** (ดู brand-spec §0) —
// รอบนี้สะกดได้แบบเดียวคือค่าใน BRAND_NAME ซึ่งเป็นภาษาไทยล้วน ห้ามพิมพ์ตรงๆ
// ⚠️ `ทดลองเล่น` เหลือรอดได้เฉพาะในฐานะ **ชื่อ route /ทดลองเล่น** ซึ่งเป็นหน้าที่มี
// อยู่จริงและอยู่ในเมนูนาวบาร์ — ห้ามใช้เป็นคำโฆษณาเกี่ยวกับตัวเกมของแบรนด์นี้
//
// ⚠️⚠️ **สองหน้าหมวดลอตเตอรีจอดอยู่ใน src/pages-disabled/ รอบนี้** → ลิงก์ไป
// สอง route นั้นจะทำให้ build แดง ห้ามเขียนกลับมา
// route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ทดลองเล่น · /about-us · /contact-us · /terms · /privacy · /line
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกม ชื่อธนาคาร ชื่อวอลเล็ต ชื่อผู้ให้บริการ
// หน่วยงานกำกับ ใบอนุญาต ปีก่อตั้ง จำนวนสมาชิก จำนวนเกม หรือยอดขั้นต่ำที่เป็น
// ตัวเลข แม้แต่รายการเดียว** จึงห้ามเขียนลงหน้าเว็บ · ตัวเลขที่ขึ้นหน้าได้มีแค่ของ
// บรีฟเอง: **0.3% · 0.8% · 24ชม.** (ไม่มีจำนวนขั้นตอนที่นับเป็นข้อ ไม่มีเปอร์เซ็นต์
// เต็มร้อย และไม่มีค่าสถิติของเกมที่เป็นตัวเลข)
//
// 🚨 **บรีฟรอบนี้โฆษณาแล้วเบรกตัวเองในย่อหน้าเดียวกันแทบทุกย่อหน้า** — ทั้งสอง
// ครึ่งต้อง ship ครบตามที่เขียน ประโยคเบรกไม่ใช่ filler ให้ตัดทิ้ง:
// 1) ควรตรวจสอบชื่อบัญชีปลายทางและข้อมูลนิติบุคคลจากหลักฐานที่เชื่อถือได้ เพื่อ
//    หลีกเลี่ยงความเสี่ยงจากบัญชีแอบอ้าง (h1)
// 2) การรองรับภาษาไทยไม่ได้เป็นหลักฐานยืนยันแหล่งที่มาหรือสถานะลิขสิทธิ์ของเกม (h2 #1)
// 3) แม้จะระบุว่ากดรับได้ไม่จำกัด แต่ควรตรวจสอบจำนวนครั้งที่รับสิทธิ์ได้จริง ·
//    การคืนเครดิตไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือทำให้มีโอกาส
//    ชนะมากขึ้น (h2 #2)
// 4) หากพบชื่อบัญชีไม่ตรงกับข้อมูลทางการหรือมีการแจ้งเปลี่ยนบัญชีอย่างผิดปกติ
//    ควรหยุดทำรายการและติดต่อธนาคารหรือผู้ให้บริการชำระเงินก่อนโอนเงิน (h2 #3)
// 5) ควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชี
//    แอบอ้าง · ไม่เปิดเผยรหัสผ่านหรือรหัส OTP · ควรตรวจสอบเวลาการให้บริการจริง
//    จากประกาศล่าสุดอีกครั้ง (h2 #4)
//
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) เป็น **ธีมมืด กลับทิศจากรอบก่อน 180 องศา**
// bg.json ของดรอปนี้คือ {"mode":"color","color":"#0d1017"} = ถ่านเกือบดำอมน้ำเงิน
// (รอบก่อนเป็น dbe6ff = ฟ้าเพอริวิงเคิลอ่อน ซึ่งเป็น **ธีมสว่าง**)
// **ห้าม "แก้" กลับไปเป็นการ์ดพื้นสว่างเพราะเห็นว่ารอบก่อนทำแบบนั้น**
// ค่าที่ใช้ได้ในไฟล์นี้: ฟ้าไซยาน #1fd8f0 (<strong> + marker + ตัวอักษรปุ่มรอง —
// 9.1:1 บนผิวการ์ด ถือตัวอักษรได้) · น้ำเงินอุลตรามารีน #1d4fd8 และ #143aa0
// (**พื้นถมของปุ่มหลักเท่านั้น 2.4:1 บนการ์ด ห้ามถือตัวอักษร**) · ผิวจม #121722
// และผิวยก #273449 (พื้นปุ่ม/ชิป) · ขอบ #33455f (**ห้ามถือตัวอักษร**) ·
// ขาว #ffffff (หมึกบนปุ่มหลัก) · พื้นเพจ #0d1017 (หมึกบนปุ่มเน้นฟ้าไซยาน)
// หมึกเนื้อความคือ #e6edf8 (= BRAND_TEXT) ซึ่ง **ไม่ประกาศในไฟล์นี้** การ์ด
// ContentBox ตั้งไว้ให้แล้วและย่อหน้าสืบทอดลงมา
// 🚨 **ห้ามใส่ตัวอักษรขาวบนพื้นถม #1fd8f0** (1.7:1) ปุ่มเน้นใช้หมึก #0d1017 เสมอ
// ส่วนปุ่มหลักใช้หมึกขาวบนไล่เฉด #1d4fd8 -> #143aa0 (6.6:1 -> 9.8:1) เท่านั้น
// ออราที่อนุญาต: rgba(31,216,240,α) · rgba(29,79,216,α) · rgba(143,217,236,α) ·
// rgba(11,182,212,α) · rgba(13,16,23,α) · rgba(0,0,0,α)
// ⚠️ รอบนี้ **ไม่มีทอง/เหลือง/ส้มเลยสักเฉด** (เลข 168 ในโลโก้เป็นวัตถุในภาพ ไม่ใช่
// สี UI และทองเป็นฮิวที่ผ่านรีโปนี้มาแล้วกว่า 20 เจ้า รวมถึงเจ้าที่ชื่อซ้ำกับรอบนี้)
// ไม่มีแดง ไม่มีชมพู ไม่มีม่วง ไม่มีน้ำตาล และ **ไม่มีแรมป์เทาเงิน** ไม่มีเขียว
// ยกเว้น **LINE green #00B900** บนปุ่ม LINE ซึ่งเป็นสีประจำแพลตฟอร์ม ห้ามเปลี่ยน
// ⚠️⚠️ **ฟ้า/ไซยานเคยนำมาแล้วหกแบรนด์ในรีโปนี้ และรอบก่อนหน้าทันทีก็ฟ้านำ** การเจอ
// ฟ้าในไฟล์จึงไม่พิสูจน์อะไรเลย ห้ามเทียบด้วยวงศ์สี ต้องเทียบ **ทีละค่า** กับ
// ตาราง brand-spec §2
//
// ลำดับปุ่มในไฟล์นี้สื่อด้วยพื้นถมสามขั้ว:
// · ปุ่มหลัก (สมัครสมาชิก) ไล่เฉด #1d4fd8 -> #143aa0 หมึก #ffffff
// · ปุ่มรอง (เข้าสู่ระบบ) ขอบ #1fd8f0 ตัวอักษร #1fd8f0 บนผิวจม #121722
// · ปุ่มลิงก์ภายในเป็นผิวจม #121722 ขอบ #33455f ตัวอักษร #1fd8f0
//   hover ยกขอบเป็นฟ้าไซยาน (ตรงกับ hover ของการ์ด ContentBox)
// · ชิปไอคอนของรายการใช้ฟ้าไซยานเป็น **เส้นขอบ** บนผิวยก #273449 ไม่ถือตัวอักษร
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง และไม่ใส่ mx-auto / max-w-* บน <p>
// เพราะการ์ดคุมความกว้างเองแล้ว — ที่ประกาศสีได้มีแค่ปุ่ม ชิปไอคอน และ <strong>
// แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรค
// ระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง (ลบแท็ก
// <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิม) และห้ามวาง <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังใน prop ที่เป็นข้อความ
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: ดรอปนี้ไม่มี article illustration เลย (banner2/
// banner3 เป็นอาร์ตเวิร์กของแบรนด์คนละราย เก่าทั้งคู่) ส่วน slide1/slide2 ถูกตรึง
// ไว้กับ index กับ /promotion และ banner1 / banner1-mobile / og.png เป็นของ glob
// ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า · slide3/slide4 เป็นโปสเตอร์ของอีกแบรนด์
// ห้าม import (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build
// จะแดง) — ไฟล์ยังอยู่บนดิสก์ ห้ามลบ
//
// Announcement รอบนี้หมุนมาเป็น AnnouncementCyber ทั้งเว็บ (brand-spec §3 —
// รอบก่อนใช้ Announcement5 จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์
// นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว จึงเรียกแบบ bare **ห้ามส่ง prop message**
// มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 156 อักขระ (ชื่อแบรนด์รอบนี้ 8 ตัวอักษร) เป็นประโยคเดียวที่บอกว่า
// หน้านี้มีอะไร แล้วหยุด
// (Google ตัดราว 155 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} รวมข้อมูลเกมสล็อตที่รองรับภาษาไทย การตรวจสอบลิขสิทธิ์ โปรโมชั่นคืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% การฝากถอน และช่องทางติดต่อแอดมิน 24ชม.`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} เว็บเกมสล็อตออนไลน์และข้อมูลที่หน้านี้รวบรวมไว้`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

// คลาสปุ่มสามขั้วของหน้านี้ ประกาศครั้งเดียวแล้วใช้ซ้ำ เพื่อไม่ให้สองปุ่มที่ทำ
// หน้าที่เดียวกันหลุดไปคนละเฉดตอนรีแบรนด์รอบหน้า
const ctaPrimary =
  "flex items-center justify-center rounded-lg border border-[#143aa0] bg-gradient-to-b from-[#1d4fd8] to-[#143aa0] px-8 py-3 font-black text-[#ffffff] shadow-[0_6px_18px_rgba(29,79,216,0.35)] transition-transform hover:scale-105";

const ctaSecondary =
  "flex items-center justify-center rounded-lg border-2 border-[#1fd8f0] bg-[#121722] px-8 py-3 font-bold text-[#1fd8f0] shadow-[0_4px_14px_rgba(0,0,0,0.35)] transition-all hover:scale-105 hover:bg-[#273449]";

const ctaQuiet =
  "flex items-center justify-center rounded-lg border border-[#33455f] bg-[#121722] px-8 py-3 font-bold text-[#1fd8f0] shadow-[0_4px_14px_rgba(0,0,0,0.3)] transition-all hover:scale-105 hover:border-[#1fd8f0] hover:shadow-[0_6px_18px_rgba(31,216,240,0.25)]";

const listChip = "mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#1fd8f0]/50 bg-[#273449] text-sm";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#1fd8f0]">{BRAND_NAME} นำเสนอเกมสล็อตออนไลน์ที่เน้นรูปแบบการใช้งานภาษาไทย มีเมนูสำหรับศึกษารายละเอียดเกม โปรโมชั่น และช่องทางฝากถอนในเว็บไซต์เดียว</strong>
        หน้านี้รวบรวมไว้ว่าเว็บไซต์ระบุอะไรไว้บ้าง เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดอ่านอะไรตรงไหน แล้วจึงค่อยไล่อ่านรายละเอียดของแต่ละหัวข้อเป็นรายข้อ
      </p>

      <p>
        สิ่งที่หน้านี้ทำได้คือชี้ว่าข้อมูลแต่ละชุดอยู่ตรงไหนและควรอ่านอะไรก่อน
        <strong class="text-[#1fd8f0]">ผู้ใช้งานสามารถตรวจสอบกติกาเกมและเงื่อนไขการทำรายการก่อนใช้บริการได้</strong>
        ซึ่งแต่ละหัวข้อวางเงื่อนไขของตัวเองไว้คนละชุด จึงควรเปิดอ่านทีละหัวข้อแทนการเทียบจากหัวข้ออื่น
      </p>

      <p>
        ส่วนข้อมูลเกี่ยวกับการรับเงินผ่านบัญชีบริษัทโดยตรงและการไม่ใช้บัญชีม้า
        <strong class="text-[#1fd8f0]">ควรตรวจสอบชื่อบัญชีปลายทางและข้อมูลนิติบุคคลจากหลักฐานที่เชื่อถือได้ เพื่อหลีกเลี่ยงความเสี่ยงจากบัญชีแอบอ้าง</strong>
        เนื้อหาในหน้านี้จึงเขียนไว้ประกอบการใช้งานเท่านั้น ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้บริการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ระบบเล่นง่าย รองรับภาษาไทย และการตรวจสอบสถานะลิขสิทธิ์ของเกม" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#1fd8f0]">{BRAND_NAME} นำเสนอข้อมูลเกมสล็อตที่รองรับการใช้งานภาษาไทย</strong>
        ช่วยให้ผู้ใช้งานศึกษาชื่อเมนู กติกาเกม และรายละเอียดฟีเจอร์ต่างๆ ได้สะดวกขึ้น รายการด้านล่างคือชุดข้อมูลที่ควรไล่อ่านให้ครบ เพราะเกมสล็อตแต่ละประเภทอาจมีรูปแบบการจ่ายรางวัลและระดับการเดิมพันแตกต่างกัน
      </p>

      <ul class="flex flex-col gap-4" aria-label="ข้อมูลที่ควรตรวจสอบก่อนเลือกเกมสล็อต">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🌐</span>
          <span>
            <strong class="text-[#1fd8f0]">ชื่อเมนูและกติกาเกมในภาษาไทย</strong> เป็นชุดแรกที่ควรอ่าน เพราะเป็นตัวบอกว่าผลของแต่ละรอบนับอย่างไร และเงื่อนไขไหนต้องเกิดขึ้นก่อนจึงจะมีผลรางวัล
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎰</span>
          <span>
            <strong class="text-[#1fd8f0]">รูปแบบการจ่ายรางวัลและฟีเจอร์ของแต่ละเกม</strong> ระบุไว้เป็นรายเกม จึงเป็นข้อมูลที่ตรงกว่าการสรุปรวมจากเกมอื่นที่เคยเปิดดูไว้ก่อนหน้า
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📊</span>
          <span>
            <strong class="text-[#1fd8f0]">ระดับการเดิมพันที่แต่ละเกมเปิดไว้</strong> กำหนดไม่เท่ากัน จึงไม่ควรเทียบค่าของเกมหนึ่งไปใช้กับอีกเกมหนึ่ง และควรดูเป็นรายเกมก่อนเลือก
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📜</span>
          <span>
            <strong class="text-[#1fd8f0]">ชื่อผู้พัฒนาเกม ประเทศที่จดทะเบียน และหลักฐานการอนุญาต</strong> คือสิ่งที่ควรตรวจสอบจากเจ้าของลิขสิทธิ์โดยตรง เมื่อพบคำกล่าวอ้างเรื่องลิขสิทธิ์แท้จากอเมริกา
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#1fd8f0]">การรองรับภาษาไทยไม่ได้เป็นหลักฐานยืนยันแหล่งที่มาหรือสถานะลิขสิทธิ์ของเกม</strong>
        สองเรื่องนี้จึงต้องตรวจแยกกัน และควรยึดหลักฐานที่ตรวจสอบได้มากกว่าข้อความที่แสดงอยู่บนหน้าโฆษณา
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/ทดลองเล่น" aria-label={`เปิดหน้าทดลองเล่นของ ${BRAND_NAME}`} class={ctaQuiet}>ไปหน้าทดลองเล่น</a>

        <a href="/ทางเข้า" aria-label={`เปิดหน้าทางเข้าของ ${BRAND_NAME}`} class={ctaQuiet}>ไปหน้าทางเข้า</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`โปรโมชั่นสมาชิก ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} นำเสนอข้อมูลโปรโมชั่นสำหรับสมาชิกที่สนใจตรวจสอบสิทธิพิเศษจากการใช้บริการ โดยมีรายการ
        <strong class="text-[#1fd8f0]">คืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8%</strong>
        ซึ่งแต่ละโปรโมชั่นอาจมีข้อกำหนดเกี่ยวกับประเภทเกม ยอดที่นำมาคำนวณ และรอบเวลารับเครดิตแตกต่างกัน
      </p>

      <p>
        รายการคืนยอดเสียระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขรายวัน
        <strong class="text-[#1fd8f0]">สมาชิกควรตรวจสอบว่าเกมสล็อตประเภทใดเข้าร่วมรายการ มีรอบสรุปยอดเวลาใด และต้องกดรับเครดิตด้วยตนเองหรือระบบดำเนินการให้อัตโนมัติ</strong>
        รวมถึงศึกษาข้อกำหนดการใช้เครดิตและการถอนเงินให้ครบถ้วน เพราะยอดเสียบางรายการอาจไม่เข้าเกณฑ์รับสิทธิ์ ทั้งนี้ การคืนเครดิตไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือทำให้มีโอกาสชนะมากขึ้น
      </p>

      <p>
        ส่วนรายการแนะนำเพื่อนระบุสิทธิ์ไว้สำหรับสมาชิกที่แนะนำผู้ใช้งานรายใหม่ โดยควรตรวจสอบวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และฐานยอดที่ใช้คำนวณโบนัสให้ชัดเจน
        <strong class="text-[#1fd8f0]">แม้จะระบุว่ากดรับได้ไม่จำกัด แต่ควรตรวจสอบจำนวนครั้งที่รับสิทธิ์ได้จริง รวมถึงรอบจ่ายเครดิตและเงื่อนไขการใช้โบนัสจากประกาศล่าสุดก่อนเข้าร่วม</strong>
        เพื่อป้องกันความเข้าใจคลาดเคลื่อนเกี่ยวกับจำนวนเครดิตที่มีสิทธิ์ได้รับ
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/promotion" aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`} class={ctaQuiet}>ดูภาพโปรโมชั่น</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="ฝากถอนเข้าบริษัทตรง ไม่ผ่านม้า และการตรวจชื่อบัญชีปลายทาง" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#1fd8f0]">{BRAND_NAME} ระบุช่องทางฝากถอนผ่านธนาคารและทรูมันนี่</strong>
        เพื่อให้สมาชิกตรวจสอบวิธีทำรายการตามบริการที่เปิดใช้งานจริง รายการด้านล่างคือสิ่งที่ควรเปิดอ่านก่อนทำรายการครั้งแรก และควรตรวจซ้ำทุกครั้งที่กลับเข้ามาใหม่
      </p>

      <ul class="flex flex-col gap-4" aria-label="สิ่งที่ควรตรวจสอบก่อนฝากถอน">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🏦</span>
          <span>
            <strong class="text-[#1fd8f0]">รายชื่อธนาคารที่รองรับและยอดขั้นต่ำ</strong> ควรดูจากบริการที่เว็บไซต์เปิดใช้งานอยู่จริงในขณะนั้น ไม่ใช่จากข้อความที่สรุปไว้สั้นๆ เพียงบรรทัดเดียว
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🔎</span>
          <span>
            <strong class="text-[#1fd8f0]">ชื่อบัญชีปลายทางและข้อมูลนิติบุคคล</strong> ควรตรงกับข้อมูลผู้ให้บริการที่ยืนยันได้ เพราะนี่คือจุดที่แยกการรับเงินเข้าบริษัทตรงออกจากบัญชีแอบอ้าง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>⏱️</span>
          <span>
            <strong class="text-[#1fd8f0]">ระยะเวลาดำเนินการและข้อกำหนดการถอนเงิน</strong> ควรศึกษาให้ครบถ้วนก่อนทำรายการ เพราะแต่ละช่องทางอาจกำหนดเงื่อนไขไว้ไม่เหมือนกัน
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#1fd8f0]">หากพบชื่อบัญชีไม่ตรงกับข้อมูลทางการหรือมีการแจ้งเปลี่ยนบัญชีอย่างผิดปกติ ควรหยุดทำรายการและติดต่อธนาคารหรือผู้ให้บริการชำระเงินเพื่อตรวจสอบก่อนโอนเงิน</strong>
        ขั้นตอนนี้ใช้เวลาไม่นาน แต่เป็นจุดที่ป้องกันความเสียหายได้มากที่สุดเมื่อเทียบกับการโอนไปก่อนแล้วค่อยตามแก้ทีหลัง
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/register" aria-label={`สมัครสมาชิก ${BRAND_NAME}`} class={ctaPrimary}>สมัครสมาชิก</a>

        <a href="/login" aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`} class={ctaSecondary}>เข้าสู่ระบบ</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`ช่องทางติดต่อแอดมิน ${BRAND_NAME} ตลอด 24ชม.`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} ระบุช่องทางติดต่อเจ้าหน้าที่สำหรับผู้ใช้งานที่ต้องการสอบถามเกี่ยวกับระบบภาษาไทย การเข้าสู่ระบบ รายการฝากถอน และรายละเอียดโปรโมชั่น
        <strong class="text-[#1fd8f0]">โดยควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง</strong>
        หากพบปัญหาเกี่ยวกับธุรกรรม ควรเก็บหมายเลขรายการและหลักฐานที่เกี่ยวข้องไว้สำหรับตรวจสอบ พร้อมแจ้งรายละเอียดปัญหาให้ชัดเจน โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP
      </p>

      <p>
        <strong class="text-[#1fd8f0]">ทั้งนี้ ควรตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุดอีกครั้ง</strong>
        เพราะช่วงเวลาที่เจ้าหน้าที่รับเรื่องอาจปรับเปลี่ยนได้ตามที่ผู้ให้บริการกำหนด และระยะเวลาตอบกลับของแต่ละช่องทางอาจไม่เท่ากัน
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/line"
          aria-label={`ติดต่อเจ้าหน้าที่ ${BRAND_NAME} ผ่าน Line Official`}
          class="flex items-center justify-center gap-2 rounded-lg border border-[#00B900] bg-[#00B900] px-8 py-3 font-black text-white shadow-[0_0_15px_rgba(0,185,0,0.35)] transition-transform hover:scale-105">
          <span aria-hidden="true">💬</span>
          ติดต่อผ่าน Line Official
        </a>

        <a href="/contact-us" aria-label={`ดูช่องทางติดต่อทีมงาน ${BRAND_NAME} ทั้งหมด`} class={ctaQuiet}>ช่องทางติดต่อทั้งหมด</a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
