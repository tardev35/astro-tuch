---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login, /register)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อของ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึงเขียนขึ้นใหม่
// บนข้อเท็จจริงของ PGW44 เท่านั้น
//
// รอบนี้ (ดรอป 2026-09-27) คือ PGW44 **เว็บที่อัปเดตค่ายสล็อตย่อย ครบทุกแนวเกม**
// จุดขายของบรีฟคือรวบรวมค่ายสล็อตย่อยและเกมหลายแนวไว้ให้เลือกจากระบบเดียว
// คอปปี้รอบก่อนเป็นของ PKG44 ซึ่งขาย "เกมปั่นสล็อตAPIแท้" "รับอนุญาตลิขสิทธิ์จาก
// เจ้าของ" และ "รูปแบบการเชื่อมต่อ API" — บรีฟของ PGW44 **ไม่ได้ระบุสักคำ**
// ทั้งหน้าจึงถูกเขียนใหม่ทั้งบท ไม่ใช่แทนชื่อแบรนด์ทับประโยคเดิม หัวข้อ
// "รูปแบบการเชื่อมต่อ API และข้อมูลลิขสิทธิ์จากเจ้าของเกม" ของรอบก่อนถูกถอดออก
// แทนด้วยหัวข้อเรื่องค่ายสล็อตย่อย/แนวเกม เมนูหมวดหมู่ และการเข้าเล่นได้ทั้งวัน
// ซึ่งเป็นสิ่งที่บรีฟรอบนี้พูดถึงจริง
//
// ข้อเท็จจริงทุกบรรทัดมาจากบรีฟรอบนี้เท่านั้น (brand-spec §4): ค่ายสล็อตย่อยและเกม
// หลายแนวในระบบเดียว · เกมคลาสสิก เกมโบนัส เกมธีมใหม่ และสล็อตที่อัปเดตตามช่วงเวลา ·
// เมนูจัดหมวดหมู่ชัดเจน · รองรับมือถือและคอมพิวเตอร์ · ค้นหาเกมได้โดยไม่ต้องเปลี่ยน
// หลายเว็บไซต์ · เข้าดูและเลือกเกมได้ตลอดทั้งวันตามรายการที่ระบบเปิดให้บริการ ·
// แต่ละเกมมีระดับเดิมพันและรูปแบบการเล่นต่างกัน ตรวจสอบจากหน้าเกมโดยตรง ·
// ข่าวสาร เกมใหม่ และโปรโมชั่นที่อัปเดตตามช่วงเวลา · โบนัสแนะนำเพื่อน 0.8% ·
// โบนัสคืนยอดเสีย 0.3% · ยอดที่เข้าเกณฑ์ / ขั้นตอนรับสิทธิ์ / รอบคำนวณ / เงื่อนไข ·
// บัญชีสมาชิก · สมัครเองผ่านหน้าเว็บ 3 ขั้นตอน · ติดต่อเจ้าหน้าที่ผ่านช่องทางไลน์
// ได้ตลอด 24 ชั่วโมง · ทีมงานช่วยเรื่องค่ายสล็อตและระบบสมาชิก
// — ห้ามอ้าง ชื่อค่าย/สตูดิโอเจาะจง ชื่อเกมเจาะจง ค่า RTP เลขใบอนุญาต ปีที่ก่อตั้ง
// เลขทะเบียนบริษัท จำนวนสมาชิก ชื่อธนาคาร ฝากถอนออโต้ เครดิตฟรี บาคาร่า คาสิโนสด
// เกมโต๊ะ รูเล็ต ไฮโล หวย บอล/กีฬา "ไม่มีประวัติโกง" การันตีว่าจะชนะ หรือการเชื่อมต่อ
// API/ลิขสิทธิ์ (คำของแบรนด์ก่อนหน้า) เพราะบรีฟรอบนี้ไม่ได้ระบุไว้
//
// ศัพท์ช่องทางติดต่อ: บรีฟรอบนี้ระบุ "ติดต่อเจ้าหน้าที่ผ่านช่องทางไลน์ได้ตลอด
// 24 ชั่วโมง" ไว้ตรงๆ (H2 ที่ 7) ต่างจากรอบก่อน — เนื้อความจึงเขียนคำว่าไลน์ได้
//
// Announcement รอบนี้หมุนจาก AnnouncementPremium มาเป็น Announcement2 ทั้งเว็บ —
// default message ของไฟล์นั้นเป็นคอปปี้ของ PGW44 แล้ว จึงเรียกแบบ bare เหมือน
// index.astro ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ PGW44 เป็น **ทองนำ + เขียวตาม บนพื้นดำอมเขียว** ตามโลโก้ (P ดำขอบทอง /
// G ทอง / W เขียว / 44 ไล่ทองไปเขียว) ตารางแมปอยู่ที่ brand-spec §2:
// ผิวการ์ด #0b1408 · ผิวแผง/ปุ่มรอง #101a0b · ทองแบรนด์ #fde90e · ทองสว่าง #fff89a ·
// ทองกลาง #f5c518 · ทองลึก #a86f02 · เขียวแบรนด์ #35d413 · เขียวสว่าง #5df53a ·
// เขียวลึก #0c6d10 · ขอบ #1f5a16 · เนื้อความ #e9f0dd (BRAND_TEXT) ·
// เน้นใน strong #fbffe8 · ตัวอักษรบนพื้นทอง #10160a
// ปุ่มหลักไล่ทอง → ทองกลาง → เขียว ตามลำดับตัวอักษรในโลโก้ ส่วนปุ่มรองใช้ขอบเขียว
// ชุดทอง/เงินโครเมียมของ PKG44 (#fdd32a #ffe27a #c8920a #c2c8d0 #efe6d2 #fff8e1
// #12100a #2a2110 #15110a) ถูกแทนครบทุกจุดแล้ว
// ส่วน #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ตามเดิม
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลางที่ไม่หมุนตามรอบรีแบรนด์ และรอบนี้
// orchestrator เป็นคนรีธีม) — สีเนื้อความจึงตรงกับที่การ์ดกำหนดไว้อยู่แล้ว
//
// ไม่มีลิงก์ /ตรวจหวย หรือ /แนวทาง ในหน้านี้: PGW44 เป็นแบรนด์สล็อต ไม่ใช่เว็บหวย
// สองหน้านั้นไม่มี route รอบนี้ href ที่ชี้ route ซึ่งไม่มีใน dist/ จะทำให้ verify-build แดง
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index และ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า
// และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กค้างหรือโลโก้ซ้ำ ห้าม import
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 158
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "เกี่ยวกับ PGW44 เว็บที่รวมค่ายสล็อตย่อยและเกมหลายแนวไว้ในระบบเดียว เมนูจัดหมวดหมู่ชัดเจน รองรับมือถือและคอมพิวเตอร์ มีโบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%";

const pageTitle = "เกี่ยวกับเรา PGW44 อัปเดตค่ายสล็อตย่อย ครบทุกแนวเกมในระบบเดียว";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e9f0dd]">
        <strong class="text-[#fbffe8]">PGW44</strong> คือเว็บที่<strong class="text-[#fbffe8]">รวบรวมค่ายสล็อตย่อยและเกมหลายแนวไว้ให้เลือกจากระบบเดียว</strong>
        ทั้งเกมคลาสสิก เกมโบนัส เกมธีมใหม่ และสล็อตที่อัปเดตตามช่วงเวลา สมาชิกจึงค้นหาเกมที่สนใจได้สะดวกโดยไม่ต้องเปลี่ยนไปเปิดหลายเว็บไซต์ และใช้งานได้ทั้งบนมือถือและคอมพิวเตอร์
      </p>

      <p class="text-left text-base leading-relaxed text-[#e9f0dd]">
        หน้านี้รวบรวมไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่รายการเกมที่จัดไว้ในเมนูหมวดหมู่ ช่วงเวลาที่เข้าดูและเลือกเกมได้ ไปจนถึงข่าวสารและโปรโมชั่นที่ตรวจสอบเงื่อนไขได้จากหน้าโปรโมชั่น
        ขั้นตอนการสมัครสมาชิก และช่องทางสอบถามเจ้าหน้าที่เมื่อไม่แน่ใจในขั้นตอนใด
      </p>

      <p class="text-left text-base leading-relaxed text-[#e9f0dd]">
        <strong class="text-[#fbffe8]">รายการเกมและเงื่อนไขของโปรโมชั่นอาจเปลี่ยนแปลงตามช่วงเวลา</strong>
        รายละเอียดทั้งหมดจึงยึดตามข้อมูลที่เว็บไซต์แสดงไว้จริงในขณะนั้นเป็นหลัก และควรตรวจสอบรายการล่าสุดจากช่องทางอย่างเป็นทางการของเว็บไซต์ก่อนทำรายการทุกครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="PGW44 อัปเดตค่ายสล็อตย่อย ครบทุกแนวเกมจากระบบเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e9f0dd]">
        สิ่งที่เว็บไซต์ระบุไว้เป็นตัวตนของ PGW44 คือ <strong class="text-[#fbffe8]">การรวบรวมค่ายสล็อตย่อยและเกมหลายแนวมาไว้ในระบบเดียว</strong>
        สมาชิกจึงเลือกเกมได้หลายรูปแบบโดยไม่ต้องสลับไปเปิดหลายเว็บไซต์ ทั้งเกมคลาสสิก เกมโบนัส เกมธีมใหม่ และสล็อตที่อัปเดตตามช่วงเวลาที่ระบบกำหนด
      </p>

      <p class="text-left text-base leading-relaxed text-[#e9f0dd]">
        เพราะรายการถูกมัดรวมมาให้ครบทุกแนวเกมไว้ที่เดียว <strong class="text-[#fbffe8]">การไล่เทียบว่าแนวไหนตรงกับที่ตัวเองสนใจจึงทำได้จบในระบบเดิม</strong>
        โดยรายการที่แสดงยึดตามสิ่งที่ระบบเปิดให้บริการอยู่ในขณะนั้น และเปลี่ยนแปลงได้ตามช่วงเวลาที่เว็บไซต์อัปเดต
      </p>
    </div>
  </ContentBox>

  <ContentBox title="เมนูจัดหมวดหมู่ชัดเจน ใช้งานได้ทั้งมือถือและคอมพิวเตอร์" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e9f0dd]">
        รายการทั้งหมดถูกจัดไว้ใน<strong class="text-[#fbffe8]">เมนูที่จัดหมวดหมู่ชัดเจน</strong>
        สมาชิกเห็นภาพรวมของค่ายสล็อตย่อยและแนวเกมที่เปิดให้เลือกได้ก่อน แล้วเปิดเข้าไปดูรายละเอียดของเกมที่สนใจต่อได้ทันที จึงค้นหาเกมที่ต้องการได้สะดวกกว่าการไล่เปิดทีละเว็บไซต์
      </p>

      <p class="text-left text-base leading-relaxed text-[#e9f0dd]">
        ตัวเว็บไซต์<strong class="text-[#fbffe8]">รองรับการใช้งานผ่านทั้งมือถือและคอมพิวเตอร์</strong>
        การเปิดดูรายการเกมและเลือกเกมจึงทำได้จากเครื่องที่ถนัด และสลับอุปกรณ์ระหว่างวันได้โดยยังเห็นเมนูหมวดหมู่ชุดเดียวกัน
      </p>
    </div>
  </ContentBox>

  <ContentBox title="เข้าเล่นเกม PGW44 ได้ทั้งวัน ตรวจรายละเอียดจากหน้าเกมโดยตรง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e9f0dd]">
        สมาชิก<strong class="text-[#fbffe8]">เข้าดูและเลือกเกมได้ตลอดทั้งวันตามรายการที่ระบบเปิดให้บริการ</strong>
        จึงไม่ต้องรอรอบเวลาใดเป็นพิเศษก่อนเปิดเข้าไปดูว่าตอนนี้มีค่ายและแนวเกมอะไรอยู่ในเมนู
      </p>

      <p class="text-left text-base leading-relaxed text-[#e9f0dd]">
        สิ่งที่ควรทำก่อนเริ่มใช้งานคือ <strong class="text-[#fbffe8]">แต่ละเกมมีระดับเดิมพันและรูปแบบการเล่นแตกต่างกัน สามารถตรวจสอบรายละเอียดของเกมนั้นได้จากหน้าเกมโดยตรง</strong>
        การอ่านให้จบก่อนกดเริ่มช่วยให้เลือกเกมและวงเงินที่เหมาะกับตัวเองได้ตรงกว่า
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ข่าวสาร เกมใหม่ และโปรโมชั่น PGW44 แนะนำเพื่อน 0.8% คืนยอดเสีย 0.3%" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e9f0dd]">
        สมาชิก PGW44 <strong class="text-[#fbffe8]">ติดตามข่าวสาร เกมใหม่ และโปรโมชั่นที่อัปเดตตามช่วงเวลาได้จากหน้าเว็บไซต์</strong>
        โดยโปรโมชั่นหลักตามข้อมูลที่กำหนดมีโบนัสแนะนำเพื่อน 0.8% ตามเงื่อนไขของโปรโมชั่น และโบนัสคืนยอดเสีย 0.3% ตามยอดและเงื่อนไขที่ระบบกำหนด
      </p>

      <p class="text-left text-base leading-relaxed text-[#e9f0dd]">
        ทั้งสองรายการมี<strong class="text-[#fbffe8]">รายละเอียดยอดที่เข้าเกณฑ์ ขั้นตอนรับสิทธิ์ และรอบคำนวณให้ตรวจสอบ</strong>
        สมาชิกดูรายละเอียดของตัวเองได้ผ่านบัญชีสมาชิก และควรอ่านเงื่อนไขของรายการที่สนใจให้ครบก่อนกดรับสิทธิ์ทุกครั้ง เพราะแต่ละรายการมีรอบและเงื่อนไขไม่เหมือนกัน
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/promotion"
          aria-label="ดูภาพโปรโมชั่นทั้งหมดของ PGW44"
          class="flex items-center justify-center rounded-lg border border-[#fde90e] bg-[#101a0b] px-8 py-3 font-bold text-[#e9f0dd] transition-all hover:scale-105 hover:border-[#5df53a] hover:bg-[#0b1408] hover:text-[#fbffe8]">
          ดูโปรโมชั่นทั้งหมด
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="สมัครเล่นสล็อต PGW44 ด้วยตัวเองแค่ 3 ขั้นตอน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e9f0dd]">
