---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

// NEXT55 เป็นคาสิโนออนไลน์เว็บตรงครบวงจร ไม่ใช่เว็บหวยเฉพาะทาง — หวยเป็นหนึ่งใน
// ห้าหมวดเกม จึงไม่มีลิงก์ไป /ตรวจหวย หรือ /แนวทาง ในหน้านี้ (สองหน้านั้นปิดอยู่)
// เนื้อหาทั้งหน้าอ้างอิงบรีฟของแบรนด์นี้เท่านั้น: เว็บตรง 100% ไม่ผ่านเอเย่นต์ ·
// One-Stop Service ครบห้าหมวด (บาคาร่าและคาสิโนสด Full HD · สล็อตลิขสิทธิ์แท้ ·
// เกมยิงปลา · หวยรัฐบาล ลาว ฮานอย จ่ายเต็มไม่มีเลขอั้น · แทงบอลทุกลีก ค่าน้ำดี) ·
// เดิมพันเริ่มต้นเพียง 1 บาท · ไม่มีขั้นต่ำฝาก-ถอน · ฝากถอนออโต้ภายใน 5 วินาที
// รองรับทุกธนาคารและ TrueMoney Wallet · แนะนำเพื่อน 0.8% ถอนเป็นเงินสดได้ ·
// คืนยอดเสีย 0.3% ทุกยอดการเล่น · สมัคร 3 ขั้นตอน (OTP · ผูกบัญชี/วอลเลท · ตั้งรหัสผ่าน) ·
// แอดมิน Line Official ตลอด 24 ชั่วโมง · รองรับ iOS/Android/แท็บเล็ต/พีซี ผ่านเบราว์เซอร์
// โดยไม่ต้องโหลดแอป
// — ไม่มีการอ้างเลขใบอนุญาต ปีที่ก่อตั้ง จำนวนสมาชิก การันตีผลกำไร ตัวเลข RTP
// หรือชื่อค่ายเกมรายใด เพราะบรีฟไม่ได้ระบุไว้
//
// Announcement รอบนี้หมุนมาใช้ Announcement3 ทั้งเว็บ — default message ของไฟล์นั้น
// เป็นคอปปี้ของ NEXT55 อยู่แล้ว จึงเรียกแบบ bare ไม่ต้องส่ง prop
//
// พาเลตต์ NEXT55: พื้นการ์ดกราไฟต์ #17181c · แดงโลโก้ #cd1437 นำโครงสร้าง
// (ขอบ ไอคอน เงา) · แดงสว่าง #f0435f สำหรับ hover และข้อควรระวัง ·
// ชมพูอ่อน #ffb3bf ใช้กับ <strong> ในเนื้อความ · เนื้อความ #d5dae2
// แบรนด์นี้ไม่มีสีน้ำเงิน ฟ้า หรือทองเลย
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 151
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "เกี่ยวกับ NEXT55 คาสิโนออนไลน์เว็บตรง 100% ไม่ผ่านเอเย่นต์ รวมบาคาร่า สล็อต ยิงปลา หวย บอล เริ่มต้น 1 บาท ฝากถอนออโต้ไม่มีขั้นต่ำ แอดมินดูแล 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ NEXT55 คาสิโนออนไลน์เว็บตรงครบวงจร ไม่ผ่านเอเย่นต์",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา NEXT55 คาสิโนออนไลน์เว็บตรง เริ่มต้น 1 บาท" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ NEXT55 คาสิโนออนไลน์เว็บตรงครบวงจร ไม่ผ่านเอเย่นต์" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d5dae2]">
        <strong class="text-[#ffb3bf]">NEXT55</strong> คือ<strong class="text-[#ffb3bf]">คาสิโนออนไลน์เว็บตรงครบวงจร</strong> ที่ให้บริการแพลตฟอร์มเดิมพันด้วยตัวเอง
        <strong class="text-[#f0435f]">ไม่ผ่านเอเย่นต์หรือตัวแทนใดๆ</strong> ทุกอย่างจึงอยู่ในบัญชีเดียว ตั้งแต่สมัครสมาชิก เข้าสู่ระบบ ฝากถอนเครดิต กดรับโปรโมชั่น ไปจนถึงการเข้าเล่นทุกหมวดเกม โดยไม่ต้องสลับไปมาระหว่างหลายระบบ
      </p>

      <p class="text-left text-base leading-relaxed text-[#d5dae2]">
        เรามุ่งเน้นมาตรฐานความปลอดภัยระดับสากลและความโปร่งใสในทุกยอดบิล ควบคู่กับเกมลิขสิทธิ์แท้และระบบที่เสถียร หน้านี้รวบรวมไว้ว่าเว็บไซต์เปิดให้ทำอะไรได้บ้าง ตั้งแต่หมวดเกมที่ให้บริการ
        โปรโมชั่นที่กดรับสิทธิ์ได้เอง ขั้นตอนสมัครสมาชิกบนมือถือ ไปจนถึงช่องทางติดต่อทีมงาน
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="NEXT55 รวมเกมคาสิโน บาคาร่า สล็อต ยิงปลา หวย บอล เริ่มต้น 1 บาท" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d5dae2]">
        ที่ NEXT55 เราตอบโจทย์ทุกไลฟ์สไตล์การเดิมพันด้วยการรวบรวมเกมยอดฮิตจากทุกค่ายดังทั่วโลกมาไว้ในเว็บเดียว <strong class="text-[#ffb3bf]">(One-Stop Service)</strong> และเปิดโอกาสให้ทุกคนเข้าถึงความสนุกได้ด้วย
        <strong class="text-[#f0435f]">เงินทุนเริ่มต้นเพียง 1 บาท</strong>
        โดยช่วงเดิมพันต่ำสุด-สูงสุดของแต่ละเกมกำหนดไว้ไม่เท่ากัน ให้ยึดค่าที่ระบบแสดงในตัวเกมเป็นหลัก
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#d5dae2]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f0435f]">🃏</span>
          <span><strong class="text-[#ffb3bf]">บาคาร่าและคาสิโนสด</strong> ถ่ายทอดสดจากคาสิโนชั้นนำ ภาพคมชัดระดับ Full HD สัมผัสบรรยากาศสมจริงเหมือนนั่งอยู่ในคาสิโนวีไอพี</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f0435f]">🎰</span>
          <span><strong class="text-[#ffb3bf]">สล็อตออนไลน์</strong> รวบรวมค่ายเกมสล็อตลิขสิทธิ์แท้ ฟีเจอร์แน่น ภาพสวยงามตระการตา และเลือกวงเงินต่อสปินได้เอง</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f0435f]">🐟</span>
          <span><strong class="text-[#ffb3bf]">เกมยิงปลา</strong> เล่นง่าย ตายไว กราฟิกสวยงาม เลือกระดับกระสุนและโต๊ะที่เหมาะกับงบของตัวเองได้</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f0435f]">🎫</span>
          <span><strong class="text-[#ffb3bf]">หวยออนไลน์</strong> รับแทงหวยทุกประเภท ทั้งหวยรัฐบาล หวยลาว และหวยฮานอย จ่ายหนัก จ่ายเต็ม ไม่มีเลขอั้น</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f0435f]">⚽</span>
          <span><strong class="text-[#ffb3bf]">แทงบอลและกีฬา</strong> ค่าน้ำดีที่สุด เปิดรับเดิมพันทุกลีกดังทั่วโลก พร้อมรูปแบบการแทงที่หลากหลาย</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#d5dae2]">
        <strong class="text-[#f0435f]">รายชื่อเกมและตารางการแข่งขันที่เปิดรับเดิมพันเปลี่ยนแปลงได้ตามรอบ จึงควรตรวจสอบรายการล่าสุดและอัตราจ่ายจากหน้าเลือกเกมในเว็บก่อนยืนยันทุกครั้ง</strong>
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="โปรโมชั่น NEXT55 จัดเต็มทุกยูส แนะนำเพื่อน 0.8% คืนยอดเสีย 0.3%" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d5dae2]">
        เราพร้อมคืนกำไรและมอบความคุ้มค่าสูงสุดให้กับสมาชิก NEXT55 ด้วยโปรโมชั่นสุดพิเศษที่ <strong class="text-[#ffb3bf]">แจกหนักให้ทุกยูสเซอร์อย่างเท่าเทียม</strong>
        ไม่ว่าจะเป็นสมาชิกใหม่หรือสมาชิกเก่า ก็กดรับสิทธิประโยชน์ได้ <strong class="text-[#f0435f]">ทุกวัน ไม่มีกั๊ก</strong>
      </p>

      <p class="text-left text-base leading-relaxed text-[#d5dae2]">
        <strong class="text-[#f0435f]">โปรโมชั่นแนะนำเพื่อน 0.8%</strong> สร้างรายได้เสริมแบบง่ายๆ เพียงนำลิงก์ส่วนตัวของคุณไปแชร์ให้เพื่อนสมัครและเข้าเล่น คุณจะได้รับค่าคอมมิชชั่นสูงถึง 0.8% จากทุกยอดการเล่นของเพื่อนทันที
        เป็นระบบ Passive Income ที่ยิ่งชวนมาก ยิ่งได้มาก และถอนเป็นเงินสดได้ตลอดเวลา
      </p>

      <p class="text-left text-base leading-relaxed text-[#d5dae2]">
        <strong class="text-[#f0435f]">โปรโมชั่นคืนยอดเสีย 0.3%</strong> ทุกการเดิมพันมีจังหวะของมัน หากวันไหนมือไม่ขึ้น เรามีระบบเซฟตี้คอยดูแลด้วยการคืนยอดเสีย 0.3% ในทุกยอดการเล่น เพื่อให้คุณมีเครดิตเงินทุนสำรองไว้ต่อยอดในรอบถัดไป
        <strong class="text-[#f0435f]">โดยก่อนกดรับควรอ่านรอบการคำนวณและเงื่อนไขของโปรโมชั่นล่าสุดให้ครบถ้วนทุกครั้ง</strong>
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="สมัคร NEXT55 ด้วยตัวเอง 3 ขั้นตอน ฝากถอนออโต้ไม่มีขั้นต่ำ" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d5dae2]">
        เริ่มต้นเปิดประสบการณ์การเดิมพันได้ง่ายๆ ผ่าน<strong class="text-[#ffb3bf]">ระบบสมัครสมาชิกอัตโนมัติ (Auto)</strong>ที่ออกแบบมาให้ใช้งานบนโทรศัพท์มือถือได้อย่างสมบูรณ์แบบ รวดเร็ว ปลอดภัย
        ใช้เวลาไม่ถึง 1 นาที เพียงทำตาม 3 ขั้นตอนดังนี้
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#d5dae2]">
        <li class="flex gap-3">
          <span class="font-bold text-[#f0435f]">1.</span>
          <span><strong class="text-[#ffb3bf]">กรอกเบอร์โทรศัพท์</strong> ระบุเบอร์มือถือของคุณเพื่อรับรหัส OTP สำหรับยืนยันตัวตนและรักษาความปลอดภัยของบัญชี</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#f0435f]">2.</span>
          <span>
            <strong class="text-[#ffb3bf]">ผูกบัญชีธนาคารหรือวอลเลท</strong> เลือกธนาคารหรือ TrueMoney Wallet พร้อมกรอกเลขบัญชี โดยชื่อ-นามสกุลต้องตรงกับข้อมูลที่ใช้สมัคร เพื่อความปลอดภัยในการฝาก-ถอน
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#f0435f]">3.</span>
          <span><strong class="text-[#ffb3bf]">ตั้งรหัสผ่าน</strong> กำหนด Username และ Password ของคุณ ล็อคอินเข้าสู่ระบบ ฝากเงินแบบไม่มีขั้นต่ำ ทุน 1 บาทก็เริ่มเล่นได้ทันที</span>
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#d5dae2]">
        หลังเปิดบัญชีแล้วสามารถทำรายการต่อได้ด้วยตัวเองทั้งหมด ระบบฝาก-ถอนเงินอัตโนมัติทำรายการเสร็จสิ้น
        <strong class="text-[#f0435f]">ภายใน 5 วินาที</strong> ไม่มีขั้นต่ำทั้งฝากและถอน รองรับทุกธนาคารชั้นนำรวมถึง TrueMoney Wallet และทำรายการได้เองตลอด 24 ชั่วโมง ส่วนอินเทอร์เฟซพัฒนามาเพื่อรองรับทุกอุปกรณ์
        ทั้งโทรศัพท์มือถือระบบ iOS และ Android แท็บเล็ต หรือคอมพิวเตอร์พีซี ผ่านเว็บเบราว์เซอร์โดยไม่ต้องดาวน์โหลดแอปพลิเคชัน
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ติดต่อแอดมิน NEXT55 ผ่าน Line Official ตลอด 24 ชั่วโมง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d5dae2]">
        <strong class="text-[#ffb3bf]">เราใส่ใจในทุกรายละเอียดการให้บริการ</strong> NEXT55 มีทีมงานแอดมินคุณภาพที่ผ่านการอบรมมาเป็นอย่างดี พร้อมสแตนด์บายดูแลสมาชิกทุกท่านผ่าน <strong
          class="text-[#f0435f]">
          ช่องทาง Line Official ตลอด 24 ชั่วโมง
        </strong>
        ไม่ว่าจะติดปัญหาเรื่องการใช้งาน สอบถามข้อมูลโปรโมชั่น หรือต้องการความช่วยเหลือเรื่องการฝาก-ถอน ทีมงานของเราพร้อมตอบกลับอย่างรวดเร็ว สุภาพ และคอยซัพพอร์ตคุณในทุกสถานการณ์
      </p>

      <p class="text-left text-base leading-relaxed text-[#d5dae2]">
        เวลาแจ้งปัญหา ควรระบุเวลา จำนวนเงิน และข้อมูลรายการที่เกี่ยวข้องให้ครบ เพื่อให้เจ้าหน้าที่ตรวจสอบได้ตรงจุด
        <strong class="text-[#f0435f]">และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่นระหว่างการติดต่อเจ้าหน้าที่ไม่ว่ากรณีใด</strong>
      </p>

      <p class="text-left text-base leading-relaxed text-[#d5dae2]">
        <strong class="text-[#f0435f]">การเดิมพันมีความเสี่ยงและผลของแต่ละรอบไม่แน่นอน ไม่มีเกมใดรับประกันผลล่วงหน้า</strong> สมาชิกจึงควรกำหนดงบประมาณก่อนเริ่มเล่นทุกครั้ง
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก NEXT55"
          class="flex items-center justify-center rounded-lg border border-[#cd1437]/70 bg-gradient-to-r from-[#f0435f] via-[#cd1437] to-[#7a0a20] px-8 py-3 font-black text-[#e7eaef] shadow-[0_0_15px_rgba(205,20,55,0.38)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ NEXT55"
