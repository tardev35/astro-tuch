---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxCyberCut.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

// TTN69 เป็นเว็บ "สล็อตออโต้เกม" — รวมเกมสล็อตจากหลายแบรนด์ดังไว้ในบัญชีเดียว ระบบออโต้
// เนื้อหาทั้งหน้าเขียนตามบรีฟของแบรนด์นี้เท่านั้น: หลายแบรนด์เกมในบัญชีเดียว · ขั้นต่ำ 1 บาท
// ทุกค่าย (พร้อมคำเตือนว่ายอดจริงต่างกันตามค่าย) · รองรับทุกธนาคารและวอลเลท · โปรแนะนำเพื่อน
// โบนัส 0.8% · สมัครเองได้ 3 ขั้นตอน · แอดมิน LINE OFFICIAL ตลอด 24 ชั่วโมง
// — บรีฟรอบนี้ไม่มี "คืนยอดเสีย 0.3%" และไม่มีข้ออ้าง "ไม่ผ่านเว็บตัวแทน" จึงไม่เขียนถึงทั้งคู่
// — ไม่มีการอ้างใบอนุญาต การจดทะเบียนบริษัท ปีที่ก่อตั้ง จำนวนสมาชิก การันตีผลกำไร
// หรือชื่อค่ายเกมรายใดที่บรีฟไม่ได้ระบุ
//
// Announcement หมุนมาใช้ AnnouncementPremium ตัวเดียวกับทั้งเว็บ — default message ของไฟล์นั้น
// เป็นคอปปี้ของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ไม่ต้องส่ง prop
//
// โลโก้ TTN69 เป็นทิวเขาสีขาวเหนือตัวอักษร TTN สีขาวโครเมียมบนแถบเขียวมรกต เงินโครเมียม
// #e4ece7 จึงเป็น accent รองจริงของหน้านี้ คู่กับเขียวมรกต #02b961 ที่เป็นสีหลัก
// คำเตือนทุกจุดใช้สีเหลืองอำพัน #f5b93c โดยตั้งใจ — คำเตือนที่ทาสีแบรนด์จะไม่อ่านเป็นคำเตือน
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 158
const pageDescription =
  "เกี่ยวกับ TTN69 เว็บสล็อตออโต้เกมที่รวมเกมจากหลายแบรนด์ดังไว้ในบัญชีเดียว รองรับทุกธนาคารและวอลเลท พร้อมโปรแนะนำเพื่อน 0.8% และแอดมิน LINE ดูแลตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ TTN69 สล็อตออโต้เกม รวมแบรนด์ดังไว้ในบัญชีเดียว",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา TTN69 สล็อตออโต้เกม รวมแบรนด์ดัง ขั้นต่ำ1บาท" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ TTN69 สล็อตออโต้เกม รวมแบรนด์ดังไว้ในบัญชีเดียว" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d5e6da]">
        <strong class="text-[#f1faf4]">TTN69</strong> ให้บริการ<strong class="text-[#f1faf4]">เกมสล็อตออนไลน์ผ่านระบบออโต้</strong>
        โดยรวมเกมจากหลายแบรนด์ไว้ให้เลือกผ่านบัญชีเดียว รองรับการใช้งานทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์
        หน้าเว็บไซต์รวมส่วนเลือกเกม ฝากถอน ตรวจสอบโปรโมชั่น และจัดการเครดิตไว้ที่เดียว พร้อมช่องทางธนาคารและวอลเลทตามที่ระบบเปิดรองรับ
      </p>

      <p class="text-left text-base leading-relaxed text-[#d5e6da]">
        นอกจากหมวดเกมสล็อตแล้ว ยังมี<strong class="text-[#e4ece7]">โปรโมชั่นแนะนำเพื่อน รับโบนัส 0.8% ตามเงื่อนไข</strong>
        รวมถึงแอดมินคอยดูแลและช่วยตรวจสอบปัญหาการใช้งานผ่าน LINE OFFICIAL ตลอด 24 ชั่วโมง
        สมาชิกจึงตรวจสอบสิทธิ์ เงื่อนไข และสถานะรายการของตนเองได้จากบัญชีเดียวโดยไม่ต้องสมัครหลายครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="เว็บสล็อต TTN69 รวมเกมจากหลายแบรนด์ดัง สลับเล่นได้จากบัญชีเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d5e6da]">
        TTN69 รวบรวมเกมสล็อตจากหลายผู้ให้บริการไว้เป็นหมวดหมู่ สมาชิกสามารถ<strong class="text-[#f1faf4]">ค้นหาเกมที่ต้องการและสลับแบรนด์เกมผ่านบัญชีเดียวได้โดยไม่ต้องสมัครใหม่</strong>
        พร้อมตรวจสอบกติกา อัตราจ่าย และวงเงินเดิมพันของแต่ละเกมก่อนทำรายการได้ด้วยตัวเอง
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#d5e6da]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#02b961]">🎰</span>
          <span><strong class="text-[#f1faf4]">สล็อตคลาสสิก</strong> รูปแบบวงล้อและเส้นรางวัลไม่ซับซ้อน เหมาะกับผู้เริ่มต้นที่อยากเห็นวิธีนับผลของแต่ละรอบให้ชัดก่อน</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e4ece7]">🎁</span>
          <span><strong class="text-[#e4ece7]">เกมโบนัส</strong> มีรอบพิเศษที่เข้าเงื่อนไขแล้วจึงเปิด หน้าอธิบายในตัวเกมระบุไว้ว่าสัญลักษณ์ชุดใดพาเข้ารอบโบนัส</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#02b961]">🌀</span>
          <span><strong class="text-[#f1faf4]">ฟรีสปิน</strong> จำนวนสปินและตัวคูณต่างกันไปตามเกม ควรดูเงื่อนไขการรับและการนับผลของแต่ละเกมก่อนเริ่ม</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e4ece7]">🕹️</span>
          <span><strong class="text-[#e4ece7]">เกมรูปแบบใหม่ตามที่แต่ละแบรนด์เปิดให้บริการ</strong> รายชื่อค่ายและเกมที่พร้อมใช้งานเปลี่ยนแปลงได้ ให้ยึดหน้าเลือกเกมล่าสุดเป็นหลัก</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#d5e6da]">
        สำหรับคำว่า “ขั้นต่ำ 1 บาททุกค่าย” และ “แตกง่าย แตกหนัก” ที่ใช้เรียกกันทั่วไป
        <strong class="text-[#f5b93c]">ยอดเดิมพันต่ำสุดจริงต่างกันไปตามค่ายและตามเกม ควรเปิดดูช่วงเดิมพันในตัวเกมก่อนทุกครั้ง และผลของเกมสล็อตเป็นไปตามระบบและความผันผวนของแต่ละเกม จึงไม่สามารถรับประกันว่าเกมใดจะแตกไวหรือสร้างกำไรได้</strong>
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="โปรโมชั่น TTN69 แนะนำเพื่อน รับโบนัส 0.8% จากยอดที่เข้าเงื่อนไข" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d5e6da]">
        สมาชิกที่มีบัญชี TTN69 สามารถ <strong class="text-[#f1faf4]">Login เพื่อตรวจสอบโปรโมชั่นที่เปิดให้รับในแต่ละช่วง</strong>
        สิทธิ์แต่ละรายการอาจกำหนดยอดที่ใช้คำนวณ รอบรับโบนัส ประเภทเกมที่เข้าร่วม
        และเงื่อนไขการถอนแตกต่างกัน จึงควรอ่านรายละเอียดให้ครบก่อนกดรับโปรโมชั่น
      </p>

      <p class="text-left text-base leading-relaxed text-[#d5e6da]">
        โปรโมชั่นแนะนำเพื่อนให้สมาชิกแชร์ลิงก์แนะนำส่วนตัวให้เพื่อน เมื่อเพื่อนสมัครและมียอดใช้งานตรงตามข้อกำหนด ระบบจะคำนวณ
        <strong class="text-[#e4ece7]">โบนัสแนะนำเพื่อน 0.8%</strong> จากยอดที่เข้าเงื่อนไข
        และสมาชิกตรวจสอบจำนวนเพื่อนที่แนะนำ ยอดที่ระบบคำนวณได้ และโบนัสที่มีสิทธิ์รับผ่านบัญชีสมาชิกได้ด้วยตัวเอง
        โดยไม่ต้องรอให้เจ้าหน้าที่สรุปยอดให้ก่อน
      </p>

      <p class="text-left text-base leading-relaxed text-[#d5e6da]">
        ก่อนรับสิทธิ์ทุกครั้งควรตรวจสอบ<strong class="text-[#f5b93c]">รอบคำนวณ ประเภทเกมที่ร่วมรายการ และเงื่อนไขล่าสุดของโปรโมชั่น</strong>ให้เรียบร้อย
        เพราะวิธีคำนวณและข้อกำหนดของแต่ละรายการไม่เหมือนกันและปรับเปลี่ยนได้
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ระบบฝากถอน TTN69 รองรับทุกธนาคารและวอลเลท ขั้นต่ำ 1 บาททุกค่าย" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d5e6da]">
        TTN69 มีระบบฝากถอนที่<strong class="text-[#f1faf4]">ช่วยให้สมาชิกจัดการเครดิตผ่านบัญชีของตนเอง</strong>
        สามารถเลือกใช้บัญชีธนาคารหรือวอลเลทจากช่องทางที่เว็บไซต์เปิดรองรับ ทำรายการฝาก ส่งคำขอถอน
        และตรวจสอบสถานะรายการผ่านมือถือได้โดยตรง ช่วยลดขั้นตอนและไม่จำเป็นต้องแจ้งรายการกับเจ้าหน้าที่ทุกครั้ง
      </p>

      <p class="text-left text-base leading-relaxed text-[#d5e6da]">
        เงื่อนไข “ขั้นต่ำ 1 บาท” และ “รองรับทุกธนาคาร” ให้ยึดข้อมูลที่แสดงในหน้าฝากถอน ณ เวลาทำรายการเป็นหลัก
        <strong class="text-[#f5b93c]">เนื่องจากรายชื่อธนาคาร ยอดขั้นต่ำ วงเงิน และสถานะของแต่ละช่องทางเปิดปิดไม่พร้อมกัน</strong>
        ก่อนกดยืนยันจึงควรตรวจสอบชื่อบัญชี จำนวนเงิน และสถานะของช่องทางที่เลือกให้ครบทุกครั้ง
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ติดต่อแอดมิน TTN69 ผ่าน LINE OFFICIAL ได้ตลอด 24 ชั่วโมง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d5e6da]">
        หากสมาชิกพบปัญหาเกี่ยวกับการสมัคร Login ไม่ได้ ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง โปรโมชั่นไม่แสดง หรือเข้าเกมสล็อตไม่ได้ สามารถ
        <strong class="text-[#f1faf4]">ติดต่อแอดมิน TTN69 ผ่าน LINE OFFICIAL ได้ตลอด 24 ชั่วโมง</strong>
        โดยควรแจ้งเวลา จำนวนเงิน และรายละเอียดของรายการให้ครบ เพื่อช่วยให้เจ้าหน้าที่ตรวจสอบปัญหาได้รวดเร็วและตรงจุด
      </p>

      <p class="text-left text-base leading-relaxed text-[#d5e6da]">
        สมาชิกใหม่ยังสามารถสอบถามขั้นตอนการฝากถอน วิธีรับโปรโมชั่น หรือการเข้าใช้งานเกมของแต่ละแบรนด์ได้
        หากเป็นปัญหาด้านธุรกรรมควรเก็บหลักฐานรายการไว้จนกว่าการตรวจสอบจะเสร็จสิ้น
        และ<strong class="text-[#f5b93c]">ควรตั้งรหัสผ่านที่คาดเดายาก ไม่เปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น และตรวจสอบให้แน่ใจว่าเป็นบัญชี LINE OFFICIAL ที่ประกาศไว้บนเว็บไซต์ก่อนส่งข้อมูลใด ๆ</strong>
      </p>

      <p class="text-left text-base leading-relaxed text-[#d5e6da]">
        <strong class="text-[#f5b93c]">การเดิมพันมีความเสี่ยงและผลของแต่ละรอบไม่แน่นอน ไม่มีเกมใดรับประกันผลล่วงหน้า</strong>
        สมาชิกจึงควรกำหนดงบประมาณก่อนเริ่มเล่นทุกครั้ง
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก TTN69"
          class="flex items-center justify-center rounded-lg border border-[#046b3a]/60 bg-gradient-to-r from-[#4ce68f] via-[#02b961] to-[#046b3a] px-8 py-3 font-black text-[#020805] shadow-[0_0_15px_rgba(2,185,97,0.35)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ TTN69"
          class="flex items-center justify-center rounded-lg border border-[#e4ece7]/55 bg-transparent px-8 py-3 font-bold text-[#e4ece7] transition-all hover:scale-105 hover:border-[#e4ece7] hover:bg-[#0c2214]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
