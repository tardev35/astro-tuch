---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login,
// /register, /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจาก
// เช็กลิสต์หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ (src/assets/content.txt)
// ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึงเขียนจากข้อเท็จจริงและคลังคำของ
// บรีฟรอบนี้เท่านั้น (.claude/brand-spec-ruaythear168vip.md §6)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x5 · h3x0
//   h1  เกี่ยวกับเรา <แบรนด์> ช่องทางเล่นหวยออนไลน์ที่รวมหวยหลายประเภทไว้ที่เดียว
//   h2  ประเภทหวยที่ <แบรนด์> รวบรวมไว้ รัฐบาลไทย ลาวพัฒนา ฮานอย หุ้นต่างประเทศ
//   h2  ข้อมูลที่ <แบรนด์> ระบุไว้ให้ตรวจสอบก่อนทำรายการ
//   h2  ช่องทางฝากถอนของ <แบรนด์> และสิ่งที่ควรตรวจก่อนทำธุรกรรม
//   h2  โปรโมชั่นของ <แบรนด์> คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%
//   h2  ช่องทางติดต่อแอดมิน <แบรนด์> ตลอด 24ชม.
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) จึงเปิดใช้งานอยู่
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// ตัวที่ routing จริงคือไฟล์นี้ Astro ไม่อ่านโฟลเดอร์นั้นเลย ห้ามแก้และห้ามลบ
//
// 🚨 แกนของดรอปนี้ (2026-10-21) คือ **เว็บหวยล้วน** — เว็บที่รวบรวมหวยหลาย
// ประเภทไว้ที่เดียว: **หวยรัฐบาลไทย (อ้างอิงผลสลากกินแบ่งรัฐบาล) · หวยลาวพัฒนา ·
// หวยฮานอย · หวยหุ้นต่างประเทศ** พร้อมอัตราจ่าย โปรโมชั่น และระบบฝากถอน
// **ไม่ใช่เว็บเกมคาสิโนและไม่ใช่เว็บระบบการเงิน**
// ⚠️ หมวดเกมของแบรนด์ก่อนหน้า (รายการเต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง)
// **ไม่มีในบรีฟรอบนี้เลยแม้แต่คำเดียว ห้ามเติมกลับเข้ามา**
//
// route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ทดลองเล่น · /about-us · /contact-us · /ตรวจหวย · /แนวทาง · /terms ·
// /privacy · /line  (รอบนี้เป็นเว็บหวย → /ตรวจหวย กับ /แนวทาง เปิดอยู่จริง
// ตาม brand-spec §4 ลิงก์ไปได้)
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อผู้ผลิตเกม ชื่อธนาคาร ผู้ให้บริการ ใบอนุญาต
// นิติบุคคล ปีก่อตั้ง จำนวนสมาชิก หรือยอดฝากขั้นต่ำ แม้แต่รายการเดียว** จึงห้าม
// เขียนลงหน้าเว็บ · ตัวเลขที่ขึ้นหน้าได้มีแค่ของบรีฟเอง: 2 ตัว 100 · 3 ตัว 1,000 ·
// 0.3% · 0.8% · 24ชม.
//
// คลังคำที่บรีฟรอบนี้ให้มาและใช้ได้เท่านี้ (brand-spec §6): หวยออนไลน์ ·
// ช่องทางเล่นหวย · หวยรัฐบาลไทย · สลากกินแบ่งรัฐบาล · หวยลาวพัฒนา · หวยฮานอย ·
// หวยหุ้นต่างประเทศ · ระบบจริงจากเว็บแม่ · บริษัทแม่ · รอบเปิดรับ · รอบปิดรับ ·
// รอบประกาศผล · อัตราจ่าย · แหล่งอ้างอิงผลรางวัล · ตารางอัตราจ่าย · เลข 2 ตัว ·
// เลข 3 ตัว · สองตัวบน · สองตัวล่าง · สามตัวตรง · สามตัวโต๊ด · เลขอั้น ·
// การจำกัดยอดรับ · วงเงินจ่ายสูงสุด · ฐานเงินเดิมพัน · บิลหวย · หมายเลขรายการ ·
// ฝากถอน · ธนาคาร · วอลเลท · ยอดขั้นต่ำ · ระยะเวลาดำเนินการ · ชื่อบัญชีปลายทาง ·
// บัญชีแอบอ้าง · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · โบนัส · เครดิต · ยอดเสีย ·
// รอบรับเครดิต · ลิงก์แนะนำ · เชื่อมโยงบัญชี · ไม่จำกัดยูส · เจ้าหน้าที่ · แอดมิน ·
// 24ชม. · เว็บไซต์ทางการ · ประกาศล่าสุด · รหัสผ่าน · รหัส OTP ·
// หลักฐานที่เชื่อถือได้
//
// ⚠️ คำโฆษณาของบรีฟ ("จ่ายสูงไม่อั้น" · "ไม่มีประวัติโกง" · "รับได้ไม่จำกัดยูส")
// อยู่ได้เฉพาะในหัวข้อที่บรีฟเขียนไว้เอง (= หัวข้อของ index.astro) ห้ามขยายเป็น
// คำกล่าวอ้างใหม่ของหน้านี้ เพราะย่อหน้าของบรีฟเองตอบกลับทันทีว่าให้ตรวจสอบจาก
// หลักฐานที่เชื่อถือได้
//
// 🚨 ประโยคกำกับความเสี่ยงของบรีฟที่ต้องขึ้นครบ (เป็นเนื้อหาของบรีฟ ไม่ใช่
// filler ให้ตัดทิ้ง):
// 1) ข้อมูลเกี่ยวกับบริษัทแม่และประวัติการให้บริการควรตรวจสอบจากหลักฐานที่
//    เชื่อถือได้ (h1)
// 2) ควรตรวจสอบวันเวลาเปิดรับ อัตราจ่าย แหล่งอ้างอิงผลรางวัล และข้อกำหนดของแต่ละ
//    ประเภทก่อนทำรายการ เพื่อป้องกันความเข้าใจคลาดเคลื่อน (h2 #1)
// 3) อัตราจ่ายจริงอาจขึ้นอยู่กับประเภทหวย รูปแบบการเดิมพัน และเงื่อนไขของแต่ละรอบ ·
//    ผลรางวัลไม่สามารถคาดการณ์หรือรับประกันได้ (h2 #2)
// 4) ตรวจสอบชื่อบัญชีปลายทางให้ตรงกับข้อมูลผู้ให้บริการที่ยืนยันได้ · เก็บหลักฐาน
//    การทำรายการและติดต่อผู้ให้บริการชำระเงินโดยเร็ว · ไม่โอนเงินซ้ำโดยไม่ได้
//    ตรวจสอบสถานะรายการเดิม (h2 #3)
// 5) เครดิตคืนยอดเสียไม่ได้รับประกันผลตอบแทนจากการเดิมพันครั้งต่อไป · แม้ระบุว่า
//    ไม่จำกัด แต่ควรยืนยันจำนวนบัญชีที่เข้าร่วม รอบจ่ายเครดิต และเงื่อนไขการใช้
//    โบนัสจากประกาศล่าสุด · ควรตรวจสอบว่าโปรโมชั่นใช้ร่วมกันได้หรือไม่ (h2 #4)
// 6) ตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความเพื่อหลีกเลี่ยงบัญชี
//    แอบอ้าง · เตรียมหมายเลขรายการและหลักฐานที่เกี่ยวข้อง · ไม่เปิดเผยรหัสผ่าน
//    หรือรหัส OTP · ควรตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุดอีกครั้ง (h2 #5)
//
// 🚨 พาเลตรอบนี้ (brand-spec §2) เป็น **ธีมสว่าง** bg.json ของดรอปนี้คือ
// {"mode":"color","color":"#ffdbdb"} = ชมพูกุหลาบสว่าง ไม่ใช่ดำ
// **ห้าม "แก้" กลับไปเป็นพื้นเข้มเพราะรอบก่อนๆ เป็นแบบนั้น**
// ค่าที่ใช้ได้ในไฟล์นี้: แดงเข้ม #8f0505 (<strong>/marker — 9.6:1 บนผิวการ์ดขาว) ·
// หมึกแดงเลือดหมู #4a0f0f (เนื้อความ = BRAND_TEXT, 15.4:1) · แดงสด #c30303
// (พื้นถม/ขอบ/ออรา — ขาวบนพื้นนี้ได้ 6.3:1) · ขาว #ffffff (ตัวอักษรบนพื้นถมแดง) ·
// อินเซ็ต #fff1ef / พื้นเพจ #ffdbdb
// 🚨 **แดงชาดสด e81313 ห้ามถือตัวอักษรและห้ามเป็นพื้นของตัวอักษร** เป็น stop ของ
// ไล่เฉด/ออราได้อย่างเดียว · สีไฮไลต์ <strong> ในเนื้อความมีตัวเดียวคือ #8f0505
// 🚨 **#ffdbdb และ #fff1ef ห้ามถือตัวอักษรบนพื้นขาว** เป็นสีพื้น/ขอบเท่านั้น
// 🚨 **ทองโบราณของรอบนี้ (dcb95f b8862b 96681f) ห้ามใช้ในไฟล์นี้เลยสักจุด**
// — บนผิวการ์ดขาวได้แค่ 1.9–3.5:1 ทองเป็นสีของโครม (navbar/footer/ticker) เท่านั้น
// ออราที่อนุญาต: rgba(195,3,3,α) · rgba(143,5,5,α) · rgba(74,15,15,α)
// ⚠️ รอบนี้ไม่มีเขียว (ยกเว้น LINE green) ไม่มีชมพูบานเย็น ไม่มีบรอนซ์ส้ม
// ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์ ·
// #00B900 บนปุ่ม LINE เป็นสีประจำแพลตฟอร์ม ไม่ใช่สีของเว็บ ห้ามเปลี่ยนเป็นแดง
//
// ลำดับปุ่มในไฟล์นี้สื่อด้วย "พื้นถมแดงสด vs พื้นถมไล่เฉดแดงเข้ม vs อินเซ็ต":
// · ปุ่มหลัก (สมัครสมาชิก) ถมแดงสด #c30303 ตัวอักษรขาว (6.3:1) ขอบ #8f0505
// · ปุ่มรอง (เข้าสู่ระบบ) ถมไล่เฉด #c30303 → #8f0505 ตัวอักษรขาว (6.3:1 / 9.6:1)
// · ปุ่มลิงก์ภายในเป็นอินเซ็ต #fff1ef ขอบแดงโปร่ง ตัวอักษรหมึกแดงเลือดหมู (14.0:1)
//   hover ยกขอบเป็นแดงทึบ (ตรงกับ hover ของการ์ด ContentBox)
// · ชิปไอคอนของรายการใช้แดงสดเป็น **เส้นขอบ** บนอินเซ็ต #fff1ef ไม่ถือตัวอักษร
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT
// #4a0f0f, 15.4:1 บนผิวการ์ดขาว) ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่
// ประกาศสีของตัวเอง ปล่อยให้สืบทอดลงมา และไม่ใส่ mx-auto / max-w-* บน <p> เพราะ
// การ์ดคุมความกว้างเองแล้ว (เพิ่มไปจะเหมือนย่อหน้าเยื้อง) — ที่ประกาศสีได้มีแค่
// ปุ่ม (ถมพื้นของตัวเองจึงต้องกำหนดหมึกของตัวเอง) ชิปไอคอน marker ของลำดับเลข
// และ <strong> ซึ่ง brand-spec §2 สงวนแดงเข้ม #8f0505 ไว้เป็นสีไฮไลต์ใน
// เนื้อความเพียงสีเดียว · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง
// เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำ
// จะขาดครึ่ง (ลบแท็ก <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิม) และห้ามวาง
// <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังใน prop ที่เป็นข้อความ
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: ดรอปนี้ (brand-spec §5) ไม่มี article illustration
// เลย (banner2/banner3 เป็นอาร์ตเวิร์กของแบรนด์คนละราย เก่าทั้งคู่) ส่วน
// slide1/slide2 ถูกตรึงไว้กับ index กับ /promotion และ banner1 /
// banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// slide3/slide4 เป็นโปสเตอร์หวยของอีกแบรนด์ ห้าม import (ลำพังการ import ก็ทำให้
// ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง) — ไฟล์ยังอยู่บนดิสก์ ห้ามลบ
//
// Announcement รอบนี้หมุนมาเป็น Announcement5 ทั้งเว็บ (brand-spec §3) ยกเว้น
// สองหน้าหวย (/ตรวจหวย · /แนวทาง) ที่คง AnnouncementHuay ไว้เป็นซับธีม —
// orchestrator ตั้ง default message ของ Announcement5 เป็นคอปปี้ของแบรนด์นี้แล้ว
// จึงเรียกแบบ bare **ห้ามส่ง prop message** มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 155 อักขระ เป็นประโยคเดียวที่บอกว่าหน้านี้มีอะไร แล้วหยุด
// (Google ตัดราว 155 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} หน้ารวมข้อมูลว่าเว็บไซต์เปิดรับหวยประเภทใดไว้บ้าง ทั้งรัฐบาลไทย ลาวพัฒนา ฮานอย หุ้นต่างประเทศ พร้อมอัตราจ่าย ฝากถอน และช่องทางติดต่อ`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} ช่องทางเล่นหวยออนไลน์ที่รวมหวยหลายประเภทไว้ที่เดียว`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#8f0505]">{BRAND_NAME} นำเสนอช่องทางเล่นหวยออนไลน์ที่รวบรวมข้อมูลหวยหลายประเภทไว้ในเว็บไซต์เดียว</strong>
        ทั้งหวยรัฐบาลไทย หวยลาวพัฒนา หวยฮานอย และหวยหุ้นต่างประเทศ พร้อมรายละเอียดอัตราจ่าย โปรโมชั่น และระบบฝากถอนสำหรับสมาชิก หน้านี้รวบรวมไว้ว่าเว็บไซต์ระบุอะไรไว้บ้าง เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดอ่านอะไรตรงไหน
        แล้วจึงค่อยไล่อ่านรายละเอียดของแต่ละหัวข้อเป็นรายข้อ
      </p>

      <p>
        ผู้ใช้งานสามารถตรวจสอบรอบเปิดรับและเงื่อนไขของแต่ละรายการได้ก่อนทำธุรกรรม
        <strong class="text-[#8f0505]">โดยสิ่งที่ควรดูให้ชัดเจนทุกครั้งคือรอบปิดรับของประเภทหวยที่สนใจ และแหล่งอ้างอิงผลรางวัลที่ประเภทนั้นใช้</strong>
        เพราะหวยแต่ละประเภทมีรอบประกาศผลและเงื่อนไขของตัวเอง ไม่ได้ใช้ชุดเดียวกันทั้งหมด
      </p>

      <p>
        เนื้อหาในหน้านี้เขียนไว้ประกอบการใช้งานเท่านั้น ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะทำรายการ
        <strong class="text-[#8f0505]">ส่วนข้อมูลเกี่ยวกับบริษัทแม่และประวัติการให้บริการควรตรวจสอบจากหลักฐานที่เชื่อถือได้</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`ประเภทหวยที่ ${BRAND_NAME} รวบรวมไว้ รัฐบาลไทย ลาวพัฒนา ฮานอย หุ้นต่างประเทศ`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        {BRAND_NAME} รวบรวมข้อมูลหวยออนไลน์หลายประเภทไว้ให้ศึกษารายละเอียดได้จากช่องทางเดียว
        <strong class="text-[#8f0505]">โดยแต่ละประเภทมีรอบประกาศผลและแหล่งอ้างอิงผลรางวัลของตัวเอง</strong>
        จึงควรดูว่าประเภทที่สนใจอ้างอิงผลจากที่ใด และต้องตรวจสอบส่วนใดเพิ่มเติมจากเงื่อนไขที่เว็บไซต์แสดงอยู่
      </p>

      <ul class="flex flex-col gap-4" aria-label="ประเภทหวยที่เว็บไซต์ระบุไว้">
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#c30303]/50 bg-[#fff1ef] text-sm">🎫</span>
          <span>
            <strong class="text-[#8f0505]">หวยรัฐบาลไทย</strong> อ้างอิงผลสลากกินแบ่งรัฐบาล จึงมีรอบประกาศผลตามประกาศของงวดนั้น และควรดูรอบเปิดรับกับรอบปิดรับของเว็บไซต์ควบคู่กันทุกครั้ง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#c30303]/50 bg-[#fff1ef] text-sm">🗓️</span>
          <span>
            <strong class="text-[#8f0505]">หวยลาวพัฒนา</strong> มีรอบประกาศผลตามรายการที่เปิดให้บริการ จึงไม่ควรเทียบรอบของประเภทหนึ่งไปใช้กับอีกประเภทหนึ่ง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#c30303]/50 bg-[#fff1ef] text-sm">🕐</span>
          <span>
            <strong class="text-[#8f0505]">หวยฮานอย</strong> มีรอบประกาศผลตามประเภทที่เปิดให้บริการ จึงควรตรวจสอบว่ารายการที่เลือกใช้รอบใด และปิดรับเวลาใดก่อนทำรายการ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#c30303]/50 bg-[#fff1ef] text-sm">📈</span>
          <span>
            <strong class="text-[#8f0505]">หวยหุ้นต่างประเทศ</strong> มีรอบประกาศผลแตกต่างจากประเภทอื่น จึงควรอ่านว่ารายการนั้นใช้ตัวเลขชุดใดเป็นผล และอ้างอิงจากแหล่งใด
          </span>
        </li>
      </ul>

      <p>
        ผู้สนใจควรตรวจสอบวันเวลาเปิดรับ อัตราจ่าย แหล่งอ้างอิงผลรางวัล และข้อกำหนดของแต่ละประเภทก่อนทำรายการ
        <strong class="text-[#8f0505]">เพื่อป้องกันความเข้าใจคลาดเคลื่อนเกี่ยวกับรอบหวยและผลการตรวจรางวัล</strong>
        ไม่ควรตัดสินจากข้อความโฆษณาเพียงอย่างเดียว
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`ข้อมูลที่ ${BRAND_NAME} ระบุไว้ให้ตรวจสอบก่อนทำรายการ`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        สิ่งที่หน้าเว็บของ {BRAND_NAME} ระบุไว้ให้เปิดดูได้คือรายละเอียดของแต่ละรายการหวย
        <strong class="text-[#8f0505]">ทั้งรอบปิดรับ รอบประกาศผล ตารางอัตราจ่าย แหล่งอ้างอิงผลรางวัล และเมนูตรวจสอบรายการที่ทำไว้</strong>
        รายการด้านล่างคือลำดับที่ควรไล่ดูให้ครบ และควรตรวจซ้ำทุกครั้งที่กลับเข้ามาใหม่ เพราะเงื่อนไขปรับเปลี่ยนได้ตามที่เว็บไซต์กำหนด
      </p>

      <ol class="ml-6 list-decimal space-y-3 marker:font-black marker:text-[#8f0505]">
        <li>
          <strong class="text-[#8f0505]">รอบเปิดรับและรอบปิดรับของประเภทหวยที่เลือก</strong> ควรดูก่อนทำรายการทุกครั้ง เพราะแต่ละประเภทปิดรับไม่พร้อมกัน และรายการที่ส่งหลังรอบปิดรับจะไม่อยู่ในงวดที่ต้องการ
        </li>
        <li>
          <strong class="text-[#8f0505]">รอบประกาศผลและแหล่งอ้างอิงผลรางวัล</strong> ควรอ่านให้ชัดเจนว่าประเภทนั้นอ้างอิงผลจากที่ใด เพื่อให้ตรวจผลจากแหล่งเดียวกับที่เว็บไซต์ระบุไว้
        </li>
        <li>
          <strong class="text-[#8f0505]">ตารางอัตราจ่ายของแต่ละรูปแบบการเดิมพัน</strong> ข้อมูลโปรโมชั่นระบุตัวอย่างไว้ที่เลข 2 ตัว 100 และเลข 3 ตัว 1,000 จึงควรอ่านต่อว่าอัตรานั้นคิดต่อฐานเงินเดิมพันเท่าใด
          และครอบคลุมสองตัวบน สองตัวล่าง สามตัวตรง หรือสามตัวโต๊ด
        </li>
        <li>
          <strong class="text-[#8f0505]">เลขอั้น การจำกัดยอดรับ และวงเงินจ่ายสูงสุดของรอบนั้น</strong> ควรเปิดดูควบคู่กับตารางอัตราจ่ายเสมอ เพราะเป็นเงื่อนไขที่กำหนดไว้ต่างกันตามประเภทหวยและตามรอบ
        </li>
        <li>
          <strong class="text-[#8f0505]">บิลหวยและหมายเลขรายการที่ได้รับ</strong> ควรตรวจสอบให้ตรงกับที่ต้องการทันทีหลังทำรายการ และเก็บไว้สำหรับใช้อ้างอิงเมื่อต้องสอบถามเจ้าหน้าที่
        </li>
      </ol>

      <p>
        <strong class="text-[#8f0505]">อัตราจ่ายจริงอาจขึ้นอยู่กับประเภทหวย รูปแบบการเดิมพัน และเงื่อนไขของแต่ละรอบ</strong>
        การไล่ดูให้ครบตั้งแต่ก่อนทำรายการจึงช่วยให้สอบถามเจ้าหน้าที่ได้ตรงประเด็นเมื่อมีข้อสงสัย แต่ไม่ได้เป็นการรับประกันยอดเครดิตที่จะได้รับ เนื่องจากผลรางวัลไม่สามารถคาดการณ์หรือรับประกันได้
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/ตรวจหวย"
          aria-label={`เปิดหน้าตรวจหวยของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#c30303]/45 bg-[#fff1ef] px-8 py-3 font-bold text-[#4a0f0f] shadow-[0_4px_14px_rgba(74,15,15,0.15)] transition-all hover:scale-105 hover:border-[#c30303] hover:shadow-[0_6px_18px_rgba(195,3,3,0.3)]">
          ไปหน้าตรวจหวย
        </a>

        <a
          href="/แนวทาง"
          aria-label={`เปิดหน้าแนวทางของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#c30303]/45 bg-[#fff1ef] px-8 py-3 font-bold text-[#4a0f0f] shadow-[0_4px_14px_rgba(74,15,15,0.15)] transition-all hover:scale-105 hover:border-[#c30303] hover:shadow-[0_6px_18px_rgba(195,3,3,0.3)]">
          ไปหน้าแนวทาง
        </a>

        <a
          href="/ทางเข้า"
          aria-label={`เปิดหน้าทางเข้าของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#c30303]/45 bg-[#fff1ef] px-8 py-3 font-bold text-[#4a0f0f] shadow-[0_4px_14px_rgba(74,15,15,0.15)] transition-all hover:scale-105 hover:border-[#c30303] hover:shadow-[0_6px_18px_rgba(195,3,3,0.3)]">
          ไปหน้าทางเข้า
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`ช่องทางฝากถอนของ ${BRAND_NAME} และสิ่งที่ควรตรวจก่อนทำธุรกรรม`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} ระบุช่องทางฝากถอนผ่านธนาคารและวอลเลท เพื่อให้สมาชิกตรวจสอบวิธีทำรายการตามบริการที่เปิดใช้งานจริง
        <strong class="text-[#8f0505]">ก่อนทำธุรกรรมจึงควรศึกษายอดขั้นต่ำ ระยะเวลาดำเนินการ และเงื่อนไขการถอนเงินให้ครบถ้วน</strong>
        เพื่อให้ทราบล่วงหน้าว่าแต่ละรายการใช้เวลาประมาณเท่าใด และต้องเตรียมข้อมูลอะไรไว้
      </p>

      <p>
        สิ่งที่ควรตรวจก่อนโอนทุกครั้งคือรายละเอียดของบัญชีที่ใช้รับเงิน
        <strong class="text-[#8f0505]">โดยตรวจสอบชื่อบัญชีปลายทางให้ตรงกับข้อมูลผู้ให้บริการที่ยืนยันได้</strong>
        และไม่โอนไปยังบัญชีที่ไม่สามารถยืนยันความเกี่ยวข้องกับผู้ให้บริการได้ เพื่อหลีกเลี่ยงความเสี่ยงจากบัญชีแอบอ้าง
      </p>

      <p>
        หากพบธุรกรรมล่าช้าหรือข้อมูลบัญชีผิดปกติ
        <strong class="text-[#8f0505]">ควรเก็บหลักฐานการทำรายการและติดต่อผู้ให้บริการชำระเงินโดยเร็ว</strong>
        และไม่ควรโอนเงินซ้ำโดยไม่ได้ตรวจสอบสถานะรายการเดิม เพราะอาจทำให้ยอดซ้ำซ้อนและตรวจสอบย้อนหลังได้ยากขึ้น
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`โปรโมชั่นของ ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} นำเสนอข้อมูลโปรโมชั่นสำหรับสมาชิกที่สนใจสิทธิพิเศษจากการใช้บริการหวยออนไลน์ โดยรายการหลักที่ระบุไว้ประกอบด้วย
        <strong class="text-[#8f0505]">รายการคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8%</strong>
        ซึ่งแต่ละรายการอาจมีข้อกำหนดเกี่ยวกับประเภทหวย ยอดที่นำมาคำนวณ รอบรับเครดิต และจำนวนบัญชีที่เข้าร่วมแตกต่างกัน ก่อนรับสิทธิ์จึงควรอ่านเงื่อนไขล่าสุดและตรวจสอบว่าโปรโมชั่นสามารถใช้ร่วมกันได้หรือไม่
      </p>

      <p>
        รายการคืนยอดเสียระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขในแต่ละวัน
        <strong class="text-[#8f0505]">สมาชิกควรตรวจสอบว่าหวยรัฐบาลไทย หวยลาวพัฒนา หวยฮานอย หรือหวยหุ้นต่างประเทศประเภทใดเข้าร่วมรายการ รวมถึงรอบคำนวณยอดและวิธีรับเครดิต</strong>
        เพราะหวยแต่ละประเภทมีรอบประกาศผลไม่เหมือนกัน ทั้งนี้ เครดิตคืนยอดเสียไม่ได้รับประกันผลตอบแทนจากการเดิมพันครั้งต่อไป
      </p>

      <p>
        ส่วนรายการแนะนำเพื่อนระบุสิทธิ์ไว้สำหรับสมาชิกที่แนะนำผู้ใช้งานรายใหม่ โดยควรตรวจสอบวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และยอดที่ใช้คำนวณโบนัสให้ครบถ้วน
        <strong class="text-[#8f0505]">แม้โปรโมชั่นจะระบุว่าไม่จำกัด แต่ควรยืนยันรายละเอียดเกี่ยวกับจำนวนบัญชีที่เข้าร่วม รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุด</strong>
        เพื่อให้ทราบหลักเกณฑ์การรับสิทธิ์อย่างถูกต้อง และไม่เกิดความคลาดเคลื่อนเกี่ยวกับยอดโบนัส
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/promotion"
          aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#c30303]/45 bg-[#fff1ef] px-8 py-3 font-bold text-[#4a0f0f] shadow-[0_4px_14px_rgba(74,15,15,0.15)] transition-all hover:scale-105 hover:border-[#c30303] hover:shadow-[0_6px_18px_rgba(195,3,3,0.3)]">
          ดูภาพโปรโมชั่น
        </a>

        <a
          href="/ทดลองเล่น"
          aria-label={`เปิดหน้าทดลองเล่นของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#c30303]/45 bg-[#fff1ef] px-8 py-3 font-bold text-[#4a0f0f] shadow-[0_4px_14px_rgba(74,15,15,0.15)] transition-all hover:scale-105 hover:border-[#c30303] hover:shadow-[0_6px_18px_rgba(195,3,3,0.3)]">
          ไปหน้าทดลองเล่น
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`ช่องทางติดต่อแอดมิน ${BRAND_NAME} ตลอด 24ชม.`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
