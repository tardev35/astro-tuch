---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

// PREMSUK365 เป็นเว็บ "หวยออนไลน์" ไม่ใช่คาสิโน/สล็อต — เนื้อหาทั้งหน้าจึงพูดเรื่องการรับ
// เลขดัง/เลขอั้น อัตราจ่ายก่อนส่งโพย ฝากถอนออโต้ และการเช็กบิลย้อนหลัง
// ทุกข้อความด้านล่างอ้างอิง src/assets/content.txt เท่านั้น ไม่มีการอ้างใบอนุญาต
// การจดทะเบียนบริษัท ปีที่ก่อตั้ง รางวัล จำนวนสมาชิก หรือการันตีผลกำไร
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 158
const pageDescription = "รู้จัก PREMSUK365 เว็บแทงหวยออนไลน์ที่รับเลขดังและเลขอั้นตามวงเงินที่ระบบเปิดรับ แสดงอัตราจ่ายก่อนส่งโพย เช็กบิลย้อนหลังได้เอง ฝากถอนออโต้ผ่านวอลเลทหรือธนาคาร";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ PREMSUK365 เว็บแทงหวยออนไลน์ที่รับเลขดังและเลขอั้น",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา PREMSUK365 เว็บแทงหวยออนไลน์ รับเลขดัง เลขอั้น ไม่ลบบิล ไม่เบี้ยวโพย" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ PREMSUK365 เว็บแทงหวยออนไลน์ที่รับเลขดังและเลขอั้น" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e4e7d8]">
        <strong class="text-[#f7e8b4]">PREMSUK365</strong> เปิดบริการสำหรับคนที่ต้องการ<strong class="text-[#f7e8b4]">แทงหวยออนไลน์</strong>ผ่านระบบที่ใช้งานง่าย
        จุดเด่นคือการรับเลขดังและเลขอั้นตามวงเงินที่ระบบเปิดรับ พร้อมแสดงอัตราจ่ายให้ตรวจสอบก่อนส่งโพยทุกครั้ง
        สมาชิกเลือกเลข กำหนดยอด และเช็กบิลย้อนหลังได้ด้วยตัวเองจากบัญชีเดียว ใช้งานผ่านสมาร์ตโฟน แท็บเล็ต หรือคอมพิวเตอร์ก็ได้เหมือนกัน
      </p>

      <p class="text-left text-base leading-relaxed text-[#e4e7d8]">
        แนวคิดของเว็บคือทำให้ทุกขั้นตอนตรวจสอบได้ตั้งแต่ก่อนยืนยันรายการ ทั้งวงเงินที่รับได้ของแต่ละเลข อัตราจ่ายที่ใช้คิดผล และประวัติบิลที่ย้อนกลับมาดูได้เสมอ
        ควบคู่กับ<strong class="text-[#f7e8b4]">ระบบฝากถอนออโต้ผ่านวอลเลทหรือธนาคาร</strong>ที่เว็บไซต์เปิดรองรับ และแอดมินที่ช่วยตรวจสอบให้ทันทีเมื่อโพยหรือธุรกรรมมีปัญหา
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="PREMSUK365 เปิดรับเลขดัง เลขอั้น เว็บไหนอั้นเว็บเรารับหมด" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e4e7d8]">
        สายหวยที่มีเลขในใจสามารถเข้ามาตรวจสอบการรับแทงกับ PREMSUK365 ได้ก่อนส่งโพย ไม่ว่าจะเป็นเลขดัง เลขกระแส หรือเลขที่บางรอบมีผู้เลือกเดิมพันจำนวนมาก
        <strong class="text-[#f7e8b4]">ระบบจะแสดงวงเงินที่สามารถรับได้ก่อนยืนยันรายการ</strong> ทำให้เห็นรายละเอียดของเลขและยอดเดิมพันอย่างชัดเจนตั้งแต่ต้น
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#e4e7d8]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e3c56a]">🎯</span>
          <span><strong class="text-[#f7e8b4]">เลขดังและเลขกระแส</strong> เลือกได้จากหน้าส่งโพยโดยตรง ระบบจะบอกว่ารอบนั้นรับเลขที่ต้องการอยู่หรือไม่ ก่อนกดยืนยัน</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e3c56a]">🎱</span>
          <span><strong class="text-[#f7e8b4]">เลขอั้น</strong> ยังตรวจสอบได้เช่นกัน หากเลขใดมีข้อจำกัด ระบบควรแสดงรายละเอียดของข้อจำกัดนั้นก่อนสมาชิกยืนยันรายการ</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e3c56a]">💰</span>
          <span><strong class="text-[#f7e8b4]">วงเงินที่ระบบเปิดรับ</strong> เป็นตัวเลขของรอบนั้น ๆ จึงควรยึดข้อมูลที่ระบบแสดง ณ เวลาที่ส่งโพยเป็นหลัก ไม่ใช่ตัวเลขของรอบก่อนหน้า</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e3c56a]">🧾</span>
          <span><strong class="text-[#f7e8b4]">ประวัติบิล</strong> เมื่อส่งโพยสำเร็จควรเก็บบิลไว้ตรวจสอบผลและยอดรางวัลภายหลัง เพราะเช็กย้อนหลังได้เองจากบัญชีสมาชิก</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#a9bda9]">
        การแทงหวยมีความเสี่ยงและผลของแต่ละรอบไม่แน่นอน ไม่มีเลขหรือรูปแบบใดรับประกันผลล่วงหน้า สมาชิกจึงควรตรวจสอบข้อมูลให้ครบและ<strong class="text-[#a9bda9]">กำหนดงบประมาณก่อนส่งโพยทุกครั้ง</strong>
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="อัตราจ่ายของ PREMSUK365 เลข 2 ตัวบาทละ 100 และเลข 3 ตัวบาทละ 1,000" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e4e7d8]">
        PREMSUK365 เน้นแสดงอัตราจ่ายให้ตรวจสอบก่อนตัดสินใจส่งโพย โดยเรทที่กำหนดไว้คือ
        <strong class="text-[#f7e8b4]">เลข 2 ตัว บาทละ 100</strong> และ<strong class="text-[#f7e8b4]">เลข 3 ตัว บาทละ 1,000</strong>
        ซึ่งช่วยให้คำนวณยอดเบื้องต้นได้ง่ายตั้งแต่ก่อนวางเดิมพัน
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#e4e7d8]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e3c56a]">2️⃣</span>
          <span>เลือกเลข 2 ตัวและลงเดิมพัน 10 บาท ด้วยเรท 1 ต่อ 100 เมื่อผลตรงตามเงื่อนไข ยอดตามเรทจะเท่ากับ <strong class="text-[#f7e8b4]">1,000 บาท</strong></span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e3c56a]">3️⃣</span>
          <span>เลือกเลข 3 ตัวและเดิมพัน 10 บาท ด้วยเรท 1 ต่อ 1,000 เมื่อผลตรงตามเงื่อนไข ยอดตามเรทจะเท่ากับ <strong class="text-[#f7e8b4]">10,000 บาท</strong></span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#a9bda9]">
        ก่อนแทงควรตรวจสอบประเภทหวย เลขที่เลือก และอัตราจ่ายจริงในระบบอีกครั้ง เพราะบางรอบหรือบางประเภทอาจมีเงื่อนไขเฉพาะ ให้ยึดอัตราจ่ายที่ปรากฏบนหน้าส่งโพยก่อนกดยืนยันเป็นหลัก
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ฝากถอนออโต้ เช็กบิลย้อนหลัง และแอดมิน PREMSUK365 ช่วยตรวจสอบ" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e4e7d8]">
        สมาชิกจัดการเครดิตได้ผ่าน<strong class="text-[#f7e8b4]">ระบบฝากถอนออโต้</strong> โดยเลือกวอลเลทหรือบัญชีธนาคารจากช่องทางที่เว็บไซต์เปิดรองรับ
        จากนั้นระบุจำนวนเงินและตรวจสอบรายละเอียดก่อนยืนยันรายการ พร้อมติดตามสถานะฝากถอนและประวัติธุรกรรมจากบัญชีสมาชิกได้ด้วยตัวเอง
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#e4e7d8]">
        <li class="flex gap-3"><span class="font-bold text-[#e3c56a]">1.</span> เปิดหน้าสมัคร PREMSUK365 และกรอกข้อมูลตามที่ระบบกำหนด ทำผ่านมือถือหรือคอมพิวเตอร์ได้โดยตรง</li>
        <li class="flex gap-3"><span class="font-bold text-[#e3c56a]">2.</span> Login เข้าบัญชี แล้วฝากเครดิตผ่านวอลเลทหรือธนาคารที่ระบบรองรับ</li>
        <li class="flex gap-3"><span class="font-bold text-[#e3c56a]">3.</span> เลือกประเภทหวยและเลขที่ต้องการ ดูวงเงินที่ระบบเปิดรับกับอัตราจ่าย แล้วจึงส่งโพย</li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#a9bda9]">
        สำหรับยอดขั้นต่ำ วงเงินสูงสุด และรายชื่อธนาคารที่รองรับ ควรตรวจสอบข้อมูลล่าสุดในระบบก่อนทำรายการทุกครั้ง เนื่องจากช่องทางและข้อกำหนดอาจแตกต่างกันในแต่ละช่วงเวลา
      </p>

      <p class="text-left text-base leading-relaxed text-[#e4e7d8]">
        หากส่งโพยไม่สำเร็จ เลขที่ต้องการแทงไม่แสดง ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง หรือพบยอดในบิลไม่ตรงกับรายการ สามารถ
        <strong class="text-[#f7e8b4]">ติดต่อแอดมิน PREMSUK365 ได้ทันที</strong> พร้อมแจ้งประเภทหวย รอบเดิมพัน เวลา และรายละเอียดธุรกรรม เพื่อให้ตรวจสอบได้ตรงจุด
        ควรเก็บข้อมูลบิลและหลักฐานการทำรายการไว้จนกว่าปัญหาจะได้รับการตรวจสอบ และ<strong class="text-[#f7e8b4]">ไม่ควรเปิดเผยรหัสผ่านหรือ OTP แก่บุคคลอื่น</strong>
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก PREMSUK365"
          class="flex items-center justify-center rounded-lg border border-[#e3c56a]/50 bg-gradient-to-r from-[#f7e8b4] via-[#e3c56a] to-[#8a6a26] px-8 py-3 font-black text-[#020c06] shadow-[0_0_15px_rgba(227,197,106,0.4)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ PREMSUK365"
          class="flex items-center justify-center rounded-lg border border-[#e3c56a]/60 bg-transparent px-8 py-3 font-bold text-[#f7e8b4] transition-all hover:scale-105 hover:border-[#f7e8b4] hover:bg-[#0d3a22]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
