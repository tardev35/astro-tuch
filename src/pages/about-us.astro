---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่ม) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง
//
// บรีฟรอบนี้ (ดรอป 2026-09-22) คือ "หวยพยัคฆ์ แทงหวย อันดับ1 รัฐบาลไทย ฮานอย
// ลาวพัฒนา จ่ายเต็ม" — เป็นเว็บ "หวย" ไม่ใช่เว็บสล็อตและไม่ใช่คาสิโน คอปปี้ของ
// แบรนด์รอบก่อน (HENG35 "สล็อตยูสใหม่ ไม่ล็อค โบนัสฝากแรก คืนยอดเสีย 0.3%
// แนะนำเพื่อน 0.8%") ถูกเขียนใหม่ทั้งหน้าแล้ว ไม่เหลือประโยคเดิม
//
// ข้อเท็จจริงทุกบรรทัดมาจากบรีฟรอบนี้เท่านั้น: รวมรัฐบาลไทย ฮานอย ลาวพัฒนา และ
// หวยหุ้นต่างประเทศไว้ในระบบเดียว · เลือกดูรอบที่เปิดรับ ตรวจสอบเลข และจัดการ
// รายการได้จากหน้าเดียว · เปิดรับเลขเด็ดเลขดังตามรอบที่ระบบกำหนด ไม่อั้นเลข
// จ่ายเต็ม · แสดงอัตราจ่ายของแต่ละประเภทเลขก่อนยืนยันรายการ · เลข 2 ตัวจ่าย 100 ·
// เลข 3 ตัวจ่าย 1,000 · สมัครเองได้ผ่านหน้าเว็บไซต์ใน 3 ขั้นตอน · แอดมินออนไลน์
// ตลอด 24 ชั่วโมง · รายการที่เปิดรับต่างกันตามวันและช่วงเวลา
// — ห้ามอ้างเลขใบอนุญาต ปีที่ก่อตั้ง เลขทะเบียนบริษัท จำนวนสมาชิก จำนวนทีมงาน
// รางวัล ที่อยู่บริษัท ชื่อเจ้ามือ อัตราจ่ายอื่นนอกจาก 100/1,000 "ปลอดภัย 100%"
// หรือการันตีว่าถูกรางวัล เพราะบรีฟไม่ได้ระบุไว้
//
// Announcement รอบนี้หมุนมาใช้ AnnouncementHuay ทั้งเว็บ — default message ของ
// ไฟล์นั้นเป็นคอปปี้ของ หวยพยัคฆ์ อยู่แล้ว จึงเรียกแบบ bare ไม่ต้องส่ง prop
//
// พาเลตต์ หวยพยัคฆ์ (กรมท่า + ทอง แทนดำ + ทองของ HENG35):
// พื้น #030b1c · การ์ด #08152f · ผิวยก #0f2149 · ขอบบรอนซ์ #ab6d13 ·
// ทองหลัก #fadb6c · ทองสว่าง #fdf5a4 · เนื้อความ #dbe4f7 · <strong> #fadb6c ·
// ตัวอักษรบนปุ่มทอง #030b1c · เงาลึก rgba(3,11,28,α) · ออร่าทอง rgba(250,219,108,α)
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 158
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "เกี่ยวกับ หวยพยัคฆ์ เว็บแทงหวยออนไลน์ที่รวมรัฐบาลไทย ฮานอย ลาวพัฒนา และหวยหุ้นต่างประเทศไว้ในระบบเดียว เลข 2 ตัวจ่าย 100 เลข 3 ตัวจ่าย 1,000 ตรวจสอบรอบก่อนแทง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับเรา หวยพยัคฆ์ แทงหวยรัฐบาลไทย ฮานอย ลาวพัฒนา ครบทุกประเภท",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา หวยพยัคฆ์ แทงหวยรัฐบาลไทย ฮานอย ลาวพัฒนา ครบทุกประเภท" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับเรา หวยพยัคฆ์ แทงหวยรัฐบาลไทย ฮานอย ลาวพัฒนา ครบทุกประเภท" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dbe4f7]">
        <strong class="text-[#fadb6c]">หวยพยัคฆ์</strong> รวมรายการแทงหวยหลายประเภทไว้ในระบบเดียว
        ทั้ง<strong class="text-[#fadb6c]">รัฐบาลไทย ฮานอย ลาวพัฒนา และหวยหุ้นต่างประเทศ</strong>
        ผู้ใช้งานสามารถเลือกดูรอบที่เปิดรับ ตรวจสอบเลขที่ต้องการ และจัดการรายการได้จากหน้าเดียว
        เหมาะกับคนที่ต้องการติดตามหวยหลายประเภทโดยไม่ต้องสลับหลายเว็บไซต์
      </p>

      <p class="text-left text-base leading-relaxed text-[#dbe4f7]">
        หน้านี้รวบรวมไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่ประเภทหวยที่เปิดรับและรอบเวลาของแต่ละรายการ
        อัตราจ่ายที่ระบบระบุไว้ก่อนยืนยันบิล ขั้นตอนการสมัครสมาชิก ไปจนถึงช่องทางติดต่อทีมงานเมื่อมีข้อสงสัยระหว่างใช้งาน
      </p>

      <p class="text-left text-base leading-relaxed text-[#dbe4f7]">
        <strong class="text-[#fadb6c]">รายการที่เปิดรับอาจแตกต่างกันตามวันและช่วงเวลา</strong>
        รายละเอียดทั้งหมดจึงยึดตามรอบที่ระบบเปิดให้ทำรายการจริงในช่วงนั้นเป็นหลัก
        และควรตรวจสอบรอบล่าสุดได้จากหน้ารวมหวยก่อนทำรายการทุกครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="หวยพยัคฆ์ เปิดรับทุกเลขเด็ด เลขดัง ไม่อั้นเลข จ่ายเต็ม" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dbe4f7]">
        หวยพยัคฆ์ เปิดให้เลือก<strong class="text-[#fadb6c]">เลขเด็ดและเลขดังจากหลายรายการตามรอบที่ระบบกำหนด</strong>
        สามารถตรวจสอบเลขที่เปิดรับ ประเภทการแทง และรายละเอียดก่อนยืนยันได้ทุกครั้ง
        พร้อมรองรับรายการจากหลายตลาด ช่วยให้เลือกเลขและติดตามรอบที่สนใจได้สะดวกมากขึ้น
      </p>

      <p class="text-left text-base leading-relaxed text-[#dbe4f7]">
        เพราะรายการถูกรวมไว้ในระบบเดียว คนที่ติดตามทั้ง<strong class="text-[#fadb6c]">หวยรัฐบาลไทย หวยฮานอย ลาวพัฒนา และหวยหุ้นต่างประเทศ</strong>
        จึงเปิดดูรอบของแต่ละตลาดเทียบกันได้จากหน้าเดียว ไม่ต้องไล่จำว่ารายการไหนปิดรับเวลาใด
        แล้วค่อยเลือกเฉพาะรอบที่ยังเปิดอยู่มาทำรายการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="อัตราจ่าย หวยพยัคฆ์ เลข 2 ตัวจ่าย 100 และเลข 3 ตัวจ่าย 1,000" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dbe4f7]">
        หวยพยัคฆ์ <strong class="text-[#fadb6c]">แสดงอัตราจ่ายของแต่ละประเภทเลขไว้อย่างชัดเจนก่อนยืนยันรายการ</strong>
        ทั้งเลข 2 ตัวและเลข 3 ตัว ผู้ใช้งานสามารถตรวจสอบอัตรา รอบหวย และประเภทบิลได้จากหน้าเดียว
        ช่วยให้เปรียบเทียบรายละเอียดและเลือกวิธีแทงที่เหมาะกับเลขที่ต้องการได้ง่ายขึ้น
      </p>

      <p class="text-left text-base leading-relaxed text-[#dbe4f7]">
        <strong class="text-[#fadb6c]">เลข 2 ตัวระบุอัตราจ่ายไว้ที่ 100</strong> ตามเงื่อนไขของแต่ละรายการ
        เลือกเลขที่ต้องการ ตรวจสอบรอบเปิดรับ และเช็กรายละเอียดของบิลก่อนยืนยันได้
        ช่วยให้จัดการเลขที่ติดตามได้เป็นขั้นตอนและลดความผิดพลาดก่อนส่งรายการ
      </p>

      <p class="text-left text-base leading-relaxed text-[#dbe4f7]">
        สำหรับ<strong class="text-[#fadb6c]">เลข 3 ตัวระบุอัตราจ่ายไว้ที่ 1,000</strong> ตามเงื่อนไขของระบบ
        ก่อนยืนยันสามารถตรวจสอบเลข ประเภทหวย รอบเวลา และรายละเอียดของรายการได้อีกครั้ง
        เหมาะกับผู้ที่มีชุดเลข 3 ตัวและต้องการดูข้อมูลให้ครบก่อนส่งบิล
      </p>
    </div>
  </ContentBox>

  <ContentBox title="สมัครแทงหวย หวยพยัคฆ์ ทำเองได้ใน 3 ขั้นตอน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dbe4f7]">
        การสมัคร หวยพยัคฆ์ สามารถทำผ่านหน้าเว็บไซต์ได้ด้วยตัวเอง ขั้นตอนไม่ซับซ้อน
        และหลัง<strong class="text-[#fadb6c]">ยืนยันบัญชีเรียบร้อยสามารถเข้าสู่ระบบเพื่อดูรายการหวยที่เปิดรับได้ทันที</strong>
        โดยมี 3 ขั้นตอนหลักดังนี้
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#dbe4f7]">
        <li class="flex gap-3">
          <span class="font-bold text-[#fadb6c]">1.</span>
          <span>เปิดหน้าสมัคร หวยพยัคฆ์ แล้วกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#fadb6c]">2.</span>
          <span>ตรวจสอบข้อมูลส่วนตัวและรายละเอียดบัญชีให้ถูกต้องก่อนกดยืนยัน</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#fadb6c]">3.</span>
          <span>ยืนยันการสมัครและเข้าสู่ระบบ จากนั้นเลือกรัฐบาลไทย ฮานอย ลาวพัฒนา หรือรายการอื่นที่ต้องการได้ทันที</span>
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#dbe4f7]">
        <strong class="text-[#fadb6c]">ตั้งรหัสผ่านที่คาดเดายาก ไม่ใช้รหัสเดียวกับบริการอื่น และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น</strong>
        รวมถึงตรวจสอบให้แน่ใจว่าเป็นช่องทางติดต่อที่ประกาศไว้บนเว็บไซต์ก่อนส่งข้อมูลใด ๆ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="แอดมิน หวยพยัคฆ์ ออนไลน์ 24 ชั่วโมง ติดต่อได้ทันที" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dbe4f7]">
        หากมีข้อสงสัยเกี่ยวกับ<strong class="text-[#fadb6c]">การสมัคร รอบหวย อัตราจ่าย วิธีเลือกเลข หรือการใช้งานเมนูภายในเว็บไซต์</strong>
        สามารถติดต่อแอดมิน หวยพยัคฆ์ ได้ตลอด 24 ชั่วโมง ทีมงานพร้อมช่วยให้ข้อมูลและตรวจสอบปัญหาตามรายละเอียดที่แจ้ง
        เพื่อให้ทั้งสมาชิกใหม่และสมาชิกเดิมใช้งานระบบได้สะดวกขึ้น
      </p>

      <p class="text-left text-base leading-relaxed text-[#dbe4f7]">
        เวลาแจ้งปัญหาเข้ามา ควรระบุรอบหวย เวลาที่ทำรายการ และเลขที่ส่งไปให้ครบ
        เพื่อให้ทีมงานตรวจสอบตามข้อมูลที่แจ้งได้เร็วขึ้น
        <strong class="text-[#fadb6c]">และควรยึดยอดกับสถานะของบิลที่ระบบแสดง ณ เวลาที่ทำรายการเป็นหลัก</strong>
      </p>

      <p class="text-left text-base leading-relaxed text-[#dbe4f7]">
        <strong class="text-[#fadb6c]">ผลรางวัลของหวยทุกประเภทตัดสินจากการออกรางวัลของแต่ละตลาด ไม่มีสูตรหรือเลขใดรับประกันผล</strong>
        จึงควรกำหนดงบประมาณก่อนทำรายการทุกครั้ง และหยุดเมื่อถึงขีดที่ตั้งไว้
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก หวยพยัคฆ์"
          class="flex items-center justify-center rounded-lg border border-[#fdf5a4]/60 bg-gradient-to-r from-[#fdf5a4] via-[#fadb6c] to-[#ab6d13] px-8 py-3 font-black text-[#030b1c] shadow-[0_0_15px_rgba(250,219,108,0.42)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ หวยพยัคฆ์"
          class="flex items-center justify-center rounded-lg border border-[#ab6d13] bg-[#0f2149] px-8 py-3 font-bold text-[#dbe4f7] transition-all hover:scale-105 hover:border-[#fadb6c] hover:bg-[#08152f] hover:text-[#fadb6c]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
