---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login, /register,
// /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx
// ที่ใช้กับ index.astro — บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES
// ที่ให้ body มา ทั้งหน้าจึงเขียนขึ้นใหม่จากข้อเท็จจริงและคลังคำของบรีฟรอบนี้เท่านั้น
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x5 · h3x0
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) จึงเปิดใช้งานอยู่
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// ตัวที่ routing จริงคือไฟล์นี้ Astro ไม่อ่านโฟลเดอร์นั้นเลย ห้ามแก้และห้ามลบ
//
// ⚠️ ดรอปนี้ (2026-10-18) คือ **เว็บสล็อตล้วน** ไม่ใช่หมวดอื่นใดทั้งสิ้น
// สองหน้าของหมวดที่แบรนด์ก่อนๆ เคยเปิดจอดอยู่ใน src/pages-disabled/ ไม่มี route
// ห้ามลิงก์ไปหา เป็น href ตายที่ทำให้ build แดง route ที่มีจริงรอบนี้คือ
// / · /about-us · /contact-us · /login · /register · /privacy · /promotion ·
// /terms · /ทดลองเล่น · /ทางเข้า · /line
//
// ⚠️ แบรนด์ก่อนหน้า (ที่ถูกแทนที่รอบนี้) ก็เป็นแบรนด์สล็อตเหมือนกัน คอปปี้เดิมจึง
// "ดูเข้าเค้า" ทั้งที่กรอบของบรีฟคนละอัน — **ห้าม find-and-replace ทับประโยคเดิม**
// ทั้งหน้าถูกเขียนใหม่รอบกรอบของบรีฟรอบนี้ ซึ่งมีแกนเดียวคือ
// **เว็บสล็อตฐานหลักที่ขายความง่ายในการถอนเงิน** ไม่ใช่กรอบของรอบก่อน ซึ่งว่าด้วย
// แหล่งที่มาของระบบและการรวมค่ายเกมชื่อดังสามค่าย ซึ่งถูกถอดออก
// หมดทั้งไฟล์แล้ว (คำต้องห้ามไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ
// false positive ในคอมเมนต์ของไฟล์นี้เอง — รายการเต็มอยู่ใน brand-spec §6)
//
// 🚨 **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกมแม้แต่ค่ายเดียว** จึงห้ามเขียนชื่อค่ายใดๆ
// ลงหน้าเว็บ ให้ใช้คำกลางว่า "ค่ายเกม" ตามบรีฟ
//
// แง่มุมที่บรีฟรอบนี้ระบุไว้มีเท่านี้ (ห้ามเติมอย่างอื่น): ฐานหลัก ·
// เว็บสล็อตฐานหลัก · ถอนง่าย · ได้เงินจริง · ไม่มีรีวิวเสีย · การันตีเว็บแท้ ·
// ผู้ใช้งานหลักแสนยูสต่อวัน · เกมสล็อตออนไลน์ · สมัครสมาชิก · เข้าสู่ระบบ ·
// ฝากถอน · เงื่อนไขการถอนเงิน · ทำรายการ · สถานะรายการ · หลักฐาน · โปรโมชั่น ·
// คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · เครดิต · ยอดเสีย · รอบเวลา · รหัสแนะนำ ·
// เชื่อมโยงบัญชี · ค่ายเกม · กติกา · LINE Official · QR Code · บัญชีแอบอ้าง ·
// รหัสผ่าน · รหัส OTP · เจ้าหน้าที่ · นโยบายการจัดเก็บข้อมูลส่วนบุคคล ·
// คุณสมบัติผู้ใช้งาน
//
// ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 100% · 3 ขั้นตอน · 24 ชม. ·
// หลักแสนยูสต่อวัน ส่วนตัวเลขและชื่อเฉพาะที่ห้ามแต่งขึ้นเองอยู่ครบใน brand-spec §6
// (เลขใบอนุญาต · ชื่อนิติบุคคล · ชื่อธนาคาร · ค่า RTP · ยอดฝากขั้นต่ำ ·
// จำนวนสมาชิก · ปีก่อตั้ง · ชื่อค่ายเกม)
//
// 🚨 บรีฟรอบนี้ hedge หนักผิดปกติ และ **ประโยค hedge ทุกประโยคต้องขึ้นครบ**
// เป็นเนื้อหาของบรีฟ ไม่ใช่ filler ให้ตัดทิ้ง — และห้ามเขียนเสริมให้กลายเป็น
// คำโฆษณาที่บรีฟกำลังเตือนเรื่องนั้นอยู่:
// 1) ข้อมูลเกี่ยวกับการจ่ายเงินจริง ความน่าเชื่อถือ และความคิดเห็นจากผู้ใช้งาน
//    ควรตรวจสอบจากหลักฐานและรีวิวหลายแหล่งก่อนตัดสินใจ (h1)
// 2) ข้อมูลที่ระบุว่ามีผู้ใช้งานหลักแสนบัญชีต่อวันหรือไม่มีรีวิวเชิงลบ ยังต้อง
//    อาศัยหลักฐานที่ตรวจสอบได้ (h2 #1)
// 3) ไม่ควรอาศัยคำโฆษณาว่าถอนได้จริงหรือถอนได้ทุกครั้งเพียงอย่างเดียว (h2 #2)
// 4) เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือ
//    รับประกันผลการเล่นในอนาคต (h2 #3)
// 5) ควรยืนยันเวลาให้บริการและระยะเวลาตอบกลับจริงจากช่องทางทางการอีกครั้ง (h2 #5)
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ชมพูบับเบิลกัมนำ ทองเนยเป็นฮิวที่สอง
// พลัมเข้มไม่เคยถือตัวอักษร บนดำสนิท** — กลับด้านกับรอบก่อนที่ทองเป็นตัวนำ
// ⚠️ แบรนด์ก่อนๆ มีทองแทบทุกราย และรอบที่แล้วก็มีทั้งทองและชมพู "มีทองอยู่" หรือ
// "มีชมพูอยู่" จึงไม่ใช่ตัวบอกว่าถูกแบรนด์ ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน
// brand-spec §2 (ค่าเดิมไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ
// false positive) ชมพูรอบนี้คือ **#fa63b9** และทองรอบนี้คือ **#ffd84d**
// ลำดับความลึก: #2b0f20 ผิวยก (= การ์ด) / #1a0914 กลาง / #0d040a จม / #000000 พื้นเพจ
//
// ลำดับปุ่มสื่อด้วย "ไล่เฉดทอง→ชมพู vs ผิวจมขอบพลัม" — คู่พื้น-หมึกคำนวณไว้แล้ว:
// · ปุ่มหลัก (สมัครสมาชิก) ถมไล่เฉด #ffd84d → #fa63b9 ขอบ #6b4708 หมึก #2a0617
//   (13.4:1 บนปลายทอง · 7.0:1 บนปลายชมพู ผ่าน AA ทั้งเส้น)
// · ปุ่มรอง/ปุ่มลิงก์ภายในเป็นชั้นจม #1a0914 → #0d040a ขอบ #6d0b3f/60
//   ตัวอักษร #fdeaf5 — hover ยกขอบเป็นชมพูบับเบิลกัม #fa63b9
// · marker ของลำดับเลขใช้ชมพูอ่อน #ffb3de (10.7:1 บนผิวการ์ด — เป็นตัวอักษร จึงใช้
//   พลัมเข้มไม่ได้ และ #ffd84d สงวนไว้ให้ <strong> เท่านั้น)
// · #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ (§2)
// ⚠️ #6d0b3f · #6b4708 ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่เส้นขอบ ออรา เงา และพื้นถม
// — ออราในไฟล์นี้ใช้ rgba(109,11,63,α) · rgba(255,216,77,α) · rgba(250,99,185,α)
// เท่านั้น และรอบนี้ไม่มีม่วง ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว ไม่มีส้ม
// ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์ และไม่มีแดงชาด
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #fdeaf5,
// 15.3:1 บนผิวยก #2b0f20) ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง
// ปล่อยให้สืบทอดลงมา และไม่ใส่ mx-auto / max-w-* บน <p> เพราะการ์ดคุมความกว้างเองแล้ว
// — ที่ประกาศสีได้มีแค่ปุ่ม (ถมพื้นของตัวเองจึงต้องกำหนดหมึกของตัวเอง) marker ของ
// ลำดับเลข และ <strong> ซึ่ง brand-spec §2 สงวน #ffd84d (12.7:1 บนผิวการ์ด) ไว้เป็น
// สีไฮไลต์ในเนื้อความโดยเฉพาะ และไม่ใช้สีอื่นเลย · แต่ละ <strong> ครอบ "ช่วงที่คั่น
// ด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ
// บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง (ลบแท็ก <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิม)
// และห้ามวาง <strong> สองอันติดกัน
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้าง
// จากหน้า และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้หมุนมาเป็น Announcement6 ทั้งเว็บ (brand-spec §3)
// orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียก
// แบบ bare ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 157 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} เว็บสล็อตฐานหลักถอนง่าย รวมเมนูสมัครสมาชิก ฝากถอน และตรวจสอบโปรโมชั่นไว้ในเว็บไซต์เดียว พร้อมเงื่อนไขการถอนเงินที่ควรศึกษาก่อนใช้งาน`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} เว็บสล็อตฐานหลักถอนง่าย รวมเมนูสมัครสมาชิกและฝากถอน`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#ffd84d]">{BRAND_NAME} เป็นเว็บสล็อตฐานหลักที่นำเสนอช่องทางเข้าใช้งานเกมสล็อตออนไลน์</strong>
        พร้อมเมนูสำหรับสมัครสมาชิก ฝากถอน และตรวจสอบโปรโมชั่นไว้ในเว็บไซต์เดียว หน้านี้รวบรวมไว้ว่าเว็บไซต์จัดเตรียมอะไรไว้ให้ศึกษาบ้าง เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดดูอะไรตรงไหน แล้วจึงค่อยอ่านเงื่อนไขของแต่ละเรื่องเป็นรายข้อ
      </p>

      <p>
        จุดที่เว็บไซต์นี้เน้นคือความสะดวกในการเข้าใช้งานและการทำรายการถอนเงิน ผู้ใช้งานจึงควรศึกษาขั้นตอนทำรายการและ
        <strong class="text-[#ffd84d]">เงื่อนไขการถอนเงินก่อนเริ่มใช้งาน</strong>
        รวมถึงสอบถามเจ้าหน้าที่เมื่อพบปัญหา เพื่อให้ทราบว่ารายการที่ทำอยู่ต้องใช้ข้อมูลอะไรบ้างและใช้รอบเวลาเท่าไร
      </p>

      <p>
        เนื้อหาในหน้านี้เขียนไว้ประกอบการศึกษาเท่านั้น ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้งาน
        <strong class="text-[#ffd84d]">ส่วนข้อมูลเกี่ยวกับการจ่ายเงินจริง ความน่าเชื่อถือ และความคิดเห็นจากผู้ใช้งาน ควรตรวจสอบจากหลักฐานและรีวิวหลายแหล่งก่อนตัดสินใจ</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`${BRAND_NAME} การันตีเว็บแท้ ผู้ใช้งานหลักแสนยูสต่อวัน และสิ่งที่ยังต้องตรวจสอบ`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} เป็นเว็บไซต์ที่นำเสนอเกมสล็อตออนไลน์และบริการสำหรับสมาชิก โดยมีจุดเน้นเรื่อง
        <strong class="text-[#ffd84d]">ความสะดวกในการเข้าใช้งานและการทำรายการถอนเงิน</strong>
        ซึ่งเป็นสิ่งที่ผู้ใช้งานเปิดอ่านและตรวจสอบได้เองจากหน้าเว็บไซต์ทางการ ส่วนข้อความที่เป็นคำรับรองของเว็บไซต์เอง มีจุดที่ควรพิจารณาเพิ่มเติมดังนี้
      </p>

      <ul class="flex flex-col gap-3" aria-label={`ข้อความที่ ${BRAND_NAME} ระบุไว้และสิ่งที่ควรตรวจสอบประกอบ`}>
        <li class="flex gap-3">
          <span aria-hidden="true">🛡️</span>
          <span>
