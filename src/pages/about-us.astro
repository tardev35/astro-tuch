---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// กินดี365 เป็นเว็บ "หวยออนไลน์" ไม่ใช่คาสิโน/สล็อต — เนื้อหาทั้งหน้าจึงพูดเรื่องประเภทหวย
// ที่เปิดรับ อัตราจ่ายก่อนส่งโพย การฝากเครดิต และการเช็กประวัติรายการด้วยตัวเอง
// ทุกข้อความด้านล่างอ้างอิง src/assets/content.txt เท่านั้น ไม่มีการอ้างใบอนุญาต
// การจดทะเบียนบริษัท ปีที่ก่อตั้ง รางวัล จำนวนสมาชิก หรือการันตีผลกำไร
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 158
const pageDescription = "รู้จัก กินดี365 เว็บหวยออนไลน์ที่รวมหวยรัฐบาลไทย ลาวพัฒนา ฮานอย VIP และหุ้นต่างประเทศไว้ในบัญชีเดียว อัตราจ่าย 2 ตัวบาทละ 100 และ 3 ตัวบาทละ 1,000 ดูแล 24 ชม.";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ กินดี365 เว็บหวยออนไลน์ครบวงจรในบัญชีเดียว",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา กินดี365 เว็บหวยออนไลน์ครบวงจร จ่ายจริง เข้าไว ไม่หักเปอร์เซ็นต์" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ กินดี365 เว็บหวยออนไลน์ครบวงจรในบัญชีเดียว" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dbe4f5]">
        <strong class="text-[#fbeeb8]">กินดี365</strong> รวมบริการ<strong class="text-[#fbeeb8]">แทงหวยออนไลน์</strong>สำหรับคนที่ต้องการเลือกหวยหลายประเภทผ่านบัญชีเดียว
        มีทั้งหวยรัฐบาลไทย หวยลาวพัฒนา หวยฮานอย VIP และหวยหุ้นต่างประเทศ พร้อมอัตราจ่ายตามที่กำหนดคือเลข 2 ตัวบาทละ 100 และเลข 3 ตัวบาทละ 1,000
        สมาชิกตรวจสอบเรท เลือกเลข ส่งโพย และเช็กประวัติรายการได้ด้วยตัวเอง ใช้งานผ่านสมาร์ตโฟน แท็บเล็ต หรือคอมพิวเตอร์ก็ได้เหมือนกัน
      </p>

      <p class="text-left text-base leading-relaxed text-[#dbe4f5]">
        แนวคิดของเว็บคือทำให้ทุกขั้นตอนตรวจสอบได้ตั้งแต่ก่อนยืนยันรายการ ทั้งรอบที่เปิดรับ อัตราจ่ายที่ใช้คิดผล และประวัติบิลที่ย้อนกลับมาดูได้เสมอ
        ควบคู่กับ<strong class="text-[#fbeeb8]">การฝากเครดิตผ่านธนาคารและวอลเลท</strong>ที่ระบบเปิดรองรับ และเจ้าหน้าที่ที่ดูแลเรื่องฝากถอนตลอด 24 ชั่วโมง
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="หวยที่ กินดี365 เปิดรับ รัฐบาลไทย ลาวพัฒนา ฮานอย VIP หุ้นต่างประเทศ" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dbe4f5]">
        กินดี365 จัดหมวดหวยออนไลน์ไว้ให้เลือกตามรอบที่เปิดบริการ สมาชิกเลือกประเภทหวย รอบที่ต้องการ เลข 2 ตัวหรือ 3 ตัว
        แล้วระบุยอดเดิมพันผ่านมือถือได้โดยตรง <strong class="text-[#fbeeb8]">ก่อนยืนยันโพยควรตรวจสอบเวลาเปิด-ปิด อัตราจ่าย และรายละเอียดของเลขที่เลือกให้ครบ</strong>
        เพื่อป้องกันการส่งผิดรอบหรือผิดประเภท
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#dbe4f5]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e9c55d]">🇹🇭</span>
          <span><strong class="text-[#fbeeb8]">หวยรัฐบาลไทย</strong> ตลาดหลักที่คนไทยคุ้นเคยที่สุด ออกผลตามงวดที่ประกาศ เลือกเลข 2 ตัวหรือ 3 ตัวได้จากหน้าส่งโพยตามปกติ</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e9c55d]">🎱</span>
          <span><strong class="text-[#fbeeb8]">หวยลาวพัฒนา</strong> เป็นอีกตลาดที่เปิดรับตามรอบของตัวเอง ควรดูเวลาปิดรับของรอบนั้นก่อนส่งโพยทุกครั้ง</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e9c55d]">⭐</span>
          <span><strong class="text-[#fbeeb8]">หวยฮานอย VIP</strong> มีรอบถี่กว่าตลาดรายงวด จึงเหมาะกับคนที่อยากเลือกเลขได้บ่อยขึ้นในหนึ่งวัน</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e9c55d]">📈</span>
          <span><strong class="text-[#fbeeb8]">หวยหุ้นต่างประเทศ</strong> อ้างอิงรอบตลาดหุ้นที่ระบบเปิดรับ เวลาเปิด-ปิดจึงต่างจากหวยประเภทอื่นอย่างชัดเจน</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#a9c4e8]">
        แต่ละตลาดหวยอาจมีเวลาเปิดรับและเงื่อนไขต่างกัน จึงควรยึดรายละเอียดที่ระบบแสดงบนหน้าส่งโพยในรอบนั้นเป็นหลัก ไม่ใช่ตัวเลขที่จำมาจากรอบก่อนหน้า
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="อัตราจ่ายของ กินดี365 เลข 2 ตัวบาทละ 100 และเลข 3 ตัวบาทละ 1,000" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dbe4f5]">
        อัตราจ่ายเป็นข้อมูลสำคัญที่คนแทงหวยควรเห็นก่อนส่งโพย โดย กินดี365 กำหนดเรทไว้ที่
        <strong class="text-[#fbeeb8]">เลข 2 ตัว บาทละ 100</strong> และ<strong class="text-[#fbeeb8]">เลข 3 ตัว บาทละ 1,000</strong>
        ทำให้คำนวณยอดตามเรทได้ตั้งแต่ก่อนเดิมพัน
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#dbe4f5]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e9c55d]">2️⃣</span>
          <span>แทงเลข 2 ตัวจำนวน 10 บาท ด้วยเรท 1 ต่อ 100 หากผลตรงตามเงื่อนไข ยอดตามเรทจะเท่ากับ <strong class="text-[#fbeeb8]">1,000 บาท</strong></span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e9c55d]">3️⃣</span>
          <span>แทงเลข 3 ตัวจำนวน 10 บาท ด้วยเรท 1 ต่อ 1,000 หากผลตรงตามเงื่อนไข ยอดตามเรทจะเท่ากับ <strong class="text-[#fbeeb8]">10,000 บาท</strong></span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#a9c4e8]">
        ก่อนแทงควรตรวจสอบประเภทหวย เลขที่เลือก และอัตราจ่ายจริงในระบบอีกครั้ง เพราะเวลาเปิด-ปิด อัตราจ่าย และเงื่อนไขต่างกันตามประเภทหวยและรอบ ให้ยึดข้อมูลบนหน้าส่งโพยก่อนกดยืนยันเป็นหลัก
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ฝากเครดิตแทงหวย กินดี365 ได้ทุกช่องทาง ทั้งธนาคารและวอลเลท" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dbe4f5]">
        สมาชิก กินดี365 เติมเครดิตสำหรับแทงหวยผ่านช่องทางการเงินที่ระบบเปิดรองรับ ทั้ง<strong class="text-[#fbeeb8]">บัญชีธนาคารและวอลเลท</strong>
        สามารถตรวจสอบยอด ฝากเครดิต ส่งคำขอถอน และติดตามสถานะธุรกรรมผ่านบัญชีสมาชิกได้ด้วยตัวเอง ก่อนยืนยันรายการควรเช็กชื่อบัญชี จำนวนเงิน และช่องทางให้ถูกต้อง
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#dbe4f5]">
        <li class="flex gap-3"><span class="font-bold text-[#e9c55d]">1.</span> เปิดหน้าสมัคร กินดี365 และกรอกข้อมูลตามที่ระบบกำหนด ทำผ่านมือถือหรือคอมพิวเตอร์ได้โดยตรง</li>
        <li class="flex gap-3"><span class="font-bold text-[#e9c55d]">2.</span> เข้าสู่ระบบ แล้วฝากเครดิตผ่านธนาคารหรือวอลเลทที่ระบบรองรับ</li>
        <li class="flex gap-3"><span class="font-bold text-[#e9c55d]">3.</span> เลือกประเภทหวยและรอบที่ต้องการ ตรวจอัตราจ่ายกับเวลาปิดรับ แล้วจึงส่งโพย</li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#a9c4e8]">
        ส่วนธนาคาร วอลเลท วงเงิน และขั้นต่ำที่รองรับจริง ควรตรวจสอบจากหน้าฝากถอนล่าสุดอีกครั้ง เนื่องจากช่องทางและข้อกำหนดอาจแตกต่างกันในแต่ละช่วงเวลา
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="เจ้าหน้าที่ กินดี365 คอยแก้ปัญหาฝากถอนตลอด 24 ชั่วโมง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dbe4f5]">
        หากฝากเครดิตแล้วเงินไม่เข้า ถอนเงินแล้วรายการค้าง เข้าสู่ระบบไม่ได้ ส่งโพยไม่สำเร็จ หรือยอดในบิลไม่ตรง สามารถ
        <strong class="text-[#fbeeb8]">ติดต่อเจ้าหน้าที่ กินดี365 ได้ตลอด 24 ชั่วโมง</strong> แนะนำให้แจ้งเวลา จำนวนเงิน ประเภทหวย และรายละเอียดรายการให้ครบ
        เพื่อช่วยให้ค้นหาธุรกรรมได้ตรงจุด หากเป็นปัญหาเกี่ยวกับโพยควรเก็บข้อมูลบิลไว้จนกว่าการตรวจสอบจะเสร็จสิ้น และ<strong class="text-[#fbeeb8]">ไม่ควรเปิดเผยรหัสผ่านหรือ OTP แก่บุคคลอื่น</strong>
      </p>

      <p class="text-left text-base leading-relaxed text-[#a9c4e8]">
        การแทงหวยมีความเสี่ยงและผลของแต่ละรอบไม่แน่นอน ไม่มีเลขหรือรูปแบบใดรับประกันผลล่วงหน้า สมาชิกจึงควรกำหนดงบประมาณก่อนส่งโพยทุกครั้ง
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก กินดี365"
          class="flex items-center justify-center rounded-lg border border-[#e9c55d]/50 bg-gradient-to-r from-[#fbeeb8] via-[#e9c55d] to-[#7e5f1f] px-8 py-3 font-black text-[#00081f] shadow-[0_0_15px_rgba(233,197,93,0.4)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ กินดี365"
          class="flex items-center justify-center rounded-lg border border-[#e9c55d]/60 bg-transparent px-8 py-3 font-bold text-[#fbeeb8] transition-all hover:scale-105 hover:border-[#fbeeb8] hover:bg-[#062052]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
