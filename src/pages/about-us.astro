---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char, so a byte count reads
// ~3x too long). One string, reused by MainLayout's meta and the WebPage node.
const pageDescription =
  "รู้จัก JAIDEE928 สล็อตใจดีเว็บแท้ จ่ายตรง รวมค่ายเกมฮิตครบทุกแบรนด์ในบัญชีเดียว พร้อมโปรโมชั่นคืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% และแอดมินดูแลตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ JAIDEE928 สล็อตใจดีเว็บแท้ จ่ายตรง รวมค่ายเกมฮิตครบทุกแบรนด์",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา JAIDEE928 สล็อตใจดีเว็บแท้ จ่ายตรง รวมค่ายเกมฮิตครบทุกแบรนด์" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ JAIDEE928" as="h1">
    <p class="mb-6 text-left text-base leading-relaxed text-[#e4d9f5]">
      <strong class="text-[#d8a7ff]">JAIDEE928</strong> คือเว็บสล็อตออนไลน์ที่พร้อมให้บริการสมาชิกซึ่งต้องการเล่นเกมผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ได้ในระบบเดียว
      ภายในบัญชีเดียวรวม <strong class="text-[#d8a7ff]">เกมสล็อตจากหลากหลายค่าย ทั้งเกมยอดนิยม เกมใหม่ เกมโบนัส และสล็อตแจ็คพอต</strong>
      พร้อมโปรโมชั่น โบนัส และคอมมิชชั่นตามเงื่อนไขที่กำหนด ระบบฝากถอนอัตโนมัติช่วยให้ตรวจสอบและทำรายการได้สะดวก โดยมีแอดมินคอยให้คำแนะนำเกี่ยวกับการสมัคร ฝากถอน
      โปรโมชั่น และการใช้งานตลอด 24 ชั่วโมง
    </p>

    <p class="mb-2 text-left text-base leading-relaxed text-[#e4d9f5]">
      สิ่งที่ JAIDEE928 ให้ความสำคัญคือความชัดเจนของข้อมูล รายละเอียดของโบนัส เปอร์เซ็นต์ วิธีคำนวณ รอบการรับ และเงื่อนไขการถอนจะแสดงอยู่ในหน้ารายละเอียดโปรโมชั่นก่อนเข้าร่วมเสมอ
      สมาชิกควรอ่านเงื่อนไขตรงจุดนั้นทุกครั้ง เพราะข้อกำหนดของแต่ละรายการไม่เท่ากัน และมีทีมงานคอยให้คำแนะนำเมื่อพบปัญหาในการใช้งาน
    </p>
  </ContentBox>

  <ContentBoxPlain title="เว็บ JAIDEE928 สล็อตใจดีเว็บตรง รวมค่ายเกมฮิตสุดมันส์ครบทุกแบรนด์" as="h2">
    <p class="mb-2 text-left text-base leading-relaxed text-[#e4d9f5]">
      JAIDEE928 รวบรวมเกมสล็อตออนไลน์จากหลากหลายค่ายให้สมาชิกเลือกเล่นผ่านบัญชีเดียว มีทั้ง <strong class="text-[#d8a7ff]">เกมยอดนิยม เกมใหม่ เกมโบนัส และสล็อตแจ็คพอต</strong>
      พร้อมจัดหมวดหมู่ให้ค้นหาได้ง่าย รองรับการเล่นผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ โดยไม่ต้องสลับใช้งานหลายบัญชี
      ก่อนเริ่มเล่นสมาชิกสามารถตรวจสอบกติกา ฟีเจอร์ อัตราเดิมพัน และรายละเอียดของแต่ละเกม เพื่อเลือกเกมให้เหมาะกับรูปแบบการเล่นของตนเอง
    </p>
  </ContentBoxPlain>

  <ContentBoxPlain title="โปรโมชั่นคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ของ JAIDEE928" as="h2">
    <p class="mb-2 text-left text-base leading-relaxed text-[#e4d9f5]">
      สมาชิกสามารถติดตามโปรโมชั่น JAIDEE928 และสิทธิ์คอมมิชชั่นที่เปิดให้รับตามเงื่อนไขของแต่ละกิจกรรม โดยระบบจะแสดงรายละเอียดเกี่ยวกับ
      <strong class="text-[#d8a7ff]">เปอร์เซ็นต์ วิธีคำนวณ รอบการรับ และข้อกำหนดที่เกี่ยวข้อง</strong> ให้ตรวจสอบก่อนเข้าร่วมทุกครั้ง
    </p>

    <p class="mt-3 mb-2 text-left text-base leading-relaxed text-[#e4d9f5]">
      สำหรับ <strong class="text-[#d8a7ff]">โปรโมชั่นแนะนำเพื่อน รับโบนัสสูงสุด 0.8%</strong> สมาชิกสามารถแชร์ลิงก์แนะนำของตนเองและติดตามสิทธิ์ผ่านบัญชีสมาชิก ส่วน
      <strong class="text-[#d8a7ff]">โปรโมชั่นคืนยอดเสีย รับโบนัสสูงสุด 0.3%</strong> จะคำนวณตามยอดและประเภทเกมที่เข้าเงื่อนไข ทั้งนี้
      โบนัสหรือคอมมิชชั่นช่วยเพิ่มสิทธิประโยชน์ในการใช้งาน แต่ไม่สามารถรับประกันผลกำไรจากการเดิมพันได้
    </p>
  </ContentBoxPlain>

  <ContentBoxPlain title="ระบบฝากถอนอัตโนมัติ และแอดมิน JAIDEE928 ดูแลตลอด 24 ชั่วโมง" as="h2">
    <p class="mb-6 text-left text-base leading-relaxed text-[#e4d9f5]">
      <strong class="text-[#d8a7ff]">ระบบ JAIDEE928</strong> ออกแบบให้สมาชิกจัดการข้อมูลบัญชีและธุรกรรมผ่านหน้าเว็บไซต์ได้ด้วยตนเอง ทั้งเข้าสู่ระบบ ตรวจสอบเครดิต
      ฝากถอนผ่านระบบอัตโนมัติ และเลือกเกมสล็อตได้ตลอด 24 ชั่วโมง พร้อมแสดงประวัติรายการเพื่อให้ง่ายต่อการตรวจสอบ หากพบปัญหาเกี่ยวกับการสมัครสมาชิก การ Login เครดิตไม่เข้า
      ฝากถอนล่าช้า หรือการรับโบนัสและคอมมิชชั่น สามารถติดต่อ <strong class="text-[#d8a7ff]">แอดมิน JAIDEE928 ได้ตลอด 24 ชั่วโมง</strong>
      ทีมงานพร้อมช่วยตรวจสอบรายการและแนะนำขั้นตอนการใช้งาน ทั้งนี้ การพนันมีความเสี่ยงและไม่สามารถรับประกันผลกำไรได้ สมาชิกควรศึกษากติกาของแต่ละเกมและกำหนดงบประมาณก่อนเดิมพันทุกครั้ง
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก JAIDEE928"
        class="flex items-center justify-center rounded-lg bg-gradient-to-r from-[#e6e8ec] via-[#d8a7ff] to-[#a855f7] px-8 py-3 font-black text-[#0d0616] shadow-[0_0_15px_rgba(168,85,247,0.45)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ JAIDEE928"
        class="flex items-center justify-center rounded-lg border border-[#a855f7]/70 bg-transparent px-8 py-3 font-bold text-[#e4d9f5] transition-all hover:scale-105 hover:border-[#d8a7ff] hover:bg-[#0d0616]/70">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
