---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "รู้จัก UFASLOT เว็บสล็อตออนไลน์รวมเกมค่ายแท้ดั้งเดิมไว้ในบัญชีเดียว ปั่นง่ายแตกไว รองรับมือถือและคอมพิวเตอร์ พร้อมโบนัสคืนยอดเสีย 0.3% ทุกวัน ดูแลตลอด 24 ชม.";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ UFASLOT เว็บสล็อตออนไลน์ รวมเกมค่ายแท้ดั้งเดิม",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา UFASLOT เว็บสล็อตออนไลน์ รวมเกมค่ายแท้ดั้งเดิมทุกค่าย" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ UFASLOT" as="h1">
    <p class="mb-6 text-left text-base leading-relaxed text-[#f2e6cd]">
      <strong class="text-[#f5c518]">UFASLOT</strong> เป็นเว็บสล็อตออนไลน์ที่เปิดให้สมาชิกเข้าเล่นผ่านเว็บเบราว์เซอร์บนมือถือ แท็บเล็ต และคอมพิวเตอร์ได้โดยตรง ไม่ต้องติดตั้งโปรแกรมเพิ่มเติม ภายในบัญชีเดียวมีเกมสล็อตจากค่ายแท้ดั้งเดิมให้เลือกหลายค่าย ทั้งเกมยอดนิยม เกมโบนัส เกมแจ็คพอต และเกมที่อัปเดตเข้ามาใหม่อย่างต่อเนื่อง ระบบปรับการแสดงผลให้เหมาะกับขนาดหน้าจอ จึงค้นหาเกมและเข้าเล่นได้สะดวกตลอด 24 ชั่วโมง
    </p>

    <p class="mb-8 text-left text-base leading-relaxed text-[#f2e6cd]">
      ด้านสิทธิพิเศษ สมาชิกที่มียอดเสียตามเงื่อนไขของโปรโมชั่นสามารถรับโบนัสคืนยอดเสีย 0.3% ได้ทุกวัน โดยตรวจสอบยอดที่นำมาคำนวณ รอบเวลา และรายละเอียดการรับสิทธิ์ผ่านระบบสมาชิกก่อนกดรับทุกครั้ง หากพบปัญหาเรื่องการสมัครสมาชิก การเข้าสู่ระบบ การฝากถอน หรือการกดรับโบนัสคืนยอดเสีย สามารถติดต่อแอดมิน UFASLOT เพื่อขอคำแนะนำและตรวจสอบข้อมูลได้ตลอดเวลา
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก UFASLOT"
        class="flex items-center justify-center rounded-lg bg-gradient-to-r from-[#fff2c3] via-[#f5c518] to-[#b6821d] px-8 py-3 font-black text-[#1a1204] shadow-[0_0_15px_rgba(245,197,24,0.45)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ UFASLOT"
        class="flex items-center justify-center rounded-lg border border-[#d3d3d3]/70 bg-transparent px-8 py-3 font-bold text-[#f2e6cd] transition-all hover:scale-105 hover:border-[#f5c518] hover:bg-[#141009]/70">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
