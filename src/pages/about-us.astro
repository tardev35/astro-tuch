---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login,
// /register, /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจาก
// เช็กลิสต์หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ (src/assets/content.txt)
// ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึงเขียนขึ้นใหม่จากข้อเท็จจริงและ
// คลังคำของบรีฟรอบนี้เท่านั้น (brand-spec §6) ไม่ใช่การแก้ทับประโยคของแบรนด์ก่อน
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x4 · h3x0
//   h1  เกี่ยวกับเรา <แบรนด์> เว็บสอนเล่นเกมเดิมพันออนไลน์ จากเศรษฐีพนันมือ1
//   h2  หัวข้อบทเรียนที่ <แบรนด์> รวบรวมไว้ และสิ่งที่ควรอ่านก่อนเริ่มศึกษา
//   h2  โปรโมชั่น <แบรนด์> คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%
//   h2  สมัครเรียนเดิมพันจากเซียน <แบรนด์> ง่ายๆ 3 ขั้นตอน
//   h2  ช่องทางติดต่อแอดมิน <แบรนด์> ตลอด 24ชม.
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) จึงเปิดใช้งานอยู่
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// ตัวที่ routing จริงคือไฟล์นี้ Astro ไม่อ่านโฟลเดอร์นั้นเลย ห้ามแก้และห้ามลบ
//
// 🚨 แกนของดรอปนี้ (2026-10-20) คือ **เว็บสอนเล่นเกมเดิมพันออนไลน์หลายประเภท**
// (สล็อต บาคาร่า ยิงปลา ไฮโล บอล หวยออนไลน์) รวมสูตรและเทคนิคเป็นบทเรียน
// **ไม่ใช่เว็บกีฬา ไม่ใช่เว็บสล็อตเพียวๆ และไม่ใช่เว็บหวย** — หวยเป็นเพียง 1 ใน 6
// ประเภทเกมที่บรีฟเอ่ยถึง สองหน้าหมวดลอตเตอรีที่แบรนด์ก่อนๆ เคยเปิด จอดอยู่ใน
// src/pages-disabled/ ไม่มี route ห้ามลิงก์ไปหา เป็น href ตายที่ทำให้ build แดง
// route ที่มีจริงรอบนี้คือ / · /about-us · /contact-us · /login · /privacy ·
// /promotion · /register · /terms · /ทดลองเล่น · /ทางเข้า · /line
//
// ⚠️ แบรนด์ก่อนหน้าทันทีเป็น **เว็บกีฬา/ฟุตบอล** (ชื่อแบรนด์และคำแวดล้อมของมัน
// ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของ
// ไฟล์นี้เอง — รายการเต็มอยู่ใน brand-spec §6) โครงหัวข้อ "ดูเข้าเค้า" เพราะใช้
// สล็อตเดียวกัน แต่กรอบเนื้อหาคนละอันโดยสิ้นเชิง จึงเขียนใหม่ทั้งหน้า
// **ห้าม find-and-replace ทับประโยคเดิม** · คำว่า `บอล`/`ฟุตบอล` ยังใช้ได้เพราะ
// บรีฟรอบนี้ระบุเอง แต่คำแวดล้อมของเว็บกีฬารอบก่อนใช้ไม่ได้แม้แต่คำเดียว
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกมหรือผู้ให้บริการแม้แต่รายเดียว** จึงห้าม
// เขียนลงหน้าเว็บ และห้ามอ้างใบอนุญาต หน่วยงานกำกับ ชื่อนิติบุคคล ชื่อธนาคาร
// ค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีก่อตั้ง · ห้ามใช้คำว่า เว็บตรง /
// ไม่ผ่านเอเย่นต์ / คาสิโนสด / รูเล็ต
//
// คลังคำที่บรีฟรอบนี้ให้มาและใช้ได้เท่านี้ (brand-spec §6): เว็บสอนเล่นเกม
// ออนไลน์ · เกมเดิมพันออนไลน์ · สล็อต · บาคาร่า · ยิงปลา · ไฮโล · บอล/ฟุตบอล ·
// หวยออนไลน์ · สูตร · เทคนิค · กติกา · ความน่าจะเป็น · สัญลักษณ์ ·
// ตารางจ่ายรางวัล · ประเภทการเดิมพัน · อัตราจ่าย · เศรษฐีพนันมือ1 · ผู้สอน ·
// บทเรียน · หลักสูตร · หัวข้อเรียน · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% ·
// โบนัส · เครดิต · ยอดเสีย · รอบคำนวณยอด · ลิงก์แนะนำ · เชื่อมโยงบัญชี ·
// สมัครสมาชิก · ลงทะเบียน · ข้อมูลส่วนบุคคล · รหัสผ่าน · รหัส OTP · เจ้าหน้าที่ ·
// แอดมิน · 24ชม. · ช่องทางทางการ · เว็บไซต์ทางการ · ประกาศล่าสุด
//
// ตัวเลขที่อ้างได้มีแค่สี่ตัวของบรีฟเอง: 0.3% · 0.8% · 24ชม. · 3 ขั้นตอน
//
// ⚠️ คำโฆษณาของบรีฟ ("รับได้ไม่จำกัดยูส" · "จากเศรษฐีพนันมือ1") อยู่ได้เฉพาะใน
// หัวข้อที่บรีฟเขียนไว้เอง ห้ามขยายเป็นคำกล่าวอ้างใหม่
//
// 🚨 บรีฟรอบนี้ **โฆษณากับกำกับความเสี่ยงอยู่ในย่อหน้าเดียวกัน** ประโยคกำกับ
// ทุกประโยคต้องขึ้นครบ เป็นเนื้อหาของบรีฟ ไม่ใช่ filler ให้ตัดทิ้ง:
// 1) คำกล่าวอ้างเกี่ยวกับผู้สอนระดับมือหนึ่งควรตรวจสอบประสบการณ์และผลงานจาก
//    หลักฐานที่เชื่อถือได้ (h1)
// 2) เทคนิคต่าง ๆ ควรใช้เพื่อทำความเข้าใจเกม ไม่ใช่สูตรรับประกันชัยชนะ ·
//    ผลการเดิมพันมีความไม่แน่นอนและอาจทำให้สูญเสียเงินได้ (h1, h2 #1)
// 3) การคืนยอดเสียไม่ได้รับประกันว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือช่วยลด
//    ความเสี่ยงทั้งหมด (h2 #2)
// 4) แม้โปรโมชั่นจะระบุว่าไม่จำกัด แต่ควรยืนยันข้อกำหนดเกี่ยวกับจำนวนบัญชีที่
//    เข้าร่วม รอบจ่ายเครดิต และเงื่อนไขการใช้งานจากประกาศล่าสุด (h2 #2)
// 5) ไม่ควรเชื่อคำโฆษณาที่รับประกันผลกำไรจากการเดิมพัน ·
//    ไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น (h2 #3, #4)
// 6) ตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชี
//    แอบอ้าง · ควรยืนยันเวลาการให้บริการจริงจากประกาศล่าสุดอีกครั้ง (h2 #4)
//
// พาเลตรอบนี้ (brand-spec §2) เป็น **ทองน้ำผึ้ง + แดงชาดจีน บนพื้นดำสนิท**
// ⚠️ **ทองเคยนำมาแล้วเกือบทุกแบรนด์ และแดงเคยนำมาแล้วหลายแบรนด์** "เจอทองหรือ
// แดงอยู่แล้ว" จึงไม่ใช่ตัวบอกว่าถูกแบรนด์ ให้เทียบเป็น **"ค่า"** ทีละตัวกับ
// ตารางใน brand-spec §2 ไม่ใช่ด้วยตา (ค่าของแบรนด์เก่าไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้
// grep หาสีแบรนด์เก่าเจอ false positive ในไฟล์นี้เอง)
// ค่าที่ใช้ได้ในไฟล์นี้: ทองน้ำผึ้ง #f0c878 (หัวข้อ/<strong>/พื้นถม CTA) ·
// งาช้าง #fff8d8 (เนื้อความ = BRAND_TEXT) · หมึก #2a0608 (ตัวอักษรบนพื้นถมทอง) ·
// แดงชาดจีน #d9212a และแดงเลือดหมู #8e1a16 · ผิวการ์ด #4e2120 / ชั้นกลาง #300605 /
// ชั้นจม #150303 / พื้นเพจ #000000
// 🚨 **แดงทั้งสองเฉดห้ามถือตัวอักษรทุกขนาด** (d9212a ได้ 2.69:1 บนผิวการ์ดและ
// 4.20:1 บนพื้นเพจ · 8e1a16 ต่ำกว่านั้นทุกพื้น) ทั้งคู่เป็น **พื้นถม / ขอบ /
// ออรา / ไอคอนเท่านั้น** ถ้าต้องการตัวอักษรที่อ่านว่า "แดง" ให้ถมแดง #d9212a
// เป็นพื้นแล้ววางงาช้าง #fff8d8 ทับ (4.68:1 ผ่าน AA) — ปุ่มเข้าสู่ระบบในไฟล์นี้
// ทำแบบนั้น และปลายเข้ม #8e1a16 ของมันได้ 8.5:1 กับงาช้าง
// ออราที่อนุญาต: rgba(240,200,120,α) · rgba(217,33,42,α) · rgba(142,26,22,α)
// ⚠️ รอบนี้ไม่มีฟ้า/น้ำเงิน ไม่มีม่วง ไม่มีเขียว (นอกจาก LINE) ไม่มีเงิน/โครเมียม
// ไม่มีโรสโกลด์ ไม่มีชมพู/ฟูเชีย ไม่มีส้มสด และ **ไม่มีบรอนซ์** (บรอนซ์เป็นสีที่
// สามของรอบก่อน) · #00B900 บนปุ่ม LINE เป็นสีประจำแพลตฟอร์ม ไม่ใช่สีของเว็บ
//
// ลำดับปุ่มในไฟล์นี้สื่อด้วย "พื้นถมทอง vs พื้นถมแดง vs ผิวจมขอบทองโปร่ง":
// · ปุ่มหลัก (สมัครสมาชิก) ถมทอง #f0c878 หมึก #2a0608 (11.74:1) ขอบ #8e1a16
// · ปุ่มรอง (เข้าสู่ระบบ) ถมไล่เฉด #d9212a → #8e1a16 ตัวอักษรงาช้าง #fff8d8
// · ปุ่มลิงก์ภายในเป็นชั้นจม #150303 ขอบทองโปร่ง ตัวอักษรงาช้าง (19.0:1)
//   hover ยกขอบเป็นทองทึบ (ตรงกับ hover ของการ์ด ContentBox)
// · ชิปไอคอนของรายการบทเรียนใช้แดงเลือดหมูเป็น **เส้นขอบ** บนชั้นกลาง #300605
//   ไม่ถือตัวอักษร
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT
// #fff8d8, 12.59:1 บนผิวยก #4e2120) ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่
// ประกาศสีของตัวเอง ปล่อยให้สืบทอดลงมา และไม่ใส่ mx-auto / max-w-* บน <p> เพราะ
// การ์ดคุมความกว้างเองแล้ว (เพิ่มไปจะเหมือนย่อหน้าเยื้อง) — ที่ประกาศสีได้มีแค่
// ปุ่ม (ถมพื้นของตัวเองจึงต้องกำหนดหมึกของตัวเอง) ชิปไอคอน marker ของลำดับเลข
// และ <strong> ซึ่ง brand-spec §2 สงวนทองน้ำผึ้ง #f0c878 (8.47:1 บนผิวการ์ด)
// ไว้เป็นสีไฮไลต์ในเนื้อความเพียงสีเดียว · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วย
// ช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ
// บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง (ลบแท็ก <strong> ออกแล้วคอปปี้ต้องอ่านได้
// เหมือนเดิม) และห้ามวาง <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังใน prop ที่เป็นข้อความ
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: ดรอปนี้ (brand-spec §5) ไม่มี article illustration
// เลย ส่วน slide1/slide2 ถูกตรึงไว้กับ index กับ /promotion และ banner1 /
// banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// banner2/banner3 และ slide3/slide4 เป็นอาร์ตเวิร์กของแบรนด์คนละราย ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้หมุนมาเป็น Announcement5 ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ Announcement3 จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็น
// คอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare **ห้ามส่ง prop message** มิฉะนั้น
// ตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 155 อักขระ เป็นประโยคเดียวที่บอกว่าหน้านี้มีอะไร แล้วหยุด
// (Google ตัดราว 155 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนยาวเกิน)
//
// ห้ามให้สตริงนี้มีชื่อของสองหน้าหมวดลอตเตอรีที่จอดอยู่ใน src/pages-disabled/
// (ชื่อไฟล์ทั้งสองอยู่ใน brand-spec §7) เพราะ sweep ของรอบถัดไปจะอ่านเป็น
// false positive ว่ายังมีลิงก์ไปหน้าที่ไม่มี route
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} เว็บสอนเล่นเกมเดิมพันออนไลน์ สล็อต บาคาร่า ยิงปลา ไฮโล บอล หวยออนไลน์ รวมสูตรและเทคนิค พร้อมโปรโมชั่นและช่องทางติดต่อแอดมิน 24ชม.`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} เว็บสอนเล่นเกมเดิมพันออนไลน์ จากเศรษฐีพนันมือ1`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#f0c878]">{BRAND_NAME} รวบรวมเนื้อหาสำหรับผู้ที่ต้องการเรียนรู้เกี่ยวกับเกมเดิมพันออนไลน์หลายประเภท</strong>
        ตั้งแต่สล็อต บาคาร่า ยิงปลา ไฮโล ไปจนถึงบอลและหวยออนไลน์ โดยมีคำอธิบายกติกา รูปแบบการเดิมพัน และแนวทางศึกษาความเสี่ยงของแต่ละเกมไว้ในที่เดียว หน้านี้รวบรวมไว้ว่าเว็บไซต์ระบุอะไรไว้บ้าง
        เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดอ่านอะไรตรงไหน แล้วจึงค่อยไล่อ่านรายละเอียดของแต่ละหัวข้อเป็นรายข้อ
      </p>

      <p>
        ผู้เริ่มต้นสามารถใช้ข้อมูลประกอบการทำความเข้าใจระบบเกมได้
        <strong class="text-[#f0c878]">ส่วนคำกล่าวอ้างเกี่ยวกับผู้สอนระดับมือหนึ่งควรตรวจสอบประสบการณ์และผลงานจากหลักฐานที่เชื่อถือได้</strong>
        เพราะบทเรียนที่อ่านแล้วเข้าใจ กับผลที่เกิดขึ้นจริงเมื่อลงเดิมพัน เป็นสองเรื่องที่แยกจากกัน
      </p>

      <p>
        เนื้อหาในหน้านี้เขียนไว้ประกอบการศึกษาเท่านั้น ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้งาน
        <strong class="text-[#f0c878]">และเทคนิคที่อธิบายไว้ควรใช้เพื่อทำความเข้าใจเกม ไม่ใช่สูตรรับประกันชัยชนะ</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`หัวข้อบทเรียนที่ ${BRAND_NAME} รวบรวมไว้ และสิ่งที่ควรอ่านก่อนเริ่มศึกษา`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} รวบรวมเนื้อหาเกี่ยวกับเกมเดิมพันหลายรูปแบบไว้เป็นบทเรียนแยกตามประเภทเกม
        <strong class="text-[#f0c878]">โดยแต่ละเกมใช้คนละกติกาและคนละชุดข้อมูลในการทำความเข้าใจ</strong>
        จึงควรดูว่าหัวข้อที่สนใจอธิบายอะไรไว้แล้ว และต้องศึกษาส่วนใดเพิ่มเติมด้วยตนเอง
      </p>

      <ul class="flex flex-col gap-4" aria-label="หัวข้อบทเรียนแยกตามประเภทเกมที่เว็บไซต์ระบุไว้">
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#8e1a16] bg-[#300605] text-sm">🎰</span>
          <span>
            <strong class="text-[#f0c878]">สล็อต</strong> เน้นการทำความเข้าใจสัญลักษณ์และตารางจ่ายรางวัล ซึ่งแต่ละเกมกำหนดไว้ไม่เหมือนกัน จึงควรอ่านตารางของเกมนั้นเองก่อนทุกครั้ง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#8e1a16] bg-[#300605] text-sm">🃏</span>
          <span>
            <strong class="text-[#f0c878]">บาคาร่า</strong> อธิบายกติกาและความน่าจะเป็นของแต่ละประเภทการเดิมพัน เพื่อให้เห็นว่าอัตราจ่ายที่ระบุไว้สัมพันธ์กับโอกาสที่เกิดขึ้นอย่างไร
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#8e1a16] bg-[#300605] text-sm">🎲</span>
          <span>
            <strong class="text-[#f0c878]">ยิงปลาและไฮโล</strong> มีรูปแบบการเล่นแตกต่างกัน จึงควรแยกศึกษาเป็นรายเกม ไม่นำวิธีของเกมหนึ่งไปใช้กับอีกเกมหนึ่ง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#8e1a16] bg-[#300605] text-sm">🎯</span>
          <span>
            <strong class="text-[#f0c878]">บอลและหวยออนไลน์</strong> ต้องศึกษาประเภทการเดิมพันและอัตราจ่ายให้ชัดเจน เพราะแต่ละรายการกำหนดเงื่อนไขและวิธีคิดรางวัลไว้คนละแบบ
          </span>
        </li>
      </ul>

      <p>
        ก่อนเริ่มศึกษาหัวข้อใด ควรกำหนดงบไว้ล่วงหน้าและยึดตามที่ตั้งไว้ ไม่ปรับเพิ่มระหว่างใช้งาน
        <strong class="text-[#f0c878]">โดยเทคนิคต่าง ๆ ควรใช้เพื่อทำความเข้าใจเกม ไม่ใช่สูตรรับประกันชัยชนะ</strong>
        เพราะผลการเดิมพันมีความไม่แน่นอนและอาจทำให้สูญเสียเงินได้
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} นำเสนอข้อมูลโปรโมชั่นสำหรับสมาชิกที่สนใจตรวจสอบสิทธิพิเศษจากการใช้บริการ โดยรายการหลักที่ระบุไว้ประกอบด้วย
        <strong class="text-[#f0c878]">รายการคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8%</strong>
        ซึ่งแต่ละรายการอาจกำหนดเงื่อนไขเกี่ยวกับประเภทเกม ยอดที่ใช้คำนวณเครดิต และช่วงเวลารับสิทธิ์แตกต่างกัน จึงควรอ่านรายละเอียดจากประกาศล่าสุด รวมถึงตรวจสอบข้อจำกัดจำนวนบัญชีและการใช้โปรโมชั่นร่วมกันก่อนเข้าร่วม
      </p>

      <p>
        รายการคืนยอดเสียระบุการคืนเครดิตตามยอดเสียที่เข้าเงื่อนไขในแต่ละวัน
        <strong class="text-[#f0c878]">สมาชิกควรตรวจสอบว่าเกมประเภทใดร่วมรายการ มีรอบคำนวณยอดเมื่อใด และต้องกดรับเครดิตด้วยตนเองหรือไม่</strong>
        รวมถึงศึกษาข้อกำหนดเกี่ยวกับการนำเครดิตไปใช้และการถอนเงินก่อนเข้าร่วม หากมีข้อสงสัยสามารถสอบถามเจ้าหน้าที่เพื่อยืนยันรายละเอียดล่าสุดได้ ทั้งนี้
        การคืนยอดเสียไม่ได้รับประกันว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือช่วยลดความเสี่ยงทั้งหมด
      </p>

      <p>
        ส่วนรายการแนะนำเพื่อนระบุสิทธิ์ไว้สำหรับสมาชิกที่แนะนำผู้ใช้งานรายใหม่ โดยควรตรวจสอบวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และยอดที่ใช้คำนวณโบนัสให้ครบถ้วน
        <strong class="text-[#f0c878]">แม้โปรโมชั่นจะระบุว่าไม่จำกัด แต่ควรยืนยันข้อกำหนดเกี่ยวกับจำนวนบัญชีที่เข้าร่วม รอบจ่ายเครดิต และเงื่อนไขการใช้งานจากประกาศล่าสุด</strong>
        เพื่อให้เข้าใจหลักเกณฑ์การรับสิทธิ์ และหลีกเลี่ยงความคลาดเคลื่อนเกี่ยวกับยอดโบนัสที่จะได้รับ
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/promotion"
          aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#f0c878]/45 bg-[#150303] px-8 py-3 font-bold text-[#fff8d8] shadow-[0_0_12px_rgba(142,26,22,0.5)] transition-all hover:scale-105 hover:border-[#f0c878] hover:shadow-[0_0_18px_rgba(240,200,120,0.4)]">
          ดูภาพโปรโมชั่น
        </a>

        <a
          href="/ทดลองเล่น"
          aria-label={`เปิดหน้าทดลองเล่นของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#f0c878]/45 bg-[#150303] px-8 py-3 font-bold text-[#fff8d8] shadow-[0_0_12px_rgba(142,26,22,0.5)] transition-all hover:scale-105 hover:border-[#f0c878] hover:shadow-[0_0_18px_rgba(240,200,120,0.4)]">
          ไปหน้าทดลองเล่น
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`สมัครเรียนเดิมพันจากเซียน ${BRAND_NAME} ง่ายๆ 3 ขั้นตอน`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        ผู้ที่สนใจเนื้อหาสอนเล่นเกมออนไลน์สามารถตรวจสอบรายละเอียดการสมัครและรูปแบบการเรียนรู้จากช่องทางทางการ
        <strong class="text-[#f0c878]">โดยควรอ่านเงื่อนไขให้ครบถ้วนก่อนลงทะเบียน และตรวจสอบว่ามีหลักสูตรหรือผู้สอนตามที่กล่าวอ้างจริงหรือไม่</strong>
        เพื่อให้เข้าใจรายละเอียดที่จำเป็นตั้งแต่เริ่มต้น ส่วนข้อจำกัดอื่นของการสมัครควรตรวจสอบจากประกาศของผู้ให้บริการโดยตรง
      </p>

      <ol class="ml-6 list-decimal space-y-3 marker:font-black marker:text-[#f0c878]">
        <li>
          <strong class="text-[#f0c878]">ตรวจสอบช่องทางสมัครเรียนรู้</strong> เข้าสู่เว็บไซต์ทางการและค้นหาข้อมูลเกี่ยวกับเนื้อหาการสอน รูปแบบบทเรียน รวมถึงรายละเอียดผู้จัดทำเนื้อหา ก่อนเลือกหัวข้อที่สนใจ
        </li>
        <li>
          <strong class="text-[#f0c878]">ศึกษาเงื่อนไขและลงทะเบียน</strong> อ่านข้อกำหนดเกี่ยวกับการสมัคร การใช้ข้อมูลส่วนบุคคล และค่าใช้จ่ายที่อาจเกี่ยวข้อง หากมีการลงทะเบียนควรกรอกข้อมูลที่ถูกต้อง
          ตั้งรหัสผ่านที่ปลอดภัย และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น
        </li>
        <li>
          <strong class="text-[#f0c878]">เริ่มศึกษากติกาและความเสี่ยง</strong> เลือกศึกษาหัวข้อเกี่ยวกับสล็อต บาคาร่า ยิงปลา ไฮโล บอล หรือหวยออนไลน์ โดยเริ่มจากกติกาพื้นฐาน ความน่าจะเป็น
          และข้อจำกัดของแต่ละเกม ไม่ควรเชื่อคำโฆษณาที่รับประกันผลกำไรจากการเดิมพัน
        </li>
      </ol>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#8e1a16] bg-[#f0c878] px-8 py-3 font-black text-[#2a0608] shadow-[0_0_14px_rgba(240,200,120,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#f0c878]/45 bg-gradient-to-b from-[#d9212a] to-[#8e1a16] px-8 py-3 font-bold text-[#fff8d8] shadow-[0_0_12px_rgba(217,33,42,0.45)] transition-transform hover:scale-105">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`ช่องทางติดต่อแอดมิน ${BRAND_NAME} ตลอด 24ชม.`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} ระบุช่องทางติดต่อเจ้าหน้าที่สำหรับผู้ที่ต้องการสอบถามเกี่ยวกับเนื้อหาการสอน การสมัครสมาชิก โปรโมชั่น และปัญหาการใช้งาน
        <strong class="text-[#f0c878]">โดยควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง</strong>
        หากต้องการสอบถามรายละเอียดหลักสูตร ควรขอข้อมูลเกี่ยวกับหัวข้อเรียน ผู้สอน และเงื่อนไขค่าใช้จ่ายให้ชัดเจนก่อนตัดสินใจ รวมถึงไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น
      </p>

      <p>
        <strong class="text-[#f0c878]">ทั้งนี้ ควรยืนยันเวลาการให้บริการจริงจากประกาศล่าสุดอีกครั้ง</strong>
        เพราะช่วงเวลาที่เจ้าหน้าที่รับเรื่องและระยะเวลาตอบกลับอาจปรับเปลี่ยนได้ตามที่ผู้ให้บริการกำหนด
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/line"
          aria-label={`ติดต่อเจ้าหน้าที่ ${BRAND_NAME} ผ่าน Line Official`}
          class="flex items-center justify-center gap-2 rounded-lg border border-[#00B900] bg-[#00B900] px-8 py-3 font-black text-white shadow-[0_0_15px_rgba(0,185,0,0.35)] transition-transform hover:scale-105">
          <span aria-hidden="true">💬</span>
          ติดต่อผ่าน Line Official
        </a>

        <a
          href="/contact-us"
          aria-label={`ดูช่องทางติดต่อทีมงาน ${BRAND_NAME} ทั้งหมด`}
          class="flex items-center justify-center rounded-lg border border-[#f0c878]/45 bg-[#150303] px-8 py-3 font-bold text-[#fff8d8] shadow-[0_0_12px_rgba(142,26,22,0.5)] transition-all hover:scale-105 hover:border-[#f0c878] hover:shadow-[0_0_18px_rgba(240,200,120,0.4)]">
          ช่องทางติดต่อทั้งหมด
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
