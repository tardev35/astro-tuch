---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char, so a byte count reads
// ~3x too long). One string, reused by MainLayout's meta and the WebPage node.
const pageDescription =
  "รู้จัก HENGDEE89 เว็บพนันออนไลน์ที่1 ในไทย รวมสล็อต บาคาร่า คาสิโนสด รูเล็ต หวย กีฬาไว้ในบัญชีเดียว คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% ฝากถอนออโต้ แอดมิน 24 ชม.";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ HENGDEE89 เว็บพนันออนไลน์รวมครบทุกการเดิมพัน",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา HENGDEE89 เว็บพนันออนไลน์ที่1 ในไทย รวมครบทุกการเดิมพัน" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ HENGDEE89" as="h1">
    <p class="mb-6 text-left text-base leading-relaxed text-[#f7e4dc]">
      <strong class="text-[#ffe98a]">HENGDEE89</strong> ให้บริการสมาชิกที่ต้องการเล่นเกมพนันออนไลน์ผ่านมือถือและคอมพิวเตอร์ โดยรวบรวม
      <strong class="text-[#ffe98a]">เกมเดิมพันหลายประเภทไว้ภายในบัญชีเดียว</strong> ทั้งเกมสล็อต บาคาร่า คาสิโนสด รูเล็ต เสือมังกร เกมไพ่ หวย และการเดิมพันกีฬา
      พร้อมระบบฝากถอนอัตโนมัติที่ช่วยให้ทำรายการได้สะดวก และมีแอดมินคอยดูแลการใช้งานตลอด 24 ชั่วโมง
    </p>

    <p class="mb-2 text-left text-base leading-relaxed text-[#f7e4dc]">
      สิ่งที่ HENGDEE89 ให้ความสำคัญคือความชัดเจนของข้อมูล ทั้งเปอร์เซ็นต์โบนัส วิธีคำนวณ รอบการรับสิทธิ์ และเงื่อนไขการถอน จะแสดงอยู่ในหน้ารายละเอียดโปรโมชั่นก่อนเข้าร่วมเสมอ
      สมาชิกควรอ่านเงื่อนไขตรงจุดนั้นทุกครั้ง เพราะข้อกำหนดของแต่ละรายการไม่เท่ากัน และมีทีมงานคอยให้คำแนะนำเมื่อพบปัญหาในการใช้งาน
    </p>
  </ContentBox>

  <ContentBoxPlain title="เว็บพนัน HENGDEE89 รวมเกมครบทุกการเดิมพันออนไลน์" as="h2">
    <p class="mb-2 text-left text-base leading-relaxed text-[#f7e4dc]">
      สมาชิกสามารถเลือกเกมเดิมพันออนไลน์ได้หลากหลายหมวดหมู่ ไม่ว่าจะเป็น <strong class="text-[#ffe98a]">เกมสล็อต บาคาร่า คาสิโนสด รูเล็ต เสือมังกร เกมไพ่ หวย และการเดิมพันกีฬา</strong>
      โดยระบบจัดหมวดหมู่ให้ค้นหาได้ง่าย รองรับการเข้าใช้งานผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ ช่วยให้เลือกเดิมพันได้ตามความสนใจผ่านบัญชีเดียว
      ก่อนเริ่มเดิมพันควรตรวจสอบกติกา อัตราการจ่าย และเงื่อนไขของเกมแต่ละประเภท เนื่องจากรายละเอียดและรูปแบบการเดิมพันอาจแตกต่างกัน
    </p>
  </ContentBoxPlain>

  <ContentBoxPlain title="โปรโมชั่น HENGDEE89 คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%" as="h2">
    <p class="mb-2 text-left text-base leading-relaxed text-[#f7e4dc]">
      HENGDEE89 มีโปรโมชั่นสำหรับสมาชิกที่เข้าเงื่อนไข โดยสามารถตรวจสอบสิทธิ์และกดรับโบนัสผ่านระบบสมาชิก โปรโมชั่นแต่ละรายการจะแสดงรายละเอียดเกี่ยวกับ
      <strong class="text-[#ffe98a]">เปอร์เซ็นต์ วิธีคำนวณ รอบรับโบนัส และข้อกำหนดที่เกี่ยวข้อง</strong> เพื่อให้สมาชิกตรวจสอบก่อนเข้าร่วม
    </p>

    <p class="mt-3 mb-2 text-left text-base leading-relaxed text-[#f7e4dc]">
      สำหรับ <strong class="text-[#ffe98a]">โปรโมชั่นคืนยอดเสียทุกวัน 0.3%</strong> ระบบจะแสดงยอดที่นำมาคำนวณและโบนัสที่รับได้ตามรอบที่กำหนด ควรตรวจสอบประเภทเกมที่ร่วมรายการและเงื่อนไขการถอนก่อนกดรับ ส่วน
      <strong class="text-[#ffe98a]">โปรโมชั่นแนะนำเพื่อน โบนัส 0.8%</strong> สมาชิกคัดลอกลิงก์แนะนำของตนเองไปแชร์ให้เพื่อนสมัคร เมื่อมียอดการใช้งานตรงตามเงื่อนไข ระบบจะคำนวณโบนัสให้และติดตามยอดได้ผ่านบัญชีของตนเอง
    </p>
  </ContentBoxPlain>

  <ContentBoxPlain title="ฝากถอนอัตโนมัติ และแอดมิน HENGDEE89 ดูแลตลอด 24 ชั่วโมง" as="h2">
    <p class="mb-6 text-left text-base leading-relaxed text-[#f7e4dc]">
      <strong class="text-[#ffe98a]">ระบบ HENGDEE89</strong> ออกแบบให้สมาชิกจัดการข้อมูลบัญชีและธุรกรรมผ่านหน้าเว็บไซต์ได้ด้วยตนเอง ทั้งเข้าสู่ระบบ ตรวจสอบเครดิต
      ฝากถอนผ่านระบบอัตโนมัติ และเลือกหมวดหมู่เกมได้ตลอด 24 ชั่วโมง พร้อมแสดงประวัติรายการเพื่อให้ง่ายต่อการตรวจสอบ หากพบปัญหาเกี่ยวกับการสมัครสมาชิก การเข้าสู่ระบบ ฝากเงิน ถอนเงิน
      เครดิตไม่เข้า การรับโปรโมชั่น หรือการเข้าเล่นเกม สามารถติดต่อ <strong class="text-[#ffe98a]">แอดมิน HENGDEE89 ได้ตลอด 24 ชั่วโมง</strong>
      ทีมงานพร้อมช่วยตรวจสอบรายการและแนะนำขั้นตอนการใช้งาน ทั้งนี้ การเดิมพันมีความเสี่ยงและไม่สามารถรับประกันผลกำไรได้ ควรศึกษากติกาของแต่ละเกมและกำหนดงบประมาณก่อนเล่นทุกครั้ง
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก HENGDEE89"
        class="flex items-center justify-center rounded-lg bg-gradient-to-r from-[#f5322e] via-[#ffe98a] to-[#fdd32d] px-8 py-3 font-black text-[#1c0707] shadow-[0_0_15px_rgba(253,211,45,0.45)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ HENGDEE89"
        class="flex items-center justify-center rounded-lg border border-[#fdd32d]/70 bg-transparent px-8 py-3 font-bold text-[#f7e4dc] transition-all hover:scale-105 hover:border-[#ffe98a] hover:bg-[#1c0707]/70">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
