---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login, /register,
// /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx
// ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึง
// เขียนขึ้นใหม่บนข้อเท็จจริงของบรีฟรอบนี้เท่านั้น (src/assets/content.txt)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) จึงเปิดใช้งานอยู่ และรอบนี้ operator สั่งให้
// คงไว้ ไม่ได้ park ลง src/pages-disabled/
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// ตัวที่ routing จริงคือไฟล์นี้ Astro ไม่อ่านโฟลเดอร์นั้นเลย ห้ามแก้และห้ามลบ
//
// ⚠️ ดรอปนี้ (2026-10-13, TSDET911) คือ **คาสิโน + กีฬา: บาคาร่า · ไฮโล · สล็อต ·
// แทงบอล** ไม่ใช่เว็บสล็อตล้วน ไม่ใช่เว็บกีฬาล้วน และไม่ใช่เว็บหมวดลอตเตอรี
// (สองหน้าของหมวดนั้นจอดอยู่ใน src/pages-disabled/ ไม่มี route ห้ามลิงก์ไปหา
// เป็น href ตายที่ทำให้ build แดง) หน้าเดิมทั้งหน้าเขียนบนกรอบของแบรนด์ก่อน (KMD88)
// ซึ่งเกือบทุกคำนามเป็นศัพท์ที่ brand-spec §7 สั่งห้ามรอบนี้ (ไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาคำต้องห้ามเจอ false positive) จึงเขียนใหม่ทั้งหน้า ไม่ใช่
// find-and-replace ทับประโยคเดิม
//
// แง่มุมที่บรีฟรอบนี้ระบุไว้มีเท่านี้ (ห้ามเติมอย่างอื่น): เว็บพนันลิขสิทธิ์ไทยแท้ ·
// ผ่านเซิร์ฟไทย 100% · ระบบเข้าเดิมพันผ่านเว็บไซต์ · รองรับบาคาร่า ไฮโล สล็อต
// แทงบอล · จัดหมวดเกมให้เลือกใช้งานผ่านมือถือและคอมพิวเตอร์ · ตรวจสอบข้อมูลเกม
// ยอดเดิมพัน และรายการต่างๆ ผ่านบัญชีเดียว · บาคาร่าเป็นเกมไพ่ที่มีตัวเลือกการ
// เดิมพันตามกติกา · ไฮโลใช้ผลจากลูกเต๋าเป็นตัวตัดสิน · สล็อตมีทั้งเกมวงล้อทั่วไป
// และเกมที่มีฟีเจอร์โบนัส · แทงบอลมีรายการแข่งขันพร้อมข้อมูลอัตราต่อรอง ·
// ไม่มีขั้นต่ำ · กติกา ตารางจ่าย เงื่อนไขการตัดสินผล · คืนยอดเสีย 0.3% เข้ายูสทุกวัน ·
// รอบประจำวัน เวลาตัดยอด ยอดที่เข้าเกณฑ์ · แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด ·
// ลิงก์แนะนำ · แอดมิน 24 ชั่วโมง ช่องทางหลัก · ชื่อเกม ค่าย เวลาที่เกิดเหตุ ·
// คู่แข่งขัน หมายเลขรายการ · PIN · OTP
//
// ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 24 ชั่วโมง (บวก 100% ที่บรีฟเขียน
// ไว้เองคู่กับ "ผ่านเซิร์ฟไทย") ห้ามเติมเลขใบอนุญาต หน่วยงานกำกับ ชื่อผู้ดำเนินงาน
// ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีที่ก่อตั้ง
//
// ประโยคกำกับที่บรีฟเขียนไว้เองและห้ามตัดทิ้งเพราะฟังดูไม่ขายของ — ขนมาครบ:
// ส่วนการกล่าวอ้างว่าเป็นเว็บลิขสิทธิ์ไทยแท้และใช้เซิร์ฟเวอร์ในประเทศไทย 100%
// ควรมีข้อมูลใบอนุญาตและผู้ให้บริการระบบที่ตรวจสอบได้ประกอบ (h1 ย่อหน้าท้าย) ·
// การเดิมพันทุกประเภทมีความเสี่ยงและไม่มีระบบใดรับประกันว่าจะได้รับกำไร
// (h2 #1 ย่อหน้าท้าย) · ควรตรวจสอบว่าโปรโมชั่นครอบคลุมบาคาร่า ไฮโล สล็อต หรือ
// แทงบอลประเภทใดบ้าง (h2 #2 ย่อหน้า 1) · ควรอ่านรายละเอียดประเภทเกมที่ร่วมรายการ
// เวลาตัดยอด และเงื่อนไขการใช้โบนัสก่อนรับทุกครั้ง (h2 #2 รายการแรก) · ส่วนคำว่า
// ไม่จำกัดควรระบุให้ชัด (h2 #2 รายการที่สอง) · ไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP
// ให้บุคคลอื่น (h2 #3 ย่อหน้าท้าย)
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **น้ำเงินไฟฟ้านำ เงินโครเมียมรอง บนกรมเกือบดำ**
// พลิกออกจากชุดม่วง-ทองบนดำของรอบก่อน (ค่าเดิมอยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive)
// พื้นเพจเป็นกรมเกือบดำ #00081f (bg.json) จึงไม่มีชั้นที่ลึกกว่าพื้นเพจได้จริง
// ลำดับความลึก: #102a5e ผิวยก (= การ์ด) / #0a1c42 กลาง / #040e26 จมสุด / #00081f พื้น
//
// ลำดับปุ่มสื่อด้วย "ฟ้าถม vs ผิวจมขอบน้ำเงิน" — คู่พื้น-หมึกคำนวณไว้แล้ว:
// · ปุ่มหลัก (สมัครสมาชิก) ถมฟ้าไล่ #6ec8ff → #0292fb ขอบ #032dad หมึก #021026
//   (9.8:1 บนปลายสว่าง และ 6.0:1 บนปลายเข้ม) ⚠️ ไล่เฉดต้องหยุดที่ #0292fb
//   ห้ามไล่ลงไปเข้มกว่านั้นใต้ตัวอักษร
// · ปุ่มรอง/ปุ่มลิงก์ภายในเป็นชั้นจม #0a1c42 → #040e26 ขอบ #0360f3/55
//   ตัวอักษร #dde8f7 — hover ยกขอบเป็นฟ้าสด #0292fb
// · #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้
// ⚠️ #0360f3 · #0292fb · #032dad · #04186e · #041a43 ห้ามถือตัวอักษรทุกขนาด ใช้ได้
// แค่เส้นขอบ ออรา เงา และพื้นถม — ออราในไฟล์นี้ใช้ rgba(3,96,243,α) และ
// rgba(2,146,251,α) เท่านั้น
// ⚠️ กับดักรอบนี้คือ **น้ำเงิน**: ไฟล์อินเวนทอรีหลายตัวเคยเป็นของแบรนด์ฟ้ามาก่อน
// "มีน้ำเงินอยู่" จึงไม่ใช่ตัวบอกว่าถูกแบรนด์ ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน
// brand-spec §2 ไม่ใช่เทียบด้วยตาหรือด้วยตระกูลสี และรอบนี้ไม่มีทอง ไม่มีม่วง
// ไม่มีชมพู ไม่มีเขียว ไม่มีส้ม ไม่มีแดง
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #dde8f7,
// 11.6:1 บนผิวยก #102a5e) ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง
// ปล่อยให้สืบทอดลงมา และไม่ใส่ mx-auto / max-w-* บน <p> เพราะการ์ดคุมความกว้างเองแล้ว
// — ที่ประกาศสีได้มีแค่ปุ่ม (ถมพื้นของตัวเองจึงต้องกำหนดหมึกของตัวเอง) และ <strong>
// ซึ่ง brand-spec §2 สงวน #6ec8ff (7.4:1 บนผิวการ์ด) ไว้ให้เป็นสีไฮไลต์ในเนื้อความ
// โดยเฉพาะ และไม่ใช้สีอื่นเลย · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง
// เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาด
// ครึ่ง (ลบแท็ก <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิมเป๊ะ)
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้าง
// จากหน้า และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้หมุนมาเป็น Announcement3 ทั้งเว็บ (รอบก่อนใช้ Announcement5 —
// brand-spec §3 หมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้
// ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูด
// คนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 151
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} เว็บพนันลิขสิทธิ์ไทยแท้ รวมบาคาร่า ไฮโล สล็อต และแทงบอลไว้ในบัญชีเดียว พร้อมคืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% และแอดมิน 24 ชั่วโมง`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} เว็บพนันลิขสิทธิ์ไทยแท้ รวมเกมคาสิโนและกีฬาไว้ในบัญชีเดียว`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#6ec8ff]">{BRAND_NAME} คือเว็บพนันออนไลน์ที่นำเสนอระบบเข้าเดิมพันผ่านเว็บไซต์</strong>
        รองรับเกมหลายประเภททั้งบาคาร่า ไฮโล สล็อต และแทงบอล พร้อมจัดหมวดเกมให้เลือกใช้งานผ่านมือถือและคอมพิวเตอร์ได้สะดวก ผู้ใช้งานจึงค้นหาประเภทเกมที่สนใจได้โดยไม่ต้องสลับหลายหน้าเว็บไซต์
      </p>

      <p>
        หน้านี้สรุปไว้ว่าภายในระบบมีอะไรให้ใช้งานบ้าง ตั้งแต่หมวดเกมที่จัดไว้ให้เลือก ไปจนถึงรายการโปรโมชั่นและช่องทางติดต่อแอดมิน
        <strong class="text-[#6ec8ff]">สมาชิกสามารถตรวจสอบข้อมูลเกม ยอดเดิมพัน และรายการต่างๆ ผ่านบัญชีเดียว</strong>
        โดยเว็บไซต์ระบุว่าเปิดให้เข้าใช้งานตลอด 24 ชั่วโมง เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดดูอะไรตรงไหน แล้วจึงค่อยลงรายละเอียดของรายการที่สนใจเป็นรายรายการ
      </p>

      <p>
        <strong class="text-[#6ec8ff]">ส่วนการกล่าวอ้างว่าเป็นเว็บลิขสิทธิ์ไทยแท้และใช้เซิร์ฟเวอร์ในประเทศไทย 100% ควรมีข้อมูลใบอนุญาตและผู้ให้บริการระบบที่ตรวจสอบได้ประกอบ</strong>
        เช่นเดียวกับชื่อโดเมนและข้อมูลผู้ดำเนินงานที่ควรตรวจสอบให้ชัดเจนก่อนส่งข้อมูลส่วนตัว ข้อมูลในหน้านี้จึงเขียนไว้เพื่อบอกว่าระบบมีอะไรให้ใช้และควรตรวจอะไรก่อนตัดสินใจ
        ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้งาน
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`หมวดเกมที่ ${BRAND_NAME} รวมไว้ในแพลตฟอร์มเดียว`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        ทางเข้าเดิมพัน {BRAND_NAME} รวบรวมหมวดเกมคาสิโนและกีฬาไว้ในแพลตฟอร์มเดียว
        <strong class="text-[#6ec8ff]">การรวมหมวดเกมไว้ในระบบเดียวช่วยให้ค้นหาประเภทเกมและศึกษารายละเอียดได้สะดวกขึ้น</strong>
        ทั้งบนหน้าจอมือถือและคอมพิวเตอร์ ประเภทการเดิมพันที่เว็บไซต์ระบุไว้แบ่งออกได้ประมาณนี้
      </p>

      <ul class="flex flex-col gap-3" aria-label={`หมวดเกมเดิมพันบนแพลตฟอร์มของ ${BRAND_NAME}`}>
        <li class="flex gap-3">
          <span aria-hidden="true">🃏</span>
          <span>
            <strong class="text-[#6ec8ff]">บาคาร่า</strong> เป็นเกมไพ่ที่มีตัวเลือกการเดิมพันตามกติกา จึงควรอ่านกติกาและตัวเลือกเดิมพันของโต๊ะที่เลือกให้เข้าใจก่อนเป็นอันดับแรก
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">🎲</span>
          <span>
            <strong class="text-[#6ec8ff]">ไฮโล</strong> ใช้ผลจากลูกเต๋าเป็นตัวตัดสิน รูปแบบการเดิมพันและเงื่อนไขการตัดสินผลของแต่ละรายการจึงเป็นสิ่งที่ควรเปิดอ่านก่อนทำรายการ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">🎰</span>
