---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login, /register)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึงเขียนขึ้นใหม่
// บนข้อเท็จจริงของ GOT777 เท่านั้น
//
// รอบนี้ (ดรอป 2026-09-29) คือ GOT777 **เว็บเกมสล็อตออนไลน์** — เกมจากแพลตฟอร์ม
// ค่ายใหญ่ สล็อตคลาสสิก เกมโบนัส ฟรีสปิน ตัวคูณ แจ็กพอต ส่วนแบรนด์ก่อนหน้า
// (LOTTOPLUS) เป็นเว็บหวยที่ขายหวยรัฐบาลไทย ลาวพัฒนา ฮานอย หวยหุ้น โพย งวด
// และอัตราจ่าย 2 ตัว/3 ตัว — คำชุดนั้นถูกถอดออกทั้งหมด ห้าม find-and-replace
// ชื่อแบรนด์ทับประโยคเดิม มิฉะนั้นเว็บสล็อตจะไปอ้างสินค้าคนละตัวซึ่งไม่มีอยู่ใน
// บรีฟรอบนี้เลยสักคำ (คำห้าม: หวย โพย แทงหวย ตรวจหวย รัฐบาลไทย ลาวพัฒนา ฮานอย
// หวยหุ้น อัตราจ่าย 2 ตัว/3 ตัว รอบออกรางวัล ส่งโพย งวด เลขเด็ด แนวทางหวย)
//
// ข้อเท็จจริงทุกบรรทัดมาจาก src/assets/content.txt เท่านั้น: รวมเกมสล็อตหลายรูปแบบ
// จากแพลตฟอร์มค่ายใหญ่ไว้ในบัญชีเดียว · สล็อตคลาสสิก เกมโบนัส ฟรีสปิน ตัวคูณ
// เกมแจ็กพอต · เกมวงล้อแบบดั้งเดิม สล็อตธีมเอเชีย เกมผจญภัย · รองรับมือถือ
// แท็บเล็ต คอมพิวเตอร์ · เลือกเกม ตรวจสอบเครดิต โปรโมชั่น ประวัติรายการจากระบบเดียว
// ไม่ต้องสมัครหลายบัญชี · ผลลัพธ์แบบสุ่ม ไม่รับประกันว่าจะชนะ · จำนวนเกมและแจ็กพอต
// ขึ้นกับแต่ละค่าย ควรตรวจกติกา ช่วงเดิมพัน ฟีเจอร์โบนัส เงื่อนไขแจ็กพอตก่อนเดิมพัน ·
// คืนยอดเสีย 0.3% ตามรอบที่กำหนด · แนะนำเพื่อน 0.8% จากลิงก์แนะนำส่วนตัว ·
// สมัครผ่านระบบออนไลน์บนมือถือ · ยอดเดิมพันขั้นต่ำต่างกันตามผู้ให้บริการ ·
// แอดมิน 24 ชั่วโมง · แจ้งปัญหาเกมด้วยชื่อเกม ค่าย เวลา · ไม่เปิดเผยรหัสผ่าน PIN OTP
// — ตัวเลขที่อ้างได้มีเท่านี้ ห้ามเพิ่มชื่อค่ายเกม ชื่อธนาคาร ขั้นต่ำฝาก RTP
// เลขใบอนุญาต ปีที่ก่อตั้ง เลขทะเบียนบริษัท หรือจำนวนสมาชิกที่บรีฟไม่ได้ระบุ
//
// บรีฟ hedge ไว้ตรง ๆ และต้องคงไว้ในคอปปี้: เกมสล็อตมีผลลัพธ์แบบสุ่ม ไม่รับประกัน
// ว่าจะชนะ · จำนวนเกม/แจ็กพอตขึ้นกับแต่ละค่าย · คำว่า "แตกง่าย" และ "ไม่มีขั้นต่ำ"
// ควรพิจารณาจากข้อมูลจริงของแต่ละเกม — หน้านี้จึงเขียนเป็นสิ่งที่ควรตรวจสอบ
// ไม่ใช่คำรับประกัน
//
// พาเลตต์ GOT777 เป็น **ทองนำ แดงเลือดหมูรอง บนดำ** ตามโลโก้ (ตัวอักษร GOT ทอง
// เลข 777 แดง อัญมณีแดงกลางตัว O) กับแบนเนอร์พื้นดำที่มีชิปคาสิโนดำแดงและเหรียญทอง
// ตารางแมปอยู่ที่ brand-spec §2: ทองหลัก #f5c518 · ทองอ่อน #ffe9a8 · ทองลึก #96690f ·
// แดงรอง #d21622 · แดงลึก #7b0304 · แดงมืดสุด #4c0301 · พื้นเพจ #0a0503 ·
// ผิวยก #160b06 · ผิวยก 2 #241108 · เนื้อความ #ece0cb (BRAND_TEXT) ·
// เนื้อความรอง #bdae92 · เน้นใน strong #fff6dd · หมึกบนพื้นทอง #0a0503
// ชุดแดงของ LOTTOPLUS (#dc020e #ff2d38 #6b0207 #f3c623 #fde79a #8a6a0a #f0e2e2
// #fff4f4 #120b0c #1f0a0c #2a0d0f #1a0203 rgba(220,2,14,*) rgba(243,198,35,*))
// ออกครบทุกจุดแล้ว ทั้งคลาส Tailwind raw hex และ rgba() ที่ใช้ทำแสงเรือง
// ส่วน #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ตามเดิม
// กฎคอนทราสต์: พื้นทอง → หมึกเข้ม #0a0503 (12.3:1) · พื้นแดง #d21622 → ตัวอักษรขาว
// (5.4:1) · ตัวอักษรบนการ์ดดำใช้ทอง #f5c518 / #ffe9a8 เท่านั้น เพราะแดงรอง #d21622
// บนการ์ดดำได้แค่ ~3.5:1 — แดงจึงใช้เป็นพื้นและขอบ ไม่ใช่หมึก
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลางที่ไม่หมุนตามรอบรีแบรนด์ และรอบนี้
// orchestrator เป็นคนรีธีม) — สีเนื้อความจึงตรงกับที่การ์ดกำหนดไว้อยู่แล้ว
//
// รอบนี้ /ตรวจหวย และ /แนวทาง ถูกย้ายไป src/pages-disabled/ (GOT777 เป็นเว็บสล็อต
// ไม่ใช่เว็บหวย) ทั้งสอง route จึงไม่มีอยู่ใน dist/ ลิงก์เดิมที่หน้านี้เคยชี้ไปหา
// ถูกถอดออกแล้ว เหลือลิงก์ภายในที่มี route จริง: /ทดลองเล่น /promotion /register
// /login /line /contact-us
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index และ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า
// และ slide3/slide4/banner2/banner3 ห้าม import (ลำพังการ import ก็ทำให้ไฟล์ถูก emit
// ลง dist/ และ verify-build จะแดง) · gamedemo7–18.webp ก็ใช้ไม่ได้: ตรวจไฟล์จริงแล้ว
// ทุกใบมีลายน้ำแบรนด์อื่นฝังอยู่ในภาพ (askmeslot) และบางใบมีชื่อค่ายเกม (JILI)
// ซึ่ง brand-spec §1 ห้ามเอ่ยชื่อค่ายบนเว็บนี้
//
// Announcement รอบนี้เป็น Announcement3 ทั้งเว็บ — orchestrator ตั้ง default
// message ของไฟล์นั้นเป็นคอปปี้ของ GOT777 แล้ว จึงเรียกแบบ bare เหมือน
// index.astro ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 157
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "เกี่ยวกับ GOT777 เว็บเกมสล็อตที่รวมเกมจากแพลตฟอร์มค่ายใหญ่ไว้ในบัญชีเดียว ทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน และแจ็กพอต พร้อมโปรโมชั่นและแอดมินดูแล 24 ชั่วโมง";

const pageTitle = "เกี่ยวกับเรา GOT777 เว็บเกมสล็อต รวมค่ายใหญ่ในบัญชีเดียว";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ece0cb]">
        <strong class="text-[#fff6dd]">GOT777</strong> คือ<strong class="text-[#fff6dd]">เว็บเกมสล็อตออนไลน์ที่รวบรวมเกมหลากหลายรูปแบบจากแพลตฟอร์มค่ายใหญ่ไว้ในบัญชีเดียว</strong>
        มีทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน ตัวคูณ และเกมแจ็กพอตให้เลือกตามความสนใจ รองรับการเข้าเล่นผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์
      </p>

      <p class="text-left text-base leading-relaxed text-[#ece0cb]">
        หน้านี้รวบรวมไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่ประเภทเกมสล็อตที่เปิดให้เลือก โปรโมชั่นของสมาชิก ระบบบัญชีที่ใช้ตรวจสอบเครดิตและประวัติรายการ ขั้นตอนการสมัคร
        ไปจนถึงช่องทางสอบถามแอดมินเมื่อไม่แน่ใจในขั้นตอนใด
      </p>

      <p class="text-left text-base leading-relaxed text-[#ece0cb]">
        <strong class="text-[#fff6dd]">เกมสล็อตเป็นเกมที่มีผลลัพธ์แบบสุ่ม แม้บางเกมจะมีแจ็กพอตหรือโบนัสให้ลุ้น แต่ไม่สามารถรับประกันว่าจะชนะหรือทำกำไรได้ตลอดเกม</strong>
        รายการเกม เงื่อนไขของแจ็กพอต และเงื่อนไขของโปรโมชั่นยังเปลี่ยนแปลงได้ตามช่วงเวลา รายละเอียดทั้งหมดจึงยึดตามข้อมูลที่เว็บไซต์และตัวเกมแสดงไว้จริงในขณะนั้นเป็นหลัก
      </p>
    </div>
  </ContentBox>

  <ContentBox title="GOT777 รวมเกมสล็อตจากแพลตฟอร์มค่ายใหญ่ไว้ในบัญชีเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ece0cb]">
        สิ่งที่เว็บไซต์ระบุไว้เป็นตัวตนของ GOT777 คือ <strong class="text-[#fff6dd]">การรวมเกมสล็อตจากหลายผู้ให้บริการไว้ในบัญชีเดียว</strong>
        สมาชิกสลับเกมผ่านบัญชีเดิมได้โดยไม่ต้องสมัครหลายบัญชี และค้นหาเกมใหม่หรือเกมยอดนิยมได้จากหน้าเกมสล็อตหน้าเดียว ช่วยให้หาเกมที่ต้องการเจอเร็วขึ้น
      </p>

      <p class="text-left text-base leading-relaxed text-[#ece0cb]">
        ถัดจากการเลือกเกมคือ<strong class="text-[#fff6dd]">หน้าบัญชีสมาชิกที่รวมเครดิต โปรโมชั่น และประวัติรายการไว้ให้ตรวจสอบได้ด้วยตัวเอง</strong>
        หลังเล่นแล้วจึงกลับมาตรวจเครดิตและรายการย้อนหลังให้เรียบร้อยได้จากระบบเดียว ไม่ต้องจดแยกไว้เองหรือย้อนถามทีละรายการ
      </p>

      <p class="text-left text-base leading-relaxed text-[#ece0cb]">
        ส่วนจำนวนเกมที่เปิดให้เล่นจริงนั้น<strong class="text-[#fff6dd]">ขึ้นอยู่กับแต่ละค่ายที่ระบบเปิดให้บริการในขณะนั้น</strong>
        จึงควรตรวจสอบข้อมูลภายในเกมก่อนเดิมพันทุกครั้ง โดยเฉพาะกติกา ช่วงเดิมพัน ฟีเจอร์โบนัส และเงื่อนไขของแจ็กพอต เพราะไม่ใช่เกมสล็อตทุกเกมหรือทุกค่ายที่จะมีระบบแจ็กพอตเหมือนกัน
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/ทดลองเล่น"
          aria-label="เปิดหน้าทดลองเล่นสล็อตของ GOT777"
          class="flex items-center justify-center rounded-lg border border-[#d21622]/80 bg-[#241108] px-8 py-3 font-bold text-[#ece0cb] transition-all hover:scale-105 hover:border-[#f5c518] hover:bg-[#160b06] hover:text-[#f5c518]">
          ไปหน้าทดลองเล่น
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="ประเภทเกมสล็อตใน GOT777 ตั้งแต่สล็อตคลาสสิกถึงเกมแจ็กพอต" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ece0cb]">
        เกมที่เปิดให้เลือกแบ่งได้เป็นไม่กี่กลุ่มใหญ่ และแต่ละกลุ่ม<strong class="text-[#fff6dd]">มีจังหวะการเล่นและฟีเจอร์เป็นของตัวเอง</strong>
        ไม่ได้ใช้ช่วงเดิมพันหรือรูปแบบโบนัสชุดเดียวกันทั้งหมด การรู้ว่าแต่ละกลุ่มต่างกันตรงไหนช่วยให้เลือกเกมที่ตรงกับสไตล์ของตัวเองได้เร็วขึ้น
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#ece0cb]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f5c518]">🎰</span>
          <span>
            <strong class="text-[#fff6dd]">สล็อตคลาสสิกและเกมวงล้อแบบดั้งเดิม</strong> สัญลักษณ์และเส้นรางวัลมีไม่มาก จึงเป็นกลุ่มที่อ่านกติกาได้เร็วที่สุด เหมาะกับคนที่เพิ่งเริ่มทำความรู้จักเกมสล็อต
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ffe9a8]">🀄</span>
          <span>
            <strong class="text-[#fff6dd]">สล็อตธีมเอเชียและเกมผจญภัย</strong> มักมีสัญลักษณ์พิเศษและฉากโบนัสเป็นของตัวเอง ควรอ่านว่าสัญลักษณ์ตัวไหนเป็นตัวเปิดฟีเจอร์ก่อนเริ่มเดิมพัน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f5c518]">🎁</span>
          <span>
            <strong class="text-[#fff6dd]">เกมโบนัส ฟรีสปิน และตัวคูณ</strong> เงื่อนไขต่างกันมากในแต่ละเกม ทั้งจำนวนรอบที่ได้ วิธีเข้าสู่ฟีเจอร์ และวิธีคิดตัวคูณ จึงควรอ่านจากหน้าข้อมูลของเกมนั้นโดยตรง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ffe9a8]">💎</span>
          <span>
