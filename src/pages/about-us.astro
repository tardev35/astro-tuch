---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char, so a byte count reads
// ~3x too long). One string, reused by MainLayout's meta and the WebPage node.
const pageDescription =
  "รู้จัก SUPERWIN9 คาสิโนออนไลน์ที่รวมคาสิโนสด บาคาร่า รูเล็ต เสือมังกร และสล็อตทุกค่ายไว้ในบัญชีเดียว พร้อมโบนัสแนะนำเพื่อน 0.8% ฝากถอนทุกธนาคาร ดูแล 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ SUPERWIN9 คาสิโนออนไลน์ รวมคาสิโนสด บาคาร่า และสล็อตทุกค่าย",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา SUPERWIN9 คาสิโนออนไลน์ รวมคาสิโนสด บาคาร่า สล็อตทุกค่าย" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ SUPERWIN9" as="h1">
    <p class="mb-6 text-left text-base leading-relaxed text-[#efe3d2]">
      <strong class="text-[#ebbb4a]">SUPERWIN9</strong> คือคาสิโนออนไลน์ที่เปิดให้สมาชิกเข้าเล่นผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ได้โดยตรง
      ภายในบัญชีเดียวมีเกมให้เลือกหลายหมวดหมู่ ทั้ง <strong class="text-[#ebbb4a]">คาสิโนสด บาคาร่า รูเล็ต เสือมังกร และสล็อต</strong> จากหลายค่าย
      พร้อมอัปเดตเกมใหม่อย่างต่อเนื่อง สมาชิกจึงค้นหาเกมที่สนใจและสลับเข้าเล่นแต่ละหมวดหมู่ได้สะดวกโดยไม่ต้องเปิดหลายบัญชี
    </p>

    <p class="mb-2 text-left text-base leading-relaxed text-[#efe3d2]">
      นอกจากตัวเกมแล้ว ที่นี่ยังมีโปรโมชั่นสำหรับสมาชิกให้เข้าร่วมตามเงื่อนไขของแต่ละกิจกรรม โดยรายละเอียดของโบนัส ยอดที่นำมาคำนวณ
      และรอบการรับสิทธิ์จะแสดงอยู่ในระบบสมาชิกก่อนกดรับเสมอ สมาชิกควรอ่านเงื่อนไขตรงจุดนั้นทุกครั้ง เพราะข้อกำหนดของแต่ละโปรโมชั่นไม่เท่ากัน
    </p>
  </ContentBox>

  <ContentBoxPlain title="โบนัสแนะนำเพื่อน 0.8% สิทธิพิเศษของสมาชิก SUPERWIN9" as="h2">
    <p class="mb-2 text-left text-base leading-relaxed text-[#efe3d2]">
      สมาชิก SUPERWIN9 เข้าร่วมโปรโมชั่นแนะนำเพื่อนเพื่อรับ <strong class="text-[#ebbb4a]">โบนัส 0.8%</strong> ได้ตามเงื่อนไขของกิจกรรม
      เพียงเข้าสู่บัญชีสมาชิก คัดลอกลิงก์แนะนำของตนเองแล้วแชร์ให้เพื่อน เมื่อเพื่อนสมัครและมีรายการที่เป็นไปตามข้อกำหนด
      ระบบจะคำนวณและแสดงโบนัสที่รับได้ในบัญชีของผู้แนะนำ ควรตรวจสอบยอดคำนวณ รอบการรับ และเงื่อนไขการถอนก่อนกดรับสิทธิ์ทุกครั้ง
    </p>
  </ContentBoxPlain>

  <ContentBoxPlain title="ฝากถอนทุกช่องทาง และแอดมิน SUPERWIN9 ดูแลตลอด 24 ชั่วโมง" as="h2">
    <p class="mb-6 text-left text-base leading-relaxed text-[#efe3d2]">
      ระบบฝากถอนรองรับ <strong class="text-[#ebbb4a]">ช่องทางธนาคารและวิธีชำระเงินที่เว็บไซต์เปิดให้บริการ</strong> สมาชิกฝากเครดิต ตรวจสอบยอด
      ส่งคำขอถอน และติดตามสถานะรายการได้จากบัญชีของตนเองโดยตรง ช่วยลดขั้นตอนในการทำธุรกรรม หากรายการล่าช้าหรือเครดิตไม่เข้า
      แจ้งรายละเอียดรายการให้ทีมงานช่วยตรวจสอบได้ทันที และไม่ว่าจะเป็นปัญหาการสมัครสมาชิก การเข้าสู่ระบบ การรับโบนัสแนะนำเพื่อน หรือการเข้าเล่นเกม
      มี <strong class="text-[#ebbb4a]">แอดมินดูแลตลอด 24 ชั่วโมง</strong> ให้ติดต่อเข้ามาได้โดยไม่ต้องรอคิว
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก SUPERWIN9"
        class="flex items-center justify-center rounded-lg bg-gradient-to-r from-[#fbe289] via-[#ebbb4a] to-[#d4a02a] px-8 py-3 font-black text-[#2a0a02] shadow-[0_0_15px_rgba(235,187,74,0.4)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ SUPERWIN9"
        class="flex items-center justify-center rounded-lg border border-[#ebbb4a]/70 bg-transparent px-8 py-3 font-bold text-[#efe3d2] transition-all hover:scale-105 hover:border-[#f5333c] hover:bg-[#240607]/70">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
