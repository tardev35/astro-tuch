---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login, /register)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึงเขียนขึ้นใหม่
// บนข้อเท็จจริงของ หวย365 เท่านั้น (src/assets/content.txt)
//
// ดรอปนี้ (2026-10-02) คือ หวย365 **เว็บแทงหวยออนไลน์** แง่มุมที่บรีฟระบุไว้มีเท่านี้:
// แนวทางหวย · กลุ่มหวย · สถิติหวยย้อนหลัง · ผลหวยตามรอบที่ประกาศ ·
// รัฐบาลไทย / ฮานอยหลายรอบ / ลาวพัฒนา / หุ้นต่างประเทศตามตลาดที่เปิด ·
// บัญชีเดียวครบทุกประเภทหวย · เลือกเลข ส่งโพย ตรวจอัตราจ่ายและรอบก่อนยืนยัน ·
// รองรับมือถือ · สมัคร 3 ขั้นตอน · แอดมิน 24 ชั่วโมง · 2 ตัว จ่าย 100 บาท ·
// 3 ตัว จ่าย 1,000 บาท
//
// แบรนด์ก่อนหน้า (หวยเฮง789 / หวยเฮง24) เป็นเว็บหวยเหมือนกันแต่คนละบรีฟ — "เลขเด็ด"
// "เลขดัง" "ไม่จำกัด" "แทงได้ไม่อั้น" "ฮานอยปกติ/พิเศษ/วีไอพี" "ฝากถอนวอลเลท" และ
// "หวยลาว" เฉย ๆ เป็นของบรีฟรอบก่อน บรีฟรอบนี้ไม่ได้ระบุไว้เลย จึงถอดออกทั้งชุดและ
// เขียนประโยคขึ้นใหม่ แทนที่จะ find-and-replace ชื่อแบรนด์ทับประโยคเดิม มิฉะนั้น
// เว็บจะไปอ้างสินค้าที่ไม่มีอยู่ · บรีฟรอบนี้สะกดว่า **ลาวพัฒนา** ไม่ใช่ "ลาว"
// (คำห้ามจาก brand-spec §6: สล็อต ฟรีสปิน RTP บาคาร่า คาสิโน บอล ค่าน้ำ
// อัตราต่อรอง ลีก)
//
// ตัวเลขที่อ้างได้มีแค่ 100 บาท · 1,000 บาท · 3 ขั้นตอน · 24 ชั่วโมง
// ห้ามเพิ่มชื่อผู้ให้บริการ ชื่อธนาคาร ขั้นต่ำฝากถอน เลขใบอนุญาต ปีที่ก่อตั้ง
// จำนวนสมาชิก ความเร็วฝากถอน หรือ "อันดับ 1" ที่บรีฟไม่ได้ระบุ · บรีฟรอบนี้ไม่มี
// โปรโมชั่น/โบนัสเลยสักรายการ จึงไม่มีหัวข้อโปรโมชั่นในหน้านี้
//
// ประโยค hedge ที่บรีฟเขียนกำกับไว้เองและห้ามตัดทิ้งเพราะดูเป็นลบ: สถิติย้อนหลังและ
// แนวทางหวยเป็นข้อมูลประกอบ ไม่สามารถรับประกันผลของงวดถัดไปได้ · อัตราจ่ายและวงเงิน
// ต่างกันตามประเภทหวยและรอบ · ให้ยึดรายละเอียดล่าสุดในหน้าส่งโพย ·
// ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP
//
// พาเลตต์ หวย365 (brand-spec §2) **แดงสดนำ ทองรอง**: แดงแบรนด์ #dc0203 ·
// แดงสว่าง #f5282a · แดงลึก #9c0201 · ทอง #ffc93c · ทองอ่อน (หมึกเน้น) #ffeab0 ·
// ทองลึก (ขอบ/ปลายไล่เฉด) #c08a07 · การ์ด #240406 · แถบบาร์ #180303 ·
// เนื้อความ #f6e7e0 (BRAND_TEXT) · หมึกบนพื้นทอง #1a0303
// เรืองแสง: แดง rgba(220,2,3,*) · ทอง rgba(255,201,60,*) · เงา rgba(8,1,1,*)
// ชุดของ หวยเฮง789 (#dc2224 #f4bc5d #ffefc2 #fbe3d4 #2b0909 #1c0606 #e43434
// #a8690c #d99a10 rgba(244,188,93,*) rgba(220,34,36,*)) ออกครบทุกจุดแล้ว
// ส่วน #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ตามเดิม
// กฎคอนทราสต์: พื้นทอง → หมึกเข้ม #1a0303 (11.6:1 บน #ffc93c, 6.4:1 ที่ #c08a07
// ปลายไล่เฉด) · ห้ามวางขาวบนทอง และห้ามวางหมึกเข้มบนแดง พื้นแดงใช้หมึกขาว
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลางที่ไม่หมุนตามรอบรีแบรนด์ และรอบนี้
// orchestrator เป็นคนรีธีม) — สีเนื้อความจึงตรงกับที่การ์ดกำหนดไว้อยู่แล้ว
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index และ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า
// และ slide3/slide4/banner2/banner3 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import (ลำพัง
// การ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น AnnouncementCyber ทั้งเว็บ (รอบก่อน หวยเฮง789 ใช้
// Announcement2) — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ หวย365
// แล้ว จึงเรียกแบบ bare เหมือน index.astro ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูด
// คนละเรื่องกันระหว่างสองหน้า
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 155
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "เกี่ยวกับเรา หวย365 เว็บแทงหวยออนไลน์ที่รวมแนวทางหวย กลุ่มหวย สถิติหวยย้อนหลัง และผลหวยตามรอบไว้ในบัญชีเดียว หน้านี้สรุปว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง";

const pageTitle = "เกี่ยวกับเรา หวย365 เว็บแทงหวยออนไลน์ รวมแนวทางหวย กลุ่มหวย สถิติหวย ผลหวย";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f6e7e0]">
        <strong class="text-[#ffeab0]">หวย365</strong> คือ<strong class="text-[#ffeab0]">เว็บแทงหวยออนไลน์ที่รวมข้อมูลและรายการหวยไว้ในหน้าเดียว</strong>
        ทั้งแนวทางหวย กลุ่มหวย สถิติหวยย้อนหลัง และผลหวยตามรอบที่ประกาศ โดยสมาชิกติดตามหวยรัฐบาลไทย หวยฮานอย หวยลาวพัฒนา และหวยหุ้นต่างประเทศได้จากบัญชีเดียว พร้อมเลือกเลข ส่งโพย และตรวจสอบรายการผ่านมือถือ
      </p>

      <p class="text-left text-base leading-relaxed text-[#f6e7e0]">
        หน้านี้สรุปไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่ประเภทหวยที่เปิดรับในแต่ละรอบ เวลาเปิดรับและเวลาปิดรับของแต่ละรายการ อัตราจ่ายของรายการที่เข้าเงื่อนไข หมวดแนวทางหวย กลุ่มพูดคุย
        และสถิติย้อนหลังที่แยกตามประเภท ไปจนถึงขั้นตอนสมัครและช่องทางสอบถามแอดมินเมื่อไม่แน่ใจในขั้นตอนใด
      </p>

      <p class="text-left text-base leading-relaxed text-[#f6e7e0]">
        <strong class="text-[#ffeab0]">ข้อมูลสถิติย้อนหลังและแนวทางหวยบนเว็บไซต์เป็นเพียงข้อมูลประกอบ</strong>
        ใช้ย้อนดูผลของรอบที่ผ่านมาได้ แต่ไม่สามารถใช้ยืนยันหรือรับประกันเลขที่จะออกในงวดถัดไปได้ เพราะผลการออกรางวัลของแต่ละรอบไม่ได้ยืนยันจากสถิติที่ผ่านมา
      </p>
    </div>
  </ContentBox>

  <ContentBox title="เว็บ หวย365 รวมรัฐบาลไทย ฮานอย ลาวพัฒนา หวยหุ้นต่างประเทศ ไว้ในบัญชีเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f6e7e0]">
        สิ่งที่เว็บไซต์ระบุไว้เป็นตัวตนของ หวย365 คือ<strong class="text-[#ffeab0]">การรวบรวมรายการหวยหลายประเภทไว้สำหรับผู้ที่ต้องการติดตามหลายรอบในบัญชีเดียว</strong>
        สมาชิกจึงเลือกหวยจากคนละประเภทได้จากบัญชีเดิม และตรวจสอบเวลาเปิดรับ เวลาปิดรับ อัตราจ่าย และผลของแต่ละรายการได้ก่อนเลือกแทง
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f6e7e0]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ffc93c]">🏛️</span>
          <span>
            <strong class="text-[#ffeab0]">หวยรัฐบาลไทย</strong> เปิดรับตามกำหนดออกรางวัลของแต่ละงวด จึงเป็นกลุ่มที่อ่านตารางรอบได้ชัดเจนที่สุดและวางแผนล่วงหน้าได้ง่ายที่สุดสำหรับผู้ที่เพิ่งเริ่มต้น
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ffc93c]">🕒</span>
          <span>
            <strong class="text-[#ffeab0]">หวยฮานอย</strong> เปิดรับหลายรอบ แต่ละรอบมีเวลาปิดรับของตัวเอง จึงควรอ่านชื่อหวยและรอบเวลาให้ตรงกับที่ต้องการก่อนยืนยันโพย
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ffc93c]">🎫</span>
          <span>
            <strong class="text-[#ffeab0]">หวยลาวพัฒนา</strong> เปิดรับตามรอบที่ระบบกำหนดเช่นกัน จึงควรดูตารางรอบและเวลาปิดรับจากหน้าส่งโพยของรอบนั้นก่อนเลือกตัวเลขทุกครั้ง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ffc93c]">📈</span>
          <span>
            <strong class="text-[#ffeab0]">หวยหุ้นต่างประเทศ</strong> เปิดรับตามตลาดที่เปิดให้บริการ จำนวนรายการที่เลือกได้ในแต่ละวันจึงขึ้นอยู่กับตลาดที่เปิดในรอบนั้น
          </span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#f6e7e0]">
        ถัดจากการเลือกรายการคือ<strong class="text-[#ffeab0]">หน้าบัญชีสมาชิกที่ใช้เลือกเลข ส่งโพย ตรวจสอบประวัติรายการ และดูผลของแต่ละรอบ</strong>
        ระบบรองรับการใช้งานผ่านมือถือ จึงติดตามรอบหวย ส่งโพย และตรวจสอบผลได้จากหน้าเว็บไซต์ในที่เดียว โดยไม่ต้องสลับใช้งานหลายบัญชี
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/ทดลองเล่น"
          aria-label="เปิดหน้าทดลองเล่นของ หวย365"
          class="flex items-center justify-center rounded-lg border border-[#ffc93c]/35 bg-[#240406] px-8 py-3 font-bold text-[#f6e7e0] transition-all hover:scale-105 hover:border-[#ffc93c] hover:bg-[#180303] hover:text-[#ffeab0]">
          ไปหน้าทดลองเล่น
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="แนวทางหวย กลุ่มหวย และสถิติหวยย้อนหลัง จัดหมวดแยกตามประเภท" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f6e7e0]">
        นอกจากรายการหวยแล้ว เว็บไซต์ยัง<strong class="text-[#ffeab0]">จัดหมวดแนวทางหวย กลุ่มพูดคุย และสถิติย้อนหลังแยกตามประเภทไว้ให้ค้นหาได้ง่ายขึ้น</strong>
        ผู้ที่สนใจเฉพาะรัฐบาลไทย เฉพาะฮานอยรอบใดรอบหนึ่ง เฉพาะลาวพัฒนา หรือเฉพาะหวยหุ้นต่างประเทศ จึงเปิดดูเฉพาะหมวดที่ตรงกับรอบของตัวเองได้ แทนการไล่อ่านรวมกันทั้งหมด
      </p>

      <p class="text-left text-base leading-relaxed text-[#f6e7e0]">
        สถิติย้อนหลังใช้สำหรับย้อนดูผลและรูปแบบตัวเลขที่เคยออกในรอบที่ผ่านมา ส่วนแนวทางหวยเป็นข้อมูลประกอบที่รวบรวมมาจากแหล่งหรือกลุ่มต่าง ๆ ทั้งสองอย่างช่วยให้เห็นภาพรวมของแต่ละรายการได้เร็วขึ้น
        และช่วยให้เปรียบเทียบรอบที่สนใจได้ภายในหน้าเดียว
      </p>

      <p class="text-left text-base leading-relaxed text-[#f6e7e0]">
        <strong class="text-[#ffeab0]">อย่างไรก็ตาม แนวทางหรือสถิติย้อนหลังไม่ได้เพิ่มความแน่นอนในการทายผลหวยรอบถัดไป</strong>
        และไม่สามารถรับประกันผลของงวดถัดไปได้ จึงควรใช้เป็นข้อมูลประกอบการตัดสินใจเท่านั้น พร้อมตั้งงบล่วงหน้าและหยุดเมื่อถึงขีดที่ตั้งไว้เสมอ
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/แนวทาง"
          aria-label="เปิดหน้าแนวทางหวยของ หวย365"
          class="flex items-center justify-center rounded-lg border border-[#ffc93c]/35 bg-[#240406] px-8 py-3 font-bold text-[#f6e7e0] transition-all hover:scale-105 hover:border-[#ffc93c] hover:bg-[#180303] hover:text-[#ffeab0]">
          ดูแนวทางหวย
        </a>

        <a
          href="/ตรวจหวย"
          aria-label="เปิดหน้าตรวจผลหวยของ หวย365"
          class="flex items-center justify-center rounded-lg border border-[#ffc93c]/35 bg-[#240406] px-8 py-3 font-bold text-[#f6e7e0] transition-all hover:scale-105 hover:border-[#ffc93c] hover:bg-[#180303] hover:text-[#ffeab0]">
          ตรวจผลหวย
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="อัตราการจ่าย หวย365 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f6e7e0]">
