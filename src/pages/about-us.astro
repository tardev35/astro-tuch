---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login, /register,
// /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx
// ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึง
// เขียนขึ้นใหม่บนข้อเท็จจริงของบรีฟรอบนี้เท่านั้น (src/assets/content.txt)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x4 · h3x0
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) จึงเปิดใช้งานอยู่ และ brand-spec §10 สั่งให้
// คงไว้ ไม่ได้ park ลง src/pages-disabled/
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// ตัวที่ routing จริงคือไฟล์นี้ Astro ไม่อ่านโฟลเดอร์นั้นเลย ห้ามแก้และห้ามลบ
//
// ⚠️ ดรอปนี้ (2026-10-18) คือ **เว็บเกมสล็อตล้วน** ไม่ใช่หมวดอื่นใดทั้งสิ้น
// (สองหน้าของหมวดที่แบรนด์ก่อนๆ เคยเปิดจอดอยู่ใน src/pages-disabled/ ไม่มี route
// ห้ามลิงก์ไปหา เป็น href ตายที่ทำให้ build แดง)
//
// ⚠️ แบรนด์ก่อนหน้า (ที่ถูกแทนที่รอบนี้) ก็เป็นแบรนด์สล็อตเหมือนกัน คอปปี้เดิมจึง
// "ดูเข้าเค้า" ทั้งที่กรอบของบรีฟคนละอัน — **ห้าม find-and-replace ทับประโยคเดิม**
// กรอบของบรีฟรอบนี้คือ "ช่องทางรับบริการจาก ผู้ให้บริการเว็บตรง ลิขสิทธิ์แท้
// ฐานหลักเกมสล็อตออนไลน์ 100%" โดยมีบริการสี่อย่างเป็นแกน: เข้าเล่น · ฝากถอน ·
// ติดต่อ · รับโปรโมชั่น ทั้งหน้าจึงเขียนใหม่รอบกรอบนั้น ไม่ใช่รอบกรอบ
// "ศูนย์ช่วยเหลือ/แจ้งปัญหา" ของรอบก่อน
//
// แง่มุมที่บรีฟรอบนี้ระบุไว้มีเท่านี้ (ห้ามเติมอย่างอื่น): ช่องทางรับบริการ ·
// ผู้ให้บริการเว็บตรง ลิขสิทธิ์แท้ · ฐานหลักเกมสล็อตออนไลน์ 100% · เกมสล็อตออนไลน์ ·
// เข้าเล่น ฝากถอน ติดต่อ รับโปรโมชั่น · เจ้าหน้าที่ · 24 ชั่วโมง · ขอคำแนะนำเกี่ยวกับ
// ขั้นตอนการใช้งาน · ตรวจสอบรายละเอียดบริการ · ข้อกำหนดของเว็บไซต์ · อ่านเงื่อนไข
// ก่อนดำเนินการ · คืนยอดเสีย 0.3% · แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด · ประเภทบัญชี
// ยอดเดิมพัน ระยะเวลาของแคมเปญ · อัตราที่ได้รับ วิธีรับสิทธิ์ เงื่อนไขการใช้งาน ·
// ยอดโบนัส การถอนเงิน ช่วงเวลาสรุปยอด ข้อกำหนดการใช้เครดิต · ผู้แนะนำ หลักเกณฑ์
// การคำนวณโบนัส ประกาศโปรโมชั่นฉบับล่าสุด · สมัครสมาชิก ช่องทางทางการ กรอกข้อมูล
// ให้ถูกต้อง รหัสผ่าน รหัสยืนยัน OTP PIN · LINE Official บัญชีที่แอบอ้าง
// หลักฐานรายการ เวลาตอบกลับ
//
// ตัวเลขที่อ้างได้มีสามตัวของบรีฟเอง: 0.3% · 0.8% · 24 ชั่วโมง ส่วนรายการตัวเลข
// และชื่อเฉพาะที่ห้ามแต่งขึ้นเองอยู่ครบใน brand-spec §7 (ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้
// การ sweep หาคำต้องห้ามของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง)
//
// ประโยคกำกับ (hedge) ที่บรีฟเขียนไว้เองและห้ามตัดทิ้งเพราะฟังดูไม่ขายของ:
// 1) ควรอ่านเงื่อนไขของแต่ละรายการก่อนดำเนินการทุกครั้ง (h1 ย่อหน้าท้าย)
// 2) ควรตรวจสอบข้อมูลบัญชีและรายละเอียดที่เกี่ยวข้องให้ถูกต้อง รวมถึงอ่านข้อกำหนด
//    ของเว็บไซต์ (h2 #1)
// 3) สิทธิ์ที่ได้รับอาจขึ้นอยู่กับประเภทบัญชี ยอดเดิมพัน ระยะเวลาของแคมเปญ ·
//    การได้รับเครดิตคืนไม่ได้เป็นการรับประกันผลการเดิมพันในครั้งต่อไป (h2 #2)
// 4) ควรกรอกข้อมูลให้ถูกต้องและอ่านเงื่อนไขก่อนสมัครทุกครั้ง · ควรใช้ข้อมูลของตนเอง
//    เท่านั้น เก็บรหัสผ่านไว้เป็นความลับ (h2 #3)
// 5) ควรตรวจสอบช่องทาง LINE Official จากหน้าเว็บไซต์ทางการก่อนเพิ่มเพื่อน เพื่อ
//    หลีกเลี่ยงบัญชีที่แอบอ้าง · ควรตรวจสอบเวลาตอบกลับจากประกาศล่าสุด (h2 #4)
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ทองไทยนำ แดงมังกรรอง บนพื้นดำอมแดง**
// ⚠️ สามแบรนด์ก่อนหน้าเป็นแดงทั้งหมด "มีแดงอยู่" จึงไม่ใช่ตัวบอกว่าถูกแบรนด์
// ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน brand-spec §2 (ค่าเดิมไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive) สิ่งที่ทำให้รอบนี้ต่างจริงคือ
// **ทองนำ** กับพื้นดำอมแดง
// ลำดับความลึก: #2b100f ผิวยก (= การ์ด) / #200a09 กลาง / #140505 จม / #1a0505 พื้นเพจ
//
// ลำดับปุ่มสื่อด้วย "ทองถม vs ผิวจมขอบแดง" — คู่พื้น-หมึกคำนวณไว้แล้ว:
// · ปุ่มหลัก (สมัครสมาชิก) ถมทองไล่ #ffdc8c → #f0b429 ขอบ #9a6c0c หมึก #1a0505
//   (9.7:1 บนปลายเข้ม และ 13:1 บนปลายสว่าง) ⚠️ ไล่เฉดต้องหยุดที่ #f0b429
//   ห้ามไล่ลงไปเข้มกว่านั้นใต้ตัวอักษร
// · ปุ่มรอง/ปุ่มลิงก์ภายในเป็นชั้นจม #200a09 → #140505 ขอบ #d30304/55
//   ตัวอักษร #f5ece0 — hover ยกขอบเป็นแดงสว่าง #ff6b6e
// · marker ของลำดับเลขใช้ทองแบรนด์ #f0b429 (8.5:1 บนผิวการ์ด — เป็นตัวอักษร จึงใช้
//   แดงแบรนด์ไม่ได้ และ #ffdc8c สงวนไว้ให้ <strong> เท่านั้น)
// · #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ (§2)
// ⚠️ #d30304 · #a00203 · #4a0202 · #9a6c0c ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่เส้นขอบ
// ออรา เงา และพื้นถม — ออราในไฟล์นี้ใช้ rgba(211,3,4,α) และ rgba(240,180,41,α)
// เท่านั้น และรอบนี้ไม่มีม่วง ไม่มีชมพู ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว ไม่มีส้ม
// (เงินอมฟ้า #cfd9e6 เป็นสีตัวอักษรรองเท่านั้น ไม่ใช่สีระบบ และหน้านี้ไม่ได้ใช้)
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #f5ece0,
// 13.0:1 บนผิวยก #2b100f) ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง
// ปล่อยให้สืบทอดลงมา และไม่ใส่ mx-auto / max-w-* บน <p> เพราะการ์ดคุมความกว้างเองแล้ว
// — ที่ประกาศสีได้มีแค่ปุ่ม (ถมพื้นของตัวเองจึงต้องกำหนดหมึกของตัวเอง) marker ของ
// ลำดับเลข และ <strong> ซึ่ง brand-spec §2 สงวน #ffdc8c (12:1 บนผิวการ์ด) ไว้เป็น
// สีไฮไลต์ในเนื้อความโดยเฉพาะ และไม่ใช้สีอื่นเลย · แต่ละ <strong> ครอบ "ช่วงที่คั่น
// ด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ
// บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง (ลบแท็ก <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิม)
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1 ของดรอปนี้เป็นของ index กับ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้าง
// จากหน้า และ banner2/banner3/slide2/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน
// ห้าม import (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้หมุนมาเป็น AnnouncementPremium ทั้งเว็บ (brand-spec §3)
// orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียก
// แบบ bare ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 157
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} ช่องทางรับบริการจาก ผู้ให้บริการเว็บตรง ลิขสิทธิ์แท้ ฐานหลักเกมสล็อตออนไลน์ รวมเรื่องเข้าเล่น ฝากถอน ติดต่อ และรับโปรโมชั่นไว้ที่เดียว`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} ช่องทางรับบริการจาก ผู้ให้บริการเว็บตรง`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#ffdc8c]">{BRAND_NAME} เป็นช่องทางรับบริการจาก ผู้ให้บริการเว็บตรง ลิขสิทธิ์แท้ ฐานหลักเกมสล็อตออนไลน์ 100%</strong>
        เปิดไว้สำหรับผู้ที่ต้องการเข้าใช้งานเกมสล็อตออนไลน์และสอบถามข้อมูลเกี่ยวกับบริการต่าง ๆ ทั้งการเข้าเล่น ฝากถอน และโปรโมชั่น โดยติดต่อเจ้าหน้าที่ผ่านช่องทางที่เว็บไซต์กำหนดได้โดยตรง
      </p>

      <p>
        หน้านี้รวบรวมไว้ว่าเว็บไซต์เปิดอะไรให้ใช้บ้าง ตั้งแต่บริการหลักสี่อย่างที่ติดต่อได้ ไปจนถึงรายการโปรโมชั่น ขั้นตอนการสมัครสมาชิก และช่องทางติดต่อเจ้าหน้าที่
        <strong class="text-[#ffdc8c]">เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดดูอะไรตรงไหน</strong>
        แล้วจึงค่อยขอคำแนะนำเกี่ยวกับขั้นตอนการใช้งานและตรวจสอบรายละเอียดบริการเป็นรายรายการจากเจ้าหน้าที่
      </p>

      <p>
        เนื้อหาในหน้านี้เขียนไว้เพื่อบอกว่าเว็บไซต์มีอะไรให้ใช้และควรตรวจอะไรก่อนตัดสินใจ ไม่ได้ใช้แทนรายละเอียดและข้อกำหนดที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้งาน
        <strong class="text-[#ffdc8c]">โดยควรอ่านเงื่อนไขของแต่ละรายการก่อนดำเนินการทุกครั้ง</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`${BRAND_NAME} ฐานหลักเกมสล็อตออนไลน์ เข้าเล่น ฝากถอน ติดต่อ รับโปรโมชั่น ได้ 24 ชั่วโมง`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} มีช่องทางให้สอบถามข้อมูลเกี่ยวกับการเข้าเล่นเกมสล็อตออนไลน์ การทำรายการฝากถอน และรายละเอียดโปรโมชั่นผ่านเจ้าหน้าที่ตามเวลาที่เว็บไซต์แจ้งไว้
        <strong class="text-[#ffdc8c]">ผู้ใช้งานสามารถติดต่อเพื่อขอคำแนะนำเกี่ยวกับขั้นตอนการใช้งานหรือเมื่อมีข้อสงสัยเกี่ยวกับเงื่อนไขต่าง ๆ ก่อนทำรายการ</strong>
        บริการที่เว็บไซต์ระบุไว้แบ่งออกได้สี่เรื่องตามนี้
      </p>

      <ul class="flex flex-col gap-3" aria-label={`บริการที่ติดต่อเจ้าหน้าที่ ${BRAND_NAME} ได้`}>
        <li class="flex gap-3">
          <span aria-hidden="true">🎰</span>
          <span>
            <strong class="text-[#ffdc8c]">เข้าเล่น</strong> สอบถามขั้นตอนการเข้าใช้งานเกมสล็อตออนไลน์และวิธีเปิดเกมจากฐานหลักของเว็บไซต์ รวมถึงขอคำแนะนำเมื่อพบปัญหาระหว่างใช้งาน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">💳</span>
          <span>
