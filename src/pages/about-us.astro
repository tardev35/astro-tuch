---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login,
// /register, /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจาก
// เช็กลิสต์หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ (src/assets/content.txt)
// ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึงเขียนจากข้อเท็จจริงและคลังคำของ
// บรีฟรอบนี้เท่านั้น (.claude/brand-spec-ufabet168.md §6)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x4 · h3x0
//   h1  เกี่ยวกับเรา <แบรนด์> ฐานหลักเว็บพนันออนไลน์ แทงบอล สล็อต และบาคาร่า
//   h2  ประเภทเกมเดิมพันที่ <แบรนด์> รวบรวมไว้ให้ศึกษาก่อนใช้งาน
//   h2  โปรโมชั่นของ <แบรนด์> คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%
//   h2  ขั้นตอนสมัครสมาชิกและเข้าสู่ระบบของ <แบรนด์>
//   h2  ช่องทางติดต่อแอดมิน <แบรนด์> ตลอด 24ชม.
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// (ขั้นตอนสมัครสามขั้นของบรีฟลงเป็น <ol> ไม่ใช่สาม h3 เพราะเป็นลำดับขั้น ไม่ใช่
// สามหัวข้อย่อยที่มีบทความของตัวเอง)
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) จึงเปิดใช้งานอยู่
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// เป็นของแบรนด์ JEDI66 เก่ามาก ตัวที่ routing จริงคือไฟล์นี้ Astro ไม่อ่านโฟลเดอร์
// นั้นเลย **ห้ามแก้ ห้ามลบ และห้ามสลับมาแทนไฟล์นี้**
//
// 🚨 แกนของดรอปนี้ (2026-10-22) คือ **เว็บพนันออนไลน์ครบวงจร** — "ฐานหลัก
// เว็บพนันออนไลน์ แทงบอล เล่นสล็อต เว็บตรง100% ไม่ผ่านม้า" ซึ่งรวม **ฟุตบอล +
// สล็อตออนไลน์ + บาคาร่า** ไว้ในเว็บเดียว พร้อมโปรโมชั่นคืนยอดเสีย 0.3% ·
// แนะนำเพื่อน 0.8% · ขั้นตอนสมัคร 3 ขั้น · แอดมิน 24ชม.
// ⚠️⚠️ **รอบก่อน (โปรดี168) เป็นเว็บสล็อตล้วน** คำสโลแกนกลุ่ม "สล็อต + ค่ายตรง +
// ใบอนุญาตเกม + ปีปฏิทิน" ที่เจอในไฟล์นี้จึงเป็นคำค้างของแบรนด์ขาออก ไม่ใช่ของ
// รอบนี้ และสองรอบก่อนเป็นเว็บลอตเตอรี — คำกลุ่มนั้นก็ห้ามหลงเหลือเช่นกัน
// **รายการคำต้องห้ามเต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่** เพื่อไม่ให้
// sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// ⚠️ ต่างจากรอบก่อน: **"แทงบอล / ฟุตบอล / ราคาต่อรอง / บาคาร่า / ไม่ผ่านม้า"
// รอบนี้ใช้ได้** เพราะเป็นคำของบรีฟรอบนี้เอง (content.txt บรรทัด 1-6)
//
// ⚠️⚠️ **/ตรวจหวย กับ /แนวทาง ยังอยู่ใน src/pages-disabled/** → ลิงก์ไปสอง route
// นั้นจะทำให้ build แดง ห้ามเขียนกลับมา
// route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ทดลองเล่น · /about-us · /contact-us · /terms · /privacy · /line
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกม ชื่อธนาคาร ชื่อวอลเล็ต ผู้ให้บริการ
// ใบอนุญาต นิติบุคคล ปีก่อตั้ง จำนวนสมาชิก ค่า RTP หรือยอดฝากขั้นต่ำ แม้แต่
// รายการเดียว** จึงห้ามเขียนลงหน้าเว็บ · ตัวเลขที่ขึ้นหน้าได้มีแค่ของบรีฟเอง:
// **0.3% · 0.8% · 100% · 24ชม. · 3 ขั้นตอน**
//
// คลังคำที่บรีฟรอบนี้ให้มาและใช้ได้เท่านี้: เว็บพนันออนไลน์ · ฐานหลัก · แทงบอล ·
// ฟุตบอล · ราคาต่อรอง · สล็อตออนไลน์ · ธีมและฟีเจอร์ · บาคาร่า · เกมไพ่ ·
// กติกาเฉพาะ · ค่ายเกม · เว็บตรง100% · ไม่ผ่านม้า · บัญชีแอบอ้าง · อัตราจ่าย ·
// เงื่อนไขการเดิมพัน · สมัครสมาชิก · เข้าสู่ระบบ · ฝากถอน · ไม่มีขั้นต่ำ ·
// ไม่จำกัด · โปรโมชั่น · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · โบนัส · เครดิต ·
// ยอดเสีย · รอบเวลาคำนวณ · ลิงก์แนะนำ · เชื่อมโยงบัญชี · คุณสมบัติผู้สมัคร ·
// การเปิดบัญชี · ข้อมูลส่วนบุคคล · รหัสผ่าน · รหัส OTP · แอดมิน · เจ้าหน้าที่ ·
// 24ชม. · เว็บไซต์ทางการ · ประกาศล่าสุด · ชื่อบัญชีปลายทาง · หลักฐานรายการ ·
// ธนาคาร
//
// 🚨 **บรีฟรอบนี้โฆษณาและกำกับข้อควรระวังในย่อหน้าเดียวกัน** — ทั้งสองครึ่งต้อง
// ship ครบตามที่เขียน ประโยคกำกับไม่ใช่ filler ให้ตัดทิ้ง:
// 1) ควรตรวจสอบยอดขั้นต่ำและชื่อบัญชีรับเงินก่อนทำธุรกรรม รวมถึงตรวจสอบข้อมูล
//    ผู้ให้บริการเพื่อหลีกเลี่ยงความเสี่ยงจากบัญชีแอบอ้าง (h1)
// 2) ข้อมูลเกี่ยวกับการเป็นเว็บตรงหรือเชื่อมต่อค่ายเกมโดยตรงควรตรวจสอบจาก
//    หลักฐานของผู้ให้บริการ เพราะไม่สามารถยืนยันได้จากข้อความโฆษณาเพียงอย่างเดียว
//    (h2 #1)
// 3) เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือ
//    รับประกันผลกำไรในอนาคต · แม้ระบุว่าไม่จำกัด แต่ควรยืนยันจำนวนบัญชีที่
//    เข้าร่วม รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุด (h2 #2)
// 4) ไม่ควรใช้ข้อมูลของบุคคลอื่นหรือเปิดเผยรหัส OTP ให้ใครทราบ · จำนวนบัญชีที่
//    เปิดรับต่อวันและข้อจำกัดการสมัครควรตรวจสอบจากประกาศล่าสุดของผู้ให้บริการ
//    (h2 #3)
// 5) ควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยง
//    บัญชีหรือบุคคลที่แอบอ้างชื่อบริการ · หากพบปัญหาเกี่ยวกับธุรกรรม ควรเก็บ
//    หลักฐานรายการและตรวจสอบชื่อบัญชีปลายทางให้ถูกต้อง · ควรตรวจสอบเวลาการ
//    ให้บริการจริงและระยะเวลาตอบกลับจากประกาศล่าสุดอีกครั้ง (h2 #4)
// ⚠️ บรีฟไม่ได้การันตีผลลัพธ์ใดๆ — คอปปี้หน้านี้จึงไม่สัญญากำไรและไม่สัญญาว่า
// ถอนได้ชัวร์
//
// 🚨 พาเลตรอบนี้ (brand-spec §2) **กลับมาเป็นธีมมืด** หลังสามรอบติดที่เป็น
// ธีมสว่าง bg.json ของดรอปนี้คือ {"mode":"color","color":"#000000"} = ดำสนิท
// **ห้าม "แก้" กลับไปเป็นพื้นสว่างเพราะรอบก่อนๆ เป็นแบบนั้น**
// ค่าที่ใช้ได้ในไฟล์นี้: ทองคานารี #fee45d (<strong>/marker/ตัวอักษรบนอินเซ็ต —
// 14.8:1 บนผิวการ์ด) · หมึกครีม #eae3d4 (เนื้อความ = BRAND_TEXT, 14.6:1) ·
// ทองกลาง #e6a416 (ขอบ/ออรา/stop กลางของปุ่ม, 8.7:1) · ทองลึก #b8780d (stop
// ปลายของปุ่ม/ขอบหนัก, 5.2:1) · หมึกเข้ม #140e02 (ตัวอักษรบนพื้นถมทอง) ·
// โครเมียม #e8ecf1 / #a8b2bf / #78828f (ปุ่มรอง) + หมึก #0b0d10 บนพื้นโครเมียม ·
// อินเซ็ต #0a0908 / อินเซ็ตอุ่น #1e1a13 / ผิวการ์ด #15130f / พื้นเพจ #000000
// 🚨 **ทองมืด 7a4e05 และโครเมียมมืด 5a6472 ห้ามถือตัวอักษร** เป็นขอบ/พื้นเท่านั้น
// 🚨 **#15130f #1e1a13 #0a0908 ห้ามถือตัวอักษร** เป็นสีผิวเท่านั้น
// 🚨 สีไฮไลต์ <strong> ในเนื้อความมีตัวเดียวคือ **ทองคานารี #fee45d**
// 🚨 **ห้ามสลับเป็นตัวอักษรขาวบนพื้นถมทอง** — ปุ่มทองใช้หมึกเข้ม #140e02 เสมอ
// ออราที่อนุญาต: rgba(254,228,93,α) · rgba(230,164,22,α) · rgba(168,178,191,α) ·
// rgba(0,0,0,α)
// ⚠️ รอบนี้ไม่มีแดง ไม่มีเขียว (ยกเว้น LINE green) ไม่มีชมพู ไม่มีฟ้า/น้ำเงิน/
// ไซยาน ไม่มีม่วง ไม่มีโรสโกลด์ ไม่มีทองแดงไหม้ ·
// #00B900 บนปุ่ม LINE เป็นสีประจำแพลตฟอร์ม ไม่ใช่สีของเว็บ ห้ามเปลี่ยนเป็นทอง
// ⚠️ **ทองนำมาแล้วเกือบทุกแบรนด์ในรีโปนี้** การเจอทองในไฟล์จึงไม่พิสูจน์อะไร —
// **ห้ามเทียบด้วยวงศ์สี ต้องเทียบทีละค่า** กับตาราง brand-spec §2 สิ่งที่แยก
// รอบนี้คือ ทองคานารี #fee45d + **โครเมียมเงินเป็นสีที่สอง** (มาจากเลข "168"
// ในโลโก้) + พื้นดำสนิท
//
// ลำดับปุ่มในไฟล์นี้สื่อด้วยพื้นถมสามขั้ว:
// · ปุ่มหลัก (สมัครสมาชิก) ถมไล่เฉดทอง #fee45d -> #e6a416 -> #b8780d หมึก #140e02
// · ปุ่มรอง (เข้าสู่ระบบ) ถมไล่เฉดโครเมียม #e8ecf1 -> #a8b2bf -> #78828f หมึก #0b0d10
// · ปุ่มลิงก์ภายในเป็นอินเซ็ต #0a0908 ขอบทองโปร่ง ตัวอักษรทองคานารี
//   hover ยกขอบเป็นทองทึบ (ตรงกับ hover ของการ์ด ContentBox)
// · ชิปไอคอนของรายการใช้ทองกลางเป็น **เส้นขอบ** บนอินเซ็ตอุ่น #1e1a13 ไม่ถือตัวอักษร
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT
// #eae3d4, 14.6:1 บนผิวการ์ด) ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่ประกาศสี
// ของตัวเอง ปล่อยให้สืบทอดลงมา และไม่ใส่ mx-auto / max-w-* บน <p> เพราะการ์ดคุม
// ความกว้างเองแล้ว (เพิ่มไปจะเหมือนย่อหน้าเยื้อง) — ที่ประกาศสีได้มีแค่ปุ่ม
// (ถมพื้นของตัวเองจึงต้องกำหนดหมึกของตัวเอง) ชิปไอคอน marker ของลำดับเลข และ
// <strong> ซึ่ง brand-spec §2 สงวนทองคานารี #fee45d ไว้เป็นสีไฮไลต์ในเนื้อความ
// เพียงสีเดียว · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะ
// ภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะ
// ขาดครึ่ง (ลบแท็ก <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิม) และห้ามวาง
// <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังใน prop ที่เป็นข้อความ
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: ดรอปนี้ไม่มี article illustration เลย
// (banner2/banner3 เป็นอาร์ตเวิร์กของแบรนด์คนละราย เก่าทั้งคู่) ส่วน
// slide1/slide2 ถูกตรึงไว้กับ index กับ /promotion และ banner1 /
// banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// slide3/slide4 เป็นโปสเตอร์ของอีกแบรนด์ ห้าม import (ลำพังการ import ก็ทำให้
// ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง) — ไฟล์ยังอยู่บนดิสก์ ห้ามลบ
//
// Announcement รอบนี้หมุนมาเป็น Announcement3 ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ AnnouncementPremium จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์
// นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว จึงเรียกแบบ bare **ห้ามส่ง prop message**
// มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 153 อักขระ (ชื่อแบรนด์รอบนี้ 8 ตัวอักษร) เป็นประโยคเดียวที่บอกว่า
// หน้านี้มีอะไร แล้วหยุด
// (Google ตัดราว 155 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} หน้ารวมข้อมูลเกมเดิมพันที่เว็บไซต์ระบุไว้ ทั้งแทงบอล สล็อตออนไลน์ บาคาร่า โปรโมชั่น ขั้นตอนสมัครสมาชิก และช่องทางติดต่อแอดมิน 24ชม.`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} ฐานหลักเว็บพนันออนไลน์ แทงบอล สล็อต และบาคาร่า`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#fee45d]">{BRAND_NAME} นำเสนอช่องทางบริการเกมเดิมพันออนไลน์ที่รวบรวมฟุตบอล สล็อต และบาคาร่าไว้ในเว็บไซต์เดียว</strong>
        พร้อมเมนูสมัครสมาชิก ฝากถอน และตรวจสอบโปรโมชั่น หน้านี้รวบรวมไว้ว่าเว็บไซต์ระบุอะไรไว้บ้าง เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดอ่านอะไรตรงไหน
        แล้วจึงค่อยไล่อ่านรายละเอียดของแต่ละหัวข้อเป็นรายข้อ
      </p>

      <p>
        สิ่งที่หน้านี้ทำได้คือชี้ว่าข้อมูลแต่ละชุดอยู่ตรงไหนและควรอ่านอะไรก่อน ผู้ใช้งานสามารถศึกษารายละเอียดเกมและเงื่อนไขการทำรายการได้จากช่องทางที่เว็บไซต์กำหนด
        <strong class="text-[#fee45d]">โดยควรตรวจสอบยอดขั้นต่ำและชื่อบัญชีรับเงินก่อนทำธุรกรรมทุกครั้ง</strong>
        เพราะเป็นรายละเอียดที่เว็บไซต์กำหนดไว้เอง และปรับเปลี่ยนได้ตามประกาศ
      </p>

      <p>
        เนื้อหาในหน้านี้เขียนไว้ประกอบการใช้งานเท่านั้น ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้บริการ
        <strong class="text-[#fee45d]">รวมถึงควรตรวจสอบข้อมูลผู้ให้บริการเพื่อหลีกเลี่ยงความเสี่ยงจากบัญชีแอบอ้าง</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`ประเภทเกมเดิมพันที่ ${BRAND_NAME} รวบรวมไว้ให้ศึกษาก่อนใช้งาน`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        {BRAND_NAME} นำเสนอข้อมูลเกมเดิมพันออนไลน์หลายประเภทไว้ในเว็บไซต์เดียว
        <strong class="text-[#fee45d]">ทั้งฟุตบอลที่มีรูปแบบราคาต่อรองแตกต่างกัน สล็อตออนไลน์ที่มีธีมและฟีเจอร์ให้ศึกษา และบาคาร่าเกมไพ่ที่มีกติกาเฉพาะ</strong>
        รายการด้านล่างคือชุดข้อมูลที่ควรไล่อ่านให้ครบก่อนเลือกใช้งาน เพราะแต่ละหมวดวางเงื่อนไขของตัวเองไว้ไม่เหมือนกัน
      </p>

      <ul class="flex flex-col gap-4" aria-label="ประเภทเกมเดิมพันและข้อมูลที่เว็บไซต์ระบุไว้ให้ศึกษา">
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#e6a416]/50 bg-[#1e1a13] text-sm">⚽</span>
          <span>
            <strong class="text-[#fee45d]">แทงบอล</strong> ควรดูว่าคู่ที่สนใจเปิดราคาต่อรองไว้รูปแบบใด และรูปแบบนั้นคิดผลอย่างไร เพราะฟุตบอลแต่ละรายการวางราคาต่อรองไว้ต่างกัน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#e6a416]/50 bg-[#1e1a13] text-sm">🎰</span>
          <span>
            <strong class="text-[#fee45d]">สล็อตออนไลน์</strong> ควรอ่านว่าเกมที่เลือกวางธีมและฟีเจอร์ไว้อย่างไร และฟีเจอร์นั้นมีเงื่อนไขการเข้าถึงหรือไม่ ก่อนเริ่มใช้งาน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#e6a416]/50 bg-[#1e1a13] text-sm">🃏</span>
          <span>
            <strong class="text-[#fee45d]">บาคาร่า</strong> เป็นเกมไพ่ที่มีกติกาเฉพาะของตัวเอง จึงควรอ่านกติกาและวิธีนับผลให้ชัดเจนก่อน ไม่ควรเทียบจากเกมหมวดอื่น
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#e6a416]/50 bg-[#1e1a13] text-sm">📋</span>
          <span>
            <strong class="text-[#fee45d]">ค่ายเกม อัตราจ่าย และเงื่อนไขการเดิมพัน</strong> ควรตรวจสอบรายชื่อค่ายเกมที่เปิดให้บริการจริง พร้อมอัตราจ่ายของรายการนั้นก่อนใช้งาน
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#fee45d]">ส่วนข้อมูลเกี่ยวกับการเป็นเว็บตรง100% หรือเชื่อมต่อค่ายเกมโดยตรง ควรตรวจสอบจากหลักฐานของผู้ให้บริการ</strong>
        เพราะไม่สามารถยืนยันได้จากข้อความโฆษณาเพียงอย่างเดียว และรายการที่เปิดให้บริการปรับเปลี่ยนได้ตามประกาศล่าสุดของเว็บไซต์
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/ทดลองเล่น"
          aria-label={`เปิดหน้าทดลองเล่นของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#e6a416]/45 bg-[#0a0908] px-8 py-3 font-bold text-[#fee45d] shadow-[0_4px_14px_rgba(0,0,0,0.5)] transition-all hover:scale-105 hover:border-[#fee45d] hover:shadow-[0_6px_18px_rgba(254,228,93,0.25)]">
          ไปหน้าทดลองเล่น
        </a>

        <a
          href="/ทางเข้า"
          aria-label={`เปิดหน้าทางเข้าของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#e6a416]/45 bg-[#0a0908] px-8 py-3 font-bold text-[#fee45d] shadow-[0_4px_14px_rgba(0,0,0,0.5)] transition-all hover:scale-105 hover:border-[#fee45d] hover:shadow-[0_6px_18px_rgba(254,228,93,0.25)]">
          ไปหน้าทางเข้า
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`โปรโมชั่นของ ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} นำเสนอโปรโมชั่นสำหรับสมาชิกที่สนใจตรวจสอบสิทธิพิเศษจากการใช้บริการ โดยรายการที่ระบุไว้ประกอบด้วย
        <strong class="text-[#fee45d]">รายการคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8%</strong>
        ซึ่งแต่ละรายการอาจมีเงื่อนไขเกี่ยวกับประเภทเกม ยอดที่นำมาคำนวณ และรอบเวลารับเครดิตแตกต่างกัน ก่อนเข้าร่วมจึงควรอ่านประกาศล่าสุดให้ครบถ้วน รวมถึงตรวจสอบข้อจำกัดจำนวนบัญชีและการใช้โปรโมชั่นร่วมกัน
      </p>

      <p>
        รายการคืนยอดเสียระบุการคืนเครดิตตามยอดเสียที่เข้าเงื่อนไขในแต่ละวัน
        <strong class="text-[#fee45d]">สมาชิกควรตรวจสอบว่าการเดิมพันฟุตบอล สล็อต หรือบาคาร่าเข้าร่วมรายการใดบ้าง มีรอบเวลาคำนวณยอดเมื่อใด และรับเครดิตด้วยวิธีไหน</strong>
        รวมถึงศึกษาข้อกำหนดเกี่ยวกับการใช้เครดิตและการถอนเงินก่อนรับสิทธิ์ ทั้งนี้ เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือรับประกันผลกำไรในอนาคต
      </p>

      <p>
        ส่วนรายการแนะนำเพื่อนระบุสิทธิ์ไว้สำหรับสมาชิกที่แนะนำผู้ใช้งานรายใหม่ โดยควรตรวจสอบวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และยอดที่ใช้คำนวณโบนัสให้ครบถ้วน
        <strong class="text-[#fee45d]">แม้โปรโมชั่นจะระบุว่าไม่จำกัด แต่สมาชิกควรยืนยันข้อกำหนดเกี่ยวกับจำนวนบัญชีที่เข้าร่วม รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุด</strong>
        เพื่อให้ทราบหลักเกณฑ์การรับสิทธิ์อย่างถูกต้อง และไม่เกิดความเข้าใจคลาดเคลื่อนเกี่ยวกับยอดเครดิตที่ได้รับ
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/promotion"
          aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#e6a416]/45 bg-[#0a0908] px-8 py-3 font-bold text-[#fee45d] shadow-[0_4px_14px_rgba(0,0,0,0.5)] transition-all hover:scale-105 hover:border-[#fee45d] hover:shadow-[0_6px_18px_rgba(254,228,93,0.25)]">
          ดูภาพโปรโมชั่น
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`ขั้นตอนสมัครสมาชิกและเข้าสู่ระบบของ ${BRAND_NAME}`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} มีช่องทางสำหรับผู้ที่ต้องการศึกษาวิธีสมัครสมาชิกและเข้าสู่ระบบเกมเดิมพันออนไลน์
        <strong class="text-[#fee45d]">ก่อนลงทะเบียนควรตรวจสอบคุณสมบัติผู้สมัคร อายุที่ได้รับอนุญาต และข้อกำหนดการเปิดบัญชีจากเว็บไซต์ทางการให้ครบถ้วน</strong>
        ลำดับด้านล่างคือ 3 ขั้นตอนที่เว็บไซต์ระบุไว้
      </p>

      <ol class="ml-6 list-decimal space-y-3 marker:font-black marker:text-[#fee45d]">
        <li>
          <strong class="text-[#fee45d]">เข้าสู่หน้าสมัครสมาชิก</strong> ตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง จากนั้นเลือกเมนูสมัครสมาชิกและอ่านรายละเอียดเกี่ยวกับเงื่อนไขการเปิดบัญชี รวมถึงนโยบายการจัดเก็บข้อมูลส่วนบุคคล
        </li>
        <li>
          <strong class="text-[#fee45d]">กรอกข้อมูลและยืนยันบัญชี</strong> กรอกข้อมูลตามที่ระบบกำหนด ตรวจสอบความถูกต้องก่อนยืนยัน และตั้งรหัสผ่านที่ปลอดภัย ไม่ควรใช้ข้อมูลของบุคคลอื่นหรือเปิดเผยรหัส OTP ให้ใครทราบ
        </li>
        <li>
          <strong class="text-[#fee45d]">เข้าสู่ระบบและตรวจสอบรายละเอียดบริการ</strong> หลังลงทะเบียนเรียบร้อย สามารถศึกษาประเภทเกม กติกา อัตราเดิมพัน และเงื่อนไขฝากถอนก่อนใช้งาน
          หากพบข้อสงสัยควรสอบถามเจ้าหน้าที่ผ่านช่องทางทางการ
        </li>
      </ol>

      <p>
        <strong class="text-[#fee45d]">ส่วนจำนวนบัญชีที่เปิดรับต่อวันและข้อจำกัดการสมัคร ควรตรวจสอบจากประกาศล่าสุดของผู้ให้บริการโดยตรง</strong>
        เพราะเป็นเงื่อนไขที่ปรับเปลี่ยนได้ตามที่เว็บไซต์กำหนด และไม่ใช่สิ่งที่หน้านี้ยืนยันแทนได้
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#b8780d] bg-gradient-to-b from-[#fee45d] via-[#e6a416] to-[#b8780d] px-8 py-3 font-black text-[#140e02] shadow-[0_0_14px_rgba(254,228,93,0.4)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#78828f] bg-gradient-to-b from-[#e8ecf1] via-[#a8b2bf] to-[#78828f] px-8 py-3 font-bold text-[#0b0d10] shadow-[0_0_12px_rgba(168,178,191,0.35)] transition-transform hover:scale-105">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`ช่องทางติดต่อแอดมิน ${BRAND_NAME} ตลอด 24ชม.`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} ระบุช่องทางติดต่อเจ้าหน้าที่สำหรับผู้ใช้งานที่ต้องการสอบถามเกี่ยวกับการสมัครสมาชิก การเข้าสู่ระบบ รายการฝากถอน และรายละเอียดโปรโมชั่น
        <strong class="text-[#fee45d]">โดยควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีหรือบุคคลที่แอบอ้างชื่อบริการ</strong>
        หากพบปัญหาเกี่ยวกับธุรกรรม ควรเก็บหลักฐานรายการและตรวจสอบชื่อบัญชีปลายทางให้ถูกต้อง โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น
      </p>

      <p>
        <strong class="text-[#fee45d]">ทั้งนี้ ควรตรวจสอบเวลาการให้บริการจริงและระยะเวลาตอบกลับจากประกาศล่าสุดอีกครั้ง</strong>
        เพราะช่วงเวลาที่เจ้าหน้าที่รับเรื่องอาจปรับเปลี่ยนได้ตามที่ผู้ให้บริการกำหนด หากพบความผิดปกติของรายการโอน ควรหยุดทำธุรกรรมและติดต่อธนาคาร
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/line"
          aria-label={`ติดต่อเจ้าหน้าที่ ${BRAND_NAME} ผ่าน Line Official`}
          class="flex items-center justify-center gap-2 rounded-lg border border-[#00B900] bg-[#00B900] px-8 py-3 font-black text-white shadow-[0_0_15px_rgba(0,185,0,0.35)] transition-transform hover:scale-105">
          <span aria-hidden="true">💬</span>
          ติดต่อผ่าน Line Official
        </a>

        <a
          href="/contact-us"
          aria-label={`ดูช่องทางติดต่อทีมงาน ${BRAND_NAME} ทั้งหมด`}
