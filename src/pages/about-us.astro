---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login,
// /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx
// ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึง
// เขียนขึ้นใหม่บนข้อเท็จจริงของ NATO168 เท่านั้น (src/assets/content.txt)
// ผังหัวข้อของหน้านี้: h1x1 · h2x4 · h3x0
//
// ดรอปนี้ (2026-10-02) คือ NATO168 **เว็บสล็อตออนไลน์ / พีจีเว็บตรง** แง่มุมที่บรีฟ
// ระบุไว้มีเท่านี้: รวมสล็อตพีจีและเกมจากค่ายที่เว็บไซต์เปิดรองรับไว้ในบัญชีเดียว ·
// เข้าเล่นผ่านมือถือได้โดยไม่ต้องสลับหลายแพลตฟอร์ม · หมวดโบนัสไทม์สำหรับติดตามเกม
// และกิจกรรมที่เปิดสิทธิ์ในแต่ละช่วง · รูปแบบเกมตั้งแต่วงล้อทั่วไป ฟรีสปิน ตัวคูณ
// ไปจนถึงเกมที่มีฟีเจอร์โบนัส · คืนยอดเสีย โบนัส 0.3% · แนะนำเพื่อน โบนัส 0.8% ·
// สมัครผ่านมือถือ 3 ขั้นตอน · แอดมิน 24 ชั่วโมง · ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP
//
// แบรนด์ก่อนหน้า (NAZA99) เป็นเว็บสล็อตเหมือนกัน แต่บรีฟของมันเอ่ย **ชื่อเกมจริง
// สามเกม** (Mahjong Ways 2 / Fortune Tiger / Sweet Bonanza) ซึ่งบรีฟรอบนี้ไม่ได้
// ระบุไว้เลย — ย่อหน้าและรายการของสามเกมนั้นถูกถอดออก **ทั้งก้อน** แล้วเขียนใหม่
// เป็นรูปแบบ/ฟีเจอร์ของเกมตามที่บรีฟพูดถึงจริง ไม่ใช่ find-and-replace ทับประโยคเดิม
// เพราะการคงโครงประโยคเดิมไว้แล้วสลับแต่ชื่อแบรนด์ คือวิธีที่ทำให้เว็บใหม่ไปอ้าง
// สินค้า/ชื่อเกมที่บรีฟของตัวเองไม่ได้ให้มา
//
// ตัวเลขที่อ้างได้มีแค่ 0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง
// ห้ามเพิ่มใบอนุญาต ชื่อค่ายเกม ชื่อเกม ชื่อผู้ให้บริการ ชื่อธนาคาร ยอดฝากขั้นต่ำ
// จำนวนสมาชิก ปีที่ก่อตั้ง หรือค่า RTP ที่บรีฟไม่ได้ระบุ
//
// ประโยค hedge ที่บรีฟเขียนกำกับไว้เองและห้ามตัดทิ้งเพราะฟังดูลบ: คำว่า
// "รับโบนัสทุกยูส" และ "ไม่มีล็อคยูส" ควรอ้างอิงเงื่อนไขจริงของเว็บไซต์ เพราะบาง
// โปรโมชั่นอาจกำหนดประเภทสมาชิก เกมที่ร่วมรายการ หรือยอดที่ใช้คำนวณต่างกัน ·
// แต่ละรายการอาจมีเงื่อนไขเรื่องค่ายเกม รอบคำนวณ หรือยอดที่นำมาคิดโบนัส จึงควร
// ตรวจสอบก่อนกดรับทุกครั้ง · ควรอ่านกติกา ฟีเจอร์ ช่วงเดิมพัน และกำหนดงบก่อนเริ่ม
//
// พาเลตต์ NATO168 (brand-spec §2) **ทอง + เงิน บนดำ** — เงินคือฮิวที่สองจริง ไม่ใช่
// ทองอีกเฉด: ทองอ่อน #fde8a8 (หมึกเน้น/หัวไล่เฉด) · ทองแบรนด์ #edb543 (จุด bullet,
// marker, ขอบ) · ทองลึก #a9761f (ปลายไล่เฉดปุ่มหลัก/ขอบลึก) · เงิน #e6e6e6 (ปุ่มรอง
// ทั้งขอบและตัวอักษร = ครึ่งเงินของเวิร์ดมาร์ก) · ผิวยกระดับอุ่น #17120a ·
// ผิวทอง #241a09 · หมึกบนพื้นทอง #1a1203 · เนื้อความ #f4ead3 (BRAND_TEXT)
// ชุดทองล้วนของ NAZA99 (#e4b34d #fdf2ac #fef1a5 #c08f2b #8a5f12 #140c02 #241404
// #1a1000 #f3e8cf rgba(228,179,77,*) rgba(10,5,1,*)) ออกครบทุกจุดแล้ว
// #00B900/#009900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้
// กฎคอนทราสต์: พื้นทอง → หมึกเข้ม #1a1203 เสมอ ห้ามกลับด้านเอาหมึกอ่อนวางบนทอง
// ปุ่มรองเป็น "ขอบเงินบนพื้นดำ" ไม่ใช่ถมทองอีกใบ สองปุ่มถมทองจะอ่านเป็นก้อนเดียว
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// — การ์ดตั้งสีเนื้อความไว้แล้ว ย้ำบนย่อหน้าอีกชั้นเพื่อให้สี body copy อ่านออกจาก
// ตัวหน้าเอง
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจาก
// หน้า และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น Announcement5 ทั้งเว็บ (รอบก่อน NAZA99 ใช้
// AnnouncementPremium) — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ
// NATO168 แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูดคนละเรื่อง
// กับหน้าอื่น
//
// รอบนี้สองเราต์ล็อตเตอรี่ของแบรนด์ก่อนถูกพาร์คไว้ใน src/pages-disabled/ แล้ว
// ห้ามสร้างลิงก์ไปสองเส้นทางนั้นจากหน้านี้ (href ไปหน้าที่ไม่มีอยู่ = build แดง)
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 158
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "เกี่ยวกับเรา NATO168 เว็บสล็อตพีจีเว็บตรงสำหรับมือใหม่ หน้านี้สรุปว่าในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่หมวดเกมและโบนัสไทม์ โปรโมชั่น จนถึงแอดมิน 24 ชั่วโมง";

const pageTitle = "เกี่ยวกับเรา NATO168 เว็บสล็อตพีจีเว็บตรง รวมเกมจากค่ายที่เปิดรองรับไว้ในบัญชีเดียว";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed text-[#f4ead3]">
        <strong class="text-[#fde8a8]">{BRAND_NAME} คือเว็บสล็อตออนไลน์ที่รวมสล็อตพีจีและเกมจากค่ายที่เว็บไซต์เปิดรองรับไว้ในบัญชีเดียว</strong>
        จุดตั้งต้นของเว็บไซต์คือผู้ที่อยากเริ่มเล่นผ่านระบบที่ใช้งานไม่ซับซ้อน จึงเข้าเล่นผ่านเบราว์เซอร์บนมือถือได้โดยไม่ต้องสลับหลายแพลตฟอร์ม และไม่ต้องจำทางเข้าแยกต่อค่ายเกม
      </p>

      <p class="text-left text-base leading-relaxed text-[#f4ead3]">
        หน้านี้สรุปไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่หมวดเกมสล็อตและฟีเจอร์ที่แต่ละเกมมี
        <strong class="text-[#fde8a8]">หมวดโบนัสไทม์สำหรับติดตามเกมและกิจกรรมที่เปิดสิทธิ์ในแต่ละช่วง</strong>
        โปรโมชั่นคืนยอดเสีย โบนัส 0.3% และกิจกรรมแนะนำเพื่อน โบนัส 0.8% ขั้นตอนสมัครแบบ 3 ขั้นตอน ไปจนถึงช่องทางติดต่อแอดมินที่ดูแลตลอด 24 ชั่วโมงเมื่อไม่แน่ใจในขั้นตอนใด
      </p>

      <p class="text-left text-base leading-relaxed text-[#f4ead3]">
        สมาชิกใหม่ตรวจสอบโบนัส เกมยอดนิยม เครดิต และรายละเอียดโปรโมชั่นได้จากบัญชีของตนเองก่อนเริ่มเล่นได้ทันที
        <strong class="text-[#fde8a8]">คำว่า “รับโบนัสทุกยูส” และ “ไม่มีล็อคยูส” ควรอ้างอิงเงื่อนไขจริงของเว็บไซต์</strong>
        เพราะบางโปรโมชั่นอาจกำหนดประเภทสมาชิก เกมที่ร่วมรายการ หรือยอดที่ใช้คำนวณแตกต่างกัน
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`ทางเข้าเล่นและหมวดเกมสล็อตของ ${BRAND_NAME} ที่เลือกได้จากบัญชีเดียว`} as="h2">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed text-[#f4ead3]">
        ทางเข้าเล่น {BRAND_NAME}
        <strong class="text-[#fde8a8]">รองรับการเข้าสู่ระบบผ่านเว็บเบราว์เซอร์ทั้งบนมือถือและคอมพิวเตอร์</strong>
        หลัง Login จึงเลือกสล็อตพีจี รวมถึงเกมสล็อตจากค่ายอื่นที่เปิดให้บริการได้จากบัญชีเดียว โดยรูปแบบเกมที่เว็บไซต์จัดไว้ให้เลือกแบ่งออกได้ประมาณนี้
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f4ead3]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#edb543]">🎰</span>
          <span>
            <strong class="text-[#fde8a8]">สล็อตวงล้อแบบทั่วไป</strong> เป็นกลุ่มที่กติกาอ่านจบได้ในรอบเดียว เหมาะกับมือใหม่ที่ต้องการเริ่มจากเกมที่มีรายละเอียดไม่มาก แล้วค่อยขยับไปเกมที่มีฟีเจอร์ซ้อนกันหลายชั้น
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#edb543]">🌀</span>
          <span>
            <strong class="text-[#fde8a8]">เกมที่มีฟรีสปิน</strong> จะมีรอบหมุนที่เข้าเงื่อนไขของตัวเกมเอง ทำให้แต่ละรอบมีจังหวะให้ติดตามต่างจากการปั่นปกติ ควรดูจากรายละเอียดฟีเจอร์ของเกมนั้นว่าเข้าเงื่อนไขอย่างไร
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#edb543]">✖️</span>
          <span>
            <strong class="text-[#fde8a8]">เกมที่มีตัวคูณ</strong> จะคิดผลของรอบนั้นจากตัวคูณที่เกมแสดงไว้ รูปแบบการนับจึงไม่เหมือนกันทุกเกม ควรอ่านวิธีคิดของตัวเกมก่อนเลือกช่วงเดิมพัน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#edb543]">🎁</span>
          <span>
            <strong class="text-[#fde8a8]">เกมที่มีฟีเจอร์โบนัสในตัว</strong> คือกลุ่มที่มีรอบพิเศษแยกจากรอบหลัก และเป็นกลุ่มที่หมวดโบนัสไทม์มักหยิบมาแสดงพร้อมกิจกรรมที่เปิดสิทธิ์ในช่วงนั้น
          </span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#f4ead3]">
        <strong class="text-[#fde8a8]">จำนวนเกมและช่วงเวลาอัปเดตขึ้นอยู่กับค่ายและผู้ให้บริการ</strong>
        หากมีเกมเพิ่มเข้ามาระหว่างเดือน ให้ดูจากรายการที่ระบบแสดงไว้ในหมวดเกมหรือหมวดโบนัสไทม์เป็นหลัก และควรอ่านกติกา ฟีเจอร์ รวมถึงช่วงเดิมพันของแต่ละเกม พร้อมกำหนดงบก่อนเริ่มทุกครั้ง
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/ทดลองเล่น"
          aria-label={`เปิดหน้าทดลองเล่นสล็อตของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#e6e6e6]/45 bg-[#17120a] px-8 py-3 font-bold text-[#e6e6e6] transition-all hover:scale-105 hover:border-[#e6e6e6] hover:bg-[#241a09] hover:text-[#fde8a8]">
          ไปหน้าทดลองเล่นสล็อต
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย โบนัส 0.3% และแนะนำเพื่อน โบนัส 0.8%`} as="h2">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed text-[#f4ead3]">
        โปรโมชั่น {BRAND_NAME}
        <strong class="text-[#fde8a8]">มีสิทธิ์หลักอยู่สองรายการให้สมาชิกติดตามตลอดเดือน</strong>
        คือโบนัสคืนยอดเสียและโบนัสแนะนำเพื่อน สามารถ Login เพื่อตรวจสอบโปรโมชั่น ยอดที่เข้าเกณฑ์ และรอบรับโบนัสได้จากบัญชีสมาชิกโดยตรง
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f4ead3]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#edb543]">💰</span>
          <span>
            <strong class="text-[#fde8a8]">คืนยอดเสีย โบนัส 0.3%</strong> สำหรับสมาชิกที่มียอดเสียตรงตามข้อกำหนดตามรอบที่เว็บไซต์กำหนด ระบบจะนำเฉพาะยอดที่เข้าเงื่อนไขมาคำนวณและแสดงโบนัสที่มีสิทธิ์รับ ก่อนกดรับควรตรวจสอบค่ายเกมและรอบตัดยอดให้ครบถ้วน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#edb543]">🤝</span>
          <span>
