---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login, /register,
// /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx
// ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึง
// เขียนขึ้นใหม่จากข้อเท็จจริงและคลังคำของบรีฟรอบนี้เท่านั้น (src/assets/content.txt)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x4 · h3x0
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) จึงเปิดใช้งานอยู่ และ brand-spec สั่งให้คงไว้
// ไม่ได้ park ลง src/pages-disabled/
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// ตัวที่ routing จริงคือไฟล์นี้ Astro ไม่อ่านโฟลเดอร์นั้นเลย ห้ามแก้และห้ามลบ
//
// ⚠️ ดรอปนี้ (2026-10-18) คือ **เว็บเกมสล็อตล้วน** ไม่ใช่หมวดอื่นใดทั้งสิ้น
// สองหน้าของหมวดที่แบรนด์ก่อนๆ เคยเปิดจอดอยู่ใน src/pages-disabled/ ไม่มี route
// ห้ามลิงก์ไปหา เป็น href ตายที่ทำให้ build แดง route ที่มีจริงรอบนี้คือ
// / · /about-us · /contact-us · /login · /register · /privacy · /promotion ·
// /terms · /ทดลองเล่น · /ทางเข้า · /line
//
// ⚠️ แบรนด์ก่อนหน้า (ที่ถูกแทนที่รอบนี้) ก็เป็นแบรนด์สล็อตเหมือนกัน คอปปี้เดิมจึง
// "ดูเข้าเค้า" ทั้งที่กรอบของบรีฟคนละอัน — **ห้าม find-and-replace ทับประโยคเดิม**
// ทั้งหน้าถูกเขียนใหม่รอบกรอบของบรีฟรอบนี้: "ศูนย์รวมช่องทางบริการเกมสล็อตออนไลน์"
// ที่จัดเมนูสี่อย่างไว้ในเว็บไซต์เดียว — สมัครสมาชิก · เข้าเล่น · ฝากถอน ·
// ติดต่อเจ้าหน้าที่ ไม่ใช่กรอบ "ศูนย์ช่วยเหลือ/แจ้งปัญหา" ของรอบก่อน
// (คำต้องห้ามไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive
// ในคอมเมนต์ของไฟล์นี้เอง — รายการเต็มอยู่ใน brand-spec §6)
//
// แง่มุมที่บรีฟรอบนี้ระบุไว้มีเท่านี้ (ห้ามเติมอย่างอื่น): ศูนย์บริการหลัก ·
// ศูนย์รวมช่องทางบริการ · เกมสล็อตออนไลน์ · ลิขสิทธิ์เว็บแท้100% · สมัครสมาชิก ·
// ลงทะเบียนสมาชิก · เข้าเล่น · เข้าสู่ระบบ · ฝากถอน · รายการฝากถอน ·
// ติดต่อเจ้าหน้าที่ · โปรโมชั่น · รับโปร · 24 ชั่วโมง · คืนยอดเสีย 0.3% ·
// แนะนำเพื่อน 0.8% · เครดิต · รอบเวลาคำนวณยอด · ประเภทเกมที่ร่วมรายการ ·
// เงื่อนไขการใช้โบนัส · รหัสแนะนำ · การเชื่อมโยงบัญชี · รอบจ่ายโบนัส ·
// LINE Official · QR Code · บัญชีปลอม · ผู้แอบอ้าง · หลักฐานรายการ · รหัสผ่าน ·
// รหัส OTP · ข้อมูลผู้ให้บริการ · หลักฐานทางการ · คุณสมบัติผู้สมัคร ·
// ข้อกำหนดในการเปิดบัญชี · ระยะเวลาตอบกลับ
//
// ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 24 ชั่วโมง · 100% · 3 ขั้นตอน
// ส่วนตัวเลขและชื่อเฉพาะที่ห้ามแต่งขึ้นเองอยู่ครบใน brand-spec §6
//
// ประโยคกำกับ (hedge) ที่บรีฟเขียนไว้เองและห้ามตัดทิ้งเพราะฟังดูไม่ขายของ:
// 1) ควรตรวจสอบข้อมูลผู้ให้บริการและสถานะลิขสิทธิ์จากหลักฐานทางการก่อนใช้งาน (h1)
// 2) แต่ละเมนูควรมีรายละเอียดขั้นตอนและเงื่อนไขให้ศึกษาอย่างชัดเจน (h2 #1)
// 3) ควรอ่านรายละเอียดเกี่ยวกับยอดที่นำมาคำนวณ ระยะเวลารับสิทธิ์ และเงื่อนไข
//    การใช้โบนัสก่อนเข้าร่วม · เครดิตคืนยอดเสียไม่ใช่การรับประกันว่าจะได้รับ
//    ผลตอบแทนจากการเดิมพัน (h2 #2)
// 4) ควรตรวจสอบความถูกต้องของช่องทางสมัครและอ่านเงื่อนไขก่อนกรอกข้อมูลส่วนตัว ·
//    ไม่ควรใช้ข้อมูลของบุคคลอื่นในการลงทะเบียน (h2 #3)
// 5) ควรเพิ่มเพื่อนผ่านลิงก์หรือ QR Code บนเว็บไซต์ทางการเท่านั้น เพื่อเลี่ยง
//    บัญชีปลอมหรือผู้แอบอ้าง · ระยะเวลาตอบกลับขึ้นอยู่กับการให้บริการจริงของ
//    เจ้าหน้าที่ (h2 #4)
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ทองนำ โรสโกลด์เป็นฮิวที่สอง แดงชาดเป็น
// สำเนียงลึกที่ไม่เคยนำ บนดำสนิท**
// ⚠️ สามแบรนด์ก่อนหน้ามีทองทั้งหมด "มีทองอยู่" จึงไม่ใช่ตัวบอกว่าถูกแบรนด์
// ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน brand-spec §2 (ค่าเดิมไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive) สิ่งที่ทำให้รอบนี้ต่างจริงคือ
// **โรสโกลด์ #f2bba5** ซึ่งเป็น vivid อันดับหนึ่งที่วัดได้จากทั้งโลโก้และแบนเนอร์
// ลำดับความลึก: #241509 ผิวยก (= การ์ด) / #160d06 กลาง / #0b0603 จม / #000000 พื้นเพจ
//
// ลำดับปุ่มสื่อด้วย "ทองถม vs ผิวจมขอบแดงชาด" — คู่พื้น-หมึกคำนวณไว้แล้ว:
// · ปุ่มหลัก (สมัครสมาชิก) ถมทองไล่ #ffe6a3 → #f7c92b ขอบ #8a5f12 หมึก #140c06
//   (7.9:1 บนปลายเข้ม และ 15.6:1 บนปลายสว่าง) ⚠️ ไล่เฉดต้องหยุดที่ #f7c92b
//   ห้ามไล่ลงไปเข้มกว่านั้นใต้ตัวอักษร
// · ปุ่มรอง/ปุ่มลิงก์ภายในเป็นชั้นจม #160d06 → #0b0603 ขอบ #b3121b/55
//   ตัวอักษร #eadfce — hover ยกขอบเป็นโรสโกลด์ #f2bba5
// · marker ของลำดับเลขใช้โรสโกลด์ #f2bba5 (10.4:1 บนผิวการ์ด — เป็นตัวอักษร จึงใช้
//   แดงชาดไม่ได้ และ #ffe6a3 สงวนไว้ให้ <strong> เท่านั้น)
// · #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ (§2)
// ⚠️ #b3121b · #5a0a0e · #8a5f12 ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่เส้นขอบ ออรา เงา
// และพื้นถม — ออราในไฟล์นี้ใช้ rgba(179,18,27,α) · rgba(247,201,43,α) ·
// rgba(242,187,165,α) เท่านั้น และรอบนี้ไม่มีม่วง ไม่มีชมพูบานเย็น ไม่มีน้ำเงิน
// ไม่มีฟ้า ไม่มีเขียว ไม่มีส้ม และไม่มีเงิน/โครเมียมอมฟ้า
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #eadfce,
// 13.5:1 บนผิวยก #241509) ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง
// ปล่อยให้สืบทอดลงมา และไม่ใส่ mx-auto / max-w-* บน <p> เพราะการ์ดคุมความกว้างเองแล้ว
// — ที่ประกาศสีได้มีแค่ปุ่ม (ถมพื้นของตัวเองจึงต้องกำหนดหมึกของตัวเอง) marker ของ
// ลำดับเลข และ <strong> ซึ่ง brand-spec §2 สงวน #ffe6a3 (14.5:1 บนผิวการ์ด) ไว้เป็น
// สีไฮไลต์ในเนื้อความโดยเฉพาะ และไม่ใช้สีอื่นเลย · แต่ละ <strong> ครอบ "ช่วงที่คั่น
// ด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ
// บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง (ลบแท็ก <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิม)
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้าง
// จากหน้า และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้หมุนมาเป็น Announcement5 ทั้งเว็บ (brand-spec §3)
// orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียก
// แบบ bare ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 152 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} ศูนย์รวมช่องทางบริการเกมสล็อตออนไลน์ที่รวมเมนูสมัครสมาชิก เข้าเล่น ฝากถอน โปรโมชั่น และช่องทางติดต่อเจ้าหน้าที่ไว้ในเว็บไซต์เดียว`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} ศูนย์รวมช่องทางบริการเกมสล็อตออนไลน์`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#ffe6a3]">{BRAND_NAME} เป็นศูนย์รวมช่องทางบริการเกมสล็อตออนไลน์ ที่จัดเตรียมเมนูสำหรับสมัครสมาชิก เข้าเล่น ฝากถอน และติดต่อเจ้าหน้าที่ไว้ในเว็บไซต์เดียว</strong>
        เพื่อให้ผู้ใช้งานค้นหาข้อมูลที่ต้องการได้สะดวก ไม่ว่าจะเป็นขั้นตอนเริ่มต้นใช้งาน รายละเอียดโปรโมชั่น หรือการสอบถามปัญหาต่าง ๆ พร้อมช่องทางติดต่อทีมงานตลอด 24 ชั่วโมง
      </p>

      <p>
        หน้านี้รวบรวมไว้ว่าเว็บไซต์จัดเตรียมอะไรไว้ให้ใช้บ้าง ตั้งแต่เมนูหลักที่เข้าถึงได้จากจุดเดียว ไปจนถึงรายการโปรโมชั่นที่ระบุไว้ ขั้นตอนการสมัครสมาชิก และช่องทางติดต่อเจ้าหน้าที่
        <strong class="text-[#ffe6a3]">เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดดูอะไรตรงไหน</strong>
        แล้วจึงค่อยศึกษารายละเอียดและเงื่อนไขของแต่ละรายการเป็นรายเรื่อง
      </p>

      <p>
        เนื้อหาในหน้านี้เขียนไว้เพื่อบอกว่าเว็บไซต์มีอะไรให้ใช้และควรตรวจอะไรก่อนตัดสินใจ ไม่ได้ใช้แทนรายละเอียดและข้อกำหนดที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้งาน
        <strong class="text-[#ffe6a3]">ทั้งนี้ ควรตรวจสอบข้อมูลผู้ให้บริการและสถานะลิขสิทธิ์จากหลักฐานทางการก่อนใช้งาน</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`${BRAND_NAME} จัดเตรียมเมนูอะไรไว้ในเว็บไซต์เดียว`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} ออกแบบช่องทางบริการให้ผู้ใช้งานเข้าถึงเมนูสำคัญได้จากจุดเดียว ตั้งแต่การลงทะเบียนสมาชิก การเข้าสู่ระบบเพื่อเลือกเกมสล็อตออนไลน์ ไปจนถึงการตรวจสอบรายการฝากถอนและโปรโมชั่นที่เปิดให้เข้าร่วม
        <strong class="text-[#ffe6a3]">โดยแต่ละเมนูควรมีรายละเอียดขั้นตอนและเงื่อนไขให้ศึกษาอย่างชัดเจน</strong>
        บริการที่เว็บไซต์ระบุไว้แบ่งออกได้สี่เรื่องตามนี้
      </p>

      <ul class="flex flex-col gap-3" aria-label={`เมนูบริการที่ ${BRAND_NAME} จัดเตรียมไว้`}>
        <li class="flex gap-3">
          <span aria-hidden="true">📝</span>
          <span>
            <strong class="text-[#ffe6a3]">สมัครสมาชิก</strong> ลงทะเบียนสมาชิกจากเมนูบนเว็บไซต์หลัก โดยควรอ่านคุณสมบัติผู้สมัครและข้อกำหนดในการเปิดบัญชีให้ครบถ้วนก่อนดำเนินการ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">🎰</span>
          <span>
