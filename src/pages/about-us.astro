---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// HIX168 เป็นเว็บ "สล็อตออนไลน์" — เกมสล็อตหลายรูปแบบ ระบบฝากถอนออโต้ และแอดมิน 24 ชม.
// ไม่ใช่เว็บคาสิโนครบวงจรแบบแบรนด์ก่อนหน้า (ห้ามพูดถึงบาคาร่า หวย หรือบอลบนหน้านี้)
// ทุกข้อความด้านล่างอ้างอิง src/assets/content.txt เท่านั้น ไม่มีการอ้างใบอนุญาต
// การจดทะเบียนบริษัท ปีที่ก่อตั้ง รางวัล จำนวนสมาชิก หรือการันตีผลกำไร
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 156
const pageDescription = "รู้จัก HIX168 เว็บสล็อตออนไลน์ที่รวมเกมปั่นแตกไวไว้ในบัญชีเดียว ใช้งานง่ายทุกอุปกรณ์ พร้อมโปรโมชั่นแนะนำเพื่อน 0.8% คืนยอดเสีย 0.3% และแอดมินดูแล 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ HIX168 เว็บสล็อตปั่นแตกไว ใช้งานง่ายทุกอุปกรณ์",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา HIX168 เว็บสล็อตปั่นแตกไว เล่นง่าย ฝากถอนออโต้ทุกช่องทาง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ HIX168" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d6e2f5]">
        <strong class="text-[#8ec5ff]">HIX168</strong> ให้บริการสมาชิกที่ต้องการ<strong class="text-[#8ec5ff]">เล่นสล็อตออนไลน์ผ่านระบบที่ใช้งานง่าย</strong>
        มีเกมสล็อตหลายรูปแบบให้เลือกภายในบัญชีเดียว รองรับการใช้งานผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ สมาชิกเลือกค่ายเกม ค้นหาเกม ตรวจสอบเครดิต และดูประวัติรายการของตัวเองได้จากอุปกรณ์ที่สะดวกที่สุด
        โดยไม่ต้องเปิดบัญชีแยกตามหมวดเกมที่อยากลอง
      </p>

      <p class="text-left text-base leading-relaxed text-[#d6e2f5]">
        นอกจากตัวเกมแล้ว สมาชิกยังตรวจสอบสิทธิ์โปรโมชั่นได้จากหน้าเว็บไซต์โดยตรง ทั้ง<strong class="text-[#8ec5ff]">แนะนำเพื่อนรับโบนัส 0.8%</strong>
        และ<strong class="text-[#8ec5ff]">คืนยอดเสีย 0.3%</strong> ตามเงื่อนไขของแต่ละรายการ พร้อมระบบฝากถอนออโต้และแอดมินหลังบ้านคอยช่วยตรวจสอบปัญหาตลอด 24 ชั่วโมง
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="เกมสล็อต HIX168 ค้นหาง่าย เล่นได้ทุกอุปกรณ์" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d6e2f5]">
        HIX168 ปรับระบบให้สมาชิกเข้าถึงเกมสล็อตและฟังก์ชันต่าง ๆ ได้สะดวกมากขึ้น สิ่งที่ควรเปิดดูให้ครบก่อนเริ่มคือ
        <strong class="text-[#8ec5ff]">กติกาของเกม ช่วงเดิมพัน และรายละเอียดของแต่ละรายการ</strong> เพราะเกมแต่ละตัวใช้กลไกและความผันผวนไม่เหมือนกัน
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#d6e2f5]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#6fb4ff]">🎰</span>
          <span><strong class="text-[#8ec5ff]">เกมสล็อตหลายรูปแบบ</strong> ทั้งเกมรอบปกติและเกมที่มีฟีเจอร์พิเศษ เลือกตามกลไกและช่วงเดิมพันที่เหมาะกับตัวเอง</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#6fb4ff]">🔍</span>
          <span><strong class="text-[#8ec5ff]">ค้นหาเกมและเลือกค่าย</strong> ผ่านระบบที่อัปเดตใหม่ ช่วยให้หาเกมที่ต้องการเจอเร็วขึ้นโดยไม่ต้องไล่ดูทีละหน้า</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#6fb4ff]">📱</span>
          <span><strong class="text-[#8ec5ff]">ใช้งานได้ทุกอุปกรณ์</strong> ทั้งสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ จัดการบัญชีต่อจากเครื่องไหนก็ได้</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#6fb4ff]">🧾</span>
          <span><strong class="text-[#8ec5ff]">ตรวจสอบเครดิตและประวัติรายการ</strong> ได้จากบัญชีสมาชิกโดยตรง พร้อมดูโปรโมชั่นที่เปิดให้รับในแต่ละวัน</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#cfd8e6]">
        เกมสล็อตมีผลลัพธ์ที่ไม่แน่นอน คำว่า<strong class="text-[#cfd8e6]">แตกไวหรือกำไรดี</strong> ไม่สามารถรับประกันผลการเล่นได้ สมาชิกจึงควรกำหนดงบประมาณและเลือกเดิมพันในระดับที่เหมาะสมกับตนเองทุกครั้ง
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="โปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ของ HIX168" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d6e2f5]">
        กิจกรรม<strong class="text-[#8ec5ff]">แนะนำเพื่อน</strong> เริ่มจากการนำลิงก์แนะนำส่วนตัวไปแชร์ให้เพื่อน เมื่อเพื่อนสมัครและมีรายการตรงตามข้อกำหนด ระบบจะคำนวณโบนัสแนะนำเพื่อน 0.8% ตามเงื่อนไข โดยสมาชิกติดตามจำนวนผู้สมัครจากลิงก์
        ยอดที่เข้าเกณฑ์ และโบนัสที่มีสิทธิ์รับได้ผ่านบัญชีของตนเอง ทั้งนี้การแชร์ลิงก์เพียงอย่างเดียวอาจยังไม่ทำให้ได้รับโบนัส หากโปรโมชั่นกำหนดให้ผู้ถูกแนะนำต้องสมัครหรือมียอดใช้งานตามเกณฑ์
      </p>

      <p class="text-left text-base leading-relaxed text-[#d6e2f5]">
        ส่วนสมาชิกที่มียอดเสียตรงตามข้อกำหนด สามารถตรวจสอบสิทธิ์รับ<strong class="text-[#8ec5ff]">โบนัสคืนยอดเสีย 0.3%</strong> ตามรอบที่ HIX168 กำหนด ระบบจะแสดงยอดที่นำมาคำนวณและโบนัสที่สามารถรับได้ ก่อนกดรับควรตรวจสอบประเภทเกม
        รอบเวลา และเงื่อนไขการถอนโบนัสให้เรียบร้อย เพราะแต่ละรายการมีเปอร์เซ็นต์ วิธีคำนวณ และข้อกำหนดแตกต่างกัน
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ระบบฝากถอนออโต้ HIX168 และแอดมินดูแลตลอด 24 ชั่วโมง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d6e2f5]">
        <strong class="text-[#8ec5ff]">ระบบฝากถอนออโต้</strong> ช่วยให้สมาชิกจัดการเครดิตผ่านบัญชีของตนเองได้ ทั้งตรวจสอบช่องทางฝากเงิน ส่งคำขอถอน และติดตามสถานะรายการผ่านหน้าเว็บไซต์ รองรับช่องทางการเงินตามที่ระบบเปิดให้บริการ
        ช่วยลดขั้นตอนในการทำธุรกรรมและใช้งานผ่านมือถือได้ตลอดทั้งวัน
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#d6e2f5]">
        <li class="flex gap-3"><span class="font-bold text-[#6fb4ff]">1.</span> เปิดหน้าสมัคร HIX168 และกรอกข้อมูลตามที่ระบบกำหนด ทำผ่านมือถือหรือคอมพิวเตอร์ได้โดยตรง</li>
        <li class="flex gap-3"><span class="font-bold text-[#6fb4ff]">2.</span> Login เข้าบัญชี ฝากเครดิต และตรวจสอบโปรโมชั่นที่มีสิทธิ์รับในวันนั้น</li>
        <li class="flex gap-3"><span class="font-bold text-[#6fb4ff]">3.</span> เลือกค่ายและเกมสล็อตที่ต้องการ ตรวจสอบกติกาและช่วงเดิมพันก่อนเริ่มเล่น</li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#cfd8e6]">
        สำหรับธนาคาร วอลเลท ยอดฝากขั้นต่ำ ยอดถอน และวงเงินต่อรายการ ควรตรวจสอบข้อมูลล่าสุดที่หน้าเว็บไซต์ก่อนยืนยันธุรกรรมทุกครั้ง เนื่องจากช่องทางและข้อกำหนดอาจแตกต่างกันในแต่ละช่วงเวลา
      </p>

      <p class="text-left text-base leading-relaxed text-[#d6e2f5]">
        หากพบปัญหา Login ไม่ได้ ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง โปรโมชั่นไม่แสดง หรือเข้าเกมสล็อตไม่ได้ สามารถ
        <strong class="text-[#8ec5ff]">ติดต่อแอดมิน HIX168 ได้ตลอด 24 ชั่วโมง</strong> พร้อมแจ้งรายละเอียด เวลา และข้อมูลรายการที่เกี่ยวข้อง เพื่อให้เจ้าหน้าที่หลังบ้านช่วยค้นหารายการและตรวจสอบปัญหาได้ตรงจุด
        สมาชิกใหม่ยังสอบถามขั้นตอนสมัคร วิธีฝากถอน หรือการรับโปรโมชั่นได้เช่นกัน โดย<strong class="text-[#8ec5ff]">ไม่ควรส่งรหัสผ่านหรือ OTP ให้บุคคลอื่น</strong>
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก HIX168"
          class="flex items-center justify-center rounded-lg border border-[#1e7bf5]/50 bg-gradient-to-r from-[#cfe4ff] via-[#1e7bf5] to-[#0a3fa8] px-8 py-3 font-black text-[#02060f] shadow-[0_0_15px_rgba(30,123,245,0.4)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ HIX168"
          class="flex items-center justify-center rounded-lg border border-[#1e7bf5]/60 bg-transparent px-8 py-3 font-bold text-[#8ec5ff] transition-all hover:scale-105 hover:border-[#6fb4ff] hover:bg-[#0d1730]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
