---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login, /register,
// /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx
// ที่ใช้กับ index.astro — บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES
// ที่ให้ body มา ทั้งหน้าจึงเขียนขึ้นใหม่จากข้อเท็จจริงและคลังคำของบรีฟรอบนี้เท่านั้น
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x5 · h3x0
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) จึงเปิดใช้งานอยู่
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// ตัวที่ routing จริงคือไฟล์นี้ Astro ไม่อ่านโฟลเดอร์นั้นเลย ห้ามแก้และห้ามลบ
//
// ⚠️ ดรอปนี้ (2026-10-19) คือ **เว็บสล็อตล้วน** ไม่ใช่หมวดอื่นใดทั้งสิ้น
// สองหน้าของหมวดลอตเตอรีที่แบรนด์ก่อนๆ เคยเปิด จอดอยู่ใน src/pages-disabled/
// ไม่มี route ห้ามลิงก์ไปหา เป็น href ตายที่ทำให้ build แดง route ที่มีจริงรอบนี้คือ
// / · /about-us · /contact-us · /login · /register · /privacy · /promotion ·
// /terms · /ทดลองเล่น · /ทางเข้า · /line
//
// ⚠️ แบรนด์ก่อนหน้า (สบายเบท168 ที่ถูกแทนที่รอบนี้) ก็เป็นแบรนด์สล็อตฟ้า+ทอง
// เหมือนกัน คอปปี้และสีเดิมจึง "ดูเข้าเค้า" ทั้งที่กรอบของบรีฟคนละอัน —
// **ห้าม find-and-replace ทับประโยคเดิม** ทั้งหน้าถูกเขียนใหม่รอบกรอบของบรีฟ
// รอบนี้ ซึ่งมีแกนเดียวคือ **โปรโมชั่นแนะนำเพื่อนโบนัส 0.8% และคืนยอดเสีย 0.3%**
// ไม่ใช่กรอบของรอบก่อน ซึ่งว่าด้วยการเป็นเว็บหลัก/เว็บอันดับหนึ่งและคำรับรองของ
// เว็บไซต์เอง ซึ่งถูกถอดออกหมดทั้งไฟล์แล้ว (คำต้องห้ามไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้
// sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง — รายการเต็มอยู่ใน
// brand-spec §6)
//
// 🚨 **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกมแม้แต่ค่ายเดียว** จึงห้ามเขียนชื่อค่ายใดๆ
// ลงหน้าเว็บ ให้ใช้คำกลางว่า "ค่ายเกม" ตามบรีฟ
//
// คลังคำที่บรีฟรอบนี้ให้มา และใช้ได้เท่านี้ (brand-spec §6): สล็อต · โปรโมชั่น ·
// แนะนำเพื่อน · ลิงก์แนะนำ · รหัสแนะนำ · โบนัส 0.8% · คืนยอดเสีย 0.3% · เครดิต ·
// ยอดเสีย · รอบคำนวณ · รอบจ่ายโบนัส · สมัครสมาชิก · เข้าสู่ระบบ · บัญชีสมาชิก ·
// ฝากถอน · ธนาคาร · วอลเลท · ยอดขั้นต่ำ · ระยะเวลาดำเนินการ · หลักฐานการทำรายการ ·
// LINE Official · QR Code · บัญชีที่แอบอ้าง · รหัสผ่าน · รหัส OTP · เจ้าหน้าที่ ·
// เงื่อนไข · 24ชม. · ค่ายเกม
//
// ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.8% · 0.3% · 24ชม. ส่วนตัวเลขและชื่อเฉพาะที่
// ห้ามแต่งขึ้นเองอยู่ครบใน brand-spec §6 (เลขใบอนุญาต · หน่วยกำกับ · ชื่อนิติบุคคล ·
// ชื่อธนาคารเจาะจง · ค่า RTP · ยอดฝากขั้นต่ำ · จำนวนสมาชิก · ปีก่อตั้ง · ชื่อค่ายเกม)
//
// 🚨 บรีฟรอบนี้ hedge หนักผิดปกติ และ **ประโยค hedge ทุกประโยคต้องขึ้นครบ**
// เป็นเนื้อหาของบรีฟ ไม่ใช่ filler ให้ตัดทิ้ง — และห้ามเขียนเสริมให้กลายเป็น
// คำโฆษณาที่บรีฟกำลังเตือนเรื่องนั้นอยู่:
// 1) ก่อนเข้าร่วมควรตรวจสอบวิธีคำนวณโบนัสและข้อจำกัดของแต่ละรายการให้ครบถ้วน (h1)
// 2) แม้โปรโมชั่นจะระบุว่ารับได้ไม่อั้น แต่ควรยืนยันรอบการจ่ายโบนัสและข้อจำกัด
//    ที่เกี่ยวข้องก่อนเข้าร่วม (h2 #1)
// 3) เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกรายการ หรือรับประกัน
//    ผลตอบแทนจากการเดิมพัน (h2 #2)
// 4) หากพบรายการล่าช้าหรือสถานะไม่ถูกต้อง ควรเก็บหลักฐานการทำรายการและติดต่อ
//    เจ้าหน้าที่ผ่านช่องทางทางการ โดยไม่ส่งรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น (h2 #4)
// 5) ควรยืนยันเวลาให้บริการและระยะเวลาตอบกลับล่าสุดจากช่องทางทางการอีกครั้ง (h2 #5)
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ฟ้าไซยานนำ เหลืองมะนาวรอง บนดำสนิท**
// ⚠️ รอบก่อนก็เป็นฟ้านำ+ทองรองเหมือนกัน "มีฟ้าอยู่" หรือ "มีสีเหลืองอยู่" จึงไม่ใช่
// ตัวบอกว่าถูกแบรนด์ ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน brand-spec §2 (ค่าเดิม
// ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive ในไฟล์นี้)
// ฟ้ารอบนี้คือ **#32bcfb** (R50 G188 B251) ฟ้าน้ำแข็ง **#a9e9ff** และฮิวที่สองคือ
// **เหลืองมะนาว #fef54b** (R254 G245 B75)
// ลำดับความลึก: #0c2a3d ผิวยก (= การ์ด) / #071a28 กลาง / #030e16 จม / #000000 พื้นเพจ
//
// ลำดับปุ่มสื่อด้วย "พื้นถมฟ้า vs ผิวจมขอบฟ้า" — คู่พื้น-หมึกคำนวณไว้แล้ว:
// · ปุ่มหลัก (สมัครสมาชิก) ถมไล่เฉด #a9e9ff → #32bcfb ขอบ #07335f หมึก #041019
//   (13.2:1 บนปลายฟ้าน้ำแข็ง · 8.9:1 บนปลายฟ้าแบรนด์ ผ่าน AA ทั้งเส้น)
// · ปุ่มรอง/ปุ่มลิงก์ภายในเป็นชั้นจม #071a28 → #030e16 ขอบ #07335f
//   ตัวอักษร #dceefc — hover ยกขอบเป็นเหลืองมะนาว #fef54b (ตรงกับ hover ของการ์ด
//   ContentBox ซึ่งใช้ #fef54b/70 เป็นขอบ hover เหมือนกัน)
// · marker ของลำดับเลขใช้ฟ้าน้ำแข็ง #a9e9ff (11.3:1 บนผิวการ์ด — เป็นตัวอักษร จึงใช้
//   น้ำเงินลึกไม่ได้ และ #fef54b สงวนไว้ให้ <strong> เท่านั้น)
// · #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ (§2)
// ⚠️ #07335f · #6b5c10 ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่เส้นขอบ ออรา เงา และพื้นถม
// — ออราในไฟล์นี้ใช้ rgba(7,51,95,α) · rgba(50,188,251,α) · rgba(254,245,75,α)
// เท่านั้น และรอบนี้ไม่มีชมพู ไม่มีแดง ไม่มีม่วง ไม่มีเขียว (นอกจาก LINE)
// ไม่มีส้ม ไม่มีเงิน/โครเมียม และไม่มีโรสโกลด์
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #dceefc,
// 13.2:1 บนผิวยก #0c2a3d) ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง
// ปล่อยให้สืบทอดลงมา และไม่ใส่ mx-auto / max-w-* บน <p> เพราะการ์ดคุมความกว้างเองแล้ว
// — ที่ประกาศสีได้มีแค่ปุ่ม (ถมพื้นของตัวเองจึงต้องกำหนดหมึกของตัวเอง) marker ของ
// ลำดับเลข และ <strong> ซึ่ง brand-spec §2 สงวน #fef54b (12.7:1 บนผิวการ์ด) ไว้เป็น
// สีไฮไลต์ในเนื้อความโดยเฉพาะ และไม่ใช้สีอื่นเลย · แต่ละ <strong> ครอบ "ช่วงที่คั่น
// ด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ
// บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง (ลบแท็ก <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิม)
// และห้ามวาง <strong> สองอันติดกัน
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้าง
// จากหน้า และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้หมุนมาเป็น Announcement5 ทั้งเว็บ (brand-spec §3 —
// รอบก่อนใช้ Announcement2 จึงหมุนออก) orchestrator ตั้ง default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message
// มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 157 อักขระ
//
// ห้ามใช้คำว่า "แนวทาง" ในสตริงนี้: เป็นชื่อหน้าหมวดลอตเตอรีที่จอดอยู่ใน
// src/pages-disabled/ และ sweep ของรอบถัดไปจะอ่านเป็น false positive
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} รวมข้อมูลโปรโมชั่นแนะนำเพื่อนโบนัส 0.8% และคืนยอดเสีย 0.3% พร้อมสิ่งที่ควรตรวจสอบในเงื่อนไข รอบคำนวณ และรายการฝากถอนผ่านธนาคารและวอลเลท`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} โปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#fef54b]">{BRAND_NAME} นำเสนอโปรโมชั่นสำหรับสมาชิกที่สนใจรับสิทธิ์จากการแนะนำเพื่อน</strong>
        โดยระบุอัตราโบนัส 0.8% พร้อมช่องทางแชร์ลิงก์แนะนำและตรวจสอบข้อมูลโปรโมชั่นผ่านบัญชีสมาชิก หน้านี้รวบรวมไว้ว่าเว็บไซต์ระบุอะไรไว้บ้าง เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดดูอะไรตรงไหน แล้วจึงค่อยอ่านเงื่อนไขของแต่ละรายการเป็นรายข้อ
      </p>

      <p>
        นอกจากรายการแนะนำเพื่อนแล้ว ยังมี
        <strong class="text-[#fef54b]">โปรโมชั่นคืนยอดเสีย 0.3% เข้ายูสทุกวัน</strong>
        รวมถึงรายละเอียดเกี่ยวกับการฝากถอนผ่านธนาคารและวอลเลท และช่องทางติดต่อเจ้าหน้าที่สำหรับสอบถามเงื่อนไขต่าง ๆ ซึ่งเป็นลำดับที่ช่วยให้ทราบว่าแต่ละรายการต้องใช้ข้อมูลอะไร และต้องรอรอบเวลาใดก่อนดำเนินการต่อ
      </p>

      <p>
        เนื้อหาในหน้านี้เขียนไว้ประกอบการศึกษาเท่านั้น ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้งาน
        <strong class="text-[#fef54b]">ก่อนเข้าร่วมควรตรวจสอบวิธีคำนวณโบนัสและข้อจำกัดของแต่ละรายการให้ครบถ้วน</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`โปรโมชั่นแนะนำเพื่อน ${BRAND_NAME} โบนัส 0.8% ไม่จำกัด`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        โปรโมชั่นแนะนำเพื่อนเป็นรายการสำหรับสมาชิกที่ต้องการตรวจสอบสิทธิ์จากการส่งต่อลิงก์แนะนำให้ผู้ใช้งานรายใหม่
        <strong class="text-[#fef54b]">โดยควรศึกษาวิธีรับรหัสแนะนำ เงื่อนไขการนับยอด และรอบเวลาคำนวณโบนัสก่อนเข้าร่วม</strong>
        เพื่อให้ทราบว่ายอดโบนัสจะเข้าสู่บัญชีสมาชิกเมื่อใด และต้องปฏิบัติตามเงื่อนไขใดบ้าง
      </p>

      <ul class="flex flex-col gap-3" aria-label={`สิ่งที่ควรตรวจสอบก่อนเข้าร่วมโปรโมชั่นแนะนำเพื่อนของ ${BRAND_NAME}`}>
        <li class="flex gap-3">
          <span aria-hidden="true">🔗</span>
          <span>
