---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char, so a byte count reads
// ~3x too long). One string, reused by MainLayout's meta and the WebPage node.
const pageDescription =
  "รู้จัก DARK168 เว็บดาร์คสล็อตเจ้าของเกมแท้ ค่ายหลักเว็บตรง การันตีไม่ล็อคยูส แนะนำเพื่อน 0.8% คืนยอดเสียทุกวัน 0.3% ฝากถอนอัตโนมัติ แอดมินดูแล 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ DARK168 เว็บดาร์คสล็อตเจ้าของเกมแท้ ค่ายหลักเว็บตรง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา DARK168 เว็บดาร์คสล็อตเจ้าของเกมแท้ ไม่ล็อคยูส" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ DARK168" as="h1">
    <p class="mb-6 text-left text-base leading-relaxed text-[#ece3d1]">
      <strong class="text-[#f6dfa4]">DARK168</strong> คือเว็บดาร์คสล็อตที่ให้บริการในฐานะ <strong class="text-[#f6dfa4]">เจ้าของเกมแท้</strong> ไม่ได้เป็นตัวแทนรับต่อจากใคร
      สมาชิกเข้าเล่นเกมสล็อตจากค่ายหลักได้ภายในบัญชีเดียว รองรับการใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ พร้อมระบบฝากถอนอัตโนมัติที่ทำรายการได้ด้วยตนเอง
      และมีแอดมินคอยให้คำแนะนำเรื่องการสมัคร ฝากถอน โปรโมชั่น และการใช้งานตลอด 24 ชั่วโมง
    </p>

    <p class="mb-2 text-left text-base leading-relaxed text-[#ece3d1]">
      สิ่งที่ DARK168 ให้ความสำคัญคือความชัดเจนของข้อมูล ทั้งเปอร์เซ็นต์โบนัส วิธีคำนวณ รอบการรับสิทธิ์ และเงื่อนไขการถอน จะแสดงอยู่ในหน้ารายละเอียดโปรโมชั่นก่อนเข้าร่วมเสมอ
      สมาชิกควรอ่านเงื่อนไขตรงจุดนั้นทุกครั้ง เพราะข้อกำหนดของแต่ละรายการไม่เท่ากัน และมีทีมงานคอยให้คำแนะนำเมื่อพบปัญหาในการใช้งาน
    </p>
  </ContentBox>

  <ContentBoxPlain title="DARK168 เว็บดาร์คสล็อตค่ายหลัก เว็บตรง การันตีไม่ล็อคยูส" as="h2">
    <p class="mb-2 text-left text-base leading-relaxed text-[#ece3d1]">
      DARK168 ให้บริการเป็น <strong class="text-[#f6dfa4]">เว็บตรงค่ายหลัก</strong> สมาชิกเลือกเล่นเกมสล็อตได้จากบัญชีเดียว โดยไม่ต้องสลับใช้งานหลายบัญชี
      และ <strong class="text-[#f6dfa4]">การันตีว่าไม่ล็อคยูส</strong> ทุกยูสเซอร์ใช้งานภายใต้เงื่อนไขชุดเดียวกัน
      ก่อนเริ่มเล่นสมาชิกสามารถตรวจสอบกติกา ฟีเจอร์ และอัตราเดิมพันของแต่ละเกม เพื่อเลือกเกมให้เหมาะกับรูปแบบการเล่นของตนเอง
      ทั้งบนสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์
    </p>
  </ContentBoxPlain>

  <ContentBoxPlain title="โปรโมชั่น DARK168 แนะนำเพื่อน 0.8% และคืนยอดเสียทุกวัน 0.3%" as="h2">
    <p class="mb-2 text-left text-base leading-relaxed text-[#ece3d1]">
      สมาชิกสามารถติดตามโปรโมชั่น DARK168 ที่เปิดให้รับตามเงื่อนไขของแต่ละกิจกรรม โดยระบบจะแสดงรายละเอียดเกี่ยวกับ
      <strong class="text-[#f6dfa4]">เปอร์เซ็นต์ วิธีคำนวณ รอบการรับ และข้อกำหนดที่เกี่ยวข้อง</strong> ให้ตรวจสอบก่อนเข้าร่วมทุกครั้ง
    </p>

    <p class="mt-3 mb-2 text-left text-base leading-relaxed text-[#ece3d1]">
      สำหรับ <strong class="text-[#f6dfa4]">โปรโมชั่นคืนยอดเสียทุกวัน รับโบนัส 0.3%</strong> จะคำนวณตามยอดและประเภทเกมที่เข้าเงื่อนไข ส่วน
      <strong class="text-[#f6dfa4]">โปรโมชั่นแนะนำเพื่อน รับโบนัส 0.8%</strong> สมาชิกสามารถแชร์ลิงก์แนะนำของตนเองและติดตามสิทธิ์ผ่านบัญชีสมาชิก ทั้งนี้
      โบนัสช่วยเพิ่มสิทธิประโยชน์ในการใช้งาน แต่ไม่สามารถรับประกันผลกำไรจากการเดิมพันได้
    </p>
  </ContentBoxPlain>

  <ContentBoxPlain title="ฝากถอนอัตโนมัติ และแอดมิน DARK168 ดูแลตลอด 24 ชั่วโมง" as="h2">
    <p class="mb-6 text-left text-base leading-relaxed text-[#ece3d1]">
      <strong class="text-[#f6dfa4]">ระบบ DARK168</strong> ออกแบบให้สมาชิกจัดการข้อมูลบัญชีและธุรกรรมผ่านหน้าเว็บไซต์ได้ด้วยตนเอง ทั้งเข้าสู่ระบบ ตรวจสอบเครดิต
      ฝากถอนผ่านระบบอัตโนมัติ และเลือกเกมสล็อตได้ตลอด 24 ชั่วโมง พร้อมแสดงประวัติรายการเพื่อให้ง่ายต่อการตรวจสอบ หากพบปัญหาเกี่ยวกับการสมัครสมาชิก การ Login เครดิตไม่เข้า
      ฝากถอนล่าช้า การรับโบนัส หรือการเข้าเกมสล็อต สามารถติดต่อ <strong class="text-[#f6dfa4]">แอดมิน DARK168 ได้ตลอด 24 ชั่วโมง</strong>
      ทีมงานพร้อมช่วยตรวจสอบรายการและแนะนำขั้นตอนการใช้งาน ทั้งนี้ การพนันมีความเสี่ยงและไม่สามารถรับประกันผลกำไรได้ สมาชิกควรศึกษากติกาของแต่ละเกมและกำหนดงบประมาณก่อนเดิมพันทุกครั้ง
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก DARK168"
        class="flex items-center justify-center rounded-lg bg-gradient-to-r from-[#c8cfd8] via-[#f6dfa4] to-[#e6b74e] px-8 py-3 font-black text-[#131009] shadow-[0_0_15px_rgba(230,183,78,0.45)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ DARK168"
        class="flex items-center justify-center rounded-lg border border-[#e6b74e]/70 bg-transparent px-8 py-3 font-bold text-[#ece3d1] transition-all hover:scale-105 hover:border-[#f6dfa4] hover:bg-[#131009]/70">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
