---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึงเขียนขึ้นใหม่
// บนข้อเท็จจริงของบรีฟรอบนี้เท่านั้น (src/assets/content.txt) ไม่ใช่แก้ทับประโยคเดิม
// ของแบรนด์ก่อน — ของเดิมทั้งย่อหน้าตั้งอยู่บนคำที่ brand-spec §7 สั่งห้าม
// จึงถูกเขียนใหม่ทั้งหมด
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) จึงเปิดใช้งานอยู่ และรอบนี้ operator สั่งให้
// คงไว้ ไม่ได้ park ลง src/pages-disabled/
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// ตัวที่ routing จริงคือไฟล์นี้ ตัวที่จอดไว้เป็นอินเวนทอรีของแบรนด์เก่า (JEDI66)
// Astro ไม่อ่านโฟลเดอร์นั้นเลย ห้ามแก้และห้ามลบ
//
// ดรอปนี้ (2026-10-10) คือ **DUCK1688 สล็อตพีจีเว็บเป็ด** เป็นเว็บสล็อต PG ล้วน
// ไม่ใช่เว็บของหมวดอื่น (รายการหมวดที่ห้ามเอ่ยอยู่ใน brand-spec §7 — สองหน้าของ
// หมวดนั้นจอดอยู่ใน src/pages-disabled/ ไม่มี route ห้ามลิงก์ไปหา) เป็น href ตายที่ทำให้
// build แดง) แง่มุมที่บรีฟระบุไว้มีเท่านี้: รวมเกมสล็อตจากค่ายหลักหลายรูปแบบ ·
// สล็อตคลาสสิก เกมฟรีสปิน โบนัสตัวคูณ เกมที่มีฟีเจอร์พิเศษ · เข้าเล่นผ่านมือถือได้
// โดยไม่ต้องติดตั้งโปรแกรมเพิ่มเติม · ค้นหาเกม เลือกยอดเดิมพัน ตรวจสอบรายละเอียด
// ของแต่ละค่าย · สล็อตเบทต่ำ ทุนน้อย จัดสรรงบด้วยตัวเอง · ช่วงเดิมพันและตารางจ่าย ·
// ผลการเล่นเป็นแบบสุ่ม · คืนยอดเสีย 0.3% เข้ายูสทุกวัน · แนะนำเพื่อนแชร์ลิงก์ 0.8%
// จากยอดที่เข้าเกณฑ์ · สมัคร 3 ขั้นตอน ยืนยันตัวตน · แอดมิน 24 ชั่วโมง ·
// ช่องทางติดต่อหลัก · PIN/OTP
//
// ⚠️ บรีฟรอบนี้ไม่ได้พูดถึงระบบฝากถอน ธนาคาร บัญชีปลายทาง หรือยอดฝากขั้นต่ำเลย
// (เอ่ยแค่ว่ามี "รายการธุรกรรมที่อยู่ระหว่างตรวจสอบ" ให้สอบถามแอดมินได้) จึงห้าม
// เขียนส่วนฝากถอนขึ้นมาเอง — ส่วนนั้นของรอบก่อนถูกแทนด้วยขั้นตอนการสมัคร 3 ขั้นตอน
// ซึ่งเป็นสิ่งที่บรีฟระบุไว้จริง
//
// ⚠️ คำที่ห้ามหลงเหลือ: ศัพท์ของหมวดอื่นที่ไม่ใช่สล็อต และคำขายของของแบรนด์ก่อนๆ
// ที่บรีฟรอบนี้ไม่ได้เอ่ย — รายการเต็มอยู่ใน brand-spec §7 ไม่พิมพ์ซ้ำที่นี่ เพื่อ
// ไม่ให้ grep หาคำต้องห้ามเจอ false positive รอบนี้เขียนใหม่จากบรีฟ ไม่ได้
// find-and-replace ทับประโยคเก่า เพราะประโยคเก่าทั้งย่อหน้าตั้งอยู่บนคำเหล่านั้น
//
// ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง
// ห้ามเติมเลขใบอนุญาต หน่วยงานกำกับ ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP ยอดฝากขั้นต่ำ
// จำนวนสมาชิก หรือปีที่ก่อตั้ง เพราะบรีฟไม่ได้เอ่ยไว้สักอย่าง
//
// ประโยคกำกับที่บรีฟเขียนไว้เองและห้ามตัดทิ้งเพราะฟังดูไม่ขายของ: ข้อมูลค่ายเกมและ
// สถานะการให้บริการโดยตรงควรตรวจสอบจากหน้าเว็บไซต์ก่อนสมัคร · ทุนน้อยกำไรงามไม่ได้
// หมายความว่าจะได้กำไรทุกครั้ง เพราะผลการเล่นเป็นแบบสุ่มและมีโอกาสเสียเงินเดิมพัน ·
// ความน่าเชื่อถือควรพิจารณาจากข้อมูลผู้ดำเนินงาน ช่องทางติดต่อ และรายละเอียดค่ายเกม
// ที่ตรวจสอบได้ ไม่ใช่อาศัยคำการันตีเพียงอย่างเดียว · คำว่าไม่จำกัดควรตรวจสอบว่า
// หมายถึงจำนวนเพื่อน จำนวนครั้ง หรือวงเงินโบนัส · ไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP
// ให้บุคคลอื่น · ควรอ่านข้อกำหนดการใช้งานและตรวจสอบอายุที่กฎหมายอนุญาตในพื้นที่ของตน
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ทองเป็ด นำ ส้มอำพัน รอง บนพื้นดำสนิท**
// พลิกทิศจากคู่ "ทองอวกาศ-เงินโครเมียม บนน้ำตาลไหม้" ของแบรนด์ก่อน ซึ่งออกครบทุกจุด
// แล้วทั้งคลาส Tailwind raw hex และ rgba() (ค่าเดิมอยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำ
// ที่นี่ เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive) รอบนี้ไม่มีสีแดงและ
// ไม่มีเงินโครเมียมเป็นฮิวเลย
// ลำดับปุ่มสื่อด้วย "ทองถม vs ผิวยกขอบทอง": ปุ่มหลัก (สมัครสมาชิก) ถมทองไล่ #fde464
// → #f3bb34 → #c8901a ขอบ #c8901a หมึกน้ำตาลเกือบดำ #1a1203 — ห้ามพลิกเป็นหมึกสว่าง ·
// ปุ่มรองและปุ่มลิงก์ภายในเป็นผิวยก #1f1709 → #0d0903 ขอบทอง #f3bb34/50 ตัวอักษร
// ส้มอำพันอ่อน #ffc98a ซึ่งเป็นฮิวที่สองจริงของแบรนด์ (ปากเป็ดบนโลโก้) ·
// #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้
// ⚠️ ปลายเข้มของไล่เฉดทองที่รองหมึกต้องหยุดที่ #c8901a (หมึก #1a1203 บนมันได้ 6.4:1)
// ห้ามไล่ลงไปถึง #8a5f08 / #5c3f04 / #a3510c ใต้ตัวอักษร เพราะสามตัวนั้นเป็นสีของ
// เส้นและออราเท่านั้น
// ⚠️ "ทอง" ไม่ใช่ตัวบอกว่าถูกแบรนด์: เจ็ดในแปดแบรนด์หลังสุดก็มีทอง แต่คนละค่า
// ให้เทียบเป็นตัวๆ กับตารางใน brand-spec §2
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #f6ecd9)
// ไว้ที่ตัวการ์ดแล้ว ข้อความในหน้านี้จึงไม่ประกาศสีของตัวเองเลย ปล่อยให้สืบทอดลงมา
// — มีแค่ปุ่มที่ประกาศสีได้ เพราะปุ่มถมพื้นของตัวเองจึงต้องกำหนดหมึกของตัวเอง
// ส่วน <strong> ใช้น้ำหนักตัวอักษรเป็นไฮไลต์ ไม่ประกาศสี และแต่ละ <strong> ครอบ
// "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิด
// แท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้าง
// จากหน้า และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น Announcement6 ทั้งเว็บ (รอบก่อนใช้ AnnouncementPremium —
// brand-spec §3 หมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้
// ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูด
// คนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 158 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} สล็อตพีจีเว็บเป็ด รวมเกมเดิมพันค่ายหลักในแพลตฟอร์มเดียว พร้อมโปรโมชั่นคืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% และแอดมินให้บริการตลอด 24 ชั่วโมง`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} สล็อตพีจีเว็บเป็ด รวมเกมเดิมพัน ค่ายหลัก`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong>{BRAND_NAME} คือสล็อตพีจีเว็บเป็ดที่รวบรวมเกมสล็อตจากค่ายหลักไว้ให้เลือกหลายรูปแบบ</strong>
        ทั้งสล็อตคลาสสิก เกมฟรีสปิน โบนัสตัวคูณ และเกมที่มีฟีเจอร์พิเศษ รองรับการเข้าเล่นผ่านมือถือโดยไม่ต้องติดตั้งโปรแกรมเพิ่มเติม สมาชิกค้นหาเกม เลือกยอดเดิมพัน และตรวจสอบรายละเอียดของแต่ละค่ายได้สะดวกจากที่เดียว
      </p>

      <p>
        หน้านี้สรุปไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่เมนูเลือกเกมและหมวดหมู่ที่จัดไว้
        <strong>ไปจนถึงรายการโปรโมชั่นที่กดรับได้ ขั้นตอนการสมัครสมาชิก และช่องทางติดต่อแอดมินที่ระบุเวลาให้บริการตลอด 24 ชั่วโมง</strong>
        เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดดูอะไรตรงไหน แล้วจึงค่อยลงรายละเอียดของรายการที่สนใจเป็นรายรายการ
      </p>

      <p>
        <strong>ส่วนข้อมูลค่ายเกมและสถานะการให้บริการโดยตรงควรตรวจสอบจากหน้าเว็บไซต์ก่อนสมัคร</strong>
        ข้อมูลในหน้านี้จึงเขียนไว้เพื่อบอกว่าระบบมีอะไรให้ใช้และควรตรวจอะไรก่อนตัดสินใจ ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้งาน ซึ่งเป็นค่าที่ควรยึดเป็นหลักเสมอ
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`เกมสล็อตและหมวดหมู่ที่ ${BRAND_NAME} รวบรวมไว้ในแพลตฟอร์มเดียว`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} รวบรวมเกมสล็อตจากค่ายหลักไว้ให้เลือกหลายแนว ตั้งแต่เกมวงล้อทั่วไปไปจนถึงสล็อตที่มีฟีเจอร์โบนัสและรูปแบบการเล่นแตกต่างกัน
        <strong>แต่ละเกมมีช่วงเดิมพันและรูปแบบโบนัสไม่เหมือนกัน เหมาะกับผู้ที่สนใจสล็อตเบทต่ำและต้องการจัดสรรงบเล่นด้วยตัวเอง</strong>
        หมวดที่เว็บไซต์ระบุไว้แบ่งออกได้ประมาณนี้ และรายการที่เปิดอยู่ในแต่ละหมวดอาจเปลี่ยนแปลงได้ตามช่วงเวลา
      </p>

      <ul class="flex flex-col gap-3" aria-label={`หมวดหมู่เกมสล็อตบนเว็บ ${BRAND_NAME}`}>
        <li class="flex gap-3">
          <span aria-hidden="true">🎰</span>
          <span>
            <strong>สล็อตคลาสสิก</strong> เกมวงล้อรูปแบบพื้นฐานที่อ่านผลได้ตรงไปตรงมา เหมาะกับการเริ่มทำความคุ้นเคยกับระบบก่อนไล่ดูหมวดอื่น
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">🌀</span>
          <span>
            <strong>เกมฟรีสปิน</strong> เกมที่มีรอบหมุนเพิ่มเป็นฟีเจอร์ของตัวเกมเอง โดยเงื่อนไขการเข้าสู่รอบฟรีสปินและจำนวนรอบที่ได้เป็นไปตามที่แต่ละเกมกำหนด
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">✖️</span>
          <span>
            <strong>โบนัสตัวคูณ</strong> เกมที่มีตัวคูณอยู่ในฟีเจอร์ของเกม ซึ่งค่าตัวคูณและจังหวะที่ทำงานต่างกันไปตามเกม จึงควรเปิดอ่านตารางจ่ายของเกมนั้นก่อนเริ่มเล่น
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">✨</span>
          <span>
