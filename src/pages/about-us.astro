---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่ม) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง
//
// บรีฟรอบนี้ (ดรอป 2026-09-21) คือ "HENG35 สมัครสล็อตยูสใหม่ ไม่ล็อค โบนัสฝากแรก
// ไม่อั้น" คอปปี้ของแบรนด์รอบก่อน ("สล็อตออโต้Top3 / เว็บตรง / ติดอันดับมาแรง")
// ถูกเขียนใหม่ทั้งหน้าแล้ว ไม่เหลือประโยคเดิม
//
// HENG35 เป็นเว็บ "สล็อต" ไม่ใช่เว็บหวยและไม่ใช่เว็บรวมคาสิโนหลายหมวด
// ข้อเท็จจริงทุกบรรทัดมาจากบรีฟรอบนี้เท่านั้น: ไม่ล็อคยูส · โบนัสฝากแรกตามเงื่อนไข
// ที่กำหนด · รองรับทั้งมือถือและคอมพิวเตอร์ · มีเกมจากหลายค่ายให้เลือก ·
// ระบบจัดหมวดเกมชัดเจน ค้นหาเกมที่ต้องการได้จากหน้าเดียว · ตัวเลือกการเดิมพัน
// หลากหลายตามแต่ละเกม · โบนัสคืนยอดเสีย 0.3% · โบนัสแนะนำเพื่อน 0.8% ·
// ตรวจสอบรายละเอียดก่อนกดรับได้จากหน้าโปรโมชั่น · รองรับธนาคารและวอลเลทตาม
// รายการที่เว็บไซต์เปิดให้ใช้งาน ตรวจสอบยอดและสถานะฝากถอนจากบัญชีได้โดยตรง ·
// ฝากถอนไม่จำกัด ไม่จำกัดยอดเดิมพัน · แอดมินพร้อมให้บริการตลอด 24 ชั่วโมง
// (บรีฟรอบนี้ระบุไว้ตรง ๆ จึงอ้างได้)
// — ห้ามอ้างเลขใบอนุญาต ปีที่ก่อตั้ง เลขทะเบียนบริษัท จำนวนสมาชิก จำนวนทีมงาน
// รางวัล ที่อยู่บริษัท ชื่อค่ายเกม อัตราจ่าย/RTP เป็นตัวเลข "ปลอดภัย 100%" หรือ
// การันตีผลกำไร เพราะบรีฟไม่ได้ระบุไว้
//
// Announcement รอบนี้หมุนมาใช้ AnnouncementPremium ทั้งเว็บ — default message ของ
// ไฟล์นั้นเป็นคอปปี้ของ HENG35 รอบนี้อยู่แล้ว จึงเรียกแบบ bare ไม่ต้องส่ง prop
//
// พาเลตต์ HENG35 รอบ 2026-09-21 (ดำ + ทอง แทนม่วงรอยัล + ทองของรอบก่อน):
// ทองหลัก #ecc55c เป็นขอบ/ออร่า · ทองสว่าง #fefac4 เป็นสต็อปบนของเกรเดียนต์ ·
// ทองบรอนซ์ #a3732c เป็นสต็อปล่างและขอบรอง · ทองอ่อน #ffdf8a เป็นสี <strong> ·
// ผิวยกระดับ #1c1710 · ตัวอักษรบนปุ่มทอง #0d0b0a · เนื้อความ #ece1cb
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 159
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "เกี่ยวกับ HENG35 สล็อตยูสใหม่ ไม่ล็อคยูส รวมเกมหลายค่ายในระบบเดียว จัดหมวดเกมชัดเจน มีโบนัสฝากแรก คืนยอดเสียและแนะนำเพื่อน รองรับธนาคารและวอลเลท ฝากถอนไม่จำกัด";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับเรา HENG35 สมัครสล็อตยูสใหม่ ไม่ล็อคยูส รับโบนัสฝากแรก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา HENG35 สมัครสล็อตยูสใหม่ ไม่ล็อคยูส รับโบนัสฝากแรก" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับเรา HENG35 สมัครสล็อตยูสใหม่ ไม่ล็อคยูส รับโบนัสฝากแรก" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ece1cb]">
        <strong class="text-[#ffdf8a]">HENG35</strong> เปิดรับสมาชิกใหม่ที่ต้องการเริ่มเล่นสล็อตผ่านระบบที่ใช้งานง่าย
        <strong class="text-[#ffdf8a]">ไม่ล็อคยูส</strong> พร้อมสิทธิ์โบนัสฝากแรกตามเงื่อนไขที่กำหนด
        จึงเหมาะกับยูสใหม่ที่อยากเริ่มต้นโดยไม่ถูกจำกัดรูปแบบการเล่นมากเกินไป
      </p>

      <p class="text-left text-base leading-relaxed text-[#ece1cb]">
        ตัวระบบ<strong class="text-[#ffdf8a]">รองรับทั้งมือถือและคอมพิวเตอร์ มีเกมจากหลายค่ายให้เลือก พร้อมระบบบัญชีที่จัดการได้สะดวก</strong>
        หน้านี้รวบรวมไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่รูปแบบของเกมและการจัดหมวดหมู่
        โปรโมชั่นที่กำหนดไว้ในระบบ ช่องทางธนาคารและวอลเลทที่รองรับ ไปจนถึงวิธีติดต่อทีมงานเมื่อมีข้อสงสัยระหว่างใช้งาน
      </p>

      <p class="text-left text-base leading-relaxed text-[#ece1cb]">
        <strong class="text-[#ffdf8a]">รายละเอียดทั้งหมดยึดตามรายการที่เว็บไซต์เปิดให้ใช้งานจริงในช่วงนั้นเป็นหลัก</strong>
        เพราะทั้งรายการเกม รายการโปรโมชั่น และช่องทางทำรายการเปลี่ยนแปลงได้ตามรอบอัปเดตของระบบ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="สล็อต HENG35 รวมเกมหลายค่าย จัดหมวดชัดเจน ค้นหาจากหน้าเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ece1cb]">
        สล็อต HENG35 มีสิทธิพิเศษสำหรับสมาชิกทั้งยูสใหม่และยูสเดิม โดยเน้นการใช้งานแบบ<strong class="text-[#ffdf8a]">ไม่มีล็อคยูส</strong>
        สมาชิกจึงเลือกเกมจากหลายค่ายและตรวจสอบเงื่อนไขก่อนเข้าเล่นได้จากหน้าเดียว
        ไม่ต้องไล่เปิดหลายหน้าเพื่อหาว่าค่ายหรือแนวเกมที่สนใจอยู่ตรงไหน
      </p>

      <p class="text-left text-base leading-relaxed text-[#ece1cb]">
        <strong class="text-[#ffdf8a]">ระบบจัดหมวดเกมไว้ชัดเจน ช่วยให้ค้นหาเกมที่ต้องการได้ง่าย พร้อมตัวเลือกการเดิมพันที่หลากหลายตามแต่ละเกม</strong>
        คนที่ยังไม่แน่ใจว่าถนัดเกมแบบไหนจึงไล่เปิดดูทีละหมวดแล้วค่อยเลือกตัวที่ถูกใจได้
        โดยเปิดใช้งานผ่านเว็บเบราว์เซอร์จากเครื่องที่ถนัดได้ทั้งมือถือและคอมพิวเตอร์
      </p>

      <p class="text-left text-base leading-relaxed text-[#ece1cb]">
        รายการเกมที่เปิดให้ใช้งาน<strong class="text-[#ffdf8a]">เปลี่ยนแปลงได้ตามรอบอัปเดตของระบบ</strong>
        จึงควรตรวจสอบจากหน้าเกมของเว็บไซต์ทุกครั้งก่อนเริ่มเล่น และดูเงื่อนไขของเกมที่สนใจให้ครบก่อนตัดสินใจ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="โปรโมชั่นสล็อต HENG35 คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ece1cb]">
        โปรโมชั่นสล็อต HENG35 มีสิทธิ์ให้เลือกหลายรูปแบบตามเงื่อนไขของระบบ และ<strong class="text-[#ffdf8a]">รับได้ทุกฝากไม่จำกัด</strong>
        สองรายการหลักคือโบนัสคืนยอดเสียและโบนัสแนะนำเพื่อน โดยสามารถตรวจสอบรายละเอียดก่อนกดรับได้จากหน้าโปรโมชั่น
        เพื่อดูยอดที่เข้าเกณฑ์ รอบรับสิทธิ์ และเงื่อนไขของแต่ละรายการก่อนนำไปใช้งาน
      </p>

      <p class="text-left text-base leading-relaxed text-[#ece1cb]">
        <strong class="text-[#ffdf8a]">โบนัสคืนยอดเสีย 0.3%</strong> ให้ตามยอดและเงื่อนไขที่กำหนด
        โดยระบบจะแสดงรายละเอียดของรอบคำนวณและยอดที่เข้าเกณฑ์ให้ตรวจสอบก่อนรับสิทธิ์
        ช่วยให้ติดตามโบนัสของตัวเองได้ง่ายขึ้น และวางแผนการใช้เครดิตในแต่ละรอบได้ชัดเจน
      </p>

      <p class="text-left text-base leading-relaxed text-[#ece1cb]">
        <strong class="text-[#ffdf8a]">โบนัสแนะนำเพื่อน 0.8%</strong> ให้ตามเงื่อนไขของกิจกรรม
        สมาชิกสามารถชวนคนรู้จักเข้ามาสมัครผ่านช่องทางที่ระบบรองรับ พร้อมตรวจสอบยอดสิทธิ์และรายละเอียดของโบนัสได้จากบัญชีสมาชิก
        จึงติดตามผลของการแนะนำเพื่อนแต่ละครั้งได้จากที่เดียวโดยไม่ต้องสอบถามทุกรอบ
      </p>

      <p class="text-left text-base leading-relaxed text-[#ece1cb]">
        <strong class="text-[#ffdf8a]">แต่ละรายการมีเงื่อนไขและรอบคำนวณต่างกัน ควรตรวจสอบรายละเอียดก่อนกดรับสิทธิ์ทุกครั้ง</strong>
        และยึดยอดกับสถานะที่ระบบแสดง ณ เวลาที่ทำรายการเป็นหลัก
      </p>
    </div>
  </ContentBox>

  <ContentBox title="HENG35 รับทุกธนาคารและวอลเลท ฝากถอนไม่จำกัด" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ece1cb]">
        ระบบของ HENG35 <strong class="text-[#ffdf8a]">รองรับช่องทางธนาคารและวอลเลทตามรายการที่เว็บไซต์เปิดให้ใช้งาน</strong>
        สมาชิกจึงเลือกช่องทางที่เหมาะกับตัวเองได้ ไม่ต้องเปิดบัญชีเพิ่มเพียงเพื่อทำรายการ
        ขั้นตอนถูกจัดให้เข้าใจง่าย และรองรับการทำรายการตามวงเงินและเงื่อนไขที่ระบบกำหนด
      </p>

      <p class="text-left text-base leading-relaxed text-[#ece1cb]">
        หลังทำรายการแล้ว <strong class="text-[#ffdf8a]">ตรวจสอบยอดและสถานะฝากถอนจากบัญชีของตัวเองได้โดยตรง</strong>
        จึงไม่ต้องรอให้ใครยืนยันแทนก่อนจะรู้ว่ารายการเดินถึงขั้นไหน หากยอดหรือสถานะไม่ตรงกับที่ทำไว้
        ให้เปิดดูประวัติรายการในบัญชีก่อน แล้วแจ้งทีมงานพร้อมเวลาและจำนวนเงินที่ทำรายการ
      </p>

      <p class="text-left text-base leading-relaxed text-[#ece1cb]">
        รายการช่องทางที่เปิดให้ใช้งาน<strong class="text-[#ffdf8a]">เปลี่ยนแปลงได้ตามที่ระบบกำหนด</strong>
        จึงควรตรวจสอบรายการล่าสุดจากหน้าทำรายการก่อนทุกครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ติดต่อแอดมิน HENG35 พร้อมให้บริการ 24 ชั่วโมง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ece1cb]">
        หากมีข้อสงสัยเกี่ยวกับ<strong class="text-[#ffdf8a]">การสมัคร โบนัสฝากแรก โปรโมชั่น การเข้าเกม หรือระบบฝากถอน</strong>
        สามารถติดต่อแอดมิน HENG35 ได้ตลอด 24 ชั่วโมง ทีมงานพร้อมช่วยตรวจสอบข้อมูลและแนะนำขั้นตอนใช้งานตามปัญหาที่แจ้ง
        ช่วยให้ทั้งสมาชิกใหม่และสมาชิกเดิมเข้าถึงข้อมูลได้สะดวกทุกช่วงเวลา
      </p>

      <p class="text-left text-base leading-relaxed text-[#ece1cb]">
        เวลาแจ้งปัญหาเข้ามา ควรระบุเวลาทำรายการ จำนวนเงิน และชื่อผู้ใช้ให้ครบ เพื่อให้ทีมงานตรวจสอบตามข้อมูลที่แจ้งได้เร็วขึ้น
        <strong class="text-[#ffdf8a]">และไม่ควรเปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่นไม่ว่ากรณีใด</strong>
        รวมถึงตรวจสอบให้แน่ใจว่าเป็นช่องทางติดต่อที่ประกาศไว้บนเว็บไซต์ก่อนส่งข้อมูลใด ๆ
      </p>

      <p class="text-left text-base leading-relaxed text-[#ece1cb]">
        <strong class="text-[#ffdf8a]">เกมสล็อตตัดสินผลแต่ละรอบแบบสุ่ม ไม่มีสูตรใดรับประกันผล</strong>
        สมาชิกจึงควรกำหนดงบประมาณก่อนเริ่มเล่นทุกครั้ง และหยุดเมื่อถึงขีดที่ตั้งไว้
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก HENG35"
          class="flex items-center justify-center rounded-lg border border-[#fefac4]/60 bg-gradient-to-r from-[#fefac4] via-[#ecc55c] to-[#a3732c] px-8 py-3 font-black text-[#0d0b0a] shadow-[0_0_15px_rgba(236,197,92,0.42)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ HENG35"
          class="flex items-center justify-center rounded-lg border border-[#a3732c] bg-[#1c1710] px-8 py-3 font-bold text-[#ece1cb] transition-all hover:scale-105 hover:border-[#ecc55c] hover:bg-[#12100b] hover:text-[#ffdf8a]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
