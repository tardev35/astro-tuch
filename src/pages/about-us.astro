---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

// ENTER55 เป็นเว็บสล็อต + หวยออนไลน์รวมในทางเข้าเดียว — หน้านี้เคยเป็นบทความของ
// แบรนด์ก่อนหน้า (ธีม "เว็บสล็อตไม่ติดเทิร์น") และถูกเขียนใหม่ทั้งหมดรอบนี้
// ไม่เหลือเนื้อหาเรื่อง "ไม่ติดเทิร์น" หรือชื่อแบรนด์เดิมแม้แต่บรรทัดเดียว
//
// ข้อเท็จจริงทุกบรรทัดมาจาก src/assets/content.txt เท่านั้น:
// เว็บตรงไม่ผ่านเอเย่นต์ มั่นคงทางการเงินระดับประเทศ เรทจ่ายสูงกว่าตลาด ·
// รวมสล็อตและหวยออนไลน์ไว้ในเว็บเดียว "ครบจบในทางเข้าเดียว" ·
// ระบบกระเป๋าเดียว (Single Wallet) ฝากครั้งเดียวเล่นได้ทั้งสล็อตและหวย ไม่ต้องโยกเงิน ·
// เปิดรับหวยรัฐบาลไทย หวยลาว หวยฮานอย หวยหุ้น · จ่ายเต็มทุกบิล ไม่หักเปอร์เซ็นต์
// แม้เป็นเลขเด็ด เลขดัง เลขอั้น · 2 ตัวบน/ล่าง บาทละ 100 · 3 ตัวตรง บาทละ 1,000 ·
// โปรแนะนำเพื่อน 0.8% จากทุกยอดการเล่นของเพื่อน ถอนเป็นเงินสดได้ ·
// โปรคืนยอดเสีย 0.3% ทุกรอบบิล · สมัครออโต้ 3 ขั้นตอน (OTP → ผูกบัญชีธนาคาร
// ชื่อตรงกัน รองรับทุกธนาคารชั้นนำและ TrueMoney Wallet → ตั้ง Username/Password) ·
// ฝาก-ถอนไม่มีขั้นต่ำ ทุน 1 บาทก็ฝากได้ ออโต้ 24 ชม. ใช้เวลา 3-5 วินาที ·
// ถอนได้ 100% เต็มจำนวน ไม่มีอั้นยอดถอนต่อวัน · ปลอดภัย 100% ไม่มีประวัติการโกง
// — ห้ามอ้างเลขใบอนุญาต ปีที่ก่อตั้ง เลขทะเบียนบริษัท จำนวนสมาชิก รางวัล ที่อยู่บริษัท
// ชื่อค่ายเกม หรือการันตีผลกำไร เพราะบรีฟไม่ได้ระบุไว้เลย
//
// Announcement รอบนี้หมุนมาใช้ Announcement3 ทั้งเว็บ — default message ของไฟล์นั้น
// เป็นคอปปี้ของ ENTER55 อยู่แล้ว จึงเรียกแบบ bare ไม่ต้องส่ง prop
//
// พาเลตต์ ENTER55: แบรนด์นี้มีสีเดียวคือทอง แยกลำดับด้วยความสว่าง — ทองหลัก
// #c4a255 เป็นขอบและไอคอน · ทองกลาง #d2b262 และทองประกาย #ebd484 เป็นสต็อปบน
// ของเกรเดียนต์และสีเดียวที่ใช้กับ <strong> · ทองเข้ม #8a6d2c เป็นสต็อปล่าง ·
// พื้นดำ #000000 กับผิวยก #16140f · เนื้อความ #ded8cb
// — ไม่มีโทนทองชุดเก่าของแบรนด์ก่อนหน้าหลงเหลืออยู่ในไฟล์นี้แล้ว
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 153
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "เกี่ยวกับ ENTER55 เว็บตรงไม่ผ่านเอเย่นต์ รวมเกมสล็อตและหวยออนไลน์ไว้ในทางเข้าเดียว ด้วยระบบกระเป๋าเดียว จ่ายเต็มทุกบิล ฝาก-ถอนไม่มีขั้นต่ำตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ ENTER55 เว็บเล่นสล็อตและหวยออนไลน์ในทางเข้าเดียว",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา ENTER55 เว็บเล่นสล็อตและหวยออนไลน์ รวมครบในทางเข้าเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ ENTER55 เว็บเล่นสล็อตและหวยออนไลน์ในทางเข้าเดียว" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ded8cb]">
        <strong class="text-[#ebd484]">ENTER55</strong> คือเว็บเดิมพันออนไลน์ที่ตอบโจทย์ทั้งสายปั่นสล็อตและคอหวยออนไลน์ไว้ในที่เดียว เรารวบรวม
        <strong class="text-[#ebd484]">ค่ายเกมสล็อตชั้นนำและหวยออนไลน์ทุกประเภทมาไว้ให้เลือกเล่นครบในทางเข้าเดียว</strong>
        ไม่ต้องเสียเวลาสมัครหลายเว็บ ไม่ต้องจำหลายรหัสผ่าน ด้วยระบบที่เสถียร ปลอดภัย และได้มาตรฐานสากล
      </p>

      <p class="text-left text-base leading-relaxed text-[#ded8cb]">
        หน้านี้รวบรวมไว้ว่าเราเป็นใคร ทำไมเรทอัตราจ่ายของเราจึงสูงกว่าตลาด ระบบกระเป๋าเดียวทำงานอย่างไร เปิดรับหวยประเภทใดบ้างและจ่ายเท่าไหร่
        มีโปรโมชั่นอะไร สมัครสมาชิกยังไง และติดต่อทีมงานได้ทางช่องทางใด
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ENTER55 เว็บตรงไม่ผ่านเอเย่นต์ เรทจ่ายสูง ถอนได้เต็มจำนวน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ded8cb]">
        เราคือ<strong class="text-[#ebd484]">เว็บตรงไม่ผ่านเอเย่นต์ที่มีความมั่นคงทางการเงินระดับประเทศ</strong>
        จึงกล้าให้เรทอัตราจ่ายที่สูงกว่าเว็บทั่วไปในตลาด ไม่ว่าคุณจะเข้ามาทำกำไรจากโบนัสแจ็คพอตสล็อต หรือเข้ามาลุ้นรวยกับตัวเลขหวยออนไลน์ เราก็พร้อมจ่ายให้แบบไม่อั้น
      </p>

      <p class="text-left text-base leading-relaxed text-[#ded8cb]">
        <strong class="text-[#ebd484]">ทุกยอดการชนะถอนออกได้จริงเต็มจำนวน 100%</strong> ไม่ว่ายอดถอนของคุณจะรวมกันหลักหมื่น หลักแสน หรือหลักล้าน
        เราก็พร้อมโอนจ่ายเต็มจำนวนและ<strong class="text-[#ebd484]">ไม่มีอั้นยอดถอนต่อวัน</strong> การันตีความปลอดภัย 100% และไม่มีประวัติการโกง
      </p>

      <p class="text-left text-base leading-relaxed text-[#ded8cb]">
        <strong class="text-[#ebd484]">ให้ยึดตัวเลขและสถานะที่ระบบแสดง ณ เวลาทำรายการเป็นหลักเสมอ</strong>
        และหากมีข้อสงสัยเรื่องรอบบิลหรือเงื่อนไขการถอนครั้งไหน สอบถามแอดมินก่อนกดทำรายการได้ตลอดเวลา
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ระบบกระเป๋าเดียว Single Wallet ฝากครั้งเดียวเล่นได้ทั้งสล็อตและหวย" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ded8cb]">
        ความสะดวกขั้นสุดของ ENTER55 มาจาก<strong class="text-[#ebd484]">ระบบกระเป๋าเดียว (Single Wallet)</strong>
        ยอดเครดิตทั้งหมดของคุณรวมอยู่ในกระเป๋าเดียว <strong class="text-[#ebd484]">ฝากเงินเพียงครั้งเดียวก็นำเครดิตไปเล่นได้ทั้งสล็อตและหวย</strong>
        สลับหน้าจากเกมสล็อตไปแทงหวยออนไลน์ได้ทันที โดยไม่ต้องกดย้ายเงินหรือโยกเครดิตระหว่างค่ายเกมให้ยุ่งยาก
      </p>

      <p class="text-left text-base leading-relaxed text-[#ded8cb]">
        ฝั่งการเงินก็ให้อิสระเช่นกัน ด้วย<strong class="text-[#ebd484]">ระบบฝาก-ถอนอัตโนมัติที่ไม่มีขั้นต่ำ ทุน 1 บาทก็ฝากเข้ามาเดิมพันได้</strong>
        ทำรายการได้ตลอด 24 ชั่วโมง และใช้เวลาเพียง 3-5 วินาทีต่อรายการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="หวยออนไลน์ที่ ENTER55 เปิดรับ และอัตราจ่ายเต็มทุกบิล" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ded8cb]">
        สำหรับคอหวยที่กำลังมองหาเว็บที่จ่ายหนักและซื่อตรง เราเปิดรับแทงหวยหลายประเภท พร้อมนโยบาย
        <strong class="text-[#ebd484]">จ่ายเต็มทุกบิล ไม่หักเปอร์เซ็นต์ แม้จะเป็นเลขเด็ด เลขดัง หรือเลขอั้น</strong>
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#ded8cb]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#c4a255]">🇹🇭</span>
          <span><strong class="text-[#ebd484]">หวยรัฐบาลไทย</strong> หวยงวดหลักที่คอหวยติดตามกันทุกงวด แทงได้ครบทุกประเภทเลขในบิลเดียว</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#c4a255]">🎯</span>
          <span><strong class="text-[#ebd484]">หวยลาว</strong> อีกสนามยอดนิยมที่เปิดรับตามรอบออกผลของหวยชุดนั้น</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#c4a255]">🕒</span>
          <span><strong class="text-[#ebd484]">หวยฮานอย</strong> สำหรับคนที่ชอบรอบออกผลถี่ ไม่ต้องรอข้ามงวดนาน</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#c4a255]">📈</span>
          <span><strong class="text-[#ebd484]">หวยหุ้น</strong> อ้างอิงตัวเลขจากตลาดหุ้น เหมาะกับคนที่ติดตามข่าวสารการเงินอยู่แล้ว</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#ded8cb]">
        อัตราจ่ายของเราให้สูงเพื่อให้คุณทำกำไรได้มากกว่าที่เคย ทั้ง<strong class="text-[#ebd484]">หวย 2 ตัวบนและ 2 ตัวล่าง จ่ายสูงสุดบาทละ 100</strong>
        ลงทุนเพียงหลักสิบก็เปลี่ยนเป็นเงินหลักพันได้ และ<strong class="text-[#ebd484]">หวย 3 ตัวตรง จ่ายสูงสุดบาทละ 1,000</strong>
        แทงถูกแล้วระบบปรับยอดเครดิตให้ทันที ถอนเงินไปใช้ได้เลย
      </p>

      <p class="text-left text-base leading-relaxed text-[#ded8cb]">
        <strong class="text-[#ebd484]">รอบเปิด-ปิดรับแทงและเรทราคาของหวยแต่ละชุดเปลี่ยนแปลงได้ตามรอบออกผล</strong>
        จึงควรตรวจรอบและอัตราจ่ายล่าสุดในหน้าแทงหวยทุกครั้งก่อนส่งบิล
      </p>
    </div>
  </ContentBox>

  <ContentBox title="โปรโมชั่น ENTER55 แนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ded8cb]">
        ในส่วนของเกมสล็อตออนไลน์ เราจัดเต็มความคุ้มค่าให้สมาชิกแบบไม่มีกั๊ก ด้วย<strong class="text-[#ebd484]">โปรโมชั่นที่ออกแบบมาเพื่อคืนกำไรและเพิ่มโอกาสในการชนะให้กับทุกยูสเซอร์</strong>
        โดยสองตัวที่มาแรงที่สุดคือโปรแนะนำเพื่อนและโปรคืนยอดเสีย
      </p>

      <p class="text-left text-base leading-relaxed text-[#ded8cb]">
        <strong class="text-[#ebd484]">โปรโมชั่นแนะนำเพื่อน 0.8%</strong> เพียงนำลิงก์ส่วนตัวของคุณไปแชร์ให้เพื่อนสมัครและเข้าเล่นสล็อต
        คุณจะได้รับค่าคอมมิชชั่นสูงถึง 0.8% จากทุกยอดการเล่นของเพื่อน ยิ่งชวนมากยิ่งได้มาก เป็นรายได้แบบ Passive Income ที่ถอนเป็นเงินสดได้จริง
      </p>

      <p class="text-left text-base leading-relaxed text-[#ded8cb]">
        <strong class="text-[#ebd484]">โปรโมชั่นคืนยอดเสีย 0.3%</strong> ทุกการเดิมพันมีหลักประกันเสมอ หากโชคไม่เข้าข้าง เรามีระบบคืนยอดเสียให้ในทุกรอบบิล
        เพื่อให้คุณมีทุนสำรองไว้แก้มือและต่อยอดสร้างกำไรในเกมสล็อตได้อย่างต่อเนื่อง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="สมัครสมาชิก ENTER55 ออโต้ 3 ขั้นตอน และช่องทางติดต่อทีมงาน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ded8cb]">
        การเปิดยูสใหม่ทำเองได้ทั้งหมดบนโทรศัพท์มือถือ ด้วย<strong class="text-[#ebd484]">ระบบสมัครสมาชิกอัตโนมัติเพียง 3 ขั้นตอน</strong>
        เริ่มจาก<strong class="text-[#ebd484]">กรอกเบอร์โทรศัพท์มือถือเพื่อรับรหัส OTP ยืนยันตัวตน</strong> จากนั้น
        <strong class="text-[#ebd484]">ผูกบัญชีธนาคารโดยกรอกเลขบัญชีที่ตรงกับชื่อ-นามสกุลของคุณ</strong> แล้ว
        <strong class="text-[#ebd484]">ตั้ง Username และ Password</strong> เพื่อล็อกอินเข้าใช้งาน เติมเงินและเริ่มเล่นได้ครบทุกเกมในทางเข้าเดียว
      </p>

      <p class="text-left text-base leading-relaxed text-[#ded8cb]">
        ระบบ<strong class="text-[#ebd484]">รองรับการฝาก-ถอนทุกธนาคารชั้นนำ รวมถึง TrueMoney Wallet</strong> และ<strong class="text-[#ebd484]">ชื่อ-นามสกุลของบัญชีที่ผูกไว้ต้องตรงกับชื่อที่ใช้สมัคร</strong>
        เพราะระบบใช้ข้อมูลชุดนี้ในการโอนยอดเข้า-ออก หากข้อมูลไม่ตรงกัน รายการจะตรวจสอบได้ช้าลง
      </p>

      <p class="text-left text-base leading-relaxed text-[#ded8cb]">
        หากมีข้อสงสัยเรื่องหวย เกมสล็อต ระบบกระเป๋าเดียว หรือพบปัญหาการฝาก-ถอนเงิน ติดต่อ
        <strong class="text-[#ebd484]">แอดมิน ENTER55 ผ่าน Line Official ได้ตลอด 24 ชั่วโมง</strong>
        เวลาแจ้งปัญหาควรระบุเวลาทำรายการ จำนวนเงิน และชื่อผู้ใช้ให้ครบ
