---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement4.astro";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "รู้จัก COCOPLUS เว็บรวมเกมเดิมพันออนไลน์ทุกค่ายดังครบวงจร สล็อต คาสิโนสด กีฬา หวย มาตรฐานสากลระดับเอเชีย ระบบฝากถอนอัตโนมัติ พร้อมทีมงานดูแลตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ COCOPLUS เว็บรวมเกมเดิมพันออนไลน์มาตรฐานสากล",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา COCOPLUS เว็บรวมเกมเดิมพันออนไลน์ มาตรฐานสากลระดับเอเชีย" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ COCOPLUS" as="h1">
    <p class="mb-6 text-left text-base leading-relaxed text-[#f3e6d3]">
      <strong class="text-[#f6d78a]">COCOPLUS</strong> คือเว็บรวมเกมเดิมพันออนไลน์ทุกค่ายดังไว้ในที่เดียว ครอบคลุมทั้งสล็อต คาสิโนสด กีฬา และหวย บนมาตรฐานระบบสากลระดับเอเชีย เปิดให้บริการสมาชิกทุกระดับผ่านบัญชีเดียวที่ใช้เครดิตร่วมกันได้ทุกหมวดเกม รองรับการเข้าใช้งานทั้งบนสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์
    </p>

    <p class="mb-8 text-left text-base leading-relaxed text-[#f3e6d3]">
      ด้านการเงิน ระบบฝากถอนอัตโนมัติเปิดให้ทำรายการได้ด้วยตนเองตลอด 24 ชั่วโมงโดยไม่ต้องรอเจ้าหน้าที่ทีละราย และมีทีมงานคอยดูแลให้คำแนะนำตลอดการเดิมพัน เพื่อให้สมาชิกทุกคนใช้งาน COCOPLUS ได้อย่างมั่นใจในทุกขั้นตอน
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก"
        class="flex items-center justify-center rounded-lg border border-[#c8102e]/60 bg-gradient-to-b from-[#f6d78a] via-[#c8102e] to-[#8a1420] px-8 py-3 font-bold text-[#2a0505] shadow-[0_10px_30px_rgba(200,16,46,0.18)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(138,20,32,0.30)]">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ"
        class="flex items-center justify-center rounded-lg border border-[#c8102e]/60 bg-[#180707] px-8 py-3 font-extrabold text-[#f6d78a] shadow-[0_4px_14px_rgba(200,16,46,0.18)] transition-transform hover:scale-105 hover:bg-[#220a0a]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
