---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login, /register)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึงเขียนขึ้นใหม่
// บนข้อเท็จจริงของ CK268 เท่านั้น
//
// รอบนี้ (ดรอป 2026-09-30) คือ CK268 **เว็บเกมสล็อตออนไลน์** — รวมเกมสล็อตจาก
// หลายค่ายไว้ผ่านบัญชีเดียว มีเกมยอดนิยม สล็อตเปิดใหม่ ฟรีสปิน ตัวคูณ และฟีเจอร์
// โบนัสหลายรูปแบบ ส่วนแบรนด์ก่อนหน้า (GOT777) ขายเกมแจ็กพอต สล็อตธีมเอเชีย และ
// เกมผจญภัย ซึ่งบรีฟรอบนี้ไม่ได้พูดถึงเลย จึงถอดออกทั้งชุด ห้าม find-and-replace
// ชื่อแบรนด์ทับประโยคเดิม มิฉะนั้นเว็บจะไปอ้างสินค้าที่ไม่มีอยู่ในบรีฟรอบนี้
// (คำห้ามจาก brand-spec §1: หวย โพย แทงหวย ตรวจหวย แนวทางหวย รัฐบาลไทย ลาวพัฒนา
// ฮานอย หวยหุ้น งวด เลขเด็ด อัตราจ่าย 2 ตัว/3 ตัว บาคาร่า คาสิโนสด แทงบอล)
//
// ข้อเท็จจริงทุกบรรทัดมาจาก brand-spec §5 เท่านั้น: รวมเกมสล็อตจากหลายค่ายผ่าน
// บัญชีเดียว · เกมยอดนิยม สล็อตเปิดใหม่ ฟรีสปิน ตัวคูณ ฟีเจอร์โบนัสหลายรูปแบบ ·
// อัปเดตรายการเกมใหม่ตลอดสัปดาห์ตามค่ายที่เปิดให้บริการ · รองรับมือถือ แท็บเล็ต
// คอมพิวเตอร์ · ค้นหาเกม ตรวจสอบเครดิต โปรโมชั่น ประวัติรายการจากระบบเดียว ·
// เกมวงล้อแบบคลาสสิก สล็อตโบนัส เกมฟรีสปิน เกมรูปแบบใหม่ · บางเกมรองรับเดิมพัน
// เริ่มต้น 1 บาท · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · สมัคร 3 ขั้นตอน ·
// แอดมิน 24 ชั่วโมง
// — ตัวเลขที่อ้างได้มีแค่ 0.3% 0.8% 1 บาท 3 ขั้นตอน 24 ชั่วโมง และ 268 ในชื่อแบรนด์
// ห้ามเพิ่มชื่อค่ายเกม ชื่อธนาคาร ขั้นต่ำฝาก %RTP เลขใบอนุญาต ปีที่ก่อตั้ง
// จำนวนสมาชิก หรือรางวัลที่บรีฟไม่ได้ระบุ
//
// บรีฟใส่ "ข้อควรระวัง" กำกับทุกข้อเสนอไว้เอง และประโยคเตือนพวกนี้เป็นส่วนหนึ่งของ
// เนื้อหา ห้ามตัดทิ้ง: "1 บาททุกเกม"/"ไม่มีขั้นต่ำ" ควรอ้างอิงช่วงเดิมพันจริงในเกม ·
// คำว่า "สล็อตชั้นนำอันดับ 1" ควรมีเกณฑ์หรือข้อมูลที่ตรวจสอบได้รองรับ ·
// โปรโมชั่นแต่ละรายการมีรอบคำนวณและเงื่อนไขของตัวเอง · ห้ามเปิดเผยรหัสผ่าน PIN OTP
//
// พาเลตต์ CK268 เป็น **เขียวนีออนนำ โครเมียมขาว-เงินรอง บนดำ** ตามโลโก้ (ตัว C กับ
// เลข 68 โครเมียม ตัว K กับเลข 2 เขียวนีออน) และแบนเนอร์พื้นดำสนิทที่มีริ้วแสง
// เขียวนีออนกับชิปคาสิโนเขียว-ดำ ตารางแมปอยู่ที่ brand-spec §2: เขียวนีออน #8bfc13 ·
// เขียวอ่อน #c9ff8f · เขียวลึก #1a7a08 · เขียวรอง #12a008 · โครเมียม #e8f0e6 ·
// พื้นเข้มสุด #030703 · ผิวยก #071007 · ผิวยก 2 #0f1b0e · เนื้อความ #d5e6cd
// (BRAND_TEXT) · เน้นใน strong #eaffd6 · หมึกบนพื้นเขียว #030703
// ชุดทอง-แดงของ GOT777 (#f5c518 #ffe9a8 #96690f #d21622 #fff6dd #ece0cb #0a0503
// #160b06 #241108 rgba(245,197,24,*) rgba(210,22,34,*)) ออกครบทุกจุดแล้ว
// ทั้งคลาส Tailwind raw hex และ rgba() ที่ใช้ทำแสงเรือง
// ส่วน #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ตามเดิม
// กฎคอนทราสต์: พื้นเขียวนีออน → หมึกเข้ม #030703 · ตัวอักษรบนการ์ดดำใช้ #d5e6cd
// #eaffd6 #8bfc13 #c9ff8f เท่านั้น ส่วนเขียวลึก #1a7a08 / #12a008 ใช้เป็นพื้นและ
// ขอบ ไม่ใช่หมึก เพราะบนการ์ดดำคอนทราสต์ไม่พอ
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลางที่ไม่หมุนตามรอบรีแบรนด์ และรอบนี้
// orchestrator เป็นคนรีธีม) — สีเนื้อความจึงตรงกับที่การ์ดกำหนดไว้อยู่แล้ว
//
// รอบนี้ /ตรวจหวย และ /แนวทาง อยู่ใน src/pages-disabled/ (CK268 เป็นเว็บสล็อต
// ไม่ใช่เว็บหวย) ทั้งสอง route จึงไม่มีอยู่ใน dist/ ลิงก์ภายในของหน้านี้จึงเหลือ
// เฉพาะที่มี route จริง: /ทดลองเล่น /promotion /register /login /line /contact-us
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index และ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า
// และ slide3/slide4/banner2/banner3 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import (ลำพัง
// การ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง) · gamedemo7–18.webp
// ก็ใช้ไม่ได้: ทุกใบมีลายน้ำแบรนด์อื่นฝังอยู่ในภาพ และบางใบมีชื่อค่ายเกม ซึ่ง
// brand-spec §1 ห้ามเอ่ยชื่อค่ายบนเว็บนี้
//
// Announcement รอบนี้เป็น Announcement5 ทั้งเว็บ — orchestrator ตั้ง default
// message ของไฟล์นั้นเป็นคอปปี้ของ CK268 แล้ว จึงเรียกแบบ bare เหมือน index.astro
// ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 159
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "เกี่ยวกับ CK268 เว็บเกมสล็อตออนไลน์ที่รวมเกมจากหลายค่ายไว้ในบัญชีเดียว หน้านี้สรุปว่าภายในเว็บมีอะไรให้ใช้งานบ้าง ตั้งแต่รายการเกม โปรโมชั่น การสมัคร และแอดมิน";

const pageTitle = "เกี่ยวกับเรา CK268 เว็บเกมสล็อตรวมหลายค่ายในบัญชีเดียว";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d5e6cd]">
        <strong class="text-[#eaffd6]">CK268</strong> คือ<strong class="text-[#eaffd6]">เว็บเกมสล็อตออนไลน์ที่รวมเกมจากหลายค่ายไว้ให้เลือกผ่านบัญชีเดียว</strong>
        มีทั้งเกมยอดนิยม สล็อตเปิดใหม่ ฟรีสปิน ตัวคูณ และฟีเจอร์โบนัสหลากหลายรูปแบบ พร้อมอัปเดตรายการเกมใหม่ตลอดสัปดาห์ตามค่ายที่เปิดให้บริการ รองรับการเข้าเล่นผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์
      </p>

      <p class="text-left text-base leading-relaxed text-[#d5e6cd]">
        หน้านี้รวบรวมไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่รายการเกมสล็อตที่เปิดให้เลือก โปรโมชั่นของสมาชิก ระบบบัญชีที่ใช้ค้นหาเกม ตรวจสอบเครดิตและประวัติรายการ ขั้นตอนการสมัคร
        ไปจนถึงช่องทางสอบถามแอดมินเมื่อไม่แน่ใจในขั้นตอนใด
      </p>

      <p class="text-left text-base leading-relaxed text-[#d5e6cd]">
        <strong class="text-[#eaffd6]">สำหรับคำว่า “สล็อตชั้นนำอันดับ 1” ควรมีเกณฑ์หรือข้อมูลที่ตรวจสอบได้รองรับ หากนำมาใช้เป็นคำกล่าวอ้างหลักของเว็บไซต์</strong>
        เช่นเดียวกับรายการเกมและเงื่อนไขของโปรโมชั่นที่เปลี่ยนแปลงได้ตามช่วงเวลา รายละเอียดทั้งหมดจึงยึดตามข้อมูลที่เว็บไซต์และตัวเกมแสดงไว้จริงในขณะนั้นเป็นหลัก
      </p>
    </div>
  </ContentBox>

  <ContentBox title="CK268 รวมเกมสล็อตจากหลายค่ายไว้ให้เลือกผ่านบัญชีเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d5e6cd]">
        สิ่งที่เว็บไซต์ระบุไว้เป็นตัวตนของ CK268 คือ <strong class="text-[#eaffd6]">การรวมเกมสล็อตจากหลายค่ายไว้ให้เลือกผ่านบัญชีเดียว</strong>
        สมาชิกจึงเลือกเกมใหม่หรือสลับค่ายได้จากบัญชีเดิม ไม่ต้องเปิดบัญชีแยกกันไปตามแต่ละค่าย และค้นหาเกมที่ต้องการได้จากระบบเดียว
      </p>

      <p class="text-left text-base leading-relaxed text-[#d5e6cd]">
        ถัดจากการเลือกเกมคือ<strong class="text-[#eaffd6]">หน้าบัญชีสมาชิกที่รวมเครดิต โปรโมชั่น และประวัติรายการไว้ให้ตรวจสอบได้ด้วยตัวเอง</strong>
        หลังเล่นแล้วจึงกลับมาตรวจเครดิตและรายการย้อนหลังให้เรียบร้อยได้จากที่เดียว ไม่ต้องจดแยกไว้เองหรือย้อนถามทีละรายการ
      </p>

      <p class="text-left text-base leading-relaxed text-[#d5e6cd]">
        ส่วนรายการเกมที่เปิดให้เล่นจริงนั้น<strong class="text-[#eaffd6]">ขึ้นอยู่กับค่ายที่ระบบเปิดให้บริการในขณะนั้น</strong>
        จึงควรตรวจสอบข้อมูลภายในเกมก่อนเดิมพันทุกครั้ง โดยเฉพาะกติกา ช่วงเดิมพัน และฟีเจอร์โบนัส เพราะแต่ละค่ายกำหนดรายละเอียดของเกมไว้ไม่เหมือนกัน
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/ทดลองเล่น"
          aria-label="เปิดหน้าทดลองเล่นสล็อตของ CK268"
          class="flex items-center justify-center rounded-lg border border-[#12a008]/80 bg-[#0f1b0e] px-8 py-3 font-bold text-[#d5e6cd] transition-all hover:scale-105 hover:border-[#8bfc13] hover:bg-[#071007] hover:text-[#8bfc13]">
          ไปหน้าทดลองเล่น
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="ประเภทเกมสล็อตใน CK268 และการอัปเดตเกมใหม่ตลอดสัปดาห์" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d5e6cd]">
        เกมที่เปิดให้เลือกแบ่งได้เป็นไม่กี่กลุ่มใหญ่ และแต่ละกลุ่ม<strong class="text-[#eaffd6]">มีจังหวะการเล่นและฟีเจอร์เป็นของตัวเอง</strong>
        ไม่ได้ใช้ช่วงเดิมพันหรือรูปแบบโบนัสชุดเดียวกันทั้งหมด การรู้ว่าแต่ละกลุ่มต่างกันตรงไหนช่วยให้เลือกเกมที่ตรงกับสไตล์ของตัวเองได้เร็วขึ้น
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#d5e6cd]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#8bfc13]">🎰</span>
          <span>
            <strong class="text-[#eaffd6]">เกมวงล้อแบบคลาสสิก</strong> สัญลักษณ์และเส้นรางวัลมีไม่มาก จึงเป็นกลุ่มที่อ่านกติกาได้เร็วที่สุด เหมาะกับคนที่เพิ่งเริ่มทำความรู้จักเกมสล็อต
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#c9ff8f]">🎁</span>
          <span>
            <strong class="text-[#eaffd6]">สล็อตโบนัสและเกมฟรีสปิน</strong> เงื่อนไขต่างกันมากในแต่ละเกม ทั้งจำนวนรอบที่ได้และวิธีเข้าสู่ฟีเจอร์ จึงควรอ่านจากหน้าข้อมูลของเกมนั้นโดยตรง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#8bfc13]">✖️</span>
          <span>
            <strong class="text-[#eaffd6]">เกมที่มีตัวคูณและฟีเจอร์โบนัสรูปแบบอื่น</strong> วิธีคิดตัวคูณและเงื่อนไขที่ทำให้ฟีเจอร์ทำงานไม่เหมือนกันทุกเกม ควรดูจากรายละเอียดภายในเกมก่อนเริ่มเดิมพัน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#c9ff8f]">🆕</span>
          <span>
            <strong class="text-[#eaffd6]">สล็อตเปิดใหม่และเกมรูปแบบใหม่</strong> ทยอยเพิ่มเข้ามาตามการอัปเดตของแต่ละค่าย จำนวนเกมและช่วงเวลาที่เพิ่มเข้าระบบจึงขึ้นอยู่กับค่ายที่เปิดให้บริการในรอบนั้น
          </span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#d5e6cd]">
        <strong class="text-[#eaffd6]">สำหรับคำว่า “1 บาททุกเกม” และ “ไม่มีขั้นต่ำ” ควรอ้างอิงช่วงเดิมพันจริงที่แสดงภายในเกม</strong>
