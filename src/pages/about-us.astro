---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึงเขียนขึ้นใหม่
// บนข้อเท็จจริงของบรีฟรอบนี้เท่านั้น (src/assets/content.txt) ไม่ใช่แก้ทับประโยคเดิม
// ของแบรนด์ก่อน — ของเดิมเป็นคอปปี้ "คาสิโนรวมหลายหมวด" ของ 789BETTING ซึ่งขัดกับ
// แบรนด์รอบนี้ทั้งย่อหน้า จึงถูกเขียนใหม่ทั้งหมด ไม่ใช่แทนที่ชื่อแบรนด์
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x4 · h3x0
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) จึงเปิดใช้งานอยู่
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// ตัวที่ routing จริงคือไฟล์นี้ ตัวที่จอดไว้เป็นอินเวนทอรี ห้ามแก้และห้ามลบ
//
// ดรอปนี้ (2026-10-08) คือ **เว็บสล็อตออนไลน์ล้วน** ไม่ใช่คาสิโนรวมหมวดและไม่ใช่
// เว็บหวย แง่มุมที่บรีฟระบุไว้มีเท่านี้: รวบรวมเกมเดิมพันหลายรูปแบบไว้ในระบบเดียว ·
// สล็อตคลาสสิก เกมโบนัส ฟรีสปิน ตัวคูณ เกมเปิดใหม่ตามรายการที่ให้บริการ ·
// รองรับการเข้าเล่นผ่านมือถือ · เลือกเกม ตรวจสอบเครดิต โปรโมชั่น ประวัติรายการ
// จากบัญชีเดียว · เกมที่รองรับยอดต่ำเลือกเล่นตามงบได้ · Login ตรวจโปรโมชั่นรายวัน
// เงื่อนไข ยอดที่เข้าเกณฑ์ รอบการรับสิทธิ์ · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% ·
// รอบตัดยอด · สมัครผ่านมือถือ · ช่องทางหลัก · PIN · OTP · แอดมิน 24 ชั่วโมง ·
// ฝากถอน · หลักฐานธุรกรรม · รีวิวจากผู้ใช้งานจริง
//
// ⚠️ คำที่ห้ามหลงเหลือ: ศัพท์หมวดคาสิโนไลฟ์ หมวดกีฬา และหมวดลอตเตอรีของแบรนด์ก่อน
// รวมถึงคำขายของที่บรีฟรอบนี้ไม่ได้เอ่ย — รายการเต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำ
// ที่นี่ เพื่อไม่ให้ grep หาคำต้องห้ามเจอ false positive
// สองหน้าหมวดลอตเตอรีจอดอยู่ใน src/pages-disabled/ จึงไม่มีปลายทางให้ลิงก์รอบนี้
//
// ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 24 ชั่วโมง
// ห้ามเติมเลขใบอนุญาต หน่วยงานกำกับ ชื่อผู้ให้บริการ ชื่อค่ายเกม ชื่อธนาคาร
// ค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีที่ก่อตั้ง เพราะบรีฟไม่ได้เอ่ยไว้สักอย่าง
//
// ประโยคกำกับที่บรีฟเขียนไว้เองและห้ามตัดทิ้งเพราะฟังดูไม่ขายของ:
// คำว่า "ไม่มีขั้นต่ำ" ควรตรวจสอบวงเงินจริงของแต่ละเกม · การระบุว่าเกมสล็อต
// "ถูกลิขสิทธิ์" ควรมีข้อมูลค่ายหรือผู้ให้บริการที่ตรวจสอบได้รองรับ ·
// โบนัสที่ได้รับจริงควรยึดรายละเอียดล่าสุดจากระบบเป็นหลัก ·
// ไม่ควรนำผลลัพธ์ของสมาชิกคนหนึ่งมาเป็นการรับประกันผลลัพธ์ของสมาชิกทุกคน
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **คู่สีสดบนพื้นกรมท่าเกือบดำ** พลิกจากแบรนด์
// ฮิวเดียว (ทองเมทัลลิกล้วนบนดำสนิท) ของ 789BETTING ซึ่งออกครบทุกจุดแล้ว ทั้งคลาส
// Tailwind raw hex และ rgba() (ค่าเดิมอยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive)
// ปุ่มหลัก (สมัครสมาชิก) ถมเหลืองมะนาวไล่ #fff48a → #fce604 → #c9a703 ขอบ #c9a703
// หมึกกรมท่า #031018 (15.0:1 บน #fce604 และ 8.7:1 บนปลายเข้มสุด) — ห้ามพลิกเป็น
// หมึกสว่าง · ปุ่มรองและปุ่มลิงก์ภายในเป็นผิวการ์ด #0a1726 → #040b14 ขอบฟ้าแบรนด์
// #0193fb/60 ตัวอักษรฟ้าอ่อน #7bcffb (10.5:1) · #00B900 บนปุ่ม LINE เป็นสีประจำ
// แบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #dbeafe)
// ไว้ที่ตัวการ์ดแล้ว ข้อความในหน้านี้จึงไม่ประกาศสีของตัวเองเลย ปล่อยให้สืบทอดลงมา
// — มีแค่ปุ่มที่ประกาศสีได้ เพราะปุ่มถมพื้นของตัวเองจึงต้องกำหนดหมึกของตัวเอง
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion
// banner2 เป็นของ index ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่
// MainLayout ปักไว้ ห้ามอ้างจากหน้า และ banner3/slide3/slide4 เป็นอาร์ตเวิร์ก
// แบรนด์ก่อน ห้าม import (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ
// verify-build จะแดง)
//
// Announcement รอบนี้เป็น Announcement3 ทั้งเว็บ (รอบก่อน 789BETTING ใช้
// Announcement5 — brand-spec §3 หมุนออก) orchestrator ตั้ง default message ของไฟล์
// นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้น
// ตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 153 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} เว็บสล็อตออนไลน์ที่รวบรวมเกมเดิมพันหลายรูปแบบไว้ในระบบเดียว พร้อมโบนัสคืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% และแอดมินดูแลตลอด 24 ชั่วโมง`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} เว็บสล็อตออนไลน์ รวมเกมเดิมพันไว้ในระบบเดียว`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong>{BRAND_NAME} คือเว็บสล็อตออนไลน์ที่รวบรวมเกมเดิมพันหลายรูปแบบไว้ในระบบเดียว</strong>
        มีทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน ตัวคูณ และเกมเปิดใหม่ตามรายการที่ให้บริการ รองรับการเข้าเล่นผ่านมือถือ ช่วยให้เลือกเกม ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการได้สะดวกจากบัญชีเดียว โดยไม่ต้องเปิดบัญชีใหม่แยกตามเกม
      </p>

      <p>
        หน้านี้สรุปไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่รูปแบบของเกมที่เปิดให้เลือก
        <strong>ไปจนถึงโบนัสสมาชิกที่เปิดให้รับในแต่ละวัน การสมัครสมาชิก และการติดต่อแอดมินที่ดูแลตลอด 24 ชั่วโมง</strong>
        เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดดูอะไรตรงไหน แล้วจึงค่อยลงรายละเอียดของเกมหรือกิจกรรมที่สนใจเป็นรายรายการ
      </p>

      <p>
        สำหรับเกมที่รองรับการเดิมพันยอดต่ำ สมาชิกเลือกเล่นตามงบได้
        <strong>แต่คำว่าไม่มีขั้นต่ำควรตรวจสอบวงเงินจริงของแต่ละเกมก่อนเสมอ ส่วนการระบุว่าเกมสล็อตถูกลิขสิทธิ์ควรมีข้อมูลค่ายหรือผู้ให้บริการที่ตรวจสอบได้รองรับ</strong>
        ข้อมูลในหน้านี้เขียนไว้เพื่อบอกว่าระบบมีอะไรให้ใช้และควรตรวจอะไรก่อนตัดสินใจ ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้งาน
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`${BRAND_NAME} รวมเกมสล็อตหลายรูปแบบไว้ในบัญชีเดียว`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} รวมเกมสล็อตหลายแนวไว้ให้เลือกจากรายการเดียว
        <strong>เลือกเกมที่ต้องการแล้วเข้าเล่นต่อได้จากบัญชีเดิม</strong>
        แต่ละเกมไม่ได้เปิดฟีเจอร์ไว้เหมือนกันทั้งหมด จึงควรเปิดดูรายละเอียดก่อนเริ่มเดิมพัน เพื่อเลือกเกมที่ตรงกับงบและความสนใจได้ง่ายขึ้น สิ่งที่ต่างกันในแต่ละแบบแบ่งออกได้ประมาณนี้
      </p>

      <ul class="flex flex-col gap-3" aria-label={`รูปแบบของเกมสล็อตบนเว็บ ${BRAND_NAME}`}>
        <li class="flex gap-3">
          <span aria-hidden="true">🎰</span>
          <span>
            <strong>สล็อตคลาสสิก</strong> เป็นรูปแบบพื้นฐานที่อ่านง่าย จำนวนวงล้อและเส้นรางวัลไม่ซับซ้อน เห็นได้ชัดว่ายอดที่ตั้งไว้ถูกคิดอย่างไรในแต่ละตา จึงเป็นจุดเริ่มที่ใช้ทำความคุ้นเคยกับระบบได้
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">🎁</span>
          <span>
            <strong>เกมโบนัส</strong> มีรอบพิเศษที่เปิดเพิ่มจากเกมหลัก เงื่อนไขการเข้าสู่รอบนั้นกำหนดไว้ในตัวเกมและไม่เหมือนกันทุกเกม ควรอ่านรายละเอียดภายในเกมก่อนว่าต้องทำอย่างไรจึงจะเข้ารอบได้
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">🌀</span>
          <span>
            <strong>ฟรีสปินและตัวคูณ</strong> เป็นฟีเจอร์ที่บางเกมเปิดไว้และบางเกมไม่มี จำนวนรอบและค่าตัวคูณที่แสดงจึงเป็นของเกมนั้นเกมเดียว ไม่ใช่ค่ากลางที่ใช้ได้กับทุกเกมในระบบ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">✨</span>
          <span>
            <strong>เกมเปิดใหม่</strong> เพิ่มเข้ามาตามรายการที่ให้บริการในแต่ละช่วง รายการที่เห็นจึงเปลี่ยนแปลงได้ ควรยึดรายการล่าสุดที่ระบบแสดงอยู่แทนการจำจากรอบก่อนหน้า
          </span>
        </li>
      </ul>

      <p>
        <strong>เกมคนละเกมกำหนดช่วงเดิมพันและฟีเจอร์ไว้ไม่เท่ากัน</strong>
        ก่อนเริ่มเดิมพันจึงควรตรวจสอบวงเงินของเกมนั้น ฟีเจอร์ที่เปิดไว้ และรายละเอียดที่แสดงในระบบทุกครั้ง แทนการใช้ค่าที่จำไว้จากเกมก่อนหน้า
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/ทดลองเล่น"
          aria-label={`เปิดหน้าทดลองเล่นของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#0193fb]/60 bg-gradient-to-b from-[#0a1726] to-[#040b14] px-8 py-3 font-bold text-[#7bcffb] shadow-[0_0_12px_rgba(1,147,251,0.30)] transition-all hover:scale-105 hover:border-[#0193fb] hover:shadow-[0_0_18px_rgba(123,207,251,0.45)]">
          ไปหน้าทดลองเล่น
        </a>

        <a
          href="/promotion"
          aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#0193fb]/60 bg-gradient-to-b from-[#0a1726] to-[#040b14] px-8 py-3 font-bold text-[#7bcffb] shadow-[0_0_12px_rgba(1,147,251,0.30)] transition-all hover:scale-105 hover:border-[#0193fb] hover:shadow-[0_0_18px_rgba(123,207,251,0.45)]">
          ดูภาพโปรโมชั่น
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`โบนัสสมาชิกของ ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} มีจุดเด่นด้านกิจกรรมและโบนัสสำหรับสมาชิก
        <strong>สามารถ Login เข้าบัญชีเพื่อตรวจสอบโปรโมชั่นที่เปิดให้รับในแต่ละวัน รวมถึงเงื่อนไข ยอดที่เข้าเกณฑ์ และรอบการรับสิทธิ์</strong>
        ช่วยให้เลือกใช้โปรโมชั่นได้ตรงกับรูปแบบการเล่นมากขึ้น โดยรายการหลักที่เว็บไซต์ระบุไว้มีสองรายการ ซึ่งคำนวณจากยอดคนละชุดกัน
      </p>

      <ul class="flex flex-col gap-3" aria-label={`กิจกรรมโบนัสของ ${BRAND_NAME}`}>
        <li class="flex gap-3">
          <span aria-hidden="true">💸</span>
          <span>
