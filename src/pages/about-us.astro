---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion,
// /login, /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์
// หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ (src/assets/content.txt) ไม่มี
// ส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่จากข้อเท็จจริงและคลังคำของบรีฟรอบนี้
// เท่านั้น (.claude/brand-spec-madum168.md §5)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x4 · h3x0
//   h1  เกี่ยวกับเรา <แบรนด์> เว็บเกมสล็อตออนไลน์และข้อมูลที่หน้านี้รวบรวมไว้
//   h2  ข้อมูลเกมสล็อตออนไลน์และสิทธิพิเศษที่ <แบรนด์> ระบุไว้
//   h2  โปรโมชั่นสมาชิก <แบรนด์> คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%
//   h2  ระบบฝากถอน <แบรนด์> ผ่านธนาคารและทรูมันนี่
//   h2  ช่องทางติดต่อแอดมิน <แบรนด์> ตลอด 24ชม.
// รายการในกล่องเป็น <ul> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) และจาก footer จึงเปิดใช้งานอยู่
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// เป็นของแบรนด์เก่ามาก ตัวที่ routing จริงคือไฟล์นี้ Astro ไม่อ่านโฟลเดอร์นั้นเลย
// **ห้ามแก้ ห้ามลบ และห้ามสลับมาแทนไฟล์นี้**
//
// 🚨 แกนของดรอปนี้ (2026-10-23) คือ **เว็บเกมสล็อตออนไลน์ล้วน** ที่บรีฟเขียนถึง
// ตัวเองว่า: เกมสล็อตเปย์แรง · โปรใหม่/โบนัสสมาชิกรายวัน · ฝากถอนง่าย จ่ายเร็ว ·
// โปรโมชั่นประจำเดือน · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · ธนาคารและทรูมันนี่ ·
// แอดมิน 24ชม.
// ⚠️⚠️ **แบรนด์ขาออกขายจุดยืนคนละแบบกับรอบนี้** คำขายของกลุ่มนั้นที่เคยอยู่ใน
// ไฟล์นี้จึงเป็นคำค้างของแบรนด์ขาออก **ไม่ใช่ของรอบนี้** (ทั้งกลุ่มคำสิทธิ์ของเกม
// กลุ่มคำผู้ผลิตเกม/ที่ตั้งเซิร์ฟเวอร์/ภาษาของระบบ และกลุ่มคำช่องทางรับเงิน ซึ่ง
// บรีฟรอบนี้ไม่มีสักคำ) **รายการคำต้องห้ามเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่**
// เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// ⚠️⚠️ ชื่อแบรนด์รอบนี้เป็น **ภาษาไทยผสมเลข** ห้ามสะกดด้วยตัวละตินที่ไหนทั้งสิ้น
// (ดู brand-spec §0) ทุกจุดต้อง interpolate จาก BRAND_NAME ห้ามพิมพ์ตรงๆ
// ⚠️ `ทดลองเล่น` เหลือรอดได้เฉพาะในฐานะ **ชื่อ route /ทดลองเล่น** ซึ่งเป็นหน้าที่มี
// อยู่จริง — ไม่ใช่คำที่คอปปี้ของหน้านี้จะอ้างเป็นคุณสมบัติของแบรนด์ได้
//
// ⚠️⚠️ **สองหน้าหมวดลอตเตอรีจอดอยู่ใน src/pages-disabled/ รอบนี้** → ลิงก์ไป
// สอง route นั้นจะทำให้ build แดง ห้ามเขียนกลับมา
// route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ทดลองเล่น · /about-us · /contact-us · /terms · /privacy · /line
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกม ชื่อธนาคาร ชื่อวอลเล็ต ชื่อผู้ให้บริการ
// หน่วยงานกำกับ ใบอนุญาต ปีก่อตั้ง จำนวนสมาชิก จำนวนเกม หรือยอดขั้นต่ำที่เป็น
// ตัวเลข แม้แต่รายการเดียว** จึงห้ามเขียนลงหน้าเว็บ · ตัวเลขที่ขึ้นหน้าได้มีแค่ของ
// บรีฟเอง: **0.3% · 0.8% · 24ชม.** (ไม่มีจำนวนขั้นตอนที่นับเป็นข้อ ไม่มีเปอร์เซ็นต์
// เต็มร้อย และไม่มีค่าสถิติของเกมที่เป็นตัวเลข)
//
// 🚨 **บรีฟรอบนี้โฆษณาแล้วเบรกตัวเองในย่อหน้าเดียวกันแทบทุกย่อหน้า** — ทั้งสอง
// ครึ่งต้อง ship ครบตามที่เขียน ประโยคเบรกไม่ใช่ filler ให้ตัดทิ้ง:
// 1) โปรโมชั่นไม่ได้รับประกันว่าจะได้รับผลกำไรจากการเดิมพัน (h1)
// 2) แต่ละรายการอาจมีข้อกำหนดเกี่ยวกับยอดที่นำมาคำนวณ ประเภทเกมที่เข้าร่วม
//    รอบรับเครดิต และการใช้โบนัสแตกต่างกัน จึงควรตรวจสอบประกาศล่าสุดทุกครั้ง (h2 #1)
// 3) การคืนเครดิตไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาสชนะ
//    ในครั้งต่อไป · แม้จะมีข้อความว่าไม่จำกัด แต่ควรยืนยันจำนวนบัญชีที่เข้าร่วมได้
//    รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุด (h2 #2)
// 4) ไม่สามารถรับประกันระยะเวลาหรือจำนวนเงินที่ถอนได้จากข้อความโฆษณาเพียงอย่างเดียว ·
//    หากพบชื่อบัญชีไม่ตรงกับข้อมูลทางการหรือมีการแจ้งเปลี่ยนบัญชีอย่างผิดปกติ
//    ควรหยุดทำรายการและติดต่อธนาคารหรือผู้ให้บริการชำระเงินก่อนโอนเงิน (h2 #3)
// 5) ควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชี
//    แอบอ้าง · ไม่เปิดเผยรหัสผ่านหรือรหัส OTP · ควรตรวจสอบเวลาการให้บริการจริง
//    จากประกาศล่าสุดอีกครั้ง (h2 #4)
//
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) ยังเป็น **ธีมมืด แต่คนละฮิวกับรอบก่อนสิ้นเชิง**
// bg.json ของดรอปนี้คือ {"mode":"color","color":"#00091f"} = น้ำเงินเที่ยงคืนเกือบดำ
// **ห้าม "แก้" กลับไปเป็นการ์ดพื้นสว่าง** และ **ห้ามให้ฟ้า/น้ำเงินถือตัวอักษร**
// ค่าที่ใช้ได้ในไฟล์นี้: แดงคริมสัน #ff2e52 (<strong> + ปุ่ม outline + ขอบชิป —
// 4.9:1 บนผิวการ์ด ถือตัวอักษรได้) · แดงพื้นปุ่ม #e01238 และแดงลึก #c9102f
// (**พื้นถม/ขอบ/ออราเท่านั้น**) · อะซัวร์ #0e68cc และ #0a4ea8 (**พื้นถมของปุ่มรอง
// เท่านั้น ห้ามถือตัวอักษรเด็ดขาด**) · ผิวจม #050e26 และผิวยก #16234a (พื้นปุ่ม/ชิป) ·
// ขอบ #2a3c70 (**ห้ามถือตัวอักษร**) · ขาว #ffffff (หมึกบนปุ่มถมทั้งสองแบบ)
// หมึกเนื้อความคือ #f4eef1 (= BRAND_TEXT) ซึ่ง **ไม่ประกาศในไฟล์นี้** การ์ด
// ContentBox ตั้งไว้ให้แล้วและย่อหน้าสืบทอดลงมา
// 🚨 **ห้ามใส่ตัวอักษรขาวบนพื้นถม #ff2e52 ตรงๆ** (3.6:1) ปุ่มหลักจึงเป็นไล่เฉด
// #ff2e52 -> #e01238 -> #c9102f ซึ่งค่ากลางและค่าปลายรับหมึกขาวได้ (4.9 / 6.6:1)
// ออราที่อนุญาต: rgba(255,46,82,α) · rgba(224,18,56,α) · rgba(201,16,47,α) ·
// rgba(17,119,232,α) · rgba(14,104,204,α) · rgba(10,78,168,α) ·
// rgba(217,223,233,α) · rgba(0,9,31,α) · rgba(0,0,0,α)
// ⚠️ รอบนี้ **ไม่มีทอง/เหลือง/ส้ม/ครีม/น้ำตาล/ม่วง และไม่มีแรมป์เทาเงิน**
// (ผมขาวเงิน สูทขาวครีม และสีผิวนักแสดงในอาร์ตเวิร์กเป็นวัตถุในภาพ ไม่ใช่สี UI)
// ไม่มีเขียว ยกเว้น **LINE green #00B900** บนปุ่ม LINE ซึ่งเป็นสีประจำแพลตฟอร์ม
// ⚠️⚠️ **ฟ้า/ไซยานเคยนำมาแล้วเจ็ดแบรนด์ในรีโปนี้ และรอบก่อนหน้าทันทีก็ฟ้านำ** การเจอ
// ฟ้าในไฟล์จึงไม่พิสูจน์อะไรเลย ห้ามเทียบด้วยวงศ์สี ต้องเทียบ **ทีละค่า** กับ
// ตาราง brand-spec §2
//
// ลำดับปุ่มในไฟล์นี้สื่อด้วยพื้นถมสามขั้ว (ตรงกับคู่ปุ่มที่ล็อกไว้ใน brand-spec §2):
// · ปุ่มหลัก (สมัครสมาชิก) ไล่เฉด #ff2e52 -> #e01238 -> #c9102f หมึก #ffffff
// · ปุ่มรอง (เข้าสู่ระบบ) ไล่เฉด #0e68cc -> #0a4ea8 หมึก #ffffff
// · ปุ่มลิงก์ภายในเป็นปุ่ม outline ขอบ #ff2e52 ตัวอักษร #ff2e52 บนผิวจม #050e26
//   hover ยกพื้นขึ้นเป็นผิวยก #16234a (ตรงกับ hover ของการ์ด ContentBox)
// · ชิปไอคอนของรายการใช้แดงคริมสันเป็น **เส้นขอบ** บนผิวยก #16234a ไม่ถือตัวอักษร
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง และไม่ใส่ mx-auto / max-w-* บน <p>
// เพราะการ์ดคุมความกว้างเองแล้ว — ที่ประกาศสีได้มีแค่ปุ่ม ชิปไอคอน และ <strong>
// แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรค
// ระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง (ลบแท็ก
// <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิม) และห้ามวาง <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังใน prop ที่เป็นข้อความ
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: ดรอปนี้ไม่มี article illustration เลย (banner2/
// banner3 เป็นอาร์ตเวิร์กของแบรนด์คนละราย เก่าทั้งคู่) ส่วน slide1/slide2 ถูกตรึง
// ไว้กับ index กับ /promotion และ banner1 / banner1-mobile / og.png เป็นของ glob
// ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า · slide3/slide4 เป็นโปสเตอร์ของอีกแบรนด์
// ห้าม import (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build
// จะแดง) — ไฟล์ยังอยู่บนดิสก์ ห้ามลบ
//
// Announcement รอบนี้หมุนมาเป็น AnnouncementPremium ทั้งเว็บ (brand-spec §3 —
// รอบก่อนใช้ AnnouncementCyber จึงหมุนออก) orchestrator ตั้ง default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว จึงเรียกแบบ bare **ห้ามส่ง prop message**
// มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 154 อักขระ (ชื่อแบรนด์รอบนี้ 8 ตัวอักษร) เป็นประโยคเดียวที่บอกว่า
// หน้านี้มีอะไร แล้วหยุด
// (Google ตัดราว 155 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} รวมข้อมูลเกมสล็อตออนไลน์ โปรโมชั่นคืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% ระบบฝากถอนผ่านธนาคารและทรูมันนี่ และช่องทางติดต่อแอดมินตลอด 24ชม.`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} เว็บเกมสล็อตออนไลน์และข้อมูลที่หน้านี้รวบรวมไว้`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

// คลาสปุ่มสามขั้วของหน้านี้ ประกาศครั้งเดียวแล้วใช้ซ้ำ เพื่อไม่ให้สองปุ่มที่ทำ
// หน้าที่เดียวกันหลุดไปคนละเฉดตอนรีแบรนด์รอบหน้า
const ctaPrimary =
  "flex items-center justify-center rounded-lg border border-[#c9102f] bg-gradient-to-b from-[#ff2e52] via-[#e01238] to-[#c9102f] px-8 py-3 font-black text-[#ffffff] shadow-[0_6px_18px_rgba(255,46,82,0.35)] transition-transform hover:scale-105";

const ctaSecondary =
  "flex items-center justify-center rounded-lg border border-[#0a4ea8] bg-gradient-to-b from-[#0e68cc] to-[#0a4ea8] px-8 py-3 font-bold text-[#ffffff] shadow-[0_6px_18px_rgba(10,78,168,0.4)] transition-transform hover:scale-105";

const ctaQuiet =
  "flex items-center justify-center rounded-lg border-2 border-[#ff2e52] bg-[#050e26] px-8 py-3 font-bold text-[#ff2e52] shadow-[0_4px_14px_rgba(0,0,0,0.35)] transition-all hover:scale-105 hover:bg-[#16234a] hover:shadow-[0_6px_18px_rgba(255,46,82,0.25)]";

const listChip = "mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#ff2e52]/50 bg-[#16234a] text-sm";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#ff2e52]">{BRAND_NAME} นำเสนอเกมสล็อตออนไลน์พร้อมข้อมูลโปรโมชั่นสำหรับสมาชิกที่ต้องการติดตามสิทธิพิเศษในแต่ละวัน</strong>
        หน้านี้รวบรวมไว้ว่าเว็บไซต์ระบุอะไรไว้บ้าง เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดอ่านอะไรตรงไหน แล้วจึงค่อยไล่อ่านรายละเอียดของแต่ละหัวข้อเป็นรายข้อ
      </p>

      <p>
        ภายในเว็บไซต์มีรายละเอียดเกี่ยวกับเกม การสมัครสมาชิก และช่องทางฝากถอนให้ตรวจสอบก่อนใช้งาน
        <strong class="text-[#ff2e52]">โดยมีโปรโมชั่นคืนยอดเสียและแนะนำเพื่อนตามเงื่อนไขที่กำหนด</strong>
        ซึ่งแต่ละหัวข้อวางเงื่อนไขของตัวเองไว้คนละชุด จึงควรเปิดอ่านทีละหัวข้อแทนการเทียบจากหัวข้ออื่น
      </p>

      <p>
        สิ่งที่หน้านี้ทำได้คือชี้ว่าข้อมูลแต่ละชุดอยู่ตรงไหนและควรอ่านอะไรก่อน
        <strong class="text-[#ff2e52]">ผู้ใช้งานควรศึกษากติกาเกมและข้อกำหนดการรับโบนัสให้ครบถ้วน เพราะโปรโมชั่นไม่ได้รับประกันว่าจะได้รับผลกำไรจากการเดิมพัน</strong>
        เนื้อหาในหน้านี้จึงเขียนไว้ประกอบการใช้งานเท่านั้น ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้บริการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`ข้อมูลเกมสล็อตออนไลน์และสิทธิพิเศษที่ ${BRAND_NAME} ระบุไว้`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#ff2e52]">{BRAND_NAME} นำเสนอข้อมูลเกมสล็อตออนไลน์ไว้ในเว็บไซต์เดียว</strong>
        ทั้งรายละเอียดเกี่ยวกับเกม การสมัครสมาชิก และช่องทางฝากถอน รายการด้านล่างคือชุดข้อมูลที่ควรไล่อ่านให้ครบก่อนใช้งาน เพราะแต่ละชุดระบุเงื่อนไขของตัวเองไว้ไม่เหมือนกัน
      </p>

      <ul class="flex flex-col gap-4" aria-label="ข้อมูลที่ควรตรวจสอบก่อนใช้งาน">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎰</span>
          <span>
            <strong class="text-[#ff2e52]">รายละเอียดเกี่ยวกับเกมและกติกาเกม</strong> เป็นชุดแรกที่ควรอ่าน เพราะเป็นตัวบอกว่าผลของแต่ละรอบนับอย่างไร และเงื่อนไขไหนต้องเกิดขึ้นก่อนจึงจะมีผลรางวัล
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📝</span>
          <span>
            <strong class="text-[#ff2e52]">ขั้นตอนการสมัครสมาชิกและการเข้าสู่ระบบ</strong> ระบุไว้ในเว็บไซต์ ควรเปิดอ่านก่อนกรอกข้อมูล และตรวจว่ากำลังใช้งานอยู่บนเว็บไซต์ทางการจริง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🏦</span>
          <span>
            <strong class="text-[#ff2e52]">ช่องทางฝากถอนที่เปิดให้ใช้งานจริง</strong> ควรตรวจสอบก่อนทำรายการทุกครั้ง เพราะบริการที่เปิดอยู่ในขณะนั้นอาจไม่ตรงกับข้อความที่สรุปไว้สั้นๆ เพียงบรรทัดเดียว
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📋</span>
          <span>
            <strong class="text-[#ff2e52]">ข้อกำหนดการรับโบนัสและเงื่อนไขการใช้โบนัส</strong> เป็นคนละชุดกับตัวโปรโมชั่น จึงควรอ่านให้ครบถ้วนก่อนกดรับเครดิต ไม่ใช่อ่านเฉพาะหัวข้อของรายการนั้น
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#ff2e52]">แต่ละรายการอาจมีข้อกำหนดเกี่ยวกับยอดที่นำมาคำนวณ ประเภทเกมที่เข้าร่วม รอบรับเครดิต และการใช้โบนัสแตกต่างกัน</strong>
        จึงควรตรวจสอบประกาศล่าสุดทุกครั้ง และยึดเงื่อนไขที่แสดงอยู่ ณ เวลาที่เข้าร่วมมากกว่าข้อความที่เคยอ่านไว้ก่อนหน้า
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/ทดลองเล่น" aria-label={`เปิดหน้าทดลองเล่นของ ${BRAND_NAME}`} class={ctaQuiet}>ไปหน้าทดลองเล่น</a>

        <a href="/ทางเข้า" aria-label={`เปิดหน้าทางเข้าของ ${BRAND_NAME}`} class={ctaQuiet}>ไปหน้าทางเข้า</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`โปรโมชั่นสมาชิก ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} นำเสนอข้อมูลโปรโมชั่นสำหรับสมาชิก โดยมีรายการ
        <strong class="text-[#ff2e52]">คืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8%</strong>
        เป็นสิทธิพิเศษที่ระบุไว้ และสามารถติดตามรายละเอียดโปรโมชั่นประจำเดือนพร้อมตรวจสอบเงื่อนไขก่อนเข้าร่วมได้
      </p>

      <p>
        รายการคืนยอดเสียระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขรายวัน
        <strong class="text-[#ff2e52]">สมาชิกควรตรวจสอบว่าเกมสล็อตประเภทใดเข้าร่วมรายการ มีรอบสรุปยอดเวลาใด และต้องกดรับเครดิตด้วยตนเองหรือระบบดำเนินการให้อัตโนมัติ</strong>
        รวมถึงศึกษาข้อกำหนดการใช้เครดิตและการถอนเงินให้ครบถ้วน เพราะยอดเสียบางรายการอาจไม่เข้าเกณฑ์รับสิทธิ์ ทั้งนี้ การคืนเครดิตไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งต่อไป
      </p>

      <p>
        ส่วนรายการแนะนำเพื่อนระบุสิทธิ์ไว้สำหรับสมาชิกที่แนะนำผู้ใช้งานรายใหม่ โดยควรตรวจสอบวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และฐานยอดที่ใช้คำนวณโบนัสให้ชัดเจน
        <strong class="text-[#ff2e52]">แม้จะมีข้อความว่าไม่จำกัด แต่ควรยืนยันจำนวนบัญชีที่เข้าร่วมได้ รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุด</strong>
        เพื่อป้องกันความเข้าใจคลาดเคลื่อนเกี่ยวกับจำนวนเครดิตที่มีสิทธิ์ได้รับ
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/promotion" aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`} class={ctaQuiet}>ดูภาพโปรโมชั่น</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`ระบบฝากถอน ${BRAND_NAME} ผ่านธนาคารและทรูมันนี่`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#ff2e52]">{BRAND_NAME} ระบุช่องทางฝากถอนผ่านธนาคารและทรูมันนี่</strong>
        เพื่อให้สมาชิกตรวจสอบวิธีทำรายการตามบริการที่เปิดใช้งานจริง รายการด้านล่างคือสิ่งที่ควรเปิดอ่านก่อนทำรายการครั้งแรก และควรตรวจซ้ำทุกครั้งที่กลับเข้ามาใหม่
      </p>

      <ul class="flex flex-col gap-4" aria-label="สิ่งที่ควรตรวจสอบก่อนฝากถอน">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>💳</span>
          <span>
            <strong class="text-[#ff2e52]">รายชื่อธนาคารที่รองรับและยอดฝากขั้นต่ำ</strong> ควรดูจากบริการที่เว็บไซต์เปิดใช้งานอยู่จริงในขณะนั้น ไม่ใช่จากข้อความโฆษณาที่สรุปไว้สั้นๆ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🔎</span>
          <span>
            <strong class="text-[#ff2e52]">ชื่อบัญชีปลายทาง</strong> ควรตรงกับข้อมูลผู้ให้บริการที่ยืนยันได้ เพราะนี่คือจุดที่แยกการทำรายการตามปกติออกจากบัญชีแอบอ้างได้เร็วที่สุด
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>⏱️</span>
          <span>
            <strong class="text-[#ff2e52]">วงเงินถอนสูงสุด ระยะเวลาดำเนินการ และการยืนยันตัวตน</strong> ควรศึกษาให้ครบถ้วนก่อนทำธุรกรรม เพราะรายการที่มียอดสูงอาจต้องผ่านขั้นตอนตรวจสอบเพิ่มเติม
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#ff2e52]">ไม่สามารถรับประกันระยะเวลาหรือจำนวนเงินที่ถอนได้จากข้อความโฆษณาเพียงอย่างเดียว</strong>
        และหากพบชื่อบัญชีไม่ตรงกับข้อมูลทางการหรือมีการแจ้งเปลี่ยนบัญชีอย่างผิดปกติ ควรหยุดทำรายการและติดต่อธนาคารหรือผู้ให้บริการชำระเงินเพื่อตรวจสอบก่อนโอนเงิน
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/register" aria-label={`สมัครสมาชิก ${BRAND_NAME}`} class={ctaPrimary}>สมัครสมาชิก</a>

        <a href="/login" aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`} class={ctaSecondary}>เข้าสู่ระบบ</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`ช่องทางติดต่อแอดมิน ${BRAND_NAME} ตลอด 24ชม.`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} ระบุช่องทางติดต่อเจ้าหน้าที่สำหรับผู้ใช้งานที่ต้องการสอบถามเกี่ยวกับการสมัครสมาชิก การเข้าสู่ระบบ รายการฝากถอน และรายละเอียดโปรโมชั่น
        <strong class="text-[#ff2e52]">โดยควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง</strong>
        หากพบปัญหาเกี่ยวกับธุรกรรม ควรเก็บหมายเลขรายการและหลักฐานที่เกี่ยวข้องไว้สำหรับตรวจสอบ พร้อมแจ้งรายละเอียดปัญหาให้ชัดเจน โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP
      </p>

      <p>
        <strong class="text-[#ff2e52]">ทั้งนี้ ควรตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุดอีกครั้ง</strong>
        เพราะช่วงเวลาที่เจ้าหน้าที่รับเรื่องอาจปรับเปลี่ยนได้ตามที่ผู้ให้บริการกำหนด และระยะเวลาตอบกลับของแต่ละช่องทางอาจไม่เท่ากัน
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/line"
          aria-label={`ติดต่อเจ้าหน้าที่ ${BRAND_NAME} ผ่าน Line Official`}
          class="flex items-center justify-center gap-2 rounded-lg border border-[#00B900] bg-[#00B900] px-8 py-3 font-black text-white shadow-[0_0_15px_rgba(0,185,0,0.35)] transition-transform hover:scale-105">
          <span aria-hidden="true">💬</span>
          ติดต่อผ่าน Line Official
        </a>

        <a href="/contact-us" aria-label={`ดูช่องทางติดต่อทีมงาน ${BRAND_NAME} ทั้งหมด`} class={ctaQuiet}>ช่องทางติดต่อทั้งหมด</a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
