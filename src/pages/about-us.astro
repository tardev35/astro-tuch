---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

// LION991 เป็นคาสิโนออนไลน์ VIP เนื้อหาทั้งหน้าจึงพูดเรื่องคาสิโนสด/โต๊ะ Live
// (บาคาร่า รูเล็ต เสือมังกร แบล็กแจ็ก และเกมคาสิโนสดประเภทอื่น) การตรวจกติกา อัตราจ่าย
// และวงเงินขั้นต่ำ-สูงสุดของแต่ละโต๊ะ โปรโมชั่นที่ตรวจสอบได้หลัง Login การสมัครเองได้
// 3 ขั้นตอนโดยไม่ผ่านแอดมิน การฝากถอน/ประวัติรายการในบัญชีสมาชิก และแอดมิน 24 ชั่วโมง
// — ทุกข้อความอ้างอิง src/assets/content.txt เท่านั้น ไม่มีการอ้างใบอนุญาต การจดทะเบียนบริษัท
// ปีที่ก่อตั้ง จำนวนสมาชิก การันตีผลกำไร หรือชื่อค่าย/สตูดิโอถ่ายทอดสดรายใด
//
// รอบรีแบรนด์ก่อนหน้าเป็นเว็บลอตเตอรี่ หน้านี้จึงถูกเขียนใหม่ทั้งหน้า
// ไม่มีตารางอัตราจ่ายตายตัวหรือเนื้อหาของแบรนด์เดิมหลงเหลือ
//
// Announcement หมุนมาใช้ AnnouncementPremium — default message ของไฟล์นั้นเป็นคอปปี้
// ของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ไม่ต้องส่ง prop
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 157
const pageDescription =
  "เกี่ยวกับ LION991 คาสิโน VIP รวมเกมเดิมพันหลายหมวดไว้ในบัญชีเดียว มีห้องไลฟ์สดทั้งบาคาร่า รูเล็ต เสือมังกร และแบล็กแจ็ก ฝากถอนจัดการเองได้ พร้อมแอดมิน 24 ชม.";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ LION991 คาสิโน VIP เกมเดิมพันออนไลน์ ครบทุกแบรนด์แท้",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา LION991 คาสิโนvip รวมเกมเดิมพัน แบรนด์แท้ไลฟ์สด 24 ชม" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ LION991 คาสิโน VIP เกมเดิมพันออนไลน์ ครบทุกแบรนด์แท้" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d6e2f5]">
        <strong class="text-[#e6ecf7]">LION991</strong> เปิดให้บริการสมาชิกที่ต้องการ<strong class="text-[#8fc2ff]">เล่นคาสิโนออนไลน์ผ่านมือถือและคอมพิวเตอร์</strong>
        โดยรวบรวมเกมเดิมพันหลายหมวดหมู่ไว้ในบัญชีเดียว พร้อมคาสิโนสดและโต๊ะ Live ตามที่ระบบเปิดให้บริการ
        สมาชิกสมัคร เข้าเกม ตรวจสอบโปรโมชั่น ฝากถอน และจัดการบัญชีของตนเองได้จากที่เดียว
      </p>

      <p class="text-left text-base leading-relaxed text-[#d6e2f5]">
        แนวคิดของเว็บคือทำให้ทุกขั้นตอนตรวจสอบได้ก่อนกดยืนยัน ทั้งกติกาของโต๊ะ อัตราจ่าย และวงเงินขั้นต่ำและสูงสุดของเกมนั้น
        ควบคู่กับ<strong class="text-[#8fc2ff]">การฝากถอนและประวัติรายการที่ย้อนกลับมาดูได้เสมอจากบัญชีสมาชิก</strong>
        พร้อมทีมงานคอยช่วยเหลือด้านการใช้งานตลอด 24 ชั่วโมง
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="ห้องคาสิโนสดของ LION991 บาคาร่า รูเล็ต เสือมังกร และแบล็กแจ็ก" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d6e2f5]">
        LION991 จัดหมวดเกมคาสิโนแบบ Live ไว้ให้เลือกตามโต๊ะและผู้ให้บริการที่เปิดให้บริการในช่วงเวลานั้น
        รองรับการรับชมผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ จึง<strong class="text-[#8fc2ff]">ติดตามการดำเนินเกมแบบเรียลไทม์ได้อย่างสะดวก</strong>
        โดยรายละเอียดของแต่ละโต๊ะอาจแตกต่างกันไปตามเกมและผู้ให้บริการ
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#d6e2f5]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#8fc2ff]">🎴</span>
          <span><strong class="text-[#8fc2ff]">บาคาร่า</strong> เปิดให้เลือกได้หลายโต๊ะตามผู้ให้บริการที่พร้อมใช้งาน ควรอ่านกติกาและอัตราจ่ายที่แสดงในเกมก่อนเริ่มเดิมพัน</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#8fc2ff]">🎡</span>
          <span><strong class="text-[#8fc2ff]">รูเล็ต</strong> เข้าเล่นได้ตามโต๊ะที่ระบบเปิดให้บริการ วงเงินขั้นต่ำและสูงสุดของแต่ละโต๊ะอาจไม่เท่ากัน</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#8fc2ff]">🐯</span>
          <span><strong class="text-[#8fc2ff]">เสือมังกร</strong> เปิดตามโต๊ะและผู้ให้บริการที่พร้อมใช้งานในขณะนั้น ควรดูเงื่อนไขของโต๊ะที่เลือกก่อนลงเดิมพัน</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#8fc2ff]">🃏</span>
          <span><strong class="text-[#8fc2ff]">แบล็กแจ็ก</strong> และเกมคาสิโนสดประเภทอื่น ๆ เข้าเล่นได้ตามรายการที่เปิดอยู่ อัตราจ่ายและวงเงินให้ยึดตามที่แสดงในเกม</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#b7c6dd]">
        รายการโต๊ะและผู้ให้บริการที่พร้อมใช้งานเปลี่ยนแปลงได้ จึงควรตรวจสอบรายการล่าสุดจากหมวดคาสิโน Live ก่อนเข้าเล่นทุกครั้ง
        ส่วนข้อมูลเกี่ยวกับสตูดิโอหรือแหล่งถ่ายทอดสดควรยึดข้อมูลที่แสดงในเกมโดยตรง
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="โปรโมชั่น LION991 ตรวจสอบได้จากบัญชีสมาชิกหลัง Login" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d6e2f5]">
        สมาชิก <strong class="text-[#8fc2ff]">Login เพื่อตรวจสอบโปรโมชั่นที่เปิดให้รับในช่วงเวลานั้นได้จากบัญชีของตนเอง</strong>
        ไม่ว่าจะเป็นสิทธิ์สำหรับสมาชิกใหม่ โปรโมชั่นยอดฝาก กิจกรรมแนะนำเพื่อน หรือโบนัสประเภทอื่น ๆ ตามที่เว็บไซต์กำหนดในรอบนั้น
      </p>

      <p class="text-left text-base leading-relaxed text-[#d6e2f5]">
        แต่ละโปรโมชั่นอาจมีเปอร์เซ็นต์ วิธีคำนวณ รอบรับโบนัส และข้อกำหนดในการถอนแตกต่างกัน ก่อนกดรับจึงควรอ่านรายละเอียดให้ครบถ้วน
        โดยเฉพาะ<strong class="text-[#e6ecf7]">ยอดขั้นต่ำ ประเภทเกมที่ร่วมรายการ และเงื่อนไขที่ต้องทำให้สำเร็จก่อนถอนโบนัส</strong>
        เพื่อเลือกโปรโมชั่นให้เหมาะกับการใช้งานของตนเอง
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="สมัครสมาชิกและฝากถอน LION991 จัดการเองได้จากบัญชีสมาชิก" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d6e2f5]">
        ผู้ใช้งานใหม่<strong class="text-[#8fc2ff]">สมัคร LION991 ผ่านระบบออนไลน์ได้ด้วยตัวเอง โดยไม่ต้องส่งข้อมูลการสมัครผ่านเจ้าหน้าที่</strong>
        เริ่มจากเปิดหน้าสมัครและกรอกข้อมูลตามที่ระบบกำหนด จากนั้น Login เข้าบัญชีและเลือกช่องทางฝากเครดิตที่เปิดให้บริการ
        แล้วจึงตรวจสอบโปรโมชั่น เลือกเกมคาสิโนหรือโต๊ะ Live และศึกษากติกาก่อนเริ่มเดิมพัน
      </p>

      <p class="text-left text-base leading-relaxed text-[#d6e2f5]">
        หลังสมัครเรียบร้อย สมาชิกตรวจสอบเครดิต ประวัติรายการ โปรโมชั่น และสถานะฝากถอนได้โดยตรงจากบัญชีของตนเอง
        หากเครดิตไม่เข้า รายการถอนค้าง หรือสถานะธุรกรรมไม่อัปเดต
        ควร<strong class="text-[#8fc2ff]">เก็บข้อมูลและหลักฐานรายการไว้เพื่อใช้ประกอบการตรวจสอบกับเจ้าหน้าที่</strong>
        จนกว่าการตรวจสอบจะเสร็จสิ้น
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="แอดมิน LION991 รับเรื่องออนไลน์ตลอด 24 ชั่วโมง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d6e2f5]">
        หากพบปัญหาเกี่ยวกับการสมัคร Login เข้าโต๊ะ Live ไม่ได้ ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง หรือโปรโมชั่นไม่แสดง สามารถ
        <strong class="text-[#8fc2ff]">ติดต่อแอดมิน LION991 ได้ตลอด 24 ชั่วโมง</strong>
        พร้อมแจ้งชื่อเกม เวลา จำนวนเงิน และรายละเอียดของรายการที่เกี่ยวข้อง เพื่อให้เจ้าหน้าที่ช่วยตรวจสอบได้ตรงจุด
      </p>

      <p class="text-left text-base leading-relaxed text-[#d6e2f5]">
        สมาชิกใหม่ยังสอบถามเรื่องวิธีใช้งานคาสิโนสด ขั้นตอนฝากถอน หรือโปรโมชั่นที่เปิดให้บริการก่อนเริ่มใช้งานจริงได้
        โดย<strong class="text-[#8fc2ff]">ไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น</strong>
      </p>

      <p class="text-left text-base leading-relaxed text-[#b7c6dd]">
        การเดิมพันมีความเสี่ยงและผลของแต่ละตาไม่แน่นอน ไม่มีเกมหรือรูปแบบใดรับประกันผลล่วงหน้า
        สมาชิกจึงควรกำหนดงบประมาณก่อนเริ่มเดิมพันทุกครั้ง
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก LION991"
          class="flex items-center justify-center rounded-lg border border-[#b7c6dd]/60 bg-gradient-to-r from-[#e6ecf7] via-[#b7c6dd] to-[#7d90ad] px-8 py-3 font-black text-[#01041c] shadow-[0_0_15px_rgba(183,198,221,0.30)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ LION991"
          class="flex items-center justify-center rounded-lg border border-[#1046e0]/60 bg-transparent px-8 py-3 font-bold text-[#8fc2ff] transition-all hover:scale-105 hover:border-[#b7c6dd] hover:bg-[#0a3390]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
