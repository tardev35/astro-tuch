---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char, so a byte count reads
// ~3x too long). One string, reused by MainLayout's meta and the WebPage node.
const pageDescription =
  "รู้จัก CREEKBET เว็บคาสิโนออนไลน์ที่รวมบาคาร่า รูเล็ต เสือมังกร คาสิโนสด และสล็อตไว้ในบัญชีเดียว พร้อมโบนัส 0.3% - 0.8% ระบบฝากถอนอัตโนมัติและแอดมินดูแล 24 ชม.";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ CREEKBET เว็บคาสิโนออนไลน์ครบทุกการเดิมพัน",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา CREEKBET เกมคาสิโนเว็บแท้ ครบทุกการเดิมพัน" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ CREEKBET" as="h1">
    <p class="mb-6 text-left text-base leading-relaxed text-[#dfe4ea]">
      <strong class="text-[#cfd4da]">CREEKBET</strong> พร้อมให้บริการสมาชิกที่ต้องการเล่นเกมคาสิโนออนไลน์ผ่านมือถือและคอมพิวเตอร์ โดยรวบรวม
      <strong class="text-[#cfd4da]">เกมเดิมพันหลากหลายประเภทไว้ภายในบัญชีเดียว</strong> ทั้งบาคาร่า รูเล็ต เสือมังกร คาสิโนสด สล็อต และเกมเดิมพันอื่น ๆ
      พร้อมโปรโมชั่นสำหรับสมาชิกตั้งแต่ 0.3% - 0.8% ตามเงื่อนไขที่กำหนด และระบบฝากถอนอัตโนมัติที่ช่วยให้ทำรายการได้สะดวกตลอด 24 ชั่วโมง
    </p>

    <p class="mb-2 text-left text-base leading-relaxed text-[#dfe4ea]">
      สิ่งที่ CREEKBET ให้ความสำคัญคือความชัดเจนของข้อมูล ทั้งเปอร์เซ็นต์โบนัส วิธีคำนวณ รอบการรับสิทธิ์ และเงื่อนไขการถอน จะแสดงอยู่ในหน้ารายละเอียดโปรโมชั่นก่อนเข้าร่วมเสมอ
      สมาชิกควรอ่านเงื่อนไขตรงจุดนั้นทุกครั้ง เพราะข้อกำหนดของแต่ละรายการไม่เท่ากัน และมีทีมงานคอยดูแลตั้งแต่การสมัคร การรับโบนัส ฝากถอน ไปจนถึงการแก้ไขปัญหาระหว่างใช้งาน
    </p>
  </ContentBox>

  <ContentBoxPlain title="เกมคาสิโน CREEKBET เลือกเล่นได้ครบในบัญชีเดียว" as="h2">
    <p class="mb-2 text-left text-base leading-relaxed text-[#dfe4ea]">
      สมาชิกสามารถเข้าเล่นคาสิโน CREEKBET ผ่านระบบที่รองรับทั้งสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ ภายในมีเกมให้เลือกหลายหมวดหมู่ ทั้ง
      <strong class="text-[#cfd4da]">บาคาร่า รูเล็ต เสือมังกร คาสิโนสด สล็อต และเกมเดิมพันอื่น ๆ</strong> พร้อมจัดหมวดหมู่ให้เลือกใช้งานได้ง่ายผ่านบัญชีเดียว
      สำหรับอัตราการจ่าย ยอดเดิมพันขั้นต่ำ และวงเงินของแต่ละเกม อาจแตกต่างกันตามประเภทเกมและผู้ให้บริการ สมาชิกจึงควรตรวจสอบรายละเอียดที่แสดงในระบบก่อนยืนยันการเดิมพันทุกครั้ง
    </p>
  </ContentBoxPlain>

  <ContentBoxPlain title="โปรโมชั่น CREEKBET คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%" as="h2">
    <p class="mb-2 text-left text-base leading-relaxed text-[#dfe4ea]">
      CREEKBET มีโปรโมชั่นสำหรับสมาชิกที่เข้าเงื่อนไข โดยสามารถ Login เพื่อตรวจสอบสิทธิ์และกดรับโบนัสผ่านบัญชีของตนเอง โปรโมชั่นแต่ละรายการจะแสดงรายละเอียดเกี่ยวกับ
      <strong class="text-[#cfd4da]">เปอร์เซ็นต์ วิธีคำนวณ รอบรับโบนัส และข้อกำหนดที่เกี่ยวข้อง</strong> เพื่อให้สมาชิกตรวจสอบรายละเอียดล่าสุดก่อนกดรับสิทธิ์
    </p>

    <p class="mt-3 mb-2 text-left text-base leading-relaxed text-[#dfe4ea]">
      สำหรับ <strong class="text-[#cfd4da]">โบนัสคืนยอดเสีย 0.3%</strong> สมาชิกที่มียอดเสียตรงตามข้อกำหนดสามารถตรวจสอบสิทธิ์ตามรอบประจำวันที่กำหนด ระบบจะแสดงยอดที่ใช้คำนวณและโบนัสที่กดรับได้
      ควรตรวจสอบประเภทเกมที่เข้าร่วม รอบคำนวณ และเงื่อนไขการถอนให้ครบถ้วน ส่วน
      <strong class="text-[#cfd4da]">โบนัสแนะนำเพื่อน 0.8%</strong> เปิดให้สมาชิกนำลิงก์แนะนำส่วนตัวไปแชร์ เมื่อเพื่อนสมัครและมียอดการใช้งานตรงตามเงื่อนไข ระบบจะคำนวณโบนัสให้ พร้อมติดตามข้อมูลการแนะนำและยอดโบนัสผ่านบัญชีของตนเองได้
    </p>
  </ContentBoxPlain>

  <ContentBoxPlain title="ฝากถอนอัตโนมัติ และแอดมิน CREEKBET ดูแลตลอด 24 ชั่วโมง" as="h2">
    <p class="mb-6 text-left text-base leading-relaxed text-[#dfe4ea]">
      <strong class="text-[#cfd4da]">ระบบ CREEKBET</strong> ออกแบบให้สมาชิกจัดการบัญชีและธุรกรรมผ่านหน้าเว็บไซต์ได้ด้วยตนเอง ทั้ง Login ตรวจสอบเครดิต
      ฝากถอนผ่านระบบอัตโนมัติ และเลือกหมวดหมู่เกมคาสิโนได้ตลอด 24 ชั่วโมง หน้าเว็บไซต์รองรับทั้ง Android, iOS แท็บเล็ต และคอมพิวเตอร์ เข้าใช้งานผ่านเว็บเบราว์เซอร์ได้โดยตรง
      หากพบปัญหาเกี่ยวกับการสมัครสมาชิก การ Login เครดิตไม่เข้า ฝากถอนล่าช้า โบนัสไม่แสดง หรือไม่สามารถเข้าเกมได้ สามารถติดต่อ
      <strong class="text-[#cfd4da]">แอดมิน CREEKBET ได้ตลอด 24 ชั่วโมง</strong> พร้อมแจ้งรายละเอียดและเวลาที่พบปัญหา เพื่อให้ทีมงานตรวจสอบรายการและแนะนำขั้นตอนดำเนินการต่อได้รวดเร็วยิ่งขึ้น
      ทั้งนี้ การเดิมพันมีความเสี่ยงและไม่สามารถรับประกันผลกำไรได้ ควรศึกษากติกาของแต่ละเกมและกำหนดงบประมาณก่อนเล่นทุกครั้ง
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก CREEKBET"
        class="flex items-center justify-center rounded-lg bg-gradient-to-r from-[#f4f6f8] via-[#cfd4da] to-[#9aa2ab] px-8 py-3 font-black text-[#0a0b0d] shadow-[0_0_15px_rgba(207,212,218,0.28)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ CREEKBET"
        class="flex items-center justify-center rounded-lg border border-[#cfd4da]/70 bg-transparent px-8 py-3 font-bold text-[#dfe4ea] transition-all hover:scale-105 hover:border-[#f4f6f8] hover:bg-[#131519]/70">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
