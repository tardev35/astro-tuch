---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char, so a byte count reads
// ~3x too long). One string, reused by MainLayout's meta and the WebPage node.
const pageDescription =
  "รู้จัก UFA99 เว็บรวมคาสิโนสล็อต ค่ายเกมแท้ มาตรฐานเอเชีย รวมสล็อต บาคาร่า รูเล็ต เสือมังกร แบล็กแจ็ก และคาสิโนสด พร้อมโบนัสแนะนำเพื่อน 0.8% คืนยอดเสีย 0.3%";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ UFA99 เว็บรวมคาสิโนสล็อต ค่ายเกมแท้ มาตรฐานเอเชีย",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา UFA99 เว็บรวมคาสิโนสล็อต ค่ายเกมแท้ มาตรฐานเอเชีย" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ UFA99" as="h1">
    <p class="mb-6 text-left text-base leading-relaxed text-[#ece0c8]">
      <strong class="text-[#fce48c]">UFA99</strong> คือเว็บรวมคาสิโนและเกมสล็อตออนไลน์ที่ให้สมาชิกเข้าใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ได้ในระบบเดียว
      ภายในบัญชีเดียวมีเกมเดิมพันหลายหมวดหมู่ให้เลือก ทั้ง <strong class="text-[#fce48c]">สล็อต บาคาร่า คาสิโนสด รูเล็ต เสือมังกร และแบล็กแจ็ก</strong>
      พร้อมโปรโมชั่นสำหรับสมาชิก ระบบฝากถอนอัตโนมัติ และบริการช่วยเหลือตลอด 24 ชั่วโมง เพื่อให้การสมัคร เข้าสู่ระบบ ฝากถอน และเลือกเกมทำได้สะดวกในทุกช่วงเวลา
    </p>

    <p class="mb-2 text-left text-base leading-relaxed text-[#ece0c8]">
      สิ่งที่ UFA99 ให้ความสำคัญคือความชัดเจนของข้อมูล รายละเอียดของโบนัส ยอดที่นำมาคำนวณ รอบการกดรับ และเงื่อนไขการถอนจะแสดงอยู่ในหน้ารายละเอียดโปรโมชั่นก่อนเข้าร่วมเสมอ
      สมาชิกควรอ่านเงื่อนไขตรงจุดนั้นทุกครั้ง เพราะข้อกำหนดของแต่ละรายการไม่เท่ากัน และมีทีมงานคอยให้คำแนะนำเมื่อพบปัญหาในการใช้งาน
    </p>
  </ContentBox>

  <ContentBoxPlain title="แหล่งเดิมพัน UFA99 คาสิโนค่ายแท้ มาตรฐานเอเชีย" as="h2">
    <p class="mb-2 text-left text-base leading-relaxed text-[#ece0c8]">
      UFA99 รวบรวมเกมคาสิโนและเกมสล็อตจากหลากหลายค่ายไว้ในบัญชีเดียว มีทั้ง <strong class="text-[#fce48c]">สล็อต บาคาร่า รูเล็ต เสือมังกร แบล็กแจ็ก คาสิโนสด</strong>
      และเกมเดิมพันประเภทอื่น ๆ ระบบจัดหมวดหมู่ให้ค้นหาเกมได้ง่าย พร้อมรองรับการเล่นผ่านเว็บเบราว์เซอร์บนทุกอุปกรณ์ โดยไม่ต้องสลับใช้งานหลายบัญชี
      ก่อนเดิมพันสมาชิกสามารถตรวจสอบกติกา รายละเอียด และเงื่อนไขของเกมที่สนใจได้จากระบบทุกครั้ง
    </p>
  </ContentBoxPlain>

  <ContentBoxPlain title="โบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ของ UFA99" as="h2">
    <p class="mb-2 text-left text-base leading-relaxed text-[#ece0c8]">
      สมาชิกสามารถติดตามโปรโมชั่น UFA99 ที่เปิดให้รับได้เป็นประจำ ไม่ว่าจะเป็น <strong class="text-[#fce48c]">โบนัสแนะนำเพื่อน โปรโมชั่นคืนยอดเสีย</strong>
      หรือสิทธิพิเศษอื่น ๆ ตามช่วงเวลาที่กำหนด โดยสามารถตรวจสอบเปอร์เซ็นต์โบนัส ยอดที่นำมาคำนวณ รอบการกดรับ และเงื่อนไขการถอนผ่านหน้ารายละเอียดโปรโมชั่นก่อนเข้าร่วมทุกครั้ง
    </p>

    <p class="mt-3 mb-2 text-left text-base leading-relaxed text-[#ece0c8]">
      สำหรับ <strong class="text-[#fce48c]">โปรโมชั่นแนะนำเพื่อน รับโบนัส 0.8%</strong> สมาชิกสามารถแชร์ลิงก์แนะนำของตนเองและติดตามสิทธิ์ผ่านบัญชีสมาชิก ส่วน
      <strong class="text-[#fce48c]">โปรโมชั่นคืนยอดเสีย รับโบนัส 0.3%</strong> จะคำนวณตามยอดและประเภทเกมที่เข้าเงื่อนไข ช่วยให้ตรวจสอบสิทธิ์ของตนเองได้อย่างชัดเจนก่อนกดรับโบนัส
    </p>
  </ContentBoxPlain>

  <ContentBoxPlain title="ระบบฝากถอนอัตโนมัติ และทีมงาน UFA99 ดูแลตลอด 24 ชั่วโมง" as="h2">
    <p class="mb-6 text-left text-base leading-relaxed text-[#ece0c8]">
      <strong class="text-[#fce48c]">ระบบ UFA99</strong> ออกแบบให้สมาชิกจัดการข้อมูลบัญชีและธุรกรรมผ่านหน้าเว็บไซต์ได้ด้วยตนเอง ทั้งเข้าสู่ระบบ ตรวจสอบเครดิต
      ฝากถอนผ่านระบบอัตโนมัติ และเลือกเกมได้ตลอด 24 ชั่วโมง พร้อมแสดงประวัติรายการเพื่อให้ง่ายต่อการตรวจสอบ หากพบปัญหาเกี่ยวกับการเข้าสู่ระบบ เครดิตไม่เข้า ถอนเงินล่าช้า
      หรือโปรโมชั่นไม่แสดง สามารถติดต่อ <strong class="text-[#fce48c]">ทีมงาน UFA99 ได้ตลอด 24 ชั่วโมง</strong> เพื่อให้เจ้าหน้าที่ช่วยตรวจสอบและแนะนำขั้นตอนดำเนินการต่อ
      ทั้งนี้ การพนันมีความเสี่ยงและไม่สามารถรับประกันผลกำไรได้ สมาชิกควรศึกษากติกาของแต่ละเกมและกำหนดงบประมาณก่อนเดิมพันทุกครั้ง
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก UFA99"
        class="flex items-center justify-center rounded-lg bg-gradient-to-r from-[#fce48c] via-[#ebc36b] to-[#7b5213] px-8 py-3 font-black text-[#0d0904] shadow-[0_0_15px_rgba(235,195,107,0.45)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ UFA99"
        class="flex items-center justify-center rounded-lg border border-[#ebc36b]/70 bg-transparent px-8 py-3 font-bold text-[#ece0c8] transition-all hover:scale-105 hover:border-[#fce48c] hover:bg-[#0d0904]/70">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
