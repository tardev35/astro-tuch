---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็น **บทความจริง** (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login,
// /register หรือหน้าภาพแบบ /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง
// ไม่ใช่เช็กลิสต์หัวข้อของบรีฟที่ใช้กับ index.astro — บรีฟรอบนี้
// (src/assets/content.txt, 29 บรรทัด) ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าใหม่จาก
// ข้อเท็จจริงและคลังคำของบรีฟรอบนี้เท่านั้น (.claude/brand-spec-abm96.md §4-§5)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x5 · h3x0
//   h1  เกี่ยวกับเรา <แบรนด์> เว็บเอเอ็มบีคาสิโน แหล่งเดิมพันเกมออนไลน์
//   h2  บาคาร่า สล็อตออนไลน์ รูเล็ต ไฮโล และคาสิโนสด ที่ <แบรนด์> รวบรวมไว้
//   h2  สิ่งที่ควรตรวจสอบเองก่อนเชื่อคำกล่าวอ้างเรื่องเริ่มต้น1บาทและโบนัสไม่อั้น
//   h2  ระบบสมาชิกของ <แบรนด์> และการสมัคร 3 ขั้นตอน
//   h2  คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% กับสิ่งที่ควรอ่านก่อนรับสิทธิ์
//   h2  ช่องทางติดต่อทางการของ <แบรนด์> และสิ่งที่ควรเตรียมก่อนแจ้งปัญหา
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// ป้ายกำกับของ <ul> อยู่ใน aria-label **ห้ามเลื่อนเป็น heading**
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) และจาก footer จึงเปิดใช้งานอยู่
// ⚠️ หัวข้อของหน้านี้ **ตั้งใจไม่ให้ซ้ำกับหัวข้อของ index.astro** — index เล่าว่า
// เว็บไซต์ "ระบุอะไรไว้" ตามลำดับของบรีฟ ส่วนหน้านี้เล่าว่า "ตรวจสอบอะไรได้จากที่ไหน"
// ถ้ารอบหน้าคัดลอกหัวข้อของ index มาวางที่นี่ จะได้สองหน้าที่แข่งกันเองใน index
//
// 🚨🚨 ดรอปนี้ (2026-10-29) **แบรนด์ขาออกอยู่คนละแกนธุรกิจ** — รอบก่อน LOTTOPLUS
// เป็น **เว็บหวย** รอบนี้เป็น **เว็บคาสิโนออนไลน์** เนื้อหาทั้งหน้าจึงถูก
// **เขียนใหม่ทั้งหน้า** ไม่ใช่แค่เปลี่ยนชื่อแบรนด์ บรีฟรอบนี้เรียกตัวเองว่า
// "เว็บเอเอ็มบีคาสิโน แหล่งเดิมพันเกมออนไลน์" และระบุหมวดเกมไว้ **ห้าหมวด**
// (บาคาร่า · สล็อตออนไลน์ · รูเล็ต · ไฮโล · คาสิโนสด) · เริ่มต้นเดิมพัน 1 บาท ·
// ไลฟ์เดิมพัน 24 ชั่วโมง · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · สมัคร 3 ขั้นตอน ·
// แอดมินออนไลน์ตลอด 24ชม.
// 🚨🚨 **คำว่า "หวย" ทุกรูป สลาก งวด โพย เลขอั้น รอบปิดรับ สองตัวบน-ล่าง
// สามตัวตรง-โต๊ด 2 ตัว จ่าย 100 3 ตัว จ่าย 1,000 ทางเข้าเว็บแม่ แทงหวยออนไลน์
// อัตราจ่ายสูง จ่ายเต็ม โอนไว — ไม่มีในบรีฟรอบนี้เลยสักคำ ห้ามโผล่ที่ไหนบนหน้านี้**
// (ลิสต์เต็มอยู่ใน brand-spec §5)
// ⚠️⚠️ ศัพท์หมวดธุรกิจของแบรนด์ขาออกเป็น **คำค้างข้ามแบรนด์** ห้ามหลุดกลับมา
// **รายการคำต้องห้ามเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่** เพื่อไม่ให้
// sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// 🚨 กลับกัน **"คืนยอดเสีย 0.3%" / "แนะนำเพื่อน 0.8%" / "โบนัสไม่อั้น" /
// "บาคาร่า" / "สล็อต" เคยเป็นคำต้องห้ามของรอบก่อน แต่รอบนี้เป็นถ้อยคำของบรีฟเอง
// — ห้ามลบออกเพราะอ่านคอมเมนต์เก่าในไฟล์ inventory แล้วเข้าใจผิด**
// ⚠️⚠️ ชื่อแบรนด์รอบนี้เป็น **ตัวละตินพิมพ์ใหญ่ติดเลข ยาว 5 อักขระ** ทุกจุด
// interpolate จาก BRAND_NAME เพื่อไม่ให้ค้างเป็นชื่อแบรนด์ก่อนหน้าตอนรีแบรนด์รอบ
// ถัดไป **ห้ามพิมพ์ชื่อแบรนด์เป็น literal** และห้ามพิมพ์โดเมน
//
// ⚠️ route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ทดลองเล่น · /about-us · /contact-us · /terms · /privacy · /line
// 🚨 **รอบนี้ /ตรวจหวย และ /แนวทาง ถูกย้ายไป src/pages-disabled/ แล้ว**
// (แบรนด์นี้เป็นคาสิโน บรีฟไม่มีคำว่าหวยเลย) — ลิงก์ที่ค้างไปสองหน้านั้น = href
// ชี้ route ที่ไม่มีจริงใน dist/ = verify-build แดง **ห้ามลิงก์ถึงเด็ดขาด**
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกม ชื่อผู้ให้บริการ หน่วยงานกำกับ เลขใบอนุญาต
// ปีก่อตั้ง จำนวนสมาชิก ค่า RTP จำนวนเกม หรือยอดฝากขั้นต่ำเป็นตัวเลข
// แม้แต่รายการเดียว** จึงห้ามเขียนลงหน้าเว็บ · ตัวเลขที่ขึ้นหน้าได้มีแค่ของบรีฟเอง:
// **1 บาท · 0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง / 24ชม.**
//
// 🚨 **บรีฟรอบนี้โฆษณาแล้วกำกับตัวเองในย่อหน้าเดียวกันแทบทุกย่อหน้า** — ทั้งสอง
// ครึ่งต้อง ship ครบ ประโยคกำกับไม่ใช่ filler ให้ตัดทิ้ง:
// 1) เกมเดิมพันมีความเสี่ยงและไม่สามารถรับประกันผลรางวัลได้ ·
//    ควรตรวจสอบรายชื่อผู้ให้บริการเกม เงื่อนไขการใช้งาน และความน่าเชื่อถือของ
//    แพลตฟอร์มก่อนทำรายการ (บรีฟบรรทัด 4 — รับที่ h1 และ h2 #2)
// 2) ควรตรวจสอบยอดเดิมพันขั้นต่ำของแต่ละค่าย ตารางเวลาเปิดโต๊ะ และข้อกำหนด
//    การใช้งานจริง (บรีฟบรรทัด 6, 27 — รับที่ h2 #1 และ #2)
// 3) แม้เว็บไซต์จะใช้ข้อความว่าโบนัสไม่อั้น แต่ควรตรวจสอบว่ามีวงเงินสูงสุดหรือ
//    ข้อกำหนดเพิ่มเติมหรือไม่ (บรีฟบรรทัด 8 — รับที่ h2 #4)
// 4) **โปรโมชั่นคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือ
//    เพิ่มโอกาสชนะในครั้งถัดไป** (บรีฟบรรทัด 10 — รับที่ h2 #4)
// 5) ควรตรวจสอบข้อกำหนดด้านอายุ กฎหมายที่เกี่ยวข้อง และนโยบายความเป็นส่วนตัว ·
//    ไม่ควรเปิดเผยรหัสผ่านและรหัส OTP (บรีฟบรรทัด 14, 18 — รับที่ h2 #3)
// 6) ควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการเพื่อหลีกเลี่ยงบัญชีแอบอ้าง ·
//    เก็บหมายเลขรายการและหลักฐานไว้ · ตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุด
//    (บรีฟบรรทัด 22 — รับที่ h2 #5)
//
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) **ทิศความสว่างเหมือนรอบก่อน แต่คนละตระกูลสี
// ทั้งชุด: เนื้อหาสว่าง โครมเข้ม** bg.json ของดรอปนี้คือ
// {"mode":"color","color":"#f8b9f0"} = **ชมพูพาสเทลอิ่มตัว**
// (รอบก่อนเป็น e1fef3 เขียวมินต์จาง — เปิด bg.json อ่านทุกรอบ ห้ามสืบทอด)
// **ห้าม "แก้" การ์ด/ปุ่มกลับไปเป็นผิวเข้ม** — ผิวเข้มบนหมึก #3d0a2c =
// ตัวอักษรหายไปเลย ไม่ใช่แค่จางลง
// ค่าที่ใช้ได้ในไฟล์นี้: `<strong>`/marker/ลิงก์ **#a30d63** (7.5:1 บนการ์ด #ffffff) ·
// เนื้อความ #3d0a2c (16.4:1) · หมึกรอง #7a4263 (7.5:1) · ทองเข้ม #6e4705 (8.2:1) ·
// พื้นไล่เฉดปุ่มหลัก #d11a7e -> #a30d63 -> #7a0449 (**พื้นถม** + หมึกขาว #ffffff —
// 5.0 / 7.5 / 10.8:1 ต่อ stop) · ปุ่มรองเป็นผิว #ffffff หมึก #a30d63 ขอบ #e0509f ·
// ปุ่ม outline ขอบ #f3a7d3 ตัวอักษร #a30d63 บนผิว #ffffff hover ยกเป็น #fff5fb ·
// ชั้นยก/ชิป #fcd9ee · เส้นบาง #f3a7d3 · ขอบตกแต่ง/ออรา #e0509f · ออราสว่าง #ff7ac2
// (**สี่ค่าท้ายห้ามถือตัวอักษร** — #e0509f ได้แค่ 3.6:1 บนการ์ดขาว)
// หมึกเนื้อความคือ #3d0a2c (= BRAND_TEXT) ซึ่ง **ไม่ประกาศในไฟล์นี้** การ์ด
// ContentBox ตั้งไว้ให้แล้วและย่อหน้าสืบทอดลงมา
// 🚨🚨 **#f3a7d3 · #fcd9ee · #e0509f · #ff7ac2 — ห้ามเป็นสีตัวอักษร** เป็นเส้น/ขอบ/
// ออรา/พื้นถมเท่านั้น · **#f2c14e ได้แค่ 1.7:1 บนการ์ดขาว ห้ามถือตัวอักษรเช่นกัน**
// บนการ์ดสว่างให้ใช้ #6e4705 แทนเมื่อต้องการโทนทอง
// และ **ห้ามใช้หมึกเข้ม #3d0a2c บนไล่เฉดปุ่มหลัก** (บน #7a0449 ได้ 1.5:1)
// **ห้ามลากปลายอ่อนของไล่เฉดให้อ่อนกว่า #d11a7e** (ขาวบน #e0509f เหลือ 3.6:1)
// ออราที่อนุญาต: rgba(163,13,99,α) · rgba(224,80,159,α) · rgba(255,122,194,α) ·
// rgba(209,26,126,α) · rgba(61,10,44,α) · rgba(68,13,49,α) · rgba(43,6,32,α)
// ⚠️⚠️ **เงาบนการ์ดสว่างต้องเบา** — ค่า alpha ของรอบก่อนถูกสำหรับการ์ดเข้ม แต่บน
// ผิวขาวจะกลายเป็นคราบเทาหนา **ห้ามลอก alpha ของรอบก่อนมา**
// 🚨🚨 **เขียวมรกต-ทองอำพันบนผิวสว่างคือฮิวของรอบก่อน รอบนี้เป็นชมพูบานเย็น-พลัม**
// ที่ห้ามคือ **ค่าเฮกซ์ของแบรนด์เก่าแบบตรงหกหลัก** ไม่ใช่ "สีชมพู" ในฐานะตระกูลสี
// เพราะมีแบรนด์ชมพูมาแล้วหลายเจ้า (okkub88 ชมพูบานเย็น · ถอนชัวร์168 ชมพูบับเบิลกัม ·
// 123BET แดงชาด-ชมพูบลัช · ZANE96 แมเจนต้า-ไวโอเลต)
// ต้องเทียบ **ทีละค่า** กับตาราง brand-spec §2 (คู่ที่พิมพ์ผิดง่ายสุดลิสต์ไว้ในนั้น
// แล้ว และเขียนแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep สะดุด)
// ค่าของ LOTTOPLUS รอบก่อนทันทีที่ต้องไม่หลงเหลือ เขียนแบบไม่มี #:
//  e1fef3 f0fdf7 d2f3e4 a3ddc3 19a97c 2fd49b 0d3326 3f6f5c 046c4e 0c7c58 03543c
//  8a6508 e2b32a c8d4d0
//  + rgba(4,108,78) rgba(25,169,124) rgba(47,212,155) rgba(226,179,42) rgba(13,51,38)
// ⚠️ ข้อยกเว้นสีเชิงความหมาย: **LINE green #00B900** บนปุ่ม LINE (ต้องเป็นพื้นถม
// ของค่านั้น + ตัวอักษรขาว) **ห้ามกลืนเข้าชมพูบานเย็นของพาเลตรอบนี้ และห้ามเอามา
// ใช้เป็นสีแบรนด์**
// ⚠️ ผ้าซาตินชมพู ชุดลูกไม้ของนางแบบ โบว์ริบบิ้น ต่างหูรูปหัวใจ ลูกหมูการ์ตูน
// ไพ่เอซ ลูกเต๋าชมพู ชิปคาสิโน วงล้อรูเล็ตขอบทอง และสีผิวนางแบบในอาร์ตเวิร์ก
// เป็น **วัตถุในภาพ ไม่ใช่สี UI** · พื้นเพจมาจาก bg.json เท่านั้น
//
// ลำดับปุ่มในไฟล์นี้สื่อด้วยพื้นถมสามขั้ว (ตรงกับคู่ปุ่มที่ล็อกไว้ใน brand-spec §2):
// · ปุ่มหลัก (สมัครสมาชิก) ไล่เฉด #d11a7e -> #a30d63 -> #7a0449 หมึกขาว #ffffff
// · ปุ่มรอง (เข้าสู่ระบบ) ผิว #ffffff หมึก #a30d63 ขอบหนา #e0509f
// · ปุ่มลิงก์ภายในเป็นปุ่ม outline ขอบบาง #f3a7d3 ตัวอักษร #a30d63 บนผิว #ffffff
//   hover ยกพื้นขึ้นเป็นการ์ดสำรอง #fff5fb
// · ชิปไอคอนของรายการใช้ขอบ #f3a7d3 บนพื้นถมอ่อน #fcd9ee ไม่ถือตัวอักษร
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง และไม่ใส่ mx-auto / max-w-* บน <p>
// เพราะการ์ดคุมความกว้างเองแล้ว — ที่ประกาศสีได้มีแค่ปุ่ม ชิปไอคอน marker ของ
// ลำดับเลข และ <strong> · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง
// เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำ
// จะขาดครึ่ง (ลบแท็ก <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิม) และห้ามวาง
// <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังใน prop ที่เป็นข้อความ และรอบนี้ต้องเป็นไอคอนหมวดเกมคาสิโน ไม่ใช่
// ไอคอนลูกบอลหวย/โพย/ธงประเทศของรอบก่อน
// slot ของ ContentBox รับ **หนึ่ง element** เท่านั้น จึงห่อด้วย <div> ชั้นเดียว
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: รูปของดรอปนี้ถูกตรึงไว้ที่อื่นครบทุกไฟล์ —
// สไลด์สองใบของดรอปถูกตรึงไว้กับ index และ /promotion · banner1 /
// banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// แบนเนอร์ใบที่สองและสาม (2026-10-23) กับสไลด์ใบที่สามและสี่ (2026-09-29)
// เป็นอาร์ตเวิร์กของแบรนด์อื่น **ห้าม import ทั้งสี่ไฟล์**
// (ชื่อไฟล์เต็มอยู่ใน brand-spec §6) (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง
// dist/ และ verify-build จะแดง) — ไฟล์ทั้งหมดยังอยู่บนดิสก์ **ห้ามลบ**
// เป็นอินเวนทอรีของแบรนด์ถัดไป
//
// Announcement รอบนี้หมุนมาเป็นตัวเลขห้า ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ตัวท้ายชื่อหวยจึงหมุนออก · เขียนชื่อ variant แบบไม่มีเครื่องหมายคำพูด
// โดยตั้งใจ เพราะ tools/gen-tw-sources.mjs นับ literal ที่มีเครื่องหมายคำพูดว่าเป็น
// การ import จริง) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์
// นี้แล้ว จึงเรียกแบบ bare **ห้ามส่ง prop message** มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกัน
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -c บนเชลล์นี้
// ก็นับเป็นไบต์ ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับตัวนับ
// ของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 155 อักขระ (ชื่อแบรนด์รอบนี้ 5 อักขระ) เป็นประโยคเดียวที่บอกว่า
// หน้านี้มีอะไร แล้วหยุด **ต้องนับใหม่ทุกรอบ** ห้ามสืบทอดความยาว
// (Google ตัดราว 160 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนๆ ยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} เว็บเอเอ็มบีคาสิโน หน้ารวมข้อมูลบาคาร่า สล็อตออนไลน์ รูเล็ต ไฮโล คาสิโนสด ระบบสมาชิก โปรโมชั่น และสิ่งที่ควรตรวจสอบเองก่อนเริ่มใช้บริการ`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} เว็บเอเอ็มบีคาสิโน แหล่งเดิมพันเกมออนไลน์`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

// คลาสปุ่มสามขั้วของหน้านี้ ประกาศครั้งเดียวแล้วใช้ซ้ำ เพื่อไม่ให้สองปุ่มที่ทำ
// หน้าที่เดียวกันหลุดไปคนละเฉดตอนรีแบรนด์รอบหน้า
const ctaPrimary =
  "flex items-center justify-center rounded-full border border-[#e0509f] bg-gradient-to-b from-[#d11a7e] via-[#a30d63] to-[#7a0449] px-8 py-3 font-black text-[#ffffff] shadow-[0_6px_18px_rgba(163,13,99,0.28)] transition-transform hover:scale-105";

const ctaSecondary =
  "flex items-center justify-center rounded-full border-2 border-[#e0509f] bg-[#ffffff] px-8 py-3 font-bold text-[#a30d63] shadow-[0_6px_18px_rgba(61,10,44,0.10)] transition-transform hover:scale-105";

const ctaQuiet =
  "flex items-center justify-center rounded-full border border-[#f3a7d3] bg-[#ffffff] px-8 py-3 font-bold text-[#a30d63] shadow-[0_4px_14px_rgba(61,10,44,0.10)] transition-all hover:scale-105 hover:border-[#e0509f] hover:bg-[#fff5fb] hover:shadow-[0_6px_18px_rgba(163,13,99,0.18)]";

const listChip = "mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#f3a7d3] bg-[#fcd9ee] text-sm";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#a30d63]">
          {BRAND_NAME} เว็บเอเอ็มบีคาสิโน นำเสนอข้อมูลเกมเดิมพันออนไลน์หลากหลายประเภท ทั้งบาคาร่า สล็อตออนไลน์ รูเล็ต ไฮโล และคาสิโนสดที่มีการถ่ายทอดเกมแบบเรียลไทม์
        </strong>
        หน้านี้สรุปไว้ว่าเว็บไซต์ระบุอะไรไว้บ้าง และควรเปิดอ่านรายละเอียดส่วนไหนก่อน เพื่อให้เห็นภาพรวมก่อนไล่อ่านกติกาและเงื่อนไขของเกมแต่ละหมวดเป็นรายข้อ
      </p>

      <p>
        ผู้ใช้งานสามารถศึกษากติกา รูปแบบการเดิมพัน และอัตราจ่ายของแต่ละเกมผ่านโทรศัพท์มือถือหรือคอมพิวเตอร์ได้
        <strong class="text-[#a30d63]">
          โดยควรตรวจสอบรายชื่อผู้ให้บริการเกม เงื่อนไขการใช้งาน และความน่าเชื่อถือของแพลตฟอร์มก่อนทำรายการ เนื่องจากเกมเดิมพันมีความเสี่ยงและไม่สามารถรับประกันผลรางวัลได้
        </strong>
      </p>

      <p>
        เนื้อหาในหน้านี้จึงเขียนไว้ประกอบการใช้งานเท่านั้น ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้บริการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`บาคาร่า สล็อตออนไลน์ รูเล็ต ไฮโล และคาสิโนสด ที่ ${BRAND_NAME} รวบรวมไว้`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#a30d63]">
          {BRAND_NAME} รวบรวมข้อมูลเกมคาสิโนหลายรูปแบบไว้ในแพลตฟอร์มเดียว โดยแต่ละหมวดใช้กติกาและวงเงินเดิมพันของตัวเอง
        </strong>
        รายการด้านล่างคือหมวดที่เว็บไซต์ระบุไว้ และเป็นจุดเริ่มต้นสำหรับคนที่ยังไม่แน่ใจว่าควรเปิดอ่านเงื่อนไขของเกมไหนก่อน
      </p>

      <ul class="flex flex-col gap-4" aria-label="หมวดเกมคาสิโนที่เว็บไซต์ระบุไว้">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🃏</span>
          <span>
            <strong class="text-[#a30d63]">บาคาร่าออนไลน์</strong> มีตัวเลือกเดิมพันตามกติกาของเกม จึงควรอ่านว่าแต่ละตัวเลือกคิดอัตราจ่ายอย่างไร และวงเงินเดิมพันต่อตาของโต๊ะนั้นกำหนดไว้เท่าใด
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎰</span>
          <span>
            <strong class="text-[#a30d63]">สล็อตออนไลน์</strong> มีธีมและฟีเจอร์แตกต่างกันในแต่ละเกม การเปลี่ยนเกมจึงเท่ากับเริ่มอ่านกติกาชุดใหม่ ไม่ใช่เปลี่ยนแค่ภาพหน้าจอ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎡</span>
          <span>
            <strong class="text-[#a30d63]">รูเล็ต</strong> ใช้การหมุนวงล้อเป็นตัวตัดสินผล จึงควรตรวจสอบว่าโต๊ะที่เลือกรองรับรูปแบบการวางเดิมพันแบบใด และคิดอัตราจ่ายของแต่ละรูปแบบไว้อย่างไร
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎲</span>
          <span>
            <strong class="text-[#a30d63]">ไฮโล</strong> อ้างอิงผลจากลูกเต๋า จึงมีรูปแบบการเดิมพันและอัตราจ่ายเป็นของตัวเอง ควรอ่านแยกจากเกมอื่นที่อยู่ในหน้าเดียวกัน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📺</span>
          <span>
            <strong class="text-[#a30d63]">คาสิโนสด</strong> มีการถ่ายทอดเกมจากโต๊ะเดิมพันแบบเรียลไทม์ จึงควรตรวจสอบตารางเวลาเปิดโต๊ะของแต่ละรายการ เพราะไม่ใช่ทุกโต๊ะที่เปิดพร้อมกัน
          </span>
        </li>
      </ul>

      <p>
        เว็บไซต์ระบุว่าสามารถเริ่มต้นเดิมพันได้ตั้งแต่ 1 บาท และมีเกมไลฟ์ให้บริการตลอด 24 ชั่วโมง อย่างไรก็ตาม
        <strong class="text-[#a30d63]">
          ควรตรวจสอบยอดเดิมพันขั้นต่ำของแต่ละค่าย ตารางเวลาเปิดโต๊ะ และข้อกำหนดการใช้งานจริง เนื่องจากเกมบางประเภทอาจมีวงเงินและช่วงเวลาให้บริการแตกต่างกัน
        </strong>
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/ทดลองเล่น" aria-label={`เปิดหน้าทดลองเล่นของ ${BRAND_NAME}`} class={ctaQuiet}>ไปหน้าทดลองเล่น</a>

        <a href="/promotion" aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`} class={ctaQuiet}>ดูภาพโปรโมชั่น</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="สิ่งที่ควรตรวจสอบเองก่อนเชื่อคำกล่าวอ้างเรื่องเริ่มต้น1บาทและโบนัสไม่อั้น" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        เว็บไซต์อธิบายตัวเองไว้ว่าเป็นแหล่งเดิมพันเกมออนไลน์ที่ครบวงจร เริ่มต้น1บาท และมีโบนัสไม่อั้น ซึ่งเป็นถ้อยคำของเว็บไซต์เอง ไม่ใช่ข้อสรุปของหน้านี้ หัวข้อนี้จึงแยกให้ชัดระหว่างสิ่งที่เว็บไซต์ระบุไว้
        กับสิ่งที่ผู้ใช้งานตรวจสอบเองได้จากหน้ารายละเอียดจริง
      </p>

      <ul class="flex flex-col gap-4" aria-label="สิ่งที่ควรตรวจสอบด้วยตัวเองก่อนใช้งาน">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🔎</span>
          <span>
            <strong class="text-[#a30d63]">รายชื่อผู้ให้บริการเกมและความน่าเชื่อถือของแพลตฟอร์ม</strong> ควรตรวจสอบก่อนทำรายการทุกครั้ง พร้อมกับเงื่อนไขการใช้งานที่เว็บไซต์แสดงไว้ ไม่ใช่ยืนยันจากข้อความโฆษณาอย่างเดียว
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>💠</span>
          <span>
            <strong class="text-[#a30d63]">ยอดเดิมพันขั้นต่ำของเกมที่ต้องการเล่น</strong> ควรดูจากหน้ารายละเอียดของเกมนั้นเอง เพราะยอดขั้นต่ำอาจแตกต่างกันตามประเภทเกมและค่ายผู้ให้บริการ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📄</span>
          <span>
            <strong class="text-[#a30d63]">วงเงินสูงสุดและข้อกำหนดเพิ่มเติมของรายการโบนัส</strong> ควรอ่านให้ครบก่อนรับสิทธิ์ เพราะแม้เว็บไซต์จะใช้ข้อความว่าโบนัสไม่อั้น ก็ยังอาจมีเพดานหรือเงื่อนไขกำกับอยู่
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#a30d63]">หน้านี้จึงชี้ว่าควรอ่านอะไรและเปิดดูจากที่ไหน แทนที่จะยืนยันแทนเว็บไซต์</strong>
        เพราะสิ่งที่ยืนยันได้จริงคือเงื่อนไขที่แสดงอยู่บนหน้ารายละเอียดในขณะใช้บริการ ไม่ใช่ข้อความสรุปที่เขียนไว้ล่วงหน้า
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`ระบบสมาชิกของ ${BRAND_NAME} และการสมัคร 3 ขั้นตอน`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#a30d63]">
          {BRAND_NAME} ระบุช่องทางสมัครสมาชิกผ่านโทรศัพท์มือถือและอุปกรณ์ที่เชื่อมต่ออินเทอร์เน็ต โดยมีขั้นตอนลงทะเบียน 3 ขั้นตอน
        </strong>
        ก่อนดำเนินการควรตรวจสอบข้อกำหนดด้านอายุ กฎหมายที่เกี่ยวข้อง และนโยบายความเป็นส่วนตัว รวมถึงศึกษาวงเงินเดิมพันขั้นต่ำของแต่ละเกม เพื่อให้เข้าใจเงื่อนไขการใช้บริการอย่างครบถ้วน
      </p>

      <ol class="ml-6 list-decimal space-y-3 marker:font-black marker:text-[#a30d63]">
        <li>
          <strong class="text-[#a30d63]">เข้าสู่หน้าสมัครสมาชิก</strong> เปิดเว็บไซต์ผ่านเบราว์เซอร์บนมือถือ ตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง จากนั้นเลือกเมนูสมัครสมาชิกและอ่านข้อกำหนดการเปิดบัญชี
          รวมถึงรายละเอียดการใช้บริการก่อนดำเนินการ
        </li>
        <li>
          <strong class="text-[#a30d63]">กรอกข้อมูลและยืนยันบัญชี</strong> กรอกข้อมูลตามที่เว็บไซต์กำหนด ตรวจสอบความถูกต้องก่อนยืนยัน และตั้งรหัสผ่านที่คาดเดาได้ยาก ไม่ควรใช้ข้อมูลของบุคคลอื่นหรือเปิดเผยรหัสผ่านและรหัส
          OTP ให้ใครทราบ
        </li>
        <li>
          <strong class="text-[#a30d63]">เข้าสู่ระบบและตรวจสอบรายละเอียดเกม</strong> หลังลงทะเบียนเรียบร้อย สามารถศึกษาหมวดบาคาร่า สล็อตออนไลน์ รูเล็ต ไฮโล และคาสิโนสด พร้อมตรวจสอบกติกา อัตราจ่าย
