---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

// OCZPLUS เป็นเว็บสล็อต/คาสิโน ไม่ใช่เว็บหวย — ไม่มีเนื้อหาหวย ตรวจหวย หรือแนวทาง
// เนื้อหาทั้งหน้าอ้างอิงบรีฟของแบรนด์นี้เท่านั้น: ระบบนิเวศการเดิมพันแบบ
// Portal & Privilege · การันตียอดถอนทุกวัน จ่ายเต็มจำนวน ไร้ประวัติการโกง ·
// แจกโบนัสทุกยูส ไม่ล็อคยูส RNG 100% · แนะนำเพื่อน 0.8% · คืนยอดเสีย 0.3% ·
// ฝาก-ถอนออโต้ 3-5 วินาที ทุกธนาคาร + TrueMoney Wallet ไม่ต้องส่งสลิป ไม่มีขั้นต่ำ ·
// ถอนไม่จำกัดจำนวนครั้งและไม่จำกัดยอดต่อวัน · แอดมิน Line Official 24 ชม. ·
// รองรับ iOS/Android ลื่นไหล
// — ไม่มีการอ้างใบอนุญาต การจดทะเบียนบริษัท ปีที่ก่อตั้ง จำนวนสมาชิก การันตีผลกำไร
// หรือชื่อค่ายเกมรายใด เพราะบรีฟไม่ได้ระบุไว้
//
// Announcement รอบนี้หมุนมาใช้ Announcement3 ทั้งเว็บ — default message ของไฟล์นั้น
// เป็นคอปปี้ของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ไม่ต้องส่ง prop
//
// พาเลตต์ OCZPLUS: พื้นกรมท่า #03101f / #071a36 / #0b2547 · ทองเมทัลลิค #d9b45e
// (อ่อน #f2dc9a เข้ม #8a6b2c ตัวอักษร #e4c67f) · เนื้อความ #ccd6e6 ·
// แดงจากเครื่องหมาย + ของโลโก้ #c0202b/#dd3a3f ใช้อย่างจำกัด — คำเตือนใช้ #dd3a3f
// โดยตั้งใจ เพราะคำเตือนที่ทาสีแบรนด์จะไม่อ่านเป็นคำเตือน
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 156
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1 — เวอร์ชันก่อนหน้ามี
// "Portal & Privilege" อยู่ นับในซอร์สได้ 157 แต่บิลด์ออกมาเป็น 161 แล้วบิลด์แดง
const pageDescription =
  "เกี่ยวกับ OCZPLUS สล็อตอันดับหนึ่ง การันตียอดถอนทุกวัน จ่ายเต็มจำนวน ไม่ล็อคยูส ด้วยระบบสุ่ม RNG 100% ฝาก-ถอนออโต้ 3-5 วินาที แอดมินดูแลผ่าน Line 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ OCZPLUS ระบบนิเวศการเดิมพันแบบ Portal & Privilege",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา OCZPLUS สล็อตอันดับหนึ่ง การันตียอดถอนทุกวัน" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ OCZPLUS ระบบนิเวศการเดิมพันแบบ Portal & Privilege" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ccd6e6]">
        <strong class="text-[#f2dc9a]">OCZPLUS</strong> คือ<strong class="text-[#f2dc9a]">แหล่งเดิมพันชั้นเยี่ยม</strong>ที่พัฒนา<strong
          class="text-[#e4c67f]">ระบบนิเวศการเดิมพันในรูปแบบ Portal &amp; Privilege</strong
        > ขึ้นมาเพื่อมอบเอกสิทธิ์และผลตอบแทนสูงสุดให้กับสมาชิก ทุกอย่างรวมอยู่ในบัญชีเดียว ตั้งแต่การสมัครสมาชิก เข้าสู่ระบบ ฝากถอนเครดิต
        กดรับโปรโมชั่น ไปจนถึงการเข้าเล่นเกมสล็อต โดยไม่ต้องสลับไปมาระหว่างหลายระบบ
      </p>

      <p class="text-left text-base leading-relaxed text-[#ccd6e6]">
        หน้าอินเทอร์เฟซ (UI/UX) ออกแบบด้วย<strong class="text-[#e4c67f]">โทนสีกรมท่าตัดกับสีทองเมทัลลิคสุดพรีเมียม</strong>
        พร้อมกราฟิกเกมสล็อตที่จัดเต็มด้วยแสงเงาระดับ Cinematic Lighting ให้ดื่มด่ำกับความบันเทิงระดับลักชูรีได้ตั้งแต่หน้าแรก
        หน้านี้รวบรวมไว้ว่าเว็บไซต์เปิดให้ทำอะไรได้บ้าง ตั้งแต่เงื่อนไขการถอน โปรโมชั่นที่ตรวจสอบสิทธิ์ได้เอง ระบบธุรกรรมอัตโนมัติ ไปจนถึงช่องทางติดต่อทีมงาน
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="OCZPLUS การันตียอดถอนทุกวัน จ่ายเต็มจำนวน ไร้ประวัติการโกง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ccd6e6]">
        ความน่าเชื่อถือคือสิ่งที่เราให้ความสำคัญเป็นอันดับแรก OCZPLUS
        <strong class="text-[#f2dc9a]">การันตียอดถอนทุกวัน</strong> ไม่ว่าสมาชิกจะทำกำไรได้หลักหมื่นหรือหลักล้าน เราพร้อม<strong
          class="text-[#e4c67f]">จ่ายเต็มจำนวน ไร้ประวัติการโกง</strong
        > พิสูจน์ได้จากรีวิวของสมาชิกตัวจริงที่หมุนเวียนเข้ามาทำกำไรและแบ่งปันความประทับใจผ่านช่องทางต่างๆ อย่างล้นหลาม
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#ccd6e6]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#d9b45e]">🏆</span>
          <span><strong class="text-[#f2dc9a]">การันตียอดถอนทุกวัน</strong> ยอดที่ทำได้จริงจ่ายเต็มจำนวน ไม่มีการตัดยอดหรือหักส่วนต่างระหว่างทาง</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#d9b45e]">🔁</span>
          <span
            ><strong class="text-[#e4c67f]">ถอนได้ตลอด 24 ชั่วโมง ไม่จำกัดจำนวนครั้ง</strong> และไม่จำกัดยอดถอนสูงสุดต่อวัน ทำรายการถัดไปได้ทันทีหลังรายการก่อนหน้าเสร็จ</span
          >
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#d9b45e]">🎲</span>
          <span><strong class="text-[#f2dc9a]">ควบคุมด้วยระบบสุ่ม RNG 100%</strong> ทั้งสมาชิกเก่าและสมาชิกใหม่มีโอกาสชนะและรับแจ็คพอตเท่าเทียมกัน</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#d9b45e]">📱</span>
          <span
            ><strong class="text-[#e4c67f]">เล่นได้ลื่นไหลบนสมาร์ทโฟนทุกรุ่น</strong> ระบบแพลตฟอร์มถูกปรับแต่ง (Optimize) มาแล้ว รองรับทั้ง iOS และ Android โดยภาพระดับพรีเมียมไม่ทำให้เครื่องสะดุด</span
          >
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#ccd6e6]">
        <strong class="text-[#dd3a3f]"
          >ระยะเวลาที่เงินเข้าบัญชียังขึ้นกับธนาคารต้นทางและปลายทางในแต่ละช่วงเวลา จึงควรยึดสถานะรายการที่ระบบแสดง ณ เวลาที่ทำรายการเป็นหลัก</strong
        >
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="โบนัสทุกยูสเซอร์ ไม่ล็อคยูส แนะนำเพื่อน 0.8% คืนยอดเสีย 0.3%" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ccd6e6]">
        เราดูแลสมาชิกทุกคนอย่างเท่าเทียม ไม่ว่าจะเป็นฐานลูกค้าเก่าที่สะสมยอดฝากมาอย่างยาวนาน หรือสมาชิกใหม่ที่เพิ่งสมัครเข้ามา OCZPLUS
        <strong class="text-[#f2dc9a]">แจกโบนัสหนัก จัดเต็มทุกยูสเซอร์แบบไม่มีการล็อคยูส</strong> เพื่อให้ทุกคนมีโอกาสคว้ารางวัลใหญ่ได้อย่างยุติธรรม
      </p>

      <p class="text-left text-base leading-relaxed text-[#ccd6e6]">
        <strong class="text-[#e4c67f]">โปรโมชั่นแนะนำเพื่อน 0.8%</strong> เปลี่ยนเครือข่ายสังคมออนไลน์ให้เป็นรายได้ที่มั่นคง เพียงส่งลิงก์แนะนำเพื่อนให้เข้ามาร่วมสนุก
        สมาชิกจะได้รับค่าคอมมิชชั่นสูงถึง 0.8% จากทุกยอดการเล่นของเพื่อน ยิ่งชวนมาก ยิ่งรับทรัพย์มาก ถือเป็นช่องทางการสร้างรายได้แบบ Passive Income ที่คุ้มค่าที่สุด
      </p>

      <p class="text-left text-base leading-relaxed text-[#ccd6e6]">
        <strong class="text-[#e4c67f]">โปรโมชั่นคืนยอดเสีย 0.3%</strong> เล่นเสียไม่ต้องถอดใจ เพราะเรามีระบบซัพพอร์ตเงินทุนด้วยการคืนยอดเสีย 0.3% ในทุกยอดการเล่น
        เพื่อให้มีเครดิตสำรองกลับไปแก้มือและต่อยอดสร้างกำไรในเกมสล็อตได้อย่างต่อเนื่อง กดรับสิทธิ์ได้ง่ายๆ ผ่านหน้าเว็บด้วยตัวเอง
        <strong class="text-[#dd3a3f]">โดยก่อนกดรับควรอ่านรอบคำนวณและเงื่อนไขของโปรโมชั่นล่าสุดให้ครบถ้วนทุกครั้ง</strong>
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ฝากถอน OCZPLUS ออโต้ 3-5 วินาที ทุกธนาคารและ TrueMoney Wallet" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ccd6e6]">
        เรามอบความสะดวกสบายสูงสุดด้วย<strong class="text-[#f2dc9a]">ระบบธุรกรรมการเงินแบบอัตโนมัติ (Auto)</strong>
        ที่ออกแบบมาเพื่อการใช้งานบนโทรศัพท์มือถือโดยเฉพาะ รองรับการทำรายการผ่านทุกธนาคารชั้นนำในประเทศไทย รวมถึง
        <strong class="text-[#e4c67f]">TrueMoney Wallet</strong> ฝากถอนง่าย รวดเร็วทันใจ ไม่ต้องส่งสลิปให้แอดมิน และไม่มีขั้นต่ำในการทำรายการ
      </p>

      <p class="text-left text-base leading-relaxed text-[#ccd6e6]">
        ระบบฝาก-ถอนอัตโนมัติประมวลผลรวดเร็วภายใน <strong class="text-[#e4c67f]">3-5 วินาที</strong> สมาชิกทำรายการถอนเงินได้ตลอด 24 ชั่วโมง
        โดยไม่จำกัดจำนวนครั้งและไม่จำกัดยอดถอนสูงสุดต่อวัน ทุกรายการถูกบันทึกไว้ในบัญชีสมาชิก ตรวจสอบยอดและสถานะย้อนหลังได้เองจากหน้าเว็บไซต์
        โดยไม่ต้องแจ้งรายการกับเจ้าหน้าที่ทุกครั้ง
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="แอดมิน OCZPLUS ดูแลสมาชิกผ่าน Line Official ตลอด 24 ชั่วโมง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ccd6e6]">
        เรายกระดับการบริการด้วยทีมงานดูแลลูกค้ามืออาชีพ ที่พร้อมสแตนด์บายให้บริการและคำปรึกษา<strong class="text-[#f2dc9a]"
          >ผ่านช่องทาง Line Official ตลอด 24 ชั่วโมง</strong
        > ไม่ว่าจะมีข้อสงสัยเรื่องการรับโปรโมชั่น ติดปัญหาการทำธุรกรรม หรือต้องการคำแนะนำในการใช้งานเว็บไซต์ ทีมแอดมินพร้อมดูแลเอาใจใส่และแก้ไขปัญหาให้อย่างรวดเร็ว
        ตรงจุด เพื่อให้ประสบการณ์การเดิมพันราบรื่นที่สุด
      </p>

      <p class="text-left text-base leading-relaxed text-[#ccd6e6]">
        เวลาแจ้งปัญหา ควรระบุเวลา จำนวนเงิน และข้อมูลรายการที่เกี่ยวข้องให้ครบ เพื่อให้เจ้าหน้าที่ตรวจสอบได้ตรงจุด
        <strong class="text-[#dd3a3f]">และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่นระหว่างการติดต่อเจ้าหน้าที่ไม่ว่ากรณีใด</strong>
      </p>

      <p class="text-left text-base leading-relaxed text-[#ccd6e6]">
        <strong class="text-[#dd3a3f]">การเดิมพันมีความเสี่ยงและผลของแต่ละรอบไม่แน่นอน ไม่มีเกมใดรับประกันผลล่วงหน้า</strong> สมาชิกจึงควรกำหนดงบประมาณก่อนเริ่มเล่นทุกครั้ง
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก OCZPLUS"
          class="flex items-center justify-center rounded-lg border border-[#8a6b2c]/70 bg-gradient-to-r from-[#f2dc9a] via-[#d9b45e] to-[#8a6b2c] px-8 py-3 font-black text-[#03101f] shadow-[0_0_15px_rgba(217,180,94,0.38)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ OCZPLUS"
          class="flex items-center justify-center rounded-lg border border-[#d9b45e]/55 bg-[#071a36]/70 px-8 py-3 font-bold text-[#e4c67f] transition-all hover:scale-105 hover:border-[#f2dc9a] hover:bg-[#0b2547]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
