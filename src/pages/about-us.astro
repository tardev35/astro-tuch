---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็น **บทความจริง** (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login,
// /register หรือหน้าภาพแบบ /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง
// ไม่ใช่เช็กลิสต์หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้
// (src/assets/content.txt) ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าใหม่จากข้อเท็จจริง
// และคลังคำของบรีฟรอบนี้เท่านั้น (.claude/brand-spec-okkub88.md §4-§5)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x5 · h3x0
//   h1  เกี่ยวกับเรา <แบรนด์> เว็บสล็อตเงินดี ทางเข้าเล่นง่าย ยูสใหม่แตกไว
//   h2  โปรโมชั่น <แบรนด์> เปิดรับสมาชิกใหม่ทุกวัน โบนัสแจกทั้งวันไม่จำกัด
//   h2  สิทธิ์คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ที่ <แบรนด์> ระบุไว้
//   h2  สมัครสมาชิก <แบรนด์> ง่าย ๆ เพียง 3 ขั้นตอน ก่อนเริ่มศึกษารายละเอียดเกม
//   h2  ระบบฝากถอน <แบรนด์> ทุกธนาคารและทรูวอลเลท ฝากถอนไม่มีขั้นต่ำ
//   h2  ช่องทางติดต่อแอดมินเว็บ <แบรนด์> ตลอด 24ชม.
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) และจาก footer จึงเปิดใช้งานอยู่
//
// มีสำเนาชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro (ของแบรนด์เก่ามาก)
// ตัวที่ routing จริงคือไฟล์นี้ Astro ไม่อ่านโฟลเดอร์นั้นเลย **ห้ามแก้ ห้ามลบ
// และห้ามสลับมาแทนไฟล์นี้**
//
// 🚨🚨 ดรอปนี้ (2026-10-24) ยังเป็น **เว็บสล็อต** เหมือนรอบก่อน แต่ **คนละคำนิยาม
// ตัวเอง** บรีฟรอบนี้เรียกตัวเองว่า "เว็บสล็อตเงินดี ทางเข้าเล่นง่าย ยูสใหม่แตกไว
// โบนัสแจกทั้งวันไม่จำกัด" และระบุ สมัครสมาชิกรับโปรไม่อั้น · 3 ขั้นตอนสมัคร ·
// คืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน · แนะนำเพื่อน 0.8% ไม่จำกัด ·
// ฝากถอนไม่มีขั้นต่ำ ทุกธนาคารและทรูวอลเลท · แอดมิน 24ชม.
// ⚠️⚠️ คำนิยามตัวเองของแบรนด์ขาออกเป็น **คำค้างข้ามแบรนด์** ห้ามหลุดกลับมา
// **รายการคำต้องห้ามเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่** เพื่อไม่ให้
// sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// ⚠️⚠️ คำที่พลาดง่ายที่สุดของรอบนี้คือชื่อกระเป๋าเงิน: บรีฟรอบนี้เขียน
// **ทรูวอลเลท** เท่านั้น (รอบก่อนเป็นอีกคำ) ห้ามสลับกลับ
// ⚠️⚠️ ชื่อแบรนด์รอบนี้เป็น **ตัวละตินพิมพ์เล็กล้วน** กลับทิศจากรอบก่อนที่ห้าม
// เขียนละติน (brand-spec §1) ทุกจุดยัง interpolate จาก BRAND_NAME เหมือนเดิม
// เพื่อไม่ให้ค้างเป็นชื่อแบรนด์ก่อนหน้าตอนรีแบรนด์รอบถัดไป
//
// ⚠️ **รอบนี้สองหน้าหมวดลอตเตอรีถูกปิด** (อยู่ใน src/pages-disabled/)
// **ห้ามลิงก์ไปสอง route นั้นจากหน้านี้** และห้ามใช้คำศัพท์หมวดลอตเตอรีเลย
// route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ทดลองเล่น · /about-us · /contact-us · /terms · /privacy · /line
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกมรายตัว ชื่อธนาคารรายตัว จำนวนเกม จำนวนค่าย
// ตัวเลข RTP อัตราจ่าย ชื่อผู้ให้บริการ หน่วยงานกำกับ เลขใบอนุญาต ปีก่อตั้ง
// จำนวนสมาชิก หรือยอดฝากขั้นต่ำที่เป็นตัวเลข แม้แต่รายการเดียว** จึงห้ามเขียน
// ลงหน้าเว็บ · ตัวเลขที่ขึ้นหน้าได้มีแค่ของบรีฟเอง:
// **0.3% · 0.8% · 3 ขั้นตอน · 24ชม.**
//
// 🚨 **บรีฟรอบนี้โฆษณาแล้วกำกับตัวเองในย่อหน้าเดียวกันแทบทุกย่อหน้า** — ทั้งสอง
// ครึ่งต้อง ship ครบ ประโยคกำกับไม่ใช่ filler ให้ตัดทิ้ง:
// 1) คำกล่าวอ้างว่ายูสใหม่แตกไวไม่สามารถใช้รับประกันผลรางวัลได้ เพราะเกมสล็อต
//    มีผลลัพธ์ที่ไม่แน่นอนในแต่ละรอบ (h1)
// 2) ควรตรวจสอบเงื่อนไขของแต่ละโปรโมชั่นก่อนรับโบนัส โดยเฉพาะจำนวนครั้งที่
//    รับสิทธิ์ได้ ยอดที่ใช้คำนวณเครดิต และข้อกำหนดการถอนเงิน · แม้ระบุว่าแจก
//    โบนัสทั้งวันไม่จำกัด ควรยืนยันรายละเอียดจากประกาศล่าสุด (h2 #1)
// 3) การคืนเครดิตไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่ม
//    โอกาสชนะในครั้งต่อไป · แม้ระบุว่าไม่จำกัด ควรยืนยันจำนวนบัญชีที่เข้าร่วมได้
//    และรอบจ่ายเครดิต (h2 #2)
// 4) ควรตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง อ่านเงื่อนไขการใช้บริการ ข้อกำหนดด้าน
//    อายุกับกฎหมายที่เกี่ยวข้อง และไม่เปิดเผยรหัส OTP ให้ใครทราบ (h2 #3)
// 5) ควรตรวจสอบรายชื่อธนาคารที่รองรับ ยอดขั้นต่ำ และชื่อบัญชีปลายทางให้ตรงกับ
//    ข้อมูลผู้ให้บริการที่ยืนยันได้ · แม้ระบุว่าฝากถอนไม่มีขั้นต่ำ ควรตรวจวงเงิน
//    ต่อรายการและข้อจำกัดที่อาจมีอยู่ · พบข้อมูลบัญชีผิดปกติให้หยุดทำธุรกรรม
//    และติดต่อผู้ให้บริการชำระเงิน (h2 #4)
// 6) ควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยง
//    บัญชีแอบอ้าง · เก็บหมายเลขรายการและหลักฐานไว้ · ไม่เปิดเผยรหัสผ่านหรือ
//    รหัส OTP · ตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุด (h2 #5)
//
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) **ยังเป็นธีมสว่างเหมือนรอบก่อน แต่คนละฮิว
// สิ้นเชิง** bg.json ของดรอปนี้คือ {"mode":"color","color":"#ffd6fa"} =
// **ชมพูบับเบิลกัมพาสเทล** (รอบก่อนเป็น 00bfff = ฟ้าสกายอิ่มตัว)
// **ห้าม "แก้" การ์ด/ปุ่มกลับไปเป็นพื้นมืด** — พื้นมืดบนหมึก #6a0f3c =
// ตัวอักษรหายไปเลย ไม่ใช่แค่จางลง
// ค่าที่ใช้ได้ในไฟล์นี้: หัวข้อ/`<strong>`/marker **#9c0f55** (8.1:1 บนการ์ดขาว) ·
// เข้มสุด #6a0f3c (12.1:1) · พื้นไล่เฉดปุ่มหลัก #d91a73 -> #b01160 -> #85094a
// (**พื้นถม** + หมึกขาว #ffffff — 4.8 / 6.8 / 9.8:1 ต่อ stop) · ปุ่มรองเป็น
// #ffffff -> #ffe3f5 คู่กับหมึก #6a0f3c · ผิวยก #fff4fb · wash #ffe3f5 ·
// เส้น #f9b2d9 · เส้นเข้ม #f479b9 (**ทั้งคู่ห้ามถือตัวอักษร**)
// หมึกเนื้อความคือ #6a0f3c (= BRAND_TEXT) ซึ่ง **ไม่ประกาศในไฟล์นี้** การ์ด
// ContentBox ตั้งไว้ให้แล้วและย่อหน้าสืบทอดลงมา
// 🚨🚨 **#fb439b บนพื้นขาวได้แค่ 3.3:1 — ห้ามเป็นสีตัวอักษร** และ **ห้ามถมพื้น
// #fb439b หรือ #ffd6fa แล้ววางหมึกขาว** (3.2 / 1.2:1) ปุ่มหลักจึงเริ่มไล่เฉดที่
// #d91a73 ไม่ใช่ #fb439b
// ออราที่อนุญาต: rgba(251,67,155,α) · rgba(255,194,226,α) · rgba(156,15,85,α) ·
// rgba(106,15,60,α) · rgba(249,178,217,α)
// ⚠️⚠️ **รอบนี้ไม่มีฟ้า ไม่มีไซแอน ไม่มีน้ำเงินเลยสักค่า** (ทั้งชุดคือพาเลตของ
// แบรนด์ขาออก) · ไม่มีทอง/เหลือง ไม่มีม่วง ไม่มีเขียวมิ้นต์ ไม่มีครีม/เบจ/น้ำตาล
// ไม่มีเทาเงิน ยกเว้น **LINE green #00B900** บนปุ่ม LINE ซึ่งเป็นสีประจำแพลตฟอร์ม
// (บนผิวขาวต้องเป็นพื้นถม bg-[#00B900] + ตัวอักษรขาว ไม่ใช่ตัวอักษรสีเขียว)
// ⚠️⚠️ **รอบนี้เป็นแบรนด์ชมพูจริง และ หมูบิน168 (สองรอบก่อน) ก็ชมพู จึงห้ามเทียบ
// ด้วยวงศ์สี** ต้องเทียบ **ทีละค่า** กับตาราง brand-spec §2 (fb8cc0 ของหมูบิน
// มี R=fb ตรงกับ #fb439b เป๊ะ · f7bcd9 มี B=d9 ตรงกับ #f9b2d9 เป๊ะ ·
// ffe9f5 ต่างจาก #ffe9f7 แค่ไบต์สุดท้าย · b00d11 ของสล็อต168 ตรงกับ #b01160
// สี่ตัวแรก b01 — เจอที่ไหนแปลว่าพิมพ์ผิด)
// เฮกซ์ของแบรนด์เก่าในคอมเมนต์เขียนแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep สะดุด
// ⚠️ หมูการ์ตูนชมพู เหรียญทอง กล่องของขวัญ พื้นสตูดิโอขาว และสีผิวนักแสดงใน
// อาร์ตเวิร์กเป็น **วัตถุในภาพ ไม่ใช่สี UI**
//
// ลำดับปุ่มในไฟล์นี้สื่อด้วยพื้นถมสามขั้ว (ตรงกับคู่ปุ่มที่ล็อกไว้ใน brand-spec §2):
// · ปุ่มหลัก (สมัครสมาชิก) ไล่เฉด #d91a73 -> #b01160 -> #85094a หมึกขาว #ffffff
// · ปุ่มรอง (เข้าสู่ระบบ) ไล่เฉดผิวสว่าง #ffffff -> #ffe3f5 หมึกเบอร์รีเข้ม #6a0f3c
// · ปุ่มลิงก์ภายในเป็นปุ่ม outline ขอบ #9c0f55 ตัวอักษร #9c0f55 บนการ์ดขาว
//   hover ยกพื้นขึ้นเป็นผิวยก #fff4fb
// · ชิปไอคอนของรายการใช้ขอบ #f9b2d9 บน wash #ffe3f5 ไม่ถือตัวอักษร
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง และไม่ใส่ mx-auto / max-w-* บน <p>
// เพราะการ์ดคุมความกว้างเองแล้ว — ที่ประกาศสีได้มีแค่ปุ่ม ชิปไอคอน marker ของ
// ลำดับเลข และ <strong> · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง
// เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำ
// จะขาดครึ่ง (ลบแท็ก <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิม) และห้ามวาง
// <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังใน prop ที่เป็นข้อความ และต้องเป็นไอคอนหมวดสล็อต ไม่ใช่ไอคอนหมวดลอตเตอรี
// slot ของ ContentBox รับ **หนึ่ง element** เท่านั้น จึงห่อด้วย <div> ชั้นเดียว
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: รูปของดรอปนี้ถูกตรึงไว้ที่อื่นครบทุกไฟล์ —
// slide1/slide2 ถูกตรึงไว้กับ index §4 ข้อ 5-6 กับ /promotion · banner1 /
// banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// banner2/banner3 และ slide3/slide4 เป็นอาร์ตเวิร์กของแบรนด์อื่น
// **ห้าม import ทั้งสี่ไฟล์** (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/
// และ verify-build จะแดง) — ไฟล์ทั้งหมดยังอยู่บนดิสก์ **ห้ามลบ** เป็นอินเวนทอรี
// ของแบรนด์ถัดไป · อาร์ตสต็อก gamedemo8/gamedemo16 ถูกตรึงไว้กับ /ทดลองเล่น
//
// Announcement รอบนี้หมุนมาเป็น Announcement3 ทั้งเว็บ (brand-spec §3 — รอบก่อนใช้
// ตัวฐานจึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ
// แบรนด์นี้แล้ว จึงเรียกแบบ bare **ห้ามส่ง prop message** มิฉะนั้นตัววิ่งจะพูด
// คนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -c บนเชลล์นี้
// ก็นับเป็นไบต์ ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับตัวนับ
// ของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 155 อักขระ (ชื่อแบรนด์รอบนี้ 7 อักขระ) เป็นประโยคเดียวที่บอกว่า
// หน้านี้มีอะไร แล้วหยุด
// (Google ตัดราว 160 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนๆ ยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} รวมข้อมูลเว็บสล็อตเงินดี ทางเข้าเล่นง่าย ยูสใหม่แตกไว ทั้งโปรโมชั่นคืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% และระบบฝากถอนทุกธนาคารและทรูวอลเลท`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} เว็บสล็อตเงินดี ทางเข้าเล่นง่าย ยูสใหม่แตกไว`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

// คลาสปุ่มสามขั้วของหน้านี้ ประกาศครั้งเดียวแล้วใช้ซ้ำ เพื่อไม่ให้สองปุ่มที่ทำ
// หน้าที่เดียวกันหลุดไปคนละเฉดตอนรีแบรนด์รอบหน้า
const ctaPrimary =
  "flex items-center justify-center rounded-full border border-[#85094a] bg-gradient-to-b from-[#d91a73] via-[#b01160] to-[#85094a] px-8 py-3 font-black text-white shadow-[0_6px_18px_rgba(156,15,85,0.3)] transition-transform hover:scale-105";

const ctaSecondary =
  "flex items-center justify-center rounded-full border border-[#f479b9] bg-gradient-to-b from-[#ffffff] to-[#ffe3f5] px-8 py-3 font-bold text-[#6a0f3c] shadow-[0_6px_18px_rgba(249,178,217,0.45)] transition-transform hover:scale-105";

const ctaQuiet =
  "flex items-center justify-center rounded-full border-2 border-[#9c0f55] bg-[#ffffff] px-8 py-3 font-bold text-[#9c0f55] shadow-[0_4px_14px_rgba(251,67,155,0.2)] transition-all hover:scale-105 hover:bg-[#fff4fb] hover:shadow-[0_6px_18px_rgba(156,15,85,0.2)]";

const listChip = "mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#f9b2d9] bg-[#ffe3f5] text-sm";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#9c0f55]">{BRAND_NAME} นำเสนอเกมสล็อตออนไลน์หลากหลายรูปแบบ พร้อมระบบสมาชิกที่รวบรวมข้อมูลเกม โปรโมชั่น และช่องทางฝากถอนไว้ในเว็บไซต์เดียว</strong>
        หน้านี้สรุปไว้ว่าเว็บไซต์ระบุอะไรไว้บ้าง และควรเปิดอ่านรายละเอียดส่วนไหนก่อน เพื่อให้เห็นภาพรวมก่อนไล่อ่านเงื่อนไขของแต่ละรายการเป็นรายข้อ
      </p>

      <p>
        ภายในเว็บไซต์ผู้ใช้งานสามารถศึกษากติกาเกม ตรวจสอบเงื่อนไขโบนัส และเลือกดูรายละเอียดค่ายเกมที่สนใจได้
        <strong class="text-[#9c0f55]">โดยเฉพาะสมาชิกใหม่ที่ควรทำความเข้าใจระบบก่อนใช้งาน</strong>
        เพราะข้อความว่าทางเข้าเล่นง่ายหมายถึงขั้นตอนการเข้าใช้งาน ไม่ได้แปลว่าเงื่อนไขของแต่ละรายการเหมือนกันทั้งหมด
      </p>

      <p>
        สิ่งที่หน้านี้ทำได้คือชี้ว่าข้อมูลแต่ละชุดอยู่ตรงไหนและควรอ่านอะไรก่อน ส่วน
        <strong class="text-[#9c0f55]">คำกล่าวอ้างว่ายูสใหม่แตกไวไม่สามารถใช้รับประกันผลรางวัลได้ เพราะเกมสล็อตมีผลลัพธ์ที่ไม่แน่นอนในแต่ละรอบ</strong>
        เนื้อหาในหน้านี้จึงเขียนไว้ประกอบการใช้งานเท่านั้น ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้บริการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`โปรโมชั่น ${BRAND_NAME} เปิดรับสมาชิกใหม่ทุกวัน โบนัสแจกทั้งวันไม่จำกัด`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#9c0f55]">{BRAND_NAME} นำเสนอข้อมูลการสมัครสมาชิกและโปรโมชั่นสำหรับผู้ใช้งานใหม่ ทั้งรายละเอียดการลงทะเบียน การเข้าสู่ระบบ และสิทธิพิเศษที่เว็บไซต์ประกาศไว้</strong>
        รายการด้านล่างคือสิ่งที่ควรเปิดอ่านก่อนกดรับสิทธิ์ เพราะเป็นเงื่อนไขที่ตรวจสอบได้จากประกาศของผู้ให้บริการ ไม่ใช่จากตัวข้อความโฆษณาเอง
      </p>

      <ul class="flex flex-col gap-4" aria-label="สิ่งที่ควรตรวจสอบก่อนรับโบนัส">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎁</span>
          <span>
            <strong class="text-[#9c0f55]">เงื่อนไขของแต่ละโปรโมชั่นก่อนรับโบนัส</strong> ควรอ่านให้ครบทุกครั้ง เพราะรายการที่เปิดรับสมาชิกใหม่ทุกวันไม่ได้แปลว่าทุกรายการใช้เงื่อนไขชุดเดียวกัน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📑</span>
          <span>
            <strong class="text-[#9c0f55]">จำนวนครั้งที่รับสิทธิ์ได้ ยอดที่ใช้คำนวณเครดิต และข้อกำหนดการถอนเงิน</strong> คือสามจุดที่บรีฟของเว็บไซต์ระบุให้ตรวจก่อนเสมอ และเป็นส่วนที่ต่างกันได้ในแต่ละรายการ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📣</span>
          <span>
            <strong class="text-[#9c0f55]">ประกาศล่าสุดของเว็บไซต์ทางการ</strong> ควรเปิดยืนยันทุกครั้ง เพราะแม้จะมีข้อความระบุว่าแจกโบนัสทั้งวันไม่จำกัด แต่รายละเอียดสิทธิ์ที่ได้รับจริงอยู่ในประกาศนั้น
          </span>
        </li>
      </ul>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/promotion" aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`} class={ctaQuiet}>ดูภาพโปรโมชั่น</a>

        <a href="/ทดลองเล่น" aria-label={`เปิดหน้าทดลองเล่นของ ${BRAND_NAME}`} class={ctaQuiet}>ไปหน้าทดลองเล่น</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`สิทธิ์คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ที่ ${BRAND_NAME} ระบุไว้`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} นำเสนอข้อมูลโปรโมชั่นสำหรับสมาชิกใหม่และสมาชิกปัจจุบันไว้สองรายการหลัก คือ
        <strong class="text-[#9c0f55]">คืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน และแนะนำเพื่อนรับโบนัส 0.8% ไม่จำกัด</strong>
        ซึ่งแต่ละรายการอาจกำหนดประเภทเกมที่เข้าร่วม ยอดที่นำมาคำนวณ รอบรับเครดิต และจำนวนครั้งที่เข้าร่วมไว้คนละแบบ จึงควรติดตามประกาศโปรโมชั่นล่าสุดก่อนรับสิทธิ์
      </p>

      <p>
        รายการคืนยอดเสียระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขรายวัน
        <strong class="text-[#9c0f55]">สมาชิกควรตรวจสอบว่าเกมสล็อตประเภทใดเข้าร่วมรายการ มีรอบสรุปยอดเวลาใด และต้องกดรับเครดิตด้วยตนเองหรือระบบดำเนินการให้อัตโนมัติ</strong>
        รวมถึงศึกษาข้อกำหนดการใช้เครดิตและการถอนเงินให้ครบถ้วน เพราะยอดเสียบางรายการอาจไม่เข้าเกณฑ์รับสิทธิ์ ทั้งนี้ การคืนเครดิตไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งต่อไป
      </p>

      <p>
        ส่วนรายการแนะนำเพื่อนระบุสิทธิ์ไว้สำหรับสมาชิกที่แนะนำผู้ใช้งานรายใหม่ โดยควรตรวจสอบวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และฐานยอดที่ใช้คำนวณโบนัสให้ชัดเจน
        <strong class="text-[#9c0f55]">แม้จะมีข้อความว่าไม่จำกัด แต่ควรยืนยันจำนวนบัญชีที่เข้าร่วมได้ รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุด</strong>
        เพื่อป้องกันความเข้าใจคลาดเคลื่อนเกี่ยวกับจำนวนเครดิตที่มีสิทธิ์ได้รับ
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME} ง่าย ๆ เพียง 3 ขั้นตอน ก่อนเริ่มศึกษารายละเอียดเกม`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#9c0f55]">การสมัครสมาชิก {BRAND_NAME} สามารถศึกษาขั้นตอนทั่วไปได้จากเมนูลงทะเบียนของเว็บไซต์</strong>
        โดยควรตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง อ่านเงื่อนไขการใช้บริการ และตรวจสอบข้อกำหนดด้านอายุกับกฎหมายที่เกี่ยวข้องก่อนดำเนินการ ลำดับด้านล่างเรียงตามที่เว็บไซต์ระบุไว้
      </p>

      <ol class="ml-6 list-decimal space-y-3 marker:font-black marker:text-[#9c0f55]">
        <li>
          <strong class="text-[#9c0f55]">เข้าสู่หน้าสมัครสมาชิก</strong> เปิดเว็บไซต์ผ่านช่องทางที่ตรวจสอบได้ จากนั้นเลือกเมนูสมัครสมาชิกและศึกษาข้อกำหนดการเปิดบัญชี รวมถึงนโยบายการจัดเก็บข้อมูลส่วนบุคคลก่อนกรอกข้อมูล
        </li>
        <li>
          <strong class="text-[#9c0f55]">กรอกข้อมูลและยืนยันบัญชี</strong> กรอกข้อมูลตามที่ระบบกำหนด ตรวจสอบความถูกต้องก่อนยืนยัน และตั้งรหัสผ่านที่ปลอดภัย ไม่ควรใช้ข้อมูลของบุคคลอื่นหรือเปิดเผยรหัส
          OTP ให้ใครทราบ
        </li>
        <li>
          <strong class="text-[#9c0f55]">เข้าสู่ระบบและตรวจสอบโปรโมชั่น</strong> หลังลงทะเบียนเรียบร้อย สามารถศึกษารายชื่อเกมสล็อต กติกาการเล่น และรายละเอียดโปรโมชั่นสำหรับสมาชิกใหม่
          หากมีข้อสงสัยเกี่ยวกับเงื่อนไขโบนัสควรสอบถามเจ้าหน้าที่ผ่านช่องทางทางการก่อนทำรายการ
        </li>
      </ol>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/register" aria-label={`สมัครสมาชิก ${BRAND_NAME}`} class={ctaPrimary}>สมัครสมาชิก</a>

        <a href="/login" aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`} class={ctaSecondary}>เข้าสู่ระบบ</a>

        <a href="/ทางเข้า" aria-label={`เปิดหน้าทางเข้าของ ${BRAND_NAME}`} class={ctaQuiet}>ไปหน้าทางเข้า</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`ระบบฝากถอน ${BRAND_NAME} ทุกธนาคารและทรูวอลเลท ฝากถอนไม่มีขั้นต่ำ`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#9c0f55]">{BRAND_NAME} ระบุช่องทางฝากถอนผ่านธนาคารและทรูวอลเลท</strong>
        เพื่อให้สมาชิกตรวจสอบวิธีทำรายการตามบริการที่เปิดใช้งานจริง รายการด้านล่างคือสิ่งที่ควรเปิดอ่านก่อนทำรายการครั้งแรก และควรตรวจซ้ำทุกครั้งที่กลับเข้ามาใหม่
      </p>

      <ul class="flex flex-col gap-4" aria-label="สิ่งที่ควรตรวจสอบก่อนฝากถอน">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>💳</span>
          <span>
            <strong class="text-[#9c0f55]">รายชื่อธนาคารที่รองรับและยอดขั้นต่ำของแต่ละช่องทาง</strong> ควรตรวจสอบก่อนฝากเงิน พร้อมศึกษาระยะเวลาดำเนินการและข้อกำหนดการถอนเงินให้ครบถ้วน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🧾</span>
          <span>
            <strong class="text-[#9c0f55]">วงเงินต่อรายการและข้อจำกัดที่อาจมีอยู่</strong> ควรตรวจแม้จะมีข้อความว่าฝากถอนไม่มีขั้นต่ำ เพราะสองเรื่องนี้เป็นคนละข้อกำหนดกันและประกาศแยกจากกัน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🏦</span>
          <span>
            <strong class="text-[#9c0f55]">ชื่อบัญชีปลายทาง</strong> ควรตรวจสอบให้ตรงกับข้อมูลผู้ให้บริการที่ยืนยันได้ก่อนโอนเงิน เพราะนี่คือจุดที่แยกการทำรายการตามปกติออกจากบัญชีแอบอ้างได้เร็วที่สุด
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#9c0f55]">หากพบข้อมูลบัญชีผิดปกติ ควรหยุดทำธุรกรรมและติดต่อผู้ให้บริการชำระเงินเพื่อตรวจสอบก่อนโอนเงิน</strong>
        แล้วค่อยกลับมาทำรายการใหม่เมื่อตรวจสอบข้อมูลปลายทางได้ครบถ้วน เพราะการหยุดก่อนโอนคือจุดที่ยังแก้ไขได้ง่ายที่สุดของทั้งกระบวนการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`ช่องทางติดต่อแอดมินเว็บ ${BRAND_NAME} ตลอด 24ชม.`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} ระบุช่องทางติดต่อเจ้าหน้าที่สำหรับผู้ใช้งานที่ต้องการสอบถามเกี่ยวกับการสมัครสมาชิก การเข้าสู่ระบบ โปรโมชั่นสมาชิกใหม่ และรายการฝากถอน
        <strong class="text-[#9c0f55]">โดยควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง</strong>
      </p>

      <p>
