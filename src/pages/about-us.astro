---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion,
// /login, /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์
// หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ (src/assets/content.txt) ไม่มี
// ส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่จากข้อเท็จจริงและคลังคำของบรีฟรอบนี้
// เท่านั้น (.claude/brand-spec-pakyok168.md §5)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x4 · h3x0
//   h1  เกี่ยวกับเรา <แบรนด์> เว็บสล็อตเดิมพันค่ายแท้ ถูกลิขสิทธิ์100%
//   h2  เกมสล็อตที่ <แบรนด์> รวบรวมไว้ และโหมดทดลองเล่นฟรี
//   h2  โปรโมชั่นสมาชิก <แบรนด์> คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%
//   h2  สมัครเล่นเว็บสล็อต <แบรนด์> ง่ายๆ 3 ขั้นตอน
//   h2  ช่องทางติดต่อแอดมิน <แบรนด์> ตลอด 24ชม.
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// (ขั้นตอนสมัครสามขั้นลงเป็น <ol> เพราะเป็นลำดับขั้น ไม่ใช่สามหัวข้อย่อยที่มี
// บทความของตัวเอง)
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) จึงเปิดใช้งานอยู่
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// เป็นของแบรนด์เก่ามาก ตัวที่ routing จริงคือไฟล์นี้ Astro ไม่อ่านโฟลเดอร์นั้นเลย
// **ห้ามแก้ ห้ามลบ และห้ามสลับมาแทนไฟล์นี้**
//
// 🚨 แกนของดรอปนี้ (2026-10-22) คือ **เว็บสล็อตออนไลน์** ที่นำเสนอเกมสล็อตจาก
// ค่ายต่าง ๆ พร้อม **โหมดทดลองเล่นฟรี** · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% ·
// สมัคร 3 ขั้นตอน · แอดมิน 24ชม.
// ⚠️⚠️ **แบรนด์ขาออก (สบาย168) ขายจุดยืนคนละแบบกับรอบนี้** คำขายของกลุ่มนั้นที่
// เคยอยู่ในไฟล์นี้จึงเป็นคำค้างของแบรนด์ขาออก **ไม่ใช่ของรอบนี้** และรอบก่อนหน้า
// นั้นเป็นเว็บพนันครบวงจร/ลอตเตอรี — คำกลุ่มนั้นก็ห้ามหลงเหลือเช่นกัน
// **รายการคำต้องห้ามเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่** เพื่อไม่ให้ sweep
// ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// ⚠️ `ไม่ผ่านม้า` กับ `บัญชีม้า` **เป็นคำของบรีฟรอบนี้เอง ใช้ได้**
//
// ⚠️⚠️ **สองหน้าหมวดลอตเตอรียังจอดอยู่ใน src/pages-disabled/ รอบนี้** → ลิงก์ไป
// สอง route นั้นจะทำให้ build แดง ห้ามเขียนกลับมา
// route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ทดลองเล่น · /about-us · /contact-us · /terms · /privacy · /line
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกม ชื่อธนาคาร ชื่อผู้ให้บริการ ใบอนุญาต
// ปีก่อตั้ง จำนวนสมาชิก ค่า RTP หรือยอดฝากขั้นต่ำ แม้แต่รายการเดียว** จึงห้าม
// เขียนลงหน้าเว็บ · ตัวเลขที่ขึ้นหน้าได้มีแค่ของบรีฟเอง:
// **0.3% · 0.8% · 24ชม. · 3 ขั้นตอน · 100%**
//
// 🚨 **บรีฟรอบนี้โฆษณาและกำกับข้อจำกัดในย่อหน้าเดียวกัน** — ทั้งสองครึ่งต้อง ship
// ครบตามที่เขียน ประโยคกำกับไม่ใช่ filler ให้ตัดทิ้ง:
// 1) คำกล่าวอ้างเกี่ยวกับลิขสิทธิ์เกม ความน่าเชื่อถือ และการไม่ใช้บัญชีม้า ควร
//    ตรวจสอบจากหลักฐานของผู้ให้บริการและข้อมูลบัญชีรับเงินที่ยืนยันได้ ไม่ควร
//    พิจารณาจากข้อความโฆษณาเพียงอย่างเดียว (h1)
// 2) ควรตรวจสอบว่ามีโหมดทดลองเล่นฟรีให้ใช้งานหรือไม่ เนื่องจากบางเกมอาจไม่มีโหมด
//    ดังกล่าว · ผลจากการทดลองเล่นไม่ได้บ่งบอกถึงผลลัพธ์เมื่อเดิมพันจริง · ควร
//    ตรวจสอบสถานะลิขสิทธิ์เกมจากข้อมูลทางการของค่ายผู้พัฒนา (h2 #1)
// 3) เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือรับประกัน
//    ผลกำไรในอนาคต · แม้ระบุว่ากดรับได้ไม่จำกัด แต่ควรตรวจสอบจำนวนครั้งที่รับ
//    สิทธิ์ได้จริงจากประกาศล่าสุด (h2 #2)
// 4) ควรตรวจสอบคุณสมบัติผู้สมัคร อายุที่กฎหมายอนุญาต และเงื่อนไขการใช้บริการ ·
//    ไม่ควรใช้ข้อมูลของบุคคลอื่นหรือเปิดเผยรหัส OTP ให้ใครทราบ (h2 #3)
// 5) ควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชี
//    แอบอ้าง · เตรียมหมายเลขรายการและหลักฐาน · ควรตรวจสอบเวลาการให้บริการจริงจาก
//    ประกาศล่าสุดอีกครั้ง (h2 #4)
//
// 🚨 พาเลตรอบนี้ (brand-spec §2) **กลับมาเป็นธีมมืด** หลังรอบก่อนเป็นฟ้าพาสเทล
// สว่าง bg.json ของดรอปนี้คือ {"mode":"color","color":"#291d0f"} = น้ำตาลกาแฟเข้ม
// **ห้าม "แก้" กลับไปเป็นพื้นสว่างเพราะรอบที่แล้วสว่าง**
// ค่าที่ใช้ได้ในไฟล์นี้: ทองสว่าง #fded41 (<strong> + ตัวอักษรบนพื้นเข้ม 11.7:1
// บนการ์ด — เป็นสีไฮไลต์ของเนื้อความ) · ทองแกน #eeae12 (ขอบ · ออรา · marker ·
// stop กลางของปุ่มหลัก 7.2:1) · ทองลึก #9f600d (**2.8:1 — พื้นถม/ขอบเท่านั้น
// ห้ามถือตัวอักษร**) · โครมกลาง #2f1e0f และอินเซ็ต #1f1308 (พื้นผิว) ·
// หมึกบนพื้นถมทอง #1f0f04 (9.5:1 บน #eeae12 · 15.4:1 บน #fded41)
// หมึกเนื้อความคือ #f4ead6 (= BRAND_TEXT) ซึ่ง **ไม่ประกาศในไฟล์นี้** การ์ด
// ContentBox ตั้งไว้ให้แล้วและย่อหน้าสืบทอดลงมา
// 🚨 **ห้ามใช้ตัวอักษรขาวบนพื้นถมทอง** ปุ่มหลักใช้หมึก #1f0f04 เสมอ
// ออราที่อนุญาต: rgba(238,174,18,α) · rgba(253,237,65,α) · rgba(224,224,223,α) ·
// rgba(31,15,4,α) · rgba(0,0,0,α)
// ⚠️ รอบนี้ไม่มีฟ้า/น้ำเงิน (สีนำของรอบก่อน) ไม่มีแดง ไม่มีชมพู ไม่มีม่วง
// ไม่มีส้ม ไม่มีเขียว ยกเว้น **LINE green #00B900** บนปุ่ม LINE ซึ่งเป็นสีประจำ
// แพลตฟอร์ม ห้ามเปลี่ยนเป็นสีแบรนด์
// ⚠️ **ทองผ่านรีโปนี้มาแล้วเกือบทุกเจ้า** การเจอทองในไฟล์จึงไม่พิสูจน์อะไร —
// ห้ามเทียบด้วยวงศ์สี ต้องเทียบทีละค่ากับตาราง brand-spec §2
//
// ลำดับปุ่มในไฟล์นี้สื่อด้วยพื้นถมสามขั้ว:
// · ปุ่มหลัก (สมัครสมาชิก) ถมไล่เฉดทอง #fded41 -> #eeae12 -> #9f600d หมึก #1f0f04
// · ปุ่มรอง (เข้าสู่ระบบ) ขอบ #eeae12 ตัวอักษร #fded41 บนโครมกลาง #2f1e0f
// · ปุ่มลิงก์ภายในเป็นอินเซ็ต #1f1308 ขอบ #9f600d ตัวอักษร #fded41
//   hover ยกขอบเป็นทองแกน (ตรงกับ hover ของการ์ด ContentBox)
// · ชิปไอคอนของรายการใช้ทองแกนเป็น **เส้นขอบ** บนอินเซ็ต #1f1308 ไม่ถือตัวอักษร
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง และไม่ใส่ mx-auto / max-w-* บน <p>
// เพราะการ์ดคุมความกว้างเองแล้ว — ที่ประกาศสีได้มีแค่ปุ่ม ชิปไอคอน marker ของ
// ลำดับเลข และ <strong> · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง
// เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำ
// จะขาดครึ่ง (ลบแท็ก <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิม) และห้ามวาง
// <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังใน prop ที่เป็นข้อความ และต้องไม่ใช่สัญลักษณ์ของอาร์ตเวิร์กแบรนด์เก่า
// (รายการที่ห้ามอยู่ใน brand-spec §1)
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: ดรอปนี้ไม่มี article illustration เลย (banner2/
// banner3 เป็นอาร์ตเวิร์กของแบรนด์คนละราย เก่าทั้งคู่) ส่วน slide1/slide2 ถูกตรึง
// ไว้กับ index กับ /promotion และ banner1 / banner1-mobile / og.png เป็นของ glob
// ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า · slide3/slide4 เป็นโปสเตอร์ของอีกแบรนด์
// ห้าม import (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build
// จะแดง) — ไฟล์ยังอยู่บนดิสก์ ห้ามลบ
//
// Announcement รอบนี้หมุนมาเป็น AnnouncementPremium ทั้งเว็บ (brand-spec §3 —
// รอบก่อนใช้ Announcement6 จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์
// นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว จึงเรียกแบบ bare **ห้ามส่ง prop message**
// มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 155 อักขระ (ชื่อแบรนด์รอบนี้ 8 ตัวอักษร) เป็นประโยคเดียวที่บอกว่า
// หน้านี้มีอะไร แล้วหยุด
// (Google ตัดราว 155 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} เว็บสล็อตที่รวบรวมเกมจากค่ายต่าง ๆ พร้อมโหมดทดลองเล่นฟรี โปรโมชั่นคืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% ขั้นตอนสมัครสมาชิก และแอดมิน 24ชม.`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} เว็บสล็อตเดิมพันค่ายแท้ ถูกลิขสิทธิ์100%`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#fded41]">{BRAND_NAME} นำเสนอเกมสล็อตออนไลน์หลากหลายรูปแบบ พร้อมข้อมูลค่ายเกม ระบบทดลองเล่น และโปรโมชั่นสำหรับสมาชิก</strong>
        หน้านี้รวบรวมไว้ว่าเว็บไซต์ระบุอะไรไว้บ้าง เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดอ่านอะไรตรงไหน แล้วจึงค่อยไล่อ่านรายละเอียดของแต่ละหัวข้อเป็นรายข้อ
      </p>

      <p>
        สิ่งที่หน้านี้ทำได้คือชี้ว่าข้อมูลแต่ละชุดอยู่ตรงไหนและควรอ่านอะไรก่อน
        <strong class="text-[#fded41]">ภายในเว็บไซต์มีเมนูสำหรับศึกษากติกาเกม ตรวจสอบรายละเอียดการสมัคร และช่องทางฝากถอนก่อนใช้งาน</strong>
        ซึ่งแต่ละเมนูวางเงื่อนไขของตัวเองไว้คนละชุด จึงควรเปิดอ่านทีละหัวข้อแทนการเทียบจากหัวข้ออื่น
      </p>

      <p>
        <strong class="text-[#fded41]">ส่วนคำกล่าวอ้างเกี่ยวกับลิขสิทธิ์เกม ความน่าเชื่อถือ และการไม่ใช้บัญชีม้า ควรตรวจสอบจากหลักฐานของผู้ให้บริการและข้อมูลบัญชีรับเงินที่ยืนยันได้</strong>
