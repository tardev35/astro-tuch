---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion,
// /login, /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์
// หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ (src/assets/content.txt) ไม่มี
// ส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่จากข้อเท็จจริงและคลังคำของบรีฟรอบนี้
// เท่านั้น (.claude/brand-spec-ngernthong168.md §5)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x4 · h3x0
//   h1  เกี่ยวกับเรา <แบรนด์> สล็อตเงินดี อัตราจ่ายสูง ค่ายเกมลิขสิทธิ์แท้100%
//   h2  เกมสล็อตที่ <แบรนด์> รวบรวมไว้มากกว่า 1,000 เกม
//   h2  โปรโมชั่นสมาชิก <แบรนด์> คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%
//   h2  สมัครเล่นสล็อต <แบรนด์> ง่ายๆ 3 ขั้นตอน
//   h2  ช่องทางติดต่อแอดมิน <แบรนด์> ตลอด 24ชม.
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// (ขั้นตอนสมัครสามขั้นลงเป็น <ol> เพราะเป็นลำดับขั้น ไม่ใช่สามหัวข้อย่อยที่มี
// บทความของตัวเอง)
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) จึงเปิดใช้งานอยู่
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// เป็นของแบรนด์เก่ามาก ตัวที่ routing จริงคือไฟล์นี้ Astro ไม่อ่านโฟลเดอร์นั้นเลย
// **ห้ามแก้ ห้ามลบ และห้ามสลับมาแทนไฟล์นี้**
//
// 🚨 แกนของดรอปนี้ (2026-10-22) คือ **เว็บสล็อตออนไลน์** ที่นำเสนอเกมสล็อต
// มากกว่า 1,000 เกม จากค่ายมาตรฐานสากล · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% ·
// สมัคร 3 ขั้นตอน · แอดมิน 24ชม.
// ⚠️⚠️ **แบรนด์ขาออกขายจุดยืนคนละแบบกับรอบนี้** คำขายของกลุ่มนั้นที่เคยอยู่ใน
// ไฟล์นี้จึงเป็นคำค้างของแบรนด์ขาออก **ไม่ใช่ของรอบนี้** (ทั้งคำกลุ่มบัญชีรับเงิน
// คำกลุ่ม "ค่ายของแท้" และคำกลุ่มโหมดเล่นฟรี ซึ่งบรีฟรอบนี้ไม่มีสักคำ) และรอบ
// ก่อนหน้านั้นเป็นเว็บลอตเตอรี — คำกลุ่มนั้นก็ห้ามหลงเหลือเช่นกัน
// **รายการคำต้องห้ามเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่** เพื่อไม่ให้ sweep
// ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// ⚠️ `ทดลองเล่น` เหลือรอดได้เฉพาะในฐานะ **ชื่อ route /ทดลองเล่น** ซึ่งเป็นหน้าที่มี
// อยู่จริงและอยู่ในเมนูนาวบาร์ — ห้ามใช้เป็นคำโฆษณาเกี่ยวกับตัวเกมของแบรนด์นี้
//
// ⚠️⚠️ **สองหน้าหมวดลอตเตอรียังจอดอยู่ใน src/pages-disabled/ รอบนี้** → ลิงก์ไป
// สอง route นั้นจะทำให้ build แดง ห้ามเขียนกลับมา
// route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ทดลองเล่น · /about-us · /contact-us · /terms · /privacy · /line
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกม ชื่อธนาคาร ชื่อวอลเล็ต ชื่อผู้ให้บริการ
// หน่วยงานกำกับ ใบอนุญาต ปีก่อตั้ง จำนวนสมาชิก ค่า RTP เป็นตัวเลข หรือยอดฝาก
// ขั้นต่ำ แม้แต่รายการเดียว** จึงห้ามเขียนลงหน้าเว็บ · ตัวเลขที่ขึ้นหน้าได้มีแค่
// ของบรีฟเอง: **1,000 เกม · 0.3% · 0.8% · 24ชม. · 3 ขั้นตอน · 100%**
//
// 🚨 **บรีฟรอบนี้โฆษณาและกำกับข้อจำกัดในย่อหน้าเดียวกัน** — ทั้งสองครึ่งต้อง ship
// ครบตามที่เขียน ประโยคกำกับไม่ใช่ filler ให้ตัดทิ้ง:
// 1) คำกล่าวอ้างเกี่ยวกับอัตราจ่ายสูงและลิขสิทธิ์เกม ควรตรวจสอบจากข้อมูลผู้พัฒนา
//    และหลักฐานการอนุญาตที่เชื่อถือได้ก่อนใช้งาน (h1)
// 2) จำนวนเกมที่เปิดให้บริการจริงอาจเปลี่ยนแปลงได้ · ค่า RTP เป็นค่าทางสถิติ
//    ระยะยาว ไม่ใช่การรับประกันผลตอบแทนของการเล่นแต่ละครั้ง (h2 #1)
// 3) เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือรับประกัน
//    ผลกำไรในอนาคต · แม้ระบุว่ากดรับได้ไม่จำกัด แต่ควรตรวจสอบจำนวนครั้งที่รับ
//    สิทธิ์ได้จริงจากประกาศล่าสุด (h2 #2)
// 4) ควรตรวจสอบคุณสมบัติผู้สมัคร อายุที่กฎหมายอนุญาต และเงื่อนไขการใช้บริการ ·
//    ไม่ควรใช้ข้อมูลของบุคคลอื่นหรือเปิดเผยรหัส OTP ให้ใครทราบ (h2 #3)
// 5) ควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชี
//    แอบอ้าง · เตรียมหมายเลขรายการและหลักฐาน · ควรตรวจสอบเวลาการให้บริการจริงจาก
//    ประกาศล่าสุดอีกครั้ง (h2 #4)
//
// 🚨 พาเลตรอบนี้ (brand-spec §2) ยังเป็นธีมมืดเหมือนรอบก่อน **แต่คนละค่า**
// bg.json ของดรอปนี้คือ {"mode":"color","color":"#29210f"} = น้ำตาลโอลีฟเข้ม
// **ห้าม "แก้" กลับไปเป็นพื้นสว่าง**
// ค่าที่ใช้ได้ในไฟล์นี้: ทองสว่าง #fcee52 (<strong> + ตัวอักษรบนพื้นเข้ม 10.7:1
// บนการ์ด — เป็นสีไฮไลต์ของเนื้อความ) · ทองแกน #f5ba14 (ขอบ · ออรา · marker ·
// stop กลางของปุ่มหลัก 7.3:1) · ทองลึก #b37c0b (**2.0:1 — พื้นถม/ขอบเท่านั้น
// ห้ามถือตัวอักษร**) · โครมกลาง #2e2512 และอินเซ็ต #201906 (พื้นผิว) ·
// หมึกบนพื้นถมทอง #201906 (9.9:1 บน #f5ba14 · 14.5:1 บน #fcee52)
// หมึกเนื้อความคือครีมอุ่น #ecd5c4 (= BRAND_TEXT) ซึ่ง **ไม่ประกาศในไฟล์นี้**
// การ์ด ContentBox ตั้งไว้ให้แล้วและย่อหน้าสืบทอดลงมา
// 🚨 **ห้ามใช้ตัวอักษรขาวบนพื้นถมทอง** ปุ่มหลักใช้หมึก #201906 เสมอ
// ออราที่อนุญาต: rgba(245,186,20,α) · rgba(252,238,82,α) · rgba(236,213,196,α) ·
// rgba(32,25,6,α) · rgba(0,0,0,α)
// ⚠️ รอบนี้ไม่มีฟ้า/น้ำเงิน ไม่มีแดง ไม่มีชมพู ไม่มีม่วง ไม่มีส้ม ไม่มีโรสโกลด์
// และ **ไม่มีแรมป์เทาเงิน** (เทาเงินคือวัสดุที่สองของแบรนด์ขาออก รอบนี้วัสดุที่สอง
// คือ **ครีมอุ่น #ecd5c4**) ไม่มีเขียว ยกเว้น **LINE green #00B900** บนปุ่ม LINE
// ซึ่งเป็นสีประจำแพลตฟอร์ม ห้ามเปลี่ยนเป็นสีแบรนด์
// ⚠️⚠️ **ทองนำสองรอบติดกัน** การเจอทองในไฟล์จึงไม่พิสูจน์อะไรเลย — ห้ามเทียบ
// ด้วยวงศ์สี ต้องเทียบ **ทีละค่า** กับตาราง brand-spec §2 (ค่าทองของแบรนด์ขาออก
// ห่างจากของรอบนี้แค่หลักหน่วยถึงหลักสิบ)
//
// ลำดับปุ่มในไฟล์นี้สื่อด้วยพื้นถมสามขั้ว:
// · ปุ่มหลัก (สมัครสมาชิก) ถมไล่เฉดทอง #fcee52 -> #f5ba14 -> #b37c0b หมึก #201906
// · ปุ่มรอง (เข้าสู่ระบบ) ขอบ #f5ba14 ตัวอักษร #fcee52 บนโครมกลาง #2e2512
// · ปุ่มลิงก์ภายในเป็นอินเซ็ต #201906 ขอบ #b37c0b ตัวอักษร #fcee52
//   hover ยกขอบเป็นทองแกน (ตรงกับ hover ของการ์ด ContentBox)
// · ชิปไอคอนของรายการใช้ทองแกนเป็น **เส้นขอบ** บนอินเซ็ต #201906 ไม่ถือตัวอักษร
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง และไม่ใส่ mx-auto / max-w-* บน <p>
// เพราะการ์ดคุมความกว้างเองแล้ว — ที่ประกาศสีได้มีแค่ปุ่ม ชิปไอคอน marker ของ
// ลำดับเลข และ <strong> · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง
// เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำ
// จะขาดครึ่ง (ลบแท็ก <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิม) และห้ามวาง
// <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังใน prop ที่เป็นข้อความ
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: ดรอปนี้ไม่มี article illustration เลย (banner2/
// banner3 เป็นอาร์ตเวิร์กของแบรนด์คนละราย เก่าทั้งคู่) ส่วน slide1/slide2 ถูกตรึง
// ไว้กับ index กับ /promotion และ banner1 / banner1-mobile / og.png เป็นของ glob
// ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า · slide3/slide4 เป็นโปสเตอร์ของอีกแบรนด์
// ห้าม import (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build
// จะแดง) — ไฟล์ยังอยู่บนดิสก์ ห้ามลบ
//
// Announcement รอบนี้หมุนมาเป็น Announcement2 ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ AnnouncementPremium จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์
// นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว จึงเรียกแบบ bare **ห้ามส่ง prop message**
// มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 157 อักขระ (ชื่อแบรนด์รอบนี้ 10 ตัวอักษร) เป็นประโยคเดียวที่บอกว่า
// หน้านี้มีอะไร แล้วหยุด
// (Google ตัดราว 155 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} เว็บสล็อตที่รวมเกมกว่า 1,000 เกม จากค่ายมาตรฐานสากล พร้อมข้อมูลอัตราจ่าย โปรโมชั่นคืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% และการติดต่อ 24ชม.`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} สล็อตเงินดี อัตราจ่ายสูง ค่ายเกมลิขสิทธิ์แท้100%`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#fcee52]">{BRAND_NAME} นำเสนอเกมสล็อตออนไลน์หลากหลายรูปแบบ พร้อมข้อมูลค่ายเกม อัตราจ่าย และโปรโมชั่นสำหรับสมาชิก</strong>
        หน้านี้รวบรวมไว้ว่าเว็บไซต์ระบุอะไรไว้บ้าง เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดอ่านอะไรตรงไหน แล้วจึงค่อยไล่อ่านรายละเอียดของแต่ละหัวข้อเป็นรายข้อ
      </p>

      <p>
        สิ่งที่หน้านี้ทำได้คือชี้ว่าข้อมูลแต่ละชุดอยู่ตรงไหนและควรอ่านอะไรก่อน
        <strong class="text-[#fcee52]">ภายในเว็บไซต์มีเมนูสำหรับเลือกศึกษาเกมที่สนใจ ตรวจสอบกติกาและเงื่อนไขการเดิมพัน รวมถึงรายละเอียดการสมัครสมาชิกและช่องทางติดต่อเจ้าหน้าที่</strong>
        ซึ่งแต่ละเมนูวางเงื่อนไขของตัวเองไว้คนละชุด จึงควรเปิดอ่านทีละหัวข้อแทนการเทียบจากหัวข้ออื่น
      </p>

      <p>
        <strong class="text-[#fcee52]">ส่วนคำกล่าวอ้างเกี่ยวกับอัตราจ่ายสูงและลิขสิทธิ์เกม ควรตรวจสอบจากข้อมูลผู้พัฒนาและหลักฐานการอนุญาตที่เชื่อถือได้ก่อนใช้งาน</strong>
