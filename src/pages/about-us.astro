---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็น **บทความจริง** (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login,
// /register หรือหน้าภาพแบบ /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง
// ไม่ใช่เช็กลิสต์หัวข้อของบรีฟที่ใช้กับ index.astro — บรีฟรอบนี้
// (src/assets/content.txt, 29 บรรทัด) ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าใหม่จาก
// ข้อเท็จจริงและคลังคำของบรีฟรอบนี้เท่านั้น (.claude/brand-spec-win8s.md §4-§5)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x5 · h3x0
//   h1  เกี่ยวกับเรา <แบรนด์> คาสิโนเล่นบาคาร่า เกมเดิมพันสด และสล็อตในที่เดียว
//   h2  บาคาร่าออนไลน์ คาสิโนสด และสล็อต สามหมวดเกมที่ <แบรนด์> รวบรวมไว้
//   h2  สิ่งที่ควรตรวจสอบเองก่อนเชื่อข้อความโฆษณาบนหน้าเว็บ
//   h2  ระบบสมาชิกของ <แบรนด์> และการสมัคร 3 ขั้นตอน
//   h2  โปรโมชั่นที่ <แบรนด์> ระบุไว้ คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%
//   h2  แอดมิน <แบรนด์> ออนไลน์ตลอด 24 ชั่วโมง
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) และจาก footer จึงเปิดใช้งานอยู่
// ⚠️ หัวข้อของหน้านี้ **ตั้งใจไม่ให้ซ้ำกับหัวข้อของ index.astro** — index เล่าว่า
// เว็บไซต์ "ระบุอะไรไว้" ตามลำดับของบรีฟ ส่วนหน้านี้เล่าว่า "ตรวจสอบอะไรได้จากที่ไหน"
// ถ้ารอบหน้าคัดลอกหัวข้อของ index มาวางที่นี่ จะได้สองหน้าที่แข่งกันเองใน index
//
// 🚨🚨 ดรอปนี้ (2026-10-28) แบรนด์ขาออกอยู่หมวดธุรกิจเดียวกัน (เว็บเดิมพันออนไลน์)
// แต่ **คนละคำนิยามตัวเองทั้งชุด** เนื้อหาทั้งหน้าจึงถูก **เขียนใหม่** ไม่ใช่แค่
// เปลี่ยนชื่อแบรนด์ บรีฟรอบนี้เรียกตัวเองว่า "คาสิโนเล่นบาคาร่า ทางเข้าเล่น
// เกมเดิมพันสด ทุกค่ายดัง การันตีลิขสิทธิ์แท้จากเมกา เล่นง่าย ไม่หักเปอร์เซ็นต์
// เซิร์ฟนอก ปลอดภัย100%" และระบุหมวดเกมไว้ **สามหมวด** (บาคาร่าออนไลน์ ·
// คาสิโนสด · สล็อต) · ระบบสมาชิกที่ใช้งานผ่านมือถือ · คืนยอดเสีย 0.3% ·
// แนะนำเพื่อน 0.8% · โบนัสไม่อั้น · สมัคร 3 ขั้นตอน · แอดมินตลอด 24ชม.
// 🚨🚨 **รอบก่อนมีเจ็ดหมวด รอบนี้มีสาม — ห้ามสืบทอดจำนวนหมวดข้ามแบรนด์**
// 🚨🚨 **อีกสี่หมวดที่รอบก่อนมี บวกหมวดสลากกินแบ่ง ไม่มีในบรีฟรอบนี้เลยสักคำ
// ห้ามโผล่ที่ไหนบนหน้านี้** (ลิสต์ชื่อหมวดที่ห้ามอยู่ครบใน brand-spec §5 —
// ไม่พิมพ์ซ้ำที่นี่ เพื่อให้ sweep ของรอบถัดไปไม่เจอ false positive ในคอมเมนต์นี้เอง)
// และ **ห้ามเขียนเนื้อหาหมวดสลากกินแบ่งทุกรูปแบบ** สองหน้าของหมวดนั้นยังอยู่ใน
// src/pages-disabled/ (ชื่อไฟล์อยู่ใน brand-spec §7)
// **ห้ามลิงก์ไปหาเด็ดขาด** ลิงก์ตาย = build แดง
// ⚠️⚠️ ศัพท์หมวดธุรกิจของแบรนด์ขาออกเป็น **คำค้างข้ามแบรนด์** ห้ามหลุดกลับมา
// **รายการคำต้องห้ามเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่** เพื่อไม่ให้
// sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// 🚨🚨 **สามคำที่ spec รอบก่อนๆ ห้ามไว้ แต่รอบนี้เป็นคำของบรีฟเอง**: เซิร์ฟนอก ·
// ปลอดภัย100% · ลิขสิทธิ์แท้จากเมกา **ห้ามลบออกเพราะอ่านคอมเมนต์เก่าแล้วเข้าใจผิด**
// 🚨🚨 **บรีฟรอบนี้ไม่มีหมวดฝากถอน/ธนาคาร/วอลเลทเป็นบริการของเว็บเลยแม้แต่คำเดียว**
// — รอบก่อนๆ เคยมีหัวข้อทำนองนั้นอยู่บนหน้านี้ **ถูกตัดออกและห้ามเขียนกลับ**
// ที่ห้ามคือ **ประโยคที่อ้างว่าเว็บให้บริการฝาก-ถอน** · ชื่อธนาคาร/วอลเล็ต ·
// ฟีเจอร์ออโต้ · และยอดขั้นต่ำ-สูงสุดที่เป็นตัวเลข
// ⚠️⚠️ **แต่ประโยคกำกับของบรีฟเองที่มีคำว่า "ถอนเงิน" ต้อง ship ตามที่บรีฟเขียน
// ห้ามเลี่ยงคำ** (บรรทัด 8 ข้อกำหนดการถอนเงิน · บรรทัด 10 ข้อกำหนดการใช้โบนัสและ
// การถอนเงิน · บรรทัด 12 เงื่อนไขการถอนเงิน) สามจุดนั้นเป็น **คำเตือนผู้บริโภคที่
// บรีฟเขียนถึงตัวเอง** ซึ่งตรงข้ามกับคำโฆษณา การเลี่ยงไปใช้ "การทำรายการ" หรือ
// "ข้อจำกัดในการใช้เครดิต" **ทำให้ความหมายเพี้ยน**
// ⚠️⚠️ ชื่อแบรนด์รอบนี้เป็น **ตัวละตินพิมพ์ใหญ่ + ตัวเลข + ตัวละตินพิมพ์ใหญ่ เขียน
// ติดกันเป็นคำเดียว ยาว 5 อักขระ** ทุกจุด interpolate จาก BRAND_NAME เพื่อไม่ให้
// ค้างเป็นชื่อแบรนด์ก่อนหน้าตอนรีแบรนด์รอบถัดไป **ห้ามพิมพ์ชื่อแบรนด์เป็น literal**
//
// ⚠️ route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ทดลองเล่น · /about-us · /contact-us · /terms · /privacy · /line
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกม ชื่อผู้ให้บริการ หน่วยงานกำกับ เลขใบอนุญาต
// ปีก่อตั้ง จำนวนสมาชิก จำนวนเกม ค่า RTP หรือยอดขั้นต่ำที่เป็นตัวเลข แม้แต่
// รายการเดียว** จึงห้ามเขียนลงหน้าเว็บ · ตัวเลขที่ขึ้นหน้าได้มีแค่ของบรีฟเอง:
// **0.3% · 0.8% · 100% · 3 ขั้นตอน · 24 ชั่วโมง**
//
// 🚨 **บรีฟรอบนี้โฆษณาแล้วกำกับตัวเองในย่อหน้าเดียวกันแทบทุกย่อหน้า** — ทั้งสอง
// ครึ่งต้อง ship ครบ ประโยคกำกับไม่ใช่ filler ให้ตัดทิ้ง:
// 1) ควรตรวจสอบรายชื่อผู้ให้บริการเกมและความน่าเชื่อถือของแพลตฟอร์มก่อนใช้งาน
//    เพราะเกมคาสิโนมีความเสี่ยงและไม่สามารถรับประกันผลรางวัลได้
//    (บรีฟบรรทัด 4 — รับที่ h1 และ h2 #1)
// 2) ควรตรวจสอบหลักฐานการได้รับอนุญาต ชื่อบริษัทผู้ให้บริการ และกติกาการคิด
//    ค่าธรรมเนียมให้ชัดเจน · การใช้เซิร์ฟเวอร์ต่างประเทศไม่ได้รับประกันความปลอดภัย
//    ของข้อมูลหรือความถูกต้องตามกฎหมายในไทย (บรีฟบรรทัด 6 — รับที่ h2 #2)
// 3) ควรตรวจสอบข้อกำหนดด้านอายุ กฎหมายที่เกี่ยวข้อง และนโยบายความเป็นส่วนตัว ·
//    ไม่เปิดเผยรหัสผ่านและรหัส OTP ให้ใครทราบ (บรีฟบรรทัด 14, 18 — รับที่ h2 #3)
// 4) โปรโมชั่นแต่ละรายการควรตรวจประเภทเกมที่เข้าร่วม ยอดที่นำมาคำนวณ รอบเวลารับ
//    เครดิต และข้อกำหนดการถอนเงิน · แม้ใช้ข้อความว่าโบนัสไม่อั้น ควรศึกษาวงเงิน
//    สูงสุด · โปรโมชั่นคืนยอดเสียไม่ได้รับประกันว่าจะได้รับเงินคืนจากทุกการเดิมพัน
//    หรือเพิ่มโอกาสชนะในครั้งถัดไป · แม้ระบุว่าไม่จำกัด ควรตรวจจำนวนบัญชี วงเงิน
//    โบนัส และเงื่อนไขการถอนเงิน (บรีฟบรรทัด 8, 10, 12 — รับที่ h2 #4)
// 5) ควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชี
//    แอบอ้าง · เก็บหมายเลขรายการและหลักฐานไว้ · ตรวจสอบเวลาการให้บริการจริงจาก
//    ประกาศล่าสุดอีกครั้ง (บรีฟบรรทัด 22 — รับที่ h2 #5)
//
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) **กลับทิศ 180° จากรอบก่อน: รอบนี้มืดทั้งเว็บ**
// bg.json ของดรอปนี้คือ {"mode":"color","color":"#1e0101"} = **ดำอมเลือดหมู**
// (รอบก่อนเป็นชมพูบลัชจาง ซึ่งอยู่คนละปลายของสเกล — เปิด bg.json อ่านทุกรอบ
// ห้ามสืบทอด) **ห้าม "แก้" การ์ด/ปุ่มกลับไปเป็นผิวสว่าง** — ผิวสว่างบนหมึก
// #fdf0e6 = ตัวอักษรหายไปเลย ไม่ใช่แค่จางลง
// ค่าที่ใช้ได้ในไฟล์นี้: `<strong>`/marker/ลิงก์ **#f27a1a** (6.6:1 บนการ์ด #2a0a04) ·
// เนื้อความ #fdf0e6 (16.4:1) · หมึกรอง #e0bda4 (10.5:1) · ทองอำพัน #e5a92b (8.8:1) ·
// เงินโครเมียม #c9d2dc (12.0:1) · พื้นไล่เฉดปุ่มหลัก #f0a21e -> #f27a1a -> #e8620e
// (**พื้นถม** + หมึกดำ #1e0101 — 9.3 / 8.0 / 5.8:1 ต่อ stop) · ปุ่มรองเป็นผิว
// #2a0a04 หมึก #f0a21e ขอบ #8a3a12 · ปุ่ม outline ขอบ+ตัวอักษร #f27a1a บนผิว
// #2a0a04 · ชั้นยก/ชิป #3b130b · เส้นบาง #5a2410 · ขอบตกแต่ง #8a3a12
// (**สองค่าท้ายห้ามถือตัวอักษร**)
// หมึกเนื้อความคือ #fdf0e6 (= BRAND_TEXT) ซึ่ง **ไม่ประกาศในไฟล์นี้** การ์ด
// ContentBox ตั้งไว้ให้แล้วและย่อหน้าสืบทอดลงมา
// 🚨🚨 **#5a2410 · #8a3a12 — ห้ามเป็นสีตัวอักษร** เป็นเส้น/ขอบ/ออรา/พื้นถมเท่านั้น
// และ **ห้ามใช้หมึกขาวบนไล่เฉดปุ่มหลัก** (2.8:1) ปุ่มหลักจึงจบไล่เฉดที่ #e8620e
// ออราที่อนุญาต: rgba(242,122,26,α) · rgba(229,169,43,α) · rgba(138,58,18,α) ·
// rgba(30,1,1,α) · rgba(20,3,2,α)
// 🚨🚨 **แดงชาด-ชมพูบลัชคือฮิวของรอบก่อน รอบนี้กลับทิศเป็นส้มเพลิง-ทองอำพันบนดำ**
// ที่ห้ามคือ **ค่าเฮกซ์ของแบรนด์เก่าแบบตรงหกหลัก** ไม่ใช่ "สีส้ม" ในฐานะตระกูลสี
// เพราะมีแบรนด์ส้ม/ทองมาแล้วหลายเจ้า ต้องเทียบ **ทีละค่า** กับตาราง brand-spec §2
// (คู่ที่พิมพ์ผิดง่ายสุดลิสต์ไว้ในนั้นแล้ว และเขียนแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้
// sweep สะดุด) ค่าของ 123BET รอบก่อนทันทีที่ต้องไม่หลงเหลือ เขียนแบบไม่มี #:
//  a30d1a c21325 8a1420 ef4a5e dca53a 7a4a0c d2d7dd 36080f 6b2b33 fdf5f6 f7e4e9
//  f7dfe4 eec3cc d98fa0
// ⚠️ ข้อยกเว้นสีเชิงความหมาย: **LINE green #00B900** บนปุ่ม LINE (ต้องเป็นพื้นถม
// ของค่านั้น + ตัวอักษรขาว) **ห้ามเปลี่ยนเป็นส้มตามพาเลตรอบนี้**
// ⚠️ ห้องญี่ปุ่นโทนขาวงาช้าง กิ่งซากุระชมพู-ขาว กิโมโนแดง-ดำปักทอง ปิ่นซากุระ
// แดง-ขาว มงกุฎทองบนตราสัญลักษณ์ และสีผิวนางแบบในอาร์ตเวิร์กเป็น **วัตถุในภาพ
// ไม่ใช่สี UI** · และ **เวิร์ดมาร์กส้มเพลิง-โครเมียมเงินก็เป็นอาร์ตเวิร์ก ไม่ใช่สี UI**
//
// ลำดับปุ่มในไฟล์นี้สื่อด้วยพื้นถมสามขั้ว (ตรงกับคู่ปุ่มที่ล็อกไว้ใน brand-spec §2):
// · ปุ่มหลัก (สมัครสมาชิก) ไล่เฉด #f0a21e -> #f27a1a -> #e8620e หมึกดำ #1e0101
// · ปุ่มรอง (เข้าสู่ระบบ) ผิว #2a0a04 หมึก #f0a21e ขอบ #8a3a12
// · ปุ่มลิงก์ภายในเป็นปุ่ม outline ขอบ #f27a1a ตัวอักษร #f27a1a บนผิว #2a0a04
//   hover ยกพื้นขึ้นเป็นชั้นยก #3b130b
// · ชิปไอคอนของรายการใช้ขอบ #5a2410 บนชั้นยก #3b130b ไม่ถือตัวอักษร
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง และไม่ใส่ mx-auto / max-w-* บน <p>
// เพราะการ์ดคุมความกว้างเองแล้ว — ที่ประกาศสีได้มีแค่ปุ่ม ชิปไอคอน marker ของ
// ลำดับเลข และ <strong> · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง
// เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำ
// จะขาดครึ่ง (ลบแท็ก <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิม) และห้ามวาง
// <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังใน prop ที่เป็นข้อความ และต้องเป็นไอคอนหมวดเกมคาสิโนของรอบนี้
// slot ของ ContentBox รับ **หนึ่ง element** เท่านั้น จึงห่อด้วย <div> ชั้นเดียว
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: รูปของดรอปนี้ถูกตรึงไว้ที่อื่นครบทุกไฟล์ —
// สไลด์สองใบของดรอปถูกตรึงไว้กับ index และ /promotion · banner1 /
// banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// แบนเนอร์ใบที่สองและสาม (2026-10-23) กับสไลด์ใบที่สามและสี่ (2026-09-29)
// เป็นอาร์ตเวิร์กของแบรนด์อื่น **ห้าม import ทั้งสี่ไฟล์**
// (ชื่อไฟล์เต็มอยู่ใน brand-spec §6) (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง
// dist/ และ verify-build จะแดง) — ไฟล์ทั้งหมดยังอยู่บนดิสก์ **ห้ามลบ**
// เป็นอินเวนทอรีของแบรนด์ถัดไป · อาร์ตสต็อกกลางของเทมเพลตถูกตรึงไว้กับ /ทดลองเล่น
//
// Announcement รอบนี้หมุนมาเป็นตัวท้ายชื่อ Premium ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ตัวท้ายชื่อเลขห้าจึงหมุนออก · เขียนชื่อไฟล์แบบไม่มีเครื่องหมายคำพูดโดยตั้งใจ
// เพราะ tools/gen-tw-sources.mjs นับ literal ที่มีเครื่องหมายคำพูดว่าเป็นการ import
// จริง) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว
// จึงเรียกแบบ bare **ห้ามส่ง prop message** มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -c บนเชลล์นี้
// ก็นับเป็นไบต์ ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับตัวนับ
// ของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 155 อักขระ (ชื่อแบรนด์รอบนี้ 5 อักขระ) เป็นประโยคเดียวที่บอกว่า
// หน้านี้มีอะไร แล้วหยุด **ต้องนับใหม่ทุกรอบ** ห้ามสืบทอดความยาว
// (Google ตัดราว 160 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนๆ ยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} คาสิโนเล่นบาคาร่า เกมเดิมพันสด และสล็อต หน้ารวมข้อมูลระบบสมาชิก โปรโมชั่นคืนยอดเสียและแนะนำเพื่อน พร้อมสิ่งที่ควรตรวจสอบเองก่อนใช้บริการ`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} คาสิโนเล่นบาคาร่า เกมเดิมพันสด และสล็อตในที่เดียว`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

// คลาสปุ่มสามขั้วของหน้านี้ ประกาศครั้งเดียวแล้วใช้ซ้ำ เพื่อไม่ให้สองปุ่มที่ทำ
// หน้าที่เดียวกันหลุดไปคนละเฉดตอนรีแบรนด์รอบหน้า
const ctaPrimary =
  "flex items-center justify-center rounded-full border border-[#8a3a12] bg-gradient-to-b from-[#f0a21e] via-[#f27a1a] to-[#e8620e] px-8 py-3 font-black text-[#1e0101] shadow-[0_6px_18px_rgba(242,122,26,0.32)] transition-transform hover:scale-105";

const ctaSecondary =
  "flex items-center justify-center rounded-full border border-[#8a3a12] bg-[#2a0a04] px-8 py-3 font-bold text-[#f0a21e] shadow-[0_6px_18px_rgba(20,3,2,0.5)] transition-transform hover:scale-105";

const ctaQuiet =
  "flex items-center justify-center rounded-full border-2 border-[#f27a1a] bg-[#2a0a04] px-8 py-3 font-bold text-[#f27a1a] shadow-[0_4px_14px_rgba(20,3,2,0.45)] transition-all hover:scale-105 hover:bg-[#3b130b] hover:shadow-[0_6px_18px_rgba(242,122,26,0.22)]";

const listChip = "mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#5a2410] bg-[#3b130b] text-sm";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#f27a1a]">{BRAND_NAME} นำเสนอข้อมูลคาสิโนออนไลน์ที่รวบรวมเกมบาคาร่าและเกมสล็อตจากค่ายต่าง ๆ พร้อมรายละเอียดเกมเดิมพันสด ระบบสมาชิก และโปรโมชั่นภายในเว็บไซต์เดียว</strong>
        หน้านี้สรุปไว้ว่าเว็บไซต์ระบุอะไรไว้บ้าง และควรเปิดอ่านรายละเอียดส่วนไหนก่อน เพื่อให้เห็นภาพรวมก่อนไล่อ่านกติกาเกมและเงื่อนไขของแต่ละรายการเป็นรายข้อ
      </p>

      <p>
        เว็บไซต์อธิบายตัวเองไว้ว่าเป็น
        <strong class="text-[#f27a1a]">คาสิโนเล่นบาคาร่า ทางเข้าเล่น เกมเดิมพันสด ทุกค่ายดัง การันตีลิขสิทธิ์แท้จากเมกา เล่นง่าย ไม่หักเปอร์เซ็นต์ เซิร์ฟนอก ปลอดภัย100%</strong>
        ซึ่งทั้งหมดนั้นเป็นข้อความที่เว็บไซต์แจ้งไว้ ไม่ใช่ข้อสรุปของหน้านี้ เพราะผู้ใช้งานสามารถศึกษากติกาบาคาร่าสด รูปแบบการเดิมพัน และเงื่อนไขของแต่ละเกมได้ในเว็บไซต์เดียว แต่แต่ละหมวดก็มีเงื่อนไขของตัวเองที่ไม่ได้เหมือนกันทั้งหมด
      </p>

      <p>
        <strong class="text-[#f27a1a]">ผู้ใช้งานควรตรวจสอบรายชื่อผู้ให้บริการเกมและความน่าเชื่อถือของแพลตฟอร์มก่อนใช้งาน เพราะเกมคาสิโนมีความเสี่ยงและไม่สามารถรับประกันผลรางวัลได้</strong>
        เนื้อหาในหน้านี้จึงเขียนไว้ประกอบการใช้งานเท่านั้น ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้บริการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`บาคาร่าออนไลน์ คาสิโนสด และสล็อต สามหมวดเกมที่ ${BRAND_NAME} รวบรวมไว้`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#f27a1a]">{BRAND_NAME} รวบรวมข้อมูลเกมไว้สามหมวด โดยแต่ละประเภทมีรูปแบบการเล่นและอัตราจ่ายไม่เหมือนกัน</strong>
        รายการด้านล่างคือหมวดที่เว็บไซต์ระบุไว้ และเป็นจุดเริ่มต้นสำหรับคนที่ยังไม่แน่ใจว่าควรเปิดอ่านกติกาของส่วนไหนก่อน
      </p>

      <ul class="flex flex-col gap-4" aria-label="หมวดเกมที่เว็บไซต์ระบุไว้">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🃏</span>
          <span>
            <strong class="text-[#f27a1a]">บาคาร่าออนไลน์</strong> เป็นเกมไพ่ที่คิดผลจากแต้มของสองฝั่ง โดยบาคาร่าแต่ละรูปแบบอาจมีอัตราจ่ายหรือค่าคอมมิชชันแตกต่างกัน จึงควรอ่านกติกาของโต๊ะที่กำลังเปิดอยู่ก่อนลงเดิมพัน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎥</span>
          <span>
            <strong class="text-[#f27a1a]">เกมคาสิโนสด</strong> เป็นเกมเดิมพันสดที่ถ่ายทอดจากโต๊ะจริง แต่ละห้องกำหนดรูปแบบการวางเดิมพันและวิธีคิดผลไว้ของตัวเอง จึงควรดูเงื่อนไขของห้องที่เข้าอยู่ก่อนเริ่ม
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎰</span>
          <span>
            <strong class="text-[#f27a1a]">เกมสล็อต</strong> เป็นเกมหมุนวงล้อที่แต่ละเกมมีฟีเจอร์และเงื่อนไขการคิดรางวัลของตัวเอง ข้อความรวมที่หน้าแรกเป็นคำอธิบายภาพรวม ไม่ได้แทนรายละเอียดของเกมที่เปิดอยู่จริง
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#f27a1a]">ควรตรวจสอบรายชื่อเกมและผู้ให้บริการที่เปิดใช้งานจริงจากเว็บไซต์ก่อนทำรายการ</strong>
        เพราะเกมแต่ละหมวดกำหนดไว้ไม่เหมือนกัน และรายการที่เปิดให้บริการในแต่ละช่วงก็ไม่ได้ครบทุกหมวดเสมอไป
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/ทดลองเล่น" aria-label={`เปิดหน้าทดลองเล่นของ ${BRAND_NAME}`} class={ctaQuiet}>ไปหน้าทดลองเล่น</a>

        <a href="/promotion" aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`} class={ctaQuiet}>ดูภาพโปรโมชั่น</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="สิ่งที่ควรตรวจสอบเองก่อนเชื่อข้อความโฆษณาบนหน้าเว็บ" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        เว็บไซต์ระบุว่าให้บริการเกมคาสิโนผ่านระบบเซิร์ฟเวอร์ต่างประเทศ พร้อมนำเสนอข้อมูลเกี่ยวกับลิขสิทธิ์เกมจากสหรัฐอเมริกาและรูปแบบการเดิมพันที่ไม่หักเปอร์เซ็นต์ ซึ่งเป็นถ้อยคำของเว็บไซต์เอง
        หัวข้อนี้จึงแยกให้ชัดระหว่างสิ่งที่เว็บไซต์ระบุไว้ กับสิ่งที่ผู้ใช้งานตรวจสอบเองได้จากหน้ารายละเอียดจริง
      </p>

      <ul class="flex flex-col gap-4" aria-label="สิ่งที่ควรตรวจสอบด้วยตัวเองก่อนใช้งาน">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🏢</span>
          <span>
            <strong class="text-[#f27a1a]">หลักฐานการได้รับอนุญาตและชื่อบริษัทผู้ให้บริการ</strong> ควรตรวจสอบให้ชัดเจนก่อนใช้งาน เพราะข้อความเรื่องลิขสิทธิ์เกมจากสหรัฐอเมริกายืนยันจากคำโฆษณาบนหน้าเว็บอย่างเดียวไม่ได้
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🛡️</span>
          <span>
            <strong class="text-[#f27a1a]">ความน่าเชื่อถือของแพลตฟอร์มและนโยบายคุ้มครองข้อมูลส่วนบุคคล</strong> ควรอ่านก่อนเปิดบัญชี เพราะการใช้เซิร์ฟเวอร์ต่างประเทศไม่ได้รับประกันความปลอดภัยของข้อมูลหรือความถูกต้องตามกฎหมายในไทย
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📄</span>
          <span>
            <strong class="text-[#f27a1a]">กติกาการคิดค่าธรรมเนียมของเกมที่กำลังจะเล่น</strong> ควรดูจากหน้ารายละเอียดในขณะใช้บริการ โดยเฉพาะบาคาร่าแต่ละรูปแบบที่อาจมีอัตราจ่ายหรือค่าคอมมิชชันแตกต่างกัน
            แทนที่จะอ่านจากข้อความสรุปที่เขียนไว้ล่วงหน้า
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#f27a1a]">หน้านี้จึงชี้ว่าควรอ่านอะไรและเปิดดูจากที่ไหน แทนที่จะยืนยันแทนเว็บไซต์</strong>
        เพราะสิ่งที่ยืนยันได้จริงคือเอกสารและเงื่อนไขที่แสดงอยู่บนหน้ารายละเอียดในขณะใช้บริการ ไม่ใช่ข้อความสรุปที่เขียนไว้ล่วงหน้า
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`ระบบสมาชิกของ ${BRAND_NAME} และการสมัคร 3 ขั้นตอน`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#f27a1a]">
          {BRAND_NAME} นำเสนอข้อมูลการสมัครสมาชิกสำหรับผู้ที่ต้องการศึกษาระบบบาคาร่าและสล็อตออนไลน์ โดยมีขั้นตอนลงทะเบียนผ่านอุปกรณ์ที่เชื่อมต่ออินเทอร์เน็ต 3 ขั้นตอน
        </strong>
        ก่อนดำเนินการควรตรวจสอบข้อกำหนดด้านอายุ กฎหมายที่เกี่ยวข้อง และนโยบายความเป็นส่วนตัว เพื่อให้เข้าใจเงื่อนไขการใช้บริการและการจัดเก็บข้อมูลส่วนบุคคล
      </p>

      <ol class="ml-6 list-decimal space-y-3 marker:font-black marker:text-[#f27a1a]">
        <li>
          <strong class="text-[#f27a1a]">เข้าสู่หน้าสมัครสมาชิก</strong> เปิดเว็บไซต์ผ่านเบราว์เซอร์บนมือถือ ตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง จากนั้นเลือกเมนูสมัครสมาชิกและอ่านข้อกำหนดการเปิดบัญชี รวมถึงรายละเอียดการใช้บริการก่อนดำเนินการ
        </li>
        <li>
