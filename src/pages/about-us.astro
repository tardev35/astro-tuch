---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char, so a byte count reads
// ~3x too long). One string, reused by MainLayout's meta and the WebPage node.
const pageDescription =
  "รู้จัก HONGHAO คาสิโนออนไลน์เว็บตรงที่รวมบาคาร่า คาสิโนสด รูเล็ต เสือมังกร และสล็อตไว้ในบัญชีเดียว พร้อมโบนัส 0.3% - 0.8% ฝากถอนออโต้และทีมงานดูแล 24 ชม.";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ HONGHAO คาสิโนออนไลน์เว็บตรง รวมค่ายดังครบวงจร",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา HONGHAO คาสิโนออนไลน์เว็บตรง รวมค่ายดังครบวงจร" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ HONGHAO" as="h1">
    <p class="mb-6 text-left text-base leading-relaxed text-[#dbe5d3]">
      <strong class="text-[#8fd45e]">HONGHAO</strong> พร้อมให้บริการสมาชิกที่ต้องการเล่นเกมพนันออนไลน์ผ่านมือถือและคอมพิวเตอร์ โดยรวบรวม
      <strong class="text-[#8fd45e]">เกมจากหลากหลายค่ายไว้ในระบบเดียว</strong> ทั้งบาคาร่า คาสิโนสด รูเล็ต เสือมังกร แบล็กแจ็ก สล็อต และเกมเดิมพันประเภทอื่น ๆ
      พร้อมโปรโมชั่นสำหรับสมาชิกตั้งแต่ 0.3% - 0.8% ตามเงื่อนไขที่กำหนด และระบบฝากถอนอัตโนมัติที่ช่วยให้ทำรายการได้สะดวกตลอด 24 ชั่วโมง
    </p>

    <p class="mb-2 text-left text-base leading-relaxed text-[#dbe5d3]">
      สิ่งที่ HONGHAO ให้ความสำคัญคือความชัดเจนของข้อมูล ทั้งเปอร์เซ็นต์โบนัส วิธีคำนวณ รอบการรับสิทธิ์ และเงื่อนไขการถอน จะแสดงอยู่ในหน้ารายละเอียดโปรโมชั่นก่อนเข้าร่วมเสมอ
      สมาชิกควรอ่านเงื่อนไขตรงจุดนั้นทุกครั้ง เพราะข้อกำหนดของแต่ละรายการไม่เท่ากัน และมีทีมงานคอยดูแลตั้งแต่การสมัคร การรับโบนัส ฝากถอน ไปจนถึงการแก้ไขปัญหาระหว่างใช้งาน
    </p>
  </ContentBox>

  <ContentBoxPlain title="เกมคาสิโน HONGHAO เลือกเล่นได้ครบในบัญชีเดียว" as="h2">
    <p class="mb-2 text-left text-base leading-relaxed text-[#dbe5d3]">
      สมาชิกสามารถเข้าเล่นคาสิโน HONGHAO ผ่านระบบที่รองรับทั้งสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ ภายในมีเกมให้เลือกหลายหมวดหมู่ ทั้ง
      <strong class="text-[#8fd45e]">บาคาร่า คาสิโนสด รูเล็ต เสือมังกร แบล็กแจ็ก สล็อต และเกมเดิมพันอื่น ๆ</strong> พร้อมจัดหมวดหมู่ให้ค้นหาได้ง่ายผ่านบัญชีเดียว
      สำหรับกติกา อัตราการจ่าย และเงื่อนไขของแต่ละเกม อาจแตกต่างกันตามค่ายและประเภทการเดิมพัน สมาชิกจึงควรตรวจสอบรายละเอียดที่แสดงในระบบก่อนยืนยันการเดิมพันทุกครั้ง
    </p>
  </ContentBoxPlain>

  <ContentBoxPlain title="โปรโมชั่น HONGHAO คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%" as="h2">
    <p class="mb-2 text-left text-base leading-relaxed text-[#dbe5d3]">
      HONGHAO มีโปรโมชั่นสำหรับสมาชิกที่เข้าเงื่อนไข โดยสามารถ Login เพื่อตรวจสอบสิทธิ์และกดรับโบนัสผ่านบัญชีของตนเอง โปรโมชั่นแต่ละรายการจะแสดงรายละเอียดเกี่ยวกับ
      <strong class="text-[#8fd45e]">เปอร์เซ็นต์ วิธีคำนวณ รอบรับโบนัส และข้อกำหนดที่เกี่ยวข้อง</strong> เพื่อให้สมาชิกตรวจสอบรายละเอียดล่าสุดก่อนกดรับสิทธิ์
    </p>

    <p class="mt-3 mb-2 text-left text-base leading-relaxed text-[#dbe5d3]">
      สำหรับ <strong class="text-[#8fd45e]">โบนัสคืนยอดเสีย 0.3%</strong> สมาชิกที่มียอดเสียตรงตามข้อกำหนดสามารถตรวจสอบสิทธิ์ตามรอบที่กำหนด ระบบจะแสดงยอดที่ใช้คำนวณและสิทธิ์ที่กดรับได้
      ควรตรวจสอบประเภทเกมที่ร่วมรายการ รอบคำนวณ และเงื่อนไขการถอนให้ครบถ้วน ส่วน
      <strong class="text-[#8fd45e]">โบนัสแนะนำเพื่อน 0.8%</strong> เปิดให้สมาชิกนำลิงก์แนะนำของตนเองไปแชร์ให้เพื่อน เมื่อเพื่อนสมัครและมียอดตรงตามเงื่อนไข ระบบจะคำนวณโบนัสให้ตามข้อกำหนด พร้อมติดตามข้อมูลการแนะนำและตรวจสอบโบนัสผ่านบัญชีสมาชิกได้
    </p>
  </ContentBoxPlain>

  <ContentBoxPlain title="ฝากถอนอัตโนมัติ และทีมงาน HONGHAO ดูแลตลอด 24 ชั่วโมง" as="h2">
    <p class="mb-6 text-left text-base leading-relaxed text-[#dbe5d3]">
      <strong class="text-[#8fd45e]">ระบบ HONGHAO</strong> ออกแบบให้สมาชิกจัดการบัญชีและธุรกรรมผ่านหน้าเว็บไซต์ได้ด้วยตนเอง ทั้ง Login ตรวจสอบเครดิต
      ฝากถอนผ่านระบบอัตโนมัติ และเลือกหมวดหมู่เกมได้ตลอด 24 ชั่วโมง หน้าเว็บไซต์รองรับทั้ง Android, iOS แท็บเล็ต และคอมพิวเตอร์ เข้าใช้งานผ่านเว็บเบราว์เซอร์ได้โดยตรง
      หากพบปัญหาเกี่ยวกับการสมัครสมาชิก การ Login เครดิตไม่เข้า ฝากถอนล่าช้า โบนัสไม่แสดง หรือไม่สามารถเข้าเกมได้ สามารถติดต่อ
      <strong class="text-[#8fd45e]">ทีมงาน HONGHAO ได้ตลอด 24 ชั่วโมง</strong> พร้อมแจ้งรายละเอียดและเวลาที่ทำรายการ เพื่อให้เจ้าหน้าที่ช่วยตรวจสอบรายการและแนะนำขั้นตอนการใช้งานต่อได้รวดเร็วยิ่งขึ้น
      ทั้งนี้ การเดิมพันมีความเสี่ยงและไม่สามารถรับประกันผลกำไรได้ ควรศึกษากติกาของแต่ละเกมและกำหนดงบประมาณให้เหมาะสมก่อนเดิมพันทุกครั้ง
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก HONGHAO"
        class="flex items-center justify-center rounded-lg bg-gradient-to-r from-[#a8e37c] via-[#62ae2d] to-[#2f6a0c] px-8 py-3 font-black text-[#060a04] shadow-[0_0_15px_rgba(98,174,45,0.28)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ HONGHAO"
        class="flex items-center justify-center rounded-lg border border-[#8fd45e]/70 bg-transparent px-8 py-3 font-bold text-[#dbe5d3] transition-all hover:scale-105 hover:border-[#f2f8ec] hover:bg-[#0d1408]/70">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
