---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็น **บทความจริง** (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login,
// /register หรือหน้าภาพแบบ /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง
// ไม่ใช่เช็กลิสต์หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้
// (src/assets/content.txt) ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าใหม่จากข้อเท็จจริง
// และคลังคำของบรีฟรอบนี้เท่านั้น (.claude/brand-spec-teva69.md §4-§5)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x5 · h3x0
//   h1  เกี่ยวกับเรา <แบรนด์> เกมพนันเบอร์ต้นๆของไทย สมัครเล่นไม่มีขั้นต่ำ
//   h2  เกมเดิมพันออนไลน์ที่ <แบรนด์> รวบรวมไว้ และข้อมูลที่ควรเปิดอ่านก่อน
//   h2  ค่ายแท้ ถูกลิขสิทธิ์ เซิร์ฟนอก และสิ่งที่ยืนยันได้จากข้อมูลจริง
//   h2  โปรโมชั่น <แบรนด์> คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%
//   h2  สมัครเล่น <แบรนด์> ไม่มีขั้นต่ำ 3 ขั้นตอน
//   h2  แอดมิน <แบรนด์> ออนไลน์ตลอด 24ชม. และช่องทางติดต่อ
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) และจาก footer จึงเปิดใช้งานอยู่
//
// 🚨🚨 ดรอปนี้ (2026-10-28) **กลับทิศจากรอบก่อน: แบรนด์ขาออกอยู่คนละหมวดธุรกิจ
// กับรอบนี้ รอบนี้เป็นเว็บเกมพนัน/คาสิโน-สล็อต** เนื้อหาทั้งหน้าจึงถูก
// **เขียนใหม่** ไม่ใช่แค่เปลี่ยนชื่อแบรนด์ บรีฟรอบนี้เรียกตัวเองว่า
// "เกมพนันเบอร์ต้นๆของไทย สมัครเล่นไม่มีขั้นต่ำ" และระบุ เกมเดิมพันออนไลน์
// หลากหลายประเภท · ค่ายแท้ ถูกลิขสิทธิ์ · เซิร์ฟนอก · ปลอดภัยในไทย ·
// โปรโมชั่นอัปเดตใหม่ตลอดสัปดาห์ · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% ·
// สมัคร 3 ขั้นตอน · แอดมินออนไลน์ตลอด 24ชม.
// ⚠️⚠️ ศัพท์หมวดธุรกิจของแบรนด์ขาออกเป็น **คำค้างข้ามแบรนด์** ห้ามหลุดกลับมา
// **รายการคำต้องห้ามเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่** เพื่อไม่ให้
// sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// 🚨🚨 **บรีฟรอบนี้ไม่พูดถึงธนาคาร วอลเลท หรือการฝากถอนเลยแม้แต่คำเดียว**
// — รอบก่อนๆ เคยมีหัวข้อ "ระบบฝากถอน" อยู่บนหน้านี้ **ถูกตัดออกและห้ามเขียนกลับ**
// 🚨🚨 **กลับทิศจากรอบก่อน: 0.3% / 0.8% รอบนี้เป็นเนื้อหาของบรีฟจริง**
// (content.txt บรรทัด 8-12) → เขียนเป็นหัวข้อและเนื้อความได้ตามปกติ
// แต่ต้องคงประโยคกำกับของบรีฟไว้ครบทุกครั้งที่อ้างถึง
// ⚠️⚠️ ชื่อแบรนด์รอบนี้เป็น **ตัวละตินพิมพ์ใหญ่ + เลข เขียนติดกันไม่มีเว้นวรรค**
// ทุกจุด interpolate จาก BRAND_NAME เพื่อไม่ให้ค้างเป็นชื่อแบรนด์ก่อนหน้าตอน
// รีแบรนด์รอบถัดไป **ห้ามพิมพ์ชื่อแบรนด์เป็น literal ในไฟล์นี้**
//
// ⚠️ **รอบนี้สองหน้าหมวดธุรกิจของแบรนด์ขาออกถูกปิด** (orchestrator ย้ายไป
// src/pages-disabled/ — ชื่อไฟล์อยู่ใน brand-spec §1 ไม่พิมพ์ซ้ำที่นี่)
// → **ไม่มี route ของสองหน้านั้นแล้ว ห้ามลิงก์ไปหาจากหน้านี้เด็ดขาด**
// route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ทดลองเล่น · /about-us · /contact-us · /terms · /privacy · /line
// ⚠️ toggle cta เปิดอยู่ → /register และ /login เป็นเมนู navbar เองแล้ว และ
// /ทางเข้า ถูกถอดออกจากเมนูด้วยเหตุผลว่ามันเป็นลิงก์ที่สามไปยังสองที่เดิม —
// หน้านี้จึงไม่วางปุ่ม "ไปหน้าทางเข้า" ซ้ำอีก (หน้ายัง route + index อยู่ตามปกติ
// และ footer ยังลิงก์ไปหาได้)
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกม ชื่อผู้ให้บริการ หน่วยงานกำกับ เลขใบอนุญาต
// ปีก่อตั้ง จำนวนสมาชิก จำนวนเกม ค่า RTP หรือยอดขั้นต่ำที่เป็นตัวเลข แม้แต่
// รายการเดียว** จึงห้ามเขียนลงหน้าเว็บ · ตัวเลขที่ขึ้นหน้าได้มีแค่ของบรีฟเอง:
// **0.3% · 0.8% · 3 ขั้นตอน · 24ชม.**
//
// 🚨 **บรีฟรอบนี้โฆษณาแล้วกำกับตัวเองในย่อหน้าเดียวกันแทบทุกย่อหน้า** — ทั้งสอง
// ครึ่งต้อง ship ครบ ประโยคกำกับไม่ใช่ filler ให้ตัดทิ้ง:
// 1) ควรตรวจสอบข้อกำหนดเกี่ยวกับยอดฝากและยอดเดิมพันของแต่ละเกม รวมถึงความ
//    น่าเชื่อถือของผู้ให้บริการก่อนใช้งาน (h1)
// 2) คำกล่าวอ้างว่าเป็นเกมถูกลิขสิทธิ์หรือมีความปลอดภัยในไทยไม่สามารถยืนยันได้
//    จากข้อความโฆษณาเพียงอย่างเดียว · ควรตรวจสอบนโยบายคุ้มครองข้อมูลส่วนบุคคล
//    และข้อกำหนดทางกฎหมายที่เกี่ยวข้องก่อนใช้งาน (h2 #2)
// 3) โปรโมชั่นแต่ละรายการอาจกำหนดประเภทเกม ยอดที่นำมาคำนวณ และข้อจำกัดการถอนเงิน
//    แตกต่างกัน · โปรโมชั่นคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการ
//    เดิมพันหรือเพิ่มโอกาสชนะในครั้งถัดไป · แม้ระบุว่าไม่จำกัด แต่ควรตรวจสอบว่ามี
//    ข้อกำหนดเกี่ยวกับจำนวนบัญชี วงเงินโบนัส หรือเงื่อนไขการถอนเงินหรือไม่ (h2 #3)
// 4) ควรตรวจสอบข้อกำหนดด้านอายุ กฎหมายที่เกี่ยวข้อง และนโยบายความเป็นส่วนตัว ·
//    ควรตรวจสอบว่าข้อความไม่มีขั้นต่ำครอบคลุมเฉพาะการสมัครสมาชิกหรือรวมถึงการ
//    ฝากเงินและการเดิมพันด้วย · ไม่เปิดเผยรหัสผ่านและรหัส OTP ให้ใครทราบ (h2 #4)
// 5) ควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชี
//    แอบอ้าง · เก็บหมายเลขรายการและหลักฐานไว้ · ตรวจสอบเวลาการให้บริการจริงจาก
//    ประกาศล่าสุดอีกครั้ง (h2 #5)
//
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) **เนื้อหาเป็นธีมสว่าง โครมเป็นผิวเข้ม**
// bg.json ของดรอปนี้คือ {"mode":"color","color":"#f0ffeb"} = **ขาวอมมิ้นต์จาง**
// (รอบก่อนเป็นขาวอมชมพูจาง คนละค่า — เปิด bg.json อ่านทุกรอบ ห้ามสืบทอด)
// **ห้าม "แก้" การ์ด/ปุ่มกลับไปเป็นพื้นมืด** — พื้นมืดบนหมึก #10280f =
// ตัวอักษรหายไปเลย ไม่ใช่แค่จางลง
// ค่าที่ใช้ได้ในไฟล์นี้: หัวข้อ/`<strong>`/marker **#116018** (7.8:1 บนการ์ดขาว) ·
// เนื้อความ #10280f (15.8:1) · หมึกรอง #3c5b36 (7.7:1) · เขียวลึก #0b4a12
// (10.5:1) · เขียวแบรนด์ #1a7d24 (5.3:1) · ทองเข้ม #8a6a0e (5.1:1) ·
// พื้นไล่เฉดปุ่มหลัก #0b4a12 -> #116018 -> #1a7d24 (**พื้นถม** + หมึกขาว #ffffff
// — 10.5 / 7.8 / 5.3:1 ต่อ stop) · ปุ่มรองเป็น #ffffff -> #e6f7df คู่กับหมึก
// #10280f · ผิวยก #e6f7df · wash #d7f0cd · เส้นอ่อน #b2dba3 · เส้นเข้ม #3f7a2e
// (**ทั้งคู่ห้ามถือตัวอักษร**)
// หมึกเนื้อความคือ #10280f (= BRAND_TEXT) ซึ่ง **ไม่ประกาศในไฟล์นี้** การ์ด
// ContentBox ตั้งไว้ให้แล้วและย่อหน้าสืบทอดลงมา
// 🚨🚨 **#28c437 บนพื้นขาวได้แค่ 2.3:1 และ #e3bb45 ได้ 2.0:1 — ห้ามเป็นสีตัวอักษร**
// สองค่านั้นเป็นไฮไลต์ของโครมเข้มเท่านั้น ปุ่มหลักจึงจบไล่เฉดที่ #1a7d24
// ออราที่อนุญาต: rgba(17,96,24,α) · rgba(11,74,18,α) · rgba(26,125,36,α) ·
// rgba(40,196,55,α) · rgba(16,40,15,α) · rgba(227,187,69,α) · rgba(11,42,18,α)
// ⚠️⚠️ **รอบนี้ไม่มีม่วง/ฟ้า/ไซแอน/แมเจนต้า/ส้มเพลิง/แดงเป็นสี UI เลยสักค่า**
// (ทั้งชุดคือพาเลตของแบรนด์ก่อนๆ) ยกเว้น **LINE green #00B900** บนปุ่ม LINE
// ซึ่งเป็นสีประจำแพลตฟอร์ม (บนผิวขาวต้องเป็นพื้นถม bg-[#00B900] + ตัวอักษรขาว)
// ⚠️⚠️ **รอบนี้เป็นแบรนด์เขียว/เงินโครเมียม และเขียวเคยเป็นฮิวนำของแบรนด์เก่า
// มาแล้วหลายเจ้า** จึงห้ามเทียบด้วยวงศ์สี ต้องเทียบ **ทีละค่า** กับตาราง
// brand-spec §2 เฮกซ์ของแบรนด์เก่าในคอมเมนต์เขียนแบบไม่มี # โดยตั้งใจ
// เพื่อไม่ให้ sweep สะดุด
// ⚠️ สูทขาว ชิปคาสิโนเขียว มงกุฎทอง ต้นไม้ในกระถาง ฉากห้องสีขาวครีม และสีผิว
// นักแสดงในอาร์ตเวิร์กเป็น **วัตถุในภาพ ไม่ใช่สี UI**
// · และ **เวิร์ดมาร์กโครเมียมเงิน-เขียวมรกตก็เป็นอาร์ตเวิร์ก ไม่ใช่สี UI**
//
// ลำดับปุ่มในไฟล์นี้สื่อด้วยพื้นถมสามขั้ว (ตรงกับคู่ปุ่มที่ล็อกไว้ใน brand-spec §2):
// · ปุ่มหลัก (สมัครสมาชิก) ไล่เฉด #0b4a12 -> #116018 -> #1a7d24 หมึกขาว #ffffff
// · ปุ่มรอง (เข้าสู่ระบบ) ไล่เฉดผิวสว่าง #ffffff -> #e6f7df หมึกเข้ม #10280f
// · ปุ่มลิงก์ภายในเป็นปุ่ม outline ขอบ #116018 ตัวอักษร #116018 บนการ์ดขาว
//   hover ยกพื้นขึ้นเป็นผิวยก #e6f7df
// · ชิปไอคอนของรายการใช้ขอบ #b2dba3 บน wash #d7f0cd ไม่ถือตัวอักษร
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง และไม่ใส่ mx-auto / max-w-* บน <p>
// เพราะการ์ดคุมความกว้างเองแล้ว — ที่ประกาศสีได้มีแค่ปุ่ม ชิปไอคอน marker ของ
// ลำดับเลข และ <strong> · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง
// เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำ
// จะขาดครึ่ง (ลบแท็ก <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิม) และห้ามวาง
// <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังใน prop ที่เป็นข้อความ และต้องเป็นไอคอนหมวดเกมพนันของรอบนี้
// slot ของ ContentBox รับ **หนึ่ง element** เท่านั้น จึงห่อด้วย <div> ชั้นเดียว
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: รูปของดรอปนี้ถูกตรึงไว้ที่อื่นครบทุกไฟล์ —
// สไลด์สองใบของดรอปถูกตรึงไว้กับ index และ /promotion · banner1 /
// banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// แบนเนอร์ใบที่สองและสาม (2026-10-23) กับสไลด์ใบที่สามและสี่ (2026-09-29)
// เป็นอาร์ตเวิร์กของแบรนด์อื่น **ห้าม import ทั้งสี่ไฟล์**
// (ชื่อไฟล์เต็มอยู่ใน brand-spec §6) (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง
// dist/ และ verify-build จะแดง) — ไฟล์ทั้งหมดยังอยู่บนดิสก์ **ห้ามลบ**
// เป็นอินเวนทอรีของแบรนด์ถัดไป · อาร์ตสต็อก gamedemo8/gamedemo16 ถูกตรึงไว้กับ
// /ทดลองเล่น
//
// Announcement รอบนี้หมุนมาเป็น AnnouncementPremium ทั้งเว็บ (brand-spec §3 —
// รอบก่อนใช้ AnnouncementHuay จึงหมุนออก) orchestrator ตั้ง default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว จึงเรียกแบบ bare **ห้ามส่ง prop message**
// มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -c บนเชลล์นี้
// ก็นับเป็นไบต์ ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับตัวนับ
// ของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 159 อักขระ (ชื่อแบรนด์รอบนี้ 6 อักขระ) เป็นประโยคเดียวที่บอกว่า
// หน้านี้มีอะไร แล้วหยุด
// (Google ตัดราว 160 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนๆ ยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} เว็บเกมพนันออนไลน์ รวมข้อมูลเกมเดิมพันหลายค่าย ระบบสมาชิกสมัครไม่มีขั้นต่ำ โปรโมชั่นคืนยอดเสียและแนะนำเพื่อน พร้อมช่องทางติดต่อแอดมิน 24ชม.`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} เกมพนันเบอร์ต้นๆของไทย สมัครเล่นไม่มีขั้นต่ำ`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

// คลาสปุ่มสามขั้วของหน้านี้ ประกาศครั้งเดียวแล้วใช้ซ้ำ เพื่อไม่ให้สองปุ่มที่ทำ
// หน้าที่เดียวกันหลุดไปคนละเฉดตอนรีแบรนด์รอบหน้า
const ctaPrimary =
  "flex items-center justify-center rounded-full border border-[#0b4a12] bg-gradient-to-b from-[#0b4a12] via-[#116018] to-[#1a7d24] px-8 py-3 font-black text-white shadow-[0_6px_18px_rgba(11,74,18,0.3)] transition-transform hover:scale-105";

const ctaSecondary =
  "flex items-center justify-center rounded-full border border-[#3f7a2e] bg-gradient-to-b from-[#ffffff] to-[#e6f7df] px-8 py-3 font-bold text-[#10280f] shadow-[0_6px_18px_rgba(40,196,55,0.25)] transition-transform hover:scale-105";

const ctaQuiet =
  "flex items-center justify-center rounded-full border-2 border-[#116018] bg-[#ffffff] px-8 py-3 font-bold text-[#116018] shadow-[0_4px_14px_rgba(17,96,24,0.2)] transition-all hover:scale-105 hover:bg-[#e6f7df] hover:shadow-[0_6px_18px_rgba(11,74,18,0.22)]";

const listChip = "mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#b2dba3] bg-[#d7f0cd] text-sm";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#116018]">{BRAND_NAME} นำเสนอข้อมูลเกมเดิมพันออนไลน์หลากหลายประเภท พร้อมรายละเอียดระบบสมาชิก โปรโมชั่น และช่องทางติดต่อเจ้าหน้าที่</strong>
        หน้านี้สรุปไว้ว่าเว็บไซต์ระบุอะไรไว้บ้าง และควรเปิดอ่านรายละเอียดส่วนไหนก่อน เพื่อให้เห็นภาพรวมก่อนไล่อ่านเงื่อนไขของแต่ละรายการเป็นรายข้อ
      </p>

      <p>
        ภายในเว็บไซต์มีข้อมูลเกมจากค่ายต่าง ๆ ให้ผู้ใช้งานศึกษากติกา รูปแบบการเดิมพัน และเงื่อนไขการใช้บริการได้จากที่เดียว
        <strong class="text-[#116018]">โดยระบุว่าสามารถสมัครสมาชิกได้โดยไม่มีขั้นต่ำ</strong>
        ซึ่งเป็นข้อมูลที่เว็บไซต์แจ้งไว้ ไม่ใช่ข้อสรุปของหน้านี้ เพราะข้อมูลแต่ละชุดถูกแยกไว้คนละหน้า และแต่ละเกมก็มีเงื่อนไขของตัวเองที่ไม่ได้เหมือนกันทั้งหมด
      </p>

      <p>
        <strong class="text-[#116018]">ทั้งนี้ ควรตรวจสอบข้อกำหนดเกี่ยวกับยอดฝากและยอดเดิมพันของแต่ละเกม รวมถึงความน่าเชื่อถือของผู้ให้บริการก่อนใช้งาน</strong>
        เนื้อหาในหน้านี้จึงเขียนไว้ประกอบการใช้งานเท่านั้น ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้บริการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`เกมเดิมพันออนไลน์ที่ ${BRAND_NAME} รวบรวมไว้ และข้อมูลที่ควรเปิดอ่านก่อน`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#116018]">{BRAND_NAME} รวบรวมข้อมูลเกมเดิมพันออนไลน์หลายประเภทไว้ในที่เดียว ซึ่งแต่ละประเภทมีกติกาและรูปแบบการเดิมพันแตกต่างกัน</strong>
        รายการด้านล่างคือข้อมูลที่เว็บไซต์เปิดให้ศึกษา และเป็นจุดเริ่มต้นสำหรับคนที่ยังไม่แน่ใจว่าควรเปิดอ่านส่วนไหนก่อน
      </p>

      <ul class="flex flex-col gap-4" aria-label="ข้อมูลที่เว็บไซต์เปิดให้ศึกษา">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎲</span>
          <span>
            <strong class="text-[#116018]">กติกาและรูปแบบการเดิมพันของแต่ละเกม</strong> เป็นส่วนที่ควรอ่านก่อนเริ่มใช้งาน เพราะเกมคนละประเภทคิดผลและคิดยอดไม่เหมือนกัน และข้อความรวมที่หน้าแรกเป็นคำอธิบายภาพรวมเท่านั้น
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🏢</span>
          <span>
            <strong class="text-[#116018]">ข้อมูลค่ายเกมและบริษัทผู้ให้บริการ</strong> คือสิ่งที่ควรตรวจจากหน้ารายละเอียดจริง ไม่ใช่จากข้อความโฆษณา เพื่อให้รู้ว่าเกมที่กำลังเปิดอยู่มาจากผู้พัฒนารายใด
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📄</span>
          <span>
            <strong class="text-[#116018]">เงื่อนไขการใช้บริการและระบบสมาชิก</strong> เป็นส่วนที่กำหนดสิทธิ์และข้อจำกัดของบัญชี จึงควรอ่านให้ครบก่อนทำรายการ ไม่ใช่หลังจากเริ่มใช้งานไปแล้ว
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#116018]">ควรตรวจสอบรายละเอียดของเกมที่เปิดให้บริการจริง รวมถึงกติกาและเงื่อนไขการใช้บริการก่อนทำรายการ</strong>
        เพราะเกมแต่ละประเภทอาจมีข้อกำหนดไม่เหมือนกัน และรายการที่เปิดให้บริการในแต่ละช่วงก็ไม่ได้ครบทุกประเภทเสมอไป
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/ทดลองเล่น" aria-label={`เปิดหน้าทดลองเล่นของ ${BRAND_NAME}`} class={ctaQuiet}>ไปหน้าทดลองเล่น</a>

        <a href="/promotion" aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`} class={ctaQuiet}>ดูภาพโปรโมชั่น</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="ค่ายแท้ ถูกลิขสิทธิ์ เซิร์ฟนอก และสิ่งที่ยืนยันได้จากข้อมูลจริง" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#116018]">{BRAND_NAME} นำเสนอข้อมูลเกมเดิมพันจากผู้พัฒนาหลายค่าย พร้อมระบุการใช้งานระบบเซิร์ฟเวอร์ต่างประเทศและการเชื่อมต่อเกมผ่านแพลตฟอร์มออนไลน์</strong>
        หัวข้อนี้จึงแยกให้ชัดระหว่างสิ่งที่เว็บไซต์ระบุไว้ กับสิ่งที่ผู้ใช้งานตรวจสอบเองได้จากหน้ารายละเอียดจริง
      </p>

      <ul class="flex flex-col gap-4" aria-label="สิ่งที่ควรตรวจสอบด้วยตัวเองก่อนใช้งาน">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🔎</span>
          <span>
            <strong class="text-[#116018]">รายชื่อค่ายเกมและข้อมูลบริษัทผู้ให้บริการ</strong> ควรตรวจสอบให้เห็นชัดว่าระบุไว้ที่ใด และตรงกับเกมที่เปิดให้บริการอยู่จริงหรือไม่
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📑</span>
          <span>
            <strong class="text-[#116018]">หลักฐานการได้รับอนุญาตอย่างชัดเจน</strong> เป็นสิ่งที่ควรตรวจสอบด้วยตัวเอง เนื่องจากคำกล่าวอ้างว่าเป็นเกมถูกลิขสิทธิ์หรือมีความปลอดภัยในไทยไม่สามารถยืนยันได้จากข้อความโฆษณาเพียงอย่างเดียว
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🔐</span>
          <span>
            <strong class="text-[#116018]">นโยบายคุ้มครองข้อมูลส่วนบุคคลและข้อกำหนดทางกฎหมายที่เกี่ยวข้อง</strong> ควรอ่านก่อนใช้งาน เพื่อให้เข้าใจว่าข้อมูลที่กรอกเข้าไปถูกจัดเก็บและใช้งานอย่างไร
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#116018]">หน้านี้จึงชี้ว่าควรอ่านอะไรและเปิดดูจากที่ไหน แทนที่จะยืนยันแทนเว็บไซต์</strong>
        เพราะสิ่งที่ยืนยันได้จริงคือเอกสารและเงื่อนไขที่แสดงอยู่บนหน้ารายละเอียดในขณะใช้บริการ ไม่ใช่ข้อความสรุปที่เขียนไว้ล่วงหน้า
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} นำเสนอข้อมูลโปรโมชั่นสำหรับสมาชิกที่อัปเดตใหม่ตลอดสัปดาห์ โดยมีรายการ
        <strong class="text-[#116018]">คืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8%</strong>
        เป็นสิทธิพิเศษที่ระบุไว้ ผู้ใช้งานสามารถติดตามรายละเอียดที่อัปเดตในแต่ละสัปดาห์ เพื่อศึกษาช่วงเวลารับสิทธิ์และเงื่อนไขการใช้เครดิตก่อนเข้าร่วม
      </p>

      <p>
        สำหรับรายการคืนยอดเสีย
        <strong class="text-[#116018]">ควรตรวจสอบประเภทเกมที่เข้าร่วม รอบเวลาคำนวณยอด และวิธีรับเครดิตให้ครบถ้วน</strong>
        เพราะยอดเดิมพันบางรายการอาจไม่เข้าเกณฑ์รับสิทธิ์ และโปรโมชั่นคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งถัดไป
      </p>

      <p>
        ส่วนรายการแนะนำเพื่อน
        <strong class="text-[#116018]">ควรตรวจสอบวิธีเชื่อมโยงบัญชีแนะนำเพื่อน ฐานยอดที่ใช้คำนวณโบนัส และรอบจ่ายเครดิตให้ชัดเจน</strong>
        แม้จะระบุว่าไม่จำกัด แต่ควรตรวจสอบว่ามีข้อกำหนดเกี่ยวกับจำนวนบัญชี วงเงินโบนัส หรือเงื่อนไขการถอนเงินหรือไม่ เพื่อให้เข้าใจรายละเอียดสิทธิ์ที่ได้รับตามประกาศจริง
      </p>

      <p>
        ทั้งนี้
        <strong class="text-[#116018]">โปรโมชั่นแต่ละรายการอาจกำหนดประเภทเกม ยอดที่นำมาคำนวณ และข้อจำกัดการถอนเงินแตกต่างกัน จึงควรตรวจสอบประกาศล่าสุดก่อนเข้าร่วมทุกครั้ง</strong>
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/promotion" aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`} class={ctaQuiet}>ดูภาพโปรโมชั่น</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`สมัครเล่น ${BRAND_NAME} ไม่มีขั้นต่ำ 3 ขั้นตอน`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#116018]">{BRAND_NAME} ระบุช่องทางสมัครสมาชิกผ่านโทรศัพท์มือถือและอุปกรณ์ที่เชื่อมต่ออินเทอร์เน็ต โดยขั้นตอนทั่วไปประกอบด้วยการเข้าสู่หน้าลงทะเบียน กรอกข้อมูล และยืนยันบัญชี</strong>
        ก่อนดำเนินการควรตรวจสอบข้อกำหนดด้านอายุ กฎหมายที่เกี่ยวข้อง และนโยบายความเป็นส่วนตัว รวมถึงตรวจสอบว่าข้อความไม่มีขั้นต่ำครอบคลุมเฉพาะการสมัครสมาชิกหรือรวมถึงการฝากเงินและการเดิมพันด้วย
      </p>

      <ol class="ml-6 list-decimal space-y-3 marker:font-black marker:text-[#116018]">
        <li>
          <strong class="text-[#116018]">เข้าสู่หน้าสมัครสมาชิก</strong> เปิดเว็บไซต์ผ่านเบราว์เซอร์บนมือถือ ตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง จากนั้นเลือกเมนูสมัครสมาชิกและอ่านข้อกำหนดการเปิดบัญชี รวมถึงรายละเอียดการใช้บริการก่อนดำเนินการ
        </li>
        <li>
          <strong class="text-[#116018]">กรอกข้อมูลและยืนยันบัญชี</strong> กรอกข้อมูลตามที่เว็บไซต์กำหนด ตรวจสอบความถูกต้องก่อนยืนยัน และตั้งรหัสผ่านที่คาดเดาได้ยาก ไม่ควรใช้ข้อมูลของบุคคลอื่นหรือเปิดเผยรหัสผ่านและรหัส
          OTP ให้ใครทราบ
        </li>
        <li>
          <strong class="text-[#116018]">เข้าสู่ระบบและตรวจสอบรายละเอียดบริการ</strong> หลังลงทะเบียนเรียบร้อย สามารถศึกษาหมวดหมู่เกม กติกาการเล่น ยอดเดิมพันขั้นต่ำ และเงื่อนไขโปรโมชั่นที่เปิดให้บริการ
          หากมีข้อสงสัยเกี่ยวกับระบบสมาชิกควรสอบถามเจ้าหน้าที่ผ่านช่องทางทางการก่อนทำรายการ
        </li>
      </ol>

