---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement4.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login, /register,
// /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx
// ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึง
// เขียนขึ้นใหม่บนข้อเท็จจริงของบรีฟรอบนี้เท่านั้น (src/assets/content.txt)
// ไม่ใช่แก้ทับประโยคเดิมของแบรนด์ก่อน — ของเดิมทั้งย่อหน้าตั้งอยู่บนคำที่
// brand-spec §7 สั่งห้าม จึงถูกเขียนใหม่ทั้งหมด
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) จึงเปิดใช้งานอยู่ และรอบนี้ operator สั่งให้
// คงไว้ ไม่ได้ park ลง src/pages-disabled/
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// ตัวที่ routing จริงคือไฟล์นี้ ตัวที่จอดไว้เป็นอินเวนทอรีของแบรนด์เก่า
// Astro ไม่อ่านโฟลเดอร์นั้นเลย ห้ามแก้และห้ามลบ
//
// ดรอปนี้ (2026-10-11) คือ **FAH999 ฟาสล็อตเว็บตรง** เป็นเว็บสล็อตล้วน ไม่ใช่เว็บ
// ของหมวดอื่น (รายการหมวดที่ห้ามเอ่ยอยู่ใน brand-spec §7 — สองหน้าของหมวดลอตเตอรี
// จอดอยู่ใน src/pages-disabled/ ไม่มี route ห้ามลิงก์ไปหา เป็น href ตายที่ทำให้
// build แดง) แง่มุมที่บรีฟระบุไว้มีเท่านี้: ทางเข้าเล่นสล็อตผ่านระบบ Login ใช้งานง่าย ·
// รองรับทั้งมือถือและคอมพิวเตอร์ · รวมเกมสล็อตหลายแนวในแพลตฟอร์มเดียว —
// สล็อตคลาสสิก เกมโบนัส ฟรีสปิน สล็อตวงล้อทั่วไป เกมที่มีฟีเจอร์พิเศษ ·
// เลือกค่าย ค้นหาเกม ตรวจสอบข้อมูลบัญชีและประวัติรายการจากบัญชีเดียว ·
// ตารางจ่าย อัตราการคืนเงินผู้เล่น ช่วงเดิมพัน · คืนยอดเสีย 0.3% เข้ายูสตามรอบ
// ประจำวัน · แนะนำเพื่อน 0.8% จากยอดที่เข้าเกณฑ์ · สมัคร 3 ขั้นตอน ยืนยันบัญชี ·
// แอดมิน 24 ชั่วโมง · ช่องทางติดต่อหลัก · PIN/OTP
//
// ⚠️ บรีฟรอบนี้ไม่ได้พูดถึงระบบฝากถอน ธนาคาร บัญชีปลายทาง หรือยอดฝากขั้นต่ำเลย
// (เอ่ยแค่ว่ามี "รายการธุรกรรมที่อยู่ระหว่างตรวจสอบ" ให้สอบถามแอดมินได้) จึงห้าม
// เขียนส่วนฝากถอนขึ้นมาเอง
//
// ⚠️ คำที่ห้ามหลงเหลือ: ศัพท์ของหมวดอื่นที่ไม่ใช่สล็อต และคำขายของของแบรนด์ก่อนๆ
// ที่บรีฟรอบนี้ไม่ได้เอ่ย — รายการเต็มอยู่ใน brand-spec §7 ไม่พิมพ์ซ้ำที่นี่ เพื่อ
// ไม่ให้ grep หาคำต้องห้ามเจอ false positive รอบนี้เขียนใหม่จากบรีฟ ไม่ได้
// find-and-replace ทับประโยคเก่า เพราะประโยคเก่าทั้งย่อหน้าตั้งอยู่บนคำเหล่านั้น
//
// ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง
// ห้ามเติมเลขใบอนุญาต หน่วยงานกำกับ ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP ยอดฝากขั้นต่ำ
// จำนวนสมาชิก หรือปีที่ก่อตั้ง เพราะบรีฟไม่ได้เอ่ยไว้สักอย่าง
//
// ประโยคกำกับที่บรีฟเขียนไว้เองและห้ามตัดทิ้งเพราะฟังดูไม่ขายของ: ควรตรวจสอบข้อมูล
// ผู้ให้บริการและค่ายเกมที่เชื่อมต่อจริงก่อนใช้งาน · ผลการหมุนเป็นแบบสุ่มและไม่มีเกมใด
// รับประกันว่าจะชนะทุกครั้ง · ควรอ่านรายละเอียดก่อนกดรับทุกครั้ง · คำว่าไม่จำกัด
// ควรระบุให้ชัดว่าหมายถึงจำนวนเพื่อน จำนวนครั้ง หรือวงเงินโบนัส · ไม่ควรเปิดเผย
// รหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น · ควรอ่านข้อกำหนดการใช้งานและตรวจสอบอายุที่
// กฎหมายอนุญาตในพื้นที่ของตน
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ชมพูฮ็อต นำ ทอง รอง บนพื้นพลัมดำ #2e002c**
// พลิกทิศจากคู่ "ทองเป็ด-ส้มอำพัน บนพื้นดำสนิท" ของแบรนด์ก่อน ซึ่งออกครบทุกจุดแล้ว
// ทั้งคลาส Tailwind raw hex และ rgba() (ค่าเดิมอยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive) รอบนี้ไม่มีส้มอำพันเป็นฮิวเลย
// ลำดับปุ่มสื่อด้วย "ชมพูถม vs ผิวจมขอบทอง": ปุ่มหลัก (สมัครสมาชิก) ถมชมพูไล่
// #ffd1ea → #ff6cbb → #ff3fa4 ขอบ #b3006a หมึกเข้ม #2b0019 — ห้ามพลิกเป็นหมึกสว่าง ·
// ปุ่มรองและปุ่มลิงก์ภายในเป็นชั้นจม #3a0534 → #210220 ขอบทอง #f5c53d/50-55
// ตัวอักษรเป็นเนื้อความ #fde8f3 (ปุ่มรอง) หรือทอง #f5c53d (ลิงก์ภายใน) ·
// #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้
// ⚠️ ปลายเข้มของไล่เฉดชมพูที่รองหมึกต้องหยุดที่ #ff3fa4 (หมึก #2b0019 บนมันได้ 5.8:1)
// ห้ามไล่ลงไปถึง #b3006a / #7a0046 / #4d002b ใต้ตัวอักษร เพราะสามตัวนั้นเป็นสีของ
// เส้นและออราเท่านั้น (#2b0019 บน #b3006a ได้แค่ 2.8:1)
// ⚠️ "ชมพู" ไม่ใช่ตัวบอกว่าถูกแบรนด์: เคยมีแบรนด์ชมพูมาก่อนแล้ว และเจ็ดในเก้าแบรนด์
// หลังสุดก็มีทอง ให้เทียบเป็นตัวๆ กับตารางแบนใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #fde8f3)
// ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง ปล่อยให้สืบทอดลงมา
// — ที่ประกาศสีได้มีแค่ปุ่ม (ถมพื้นของตัวเองจึงต้องกำหนดหมึกของตัวเอง) และ <strong>
// ซึ่ง brand-spec §2 กำหนดให้ใช้ชมพูไฮไลต์ #ff6cbb (5.7:1 บนผิวการ์ด) เป็นสี
// ไฮไลต์ในเนื้อความโดยเฉพาะ · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง
// เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้าง
// จากหน้า และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น Announcement4 ทั้งเว็บ (รอบก่อนใช้ Announcement6 —
// brand-spec §3 หมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้
// ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูด
// คนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 153
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} ฟาสล็อตเว็บตรง รวมเกมสล็อตหลายแนวไว้ในแพลตฟอร์มเดียว พร้อมโปรโมชั่นคืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% และแอดมินให้บริการตลอด 24 ชั่วโมง`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} ฟาสล็อตเว็บตรง เล่นสล็อตระบบแท้ ใช้งานง่าย`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#ff6cbb]">{BRAND_NAME} คือฟาสล็อตเว็บตรงที่นำเสนอทางเข้าเล่นสล็อตออนไลน์ผ่านระบบ Login ใช้งานง่าย</strong>
        รองรับทั้งมือถือและคอมพิวเตอร์ พร้อมรวมเกมสล็อตหลายแนวไว้ในแพลตฟอร์มเดียว ทั้งสล็อตคลาสสิก เกมโบนัส และฟรีสปิน สมาชิกเลือกค่าย ค้นหาเกม และตรวจสอบข้อมูลบัญชีได้สะดวกตลอดวันจากบัญชีเดียว
      </p>

      <p>
        หน้านี้สรุปไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่หมวดเกมและเมนูค้นหาที่จัดไว้
        <strong class="text-[#ff6cbb]">ไปจนถึงรายการโปรโมชั่นที่กดรับได้ ขั้นตอนการสมัครสมาชิก และช่องทางติดต่อแอดมินที่ระบุเวลาให้บริการตลอด 24 ชั่วโมง</strong>
        เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดดูอะไรตรงไหน แล้วจึงค่อยลงรายละเอียดของรายการที่สนใจเป็นรายรายการ
      </p>

      <p>
        <strong class="text-[#ff6cbb]">ส่วนการยืนยันว่าเป็นสล็อตระบบแท้หรือเว็บตรง ควรตรวจสอบข้อมูลผู้ให้บริการและค่ายเกมที่เชื่อมต่อจริงก่อนใช้งาน</strong>
        ข้อมูลในหน้านี้จึงเขียนไว้เพื่อบอกว่าระบบมีอะไรให้ใช้และควรตรวจอะไรก่อนตัดสินใจ ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้งาน ซึ่งเป็นค่าที่ควรยึดเป็นหลักเสมอ
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`หมวดเกมสล็อตที่ ${BRAND_NAME} รวบรวมไว้ในแพลตฟอร์มเดียว`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} ทางเข้าหลักเน้นการจัดหมวดหมู่ให้ค้นหาเกมได้สะดวก มีทั้งสล็อตวงล้อทั่วไป เกมที่มีฟีเจอร์พิเศษ และเกมโบนัสให้เลือกตามความสนใจ
        <strong class="text-[#ff6cbb]">ระบบ Login ช่วยให้สมาชิกเข้าถึงข้อมูลบัญชี ประวัติรายการ และหมวดเกมได้จากบัญชีเดียว</strong>
        พร้อมรองรับการใช้งานผ่านหน้าจอมือถือโดยไม่ต้องสลับหลายเว็บไซต์ หมวดที่เว็บไซต์ระบุไว้แบ่งออกได้ประมาณนี้ และรายการที่เปิดอยู่ในแต่ละหมวดอาจเปลี่ยนแปลงได้ตามช่วงเวลา
      </p>

      <ul class="flex flex-col gap-3" aria-label={`หมวดเกมสล็อตบนเว็บ ${BRAND_NAME}`}>
        <li class="flex gap-3">
          <span aria-hidden="true">🎰</span>
          <span>
            <strong class="text-[#ff6cbb]">สล็อตคลาสสิก</strong> เกมวงล้อรูปแบบพื้นฐานที่อ่านผลได้ตรงไปตรงมา เหมาะกับการเริ่มทำความคุ้นเคยกับระบบก่อนไล่ดูหมวดอื่น
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">🌀</span>
          <span>
            <strong class="text-[#ff6cbb]">สล็อตวงล้อทั่วไป</strong> รายการหลักที่มีให้เลือกมากที่สุด แต่ละเกมมีช่วงเดิมพันและตารางจ่ายของตัวเอง จึงควรเปิดอ่านก่อนเริ่มเล่น
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">🎁</span>
          <span>
            <strong class="text-[#ff6cbb]">เกมโบนัสและฟรีสปิน</strong> เกมที่มีรอบโบนัสหรือรอบหมุนเพิ่มเป็นฟีเจอร์ของตัวเกมเอง โดยเงื่อนไขการเข้าสู่รอบและจำนวนรอบที่ได้เป็นไปตามที่แต่ละเกมกำหนด
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">✨</span>
          <span>
            <strong class="text-[#ff6cbb]">เกมที่มีฟีเจอร์พิเศษ</strong> รายการที่เพิ่มเข้ามาตามรอบของแต่ละค่าย เป็นหมวดที่ควรเปิดดูเป็นระยะ เพราะรายชื่อที่เปิดให้เล่นไม่คงที่
          </span>
