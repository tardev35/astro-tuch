---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "รู้จัก ZORO365 คาสิโนออนไลน์อัตราจ่ายสูง รวมเกมจากค่ายชั้นนำในระบบเดียว รองรับมือถือและคอมพิวเตอร์ ฝากถอนอัตโนมัติ พร้อมทีมงานดูแลสมาชิกตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ ZORO365 คาสิโนออนไลน์อัตราจ่ายสูง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา ZORO365 คาสิโนออนไลน์อัตราจ่ายสูง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ ZORO365" as="h1">
    <p class="mb-6 text-left text-base leading-relaxed text-[#e9f7e6]">
      <strong class="text-[#4ade80]">ZORO365</strong> คือคาสิโนออนไลน์อัตราจ่ายสูงที่รวมเกมจากค่ายชั้นนำไว้ในระบบเดียว ครอบคลุมบาคาร่า รูเล็ต เกมไพ่ และเกมคาสิโนสด รองรับการเข้าใช้งานผ่านโทรศัพท์มือถือและคอมพิวเตอร์ได้โดยตรงผ่านเว็บเบราว์เซอร์ ไม่ต้องติดตั้งโปรแกรมเพิ่มเติม
    </p>

    <p class="mb-8 text-left text-base leading-relaxed text-[#e9f7e6]">
      ด้านการเงิน ระบบฝากถอนอัตโนมัติเปิดให้ทำรายการได้ด้วยตนเองตลอด 24 ชั่วโมงโดยไม่ต้องรอเจ้าหน้าที่ทีละราย และมีทีมงานคอยดูแลให้คำแนะนำตลอดการเดิมพัน เพื่อให้สมาชิกทุกคนใช้งาน ZORO365 ได้อย่างมั่นใจในทุกขั้นตอน
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก"
        class="flex items-center justify-center rounded-lg border border-[#22c55e]/60 bg-gradient-to-b from-[#4ade80] to-[#22c55e] px-8 py-3 font-bold text-white shadow-[0_10px_30px_rgba(34,197,94,0.18)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(21,128,61,0.30)]">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ"
        class="flex items-center justify-center rounded-lg border border-[#22c55e]/60 bg-[#04120a] px-8 py-3 font-extrabold text-[#e9f7e6] shadow-[0_4px_14px_rgba(34,197,94,0.18)] transition-transform hover:scale-105 hover:bg-[#0a2116]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
