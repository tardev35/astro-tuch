---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่ม) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง
// ไม่ได้มาจากเช็กลิสต์หัวข้อของ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน
// SUB-PAGES ที่ให้ body จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริงของ KINGDOM66 เท่านั้น
//
// รอบนี้ (ดรอป 2026-09-25) คือ KINGDOM66 เว็บ **คาสิโนรวมหมวด** — บาคาร่า ไพ่
// สล็อต หวย บอล และเกมไลฟ์สดจากผู้ให้บริการต่างประเทศ ส่วนคอปปี้รอบก่อนเป็นของ
// UWIN33 ซึ่งบรีฟระบุ "รูเล็ต" และ "ไฮโล" ไว้ — บรีฟของ KINGDOM66 **ไม่ได้ระบุ
// ทั้งสองอย่าง** ทั้งหน้าจึงถูกเขียนใหม่ สองหมวดนั้นถูกถอดออก และเพิ่มหัวข้อ
// "เกมไลฟ์สดจากบริษัทต่างประเทศ" ซึ่งบรีฟรอบนี้ระบุไว้จริง ห้าม find-and-replace
// ชื่อแบรนด์ทับของเก่าเด็ดขาด
//
// ข้อเท็จจริงทุกบรรทัดมาจาก src/assets/content.txt เท่านั้น: บาคาร่า · ไพ่ ·
// สล็อต · หวย · บอล · เกมไลฟ์สดจากผู้ให้บริการต่างประเทศตามรายการที่เปิดให้บริการ ·
// รวมทุกหมวดไว้ในระบบเดียว ใช้บัญชีเดียว · ระบบจัดหมวดหมู่ให้ค้นหาได้ง่าย ·
// ตรวจสอบรายละเอียดเกม ค่ายที่ให้บริการ และรูปแบบเดิมพันก่อนเข้าเล่นได้จากหน้าเดียว ·
// สิทธิ์เครดิตฟรีและโปรโมชั่นตามเงื่อนไขที่กำหนด · รองรับมือถือและคอมพิวเตอร์ ·
// โบนัสแนะนำเพื่อน 0.8% · โบนัสคืนยอดเสีย 0.3% · ตรวจสอบยอดที่เข้าเกณฑ์ รอบรับสิทธิ์
// และข้อกำหนดก่อนกดรับ · สมัครเองผ่านหน้าเว็บได้ใน 3 ขั้นตอน ·
// LINE OFFICIAL 24 ชั่วโมง
// — ห้ามอ้างชื่อค่ายเกม ชื่อสตูดิโอไลฟ์สด ชื่อเกมเฉพาะ เลขใบอนุญาต ปีที่ก่อตั้ง
// เลขทะเบียนบริษัท จำนวนสมาชิก ค่า RTP ช่องทางฝากถอนเจาะจง "ไม่มีขั้นต่ำ"
// "ออโต้ 10 วินาที" ชื่อธนาคาร หรือการันตีว่าจะชนะ เพราะบรีฟรอบนี้ไม่ได้ระบุไว้
//
// Announcement รอบนี้หมุนจาก AnnouncementPremium มาเป็น AnnouncementCyber ทั้งเว็บ —
// default message ของไฟล์นั้นเป็นคอปปี้ของ KINGDOM66 แล้ว จึงเรียกแบบ bare เหมือน
// index.astro ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ KINGDOM66 (ทองราชสำนักบนดำ ตามโลโก้ที่ KINGDOM เป็นทองสลักและ 66 เป็น
// ทองสว่าง): พื้นเพจ #050403 · ผิวการ์ด #151109 · ผิวการ์ดยก #241c13 ·
// ทองแบรนด์ #e6bf4e · ทองสว่าง #f2d683 · ทองอ่อน #f5e196 · ทองลึก #5c4113 ·
// แพลทินัมครีม #efe6cf · เนื้อความ #ebe3d3 (BRAND_TEXT) · เน้นใน strong #fdf6e0
// — พาเลตต์ทอง-โครเมียมเย็นของ UWIN33 ถูกแทนครบทุกจุดแล้ว ห้ามนำกลับมา
// (ตารางแมป old→new ดูที่ .rebrand-spec.md §2 — ห้ามพิมพ์ฮิวเก่าซ้ำไว้ในไฟล์นี้
// เพราะสคริปต์แมปพาเลตต์จะไล่แทนค่าในคอมเมนต์ด้วย) รอบนี้ไม่มีฮิวเงินเย็นเลย
// เงินโครเมียมเดิมกลายเป็นแพลทินัมครีมอุ่น #efe6cf
// ไล่สีของปุ่มหลักเดินตามโลโก้: แพลทินัมครีม → ทองสว่าง → ทองแบรนด์
// ตัวอักษรบนพื้นทองต้องเป็นดำ #1a1206 เสมอ ห้ามใช้สีขาว
// ส่วน #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ตามเดิม
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลางที่ไม่หมุนตามรอบรีแบรนด์ และรอบนี้
// orchestrator เป็นคนรีธีม) — สีเนื้อความจึงตรงกับที่การ์ดกำหนดไว้อยู่แล้ว
//
// ไม่มีลิงก์ /ตรวจหวย หรือ /แนวทาง ในหน้านี้: KINGDOM66 เป็นแบรนด์คาสิโน ไม่ใช่
// เว็บหวยเฉพาะทาง สองหน้านั้นอยู่ใน src/pages-disabled/ รอบนี้ href ที่ชี้ route
// ซึ่งไม่มีใน dist/ จะทำให้ verify-build แดง
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index และ /promotion
// ส่วน banner1/banner1-mobile เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า
// และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กค้างของลูกค้าเจ้าอื่น ห้าม import
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 158
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "เกี่ยวกับ KINGDOM66 รวมเกมคาสิโนทั้งบาคาร่า ไพ่ สล็อต หวย บอล และไลฟ์สดจากบริษัทต่างประเทศ พร้อมโปรโมชั่นแนะนำเพื่อน 0.8% คืนยอดเสีย 0.3% และแอดมิน 24 ชั่วโมง";

const pageTitle = "เกี่ยวกับเรา KINGDOM66 รวมบาคาร่า ไพ่ สล็อต หวย บอล และไลฟ์สดในบัญชีเดียว";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ebe3d3]">
        <strong class="text-[#fdf6e0]">KINGDOM66</strong> คือเว็บที่<strong class="text-[#fdf6e0]">รวมเกมคาสิโนหลายรูปแบบไว้ในระบบเดียว</strong>
        ทั้งบาคาร่า ไพ่ สล็อต หวย บอล และเกมไลฟ์สดจากผู้ให้บริการต่างประเทศตามรายการที่เปิดให้บริการ พร้อมระบบจัดหมวดหมู่ที่ค้นหาได้ง่าย รองรับการเข้าใช้งานผ่านมือถือและคอมพิวเตอร์ ช่วยให้เลือกหมวดเกมที่สนใจและจัดการบัญชีได้จากบัญชีเดียว
      </p>

      <p class="text-left text-base leading-relaxed text-[#ebe3d3]">
        หน้านี้รวบรวมไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่หมวดเกมที่เปิดให้เลือก สิทธิ์เครดิตฟรีและโปรโมชั่นที่ตรวจสอบรายละเอียดได้จากหน้าโปรโมชั่น ขั้นตอนการสมัครสมาชิก
        ไปจนถึงช่องทางสอบถามเจ้าหน้าที่เมื่อไม่แน่ใจในขั้นตอนใด
      </p>

      <p class="text-left text-base leading-relaxed text-[#ebe3d3]">
        <strong class="text-[#fdf6e0]">รายการเกม ค่ายที่ให้บริการ และเงื่อนไขของโปรโมชั่นอาจเปลี่ยนแปลงตามช่วงเวลา</strong>
        รายละเอียดทั้งหมดจึงยึดตามข้อมูลที่เว็บไซต์แสดงไว้จริงในขณะนั้นเป็นหลัก และควรตรวจสอบรายการล่าสุดจากหน้าเว็บไซต์ก่อนทำรายการทุกครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="KINGDOM66 รวมบาคาร่า ไพ่ สล็อต หวย และบอลไว้ในระบบเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ebe3d3]">
        บริการหลักของ KINGDOM66 คือ <strong class="text-[#fdf6e0]">ตัวเลือกเกมครบทั้งบาคาร่า ไพ่ สล็อต หวย และบอล</strong>
        โดยรวบรวมแต่ละหมวดไว้ในบัญชีเดียว สมาชิกจึงเลือกหมวดที่ต้องการได้จากที่เดียว ไม่ต้องสลับไปเปิดหลายเว็บไซต์เพื่อดูว่ามีอะไรให้เล่นบ้าง
      </p>

      <p class="text-left text-base leading-relaxed text-[#ebe3d3]">
        ก่อนเข้าเล่น สมาชิกสามารถ<strong class="text-[#fdf6e0]">ตรวจสอบรายละเอียดเกม ค่ายที่ให้บริการ และรูปแบบเดิมพันได้จากหน้าเดียว</strong>
        แล้วสลับไปยังหมวดที่สนใจต่อได้ง่าย ระบบจัดหมวดหมู่ไว้ให้ค้นหาได้เร็วทั้งบนมือถือและคอมพิวเตอร์
      </p>
    </div>
  </ContentBox>

  <ContentBox title="คาสิโนไลฟ์สดของ KINGDOM66 ส่งตรงจากบริษัทต่างประเทศ" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ebe3d3]">
        อีกหมวดที่แยกออกมาจากเกมทั่วไปคือ <strong class="text-[#fdf6e0]">เกมไลฟ์สดที่ถ่ายทอดมาจากผู้ให้บริการต่างประเทศตามรายการที่เปิดให้บริการ</strong>
        สมาชิกจึงวางเดิมพันไปพร้อมกับภาพที่กำลังถ่ายทอดอยู่ในรอบนั้น ซึ่งเป็นรูปแบบที่ต่างจากหมวดเกมอื่นในเว็บไซต์ที่ไม่มีการถ่ายทอดสด
      </p>

      <p class="text-left text-base leading-relaxed text-[#ebe3d3]">
        เพราะรายการในหมวดนี้ขึ้นอยู่กับค่ายที่เปิดให้บริการในแต่ละช่วง <strong class="text-[#fdf6e0]">จึงควรเปิดดูรายการที่เปิดอยู่จริงและรูปแบบเดิมพันของรายการนั้นก่อนเข้าเล่นทุกครั้ง</strong>
        ข้อมูลชุดนี้ระบบแสดงไว้ให้ตรวจสอบได้จากหน้ารวมเกมตั้งแต่ก่อนกดเข้า และเข้าถึงได้จากบัญชีเดียวกับหมวดอื่น
      </p>
    </div>
  </ContentBox>

  <ContentBox title="โปรโมชั่น KINGDOM66 แนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ebe3d3]">
        โปรโมชั่นของ KINGDOM66 <strong class="text-[#fdf6e0]">จัดสิทธิ์ให้สมาชิกเลือกตามเงื่อนไขของแต่ละรายการ</strong>
        โดยมีทั้งโบนัสแนะนำเพื่อน 0.8% สำหรับสมาชิกที่แนะนำเพื่อนเข้ามาสมัคร และโบนัสคืนยอดเสีย 0.3% ตามยอดและเงื่อนไขที่ระบบกำหนดไว้ในแต่ละรอบ
      </p>

      <p class="text-left text-base leading-relaxed text-[#ebe3d3]">
        ระบบ<strong class="text-[#fdf6e0]">แสดงยอดที่เข้าเกณฑ์ รอบรับสิทธิ์ และข้อกำหนดไว้ให้ตรวจสอบ</strong>
        สมาชิกจึงติดตามโบนัสของตัวเองในแต่ละรอบได้จากบัญชีสมาชิกโดยตรง และควรอ่านเงื่อนไขของรายการที่สนใจให้ครบก่อนกดรับทุกครั้ง เพราะแต่ละรายการมีรอบคำนวณไม่เหมือนกัน ส่วนสิทธิ์เครดิตฟรีก็ควรตรวจรายละเอียดจากหน้าเว็บไซต์ก่อนรับเช่นกัน
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/promotion"
          aria-label="ดูภาพโปรโมชั่นทั้งหมดของ KINGDOM66"
          class="flex items-center justify-center rounded-lg border border-[#e6bf4e] bg-[#151109] px-8 py-3 font-bold text-[#ebe3d3] transition-all hover:scale-105 hover:border-[#f2d683] hover:bg-[#241c13] hover:text-[#fdf6e0]">
          ดูโปรโมชั่นทั้งหมด
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="สมัครสมาชิก KINGDOM66 ด้วยตัวเองใน 3 ขั้นตอน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ebe3d3]">
        การสมัคร KINGDOM66 <strong class="text-[#fdf6e0]">ทำผ่านหน้าเว็บไซต์ได้ด้วยตัวเอง ใช้ขั้นตอนไม่ซับซ้อน</strong>
        หลังยืนยันบัญชีเรียบร้อยสามารถเข้าสู่ระบบเพื่อเลือกเกมและตรวจสอบโปรโมชั่นที่เปิดให้รับในแต่ละวันได้ทันที โดยมีขั้นตอนหลักเพียง 3 ขั้นตอนดังนี้
      </p>

      <ol class="ml-6 list-decimal space-y-2 text-left text-base leading-relaxed text-[#ebe3d3] marker:font-black marker:text-[#e6bf4e]">
        <li>เปิดหน้าสมัคร KINGDOM66 แล้วกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน</li>
        <li>ตรวจสอบข้อมูลและรายละเอียดบัญชีให้ถูกต้องก่อนกดยืนยัน</li>
        <li>ยืนยันการสมัครและเข้าสู่ระบบ จากนั้นเลือกเกมและตรวจสอบโปรโมชั่นที่เปิดให้รับได้ทันที</li>
      </ol>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก KINGDOM66"
          class="flex items-center justify-center rounded-lg border border-[#f2d683]/60 bg-gradient-to-r from-[#efe6cf] via-[#f2d683] to-[#e6bf4e] px-8 py-3 font-black text-[#1a1206] shadow-[0_0_15px_rgba(230,191,78,0.50)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ KINGDOM66"
          class="flex items-center justify-center rounded-lg border border-[#e6bf4e] bg-[#151109] px-8 py-3 font-bold text-[#ebe3d3] transition-all hover:scale-105 hover:border-[#f2d683] hover:bg-[#241c13] hover:text-[#fdf6e0]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="ใช้งาน KINGDOM66 ได้ทั้งมือถือและคอมพิวเตอร์จากบัญชีเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ebe3d3]">
