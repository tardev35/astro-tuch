---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็น **บทความจริง** (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion,
// /login, /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ใช่เช็กลิสต์หัวข้อ
// docx ที่ใช้กับ index.astro — บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน
// SUB-PAGES จึงเขียนทั้งหน้าใหม่จากข้อเท็จจริงและคลังคำของบรีฟรอบนี้เท่านั้น
// (.claude/brand-spec-slot168.md §4-§5)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x5 · h3x0
//   h1  เกี่ยวกับเรา <แบรนด์> ระบบสล็อตเว็บนอก ค่ายแท้ถูกลิขสิทธิ์
//   h2  <แบรนด์> ทางเข้าเล่นฐานเกมหลัก ไม่ผ่านเอเย่นต์100%
//   h2  เกมสล็อตและค่ายผู้พัฒนาเกมที่ <แบรนด์> รวบรวมไว้
//   h2  โปรโมชั่นสมาชิก <แบรนด์> คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%
//   h2  ระบบฝากถอน <แบรนด์> ได้ทุกธนาคารและทรูมันนี่
//   h2  ช่องทางติดต่อแอดมินเว็บ <แบรนด์> ตลอด 24ชม.
// รายการในกล่องเป็น <ul> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) และจาก footer จึงเปิดใช้งานอยู่
//
// มีสำเนาชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro (ของแบรนด์เก่ามาก)
// ตัวที่ routing จริงคือไฟล์นี้ Astro ไม่อ่านโฟลเดอร์นั้นเลย **ห้ามแก้ ห้ามลบ
// และห้ามสลับมาแทนไฟล์นี้**
//
// 🚨🚨 แกนของดรอปนี้ (2026-10-23) คือ **เว็บสล็อต** — กลับทิศจากรอบก่อนซึ่งเป็น
// เว็บหมวดเลข/สลาก บรีฟเรียกตัวเองว่า "ระบบสล็อตเว็บนอก ทางเข้าเล่นฐานเกมหลัก
// ไม่ผ่านเอเย่นต์100%" และระบุ สล็อตคลาสสิก · รอบโบนัส · สัญลักษณ์พิเศษ ·
// ค่ายแท้ถูกลิขสิทธิ์ · ฝากถอนยอดเข้าบริษัทแม่โดยตรง · คืนยอดเสีย 0.3% ·
// แนะนำเพื่อน 0.8% · ไม่จำกัด · ธนาคารและทรูมันนี่ · แอดมิน 24ชม.
// ⚠️⚠️ **แบรนด์ขาออกเป็นเว็บคนละหมวดกับรอบนี้** คำนิยามตัวเองของหมวดนั้นจึงเป็น
// คำค้างของแบรนด์ขาออก **ไม่ใช่ของรอบนี้** — **รายการคำต้องห้ามเต็มอยู่ใน
// brand-spec §5 ไม่พิมพ์ซ้ำที่นี่** เพื่อไม่ให้ sweep ของรอบถัดไปเจอ
// false positive ในคอมเมนต์ของไฟล์นี้เอง
// ⚠️⚠️ ชื่อแบรนด์รอบนี้เป็น **ภาษาไทยผสมเลข** ห้ามสะกดด้วยตัวละตินที่ไหนทั้งสิ้น
// (brand-spec §1) ทุกจุดต้อง interpolate จาก BRAND_NAME ห้ามพิมพ์ตรงๆ
//
// ⚠️ **รอบนี้สองหน้าหมวดเลข/สลากถูกปิด** (ย้ายไป src/pages-disabled/ แล้วใน P1)
// **ห้ามลิงก์ไปสอง route นั้นจากหน้านี้**
// route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ทดลองเล่น · /about-us · /contact-us · /terms · /privacy · /line
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกมรายตัว จำนวนเกม จำนวนค่าย RTP ชื่อธนาคาร
// รายตัว ชื่อผู้ให้บริการ หน่วยงานกำกับ เลขใบอนุญาต ปีก่อตั้ง จำนวนสมาชิก หรือ
// ยอดฝากขั้นต่ำที่เป็นตัวเลข แม้แต่รายการเดียว** จึงห้ามเขียนลงหน้าเว็บ ·
// ตัวเลขที่ขึ้นหน้าได้มีแค่ของบรีฟเอง: **0.3% · 0.8% · 100% (เฉพาะในวลี
// "ไม่ผ่านเอเย่นต์100%") · 24ชม.** และไม่มีจำนวนขั้นตอนที่นับเป็นข้อ
//
// 🚨 **บรีฟรอบนี้โฆษณาแล้วเบรกตัวเองในย่อหน้าเดียวกันแทบทุกย่อหน้า** — ทั้งสอง
// ครึ่งต้อง ship ครบ ประโยคเบรกไม่ใช่ filler ให้ตัดทิ้ง:
// 1) ควรตรวจสอบข้อมูลผู้ให้บริการและหลักฐานความเกี่ยวข้องกับค่ายเกมโดยตรง
//    ก่อนใช้งาน (h1 + h2 #1)
// 2) คำกล่าวอ้างว่าเป็นเกมลิขสิทธิ์แท้หรือยอดเงินเข้าบริษัทแม่โดยตรง ไม่สามารถ
//    ยืนยันได้จากข้อความโฆษณาเพียงอย่างเดียว (h2 #2 + h2 #4)
// 3) ไม่ควรตีความข้อความว่าจ่ายสูงเป็นการรับประกันผลกำไรจากเกมสล็อต · เครดิต
//    คืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาส
//    ชนะในครั้งต่อไป · แม้ระบุว่าไม่จำกัด แต่ควรยืนยันจำนวนบัญชีที่เข้าร่วม
//    รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัส (h2 #3)
// 4) หากพบชื่อบัญชีไม่ตรงกับข้อมูลทางการหรือมีการแจ้งเปลี่ยนบัญชีอย่างผิดปกติ
//    ควรหยุดทำรายการและติดต่อธนาคารหรือผู้ให้บริการชำระเงินก่อนโอนเงิน (h2 #4)
// 5) ควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยง
//    บัญชีแอบอ้าง · ไม่เปิดเผยรหัสผ่านหรือรหัส OTP · ควรตรวจสอบเวลาการให้บริการ
//    จริงจากประกาศล่าสุดอีกครั้ง (h2 #5)
//
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) เป็น **ธีมมืด แดงเจล x มุกอุ่น บนดำอมแดง**
// bg.json ของดรอปนี้คือ {"mode":"color","color":"#140000"}
// **ห้าม "แก้" กลับไปเป็นการ์ดพื้นสว่าง** และ **ห้ามให้ค่าพื้น/ค่าขอบถือตัวอักษร**
// ค่าที่ใช้ได้ในไฟล์นี้: แดงสด #fb2e33 (<strong> + ตัวอักษรปุ่ม outline — 5.1:1
// บนผิวการ์ด ถือตัวอักษรได้) · พื้นไล่เฉดปุ่มหลัก #d81115 -> #b00d11 -> #8a0608
// (**พื้นถมเท่านั้น** + หมึกขาว) · มุกอุ่น #f0e6e4 -> #c9b9b7 (**พื้นถมของปุ่มรอง
// เท่านั้น** + หมึกดำ #0a0a0a) · ขอบ #551c1e และ #7d6f6e (**ห้ามถือตัวอักษร**) ·
// ผิวจม #0b0000 และผิวยก #2a0c0d (พื้นปุ่ม/ชิป)
// หมึกเนื้อความคือ #f0e6e4 (= BRAND_TEXT) ซึ่ง **ไม่ประกาศในไฟล์นี้** การ์ด
// ContentBox ตั้งไว้ให้แล้วและย่อหน้าสืบทอดลงมา
// 🚨🚨 **ขาวบนแดงสด #fb2e33 ได้แค่ 3.8:1 — ห้ามถมพื้น #fb2e33 แล้ววางหมึกขาว**
// ปุ่มหลักจึงเริ่มไล่เฉดที่ #d81115 ไม่ใช่ #fb2e33 (5.2 / 7.2 / 10.0:1 ต่อ stop)
// ออราที่อนุญาต: rgba(251,46,51,α) · rgba(203,11,13,α) · rgba(138,6,8,α) ·
// rgba(240,230,228,α) · rgba(227,214,212,α) · rgba(0,0,0,α)
// ⚠️⚠️ **รอบนี้ไม่มีทองเลยสักเฉด** — ทองคือสีนำของแบรนด์ขาออก การปล่อยทองไว้ =
// ทั้งผิดพาเลตและหลงเหลือข้ามแบรนด์พร้อมกัน · ไม่มีโครเมียมเงินเย็น (วัสดุที่สอง
// รอบนี้เป็นมุกอุ่น R>G>B) · ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีม่วง ไม่มีส้ม ไม่มีครีม
// ไม่มีเขียว ยกเว้น **LINE green #00B900** บนปุ่ม LINE ซึ่งเป็นสีประจำแพลตฟอร์ม
// ⚠️⚠️ **รอบนี้เป็นแบรนด์แดงจริง จึงห้ามเทียบด้วยวงศ์สี** ต้องเทียบ **ทีละค่า**
// กับตาราง brand-spec §2 (fb141b และ fb1b32 ของแบรนด์อื่นห่างจาก #fb2e33 แค่ G/B
// และ 8a0609 ห่างจาก #8a0608 แค่ B1 — เจอที่ไหนแปลว่าพิมพ์ผิด เฮกซ์ของแบรนด์อื่น
// ในคอมเมนต์เขียนแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep สะดุด)
// ⚠️ คาร์ดิแกนแดง เสื้อกล้ามขาว พื้นสตูดิโอขาว มงกุฎทองเล็กในโลโก้ และสีผิว
// นักแสดงในอาร์ตเวิร์กเป็น **วัตถุในภาพ ไม่ใช่สี UI**
//
// ลำดับปุ่มในไฟล์นี้สื่อด้วยพื้นถมสามขั้ว (ตรงกับคู่ปุ่มที่ล็อกไว้ใน brand-spec §2):
// · ปุ่มหลัก (สมัครสมาชิก) ไล่เฉด #d81115 -> #b00d11 -> #8a0608 หมึก #ffffff
// · ปุ่มรอง (เข้าสู่ระบบ) ไล่เฉดมุก #f0e6e4 -> #c9b9b7 หมึก #0a0a0a
// · ปุ่มลิงก์ภายในเป็นปุ่ม outline ขอบ #fb2e33 ตัวอักษร #fb2e33 บนผิวจม #0b0000
//   hover ยกพื้นขึ้นเป็นผิวยก #2a0c0d (ตรงกับ hover ของการ์ด ContentBox)
// · ชิปไอคอนของรายการใช้ขอบ #551c1e บนผิวยก #2a0c0d ไม่ถือตัวอักษร
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง และไม่ใส่ mx-auto / max-w-* บน <p>
// เพราะการ์ดคุมความกว้างเองแล้ว — ที่ประกาศสีได้มีแค่ปุ่ม ชิปไอคอน และ <strong>
// แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรค
// ระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง (ลบแท็ก
// <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิม) และห้ามวาง <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังใน prop ที่เป็นข้อความ และต้องเป็นไอคอนหมวดสล็อต ไม่ใช่ไอคอนหมวดเลข/สลาก
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: รูปของดรอปนี้ถูกตรึงไว้ที่อื่นครบทุกไฟล์ —
// slide1/slide2 ถูกตรึงไว้กับ index §4-§5 กับ /promotion · banner1 /
// banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// banner2/banner3 (mtime 18:43) เป็นอาร์ตเวิร์กของรอบก่อน และ slide3/slide4
// (mtime 2026-09-29) เป็นของอีกแบรนด์ **ห้าม import ทั้งสี่ไฟล์**
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง) —
// ไฟล์ทั้งหมดยังอยู่บนดิสก์ **ห้ามลบ** เป็นอินเวนทอรีของแบรนด์ถัดไป
//
// Announcement รอบนี้หมุนมาเป็น Announcement5 ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ AnnouncementHuay จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้น
// เป็นคอปปี้ของแบรนด์นี้แล้ว จึงเรียกแบบ bare **ห้ามส่ง prop message** มิฉะนั้น
// ตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 157 อักขระ (ชื่อแบรนด์รอบนี้ 8 อักขระ) เป็นประโยคเดียวที่บอกว่า
// หน้านี้มีอะไร แล้วหยุด
// (Google ตัดราว 160 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} รวมข้อมูลระบบสล็อตเว็บนอก ค่ายแท้ถูกลิขสิทธิ์ โปรโมชั่นคืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% ช่องทางฝากถอนธนาคารและทรูมันนี่ และแอดมิน 24ชม.`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} ระบบสล็อตเว็บนอก ค่ายแท้ถูกลิขสิทธิ์`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

// คลาสปุ่มสามขั้วของหน้านี้ ประกาศครั้งเดียวแล้วใช้ซ้ำ เพื่อไม่ให้สองปุ่มที่ทำ
// หน้าที่เดียวกันหลุดไปคนละเฉดตอนรีแบรนด์รอบหน้า
const ctaPrimary =
  "flex items-center justify-center rounded-lg border border-[#8a0608] bg-gradient-to-b from-[#d81115] via-[#b00d11] to-[#8a0608] px-8 py-3 font-black text-white shadow-[0_6px_18px_rgba(203,11,13,0.35)] transition-transform hover:scale-105";

const ctaSecondary =
  "flex items-center justify-center rounded-lg border border-[#7d6f6e] bg-gradient-to-b from-[#f0e6e4] to-[#c9b9b7] px-8 py-3 font-bold text-[#0a0a0a] shadow-[0_6px_18px_rgba(240,230,228,0.25)] transition-transform hover:scale-105";

const ctaQuiet =
  "flex items-center justify-center rounded-lg border-2 border-[#fb2e33] bg-[#0b0000] px-8 py-3 font-bold text-[#fb2e33] shadow-[0_4px_14px_rgba(0,0,0,0.35)] transition-all hover:scale-105 hover:bg-[#2a0c0d] hover:shadow-[0_6px_18px_rgba(203,11,13,0.25)]";

const listChip = "mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#551c1e] bg-[#2a0c0d] text-sm";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#fb2e33]">{BRAND_NAME} นำเสนอข้อมูลเกมสล็อตออนไลน์จากค่ายต่างประเทศ</strong>
        พร้อมรายละเอียดระบบเกม โปรโมชั่น และช่องทางฝากถอนสำหรับสมาชิก หน้านี้รวบรวมไว้ว่าเว็บไซต์ระบุอะไรไว้บ้าง เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดอ่านอะไรตรงไหน แล้วจึงค่อยไล่อ่านรายละเอียดของแต่ละหัวข้อเป็นรายข้อ
      </p>

      <p>
        ภายในเว็บไซต์มีเมนูสำหรับศึกษากติกาเกม ตรวจสอบเงื่อนไขการเดิมพัน และเลือกดูข้อมูลค่ายเกมที่สนใจ
        <strong class="text-[#fb2e33]">โดยควรตรวจสอบความถูกต้องของข้อมูลก่อนทำรายการทุกครั้ง</strong>
        เพราะแต่ละรายการวางเงื่อนไขของตัวเองไว้คนละชุด จึงควรเปิดอ่านทีละรายการแทนการเทียบจากรายการอื่นที่เคยเปิดไว้ก่อนหน้า
      </p>

      <p>
        สิ่งที่หน้านี้ทำได้คือชี้ว่าข้อมูลแต่ละชุดอยู่ตรงไหนและควรอ่านอะไรก่อน ส่วนคำกล่าวอ้างเกี่ยวกับการเป็นทางเข้าเว็บหลักหรือไม่ผ่านเอเย่นต์
        <strong class="text-[#fb2e33]">ควรตรวจสอบข้อมูลผู้ให้บริการและหลักฐานความเกี่ยวข้องกับค่ายเกมโดยตรงก่อนใช้งาน</strong>
        เนื้อหาในหน้านี้จึงเขียนไว้ประกอบการใช้งานเท่านั้น ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้บริการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`${BRAND_NAME} ทางเข้าเล่นฐานเกมหลัก ไม่ผ่านเอเย่นต์100%`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#fb2e33]">{BRAND_NAME} ระบุตัวเองว่าเป็นระบบสล็อตเว็บนอก ทางเข้าเล่นฐานเกมหลัก ไม่ผ่านเอเย่นต์100%</strong>
        รายการด้านล่างคือสิ่งที่ควรเปิดอ่านก่อนเชื่อข้อความลักษณะนี้ เพราะเป็นคำที่ตรวจสอบได้จากข้อมูลผู้ให้บริการ ไม่ใช่จากตัวข้อความเอง
      </p>

      <ul class="flex flex-col gap-4" aria-label="สิ่งที่ควรตรวจสอบก่อนใช้งานทางเข้า">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🔎</span>
          <span>
            <strong class="text-[#fb2e33]">ข้อมูลผู้ให้บริการและหลักฐานความเกี่ยวข้องกับค่ายเกม</strong> ควรตรวจสอบโดยตรงก่อนใช้งาน เพราะนี่คือจุดที่แยกข้อความโฆษณาออกจากข้อเท็จจริงที่ยืนยันได้
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🔗</span>
          <span>
            <strong class="text-[#fb2e33]">ที่อยู่เว็บไซต์ที่เปิดอยู่ในขณะนั้น</strong> ควรตรงกับช่องทางทางการ และควรตรวจการเชื่อมต่อให้ถูกต้องก่อนกรอกข้อมูลใด ๆ ที่ปลายทาง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🧩</span>
          <span>
            <strong class="text-[#fb2e33]">กติกาเกมและเงื่อนไขการเดิมพันของรายการที่จะเล่น</strong> ควรอ่านจากหน้าของรายการนั้นเอง เพราะแต่ละเกมกำหนดรูปแบบการจ่ายรางวัลไว้คนละแบบ
          </span>
        </li>
      </ul>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/ทางเข้า" aria-label={`เปิดหน้าทางเข้าของ ${BRAND_NAME}`} class={ctaQuiet}>ไปหน้าทางเข้า</a>

        <a href="/ทดลองเล่น" aria-label={`เปิดหน้าทดลองเล่นของ ${BRAND_NAME}`} class={ctaQuiet}>ไปหน้าทดลองเล่น</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`เกมสล็อตและค่ายผู้พัฒนาเกมที่ ${BRAND_NAME} รวบรวมไว้`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#fb2e33]">{BRAND_NAME} นำเสนอเกมสล็อตจากค่ายต่าง ๆ ที่มีรูปแบบการเล่นและฟีเจอร์แตกต่างกัน</strong>
        รายการด้านล่างคือรูปแบบที่ระบุไว้ และควรไล่อ่านให้ครบก่อนเลือกเกมที่จะเล่น เพราะแต่ละรูปแบบใช้เงื่อนไขการจ่ายรางวัลของตัวเอง
      </p>

      <ul class="flex flex-col gap-4" aria-label="รูปแบบเกมสล็อตที่ระบุไว้">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎰</span>
          <span>
            <strong class="text-[#fb2e33]">สล็อตคลาสสิก</strong> เป็นรูปแบบพื้นฐานที่อ่านผลจากแนวการเรียงสัญลักษณ์ตรงไปตรงมา จึงควรดูจำนวนแนวที่เปิดใช้งานของเกมนั้นก่อนหมุน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎁</span>
          <span>
            <strong class="text-[#fb2e33]">เกมที่มีรอบโบนัส</strong> จะเข้าสู่รอบพิเศษตามเงื่อนไขของเกม ควรอ่านว่ารอบนั้นเริ่มจากอะไรและคำนวณผลด้วยวิธีใด ก่อนตั้งวงเงินที่จะใช้
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>✨</span>
          <span>
            <strong class="text-[#fb2e33]">เกมที่ใช้สัญลักษณ์พิเศษในการจ่ายรางวัล</strong> กำหนดบทบาทของสัญลักษณ์แต่ละตัวไว้ในกติกาของเกมเอง จึงควรเปิดอ่านจากหน้ากติกา ไม่ใช่สรุปจากเกมอื่นที่เคยเล่น
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📄</span>
          <span>
            <strong class="text-[#fb2e33]">รายชื่อค่ายผู้พัฒนาและหลักฐานการได้รับอนุญาตให้บริการเกม</strong> เป็นสิ่งที่ผู้ใช้งานควรตรวจสอบเอง รวมถึงข้อมูลบริษัทและชื่อบัญชีรับเงินก่อนทำธุรกรรม
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#fb2e33]">คำกล่าวอ้างว่าเป็นเกมลิขสิทธิ์แท้หรือยอดเงินเข้าบริษัทแม่โดยตรง ไม่สามารถยืนยันได้จากข้อความโฆษณาเพียงอย่างเดียว</strong>
        จึงควรยึดข้อมูลที่ตรวจสอบได้จากผู้ให้บริการและจากค่ายผู้พัฒนาเกมเป็นหลัก มากกว่าถ้อยคำที่ปรากฏบนหน้าโฆษณา
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`โปรโมชั่นสมาชิก ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} นำเสนอข้อมูลโปรโมชั่นสำหรับสมาชิกที่ต้องการศึกษาสิทธิพิเศษจากการใช้บริการ โดยมีรายการ
        <strong class="text-[#fb2e33]">คืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8%</strong>
        เป็นโปรโมชั่นหลักที่ระบุไว้ แต่ละรายการอาจมีข้อกำหนดเกี่ยวกับประเภทเกม ยอดที่นำมาคำนวณ รอบเวลารับเครดิต และเงื่อนไขการถอนเงินแตกต่างกัน จึงควรตรวจสอบประกาศล่าสุดก่อนเข้าร่วม
      </p>

      <p>
        รายการคืนยอดเสียระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขรายวัน
        <strong class="text-[#fb2e33]">สมาชิกควรตรวจสอบว่าเกมสล็อตประเภทใดเข้าร่วมรายการ มีรอบสรุปยอดเวลาใด และต้องกดรับเครดิตด้วยตนเองหรือระบบดำเนินการให้อัตโนมัติ</strong>
        เพราะยอดเสียบางรายการอาจไม่เข้าเกณฑ์รับสิทธิ์ ทั้งนี้ เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งต่อไป
      </p>

      <p>
        ส่วนรายการแนะนำเพื่อนระบุสิทธิ์ไว้สำหรับสมาชิกที่แนะนำผู้ใช้งานรายใหม่ โดยควรตรวจสอบวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และฐานยอดที่ใช้คำนวณโบนัสให้ชัดเจน
        <strong class="text-[#fb2e33]">แม้จะมีข้อความว่าไม่จำกัด แต่ควรยืนยันจำนวนบัญชีที่เข้าร่วมได้ รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุด</strong>
        เพื่อป้องกันความเข้าใจคลาดเคลื่อนเกี่ยวกับจำนวนเครดิตที่มีสิทธิ์ได้รับ และไม่ควรตีความข้อความว่าจ่ายสูงเป็นการรับประกันผลกำไรจากเกมสล็อต
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/promotion" aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`} class={ctaQuiet}>ดูภาพโปรโมชั่น</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`ระบบฝากถอน ${BRAND_NAME} ได้ทุกธนาคารและทรูมันนี่`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#fb2e33]">{BRAND_NAME} ระบุช่องทางฝากถอนผ่านธนาคารและทรูมันนี่ พร้อมข้อความว่าฝากถอนยอดเข้าบริษัทแม่โดยตรง</strong>
        เพื่อให้สมาชิกตรวจสอบวิธีทำรายการตามบริการที่เปิดใช้งานจริง รายการด้านล่างคือสิ่งที่ควรเปิดอ่านก่อนทำรายการครั้งแรก และควรตรวจซ้ำทุกครั้งที่กลับเข้ามาใหม่
      </p>

      <ul class="flex flex-col gap-4" aria-label="สิ่งที่ควรตรวจสอบก่อนฝากถอน">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>💳</span>
          <span>
            <strong class="text-[#fb2e33]">รายชื่อธนาคารที่รองรับและยอดขั้นต่ำ</strong> ควรดูจากบริการที่เว็บไซต์เปิดใช้งานอยู่จริงในขณะนั้น ไม่ใช่จากข้อความที่สรุปไว้สั้น ๆ เพียงบรรทัดเดียว
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🏦</span>
          <span>
            <strong class="text-[#fb2e33]">ชื่อบัญชีปลายทาง</strong> ควรตรงกับข้อมูลผู้ให้บริการที่ยืนยันได้ เพราะนี่คือจุดที่แยกการทำรายการตามปกติออกจากบัญชีแอบอ้างได้เร็วที่สุด
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>⏱️</span>
          <span>
            <strong class="text-[#fb2e33]">ระยะเวลาดำเนินการและข้อกำหนดการถอนเงิน</strong> ควรศึกษาให้ครบถ้วนก่อนทำธุรกรรม เพราะรายการที่มียอดสูงอาจต้องผ่านขั้นตอนตรวจสอบเพิ่มเติม
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#fb2e33]">หากพบชื่อบัญชีไม่ตรงกับข้อมูลทางการหรือมีการแจ้งเปลี่ยนบัญชีอย่างผิดปกติ ควรหยุดทำรายการทันที</strong>
        แล้วติดต่อธนาคารหรือผู้ให้บริการชำระเงินเพื่อตรวจสอบก่อนโอนเงิน เพราะเงื่อนไขที่แสดงอยู่ ณ เวลาทำรายการคือเงื่อนไขที่มีผลจริง
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/register" aria-label={`สมัครสมาชิก ${BRAND_NAME}`} class={ctaPrimary}>สมัครสมาชิก</a>

        <a href="/login" aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`} class={ctaSecondary}>เข้าสู่ระบบ</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`ช่องทางติดต่อแอดมินเว็บ ${BRAND_NAME} ตลอด 24ชม.`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} ระบุช่องทางติดต่อเจ้าหน้าที่สำหรับผู้ใช้งานที่ต้องการสอบถามเกี่ยวกับการเข้าสู่ระบบ รายชื่อค่ายเกม รายการฝากถอน และรายละเอียดโปรโมชั่น
        <strong class="text-[#fb2e33]">โดยควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง</strong>
        หากพบปัญหาเกี่ยวกับธุรกรรม ควรเก็บหมายเลขรายการและหลักฐานที่เกี่ยวข้องไว้สำหรับตรวจสอบ พร้อมแจ้งรายละเอียดปัญหาให้ชัดเจน โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP
      </p>

      <p>
        <strong class="text-[#fb2e33]">ทั้งนี้ ควรตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุดอีกครั้ง</strong>
        เพราะช่วงเวลาที่เจ้าหน้าที่รับเรื่องอาจปรับเปลี่ยนได้ตามที่ผู้ให้บริการกำหนด และระยะเวลาตอบกลับของแต่ละช่องทางอาจไม่เท่ากัน
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/line"
          aria-label={`ติดต่อเจ้าหน้าที่ ${BRAND_NAME} ผ่าน Line Official`}
          class="flex items-center justify-center gap-2 rounded-lg border border-[#00B900] bg-[#00B900] px-8 py-3 font-black text-white shadow-[0_0_15px_rgba(0,185,0,0.35)] transition-transform hover:scale-105">
          <span aria-hidden="true">💬</span>
          ติดต่อผ่าน Line Official
        </a>

