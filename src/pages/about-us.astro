---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็น **บทความจริง** (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login,
// /register หรือหน้าภาพแบบ /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง
// ไม่ใช่เช็กลิสต์หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้
// (src/assets/content.txt) ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าใหม่จากข้อเท็จจริง
// และคลังคำของบรีฟรอบนี้เท่านั้น (.claude/brand-spec-lotto189.md §4-§5)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x5 · h3x0
//   h1  เกี่ยวกับเรา <แบรนด์> เว็บหวยลอตโต้ แทงหวยออนไลน์ทุกประเภท
//   h2  ประเภทหวยที่ <แบรนด์> รวบรวมไว้ ทั้งรัฐบาลไทย ลาว ฮานอย และหุ้นต่างประเทศ
//   h2  จ่ายเต็ม จ่ายสด รับทุกเลข ไม่มีอั้นเลข และสิ่งที่ควรตรวจก่อนยืนยันบิล
//   h2  อัตราจ่ายของ <แบรนด์> 2 ตัว 100 และ 3 ตัว 1,000
//   h2  วิธีสมัครแทงหวย <แบรนด์> ด้วยมือถือ 3 ขั้นตอน
//   h2  แอดมินออนไลน์ตลอด 24ชม. และช่องทางติดต่อของ <แบรนด์>
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) และจาก footer จึงเปิดใช้งานอยู่
//
// 🚨🚨 ดรอปนี้ (2026-10-27) **กลับทิศจากรอบก่อน: จากเว็บสล็อต (ZNOVA168) มาเป็น
// เว็บหวย/ลอตโต้** เนื้อหาทั้งหน้าจึงถูก **เขียนใหม่** ไม่ใช่แค่เปลี่ยนชื่อแบรนด์
// บรีฟรอบนี้เรียกตัวเองว่า "แนะนำเว็บหวยลอตโต้ แทงหวยจ่ายสด รับทุกเลข ไม่มีอั้น"
// และระบุ หวยรัฐบาลไทย · หวยลาว · หวยฮานอย · หวยหุ้นต่างประเทศ · จ่ายเต็ม จ่ายสด ·
// รับทุกเลข ไม่มีอั้นเลข · อัตราจ่าย 2 ตัว 100 และ 3 ตัว 1,000 ·
// สมัครด้วยมือถือ 3 ขั้นตอน · แอดมินออนไลน์ตลอด 24ชม.
// ⚠️⚠️ ศัพท์หมวดสล็อตของแบรนด์ขาออกเป็น **คำค้างข้ามแบรนด์** ห้ามหลุดกลับมา
// **รายการคำต้องห้ามเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่** เพื่อไม่ให้
// sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// 🚨🚨 **บรีฟรอบนี้ไม่พูดถึงธนาคาร วอลเลท การฝากถอน หรือโปรโมชั่นเลยแม้แต่คำเดียว**
// — รอบก่อนๆ เคยมีทั้งหัวข้อ "ระบบฝากถอน" และหัวข้อโปรโมชั่นอยู่บนหน้านี้
// **ทั้งหมดถูกตัดออกและห้ามเขียนกลับเข้ามา**
// 🚨🚨 **0.3% / 0.8% พิมพ์อยู่บนสไลด์จริง แต่เป็นคอปปี้ของ ZNOVA168 รอบก่อน**
// → เขียนได้เฉพาะใน alt ของ /promotion เท่านั้น **ห้ามอยู่บนหน้านี้เลยสักจุด**
// ⚠️⚠️ ชื่อแบรนด์รอบนี้เป็น **ตัวละตินพิมพ์ใหญ่ + เลข เขียนติดกันไม่มีเว้นวรรค**
// ทุกจุด interpolate จาก BRAND_NAME เพื่อไม่ให้ค้างเป็นชื่อแบรนด์ก่อนหน้าตอน
// รีแบรนด์รอบถัดไป **ห้ามพิมพ์ชื่อแบรนด์เป็น literal ในไฟล์นี้**
//
// ⚠️ **รอบนี้สองหน้าหมวดหวยถูกเปิดใช้งาน** (orchestrator ย้ายกลับเข้า src/pages/)
// → /ตรวจหวย และ /แนวทาง **มี route จริง ลิงก์ไปได้**
// route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ทดลองเล่น · /about-us · /contact-us · /ตรวจหวย · /แนวทาง · /terms ·
// /privacy · /line
// ⚠️ toggle cta เปิดอยู่ → /register และ /login เป็นเมนู navbar เองแล้ว และ
// /ทางเข้า ถูกถอดออกจากเมนูด้วยเหตุผลว่ามันเป็นลิงก์ที่สามไปยังสองที่เดิม —
// หน้านี้จึงไม่วางปุ่ม "ไปหน้าทางเข้า" ซ้ำอีก (หน้ายัง route + index อยู่ตามปกติ
// และ footer ยังลิงก์ไปหาได้)
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อผู้ให้บริการ หน่วยงานกำกับ เลขใบอนุญาต ปีก่อตั้ง
// จำนวนสมาชิก เวลาเปิด-ปิดรับเป็นตัวเลข หรือยอดเดิมพันขั้นต่ำที่เป็นตัวเลข
// แม้แต่รายการเดียว** จึงห้ามเขียนลงหน้าเว็บ · ตัวเลขที่ขึ้นหน้าได้มีแค่ของบรีฟเอง:
// **2 ตัว 100 · 3 ตัว 1,000 · 3 ขั้นตอน · 24ชม.**
//
// 🚨 **บรีฟรอบนี้โฆษณาแล้วกำกับตัวเองในย่อหน้าเดียวกันแทบทุกย่อหน้า** — ทั้งสอง
// ครึ่งต้อง ship ครบ ประโยคกำกับไม่ใช่ filler ให้ตัดทิ้ง:
// 1) ผลการออกรางวัลมีความไม่แน่นอนและไม่สามารถคาดการณ์ได้อย่างแม่นยำ (h1)
// 2) ควรตรวจสอบข้อจำกัดการรับหมายเลข วงเงินเดิมพันสูงสุด และเงื่อนไขการจ่ายรางวัล
//    ของแต่ละประเภทให้ชัดเจนก่อนยืนยันบิล (h2 #1 + #2)
// 3) ควรตรวจสอบว่าอัตราดังกล่าวคำนวณจากเงินเดิมพันจำนวนเท่าใด ใช้กับหวยประเภทใด
//    และวงเงินจ่ายสูงสุดเท่าใด · ผลการออกรางวัลไม่สามารถรับประกันได้จากสถิติหรือ
//    เลขย้อนหลัง (h2 #3)
// 4) ควรตรวจสอบข้อกำหนดด้านอายุ กฎหมายที่เกี่ยวข้อง และนโยบายความเป็นส่วนตัว ·
//    ไม่เปิดเผยรหัสผ่านและรหัส OTP ให้ใครทราบ (h2 #4)
// 5) ควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชี
//    แอบอ้าง · เก็บหมายเลขรายการและหลักฐานไว้ · ตรวจสอบเวลาการให้บริการจริงจาก
//    ประกาศล่าสุดอีกครั้ง (h2 #5)
//
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) **เนื้อหาเป็นธีมสว่าง โครมเป็นผิวเข้ม**
// bg.json ของดรอปนี้คือ {"mode":"color","color":"#fff0f0"} = **ขาวอมชมพูจาง**
// (รอบก่อนเป็นครีมอมงาช้างอุ่น คนละค่า — เปิด bg.json อ่านทุกรอบ ห้ามสืบทอด)
// **ห้าม "แก้" การ์ด/ปุ่มกลับไปเป็นพื้นมืด** — พื้นมืดบนหมึก #25090f =
// ตัวอักษรหายไปเลย ไม่ใช่แค่จางลง
// ค่าที่ใช้ได้ในไฟล์นี้: หัวข้อ/`<strong>`/marker **#b00718** (7.3:1 บนการ์ดขาว) ·
// เนื้อความ #25090f (18.7:1) · หมึกรอง #6e3b44 (8.8:1) · แดงแบรนด์ #c1071b
// (6.6:1) · แดงลึก #8a0412 (10.4:1) · ทองเข้ม #8f6310 (5.3:1) ·
// พื้นไล่เฉดปุ่มหลัก #8a0412 -> #b00718 -> #d61023 (**พื้นถม** + หมึกขาว #ffffff
// — 10.4 / 7.3 / 5.3:1 ต่อ stop) · ปุ่มรองเป็น #ffffff -> #ffe4e6 คู่กับหมึก
// #25090f · ผิวยก #ffe4e6 · wash #ffd4d7 · เส้นอ่อน #f5b9bd · เส้นเข้ม #a8333f
// (**ทั้งคู่ห้ามถือตัวอักษร**)
// หมึกเนื้อความคือ #25090f (= BRAND_TEXT) ซึ่ง **ไม่ประกาศในไฟล์นี้** การ์ด
// ContentBox ตั้งไว้ให้แล้วและย่อหน้าสืบทอดลงมา
// 🚨🚨 **#ff2436 บนพื้นขาวได้แค่ 3.9:1 และ #e9b53c ได้ 2.0:1 — ห้ามเป็นสีตัวอักษร**
// สองค่านั้นเป็นไฮไลต์ของโครมเข้มเท่านั้น ปุ่มหลักจึงจบไล่เฉดที่ #d61023
// ออราที่อนุญาต: rgba(138,4,18,α) · rgba(176,7,24,α) · rgba(193,7,27,α) ·
// rgba(214,16,35,α) · rgba(37,9,15,α) · rgba(245,185,189,α)
// ⚠️⚠️ **รอบนี้ไม่มีม่วง/ฟ้า/ไซแอน/แมเจนต้า/ส้มเพลิง/เขียวแบรนด์เลยสักค่า**
// (ทั้งชุดคือพาเลตของแบรนด์ก่อนๆ) ยกเว้น **LINE green #00B900** บนปุ่ม LINE
// ซึ่งเป็นสีประจำแพลตฟอร์ม (บนผิวขาวต้องเป็นพื้นถม bg-[#00B900] + ตัวอักษรขาว)
// ⚠️⚠️ **รอบนี้เป็นแบรนด์แดง/ทอง/ครีม และตระกูลนี้ผ่าน template มาแล้วสิบกว่าเจ้า
// จึงห้ามเทียบด้วยวงศ์สี** ต้องเทียบ **ทีละค่า** กับตาราง brand-spec §2
// เฮกซ์ของแบรนด์เก่าในคอมเมนต์เขียนแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep สะดุด
// ⚠️ สูทขาว เก้าอี้อาร์มแชร์ขอบทอง ลูกบอลหวย โพยหวย ปากกาทอง ฉากห้องสีขาวครีม
// และสีผิวนักแสดงในอาร์ตเวิร์กเป็น **วัตถุในภาพ ไม่ใช่สี UI**
// · และ **เวิร์ดมาร์กโครเมียมเงินตัดขอบแดงก็เป็นอาร์ตเวิร์ก ไม่ใช่สี UI**
//
// ลำดับปุ่มในไฟล์นี้สื่อด้วยพื้นถมสามขั้ว (ตรงกับคู่ปุ่มที่ล็อกไว้ใน brand-spec §2):
// · ปุ่มหลัก (สมัครสมาชิก) ไล่เฉด #8a0412 -> #b00718 -> #d61023 หมึกขาว #ffffff
// · ปุ่มรอง (เข้าสู่ระบบ) ไล่เฉดผิวสว่าง #ffffff -> #ffe4e6 หมึกเข้ม #25090f
// · ปุ่มลิงก์ภายในเป็นปุ่ม outline ขอบ #b00718 ตัวอักษร #b00718 บนการ์ดขาว
//   hover ยกพื้นขึ้นเป็นผิวยก #ffe4e6
// · ชิปไอคอนของรายการใช้ขอบ #f5b9bd บน wash #ffd4d7 ไม่ถือตัวอักษร
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง และไม่ใส่ mx-auto / max-w-* บน <p>
// เพราะการ์ดคุมความกว้างเองแล้ว — ที่ประกาศสีได้มีแค่ปุ่ม ชิปไอคอน marker ของ
// ลำดับเลข และ <strong> · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง
// เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำ
// จะขาดครึ่ง (ลบแท็ก <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิม) และห้ามวาง
// <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังใน prop ที่เป็นข้อความ และต้องเป็นไอคอนหมวดหวย ไม่ใช่ไอคอนหมวดสล็อต
// slot ของ ContentBox รับ **หนึ่ง element** เท่านั้น จึงห่อด้วย <div> ชั้นเดียว
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: รูปของดรอปนี้ถูกตรึงไว้ที่อื่นครบทุกไฟล์ —
// slide1 ถูกตรึงไว้กับ index §4 ข้อ 6 · slide1/slide2 กับ /promotion ·
// banner1 / banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้าง
// จากหน้า · แบนเนอร์ใบที่สองและสาม (2026-10-23) กับสไลด์ใบที่สามและสี่
// (2026-09-29) เป็นอาร์ตเวิร์กของแบรนด์อื่น **ห้าม import ทั้งสี่ไฟล์**
// (ชื่อไฟล์เต็มอยู่ใน brand-spec §6) (ลำพังการ import ก็ทำให้
// ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง) — ไฟล์ทั้งหมดยังอยู่บนดิสก์
// **ห้ามลบ** เป็นอินเวนทอรีของแบรนด์ถัดไป · อาร์ตสต็อก gamedemo8/gamedemo16
// ถูกตรึงไว้กับ /ทดลองเล่น
//
// Announcement รอบนี้หมุนมาเป็น AnnouncementHuay ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ Announcement2 จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็น
// คอปปี้ของแบรนด์นี้แล้ว จึงเรียกแบบ bare **ห้ามส่ง prop message** มิฉะนั้นตัววิ่ง
// จะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -c บนเชลล์นี้
// ก็นับเป็นไบต์ ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับตัวนับ
// ของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 157 อักขระ (ชื่อแบรนด์รอบนี้ 8 อักขระ) เป็นประโยคเดียวที่บอกว่า
// หน้านี้มีอะไร แล้วหยุด
// (Google ตัดราว 160 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนๆ ยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} เว็บหวยลอตโต้ รวมข้อมูลหวยรัฐบาลไทย หวยลาว หวยฮานอย หวยหุ้นต่างประเทศ อัตราจ่าย 2 ตัว 100 และ 3 ตัว 1,000 วิธีสมัครด้วยมือถือ 3 ขั้นตอน`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} เว็บหวยลอตโต้ แทงหวยออนไลน์ทุกประเภท`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

// คลาสปุ่มสามขั้วของหน้านี้ ประกาศครั้งเดียวแล้วใช้ซ้ำ เพื่อไม่ให้สองปุ่มที่ทำ
// หน้าที่เดียวกันหลุดไปคนละเฉดตอนรีแบรนด์รอบหน้า
const ctaPrimary =
  "flex items-center justify-center rounded-full border border-[#8a0412] bg-gradient-to-b from-[#8a0412] via-[#b00718] to-[#d61023] px-8 py-3 font-black text-white shadow-[0_6px_18px_rgba(138,4,18,0.3)] transition-transform hover:scale-105";

const ctaSecondary =
  "flex items-center justify-center rounded-full border border-[#a8333f] bg-gradient-to-b from-[#ffffff] to-[#ffe4e6] px-8 py-3 font-bold text-[#25090f] shadow-[0_6px_18px_rgba(245,185,189,0.65)] transition-transform hover:scale-105";

const ctaQuiet =
  "flex items-center justify-center rounded-full border-2 border-[#b00718] bg-[#ffffff] px-8 py-3 font-bold text-[#b00718] shadow-[0_4px_14px_rgba(176,7,24,0.2)] transition-all hover:scale-105 hover:bg-[#ffe4e6] hover:shadow-[0_6px_18px_rgba(138,4,18,0.22)]";

const listChip = "mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#f5b9bd] bg-[#ffd4d7] text-sm";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#b00718]">{BRAND_NAME} นำเสนอข้อมูลหวยออนไลน์หลายประเภท ทั้งหวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยหุ้นต่างประเทศ</strong>
        หน้านี้สรุปไว้ว่าเว็บไซต์ระบุอะไรไว้บ้าง และควรเปิดอ่านรายละเอียดส่วนไหนก่อน เพื่อให้เห็นภาพรวมก่อนไล่อ่านเงื่อนไขของแต่ละรายการเป็นรายข้อ
      </p>

      <p>
        ภายในเว็บไซต์รวบรวมรายละเอียดอัตราจ่าย รอบประกาศผล และช่องทางติดต่อเจ้าหน้าที่ไว้ในช่องทางเดียว
        <strong class="text-[#b00718]">ผู้ใช้งานสามารถศึกษารูปแบบการเลือกหมายเลข ตรวจสอบเงื่อนไขการเดิมพัน และติดตามข้อมูลผลรางวัลได้</strong>
        โดยเฉพาะผู้ที่เพิ่งเริ่มต้นและต้องการทำความเข้าใจระบบก่อน เพราะข้อมูลแต่ละชุดถูกแยกไว้คนละหน้า และแต่ละรายการก็มีเงื่อนไขของตัวเองที่ไม่ได้เหมือนกันทั้งหมด
      </p>

      <p>
        <strong class="text-[#b00718]">ควรตรวจสอบความถูกต้องของข้อมูลและข้อกำหนดก่อนทำรายการ เนื่องจากผลการออกรางวัลมีความไม่แน่นอนและไม่สามารถคาดการณ์ได้อย่างแม่นยำ</strong>
        เนื้อหาในหน้านี้จึงเขียนไว้ประกอบการใช้งานเท่านั้น ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้บริการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`ประเภทหวยที่ ${BRAND_NAME} รวบรวมไว้ ทั้งรัฐบาลไทย ลาว ฮานอย และหุ้นต่างประเทศ`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#b00718]">{BRAND_NAME} รวบรวมข้อมูลหวยหลากหลายประเภทไว้ในที่เดียว ซึ่งแต่ละรายการมีวันประกาศผลและรูปแบบการเดิมพันแตกต่างกัน</strong>
        รายการด้านล่างคือกลุ่มที่เว็บไซต์ระบุไว้ และเป็นจุดเริ่มต้นสำหรับคนที่ยังไม่แน่ใจว่าควรเปิดอ่านรายละเอียดของรายการแบบไหนก่อน
      </p>

      <ul class="flex flex-col gap-4" aria-label="ประเภทหวยที่เว็บไซต์ระบุไว้">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🏛️</span>
          <span>
            <strong class="text-[#b00718]">หวยรัฐบาลไทย</strong> เป็นรายการที่รอบประกาศผลอ้างอิงจากการออกรางวัลอย่างเป็นทางการ จึงควรตรวจรอบปิดรับของเว็บไซต์เทียบกับรอบออกรางวัลจริงทุกครั้ง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🗓️</span>
          <span>
            <strong class="text-[#b00718]">หวยลาว และหวยฮานอย</strong> เป็นรายการที่มีรอบประกาศผลถี่กว่า จุดที่ควรอ่านก่อนคือวันและเวลาที่เปิดรับของแต่ละรอบ และรูปแบบการเดิมพันที่รายการนั้นรองรับ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📈</span>
          <span>
            <strong class="text-[#b00718]">หวยหุ้นต่างประเทศ</strong> อ้างอิงผลจากตลาดที่เปิดทำการคนละช่วงเวลา จึงเป็นกลุ่มที่รอบปิดรับและแหล่งอ้างอิงผลรางวัลต้องตรวจให้ชัดที่สุดก่อนยืนยันบิล
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#b00718]">ควรตรวจสอบรายการที่เปิดให้บริการจริง รวมถึงรอบปิดรับและแหล่งอ้างอิงผลรางวัลก่อนทำรายการ</strong>
        เพราะหวยแต่ละประเภทอาจมีข้อกำหนดไม่เหมือนกัน และรายการที่เปิดรับในแต่ละวันก็ไม่ได้ครบทุกประเภทเสมอไป
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/ตรวจหวย" aria-label={`เปิดหน้าตรวจหวยของ ${BRAND_NAME}`} class={ctaQuiet}>ไปหน้าตรวจหวย</a>

        <a href="/แนวทาง" aria-label={`เปิดหน้าแนวทางของ ${BRAND_NAME}`} class={ctaQuiet}>ไปหน้าแนวทาง</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="จ่ายเต็ม จ่ายสด รับทุกเลข ไม่มีอั้นเลข และสิ่งที่ควรตรวจก่อนยืนยันบิล" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#b00718]">เว็บไซต์ระบุว่ารับทุกเลข ไม่มีเลขอั้น และจ่ายเต็มตามอัตราที่กำหนด</strong>
        รายการด้านล่างคือสิ่งที่ผู้ใช้งานควรตรวจสอบก่อนยืนยันบิล เพราะเป็นข้อมูลที่อ่านได้จากหน้ารายการจริง ไม่ใช่จากตัวข้อความโฆษณาเอง
      </p>

      <ul class="flex flex-col gap-4" aria-label="สิ่งที่ควรตรวจสอบก่อนยืนยันบิล">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🔢</span>
          <span>
            <strong class="text-[#b00718]">ข้อจำกัดการรับหมายเลข</strong> ควรตรวจจากหน้ารายการที่กำลังจะแทงจริง เพราะข้อความรวมที่หน้าแรกเป็นคำอธิบายภาพรวม ไม่ได้แทนเงื่อนไขของรายการนั้น
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>💠</span>
          <span>
            <strong class="text-[#b00718]">วงเงินเดิมพันสูงสุดของแต่ละรายการ</strong> คือค่าที่ต่างกันได้ระหว่างหวยคนละประเภท จึงควรเปิดดูก่อนกรอกยอด ไม่ใช่หลังกดยืนยัน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🧾</span>
          <span>
            <strong class="text-[#b00718]">เงื่อนไขการจ่ายรางวัลของแต่ละประเภท</strong> ควรอ่านให้ครบ เพื่อให้เข้าใจรายละเอียดการทำรายการอย่างถูกต้องตั้งแต่บิลแรก
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#b00718]">ควรตรวจสอบข้อจำกัดการรับหมายเลข วงเงินเดิมพันสูงสุด และเงื่อนไขการจ่ายรางวัลของแต่ละประเภทให้ชัดเจนก่อนยืนยันบิล</strong>
        หน้านี้จึงชี้ว่าควรอ่านอะไรและเปิดดูจากที่ไหน แทนที่จะยืนยันแทนเว็บไซต์ เพราะสิ่งที่ยืนยันได้จริงคือเงื่อนไขที่แสดงอยู่บนหน้ารายการในขณะทำรายการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`อัตราจ่ายของ ${BRAND_NAME} 2 ตัว 100 และ 3 ตัว 1,000`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} ระบุข้อมูลอัตราจ่ายหวยออนไลน์สำหรับหมายเลขสองหลักและสามหลักไว้สองค่า คือ
        <strong class="text-[#b00718]">อัตราจ่าย 2 ตัว 100 และ 3 ตัว 1,000</strong>
        โดยผู้ใช้งานควรตรวจสอบว่าอัตราดังกล่าวคำนวณจากเงินเดิมพันจำนวนเท่าใด และใช้กับหวยประเภทใดบ้าง เนื่องจากแต่ละประเภทอาจมีข้อกำหนดแตกต่างกัน
      </p>

      <p>
        สำหรับหมายเลขสองหลัก
        <strong class="text-[#b00718]">ควรตรวจสอบว่าใช้กับเลขสองตัวบนหรือสองตัวล่าง และคำนวณจากเงินเดิมพันจำนวนเท่าใด</strong>
        เพราะแต่ละประเภทอาจกำหนดอัตราจ่ายไม่เท่ากัน ก่อนยืนยันรายการจึงควรตรวจสอบหมายเลขที่เลือก รอบประกาศผล และเงื่อนไขการจ่ายรางวัลให้ครบถ้วน เพื่อหลีกเลี่ยงความเข้าใจคลาดเคลื่อนเกี่ยวกับยอดเงินที่มีสิทธิ์ได้รับ
      </p>

      <p>
        ส่วนหมายเลขสามหลัก
        <strong class="text-[#b00718]">ควรตรวจสอบว่าอัตราดังกล่าวใช้กับสามตัวตรง สามตัวโต๊ด หรือการเดิมพันรูปแบบใด รวมถึงฐานเงินเดิมพันและวงเงินจ่ายสูงสุดของแต่ละรายการ</strong>
        ก่อนยืนยันบิลควรตรวจสอบหมายเลขและประเภทหวยให้ถูกต้อง เพราะผลการออกรางวัลไม่สามารถรับประกันได้จากสถิติหรือเลขย้อนหลัง
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/promotion" aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`} class={ctaQuiet}>ดูภาพโปรโมชั่น</a>

        <a href="/ทดลองเล่น" aria-label={`เปิดหน้าทดลองเล่นของ ${BRAND_NAME}`} class={ctaQuiet}>ไปหน้าทดลองเล่น</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`วิธีสมัครแทงหวย ${BRAND_NAME} ด้วยมือถือ 3 ขั้นตอน`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#b00718]">{BRAND_NAME} ระบุช่องทางสมัครสมาชิกผ่านโทรศัพท์มือถือ โดยขั้นตอนทั่วไปประกอบด้วยการเข้าสู่หน้าลงทะเบียน กรอกข้อมูล และยืนยันบัญชี</strong>
        ก่อนดำเนินการควรตรวจสอบข้อกำหนดด้านอายุ กฎหมายที่เกี่ยวข้อง และนโยบายความเป็นส่วนตัว เพื่อให้เข้าใจเงื่อนไขการใช้บริการและการจัดเก็บข้อมูลส่วนบุคคล
      </p>

      <ol class="ml-6 list-decimal space-y-3 marker:font-black marker:text-[#b00718]">
        <li>
          <strong class="text-[#b00718]">เข้าสู่หน้าสมัครสมาชิก</strong> เปิดเว็บไซต์ผ่านเบราว์เซอร์บนมือถือ ตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง จากนั้นเลือกเมนูสมัครสมาชิกและอ่านข้อกำหนดการเปิดบัญชี รวมถึงรายละเอียดการใช้บริการก่อนดำเนินการ
        </li>
        <li>
          <strong class="text-[#b00718]">กรอกข้อมูลและยืนยันบัญชี</strong> กรอกข้อมูลตามที่เว็บไซต์กำหนด ตรวจสอบความถูกต้องก่อนยืนยัน และตั้งรหัสผ่านที่คาดเดาได้ยาก ไม่ควรใช้ข้อมูลของบุคคลอื่นหรือเปิดเผยรหัสผ่านและรหัส
          OTP ให้ใครทราบ
        </li>
        <li>
          <strong class="text-[#b00718]">เข้าสู่ระบบและตรวจสอบรายละเอียดหวย</strong> หลังลงทะเบียนเรียบร้อย สามารถศึกษารายการหวยที่เปิดให้บริการ รอบปิดรับ อัตราจ่าย และข้อกำหนดการเดิมพัน
          หากมีข้อสงสัยเกี่ยวกับระบบสมาชิกควรสอบถามเจ้าหน้าที่ผ่านช่องทางทางการก่อนทำรายการ
        </li>
      </ol>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/register" aria-label={`สมัครสมาชิก ${BRAND_NAME}`} class={ctaPrimary}>สมัครสมาชิก</a>

        <a href="/login" aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`} class={ctaSecondary}>เข้าสู่ระบบ</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`แอดมินออนไลน์ตลอด 24ชม. และช่องทางติดต่อของ ${BRAND_NAME}`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} ระบุช่องทางติดต่อเจ้าหน้าที่สำหรับผู้ใช้งานที่ต้องการสอบถามเกี่ยวกับการสมัครสมาชิก การเข้าสู่ระบบ ประเภทหวย รอบปิดรับ อัตราจ่าย และการตรวจสอบรายการ
        <strong class="text-[#b00718]">โดยควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง</strong>
      </p>

      <p>
        หากพบปัญหาเกี่ยวกับบิลหวยหรือธุรกรรม ควรเก็บหมายเลขรายการและหลักฐานที่เกี่ยวข้องไว้สำหรับตรวจสอบ พร้อมแจ้งรายละเอียดให้ชัดเจน
        <strong class="text-[#b00718]">โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น</strong>
        ทั้งนี้ ควรตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุดอีกครั้ง เพราะช่วงเวลาที่เจ้าหน้าที่รับเรื่องและระยะเวลาตอบกลับของแต่ละช่องทางอาจไม่เท่ากัน
      </p>

