---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึงเขียนขึ้นใหม่
// บนข้อเท็จจริงของบรีฟรอบนี้เท่านั้น (src/assets/content.txt) ไม่ใช่แก้ทับประโยคเดิม
// ของแบรนด์ก่อน — ของเดิมเป็นคอปปี้ของแบรนด์ก่อนหน้า ซึ่งทั้งย่อหน้าตั้งอยู่บนคำ
// ที่ brand-spec §6 สั่งห้าม จึงถูกเขียนใหม่ทั้งหมด
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) จึงเปิดใช้งานอยู่ และรอบนี้ operator สั่งให้
// คงไว้ ไม่ได้ park ลง src/pages-disabled/
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// ตัวที่ routing จริงคือไฟล์นี้ ตัวที่จอดไว้เป็นอินเวนทอรี ห้ามแก้และห้ามลบ
//
// ดรอปนี้ (2026-10-09) คือ **ฐานเว็บสล็อตหลักที่รวบรวมเกมสล็อตหลายรูปแบบไว้ใน
// แพลตฟอร์มเดียว** ธีมป่ากับกอริลลาสวมมงกุฎ ไม่ใช่เว็บลอตเตอรีและไม่ใช่เว็บรวมทุกหมวด
// (สองหน้าของหมวดลอตเตอรีจอดอยู่ใน src/pages-disabled/ ไม่มี route จึงห้ามลิงก์ไปหา
// มิฉะนั้นเป็น href ตายที่ทำให้ build แดง) แง่มุมที่บรีฟระบุไว้มีเท่านี้:
// รวมเกมสล็อตหลายรูปแบบในแพลตฟอร์มเดียว (เกมคลาสสิก ฟรีสปิน โบนัส ตัวคูณ
// สล็อตวงล้อทั่วไป เกมที่มีฟีเจอร์พิเศษ) · เดิมพันเริ่มต้น 1 บาทในเกมที่กำหนด
// ตามช่วงเดิมพันที่ผู้ให้บริการกำหนด · สล็อตเบทต่ำ ทุนน้อยก็เล่นได้ · ทางเข้าเล่น
// ผ่านมือถือได้ตลอด 24 ชั่วโมง · เลือกค่าย ตรวจสอบเครดิต ติดตามรายการจากบัญชีเดียว ·
// ตรวจตารางจ่ายและรายละเอียดเกมก่อนเริ่มเล่น · คืนยอดเสีย 0.3% เข้ายูสตามรอบ ·
// แนะนำเพื่อนแชร์ลิงก์ 0.8% จากยอดที่เข้าเกณฑ์ · ฝากถอนเข้าบริษัทโดยตรง ตรวจชื่อ
// บัญชีปลายทางและข้อมูลนิติบุคคล · แอดมิน 24 ชั่วโมง · PIN/OTP
//
// ⚠️ คำที่ห้ามหลงเหลือ: ศัพท์ของหมวดอื่นที่ไม่ใช่สล็อต และคำขายของของแบรนด์ก่อนๆ
// ที่บรีฟรอบนี้ไม่ได้เอ่ย — รายการเต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อ
// ไม่ให้ grep หาคำต้องห้ามเจอ false positive รอบนี้เขียนใหม่จากบรีฟ ไม่ได้
// find-and-replace ทับประโยคเก่า เพราะประโยคเก่าทั้งย่อหน้าตั้งอยู่บนคำเหล่านั้น
//
// ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 1 บาท · 0.3% · 0.8% · 24 ชั่วโมง
// ห้ามเติมเลขใบอนุญาต หน่วยงานกำกับ ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP ยอดฝากขั้นต่ำ
// จำนวนสมาชิก หรือปีที่ก่อตั้ง เพราะบรีฟไม่ได้เอ่ยไว้สักอย่าง
//
// ประโยคกำกับที่บรีฟเขียนไว้เองและห้ามตัดทิ้งเพราะฟังดูไม่ขายของ: การยืนยันว่าเป็น
// เว็บแท้และปลอดภัยควรมีข้อมูลผู้ให้บริการที่ตรวจสอบได้รองรับ · เบทต่ำไม่ได้แปลว่า
// โอกาสชนะมากกว่า เพราะผลการหมุนเป็นแบบสุ่ม และแต่ละเกมกำหนดยอดขั้นต่ำต่างกัน ·
// แต่ละโปรโมชั่นกำหนดค่ายเกม ระยะเวลา และเงื่อนไขต่างกัน ควรอ่านก่อนรับสิทธิ์ ·
// คำว่าไม่จำกัดควรตรวจสอบว่าหมายถึงอะไร · ชื่อบัญชีบริษัทอย่างเดียวไม่สามารถ
// รับประกันความปลอดภัยของธุรกรรมได้ทั้งหมด · ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP
// แม้ผู้นั้นจะอ้างว่าเป็นเจ้าหน้าที่
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **เขียวนีออนป่า x ทองมงกุฎ บนเขียวป่าเกือบดำ**
// พลิกจากคู่ม่วงนีออน-ทองของแบรนด์ก่อน ซึ่งออกครบทุกจุดแล้ว ทั้งคลาส Tailwind
// raw hex และ rgba() (ค่าเดิมอยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้
// grep หาสีแบรนด์เก่าเจอ false positive)
// ลำดับปุ่มสื่อด้วย "ทองถม vs เขียวโปร่ง": ปุ่มหลัก (สมัครสมาชิก) ถมทองไล่ #f2c230
// → #a87a08 ขอบ #a87a08 หมึกเขียวเกือบดำ #06220a — ห้ามพลิกเป็นหมึกสว่าง ·
// ปุ่มรองและปุ่มลิงก์ภายในเป็นผิวการ์ด #14380a → #0f2e05 ขอบเขียว #5cc211/55
// ตัวอักษรเขียวอ่อน #bde397 · #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สี
// ของเว็บ จึงคงไว้ และแยกออกจากไลม์แบรนด์ได้ด้วยตาเพราะอิ่มตัวกว่าและเข้มกว่า
// ⚠️ เขียวสด #5cc211 กับเขียวกลาง #2f8c07 ห้ามถือตัวอักษร ใช้เป็นขอบ เงา และออรา
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #e9f7d6)
// ไว้ที่ตัวการ์ดแล้ว ข้อความในหน้านี้จึงไม่ประกาศสีของตัวเองเลย ปล่อยให้สืบทอดลงมา
// — มีแค่ปุ่มที่ประกาศสีได้ เพราะปุ่มถมพื้นของตัวเองจึงต้องกำหนดหมึกของตัวเอง
// ส่วน <strong> ใช้น้ำหนักตัวอักษรเป็นไฮไลต์ ไม่ประกาศสี และแต่ละ <strong> ครอบ
// "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิด
// แท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้าง
// จากหน้า และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น Announcement3 ทั้งเว็บ (รอบก่อนใช้ Announcement5 —
// brand-spec §3 หมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้
// ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูด
// คนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 157 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} ฐานเว็บสล็อตหลักที่รวมเกมสล็อตหลายรูปแบบไว้ในแพลตฟอร์มเดียว เดิมพันเริ่มต้น 1 บาท คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% แอดมิน 24 ชั่วโมง`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} ฐานเว็บสล็อตหลัก รวมเกมสล็อตหลายรูปแบบไว้ในแพลตฟอร์มเดียว`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong>{BRAND_NAME} คือฐานเว็บสล็อตหลักที่รวบรวมเกมสล็อตหลายรูปแบบไว้ในแพลตฟอร์มเดียว</strong>
        มีทั้งเกมคลาสสิก ฟรีสปิน โบนัส และตัวคูณให้เลือกตามความสนใจ รองรับการเดิมพันเริ่มต้น 1 บาทในเกมที่กำหนด จึงเหมาะกับผู้ที่ต้องการเลือกสล็อตเบทต่ำและแบ่งงบเล่นตามความสะดวก พร้อมทางเข้าเล่นผ่านมือถือได้ตลอด 24 ชั่วโมง
      </p>

      <p>
        หน้านี้สรุปไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่เมนูเลือกค่ายและหมวดเกมสล็อต
        <strong>ไปจนถึงการตรวจสอบเครดิต การติดตามรายการต่างๆ โปรโมชั่นที่เปิดให้รับในแต่ละช่วง และช่องทางติดต่อแอดมินที่ให้บริการตลอด 24 ชั่วโมง</strong>
        เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดดูอะไรตรงไหน แล้วจึงค่อยลงรายละเอียดของรายการที่สนใจเป็นรายรายการ
      </p>

      <p>
        <strong>ส่วนการยืนยันว่าเป็นเว็บแท้และปลอดภัยควรมีข้อมูลผู้ให้บริการที่ตรวจสอบได้รองรับ</strong>
        ข้อมูลในหน้านี้จึงเขียนไว้เพื่อบอกว่าระบบมีอะไรให้ใช้และควรตรวจอะไรก่อนตัดสินใจ ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้งาน ซึ่งเป็นค่าที่ควรยึดเป็นหลักเสมอ
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`เกมสล็อตและเมนูที่ ${BRAND_NAME} รวมไว้ในบัญชีเดียว`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} รวมเมนูที่สมาชิกต้องใช้ไว้หลังการเข้าสู่ระบบครั้งเดียว
        <strong>ตั้งแต่การเลือกค่ายและหมวดเกมสล็อต ไปจนถึงการตรวจสอบเครดิตและติดตามรายการต่างๆ จากบัญชีเดียว</strong>
        เมนูแต่ละส่วนทำหน้าที่คนละอย่างและแสดงข้อมูลคนละชุด จึงควรเปิดดูให้ครบตั้งแต่ครั้งแรก เพื่อให้รู้ว่าข้อมูลที่ต้องใช้จริงอยู่ตรงไหน สิ่งที่แต่ละเมนูดูแลแบ่งออกได้ประมาณนี้
      </p>

      <ul class="flex flex-col gap-3" aria-label={`เมนูฝั่งสมาชิกบนเว็บ ${BRAND_NAME}`}>
        <li class="flex gap-3">
          <span aria-hidden="true">🎰</span>
          <span>
            <strong>เมนูเลือกค่ายและหมวดเกม</strong> ใช้ไล่ดูรายชื่อค่ายและหมวดเกมสล็อตที่ระบบเปิดให้บริการ ทั้งสล็อตวงล้อทั่วไป เกมโบนัส ฟรีสปิน ตัวคูณ และเกมที่มีฟีเจอร์พิเศษ โดยรายการที่เปิดอยู่อาจเปลี่ยนแปลงได้ตามช่วงเวลา
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">🪙</span>
          <span>
            <strong>ช่วงเดิมพันของแต่ละเกม</strong> บางเกมเริ่มต้นได้ตั้งแต่ 1 บาท ตามช่วงเดิมพันที่ผู้ให้บริการกำหนด จึงควรเปิดดูช่วงเดิมพันและตารางจ่ายที่แสดงภายในเกมก่อนเริ่มเล่น เพื่อวางแผนจำนวนเงินต่อรอบให้เหมาะกับงบที่ตั้งไว้
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">💳</span>
          <span>
            <strong>การตรวจสอบเครดิต</strong> แสดงยอดล่าสุดของบัญชีที่ระบบบันทึกไว้ เป็นค่าที่ควรยึดก่อนเลือกเกม แทนตัวเลขที่จำไว้จากรอบก่อนหน้า
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">📋</span>
          <span>
            <strong>การติดตามรายการต่างๆ</strong> ใช้ไล่ดูรายการย้อนหลังของบัญชีตัวเองและสถานะของรายการที่ส่งไว้ เป็นที่เดียวกับที่ใช้อ้างอิงวันเวลาเวลาจะแจ้งปัญหาให้เจ้าหน้าที่ตรวจสอบ
          </span>
        </li>
      </ul>

      <p>
        ก่อนเริ่มเล่นสามารถตรวจสอบตารางจ่ายและรายละเอียดของแต่ละเกมได้โดยตรงจากในเกมเอง
        <strong>การเลือกเกมสล็อตเบทต่ำช่วยให้แบ่งงบสำหรับแต่ละรอบได้ชัดเจนขึ้น แต่ไม่ได้หมายความว่าจะมีโอกาสชนะมากกว่าเกมเดิมพันสูง</strong>
