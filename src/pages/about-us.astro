---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";

// MGM9 เป็นคาสิโนออนไลน์ครบวงจร (บาคาร่า / สล็อต / ฟุตบอล / หวย) ไม่ใช่เว็บหวยล้วน
// เนื้อหาทั้งหน้าจึงพูดเรื่องหมวดเกมที่เปิดให้บริการ ระบบฝากถอนวอลเลท/ธนาคาร
// โปรโมชั่นแนะนำเพื่อน 0.8% กับคืนยอดเสีย 0.3% ขั้นตอนสมัคร และการติดต่อแอดมิน
// ทุกข้อความด้านล่างอ้างอิง src/assets/content.txt เท่านั้น ไม่มีการอ้างใบอนุญาต
// การจดทะเบียนบริษัท ปีที่ก่อตั้ง รางวัล จำนวนสมาชิก หรือการันตีผลกำไร
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 157
const pageDescription = "MGM9 คาสิโนออนไลน์ครบวงจร บาคาร่า สล็อต ฟุตบอล หวย ไว้ในบัญชีเดียว ฝากถอนผ่านวอลเลทและธนาคาร พร้อมโบนัสแนะนำเพื่อน 0.8% คืนยอดเสีย 0.3% แอดมินดูแล 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ MGM9 คาสิโนเกมครบวงจรในบัญชีเดียว",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา MGM9 คาสิโนเกมครบวงจร บาคาร่า สล็อต บอล หวย ในบัญชีเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ MGM9 คาสิโนเกมครบวงจรในบัญชีเดียว" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d3e6ff]">
        <strong class="text-[#9ad4ff]">MGM9</strong> รวมบริการ<strong class="text-[#9ad4ff]">เกมเดิมพันออนไลน์หลายประเภทไว้ในระบบเดียว</strong>
        ทั้งบาคาร่า สล็อต ฟุตบอล และหวย รองรับการใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์
        สมาชิกสามารถเลือกเกม ฝากถอน ตรวจสอบโปรโมชั่น และจัดการบัญชีได้จากหน้าเว็บไซต์ โดยไม่ต้องสลับไปมาระหว่างหลายบัญชี
      </p>

      <p class="text-left text-base leading-relaxed text-[#d3e6ff]">
        แนวคิดของเว็บคือทำให้ทุกขั้นตอนตรวจสอบได้ตั้งแต่ก่อนยืนยันรายการ ทั้งกติกา อัตราจ่าย ช่วงเดิมพัน และประวัติธุรกรรมที่ย้อนกลับมาดูได้เสมอ
        ควบคู่กับ<strong class="text-[#9ad4ff]">โปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไข</strong>
        รวมถึงแอดมินที่คอยให้คำแนะนำและรับเรื่องปัญหาการใช้งานตลอด 24 ชั่วโมง
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="หมวดเกมของ MGM9 บาคาร่า สล็อต บอล และหวย ไม่อั้นจ่าย ไม่มีขั้นต่ำ" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d3e6ff]">
        MGM9 จัดหมวดเกมหลักไว้ให้สมาชิกเลือกตามความสนใจ สามารถตรวจสอบกติกา อัตราจ่าย ช่วงเดิมพัน และรายละเอียดของแต่ละเกม
        <strong class="text-[#9ad4ff]">ก่อนยืนยันรายการได้จากบัญชีเดียว</strong> ช่วยให้สลับเล่นระหว่างเกมแต่ละประเภทได้สะดวกบนมือถือ
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#d3e6ff]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#4aa4f4]">🃏</span>
          <span><strong class="text-[#9ad4ff]">บาคาร่าออนไลน์และเกมคาสิโนสด</strong> เปิดให้เลือกโต๊ะตามที่ระบบให้บริการ ตรวจกติกาและช่วงเดิมพันของโต๊ะนั้นได้ก่อนลงเดิมพัน</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#4aa4f4]">🎰</span>
          <span><strong class="text-[#9ad4ff]">สล็อตออนไลน์</strong> มีให้เลือกหลายรูปแบบ สามารถดูรายละเอียดของเกมและวงเงินเดิมพันต่อรอบก่อนเริ่มหมุนได้</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#4aa4f4]">⚽</span>
          <span><strong class="text-[#9ad4ff]">เดิมพันฟุตบอล</strong> เปิดตามรายการแข่งขันที่มีในระบบ ควรตรวจคู่แข่งขัน รูปแบบเดิมพัน และอัตราจ่ายก่อนยืนยันบิล</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#4aa4f4]">🎯</span>
          <span><strong class="text-[#9ad4ff]">หวยออนไลน์</strong> เปิดรับตามรอบที่ให้บริการ เวลาเปิด-ปิดรับจึงต่างจากเกมหมวดอื่นอย่างชัดเจน</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#a8c8ea]">
        สำหรับเงื่อนไข “ไม่อั้นจ่าย” และ “ไม่มีขั้นต่ำ” ควรยึดวงเงินและข้อกำหนดที่ระบบแสดง ณ เวลาทำรายการเป็นหลัก
        เนื่องจากเกม โต๊ะ หรือประเภทการเดิมพันแต่ละรายการอาจกำหนดวงเงินแตกต่างกัน
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ฝากถอนวอลเลทและธนาคาร พร้อมโปรโมชั่นของ MGM9 ครบทุกรูปแบบ" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d3e6ff]">
        สมาชิก MGM9 สามารถจัดการเครดิตผ่านระบบฝากถอนที่เว็บไซต์เปิดให้บริการ <strong class="text-[#9ad4ff]">รองรับทั้งวอลเลทและบัญชีธนาคารตามช่องทางที่กำหนด</strong>
        สามารถตรวจสอบยอด ฝากเครดิต ส่งคำขอถอน และติดตามสถานะธุรกรรมผ่านบัญชีสมาชิกได้ด้วยตนเอง
        นอกจากนี้ยังสามารถ Login เพื่อตรวจสอบโปรโมชั่นและสิทธิ์โบนัสที่พร้อมให้กดรับได้ในแต่ละรอบ
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#d3e6ff]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#4aa4f4]">🤝</span>
          <span>
            <strong class="text-[#9ad4ff]">โปรโมชั่นแนะนำเพื่อน โบนัส 0.8%</strong> สมาชิกแชร์ลิงก์แนะนำส่วนตัวให้เพื่อน เมื่อเพื่อนสมัครและมียอดใช้งานตรงตามข้อกำหนด
            ระบบจะคำนวณโบนัสตามเงื่อนไข ตรวจสอบจำนวนเพื่อน ยอดที่เข้าเกณฑ์ และโบนัสที่มีสิทธิ์รับผ่านบัญชีได้โดยตรง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#4aa4f4]">💸</span>
          <span>
            <strong class="text-[#9ad4ff]">โปรโมชั่นคืนยอดเสีย โบนัส 0.3%</strong> สมาชิกที่มียอดเสียเข้าเงื่อนไขตรวจสอบสิทธิ์ได้ตามรอบที่กำหนด
            ระบบจะแสดงยอดที่นำมาคำนวณและโบนัสที่กดรับได้ ควรตรวจว่าเกมที่เดิมพันเข้าร่วมโปรโมชั่นหรือไม่ก่อนใช้สิทธิ์
          </span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#a8c8ea]">
        ก่อนกดรับโบนัสทุกครั้งควรอ่านรอบคำนวณ เงื่อนไขการถอน และรายชื่อช่องทางฝากถอนล่าสุดที่ระบบแสดงในขณะนั้น
        เนื่องจากข้อกำหนดของแต่ละโปรโมชั่นและแต่ละช่องทางอาจแตกต่างกันในแต่ละช่วงเวลา
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="สมัคร MGM9 ด้วย 3 ขั้นตอนง่าย ๆ แล้วเริ่มเลือกเกมได้ทันที" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d3e6ff]">
        ผู้ใช้งานใหม่สามารถเริ่มสมัคร MGM9 ผ่านมือถือได้ด้วยขั้นตอนที่ไม่ซับซ้อน
        หลังเปิดบัญชีแล้ว<strong class="text-[#9ad4ff]">สามารถเลือกเกมและตรวจสอบโปรโมชั่นที่ต้องการได้ทันที</strong>
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#d3e6ff]">
        <li class="flex gap-3"><span class="font-bold text-[#4aa4f4]">1.</span> เข้าหน้าสมัคร MGM9 และกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน</li>
        <li class="flex gap-3"><span class="font-bold text-[#4aa4f4]">2.</span> Login เข้าบัญชี เลือกช่องทางฝากเครดิตผ่านธนาคารหรือวอลเลทที่รองรับ</li>
        <li class="flex gap-3"><span class="font-bold text-[#4aa4f4]">3.</span> เลือกบาคาร่า สล็อต บอล หรือหวย ตรวจสอบกติกาและรายละเอียดก่อนเริ่มเดิมพัน</li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#a8c8ea]">
        หลังสมัครสมาชิกสามารถตรวจสอบเครดิต ประวัติธุรกรรม โปรโมชั่น และรายการเดิมพันผ่านบัญชีของตนเองได้
        โดยควรตั้งรหัสผ่านที่คาดเดายากและไม่เปิดเผย OTP แก่บุคคลอื่น
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="แอดมิน MGM9 ให้บริการออนไลน์ตลอด 24 ชั่วโมง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d3e6ff]">
        หากพบปัญหาเกี่ยวกับการสมัคร Login ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง โปรโมชั่นไม่แสดง หรือเข้าเกมไม่ได้ สามารถ
        <strong class="text-[#9ad4ff]">ติดต่อแอดมิน MGM9 ได้ตลอด 24 ชั่วโมง</strong> พร้อมแจ้งเวลา จำนวนเงิน และรายละเอียดของรายการ
        เพื่อช่วยให้เจ้าหน้าที่ตรวจสอบข้อมูลได้ตรงจุด
      </p>

      <p class="text-left text-base leading-relaxed text-[#d3e6ff]">
        สมาชิกใหม่ยังสามารถสอบถามวิธีฝากถอน ขั้นตอนรับโปรโมชั่น หรือการเข้าใช้งานเกมแต่ละหมวดได้
        หากเป็นปัญหาเกี่ยวกับธุรกรรมควรเก็บหลักฐานรายการไว้จนกว่าการตรวจสอบจะเสร็จสิ้น และ<strong class="text-[#9ad4ff]">ไม่ควรแจ้งรหัสผ่านหรือ OTP ให้บุคคลอื่น</strong>
      </p>

      <p class="text-left text-base leading-relaxed text-[#a8c8ea]">
        การเดิมพันมีความเสี่ยงและผลของแต่ละรอบไม่แน่นอน ไม่มีเกมหรือรูปแบบใดรับประกันผลล่วงหน้า สมาชิกจึงควรกำหนดงบประมาณก่อนเริ่มเดิมพันทุกครั้ง
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก MGM9"
          class="flex items-center justify-center rounded-lg border border-[#4aa4f4]/50 bg-gradient-to-r from-[#9ad4ff] via-[#4aa4f4] to-[#1f74d6] px-8 py-3 font-black text-[#01102e] shadow-[0_0_15px_rgba(74,164,244,0.30)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ MGM9"
          class="flex items-center justify-center rounded-lg border border-[#4aa4f4]/60 bg-transparent px-8 py-3 font-bold text-[#9ad4ff] transition-all hover:scale-105 hover:border-[#9ad4ff] hover:bg-[#062a72]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
