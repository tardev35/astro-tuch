---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char, so a byte count reads
// ~3x too long). One string, reused by MainLayout's meta and the WebPage node.
const pageDescription =
  "รู้จัก BPLAY639 คาสิโนเกมมาใหม่ ลิขสิทธิ์แท้จากอเมริกา รวมเกมคาสิโนหลายหมวดในบัญชีเดียว พร้อมโบนัสแนะนำเพื่อน 0.8% คืนยอดเสีย 0.3% และแอดมินดูแลตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ BPLAY639 คาสิโนเกมมาใหม่ ลิขสิทธิ์แท้จากอเมริกา",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา BPLAY639 คาสิโนลิขสิทธิ์แท้จากอเมริกา เชื่อถือได้ ปลอดภัย" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ BPLAY639" as="h1">
    <p class="mb-6 text-left text-base leading-relaxed text-[#f2e3f7]">
      <strong class="text-[#f9a8d4]">BPLAY639</strong> คือ <strong class="text-[#f9a8d4]">คาสิโนเกมมาใหม่ ลิขสิทธิ์แท้จากอเมริกา</strong>
      ที่พร้อมให้บริการสมาชิกซึ่งต้องการเล่นเกมคาสิโนออนไลน์ผ่านมือถือและคอมพิวเตอร์ ภายในระบบมีเกมหลากหลายประเภทให้เลือก พร้อมอัปเดตเกมใหม่อย่างต่อเนื่อง
      รวมถึงโปรโมชั่นสำหรับสมาชิกทั้งโบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไข ระบบออกแบบให้สมัครและเข้าใช้งานได้สะดวก
      สมาชิกที่สมัครแล้วเข้าถึงเว็บผ่านลิงก์ตรงได้ทันที โดยไม่ต้องไล่หาทางเข้าจากที่อื่น
    </p>

    <p class="mb-2 text-left text-base leading-relaxed text-[#f2e3f7]">
      สิ่งที่ BPLAY639 ให้ความสำคัญคือความชัดเจนของข้อมูลก่อนตัดสินใจเดิมพัน ทั้งกติกาของเกม อัตราเดิมพัน เงื่อนไขของโปรโมชั่น และขั้นตอนการใช้งานในระบบ
      จะแสดงให้อ่านได้ก่อนเข้าร่วมเสมอ สมาชิกจึงควรอ่านรายละเอียดตรงจุดนั้นทุกครั้ง เพราะข้อกำหนดของแต่ละรายการไม่เท่ากัน
      และมีแอดมินคอยให้คำแนะนำตั้งแต่การสมัคร การเข้าสู่ระบบ ไปจนถึงการแก้ไขปัญหาระหว่างใช้งาน
    </p>
  </ContentBox>

  <ContentBoxPlain title="รวมเกมคาสิโน BPLAY639 หลายหมวดหมู่ไว้ในบัญชีเดียว" as="h2">
    <p class="mb-2 text-left text-base leading-relaxed text-[#f2e3f7]">
      BPLAY639 รวบรวมเกมคาสิโนออนไลน์หลายหมวดหมู่ไว้ภายในบัญชีเดียว ทั้ง
      <strong class="text-[#f9a8d4]">บาคาร่า รูเล็ต เสือมังกร แบล็กแจ็ก คาสิโนสด สล็อต</strong> และเกมใหม่จากผู้ให้บริการที่เปิดให้ใช้งาน
      สมาชิกสามารถเลือกเกมผ่านสมาร์ตโฟน แท็บเล็ต หรือคอมพิวเตอร์ พร้อมตรวจสอบกติกา ฟีเจอร์ อัตราเดิมพัน และรายละเอียดของเกมก่อนเริ่มเล่นได้โดยตรง
      ทั้งนี้ เกมคาสิโนมีผลลัพธ์ที่ไม่แน่นอน จึงไม่มีเกมใดสามารถรับประกันการแตกรางวัลหรือกำไรได้ทุกครั้ง ควรเลือกเดิมพันตามงบประมาณและศึกษากติกาของเกมก่อนเริ่มเล่น
    </p>
  </ContentBoxPlain>

  <ContentBoxPlain title="โบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% สำหรับสมาชิก BPLAY639" as="h2">
    <p class="mb-2 text-left text-base leading-relaxed text-[#f2e3f7]">
      สมาชิกสามารถตรวจสอบโปรโมชั่นและโบนัสที่กำลังเปิดให้รับผ่านหน้าเว็บไซต์ โดยมีทั้งสิทธิ์สำหรับสมาชิกใหม่และโปรโมชั่นสำหรับสมาชิกที่ใช้งานเป็นประจำ
      แต่ละรายการจะแสดง <strong class="text-[#f9a8d4]">เปอร์เซ็นต์ วิธีคำนวณ รอบการรับ และข้อกำหนดที่เกี่ยวข้อง</strong> ให้ตรวจสอบก่อนกดรับสิทธิ์
    </p>

    <p class="mt-3 mb-2 text-left text-base leading-relaxed text-[#f2e3f7]">
      โบนัสแนะนำเพื่อนคำนวณให้ 0.8% เมื่อเพื่อนสมัคร ฝากเงิน และมีรายการตรงตามข้อกำหนด ส่วนโบนัสคืนยอดเสียสูงถึง 0.3% คิดจากยอดที่เข้าเกณฑ์ตามรอบประจำวันที่กำหนด
      สำหรับโปรโมชั่นที่ระบุว่าไม่จำกัดจำนวน ให้ยึด <strong class="text-[#f9a8d4]">รายละเอียด วงเงิน และข้อกำหนดล่าสุดที่แสดงบนหน้าโปรโมชั่น</strong> เป็นหลัก
      เพื่อให้ทราบสิทธิ์ที่ได้รับอย่างชัดเจนก่อนเข้าร่วม
    </p>
  </ContentBoxPlain>

  <ContentBoxPlain title="สมัครสมาชิกเองได้บนมือถือ และแอดมิน BPLAY639 ดูแลผ่าน LINE Official ตลอด 24 ชั่วโมง" as="h2">
    <p class="mb-6 text-left text-base leading-relaxed text-[#f2e3f7]">
      <strong class="text-[#f9a8d4]">ระบบ BPLAY639</strong> ออกแบบให้สมาชิกเริ่มต้นใช้งานผ่านมือถือได้ด้วยตัวเองเพียง 3 ขั้นตอน
      คือสมัครสมาชิกผ่านหน้าเว็บไซต์และกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน จากนั้น Login เข้าสู่บัญชี ฝากเครดิต และตรวจสอบโปรโมชั่นที่มีสิทธิ์รับ
      แล้วเลือกเกมคาสิโนที่ต้องการพร้อมศึกษากติกาและรายละเอียดให้เรียบร้อยก่อนเริ่มเดิมพัน หน้าเว็บไซต์รองรับการใช้งานผ่านเว็บเบราว์เซอร์ทั้ง
      <strong class="text-[#f9a8d4]">Android และ iOS รวมถึงแท็บเล็ตและคอมพิวเตอร์</strong>
      หากพบปัญหาเกี่ยวกับการสมัครสมาชิก การ Login เครดิตไม่เข้า ฝากถอนล่าช้า โบนัสไม่แสดง หรือไม่สามารถเข้าเกมได้ สามารถติดต่อ
      <strong class="text-[#f9a8d4]">แอดมิน BPLAY639 ผ่าน LINE Official ได้ตลอด 24 ชั่วโมง</strong> พร้อมแจ้งรายละเอียดของปัญหาและเวลาที่ทำรายการ
      ทีมงานพร้อมช่วยตรวจสอบข้อมูลและแนะนำขั้นตอนดำเนินการต่อ เพื่อให้สมาชิกกลับมาใช้งานระบบได้อย่างต่อเนื่อง ทั้งนี้ ควรหลีกเลี่ยงคำแนะนำที่อ้างว่าการันตีกำไรหรือผลรางวัลได้
      เพราะการเดิมพันมีความเสี่ยงเสมอ ควรศึกษากติกาของแต่ละเกมและกำหนดงบประมาณให้เหมาะสมก่อนเดิมพันทุกครั้ง
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก BPLAY639"
        class="flex items-center justify-center rounded-lg bg-gradient-to-r from-[#ec4899] via-[#f472b6] to-[#4c1d6b] px-8 py-3 font-black text-[#150724] shadow-[0_0_15px_rgba(244,114,182,0.28)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ BPLAY639"
        class="flex items-center justify-center rounded-lg border border-[#f9a8d4]/70 bg-transparent px-8 py-3 font-bold text-[#f2e3f7] transition-all hover:scale-105 hover:border-[#fdf2f8] hover:bg-[#2c0f45]/70">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
