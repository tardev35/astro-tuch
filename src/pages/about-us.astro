---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่ม) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง
// ไม่ได้มาจากเช็กลิสต์หัวข้อของ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน
// SUB-PAGES ที่ให้ body จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริงของ MAHAGAME66 เท่านั้น
//
// รอบนี้ (ดรอป 2026-09-24) คือ "MAHAGAME66 พนันออนไลน์ เว็บตรง ปลอดภัย ระบบแท้100%"
// เป็น **เว็บพนันรวมเกม** (บาคาร่า สล็อต หวย บอล รูเล็ต + หมวดไลฟ์สด) ส่วนคอปปี้
// รอบก่อนเป็นของ 888PARUAY ซึ่งเป็น **เว็บหวยล้วน** (รัฐบาลไทย/ฮานอย/ลาวพัฒนา/
// หุ้นต่างประเทศ, เลข 2 ตัวจ่าย 100, เลข 3 ตัวจ่าย 1,000, หน้าตรวจหวย) — ทั้งหน้า
// ถูกเขียนใหม่ ห้าม find-and-replace ชื่อแบรนด์ทับของเก่าเด็ดขาด เพราะจะทำให้
// MAHAGAME66 อ้างอัตราจ่ายและรายการหวยที่บรีฟรอบนี้ไม่เคยระบุ
//
// ข้อเท็จจริงทุกบรรทัดมาจาก brand-spec §4 ("ข้อเท็จจริงที่บรีฟระบุ") เท่านั้น:
// บาคาร่า · สล็อต · หวย · บอล · รูเล็ต · หมวดเกมไลฟ์สด · เชื่อมต่อจากผู้ให้บริการ
// ตามข้อมูลของเว็บไซต์ · ตรวจสอบค่ายเกม รายละเอียดโต๊ะ รูปแบบเดิมพันก่อนเข้าเล่น ·
// โบนัสแนะนำเพื่อน 0.8% · โบนัสคืนยอดเสีย 0.3% · ตรวจสอบยอดที่เข้าเกณฑ์ รอบรับสิทธิ์
// และเงื่อนไขก่อนกดรับ · ฝากถอนผ่านวอลเลทและธนาคาร · ตรวจสอบยอดและสถานะรายการ
// ผ่านบัญชี · รองรับมือถือและคอมพิวเตอร์ · เมนูจัดหมวดหมู่ชัดเจน · บัญชีเดียว ·
// แอดมิน 24 ชั่วโมง
// — ห้ามอ้างชื่อค่ายเกม/ชื่อเกมเฉพาะ เลขใบอนุญาต ปีที่ก่อตั้ง เลขทะเบียนบริษัท
// จำนวนสมาชิก ค่า RTP "ฝากถอนไม่มีขั้นต่ำ" "ออโต้ 10 วินาที" ขั้นต่ำการเดิมพัน
// ชื่อธนาคารเจาะจง หรือการันตีว่าจะชนะ เพราะบรีฟไม่ได้ระบุไว้
// ด้วยเหตุนี้จึงไม่มีลิสต์ "สมัคร 3 ขั้นตอน" ในหน้านี้อีกแล้ว (ของรอบก่อน) —
// บรีฟรอบนี้ไม่ได้บอกจำนวนขั้นตอนการสมัครไว้ การเขียนเลขขั้นตอนคือการแต่งข้อมูล
//
// Announcement รอบนี้หมุนมาใช้ Announcement5 ทั้งเว็บ — default message ของไฟล์นั้น
// ถูกตั้งเป็นคอปปี้ของ MAHAGAME66 แล้ว จึงเรียกแบบ bare เหมือน index.astro
// ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ MAHAGAME66 (แดง + ดำ + เงินโครเมียม): พื้นเพจ #080506 · ผิวการ์ด #16090a ·
// ผิวการ์ดยก #26100f · แดงแบรนด์ #de161d · แดงสว่าง #ff4d52 · แดงลึก #7a0a0e ·
// เงินโครเมียม #e2e8ef · เงินหม่น #9ba3ad · เนื้อความ #e8e3e1 (BRAND_TEXT) ·
// เน้นใน strong #fff6f5 — พาเลตต์ทอง-เขียวของ 888PARUAY (#fcdc2b #fff6ae #a87d0c
// #1fae1c #0c4402 #07130a #0d2312 #143a1c #cf1111 #8a0303 #e8e4c6 #fffdf0)
// ถูกแทนครบทุกจุดแล้ว ห้ามนำกลับมา
// ส่วน #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ตามเดิม
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลางที่ไม่หมุนตามรอบรีแบรนด์ และรอบนี้
// orchestrator เป็นคนรีธีม) — เนื้อความในการ์ดจึงไม่ระบุสีของตัวเองเลย ให้สืบทอด
// สีจากการ์ด มีเพียงปุ่มเท่านั้นที่ถือสีของพาเลตต์
//
// ไม่มีลิงก์ /ตรวจหวย หรือ /แนวทาง ในหน้านี้: รอบนี้สองหน้านั้นถูกย้ายกลับไป
// src/pages-disabled/ แล้ว (MAHAGAME66 ไม่ใช่เว็บหวยเฉพาะทาง) href ที่ชี้ route
// ซึ่งไม่มีใน dist/ จะทำให้ verify-build แดง
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index และ /promotion
// ส่วน banner1/banner1-mobile เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า
// และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กค้างของลูกค้าเจ้าอื่น ห้าม import
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 151
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "เกี่ยวกับ MAHAGAME66 เว็บพนันออนไลน์ที่รวมบาคาร่า สล็อต หวย บอล รูเล็ต และเกมไลฟ์สดไว้ในบัญชีเดียว พร้อมโปรโมชั่น ระบบฝากถอนวอลเลท และแอดมิน 24 ชั่วโมง";

const pageTitle = "เกี่ยวกับเรา MAHAGAME66 เว็บตรง บาคาร่า สล็อต หวย บอล รูเล็ต ครบในบัญชีเดียว";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        <strong>MAHAGAME66</strong> คือเว็บที่<strong>รวมเกมพนันออนไลน์หลายประเภทไว้ในระบบเดียว</strong>
        ทั้งบาคาร่า สล็อต หวย บอล และรูเล็ต พร้อมหมวดเกมไลฟ์สดตามรายการที่เปิดให้บริการ รองรับการใช้งานผ่านมือถือและคอมพิวเตอร์ โดยเมนูจัดหมวดหมู่ไว้ชัดเจน ช่วยให้สมาชิกเลือกเกมที่ต้องการได้ง่ายจากบัญชีเดียว
      </p>

      <p class="text-left text-base leading-relaxed">
        หน้านี้รวบรวมไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่หมวดเกมที่เปิดให้เลือก โปรโมชั่นที่ตรวจสอบรายละเอียดได้หลังสมัคร ช่องทางฝากถอนที่ระบบรองรับ
        ไปจนถึงช่องทางสอบถามแอดมินเมื่อไม่แน่ใจในขั้นตอนใด
      </p>

      <p class="text-left text-base leading-relaxed">
        <strong>รายการเกม ค่ายที่เชื่อมต่อ และเงื่อนไขของโปรโมชั่นอาจเปลี่ยนแปลงตามช่วงเวลา</strong>
        รายละเอียดทั้งหมดจึงยึดตามข้อมูลที่เว็บไซต์แสดงไว้จริงในขณะนั้นเป็นหลัก และควรตรวจสอบรายการล่าสุดจากหน้าเว็บไซต์ก่อนทำรายการทุกครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="MAHAGAME66 รวมบาคาร่า สล็อต หวย บอล และรูเล็ตไว้ในระบบเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        บริการหลักของ MAHAGAME66 คือ <strong>เกมยอดนิยมครบทั้งบาคาร่า สล็อต หวย บอล และรูเล็ต</strong>
        พร้อมหมวดเกมไลฟ์สดที่เชื่อมต่อจากผู้ให้บริการตามข้อมูลของเว็บไซต์ สมาชิกจึงเลือกหมวดที่ต้องการได้จากบัญชีเดียว ไม่ต้องสลับไปเปิดหลายเว็บไซต์เพื่อดูว่ามีอะไรให้เล่นบ้าง
      </p>

      <p class="text-left text-base leading-relaxed">
        ก่อนเข้าเล่น สมาชิกสามารถ<strong>ตรวจสอบค่ายเกม รายละเอียดโต๊ะ และรูปแบบเดิมพันได้</strong>
        ช่วยให้เลือกเกมที่ตรงกับความสนใจได้สะดวกมากขึ้น และเมนูที่จัดหมวดหมู่ชัดเจนก็ช่วยให้หาหมวดที่ต้องการได้เร็วทั้งบนมือถือและคอมพิวเตอร์
      </p>
    </div>
  </ContentBox>

  <ContentBox title="โปรโมชั่น MAHAGAME66 แนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        โปรโมชั่นของ MAHAGAME66 <strong>มีสิทธิ์ให้สมาชิกเลือกหลายรูปแบบตามเงื่อนไขของแต่ละรายการ</strong>
        โดยสามารถตรวจสอบรายละเอียดได้หลังสมัคร ทั้งโบนัสแนะนำเพื่อน 0.8% สำหรับสมาชิกที่แนะนำเพื่อนเข้ามาสมัคร และโบนัสคืนยอดเสีย 0.3% ตามยอดและเงื่อนไขที่กำหนด
      </p>

      <p class="text-left text-base leading-relaxed">
        ระบบ<strong>แสดงข้อมูลเกี่ยวกับยอดที่เข้าเกณฑ์ รอบรับสิทธิ์ และเงื่อนไขก่อนกดรับอย่างชัดเจน</strong>
        สมาชิกจึงติดตามสิทธิ์ของตัวเองในแต่ละรอบได้จากบัญชีสมาชิก และควรอ่านเงื่อนไขของรายการที่สนใจให้ครบก่อนกดรับทุกครั้ง เพราะแต่ละรายการมีรอบคำนวณไม่เหมือนกัน
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/promotion"
          aria-label="ดูภาพโปรโมชั่นทั้งหมดของ MAHAGAME66"
          class="flex items-center justify-center rounded-lg border border-[#de161d] bg-[#16090a] px-8 py-3 font-bold transition-all hover:scale-105 hover:border-[#ff4d52] hover:bg-[#26100f]">
          ดูโปรโมชั่นทั้งหมด
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="ระบบฝากถอน MAHAGAME66 รองรับวอลเลทและธนาคาร" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        ระบบของ MAHAGAME66 <strong>รองรับช่องทางฝากถอนผ่านวอลเลทและธนาคารตามรายการที่เว็บไซต์เปิดให้ใช้งาน</strong>
        สมาชิกสามารถเลือกช่องทางที่สะดวก พร้อมตรวจสอบยอดและสถานะรายการผ่านบัญชีได้โดยตรง ไม่ต้องรอถามจากช่องทางอื่นเพื่อดูว่ารายการไปถึงขั้นไหนแล้ว
      </p>

      <p class="text-left text-base leading-relaxed">
        <strong>ขั้นตอนถูกจัดให้เข้าใจง่าย ช่วยให้จัดการเครดิตได้จากหน้าเดียว</strong>
        และเนื่องจากช่องทางที่เปิดใช้งานเป็นไปตามรายการที่เว็บไซต์กำหนด จึงควรเช็กช่องทางที่รองรับอยู่ในขณะนั้นอีกครั้งก่อนเริ่มทำรายการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ใช้งาน MAHAGAME66 ได้ทั้งมือถือและคอมพิวเตอร์จากบัญชีเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        MAHAGAME66 <strong>รองรับการใช้งานผ่านมือถือและคอมพิวเตอร์</strong>
        เมนูจัดหมวดหมู่ชัดเจน ช่วยให้สมาชิกเลือกเกมที่ต้องการได้ง่ายจากบัญชีเดียว ไม่ต้องจำหลายบัญชีเมื่อสลับอุปกรณ์ระหว่างวัน
      </p>

      <p class="text-left text-base leading-relaxed">
        หลังเข้าสู่ระบบ สมาชิกสามารถเปิดดูหมวดเกม ตรวจสอบค่ายเกมและรายละเอียดโต๊ะ ดูเงื่อนไขของโปรโมชั่นที่เปิดให้กดรับ
        ไปจนถึง<strong>ตรวจสอบยอดและสถานะรายการฝากถอนได้จากบัญชีเดียวกัน</strong>
      </p>

      <p class="text-left text-base leading-relaxed">
        <strong>ผลของเกมทุกประเภทตัดสินจากผลของรอบนั้น ไม่มีสูตรหรือรูปแบบเดิมพันใดรับประกันผล</strong>
        จึงควรกำหนดงบประมาณก่อนทำรายการทุกครั้ง และหยุดเมื่อถึงขีดที่ตั้งไว้
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก MAHAGAME66"
          class="flex items-center justify-center rounded-lg border border-[#ff4d52]/60 bg-gradient-to-r from-[#ff4d52] via-[#de161d] to-[#7a0a0e] px-8 py-3 font-black text-[#fff6f5] shadow-[0_0_15px_rgba(222,22,29,0.50)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ MAHAGAME66"
          class="flex items-center justify-center rounded-lg border border-[#de161d] bg-[#16090a] px-8 py-3 font-bold transition-all hover:scale-105 hover:border-[#ff4d52] hover:bg-[#26100f]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="แอดมิน MAHAGAME66 ให้บริการตลอด 24 ชั่วโมง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        หากมีข้อสงสัยเกี่ยวกับการสมัคร ทางเข้าเกม โปรโมชั่น บาคาร่า สล็อต หวย บอล รูเล็ต หรือระบบฝากถอน สามารถ
        <strong>ติดต่อแอดมิน MAHAGAME66 ได้ตลอด 24 ชั่วโมง</strong>
        ทีมงานพร้อมช่วยตรวจสอบข้อมูลและแนะนำขั้นตอนตามปัญหาที่แจ้ง เพื่อให้สมาชิกเข้าถึงข้อมูลได้สะดวกทุกช่วงเวลา
      </p>

      <p class="text-left text-base leading-relaxed">
