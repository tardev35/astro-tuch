---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char, so a byte count reads
// ~3x too long). One string, reused by MainLayout's meta and the WebPage node.
// This page is 159.
const pageDescription = "รู้จัก FAH999 ศูนย์รวมเกมสล็อตออนไลน์ที่มีสล็อตธีมเอเชีย เกมโบนัส และเกมบนมือถือ พร้อมโปรโมชั่นสมาชิกตามเงื่อนไข ระบบฝากถอนออนไลน์ และแอดมินดูแลตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ FAH999 ศูนย์รวมเกมสล็อตออนไลน์ธีมเอเชีย",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา FAH999 ศูนย์รวมเกมสล็อตออนไลน์ธีมเอเชีย เล่นง่ายทุกอุปกรณ์" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ FAH999" as="h1">
    <p class="mb-6 text-left text-base leading-relaxed text-[#e6cfe9]">
      <strong class="text-[#fb44b3]">FAH999</strong> คือ <strong class="text-[#fb44b3]">จุดรวมเกมสล็อตออนไลน์สำหรับผู้ที่ต้องการเลือกเล่นเกมหลากหลายรูปแบบ</strong>
      ทั้งผ่านมือถือและคอมพิวเตอร์ ภายในเว็บมีทั้งสล็อตธีมเอเชีย เกมโบนัส และเกมที่ออกแบบมาให้เล่นบนมือถือโดยเฉพาะ รองรับการใช้งานผ่านเบราว์เซอร์บนมือถือ แท็บเล็ต และคอมพิวเตอร์ โดยไม่ต้องติดตั้งโปรแกรมเพิ่ม
    </p>

    <p class="mb-2 text-left text-base leading-relaxed text-[#e6cfe9]">
      สมาชิกจัดการทุกอย่างได้จากบัญชีเดียว ทั้งการเลือกเกมสล็อต ตรวจสอบโปรโมชั่นที่มีสิทธิ์รับตามเงื่อนไข ฝากถอนผ่านระบบออนไลน์ และดูประวัติรายการย้อนหลัง พร้อม
      <strong class="text-[#fb44b3]">แอดมิน FAH999 คอยให้คำแนะนำและตรวจสอบรายการให้ตลอด 24 ชั่วโมง</strong>
      ทั้งนี้ก่อนกรอกข้อมูลบัญชีหรือทำธุรกรรมทุกครั้ง ควรตรวจสอบว่าลิงก์ที่กำลังเปิดอยู่เป็นช่องทางที่ผู้ให้บริการประกาศไว้จริง
    </p>
  </ContentBox>

  <ContentBoxPlain title="เกมสล็อตธีมเอเชียและเกมโบนัสที่ FAH999 รวมไว้ให้เลือกเล่น" as="h2">
    <p class="mb-2 text-left text-base leading-relaxed text-[#e6cfe9]">
      ภายใน FAH999 มีเกมสล็อตหลายรูปแบบให้เลือก ทั้ง <strong class="text-[#fb44b3]">สล็อตธีมเอเชีย เกมที่มีระบบโบนัสในตัว และเกมที่ออกแบบหน้าจอมาให้เล่นบนมือถือ</strong>
      สำหรับคนที่ยังไม่รู้ว่าจะเริ่มจากเกมไหนดี สามารถลองดูเกมจาก PG SOFT อย่าง Mahjong Ways 2, Fortune Tiger และ Lucky Neko ซึ่งแต่ละเกมมีรูปแบบแตกต่างกัน ทั้งระบบฟรีสปิน ตัวคูณ และจำนวนวงล้อ
    </p>

    <p class="mt-3 mb-2 text-left text-base leading-relaxed text-[#e6cfe9]">
      ก่อนเลือกเล่นควรอ่านรายละเอียดของเกมและ Paytable ให้ครบ แล้ว
      <strong class="text-[#fb44b3]">เลือกจำนวนเดิมพันให้เหมาะกับงบประมาณของตัวเอง</strong>
      เพราะแต่ละเกมกำหนดเงื่อนไขฟีเจอร์และระดับ RTP ไว้ไม่เหมือนกัน ข้อมูลเหล่านี้แสดงอยู่ในหน้าเกมโดยตรง และอาจปรับเปลี่ยนได้ตามรอบที่ผู้ให้บริการเกมกำหนด
    </p>
  </ContentBoxPlain>

  <ContentBoxPlain title="โปรโมชั่นสมาชิก FAH999 และเงื่อนไขที่ควรตรวจสอบก่อนกดรับ" as="h2">
    <p class="mb-2 text-left text-base leading-relaxed text-[#e6cfe9]">
      สมาชิกตรวจสอบโปรโมชั่น FAH999 ที่กำลังเปิดให้รับได้จากบัญชีผู้ใช้งานและหน้าโปรโมชั่น โดยรายการหลักตามข้อมูลที่กำหนดคือ
      <strong class="text-[#fb44b3]">โบนัส <span class="text-[#c98cff]">0.8%</span> ที่รับได้ทุกวัน</strong> ซึ่งสิทธิ์ในการรับควรเป็นไปตามยอดและเงื่อนไขของกิจกรรมในรอบนั้น
    </p>

    <p class="mt-3 mb-2 text-left text-base leading-relaxed text-[#e6cfe9]">
      โบนัสแต่ละรายการอาจกำหนดยอดที่นำมาคำนวณ เกมที่เข้าร่วม รอบรับสิทธิ์ และข้อกำหนดการถอนแตกต่างกัน สมาชิกจึงควร
      <strong class="text-[#fb44b3]">ตรวจสอบรอบคำนวณ ยอดที่นำมาคิดโบนัส และข้อกำหนดการถอนก่อนกดรับทุกครั้ง</strong>
      เพื่อให้เข้าใจรายละเอียดของโปรโมชั่นอย่างครบถ้วน เนื่องจากรายละเอียดอาจมีการเปลี่ยนแปลงได้
    </p>
  </ContentBoxPlain>

  <ContentBoxPlain title="ระบบฝากถอนออนไลน์และการดูแลสมาชิกของทีมงาน FAH999" as="h2">
    <p class="mb-4 text-left text-base leading-relaxed text-[#e6cfe9]">
      ระบบของ FAH999 รองรับการฝากถอนและการจัดการบัญชีแบบออนไลน์ สมาชิกเปิดบัญชีผ่านหน้าสมัครได้ด้วยขั้นตอนที่ไม่ซับซ้อน เริ่มจากกรอกข้อมูลตามที่ระบบร้องขอ จากนั้น Login แล้วตรวจสอบเครดิต ประวัติรายการ
      และช่องทางฝากถอนที่เปิดให้บริการได้จากระบบสมาชิก โดยควรใช้ข้อมูลที่ถูกต้องในการสมัคร และ
      <strong class="text-[#fb44b3]">ไม่เปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น</strong>
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#e6cfe9]">
      หากพบปัญหา Login ไม่ได้ ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินล่าช้า โปรโมชั่นไม่แสดง หรือเข้าเกมสล็อตไม่ได้ สามารถติดต่อ
      <strong class="text-[#fb44b3]">แอดมิน FAH999 ได้ตลอด 24 ชั่วโมง</strong> พร้อมแจ้งรายละเอียดของรายการ จำนวนเงิน และช่วงเวลาที่เกิดปัญหา เพื่อให้ทีมงานค้นหารายการและตรวจสอบได้ตรงจุด
      รวมถึงสอบถามข้อมูลเกี่ยวกับเกม โปรโมชั่น และขั้นตอนการใช้งานสำหรับสมาชิกใหม่ได้เช่นกัน
    </p>

    <p class="mb-6 text-left text-base leading-relaxed text-[#e6cfe9]">
      ทั้งนี้ <strong class="text-[#fb44b3]">การเดิมพันมีความเสี่ยงและไม่มีเกมใดรับประกันผลรางวัลได้</strong> ผู้เล่นจึงควรกำหนดงบประมาณของตัวเองก่อนเล่นทุกครั้ง และเล่นเท่าที่รับความเสี่ยงไหว
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก FAH999"
        class="flex items-center justify-center rounded-lg bg-gradient-to-r from-[#fb44b3] via-[#c2249b] to-[#6b1fa8] px-8 py-3 font-black text-[#fdeaf8] shadow-[0_0_15px_rgba(194,36,155,0.32)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ FAH999"
        class="flex items-center justify-center rounded-lg border border-[#c2249b]/70 bg-transparent px-8 py-3 font-bold text-[#e6cfe9] transition-all hover:scale-105 hover:border-[#fb44b3] hover:bg-[#2a0640]/70">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
