---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login, /register,
// /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx
// ที่ใช้กับ index.astro — บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES
// ที่ให้ body มา ทั้งหน้าจึงเขียนขึ้นใหม่จากข้อเท็จจริงและคลังคำของบรีฟรอบนี้เท่านั้น
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x4 · h3x0
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) จึงเปิดใช้งานอยู่ และ brand-spec §8 สั่งให้คงไว้
// ไม่ได้ park ลง src/pages-disabled/
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// ตัวที่ routing จริงคือไฟล์นี้ Astro ไม่อ่านโฟลเดอร์นั้นเลย ห้ามแก้และห้ามลบ
//
// ⚠️ ดรอปนี้ (2026-10-18) คือ **เว็บสล็อตล้วน** ไม่ใช่หมวดอื่นใดทั้งสิ้น
// สองหน้าของหมวดที่แบรนด์ก่อนๆ เคยเปิดจอดอยู่ใน src/pages-disabled/ ไม่มี route
// ห้ามลิงก์ไปหา เป็น href ตายที่ทำให้ build แดง route ที่มีจริงรอบนี้คือ
// / · /about-us · /contact-us · /login · /register · /privacy · /promotion ·
// /terms · /ทดลองเล่น · /ทางเข้า · /line
//
// ⚠️ แบรนด์ก่อนหน้า (ที่ถูกแทนที่รอบนี้) ก็เป็นแบรนด์สล็อตเหมือนกัน คอปปี้เดิมจึง
// "ดูเข้าเค้า" ทั้งที่กรอบของบรีฟคนละอัน — **ห้าม find-and-replace ทับประโยคเดิม**
// ทั้งหน้าถูกเขียนใหม่รอบกรอบของบรีฟรอบนี้: **ฐานหลักเว็บสล็อตลิขสิทธิ์แท้
// นำเข้าตรงจากสิงคโปร์** ที่รวม **3 ค่ายหลัก PG SOFT · JOKER · JILI** ไว้ในเว็บไซต์เดียว
// ไม่ใช่กรอบ "ศูนย์บริการ/ศูนย์รวมช่องทาง" ของรอบก่อน ซึ่งถูกถอดออกหมดทั้งไฟล์แล้ว
// (คำต้องห้ามไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive
// ในคอมเมนต์ของไฟล์นี้เอง — รายการเต็มอยู่ใน brand-spec §6)
//
// แง่มุมที่บรีฟรอบนี้ระบุไว้มีเท่านี้ (ห้ามเติมอย่างอื่น): ฐานหลัก ·
// เว็บสล็อตลิขสิทธิ์แท้ · นำเข้าตรงจากสิงคโปร์ · ค่ายเกมมาตรฐานสากล ·
// PG SOFT · JOKER · JILI · 3 ค่ายหลัก · เกมสล็อตออนไลน์ · สมัครสมาชิก ·
// ลงทะเบียน · เข้าใช้งาน · เข้าสู่ระบบ · โปรโมชั่น · คืนยอดเสีย 0.3% ·
// แนะนำเพื่อน 0.8% · เครดิต · ยอดเดิมพัน · รอบการคำนวณ · รหัสแนะนำ ·
// ตารางการจ่ายรางวัล · ฟีเจอร์ · กติกา · LINE Official · QR Code ·
// บัญชีแอบอ้าง · รหัสผ่าน · รหัส OTP · ฝากถอน · เจ้าหน้าที่ · หลักฐาน ·
// ผู้ให้บริการ · สถานะลิขสิทธิ์ · ข้อกำหนดบริการ · อายุผู้ใช้งาน
//
// ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 100% · 3 ขั้นตอน · 3 ค่าย ·
// 24 ชั่วโมง ส่วนตัวเลขและชื่อเฉพาะที่ห้ามแต่งขึ้นเองอยู่ครบใน brand-spec §6
// (เลขใบอนุญาต · ชื่อนิติบุคคล · ชื่อธนาคาร · ค่า RTP · ยอดฝากขั้นต่ำ ·
// จำนวนสมาชิก · ปีก่อตั้ง · ค่ายเกมอื่นนอกจากสามค่ายข้างบน)
//
// ประโยคกำกับ (hedge) ที่บรีฟเขียนไว้เองและห้ามตัดทิ้งเพราะฟังดูไม่ขายของ:
// 1) ข้อมูลเกี่ยวกับลิขสิทธิ์และแหล่งที่มาของระบบควรตรวจสอบจากหลักฐานของ
//    ผู้ให้บริการโดยตรง (h1)
// 2) ข้อมูลการเชื่อมต่อระบบจากสิงคโปร์และสถานะลิขสิทธิ์ควรตรวจสอบกับผู้ให้บริการ
//    โดยตรง เพื่อให้ได้รับข้อมูลที่ถูกต้องและเป็นปัจจุบัน (h2 #1)
// 3) ก่อนเข้าร่วมควรตรวจสอบระยะเวลาของแคมเปญ เงื่อนไขยอดเดิมพัน และวิธีรับเครดิต ·
//    เครดิตคืนยอดเสียไม่ได้รับประกันผลตอบแทนจากการเล่นครั้งต่อไป (h2 #2)
// 4) ควรอ่านข้อกำหนดเกี่ยวกับอายุผู้ใช้งานและเงื่อนไขบริการก่อนสมัคร ·
//    ไม่ใช้ข้อมูลของผู้อื่นหรือเปิดเผยรหัสยืนยันให้บุคคลภายนอก (h2 #3)
// 5) ควรตรวจสอบลิงก์หรือ QR Code จากเว็บไซต์ทางการก่อนเพิ่มเพื่อน เพื่อหลีกเลี่ยง
//    บัญชีแอบอ้าง · ควรตรวจสอบเวลาการให้บริการและระยะเวลาตอบกลับล่าสุดจาก
//    ช่องทางทางการอีกครั้ง (h2 #4)
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ทองนำ ชมพูบานเย็นเป็นฮิวที่สองจริง
// พลัมเข้มเป็นเงาที่ไม่เคยถือตัวอักษร บนดำสนิท**
// ⚠️ แบรนด์ก่อนๆ มีทองแทบทุกราย "มีทองอยู่" จึงไม่ใช่ตัวบอกว่าถูกแบรนด์ ให้เทียบ
// เป็น "ค่า" ทีละตัวกับตารางใน brand-spec §2 (ค่าเดิมไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้
// grep หาสีแบรนด์เก่าเจอ false positive) สิ่งที่ทำให้รอบนี้ต่างจริงคือ
// **ชมพูบานเย็น #f5469f** ซึ่งเป็นฮิวที่สองที่วัดได้จากทั้งโลโก้และแบนเนอร์
// ลำดับความลึก: #24101c ผิวยก (= การ์ด) / #160a12 กลาง / #0b0509 จม / #000000 พื้นเพจ
//
// ลำดับปุ่มสื่อด้วย "ทองถม vs ผิวจมขอบพลัม" — คู่พื้น-หมึกคำนวณไว้แล้ว:
// · ปุ่มหลัก (สมัครสมาชิก) ถมทองไล่ #ffeaa0 → #fcd434 ขอบ #7a5508 หมึก #1a0612
//   (13.5:1 บนปลายทองแบรนด์) ⚠️ ไล่เฉดต้องหยุดที่ #fcd434 ห้ามไล่เข้มกว่านั้น
//   ใต้ตัวอักษร
// · ปุ่มรอง/ปุ่มลิงก์ภายในเป็นชั้นจม #160a12 → #0b0509 ขอบ #8c0f52/60
//   ตัวอักษร #f6e4ee — hover ยกขอบเป็นชมพูบานเย็น #f5469f
// · marker ของลำดับเลขใช้ชมพูอ่อน #ff8dc6 (8.6:1 บนผิวการ์ด — เป็นตัวอักษร จึงใช้
//   พลัมเข้มไม่ได้ และ #ffeaa0 สงวนไว้ให้ <strong> เท่านั้น)
// · #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ (§2)
// ⚠️ #8c0f52 · #7a5508 ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่เส้นขอบ ออรา เงา และพื้นถม
// — ออราในไฟล์นี้ใช้ rgba(140,15,82,α) · rgba(252,212,52,α) · rgba(245,70,159,α)
// เท่านั้น และรอบนี้ไม่มีม่วง ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว ไม่มีส้ม
// ไม่มีเงิน/โครเมียมอมฟ้า ไม่มีโรสโกลด์ และไม่มีแดงชาด
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #f6e4ee,
// 14.9:1 บนผิวยก #24101c) ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง
// ปล่อยให้สืบทอดลงมา และไม่ใส่ mx-auto / max-w-* บน <p> เพราะการ์ดคุมความกว้างเองแล้ว
// — ที่ประกาศสีได้มีแค่ปุ่ม (ถมพื้นของตัวเองจึงต้องกำหนดหมึกของตัวเอง) marker ของ
// ลำดับเลข และ <strong> ซึ่ง brand-spec §2 สงวน #ffeaa0 (15.2:1 บนผิวการ์ด) ไว้เป็น
// สีไฮไลต์ในเนื้อความโดยเฉพาะ และไม่ใช้สีอื่นเลย · แต่ละ <strong> ครอบ "ช่วงที่คั่น
// ด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ
// บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง (ลบแท็ก <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิม)
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้าง
// จากหน้า และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้หมุนมาเป็น Announcement3 ทั้งเว็บ (brand-spec §3)
// orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียก
// แบบ bare ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 156 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} ฐานหลักเว็บสล็อตลิขสิทธิ์แท้ นำเข้าตรงจากสิงคโปร์ รวมค่ายเกมมาตรฐานสากล PG SOFT JOKER JILI 3 ค่ายหลัก พร้อมโปรโมชั่นและวิธีสมัครสมาชิก`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} ฐานหลักเว็บสล็อตลิขสิทธิ์แท้ นำเข้าตรงจากสิงคโปร์`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#ffeaa0]">{BRAND_NAME} เป็นฐานหลักเว็บสล็อตลิขสิทธิ์แท้ ที่นำเสนอเกมสล็อตออนไลน์จากค่ายเกมมาตรฐานสากล PG SOFT JOKER และ JILI</strong>
        พร้อมรวบรวมข้อมูลเกี่ยวกับการสมัครสมาชิก การเข้าใช้งาน และโปรโมชั่นไว้ในเว็บไซต์เดียว ผู้เล่นจึงศึกษารายละเอียดของแต่ละค่ายได้ก่อนเลือกเกมที่สนใจ รวมถึงติดต่อเจ้าหน้าที่เพื่อสอบถามบริการเพิ่มเติมได้
      </p>

      <p>
        หน้านี้รวบรวมไว้ว่าเว็บไซต์จัดเตรียมอะไรไว้ให้ศึกษาบ้าง ตั้งแต่ 3 ค่ายหลักที่เปิดให้เลือก รายการโปรโมชั่นที่ระบุไว้ ขั้นตอนลงทะเบียน 3 ขั้นตอน ไปจนถึงช่องทางติดต่อแอดมิน
        <strong class="text-[#ffeaa0]">เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดดูอะไรตรงไหน</strong>
        แล้วจึงค่อยศึกษากติกาและเงื่อนไขของแต่ละเรื่องเป็นรายข้อ
      </p>

      <p>
        เนื้อหาในหน้านี้เขียนไว้ประกอบการศึกษาเท่านั้น ไม่ได้ใช้แทนรายละเอียดและข้อกำหนดบริการที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้งาน
        <strong class="text-[#ffeaa0]">โดยข้อมูลเกี่ยวกับลิขสิทธิ์และแหล่งที่มาของระบบควรตรวจสอบจากหลักฐานของผู้ให้บริการโดยตรง</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`3 ค่ายเกมมาตรฐานสากล PG SOFT JOKER JILI ที่ ${BRAND_NAME} รวบรวมไว้`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} นำเสนอเกมสล็อตจาก 3 ค่ายหลัก ซึ่งแต่ละค่ายมีแนวเกมและฟีเจอร์แตกต่างกันในแต่ละเกม
        <strong class="text-[#ffeaa0]">ผู้เล่นสามารถศึกษากติกา ตารางการจ่ายรางวัล และคุณสมบัติของเกมก่อนเข้าใช้งาน</strong>
        เพื่อให้เลือกเกมที่ตรงกับรูปแบบที่ตนเองสนใจได้ชัดเจนขึ้น
      </p>

      <ul class="flex flex-col gap-3" aria-label={`ค่ายเกมที่ ${BRAND_NAME} รวบรวมไว้`}>
        <li class="flex gap-3">
          <span aria-hidden="true">🎮</span>
          <span>
            <strong class="text-[#ffeaa0]">PG SOFT</strong> โดดเด่นด้านภาพและรูปแบบการเล่นบนมือถือ เหมาะกับผู้ที่ต้องการศึกษาเกมจากหน้าจอขนาดเล็กเป็นหลัก
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">🃏</span>
          <span>
            <strong class="text-[#ffeaa0]">JOKER</strong> มีเกมสล็อตหลากหลายแนวให้เลือก จึงควรอ่านกติกาและตารางการจ่ายรางวัลของแต่ละเกมก่อนเริ่มใช้งาน
