---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่ม) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง
// ไม่ได้มาจากเช็กลิสต์หัวข้อของ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน
// SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริงของ UFAGOOL เท่านั้น
//
// บรีฟรอบนี้ (ดรอป 2026-09-23) คือ "UFAGOOL กีฬาคาสิโนเว็บตรง รวมพนันออนไลน์
// ในเครือลิขสิทธิ์แท้" — แบรนด์นี้นำด้วย "กีฬา" (โลโก้และแบนเนอร์เป็นฟุตบอล)
// คอปปี้ของแบรนด์รอบก่อน (เว็บรวมพนันที่อ้างหมวดบาคาร่า ลอตเตอรี บอล ไฮโล
// และหัวข้อฝากถอนวอลเลท) ถูกเขียนใหม่ทั้งหน้าแล้ว เพราะบรีฟของ UFAGOOL
// ไม่ได้ระบุหมวดเหล่านั้นเลย ห้ามใช้ find-and-replace กับหน้านี้
// มันจะทำให้ UFAGOOL อ้างเกมที่บรีฟไม่เคยพูดถึง
//
// ข้อเท็จจริงทุกบรรทัดมาจากบรีฟรอบนี้เท่านั้น: กีฬา · คาสิโนสด · สล็อต ·
// เกมออนไลน์ประเภทอื่นตามรายการที่เปิดให้บริการ · เครือตรงแบรนด์ลิขสิทธิ์แท้
// ไม่ผ่านเอเย่นต์ · บัญชีเดียวใช้ได้ทั้งมือถือและคอมพิวเตอร์ · โปรโมชั่นสำหรับ
// สมาชิกใหม่และสมาชิกเดิม บางรายการกดรับหลังสมัครได้โดยไม่ต้องฝาก · โบนัส
// แนะนำเพื่อน 0.8% · โบนัสคืนยอดเสีย 0.3% · สมัครผ่านมือถือ 3 ขั้นตอน ·
// แอดมินดูแลตลอด 24 ชั่วโมง
// — ห้ามอ้างเลขใบอนุญาต ปีที่ก่อตั้ง เลขทะเบียนบริษัท จำนวนสมาชิก ชื่อค่ายเกม
// ค่า RTP อัตราจ่าย ขั้นต่ำการเดิมพัน "ฝากถอนออโต้ไม่มีขั้นต่ำ" "ปลอดภัย 100%"
// "เร็วที่สุด/ปลอดภัยที่สุดในไทย" หรือการันตีว่าจะชนะ เพราะบรีฟไม่ได้ระบุไว้
// และห้ามเขียนคำไทยที่แปลว่าลอตเตอรีที่ใดในหน้านี้ — UFAGOOL ไม่ใช่เว็บลอตเตอรี
// บรีฟไม่เคยเอ่ยถึง ส่วนบาคาร่า/ไฮโลก็ห้ามระบุชื่อเจาะจง ให้พูดรวมเป็น
// "คาสิโนสด" เท่านั้น
//
// Announcement รอบนี้หมุนมาใช้ Announcement3 ทั้งเว็บ — default message ของไฟล์นั้น
// เป็นคอปปี้ของ UFAGOOL อยู่แล้ว จึงเรียกแบบ bare เหมือน index.astro
// ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ UFAGOOL (แดงคริมสัน + เงินโครเมียม บนพื้นเกือบดำ แทนแดง + ทองของรอบก่อน):
// พื้นเกือบดำ #0a0708 · การ์ด #16100f · การ์ดยก #241a1a · ขอบแดงลึก #5e0507 ·
// แดงหลัก #c50d12 · แดงสว่าง #ef1f25 · แดงลึกปลายเกรเดียนต์ #7a0103 ·
// ขาวเงิน #f4f7fa ใช้กับชื่อแบรนด์และข้อความเน้น · เงินกลาง #b8c3cf ใช้กับป้าย
// เลขลำดับและไอคอน · เนื้อความ #cdd5dd (BRAND_TEXT) · ตัวอักษรบนปุ่มไล่สีแดง
// #f4f7fa · ตัวเลขโบนัส 0.8%/0.3% ใช้ #ff5a5f เท่านั้น — โทนทองและพื้นแดง
// เลือดหมูของแบรนด์รอบก่อนถูกถอดออกหมดแล้ว ห้ามนำกลับมา
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index และ /promotion
// ส่วน banner1/banner1-mobile เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า
// และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กค้างของลูกค้าเจ้าอื่น ห้าม import
//
// ห้ามลิงก์ไปสองหน้าลอตเตอรีที่ถูกพักไว้ใน src/pages-disabled/ เด็ดขาด
// การลิงก์ไปเส้นทางที่ไม่มีจริงทำให้ verify-build แดง
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 156
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "เกี่ยวกับ UFAGOOL กีฬาคาสิโนเว็บตรง รวมเดิมพันกีฬา คาสิโนสด และสล็อต ในเครือตรงแบรนด์ลิขสิทธิ์แท้ ไม่ผ่านเอเย่นต์ พร้อมโปรโมชั่นและแอดมินดูแลตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับเรา UFAGOOL กีฬาคาสิโนเว็บตรง ในเครือลิขสิทธิ์แท้ ไม่ผ่านเอเย่นต์",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา UFAGOOL กีฬาคาสิโนเว็บตรง ในเครือลิขสิทธิ์แท้ ไม่ผ่านเอเย่นต์" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับเรา UFAGOOL กีฬาคาสิโนเว็บตรง ในเครือลิขสิทธิ์แท้ ไม่ผ่านเอเย่นต์" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#cdd5dd]">
        <strong class="text-[#f4f7fa]">UFAGOOL</strong> คือกีฬาคาสิโนเว็บตรงที่
        <strong class="text-[#f4f7fa]">รวมเกมพนันออนไลน์หลายประเภทไว้ในระบบเดียว</strong>
        ทั้งการเดิมพันกีฬา คาสิโนสด สล็อต และเกมรูปแบบอื่นตามรายการที่เปิดให้บริการ พร้อมรูปแบบการเชื่อมต่อเครือตรงตามข้อมูลของเว็บไซต์ ไม่ผ่านเอเย่นต์ สมาชิกจึงเข้าถึงเกมต่าง ๆ ได้สะดวกผ่านบัญชีเดียวทั้งบนมือถือและคอมพิวเตอร์
      </p>

      <p class="text-left text-base leading-relaxed text-[#cdd5dd]">
        หน้านี้รวบรวมไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่หมวดเกมที่เลือกได้จากหน้าเดียว รายการโปรโมชั่นที่สมาชิกตรวจสอบเงื่อนไขก่อนกดรับได้ ขั้นตอนการสมัครสำหรับคนที่เพิ่งเข้ามาใช้งานครั้งแรก
        ไปจนถึงช่องทางสอบถามแอดมินเมื่อไม่แน่ใจในขั้นตอนใด
      </p>

      <p class="text-left text-base leading-relaxed text-[#cdd5dd]">
        <strong class="text-[#f4f7fa]">รายการเกมและสิทธิ์ที่เปิดให้ใช้งานอาจมีการอัปเดตตามช่วงเวลา</strong>
        รายละเอียดทั้งหมดจึงยึดตามหมวดหมู่และเงื่อนไขที่ระบบแสดงไว้จริงในช่วงนั้นเป็นหลัก และควรตรวจสอบรายการล่าสุดจากหน้าเว็บไซต์ก่อนเข้าเล่นทุกครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="UFAGOOL รวมเดิมพันกีฬา คาสิโนสด และสล็อต ไว้ให้เลือกจากหน้าเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#cdd5dd]">
        ภายในระบบของ UFAGOOL <strong class="text-[#f4f7fa]">รวมเกมพนันหลายหมวดให้เลือกจากหน้าเดียว ทั้งการเดิมพันกีฬา คาสิโนสด สล็อต และเกมรูปแบบอื่นตามรายการที่เปิดให้บริการ</strong>
        สมาชิกจึงเลือกหมวดที่สนใจได้จากเมนูเกม และสลับไปดูอีกหมวดได้จากจุดเดียวกัน โดยไม่ต้องสมัครแยกหรือเปลี่ยนไปใช้หลายเว็บไซต์
      </p>

      <p class="text-left text-base leading-relaxed text-[#cdd5dd]">
        ก่อนเข้าเล่น <strong class="text-[#f4f7fa]">สมาชิกสามารถตรวจสอบหมวดเกมและค่ายที่รองรับได้จากหน้าเว็บไซต์</strong>
        เพื่อเลือกประเภทที่เหมาะกับรูปแบบการใช้งานของตัวเอง โดยรายการที่เปิดให้บริการจะแสดงไว้ตามที่ระบบกำหนดในช่วงเวลานั้น
      </p>
    </div>
  </ContentBox>

  <ContentBox title="เครือตรงแบรนด์ลิขสิทธิ์แท้ ไม่ผ่านเอเย่นต์ ใช้บัญชีเดียวได้ทุกอุปกรณ์" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#cdd5dd]">
        จุดที่ UFAGOOL ระบุไว้ชัดเจนคือ <strong class="text-[#f4f7fa]">การเชื่อมต่อผ่านเครือแบรนด์ลิขสิทธิ์แท้โดยตรงตามข้อมูลของเว็บไซต์ ไม่ผ่านเอเย่นต์</strong>
        รูปแบบนี้ช่วยลดขั้นตอนการใช้งาน และทำให้สมาชิกเลือกเกมจากหลายค่ายได้โดยไม่ต้องสลับไปมาระหว่างหลายระบบ
      </p>

      <p class="text-left text-base leading-relaxed text-[#cdd5dd]">
        ในทางการใช้งานจริง <strong class="text-[#f4f7fa]">บัญชีเดียวใช้ได้ทั้งบนมือถือและคอมพิวเตอร์</strong>
        การเปิดหมวดเดียวกันจากคนละอุปกรณ์จึงเห็นโครงหน้าแบบเดียวกัน และไม่ต้องจำข้อมูลเข้าใช้งานหลายชุด ทำให้ย้ายจากจอเล็กไปจอใหญ่ระหว่างวันได้โดยไม่สะดุด
      </p>
    </div>
  </ContentBox>

  <ContentBox title="โปรโมชั่น UFAGOOL แนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#cdd5dd]">
        โปรโมชั่นของ UFAGOOL <strong class="text-[#f4f7fa]">มีสิทธิ์สำหรับสมาชิกใหม่และสมาชิกเดิมให้เลือกตามเงื่อนไขของแต่ละรายการ</strong>
        โดยบางโปรโมชั่นสามารถตรวจสอบและกดรับหลังสมัครได้โดยไม่ต้องฝากก่อนตามที่ระบบกำหนด แต่ละรายการมีรายละเอียดของตัวเองให้อ่านก่อนรับสิทธิ์ จึงเลือกเฉพาะรายการที่ตรงกับการใช้งานของตัวเองได้
      </p>

      <p class="text-left text-base leading-relaxed text-[#cdd5dd]">
        สมาชิกที่แนะนำเพื่อนเข้ามาสมัครสามารถรับ<strong class="text-[#ff5a5f]">โบนัสแนะนำเพื่อน 0.8%</strong>
        ตามเงื่อนไขของกิจกรรม ระบบมีรายละเอียดเกี่ยวกับยอดที่เข้าเกณฑ์และขั้นตอนรับสิทธิ์ให้ตรวจสอบ ช่วยให้ติดตามโบนัสจากการแนะนำเพื่อนได้สะดวกผ่านบัญชีสมาชิกโดยตรง
      </p>

      <p class="text-left text-base leading-relaxed text-[#cdd5dd]">
        ส่วนโปรโมชั่นคืนยอดเสียให้<strong class="text-[#ff5a5f]">โบนัส 0.3%</strong> ตามยอดและเงื่อนไขที่กำหนด สมาชิกสามารถตรวจสอบรอบคำนวณ ยอดที่เข้าเกณฑ์ และรายละเอียดก่อนกดรับได้จากหน้าโปรโมชั่น
        จึงติดตามสิทธิ์ของตัวเองในแต่ละรอบได้ชัดเจนมากขึ้น
      </p>
    </div>
  </ContentBox>

  <ContentBox title="สมัคร UFAGOOL ด้วยตัวเองผ่านมือถือ 3 ขั้นตอน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#cdd5dd]">
        การสมัคร UFAGOOL ทำผ่านมือถือได้ด้วยตัวเอง ขั้นตอนไม่ซับซ้อนและใช้เวลาไม่นาน หลังสมัครเสร็จสามารถ<strong class="text-[#f4f7fa]">
          เข้าสู่ระบบเพื่อเลือกกีฬา คาสิโน สล็อต หรือเกมประเภทที่สนใจได้ทันที
        </strong>
        โดยมีขั้นตอนหลักดังนี้
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#cdd5dd]">
        <li class="flex gap-3">
          <span class="font-bold text-[#b8c3cf]">1.</span>
          <span>เปิดหน้าสมัคร UFAGOOL ผ่านมือถือ แล้วกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#b8c3cf]">2.</span>
          <span>ตรวจสอบข้อมูลและรายละเอียดบัญชีให้ถูกต้องก่อนกดยืนยัน</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#b8c3cf]">3.</span>
          <span>ยืนยันการสมัครและเข้าสู่ระบบ จากนั้นเลือกหมวดกีฬา คาสิโน สล็อต หรือเกมที่ต้องการได้ทันที</span>
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#cdd5dd]">
        <strong class="text-[#f4f7fa]">ผลของเกมเดิมพันทุกประเภทตัดสินจากระบบของเกมนั้น ไม่มีสูตรหรือช่วงเวลาใดรับประกันผล</strong>
        จึงควรกำหนดงบประมาณก่อนเข้าเล่นทุกครั้ง และหยุดเมื่อถึงขีดที่ตั้งไว้
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก UFAGOOL"
          class="flex items-center justify-center rounded-lg border border-[#ef1f25]/60 bg-gradient-to-r from-[#ef1f25] via-[#c50d12] to-[#7a0103] px-8 py-3 font-black text-[#f4f7fa] shadow-[0_0_15px_rgba(197,13,18,0.50)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ UFAGOOL"
