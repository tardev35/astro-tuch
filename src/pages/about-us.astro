---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// PAOTUNG (เป๋าตุง) เป็นเว็บรวมเกมออนไลน์หลายหมวด ไม่ใช่เว็บหวยเฉพาะทาง —
// หวยเป็นหนึ่งในสี่หมวดเกม จึงไม่มีลิงก์ไป /ตรวจหวย หรือ /แนวทาง ในหน้านี้
// เนื้อหาทั้งหน้าอ้างอิงบรีฟของแบรนด์นี้เท่านั้น: แพลตฟอร์มแบบ Portal & Privilege
// โทนกรมท่าตัดทองเมทัลลิค ระดับลักชูรี · One-Stop Service ครบสี่หมวด
// (สล็อตออนไลน์ · บาคาร่าและคาสิโนสด · หวยรัฐบาล ลาว ฮานอย · กีฬา มวย ฟุตบอล) ·
// เดิมพันเริ่มต้นเพียง 1 บาท · โปรโมชั่นแจกทุกยูสผ่านระบบอัตโนมัติ 100% ไม่ล็อคยูส ·
// แนะนำเพื่อน 0.8% ถอนเป็นเงินสดได้ · คืนยอดเสีย 0.3% ทุกยอดการเล่น ·
// สมัครบนมือถือ 3 ขั้นตอน (OTP · ผูกบัญชีธนาคาร · ตั้งรหัสผ่าน) เติม 1 บาทเริ่มเล่นได้ ·
// ฝาก-ถอนอัตโนมัติ 3-5 วินาที ทุกธนาคารชั้นนำ ทำรายการเองได้ 24 ชั่วโมง ·
// รองรับมือถือ iOS/Android แท็บเล็ต และพีซี โดยไม่ต้องโหลดแอป ·
// แอดมิน Line Official ตลอด 24 ชั่วโมง
// — ไม่มีการอ้างใบอนุญาต การจดทะเบียนบริษัท ปีที่ก่อตั้ง จำนวนสมาชิก การันตีผลกำไร
// ตัวเลข RTP หรือชื่อค่ายเกมรายใด เพราะบรีฟไม่ได้ระบุไว้
//
// Announcement รอบนี้หมุนมาใช้ Announcement5 ทั้งเว็บ — default message ของไฟล์นั้น
// เป็นคอปปี้ของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ไม่ต้องส่ง prop
//
// พาเลตต์ PAOTUNG: พื้นการ์ดกรมท่า #04203c · น้ำเงินโลโก้ #226ca9 นำโครงสร้าง
// (ขอบ ไอคอน เงา) · ฟ้าสว่าง #3b9ddd / #7fc4f0 สำหรับ hover และข้อความเน้นรอง ·
// ทองเมทัลลิค #e0bd72 กับทองอ่อน #f5e3b3 ใช้กับ <strong> ในเนื้อความและปุ่มสมัคร ·
// เนื้อความ #cfdeed — แบรนด์นี้ไม่มีสีแดงเลย ข้อควรระวังจึงใช้ฟ้าสว่าง #7fc4f0
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 159
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "เกี่ยวกับ PAOTUNG ศูนย์รวมเกมออนไลน์ครบวงจร ทั้งสล็อต บาคาร่า คาสิโนสด หวย มวย ฟุตบอล เดิมพันเริ่มต้น 1 บาท ระบบอัตโนมัติ 100% ไม่ล็อคยูส แอดมินดูแล 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ PAOTUNG ศูนย์รวมเกมออนไลน์แบบ Portal & Privilege",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา PAOTUNG รวมเกมออนไลน์ เดิมพันเริ่มต้น 1 บาท" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ PAOTUNG ศูนย์รวมเกมออนไลน์แบบ Portal & Privilege" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#cfdeed]">
        <strong class="text-[#f5e3b3]">PAOTUNG (เป๋าตุง)</strong> คือ<strong class="text-[#f5e3b3]">ศูนย์รวมเกมออนไลน์</strong>ที่ออกแบบแพลตฟอร์มในรูปแบบ
        <strong class="text-[#e0bd72]">Portal &amp; Privilege</strong> เพื่อเชื่อมต่อทุกความบันเทิงไว้ในที่เดียว ทุกอย่างอยู่ในบัญชีเดียว ตั้งแต่สมัครสมาชิก เข้าสู่ระบบ ฝากถอนเครดิต กดรับโปรโมชั่น ไปจนถึงการเข้าเล่นทุกหมวดเกม
        โดยไม่ต้องสลับไปมาระหว่างหลายระบบ
      </p>

      <p class="text-left text-base leading-relaxed text-[#cfdeed]">
        หน้าอินเทอร์เฟซของเราใช้<strong class="text-[#e0bd72]">โทนสีกรมท่า (Navy Blue) สลับกับลวดลายสีทองเมทัลลิค (Gold Metallic)</strong>
        เพื่อมอบความรู้สึกพรีเมียมและความลักชูรีในทุกครั้งที่เข้าใช้งาน ควบคู่กับเกมลิขสิทธิ์แท้ครบทุกค่าย หน้านี้รวบรวมไว้ว่าเว็บไซต์เปิดให้ทำอะไรได้บ้าง ตั้งแต่หมวดเกมที่ให้บริการ โปรโมชั่นที่กดรับสิทธิ์ได้เอง
        ขั้นตอนสมัครสมาชิกบนมือถือ ไปจนถึงช่องทางติดต่อทีมงาน
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="PAOTUNG รวมเกมครบวงจร สล็อต บาคาร่า หวย มวย และฟุตบอล" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#cfdeed]">
        ที่ PAOTUNG เราคืออาณาจักรความบันเทิงแบบครบวงจร <strong class="text-[#f5e3b3]">(One-Stop Service)</strong> ที่รวบรวมเกมยอดฮิตจากทุกมุมโลกมาไว้ในเว็บเดียว และเปิดโอกาสให้ทุกคนเข้าถึงความสนุกได้ด้วยข้อเสนอ
        <strong class="text-[#e0bd72]">เดิมพันเริ่มต้นเพียง 1 บาท</strong>
        โดยช่วงเดิมพันต่ำสุด-สูงสุดของแต่ละเกมกำหนดไว้ไม่เท่ากัน ให้ยึดค่าที่ระบบแสดงในตัวเกมเป็นหลัก
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#cfdeed]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#7fc4f0]">🎰</span>
          <span><strong class="text-[#f5e3b3]">สล็อตออนไลน์</strong> รวมค่ายสล็อตระดับโลกที่มาพร้อมภาพกราฟิกคมชัด จัดเต็มด้วยแสงเงาสมจริงแบบ Cinematic Lighting ให้ทุกการสปินตื่นตาตื่นใจ</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#7fc4f0]">🃏</span>
          <span><strong class="text-[#f5e3b3]">บาคาร่าและคาสิโนสด</strong> สัมผัสบรรยากาศโต๊ะวีไอพีเสมือนจริง ส่งตรงสัญญาณภาพสดจากคาสิโนชั้นนำ เล่นง่าย จ่ายไว</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#7fc4f0]">🎫</span>
          <span><strong class="text-[#f5e3b3]">หวยออนไลน์</strong> รับแทงหวยทุกประเภท ทั้งหวยรัฐบาล หวยลาว และหวยฮานอย ให้อัตราจ่ายสูง จ่ายเต็มไม่มีอั้น</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#7fc4f0]">🥊</span>
          <span><strong class="text-[#f5e3b3]">เดิมพันกีฬา มวย และฟุตบอล</strong> อัปเดตราคาค่าน้ำดีที่สุด ครบทุกแมตช์ ทุกลีกดัง ให้คอกีฬาได้ลุ้นมันส์ทุกวินาที</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#cfdeed]">
        <strong class="text-[#7fc4f0]">รายชื่อเกมและตารางการแข่งขันที่เปิดรับเดิมพันเปลี่ยนแปลงได้ตามรอบ จึงควรตรวจสอบรายการล่าสุดและอัตราจ่ายจากหน้าเลือกเกมในเว็บก่อนยืนยันทุกครั้ง</strong>
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="โปรโมชั่น PAOTUNG แจกทุกยูส ไม่ล็อคยูส แนะนำเพื่อน 0.8% คืนยอดเสีย 0.3%" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#cfdeed]">
        เราให้ความสำคัญกับการมอบผลตอบแทนที่คุ้มค่าที่สุดให้กับสมาชิก PAOTUNG จึงจัดเต็มโปรโมชั่นสุดพิเศษที่พร้อม <strong class="text-[#f5e3b3]">แจกหนักให้ทุกยูสเซอร์อย่างเท่าเทียม</strong>
        และทุกรายการ <strong class="text-[#e0bd72]">ทำงานผ่านระบบอัตโนมัติ 100% การันตีไม่มีการล็อคยูส</strong> ให้มั่นใจในความโปร่งใสและรับสิทธิประโยชน์ได้อย่างเต็มที่
      </p>

      <p class="text-left text-base leading-relaxed text-[#cfdeed]">
        <strong class="text-[#e0bd72]">โปรโมชั่นแนะนำเพื่อน 0.8%</strong> ยิ่งแชร์ยิ่งรับทรัพย์ เพียงคัดลอกลิงก์ส่วนตัวของคุณส่งให้เพื่อนสมัครและเข้าเล่น คุณก็จะได้รับค่าคอมมิชชั่นสูงถึง 0.8% จากทุกยอดการเดิมพันของเพื่อน
        ถือเป็นการสร้างรายได้เสริมแบบ Passive Income ที่มั่นคงและสามารถถอนเป็นเงินสดได้ตลอดเวลา
      </p>

      <p class="text-left text-base leading-relaxed text-[#cfdeed]">
        <strong class="text-[#e0bd72]">โปรโมชั่นคืนยอดเสีย 0.3%</strong> เพื่อดูแลสมาชิกในทุกจังหวะของการเดิมพัน เรามีระบบรองรับความเสี่ยงด้วยการคืนยอดเสีย 0.3% ในทุกยอดการเล่น เพื่อให้คุณมีเครดิตสำรองสำหรับนำกลับไปต่อยอดสร้างกำไรในรอบถัดไปได้อย่างสบายใจ
        <strong class="text-[#7fc4f0]">โดยก่อนกดรับควรอ่านรอบการคำนวณและเงื่อนไขของโปรโมชั่นล่าสุดให้ครบถ้วนทุกครั้ง</strong>
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="สมัครสมาชิก PAOTUNG บนมือถือด้วยตัวเองใน 3 ขั้นตอน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#cfdeed]">
        เริ่มต้นสัมผัสแพลตฟอร์มระดับพรีเมียมได้ง่ายๆ ผ่าน<strong class="text-[#f5e3b3]">ระบบสมัครสมาชิกอัตโนมัติ</strong>ที่ออกแบบมาให้ใช้งานบนโทรศัพท์มือถือได้อย่างสมบูรณ์แบบ
        ใช้เวลาเพียงไม่กี่วินาทีด้วย 3 ขั้นตอนดังนี้
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#cfdeed]">
        <li class="flex gap-3">
          <span class="font-bold text-[#7fc4f0]">1.</span>
          <span><strong class="text-[#f5e3b3]">กรอกเบอร์โทรศัพท์</strong> ระบุเบอร์มือถือของคุณเพื่อรับรหัส OTP สำหรับยืนยันตัวตนและรักษาความปลอดภัยของบัญชี</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#7fc4f0]">2.</span>
          <span><strong class="text-[#f5e3b3]">ผูกบัญชีธนาคาร</strong> เลือกธนาคารและกรอกเลขบัญชีที่ต้องการใช้ทำรายการฝาก-ถอน โดยชื่อ-นามสกุลต้องตรงกับชื่อบัญชีที่สมัครเท่านั้น</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#7fc4f0]">3.</span>
          <span><strong class="text-[#f5e3b3]">ตั้งรหัสผ่าน</strong> กำหนด Username และ Password เพื่อความปลอดภัย จากนั้นล็อคอินเข้าสู่ระบบ เติมเงินเพียง 1 บาทก็เริ่มสนุกได้ทันที</span>
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#cfdeed]">
        หลังเปิดบัญชีแล้วสามารถทำรายการต่อได้ด้วยตัวเองทั้งหมด ระบบฝาก-ถอนเงินอัตโนมัติ (Auto) ทำรายการเสร็จสิ้นภายใน
        <strong class="text-[#e0bd72]">3-5 วินาที</strong> รองรับทุกธนาคารชั้นนำ และทำรายการได้เองตลอด 24 ชั่วโมง ส่วนอินเทอร์เฟซพัฒนามาเพื่อรองรับทุกอุปกรณ์ ทั้งโทรศัพท์มือถือระบบ iOS และ Android แท็บเล็ต
        หรือคอมพิวเตอร์พีซี ได้อย่างไหลลื่นโดยไม่ต้องโหลดแอปพลิเคชัน
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ติดต่อทีมงาน PAOTUNG ผ่าน Line Official ตลอด 24 ชั่วโมง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#cfdeed]">
        <strong class="text-[#f5e3b3]">การดูแลลูกค้าระดับ VIP คือมาตรฐานของเรา</strong> PAOTUNG มีทีมงานแอดมินมืออาชีพที่พร้อมให้บริการและดูแลสมาชิกทุกท่านอย่างใกล้ชิด และเปิด <strong
          class="text-[#e0bd72]">
          ช่องทางติดต่อผ่าน Line Official ตลอด 24 ชั่วโมง
        </strong>
        ไม่ว่าจะต้องการสอบถามข้อมูล ติดปัญหาการเข้าใช้งาน หรือต้องการคำแนะนำเกี่ยวกับระบบแพลตฟอร์ม ทีมงานของเราพร้อมตอบกลับอย่างรวดเร็ว สุภาพ และใส่ใจ เพื่อให้ทุกการเดิมพันของคุณลื่นไหลที่สุด
      </p>

      <p class="text-left text-base leading-relaxed text-[#cfdeed]">
        เวลาแจ้งปัญหา ควรระบุเวลา จำนวนเงิน และข้อมูลรายการที่เกี่ยวข้องให้ครบ เพื่อให้เจ้าหน้าที่ตรวจสอบได้ตรงจุด
        <strong class="text-[#7fc4f0]">และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่นระหว่างการติดต่อเจ้าหน้าที่ไม่ว่ากรณีใด</strong>
      </p>

      <p class="text-left text-base leading-relaxed text-[#cfdeed]">
        <strong class="text-[#7fc4f0]">การเดิมพันมีความเสี่ยงและผลของแต่ละรอบไม่แน่นอน ไม่มีเกมใดรับประกันผลล่วงหน้า</strong> สมาชิกจึงควรกำหนดงบประมาณก่อนเริ่มเล่นทุกครั้ง
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก PAOTUNG"
          class="flex items-center justify-center rounded-lg border border-[#e0bd72]/70 bg-gradient-to-r from-[#f5e3b3] via-[#e0bd72] to-[#a5813a] px-8 py-3 font-black text-[#020f1e] shadow-[0_0_15px_rgba(224,189,114,0.38)] transition-transform hover:scale-105">
