---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login, /register,
// /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx
// ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึง
// เขียนขึ้นใหม่บนข้อเท็จจริงของบรีฟรอบนี้เท่านั้น (src/assets/content.txt)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x4 · h3x0
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) จึงเปิดใช้งานอยู่ และรอบนี้ brand-spec §1
// สั่งให้คงไว้ ไม่ได้ park ลง src/pages-disabled/
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// ตัวที่ routing จริงคือไฟล์นี้ Astro ไม่อ่านโฟลเดอร์นั้นเลย ห้ามแก้และห้ามลบ
//
// ⚠️ ดรอปนี้ (2026-10-13, GT66B) คือ **คาสิโนล้วน: บาคาร่า · ไฮโล · สล็อต**
// ไม่ใช่เว็บกีฬา ไม่ใช่เว็บหมวดลอตเตอรี (สองหน้าของหมวดนั้นจอดอยู่ใน
// src/pages-disabled/ ไม่มี route ห้ามลิงก์ไปหา เป็น href ตายที่ทำให้ build แดง)
// หน้าเดิมทั้งหน้าเขียนบนกรอบของแบรนด์ก่อน (TKB55) ซึ่งขาย "เว็บคาสิโนไทย /
// ยอดเข้าบริษัทโดยตรง / ฝากถอนทุกธนาคาร / บอลออนไลน์" — **บรีฟรอบนี้ไม่มีกรอบนั้น
// เลยสักคำ** จึงเขียนใหม่ทั้งหน้า ไม่ใช่ find-and-replace ทับประโยคเดิม และหัวข้อ
// ระบบฝากถอนของรอบก่อนถูกถอดทิ้งทั้งหัวข้อ แทนที่ด้วยหัวข้อการสมัคร 3 ขั้นตอน
// ซึ่งเป็นหัวข้อที่บรีฟรอบนี้มีจริง (content.txt บรรทัด 14–18)
// คำที่ brand-spec §7 ห้ามไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำต้องห้ามเจอ
// false positive
//
// แง่มุมที่บรีฟรอบนี้ระบุไว้มีเท่านี้ (ห้ามเติมอย่างอื่น): คาสิโนเซิร์ฟนอก ·
// ทางเข้าเกมคาสิโนออนไลน์หลายประเภท ทั้งบาคาร่า ไฮโล และสล็อต · รวบรวมหมวดเกมจาก
// ผู้ให้บริการระดับเอเชียไว้ในแพลตฟอร์มเดียว · รองรับการเข้าใช้งานผ่านมือถือและ
// คอมพิวเตอร์ · เมนูค้นหาเกม ตรวจสอบเครดิต จัดการบัญชีสมาชิก · เซิร์ฟเวอร์ต่างประเทศ ·
// เกมถูกลิขสิทธิ์ · มาตรฐานการให้บริการ · บาคาร่าเป็นเกมไพ่ที่มีตัวเลือกการเดิมพัน
// ตามกติกา · ไฮโลใช้ผลจากลูกเต๋าในการตัดสิน · สล็อตมีเกมวงล้อคลาสสิก ฟรีสปิน
// โบนัสตัวคูณ และฟีเจอร์พิเศษ · กติกา ตารางจ่าย ช่วงเดิมพัน เงื่อนไขการเดิมพัน ·
// คืนยอดเสีย 0.3% เข้ายูสทุกวัน · รอบประจำวัน เวลาตัดยอด ยอดที่เข้าเกณฑ์ ·
// แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด · ลิงก์แนะนำ · สมัคร 3 ขั้นตอน · ยืนยันบัญชี ·
// แอดมิน 24 ชั่วโมง ช่องทางหลัก · ชื่อเกม ค่าย เวลาที่เกิดเหตุ · รหัสผ่าน · PIN · OTP
//
// ตัวเลขที่อ้างได้มีสามตัวของบรีฟเอง: 0.3% · 0.8% · 24 ชั่วโมง ห้ามเติมเลข
// ใบอนุญาต หน่วยงานกำกับ ชื่อนิติบุคคล ชื่อค่ายเกมจริง ชื่อธนาคาร ค่า RTP
// ยอดฝากขั้นต่ำ จำนวนสมาชิก ปีที่ก่อตั้ง หรือตำแหน่งเซิร์ฟเวอร์ที่เจาะจงกว่า
// คำว่า "ต่างประเทศ"
//
// ประโยคกำกับ (hedge) ที่บรีฟเขียนไว้เองและห้ามตัดทิ้งเพราะฟังดูไม่ขายของ — ขนมาครบ
// ทั้งห้าจุดตาม brand-spec §7:
// 1) ข้อมูลเซิร์ฟเวอร์ต่างประเทศ ลิขสิทธิ์เกม และมาตรฐานการให้บริการ ควรมีรายละเอียด
//    ผู้ดำเนินงานหรือเอกสารรับรองที่สามารถตรวจสอบได้ประกอบ (h1 ย่อหน้าท้าย)
// 2) ค่ายเกมระดับเอเชียควรมีรายชื่อผู้พัฒนาและข้อมูลการให้บริการที่ชัดเจน และไม่มีเกม
//    ประเภทใดรับประกันผลกำไรจากการเดิมพัน (h2 #1 ย่อหน้าท้าย)
// 3) คำว่าไม่จำกัดควรระบุให้ชัดว่าหมายถึงอะไร (h2 #2 รายการที่สอง)
// 4) ผู้สมัครควรตรวจสอบชื่อโดเมน ข้อมูลผู้ดำเนินงาน และข้อกำหนดการใช้งานก่อนส่งข้อมูล
//    ส่วนตัว รวมถึงตรวจสอบอายุและข้อกฎหมายที่เกี่ยวข้องในพื้นที่ของตน (h2 #3)
// 5) ไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น (h2 #4 ย่อหน้าท้าย)
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **แดงมังกรนำ โครเมียมขาวรอง บนดำสนิท**
// ⚠️ แบรนด์ก่อนหน้าทันที (TKB55) ก็เป็นแดง-โลหะ-ดำเหมือนกัน และแดงของมันต่างจาก
// รอบนี้แค่หนึ่งหลัก "มีแดงอยู่" จึงไม่ใช่ตัวบอกว่าถูกแบรนด์ ให้เทียบเป็น "ค่า"
// ทีละตัวกับตารางใน brand-spec §2 (ค่าเดิมไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสี
// แบรนด์เก่าเจอ false positive)
// พื้นเพจเป็นดำสนิท #000000 (bg.json) จึงไม่มีชั้นที่ลึกกว่าพื้นเพจได้จริง
// ลำดับความลึก: #1c0c0b ผิวยก (= การ์ด) / #130c0c กลาง / #0b0303 จมสุด / #000000 พื้น
//
// ลำดับปุ่มสื่อด้วย "แดงถม vs ผิวจมขอบแดง" — คู่พื้น-หมึกคำนวณไว้แล้ว:
// · ปุ่มหลัก (สมัครสมาชิก) ถมแดงไล่ #ffa0a2 → #fb141b ขอบ #db040b หมึก #190505
//   (5.0:1 บนปลายเข้ม และสูงกว่านั้นบนปลายสว่าง) ⚠️ ไล่เฉดต้องหยุดที่ #fb141b
//   ห้ามไล่ลงไปเข้มกว่านั้นใต้ตัวอักษร
// · ปุ่มรอง/ปุ่มลิงก์ภายในเป็นชั้นจม #130c0c → #0b0303 ขอบ #fb141b/55
//   ตัวอักษร #eceaea — hover ยกขอบเป็นแดงสว่าง #ff5f63
// · #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้
// ⚠️ #fb141b · #db040b · #8a0609 · #3b0405 ห้ามถือตัวอักษรทุกขนาด ใช้ได้
// แค่เส้นขอบ ออรา เงา และพื้นถม — ออราในไฟล์นี้ใช้ rgba(251,20,27,α) เท่านั้น
// และรอบนี้ไม่มีทอง ไม่มีม่วง ไม่มีชมพู ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว ไม่มีส้ม
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #eceaea,
// 15.9:1 บนผิวยก #1c0c0b) ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง
// ปล่อยให้สืบทอดลงมา และไม่ใส่ mx-auto / max-w-* บน <p> เพราะการ์ดคุมความกว้างเองแล้ว
// — ที่ประกาศสีได้มีแค่ปุ่ม (ถมพื้นของตัวเองจึงต้องกำหนดหมึกของตัวเอง) และ <strong>
// ซึ่ง brand-spec §2 สงวน #ffa0a2 (9.8:1 บนผิวการ์ด) ไว้เป็นสีไฮไลต์ในเนื้อความ
// โดยเฉพาะ และไม่ใช้สีอื่นเลย · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง
// เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาด
// ครึ่ง (ลบแท็ก <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิมเป๊ะ)
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้าง
// จากหน้า และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้หมุนมาเป็น Announcement2 ทั้งเว็บ (รอบก่อน TKB55 ใช้
// Announcement5 — brand-spec §3 หมุนออก) orchestrator ตั้ง default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message
// มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 155
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} คาสิโนเซิร์ฟนอก รวมบาคาร่า ไฮโล และสล็อตจากค่ายระดับเอเชียไว้ในแพลตฟอร์มเดียว พร้อมคืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% และแอดมิน 24 ชั่วโมง`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} คาสิโนเซิร์ฟนอก รวมหมวดเกมไว้ในแพลตฟอร์มเดียว`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#ffa0a2]">{BRAND_NAME} คือคาสิโนเซิร์ฟนอกที่นำเสนอทางเข้าเกมคาสิโนออนไลน์หลายประเภท ทั้งบาคาร่า ไฮโล และสล็อต</strong>
        พร้อมรวบรวมหมวดเกมจากผู้ให้บริการระดับเอเชียไว้ในแพลตฟอร์มเดียว รองรับการเข้าใช้งานผ่านมือถือและคอมพิวเตอร์ ผู้ใช้งานจึงเปิดดูประเภทเกมที่สนใจได้โดยไม่ต้องสลับไปมาหลายหน้าเว็บไซต์
      </p>

      <p>
        หน้านี้สรุปไว้ว่าภายในระบบมีอะไรให้ใช้งานบ้าง ตั้งแต่หมวดเกมที่จัดไว้ให้เลือก ไปจนถึงรายการโปรโมชั่น ขั้นตอนการสมัคร และช่องทางติดต่อแอดมิน
        <strong class="text-[#ffa0a2]">โดยมีเมนูค้นหาเกม ตรวจสอบเครดิต และจัดการบัญชีสมาชิกได้สะดวกจากบัญชีเดียว</strong>
        เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดดูอะไรตรงไหน แล้วจึงค่อยลงรายละเอียดของรายการที่สนใจเป็นรายรายการ
      </p>

      <p>
        เว็บไซต์ระบุว่าใช้เซิร์ฟเวอร์ต่างประเทศ มีเกมถูกลิขสิทธิ์ และให้บริการได้มาตรฐาน
        <strong class="text-[#ffa0a2]">ส่วนข้อมูลเกี่ยวกับเซิร์ฟเวอร์ต่างประเทศ ลิขสิทธิ์เกม และมาตรฐานการให้บริการ ควรมีรายละเอียดผู้ดำเนินงานหรือเอกสารรับรองที่สามารถตรวจสอบได้ประกอบ</strong>
        ไม่ใช่ยึดจากข้อความโฆษณาเพียงอย่างเดียว ข้อมูลในหน้านี้จึงเขียนไว้เพื่อบอกว่าระบบมีอะไรให้ใช้และควรตรวจอะไรก่อนตัดสินใจ
        ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้งาน
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`หมวดเกมที่ ${BRAND_NAME} รวมไว้ในแพลตฟอร์มเดียว`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} นำเสนอเกมคาสิโนยอดนิยมหลายรูปแบบไว้ให้เลือกตามความสนใจ
        <strong class="text-[#ffa0a2]">การจัดหมวดหมู่เกมช่วยให้ผู้ใช้งานค้นหาประเภทที่สนใจได้ง่าย</strong>
        ทั้งบนหน้าจอมือถือและคอมพิวเตอร์ พร้อมตรวจสอบรายละเอียดเกมและช่วงเดิมพันก่อนเริ่มเล่น ประเภทการเดิมพันที่เว็บไซต์ระบุไว้แบ่งออกได้ประมาณนี้
      </p>

      <ul class="flex flex-col gap-3" aria-label={`หมวดเกมคาสิโนบนแพลตฟอร์มของ ${BRAND_NAME}`}>
        <li class="flex gap-3">
          <span aria-hidden="true">🃏</span>
          <span>
