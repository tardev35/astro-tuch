---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึงเขียนขึ้นใหม่
// บนข้อเท็จจริงของบรีฟรอบนี้เท่านั้น (src/assets/content.txt) ไม่ใช่แก้ทับประโยคเดิม
// ของแบรนด์ก่อน — ของเดิมเป็นคอปปี้ "ฐานเล่นหลักรวมทุกหมวด" ของ KOON234
// ซึ่งขัดกับแบรนด์รอบนี้ทั้งหน้า จึงถูกเขียนใหม่ทั้งหมด ไม่ใช่แทนที่ชื่อแบรนด์
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) จึงเปิดใช้งานอยู่
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// ตัวที่ routing จริงคือไฟล์นี้ ตัวที่จอดไว้เป็นอินเวนทอรี ห้ามแก้และห้ามลบ
//
// ดรอปนี้ (2026-10-09) คือ **ฐานเข้าเล่นสล็อตเว็บหลัก — สล็อตล้วน** ไม่ใช่เว็บรวม
// ทุกหมวดแบบรอบก่อน แง่มุมที่บรีฟระบุไว้มีเท่านี้: รวมเกมสล็อตหลายรูปแบบไว้ในระบบ
// เดียว (สล็อตคลาสสิก เกมโบนัส ฟรีสปิน ตัวคูณ เกมใหม่) · เล่นผ่านมือถือได้สะดวก ·
// เมนูเลือกค่าย ตรวจสอบเครดิต ประวัติรายการ บัญชีสมาชิกเดียว · ถอนยอดส่งคำขอได้
// 24 ชั่วโมง แต่เวลาเงินเข้าแตกต่างกัน · ยอดขั้นต่ำ เงื่อนไขการถอน สถานะรายการ ·
// คืนยอดเสีย 0.3% เข้ายูส รอบตัดยอด ยอดที่เข้าเกณฑ์ · แนะนำเพื่อน 0.8% แชร์ลิงก์ ·
// สมัคร 3 ขั้นตอน ยืนยันบัญชี ช่องทางหลัก เว็บไซต์เลียนแบบ · แอดมิน 24 ชั่วโมง ·
// รหัสผ่าน PIN OTP หลักฐานธุรกรรม
//
// ⚠️ คำที่ห้ามหลงเหลือ: ศัพท์ของหมวดอื่นที่ไม่ใช่สล็อตซึ่งมาจากแบรนด์ก่อนๆ
// (เป็นของอินเวนทอรีที่จอดไว้) รวมถึงคำขายของที่บรีฟรอบนี้ไม่ได้เอ่ย —
// รายการเต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำต้องห้าม
// เจอ false positive · สองหน้าหมวดลอตเตอรียังจอดอยู่ใน src/pages-disabled/ จึงไม่มี
// ปลายทางให้ลิงก์รอบนี้
//
// ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 24 ชั่วโมง · 3 ขั้นตอน
// ห้ามเติมเลขใบอนุญาต หน่วยงานกำกับ ชื่อผู้ดำเนินงาน ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP
// ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีที่ก่อตั้ง เพราะบรีฟไม่ได้เอ่ยไว้สักอย่าง
//
// ประโยคกำกับที่บรีฟเขียนไว้เองและห้ามตัดทิ้งเพราะฟังดูไม่ขายของ:
// ควรมีข้อมูลผู้ให้บริการและรายชื่อค่ายเกมที่ตรวจสอบได้ · ระยะเวลาที่เงินเข้าบัญชี
// อาจแตกต่างกัน · แต่ละโปรโมชั่นกำหนดค่ายเกม ระยะเวลา และเงื่อนไขต่างกัน จึงควร
// อ่านรายละเอียดก่อนรับสิทธิ์ · คำว่าไม่จำกัดควรตรวจสอบรายละเอียด · ไม่ควรเปิดเผย
// รหัสผ่าน PIN หรือ OTP แม้ผู้นั้นจะอ้างว่าเป็นเจ้าหน้าที่
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **แดงแล็กเกอร์ x ทอง บนแดงเกือบดำ** แบบตรุษจีน
// พลิกจากคู่มรกต-ทองบนเขียวเกือบดำของ KOON234 ซึ่งออกครบทุกจุดแล้ว ทั้งคลาส
// Tailwind raw hex และ rgba() (ค่าเดิมอยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive)
// ปุ่มหลัก (สมัครสมาชิก) ถมทองไล่ #ffd87a → #f5b61d → #b07a06 ขอบ #b07a06 หมึกแดง
// เกือบดำ #1c0503 (10.7:1 บน #f5b61d) — ห้ามพลิกเป็นหมึกสว่าง · ปุ่มรองและปุ่มลิงก์
// ภายในเป็นผิวการ์ด #2a0806 → #120302 ขอบทอง #f5b61d/55 ตัวอักษรทองสว่าง #ffd87a
// (13.5:1) · #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #fdeedd)
// ไว้ที่ตัวการ์ดแล้ว ข้อความในหน้านี้จึงไม่ประกาศสีของตัวเองเลย ปล่อยให้สืบทอดลงมา
// — มีแค่ปุ่มที่ประกาศสีได้ เพราะปุ่มถมพื้นของตัวเองจึงต้องกำหนดหมึกของตัวเอง
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้าง
// จากหน้า และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น AnnouncementCyber ทั้งเว็บ (รอบก่อน KOON234 ใช้
// AnnouncementPremium ที่หน้าย่อย — brand-spec §3 หมุนออก) orchestrator ตั้ง
// default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare
// ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 154 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} ฐานเข้าเล่นสล็อตเว็บหลักที่รวมเกมสล็อตจากค่ายที่เปิดให้บริการไว้ในบัญชีเดียว พร้อมคืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% และแอดมิน 24 ชั่วโมง`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} ฐานเข้าเล่นสล็อตเว็บหลัก รวมเกมสล็อตไว้ในระบบเดียว`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong>{BRAND_NAME} คือฐานเข้าเล่นสล็อตเว็บหลักที่รวบรวมเกมสล็อตหลากหลายรูปแบบไว้ในระบบเดียว</strong>
        มีทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน ตัวคูณ และเกมใหม่จากค่ายที่เปิดให้บริการ รองรับการเข้าเล่นผ่านมือถือได้สะดวก พร้อมเมนูเลือกค่าย ตรวจสอบเครดิต และติดตามรายการต่างๆ ผ่านบัญชีสมาชิกเดียว
      </p>

      <p>
        หน้านี้สรุปไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่เมนูเลือกค่ายและหมวดเกมสล็อต
        <strong>ไปจนถึงการตรวจสอบเครดิต ประวัติรายการ โปรโมชั่นที่เปิดให้รับในแต่ละช่วง และการติดต่อแอดมินที่ดูแลตลอด 24 ชั่วโมง</strong>
        เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดดูอะไรตรงไหน แล้วจึงค่อยลงรายละเอียดของรายการที่สนใจเป็นรายรายการ
      </p>

      <p>
        ส่วนการระบุว่าเป็นศูนย์รวมเกมสล็อตค่ายแท้ ไม่ผ่านเว็บตัวแทน
        <strong>ควรมีข้อมูลผู้ให้บริการและรายชื่อค่ายเกมที่ตรวจสอบได้ เพื่อให้สมาชิกทราบรายละเอียดของแพลตฟอร์มก่อนใช้งาน</strong>
        ข้อมูลในหน้านี้เขียนไว้เพื่อบอกว่าระบบมีอะไรให้ใช้และควรตรวจอะไรก่อนตัดสินใจ ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้งาน
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`เมนูที่ ${BRAND_NAME} รวมไว้ในบัญชีสมาชิกเดียว`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} รวมเมนูที่สมาชิกต้องใช้ไว้หลังการเข้าสู่ระบบครั้งเดียว
        <strong>ตั้งแต่การเลือกค่ายและหมวดเกมสล็อต ไปจนถึงการตรวจสอบเครดิตและประวัติรายการจากบัญชีเดิม</strong>
        เมนูแต่ละส่วนทำหน้าที่คนละอย่างและแสดงข้อมูลคนละชุด จึงควรเปิดดูให้ครบตั้งแต่ครั้งแรก เพื่อให้รู้ว่าข้อมูลที่ต้องใช้จริงอยู่ตรงไหน สิ่งที่แต่ละเมนูดูแลแบ่งออกได้ประมาณนี้
      </p>

      <ul class="flex flex-col gap-3" aria-label={`เมนูฝั่งสมาชิกบนเว็บ ${BRAND_NAME}`}>
        <li class="flex gap-3">
          <span aria-hidden="true">🎰</span>
          <span>
            <strong>เมนูเลือกค่ายและหมวดเกม</strong> ใช้ไล่ดูรายชื่อค่ายและหมวดเกมสล็อตที่ระบบเปิดให้บริการ ทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน และเกมที่มีฟีเจอร์ตัวคูณ โดยจำนวนค่ายและเกมอาจเปลี่ยนแปลงตามช่วงเวลา
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">💳</span>
          <span>
            <strong>การตรวจสอบเครดิต</strong> แสดงยอดล่าสุดของบัญชีที่ระบบบันทึกไว้ เป็นค่าที่ควรยึดก่อนเลือกเกม แทนตัวเลขที่จำไว้จากรอบก่อนหน้า
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">📋</span>
          <span>
            <strong>ประวัติรายการ</strong> ใช้ไล่ดูรายการย้อนหลังของบัญชีตัวเองและสถานะรายการถอนที่ส่งไว้ เป็นที่เดียวกับที่ใช้อ้างอิงวันเวลาเวลาจะแจ้งปัญหาให้เจ้าหน้าที่ตรวจสอบ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">🎁</span>
          <span>
            <strong>รายการโปรโมชั่น</strong> แสดงสิทธิพิเศษที่เปิดให้รับในแต่ละช่วง พร้อมยอดที่เข้าเกณฑ์ รอบคำนวณ และสถานะการรับโบนัสที่ตรวจสอบผ่านบัญชีได้โดยตรง
          </span>
        </li>
      </ul>

      <p>
        ฝั่งการถอนยอด ระบบรองรับการส่งคำขอตามช่องทางที่เว็บไซต์เปิดให้ใช้งานได้ตลอด 24 ชั่วโมง
        <strong>แต่ระยะเวลาที่เงินเข้าบัญชีอาจแตกต่างกันตามขั้นตอนตรวจสอบและช่องทางชำระเงิน</strong>
        จึงควรตรวจสอบยอดขั้นต่ำ เงื่อนไขการถอน และสถานะรายการก่อนทำธุรกรรมทุกครั้ง หากพบยอดไม่อัปเดตสามารถแจ้งฝ่ายบริการพร้อมหลักฐานเพื่อให้ตรวจสอบได้ตรงรายการ
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/ทดลองเล่น"
          aria-label={`เปิดหน้าทดลองเล่นของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#f5b61d]/55 bg-gradient-to-b from-[#2a0806] to-[#120302] px-8 py-3 font-bold text-[#ffd87a] shadow-[0_0_12px_rgba(212,32,13,0.35)] transition-all hover:scale-105 hover:border-[#f5b61d] hover:shadow-[0_0_18px_rgba(245,182,29,0.45)]">
          ไปหน้าทดลองเล่น
        </a>

        <a
          href="/promotion"
          aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#f5b61d]/55 bg-gradient-to-b from-[#2a0806] to-[#120302] px-8 py-3 font-bold text-[#ffd87a] shadow-[0_0_12px_rgba(212,32,13,0.35)] transition-all hover:scale-105 hover:border-[#f5b61d] hover:shadow-[0_0_18px_rgba(245,182,29,0.45)]">
          ดูภาพโปรโมชั่น
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`โปรโมชั่นของ ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        โปรโมชั่นเล่นสล็อต {BRAND_NAME} มีสิทธิพิเศษสำหรับสมาชิกตามกิจกรรมที่เปิดให้รับในแต่ละช่วง
        <strong>โดยเน้นโบนัสคืนยอดเสียและกิจกรรมแนะนำเพื่อน สมาชิกตรวจสอบยอดที่เข้าเกณฑ์ รอบคำนวณ และสถานะการรับโบนัสผ่านบัญชีได้โดยตรง</strong>
