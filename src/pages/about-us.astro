---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login,
// /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx
// ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึง
// เขียนขึ้นใหม่บนข้อเท็จจริงของ DM899 เท่านั้น (src/assets/content.txt)
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
//
// ดรอปนี้ (2026-10-03) คือ DM899 **สล็อตคาสิโนเว็บตรงต่างประเทศ บัญชีบริษัทแท้ 100%**
// แง่มุมที่บรีฟระบุไว้มีเท่านี้: รวมเกมเดิมพันหลายรูปแบบไว้ในระบบเดียว มีทั้งเกมสล็อต
// เกมคาสิโนสด และหมวดเกมอื่นตามผู้ให้บริการที่เชื่อมต่อกับระบบ · เข้าเล่นผ่านเว็บ
// เบราว์เซอร์บนมือถือ · สลับหมวดเกม ตรวจสอบเครดิต และดูประวัติรายการได้จากบัญชีเดียว
// โดยไม่ต้องสมัครใหม่แยกตามค่าย · โปรโมชั่นเปิดตามแคมเปญของแต่ละเดือน มีคืนยอดเสีย
// 0.3% และแนะนำเพื่อน 0.8% ซึ่งมีรอบคำนวณและยอดที่เข้าเกณฑ์ของตัวเอง · สมัครบนมือถือ
// 3 ขั้นตอน · แอดมิน 24 ชั่วโมง · ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP
//
// ⚠️ บรีฟรอบนี้ **ไม่ได้** เอ่ยถึง สล็อตคลาสสิก ฟรีสปิน ตัวคูณ เกมโบนัส หรือช่วง
// เดิมพันขั้นต่ำ/สูงสุด (นั่นเป็นของบรีฟ 1SS365 รอบก่อน) จึงห้ามอ้างฟีเจอร์ชุดนั้น
// สิ่งที่อ้างได้คือหมวดเกมสามหมวดตามบรีฟ และคำว่า "รายละเอียดการเดิมพัน" ที่บรีฟใช้เอง
//
// แบรนด์ก่อนหน้า (1SS365) เป็นเว็บสล็อตที่ขายจุดขาย "ไม่ผ่านเอเย่นต์ / แตกง่าย จ่ายไว"
// และแบรนด์ก่อนนั้น (หวย365) เป็นเว็บแทงหวย — ทั้งสองชุดคำถูกถอดออกทั้งก้อนแล้วเขียน
// ใหม่จากบรีฟรอบนี้ ไม่ใช่ find-and-replace ทับประโยคเดิม คำหมวดหวยทุกคำ (หวย โพย งวด
// เลข 2 ตัว/3 ตัว อัตราจ่าย ฮานอย ลาวพัฒนา หวยหุ้น ตรวจหวย แนวทาง) ห้ามหลงเหลือ และ
// ห้ามลิงก์ไป /ตรวจหวย หรือ /แนวทาง เพราะสองหน้านั้นอยู่ใน src/pages-disabled/ แล้ว
// = เราต์ตายและทำให้ build แดง
//
// ตัวเลขที่อ้างได้มีแค่ คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · 3 ขั้นตอน · 24 ชั่วโมง ·
// 100% ห้ามเพิ่มใบอนุญาต ชื่อผู้ให้บริการ ชื่อธนาคาร ยอดฝากขั้นต่ำ จำนวนสมาชิก
// ปีที่ก่อตั้ง ค่า RTP หรือชื่อค่ายเกม/ชื่อเกมที่บรีฟไม่ได้เอ่ยไว้สักชื่อ
//
// ประโยคกำกับที่บรีฟเขียนไว้เองและห้ามตัดทิ้งเพราะฟังดูไม่ขายของ: คำว่า "บัญชีบริษัท
// แท้ 100%" ควรมีชื่อนิติบุคคลและข้อมูลที่ตรวจสอบได้รองรับก่อนนำมาใช้ยืนยันด้านความ
// ปลอดภัย · คำว่า "การันตีระบบเกมมาตรฐาน" ควรระบุมาตรฐาน ใบอนุญาต หรือหน่วยงานที่
// ตรวจสอบได้อย่างชัดเจน เพราะการเป็นแพลตฟอร์มต่างประเทศไม่ได้ยืนยันมาตรฐานหรือความ
// ปลอดภัยของระบบโดยอัตโนมัติ · จำนวนค่ายและเกมสามารถเพิ่มหรือลดได้ตามช่วงเวลา
//
// พาเลตต์ DM899 (brand-spec §2) **เขียวมรกตนำ แดงสดรอง ทองเสริม บนดำอมเขียว** —
// โลโก้คือตัว D เขียวซ้อนตัว M แดง ตามด้วยเลข 899 โครเมียมเงิน:
// เขียวแบรนด์ #01a326 (ขอบ ออรา ปุ่มรอง) · เขียวสว่าง #12c23a (ไอคอน bullet, ขอบ
// active) · เขียวสว่างสุด #4ade6b (ต้นไล่เฉดปุ่มหลัก, hover) · เขียวแกน #01841b
// (ปลายไล่เฉดปุ่มหลัก) · แดงแบรนด์ #fb252b (ออรามุมตรงข้าม) · ทองอ่อน #ffe9a8
// (หมึก strong ทั้งเว็บ + ตัวอักษรปุ่มรอง) · ทองแบรนด์ #f2b422 (ขอบปุ่มรอง, marker) ·
// พื้นการ์ด #0a1a0e · พื้นยกระดับ #102a16 · หมึกบนพื้นสว่าง #06140a · เนื้อความ
// #e4f2e4 (BRAND_TEXT)
// ชุดทอง-เงินโครเมียมของ 1SS365 (#edbb23 #ffeeb4 #a87708 #c8cbce #f1f2f3 #121010
// #f0e6d2 #050505 #2a2115 #f7d458 #1a1710 และ rgba(237,187,35,*)) ออกครบทุกจุดแล้ว
// #00B900/#009900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ — และ
// เพราะรอบนี้แบรนด์เป็นเขียวด้วย ปุ่ม LINE จึงเป็นพื้นทึบไม่ไล่เฉด ต่างจากปุ่มสมัคร
// ที่เป็นไล่เฉดเขียวชัดเจน
// กฎคอนทราสต์: พื้นเขียวสว่าง → หมึก #06140a เสมอ และปุ่มรองเป็น "ขอบทองบนพื้นดำ
// อมเขียว" ไม่ใช่ถมทองอีกใบ
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// — การ์ดตั้งสีเนื้อความ #e4f2e4 ไว้ที่ตัวการ์ดแล้ว ย่อหน้าจึงไม่ใส่คลาสสีซ้ำ
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจาก
// หน้า และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น Announcement3 ทั้งเว็บ (รอบก่อน 1SS365 ใช้
// AnnouncementPremium) — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ
// DM899 แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูดคนละเรื่อง
// กับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 155
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} สล็อตคาสิโนเว็บตรงต่างประเทศ หน้านี้สรุปว่าภายในเว็บไซต์มีหมวดเกม โปรโมชั่น ขั้นตอนสมัครบนมือถือ และช่องทางติดต่อแอดมินอะไรให้ใช้งานบ้าง`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} สล็อตคาสิโนเว็บตรงต่างประเทศ รวมหมวดเกมไว้ในบัญชีเดียว`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed">
        <strong class="text-[#ffe9a8]">{BRAND_NAME} เป็นเว็บสล็อตคาสิโนจากแพลตฟอร์มต่างประเทศ ที่รวบรวมเกมเดิมพันหลายรูปแบบไว้ในระบบเดียว</strong>
        มีทั้งเกมสล็อต เกมคาสิโนสด และหมวดเกมอื่นตามที่เว็บไซต์เปิดให้บริการ จุดตั้งต้นของระบบคือผู้ที่ต้องการเข้าเล่นผ่านเว็บเบราว์เซอร์บนมือถือ จึงเลือกเกม ตรวจสอบโปรโมชั่น และจัดการรายการของตัวเองได้จากบัญชีเดียว
      </p>

      <p class="text-left text-base leading-relaxed">
        หน้านี้สรุปไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่หมวดเกมที่ระบบรองรับ
        <strong class="text-[#ffe9a8]">ไปจนถึงโปรโมชั่นที่เปิดตามแคมเปญของแต่ละเดือน ขั้นตอนสมัครบนมือถือแบบ 3 ขั้นตอน และช่องทางติดต่อแอดมินที่ดูแลตลอด 24 ชั่วโมง</strong>
        เมื่อไม่แน่ใจในขั้นตอนใด สมาชิกจึงสลับหมวดเกม ตรวจสอบเครดิต และดูประวัติรายการได้จากระบบเดียวโดยไม่ต้องสมัครบัญชีใหม่แยกตามค่าย
      </p>

      <p class="text-left text-base leading-relaxed">
        สิ่งหนึ่งที่ควรอ่านไปพร้อมกันคือระบบฝากถอนที่เว็บไซต์ระบุว่าเชื่อมต่อกับบัญชีบริษัทโดยตรง
        <strong class="text-[#ffe9a8]">อย่างไรก็ตาม คำว่าบัญชีบริษัทแท้ 100% ควรมีชื่อนิติบุคคลและข้อมูลที่ตรวจสอบได้รองรับก่อนนำมาใช้ยืนยันด้านความปลอดภัย</strong>
        ข้อมูลในหน้านี้จึงเขียนไว้เพื่อบอกว่าระบบมีอะไรให้ใช้ ไม่ได้ใช้แทนการตรวจสอบข้อมูลของผู้ให้บริการก่อนทำธุรกรรม
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`หมวดเกมเดิมพันที่ ${BRAND_NAME} เปิดให้เลือกจากบัญชีเดียว`} as="h2">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed">
        หลัง Login สมาชิกเลือกประเภทการเดิมพันได้จากบัญชีเดียว
        <strong class="text-[#ffe9a8]">ตามหมวดเกมและผู้ให้บริการที่เชื่อมต่อกับระบบในขณะนั้น</strong>
        หมวดที่เว็บไซต์ระบุไว้แบ่งออกได้ประมาณนี้
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#12c23a]">🎰</span>
          <span>
            <strong class="text-[#ffe9a8]">เกมสล็อต</strong> เป็นหมวดที่หน้าเกมอ่านจบได้เร็วที่สุด จึงเหมาะกับการเริ่มทำความคุ้นเคยกับการค้นหาเกมและตำแหน่งของข้อมูลเกม ก่อนย้ายไปหมวดที่มีรายละเอียดมากกว่า
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#12c23a]">🃏</span>
          <span>
            <strong class="text-[#ffe9a8]">เกมคาสิโนสด</strong> เป็นหมวดที่เล่นผ่านโต๊ะถ่ายทอดสด เงื่อนไขของแต่ละโต๊ะระบุไว้ในหน้าของโต๊ะนั้น ควรเปิดอ่านรายละเอียดการเดิมพันก่อนเข้าร่วมทุกครั้ง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#12c23a]">🎲</span>
          <span>
            <strong class="text-[#ffe9a8]">หมวดเกมอื่นตามผู้ให้บริการที่เชื่อมต่อกับระบบ</strong> จะปรากฏตามที่เว็บไซต์เปิดให้บริการในช่วงเวลานั้น จึงควรดูรายการล่าสุดจากหน้าเกมแทนการอ้างจากรายการที่จำไว้
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#12c23a]">🔁</span>
          <span>
            <strong class="text-[#ffe9a8]">การสลับหมวดเกมจากบัญชีเดียว</strong> ทำได้โดยไม่ต้องสมัครบัญชีใหม่แยกตามค่าย และตรวจสอบเครดิตกับประวัติรายการของตัวเองได้จากที่เดิมทั้งบนมือถือและคอมพิวเตอร์
          </span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed">
        <strong class="text-[#ffe9a8]">จำนวนค่ายและเกมสามารถมีการเพิ่มหรือลดได้ตามช่วงเวลา</strong>
        สมาชิกจึงควรตรวจสอบรายการล่าสุดจากหน้าเกมก่อนเลือก และหากต้องการใช้ข้อความว่าการันตีระบบเกมมาตรฐาน ควรระบุมาตรฐาน ใบอนุญาต หรือหน่วยงานที่ตรวจสอบได้อย่างชัดเจน เพราะการเป็นแพลตฟอร์มต่างประเทศไม่ได้ยืนยันมาตรฐานหรือความปลอดภัยของระบบโดยอัตโนมัติ
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/ทดลองเล่น"
          aria-label={`เปิดหน้าทดลองเล่นของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#f2b422]/60 bg-[#102a16] px-8 py-3 font-bold text-[#ffe9a8] transition-all hover:scale-105 hover:border-[#4ade6b] hover:bg-[#0a1a0e] hover:text-[#4ade6b]">
          ไปหน้าทดลองเล่น
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`โปรโมชั่นและขั้นตอนสมัครเดิมพัน ${BRAND_NAME} บนมือถือ`} as="h2">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed">
        สมาชิกสามารถ Login เพื่อตรวจสอบโปรโมชั่นที่บัญชีมีสิทธิ์รับตามแคมเปญที่ {BRAND_NAME} เปิดในแต่ละเดือน
        <strong class="text-[#ffe9a8]">มีทั้งโบนัสคืนยอดเสียและกิจกรรมแนะนำเพื่อน</strong>
        โดยทั้งสองรายการคำนวณจากยอดที่เข้าเกณฑ์ตามรอบที่เว็บไซต์กำหนด ไม่ได้ให้โดยอัตโนมัติกับทุกยอดการเล่น
      </p>

