---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึงเขียนขึ้นใหม่
// บนข้อเท็จจริงของบรีฟรอบนี้เท่านั้น (src/assets/content.txt) ไม่ใช่แก้ทับประโยคเดิม
// ของแบรนด์ก่อน — ของเดิมทั้งย่อหน้าตั้งอยู่บนคำที่ brand-spec §6 สั่งห้าม
// จึงถูกเขียนใหม่ทั้งหมด
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) จึงเปิดใช้งานอยู่ และรอบนี้ operator สั่งให้
// คงไว้ ไม่ได้ park ลง src/pages-disabled/
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// ตัวที่ routing จริงคือไฟล์นี้ ตัวที่จอดไว้เป็นอินเวนทอรี ห้ามแก้และห้ามลบ
//
// ดรอปนี้ (2026-10-09) คือ **คลับคนเล่นสล็อตซุปเปอร์ กลุ่มลับคนดังวงการสล็อตออนไลน์**
// ธีมป่ากับเสือโคร่ง ไม่ใช่เว็บลอตเตอรีและไม่ใช่เว็บรวมทุกหมวด (สองหน้าของหมวด
// ลอตเตอรีจอดอยู่ใน src/pages-disabled/ ไม่มี route จึงห้ามลิงก์ไปหา มิฉะนั้นเป็น
// href ตายที่ทำให้ build แดง) แง่มุมที่บรีฟระบุไว้มีเท่านี้:
// ชุมชนสำหรับผู้สนใจเกมสล็อตออนไลน์ · รวบรวมข้อมูลเกมจากค่ายต่างๆ กิจกรรมสมาชิก
// และโปรโมชั่นที่เปิดให้รับในแต่ละช่วง · สล็อตคลาสสิก เกมฟรีสปิน โบนัสตัวคูณ และ
// เกมใหม่จากค่ายที่เปิดให้บริการ · จัดหมวดหมู่ให้ค้นหาเกมสะดวก · ดับเบิ้ลโบนัส =
// มีโปรโมชั่นมากกว่าหนึ่งรูปแบบให้เลือกตามเงื่อนไข · คืนยอดเสีย 0.3% เข้ายูสตามรอบ ·
// แนะนำเพื่อนแชร์ลิงก์ 0.8% จากยอดที่เข้าเกณฑ์ · ฝากถอนเข้าบัญชีบริษัทโดยตรง
// ตรวจชื่อบัญชีปลายทางและข้อมูลนิติบุคคล · แอดมิน 24 ชั่วโมง · PIN/OTP
//
// ⚠️ คำที่ห้ามหลงเหลือ: ศัพท์ของหมวดอื่นที่ไม่ใช่สล็อต และคำขายของของแบรนด์ก่อนๆ
// ที่บรีฟรอบนี้ไม่ได้เอ่ย — รายการเต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อ
// ไม่ให้ grep หาคำต้องห้ามเจอ false positive รอบนี้เขียนใหม่จากบรีฟ ไม่ได้
// find-and-replace ทับประโยคเก่า เพราะประโยคเก่าทั้งย่อหน้าตั้งอยู่บนคำเหล่านั้น
//
// ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 24 ชั่วโมง
// ⚠️ เลขพาดหัวของแบรนด์ก่อน (ยอดเดิมพันเริ่มต้นหน่วยบาท) ไม่มีอยู่ในบรีฟรอบนี้เลย
// ห้ามยกมา — ค่าเดิมอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่
// ห้ามเติมเลขใบอนุญาต หน่วยงานกำกับ ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP ยอดฝากขั้นต่ำ
// จำนวนสมาชิก หรือปีที่ก่อตั้ง เพราะบรีฟไม่ได้เอ่ยไว้สักอย่าง
//
// ประโยคกำกับที่บรีฟเขียนไว้เองและห้ามตัดทิ้งเพราะฟังดูไม่ขายของ: การกล่าวถึง
// กลุ่มลับหรือบุคคลมีชื่อเสียงควรมีข้อมูลกิจกรรมและผู้เข้าร่วมที่ตรวจสอบได้ ·
// ดับเบิ้ลโบนัสไม่ได้แปลว่าได้โบนัสสองเท่าจากทุกเกมเสมอไป · คำว่าไม่จำกัดควรระบุ
// ให้ชัดว่าหมายถึงจำนวนเพื่อน จำนวนครั้ง หรือวงเงิน · ชื่อบัญชีบริษัทเพียงอย่างเดียว
// ไม่ได้รับประกันว่าธุรกรรมจะไม่มีความเสี่ยง · ไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP
// ให้บุคคลอื่น แม้จะอ้างว่าเป็นเจ้าหน้าที่
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **แดงเสือโคร่ง x ทองถ่านไฟ บนน้ำตาลถ่านเกือบดำ**
// พลิกจากคู่เขียวป่า-ทองมงกุฎของแบรนด์ก่อน ซึ่งออกครบทุกจุดแล้ว ทั้งคลาส Tailwind
// raw hex และ rgba() (ค่าเดิมอยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้
// grep หาสีแบรนด์เก่าเจอ false positive)
// ลำดับปุ่มสื่อด้วย "ทองถม vs แดงโปร่ง": ปุ่มหลัก (สมัครสมาชิก) ถมทองไล่ #ffd666 →
// #f2b705 → #c08a0b ขอบ #a8730a หมึกน้ำตาลเกือบดำ #2b0a00 — ห้ามพลิกเป็นหมึกสว่าง ·
// ปุ่มรองและปุ่มลิงก์ภายในเป็นผิวการ์ด #3d1709 → #301105 ขอบแดง #e8232a/55
// ตัวอักษรครีมอุ่น #f5cbb0 · #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สี
// ของเว็บ จึงคงไว้
// ⚠️ ปลายเข้มของไล่เฉดทองเป็น #c08a0b ไม่ใช่ #a8730a — หมึก #2b0a00 บน #a8730a
// ได้แค่ 4.48:1 (ตก) แต่บน #c08a0b ได้ 6.0:1 ส่วน #a8730a ใช้เป็นขอบเท่านั้น
// ⚠️ แดงแบรนด์ #e8232a ได้ 3.5:1 บนผิวการ์ด ห้ามถือตัวอักษร ใช้เป็นขอบ เงา และออรา
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #fbe8d5)
// ไว้ที่ตัวการ์ดแล้ว ข้อความในหน้านี้จึงไม่ประกาศสีของตัวเองเลย ปล่อยให้สืบทอดลงมา
// — มีแค่ปุ่มที่ประกาศสีได้ เพราะปุ่มถมพื้นของตัวเองจึงต้องกำหนดหมึกของตัวเอง
// ส่วน <strong> ใช้น้ำหนักตัวอักษรเป็นไฮไลต์ ไม่ประกาศสี และแต่ละ <strong> ครอบ
// "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิด
// แท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้าง
// จากหน้า และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น Announcement2 ทั้งเว็บ (รอบก่อนใช้ Announcement3 —
// brand-spec §3 หมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้
// ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูด
// คนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 157 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} คลับคนเล่นสล็อตซุปเปอร์ รวมข้อมูลเกมจากค่ายต่างๆ กิจกรรมสมาชิก ดับเบิ้ลโบนัส คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% และแอดมิน 24 ชั่วโมง`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} คลับคนเล่นสล็อตซุปเปอร์ ชุมชนคนสนใจเกมสล็อตออนไลน์`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong>{BRAND_NAME} คือคลับคนเล่นสล็อตซุปเปอร์ที่นำเสนอรูปแบบชุมชนสำหรับผู้สนใจเกมสล็อตออนไลน์</strong>
        โดยรวบรวมข้อมูลเกมจากค่ายต่างๆ กิจกรรมสมาชิก และโปรโมชั่นที่เปิดให้รับในแต่ละช่วงไว้ด้วยกัน ภายใต้แนวคิดกลุ่มลับคนดังวงการสล็อตออนไลน์ สมาชิกติดตามเกมใหม่ ตรวจสอบรายละเอียดโบนัส และเลือกหมวดเกมที่สนใจได้ผ่านระบบเดียว
      </p>

      <p>
        หน้านี้สรุปไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่หมวดเกมและรายชื่อค่ายที่เปิดให้บริการ
        <strong>ไปจนถึงรายการโปรโมชั่นที่กดรับได้ ระบบฝากถอน และช่องทางติดต่อแอดมินที่เปิดให้บริการตลอด 24 ชั่วโมง</strong>
        เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดดูอะไรตรงไหน แล้วจึงค่อยลงรายละเอียดของรายการที่สนใจเป็นรายรายการ
      </p>

      <p>
        <strong>ส่วนการกล่าวถึงกลุ่มลับหรือบุคคลมีชื่อเสียงควรมีข้อมูลกิจกรรมและผู้เข้าร่วมที่ตรวจสอบได้</strong>
        เพื่อไม่ให้เกิดความเข้าใจคลาดเคลื่อน ข้อมูลในหน้านี้จึงเขียนไว้เพื่อบอกว่าระบบมีอะไรให้ใช้และควรตรวจอะไรก่อนตัดสินใจ ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้งาน ซึ่งเป็นค่าที่ควรยึดเป็นหลักเสมอ
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`เกมสล็อตและหมวดหมู่ที่ ${BRAND_NAME} รวบรวมไว้ให้สมาชิก`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} นำเสนอเกมสล็อตหลายรูปแบบจากค่ายที่เปิดให้บริการ
        <strong>โดยเน้นการจัดหมวดหมู่ให้ค้นหาเกมได้สะดวก พร้อมข้อมูลกิจกรรมและสิทธิพิเศษสำหรับสมาชิก</strong>
        หมวดที่เว็บไซต์ระบุไว้แบ่งออกได้ประมาณนี้ และรายการที่เปิดอยู่ในแต่ละหมวดอาจเปลี่ยนแปลงได้ตามช่วงเวลา
      </p>

      <ul class="flex flex-col gap-3" aria-label={`หมวดเกมสล็อตบนเว็บ ${BRAND_NAME}`}>
        <li class="flex gap-3">
          <span aria-hidden="true">🎰</span>
          <span>
            <strong>สล็อตคลาสสิก</strong> เกมวงล้อรูปแบบพื้นฐานที่อ่านผลได้ตรงไปตรงมา เหมาะกับการเริ่มทำความคุ้นเคยกับระบบก่อนไล่ดูหมวดอื่น
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">🌀</span>
          <span>
            <strong>เกมฟรีสปิน</strong> เกมที่มีรอบหมุนเพิ่มเป็นฟีเจอร์ของตัวเกมเอง โดยเงื่อนไขการเข้าสู่รอบฟรีสปินและจำนวนรอบที่ได้เป็นไปตามที่แต่ละเกมกำหนด
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">✖️</span>
          <span>
            <strong>โบนัสตัวคูณ</strong> เกมที่มีตัวคูณอยู่ในฟีเจอร์ของเกม ซึ่งค่าตัวคูณและจังหวะที่ทำงานต่างกันไปตามเกม จึงควรเปิดอ่านรายละเอียดภายในเกมก่อนเริ่มเล่น
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">🆕</span>
          <span>
            <strong>เกมใหม่จากค่ายที่เปิดให้บริการ</strong> รายการที่เพิ่มเข้ามาตามรอบของแต่ละค่าย เป็นหมวดที่ควรเปิดดูเป็นระยะ เพราะรายชื่อที่เปิดให้เล่นไม่คงที่
          </span>
        </li>
      </ul>

      <p>
        จุดเด่นของแนวคิดดับเบิ้ลโบนัสคือการนำเสนอโปรโมชั่นมากกว่าหนึ่งรูปแบบให้เลือกตามเงื่อนไข เช่น โบนัสจากกิจกรรมประจำวันและโบนัสแนะนำเพื่อน
        <strong>อย่างไรก็ตาม คำว่าดับเบิ้ลโบนัสไม่ได้หมายความว่าสมาชิกจะได้รับโบนัสสองเท่าจากทุกเกมหรือทุกรายการเสมอไป</strong>
        จึงควรตรวจสอบว่าโปรโมชั่นใดสามารถรับร่วมกันได้ รวมถึงค่ายเกมที่เข้าร่วม ระยะเวลา และข้อกำหนดของแต่ละกิจกรรมก่อนรับสิทธิ์
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/ทดลองเล่น"
          aria-label={`เปิดหน้าทดลองเล่นของ ${BRAND_NAME}`}
