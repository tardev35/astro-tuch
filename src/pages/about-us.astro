---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";

// CASINO888 เป็นเว็บ "คาสิโนครบวงจร" — บาคาร่า สล็อต หวย และฟุตบอล อยู่ในบัญชีเดียว
// ไม่ใช่เว็บสล็อตอย่างเดียวแบบแบรนด์ก่อนหน้า ทุกข้อความด้านล่างอ้างอิง
// src/assets/content.txt เท่านั้น ไม่มีการอ้างใบอนุญาต รางวัล หรือการันตีผลกำไร
// (ตัวบรีฟเองระบุว่าเรื่องลิขสิทธิ์/เว็บตรงให้ตรวจสอบจากผู้ให้บริการโดยตรง
// และขั้นต่ำจริงต่างกันไปตามแต่ละเกม)
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 157
const pageDescription =
  "รู้จัก CASINO888 เว็บเดิมพันออนไลน์ครบวงจร รวมบาคาร่า สล็อต หวย และบอลไว้ในบัญชีเดียว พร้อมโปรโมชั่นแนะนำเพื่อน 0.8% คืนยอดเสีย 0.3% และแอดมินดูแล 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ CASINO888 แหล่งเดิมพันออนไลน์ครบวงจรในบัญชีเดียว",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา CASINO888 เว็บพนัน888 บาคาร่า สล็อต หวย บอล ครบวงจร" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ CASINO888" as="h1">
    <div>
      <p class="mb-6 text-left text-base leading-relaxed text-[#e9ddc4]">
        <strong class="text-[#e4c25a]">CASINO888</strong> เป็นช่องทางสำหรับผู้ที่ต้องการ<strong class="text-[#e4c25a]">เดิมพันออนไลน์หลายประเภทผ่านบัญชีเดียว</strong>
        ทั้งบาคาร่าและเกมคาสิโนสด สล็อตออนไลน์ หวยออนไลน์หลายประเภท รวมถึงการเดิมพันฟุตบอลตามรายการที่เปิดให้บริการ รองรับการใช้งานบนมือถือ แท็บเล็ต และคอมพิวเตอร์
        สมาชิกเลือกเกม ตรวจสอบโบนัส ฝากถอน และจัดการเครดิตของตนเองได้จากระบบเดียว โดยไม่ต้องเปิดบัญชีแยกตามหมวดเกมที่อยากลอง
      </p>

      <p class="mb-2 text-left text-base leading-relaxed text-[#e9ddc4]">
        นอกจากตัวเกมแล้ว สมาชิกยังตรวจสอบสิทธิ์โปรโมชั่นได้จากหน้าเว็บไซต์โดยตรง ทั้ง<strong class="text-[#e4c25a]">แนะนำเพื่อนรับโบนัส 0.8%</strong>
        และ<strong class="text-[#e4c25a]">คืนยอดเสีย 0.3%</strong> ตามเงื่อนไขของแต่ละรายการ พร้อมมีแอดมินคอยดูแลปัญหาการใช้งานตลอด 24 ชั่วโมง
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="หมวดเกมเดิมพันของ CASINO888 รวมไว้ในบัญชีเดียว" as="h2">
    <div>
      <p class="mb-4 text-left text-base leading-relaxed text-[#e9ddc4]">
        CASINO888 จัดหมวดหมู่เกมเดิมพันไว้ให้ค้นหาได้ง่าย สมาชิกสามารถเลือกเกม ตรวจสอบ
        <strong class="text-[#e4c25a]">อัตราจ่าย กติกา และขั้นต่ำของการเดิมพัน</strong> ได้ก่อนยืนยันรายการทุกครั้ง
        เพราะแต่ละหมวดใช้รูปแบบการคิดผลและเงื่อนไขไม่เหมือนกัน
      </p>

      <ul class="mb-4 flex flex-col gap-3 text-left text-base leading-relaxed text-[#e9ddc4]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e4c25a]">🃏</span>
          <span><strong class="text-[#e4c25a]">บาคาร่าและเกมคาสิโนสด</strong> สำหรับผู้ที่ต้องการเดิมพันเป็นรอบและเห็นผลทันทีตามที่ระบบเปิดให้บริการ</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e4c25a]">🎰</span>
          <span><strong class="text-[#e4c25a]">สล็อตออนไลน์</strong> มีให้เลือกหลายรูปแบบ ทั้งเกมรอบปกติและเกมที่มีฟีเจอร์พิเศษตามกลไกของแต่ละค่าย</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e4c25a]">🔢</span>
          <span><strong class="text-[#e4c25a]">หวยออนไลน์</strong> เปิดให้เลือกได้หลายประเภท โดยแต่ละประเภทมีรอบออกผลและอัตราจ่ายเป็นของตัวเอง</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e4c25a]">⚽</span>
          <span><strong class="text-[#e4c25a]">ฟุตบอล</strong> เดิมพันได้ตามรายการที่เปิดให้บริการ พร้อมรายละเอียดอัตราจ่ายและขั้นต่ำของแต่ละบิล</span>
        </li>
      </ul>

      <p class="mb-2 text-left text-base leading-relaxed text-[#c9c9c9]">
        ส่วนเรื่อง<strong class="text-[#c9c9c9]">ยอดเดิมพันขั้นต่ำ</strong> บางเกมรองรับการเดิมพันเริ่มต้นประมาณ 1 บาท แต่ขั้นต่ำจริงขึ้นอยู่กับข้อกำหนดของผู้ให้บริการแต่ละราย
        จึงควรตรวจสอบตัวเลขบนหน้าเกมก่อนทำรายการ และสำหรับข้อมูลเรื่องลิขสิทธิ์หรือสถานะการเป็นเว็บตรง ควรตรวจสอบรายละเอียดผู้ให้บริการเกมหรือใบอนุญาตที่เว็บไซต์แสดงโดยตรง
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="โปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ของ CASINO888" as="h2">
    <div>
      <p class="mb-2 text-left text-base leading-relaxed text-[#e9ddc4]">
        กิจกรรม<strong class="text-[#e4c25a]">แนะนำเพื่อน</strong> เริ่มจากการนำลิงก์แนะนำส่วนตัวไปแชร์ให้เพื่อน เมื่อเพื่อนสมัครและมียอดการใช้งานตรงตามเงื่อนไข
        ระบบจะคำนวณโบนัสแนะนำเพื่อน 0.8% ตามข้อกำหนด โดยสมาชิกตรวจสอบจำนวนการแนะนำ ยอดที่นำมาคำนวณ และโบนัสที่มีสิทธิ์รับได้ผ่านบัญชีของตนเอง
        ทั้งนี้การแชร์ลิงก์เพียงอย่างเดียวอาจยังไม่ทำให้ได้รับโบนัส หากโปรโมชั่นกำหนดให้ผู้ถูกแนะนำต้องสมัครหรือมียอดใช้งานตามเกณฑ์
      </p>

      <p class="mt-3 mb-2 text-left text-base leading-relaxed text-[#e9ddc4]">
        ส่วนสมาชิกที่มียอดเสียตรงตามข้อกำหนด สามารถตรวจสอบสิทธิ์รับ<strong class="text-[#e4c25a]">โบนัสคืนยอดเสีย 0.3%</strong> ตามรอบประจำวันที่ CASINO888 กำหนด
        ระบบจะแสดงยอดที่เข้าเกณฑ์และโบนัสที่สามารถรับได้ ก่อนกดยืนยันควรตรวจสอบประเภทเกม รอบคำนวณ และข้อกำหนดของโปรโมชั่นให้เรียบร้อย
        โดยโบนัสคืนยอดเสียไม่ได้รับประกันว่าจะชดเชยเงินที่เสียจากการเดิมพันทั้งหมด
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="สมัคร CASINO888 ง่าย ๆ 3 ขั้นตอน และแอดมินดูแลตลอด 24 ชั่วโมง" as="h2">
    <div>
      <p class="mb-4 text-left text-base leading-relaxed text-[#e9ddc4]">
        การสมัคร CASINO888 สามารถทำผ่านมือถือหรือคอมพิวเตอร์ได้ โดยหลังเปิดบัญชีเรียบร้อย สมาชิกสามารถเลือกหมวดเกมและจัดการเครดิตผ่านระบบออนไลน์ได้ทันที
        รวมถึงตรวจสอบโปรโมชั่น ประวัติการทำรายการ และสถานะฝากถอนจากบัญชีของตนเอง
      </p>

      <ol class="mb-4 flex flex-col gap-2 text-left text-base leading-relaxed text-[#e9ddc4]">
        <li class="flex gap-3"><span class="font-bold text-[#e4c25a]">1.</span> เปิดหน้าสมัคร CASINO888 และกรอกข้อมูลตามที่ระบบกำหนด</li>
        <li class="flex gap-3"><span class="font-bold text-[#e4c25a]">2.</span> Login เข้าบัญชี ฝากเครดิต และตรวจสอบโปรโมชั่นที่มีสิทธิ์รับ</li>
        <li class="flex gap-3"><span class="font-bold text-[#e4c25a]">3.</span> เลือกบาคาร่า สล็อต หวย หรือฟุตบอล ตรวจสอบขั้นต่ำและกติกาก่อนเดิมพัน</li>
      </ol>

      <p class="mb-4 text-left text-base leading-relaxed text-[#e9ddc4]">
        สมาชิกควรตั้งรหัสผ่านที่คาดเดายาก และ<strong class="text-[#e4c25a]">ไม่เปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น</strong>
        รวมถึงควรตรวจสอบว่ากำลังใช้งานช่องทางของผู้ให้บริการที่ถูกต้องก่อนทำธุรกรรมทุกครั้ง
      </p>

      <p class="mb-6 text-left text-base leading-relaxed text-[#e9ddc4]">
        หากพบปัญหาเกี่ยวกับการสมัครสมาชิก Login ไม่ได้ ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง โปรโมชั่นไม่แสดง หรือเข้าเกมไม่ได้ สามารถ
        <strong class="text-[#e4c25a]">ติดต่อแอดมิน CASINO888 ได้ตลอด 24 ชั่วโมง</strong> พร้อมแจ้งรายละเอียด เวลา และข้อมูลรายการที่เกี่ยวข้อง
        เพื่อช่วยให้เจ้าหน้าที่ตรวจสอบปัญหาได้ตรงจุด รวมถึงสอบถามขั้นตอนฝากถอน วิธีรับโปรโมชั่น หรือข้อมูลการใช้งานเกมแต่ละหมวดสำหรับสมาชิกใหม่ได้
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก CASINO888"
          class="flex items-center justify-center rounded-lg border border-[#e4c25a]/50 bg-gradient-to-r from-[#fdf49c] via-[#e4c25a] to-[#b28a2a] px-8 py-3 font-black text-[#050403] shadow-[0_0_15px_rgba(228,194,90,0.4)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ CASINO888"
          class="flex items-center justify-center rounded-lg border border-[#e4c25a]/60 bg-transparent px-8 py-3 font-bold text-[#e4c25a] transition-all hover:scale-105 hover:border-[#fdf49c] hover:bg-[#17120a]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
