---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

// MHEEPOOH168 เป็นเว็บรวมคาสิโนเกมที่รวมบาคาร่า สล็อต หวย และบอลไว้ในระบบเดียว —
// หน้านี้เคยเป็นบทความของแบรนด์ก่อนหน้า (ธีม "เว็บสล็อต + หวยออนไลน์ เว็บตรง
// ไม่ผ่านเอเย่นต์") และถูกเขียนใหม่ทั้งหมดรอบนี้ ไม่เหลือชื่อแบรนด์เดิมหรือข้อความ
// ที่บรีฟรอบนี้ไม่ได้ระบุแม้แต่บรรทัดเดียว
//
// ข้อเท็จจริงทุกบรรทัดมาจาก src/assets/content.txt เท่านั้น:
// เว็บรวมคาสิโนเกมหลายรูปแบบในระบบเดียว ทั้งบาคาร่า สล็อต หวย บอล ·
// ออกแบบให้เข้าถึงง่ายบนมือถือและคอมพิวเตอร์ · ระบบจัดหมวดหมู่เกมชัดเจน ·
// มาตรฐานการใช้งานที่เน้นความเป็นระบบในปี 2026 · แต่ละประเภทแยกเป็นเมนูชัดเจน
// สลับรูปแบบการเล่นได้จากบัญชีเดียว มีตัวเลือกจากหลายค่ายและหลายตลาด ·
// โปรโมชั่นสล็อตใช้ได้ทุกเกม ไม่จำกัด มีทั้งโบนัสคืนยอดเสีย 0.3% และโบนัสแนะนำ
// เพื่อน 0.8% แต่ละรายการมีเงื่อนไขแยกไว้ชัดเจน ตรวจสอบสิทธิ์ได้ก่อนกดรับ ·
// รองรับช่องทางธนาคารและวอลเลทที่กำหนดไว้ภายในเว็บไซต์ ตรวจสอบสถานะรายการและ
// ยอดผ่านบัญชีของตัวเองได้ · แอดมินให้บริการตลอด 24 ชั่วโมง
// — ห้ามอ้างเลขใบอนุญาต ปีที่ก่อตั้ง เลขทะเบียนบริษัท จำนวนสมาชิก รางวัล ที่อยู่
// บริษัท ชื่อค่ายเกม อัตราจ่ายเป็นตัวเลข หรือการันตีผลกำไร เพราะบรีฟไม่ได้ระบุไว้
//
// Announcement รอบนี้หมุนมาใช้ AnnouncementPremium ทั้งเว็บ — default message ของ
// ไฟล์นั้นเป็นคอปปี้ของ MHEEPOOH168 อยู่แล้ว จึงเรียกแบบ bare ไม่ต้องส่ง prop
//
// พาเลตต์ MHEEPOOH168: ทองสว่าง #fced74 เป็นสีเดียวที่ใช้กับ <strong> และสต็อปบน
// ของเกรเดียนต์ · ทองกลาง #f5b70a เป็นขอบ ไอคอน และตัวเลขลำดับ · ทองเข้ม #8a5a06
// เป็นสต็อปล่าง · แดงเลือดหมู #8f0505 กับแดงเข้ม #2b0101 เป็นผิวยกและตัวอักษรบน
// ปุ่มทอง · เนื้อความครีม #f1dccd — ไม่มีโทนทองบนดำของแบรนด์ก่อนหลงเหลือในไฟล์นี้
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 159
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "เกี่ยวกับ MHEEPOOH168 เว็บรวมคาสิโนเกมที่รวมบาคาร่า สล็อต หวย และบอลไว้ในระบบเดียว ระบบจัดหมวดหมู่เกมชัดเจน สลับเล่นได้จากบัญชีเดียว พร้อมแอดมินดูแล 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ MHEEPOOH168 เว็บรวมคาสิโนเกม มาตรฐานสากล 2026",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา MHEEPOOH168 เว็บรวมคาสิโนเกม บาคาร่า สล็อต หวย บอล" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ MHEEPOOH168 เว็บรวมคาสิโนเกม มาตรฐานสากล 2026" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f1dccd]">
        <strong class="text-[#fced74]">MHEEPOOH168</strong> คือเว็บรวมคาสิโนเกมที่รวบรวมความบันเทิงหลายรูปแบบไว้ในระบบเดียว
        <strong class="text-[#fced74]">ทั้งบาคาร่า สล็อต หวย และบอล</strong>
        พร้อมรูปแบบการใช้งานที่ออกแบบให้เข้าถึงได้ง่ายทั้งบนมือถือและคอมพิวเตอร์ ระบบจัดหมวดหมู่เกมชัดเจน ช่วยให้สมาชิกเลือกประเภทที่ต้องการได้สะดวก พร้อมมาตรฐานการใช้งานที่เน้นความเป็นระบบในปี 2026
      </p>

      <p class="text-left text-base leading-relaxed text-[#f1dccd]">
        หน้านี้รวบรวมไว้ว่าภายในเว็บไซต์มีเกมหมวดใดให้เลือกบ้าง โปรโมชั่นที่กำหนดไว้มีรายการอะไร ช่องทางธนาคารและวอลเลททำงานอย่างไร และติดต่อทีมงานได้ทางไหนเมื่อมีข้อสงสัยระหว่างใช้งาน
      </p>
    </div>
  </ContentBox>

  <ContentBox title="เกมเว็บ MHEEPOOH168 บาคาร่า สล็อต หวย บอล ครบวงจร" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f1dccd]">
        ภายใน MHEEPOOH168 มีเกมให้เลือกครบหลายหมวด ทั้งบาคาร่า สล็อต หวย และบอล โดย<strong class="text-[#fced74]">แต่ละประเภทถูกแยกเป็นเมนูอย่างชัดเจน</strong>
        ทำให้มองเห็นตั้งแต่หน้าแรกว่าหมวดที่ต้องการอยู่ตรงไหน และเข้าถึงเกมที่สนใจได้โดยไม่ต้องเปลี่ยนไปหลายเว็บไซต์
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f1dccd]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f5b70a]">🃏</span>
          <span><strong class="text-[#fced74]">บาคาร่า</strong> หมวดเกมไพ่ที่แยกเมนูไว้ของตัวเอง เปิดเข้าโต๊ะที่ต้องการได้จากหน้าหมวดโดยตรง</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f5b70a]">🎰</span>
          <span><strong class="text-[#fced74]">สล็อต</strong> รวมตัวเลือกจากหลายค่ายไว้ในหมวดเดียว เลือกดูได้ตามรายการที่เปิดให้ใช้งานในหน้าเกม</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f5b70a]">🔢</span>
          <span><strong class="text-[#fced74]">หวย</strong> หมวดตัวเลขที่แยกเมนูไว้ชัดเจน ตรวจสอบรายการที่เปิดรับได้จากหน้าเกมของเว็บไซต์</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f5b70a]">⚽</span>
          <span><strong class="text-[#fced74]">บอล</strong> เปิดให้เลือกจากหลายตลาด สลับเข้ามาดูได้จากเมนูหมวดเดียวกับเกมอื่น</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#f1dccd]">
        จุดที่ทำให้ใช้งานต่อเนื่องได้คือ<strong class="text-[#fced74]">สามารถสลับรูปแบบการเล่นได้จากบัญชีเดียว</strong>
        ไม่ต้องเปิดบัญชีแยกตามหมวด และมีตัวเลือกจากหลายค่ายและหลายตลาดให้เลือกภายในระบบเดียวกัน
        <strong class="text-[#fced74]">รายการเกมที่เปิดให้ใช้งานเปลี่ยนแปลงได้ตามรอบอัปเดต จึงควรตรวจสอบจากหน้าเกมของเว็บไซต์ทุกครั้ง</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title="โปรโมชั่นสล็อต MHEEPOOH168 ใช้ได้ทุกเกม ไม่จำกัด" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f1dccd]">
        โปรโมชั่นสล็อตของ MHEEPOOH168 มีตัวเลือกสำหรับสมาชิกที่ต้องการรับสิทธิ์เพิ่มเติมจากการใช้งาน โดยมีทั้ง
        <strong class="text-[#fced74]">โบนัสคืนยอดเสียและโบนัสแนะนำเพื่อน</strong>
        แต่ละโปรโมชั่นมีรายละเอียดและเงื่อนไขแยกไว้อย่างชัดเจน สามารถตรวจสอบสิทธิ์ก่อนรับเพื่อเลือกโปรโมชั่นที่เหมาะกับรูปแบบการเล่นของตัวเอง
      </p>

      <p class="text-left text-base leading-relaxed text-[#f1dccd]">
        <strong class="text-[#fced74]">โบนัสคืนยอดเสีย 0.3%</strong> สมาชิกรับได้ตามยอดและเงื่อนไขที่ระบบกำหนด โดยตรวจสอบรอบคำนวณ รายละเอียดของยอดที่เข้าเกณฑ์ และขั้นตอนรับสิทธิ์ได้จากหน้าโปรโมชั่น ช่วยให้ติดตามโบนัสแต่ละรอบได้ง่ายขึ้นและไม่พลาดสิทธิ์ที่ได้รับ
      </p>

      <p class="text-left text-base leading-relaxed text-[#f1dccd]">
        <strong class="text-[#fced74]">โบนัสแนะนำเพื่อน 0.8%</strong> ให้ตามเงื่อนไขที่กำหนด สมาชิกสามารถชวนคนรู้จักเข้ามาสมัครผ่านช่องทางที่ระบบรองรับ พร้อมตรวจสอบข้อมูลของโบนัสและยอดสิทธิ์ได้จากบัญชีสมาชิก
        เหมาะสำหรับผู้ที่ต้องการรับสิทธิ์เพิ่มเติมจากกิจกรรมแนะนำเพื่อน
      </p>

      <p class="text-left text-base leading-relaxed text-[#f1dccd]">
        <strong class="text-[#fced74]">แต่ละรายการมีเงื่อนไขแตกต่างกัน แนะนำให้ตรวจสอบรายละเอียดก่อนกดรับสิทธิ์ทุกครั้ง</strong>
        และยึดยอดกับสถานะที่ระบบแสดง ณ เวลาที่ทำรายการเป็นหลัก
      </p>
    </div>
  </ContentBox>

  <ContentBox title="MHEEPOOH168 รองรับทุกธนาคารและวอลเลท ไม่จำกัดยอด" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f1dccd]">
        ระบบของ MHEEPOOH168 <strong class="text-[#fced74]">รองรับช่องทางธนาคารและวอลเลทที่กำหนดไว้ภายในเว็บไซต์</strong>
        ช่วยให้สมาชิกเลือกวิธีจัดการเครดิตได้ตามความสะดวก โดยขั้นตอนถูกจัดวางให้เข้าใจง่าย เหมาะกับทั้งสมาชิกใหม่และผู้ที่ใช้งานเป็นประจำ
      </p>

      <p class="text-left text-base leading-relaxed text-[#f1dccd]">
        หลังทำรายการแล้ว <strong class="text-[#fced74]">สามารถตรวจสอบสถานะรายการและยอดผ่านบัญชีของตัวเองได้</strong>
        จึงไม่ต้องรอให้ใครยืนยันแทนก่อนจะรู้ว่ารายการเดินถึงขั้นไหน หากยอดหรือสถานะไม่ตรงกับที่ทำไว้ ให้เปิดดูประวัติรายการในบัญชีก่อน แล้วแจ้งทีมงานพร้อมเวลาและจำนวนเงิน
      </p>

      <p class="text-left text-base leading-relaxed text-[#f1dccd]">
        <strong class="text-[#fced74]">ช่องทางที่เปิดให้ใช้งานเป็นไปตามรายการที่ระบุไว้ภายในเว็บไซต์และเปลี่ยนแปลงได้</strong>
        จึงควรตรวจสอบรายการล่าสุดจากหน้าทำรายการก่อนทุกครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="แอดมิน MHEEPOOH168 คอยให้บริการ 24 ชั่วโมง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f1dccd]">
        หากมีข้อสงสัยเกี่ยวกับ<strong class="text-[#fced74]">การสมัคร เกม โปรโมชั่น ระบบเครดิต หรือการเข้าใช้งาน</strong>
        สามารถติดต่อแอดมิน MHEEPOOH168 ได้ตลอด 24 ชั่วโมง ทีมงานพร้อมให้ข้อมูลเกี่ยวกับเมนูและขั้นตอนต่าง ๆ ภายในเว็บไซต์ รวมถึงช่วยตรวจสอบปัญหาเบื้องต้นเพื่อให้สมาชิกใช้งานระบบได้ต่อเนื่องมากขึ้น
      </p>

      <p class="text-left text-base leading-relaxed text-[#f1dccd]">
        เวลาแจ้งปัญหาเข้ามา ควรระบุเวลาทำรายการ จำนวนเงิน และชื่อผู้ใช้ให้ครบ เพื่อให้ทีมงานตรวจสอบตามข้อมูลที่แจ้งได้เร็วขึ้น
        <strong class="text-[#fced74]">และไม่ควรเปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่นไม่ว่ากรณีใด</strong>
        รวมถึงตรวจสอบให้แน่ใจว่าเป็นบัญชี Line Official ที่ประกาศไว้บนเว็บไซต์ก่อนส่งข้อมูลใด ๆ
      </p>

      <p class="text-left text-base leading-relaxed text-[#f1dccd]">
        <strong class="text-[#fced74]">เกมทุกหมวดตัดสินผลแต่ละรอบแบบสุ่ม ไม่มีสูตรใดรับประกันผล</strong>
        สมาชิกจึงควรกำหนดงบประมาณก่อนเริ่มเล่นทุกครั้ง และหยุดเมื่อถึงขีดที่ตั้งไว้
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก MHEEPOOH168"
          class="flex items-center justify-center rounded-lg border border-[#fced74] bg-gradient-to-r from-[#fced74] via-[#f5b70a] to-[#8a5a06] px-8 py-3 font-black text-[#2b0101] shadow-[0_0_15px_rgba(245,183,10,0.42)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ MHEEPOOH168"
          class="flex items-center justify-center rounded-lg border border-[#8f0505] bg-[#2b0101] px-8 py-3 font-bold text-[#f1dccd] transition-all hover:scale-105 hover:border-[#f5b70a] hover:bg-[#540202] hover:text-[#fced74]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
