---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxHuay.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";

// LOTTOKA เป็น "เว็บแทงหวยออนไลน์" ล้วนๆ ไม่ใช่คาสิโน — หน้านี้เคยเป็นบทความของ
// แบรนด์คาสิโนก่อนหน้า (บาคาร่า สล็อต ยิงปลา บอล) และถูกเขียนใหม่ทั้งหมดรอบนี้
//
// ข้อเท็จจริงทุกบรรทัดมาจาก src/assets/content.txt เท่านั้น:
// แพลตฟอร์มหลักเว็บตรง ไม่ผ่านเอเย่นต์ · ทุกยอดฝาก-ถอนโอนเข้าบัญชีของบริษัทโดยตรง
// ไม่ใช้บัญชีม้าหรือผ่านบุคคลที่สาม ยอดเข้าเต็ม 100% ไม่หักค่าธรรมเนียม ·
// เปิดรับหวยรัฐบาลไทย (1 และ 16 ของเดือน) · หวยลาวพัฒนา (จันทร์ พุธ ศุกร์) ·
// หวยออมสิน · หวยฮานอย ปกติ/พิเศษ/VIP ออกทุกวัน · หวยหุ้นไทยและต่างประเทศ
// (นิเคอิ ดาวโจนส์ ฮั่งเส็ง) · 2 ตัวบาทละ 100 · 3 ตัวตรงบาทละ 1,000 ·
// จ่ายเต็มทุกบิล ไม่หักเปอร์เซ็นต์ รับแทงทุกเลข ไม่มีเลขอั้น ·
// สมัครออโต้ 3 ขั้นตอน · ทุกธนาคารและ TrueMoney Wallet ไม่มีขั้นต่ำในการฝาก ·
// แอดมิน Line Official 24 ชั่วโมง
// — ห้ามอ้างเลขใบอนุญาต ปีที่ก่อตั้ง เลขทะเบียนบริษัท จำนวนสมาชิก รางวัล
// หรือการันตีผลกำไร เพราะบรีฟไม่ได้ระบุไว้เลย
//
// Announcement รอบนี้หมุนมาใช้ AnnouncementHuay ทั้งเว็บ — default message ของ
// ไฟล์นั้นเป็นคอปปี้ของ LOTTOKA อยู่แล้ว จึงเรียกแบบ bare ไม่ต้องส่ง prop
//
// พาเลตต์ LOTTOKA: แดงโลโก้ #c21e22 นำโครงสร้าง · แดงสว่าง #e2353a สำหรับ hover
// ไอคอน และข้อควรระวัง · ชมพูอ่อน #ff9a9d เป็นสีเดียวที่ใช้กับ <strong> ·
// ครีม #ffe9ea บนปุ่มแดง · เนื้อความ #ded9da — ไม่มีทองหรือน้ำเงินของแบรนด์หวยเก่า
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 157
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "เกี่ยวกับ LOTTOKA เว็บแทงหวยออนไลน์หลัก ไม่ผ่านเอเย่นต์ ยอดฝากถอนเข้าบัญชีบริษัทโดยตรง เข้าเต็ม 100% เปิดรับหวยรัฐบาล ลาว ออมสิน ฮานอย หวยหุ้น จ่ายเต็มทุกบิล";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ LOTTOKA เว็บแทงหวยออนไลน์หลัก ไม่ผ่านเอเย่นต์",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา LOTTOKA เว็บแทงหวยออนไลน์หลัก จ่ายเต็มทุกบิล" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ LOTTOKA เว็บแทงหวยออนไลน์หลัก ไม่ผ่านเอเย่นต์" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ded9da]">
        <strong class="text-[#ff9a9d]">LOTTOKA (ลอตโตก้า)</strong> คือเว็บแทงหวยออนไลน์ที่เป็น<strong class="text-[#ff9a9d]">แพลตฟอร์มหลักเว็บตรง ไม่ผ่านเอเย่นต์</strong>
        เราดูแลระบบสมาชิก ระบบรับโพย และระบบการเงินด้วยตัวเองทั้งหมด สมาชิกจึงใช้บัญชีเดียวทำได้ครบตั้งแต่สมัครสมาชิก ฝากเครดิต เลือกตลาดหวยที่จะแทง ส่งโพย ตรวจผล ไปจนถึงถอนเงิน โดยไม่ต้องผ่านคนกลางคนใด
      </p>

      <p class="text-left text-base leading-relaxed text-[#ded9da]">
        สิ่งที่ทำให้ LOTTOKA ต่างจากเว็บทั่วไปคือระบบการเงินที่โปร่งใส ทุกยอดฝาก-ถอนของคุณจะถูกโอนเข้าสู่<strong class="text-[#ff9a9d]">บัญชีของบริษัทโดยตรง</strong>
        ไม่มีการใช้บัญชีม้าหรือผ่านบุคคลที่สาม หน้านี้รวบรวมไว้ว่าเราเป็นใคร เปิดรับหวยตลาดไหนบ้าง จ่ายอย่างไร และติดต่อทีมงานได้ทางช่องทางใด
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="ระบบการเงิน LOTTOKA โอนเข้าบัญชีของบริษัทโดยตรง ยอดเข้าเต็ม 100%" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ded9da]">
        หัวใจของ LOTTOKA คือการที่ยอดการฝากและถอนทุกรายการวิ่งเข้า<strong class="text-[#ff9a9d]">บัญชีของบริษัทโดยตรง</strong> ไม่ผ่านบัญชีม้าและไม่ผ่านบุคคลที่สาม
        วิธีนี้ช่วยเพิ่มความปลอดภัยให้สมาชิก ป้องกันปัญหาเว็บโดนบล็อกหรือการทุจริต และทำให้ทุกรายการถูกบันทึกอย่างถูกต้องและตรวจสอบย้อนกลับได้
      </p>

      <p class="text-left text-base leading-relaxed text-[#ded9da]">
        เมื่อเส้นทางเงินตรงแบบนี้ เราจึง<strong class="text-[#ff9a9d]">รับประกันยอดเงินเข้าเต็ม 100% ไม่มีหักค่าธรรมเนียม</strong> จ่ายไว จ่ายตรง
        ระบบรองรับทุกธนาคารชั้นนำในประเทศไทยและ TrueMoney Wallet ดำเนินการด้วยระบบออโต้ที่รวดเร็วทันใจ และ<strong class="text-[#ff9a9d]">ไม่มีขั้นต่ำในการฝากเงิน</strong>
      </p>

      <p class="text-left text-base leading-relaxed text-[#ded9da]">
        <strong class="text-[#e2353a]">ชื่อ-นามสกุลของบัญชีธนาคารหรือวอลเลทที่ผูกไว้ต้องตรงกับชื่อที่ใช้สมัคร</strong> เพราะระบบใช้ข้อมูลชุดนี้ในการโอนยอดเข้า-ออกบริษัท
        หากข้อมูลไม่ตรงกัน รายการจะตรวจสอบได้ช้าลง ให้ยึดตัวเลขและสถานะที่ระบบแสดง ณ เวลาทำรายการเป็นหลักเสมอ
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ตลาดหวยที่ LOTTOKA เปิดรับ ครบทั้งไทย ลาว ออมสิน ฮานอย และหวยหุ้น" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ded9da]">
        ที่ LOTTOKA เราคือ<strong class="text-[#ff9a9d]">ศูนย์รวมหวยออนไลน์ที่ครบครันที่สุด</strong> ตอบโจทย์คอหวยทุกสาย ไม่ว่าคุณจะชอบลุ้นรางวัลใหญ่หรือชอบทำกำไรทุกวัน
        เราเปิดรับแทงครบทุกประเภท และแต่ละตลาดมีวันออกรางวัลกับรอบปิดรับโพยเป็นของตัวเอง
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#ded9da]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e2353a]">🏛️</span>
          <span><strong class="text-[#ff9a9d]">หวยรัฐบาลไทย</strong> ลุ้นรวยทุกวันที่ 1 และ 16 ของเดือน เปิดรับแทงล่วงหน้า ปิดรับช้า ให้เวลาคุณหาเลขเด็ดได้อย่างเต็มที่</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ff8a8d]">🌏</span>
          <span><strong class="text-[#ff9a9d]">หวยลาว (ลาวพัฒนา)</strong> หวยยอดฮิตฝั่งโขง ออกรางวัลทุกวันจันทร์ พุธ ศุกร์ ลุ้นง่าย จ่ายหนัก</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e2353a]">🏦</span>
          <span><strong class="text-[#ff9a9d]">หวยออมสิน</strong> อีกหนึ่งทางเลือกสำหรับคนชอบหวยไทย อ้างอิงผลสลากออมสิน มั่นใจได้ในความโปร่งใส</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ff8a8d]">🕐</span>
          <span><strong class="text-[#ff9a9d]">หวยฮานอย (เวียดนาม)</strong> ลุ้นสนุกได้ทุกวันไม่มีวันหยุด มีทั้งฮานอยปกติ ฮานอยพิเศษ และฮานอย VIP</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e2353a]">📈</span>
          <span><strong class="text-[#ff9a9d]">หวยหุ้นต่างประเทศและหุ้นไทย</strong> ตอบสนองสายวิเคราะห์ด้วยหวยหุ้นชั้นนำ เช่น นิเคอิ ดาวโจนส์ ฮั่งเส็ง และอื่นๆ อีกมากมาย</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#ded9da]">
        <strong class="text-[#e2353a]">รอบที่เปิดรับและเวลาปิดรับโพยของแต่ละตลาดเปลี่ยนแปลงได้ตามรอบออกรางวัล จึงควรตรวจรอบล่าสุดในหน้าเลือกหวยก่อนส่งโพยทุกครั้ง</strong>
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="อัตราจ่าย LOTTOKA จ่ายเต็มทุกบิล รับแทงทุกเลข ไม่มีเลขอั้น" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ded9da]">
        เรากล้าให้มากกว่าใคร ด้วยความเป็นเว็บหลักที่มีฐานการเงินมั่นคงระดับประเทศ LOTTOKA จึงมอบ<strong class="text-[#ff9a9d]">อัตราการจ่ายที่สูงที่สุดในตลาด</strong>
        แทงถูกปุ๊บ รับเงินเต็มจำนวนปั๊บ ไม่มีหักเปอร์เซ็นต์ใดๆ ทั้งสิ้น
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#ded9da]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e2353a]">🎯</span>
          <span>
            <strong class="text-[#ff9a9d]">ถูก 2 ตัวจ่าย 100 บาท</strong> คุ้มค่าสุดๆ กับการแทงหวย 2 ตัวบนและ 2 ตัวล่าง รับอัตราจ่ายสูงสุดถึงบาทละ 100 ลงทุนเพียงเล็กน้อยก็สร้างกำไรก้อนโตได้ง่ายๆ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ff8a8d]">💰</span>
          <span>
            <strong class="text-[#ff9a9d]">ถูก 3 ตัวจ่าย 1,000 บาท</strong> สัมผัสประสบการณ์รวยพริบตาเมื่อทายผล 3 ตัวตรงถูกต้อง รับเงินรางวัลไปเลยในเรทสูงสุดบาทละ 1,000 จ่ายจริง จ่ายเต็ม ทุกบิลการเดิมพัน
          </span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#ded9da]">
        เรื่องเลขดังหรือเลขอั้นก็เช่นกัน LOTTOKA มีนโยบาย<strong class="text-[#ff9a9d]">รับแทงทุกเลข ไม่มีปิดกั้น</strong> หากคุณทำรายการแทงสำเร็จก่อนที่ระบบจะปิดรับโพย
        และถูกรางวัล เราการันตีจ่ายเต็มจำนวนตามเรทราคาที่กำหนดไว้ในบิล โดยไม่มีการหักเปอร์เซ็นต์ย้อนหลัง
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ทีมงาน LOTTOKA ดูแลผ่าน Line Official ตลอด 24 ชั่วโมง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ded9da]">
        <strong class="text-[#ff9a9d]">เราให้ความสำคัญกับการบริการลูกค้าเป็นอันดับหนึ่ง</strong> ทีมงานแอดมินคุณภาพของ LOTTOKA พร้อมสแตนด์บายดูแลคุณผ่าน Line Official ตลอด 24 ชั่วโมง
        ไม่ว่าคุณจะต้องการคำแนะนำในการแทงหวย สอบถามเรื่องระบบการโอนเงินตรงเข้าบริษัท หรือแจ้งปัญหาการใช้งาน แอดมินของเราพร้อมตอบกลับอย่างรวดเร็ว สุภาพ และแก้ปัญหาให้อย่างมืออาชีพ
      </p>

      <p class="text-left text-base leading-relaxed text-[#ded9da]">
        เวลาแจ้งปัญหา ควรระบุเวลาทำรายการ จำนวนเงิน และเลขบิลที่เกี่ยวข้องให้ครบ เพื่อให้เจ้าหน้าที่ตรวจสอบได้ตรงจุด
        <strong class="text-[#e2353a]">และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่นระหว่างการติดต่อเจ้าหน้าที่ไม่ว่ากรณีใด</strong>
      </p>

      <p class="text-left text-base leading-relaxed text-[#ded9da]">
        <strong class="text-[#e2353a]">การแทงหวยมีความเสี่ยงและผลรางวัลของแต่ละงวดไม่แน่นอน ไม่มีเลขใดรับประกันผลล่วงหน้า</strong> สมาชิกจึงควรกำหนดงบประมาณก่อนส่งโพยทุกครั้ง
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก LOTTOKA"
          class="flex items-center justify-center rounded-lg border border-[#c21e22]/70 bg-gradient-to-r from-[#e2353a] via-[#c21e22] to-[#7d1114] px-8 py-3 font-black text-[#ffe9ea] shadow-[0_0_15px_rgba(194,30,34,0.38)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ LOTTOKA"
          class="flex items-center justify-center rounded-lg border border-[#c21e22]/60 bg-[#1c0d0f] px-8 py-3 font-bold text-[#ff9a9d] transition-all hover:scale-105 hover:border-[#e2353a] hover:bg-[#3a0709]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
