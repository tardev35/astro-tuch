---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxCyberCut.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";

// HERO1688 เป็นเว็บ "สล็อตออโต้เว็บตรง" — รวมเกมสล็อตจากหลายค่ายไว้ในบัญชีเดียว ค่ายแท้
// ไม่ผ่านเว็บตัวแทน ไม่ใช่เว็บคาสิโนครบห้าหมวดแบบรอบรีแบรนด์ก่อนหน้า เนื้อหาทั้งหน้าจึงถูก
// เขียนใหม่ให้พูดถึงสล็อตล้วนตามบรีฟ: หมวดเกมสล็อตหลายค่ายในบัญชีเดียว ตรวจกติกาและอัตรา
// จ่ายก่อนเดิมพัน โปรโมชั่นแนะนำเพื่อน 0.8% คืนยอดเสีย 0.3% ฝากถอนวอลเลท/ธนาคาร ไม่มี
// ขั้นต่ำตามที่หน้าฝากถอนแสดง และแอดมิน 24 ชม.
// — ไม่มีการอ้างใบอนุญาต การจดทะเบียนบริษัท ปีที่ก่อตั้ง จำนวนสมาชิก การันตีผลกำไร
// ชื่อค่ายเกมรายใด หรือตาราง RTP ตายตัว
//
// Announcement หมุนมาใช้ AnnouncementCyber ตัวเดียวกับ index — default message ของไฟล์นั้น
// เป็นคอปปี้ของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ไม่ต้องส่ง prop
//
// โลโก้ HERO1688 เป็นสองโทน (HERO แดง / 1688 เงินโครเมียม) เงิน #e3e7ec จึงถูกใช้เป็น
// accent รองจริงในหน้านี้ ทั้งไอคอนสลับสีในลิสต์และปุ่มเข้าสู่ระบบ ไม่ใช่แดงจางลง
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 152
const pageDescription =
  "เกี่ยวกับ HERO1688 เว็บสล็อตออโต้เว็บตรง รวมเกมสล็อตจากหลายค่ายไว้ในบัญชีเดียว ไม่ผ่านเว็บตัวแทน พร้อมระบบฝากถอนวอลเลทและแอดมินดูแลสมาชิกตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ HERO1688 สล็อตออโต้เว็บตรง รวมเกมหลายค่ายไว้ในบัญชีเดียว",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา HERO1688 สล็อตออโต้เว็บตรง ค่ายแท้ ไม่ผ่านเว็บตัวแทน" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ HERO1688 สล็อตออโต้เว็บตรง รวมเกมหลายค่ายไว้ในบัญชีเดียว" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dbe1ea]">
        <strong class="text-[#f4f7fb]">HERO1688</strong> ให้บริการ<strong class="text-[#f4f7fb]">เกมสล็อตออนไลน์ผ่านระบบออโต้</strong>
        โดยรวมเกมจากหลายค่ายไว้ให้เลือกผ่านบัญชีเดียว รองรับการใช้งานทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์
        หน้าเว็บไซต์รวมส่วนเลือกเกม ฝากถอน ตรวจสอบโปรโมชั่น และจัดการเครดิตไว้ที่เดียว พร้อมช่องทางวอลเลทและธนาคารตามที่ระบบเปิดรองรับ
      </p>

      <p class="text-left text-base leading-relaxed text-[#dbe1ea]">
        นอกจากหมวดเกมสล็อตแล้ว ยังมี<strong class="text-[#e3e7ec]">โปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไข</strong>
        รวมถึงแอดมินคอยดูแลและช่วยตรวจสอบปัญหาการใช้งานตลอด 24 ชั่วโมง
        สมาชิกจึงตรวจสอบสิทธิ์ เงื่อนไข และสถานะรายการของตนเองได้จากบัญชีเดียวโดยไม่ต้องสมัครหลายครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="เว็บสล็อต HERO1688 รวมเกมจากหลายค่าย สลับเล่นได้จากบัญชีเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dbe1ea]">
        HERO1688 รวบรวมเกมสล็อตจากหลายผู้ให้บริการไว้เป็นหมวดหมู่ สมาชิกสามารถ<strong class="text-[#f4f7fb]">ค้นหาเกมที่ต้องการและสลับค่ายผ่านบัญชีเดียวได้โดยไม่ต้องสมัครใหม่</strong>
        พร้อมตรวจสอบกติกา อัตราจ่าย และวงเงินเดิมพันของแต่ละเกมก่อนทำรายการได้ด้วยตัวเอง
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#dbe1ea]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ff5a5d]">🎰</span>
          <span><strong class="text-[#f4f7fb]">สล็อตคลาสสิก</strong> รูปแบบวงล้อและเส้นรางวัลไม่ซับซ้อน เหมาะกับผู้เริ่มต้นที่อยากเห็นวิธีนับผลของแต่ละรอบให้ชัดก่อน</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e3e7ec]">🎁</span>
          <span><strong class="text-[#e3e7ec]">เกมโบนัส</strong> มีรอบพิเศษที่เข้าเงื่อนไขแล้วจึงเปิด หน้าอธิบายในตัวเกมระบุไว้ว่าสัญลักษณ์ชุดใดพาเข้ารอบโบนัส</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ff5a5d]">🌀</span>
          <span><strong class="text-[#f4f7fb]">ฟรีสปิน</strong> จำนวนสปินและตัวคูณต่างกันไปตามเกม ควรดูเงื่อนไขการรับและการนับผลของแต่ละเกมก่อนเริ่ม</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e3e7ec]">🕹️</span>
          <span><strong class="text-[#e3e7ec]">เกมรูปแบบใหม่ตามที่แต่ละค่ายเปิดให้บริการ</strong> รายชื่อค่ายและเกมที่พร้อมใช้งานเปลี่ยนแปลงได้ ให้ยึดหน้าเลือกเกมล่าสุดเป็นหลัก</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#dbe1ea]">
        สำหรับคำว่า “ค่ายแท้” และ “ไม่ผ่านเว็บตัวแทน” ข้อมูลผู้ให้บริการและรายละเอียดที่ตรวจสอบได้จะแสดงอยู่บนเว็บไซต์
        <strong class="text-[#ff5a5d]">ส่วนผลลัพธ์ของเกมสล็อตเป็นไปตามระบบของแต่ละเกม จึงไม่สามารถรับประกันว่าเกมใดจะแตกไวหรือสร้างกำไรได้ทุกครั้ง</strong>
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="โปรโมชั่น HERO1688 แนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dbe1ea]">
        สมาชิกที่มีบัญชี HERO1688 สามารถ <strong class="text-[#f4f7fb]">Login เพื่อตรวจสอบโปรโมชั่นที่เปิดให้รับในแต่ละช่วง</strong>
        โดยมีทั้งกิจกรรมแนะนำเพื่อนและโบนัสคืนยอดเสีย สิทธิ์แต่ละรายการอาจกำหนดยอดที่ใช้คำนวณ รอบรับโบนัส เกมที่เข้าร่วม
        และเงื่อนไขการถอนแตกต่างกัน จึงควรอ่านรายละเอียดให้ครบก่อนกดรับโปรโมชั่น
      </p>

      <p class="text-left text-base leading-relaxed text-[#dbe1ea]">
        โปรโมชั่นแนะนำเพื่อนให้สมาชิกแชร์ลิงก์แนะนำส่วนตัวให้เพื่อน เมื่อเพื่อนสมัครและมียอดใช้งานตรงตามข้อกำหนด ระบบจะคำนวณโบนัส
        <strong class="text-[#e3e7ec]">แนะนำเพื่อน 0.8%</strong> จากยอดที่เข้าเงื่อนไข และตรวจสอบจำนวนเพื่อน ยอดคำนวณ และโบนัสที่มีสิทธิ์รับผ่านบัญชีสมาชิกได้ด้วยตัวเอง
        ส่วนสมาชิกที่มียอดเสียตรงตามข้อกำหนดสามารถตรวจสอบสิทธิ์รับ<strong class="text-[#e3e7ec]">โบนัสคืนยอดเสีย 0.3%</strong>
        ตามรอบที่ HERO1688 กำหนด โดยระบบจะแสดงยอดที่เข้าเงื่อนไขและจำนวนโบนัสที่สามารถกดรับได้
      </p>

      <p class="text-left text-base leading-relaxed text-[#dbe1ea]">
        ก่อนรับสิทธิ์ทุกครั้งควรตรวจสอบ<strong class="text-[#ff5a5d]">ประเภทเกมที่ร่วมรายการ รอบคำนวณ และเงื่อนไขของโปรโมชั่น</strong>ให้เรียบร้อย
        เพราะวิธีคำนวณและข้อกำหนดล่าสุดของแต่ละรายการไม่เหมือนกัน
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ระบบฝากถอน HERO1688 ไม่มีขั้นต่ำ รองรับวอลเลทและธนาคาร" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dbe1ea]">
        HERO1688 มีระบบฝากถอนที่<strong class="text-[#f4f7fb]">ช่วยให้สมาชิกจัดการเครดิตผ่านบัญชีของตนเอง</strong>
        สามารถเลือกใช้วอลเลทหรือบัญชีธนาคารจากช่องทางที่เว็บไซต์เปิดรองรับ ทำรายการฝาก ส่งคำขอถอน
        และตรวจสอบสถานะรายการผ่านมือถือได้โดยตรง ช่วยลดขั้นตอนและไม่จำเป็นต้องแจ้งรายการกับเจ้าหน้าที่ทุกครั้ง
      </p>

      <p class="text-left text-base leading-relaxed text-[#dbe1ea]">
        เงื่อนไข “ไม่มีขั้นต่ำ” และ “รองรับทุกธนาคาร” ให้ยึดข้อมูลที่แสดงในหน้าฝากถอน ณ เวลาทำรายการเป็นหลัก
        <strong class="text-[#ff5a5d]">เนื่องจากช่องทางแต่ละประเภทอาจกำหนดยอดขั้นต่ำ วงเงิน หรือเงื่อนไขแตกต่างกัน</strong>
        ก่อนกดยืนยันจึงควรตรวจสอบชื่อบัญชี จำนวนเงิน และสถานะของช่องทางที่เลือกให้ครบทุกครั้ง
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ติดต่อสอบถามแอดมิน HERO1688 ได้ตลอด 24 ชั่วโมง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dbe1ea]">
        หากสมาชิกพบปัญหาเกี่ยวกับการสมัคร Login ไม่ได้ ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง โปรโมชั่นไม่แสดง หรือเข้าเกมสล็อตไม่ได้ สามารถ
        <strong class="text-[#f4f7fb]">ติดต่อแอดมิน HERO1688 ได้ตลอด 24 ชั่วโมง</strong>
        โดยควรแจ้งเวลา จำนวนเงิน และรายละเอียดของรายการให้ครบ เพื่อช่วยให้เจ้าหน้าที่ตรวจสอบปัญหาได้รวดเร็วและตรงจุด
      </p>

      <p class="text-left text-base leading-relaxed text-[#dbe1ea]">
        สมาชิกใหม่ยังสามารถสอบถามขั้นตอนการฝากถอน วิธีรับโปรโมชั่น หรือการเข้าใช้งานเกมของแต่ละค่ายได้
        หากเป็นปัญหาด้านธุรกรรมควรเก็บหลักฐานรายการไว้จนกว่าการตรวจสอบจะเสร็จสิ้น
        และ<strong class="text-[#e3e7ec]">ไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น</strong>
      </p>

      <p class="text-left text-base leading-relaxed text-[#dbe1ea]">
        <strong class="text-[#ff5a5d]">การเดิมพันมีความเสี่ยงและผลของแต่ละรอบไม่แน่นอน ไม่มีเกมใดรับประกันผลล่วงหน้า</strong>
        สมาชิกจึงควรกำหนดงบประมาณก่อนเริ่มเล่นทุกครั้ง
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก HERO1688"
          class="flex items-center justify-center rounded-lg border border-[#7d0507]/60 bg-gradient-to-r from-[#ff5a5d] via-[#e11015] to-[#7d0507] px-8 py-3 font-black text-[#010207] shadow-[0_0_15px_rgba(225,16,21,0.35)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ HERO1688"
          class="flex items-center justify-center rounded-lg border border-[#e3e7ec]/55 bg-transparent px-8 py-3 font-bold text-[#e3e7ec] transition-all hover:scale-105 hover:border-[#e3e7ec] hover:bg-[#1a0509]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
