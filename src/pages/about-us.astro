---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char, so a byte count reads
// ~3x too long). One string, reused by MainLayout's meta and the WebPage node.
const pageDescription =
  "รู้จัก BETPLAY369 เว็บเกมคาสิโนที่รวมบาคาร่า คาสิโนสด สล็อต หวย มวย และฟุตบอลไว้ในบัญชีเดียว พร้อมโปรโมชั่นตามเงื่อนไข และแอดมินดูแลสมาชิกตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ BETPLAY369 เว็บเกมคาสิโนที่รวมทุกหมวดไว้ในบัญชีเดียว",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา BETPLAY369 เว็บเกมคาสิโนครอบคลุมทั้งวงจร แบรนด์แท้ของเอเชีย" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ BETPLAY369" as="h1">
    <div>
      <p class="mb-6 text-left text-base leading-relaxed text-[#dfd0ee]">
        <strong class="text-[#ff35b4]">BETPLAY369</strong> คือ <strong class="text-[#ff35b4]">เว็บเกมคาสิโนออนไลน์แบบครอบคลุมครบวงจร</strong>
        ที่ให้บริการสมาชิกซึ่งต้องการรวมเกมเดิมพันออนไลน์หลายประเภทไว้ในบัญชีเดียว ทั้งบาคาร่า คาสิโนสด สล็อต หวย มวย และฟุตบอล
        รองรับการใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ พร้อมเกมคาสิโนสดจากโต๊ะ Live ที่เปิดให้บริการตามระบบ
      </p>

      <p class="mb-2 text-left text-base leading-relaxed text-[#dfd0ee]">
        สมาชิกจัดการทุกอย่างได้จากบัญชีเดียว ทั้งสมัครสมาชิก ฝากเครดิต เลือกหมวดเกม ตรวจสอบโปรโมชั่นที่มีสิทธิ์รับ ดูประวัติรายการ และถอนเงิน พร้อม
        <strong class="text-[#ff35b4]">แอดมิน BETPLAY369 คอยช่วยตรวจสอบรายการและให้คำแนะนำด้านการใช้งานตลอด 24 ชั่วโมง</strong>
        ทั้งนี้กติกา อัตราจ่าย และรายละเอียดการเดิมพันของแต่ละหมวดแตกต่างกัน สมาชิกจึงควรตรวจสอบรายละเอียดที่แสดงในหน้าเกมก่อนยืนยันการเดิมพันทุกครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="หมวดเกมเดิมพันที่ BETPLAY369 เปิดให้ใช้งานจากบัญชีเดียว" as="h2">
    <div>
      <p class="mb-2 text-left text-base leading-relaxed text-[#dfd0ee]">
        BETPLAY369 จัดหมวดหมู่เกมให้เลือกได้ตามความสนใจ มีทั้ง <strong class="text-[#ff35b4]">บาคาร่าและคาสิโนสด</strong> สำหรับผู้ที่ชอบรูปแบบ Live,
        สล็อตออนไลน์หลากหลายค่าย, หวยออนไลน์หลายรอบ รวมถึงการเดิมพันมวยและฟุตบอล สมาชิกเลือกหมวดเกม ตรวจสอบกติกา อัตราจ่าย
        และรายละเอียดการเดิมพันผ่านบัญชีเดียวได้สะดวกทั้งบนมือถือ แท็บเล็ต และคอมพิวเตอร์ ไม่ต้องโยกเครดิตไปมาระหว่างหลายบัญชี
      </p>

      <p class="mt-3 mb-2 text-left text-base leading-relaxed text-[#dfd0ee]">
        เกมและการเดิมพันแต่ละประเภทมีความเสี่ยงแตกต่างกัน
        <strong class="text-[#ff35b4]">ผลการแข่งขันหรือผลของเกมไม่สามารถรับประกันล่วงหน้าได้</strong> จึงควรตรวจสอบกติกาและกำหนดงบประมาณก่อนยืนยันการเดิมพัน
        ส่วนข้อมูลเกี่ยวกับผู้ให้บริการเกม ลิขสิทธิ์ หรือแหล่งที่มาของเกม แนะนำให้ตรวจสอบจากรายละเอียดที่เว็บไซต์หรือผู้ให้บริการประกาศโดยตรงก่อนใช้งาน
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="โปรโมชั่นและเงื่อนไขที่ BETPLAY369 แจ้งไว้ให้ตรวจสอบ" as="h2">
    <div>
      <p class="mb-2 text-left text-base leading-relaxed text-[#dfd0ee]">
        สมาชิกตรวจสอบโปรโมชั่น BETPLAY369 ที่กำลังเปิดให้รับได้จากหน้าโปรโมชั่น รายการหลักคือ
        <strong class="text-[#ff35b4]">โปรโมชั่นคืนยอดเสีย รับโบนัส <span class="text-[#ffd54a]">0.3%</span></strong> ตามรอบที่กำหนด และ
        <strong class="text-[#ff35b4]">โปรโมชั่นแนะนำเพื่อน รับโบนัส <span class="text-[#ffd54a]">0.8%</span></strong> สำหรับรายการที่เข้าเงื่อนไข
        แม้เป็นผู้เล่นที่ใช้เงินเดิมพันไม่สูงก็สามารถตรวจสอบสิทธิ์ในบัญชีของตนเองก่อนกดรับได้
      </p>

      <p class="mt-3 mb-2 text-left text-base leading-relaxed text-[#dfd0ee]">
        โบนัสแต่ละรายการอาจกำหนดยอดขั้นต่ำ เกมที่เข้าร่วม วิธีคำนวณ รอบรับ และเงื่อนไขการถอนแตกต่างกัน ระบบจะแสดงยอดที่นำมาคำนวณและโบนัสที่กดรับได้ผ่านบัญชีสมาชิก
        แนะนำให้อ่านเงื่อนไขให้ครบถ้วนก่อนกดรับสิทธิ์ทุกครั้ง เพื่อเลือกโปรโมชั่นให้ตรงกับรูปแบบการใช้งานของตนเอง
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="การเริ่มใช้งานและการดูแลสมาชิกของทีมงาน BETPLAY369" as="h2">
    <div>
      <p class="mb-4 text-left text-base leading-relaxed text-[#dfd0ee]">
        ผู้ใช้งานใหม่สมัคร BETPLAY369 ผ่านหน้าเว็บไซต์ได้ด้วยขั้นตอนที่ไม่ซับซ้อน เริ่มจากกรอกข้อมูลตามที่ระบบกำหนด จากนั้น Login เข้าสู่บัญชี ฝากเครดิต
        แล้วเลือกหมวดเกมและขนาดเดิมพันที่ต้องการ โดยควรใช้ข้อมูลที่ถูกต้องในการสมัคร และ
        <strong class="text-[#ff35b4]">ไม่เปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น</strong>
      </p>

      <p class="mb-4 text-left text-base leading-relaxed text-[#dfd0ee]">
        หลังเปิดบัญชีเรียบร้อย สมาชิกตรวจสอบเครดิต ประวัติรายการ โปรโมชั่น และช่องทางฝากถอนได้จากระบบสมาชิก หากพบปัญหาสมัครสมาชิกไม่ได้ Login ไม่ผ่าน
        ฝากเงินแล้วเครดิตไม่เข้า โปรโมชั่นไม่แสดง หรือเข้าโต๊ะคาสิโน Live ไม่ได้ สามารถแจ้ง <strong class="text-[#ff35b4]">แอดมิน BETPLAY369</strong>
        พร้อมรายละเอียดและเวลาที่พบปัญหา เพื่อให้ทีมงานตรวจสอบระบบและแนะนำขั้นตอนดำเนินการต่อได้ตรงจุดตลอด 24 ชั่วโมง
      </p>

      <p class="mb-6 text-left text-base leading-relaxed text-[#dfd0ee]">
        สำหรับคำกล่าวเรื่องไลฟ์สดหรือการส่งสัญญาณจากต่างประเทศ ควรยึดข้อมูลของสตูดิโอและผู้ให้บริการเกมที่แสดงในระบบเป็นหลัก เนื่องจากแต่ละโต๊ะ Live
        อาจมาจากผู้ให้บริการและสถานที่แตกต่างกัน ทั้งนี้ <strong class="text-[#ff35b4]">การเดิมพันมีความเสี่ยงและไม่มีรูปแบบใดรับประกันผลรางวัลได้</strong>
        ผู้เล่นจึงควรกำหนดงบประมาณของตัวเองก่อนเล่นทุกครั้ง และเล่นเท่าที่รับความเสี่ยงไหว
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก BETPLAY369"
          class="flex items-center justify-center rounded-lg bg-gradient-to-r from-[#ff35b4] via-[#e5399f] to-[#6d1750] px-8 py-3 font-black text-[#f4ebff] shadow-[0_0_15px_rgba(229,57,159,0.32)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ BETPLAY369"
          class="flex items-center justify-center rounded-lg border border-[#e5399f]/70 bg-transparent px-8 py-3 font-bold text-[#dfd0ee] transition-all hover:scale-105 hover:border-[#ff35b4] hover:bg-[#1a0730]/70">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
