---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่ม) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง
// ไม่ได้มาจากเช็กลิสต์หัวข้อของ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน
// SUB-PAGES ที่ให้ body มา ทั้งหน้าจึงเขียนขึ้นใหม่บนข้อเท็จจริงของ PKG44 เท่านั้น
//
// รอบนี้ (ดรอป 2026-09-27) คือ PKG44 **เว็บเกมปั่นสล็อตหลายค่าย** จุดขายของบรีฟคือ
// รวมเกมปั่นสล็อตจากหลายค่ายไว้ในระบบเดียว + รูปแบบการเชื่อมต่อ API + ข้อมูลลิขสิทธิ์
// ตามที่เว็บไซต์ระบุ ส่วนคอปปี้รอบก่อนเป็นของแบรนด์ก่อนหน้า ซึ่งเป็น **คาสิโน** และบรีฟ
// รอบนั้นขายคำว่า "คาสิโนแท้ จากบริษัทโดยตรง" กับ "เว็บนี้ไม่มีประวัติโกง" — บรีฟของ
// PKG44 **ไม่ได้ระบุสักคำ** ทั้งหน้าจึงถูกเขียนใหม่ทั้งบท ไม่ใช่แทนชื่อแบรนด์ทับของเดิม
// หัวข้อ "คาสิโนแท้ เชื่อมต่อจากบริษัทโดยตรง เว็บนี้ไม่มีประวัติโกง" และ "รวมเกมหลาย
// ประเภทไว้ให้เลือกจากบัญชีเดียว" ของรอบก่อนถูกถอดออก แทนด้วยหัวข้อเรื่องสล็อตหลายค่าย
// รูปแบบการเชื่อมต่อ API/ลิขสิทธิ์ และทางเข้า/เมนู ซึ่งเป็นสิ่งที่บรีฟรอบนี้พูดถึงจริง
//
// ข้อเท็จจริงทุกบรรทัดมาจากบรีฟรอบนี้เท่านั้น (brand-spec §4/§5): เกมปั่นสล็อต ·
// สล็อตหลายค่ายในระบบเดียว · รูปแบบการเชื่อมต่อ API · ข้อมูลลิขสิทธิ์จากเจ้าของ/
// ผู้ให้บริการ · สล็อตยอดนิยม เกมโบนัส และเกมใหม่ที่อัปเดตตามช่วงเวลา · เมนูแบ่ง
// หมวดหมู่ชัดเจน · บัญชีเดียว · รองรับมือถือและคอมพิวเตอร์ · ตรวจสอบชื่อค่ายและ
// รายละเอียดเกมก่อนเริ่มเล่น · ระบบบัญชีสมาชิก · โบนัสแนะนำเพื่อน 0.8% · โบนัส
// คืนยอดเสีย 0.3% · ยอดที่เข้าเกณฑ์ / รอบรับสิทธิ์ / รอบคำนวณ / เงื่อนไข ·
// สมัครเองผ่านหน้าเว็บ 3 ขั้นตอน · ติดต่อเจ้าหน้าที่ได้ตลอด 24 ชั่วโมง
// — ห้ามอ้าง บาคาร่า คาสิโนสด เกมโต๊ะ รูเล็ต ไฮโล หวย บอล/กีฬา ชื่อค่ายหรือสตูดิโอ
// เจาะจง ชื่อเกมเจาะจง ค่า RTP เลขใบอนุญาต ปีที่ก่อตั้ง เลขทะเบียนบริษัท จำนวนสมาชิก
// ชื่อธนาคาร ฝากถอนออโต้/ไม่มีขั้นต่ำ เครดิตฟรี การันตีว่าจะชนะ หรือ "ไม่มีประวัติโกง"
// (คำของแบรนด์ก่อนหน้า) เพราะบรีฟรอบนี้ไม่ได้ระบุไว้
//
// ศัพท์ช่องทางติดต่อ: บรีฟรอบนี้พูดแค่ "ติดต่อเจ้าหน้าที่ PKG44" เฉย ๆ **ไม่ได้ระบุไลน์**
// เนื้อความจึงห้ามเขียนว่าผ่านช่องทางไลน์/ไลน์แอด/LINE OFFICIAL ส่วนป้ายบนปุ่มที่ลิงก์
// /line ยังอ่านว่า "ติดต่อผ่าน Line Official" ได้ตามมาร์กอัปเดิม เพราะนั่นคือปลายทางจริง
//
// Announcement รอบนี้หมุนจาก Announcement2 มาเป็น AnnouncementPremium ทั้งเว็บ —
// default message ของไฟล์นั้นเป็นคอปปี้ของ PKG44 แล้ว จึงเรียกแบบ bare เหมือน
// index.astro ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ PKG44 เป็น **ทองเมทัลลิก + เงินโครเมียมบนพื้นดำ** ตามโลโก้ (P G 44 เป็นทอง /
// K เป็นเงินโครเมียม) ตารางแมป old→new hex อยู่ที่ brand-spec §2:
// ผิวการ์ด #12100a · ผิวการ์ดยก/hover #2a2110 · ทองแบรนด์ #fdd32a ·
// ทองสว่าง #ffe27a · ทองอ่อนสุด #ffeeb8 · ทองลึก #c8920a · ทองเข้มสุด #15110a
// (ตัวอักษรบนพื้นทอง) · เงินโครเมียมกลาง #c2c8d0 · เงินโครเมียมสว่าง #f2f4f7 ·
// เนื้อความ #efe6d2 (BRAND_TEXT) · เน้นใน strong #fff8e1
// ปุ่มหลักไล่ทองอ่อนสุด → ทองแบรนด์ → ทองลึก ส่วนปุ่มรองใช้เส้นขอบเงินโครเมียม
// เพื่อให้คู่ทอง/เงินอ่านออกจากหน้าเอง
// ส่วน #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ตามเดิม
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลางที่ไม่หมุนตามรอบรีแบรนด์ และรอบนี้
// orchestrator เป็นคนรีธีม) — สีเนื้อความจึงตรงกับที่การ์ดกำหนดไว้อยู่แล้ว
//
// ไม่มีลิงก์ /ตรวจหวย หรือ /แนวทาง ในหน้านี้: PKG44 เป็นแบรนด์สล็อต ไม่ใช่เว็บหวย
// สองหน้านั้นไม่มี route รอบนี้ href ที่ชี้ route ซึ่งไม่มีใน dist/ จะทำให้ verify-build แดง
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index และ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า
// และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กค้างของลูกค้าเจ้าอื่น ห้าม import
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 152
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "เกี่ยวกับ PKG44 เว็บเกมปั่นสล็อตหลายค่ายในระบบเดียว พร้อมรูปแบบการเชื่อมต่อ API และข้อมูลลิขสิทธิ์จากเจ้าของเกม โบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%";

const pageTitle = "เกี่ยวกับเรา PKG44 เกมปั่นสล็อตAPIแท้ รับอนุญาตลิขสิทธิ์จากเจ้าของ";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#efe6d2]">
        <strong class="text-[#fff8e1]">PKG44</strong> คือเว็บที่<strong class="text-[#fff8e1]">รวมเกมปั่นสล็อตจากหลายค่ายไว้ในระบบเดียว</strong>
        พร้อมรูปแบบการเชื่อมต่อ API และข้อมูลลิขสิทธิ์ตามที่เว็บไซต์ระบุ สมาชิกจึงเลือกเกมได้หลายแนวจากบัญชีเดียว และเปิดใช้งานได้ทั้งบนมือถือและคอมพิวเตอร์ผ่านเมนูที่จัดไว้ชัดเจน
      </p>

      <p class="text-left text-base leading-relaxed text-[#efe6d2]">
        หน้านี้รวบรวมไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่รายการเกมสล็อตที่แบ่งหมวดหมู่ไว้ รูปแบบการเชื่อมต่อ API และข้อมูลลิขสิทธิ์ ไปจนถึงโปรโมชั่นที่ตรวจสอบเงื่อนไขได้จากหน้าโปรโมชั่น
        ขั้นตอนการสมัครสมาชิก และช่องทางสอบถามเจ้าหน้าที่เมื่อไม่แน่ใจในขั้นตอนใด
      </p>

      <p class="text-left text-base leading-relaxed text-[#efe6d2]">
        <strong class="text-[#fff8e1]">รายการเกมและเงื่อนไขของโปรโมชั่นอาจเปลี่ยนแปลงตามช่วงเวลา</strong>
        รายละเอียดทั้งหมดจึงยึดตามข้อมูลที่เว็บไซต์แสดงไว้จริงในขณะนั้นเป็นหลัก และควรตรวจสอบรายการล่าสุดจากช่องทางอย่างเป็นทางการของเว็บไซต์ก่อนทำรายการทุกครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="PKG44 รวมเกมปั่นสล็อตหลายค่ายไว้ในระบบเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#efe6d2]">
        สิ่งที่เว็บไซต์ระบุไว้เป็นตัวตนของ PKG44 คือ <strong class="text-[#fff8e1]">การรวมเกมปั่นสล็อตจากหลายค่ายมาไว้ในระบบเดียว</strong>
        สมาชิกจึงเลือกเกมได้หลายแนวโดยไม่ต้องสลับไปเปิดหลายเว็บไซต์ ทั้งสล็อตยอดนิยม เกมโบนัส และเกมใหม่ที่อัปเดตตามช่วงเวลาที่เว็บไซต์กำหนด
      </p>

      <p class="text-left text-base leading-relaxed text-[#efe6d2]">
        รายการทั้งหมดถูกจัดไว้ใน<strong class="text-[#fff8e1]">เมนูที่แบ่งหมวดหมู่ชัดเจน</strong>
        สมาชิกเห็นภาพรวมของค่ายและเกมที่เปิดให้เลือกได้ก่อน แล้วเปิดเข้าไปดูรายละเอียดของเกมที่สนใจต่อได้ทันที โดยรายการที่แสดงยึดตามสิ่งที่ระบบเปิดให้บริการอยู่ในขณะนั้น
      </p>
    </div>
  </ContentBox>

  <ContentBox title="รูปแบบการเชื่อมต่อ API และข้อมูลลิขสิทธิ์จากเจ้าของเกม" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#efe6d2]">
        ตามข้อมูลที่เว็บไซต์ระบุ PKG44 ใช้<strong class="text-[#fff8e1]">รูปแบบการเชื่อมต่อ API และมีข้อมูลเกี่ยวกับลิขสิทธิ์ของเกมจากผู้ให้บริการ</strong>
        รายละเอียดส่วนนี้ถูกแสดงไว้ให้อ่านประกอบ สมาชิกจึงตรวจสอบได้ว่าเกมแต่ละรายการมาจากค่ายใดก่อนเริ่มเล่น
      </p>

      <p class="text-left text-base leading-relaxed text-[#efe6d2]">
        ก่อนใช้งานจริง แนะนำให้<strong class="text-[#fff8e1]">ตรวจสอบชื่อค่าย รายละเอียดเกม และข้อมูลที่เกี่ยวข้องจากช่องทางอย่างเป็นทางการเพิ่มเติม</strong>
        เพื่อช่วยลดความเสี่ยงจากการเข้าใช้งานผ่านช่องทางที่ไม่ถูกต้อง หากไม่แน่ใจว่าช่องทางใดเป็นของเว็บไซต์จริง สามารถสอบถามเจ้าหน้าที่ก่อนได้ทุกครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ทางเข้า PKG44 และระบบบัญชีสมาชิก ใช้งานได้ทั้งมือถือและคอมพิวเตอร์" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#efe6d2]">
        ทางเข้า PKG44 ออกแบบให้<strong class="text-[#fff8e1]">เข้าถึงเกมสล็อตแต่ละค่ายได้สะดวกจากบัญชีเดียว</strong>
        เมนูแบ่งหมวดหมู่ไว้ชัดเจนและรองรับการใช้งานผ่านมือถือ จึงเปิดใช้งานต่อเนื่องได้แม้สลับอุปกรณ์ระหว่างวัน
      </p>

      <p class="text-left text-base leading-relaxed text-[#efe6d2]">
        ส่วนของบัญชีสมาชิกช่วยให้<strong class="text-[#fff8e1]">จัดการรายการต่าง ๆ ได้เป็นขั้นตอนมากขึ้น</strong>
        สมาชิกเห็นรายการของตัวเองได้จากที่เดียว ตรวจสอบสถานะของแต่ละรายการได้จากบัญชีนั้นโดยตรง และเลือกเกมที่สนใจต่อได้จากหน้าเดิม
      </p>
    </div>
  </ContentBox>

  <ContentBox title="โปรโมชั่น PKG44 แนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#efe6d2]">
        สมาชิก PKG44 <strong class="text-[#fff8e1]">ติดตามข่าวสาร เกมใหม่ และโปรโมชั่นที่เว็บไซต์อัปเดตตามช่วงเวลาได้จากหน้าเดียว</strong>
        โดยมีทั้งโบนัสแนะนำเพื่อน 0.8% สำหรับสมาชิกที่แนะนำเพื่อนเข้ามาสมัคร และโบนัสคืนยอดเสีย 0.3% ตามยอดและเงื่อนไขที่กำหนดไว้ในแต่ละรอบ
      </p>

      <p class="text-left text-base leading-relaxed text-[#efe6d2]">
        ระบบ<strong class="text-[#fff8e1]">แสดงยอดที่เข้าเกณฑ์ รอบรับสิทธิ์ และรอบคำนวณไว้ให้ตรวจสอบ</strong>
        สมาชิกจึงติดตามโบนัสของตัวเองในแต่ละรอบได้จากบัญชีสมาชิกโดยตรง และควรอ่านเงื่อนไขของรายการที่สนใจให้ครบก่อนกดรับทุกครั้ง เพราะรายละเอียดของแต่ละรายการแตกต่างกัน
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/promotion"
          aria-label="ดูภาพโปรโมชั่นทั้งหมดของ PKG44"
          class="flex items-center justify-center rounded-lg border border-[#fdd32a] bg-[#12100a] px-8 py-3 font-bold text-[#efe6d2] transition-all hover:scale-105 hover:border-[#ffe27a] hover:bg-[#2a2110] hover:text-[#fff8e1]">
          ดูโปรโมชั่นทั้งหมด
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="สมัครสมาชิก PKG44 ด้วยตัวเองใน 3 ขั้นตอน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#efe6d2]">
