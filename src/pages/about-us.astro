---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login, /register,
// /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx
// ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึง
// เขียนขึ้นใหม่บนข้อเท็จจริงของบรีฟรอบนี้เท่านั้น (src/assets/content.txt)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา 🏆) จึงเปิดใช้งานอยู่ และรอบนี้ operator สั่งให้
// คงไว้ ไม่ได้ park ลง src/pages-disabled/
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// ตัวที่ routing จริงคือไฟล์นี้ ตัวที่จอดไว้เป็นอินเวนทอรีของแบรนด์เก่า
// Astro ไม่อ่านโฟลเดอร์นั้นเลย ห้ามแก้และห้ามลบ
//
// ⚠️ ดรอปนี้ (2026-10-11) คือ **UFA324 เว็บเล่นเกมกีฬาออนไลน์** — ฟุตบอล มวย และ
// เกมคาสิโน (เกมไพ่ เกมโต๊ะ สล็อตจากค่ายต่างๆ) **ไม่ใช่เว็บสล็อตล้วน** แบบแบรนด์
// ก่อนหน้า และไม่ใช่เว็บลอตเตอรี (สองหน้าของหมวดลอตเตอรีจอดอยู่ใน src/pages-disabled/
// ไม่มี route ห้ามลิงก์ไปหา เป็น href ตายที่ทำให้ build แดง) หน้าเดิมทั้งหน้าพูดเรื่อง
// หมวดเกมสล็อต รอบโบนัส และขั้นตอนการสมัครเป็นจำนวนขั้น ซึ่งเป็นคำที่ brand-spec §7
// สั่งห้ามรอบนี้ จึงเขียนใหม่ทั้งหน้า ไม่ใช่ find-and-replace ทับประโยคเดิม
//
// แง่มุมที่บรีฟรอบนี้ระบุไว้มีเท่านี้ (ห้ามเติมอย่างอื่น): ทางเข้าเดิมพันหลายประเภท
// ในแพลตฟอร์มเดียว · ฟุตบอล (คู่แข่งขัน ประเภทการเดิมพัน อัตราต่อรอง) · มวย
// (รายการแข่งขันและรูปแบบการเดิมพันตามที่ผู้ให้บริการเปิด) · เกมคาสิโน (เกมไพ่
// เกมโต๊ะ สล็อตจากค่ายต่างๆ) · ค้นหาประเภทกีฬา ตรวจสอบรายละเอียดการแข่งขัน
// เลือกหมวดเกม · ใช้ผ่านมือถือหรือคอมพิวเตอร์ · เมนูจัดการบัญชีและติดตามรายการ ·
// กติกา อัตราจ่าย เงื่อนไขการตัดสินผล · คืนยอดเสีย 0.3% เข้ายูสทุกวัน ตามรอบคำนวณ
// และเวลาตัดรอบ · แนะนำเพื่อน โบนัส 0.8% จากยอดที่เข้าเกณฑ์ ผ่านลิงก์แนะนำ ·
// ฝากถอน (ช่องทางชำระเงิน สถานะรายการ ชื่อบัญชีผู้รับเงิน ระยะเวลาดำเนินการ) ·
// แอดมิน 24 ชั่วโมง · ช่องทางติดต่อหลัก · PIN/OTP
//
// ⚠️ คำที่ห้ามหลงเหลือ: ศัพท์หมวดสล็อตล้วนและคำขายของของแบรนด์ก่อนๆ ที่บรีฟรอบนี้
// ไม่ได้เอ่ย รวมถึงศัพท์หมวดลอตเตอรีทุกคำ — รายการเต็มอยู่ใน brand-spec §7 ไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาคำต้องห้ามเจอ false positive
// ⚠️ บรีฟรอบนี้ไม่มี "จำนวนขั้นตอนการสมัคร" เลย (ของแบรนด์ก่อน) จึงไม่เขียนส่วน
// ขั้นตอนสมัครขึ้นมาเอง — มีแค่ปุ่มไปหน้าสมัครสมาชิก
//
// ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 24 ชั่วโมง
// ห้ามเติมเลขใบอนุญาต หน่วยงานกำกับ ชื่อค่ายเกม ชื่อธนาคาร ชื่อลีก/ทีม/นักมวย
// ค่า RTP ยอดฝากถอนขั้นต่ำเป็นตัวเลข จำนวนสมาชิก หรือปีที่ก่อตั้ง
// เพราะบรีฟไม่ได้เอ่ยไว้สักอย่าง
//
// ประโยคกำกับที่บรีฟเขียนไว้เองและห้ามตัดทิ้งเพราะฟังดูไม่ขายของ — ขนมาครบทั้งเจ็ด:
// ควรมีข้อมูลผู้ให้บริการและระบบเกมที่สามารถตรวจสอบได้ (h1 ย่อหน้า 3) ·
// อัตราต่อรองอาจเปลี่ยนแปลงตามช่วงเวลา (h2 #1 ย่อหน้าท้าย) · ไม่มีการเดิมพัน
// ประเภทใดรับประกันผลตอบแทน จึงควรกำหนดวงเงินและพิจารณาความเสี่ยง (h2 #1
// ย่อหน้าท้าย) · ควรตรวจสอบว่าโปรโมชั่นครอบคลุมเฉพาะสล็อตหรือรวมกีฬาและคาสิโน
// ด้วย (h2 #2 ย่อหน้าท้าย) · คำว่าไม่จำกัดควรระบุให้ชัด (h2 #2 รายการที่สอง) ·
// จ่ายตรง ไม่บิดยูส ไม่มีขั้นต่ำ ไม่ผ่านบัญชีม้า ควรมีข้อมูลที่ตรวจสอบได้รองรับ
// (h2 #3 ย่อหน้า 2) · ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP (h2 #3 ย่อหน้า 3)
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ทองแชมเปี้ยน นำ เงินโครเมียม รอง บนพื้นดำ
// สนิท #000000** พลิกทิศจากคู่ "ชมพูฮ็อต-ทอง บนพื้นพลัม" ของแบรนด์ก่อน
// ซึ่งออกครบทุกจุดแล้วทั้งคลาส Tailwind raw hex และ rgba() (ค่าเดิมอยู่ใน
// brand-spec §2 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive)
// รอบนี้ไม่มีชมพูเป็นฮิวเลย และเพราะพื้นเพจเป็นดำสนิท จึง **ไม่มีชั้นที่ลึกกว่า
// พื้นเพจ** ได้อีก ทุกผิวต้องสว่างขึ้นจาก #000000 เท่านั้น
//
// ลำดับปุ่มสื่อด้วย "ทองถม vs ผิวจมขอบทอง/ขอบเงิน" — คู่พื้น-หมึกคำนวณไว้แล้ว:
// · ปุ่มหลัก (สมัครสมาชิก) ถมทองไล่ #ffe08a → #e5a81b → #bb8410 ขอบ #7d5a07
//   หมึกเข้ม #140d01 (16:1 บน #ffe08a · 9.8:1 บน #e5a81b · 6.3:1 บน #bb8410)
//   ⚠️ ไล่เฉดต้องหยุดที่ #bb8410 ห้ามไล่ลงไปถึง #7d5a07 ใต้ตัวอักษร
//   (#140d01 บน #7d5a07 = 3.3:1 ตก AA) — #7d5a07 อยู่ได้เฉพาะเป็นเส้นขอบ
// · ปุ่มลิงก์ภายในเป็นชั้นจม #17130a → #0d0b06 ขอบทอง #e5a81b/50 ตัวอักษรทอง
//   #e5a81b (8.2:1 บน #17130a)
// · ปุ่มรอง (เข้าสู่ระบบ) ชั้นจมเดียวกัน แต่ขอบเงิน #b9c2cc/55 ตัวอักษรเนื้อความ
//   #f0e8d4 — ต่างแกนจากปุ่มลิงก์ภายในด้วยฮิวที่สองของโลโก้ (เลข 324 เงินโครเมียม)
// · #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้
// ⚠️ #7d5a07 · #43300a · #464f5a ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่เส้นขอบ ออรา
// และเงา — ออราในไฟล์นี้ใช้ rgba(229,168,27,α) เท่านั้น นอกจากเงาดำล้วน
// ⚠️ "ทอง" ไม่ใช่ตัวบอกว่าถูกแบรนด์: เจ็ดในสิบแบรนด์หลังสุดมีทอง และทองรอบนี้
// #e5a81b ต่างจากทองของแบรนด์ก่อนๆ แค่ไม่กี่ตัวอักษรทุกคู่ ให้เทียบเป็น "ค่า" กับ
// ตารางแบนใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep เจอ false positive
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #f0e8d4,
// 13.9:1 บนผิวยก #231c0e) ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง
// ปล่อยให้สืบทอดลงมา และไม่ใส่ mx-auto / max-w-* บน <p> เพราะการ์ดคุมความกว้างเองแล้ว
// — ที่ประกาศสีได้มีแค่ปุ่ม (ถมพื้นของตัวเองจึงต้องกำหนดหมึกของตัวเอง) และ <strong>
// ซึ่ง brand-spec §2 กำหนดให้ใช้ทองไฮไลต์ #ffcf5e (11.6:1 บนผิวการ์ด) เป็นสี
// ไฮไลต์ในเนื้อความโดยเฉพาะ · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง
// เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง
// (ลบแท็ก <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิมเป๊ะ)
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้าง
// จากหน้า และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น Announcement2 ทั้งเว็บ (ตัวที่แบรนด์ก่อนใช้ถูกหมุนออกตาม
// brand-spec §3) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้
// ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูด
// คนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 158
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} เว็บเล่นเกมกีฬาออนไลน์ รวมทางเข้าเดิมพันฟุตบอล มวย เกมคาสิโนไว้ในแพลตฟอร์มเดียว พร้อมคืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% และแอดมิน 24 ชั่วโมง`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} เว็บเล่นเกมกีฬาออนไลน์ ทางเข้าเดิมพันครบวงจร`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#ffcf5e]">{BRAND_NAME} เป็นเว็บเล่นเกมกีฬาออนไลน์ที่รวมทางเข้าเดิมพันหลายประเภทไว้ในแพลตฟอร์มเดียว</strong>
        ทั้งฟุตบอล มวย และเกมคาสิโน ผู้ใช้งานค้นหาประเภทกีฬา ตรวจสอบรายละเอียดการแข่งขัน และเลือกหมวดเกมที่สนใจได้สะดวกผ่านมือถือหรือคอมพิวเตอร์ พร้อมเมนูจัดการบัญชีและติดตามรายการต่างๆ จากบัญชีเดียว
      </p>

      <p>
        หน้านี้สรุปไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่หมวดเดิมพันกีฬาและเกมคาสิโนที่จัดไว้
        <strong class="text-[#ffcf5e]">ไปจนถึงรายการโปรโมชั่นที่ตรวจสอบเงื่อนไขได้ ระบบฝากถอน และช่องทางติดต่อแอดมินที่ระบุเวลาให้บริการตลอด 24 ชั่วโมง</strong>
        เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดดูอะไรตรงไหน แล้วจึงค่อยลงรายละเอียดของรายการที่สนใจเป็นรายรายการ
      </p>

      <p>
        <strong class="text-[#ffcf5e]">ส่วนการระบุว่าเป็นฐานเกมแท้ ควรมีข้อมูลผู้ให้บริการและระบบเกมที่สามารถตรวจสอบได้ เพื่อประกอบการพิจารณาก่อนใช้งาน</strong>
        ข้อมูลในหน้านี้จึงเขียนไว้เพื่อบอกว่าระบบมีอะไรให้ใช้และควรตรวจอะไรก่อนตัดสินใจ ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้งาน ซึ่งเป็นค่าที่ควรยึดเป็นหลักเสมอ
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`หมวดเดิมพันที่ ${BRAND_NAME} รวมไว้ในระบบเดียว`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        ทางเข้า {BRAND_NAME} รวบรวมหมวดเดิมพันกีฬาและเกมคาสิโนไว้ในระบบเดียว ค้นหาตามประเภทกีฬาหรือเลือกจากหมวดเกมก็ได้
        <strong class="text-[#ffcf5e]">ระบบจัดเมนูให้ตรวจสอบรายละเอียดการแข่งขัน ข้อมูลบัญชี และรายการที่ทำไว้ได้จากที่เดียว</strong>
