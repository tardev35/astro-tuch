---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion,
// /login, /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์
// หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา
// ทั้งหน้าจึงเขียนขึ้นใหม่บนข้อเท็จจริงของ UOK365 เท่านั้น (src/assets/content.txt)
//
// ⚠️ บรีฟของดรอปนี้พิมพ์ชื่อแบรนด์รอบก่อนไว้ทุกย่อหน้า แต่อาร์ตเวิร์กทั้งชุด
// (โลโก้ แบนเนอร์ สไลด์ og) และคำสั่งของ operator เป็น UOK365 ตรงกัน จึงยึด
// "โครงเรื่อง + ย่อหน้า + ตัวเลข" ของบรีฟไว้ แล้วแทนชื่อเป็น UOK365 ทุกจุด
// (brand-spec §1) ในโค้ดจึงไม่พิมพ์ชื่อแบรนด์ตรงๆ เลย แต่ interpolate BRAND_NAME
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก NavbarPremium (เกี่ยวกับเรา) จึงเปิดใช้งานอยู่
//
// มีสำเนาของไฟล์นี้จอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย — ตัวที่
// routing จริงคือไฟล์นี้ ตัวที่จอดไว้เป็นอินเวนทอรี ห้ามแก้และห้ามลบ
//
// ดรอปนี้ (2026-10-07) คือ UOK365 **เว็บสล็อตเบทต่ำ** ไม่ใช่เว็บหวย แง่มุมที่บรีฟ
// ระบุไว้มีเท่านี้: รวมเกมหลายรูปแบบไว้ในระบบเดียว · เหมาะกับสายสล็อตที่เริ่มจาก
// ยอดเดิมพันไม่สูง · เกมคลาสสิก ฟรีสปิน โบนัส ตัวคูณ สล็อตเปิดใหม่ · เข้าเล่นผ่าน
// มือถือได้สะดวก · เลือกเกมตามช่วงเดิมพัน · เบทต่ำ ทุนน้อย แบ่งงบเล่นเป็นรอบ ·
// ตรวจสอบตารางจ่าย ฟีเจอร์โบนัส ฟรีสปิน ก่อนเริ่ม · Login ตรวจโปรโมชั่น ยอดคำนวณ
// และสถานะการรับสิทธิ์ · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · สมัคร 3 ขั้นตอน ·
// บัญชีเดียวดูเครดิต โปรโมชั่น ประวัติรายการ · แอดมิน 24 ชั่วโมง · PIN รหัสผ่าน OTP
//
// ⚠️ คำที่ห้ามหลงเหลือ (brand-spec §4): คำหมวดหวยทั้งชุด (หวย โพย เลขเด็ด
// แนวทาง งวด อัตราจ่าย ตรวจหวย) เพราะเป็นของอินเวนทอรี *Huay ที่จอดไว้ ไม่ใช่
// ของแบรนด์นี้ · รวมถึงคำขายของที่บรีฟไม่ได้เอ่ย เช่น ไฮคลาส VIP ส่งตรงจากเว็บแม่
// ยอดเข้าบริษัทตรง ไม่ผ่านบัญชีม้า ค่ายเกมพรีเมียม
// ลิงก์หน้าหวยทั้งสองไม่มีปลายทางรอบนี้ (จอดอยู่ใน src/pages-disabled/)
//
// ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 100% · 24 ชั่วโมง · 3 ขั้นตอน
// ห้ามเติมเลขใบอนุญาต หน่วยงานกำกับ ชื่อผู้ให้บริการ ชื่อค่ายเกม ชื่อธนาคาร
// ค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีที่ก่อตั้ง เพราะบรีฟไม่ได้เอ่ยไว้สักอย่าง
//
// ประโยคกำกับที่บรีฟเขียนไว้เองและห้ามตัดทิ้งเพราะฟังดูไม่ขายของ: การระบุว่าเป็น
// เกมค่ายตรงและถูกลิขสิทธิ์ ควรมีรายชื่อผู้ให้บริการหรือข้อมูลสิทธิ์การให้บริการที่
// ตรวจสอบได้ประกอบ · "ไม่มีขั้นต่ำ" ควรอ้างอิงจากเกมที่เปิดให้บริการจริง ·
// "โบนัสสูง ให้เยอะกว่าใคร" ควรมีข้อมูลเปรียบเทียบรองรับ · "เล่นสล็อตไม่จำกัดยอด"
// ควรอ้างอิงวงเงินขั้นต่ำและสูงสุดของแต่ละเกม
//
// พาเลตต์ UOK365 (brand-spec §2) **ทองเมทัลลิก + เงินโครเมียม บนน้ำตาลเกือบดำ**
// — พลิกฮิวจากเขียวนีออนของรอบก่อน ชุดเขียว/เขียวดำของรอบนั้นออกครบทุกจุดแล้ว
// ทั้งคลาส Tailwind raw hex และ rgba() (ค่าเดิมอยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำ
// ที่นี่ เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive)
// ปุ่มหลักเป็นทองไล่ #f5d98a → #c8912f → #6d4412 บนหมึกเข้ม #191005 (ทองถมพื้น
// ต้องใช้หมึกเข้มเสมอ — หมึกสว่างบนทองเหลือคอนทราสต์ ~2.6:1)
// ปุ่มรองเป็นผิวการ์ด #191108 → #070504 ขอบทองแบรนด์ #c8912f/60 ตัวอักษรทองอ่อน
// #f5d98a · ขอบรูปใช้ #c8912f/30 เท่ากับที่ ContentBox ใช้กับการ์ด
// #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT) ไว้ที่
// ตัวการ์ดแล้ว ข้อความในหน้านี้จึงไม่ประกาศสีของตัวเองเลย ปล่อยให้สืบทอดลงมา
// — มีแค่ปุ่มที่ประกาศสีได้ เพราะปุ่มถมพื้นของตัวเองจึงต้องกำหนดหมึกของตัวเอง
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจาก
// หน้า และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น AnnouncementPremium ทั้งเว็บ (รอบก่อนใช้ตัว *Cyber
// — brand-spec §3 หมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้
// ของ UOK365 ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูด
// คนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 151 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} เว็บสล็อตเบทต่ำที่รวมเกมค่ายตรงถูกลิขสิทธิ์ไว้ในบัญชีเดียว ทั้งเกมคลาสสิก ฟรีสปิน โบนัส ตัวคูณ สล็อตเปิดใหม่ โปรโมชั่น และการฝากถอน`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} เว็บสล็อตเบทต่ำ รวมเกมค่ายตรง ถูกลิขสิทธิ์`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong>{BRAND_NAME} คือเว็บสล็อตเบทต่ำที่รวบรวมเกมหลายรูปแบบไว้ในระบบเดียว</strong>
        เหมาะกับสายสล็อตที่ต้องการเริ่มจากยอดเดิมพันไม่สูง มีทั้งเกมคลาสสิก ฟรีสปิน โบนัส ตัวคูณ และสล็อตเปิดใหม่จากค่ายที่ระบบรองรับ เข้าเล่นผ่านมือถือได้สะดวก พร้อมเลือกเกมตามช่วงเดิมพันที่ต้องการ
      </p>

      <p>
        หน้านี้สรุปไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่การเลือกค่ายและค้นหาเกมสล็อต
        <strong>ไปจนถึงโปรโมชั่นคืนยอดเสียกับแนะนำเพื่อน การสมัครใน 3 ขั้นตอน และการติดต่อแอดมินที่ดูแลตลอด 24 ชั่วโมง</strong>
        เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดดูอะไรตรงไหน แล้วจึงค่อยลงรายละเอียดของเกมหรือแคมเปญที่สนใจเป็นรายรายการ
      </p>

      <p>
        สิ่งที่ควรอ่านไปพร้อมกันคือข้อจำกัดของข้อความประชาสัมพันธ์
        <strong>การระบุว่าเป็นเกมค่ายตรงและถูกลิขสิทธิ์ ควรมีรายชื่อผู้ให้บริการหรือข้อมูลสิทธิ์การให้บริการที่สามารถตรวจสอบได้ประกอบ</strong>
        ข้อมูลในหน้านี้จึงเขียนไว้เพื่อบอกว่าระบบมีอะไรให้ใช้และควรตรวจอะไรก่อนตัดสินใจ ไม่ได้ใช้แทนการอ่านเงื่อนไขและรายละเอียดที่เว็บไซต์แสดงอยู่ตรงหน้า
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`${BRAND_NAME} รวมเกมค่ายตรงไว้ในบัญชีเดียว เลือกเกมตามช่วงเดิมพันได้`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        เว็บ {BRAND_NAME} มีเกมเบทต่ำให้เลือกหลายแบบ
        <strong>เหมาะกับผู้ที่มีทุนน้อยและต้องการแบ่งงบเล่นเป็นรอบ โดยเลือกเกมจากยอดเดิมพันขั้นต่ำที่ระบบกำหนด</strong>
        เกมแต่ละตัวไม่ได้ทำงานเหมือนกันทั้งหมด จึงควรเปิดดูรายละเอียดก่อนเริ่มเล่น เพื่อเลือกประเภทที่ตรงกับงบและความสนใจได้ง่ายขึ้น สิ่งที่ต่างกันในแต่ละเกมแบ่งออกได้ประมาณนี้
      </p>

      <ul class="flex flex-col gap-3" aria-label={`สิ่งที่แตกต่างกันในเกมสล็อตแต่ละตัวบนเว็บ ${BRAND_NAME}`}>
        <li class="flex gap-3">
          <span aria-hidden="true">🎰</span>
          <span>
            <strong>รูปแบบวงล้อ</strong> เป็นโครงของเกมที่ทำให้สล็อตคลาสสิกกับเกมเปิดใหม่เล่นไม่เหมือนกัน การเปิดดูรูปแบบวงล้อก่อนจึงช่วยให้รู้ว่าเกมนั้นเป็นแนวที่กำลังมองหาหรือไม่ ก่อนจะลงเครดิตจริง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">✨</span>
          <span>
            <strong>ตารางจ่าย ฟีเจอร์โบนัส ฟรีสปิน และตัวคูณ</strong> มีไม่เท่ากันในแต่ละเกม บางเกมมีครบ บางเกมมีเพียงบางอย่าง จึงควรอ่านรายละเอียดของเกมนั้นโดยตรง มากกว่าจะเทียบจากเกมอื่นที่เคยเล่นมาก่อน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">💠</span>
          <span>
            <strong>ช่วงเดิมพันของแต่ละเกม</strong> เป็นตัวบอกว่าเกมนั้นเหมาะกับงบที่ตั้งไว้หรือไม่ ควรตรวจสอบก่อนเริ่มเล่นทุกครั้ง เพราะค่ายและเกมที่ต่างกันไม่จำเป็นต้องเปิดช่วงเดิมพันชุดเดียวกัน
          </span>
        </li>
      </ul>

      <p>
        <strong>คำว่าไม่มีขั้นต่ำ ควรอ้างอิงจากเกมที่เปิดให้บริการจริง</strong>
        เนื่องจากเกมสล็อตแต่ละค่ายกำหนดยอดเดิมพันต่ำสุดไม่เท่ากัน บางเกมอาจเริ่มด้วยยอดต่ำมาก ขณะที่บางเกมใช้ขั้นต่ำสูงกว่า จึงควรยึดตัวเลขที่แสดงภายในเกมเป็นหลักและกำหนดงบก่อนเล่นทุกครั้ง
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/ทดลองเล่น"
          aria-label={`เปิดหน้าทดลองเล่นของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#c8912f]/60 bg-gradient-to-b from-[#191108] to-[#070504] px-8 py-3 font-bold text-[#f5d98a] shadow-[0_0_12px_rgba(200,145,47,0.25)] transition-all hover:scale-105 hover:border-[#c8912f] hover:shadow-[0_0_18px_rgba(245,217,138,0.40)]">
          ไปหน้าทดลองเล่น
        </a>

        <a
          href="/promotion"
          aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#c8912f]/60 bg-gradient-to-b from-[#191108] to-[#070504] px-8 py-3 font-bold text-[#f5d98a] shadow-[0_0_12px_rgba(200,145,47,0.25)] transition-all hover:scale-105 hover:border-[#c8912f] hover:shadow-[0_0_18px_rgba(245,217,138,0.40)]">
          ดูภาพโปรโมชั่น
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`โปรโมชั่นของ ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        โปรโมชั่นเล่นสล็อต {BRAND_NAME} มีสิทธิ์ให้สมาชิกเลือกตามแคมเปญที่เปิดในแต่ละช่วง
        <strong>สามารถ Login เพื่อตรวจสอบโปรโมชั่น ยอดคำนวณ และสถานะการรับสิทธิ์จากบัญชีได้โดยตรง</strong>
        โดยกิจกรรมที่เว็บไซต์ระบุไว้มีสองรายการหลัก ซึ่งคำนวณจากยอดคนละชุดกันและอาจมีรอบตัดยอดกับค่ายเกมที่ร่วมรายการต่างกัน
      </p>

      <ul class="flex flex-col gap-3" aria-label={`กิจกรรมโบนัสของ ${BRAND_NAME}`}>
        <li class="flex gap-3">
          <span aria-hidden="true">💸</span>
          <span>
