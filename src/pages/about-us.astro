---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login,
// /register, /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจาก
// เช็กลิสต์หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ (src/assets/content.txt)
// ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึงเขียนจากข้อเท็จจริงและคลังคำของ
// บรีฟรอบนี้เท่านั้น (.claude/brand-spec-sabai168.md §5)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x4 · h3x0
//   h1  เกี่ยวกับเรา <แบรนด์> เว็บเกมสล็อตออนไลน์เบทต่ำ ทุนน้อยก็เล่นได้
//   h2  เกมสล็อตออนไลน์ที่ <แบรนด์> รวบรวมไว้ให้ศึกษาก่อนใช้งาน
//   h2  โปรโมชั่นของ <แบรนด์> คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%
//   h2  ขั้นตอนสมัครสมาชิกและเข้าสู่ระบบของ <แบรนด์>
//   h2  ช่องทางติดต่อแอดมิน <แบรนด์> ตลอด 24ชม.
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// (ขั้นตอนสมัครสามขั้นของบรีฟลงเป็น <ol> ไม่ใช่สาม h3 เพราะเป็นลำดับขั้น ไม่ใช่
// สามหัวข้อย่อยที่มีบทความของตัวเอง)
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) จึงเปิดใช้งานอยู่
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// เป็นของแบรนด์ JEDI66 เก่ามาก ตัวที่ routing จริงคือไฟล์นี้ Astro ไม่อ่านโฟลเดอร์
// นั้นเลย **ห้ามแก้ ห้ามลบ และห้ามสลับมาแทนไฟล์นี้**
//
// 🚨 แกนของดรอปนี้ (2026-10-22) คือ **เว็บเกมสล็อตออนไลน์เบทต่ำ** — "สล็อตเบทต่ำ
// สบายเป๋า ทุนน้อย เล่นง่าย ยอดเข้าบริษัทโดยตรง" พร้อมโปรโมชั่นคืนยอดเสีย 0.3% ·
// แนะนำเพื่อน 0.8% · ขั้นตอนสมัคร 3 ขั้น · แอดมิน 24ชม.
// ⚠️⚠️ **แบรนด์ขาออกรอบนี้เป็นเว็บพนันครบวงจร** (กีฬา + เกมไพ่ + สล็อต) คำสโลแกน
// กลุ่มนั้นที่เจอในไฟล์นี้จึงเป็นคำค้างของแบรนด์ขาออก **ไม่ใช่ของรอบนี้**
// และรอบก่อนหน้านั้นเป็นสล็อตล้วนอีกเจ้าหนึ่งกับเว็บลอตเตอรี — คำกลุ่มนั้นก็ห้าม
// หลงเหลือเช่นกัน **รายการคำต้องห้ามเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่**
// เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
//
// ⚠️⚠️ **สองหน้าหมวดลอตเตอรียังจอดอยู่ใน src/pages-disabled/ รอบนี้** → ลิงก์ไป
// สอง route นั้นจะทำให้ build แดง ห้ามเขียนกลับมา
// route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ทดลองเล่น · /about-us · /contact-us · /terms · /privacy · /line
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกม ชื่อธนาคาร ชื่อวอลเล็ต ผู้ให้บริการ
// ใบอนุญาต นิติบุคคลรายใด ปีก่อตั้ง จำนวนสมาชิก ค่า RTP หรือยอดฝากขั้นต่ำ แม้แต่
// รายการเดียว** จึงห้ามเขียนลงหน้าเว็บ · ตัวเลขที่ขึ้นหน้าได้มีแค่ของบรีฟเอง:
// **0.3% · 0.8% · 24ชม. · 3 ขั้นตอน**
//
// คลังคำที่บรีฟรอบนี้ให้มาและใช้ได้เท่านี้: สล็อต · สล็อตออนไลน์ · เบทต่ำ ·
// สบายเป๋า · ทุนน้อย · เล่นง่าย · ยอดเข้าบริษัทโดยตรง · เกมเดิมพันออนไลน์ ·
// ค่ายแท้ · ค่ายต่าง ๆ · เกมสล็อตคลาสสิก · ฟีเจอร์โบนัส · ปรับระดับการเดิมพัน ·
// ยอดเดิมพันขั้นต่ำ · งบประมาณ · ข้อกำหนดการฝากเงิน · สถานะลิขสิทธิ์ ·
// ความเสี่ยงต่อการสูญเสียเงิน · โปรโมชั่น · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% ·
// กดรับได้ไม่จำกัด · เครดิต · ยอดเสีย · รอบสรุปยอด · ลิงก์แนะนำ · เชื่อมโยงบัญชี ·
// สมัครสมาชิก · เข้าสู่ระบบ · ยืนยันบัญชี · คุณสมบัติ · อายุที่กฎหมายอนุญาต ·
// รหัสผ่าน · รหัส OTP · ข้อมูลส่วนบุคคล · แอดมิน · เจ้าหน้าที่ · 24ชม. ·
// เว็บไซต์ทางการ · ประกาศล่าสุด · บัญชีแอบอ้าง · ฝากถอน · หมายเลขรายการ ·
// หลักฐาน · นิติบุคคล · บัญชีรับเงิน
//
// 🚨 **บรีฟรอบนี้โฆษณาและกำกับข้อควรระวังในย่อหน้าเดียวกัน** — ทั้งสองครึ่งต้อง
// ship ครบตามที่เขียน ประโยคกำกับไม่ใช่ filler ให้ตัดทิ้ง:
// 1) คำกล่าวอ้างว่ายอดเงินเข้าบริษัทโดยตรงควรยืนยันจากข้อมูลนิติบุคคลและบัญชี
//    รับเงินที่ตรวจสอบได้ เพื่อหลีกเลี่ยงความเสี่ยงจากบัญชีแอบอ้าง (h1)
// 2) ควรตรวจสอบสถานะลิขสิทธิ์ของเกมจากหลักฐานทางการ และตระหนักว่าแม้เดิมพันด้วย
//    เงินจำนวนน้อยก็ยังมีความเสี่ยงต่อการสูญเสียเงิน (h2 #1)
// 3) เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือ
//    รับประกันผลกำไรในอนาคต · แม้ระบุว่ากดรับได้ไม่จำกัด แต่ควรตรวจสอบจำนวนครั้ง
//    ที่รับสิทธิ์ได้จริงจากประกาศล่าสุด (h2 #2)
// 4) ไม่ควรใช้ข้อมูลของบุคคลอื่นหรือเปิดเผยรหัส OTP ให้ใครทราบ · ควรตรวจสอบ
//    คุณสมบัติและอายุที่กฎหมายอนุญาตก่อนดำเนินการ (h2 #3)
// 5) ควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยง
//    บัญชีแอบอ้าง · หากพบปัญหาเกี่ยวกับธุรกรรม ควรเตรียมหมายเลขรายการและหลักฐาน
//    ที่เกี่ยวข้อง · ควรตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุดอีกครั้ง (h2 #4)
// ⚠️ บรีฟไม่ได้การันตีผลลัพธ์ใดๆ — คอปปี้หน้านี้จึงไม่สัญญากำไรและไม่สัญญาว่า
// ถอนได้ชัวร์
//
// 🚨 พาเลตรอบนี้ (brand-spec §2) **กลับมาเป็นธีมสว่าง** หลังรอบก่อนเป็นดำสนิท
// bg.json ของดรอปนี้คือ {"mode":"color","color":"#ccf7ff"} = ฟ้าพาสเทลสว่าง
// **ห้าม "แก้" กลับไปเป็นพื้นมืดเพราะรอบที่แล้วมืด**
// ค่าที่ใช้ได้ในไฟล์นี้: ทองลึก #8a6504 (<strong>/marker — 5.0:1 บนการ์ดขาว
// และเป็น **สีไฮไลต์เพียงค่าเดียว** ของเนื้อความ) · หมึกน้ำเงิน #0f3a4a
// (เนื้อความ = BRAND_TEXT, 12.2:1) · น้ำเงินหมึก #063a57 (หัวข้อ/ตัวอักษรบน
// อินเซ็ต, 7.5:1) · ฟ้าลึก #0a7fbd (stop ปลายของปุ่ม/ขอบหนัก) · ฟ้าสกาย #2cc3fc
// และฟ้าน้ำแข็ง #6bdcfb (stop ของปุ่ม/ขอบ/ออรา) · ขอบฟ้าอ่อน #9ae0fa ·
// ทองคานารี #fdcb0c + ทองซีด #fefb6b (พื้นถมปุ่มรอง) · หมึก #06293c (บนพื้นถมฟ้า)
// · หมึก #2a1f02 (บนพื้นถมทอง) · อินเซ็ต #dff4fd / ชั้นกลาง #f2fbff /
// ผิวการ์ด #ffffff / พื้นเพจ #ccf7ff
// 🚨 **#2cc3fc #6bdcfb #9ae0fa #fdcb0c #fefb6b ห้ามถือตัวอักษรบนพื้นสว่าง**
// (1.5–2.4:1) เป็นขอบ/ออรา/พื้นถมเท่านั้น
// 🚨 **#ffffff #f2fbff #dff4fd #ccf7ff ห้ามถือตัวอักษร** เป็นสีผิวเท่านั้น
// 🚨 สีไฮไลต์ <strong> ในเนื้อความมีตัวเดียวคือ **ทองลึก #8a6504**
// 🚨 **ห้ามสลับเป็นตัวอักษรขาวบนพื้นถมฟ้า/ทอง** — ปุ่มฟ้าใช้หมึก #06293c เสมอ
// และปุ่มทองใช้หมึก #2a1f02 เสมอ
// ออราที่อนุญาต: rgba(44,195,252,α) · rgba(253,203,12,α) · rgba(107,220,251,α) ·
// rgba(6,58,87,α) · rgba(0,0,0,α)
// ⚠️ รอบนี้ไม่มีแดง ไม่มีเขียว (ยกเว้น LINE green) ไม่มีชมพู ไม่มีม่วง ไม่มีส้ม
// ไม่มีโรสโกลด์ ไม่มีทองแดงไหม้ ไม่มีเงิน/โครเมียม (ซึ่งเป็นสีที่สองของรอบก่อน) ·
// #00B900 บนปุ่ม LINE เป็นสีประจำแพลตฟอร์ม ไม่ใช่สีของเว็บ ห้ามเปลี่ยนเป็นสีแบรนด์
// ⚠️ **ฟ้าและทองผ่านรีโปนี้มาแล้วหลายเจ้า และชื่อก็เกือบซ้ำ (สบายเบท168 เป็นคนละ
// ลูกค้าและเคยเดินฟ้า+ทองเหมือนกัน)** การเจอฟ้าหรือทองในไฟล์จึงไม่พิสูจน์อะไร —
// **ห้ามเทียบด้วยวงศ์สี ต้องเทียบทีละค่า** กับตาราง brand-spec §2 สิ่งที่แยก
// รอบนี้คือ ฟ้าสกาย #2cc3fc นำ + ทองคานารี #fdcb0c รอง **บนธีมสว่าง**
//
// ลำดับปุ่มในไฟล์นี้สื่อด้วยพื้นถมสามขั้ว:
// · ปุ่มหลัก (สมัครสมาชิก) ถมไล่เฉดฟ้า #6bdcfb -> #2cc3fc -> #0a7fbd หมึก #06293c
// · ปุ่มรอง (เข้าสู่ระบบ) ถมไล่เฉดทอง #fefb6b -> #fdcb0c หมึก #2a1f02
// · ปุ่มลิงก์ภายในเป็นอินเซ็ต #dff4fd ขอบฟ้าอ่อน ตัวอักษรน้ำเงินหมึก #063a57
//   hover ยกขอบเป็นฟ้าสกายทึบ (ตรงกับ hover ของการ์ด ContentBox)
// · ชิปไอคอนของรายการใช้ฟ้าสกายเป็น **เส้นขอบ** บนอินเซ็ต #dff4fd ไม่ถือตัวอักษร
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT
// #0f3a4a, 12.2:1 บนผิวการ์ด) ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่ประกาศสี
// ของตัวเอง ปล่อยให้สืบทอดลงมา และไม่ใส่ mx-auto / max-w-* บน <p> เพราะการ์ดคุม
// ความกว้างเองแล้ว (เพิ่มไปจะเหมือนย่อหน้าเยื้อง) — ที่ประกาศสีได้มีแค่ปุ่ม
// (ถมพื้นของตัวเองจึงต้องกำหนดหมึกของตัวเอง) ชิปไอคอน marker ของลำดับเลข และ
// <strong> ซึ่ง brand-spec §2 สงวนทองลึก #8a6504 ไว้เป็นสีไฮไลต์ในเนื้อความ
// เพียงสีเดียว · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะ
// ภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะ
// ขาดครึ่ง (ลบแท็ก <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิม) และห้ามวาง
// <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังใน prop ที่เป็นข้อความ และต้องไม่ใช่สัญลักษณ์ของอาร์ตเวิร์กแบรนด์เก่า
// (รายการที่ห้ามอยู่ใน brand-spec §1)
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: ดรอปนี้ไม่มี article illustration เลย
// (banner2/banner3 เป็นอาร์ตเวิร์กของแบรนด์คนละราย เก่าทั้งคู่) ส่วน
// slide1/slide2 ถูกตรึงไว้กับ index กับ /promotion และ banner1 /
// banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// slide3/slide4 เป็นโปสเตอร์ของอีกแบรนด์ ห้าม import (ลำพังการ import ก็ทำให้
// ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง) — ไฟล์ยังอยู่บนดิสก์ ห้ามลบ
//
// Announcement รอบนี้หมุนมาเป็น Announcement6 ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ Announcement3 จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์
// นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว จึงเรียกแบบ bare **ห้ามส่ง prop message**
// มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 152 อักขระ (ชื่อแบรนด์รอบนี้ 7 ตัวอักษร) เป็นประโยคเดียวที่บอกว่า
// หน้านี้มีอะไร แล้วหยุด
// (Google ตัดราว 155 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} หน้ารวบรวมข้อมูลเกมสล็อตออนไลน์เบทต่ำที่เว็บไซต์ระบุไว้ ทั้งโปรโมชั่นสมาชิก ขั้นตอนสมัครสมาชิก และช่องทางติดต่อเจ้าหน้าที่ตลอด 24ชม.`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} เว็บเกมสล็อตออนไลน์เบทต่ำ ทุนน้อยก็เล่นได้`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#8a6504]">{BRAND_NAME} นำเสนอเกมสล็อตออนไลน์ที่มีรูปแบบการเดิมพันหลากหลาย รวมถึงเกมที่กำหนดเงินเดิมพันเริ่มต้นในระดับต่ำ</strong>
        จึงเหมาะกับผู้ที่ต้องการศึกษารูปแบบเกมและจัดการงบประมาณของตนเอง หน้านี้รวบรวมไว้ว่าเว็บไซต์ระบุอะไรไว้บ้าง เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดอ่านอะไรตรงไหน แล้วจึงค่อยไล่อ่านรายละเอียดของแต่ละหัวข้อเป็นรายข้อ
      </p>

      <p>
        สิ่งที่หน้านี้ทำได้คือชี้ว่าข้อมูลแต่ละชุดอยู่ตรงไหนและควรอ่านอะไรก่อน ภายในเว็บไซต์มีข้อมูลเกี่ยวกับการสมัครสมาชิก โปรโมชั่น และช่องทางฝากถอนให้ตรวจสอบก่อนใช้งาน
        <strong class="text-[#8a6504]">ส่วนคำกล่าวอ้างว่ายอดเงินเข้าบริษัทโดยตรงควรยืนยันจากข้อมูลนิติบุคคลและบัญชีรับเงินที่ตรวจสอบได้</strong>
        เพื่อหลีกเลี่ยงความเสี่ยงจากบัญชีแอบอ้าง
      </p>

      <p>
        เนื้อหาในหน้านี้เขียนไว้ประกอบการใช้งานเท่านั้น ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้บริการ
        <strong class="text-[#8a6504]">และควรตรวจสอบรายละเอียดล่าสุดจากเว็บไซต์ทางการทุกครั้งก่อนทำรายการ</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`เกมสล็อตออนไลน์ที่ ${BRAND_NAME} รวบรวมไว้ให้ศึกษาก่อนใช้งาน`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        {BRAND_NAME} รวบรวมข้อมูลเกมสล็อตออนไลน์จากค่ายต่าง ๆ ไว้ในเว็บไซต์เดียว
        <strong class="text-[#8a6504]">โดยมีเกมหลายรูปแบบให้ศึกษาทั้งเกมสล็อตคลาสสิก เกมที่มีฟีเจอร์โบนัส และเกมที่สามารถปรับระดับการเดิมพันได้</strong>
        รายการด้านล่างคือชุดข้อมูลที่ควรไล่อ่านให้ครบก่อนเลือกใช้งาน เพราะแต่ละเกมวางเงื่อนไขของตัวเองไว้ไม่เหมือนกัน
      </p>

      <ul class="flex flex-col gap-4" aria-label="รูปแบบเกมสล็อตและข้อมูลที่เว็บไซต์ระบุไว้ให้ศึกษา">
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#2cc3fc]/60 bg-[#dff4fd] text-sm">✨</span>
          <span>
            <strong class="text-[#8a6504]">เกมสล็อตคลาสสิก</strong> เป็นรูปแบบพื้นฐานที่กติกาตรงไปตรงมา เหมาะกับการทำความเข้าใจวิธีนับผลก่อนขยับไปเกมที่ซับซ้อนกว่า
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#2cc3fc]/60 bg-[#dff4fd] text-sm">🎁</span>
          <span>
            <strong class="text-[#8a6504]">เกมที่มีฟีเจอร์โบนัส</strong> ควรอ่านว่าฟีเจอร์นั้นเข้าเงื่อนไขเมื่อใด และมีข้อกำหนดการเข้าถึงหรือไม่ ก่อนเริ่มใช้งาน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#2cc3fc]/60 bg-[#dff4fd] text-sm">🎚️</span>
          <span>
            <strong class="text-[#8a6504]">เกมที่ปรับระดับการเดิมพันได้</strong> ช่วยให้ผู้ที่มีงบประมาณจำกัดเลือกระดับที่รับไหว แต่ควรดูช่วงที่ปรับได้จริงของแต่ละเกมก่อน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#2cc3fc]/60 bg-[#dff4fd] text-sm">🔎</span>
          <span>
            <strong class="text-[#8a6504]">ยอดเดิมพันขั้นต่ำและข้อกำหนดการฝากเงิน</strong> ควรตรวจสอบก่อนทำรายการทุกครั้ง เพราะจำนวนเงินเริ่มต้นอาจแตกต่างกันตามผู้ให้บริการ
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#8a6504]">ทั้งนี้ ควรตรวจสอบสถานะลิขสิทธิ์ของเกมจากหลักฐานทางการ และตระหนักว่าแม้เดิมพันด้วยเงินจำนวนน้อยก็ยังมีความเสี่ยงต่อการสูญเสียเงิน</strong>
        เพราะไม่สามารถยืนยันได้จากข้อความโฆษณาเพียงอย่างเดียว และรายการที่เปิดให้บริการปรับเปลี่ยนได้ตามประกาศล่าสุดของเว็บไซต์
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/ทดลองเล่น"
          aria-label={`เปิดหน้าทดลองเล่นของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#9ae0fa] bg-[#dff4fd] px-8 py-3 font-bold text-[#063a57] shadow-[0_4px_14px_rgba(6,58,87,0.12)] transition-all hover:scale-105 hover:border-[#2cc3fc] hover:shadow-[0_6px_18px_rgba(44,195,252,0.3)]">
          ไปหน้าทดลองเล่น
        </a>

        <a
          href="/ทางเข้า"
          aria-label={`เปิดหน้าทางเข้าของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#9ae0fa] bg-[#dff4fd] px-8 py-3 font-bold text-[#063a57] shadow-[0_4px_14px_rgba(6,58,87,0.12)] transition-all hover:scale-105 hover:border-[#2cc3fc] hover:shadow-[0_6px_18px_rgba(44,195,252,0.3)]">
          ไปหน้าทางเข้า
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`โปรโมชั่นของ ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} นำเสนอข้อมูลโปรโมชั่นสำหรับสมาชิกที่สนใจสิทธิพิเศษจากการใช้บริการ โดยรายการที่ระบุไว้ประกอบด้วย
        <strong class="text-[#8a6504]">รายการคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8%</strong>
        ซึ่งแต่ละรายการอาจมีข้อกำหนดเกี่ยวกับยอดที่นำมาคำนวณ ประเภทเกมที่เข้าร่วม และรอบเวลารับเครดิตแตกต่างกัน ก่อนเข้าร่วมจึงควรอ่านประกาศล่าสุดให้ครบถ้วน
      </p>

      <p>
        รายการคืนยอดเสียระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขในแต่ละวัน
        <strong class="text-[#8a6504]">สมาชิกควรตรวจสอบว่าเกมสล็อตประเภทใดเข้าร่วมรายการ มีรอบสรุปยอดเวลาใด และต้องกดรับเครดิตด้วยตนเองหรือไม่</strong>
        รวมถึงศึกษาข้อกำหนดเกี่ยวกับการนำเครดิตไปใช้และการถอนเงินให้ครบถ้วน ทั้งนี้ การได้รับเครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือรับประกันผลกำไรในอนาคต
      </p>

      <p>
        ส่วนรายการแนะนำเพื่อนระบุสิทธิ์ไว้สำหรับสมาชิกที่แนะนำผู้ใช้งานรายใหม่ โดยควรตรวจสอบวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และยอดที่ใช้คำนวณโบนัสให้ชัดเจน
        <strong class="text-[#8a6504]">แม้โปรโมชั่นจะระบุว่ากดรับได้ไม่จำกัด แต่ควรตรวจสอบจำนวนครั้งที่รับสิทธิ์ได้จริง รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุด</strong>
        เพื่อให้เข้าใจหลักเกณฑ์การรับสิทธิ์อย่างถูกต้อง และไม่เกิดความคลาดเคลื่อนเกี่ยวกับยอดเครดิตที่ได้รับ
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/promotion"
          aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#9ae0fa] bg-[#dff4fd] px-8 py-3 font-bold text-[#063a57] shadow-[0_4px_14px_rgba(6,58,87,0.12)] transition-all hover:scale-105 hover:border-[#2cc3fc] hover:shadow-[0_6px_18px_rgba(44,195,252,0.3)]">
          ดูภาพโปรโมชั่น
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`ขั้นตอนสมัครสมาชิกและเข้าสู่ระบบของ ${BRAND_NAME}`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} มีช่องทางสำหรับผู้ที่ต้องการศึกษาวิธีสมัครสมาชิกและเข้าสู่ระบบเกมสล็อตออนไลน์
        <strong class="text-[#8a6504]">ผู้สมัครควรตรวจสอบคุณสมบัติ อายุที่กฎหมายอนุญาต และเงื่อนไขการใช้บริการก่อนดำเนินการ</strong>
        ลำดับด้านล่างคือ 3 ขั้นตอนที่เว็บไซต์ระบุไว้
      </p>

      <ol class="ml-6 list-decimal space-y-3 marker:font-black marker:text-[#8a6504]">
        <li>
          <strong class="text-[#8a6504]">เข้าสู่หน้าสมัครสมาชิก</strong> ตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง จากนั้นเลือกเมนูสมัครสมาชิกและอ่านรายละเอียดเกี่ยวกับเงื่อนไขการเปิดบัญชี รวมถึงนโยบายการจัดเก็บข้อมูลส่วนบุคคล
        </li>
        <li>
          <strong class="text-[#8a6504]">กรอกข้อมูลและยืนยันบัญชี</strong> กรอกข้อมูลตามที่ระบบกำหนด ตรวจสอบความถูกต้องก่อนยืนยัน และตั้งรหัสผ่านที่คาดเดาได้ยาก ไม่ควรใช้ข้อมูลของบุคคลอื่นหรือเปิดเผยรหัส
          OTP ให้ใครทราบ
        </li>
        <li>
          <strong class="text-[#8a6504]">เข้าสู่ระบบและตรวจสอบรายละเอียดเกม</strong> หลังลงทะเบียนเรียบร้อย สามารถศึกษารายชื่อเกมสล็อต กติกาการเล่น ยอดเดิมพันขั้นต่ำ และเงื่อนไขโปรโมชั่นที่เปิดให้บริการ
          หากพบข้อสงสัยควรสอบถามเจ้าหน้าที่ผ่านช่องทางทางการก่อนทำรายการ
        </li>
      </ol>

      <p>
        <strong class="text-[#8a6504]">ส่วนข้อกำหนดและข้อจำกัดของการเปิดบัญชี ควรตรวจสอบจากประกาศล่าสุดของเว็บไซต์โดยตรง</strong>
        เพราะเป็นเงื่อนไขที่ปรับเปลี่ยนได้ตามที่ผู้ให้บริการกำหนด และไม่ใช่สิ่งที่หน้านี้ยืนยันแทนได้
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#0a7fbd] bg-gradient-to-b from-[#6bdcfb] via-[#2cc3fc] to-[#0a7fbd] px-8 py-3 font-black text-[#06293c] shadow-[0_0_14px_rgba(44,195,252,0.4)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#fdcb0c] bg-gradient-to-b from-[#fefb6b] to-[#fdcb0c] px-8 py-3 font-bold text-[#2a1f02] shadow-[0_0_12px_rgba(253,203,12,0.35)] transition-transform hover:scale-105">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`ช่องทางติดต่อแอดมิน ${BRAND_NAME} ตลอด 24ชม.`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} ระบุช่องทางติดต่อเจ้าหน้าที่สำหรับผู้ใช้งานที่ต้องการสอบถามเกี่ยวกับการสมัครสมาชิก การเข้าสู่ระบบ รายการฝากถอน และรายละเอียดโปรโมชั่น
        <strong class="text-[#8a6504]">โดยควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง</strong>
        หากพบปัญหาเกี่ยวกับธุรกรรม ควรเตรียมหมายเลขรายการและหลักฐานที่เกี่ยวข้องไว้สำหรับตรวจสอบ พร้อมอธิบายปัญหาให้ชัดเจน โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP
      </p>

      <p>
        <strong class="text-[#8a6504]">ทั้งนี้ ควรตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุดอีกครั้ง</strong>
        เพราะช่วงเวลาที่เจ้าหน้าที่รับเรื่องอาจปรับเปลี่ยนได้ตามที่ผู้ให้บริการกำหนด และระยะเวลาตอบกลับของแต่ละช่องทางอาจไม่เท่ากัน
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/line"
          aria-label={`ติดต่อเจ้าหน้าที่ ${BRAND_NAME} ผ่าน Line Official`}
          class="flex items-center justify-center gap-2 rounded-lg border border-[#00B900] bg-[#00B900] px-8 py-3 font-black text-white shadow-[0_0_15px_rgba(0,185,0,0.35)] transition-transform hover:scale-105">
          <span aria-hidden="true">💬</span>
          ติดต่อผ่าน Line Official
        </a>

