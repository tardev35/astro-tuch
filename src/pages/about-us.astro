---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่ม) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง
// ไม่ได้มาจากเช็กลิสต์หัวข้อของ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน
// SUB-PAGES ที่ให้ body จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริงของ MIRACLE55 เท่านั้น
//
// รอบนี้ (ดรอป 2026-09-25) คือ MIRACLE55 เว็บ **คาสิโนฐานหลัก** ที่เข้าเล่นผ่าน
// ระบบบริษัทแม่โดยตรง มีเกมสด เกมโต๊ะ และหมวดเกมยอดนิยม แยกค่ายไว้ชัดเจน
// ส่วนคอปปี้รอบก่อนเป็นของ KINGDOM66 ซึ่งบรีฟระบุ "บาคาร่า" "หวย" "บอล" และ
// "เครดิตฟรี" ไว้ — บรีฟของ MIRACLE55 **ไม่ได้ระบุสักคำ** ทั้งหน้าจึงถูกเขียนใหม่
// หัวข้อ "คาสิโนไลฟ์สดจากบริษัทต่างประเทศ" ของรอบก่อนถูกถอดออก (บรีฟรอบนี้ไม่ได้
// พูดถึงผู้ให้บริการต่างประเทศ) และแทนด้วยหัวข้อ "เข้าเล่นผ่านระบบบริษัทแม่โดยตรง"
// ซึ่งเป็นตัวตนของแบรนด์นี้จริง ห้าม find-and-replace ชื่อแบรนด์ทับของเก่าเด็ดขาด
//
// ข้อเท็จจริงทุกบรรทัดมาจาก src/assets/content.txt เท่านั้น: คาสิโนฐานหลัก ·
// รวมเกมจากหลายแบรนด์ไว้ในระบบเดียว · เข้าเล่นผ่านระบบบริษัทตรง/บริษัทแม่โดยตรง ·
// เกมสด · เกมโต๊ะ · หมวดเกมยอดนิยม · ระบบจัดแยกแต่ละค่ายให้ค้นหาได้ง่าย ·
// ตรวจสอบรายละเอียดเกมก่อนเข้าใช้งาน · จัดการบัญชีผ่านระบบเดียว ·
// รองรับมือถือและคอมพิวเตอร์ · โบนัสแนะนำเพื่อน 0.8% · โบนัสคืนยอดเสีย 0.3% ·
// ตรวจสอบยอดที่เข้าเกณฑ์ รอบคำนวณ และวิธีรับสิทธิ์ก่อนกดรับ ·
// สมัครเองผ่านหน้าเว็บได้ใน 3 ขั้นตอน · ไลน์แอด 24 ชั่วโมง
// — ห้ามอ้าง บาคาร่า หวย บอล เครดิตฟรี ชื่อค่ายเกม ชื่อสตูดิโอ ชื่อเกมเฉพาะ
// เลขใบอนุญาต ปีที่ก่อตั้ง เลขทะเบียนบริษัท จำนวนสมาชิก ค่า RTP ชื่อธนาคาร
// ช่องทางฝากถอนเจาะจง "ไม่มีขั้นต่ำ" "ออโต้ 10 วินาที" หรือการันตีว่าจะชนะ
// เพราะบรีฟรอบนี้ไม่ได้ระบุไว้
//
// ศัพท์ของบรีฟรอบนี้คือ **ไลน์แอด** ไม่ใช่ "LINE OFFICIAL" ที่ KINGDOM66 ใช้ —
// เนื้อความใช้คำของบรีฟ ส่วนป้ายบนปุ่มยังอ่านว่า Line Official ตามมาร์กอัปเดิม
//
// Announcement รอบนี้หมุนจาก AnnouncementCyber มาเป็น Announcement5 ทั้งเว็บ —
// default message ของไฟล์นั้นเป็นคอปปี้ของ MIRACLE55 แล้ว จึงเรียกแบบ bare เหมือน
// index.astro ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ MIRACLE55 เป็น **สองโลหะ** ตามโลโก้ (MI ทอง / RACLE เงินโครเมียม /
// 55 ทอง) จึงต้องใช้เงินเป็นแอ็กเซนต์ที่สองจริง ๆ ไม่ใช่หน้าทองล้วน:
// พื้นเพจ #050403 · ผิวการ์ด #14100a · ผิวการ์ดยก #1b140b · ตัวอักษรบนพื้นทอง #0d0a06 ·
// ทองสว่าง #fee47b · ทองแบรนด์ #fcda65 · ทองเข้ม #d9a62b · ทองลึก #8c5f14 ·
// เงินไฮไลต์ #fcfcfc · เงินกลาง #eaeaea · เงินเส้นขอบ #d2d3d4 · เงินหม่น #a8acb1 ·
// เนื้อความ #e8e6e1 (BRAND_TEXT) · เน้นใน strong #fcfcfc
// ปุ่มหลักไล่ทองสว่าง → ทองแบรนด์ → ทองเข้ม ส่วนปุ่มรองใช้เส้นขอบเงินโครเมียม
// เพื่อให้คู่ทอง/เงินอ่านออกจากหน้าเอง — ชุดทองครีมอุ่นของ KINGDOM66 ถูกแทนครบแล้ว
// (ตารางแมป old→new ดูที่ .rebrand-spec-MIRACLE55.md §2 — ห้ามพิมพ์ฮิวเก่าซ้ำไว้ใน
// ไฟล์นี้ เพราะสคริปต์แมปพาเลตต์จะไล่แทนค่าในคอมเมนต์ด้วย)
// ส่วน #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ตามเดิม
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลางที่ไม่หมุนตามรอบรีแบรนด์ และรอบนี้
// orchestrator เป็นคนรีธีม) — สีเนื้อความจึงตรงกับที่การ์ดกำหนดไว้อยู่แล้ว
//
// ไม่มีลิงก์ /ตรวจหวย หรือ /แนวทาง ในหน้านี้: MIRACLE55 เป็นแบรนด์คาสิโน ไม่ใช่
// เว็บหวย สองหน้านั้นอยู่ใน src/pages-disabled/ รอบนี้ href ที่ชี้ route ซึ่งไม่มี
// ใน dist/ จะทำให้ verify-build แดง
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index และ /promotion
// ส่วน banner1/banner1-mobile เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า
// และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กค้างของลูกค้าเจ้าอื่น ห้าม import
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 152
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "เกี่ยวกับ MIRACLE55 คาสิโนฐานหลักที่เล่นผ่านระบบบริษัทแม่โดยตรง รวมเกมสด เกมโต๊ะ และหมวดยอดนิยมจากหลายค่าย พร้อมโบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%";

const pageTitle = "เกี่ยวกับเรา MIRACLE55 คาสิโนฐานหลัก เล่นผ่านบริษัทตรง สนุกทุกค่าย";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e8e6e1]">
        <strong class="text-[#fcfcfc]">MIRACLE55</strong> คือ<strong class="text-[#fcfcfc]">คาสิโนฐานหลักที่รวมเกมจากหลายแบรนด์ไว้ในระบบเดียว</strong>
        โดยเข้าเล่นผ่านระบบบริษัทแม่โดยตรงตามข้อมูลของเว็บไซต์ สมาชิกเลือกเกมที่สนใจได้จากหลายค่าย ทั้งเกมสด เกมโต๊ะ และหมวดเกมยอดนิยม พร้อมเมนูที่จัดไว้ชัดเจน และใช้งานได้ทั้งบนมือถือและคอมพิวเตอร์
      </p>

      <p class="text-left text-base leading-relaxed text-[#e8e6e1]">
        หน้านี้รวบรวมไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่หมวดเกมที่เปิดให้เลือกและวิธีที่ระบบแยกค่ายไว้ให้ค้นหา ไปจนถึงโปรโมชั่นที่ตรวจสอบเงื่อนไขได้จากหน้าโปรโมชั่น ขั้นตอนการสมัครสมาชิก
        และช่องทางสอบถามเจ้าหน้าที่เมื่อไม่แน่ใจในขั้นตอนใด
      </p>

      <p class="text-left text-base leading-relaxed text-[#e8e6e1]">
        <strong class="text-[#fcfcfc]">รายการเกม ค่ายที่ให้บริการ และเงื่อนไขของโปรโมชั่นอาจเปลี่ยนแปลงตามช่วงเวลา</strong>
        รายละเอียดทั้งหมดจึงยึดตามข้อมูลที่เว็บไซต์แสดงไว้จริงในขณะนั้นเป็นหลัก และควรตรวจสอบรายการล่าสุดจากหน้าเว็บไซต์ก่อนทำรายการทุกครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="MIRACLE55 คาสิโนฐานหลัก เข้าเล่นผ่านระบบบริษัทแม่โดยตรง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e8e6e1]">
        จุดที่ทำให้ MIRACLE55 ต่างจากเว็บทั่วไปคือ <strong class="text-[#fcfcfc]">รูปแบบการเข้าเล่นผ่านระบบบริษัทตรงตามข้อมูลของเว็บไซต์</strong>
        เกมจากหลายแบรนด์จึงถูกรวมไว้ในระบบเดียว สมาชิกไม่ต้องสลับไปเปิดหลายเว็บไซต์เพื่อดูว่ามีอะไรให้เล่นบ้าง และจัดการทุกอย่างได้จากบัญชีเดียว
      </p>

      <p class="text-left text-base leading-relaxed text-[#e8e6e1]">
        โครงแบบนี้ทำให้<strong class="text-[#fcfcfc]">เมนูถูกจัดไว้ชัดเจนตั้งแต่หน้าแรก</strong>
        สมาชิกเห็นภาพรวมของหมวดที่เปิดให้เลือก แล้วเปิดเข้าไปดูรายละเอียดของรายการที่สนใจต่อได้ทันที โดยรายละเอียดทั้งหมดยึดตามข้อมูลที่ระบบแสดงไว้ในขณะนั้น
      </p>
    </div>
  </ContentBox>

  <ContentBox title="เกมสด เกมโต๊ะ และหมวดยอดนิยมของ MIRACLE55 แยกค่ายไว้ชัดเจน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e8e6e1]">
        เกมคาสิโนของ MIRACLE55 มีตัวเลือกจากหลายค่ายและหลายรูปแบบ <strong class="text-[#fcfcfc]">ทั้งเกมสด เกมโต๊ะ และหมวดที่ได้รับความนิยม</strong>
        โดยระบบจัดแยกแต่ละค่ายไว้ให้ค้นหาได้ง่าย สมาชิกจึงไล่ดูได้ว่าค่ายไหนเปิดรายการอะไรอยู่บ้าง แล้วเลือกประเภทที่เหมาะกับตัวเอง
      </p>

      <p class="text-left text-base leading-relaxed text-[#e8e6e1]">
        ก่อนเข้าใช้งาน สมาชิกสามารถ<strong class="text-[#fcfcfc]">ตรวจสอบค่ายและรายละเอียดของแต่ละเกมได้จากหน้ารวมเกม</strong>
        แล้วสลับไปยังหมวดที่สนใจต่อได้จากหน้าเดิม ระบบเปิดให้ทำได้ทั้งบนมือถือและคอมพิวเตอร์ และจัดการบัญชีผ่านระบบเดียวได้สะดวกมากขึ้น
      </p>
    </div>
  </ContentBox>

  <ContentBox title="โปรโมชั่น MIRACLE55 แนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e8e6e1]">
        โปรโมชั่นของ MIRACLE55 <strong class="text-[#fcfcfc]">จัดสิทธิ์ให้สมาชิกเลือกตามเงื่อนไขของแต่ละรายการ</strong>
        โดยมีทั้งโบนัสแนะนำเพื่อน 0.8% สำหรับสมาชิกที่แนะนำเพื่อนเข้ามาสมัคร และโบนัสคืนยอดเสีย 0.3% ตามยอดและเงื่อนไขที่ระบบกำหนดไว้ในแต่ละรอบ
      </p>

      <p class="text-left text-base leading-relaxed text-[#e8e6e1]">
        ระบบ<strong class="text-[#fcfcfc]">แสดงยอดที่เข้าเกณฑ์ รอบคำนวณ และวิธีรับสิทธิ์ไว้ให้ตรวจสอบ</strong>
        สมาชิกจึงติดตามโบนัสของตัวเองในแต่ละรอบได้จากบัญชีสมาชิกโดยตรง และควรอ่านเงื่อนไขของรายการที่สนใจให้ครบก่อนกดรับทุกครั้ง เพราะรายละเอียดของแต่ละรายการอาจแตกต่างกัน
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/promotion"
          aria-label="ดูภาพโปรโมชั่นทั้งหมดของ MIRACLE55"
          class="flex items-center justify-center rounded-lg border border-[#d9a62b] bg-[#14100a] px-8 py-3 font-bold text-[#e8e6e1] transition-all hover:scale-105 hover:border-[#fee47b] hover:bg-[#1b140b] hover:text-[#fcfcfc]">
          ดูโปรโมชั่นทั้งหมด
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="สมัครสมาชิก MIRACLE55 ด้วยตัวเองใน 3 ขั้นตอน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e8e6e1]">
        การสมัคร MIRACLE55 <strong class="text-[#fcfcfc]">ทำผ่านหน้าเว็บไซต์ได้ด้วยตัวเอง ขั้นตอนไม่ซับซ้อน</strong>
        หลังยืนยันบัญชีเรียบร้อยสามารถเข้าสู่ระบบเพื่อเลือกเกมและตรวจสอบโปรโมชั่นที่เปิดให้รับในแต่ละวันได้ทันที โดยมีขั้นตอนหลักเพียง 3 ขั้นตอนดังนี้
      </p>

      <ol class="ml-6 list-decimal space-y-2 text-left text-base leading-relaxed text-[#e8e6e1] marker:font-black marker:text-[#d9a62b]">
        <li>เปิดหน้าสมัคร MIRACLE55 แล้วกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน</li>
        <li>ตรวจสอบข้อมูลส่วนตัวและรายละเอียดบัญชีให้ถูกต้องก่อนกดยืนยัน</li>
        <li>ยืนยันการสมัครและเข้าสู่ระบบ จากนั้นเลือกเกมและตรวจสอบโปรโมชั่นที่เปิดให้สมาชิกได้ทันที</li>
      </ol>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก MIRACLE55"
          class="flex items-center justify-center rounded-lg border border-[#fee47b]/60 bg-gradient-to-r from-[#fee47b] via-[#fcda65] to-[#d9a62b] px-8 py-3 font-black text-[#0d0a06] shadow-[0_0_15px_rgba(252,218,101,0.35)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ MIRACLE55"
          class="flex items-center justify-center rounded-lg border border-[#d2d3d4]/70 bg-[#14100a] px-8 py-3 font-bold text-[#e8e6e1] shadow-[0_0_15px_rgba(210,211,212,0.28)] transition-all hover:scale-105 hover:border-[#fcfcfc] hover:bg-[#1b140b] hover:text-[#fcfcfc]">
