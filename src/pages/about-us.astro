---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่ม) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง
// ไม่ได้มาจากเช็กลิสต์หัวข้อของ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน
// SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริงของ 365LOTTO เท่านั้น
//
// บรีฟรอบนี้ (ดรอป 2026-09-24) คือ "365LOTTO หวยคาสิโนในเว็บเดียว หวย บาคาร่า
// ไพ่ สล็อต เดิมพันครบวงจร" — แบรนด์นี้เป็น **หวย + คาสิโน** ไม่ใช่คาสิโนสดล้วน
// คอปปี้ของแบรนด์รอบก่อน (SAGAME66 ที่นำด้วย "บาคาร่า รูเล็ต คาสิโนสด" และ
// "ค่ายมาตรฐานสากลปี 2026") ถูกเขียนใหม่ทั้งหน้าแล้ว เพราะบรีฟของ 365LOTTO
// ไม่ได้พูดถึงรูเล็ตหรือชื่อค่ายเลย แต่พูดถึงหวยเป็นบริการหลัก ห้ามใช้
// find-and-replace กับหน้านี้ มันจะทำให้ 365LOTTO อ้างเกมที่บรีฟไม่เคยระบุ
//
// ข้อเท็จจริงทุกบรรทัดมาจากบรีฟรอบนี้เท่านั้น: หวยรัฐบาลไทย · หวยฮานอย ·
// ลาวพัฒนา · แยกรอบเปิดรับของแต่ละประเภทชัดเจน · ตรวจสอบเลข รอบเวลา และ
// รายละเอียดก่อนยืนยัน · เลข 2 ตัวอัตราจ่าย 100 · เลข 3 ตัวอัตราจ่าย 1,000 ·
// บาคาร่า ไพ่ สล็อต และเกมรูปแบบอื่นตามรายการที่เปิดให้บริการ · บัญชีเดียว ·
// รองรับทั้งมือถือและคอมพิวเตอร์ · เมนูจัดหมวดชัดเจน · โบนัสแนะนำเพื่อน 0.8% ·
// โบนัสคืนยอดเสีย 0.3% · สมัครผ่านมือถือ 3 ขั้นตอน · แอดมินดูแลตลอด 24 ชั่วโมง
// — ห้ามอ้างเลขใบอนุญาต ปีที่ก่อตั้ง เลขทะเบียนบริษัท จำนวนสมาชิก ชื่อค่ายเกม
// ค่า RTP อัตราจ่ายอื่นนอกจาก 100/1,000 ขั้นต่ำการเดิมพัน "ฝากถอนออโต้ไม่มี
// ขั้นต่ำ" "ปลอดภัย 100%" "เร็วที่สุด/ปลอดภัยที่สุดในไทย" หรือการันตีว่าจะถูกรางวัล
// เพราะบรีฟไม่ได้ระบุไว้
//
// Announcement รอบนี้หมุนมาใช้ AnnouncementHuay ทั้งเว็บ — default message ของ
// ไฟล์นั้นเป็นคอปปี้ของ 365LOTTO อยู่แล้ว จึงเรียกแบบ bare เหมือน index.astro
// ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ 365LOTTO (แดงเข้ม + ทองสว่าง + เงินโครเมียม บนพื้นแดงเกือบดำ แทนทองอุ่น-
// น้ำตาลของ SAGAME66 รอบก่อน): พื้นเกือบดำ #120406 · การ์ด #1a0709 · การ์ดยก
// #33100f · ทองลึก #9c6a12 · ทองหลัก #fadc64 · ทองสว่าง #ffe9a3 · แดงสด #e01f26 ·
// เงินโครเมียม #f3f6fa ใช้กับชื่อแบรนด์และข้อความเน้น · เนื้อความ #f0ddc4
// (BRAND_TEXT) · ตัวอักษรบนปุ่มไล่สีทองใช้หมึก #120406 เพื่อให้อ่านออก ·
// ตัวเลข (100 / 1,000 / 0.8% / 0.3%) ใช้ทองสว่าง #ffe9a3 เท่านั้น
// — ทองอุ่นและน้ำตาลของแบรนด์รอบก่อน (#e8b93f/#96671a/#0d0903/#171006/#2a1d0b/
// #e3d8c0/#eef3f8) ถูกถอดออกหมดแล้ว ห้ามนำกลับมา
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index และ /promotion
// ส่วน banner1/banner1-mobile เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า
// และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กค้างของลูกค้าเจ้าอื่น ห้าม import
//
// ห้ามลิงก์ไป /ตรวจหวย หรือ /แนวทาง รอบนี้ทั้งสองหน้าถูกพักไว้ใน src/pages-disabled/
// การลิงก์ไปเส้นทางที่ไม่มีจริงทำให้ verify-build แดง
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 153
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "เกี่ยวกับ 365LOTTO เว็บรวมหวยและคาสิโนในระบบเดียว ทั้งหวยรัฐบาลไทย ฮานอย ลาวพัฒนา พร้อมบาคาร่า ไพ่ สล็อต และโปรโมชั่นที่ตรวจสอบเงื่อนไขได้ก่อนกดรับสิทธิ์";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับเรา 365LOTTO หวยคาสิโนในเว็บเดียว ครบทั้งหวยและเกมเดิมพัน",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา 365LOTTO หวยคาสิโนในเว็บเดียว ครบทั้งหวยและเกมเดิมพัน" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับเรา 365LOTTO หวยคาสิโนในเว็บเดียว ครบทั้งหวยและเกมเดิมพัน" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f0ddc4]">
        <strong class="text-[#f3f6fa]">365LOTTO</strong> คือเว็บที่
        <strong class="text-[#f3f6fa]">รวมทั้งหวยและคาสิโนไว้ในระบบเดียว</strong>
        มีให้เลือกตั้งแต่หวยรัฐบาลไทย หวยฮานอย ลาวพัฒนา ไปจนถึงบาคาร่า ไพ่ สล็อต และเกมรูปแบบอื่นอีกหลายประเภทตามรายการที่เปิดให้บริการ โดยเลือกหมวดที่สนใจได้ผ่านบัญชีเดียว รองรับทั้งมือถือและคอมพิวเตอร์
      </p>

      <p class="text-left text-base leading-relaxed text-[#f0ddc4]">
        หน้านี้รวบรวมไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่รายการหวยที่เปิดรับในแต่ละรอบ อัตราจ่ายที่ระบบระบุไว้ หมวดเกมอื่นที่เลือกได้จากบัญชีเดียวกัน รายการโปรโมชั่นที่ตรวจสอบเงื่อนไขก่อนกดรับได้
        ขั้นตอนการสมัครสำหรับคนที่เพิ่งเข้ามาใช้งานครั้งแรก ไปจนถึงช่องทางสอบถามแอดมินเมื่อไม่แน่ใจในขั้นตอนใด
      </p>

      <p class="text-left text-base leading-relaxed text-[#f0ddc4]">
        <strong class="text-[#f3f6fa]">รอบที่เปิดรับ รายการเกม และสิทธิ์ที่ใช้งานได้อาจเปลี่ยนแปลงตามช่วงเวลา</strong>
        รายละเอียดทั้งหมดจึงยึดตามรอบเวลาและเงื่อนไขที่ระบบแสดงไว้จริงในช่วงนั้นเป็นหลัก และควรตรวจสอบรายการล่าสุดจากหน้าเว็บไซต์ก่อนทำรายการทุกครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="365LOTTO รวมหวยรัฐบาลไทย ฮานอย ลาวพัฒนา ไว้ในระบบเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f0ddc4]">
        บริการหลักของ 365LOTTO คือ <strong class="text-[#f3f6fa]">รายการหวยยอดนิยมให้เลือกทั้งรัฐบาลไทย หวยฮานอย และลาวพัฒนา</strong>
        โดยแยกรอบเปิดรับของแต่ละประเภทไว้อย่างชัดเจน ผู้ใช้งานจึงติดตามหวยหลายประเภทได้จากหน้าเดียว ไม่ต้องสลับไปเปิดหลายเว็บไซต์เพื่อดูว่ารอบไหนกำลังเปิดรับอยู่
      </p>

      <p class="text-left text-base leading-relaxed text-[#f0ddc4]">
        ก่อนยืนยันบิลทุกครั้ง <strong class="text-[#f3f6fa]">สามารถตรวจสอบเลข รอบเวลา และรายละเอียดของรายการนั้นได้จากหน้าเว็บไซต์</strong>
        ทั้งประเภทหวยที่เลือก ชุดตัวเลขที่กรอก และข้อมูลของบิล ขั้นตอนนี้คือจุดที่ลดความผิดพลาดได้มากที่สุดสำหรับคนที่ซื้อหลายรายการในรอบเดียวกัน
      </p>
    </div>
  </ContentBox>

  <ContentBox title="อัตราจ่ายหวย 365LOTTO เลข 2 ตัวจ่าย 100 และเลข 3 ตัวจ่าย 1,000" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f0ddc4]">
        365LOTTO <strong class="text-[#f3f6fa]">แสดงอัตราจ่ายของหวยแต่ละประเภทไว้ให้ตรวจสอบก่อนทำรายการ</strong>
        ทั้งเลข 2 ตัวและเลข 3 ตัว พร้อมรายละเอียดของรอบที่เปิดรับ ผู้ใช้งานจึงเลือกประเภทการซื้อให้ตรงกับรูปแบบที่ต้องการได้ตั้งแต่ก่อนกดยืนยัน
      </p>

      <p class="text-left text-base leading-relaxed text-[#f0ddc4]">
        ตามเงื่อนไขที่ระบบกำหนด <strong class="text-[#f3f6fa]">เลข 2 ตัวระบุอัตราจ่ายไว้ที่ <span class="text-[#ffe9a3]">100</span> และเลข 3 ตัวระบุอัตราจ่ายไว้ที่ <span class="text-[#ffe9a3]">1,000</span></strong>
        โดยรายละเอียดอาจแตกต่างกันตามประเภทหวยและตามรอบ จึงควรเช็กอัตราจ่ายของรอบที่กำลังเปิดรับอีกครั้งก่อนส่งบิลจริงเสมอ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="บาคาร่า ไพ่ สล็อต และเกมรูปแบบอื่นในบัญชีเดียวกับหวย" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f0ddc4]">
        365LOTTO ไม่ได้มีเฉพาะหวย <strong class="text-[#f3f6fa]">ภายในระบบยังมีบาคาร่า ไพ่ สล็อต และเกมรูปแบบอื่นตามรายการที่เปิดให้บริการ</strong>
        สมาชิกจึงเลือกดูแต่ละหมวดผ่านบัญชีเดียวได้จากหน้าเว็บไซต์ และสลับจากหวยไปหมวดเกมอื่นได้จากจุดเดียวกัน โดยไม่ต้องสมัครแยก
      </p>

      <p class="text-left text-base leading-relaxed text-[#f0ddc4]">
        <strong class="text-[#f3f6fa]">เมนูถูกจัดหมวดหมู่ไว้ชัดเจน</strong>
        จึงเข้าถึงรายการต่าง ๆ ได้สะดวกขึ้นโดยไม่ต้องไล่เปิดทีละหน้า และเพราะบัญชีเดียวใช้ได้ทั้งบนมือถือและคอมพิวเตอร์ การเปิดหมวดเดียวกันจากคนละอุปกรณ์ก็เห็นโครงหน้าแบบเดียวกัน
      </p>
    </div>
  </ContentBox>

  <ContentBox title="โปรโมชั่น 365LOTTO แนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f0ddc4]">
        โปรโมชั่นของ 365LOTTO <strong class="text-[#f3f6fa]">มีสิทธิ์ให้สมาชิกเลือกหลายรูปแบบตามเงื่อนไขของแต่ละรายการ</strong>
        แต่ละรายการมีรายละเอียดของตัวเองให้ตรวจสอบก่อนกดรับ สมาชิกจึงเลือกเฉพาะโปรโมชั่นที่เหมาะกับลักษณะการใช้งานของตัวเอง และติดตามสิทธิ์ทั้งหมดผ่านบัญชีได้จากที่เดียว
      </p>

      <p class="text-left text-base leading-relaxed text-[#f0ddc4]">
        สมาชิกที่แนะนำเพื่อนเข้ามาสมัครสามารถรับ<strong class="text-[#ffe9a3]">โบนัสแนะนำเพื่อน 0.8%</strong>
        ตามเงื่อนไขของโปรโมชั่น ระบบจะแสดงรายละเอียดของยอดที่เข้าเกณฑ์และขั้นตอนรับสิทธิ์ให้ตรวจสอบ ช่วยให้ติดตามโบนัสจากกิจกรรมแนะนำเพื่อนได้สะดวกผ่านบัญชีสมาชิกโดยตรง
      </p>

      <p class="text-left text-base leading-relaxed text-[#f0ddc4]">
        ส่วนโปรโมชั่นคืนยอดเสียให้<strong class="text-[#ffe9a3]">โบนัส 0.3%</strong> ตามยอดและเงื่อนไขที่ระบบกำหนด สมาชิกสามารถตรวจสอบรอบคำนวณ ยอดที่เข้าเกณฑ์ และรายละเอียดก่อนกดรับสิทธิ์ได้จากหน้าโปรโมชั่น
        จึงติดตามสิทธิ์ในแต่ละรอบได้ชัดเจนและจัดการโบนัสของตัวเองได้ง่ายขึ้น
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/promotion"
          aria-label="ดูโปรโมชั่นทั้งหมดของ 365LOTTO"
          class="flex items-center justify-center rounded-lg border border-[#fadc64] bg-[#1a0709] px-8 py-3 font-bold text-[#f0ddc4] transition-all hover:scale-105 hover:border-[#ffe9a3] hover:bg-[#33100f] hover:text-[#f3f6fa]">
          ดูโปรโมชั่นทั้งหมด
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="สมัคร 365LOTTO ด้วยตัวเองผ่านมือถือ 3 ขั้นตอน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f0ddc4]">
        การสมัคร 365LOTTO ทำผ่านมือถือได้ด้วยตัวเอง ขั้นตอนไม่ซับซ้อนและใช้เวลาไม่นาน หลังยืนยันบัญชีเรียบร้อยก็สามารถ<strong class="text-[#f3f6fa]">
          เข้าสู่ระบบเพื่อเลือกหวยหรือเกมประเภทที่สนใจได้ทันที
        </strong>
        โดยมี 3 ขั้นตอนหลักดังนี้
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#f0ddc4]">
        <li class="flex gap-3">
          <span class="font-bold text-[#fadc64]">1.</span>
          <span>เปิดหน้าสมัคร 365LOTTO บนมือถือ แล้วกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#fadc64]">2.</span>
