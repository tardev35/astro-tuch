---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login,
// /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx
// ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึง
// เขียนขึ้นใหม่บนข้อเท็จจริงของ 1SS365 เท่านั้น (src/assets/content.txt)
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
//
// ดรอปนี้ (2026-10-03) คือ 1SS365 **สล็อตออนไลน์ เว็บตรงต่างประเทศ ไม่ผ่านเอเย่นต์**
// แง่มุมที่บรีฟระบุไว้มีเท่านี้: รวมเกมสล็อตหลายรูปแบบไว้เลือกผ่านบัญชีเดียว ทั้ง
// สล็อตคลาสสิก ฟรีสปิน ตัวคูณ และเกมโบนัส · เข้าเล่นผ่านมือถือได้โดยไม่ต้องสลับหลาย
// เว็บไซต์ · ตรวจสอบค่ายเกม เครดิต โปรโมชั่น และประวัติรายการได้จากระบบเดียว ·
// ช่วงเดิมพันขั้นต่ำและสูงสุดขึ้นกับค่ายและเกมที่เลือก · โปรโมชั่นคืนยอดเสีย 0.3%
// และแนะนำเพื่อน 0.8% มีรอบคำนวณและยอดที่เข้าเกณฑ์ของตัวเอง · สมัครผ่านมือถือ
// 3 ขั้นตอน · แอดมิน 24 ชั่วโมง · ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP
//
// แบรนด์ก่อนหน้า (หวย365) เป็น **เว็บแทงหวยออนไลน์** คนละสินค้ากันทั้งหน้า — ย่อหน้า
// และรายการของหวย (รายการหวยรัฐบาลไทย ฮานอย ลาวพัฒนา หวยหุ้น เลือกเลข ส่งโพย โพย
// อัตราจ่าย 2 ตัว 100 บาท 3 ตัว 1,000 บาท งวด สถิติหวยย้อนหลัง แนวทางหวย กลุ่มหวย)
// ถูกถอดออก **ทั้งก้อน** แล้วเขียนใหม่เป็นเรื่องของสล็อตตามที่บรีฟรอบนี้ระบุจริง
// ไม่ใช่ find-and-replace ทับประโยคเดิม เพราะการคงโครงประโยคเดิมไว้แล้วสลับแต่ชื่อ
// แบรนด์ คือวิธีที่ทำให้เว็บใหม่ไปอ้างสินค้าที่บรีฟของตัวเองไม่ได้ให้มา
//
// รอบนี้ /ตรวจหวย กับ /แนวทาง ถูกย้ายไป src/pages-disabled/ แล้ว (1SS365 ไม่ใช่เว็บ
// หวย) ห้ามลิงก์ไปสองเราต์นั้นจากหน้านี้ เพราะเป็นเราต์ตายและทำให้ build แดง
//
// ตัวเลขที่อ้างได้มีแค่ คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · 3 ขั้นตอน · 24 ชั่วโมง ·
// 100% ห้ามเพิ่มใบอนุญาต ชื่อผู้ให้บริการ ชื่อธนาคาร ยอดฝากขั้นต่ำ จำนวนสมาชิก
// ปีที่ก่อตั้ง ค่า RTP หรือชื่อค่ายเกม/ชื่อเกมที่บรีฟไม่ได้เอ่ยไว้สักชื่อ
//
// ประโยคเฮดจ์ที่บรีฟเขียนกำกับไว้เองและห้ามตัดทิ้งเพราะฟังดูไม่ขายของ: คำว่าแตกง่าย
// หรือจ่ายไวเป็นลักษณะเชิงโฆษณา ไม่สามารถใช้รับประกันผลการเล่นหรือระยะเวลาของธุรกรรม
// ได้ในทุกกรณี · แต่ละค่ายกำหนดช่วงเดิมพันต่างกัน จึงไม่ควรถือว่าทุกเกมไม่มีขั้นต่ำ
// เหมือนกันทั้งหมด · การเป็นเว็บต่างประเทศหรือไม่ผ่านเอเย่นต์เพียงอย่างเดียวไม่ได้
// รับประกันว่าเว็บไซต์หรือธุรกรรมจะปลอดภัย 100%
//
// พาเลตต์ 1SS365 (brand-spec §New palette) **ทองนำ เงินโครเมียมรอง บนดำ** — ทองคือ
// สีตัวตนจริงจาก logo.webp (vivid #edbb23) และเงินคือฮิวที่สองจากตัวอักษร 1SS:
// ทองแบรนด์ #edbb23 (ขอบ จุด bullet, marker, หมึกเน้น) · ทองสว่าง #f7d458 (hover) ·
// ทองอ่อน #ffeeb4 (ต้นไล่เฉด หมึกเน้นใน strong ตัวอักษรปุ่มรอง) · ทองลึก #a87708
// (ขอบจาง ปลายไล่เฉดปุ่มหลัก) · เงินโครเมียม #c8cbce · พื้นลึก #050505 · พื้นการ์ด
// #121010 · พื้นอุ่น #1a1710 (ปุ่มรอง) · ขอบอุ่น #2a2115 · เนื้อความ #f0e6d2
// (BRAND_TEXT)
// ชุดแดง-ทองของ หวย365 (#dc0203 #f5282a #8c0402 #ffc93c #ffeab0 #c08a07 #240406
// #3a0a0c #1a0303 #f6e7e0 rgba(255,201,60,*) rgba(140,4,2,*)) ออกครบทุกจุดแล้ว
// #00B900/#009900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้
// กฎคอนทราสต์: พื้นทอง → หมึกดำ #050505 เสมอ และไล่เฉดปุ่มทองจบที่ #a87708 เท่านั้น
// ปุ่มรองเป็น "ขอบทองจางบนพื้นดำอมทอง" ไม่ใช่ถมทองอีกใบ
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// — การ์ดตั้งสีเนื้อความ #f0e6d2 ไว้ที่ตัวการ์ดแล้ว ย่อหน้าจึงไม่ใส่คลาสสีซ้ำ
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจาก
// หน้า และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น AnnouncementPremium ทั้งเว็บ (รอบก่อน หวย365 ใช้
// AnnouncementHuay) — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ
// 1SS365 แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูดคนละเรื่อง
// กับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 159
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} สล็อตเว็บตรงต่างประเทศ ไม่ผ่านเอเย่นต์ หน้านี้สรุปว่าภายในเว็บไซต์มีเกมสล็อต โปรโมชั่น ขั้นตอนสมัคร และช่องทางติดต่อแอดมินอะไรให้ใช้งานบ้าง`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} สล็อตเว็บตรงต่างประเทศ ไม่ผ่านเอเย่นต์ รวมเกมไว้ในบัญชีเดียว`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed">
        <strong class="text-[#ffeeb4]">{BRAND_NAME} ให้บริการเกมสล็อตออนไลน์จากแพลตฟอร์มต่างประเทศ โดยรวมเกมหลายรูปแบบไว้ให้เลือกผ่านบัญชีเดียว</strong>
        ทั้งสล็อตคลาสสิก ฟรีสปิน ตัวคูณ และเกมโบนัส จุดตั้งต้นของเว็บไซต์คือผู้ที่ต้องการเข้าเล่นผ่านมือถือโดยไม่ต้องสลับไปมาหลายเว็บไซต์ จึงค้นหาเกม ตรวจสอบเครดิต และย้อนดูรายการของตัวเองได้จากที่เดิม
      </p>

      <p class="text-left text-base leading-relaxed">
        หน้านี้สรุปไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่ค่ายเกมและช่วงเดิมพันที่ระบบรองรับ
        <strong class="text-[#ffeeb4]">ไปจนถึงโปรโมชั่นที่เปิดให้รับในแต่ละช่วงของเดือน ขั้นตอนสมัครแบบ 3 ขั้นตอน และช่องทางติดต่อแอดมินที่ดูแลตลอด 24 ชั่วโมง</strong>
        เมื่อไม่แน่ใจในขั้นตอนใด สมาชิกจึงตรวจสอบค่ายเกม เครดิต โปรโมชั่น และประวัติรายการได้จากระบบเดียวโดยไม่ต้องเปิดหลายหน้าพร้อมกัน
      </p>

      <p class="text-left text-base leading-relaxed">
        สิ่งหนึ่งที่เว็บไซต์ระบุไว้เองและควรอ่านไปพร้อมกันคือ
        <strong class="text-[#ffeeb4]">คำว่าแตกง่ายหรือจ่ายไวเป็นลักษณะเชิงโฆษณา ไม่สามารถใช้รับประกันผลการเล่นหรือระยะเวลาของธุรกรรมได้ในทุกกรณี</strong>
        ข้อมูลในหน้านี้จึงเขียนไว้เพื่อบอกว่าระบบมีอะไรให้ใช้ ไม่ได้ใช้คาดการณ์ผลของเกมรอบใดรอบหนึ่ง
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`เกมสล็อตและช่วงเดิมพันที่ ${BRAND_NAME} เปิดให้เลือก`} as="h2">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed">
        หลัง Login สมาชิกเลือกเกมสล็อตได้
        <strong class="text-[#ffeeb4]">ตามค่ายและช่วงเดิมพันที่ระบบรองรับ มีทั้งเกมที่เริ่มต้นด้วยยอดต่ำและเกมที่ปรับระดับเดิมพันได้หลายช่วง</strong>
        รูปแบบเกมที่รวมไว้ในบัญชีเดียวแบ่งออกได้ประมาณนี้
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#edbb23]">🎰</span>
          <span>
            <strong class="text-[#ffeeb4]">สล็อตคลาสสิก</strong> เป็นรูปแบบพื้นฐานที่กติกาอ่านจบได้เร็วที่สุด เหมาะกับการเริ่มทำความคุ้นเคยกับหน้าเกมและปุ่มปรับเดิมพันก่อนย้ายไปเกมที่มีฟีเจอร์มากกว่า
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#edbb23]">🌀</span>
          <span>
            <strong class="text-[#ffeeb4]">ฟรีสปิน</strong> เป็นฟีเจอร์ที่แต่ละเกมกำหนดเงื่อนไขการเข้าถึงต่างกัน ควรเปิดข้อมูลเกมอ่านว่ารอบฟรีสปินของเกมนั้นเริ่มอย่างไรและนับจบอย่างไร
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#edbb23]">✖️</span>
          <span>
            <strong class="text-[#ffeeb4]">ตัวคูณ</strong> เป็นอีกฟีเจอร์ที่ค่าของมันขึ้นอยู่กับเกมและรอบที่กำลังเล่น ไม่ใช่ค่าคงที่ของทั้งเว็บไซต์ จึงควรดูจากข้อมูลของเกมนั้นโดยตรง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#edbb23]">🎁</span>
          <span>
            <strong class="text-[#ffeeb4]">เกมโบนัส</strong> คือกลุ่มเกมที่มีรอบพิเศษแยกออกจากรอบปกติ รายละเอียดของรอบนั้นระบุไว้ในหน้าข้อมูลของเกม ควรอ่านก่อนตั้งยอดเดิมพัน
          </span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed">
        <strong class="text-[#ffeeb4]">ก่อนเริ่มเล่นควรตรวจสอบขั้นต่ำและสูงสุดของเกมนั้นโดยตรง</strong>
        เนื่องจากแต่ละค่ายสามารถกำหนดช่วงเดิมพันแตกต่างกัน จึงไม่ควรถือว่าทุกเกมไม่มีขั้นต่ำเหมือนกันทั้งหมด การเปิดข้อมูลเกมอ่านก่อนหนึ่งครั้งคือวิธีที่ตรงที่สุดในการรู้ว่าเกมที่เลือกอยู่รองรับช่วงใด
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/ทดลองเล่น"
          aria-label={`เปิดหน้าทดลองเล่นสล็อตของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#a87708]/55 bg-[#1a1710] px-8 py-3 font-bold text-[#ffeeb4] transition-all hover:scale-105 hover:border-[#edbb23] hover:bg-[#121010] hover:text-[#f7d458]">
          ไปหน้าทดลองเล่น
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`โปรโมชั่นและขั้นตอนสมัครเล่นสล็อต ${BRAND_NAME} บนมือถือ`} as="h2">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed">
        สมาชิกตรวจสอบโปรโมชั่นที่ {BRAND_NAME} เปิดให้รับในแต่ละช่วงของเดือนได้จากบัญชีของตนเอง
        <strong class="text-[#ffeeb4]">มีทั้งโบนัสคืนยอดเสียและกิจกรรมแนะนำเพื่อน</strong>
        โดยทั้งสองรายการคำนวณจากยอดที่เข้าเกณฑ์ตามรอบที่เว็บไซต์กำหนด ไม่ได้ให้โดยอัตโนมัติกับทุกยอดการเล่น
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#edbb23]">💸</span>
          <span>
            <strong class="text-[#ffeeb4]">คืนยอดเสีย โบนัส 0.3%</strong> สำหรับสมาชิกที่มียอดเสียตรงตามข้อกำหนด ระบบจะนำยอดที่เข้าเกณฑ์มาคำนวณก่อนแสดงโบนัสที่รับได้ ควรตรวจรอบตัดยอด ค่ายเกมที่ร่วมรายการ และเงื่อนไขการใช้โบนัสก่อนกดรับทุกครั้ง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#edbb23]">🤝</span>
          <span>
