---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

// JOKERSLOTZ เป็นเว็บเกมสล็อตลิขสิทธิ์แท้จากค่าย Joker Gaming — หน้านี้เคยเป็นบทความ
// ของแบรนด์หวยก่อนหน้า (ตลาดหวย อัตราจ่ายบาทละ การส่งโพย) และถูกเขียนใหม่
// ทั้งหมดรอบนี้ ไม่เหลือเนื้อหาหวยแม้แต่บรรทัดเดียว
//
// ข้อเท็จจริงทุกบรรทัดมาจาก src/assets/content.txt เท่านั้น:
// เว็บให้บริการเกมโจ๊กเกอร์สล็อตอันดับ 1 ในไทย ได้รับการยอมรับจากผู้เล่นทั่วประเทศ ·
// อัปเดตทางเข้าสำรองล่าสุด แก้ปัญหาลิ้งก์เข้าไม่ได้หรือเว็บโดนบล็อก ·
// เกมสล็อตลิขสิทธิ์แท้จากค่าย Joker Gaming · พัฒนาระบบเซิร์ฟเวอร์ใหม่ทั้งหมด
// เข้ารหัสความปลอดภัย (Encryption) แน่นหนาขึ้น แนะนำให้สมัครใช้ยูสใหม่ ·
// โปรแนะนำเพื่อน 0.8% จากทุกยอดเดิมพันของเพื่อน ถอนเป็นเงินสดได้ ·
// โปรคืนยอดเสีย 0.3% ทุกรอบบิล · สมัครออโต้ 3 ขั้นตอน เสร็จใน 1 นาที ·
// รองรับทุกธนาคารและ TrueMoney Wallet ระบบฝาก-ถอนออโต้ ·
// แอดมิน Line Official 24 ชั่วโมง · เล่นผ่านเว็บบราว์เซอร์บนมือถือ iOS และ Android
// ไม่ต้องดาวน์โหลดแอป
// — ห้ามอ้างเลขใบอนุญาต ปีที่ก่อตั้ง เลขทะเบียนบริษัท จำนวนสมาชิก รางวัล ที่อยู่บริษัท
// หรือการันตีผลกำไร เพราะบรีฟไม่ได้ระบุไว้เลย
//
// Announcement รอบนี้หมุนมาใช้ AnnouncementPremium ทั้งเว็บ — default message ของ
// ไฟล์นั้นเป็นคอปปี้ของ JOKERSLOTZ อยู่แล้ว จึงเรียกแบบ bare ไม่ต้องส่ง prop
//
// พาเลตต์ JOKERSLOTZ: แดงโลโก้ #a51515 นำโครงสร้าง · แดงสว่าง #c81e1e สำหรับ hover
// และตัวเลขลำดับ · แดงเข้ม #6d0d0d เป็นสต็อปล่างของเกรเดียนต์ · ทอง #d9b45e เป็นขอบ
// และไอคอน · ทองอ่อน #f2dc9a เป็นสีเดียวที่ใช้กับ <strong> และตัวอักษรบนปุ่มแดง ·
// เนื้อความ #ecdfd0 — ไม่มีชมพูหรือเทาของแบรนด์ก่อนหน้าหลงเหลือ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 158
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "เกี่ยวกับ JOKERSLOTZ เว็บโจ๊กเกอร์สล็อตอันดับ 1 ในไทย เกมลิขสิทธิ์แท้จากค่าย Joker Gaming ทางเข้าสำรองอัปเดตล่าสุด ฝาก-ถอนออโต้ทุกธนาคาร แอดมินดูแล 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ JOKERSLOTZ เว็บโจ๊กเกอร์สล็อตอันดับ 1 ในไทย",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา JOKERSLOTZ เว็บโจ๊กเกอร์สล็อตอันดับ 1 ในไทย" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ JOKERSLOTZ เว็บโจ๊กเกอร์สล็อตอันดับ 1 ในไทย" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ecdfd0]">
        <strong class="text-[#f2dc9a]">JOKERSLOTZ (โจ๊กเกอร์สล็อตซ์)</strong> คือเว็บให้บริการ<strong class="text-[#f2dc9a]">เกมโจ๊กเกอร์สล็อตอันดับ 1 ในไทย</strong>
        ที่ได้รับการยอมรับจากผู้เล่นทั่วประเทศ เราเปิดให้เข้าถึงหน้าเกมสล็อตลิขสิทธิ์แท้จากค่าย Joker Gaming ได้โดยตรง สมาชิกใช้บัญชีเดียวทำได้ครบตั้งแต่สมัครสมาชิก ฝากเครดิต เลือกเกมที่จะหมุน กดรับโปรโมชั่น
        ไปจนถึงถอนเงิน
      </p>

      <p class="text-left text-base leading-relaxed text-[#ecdfd0]">
        สิ่งที่เราให้ความสำคัญที่สุดคือความต่อเนื่องของการเข้าใช้งาน เราจึง<strong class="text-[#f2dc9a]">อัปเดตทางเข้าสำรองล่าสุด</strong>
        ไว้แก้ปัญหาลิ้งก์เข้าใช้งานไม่ได้หรือเว็บโดนบล็อก ให้คุณเข้าถึงหน้าเกมได้อย่างรวดเร็วและเสถียรที่สุด หน้านี้รวบรวมไว้ว่าเราเป็นใคร ให้บริการเกมจากค่ายไหน ดูแลเรื่องความปลอดภัยและระบบการเงินอย่างไร
        และติดต่อทีมงานได้ทางช่องทางใด
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ทางเข้าสำรอง JOKERSLOTZ อัปเดตล่าสุด เซิร์ฟเวอร์ใหม่ ปลอดภัยขึ้น 100%" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ecdfd0]">
        การอัปเดตลิ้งก์ทางเข้าสำรองในครั้งนี้ไม่ได้เปลี่ยนแค่ที่อยู่เว็บ แต่เรา<strong class="text-[#f2dc9a]">พัฒนาระบบเซิร์ฟเวอร์ใหม่ทั้งหมดเพื่อยกระดับความปลอดภัยขั้นสูงสุด</strong>
        ทางเข้าสำรองถูกสร้างขึ้นมาเพื่อป้องกันปัญหาลิ้งก์หลักเข้าไม่ได้ เนื่องจากบางครั้งเครือข่ายอินเทอร์เน็ตอาจมีการบล็อก การใช้ทางเข้าสำรองจึงช่วยให้คุณเข้าเล่นเกมสล็อตได้อย่างต่อเนื่องโดยไม่ต้องกลัวเว็บปลิว
