---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion,
// /login, /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์
// หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา
// ทั้งหน้าจึงเขียนขึ้นใหม่บนข้อเท็จจริงของบรีฟรอบนี้เท่านั้น (src/assets/content.txt)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x4 · h3x0
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) จึงเปิดใช้งานอยู่ (เจ้าของสั่งให้คงไว้รอบนี้)
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// ตัวที่ routing จริงคือไฟล์นี้ ตัวที่จอดไว้เป็นอินเวนทอรี ห้ามแก้และห้ามลบ
//
// ดรอปนี้ (2026-10-08) คือ **คาสิโนฐานเข้าหลัก** ที่รวมหลายหมวดไว้ในบัญชีเดียว
// ไม่ใช่เว็บหวย และไม่ใช่เว็บคาสิโนไลฟ์เบทต่ำแบบรอบก่อน แง่มุมที่บรีฟระบุไว้มีเท่านี้:
// รวมช่องทางเดิมพันหลายประเภทในระบบเดียว · บาคาร่า รูเล็ต บอล หวย สล็อต ·
// เลือกเกม ตรวจสอบเครดิต โปรโมชั่น ประวัติการเดิมพัน ผ่านบัญชีเดียว ·
// บาคาร่า/รูเล็ตมีโต๊ะตามรายการที่เปิดให้บริการ · สล็อตมีเกมคลาสสิก ฟรีสปิน โบนัส
// ตัวคูณ · บอลเลือกคู่แข่งขันและตลาดเดิมพันตามช่วงเวลา · หวยแบ่งรอบเปิดรับตามประเภท ·
// กติกา ช่วงเดิมพัน เวลาเปิดรับต่างกัน · ตรวจราคา วงเงิน เวลาเปิด-ปิดก่อนยืนยัน ·
// คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · Login ตรวจโบนัส ยอดที่เข้าเกณฑ์ สถานะรับสิทธิ์ ·
// รอบตัดยอด · ช่องทางฝากถอนตามที่ระบบเปิดให้บริการ · ชื่อบัญชีปลายทาง · นิติบุคคล ·
// แอดมิน 24 ชั่วโมง · หลักฐานธุรกรรม · PIN รหัสผ่าน OTP
//
// ⚠️ คำที่ห้ามหลงเหลือ: คำขายของของแบรนด์ก่อนและศัพท์ที่บรีฟรอบนี้ไม่ได้เอ่ย —
// รายการเต็มอยู่ใน brand-spec §4 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำต้องห้าม
// เจอ false positive · หวยเป็นเพียง "หนึ่งหมวด" ที่บรีฟระบุ ไม่ใช่ธีมของเว็บ และ
// สองหน้าของหมวดนั้นจอดอยู่ใน src/pages-disabled/ จึงไม่มีปลายทางให้ลิงก์รอบนี้
//
// ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 100% · 24 ชั่วโมง
// ห้ามเติมเลขใบอนุญาต หน่วยงานกำกับ ชื่อผู้ให้บริการ ชื่อค่ายเกม ชื่อธนาคาร
// ค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีที่ก่อตั้ง เพราะบรีฟไม่ได้เอ่ยไว้สักอย่าง
//
// ประโยคกำกับที่บรีฟเขียนไว้เองและห้ามตัดทิ้งเพราะฟังดูไม่ขายของ: ข้อความ
// "เดิมพันตรงกับบริษัท 100%" ควรมีชื่อบริษัทหรือนิติบุคคลที่ตรวจสอบได้ · คำว่า
// "ฝากถอนได้ทุกช่องทาง" ควรหมายถึงช่องทางที่ระบบรองรับจริงในขณะทำรายการ ·
// ควรเปรียบเทียบชื่อบัญชีปลายทางกับข้อมูลจากช่องทางหลักก่อนทำรายการ ·
// ไม่ควรพิจารณาจากข้อความ "บริษัท 100%" เพียงอย่างเดียว
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็นแบรนด์ **ฮิวเดียว: ทองเมทัลลิกบนดำสนิท**
// พลิกจากชุดตรุษจีนสามสี (แดง-เขียวมรกต-ทอง) ของ GUCCI168 ซึ่งออกครบทุกจุดแล้ว
// ทั้งคลาส Tailwind raw hex และ rgba() (ค่าเดิมอยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive)
// ปุ่มหลัก (สมัครสมาชิก) ถมไล่ทอง #ffe79a → #fad354 → #ddab33 หมึก #0a0802
// (9.5:1 บน #ddab33 ซึ่งเป็นปลายเข้มสุด) ขอบทองลึก #8a6410 — ห้ามพลิกเป็นหมึกสว่าง
// ปุ่มรองและปุ่มลิงก์ภายในเป็นผิวการ์ด #17130a → #060402 ขอบทองแบรนด์ #fad354/60
// ตัวอักษรทองแชมเปญ #ffe79a (รอบนี้ไม่มีฮิวที่สอง ปุ่มรองจึงเป็น "ผิวการ์ด" ไม่ใช่สีอื่น)
// #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #f3e7cd)
// ไว้ที่ตัวการ์ดแล้ว ข้อความในหน้านี้จึงไม่ประกาศสีของตัวเองเลย ปล่อยให้สืบทอดลงมา
// — มีแค่ปุ่มที่ประกาศสีได้ เพราะปุ่มถมพื้นของตัวเองจึงต้องกำหนดหมึกของตัวเอง
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจาก
// หน้า และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น Announcement5 ทั้งเว็บ (รอบก่อน GUCCI168 ใช้ Announcement3
// — brand-spec §3 หมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ
// แบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูดคนละเรื่อง
// กับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 159 อักขระ
// (นับด้วย BRAND_NAME ยาว 10 ตัวอักษร ส่วนที่ไม่ใช่ชื่อแบรนด์ยาว 149 ตัว)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} คาสิโนฐานเข้าหลักที่รวมบาคาร่า รูเล็ต บอล หวย สล็อต ไว้ในบัญชีเดียว พร้อมโปรโมชั่นคืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% และแอดมิน 24 ชั่วโมง`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} คาสิโนฐานเข้าหลัก บาคาร่า รูเล็ต บอล หวย สล็อต`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong>{BRAND_NAME} คือคาสิโนฐานเข้าหลักที่รวมช่องทางเดิมพันหลายประเภทไว้ในระบบเดียว</strong>
        รองรับทั้งบาคาร่า รูเล็ต บอล หวย สล็อต และเกมคาสิโนตามรายการที่เปิดให้บริการ สมาชิกเลือกเกม ตรวจสอบเครดิต โปรโมชั่น และประวัติการเดิมพันผ่านบัญชีเดียวได้จากที่เดียวกัน โดยไม่ต้องเปิดบัญชีใหม่แยกตามประเภทเกม
      </p>

      <p>
        หน้านี้สรุปไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่การเลือกหมวดเกมและการเปิดโต๊ะ
        <strong>ไปจนถึงโปรโมชั่นคืนยอดเสียกับแนะนำเพื่อน ช่องทางฝากถอน และการติดต่อแอดมินที่ดูแลตลอด 24 ชั่วโมง</strong>
        เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดดูอะไรตรงไหน แล้วจึงค่อยลงรายละเอียดของเกมหรือแคมเปญที่สนใจเป็นรายรายการ
      </p>

      <p>
        <strong>ส่วนข้อความ เดิมพันตรงกับบริษัท 100% ควรมีชื่อบริษัทหรือนิติบุคคลที่สามารถตรวจสอบได้</strong>
        เพื่อยืนยันว่าข้อมูลบนเว็บไซต์สอดคล้องกับผู้ให้บริการจริง ข้อมูลในหน้านี้เขียนไว้เพื่อบอกว่าระบบมีอะไรให้ใช้และควรตรวจอะไรก่อนตัดสินใจ ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะทำรายการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`${BRAND_NAME} รวมบาคาร่า รูเล็ต บอล หวย สล็อต ไว้ในบัญชีเดียว`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} รวมเกมคาสิโนและการเดิมพันหลายแนวไว้ให้เลือก
        <strong>เลือกหมวดที่ต้องการแล้วเข้าเล่นต่อได้จากบัญชีเดิม</strong>
        แต่ละหมวดไม่ได้ทำงานเหมือนกันทั้งหมด จึงควรเปิดดูรายละเอียดก่อนเริ่มเดิมพัน เพื่อเลือกรายการที่ตรงกับงบและความสนใจได้ง่ายขึ้น สิ่งที่ต่างกันในแต่ละหมวดแบ่งออกได้ประมาณนี้
      </p>

      <ul class="flex flex-col gap-3" aria-label={`ความแตกต่างของแต่ละหมวดเกมบนเว็บ ${BRAND_NAME}`}>
        <li class="flex gap-3">
          <span aria-hidden="true">🃏</span>
          <span>
            <strong>บาคาร่าและรูเล็ต</strong> มีโต๊ะให้เลือกตามรายการที่เปิดให้บริการในแต่ละช่วง จำนวนโต๊ะและตลาดเดิมพันจึงเปลี่ยนแปลงได้ตามเวลา ควรดูรายการล่าสุดที่ระบบแสดงแทนการจำจากรอบก่อน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">🎰</span>
          <span>
            <strong>สล็อต</strong> มีทั้งเกมคลาสสิก ฟรีสปิน โบนัส และตัวคูณ ซึ่งแต่ละเกมเปิดฟีเจอร์ไว้ไม่เท่ากัน บางเกมมีครบ บางเกมมีเพียงบางอย่าง จึงควรอ่านรายละเอียดของเกมนั้นโดยตรง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">⚽</span>
          <span>
            <strong>บอล</strong> เลือกคู่แข่งขันและตลาดเดิมพันได้ตามช่วงเวลาที่ระบบเปิดรับ รายการที่ยังไม่เปิดหรือปิดรับไปแล้วจะไม่แสดงเป็นตัวเลือก จึงควรตรวจสถานะของรายการก่อนทุกครั้ง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">🎫</span>
          <span>
            <strong>หวย</strong> แบ่งรอบเปิดรับตามประเภทของรายการ เวลาเปิดและเวลาปิดรับจึงไม่ตรงกันทุกรายการ ควรดูรอบที่ระบบกำลังเปิดรับอยู่ก่อนยืนยันการเดิมพัน
          </span>
        </li>
      </ul>

      <p>
        <strong>เกมแต่ละประเภทมีกติกา ช่วงเดิมพัน และเวลาเปิดรับแตกต่างกัน โดยเฉพาะบอลและหวยที่อ้างอิงตามตารางของแต่ละรายการ</strong>
        ก่อนยืนยันการเดิมพันจึงควรตรวจสอบราคา วงเงิน เวลาเปิด-ปิด และรายละเอียดที่แสดงในระบบทุกครั้ง
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/ทดลองเล่น"
          aria-label={`เปิดหน้าทดลองเล่นของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#fad354]/60 bg-gradient-to-b from-[#17130a] to-[#060402] px-8 py-3 font-bold text-[#ffe79a] shadow-[0_0_12px_rgba(250,211,84,0.25)] transition-all hover:scale-105 hover:border-[#fad354] hover:shadow-[0_0_18px_rgba(255,231,154,0.40)]">
          ไปหน้าทดลองเล่น
        </a>

        <a
          href="/promotion"
          aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#fad354]/60 bg-gradient-to-b from-[#17130a] to-[#060402] px-8 py-3 font-bold text-[#ffe79a] shadow-[0_0_12px_rgba(250,211,84,0.25)] transition-all hover:scale-105 hover:border-[#fad354] hover:shadow-[0_0_18px_rgba(255,231,154,0.40)]">
          ดูภาพโปรโมชั่น
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`โปรโมชั่นของ ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        โปรโมชั่น {BRAND_NAME} มีสิทธิ์สำหรับสมาชิกตามแคมเปญที่เปิดในแต่ละช่วง
        <strong>สามารถ Login เพื่อตรวจสอบโบนัส ยอดที่เข้าเกณฑ์ และสถานะการรับสิทธิ์ได้จากบัญชี</strong>
        โดยกิจกรรมที่เว็บไซต์ระบุไว้มีสองรายการหลัก ซึ่งคำนวณจากยอดคนละชุดกัน และอาจมีรอบตัดยอดกับประเภทเกมที่ร่วมรายการไม่เหมือนกัน
      </p>

      <ul class="flex flex-col gap-3" aria-label={`กิจกรรมโบนัสของ ${BRAND_NAME}`}>
        <li class="flex gap-3">
          <span aria-hidden="true">💸</span>
          <span>
