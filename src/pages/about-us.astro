---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion,
// /login, /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์
// หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ (src/assets/content.txt) ไม่มี
// ส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่จากข้อเท็จจริงและคลังคำของบรีฟรอบนี้
// เท่านั้น (.claude/brand-spec-ruaythear168club.md §5)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x4 · h3x0
//   h1  เกี่ยวกับเรา <แบรนด์> เว็บสล็อตออนไลน์และข้อมูลที่หน้านี้รวบรวมไว้
//   h2  เกมสล็อตและระดับการเดิมพันที่ <แบรนด์> นำเสนอ
//   h2  โปรโมชั่นสมาชิก <แบรนด์> คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%
//   h2  สมัครเล่นเกมสล็อต <แบรนด์> ง่ายๆ 3 ขั้นตอน
//   h2  ช่องทางติดต่อแอดมิน <แบรนด์> ตลอด 24ชม.
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// (ขั้นตอนสมัครสามขั้นลงเป็น <ol> เพราะเป็นลำดับขั้น ไม่ใช่สามหัวข้อย่อยที่มี
// บทความของตัวเอง)
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) และจาก footer จึงเปิดใช้งานอยู่
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// เป็นของแบรนด์เก่ามาก ตัวที่ routing จริงคือไฟล์นี้ Astro ไม่อ่านโฟลเดอร์นั้นเลย
// **ห้ามแก้ ห้ามลบ และห้ามสลับมาแทนไฟล์นี้**
//
// 🚨 แกนของดรอปนี้ (2026-10-23) คือ **เว็บสล็อตออนไลน์** ที่เรียกตัวเองว่า
// "เกมสล็อตจ่ายแพง ปรับเรทแตกหนักที่สุดในวงการ" · เดิมพันไม่มีขั้นต่ำ ทุนน้อย
// เล่นได้ ไม่อั้นจ่าย ไม่อั้นถอน · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% ·
// สมัคร 3 ขั้นตอน · แอดมิน 24ชม.
// ⚠️⚠️ **แบรนด์ขาออกขายจุดยืนคนละแบบกับรอบนี้** คำขายของกลุ่มนั้นที่เคยอยู่ใน
// ไฟล์นี้จึงเป็นคำค้างของแบรนด์ขาออก **ไม่ใช่ของรอบนี้** (ทั้งคำกลุ่มจำนวนเกม
// คำกลุ่มสถานะของค่ายเกม และคำกลุ่มประเภทเกมที่บรีฟรอบนี้ไม่มีสักคำ) และรอบ
// ก่อนหน้านั้นเป็นเว็บลอตเตอรี — คำกลุ่มนั้นก็ห้ามหลงเหลือเช่นกัน
// **รายการคำต้องห้ามเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่** เพื่อไม่ให้ sweep
// ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// ⚠️⚠️ **ระวังชื่อใกล้เคียงของแบรนด์เก่าสามเจ้า** ที่สะกดคล้ายชื่อรอบนี้มาก —
// รายชื่ออยู่ใน brand-spec §0 รอบนี้สะกดได้แบบเดียวคือค่าใน BRAND_NAME เท่านั้น
// ⚠️ `ทดลองเล่น` เหลือรอดได้เฉพาะในฐานะ **ชื่อ route /ทดลองเล่น** ซึ่งเป็นหน้าที่มี
// อยู่จริงและอยู่ในเมนูนาวบาร์ — ห้ามใช้เป็นคำโฆษณาเกี่ยวกับตัวเกมของแบรนด์นี้
//
// ⚠️⚠️ **สองหน้าหมวดลอตเตอรีจอดอยู่ใน src/pages-disabled/ รอบนี้** → ลิงก์ไป
// สอง route นั้นจะทำให้ build แดง ห้ามเขียนกลับมา
// route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ทดลองเล่น · /about-us · /contact-us · /terms · /privacy · /line
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกม ชื่อธนาคาร ชื่อวอลเล็ต ชื่อผู้ให้บริการ
// หน่วยงานกำกับ ใบอนุญาต ปีก่อตั้ง จำนวนสมาชิก ค่า RTP เป็นตัวเลข หรือยอดฝาก
// ขั้นต่ำ แม้แต่รายการเดียว** จึงห้ามเขียนลงหน้าเว็บ · ตัวเลขที่ขึ้นหน้าได้มีแค่
// ของบรีฟเอง: **0.3% · 0.8% · 3 ขั้นตอน · 24ชม.**
//
// 🚨 **บรีฟรอบนี้โฆษณาแล้วเบรกตัวเองในย่อหน้าเดียวกันแทบทุกย่อหน้า** — ทั้งสอง
// ครึ่งต้อง ship ครบตามที่เขียน ประโยคเบรกไม่ใช่ filler ให้ตัดทิ้ง:
// 1) ผลลัพธ์ของเกมสล็อตมีความไม่แน่นอน และไม่มีเว็บไซต์ใดรับประกันการชนะใน
//    แต่ละรอบได้ (h1)
// 2) แม้ระบุว่าไม่อั้นจ่ายหรือไม่อั้นถอน ก็ไม่ควรสรุปว่าไม่มีเพดานธุรกรรมโดย
//    ไม่ตรวจสอบข้อกำหนดล่าสุด · ค่า RTP เป็นสถิติระยะยาว (h2 #1)
// 3) การคืนเครดิตไม่ได้แปลว่าจะได้เงินคืนจากทุกการเดิมพันหรือทำให้มีโอกาสชนะ
//    มากขึ้น · แม้ระบุว่ากดรับได้ไม่จำกัด ก็ควรตรวจสอบจำนวนครั้งที่รับสิทธิ์ได้
//    จริงจากประกาศล่าสุด (h2 #2)
// 4) ควรตรวจสอบคุณสมบัติผู้สมัคร ข้อกำหนดด้านอายุ และกฎหมายที่เกี่ยวข้อง ·
//    ไม่ควรใช้ข้อมูลของบุคคลอื่นหรือเปิดเผยรหัส OTP ให้ใครทราบ (h2 #3)
// 5) ควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยง
//    บัญชีแอบอ้าง · ควรตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุดอีกครั้ง (h2 #4)
//
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) เป็น **ธีมสว่าง กลับทิศจากรอบก่อน 180 องศา**
// bg.json ของดรอปนี้คือ {"mode":"color","color":"#dbe6ff"} = ฟ้าเพอริวิงเคิลอ่อน
// **ห้าม "แก้" กลับไปเป็นการ์ดพื้นเข้มเพราะรอบก่อนทำแบบนั้น**
// ค่าที่ใช้ได้ในไฟล์นี้: ฟ้าเข้ม #0d6b9b (หัวข้อ + <strong> + ตัวอักษรปุ่มรอง
// 5.6:1 บนผิวการ์ดขาว) · ฟ้าลึก #0a5176 (stop ล่างของปุ่มหลัก 8.0:1 กับหมึกขาว) ·
// ฟ้าไซยาน #18a5e2 (**2.6:1 บนผิวสว่าง — ห้ามถือตัวอักษร** เป็นขอบ/ออรา/ชิป) ·
// ฟ้าอ่อน #a9d7f2 (ขอบ **ห้ามถือตัวอักษร**) · ผิวกลาง #eef4ff และอินเซ็ต #dce9fb
// (พื้น) · ผิวขาว #ffffff (พื้น)
// หมึกเนื้อความคือ #16294a (= BRAND_TEXT) ซึ่ง **ไม่ประกาศในไฟล์นี้** การ์ด
// ContentBox ตั้งไว้ให้แล้วและย่อหน้าสืบทอดลงมา
// 🚨 **ห้ามใส่ตัวอักษรขาวบนพื้นถม #18a5e2** (2.6:1) และปุ่มหลักใช้หมึกขาวบนไล่เฉด
// #0d6b9b -> #0a5176 เสมอ
// ออราที่อนุญาต: rgba(24,165,226,α) · rgba(13,107,155,α) · rgba(244,228,211,α) ·
// rgba(22,41,74,α) · rgba(0,0,0,α)
// ⚠️ รอบนี้ **ไม่มีทอง/เหลือง ไม่มีน้ำตาล ไม่มีครีมเป็นสีตัวอักษร ไม่มีแดง
// ไม่มีชมพู ไม่มีม่วง ไม่มีส้ม และไม่มีแรมป์เทาเงิน** (เลข "168" ในโลโก้เป็นผิว
// โครเมียมก็จริง แต่โครมในฐานะสี UI เป็นของแบรนด์เก่า) ไม่มีเขียว ยกเว้น
// **LINE green #00B900** บนปุ่ม LINE ซึ่งเป็นสีประจำแพลตฟอร์ม ห้ามเปลี่ยน
// ⚠️⚠️ **ฟ้าเคยนำมาแล้วห้าแบรนด์ในรีโปนี้** การเจอฟ้าในไฟล์จึงไม่พิสูจน์อะไรเลย
// ห้ามเทียบด้วยวงศ์สี ต้องเทียบ **ทีละค่า** กับตาราง brand-spec §2
//
// ลำดับปุ่มในไฟล์นี้สื่อด้วยพื้นถมสามขั้ว:
// · ปุ่มหลัก (สมัครสมาชิก) ไล่เฉด #0d6b9b -> #0a5176 หมึก #ffffff
// · ปุ่มรอง (เข้าสู่ระบบ) ขอบ #0d6b9b ตัวอักษร #0d6b9b บนผิวขาว #ffffff
// · ปุ่มลิงก์ภายในเป็นผิวกลาง #eef4ff ขอบ #0d6b9b ตัวอักษร #0d6b9b
//   hover ยกขอบเป็นฟ้าไซยาน (ตรงกับ hover ของการ์ด ContentBox)
// · ชิปไอคอนของรายการใช้ฟ้าไซยานเป็น **เส้นขอบ** บนอินเซ็ต #dce9fb ไม่ถือตัวอักษร
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง และไม่ใส่ mx-auto / max-w-* บน <p>
// เพราะการ์ดคุมความกว้างเองแล้ว — ที่ประกาศสีได้มีแค่ปุ่ม ชิปไอคอน marker ของ
// ลำดับเลข และ <strong> · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง
// เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำ
// จะขาดครึ่ง (ลบแท็ก <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิม) และห้ามวาง
// <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังใน prop ที่เป็นข้อความ
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: ดรอปนี้ไม่มี article illustration เลย (banner2/
// banner3 เป็นอาร์ตเวิร์กของแบรนด์คนละราย เก่าทั้งคู่) ส่วน slide1/slide2 ถูกตรึง
// ไว้กับ index กับ /promotion และ banner1 / banner1-mobile / og.png เป็นของ glob
// ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า · slide3/slide4 เป็นโปสเตอร์ของอีกแบรนด์
// ห้าม import (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build
// จะแดง) — ไฟล์ยังอยู่บนดิสก์ ห้ามลบ
//
// Announcement รอบนี้หมุนมาเป็น Announcement5 ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ Announcement2 จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็น
// คอปปี้ของแบรนด์นี้แล้ว จึงเรียกแบบ bare **ห้ามส่ง prop message**
// มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 156 อักขระ (ชื่อแบรนด์รอบนี้ 9 ตัวอักษร) เป็นประโยคเดียวที่บอกว่า
// หน้านี้มีอะไร แล้วหยุด
// (Google ตัดราว 155 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} เว็บสล็อตออนไลน์ที่รวมข้อมูลระดับการเดิมพัน โปรโมชั่นคืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% ขั้นตอนสมัครสมาชิก และช่องทางติดต่อแอดมิน 24ชม.`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} เว็บสล็อตออนไลน์และข้อมูลที่หน้านี้รวบรวมไว้`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

// คลาสปุ่มสามขั้วของหน้านี้ ประกาศครั้งเดียวแล้วใช้ซ้ำ เพื่อไม่ให้สองปุ่มที่ทำ
// หน้าที่เดียวกันหลุดไปคนละเฉดตอนรีแบรนด์รอบหน้า
const ctaPrimary =
  "flex items-center justify-center rounded-lg border border-[#0a5176] bg-gradient-to-b from-[#0d6b9b] to-[#0a5176] px-8 py-3 font-black text-[#ffffff] shadow-[0_6px_18px_rgba(13,107,155,0.3)] transition-transform hover:scale-105";

const ctaSecondary =
  "flex items-center justify-center rounded-lg border-2 border-[#0d6b9b] bg-[#ffffff] px-8 py-3 font-bold text-[#0d6b9b] shadow-[0_4px_14px_rgba(22,41,74,0.12)] transition-all hover:scale-105 hover:bg-[#eef4ff]";

const ctaQuiet =
  "flex items-center justify-center rounded-lg border border-[#0d6b9b] bg-[#eef4ff] px-8 py-3 font-bold text-[#0d6b9b] shadow-[0_4px_14px_rgba(22,41,74,0.1)] transition-all hover:scale-105 hover:border-[#18a5e2] hover:shadow-[0_6px_18px_rgba(24,165,226,0.3)]";

const listChip = "mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#18a5e2]/60 bg-[#dce9fb] text-sm";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#0d6b9b]">{BRAND_NAME} นำเสนอเกมสล็อตออนไลน์หลายรูปแบบ พร้อมข้อมูลอัตราจ่าย ระดับการเดิมพัน และโปรโมชั่นสำหรับสมาชิก</strong>
        หน้านี้รวบรวมไว้ว่าเว็บไซต์ระบุอะไรไว้บ้าง เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดอ่านอะไรตรงไหน แล้วจึงค่อยไล่อ่านรายละเอียดของแต่ละหัวข้อเป็นรายข้อ
      </p>

      <p>
        สิ่งที่หน้านี้ทำได้คือชี้ว่าข้อมูลแต่ละชุดอยู่ตรงไหนและควรอ่านอะไรก่อน
        <strong class="text-[#0d6b9b]">ภายในเว็บไซต์มีรายละเอียดเกี่ยวกับการสมัครสมาชิก ช่องทางฝากถอน และการติดต่อเจ้าหน้าที่ให้ตรวจสอบก่อนใช้งาน</strong>
        ซึ่งแต่ละหัวข้อวางเงื่อนไขของตัวเองไว้คนละชุด จึงควรเปิดอ่านทีละหัวข้อแทนการเทียบจากหัวข้ออื่น
      </p>

      <p>
        <strong class="text-[#0d6b9b]">ส่วนคำกล่าวอ้างเรื่องการปรับเรทแตกหนักที่สุดควรพิจารณาจากข้อมูลที่ตรวจสอบได้</strong>
        เนื่องจากผลลัพธ์ของเกมสล็อตมีความไม่แน่นอน และไม่มีเว็บไซต์ใดสามารถรับประกันการชนะในแต่ละรอบได้ เนื้อหาในหน้านี้จึงเขียนไว้ประกอบการใช้งานเท่านั้น
        ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้บริการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`เกมสล็อตและระดับการเดิมพันที่ ${BRAND_NAME} นำเสนอ`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        {BRAND_NAME} นำเสนอข้อมูลเกมสล็อตที่มีระดับการเดิมพันแตกต่างกัน
        <strong class="text-[#0d6b9b]">รวมถึงเกมที่กำหนดเงินเดิมพันเริ่มต้นในระดับต่ำ ซึ่งเป็นที่มาของคำว่าเดิมพันไม่มีขั้นต่ำและทุนน้อยเล่นได้</strong>
        รายการด้านล่างคือชุดข้อมูลที่ควรไล่อ่านให้ครบก่อนเลือกเกม เพราะแต่ละเกมวางกติกาและตารางจ่ายรางวัลของตัวเองไว้ไม่เหมือนกัน
      </p>

      <ul class="flex flex-col gap-4" aria-label="ข้อมูลที่ควรตรวจสอบก่อนเลือกเกมสล็อต">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📘</span>
          <span>
            <strong class="text-[#0d6b9b]">กติกาของเกม</strong> เป็นชุดแรกที่ควรอ่าน เพราะเป็นตัวกำหนดว่าผลของแต่ละรอบนับอย่างไร และเงื่อนไขไหนที่ต้องเกิดขึ้นก่อนจึงจะมีผลรางวัล
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🧾</span>
          <span>
            <strong class="text-[#0d6b9b]">ตารางจ่ายรางวัล</strong> ระบุอัตราจ่ายของแต่ละเกมไว้เป็นรายรายการ จึงเป็นข้อมูลที่ตรงกว่าคำโฆษณาเรื่องอัตราจ่ายโดยรวม
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📊</span>
          <span>
            <strong class="text-[#0d6b9b]">ค่า RTP ที่ผู้พัฒนาเปิดเผย</strong> เป็นค่าทางสถิติระยะยาว ไม่ใช่การรับประกันผลของการเล่นแต่ละครั้ง และแต่ละเกมเปิดเผยไว้คนละค่า
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🏦</span>
          <span>
            <strong class="text-[#0d6b9b]">ยอดฝากขั้นต่ำและวงเงินถอน</strong> ควรตรวจสอบตามเงื่อนไขจริงก่อนทำรายการ เพราะแต่ละบริการอาจกำหนดข้อจำกัดแตกต่างกัน
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#0d6b9b]">แม้จะมีข้อความระบุว่าไม่อั้นจ่ายหรือไม่อั้นถอน ก็ไม่ควรสรุปว่าไม่มีเพดานธุรกรรมโดยไม่ตรวจสอบข้อกำหนดล่าสุด</strong>
        เพราะข้อกำหนดเหล่านี้ปรับเปลี่ยนได้ตามที่ผู้ให้บริการประกาศ และไม่ใช่สิ่งที่หน้านี้ยืนยันแทนได้
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/ทดลองเล่น" aria-label={`เปิดหน้าทดลองเล่นของ ${BRAND_NAME}`} class={ctaQuiet}> ไปหน้าทดลองเล่น </a>

        <a href="/ทางเข้า" aria-label={`เปิดหน้าทางเข้าของ ${BRAND_NAME}`} class={ctaQuiet}> ไปหน้าทางเข้า </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`โปรโมชั่นสมาชิก ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} นำเสนอข้อมูลโปรโมชั่นสำหรับสมาชิก โดยมีรายการ
        <strong class="text-[#0d6b9b]">คืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8%</strong>
        ซึ่งแต่ละโปรโมชั่นอาจกำหนดประเภทเกมที่เข้าร่วม ยอดที่นำมาคำนวณ และรอบเวลารับเครดิตแตกต่างกัน ก่อนเข้าร่วมจึงควรอ่านประกาศล่าสุดให้ครบถ้วน
      </p>

      <p>
        รายการคืนยอดเสียระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขรายวัน
        <strong class="text-[#0d6b9b]">สมาชิกควรตรวจสอบว่าเกมสล็อตประเภทใดเข้าร่วมรายการ มีรอบสรุปยอดเวลาใด และต้องกดรับเครดิตด้วยตนเองหรือระบบดำเนินการให้อัตโนมัติ</strong>
        รวมถึงศึกษาข้อกำหนดการใช้เครดิตและการถอนเงินให้ครบถ้วน เพราะยอดเสียบางรายการอาจไม่เข้าเกณฑ์รับสิทธิ์ ทั้งนี้
        การคืนเครดิตไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือทำให้มีโอกาสชนะมากขึ้น
      </p>

      <p>
        ส่วนรายการแนะนำเพื่อนระบุสิทธิ์ไว้สำหรับสมาชิกที่แนะนำผู้ใช้งานรายใหม่ โดยควรตรวจสอบวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และฐานยอดที่ใช้คำนวณโบนัสให้ชัดเจน
        <strong class="text-[#0d6b9b]">แม้จะมีข้อความว่าไม่จำกัด แต่ควรยืนยันจำนวนบัญชีที่เข้าร่วมได้ รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุด</strong>
        เพื่อป้องกันความเข้าใจคลาดเคลื่อนเกี่ยวกับจำนวนเครดิตที่มีสิทธิ์ได้รับ
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/promotion" aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`} class={ctaQuiet}> ดูภาพโปรโมชั่น </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`สมัครเล่นเกมสล็อต ${BRAND_NAME} ง่ายๆ 3 ขั้นตอน`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} มีช่องทางสำหรับผู้ที่ต้องการศึกษาวิธีสมัครสมาชิกและเข้าสู่ระบบเกมสล็อตออนไลน์
        <strong class="text-[#0d6b9b]">ก่อนดำเนินการควรตรวจสอบคุณสมบัติผู้สมัคร ข้อกำหนดด้านอายุ และกฎหมายที่เกี่ยวข้อง</strong>
        รวมถึงศึกษานโยบายความเป็นส่วนตัวเพื่อทำความเข้าใจวิธีจัดเก็บข้อมูลส่วนบุคคล ลำดับด้านล่างคือ 3 ขั้นตอนที่เว็บไซต์ระบุไว้
      </p>

      <ol class="ml-6 list-decimal space-y-3 marker:font-black marker:text-[#0d6b9b]">
        <li>
          <strong class="text-[#0d6b9b]">เข้าสู่หน้าสมัครสมาชิก</strong> ตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง จากนั้นเลือกเมนูสมัครสมาชิกและอ่านเงื่อนไขการเปิดบัญชี รวมถึงนโยบายการจัดเก็บข้อมูลส่วนบุคคลก่อนกรอกข้อมูล
        </li>
        <li>
          <strong class="text-[#0d6b9b]">กรอกข้อมูลและยืนยันบัญชี</strong> กรอกข้อมูลตามที่ระบบกำหนด ตรวจสอบความถูกต้องก่อนยืนยัน และตั้งรหัสผ่านที่คาดเดาได้ยาก ไม่ควรใช้ข้อมูลของบุคคลอื่นหรือเปิดเผยรหัส
          OTP ให้ใครทราบ
        </li>
        <li>
          <strong class="text-[#0d6b9b]">เข้าสู่ระบบและตรวจสอบรายละเอียดเกม</strong> หลังลงทะเบียนเรียบร้อย สามารถศึกษารายชื่อเกมสล็อต กติกาการเล่น ยอดเดิมพันขั้นต่ำ และรายละเอียดโปรโมชั่นที่เปิดให้บริการ
          หากมีข้อสงสัยควรสอบถามเจ้าหน้าที่ผ่านช่องทางทางการก่อนทำรายการ
        </li>
      </ol>

      <p>
        <strong class="text-[#0d6b9b]">ส่วนข้อกำหนดและข้อจำกัดของการเปิดบัญชี ควรตรวจสอบจากประกาศล่าสุดของเว็บไซต์โดยตรง</strong>
        เพราะเป็นเงื่อนไขที่ปรับเปลี่ยนได้ตามที่ผู้ให้บริการกำหนด และไม่ใช่สิ่งที่หน้านี้ยืนยันแทนได้
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/register" aria-label={`สมัครสมาชิก ${BRAND_NAME}`} class={ctaPrimary}> สมัครสมาชิก </a>

        <a href="/login" aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`} class={ctaSecondary}> เข้าสู่ระบบ </a>
      </div>
    </div>
  </ContentBox>

