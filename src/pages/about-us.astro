---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";

// KINDEE365 เป็นเว็บหวย/ลอตเตอรี่ออนไลน์ ไม่ใช่คาสิโน เนื้อหาทั้งหน้าจึงพูดเรื่อง
// หวย 4 ประเภท (รัฐบาลไทย / ลาวพัฒนา / ฮานอย / หุ้นต่างประเทศ) เรท 3 ตัวบาทละ 1,000
// และ 2 ตัวบาทละ 100 ระบบฝากถอนออโต้ธนาคาร/วอลเลท การส่งโพยและดูประวัติรายการเอง
// และเจ้าหน้าที่ 24 ชั่วโมง — ทุกข้อความอ้างอิง src/assets/content.txt เท่านั้น
// ไม่มีการอ้างใบอนุญาต การจดทะเบียนบริษัท ปีที่ก่อตั้ง จำนวนสมาชิก หรือการันตีผลกำไร
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 160
const pageDescription =
  "KINDEE365 เว็บหวยลอตเตอรี่ออนไลน์ เปิดรับหวยรัฐบาลไทย ลาวพัฒนา ฮานอย และหุ้นต่างประเทศ เรท 3 ตัวบาทละ 1,000 และ 2 ตัวบาทละ 100 ฝากถอนออโต้ ทีมงานดูแล 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ KINDEE365 เว็บหวยลอตเตอรี่ออนไลน์",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา KINDEE365 เว็บหวยลอตเตอรี่ออนไลน์ มีครบทุกเลข รับทุกเลข" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ KINDEE365 เว็บหวยลอตเตอรี่ออนไลน์" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#cfe3f7]">
        <strong class="text-[#e8bb4a]">KINDEE365</strong> เปิดบริการสำหรับผู้ที่ต้องการ<strong class="text-[#a3dbfb]">แทงหวยออนไลน์ผ่านระบบที่ใช้งานง่าย</strong>
        ทั้งบนมือถือและคอมพิวเตอร์ โดยรวมหวยหลายประเภทไว้ในบัญชีเดียว สมาชิกเลือกประเภทหวย เลขที่ต้องการ
        และจำนวนเงินเดิมพันได้จากระบบโดยตรง แล้วยืนยันโพยด้วยตัวเองโดยไม่ต้องผ่านคนกลาง
      </p>

      <p class="text-left text-base leading-relaxed text-[#cfe3f7]">
        แนวคิดของเว็บคือทำให้ทุกขั้นตอนตรวจสอบได้ก่อนกดยืนยัน ทั้งเวลาเปิด-ปิดของรอบ อัตราจ่าย เลขอั้น และวงเงินของรอบนั้น
        ควบคู่กับ<strong class="text-[#a3dbfb]">ระบบฝากถอนออโต้และประวัติรายการที่ย้อนกลับมาดูได้เสมอ</strong>
        พร้อมเจ้าหน้าที่คอยรับเรื่องและช่วยตรวจสอบปัญหาตลอด 24 ชั่วโมง
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="หวยที่ KINDEE365 เปิดรับ รัฐบาลไทย ลาวพัฒนา ฮานอย และหุ้นต่างประเทศ" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#cfe3f7]">
        KINDEE365 จัดหมวดหวยออนไลน์ไว้ให้เลือกตามรอบที่เปิดบริการ สมาชิกดูเรทของแต่ละประเภท ส่งโพย
        และ<strong class="text-[#a3dbfb]">ตรวจสอบประวัติรายการย้อนหลังได้จากบัญชีของตนเอง</strong>
        โดยแต่ละประเภทมีเวลาเปิด-ปิดรับและเงื่อนไขต่างกัน จึงควรอ่านรายละเอียดของรอบนั้นให้ครบก่อนยืนยันโพย
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#cfe3f7]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e8bb4a]">🇹🇭</span>
          <span><strong class="text-[#a3dbfb]">หวยรัฐบาลไทย</strong> เปิดรับตามรอบการออกรางวัลที่ระบบกำหนด ควรตรวจเวลาปิดรับของรอบนั้นก่อนส่งโพย</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e8bb4a]">🎫</span>
          <span><strong class="text-[#a3dbfb]">หวยลาวพัฒนา</strong> เปิดตามรอบที่ให้บริการ เวลาเปิด-ปิดรับและเงื่อนไขของรอบแสดงอยู่ในระบบ</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e8bb4a]">🕐</span>
          <span><strong class="text-[#a3dbfb]">หวยฮานอย</strong> มีหลายรอบต่อวันตามที่เปิดบริการ ตรวจสอบรอบที่ต้องการก่อนเลือกเลขและจำนวนเงิน</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e8bb4a]">📈</span>
          <span><strong class="text-[#a3dbfb]">หวยหุ้นต่างประเทศ</strong> อ้างอิงรอบตลาดที่ระบบเปิดรับ จึงมีช่วงเวลาปิดรับต่างจากหวยประเภทอื่น</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#8fb3d9]">
        สำหรับข้อความว่า “รับทุกเลข” หรือ “จ่ายไม่อั้น” ควรยึดวงเงินและเงื่อนไขที่ระบบแสดง ณ เวลาส่งโพยเป็นหลัก
        เนื่องจากบางเลขหรือบางรอบอาจมีข้อกำหนดเฉพาะ
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="อัตราจ่ายของ KINDEE365 เลข 3 ตัวบาทละ 1,000 เลข 2 ตัวบาทละ 100" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#cfe3f7]">
        KINDEE365 กำหนดอัตราจ่ายสำหรับหน้านี้ไว้ที่ <strong class="text-[#e8bb4a]">เลข 3 ตัว บาทละ 1,000</strong>
        และ <strong class="text-[#e8bb4a]">เลข 2 ตัว บาทละ 100</strong> เพื่อให้สมาชิกเห็นเรทและคำนวณยอดเบื้องต้นได้ก่อนส่งโพย
        เช่น แทงเลข 3 ตัว 10 บาทและเรทในรอบนั้นยังอยู่ที่ 1,000 ยอดตามเรทจะเท่ากับ 10 × 1,000 = 10,000 บาท
      </p>

      <p class="text-left text-base leading-relaxed text-[#8fb3d9]">
        ตัวเลขข้างต้นเป็นเรทที่ระบุไว้สำหรับหน้านี้ ควรตรวจสอบอัตราจ่ายที่แสดงจริงในระบบก่อนยืนยันทุกครั้ง
        เพราะประเภทหวยหรือรอบเดิมพันอาจมีเงื่อนไขแตกต่างกัน
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ฝากถอนระบบออโต้ของ KINDEE365 ผ่านธนาคารและวอลเลท" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#cfe3f7]">
        สมาชิกจัดการเครดิตผ่านระบบฝากถอนออโต้ของ KINDEE365 ได้เอง โดย<strong class="text-[#a3dbfb]">เลือกใช้ธนาคารหรือวอลเลทตามช่องทางที่เว็บไซต์เปิดรองรับ</strong>
        ทั้งการฝากเครดิต ส่งคำขอถอน และตรวจสอบสถานะรายการผ่านบัญชีของตนเองโดยตรง
        ก่อนทำธุรกรรมควรตรวจสอบชื่อบัญชี จำนวนเงิน ยอดขั้นต่ำ และวงเงินต่อรายการให้ถูกต้องทุกครั้ง
      </p>

      <p class="text-left text-base leading-relaxed text-[#cfe3f7]">
        หากเครดิตไม่เข้า รายการถอนค้าง หรือสถานะธุรกรรมไม่อัปเดต
        ควร<strong class="text-[#a3dbfb]">เก็บข้อมูลและหลักฐานรายการไว้เพื่อใช้ประกอบการตรวจสอบกับเจ้าหน้าที่</strong>
        จนกว่าการตรวจสอบจะเสร็จสิ้น
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="เจ้าหน้าที่ KINDEE365 รับเรื่องออนไลน์ตลอด 24 ชั่วโมง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#cfe3f7]">
        หากพบปัญหาเกี่ยวกับการสมัครสมาชิก Login ส่งโพย ฝากเงิน ถอนเงิน หรือข้อมูลในบัญชีไม่ตรง สามารถ
        <strong class="text-[#a3dbfb]">ติดต่อเจ้าหน้าที่ KINDEE365 ได้ตลอด 24 ชั่วโมง</strong>
        พร้อมแจ้งเวลา จำนวนเงิน ประเภทหวย และรายละเอียดของรายการ เพื่อให้ทีมงานช่วยตรวจสอบได้ตรงจุด
      </p>

      <p class="text-left text-base leading-relaxed text-[#cfe3f7]">
        สมาชิกใหม่ยังสอบถามเรื่องอัตราจ่าย รอบหวย วิธีส่งโพย หรือขั้นตอนการฝากถอนก่อนเริ่มใช้งานจริงได้
        โดย<strong class="text-[#a3dbfb]">ไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น</strong>
      </p>

      <p class="text-left text-base leading-relaxed text-[#8fb3d9]">
        การเดิมพันมีความเสี่ยงและผลของแต่ละรอบไม่แน่นอน ไม่มีเลขหรือรูปแบบใดรับประกันผลล่วงหน้า
        สมาชิกจึงควรกำหนดงบประมาณก่อนเริ่มเดิมพันทุกครั้ง
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก KINDEE365"
          class="flex items-center justify-center rounded-lg border border-[#e8bb4a]/60 bg-gradient-to-r from-[#f8dc8c] via-[#e8bb4a] to-[#b98213] px-8 py-3 font-black text-[#010b26] shadow-[0_0_15px_rgba(232,187,74,0.30)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ KINDEE365"
          class="flex items-center justify-center rounded-lg border border-[#2b8ae9]/60 bg-transparent px-8 py-3 font-bold text-[#a3dbfb] transition-all hover:scale-105 hover:border-[#e8bb4a] hover:bg-[#083163]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
