---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion,
// /login, /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์
// หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา
// ทั้งหน้าจึงเขียนขึ้นใหม่บนข้อเท็จจริงของ หวยดีใจ เท่านั้น (src/assets/content.txt)
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก NavbarStyle8 (เกี่ยวกับเรา) จึงเปิดใช้งานอยู่
//
// ดรอปนี้ (2026-10-04) คือ หวยดีใจ **เว็บรับแทงหวยออนไลน์** ไม่ใช่คาสิโน/สล็อต
// แง่มุมที่บรีฟระบุไว้มีเท่านี้: รวมรายการยอดนิยมและแนวทางตัวเลขไว้ให้ติดตามก่อน
// หวยออก ทั้งรัฐบาลไทย หวยลาว หวยฮานอย หวยออมสิน และหวย ธ.ก.ส. · เลือกเลข
// ตรวจสอบรอบ อัตราจ่าย และส่งโพยผ่านมือถือจากบัญชีเดียว · ตรวจเวลาเปิดรับ เวลา
// ปิดรับ เลข และยอดเดิมพันก่อนส่งโพย · อัตราของรายการที่เข้าเงื่อนไข 2 ตัว จ่าย
// 100 บาท และ 3 ตัว จ่าย 1,000 บาท · เลข 3 ตัวมีหลายรูปแบบและไม่ได้ใช้อัตรา
// เดียวกันเสมอ · สมัคร 3 ขั้นตอน (กรอกข้อมูล → ยืนยันและ Login → เลือกหวย รอบ
// เลข แล้วตรวจอัตราจ่ายก่อนส่งโพย) · ประวัติรายการ · ผลรางวัล · แอดมิน 24 ชั่วโมง ·
// ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP
//
// ⚠️ แบรนด์ก่อนหน้าของหน้านี้คือ หวย24 (เว็บหวยอีกเจ้าที่ไม่เกี่ยวกัน) เขียนบน
// บรีฟคนละฉบับ ข้อขายของมันไม่มีในบรีฟรอบนี้ จึงห้ามหลงเหลือ: "เลขดัง" ·
// "รับไม่อั้น" · "จ่ายเต็มทุกโพย" · การถกว่า "เรทจ่ายสูงที่สุด" เหมาะหรือไม่ ·
// "วงเงินรับแทง" แบบที่บรีฟเก่าใช้ (รอบนี้บรีฟเขียนว่า "วงเงินที่ระบบเปิดรับ")
// ก่อนหน้านั้นหน้านี้เคยเป็นคาสิโน คำชุดนั้นยิ่งห้ามโผล่: สล็อต บาคาร่า บอล
// ค่ายเกม คาสิโนสด RTP คืนยอดเสีย เว็บตรง — เขียนใหม่จากบรีฟ ไม่ใช่ find-replace
//
// ตัวเลขที่อ้างได้มีแค่ 2 ตัว / 3 ตัว / 100 / 1,000 / 3 ขั้นตอน / 24 ชั่วโมง
// รายการหวยที่เอ่ยได้มีห้าชื่อ: รัฐบาลไทย · หวยลาว · หวยฮานอย · หวยออมสิน ·
// หวย ธ.ก.ส. ห้ามเติมตลาดอื่น (หวยหุ้น ยี่กี ลาวพัฒนา) ห้ามแต่งเวลาเปิด-ปิดรับ
// เป็นตัวเลข ชื่อธนาคาร เลขใบอนุญาต หน่วยงานกำกับ ยอดฝากขั้นต่ำ จำนวนสมาชิก
// หรือปีที่ก่อตั้ง เพราะบรีฟไม่ได้เอ่ยไว้สักอย่าง
//
// ประโยคกำกับที่บรีฟเขียนไว้เองและห้ามตัดทิ้งเพราะฟังดูไม่ขายของ: แนวทางและ
// สถิติย้อนหลังเป็นข้อมูลประกอบ ไม่การันตีเลขเข้าทุกงวดและไม่รับประกันผลล่วงหน้า ·
// "ไม่อั้นจ่าย" ไม่ได้แปลว่าทุกเลขหรือทุกรอบไม่มีวงเงินสูงสุด ให้ยึดหน้าส่งโพย ·
// "ไม่มีลบโพย" หมายถึงโพยที่ระบบรับและยืนยันสมบูรณ์ตามเงื่อนไขที่ประกาศไว้ ·
// อัตรา 2ตัว100 / 3ตัว1,000 ใช้กับรายการที่เข้าเงื่อนไข ไม่ใช่ทุกหวย
//
// พาเลตต์ หวยดีใจ (brand-spec §2) **แดงแบรนด์ + เงินโครเมียม บนดำอมแดง ทองเป็น
// สีรอง** — โลโก้คือคำว่า "หวย" สีโครเมียม + "ดีใจ" สีแดง + มงกุฎทอง: แดงแบรนด์
// #dc0409 (ไล่เฉดปุ่มหลัก) · แดงสว่าง #f5363d (hover, marker) · แดงเข้ม #8e0206
// (ขอบและปลายไล่เฉดปุ่มหลัก) · เงินสว่าง #eef0f4 (หมึกบนปุ่ม) · เงินกลาง #c3c7d1
// (ขอบปุ่มรอง ไอคอน) · ทอง #f3c54e (หมึก strong ทั้งหน้า + hover ปุ่มรอง) ·
// พื้นลึกสุด #0d0407 (ปุ่มรอง) · พื้นยก #211016 (hover ปุ่มรอง)
// ชุดแดง+ทองของ หวย24 (#d20a0a #f5c33b #ffd45e #a9761a #f7e2d6 #0a0303 #1a0303
// #2a0606 #7a0505 #ff5c5c rgba(210,10,10,*) rgba(245,195,59,*)) ออกครบทุกจุดแล้ว
// #00B900/#009900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// — การ์ดตั้ง text-left text-base leading-relaxed text-[#edeaf0] ไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าจึงไม่ถือคลาสสีของตัวเอง ใส่สีเฉพาะที่ <strong>
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจาก
// หน้า และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น Announcement5 ทั้งเว็บ (รอบก่อน หวย24 ใช้ Announcement3)
// — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ หวยดีใจ แล้ว จึงเรียก
// แบบ bare ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 156 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} เว็บรับแทงหวยออนไลน์ รวมรายการรัฐบาลไทย หวยลาว หวยฮานอย หวยออมสิน หวย ธ.ก.ส. อัตราจ่าย 2 ตัว 3 ตัว สมัคร 3 ขั้นตอน และแอดมิน 24 ชั่วโมง`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} เว็บรับแทงหวยออนไลน์ รัฐบาลไทย ลาว ฮานอย ออมสิน ธ.ก.ส.`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#f3c54e]">{BRAND_NAME} คือเว็บรับแทงหวยออนไลน์ที่รวมรายการยอดนิยมและแนวทางตัวเลขไว้ให้ติดตามก่อนหวยออก</strong>
        มีทั้งรัฐบาลไทยตามกำหนดออกรางวัล หวยลาว หวยฮานอย รวมถึงหวยออมสินและหวย ธ.ก.ส. ตามรายการที่เปิดให้บริการ สมาชิกเลือกเลข ตรวจสอบรอบ อัตราจ่าย และส่งโพยผ่านมือถือได้จากบัญชีเดียว
      </p>

      <p>
        หน้านี้สรุปไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่รายการหวยและรอบที่ระบบเปิดรับ
        <strong class="text-[#f3c54e]">ไปจนถึงอัตราจ่ายของเลข 2 ตัวและเลข 3 ตัว การสมัครบนมือถือแบบ 3 ขั้นตอน และช่องทางติดต่อแอดมินที่ดูแลตลอด 24 ชั่วโมง</strong>
        พร้อมแนวทางและสถิติย้อนหลังให้เปิดดูประกอบการเลือกเลขในแต่ละรอบ ก่อนจะนำเลขที่สนใจไปตรวจสอบรายละเอียดของรายการนั้นแล้วส่งโพย
      </p>

      <p>
        สิ่งที่ควรอ่านไปพร้อมกันคือข้อจำกัดของข้อมูลชุดนี้
        <strong class="text-[#f3c54e]">แนวทางหวยเป็นข้อมูลประกอบเท่านั้น ไม่สามารถการันตีว่าเลขจะเข้าทุกงวดหรือรับประกันผลรางวัลล่วงหน้าได้</strong>
        ข้อมูลในหน้านี้จึงเขียนไว้เพื่อบอกว่าระบบมีอะไรให้ใช้และควรตรวจอะไรก่อนส่งโพย ไม่ได้ใช้แทนการอ่านเวลาเปิดรับ เวลาปิดรับ อัตราจ่าย และวงเงินที่ระบบเปิดรับซึ่งแสดงอยู่ตรงหน้า
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`รายการหวยและอัตราจ่ายที่ ${BRAND_NAME} เปิดให้ส่งโพย`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        เว็บ {BRAND_NAME} รวบรวมหวยหลายประเภทไว้ให้เลือกตามรอบ และเปิดรับตัวเลขตามรายการที่ระบบกำหนด ไม่ว่าจะเป็นเลขที่เลือกเองหรือเลขเด็ดที่ได้จากแนวทาง
        <strong class="text-[#f3c54e]">สมาชิกตรวจสอบเวลาเปิดรับ เวลาปิดรับ เลขที่ต้องการ และยอดเดิมพันได้ก่อนส่งโพย</strong>
        ช่วยให้ติดตามหลายรายการได้โดยไม่ต้องเปลี่ยนบัญชีไปมา อัตราของรายการที่เข้าเงื่อนไขแบ่งออกได้ประมาณนี้
      </p>

      <ul class="flex flex-col gap-3" aria-label={`อัตราจ่ายและรายการหวยที่ ${BRAND_NAME} เปิดรับ`}>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#c3c7d1]">🔢</span>
          <span>
            <strong class="text-[#f3c54e]">เลข 2 ตัว จ่าย 100 บาท</strong> สำหรับรายการที่กำหนดอัตรานี้ เลือกเลขและจำนวนเงินได้ตามวงเงินที่ระบบเปิดรับ ก่อนกดยืนยันควรตรวจสอบเลขทั้งสองหลัก ประเภทหวย รอบเวลา
            และอัตราจ่ายอีกครั้ง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#c3c7d1]">🎯</span>
          <span>
            <strong class="text-[#f3c54e]">เลข 3 ตัว จ่าย 1,000 บาท</strong> ควรตรวจสอบรูปแบบเลข 3 ตัวและเรทที่ระบบแสดงก่อนส่งโพย เนื่องจากการเดิมพันเลข 3 ตัวมีได้หลายประเภทและไม่ได้หมายความว่าทุกรายการจะใช้อัตราเดียวกัน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#c3c7d1]">🧾</span>
          <span>
            <strong class="text-[#f3c54e]">รัฐบาลไทย หวยลาว หวยฮานอย หวยออมสิน และหวย ธ.ก.ส.</strong> แต่ละรายการอาจมีรายละเอียดของรอบแตกต่างกัน จึงควรเปิดอ่านรอบของรายการที่ต้องการก่อนส่งโพย เพื่อให้ทราบว่าเลขและรูปแบบที่เลือกใช้อัตราใด
          </span>
        </li>
      </ul>

      <p>
        หากเป็นเลขเด็ดหรือเลขที่มีผู้เลือกจำนวนมาก ควรตรวจสอบวงเงินที่ระบบเปิดรับก่อนยืนยัน เพราะ
        <strong class="text-[#f3c54e]">คำว่าไม่อั้นจ่ายไม่ได้หมายความว่าทุกเลขหรือทุกรอบจะไม่มีวงเงินสูงสุด</strong>
        เงื่อนไขจริงควรยึดข้อมูลที่แสดงบนหน้าส่งโพยเป็นหลัก และควรยึดอัตราล่าสุดที่ระบบแสดงมากกว่าตัวเลขที่จำไว้จากรอบก่อน
      </p>

      <p>
        ในทางเดียวกัน
        <strong class="text-[#f3c54e]">คำว่าไม่มีลบโพยควรหมายถึงโพยที่ระบบรับและยืนยันอย่างสมบูรณ์ตามเงื่อนไขแล้ว</strong>
        ทั้งนี้กรณีรายการผิดพลาด เป็นโมฆะ หรือเหตุอื่นควรเป็นไปตามข้อกำหนดที่เว็บไซต์ประกาศไว้อย่างชัดเจน และเมื่อโพยได้รับการยืนยันแล้วควรมีประวัติรายการให้กลับมาตรวจสอบได้
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/promotion"
          aria-label={`ดูภาพอัตราการจ่ายของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#c3c7d1]/45 bg-[#0d0407] px-8 py-3 font-bold text-[#eef0f4] transition-all hover:scale-105 hover:border-[#f5363d] hover:bg-[#211016] hover:text-[#f3c54e]">
          ดูภาพอัตราการจ่าย
        </a>

        <a
          href="/แนวทาง"
          aria-label={`อ่านแนวทางหวยของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#c3c7d1]/45 bg-[#0d0407] px-8 py-3 font-bold text-[#eef0f4] transition-all hover:scale-105 hover:border-[#f5363d] hover:bg-[#211016] hover:text-[#f3c54e]">
          อ่านแนวทางหวย
        </a>

        <a
          href="/ทดลองเล่น"
          aria-label={`เปิดหน้าทดลองเล่นของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#c3c7d1]/45 bg-[#0d0407] px-8 py-3 font-bold text-[#eef0f4] transition-all hover:scale-105 hover:border-[#f5363d] hover:bg-[#211016] hover:text-[#f3c54e]">
          ไปหน้าทดลองเล่น
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`สมัคร ${BRAND_NAME} 3 ขั้นตอน แล้วใช้บัญชีเดียวติดตามผลหวยและประวัติรายการ`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#f3c54e]">การสมัคร {BRAND_NAME} สามารถทำผ่านมือถือได้ใน 3 ขั้นตอน</strong>
