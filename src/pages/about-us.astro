---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char, so a byte count reads
// ~3x too long). One string, reused by MainLayout's meta and the WebPage node.
const pageDescription =
  "รู้จัก AKA99 สล็อตเว็บตรงค่ายใหญ่ เซิร์ฟนอก เจ้าของแท้ ไม่ผ่านเอเยนต์ รวมเกมสล็อต PGSOFT ไว้ในบัญชีเดียว พร้อมโบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ AKA99 สล็อตเว็บตรงค่ายใหญ่ เซิร์ฟนอก เจ้าของแท้",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา AKA99 สล็อตเว็บตรงค่ายใหญ่ เซิร์ฟนอก เจ้าของแท้" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ AKA99" as="h1">
    <p class="mb-6 text-left text-base leading-relaxed text-[#cfdcea]">
      <strong class="text-[#9dd2fa]">AKA99</strong> คือ <strong class="text-[#9dd2fa]">สล็อตเว็บตรงค่ายใหญ่ เซิร์ฟนอก เจ้าของแท้ ไม่ผ่านเอเยนต์</strong>
      ให้บริการสมาชิกที่ต้องการเล่นสล็อตออนไลน์ผ่านมือถือและคอมพิวเตอร์ โดยรวบรวมเกมสล็อตจากค่าย PGSOFT ไว้ในระบบเดียว ทั้งเกมยอดนิยม เกมใหม่
      เกมโบนัส และสล็อตแจ็คพอต พร้อมโปรโมชั่นสำหรับสมาชิกทั้งโบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไขที่กำหนด และระบบฝากถอนอัตโนมัติที่ทำรายการได้สะดวกตลอด 24 ชั่วโมง
    </p>

    <p class="mb-2 text-left text-base leading-relaxed text-[#cfdcea]">
      สิ่งที่ AKA99 ให้ความสำคัญคือความชัดเจนของข้อมูล ทั้งเปอร์เซ็นต์โบนัส วิธีคำนวณ รอบการรับสิทธิ์ และเงื่อนไขการถอน จะแสดงอยู่ในหน้ารายละเอียดโปรโมชั่นก่อนเข้าร่วมเสมอ
      สมาชิกควรอ่านเงื่อนไขตรงจุดนั้นทุกครั้ง เพราะข้อกำหนดของแต่ละรายการไม่เท่ากัน และมีแอดมินคอยดูแลตั้งแต่การสมัคร การรับโบนัส ฝากถอน ไปจนถึงการแก้ไขปัญหาระหว่างใช้งาน
    </p>
  </ContentBox>

  <ContentBoxPlain title="เกมสล็อต AKA99 ค่าย PGSOFT เลือกเล่นได้ครบในบัญชีเดียว" as="h2">
    <p class="mb-2 text-left text-base leading-relaxed text-[#cfdcea]">
      สมาชิกสามารถเข้าเล่นสล็อต AKA99 ผ่านระบบที่รองรับทั้งสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ ภายในมีเกมให้เลือกหลายหมวดหมู่ ทั้ง
      <strong class="text-[#9dd2fa]">เกมยอดนิยม เกมใหม่ เกมโบนัส และสล็อตแจ็คพอตจากค่าย PGSOFT</strong> พร้อมจัดหมวดหมู่ให้ค้นหาได้ง่ายผ่านบัญชีเดียว
      สำหรับรูปแบบเกม อัตราเดิมพัน ฟีเจอร์ และเงื่อนไขของแต่ละเกมอาจแตกต่างกัน สมาชิกจึงควรตรวจสอบรายละเอียดที่แสดงในระบบก่อนยืนยันการเดิมพันทุกครั้ง
    </p>
  </ContentBoxPlain>

  <ContentBoxPlain title="โปรโมชั่น AKA99 คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%" as="h2">
    <p class="mb-2 text-left text-base leading-relaxed text-[#cfdcea]">
      AKA99 มีโปรโมชั่นสำหรับสมาชิกที่เข้าเงื่อนไข โดยสามารถ Login เพื่อตรวจสอบสิทธิ์และกดรับโบนัสผ่านบัญชีของตนเอง โปรโมชั่นแต่ละรายการจะแสดงรายละเอียดเกี่ยวกับ
      <strong class="text-[#9dd2fa]">เปอร์เซ็นต์ วิธีคำนวณ รอบรับโบนัส และข้อกำหนดที่เกี่ยวข้อง</strong> เพื่อให้สมาชิกตรวจสอบรายละเอียดล่าสุดก่อนกดรับสิทธิ์
    </p>

    <p class="mt-3 mb-2 text-left text-base leading-relaxed text-[#cfdcea]">
      สำหรับ <strong class="text-[#9dd2fa]">โบนัสคืนยอดเสีย 0.3%</strong> สมาชิกที่มียอดเสียตรงตามข้อกำหนดสามารถตรวจสอบสิทธิ์ตามรอบที่กำหนด ระบบจะแสดงยอดที่ใช้คำนวณและสิทธิ์ที่กดรับได้
      ควรตรวจสอบประเภทเกมที่ร่วมรายการ รอบคำนวณ และเงื่อนไขการถอนให้ครบถ้วน ส่วน
      <strong class="text-[#9dd2fa]">โบนัสแนะนำเพื่อน 0.8%</strong> เปิดให้สมาชิกนำลิงก์แนะนำของตนเองไปแชร์ให้เพื่อน เมื่อเพื่อนสมัครและมียอดตรงตามเงื่อนไข ระบบจะคำนวณโบนัสให้ตามข้อกำหนด พร้อมติดตามข้อมูลการแนะนำและตรวจสอบโบนัสผ่านบัญชีสมาชิกได้
    </p>
  </ContentBoxPlain>

  <ContentBoxPlain title="ฝากถอนอัตโนมัติ และแอดมิน AKA99 ดูแลผ่าน LINE Official ตลอด 24 ชั่วโมง" as="h2">
    <p class="mb-6 text-left text-base leading-relaxed text-[#cfdcea]">
      <strong class="text-[#9dd2fa]">ระบบ AKA99</strong> ออกแบบให้สมาชิกจัดการบัญชีและธุรกรรมผ่านหน้าเว็บไซต์ได้ด้วยตนเอง ทั้ง Login ตรวจสอบเครดิต
      ฝากถอนผ่านระบบอัตโนมัติ และเลือกหมวดหมู่เกมสล็อตได้ตลอด 24 ชั่วโมง หน้าเว็บไซต์รองรับทั้ง Android, iOS แท็บเล็ต และคอมพิวเตอร์ เข้าใช้งานผ่านเว็บเบราว์เซอร์ได้โดยตรง
      หากพบปัญหาเกี่ยวกับการสมัครสมาชิก การ Login เครดิตไม่เข้า ฝากถอนล่าช้า โบนัสไม่แสดง หรือไม่สามารถเข้าเกมได้ สามารถติดต่อ
      <strong class="text-[#9dd2fa]">แอดมิน AKA99 ผ่าน LINE Official ได้ตลอด 24 ชั่วโมง</strong> พร้อมแจ้งรายละเอียดและเวลาที่ทำรายการ เพื่อให้ทีมงานช่วยตรวจสอบรายการและแนะนำขั้นตอนการใช้งานต่อได้รวดเร็วยิ่งขึ้น
      ทั้งนี้ การเดิมพันมีความเสี่ยงและไม่สามารถรับประกันผลกำไรหรือการถูกรางวัลได้ ควรศึกษากติกาของแต่ละเกมและกำหนดงบประมาณให้เหมาะสมก่อนเดิมพันทุกครั้ง
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก AKA99"
        class="flex items-center justify-center rounded-lg bg-gradient-to-r from-[#4aa3ff] via-[#0b6cf0] to-[#0a2a6b] px-8 py-3 font-black text-[#03081c] shadow-[0_0_15px_rgba(11,108,240,0.28)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ AKA99"
        class="flex items-center justify-center rounded-lg border border-[#9dd2fa]/70 bg-transparent px-8 py-3 font-bold text-[#cfdcea] transition-all hover:scale-105 hover:border-[#eaf3fd] hover:bg-[#061436]/70">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
