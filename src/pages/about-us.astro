---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

// MEPAY77 เป็นเว็บคาสิโนออนไลน์ ไม่ใช่เว็บสล็อตอย่างเดียวและไม่ใช่เว็บหวย
// เนื้อหาทั้งหน้าจึงครอบคลุมสี่หมวดตามบรีฟ: บาคาร่า/คาสิโนสด สล็อต หวย และบอล
// พร้อมโปรโมชั่นแนะนำเพื่อน 0.8% คืนยอดเสีย 0.3% ระบบฝากถอนวอลเลท และแอดมิน 24 ชั่วโมง
// — ทุกข้อความอ้างอิง src/assets/content.txt เท่านั้น ไม่มีการอ้างใบอนุญาต การจดทะเบียนบริษัท
// ปีที่ก่อตั้ง จำนวนสมาชิก การันตีผลกำไร หรือชื่อค่ายเกมรายใด
//
// รอบรีแบรนด์ก่อนหน้าเป็นเว็บสล็อตล้วน หน้านี้จึงถูกเขียนใหม่ทั้งหน้าเป็นเนื้อหาคาสิโนครบวงจร
//
// Announcement หมุนมาใช้ Announcement3 — default message ของไฟล์นั้นเป็นคอปปี้
// ของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ไม่ต้องส่ง prop
//
// โลโก้ MEPAY77 เป็นสองโทน (ME/77 ทอง, PAY เงินแปรง) เงิน #dfe3e8 จึงถูกใช้เป็น
// accent รองจริงในหน้านี้ ทั้งไอคอนสลับสีในลิสต์และปุ่มเข้าสู่ระบบ ไม่ใช่ทองจางลง
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 155
const pageDescription =
  "เกี่ยวกับ MEPAY77 คาสิโนออนไลน์ที่รวมบาคาร่า สล็อต หวย และบอลไว้ในบัญชีเดียว ตรวจสอบโปรโมชั่น ฝากถอนวอลเลท และจัดการเครดิตเองได้ พร้อมแอดมินดูแลตลอด 24 ชม.";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ MEPAY77 คาสิโนออนไลน์ รวมบาคาร่า สล็อต หวย บอล ในบัญชีเดียว",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา MEPAY77 คาสิโนออนไลน์ บาคาร่า สล็อต หวย บอล ครบวงจร" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ MEPAY77 คาสิโนออนไลน์ รวมบาคาร่า สล็อต หวย บอล ในบัญชีเดียว" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f1e5cd]">
        <strong class="text-[#fff6e0]">MEPAY77</strong> ให้บริการ<strong class="text-[#fdcc5c]">เกมคาสิโนออนไลน์หลายหมวดหมู่ผ่านระบบเดียว</strong>
        ทั้งบาคาร่า สล็อต หวย และฟุตบอล รองรับการใช้งานบนมือถือและคอมพิวเตอร์
        สมาชิกสามารถเลือกเกม ตรวจสอบโปรโมชั่น ฝากถอน และจัดการเครดิตได้สะดวก พร้อมระบบวอลเลทและธนาคารตามช่องทางที่รองรับ
      </p>

      <p class="text-left text-base leading-relaxed text-[#f1e5cd]">
        นอกจากหมวดเกมแล้ว ยังมี<strong class="text-[#dfe3e8]">โปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไข</strong>
        รวมถึงแอดมินคอยดูแลปัญหาการใช้งานตลอด 24 ชั่วโมง
        สมาชิกจึงตรวจสอบสิทธิ์ เงื่อนไข และสถานะรายการของตนเองได้จากบัญชีเดียวโดยไม่ต้องสมัครหลายครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="MEPAY77 รวมเกมฮิต บาคาร่า สล็อต หวย บอล ครบวงจร" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f1e5cd]">
        MEPAY77 จัดเกมเดิมพันหลักไว้ให้สมาชิกเลือกได้ตามความสนใจ สมาชิกสามารถ<strong class="text-[#fdcc5c]">สลับหมวดเกมผ่านบัญชีเดียวได้โดยไม่ต้องสมัครหลายครั้ง</strong>
        พร้อมตรวจสอบกติกา อัตราจ่าย และวงเงินของแต่ละเกมก่อนยืนยันเดิมพัน
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f1e5cd]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fdcc5c]">🃏</span>
          <span><strong class="text-[#fdcc5c]">บาคาร่าออนไลน์และคาสิโนสด</strong> เปิดให้เลือกโต๊ะตามรายการที่ระบบเปิดให้บริการในแต่ละช่วงเวลา</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#dfe3e8]">🎰</span>
          <span><strong class="text-[#dfe3e8]">สล็อตออนไลน์จากหลายค่าย</strong> เลือกเกมได้จากบัญชีเดียว โดยแต่ละเกมมีกติกาและรูปแบบการเดิมพันต่างกัน</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fdcc5c]">🎟️</span>
          <span><strong class="text-[#fdcc5c]">หวยออนไลน์ตามรอบที่เปิดให้บริการ</strong> ควรตรวจสอบรอบเวลาและอัตราจ่ายของรายการนั้นก่อนส่งโพย</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#dfe3e8]">⚽</span>
          <span><strong class="text-[#dfe3e8]">การเดิมพันฟุตบอลตามรายการแข่งขัน</strong> ดูวงเงินและเงื่อนไขของแต่ละบิลได้ก่อนกดยืนยัน</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#cdb98a]">
        เกมสล็อตและเกมคาสิโนมีผลลัพธ์ไม่แน่นอน จึงไม่มีเกมใดรับประกันว่า “แตกง่าย” หรือสร้างกำไรได้ทุกครั้ง
        ควรเลือกเกมจากกติกา รูปแบบการเดิมพัน และงบประมาณที่เหมาะสมกับตนเอง
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="โปรโมชั่น MEPAY77 แนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f1e5cd]">
        สมาชิกที่มีบัญชี MEPAY77 สามารถ <strong class="text-[#fdcc5c]">Login เพื่อตรวจสอบโปรโมชั่นที่เปิดให้รับในแต่ละช่วง</strong>
        โดยมีทั้งกิจกรรมแนะนำเพื่อนและโบนัสคืนยอดเสีย สิทธิ์แต่ละรายการอาจกำหนดยอดที่ใช้คำนวณ รอบรับโบนัส ประเภทเกม
        และเงื่อนไขแตกต่างกัน จึงควรอ่านรายละเอียดให้ครบก่อนกดรับโปรโมชั่น
      </p>

      <p class="text-left text-base leading-relaxed text-[#f1e5cd]">
        โปรโมชั่นแนะนำเพื่อนให้สมาชิกแชร์ลิงก์แนะนำส่วนตัวให้เพื่อน เมื่อเพื่อนสมัครและมียอดใช้งานตรงตามเงื่อนไข ระบบจะคำนวณโบนัส
        <strong class="text-[#dfe3e8]">แนะนำเพื่อน 0.8%</strong> ตามข้อกำหนด และตรวจสอบจำนวนเพื่อน ยอดที่เข้าเกณฑ์ และโบนัสที่ได้รับผ่านบัญชีสมาชิกได้ด้วยตัวเอง
        ส่วนสมาชิกที่มียอดเสียตรงตามเงื่อนไขสามารถตรวจสอบสิทธิ์รับ<strong class="text-[#dfe3e8]">โบนัสคืนยอดเสีย 0.3%</strong>
        ตามรอบที่ MEPAY77 กำหนด โดยระบบจะแสดงยอดที่ใช้คำนวณและจำนวนโบนัสที่สามารถกดรับได้
      </p>

      <p class="text-left text-base leading-relaxed text-[#cdb98a]">
        ก่อนรับสิทธิ์ทุกครั้งควรตรวจสอบ<strong class="text-[#fff6e0]">ประเภทเกม รอบเวลา และข้อกำหนดเกี่ยวกับโบนัส</strong>ให้เรียบร้อย
        เพราะวิธีคำนวณและข้อกำหนดล่าสุดของแต่ละรายการไม่เหมือนกัน
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ระบบ MEPAY77 ฝากถอนวอลเลท ไม่มีขั้นต่ำ รองรับทุกธนาคาร" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f1e5cd]">
        MEPAY77 มีระบบฝากถอนสำหรับ<strong class="text-[#fdcc5c]">ช่วยให้สมาชิกจัดการเครดิตผ่านบัญชีของตนเอง</strong>
        สามารถเลือกใช้วอลเลทหรือธนาคารจากช่องทางที่เว็บไซต์เปิดรองรับ ฝากเครดิต ส่งคำขอถอน
        และตรวจสอบสถานะรายการผ่านมือถือได้โดยตรง ช่วยลดขั้นตอนและไม่จำเป็นต้องแจ้งรายการกับเจ้าหน้าที่ทุกครั้ง
      </p>

      <p class="text-left text-base leading-relaxed text-[#cdb98a]">
        สำหรับเงื่อนไข <strong class="text-[#fff6e0]">ไม่มีขั้นต่ำ</strong> และ <strong class="text-[#fff6e0]">รองรับทุกธนาคาร</strong>
        ควรตรวจสอบข้อมูลล่าสุดในหน้าฝากถอนก่อนทำรายการ เนื่องจากแต่ละช่องทางอาจมีขั้นต่ำ วงเงินสูงสุด หรือข้อกำหนดแตกต่างกัน
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ติดต่อสอบถามแอดมิน MEPAY77 ได้ตลอด 24 ชั่วโมง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f1e5cd]">
        หากสมาชิกพบปัญหา Login ไม่ได้ ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง เข้าเกมไม่ได้ หรือโปรโมชั่นไม่แสดง สามารถ
        <strong class="text-[#fdcc5c]">ติดต่อแอดมิน MEPAY77 ได้ตลอด 24 ชั่วโมง</strong>
        พร้อมแจ้งเวลา จำนวนเงิน และรายละเอียดรายการ เพื่อช่วยให้เจ้าหน้าที่ตรวจสอบข้อมูลในระบบได้ตรงจุด
      </p>

      <p class="text-left text-base leading-relaxed text-[#f1e5cd]">
        สมาชิกใหม่ยังสามารถสอบถามวิธีใช้งาน ขั้นตอนฝากถอน โปรโมชั่น หรือข้อมูลเกี่ยวกับเกมแต่ละหมวดได้
        หากเป็นปัญหาด้านธุรกรรมควรเก็บหลักฐานรายการไว้จนกว่าการตรวจสอบจะเสร็จสิ้น
        และ<strong class="text-[#dfe3e8]">ไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น</strong>
      </p>

      <p class="text-left text-base leading-relaxed text-[#cdb98a]">
        การเดิมพันมีความเสี่ยงและผลของแต่ละรอบไม่แน่นอน ไม่มีเกมหรือรูปแบบใดรับประกันผลล่วงหน้า
        สมาชิกจึงควรกำหนดงบประมาณก่อนเริ่มเล่นทุกครั้ง
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก MEPAY77"
          class="flex items-center justify-center rounded-lg border border-[#f2ae35]/60 bg-gradient-to-r from-[#fff6e0] via-[#fdcc5c] to-[#a3701c] px-8 py-3 font-black text-[#130c01] shadow-[0_0_15px_rgba(242,174,53,0.35)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ MEPAY77"
          class="flex items-center justify-center rounded-lg border border-[#dfe3e8]/55 bg-transparent px-8 py-3 font-bold text-[#dfe3e8] transition-all hover:scale-105 hover:border-[#dfe3e8] hover:bg-[#241503]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
