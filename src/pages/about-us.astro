---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement4.astro";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "รู้จัก FIN8888 แบรนด์เกมสล็อตออนไลน์ธีมเทศกาล รวมค่ายเกมมาตรฐาน PG Joker Pragmatic Play รองรับมือถือและคอมพิวเตอร์ ฝากถอนอัตโนมัติ 24 ชั่วโมง พร้อมทีมงานดูแล";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ FIN8888 แบรนด์เกมสล็อตออนไลน์",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา FIN8888 แบรนด์เกมสล็อตออนไลน์" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ FIN8888" as="h1">
    <p class="mb-6 text-left text-base leading-relaxed text-[#dbeafe]">
      <strong class="text-[#dbeafe]">FIN8888</strong> คือแบรนด์เกมสล็อตออนไลน์ธีมงานเทศกาลรื่นเริง ชูสีสันคู่ฟ้าไซแอนและทอง พร้อมเจ้าสัวมาสคอตประจำแบรนด์ รวมเกมจากค่ายมาตรฐานอย่าง PG, Joker, Pragmatic Play, Play'n GO, Habanero และ Live22 ไว้ในบัญชีเดียว รองรับการเข้าใช้งานผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ได้อย่างเต็มรูปแบบ ไม่ว่าจะเป็นระบบ Android, iOS หรือเว็บเบราว์เซอร์บนคอมพิวเตอร์ ก็เข้าเล่นได้ทันทีโดยไม่ต้องติดตั้งโปรแกรมเพิ่มเติม
    </p>

    <p class="mb-8 text-left text-base leading-relaxed text-[#dbeafe]">
      ด้านการเงิน ระบบฝากถอนอัตโนมัติของ FIN8888 เปิดให้ทำรายการได้ด้วยตนเองตลอด 24 ชั่วโมงโดยไม่ต้องรอเจ้าหน้าที่ทีละราย พร้อมรับอนุญาตจากเจ้าของแบรนด์ต้นฉบับโดยตรง ทำให้มั่นใจได้ในความปลอดภัยของข้อมูลสมาชิกและประวัติการทำรายการ และมีทีมงานคอยดูแลให้คำแนะนำตลอดการเดิมพัน เพื่อให้สมาชิกทุกคนใช้งาน FIN8888 ได้อย่างมั่นใจในทุกขั้นตอน
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก"
        class="flex items-center justify-center rounded-lg border border-[#0891b2]/60 bg-gradient-to-b from-[#22d3ee] to-[#0891b2] px-8 py-3 font-bold text-white shadow-[0_10px_30px_rgba(8,145,178,0.18)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(21,94,117,0.30)]">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ"
        class="flex items-center justify-center rounded-lg border border-[#0891b2]/60 bg-[#050b16] px-8 py-3 font-extrabold text-[#dbeafe] shadow-[0_4px_14px_rgba(8,145,178,0.18)] transition-transform hover:scale-105 hover:bg-[#0a1628]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
