---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxCyberCut.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

// UFAFOX is a PG slot brand — nothing on this page may mention lottery content.
// Every claim below traces back to src/assets/content.txt; nothing invented.
//
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char, so a byte count reads
// ~3x too long). One string, reused by MainLayout's meta and the WebPage node.
// This page is 151.
const pageDescription =
  "รู้จัก UFAFOX เว็บสล็อต PG ค่ายหลัก ที่รวมวิธีอ่าน Paytable, RTP, ความผันผวน, Wild, Scatter และ Free Spins พร้อมแผนคุมเงินทุนและสมัครเองได้ใน 3 ขั้นตอน";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ UFAFOX เว็บสล็อต PG ค่ายหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา UFAFOX เว็บสล็อต PG ค่ายหลัก คู่มือ เทคนิค และสูตรคุมทุน" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ UFAFOX" as="h1">
    <div>
      <p class="mb-6 text-left text-base leading-relaxed text-[#ded4cb]">
        <strong class="text-[#ffb266]">UFAFOX</strong> คือ <strong class="text-[#ffb266]">เว็บเดิมพันที่เน้นเกมสล็อต PG ค่ายหลัก</strong>
        สำหรับคนที่ต้องการเลือกเกมพร้อมข้อมูลประกอบก่อนเล่น เราจึงวางคำแนะนำไว้ตั้งแต่การอ่าน Paytable ทำความเข้าใจ RTP ความผันผวน
        ฟีเจอร์ฟรีสปิน ไปจนถึงวิธีจัดการเงินทุนผ่านมือถือ ให้ศึกษาได้ครบทุกเกมโดยไม่มีค่าใช้จ่ายเพิ่ม
      </p>

      <p class="mb-2 text-left text-base leading-relaxed text-[#ded4cb]">
        จุดสำคัญที่บอกกันตรง ๆ คือ <strong class="text-[#ffb266]">เทคนิคหรือสูตรไม่สามารถบังคับผลสล็อตให้ชนะได้</strong>
        เพราะผลลัพธ์ของแต่ละรอบไม่สามารถทำนายล่วงหน้าได้ สิ่งที่คู่มือชุดนี้ทำได้จริงคือช่วยวางแผนงบประมาณ ลดการเล่นตามอารมณ์
        และทำให้เข้าใจกติกาของแต่ละเกมมากขึ้นก่อนลงเงินจริง
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="ข้อมูลเกมที่ UFAFOX แนะนำให้อ่านก่อนเลือกเกมสล็อต PG" as="h2">
    <div>
      <p class="mb-2 text-left text-base leading-relaxed text-[#ded4cb]">
        ก่อนเลือกเกมสล็อตใน UFAFOX ควรเริ่มจากการอ่านรายละเอียดของเกมนั้นให้ครบ โดยเฉพาะ
        <strong class="text-[#ffb266]">Paytable, RTP, จำนวนเพย์ไลน์หรือรูปแบบการจ่าย, Wild, Scatter, Free Spins และเงื่อนไขของฟีเจอร์โบนัส</strong>
        เพราะสล็อต PG แต่ละเกมไม่ได้ใช้ระบบเหมือนกัน การรู้ว่าเกมจ่ายรางวัลอย่างไรช่วยให้เลือกขนาดเดิมพันและเงินทุนได้เหมาะสมกว่าเดิม
        แทนที่จะเลือกเกมจากคำว่าแตกง่ายเพียงอย่างเดียว
      </p>

      <p class="mt-3 mb-2 text-left text-base leading-relaxed text-[#ded4cb]">
        อีกสองค่าที่ควรดูประกอบกันเสมอคือ <strong class="text-[#e3e7ec]">RTP</strong> กับ <strong class="text-[#e3e7ec]">ระดับความผันผวน</strong>
        เกมที่มีความผันผวนสูงอาจมีช่วงที่รางวัลห่างกว่า ขณะที่เกมความผันผวนต่ำอาจมีรูปแบบการจ่ายแตกต่างออกไป
        จึงควรเลือกให้เหมาะกับเงินทุนและระยะเวลาที่ตั้งใจเล่น มากกว่าการตามคำบอกว่าเกมใดกำลังแตกหรือถึงรอบจ่าย
        เพราะ<strong class="text-[#ffb266]">ผลของรอบก่อนหน้าไม่ได้ยืนยันผลของรอบถัดไป</strong>
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="แผนคุมทุนของ UFAFOX แบ่งทุน 100 ส่วน และตั้ง Stop Loss กับ Stop Win" as="h2">
    <div>
      <p class="mb-2 text-left text-base leading-relaxed text-[#ded4cb]">
        วิธีแรกคือ <strong class="text-[#ffb266]">แบ่งงบสำหรับเล่นออกเป็น 100 หน่วย</strong> เช่น มีทุน 1,000 บาท ให้คิด 1 หน่วยเท่ากับ 10 บาท
        แล้วกำหนดขนาดเดิมพันให้อยู่ในระดับที่รับความผันผวนได้ หากเสียถึงจุดที่ตั้งไว้ให้หยุดตามแผน ไม่เพิ่มเดิมพันเพื่อไล่เอาเงินคืน
        วิธีนี้ไม่ได้ทำให้เกมจ่ายรางวัลมากขึ้น แต่ช่วยให้รู้ล่วงหน้าว่าแต่ละรอบสามารถใช้เงินได้เท่าไร
      </p>

      <p class="mt-3 mb-2 text-left text-base leading-relaxed text-[#ded4cb]">
        วิธีที่สองคือ <strong class="text-[#ffb266]">กำหนดจุดหยุดตั้งแต่ก่อนกด Spin</strong> ทั้งจุดที่จะหยุดเมื่อเสียถึงจำนวนที่รับได้
        และจุดที่จะพักหรือจบรอบเมื่อยอดเพิ่มถึงเป้าหมายที่ตั้งไว้ หลักนี้ช่วยป้องกันการเล่นต่อเพราะอยากเอาคืนหรือหวังกำไรเพิ่ม
        แม้ไม่ใช่สูตรชนะสล็อต แต่เป็นวิธีบริหารเงินที่ชัดเจนและนำไปใช้กับเกมสล็อตหลายรูปแบบได้
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="สมัคร UFAFOX ด้วยตัวเอง 3 ขั้นตอน และติดต่อแอดมินได้เมื่อติดปัญหา" as="h2">
    <div>
      <p class="mb-4 text-left text-base leading-relaxed text-[#ded4cb]">
        การเริ่มใช้งาน UFAFOX ทำผ่านมือถือหรือคอมพิวเตอร์ก็ได้ โดยควรตรวจสอบข้อมูลและเงื่อนไขของระบบก่อนทำรายการทุกครั้ง
      </p>

      <ol class="mb-4 flex flex-col gap-2 text-left text-base leading-relaxed text-[#ded4cb]">
        <li class="flex gap-3"><span class="font-bold text-[#ff9130]">1.</span> สมัครสมาชิก UFAFOX และกรอกข้อมูลตามที่ระบบกำหนด</li>
        <li class="flex gap-3"><span class="font-bold text-[#ff9130]">2.</span> Login เข้าบัญชี ตรวจสอบช่องทางฝากเงินและรายละเอียดโปรโมชั่น</li>
        <li class="flex gap-3"><span class="font-bold text-[#ff9130]">3.</span> เลือกเกมสล็อต PG อ่านกติกาและกำหนดงบประมาณก่อนเริ่มเล่น</li>
      </ol>

      <p class="mb-4 text-left text-base leading-relaxed text-[#ded4cb]">
        หลังสมัครควรตั้งรหัสผ่านที่คาดเดายากและ<strong class="text-[#ffb266]">ไม่เปิดเผยรหัสผ่านหรือ OTP ให้ผู้อื่น</strong>
        ส่วนโบนัสหรือโปรโมชั่นควรอ่านเงื่อนไขก่อนกดรับทุกครั้ง เพราะแต่ละรายการมีวิธีคำนวณและรอบรับสิทธิ์ต่างกัน
      </p>

      <p class="mb-6 text-left text-base leading-relaxed text-[#ded4cb]">
        หากพบปัญหาเกี่ยวกับการสมัคร Login ฝากถอน เครดิตไม่เข้า โปรโมชั่น หรือเข้าเกมสล็อตไม่ได้ สามารถ
        <strong class="text-[#ffb266]">ติดต่อแอดมิน UFAFOX ได้ทันที</strong> พร้อมแจ้งรายละเอียดและเวลาที่เกิดรายการ เพื่อให้ตรวจสอบปัญหาได้ตรงจุด
        สอบถามวิธีอ่านกติกา ฟีเจอร์ หรือข้อมูลของเกมได้เช่นกัน แต่ควรระวังคำแนะนำที่อ้างว่ามีสูตรล็อกผล สูตรชนะ 100% หรือรู้รอบแตกล่วงหน้า
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก UFAFOX"
          class="flex items-center justify-center rounded-lg bg-gradient-to-r from-[#ffb266] via-[#f26a02] to-[#8c3a01] px-8 py-3 font-black text-[#070403] shadow-[0_0_15px_rgba(242,106,2,0.35)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ UFAFOX"
          class="flex items-center justify-center rounded-lg border border-[#4a2409]/80 bg-transparent px-8 py-3 font-bold text-[#e3e7ec] transition-all hover:scale-105 hover:border-[#f26a02] hover:bg-[#1e0f06]/70">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
