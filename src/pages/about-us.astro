---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// OSAKA198 เป็นเว็บสล็อตออนไลน์ เนื้อหาทั้งหน้าจึงพูดเรื่องเกมสล็อตจากหลายค่ายในบัญชีเดียว
// ช่วงเดิมพันเริ่มต้น 1 บาทตามเงื่อนไขของแต่ละเกม โปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%
// การสมัคร 3 ขั้นตอน การฝากถอน/ประวัติรายการในบัญชีสมาชิก และแอดมิน 24 ชั่วโมง
// — ทุกข้อความอ้างอิง src/assets/content.txt เท่านั้น ไม่มีการอ้างใบอนุญาต การจดทะเบียนบริษัท
// ปีที่ก่อตั้ง จำนวนสมาชิก การันตีผลกำไร หรือชื่อค่ายเกมรายใด
//
// รอบรีแบรนด์ก่อนหน้าเป็นคาสิโนสด/บาคาร่า หน้านี้จึงถูกเขียนใหม่ทั้งหน้าเป็นเนื้อหาสล็อต
//
// Announcement หมุนมาใช้ Announcement5 — default message ของไฟล์นั้นเป็นคอปปี้
// ของแบรนด์นี้อยู่แล้ว จึงเรียกแบบ bare ไม่ต้องส่ง prop
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 157
const pageDescription =
  "เกี่ยวกับ OSAKA198 เว็บสล็อตออนไลน์ที่รวมเกมจากหลายค่ายไว้ในบัญชีเดียว แทงสล็อตเริ่มต้น 1 บาท ไม่จำกัดยอด ฝากถอนและตรวจโปรโมชั่นเองได้ พร้อมแอดมินดูแล 24 ชม.";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ OSAKA198 เว็บสล็อตออนไลน์ รวมทุกค่ายไว้ในบัญชีเดียว",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา OSAKA198 เว็บสล็อตออนไลน์ แทงสล็อต 1 บาท ทุกค่าย" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ OSAKA198 เว็บสล็อตออนไลน์ รวมทุกค่ายไว้ในบัญชีเดียว" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e8ddc8]">
        <strong class="text-[#f7f1e4]">OSAKA198</strong> เปิดบริการสำหรับผู้ที่ต้องการ<strong class="text-[#e4cc95]">เล่นสล็อตออนไลน์ผ่านมือถือและคอมพิวเตอร์</strong>
        โดยมีเกมจากหลายค่ายให้เลือกในบัญชีเดียว พร้อมตัวเลือกเดิมพันเริ่มต้นระดับต่ำตามเงื่อนไขของแต่ละเกม
        สมาชิกสมัคร เข้าเกม ตรวจสอบโปรโมชั่น ฝากถอน และดูประวัติการใช้งานได้ผ่านระบบเดียวกัน
      </p>

      <p class="text-left text-base leading-relaxed text-[#e8ddc8]">
        แนวคิดของเว็บคือทำให้ทุกขั้นตอนตรวจสอบได้ก่อนกดยืนยัน ทั้งช่วงเดิมพันของเกมที่เลือก เงื่อนไขของโปรโมชั่นแต่ละรายการ
        และ<strong class="text-[#e4cc95]">การฝากถอนกับประวัติรายการที่ย้อนกลับมาดูได้เสมอจากบัญชีสมาชิก</strong>
        พร้อมแอดมินคอยให้คำแนะนำตลอด 24 ชั่วโมง ตั้งแต่ขั้นตอนสมัครไปจนถึงการใช้งานภายในเว็บไซต์
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="OSAKA198 เล่นสล็อตไม่อั้น ไม่จำกัดยอด เล่นได้ทุกค่าย ในเว็บเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e8ddc8]">
        สมาชิก OSAKA198 สามารถเลือกเล่นสล็อตจากหลากหลายค่ายผ่านระบบเดียว มีทั้งเกมยอดนิยม เกมใหม่ เกมโบนัส ฟรีสปิน และสล็อตหลายรูปแบบ
        รองรับการใช้งานผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ โดย<strong class="text-[#e4cc95]">ไม่ต้องสมัครแยกหลายบัญชี</strong>
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#e8ddc8]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e4cc95]">🎰</span>
          <span><strong class="text-[#e4cc95]">เกมยอดนิยมและเกมใหม่</strong> เปิดให้เลือกตามรายการที่ค่ายผู้ให้บริการปล่อยเข้าระบบในช่วงเวลานั้น</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e4cc95]">🎁</span>
          <span><strong class="text-[#e4cc95]">เกมโบนัสและฟรีสปิน</strong> มีรูปแบบการแจกและเงื่อนไขต่างกันไปในแต่ละเกม ควรอ่านรายละเอียดที่แสดงในเกมก่อนเริ่มหมุน</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e4cc95]">🪙</span>
          <span><strong class="text-[#e4cc95]">เดิมพันเริ่มต้น 1 บาท</strong> เลือกได้หากเกมนั้นเปิดช่วงเดิมพันระดับดังกล่าว ขั้นต่ำจริงขึ้นอยู่กับผู้ให้บริการและแต่ละเกม</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e4cc95]">📱</span>
          <span><strong class="text-[#e4cc95]">เล่นได้ทุกอุปกรณ์</strong> ทั้งสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ โดยใช้บัญชีสมาชิกเดียวกันตลอด</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#c7b895]">
        หากต้องการเล่นสล็อตเริ่มต้น 1 บาท ควรตรวจสอบช่วงเดิมพันของเกมนั้นก่อนเริ่มเล่น เนื่องจากขั้นต่ำจริงจะแตกต่างกันตามค่ายและเกม
        ส่วนเงื่อนไข “ไม่จำกัดยอด” หรือ “ไม่อั้น” ควรยึดวงเงินที่ระบบแสดง ณ เวลาทำรายการเป็นหลัก
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="โปรโมชั่น OSAKA198 แนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e8ddc8]">
        สมาชิกสามารถ <strong class="text-[#e4cc95]">Login OSAKA198 เพื่อตรวจสอบโปรโมชั่นที่เปิดให้รับผ่านบัญชีของตนเอง</strong>
        โดยมีทั้งโบนัสแนะนำเพื่อนและโปรโมชั่นคืนยอดเสีย แต่ละรายการอาจกำหนดยอดที่ใช้คำนวณ รอบรับ และเงื่อนไขการถอนแตกต่างกัน
        ก่อนกดรับควรอ่านรายละเอียดล่าสุดให้ครบถ้วน
      </p>

      <p class="text-left text-base leading-relaxed text-[#e8ddc8]">
        โปรโมชั่นแนะนำเพื่อนให้แชร์ลิงก์แนะนำส่วนตัวให้เพื่อน เมื่อเพื่อนสมัครและมียอดใช้งานตรงตามข้อกำหนด ระบบจะคำนวณโบนัส
        <strong class="text-[#e4cc95]">แนะนำเพื่อน 0.8%</strong> ตามเงื่อนไข ส่วนสมาชิกที่มียอดเสียตรงตามข้อกำหนดสามารถตรวจสอบสิทธิ์รับ
        <strong class="text-[#e4cc95]">โบนัสคืนยอดเสีย 0.3%</strong> ตามรอบที่ OSAKA198 กำหนด โดยระบบจะแสดงยอดที่นำมาคำนวณและโบนัสที่รับได้
      </p>

      <p class="text-left text-base leading-relaxed text-[#c7b895]">
        ก่อนกดรับทุกครั้งควรตรวจสอบ<strong class="text-[#f7f1e4]">ประเภทเกมที่ร่วมรายการ รอบเวลา และเงื่อนไขของโปรโมชั่น</strong>ให้ครบถ้วน
        เพราะวิธีคำนวณและข้อกำหนดการถอนของแต่ละรายการไม่เหมือนกัน
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="สมัครสมาชิกและฝากถอน OSAKA198 จัดการเองได้จากบัญชีสมาชิก" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e8ddc8]">
        ผู้ใช้งานใหม่<strong class="text-[#e4cc95]">เริ่มต้นสมัคร OSAKA198 ผ่านมือถือหรือคอมพิวเตอร์ได้ด้วยขั้นตอนที่ไม่ซับซ้อน</strong>
        เริ่มจากสมัครสมาชิกและกรอกข้อมูลตามที่ระบบกำหนด จากนั้น Login เข้าสู่บัญชีและฝากเครดิตผ่านช่องทางที่เปิดให้บริการ
        แล้วจึงตรวจสอบโปรโมชั่น เลือกค่ายและเกมสล็อตที่ต้องการก่อนเริ่มเล่น
      </p>

      <p class="text-left text-base leading-relaxed text-[#e8ddc8]">
        หลังสมัครเรียบร้อยสามารถตรวจสอบเครดิต โปรโมชั่น ประวัติรายการ และสถานะฝากถอนผ่านบัญชีสมาชิกได้
        โดยควร<strong class="text-[#e4cc95]">ตั้งรหัสผ่านที่คาดเดายากและไม่เปิดเผย OTP ให้บุคคลอื่น</strong>
        หากเครดิตไม่เข้า รายการถอนค้าง หรือสถานะธุรกรรมไม่อัปเดต ควรเก็บหลักฐานรายการไว้จนกว่าการตรวจสอบจะเสร็จสิ้น
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="แอดมิน OSAKA198 ติดต่อสอบถามได้ตลอด 24 ชั่วโมง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e8ddc8]">
        หากพบปัญหาเกี่ยวกับการสมัคร Login ไม่ได้ ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง โปรโมชั่นไม่แสดง หรือเข้าเกมสล็อตไม่ได้ สามารถ
        <strong class="text-[#e4cc95]">ติดต่อแอดมิน OSAKA198 ได้ตลอด 24 ชั่วโมง</strong>
        พร้อมแจ้งรายละเอียด เวลา และข้อมูลรายการที่เกี่ยวข้อง เพื่อให้เจ้าหน้าที่ช่วยตรวจสอบปัญหาได้ตรงจุด
      </p>

      <p class="text-left text-base leading-relaxed text-[#e8ddc8]">
        สมาชิกใหม่ยังสามารถสอบถามเกี่ยวกับการเลือกเกม การฝากถอน หรือวิธีรับโปรโมชั่นได้
        โดยหากเป็นปัญหาเกี่ยวกับธุรกรรมควรเก็บหลักฐานไว้จนกว่าการตรวจสอบจะเสร็จสิ้น
      </p>

      <p class="text-left text-base leading-relaxed text-[#c7b895]">
        การเดิมพันมีความเสี่ยงและผลของแต่ละรอบไม่แน่นอน ไม่มีเกมหรือรูปแบบใดรับประกันผลล่วงหน้า
        สมาชิกจึงควรกำหนดงบประมาณก่อนเริ่มเล่นทุกครั้ง
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก OSAKA198"
          class="flex items-center justify-center rounded-lg border border-[#c7b895]/60 bg-gradient-to-r from-[#f7f1e4] via-[#c7b895] to-[#9a8a68] px-8 py-3 font-black text-[#0b0906] shadow-[0_0_15px_rgba(199,184,149,0.30)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ OSAKA198"
          class="flex items-center justify-center rounded-lg border border-[#a37c4b]/60 bg-transparent px-8 py-3 font-bold text-[#e4cc95] transition-all hover:scale-105 hover:border-[#c7b895] hover:bg-[#5b4423]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
