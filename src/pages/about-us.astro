---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char, so a byte count reads
// ~3x too long). One string, reused by MainLayout's meta and the WebPage node.
const pageDescription =
  "รู้จัก 12PLAY เว็บคาสิโนออนไลน์ที่รวมบาคาร่า รูเล็ต เสือมังกร แบล็กแจ็ก และสล็อตไว้ในบัญชีเดียว พร้อมโบนัสค่าแนะนำ ระบบฝากถอนออโต้ และแอดมินดูแล 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ 12PLAY เว็บคาสิโนออนไลน์ รวมค่ายเกมไว้ในบัญชีเดียว",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา 12PLAY เว็บคาสิโนออนไลน์ รวมค่ายเกมในบัญชีเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ 12PLAY" as="h1">
    <p class="mb-6 text-left text-base leading-relaxed text-[#e0d7d8]">
      <strong class="text-[#ff5a63]">12PLAY</strong> พร้อมให้บริการสมาชิกที่ต้องการเข้าเล่นคาสิโนออนไลน์ผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ได้โดยตรง
      ภายในบัญชีเดียวมีเกมให้เลือกหลายหมวดหมู่ ทั้ง <strong class="text-[#ff5a63]">บาคาร่า รูเล็ต เสือมังกร แบล็กแจ็ก และสล็อต</strong> จากหลายค่าย
      พร้อมโปรโมชั่นสำหรับสมาชิกใหม่และสมาชิกปัจจุบัน รวมถึงโบนัสจากกิจกรรมแนะนำเพื่อนตามเงื่อนไข สมาชิกจึงค้นหาเกมที่สนใจและสลับเข้าเล่นแต่ละหมวดหมู่ได้สะดวกโดยไม่ต้องเปิดหลายบัญชี
    </p>

    <p class="mb-2 text-left text-base leading-relaxed text-[#e0d7d8]">
      นอกจากตัวเกมแล้ว ที่นี่ยังมีระบบฝากถอนอัตโนมัติที่ช่วยให้สมาชิกทำรายการได้ด้วยตนเองตลอด 24 ชั่วโมง และมีทีมงานคอยให้คำแนะนำเมื่อพบปัญหาในการใช้งาน
      รายละเอียดของโบนัส ยอดที่นำมาคำนวณ และรอบการรับสิทธิ์จะแสดงอยู่ในระบบสมาชิกก่อนกดรับเสมอ สมาชิกควรอ่านเงื่อนไขตรงจุดนั้นทุกครั้ง
      เพราะข้อกำหนดของแต่ละโปรโมชั่นไม่เท่ากัน
    </p>
  </ContentBox>

  <ContentBoxPlain title="12PLAY รวมเกมคาสิโนหลายหมวดหมู่ไว้ในบัญชีเดียว" as="h2">
    <p class="mb-2 text-left text-base leading-relaxed text-[#e0d7d8]">
      สมาชิกสามารถเลือกเกมคาสิโนออนไลน์จากหลากหลายค่ายได้ในบัญชีเดียว ทั้ง <strong class="text-[#ff5a63]">บาคาร่า รูเล็ต เสือมังกร แบล็กแจ็ก สล็อต</strong>
      และเกมเดิมพันยอดนิยมอื่น ๆ ระบบรองรับการเข้าใช้งานผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ พร้อมจัดหมวดหมู่เกมให้ค้นหาได้ง่าย
      สมาชิกจึงเลือกหมวดหมู่และเข้าเล่นเกมที่สนใจได้สะดวก โดยแนะนำให้อ่านกติกาและรายละเอียดของแต่ละเกมก่อนเริ่มเดิมพันทุกครั้ง
    </p>
  </ContentBoxPlain>

  <ContentBoxPlain title="โบนัสค่าแนะนำและโปรโมชั่นสมาชิกของ 12PLAY" as="h2">
    <p class="mb-2 text-left text-base leading-relaxed text-[#e0d7d8]">
      สมาชิก 12PLAY เข้าร่วมกิจกรรมแนะนำเพื่อนเพื่อรับ <strong class="text-[#ff5a63]">โบนัสค่าแนะนำ 0.8%</strong> ได้ตามเงื่อนไขที่กำหนด
      เพียงเข้าสู่บัญชีสมาชิก คัดลอกลิงก์แนะนำของตนเองแล้วแชร์ให้เพื่อน เมื่อมีรายการที่ตรงตามข้อกำหนด ระบบจะคำนวณสิทธิ์โบนัสตามอัตราที่ประกาศไว้
      สมาชิกตรวจสอบยอดแนะนำและสิทธิ์ที่ได้รับผ่านบัญชีสมาชิกได้โดยตรง ควรอ่านอัตราโบนัส รอบการรับ และข้อกำหนดการถอนให้ครบก่อนใช้สิทธิ์ทุกครั้ง
    </p>

    <p class="mt-3 mb-2 text-left text-base leading-relaxed text-[#e0d7d8]">
      ผู้ใช้งานใหม่สมัครสมาชิกผ่านหน้าเว็บไซต์ได้ด้วยขั้นตอนที่ไม่ซับซ้อน หลังเปิดบัญชีเรียบร้อยสามารถตรวจสอบโปรโมชั่นโบนัสยอดฝากที่กำลังเปิดให้รับได้จากหน้าเว็บไซต์
      โดยสิทธิ์และจำนวนโบนัสขึ้นอยู่กับเงื่อนไขของแต่ละโปรโมชั่น นอกจากนี้ยังมีโปรโมชั่นคืนยอดเสียรับโบนัส 0.3% ให้ติดตามอีกรายการหนึ่ง
      สมาชิกควรอ่านรายละเอียดเกี่ยวกับยอดฝากขั้นต่ำ ยอดเทิร์น และเงื่อนไขการถอนให้ครบถ้วนก่อนกดรับโบนัส
    </p>
  </ContentBoxPlain>

  <ContentBoxPlain title="ระบบฝากถอนออโต้ และแอดมิน 12PLAY ดูแลตลอด 24 ชั่วโมง" as="h2">
    <p class="mb-6 text-left text-base leading-relaxed text-[#e0d7d8]">
      <strong class="text-[#ff5a63]">ระบบฝากถอนอัตโนมัติ</strong> ช่วยให้สมาชิกฝากเครดิต ส่งคำขอถอน และตรวจสอบสถานะธุรกรรมได้ด้วยตนเองตลอด 24 ชั่วโมง
      โดยข้อกำหนดเรื่องยอดขั้นต่ำและช่องทางที่รองรับให้ยึดข้อมูลล่าสุดที่แสดงในหน้าฝากถอนเป็นหลัก หากพบปัญหาเครดิตไม่เข้า ถอนเงินไม่ได้ หรือรายการค้าง
      ไม่ว่าจะเป็นปัญหาการสมัครสมาชิก การเข้าสู่ระบบ การรับโบนัสค่าแนะนำ หรือการเข้าเล่นเกมคาสิโน มี
      <strong class="text-[#ff5a63]">แอดมินดูแลตลอดทั้งวันทั้งคืน</strong> ให้ติดต่อเข้ามาได้โดยไม่ต้องรอคิว ทั้งนี้ การพนันมีความเสี่ยง
      ไม่มีระบบหรือเทคนิคใดรับประกันผลกำไร ผู้เล่นควรศึกษากติกาและกำหนดงบประมาณก่อนเดิมพันทุกครั้ง
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก 12PLAY"
        class="flex items-center justify-center rounded-lg bg-gradient-to-r from-[#ff5a63] via-[#e01020] to-[#8a0710] px-8 py-3 font-black text-[#f4eff0] shadow-[0_0_15px_rgba(224,16,32,0.45)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ 12PLAY"
        class="flex items-center justify-center rounded-lg border border-[#e01020]/70 bg-transparent px-8 py-3 font-bold text-[#e0d7d8] transition-all hover:scale-105 hover:border-[#ff5a63] hover:bg-[#1a0304]/70">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
