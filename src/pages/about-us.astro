---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็น **บทความจริง** (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login,
// /register หรือหน้าภาพแบบ /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง
// ไม่ใช่เช็กลิสต์หัวข้อของบรีฟที่ใช้กับ index.astro — บรีฟรอบนี้
// (src/assets/content.txt, 29 บรรทัด) ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าใหม่จาก
// ข้อเท็จจริงและคลังคำของบรีฟรอบนี้เท่านั้น (.claude/brand-spec-123bet.md §4-§5)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x5 · h3x0
//   h1  เกี่ยวกับเรา <แบรนด์> เว็บเกมคาสิโนออนไลน์ที่รวมเจ็ดหมวดเดิมพันไว้ในที่เดียว
//   h2  บาคาร่า สล็อต ไฮโล รูเล็ต ยิงปลา บอล หวย เจ็ดหมวดที่ <แบรนด์> รวบรวมไว้
//   h2  สิ่งที่ควรตรวจสอบเองก่อนเชื่อข้อความโฆษณาบนหน้าเว็บ
//   h2  ระบบสมาชิกของ <แบรนด์> และการสมัครที่ระบุว่าไม่มีขั้นต่ำ
//   h2  โปรโมชั่นที่ <แบรนด์> ระบุไว้ คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%
//   h2  แอดมิน <แบรนด์> และช่องทางติดต่อตลอด 24 ชั่วโมง
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) และจาก footer จึงเปิดใช้งานอยู่
// ⚠️ หัวข้อของหน้านี้ **ตั้งใจไม่ให้ซ้ำกับหัวข้อของ index.astro** — index เล่าว่า
// เว็บไซต์ "ระบุอะไรไว้" ตามลำดับของบรีฟ ส่วนหน้านี้เล่าว่า "ตรวจสอบอะไรได้จากที่ไหน"
// ถ้ารอบหน้าคัดลอกหัวข้อของ index มาวางที่นี่ จะได้สองหน้าที่แข่งกันเองใน index
//
// 🚨🚨 ดรอปนี้ (2026-10-28) แบรนด์ขาออกอยู่หมวดธุรกิจเดียวกัน (เว็บเดิมพันออนไลน์)
// แต่ **คนละคำนิยามตัวเองทั้งชุด** เนื้อหาทั้งหน้าจึงถูก **เขียนใหม่** ไม่ใช่แค่
// เปลี่ยนชื่อแบรนด์ บรีฟรอบนี้เรียกตัวเองว่า "เจ้าของบาคาร่าสล็อต เว็บตรง
// ถูกลิขสิทธิ์ ครบทุกค่าย เซิร์ฟแท้ ปลอดภัยในไทย" และระบุ **เจ็ดหมวดเกม**
// (บาคาร่า · สล็อตออนไลน์ · ไฮโล · รูเล็ต · ยิงปลา · เดิมพันฟุตบอล · หวยออนไลน์) ·
// ระบบสมาชิกที่รองรับการใช้งานผ่านมือถือ · โปรโมชั่นอัปเดตใหม่ตลอดสัปดาห์ ·
// คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · สมัคร 3 ขั้นตอน · แอดมินตลอด 24ชม.
// 🚨🚨 **รอบก่อนมีห้าหมวด รอบนี้มีเจ็ด — ห้ามสืบทอดจำนวนหมวดข้ามแบรนด์**
// ⚠️⚠️ ศัพท์หมวดธุรกิจของแบรนด์ขาออกเป็น **คำค้างข้ามแบรนด์** ห้ามหลุดกลับมา
// **รายการคำต้องห้ามเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่** เพื่อไม่ให้
// sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// 🚨🚨 **สามคำที่ spec รอบก่อนห้ามไว้ แต่รอบนี้เป็นคำของบรีฟเอง**: เว็บตรง ·
// ถูกลิขสิทธิ์ · ปลอดภัยในไทย **ห้ามลบออกเพราะอ่านคอมเมนต์เก่าแล้วเข้าใจผิด**
// 🚨🚨 **บรีฟรอบนี้ไม่มีหมวดฝากถอน/ธนาคาร/วอลเลทเป็นบริการของเว็บเลยแม้แต่คำเดียว**
// — รอบก่อนๆ เคยมีหัวข้อทำนองนั้นอยู่บนหน้านี้ **ถูกตัดออกและห้ามเขียนกลับ**
// ที่ห้ามคือ **ประโยคที่อ้างว่าเว็บให้บริการฝาก-ถอน** · ชื่อธนาคาร/วอลเล็ต ·
// ฟีเจอร์ออโต้ · และยอดขั้นต่ำ-สูงสุดที่เป็นตัวเลข
// ⚠️⚠️ **แต่ประโยคกำกับของบรีฟเองที่มีคำว่า "ถอนเงิน"/"ฝากเงิน" ต้อง ship ตามที่
// บรีฟเขียน ห้ามเลี่ยงคำ** (บรรทัด 8 ข้อจำกัดการถอนเงิน · บรรทัด 10 ข้อกำหนด
// การใช้โบนัสและการถอนเงิน · บรรทัด 12 เงื่อนไขการถอนเงิน · บรรทัด 14 ไม่มี
// ขั้นต่ำครอบคลุมเฉพาะการสมัครหรือรวมถึงการฝากเงินและการเดิมพันด้วย)
// สามคำนั้นเป็น **คำเตือนผู้บริโภคที่บรีฟเขียนถึงตัวเอง** ซึ่งตรงข้ามกับคำโฆษณา
// การเลี่ยงไปใช้ "การทำรายการ" หรือ "ข้อจำกัดในการใช้เครดิต" **ทำให้ความหมายเพี้ยน**
// (ตัดสินโดย orchestrator รอบนี้ 2026-10-28 หลังเคยเลี่ยงคำไปรอบหนึ่งแล้ว)
// ⚠️⚠️ **หวย รอบนี้ใช้ได้ในฐานะ "หนึ่งในเจ็ดหมวดเกม" เท่านั้น** ห้ามเขียนเนื้อหา
// เฉพาะทางหวย (รายการคำเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ที่นี่)
// และ **สองหน้าหมวดหวยยังอยู่ใน src/pages-disabled/ (ชื่อไฟล์อยู่ใน brand-spec §7)
// ห้ามลิงก์ไปหาเด็ดขาด** ลิงก์ตาย = build แดง
// ⚠️⚠️ ชื่อแบรนด์รอบนี้เป็น **ตัวเลขนำหน้า + ตัวละตินพิมพ์ใหญ่ เขียนติดกันเป็นคำเดียว**
// ทุกจุด interpolate จาก BRAND_NAME เพื่อไม่ให้ค้างเป็นชื่อแบรนด์ก่อนหน้าตอน
// รีแบรนด์รอบถัดไป **ห้ามพิมพ์ชื่อแบรนด์เป็น literal ในไฟล์นี้**
//
// ⚠️ route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ทดลองเล่น · /about-us · /contact-us · /terms · /privacy · /line
// ⚠️ toggle cta เปิดอยู่ → /register และ /login เป็นเมนู navbar เองแล้ว และ
// /ทางเข้า ถูกถอดออกจากเมนูด้วยเหตุผลว่ามันเป็นลิงก์ที่สามไปยังสองที่เดิม —
// หน้านี้จึงไม่วางปุ่ม "ไปหน้าทางเข้า" ซ้ำอีก (หน้ายัง route + index อยู่ตามปกติ
// และ footer ยังลิงก์ไปหาได้)
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกม ชื่อผู้ให้บริการ หน่วยงานกำกับ เลขใบอนุญาต
// ปีก่อตั้ง จำนวนสมาชิก จำนวนเกม ค่า RTP หรือยอดขั้นต่ำที่เป็นตัวเลข แม้แต่
// รายการเดียว** จึงห้ามเขียนลงหน้าเว็บ · ตัวเลขที่ขึ้นหน้าได้มีแค่ของบรีฟเอง:
// **0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง** และ **ไม่มี 100%**
//
// 🚨 **บรีฟรอบนี้โฆษณาแล้วกำกับตัวเองในย่อหน้าเดียวกันแทบทุกย่อหน้า** — ทั้งสอง
// ครึ่งต้อง ship ครบ ประโยคกำกับไม่ใช่ filler ให้ตัดทิ้ง:
// 1) คำกล่าวอ้างเกี่ยวกับการเป็นเจ้าของระบบเกม เว็บตรง และลิขสิทธิ์ถูกต้อง
//    ควรตรวจสอบข้อมูลบริษัทและหลักฐานการได้รับอนุญาตจากแหล่งที่เชื่อถือได้ก่อนใช้งาน
//    (บรีฟบรรทัด 4 — รับที่ h1 และ h2 #2)
// 2) ควรตรวจสอบรายชื่อผู้พัฒนาเกม ความน่าเชื่อถือของระบบเซิร์ฟเวอร์ และนโยบาย
//    คุ้มครองข้อมูลส่วนบุคคลให้ชัดเจน เพราะคำกล่าวอ้างว่าใช้เซิร์ฟเวอร์แท้หรือ
//    ปลอดภัยในไทย ไม่สามารถยืนยันได้จากข้อความโฆษณาเพียงอย่างเดียว
//    (บรีฟบรรทัด 6 — รับที่ h2 #1 และ #2)
// 3) ควรตรวจสอบข้อกำหนดด้านอายุ กฎหมายที่เกี่ยวข้อง และนโยบายความเป็นส่วนตัว ·
//    ควรตรวจสอบว่าข้อความไม่มีขั้นต่ำครอบคลุมเฉพาะการสมัครหรือรวมถึงการฝากเงิน
//    และการเดิมพันด้วย · ไม่เปิดเผยรหัสผ่านและรหัส OTP ให้ใครทราบ
//    (บรีฟบรรทัด 14, 18 — รับที่ h2 #3)
// 4) โปรโมชั่นแต่ละรายการอาจกำหนดประเภทเกม ยอดที่นำมาคำนวณ รอบรับสิทธิ์ และ
//    ข้อจำกัดการถอนเงินแตกต่างกัน · ควรศึกษาข้อกำหนดการใช้โบนัสและการถอนเงิน
//    ก่อนรับเครดิต · โปรโมชั่นคืนยอดเสียไม่ได้รับประกันว่าจะได้รับเงินคืนจากทุก
//    การเดิมพันหรือเพิ่มโอกาสชนะในครั้งถัดไป · แม้ระบุว่าไม่จำกัด แต่ควรตรวจสอบ
//    ข้อกำหนดเกี่ยวกับจำนวนบัญชี วงเงินโบนัส และเงื่อนไขการถอนเงิน
//    (บรีฟบรรทัด 8, 10, 12 — รับที่ h2 #4)
// 5) ควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชี
//    แอบอ้าง · เก็บหมายเลขรายการและหลักฐานไว้ · ตรวจสอบเวลาการให้บริการจริงจาก
//    ประกาศล่าสุดอีกครั้ง (บรีฟบรรทัด 22 — รับที่ h2 #5)
//
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) **กลับทิศ 180° จากรอบก่อน: รอบนี้เนื้อหาสว่าง
// ส่วนโครมเข้ม** bg.json ของดรอปนี้คือ {"mode":"color","color":"#f7e4e9"} =
// **ชมพูบลัชจาง** (รอบก่อนเป็นเขียวป่าจมเกือบดำ ซึ่งอยู่คนละปลายของสเกล —
// เปิด bg.json อ่านทุกรอบ ห้ามสืบทอด)
// **ห้าม "แก้" การ์ด/ปุ่มกลับไปเป็นผิวเข้ม** — ผิวเข้มบนหมึก 36080f =
// ตัวอักษรหายไปเลย ไม่ใช่แค่จางลง
// ค่าที่ใช้ได้ในไฟล์นี้: `<strong>`/marker/ลิงก์ **#a30d1a** (7.4:1 บนการ์ด #fdf5f6) ·
// เนื้อความ #36080f (16.3:1) · หมึกรอง #6b2b33 (9.7:1) · ทองเข้ม #7a4a0c (7.0:1) ·
// พื้นไล่เฉดปุ่มหลัก #8a1420 -> #a30d1a -> #c21325 (**พื้นถม** + หมึกขาว #ffffff —
// 9.5 / 8.0 / 6.2:1 ต่อ stop) · ปุ่มรองเป็น #fdf5f6 -> #f7dfe4 คู่กับหมึก #a30d1a
// ขอบ #d98fa0 · ปุ่ม outline ขอบ+ตัวอักษร #a30d1a บนผิว #fdf5f6 · ชั้นยก/ชิป
// #f7dfe4 · เส้นบาง #eec3cc · ขอบตกแต่ง #d98fa0 (**สองค่าท้ายห้ามถือตัวอักษร**)
// หมึกเนื้อความคือ #36080f (= BRAND_TEXT) ซึ่ง **ไม่ประกาศในไฟล์นี้** การ์ด
// ContentBox ตั้งไว้ให้แล้วและย่อหน้าสืบทอดลงมา
// 🚨🚨 **#eec3cc (1.5:1) · #d98fa0 (2.3:1) · #ef4a5e — ห้ามเป็นสีตัวอักษร**
// สามค่านั้นเป็นเส้น/ขอบ/ออรา/พื้นถมเท่านั้น ปุ่มหลักจึงจบไล่เฉดที่ #c21325
// ออราที่อนุญาต: rgba(163,13,26,α) · rgba(220,165,58,α) · rgba(217,143,160,α) ·
// rgba(54,8,15,α)
// 🚨🚨 **spec สามรอบก่อนเขียนว่า "รอบนี้ไม่มีแดงเป็นสี UI เลยสักเฉด" — รอบนี้
// กลับทิศเต็มๆ แดงชาดคือฮิวนำของแบรนด์** ที่ห้ามคือ **ค่าเฮกซ์ของแบรนด์เก่าแบบ
// ตรงหกหลัก** ไม่ใช่ "สีแดง" ในฐานะตระกูลสี และเพราะมีแบรนด์แดงมาแล้วสามเจ้า
// ต้องเทียบ **ทีละค่า** กับตาราง brand-spec §2 (คู่ที่พิมพ์ผิดง่ายสุดลิสต์ไว้ในนั้น
// แล้ว และเขียนแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep สะดุด)
// ⚠️ ข้อยกเว้นสีเชิงความหมาย: **LINE green #00B900** บนปุ่ม LINE (ต้องเป็นพื้นถม
// ของค่านั้น + ตัวอักษรขาว) **ห้ามเปลี่ยนเป็นแดงตามพาเลตรอบนี้**
// ⚠️ โถงวังหินอ่อนงาช้าง มงกุฎทองประดับอัญมณีแดง ชุดราตรีแดง-ขาว ชิปคาสิโนแดง-ขาว
// ไพ่เอซโพดำ และสีผิวนางแบบในอาร์ตเวิร์กเป็น **วัตถุในภาพ ไม่ใช่สี UI**
// · และ **เวิร์ดมาร์กแดงชาด-โครเมียมเงินก็เป็นอาร์ตเวิร์ก ไม่ใช่สี UI**
//
// ลำดับปุ่มในไฟล์นี้สื่อด้วยพื้นถมสามขั้ว (ตรงกับคู่ปุ่มที่ล็อกไว้ใน brand-spec §2):
// · ปุ่มหลัก (สมัครสมาชิก) ไล่เฉด #8a1420 -> #a30d1a -> #c21325 หมึกขาว #ffffff
// · ปุ่มรอง (เข้าสู่ระบบ) ไล่เฉด #fdf5f6 -> #f7dfe4 หมึก #a30d1a ขอบ #d98fa0
// · ปุ่มลิงก์ภายในเป็นปุ่ม outline ขอบ #a30d1a ตัวอักษร #a30d1a บนผิว #fdf5f6
//   hover ยกพื้นขึ้นเป็นชั้นยก #f7dfe4
// · ชิปไอคอนของรายการใช้ขอบ #eec3cc บนชั้นยก #f7dfe4 ไม่ถือตัวอักษร
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง และไม่ใส่ mx-auto / max-w-* บน <p>
// เพราะการ์ดคุมความกว้างเองแล้ว — ที่ประกาศสีได้มีแค่ปุ่ม ชิปไอคอน marker ของ
// ลำดับเลข และ <strong> · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง
// เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำ
// จะขาดครึ่ง (ลบแท็ก <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิม) และห้ามวาง
// <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังใน prop ที่เป็นข้อความ และต้องเป็นไอคอนหมวดเกมคาสิโนของรอบนี้
// slot ของ ContentBox รับ **หนึ่ง element** เท่านั้น จึงห่อด้วย <div> ชั้นเดียว
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: รูปของดรอปนี้ถูกตรึงไว้ที่อื่นครบทุกไฟล์ —
// สไลด์สองใบของดรอปถูกตรึงไว้กับ index และ /promotion · banner1 /
// banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// แบนเนอร์ใบที่สองและสาม (2026-10-23) กับสไลด์ใบที่สามและสี่ (2026-09-29)
// เป็นอาร์ตเวิร์กของแบรนด์อื่น **ห้าม import ทั้งสี่ไฟล์**
// (ชื่อไฟล์เต็มอยู่ใน brand-spec §6) (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง
// dist/ และ verify-build จะแดง) — ไฟล์ทั้งหมดยังอยู่บนดิสก์ **ห้ามลบ**
// เป็นอินเวนทอรีของแบรนด์ถัดไป · อาร์ตสต็อกกลางของเทมเพลตถูกตรึงไว้กับ /ทดลองเล่น
//
// Announcement รอบนี้หมุนมาเป็นตัวท้ายชื่อเลขห้า ทั้งเว็บ (brand-spec §3 — รอบก่อน
// ใช้ตัวท้ายชื่อเลขสามจึงหมุนออก · เขียนชื่อไฟล์แบบไม่มีเครื่องหมายคำพูดโดยตั้งใจ
// เพราะ tools/gen-tw-sources.mjs นับ literal ที่มีเครื่องหมายคำพูดว่าเป็นการ import
// จริง) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว
// จึงเรียกแบบ bare **ห้ามส่ง prop message** มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -c บนเชลล์นี้
// ก็นับเป็นไบต์ ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับตัวนับ
// ของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 158 อักขระ (ชื่อแบรนด์รอบนี้ 6 อักขระ) เป็นประโยคเดียวที่บอกว่า
// หน้านี้มีอะไร แล้วหยุด
// (Google ตัดราว 160 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนๆ ยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} เว็บเกมคาสิโนออนไลน์ หน้ารวมข้อมูลเจ็ดหมวดเดิมพัน ระบบสมาชิก โปรโมชั่นคืนยอดเสียและแนะนำเพื่อน พร้อมสิ่งที่ควรตรวจสอบเองก่อนเริ่มใช้บริการ`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} เว็บเกมคาสิโนออนไลน์ที่รวมเจ็ดหมวดเดิมพันไว้ในที่เดียว`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

// คลาสปุ่มสามขั้วของหน้านี้ ประกาศครั้งเดียวแล้วใช้ซ้ำ เพื่อไม่ให้สองปุ่มที่ทำ
// หน้าที่เดียวกันหลุดไปคนละเฉดตอนรีแบรนด์รอบหน้า
const ctaPrimary =
  "flex items-center justify-center rounded-full border border-[#8a1420] bg-gradient-to-b from-[#8a1420] via-[#a30d1a] to-[#c21325] px-8 py-3 font-black text-white shadow-[0_6px_18px_rgba(163,13,26,0.32)] transition-transform hover:scale-105";

const ctaSecondary =
  "flex items-center justify-center rounded-full border border-[#d98fa0] bg-gradient-to-b from-[#fdf5f6] to-[#f7dfe4] px-8 py-3 font-bold text-[#a30d1a] shadow-[0_6px_18px_rgba(54,8,15,0.14)] transition-transform hover:scale-105";

const ctaQuiet =
  "flex items-center justify-center rounded-full border-2 border-[#a30d1a] bg-[#fdf5f6] px-8 py-3 font-bold text-[#a30d1a] shadow-[0_4px_14px_rgba(54,8,15,0.1)] transition-all hover:scale-105 hover:bg-[#f7dfe4] hover:shadow-[0_6px_18px_rgba(163,13,26,0.22)]";

const listChip = "mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#eec3cc] bg-[#f7dfe4] text-sm";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#a30d1a]">{BRAND_NAME} นำเสนอข้อมูลเกมคาสิโนออนไลน์หลากหลายประเภท พร้อมระบบสมาชิกที่รองรับการใช้งานผ่านมือถือ</strong>
        หน้านี้สรุปไว้ว่าเว็บไซต์ระบุอะไรไว้บ้าง และควรเปิดอ่านรายละเอียดส่วนไหนก่อน เพื่อให้เห็นภาพรวมก่อนไล่อ่านกติกาเกมและเงื่อนไขของแต่ละรายการเป็นรายข้อ
      </p>

      <p>
        เว็บไซต์อธิบายตัวเองไว้ว่าเป็น
        <strong class="text-[#a30d1a]">เจ้าของบาคาร่าสล็อต เว็บตรง ถูกลิขสิทธิ์ ครบทุกค่าย เซิร์ฟแท้ ปลอดภัยในไทย</strong>
        ซึ่งทั้งหมดนั้นเป็นข้อความที่เว็บไซต์แจ้งไว้ ไม่ใช่ข้อสรุปของหน้านี้ เพราะผู้ใช้งานสามารถศึกษากติกาเกม โปรโมชั่น และรายละเอียดบริการได้ในเว็บไซต์เดียว แต่แต่ละหมวดก็มีเงื่อนไขของตัวเองที่ไม่ได้เหมือนกันทั้งหมด
      </p>

      <p>
        <strong class="text-[#a30d1a]">ส่วนคำกล่าวอ้างเกี่ยวกับการเป็นเจ้าของระบบเกม เว็บตรง และลิขสิทธิ์ถูกต้อง ควรตรวจสอบข้อมูลบริษัทและหลักฐานการได้รับอนุญาตจากแหล่งที่เชื่อถือได้ก่อนใช้งาน</strong>
        เนื้อหาในหน้านี้จึงเขียนไว้ประกอบการใช้งานเท่านั้น ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้บริการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`บาคาร่า สล็อต ไฮโล รูเล็ต ยิงปลา บอล หวย เจ็ดหมวดที่ ${BRAND_NAME} รวบรวมไว้`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#a30d1a]">{BRAND_NAME} รวบรวมข้อมูลเกมเดิมพันไว้เจ็ดหมวด โดยแต่ละประเภทมีรูปแบบการเล่นและอัตราจ่ายไม่เหมือนกัน</strong>
        รายการด้านล่างคือหมวดที่เว็บไซต์ระบุไว้ และเป็นจุดเริ่มต้นสำหรับคนที่ยังไม่แน่ใจว่าควรเปิดอ่านกติกาของส่วนไหนก่อน
      </p>

      <ul class="flex flex-col gap-4" aria-label="หมวดเกมเดิมพันที่เว็บไซต์ระบุไว้">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🃏</span>
          <span>
            <strong class="text-[#a30d1a]">บาคาร่า</strong> เป็นเกมไพ่ที่คิดผลจากแต้มของสองฝั่ง รูปแบบการวางเดิมพันและอัตราจ่ายของแต่ละช่องไม่เท่ากัน จึงควรอ่านกติกาของโต๊ะที่กำลังเปิดอยู่ก่อนลงเดิมพัน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎰</span>
          <span>
            <strong class="text-[#a30d1a]">สล็อตออนไลน์</strong> เป็นเกมหมุนวงล้อที่แต่ละเกมมีฟีเจอร์และเงื่อนไขการคิดรางวัลของตัวเอง ข้อความรวมที่หน้าแรกเป็นคำอธิบายภาพรวม ไม่ได้แทนรายละเอียดของเกมที่เปิดอยู่จริง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎲</span>
          <span>
            <strong class="text-[#a30d1a]">ไฮโล</strong> เป็นเกมทอยลูกเต๋าที่แต่ละช่องเดิมพันมีอัตราจ่ายต่างกัน จึงควรดูตารางอัตราจ่ายของโต๊ะนั้นก่อนเลือกช่องที่จะลง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎡</span>
          <span>
            <strong class="text-[#a30d1a]">รูเล็ต</strong> เป็นเกมวงล้อที่มีกติกาเฉพาะตัว การวางเดิมพันแบบตัวเลขเดี่ยวกับแบบกลุ่มคิดผลคนละแบบ จึงควรอ่านรูปแบบการวางของโต๊ะนั้นให้ครบก่อนเริ่ม
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🐟</span>
          <span>
            <strong class="text-[#a30d1a]">ยิงปลา</strong> เป็นเกมที่คิดผลจากเป้าหมายในฉากและกระสุนที่ใช้ ซึ่งแต่ละห้องกำหนดค่าไว้ไม่เท่ากัน จึงควรดูเงื่อนไขของห้องที่เข้าอยู่ก่อนเริ่มยิง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>⚽</span>
          <span>
            <strong class="text-[#a30d1a]">เดิมพันฟุตบอล</strong> เป็นการเดิมพันผลการแข่งขัน ซึ่งมีรูปแบบการคิดผลหลายแบบในแต่ละคู่ จึงควรอ่านเงื่อนไขของบิลที่กำลังทำรายการให้ครบก่อนยืนยัน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎫</span>
          <span>
            <strong class="text-[#a30d1a]">หวยออนไลน์</strong> เป็นหนึ่งในเจ็ดหมวดที่เว็บไซต์ระบุไว้ โดยรายละเอียดและเงื่อนไขการรับรางวัลให้ดูจากหน้าของหมวดนั้นในขณะใช้บริการ
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#a30d1a]">ผู้ใช้งานควรตรวจสอบรายชื่อผู้พัฒนาเกมและวงเงินเดิมพันของหมวดที่กำลังจะเล่นก่อนทำรายการ</strong>
        เพราะเกมแต่ละหมวดกำหนดไว้ไม่เหมือนกัน และรายการที่เปิดให้บริการในแต่ละช่วงก็ไม่ได้ครบทุกหมวดเสมอไป
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/ทดลองเล่น" aria-label={`เปิดหน้าทดลองเล่นของ ${BRAND_NAME}`} class={ctaQuiet}>ไปหน้าทดลองเล่น</a>

        <a href="/promotion" aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`} class={ctaQuiet}>ดูภาพโปรโมชั่น</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="สิ่งที่ควรตรวจสอบเองก่อนเชื่อข้อความโฆษณาบนหน้าเว็บ" as="h2">
    <div class="flex flex-col gap-6">
      <p>
        หัวข้อบนหน้าเว็บระบุไว้ว่าเป็น
        <strong class="text-[#a30d1a]">เซิร์ฟแท้ ปลอดภัยในไทย</strong>
        ซึ่งเป็นถ้อยคำโฆษณาของเว็บไซต์เอง หัวข้อนี้จึงแยกให้ชัดระหว่างสิ่งที่เว็บไซต์ระบุไว้ กับสิ่งที่ผู้ใช้งานตรวจสอบเองได้จากหน้ารายละเอียดจริง
      </p>

      <ul class="flex flex-col gap-4" aria-label="สิ่งที่ควรตรวจสอบด้วยตัวเองก่อนใช้งาน">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🏢</span>
          <span>
            <strong class="text-[#a30d1a]">ข้อมูลบริษัทและหลักฐานการได้รับอนุญาต</strong> ควรตรวจสอบจากแหล่งที่เชื่อถือได้ก่อนใช้งาน เพราะคำกล่าวอ้างเรื่องการเป็นเจ้าของระบบเกมและลิขสิทธิ์ถูกต้องยืนยันจากข้อความบนหน้าเว็บอย่างเดียวไม่ได้
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🛡️</span>
          <span>
            <strong class="text-[#a30d1a]">ความน่าเชื่อถือของระบบเซิร์ฟเวอร์และนโยบายคุ้มครองข้อมูลส่วนบุคคล</strong> ควรตรวจสอบให้ชัดเจน เพราะคำกล่าวอ้างว่าใช้เซิร์ฟเวอร์แท้หรือปลอดภัยในไทย ไม่สามารถยืนยันได้จากข้อความโฆษณาเพียงอย่างเดียว
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📄</span>
          <span>
            <strong class="text-[#a30d1a]">รายชื่อเกมและผู้พัฒนาที่เปิดใช้งานจริง</strong> ควรดูจากหน้ารายละเอียดในขณะใช้บริการ ว่าตรงกับหมวดที่ประกาศไว้หรือไม่ แทนที่จะอ่านจากข้อความสรุปที่เขียนไว้ล่วงหน้า
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#a30d1a]">หน้านี้จึงชี้ว่าควรอ่านอะไรและเปิดดูจากที่ไหน แทนที่จะยืนยันแทนเว็บไซต์</strong>
        เพราะสิ่งที่ยืนยันได้จริงคือเอกสารและเงื่อนไขที่แสดงอยู่บนหน้ารายละเอียดในขณะใช้บริการ ไม่ใช่ข้อความสรุปที่เขียนไว้ล่วงหน้า
