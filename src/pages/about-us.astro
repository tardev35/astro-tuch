---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion,
// /login, /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์
// หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ (src/assets/content.txt) ไม่มี
// ส่วน SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่จากข้อเท็จจริงและคลังคำของบรีฟรอบนี้
// เท่านั้น (.claude/brand-spec-ruay168.md §4-§5)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x5 · h3x0
//   h1  เกี่ยวกับเรา <แบรนด์> แทงหวยเว็บรวย รับแทงเลขออนไลน์ทุกประเภท
//   h2  ประเภทหวยที่ <แบรนด์> รวบรวมไว้ รัฐบาลไทย ลาว ฮานอย ออมสิน
//   h2  อัตราจ่ายหวย <แบรนด์> บาทละ 1,000 รวมถึง 2 ตัว 100 และ 3 ตัว 1,000
//   h2  โปรโมชั่นสมาชิก <แบรนด์> คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%
//   h2  ระบบฝากถอน <แบรนด์> ผ่านธนาคารและทรูมันนี่
//   h2  ช่องทางติดต่อแอดมินแทงหวย <แบรนด์> ตลอด 24ชม.
// รายการในกล่องเป็น <ul> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) และจาก footer จึงเปิดใช้งานอยู่
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// เป็นของแบรนด์เก่ามาก ตัวที่ routing จริงคือไฟล์นี้ Astro ไม่อ่านโฟลเดอร์นั้นเลย
// **ห้ามแก้ ห้ามลบ และห้ามสลับมาแทนไฟล์นี้**
//
// 🚨🚨 แกนของดรอปนี้ (2026-10-23) คือ **เว็บหวย (หวยออนไลน์)** ไม่ใช่เว็บเกม
// บรีฟเรียกตัวเองว่า "แทงหวยเว็บรวย รับแทงเลขออนไลน์ทุกประเภท" และระบุ
// หวยรัฐบาลไทย · หวยลาว · หวยฮานอย · หวยออมสิน · บาทละ 1,000 · 2 ตัว 100 ·
// 3 ตัว 1,000 · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · ธนาคารและทรูมันนี่ ·
// แอดมิน 24ชม.
// ⚠️⚠️ **แบรนด์ขาออกเป็นเว็บเกมคนละหมวดกับรอบนี้** คำนิยามตัวเองของหมวดนั้น
// (ทั้งชื่อหมวดเกม คำโฆษณาแบบจ่ายแบบไม่มีเพดาน และคำโบนัสรายวัน) จึงเป็นคำค้างของ
// แบรนด์ขาออก **ไม่ใช่ของรอบนี้** — **รายการคำต้องห้ามเต็มอยู่ใน brand-spec §5
// ไม่พิมพ์ซ้ำที่นี่** เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive ใน
// คอมเมนต์ของไฟล์นี้เอง
// ⚠️⚠️ ชื่อแบรนด์รอบนี้เป็น **ภาษาไทยผสมเลข** ห้ามสะกดด้วยตัวละตินที่ไหนทั้งสิ้น
// (ดู brand-spec §0) ทุกจุดต้อง interpolate จาก BRAND_NAME ห้ามพิมพ์ตรงๆ
// ⚠️ `ทดลองเล่น` เหลือรอดได้เฉพาะในฐานะ **ชื่อ route /ทดลองเล่น** ซึ่งเป็นหน้าที่มี
// อยู่จริง — ไม่ใช่คำที่คอปปี้ของหน้านี้จะอ้างเป็นคุณสมบัติของแบรนด์ได้
//
// ⚠️ **รอบนี้สองหน้าหมวดหวยเปิดอยู่** (/ตรวจหวย · /แนวทาง ย้ายเข้า src/pages/
// แล้วใน P1) ลิงก์ไปสอง route นั้นจากหน้านี้จึงถูกต้อง
// route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ทดลองเล่น · /ตรวจหวย · /แนวทาง · /about-us · /contact-us · /terms ·
// /privacy · /line
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อสำนักหวย ชื่อธนาคารรายตัว ชื่อผู้ให้บริการ
// หน่วยงานกำกับ ใบอนุญาต ปีก่อตั้ง จำนวนสมาชิก หรือยอดขั้นต่ำที่เป็นตัวเลข
// แม้แต่รายการเดียว** จึงห้ามเขียนลงหน้าเว็บ · ตัวเลขที่ขึ้นหน้าได้มีแค่ของบรีฟเอง:
// **บาทละ 1,000 · 2 ตัว 100 · 3 ตัว 1,000 · 0.3% · 0.8% · 24ชม.**
// ⚠️ อัตรา 3.2 (วิ่ง/โต๊ด) อยู่ **บนภาพแบนเนอร์เท่านั้น** ห้ามเขียนเป็นคำกล่าวอ้าง
// และไม่มีเปอร์เซ็นต์เต็มร้อย ไม่มีจำนวนขั้นตอนที่นับเป็นข้อ
//
// 🚨 **บรีฟรอบนี้โฆษณาแล้วเบรกตัวเองในย่อหน้าเดียวกันแทบทุกย่อหน้า** — ทั้งสอง
// ครึ่งต้อง ship ครบตามที่เขียน ประโยคเบรกไม่ใช่ filler ให้ตัดทิ้ง:
// 1) เลขเด็ดหรือสถิติย้อนหลังไม่สามารถรับประกันผลรางวัลในงวดถัดไปได้ (h1)
// 2) แต่ละประเภทมีวันประกาศผลและรูปแบบการออกรางวัลแตกต่างกัน · ไม่ใช่ทุกรายการ
//    ที่จะใช้อัตราจ่ายเดียวกัน (h2 #1)
// 3) ยังไม่สามารถยืนยันได้ว่าใช้อัตราเดียวกันกับหวยทุกประเภท ควรตรวจสอบตาราง
//    อัตราจ่าย ฐานเงินเดิมพัน และข้อจำกัดของแต่ละรายการก่อนยืนยันบิล (h2 #2)
// 4) เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกบิลหรือรับประกัน
//    ผลตอบแทนในงวดถัดไป · แม้โปรโมชั่นจะระบุว่าไม่จำกัด แต่ควรยืนยันข้อกำหนด
//    เกี่ยวกับจำนวนบัญชีที่เข้าร่วม รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัส (h2 #3)
// 5) หากพบชื่อบัญชีไม่ตรงกับข้อมูลทางการหรือมีการแจ้งเปลี่ยนบัญชีอย่างผิดปกติ
//    ควรหยุดทำรายการและติดต่อธนาคารหรือผู้ให้บริการชำระเงินก่อนโอนเงิน (h2 #4)
// 6) ควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชี
//    แอบอ้าง · ไม่เปิดเผยรหัสผ่านหรือรหัส OTP · ควรตรวจสอบเวลาการให้บริการจริง
//    จากประกาศล่าสุดอีกครั้ง (h2 #5)
//
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) เป็น **ธีมมืด ทอง x โครเมียมเงิน บนดำสนิท**
// bg.json ของดรอปนี้คือ {"mode":"color","color":"#000000"} = ดำสนิท
// **ห้าม "แก้" กลับไปเป็นการ์ดพื้นสว่าง** และ **ห้ามให้ค่าพื้น/ค่าขอบถือตัวอักษร**
// ค่าที่ใช้ได้ในไฟล์นี้: ทอง #ffd94a (<strong> + ตัวอักษรปุ่ม outline — 13.8:1 บน
// ผิวการ์ด ถือตัวอักษรได้) · ทองพื้นถม #e3a712 และ #b07d08 (**พื้นไล่เฉดของปุ่มหลัก
// เท่านั้น**) · #9d6f06 (**ขอบ/ออราเท่านั้น ห้ามถือตัวอักษรเด็ดขาด**) ·
// โครเมียมเงิน #e8eaee -> #b4b9c2 (**พื้นถมของปุ่มรองเท่านั้น**) · ขอบ #6b7079
// และ #3d3425 (**ห้ามถือตัวอักษร**) · ผิวจม #070707 และผิวยก #1c1a16 (พื้นปุ่ม/ชิป)
// หมึกเนื้อความคือ #f3ece0 (= BRAND_TEXT) ซึ่ง **ไม่ประกาศในไฟล์นี้** การ์ด
// ContentBox ตั้งไว้ให้แล้วและย่อหน้าสืบทอดลงมา
// 🚨🚨 **ขาวบนทองได้แค่ ~1.2-2.2:1 — ห้ามใส่หมึกขาวบนพื้นทองเด็ดขาด** ปุ่มทองและ
// ปุ่มโครเมียมจึงใช้ **หมึกดำ #0a0a0a** ทั้งคู่ (14.6 / 9.2 / 5.4:1 และ 16.6 / 10.5:1)
// ออราที่อนุญาต: rgba(255,217,74,α) · rgba(227,167,18,α) · rgba(176,125,8,α) ·
// rgba(232,234,238,α) · rgba(221,225,231,α) · rgba(0,0,0,α)
// ⚠️⚠️ **รอบนี้ไม่มีแดงเลยสักเฉด** — แดงคือสีนำของแบรนด์ขาออก การปล่อยแดงไว้ =
// ทั้งผิดพาเลตและหลงเหลือข้ามแบรนด์พร้อมกัน · ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีม่วง
// ไม่มีชมพู ไม่มีส้ม ไม่มีครีม ไม่มีพีช ไม่มีเขียว ยกเว้น **LINE green #00B900**
// บนปุ่ม LINE ซึ่งเป็นสีประจำแพลตฟอร์ม
// ⚠️⚠️ **ทอง/เหลืองเคยนำมาแล้วเกือบทุกแบรนด์ในรีโปนี้** การเจอทองในไฟล์จึงไม่
// พิสูจน์อะไรเลย ห้ามเทียบด้วยวงศ์สี ต้องเทียบ **ทีละค่า** กับตาราง brand-spec §2
// (ffd84d ของแบรนด์เก่าห่างจาก #ffd94a ของรอบนี้แค่ G1 — เจอที่ไหนแปลว่าพิมพ์ผิด
// เฮกซ์ของแบรนด์เก่าในคอมเมนต์เขียนแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep สะดุด)
// ⚠️ ผมขาวเงิน สูทขาว ลิปสติกแดง และสีผิวนักแสดงในอาร์ตเวิร์กเป็น **วัตถุในภาพ
// ไม่ใช่สี UI**
//
// ลำดับปุ่มในไฟล์นี้สื่อด้วยพื้นถมสามขั้ว (ตรงกับคู่ปุ่มที่ล็อกไว้ใน brand-spec §2):
// · ปุ่มหลัก (สมัครสมาชิก) ไล่เฉด #ffd94a -> #e3a712 -> #b07d08 หมึก #0a0a0a
// · ปุ่มรอง (เข้าสู่ระบบ) ไล่เฉด #e8eaee -> #b4b9c2 หมึก #0a0a0a
// · ปุ่มลิงก์ภายในเป็นปุ่ม outline ขอบ #ffd94a ตัวอักษร #ffd94a บนผิวจม #070707
//   hover ยกพื้นขึ้นเป็นผิวยก #1c1a16 (ตรงกับ hover ของการ์ด ContentBox)
// · ชิปไอคอนของรายการใช้ขอบ #3d3425 บนผิวยก #1c1a16 ไม่ถือตัวอักษร
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง และไม่ใส่ mx-auto / max-w-* บน <p>
// เพราะการ์ดคุมความกว้างเองแล้ว — ที่ประกาศสีได้มีแค่ปุ่ม ชิปไอคอน และ <strong>
// แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรค
// ระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง (ลบแท็ก
// <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิม) และห้ามวาง <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังใน prop ที่เป็นข้อความ และต้องเป็นไอคอนหมวดหวย ไม่ใช่ไอคอนหมวดเกม
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: รูปของดรอปนี้ถูกตรึงไว้ที่อื่นครบทุกไฟล์ —
// banner2/banner3 เป็นรูปประกอบบทความของ index §3-§4 · slide1/slide2 ถูกตรึงไว้กับ
// index §6-§7 กับ /promotion · banner1 / banner1-mobile / og.png เป็นของ glob ที่
// MainLayout ปักไว้ ห้ามอ้างจากหน้า · slide3/slide4 (mtime 2026-09-29) เป็น
// อาร์ตเวิร์กของอีกแบรนด์ ห้าม import · gamedemo* (mtime 2026-08-04) เป็นอาร์ต
// หมวดเกมของแบรนด์เก่า ห้าม import รอบนี้เช่นกัน
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง) —
// ไฟล์ทั้งหมดยังอยู่บนดิสก์ **ห้ามลบ** เป็นอินเวนทอรีของแบรนด์ถัดไป
//
// Announcement รอบนี้หมุนมาเป็น AnnouncementHuay ทั้งเว็บ (brand-spec §3 —
// รอบก่อนใช้ AnnouncementPremium จึงหมุนออก) orchestrator ตั้ง default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว จึงเรียกแบบ bare **ห้ามส่ง prop message**
// มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 155 อักขระ (ชื่อแบรนด์รอบนี้ 6 ตัวอักษร) เป็นประโยคเดียวที่บอกว่า
// หน้านี้มีอะไร แล้วหยุด
// (Google ตัดราว 155 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} รวมข้อมูลแทงหวยออนไลน์ทั้งหวยรัฐบาลไทย ลาว ฮานอย ออมสิน อัตราจ่ายบาทละ 1,000 โปรโมชั่นคืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% และช่องทางฝากถอน`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} แทงหวยเว็บรวย รับแทงเลขออนไลน์ทุกประเภท`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

// คลาสปุ่มสามขั้วของหน้านี้ ประกาศครั้งเดียวแล้วใช้ซ้ำ เพื่อไม่ให้สองปุ่มที่ทำ
// หน้าที่เดียวกันหลุดไปคนละเฉดตอนรีแบรนด์รอบหน้า
const ctaPrimary =
  "flex items-center justify-center rounded-lg border border-[#9d6f06] bg-gradient-to-b from-[#ffd94a] via-[#e3a712] to-[#b07d08] px-8 py-3 font-black text-[#0a0a0a] shadow-[0_6px_18px_rgba(227,167,18,0.35)] transition-transform hover:scale-105";

const ctaSecondary =
  "flex items-center justify-center rounded-lg border border-[#6b7079] bg-gradient-to-b from-[#e8eaee] to-[#b4b9c2] px-8 py-3 font-bold text-[#0a0a0a] shadow-[0_6px_18px_rgba(232,234,238,0.25)] transition-transform hover:scale-105";

const ctaQuiet =
  "flex items-center justify-center rounded-lg border-2 border-[#ffd94a] bg-[#070707] px-8 py-3 font-bold text-[#ffd94a] shadow-[0_4px_14px_rgba(0,0,0,0.35)] transition-all hover:scale-105 hover:bg-[#1c1a16] hover:shadow-[0_6px_18px_rgba(227,167,18,0.25)]";

const listChip = "mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#3d3425] bg-[#1c1a16] text-sm";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#ffd94a]">{BRAND_NAME} นำเสนอข้อมูลหวยออนไลน์หลากหลายประเภท ทั้งหวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยออมสิน</strong>
        พร้อมรายละเอียดอัตราจ่ายและรอบประกาศผลที่แตกต่างกัน หน้านี้รวบรวมไว้ว่าเว็บไซต์ระบุอะไรไว้บ้าง เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดอ่านอะไรตรงไหน แล้วจึงค่อยไล่อ่านรายละเอียดของแต่ละหัวข้อเป็นรายข้อ
      </p>

      <p>
        ผู้ใช้งานสามารถศึกษารูปแบบการเลือกหมายเลข ตรวจสอบเงื่อนไขการเดิมพัน และติดตามข้อมูลเลขดังจากแหล่งต่าง ๆ ได้
        <strong class="text-[#ffd94a]">โดยควรตรวจสอบความถูกต้องของข้อมูลก่อนทำรายการทุกครั้ง</strong>
        เพราะแต่ละประเภทหวยวางรอบปิดรับและเงื่อนไขของตัวเองไว้คนละชุด จึงควรเปิดอ่านทีละรายการแทนการเทียบจากรายการอื่นที่เคยเปิดไว้
      </p>

      <p>
        สิ่งที่หน้านี้ทำได้คือชี้ว่าข้อมูลแต่ละชุดอยู่ตรงไหนและควรอ่านอะไรก่อน
        <strong class="text-[#ffd94a]">เพราะเลขเด็ดหรือสถิติย้อนหลังไม่สามารถรับประกันผลรางวัลในงวดถัดไปได้</strong>
        เนื้อหาในหน้านี้จึงเขียนไว้ประกอบการใช้งานเท่านั้น ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้บริการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`ประเภทหวยที่ ${BRAND_NAME} รวบรวมไว้ รัฐบาลไทย ลาว ฮานอย ออมสิน`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#ffd94a]">{BRAND_NAME} รวบรวมข้อมูลหวยหลายประเภทไว้ในช่องทางเดียว</strong>
        รายการด้านล่างคือประเภทที่ระบุไว้ และควรไล่อ่านให้ครบก่อนเลือกงวดที่จะลง เพราะแต่ละประเภทอ้างอิงแหล่งผลรางวัลคนละแหล่งกัน
      </p>

      <ul class="flex flex-col gap-4" aria-label="ประเภทหวยที่ระบุไว้">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎫</span>
          <span>
            <strong class="text-[#ffd94a]">หวยรัฐบาลไทย</strong> อ้างอิงผลสลากกินแบ่งรัฐบาล จึงควรดูรอบปิดรับของงวดนั้นให้ตรงกับวันประกาศผลที่ประกาศไว้จริง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🗓️</span>
          <span>
            <strong class="text-[#ffd94a]">หวยลาวและหวยฮานอย</strong> มีรอบออกรางวัลเป็นของตัวเอง ควรตรวจว่ารายการที่เปิดอยู่ในขณะนั้นเป็นรอบใด ก่อนเลือกหมายเลขและยืนยันบิล
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🏦</span>
          <span>
            <strong class="text-[#ffd94a]">รายการที่เกี่ยวข้องกับผลรางวัลออมสิน</strong> ใช้รูปแบบการออกรางวัลคนละแบบกับหวยรัฐบาลไทย จึงควรอ่านเงื่อนไขของรายการนั้นโดยตรง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📊</span>
          <span>
            <strong class="text-[#ffd94a]">ข้อมูลเลขเด็ดและเลขดังจากสำนักต่าง ๆ</strong> เป็นข้อมูลประกอบการตัดสินใจเท่านั้น ไม่ใช่ผลที่ยืนยันได้ล่วงหน้าของงวดถัดไป
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#ffd94a]">แต่ละประเภทมีวันประกาศผลและรูปแบบการออกรางวัลแตกต่างกัน</strong>
        และไม่ใช่ทุกรายการที่จะใช้อัตราจ่ายเดียวกัน จึงควรยึดตารางของประเภทที่กำลังจะลงเป็นหลัก มากกว่าสรุปจากประเภทที่เคยลงไว้ก่อนหน้า
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/ตรวจหวย" aria-label={`เปิดหน้าตรวจหวยของ ${BRAND_NAME}`} class={ctaQuiet}>ไปหน้าตรวจหวย</a>

        <a href="/แนวทาง" aria-label={`เปิดหน้าแนวทางของ ${BRAND_NAME}`} class={ctaQuiet}>ไปหน้าแนวทาง</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`อัตราจ่ายหวย ${BRAND_NAME} บาทละ 1,000 รวมถึง 2 ตัว 100 และ 3 ตัว 1,000`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#ffd94a]">{BRAND_NAME} ระบุอัตราจ่ายไว้ที่บาทละ 1,000</strong>
        สำหรับอัตราที่ระบุไว้แบบนี้ ควรตรวจสอบว่าใช้กับการเดิมพันประเภทใด รวมถึงฐานเงินเดิมพันและวงเงินจ่ายสูงสุดของแต่ละรอบ ก่อนเลือกหมายเลขและกดยืนยัน
      </p>

      <ul class="flex flex-col gap-4" aria-label="อัตราจ่ายที่ควรตรวจสอบก่อนยืนยันบิล">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🔢</span>
          <span>
            <strong class="text-[#ffd94a]">อัตราจ่าย 2 ตัว 100</strong> เป็นข้อมูลสำหรับการเดิมพันหมายเลขสองหลัก ควรตรวจว่าอัตราดังกล่าวใช้กับเลขสองตัวบนหรือสองตัวล่าง และคำนวณจากเงินเดิมพันจำนวนเท่าใด
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎯</span>
          <span>
            <strong class="text-[#ffd94a]">อัตราจ่าย 3 ตัว 1,000</strong> เป็นข้อมูลของหมายเลขสามหลัก ควรตรวจว่าใช้กับสามตัวตรง สามตัวโต๊ด หรือรูปแบบการเดิมพันประเภทใด
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🧾</span>
          <span>
            <strong class="text-[#ffd94a]">ข้อจำกัดการรับหมายเลขและเงื่อนไขการจ่ายรางวัล</strong> ควรตรวจก่อนยืนยันบิลทุกครั้ง เพื่อให้เข้าใจจำนวนเงินที่มีสิทธิ์ได้รับตามข้อกำหนดจริง
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#ffd94a]">ยังไม่สามารถยืนยันได้ว่าใช้อัตราเดียวกันกับหวยทุกประเภท</strong>
        จึงควรตรวจสอบตารางอัตราจ่าย ฐานเงินเดิมพัน และข้อจำกัดของแต่ละรายการจากข้อมูลล่าสุดก่อนยืนยันบิล และควรตรวจหมายเลขที่เลือกอีกครั้งก่อนกด เพราะผลการออกรางวัลมีความไม่แน่นอนและคาดการณ์จากเลขย้อนหลังได้ไม่แม่นยำ
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`โปรโมชั่นสมาชิก ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} นำเสนอข้อมูลโปรโมชั่นสำหรับสมาชิก โดยมีรายการ
        <strong class="text-[#ffd94a]">คืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8%</strong>
        เป็นสิทธิพิเศษที่ระบุไว้ และสามารถติดตามประกาศโปรโมชั่นประจำเดือนพร้อมตรวจสอบเงื่อนไขก่อนรับสิทธิ์ได้
      </p>

      <p>
        รายการคืนยอดเสียระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขรายวัน
        <strong class="text-[#ffd94a]">สมาชิกควรตรวจสอบว่าหวยรัฐบาลไทย ลาว ฮานอย หรือหวยประเภทใดเข้าร่วมรายการ รวมถึงรอบเวลาคำนวณยอดและวิธีรับเครดิต</strong>
        เพราะหวยแต่ละประเภทมีรอบประกาศผลแตกต่างกัน ทั้งนี้ เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกบิลหรือรับประกันผลตอบแทนในงวดถัดไป
      </p>

      <p>
        ส่วนรายการแนะนำเพื่อนระบุสิทธิ์ไว้สำหรับสมาชิกที่แนะนำผู้ใช้งานรายใหม่ โดยควรตรวจสอบวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และยอดที่ใช้คำนวณโบนัสให้ครบถ้วน
        <strong class="text-[#ffd94a]">แม้โปรโมชั่นจะระบุว่าไม่จำกัด แต่ควรยืนยันข้อกำหนดเกี่ยวกับจำนวนบัญชีที่เข้าร่วม รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุด</strong>
        เพื่อให้เข้าใจหลักเกณฑ์การรับสิทธิ์และหลีกเลี่ยงความคลาดเคลื่อนเกี่ยวกับยอดเครดิตที่ได้รับ
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/promotion" aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`} class={ctaQuiet}>ดูภาพโปรโมชั่น</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`ระบบฝากถอน ${BRAND_NAME} ผ่านธนาคารและทรูมันนี่`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#ffd94a]">{BRAND_NAME} ระบุช่องทางฝากถอนผ่านธนาคารและทรูมันนี่</strong>
        เพื่อให้สมาชิกตรวจสอบวิธีทำรายการตามบริการที่เปิดใช้งานจริง รายการด้านล่างคือสิ่งที่ควรเปิดอ่านก่อนทำรายการครั้งแรก และควรตรวจซ้ำทุกครั้งที่กลับเข้ามาใหม่
      </p>

      <ul class="flex flex-col gap-4" aria-label="สิ่งที่ควรตรวจสอบก่อนฝากถอน">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>💳</span>
          <span>
            <strong class="text-[#ffd94a]">รายชื่อธนาคารที่รองรับและยอดขั้นต่ำ</strong> ควรดูจากบริการที่เว็บไซต์เปิดใช้งานอยู่จริงในขณะนั้น ไม่ใช่จากข้อความที่สรุปไว้สั้น ๆ เพียงบรรทัดเดียว
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🔎</span>
          <span>
            <strong class="text-[#ffd94a]">ชื่อบัญชีปลายทาง</strong> ควรตรงกับข้อมูลผู้ให้บริการที่ยืนยันได้ เพราะนี่คือจุดที่แยกการทำรายการตามปกติออกจากบัญชีแอบอ้างได้เร็วที่สุด
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>⏱️</span>
          <span>
            <strong class="text-[#ffd94a]">ระยะเวลาดำเนินการและข้อกำหนดการถอนเงิน</strong> ควรศึกษาให้ครบถ้วนก่อนทำธุรกรรม เพราะรายการที่มียอดสูงอาจต้องผ่านขั้นตอนตรวจสอบเพิ่มเติม
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#ffd94a]">หากพบชื่อบัญชีไม่ตรงกับข้อมูลทางการหรือมีการแจ้งเปลี่ยนบัญชีอย่างผิดปกติ ควรหยุดทำรายการทันที</strong>
        แล้วติดต่อธนาคารหรือผู้ให้บริการชำระเงินเพื่อตรวจสอบก่อนโอนเงิน เพราะเงื่อนไขที่แสดงอยู่ ณ เวลาทำรายการคือเงื่อนไขที่มีผลจริง
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/register" aria-label={`สมัครสมาชิก ${BRAND_NAME}`} class={ctaPrimary}>สมัครสมาชิก</a>

        <a href="/login" aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`} class={ctaSecondary}>เข้าสู่ระบบ</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`ช่องทางติดต่อแอดมินแทงหวย ${BRAND_NAME} ตลอด 24ชม.`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} ระบุช่องทางติดต่อเจ้าหน้าที่สำหรับผู้ใช้งานที่ต้องการสอบถามเกี่ยวกับประเภทหวย รอบปิดรับ อัตราจ่าย การตรวจบิล รายการฝากถอน และรายละเอียดโปรโมชั่น
        <strong class="text-[#ffd94a]">โดยควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง</strong>
        หากพบปัญหาเกี่ยวกับรายการหวยหรือธุรกรรม ควรเก็บหมายเลขรายการและหลักฐานที่เกี่ยวข้องไว้สำหรับตรวจสอบ พร้อมแจ้งรายละเอียดให้ชัดเจน โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP
      </p>

      <p>
        <strong class="text-[#ffd94a]">ทั้งนี้ ควรตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุดอีกครั้ง</strong>
        เพราะช่วงเวลาที่เจ้าหน้าที่รับเรื่องอาจปรับเปลี่ยนได้ตามที่ผู้ให้บริการกำหนด และระยะเวลาตอบกลับของแต่ละช่องทางอาจไม่เท่ากัน
      </p>

