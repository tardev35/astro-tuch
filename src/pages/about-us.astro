---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึงเขียนขึ้นใหม่
// บนข้อเท็จจริงของบรีฟรอบนี้เท่านั้น (src/assets/content.txt) ไม่ใช่แก้ทับประโยคเดิม
// ของแบรนด์ก่อน — ของเดิมทั้งย่อหน้าตั้งอยู่บนคำที่ brand-spec §6 สั่งห้าม
// จึงถูกเขียนใหม่ทั้งหมด
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) จึงเปิดใช้งานอยู่ และรอบนี้ operator สั่งให้
// คงไว้ ไม่ได้ park ลง src/pages-disabled/
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// ตัวที่ routing จริงคือไฟล์นี้ ตัวที่จอดไว้เป็นอินเวนทอรี ห้ามแก้และห้ามลบ
//
// ดรอปนี้ (2026-10-10) คือ **เว็บตรงฐานสล็อตหลัก ไม่ผ่านเอเย่นต์ ไม่ผ่านม้า**
// อัปเดตระบบเข้าเล่นใหม่ปี 2026 เป็นเว็บสล็อตล้วน ไม่ใช่เว็บหวยและไม่ใช่เว็บรวม
// ทุกหมวด (สองหน้าของหมวดหวยจอดอยู่ใน src/pages-disabled/ ไม่มี route จึงห้ามลิงก์
// ไปหา มิฉะนั้นเป็น href ตายที่ทำให้ build แดง) แง่มุมที่บรีฟระบุไว้มีเท่านี้:
// รองรับมือถือและคอมพิวเตอร์ · รวมเกมสล็อตหลายประเภทไว้ในบัญชีเดียว · สล็อตคลาสสิก
// เกมฟรีสปิน โบนัสตัวคูณ และเกมใหม่จากค่ายที่เปิดให้บริการ · เน้นจัดหมวดเกมให้เลือก
// ใช้งานง่าย ค้นหาเกม ตรวจสอบเครดิต โปรโมชั่น ประวัติรายการ · หน้าเข้าสู่ระบบ
// เมนูเลือกเกม ส่วนจัดการบัญชี · ข้อมูลผู้ดำเนินงานและรายชื่อค่ายเกมที่ตรวจสอบได้ ·
// คืนยอดเสีย 0.3% เข้ายูสทุกวัน · แนะนำเพื่อนแชร์ลิงก์ 0.8% จากยอดที่เข้าเกณฑ์ ·
// ฝากถอนเข้าบัญชีบริษัทโดยตรง ตรวจชื่อบัญชีปลายทางและข้อมูลนิติบุคคล ·
// แอดมิน 24 ชั่วโมง · ช่องทางติดต่อหลัก · PIN/OTP
//
// ⚠️ คำที่ห้ามหลงเหลือ: ศัพท์ของหมวดอื่นที่ไม่ใช่สล็อต และคำขายของของแบรนด์ก่อนๆ
// ที่บรีฟรอบนี้ไม่ได้เอ่ย — รายการเต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อ
// ไม่ให้ grep หาคำต้องห้ามเจอ false positive รอบนี้เขียนใหม่จากบรีฟ ไม่ได้
// find-and-replace ทับประโยคเก่า เพราะประโยคเก่าทั้งย่อหน้าตั้งอยู่บนคำเหล่านั้น
//
// ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 24 ชั่วโมง · 100% · 2026
// ห้ามเติมเลขใบอนุญาต หน่วยงานกำกับ ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP ยอดฝากขั้นต่ำ
// จำนวนสมาชิก หรือปีที่ก่อตั้ง เพราะบรีฟไม่ได้เอ่ยไว้สักอย่าง
//
// ประโยคกำกับที่บรีฟเขียนไว้เองและห้ามตัดทิ้งเพราะฟังดูไม่ขายของ: ไม่ควรใช้คำโฆษณา
// เพียงอย่างเดียวเป็นหลักฐานยืนยันว่าเว็บไซต์เชื่อมต่อกับค่ายเกมโดยตรง · การระบุว่า
// โปรโมชั่นครอบคลุมทุกค่ายควรอ้างอิงรายชื่อเกมที่ร่วมรายการจริง · คำว่าไม่จำกัด
// ควรระบุให้ชัดว่าหมายถึงจำนวนเพื่อน จำนวนครั้ง หรือวงเงิน · ชื่อบัญชีบริษัทเพียง
// อย่างเดียวไม่ได้รับประกันว่าธุรกรรมจะไม่มีความเสี่ยง · ไม่ควรเปิดเผยรหัสผ่าน PIN
// หรือ OTP ให้บุคคลอื่น แม้จะอ้างว่าเป็นเจ้าหน้าที่
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ทองสายฟ้า บนแดงเลือดนก** พลิกทิศจากคู่
// "แดงนำ-ทองรอง บนน้ำตาลถ่านเกือบดำ" ของแบรนด์ก่อน ซึ่งออกครบทุกจุดแล้ว ทั้งคลาส
// Tailwind raw hex และ rgba() (ค่าเดิมอยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำที่นี่ เพื่อ
// ไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive)
// ลำดับปุ่มสื่อด้วย "ทองถม vs ผิวจมขอบทอง": ปุ่มหลัก (สมัครสมาชิก) ถมทองไล่ #ffdd73
// → #f5c518 → #b8860f ขอบ #b8860f หมึกน้ำตาลเกือบดำ #2a0300 — ห้ามพลิกเป็นหมึกสว่าง ·
// ปุ่มรองและปุ่มลิงก์ภายในเป็นผิวจม #6d0804 → #430000 ขอบทอง #f5c518/50 ตัวอักษร
// ครีมอุ่น #f8d2bb · #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ
// จึงคงไว้
// ⚠️ ปลายเข้มของไล่เฉดทองเป็น #b8860f (หมึก #2a0300 บนมันได้ 5.8:1 = ผ่าน) ห้าม
// ไล่ลงไปถึงทองลึก #8a6208 ใต้ตัวอักษร เพราะตัวนั้นเป็นสีของเงาและออราเท่านั้น
// ⚠️ แดงสายฟ้า #ff3b14 ได้ ≈3.6:1 บนผิวการ์ด ห้ามถือตัวอักษรเนื้อความ ใช้เป็นออรา
// เงา และปลายไล่เฉดของหัวข้อ (ซึ่ง ContentBox จัดการเองแล้ว)
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #fdf0e2)
// ไว้ที่ตัวการ์ดแล้ว ข้อความในหน้านี้จึงไม่ประกาศสีของตัวเองเลย ปล่อยให้สืบทอดลงมา
// — มีแค่ปุ่มที่ประกาศสีได้ เพราะปุ่มถมพื้นของตัวเองจึงต้องกำหนดหมึกของตัวเอง
// ส่วน <strong> ใช้น้ำหนักตัวอักษรเป็นไฮไลต์ ไม่ประกาศสี และแต่ละ <strong> ครอบ
// "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิด
// แท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้าง
// จากหน้า และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น Announcement5 ทั้งเว็บ (รอบก่อนใช้ Announcement2 —
// brand-spec §3 หมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้
// ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูด
// คนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 154 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} เว็บตรงฐานสล็อตหลัก ไม่ผ่านเอเย่นต์ รวมหมวดเกมสล็อต โปรโมชั่นคืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% ฝากถอนบัญชีบริษัท และแอดมิน 24 ชั่วโมง`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} เว็บตรงฐานสล็อตหลัก อัปเดตระบบเข้าเล่นใหม่ 2026`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong>{BRAND_NAME} คือเว็บตรงฐานสล็อตหลักที่นำเสนอระบบเข้าเล่นสล็อตออนไลน์รูปแบบใหม่ในปี 2026</strong>
        รองรับการใช้งานผ่านมือถือและคอมพิวเตอร์ พร้อมรวบรวมเกมสล็อตหลายประเภทไว้ในบัญชีเดียว ทั้งสล็อตคลาสสิก เกมฟรีสปิน โบนัสตัวคูณ และเกมใหม่จากค่ายที่เปิดให้บริการ สมาชิกค้นหาเกม ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการได้จากระบบเดียว
      </p>

      <p>
        หน้านี้สรุปไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่เมนูเลือกเกมและหมวดที่จัดไว้
        <strong>ไปจนถึงรายการโปรโมชั่นที่กดรับได้ ระบบฝากถอนเข้าบัญชีบริษัทโดยตรง และช่องทางติดต่อแอดมินที่เปิดให้บริการตลอด 24 ชั่วโมง</strong>
        เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดดูอะไรตรงไหน แล้วจึงค่อยลงรายละเอียดของรายการที่สนใจเป็นรายรายการ
      </p>

      <p>
        <strong>ส่วนการยืนยันว่าเป็นเว็บตรงไม่ผ่านเอเย่นต์ ควรมีข้อมูลผู้ดำเนินงานและรายชื่อค่ายเกมที่ตรวจสอบได้รองรับ ไม่ควรใช้คำโฆษณาเพียงอย่างเดียวเป็นหลักฐาน</strong>
        ข้อมูลในหน้านี้จึงเขียนไว้เพื่อบอกว่าระบบมีอะไรให้ใช้และควรตรวจอะไรก่อนตัดสินใจ ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้งาน ซึ่งเป็นค่าที่ควรยึดเป็นหลักเสมอ
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`เกมสล็อตและหมวดหมู่ที่ ${BRAND_NAME} รวบรวมไว้ให้สมาชิก`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} นำเสนอเกมสล็อตหลายรูปแบบจากค่ายที่เปิดให้บริการ
        <strong>โดยเน้นการจัดหมวดเกมให้เลือกใช้งานได้ง่าย พร้อมทางเข้าสำหรับสมาชิกที่ต้องการค้นหาเกมจากหลายค่ายผ่านระบบเดียว</strong>
        หมวดที่เว็บไซต์ระบุไว้แบ่งออกได้ประมาณนี้ และรายการที่เปิดอยู่ในแต่ละหมวดอาจเปลี่ยนแปลงได้ตามช่วงเวลา
      </p>

      <ul class="flex flex-col gap-3" aria-label={`หมวดเกมสล็อตบนเว็บ ${BRAND_NAME}`}>
        <li class="flex gap-3">
          <span aria-hidden="true">🎰</span>
          <span>
            <strong>สล็อตคลาสสิก</strong> เกมวงล้อรูปแบบพื้นฐานที่อ่านผลได้ตรงไปตรงมา เหมาะกับการเริ่มทำความคุ้นเคยกับระบบก่อนไล่ดูหมวดอื่น
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">🌀</span>
          <span>
            <strong>เกมฟรีสปิน</strong> เกมที่มีรอบหมุนเพิ่มเป็นฟีเจอร์ของตัวเกมเอง โดยเงื่อนไขการเข้าสู่รอบฟรีสปินและจำนวนรอบที่ได้เป็นไปตามที่แต่ละเกมกำหนด
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">✖️</span>
          <span>
            <strong>โบนัสตัวคูณ</strong> เกมที่มีตัวคูณอยู่ในฟีเจอร์ของเกม ซึ่งค่าตัวคูณและจังหวะที่ทำงานต่างกันไปตามเกม จึงควรเปิดอ่านรายละเอียดภายในเกมก่อนเริ่มเล่น
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">🆕</span>
          <span>
            <strong>เกมใหม่จากค่ายที่เปิดให้บริการ</strong> รายการที่เพิ่มเข้ามาตามรอบของแต่ละค่าย เป็นหมวดที่ควรเปิดดูเป็นระยะ เพราะรายชื่อที่เปิดให้เล่นไม่คงที่
          </span>
        </li>
      </ul>

      <p>
        การอัปเดตเว็บไซต์ในปี 2026 ครอบคลุมทั้งหน้าเข้าสู่ระบบ เมนูเลือกเกม และส่วนจัดการบัญชี เพื่อช่วยให้ใช้งานผ่านมือถือได้สะดวกขึ้น
        <strong>โดยสมาชิกควรตรวจสอบช่องทางหลักก่อน Login ทุกครั้ง</strong>
        และควรตรวจสอบรายชื่อผู้ให้บริการกับข้อมูลที่เกี่ยวข้องก่อนสมัครสมาชิก แทนการยึดถ้อยคำบนหน้าประชาสัมพันธ์เพียงอย่างเดียว
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/ทดลองเล่น"
          aria-label={`เปิดหน้าทดลองเล่นของ ${BRAND_NAME}`}
