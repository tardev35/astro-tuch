---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึงเขียนขึ้นใหม่
// บนข้อเท็จจริงของบรีฟรอบนี้เท่านั้น (src/assets/content.txt) ไม่ใช่แก้ทับประโยคเดิม
// ของแบรนด์ก่อน — ของเดิมเป็นคอปปี้ "เว็บสล็อตออนไลน์ล้วน" ของ แตกดี168 ซึ่งขัดกับ
// แบรนด์รอบนี้ทั้งย่อหน้า จึงถูกเขียนใหม่ทั้งหมด ไม่ใช่แทนที่ชื่อแบรนด์
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x4 · h3x0
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) จึงเปิดใช้งานอยู่
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// ตัวที่ routing จริงคือไฟล์นี้ ตัวที่จอดไว้เป็นอินเวนทอรี ห้ามแก้และห้ามลบ
//
// ดรอปนี้ (2026-10-09) คือ **เว็บพนันฐานเล่นหลักที่รวบรวมช่องทางเข้าเล่นออนไลน์
// ไว้ในระบบเดียว** ไม่ใช่เว็บสล็อตเฉพาะทาง ไม่ใช่คาสิโนรวมหมวด และไม่ใช่เว็บหวย
// แง่มุมที่บรีฟระบุไว้มีเท่านี้: รวบรวมช่องทางเข้าเล่นออนไลน์ไว้ในระบบเดียว ·
// รองรับมือถือและคอมพิวเตอร์ · ปรับรูปแบบเว็บไซต์ให้เข้าถึงเมนูต่างๆ ได้สะดวก ·
// ตรวจสอบบัญชี โปรโมชั่น และรายการใช้งานได้จากหน้าเดียว · ควรมีข้อมูลผู้ดำเนินงาน
// และช่องทางหลักที่ตรวจสอบได้ · อัปเกรดระบบตั้งแต่หน้าเข้าสู่ระบบ การจัดการบัญชี
// สมาชิก ไปจนถึงการตรวจสอบรายการ · การเข้ารหัสข้อมูล การจัดการสิทธิ์เข้าถึง
// การแจ้งเตือนรายการผิดปกติ · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · ลิงก์ส่วนตัว ·
// ยอดที่เข้าเกณฑ์ · รอบคำนวณ · รอบตัดยอด · โอนโบนัสเข้ายูสอัตโนมัติ ·
// สมัคร 3 ขั้นตอน · ยืนยันบัญชี · แอดมิน 24 ชั่วโมง · รหัสผ่าน PIN OTP
//
// ⚠️ คำที่ห้ามหลงเหลือ: ศัพท์หมวดสล็อต หมวดคาสิโนไลฟ์ หมวดกีฬา และหมวดลอตเตอรี
// ของแบรนด์ก่อนๆ (เป็นของอินเวนทอรีที่จอดไว้) รวมถึงคำขายของที่บรีฟรอบนี้ไม่ได้
// เอ่ย — รายการเต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำ
// ต้องห้ามเจอ false positive
// สองหน้าหมวดลอตเตอรีจอดอยู่ใน src/pages-disabled/ จึงไม่มีปลายทางให้ลิงก์รอบนี้
//
// ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 24 ชั่วโมง · 3 ขั้นตอน · 100%
// ห้ามเติมเลขใบอนุญาต หน่วยงานกำกับ ชื่อนิติบุคคล ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP
// ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีที่ก่อตั้ง เพราะบรีฟไม่ได้เอ่ยไว้สักอย่าง
//
// ประโยคกำกับที่บรีฟเขียนไว้เองและห้ามตัดทิ้งเพราะฟังดูไม่ขายของ:
// ควรมีข้อมูลผู้ดำเนินงานและช่องทางหลักที่ตรวจสอบได้ · ข้อความปลอดภัยขึ้น 100%
// ไม่สามารถใช้รับรองว่าไม่มีความเสี่ยงได้ทั้งหมด · ไม่ใช่ทุกการเดิมพันจะได้รับ
// โบนัสโดยอัตโนมัติ · เงื่อนไขไม่จำกัดควรระบุให้ชัดว่าเป็นจำนวนเพื่อน จำนวนครั้ง
// หรือวงเงินโบนัส · ไม่ควรเปิดเผยรหัสผ่าน PIN OTP แม้ผู้นั้นจะอ้างว่าเป็นแอดมิน
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **มรกตเข้ม x ทอง บนเขียวเกือบดำ** พลิกจาก
// คู่ฟ้าสด-เหลืองมะนาวบนกรมท่าเกือบดำของ แตกดี168 ซึ่งออกครบทุกจุดแล้ว ทั้งคลาส
// Tailwind raw hex และ rgba() (ค่าเดิมอยู่ใน brand-spec §2 ไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive)
// ปุ่มหลัก (สมัครสมาชิก) ถมทองไล่ #fde9a6 → #f7d14e → #cc920a ขอบ #8a6204
// หมึกเขียวเข้ม #07170c (11.8:1 บน #f7d14e) — ห้ามพลิกเป็นหมึกสว่าง · ปุ่มรองและ
// ปุ่มลิงก์ภายในเป็นผิวการ์ด #09190d → #051007 ขอบเขียวมรกต #0a6b32/60 ตัวอักษร
// เขียวสว่าง #2fbf6a · #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ
// จึงคงไว้
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #e8f2e6)
// ไว้ที่ตัวการ์ดแล้ว ข้อความในหน้านี้จึงไม่ประกาศสีของตัวเองเลย ปล่อยให้สืบทอดลงมา
// — มีแค่ปุ่มที่ประกาศสีได้ เพราะปุ่มถมพื้นของตัวเองจึงต้องกำหนดหมึกของตัวเอง
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้าง
// จากหน้า และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น AnnouncementPremium ทั้งเว็บ (รอบก่อน แตกดี168 ใช้
// Announcement3 — brand-spec §3 หมุนออก) orchestrator ตั้ง default message ของไฟล์
// นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้น
// ตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 157 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} เว็บพนันฐานเล่นหลักที่รวบรวมช่องทางเข้าเล่นออนไลน์ไว้ในระบบเดียว พร้อมโปรโมชั่นคืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% และแอดมินดูแล 24 ชั่วโมง`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} เว็บพนันฐานเล่นหลัก รวมช่องทางเข้าเล่นไว้ในระบบเดียว`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong>{BRAND_NAME} คือเว็บพนันฐานเล่นหลักที่รวบรวมช่องทางเข้าเล่นออนไลน์ไว้ในระบบเดียว</strong>
        รองรับการใช้งานทั้งผ่านมือถือและคอมพิวเตอร์ พร้อมปรับรูปแบบเว็บไซต์ให้เข้าถึงเมนูต่างๆ ได้สะดวก สมาชิกจึงตรวจสอบบัญชี โปรโมชั่น และรายการใช้งานได้จากหน้าเดียว โดยไม่ต้องสลับไปมาหลายหน้าจอ
      </p>

      <p>
        หน้านี้สรุปไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่เมนูฝั่งสมาชิกที่เปิดให้ตรวจสอบได้
        <strong>ไปจนถึงโปรโมชั่นที่เปิดให้รับในแต่ละช่วง การสมัครสมาชิก และการติดต่อแอดมินที่ดูแลตลอด 24 ชั่วโมง</strong>
        เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดดูอะไรตรงไหน แล้วจึงค่อยลงรายละเอียดของรายการที่สนใจเป็นรายรายการ
      </p>

      <p>
        ส่วนการระบุว่าเป็นเว็บไม่ผ่านเอเย่นต์
        <strong>ควรมีข้อมูลผู้ดำเนินงานและช่องทางหลักที่ตรวจสอบได้ เพื่อให้สมาชิกทราบว่าเว็บไซต์ให้บริการโดยใคร</strong>
        ข้อมูลในหน้านี้เขียนไว้เพื่อบอกว่าระบบมีอะไรให้ใช้และควรตรวจอะไรก่อนตัดสินใจ ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้งาน
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`${BRAND_NAME} รวมช่องทางเข้าเล่นออนไลน์ไว้ในบัญชีเดียว`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} รวบรวมช่องทางเข้าเล่นออนไลน์ไว้ให้เปิดใช้งานได้จากระบบเดียว
        <strong>เข้าสู่ระบบครั้งเดียวแล้วใช้เมนูฝั่งสมาชิกต่อได้จากบัญชีเดิม</strong>
        เมนูแต่ละส่วนทำหน้าที่คนละอย่างและแสดงข้อมูลคนละชุด จึงควรเปิดดูให้ครบตั้งแต่ครั้งแรก เพื่อให้รู้ว่าข้อมูลที่ต้องใช้จริงอยู่ตรงไหน สิ่งที่แต่ละเมนูดูแลแบ่งออกได้ประมาณนี้
      </p>

      <ul class="flex flex-col gap-3" aria-label={`เมนูฝั่งสมาชิกบนเว็บ ${BRAND_NAME}`}>
        <li class="flex gap-3">
          <span aria-hidden="true">🔐</span>
          <span>
            <strong>หน้าเข้าสู่ระบบ</strong> เป็นด่านแรกของบัญชี จุดที่ควรดูคือที่อยู่เว็บไซต์ที่กำลังเปิดอยู่และขั้นตอนยืนยันข้อมูลตามที่ระบบกำหนด ก่อนกรอกข้อมูลใดๆ ลงไป
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">👤</span>
          <span>
            <strong>การจัดการบัญชีสมาชิก</strong> ใช้ดูและแก้ไขรายละเอียดของบัญชีเท่าที่ระบบเปิดให้แก้ได้ เป็นเมนูที่บอกว่าข้อมูลอะไรของสมาชิกถูกบันทึกไว้บ้าง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">📋</span>
          <span>
            <strong>การตรวจสอบรายการ</strong> ใช้ไล่ดูรายการใช้งานย้อนหลังของบัญชีตัวเอง และเป็นที่เดียวกับที่ใช้อ้างอิงวันเวลาเวลาจะแจ้งปัญหาให้เจ้าหน้าที่ตรวจสอบ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">🎁</span>
          <span>
            <strong>รายการโปรโมชั่น</strong> แสดงสิทธิพิเศษที่เปิดให้บริการในแต่ละช่วง พร้อมยอดที่เข้าเกณฑ์ รอบคำนวณ และรายละเอียดโบนัสที่ตรวจสอบผ่านบัญชีได้โดยตรง
          </span>
        </li>
      </ul>

      <p>
        <strong>รายการที่เปิดให้บริการในแต่ละช่วงไม่จำเป็นต้องเป็นชุดเดียวกัน</strong>
        สิ่งที่เห็นอยู่ในระบบตอนนี้จึงเป็นค่าล่าสุดที่ควรยึด แทนการใช้ค่าที่จำไว้จากรอบก่อนหน้า
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/ทดลองเล่น"
          aria-label={`เปิดหน้าทดลองเล่นของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#0a6b32]/60 bg-gradient-to-b from-[#09190d] to-[#051007] px-8 py-3 font-bold text-[#2fbf6a] shadow-[0_0_12px_rgba(10,107,50,0.35)] transition-all hover:scale-105 hover:border-[#2fbf6a] hover:shadow-[0_0_18px_rgba(47,191,106,0.45)]">
          ไปหน้าทดลองเล่น
        </a>

        <a
          href="/promotion"
          aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#0a6b32]/60 bg-gradient-to-b from-[#09190d] to-[#051007] px-8 py-3 font-bold text-[#2fbf6a] shadow-[0_0_12px_rgba(10,107,50,0.35)] transition-all hover:scale-105 hover:border-[#2fbf6a] hover:shadow-[0_0_18px_rgba(47,191,106,0.45)]">
          ดูภาพโปรโมชั่น
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`การอัปเกรดระบบของ ${BRAND_NAME} และมาตรการที่ตรวจสอบได้จริง`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} เน้นการอัปเกรดระบบให้รองรับการใช้งานออนไลน์ได้สะดวกขึ้น
        <strong>ตั้งแต่หน้าเข้าสู่ระบบ การจัดการบัญชีสมาชิก ไปจนถึงการตรวจสอบรายการต่างๆ</strong>
        โดยควรมีมาตรการป้องกันการเข้าถึงบัญชีโดยไม่ได้รับอนุญาต รวมถึงขั้นตอนยืนยันข้อมูลที่เหมาะสม เพื่อช่วยลดความเสี่ยงจากการใช้งานผ่านช่องทางที่ไม่ถูกต้อง
      </p>

