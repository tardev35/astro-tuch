---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login, /register,
// /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx
// ที่ใช้กับ index.astro — บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES
// ที่ให้ body มา ทั้งหน้าจึงเขียนขึ้นใหม่จากข้อเท็จจริงและคลังคำของบรีฟรอบนี้เท่านั้น
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x4 · h3x0
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) จึงเปิดใช้งานอยู่
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// ตัวที่ routing จริงคือไฟล์นี้ Astro ไม่อ่านโฟลเดอร์นั้นเลย ห้ามแก้และห้ามลบ
//
// ⚠️ ดรอปนี้ (2026-10-20) คือ **เว็บเกมสล็อตเป็นแกน** และบรีฟระบุหมวดเกมไว้สี่หมวด
// คือ สล็อต · ยิงปลา · ไฮโล · หวยออนไลน์ — **ไม่ใช่เว็บหวย** หวยออนไลน์เป็นหนึ่งใน
// สี่หมวดที่ผู้ให้บริการเปิดไว้ ไม่ใช่หัวเรื่องของเว็บ สองหน้าหมวดลอตเตอรีที่แบรนด์
// ก่อนๆ เคยเปิด จอดอยู่ใน src/pages-disabled/ ไม่มี route ห้ามลิงก์ไปหา เป็น href
// ตายที่ทำให้ build แดง route ที่มีจริงรอบนี้คือ / · /about-us · /contact-us ·
// /login · /privacy · /promotion · /register · /terms · /ทดลองเล่น · /ทางเข้า · /line
//
// ⚠️ แบรนด์ก่อนหน้าทันที (มีเฮ168 ที่ถูกแทนที่รอบนี้ — โดเมนเดิมไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ sweep ของรอบถัดไปสะดุดที่คอมเมนต์ของไฟล์นี้เอง) ก็เป็นแบรนด์
// สล็อตเหมือนกัน คอปปี้และโครงหัวข้อเดิมจึง "ดูเข้าเค้า" ทั้งที่กรอบของบรีฟคนละอัน —
// **ห้าม find-and-replace ทับประโยคเดิม** ทั้งหน้าถูกเขียนใหม่รอบกรอบของบรีฟรอบนี้
// ซึ่งว่าด้วย **การรวมเกมสี่หมวดกับเมนูสมัครสมาชิก เข้าสู่ระบบ ฝากถอน และตรวจสอบ
// โปรโมชั่นไว้ในเว็บไซต์เดียว** ไม่ใช่กรอบของรอบก่อนที่ยกคนรุ่นใหม่/การใช้งานบนมือถือ
// ขึ้นเป็นแกน (คำต้องห้ามไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ
// false positive — รายการเต็มอยู่ใน brand-spec §6)
//
// 🚨 **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกมแม้แต่ค่ายเดียว** จึงห้ามเขียนชื่อค่ายใดๆ
// ลงหน้าเว็บ และห้ามอ้างใบอนุญาต หน่วยงานกำกับ ชื่อนิติบุคคล ชื่อธนาคารเฉพาะราย
// ค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีก่อตั้ง
//
// คลังคำที่บรีฟรอบนี้ให้มา และใช้ได้เท่านี้ (brand-spec §6): สล็อต · ยิงปลา ·
// ไฮโล · หวยออนไลน์ · แทงหวย · กติกา · อัตราจ่าย · อัตราเดิมพัน ·
// เงื่อนไขการเดิมพัน · ข้อมูลผู้ให้บริการ · โปรโมชั่น · คืนยอดเสีย 0.3% ·
// แนะนำเพื่อน 0.8% · โบนัส · เครดิต · ยอดเสีย · รอบเวลารับเครดิต · ลิงก์แนะนำ ·
// เชื่อมโยงบัญชี · สมัครสมาชิก · เข้าสู่ระบบ · ลงทะเบียน · ฝากถอน ·
// ข้อมูลส่วนบุคคล · รหัสผ่าน · รหัส OTP · เจ้าหน้าที่ · แอดมิน · 24ชม. ·
// ช่องทางทางการ
//
// ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 24ชม. · 3 ขั้นตอน
//
// ⚠️ คำว่า "รวยขั้นเทพ" และ "รับได้ไม่จำกัด" อยู่ได้เฉพาะในหัวข้อที่บรีฟเขียนไว้เอง
// (= หัวข้อของ index.astro) หน้านี้จึงไม่หยิบมาเป็นหัวข้อ เพราะย่อหน้าของบรีฟเอง
// หักล้างทันทีว่าเกมเหล่านี้มีความเสี่ยงต่อการสูญเสียเงิน
//
// 🚨 บรีฟรอบนี้ **โฆษณากับกำกับความเสี่ยงอยู่ในย่อหน้าเดียวกัน** และประโยคกำกับ
// ทุกประโยคต้องขึ้นครบ เป็นเนื้อหาของบรีฟ ไม่ใช่ filler ให้ตัดทิ้ง:
// 1) ควรตรวจสอบกติกา เงื่อนไขการเดิมพัน และข้อมูลผู้ให้บริการก่อนเริ่มใช้งานทุกครั้ง (h1)
// 2) เกมเหล่านี้มีความเสี่ยงต่อการสูญเสียเงิน · ไม่มีรูปแบบใดรับประกันผลกำไรจาก
//    การเดิมพัน (h2 #1)
// 3) เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือรับประกัน
//    ผลตอบแทนในอนาคต (h2 #2)
// 4) แม้โปรโมชั่นจะระบุว่าไม่จำกัด แต่ควรตรวจสอบข้อกำหนดเกี่ยวกับจำนวนผู้เข้าร่วม
//    ยอดที่นำมาคำนวณ รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัส (h2 #2)
// 5) ไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น (h2 #3, #4)
// 6) ควรตรวจสอบเวลาการให้บริการและระยะเวลาตอบกลับล่าสุดจากช่องทางทางการอีกครั้ง (h2 #4)
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ทองจักรพรรดินำ แดงชาดรอง บนดำสนิท**
// ⚠️ รอบก่อนเป็นแดงนำ+ทองเนยรอง รอบนี้ **กลับขั้ว** แต่ทองเคยนำมาแล้วเกือบทุกแบรนด์
// และแดงเคยนำมาแล้วสี่แบรนด์ "เจอทองอยู่แล้ว" หรือ "เจอแดงอยู่แล้ว" จึงไม่ใช่ตัวบอก
// ว่าถูกแบรนด์ ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน brand-spec §2 (ค่าเดิมไม่พิมพ์ซ้ำ
// ที่นี่ เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive ในไฟล์นี้)
// ทองรอบนี้คือ **#f0bb4e** (R240 G187 B78) ครีมทอง **#ffeccb** ทองแดง **#d9701a**
// และฮิวที่สองคือ **แดงชาด #e4021b** (R228 G2 B27)
// ลำดับความลึก: #3b1b0e ผิวยก (= การ์ด) / #260d04 กลาง / #0d0501 จม / #000000 พื้นเพจ
//
// ⚠️ **แดงชาด #e4021b ได้แค่ 3.2:1 บนผิวการ์ด จึงห้ามถือตัวอักษรทุกขนาด** ใช้ได้แค่
// เส้นขอบ ไอคอน ออรา และพื้นถม เช่นเดียวกับทองแดง #d9701a ที่ 4.7:1 ถือเป็นของตกแต่ง
// ไม่ใช่สีเนื้อความ — ออราในไฟล์นี้ใช้ rgba(240,187,78,α) · rgba(217,112,26,α)
// เท่านั้น และรอบนี้ไม่มีฟ้า/น้ำเงิน ไม่มีม่วง ไม่มีเขียว (นอกจาก LINE) ไม่มีเงิน/
// โครเมียม ไม่มีโรสโกลด์ ไม่มีเหลืองมะนาว และไม่มีชมพู/ฟูเชีย ส้มตัวเดียวที่อนุญาต
// คือทองแดง #d9701a ซึ่งเป็นเฉดเงาของทอง ไม่ใช่ส้มอิสระ
//
// ลำดับปุ่มสื่อด้วย "พื้นถมทอง vs ผิวจมขอบทองแดง" — คู่พื้น-หมึกคำนวณไว้แล้ว:
// · ปุ่มหลัก (สมัครสมาชิก) ถมไล่เฉด #ffeccb → #f0bb4e ขอบ #d9701a หมึก #2b1400
//   (9.9:1 บนปลายทองแบรนด์ และสูงกว่านั้นบนปลายครีม ผ่าน AA ทั้งเส้น)
// · ปุ่มรอง/ปุ่มลิงก์ภายในเป็นชั้นจม #260d04 → #0d0501 ขอบ #d9701a
//   ตัวอักษร #fff8ec (17.4:1–19.1:1) — hover ยกขอบเป็นทอง #f0bb4e (ตรงกับ hover
//   ของการ์ด ContentBox ซึ่งใช้ #ffeccb/70 เป็นขอบ hover)
// · ชิปไอคอนของรายการหมวดเกมใช้แดงชาดเป็น **เส้นขอบ** บนผิวกลาง #260d04 —
//   เป็นที่เดียวในหน้านี้ที่แดงปรากฏ และไม่ถือตัวอักษร
// · marker ของลำดับเลขใช้ครีมทอง #ffeccb (13.4:1 บนผิวการ์ด — เป็นตัวอักษร จึงใช้
//   แดงหรือทองแดงไม่ได้ และ #f0bb4e สงวนไว้ให้ <strong> เท่านั้น)
// · #00B900 บนปุ่ม LINE เป็นสีประจำแพลตฟอร์ม LINE ไม่ใช่สีของเว็บ จึงคงไว้
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #fff8ec,
// 14.7:1 บนผิวยก #3b1b0e) ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง
// ปล่อยให้สืบทอดลงมา และไม่ใส่ mx-auto / max-w-* บน <p> เพราะการ์ดคุมความกว้างเองแล้ว
// — ที่ประกาศสีได้มีแค่ปุ่ม (ถมพื้นของตัวเองจึงต้องกำหนดหมึกของตัวเอง) ชิปไอคอน
// marker ของลำดับเลข และ <strong> ซึ่ง brand-spec §2 สงวน #f0bb4e (8.8:1 บนผิว
// การ์ด) ไว้เป็นสีไฮไลต์ในเนื้อความโดยเฉพาะ และไม่ใช้สีอื่นเลย · แต่ละ <strong>
// ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/
// ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง (ลบแท็ก <strong> ออกแล้วคอปปี้ต้อง
// อ่านได้เหมือนเดิม) และห้ามวาง <strong> สองอันติดกัน
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้าง
// จากหน้า และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้หมุนมาเป็น AnnouncementPremium ทั้งเว็บ (brand-spec §3 —
// รอบก่อนใช้ Announcement5 จึงหมุนออก) orchestrator ตั้ง default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message
// มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 157 อักขระ
//
// ห้ามให้สตริงนี้มีชื่อของสองหน้าหมวดลอตเตอรีที่จอดอยู่ใน src/pages-disabled/
// (ชื่อไฟล์ทั้งสองอยู่ใน brand-spec §7) เพราะ sweep ของรอบถัดไปจะอ่านเป็น
// false positive ว่ายังมีลิงก์ไปหน้าที่ไม่มี route
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} รวมข้อมูลเกมสล็อต ยิงปลา ไฮโล และหวยออนไลน์ ทั้งกติกา อัตราจ่าย โปรโมชั่นคืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% และช่องทางติดต่อแอดมิน 24ชม.`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} รวมเกมสล็อต ยิงปลา ไฮโล และหวยออนไลน์ไว้ในเว็บเดียว`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#f0bb4e]">{BRAND_NAME} นำเสนอช่องทางบริการเกมออนไลน์หลายประเภทไว้ในเว็บไซต์เดียว</strong>
        ทั้งเกมสล็อต ยิงปลา ไฮโล และหวยออนไลน์ พร้อมรวบรวมเมนูสมัครสมาชิก เข้าสู่ระบบ ฝากถอน และตรวจสอบโปรโมชั่นไว้ในที่เดียวกัน หน้านี้รวบรวมไว้ว่าเว็บไซต์ระบุอะไรไว้บ้าง เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดดูอะไรตรงไหน
        แล้วจึงค่อยอ่านรายละเอียดของแต่ละเรื่องเป็นรายข้อ
      </p>

      <p>
        ผู้ใช้งานสามารถศึกษารายละเอียดของแต่ละเกมและเลือกดูบริการที่สนใจได้สะดวก
        <strong class="text-[#f0bb4e]">โดยควรตรวจสอบกติกา เงื่อนไขการเดิมพัน และข้อมูลผู้ให้บริการก่อนเริ่มใช้งานทุกครั้ง</strong>
