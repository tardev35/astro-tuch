---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login, /register)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึงเขียนขึ้นใหม่
// บนข้อเท็จจริงของ หวยเฮง24 เท่านั้น
//
// รอบนี้ (ดรอป 2026-10-01) คือ หวยเฮง24 **เว็บเล่นหวยออนไลน์** — รวมรายการยอดนิยม
// ไว้ให้เลือกในบัญชีเดียว ทั้งหวยลาว หวยฮานอย หวยรัฐบาลไทย และหวยหุ้น ส่วนแบรนด์
// ก่อนหน้า (หวยเต็ง) เป็นเว็บหวยเหมือนกันแต่บรีฟคนละฉบับ — รายละเอียดอย่าง
// "ลาวพัฒนา" "ฮานอยปกติ/พิเศษ/วีไอพี" และ "หวยหุ้นต่างประเทศ" เป็นของบรีฟรอบก่อน
// บรีฟรอบนี้ไม่ได้ระบุไว้ จึงถอดออกทั้งชุด และเพิ่มสิ่งที่บรีฟรอบนี้ระบุแทนคือ
// ฝากถอนผ่านวอลเลทและธนาคารที่ระบบรองรับ กับการเช็คผลหลังประกาศผลของแต่ละรอบ
// ก่อนหน้านั้น (BRAVO168) เป็นเว็บแทงบอล และก่อนหน้านั้นอีก (CK268) เป็นเว็บสล็อต
// ห้าม find-and-replace ชื่อแบรนด์ทับประโยคเดิม มิฉะนั้นเว็บจะไปอ้างสินค้าที่ไม่มีอยู่
// (คำห้ามจาก brand-spec §6: สล็อต ฟรีสปิน ตัวคูณ ค่ายเกม RTP แตกง่าย เว็บตรง บอล
// ค่าน้ำ อัตราต่อรอง ลีก บิลสเต็ป แฮนดิแคป คาสิโน บาคาร่า)
//
// ข้อเท็จจริงทุกบรรทัดมาจาก content.txt เท่านั้น: รวมรายการยอดนิยมในบัญชีเดียว ·
// หวยลาวตามรายการที่เปิดรับ หวยฮานอยหลายรอบ หวยรัฐบาลไทยตามกำหนดออกรางวัล
// หวยหุ้นตามตลาดที่ระบบรองรับ · ตรวจสอบเวลาเปิดรับ เวลาปิดรับ และอัตราจ่ายของแต่ละ
// รายการก่อนเลือกเลขได้จากหน้าเดียว · หลังส่งโพยตรวจชื่อหวย รอบเวลา เลขที่เลือก
// และยอดเดิมพัน · เช็คผลและสถานะโพยผ่านบัญชีสมาชิกเมื่อประกาศผลแล้ว ·
// ฝากถอนผ่านวอลเลทและธนาคารที่ระบบรองรับ · 2 ตัว จ่าย 100 บาท · 3 ตัว จ่าย 1,000 บาท ·
// สมัคร 3 ขั้นตอน · แอดมิน 24 ชั่วโมง
// — ตัวเลขที่อ้างได้มีแค่ 100 บาท 1,000 บาท 3 ขั้นตอน และ 24 ชั่วโมง
// ห้ามเพิ่มชื่อผู้ให้บริการ ชื่อธนาคาร ขั้นต่ำฝากถอน เลขใบอนุญาต ปีที่ก่อตั้ง
// หรือจำนวนสมาชิกที่บรีฟไม่ได้ระบุ · บรีฟรอบนี้ไม่มีโปรโมชั่น/โบนัสเลยสักรายการ
// จึงไม่มีหัวข้อโปรโมชั่นในหน้านี้ · บรีฟรอบนี้ไม่ได้อ้าง "อันดับ 1" ไว้เลย
// ประโยค hedge เรื่องอันดับ 1 ของรอบก่อนจึงถูกถอดออก ไม่ใช่เขียนทับ
//
// บรีฟใส่ประโยค hedge กำกับไว้เองและห้ามตัดทิ้ง: อัตรา 2 ตัว/3 ตัว ไม่ควรถือว่าใช้
// เหมือนกันทุกรายการ ให้ยึดตัวเลขที่แสดงในหน้าส่งโพยของแต่ละรอบ · ผลรางวัลควร
// อ้างอิงข้อมูลอย่างเป็นทางการของหวยแต่ละประเภท · ห้ามเปิดเผยรหัสผ่าน PIN OTP
//
// พาเลตต์ หวยเฮง24 เป็น **แดงเข้ม + ทอง** ตามโลโก้ (คำว่า "หวย" แดงเลือดนกเงาวาว
// ขอบทอง คู่กับ "เฮง24" ทองไล่เฉด) และแบนเนอร์ฉากผ้าซาตินแดงที่มีเงาปราสาททอง
// เหรียญทอง และลูกหวยแดง-ขาว ตารางแมปอยู่ที่ brand-spec §2: พื้นเพจ #1a0505 ·
// การ์ด #2e0707 · ผิวยก #3d0808 · แดงเข้ม #5a0202 · แดงกลาง #720202 ·
// แดงแบรนด์ #8b0302 · แดงสว่าง #c01616 · ทองเข้ม #7a4a02 · ทองมืด #a46304 ·
// ทองกลาง #bd7c13 · ทองแบรนด์ #e0a52a · ทองสว่าง #fbdc64 · ทองอ่อน #fdea83 ·
// เนื้อความ #f6e6cf (BRAND_TEXT) · หมึกบนพื้นทอง #2a0606
// เรืองแสง: ทอง rgba(224,165,42,0.40) · แดง rgba(192,22,22,0.35)
// ชุดเขียวป่า-ทองของ หวยเต็ง (#03150a #062a12 #0b3d18 #024a0f #026314 #0bb42f
// #e5c04f #fae474 #bd8d2d #d8ead9 #0a1a0c rgba(229,192,79,*) rgba(2,99,20,*))
// ออกครบทุกจุดแล้ว ทั้งคลาส Tailwind raw hex และ rgba()
// ส่วน #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ตามเดิม
// กฎคอนทราสต์: พื้นทอง → หมึกเข้ม #2a0606 · ตัวอักษรบนการ์ดแดงใช้ #f6e6cf #fdea83
// #fbdc64 #e0a52a เท่านั้น ส่วน #8b0302 / #5a0202 / #3d0808 / #bd7c13 ใช้เป็นพื้นและขอบ
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลางที่ไม่หมุนตามรอบรีแบรนด์ และรอบนี้
// orchestrator เป็นคนรีธีม) — สีเนื้อความจึงตรงกับที่การ์ดกำหนดไว้อยู่แล้ว
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index และ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า
// และ slide3/slide4/banner2/banner3 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import (ลำพัง
// การ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น Announcement5 ทั้งเว็บ (รอบก่อน หวยเต็ง ใช้ Announcement3)
// — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ หวยเฮง24 แล้ว จึง
// เรียกแบบ bare เหมือน index.astro ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะไม่ตรงกัน
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 155
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "เกี่ยวกับเรา หวยเฮง24 เว็บเล่นหวยออนไลน์ที่รวมหวยลาว หวยฮานอย หวยรัฐบาลไทย และหวยหุ้นไว้ให้เลือกในบัญชีเดียว หน้านี้สรุปว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง";

const pageTitle = "เกี่ยวกับเรา หวยเฮง24 เว็บเล่นหวยออนไลน์รวมทุกรายการในบัญชีเดียว";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f6e6cf]">
        <strong class="text-[#fdea83]">หวยเฮง24</strong> คือ<strong class="text-[#fdea83]">เว็บเล่นหวยออนไลน์ที่รวมรายการยอดนิยมไว้ให้เลือกในบัญชีเดียว</strong>
        ทั้งหวยลาว หวยฮานอย หวยรัฐบาลไทย และหวยหุ้น รองรับการเข้าใช้งานผ่านมือถือโดยไม่ต้องสลับไปมาหลายเว็บไซต์ สำหรับผู้ที่ต้องการติดตามหวยหลายประเภทและหลายรอบในแต่ละวัน
      </p>

      <p class="text-left text-base leading-relaxed text-[#f6e6cf]">
        หน้านี้รวบรวมไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่ประเภทหวยที่เปิดรับในแต่ละรอบ อัตราจ่ายของรายการที่เข้าเงื่อนไข ระบบบัญชีที่ใช้เลือกเลข ส่งโพย ตรวจสอบรายการและเช็คผล
        ช่องทางฝากถอนผ่านวอลเลทและธนาคารที่ระบบรองรับ ขั้นตอนการสมัคร ไปจนถึงช่องทางสอบถามแอดมินเมื่อไม่แน่ใจในขั้นตอนใด
      </p>

      <p class="text-left text-base leading-relaxed text-[#f6e6cf]">
        <strong class="text-[#fdea83]">ตารางเวลาและเงื่อนไขของหวยแต่ละประเภทเปลี่ยนแปลงได้ตามรอบ</strong>
        รายละเอียดทั้งหมดในหน้านี้จึงยึดตามข้อมูลที่เว็บไซต์แสดงไว้ในหน้าส่งโพยของรอบนั้นเป็นหลัก และเมื่อประกาศผลแล้วควรอ้างอิงข้อมูลอย่างเป็นทางการของหวยแต่ละประเภทประกอบด้วย
      </p>
    </div>
  </ContentBox>

  <ContentBox title="หวยเฮง24 รวมหวยหลายประเภทไว้ให้เลือกในบัญชีเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f6e6cf]">
        สิ่งที่เว็บไซต์ระบุไว้เป็นตัวตนของ หวยเฮง24 คือ <strong class="text-[#fdea83]">การรวมรายการหวยยอดนิยมไว้ให้เลือกในบัญชีเดียว</strong>
        สมาชิกจึงเลือกหวยจากคนละประเภทได้จากบัญชีเดิม ไม่ต้องเปิดบัญชีแยกกันไปตามแต่ละรายการ และตรวจสอบเวลาเปิดรับ เวลาปิดรับ และอัตราจ่ายของแต่ละรายการก่อนเลือกเลขได้จากหน้าเดียว
      </p>

      <p class="text-left text-base leading-relaxed text-[#f6e6cf]">
        ถัดจากการเลือกรายการคือ<strong class="text-[#fdea83]">หน้าบัญชีสมาชิกที่ใช้เลือกเลข ส่งโพย ตรวจสอบรายการ และเช็คผลหลังประกาศผลของแต่ละรอบ</strong>
        พร้อมช่องทางฝากถอนผ่านวอลเลทและธนาคารตามที่ระบบเปิดรองรับ จึงจัดการตั้งแต่เลือกหวยไปจนถึงตรวจผลและธุรกรรมได้จากที่เดียว ไม่ต้องจดแยกไว้เองหรือย้อนถามทีละรายการ
      </p>

      <p class="text-left text-base leading-relaxed text-[#f6e6cf]">
        ส่วนรายการที่เปิดรับจริงในแต่ละวันนั้น<strong class="text-[#fdea83]">ขึ้นอยู่กับตารางของหวยแต่ละประเภทและรอบเวลาที่ระบบเปิดรับในขณะนั้น</strong>
        หลังส่งโพยจึงควรตรวจสอบชื่อหวย รอบเวลา เลขที่เลือก และยอดเดิมพันให้ถูกต้องทุกครั้ง แทนการอ้างจากรอบก่อนหน้าที่เคยเล่นไว้
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/ทดลองเล่น"
          aria-label="เปิดหน้าทดลองเล่นของ หวยเฮง24"
          class="flex items-center justify-center rounded-lg border border-[#e0a52a]/35 bg-[#3d0808] px-8 py-3 font-bold text-[#f6e6cf] transition-all hover:scale-105 hover:border-[#e0a52a] hover:bg-[#2e0707] hover:text-[#fdea83]">
          ไปหน้าทดลองเล่น
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="ประเภทหวยที่ หวยเฮง24 เปิดรับ หวยลาว ฮานอย รัฐบาลไทย และหวยหุ้น" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f6e6cf]">
        รายการที่เปิดให้เลือกแบ่งได้เป็นไม่กี่กลุ่มใหญ่ และแต่ละกลุ่ม<strong class="text-[#fdea83]">มีตารางเวลาและเงื่อนไขเป็นของตัวเอง</strong>
        ไม่ได้ใช้ชุดเดียวกันทั้งหมด การรู้ว่าแต่ละกลุ่มต่างกันตรงไหนช่วยให้เลือกรอบที่ตรงกับจังหวะของตัวเองได้เร็วขึ้น
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f6e6cf]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e0a52a]">🏛️</span>
          <span>
            <strong class="text-[#fdea83]">หวยรัฐบาลไทย</strong> เปิดรับตามกำหนดออกรางวัลของแต่ละงวด จึงเป็นกลุ่มที่รอบชัดเจนที่สุดและวางแผนล่วงหน้าได้ง่ายที่สุดสำหรับผู้ที่เพิ่งเริ่มต้น
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fbdc64]">🎫</span>
          <span>
            <strong class="text-[#fdea83]">หวยลาว</strong> เปิดรับตามรายการที่ระบบประกาศไว้ในแต่ละรอบ จึงควรดูตารางและเวลาปิดรับของรอบนั้นจากหน้าส่งโพยก่อนเลือกเลขทุกครั้ง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e0a52a]">🕒</span>
          <span>
            <strong class="text-[#fdea83]">หวยฮานอย</strong> เปิดรับหลายรอบ แต่ละรอบมีเวลาปิดรับของตัวเอง จึงควรอ่านชื่อหวยและรอบเวลาให้ตรงกับที่ต้องการก่อนยืนยันโพย
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#fbdc64]">📈</span>
          <span>
            <strong class="text-[#fdea83]">หวยหุ้น</strong> เปิดรับตามตลาดที่ระบบรองรับและรอบเวลาที่กำหนด จำนวนรายการที่เลือกได้ในแต่ละวันจึงขึ้นอยู่กับตลาดที่เปิดในรอบนั้น
          </span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#f6e6cf]">
        <strong class="text-[#fdea83]">ตารางเวลาและเงื่อนไขของหวยแต่ละประเภทไม่จำเป็นต้องเหมือนกัน</strong>
