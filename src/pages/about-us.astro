---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char, so a byte count reads
// ~3x too long). One string, reused by MainLayout's meta and the WebPage node.
// This page is 156.
const pageDescription =
  "รู้จัก HUAY928 เว็บแทงหวยออนไลน์ที่รวมหวยรัฐบาลไทย ลาว ฮานอย ยี่กี่ และหุ้น ในระบบเดียว 2 ตัวจ่าย 100 และ 3 ตัวจ่าย 1,000 ส่งโพยผ่านมือถือ แอดมินดูแล 24 ชม.";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ HUAY928 เว็บแทงหวยออนไลน์ครบทุกประเภท",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา HUAY928 เว็บแทงหวยออนไลน์ รัฐบาลไทย ลาว ฮานอย ยี่กี่ หุ้น" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ HUAY928" as="h1">
    <div>
      <p class="mb-6 text-left text-base leading-relaxed text-[#d5e3f7]">
        <strong class="text-[#dfb455]">HUAY928</strong> คือ <strong class="text-[#dfb455]">เว็บแทงหวยออนไลน์ที่รวมหวยหลายประเภทไว้ในระบบเดียว</strong>
        ครอบคลุมทั้งหวยรัฐบาลไทย หวยลาว หวยฮานอย หวยยี่กี่ และหวยหุ้น พร้อมรองรับการเดิมพันเลข 2 ตัวและ 3 ตัวตามอัตราจ่ายที่กำหนด
        โดยรอบที่เปิดให้ส่งโพยเป็นไปตามเวลาเปิด-ปิดของหวยแต่ละประเภทที่ระบบแสดงไว้
      </p>

      <p class="mb-2 text-left text-base leading-relaxed text-[#d5e3f7]">
        สมาชิกจัดการทุกอย่างได้ด้วยตัวเองจากบัญชีเดียว ทั้งการเลือกประเภทหวยและรอบที่ต้องการ ตรวจสอบเรทและเลขอั้นก่อนยืนยันโพย
        <strong class="text-[#dfb455]">เลือกเลข ส่งโพย และติดตามสถานะรายการผ่านมือถือได้โดยตรง</strong> รวมถึงดูประวัติโพยและประวัติธุรกรรมย้อนหลัง
        โดยมีแอดมินคอยดูแลเรื่องการสมัคร ฝากถอน และปัญหาการใช้งานตลอดทั้งวัน
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="ประเภทหวยที่ HUAY928 เปิดรับ รัฐบาลไทย ลาว ฮานอย ยี่กี่ และหุ้น" as="h2">
    <div>
      <p class="mb-2 text-left text-base leading-relaxed text-[#d5e3f7]">
        HUAY928 รวมหวยหลายประเภทไว้ให้เลือกตามรอบที่เปิดรับ ทั้ง
        <strong class="text-[#dfb455]">หวยรัฐบาลไทย หวยลาว หวยฮานอย หวยยี่กี่ และหวยหุ้น</strong>
        สมาชิกเลือกประเภทหวยและรอบที่ต้องการ จากนั้นกรอกเลขและยอดเดิมพันผ่านระบบได้โดยตรง
      </p>

      <p class="mt-3 mb-2 text-left text-base leading-relaxed text-[#d5e3f7]">
        ก่อนส่งโพยควรตรวจสอบเวลาเปิด-ปิด อัตราจ่าย เลขอั้น และวงเงินที่ระบบแสดง เนื่องจากรายละเอียดของหวยแต่ละประเภทและแต่ละรอบอาจแตกต่างกัน
        สำหรับข้อความว่าไม่จำกัดยอด ให้
        <strong class="text-[#dfb455]">ยึดวงเงินที่หน้าแทงแสดง ณ เวลาทำรายการเป็นหลัก</strong>
        เพื่อป้องกันความคลาดเคลื่อนหากเลขบางรายการมีการกำหนดวงเงินเฉพาะ
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="อัตราจ่ายของ HUAY928 เลข 2 ตัวจ่าย 100 และ 3 ตัวจ่าย 1,000" as="h2">
    <div>
      <p class="mb-2 text-left text-base leading-relaxed text-[#d5e3f7]">
        เรทที่กำหนดไว้บนหน้าเว็บคือ <strong class="text-[#8fc3ec]">2 ตัวจ่าย 100</strong> และ <strong class="text-[#8fc3ec]">3 ตัวจ่าย 1,000</strong>
        เพื่อให้สมาชิกเห็นข้อมูลก่อนส่งโพย ตัวอย่างการคำนวณคือ หากอัตราจ่ายเป็น 1 บาทต่อ 100 บาท การแทงเลข 2 ตัวจำนวน 10 บาท เมื่อถูกรางวัลตามเงื่อนไขจะคำนวณเป็น 1,000 บาท
        และหากอัตราจ่ายเป็น 1 บาทต่อ 1,000 บาท การแทงเลข 3 ตัวจำนวน 10 บาท จะคำนวณเป็น 10,000 บาท
      </p>

      <p class="mt-3 mb-2 text-left text-base leading-relaxed text-[#d5e3f7]">
        ทั้งนี้ <strong class="text-[#dfb455]">อัตราจ่ายจริงควรยึดตัวเลขที่ระบบ HUAY928 แสดงก่อนยืนยันโพย</strong>
        เนื่องจากเลขบางรายการหรือหวยบางประเภทอาจมีเงื่อนไขแตกต่างกันในแต่ละรอบ
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="สมัครแทงหวย HUAY928 ด้วยตัวเอง และแอดมินดูแลตลอด 24 ชั่วโมง" as="h2">
    <div>
      <p class="mb-4 text-left text-base leading-relaxed text-[#d5e3f7]">
        ผู้ใช้งานใหม่สมัคร HUAY928 และเริ่มส่งโพยได้ด้วยตัวเองโดยไม่ต้องผ่านเจ้ามือ ขั้นตอนไม่ซับซ้อนและรองรับการใช้งานผ่านมือถือ เริ่มจากสมัครสมาชิกและกรอกข้อมูลตามที่ระบบกำหนด
        จากนั้น Login เข้าบัญชีและ<strong class="text-[#dfb455]">ฝากเครดิตผ่านช่องทางที่เปิดให้บริการ</strong> แล้วเลือกหวยและรอบที่ต้องการ กรอกเลขกับยอดเดิมพัน ตรวจสอบเรท แล้วจึงยืนยันโพย
      </p>

      <p class="mb-4 text-left text-base leading-relaxed text-[#d5e3f7]">
        หลังส่งโพยสามารถกลับมาตรวจสอบเลข ยอดเดิมพัน สถานะรายการ และประวัติโพยได้จากบัญชีสมาชิก ควรตรวจสอบข้อมูลให้เรียบร้อยก่อนกดยืนยัน เนื่องจากรายการที่ส่งสำเร็จแล้วอาจไม่สามารถแก้ไขได้ตามเงื่อนไขของระบบ
        หากพบปัญหาเกี่ยวกับการสมัคร Login ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง ส่งโพยไม่สำเร็จ หรือยอดเดิมพันแสดงไม่ถูกต้อง สามารถ
        <strong class="text-[#dfb455]">ติดต่อแอดมิน HUAY928 ได้ตลอด 24 ชั่วโมง</strong>
        พร้อมแจ้งรายละเอียดและเวลาที่เกิดรายการ เพื่อให้เจ้าหน้าที่ตรวจสอบได้ตรงจุด
      </p>

      <p class="mb-6 text-left text-base leading-relaxed text-[#d5e3f7]">
        สมาชิกยังสอบถามเรื่องรอบหวย เวลาเปิดรับ อัตราจ่าย และวิธีใช้งานระบบก่อนส่งโพยได้ โดย
        <strong class="text-[#dfb455]">ไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น</strong>
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก HUAY928"
          class="flex items-center justify-center rounded-lg bg-gradient-to-r from-[#f7d979] via-[#dfb455] to-[#a87a1e] px-8 py-3 font-black text-[#01091b] shadow-[0_0_15px_rgba(168,122,30,0.32)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ HUAY928"
          class="flex items-center justify-center rounded-lg border border-[#a87a1e]/70 bg-transparent px-8 py-3 font-bold text-[#d5e3f7] transition-all hover:scale-105 hover:border-[#dfb455] hover:bg-[#061733]/70">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
