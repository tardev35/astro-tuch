---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

// GPSS789 เป็นเว็บ "คาสิโนตรง" ที่รวมเกมเดิมพันหลายประเภทไว้ในระบบเดียว — บาคาร่า/คาสิโนสด
// แทงบอล สล็อตออนไลน์หลายค่าย และหวยออนไลน์ ไม่ใช่เว็บสล็อตอย่างเดียวแบบแบรนด์ก่อนหน้า
// ทุกข้อความด้านล่างอ้างอิง src/assets/content.txt เท่านั้น ไม่มีการอ้างใบอนุญาต
// การจดทะเบียนบริษัท ปีที่ก่อตั้ง รางวัล จำนวนสมาชิก หรือการันตีผลกำไร
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 159
const pageDescription = "รู้จัก GPSS789 เว็บคาสิโนตรงที่รวมบาคาร่า แทงบอล สล็อตหลายค่าย และหวยออนไลน์ไว้ในบัญชีเดียว พร้อมโปรโมชั่นแนะนำเพื่อน 0.8% คืนยอดเสีย 0.3% และแอดมิน 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ GPSS789 คาสิโนตรง รวมเกมเดิมพันออนไลน์ครบทุกหมวด",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา GPSS789 คาสิโนตรง รวมบาคาร่า แทงบอล สล็อต หวย ไว้ในบัญชีเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ GPSS789 คาสิโนตรง รวมเกมเดิมพันออนไลน์ครบทุกหมวด" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e8dcc4]">
        <strong class="text-[#f5d98a]">GPSS789</strong> เป็นเว็บ<strong class="text-[#f5d98a]">คาสิโนตรง</strong>ที่รวมเกมเดิมพันออนไลน์หลายประเภทไว้ในระบบเดียว
        ตั้งแต่บาคาร่าและคาสิโนสดสำหรับผู้ที่ชอบเกมโต๊ะ การแทงบอลตามรายการแข่งขันที่เปิดให้บริการ สล็อตออนไลน์จากหลายค่าย ไปจนถึงหวยออนไลน์ตามรอบที่กำหนด
        รองรับการใช้งานผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ โดยไม่ต้องเปิดบัญชีแยกตามหมวดเกมที่อยากลอง
      </p>

      <p class="text-left text-base leading-relaxed text-[#e8dcc4]">
        แนวคิดของเว็บคือรวมทุกอย่างไว้ที่หน้าเดียว สมาชิกเลือกหมวดเกม ตรวจสอบโปรโมชั่นที่เปิดให้รับ ทำรายการฝากถอน และดูประวัติรายการของตัวเองได้จากบัญชีเดียวกัน
        พร้อม<strong class="text-[#f5d98a]">โปรโมชั่นแนะนำเพื่อน 0.8%</strong> และ<strong class="text-[#f5d98a]">คืนยอดเสีย 0.3%</strong> ตามเงื่อนไขของแต่ละรายการ
        รวมถึงระบบฝากถอนออโต้และแอดมินที่คอยดูแลปัญหาการใช้งานตลอด 24 ชั่วโมง
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="GPSS789 รวมเกมหลัก บาคาร่า แทงบอล สล็อต หวย ไว้ในบัญชีเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e8dcc4]">
        ภายใน GPSS789 มีเกมหลักให้เลือกหลายหมวดหมู่ สิ่งที่ควรเปิดดูให้ครบก่อนยืนยันรายการคือ
        <strong class="text-[#f5d98a]">กติกาของเกม อัตราจ่าย และรายละเอียดการเดิมพัน</strong> เพราะแต่ละหมวดคิดผลและวางเดิมพันคนละแบบ
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#e8dcc4]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f2c14e]">🃏</span>
          <span><strong class="text-[#f5d98a]">บาคาร่าและคาสิโนสด</strong> สำหรับผู้ที่ชอบเกมโต๊ะและการเดิมพันแบบถ่ายทอดสด ควรอ่านกติกาของโต๊ะและช่วงเดิมพันที่โต๊ะนั้นรองรับก่อนเข้าเล่น</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f2c14e]">⚽</span>
          <span><strong class="text-[#f5d98a]">แทงบอล</strong> ตามรายการแข่งขันที่เปิดให้บริการ ตลาดเดิมพันและอัตราจ่ายเปลี่ยนได้ตลอด จึงควรตรวจสอบตัวเลขล่าสุดในหน้ารายการก่อนยืนยัน</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f2c14e]">🎰</span>
          <span><strong class="text-[#f5d98a]">สล็อตออนไลน์จากหลายค่าย</strong> ทั้งเกมรอบปกติและเกมที่มีฟีเจอร์พิเศษ เลือกตามกลไกและช่วงเดิมพันที่เหมาะกับงบของตัวเอง</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f2c14e]">🎟️</span>
          <span><strong class="text-[#f5d98a]">หวยออนไลน์ตามรอบที่กำหนด</strong> แต่ละรอบมีเวลาปิดรับและอัตราจ่ายของตัวเอง ควรดูรายละเอียดของรอบนั้นก่อนส่งโพย</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#c2cad3]">
        เกมแต่ละประเภทมีรูปแบบและความเสี่ยงแตกต่างกัน ไม่มีเกมไหนรับประกันผลได้เสียล่วงหน้า สมาชิกจึงควรตรวจสอบข้อมูลให้ครบถ้วนและ<strong class="text-[#c2cad3]">กำหนดงบประมาณก่อนเดิมพันทุกครั้ง</strong>
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="โปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ของ GPSS789" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e8dcc4]">
        สมาชิกสามารถ Login เข้าบัญชีเพื่อดูโปรโมชั่นที่เปิดให้รับในแต่ละวันได้โดยตรง กิจกรรม<strong class="text-[#f5d98a]">แนะนำเพื่อน</strong>
        เริ่มจากการนำลิงก์แนะนำส่วนตัวไปแชร์ เมื่อเพื่อนสมัครและมีรายการตรงตามข้อกำหนด ระบบจะคำนวณโบนัสแนะนำเพื่อน 0.8% ตามเงื่อนไข โดยติดตามจำนวนผู้สมัครจากลิงก์
        ยอดที่เข้าเกณฑ์ และโบนัสที่มีสิทธิ์รับได้จากบัญชีของตัวเอง ทั้งนี้การแชร์ลิงก์เพียงอย่างเดียวอาจยังไม่ทำให้ได้รับโบนัส หากโปรโมชั่นกำหนดให้ผู้ถูกแนะนำต้องมียอดใช้งานตามเกณฑ์ด้วย
      </p>

      <p class="text-left text-base leading-relaxed text-[#e8dcc4]">
        ส่วนสมาชิกที่มียอดเสียตรงตามข้อกำหนด สามารถตรวจสอบสิทธิ์รับ<strong class="text-[#f5d98a]">โบนัสคืนยอดเสีย 0.3%</strong> ตามรอบที่ GPSS789 กำหนด
        ระบบจะแสดงยอดที่นำมาคำนวณและโบนัสที่กดรับได้ ก่อนกดรับควรตรวจสอบประเภทเกมที่นับยอด รอบคำนวณ และเงื่อนไขการถอนโบนัสให้เรียบร้อย
        เพราะแต่ละรายการกำหนดเปอร์เซ็นต์ วิธีคำนวณ และข้อกำหนดไว้ไม่เหมือนกัน
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="ระบบฝากถอนออโต้ GPSS789 และแอดมินดูแลตลอด 24 ชั่วโมง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e8dcc4]">
        <strong class="text-[#f5d98a]">ระบบฝากถอนออโต้</strong> ช่วยให้สมาชิกจัดการเครดิตผ่านบัญชีของตนเองได้ ทั้งตรวจสอบช่องทางฝากเงิน ส่งคำขอถอน และติดตามสถานะรายการผ่านหน้าเว็บไซต์
        รองรับธนาคารและวอลเลทตามช่องทางที่เว็บไซต์เปิดให้บริการ ช่วยลดขั้นตอนในการทำธุรกรรมและใช้งานผ่านมือถือได้สะดวกตลอดทั้งวัน
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#e8dcc4]">
        <li class="flex gap-3"><span class="font-bold text-[#f2c14e]">1.</span> เปิดหน้าสมัคร GPSS789 และกรอกข้อมูลตามที่ระบบกำหนด ทำผ่านมือถือหรือคอมพิวเตอร์ได้โดยตรง</li>
        <li class="flex gap-3"><span class="font-bold text-[#f2c14e]">2.</span> Login เข้าบัญชี ฝากเครดิต และตรวจสอบโปรโมชั่นที่มีสิทธิ์รับในวันนั้น</li>
        <li class="flex gap-3"><span class="font-bold text-[#f2c14e]">3.</span> เลือกหมวดเกมที่ต้องการ ทั้งบาคาร่า แทงบอล สล็อต หรือหวย แล้วอ่านกติกาและอัตราจ่ายก่อนเริ่มเดิมพัน</li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#c2cad3]">
        สำหรับรายชื่อธนาคาร วอลเลท ยอดฝากขั้นต่ำ ยอดถอน และวงเงินต่อรายการ ควรตรวจสอบข้อมูลล่าสุดที่แสดงในหน้าฝากถอนก่อนยืนยันธุรกรรมทุกครั้ง เนื่องจากช่องทางและข้อกำหนดอาจแตกต่างกันในแต่ละช่วงเวลา
      </p>

      <p class="text-left text-base leading-relaxed text-[#e8dcc4]">
        หากพบปัญหาเรื่องการสมัครสมาชิก Login ไม่ได้ ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง โปรโมชั่นไม่แสดง หรือเข้าเกมไม่ได้ สามารถ
        <strong class="text-[#f5d98a]">ติดต่อแอดมิน GPSS789 ได้ตลอด 24 ชั่วโมง</strong> พร้อมแจ้งรายละเอียด เวลา และข้อมูลรายการที่เกี่ยวข้อง เพื่อให้เจ้าหน้าที่ตรวจสอบปัญหาได้ตรงจุด
        สมาชิกใหม่ยังสอบถามขั้นตอนสมัคร วิธีฝากถอน หรือวิธีเลือกหมวดเกมที่ต้องการได้เช่นกัน โดย<strong class="text-[#f5d98a]">ไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น</strong>
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก GPSS789"
          class="flex items-center justify-center rounded-lg border border-[#d9a441]/50 bg-gradient-to-r from-[#ffeec2] via-[#d9a441] to-[#7a5312] px-8 py-3 font-black text-[#0a0704] shadow-[0_0_15px_rgba(217,164,65,0.4)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ GPSS789"
          class="flex items-center justify-center rounded-lg border border-[#d9a441]/60 bg-transparent px-8 py-3 font-bold text-[#f5d98a] transition-all hover:scale-105 hover:border-[#f2c14e] hover:bg-[#221a0e]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
