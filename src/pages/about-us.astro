---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char, so a byte count reads
// ~3x too long). One string, reused by MainLayout's meta and the WebPage node.
// This page is 156.
const pageDescription = "รู้จัก JUDTEM168 ศูนย์สล็อตอันดับ1 ที่รวมเกมจาก PG SOFT, Pragmatic Play, JILI, JDB และ Habanero ไว้ในบัญชีเดียว พร้อมระบบฝากถอนออโต้และแอดมินดูแลตลอดทั้งวัน";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ JUDTEM168 ศูนย์สล็อตอันดับ1 รวมค่ายเกมฮิตติดอันดับ",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา JUDTEM168 ศูนย์สล็อตอันดับ1 รวมค่ายเกมฮิต ฝากถอนออโต้" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ JUDTEM168" as="h1">
    <p class="mb-6 text-left text-base leading-relaxed text-[#f0e2bd]">
      <strong class="text-[#e8bf4e]">JUDTEM168</strong> คือ <strong class="text-[#e8bf4e]">ศูนย์รวมเกมสล็อตออนไลน์หลายรูปแบบไว้ให้สมาชิกเลือกเล่นผ่านบัญชีเดียว</strong>
      รองรับการเข้าใช้งานทั้งบนมือถือ แท็บเล็ต และคอมพิวเตอร์ ผ่านเบราว์เซอร์โดยไม่ต้องติดตั้งโปรแกรมเพิ่ม เข้าเล่นเกมได้ตลอดทั้งวันตามรอบที่ผู้ให้บริการเกมเปิดให้บริการจริง
    </p>

    <p class="mb-2 text-left text-base leading-relaxed text-[#f0e2bd]">
      สมาชิกจัดการทุกอย่างได้จากบัญชีเดียว ทั้งการเลือกค่ายและเกมสล็อต ตรวจสอบโปรโมชั่นที่มีสิทธิ์รับตามเงื่อนไข ทำรายการผ่าน
      <strong class="text-[#e8bf4e]">ระบบฝากถอนออโต้ที่ทำรายการได้ตลอดทั้งวัน</strong> และดูประวัติรายการย้อนหลัง โดยมีทีมงานคอยช่วยตรวจสอบปัญหาเกี่ยวกับบัญชี ฝากถอน โปรโมชั่น และการเข้าเกม
      ทั้งนี้ก่อนกรอกข้อมูลบัญชีหรือทำธุรกรรมทุกครั้ง ควรตรวจสอบว่าลิงก์ที่กำลังเปิดอยู่เป็นช่องทางที่ผู้ให้บริการประกาศไว้จริง
    </p>
  </ContentBox>

  <ContentBoxPlain title="ค่ายเกมสล็อตที่ JUDTEM168 รวมไว้ให้เลือกเล่น" as="h2">
    <p class="mb-2 text-left text-base leading-relaxed text-[#f0e2bd]">
      ภายใน JUDTEM168 จัดหมวดหมู่เกมสล็อตจากผู้ให้บริการหลายค่ายไว้ เพื่อช่วยให้สมาชิกค้นหาเกมที่ชอบได้สะดวก เช่น
      <strong class="text-[#e8bf4e]">PG SOFT, Pragmatic Play, JILI, JDB และ Habanero</strong>
      ซึ่งแต่ละค่ายมีทั้งสล็อตธีมเอเชีย เกมโบนัส เกมที่มีฟีเจอร์พิเศษ และสล็อตรูปแบบอื่น ๆ ให้เลือก โดย PG SOFT เน้นเกมที่ออกแบบให้เล่นบนมือถือได้ลื่นไหล เช่น Mahjong Ways, Fortune Tiger และ Lucky Neko
      ส่วน Pragmatic Play มีทั้งสล็อตคลาสสิก เกมที่มี Free Spins และฟีเจอร์โบนัสหลายรูปแบบ
    </p>

    <p class="mt-3 mb-2 text-left text-base leading-relaxed text-[#f0e2bd]">
      ก่อนเข้าเล่นควรตรวจสอบรายชื่อค่ายที่เปิดให้บริการจริง แล้ว
      <strong class="text-[#e8bf4e]">อ่าน Paytable กติกา RTP และรายละเอียดการเดิมพันของแต่ละเกมให้ครบ</strong>
      เพราะแต่ละเกมกำหนดค่าความผันผวน ขนาดเดิมพัน และเงื่อนไขฟีเจอร์ไว้ไม่เหมือนกัน ข้อมูลเหล่านี้แสดงอยู่ในหน้าเกมโดยตรง และให้ยึดข้อมูลล่าสุดที่แสดงภายในระบบ JUDTEM168 เป็นหลัก
    </p>
  </ContentBoxPlain>

  <ContentBoxPlain title="โปรโมชั่นของ JUDTEM168 และเงื่อนไขที่ควรตรวจสอบก่อนกดรับ" as="h2">
    <p class="mb-2 text-left text-base leading-relaxed text-[#f0e2bd]">
      สมาชิกตรวจสอบโปรโมชั่นที่กำลังเปิดให้รับได้จากบัญชีผู้ใช้งานและหน้าโปรโมชั่น โดยรายการหลักคือ
      <strong class="text-[#e8bf4e]">กิจกรรมแนะนำเพื่อนรับโบนัส <span class="text-[#f5d98a]">0.8%</span></strong>
      ซึ่งคำนวณจากยอดของเพื่อนที่สมัครผ่านลิงก์แนะนำและเข้าข้อกำหนด และ
      <strong class="text-[#e8bf4e]">โปรโมชั่นคืนยอดเสียรับโบนัส <span class="text-[#f5d98a]">0.3%</span></strong> สำหรับยอดเสียที่เข้าเงื่อนไขตามรอบที่กำหนด
    </p>

    <p class="mt-3 mb-2 text-left text-base leading-relaxed text-[#f0e2bd]">
      โบนัสแต่ละรายการอาจกำหนดยอดที่นำมาคำนวณ ประเภทเกมที่เข้าร่วม รอบรับสิทธิ์ และข้อกำหนดการถอนแตกต่างกัน สมาชิกจึงควร
      <strong class="text-[#e8bf4e]">ตรวจสอบวิธีคำนวณ รอบเวลา และเงื่อนไขการถอนก่อนกดรับทุกครั้ง</strong>
      ทั้งนี้โปรโมชั่นไม่ได้ทำให้เกมสล็อตมีโอกาสชนะเพิ่มขึ้นหรือรับประกันว่าเกมจะแตกง่าย ควรใช้โบนัสตามเงื่อนไขและกำหนดงบประมาณในการเล่นให้เหมาะสม
    </p>
  </ContentBoxPlain>

  <ContentBoxPlain title="สมัครสมาชิก ฝากถอนออโต้ และการดูแลสมาชิกของทีมงาน JUDTEM168" as="h2">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f0e2bd]">
      เริ่มต้นใช้งาน JUDTEM168 ผ่านมือถือได้ง่ายเพียง 3 ขั้นตอน คือ สมัครสมาชิกและกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน จากนั้น Login เข้าสู่บัญชีและทำรายการฝากเครดิตผ่าน
      <strong class="text-[#e8bf4e]">ระบบออโต้ที่ทำรายการได้ตลอดทั้งวันทั้งคืน</strong> แล้วเลือกค่ายและเกมสล็อตที่ต้องการ ตรวจสอบกติกาก่อนเริ่มเดิมพัน สมาชิกตรวจสอบเครดิต ประวัติรายการ และสถานะฝากถอนผ่านบัญชีของตนเองได้
      โดยยอดขั้นต่ำ วงเงิน และช่องทางที่รองรับให้ยึดรายละเอียดล่าสุดในระบบ ณ เวลาทำรายการ และควรใช้ข้อมูลที่ถูกต้องในการสมัคร รวมถึง
      <strong class="text-[#e8bf4e]">ไม่เปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น</strong>
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f0e2bd]">
      หากพบปัญหา Login ไม่ได้ เครดิตไม่เข้า ถอนเงินค้าง โปรโมชั่นไม่แสดง หรือเข้าเกมสล็อตไม่ได้ สามารถ
      <strong class="text-[#e8bf4e]">ติดต่อแอดมิน JUDTEM168 ผ่าน LINE Official</strong>
      พร้อมแจ้งรายละเอียดของรายการ จำนวนเงิน และช่วงเวลาที่เกิดปัญหา เพื่อให้ทีมงานค้นหารายการและตรวจสอบได้ตรงจุด สำหรับระยะเวลาแก้ไขจะขึ้นอยู่กับลักษณะของปัญหาและขั้นตอนตรวจสอบของแต่ละรายการ
    </p>

    <p class="mb-6 text-left text-base leading-relaxed text-[#f0e2bd]">
      ทั้งนี้ <strong class="text-[#e8bf4e]">การเดิมพันมีความเสี่ยงและไม่มีเกมใดรับประกันผลรางวัลได้</strong> ผู้เล่นจึงควรกำหนดงบประมาณของตัวเองก่อนเล่นทุกครั้ง และเล่นเท่าที่รับความเสี่ยงไหว
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก JUDTEM168"
        class="flex items-center justify-center rounded-lg bg-gradient-to-r from-[#fae27c] via-[#d8ae3a] to-[#6a5115] px-8 py-3 font-black text-[#050301] shadow-[0_0_15px_rgba(204,156,45,0.32)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ JUDTEM168"
        class="flex items-center justify-center rounded-lg border border-[#cc9c2d]/70 bg-transparent px-8 py-3 font-bold text-[#f0e2bd] transition-all hover:scale-105 hover:border-[#e8bf4e] hover:bg-[#120c04]/70">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
