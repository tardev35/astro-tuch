---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็น **บทความจริง** (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login,
// /register หรือหน้าภาพแบบ /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง
// ไม่ใช่เช็กลิสต์หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้
// (src/assets/content.txt) ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าใหม่จากข้อเท็จจริง
// และคลังคำของบรีฟรอบนี้เท่านั้น (.claude/brand-spec-zane96.md §4-§5)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x5 · h3x0
//   h1  เกี่ยวกับเรา <แบรนด์> สล็อตลิขสิทธิ์แท้ในไทย เว็บตรงไม่ผ่านเอเย่นต์
//   h2  รูปแบบเกมที่ <แบรนด์> นำเสนอ ทั้งสล็อตคลาสสิก ฟีเจอร์ฟรีสปิน และเกมโบนัส
//   h2  <แบรนด์> สล็อตลิขสิทธิ์แท้ เว็บตรงไม่ผ่านเอเย่นต์ และสิ่งที่ควรตรวจสอบ
//   h2  โปรโมชั่น <แบรนด์> คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%
//   h2  สมัครสมาชิก <แบรนด์> ด้วยมือถือ 3 ขั้นตอน
//   h2  แอดมินออนไลน์ตลอด 24ชม. และช่องทางติดต่อของ <แบรนด์>
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) และจาก footer จึงเปิดใช้งานอยู่
//
// มีสำเนาชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro (ของแบรนด์ JEDI66)
// ตัวที่ routing จริงคือไฟล์นี้ Astro ไม่อ่านโฟลเดอร์นั้นเลย **ห้ามแก้ ห้ามลบ
// และห้ามสลับมาแทนไฟล์นี้**
//
// 🚨🚨 ดรอปนี้ (2026-10-25) ยังเป็น **เว็บสล็อต** เหมือนรอบก่อน แต่ **คนละคำนิยาม
// ตัวเอง** บรีฟรอบนี้เรียกตัวเองว่า "สล็อตลิขสิทธิ์แท้ในไทย เว็บตรงไม่ผ่าน
// เอเย่นต์" และระบุ แหล่งรวมเกมสล็อตแบรนด์ดัง · ยูสใหม่เล่นง่ายไม่มีขั้นต่ำ
// 1 บาทก็เล่นได้ · สล็อตคลาสสิก เกมที่มีฟีเจอร์ฟรีสปิน เกมโบนัส · ตารางจ่ายรางวัล ·
// ค่า RTP และความผันผวน (เป็นแนวคิด ไม่มีตัวเลข) · โปรโมชั่นอัปเดตใหม่ทุกสัปดาห์ ·
// คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · สมัครด้วยมือถือ 3 ขั้นตอน ·
// แอดมินออนไลน์ตลอด 24ชม.
// ⚠️⚠️ คำนิยามตัวเองของแบรนด์ขาออกเป็น **คำค้างข้ามแบรนด์** ห้ามหลุดกลับมา
// **รายการคำต้องห้ามเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่** เพื่อไม่ให้
// sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// 🚨 สองคู่ที่ต่างกัน **คำเดียว** จากรอบก่อนและพลาดง่ายที่สุด: บรีฟรอบนี้เขียน
// "อัปเดตใหม่**ทุก**สัปดาห์" (ไม่ใช่ "ตลอดสัปดาห์") และ "สมัครด้วย**มือถือ**"
// (ไม่ใช่ "ด้วยตัวเอง") — ใช้ของบรีฟเสมอ
// 🚨🚨 **บรีฟรอบนี้ไม่พูดถึงธนาคาร วอลเลท หรือการฝากถอนเลยแม้แต่คำเดียว** —
// รอบก่อนๆ เคยมีทั้งหัวข้อ "ระบบฝากถอน" และชื่อวอลเล็ตอยู่บนหน้านี้
// **ทั้งหมดถูกตัดออกและห้ามเขียนกลับเข้ามา** ชื่อวอลเล็ตของแบรนด์ก่อนคือคำที่
// พลาดง่ายที่สุด (ค่าเต็มอยู่ใน brand-spec §5)
// ⚠️⚠️ ชื่อแบรนด์รอบนี้เป็น **ตัวละตินพิมพ์ใหญ่ + เลข เขียนติดกันไม่มีเว้นวรรค**
// ทุกจุด interpolate จาก BRAND_NAME เพื่อไม่ให้ค้างเป็นชื่อแบรนด์ก่อนหน้าตอน
// รีแบรนด์รอบถัดไป **ห้ามพิมพ์ชื่อแบรนด์เป็น literal ในไฟล์นี้**
//
// ⚠️ **รอบนี้สองหน้าหมวดลอตเตอรีถูกปิด** (อยู่ใน src/pages-disabled/)
// **ห้ามลิงก์ไปสอง route นั้นจากหน้านี้** และห้ามใช้คำศัพท์หมวดลอตเตอรีเลย
// route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ทดลองเล่น · /about-us · /contact-us · /terms · /privacy · /line
// ⚠️ toggle cta เปิดอยู่ → /register และ /login เป็นเมนู navbar เองแล้ว และ
// /ทางเข้า ถูกถอดออกจากเมนูด้วยเหตุผลว่ามันเป็นลิงก์ที่สามไปยังสองที่เดิม —
// หน้านี้จึงไม่วางปุ่ม "ไปหน้าทางเข้า" ซ้ำอีก (หน้ายัง route + index อยู่ตามปกติ
// และ footer ยังลิงก์ไปหาได้)
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกมรายตัว ชื่อธนาคารรายตัว จำนวนเกม จำนวนค่าย
// ตัวเลข RTP อัตราจ่าย ชื่อผู้ให้บริการ หน่วยงานกำกับ เลขใบอนุญาต ปีก่อตั้ง
// จำนวนสมาชิก หรือยอดฝากขั้นต่ำที่เป็นตัวเลข แม้แต่รายการเดียว** จึงห้ามเขียน
// ลงหน้าเว็บ · ตัวเลขที่ขึ้นหน้าได้มีแค่ของบรีฟเอง:
// **1 บาท · 0.3% · 0.8% · 3 ขั้นตอน · 24ชม.**
// ⚠️ "ค่า RTP และความผันผวน" พูดถึงได้ในฐานะ **แนวคิด** (บรีฟบรรทัด 6 เขียนเอง)
// แต่ห้ามใส่ค่าเป็นตัวเลขเด็ดขาด
//
// 🚨 **บรีฟรอบนี้โฆษณาแล้วกำกับตัวเองในย่อหน้าเดียวกันแทบทุกย่อหน้า** — ทั้งสอง
// ครึ่งต้อง ship ครบ ประโยคกำกับไม่ใช่ filler ให้ตัดทิ้ง:
// 1) คำกล่าวอ้างเกี่ยวกับลิขสิทธิ์เกมและการเป็นเว็บตรงไม่ผ่านเอเย่นต์ ควรตรวจสอบ
//    ข้อมูลบริษัทและหลักฐานการได้รับอนุญาตจากแหล่งที่เชื่อถือได้ (h1 + h2 #2)
// 2) ควรตรวจสอบยอดเดิมพันขั้นต่ำ ตารางจ่ายรางวัล และกติกาของแต่ละเกมก่อนใช้งาน ·
//    ควรศึกษาค่า RTP และความผันผวนของเกม เพื่อทำความเข้าใจความเสี่ยงโดยไม่คาดหวัง
//    ผลรางวัลที่แน่นอน (h2 #1)
// 3) เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่ม
//    โอกาสชนะในครั้งต่อไป · แม้ระบุว่าไม่จำกัด ควรยืนยันจำนวนบัญชีที่เข้าร่วมได้
//    และรอบจ่ายเครดิต (h2 #3)
// 4) ควรตรวจสอบคุณสมบัติผู้สมัคร ข้อกำหนดด้านอายุ กฎหมายที่เกี่ยวข้อง และนโยบาย
//    ความเป็นส่วนตัว · ไม่เปิดเผยรหัสผ่านและรหัส OTP ให้ใครทราบ (h2 #4)
// 5) ควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชี
//    แอบอ้าง · เก็บหมายเลขรายการและหลักฐานไว้ · ตรวจสอบเวลาการให้บริการจริงจาก
//    ประกาศล่าสุดอีกครั้ง (h2 #5)
//
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) **เนื้อหายังเป็นธีมสว่างและโครมยังเข้มเหมือน
// รอบก่อน แต่ฮิวคนละตระกูลสิ้นเชิง** bg.json ของดรอปนี้คือ
// {"mode":"color","color":"#f8e6f9"} = **ไลแลคอมชมพูจาง** (รอบก่อนเป็นขาว
// อมชมพูที่จางกว่านี้)
// **ห้าม "แก้" การ์ด/ปุ่มกลับไปเป็นพื้นมืด** — พื้นมืดบนหมึก #241046 =
// ตัวอักษรหายไปเลย ไม่ใช่แค่จางลง
// ค่าที่ใช้ได้ในไฟล์นี้: หัวข้อ/`<strong>`/marker **#5411c4** (9.3:1 บนการ์ดขาว) ·
// เนื้อความ #241046 (16.8:1) · หมึกรอง #6b4a86 (7.1:1) · ไวโอเลตนีออน #7a1bd6
// (7.1:1) · ฟ้าอิเล็กทริก #2b3fd9 (7.5:1) · แมเจนต้า #c2178b (5.6:1) ·
// พื้นไล่เฉดปุ่มหลัก #5411c4 -> #8e14b8 -> #c2178b (**พื้นถม** + หมึกขาว #ffffff
// — 9.3 / 7.2 / 5.6:1 ต่อ stop) · ปุ่มรองเป็น #ffffff -> #ece0fb คู่กับหมึก
// #241046 · ผิวยก #f6edfe · wash #ece0fb · เส้นอ่อน #dcc6f4 · เส้นเข้ม #9a6fd0
// (**ทั้งคู่ห้ามถือตัวอักษร**)
// หมึกเนื้อความคือ #241046 (= BRAND_TEXT) ซึ่ง **ไม่ประกาศในไฟล์นี้** การ์ด
// ContentBox ตั้งไว้ให้แล้วและย่อหน้าสืบทอดลงมา
// 🚨🚨 **#f23bb4 บนพื้นขาวได้แค่ 3.5:1 และ #bb6dff ได้ 3.1:1 — ห้ามเป็นสีตัวอักษร**
// และ **ขาวบนสองค่านั้นได้ 2.6 / 2.0:1** ปุ่มหลักจึงจบไล่เฉดที่ #c2178b ไม่ใช่ #f23bb4
// ออราที่อนุญาต: rgba(84,17,196,α) · rgba(122,27,214,α) · rgba(194,23,139,α) ·
// rgba(242,59,180,α) · rgba(43,63,217,α) · rgba(220,198,244,α) · rgba(36,16,70,α)
// ⚠️⚠️ **รอบนี้ไม่มีแดง/ทอง/เหลือง/ส้ม/ครีม/เทาเงินเลยสักค่า** (ทั้งชุดคือพาเลต
// ของแบรนด์ขาออก) ยกเว้น **LINE green #00B900** บนปุ่ม LINE ซึ่งเป็นสีประจำ
// แพลตฟอร์ม (บนผิวขาวต้องเป็นพื้นถม bg-[#00B900] + ตัวอักษรขาว ไม่ใช่ตัวอักษรสีเขียว)
// ⚠️⚠️ **รอบนี้เป็นแบรนด์ม่วง/ชมพู/ฟ้า และทั้งสามตระกูลเคยเป็นฮิวนำของแบรนด์เก่า
// มาแล้ว จึงห้ามเทียบด้วยวงศ์สี** ต้องเทียบ **ทีละค่า** กับตาราง brand-spec §2
// เฮกซ์ของแบรนด์เก่าในคอมเมนต์เขียนแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep สะดุด
// ⚠️ ชุดเมทัลลิกโฮโลแกรม ตู้สล็อต 777 ชิปคาสิโน เชอร์รี่ เพชร กล่องของขวัญ
// ฉากสตูดิโอขาว-ไลแลค และสีผิวนักแสดงในอาร์ตเวิร์กเป็น **วัตถุในภาพ ไม่ใช่สี UI**
// · และ **เวิร์ดมาร์กโครเมียมไล่ฟ้า→ม่วง→แมเจนต้าก็เป็นอาร์ตเวิร์ก ไม่ใช่สี UI**
//
// ลำดับปุ่มในไฟล์นี้สื่อด้วยพื้นถมสามขั้ว (ตรงกับคู่ปุ่มที่ล็อกไว้ใน brand-spec §2):
// · ปุ่มหลัก (สมัครสมาชิก) ไล่เฉด #5411c4 -> #8e14b8 -> #c2178b หมึกขาว #ffffff
// · ปุ่มรอง (เข้าสู่ระบบ) ไล่เฉดผิวสว่าง #ffffff -> #ece0fb หมึกอินดิโก #241046
// · ปุ่มลิงก์ภายในเป็นปุ่ม outline ขอบ #5411c4 ตัวอักษร #5411c4 บนการ์ดขาว
//   hover ยกพื้นขึ้นเป็นผิวยก #f6edfe
// · ชิปไอคอนของรายการใช้ขอบ #dcc6f4 บน wash #ece0fb ไม่ถือตัวอักษร
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง และไม่ใส่ mx-auto / max-w-* บน <p>
// เพราะการ์ดคุมความกว้างเองแล้ว — ที่ประกาศสีได้มีแค่ปุ่ม ชิปไอคอน marker ของ
// ลำดับเลข และ <strong> · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง
// เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำ
// จะขาดครึ่ง (ลบแท็ก <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิม) และห้ามวาง
// <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังใน prop ที่เป็นข้อความ และต้องเป็นไอคอนหมวดสล็อต ไม่ใช่ไอคอนหมวดลอตเตอรี
// slot ของ ContentBox รับ **หนึ่ง element** เท่านั้น จึงห่อด้วย <div> ชั้นเดียว
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: รูปของดรอปนี้ถูกตรึงไว้ที่อื่นครบทุกไฟล์ —
// slide1/slide2 ถูกตรึงไว้กับ index §4 ข้อ 4-5 กับ /promotion · banner1 /
// banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// banner2/banner3 (2026-10-23) และ slide3/slide4 (2026-09-29) เป็นอาร์ตเวิร์ก
// ของแบรนด์อื่น **ห้าม import ทั้งสี่ไฟล์** (ลำพังการ import ก็ทำให้ไฟล์ถูก emit
// ลง dist/ และ verify-build จะแดง) — ไฟล์ทั้งหมดยังอยู่บนดิสก์ **ห้ามลบ**
// เป็นอินเวนทอรีของแบรนด์ถัดไป · อาร์ตสต็อก gamedemo8/gamedemo16 ถูกตรึงไว้กับ
// /ทดลองเล่น
//
// Announcement รอบนี้หมุนมาเป็น Announcement2 ทั้งเว็บ (brand-spec §3 — รอบก่อนใช้
// Announcement5 จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้
// ของแบรนด์นี้แล้ว จึงเรียกแบบ bare **ห้ามส่ง prop message** มิฉะนั้นตัววิ่งจะพูด
// คนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -c บนเชลล์นี้
// ก็นับเป็นไบต์ ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับตัวนับ
// ของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 156 อักขระ (ชื่อแบรนด์รอบนี้ 6 อักขระ รอบก่อน 12) เป็นประโยคเดียว
// ที่บอกว่าหน้านี้มีอะไร แล้วหยุด
// (Google ตัดราว 160 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนๆ ยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} สล็อตลิขสิทธิ์แท้ในไทย รวมข้อมูลรูปแบบเกม โปรโมชั่นคืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% วิธีสมัครด้วยมือถือ 3 ขั้นตอน และช่องทางติดต่อ 24ชม.`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} สล็อตลิขสิทธิ์แท้ในไทย เว็บตรงไม่ผ่านเอเย่นต์`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

// คลาสปุ่มสามขั้วของหน้านี้ ประกาศครั้งเดียวแล้วใช้ซ้ำ เพื่อไม่ให้สองปุ่มที่ทำ
// หน้าที่เดียวกันหลุดไปคนละเฉดตอนรีแบรนด์รอบหน้า
const ctaPrimary =
  "flex items-center justify-center rounded-full border border-[#5411c4] bg-gradient-to-b from-[#5411c4] via-[#8e14b8] to-[#c2178b] px-8 py-3 font-black text-white shadow-[0_6px_18px_rgba(84,17,196,0.3)] transition-transform hover:scale-105";

const ctaSecondary =
  "flex items-center justify-center rounded-full border border-[#9a6fd0] bg-gradient-to-b from-[#ffffff] to-[#ece0fb] px-8 py-3 font-bold text-[#241046] shadow-[0_6px_18px_rgba(220,198,244,0.65)] transition-transform hover:scale-105";

const ctaQuiet =
  "flex items-center justify-center rounded-full border-2 border-[#5411c4] bg-[#ffffff] px-8 py-3 font-bold text-[#5411c4] shadow-[0_4px_14px_rgba(122,27,214,0.2)] transition-all hover:scale-105 hover:bg-[#f6edfe] hover:shadow-[0_6px_18px_rgba(84,17,196,0.22)]";

const listChip = "mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#dcc6f4] bg-[#ece0fb] text-sm";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#5411c4]">{BRAND_NAME} นำเสนอเกมสล็อตออนไลน์จากค่ายเกมหลากหลายแบรนด์ พร้อมระบบสมาชิกที่ออกแบบให้ใช้งานผ่านมือถือได้สะดวก</strong>
        หน้านี้สรุปไว้ว่าเว็บไซต์ระบุอะไรไว้บ้าง และควรเปิดอ่านรายละเอียดส่วนไหนก่อน เพื่อให้เห็นภาพรวมก่อนไล่อ่านเงื่อนไขของแต่ละรายการเป็นรายข้อ
      </p>

      <p>
        ภายในเว็บไซต์รวบรวมข้อมูลเกมสล็อต โปรโมชั่น และช่องทางติดต่อเจ้าหน้าที่ไว้ในที่เดียว
        <strong class="text-[#5411c4]">ผู้ใช้งานสามารถศึกษารายละเอียดเกมและเงื่อนไขต่าง ๆ ก่อนใช้งาน</strong>
        โดยเฉพาะผู้ที่เพิ่งเริ่มต้นและต้องการทำความเข้าใจระบบก่อน เพราะข้อมูลแต่ละชุดถูกแยกไว้คนละหน้า และแต่ละชุดก็มีเงื่อนไขของตัวเองที่ไม่ได้เหมือนกันทั้งหมด
      </p>

      <p>
        <strong class="text-[#5411c4]">ส่วนคำกล่าวอ้างเกี่ยวกับลิขสิทธิ์เกมและการเป็นเว็บตรงไม่ผ่านเอเย่นต์ ควรตรวจสอบข้อมูลบริษัทและหลักฐานการได้รับอนุญาตจากแหล่งที่เชื่อถือได้</strong>
        เนื้อหาในหน้านี้จึงเขียนไว้ประกอบการใช้งานเท่านั้น ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้บริการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`รูปแบบเกมที่ ${BRAND_NAME} นำเสนอ ทั้งสล็อตคลาสสิก ฟีเจอร์ฟรีสปิน และเกมโบนัส`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#5411c4]">{BRAND_NAME} นำเสนอเกมสล็อตจากค่ายต่าง ๆ โดยมีข้อมูลการเดิมพันเริ่มต้น 1 บาทสำหรับบางรายการตามที่ระบุ</strong>
        รายการด้านล่างคือกลุ่มเกมที่เว็บไซต์ระบุไว้ และเป็นจุดเริ่มต้นสำหรับคนที่ยังไม่แน่ใจว่าควรเปิดอ่านรายละเอียดของเกมแบบไหนก่อน
      </p>

      <ul class="flex flex-col gap-4" aria-label="กลุ่มเกมที่เว็บไซต์ระบุไว้">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎰</span>
          <span>
            <strong class="text-[#5411c4]">สล็อตคลาสสิก</strong> คือกลุ่มที่โครงสร้างการเล่นตรงไปตรงมาที่สุด เหมาะกับการทำความเข้าใจกติกาพื้นฐานก่อนขยับไปดูเกมกลุ่มอื่น
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🌀</span>
          <span>
            <strong class="text-[#5411c4]">เกมที่มีฟีเจอร์ฟรีสปิน</strong> คือกลุ่มที่มีรอบหมุนเพิ่มตามเงื่อนไขของตัวเอง ซึ่งวิธีเข้ารอบและการคิดรางวัลระบุไว้ในหน้าเกมแต่ละเกม ไม่ใช่ที่หน้ารวม
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎁</span>
          <span>
            <strong class="text-[#5411c4]">เกมโบนัส</strong> คือกลุ่มที่มีกติกาแตกต่างกันไปในแต่ละเกม จึงเป็นกลุ่มที่ควรอ่านกติกาและตารางจ่ายรางวัลให้จบก่อนเริ่มเล่นมากที่สุด
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#5411c4]">สมาชิกใหม่ควรตรวจสอบยอดเดิมพันขั้นต่ำ ตารางจ่ายรางวัล และกติกาของแต่ละเกมก่อนใช้งาน</strong>
        เพราะเกมสล็อตแต่ละประเภทอาจกำหนดวงเงินเดิมพันไม่เท่ากัน นอกจากนี้ควรศึกษาค่า RTP และความผันผวนของเกม เพื่อทำความเข้าใจความเสี่ยงโดยไม่คาดหวังผลรางวัลที่แน่นอน
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/ทดลองเล่น" aria-label={`เปิดหน้าทดลองเล่นของ ${BRAND_NAME}`} class={ctaQuiet}>ไปหน้าทดลองเล่น</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`${BRAND_NAME} สล็อตลิขสิทธิ์แท้ เว็บตรงไม่ผ่านเอเย่นต์ และสิ่งที่ควรตรวจสอบ`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#5411c4]">{BRAND_NAME} ระบุตัวเองว่าเป็นสล็อตลิขสิทธิ์แท้ในไทย เว็บตรงไม่ผ่านเอเย่นต์ และเป็นแหล่งรวมเกมสล็อตแบรนด์ดัง</strong>
        รายการด้านล่างคือสิ่งที่ผู้ใช้งานควรตรวจสอบก่อนสมัครสมาชิก เพราะเป็นข้อมูลที่ยืนยันได้จากแหล่งที่มา ไม่ใช่จากตัวข้อความโฆษณาเอง
      </p>

      <ul class="flex flex-col gap-4" aria-label="สิ่งที่ควรตรวจสอบก่อนสมัครสมาชิก">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🏢</span>
          <span>
            <strong class="text-[#5411c4]">ข้อมูลบริษัทผู้ให้บริการ</strong> ควรตรวจสอบให้ตรงกับข้อมูลที่เว็บไซต์แสดงไว้ และควรหาข้อมูลประกอบจากแหล่งที่เชื่อถือได้ก่อนตัดสินใจ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📑</span>
          <span>
            <strong class="text-[#5411c4]">หลักฐานการได้รับอนุญาตและที่มาของลิขสิทธิ์เกม</strong> คือสองจุดที่บรีฟของเว็บไซต์ระบุให้ตรวจก่อนเสมอ ไม่ใช่สิ่งที่สรุปได้จากข้อความบนหน้าเว็บ
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📘</span>
          <span>
            <strong class="text-[#5411c4]">กติกาเกม ตารางจ่ายรางวัล และข้อกำหนดการใช้งาน</strong> ควรอ่านให้ครบ เพื่อประกอบการพิจารณาความน่าเชื่อถือของเว็บไซต์ด้วยข้อมูลที่ตรวจสอบได้
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#5411c4]">คำกล่าวอ้างเกี่ยวกับลิขสิทธิ์เกมและการเป็นเว็บตรงไม่ผ่านเอเย่นต์ ควรตรวจสอบข้อมูลบริษัทและหลักฐานการได้รับอนุญาตจากแหล่งที่เชื่อถือได้</strong>
        หน้านี้จึงชี้ว่าควรอ่านอะไรและหาข้อมูลจากที่ไหน แทนที่จะยืนยันแทนเว็บไซต์ เพราะสิ่งที่ยืนยันได้จริงคือเอกสารและข้อมูลที่เปิดให้ตรวจสอบ ไม่ใช่ข้อความบนหน้าโฆษณา
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`โปรโมชั่น ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} นำเสนอข้อมูลโปรโมชั่นสำหรับสมาชิกไว้สองรายการหลัก คือ
        <strong class="text-[#5411c4]">คืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อน โบนัส 0.8% ไม่จำกัด</strong>
        โดยเว็บไซต์ระบุว่าโปรโมชั่นอัปเดตใหม่ทุกสัปดาห์ สมาชิกจึงควรติดตามรายละเอียดโปรโมชั่นประจำสัปดาห์เพื่อศึกษารอบรับเครดิตและเงื่อนไขการเข้าร่วม
      </p>

      <p>
        รายการคืนยอดเสียระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขรายวัน
        <strong class="text-[#5411c4]">สมาชิกควรตรวจสอบว่าเกมสล็อตประเภทใดเข้าร่วมรายการ มีรอบสรุปยอดเวลาใด และต้องกดรับเครดิตด้วยตนเองหรือระบบดำเนินการให้อัตโนมัติ</strong>
        เพราะยอดเสียบางรายการอาจไม่เข้าเกณฑ์รับสิทธิ์ ทั้งนี้ เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งต่อไป
      </p>

      <p>
        ส่วนรายการแนะนำเพื่อนระบุสิทธิ์ไว้สำหรับสมาชิกที่แนะนำผู้ใช้งานรายใหม่ โดยควรตรวจสอบวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และฐานยอดที่ใช้คำนวณโบนัสให้ชัดเจน
        <strong class="text-[#5411c4]">แม้จะมีข้อความว่าไม่จำกัด แต่ควรยืนยันจำนวนบัญชีที่เข้าร่วมได้ รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุด</strong>
        เพื่อป้องกันความเข้าใจคลาดเคลื่อนเกี่ยวกับจำนวนเครดิตที่มีสิทธิ์ได้รับ
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/promotion" aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`} class={ctaQuiet}>ดูภาพโปรโมชั่น</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`สมัครสมาชิก ${BRAND_NAME} ด้วยมือถือ 3 ขั้นตอน`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#5411c4]">{BRAND_NAME} มีข้อมูลการสมัครสมาชิกสำหรับผู้ที่ต้องการศึกษาวิธีลงทะเบียนผ่านโทรศัพท์มือถือ</strong>
        ก่อนดำเนินการควรตรวจสอบคุณสมบัติผู้สมัคร ข้อกำหนดด้านอายุ กฎหมายที่เกี่ยวข้อง และนโยบายความเป็นส่วนตัวให้ครบถ้วน ลำดับด้านล่างเรียงตามที่เว็บไซต์ระบุไว้
      </p>

      <ol class="ml-6 list-decimal space-y-3 marker:font-black marker:text-[#5411c4]">
        <li>
          <strong class="text-[#5411c4]">เข้าสู่หน้าสมัครสมาชิก</strong> เปิดเว็บไซต์ผ่านเบราว์เซอร์บนมือถือ ตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง จากนั้นเลือกเมนูสมัครสมาชิกและอ่านข้อกำหนดการเปิดบัญชีก่อนดำเนินการ
        </li>
        <li>
          <strong class="text-[#5411c4]">กรอกข้อมูลและยืนยันบัญชี</strong> กรอกข้อมูลตามที่เว็บไซต์กำหนด ตรวจสอบความถูกต้องก่อนยืนยัน และตั้งรหัสผ่านที่คาดเดาได้ยาก ไม่ควรใช้ข้อมูลของบุคคลอื่นหรือเปิดเผยรหัสผ่านและรหัส
          OTP ให้ใครทราบ
        </li>
        <li>
          <strong class="text-[#5411c4]">เข้าสู่ระบบและตรวจสอบรายละเอียดเกม</strong> หลังลงทะเบียนเรียบร้อย สามารถศึกษารายชื่อเกมสล็อต กติกาการเล่น ยอดเดิมพันขั้นต่ำ และเงื่อนไขโปรโมชั่นที่เปิดให้บริการ
          หากมีข้อสงสัยเกี่ยวกับระบบสมาชิกควรสอบถามเจ้าหน้าที่ผ่านช่องทางทางการก่อนทำรายการ
        </li>
      </ol>

