---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่ม) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง
// ไม่ได้มาจากเช็กลิสต์หัวข้อของ docx ที่ใช้กับ index.astro
//
// บรีฟรอบนี้ (ดรอป 2026-09-22) คือ "HENG38 เว็บรวมสล็อตใหญ่ เกมแท้ค่ายดัง
// ส่งตรงจากบริษัทแม่" — เป็นเว็บ "สล็อต" ไม่ใช่เว็บหวย คอปปี้ของแบรนด์รอบก่อน
// (หวยพยัคฆ์ "แทงหวย รัฐบาลไทย ฮานอย ลาวพัฒนา จ่ายเต็ม" เลข 2 ตัวจ่าย 100 /
// เลข 3 ตัวจ่าย 1,000) ถูกเขียนใหม่ทั้งหน้าแล้ว ไม่เหลือประโยคเดิมและไม่เหลือ
// หัวข้อเรื่องหวยแม้แต่หัวข้อเดียว ห้ามเอ่ยรอบหวย ประเภทเลข หรืออัตราจ่ายต่อเลข
//
// ข้อเท็จจริงทุกบรรทัดมาจากบรีฟรอบนี้เท่านั้น: รวมเกมแท้จากค่ายดังไว้ในระบบเดียว ·
// มีทั้งเกมยอดนิยม เกมใหม่ และสล็อตหลายรูปแบบ · เมนูจัดหมวดหมู่ชัดเจน ใช้งานได้
// ทั้งมือถือและคอมพิวเตอร์ · บัญชีเดียวไม่ต้องสลับหลายเว็บไซต์ · ระบบ API เชื่อม
// เกมจากค่ายตามที่เว็บไซต์ระบุ เปิดเกมและสลับค่ายได้จากหน้าเดียว ส่งตรงจากบริษัทแม่ ·
// ตรวจสอบชื่อค่าย รายละเอียดเกม และข้อมูลที่เกี่ยวข้องได้จากหน้าระบบ · โบนัสแนะนำ
// เพื่อน 0.8% · โบนัสคืนยอดเสีย 0.3% · เช็กยอดที่เข้าเกณฑ์ รอบคำนวณ และข้อกำหนด
// ก่อนกดรับ · สมัครเองได้ผ่านหน้าเว็บไซต์ใน 3 ขั้นตอน · เดิมพันเริ่มต้นตามเงื่อนไข
// ของแต่ละเกม · แอดมินออนไลน์ 24 ชั่วโมง · รายการเกมอาจอัปเดตตามช่วงเวลา
// — ห้ามอ้างเลขใบอนุญาต ปีที่ก่อตั้ง เลขทะเบียนบริษัท จำนวนสมาชิก จำนวนทีมงาน
// รางวัล ที่อยู่บริษัท RTP เปอร์เซ็นต์แตกอื่นนอกจาก 0.8%/0.3% "ปลอดภัย 100%"
// หรือการันตีว่าจะชนะ เพราะบรีฟไม่ได้ระบุไว้
//
// Announcement รอบนี้หมุนมาใช้ AnnouncementPremium ทั้งเว็บ — default message
// ของไฟล์นั้นเป็นคอปปี้ของ HENG38 อยู่แล้ว จึงเรียกแบบ bare เหมือน index.astro
// ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ HENG38 (มรกต + ทอง แทนกรมท่า + ทองของ หวยพยัคฆ์):
// พื้น #03140a · การ์ด #061f0f · ผิวยก #0a2d16 · ขอบบรอนซ์ #a5761a ·
// ทองหลัก #f3cf63 · ทองสว่าง #fbeeb0 · เนื้อความ #e6e2d2 · <strong> #f3cf63 ·
// ตัวอักษรบนปุ่มทอง #03140a · เงาลึก rgba(3,20,10,α) · ออร่าทอง rgba(243,207,99,α)
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index และ
// /promotion ส่วนแกลเลอรี gamedemo7..18.webp เป็นของแบรนด์อื่น (mtime
// 2026-08-04) และสองใบในชุดมีโลโก้เว็บเจ้าอื่นพิมพ์ทับอยู่ ห้าม import
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 154
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "เกี่ยวกับ HENG38 เว็บรวมสล็อตใหญ่ที่รวมเกมแท้จากค่ายดังไว้ในระบบเดียว การันตีระบบ API 100% ส่งตรงจากบริษัทแม่ พร้อมโปรโมชั่นที่ตรวจสอบเงื่อนไขได้ก่อนกดรับ";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับเรา HENG38 เว็บรวมสล็อตใหญ่ เกมแท้ค่ายดัง ครบทุกเกมฮิต",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา HENG38 เว็บรวมสล็อตใหญ่ เกมแท้ค่ายดัง ครบทุกเกมฮิต" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับเรา HENG38 เว็บรวมสล็อตใหญ่ เกมแท้ค่ายดัง ครบทุกเกมฮิต" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e6e2d2]">
        <strong class="text-[#f3cf63]">HENG38</strong> คือเว็บรวมสล็อตใหญ่ที่รวบรวม<strong class="text-[#f3cf63]">เกมแท้จากค่ายดังไว้ในระบบเดียว</strong>
        ภายในมีทั้งเกมยอดนิยม เกมใหม่ และสล็อตหลายรูปแบบให้เลือกตามสไตล์ที่ต้องการ เมนูถูกจัดหมวดหมู่ไว้ชัดเจนและใช้งานได้ทั้งบนมือถือและคอมพิวเตอร์ จึงเหมาะกับคนที่ต้องการเลือกเกมฮิตจากหลายค่ายผ่านบัญชีเดียวโดยไม่ต้องสลับหลายเว็บไซต์
      </p>

      <p class="text-left text-base leading-relaxed text-[#e6e2d2]">
        หน้านี้รวบรวมไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่โครงของหน้ารวมเกมและการจัดหมวดหมู่ค่าย รูปแบบการเชื่อมต่อเกมที่เว็บไซต์ระบุไว้
        รายการโปรโมชั่นที่เปิดให้สมาชิกตรวจสอบเงื่อนไขก่อนกดรับ ขั้นตอนการสมัครสมาชิก ไปจนถึงช่องทางติดต่อทีมงานเมื่อมีข้อสงสัยระหว่างใช้งาน
      </p>

      <p class="text-left text-base leading-relaxed text-[#e6e2d2]">
        <strong class="text-[#f3cf63]">รายการเกมภายในระบบอาจมีการอัปเดตตามช่วงเวลา</strong>
        รายละเอียดทั้งหมดจึงยึดตามค่ายและเกมที่เปิดให้ใช้งานจริงในช่วงนั้นเป็นหลัก และควรตรวจสอบรายการล่าสุดได้จากหน้ารวมเกมก่อนเข้าเล่นทุกครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ระบบ API 100% ของ HENG38 ส่งตรงจากบริษัทแม่" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e6e2d2]">
        จุดตั้งต้นของ HENG38 คือการยก<strong class="text-[#f3cf63]">เกมแท้จากค่ายดังหลายค่ายมาไว้ในระบบเดียว</strong>
        ทั้งเกมยอดนิยมที่คนเล่นกันประจำ เกมใหม่ที่เพิ่งเปิดให้ใช้งาน และสล็อตหลายรูปแบบสำหรับคนที่อยากเปลี่ยนแนว เมนูถูกจัดหมวดหมู่ไว้ชัดเจน การมองหาค่ายที่ต้องการหรือไล่ดูเกมภายในค่ายเดียวกันจึงทำได้จากหน้าเดียว
      </p>

      <p class="text-left text-base leading-relaxed text-[#e6e2d2]">
        HENG38 ชูจุดเด่นเรื่อง<strong class="text-[#f3cf63]">ระบบ API ที่เชื่อมต่อเกมจากค่ายตามที่เว็บไซต์ระบุ</strong>
        ช่วยให้การเปิดเกมและสลับค่ายทำได้จากหน้าเดียว พร้อมรูปแบบการเชื่อมต่อจากระบบบริษัทแม่ เพื่อให้สมาชิกเข้าถึงรายการเกมได้สะดวกโดยไม่ต้องออกจากหน้ารวมเกมไปเปิดที่อื่น และเนื่องจากระบบรองรับทั้งมือถือและคอมพิวเตอร์
        รายการเกมชุดเดิมจึงเปิดต่อได้จากอุปกรณ์ไหนก็ได้ด้วยบัญชีเดียวกัน
      </p>

      <p class="text-left text-base leading-relaxed text-[#e6e2d2]">
        ก่อนเข้าเล่นสามารถ<strong class="text-[#f3cf63]">ตรวจสอบชื่อค่าย รายละเอียดเกม และข้อมูลที่เกี่ยวข้องได้จากหน้าระบบ</strong>
        ทั้งรูปแบบของเกม ฟีเจอร์ที่เกมนั้นมี และเงื่อนไขเดิมพันเริ่มต้นที่แต่ละค่ายกำหนดไว้ไม่เท่ากัน การเปิดดูข้อมูลให้ครบก่อนจึงช่วยให้เลือกเกมที่เหมาะกับงบและสไตล์ของตัวเองได้ง่ายขึ้น
      </p>
    </div>
  </ContentBox>

  <ContentBox title="โปรโมชั่น HENG38 แนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e6e2d2]">
        โปรโมชั่นของ HENG38 มีสิทธิ์สำหรับสมาชิกหลายรูปแบบ โดยเน้นรายการที่
        <strong class="text-[#f3cf63]">ตรวจสอบเงื่อนไขและกดรับผ่านระบบได้เอง</strong>
        สมาชิกสามารถเปิดดูรายละเอียดของแต่ละโปรโมชั่นก่อนรับ เพื่อเช็กยอดที่เข้าเกณฑ์ รอบคำนวณ และข้อกำหนดที่เกี่ยวข้องได้อย่างชัดเจนก่อนตัดสินใจ
      </p>

      <p class="text-left text-base leading-relaxed text-[#e6e2d2]">
        สมาชิกที่แนะนำเพื่อนเข้ามาสมัครสามารถรับ<strong class="text-[#f3cf63]">โบนัสแนะนำเพื่อน 0.8%</strong>
        ตามเงื่อนไขของโปรโมชั่น ระบบมีรายละเอียดให้ตรวจสอบเกี่ยวกับการรับสิทธิ์และยอดที่เข้าเกณฑ์ ช่วยให้ติดตามโบนัสจากการแนะนำเพื่อนได้สะดวก และตรวจสอบข้อมูลผ่านบัญชีสมาชิกได้โดยตรง
      </p>

      <p class="text-left text-base leading-relaxed text-[#e6e2d2]">
        ส่วนโปรโมชั่นคืนยอดเสียให้<strong class="text-[#f3cf63]">โบนัส 0.3%</strong> ตามยอดและเงื่อนไขที่ระบบกำหนด สมาชิกสามารถตรวจสอบรอบคำนวณและรายละเอียดของยอดที่เข้าเกณฑ์ก่อนกดรับ ช่วยให้รู้ข้อมูลของโบนัสในแต่ละรอบได้ชัดเจนและติดตามสิทธิ์ของตัวเองได้ง่ายขึ้น
      </p>
    </div>
  </ContentBox>

  <ContentBox title="สมัคร HENG38 ทำเองได้ผ่านหน้าเว็บไซต์ใน 3 ขั้นตอน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e6e2d2]">
        การสมัคร HENG38 สามารถทำผ่านหน้าเว็บไซต์ได้ด้วยตัวเอง ใช้ขั้นตอนไม่ซับซ้อน หลังสมัครเสร็จสามารถ<strong class="text-[#f3cf63]">
          เข้าสู่ระบบเพื่อเลือกเกมสล็อตที่รองรับการเดิมพันเริ่มต้นตามเงื่อนไขของแต่ละเกม
        </strong>
        โดยมี 3 ขั้นตอนหลักดังนี้
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#e6e2d2]">
        <li class="flex gap-3">
          <span class="font-bold text-[#f3cf63]">1.</span>
          <span>เปิดหน้าสมัคร HENG38 แล้วกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#f3cf63]">2.</span>
          <span>ตรวจสอบข้อมูลส่วนตัวและรายละเอียดบัญชีให้ถูกต้องก่อนกดยืนยัน</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#f3cf63]">3.</span>
          <span>ยืนยันการสมัครและเข้าสู่ระบบ จากนั้นเลือกค่ายและเกมสล็อตที่ต้องการได้ทันที</span>
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#e6e2d2]">
        <strong class="text-[#f3cf63]">ตั้งรหัสผ่านที่คาดเดายาก ไม่ใช้รหัสเดียวกับบริการอื่น และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น</strong>
        รวมถึงตรวจสอบให้แน่ใจว่าเป็นช่องทางติดต่อที่ประกาศไว้บนเว็บไซต์ก่อนส่งข้อมูลใด ๆ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="แอดมิน HENG38 ออนไลน์ 24 ชั่วโมง ติดต่อได้ทันที" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e6e2d2]">
        หากพบปัญหาเกี่ยวกับ<strong class="text-[#f3cf63]">การสมัคร การเข้าเกม โปรโมชั่น ระบบเครดิต หรือการใช้งานภายในเว็บไซต์</strong>
        สามารถติดต่อแอดมิน HENG38 ได้ตลอด 24 ชั่วโมง ทีมงานพร้อมช่วยตรวจสอบข้อมูลและแนะนำขั้นตอนตามปัญหาที่แจ้ง เพื่อให้ทั้งสมาชิกใหม่และสมาชิกเดิมเข้าถึงข้อมูลที่ต้องการได้สะดวกทุกช่วงเวลา
      </p>

      <p class="text-left text-base leading-relaxed text-[#e6e2d2]">
        เวลาแจ้งปัญหาเข้ามา ควรระบุชื่อค่ายและเกมที่เล่นอยู่ เวลาที่เกิดปัญหา และรายละเอียดของรายการให้ครบ เพื่อให้ทีมงานตรวจสอบตามข้อมูลที่แจ้งได้เร็วขึ้น
        <strong class="text-[#f3cf63]">และควรยึดตามยอดและสถานะที่ระบบแสดง ณ เวลาที่ทำรายการเป็นหลัก</strong>
      </p>

      <p class="text-left text-base leading-relaxed text-[#e6e2d2]">
        <strong class="text-[#f3cf63]">ผลของเกมสล็อตทุกเกมตัดสินจากระบบของค่ายเกมนั้น ไม่มีสูตรหรือช่วงเวลาใดรับประกันผล</strong>
        จึงควรกำหนดงบประมาณก่อนเข้าเล่นทุกครั้ง และหยุดเมื่อถึงขีดที่ตั้งไว้
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก HENG38"
