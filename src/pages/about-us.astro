---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// UFA168 รวมเกมเดิมพันหลายหมวดไว้ในบัญชีเดียว — ทุกข้อความด้านล่างอ้างอิง
// src/assets/content.txt เท่านั้น ไม่มีการอ้างใบอนุญาต รางวัล หรือการันตีผลแพ้ชนะ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 157
const pageDescription =
  "รู้จัก UFA168 เว็บเดิมพันที่รวมสล็อต บาคาร่า คาสิโนสด กีฬา และหวย ไว้ในบัญชีเดียว พร้อมโปรโมชั่นแนะนำเพื่อน 0.8% คืนยอดเสีย 0.3% และแอดมินดูแลตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ UFA168 เว็บเดิมพันครบวงจรในบัญชีเดียว",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา UFA168 เว็บเดิมพันครบวงจร รวมทุกหมวดในบัญชีเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ UFA168" as="h1">
    <div>
      <p class="mb-6 text-left text-base leading-relaxed text-[#e6dcc2]">
        <strong class="text-[#f3db5b]">UFA168</strong> เป็นช่องทางสำหรับผู้ที่ต้องการ<strong class="text-[#f3db5b]">รวมเกมเดิมพันออนไลน์หลายประเภทไว้ในบัญชีเดียว</strong>
        รองรับการใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ สมาชิกสามารถเลือกเกม ตรวจสอบโปรโมชั่น ฝากถอน และจัดการข้อมูลของตนเองผ่านระบบออนไลน์ได้ในที่เดียว
        โดยไม่ต้องสลับบัญชีไปมาระหว่างแต่ละหมวดเกม
      </p>

      <p class="mb-2 text-left text-base leading-relaxed text-[#e6dcc2]">
        นอกจากตัวเกมแล้ว สมาชิกยังตรวจสอบสิทธิ์โปรโมชั่นได้จากหน้าเว็บไซต์โดยตรง ทั้ง<strong class="text-[#f3db5b]">แนะนำเพื่อนรับโบนัส 0.8%</strong>
        และ<strong class="text-[#f3db5b]">คืนยอดเสีย 0.3%</strong> ตามเงื่อนไขของแต่ละรายการ พร้อมมีแอดมินคอยให้คำแนะนำและตรวจสอบปัญหาการใช้งานตลอด 24 ชั่วโมง
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="เกมเดิมพันหลายหมวดหมู่ของ UFA168 เลือกได้จากบัญชีเดียว" as="h2">
    <div>
      <p class="mb-2 text-left text-base leading-relaxed text-[#e6dcc2]">
        ภายใน UFA168 มีเกมเดิมพันหลายหมวดหมู่ให้เลือก ไม่ว่าจะเป็น
        <strong class="text-[#f3db5b]">เกมสล็อต บาคาร่า คาสิโนสด เกมไพ่ กีฬา หวย และเกมออนไลน์ประเภทอื่น ๆ</strong>
        สมาชิกสามารถเลือกค่ายและเกมที่สนใจผ่านบัญชีเดียว พร้อมตรวจสอบกติกา อัตราจ่าย และรายละเอียดการเดิมพันก่อนเริ่มเล่น
        เพื่อให้เข้าใจเงื่อนไขของแต่ละเกมอย่างชัดเจนก่อนลงเงินจริง
      </p>

      <p class="mt-3 mb-2 text-left text-base leading-relaxed text-[#e6dcc2]">
        สำหรับข้อมูลเรื่อง<strong class="text-[#d8dce2]">ลิขสิทธิ์หรือผู้ให้บริการเกม</strong>
        ควรตรวจสอบจากข้อมูลของค่ายเกมที่แสดงอยู่ในระบบโดยตรง เนื่องจากแต่ละเกมอาจมาจากผู้พัฒนาหรือผู้ให้บริการแตกต่างกัน
        การอ่านรายละเอียดจากหน้าเกมจึงเป็นข้อมูลที่ตรงกับสิ่งที่เปิดให้บริการอยู่จริงมากที่สุด
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="โปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ของ UFA168" as="h2">
    <div>
      <p class="mb-2 text-left text-base leading-relaxed text-[#e6dcc2]">
        กิจกรรม<strong class="text-[#f3db5b]">แนะนำเพื่อน</strong> เริ่มจากการคัดลอกลิงก์แนะนำส่วนตัวไปแชร์ให้เพื่อน เมื่อเพื่อนสมัครและมียอดการใช้งานตรงตามข้อกำหนด
        ระบบจะคำนวณโบนัสแนะนำเพื่อน 0.8% ตามเงื่อนไข โดยสมาชิกตรวจสอบจำนวนการแนะนำ ยอดที่ใช้คำนวณ และโบนัสที่มีสิทธิ์รับได้ผ่านบัญชีของตนเอง
      </p>

      <p class="mt-3 mb-2 text-left text-base leading-relaxed text-[#e6dcc2]">
        ส่วนสมาชิกที่มียอดเสียเข้าเงื่อนไข สามารถตรวจสอบสิทธิ์รับ<strong class="text-[#f3db5b]">โบนัสคืนยอดเสีย 0.3%</strong> ตามรอบที่กำหนด
        ระบบจะแสดงยอดที่นำมาคำนวณและสิทธิ์ที่กดรับได้ ก่อนกดรับทุกครั้งควรตรวจสอบรอบเวลา ประเภทเกมที่ร่วมรายการ และเงื่อนไขเกี่ยวกับการถอนโบนัสให้ครบถ้วน
        เพราะโปรโมชั่นแต่ละรายการมีวิธีคำนวณและข้อกำหนดแตกต่างกัน
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="สมัคร UFA168 ด้วยตัวเอง 3 ขั้นตอน และแอดมินดูแลตลอด 24 ชั่วโมง" as="h2">
    <div>
      <p class="mb-4 text-left text-base leading-relaxed text-[#e6dcc2]">
        เริ่มต้นสมัคร UFA168 ผ่านมือถือหรือคอมพิวเตอร์ได้ด้วยขั้นตอนที่ไม่ซับซ้อน หลังเปิดบัญชีเรียบร้อยสามารถตรวจสอบเกม โปรโมชั่น และช่องทางฝากถอนผ่านระบบสมาชิกได้ทันที
      </p>

      <ol class="mb-4 flex flex-col gap-2 text-left text-base leading-relaxed text-[#e6dcc2]">
        <li class="flex gap-3"><span class="font-bold text-[#d4af37]">1.</span> เข้าหน้าสมัคร UFA168 และกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน</li>
        <li class="flex gap-3"><span class="font-bold text-[#d4af37]">2.</span> Login เข้าสู่บัญชีและทำรายการฝากเครดิตผ่านช่องทางที่เปิดให้บริการ</li>
        <li class="flex gap-3"><span class="font-bold text-[#d4af37]">3.</span> ตรวจสอบโปรโมชั่น เลือกเกมที่ต้องการ และศึกษากติกาก่อนเริ่มเดิมพัน</li>
      </ol>

      <p class="mb-4 text-left text-base leading-relaxed text-[#e6dcc2]">
        สมาชิกควรตั้งรหัสผ่านที่คาดเดาได้ยาก และ<strong class="text-[#f3db5b]">ไม่เปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น</strong>
        รวมถึงควรตรวจสอบว่ากำลังใช้งานช่องทางของผู้ให้บริการที่ถูกต้องก่อนทำธุรกรรมทุกครั้ง
      </p>

      <p class="mb-6 text-left text-base leading-relaxed text-[#e6dcc2]">
        หากพบปัญหาเกี่ยวกับการสมัครสมาชิก Login ไม่ได้ เครดิตไม่เข้า ถอนเงินล่าช้า โปรโมชั่นไม่แสดง หรือเข้าเกมไม่ได้ สามารถ
        <strong class="text-[#f3db5b]">ติดต่อแอดมิน UFA168 ได้ตลอด 24 ชั่วโมง</strong> พร้อมแจ้งรายละเอียดและเวลาที่เกิดรายการ
        เพื่อให้ทีมงานตรวจสอบข้อมูลและแนะนำขั้นตอนแก้ไขได้ตรงกับปัญหา และหากไม่แน่ใจว่าลิงก์ทางเข้าที่ได้รับถูกต้องหรือไม่ ควรสอบถามเจ้าหน้าที่ก่อน Login หรือฝากเงินทุกครั้ง
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก UFA168"
          class="flex items-center justify-center rounded-lg bg-gradient-to-r from-[#fff3bf] via-[#f3db5b] to-[#a37c14] px-8 py-3 font-black text-[#050403] shadow-[0_0_15px_rgba(243,219,91,0.35)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ UFA168"
          class="flex items-center justify-center rounded-lg border border-[#6b5316]/80 bg-transparent px-8 py-3 font-bold text-[#d8dce2] transition-all hover:scale-105 hover:border-[#f3db5b] hover:bg-[#241a08]/70">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
