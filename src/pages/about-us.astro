---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// GODBET88 เป็นเว็บสล็อตไม่ติดเทิร์น — หน้านี้เคยเป็นบทความของแบรนด์ก่อนหน้า
// (เว็บสล็อตค่ายเดียว ทางเข้าสำรอง เซิร์ฟเวอร์ใหม่ ยูสใหม่) และถูกเขียนใหม่ทั้งหมด
// รอบนี้ ไม่เหลือเนื้อหาเรื่องทางเข้าสำรองหรือชื่อแบรนด์เดิมแม้แต่บรรทัดเดียว
//
// ข้อเท็จจริงทุกบรรทัดมาจาก src/assets/content.txt เท่านั้น:
// เว็บสล็อตเว็บตรง จุดเด่นคือ "ไม่ติดเทิร์น" เล่นได้เท่าไหร่ถอนออกได้ทันที ไม่ต้องทำ
// ยอดเทิร์นโอเวอร์ · สั่งถอนได้ตลอดเวลา ไม่จำกัดรอบบิลต่อวัน ถอนกี่ครั้งก็ได้ ·
// เริ่มต้นเดิมพันเพียง 1 บาท · เกมสล็อตลิขสิทธิ์แท้ครบทุกค่ายดัง PG SLOT,
// Pragmatic Play, Joker Gaming, JILI · ฝาก-ถอนไม่มีขั้นต่ำ ทุน 50 บาทก็ฝากได้ ·
// ถอนได้ทุกยอดแม้หลักล้าน โอนเต็มจำนวน ไม่มีการแบ่งจ่าย ไม่ต้องรอคิว ·
// โปรแนะนำเพื่อน 0.8% จากทุกยอดการเล่นของเพื่อน ถอนเป็นเงินสดได้ ·
// โปรคืนยอดเสีย 0.3% ทุกรอบบิล กดรับสิทธิ์ผ่านหน้าเว็บ · สมัครออโต้ 3 ขั้นตอน
// ไม่ถึง 1 นาที (OTP → ผูกบัญชีธนาคารชื่อตรงกัน รองรับทุกธนาคารชั้นนำและ
// TrueMoney Wallet → ตั้งรหัสผ่าน) · แอดมิน Line Official 24 ชั่วโมง
// — ห้ามอ้างเลขใบอนุญาต ปีที่ก่อตั้ง เลขทะเบียนบริษัท จำนวนสมาชิก รางวัล ที่อยู่บริษัท
// หรือการันตีผลกำไร เพราะบรีฟไม่ได้ระบุไว้เลย
// — Joker Gaming ในหน้านี้เป็น "ค่ายเกม" หนึ่งในสี่ค่ายตามบรีฟ ไม่ใช่ตัวตนของเว็บ
//
// Announcement รอบนี้หมุนมาใช้ Announcement5 ทั้งเว็บ — default message ของไฟล์นั้น
// เป็นคอปปี้ของ GODBET88 อยู่แล้ว จึงเรียกแบบ bare ไม่ต้องส่ง prop
//
// พาเลตต์ GODBET88: แบรนด์นี้มีสีเดียวคือทอง แยกลำดับด้วยความสว่าง — ทองหลัก
// #c2a55c เป็นขอบและไอคอน · ทองอ่อน #e2c87f และทองประกาย #f6e7b8 เป็นสต็อปบน
// ของเกรเดียนต์และสีเดียวที่ใช้กับ <strong> · ทองเข้ม #9a7f3f / #5c4418 เป็นสต็อป
// ล่าง · พื้นดำอมน้ำตาล #0a0806 กับผิวยก #161208 · เนื้อความ #ece1cc
// — ไม่มีแดงเลือดหมูหรือทองเก่าของแบรนด์ก่อนหน้าหลงเหลือ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 160
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "เกี่ยวกับ GODBET88 เว็บสล็อตไม่ติดเทิร์น เล่นได้เท่าไหร่ถอนออกได้ทันที เริ่มเดิมพัน 1 บาท เล่นได้ทุกค่าย ฝาก-ถอนไม่มีขั้นต่ำ แอดมินดูแลผ่าน LINE ตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ GODBET88 เว็บสล็อตไม่ติดเทิร์น ถอนได้ทุกยอด",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา GODBET88 เว็บสล็อตไม่ติดเทิร์น ถอนได้ทุกยอด ไม่มีขั้นต่ำ" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ GODBET88 เว็บสล็อตไม่ติดเทิร์น ถอนได้ทุกยอด" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ece1cc]">
        <strong class="text-[#f6e7b8]">GODBET88</strong> คือ<strong class="text-[#f6e7b8]">เว็บสล็อตเว็บตรงที่เข้าใจคอสล็อตมากที่สุด</strong>
        และปลดล็อคข้อจำกัดที่ผู้เล่นสล็อตออนไลน์เจอกันมาตลอด จุดเด่นที่ทุกคนตามหาและเป็นหัวใจของเราคือการเป็น
        <strong class="text-[#f6e7b8]">เว็บสล็อตไม่ติดเทิร์น</strong> เล่นได้เท่าไหร่ถอนออกได้ทันที ไม่ต้องทำยอดเทิร์นโอเวอร์ให้วุ่นวายและเสียเวลา
      </p>

      <p class="text-left text-base leading-relaxed text-[#ece1cc]">
        เราอยากให้คุณสนุกกับการปั่นสล็อตได้ทั้งวันและทำกำไรได้ต่อเนื่อง จึงให้<strong class="text-[#f6e7b8]">อิสระทางการเงินสูงสุดด้วยระบบที่สั่งถอนเงินได้ตลอดเวลา
        ไม่จำกัดรอบบิลต่อวัน ถอนกี่ครั้งก็ได้ตามใจคุณ</strong> หน้านี้รวบรวมไว้ว่าเราเป็นใคร ระบบไม่ติดเทิร์นทำงานอย่างไร เปิดให้เล่นเกมจากค่ายไหน
        มีโปรโมชั่นอะไร สมัครสมาชิกยังไง และติดต่อทีมงานได้ทางช่องทางใด
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ระบบไม่ติดเทิร์นของ GODBET88 ถอนได้ทุกยอดไม่จำกัดรอบบิล" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ece1cc]">
        คำว่า "สล็อตไม่ติดเทิร์น" หมายถึง<strong class="text-[#f6e7b8]">เมื่อคุณฝากเงินเข้ามาเล่นเกมสล็อตและเล่นได้กำไรตามที่พอใจแล้ว สามารถกดทำรายการถอนเงินได้ทันที 100%</strong>
        โดยไม่จำเป็นต้องทำยอดเล่นสะสม (ยอดเทิร์น) ให้ถึงเป้าตามที่เว็บกำหนดเหมือนเว็บทั่วไป ไม่มีเงื่อนไขซ่อนที่มาหยุดคุณไว้ตอนกำลังจะถอน
      </p>

      <p class="text-left text-base leading-relaxed text-[#ece1cc]">
        และเมื่อแจ็คพอตแตก ไม่ว่ายอดถอนของคุณจะหลักร้อย หลักหมื่น หรือทะลุถึง
        <strong class="text-[#f6e7b8]">หลักล้าน เราก็พร้อมโอนจ่ายให้เต็มจำนวน ถอนได้ทุกยอดทันที ไม่มีกั๊ก ไม่มีอั้น</strong>
        GODBET88 เป็นเว็บตรงที่มีฐานการเงินแข็งแกร่งระดับประเทศ จึงไม่มีการแบ่งจ่าย ไม่ต้องรอคิว ระบบออโต้โอนเงินเข้าบัญชีของคุณอย่างรวดเร็ว
      </p>

      <p class="text-left text-base leading-relaxed text-[#ece1cc]">
        <strong class="text-[#f6e7b8]">ให้ยึดตัวเลขและสถานะที่ระบบแสดง ณ เวลาทำรายการเป็นหลักเสมอ</strong>
        และหากมีข้อสงสัยเรื่องรอบบิลหรือเงื่อนไขการถอนครั้งไหน สอบถามแอดมินก่อนกดทำรายการได้ตลอดเวลา
      </p>
    </div>
  </ContentBox>

  <ContentBox title="เกมสล็อตลิขสิทธิ์แท้ทุกค่ายดังที่ GODBET88 เปิดให้เล่น" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ece1cc]">
        ไม่ว่าคุณจะมีทุนหลักสิบหรือหลักหมื่น ก็เข้ามาสร้างกำไรก้อนโตกับเราได้อย่างเท่าเทียม เพราะเราเปิดโอกาสให้ทุกคนเข้าถึงความสนุกด้วยเงินลงทุน
        <strong class="text-[#f6e7b8]">เริ่มต้นเพียง 1 บาท</strong> แต่เลือกเล่น<strong class="text-[#f6e7b8]">เกมสล็อตลิขสิทธิ์แท้ได้ครบทุกค่ายดังระดับโลก</strong>
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#ece1cc]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#c2a55c]">🎰</span>
          <span><strong class="text-[#f6e7b8]">PG SLOT</strong> เกมสล็อตแตกง่ายที่คอสล็อตไทยคุ้นเคยที่สุด ทั้งภาพ เสียง และฟีเจอร์โบนัสตรงตามที่ค่ายออกแบบไว้</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#c2a55c]">🃏</span>
          <span><strong class="text-[#f6e7b8]">Pragmatic Play</strong> ค่ายระดับโลกที่มีเกมให้เลือกหลากหลายรูปแบบ ตั้งแต่ไลน์การจ่ายมาตรฐานไปจนถึงเกมโบนัสซื้อฟรีสปิน</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#c2a55c]">👑</span>
          <span><strong class="text-[#f6e7b8]">Joker Gaming</strong> ค่ายเกมคลาสสิกที่มีเกมสล็อตให้เลือกจำนวนมาก เล่นเข้าใจง่ายและเป็นที่นิยมต่อเนื่อง</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#c2a55c]">⚡</span>
          <span><strong class="text-[#f6e7b8]">JILI และค่ายอื่น ๆ อีกมากมาย</strong> รวมไว้ในบัญชีเดียว สลับค่ายเล่นได้ทันทีโดยไม่ต้องสมัครหลายยูส</span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#ece1cc]">
        <strong class="text-[#f6e7b8]">รายชื่อเกมและฟีเจอร์ภายในเกมเปลี่ยนแปลงได้ตามรอบการอัปเดตของแต่ละค่าย</strong>
        จึงควรตรวจรายการล่าสุดในหน้าเกมทุกครั้ง และอ่านตารางอัตราจ่ายของเกมนั้นก่อนวางเดิมพัน
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ฝาก-ถอนไม่มีขั้นต่ำ และสมัคร GODBET88 ออโต้ 3 ขั้นตอน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ece1cc]">
        เราให้อิสระขั้นสุดด้วย<strong class="text-[#f6e7b8]">ระบบฝาก-ถอนไม่มีขั้นต่ำ ทุนน้อยก็ฝากเล่นได้</strong>
        มีเงินแค่ 50 บาทก็ฝากเข้ามาปั่นได้จริง เพราะเกมสล็อตของเราเริ่มต้นเบท (Bet) เพียง 1 บาทเท่านั้น ทุนก้อนเล็กจึงยังลุ้นแจ็คพอตหลักหมื่นได้
      </p>

      <p class="text-left text-base leading-relaxed text-[#ece1cc]">
        การเปิดยูสใหม่ใช้<strong class="text-[#f6e7b8]">ระบบสมัครสมาชิกอัตโนมัติ (Auto) ที่รวดเร็วและปลอดภัย ใช้เวลาไม่ถึง 1 นาที</strong>
        ทำเองได้ทั้งหมดบนโทรศัพท์มือถือด้วยสามขั้นตอน คือกรอกเบอร์โทรศัพท์มือถือเพื่อรับรหัส OTP ยืนยันตัวตน ผูกบัญชีธนาคารโดยกรอกชื่อ-นามสกุลและเลขบัญชีที่ต้องการใช้ทำรายการ
        แล้วตั้งรหัสผ่านเข้าใช้งาน จากนั้นล็อคอิน ฝากเงินแบบไม่มีขั้นต่ำ และเริ่มปั่นสล็อตได้เลย
      </p>

      <p class="text-left text-base leading-relaxed text-[#ece1cc]">
        ระบบ<strong class="text-[#f6e7b8]">รองรับทุกธนาคารชั้นนำ รวมถึง TrueMoney Wallet</strong> และ<strong class="text-[#f6e7b8]">ชื่อ-นามสกุลของบัญชีที่ผูกไว้ต้องตรงกับชื่อที่ใช้สมัคร</strong>
        เพราะระบบใช้ข้อมูลชุดนี้ในการโอนยอดเข้า-ออก หากข้อมูลไม่ตรงกัน รายการจะตรวจสอบได้ช้าลง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="โปรสล็อต GODBET88 แนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ece1cc]">
        เพื่อเพิ่มความคุ้มค่าให้กับการลงทุนของคุณ GODBET88 ได้<strong class="text-[#f6e7b8]">คัดสรรโปรโมชั่นสุดพิเศษที่แจกจริง และมอบสิทธิประโยชน์ให้สมาชิกทุกคนอย่างยุติธรรม
        โดยไม่ต้องทำเงื่อนไขยุ่งยาก</strong> โดยสองตัวที่มาแรงที่สุดคือโปรแนะนำเพื่อนและโปรคืนยอดเสีย
      </p>

      <p class="text-left text-base leading-relaxed text-[#ece1cc]">
        <strong class="text-[#f6e7b8]">โปรโมชั่นแนะนำเพื่อน 0.8%</strong> เปลี่ยนช่องทางโซเชียลของคุณให้เป็นเครื่องผลิตเงิน เพียงนำลิงก์ส่วนตัวไปแชร์และชวนเพื่อนมาสมัครเล่นสล็อตกับเรา
        คุณจะได้รับค่าคอมมิชชั่นสูงถึง 0.8% จากทุกยอดการเล่นของเพื่อน ยิ่งเพื่อนเล่นมาก คุณยิ่งได้มาก รับรายได้แบบ Passive Income ตลอดชีพ และถอนเป็นเงินสดได้เลย
      </p>

      <p class="text-left text-base leading-relaxed text-[#ece1cc]">
        <strong class="text-[#f6e7b8]">โปรโมชั่นคืนยอดเสีย 0.3%</strong> ทำให้เล่นสล็อตแบบไม่ต้องกลัวหมดตัว เพราะเรามีระบบเซฟตี้คืนทุนให้ผู้เล่นทุกคนในทุกรอบบิล
        เพื่อให้คุณมีเครดิตสำรองไว้แก้มือและนำไปต่อยอดทำกำไรในเกมสล็อตค่ายโปรดของคุณได้อีกครั้ง กดรับสิทธิ์ได้ง่าย ๆ ผ่านหน้าเว็บ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ทีมงาน GODBET88 ดูแลผ่าน Line Official ตลอด 24 ชั่วโมง" as="h2">
    <div class="flex flex-col gap-4">
