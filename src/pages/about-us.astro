---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login,
// /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx
// ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึง
// เขียนขึ้นใหม่บนข้อเท็จจริงของ UP555 เท่านั้น (src/assets/content.txt)
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
//
// ดรอปนี้ (2026-10-03) คือ UP555 **คาสิโนอัปเดตล่าสุด ปรับปรุงทางเข้าเล่นเกมใหม่**
// แง่มุมที่บรีฟระบุไว้มีเท่านี้: ปรับทางเข้าเล่นเกมคาสิโนใหม่ให้รองรับการใช้งานผ่าน
// มือถือได้สะดวกขึ้น · รวมเกมหลายประเภทไว้ในบัญชีเดียว ทั้งสล็อต บาคาร่า บอล
// (เดิมพันฟุตบอล) และหวย · เลือกหมวดเกม ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการ
// ผ่านระบบเดียว · ปรับส่วนการเข้าสู่ระบบและเมนูให้ค้นหาเกมได้ง่ายขึ้น ·
// คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% (ลิงก์แนะนำ) · สมัครบนมือถือ 3 ขั้นตอน ·
// แอดมิน 24 ชั่วโมง · ห้ามเปิดเผยรหัสผ่าน PIN หรือ OTP
//
// ⚠️ UP555 เป็น **คาสิโน** ที่มีหวยเป็นหนึ่งในหมวดเกม ไม่ใช่เว็บหวย — และบรีฟรอบนี้
// **ไม่ได้** พูดถึง "เว็บตรงต่างประเทศ" "บัญชีบริษัทแท้ 100%" "ไม่ผ่านเอเย่นต์"
// "การันตีระบบเกมมาตรฐาน" "เกมคาสิโนสด" หรือ "จำนวนค่าย" (ของแบรนด์รอบก่อน DM899
// และก่อนนั้น 1SS365) จึงห้ามอ้างชุดคำนั้นทั้งก้อน หน้านี้เขียนขึ้นใหม่จากบรีฟ
// ไม่ใช่ find-and-replace ทับประโยคเดิม
//
// ถึงหวยจะเป็นหมวดเกมที่บรีฟระบุไว้จริง ก็ **ห้ามลิงก์ไป /ตรวจหวย หรือ /แนวทาง**
// เพราะสองหน้านั้นอยู่ใน src/pages-disabled/ = เราต์ตายและทำให้ build แดง
//
// ตัวเลขที่อ้างได้มีแค่ คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · 3 ขั้นตอน ·
// 24 ชั่วโมง ห้ามเพิ่มใบอนุญาต ชื่อหน่วยงานกำกับ ชื่อค่ายเกม ชื่อธนาคาร
// ยอดฝากขั้นต่ำ จำนวนสมาชิก ปีที่ก่อตั้ง หรือค่า RTP เพราะบรีฟไม่ได้เอ่ยไว้สักชื่อ
//
// ประโยคกำกับที่บรีฟเขียนไว้เองและห้ามตัดทิ้งเพราะฟังดูไม่ขายของ: ผลการเดิมพันมี
// ความไม่แน่นอน จึงไม่สามารถรับประกันผลกำไรหรือเงินรางวัลจากการเล่นได้ · ความปลอดภัย
// ควรพิจารณาจากมาตรการที่ตรวจสอบได้ เช่น การรักษาความปลอดภัยของบัญชี ระบบยืนยัน
// ตัวตน และข้อมูลผู้ดำเนินงาน จึงไม่ควรใช้คำว่า "ปลอดภัยแน่นอน" เป็นการรับประกัน
// โดยไม่มีข้อมูลดังกล่าวรองรับ · รายการเกมและผู้ให้บริการอาจอัปเดตตามช่วงเวลา
//
// พาเลตต์ UP555 (brand-spec §2) **ทองนำ เงินโครเมียมรอง บนดำอมน้ำตาล** — โลโก้คือ
// ตัว U/UP สีเงินโครเมียมคู่กับเลข 555 สีทองเมทัลลิก:
// ทองแบรนด์ #ebbb54 (ขอบ ออรา marker ปุ่มรอง) · ทองสว่าง #fce675 (หมึก strong
// ทั้งหน้า + ต้นไล่เฉดปุ่มหลัก) · ทองเข้ม #ab6d24 (ปลายไล่เฉดปุ่มหลัก, ขอบ) ·
// ทองกลาง #d6a53a (ไอคอน bullet) · เงินโครเมียม #d5d4d3 / เงินสว่าง #f3f3f2
// (hover ของปุ่มรอง) · พื้นการ์ด #130b03 · พื้นชิป/ป้าย #241705 · พื้นลึกสุด
// #0c0502 · หมึกบนพื้นทอง #160d02 · เนื้อความ #f8eed9 (BRAND_TEXT)
// ชุดเขียวมรกต-แดง-ทองของ DM899 (#01a326 #4ade6b #12c23a #01841b #fb252b #ffe9a8
// #f2b422 #0a1a0e #102a16 #06140a #e4f2e4 และ rgba(1,163,38,*) rgba(3,10,5,*))
// ออกครบทุกจุดแล้ว
// #00B900/#009900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้
// กฎคอนทราสต์: พื้นทองสว่าง → หมึก #160d02 เสมอ และปุ่มรองเป็น "ขอบทองบนพื้นดำ
// อมน้ำตาล" ไม่ใช่ถมทองอีกใบ
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// — การ์ดตั้งสีเนื้อความ #f8eed9 ไว้ที่ตัวการ์ดแล้ว ย่อหน้าจึงไม่ใส่คลาสสีซ้ำ
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจาก
// หน้า และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น Announcement5 ทั้งเว็บ (รอบก่อน DM899 ใช้ Announcement3)
// — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ UP555 แล้ว จึงเรียก
// แบบ bare ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 159
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} คาสิโนอัปเดตล่าสุด หน้านี้สรุปว่าในเว็บไซต์มีหมวดเกมสล็อต บาคาร่า บอล หวย โปรโมชั่น ขั้นตอนสมัครบนมือถือ และช่องทางติดต่อแอดมินอะไรให้ใช้งาน`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} คาสิโนอัปเดตล่าสุด รวมสล็อต บาคาร่า บอล หวย ไว้ในบัญชีเดียว`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed">
        <strong class="text-[#fce675]">{BRAND_NAME} คือเว็บคาสิโนที่ปรับปรุงทางเข้าเล่นเกมใหม่ให้รองรับการใช้งานผ่านมือถือได้สะดวกขึ้น</strong>
        และรวมเกมหลายประเภทไว้ในบัญชีเดียว ทั้งสล็อต บาคาร่า เดิมพันฟุตบอล และหวยตามรายการที่ระบบเปิดให้บริการ จุดตั้งต้นของการอัปเกรดคือการจัดหมวดหมู่เกมและเมนูสำคัญให้ค้นหาเกมที่ต้องการได้เร็วขึ้น
      </p>

      <p class="text-left text-base leading-relaxed">
        หน้านี้สรุปไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่หมวดเกมที่ระบบรองรับ
        <strong class="text-[#fce675]">ไปจนถึงโปรโมชั่นที่เปิดให้รับตามแคมเปญของแต่ละช่วง ขั้นตอนสมัครบนมือถือแบบ 3 ขั้นตอน และช่องทางติดต่อแอดมินที่ดูแลตลอด 24 ชั่วโมง</strong>
        หลัง Login สมาชิกจะเลือกหมวดเกม ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการได้ผ่านระบบเดียว โดยไม่ต้องสมัครใหม่หลายครั้งเมื่อสลับประเภทเกม
      </p>

      <p class="text-left text-base leading-relaxed">
        สิ่งที่ควรอ่านไปพร้อมกันคือข้อจำกัดของการเดิมพันเอง
        <strong class="text-[#fce675]">ผลการเดิมพันมีความไม่แน่นอน จึงไม่สามารถรับประกันผลกำไรหรือเงินรางวัลจากการเล่นได้</strong>
        ข้อมูลในหน้านี้จึงเขียนไว้เพื่อบอกว่าระบบมีอะไรให้ใช้และควรตรวจอะไรก่อนใช้งาน ไม่ได้ใช้แทนการอ่านเงื่อนไขของเกมและโปรโมชั่นที่แสดงอยู่ในบัญชีของตนเอง
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`หมวดเกมที่ ${BRAND_NAME} รวมไว้ให้เลือกจากบัญชีเดียว`} as="h2">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed">
        หลัง Login สมาชิกเลือกประเภทการเดิมพันได้จากบัญชีเดียว
        <strong class="text-[#fce675]">สลับประเภทเกมได้โดยไม่ต้องสมัครใหม่หลายครั้ง</strong>
        หมวดที่บรีฟของเว็บไซต์ระบุไว้แบ่งออกได้ประมาณนี้
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#d6a53a]">🎰</span>
          <span>
            <strong class="text-[#fce675]">สล็อต</strong> เป็นหมวดที่มีธีมและฟีเจอร์แตกต่างกันในแต่ละเกม จึงเหมาะกับการเริ่มทำความคุ้นเคยกับการค้นหาเกมและตำแหน่งของข้อมูลเกม ก่อนย้ายไปหมวดที่มีเงื่อนไขมากกว่า
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#d6a53a]">🃏</span>
          <span>
            <strong class="text-[#fce675]">บาคาร่าออนไลน์</strong> เป็นหมวดที่เงื่อนไขของแต่ละโต๊ะระบุไว้ในหน้าของโต๊ะนั้นเอง จึงควรเปิดอ่านรายละเอียดก่อนเข้าร่วมทุกครั้ง ไม่ใช่เทียบเอาจากโต๊ะอื่นที่เคยเล่น
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#d6a53a]">⚽</span>
          <span>
            <strong class="text-[#fce675]">บอล หรือตลาดเดิมพันฟุตบอล</strong> เปิดตามรายการที่ระบบมีให้ในช่วงเวลานั้น ควรดูรายการล่าสุดจากหน้าเกมแทนการอ้างจากรายการที่จำไว้จากครั้งก่อน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#d6a53a]">🎫</span>
          <span>
            <strong class="text-[#fce675]">หวยตามรายการที่ระบบเปิดให้บริการ</strong> เป็นหนึ่งในหมวดเกมของบัญชีเดียวกัน ไม่ใช่ระบบแยก จึงตรวจสอบเครดิตและประวัติรายการได้จากที่เดิมเหมือนหมวดอื่น
          </span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed">
        <strong class="text-[#fce675]">รายการเกมและผู้ให้บริการอาจมีการอัปเดตหรือเปลี่ยนแปลงตามช่วงเวลา</strong>
        สมาชิกจึงควรดูรายการล่าสุดจากหน้าเกมก่อนเลือก และด้านความปลอดภัยควรพิจารณาจากมาตรการที่ตรวจสอบได้ เช่น การรักษาความปลอดภัยของบัญชี ระบบยืนยันตัวตน และข้อมูลผู้ดำเนินงาน จึงไม่ควรใช้คำว่า ปลอดภัยแน่นอน เป็นการรับประกันโดยไม่มีข้อมูลดังกล่าวรองรับ
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/ทดลองเล่น"
          aria-label={`เปิดหน้าทดลองเล่นของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#ebbb54]/60 bg-[#241705] px-8 py-3 font-bold text-[#fce675] transition-all hover:scale-105 hover:border-[#fce675] hover:bg-[#130b03] hover:text-[#f3f3f2]">
          ไปหน้าทดลองเล่น
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`โปรโมชั่นและขั้นตอนสมัครเดิมพัน ${BRAND_NAME} บนมือถือ`} as="h2">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed">
        สมาชิกสามารถ Login เพื่อตรวจสอบรายการโปรโมชั่นล่าสุดที่บัญชีมีสิทธิ์รับตามแคมเปญที่ {BRAND_NAME} เปิดในแต่ละช่วง
        <strong class="text-[#fce675]">มีทั้งโปรโมชั่นคืนยอดเสียและกิจกรรมแนะนำเพื่อน</strong>
        โดยทั้งสองรายการคำนวณจากยอดที่เข้าเกณฑ์ตามรอบที่เว็บไซต์กำหนด ไม่ได้ให้โดยอัตโนมัติกับทุกยอดการเล่น
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#d6a53a]">💸</span>
          <span>
            <strong class="text-[#fce675]">คืนยอดเสีย โบนัส 0.3%</strong> สำหรับสมาชิกที่มียอดเสียตรงตามเงื่อนไข ระบบจะนำเฉพาะยอดที่เข้าเกณฑ์มาคำนวณก่อนแสดงโบนัสที่สามารถรับได้ ควรตรวจว่าเกมสล็อต บาคาร่า บอล หรือเกมประเภทใดร่วมรายการ รวมถึงรอบตัดยอดก่อนกดรับสิทธิ์
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#d6a53a]">🤝</span>
          <span>
