---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char, so a byte count reads
// ~3x too long). One string, reused by MainLayout's meta and the WebPage node.
// This page is 157.
const pageDescription = "รู้จัก ขวัญใจ168 เว็บสล็อตที่เปิดทางเข้าสำรองให้สมาชิกเข้าเล่นต่อได้เมื่อช่องทางหลักใช้งานไม่ได้ สมัครยูสเซอร์ใหม่ ฝากถอนออโต้ พร้อมแอดมินดูแลตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ ขวัญใจ168 เว็บสล็อตที่เปิดทางเข้าสำรองไว้ให้สมาชิก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา ขวัญใจ168 เว็บสล็อตทางเข้าสำรอง สมัครยูสใหม่เข้าเล่นได้ทันที" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ ขวัญใจ168" as="h1">
    <p class="mb-6 text-left text-base leading-relaxed text-[#cfe7f2]">
      <strong class="text-[#22b8e8]">ขวัญใจ168</strong> คือ <strong class="text-[#22b8e8]">เว็บสล็อตออนไลน์ที่จัดเตรียมทางเข้าสำรองไว้ให้สมาชิก</strong>
      สำหรับกรณีที่ช่องทางหลักถูกปิดกั้นหรือเข้าใช้งานไม่ได้ สมาชิกยังเปิดหน้าเว็บสำรอง เข้าสู่ระบบ หรือสมัครยูสเซอร์ใหม่เพื่อเล่นสล็อตต่อได้ตามที่ระบบกำหนด รองรับการใช้งานผ่านเบราว์เซอร์บนมือถือ แท็บเล็ต
      และคอมพิวเตอร์ โดยไม่ต้องติดตั้งโปรแกรมเพิ่ม
    </p>

    <p class="mb-2 text-left text-base leading-relaxed text-[#cfe7f2]">
      สมาชิกจัดการทุกอย่างได้จากบัญชีเดียว ทั้งสมัครสมาชิก ฝากถอนผ่านระบบออโต้ เลือกเกมสล็อต ตรวจสอบโปรโมชั่นที่มีสิทธิ์รับ และดูประวัติรายการ พร้อม
      <strong class="text-[#22b8e8]">แอดมิน ขวัญใจ168 คอยช่วยตรวจสอบรายการและให้คำแนะนำด้านการใช้งานตลอด 24 ชั่วโมง</strong>
      ทั้งนี้ก่อนกรอกข้อมูลบัญชีหรือทำธุรกรรมทุกครั้ง ควรตรวจสอบว่าลิงก์ที่กำลังเปิดอยู่เป็นช่องทางที่ผู้ให้บริการประกาศไว้จริง
    </p>
  </ContentBox>

  <ContentBoxPlain title="ทางเข้าสำรอง ขวัญใจ168 มีไว้ทำอะไร เมื่อช่องทางหลักเข้าไม่ได้" as="h2">
    <p class="mb-2 text-left text-base leading-relaxed text-[#cfe7f2]">
      เมื่อช่องทางหลักของ ขวัญใจ168 ไม่สามารถเปิดได้ หน้าเว็บสำรองจะทำหน้าที่เป็นทางเข้าอีกช่องทางหนึ่งที่ให้บริการเกมสล็อตชุดเดิม สมาชิกสามารถ
      <strong class="text-[#22b8e8]">ตรวจสอบทางเข้าสำรองจากช่องทางติดต่ออย่างเป็นทางการของผู้ให้บริการ</strong> แล้วเปิดผ่านเบราว์เซอร์ได้ทั้งบนมือถือและคอมพิวเตอร์ ไม่ว่าจะเข้าจากอุปกรณ์ใด หน้าจอเกม ระบบฝากถอน
      และหน้าโปรโมชั่นก็ทำงานในรูปแบบเดียวกัน
    </p>

    <p class="mt-3 mb-2 text-left text-base leading-relaxed text-[#cfe7f2]">
      ก่อน Login หรือสมัครบัญชีใหม่ ควรตรวจสอบชื่อเว็บไซต์และช่องทางที่ใช้ให้ถูกต้องทุกครั้ง เพื่อ
      <strong class="text-[#22b8e8]">หลีกเลี่ยงเว็บไซต์เลียนแบบหรือการส่งข้อมูลให้บุคคลอื่นโดยไม่ตั้งใจ</strong>
      ส่วนรายละเอียดของเกม ผู้ให้บริการเกม และเงื่อนไขการใช้งาน แนะนำให้อ่านจากที่ระบบแสดงไว้โดยตรง เพราะข้อมูลเหล่านี้อาจปรับเปลี่ยนตามรอบที่ผู้ให้บริการกำหนด
    </p>
  </ContentBoxPlain>

  <ContentBoxPlain title="โปรโมชั่นและเงื่อนไขที่ ขวัญใจ168 แจ้งไว้ให้ตรวจสอบ" as="h2">
    <p class="mb-2 text-left text-base leading-relaxed text-[#cfe7f2]">
      สมาชิกตรวจสอบโปรโมชั่น ขวัญใจ168 ที่กำลังเปิดให้รับได้จากบัญชีผู้ใช้งานและหน้าโปรโมชั่น รายการหลักคือ
      <strong class="text-[#22b8e8]">โปรโมชั่นแนะนำเพื่อน รับคอมมิชชั่น <span class="text-[#ffd76a]">0.8%</span></strong> สำหรับยอดที่เข้าเงื่อนไข และ
      <strong class="text-[#22b8e8]">โปรโมชั่นคืนยอดเสีย รับโบนัส <span class="text-[#ffd76a]">0.3%</span></strong> ตามรอบประจำวันที่กำหนด สมาชิกที่ใช้เงินเดิมพันไม่สูงก็ตรวจสอบสิทธิ์ในบัญชีของตนเองก่อนกดรับได้เช่นกัน
    </p>

    <p class="mt-3 mb-2 text-left text-base leading-relaxed text-[#cfe7f2]">
      โบนัสแต่ละรายการอาจกำหนดยอดที่นำมาคำนวณ เกมที่เข้าร่วม รอบรับสิทธิ์ และเงื่อนไขการถอนแตกต่างกัน ระบบจะแสดงยอดการแนะนำและโบนัสที่กดรับได้ผ่านบัญชีสมาชิก
      แนะนำให้อ่านรายละเอียดล่าสุดให้ครบก่อนกดรับทุกครั้ง เพื่อเลือกโปรโมชั่นให้ตรงกับรูปแบบการใช้งานของตนเอง
    </p>
  </ContentBoxPlain>

  <ContentBoxPlain title="การสมัครยูสเซอร์ใหม่และการดูแลสมาชิกของทีมงาน ขวัญใจ168" as="h2">
    <p class="mb-4 text-left text-base leading-relaxed text-[#cfe7f2]">
      กรณีระบบกำหนดให้เปิดบัญชีใหม่ ผู้ใช้งานสมัคร ขวัญใจ168 ผ่านหน้าสมัครได้ด้วยขั้นตอนที่ไม่ซับซ้อน เริ่มจากกรอกข้อมูลตามที่ระบบร้องขอ จากนั้น Login แล้วตรวจสอบช่องทางฝากเครดิตที่เปิดให้บริการ
      โดยควรใช้ข้อมูลที่ถูกต้องในการสมัคร และ
      <strong class="text-[#22b8e8]">ไม่เปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น</strong>
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#cfe7f2]">
      ก่อนกดสมัคร แนะนำให้สอบถามเจ้าหน้าที่ก่อนว่าบัญชีเดิมยังใช้งานต่อได้หรือจำเป็นต้องสร้างยูสเซอร์ใหม่ เพื่อ
      <strong class="text-[#22b8e8]">ป้องกันการสมัครบัญชีซ้ำโดยไม่จำเป็น</strong> หลังเปิดบัญชีเรียบร้อย สมาชิกตรวจสอบเครดิต ประวัติรายการ โปรโมชั่น และช่องทางฝากถอนได้จากระบบสมาชิกทั้งบนมือถือ แท็บเล็ต
      และคอมพิวเตอร์
    </p>

    <p class="mb-6 text-left text-base leading-relaxed text-[#cfe7f2]">
      หากเข้าหน้าเว็บสำรองไม่ได้ Login ไม่ผ่าน สมัครยูสใหม่ไม่สำเร็จ เครดิตไม่เข้า หรือพบปัญหาเกี่ยวกับการฝากถอนและโปรโมชั่น สามารถแจ้ง
      <strong class="text-[#22b8e8]">แอดมิน ขวัญใจ168</strong> ผ่านช่องทางที่ผู้ให้บริการประกาศไว้ พร้อมรายละเอียดของปัญหาและเวลาที่ทำรายการ เพื่อให้ทีมงานตรวจสอบได้ตรงจุด ทั้งนี้ <strong
        class="text-[#22b8e8]">
        การเดิมพันมีความเสี่ยงและไม่มีเกมใดรับประกันผลรางวัลได้
      </strong>
      ผู้เล่นจึงควรกำหนดงบประมาณของตัวเองก่อนเล่นทุกครั้ง และเล่นเท่าที่รับความเสี่ยงไหว
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก ขวัญใจ168"
        class="flex items-center justify-center rounded-lg bg-gradient-to-r from-[#22b8e8] via-[#1687c9] to-[#0e4f7a] px-8 py-3 font-black text-[#eafcff] shadow-[0_0_15px_rgba(22,135,201,0.32)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ ขวัญใจ168"
        class="flex items-center justify-center rounded-lg border border-[#1687c9]/70 bg-transparent px-8 py-3 font-bold text-[#cfe7f2] transition-all hover:scale-105 hover:border-[#22b8e8] hover:bg-[#02142b]/70">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
