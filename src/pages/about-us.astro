---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login,
// /register) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx
// ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึง
// เขียนขึ้นใหม่บนข้อเท็จจริงของ หวยคิง เท่านั้น (src/assets/content.txt)
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
//
// ดรอปนี้ (2026-10-04) คือ หวยคิง **เว็บรับแทงหวยออนไลน์** ไม่ใช่คาสิโน แง่มุมที่
// บรีฟระบุไว้มีเท่านี้: รับแทงหวยโดยเลือกเลขและส่งโพยผ่านระบบบนมือถือ · มีทั้งเลข
// 2 ตัว เลข 3 ตัว และรายการหวยตามรอบที่เว็บไซต์เปิดให้บริการ · อัตราจ่ายสำหรับ
// รายการที่เข้าเงื่อนไข 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท (เลข 3 ตัว
// กำหนดไว้สูงสุดตามโปรโมชันที่บาทละ 1,000) · ตรวจสอบเลข ยอดแทง อัตราจ่าย และสถานะ
// โพยได้ก่อนยืนยัน · จัดการเครดิตผ่านวอลเลทและธนาคารที่ระบบกำหนด · สมัคร 3 ขั้นตอน ·
// แอดมิน 24 ชั่วโมง · ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP
//
// ⚠️ แบรนด์ก่อน (UP555) เป็นคาสิโน คำชุดนั้นห้ามหลงเหลือเด็ดขาด: สล็อต บาคาร่า
// บอล/เดิมพันฟุตบอล ค่ายเกม คาสิโนสด หมวดเกม RTP ความผันผวน ทางเข้าเล่นใหม่
// ระบบอัปเกรด คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% เว็บตรงต่างประเทศ บัญชีบริษัทแท้ 100%
// หน้านี้เขียนขึ้นใหม่จากบรีฟ ไม่ใช่ find-and-replace ทับประโยคเดิม
//
// ตัวเลขที่อ้างได้มีแค่ 100 / 1,000 / 2 ตัว / 3 ตัว / 3 ขั้นตอน / 24 ชั่วโมง
// ห้ามแต่งชื่อตลาดหวย (ฮานอย ลาวพัฒนา หวยหุ้น ยี่กี) เวลาเปิด-ปิดรับ ชื่อธนาคาร
// เลขใบอนุญาต ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีที่ก่อตั้ง เพราะบรีฟไม่ได้เอ่ยไว้สักอย่าง
//
// ประโยคกำกับที่บรีฟเขียนไว้เองและห้ามตัดทิ้งเพราะฟังดูไม่ขายของ: ข้อความ
// "สูงที่สุดในวงการ" ควรมีข้อมูลเปรียบเทียบที่ตรวจสอบได้รองรับ หากไม่มีควรใช้คำว่า
// "อัตราจ่ายสูง" · คำว่า "จ่ายไม่อั้น" ควรยึดวงเงินจริงที่เว็บไซต์แสดง ·
// กรณีระบุว่ายอดฝากเข้าบริษัทโดยตรง ควรแสดงชื่อนิติบุคคลและรายละเอียดบัญชีที่
// ตรวจสอบได้ · อัตราจ่ายอาจแตกต่างตามประเภทหวย รูปแบบการแทง หรือเงื่อนไขของแต่ละรอบ
// จึงให้ยึดอัตราล่าสุดที่ระบบแสดงบนหน้าส่งโพยก่อนยืนยัน
//
// พาเลตต์ หวยคิง (brand-spec §2) **ทองโลหะบนดำอมน้ำตาล คู่สีรองเป็นครีมอมพีช** —
// โลโก้คือมงกุฎทองบนลูกบอลหวยเลข 9 กับตัวอักษรไทยสามมิติสีทอง และครีมอมพีชมาจาก
// ชุดขาวของนางแบบใน slide1/slide2 (ไม่ใช่เงินโครเมียมแบบ UP555):
// ทองแบรนด์ #cd9a2c (ขอบ ไอคอน bullet marker ปุ่มรอง) · ทองสว่าง #fdeb7c (หมึก
// strong ทั้งหน้า + ต้นไล่เฉดปุ่มหลัก) · ทองลึก #ab7314 (ปลายไล่เฉดปุ่มหลัก, ขอบ) ·
// ครีมอมพีช #fcd4c3 / ครีมอ่อน #fce2d4 (สีรอง, hover ของปุ่มรอง) · ผิวการ์ดยก
// #1c140b · พื้นลึกสุด #0c0b0a (ปุ่มรอง) · ขอบจาง #5c3f12 · หมึกบนปุ่มทอง #120a02 ·
// เนื้อความ #f5e7c8 (BRAND_TEXT) · glow เป็น rgba(205,154,44,α)
// ชุดทอง + เงินโครเมียมของ UP555 (#ebbb54 #fce675 #ab6d24 #d6a53a #d5d4d3 #f3f3f2
// #130b03 #241705 #0c0502 #160d02 #f8eed9 rgba(235,187,84,*) rgba(12,5,2,*))
// ออกครบทุกจุดแล้ว
// #00B900/#009900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้
// กฎคอนทราสต์: พื้นทองสว่าง → หมึก #120a02 เสมอ และปุ่มรองเป็น "ขอบทอง/ครีมบนพื้นดำ
// อมน้ำตาล" ไม่ใช่ถมทองอีกใบ
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// — การ์ดตั้งสีเนื้อความ #f5e7c8 ไว้ที่ตัวการ์ดแล้ว ย่อหน้าจึงไม่ใส่คลาสสีซ้ำ
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจาก
// หน้า และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น AnnouncementHuay ทั้งเว็บ (รอบก่อน UP555 ใช้ Announcement5)
// — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ หวยคิง แล้ว จึงเรียก
// แบบ bare ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 154
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} เว็บรับแทงหวยออนไลน์ หน้านี้สรุปรายการหวยและรอบที่เปิดรับ อัตราจ่ายเลข 2 ตัวและ 3 ตัว การสมัคร 3 ขั้นตอน เครดิต และช่องทางติดต่อแอดมิน`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} เว็บรับแทงหวยออนไลน์ ส่งโพยผ่านมือถือ อัตราจ่ายบาทละ 1,000`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed">
        <strong class="text-[#fdeb7c]">{BRAND_NAME} คือเว็บรับแทงหวยออนไลน์ที่เปิดให้สมาชิกเลือกเลขและส่งโพยผ่านระบบบนมือถือ</strong>
        มีทั้งเลข 2 ตัว เลข 3 ตัว รวมถึงรายการหวยตามรอบที่เว็บไซต์เปิดให้บริการ จุดเด่นที่เว็บไซต์ระบุไว้คืออัตราจ่ายสำหรับรายการที่เข้าเงื่อนไข โดยเลข 3 ตัวกำหนดไว้สูงสุดตามโปรโมชันที่บาทละ 1,000
      </p>

      <p class="text-left text-base leading-relaxed">
        หน้านี้สรุปไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่รายการหวยและรอบที่ระบบเปิดรับ
        <strong class="text-[#fdeb7c]">ไปจนถึงอัตราจ่ายของเลข 2 ตัวและเลข 3 ตัว ขั้นตอนสมัครบนมือถือแบบ 3 ขั้นตอน และช่องทางติดต่อแอดมินที่ดูแลตลอด 24 ชั่วโมง</strong>
        หลัง Login สมาชิกจะตรวจสอบเลข ยอดแทง อัตราจ่าย และสถานะโพยได้ก่อนยืนยันรายการ พร้อมดูเครดิตและประวัติโพยจากบัญชีของตนเอง
      </p>

      <p class="text-left text-base leading-relaxed">
        สิ่งที่ควรอ่านไปพร้อมกันคือข้อความประชาสัมพันธ์ของเว็บหวยทุกแห่ง
        <strong class="text-[#fdeb7c]">คำว่าอัตราจ่ายสูงที่สุดในวงการควรมีข้อมูลเปรียบเทียบที่ตรวจสอบได้รองรับ หากไม่มีหลักฐานดังกล่าวก็ควรอ่านเป็นเพียงคำว่าอัตราจ่ายสูง</strong>
        ข้อมูลในหน้านี้จึงเขียนไว้เพื่อบอกว่าระบบมีอะไรให้ใช้และควรตรวจอะไรก่อนส่งโพย ไม่ได้ใช้แทนการอ่านอัตราจ่ายและวงเงินรับแทงที่ระบบแสดงอยู่ในบัญชีของตนเอง
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`รายการหวยและอัตราจ่ายที่ ${BRAND_NAME} เปิดให้ส่งโพย`} as="h2">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed">
        เว็บ {BRAND_NAME} เปิดรับตัวเลขตามรายการและรอบหวยที่ระบบกำหนด ไม่ว่าจะเป็นเลขที่เลือกเอง เลขเด็ด หรือเลขดังที่กำลังได้รับความสนใจ
        <strong class="text-[#fdeb7c]">สมาชิกกรอกเลขและยอดที่ต้องการก่อนตรวจสอบสถานะการรับแทงจากระบบ</strong>
        จึงทราบวงเงินและรายละเอียดของโพยก่อนกดยืนยันรายการทุกครั้ง อัตราจ่ายสำหรับรายการที่เข้าเงื่อนไขแบ่งออกได้ประมาณนี้
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#cd9a2c]">🔢</span>
          <span>
            <strong class="text-[#fdeb7c]">เลข 2 ตัว จ่าย 100 บาท</strong> สำหรับรายการที่เข้าเงื่อนไข เลือกเลขและกำหนดยอดแทงได้ตามวงเงินที่ระบบเปิดรับ ก่อนส่งโพยควรตรวจสอบเลขให้ครบทั้งสองหลัก รวมถึงดูประเภทการเดิมพัน อัตราจ่าย และยอดรวมให้เรียบร้อย
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#cd9a2c]">🎯</span>
          <span>
            <strong class="text-[#fdeb7c]">เลข 3 ตัว จ่าย 1,000 บาท</strong> ควรตรวจสอบว่าอัตราดังกล่าวใช้กับรูปแบบเลข 3 ตัวประเภทใดก่อนส่งโพย เนื่องจากเลข 3 ตัวสามารถมีการเดิมพันหลายรูปแบบ หากเลือกเลขดังหรือเลขที่มียอดสูง ควรดูวงเงินรับแทงที่ระบบแสดงเพิ่มเติม
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#cd9a2c]">🧾</span>
          <span>
            <strong class="text-[#fdeb7c]">รายการหวยตามรอบที่เว็บไซต์เปิดให้บริการ</strong> แต่ละรายการอาจมีรายละเอียดในการคำนวณแตกต่างกัน จึงควรเปิดราคาของรายการที่ต้องการอ่านก่อนส่งโพย เพื่อให้ทราบว่าเลขและประเภทหวยที่เลือกใช้อัตราใด
          </span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed">
        <strong class="text-[#fdeb7c]">อัตราจ่ายอาจแตกต่างตามประเภทหวย รูปแบบการแทง หรือเงื่อนไขของแต่ละรอบ</strong>
        หากข้อมูลบนหน้าส่งโพยแตกต่างจากข้อความประชาสัมพันธ์ ควรยึดอัตราล่าสุดที่ระบบแสดงก่อนยืนยันรายการ และสำหรับเลขที่มีผู้เลือกจำนวนมาก ระบบอาจกำหนดวงเงินรับแทงตามแต่ละรอบ ดังนั้นคำว่าจ่ายไม่อั้นควรยึดวงเงินจริงที่เว็บไซต์แสดง
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/promotion"
          aria-label={`ดูภาพอัตราการจ่ายของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#cd9a2c]/60 bg-[#0c0b0a] px-8 py-3 font-bold text-[#fdeb7c] transition-all hover:scale-105 hover:border-[#fdeb7c] hover:bg-[#1c140b] hover:text-[#fce2d4]">
          ดูภาพอัตราการจ่าย
        </a>

        <a
          href="/ทดลองเล่น"
          aria-label={`เปิดหน้าทดลองเล่นของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#cd9a2c]/60 bg-[#0c0b0a] px-8 py-3 font-bold text-[#fdeb7c] transition-all hover:scale-105 hover:border-[#fdeb7c] hover:bg-[#1c140b] hover:text-[#fce2d4]">
          ไปหน้าทดลองเล่น
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`สมัคร ${BRAND_NAME} 3 ขั้นตอน และการจัดการเครดิตผ่านวอลเลทและธนาคาร`} as="h2">
    <div class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed">
        <strong class="text-[#fdeb7c]">การสมัคร {BRAND_NAME} สามารถทำผ่านมือถือได้ใน 3 ขั้นตอน</strong>
        และเมื่อเปิดบัญชีเรียบร้อยก็ใช้บัญชีเดียวตรวจสอบรายการหวย อัตราจ่าย เครดิต และประวัติโพยได้จากที่เดิม โดยลำดับที่เว็บไซต์กำหนดไว้เป็นดังนี้
      </p>

      <ol class="ml-6 list-decimal space-y-2 text-left text-base leading-relaxed marker:font-black marker:text-[#cd9a2c]">
        <li>เปิดหน้าสมัครและกรอกข้อมูลตามที่ระบบกำหนด</li>
        <li>ยืนยันข้อมูลเพื่อสร้างบัญชีและ Login เข้าสู่ระบบ</li>
        <li>เลือกรายการหวย กรอกตัวเลขและยอดที่ต้องการ พร้อมตรวจสอบอัตราจ่ายก่อนส่งโพย</li>
      </ol>

      <p class="text-left text-base leading-relaxed">
        ด้านการจัดการยอดเงิน เว็บไซต์
