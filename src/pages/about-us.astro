---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login, /register)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึงเขียนขึ้นใหม่
// บนข้อเท็จจริงของ LOTTOPLUS เท่านั้น
//
// รอบนี้ (ดรอป 2026-09-29) คือ LOTTOPLUS **เว็บหวยออนไลน์** — รัฐบาลไทย ลาวพัฒนา
// ฮานอย หวยหุ้น ส่วนแบรนด์ก่อนหน้าเป็นเว็บคาสิโนที่ขายบาคาร่า สล็อต เกมไพ่
// และค่ายเกม — คำชุดนั้นถูกถอดออกทั้งหมด ห้าม find-and-replace ชื่อแบรนด์ทับประโยค
// เดิม มิฉะนั้นเว็บหวยจะไปอ้างสินค้าคนละตัวซึ่งไม่มีอยู่ในบรีฟรอบนี้เลยสักคำ
// (คำห้าม: คาสิโน บาคาร่า สล็อต เกมไพ่ ค่ายเกม RTP ผู้ให้บริการเกม กีฬา/บอล
// เว็บตรง ใบอนุญาต)
//
// ข้อเท็จจริงทุกบรรทัดมาจาก src/assets/content.txt เท่านั้น: ให้บริการหวยออนไลน์
// ผ่านหน้าเว็บไซต์ สมัคร/เข้าใช้งานผ่านเบราว์เซอร์บนมือถือได้โดยไม่ต้องติดตั้งแอป ·
// รวมหวยรัฐบาลไทย ลาวพัฒนา ฮานอย หวยหุ้นไว้ในบัญชีเดียว · เลือกเลข ส่งโพย
// ตรวจสอบรายการ ตรวจผลหวย ฝากถอน · หวยรัฐบาลไทยตามรอบออกรางวัล ลาวพัฒนา/ฮานอย
// ตามรายการที่เปิดรับ หวยหุ้นมีรอบเดิมพันต่างกันแต่ละวัน · อัตราจ่าย 2 ตัว 100 และ
// 3 ตัว 1,000 ขึ้นกับประเภทหวย รูปแบบการแทง และรอบ · คืนยอดเสีย 0.3% ·
// แนะนำเพื่อน 0.8% · ฝากเข้าบัญชีบริษัทตรง ไม่ผ่านตัวแทน · แอดมิน 24 ชั่วโมง ·
// ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP
// — ตัวเลขที่อ้างได้มีเท่านี้ ห้ามเพิ่มชื่อธนาคาร ขั้นต่ำฝาก เลขใบอนุญาต ปีที่ก่อตั้ง
// เลขทะเบียนบริษัท จำนวนสมาชิก หรือจำนวนขั้นตอนที่บรีฟไม่ได้นับไว้
//
// บรีฟมีข้อสงวนไว้ตรง ๆ สองข้อและต้องคงไว้ในคอปปี้: คำว่า "ปลอดภัย 100%" ควรมี
// มาตรการและข้อมูลที่ตรวจสอบได้รองรับ (ห้ามรับประกันจากข้อความโฆษณาเพียงอย่างเดียว)
// และอัตราจ่ายจริงขึ้นกับประเภทหวย รูปแบบการแทง และรอบที่เปิดรับ จึงให้ยึดตัวเลขที่
// ระบบแสดงก่อนยืนยันโพยเป็นหลัก — หน้านี้จึงเขียนเป็นสิ่งที่ควรตรวจสอบ ไม่ใช่คำรับประกัน
//
// พาเลตต์ LOTTOPLUS เป็น **แดงนำ ทองรอง บนดำ** ตามโลโก้ (ตัวอักษรขาวบนบล็อกแดง
// #dc020e) กับแบนเนอร์พื้นดำที่มีลูกหวยแดง-ขาวและเหรียญทอง ตารางแมปอยู่ที่
// brand-spec §2: แดงสว่าง #ff2d38 · แดงแบรนด์ #dc020e · แดงลึก #6b0207 ·
// ทองอ่อน #fde79a · ทองรอง #f3c623 · ทองลึก #8a6a0a · ผิวการ์ด #120b0c ·
// ผิวการ์ดอุ่น #1f0a0c · แผง #2a0d0f · เนื้อความ #f0e2e2 (BRAND_TEXT) ·
// เน้นใน strong #fff4f4 · หมึกบนพื้นทอง #1a0203
// ชุดทอง-ดำของแบรนด์ก่อน (#fcc403 #fdda04 #e0a800 #8a6502 #e9e4d6 #fffbea #120d02
// #101010 #191712 rgba(252,196,3,*)) ออกครบทุกจุดแล้ว ทั้งคลาส Tailwind raw hex
// และ rgba() ที่ใช้ทำแสงเรือง ส่วน #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE
// ไม่ใช่สีของเว็บ จึงคงไว้ตามเดิม
// กฎคอนทราสต์: พื้นทอง → หมึกเข้ม #1a0203 · พื้นแดง → ตัวอักษรขาว · เลขลำดับและ
// ไอคอนในลิสต์ใช้ #ff2d38 สลับ #f3c623 (แดงแบรนด์ #dc020e บนการ์ดดำได้แค่ 3.8:1)
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลางที่ไม่หมุนตามรอบรีแบรนด์ และรอบนี้
// orchestrator เป็นคนรีธีม) — สีเนื้อความจึงตรงกับที่การ์ดกำหนดไว้อยู่แล้ว
//
// รอบนี้ /ตรวจหวย และ /แนวทาง ถูกย้ายกลับเข้า src/pages/ แล้ว (LOTTOPLUS เป็น
// เว็บหวย) ทั้งสอง route มีจริงใน dist/ จึงลิงก์ถึงได้
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide4 ของดรอปนี้เป็นของ index และ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า
// และ slide2/slide3/banner2/banner3 ห้าม import (ลำพังการ import ก็ทำให้ไฟล์ถูก emit
// ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น AnnouncementHuay ทั้งเว็บ — orchestrator ตั้ง default
// message ของไฟล์นั้นเป็นคอปปี้ของ LOTTOPLUS แล้ว จึงเรียกแบบ bare เหมือน
// index.astro ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 156
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription =
  "เกี่ยวกับ LOTTOPLUS เว็บหวยออนไลน์ที่รวมหวยรัฐบาลไทย ลาวพัฒนา ฮานอย และหวยหุ้นไว้ในบัญชีเดียว ส่งโพยและตรวจผลผ่านหน้าเว็บ ฝากถอนเข้าบัญชีบริษัทไม่ผ่านตัวแทน";

const pageTitle = "เกี่ยวกับเรา LOTTOPLUS เว็บหวยออนไลน์ ครบทุกแนวในบัญชีเดียว";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        <strong class="text-[#fff4f4]">LOTTOPLUS</strong> คือเว็บ<strong class="text-[#fff4f4]">หวยออนไลน์ที่ให้บริการผ่านหน้าเว็บไซต์</strong>
        สมัครและเข้าใช้งานผ่านเบราว์เซอร์บนมือถือได้โดยไม่จำเป็นต้องติดตั้งแอป สมาชิกเลือกเลข ส่งโพย ตรวจสอบรายการ ตรวจผลหวย และจัดการฝากถอนได้จากบัญชีเดียว
      </p>

      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        หน้านี้รวบรวมไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่ประเภทหวยที่เปิดรับ อัตราจ่ายและโปรโมชั่นของสมาชิก ช่องทางฝากถอนเข้าบัญชีบริษัท
        ขั้นตอนการสมัคร ไปจนถึงช่องทางสอบถามแอดมินเมื่อไม่แน่ใจในขั้นตอนใด
      </p>

      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        <strong class="text-[#fff4f4]">รายการหวยที่เปิดรับ เวลาปิดรับ อัตราจ่าย และเงื่อนไขของโปรโมชั่นเปลี่ยนแปลงได้ตามช่วงเวลา</strong>
        รายละเอียดทั้งหมดจึงยึดตามข้อมูลที่เว็บไซต์แสดงไว้จริงในขณะนั้นเป็นหลัก และก่อนทำรายการควรตรวจสอบรอบหวย อัตราจ่าย และข้อมูลบัญชีปลายทางทุกครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="LOTTOPLUS รวมหวยรัฐบาลไทย ลาวพัฒนา ฮานอย และหวยหุ้นไว้ในบัญชีเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        สิ่งที่เว็บไซต์ระบุไว้เป็นตัวตนของ LOTTOPLUS คือ <strong class="text-[#fff4f4]">การรวมหวยหลายประเภทไว้ในบัญชีเดียว</strong>
        เริ่มจากหวยรัฐบาลไทยตามรอบออกรางวัล หวยลาวพัฒนาและหวยฮานอยตามรายการที่เปิดรับ และหวยหุ้นที่มีรอบเดิมพันแตกต่างกันในแต่ละวัน สมาชิกเลือกประเภทเลขและตรวจสอบเวลาปิดรับก่อนส่งโพยได้จากหน้าเว็บไซต์
      </p>

      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        ถัดจากการส่งโพยคือ<strong class="text-[#fff4f4]">หน้าบัญชีสมาชิกที่รวมเครดิต ประวัติโพย และสถานะรายการไว้ให้ตรวจสอบได้ด้วยตัวเอง</strong>
        หลังส่งรายการแล้วจึงกลับมาตรวจโพย เลขที่เลือก ยอดเดิมพัน และสถานะรายการให้เรียบร้อยได้ ไม่ต้องจดแยกไว้เองหรือย้อนถามทีละรายการ
      </p>

      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        ส่วนการตรวจผลควร<strong class="text-[#fff4f4]">อ้างอิงผลอย่างเป็นทางการของหวยแต่ละประเภท</strong>
        หากรายการไหนมีหลายรอบต่อวัน ควรตรวจสอบชื่อรายการและเวลาของรอบให้ตรงกันก่อนคำนวณผลรางวัล เพราะเลขชุดเดียวกันคนละรอบคือคนละรายการ
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/ตรวจหวย"
          aria-label="เปิดหน้าตรวจผลหวยของ LOTTOPLUS"
          class="flex items-center justify-center rounded-lg border border-[#dc020e]/80 bg-[#2a0d0f] px-8 py-3 font-bold text-[#f0e2e2] transition-all hover:scale-105 hover:border-[#ff2d38] hover:bg-[#1f0a0c] hover:text-[#ff2d38]">
          ตรวจผลหวย
        </a>

        <a
          href="/แนวทาง"
          aria-label="ดูหน้าแนวทางหวยของ LOTTOPLUS"
          class="flex items-center justify-center rounded-lg border border-[#f3c623]/70 bg-[#2a0d0f] px-8 py-3 font-bold text-[#f0e2e2] transition-all hover:scale-105 hover:border-[#f3c623] hover:bg-[#1f0a0c] hover:text-[#f3c623]">
          ดูแนวทางหวย
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="อัตราจ่ายและโปรโมชั่น LOTTOPLUS คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8%" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        LOTTOPLUS มีทั้งอัตราจ่ายหวยและโปรโมชั่นสำหรับสมาชิก โดยตรวจสอบรายละเอียดของ
        <strong class="text-[#fff4f4]">อัตราจ่ายหวย 2 ตัว 100 และ 3 ตัว 1,000</strong> ได้จากหน้าส่งโพยของรอบนั้น
        และดูรายละเอียดของเลข 2 ตัว เลข 3 ตัว โบนัสคืนยอดเสีย กับกิจกรรมแนะนำเพื่อนได้จากหน้าโปรโมชั่น
      </p>

      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        <strong class="text-[#fff4f4]">อัตราจ่ายจริงอาจขึ้นอยู่กับประเภทหวย รูปแบบการแทง และรอบที่เปิดรับ จึงควรยึดตัวเลขที่ระบบแสดงก่อนยืนยันโพยเป็นหลัก</strong>
        ไม่ควรถือว่าเป็นอัตราเดียวกันทุกประเภท โดยเฉพาะเลข 3 ตัวตรงและรูปแบบการเดิมพันอื่นที่อาจมีวิธีคำนวณเงินรางวัลแตกต่างกัน
      </p>

      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        โปรโมชั่นสมาชิกมีสองรายการหลัก คือ <strong class="text-[#fff4f4]">โบนัสคืนยอดเสีย 0.3%</strong>
        สำหรับสมาชิกที่มียอดเสียตรงตามเงื่อนไขในรอบที่กำหนด และ <strong class="text-[#fff4f4]">โบนัสแนะนำเพื่อน 0.8%</strong>
        ที่คำนวณจากยอดใช้งานของเพื่อนซึ่งสมัครผ่านลิงก์แนะนำส่วนตัวและเข้าเกณฑ์ที่ระบบกำหนด ทั้งสองรายการมีรอบคำนวณและเงื่อนไขของตัวเอง สมาชิกตรวจสอบสิทธิ์และยอดคำนวณได้จากบัญชีสมาชิกก่อนกดรับทุกครั้ง
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/promotion"
          aria-label="ดูภาพโปรโมชั่นทั้งหมดของ LOTTOPLUS"
          class="flex items-center justify-center rounded-lg border border-[#dc020e]/80 bg-[#2a0d0f] px-8 py-3 font-bold text-[#f0e2e2] transition-all hover:scale-105 hover:border-[#ff2d38] hover:bg-[#1f0a0c] hover:text-[#ff2d38]">
          ดูโปรโมชั่นทั้งหมด
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="ฝากถอน LOTTOPLUS เข้าบัญชีบริษัทตรง ไม่ผ่านตัวแทน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        ระบบฝากถอนของ LOTTOPLUS ให้สมาชิก<strong class="text-[#fff4f4]">ทำรายการและติดตามสถานะเครดิตผ่านบัญชีของตนเอง</strong>
        ก่อนโอนเงินควรเปรียบเทียบชื่อบัญชีปลายทาง จำนวนเงิน และรายละเอียดที่เว็บไซต์ประกาศไว้ให้ตรงกันทุกครั้ง ส่วนรายการถอนควรตรวจสถานะผ่านระบบและเก็บหลักฐานธุรกรรมไว้จนดำเนินการเสร็จสมบูรณ์
      </p>

      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
