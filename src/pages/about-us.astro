---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login,
// /register, /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจาก
// เช็กลิสต์หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ (src/assets/content.txt)
// ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึงเขียนขึ้นใหม่จากข้อเท็จจริงและ
// คลังคำของบรีฟรอบนี้เท่านั้น (.claude/brand-spec-satu168.md §6)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x5 · h3x0
//   h1  เกี่ยวกับเรา <แบรนด์> เว็บหวยที่รวบรวมหวยหลายประเภทไว้ในเว็บไซต์เดียว
//   h2  ประเภทหวยที่ <แบรนด์> รวบรวมไว้ รัฐบาลไทย ฮานอย ลาว หุ้นต่างประเทศ
//   h2  ข้อมูลที่ <แบรนด์> ระบุไว้ให้ตรวจสอบก่อนทำรายการ
//   h2  <แบรนด์> รองรับการฝากถอนวอลเลทและธนาคารชั้นนำ
//   h2  โปรโมชั่น <แบรนด์> คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%
//   h2  ช่องทางติดต่อแอดมิน <แบรนด์> ตลอด 24ชม.
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) จึงเปิดใช้งานอยู่
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// ตัวที่ routing จริงคือไฟล์นี้ Astro ไม่อ่านโฟลเดอร์นั้นเลย ห้ามแก้และห้ามลบ
//
// 🚨 แกนของดรอปนี้ (2026-10-21) คือ **เว็บหวยล้วน** — เว็บที่รวบรวมหวยหลาย
// ประเภทไว้ที่เดียว: **หวยรัฐบาลไทย (อ้างอิงผลสลากกินแบ่งรัฐบาล) · หวยฮานอย ·
// หวยลาว · หวยหุ้นต่างประเทศ** พร้อมเมนูตรวจสอบรายการ เลือกประเภทหวย และ
// รายละเอียดการฝากถอน **ไม่ใช่เว็บเกมคาสิโนและไม่ใช่เว็บระบบการเงิน**
// ⚠️ หมวดเกมของแบรนด์ก่อนหน้า (รายการเต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง)
// **ไม่มีในบรีฟรอบนี้เลยแม้แต่คำเดียว ห้ามเติมกลับเข้ามา** ทั้งหน้าเขียนใหม่หมด
// ไม่ใช่ find-and-replace ทับประโยคเดิม
//
// route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ทดลองเล่น · /about-us · /contact-us · /ตรวจหวย · /แนวทาง · /terms ·
// /privacy · /line  (รอบนี้เป็นเว็บหวย → /ตรวจหวย กับ /แนวทาง เปิดอยู่จริง
// ตาม brand-spec §7 ลิงก์ไปได้)
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกม ชื่อธนาคาร ผู้ให้บริการ ใบอนุญาต
// นิติบุคคล ปีก่อตั้ง จำนวนสมาชิก หรือค่าอัตราคืนของเกม แม้แต่รายการเดียว** จึงห้ามเขียน
// ลงหน้าเว็บ · ตัวเลขที่ขึ้นหน้าได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 24ชม.
//
// คลังคำที่บรีฟรอบนี้ให้มาและใช้ได้เท่านี้ (brand-spec §6): หวยออนไลน์ ·
// หวยรัฐบาลไทย · สลากกินแบ่งรัฐบาล · หวยฮานอย · หวยลาว · หวยหุ้นต่างประเทศ ·
// ระบบแทงหวย · ทางเข้า · บริษัทแม่ · รอบปิดรับ · รอบประกาศผล · อัตราจ่าย ·
// แหล่งอ้างอิงผลรางวัล · ตรวจสอบรายการ · ประเภทหวย · บิลหวย · หมายเลขรายการ ·
// ฝากถอน · ธนาคาร · วอลเลท · ยอดขั้นต่ำ · ระยะเวลาดำเนินการ · ชื่อบัญชีปลายทาง ·
// บัญชีแอบอ้าง · รายการผิดปกติ · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · โบนัส ·
// เครดิต · ยอดเสีย · รอบเวลารับเครดิต · ลิงก์แนะนำ · เชื่อมโยงบัญชี ·
// ไม่จำกัดยูส · เจ้าหน้าที่ · แอดมิน · 24ชม. · เว็บไซต์ทางการ · ประกาศล่าสุด ·
// รหัสผ่าน · รหัส OTP · หลักฐานที่เชื่อถือได้
//
// ⚠️ คำโฆษณาของบรีฟ ("จ่ายจริงไม่โกง" · "ไม่มีประวัติโกง" · "รับได้ไม่จำกัดยูส")
// อยู่ได้เฉพาะในหัวข้อที่บรีฟเขียนไว้เอง (= หัวข้อของ index.astro) ห้ามขยายเป็น
// คำกล่าวอ้างใหม่ของหน้านี้ เพราะย่อหน้าของบรีฟเองตอบกลับทันทีว่าให้พิจารณา
// หลักฐานจากหลายแหล่งประกอบกัน
//
// 🚨 ประโยคกำกับความเสี่ยงของบรีฟที่ต้องขึ้นครบ (เป็นเนื้อหาของบรีฟ ไม่ใช่
// filler ให้ตัดทิ้ง):
// 1) ข้อมูลเกี่ยวกับบริษัทแม่และประวัติการจ่ายเงินควรตรวจสอบจากหลักฐานที่
//    เชื่อถือได้ก่อนตัดสินใจ (h1)
// 2) ควรตรวจสอบวันเวลาเปิดรับ อัตราจ่าย และแหล่งอ้างอิงผลรางวัลให้ชัดเจน
//    ก่อนทำรายการ (h2 #1 / h2 #2)
// 3) สำหรับคำกล่าวอ้างเรื่องการจ่ายเงินจริงหรือไม่มีประวัติร้องเรียน ควรพิจารณา
//    หลักฐานการให้บริการและความคิดเห็นจากหลายแหล่งประกอบกัน (h2 #1)
// 4) ตรวจสอบชื่อบัญชีปลายทางให้ตรงกับข้อมูลผู้ให้บริการที่ยืนยันได้ · หากพบ
//    รายการผิดปกติควรหยุดทำธุรกรรมและติดต่อธนาคารหรือผู้ให้บริการชำระเงินทันที
//    (h2 #3)
// 5) การคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกบิลหรือรับประกัน
//    ผลตอบแทนในอนาคต · แม้ระบุว่าไม่จำกัด แต่ควรยืนยันข้อกำหนดเกี่ยวกับจำนวน
//    บัญชีที่เข้าร่วม รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุด ·
//    ควรตรวจสอบว่าโปรโมชั่นใช้ร่วมกันได้หรือไม่ (h2 #4)
// 6) ตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความเพื่อหลีกเลี่ยงบัญชี
//    แอบอ้าง · เก็บหมายเลขรายการและหลักฐานที่เกี่ยวข้องไว้ · ไม่เปิดเผยรหัสผ่าน
//    หรือรหัส OTP ให้บุคคลอื่น · ควรตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุด
//    อีกครั้ง (h2 #5)
//
// 🚨 พาเลตรอบนี้ (brand-spec §2) เป็น **ธีมสว่าง** bg.json ของดรอปนี้คือ
// {"mode":"color","color":"#d8ffc7"} = เขียวมิ้นต์สว่าง ไม่ใช่ดำ
// **ห้าม "แก้" กลับไปเป็นพื้นเข้มเพราะรอบก่อนๆ เป็นแบบนั้น**
// ค่าที่ใช้ได้ในไฟล์นี้: เขียวเข้ม #0a5f1c (หัวข้อ/<strong>/marker — 7.9:1 บนผิว
// การ์ดขาว) · หมึกเขียวป่า #0c3a16 (เนื้อความ = BRAND_TEXT, 12.9:1) ·
// เขียวมรกต #0b7d28 (พื้นถม/ขอบ/ออรา — ขาวบนพื้นนี้ได้ 5.3:1) · ขาว #ffffff
// (ตัวอักษรบนพื้นถมเขียว) · อินเซ็ต #e9fbdd / พื้นเพจ #d8ffc7
// 🚨 **เขียวใบตอง 0f9b35 ห้ามถือตัวอักษรและห้ามเป็นพื้นของตัวอักษร** (3.7:1)
// เป็น stop ของไล่เฉด/ออราได้อย่างเดียว · สีไฮไลต์ <strong> ในเนื้อความมีตัวเดียว
// คือ #0a5f1c
// 🚨 **#d8ffc7 และ #e9fbdd ห้ามถือตัวอักษรบนพื้นขาว** เป็นสีพื้น/ขอบเท่านั้น
// 🚨 **ทองสัมฤทธิ์ของรอบนี้ (c9cb63 aeb04a 9ba03c) ห้ามใช้ในไฟล์นี้เลยสักจุด**
// — บนผิวการ์ดขาวได้แค่ 1.7–2.8:1 ทองเป็นสีของโครม (navbar/footer/ticker) เท่านั้น
// ออราที่อนุญาต: rgba(11,125,40,α) · rgba(10,95,28,α) · rgba(12,58,22,α)
// ⚠️ รอบนี้ไม่มีชมพู ไม่มีแดงชาด ไม่มีบรอนซ์ส้ม ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง
// ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์ · #00B900 บนปุ่ม LINE เป็นสีประจำแพลตฟอร์ม
// ไม่ใช่สีของเว็บ ห้ามเปลี่ยนเป็นเขียวของแบรนด์
//
// ลำดับปุ่มในไฟล์นี้สื่อด้วย "พื้นถมเขียวมรกต vs พื้นถมไล่เฉดเขียวเข้ม vs อินเซ็ต":
// · ปุ่มหลัก (สมัครสมาชิก) ถมเขียวมรกต #0b7d28 ตัวอักษรขาว (5.3:1) ขอบ #0a5f1c
// · ปุ่มรอง (เข้าสู่ระบบ) ถมไล่เฉด #0b7d28 → #0a5f1c ตัวอักษรขาว (5.3:1 / 7.9:1)
// · ปุ่มลิงก์ภายในเป็นอินเซ็ต #e9fbdd ขอบเขียวโปร่ง ตัวอักษรหมึกเขียวป่า (11.8:1)
//   hover ยกขอบเป็นเขียวทึบ (ตรงกับ hover ของการ์ด ContentBox)
// · ชิปไอคอนของรายการใช้เขียวมรกตเป็น **เส้นขอบ** บนอินเซ็ต #e9fbdd ไม่ถือตัวอักษร
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT
// #0c3a16, 12.9:1 บนผิวการ์ดขาว) ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่
// ประกาศสีของตัวเอง ปล่อยให้สืบทอดลงมา และไม่ใส่ mx-auto / max-w-* บน <p> เพราะ
// การ์ดคุมความกว้างเองแล้ว (เพิ่มไปจะเหมือนย่อหน้าเยื้อง) — ที่ประกาศสีได้มีแค่
// ปุ่ม (ถมพื้นของตัวเองจึงต้องกำหนดหมึกของตัวเอง) ชิปไอคอน marker ของลำดับเลข
// และ <strong> ซึ่ง brand-spec §2 สงวนเขียวเข้ม #0a5f1c ไว้เป็นสีไฮไลต์ใน
// เนื้อความเพียงสีเดียว · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง
// เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำ
// จะขาดครึ่ง (ลบแท็ก <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิม) และห้ามวาง
// <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังใน prop ที่เป็นข้อความ
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: ดรอปนี้ (brand-spec §5) ไม่มี article illustration
// เลย (banner2/banner3 เป็นอาร์ตเวิร์กของแบรนด์คนละราย เก่าทั้งคู่) ส่วน
// slide1/slide2 ถูกตรึงไว้กับ index กับ /promotion และ banner1 /
// banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// gamedemo*.webp ของแบรนด์หมวดอื่นก็ไม่ import (ลำพังการ import ก็ทำให้ไฟล์ถูก
// emit ลง dist/ และ verify-build จะแดง) — ไฟล์ยังอยู่บนดิสก์ ห้ามลบ
//
// Announcement รอบนี้หมุนมาเป็น AnnouncementHuay ทั้งเว็บ (brand-spec §3)
// orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว
// จึงเรียกแบบ bare **ห้ามส่ง prop message** มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 158 อักขระ เป็นประโยคเดียวที่บอกว่าหน้านี้มีอะไร แล้วหยุด
// (Google ตัดราว 155 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} หน้ารวมข้อมูลว่าเว็บไซต์เปิดรับหวยประเภทใดไว้บ้าง ทั้งรัฐบาลไทย ฮานอย ลาว และหุ้นต่างประเทศ พร้อมรอบปิดรับ อัตราจ่าย ฝากถอน ช่องทางติดต่อ`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} เว็บหวยที่รวบรวมหวยหลายประเภทไว้ในเว็บไซต์เดียว`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#0a5f1c]">{BRAND_NAME} นำเสนอช่องทางบริการหวยออนไลน์ที่รวบรวมข้อมูลหวยหลายประเภทไว้ในเว็บไซต์เดียว</strong>
        ทั้งหวยรัฐบาลไทย หวยฮานอย หวยลาว และหวยหุ้นต่างประเทศ พร้อมเมนูตรวจสอบรายการ เลือกประเภทหวย และศึกษารายละเอียดการฝากถอน หน้านี้รวบรวมไว้ว่าเว็บไซต์ระบุอะไรไว้บ้าง เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดอ่านอะไรตรงไหน
        แล้วจึงค่อยไล่อ่านรายละเอียดของแต่ละหัวข้อเป็นรายข้อ
      </p>

      <p>
        ผู้ใช้งานสามารถตรวจสอบอัตราจ่าย รอบปิดรับ และเงื่อนไขของแต่ละรายการได้ก่อนใช้งาน
        <strong class="text-[#0a5f1c]">โดยสิ่งที่ควรดูให้ชัดเจนทุกครั้งคือรอบปิดรับของประเภทหวยที่สนใจ และแหล่งอ้างอิงผลรางวัลที่ประเภทนั้นใช้</strong>
        เพราะหวยแต่ละประเภทมีรอบประกาศผลและเงื่อนไขของตัวเอง ไม่ได้ใช้ชุดเดียวกันทั้งหมด
      </p>

      <p>
        เนื้อหาในหน้านี้เขียนไว้ประกอบการใช้งานเท่านั้น ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะทำรายการ
        <strong class="text-[#0a5f1c]">ส่วนข้อมูลเกี่ยวกับบริษัทแม่และประวัติการจ่ายเงินควรตรวจสอบจากหลักฐานที่เชื่อถือได้ก่อนตัดสินใจ</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`ประเภทหวยที่ ${BRAND_NAME} รวบรวมไว้ รัฐบาลไทย ฮานอย ลาว หุ้นต่างประเทศ`} as="h2">
