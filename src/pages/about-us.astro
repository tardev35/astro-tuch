---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char, so a byte count reads
// ~3x too long). One string, reused by MainLayout's meta and the WebPage node.
const pageDescription =
  "รู้จัก JAIDEE928 คาสิโนใจดีเว็บแท้ รวมบาคาร่า รูเล็ต เสือมังกร แบล็กแจ็ก คาสิโนสด และสล็อตไว้ในบัญชีเดียว พร้อมโบนัสแนะนำเพื่อน 0.8% คืนยอดเสีย 0.3% ดูแล 24 ชม.";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ JAIDEE928 คาสิโนใจดีเว็บแท้ รวมเกมเดิมพันครบวงจรในบัญชีเดียว",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา JAIDEE928 คาสิโนใจดีเว็บแท้ รวมเกมเดิมพันครบวงจร" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ JAIDEE928" as="h1">
    <p class="mb-6 text-left text-base leading-relaxed text-[#dce9ff]">
      <strong class="text-[#7db4ff]">JAIDEE928</strong> คือเว็บคาสิโนออนไลน์ที่พร้อมให้บริการสมาชิกซึ่งต้องการเดิมพันผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ได้ในระบบเดียว
      ภายในบัญชีเดียวรวม <strong class="text-[#7db4ff]">บาคาร่า รูเล็ต เสือมังกร แบล็กแจ็ก คาสิโนสด และสล็อต</strong>
      พร้อมโปรโมชั่นและโบนัสแนะนำตามเงื่อนไขที่กำหนด ระบบฝากถอนอัตโนมัติไม่มีขั้นต่ำช่วยให้ตรวจสอบและทำรายการได้ด้วยตนเอง โดยมีแอดมินคอยให้คำแนะนำเกี่ยวกับการสมัคร ฝากถอน
      โปรโมชั่น และการใช้งานตลอด 24 ชั่วโมง
    </p>

    <p class="mb-2 text-left text-base leading-relaxed text-[#dce9ff]">
      สิ่งที่ JAIDEE928 ให้ความสำคัญคือความชัดเจนของข้อมูล รายละเอียดของโบนัส เปอร์เซ็นต์ วิธีคำนวณ รอบการรับ และเงื่อนไขการถอนจะแสดงอยู่ในหน้ารายละเอียดโปรโมชั่นก่อนเข้าร่วมเสมอ
      สมาชิกควรอ่านเงื่อนไขตรงจุดนั้นทุกครั้ง เพราะข้อกำหนดของแต่ละรายการไม่เท่ากัน และมีทีมงานคอยให้คำแนะนำเมื่อพบปัญหาในการใช้งาน
    </p>
  </ContentBox>

  <ContentBoxPlain title="เว็บ JAIDEE928 คาสิโนใจดีเว็บแท้ รวมเกมเดิมพันมาตรฐานครบทุกหมวด" as="h2">
    <p class="mb-2 text-left text-base leading-relaxed text-[#dce9ff]">
      JAIDEE928 รวบรวมเกมคาสิโนออนไลน์หลากหลายหมวดหมู่ให้สมาชิกเลือกเดิมพันผ่านบัญชีเดียว ทั้ง <strong class="text-[#7db4ff]">บาคาร่า รูเล็ต เสือมังกร แบล็กแจ็ก คาสิโนสด และสล็อต</strong>
      พร้อมจัดหมวดหมู่ให้ค้นหาได้ง่าย รองรับการเข้าเล่นผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ โดยไม่ต้องสลับใช้งานหลายบัญชี
      ก่อนเดิมพันสมาชิกสามารถตรวจสอบกติกา อัตราจ่าย ขั้นต่ำต่อตา และรายละเอียดของแต่ละเกม เพื่อเลือกเกมให้เหมาะกับรูปแบบการเล่นของตนเอง
    </p>
  </ContentBoxPlain>

  <ContentBoxPlain title="โปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ของ JAIDEE928" as="h2">
    <p class="mb-2 text-left text-base leading-relaxed text-[#dce9ff]">
      สมาชิกสามารถติดตามโปรโมชั่น JAIDEE928 ที่เปิดให้รับตามเงื่อนไขของแต่ละกิจกรรม โดยระบบจะแสดงรายละเอียดเกี่ยวกับ
      <strong class="text-[#7db4ff]">เปอร์เซ็นต์ วิธีคำนวณ รอบการรับ และข้อกำหนดที่เกี่ยวข้อง</strong> ให้ตรวจสอบก่อนเข้าร่วมทุกครั้ง
    </p>

    <p class="mt-3 mb-2 text-left text-base leading-relaxed text-[#dce9ff]">
      สำหรับ <strong class="text-[#7db4ff]">โปรโมชั่นแนะนำเพื่อน รับโบนัสสูงสุด 0.8%</strong> สมาชิกสามารถแชร์ลิงก์แนะนำของตนเองและติดตามสิทธิ์ผ่านบัญชีสมาชิก ส่วน
      <strong class="text-[#7db4ff]">โปรโมชั่นคืนยอดเสีย รับโบนัสสูงสุด 0.3%</strong> จะคำนวณตามยอดและประเภทเกมที่เข้าเงื่อนไข ทั้งนี้
      โบนัสช่วยเพิ่มสิทธิประโยชน์ในการใช้งาน แต่ไม่สามารถรับประกันผลกำไรจากการเดิมพันได้
    </p>
  </ContentBoxPlain>

  <ContentBoxPlain title="ฝากถอนอัตโนมัติไม่มีขั้นต่ำ และแอดมิน JAIDEE928 ดูแลตลอด 24 ชั่วโมง" as="h2">
    <p class="mb-6 text-left text-base leading-relaxed text-[#dce9ff]">
      <strong class="text-[#7db4ff]">ระบบ JAIDEE928</strong> ออกแบบให้สมาชิกจัดการข้อมูลบัญชีและธุรกรรมผ่านหน้าเว็บไซต์ได้ด้วยตนเอง ทั้งเข้าสู่ระบบ ตรวจสอบเครดิต
      ฝากถอนผ่านระบบอัตโนมัติแบบไม่มีขั้นต่ำ และเลือกเกมคาสิโนได้ตลอด 24 ชั่วโมง พร้อมแสดงประวัติรายการเพื่อให้ง่ายต่อการตรวจสอบ หากพบปัญหาเกี่ยวกับการสมัครสมาชิก การ Login เครดิตไม่เข้า
      ถอนเงินล่าช้า หรือโบนัสไม่แสดง สามารถติดต่อ <strong class="text-[#7db4ff]">แอดมิน JAIDEE928 ได้ตลอด 24 ชั่วโมง</strong>
      ทีมงานพร้อมช่วยตรวจสอบรายการและแนะนำขั้นตอนการใช้งาน ทั้งนี้ การพนันมีความเสี่ยงและไม่สามารถรับประกันผลกำไรได้ สมาชิกควรศึกษากติกาของแต่ละเกมและกำหนดงบประมาณก่อนเดิมพันทุกครั้ง
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก JAIDEE928"
        class="flex items-center justify-center rounded-lg bg-gradient-to-r from-[#e6e8ec] via-[#7db4ff] to-[#0e6efb] px-8 py-3 font-black text-[#040e22] shadow-[0_0_15px_rgba(14,110,251,0.45)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ JAIDEE928"
        class="flex items-center justify-center rounded-lg border border-[#0e6efb]/70 bg-transparent px-8 py-3 font-bold text-[#dce9ff] transition-all hover:scale-105 hover:border-[#7db4ff] hover:bg-[#040e22]/70">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
