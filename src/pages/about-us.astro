---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login, /register)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึงเขียนขึ้นใหม่
// บนข้อเท็จจริงของ หวยเต็ง เท่านั้น
//
// รอบนี้ (ดรอป 2026-10-01) คือ หวยเต็ง **เว็บแทงหวยออนไลน์** — รวมรายการหวยยอดนิยม
// ไว้ให้เลือกผ่านบัญชีเดียว ทั้งรัฐบาลไทย ลาวพัฒนา ฮานอย (ปกติ/พิเศษ/วีไอพี)
// และหวยหุ้นต่างประเทศ ส่วนแบรนด์ก่อนหน้า (BRAVO168) เป็นเว็บแทงบอล/สปอร์ตบุ๊ก
// และก่อนหน้านั้น (CK268) เป็นเว็บเกมสล็อต ซึ่งบรีฟรอบนี้ไม่ได้พูดถึงเลย จึงถอดออก
// ทั้งชุด ห้าม find-and-replace ชื่อแบรนด์ทับประโยคเดิม มิฉะนั้นเว็บจะไปอ้างสินค้า
// ที่ไม่มีอยู่ในบรีฟรอบนี้
// (คำห้ามจาก brand-spec §1: บอล ฟุตบอล บอลเดี่ยว บอลสเต็ป บอลสด ค่าน้ำ อัตราต่อรอง
// ลีก คู่แข่งขัน แมตช์ บิล แฮนดิแคป สล็อต ฟรีสปิน แจ็กพอต บาคาร่า รูเล็ต คาสิโน RTP)
//
// ข้อเท็จจริงทุกบรรทัดมาจาก content.txt เท่านั้น: รวมรายการหวยยอดนิยมผ่านบัญชีเดียว ·
// รัฐบาลไทย ลาวพัฒนา ฮานอยปกติ ฮานอยพิเศษ ฮานอยวีไอพี หวยหุ้นต่างประเทศ ·
// เลือกเลข ส่งโพย ตรวจสอบรายการ อัตราจ่าย และผลหวยตามรอบจากระบบเดียว ·
// ก่อนส่งโพยตรวจชื่อรายการ เลขที่เลือก ยอดเดิมพัน เวลาปิดรับ และอัตราจ่ายของรอบนั้น ·
// 2 ตัว จ่าย 100 บาท · 3 ตัว จ่าย 1,000 บาท · สมัคร 3 ขั้นตอน · แอดมิน 24 ชั่วโมง
// — ตัวเลขที่อ้างได้มีแค่ 100 บาท 1,000 บาท 3 ขั้นตอน และ 24 ชั่วโมง
// ห้ามเพิ่มชื่อผู้ให้บริการ ชื่อธนาคาร ขั้นต่ำฝากถอน เลขใบอนุญาต ปีที่ก่อตั้ง
// หรือจำนวนสมาชิกที่บรีฟไม่ได้ระบุ · บรีฟรอบนี้ไม่มีโปรโมชั่น/โบนัสเลยสักรายการ
// จึงไม่มีหัวข้อโปรโมชั่นในหน้านี้
//
// บรีฟใส่ประโยค hedge กำกับไว้เองและห้ามตัดทิ้ง: คำว่า "อันดับ 1" ควรมีเกณฑ์หรือ
// ข้อมูลที่ตรวจสอบได้รองรับ · อัตรา 2 ตัว/3 ตัว ไม่ควรถือว่าใช้กับหวยทุกประเภท
// โดยอัตโนมัติ ให้ยึดข้อมูลที่แสดงในหน้าส่งโพยของแต่ละรอบ · ห้ามเปิดเผยรหัสผ่าน
// PIN OTP
//
// พาเลตต์ หวยเต็ง เป็น **เขียวป่า + ทอง** ตามโลโก้ (คำว่า "หวย" เขียวมรกต คู่กับ
// "เต็ง" ทองตัน) และแบนเนอร์ฉากคืนสีเขียวป่าที่มีริ้วแสงทอง เหรียญทอง ลูกหวยทอง
// และเงาวัดสีทอง ตารางแมปอยู่ที่ brand-spec §2: พื้นเข้มสุด #03150a · การ์ด #062a12 ·
// ผิวยก #0b3d18 · เส้น/ขอบ #024a0f · เขียวแบรนด์ #026314 · เขียวสว่าง #0bb42f ·
// ทองหลัก #e5c04f · ทองอ่อน #fae474 · ทองเข้ม #bd8d2d · เนื้อความ #d8ead9
// (BRAND_TEXT) · หมึกบนพื้นทอง #0a1a0c
// เรืองแสง: ทอง rgba(229,192,79,0.30) · เขียว rgba(2,99,20,0.35)
// ชุดน้ำเงินรอยัล-ทองของ BRAVO168 (#02081a #04142f #072247 #0e3f8f #1558c4 #2f86f0
// #f4cb69 #ffe39a #c9922e #e8f1ff #a8bedd #dbe5f5 #0a1020 rgba(244,203,105,*)
// rgba(21,88,196,*)) ออกครบทุกจุดแล้ว ทั้งคลาส Tailwind raw hex และ rgba()
// ส่วน #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ตามเดิม
// กฎคอนทราสต์: พื้นทอง → หมึกเข้ม #0a1a0c · ตัวอักษรบนการ์ดเขียวใช้ #d8ead9 #fae474
// #e5c04f #0bb42f เท่านั้น ส่วน #026314 / #024a0f / #bd8d2d ใช้เป็นพื้นและขอบ ไม่ใช่หมึก
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลางที่ไม่หมุนตามรอบรีแบรนด์ และรอบนี้
// orchestrator เป็นคนรีธีม) — สีเนื้อความจึงตรงกับที่การ์ดกำหนดไว้อยู่แล้ว
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index และ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า
// และ slide3/slide4/banner2/banner3 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import (ลำพัง
// การ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น Announcement3 ทั้งเว็บ — orchestrator ตั้ง default message
// ของไฟล์นั้นเป็นคอปปี้ของ หวยเต็ง แล้ว จึงเรียกแบบ bare เหมือน index.astro
// ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 151
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "เกี่ยวกับ หวยเต็ง เว็บแทงหวยออนไลน์ที่รวมหวยรัฐบาลไทย ลาวพัฒนา ฮานอย และหวยหุ้นต่างประเทศไว้ในบัญชีเดียว หน้านี้สรุปว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง";

const pageTitle = "เกี่ยวกับเรา หวยเต็ง เว็บแทงหวยออนไลน์รวมทุกรายการในบัญชีเดียว";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d8ead9]">
        <strong class="text-[#fae474]">หวยเต็ง</strong> คือ<strong class="text-[#fae474]">เว็บแทงหวยออนไลน์ที่รวบรวมรายการหวยยอดนิยมไว้ให้เลือกผ่านบัญชีเดียว</strong>
        มีทั้งหวยรัฐบาลไทย ลาวพัฒนา ฮานอย และหวยหุ้นต่างประเทศ รองรับการเข้าใช้งานผ่านมือถือโดยไม่ต้องสลับไปมาหลายเว็บไซต์ สำหรับผู้ที่ต้องการติดตามหวยหลายประเภทและหลายรอบในแต่ละวัน
      </p>

      <p class="text-left text-base leading-relaxed text-[#d8ead9]">
        หน้านี้รวบรวมไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่ประเภทหวยที่เปิดรับในแต่ละรอบ อัตราจ่ายของรายการที่ร่วมเงื่อนไข ระบบบัญชีที่ใช้เลือกเลข ส่งโพย ตรวจสอบรายการและผลรางวัล
        ขั้นตอนการสมัคร ไปจนถึงช่องทางสอบถามแอดมินเมื่อไม่แน่ใจในขั้นตอนใด
      </p>

      <p class="text-left text-base leading-relaxed text-[#d8ead9]">
        <strong class="text-[#fae474]">ส่วนคำว่า “เว็บแทงหวยออนไลน์อันดับ 1” หากนำมาใช้เป็นจุดขายหลัก ควรมีเกณฑ์หรือข้อมูลที่สามารถตรวจสอบได้รองรับ</strong>
        เช่นเดียวกับตารางเวลาและเงื่อนไขของหวยแต่ละประเภทที่เปลี่ยนแปลงได้ตามรอบ รายละเอียดทั้งหมดจึงยึดตามข้อมูลที่เว็บไซต์แสดงไว้ในหน้าส่งโพยของรอบนั้นเป็นหลัก
      </p>
    </div>
  </ContentBox>

  <ContentBox title="หวยเต็ง รวมหวยหลายประเภทไว้ให้เลือกผ่านบัญชีเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d8ead9]">
        สิ่งที่เว็บไซต์ระบุไว้เป็นตัวตนของ หวยเต็ง คือ <strong class="text-[#fae474]">การรวมรายการหวยยอดนิยมไว้ให้เลือกผ่านบัญชีเดียว</strong>
        สมาชิกจึงเลือกหวยจากคนละประเภทได้จากบัญชีเดิม ไม่ต้องเปิดบัญชีแยกกันไปตามแต่ละรายการ และไล่ดูรอบที่เปิดรับของแต่ละประเภทได้จากระบบเดียว
      </p>

      <p class="text-left text-base leading-relaxed text-[#d8ead9]">
        ถัดจากการเลือกรายการคือ<strong class="text-[#fae474]">หน้าบัญชีสมาชิกที่ใช้เลือกเลข ส่งโพย ตรวจสอบรายการ อัตราจ่าย และผลหวยตามรอบที่เปิดให้บริการ</strong>
        เมื่อประกาศผลแล้วจึงกลับมาตรวจสอบโพยและผลรางวัลตามรายการที่เลือกไว้ได้จากที่เดียว ไม่ต้องจดแยกไว้เองหรือย้อนถามทีละรายการ
      </p>

      <p class="text-left text-base leading-relaxed text-[#d8ead9]">
        ส่วนรายการที่เปิดรับจริงในแต่ละวันนั้น<strong class="text-[#fae474]">ขึ้นอยู่กับตารางของหวยแต่ละประเภทและรอบเวลาที่ระบบเปิดรับในขณะนั้น</strong>
        จึงควรตรวจสอบชื่อรายการ เลขที่เลือก ยอดเดิมพัน เวลาปิดรับ และอัตราจ่ายของรอบนั้นให้เรียบร้อยก่อนกดส่งโพยทุกครั้ง
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/ทดลองเล่น"
          aria-label="เปิดหน้าทดลองเล่นของ หวยเต็ง"
          class="flex items-center justify-center rounded-lg border border-[#024a0f] bg-[#0b3d18] px-8 py-3 font-bold text-[#d8ead9] transition-all hover:scale-105 hover:border-[#e5c04f] hover:bg-[#062a12] hover:text-[#e5c04f]">
          ไปหน้าทดลองเล่น
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="ประเภทหวยที่ หวยเต็ง เปิดรับ รัฐบาลไทย ลาวพัฒนา ฮานอย และหวยหุ้น" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d8ead9]">
        รายการที่เปิดให้เลือกแบ่งได้เป็นไม่กี่กลุ่มใหญ่ และแต่ละกลุ่ม<strong class="text-[#fae474]">มีตารางเวลาและเงื่อนไขเป็นของตัวเอง</strong>
        ไม่ได้ใช้ชุดเดียวกันทั้งหมด การรู้ว่าแต่ละกลุ่มต่างกันตรงไหนช่วยให้เลือกรอบที่ตรงกับจังหวะของตัวเองได้เร็วขึ้น
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#d8ead9]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e5c04f]">🏛️</span>
          <span>
            <strong class="text-[#fae474]">หวยรัฐบาลไทย</strong> เปิดรับตามกำหนดออกรางวัลของแต่ละงวด จึงเป็นกลุ่มที่รอบชัดเจนที่สุดและวางแผนล่วงหน้าได้ง่ายที่สุดสำหรับผู้ที่เพิ่งเริ่มต้น
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#0bb42f]">🎫</span>
          <span>
            <strong class="text-[#fae474]">หวยลาวพัฒนา</strong> เป็นอีกรายการที่ระบบเปิดรับตามรอบของตัวเอง จึงควรดูตารางและเวลาปิดรับของรอบนั้นจากหน้าส่งโพยก่อนเลือกเลขทุกครั้ง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#e5c04f]">🕒</span>
          <span>
            <strong class="text-[#fae474]">หวยฮานอย ปกติ พิเศษ และวีไอพี</strong> แยกเป็นคนละรอบกัน แต่ละรอบมีเวลาปิดรับของตัวเอง จึงควรอ่านชื่อรายการให้ตรงรอบก่อนยืนยันโพย
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#0bb42f]">📈</span>
          <span>
            <strong class="text-[#fae474]">หวยหุ้นต่างประเทศ</strong> เปิดรับตามตลาดและรอบเวลาที่ระบบกำหนด จำนวนรายการที่เลือกได้ในแต่ละวันจึงขึ้นอยู่กับตลาดที่เปิดในรอบนั้น
          </span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#d8ead9]">
        <strong class="text-[#fae474]">ตารางเวลาและเงื่อนไขของหวยแต่ละประเภทไม่จำเป็นต้องเหมือนกัน</strong>
        ก่อนส่งโพยจึงควรตรวจสอบชื่อรายการ เลขที่เลือก ยอดเดิมพัน เวลาปิดรับ และอัตราจ่ายของรอบนั้นให้เรียบร้อย แทนการอ้างจากรอบก่อนหน้าที่เคยเล่นไว้
      </p>
    </div>
  </ContentBox>

  <ContentBox title="อัตราจ่าย หวยเต็ง 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#d8ead9]">
        หวยเต็ง <strong class="text-[#fae474]">กำหนดอัตราจ่ายสำหรับรายการที่ร่วมเงื่อนไข โดยมีตัวเลือก 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท</strong>
        ตามประเภทหวยและรูปแบบการเดิมพันที่ระบบกำหนด สมาชิกสามารถตรวจสอบอัตราจ่ายล่าสุดได้ก่อนส่งโพย เพื่อให้ทราบรายละเอียดของรายการและจำนวนเงินที่ใช้คำนวณอย่างชัดเจน
      </p>

      <p class="text-left text-base leading-relaxed text-[#d8ead9]">
        สำหรับรายการที่กำหนดอัตรา 2 ตัว จ่าย 100 บาท ควรดูให้ชัดเจนว่าอัตราดังกล่าวใช้กับหวยประเภทใดและรูปแบบ 2 ตัวรายการใด เพื่อป้องกันความเข้าใจคลาดเคลื่อนเมื่อตรวจผลและคำนวณรางวัล
        ส่วนรายการที่กำหนดอัตรา 3 ตัว จ่าย 1,000 บาท ควรตรวจสอบประเภทของเลข 3 ตัวและหวยที่ร่วมอัตรานี้จากหน้าส่งโพยก่อนยืนยันทุกครั้ง
      </p>

      <p class="text-left text-base leading-relaxed text-[#d8ead9]">
