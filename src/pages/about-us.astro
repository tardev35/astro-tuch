---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login, /register,
// /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx
// ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึง
// เขียนขึ้นใหม่บนข้อเท็จจริงของบรีฟรอบนี้เท่านั้น (src/assets/content.txt)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x3 · h3x0
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) จึงเปิดใช้งานอยู่ และรอบนี้ operator สั่งให้
// คงไว้ ไม่ได้ park ลง src/pages-disabled/
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// ตัวที่ routing จริงคือไฟล์นี้ Astro ไม่อ่านโฟลเดอร์นั้นเลย ห้ามแก้และห้ามลบ
//
// ⚠️ ดรอปนี้ (2026-10-12) คือ **เว็บเล่นสล็อตออนไลน์ล้วน** (บรีฟเรียก
// ตัวเองว่า สล็อตปันโปรในตำนาน) **ไม่ใช่เว็บเกมรวมหลายหมวด** แบบแบรนด์ก่อน ไม่ใช่
// เว็บกีฬา และไม่ใช่เว็บลอตเตอรี (สองหน้าของหมวดนั้นจอดอยู่ใน src/pages-disabled/
// ไม่มี route ห้ามลิงก์ไปหา เป็น href ตายที่ทำให้ build แดง) หน้าเดิมทั้งหน้าเขียน
// บนกรอบ "เกมรวมหลายหมวด" ของแบรนด์ก่อน ซึ่งทุกคำเป็นศัพท์ที่ brand-spec §6 สั่งห้าม
// รอบนี้ (ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาคำต้องห้ามเจอ false positive) จึงเขียน
// ใหม่ทั้งหน้า ไม่ใช่ find-and-replace ทับประโยคเดิม
//
// แง่มุมที่บรีฟรอบนี้ระบุไว้มีเท่านี้ (ห้ามเติมอย่างอื่น): เว็บเล่นสล็อตออนไลน์ที่รวม
// เกมสล็อตหลายรูปแบบไว้ในระบบเดียว · สล็อตคลาสสิก · เกมวงล้อแบบดั้งเดิม · สล็อตภาพ
// สมัยใหม่ · เกมโบนัส · ฟรีสปิน · ฟีเจอร์โบนัส · หมวดเกมรวมในหน้าเดียว · เมนูตรวจสอบ
// เครดิต · ข้อมูลบัญชีสมาชิก · ยอดเดิมพัน · ตารางจ่าย · รองรับมือถือและคอมพิวเตอร์ ·
// ทางเข้าเล่นใหม่ปี 2026 · เว็บไซต์เลียนแบบ · ภาพลักษณ์เว็บคนนิยมเล่นมายาวนานต้องมี
// ประวัติการเปิดให้บริการและความคิดเห็นจากผู้ใช้งานจริงที่ตรวจสอบได้ประกอบ ·
// คืนยอดเสีย 0.3% เข้ายูสทุกวัน · แนะนำเพื่อน 0.8% ไม่จำกัด · ลิงก์แนะนำส่วนตัว ·
// สมัครสมาชิก 3 ขั้นตอน · ยืนยันบัญชี · แอดมิน 24 ชั่วโมง · ช่องทางหลัก · PIN · OTP
//
// ⚠️ คำที่ห้ามหลงเหลือ: ศัพท์หมวดเกมรวมของแบรนด์ก่อน ศัพท์กรอบเว็บกีฬา คำขายของของ
// แบรนด์เก่าๆ และศัพท์หมวดลอตเตอรีทุกคำ — รายการเต็มอยู่ใน brand-spec §6 ไม่พิมพ์ซ้ำ
// ที่นี่ เพื่อไม่ให้ grep หาคำต้องห้ามเจอ false positive
//
// ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง · ปี 2026
// ห้ามเติมเลขใบอนุญาต หน่วยงานกำกับ ชื่อค่ายเกม ชื่อธนาคาร ค่า RTP ยอดฝากถอนขั้นต่ำ
// เป็นตัวเลข จำนวนสมาชิก หรือปีที่ก่อตั้ง เพราะบรีฟไม่ได้เอ่ยไว้สักอย่าง
//
// ประโยคกำกับที่บรีฟเขียนไว้เองและห้ามตัดทิ้งเพราะฟังดูไม่ขายของ — ขนมาครบ:
// ควรตรวจสอบช่องทางเข้าเล่นล่าสุดและรายละเอียดค่ายเกมจากเว็บไซต์หลักก่อนใช้งาน
// เพื่อหลีกเลี่ยงการเข้าสู่เว็บไซต์เลียนแบบ (h1 ย่อหน้า 1) · จำนวนปีที่เปิดเว็บไซต์
// และความนิยมไม่สามารถยืนยันได้จากชื่อแบรนด์เพียงอย่างเดียว (h1 ย่อหน้า 3) ·
// ควรตรวจสอบโดเมนหลักและข้อมูลผู้ให้บริการให้ชัดเจนก่อนสมัครสมาชิก (h1 ย่อหน้า 3) ·
// แต่ละกิจกรรมอาจกำหนดรอบรับสิทธิ์ ประเภทเกม และเงื่อนไขการใช้โบนัสแตกต่างกัน
// จึงควรอ่านรายละเอียดให้ครบถ้วนก่อนกดรับ (h2 #2 ย่อหน้า 1) · ควรตรวจสอบเวลาตัดรอบ
// เกมที่ร่วมรายการ และข้อกำหนดการใช้โบนัสก่อนรับทุกครั้ง (h2 #2 รายการแรก) ·
// คำว่าไม่จำกัดควรตรวจสอบว่าหมายถึงจำนวนเพื่อน จำนวนครั้งในการรับสิทธิ์ หรือวงเงิน
// โบนัส (h2 #2 รายการที่สอง) · ผู้สมัครควรตรวจสอบชื่อโดเมนและรายละเอียดผู้ให้บริการ
// ก่อนส่งข้อมูลส่วนตัว พร้อมอ่านข้อกำหนดการใช้งานและตรวจสอบอายุที่กฎหมายอนุญาต
// (h2 #3 ย่อหน้า 1) · ไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP (h2 #3 ย่อหน้าท้าย)
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ชมพูฮอตพิงก์นำ ทองสว่างรอง บนพื้นพลัมเข้ม
// อมม่วง #2e0022** พลิกออกจากสาย "ทองบนดำ" ของแปดรอบหลังสุด (ค่าเดิมอยู่ใน
// brand-spec §2 ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive)
// และเพราะพื้นเพจ **ไม่ใช่ดำสนิท** รอบนี้จึงมีชั้นที่ลึกกว่าพื้นเพจได้จริง (#1c0014)
// ลำดับความลึก: #4a1038 ผิวยก / #3a0a2a ผิวกลาง / #2e0022 พื้นเพจ / #1c0014 ผิวจม
//
// ลำดับปุ่มสื่อด้วย "ทองถม vs ผิวจมขอบชมพู" — คู่พื้น-หมึกคำนวณไว้แล้ว:
// · ปุ่มหลัก (สมัครสมาชิก) ถมทองไล่ #fce343 → #ffc554 ขอบ #8a0a45 หมึก #2a0012
//   ⚠️ ไล่เฉดต้องหยุดที่ #ffc554 ห้ามไล่ลงไปเข้มกว่านั้นใต้ตัวอักษร
// · ปุ่มรอง (เข้าสู่ระบบ) ชั้นจม #3a0a2a → #1c0014 ขอบ #f41571/55 ตัวอักษร #fde7f2
// · ปุ่มลิงก์ภายในเป็นชั้นจมเดียวกัน ขอบ #f41571/50 ตัวอักษรชมพูสว่าง #ff5ca8
// · #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้
// ⚠️ #8a0a45 · #4a0426 ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่เส้นขอบ ออรา และเงา —
// ออราในไฟล์นี้ใช้ rgba(244,21,113,α) และ rgba(252,227,67,α) เท่านั้น
// ⚠️ "ชมพู" และ "ทอง" ไม่ใช่ตัวบอกว่าถูกแบรนด์: ชมพูของแบรนด์เก่ารอบหนึ่งและทองของแปดรอบ
// หลังสุดใกล้กันมาก ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน brand-spec §2
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #fde7f2,
// 12.6:1 บนผิวยก #4a1038) ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง
// ปล่อยให้สืบทอดลงมา และไม่ใส่ mx-auto / max-w-* บน <p> เพราะการ์ดคุมความกว้างเองแล้ว
// — ที่ประกาศสีได้มีแค่ปุ่ม (ถมพื้นของตัวเองจึงต้องกำหนดหมึกของตัวเอง) และ <strong>
// ซึ่ง brand-spec §2 กำหนดให้ใช้ทองไฮไลต์ #ffd94a (10.8:1 บนผิวการ์ด) เป็นสีไฮไลต์
// ในเนื้อความโดยเฉพาะ · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง เพราะ
// ภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง
// (ลบแท็ก <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิมเป๊ะ)
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้าง
// จากหน้า และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้หมุนมาเป็น Announcement3 ทั้งเว็บ (รอบก่อนใช้ Announcement5 —
// brand-spec §3 หมุนออก) orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ
// แบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะพูดคนละเรื่อง
// กับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 154 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} เว็บเล่นสล็อตออนไลน์ที่รวมสล็อตคลาสสิก เกมโบนัส และฟรีสปินไว้ในระบบเดียว พร้อมคืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% และแอดมิน 24 ชั่วโมง`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} เว็บเล่นสล็อตออนไลน์ รวมเกมสล็อตไว้ในระบบเดียว`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#ffd94a]">{BRAND_NAME} คือเว็บเล่นสล็อตออนไลน์ที่รวมเกมสล็อตหลายรูปแบบไว้ให้เลือกในระบบเดียว</strong>
        ทั้งสล็อตคลาสสิก เกมโบนัส และฟรีสปิน พร้อมทางเข้าเล่นใหม่ปี 2026 ที่เน้นความสะดวกในการใช้งานผ่านมือถือและคอมพิวเตอร์ ผู้ที่สนใจควรตรวจสอบช่องทางเข้าเล่นล่าสุดและรายละเอียดค่ายเกมจากเว็บไซต์หลักก่อนใช้งาน
        เพื่อหลีกเลี่ยงการเข้าสู่เว็บไซต์เลียนแบบ
      </p>

      <p>
        หน้านี้สรุปไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่หมวดเกมที่จัดไว้ให้เลือกตามความสนใจ
        <strong class="text-[#ffd94a]">
          ไปจนถึงเมนูตรวจสอบเครดิต ข้อมูลบัญชีสมาชิก รายการโปรโมชั่นที่ตรวจสอบเงื่อนไขได้ ขั้นตอนสมัครสมาชิก และช่องทางติดต่อแอดมินที่ระบุเวลาให้บริการตลอด 24 ชั่วโมง
        </strong>
        เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดดูอะไรตรงไหน แล้วจึงค่อยลงรายละเอียดของรายการที่สนใจเป็นรายรายการ
      </p>

      <p>
        <strong class="text-[#ffd94a]">
          สำหรับภาพลักษณ์เว็บคนนิยมเล่นมายาวนาน ควรมีข้อมูลประวัติการเปิดให้บริการและความคิดเห็นจากผู้ใช้งานจริงที่ตรวจสอบได้ประกอบ
          เพราะจำนวนปีที่เปิดเว็บไซต์และความนิยมไม่สามารถยืนยันได้จากชื่อแบรนด์เพียงอย่างเดียว
        </strong>
        ส่วนผู้ที่ต้องการเข้าเล่นควรตรวจสอบโดเมนหลักและข้อมูลผู้ให้บริการให้ชัดเจนก่อนสมัครสมาชิก ข้อมูลในหน้านี้จึงเขียนไว้เพื่อบอกว่าระบบมีอะไรให้ใช้และควรตรวจอะไรก่อนตัดสินใจ ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้งาน
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`หมวดเกมสล็อตที่ ${BRAND_NAME} รวมไว้ในระบบเดียว`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} นำเสนอรูปแบบการใช้งานสำหรับผู้สนใจเกมสล็อตหลายประเภท จุดเด่นอยู่ที่การรวมหมวดเกมและข้อมูลสมาชิกไว้ในหน้าเดียว
        <strong class="text-[#ffd94a]">ช่วยให้ค้นหาเกมที่สนใจ ตรวจสอบยอดเดิมพัน และดูรายละเอียดตารางจ่ายได้สะดวกผ่านอุปกรณ์ที่ใช้งานอยู่</strong>
