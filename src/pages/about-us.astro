---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "รู้จัก WE168 คาสิโนออนไลน์ครบวงจร บาคาร่า รูเล็ต เสือมังกร แบล็กแจ็ก ไฮโล สล็อต ระบบฝากถอนอัตโนมัติ รองรับมือถือทุกรุ่น พร้อมทีมงานดูแลตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ WE168 คาสิโนออนไลน์ครบวงจร ครบทุกหมวดหมู่เกม",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา WE168 คาสิโนออนไลน์ครบวงจร รองรับมือถือทุกเครื่อง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ WE168" as="h1">
    <p class="mb-6 text-left text-base leading-relaxed text-[#e8f5ee]">
      <strong class="text-[#4ade80]">WE168</strong> คือคาสิโนออนไลน์ครบวงจรที่รวมเกมยอดนิยมไว้ในบัญชีเดียว ครอบคลุมบาคาร่า รูเล็ต เสือมังกร แบล็กแจ็ก ไฮโล และสล็อต จัดหมวดหมู่เกมให้เลือกเล่นได้ง่าย รองรับการใช้งานผ่านโทรศัพท์มือถือทั้ง Android และ iOS รวมถึงแท็บเล็ตและคอมพิวเตอร์ได้โดยตรงผ่านเว็บเบราว์เซอร์ ไม่ต้องติดตั้งโปรแกรมเพิ่มเติม
    </p>

    <p class="mb-8 text-left text-base leading-relaxed text-[#e8f5ee]">
      ด้านการเงิน ระบบฝากถอนอัตโนมัติของ WE168 เปิดให้สมาชิกทำรายการได้ด้วยตนเองตลอด 24 ชั่วโมงโดยไม่ต้องรอเจ้าหน้าที่ทีละราย พร้อมทีมงานคอยดูแลและตรวจสอบปัญหาการใช้งาน ไม่ว่าจะเป็นการสมัครสมาชิก การเข้าสู่ระบบ หรือสถานะรายการฝากถอน เพื่อให้สมาชิกทุกคนเดิมพันกับ WE168 ได้อย่างมั่นใจในทุกขั้นตอน
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก"
        class="flex items-center justify-center rounded-lg bg-gradient-to-r from-[#f9a8d4] to-[#db2777] px-8 py-3 font-black text-[#4a0a29] shadow-[0_0_15px_rgba(236,72,153,0.45)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ"
        class="flex items-center justify-center rounded-lg border border-[#5dca22]/70 bg-transparent px-8 py-3 font-bold text-[#5dca22] transition-all hover:scale-105 hover:bg-[#1f3a08]/60">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
