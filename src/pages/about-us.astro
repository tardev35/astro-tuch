---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login, /register,
// /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx
// ที่ใช้กับ index.astro — บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES
// ที่ให้ body มา ทั้งหน้าจึงเขียนขึ้นใหม่จากข้อเท็จจริงและคลังคำของบรีฟรอบนี้เท่านั้น
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x4 · h3x0
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) จึงเปิดใช้งานอยู่
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// ตัวที่ routing จริงคือไฟล์นี้ Astro ไม่อ่านโฟลเดอร์นั้นเลย ห้ามแก้และห้ามลบ
//
// ⚠️ ดรอปนี้ (2026-10-19) คือ **เว็บสล็อตล้วน** ไม่ใช่คาสิโน ไม่มีกีฬา และไม่ใช่
// เว็บหวย สองหน้าของหมวดลอตเตอรีที่แบรนด์ก่อนๆ เคยเปิด จอดอยู่ใน src/pages-disabled/
// ไม่มี route ห้ามลิงก์ไปหา เป็น href ตายที่ทำให้ build แดง route ที่มีจริงรอบนี้คือ
// / · /about-us · /contact-us · /login · /register · /privacy · /promotion ·
// /terms · /ทดลองเล่น · /ทางเข้า · /line
//
// ⚠️ แบรนด์ก่อนหน้าทันที (นินจา168 ที่ถูกแทนที่รอบนี้) ก็เป็นแบรนด์สล็อตฟ้า+เหลือง
// เหมือนกัน และก่อนหน้านั้นเป็นฟ้า+ทอง คอปปี้และสีเดิมจึง "ดูเข้าเค้า" ทั้งที่กรอบ
// ของบรีฟคนละอัน — **ห้าม find-and-replace ทับประโยคเดิม** ทั้งหน้าถูกเขียนใหม่
// รอบกรอบของบรีฟรอบนี้ ซึ่งว่าด้วย **การศึกษาระบบเกมสล็อตตามงบประมาณของตัวเอง
// ช่วงเดิมพันขั้นต่ำ ตารางจ่ายรางวัล ความผันผวน และโปรโมชั่นสองรายการคือคืนยอดเสีย
// 0.3% กับแนะนำเพื่อน 0.8%** ไม่ใช่กรอบของรอบก่อนซึ่งยกช่องทางชำระเงินขึ้นเป็น
// หัวข้อหลัก และมีคำกล่าวอ้างเรื่องความเป็นเว็บหลัก (คำต้องห้ามไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive — รายการเต็มอยู่ใน brand-spec §6)
//
// 🚨 **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกมแม้แต่ค่ายเดียว** จึงห้ามเขียนชื่อค่ายใดๆ
// ลงหน้าเว็บ ให้ใช้คำกลางว่า "ค่ายเกม" ตามบรีฟ
//
// คลังคำที่บรีฟรอบนี้ให้มา และใช้ได้เท่านี้ (brand-spec §6): สล็อต · ค่ายเกม ·
// กติกา · อัตราเดิมพัน · เงื่อนไขการจ่ายรางวัล · ตารางจ่ายรางวัล · ความผันผวน ·
// เดิมพันขั้นต่ำ · งบประมาณ · ทุนน้อย · โปรโมชั่น · คืนยอดเสีย 0.3% ·
// แนะนำเพื่อน 0.8% · โบนัส · เครดิต · ยอดเสีย · รอบคำนวณ · รอบจ่ายโบนัส ·
// ลิงก์แนะนำ · สมัครสมาชิก · เข้าสู่ระบบ · ลงทะเบียน · บัญชีสมาชิก ·
// ข้อมูลส่วนบุคคล · รหัสผ่าน · รหัส OTP · ฝากถอน · เจ้าหน้าที่ · แอดมิน · 24ชม. ·
// ช่องทางทางการ · บัญชีแอบอ้าง · หลักฐาน
//
// ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 24ชม. ส่วนตัวเลขและชื่อเฉพาะที่
// ห้ามแต่งขึ้นเองอยู่ครบใน brand-spec §6 (ชื่อผู้กำกับดูแล · ชื่อนิติบุคคล ·
// ค่าตัวเลขของเกม · ยอดฝากขั้นต่ำ · จำนวนสมาชิก · ปีก่อตั้ง · ชื่อค่ายเกม)
//
// ⚠️ คำว่า "ไม่มีขั้นต่ำ" และ "การันตีได้เงินสูงทุกรอบ" อยู่ได้เฉพาะในหัวข้อที่บรีฟ
// เขียนไว้เอง (= หัวข้อของ index.astro) หน้านี้จึงไม่หยิบมาใช้เลย เพราะย่อหน้าของ
// บรีฟเองหักล้างทันทีว่าไม่มีระบบใดรับประกันว่าจะได้รับเงินรางวัลสูงทุกรอบ
//
// 🚨 บรีฟรอบนี้ hedge หนักผิดปกติ และ **ประโยค hedge ทุกประโยคต้องขึ้นครบ**
// เป็นเนื้อหาของบรีฟ ไม่ใช่ filler ให้ตัดทิ้ง:
// 1) เกมสล็อตมีความเสี่ยงและไม่สามารถรับประกันผลตอบแทนได้ (h1)
// 2) เงื่อนไขขั้นต่ำอาจแตกต่างกันในแต่ละเกม และไม่มีระบบใดรับประกันว่าจะได้รับ
//    เงินรางวัลสูงทุกรอบ · ควรกำหนดงบประมาณที่ยอมรับการสูญเสียได้ก่อนเริ่มเล่น (h2 #1)
// 3) เครดิตคืนยอดเสียไม่ใช่การรับประกันว่าจะได้เงินคืนจากทุกการเดิมพัน (h2 #2)
// 4) แม้จะมีการระบุว่าไม่จำกัด แต่ควรศึกษาข้อกำหนดเกี่ยวกับจำนวนผู้เข้าร่วม
//    รอบจ่ายโบนัส และเงื่อนไขการใช้เครดิตให้ชัดเจน (h2 #2)
// 5) ไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น (h2 #3, #4)
// 6) ควรตรวจสอบเวลาการให้บริการและระยะเวลาตอบกลับล่าสุดจากประกาศทางการอีกครั้ง (h2 #4)
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ฟ้าอะซัวร์นำ ทองอำพันรอง บนดำสนิท**
// ⚠️ สองรอบก่อนก็เป็นฟ้านำ+สีเหลือง/ทองรองเหมือนกัน "มีฟ้าอยู่" หรือ "มีทองอยู่"
// จึงไม่ใช่ตัวบอกว่าถูกแบรนด์ ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน brand-spec §2
// (ค่าเดิมไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive ในไฟล์นี้)
// ฟ้ารอบนี้คือ **#039cfa** (R3 G156 B250) ฟ้าน้ำแข็ง **#c3ebfc** และฮิวที่สองคือ
// **ทองอำพัน #f9a826** (R249 G168 B38)
// ลำดับความลึก: #0b2d52 ผิวยก (= การ์ด) / #071e38 กลาง / #030f1d จม / #000000 พื้นเพจ
//
// ลำดับปุ่มสื่อด้วย "พื้นถมฟ้า vs ผิวจมขอบน้ำเงินลึก" — คู่พื้น-หมึกคำนวณไว้แล้ว:
// · ปุ่มหลัก (สมัครสมาชิก) ถมไล่เฉด #c3ebfc → #039cfa ขอบ #04366b หมึก #031320
//   (15.8:1 บนปลายฟ้าน้ำแข็ง · 6.2:1 บนปลายฟ้าแบรนด์ ผ่าน AA ทั้งเส้น)
// · ปุ่มรอง/ปุ่มลิงก์ภายในเป็นชั้นจม #071e38 → #030f1d ขอบ #04366b
//   ตัวอักษร #e3f2fc — hover ยกขอบเป็นทองอำพัน #f9a826 (ตรงกับ hover ของการ์ด
//   ContentBox ซึ่งใช้ #f9a826/70 เป็นขอบ hover เหมือนกัน)
// · marker ของลำดับเลขใช้ฟ้าน้ำแข็ง #c3ebfc (10.8:1 บนผิวการ์ด — เป็นตัวอักษร จึงใช้
//   น้ำเงินลึกไม่ได้ และ #f9a826 สงวนไว้ให้ <strong> เท่านั้น)
// · #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ (§2)
// ⚠️ #04366b · #704504 ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่เส้นขอบ ออรา เงา และพื้นถม
// — ออราในไฟล์นี้ใช้ rgba(4,54,107,α) · rgba(3,156,250,α) · rgba(249,168,38,α)
// เท่านั้น และรอบนี้ไม่มีชมพู ไม่มีแดง ไม่มีม่วง ไม่มีเขียว (นอกจาก LINE)
// ไม่มีส้ม ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์ และไม่มีเหลืองมะนาว
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #e3f2fc,
// 11.9:1 บนผิวยก #0b2d52) ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง
// ปล่อยให้สืบทอดลงมา และไม่ใส่ mx-auto / max-w-* บน <p> เพราะการ์ดคุมความกว้างเองแล้ว
// — ที่ประกาศสีได้มีแค่ปุ่ม (ถมพื้นของตัวเองจึงต้องกำหนดหมึกของตัวเอง) marker ของ
// ลำดับเลข และ <strong> ซึ่ง brand-spec §2 สงวน #f9a826 (6.9:1 บนผิวการ์ด) ไว้เป็น
// สีไฮไลต์ในเนื้อความโดยเฉพาะ และไม่ใช้สีอื่นเลย · แต่ละ <strong> ครอบ "ช่วงที่คั่น
// ด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ
// บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง (ลบแท็ก <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิม)
// และห้ามวาง <strong> สองอันติดกัน
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้าง
// จากหน้า และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้หมุนมาเป็น Announcement3 ทั้งเว็บ (brand-spec §3 —
// รอบก่อนใช้ Announcement5 จึงหมุนออก) orchestrator ตั้ง default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message
// มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 157 อักขระ
//
// ห้ามให้สตริงนี้มีชื่อของสองหน้าหมวดลอตเตอรีที่จอดอยู่ใน src/pages-disabled/
// (ชื่อไฟล์ทั้งสองอยู่ใน brand-spec §1) เพราะ sweep ของรอบถัดไปจะอ่านเป็น
// false positive ว่ายังมีลิงก์ไปหน้าที่ไม่มี route
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} รวมข้อมูลเกมสล็อตจากหลายค่ายเกม ช่วงเดิมพันขั้นต่ำ ตารางจ่ายรางวัล โปรโมชั่นคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ไว้ให้อ่านในหน้าเดียว`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} สล็อตรวมเกมทุกค่าย เล่นตามงบประมาณของตัวเอง`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#f9a826]">{BRAND_NAME} นำเสนอเกมสล็อตออนไลน์หลากหลายรูปแบบสำหรับผู้ที่สนใจศึกษาระบบเกม</strong>
        และเลือกเล่นตามงบประมาณของตนเอง หน้านี้รวบรวมไว้ว่าเว็บไซต์ระบุอะไรไว้บ้าง ทั้งข้อมูลการสมัครสมาชิก การเข้าสู่ระบบ โปรโมชั่น และช่องทางติดต่อเจ้าหน้าที่ เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดดูอะไรตรงไหน แล้วจึงค่อยอ่านรายละเอียดของแต่ละเรื่องเป็นรายข้อ
      </p>

      <p>
        ผู้เล่นสามารถตรวจสอบรายละเอียดของแต่ละเกมได้ก่อนเริ่มใช้งาน
        <strong class="text-[#f9a826]">ทั้งกติกา อัตราเดิมพัน และเงื่อนไขการจ่ายรางวัล</strong>
        ซึ่งเป็นลำดับที่ช่วยให้ทราบว่าแต่ละเกมกำหนดอะไรไว้บ้าง และต้องเตรียมข้อมูลอะไรก่อนดำเนินการต่อในขั้นตอนถัดไป
      </p>

      <p>
        เนื้อหาในหน้านี้เขียนไว้ประกอบการศึกษาเท่านั้น ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้งาน
        <strong class="text-[#f9a826]">โดยควรเข้าใจว่าเกมสล็อตมีความเสี่ยงและไม่สามารถรับประกันผลตอบแทนได้</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ทุนน้อยก็เริ่มได้ ศึกษาช่วงเดิมพันขั้นต่ำของแต่ละเกมก่อนเลือก" as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} นำเสนอเกมสล็อตที่มีรูปแบบการเดิมพันแตกต่างกันตามแต่ละค่ายเกม
