---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่ม) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง
// ไม่ได้มาจากเช็กลิสต์หัวข้อของ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน
// SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริงของ 888PARUAY เท่านั้น
//
// บรีฟรอบนี้ (ดรอป 2026-09-24) คือ "888PARUAY แทงหวย ตรวจหวย เว็บตรงอันดับ1" —
// แบรนด์นี้เป็น **เว็บหวยล้วน** ไม่มีสล็อต ไม่มีบาคาร่า ไม่มีกีฬา คอปปี้ของแบรนด์
// รอบก่อน (ที่นำด้วย "หวยคาสิโนในเว็บเดียว บาคาร่า ไพ่ สล็อต" และโบนัสแนะนำเพื่อน
// 0.8% / คืนยอดเสีย 0.3%) ถูกเขียนใหม่ทั้งหน้าแล้ว เพราะบรีฟของ
// 888PARUAY ไม่ได้พูดถึงเกมคาสิโนหรือโบนัสเปอร์เซ็นต์ใด ๆ เลย ห้ามใช้
// find-and-replace กับหน้านี้ มันจะทำให้ 888PARUAY อ้างบริการที่บรีฟไม่เคยระบุ
//
// ข้อเท็จจริงทุกบรรทัดมาจากบรีฟรอบนี้เท่านั้น: หวยรัฐบาลไทย · หวยฮานอย ·
// ลาวพัฒนา · หุ้นต่างประเทศ · แต่ละประเภทมีช่วงเวลาเปิดและปิดรับต่างกันตามรอบ ·
// แสดงรอบเปิดรับและข้อมูลผลหวยให้ตรวจสอบได้ · เลือกประเภทหวยและรอบจากหน้าตรวจผล ·
// เลข 2 ตัวอัตราจ่าย 100 · เลข 3 ตัวอัตราจ่าย 1,000 · ตรวจสอบตัวเลข ประเภทหวย
// รอบเวลา และอัตราจ่ายก่อนกดยืนยัน · ระบบจัดหมวดหมู่ชัดเจน · รองรับการใช้งาน
// ผ่านมือถือ · สมัครผ่านมือถือ 3 ขั้นตอน · แอดมินออนไลน์ตลอด 24 ชั่วโมง
// — ห้ามอ้างเลขใบอนุญาต ปีที่ก่อตั้ง เลขทะเบียนบริษัท จำนวนสมาชิก ชื่อค่ายเกม
// อัตราจ่ายอื่นนอกจาก 100/1,000 ขั้นต่ำการเดิมพัน "ฝากถอนไม่มีขั้นต่ำ"
// "ปลอดภัย 100%" หรือการันตีว่าจะถูกรางวัล เพราะบรีฟไม่ได้ระบุไว้
//
// Announcement รอบนี้หมุนมาใช้ Announcement3 ทั้งเว็บ — default message ของ
// ไฟล์นั้นถูกตั้งเป็นคอปปี้ของ 888PARUAY แล้ว จึงเรียกแบบ bare เหมือน index.astro
// ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ 888PARUAY (ทอง + เขียวเข้ม + แดง): พื้น #07130a · การ์ด #0d2312 ·
// การ์ดยก #143a1c · ทองหลัก #fcdc2b · ทองสว่าง #fff6ae · ทองลึก #a87d0c ·
// เขียวสด #1fae1c · เขียวลึก #0c4402 · แดงสด #cf1111 · แดงลึก #8a0303 ·
// เนื้อความ #e8e4c6 (BRAND_TEXT) — พาเลตต์แดง-ทอง-เงินของแบรนด์รอบก่อนถูกถอด
// ออกครบแล้ว ห้ามนำกลับมา
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลางที่ไม่หมุนตามรอบรีแบรนด์ และรอบนี้
// orchestrator เป็นคนรีธีม) — เนื้อความในการ์ดจึงไม่ระบุสีของตัวเองเลย ให้สืบทอด
// สีจากการ์ด มีเพียงปุ่มและหมายเลขลำดับเท่านั้นที่ถือสีของพาเลตต์
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index และ /promotion
// ส่วน banner1/banner1-mobile เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า
// และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กค้างของลูกค้าเจ้าอื่น ห้าม import
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 155
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "เกี่ยวกับ 888PARUAY เว็บแทงหวยและตรวจหวยออนไลน์ในระบบเดียว รองรับรัฐบาลไทย ฮานอย ลาวพัฒนา หุ้นต่างประเทศ พร้อมอัตราจ่ายและรอบเปิดรับที่ตรวจสอบได้ก่อนยืนยัน";

const pageTitle = "เกี่ยวกับเรา 888PARUAY เว็บแทงหวย ตรวจหวยออนไลน์ในระบบเดียว";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        <strong>888PARUAY</strong> คือเว็บที่รวมบริการ<strong>แทงหวยและตรวจหวยออนไลน์ไว้ในระบบเดียว</strong>
        รองรับรายการยอดนิยมทั้งหวยรัฐบาลไทย หวยฮานอย ลาวพัฒนา และหุ้นต่างประเทศ พร้อมแสดงรอบเปิดรับและข้อมูลผลหวยให้ตรวจสอบได้จากหน้าเดียว โดยระบบจัดหมวดหมู่ไว้ชัดเจนและรองรับการใช้งานผ่านมือถือ
      </p>

      <p class="text-left text-base leading-relaxed">
        หน้านี้รวบรวมไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่ประเภทหวยที่เปิดรับในแต่ละรอบ อัตราจ่ายที่ระบบระบุไว้ ขั้นตอนการตรวจผลหวย
        ขั้นตอนการสมัครสำหรับคนที่เพิ่งเข้ามาใช้งานครั้งแรก ไปจนถึงช่องทางสอบถามแอดมินเมื่อไม่แน่ใจในขั้นตอนใด
      </p>

      <p class="text-left text-base leading-relaxed">
        <strong>รอบที่เปิดรับและรายการที่ใช้งานได้อาจเปลี่ยนแปลงตามช่วงเวลา</strong>
        รายละเอียดทั้งหมดจึงยึดตามรอบเวลาและเงื่อนไขที่ระบบแสดงไว้จริงในช่วงนั้นเป็นหลัก และควรตรวจสอบรายการล่าสุดจากหน้าเว็บไซต์ก่อนทำรายการทุกครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="888PARUAY รวมหวยรัฐบาลไทย ฮานอย ลาวพัฒนา และหุ้นต่างประเทศ" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        บริการหลักของ 888PARUAY คือ <strong>รายการหวยหลายประเภทให้เลือกทั้งรัฐบาลไทย หวยฮานอย ลาวพัฒนา และหุ้นต่างประเทศ</strong>
        ผู้ใช้งานสามารถตรวจสอบรอบเปิดรับ เลือกตัวเลข และดูรายละเอียดของแต่ละรายการได้จากหน้าเดียว ไม่ต้องสลับไปเปิดหลายเว็บไซต์เพื่อดูว่ารอบไหนกำลังเปิดรับอยู่
      </p>

      <p class="text-left text-base leading-relaxed">
        <strong>แต่ละประเภทมีช่วงเวลาเปิดและปิดรับแตกต่างกันตามรอบที่ระบบกำหนด</strong>
        การเปิดดูรอบของประเภทที่สนใจไว้ล่วงหน้าจึงช่วยให้วางแผนได้ว่าจะติดตามรายการไหนในแต่ละวัน และไม่พลาดรอบที่ปิดรับเร็วกว่ารายการอื่น
      </p>
    </div>
  </ContentBox>

  <ContentBox title="อัตราจ่ายหวย 888PARUAY เลข 2 ตัวจ่าย 100 และเลข 3 ตัวจ่าย 1,000" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        888PARUAY <strong>แสดงอัตราจ่ายของเลขแต่ละประเภทไว้ให้ตรวจสอบก่อนยืนยันรายการ</strong>
        ทั้งเลข 2 ตัวและเลข 3 ตัว ผู้ใช้งานจึงเช็กตัวเลข รอบหวย และรายละเอียดของบิลได้อย่างเป็นขั้นตอน และเลือกประเภทการแทงให้ตรงกับรูปแบบที่ต้องการได้ตั้งแต่ก่อนกดยืนยัน
      </p>

      <p class="text-left text-base leading-relaxed">
        ตามเงื่อนไขที่ระบบกำหนด <strong>เลข 2 ตัวระบุอัตราจ่ายไว้ที่ 100 และเลข 3 ตัวระบุอัตราจ่ายไว้ที่ 1,000</strong>
        โดยรายละเอียดอาจแตกต่างกันตามประเภทหวยและตามรอบ จึงควรเช็กอัตราจ่ายของรอบที่กำลังเปิดรับอีกครั้งก่อนส่งบิลจริงเสมอ
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/promotion"
          aria-label="ดูภาพอัตราจ่ายหวยของ 888PARUAY"
          class="flex items-center justify-center rounded-lg border border-[#fcdc2b] bg-[#0d2312] px-8 py-3 font-bold transition-all hover:scale-105 hover:border-[#fff6ae] hover:bg-[#143a1c]">
          ดูอัตราจ่ายทั้งหมด
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="ตรวจหวยผ่าน 888PARUAY ได้จากหน้าเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        นอกจากการแทง ระบบยัง<strong>แสดงข้อมูลผลหวยตามรายการที่เว็บไซต์เปิดให้บริการ</strong>
        โดยเลือกประเภทหวยและรอบที่ต้องการได้จากหน้าตรวจผล ช่วยให้ติดตามทั้งรัฐบาลไทย ฮานอย ลาวพัฒนา และรายการอื่นได้จากหน้าเดียว ไม่ต้องไล่หาผลของแต่ละประเภทจากคนละที่
      </p>

      <p class="text-left text-base leading-relaxed">
        เพราะรอบของแต่ละประเภทไม่ตรงกัน <strong>ควรเลือกให้ตรงทั้งประเภทหวยและรอบก่อนอ่านผล</strong>
        โดยเฉพาะเมื่อติดตามหลายรายการในวันเดียวกัน วิธีนี้ช่วยลดการอ่านผลข้ามรอบซึ่งเป็นความผิดพลาดที่เจอบ่อยที่สุดของคนที่เพิ่งเริ่มใช้งาน
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/ตรวจหวย"
          aria-label="เปิดหน้าตรวจหวยของ 888PARUAY"
          class="flex items-center justify-center rounded-lg border border-[#fcdc2b] bg-[#0d2312] px-8 py-3 font-bold transition-all hover:scale-105 hover:border-[#fff6ae] hover:bg-[#143a1c]">
          ไปที่หน้าตรวจหวย
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="สมัครแทงหวย 888PARUAY ผ่านมือถือ 3 ขั้นตอน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        การสมัครแทงหวย 888PARUAY ทำผ่านมือถือได้ด้วยตัวเอง ขั้นตอนถูกจัดไว้ให้เข้าใจง่าย และหลังจากยืนยันบัญชีเรียบร้อยก็สามารถ<strong>เข้าสู่ระบบเพื่อเลือกหวยที่กำลังเปิดรับได้ทันที</strong>
        โดยมี 3 ขั้นตอนหลักดังนี้
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed">
        <li class="flex gap-3">
          <span class="font-bold text-[#fcdc2b]">1.</span>
          <span>เปิดหน้าสมัคร 888PARUAY บนมือถือ แล้วกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#fcdc2b]">2.</span>
          <span>ตรวจสอบข้อมูลส่วนตัวและรายละเอียดบัญชีให้ถูกต้องก่อนกดยืนยัน</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#fcdc2b]">3.</span>
          <span>ยืนยันการสมัครและเข้าสู่ระบบ จากนั้นเลือกรัฐบาลไทย ฮานอย ลาวพัฒนา หรือหุ้นต่างประเทศที่ต้องการได้ทันที</span>
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed">
        <strong>ผลของหวยทุกประเภทตัดสินจากผลรางวัลของรายการนั้น ไม่มีสูตรหรือชุดเลขใดรับประกันผล</strong>
        จึงควรกำหนดงบประมาณก่อนทำรายการทุกครั้ง และหยุดเมื่อถึงขีดที่ตั้งไว้
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก 888PARUAY"
          class="flex items-center justify-center rounded-lg border border-[#fff6ae]/60 bg-gradient-to-r from-[#fff6ae] via-[#fcdc2b] to-[#a87d0c] px-8 py-3 font-black text-[#07130a] shadow-[0_0_15px_rgba(252,220,43,0.50)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ 888PARUAY"
          class="flex items-center justify-center rounded-lg border border-[#fcdc2b] bg-[#0d2312] px-8 py-3 font-bold transition-all hover:scale-105 hover:border-[#fff6ae] hover:bg-[#143a1c]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="แอดมินเว็บ 888PARUAY ออนไลน์ตลอด 24 ชั่วโมง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        หากมีข้อสงสัยเกี่ยวกับการสมัคร รอบหวย อัตราจ่าย การตรวจหวย หรือการใช้งานบัญชี สามารถ
        <strong>ติดต่อแอดมินเว็บ 888PARUAY ได้ตลอด 24 ชั่วโมง</strong>
        ทีมงานพร้อมให้ข้อมูลเกี่ยวกับเมนูและช่วยตรวจสอบปัญหาตามรายละเอียดที่แจ้ง เพื่อให้สมาชิกเข้าถึงข้อมูลที่ต้องการได้สะดวกทุกช่วงเวลา
      </p>

      <p class="text-left text-base leading-relaxed">
        เวลาแจ้งปัญหา การบอกรายละเอียดให้ครบตั้งแต่ครั้งแรกช่วยให้ตรวจสอบได้เร็วขึ้น ทั้ง<strong>ประเภทหวยที่ใช้งานอยู่ รอบเวลาของรายการ อุปกรณ์ที่เปิด และเวลาที่เกิดปัญหา</strong>
        รวมถึงเลขที่บิลหรือรายการที่ต้องการให้ตรวจสอบ หากมีอยู่ในบัญชีแล้ว
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/line"
          aria-label="ติดต่อแอดมิน 888PARUAY ผ่าน Line Official"
