---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login, /register,
// /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx
// ที่ใช้กับ index.astro — บรีฟรอบนี้ (src/assets/content.txt) ไม่มีส่วน SUB-PAGES
// ที่ให้ body มา ทั้งหน้าจึงเขียนขึ้นใหม่จากข้อเท็จจริงและคลังคำของบรีฟรอบนี้เท่านั้น
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x5 · h3x0
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) จึงเปิดใช้งานอยู่
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// ตัวที่ routing จริงคือไฟล์นี้ Astro ไม่อ่านโฟลเดอร์นั้นเลย ห้ามแก้และห้ามลบ
//
// ⚠️ ดรอปนี้ (2026-10-19) คือ **เว็บสล็อตล้วน** ไม่ใช่หมวดอื่นใดทั้งสิ้น
// สองหน้าของหมวดลอตเตอรีที่แบรนด์ก่อนๆ เคยเปิด จอดอยู่ใน src/pages-disabled/
// ไม่มี route ห้ามลิงก์ไปหา เป็น href ตายที่ทำให้ build แดง route ที่มีจริงรอบนี้คือ
// / · /about-us · /contact-us · /login · /register · /privacy · /promotion ·
// /terms · /ทดลองเล่น · /ทางเข้า · /line
//
// ⚠️ แบรนด์ก่อนหน้า (ถอนชัวร์168 ที่ถูกแทนที่รอบนี้) ก็เป็นแบรนด์สล็อตเหมือนกัน
// คอปปี้เดิมจึง "ดูเข้าเค้า" ทั้งที่กรอบของบรีฟคนละอัน — **ห้าม find-and-replace
// ทับประโยคเดิม** ทั้งหน้าถูกเขียนใหม่รอบกรอบของบรีฟรอบนี้ ซึ่งมีแกนเดียวคือ
// **การเป็นเว็บสล็อตทางการ/ฐานเกมหลักที่รวมทุกเมนูไว้ในเว็บไซต์เดียว**
// ไม่ใช่กรอบของรอบก่อน ซึ่งว่าด้วยความง่ายในการถอนเงินและคำรับรองของเว็บไซต์เอง
// ซึ่งถูกถอดออกหมดทั้งไฟล์แล้ว (คำต้องห้ามไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของ
// รอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง — รายการเต็มอยู่ใน
// brand-spec §6)
//
// 🚨 **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกมแม้แต่ค่ายเดียว** จึงห้ามเขียนชื่อค่ายใดๆ
// ลงหน้าเว็บ ให้ใช้คำกลางว่า "ค่ายเกม" ตามบรีฟ
//
// แง่มุมที่บรีฟรอบนี้ระบุไว้มีเท่านี้ (ห้ามเติมอย่างอื่น): เว็บสล็อตทางการ ·
// ผู้ให้บริการฐานเกมหลัก · เว็บแท้อันดับ1 · เว็บแท้100% · เกมสล็อตออนไลน์ ·
// สมัครสมาชิก · เข้าสู่ระบบ · ฝากถอน · โปรโมชั่น · คืนยอดเสีย 0.3% ·
// แนะนำเพื่อน 0.8% · เครดิต · ยอดเสีย · รอบสรุปยอด · รหัสแนะนำ · ค่ายเกม ·
// กติกา · เงื่อนไขบริการ · LINE Official · QR Code · บัญชีที่แอบอ้าง ·
// รหัสผ่าน · รหัส OTP · เจ้าหน้าที่ · นโยบายข้อมูลส่วนบุคคล · คุณสมบัติผู้ใช้งาน ·
// 3 ขั้นตอน · 24ชม.
//
// ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 100% · 3 ขั้นตอน · 24ชม. ·
// อันดับ1 ส่วนตัวเลขและชื่อเฉพาะที่ห้ามแต่งขึ้นเองอยู่ครบใน brand-spec §6
// (เลขใบอนุญาต · ชื่อนิติบุคคล · ชื่อธนาคาร · ค่า RTP · ยอดฝากขั้นต่ำ ·
// จำนวนสมาชิก · ปีก่อตั้ง · ชื่อค่ายเกม)
//
// 🚨 บรีฟรอบนี้ hedge หนักผิดปกติ และ **ประโยค hedge ทุกประโยคต้องขึ้นครบ**
// เป็นเนื้อหาของบรีฟ ไม่ใช่ filler ให้ตัดทิ้ง — และห้ามเขียนเสริมให้กลายเป็น
// คำโฆษณาที่บรีฟกำลังเตือนเรื่องนั้นอยู่:
// 1) ควรตรวจสอบข้อมูลผู้ให้บริการและความน่าเชื่อถือจากหลักฐานที่ตรวจสอบได้
//    ก่อนใช้งาน (h1)
// 2) คำกล่าวอ้างเกี่ยวกับการเป็นเว็บหลักหรือเว็บอันดับหนึ่ง ควรพิจารณาร่วมกับ
//    ข้อมูลผู้ให้บริการ หลักฐานการอนุญาต และความคิดเห็นจากผู้ใช้งานหลายแหล่ง (h2 #1)
// 3) ผู้ใช้งานควรอ่านรายละเอียดก่อนเข้าร่วม และสอบถามเจ้าหน้าที่หากมีข้อสงสัย
//    เพื่อให้เข้าใจสิทธิ์ที่ได้รับตามเงื่อนไขจริง (h2 #3)
// 4) เครดิตคืนยอดเสียไม่ใช่การรับประกันผลตอบแทนจากการเดิมพัน (h2 #3)
// 5) แม้โปรโมชั่นจะระบุว่าไม่จำกัด ก็ควรยืนยันรายละเอียดจากประกาศล่าสุด (h2 #3)
// 6) ควรตรวจสอบเวลาการให้บริการและระยะเวลาตอบกลับล่าสุดอีกครั้ง (h2 #5)
//
// พาเลตต์รอบนี้ (brand-spec §2) เป็น **ฟ้าบับเบิลนำ ทองเป็นฮิวที่สอง น้ำเงินลึก
// ไม่เคยถือตัวอักษร บนดำสนิท** — เปลี่ยนตระกูลสีไปเลยจากรอบก่อนที่ชมพูเป็นตัวนำ
// ⚠️ แบรนด์ก่อนๆ มีทองแทบทุกราย และ TSDET911 เคยเป็นน้ำเงิน "มีทองอยู่" หรือ
// "มีฟ้าอยู่" จึงไม่ใช่ตัวบอกว่าถูกแบรนด์ ให้เทียบเป็น "ค่า" ทีละตัวกับตารางใน
// brand-spec §2 (ค่าเดิมไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ
// false positive) ฟ้ารอบนี้คือ **#2f9ff5** และทองรอบนี้คือ **#ffc82e**
// ลำดับความลึก: #0e2238 ผิวยก (= การ์ด) / #081726 กลาง / #040d16 จม / #000000 พื้นเพจ
//
// ลำดับปุ่มสื่อด้วย "พื้นถมฟ้า vs ผิวจมขอบฟ้า" — คู่พื้น-หมึกคำนวณไว้แล้ว:
// · ปุ่มหลัก (สมัครสมาชิก) ถมไล่เฉด #a8dcff → #2f9ff5 ขอบ #0b3f78 หมึก #04121f
//   (13.9:1 บนปลายฟ้าอ่อน · 6.9:1 บนปลายฟ้าแบรนด์ ผ่าน AA ทั้งเส้น)
// · ปุ่มรอง/ปุ่มลิงก์ภายในเป็นชั้นจม #081726 → #040d16 ขอบ #0b3f78
//   ตัวอักษร #e8f4ff — hover ยกขอบเป็นทอง #ffc82e
// · marker ของลำดับเลขใช้ฟ้าอ่อน #a8dcff (11.6:1 บนผิวการ์ด — เป็นตัวอักษร จึงใช้
//   น้ำเงินลึกไม่ได้ และ #ffc82e สงวนไว้ให้ <strong> เท่านั้น)
// · #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ (§2)
// ⚠️ #0b3f78 · #5c4a16 ห้ามถือตัวอักษรทุกขนาด ใช้ได้แค่เส้นขอบ ออรา เงา และพื้นถม
// — ออราในไฟล์นี้ใช้ rgba(11,63,120,α) · rgba(47,159,245,α) · rgba(255,200,46,α)
// เท่านั้น และรอบนี้ไม่มีชมพู ไม่มีแดง ไม่มีม่วง ไม่มีเขียว (นอกจาก LINE)
// ไม่มีส้ม ไม่มีเงิน/โครเมียม และไม่มีโรสโกลด์
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT #e8f4ff,
// 15.4:1 บนผิวยก #0e2238) ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง
// ปล่อยให้สืบทอดลงมา และไม่ใส่ mx-auto / max-w-* บน <p> เพราะการ์ดคุมความกว้างเองแล้ว
// — ที่ประกาศสีได้มีแค่ปุ่ม (ถมพื้นของตัวเองจึงต้องกำหนดหมึกของตัวเอง) marker ของ
// ลำดับเลข และ <strong> ซึ่ง brand-spec §2 สงวน #ffc82e (11.3:1 บนผิวการ์ด) ไว้เป็น
// สีไฮไลต์ในเนื้อความโดยเฉพาะ และไม่ใช้สีอื่นเลย · แต่ละ <strong> ครอบ "ช่วงที่คั่น
// ด้วยช่องว่าง" ทั้งช่วง เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ
// บรรทัดจะตัดในแท็กและคำจะขาดครึ่ง (ลบแท็ก <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิม)
// และห้ามวาง <strong> สองอันติดกัน
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index กับ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้าง
// จากหน้า และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import
// (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้หมุนมาเป็น Announcement2 ทั้งเว็บ (brand-spec §3 —
// รอบก่อนใช้ Announcement6 จึงหมุนออก) orchestrator ตั้ง default message ของ
// ไฟล์นั้นเป็นคอปปี้ของแบรนด์นี้ไว้แล้ว จึงเรียกแบบ bare ห้ามส่ง prop message
// มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 156 อักขระ
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} เว็บสล็อตทางการ ผู้ให้บริการฐานเกมหลัก รวมเมนูสมัครสมาชิก เข้าสู่ระบบ ฝากถอน และโปรโมชั่นไว้ในเว็บไซต์เดียว พร้อมเงื่อนไขที่ควรศึกษา`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} เว็บสล็อตทางการ ผู้ให้บริการฐานเกมหลัก`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#ffc82e]">{BRAND_NAME} นำเสนอช่องทางสำหรับผู้ที่สนใจเกมสล็อตออนไลน์</strong>
        โดยรวบรวมข้อมูลการสมัครสมาชิก การเข้าสู่ระบบ การฝากถอน และโปรโมชั่นไว้ในเว็บไซต์เดียว หน้านี้สรุปไว้ว่าเว็บไซต์จัดเตรียมอะไรไว้ให้ศึกษาบ้าง เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดดูอะไรตรงไหน แล้วจึงค่อยอ่านเงื่อนไขของแต่ละเรื่องเป็นรายข้อ
      </p>

      <p>
        ผู้ใช้งานสามารถศึกษารายละเอียดของเกมและ
        <strong class="text-[#ffc82e]">เงื่อนไขบริการก่อนเริ่มต้นใช้งาน</strong>
        พร้อมช่องทางติดต่อเจ้าหน้าที่เมื่อมีข้อสงสัย ซึ่งเป็นลำดับที่ช่วยให้ทราบว่าแต่ละรายการต้องใช้ข้อมูลอะไรบ้าง และต้องรอรอบเวลาใดก่อนดำเนินการต่อ
      </p>

      <p>
        เนื้อหาในหน้านี้เขียนไว้ประกอบการศึกษาเท่านั้น ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้งาน
        <strong class="text-[#ffc82e]">ทั้งนี้ ควรตรวจสอบข้อมูลผู้ให้บริการและความน่าเชื่อถือจากหลักฐานที่ตรวจสอบได้ก่อนใช้งาน</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`${BRAND_NAME} ช่องทางเล่นสล็อตเว็บหลัก และสิ่งที่ควรพิจารณาประกอบ`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} เป็นเว็บไซต์ที่นำเสนอช่องทางเข้าใช้งานเกมสล็อตออนไลน์ พร้อม
        <strong class="text-[#ffc82e]">เมนูสำหรับจัดการบัญชีสมาชิกและตรวจสอบรายละเอียดบริการต่าง ๆ</strong>
        ผู้ใช้งานสามารถศึกษารายชื่อค่ายเกม กติกา และเงื่อนไขการทำรายการผ่านช่องทางที่เว็บไซต์จัดเตรียมไว้ได้โดยตรง
      </p>

      <ul class="flex flex-col gap-3" aria-label={`คำกล่าวอ้างที่ ${BRAND_NAME} ระบุไว้ และสิ่งที่ควรตรวจสอบประกอบ`}>
        <li class="flex gap-3">
          <span aria-hidden="true">🛡️</span>
          <span>
            <strong class="text-[#ffc82e]">เว็บสล็อตทางการ</strong> เป็นคำที่เว็บไซต์ใช้เรียกตัวเอง ผู้สนใจจึงควรเปิดอ่านข้อมูลผู้ให้บริการและเงื่อนไขบริการจากหน้าเว็บไซต์ประกอบ ไม่ยึดจากข้อความที่ส่งต่อกันมาเพียงอย่างเดียว
