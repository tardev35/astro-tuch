---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็น **บทความจริง** (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login,
// /register หรือหน้าภาพแบบ /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง
// ไม่ใช่เช็กลิสต์หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้
// (src/assets/content.txt) ไม่มีส่วน SUB-PAGES จึงเขียนทั้งหน้าใหม่จากข้อเท็จจริง
// และคลังคำของบรีฟรอบนี้เท่านั้น (.claude/brand-spec-bohba168.md §4-§5)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x5 · h3x0
//   h1  เกี่ยวกับเรา <แบรนด์> รวมค่ายดังเว็บตรงแตกง่าย เบทต่ำ ไม่ทำเทิร์น
//   h2  โปรโมชั่นของ <แบรนด์> ฝากรับโบนัสได้ทั้งวัน ไม่ต้องทำเทิร์น
//   h2  สิทธิ์คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ที่ <แบรนด์> ระบุไว้
//   h2  สมัครสมาชิกและเข้าสู่ระบบ <แบรนด์> ก่อนเริ่มศึกษารายละเอียดเกม
//   h2  ระบบฝากถอน <แบรนด์> ได้ทุกธนาคารและทรูมันนี่
//   h2  ช่องทางติดต่อแอดมินเว็บ <แบรนด์> ตลอด 24ชม.
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา) และจาก footer จึงเปิดใช้งานอยู่
//
// มีสำเนาชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro (ของแบรนด์เก่ามาก)
// ตัวที่ routing จริงคือไฟล์นี้ Astro ไม่อ่านโฟลเดอร์นั้นเลย **ห้ามแก้ ห้ามลบ
// และห้ามสลับมาแทนไฟล์นี้**
//
// 🚨🚨 แกนของดรอปนี้ (2026-10-24) คือ **เว็บสล็อต** เหมือนรอบก่อน แต่ **คนละ
// คำนิยามตัวเอง** บรีฟรอบนี้เรียกตัวเองว่า "เกมสล็อตสนุกสุดมันส์ รวมค่ายดัง
// เว็บตรงแตกง่าย ใช้ทุนเล่นน้อย เบทต่ำ 1 บาท" และระบุ โบนัสฝากไม่ต้องทำเทิร์น ·
// คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% ไม่จำกัด · ฝากถอนทุกธนาคารและทรูมันนี่ ·
// แอดมิน 24ชม.
// ⚠️⚠️ คำนิยามตัวเองของแบรนด์ขาออกเป็น **คำค้างข้ามแบรนด์** ห้ามหลุดกลับมา
// **รายการคำต้องห้ามเต็มอยู่ใน brand-spec §5 ไม่พิมพ์ซ้ำที่นี่** เพื่อไม่ให้
// sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// ⚠️⚠️ ชื่อแบรนด์รอบนี้เป็น **ภาษาไทยผสมเลข** ห้ามสะกดด้วยตัวละตินที่ไหนทั้งสิ้น
// (brand-spec §1) ทุกจุดต้อง interpolate จาก BRAND_NAME ห้ามพิมพ์ตรงๆ
//
// ⚠️ **รอบนี้สองหน้าหมวดลอตเตอรีถูกปิด** (อยู่ใน src/pages-disabled/)
// **ห้ามลิงก์ไปสอง route นั้นจากหน้านี้**
// route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ทดลองเล่น · /about-us · /contact-us · /terms · /privacy · /line
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกมรายตัว ชื่อธนาคารรายตัว จำนวนเกม จำนวนค่าย
// ตัวเลข RTP อัตราจ่าย ชื่อผู้ให้บริการ หน่วยงานกำกับ เลขใบอนุญาต ปีก่อตั้ง
// จำนวนสมาชิก หรือยอดฝากขั้นต่ำที่เป็นตัวเลขอื่น แม้แต่รายการเดียว** จึงห้ามเขียน
// ลงหน้าเว็บ · ตัวเลขที่ขึ้นหน้าได้มีแค่ของบรีฟเอง: **0.3% · 0.8% · 1 บาท · 24ชม.**
// ⚠️ "ค่า RTP" เอ่ยได้ในฐานะ **สิ่งที่ผู้ใช้ควรตรวจสอบจากผู้พัฒนาเกม** (บรีฟบรรทัด 6)
// แต่ **ห้ามเขียนเป็นตัวเลขเด็ดขาด**
//
// 🚨 **บรีฟรอบนี้โฆษณาแล้วกำกับตัวเองในย่อหน้าเดียวกันแทบทุกย่อหน้า** — ทั้งสอง
// ครึ่งต้อง ship ครบ ประโยคกำกับไม่ใช่ filler ให้ตัดทิ้ง:
// 1) คำกล่าวอ้างว่าแตกง่ายหรือถอนได้ไม่จำกัด ควรพิจารณาจากข้อมูลและเงื่อนไขจริง
//    เพราะเกมสล็อตไม่สามารถรับประกันผลรางวัล และการถอนเงินอาจมีข้อจำกัดตาม
//    ผู้ให้บริการ (h1 + h2 #2)
// 2) ควรตรวจสอบว่าโปรโมชั่นใดได้รับการยกเว้นข้อกำหนดยอดเดิมพัน และมีเงื่อนไข
//    เรื่องจำนวนครั้งที่รับสิทธิ์ วงเงินโบนัสสูงสุด หรือการถอนเงินหรือไม่ (h2 #1)
// 3) เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่ม
//    โอกาสชนะในครั้งต่อไป · แม้ระบุว่าไม่จำกัด แต่ควรยืนยันจำนวนบัญชีที่เข้าร่วม
//    ได้และรอบจ่ายเครดิต (h2 #2)
// 4) การไม่ต้องทำเทิร์นไม่ได้หมายความว่าไม่มีข้อจำกัดทุกประเภท (h2 #1)
// 5) ควรตรวจสอบรายชื่อธนาคารที่รองรับ ยอดขั้นต่ำ และชื่อบัญชีปลายทางให้ตรงกับ
//    ข้อมูลผู้ให้บริการที่ยืนยันได้ · พบชื่อบัญชีไม่ตรงหรือมีการแจ้งเปลี่ยนบัญชี
//    อย่างผิดปกติ ให้หยุดทำรายการและติดต่อธนาคารหรือผู้ให้บริการชำระเงิน (h2 #4)
// 6) ควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยง
//    บัญชีแอบอ้าง · เก็บหมายเลขรายการไว้เป็นหลักฐาน · ไม่เปิดเผยรหัสผ่านหรือ
//    รหัส OTP · ตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุด (h2 #5)
//
// 🚨🚨 พาเลตรอบนี้ (brand-spec §2) **ยังเป็นธีมสว่างเหมือนรอบก่อน แต่คนละฮิว
// สิ้นเชิง** bg.json ของดรอปนี้คือ {"mode":"color","color":"#00bfff"} =
// **ฟ้าสกายอิ่มตัว** (รอบก่อนเป็น ffe5ff = ชมพูพาสเทล)
// **ห้าม "แก้" การ์ด/ปุ่มกลับไปเป็นพื้นมืด** — พื้นมืดบนหมึก #06283f =
// ตัวอักษรหายไปเลย ไม่ใช่แค่จางลง
// ค่าที่ใช้ได้ในไฟล์นี้: หัวข้อ/`<strong>`/marker **#0f5684** (7.8:1 บนการ์ดขาว) ·
// เข้มสุด #06283f (15.2:1) · พื้นไล่เฉดปุ่มหลัก #1a6ea8 -> #0f5684 -> #06283f
// (**พื้นถม** + หมึกขาว #ffffff — 5.5 / 7.8 / 15.2:1 ต่อ stop) · ปุ่มรองเป็น
// #ffffff -> #e4f6fb คู่กับหมึก #06283f · ผิวยก #f0faff · wash #e4f6fb ·
// เส้น #7fcbe8 · เส้นเข้ม #4fb8ea (**ทั้งคู่ห้ามถือตัวอักษร**)
// หมึกเนื้อความคือ #06283f (= BRAND_TEXT) ซึ่ง **ไม่ประกาศในไฟล์นี้** การ์ด
// ContentBox ตั้งไว้ให้แล้วและย่อหน้าสืบทอดลงมา
// 🚨🚨 **#12b4ef บนพื้นขาวได้แค่ 2.4:1 — ห้ามเป็นสีตัวอักษร** และ **ห้ามถมพื้น
// #12b4ef หรือ #00bfff แล้ววางหมึกขาว** (2.4 / 2.1:1) ปุ่มหลักจึงเริ่มไล่เฉดที่
// #1a6ea8 ไม่ใช่ #12b4ef
// ออราที่อนุญาต: rgba(18,180,239,α) · rgba(182,227,240,α) · rgba(15,86,132,α) ·
// rgba(6,40,63,α) · rgba(127,203,232,α)
// ⚠️⚠️ **รอบนี้ไม่มีชมพู ไม่มีแมเจนต้า ไม่มีพลัมเลยสักค่า** (ทั้งชุดคือพาเลตของ
// แบรนด์ขาออก) · ไม่มีทอง/เหลือง ไม่มีแดง ไม่มีม่วง ไม่มีครีม/เบจ/น้ำตาล
// ไม่มีเทาเงิน ยกเว้น **LINE green #00B900** บนปุ่ม LINE ซึ่งเป็นสีประจำแพลตฟอร์ม
// ⚠️⚠️ **รอบนี้เป็นแบรนด์ฟ้าจริง จึงห้ามเทียบด้วยวงศ์สี** ต้องเทียบ **ทีละค่า**
// กับตาราง brand-spec §2 (18a5e2 ของอีกแบรนด์ห่างจาก #12b4ef แค่ R6/G15/B13 ·
// 063a57 มี R=06 ตรงกับ #06283f เป๊ะ · 07335f ใกล้ #06283f ที่ R ·
// 0a4ea8 ใกล้ #0b4a73 ที่ G — เจอที่ไหนแปลว่าพิมพ์ผิด)
// ⚠️ เสื้อคลุมถักฟ้าอ่อน พื้นสตูดิโอขาว ดาวเหลือง เหรียญทอง และสีผิวนักแสดงใน
// อาร์ตเวิร์กเป็น **วัตถุในภาพ ไม่ใช่สี UI**
//
// ลำดับปุ่มในไฟล์นี้สื่อด้วยพื้นถมสามขั้ว (ตรงกับคู่ปุ่มที่ล็อกไว้ใน brand-spec §2):
// · ปุ่มหลัก (สมัครสมาชิก) ไล่เฉด #1a6ea8 -> #0f5684 -> #06283f หมึกขาว #ffffff
// · ปุ่มรอง (เข้าสู่ระบบ) ไล่เฉดผิวสว่าง #ffffff -> #e4f6fb หมึกน้ำเงินเข้ม #06283f
// · ปุ่มลิงก์ภายในเป็นปุ่ม outline ขอบ #4fb8ea ตัวอักษร #0f5684 บนการ์ดขาว
//   hover ยกพื้นขึ้นเป็นผิวยก #f0faff
// · ชิปไอคอนของรายการใช้ขอบ #7fcbe8 บน wash #e4f6fb ไม่ถือตัวอักษร
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความไว้ที่ตัวการ์ดแล้ว
// ย่อหน้าในหน้านี้จึงไม่ประกาศสีของตัวเอง และไม่ใส่ mx-auto / max-w-* บน <p>
// เพราะการ์ดคุมความกว้างเองแล้ว — ที่ประกาศสีได้มีแค่ปุ่ม ชิปไอคอน marker ของ
// ลำดับเลข และ <strong> · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง
// เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำ
// จะขาดครึ่ง (ลบแท็ก <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิม) และห้ามวาง
// <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังใน prop ที่เป็นข้อความ และต้องเป็นไอคอนหมวดสล็อต ไม่ใช่ไอคอนหมวดลอตเตอรี
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: รูปของดรอปนี้ถูกตรึงไว้ที่อื่นครบทุกไฟล์ —
// slide1/slide2 ถูกตรึงไว้กับ index §4 ข้อ 4-5 กับ /promotion · banner1 /
// banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// banner2/banner3 และ slide3/slide4 เป็นอาร์ตเวิร์กของแบรนด์อื่น
// **ห้าม import ทั้งสี่ไฟล์** (ลำพังการ import ก็ทำให้ไฟล์ถูก emit ลง dist/
// และ verify-build จะแดง) — ไฟล์ทั้งหมดยังอยู่บนดิสก์ **ห้ามลบ** เป็นอินเวนทอรี
// ของแบรนด์ถัดไป
//
// Announcement รอบนี้หมุนมาเป็น Announcement ตัวฐานทั้งเว็บ (brand-spec §3 —
// รอบก่อนใช้ Announcement4 จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์นั้น
// เป็นคอปปี้ของแบรนด์นี้แล้ว จึงเรียกแบบ bare **ห้ามส่ง prop message** มิฉะนั้น
// ตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -c บนเชลล์นี้
// ก็นับเป็นไบต์ ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับตัวนับ
// ของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 158 อักขระ (ชื่อแบรนด์รอบนี้ 10 อักขระ) เป็นประโยคเดียวที่บอกว่า
// หน้านี้มีอะไร แล้วหยุด
// (Google ตัดราว 160 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนๆ ยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} รวมข้อมูลเกมสล็อตจากค่ายต่าง ๆ โปรโมชั่นฝากรับโบนัสไม่ต้องทำเทิร์น คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% และระบบฝากถอนทุกธนาคารและทรูมันนี่`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} รวมค่ายดังเว็บตรงแตกง่าย เบทต่ำ ไม่ทำเทิร์น`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

// คลาสปุ่มสามขั้วของหน้านี้ ประกาศครั้งเดียวแล้วใช้ซ้ำ เพื่อไม่ให้สองปุ่มที่ทำ
// หน้าที่เดียวกันหลุดไปคนละเฉดตอนรีแบรนด์รอบหน้า
const ctaPrimary =
  "flex items-center justify-center rounded-full border border-[#06283f] bg-gradient-to-b from-[#1a6ea8] via-[#0f5684] to-[#06283f] px-8 py-3 font-black text-white shadow-[0_6px_18px_rgba(15,86,132,0.3)] transition-transform hover:scale-105";

const ctaSecondary =
  "flex items-center justify-center rounded-full border border-[#4fb8ea] bg-gradient-to-b from-[#ffffff] to-[#e4f6fb] px-8 py-3 font-bold text-[#06283f] shadow-[0_6px_18px_rgba(127,203,232,0.35)] transition-transform hover:scale-105";

const ctaQuiet =
  "flex items-center justify-center rounded-full border-2 border-[#4fb8ea] bg-[#ffffff] px-8 py-3 font-bold text-[#0f5684] shadow-[0_4px_14px_rgba(18,180,239,0.2)] transition-all hover:scale-105 hover:bg-[#f0faff] hover:shadow-[0_6px_18px_rgba(15,86,132,0.2)]";

const listChip = "mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#7fcbe8] bg-[#e4f6fb] text-sm";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#0f5684]">{BRAND_NAME} นำเสนอเกมสล็อตออนไลน์หลากหลายรูปแบบ ทั้งเกมคลาสสิก เกมโบนัส และเกมสล็อตจากค่ายต่าง ๆ รวบรวมไว้ในเว็บไซต์เดียว</strong>
        หน้านี้สรุปไว้ว่าเว็บไซต์ระบุอะไรไว้บ้าง และควรเปิดอ่านรายละเอียดส่วนไหนก่อน เพื่อให้เห็นภาพรวมก่อนไล่อ่านเงื่อนไขของแต่ละรายการเป็นรายข้อ
      </p>

      <p>
        ข้อมูลที่ระบุไว้มีทั้งเกมที่กำหนดการเดิมพันเริ่มต้น 1 บาทสำหรับผู้ที่ต้องการศึกษารูปแบบเกมด้วยงบประมาณจำกัด รายละเอียดโปรโมชั่น ระบบฝากถอน และช่องทางติดต่อเจ้าหน้าที่
        <strong class="text-[#0f5684]">โดยควรตรวจสอบยอดเดิมพันขั้นต่ำ ตารางจ่ายรางวัล และค่า RTP จากผู้พัฒนาเกมก่อนใช้งาน</strong>
        เพราะเกมแต่ละประเภทกำหนดระดับการเดิมพันไว้คนละชุด การเทียบจากเกมอื่นที่เคยเปิดไว้ก่อนหน้าจึงไม่ตรงกับเงื่อนไขที่มีผลอยู่จริง
      </p>

      <p>
        สิ่งที่หน้านี้ทำได้คือชี้ว่าข้อมูลแต่ละชุดอยู่ตรงไหนและควรอ่านอะไรก่อน ส่วนคำกล่าวอ้างว่าแตกง่ายหรือถอนได้ไม่จำกัด
        <strong class="text-[#0f5684]">ควรพิจารณาจากข้อมูลและเงื่อนไขจริง เพราะเกมสล็อตไม่สามารถรับประกันผลรางวัล และการถอนเงินอาจมีข้อจำกัดตามผู้ให้บริการ</strong>
        เนื้อหาในหน้านี้จึงเขียนไว้ประกอบการใช้งานเท่านั้น ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้บริการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`โปรโมชั่นของ ${BRAND_NAME} ฝากรับโบนัสได้ทั้งวัน ไม่ต้องทำเทิร์น`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#0f5684]">{BRAND_NAME} นำเสนอข้อมูลโปรโมชั่นที่ระบุว่าสามารถรับโบนัสจากการฝากเงินได้ตลอดวันโดยไม่ต้องทำเทิร์น</strong>
        รายการด้านล่างคือสิ่งที่ควรเปิดอ่านก่อนเข้าร่วม เพราะเป็นเงื่อนไขที่ตรวจสอบได้จากประกาศของผู้ให้บริการ ไม่ใช่จากตัวข้อความโฆษณาเอง
      </p>

      <ul class="flex flex-col gap-4" aria-label="สิ่งที่ควรตรวจสอบก่อนรับโบนัสฝาก">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎁</span>
          <span>
            <strong class="text-[#0f5684]">โปรโมชั่นใดได้รับการยกเว้นข้อกำหนดยอดเดิมพัน</strong> ควรตรวจสอบก่อนเข้าร่วมทุกครั้ง เพราะข้อความว่าไม่ต้องทำเทิร์นอาจใช้กับบางรายการเท่านั้น
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>📑</span>
          <span>
            <strong class="text-[#0f5684]">จำนวนครั้งที่รับสิทธิ์ วงเงินโบนัสสูงสุด และเงื่อนไขการถอนเงิน</strong> ควรอ่านให้ครบว่ามีกำหนดไว้หรือไม่ เพราะการไม่ต้องทำเทิร์นไม่ได้หมายความว่าไม่มีข้อจำกัดทุกประเภท
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🎰</span>
          <span>
            <strong class="text-[#0f5684]">หลักเกณฑ์ของแต่ละรายการที่อาจแตกต่างกัน</strong> ทั้งโปรฝาก คืนยอดเสีย และแนะนำเพื่อน จึงควรอ่านรายละเอียดล่าสุดของรายการนั้นให้ครบถ้วนก่อนกดรับสิทธิ์
          </span>
        </li>
      </ul>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/promotion" aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`} class={ctaQuiet}>ดูภาพโปรโมชั่น</a>

        <a href="/ทดลองเล่น" aria-label={`เปิดหน้าทดลองเล่นของ ${BRAND_NAME}`} class={ctaQuiet}>ไปหน้าทดลองเล่น</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`สิทธิ์คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ที่ ${BRAND_NAME} ระบุไว้`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} ระบุรายการสำหรับสมาชิกที่ต้องการศึกษาสิทธิ์จากการใช้บริการไว้สองรายการหลัก คือ
        <strong class="text-[#0f5684]">คืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน และแนะนำเพื่อนรับโบนัส 0.8% ไม่จำกัด</strong>
        ซึ่งแต่ละรายการอาจกำหนดประเภทเกมที่เข้าร่วม ยอดที่นำมาคำนวณ รอบเวลารับเครดิต และเงื่อนไขการถอนเงินไว้คนละแบบ จึงควรตรวจสอบประกาศล่าสุดก่อนเข้าร่วม
      </p>

      <p>
        รายการคืนยอดเสียระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขรายวัน
        <strong class="text-[#0f5684]">สมาชิกควรตรวจสอบว่าเกมสล็อตประเภทใดเข้าร่วมรายการ มีรอบสรุปยอดเวลาใด และต้องกดรับเครดิตด้วยตนเองหรือระบบดำเนินการให้อัตโนมัติ</strong>
        รวมถึงศึกษาข้อกำหนดการใช้เครดิตและการถอนเงินให้ครบถ้วน เพราะยอดเสียบางรายการอาจไม่เข้าเกณฑ์รับสิทธิ์ ทั้งนี้ เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งต่อไป
      </p>

      <p>
        ส่วนรายการแนะนำเพื่อนระบุสิทธิ์ไว้สำหรับสมาชิกที่แนะนำผู้ใช้งานรายใหม่ โดยควรตรวจสอบวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และฐานยอดที่ใช้คำนวณโบนัสให้ชัดเจน
        <strong class="text-[#0f5684]">แม้จะมีข้อความว่าไม่จำกัด แต่ควรยืนยันจำนวนบัญชีที่เข้าร่วมได้ รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุด</strong>
        เพื่อป้องกันความเข้าใจคลาดเคลื่อนเกี่ยวกับจำนวนเครดิตที่มีสิทธิ์ได้รับ
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`สมัครสมาชิกและเข้าสู่ระบบ ${BRAND_NAME} ก่อนเริ่มศึกษารายละเอียดเกม`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#0f5684]">{BRAND_NAME} มีช่องทางสำหรับผู้ที่ต้องการศึกษาวิธีสมัครสมาชิกและเข้าสู่ระบบเกมสล็อตออนไลน์</strong>
        โดยลำดับการใช้งานทั่วไปเรียงไว้ด้านล่าง ก่อนดำเนินการควรตรวจสอบคุณสมบัติผู้สมัคร ข้อกำหนดด้านอายุ และกฎหมายที่เกี่ยวข้อง รวมถึงศึกษานโยบายความเป็นส่วนตัวเพื่อทำความเข้าใจวิธีจัดเก็บข้อมูลส่วนบุคคล
      </p>

      <ol class="ml-6 list-decimal space-y-3 marker:font-black marker:text-[#0f5684]">
        <li>
          <strong class="text-[#0f5684]">เข้าสู่หน้าสมัครสมาชิก</strong> ตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง จากนั้นเลือกเมนูสมัครสมาชิกและอ่านเงื่อนไขการเปิดบัญชี รวมถึงนโยบายการจัดเก็บข้อมูลส่วนบุคคลก่อนกรอกข้อมูล
        </li>
        <li>
          <strong class="text-[#0f5684]">กรอกข้อมูลและยืนยันบัญชี</strong> กรอกข้อมูลตามที่ระบบกำหนด ตรวจสอบความถูกต้องก่อนยืนยัน และตั้งรหัสผ่านที่คาดเดาได้ยาก ไม่ควรใช้ข้อมูลของบุคคลอื่นหรือเปิดเผยรหัส
          OTP ให้ใครทราบ
        </li>
        <li>
          <strong class="text-[#0f5684]">เข้าสู่ระบบและตรวจสอบรายละเอียดเกม</strong> หลังลงทะเบียนเรียบร้อย สามารถศึกษารายชื่อเกมสล็อต กติกาการเล่น ยอดเดิมพันขั้นต่ำ และรายละเอียดโปรโมชั่นที่เปิดให้บริการ
          หากมีข้อสงสัยควรสอบถามเจ้าหน้าที่ผ่านช่องทางทางการก่อนทำรายการ
        </li>
      </ol>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/register" aria-label={`สมัครสมาชิก ${BRAND_NAME}`} class={ctaPrimary}>สมัครสมาชิก</a>

        <a href="/login" aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`} class={ctaSecondary}>เข้าสู่ระบบ</a>

        <a href="/ทางเข้า" aria-label={`เปิดหน้าทางเข้าของ ${BRAND_NAME}`} class={ctaQuiet}>ไปหน้าทางเข้า</a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`ระบบฝากถอน ${BRAND_NAME} ได้ทุกธนาคารและทรูมันนี่`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#0f5684]">{BRAND_NAME} ระบุช่องทางฝากถอนผ่านธนาคารและทรูมันนี่</strong>
        เพื่อให้สมาชิกตรวจสอบวิธีทำรายการตามบริการที่เปิดใช้งานจริง รายการด้านล่างคือสิ่งที่ควรเปิดอ่านก่อนทำรายการครั้งแรก และควรตรวจซ้ำทุกครั้งที่กลับเข้ามาใหม่
      </p>

      <ul class="flex flex-col gap-4" aria-label="สิ่งที่ควรตรวจสอบก่อนฝากถอน">
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>💳</span>
          <span>
            <strong class="text-[#0f5684]">รายชื่อธนาคารที่รองรับและยอดขั้นต่ำของแต่ละช่องทาง</strong> ควรตรวจสอบก่อนฝากเงิน พร้อมศึกษาระยะเวลาดำเนินการและข้อกำหนดการถอนเงินให้ครบถ้วน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🪪</span>
          <span>
            <strong class="text-[#0f5684]">ขั้นตอนการยืนยันตัวตน</strong> ควรอ่านให้ครบก่อนเริ่มทำรายการ เพราะรายการบางประเภทอาจต้องผ่านการตรวจสอบเพิ่มเติมก่อนระบบดำเนินการให้
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class={listChip}>🏦</span>
          <span>
            <strong class="text-[#0f5684]">ชื่อบัญชีปลายทาง</strong> ควรตรวจสอบให้ตรงกับข้อมูลผู้ให้บริการที่ยืนยันได้ก่อนโอนเงิน เพราะนี่คือจุดที่แยกการทำรายการตามปกติออกจากบัญชีแอบอ้างได้เร็วที่สุด
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#0f5684]">หากพบชื่อบัญชีไม่ตรงกับข้อมูลทางการหรือมีการแจ้งเปลี่ยนบัญชีอย่างผิดปกติ ควรหยุดทำรายการและติดต่อธนาคารหรือผู้ให้บริการชำระเงินเพื่อตรวจสอบก่อนโอนเงิน</strong>
        แล้วค่อยกลับมาทำรายการใหม่เมื่อตรวจสอบข้อมูลปลายทางได้ครบถ้วน เพราะการหยุดก่อนโอนคือจุดที่ยังแก้ไขได้ง่ายที่สุดของทั้งกระบวนการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`ช่องทางติดต่อแอดมินเว็บ ${BRAND_NAME} ตลอด 24ชม.`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} ระบุช่องทางติดต่อเจ้าหน้าที่สำหรับผู้ใช้งานที่ต้องการสอบถามเกี่ยวกับรายชื่อเกมสล็อต การเข้าสู่ระบบ รายการฝากถอน และรายละเอียดโปรโมชั่น โดยเฉพาะเงื่อนไขโบนัสไม่ต้องทำเทิร์นและวิธีรับเครดิตคืนยอดเสีย
        <strong class="text-[#0f5684]">ผู้ใช้งานควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง</strong>
      </p>

      <p>
        หากพบปัญหาเกี่ยวกับธุรกรรม ควรเก็บหมายเลขรายการและหลักฐานที่เกี่ยวข้องไว้สำหรับตรวจสอบ พร้อมแจ้งรายละเอียดปัญหาให้ชัดเจน
        <strong class="text-[#0f5684]">โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น</strong>
        ทั้งนี้ ควรตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุดอีกครั้ง เพราะช่วงเวลาที่เจ้าหน้าที่รับเรื่องและระยะเวลาตอบกลับของแต่ละช่องทางอาจไม่เท่ากัน
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/line"
          aria-label={`ติดต่อเจ้าหน้าที่ ${BRAND_NAME} ผ่าน Line Official`}
          class="flex items-center justify-center gap-2 rounded-full border border-[#00B900] bg-[#00B900] px-8 py-3 font-black text-white shadow-[0_0_15px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
          <span aria-hidden="true">💬</span>
          ติดต่อผ่าน Line Official
        </a>

