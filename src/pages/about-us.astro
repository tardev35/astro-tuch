---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่ม) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง
// ไม่ได้มาจากเช็กลิสต์หัวข้อของ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน
// SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริงของ SAGAME66 เท่านั้น
//
// บรีฟรอบนี้ (ดรอป 2026-09-23) คือ "SAGAME66 เว็บบาคาร่า รูเล็ต คาสิโน รวมครบ
// ทุกค่ายแท้" — แบรนด์นี้เป็นคาสิโนสด/เกมโต๊ะ ไม่ใช่เว็บกีฬาและไม่ใช่เว็บหวย
// คอปปี้ของแบรนด์รอบก่อน (เว็บ "กีฬาคาสิโนเว็บตรง" ที่อ้างเดิมพันกีฬา สล็อต
// และ "เครือตรงแบรนด์ลิขสิทธิ์แท้ ไม่ผ่านเอเย่นต์") ถูกเขียนใหม่ทั้งหน้าแล้ว
// เพราะบรีฟของ SAGAME66 ไม่ได้ระบุสิ่งเหล่านั้นเลย ห้ามใช้ find-and-replace
// กับหน้านี้ มันจะทำให้ SAGAME66 อ้างเกมและข้อความที่บรีฟไม่เคยพูดถึง
//
// ข้อเท็จจริงทุกบรรทัดมาจากบรีฟรอบนี้เท่านั้น: บาคาร่า · รูเล็ต · คาสิโนสด ·
// เกมโต๊ะยอดนิยมและเกมเดิมพันประเภทอื่นตามรายการที่เปิดให้บริการ · หลายค่าย
// ในระบบเดียว · ค่ายมาตรฐานสากลปี 2026 · เมนูจัดหมวดหมู่ชัดเจน ค้นหาเกมง่าย ·
// ตรวจสอบชื่อค่าย รายละเอียดเกม และระดับเดิมพันก่อนเข้าเล่นได้ · รองรับทั้ง
// มือถือและคอมพิวเตอร์ · โปรโมชั่นหลายรูปแบบ บางรายการกดรับหลังสมัครได้โดย
// ไม่ต้องฝากก่อน · โบนัสแนะนำเพื่อน 0.8% · โบนัสคืนยอดเสีย 0.3% · สมัครผ่าน
// มือถือ 3 ขั้นตอน · แอดมินดูแลตลอด 24 ชั่วโมง
// — ห้ามอ้างเลขใบอนุญาต ปีที่ก่อตั้ง เลขทะเบียนบริษัท จำนวนสมาชิก ชื่อค่ายเกม
// ค่า RTP อัตราจ่าย ขั้นต่ำการเดิมพัน "ฝากถอนออโต้ไม่มีขั้นต่ำ" "ปลอดภัย 100%"
// "เร็วที่สุด/ปลอดภัยที่สุดในไทย" หรือการันตีว่าจะชนะ เพราะบรีฟไม่ได้ระบุไว้
// และห้ามเขียนคำไทยที่แปลว่าลอตเตอรีที่ใดในหน้านี้ — SAGAME66 ไม่ใช่เว็บหวย
//
// Announcement รอบนี้หมุนมาใช้ Announcement5 ทั้งเว็บ — default message ของไฟล์นั้น
// เป็นคอปปี้ของ SAGAME66 อยู่แล้ว จึงเรียกแบบ bare เหมือน index.astro
// ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ SAGAME66 (ทอง + เงินโครเมียม บนน้ำตาลเกือบดำ แทนแดงคริมสัน-เงินของรอบก่อน):
// พื้นเกือบดำ #0d0903 · การ์ด #171006 · การ์ดยก #2a1d0b · ทองลึก #96671a ·
// ทองหลัก #e8b93f · ทองสว่าง #ffe9a3 · เงินโครเมียม #eef3f8 ใช้กับชื่อแบรนด์และ
// ข้อความเน้น · เงินกลาง #b6c1cd · เนื้อความ #e3d8c0 (BRAND_TEXT) · ตัวอักษรบน
// ปุ่มไล่สีทองใช้สีพื้น #0d0903 เพื่อให้อ่านออก · ตัวเลขโบนัส 0.8%/0.3% ใช้
// ทองสว่าง #ffe9a3 — โทนแดงคริมสันและเงินเย็นของแบรนด์รอบก่อนถูกถอดออกหมดแล้ว
// ห้ามนำกลับมา
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index และ /promotion
// ส่วน banner1/banner1-mobile เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า
// และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กค้างของลูกค้าเจ้าอื่น ห้าม import
//
// ห้ามลิงก์ไปสองหน้าลอตเตอรีที่ถูกพักไว้ใน src/pages-disabled/ เด็ดขาด
// การลิงก์ไปเส้นทางที่ไม่มีจริงทำให้ verify-build แดง
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 155
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "เกี่ยวกับ SAGAME66 เว็บบาคาร่า รูเล็ต คาสิโน แหล่งรวมเกมเดิมพันจากค่ายมาตรฐานสากล พร้อมโปรโมชั่นแนะนำเพื่อนและคืนยอดเสีย และแอดมินดูแลสมาชิกตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับเรา SAGAME66 เว็บบาคาร่า รูเล็ต คาสิโน รวมครบทุกค่ายแท้",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา SAGAME66 เว็บบาคาร่า รูเล็ต คาสิโน รวมครบทุกค่ายแท้" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับเรา SAGAME66 เว็บบาคาร่า รูเล็ต คาสิโน รวมครบทุกค่ายแท้" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e3d8c0]">
        <strong class="text-[#eef3f8]">SAGAME66</strong> คือเว็บรวมเกมคาสิโนที่
        <strong class="text-[#eef3f8]">มีทั้งบาคาร่า รูเล็ต และเกมโต๊ะยอดนิยมจากหลายค่ายให้เลือกในระบบเดียว</strong>
        รองรับการใช้งานผ่านมือถือและคอมพิวเตอร์ เมนูจัดหมวดหมู่ไว้ชัดเจน ช่วยให้ผู้ใช้งานค้นหาเกมที่ต้องการได้ง่าย พร้อมตัวเลือกการเดิมพันหลายระดับตามเงื่อนไขของแต่ละเกม
      </p>

      <p class="text-left text-base leading-relaxed text-[#e3d8c0]">
        หน้านี้รวบรวมไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่หมวดเกมที่เลือกได้จากหน้าเดียว รายการโปรโมชั่นที่สมาชิกตรวจสอบเงื่อนไขก่อนกดรับได้ ขั้นตอนการสมัครสำหรับคนที่เพิ่งเข้ามาใช้งานครั้งแรก
        ไปจนถึงช่องทางสอบถามแอดมินเมื่อไม่แน่ใจในขั้นตอนใด
      </p>

      <p class="text-left text-base leading-relaxed text-[#e3d8c0]">
        <strong class="text-[#eef3f8]">รายการเกมและสิทธิ์ที่เปิดให้ใช้งานอาจมีการอัปเดตตามช่วงเวลา</strong>
        รายละเอียดทั้งหมดจึงยึดตามหมวดหมู่และเงื่อนไขที่ระบบแสดงไว้จริงในช่วงนั้นเป็นหลัก และควรตรวจสอบรายการล่าสุดจากหน้าเว็บไซต์ก่อนเข้าเล่นทุกครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="SAGAME66 รวมบาคาร่า รูเล็ต และคาสิโนสด ไว้ให้เลือกจากระบบเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e3d8c0]">
        ภายในระบบของ SAGAME66 <strong class="text-[#eef3f8]">รวมเกมเดิมพันหลายหมวดให้เลือกจากหน้าเดียว ทั้งบาคาร่า รูเล็ต คาสิโนสด และเกมประเภทอื่นตามรายการที่เปิดให้บริการ</strong>
        สมาชิกจึงเลือกหมวดที่สนใจได้จากเมนูเกม และสลับไปดูอีกหมวดได้จากจุดเดียวกัน โดยไม่ต้องสมัครแยกหรือเปลี่ยนไปใช้หลายเว็บไซต์
      </p>

      <p class="text-left text-base leading-relaxed text-[#e3d8c0]">
        แต่ละเกมมี <strong class="text-[#eef3f8]">ตัวเลือกการเดิมพันหลายระดับตามเงื่อนไขของเกมนั้น</strong>
        สมาชิกจึงเลือกระดับที่เหมาะกับรูปแบบการใช้งานของตัวเองได้ก่อนเข้าเล่น โดยรายการที่เปิดให้บริการจะแสดงไว้ตามที่ระบบกำหนดในช่วงเวลานั้น
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ค่ายมาตรฐานสากลปี 2026 กับเมนูที่จัดหมวดหมู่ให้ค้นหาเกมได้ง่าย" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e3d8c0]">
        SAGAME66 <strong class="text-[#eef3f8]">รวมเกมเดิมพันจากหลายค่ายที่มีรูปแบบการเล่นแตกต่างกันภายในปี 2026</strong>
        ทั้งบาคาร่า รูเล็ต คาสิโนสด และเกมยอดนิยมอื่น ๆ ระบบจัดหน้าเกมไว้ให้ค้นหาได้ง่าย จึงไม่ต้องไล่เปิดทีละหน้าเพื่อหาเกมที่ต้องการ
      </p>

      <p class="text-left text-base leading-relaxed text-[#e3d8c0]">
        ก่อนเข้าเล่น <strong class="text-[#eef3f8]">สามารถตรวจสอบชื่อค่าย รายละเอียดเกม และระดับเดิมพันได้จากหน้าเว็บไซต์</strong>
        ช่วยให้เลือกเกมที่ตรงกับสไตล์ของตัวเองได้สะดวกขึ้น และเปิดหมวดเดียวกันจากคนละอุปกรณ์ก็เห็นโครงหน้าแบบเดียวกัน เพราะบัญชีเดียวใช้ได้ทั้งบนมือถือและคอมพิวเตอร์
      </p>
    </div>
  </ContentBox>

  <ContentBox title="โปรโมชั่น SAGAME66 แนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e3d8c0]">
        โปรโมชั่นของ SAGAME66 <strong class="text-[#eef3f8]">มีสิทธิ์ให้สมาชิกเลือกหลายรูปแบบตามเงื่อนไขของแต่ละรายการ</strong>
        โดยบางโปรโมชั่นสามารถตรวจสอบและกดรับหลังสมัครได้โดยไม่ต้องทำรายการฝากก่อนตามที่ระบบกำหนด แต่ละรายการมีรายละเอียดของตัวเองให้อ่านก่อนรับสิทธิ์ จึงเลือกเฉพาะรายการที่ตรงกับการใช้งานของตัวเองได้
      </p>

      <p class="text-left text-base leading-relaxed text-[#e3d8c0]">
        สมาชิกที่แนะนำเพื่อนเข้ามาสมัครสามารถรับ<strong class="text-[#ffe9a3]">โบนัสแนะนำเพื่อน 0.8%</strong>
        ตามเงื่อนไขของโปรโมชั่น ระบบจะแสดงรายละเอียดของยอดที่เข้าเกณฑ์และขั้นตอนรับสิทธิ์ให้ตรวจสอบ ช่วยให้ติดตามโบนัสจากกิจกรรมแนะนำเพื่อนได้สะดวกผ่านบัญชีสมาชิกโดยตรง
      </p>

      <p class="text-left text-base leading-relaxed text-[#e3d8c0]">
        ส่วนโปรโมชั่นคืนยอดเสียให้<strong class="text-[#ffe9a3]">โบนัส 0.3%</strong> ตามยอดและเงื่อนไขที่กำหนด สมาชิกสามารถตรวจสอบรอบคำนวณ ยอดที่เข้าเกณฑ์ และรายละเอียดก่อนกดรับสิทธิ์ได้จากหน้าโปรโมชั่น
        จึงติดตามโบนัสในแต่ละรอบได้ชัดเจนและจัดการสิทธิ์ของตัวเองได้ง่ายขึ้น
      </p>
    </div>
  </ContentBox>

  <ContentBox title="สมัคร SAGAME66 ด้วยตัวเองผ่านมือถือ 3 ขั้นตอน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e3d8c0]">
        การสมัคร SAGAME66 ทำผ่านมือถือได้ด้วยตัวเอง ขั้นตอนถูกจัดไว้ให้เข้าใจง่ายและใช้เวลาไม่นาน หลังยืนยันบัญชีเรียบร้อยก็สามารถ<strong class="text-[#eef3f8]">
          เข้าสู่ระบบเพื่อเลือกบาคาร่า รูเล็ต หรือคาสิโนที่ต้องการได้ทันที
        </strong>
        โดยมี 3 ขั้นตอนหลักดังนี้
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#e3d8c0]">
        <li class="flex gap-3">
          <span class="font-bold text-[#e8b93f]">1.</span>
          <span>เปิดหน้าสมัคร SAGAME66 บนมือถือ แล้วกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#e8b93f]">2.</span>
          <span>ตรวจสอบข้อมูลและรายละเอียดบัญชีให้ถูกต้องก่อนกดยืนยัน</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#e8b93f]">3.</span>
          <span>ยืนยันการสมัครและเข้าสู่ระบบ จากนั้นเลือกบาคาร่า รูเล็ต คาสิโน หรือเกมที่ต้องการได้ทันที</span>
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#e3d8c0]">
        <strong class="text-[#eef3f8]">ผลของเกมเดิมพันทุกประเภทตัดสินจากระบบของเกมนั้น ไม่มีสูตรหรือช่วงเวลาใดรับประกันผล</strong>
        จึงควรกำหนดงบประมาณก่อนเข้าเล่นทุกครั้ง และหยุดเมื่อถึงขีดที่ตั้งไว้
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก SAGAME66"
          class="flex items-center justify-center rounded-lg border border-[#ffe9a3]/60 bg-gradient-to-r from-[#ffe9a3] via-[#e8b93f] to-[#96671a] px-8 py-3 font-black text-[#0d0903] shadow-[0_0_15px_rgba(232,185,63,0.50)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ SAGAME66"
          class="flex items-center justify-center rounded-lg border border-[#e8b93f] bg-[#171006] px-8 py-3 font-bold text-[#e3d8c0] transition-all hover:scale-105 hover:border-[#ffe9a3] hover:bg-[#2a1d0b] hover:text-[#eef3f8]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBox>

