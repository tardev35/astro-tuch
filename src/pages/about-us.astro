---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่ม) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง
// ไม่ได้มาจากเช็กลิสต์หัวข้อของ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน
// SUB-PAGES ที่ให้ body จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริงของ BRAZIL999 เท่านั้น
//
// รอบนี้ (ดรอป 2026-09-25) คือ BRAZIL999 **คาสิโนออนไลน์ที่เชื่อมต่อจากบริษัทโดยตรง**
// จุดขายของบรีฟคือ "เว็บนี้ไม่มีประวัติโกง ตรวจสอบได้" กับการรวมเกมหลายประเภทไว้ใน
// บัญชีเดียว ส่วนคอปปี้รอบก่อนเป็นของแบรนด์ก่อนหน้า ซึ่งบรีฟรอบนั้นระบุ "เกมสด" "เกมโต๊ะ"
// "หมวดเกมยอดนิยม" และ "ระบบแยกค่าย" ไว้ — บรีฟของ BRAZIL999 **ไม่ได้ระบุสักคำ**
// ทั้งหน้าจึงถูกเขียนใหม่ หัวข้อ "เกมสด เกมโต๊ะ และหมวดยอดนิยม แยกค่ายไว้ชัดเจน"
// ของรอบก่อนถูกถอดออก และแทนด้วย "ระบบบัญชีและการจัดการข้อมูลของสมาชิก" ซึ่งเป็น
// สิ่งที่บรีฟรอบนี้พูดถึงจริง ห้าม find-and-replace ชื่อแบรนด์ทับของเก่าเด็ดขาด
//
// ข้อเท็จจริงทุกบรรทัดมาจากบรีฟรอบนี้เท่านั้น (brand-spec §4): คาสิโนแท้จากบริษัท
// โดยตรง · เว็บนี้ไม่มีประวัติโกง ตรวจสอบได้ · รวมเกมหลายประเภทไว้ให้เลือกจากบัญชี
// เดียว · ตรวจสอบรายละเอียดเกม โปรโมชั่น และข้อมูลการใช้งานก่อนเริ่มเล่น ·
// เข้าถึงแต่ละเมนูได้ง่ายทั้งบนมือถือและคอมพิวเตอร์ · ขั้นตอนเข้าสู่ระบบและจัดการ
// รายการผ่านบัญชีส่วนตัว · ควรตรวจสอบข้อมูล เงื่อนไข และช่องทางอย่างเป็นทางการก่อน
// ทำรายการ เพื่อลดความเสี่ยงจากช่องทางที่ไม่ถูกต้อง · ข่าวสารและโปรโมชั่นอัปเดตตาม
// ช่วงเวลา · โบนัสแนะนำเพื่อน 0.8% · โบนัสคืนยอดเสีย 0.3% · ตรวจสอบยอดที่เข้าเกณฑ์
// รอบคำนวณ และวิธีรับสิทธิ์ก่อนกดรับ · สมัครเองผ่านหน้าเว็บได้ใน 3 ขั้นตอน ·
// ติดต่อเจ้าหน้าที่ผ่านช่องทางไลน์ได้ตลอด 24 ชั่วโมง
// — ห้ามอ้าง บาคาร่า สล็อต หวย บอล เกมสด เกมโต๊ะ เครดิตฟรี ชื่อค่ายเกม ชื่อสตูดิโอ
// ชื่อเกมเฉพาะ เลขใบอนุญาต ปีที่ก่อตั้ง เลขทะเบียนบริษัท จำนวนสมาชิก ค่า RTP
// ชื่อธนาคาร ช่องทางฝากถอนเจาะจง "ฝากถอนไม่มีขั้นต่ำ" "ออโต้ 10 วินาที" หรือ
// การันตีว่าจะชนะ เพราะบรีฟรอบนี้ไม่ได้ระบุไว้
//
// ศัพท์ของบรีฟรอบนี้คือ **ช่องทางไลน์ / ไลน์** ไม่ใช่ "ไลน์แอด" ที่แบรนด์ก่อนหน้าใช้ และ
// ไม่ใช่ "LINE OFFICIAL" ที่แบรนด์เก่ากว่านั้นใช้ — เนื้อความใช้คำของบรีฟ ส่วนป้ายบนปุ่ม
// ยังอ่านว่า Line Official ตามมาร์กอัปเดิม
//
// Announcement รอบนี้หมุนจาก Announcement5 มาเป็น Announcement2 ทั้งเว็บ —
// default message ของไฟล์นั้นเป็นคอปปี้ของ BRAZIL999 แล้ว จึงเรียกแบบ bare เหมือน
// index.astro ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ BRAZIL999 เป็น **เขียว + เงินโครเมียมบนดำ** ตามโลโก้ (BRAZIL เป็นเงิน
// โครเมียม / 999 เป็นเขียวสด) ทองเป็นแอ็กเซนต์ที่สามใช้เฉพาะจุดเล็ก ๆ ห้ามให้ทองนำ
// (ทองนำคือหน้าตาของแบรนด์ก่อนหน้า):
// พื้นเพจ #040a05 · ผิวการ์ด #0a1a0c · ผิวการ์ดยก #123a18 · ขอบลึก #1c5a26 ·
// เขียวแบรนด์ #22c55e · เขียวสว่าง #7cf25c · เขียวอ่อนสุด #b6ff9c ·
// เขียวลึก #0a6b18 · เขียวเข้มสุด #04380c (ตัวอักษรบนพื้นเขียว) ·
// เงินโครเมียมกลาง #aab4bf · เงินโครเมียมสว่าง #f1f5f9 · เงินโครเมียมเข้ม #6b7580 ·
// ทองแอ็กเซนต์ #e8c65a · เนื้อความ #dfeadd (BRAND_TEXT) · เน้นใน strong #f4fbf2
// ปุ่มหลักไล่เขียวอ่อนสุด → เขียวแบรนด์ → เขียวลึก ส่วนปุ่มรองใช้เส้นขอบเงินโครเมียม
// เพื่อให้คู่เขียว/โครเมียมอ่านออกจากหน้าเอง
// (ตารางแมป old→new hex ดูที่ brand-spec §2 — ห้ามพิมพ์ฮิวเก่าซ้ำไว้ในไฟล์นี้
// เพราะสคริปต์แมปพาเลตต์จะไล่แทนค่าในคอมเมนต์ด้วย)
// ส่วน #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ตามเดิม
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลางที่ไม่หมุนตามรอบรีแบรนด์ และรอบนี้
// orchestrator เป็นคนรีธีม) — สีเนื้อความจึงตรงกับที่การ์ดกำหนดไว้อยู่แล้ว
//
// ไม่มีลิงก์ /ตรวจหวย หรือ /แนวทาง ในหน้านี้: BRAZIL999 เป็นแบรนด์คาสิโน ไม่ใช่
// เว็บหวย สองหน้านั้นอยู่ใน src/pages-disabled/ รอบนี้ href ที่ชี้ route ซึ่งไม่มี
// ใน dist/ จะทำให้ verify-build แดง
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index และ /promotion
// ส่วน banner1/banner1-mobile เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า
// และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กค้างของลูกค้าเจ้าอื่น ห้าม import
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 152
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "เกี่ยวกับ BRAZIL999 คาสิโนออนไลน์ที่เชื่อมต่อจากบริษัทโดยตรง รวมเกมหลายประเภทไว้ให้เลือกจากบัญชีเดียว พร้อมโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3%";

const pageTitle = "เกี่ยวกับเรา BRAZIL999 คาสิโนแท้ จากบริษัทโดยตรง ตรวจสอบได้ทุกขั้นตอน";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dfeadd]">
        <strong class="text-[#f4fbf2]">BRAZIL999</strong> คือ<strong class="text-[#f4fbf2]">คาสิโนออนไลน์ที่เชื่อมต่อจากบริษัทโดยตรงตามข้อมูลของเว็บไซต์</strong>
        โดยรวมเกมหลายประเภทไว้ให้เลือกจากบัญชีเดียว ผู้ใช้งานจึงเปิดดูรายการที่สนใจได้จากระบบเดียว และเข้าถึงแต่ละเมนูได้ง่ายทั้งบนมือถือและคอมพิวเตอร์
      </p>

      <p class="text-left text-base leading-relaxed text-[#dfeadd]">
        หน้านี้รวบรวมไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่รูปแบบการเชื่อมต่อจากบริษัทโดยตรงและการจัดการบัญชีของสมาชิก ไปจนถึงโปรโมชั่นที่ตรวจสอบเงื่อนไขได้จากหน้าโปรโมชั่น ขั้นตอนการสมัครสมาชิก
        และช่องทางสอบถามเจ้าหน้าที่เมื่อไม่แน่ใจในขั้นตอนใด
      </p>

      <p class="text-left text-base leading-relaxed text-[#dfeadd]">
        <strong class="text-[#f4fbf2]">รายการเกมและเงื่อนไขของโปรโมชั่นอาจเปลี่ยนแปลงตามช่วงเวลา</strong>
        รายละเอียดทั้งหมดจึงยึดตามข้อมูลที่เว็บไซต์แสดงไว้จริงในขณะนั้นเป็นหลัก และควรตรวจสอบรายการล่าสุดจากช่องทางอย่างเป็นทางการของเว็บไซต์ก่อนทำรายการทุกครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="BRAZIL999 คาสิโนแท้ เชื่อมต่อจากบริษัทโดยตรง เว็บนี้ไม่มีประวัติโกง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dfeadd]">
        จุดที่เว็บไซต์ระบุไว้เป็นตัวตนของ BRAZIL999 คือ <strong class="text-[#f4fbf2]">รูปแบบคาสิโนออนไลน์ที่เชื่อมต่อจากบริษัทโดยตรง</strong>
        และการยืนยันว่าเว็บนี้ไม่มีประวัติโกง ตรวจสอบได้ทุกขั้นตอน ผู้ใช้งานจึงเดิมพันได้อย่างมั่นใจมากขึ้น เพราะรายละเอียดของระบบเปิดให้ตรวจสอบก่อนตัดสินใจ
      </p>

      <p class="text-left text-base leading-relaxed text-[#dfeadd]">
        โครงแบบนี้ทำให้<strong class="text-[#f4fbf2]">เมนูถูกจัดไว้ชัดเจนตั้งแต่หน้าแรก</strong>
        ผู้ใช้งานเห็นภาพรวมของรายการที่เปิดให้เลือก แล้วเปิดเข้าไปดูรายละเอียดของสิ่งที่สนใจต่อได้ทันที โดยรายละเอียดทั้งหมดยึดตามข้อมูลที่ระบบแสดงไว้ในขณะนั้น
      </p>
    </div>
  </ContentBox>

  <ContentBox title="รวมเกมหลายประเภทไว้ให้เลือกจากบัญชีเดียว ตรวจสอบได้ก่อนเริ่มเล่น" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dfeadd]">
        BRAZIL999 <strong class="text-[#f4fbf2]">รวมเกมหลายประเภทไว้ให้เลือกจากบัญชีเดียว</strong>
        ผู้ใช้งานจึงไม่ต้องสลับไปเปิดหลายเว็บไซต์เพื่อดูว่ามีอะไรให้เล่นบ้าง และจัดการทุกอย่างได้จากระบบเดียวตั้งแต่เริ่มต้น
      </p>

      <p class="text-left text-base leading-relaxed text-[#dfeadd]">
        ก่อนเริ่มเล่น ผู้ใช้งานสามารถ<strong class="text-[#f4fbf2]">ตรวจสอบรายละเอียดเกม โปรโมชั่น และข้อมูลการใช้งานได้จากหน้าเว็บไซต์</strong>
        แล้วสลับไปยังรายการที่สนใจต่อได้จากหน้าเดิม ระบบเปิดให้เข้าถึงแต่ละเมนูได้ง่ายทั้งบนมือถือและคอมพิวเตอร์ จึงใช้งานต่อเนื่องได้แม้สลับอุปกรณ์ระหว่างวัน
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ระบบบัญชีและการจัดการข้อมูลของสมาชิก BRAZIL999" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dfeadd]">
        BRAZIL999 <strong class="text-[#f4fbf2]">ให้ความสำคัญกับระบบบัญชีและการจัดการข้อมูลของสมาชิก</strong>
        โดยมีขั้นตอนเข้าสู่ระบบและจัดการรายการผ่านบัญชีส่วนตัว ผู้ใช้งานจึงเห็นรายการของตัวเองได้จากที่เดียว และตรวจสอบสถานะของแต่ละรายการได้จากบัญชีนั้นโดยตรง
      </p>

      <p class="text-left text-base leading-relaxed text-[#dfeadd]">
        ก่อนทำรายการทุกครั้ง ควร<strong class="text-[#f4fbf2]">ตรวจสอบข้อมูล เงื่อนไข และช่องทางอย่างเป็นทางการของเว็บไซต์</strong>
        เพื่อช่วยลดความเสี่ยงจากการเข้าใช้งานผ่านช่องทางที่ไม่ถูกต้อง หากไม่แน่ใจว่าช่องทางใดเป็นของเว็บไซต์จริง สามารถสอบถามเจ้าหน้าที่ก่อนได้ทุกครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="โปรโมชั่น BRAZIL999 แนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dfeadd]">
        สมาชิก BRAZIL999 <strong class="text-[#f4fbf2]">ติดตามข่าวสารและโปรโมชั่นที่เว็บไซต์อัปเดตตามช่วงเวลาได้</strong>
        โดยมีทั้งโบนัสแนะนำเพื่อน 0.8% สำหรับสมาชิกที่แนะนำเพื่อนเข้ามาสมัคร และโบนัสคืนยอดเสีย 0.3% ตามยอดและเงื่อนไขที่กำหนดไว้ในแต่ละรอบ
      </p>

      <p class="text-left text-base leading-relaxed text-[#dfeadd]">
        ระบบ<strong class="text-[#f4fbf2]">แสดงยอดที่เข้าเกณฑ์ รอบคำนวณ และวิธีรับสิทธิ์ไว้ให้ตรวจสอบ</strong>
        สมาชิกจึงติดตามโบนัสของตัวเองในแต่ละรอบได้จากบัญชีสมาชิกโดยตรง และควรอ่านเงื่อนไขของรายการที่สนใจให้ครบก่อนกดรับทุกครั้ง เพราะรายละเอียดของแต่ละรายการอาจแตกต่างกัน
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/promotion"
