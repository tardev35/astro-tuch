---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login, /register)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อของ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึงเขียนขึ้นใหม่
// บนข้อเท็จจริงของ LOTTO24 เท่านั้น
//
// รอบนี้ (ดรอป 2026-09-28) คือ LOTTO24 **เว็บแทงหวยออนไลน์** ไม่ใช่เว็บบาคาร่า/
// คาสิโนไลฟ์สด และไม่ใช่เว็บสล็อต คอปปี้รอบก่อนเป็นของ SEXYGAME666 ซึ่งขาย
// "โต๊ะบาคาร่าไลฟ์สด" "เกมคาสิโนสดจากผู้ให้บริการต่างประเทศ" และ "เมนูค้นหาง่าย"
// ส่วนรอบก่อนหน้านั้น (PGW44) ขายค่ายสล็อตย่อยและเกมโบนัส — บรีฟของ LOTTO24
// **ไม่ได้ระบุสักคำ** ทั้งหน้าจึงถูกเขียนใหม่ทั้งบท ไม่ใช่แทนชื่อแบรนด์ทับประโยคเดิม
// หัวข้อเรื่องบาคาร่าไลฟ์สด/เมนูค้นหาเกม/รองรับมือถือของรอบก่อนถูกถอดออกทั้งชุด
// แทนด้วยหัวข้อเรื่องยอดเข้าบัญชีบริษัทโดยตรง อัตราจ่ายเลข 2 ตัว/3 ตัว โปรโมชั่น
// สองรายการ ขั้นตอนสมัคร และช่องทางไลน์ ซึ่งเป็นสิ่งที่บรีฟรอบนี้พูดถึงจริง
//
// ข้อเท็จจริงทุกบรรทัดมาจากบรีฟรอบนี้เท่านั้น (src/assets/content.txt): แทงหวย
// ออนไลน์หลายประเภทในระบบเดียว · อัตราจ่ายระบุชัดทั้งเลข 2 ตัวและ 3 ตัว · เลข 3 ตัว
// สูงสุด 1,000 และเลข 2 ตัว 100 ตามเงื่อนไขของแต่ละรายการ · รูปแบบไม่ลดเรทตาม
// เงื่อนไขที่กำหนด · ยอดเข้าบัญชีบริษัทโดยตรง ไม่ผ่านม้า ไม่ผ่านช่องทางบุคคลอื่น ·
// รองรับวอลเลท · ระบบสมาชิกติดตามยอด รายการย้อนหลัง และข้อมูลการแทงหวยจากหน้าเดียว ·
// ตรวจสอบอัตราจ่าย รอบหวย และรายละเอียดบิลก่อนยืนยัน · โบนัสแนะนำเพื่อน 0.8% ·
// โบนัสคืนยอดเสีย 0.3% · ยอดที่เข้าเกณฑ์ / วิธีรับสิทธิ์ / รอบคำนวณ / รอบรับสิทธิ์ ·
// สมัครเองผ่านหน้าเว็บ 3 ขั้นตอน · แทงง่าย จ่ายทันที ไม่ต้องรอคิว · ติดต่อเจ้าหน้าที่
// ผ่านช่องทางไลน์ได้ 24 ชั่วโมง
// — ห้ามอ้าง ชื่อประเภทหวยเจาะจง (รัฐบาล/ฮานอย/ลาว/ยี่กี ไม่มีในบรีฟ) เวลาปิดรับ
// แต่ละรอบ เลขใบอนุญาต ปีที่ก่อตั้ง เลขทะเบียนบริษัท จำนวนสมาชิก ชื่อธนาคาร
// ชื่อวอลเลทเจาะจง ฝากถอนออโต้ เครดิตฟรี สล็อต ค่ายเกม RTP บาคาร่า ไลฟ์สด
// บอล/กีฬา "ไม่มีประวัติโกง" หรือการันตีว่าจะถูกรางวัล เพราะบรีฟรอบนี้ไม่ได้ระบุไว้
//
// ศัพท์ช่องทางติดต่อ: บรีฟรอบนี้เขียนหัวข้อไว้ว่า "ติดต่อเจ้าหน้าที่ LOTTO24 ผ่าน
// ช่องทางไลน์ได้ 24 ชั่วโมง" — รอบนี้ไลน์**อยู่ในหัวข้อของบรีฟเอง** จึงเขียนถึงได้
// ตรงตามที่บรีฟระบุ (ต่างจาก SEXYGAME666 ที่หัวข้อไม่มีคำว่าไลน์)
//
// พาเลตต์ LOTTO24 เป็น **แดงนำ + ทองตาม บนพื้นดำ** ตามโลโก้ (LOTTO ขาวเงา / 24 แดง)
// และอาร์ตเวิร์กที่มีเหรียญทองกับลูกบอลหวยแดง-ขาว ตารางแมปอยู่ที่ brand-spec §2:
// ผิวการ์ด #2a0405 · ผิวแผง/ปุ่มรอง/hover #7f1d1d · แดงแบรนด์ #dc2626 ·
// แดงสว่าง #fc2b2c · แดงลึก/ขอบ #b40102 · ทองแบรนด์ #fbbf24 · ทองอ่อน #fde68a ·
// ทองลึก #a16207 · พื้นเพจ #000000 · เนื้อความ #f6e2e2 (BRAND_TEXT) ·
// เน้นใน strong #fde68a · ตัวอักษรบนพื้นทอง #2a0405
// ปุ่มหลักไล่เฉดทอง #fbbf24 → #fde68a ส่วนปุ่มรองใช้ขอบแดงบนผิวการ์ดเกือบดำ
// ทองลึก #a16207 จงใจใช้เฉพาะเส้นขอบ ไม่เอามาอยู่ใต้ตัวหนังสือ เพราะหมึกเข้มบน
// ทองลึกเหลือคอนทราสต์แค่ ~3.3:1 ส่วนบนทองแบรนด์ได้ ~10:1
// ชุดชมพู/ม่วงของ SEXYGAME666 (#fa42b5 #ffb3e2 #ec3fae #7d1550 #8b3df3 #c9a4ff
// #4a17a0 #3d1180 #0f0518 #140722 #070109 #12041c #f2dcee #fff2fb) ถูกแทนครบทุกจุดแล้ว
// ส่วน #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ตามเดิม
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลางที่ไม่หมุนตามรอบรีแบรนด์ และรอบนี้
// orchestrator เป็นคนรีธีม) — สีเนื้อความจึงตรงกับที่การ์ดกำหนดไว้อยู่แล้ว
//
// ไม่มีลิงก์ /ตรวจหวย หรือ /แนวทาง ในหน้านี้: สวิตช์ของ operator รอบนี้ปล่อยสองหน้านั้น
// ไว้ใน src/pages-disabled/ จึงไม่มี route href ที่ชี้ route ซึ่งไม่มีใน dist/ จะทำให้
// verify-build แดง — แม้ LOTTO24 จะเป็นแบรนด์หวยก็ห้ามเติมลิงก์เอง
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index และ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า
// และ banner3/slide3/slide4 เป็นอาร์ตเวิร์กค้างของแบรนด์ก่อน ห้าม import
//
// Announcement รอบนี้หมุนจาก Announcement5 มาเป็น AnnouncementHuay ทั้งเว็บ —
// orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ LOTTO24 แล้ว จึงเรียก
// แบบ bare เหมือน index.astro ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 157
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "เกี่ยวกับ LOTTO24 เว็บแทงหวยออนไลน์ที่ระบุอัตราจ่ายเลข 3 ตัวสูงสุด 1,000 และ 2 ตัว 100 ยอดเข้าบัญชีบริษัทโดยตรง ไม่ผ่านม้า พร้อมโบนัสแนะนำเพื่อนและคืนยอดเสีย";

const pageTitle = "เกี่ยวกับเรา LOTTO24 เว็บแทงหวยออนไลน์ ยอดเข้าบัญชีบริษัทโดยตรง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f6e2e2]">
        <strong class="text-[#fde68a]">LOTTO24</strong> คือเว็บ<strong class="text-[#fde68a]">แทงหวยออนไลน์ที่รวมบริการหลายประเภทไว้ในระบบเดียว</strong>
        โดยระบุอัตราจ่ายของเลข 2 ตัวและเลข 3 ตัวไว้ชัดเจนตามเงื่อนไขของแต่ละรายการ เน้นรูปแบบไม่ลดเรทตามที่เว็บไซต์กำหนด และรองรับการทำรายการผ่านวอลเลทและช่องทางบัญชีบริษัทโดยตรง
      </p>

      <p class="text-left text-base leading-relaxed text-[#f6e2e2]">
        หน้านี้รวบรวมไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่ช่องทางทำรายการและอัตราจ่ายที่ระบบระบุไว้ รอบหวยที่เปิดรับ ไปจนถึงโปรโมชั่นที่ตรวจสอบเงื่อนไขได้จากหน้าโปรโมชั่น
        ขั้นตอนการสมัครสมาชิก และช่องทางสอบถามเจ้าหน้าที่เมื่อไม่แน่ใจในขั้นตอนใด
      </p>

      <p class="text-left text-base leading-relaxed text-[#f6e2e2]">
        <strong class="text-[#fde68a]">อัตราจ่าย รอบหวยที่เปิดรับ และเงื่อนไขของโปรโมชั่นอาจเปลี่ยนแปลงตามช่วงเวลา</strong>
        รายละเอียดทั้งหมดจึงยึดตามข้อมูลที่เว็บไซต์แสดงไว้จริงในขณะนั้นเป็นหลัก และควรตรวจสอบรายการล่าสุดจากช่องทางอย่างเป็นทางการของเว็บไซต์ก่อนยืนยันบิลทุกครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="LOTTO24 รับแทงหวยยอดเข้าบัญชีบริษัทโดยตรง ไม่ผ่านม้า" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f6e2e2]">
        สิ่งที่เว็บไซต์ระบุไว้เป็นตัวตนของ LOTTO24 คือ <strong class="text-[#fde68a]">การรองรับการทำรายการผ่านช่องทางบัญชีบริษัทโดยตรง</strong>
        สมาชิกจึงตรวจสอบรายละเอียดบัญชีและสถานะของรายการได้ชัดเจนก่อนดำเนินการ โดยไม่ต้องผ่านช่องทางบุคคลอื่น และมีวอลเลทเป็นอีกช่องทางตามรายการที่ระบบเปิดให้ใช้งาน
      </p>

      <p class="text-left text-base leading-relaxed text-[#f6e2e2]">
        ถัดจากตัวช่องทางคือ<strong class="text-[#fde68a]">ระบบสมาชิกที่รวมยอด รายการย้อนหลัง และข้อมูลการแทงหวยไว้ให้ดูจากหน้าเดียว</strong>
        การติดตามว่าบิลไหนส่งไปแล้วและรอบไหนกำลังรอผลจึงทำได้ต่อเนื่อง ไม่ต้องจดแยกไว้เองหรือย้อนถามทีละรายการ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="อัตราจ่าย LOTTO24 เลข 3 ตัวสูงสุด 1,000 และเลข 2 ตัว 100" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f6e2e2]">
        ตามข้อมูลที่กำหนด LOTTO24 ระบุ<strong class="text-[#fde68a]">อัตราจ่ายเลข 3 ตัวสูงสุด 1,000 และเลข 2 ตัว 100</strong>
        ตามเงื่อนไขของแต่ละรายการ โดยอัตราจริงที่ใช้กับบิลหนึ่งใบขึ้นอยู่กับประเภทหวยและรอบที่เปิดรับในขณะนั้น หน้าเว็บไซต์จึงแสดงอัตราของรอบที่กำลังเปิดไว้ให้ดูก่อนเลือกเลข
      </p>

      <p class="text-left text-base leading-relaxed text-[#f6e2e2]">
        สิ่งที่ควรทำก่อนยืนยันคือ <strong class="text-[#fde68a]">อ่านอัตราจ่าย รอบหวย และรายละเอียดบิลของรายการนั้นให้ครบ</strong>
        เพราะแต่ละประเภทและแต่ละรอบมีเงื่อนไขของตัวเอง การตรวจให้จบก่อนส่งบิลช่วยให้เลือกเลขและวงเงินที่เหมาะกับตัวเองได้ตรงกว่า
      </p>
    </div>
  </ContentBox>

  <ContentBox title="โปรโมชั่น LOTTO24 แนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f6e2e2]">
        โปรโมชั่นหลักตามข้อมูลที่กำหนดมีสองรายการ คือ <strong class="text-[#fde68a]">โบนัสแนะนำเพื่อน 0.8%</strong>
        สำหรับสมาชิกที่แนะนำเพื่อนเข้ามาสมัครตามเงื่อนไขของโปรโมชั่น และ <strong class="text-[#fde68a]">โบนัสคืนยอดเสีย 0.3%</strong> ตามยอดและเงื่อนไขที่ระบบกำหนด
      </p>

      <p class="text-left text-base leading-relaxed text-[#f6e2e2]">
        ทั้งสองรายการมี<strong class="text-[#fde68a]">รายละเอียดยอดที่เข้าเกณฑ์ วิธีรับสิทธิ์ รอบรับสิทธิ์ และรอบคำนวณให้ตรวจสอบ</strong>
        สมาชิกดูรายละเอียดของตัวเองได้ผ่านบัญชีสมาชิก และควรอ่านเงื่อนไขของรายการที่สนใจให้ครบก่อนกดรับสิทธิ์ทุกครั้ง เพราะแต่ละรายการมีรอบและเงื่อนไขไม่เหมือนกัน
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/promotion"
          aria-label="ดูภาพโปรโมชั่นทั้งหมดของ LOTTO24"
          class="flex items-center justify-center rounded-lg border border-[#dc2626] bg-[#2a0405] px-8 py-3 font-bold text-[#f6e2e2] transition-all hover:scale-105 hover:border-[#fc2b2c] hover:bg-[#7f1d1d] hover:text-[#fde68a]">
          ดูโปรโมชั่นทั้งหมด
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="สมัครแทงหวย LOTTO24 ด้วยตัวเองแค่ 3 ขั้นตอน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f6e2e2]">
        การสมัคร LOTTO24 <strong class="text-[#fde68a]">ทำผ่านหน้าเว็บไซต์ได้ด้วยตัวเอง โดยมีขั้นตอนหลักเพียง 3 ขั้นตอน</strong>
        หลังยืนยันบัญชีเรียบร้อยสามารถเข้าสู่ระบบเพื่อเลือกรอบหวยและเลขที่ต้องการได้ทันที ตามที่เว็บไซต์ระบุไว้ว่าแทงง่าย จ่ายทันที ไม่ต้องรอคิว
      </p>

      <ol class="ml-6 list-decimal space-y-2 text-left text-base leading-relaxed text-[#f6e2e2] marker:font-black marker:text-[#fbbf24]">
