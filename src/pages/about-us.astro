---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "รู้จัก LOBBYBKK คาสิโนออนไลน์ระบบออโต้ รองรับมือถือและคอมพิวเตอร์ เข้าใช้งานได้ทุกที่ทุกเวลา ฝากถอนอัตโนมัติรวดเร็ว พร้อมทีมงานดูแลสมาชิกตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ LOBBYBKK คาสิโนออนไลน์ระบบออโต้",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา LOBBYBKK คาสิโนออนไลน์ระบบออโต้" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ LOBBYBKK" as="h1">
    <p class="mb-6 text-left text-base leading-relaxed text-[#f0e9fc]">
      <strong class="text-[#e5e7eb]">LOBBYBKK</strong> คือคาสิโนออนไลน์ระบบออโต้ที่รวมเกมเดิมพันไว้ในที่เดียว รองรับการใช้งานผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ เข้าใช้งานได้สะดวกทุกที่ทุกเวลาโดยไม่ต้องติดตั้งโปรแกรมเพิ่มเติม เปิดให้บริการสมาชิกทุกระดับผ่านบัญชีเดียว
    </p>

    <p class="mb-8 text-left text-base leading-relaxed text-[#f0e9fc]">
      ด้านการเงิน ระบบฝากถอนอัตโนมัติเปิดให้ทำรายการได้ด้วยตนเองตลอด 24 ชั่วโมงโดยไม่ต้องรอเจ้าหน้าที่ทีละราย และมีทีมงานคอยดูแลให้คำแนะนำตลอดการเดิมพัน เพื่อให้สมาชิกทุกคนใช้งาน LOBBYBKK ได้อย่างมั่นใจในทุกขั้นตอน
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก"
        class="flex items-center justify-center rounded-lg border border-[#7c3aed]/60 bg-gradient-to-b from-[#a78bfa] to-[#7c3aed] px-8 py-3 font-bold text-white shadow-[0_10px_30px_rgba(124,58,237,0.18)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(76,29,149,0.30)]">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ"
        class="flex items-center justify-center rounded-lg border border-[#7c3aed]/60 bg-[#150c24] px-8 py-3 font-extrabold text-[#e5e7eb] shadow-[0_4px_14px_rgba(124,58,237,0.18)] transition-transform hover:scale-105 hover:bg-[#1c1030]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
