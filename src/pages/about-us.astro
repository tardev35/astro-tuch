---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่ม) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง
// ไม่ได้มาจากเช็กลิสต์หัวข้อของ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ไม่มีส่วน
// SUB-PAGES จึงเขียนทั้งหน้าขึ้นใหม่บนข้อเท็จจริงของ THE88 เท่านั้น
//
// บรีฟรอบนี้ (ดรอป 2026-09-23) คือ "THE88 ผู้ให้บริการระบบพนันออนไลน์ จากบริษัท
// หลักโดยตรง" — เว็บรวมเกมพนันออนไลน์หลายประเภทไว้ในระบบเดียว คอปปี้ของแบรนด์
// รอบก่อน (WY88 "ทางเข้าเล่นรูปแบบ VIP สำหรับยูสไทย") ถูกเขียนใหม่ทั้งหน้าแล้ว
// ไม่เหลือประโยคเดิมและไม่เหลือชื่อแบรนด์เก่าแม้แต่จุดเดียว
//
// ข้อเท็จจริงทุกบรรทัดมาจากบรีฟรอบนี้เท่านั้น: ผู้ให้บริการระบบพนันออนไลน์ที่รวมเกม
// หลายประเภทไว้ในระบบเดียว · เชื่อมต่อจากบริษัทหลักตามข้อมูลของเว็บไซต์ ·
// เลือกเล่นได้ทั้งบาคาร่า สล็อต หวย บอล และไฮโล ผ่านบัญชีเดียว · รองรับทั้งมือถือ
// และคอมพิวเตอร์ · เมนูจัดหมวดหมู่ชัดเจนและเข้าถึงง่าย · ตรวจสอบรายละเอียดเกมและ
// ค่ายที่เปิดให้บริการก่อนเข้าเล่นได้ · โปรโมชั่นบางรายการกดรับหลังสมัครได้ตาม
// เงื่อนไข · โบนัสแนะนำเพื่อน 0.8% · โบนัสคืนยอดเสีย 0.3% · ตรวจสอบรอบคำนวณ
// ยอดที่เข้าเกณฑ์ และเงื่อนไขก่อนกดรับ · ฝากถอนผ่านวอลเลทและธนาคารที่เว็บไซต์
// กำหนด ตรวจยอดเครดิตและสถานะรายการจากบัญชีตัวเองได้ · แอดมินดูแลตลอด 24 ชั่วโมง
// — ห้ามอ้างเลขใบอนุญาต ปีที่ก่อตั้ง เลขทะเบียนบริษัท จำนวนสมาชิก ชื่อค่ายเกม
// ค่า RTP อัตราจ่าย ขั้นต่ำการเดิมพัน "ฝากถอนออโต้ไม่มีขั้นต่ำ" "ปลอดภัย 100%"
// "เร็วที่สุด/ปลอดภัยที่สุดในไทย" หรือการันตีว่าจะชนะ เพราะบรีฟไม่ได้ระบุไว้
//
// Announcement รอบนี้หมุนมาใช้ Announcement2 ทั้งเว็บ — default message ของไฟล์นั้น
// เป็นคอปปี้ของ THE88 อยู่แล้ว จึงเรียกแบบ bare เหมือน index.astro
// ห้ามส่ง prop message มิฉะนั้นข้อความตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// พาเลตต์ THE88 (แดงจีน + ทองหรู แทนชมพูมาเจนตา + ทองของแบรนด์รอบก่อน):
// พื้นเกือบดำแดง #1c0504 · การ์ด #2d0908 · ขอบแดงหลัก #a40201 · แดงสว่าง #dd0503 ·
// แดงลึก #6b0302 · ทองหลัก #f2c14e ใช้กับ <strong> · ทองสว่าง #ffe7a6 ใช้กับชื่อ
// แบรนด์ เลขลำดับ และไอคอน · ทองเข้ม #8a6524 เป็นสต็อปปลายของเกรเดียนต์ ·
// เนื้อความ #f7e3dd (BRAND_TEXT) · ตัวอักษรบนปุ่มไล่สี #1c0504 · ออร่าทอง
// rgba(242,193,78,α) — ข้อความเน้นใช้ทองไม่ใช้แดง เพราะแดงบนพื้นแดงเข้มอ่านไม่ออก
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index และ /promotion
// ส่วน banner1/banner1-mobile เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า
// และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กค้างของลูกค้าเจ้าอื่น ห้าม import
//
// ไม่มีลิงก์ไป /ตรวจหวย หรือ /แนวทาง เด็ดขาด — รอบนี้สองหน้านั้นถูกพักไว้ใน
// src/pages-disabled/ การลิงก์ไปเส้นทางที่ไม่มีจริงทำให้ verify-build แดง
// (หวยในหน้านี้เป็นชื่อหมวดเกมในข้อความเท่านั้น ไม่ใช่ลิงก์)
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 155
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "เกี่ยวกับ THE88 ผู้ให้บริการระบบพนันออนไลน์ที่รวมบาคาร่า สล็อต หวย บอล ไฮโล ไว้ในบัญชีเดียว พร้อมโปรโมชั่น ระบบฝากถอน และแอดมินที่ดูแลสมาชิกตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับเรา THE88 ผู้ให้บริการระบบพนันออนไลน์ จากบริษัทหลักโดยตรง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา THE88 ผู้ให้บริการระบบพนันออนไลน์ จากบริษัทหลักโดยตรง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับเรา THE88 ผู้ให้บริการระบบพนันออนไลน์ จากบริษัทหลักโดยตรง" as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f7e3dd]">
        <strong class="text-[#ffe7a6]">THE88</strong> คือผู้ให้บริการระบบพนันออนไลน์ที่
        <strong class="text-[#f2c14e]">รวมเกมหลายประเภทไว้ในระบบเดียว</strong>
        พร้อมรูปแบบการเชื่อมต่อจากบริษัทหลักตามข้อมูลของเว็บไซต์ สมาชิกจึงเลือกเล่นได้ทั้งบาคาร่า สล็อต หวย บอล และไฮโล ผ่านบัญชีเดียว โดยรองรับการใช้งานทั้งบนมือถือและคอมพิวเตอร์
      </p>

      <p class="text-left text-base leading-relaxed text-[#f7e3dd]">
        หน้านี้รวบรวมไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่หมวดเกมที่เปิดให้เลือกจากบัญชีเดียว รายการโปรโมชั่นที่สมาชิกตรวจสอบเงื่อนไขก่อนกดรับได้ ช่องทางฝากถอนที่ระบบรองรับ
        ขั้นตอนการสมัครสำหรับคนที่เพิ่งเข้ามาใช้งานครั้งแรก ไปจนถึงช่องทางสอบถามแอดมินเมื่อไม่แน่ใจในขั้นตอนใด
      </p>

      <p class="text-left text-base leading-relaxed text-[#f7e3dd]">
        <strong class="text-[#f2c14e]">รายการเกมและสิทธิ์ที่เปิดให้ใช้งานอาจมีการอัปเดตตามช่วงเวลา</strong>
        รายละเอียดทั้งหมดจึงยึดตามหมวดหมู่และเงื่อนไขที่ระบบแสดงไว้จริงในช่วงนั้นเป็นหลัก และควรตรวจสอบรายการล่าสุดจากหน้าเว็บไซต์ก่อนเข้าเล่นทุกครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="เว็บ THE88 รวมบาคาร่า สล็อต หวย บอล ไฮโล ไว้ในบัญชีเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f7e3dd]">
        ภายในระบบของ THE88 <strong class="text-[#f2c14e]">รวมเกมยอดนิยมไว้ครบทั้งบาคาร่า สล็อต หวย บอล และไฮโล</strong>
        โดยแบ่งหมวดหมู่ให้เลือกอย่างชัดเจน สมาชิกจึงเลือกหมวดที่สนใจได้จากเมนูเกม และสลับไปดูอีกหมวดได้จากจุดเดียวกัน โดยไม่ต้องสมัครแยกหรือเปลี่ยนไปใช้หลายเว็บไซต์
      </p>

      <p class="text-left text-base leading-relaxed text-[#f7e3dd]">
        ก่อนเข้าเล่น <strong class="text-[#f2c14e]">สมาชิกสามารถตรวจสอบรายละเอียดเกมและค่ายที่เปิดให้บริการได้จากหน้าเว็บไซต์</strong>
        เพื่อเลือกประเภทที่เหมาะกับรูปแบบการใช้งานของตัวเอง และเนื่องจากระบบถูกออกแบบให้รองรับหลายอุปกรณ์ การเปิดหมวดเดียวกันจากมือถือหรือคอมพิวเตอร์จึงเห็นโครงหน้าแบบเดียวกัน
      </p>
    </div>
  </ContentBox>

  <ContentBox title="โปรโมชั่น THE88 แนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f7e3dd]">
        THE88 มีสิทธิ์สำหรับสมาชิกให้เลือกหลายรูปแบบ โดยบางรายการ
        <strong class="text-[#f2c14e]">สามารถตรวจสอบและกดรับหลังสมัครได้ตามเงื่อนไขที่กำหนด</strong>
        แต่ละรายการมีรายละเอียดของตัวเองให้ตรวจสอบก่อนรับ ทำให้เลือกสิทธิ์ที่ตรงกับความต้องการได้ง่ายขึ้น แทนที่จะต้องกดรับทุกอย่างไว้ก่อน
      </p>

      <p class="text-left text-base leading-relaxed text-[#f7e3dd]">
        สมาชิกที่แนะนำเพื่อนเข้ามาสมัครสามารถรับ<strong class="text-[#f2c14e]">โบนัสแนะนำเพื่อน 0.8%</strong>
        ตามเงื่อนไขของกิจกรรม ระบบมีรายละเอียดเกี่ยวกับยอดที่เข้าเกณฑ์และขั้นตอนรับสิทธิ์ให้ตรวจสอบ ช่วยให้ติดตามโบนัสจากการแนะนำเพื่อนได้สะดวกผ่านบัญชีสมาชิก
      </p>

      <p class="text-left text-base leading-relaxed text-[#f7e3dd]">
        ส่วนโปรโมชั่นคืนยอดเสียให้<strong class="text-[#f2c14e]">โบนัส 0.3%</strong> ตามยอดและเงื่อนไขที่กำหนด สมาชิกสามารถตรวจสอบรอบคำนวณ ยอดที่เข้าเกณฑ์ และรายละเอียดก่อนกดรับได้จากหน้าโปรโมชั่น
        จึงติดตามสิทธิ์ของตัวเองในแต่ละรอบได้ชัดเจนมากขึ้น
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ระบบ THE88 ฝากถอนวอลเลทและธนาคารชั้นนำ" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f7e3dd]">
        ระบบของ THE88 <strong class="text-[#f2c14e]">รองรับช่องทางฝากถอนผ่านวอลเลทและธนาคารที่เว็บไซต์กำหนด</strong>
        สมาชิกจึงเลือกช่องทางที่สะดวกกับตัวเองได้ และตรวจสอบยอดเครดิตพร้อมสถานะของรายการผ่านบัญชีของตัวเองได้จากหน้าเว็บไซต์
      </p>

      <p class="text-left text-base leading-relaxed text-[#f7e3dd]">
        <strong class="text-[#f2c14e]">ขั้นตอนถูกจัดให้เข้าใจง่าย</strong>
        ช่วยให้จัดการรายการต่าง ๆ ได้จากหน้าเว็บไซต์โดยไม่ต้องสลับหลายระบบ และเนื่องจากช่องทางที่เปิดรองรับอาจเปลี่ยนแปลงได้ตามช่วงเวลา ควรดูรายการล่าสุดจากหน้าฝากถอนก่อนทำรายการทุกครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="สมัคร THE88 ด้วยตัวเองผ่านหน้าเว็บไซต์ 3 ขั้นตอน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f7e3dd]">
        การสมัคร THE88 ทำผ่านหน้าเว็บไซต์ได้ด้วยตัวเอง ใช้ขั้นตอนไม่ซับซ้อน และหลังยืนยันบัญชีเรียบร้อยสามารถ<strong class="text-[#f2c14e]">
          เข้าสู่ระบบเพื่อเลือกบาคาร่า สล็อต หวย บอล หรือไฮโลที่ต้องการได้ทันที
        </strong>
        โดยมี 3 ขั้นตอนหลักดังนี้
      </p>

      <ol class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#f7e3dd]">
        <li class="flex gap-3">
          <span class="font-bold text-[#ffe7a6]">1.</span>
          <span>เปิดหน้าสมัคร THE88 แล้วกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#ffe7a6]">2.</span>
          <span>ตรวจสอบข้อมูลและรายละเอียดบัญชีให้ถูกต้องก่อนกดยืนยัน</span>
        </li>
        <li class="flex gap-3">
          <span class="font-bold text-[#ffe7a6]">3.</span>
          <span>ยืนยันการสมัครและเข้าสู่ระบบ จากนั้นเลือกหมวดเกมที่ต้องการได้ทันที</span>
        </li>
      </ol>

      <p class="text-left text-base leading-relaxed text-[#f7e3dd]">
        <strong class="text-[#f2c14e]">ผลของเกมเดิมพันทุกประเภทตัดสินจากระบบของเกมนั้น ไม่มีสูตรหรือช่วงเวลาใดรับประกันผล</strong>
        จึงควรกำหนดงบประมาณก่อนเข้าเล่นทุกครั้ง และหยุดเมื่อถึงขีดที่ตั้งไว้
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก THE88"
          class="flex items-center justify-center rounded-lg border border-[#ffe7a6]/60 bg-gradient-to-r from-[#ffe7a6] via-[#f2c14e] to-[#8a6524] px-8 py-3 font-black text-[#1c0504] shadow-[0_0_15px_rgba(242,193,78,0.50)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ THE88"
          class="flex items-center justify-center rounded-lg border border-[#a40201] bg-[#1c0504] px-8 py-3 font-bold text-[#f7e3dd] transition-all hover:scale-105 hover:border-[#dd0503] hover:bg-[#2d0908] hover:text-[#ffe7a6]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="แอดมิน THE88 ดูแลสมาชิกตลอด 24 ชั่วโมง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#f7e3dd]">
        หากมีข้อสงสัยเกี่ยวกับการสมัคร โปรโมชั่น เกม การเข้าใช้งาน หรือระบบฝากถอน สามารถ
