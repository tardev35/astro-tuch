---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

// LUCKY88 เป็นเว็บ "สล็อต" ไม่ใช่เว็บรวมหลายหมวดและไม่ใช่หวย — ทุกข้อความด้านล่าง
// อ้างอิง src/assets/content.txt เท่านั้น ไม่มีการอ้างใบอนุญาต รางวัล
// หรือการันตีผลกำไร (ตัวบรีฟเองก็ระบุว่าเกมสล็อตรับประกันผลไม่ได้)
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 156
const pageDescription =
  "รู้จัก LUCKY88 เว็บสล็อตออนไลน์ที่รวมเกมจากหลายค่ายไว้ในระบบเดียว พร้อมโปรโมชั่นแนะนำเพื่อนรับ 0.8% คืนยอดเสีย 0.3% และแอดมินดูแลระบบหลังบ้านตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ LUCKY88 เว็บสล็อตออนไลน์ รวมเกมหลายค่ายในระบบเดียว",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา LUCKY88 เว็บสล็อตออนไลน์ รวมค่ายชั้นนำไว้ในระบบเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ LUCKY88" as="h1">
    <div>
      <p class="mb-6 text-left text-base leading-relaxed text-[#e8dadb]">
        <strong class="text-[#ff3b4d]">LUCKY88</strong> เป็นช่องทางสำหรับผู้ที่ต้องการ<strong class="text-[#ff3b4d]">เล่นเกมสล็อตออนไลน์จากหลายค่ายผ่านระบบเดียว</strong>
        รองรับการใช้งานบนมือถือ แท็บเล็ต และคอมพิวเตอร์ สมาชิกสามารถเลือกค่ายเกม ตรวจสอบโปรโมชั่น ฝากถอน และจัดการเครดิตของตนเองได้จากบัญชีสมาชิกในที่เดียว
        โดยไม่ต้องเปิดบัญชีแยกตามค่ายเกมที่อยากลอง
      </p>

      <p class="mb-2 text-left text-base leading-relaxed text-[#e8dadb]">
        นอกจากตัวเกมแล้ว สมาชิกยังตรวจสอบสิทธิ์โปรโมชั่นได้จากหน้าเว็บไซต์โดยตรง ทั้ง<strong class="text-[#ff3b4d]">แนะนำเพื่อนรับโบนัส 0.8%</strong>
        และ<strong class="text-[#ff3b4d]">คืนยอดเสีย 0.3%</strong> ตามเงื่อนไขของแต่ละรายการ พร้อมมีแอดมินคอยดูแลปัญหาการใช้งานระบบหลังบ้านตลอด 24 ชั่วโมง
      </p>
    </div>
  </ContentBox>

  <ContentBoxPlain title="เกมสล็อตหลายรูปแบบของ LUCKY88 เลือกได้จากบัญชีเดียว" as="h2">
    <div>
      <p class="mb-2 text-left text-base leading-relaxed text-[#e8dadb]">
        ภายใน LUCKY88 มีเกมสล็อตหลายรูปแบบให้เลือก ไม่ว่าจะเป็น
        <strong class="text-[#ff3b4d]">สล็อตเบทต่ำ เกมฟรีสปิน เกมโบนัส สล็อตแจ็กพอต และเกมจากค่ายต่าง ๆ</strong>
        สมาชิกสามารถตรวจสอบช่วงเดิมพัน อัตราจ่าย Paytable และรายละเอียดฟีเจอร์ของแต่ละเกมก่อนเริ่มเล่น
        พร้อมจัดการเครดิตและส่งคำขอถอนผ่านระบบสมาชิกได้ด้วยตนเอง
      </p>

      <p class="mt-3 mb-2 text-left text-base leading-relaxed text-[#e8dadb]">
        ส่วนเรื่อง<strong class="text-[#cfd4da]">วงเงินถอนสูงสุด จำนวนครั้งในการถอน และข้อความว่าไม่จำกัดยอด</strong>
        ควรยึดเงื่อนไขล่าสุดที่แสดงในหน้าฝากถอนเป็นหลัก เนื่องจากวงเงินอาจแตกต่างกันตามช่องทางหรือข้อกำหนดของระบบ
        และเกมสล็อตไม่สามารถรับประกันผลกำไรหรือรางวัลได้
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="โปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ของ LUCKY88" as="h2">
    <div>
      <p class="mb-2 text-left text-base leading-relaxed text-[#e8dadb]">
        กิจกรรม<strong class="text-[#ff3b4d]">แนะนำเพื่อน</strong> เริ่มจากการนำลิงก์แนะนำส่วนตัวไปแชร์ให้เพื่อน เมื่อเพื่อนสมัครและมียอดการใช้งานตรงตามข้อกำหนด
        ระบบจะคำนวณโบนัสแนะนำเพื่อน 0.8% ตามเงื่อนไข โดยสมาชิกตรวจสอบจำนวนเพื่อน ยอดที่เข้าเกณฑ์ และโบนัสที่มีสิทธิ์รับได้จากบัญชีของตนเอง
        ทั้งนี้การแชร์ลิงก์เพียงอย่างเดียวอาจยังไม่ทำให้ได้รับโบนัส หากโปรโมชั่นกำหนดให้ผู้ถูกแนะนำต้องสมัคร ฝากเงิน หรือมียอดเล่นตามเกณฑ์
      </p>

      <p class="mt-3 mb-2 text-left text-base leading-relaxed text-[#e8dadb]">
        ส่วนสมาชิกที่มียอดเสียเข้าเงื่อนไข สามารถตรวจสอบสิทธิ์รับ<strong class="text-[#ff3b4d]">โบนัสคืนยอดเสีย 0.3%</strong> ตามรอบที่ LUCKY88 กำหนด
        ระบบจะแสดงยอดที่นำมาคำนวณและโบนัสที่กดรับได้ ก่อนรับสิทธิ์ทุกครั้งควรตรวจสอบประเภทเกมสล็อตที่ร่วมรายการ รอบคำนวณ และข้อกำหนดเกี่ยวกับการถอนโบนัสให้ครบถ้วน
        เพราะโปรโมชั่นแต่ละรายการมีวิธีคำนวณและข้อกำหนดแตกต่างกัน
      </p>
    </div>
  </ContentBoxPlain>

  <ContentBoxPlain title="สมัคร LUCKY88 ด้วยตัวเอง 3 ขั้นตอน และแอดมินดูแลตลอด 24 ชั่วโมง" as="h2">
    <div>
      <p class="mb-4 text-left text-base leading-relaxed text-[#e8dadb]">
        เริ่มต้นสมัคร LUCKY88 ผ่านมือถือได้ด้วยขั้นตอนที่ไม่ซับซ้อน ระบบรองรับการใช้งานผ่านเว็บเบราว์เซอร์โดยตรงทั้งบน Android และ iOS
        หลังเปิดบัญชีเรียบร้อยสามารถตรวจสอบเครดิต โปรโมชั่น ประวัติการทำรายการ และสถานะฝากถอนผ่านบัญชีของตนเองได้ทันที
      </p>

      <ol class="mb-4 flex flex-col gap-2 text-left text-base leading-relaxed text-[#e8dadb]">
        <li class="flex gap-3"><span class="font-bold text-[#ff3b4d]">1.</span> เปิดหน้าสมัครสมาชิก LUCKY88 และกรอกข้อมูลที่ระบบกำหนด</li>
        <li class="flex gap-3"><span class="font-bold text-[#ff3b4d]">2.</span> Login เข้าบัญชี ตรวจสอบโปรโมชั่น และฝากเครดิตผ่านช่องทางที่รองรับ</li>
        <li class="flex gap-3"><span class="font-bold text-[#ff3b4d]">3.</span> เลือกค่ายเกมสล็อต อ่านกติกาและรายละเอียดก่อนเริ่มเดิมพัน</li>
      </ol>

      <p class="mb-4 text-left text-base leading-relaxed text-[#e8dadb]">
        สมาชิกควรตั้งรหัสผ่านที่คาดเดายาก และ<strong class="text-[#ff3b4d]">ไม่เปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น</strong>
        รวมถึงควรตรวจสอบว่ากำลังใช้งานช่องทางของผู้ให้บริการที่ถูกต้องก่อนทำธุรกรรมทุกครั้ง
      </p>

      <p class="mb-6 text-left text-base leading-relaxed text-[#e8dadb]">
        หากพบปัญหาเกี่ยวกับการสมัคร Login ไม่ได้ เครดิตฝากไม่เข้า ถอนเงินค้าง โปรโมชั่นไม่แสดง หรือเข้าเกมสล็อตไม่ได้ สามารถ
        <strong class="text-[#ff3b4d]">ติดต่อแอดมิน LUCKY88 ได้ตลอด 24 ชั่วโมง</strong> พร้อมแจ้งเวลา จำนวนเงิน และรายละเอียดของรายการ
        เพื่อช่วยให้เจ้าหน้าที่ตรวจสอบปัญหาในระบบหลังบ้านได้ตรงจุด และหากเป็นเรื่องธุรกรรมควรเก็บหลักฐานรายการไว้จนกว่าการตรวจสอบจะเสร็จสิ้น
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก LUCKY88"
          class="flex items-center justify-center rounded-lg bg-gradient-to-r from-[#ff3b4d] via-[#e01a2b] to-[#8e0407] px-8 py-3 font-black text-[#f4f6f8] shadow-[0_0_15px_rgba(224,26,43,0.4)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ LUCKY88"
          class="flex items-center justify-center rounded-lg border border-[#c1121f]/80 bg-transparent px-8 py-3 font-bold text-[#cfd4da] transition-all hover:scale-105 hover:border-[#ff3b4d] hover:bg-[#3b0303]/70">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
