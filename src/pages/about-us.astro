---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char, so a byte count reads
// ~3x too long). One string, reused by MainLayout's meta and the WebPage node.
// This page is 154.
const pageDescription =
  "รู้จัก LEKDED เว็บซื้อหวยออนไลน์ที่รวมหวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยหุ้น ไว้ในบัญชีเดียว พร้อมโปรวันที่ 1 และ 16 ระบบฝากถอนออโต้ และแอดมินดูแล 24 ชม.";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ LEKDED เว็บซื้อหวยออนไลน์ครบทุกประเภท",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา LEKDED เว็บซื้อหวยออนไลน์ รัฐบาลไทย ลาว ฮานอย หุ้น" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ LEKDED" as="h1">
    <p class="mb-6 text-left text-base leading-relaxed text-[#ecdfb4]">
      <strong class="text-[#e2c466]">LEKDED</strong> คือ <strong class="text-[#e2c466]">เว็บซื้อหวยออนไลน์ที่รวมหวยหลายประเภทไว้ให้สมาชิกเลือกซื้อผ่านบัญชีเดียว</strong>
      ทั้งหวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยหุ้น เปิดใช้งานได้ทั้งบนมือถือ แท็บเล็ต และคอมพิวเตอร์ผ่านเบราว์เซอร์โดยไม่ต้องติดตั้งโปรแกรมเพิ่ม
      โดยรอบเดิมพันที่เปิดให้ส่งโพยเป็นไปตามเวลาเปิด-ปิดของหวยแต่ละประเภทที่ระบบแสดงไว้
    </p>

    <p class="mb-2 text-left text-base leading-relaxed text-[#ecdfb4]">
      สมาชิกจัดการทุกอย่างได้จากบัญชีเดียว ทั้งการเลือกประเภทหวยและรอบที่ต้องการ ตรวจสอบอัตราจ่ายและเลขอั้นก่อนยืนยันโพย ทำรายการผ่าน
      <strong class="text-[#e2c466]">ระบบฝากถอนออโต้ที่ทำรายการได้ตลอดทั้งวัน</strong> และดูประวัติโพยกับประวัติธุรกรรมย้อนหลัง โดยมีทีมงานคอยช่วยตรวจสอบปัญหาเกี่ยวกับบัญชี ฝากถอน โปรโมชั่น และการส่งโพย
      ทั้งนี้ก่อนกรอกข้อมูลบัญชีหรือทำธุรกรรมทุกครั้ง ควรตรวจสอบว่าลิงก์ที่กำลังเปิดอยู่เป็นช่องทางที่ผู้ให้บริการประกาศไว้จริง
    </p>
  </ContentBox>

  <ContentBoxPlain title="ประเภทหวยที่ LEKDED เปิดรับ รัฐบาลไทย ลาว ฮานอย และหุ้น" as="h2">
    <p class="mb-2 text-left text-base leading-relaxed text-[#ecdfb4]">
      ภายในระบบของ LEKDED แยกหมวดหมู่หวยและรอบเดิมพันไว้ให้ตรวจสอบได้ง่าย สมาชิกเลือกซื้อได้หลายประเภทตามรอบที่เปิดให้บริการ ทั้ง
      <strong class="text-[#e2c466]">หวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยหุ้น</strong>
      จากนั้นเลือกเลขที่ต้องการ กรอกจำนวนเงิน และตรวจสอบรายละเอียดโพยก่อนยืนยันรายการผ่านมือถือได้โดยตรง
    </p>

    <p class="mt-3 mb-2 text-left text-base leading-relaxed text-[#ecdfb4]">
      วงเงินรับแทง เลขอั้น เวลาเปิด-ปิด และอัตราจ่ายของหวยแต่ละประเภทอาจแตกต่างกันในแต่ละรอบ จึงควร
      <strong class="text-[#e2c466]">ตรวจสอบข้อมูลที่ระบบแสดงในรอบนั้นก่อนส่งโพยทุกครั้ง</strong>
      และให้ยึดรายละเอียดล่าสุดที่แสดงภายในระบบ LEKDED เป็นหลัก
    </p>
  </ContentBoxPlain>

  <ContentBoxPlain title="โปรโมชั่นของ LEKDED และเงื่อนไขที่ควรตรวจสอบก่อนกดรับ" as="h2">
    <p class="mb-2 text-left text-base leading-relaxed text-[#ecdfb4]">
      สมาชิกตรวจสอบโปรโมชั่นที่กำลังเปิดให้รับได้จากบัญชีผู้ใช้งานและหน้าโปรโมชั่น โดย LEKDED มี
      <strong class="text-[#e2c466]">โบนัสสำหรับสมาชิกตามรอบวันที่ <span class="text-[#efd591]">1</span> และ <span class="text-[#efd591]">16</span> ของเดือน</strong>
      ซึ่งสมาชิกที่มีคุณสมบัติตรงตามข้อกำหนดสามารถ Login เพื่อตรวจสอบสิทธิ์และรายละเอียดโบนัสผ่านบัญชีของตนเองได้
    </p>

    <p class="mt-3 mb-2 text-left text-base leading-relaxed text-[#ecdfb4]">
      ก่อนกดรับควรอ่านข้อมูลเกี่ยวกับยอดที่ใช้คำนวณ ช่วงเวลารับสิทธิ์ และเงื่อนไขที่เกี่ยวข้องให้ครบถ้วน เพราะรายละเอียดโบนัสและวิธีรับอาจแตกต่างกันตามกิจกรรม หากไม่พบโบนัสหรือไม่แน่ใจว่าบัญชีของตนเองเข้าเงื่อนไขหรือไม่
      <strong class="text-[#e2c466]">สามารถสอบถามแอดมิน LEKDED เพื่อตรวจสอบสิทธิ์ก่อนทำรายการได้</strong>
    </p>
  </ContentBoxPlain>

  <ContentBoxPlain title="สมัครสมาชิก ฝากถอนออโต้ และการดูแลสมาชิกของทีมงาน LEKDED" as="h2">
    <p class="mb-4 text-left text-base leading-relaxed text-[#ecdfb4]">
      เริ่มต้นใช้งาน LEKDED ผ่านมือถือได้ง่ายเพียง 3 ขั้นตอน คือ สมัครสมาชิกและกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน จากนั้น Login เข้าสู่บัญชีและฝากเครดิตผ่าน
      <strong class="text-[#e2c466]">ระบบออโต้ที่รองรับบัญชีธนาคารและวอลเลทตามช่องทางที่เปิดให้บริการ</strong> แล้วเลือกประเภทหวยและรอบที่ต้องการ ตรวจสอบอัตราจ่ายก่อนยืนยันโพย
      สมาชิกตรวจสอบยอด ประวัติโพย และสถานะฝากถอนผ่านบัญชีของตนเองได้ โดยยอดขั้นต่ำ วงเงิน และช่องทางที่รองรับให้ยึดรายละเอียดล่าสุดในระบบ ณ เวลาทำรายการ รวมถึงควร
      <strong class="text-[#e2c466]">ไม่เปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น</strong>
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#ecdfb4]">
      ก่อนยืนยันรายการฝากถอนควรตรวจสอบชื่อบัญชี จำนวนเงิน และช่องทางให้ถูกต้อง หากพบปัญหาสมัครสมาชิกไม่สำเร็จ Login ไม่ได้ เครดิตไม่เข้า ถอนเงินล่าช้า ส่งโพยไม่สำเร็จ หรือโปรโมชั่นไม่แสดง สามารถ
      <strong class="text-[#e2c466]">ติดต่อแอดมิน LEKDED ได้ตลอด 24 ชั่วโมง</strong>
      พร้อมแจ้งจำนวนเงิน เวลา และรายละเอียดธุรกรรม เพื่อให้เจ้าหน้าที่ค้นหารายการและแนะนำขั้นตอนแก้ไขได้ตรงจุด
    </p>

    <p class="mb-6 text-left text-base leading-relaxed text-[#ecdfb4]">
      ทั้งนี้ <strong class="text-[#e2c466]">การเดิมพันมีความเสี่ยงและไม่มีการซื้อหวยรูปแบบใดรับประกันผลรางวัลได้</strong> ผู้เล่นจึงควรกำหนดงบประมาณของตัวเองก่อนทุกครั้ง และเล่นเท่าที่รับความเสี่ยงไหว
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก LEKDED"
        class="flex items-center justify-center rounded-lg bg-gradient-to-r from-[#fbe479] via-[#e2c466] to-[#b5811e] px-8 py-3 font-black text-[#030803] shadow-[0_0_15px_rgba(181,129,30,0.32)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ LEKDED"
        class="flex items-center justify-center rounded-lg border border-[#b5811e]/70 bg-transparent px-8 py-3 font-bold text-[#ecdfb4] transition-all hover:scale-105 hover:border-[#e2c466] hover:bg-[#0b1405]/70">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
