---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login, /register)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึงเขียนขึ้นใหม่
// บนข้อเท็จจริงของ หวยเฮง789 เท่านั้น (src/assets/content.txt)
//
// รอบนี้ (ดรอป 2026-10-01) คือ หวยเฮง789 **เว็บแทงหวยออนไลน์** — แง่มุมที่บรีฟระบุ
// ไว้มีเท่านี้: รัฐบาลไทย / ฮานอย / ลาว / หุ้นต่างประเทศ · เลขเด็ด เลขดัง ·
// ไม่จำกัด แทงได้ไม่อั้น (ต้องมีคำกำกับเรื่องวงเงินของบรีฟติดไปด้วยทุกครั้ง) ·
// บัญชีเดียวครบทุกประเภท · เลือกเลขเอง ส่งโพย ตรวจอัตราจ่ายก่อนยืนยัน ·
// รองรับมือถือ · สมัคร 3 ขั้นตอน · แอดมิน 24 ชั่วโมง · 2 ตัว จ่าย 100 บาท ·
// 3 ตัว จ่าย 1,000 บาท
//
// แบรนด์ก่อนหน้า (หวยเฮง24) เป็นเว็บหวยเหมือนกันแต่คนละบรีฟ — "ลาวพัฒนา"
// "ฮานอยปกติ/พิเศษ/วีไอพี" "ฝากถอนวอลเลทและธนาคาร" และ "เช็คผลทันที" เป็นของบรีฟ
// รอบก่อน บรีฟรอบนี้ไม่ได้ระบุไว้เลย จึงถอดออกทั้งชุด แทนที่จะ find-and-replace
// ชื่อแบรนด์ทับประโยคเดิม มิฉะนั้นเว็บจะไปอ้างสินค้าที่ไม่มีอยู่
// (คำห้ามจาก brand-spec §6: สล็อต ฟรีสปิน ตัวคูณ ค่ายเกม RTP แตกง่าย เว็บตรง บอล
// ค่าน้ำ อัตราต่อรอง ลีก บิลสเต็ป แฮนดิแคป คาสิโน บาคาร่า ไพ่ เกมยิงปลา)
//
// ตัวเลขที่อ้างได้มีแค่ 100 บาท · 1,000 บาท · 3 ขั้นตอน · 24 ชั่วโมง
// ห้ามเพิ่มชื่อผู้ให้บริการ ชื่อธนาคาร ขั้นต่ำฝากถอน เลขใบอนุญาต ปีที่ก่อตั้ง
// จำนวนสมาชิก หรือ "อันดับ 1" ที่บรีฟไม่ได้ระบุ · บรีฟรอบนี้ไม่มีโปรโมชั่น/โบนัส
// เลยสักรายการ จึงไม่มีหัวข้อโปรโมชั่นในหน้านี้
//
// ประโยค hedge ที่บรีฟเขียนกำกับไว้เองและห้ามตัดทิ้ง: "ไม่จำกัด"/"แทงได้ไม่อั้น"
// ให้อ้างอิงวงเงินที่ระบบเปิดรับจริง · เลขเด็ด/เลขดังไม่รับประกันผลรางวัล ·
// อัตราจ่ายอาจแตกต่างกันตามประเภทหวย ให้ยึดอัตราในหน้าส่งโพยของรอบนั้น ·
// ห้ามเปิดเผยรหัสผ่าน PIN หรือ OTP
//
// พาเลตต์ หวยเฮง789 เป็น **แดงนำ ทองรอง** (brand-spec §2) กลับด้านจากรอบก่อนที่
// ทองเป็นสีนำ: แดงสว่าง #e43434 · แดงแบรนด์ #dc2224 · แดงเข้ม #ab0204 ·
// ขอบแดงเข้มสุด #5c0a0a · ทองอ่อน (หมึกเน้น) #ffefc2 · ทองรอง #f4bc5d ·
// ทองเข้ม (ปลายไล่เฉดใต้หมึกเข้ม) #d99a10 · ทองเข้มสุด (ขอบ/เส้นเท่านั้น) #a8690c ·
// การ์ด #2b0909 · พื้นเซคชัน #1c0606 · เนื้อความ #fbe3d4 (BRAND_TEXT)
// เรืองแสง: แดง rgba(220,34,36,*) · ทอง rgba(244,188,93,*)
// ชุดทองนำของ หวยเฮง24 (#e0a52a #fdea83 #fbdc64 #bd7c13 #2a0606 #1a0505 #f6e6cf
// #3d0808 #2e0707 rgba(224,165,42,*) rgba(192,22,22,*)) ออกครบทุกจุดแล้ว
// ส่วน #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ตามเดิม
// กฎคอนทราสต์: พื้นทอง → หมึกเข้ม #1c0606 และไล่เฉดต้องไม่จบเข้มกว่า #d99a10 ·
// ห้ามวางหมึกเข้มบนแดง #dc2224 (3.4:1 ตก) พื้นแดงใช้หมึกขาว
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลางที่ไม่หมุนตามรอบรีแบรนด์ และรอบนี้
// orchestrator เป็นคนรีธีม) — สีเนื้อความจึงตรงกับที่การ์ดกำหนดไว้อยู่แล้ว
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index และ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า
// และ slide3/slide4/banner2/banner3 เป็นอาร์ตเวิร์กแบรนด์ก่อน ห้าม import (ลำพัง
// การ import ก็ทำให้ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง)
//
// Announcement รอบนี้เป็น Announcement2 ทั้งเว็บ (รอบก่อน หวยเฮง24 ใช้ Announcement5)
// — orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ หวยเฮง789 แล้ว จึง
// เรียกแบบ bare เหมือน index.astro ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะไม่ตรงกัน
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 151
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "เกี่ยวกับเรา หวยเฮง789 เว็บแทงหวยออนไลน์ที่รวมรัฐบาลไทย ฮานอย ลาว และหวยหุ้นต่างประเทศไว้ในบัญชีเดียว หน้านี้สรุปไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง";

const pageTitle = "เกี่ยวกับเรา หวยเฮง789 เว็บแทงหวยออนไลน์ครบทุกประเภทในบัญชีเดียว";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#fbe3d4]">
        <strong class="text-[#ffefc2]">หวยเฮง789</strong> คือ<strong class="text-[#ffefc2]">เว็บแทงหวยออนไลน์ที่เปิดให้เลือกแทงหวยหลายประเภทผ่านบัญชีเดียว</strong>
        รองรับทั้งหวยรัฐบาลไทย หวยฮานอย หวยลาว และหวยหุ้นต่างประเทศ สมาชิกเลือกเลขเด็ด เลขดัง หรือชุดตัวเลขที่สนใจได้ด้วยตัวเอง พร้อมตรวจสอบรอบ อัตราจ่าย และรายละเอียดโพยก่อนยืนยันรายการ
      </p>

      <p class="text-left text-base leading-relaxed text-[#fbe3d4]">
        หน้านี้รวบรวมไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่ประเภทหวยที่เปิดรับในแต่ละรอบ อัตราจ่ายของรายการที่เข้าเงื่อนไข ระบบบัญชีที่ใช้เลือกเลข ส่งโพย ตรวจสอบประวัติรายการและผลของแต่ละรอบ
        ขั้นตอนการสมัคร ไปจนถึงช่องทางสอบถามแอดมินเมื่อไม่แน่ใจในขั้นตอนใด ทั้งหมดใช้งานผ่านมือถือได้จากหน้าเว็บไซต์โดยไม่ต้องสลับใช้งานหลายบัญชี
      </p>

      <p class="text-left text-base leading-relaxed text-[#fbe3d4]">
        <strong class="text-[#ffefc2]">สำหรับคำว่า “ไม่จำกัด” และ “แทงได้ไม่อั้น” ควรอ้างอิงวงเงินที่ระบบเปิดรับจริง</strong>
        เนื่องจากหวยแต่ละประเภท เลขแต่ละชุด และแต่ละรอบอาจกำหนดวงเงินแตกต่างกัน รายละเอียดทั้งหมดในหน้านี้จึงยึดตามข้อมูลที่เว็บไซต์แสดงไว้ในหน้าส่งโพยของรอบนั้นเป็นหลัก
      </p>
    </div>
  </ContentBox>

  <ContentBox title="หวยเฮง789 รวมรัฐบาลไทย ฮานอย ลาว และหวยหุ้นต่างประเทศไว้ในบัญชีเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#fbe3d4]">
        สิ่งที่เว็บไซต์ระบุไว้เป็นตัวตนของ หวยเฮง789 คือ <strong class="text-[#ffefc2]">การรวมรายการหวยที่ได้รับความสนใจไว้หลายรูปแบบในบัญชีเดียว</strong>
        สมาชิกจึงเลือกหวยจากคนละประเภทได้จากบัญชีเดิม ไม่ต้องสลับใช้งานหลายบัญชี และเลือกประเภทหวย ดูเวลาปิดรับ และตรวจสอบอัตราจ่ายก่อนเลือกตัวเลขได้จากที่เดียว
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#fbe3d4]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f4bc5d]">🏛️</span>
          <span>
            <strong class="text-[#ffefc2]">หวยรัฐบาลไทย</strong> เปิดรับตามกำหนดออกรางวัลของแต่ละงวด จึงเป็นกลุ่มที่รอบชัดเจนที่สุดและวางแผนล่วงหน้าได้ง่ายที่สุดสำหรับผู้ที่เพิ่งเริ่มต้น
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f4bc5d]">🕒</span>
          <span>
            <strong class="text-[#ffefc2]">หวยฮานอย</strong> เปิดรับตามรอบที่ระบบเปิดรับ แต่ละรอบมีเวลาปิดรับของตัวเอง จึงควรอ่านชื่อหวยและรอบเวลาให้ตรงกับที่ต้องการก่อนยืนยันโพย
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f4bc5d]">🎫</span>
          <span>
            <strong class="text-[#ffefc2]">หวยลาว</strong> เปิดรับตามรอบที่ระบบเปิดรับเช่นกัน จึงควรดูตารางรอบและเวลาปิดรับจากหน้าส่งโพยของรอบนั้นก่อนเลือกตัวเลขทุกครั้ง
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f4bc5d]">📈</span>
          <span>
            <strong class="text-[#ffefc2]">หวยหุ้นต่างประเทศ</strong> เปิดรับตามตลาดที่ระบบรองรับ จำนวนรายการที่เลือกได้ในแต่ละวันจึงขึ้นอยู่กับตลาดที่เปิดในรอบนั้น
          </span>
        </li>
      </ul>

      <p class="text-left text-base leading-relaxed text-[#fbe3d4]">
        ถัดจากการเลือกรายการคือ<strong class="text-[#ffefc2]">หน้าบัญชีสมาชิกที่ใช้เลือกเลข ส่งโพย ตรวจสอบประวัติรายการ และดูผลของแต่ละรอบ</strong>
        ระบบรองรับการใช้งานผ่านมือถือ จึงติดตามรอบหวย ส่งโพย และตรวจสอบผลได้จากหน้าเว็บไซต์ในที่เดียว แทนการจดแยกไว้เองหรือย้อนถามทีละรายการ
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/ทดลองเล่น"
          aria-label="เปิดหน้าทดลองเล่นของ หวยเฮง789"
          class="flex items-center justify-center rounded-lg border border-[#f4bc5d]/35 bg-[#2b0909] px-8 py-3 font-bold text-[#fbe3d4] transition-all hover:scale-105 hover:border-[#f4bc5d] hover:bg-[#1c0606] hover:text-[#ffefc2]">
          ไปหน้าทดลองเล่น
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="เลขเด็ด เลขดัง เลือกเองได้ตามวงเงินที่ หวยเฮง789 เปิดรับ" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#fbe3d4]">
        ผู้ที่ติดตามเลขเด็ดหรือเลขดังสามารถ<strong class="text-[#ffefc2]">นำตัวเลขมาเลือกแทงตามรูปแบบที่ระบบเปิดรับได้</strong>
        ไม่ต้องรอชุดตัวเลขที่เว็บไซต์จัดไว้ให้ ระบบเปิดให้เลือกชุดตัวเลขที่สนใจด้วยตัวเองแล้วตรวจสอบรายละเอียดโพยก่อนยืนยันรายการ
      </p>

      <p class="text-left text-base leading-relaxed text-[#fbe3d4]">
        <strong class="text-[#ffefc2]">แต่ตัวเลขดังกล่าวไม่สามารถรับประกันผลรางวัลได้</strong>
        ก่อนส่งโพยจึงควรตรวจสอบเลข ยอดเดิมพัน และวงเงินที่รับได้ในรอบนั้น โดยเฉพาะเลขที่มียอดเดิมพันจำนวนมากซึ่งอาจมีข้อจำกัดแตกต่างจากเลขทั่วไป
      </p>

      <p class="text-left text-base leading-relaxed text-[#fbe3d4]">
        ส่วนรายการที่เปิดรับจริงในแต่ละวันนั้น<strong class="text-[#ffefc2]">ขึ้นอยู่กับตารางรอบของหวยแต่ละประเภทและรอบเวลาที่ระบบเปิดรับในขณะนั้น</strong>
        หลังส่งโพยจึงควรตรวจสอบชื่อหวย รอบเวลา ตัวเลขที่เลือก และยอดเดิมพันให้ถูกต้องทุกครั้ง แทนการอ้างจากรอบก่อนหน้าที่เคยเล่นไว้
      </p>
    </div>
  </ContentBox>

  <ContentBox title="อัตราจ่าย หวยเฮง789 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#fbe3d4]">
        หวยเฮง789 <strong class="text-[#ffefc2]">มีอัตราจ่ายสำหรับรายการที่เข้าเงื่อนไข โดยมี 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท</strong>
        ตามประเภทหวยและรูปแบบการเดิมพันที่กำหนด สมาชิกสามารถตรวจสอบอัตราล่าสุดก่อนยืนยันโพย เพื่อให้ทราบรายละเอียดของรายการและอัตราที่ใช้คำนวณอย่างชัดเจน
      </p>

      <p class="text-left text-base leading-relaxed text-[#fbe3d4]">
