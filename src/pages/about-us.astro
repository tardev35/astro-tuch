---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char, so a byte count reads
// ~3x too long). One string, reused by MainLayout's meta and the WebPage node.
const pageDescription =
  "รู้จัก CAMPING289 เว็บสล็อตคนมือโปร เข้าถึงเว็บผ่านลิงก์ตรงหลังสมัคร รวมเกมสล็อตหลากหลายรูปแบบ พร้อมข้อมูลกติกาและแอดมินดูแลผ่าน LINE Official ตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ CAMPING289 สล็อตคนมือโปร เว็บตรง เจ้าของแท้ระดับโลก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา CAMPING289 สล็อตคนมือโปร เว็บตรง เจ้าของแท้ระดับโลก" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ CAMPING289" as="h1">
    <p class="mb-6 text-left text-base leading-relaxed text-[#d6e6cc]">
      <strong class="text-[#b6e87a]">CAMPING289</strong> คือเว็บ <strong class="text-[#b6e87a]">สล็อตคนมือโปร เว็บตรง เจ้าของแท้ระดับโลก</strong>
      ที่ให้บริการสมาชิกซึ่งต้องการเล่นสล็อตออนไลน์ผ่านมือถือและคอมพิวเตอร์ ภายในระบบมีเกมสล็อตหลากหลายรูปแบบให้เลือก พร้อมข้อมูลประกอบการเล่นทั้งกติกา ฟีเจอร์ของเกม
      และแนวทางการบริหารงบประมาณสำหรับผู้เล่น สมาชิกที่สมัครแล้วสามารถเข้าถึงเว็บผ่านลิงก์ตรงได้ทันที โดยไม่ต้องไล่หาทางเข้าจากที่อื่น
    </p>

    <p class="mb-2 text-left text-base leading-relaxed text-[#d6e6cc]">
      สิ่งที่ CAMPING289 ให้ความสำคัญคือความชัดเจนของข้อมูลก่อนตัดสินใจเดิมพัน ทั้งกติกาของเกม เงื่อนไขของโปรโมชั่น และขั้นตอนการใช้งานในระบบ จะแสดงให้อ่านได้ก่อนเข้าร่วมเสมอ
      สมาชิกจึงควรอ่านรายละเอียดตรงจุดนั้นทุกครั้ง เพราะข้อกำหนดของแต่ละรายการไม่เท่ากัน และมีแอดมินคอยให้คำแนะนำตั้งแต่การสมัคร การเข้าสู่ระบบ ไปจนถึงการแก้ไขปัญหาระหว่างใช้งาน
    </p>
  </ContentBox>

  <ContentBoxPlain title="เกมสล็อต CAMPING289 เลือกเล่นได้หลากหลายรูปแบบในบัญชีเดียว" as="h2">
    <p class="mb-2 text-left text-base leading-relaxed text-[#d6e6cc]">
      สมาชิกสามารถเข้าเล่นสล็อต CAMPING289 ผ่านระบบที่รองรับทั้งสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ ภายในมีเกมสล็อตหลายรูปแบบให้เลือก พร้อม
      <strong class="text-[#b6e87a]">ข้อมูลกติกา ฟีเจอร์โบนัส การเลือกขนาดเดิมพัน และแนวทางการกำหนดงบประมาณ</strong> ที่อัปเดตอย่างต่อเนื่อง เพื่อให้ผู้เล่นใช้ประกอบการตัดสินใจได้
      ทั้งนี้ เทคนิคต่าง ๆ เป็นเพียงข้อมูลประกอบการเล่นเท่านั้น ไม่สามารถทำให้เกมสล็อตแตกหรือรับประกันผลกำไรได้ เพราะผลลัพธ์ของแต่ละเกมขึ้นอยู่กับระบบและกติกาของเกมนั้น ๆ
      สมาชิกจึงควรตรวจสอบรายละเอียดที่แสดงในระบบก่อนยืนยันการเดิมพันทุกครั้ง
    </p>
  </ContentBoxPlain>

  <ContentBoxPlain title="สิทธิพิเศษและโปรโมชั่นสำหรับสมาชิก CAMPING289" as="h2">
    <p class="mb-2 text-left text-base leading-relaxed text-[#d6e6cc]">
      สมาชิกสามารถ Login เพื่อตรวจสอบโปรโมชั่น โบนัส และสิทธิพิเศษที่เปิดให้รับในแต่ละวันผ่านบัญชีของตนเอง โดยแต่ละกิจกรรมอาจกำหนด
      <strong class="text-[#b6e87a]">ยอดที่ใช้คำนวณ รอบการรับ และเงื่อนไขแตกต่างกัน</strong> จึงควรอ่านรายละเอียดให้ครบถ้วนก่อนกดรับสิทธิ์
    </p>

    <p class="mt-3 mb-2 text-left text-base leading-relaxed text-[#d6e6cc]">
      สำหรับโปรโมชั่นที่ระบุว่าไม่จำกัด ควรยึด <strong class="text-[#b6e87a]">วงเงินและข้อกำหนดล่าสุดที่แสดงบนหน้าโปรโมชั่น</strong> เป็นหลัก เพื่อให้ทราบรายละเอียดก่อนเข้าร่วมอย่างชัดเจน
      รายการที่เปิดรับอยู่ในขณะนี้ รวมถึงเงื่อนไขของแต่ละรายการ ดูได้จากหน้าโปรโมชั่นของเว็บไซต์ หรือสอบถามแอดมินก่อนกดรับสิทธิ์ทุกครั้ง
    </p>
  </ContentBoxPlain>

  <ContentBoxPlain title="สมัครสมาชิกเองได้บนมือถือ และแอดมิน CAMPING289 ดูแลผ่าน LINE Official ตลอด 24 ชั่วโมง" as="h2">
    <p class="mb-6 text-left text-base leading-relaxed text-[#d6e6cc]">
      <strong class="text-[#b6e87a]">ระบบ CAMPING289</strong> ออกแบบให้สมาชิกเริ่มต้นใช้งานผ่านมือถือได้ด้วยตัวเอง เพียงสมัครสมาชิกผ่านหน้าเว็บไซต์และกรอกข้อมูลที่ระบบกำหนด
      จากนั้น Login เข้าสู่บัญชีเพื่อตรวจสอบช่องทางฝากเครดิตที่เปิดให้บริการ แล้วเลือกเกมสล็อตพร้อมศึกษากติกาและรายละเอียดให้เรียบร้อยก่อนเริ่มเดิมพัน
      หน้าเว็บไซต์รองรับการใช้งานผ่านเว็บเบราว์เซอร์ทั้ง <strong class="text-[#b6e87a]">Android และ iOS รวมถึงแท็บเล็ตและคอมพิวเตอร์</strong>
      ช่วยให้ตรวจสอบบัญชี โปรโมชั่น และรายการต่าง ๆ ได้จากอุปกรณ์ที่สะดวก หากมีข้อสงสัยเกี่ยวกับการสมัครสมาชิก การเข้าสู่ระบบ การฝากถอน โปรโมชั่น หรือวิธีใช้งานส่วนต่าง ๆ
      สามารถติดต่อ <strong class="text-[#b6e87a]">แอดมิน CAMPING289 ผ่าน LINE Official ได้ตลอด 24 ชั่วโมง</strong> พร้อมแจ้งรายละเอียดและเวลาที่ทำรายการ
      เพื่อให้ทีมงานช่วยตรวจสอบรายการและแนะนำขั้นตอนการใช้งานต่อได้รวดเร็วยิ่งขึ้น ทั้งนี้ ควรหลีกเลี่ยงการเชื่อคำแนะนำที่อ้างว่าการันตีกำไรหรือผลรางวัลได้
      เพราะการเดิมพันมีความเสี่ยงเสมอ ควรศึกษากติกาของแต่ละเกมและกำหนดงบประมาณให้เหมาะสมก่อนเดิมพันทุกครั้ง
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก CAMPING289"
        class="flex items-center justify-center rounded-lg bg-gradient-to-r from-[#9ada4e] via-[#69b522] to-[#0b5232] px-8 py-3 font-black text-[#04120a] shadow-[0_0_15px_rgba(105,181,34,0.28)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ CAMPING289"
        class="flex items-center justify-center rounded-lg border border-[#b6e87a]/70 bg-transparent px-8 py-3 font-bold text-[#d6e6cc] transition-all hover:scale-105 hover:border-[#eefae4] hover:bg-[#072a13]/70">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
