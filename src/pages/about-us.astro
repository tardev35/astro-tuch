---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "รู้จัก JEDI66 แบรนด์เกมสล็อตออนไลน์ธีมคาสิโนเมืองยามค่ำคืน รวมค่ายเกมมาตรฐาน รองรับมือถือและคอมพิวเตอร์ ฝากถอนอัตโนมัติ 24 ชั่วโมง พร้อมทีมงานดูแลตลอดเวลา";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ JEDI66 แบรนด์เกมสล็อตออนไลน์",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา JEDI66 แบรนด์เกมสล็อตออนไลน์" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ JEDI66" as="h1">
    <p class="mb-6 text-left text-base leading-relaxed text-[#e0f2fe]">
      <strong class="text-[#e0f2fe]">JEDI66</strong> คือแบรนด์เกมสล็อตออนไลน์ธีมคาสิโนเมืองยามค่ำคืน ชูโทนสีฟ้าไฟฟ้าคู่เงินเมทัลลิก พร้อมลวดลายไพ่ ชิป และสัญลักษณ์ 777 ประจำแบรนด์ รวมเกมจากค่ายมาตรฐานอย่าง PG, Joker, Pragmatic Play, Play'n GO, Habanero และ Live22 ไว้ในบัญชีเดียว รองรับการเข้าใช้งานผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ได้อย่างเต็มรูปแบบ ไม่ว่าจะเป็นระบบ Android, iOS หรือเว็บเบราว์เซอร์บนคอมพิวเตอร์ ก็เข้าเล่นได้ทันทีโดยไม่ต้องติดตั้งโปรแกรมเพิ่มเติม
    </p>

    <p class="mb-8 text-left text-base leading-relaxed text-[#e0f2fe]">
      ด้านการเงิน ระบบฝากถอนอัตโนมัติของ JEDI66 เปิดให้ทำรายการได้ด้วยตนเองตลอด 24 ชั่วโมงโดยไม่ต้องรอเจ้าหน้าที่ทีละราย พร้อมรับอนุญาตจากเจ้าของแบรนด์ต้นฉบับโดยตรง ทำให้มั่นใจได้ในความปลอดภัยของข้อมูลสมาชิกและประวัติการทำรายการ และมีทีมงานคอยดูแลให้คำแนะนำตลอดการเดิมพัน เพื่อให้สมาชิกทุกคนใช้งาน JEDI66 ได้อย่างมั่นใจในทุกขั้นตอน
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก"
        class="flex items-center justify-center rounded-lg border border-[#0ea5e9]/60 bg-gradient-to-b from-[#38bdf8] to-[#0ea5e9] px-8 py-3 font-bold text-white shadow-[0_10px_30px_rgba(14,165,233,0.18)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(7,89,133,0.30)]">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ"
        class="flex items-center justify-center rounded-lg border border-[#0ea5e9]/60 bg-[#050b16] px-8 py-3 font-extrabold text-[#e0f2fe] shadow-[0_4px_14px_rgba(14,165,233,0.18)] transition-transform hover:scale-105 hover:bg-[#0a1628]">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
