---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /promotion, /login, /register)
// หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจากเช็กลิสต์หัวข้อของ docx ที่ใช้กับ
// index.astro — บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึงเขียนขึ้นใหม่
// บนข้อเท็จจริงของ WIN999 เท่านั้น
//
// รอบนี้ (ดรอป 2026-09-29) คือ WIN999 **เว็บคาสิโนออนไลน์** — บาคาร่า สล็อต เกมไพ่
// และเกมอื่นตามค่ายที่ระบบรองรับ ส่วนแบรนด์ก่อนหน้าเป็นเว็บล็อตเตอรีออนไลน์ที่ขาย
// อัตราจ่ายตัวเลข รอบจับรางวัล ใบแทง และคำว่าไม่ผ่านคนกลาง — คำชุดนั้นถูกถอดออก
// ทั้งหมด ห้าม find-and-replace ชื่อแบรนด์ทับประโยคเดิม มิฉะนั้นเว็บคาสิโนจะไปอ้าง
// สินค้าคนละตัวซึ่งไม่มีอยู่ในบรีฟรอบนี้เลยสักคำ
//
// ข้อเท็จจริงทุกบรรทัดมาจากบรีฟรอบนี้เท่านั้น (src/assets/content.txt): ให้บริการ
// เกมคาสิโนออนไลน์ผ่านระบบเว็บไซต์ รองรับมือถือ แท็บเล็ต คอมพิวเตอร์ · รวมบาคาร่า
// สล็อต เกมไพ่ และเกมอื่นตามค่ายที่ระบบรองรับ · Login ผ่านเว็บเบราว์เซอร์ เลือกหมวด
// เดิมพันจากบัญชีเดียว · ตรวจสอบเครดิต ประวัติรายการ และรายละเอียดเกมได้ด้วยตัวเอง ·
// ฝากถอนผ่านระบบบัญชีบริษัท ก่อนฝากควรตรวจชื่อบัญชี จำนวนเงิน ข้อมูลปลายทาง ·
// รายการถอนควรตรวจสถานะและเก็บหลักฐานไว้จนเสร็จสมบูรณ์ · ทางเข้าล่าสุดควรบันทึกจาก
// ช่องทางหลัก · สมัครเอง 3 ขั้นตอน · โบนัสคืนยอดเสีย 0.3% · โบนัสแนะนำเพื่อน 0.8% ·
// แอดมินตอบแชท 24 ชั่วโมง
// — ห้ามอ้างคำชุดล็อตเตอรีทั้งหมด (ดูรายการเต็มใน brand-spec §8) รวมถึงเลขใบอนุญาต
// ปีที่ก่อตั้ง เลขทะเบียนบริษัท จำนวนสมาชิก ชื่อธนาคาร ชื่อค่ายเกมเจาะจง RTP
// เครดิตฟรี หรือคำโฆษณาแบบ "เว็บตรง/มาตรฐานสากล" ที่บรีฟสั่งห้ามใช้เป็นหลักฐาน
//
// บรีฟระบุข้อจำกัดไว้ตรง ๆ สองข้อและต้องคงไว้: การเปิด 24 ชั่วโมงขึ้นกับสถานะของ
// เว็บไซต์และค่ายเกม (ห้ามรับประกันว่าไม่มีปิดปรับปรุง) และคำว่า "ไม่เสี่ยงโดนอายัด"
// รับประกันไม่ได้จากประเภทบัญชีเพียงอย่างเดียว — หน้านี้จึงเขียนเป็นสิ่งที่ควรตรวจสอบ
// ไม่ใช่คำรับประกัน
//
// พาเลตต์ WIN999 เป็น **ทองบนดำ** ตามโลโก้ (WIN ทอง #fcc403 / 999 ขาว) และแบนเนอร์
// พื้นดำที่มีริ้วแสงทอง ตารางแมปอยู่ที่ brand-spec §2: ทองสว่าง #fdda04 · ทองแบรนด์
// #fcc403 · ทองกลาง #e0a800 · ทองลึก #8a6502 · พื้นเพจ #050505 · ผิวการ์ด #101010 ·
// ผิวการ์ดอุ่น #191712 · เนื้อความ #e9e4d6 (BRAND_TEXT) · เน้นใน strong #fffbea ·
// ตัวอักษรบนพื้นทอง #120d02 · แสงเรือง rgba(252,196,3,*)
// ชุดแดง-ทองบนพื้นแดงเกือบดำของแบรนด์ก่อน (รายการ hex เต็มอยู่ใน brand-spec §2)
// ถูกแทนครบทุกจุดแล้ว ทั้งคลาส Tailwind, raw hex และ rgba() ที่ใช้ทำแสงเรือง
// ส่วน #00B900 บนปุ่ม LINE เป็นสีประจำแบรนด์ LINE ไม่ใช่สีของเว็บ จึงคงไว้ตามเดิม
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลางที่ไม่หมุนตามรอบรีแบรนด์ และรอบนี้
// orchestrator เป็นคนรีธีม) — สีเนื้อความจึงตรงกับที่การ์ดกำหนดไว้อยู่แล้ว
//
// หน้านี้ไม่ลิงก์ไปสองหน้าล็อตเตอรีที่จอดอยู่ใน src/pages-disabled/ เพราะรอบนี้เป็น
// แบรนด์คาสิโน ทั้งสองจึงต้องปิดอยู่ — href ที่ชี้ route ซึ่งไม่มีใน dist/ จะทำให้
// verify-build แดง
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: slide1/slide2 ของดรอปนี้เป็นของ index และ /promotion
// ส่วน banner1/banner1-mobile/og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า
// และ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กค้างของแบรนด์ก่อน ห้าม import
//
// Announcement รอบนี้หมุนจากตัวของแบรนด์ก่อนมาเป็น AnnouncementPremium ทั้งเว็บ —
// orchestrator ตั้ง default message ของไฟล์นั้นเป็นคอปปี้ของ WIN999 แล้ว จึงเรียก
// แบบ bare เหมือน index.astro ห้ามส่ง prop message มิฉะนั้นตัววิ่งจะไม่ตรงกันทั้งเว็บ
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ การนับไบต์จะยาวเกินจริง ~3 เท่า)
// สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node — หน้านี้ยาว 156
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = "เกี่ยวกับ WIN999 เว็บคาสิโนออนไลน์ที่รวมบาคาร่า สล็อต และเกมไพ่ไว้ในบัญชีเดียว ฝากถอนผ่านบัญชีบริษัท ตรวจเครดิตและโปรโมชั่นได้เอง พร้อมแอดมินดูแล 24 ชั่วโมง";

const pageTitle = "เกี่ยวกับเรา WIN999 เว็บคาสิโนออนไลน์ เล่นจากบัญชีเดียวได้ทุกหมวด";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e9e4d6]">
        <strong class="text-[#fffbea]">WIN999</strong> คือเว็บ<strong class="text-[#fffbea]">คาสิโนออนไลน์ที่ให้บริการผ่านระบบเว็บไซต์</strong>
        รองรับการใช้งานทั้งบนมือถือ แท็บเล็ต และคอมพิวเตอร์ สมาชิกเลือกเกม ตรวจสอบเครดิต ดูโปรโมชั่น และจัดการฝากถอนได้จากบัญชีเดียว ตลอดช่วงเวลาที่ระบบเปิดให้บริการ
      </p>

      <p class="text-left text-base leading-relaxed text-[#e9e4d6]">
        หน้านี้รวบรวมไว้ว่าภายในเว็บไซต์มีอะไรให้ใช้งานบ้าง ตั้งแต่หมวดเกมที่เปิดให้เลือก ช่องทางฝากถอนผ่านระบบบัญชีบริษัท ไปจนถึงโปรโมชั่นที่ตรวจสอบเงื่อนไขได้จากบัญชีสมาชิก
        ขั้นตอนการสมัคร และช่องทางสอบถามแอดมินเมื่อไม่แน่ใจในขั้นตอนใด
      </p>

      <p class="text-left text-base leading-relaxed text-[#e9e4d6]">
        <strong class="text-[#fffbea]">หมวดเกมที่เปิดให้เล่น เงื่อนไขของโปรโมชั่น และสถานะของระบบเปลี่ยนแปลงได้ตามช่วงเวลา</strong>
        รายละเอียดทั้งหมดจึงยึดตามข้อมูลที่เว็บไซต์แสดงไว้จริงในขณะนั้นเป็นหลัก และควรตรวจสอบรายการล่าสุดจากช่องทางอย่างเป็นทางการของเว็บไซต์ก่อนทำธุรกรรมทุกครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="WIN999 รวมบาคาร่า สล็อต และเกมไพ่ไว้ในบัญชีเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e9e4d6]">
        สิ่งที่เว็บไซต์ระบุไว้เป็นตัวตนของ WIN999 คือ <strong class="text-[#fffbea]">การรวมเกมคาสิโนออนไลน์หลายรูปแบบไว้ในระบบเดียว</strong>
        ทั้งบาคาร่า สล็อต เกมไพ่ และเกมอื่นตามค่ายที่ระบบรองรับ สมาชิก Login ผ่านเว็บเบราว์เซอร์แล้วสลับหมวดเดิมพันได้จากบัญชีเดียว โดยไม่ต้องเปิดเว็บไซต์เพิ่มทีละหมวด
      </p>

      <p class="text-left text-base leading-relaxed text-[#e9e4d6]">
        ถัดจากตัวเกมคือ<strong class="text-[#fffbea]">หน้าบัญชีสมาชิกที่รวมเครดิต ประวัติรายการ และรายละเอียดเกมไว้ให้ตรวจสอบได้ด้วยตัวเอง</strong>
        การติดตามว่ารายการไหนทำไปแล้วและเครดิตคงเหลือเท่าไรจึงทำได้ต่อเนื่อง ไม่ต้องจดแยกไว้เองหรือย้อนถามทีละรายการ
      </p>

      <p class="text-left text-base leading-relaxed text-[#e9e4d6]">
        การเปิดให้บริการตลอด 24 ชั่วโมงขึ้นอยู่กับสถานะของเว็บไซต์และผู้ให้บริการเกม
        <strong class="text-[#fffbea]">หากบางค่ายมีการปิดปรับปรุง สมาชิกอาจเข้าเกมนั้นไม่ได้เป็นการชั่วคราว</strong>
        กรณีแบบนี้ควรตรวจสอบประกาศล่าสุดของเว็บไซต์ก่อน แล้วค่อยเลือกหมวดอื่นที่ยังเปิดให้บริการอยู่
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ระบบฝากถอน WIN999 ผ่านบัญชีบริษัท ตรวจสอบก่อนโอนทุกครั้ง" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e9e4d6]">
        ระบบฝากถอนของ WIN999 ให้สมาชิก<strong class="text-[#fffbea]">ทำรายการและติดตามสถานะเครดิตผ่านบัญชีของตนเอง</strong>
        ก่อนฝากเงินควรตรวจสอบชื่อบัญชี จำนวนเงิน และข้อมูลปลายทางให้ตรงกับรายละเอียดที่เว็บไซต์แสดงไว้ ส่วนรายการถอนควรตรวจสถานะผ่านระบบและเก็บหลักฐานธุรกรรมไว้จนกว่าจะดำเนินการเสร็จสมบูรณ์
      </p>

      <p class="text-left text-base leading-relaxed text-[#e9e4d6]">
        เมื่อเว็บไซต์ระบุว่าเป็นบัญชีบริษัท สิ่งที่ตรวจสอบได้จริงคือ<strong class="text-[#fffbea]">ชื่อนิติบุคคลปลายทางต้องตรงกับข้อมูลผู้ให้บริการที่เว็บไซต์เปิดเผยไว้</strong>
        ส่วนข้อความว่าไม่เสี่ยงโดนอายัดนั้นรับประกันจากประเภทบัญชีเพียงอย่างเดียวไม่ได้ เพราะบัญชีธนาคารถูกจำกัดหรือระงับได้จากหลายสาเหตุ หากชื่อบัญชีไม่ตรงหรือมีการเปลี่ยนบัญชีผิดปกติ ควรหยุดทำรายการแล้วยืนยันข้อมูลกับช่องทางหลักก่อน
      </p>
    </div>
  </ContentBox>

  <ContentBox title="โปรโมชั่น WIN999 คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e9e4d6]">
        โปรโมชั่นหลักตามข้อมูลที่กำหนดมีสองรายการ คือ <strong class="text-[#fffbea]">โบนัสคืนยอดเสีย 0.3%</strong>
        สำหรับสมาชิกที่มียอดเสียตรงตามเงื่อนไขในรอบที่เว็บไซต์กำหนด และ <strong class="text-[#fffbea]">โบนัสแนะนำเพื่อน 0.8%</strong> ซึ่งคำนวณจากยอดใช้งานของเพื่อนที่สมัครผ่านลิงก์แนะนำส่วนตัวและเข้าเกณฑ์ที่ระบบกำหนด
      </p>

      <p class="text-left text-base leading-relaxed text-[#e9e4d6]">
        ทั้งสองรายการมี<strong class="text-[#fffbea]">รอบตัดยอด ประเภทเกมที่นับ ยอดที่เข้าเกณฑ์ และข้อกำหนดการรับที่ต่างกัน</strong>
        สมาชิกตรวจสอบสิทธิ์และยอดคำนวณของตัวเองได้จากบัญชีสมาชิก และควรอ่านรายละเอียดล่าสุดของรายการที่สนใจให้ครบก่อนกดรับโบนัสทุกครั้ง
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/promotion"
          aria-label="ดูภาพโปรโมชั่นทั้งหมดของ WIN999"
          class="flex items-center justify-center rounded-lg border border-[#fcc403]/80 bg-[#101010] px-8 py-3 font-bold text-[#e9e4d6] transition-all hover:scale-105 hover:border-[#fdda04] hover:bg-[#191712] hover:text-[#fdda04]">
          ดูโปรโมชั่นทั้งหมด
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title="สมัครสมาชิก WIN999 ด้วยตัวเองแค่ 3 ขั้นตอน" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#e9e4d6]">
        การสมัคร WIN999 <strong class="text-[#fffbea]">ทำผ่านหน้าเว็บไซต์ได้ด้วยตัวเอง โดยแบ่งเป็น 3 ขั้นตอนหลัก</strong>
        หลังยืนยันบัญชีเรียบร้อยสามารถ Login เข้าไปเลือกหมวดเกมที่ต้องการได้ทันที พร้อมตรวจสอบช่องทางฝากเงินและโปรโมชั่นที่เปิดให้รับในขณะนั้น
      </p>

      <ol class="ml-6 list-decimal space-y-2 text-left text-base leading-relaxed text-[#e9e4d6] marker:font-black marker:text-[#fcc403]">
        <li>เปิดหน้าสมัคร WIN999 แล้วกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน</li>
        <li>ยืนยันข้อมูลหรือเบอร์โทรศัพท์ตามขั้นตอนที่ระบบแจ้งไว้</li>
