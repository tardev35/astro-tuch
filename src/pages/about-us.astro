---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็นบทความจริง (ไม่ใช่หน้าปุ่มแบบ /contact-us, /ทางเข้า, /login,
// /register, /promotion) หัวข้อย่อยจึงมาจากตัวบทความของหน้าเอง ไม่ได้มาจาก
// เช็กลิสต์หัวข้อ docx ที่ใช้กับ index.astro — บรีฟรอบนี้ (src/assets/content.txt)
// ไม่มีส่วน SUB-PAGES ที่ให้ body มา ทั้งหน้าจึงเขียนจากข้อเท็จจริงและคลังคำของ
// บรีฟรอบนี้เท่านั้น (.claude/brand-spec-prodeee168.md)
//
// ผังหัวข้อของหน้านี้: h1x1 · h2x4 · h3x0
//   h1  เกี่ยวกับเรา <แบรนด์> เว็บรวมข้อมูลเกมสล็อตลิขสิทธิ์แท้ไว้ในที่เดียว
//   h2  ข้อมูลเกมสล็อตที่ <แบรนด์> รวบรวมไว้ให้ศึกษาก่อนเลือกใช้งาน
//   h2  โปรโมชั่นของ <แบรนด์> คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%
//   h2  ขั้นตอนสมัครสมาชิกและเข้าสู่ระบบของ <แบรนด์>
//   h2  ช่องทางติดต่อแอดมิน <แบรนด์> ตลอด 24ชม.
// รายการในกล่องเป็น <ul>/<ol> จึงไม่ต้องมี h3 — บทความนี้ไม่มีชั้นย่อยจริง
// (ขั้นตอนสมัครสามขั้นของบรีฟลงเป็น <ol> ไม่ใช่สาม h3 เพราะเป็นลำดับขั้น ไม่ใช่
// สามหัวข้อย่อยที่มีบทความของตัวเอง)
// หน้านี้ลิงก์จาก navbar (เกี่ยวกับเรา 🐰) จึงเปิดใช้งานอยู่
//
// มีสำเนาของไฟล์ชื่อเดียวกันจอดอยู่ที่ src/pages-disabled/about-us.astro ด้วย —
// ตัวที่ routing จริงคือไฟล์นี้ Astro ไม่อ่านโฟลเดอร์นั้นเลย ห้ามแก้และห้ามลบ
//
// 🚨 แกนของดรอปนี้ (2026-10-21/22) คือ **เว็บสล็อตออนไลน์ล้วน** — "โปรดี168
// สล็อตแท้โปรเด็ด มัดรวมเกมสล็อตลิขสิทธิ์แท้ ค่ายตรงมาแรง" พร้อมโปรโมชั่น
// คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · ขั้นตอนสมัคร 3 ขั้น · แอดมิน 24ชม.
// ⚠️⚠️ **รอบก่อน (รวยแท้168) เป็นเว็บหวยล้วน** คำกลุ่มหวยทุกคำที่เจอในไฟล์นี้จึง
// เป็นคำค้างของแบรนด์ขาออก ไม่ใช่ของรอบนี้ (รายการเต็มอยู่ใน brand-spec §1
// ไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep ของรอบถัดไปเจอ false positive ในคอมเมนต์
// ของไฟล์นี้เอง) และหมวดบาคาร่า/คาสิโนสด/ยิงปลา/ไฮโล/บอล ก็ไม่มีในบรีฟรอบนี้เลย
// **ห้ามเติมกลับเข้ามาแม้แต่คำเดียว**
//
// ⚠️⚠️ **/ตรวจหวย กับ /แนวทาง ถูกย้ายไป src/pages-disabled/ รอบนี้แล้ว** (รอบนี้
// เป็นเว็บสล็อต) → ลิงก์ไปสอง route นั้นจะทำให้ build แดง ห้ามเขียนกลับมา
// route ที่มีจริงรอบนี้: / · /promotion · /register · /login · /ทางเข้า ·
// /ทดลองเล่น · /about-us · /contact-us · /terms · /privacy · /line
//
// 🚨 บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกม ชื่อธนาคาร ผู้ให้บริการ ใบอนุญาต
// นิติบุคคล ปีก่อตั้ง จำนวนสมาชิก ค่า RTP หรือยอดฝากขั้นต่ำ แม้แต่รายการเดียว**
// จึงห้ามเขียนลงหน้าเว็บ · ตัวเลขที่ขึ้นหน้าได้มีแค่ของบรีฟเอง:
// **0.3% · 0.8% · 24ชม. · ปี 2026**
//
// คลังคำที่บรีฟรอบนี้ให้มาและใช้ได้เท่านี้: เกมสล็อตออนไลน์ · ค่ายเกม ·
// ลิขสิทธิ์แท้ · ค่ายตรง · รูปแบบเกม · ฟีเจอร์พิเศษ · ตารางจ่ายรางวัล ·
// เงื่อนไขการเดิมพัน · กติกาการเล่น · ช่วงเดิมพันขั้นต่ำ · บริการสมาชิก ·
// สถานะลิขสิทธิ์ · หลักฐานทางการ · หลักฐานการได้รับอนุญาตจากเจ้าของเกม ·
// คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · เครดิต · ยอดเสีย · ยอดเดิมพัน ·
// รอบคำนวณเครดิต · รอบสรุปยอด · วิธีรับสิทธิ์ · ลิงก์แนะนำ · เชื่อมโยงบัญชี ·
// ไม่จำกัดยูสต่อวัน · สมัครสมาชิก · ลงทะเบียน · เปิดบัญชี · คุณสมบัติผู้สมัคร ·
// ข้อมูลส่วนบุคคล · รหัสผ่าน · รหัส OTP · เข้าสู่ระบบ · รายการฝากถอน ·
// เจ้าหน้าที่ · แอดมิน · 24ชม. · เว็บไซต์ทางการ · ประกาศล่าสุด ·
// บุคคลที่แอบอ้างชื่อบริการ · อัปเดตก่อนสิ้นปี 2026
//
// 🚨 ประโยคกำกับความเสี่ยงของบรีฟที่ต้องขึ้นครบ (เป็นเนื้อหาของบรีฟ ไม่ใช่
// filler ให้ตัดทิ้ง):
// 1) ควรตรวจสอบสถานะลิขสิทธิ์ของเกมและข้อมูลผู้ให้บริการจากหลักฐานทางการก่อน
//    ใช้งาน (h1)
// 2) รายชื่อค่ายเกมและรายการที่เปิดให้บริการอาจเปลี่ยนแปลงได้ จึงควรตรวจสอบ
//    ข้อมูลล่าสุด รวมถึงหลักฐานการได้รับอนุญาตจากเจ้าของเกมก่อนตัดสินใจ (h2 #1)
// 3) เครดิตคืนยอดเสียไม่ได้รับประกันว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือทำกำไร
//    ได้ในครั้งต่อไป · แม้ระบุว่าไม่จำกัด แต่ควรยืนยันจำนวนบัญชีที่เข้าร่วม
//    รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัส · ควรตรวจสอบว่ารับสิทธิ์ร่วมกันได้
//    หรือไม่ (h2 #2)
// 4) ไม่ควรใช้ข้อมูลของบุคคลอื่นหรือเปิดเผยรหัส OTP ให้ใครทราบ · จำนวนบัญชีที่
//    เปิดรับต่อวันและข้อจำกัดการสมัครควรตรวจสอบจากประกาศของผู้ให้บริการโดยตรง
//    (h2 #3)
// 5) ตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชี
//    หรือบุคคลที่แอบอ้างชื่อบริการ · ไม่เปิดเผยรหัสผ่านหรือรหัส OTP ·
//    ควรตรวจสอบเวลาการให้บริการและระยะเวลาตอบกลับล่าสุดจากประกาศทางการอีกครั้ง
//    (h2 #4)
// ⚠️ บรีฟไม่ได้การันตีผลลัพธ์ใดๆ — คอปปี้หน้านี้จึงไม่สัญญากำไรและไม่สัญญาว่า
// ถอนได้ชัวร์
//
// 🚨 พาเลตรอบนี้ (brand-spec §2) เป็น **ธีมสว่าง** bg.json ของดรอปนี้คือ
// {"mode":"color","color":"#ffd1d1"} = ชมพูพาสเทลสว่าง ไม่ใช่ดำ
// **ห้าม "แก้" กลับไปเป็นพื้นเข้มเพราะรอบก่อนๆ เป็นแบบนั้น**
// ค่าที่ใช้ได้ในไฟล์นี้: แดงเข้ม #9b0a0c (<strong>/marker — 8.6:1 บนผิวการ์ดขาว) ·
// หมึกน้ำตาลแดง #401107 (เนื้อความ = BRAND_TEXT, 16.1:1) · แดงเชอร์รี่ #eb0305
// (พื้นถม/ขอบ/ออรา — ขาวบนพื้นนี้ได้ 4.6:1) · ทองแดงไหม้ #b44c06 (5.3:1 ถือ
// ตัวอักษรได้) · ทองแดงเข้ม #7a2f03 (9.4:1) · ขาว #ffffff (ตัวอักษรบนพื้นถม) ·
// อินเซ็ต #fff4ea / พื้นเพจ #ffd1d1
// 🚨 **แดงสด ff4446 ห้ามถือตัวอักษรและห้ามเป็นพื้นของตัวอักษร** เป็น stop ของ
// ไล่เฉด/ออราได้อย่างเดียว · สีไฮไลต์ <strong> ในเนื้อความมีตัวเดียวคือ #9b0a0c
// 🚨 **#ffd1d1 และ #fff4ea ห้ามถือตัวอักษรบนพื้นขาว** เป็นสีพื้น/ขอบเท่านั้น
// 🚨 **ทองสาลี่ f0b46a ห้ามใช้ในไฟล์นี้เลยสักจุด** — บนผิวการ์ดขาวได้แค่ 1.8:1
// ทองสาลี่เป็นสีของโครม (navbar/footer/ticker/Navfoot) เท่านั้น
// ออราที่อนุญาต: rgba(235,3,5,α) · rgba(155,10,12,α) · rgba(180,76,6,α) ·
// rgba(122,47,3,α) · rgba(64,17,7,α)
// ⚠️ รอบนี้ไม่มีเขียว (ยกเว้น LINE green) ไม่มีชมพูบานเย็น ไม่มีฟ้า/น้ำเงิน/
// ไซยาน ไม่มีม่วง ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์ ·
// #00B900 บนปุ่ม LINE เป็นสีประจำแพลตฟอร์ม ไม่ใช่สีของเว็บ ห้ามเปลี่ยนเป็นแดง
// ⚠️ แดงกับทองนำมาแล้วหลายแบรนด์ในรีโปนี้ รวมถึงรอบก่อนที่เป็นแดง+ทอง+ธีมสว่าง
// ชมพูเหมือนกัน — **ห้ามเทียบด้วยวงศ์สี ต้องเทียบทีละค่า** กับตาราง brand-spec §2
//
// ลำดับปุ่มในไฟล์นี้สื่อด้วยพื้นถมสามขั้ว:
// · ปุ่มหลัก (สมัครสมาชิก) ถมไล่เฉดแดง #eb0305 -> #c20305 -> #9b0a0c ตัวอักษรขาว
// · ปุ่มรอง (เข้าสู่ระบบ) ถมไล่เฉดทองแดง #b44c06 -> #7a2f03 ตัวอักษรขาว
// · ปุ่มลิงก์ภายในเป็นอินเซ็ต #fff4ea ขอบแดงโปร่ง ตัวอักษรหมึกน้ำตาลแดง
//   hover ยกขอบเป็นแดงทึบ (ตรงกับ hover ของการ์ด ContentBox)
// · ชิปไอคอนของรายการใช้แดงเชอร์รี่เป็น **เส้นขอบ** บนอินเซ็ต #fff4ea ไม่ถือตัวอักษร
//
// หน้านี้อยู่บน ContentBox.astro (ไฟล์กลาง always-live ที่ orchestrator รีธีมใน P1)
// การ์ดตั้ง text-left text-base leading-relaxed + สีเนื้อความ (= BRAND_TEXT
// #401107, 16.1:1 บนผิวการ์ดขาว) ไว้ที่ตัวการ์ดแล้ว ย่อหน้าในหน้านี้จึงไม่
// ประกาศสีของตัวเอง ปล่อยให้สืบทอดลงมา และไม่ใส่ mx-auto / max-w-* บน <p> เพราะ
// การ์ดคุมความกว้างเองแล้ว (เพิ่มไปจะเหมือนย่อหน้าเยื้อง) — ที่ประกาศสีได้มีแค่
// ปุ่ม (ถมพื้นของตัวเองจึงต้องกำหนดหมึกของตัวเอง) ชิปไอคอน marker ของลำดับเลข
// และ <strong> ซึ่ง brand-spec §2 สงวนแดงเข้ม #9b0a0c ไว้เป็นสีไฮไลต์ใน
// เนื้อความเพียงสีเดียว · แต่ละ <strong> ครอบ "ช่วงที่คั่นด้วยช่องว่าง" ทั้งช่วง
// เพราะภาษาไทยไม่เว้นวรรคระหว่างคำ ถ้าเปิด/ปิดแท็กกลางคำ บรรทัดจะตัดในแท็กและคำ
// จะขาดครึ่ง (ลบแท็ก <strong> ออกแล้วคอปปี้ต้องอ่านได้เหมือนเดิม) และห้ามวาง
// <strong> สองอันติดกัน
// emoji ตกแต่งอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความเสมอ
// ห้ามฝังใน prop ที่เป็นข้อความ
//
// ไม่มีรูปในหน้านี้โดยตั้งใจ: ดรอปนี้ไม่มี article illustration เลย
// (banner2/banner3 เป็นอาร์ตเวิร์กของแบรนด์คนละราย เก่าทั้งคู่) ส่วน
// slide1/slide2 ถูกตรึงไว้กับ index กับ /promotion และ banner1 /
// banner1-mobile / og.png เป็นของ glob ที่ MainLayout ปักไว้ ห้ามอ้างจากหน้า ·
// slide3/slide4 เป็นโปสเตอร์ของอีกแบรนด์ ห้าม import (ลำพังการ import ก็ทำให้
// ไฟล์ถูก emit ลง dist/ และ verify-build จะแดง) — ไฟล์ยังอยู่บนดิสก์ ห้ามลบ
//
// Announcement รอบนี้หมุนมาเป็น AnnouncementPremium ทั้งเว็บ (brand-spec §3 —
// รอบก่อนใช้ Announcement5 จึงหมุนออก) orchestrator ตั้ง default message ของไฟล์
// นั้นเป็นคอปปี้ของแบรนด์นี้แล้ว จึงเรียกแบบ bare **ห้ามส่ง prop message**
// มิฉะนั้นตัววิ่งจะพูดคนละเรื่องกับหน้าอื่น
//
// 150–160 CHARACTERS (ไม่ใช่ไบต์ — ภาษาไทย 3 ไบต์ต่ออักขระ และ wc -m บนเชลล์นี้
// ก็นับเป็นไบต์เช่นกัน ให้วัดด้วย node -e 'console.log([...s].length)' ซึ่งตรงกับ
// ตัวนับของ verify-build) สตริงเดียว ใช้ทั้ง meta ของ MainLayout และ WebPage node
// — หน้านี้ยาว 158 อักขระ (ชื่อแบรนด์รอบนี้ 8 ตัวอักษร) เป็นประโยคเดียวที่บอกว่า
// หน้านี้มีอะไร แล้วหยุด
// (Google ตัดราว 155 การเติมอนุประโยคต่อไปเรื่อยๆ คือสาเหตุที่รอบก่อนยาวเกิน)
//
// ห้ามใส่ "&" ในสตริงนี้: Astro serialize เป็น &#38; ในแอตทริบิวต์ content ทำให้
// ตัวนับของ verify-build เห็นเป็น 5 อักขระ ไม่ใช่ 1
const pageDescription = `เกี่ยวกับเรา ${BRAND_NAME} หน้ารวมข้อมูลเกมสล็อตที่เว็บไซต์รวบรวมไว้ ทั้งรูปแบบเกม ตารางจ่ายรางวัล เงื่อนไขการเดิมพัน โปรโมชั่น ขั้นตอนสมัคร และช่องทางติดต่อแอดมิน`;

const pageTitle = `เกี่ยวกับเรา ${BRAND_NAME} เว็บรวมข้อมูลเกมสล็อตลิขสิทธิ์แท้ไว้ในที่เดียว`;

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="flex flex-col gap-5">
      <p>
        <strong class="text-[#9b0a0c]">{BRAND_NAME} นำเสนอเกมสล็อตออนไลน์หลากหลายรูปแบบ พร้อมรวบรวมข้อมูลค่ายเกม โปรโมชั่น และบริการสมาชิกไว้ในเว็บไซต์เดียว</strong>
        ผู้ใช้งานสามารถเลือกศึกษารายละเอียดเกมสล็อตที่สนใจ ตรวจสอบกติกาและเงื่อนไขการเดิมพัน รวมถึงติดตามข้อมูลโปรโมชั่นที่ประกาศก่อนสิ้นปี 2026 ได้สะดวก หน้านี้รวบรวมไว้ว่าเว็บไซต์ระบุอะไรไว้บ้าง
        เพื่อให้เห็นภาพรวมก่อนว่าต้องเปิดอ่านอะไรตรงไหน แล้วจึงค่อยไล่อ่านรายละเอียดของแต่ละหัวข้อเป็นรายข้อ
      </p>

      <p>
        สิ่งที่หน้านี้ทำได้คือชี้ว่าข้อมูลแต่ละชุดอยู่ตรงไหนและควรอ่านอะไรก่อน
        <strong class="text-[#9b0a0c]">โดยสิ่งที่ควรดูให้ชัดเจนทุกครั้งคือกติกาของเกมที่สนใจ และเงื่อนไขการเดิมพันที่เกมนั้นกำหนดไว้</strong>
        เพราะเกมสล็อตแต่ละรายการมีรูปแบบและเงื่อนไขของตัวเอง ไม่ได้ใช้ชุดเดียวกันทั้งหมด
      </p>

      <p>
        เนื้อหาในหน้านี้เขียนไว้ประกอบการใช้งานเท่านั้น ไม่ได้ใช้แทนรายละเอียดและเงื่อนไขที่เว็บไซต์แสดงอยู่ตรงหน้าในขณะใช้บริการ
        <strong class="text-[#9b0a0c]">โดยควรตรวจสอบสถานะลิขสิทธิ์ของเกมและข้อมูลผู้ให้บริการจากหลักฐานทางการก่อนใช้งาน</strong>
      </p>
    </div>
  </ContentBox>

  <ContentBox title={`ข้อมูลเกมสล็อตที่ ${BRAND_NAME} รวบรวมไว้ให้ศึกษาก่อนเลือกใช้งาน`} as="h2">
    <div class="flex flex-col gap-6">
      <p>
        {BRAND_NAME} นำเสนอข้อมูลเกมสล็อตจากค่ายต่าง ๆ สำหรับผู้ที่ต้องการติดตามเกมและโปรโมชั่นในช่วงปลายปี 2026
        <strong class="text-[#9b0a0c]">โดยสามารถศึกษารูปแบบเกม ฟีเจอร์พิเศษ ตารางจ่ายรางวัล และเงื่อนไขการเดิมพันก่อนเลือกใช้งานได้</strong>
        นอกจากนี้ยังมีข้อมูลโปรโมชั่นสำหรับสมาชิกให้ตรวจสอบตามประกาศของเว็บไซต์ รายการด้านล่างคือชุดข้อมูลที่ควรไล่อ่านให้ครบก่อนตัดสินใจ
      </p>

      <ul class="flex flex-col gap-4" aria-label="ชุดข้อมูลของเกมสล็อตที่เว็บไซต์ระบุไว้ให้ศึกษา">
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#eb0305]/50 bg-[#fff4ea] text-sm">🎰</span>
          <span>
            <strong class="text-[#9b0a0c]">รูปแบบเกม</strong> ควรอ่านว่าเกมที่สนใจเล่นด้วยรูปแบบใด และมีกติกาการเล่นอย่างไร เพราะเกมแต่ละรายการวางรูปแบบไว้ไม่เหมือนกัน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#eb0305]/50 bg-[#fff4ea] text-sm">✨</span>
          <span>
            <strong class="text-[#9b0a0c]">ฟีเจอร์พิเศษ</strong> ควรดูว่าเกมนั้นเปิดฟีเจอร์อะไรไว้ และฟีเจอร์นั้นมีเงื่อนไขการเข้าถึงหรือไม่ ก่อนเลือกใช้งาน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#eb0305]/50 bg-[#fff4ea] text-sm">📋</span>
          <span>
            <strong class="text-[#9b0a0c]">ตารางจ่ายรางวัล</strong> ควรอ่านควบคู่กับรูปแบบเกมเสมอ เพราะเป็นข้อมูลที่เกมแต่ละรายการกำหนดไว้ของตัวเอง ไม่ใช่ค่ากลางที่ใช้ร่วมกัน
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#eb0305]/50 bg-[#fff4ea] text-sm">📑</span>
          <span>
            <strong class="text-[#9b0a0c]">เงื่อนไขการเดิมพันและช่วงเดิมพันขั้นต่ำ</strong> ควรตรวจสอบก่อนเริ่มทุกครั้ง เพื่อให้ทราบล่วงหน้าว่าเกมนั้นกำหนดอะไรไว้
          </span>
        </li>
      </ul>

      <p>
        <strong class="text-[#9b0a0c]">ทั้งนี้ รายชื่อค่ายเกมและรายการที่เปิดให้บริการอาจเปลี่ยนแปลงได้</strong>
        จึงควรตรวจสอบข้อมูลล่าสุด รวมถึงหลักฐานการได้รับอนุญาตจากเจ้าของเกมก่อนตัดสินใจ ไม่ควรตัดสินจากข้อความโฆษณาเพียงอย่างเดียว
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/ทดลองเล่น"
          aria-label={`เปิดหน้าทดลองเล่นของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#eb0305]/45 bg-[#fff4ea] px-8 py-3 font-bold text-[#401107] shadow-[0_4px_14px_rgba(64,17,7,0.15)] transition-all hover:scale-105 hover:border-[#eb0305] hover:shadow-[0_6px_18px_rgba(235,3,5,0.3)]">
          ไปหน้าทดลองเล่น
        </a>

        <a
          href="/ทางเข้า"
          aria-label={`เปิดหน้าทางเข้าของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#eb0305]/45 bg-[#fff4ea] px-8 py-3 font-bold text-[#401107] shadow-[0_4px_14px_rgba(64,17,7,0.15)] transition-all hover:scale-105 hover:border-[#eb0305] hover:shadow-[0_6px_18px_rgba(235,3,5,0.3)]">
          ไปหน้าทางเข้า
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`โปรโมชั่นของ ${BRAND_NAME} คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} นำเสนอโปรโมชั่นสำหรับสมาชิกที่สนใจสิทธิพิเศษจากการใช้บริการเกมสล็อตออนไลน์ โดยรายการหลักที่ระบุไว้ประกอบด้วย
        <strong class="text-[#9b0a0c]">รายการคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8%</strong>
        ซึ่งแต่ละรายการอาจมีเงื่อนไขเกี่ยวกับยอดเดิมพัน รอบคำนวณเครดิต และวิธีรับสิทธิ์แตกต่างกัน ก่อนเข้าร่วมจึงควรตรวจสอบรายละเอียดจากประกาศล่าสุด รวมถึงข้อจำกัดในการใช้โบนัสและการรับโปรโมชั่นร่วมกัน
      </p>

      <p>
        รายการคืนยอดเสียระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขในแต่ละวัน
        <strong class="text-[#9b0a0c]">สมาชิกควรตรวจสอบว่าเกมสล็อตประเภทใดเข้าร่วมรายการ มีรอบสรุปยอดเวลาใด และเครดิตจะเข้าสู่บัญชีโดยอัตโนมัติหรือต้องกดรับด้วยตนเอง</strong>
        รวมถึงศึกษาข้อกำหนดเกี่ยวกับการนำเครดิตไปใช้และการถอนเงินก่อนเข้าร่วม ทั้งนี้ เครดิตคืนยอดเสียไม่ได้รับประกันว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือทำกำไรได้ในครั้งต่อไป
      </p>

      <p>
        ส่วนรายการแนะนำเพื่อนระบุสิทธิ์ไว้สำหรับสมาชิกที่แนะนำผู้ใช้งานรายใหม่ โดยควรตรวจสอบขั้นตอนการรับลิงก์แนะนำ วิธีเชื่อมโยงบัญชี และยอดที่ใช้คำนวณโบนัสให้ครบถ้วน
        <strong class="text-[#9b0a0c]">แม้โปรโมชั่นจะระบุว่าไม่จำกัด แต่ควรยืนยันข้อกำหนดเกี่ยวกับจำนวนบัญชีที่เข้าร่วม รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุด</strong>
        เพื่อให้เข้าใจหลักเกณฑ์การรับสิทธิ์อย่างถูกต้อง และหลีกเลี่ยงความคลาดเคลื่อนเกี่ยวกับยอดเครดิตที่ได้รับ
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/promotion"
          aria-label={`ดูภาพโปรโมชั่นทั้งหมดของ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#eb0305]/45 bg-[#fff4ea] px-8 py-3 font-bold text-[#401107] shadow-[0_4px_14px_rgba(64,17,7,0.15)] transition-all hover:scale-105 hover:border-[#eb0305] hover:shadow-[0_6px_18px_rgba(235,3,5,0.3)]">
          ดูภาพโปรโมชั่น
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`ขั้นตอนสมัครสมาชิกและเข้าสู่ระบบของ ${BRAND_NAME}`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} มีช่องทางสำหรับผู้ที่ต้องการศึกษาวิธีลงทะเบียนสมาชิกและเข้าสู่ระบบเกมสล็อตออนไลน์ โดยสามารถตรวจสอบขั้นตอนการสมัครจากเว็บไซต์ทางการ
        <strong class="text-[#9b0a0c]">ก่อนลงทะเบียนควรอ่านข้อกำหนดเกี่ยวกับคุณสมบัติผู้สมัคร การเปิดบัญชี และการจัดเก็บข้อมูลส่วนบุคคลให้ครบถ้วน</strong>
        ลำดับด้านล่างคือสามขั้นที่เว็บไซต์ระบุไว้
      </p>

      <ol class="ml-6 list-decimal space-y-3 marker:font-black marker:text-[#9b0a0c]">
        <li>
          <strong class="text-[#9b0a0c]">เข้าสู่หน้าสมัครสมาชิก</strong> ตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง จากนั้นเลือกเมนูสมัครสมาชิกและอ่านรายละเอียดเกี่ยวกับเงื่อนไขการเปิดบัญชี รวมถึงข้อกำหนดการใช้บริการก่อนดำเนินการ
        </li>
        <li>
          <strong class="text-[#9b0a0c]">กรอกข้อมูลและยืนยันการลงทะเบียน</strong> กรอกข้อมูลตามที่ระบบกำหนด ตรวจสอบความถูกต้องก่อนยืนยัน และตั้งรหัสผ่านที่ปลอดภัย ไม่ควรใช้ข้อมูลของบุคคลอื่นหรือเปิดเผยรหัส OTP ให้ใครทราบ
        </li>
        <li>
          <strong class="text-[#9b0a0c]">เข้าสู่ระบบและตรวจสอบรายละเอียดเกม</strong> หลังลงทะเบียนเรียบร้อย สามารถศึกษารายชื่อค่ายเกมสล็อต กติกาการเล่น ช่วงเดิมพันขั้นต่ำ และรายละเอียดโปรโมชั่นที่เปิดให้บริการ
          หากพบข้อสงสัยควรติดต่อเจ้าหน้าที่ผ่านช่องทางทางการก่อนทำรายการ
        </li>
      </ol>

      <p>
        <strong class="text-[#9b0a0c]">ส่วนจำนวนบัญชีที่เปิดรับต่อวันและข้อจำกัดการสมัครควรตรวจสอบจากประกาศของผู้ให้บริการโดยตรง</strong>
        เพราะเป็นเงื่อนไขที่ปรับเปลี่ยนได้ตามที่เว็บไซต์กำหนด และไม่ใช่สิ่งที่หน้านี้ยืนยันแทนได้
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label={`สมัครสมาชิก ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#9b0a0c] bg-gradient-to-b from-[#eb0305] via-[#c20305] to-[#9b0a0c] px-8 py-3 font-black text-white shadow-[0_0_14px_rgba(235,3,5,0.45)] transition-transform hover:scale-105">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label={`เข้าสู่ระบบ ${BRAND_NAME}`}
          class="flex items-center justify-center rounded-lg border border-[#7a2f03] bg-gradient-to-b from-[#b44c06] to-[#7a2f03] px-8 py-3 font-bold text-white shadow-[0_0_12px_rgba(122,47,3,0.4)] transition-transform hover:scale-105">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBox>

  <ContentBox title={`ช่องทางติดต่อแอดมิน ${BRAND_NAME} ตลอด 24ชม.`} as="h2">
    <div class="flex flex-col gap-5">
      <p>
        {BRAND_NAME} ระบุช่องทางติดต่อเจ้าหน้าที่สำหรับผู้ใช้งานที่ต้องการสอบถามเกี่ยวกับการสมัครสมาชิก การเข้าสู่ระบบ รายการฝากถอน และโปรโมชั่นต่าง ๆ
        <strong class="text-[#9b0a0c]">โดยควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีหรือบุคคลที่แอบอ้างชื่อบริการ</strong>
        หากพบปัญหาในการทำรายการ ควรเตรียมข้อมูลและหลักฐานที่เกี่ยวข้องไว้สำหรับตรวจสอบ พร้อมแจ้งรายละเอียดให้ชัดเจน โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP
      </p>

      <p>
        <strong class="text-[#9b0a0c]">ทั้งนี้ ควรตรวจสอบเวลาการให้บริการและระยะเวลาตอบกลับล่าสุดจากประกาศทางการอีกครั้ง</strong>
        เพราะช่วงเวลาที่เจ้าหน้าที่รับเรื่องอาจปรับเปลี่ยนได้ตามที่ผู้ให้บริการกำหนด
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/line"
          aria-label={`ติดต่อเจ้าหน้าที่ ${BRAND_NAME} ผ่าน Line Official`}
          class="flex items-center justify-center gap-2 rounded-lg border border-[#00B900] bg-[#00B900] px-8 py-3 font-black text-white shadow-[0_0_15px_rgba(0,185,0,0.35)] transition-transform hover:scale-105">
          <span aria-hidden="true">💬</span>
          ติดต่อผ่าน Line Official
        </a>

        <a
          href="/contact-us"
          aria-label={`ดูช่องทางติดต่อทีมงาน ${BRAND_NAME} ทั้งหมด`}
          class="flex items-center justify-center rounded-lg border border-[#eb0305]/45 bg-[#fff4ea] px-8 py-3 font-bold text-[#401107] shadow-[0_4px_14px_rgba(64,17,7,0.15)] transition-all hover:scale-105 hover:border-[#eb0305] hover:shadow-[0_6px_18px_rgba(235,3,5,0.3)]">
          ช่องทางติดต่อทั้งหมด
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
