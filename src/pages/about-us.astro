---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import ContentBoxPlain from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char, so a byte count reads
// ~3x too long). One string, reused by MainLayout's meta and the WebPage node.
const pageDescription =
  "รู้จัก JADTEM88 สล็อตเครือยักษ์ใหญ่ เซิร์ฟนอก ที่รวมเกมสล็อต บาคาร่า และคาสิโนสดจากหลายค่ายไว้ในบัญชีเดียว ไม่ล็อกรางวัล พร้อมแอดมินดูแลผ่าน LINE Official";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ JADTEM88 สล็อตเครือยักษ์ใหญ่ เซิร์ฟนอก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา JADTEM88 สล็อตเครือยักษ์ใหญ่ เซิร์ฟนอก ปลอดภัย เชื่อถือได้" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ JADTEM88" as="h1">
    <p class="mb-6 text-left text-base leading-relaxed text-[#cbd5e1]">
      <strong class="text-[#60a5fa]">JADTEM88</strong> คือ <strong class="text-[#60a5fa]">สล็อตเครือยักษ์ใหญ่ที่ให้บริการผ่านเซิร์ฟเวอร์ต่างประเทศ</strong>
      พร้อมให้บริการสมาชิกที่ต้องการเล่นคาสิโนและเกมสล็อตออนไลน์ผ่านระบบที่รองรับทั้งมือถือและคอมพิวเตอร์ ภายในระบบมีเกมจากหลากหลายค่ายให้เลือกในบัญชีเดียว
      พร้อมโปรโมชั่นสำหรับสมาชิกใหม่ ระบบสมัครใช้งานไม่ซับซ้อน และมีแอดมินคอยให้คำแนะนำเกี่ยวกับการสมัคร ฝากถอน โปรโมชั่น และปัญหาการใช้งานผ่าน LINE Official
    </p>

    <p class="mb-2 text-left text-base leading-relaxed text-[#cbd5e1]">
      สิ่งที่ JADTEM88 ให้ความสำคัญคือความชัดเจนของข้อมูลก่อนตัดสินใจเดิมพัน ทั้งกติกาของเกม ฟีเจอร์ อัตราเดิมพัน เงื่อนไขของโปรโมชั่น และขั้นตอนการใช้งานในระบบ
      จะแสดงให้อ่านได้ก่อนเข้าร่วมเสมอ สมาชิกจึงควรอ่านรายละเอียดตรงจุดนั้นทุกครั้ง เพราะข้อกำหนดของแต่ละรายการไม่เท่ากัน
      เกมทุกเกมทำงานตามระบบของผู้ให้บริการแต่ละค่ายโดยตรง <strong class="text-[#60a5fa]">ไม่มีการล็อกรางวัล</strong> และไม่มีการแทรกแซงผลจากทางเว็บไซต์
    </p>
  </ContentBox>

  <ContentBoxPlain title="รวมเกมคาสิโนและสล็อต JADTEM88 จากหลายค่ายไว้ในบัญชีเดียว" as="h2">
    <p class="mb-2 text-left text-base leading-relaxed text-[#cbd5e1]">
      JADTEM88 รวบรวมเกมเดิมพันออนไลน์หลากหลายประเภทไว้ภายในระบบเดียว ทั้ง
      <strong class="text-[#60a5fa]">เกมสล็อต บาคาร่า คาสิโนสด รูเล็ต เสือมังกร แบล็กแจ็ก</strong> และเกมยอดนิยมจากหลายค่าย
      สมาชิกสามารถเลือกเกมผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ พร้อมตรวจสอบกติกา ฟีเจอร์ อัตราเดิมพัน และรายละเอียดของแต่ละเกมก่อนเริ่มเล่นได้จากหน้าเกมโดยตรง
      การรวมทุกค่ายไว้ในบัญชีเดียวทำให้ไม่ต้องโยกเครดิตไปมาระหว่างค่าย และสลับไปเล่นเกมของอีกค่ายได้ทันทีจากหน้าเดียวกัน
    </p>

    <p class="mt-3 mb-2 text-left text-base leading-relaxed text-[#cbd5e1]">
      ผลลัพธ์และรางวัลของเกมขึ้นอยู่กับระบบและกติกาของผู้ให้บริการแต่ละราย ไม่มีรูปแบบการเดิมพันใดสามารถรับประกันรางวัลหรือผลกำไรได้
      จึงควรกำหนดงบประมาณและศึกษารายละเอียดของเกมให้ครบถ้วนก่อนเดิมพันทุกครั้ง
    </p>
  </ContentBoxPlain>

  <ContentBoxPlain title="โปรโมชั่นสมาชิกใหม่ JADTEM88 ตรวจสอบเงื่อนไขได้ก่อนกดรับ" as="h2">
    <p class="mb-2 text-left text-base leading-relaxed text-[#cbd5e1]">
      สมาชิกใหม่สามารถตรวจสอบโปรโมชั่น JADTEM88 ที่เปิดให้รับหลังสมัครผ่านหน้าเว็บไซต์ ไม่ว่าจะเป็น
      <strong class="text-[#60a5fa]">โบนัสสมาชิกใหม่ โบนัสยอดฝาก หรือสิทธิพิเศษจากกิจกรรมที่กำลังเปิดให้บริการ</strong>
      ระบบจะแสดงรายละเอียดของโปรโมชั่นและสิทธิ์ที่บัญชีสามารถรับได้ เพื่อช่วยให้ตรวจสอบข้อมูลก่อนตัดสินใจกดรับ
    </p>

    <p class="mt-3 mb-2 text-left text-base leading-relaxed text-[#cbd5e1]">
      โปรโมชั่นแต่ละรายการอาจกำหนด <strong class="text-[#60a5fa]">ยอดฝาก ระยะเวลารับสิทธิ์ ยอดเทิร์น หรือเงื่อนไขการถอน</strong> แตกต่างกัน
      แนะนำให้อ่านรายละเอียดให้ครบถ้วนก่อนเข้าร่วมทุกครั้ง เพื่อให้ทราบสิทธิ์ที่ได้รับและข้อกำหนดที่ต้องทำตามอย่างชัดเจน
    </p>
  </ContentBoxPlain>

  <ContentBoxPlain title="สมัครเองได้บนมือถือ และแอดมิน JADTEM88 ดูแลผ่าน LINE Official" as="h2">
    <p class="mb-6 text-left text-base leading-relaxed text-[#cbd5e1]">
      ผู้ใช้งานใหม่สามารถสมัคร JADTEM88 ผ่านมือถือได้ด้วยตนเอง โดยไม่ต้องติดตั้งโปรแกรมเพิ่มเติม เริ่มต้นง่ายเพียง
      <strong class="text-[#60a5fa]">3 ขั้นตอน</strong> คือเข้าหน้าสมัครสมาชิกและกรอกข้อมูลที่ระบบกำหนดให้ครบถ้วน จากนั้น Login เข้าสู่บัญชี ฝากเครดิต
      และตรวจสอบโปรโมชั่นสำหรับสมาชิกใหม่ แล้วจึงเลือกค่ายและเกมที่ต้องการ ศึกษากติกาให้เรียบร้อยก่อนเริ่มเดิมพัน
      หลังสมัครเรียบร้อย สามารถจัดการบัญชี ตรวจสอบเครดิต ฝากถอน ติดตามโปรโมชั่น และดูประวัติรายการผ่านระบบสมาชิกได้จากอุปกรณ์ที่สะดวก
      หากพบปัญหาเกี่ยวกับการสมัครสมาชิก Login ไม่ได้ เครดิตไม่เข้า ฝากถอนล่าช้า โปรโมชั่นไม่แสดง หรือเข้าเกมไม่ได้ สามารถติดต่อ
      <strong class="text-[#60a5fa]">แอดมิน JADTEM88 ผ่าน LINE Official</strong> ของเว็บไซต์ พร้อมแจ้งรายละเอียดของปัญหาและเวลาที่ทำรายการ
      เพื่อให้ทีมงานตรวจสอบข้อมูลและแนะนำขั้นตอนแก้ไขได้ตรงจุด
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก JADTEM88"
        class="flex items-center justify-center rounded-lg bg-gradient-to-r from-[#e2e8f0] via-[#93c5fd] to-[#60a5fa] px-8 py-3 font-black text-[#03060f] shadow-[0_0_15px_rgba(59,130,246,0.28)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ JADTEM88"
        class="flex items-center justify-center rounded-lg border border-[#60a5fa]/70 bg-transparent px-8 py-3 font-bold text-[#cbd5e1] transition-all hover:scale-105 hover:border-[#f1f5f9] hover:bg-[#0a142c]/70">
        เข้าสู่ระบบ
      </a>
    </div>
  </ContentBoxPlain>
  <Navfoot />
</MainLayout>
