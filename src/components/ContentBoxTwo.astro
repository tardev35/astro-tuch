---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🔐", iconright = "🎰" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a game-list panel),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
// LoginRtpSection renders it without a title, which is why the page's heading
// inventory stops at the docx's own sections.
//
// Reached only through LoginRtpSection (a nested import), so a grep for
// "components/ContentBoxTwo.astro" in src/pages/ finds nothing — it is LIVE, not
// inventory, and has to carry the current brand's colours.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// แตกดี168 (รอบฟ้าสด-เหลืองมะนาวบนกรมท่าเกือบดำ 2026-10-08, brand-spec §2):
// โลโก้รอบนี้เป็นคำว่า แตกดี สีเหลืองมะนาวแบนๆ วางเหนือเลข 168 สีฟ้าสด มีสองฮิวจริง
// ต่างจากทองเมทัลลิกฮิวเดียวของ 789BETTING รอบก่อน สองคอลัมน์ของกล่องนี้จึงถูกแยก
// ด้วย "คู่สี" ตรงๆ ไม่ใช่ด้วยระดับความสว่างของโลหะเดียว: ฝั่งซ้ายเป็นแผ่นฟ้าทึบ
// ไล่ฟ้าซีด #d4ecfd → ฟ้าอ่อน #7bcffb → ฟ้าแบรนด์ #0193fb บนหมึกเข้ม #031018
// (11.2:1 บน #7bcffb และ 6.0:1 บน #0193fb — §2 ห้ามพลิกแผ่นสีสดไปใช้หมึกสว่าง)
// ป้ายคอลัมน์เป็นฟ้าอ่อน ส่วนฝั่งขวาเป็นแผ่นกรมท่าลึก ไล่ผิวยก #0a1726 → ผิวลึกสุด
// #020609 ในกรอบฟ้าเข้ม #064a86 บนไอคอนเหลืองมะนาว #fce604 ป้ายคอลัมน์เป็นเหลือง
// มะนาว ซึ่งใช้เป็นสีตัวอักษรบนพื้นมืดได้ (14.1:1 บนผิวยก)
// หัวข้อ docx (เมื่อมีการส่ง title มา) ไล่ฟ้าซีด #d4ecfd → ฟ้าอ่อน #7bcffb →
// เหลืองมะนาว #fce604 เส้นคั่นเป็นฟ้าเข้ม #064a86 ทั้งสองฝั่ง สันหัวข้อไล่ฟ้าอ่อน →
// ฟ้าแบรนด์ → ฟ้าเข้ม เนื้อความ #dbeafe (= BRAND_TEXT)
//
// ไอคอนเริ่มต้นเป็น 🔐 / 🎰 — รอบนี้เป็นเว็บสล็อตออนไลน์ล้วน ไม่ใช่คาสิโนรวมหรือ
// เว็บหวย (LoginRtpSection ส่งไอคอนมาเองอยู่แล้ว ค่านี้คือกันหลงเท่านั้น)
//
// ชุดทองเมทัลลิกของ 789BETTING ที่เคยค้างในไฟล์นี้ (#fad354 #ffe79a #ddab33
// #8a6410 #c9881f #4a3407 #17130a #060402 #0a0802 #f3e7cd rgba(250,211,84,…))
// ออกครบทุกจุดแล้ว
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#064a86] pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#7bcffb] via-[#0193fb] to-[#064a86] shadow-[0_0_10px_rgba(1,147,251,0.6)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#d4ecfd] via-[#7bcffb] to-[#fce604] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dbeafe]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#064a86] pb-3 text-xl leading-normal font-black tracking-widest text-[#7bcffb] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#0b6fc4] bg-gradient-to-br from-[#d4ecfd] via-[#7bcffb] to-[#0193fb] text-sm text-[#031018] shadow-[0_5px_15px_rgba(1,147,251,0.4)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dbeafe]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#064a86] pb-3 text-xl leading-normal font-black tracking-widest text-[#fce604] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#064a86] bg-gradient-to-br from-[#0a1726] to-[#020609] text-sm text-[#fce604] shadow-[0_5px_15px_rgba(0,0,0,0.6)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
