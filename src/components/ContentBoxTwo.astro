---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🔐", iconright = "🎲" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a channel panel),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
// LoginRtpSection renders it without a title, which is why the page's heading
// inventory stops at the docx's own sections.
//
// Reached ONLY through LoginRtpSection this round (index.astro does not import
// it directly — the docx's two-column section went to ContentBoxTwoCyberCut and
// its three-column one to ContentBox3ThreePremium).
// A grep for "components/ContentBoxTwo.astro" in src/pages/ therefore finds
// nothing, and that does NOT mean it is inventory: match the bare filename
// instead. It is LIVE and has to carry this brand's colours.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// TND168 (รอบทองมังกรบนดำสนิท 2026-10-12, brand-spec §2):
// โลโก้เป็นเหรียญตรากลมทอง กลางเหรียญเป็นมังกรจีนขดตัวหล่อทองขัดเงาสามมิติ พาดกลาง
// เป็น TND168 ตัวพิมพ์ใหญ่หนาแบบ serif ทองขัดเงา งานอาร์ตเป็นฉากคาสิโนดำ-ทองล้วน —
// คู่นายแบบ-นางแบบผมขาวเงินในชุดสูทดำแต่งทอง ริบบิ้นแสงทอง ชิปดำขอบทอง ไพ่เอซทอง
// ลูกเต๋าทอง วงล้อรูเล็ต กองเหรียญทอง
// ⚠️ รอบนี้เป็น **ฮิวเดียวล้วน** ไม่ใช่คู่สองฮิวแบบ PUNPRO168 รอบก่อน (ชมพู+ทอง) และ
// ไม่ใช่ทองสองระดับแบบ TIGERWIN369 — ทองหลัก #dfa310 เป็นสีเดียวของแบรนด์ ส่วน
// #ffe4a3 กับ #c9b88e เป็นค่าอื่นของทองเดียวกัน
// กล่องนี้ไม่มีการ์ดครอบ มันวางสองคอลัมน์ลงบนพื้นเพจ **ดำสนิท #000000** ตรงๆ จึงเป็น
// จังหวะ "โปร่ง" ของหน้า คั่นหลังบล็อกเนื้อหาของบรีฟทั้งแปดส่วน
// ⚠️ พื้นเพจรอบนี้ดำสนิท จึงไม่มีชั้นไหนจมต่ำกว่าพื้นได้ — #070502 คือก้นสุดที่ใช้ได้
// และเป็นพื้นของช่องกรอกกับแถวรายการ
// สองคอลัมน์ถูกแยกด้วยคู่ "แผ่นทองทึบ vs แผ่นมืดกรอบทอง" ซึ่งเป็นวิธีแยกคอลัมน์ที่ยัง
// ใช้ได้เมื่อมีฮิวเดียว: ฝั่งซ้ายเป็นแผ่นทองไล่ทองสว่าง #ffe4a3 → ทองหลัก #dfa310 บน
// หมึก #140d02 (§2 ระบุว่านี่คือหมึกตัวเดียวที่วางบนพื้นถมทองได้ ได้ 8.7:1 บน #dfa310
// — ห้ามพลิกแผ่นทองไปใช้หมึกสว่าง และห้ามไล่ลงไปถึง #8a5c09 ใต้ตัวอักษร) ป้ายคอลัมน์
// ซ้ายเป็นทองหลัก #dfa310 (7.6:1) ส่วนฝั่งขวาเป็นแผ่นมืดทึบ ไล่ผิวกลาง #120c04 → ผิว
// จม #070502 ในกรอบทองสว่างบนไอคอนทองสว่าง #ffe4a3 ป้ายคอลัมน์ขวาเป็นทองสว่าง
// #ffe4a3 (13.5:1)
// — §2 ห้าม #8a5c09 / #43240b ถือตัวอักษรที่ไหนเลย และ #ffc93d สงวนไว้ให้ <strong>
// ในย่อหน้าเท่านั้น จึงไม่โผล่ในไฟล์นี้
// หัวข้อ docx (เมื่อมีการส่ง title มา) ไล่ทองทราย #c9b88e → ทองหลัก #dfa310 → ทอง
// สว่าง #ffe4a3 เส้นคั่นเป็นบรอนซ์ลึก #43240b ทั้งสองฝั่ง สันหัวข้อไล่ทองสว่าง →
// ทองหลัก → บรอนซ์ลึก เนื้อความงาช้างอุ่น #f0e9dc (= BRAND_TEXT) — ~18:1 บนพื้นเพจ
//
// ไอคอนเริ่มต้นเป็น 🔐 / 🎲 — รอบนี้เป็น **คาสิโนออนไลน์รวมทุกหมวด** (บาคาร่า สล็อต
// รูเล็ต ไฮโล แทงบอล + คาสิโนไลฟ์สด) ไม่ใช่เว็บสล็อตล้วนแบบ PUNPRO168 จึงไม่ใช้ 🎰
// เป็นค่าตั้งต้นอีก และลูกเต๋าทองมาจากอาร์ตเวิร์กโดยตรง (LoginRtpSection ส่งไอคอนมา
// เองอยู่แล้ว ค่านี้คือกันหลง)
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือทอง** ทองมาแล้วเก้าใน
// สิบเอ็ดรอบ "มีทองอยู่แล้ว" จึงไม่พิสูจน์อะไร: ชุดชมพูฮอตพิงก์-ทองของ PUNPRO168 ที่
// เคยค้างอยู่ทั้งไฟล์นี้ (#f41571 #ff5ca8 #fce343 #ffd94a #f0c3dc #fde7f2 #8a0a45
// #4a0426 #2a0012 #4a1038 #3a0a2a #2e0022 #1c0014) ชุดทองอำพันเสือของ TIGERWIN369
// (#d98324 #f7b733 #ffd98a #f7e4c0 #e3cfae #8a5214 #4a2a08 #1a0d02 #2d1c0a #1c1206
// #0f0903) ชุดทองแชมเปี้ยน-เงินโครเมียมของ UFA324 (#e5a81b #b9c2cc #231c0e #17130a
// #f0e8d4 #ffe08a #7d5a07 #43300a #464f5a #8792a0) ชุดชมพูฮอต-ทองของ FAH999 (#ff3fa4
// #ff6cbb #ffd1ea #fde8f3 #f5c53d #7a0046 #4a0b42 #3a0534 #2e002c) ชุดทองเป็ด-ส้ม
// ปากเป็ดของ DUCK1688 (#f3bb34 #fde464 #1a1203) ชุดทองอวกาศ-เงินโครเมียมของ NAZA168
// (#fbc134 #cfd6e3 #241700) และชุดทองสายฟ้า-แดงของ FLASH877 (#f5c518 #ffdd73 #ff3b14)
// ออกครบทุกจุดแล้ว
// ⚠️ "มีทองอยู่แล้ว" ไม่พิสูจน์อะไรเลย — #e5a81b #f5c53d #fbc134 #f3bb34 #f5c518
// #ddab33 ไม่มีตัวไหนเป็น #dfa310 และ #ffd98a / #ffe08a / #ffdd73 ไม่ใช่ #ffe4a3
// ⚠️ **รอบนี้ไม่มีชมพู ไม่มีม่วง/พลัม ไม่มีเงิน/เทา ไม่มีเขียว ไม่มีน้ำเงิน ไม่มี
// ส้มอำพัน และไม่มีแดงเลย** #b9c2cc #f2f5f9 #8792a0 #464f5a #cfd6e3 #eef2f8 #3f4859
// ต้องไม่เหลืออยู่ในไฟล์นี้
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#43240b] pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe4a3] via-[#dfa310] to-[#43240b] shadow-[0_0_10px_rgba(223,163,16,0.6)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#c9b88e] via-[#dfa310] to-[#ffe4a3] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e9dc]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#43240b] pb-3 text-xl leading-normal font-black tracking-widest text-[#dfa310] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#8a5c09] bg-gradient-to-br from-[#ffe4a3] to-[#dfa310] text-sm text-[#140d02] shadow-[0_5px_15px_rgba(223,163,16,0.4)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e9dc]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#43240b] pb-3 text-xl leading-normal font-black tracking-widest text-[#ffe4a3] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#ffe4a3]/60 bg-gradient-to-br from-[#120c04] to-[#070502] text-sm text-[#ffe4a3] shadow-[0_5px_15px_rgba(0,0,0,0.7)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
