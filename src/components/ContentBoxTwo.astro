---
export interface Props {
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { titleleft, titleright, label } = Astro.props;

// This box carries chrome (a login widget, a service list), never docx article
// content, so both column labels render as <p> and the section gets its
// accessible name from aria-label instead of a heading.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e4d9f5]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#a855f7]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#d8a7ff] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#a855f7]/50 bg-gradient-to-br from-[#d8a7ff] via-[#a855f7] to-[#2c046a] text-sm text-[#060210] shadow-[0_5px_15px_rgba(168,85,247,0.32)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e4d9f5]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#b3b8c2]/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#e6e8ec] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#b3b8c2]/60 bg-gradient-to-br from-[#e6e8ec] via-[#b3b8c2] to-[#a897c4] text-sm text-[#060210] shadow-[0_5px_15px_rgba(230,232,236,0.28)]">
              🎰
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
