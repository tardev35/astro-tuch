---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a service list),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#6d1750]/65 pb-4">
        <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e5399f] to-[#22c6f0] shadow-[0_0_10px_rgba(229,57,159,0.55)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#f4ebff] via-[#22c6f0] to-[#e5399f] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dfd0ee]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#e5399f]/50 pb-3 text-xl leading-normal font-black tracking-widest text-[#ff35b4] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#e5399f]/55 bg-gradient-to-br from-[#ff35b4] via-[#e5399f] to-[#6d1750] text-sm text-[#f4ebff] shadow-[0_5px_15px_rgba(229,57,159,0.32)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dfd0ee]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#a48fc4]/55 pb-3 text-xl leading-normal font-black tracking-widest text-[#22c6f0] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#22c6f0]/60 bg-gradient-to-br from-[#6ee7ff] via-[#22c6f0] to-[#0e5a72] text-sm text-[#08030f] shadow-[0_5px_15px_rgba(34,198,240,0.3)]">
              🎲
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
