---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🔐", iconright = "🎫" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a lottery
// เปิดรับ/ตรวจก่อนส่งโพย panel), never docx article content, so both column
// labels render as <p> and the section gets its accessible name from aria-label
// instead of a heading. With a `title` the heading itself names the region, so
// the aria-label is dropped. LoginRtpSection renders it without a title this
// round, which is why the page's heading inventory stops at the ten docx
// sections.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// LOTTOPLUS (รอบแดง-ทอง-ดำ 2026-09-29): โลโก้เป็นตัวอักษรขาวบนบล็อกแดง #dc020e
// บนแบนเนอร์พื้นดำที่มีริ้วแสงแดง ลูกหวยแดง-ขาว เหรียญทองและมงกุฎทอง สองคอลัมน์ของ
// กล่องนี้จึงถูกแยกด้วยคู่แดง/ทองนั้นตรงๆ — ฝั่งซ้ายเป็นแดงเต็มใบ ป้ายไอคอนไล่จาก
// แดงสว่าง #ff2d38 ลงแดงแบรนด์ ไปหาแดงลึก #6b0207 ตัวอักษรบนป้ายแดงเป็นขาว
// (5.17:1) ตามกฎคอนทราสต์ — ห้ามใช้หมึกเข้มบนแดง ส่วนฝั่งขวาเป็นทองบนพื้นดำ ป้าย
// ไอคอนเป็นทองเต็มใบบนหมึกเข้ม #1a0203 (12.4:1) หัวข้อ docx (เมื่อมีการส่ง title
// มา) ไล่ทองอ่อน #fde79a → ทองรอง #f3c623 → แดงแบรนด์ เส้นคั่นเป็นแดงลึกทั้งสอง
// ฝั่ง เนื้อความ #f0e2e2 (BRAND_TEXT) — ชุดทอง-ดำของ WIN999 ที่ค้างในไฟล์นี้
// (#fcc403 #fdda04 #8a6502 #4a3402 #120d02 #191712 #e9e4d6) ออกทั้งหมด
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#6b0207] pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fde79a] via-[#f3c623] to-[#dc020e] shadow-[0_0_10px_rgba(220,2,14,0.5)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#fde79a] via-[#f3c623] to-[#dc020e] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e2e2]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#6b0207] pb-3 text-xl leading-normal font-black tracking-widest text-[#ff2d38] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#ff2d38]/70 bg-gradient-to-br from-[#ff2d38] via-[#dc020e] to-[#6b0207] text-sm text-white shadow-[0_5px_15px_rgba(220,2,14,0.4)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e2e2]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#6b0207] pb-3 text-xl leading-normal font-black tracking-widest text-[#f3c623] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#f3c623]/70 bg-gradient-to-br from-[#fde79a] via-[#f3c623] to-[#8a6a0a] text-sm text-[#1a0203] shadow-[0_5px_15px_rgba(243,198,35,0.4)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
