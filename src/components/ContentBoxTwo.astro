---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a service list),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// LOTTOKA palette: the left column badge is the logo's solid red (the LOTTO
// wordmark), the right column badge is the cream of the outlined KA — so the two
// halves are told apart by brightness inside one hue. No gold, no navy, no
// second colour: this brand is red on near-black.
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#c21e22]/40 pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ff9a9d] via-[#e2353a] to-[#7d1114] shadow-[0_0_10px_rgba(194,30,34,0.55)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#ff9a9d] via-[#e2353a] to-[#ffe9ea] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ded9da]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#c21e22]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#ff9a9d] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#c21e22]/70 bg-gradient-to-br from-[#ff9a9d] via-[#e2353a] to-[#7d1114] text-sm text-[#0a0608] shadow-[0_5px_15px_rgba(194,30,34,0.35)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ded9da]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#ffe9ea]/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#ffe9ea] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#ffe9ea]/50 bg-gradient-to-br from-[#ffe9ea] via-[#ff9a9d] to-[#c21e22] text-sm text-[#0a0608] shadow-[0_5px_15px_rgba(255,233,234,0.24)]">
              🛡️
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
