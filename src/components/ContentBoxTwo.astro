---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🃏", iconright = "🛡️" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a channel panel),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
//
// รอบนี้ index.astro **import ไฟล์นี้ตรงๆ** และส่ง **docx H2 §2** มาให้ (content.txt
// บรรทัด 6 แบ่งครึ่งต่อคอลัมน์) ตาม brand-spec §3
// ⚠️ LoginRtpSection ไม่ถูก render ที่ไหนเลยรอบนี้ (ตาราง RTP ของมันจะพาเลข RTP
// ขึ้นหน้า ซึ่งบรีฟรอบนี้ห้ามเป็นตัวเลขโดยตรง) ไฟล์นี้จึงเป็น **กล่องเนื้อหาของ
// หน้าแรกโดยตรง** ไม่ใช่ chrome
// ⚠️ เช็ก "ไฟล์นี้ถูกใช้ไหม" ต้อง match **ชื่อไฟล์เปล่า** ไม่ใช่ path "components/…"
// เพราะ component ที่ถูกเรียกจาก component อื่นจะหลุดจาก grep แบบ path
//
// รอบนี้หน้าแรก **ไม่ส่ง titleleft/titleright** มาด้วย — บรีฟให้ §2 เป็นย่อหน้าเดียว
// ที่ไม่มีหัวข้อย่อย การตั้งป้ายคอลัมน์เองจะเป็นคำของเพจ ไม่ใช่ของบรีฟ (ไอคอนสองตัว
// จึงไม่ถูก render รอบนี้ — มันอยู่ในป้ายคอลัมน์) ค่าเริ่มต้นของไอคอนเปลี่ยนเป็น
// 🃏 / 🛡️ ให้ตรงหัวข้อ §2 ของบรีฟ คือ **หมวดเกมเดิมพันหลายหมวดหมู่ กับสิ่งที่
// ผู้ใช้งานควรตรวจสอบก่อนเชื่อคำกล่าวอ้างเรื่องเซิร์ฟเวอร์แท้และความปลอดภัย**
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// ───────────────────────────────────────────────────────────────────────────
// 123BET (ดรอป 2026-10-28) — พาเลตตาม .claude/brand-spec-123bet.md §2
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **ฟ้าสกาย-น้ำเงินลึกของ โบ๊ะบ๊ะ168** ทั้งใบ จึงรีเธม
// ทั้งไฟล์: รอบนี้เป็น **ธีมสว่าง** พื้นเพจ **#f7e4e9** (bg.json) = ชมพูบลัชจาง
// **ห้ามแก้กลับไปเป็นพื้นมืด และห้ามเหลือฟ้า/ไซแอน/น้ำเงินไว้เลยสักค่า**
//
// ⚠️⚠️ <section> ใบนี้ **ไม่มีการ์ดครอบ** (เป็นใบเดียวของหน้าแรกที่เป็นแบบนั้น)
// header จึงนั่งบน **พื้นเพจ #f7e4e9** โดยตรง ซึ่ง §2 ตรวจคอนทราสต์ไว้ให้แล้ว:
//   **#a30d1a บนพื้นเพจ #f7e4e9 ได้ 6.6:1** — ผ่าน AA ทั้งแบบ normal text
//   จึงใช้เป็นสีหัวข้อได้ตรง ๆ เหมือนใบอื่นของหน้า และลำดับชั้นยังมาจาก
//   ขนาด/น้ำหนัก/แท่งตั้งแดงอีกชั้นหนึ่ง
// ส่วน **เนื้อความอยู่ในสองแผงการ์ด #fdf5f6** จึงกลับไปใช้เกณฑ์ปกติ: หมึก #36080f
// (16.3:1) และ <strong> ของหน้าเพจเป็น #a30d1a (7.4:1 บนการ์ด) ตามทั้งหน้า
//
// จังหวะรูปทรงของใบนี้: **แท่งตั้งแดงข้างหัวข้อ + เส้นคาดใต้ header โดยไม่มีการ์ด
// ครอบ แล้วเนื้อความแยกเป็นสองแผงมุมมน** ซึ่งไม่ซ้ำกับใบไหนบนหน้าเดียวกัน
// (§1 การ์ดมุมตัด 40px พร้อมสันซ้ายสี่พิกเซล · §3 การ์ดมุมมนพร้อมเส้นคาดหัวการ์ด ·
// §4 การ์ดมุมมน 28px หัวข้อบนเส้นคาดเต็มคอลัมน์ · §5 การ์ดมุมตัด 36px พร้อมชิปกลีฟ ·
// §6 หัวข้อจัดกึ่งกลางใต้เส้นคาด · §7 การ์ดซ้อนการ์ดกับหัวข้อคร่อมเส้นคู่ ·
// §8 หัวข้อไล่เฉด bg-clip-text บนแผ่นป้ายรางซ้าย)
// แท่งตั้งไล่ **แดงชาด #a30d1a → แดงสด #c21325 → ทองอำพัน #dca53a**
// (พื้นถมล้วน ไม่มีตัวอักษรวางทับ)
// ป้ายคอลัมน์ (ถ้าแบรนด์ถัดไปส่งมา) เป็นขั้วกลับของกัน: ซ้าย #a30d1a พร้อม
// **ชิปถมแดง** ไล่ #8a1420 → #a30d1a หมึก **ขาว** (สูตรปุ่มหลักของ §2 —
// 9.5:1 และ 8.0:1) ⚠️ **ห้ามลากไล่เฉดสว่างกว่า #c21325 แล้ววางหมึกขาว**
// ขวา #36080f พร้อม **ชิปถมการ์ด-ยก** ไล่ #fdf5f6 → #f7dfe4 หมึก **#a30d1a**
// (สูตรปุ่มรองของ §2) ในกรอบ #d98fa0
// เส้น/ขอบทุกเส้นเป็น #eec3cc บนผิวการ์ด และ #d98fa0 บนพื้นเพจ ซึ่ง §2 ระบุว่า
// **ทั้งสองค่าห้ามถือตัวอักษร**
//
// ⚠️ **เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี"** — แดงนำมาแล้วหลายแบรนด์ในรีโปนี้
// และ **รอบนี้เป็นแบรนด์แดงจริง จึงต้องเทียบทีละหลัก** แดงรอบนี้คือ
// **#a30d1a / #8a1420 / #c21325 / #36080f / #330710 / #1c050b / #6b2b33**
// ทองคือ **#dca53a / #7a4a0c** ผิวคือ **#fdf5f6 / #f7dfe4 / #eec3cc / #d98fa0 /
// #f7e4e9** ค่าที่ต้องไม่เหลือในไฟล์นี้:
//   **โบ๊ะบ๊ะ168 (ชุดที่เพิ่งอยู่ทั้งใบนี้)** — 00bfff 12b4ef b6e3f0 7fcbe8 4fb8ea
//     06283f 0b4a73 2a87c4 eaf7ff f0faff e4f6fb 355f7d 0f5684 1a6ea8
//   **ZORO365 (แบรนด์ขาออกทันที)** — 002908 010d04 031b09 073c1a 0e5424 1e7033
//     35a043 3ddc4a 23823a dfe6e3 e8c86a eef7f0 9dc2a5
//   **LOTTO189 (ตระกูลสีเดียวกับรอบนี้เป๊ะ — เสี่ยงที่สุด)** — fff0f0 ffe4e6 ffd4d7
//     f5b9bd a8333f 25090f 6e3b44 b00718 c1071b 8a0412 8f6310 d61023 ff2436 e9b53c
//     24060c 3d0d16 120307 7e1221 ffeaea f0bcbc c3ccd6
//     ⚠️⚠️ **c1071b / b00718 ↔ a30d1a · 7e1221 / 8a0412 ↔ 8a1420 · 6e3b44 ↔ 6b2b33 ·
//     e9b53c ↔ dca53a · ffe4e6 / ffd4d7 ↔ f7e4e9 / f7dfe4 — เจอค่าซ้ายให้สงสัยว่า
//     พิมพ์ผิดก่อนเสมอ**
//   **MEXICANOSLOT** — de2b1e f2a033 a81410 c81e12 9d140c 6f0e08 3f130d 80453a
//     2b100a 431a10 1d0a06 8c3a22 fdeee2 e8c6ae fed7b5 fec28d f6c4a4 e2855c fde4d3
//     fff3ea fef6fb f2543f ⚠️ **a81410 ↔ a30d1a · fef6fb ↔ fdf5f6**
//   **TEVA69** — f0ffeb ffffff e6f7df d7f0cd b2dba3 3f7a2e 10280f 3c5b36 116018
//     0b4a12 1a7d24 8a6a0e 28c437 e3bb45 c6cfd2 · **ZANE96** — 7a1bd6 2b3fd9 c2178b
//     f23bb4 bb6dff 7aa7ff 5411c4 241046 f8e6f9 f6edfe ece0fb dcc6f4
//   **ZNOVA168** — 2a1206 1a0c04 2b1608 7a3a0c fff3e0 e0b784 fffbf0 c98a24 c23400
//     d13800 fa4903 e8a000 ff8a2b d8dde6 6a4a30 ⚠️ **7a3a0c ↔ 7a4a0c · c23400 ↔ c21325**
//   **okkub88 / หมูบิน168** — ffd6fa fff4fb ffe3f5 f9b2d9 f479b9 f4a7cf 6a0f3c
//     95486b 9c0f55 fb439b fc74b5 d91a73 b01160 85094a fa539c c2185b 8e0f41 fb8cc0
//     fdc6c3 ffd1cd f7bcd9 ef8dbd ffe5ff fff0f8 ffeef7 3b0b26 7a4463
//   **แดงของแบรนด์เก่ากว่านั้น** — fb2e33 cb0b0d d81115 b00d11 8a0608 ff2e52 e01238
//     c9102f c30303 8f0505 e81313 eb0305 e40303 c20305 fa0513 ff5a5f d9212a 8e1a16
//     fb141b ff5f63 d30304 a00203 dc0203 f5282a b3121b 5a0a0e ff3b14 fb1b32 1c0607
// (เขียนเฮกซ์ของแบรนด์เก่าแบบ **ไม่มี #** โดยตั้งใจ เพื่อไม่ให้ sweep ที่ไล่หา
// สีของแบรนด์เก่าใน src/ สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
// ⚠️ **รอบนี้ไม่มีฟ้า/ไซแอน/น้ำเงิน ไม่มีเขียว ไม่มีม่วง ไม่มีชมพู/ฟูเชีย ไม่มีส้ม
// และไม่มีแรมป์เทาเงิน** — เงินโครเมียม #d2d7dd เป็นลายเซ็นของเวิร์ดมาร์กและ
// ใช้บนโครมเข้มเท่านั้น ไม่อยู่ในไฟล์นี้
// rgba() ที่อนุญาตรอบนี้: rgba(163,13,26,α) · rgba(220,165,58,α) ·
// rgba(217,143,160,α) · rgba(54,8,15,α)
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#d98fa0] pb-4">
        <div aria-hidden="true" class="h-9 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#a30d1a] via-[#c21325] to-[#dca53a] shadow-[0_0_12px_rgba(163,13,26,0.55)]" />
        <HeadingTag class={`${headingSize} leading-normal font-black tracking-wide text-[#a30d1a]`}>{title}</HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 rounded-3xl border border-[#eec3cc] bg-[#fdf5f6] p-6 text-left text-base leading-relaxed text-[#36080f] shadow-[0_10px_26px_rgba(54,8,15,0.12)] md:p-7">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#eec3cc] pb-3 text-xl leading-normal font-black tracking-wide text-[#a30d1a]">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#8a1420] bg-gradient-to-br from-[#8a1420] to-[#a30d1a] text-sm text-white shadow-[0_5px_15px_rgba(163,13,26,0.4)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 rounded-3xl border border-[#eec3cc] bg-[#fdf5f6] p-6 text-left text-base leading-relaxed text-[#36080f] shadow-[0_10px_26px_rgba(54,8,15,0.12)] md:p-7">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#eec3cc] pb-3 text-xl leading-normal font-black tracking-wide text-[#36080f]">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#d98fa0] bg-gradient-to-br from-[#fdf5f6] to-[#f7dfe4] text-sm text-[#a30d1a] shadow-[0_5px_15px_rgba(217,143,160,0.5)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
