---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🔐", iconright = "⚽" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a bet-type panel),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
// LoginRtpSection renders it without a title, which is why the page's heading
// inventory stops at the docx's own sections.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// BRAVO168 (รอบน้ำเงินรอยัล-ทอง 2026-09-30): เวิร์ดมาร์กเป็นสองโทน ตัวอักษร BRAVO เป็น
// โครเมียมไล่น้ำเงินรอยัล ส่วนเลข 168 เป็นทองตัน บนงานอาร์ตพื้นสนามกลางคืนกรมท่าที่มีริ้ว
// แสงทองพาดโค้ง ลูกฟุตบอลทอง-กรมท่า เหรียญทองกองสูง และถ้วยรางวัลทอง สองคอลัมน์ของ
// กล่องนี้จึงถูกแยกด้วยคู่ทอง/น้ำเงินนั้นตรงๆ ตามลำดับบนโลโก้ — ฝั่งซ้ายเป็นทองเต็มใบ
// ป้ายไอคอนไล่จากทองอ่อน #ffe39a ลงทองแบรนด์ #f4cb69 ไปหาทองลึก #c9922e ส่วนฝั่งขวา
// เป็นน้ำเงินเต็มใบ ป้ายไอคอนไล่ฟ้าสว่าง #2f86f0 → น้ำเงินรอยัล #1558c4 → น้ำเงินเส้น
// #0e3f8f ตัวอักษรบนป้ายทองเป็นหมึกเข้ม #0a1020 (พื้นสว่าง ต้องใช้หมึกเข้ม) ส่วนป้าย
// น้ำเงินเป็นตัวอักษรขาวนวล #dbe5f5 เพราะน้ำเงินรอยัลเป็นพื้นเข้ม หัวข้อ docx (เมื่อมีการ
// ส่ง title มา) ไล่ทองอ่อน → ทองแบรนด์ → ทองลึก เส้นคั่นเป็นน้ำเงินเส้นทั้งสองฝั่ง เนื้อความ
// #dbe5f5 (BRAND_TEXT) — ชุดเขียวนีออน-โครเมียมของ CK268 (#8bfc13 #c9ff8f #1a7a08
// #e8f0e6 #b9c9b4 #8fa38a #030703 #d5e6cd) ออกทั้งหมด ไม่เหลือเขียวอยู่เลย
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#0e3f8f] pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe39a] via-[#f4cb69] to-[#c9922e] shadow-[0_0_10px_rgba(244,203,105,0.5)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#ffe39a] via-[#f4cb69] to-[#c9922e] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dbe5f5]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#0e3f8f] pb-3 text-xl leading-normal font-black tracking-widest text-[#ffe39a] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#f4cb69]/70 bg-gradient-to-br from-[#ffe39a] via-[#f4cb69] to-[#c9922e] text-sm text-[#0a1020] shadow-[0_5px_15px_rgba(244,203,105,0.4)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dbe5f5]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#0e3f8f] pb-3 text-xl leading-normal font-black tracking-widest text-[#2f86f0] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#2f86f0]/70 bg-gradient-to-br from-[#2f86f0] via-[#1558c4] to-[#0e3f8f] text-sm text-[#dbe5f5] shadow-[0_5px_15px_rgba(21,88,196,0.35)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
