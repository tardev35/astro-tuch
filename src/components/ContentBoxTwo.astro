---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🔐", iconright = "🎰" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a channel panel),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
// LoginRtpSection renders it without a title, which is why the page's heading
// inventory stops at the docx's own sections (brand-spec §5: h1×1 h2×5 h3×2).
//
// Reached ONLY through LoginRtpSection this round (index.astro does not import
// it directly — the docx's two-column section went to ContentBoxTwoCyberCut,
// and the rest of the shape mix is in brand-spec §3).
// A grep for "components/ContentBoxTwo.astro" in src/pages/ therefore finds
// nothing, and that does NOT mean it is inventory: match the bare filename
// instead. It is LIVE and has to carry this brand's colours.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// มีโชค168 (รอบ **ทองนำ · ชมพูบานเย็นเป็นฮิวที่สอง · พลัมเข้มเป็นเงา บนดำสนิท**
// 2026-10-18, brand-spec §2): โลโก้คือแมวกวักนำโชคขนขาวลายส้มทอง นั่งอยู่เหนือคำว่า
// "มีโชค" ตัวอักษรไทยหนาสามมิติ **ไล่เฉดชมพูบานเย็นขึ้นทอง** ต่อด้วยเลข "168" ทอง
// สามมิติ ล้อมด้วยริบบิ้นซาตินชมพูบานเย็น เหรียญจีนทองรูสี่เหลี่ยม ทองแท่งจีน
// หัวใจชมพู และดอกซากุระ
// ⚠️ ฮิวที่สองของรอบนี้คือ **ชมพูบานเย็น #f5469f** ซึ่งเป็นจุดที่แยกรอบนี้ออกจาก
// สามรอบก่อนจริงๆ (ขวัญใจ168 โรสโกลด์ f2bba5/c98a74 · รับตัง168 แดงสด d30304 ·
// สมหวัง168 แดงนำ fa0513) และมันต้อง **เห็นจริงบนหน้าเว็บ** ไม่ใช่เขียนไว้ในสเปก
// ⚠️ bg.json = {"mode":"color","color":"#000000"} → พื้นเพจเป็น **ดำสนิท** ลำดับ
// ความลึก: #24101c ยก / #160a12 กลาง / #0b0509 จม / #000000 พื้น
// กล่องนี้ไม่มีการ์ดครอบ มันวางสองคอลัมน์ลงบนพื้นเพจดำสนิทตรงๆ จึงเป็นจังหวะ
// "โปร่ง" ของหน้า คั่นหลังบล็อกเนื้อหาของบรีฟ — กล่องเนื้อหาใบอื่นมีผิวและกรอบของ
// ตัวเองทั้งหมด ใบนี้จึงเป็นใบเดียวที่ไม่มีผิว
// สองคอลัมน์ถูกแยกด้วยคู่ "แผ่นถมสว่าง vs แผ่นมืดกรอบชมพู" และเรียงตามลำดับนำของ
// รอบนี้: **ฝั่งซ้ายเป็นฝั่งทอง** ป้ายไอคอนเป็นแผ่นถมไล่ #fcd434 → #ff8dc6 บนหมึก
// #1a0612 (§2 ระบุว่านี่คือหมึกตัวเดียวที่วางบนพื้นถมทอง/ชมพูได้ — 13.5:1 บน #fcd434
// ห้ามพลิกแผ่นสว่างไปใช้หมึกสว่าง) ป้ายคอลัมน์ซ้ายเป็นทองแบรนด์ #fcd434 (12.4:1)
// ส่วน **ฝั่งขวาเป็นฝั่งชมพู** ป้ายไอคอนเป็นแผ่นมืดไล่ผิวยก #24101c → ผิวจม #0b0509
// ในกรอบชมพูบานเย็น #f5469f บนไอคอนชมพูอ่อน #ff8dc6 และป้ายคอลัมน์ขวาเป็นชมพูอ่อน
// #ff8dc6 (9.9:1) — ตรงนี้คือจุดที่ฮิวที่สองของรอบนี้ปรากฏตัว
// §2 ห้าม #8c0f52 และ #7a5508 ถือตัวอักษรที่ไหนเลย — ในไฟล์นี้ทั้งสองค่าอยู่ที่ขอบ
// เส้นคั่น และสันหัวข้อเท่านั้น · #ffeaa0 สงวนไว้ให้ <strong> ในย่อหน้า
// หัวข้อ docx (เมื่อมีการส่ง title มา) ไล่ ทองแบรนด์ #fcd434 → ชมพูอ่อน #ff8dc6 →
// ชมพูบานเย็น #f5469f ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุก
// สต็อปจึงต้องถือตัวอักษรได้ตาม §2 (12.4 / 9.9 / 6.2) สันหัวข้อไล่ #fcd434 →
// #f5469f → ทองลึก #7a5508 (ซึ่งเป็น **พื้น** ไม่ใช่ตัวอักษร จึงใช้ได้)
// เส้นคั่นเป็นทองลึก #7a5508 ฝั่งซ้าย และพลัมเข้ม #8c0f52 ฝั่งขวา
// เนื้อความ #f6e4ee (= BRAND_TEXT) — 14.9:1 บนผิวยก
// glow rgba ใช้ได้ 4 ชุดตาม §2: rgba(252,212,52,α) · rgba(245,70,159,α) ·
// rgba(255,141,198,α) · rgba(140,15,82,α) — ไฟล์นี้ใช้ชุดแรกกับชุดที่สอง
//
// ไอคอนเริ่มต้นเป็น 🔐 / 🎰 — บรีฟรอบนี้เป็น **เว็บสล็อตล้วน** ไม่ใช่คาสิโนและไม่ใช่
// หวย จึงไม่ใช้ไพ่/ลูกเต๋า/ลูกบอลเป็นค่าตั้งต้น (LoginRtpSection ส่งไอคอนมาเองอยู่
// แล้ว ค่านี้คือกันหลง)
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือทอง** เพราะเกือบทุกแบรนด์
// ที่ผ่านไฟล์นี้มีทอง "เจอทองอยู่แล้ว" จึงไม่พิสูจน์อะไรเลย ชุดที่เพิ่งอยู่ในไฟล์นี้
// คือขวัญใจ168 (f7c92b ffe6a3 f2bba5 c98a74 b3121b 5a0a0e 8a5f12 eadfce 140c06
// 241509 160d06 0b0603) ซึ่งเป็นทองนำบนดำสนิทเหมือนกันทุกบทบาท ก่อนหน้านั้นคือ
// รับตัง168 (f0b429 ffdc8c d30304 ff6b6e a00203 4a0202 9a6c0c cfd9e6 f5ece0 2b100f
// 200a09 140505 1a0505) สมหวัง168 (fa0513 ffadaf ff5a5f e3b23c ffe5a8 8a6210 b90203
// 8c0204 5b0203 3c0303 170504 f4ecea ccb9b6 2c1413 1f0d0c 140706 290f0f) และ TKB55
// (fb131b ff8a8f ff4d55 e9eef4 aeb9c6 f2e4e5 2a0d0f 1a0708 0d0304 c40304 8a0206
// 53050a 1a0304) — ถอดออกครบทุกค่าแล้ว
// ⚠️ ทองรอบนี้คือ **#fcd434** (R=252 G=212 B=52) ไม่ใช่ f7c92b (ขวัญใจ168) f0b429
// (รับตัง168) e3b23c (สมหวัง168) dfa310 (TND168) e2b33f (KMD88) e5a81b (UFA324)
// fad354 (789BETTING) 8a6210 หรือ 9a6c0c
// ⚠️ ชมพูรอบนี้คือ **#f5469f / #ff8dc6** ไม่ใช่ f41571 / ff5ca8 ของ PUNPRO168
// ⚠️ พื้นเพจรอบนี้คือ **#000000** เหมือนรอบก่อน แต่ผิวทั้งสามชั้นเป็นโทนพลัม
// (#24101c / #160a12 / #0b0509) ไม่ใช่โทนทองไหม้ (241509 / 160d06 / 0b0603)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีน้ำเงิน ไม่มีฟ้า/ไซแอน ไม่มีม่วง/ไวโอเลต ไม่มีเขียว ไม่มีส้ม
// ไม่มีเงิน/โครเมียมอมฟ้า ไม่มีโรสโกลด์ (f2bba5/c98a74) และไม่มีแดงชาด (b3121b)**
// — cfd9e6 e9eef4 aeb9c6 cfdcec 9db4d4 ต้องไม่เหลืออยู่ในไฟล์นี้
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#7a5508] pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fcd434] via-[#f5469f] to-[#7a5508] shadow-[0_0_10px_rgba(252,212,52,0.6)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#fcd434] via-[#ff8dc6] to-[#f5469f] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e4ee]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#7a5508] pb-3 text-xl leading-normal font-black tracking-widest text-[#fcd434] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#7a5508] bg-gradient-to-br from-[#fcd434] to-[#ff8dc6] text-sm text-[#1a0612] shadow-[0_5px_15px_rgba(252,212,52,0.4)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e4ee]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#8c0f52] pb-3 text-xl leading-normal font-black tracking-widest text-[#ff8dc6] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#f5469f] bg-gradient-to-br from-[#24101c] to-[#0b0509] text-sm text-[#ff8dc6] shadow-[0_5px_15px_rgba(245,70,159,0.45)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
