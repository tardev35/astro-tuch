---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a game list),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// UFAGOOL (รอบแดง-เงินโครเมียม 2026-09-23): โลโก้แบรนด์นี้เป็นตัวอักษร UFA สีแดง
// เงาวาวคู่กับ GOOL สีเงินโครเมียม สองครึ่งของกล่องจึงแยกกันด้วยคู่สีนั้นจริงๆ
// ป้ายไอคอนฝั่งซ้ายไล่จากแดงสด #ef1f25 ลงแดงแบรนด์ #c50d12 ไปหาแดงลึก #7a0103
// ตัวอักษรบนป้ายใช้สีพื้นเพจ #0a0708 ส่วนฝั่งขวาไล่จากขาวเงิน #f4f7fa ลงเงินหลัก
// #b8c3cf ไปหาเงินเข้ม #5c6672 เส้นคั่นเป็นแดงแบรนด์กับแดงลึก #5e0507
// — แดง-ทองของแบรนด์ก่อนหน้า (#a40201 #dd0503 #6b0302 #f2c14e #ffe7a6 #8a6524 #1c0504
// #f7e3dd) ออกหมด
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#c50d12]/40 pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ef1f25] via-[#c50d12] to-[#7a0103] shadow-[0_0_10px_rgba(197,13,18,0.45)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#ef1f25] via-[#f4f7fa] to-[#b8c3cf] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cdd5dd]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#c50d12]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#f4f7fa] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#c50d12]/70 bg-gradient-to-br from-[#ef1f25] via-[#c50d12] to-[#7a0103] text-sm text-[#0a0708] shadow-[0_5px_15px_rgba(197,13,18,0.45)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cdd5dd]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#5e0507] pb-3 text-xl leading-normal font-black tracking-widest text-[#b8c3cf] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#b8c3cf]/50 bg-gradient-to-br from-[#f4f7fa] via-[#b8c3cf] to-[#5c6672] text-sm text-[#0a0708] shadow-[0_5px_15px_rgba(184,195,207,0.35)]">
              📋
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
