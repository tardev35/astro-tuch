---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a service list),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// GODBET88 palette: one identity hue, metallic gold. The left column badge runs
// primary gold (#c2a55c) down into the darkest brown-gold (#5c4418) and the
// right one runs the sheen (#f6e7b8) down into primary, so the two halves are
// told apart by brightness inside the gold rather than by a second colour. The
// previous brand's crimson wordmark red is gone.
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#c2a55c]/40 pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f6e7b8] via-[#c2a55c] to-[#5c4418] shadow-[0_0_10px_rgba(194,165,92,0.55)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#f6e7b8] via-[#e2c87f] to-[#c2a55c] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece1cc]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#c2a55c]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#e2c87f] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#c2a55c]/70 bg-gradient-to-br from-[#c2a55c] via-[#9a7f3f] to-[#5c4418] text-sm text-[#f6e7b8] shadow-[0_5px_15px_rgba(194,165,92,0.35)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece1cc]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#f6e7b8]/45 pb-3 text-xl leading-normal font-black tracking-widest text-[#f6e7b8] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#f6e7b8]/60 bg-gradient-to-br from-[#f6e7b8] via-[#e2c87f] to-[#c2a55c] text-sm text-[#050403] shadow-[0_5px_15px_rgba(246,231,184,0.28)]">
              🛡️
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
