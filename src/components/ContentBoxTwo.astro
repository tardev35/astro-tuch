---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a service list),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#3f6b23]/60 pb-4">
        <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#a8e37c] to-[#d9b95c] shadow-[0_0_10px_rgba(98,174,45,0.55)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#f2f8ec] via-[#8fd45e] to-[#d9b95c] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dbe5d3]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#62ae2d]/45 pb-3 text-xl leading-normal font-black tracking-widest text-[#8fd45e] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#62ae2d]/55 bg-gradient-to-br from-[#a8e37c] via-[#62ae2d] to-[#2f6a0c] text-sm text-[#060a04] shadow-[0_5px_15px_rgba(98,174,45,0.32)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dbe5d3]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#8a6320]/55 pb-3 text-xl leading-normal font-black tracking-widest text-[#d9b95c] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#d9b95c]/60 bg-gradient-to-br from-[#f0dca0] via-[#d9b95c] to-[#8a6320] text-sm text-[#3a2a08] shadow-[0_5px_15px_rgba(217,185,92,0.3)]">
              🎲
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
