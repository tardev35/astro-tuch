---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a service list),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// PAOTUNG palette: left column badge is the logo's primary blue, right column
// badge is gold metallic — the navy + gold split the brief names and the logo
// carries (a gold money bag over a mid-blue PAOTUNG wordmark) — so the two
// halves are told apart by hue and not only by position. No red anywhere.
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#226ca9]/55 pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f5e3b3] via-[#e0bd72] to-[#054e83] shadow-[0_0_10px_rgba(224,189,114,0.45)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#f5e3b3] via-[#e0bd72] to-[#3b9ddd] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cfdeed]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#226ca9]/55 pb-3 text-xl leading-normal font-black tracking-widest text-[#7fc4f0] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#226ca9]/70 bg-gradient-to-br from-[#7fc4f0] via-[#3b9ddd] to-[#054e83] text-sm text-[#020f1e] shadow-[0_5px_15px_rgba(34,108,169,0.35)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cfdeed]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#e0bd72]/45 pb-3 text-xl leading-normal font-black tracking-widest text-[#f5e3b3] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#e0bd72]/60 bg-gradient-to-br from-[#f5e3b3] via-[#e0bd72] to-[#a5813a] text-sm text-[#020f1e] shadow-[0_5px_15px_rgba(224,189,114,0.28)]">
              📋
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
