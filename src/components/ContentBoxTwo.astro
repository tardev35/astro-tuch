---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a game list),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// ABM96 (รอบชมพู-เหลือง 2026-09-22): โลโก้แบรนด์นี้เป็นตัวอักษร ABM สีชมพูคู่กับเลข
// 96 สีเหลืองบนพื้นขาว สองครึ่งของกล่องจึงแยกกันด้วยคู่สีนั้นจริงๆ ป้ายไอคอนฝั่งซ้าย
// ไล่จากชมพูอ่อน #ffc9dc ลงชมพูหลัก #fd6494 ไปหาชมพูเข้ม #b8325f ตัวอักษรบนป้ายใช้
// สีพื้นเพจ #12030a ส่วนฝั่งขวาไล่จากเหลืองอ่อน #ffe98a ลงเหลืองโลโก้ #feda2a ไปหา
// เหลืองเข้ม #d9a800 เส้นคั่นเป็นชมพูหลักกับพื้นการ์ดสว่าง #3d0f26 — มรกต-ทองของ
// HENG38 ออกหมด
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#fd6494]/40 pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffc9dc] via-[#fd6494] to-[#b8325f] shadow-[0_0_10px_rgba(253,100,148,0.55)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#ffc9dc] via-[#fd6494] to-[#feda2a] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fbe3ee]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#fd6494]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#ffc9dc] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#fd6494]/70 bg-gradient-to-br from-[#ffc9dc] via-[#fd6494] to-[#b8325f] text-sm text-[#12030a] shadow-[0_5px_15px_rgba(253,100,148,0.35)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fbe3ee]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#3d0f26] pb-3 text-xl leading-normal font-black tracking-widest text-[#feda2a] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#feda2a]/50 bg-gradient-to-br from-[#ffe98a] via-[#feda2a] to-[#d9a800] text-sm text-[#12030a] shadow-[0_5px_15px_rgba(254,218,42,0.22)]">
              🎴
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
