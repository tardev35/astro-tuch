---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a service list),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#0e4f7a]/70 pb-4">
        <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#4bdbee] to-[#1687c9] shadow-[0_0_10px_rgba(75,219,238,0.55)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#eafcff] via-[#4bdbee] to-[#1687c9] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cfe7f2]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#1687c9]/55 pb-3 text-xl leading-normal font-black tracking-widest text-[#22b8e8] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#1687c9]/60 bg-gradient-to-br from-[#22b8e8] via-[#1687c9] to-[#0e4f7a] text-sm text-[#eafcff] shadow-[0_5px_15px_rgba(22,135,201,0.34)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cfe7f2]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#8fb6cc]/45 pb-3 text-xl leading-normal font-black tracking-widest text-[#4bdbee] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#4bdbee]/60 bg-gradient-to-br from-[#9df1ff] via-[#4bdbee] to-[#083b5c] text-sm text-[#01050b] shadow-[0_5px_15px_rgba(75,219,238,0.32)]">
              🎰
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
