---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a checklist panel),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
// LoginRtpSection renders it without a title this round, which is why the page's
// heading inventory stops at the eight docx sections.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// PKG44 (รอบทองเมทัลลิก-โครเมียม-ดำ 2026-09-27): โลโก้เขียน P เป็นทอง K เป็นโครเมียม
// ขัดเงา แล้วปิดท้ายด้วย G44 สีทอง สองคอลัมน์ของกล่องนี้จึงถูกแยกด้วยคู่วัสดุนั้นตรงๆ
// — ฝั่งซ้ายเป็นทองล้วน ป้ายไอคอนไล่จากทองสว่าง #ffe27a ลงทองแบรนด์ #fdd32a ไปหา
// ทองเข้มสุด #15110a ตัวอักษรบนป้ายใช้ #15110a ตามกฎคอนทราสต์ที่ว่าตัวอักษรบนพื้น
// สว่างต้องเกือบดำ ไม่ใช่ขาว ส่วนฝั่งขวาเป็นโครเมียมล้วน ไล่จากโครเมียมสว่าง #f2f4f7
// ลงโครเมียมกลาง #c2c8d0 ไปจบที่โครเมียมเข้ม #8a9099 หัวข้อ docx (เมื่อมีการส่ง title
// มา) ไล่โครเมียม-ทองอ่อน-ทองแบรนด์ตามลำดับบนโลโก้ เส้นคั่นเป็นทองลึก #4a3a12 ฝั่งซ้าย
// กับผิวการ์ดยก #2a2110 ฝั่งขวา เนื้อความ #efe6d2 (BRAND_TEXT) — ชุดเขียวมรกตของ
// BRAZIL999 (#22c55e #7cf25c #b6ff9c #0a6b18 #04380c #1c5a26 #123a18 #aab4bf
// #f1f5f9 #6b7580 #dfeadd #040a05) ออกทั้งหมด
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#4a3a12]/70 pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f2f4f7] via-[#ffeeb8] to-[#fdd32a] shadow-[0_0_10px_rgba(253,211,42,0.5)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#f2f4f7] via-[#ffeeb8] to-[#fdd32a] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#efe6d2]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#4a3a12]/70 pb-3 text-xl leading-normal font-black tracking-widest text-[#ffe27a] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#fdd32a]/70 bg-gradient-to-br from-[#ffe27a] via-[#fdd32a] to-[#c8920a] text-sm text-[#15110a] shadow-[0_5px_15px_rgba(253,211,42,0.4)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#efe6d2]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#2a2110] pb-3 text-xl leading-normal font-black tracking-widest text-[#c2c8d0] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#c2c8d0]/55 bg-gradient-to-br from-[#f2f4f7] via-[#c2c8d0] to-[#8a9099] text-sm text-[#15110a] shadow-[0_5px_15px_rgba(194,200,208,0.28)]">
              🛡️
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
