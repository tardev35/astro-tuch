---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🔐", iconright = "🎟️" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a lottery-listing
// panel), never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
// LoginRtpSection renders it without a title, which is why the page's heading
// inventory stops at the docx's own sections.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// หวยเต็ง (รอบเขียวป่า-ทอง 2026-10-01): เวิร์ดมาร์กเป็นสองโทน คำว่า "หวย" เป็นเขียว
// มรกตเงาวาวขอบทอง ส่วน "เต็ง" เป็นทองตัน บนงานอาร์ตฉากคืนเขียวป่าที่มีริ้วแสงทอง
// พาดโค้ง เหรียญทองกองสูง ลูกหวยทอง-ขาว และเงาวัดสีทอง สองคอลัมน์ของกล่องนี้จึงถูก
// แยกด้วยคู่ทอง/เขียวนั้นตรงๆ ตามลำดับบนโลโก้ — ฝั่งซ้ายเป็นทองเต็มใบ ป้ายไอคอนไล่
// จากทองอ่อน #fae474 ลงทองแบรนด์ #e5c04f ไปหาทองลึก #bd8d2d ส่วนฝั่งขวาเป็นเขียว
// เต็มใบ ป้ายไอคอนไล่เขียวมรกตสว่าง #0bb42f → เขียวแบรนด์ #026314 → เขียวแบรนด์ลึก
// #024a0f ตัวอักษรบนป้ายทองเป็นหมึกเข้ม #0a1a0c (พื้นสว่าง ต้องใช้หมึกเข้ม) ส่วนป้าย
// เขียวเป็นตัวอักษรขาวนวล #d8ead9 เพราะเขียวแบรนด์เป็นพื้นเข้ม หัวข้อ docx (เมื่อมีการ
// ส่ง title มา) ไล่ทองอ่อน → ทองแบรนด์ → ทองลึก เส้นคั่นเป็นเขียวลึกทั้งสองฝั่ง เนื้อความ
// #d8ead9 (BRAND_TEXT) — ชุดน้ำเงินรอยัล-ทองของ BRAVO168 (#1558c4 #0e3f8f #2f86f0
// #f4cb69 #ffe39a #c9922e #0a1020 #dbe5f5) ออกทั้งหมด ไม่เหลือน้ำเงินอยู่เลย
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#024a0f] pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fae474] via-[#e5c04f] to-[#bd8d2d] shadow-[0_0_10px_rgba(229,192,79,0.5)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#fae474] via-[#e5c04f] to-[#bd8d2d] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d8ead9]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#024a0f] pb-3 text-xl leading-normal font-black tracking-widest text-[#fae474] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#e5c04f]/70 bg-gradient-to-br from-[#fae474] via-[#e5c04f] to-[#bd8d2d] text-sm text-[#0a1a0c] shadow-[0_5px_15px_rgba(229,192,79,0.4)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d8ead9]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#024a0f] pb-3 text-xl leading-normal font-black tracking-widest text-[#0bb42f] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#0bb42f]/70 bg-gradient-to-br from-[#0bb42f] via-[#026314] to-[#024a0f] text-sm text-[#d8ead9] shadow-[0_5px_15px_rgba(2,99,20,0.35)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
