---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🔐", iconright = "🎰" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a channel panel),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
// LoginRtpSection renders it without a title, which is why the page's heading
// inventory stops at the docx's own sections.
//
// Reached ONLY through LoginRtpSection this round (index.astro does not import
// it directly — the docx's two-column sections went to ContentBoxTwoCyberCut and
// ContentBoxTwoPremium, and the rest of the shape mix is in brand-spec §3).
// A grep for "components/ContentBoxTwo.astro" in src/pages/ therefore finds
// nothing, and that does NOT mean it is inventory: match the bare filename
// instead. It is LIVE and has to carry this brand's colours.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// รับตัง168 (รอบทองไทยนำ แดงมังกรรอง บนดำอมแดง 2026-10-18, brand-spec §2):
// โลโก้คือคำว่า "รับตัง" ตัวอักษรสามมิติผิวโครเมียมอมฟ้าเงินขอบแดง ต่อด้วยเลข "168"
// แดงสดตัวหนาสามมิติ วางอยู่บน **กองเหรียญจีนทองรูสี่เหลี่ยม** หนาเต็มพื้นหลังกับ
// ริบบิ้นซาตินแดงพลิ้ว งานอาร์ตเป็นฉากพื้นดำ ชายหนุ่มผมดำในชุดดำกับหญิงสาวผมยาวดำ
// ฝนเหรียญทอง กองชิปทอง-ดำ-แดง ไพ่เอซ กรอบลวดลายทอง และมงกุฎทอง
// ⚠️ รอบนี้เป็น **สองโทนจริง: ทองไทยนำ แดงมังกรรอง** ซึ่ง **กลับลำดับ** จากรอบก่อน
// (สมหวัง168 แดงนำ ทองรอง) ถ้าเผลออยากใส่สีที่สอง คำตอบคือ **แดง** #d30304 /
// #ff6b6e ไม่ใช่โครเมียม/เงิน — สีเงินอมฟ้าในคำว่า "รับตัง" เป็นรายละเอียดในรูป §2
// ดึงมันออกมาเป็น **สีตัวอักษรรอง #cfd9e6 เท่านั้น** ห้ามใช้เป็นขอบ สีเน้น หรือ
// สต็อปเกรเดียนต์ และไฟล์นี้ไม่ได้ใช้มันเลย
// กล่องนี้ไม่มีการ์ดครอบ มันวางสองคอลัมน์ลงบนพื้นเพจ **ดำอมแดง #1a0505** (bg.json)
// ตรงๆ จึงเป็นจังหวะ "โปร่ง" ของหน้า คั่นหลังบล็อกเนื้อหาของบรีฟ — กล่องเนื้อหา
// อีกแปดใบมีผิวและกรอบของตัวเองทั้งหมด ใบนี้จึงเป็นใบเดียวที่ไม่มีผิว
// ลำดับความลึก: #2b100f ยก / #200a09 กลาง / #140505 จม / #1a0505 พื้น
// สองคอลัมน์ถูกแยกด้วยคู่ "แผ่นทองทึบ vs แผ่นมืดกรอบแดง" ซึ่งตรงกับสองโทนของงานอาร์ต
// และเรียงตามลำดับนำของรอบนี้: **ฝั่งซ้ายเป็นฝั่งทอง** ป้ายไอคอนเป็นแผ่นทองทึบไล่
// #f0b429 → #ffdc8c บนหมึก #1a0505 (§2 ระบุว่านี่คือหมึกตัวเดียวที่วางบนพื้นถมทอง/
// แดงสว่างได้ — ห้ามพลิกแผ่นทองไปใช้หมึกสว่าง) และป้ายคอลัมน์ซ้ายเป็นทองแบรนด์
// #f0b429 (8.5:1) ส่วน **ฝั่งขวาเป็นฝั่งแดง** ป้ายไอคอนเป็นแผ่นมืดไล่ผิวยก #2b100f
// → ผิวจม #140505 ในกรอบแดงแบรนด์ #d30304 บนไอคอนแดงสว่าง #ff6b6e และป้ายคอลัมน์
// ขวาเป็นแดงสว่าง #ff6b6e (5.4:1 และเป็น text-xl font-black จึงเป็น large text)
// §2 ห้าม #d30304 #a00203 #4a0202 #9a6c0c ถือตัวอักษรที่ไหนเลย — ในไฟล์นี้ทั้งสี่ค่า
// อยู่ที่ขอบ เส้นคั่น สันหัวข้อ และ **พื้น** ของแผ่นไอคอนเท่านั้น
// หัวข้อ docx (เมื่อมีการส่ง title มา) ไล่ ทองสว่าง #ffdc8c → ทองแบรนด์ #f0b429 →
// แดงสว่าง #ff6b6e ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุก
// สต็อปจึงต้องถือตัวอักษรได้ตาม §2 สันหัวข้อไล่ ทองสว่าง #ffdc8c → ทองแบรนด์
// #f0b429 → ทองลึก #9a6c0c (ซึ่งเป็น **พื้น** ไม่ใช่ตัวอักษร จึงใช้ได้) เส้นคั่นเป็น
// แดงเข้มสุด #4a0202 ทั้งสองฝั่ง เนื้อความ #f5ece0 (= BRAND_TEXT) — 13.6:1 บนพื้นเพจ
//
// ไอคอนเริ่มต้นเป็น 🔐 / 🎰 — บรีฟรอบนี้เป็น **เว็บเกมสล็อตล้วน** ไม่ใช่คาสิโนและ
// ไม่ใช่กีฬา จึงไม่ใช้ไพ่/ลูกเต๋า/ลูกบอลเป็นค่าตั้งต้น (LoginRtpSection ส่งไอคอนมา
// เองอยู่แล้ว ค่านี้คือกันหลง)
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือแดง และมันหนักเป็นพิเศษ
// ที่ไฟล์นี้** เพราะชุดที่เพิ่งอยู่ในนี้ (สมหวัง168: #fa0513 #ffadaf #ff5a5f #e3b23c
// #ffe5a8 #8a6210 #b90203 #8c0204 #5b0203 #3c0303 #170504 #f4ecea #ccb9b6 #2c1413
// #1f0d0c #140706 #290f0f) ก็เป็นแดง+ทองบนดำอมแดงเหมือนกันทุกบทบาท "เจอแดงกับทอง
// อยู่แล้ว" จึงไม่พิสูจน์อะไรเลย — แดงของสมหวัง168 คือ #fa0513 (G=5 B=19) ของ TKB55
// คือ #fb131b ของ GT66B คือ #fb141b ของ SUPERSLOTCLUB คือ #e8232a ของ PIGPG คือ
// #d4200d และของ FLASH877 คือ #ff3b14 ส่วนแดงรอบนี้คือ **#d30304** (R=211 G=3 B=4)
// ⚠️ ทองรอบนี้คือ **#f0b429** ไม่ใช่ #e3b23c ของสมหวัง168 ไม่ใช่ #dfa310 ของ TND168
// #e5a81b ของ UFA324 #e2b33f ของ KMD88 หรือ #fad354 ของ 789BETTING
// ⚠️ พื้นเพจรอบนี้ #1a0505 ไม่ใช่ #290f0f ของรอบก่อน และไม่ใช่ #1a0708 / #1a0304
// ของ TKB55 หรือ #190505 ของ GT66B — ให้เทียบทีละหลัก
// ⚠️ **รอบนี้ไม่มีโครเมียม/เงินเป็นสีระบบ ไม่มีม่วง ไม่มีชมพู ไม่มีน้ำเงิน ไม่มีฟ้า
// ไม่มีเขียว ไม่มีส้ม** #e9eef4 #aeb9c6 #cfdcec #9db4d4 ต้องไม่เหลืออยู่ในไฟล์นี้
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#4a0202] pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffdc8c] via-[#f0b429] to-[#9a6c0c] shadow-[0_0_10px_rgba(240,180,41,0.6)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#ffdc8c] via-[#f0b429] to-[#ff6b6e] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f5ece0]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#4a0202] pb-3 text-xl leading-normal font-black tracking-widest text-[#f0b429] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#9a6c0c] bg-gradient-to-br from-[#f0b429] to-[#ffdc8c] text-sm text-[#1a0505] shadow-[0_5px_15px_rgba(240,180,41,0.4)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f5ece0]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#4a0202] pb-3 text-xl leading-normal font-black tracking-widest text-[#ff6b6e] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#d30304] bg-gradient-to-br from-[#2b100f] to-[#140505] text-sm text-[#ff6b6e] shadow-[0_5px_15px_rgba(0,0,0,0.7)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
