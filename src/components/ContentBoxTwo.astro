---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🎰", iconright = "📋" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a channel panel),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
//
// รอบนี้ index.astro **import ไฟล์นี้ตรงๆ** และส่ง **docx H2 §2** มาให้ (content.txt
// บรรทัด 6 แบ่งครึ่งต่อคอลัมน์) ตาม brand-spec §3 — ตัวฐานนี้ไม่เคยถูกใช้ทั้งใน
// หมูบิน168 (N-1 ใช้ ContentBoxTwoNeumorphism) และ สล็อต168 (N-2)
// ⚠️ LoginRtpSection ไม่ถูก render ที่ไหนเลยรอบนี้ (ตาราง RTP ของมันจะพาเลข RTP
// ขึ้นหน้า ซึ่งบรีฟรอบนี้เอ่ย "ค่า RTP" ในฐานะสิ่งที่ผู้ใช้ควรตรวจสอบจากผู้พัฒนาเกม
// เท่านั้น **ห้ามเขียนเป็นตัวเลข**) ไฟล์นี้จึงเป็น **กล่องเนื้อหาของหน้าแรกโดยตรง**
// ไม่ใช่ chrome
// ⚠️ เช็ก "ไฟล์นี้ถูกใช้ไหม" ต้อง match **ชื่อไฟล์เปล่า** ไม่ใช่ path "components/…"
// เพราะ component ที่ถูกเรียกจาก component อื่นจะหลุดจาก grep แบบ path
//
// รอบนี้หน้าแรก **ไม่ส่ง titleleft/titleright** มาด้วย — บรีฟให้ §2 เป็นย่อหน้าเดียว
// ที่ไม่มีหัวข้อย่อย การตั้งป้ายคอลัมน์เองจะเป็นคำของเพจ ไม่ใช่ของบรีฟ (ไอคอนสองตัว
// จึงไม่ถูก render รอบนี้ — มันอยู่ในป้ายคอลัมน์) ค่าเริ่มต้นของไอคอนเปลี่ยนเป็น
// 🎰 / 📋 ให้ตรงหัวข้อ §2 ของบรีฟ คือ **รวมค่ายดังเกมสล็อต กับสิ่งที่ควรตรวจสอบ
// ก่อนใช้งาน**
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// ───────────────────────────────────────────────────────────────────────────
// โบ๊ะบ๊ะ168 (ดรอป 2026-10-24) — พาเลตตาม .claude/brand-spec-bohba168.md §2
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **แดงคริมสัน-อะซัวร์บนน้ำเงินเที่ยงคืนของ
// มาดาม168** ทั้งใบ จึงรีเธมทั้งไฟล์: รอบนี้เป็น **ธีมสว่าง** พื้นเพจ **#00bfff**
// (bg.json) = ฟ้าสกายอิ่มตัว **ห้ามแก้กลับไปเป็นพื้นมืด**
//
// ⚠️⚠️ <section> ใบนี้ **ไม่มีการ์ดครอบ** (เป็นใบเดียวของหน้าแรกที่เป็นแบบนั้น)
// header จึงนั่งบน **พื้นเพจ #00bfff** โดยตรง ซึ่งเปลี่ยนตัวเลขคอนทราสต์ทั้งชุด:
//   ⚠️⚠️ **#0f5684 บนพื้นเพจ #00bfff ได้แค่ 3.6:1** (ผ่านเฉพาะเกณฑ์ large text)
//   จึง **ไม่ใช้ #0f5684 เป็นสีหัวข้อในไฟล์นี้** — หัวข้อใช้ **#06283f (7.2:1 บน
//   พื้นเพจ)** แทน และลำดับชั้นมาจาก **ขนาด/น้ำหนัก/แท่งตั้งฟ้า** ไม่ใช่จากสี
//   นี่คือจุดที่ใบนี้ต่างจากอีกเจ็ดใบ ซึ่งหัวข้อเป็น #0f5684 บนผิวขาว/ผิวยก
// ส่วน **เนื้อความอยู่ในสองแผงขาว** จึงกลับไปใช้เกณฑ์ปกติ: หมึก #06283f (15.2:1)
// และ <strong> ของหน้าเพจเป็น #0f5684 (7.8:1 บนขาว) ตามทั้งหน้า
//
// จังหวะรูปทรงของใบนี้: **แท่งตั้งฟ้าข้างหัวข้อ + เส้นคาดใต้ header โดยไม่มีการ์ด
// ครอบ แล้วเนื้อความแยกเป็นสองแผงขาวมุมมน** ซึ่งไม่ซ้ำกับใบไหนบนหน้าเดียวกัน
// (§1 แผ่นถมน้ำเงินหมึกขาว · §3 สันซ้ายสี่พิกเซลบนการ์ดมุมตัด 40px · §4 หัวข้อทึบ
// พร้อมขีดสั้นบนการ์ดมุมกลม · §5 ชิปถมฟ้าคู่กลีฟเมฆบนการ์ดมุมตัด 36px · §6 เส้นคาด
// เหนือหัวข้อที่จัดกึ่งกลาง · §7 เส้นคู่คร่อมบน-ล่างในการ์ดซ้อนการ์ด · §8 หัวข้อ
// ไล่เฉด bg-clip-text บนแผ่นป้ายรางซ้าย)
// แท่งตั้งไล่ **ฟ้าสกาย #12b4ef → ฟ้าเส้นเข้ม #4fb8ea → ฟ้าพาสเทล #b6e3f0**
// (พื้นถมล้วน ไม่มีตัวอักษรวางทับ)
// ป้ายคอลัมน์ (ถ้าแบรนด์ถัดไปส่งมา) เป็นขั้วกลับของกัน: ซ้าย #0f5684 พร้อม
// **ชิปถมน้ำเงิน** ไล่ #1a6ea8 → #0f5684 หมึก **ขาว** (สูตรปุ่มหลักของ §2 —
// 5.5:1 และ 7.8:1) ⚠️ **ห้ามลากไล่เฉดขึ้นไปถึง #12b4ef หรือ #00bfff แล้ววาง
// หมึกขาว** (2.4:1 / 2.1:1) ขวา #06283f พร้อม **ชิปถมขาว-wash** ไล่ #ffffff →
// #e4f6fb หมึก **#06283f** (สูตรปุ่มรองของ §2 — 15.2:1 และ 14.0:1)
// เส้น/ขอบทุกเส้นเป็น #7fcbe8 บนผิวขาว และ #0f5684/40 บนพื้นเพจ ซึ่ง §2 ระบุว่า
// **#7fcbe8 ห้ามถือตัวอักษร**
//
// ⚠️ **เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี"** — ฟ้า/ไซยานนำมาแล้วแปดแบรนด์ในรีโปนี้
// และ **รอบนี้เป็นแบรนด์ฟ้าจริง จึงต้องเทียบทีละหลัก** ฟ้ารอบนี้คือ
// **#12b4ef / #b6e3f0 / #00bfff / #7fcbe8 / #4fb8ea / #0f5684 / #1a6ea8 / #06283f**
// ค่าที่ต้องไม่เหลือในไฟล์นี้:
//   **มาดาม168 (ชุดที่เพิ่งอยู่ทั้งใบนี้)** — ff2e52 e01238 c9102f 1177e8 0e68cc
//     0a4ea8 2a3c70 16234a 0b1733 050e26 00091f f4eef1 d9dfe9 b3bdd6
//     ⚠️ 0a4ea8 ใกล้ #0b4a73 ที่ G (4e vs 4a) แต่ B ห่าง 53 — **grep ทีละค่า**
//   **หมูบิน168 (แบรนด์ขาออก — เสี่ยงหลงเหลือสูงสุด)** — fa539c c2185b 8e0f41
//     fb8cc0 fdc6c3 ffd1cd f7bcd9 ef8dbd ffe5ff fff0f8 ffeef7 3b0b26 54123a 7a2350
//     ffe9f5 7a4463
//   **สล็อต168** — fb2e33 cb0b0d d81115 b00d11 8a0608 f0e6e4 c9b9b7 e3d6d4 7d6f6e
//     140000 0b0000 1c0607 2a0c0d 551c1e
//   **ร่ำรวย168** — 18a5e2 0d6b9b 0a5176 a9d7f2 16294a dbe6ff eef4ff dce9fb f4e4d3
//     e4cbb3 ⚠️⚠️ **18a5e2 ห่างจาก #12b4ef แค่ R6/G15/B13 — ใกล้ที่สุดในรีโป
//     เจอที่ไหนให้สงสัยว่าพิมพ์ผิดก่อน**
//   **นาซ่า168** — 1fd8f0 0bb6d4 8fd9ec 1d4fd8 143aa0 e6edf8 9fb2cb 273449 1b2434
//     121722 33455f 0d1017
//   **สบาย168** — 2cc3fc 6bdcfb 0a7fbd 063a57 04293d 0a4f74 9ae0fa cdf2ff f2fbff
//     ⚠️ **063a57 มี R=06 ตรงกับ #06283f เป๊ะ ต่างที่ G/B 18/24**
//   **นินจา168** — 32bcfb a9e9ff fef54b 6b5c10 07335f 0c2a3d 071a28
//     ⚠️ **07335f ใกล้ #06283f ที่ R (07 vs 06)**
//   **รวยแทร่168** — 039cfa 0494f5 c3ebfc 04366b e3f2fc 0b2d52
//   **สบายเบท168** — 2f9ff5 a8dcff d6ecff 0b3f78 e8f4ff
//   **TSDET911** — 0360f3 0292fb 6ec8ff 4fb4ff cfdcec 9db4d4 dde8f7 00081f
//   **ufalion168 / พักยก168** — d4922c fdfc71 f6e3b4 a25b24 eeae12 fded41 9f600d
//     e0e0df c0c0bf a1a09e f4ead6 291d0f
// (เขียนเฮกซ์ของแบรนด์เก่าแบบ **ไม่มี #** โดยตั้งใจ เพื่อไม่ให้ sweep ที่ไล่หา
// สีของแบรนด์เก่าใน src/ สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
// ⚠️ **รอบนี้ไม่มีแดง ไม่มีชมพู/ฟูเชีย ไม่มีทอง/เหลืองเป็นสี UI ไม่มีส้ม ไม่มีเขียว
// ไม่มีม่วง ไม่มีโรสโกลด์ ไม่มีบรอนซ์ ไม่มีครีม/เบจ/พีช และไม่มีแรมป์เทาเงิน**
// rgba() ที่อนุญาตรอบนี้: rgba(18,180,239,α) · rgba(182,227,240,α) ·
// rgba(15,86,132,α) · rgba(6,40,63,α) · rgba(127,203,232,α)
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#0f5684]/40 pb-4">
        <div aria-hidden="true" class="h-9 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#12b4ef] via-[#4fb8ea] to-[#b6e3f0] shadow-[0_0_12px_rgba(18,180,239,0.55)]" />
        <HeadingTag class={`${headingSize} leading-normal font-black tracking-wide text-[#06283f]`}>{title}</HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 rounded-3xl border border-[#7fcbe8] bg-white p-6 text-left text-base leading-relaxed text-[#06283f] shadow-[0_10px_26px_rgba(15,86,132,0.12)] md:p-7">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#7fcbe8] pb-3 text-xl leading-normal font-black tracking-wide text-[#0f5684]">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#0f5684] bg-gradient-to-br from-[#1a6ea8] to-[#0f5684] text-sm text-white shadow-[0_5px_15px_rgba(15,86,132,0.4)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 rounded-3xl border border-[#7fcbe8] bg-white p-6 text-left text-base leading-relaxed text-[#06283f] shadow-[0_10px_26px_rgba(15,86,132,0.12)] md:p-7">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#7fcbe8] pb-3 text-xl leading-normal font-black tracking-wide text-[#06283f]">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#4fb8ea] bg-gradient-to-br from-white to-[#e4f6fb] text-sm text-[#06283f] shadow-[0_5px_15px_rgba(127,203,232,0.5)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
