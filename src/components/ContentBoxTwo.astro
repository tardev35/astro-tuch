---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🔐", iconright = "🎟️" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a lottery-listing
// panel), never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
// LoginRtpSection renders it without a title, which is why the page's heading
// inventory stops at the docx's own sections.
//
// Reached only through LoginRtpSection (a nested import), so a grep for
// "components/ContentBoxTwo.astro" in src/pages/ finds nothing — it is LIVE, not
// inventory, and has to carry the current brand's colours.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// หวย365 (รอบแดงสด-ทอง 2026-10-02): เวิร์ดมาร์กเป็นแดงสด #dc0203 ล้วนบนพื้นขาว คำว่า
// "หวย" กับเลข 6 เป็นแดง เลข 3 กับ 5 เป็นดำ บนงานอาร์ตฉากผ้าซาตินแดงที่มีลายไทยทอง
// #ffc93c เหรียญทอง ลูกหวยแดง-ขาว และหญิงสาวในชุดไทยขาว-ทอง สองคอลัมน์ของกล่องนี้
// จึงถูกแยกด้วยคู่ทอง/แดงนั้นตรงๆ — ฝั่งซ้ายเป็นทองเต็มใบ ป้ายไอคอนไล่จากทองอ่อน #ffeab0
// ลงทอง #ffc93c ไปหาทองลึก #c08a07 ซึ่งเป็นจุดที่มืดที่สุดที่ยังรองหมึกเข้ม #1a0303 ได้
// (6.4:1) ส่วนฝั่งขวาเป็นแดงเต็มใบ ป้ายไอคอนไล่แดงสว่าง #f5282a → แดงแบรนด์ #dc0203 →
// แดงลึก #9c0201 และใช้ตัวอักษร "ขาว" ไม่ใช่หมึกเข้ม เพราะขาวบนแดงลึกได้ 9.4:1 ส่วนหมึก
// เข้มบนแดงแบรนด์ตกเกณฑ์ ข้อความป้ายฝั่งขวาใช้สีเนื้อความ #f6e7e0 หัวข้อ docx (เมื่อมีการ
// ส่ง title มา) ไล่ทองอ่อน → ทอง → แดงแบรนด์ เส้นคั่นเป็นแดงลึก #9c0201 ทั้งสองฝั่ง
// เนื้อความ #f6e7e0 (BRAND_TEXT) — ชุดแดง-ทองของ หวยเฮง789 (#dc2224 #f4bc5d #ffefc2
// #fbe3d4 #e43434 #ab0204 #1c0606 #5c0a0a #2b0909) และของ หวยเฮง24 (#e0a52a #fdea83
// #8b0302 #c01616 #720202 #f6e6cf) ออกครบทุกจุด
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#9c0201] pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffeab0] via-[#ffc93c] to-[#dc0203] shadow-[0_0_10px_rgba(255,201,60,0.5)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#ffeab0] via-[#ffc93c] to-[#dc0203] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e7e0]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#9c0201] pb-3 text-xl leading-normal font-black tracking-widest text-[#ffc93c] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#ffc93c]/70 bg-gradient-to-br from-[#ffeab0] via-[#ffc93c] to-[#c08a07] text-sm text-[#1a0303] shadow-[0_5px_15px_rgba(255,201,60,0.40)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e7e0]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#9c0201] pb-3 text-xl leading-normal font-black tracking-widest text-[#f6e7e0] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#f5282a]/70 bg-gradient-to-br from-[#f5282a] via-[#dc0203] to-[#9c0201] text-sm text-white shadow-[0_5px_15px_rgba(220,2,3,0.35)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
