---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🔐", iconright = "🎰" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a game-category
// panel), never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
// LoginRtpSection renders it without a title, which is why the page's heading
// inventory stops at the docx's own sections.
//
// Reached only through LoginRtpSection (a nested import), so a grep for
// "components/ContentBoxTwo.astro" in src/pages/ finds nothing — it is LIVE, not
// inventory, and has to carry the current brand's colours.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// 1SS365 (รอบทอง-เงินโครเมียม-ดำ 2026-10-03): โลโก้เป็นสองโลหะจริง — เหรียญเลข 1 กับ
// เลข 365 เป็นทอง (vivid #edbb23 #ca8b14 #d19416 #f3cb35) ส่วนตัวอักษร 1SS เป็นเงิน
// โครเมียม (#fdfdfd #cdcdcd) สองคอลัมน์ของกล่องนี้จึงถูกแยกด้วยสองโลหะของแบรนด์ ไม่ใช่
// ด้วยความสว่างของสีเดียว — ฝั่งซ้ายเป็นทอง ป้ายไอคอนไล่ทองอ่อน #ffeeb4 → ทองแบรนด์
// #edbb23 → ทองลึก #a87708 บนหมึกเข้ม #1a1710 (พื้นทองต้องใช้หมึกเข้มเสมอ และไล่เฉด
// ใต้หมึกเข้มห้ามจบเข้มกว่าทองลึก ซึ่งวัดได้ 4.8:1) ส่วนฝั่งขวาเป็นเงิน ป้ายไอคอนไล่ขาวเงิน
// #f1f2f3 → เงินโครเมียม #c8cbce → เงินเข้ม #8d9094 และใช้หมึกเข้ม #050505 เช่นกัน
// เพราะพื้นเงินสว่างกว่าทองอีก ป้ายคอลัมน์ซ้ายเป็นทองแบรนด์ ฝั่งขวาเป็นเงินโครเมียม ซึ่ง
// อยู่บนพื้นเพจดำ ไม่ได้อยู่บนพื้นโลหะ หัวข้อ docx (เมื่อมีการส่ง title มา) ไล่ทองอ่อน →
// ทองแบรนด์ → เงิน เส้นคั่นเป็นกรอบอุ่น #2a2115 ทั้งสองฝั่ง เนื้อความ #f0e6d2 (BRAND_TEXT)
//
// ชุดแดงสด-ทองของ หวย365 ที่เคยค้างในไฟล์นี้ (#dc0203 #e00104 #e2020a #f5282a
// #8c0402 #3a0a0c #ffc93c #ffeab0 #c08a07 #1a0303 #f6e7e0) ออกครบทุกจุดแล้ว และแดง
// ถูกถอดออกหมดเพราะโลโก้รอบนี้ไม่มีฮิวแดงเลย เงินโครเมียมกลับเข้ามาเป็นฮิวที่สองจริงแทน
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#2a2115] pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffeeb4] via-[#edbb23] to-[#a87708] shadow-[0_0_10px_rgba(237,187,35,0.5)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#ffeeb4] via-[#edbb23] to-[#c8cbce] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e6d2]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#2a2115] pb-3 text-xl leading-normal font-black tracking-widest text-[#edbb23] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#edbb23]/70 bg-gradient-to-br from-[#ffeeb4] via-[#edbb23] to-[#a87708] text-sm text-[#1a1710] shadow-[0_5px_15px_rgba(237,187,35,0.40)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e6d2]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#2a2115] pb-3 text-xl leading-normal font-black tracking-widest text-[#c8cbce] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#c8cbce]/70 bg-gradient-to-br from-[#f1f2f3] via-[#c8cbce] to-[#8d9094] text-sm text-[#050505] shadow-[0_5px_15px_rgba(200,203,206,0.35)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
