---
export interface Props {
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { titleleft, titleright, label } = Astro.props;

const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f2e6cd]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#b6821d]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#f5c518] uppercase">
            <span aria-hidden="true" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#b6821d]/50 bg-gradient-to-br from-[#fff2c3] via-[#f5c518] to-[#845914] text-sm text-[#2b1c05] shadow-[0_5px_15px_rgba(245,197,24,0.32)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f2e6cd]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#d3d3d3]/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#d3d3d3] uppercase">
            <span aria-hidden="true" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#7c7c7c]/60 bg-gradient-to-br from-[#f1f1f1] via-[#d3d3d3] to-[#7c7c7c] text-sm text-[#1a1a1a] shadow-[0_5px_15px_rgba(211,211,211,0.28)]">
              🎰
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
