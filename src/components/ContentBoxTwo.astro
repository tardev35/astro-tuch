---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🔐", iconright = "🎰" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a game-list panel),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
// LoginRtpSection renders it without a title, which is why the page's heading
// inventory stops at the docx's own sections.
//
// Reached only through LoginRtpSection (a nested import), so a grep for
// "components/ContentBoxTwo.astro" in src/pages/ finds nothing — it is LIVE, not
// inventory, and has to carry the current brand's colours.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// BOOM369 (รอบเขียวนีออน-เงิน บนดำสนิท 2026-10-07, brand-spec §2): โลโก้รอบนี้เป็นสอง
// วัสดุในเวิร์ดมาร์กเดียว — คำว่า "BOOM" เป็นเขียวนีออน #42fb5a ที่มีขอบโครเมียม ติดกับ
// ตัวเลข "369" เงินแปรง #dadcdc ในวงแหวนเปิดที่ไล่เขียวนีออนไปหาเทอร์ควอยซ์เข้ม สอง
// คอลัมน์ของกล่องนี้จึงถูกแยกด้วยคู่วัสดุนั้นตรงๆ ไม่ใช่ด้วยความสว่างของสีเดียว —
// ฝั่งซ้ายเป็นฝั่งเขียว ป้ายไอคอนไล่เขียวนีออน #42fb5a → เขียวแบรนด์ #04ab3a → เขียวลึก
// #036b26 บนหมึกเขียวดำ #03150a (พื้น #42fb5a ใช้หมึกนี้ได้สีเดียวตาม §2) ป้ายคอลัมน์
// เป็นเขียวนีออน ส่วนฝั่งขวาเป็นฝั่งเงิน ป้ายไอคอนเป็นปุ่มรอง ไล่ผิวยก #0b231b → ผิว
// ลึกสุด #041109 ขอบเขียวนีออนโปร่ง บนหมึกเนื้อความ #cfe9d7 ป้ายคอลัมน์เป็นเงิน
// โครเมียม #dadcdc
// หัวข้อ docx (เมื่อมีการส่ง title มา) ไล่เขียวนีออน → เงินโครเมียม → ทอง #f3c44a
// เส้นคั่นเป็นเขียวลึก #036b26 ทั้งสองฝั่ง เนื้อความ #cfe9d7 (= BRAND_TEXT)
//
// ไอคอนเริ่มต้นเป็น 🔐 / 🎰 — รอบนี้เป็นเว็บสล็อต ไม่ใช่เว็บหวย
// (LoginRtpSection ส่งไอคอนมาเองอยู่แล้ว ค่านี้คือกันหลงเท่านั้น)
//
// ชุดฟ้า-ทองบนการ์ดสว่างของ HI59 ที่เคยค้างในไฟล์นี้ (#0a84e0 #065a9c #044b80
// #033f70 #06355f #fdbc04 #ffe27a #c88a02 #8a6102 #04203f #eaf5ff #9ecbf2
// #0d2744 rgba(10,132,224,…) rgba(6,90,156,…) rgba(200,138,2,…)) ออกครบทุกจุดแล้ว
// — รอบนี้เป็นการพลิกขั้วกลับจากการ์ดสว่างเป็นการ์ดมืด ไม่ใช่การเปลี่ยนเบอร์สีบนโครงเดิม
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#036b26] pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#42fb5a] via-[#04ab3a] to-[#036b26] shadow-[0_0_10px_rgba(66,251,90,0.55)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#42fb5a] via-[#dadcdc] to-[#f3c44a] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cfe9d7]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#036b26] pb-3 text-xl leading-normal font-black tracking-widest text-[#42fb5a] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#036b26] bg-gradient-to-br from-[#42fb5a] via-[#04ab3a] to-[#036b26] text-sm text-[#03150a] shadow-[0_5px_15px_rgba(66,251,90,0.45)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cfe9d7]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#036b26] pb-3 text-xl leading-normal font-black tracking-widest text-[#dadcdc] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#42fb5a]/60 bg-gradient-to-br from-[#0b231b] to-[#041109] text-sm text-[#cfe9d7] shadow-[0_0_12px_rgba(66,251,90,0.25)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
