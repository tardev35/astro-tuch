---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🔐", iconright = "🎲" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a lottery-schedule
// panel), never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
// LoginRtpSection renders it without a title, which is why the page's heading
// inventory stops at the docx's own sections.
//
// Reached only through LoginRtpSection (a nested import), so a grep for
// "components/ContentBoxTwo.astro" in src/pages/ finds nothing — it is LIVE, not
// inventory, and has to carry the current brand's colours.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// หวย365 (รอบแดงสด-ทอง-ดำ 2026-10-03): โลโก้เป็นสองสีจริง — คำว่า หวย เป็นแดงสด
// (vivid #dc0203 #e00104 #e2020a) เลข 365 เป็นดำ #020202 ส่วนทองมาจากตัวอักษรบน
// แบนเนอร์ สองคอลัมน์ของกล่องนี้จึงถูกแยกด้วยสองสีของแบรนด์ ไม่ใช่ด้วยความสว่างของสีเดียว
// — ฝั่งซ้ายเป็นทอง ป้ายไอคอนไล่ทองอ่อน #ffeab0 → ทองแบรนด์ #ffc93c → ทองลึก #c08a07
// บนหมึกบนพื้นทอง #1a0303 (ซึ่งเป็นจุดที่เข้มที่สุดที่ยังรองหมึกเข้มได้ที่ 6.4:1 ห้ามไล่
// จบเข้มกว่านี้) ส่วนฝั่งขวาเป็นแดง ป้ายไอคอนไล่แดงสว่าง #f5282a → แดงแบรนด์ #dc0203 →
// แดงลึก #8c0402 และใช้ตัวอักษร "ขาว" เพราะหมึกเข้มบนพื้นแดงได้แค่ 2.8:1 (ตก) ส่วนขาว
// ได้ ~5.1:1 (ผ่าน) ป้ายคอลัมน์ซ้ายเป็นทองแบรนด์ ฝั่งขวาเป็นแดงสว่าง #f5282a ซึ่งอยู่บน
// พื้นเพจเข้ม ไม่ได้อยู่บนพื้นแดง หัวข้อ docx (เมื่อมีการส่ง title มา) ไล่ทองอ่อน → ทองแบรนด์
// → แดงสว่าง เส้นคั่นเป็นพื้นยกระดับ #3a0a0c ทั้งสองฝั่ง เนื้อความ #f6e7e0 (BRAND_TEXT)
//
// ชุดทอง-เงินของ NATO168 ที่เคยค้างในไฟล์นี้ (#edb543 #fde8a8 #a9761f #e6e6e6 #a9a9a9
// #3a2a0d #1a1203 #f4ead3) ออกครบทุกจุดแล้ว เงินถูกถอดออกทั้งหมดเพราะโลโก้รอบนี้ไม่มี
// ฮิวเงินเลย แดงเข้ามาเป็นฮิวที่สองจริงแทน
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#3a0a0c] pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffeab0] via-[#ffc93c] to-[#c08a07] shadow-[0_0_10px_rgba(255,201,60,0.5)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#ffeab0] via-[#ffc93c] to-[#f5282a] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e7e0]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#3a0a0c] pb-3 text-xl leading-normal font-black tracking-widest text-[#ffc93c] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#ffc93c]/70 bg-gradient-to-br from-[#ffeab0] via-[#ffc93c] to-[#c08a07] text-sm text-[#1a0303] shadow-[0_5px_15px_rgba(255,201,60,0.40)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e7e0]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#3a0a0c] pb-3 text-xl leading-normal font-black tracking-widest text-[#f5282a] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#f5282a]/70 bg-gradient-to-br from-[#f5282a] via-[#dc0203] to-[#8c0402] text-sm text-white shadow-[0_5px_15px_rgba(220,2,3,0.35)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
