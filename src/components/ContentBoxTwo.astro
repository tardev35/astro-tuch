---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🔐", iconright = "🎰" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a game-category
// panel), never docx article content, so both column labels render as <p> and
// the section gets its accessible name from aria-label instead of a heading.
// With a `title` the heading itself names the region, so the aria-label is
// dropped. LoginRtpSection renders it without a title this round, which is why
// the page's heading inventory stops at the docx's own sections.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// CK268 (รอบเขียวนีออน-โครเมียม-ดำ 2026-09-30): เวิร์ดมาร์กเป็นโลหะสองโทน ตัว C กับ
// เลข 68 เป็นโครเมียมขาวเงิน ส่วนตัว K กับเลข 2 เป็นเขียวนีออนไล่เฉด บนงานอาร์ตพื้น
// ดำสนิทที่มีริ้วแสงเขียวนีออนพาดโค้ง ชิปคาสิโนเขียว-ดำ และไพ่โพดำ สองคอลัมน์ของ
// กล่องนี้จึงถูกแยกด้วยคู่เขียว/โครเมียมนั้นตรงๆ ตามลำดับบนโลโก้ — ฝั่งซ้ายเป็นเขียว
// เต็มใบ ป้ายไอคอนไล่จากเขียวอ่อน #c9ff8f ลงเขียวนีออนแบรนด์ #8bfc13 ไปหาเขียวลึก
// #1a7a08 ส่วนฝั่งขวาเป็นโครเมียมเต็มใบ ป้ายไอคอนไล่โครเมียมขาว #e8f0e6 → โครเมียม
// กลาง #b9c9b4 → โครเมียมหม่น #8fa38a ตัวอักษรบนป้ายทั้งสองเป็นหมึกเข้ม #030703
// เพราะทั้งคู่เป็นพื้นสว่าง (14.9:1 และ 15.5:1) ตามกฎคอนทราสต์ หัวข้อ docx (เมื่อมี
// การส่ง title มา) ไล่โครเมียมขาว → เขียวนีออน → เขียวลึก เส้นคั่นเป็นเขียวลึกทั้ง
// สองฝั่ง เนื้อความ #d5e6cd (BRAND_TEXT) — ชุดทอง-แดงของ GOT777 (#f5c518 #ffe9a8
// #96690f #d21622 #7b0304 #4c0301 #0a0503 #ece0cb) ออกทั้งหมด ทองไม่เหลืออยู่เลย
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#1a7a08] pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e8f0e6] via-[#8bfc13] to-[#1a7a08] shadow-[0_0_10px_rgba(139,252,19,0.5)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#e8f0e6] via-[#8bfc13] to-[#1a7a08] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d5e6cd]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#1a7a08] pb-3 text-xl leading-normal font-black tracking-widest text-[#c9ff8f] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#8bfc13]/70 bg-gradient-to-br from-[#c9ff8f] via-[#8bfc13] to-[#1a7a08] text-sm text-[#030703] shadow-[0_5px_15px_rgba(139,252,19,0.4)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d5e6cd]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#1a7a08] pb-3 text-xl leading-normal font-black tracking-widest text-[#e8f0e6] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#e8f0e6]/70 bg-gradient-to-br from-[#e8f0e6] via-[#b9c9b4] to-[#8fa38a] text-sm text-[#030703] shadow-[0_5px_15px_rgba(232,240,230,0.3)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
