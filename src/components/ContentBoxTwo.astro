---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a game list),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// SAGAME66 (รอบทอง-เงินโครเมียม 2026-09-23): โลโก้แบรนด์นี้เป็นตัวอักษร SA ทอง
// สามมิติ ต่อด้วย GAME สีเงินโครเมียม แล้ว 66 กลับมาเป็นทอง สองครึ่งของกล่องจึงแยก
// กันด้วยคู่สีนั้นจริงๆ ป้ายไอคอนฝั่งซ้ายไล่จากทองสว่าง #ffe9a3 ลงทองหลัก #e8b93f
// ไปหาทองลึก #96671a ตัวอักษรบนป้ายใช้สีพื้นเพจ #0d0903 ส่วนฝั่งขวาไล่จากเงิน
// โครเมียม #eef3f8 ลงเงินกลาง #b6c1cd ไปจบที่ทองลึก #96671a เส้นคั่นเป็นทองหลัก
// กับพื้นยก #2a1d0b เนื้อความ #e3d8c0 (BRAND_TEXT) — แดง-เงินเย็นของ UFAGOOL
// (#c50d12 #ef1f25 #7a0103 #5e0507 #f4f7fa #b8c3cf #cdd5dd #5c6672 #0a0708)
// ออกหมด
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#e8b93f]/40 pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe9a3] via-[#e8b93f] to-[#96671a] shadow-[0_0_10px_rgba(232,185,63,0.45)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#ffe9a3] via-[#eef3f8] to-[#e8b93f] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e3d8c0]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#e8b93f]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#ffe9a3] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#e8b93f]/70 bg-gradient-to-br from-[#ffe9a3] via-[#e8b93f] to-[#96671a] text-sm text-[#0d0903] shadow-[0_5px_15px_rgba(232,185,63,0.45)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e3d8c0]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#2a1d0b] pb-3 text-xl leading-normal font-black tracking-widest text-[#eef3f8] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#eef3f8]/50 bg-gradient-to-br from-[#eef3f8] via-[#b6c1cd] to-[#96671a] text-sm text-[#0d0903] shadow-[0_5px_15px_rgba(238,243,248,0.3)]">
              📋
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
