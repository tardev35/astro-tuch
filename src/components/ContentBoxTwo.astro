---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a service list),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#1d4ed8]/60 pb-4">
        <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#2563eb] to-[#cbd5e1] shadow-[0_0_10px_rgba(59,130,246,0.55)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#f1f5f9] via-[#60a5fa] to-[#cbd5e1] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cbd5e1]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#3b82f6]/45 pb-3 text-xl leading-normal font-black tracking-widest text-[#60a5fa] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#3b82f6]/55 bg-gradient-to-br from-[#2563eb] via-[#3b82f6] to-[#1d4ed8] text-sm text-[#03060f] shadow-[0_5px_15px_rgba(59,130,246,0.32)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cbd5e1]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#cbd5e1]/55 pb-3 text-xl leading-normal font-black tracking-widest text-[#cbd5e1] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#cbd5e1]/60 bg-gradient-to-br from-[#f1f5f9] via-[#cbd5e1] to-[#132447] text-sm text-[#03060f] shadow-[0_5px_15px_rgba(203,213,225,0.3)]">
              🎴
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
