---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🔐", iconright = "🎟️" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a lottery-list
// panel), never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
// LoginRtpSection renders it without a title, which is why the page's heading
// inventory stops at the docx's own sections.
//
// Reached only through LoginRtpSection (a nested import), so a grep for
// "components/ContentBoxTwo.astro" in src/pages/ finds nothing — it is LIVE, not
// inventory, and has to carry the current brand's colours.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// หวยดีใจ (รอบแดงแบรนด์ + เงินโครเมียม บนดำอมแดง 2026-10-04): brand-spec §2
// โลโก้รอบนี้เป็นสองโลหะในคำเดียว — "หวย" เป็นเงินโครเมียม (#eef0f4 / #c3c7d1) และ
// "ดีใจ" เป็นแดงเมทัลลิก (#dc0409) โดยมีมงกุฎทอง #f3c54e อยู่เหนือทั้งสองคำ สองคอลัมน์
// ของกล่องนี้จึงถูกแยกด้วยคู่โลหะนั้นตรงๆ ไม่ใช่ด้วยความสว่างของสีเดียว — ฝั่งซ้าย
// เป็นแดง ป้ายไอคอนไล่แดงสว่าง #f5363d → แดงแบรนด์ → แดงลึก #8e0206 บนหมึกสว่าง
// #edeaf0 (พื้นแดงเข้มต้องใช้หมึกสว่างเสมอ) ป้ายคอลัมน์เป็นแดงสว่าง ส่วนฝั่งขวาเป็น
// เงินโครเมียม ป้ายไอคอนไล่เงินสว่าง #eef0f4 → เงินกลาง → เงินหม่น #8d93a1 บนหมึก
// เข้ม #0d0407 (พื้นเงินสว่างต้องใช้หมึกเข้มเสมอ) ป้ายคอลัมน์เป็นเงินกลาง หัวข้อ docx
// (เมื่อมีการส่ง title มา) ไล่เงินสว่าง → ทอง → แดงแบรนด์ เส้นคั่นเป็นแดงดำ #4b0205
// ทั้งสองฝั่ง เนื้อความ #edeaf0 (= BRAND_TEXT) glow เป็น rgba(220,4,9,…)
//
// ไอคอนเริ่มต้นเป็น 🔐 / 🎟️ — รอบนี้เป็นเว็บหวยล้วน ไม่ใช่คาสิโน
// (LoginRtpSection ส่งไอคอนมาเองอยู่แล้ว ค่านี้คือกันหลงเท่านั้น)
//
// ชุดแดง + ทองของ หวย24 ที่เคยค้างในไฟล์นี้ (#d20a0a #f5c33b #ffd45e #a9761a
// #ff3b3b #7a0505 #3d0a0a #190505 #fff1e8 #f7e2d6 rgba(210,10,10,…)
// rgba(245,195,59,…)) ออกครบทุกจุดแล้ว — รอบนี้คู่สีหลักคือ แดง/เงิน ทองเหลือเป็น
// สีรองที่ใช้เฉพาะปลายไล่เฉดของหัวข้อ
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#4b0205] pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#eef0f4] via-[#f3c54e] to-[#dc0409] shadow-[0_0_10px_rgba(220,4,9,0.5)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#eef0f4] via-[#f3c54e] to-[#dc0409] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#edeaf0]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#4b0205] pb-3 text-xl leading-normal font-black tracking-widest text-[#f5363d] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#f5363d]/70 bg-gradient-to-br from-[#f5363d] via-[#dc0409] to-[#8e0206] text-sm text-[#edeaf0] shadow-[0_5px_15px_rgba(220,4,9,0.45)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#edeaf0]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#4b0205] pb-3 text-xl leading-normal font-black tracking-widest text-[#c3c7d1] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#eef0f4]/70 bg-gradient-to-br from-[#eef0f4] via-[#c3c7d1] to-[#8d93a1] text-sm text-[#0d0407] shadow-[0_5px_15px_rgba(195,199,209,0.40)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
