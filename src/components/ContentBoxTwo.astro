---
export interface Props {
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { titleleft, titleright, label } = Astro.props;

// This box carries chrome (a login widget, a service list), never docx article
// content, so both column labels render as <p> and the section gets its
// accessible name from aria-label instead of a heading.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d5e8d0]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#25cb0e]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#6ef25a] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#25cb0e]/50 bg-gradient-to-br from-[#6ef25a] via-[#25cb0e] to-[#063f04] text-sm text-[#031204] shadow-[0_5px_15px_rgba(37,203,14,0.32)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d5e8d0]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#cfd6cd]/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#f0f7ee] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#8fa08c]/60 bg-gradient-to-br from-[#f0f7ee] via-[#cfd6cd] to-[#8fa08c] text-sm text-[#010301] shadow-[0_5px_15px_rgba(240,247,238,0.28)]">
              🎰
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
