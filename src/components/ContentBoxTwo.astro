---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a service list),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#1046e0]/45 pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e6ecf7] to-[#7d90ad] shadow-[0_0_10px_rgba(183,198,221,0.55)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#e6ecf7] via-[#b7c6dd] to-[#7d90ad] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d6e2f5]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#1046e0]/45 pb-3 text-xl leading-normal font-black tracking-widest text-[#8fc2ff] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#1046e0]/60 bg-gradient-to-br from-[#8fc2ff] via-[#3d82ff] to-[#1046e0] text-sm text-[#01041c] shadow-[0_5px_15px_rgba(16,70,224,0.30)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d6e2f5]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#b7c6dd]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#b7c6dd] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#b7c6dd]/60 bg-gradient-to-br from-[#e6ecf7] via-[#b7c6dd] to-[#7d90ad] text-sm text-[#01041c] shadow-[0_5px_15px_rgba(183,198,221,0.35)]">
              📋
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
