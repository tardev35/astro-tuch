---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a service list),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#1e7bf5]/40 pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#8ec5ff] to-[#0a3fa8] shadow-[0_0_10px_rgba(30,123,245,0.55)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#8ec5ff] via-[#1e7bf5] to-[#0a3fa8] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d6e2f5]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#1e7bf5]/45 pb-3 text-xl leading-normal font-black tracking-widest text-[#6fb4ff] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#1e7bf5]/60 bg-gradient-to-br from-[#8ec5ff] via-[#1e7bf5] to-[#0a3fa8] text-sm text-[#02060f] shadow-[0_5px_15px_rgba(30,123,245,0.30)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d6e2f5]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#cfd8e6]/35 pb-3 text-xl leading-normal font-black tracking-widest text-[#cfd8e6] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#cfd8e6]/60 bg-gradient-to-br from-[#f4f8ff] via-[#cfd8e6] to-[#7f8ea3] text-sm text-[#02060f] shadow-[0_5px_15px_rgba(207,216,230,0.22)]">
              📊
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
