---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🔐", iconright = "🎰" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a game-category
// panel), never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
// LoginRtpSection renders it without a title, which is why the page's heading
// inventory stops at the docx's own sections.
//
// Reached only through LoginRtpSection (a nested import), so a grep for
// "components/ContentBoxTwo.astro" in src/pages/ finds nothing — it is LIVE, not
// inventory, and has to carry the current brand's colours.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// DM899 (รอบเขียวมรกต-แดงสด-ทอง บนดำอมเขียว 2026-10-03): โลโก้เป็นคู่สีจริง — ตัว D
// เป็นเขียว (vivid #01841b #018b1b) ซ้อนตัว M เป็นแดง (#fb252b #bb0303 #f91c20)
// ตามด้วยเลข 899 โครเมียม สองคอลัมน์ของกล่องนี้จึงถูกแยกด้วยคู่ D/M นั้นตรงๆ ไม่ใช่
// ด้วยความสว่างของสีเดียว — ฝั่งซ้ายเป็นเขียว ป้ายไอคอนไล่เขียวสว่าง #4ade6b →
// เขียวสว่างกลาง #12c23a → เขียวแบรนด์ #01a326 บนหมึกบนพื้นสว่าง #06140a (พื้น
// เขียวสว่างต้องใช้หมึกเข้มเสมอ และไล่เฉดใต้หมึกเข้มห้ามจบเข้มกว่าเขียวแบรนด์ ซึ่ง
// วัดได้ 5.6:1 ส่วนเขียวแกน #01841b ตกเหลือ 3.9:1) ส่วนฝั่งขวาเป็นแดง ป้ายไอคอนไล่
// แดงอ่อน #ff6b6e → แดงแบรนด์ #fb252b → แดงลึก #8f0609 และใช้ตัวอักษรขาว เพราะ
// หมึกเข้มบนแดงแบรนด์ได้แค่ 2.8:1 ป้ายคอลัมน์ซ้ายเป็นเขียวสว่าง #4ade6b ฝั่งขวาเป็น
// แดงอ่อน #ff6b6e ซึ่งอยู่บนพื้นเพจดำอมเขียว ไม่ได้อยู่บนพื้นสี หัวข้อ docx (เมื่อมี
// การส่ง title มา) ไล่ทองอ่อน #ffe9a8 → ทองแบรนด์ #f2b422 → เขียวสว่าง #12c23a
// เส้นคั่นเป็นเขียวลึก #0a4a18 ทั้งสองฝั่ง เนื้อความ #e4f2e4 (BRAND_TEXT)
//
// ชุดทอง-เงินโครเมียมของ 1SS365 ที่เคยค้างในไฟล์นี้ (#edbb23 #ffeeb4 #a87708
// #c8cbce #f1f2f3 #8d9094 #2a2115 #1a1710 #050505 #f0e6d2) ออกครบทุกจุดแล้ว
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#0a4a18] pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#4ade6b] via-[#01a326] to-[#01841b] shadow-[0_0_10px_rgba(1,163,38,0.5)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#ffe9a8] via-[#f2b422] to-[#12c23a] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e4f2e4]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#0a4a18] pb-3 text-xl leading-normal font-black tracking-widest text-[#4ade6b] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#4ade6b]/70 bg-gradient-to-br from-[#4ade6b] via-[#12c23a] to-[#01a326] text-sm text-[#06140a] shadow-[0_5px_15px_rgba(1,163,38,0.40)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e4f2e4]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#0a4a18] pb-3 text-xl leading-normal font-black tracking-widest text-[#ff6b6e] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#ff6b6e]/70 bg-gradient-to-br from-[#ff6b6e] via-[#fb252b] to-[#8f0609] text-sm text-white shadow-[0_5px_15px_rgba(251,37,43,0.35)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
