---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a checklist panel),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
// LoginRtpSection renders it without a title this round, which is why the page's
// heading inventory stops at the eight docx sections.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// BRAZIL999 (รอบเขียว-โครเมียม-ดำ 2026-09-25): โลโก้เขียน BRAZIL เป็นโครเมียมขัดเงา
// แล้วปิดท้ายด้วย 999 สีเขียวสด สองคอลัมน์ของกล่องนี้จึงถูกแยกด้วยคู่วัสดุนั้นตรงๆ —
// ฝั่งซ้ายเป็นเขียวล้วน ป้ายไอคอนไล่จากเขียวสว่าง #7cf25c ลงเขียวแบรนด์ #22c55e ไปหา
// เขียวลึก #04380c ตัวอักษรบนป้ายใช้ #040a05 ตามกฎคอนทราสต์ที่ว่าตัวอักษรบนพื้นสว่าง
// ต้องเกือบดำ ไม่ใช่ขาว ส่วนฝั่งขวาเป็นโครเมียมล้วน ไล่จากโครเมียมสว่าง #f1f5f9 ลง
// โครเมียมกลาง #aab4bf ไปจบที่โครเมียมลึก #6b7580 หัวข้อ docx (เมื่อมีการส่ง title
// มา) ไล่โครเมียม-เขียวสว่าง-เขียวแบรนด์ตามลำดับบนโลโก้ เส้นคั่นเป็นเขียวลึก #1c5a26
// ฝั่งซ้ายกับผิวการ์ดยก #123a18 ฝั่งขวา เนื้อความ #dfeadd (BRAND_TEXT) — ชุด
// ทอง-โครเมียมของ MIRACLE55 (#fee47b #fcda65 #8c5f14 #d9a62b #fcfcfc #d2d3d4
// #a8acb1 #2c241c #0d0a06 #e8e6e1) ออกทั้งหมด แบรนด์นี้ไม่ได้นำด้วยทอง
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#1c5a26]/70 pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f1f5f9] via-[#b6ff9c] to-[#22c55e] shadow-[0_0_10px_rgba(34,197,94,0.5)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#f1f5f9] via-[#b6ff9c] to-[#22c55e] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dfeadd]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#1c5a26]/70 pb-3 text-xl leading-normal font-black tracking-widest text-[#7cf25c] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#22c55e]/70 bg-gradient-to-br from-[#7cf25c] via-[#22c55e] to-[#04380c] text-sm text-[#040a05] shadow-[0_5px_15px_rgba(34,197,94,0.4)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dfeadd]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#123a18] pb-3 text-xl leading-normal font-black tracking-widest text-[#aab4bf] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#aab4bf]/55 bg-gradient-to-br from-[#f1f5f9] via-[#aab4bf] to-[#6b7580] text-sm text-[#040a05] shadow-[0_5px_15px_rgba(170,180,191,0.28)]">
              🛡️
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
