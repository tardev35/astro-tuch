---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a service list),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Left column badge brand green, right column badge coin gold — the YADOM168
// artwork's own split (a chrome wordmark over a green 168, against gold coins),
// so the two halves are told apart by hue, not only by position.
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#0f3d0d]/55 pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#8fe06f] via-[#5cc23f] to-[#1d6b18] shadow-[0_0_10px_rgba(92,194,63,0.45)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#8fe06f] via-[#f2fbef] to-[#5cc23f] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d4e8cb]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#0f3d0d]/55 pb-3 text-xl leading-normal font-black tracking-widest text-[#8fe06f] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#0f3d0d]/70 bg-gradient-to-br from-[#8fe06f] via-[#5cc23f] to-[#1d6b18] text-sm text-[#040d04] shadow-[0_5px_15px_rgba(92,194,63,0.30)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d4e8cb]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#e6bd5c]/30 pb-3 text-xl leading-normal font-black tracking-widest text-[#e6bd5c] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#e6bd5c]/50 bg-gradient-to-br from-[#e6bd5c] via-[#9c8340] to-[#1d6b18] text-sm text-[#040d04] shadow-[0_5px_15px_rgba(230,189,92,0.35)]">
              📋
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
