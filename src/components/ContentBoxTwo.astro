---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a service list),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// FAH999 (รอบม่วง-ทอง 2026-09-21): สองครึ่งแยกกันด้วย "สี" ไม่ใช่ความสว่าง —
// ป้ายไอคอนฝั่งซ้ายไล่จากทองประกาย #fef354 ลงทองหลัก #fbbf13 ไปหาม่วงกลาง
// #7c2fd4 ตัวอักษรบนป้ายทองใช้สีการ์ด #180430 ส่วนฝั่งขวาไล่จากม่วงสว่าง
// #a855f7 ลงม่วงกลางไปหาม่วงเข้ม #4a1188 ตัวอักษรบนป้ายม่วงใช้สีเนื้อความ
// #ecdcff เส้นคั่นและกรอบเป็นม่วงเข้มกับทองหลัก — โทนดำ+บรอนซ์ของรอบก่อนหายไป
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#fbbf13]/40 pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fef354] via-[#fbbf13] to-[#7c2fd4] shadow-[0_0_10px_rgba(251,191,19,0.55)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#fef354] via-[#fbbf13] to-[#a855f7] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ecdcff]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#fbbf13]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#ffdf6b] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#fbbf13]/70 bg-gradient-to-br from-[#fef354] via-[#fbbf13] to-[#7c2fd4] text-sm text-[#180430] shadow-[0_5px_15px_rgba(251,191,19,0.35)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ecdcff]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#4a1188] pb-3 text-xl leading-normal font-black tracking-widest text-[#ecdcff] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#a855f7]/70 bg-gradient-to-br from-[#a855f7] via-[#7c2fd4] to-[#4a1188] text-sm text-[#ecdcff] shadow-[0_5px_15px_rgba(168,85,247,0.30)]">
              🛡️
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
