---
export interface Props {
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { titleleft, titleright, label } = Astro.props;

const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e6c8]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#ebbc4c]/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#ebbc4c] uppercase">
            <span aria-hidden="true" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#ebbc4c]/40 bg-gradient-to-br from-[#fcf3ab] via-[#ebbc4c] to-[#9a6d25] text-sm text-[#241705] shadow-[0_5px_15px_rgba(235,188,76,0.3)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e6c8]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#ebbc4c]/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#ebbc4c] uppercase">
            <span aria-hidden="true" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#9a6d25]/50 bg-gradient-to-br from-[#ebbc4c] via-[#9a6d25] to-[#744b1b] text-sm text-[#241705] shadow-[0_5px_15px_rgba(154,109,37,0.35)]">
              🎰
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
