---
export interface Props {
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { titleleft, titleright, label } = Astro.props;

// This box carries chrome (a login widget, a service list), never docx article
// content, so both column labels render as <p> and the section gets its
// accessible name from aria-label instead of a heading.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e4dc]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#fdd32d]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#fdd32d] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#fdd32d]/50 bg-gradient-to-br from-[#ffe98a] via-[#fdd32d] to-[#6b4c05] text-sm text-[#0d0303] shadow-[0_5px_15px_rgba(253,211,45,0.32)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e4dc]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#8e0c0a]/45 pb-3 text-xl leading-normal font-black tracking-widest text-[#f5322e] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#f5322e]/60 bg-gradient-to-br from-[#f5322e] via-[#d31411] to-[#8e0c0a] text-sm text-[#ffe98a] shadow-[0_5px_15px_rgba(211,20,17,0.28)]">
              🎲
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
