---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a game-category
// list), never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
// LoginRtpSection renders it without a title this round, which is why the page's
// heading inventory stops at the eight docx sections.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// KINGDOM66 (รอบทอง-ดำ 2026-09-25): โลโก้แบรนด์นี้เขียนคำว่า KINGDOM เป็นทองแกะสลัก
// ด้านไล่อ่อนไปเข้มบนพื้นเกือบดำ แล้วปิดท้ายด้วยเลข 66 ทองเต็มดวง สองครึ่งของกล่องจึง
// แยกกันด้วยคู่สีนั้นจริงๆ ป้ายไอคอนฝั่งซ้ายไล่จากทองสว่าง #f2d683 ลงทองแบรนด์
// #e6bf4e ไปหาทองลึก #5c4113 ตัวอักษรบนป้ายใช้สีดำอมทอง #1a1206 ตามกฎคอนทราสต์ที่ว่า
// ตัวอักษรบนพื้นทองต้องเกือบดำ ไม่ใช่ขาว ส่วนฝั่งขวาไล่จากครีมแพลตินัมอุ่น #efe6cf ลง
// ครีมหม่น #b5a888 ไปจบที่ทองลึก เส้นคั่นเป็นทองลึกกับผิวการ์ดยก #241c13 เนื้อความ
// #ebe3d3 (BRAND_TEXT) — ชุดทอง-เงินโครเมียมเย็นของ UWIN33 (#e0b429 #fbd564
// #7a5407 #dfe4ec #a6adb9 #161106 #26200e #080602 #ece6d8) ออกทั้งหมด แบรนด์นี้
// ไม่มีสีเงินเย็นอยู่เลย
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#5c4113]/70 pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#efe6cf] via-[#f2d683] to-[#e6bf4e] shadow-[0_0_10px_rgba(230,191,78,0.5)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#efe6cf] via-[#f2d683] to-[#e6bf4e] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ebe3d3]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#5c4113]/70 pb-3 text-xl leading-normal font-black tracking-widest text-[#f2d683] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#e6bf4e]/70 bg-gradient-to-br from-[#f2d683] via-[#e6bf4e] to-[#5c4113] text-sm text-[#1a1206] shadow-[0_5px_15px_rgba(230,191,78,0.4)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ebe3d3]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#241c13] pb-3 text-xl leading-normal font-black tracking-widest text-[#efe6cf] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#efe6cf]/50 bg-gradient-to-br from-[#efe6cf] via-[#b5a888] to-[#5c4113] text-sm text-[#1a1206] shadow-[0_5px_15px_rgba(239,230,207,0.24)]">
              🎮
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
