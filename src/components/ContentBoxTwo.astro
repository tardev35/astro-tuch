---
export interface Props {
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { titleleft, titleright, label } = Astro.props;

// This box carries chrome (a login widget, a service list), never docx article
// content, so both column labels render as <p> and the section gets its
// accessible name from aria-label instead of a heading.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece3d1]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#e6b74e]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#f6dfa4] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#e6b74e]/50 bg-gradient-to-br from-[#f6dfa4] via-[#e6b74e] to-[#5c4212] text-sm text-[#050505] shadow-[0_5px_15px_rgba(230,183,78,0.32)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece3d1]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#8f9aa6]/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#c8cfd8] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#8f9aa6]/60 bg-gradient-to-br from-[#eef2f6] via-[#c8cfd8] to-[#8f9aa6] text-sm text-[#050505] shadow-[0_5px_15px_rgba(200,207,216,0.28)]">
              🎰
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
