---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a service list),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Left column badge gold, right column badge chrome silver — the SUPERMAX168
// wordmark's own split, so the two halves are told apart by hue, not only by
// position.
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#ba8219]/55 pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fff8e2] via-[#e3e3e4] to-[#ba8219] shadow-[0_0_10px_rgba(236,201,100,0.45)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#f9e38b] via-[#fff8e2] to-[#e3e3e4] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e6c8]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#ba8219]/55 pb-3 text-xl leading-normal font-black tracking-widest text-[#f9e38b] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#ba8219]/70 bg-gradient-to-br from-[#f9e38b] via-[#ecc964] to-[#ba8219] text-sm text-[#030201] shadow-[0_5px_15px_rgba(236,201,100,0.30)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e6c8]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#e3e3e4]/30 pb-3 text-xl leading-normal font-black tracking-widest text-[#e3e3e4] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#e3e3e4]/50 bg-gradient-to-br from-[#e3e3e4] via-[#d2a43b] to-[#ba8219] text-sm text-[#030201] shadow-[0_5px_15px_rgba(227,227,228,0.35)]">
              📋
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
