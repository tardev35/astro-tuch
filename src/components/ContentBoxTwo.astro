---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a service list),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Left column badge emerald, right column badge chrome-white — the TTN69 logo's
// own split (a snow-capped peak over an emerald ridge), so the two halves are
// told apart by hue, not only by position.
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#046b3a]/55 pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f1faf4] via-[#e4ece7] to-[#046b3a] shadow-[0_0_10px_rgba(2,185,97,0.45)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#4ce68f] via-[#f1faf4] to-[#e4ece7] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d5e6da]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#046b3a]/55 pb-3 text-xl leading-normal font-black tracking-widest text-[#4ce68f] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#046b3a]/70 bg-gradient-to-br from-[#4ce68f] via-[#02b961] to-[#046b3a] text-sm text-[#020805] shadow-[0_5px_15px_rgba(2,185,97,0.30)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d5e6da]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#e4ece7]/30 pb-3 text-xl leading-normal font-black tracking-widest text-[#e4ece7] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#e4ece7]/50 bg-gradient-to-br from-[#e4ece7] via-[#9db0a4] to-[#046b3a] text-sm text-[#020805] shadow-[0_5px_15px_rgba(228,236,231,0.35)]">
              📋
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
