---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🔐", iconright = "🎰" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a channel panel),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
// LoginRtpSection renders it without a title, which is why the page's heading
// inventory stops at the docx's own sections.
//
// Reached only through LoginRtpSection (a nested import), so a grep for
// "components/ContentBoxTwo.astro" in src/pages/ finds nothing — it is LIVE, not
// inventory, and has to carry the current brand's colours.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// WEPLAY168 (รอบม่วงนีออน-ทองอาร์เขต 2026-10-09, brand-spec §2):
// โลโก้รอบนี้เป็นเครื่องเกมพกพาทรงเกมบอยสีม่วง มีเอเลี่ยนพิกเซลสีทองอยู่บนจอ กับ
// ปุ่มและดีแพดสีทอง และมีคำว่า WEPLAY เป็นตัวอักษรสามมิติสีเงินอมม่วงคู่กับเลข 168
// สีทองสด วางอยู่บนแฉกสายฟ้าสีม่วง แบนเนอร์กับสไลด์เป็นฉากห้องเกมอาร์เขตนีออนโทน
// ม่วงเต็มไปด้วยเหรียญทอง แบรนด์จึงมีสองฮิวจริง — ม่วงไฟฟ้ากับทอง — ต่างจากคู่
// แดงแล็กเกอร์-ทองของ PIGPG รอบก่อน
// สองคอลัมน์ของกล่องนี้ถูกแยกด้วยคู่สีตรงๆ: ฝั่งซ้ายเป็นแผ่นทองทึบ ไล่เงินอมม่วง
// #efe6ff → ทองอุ่น #ffd23d → ทองแบรนด์ #fbe455 บนหมึกเข้ม #190633 (11:1 ขึ้นไป
// ทั้งไล่เฉด — §2 ห้ามพลิกแผ่นทองไปใช้หมึกสว่าง) ป้ายคอลัมน์เป็นทองอุ่น ส่วนฝั่งขวา
// เป็นแผ่นม่วงทึบ ไล่ม่วงกลาง #7a1fc4 → ม่วงลึก #5b1a75 ในกรอบม่วงแบรนด์ #a435f0
// บนไอคอนทองอุ่น ป้ายคอลัมน์เป็นม่วงอ่อน #d2a6ff ซึ่งใช้เป็นสีตัวอักษรบนพื้นมืดได้
// (7.4:1 บนผิวยก) ขณะที่ม่วงแบรนด์ใช้ไม่ได้ (3.1:1)
// หัวข้อ docx (เมื่อมีการส่ง title มา) ไล่เงินอมม่วง → ทองอุ่น → ทองแบรนด์ เส้นคั่น
// เป็นม่วงลึกทั้งสองฝั่ง สันหัวข้อไล่ทองอุ่น → ทองแบรนด์ → ม่วงลึก
// เนื้อความ #ece2ff (= BRAND_TEXT)
//
// ไอคอนเริ่มต้นเป็น 🔐 / 🎰 — รอบนี้เป็นเว็บเล่นสล็อตออโต้ ไม่ใช่เว็บพนันรวมช่องทาง
// แบบรอบก่อนและไม่ใช่เว็บหวย (LoginRtpSection ส่งไอคอนมาเองอยู่แล้ว ค่านี้คือกันหลง
// เท่านั้น)
//
// ชุดแดงแล็กเกอร์-ทองของ PIGPG ที่เคยค้างในไฟล์นี้ (#d4200d #a30303 #f5b61d #ffd87a
// #fdf9e4 #b07a06 #6b0402 #fdc4a3 #120302 #fdeedd rgba(245,182,29,…)) ชุดฟ้าสด-
// เหลืองมะนาวของ แตกดี168 (#0193fb #7bcffb #d4ecfd #064a86 #fce604 #dbeafe) และชุด
// ทองเมทัลลิกของ 789BETTING ก่อนหน้านั้น (#fad354 #ffe79a #8a6410 #060402 #f3e7cd)
// ออกครบทุกจุดแล้ว — ทองของรอบนี้เป็นคนละค่า อย่าปล่อยของเก่าไว้เพราะ "ดูคล้ายกัน"
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#5b1a75] pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffd23d] via-[#fbe455] to-[#5b1a75] shadow-[0_0_10px_rgba(251,228,85,0.6)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#efe6ff] via-[#ffd23d] to-[#fbe455] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece2ff]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#5b1a75] pb-3 text-xl leading-normal font-black tracking-widest text-[#ffd23d] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#c98a05] bg-gradient-to-br from-[#efe6ff] via-[#ffd23d] to-[#fbe455] text-sm text-[#190633] shadow-[0_5px_15px_rgba(251,228,85,0.4)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece2ff]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#5b1a75] pb-3 text-xl leading-normal font-black tracking-widest text-[#d2a6ff] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#a435f0]/60 bg-gradient-to-br from-[#7a1fc4] to-[#5b1a75] text-sm text-[#ffd23d] shadow-[0_5px_15px_rgba(0,0,0,0.6)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
