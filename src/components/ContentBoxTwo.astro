---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a game list),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// 365LOTTO (รอบแดง-ทอง-เงินโครเมียม 2026-09-24): โลโก้แบรนด์นี้เป็นเลข 365 สีทอง
// ต่อด้วยคำว่า LOTTO สีเงินโครเมียมที่มีวง O สองวงเป็นแดงสด สองครึ่งของกล่องจึงแยก
// กันด้วยคู่สีนั้นจริงๆ ป้ายไอคอนฝั่งซ้ายไล่จากทองสว่าง #fdf3b4 ลงทองหลัก #fadc64
// ไปหาทองลึก #e0b03a ตัวอักษรบนป้ายใช้สีพื้นเพจ #120406 ส่วนฝั่งขวาไล่จากเงิน
// โครเมียม #f3f6fa ลงแดงสด #e01f26 ไปจบที่แดงเข้ม #a40304 บนตัวอักษรทองสว่าง
// เส้นคั่นเป็นทองลึก #9c6a12 กับพื้นยก #2a0b0e เนื้อความ #f0ddc4 (BRAND_TEXT) —
// ทอง-เงินโครเมียมของ SAGAME66 (#e8b93f #ffe9a3 #96671a #2a1d0b #171006 #0d0903
// #e3d8c0 #eef3f8 #b6c1cd) ออกทั้งหมด
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#9c6a12]/45 pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdf3b4] via-[#fadc64] to-[#e01f26] shadow-[0_0_10px_rgba(250,220,100,0.5)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#fdf3b4] via-[#f3f6fa] to-[#e01f26] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0ddc4]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#9c6a12]/45 pb-3 text-xl leading-normal font-black tracking-widest text-[#fdf3b4] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#fadc64]/70 bg-gradient-to-br from-[#fdf3b4] via-[#fadc64] to-[#e0b03a] text-sm text-[#120406] shadow-[0_5px_15px_rgba(250,220,100,0.4)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0ddc4]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#2a0b0e] pb-3 text-xl leading-normal font-black tracking-widest text-[#f3f6fa] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#e01f26]/60 bg-gradient-to-br from-[#f3f6fa] via-[#e01f26] to-[#a40304] text-sm text-[#fdf3b4] shadow-[0_5px_15px_rgba(224,31,38,0.35)]">
              📋
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
