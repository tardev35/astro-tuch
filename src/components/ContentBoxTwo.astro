---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🔐", iconright = "🃏" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a channel panel),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
// LoginRtpSection renders it without a title, which is why the page's heading
// inventory stops at the docx's own sections.
//
// Reached ONLY through LoginRtpSection this round (index.astro does not import
// it directly — the docx's two-column section went to ContentBoxTwoPremium and
// its two-half one to ContentBoxSpecial).
// A grep for "components/ContentBoxTwo.astro" in src/pages/ therefore finds
// nothing, and that does NOT mean it is inventory: match the bare filename
// instead. It is LIVE and has to carry this brand's colours.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// KMD88 (รอบม่วงราชา-ทอง 2026-10-13, brand-spec §2):
// โลโก้เป็นคำว่า KMD ตัวอักษรสามมิติม่วงขัดเงาขอบทอง ต่อด้วยเลข 88 ทองเมทัลลิก ใน
// วงแหวนทองที่ขาดช่วง งานอาร์ตเป็นฉากคาสิโนดำที่ส่องด้วยริบบิ้นแสงม่วง — คู่นายแบบ-
// นางแบบผมขาวเงินในชุดดำขลิบม่วง/ทอง ไพ่เอซขอบทอง ชิปม่วงสลับทอง มงกุฎทอง ลูกเต๋าทอง
// และเหรียญทอง
// ⚠️ รอบนี้เป็น **สองฮิวจริง — ม่วงนำ ทองรอง** ไม่ใช่ฮิวเดียวล้วนแบบ TND168 รอบก่อน
// (ทองล้วน) และไม่ใช่ทองสองระดับแบบ TIGERWIN369 — ม่วงแบรนด์ #7505cc เป็นสีนำ ส่วน
// ทองแบรนด์ #e2b33f เป็นฮิวที่สองจริง ไม่ใช่เฉดอื่นของม่วงเดียวกัน
// กล่องนี้ไม่มีการ์ดครอบ มันวางสองคอลัมน์ลงบนพื้นเพจ **ดำสนิท #000000** ตรงๆ จึงเป็น
// จังหวะ "โปร่ง" ของหน้า คั่นหลังบล็อกเนื้อหาของบรีฟทั้งแปดส่วน
// ⚠️ พื้นเพจรอบนี้ดำสนิท จึงไม่มีชั้นไหนจมต่ำกว่าพื้นได้ — #0a0213 คือก้นสุดที่ใช้ได้
// และเป็นพื้นของช่องกรอกกับแถวรายการ
// สองคอลัมน์ถูกแยกด้วยคู่ "แผ่นมืดกรอบม่วง vs แผ่นทองทึบ" ซึ่งตรงกับคู่ฮิวของโลโก้:
// ฝั่งซ้ายเป็นฝั่งม่วง ป้ายไอคอนเป็นแผ่นมืดไล่ม่วงลึก #3a0565 → ผิวจม #0a0213 ในกรอบ
// ม่วงแบรนด์ บนไอคอนม่วงตัวอักษร #c07cff ป้ายคอลัมน์ซ้ายเป็นม่วงตัวอักษร #c07cff
// (5.3:1) ส่วนฝั่งขวาเป็นฝั่งทอง ป้ายไอคอนเป็นแผ่นทองไล่ทองสว่าง #ffdf8c → ทองแบรนด์
// #e2b33f บนหมึก #1a0526 (§2 ระบุว่านี่คือหมึกตัวเดียวที่วางบนพื้นถมทองหรือพื้นสว่าง
// ได้ ได้ 8.4:1 บน #e2b33f — ห้ามพลิกแผ่นทองไปใช้หมึกสว่าง) ป้ายคอลัมน์ขวาเป็นทอง
// แบรนด์ #e2b33f (8.1:1)
// — §2 ห้าม #7505cc #b453ff #3a0565 #2c0349 #7a5a0a ถือตัวอักษรที่ไหนเลย และ #ffd45e
// สงวนไว้ให้ <strong> ในย่อหน้าของหน้าแรกเท่านั้น จึงไม่โผล่ในไฟล์นี้
// หัวข้อ docx (เมื่อมีการส่ง title มา) ไล่ม่วงอ่อน #d9b8ff → ม่วงตัวอักษร #c07cff →
// ทองแบรนด์ #e2b33f เส้นคั่นเป็นม่วงลึกสุด #2c0349 ทั้งสองฝั่ง สันหัวข้อไล่ม่วงสว่าง
// #b453ff → ม่วงแบรนด์ #7505cc → ม่วงลึก #3a0565 เนื้อความงาช้างอมม่วง #ece2f8
// (= BRAND_TEXT) — 17.8:1 บนพื้นเพจ
//
// ไอคอนเริ่มต้นเป็น 🔐 / 🃏 — รอบนี้เป็น **คาสิโนรวมเกม** (บาคาร่า สล็อต บอลออนไลน์)
// ไม่ใช่เว็บสล็อตล้วน จึงไม่ใช้ 🎰 เป็นค่าตั้งต้น และไพ่มาจากบาคาร่าซึ่งบรีฟเรียกว่า
// เกมไพ่ตรงๆ (LoginRtpSection ส่งไอคอนมาเองอยู่แล้ว ค่านี้คือกันหลง)
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือทั้งสองฮิว** ทองมาแล้ว
// เก้าในสิบสองรอบ และม่วงก็เพิ่งมาสองรอบ: ชุดทองมังกรของ TND168 ที่เคยค้างอยู่ทั้ง
// ไฟล์นี้ (#dfa310 #ffc93d #ffe4a3 #c9b88e #f0e9dc #8a5c09 #43240b #140d02 #1b1307
// #120c04 #070502) ชุดชมพูฮอตพิงก์-ทองของ PUNPRO168 (#f41571 #ff5ca8 #fce343 #ffd94a
// #f0c3dc #fde7f2 #8a0a45 #4a0426 #2a0012 #4a1038 #3a0a2a #2e0022 #1c0014) ชุดทอง
// อำพันเสือของ TIGERWIN369 (#d98324 #f7b733 #ffd98a #f7e4c0 #e3cfae #8a5214 #4a2a08
// #1a0d02 #2d1c0a #1c1206 #0f0903) ชุดทองแชมเปี้ยน-เงินโครเมียมของ UFA324 (#e5a81b
// #b9c2cc #231c0e #17130a #f0e8d4 #ffe08a #7d5a07 #43300a #464f5a #8792a0 #bb8410)
// ชุดชมพูฮอต-ทองของ FAH999 (#ff3fa4 #f5c53d #2e002c) ชุดทองเป็ด-ส้มปากเป็ดของ
// DUCK1688 (#f3bb34 #fde464 #1a1203) ชุดทองอวกาศ-เงินโครเมียมของ NAZA168 (#fbc134
// #cfd6e3 #241700) และชุดทองสายฟ้า-แดงของ FLASH877 (#f5c518 #ffdd73 #ff3b14)
// ออกครบทุกจุดแล้ว
// ⚠️ "มีทองอยู่แล้ว" ไม่พิสูจน์อะไรเลย — #e5a81b (G=168) #dfa310 (G=163) #f5c53d
// (G=197) #fbc134 (G=193) #f3bb34 (G=187) ไม่มีตัวไหนเป็น #e2b33f (G=179)
// ⚠️ ม่วง false friend ที่ใกล้ที่สุด: #a435f0 / #d2a6ff / #c9b2e8 ของ WEPLAY168 และ
// #7e22ce / #c4b5fd / #ddd6fe ของ BPLAY639 — ไม่ใช่ #7505cc / #b453ff / #c07cff /
// #d9b8ff ของรอบนี้
// ⚠️ **รอบนี้ไม่มีชมพู ไม่มีเงิน/เทา ไม่มีเขียว ไม่มีน้ำเงิน ไม่มีส้มอำพัน และไม่มี
// แดงเลย** #b9c2cc #f2f5f9 #8792a0 #464f5a #cfd6e3 #eef2f8 #3f4859 ต้องไม่เหลืออยู่
// ในไฟล์นี้
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#2c0349] pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#b453ff] via-[#7505cc] to-[#3a0565] shadow-[0_0_10px_rgba(117,5,204,0.6)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#d9b8ff] via-[#c07cff] to-[#e2b33f] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece2f8]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#2c0349] pb-3 text-xl leading-normal font-black tracking-widest text-[#c07cff] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#7505cc]/70 bg-gradient-to-br from-[#3a0565] to-[#0a0213] text-sm text-[#c07cff] shadow-[0_5px_15px_rgba(0,0,0,0.7)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece2f8]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#2c0349] pb-3 text-xl leading-normal font-black tracking-widest text-[#e2b33f] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#7a5a0a] bg-gradient-to-br from-[#ffdf8c] to-[#e2b33f] text-sm text-[#1a0526] shadow-[0_5px_15px_rgba(226,179,63,0.4)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
