---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🔐", iconright = "🎴" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a game-list panel),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
// LoginRtpSection renders it without a title, which is why the page's heading
// inventory stops at the docx's own sections.
//
// Reached only through LoginRtpSection (a nested import), so a grep for
// "components/ContentBoxTwo.astro" in src/pages/ finds nothing — it is LIVE, not
// inventory, and has to carry the current brand's colours.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// 789BETTING (รอบทองเมทัลลิกบนดำสนิท 2026-10-08, brand-spec §2-§3):
// โลโก้รอบนี้เป็นเลข 789 ทองขัดเงาสามมิติ ทับคำว่า BETTING ตัวพิมพ์ใหญ่สีดำบนแถบขีดขาว
// ไม่มีสีที่สองเลย — ต่างจากคู่แดง/เขียวมรกตของ GUCCI168 รอบก่อน สองคอลัมน์ของกล่องนี้
// จึงถูกแยกด้วย "โลหะสว่าง vs โลหะลึก" ไม่ใช่ด้วยคู่สี: ฝั่งซ้ายเป็นแผ่นทองทึบ ไล่ทอง
// แชมเปญ #ffe79a → ทองกลาง #ddab33 → บรอนซ์ #c9881f บนหมึก #0a0802 (13.5:1 บนปลายสว่าง
// และ 10.3:1 บน #ddab33 — §2 ห้ามพลิกปุ่มทองไปใช้หมึกสว่าง) ป้ายคอลัมน์เป็นทองแชมเปญ
// ส่วนฝั่งขวาเป็นแผ่นดำลึก ไล่ผิวยก #17130a → ผิวลึกสุด #060402 ในกรอบเส้นไรผม #4a3407
// บนไอคอนทองแบรนด์ #fad354 ป้ายคอลัมน์เป็นทองแบรนด์ #fad354 ซึ่งใช้เป็นสีตัวอักษรบนพื้น
// มืดได้ (12.8:1 บนผิวยก)
// หัวข้อ docx (เมื่อมีการส่ง title มา) ไล่ทองแชมเปญ #ffe79a → ทองแบรนด์ #fad354 →
// ทองกลาง #ddab33 เส้นคั่นเป็นเส้นไรผม #4a3407 ทั้งสองฝั่ง สันหัวข้อไล่แชมเปญ → ทอง
// แบรนด์ → ทองลึก #8a6410 เนื้อความ #f3e7cd (= BRAND_TEXT)
//
// ไอคอนเริ่มต้นเป็น 🔐 / 🎴 — รอบนี้เป็นคาสิโนฐานเข้าหลักที่รวมบาคาร่า รูเล็ต บอล หวย
// สล็อต ไม่ใช่เว็บหวยเฉพาะทาง (LoginRtpSection ส่งไอคอนมาเองอยู่แล้ว ค่านี้คือกันหลง
// เท่านั้น)
//
// ชุดตรุษจีนแดง-เขียวมรกต-ทองของ GUCCI168 ที่เคยค้างในไฟล์นี้ (#c41115 #e0201f #7a0505
// #0b7a33 #2bbf63 #063f1c #ffdf91 #d9a521 #8c6410 #f6e3cf rgba(196,17,21,…)
// rgba(217,165,33,…) rgba(11,122,51,…)) ออกครบทุกจุดแล้ว
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#4a3407] pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe79a] via-[#fad354] to-[#8a6410] shadow-[0_0_10px_rgba(250,211,84,0.6)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#ffe79a] via-[#fad354] to-[#ddab33] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e7cd]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#4a3407] pb-3 text-xl leading-normal font-black tracking-widest text-[#ffe79a] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#8a6410] bg-gradient-to-br from-[#ffe79a] via-[#ddab33] to-[#c9881f] text-sm text-[#0a0802] shadow-[0_5px_15px_rgba(250,211,84,0.4)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e7cd]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#4a3407] pb-3 text-xl leading-normal font-black tracking-widest text-[#fad354] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#4a3407] bg-gradient-to-br from-[#17130a] to-[#060402] text-sm text-[#fad354] shadow-[0_5px_15px_rgba(0,0,0,0.6)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
