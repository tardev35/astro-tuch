---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a game list),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// WY88 (รอบชมพูมาเจนตา-ทอง 2026-09-23): โลโก้แบรนด์นี้เป็นตัวอักษร WY สีชมพู
// มาเจนตาคู่กับเลข 88 สีทอง สองครึ่งของกล่องจึงแยกกันด้วยคู่สีนั้นจริงๆ ป้ายไอคอน
// ฝั่งซ้ายไล่จากชมพูกุหลาบ #f9a8cd ลงมาเจนตาหลัก #ec2b84 ไปหามาเจนตาเข้ม
// #a3145a ตัวอักษรบนป้ายใช้สีพื้นเพจ #170411 ส่วนฝั่งขวาไล่จากทองประกาย #fced94
// ลงทองหลัก #e8b33a ไปหาทองเข้ม #c3832b เส้นคั่นเป็นมาเจนตาหลักกับมาเจนตาเข้ม —
// ชมพู-เหลืองของ ABM96 ออกหมด
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#ec2b84]/40 pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f9a8cd] via-[#ec2b84] to-[#a3145a] shadow-[0_0_10px_rgba(236,43,132,0.55)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#f9a8cd] via-[#ec2b84] to-[#e8b33a] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fce9f3]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#ec2b84]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#f9a8cd] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#ec2b84]/70 bg-gradient-to-br from-[#f9a8cd] via-[#ec2b84] to-[#a3145a] text-sm text-[#170411] shadow-[0_5px_15px_rgba(236,43,132,0.35)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fce9f3]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#a3145a] pb-3 text-xl leading-normal font-black tracking-widest text-[#e8b33a] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#e8b33a]/50 bg-gradient-to-br from-[#fced94] via-[#e8b33a] to-[#c3832b] text-sm text-[#170411] shadow-[0_5px_15px_rgba(232,179,58,0.22)]">
              🎴
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
