---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🔐", iconright = "🎰" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a recommended-game
// panel), never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
// LoginRtpSection renders it without a title, which is why the page's heading
// inventory stops at the docx's own sections.
//
// Reached only through LoginRtpSection (a nested import), so a grep for
// "components/ContentBoxTwo.astro" in src/pages/ finds nothing — it is LIVE, not
// inventory, and has to carry the current brand's colours.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// NAZA99 (รอบทอง-ดำ 2026-10-02): โลโก้เป็นตัวอักษรทองเมทัลลิกล้วนบนพื้นโปร่ง (#e4b34d นำ
// รองด้วย #fdf2ac) บนงานอาร์ตฉากทองอร่ามบนพื้นดำอมน้ำตาล #140c02 ที่มีเหรียญทอง ริ้วแสงทอง
// และหญิงสาวในชุดขาว-ทอง แบรนด์นี้ไม่มีสีคู่ตรงข้าม สองคอลัมน์ของกล่องนี้จึงถูกแยกด้วยระดับ
// ความสว่างของทอง — ฝั่งซ้ายเป็นทองสว่าง ป้ายไอคอนไล่จากแชมเปญ #fdf2ac ลงทองแบรนด์
// #e4b34d ไปหาทองเข้ม #c08f2b ซึ่งเป็นจุดที่มืดที่สุดที่ยังรองหมึกบนพื้นทอง #1a1000 ได้
// (7.0:1) ส่วนฝั่งขวาเป็นทองเข้ม ป้ายไอคอนไล่ทองแบรนด์ #e4b34d → ทองเข้ม #c08f2b →
// ทองลึก #8a5f12 และใช้แชมเปญ #fdf2ac เป็นตัวอักษร เพราะหมึกเข้มบนทองลึกตกเกณฑ์
// ข้อความป้ายฝั่งขวาใช้สีเนื้อความ #f3e8cf หัวข้อ docx (เมื่อมีการส่ง title มา) ไล่แชมเปญ →
// ทองแบรนด์ → ทองลึก เส้นคั่นเป็นทองลึก #8a5f12 ทั้งสองฝั่ง เนื้อความ #f3e8cf (BRAND_TEXT)
// — ชุดแดงสด-ทองของ หวย365 (#dc0203 #f5282a #9c0201 #ffc93c #ffeab0 #c08a07 #240406
// #180303 #f6e7e0) และของ หวยเฮง789 (#dc2224 #f4bc5d #ffefc2 #fbe3d4 #1c0606 #2b0909)
// ออกครบทุกจุด
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#8a5f12] pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdf2ac] via-[#e4b34d] to-[#8a5f12] shadow-[0_0_10px_rgba(228,179,77,0.5)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#fdf2ac] via-[#e4b34d] to-[#8a5f12] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e8cf]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#8a5f12] pb-3 text-xl leading-normal font-black tracking-widest text-[#e4b34d] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#e4b34d]/70 bg-gradient-to-br from-[#fdf2ac] via-[#e4b34d] to-[#c08f2b] text-sm text-[#1a1000] shadow-[0_5px_15px_rgba(228,179,77,0.40)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e8cf]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#8a5f12] pb-3 text-xl leading-normal font-black tracking-widest text-[#f3e8cf] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#c08f2b]/70 bg-gradient-to-br from-[#e4b34d] via-[#c08f2b] to-[#8a5f12] text-sm text-[#fdf2ac] shadow-[0_5px_15px_rgba(192,143,43,0.35)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
