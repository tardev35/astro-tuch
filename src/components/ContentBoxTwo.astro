---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a game-category
// list), never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// UWIN33 (รอบทอง-โครเมียม-ดำ 2026-09-24): โลโก้แบรนด์นี้เขียนตัว U เป็นทองนูนบนดำ
// คำว่า WIN เป็นเงินโครเมียม แล้ว 33 กลับมาเป็นทอง สองครึ่งของกล่องจึงแยกกันด้วยคู่
// สีนั้นจริงๆ ป้ายไอคอนฝั่งซ้ายไล่จากทองสว่าง #fbd564 ลงทองแบรนด์ #e0b429 ไปหาทอง
// ลึก #7a5407 ตัวอักษรบนป้ายใช้สีพื้นเพจ #080602 ตามกฎคอนทราสต์ที่ว่าตัวอักษรบนพื้น
// ทองต้องเกือบดำ ไม่ใช่ขาว ส่วนฝั่งขวาไล่จากเงินโครเมียม #dfe4ec ลงเงินหม่น #a6adb9
// ไปจบที่ทองลึก เส้นคั่นเป็นทองลึกกับผิวการ์ดยก #26200e เนื้อความ #ece6d8
// (BRAND_TEXT) — ชุดแดง-ดำ-เงินโครเมียมของ MAHAGAME66 (#de161d #ff4d52 #7a0a0e
// #e2e8ef #9ba3ad #16090a #26100f #080506 #e8e3e1) ออกทั้งหมด
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#7a5407]/55 pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#dfe4ec] via-[#fbd564] to-[#e0b429] shadow-[0_0_10px_rgba(224,180,41,0.5)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#dfe4ec] via-[#fbd564] to-[#e0b429] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece6d8]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#7a5407]/55 pb-3 text-xl leading-normal font-black tracking-widest text-[#fbd564] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#e0b429]/70 bg-gradient-to-br from-[#fbd564] via-[#e0b429] to-[#7a5407] text-sm text-[#080602] shadow-[0_5px_15px_rgba(224,180,41,0.45)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece6d8]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#26200e] pb-3 text-xl leading-normal font-black tracking-widest text-[#dfe4ec] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#dfe4ec]/50 bg-gradient-to-br from-[#dfe4ec] via-[#a6adb9] to-[#7a5407] text-sm text-[#080602] shadow-[0_5px_15px_rgba(223,228,236,0.28)]">
              🎮
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
