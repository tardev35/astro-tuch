---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🏧", iconright = "🪪" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a channel panel),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
//
// รอบนี้ index.astro **import ไฟล์นี้ตรงๆ** และส่ง **docx H2 §2** มาให้ (content.txt
// บรรทัด 6 แบ่งครึ่งต่อคอลัมน์) ตาม brand-spec §3 — รอบก่อน (นาซ่า168) ตระกูลนี้ใช้
// ContentBoxTwoPremium กับ ContentBoxTwoCyberCut ส่วนรอบนี้มาที่ตัวฐาน
// ⚠️ LoginRtpSection ไม่ถูก render ที่ไหนเลยรอบนี้ (ตาราง RTP ของมันจะพาเลข RTP
// ขึ้นหน้า ซึ่งบรีฟรอบนี้ไม่มีคำว่า RTP เลยสักครั้ง) ไฟล์นี้จึงเป็น **กล่องเนื้อหา
// ของหน้าแรกโดยตรง** ไม่ใช่ chrome
// ⚠️ เช็ก "ไฟล์นี้ถูกใช้ไหม" ต้อง match **ชื่อไฟล์เปล่า** ไม่ใช่ path "components/…"
// เพราะ component ที่ถูกเรียกจาก component อื่นจะหลุดจาก grep แบบ path
//
// รอบนี้หน้าแรก **ไม่ส่ง titleleft/titleright** มาด้วย — บรีฟให้ §2 เป็นย่อหน้าเดียว
// ที่ไม่มีหัวข้อย่อย การตั้งป้ายคอลัมน์เองจะเป็นคำของเพจ ไม่ใช่ของบรีฟ (ไอคอนสองตัว
// จึงไม่ถูก render รอบนี้ — มันอยู่ในป้ายคอลัมน์) ค่าเริ่มต้นของไอคอนเปลี่ยนเป็น
// 🏧 / 🪪 ให้ตรงหัวข้อ §2 ของบรีฟ คือ **ระบบฝากถอนกับการยืนยันตัวตน**
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// ───────────────────────────────────────────────────────────────────────────
// มาดาม168 (ดรอป 2026-10-23) — พาเลตตาม .claude/brand-spec-madum168.md §2
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **ฟ้าไซยาน-ครีมบนธีมสว่างของ ร่ำรวย168** ทั้งใบ
// จึงรีเธมทั้งไฟล์: รอบนี้เป็น **ธีมมืด** พื้นเพจ **#00091f** (bg.json) =
// น้ำเงินเที่ยงคืนเกือบดำ **ไม่ใช่ฟ้าเพอริวิงเคิลอ่อน** ห้ามแก้กลับไปเป็นพื้นสว่าง
// ⚠️⚠️ <section> ใบนี้ **ไม่มีการ์ดครอบ** (เป็นใบเดียวของหน้าแรกที่เป็นแบบนั้น)
// ตัวอักษรทุกตัวจึงนั่งบน **พื้นเพจ #00091f** โดยตรง — ค่าคอนทราสต์ที่ใช้จึงต้องวัด
// กับพื้นเพจ ไม่ใช่กับผิวการ์ด: หัวข้อ #ff2e52 = **5.4:1** · เนื้อความ #f4eef1 =
// **17.3:1** · และนี่คือเหตุผลที่ไฮไลต์ <strong> ของหน้าเพจ (#ff2e52) อ่านออก
// สบายในย่อหน้าของใบนี้ด้วย
//
// จังหวะรูปทรงของใบนี้: **แท่งตั้งสี่เหลี่ยมมนข้างหัวข้อ + เส้นคาดใต้ header
// โดยไม่มีการ์ดครอบ** ซึ่งไม่ซ้ำกับใบไหนบนหน้าเดียวกัน (§1 แผ่นถมแดงหมึกขาว ·
// §3 เส้นคาดเหนือหัวข้อที่จัดกึ่งกลาง · §4 แท่งตั้งสามสต็อปบนการ์ดมุมกลม ·
// §5 ชิปถมอะซัวร์คู่กลีฟบนการ์ดมุมตัด 36px · §6 สันซ้ายสี่พิกเซลบนการ์ดมุมตัด
// 40px · §7 เส้นคู่คร่อมบน-ล่าง · §8 หัวข้อไล่เฉด bg-clip-text จัดกึ่งกลาง)
// แท่งตั้งไล่ **แดงคริมสัน #ff2e52 → แดงลึก #c9102f → อะซัวร์ #1177e8** (พื้นถมล้วน
// ไม่มีตัวอักษรวางทับ) หัวข้อเป็น **แดงคริมสัน #ff2e52 ทึบสีเดียว ไม่ไล่เฉด** —
// ⚠️ ไม่ใช้ bg-clip-text ที่นี่โดยตั้งใจ เพราะ §2 ห้าม #1177e8 (ต่ำกว่า AA) และ
// #c9102f เป็นพิกเซลของตัวอักษร
// ป้ายคอลัมน์ (ถ้าแบรนด์ถัดไปส่งมา) เป็นขั้วกลับของกัน: ซ้าย #ff2e52 พร้อม
// **ชิปถมแดง** ไล่ #e01238 → #c9102f หมึก **ขาว** (สูตรปุ่มหลักของ §2 —
// ⚠️ **ห้ามลากไล่เฉดขึ้นไปถึง #ff2e52 แล้ววางหมึกขาว** เพราะได้แค่ 3.6:1)
// ขวา #d9dfe9 พร้อม **ชิปถมอะซัวร์** ไล่ #0e68cc → #0a4ea8 หมึก **ขาว**
// (5.5:1 และ 7.8:1 — สูตรปุ่มรองของ §2) เนื้อความ #f4eef1 (= BRAND_TEXT)
// เส้น/ขอบทุกเส้นเป็น #2a3c70 ซึ่ง §2 ระบุว่า **ห้ามถือตัวอักษร**
//
// ⚠️ **เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี"** — ฟ้า/ไซยานนำมาแล้วเจ็ดแบรนด์ในรีโปนี้
// อะซัวร์รอบนี้คือ **#1177e8 / #0e68cc / #0a4ea8** และ **ไม่ถือตัวอักษรเลย**
// ค่าที่ต้องไม่เหลือในไฟล์นี้:
//   **นาซ่า168 (แบรนด์ขาออก — เสี่ยงที่สุด)** — 1fd8f0 0bb6d4 8fd9ec 1d4fd8 143aa0
//     e6edf8 9fb2cb 273449 1b2434 121722 33455f 0d1017
//   **ร่ำรวย168 (ชุดที่เพิ่งอยู่ทั้งใบนี้)** — 18a5e2 0d6b9b 0a5176 a9d7f2 16294a
//     dbe6ff eef4ff dce9fb 111a3f 202a66 31408a e9f1ff adc0e4 f4e4d3 e4cbb3
//     กับ rgba 24/165/226, rgba 13/107/155, rgba 244/228/211, rgba 22/41/74
//   **ufalion168 (เจ้าของธีมก่อนหน้านั้นของไฟล์นี้)** — d4922c fdfc71 f6e3b4 a25b24
//     5a3310 33200a 1f1304 0a0601 1a1000 fbf6e3
//   **สบาย168** — 2cc3fc 6bdcfb 0a7fbd 063a57 04293d 0a4f74 9ae0fa cdf2ff ccf7ff
//     f2fbff dff4fd eafaff a9e3f9 0f3a4a 06293c
//   **รวยแทร่168** — 039cfa 0494f5 c3ebfc 04366b e3f2fc 0b2d52 f9a826 704504
//   **นินจา168** — 32bcfb a9e9ff fef54b 6b5c10 07335f 0c2a3d 071a28
//   **สบายเบท168** — 2f9ff5 a8dcff d6ecff 0b3f78 e8f4ff ffc82e 5c4a16
//   **TSDET911** — 0360f3 0292fb 6ec8ff 4fb4ff cfdcec 9db4d4 dde8f7 00081f 102a5e
//     0a1c42 032dad 04186e
//   **พักยก168** — eeae12 fded41 9f600d e0e0df c0c0bf a1a09e f4ead6 291d0f
// ⚠️⚠️ **แดงนำรอบนี้ จึงต้องเทียบแดงของแบรนด์เก่าทีละค่า** — ไม่ใช่ b3121b f2bba5
// c98a74 (ขวัญใจ168) c30303 8f0505 e81313 4a0f0f ffdbdb fff1ef (รวยแท้168) fb141b
// ff5f63 ffa0a2 db040b 8a0609 (GT66B) eb0305 e40303 c20305 9b0a0c ff4446 (โปรดี168)
// fa0513 ff5a5f ffadaf (สมหวัง168) d9212a 8e1a16 (ดวงเศรษฐี168) fb1b32 ff8f9c
// 5c0410 (มีเฮ168) e4021b (รวยเทพ168) d30304 a00203 ff6b6e (รับตัง168) dc0203
// f5282a (หวย365) dd1b74 a4186b 4a0d35 2d0720 (มีทรัพย์168) fa63b9 ffb3de
// (ถอนชัวร์168) f5469f ff8dc6 8c0f52 (มีโชค168) ff3b14 6d0804 2b0000 (FLASH877)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบ **ไม่มี #** โดยตั้งใจ เพื่อไม่ให้ sweep ที่ไล่หา
// สีของแบรนด์เก่าใน src/ สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
// ⚠️ **รอบนี้ไม่มีทอง/เหลืองเป็นสี UI เลยสักเฉด ไม่มีส้ม ไม่มีเขียว ไม่มีม่วง
// ไม่มีชมพู/ฟูเชีย ไม่มีโรสโกลด์ ไม่มีบรอนซ์ ไม่มีครีม/เบจ และไม่มีแรมป์เทาเงิน**
// rgba() ที่อนุญาตรอบนี้: rgba(255,46,82,α) · rgba(224,18,56,α) · rgba(201,16,47,α) ·
// rgba(17,119,232,α) · rgba(14,104,204,α) · rgba(10,78,168,α) · rgba(217,223,233,α) ·
// rgba(0,9,31,α) · rgba(0,0,0,α)
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#2a3c70] pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ff2e52] via-[#c9102f] to-[#1177e8] shadow-[0_0_10px_rgba(255,46,82,0.55)]" />
        <HeadingTag class={`${headingSize} leading-normal font-black tracking-wide text-[#ff2e52]`}>{title}</HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f4eef1]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#2a3c70] pb-3 text-xl leading-normal font-black tracking-wide text-[#ff2e52]">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#c9102f] bg-gradient-to-br from-[#e01238] to-[#c9102f] text-sm text-white shadow-[0_5px_15px_rgba(201,16,47,0.45)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f4eef1]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#2a3c70] pb-3 text-xl leading-normal font-black tracking-wide text-[#d9dfe9]">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#0a4ea8] bg-gradient-to-br from-[#0e68cc] to-[#0a4ea8] text-sm text-white shadow-[0_5px_15px_rgba(17,119,232,0.45)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
