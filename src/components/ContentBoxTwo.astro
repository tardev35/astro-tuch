---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a service list),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// NEXT55 palette: the left column badge is the logo's crimson (the interlocking
// arrows that replace the X), the right column badge is brushed silver (the
// graphite wordmark) — so the two halves are told apart by hue and not only by
// position. No gold and no blue anywhere.
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#cd1437]/40 pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffb3bf] via-[#f0435f] to-[#7a0a20] shadow-[0_0_10px_rgba(205,20,55,0.55)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#ffb3bf] via-[#f0435f] to-[#e7eaef] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d5dae2]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#cd1437]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#ffb3bf] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#cd1437]/70 bg-gradient-to-br from-[#ffb3bf] via-[#f0435f] to-[#7a0a20] text-sm text-[#0c0d10] shadow-[0_5px_15px_rgba(205,20,55,0.35)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d5dae2]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#3a3d45] pb-3 text-xl leading-normal font-black tracking-widest text-[#e7eaef] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#8d939e]/60 bg-gradient-to-br from-[#e7eaef] via-[#c3c8d1] to-[#8d939e] text-sm text-[#0c0d10] shadow-[0_5px_15px_rgba(231,234,239,0.28)]">
              📋
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
