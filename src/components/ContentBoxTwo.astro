---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a game-category
// list), never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
// LoginRtpSection renders it without a title this round, which is why the page's
// heading inventory stops at the eight docx sections.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// MIRACLE55 (รอบทอง-โครเมียม-ดำ 2026-09-25): โลโก้เขียน MI เป็นทอง RACLE เป็นโครเมียม
// ขัดเงา แล้วปิดท้ายด้วย 55 ทองอีกครั้ง สองคอลัมน์ของกล่องนี้จึงถูกแยกด้วยคู่โลหะนั้นตรงๆ
// — ฝั่งซ้ายเป็นทองล้วน ป้ายไอคอนไล่จากทองสว่าง #fee47b ลงทองแบรนด์ #fcda65 ไปหาทองลึก
// #8c5f14 ตัวอักษรบนป้ายใช้ #0d0a06 ตามกฎคอนทราสต์ที่ว่าตัวอักษรบนพื้นทองต้องเกือบดำ
// ไม่ใช่ขาว ส่วนฝั่งขวาเป็นโครเมียมล้วน ไล่จากขาวโครเมียม #fcfcfc ลงเงิน #d2d3d4 ไปจบที่
// เงินหม่น #a8acb1 หัวข้อ docx (เมื่อมีการส่ง title มา) ไล่ทอง-ขาว-ทองตามลำดับบนโลโก้
// เส้นคั่นเป็นทองลึกฝั่งซ้ายกับผิวการ์ดยก #2c241c ฝั่งขวา เนื้อความ #e8e6e1 (BRAND_TEXT)
// — ชุดทอง-ครีมอุ่นของ KINGDOM66 (#e6bf4e #f2d683 #5c4113 #efe6cf #b5a888 #241c13
// #1a1206 #ebe3d3) ออกทั้งหมด แบรนด์นี้ไม่มีครีมอุ่นอยู่เลย มีแต่เงินเย็น
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#8c5f14]/70 pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fee47b] via-[#fcfcfc] to-[#d9a62b] shadow-[0_0_10px_rgba(252,218,101,0.5)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#fee47b] via-[#fcfcfc] to-[#fcda65] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e8e6e1]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#8c5f14]/70 pb-3 text-xl leading-normal font-black tracking-widest text-[#fcda65] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#fcda65]/70 bg-gradient-to-br from-[#fee47b] via-[#fcda65] to-[#8c5f14] text-sm text-[#0d0a06] shadow-[0_5px_15px_rgba(252,218,101,0.4)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e8e6e1]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#2c241c] pb-3 text-xl leading-normal font-black tracking-widest text-[#d2d3d4] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#d2d3d4]/55 bg-gradient-to-br from-[#fcfcfc] via-[#d2d3d4] to-[#a8acb1] text-sm text-[#0d0a06] shadow-[0_5px_15px_rgba(210,211,212,0.28)]">
              🎮
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
