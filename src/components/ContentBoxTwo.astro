---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a service list),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#4a2409]/80 pb-4">
        <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffb266] to-[#8c3a01] shadow-[0_0_10px_rgba(242,106,2,0.55)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#e3e7ec] via-[#ffb266] to-[#f26a02] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ded4cb]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#f26a02]/55 pb-3 text-xl leading-normal font-black tracking-widest text-[#ffc48a] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#f26a02]/60 bg-gradient-to-br from-[#ffb266] via-[#f26a02] to-[#8c3a01] text-sm text-[#070403] shadow-[0_5px_15px_rgba(242,106,2,0.34)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ded4cb]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#9ba3ad]/45 pb-3 text-xl leading-normal font-black tracking-widest text-[#e3e7ec] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#9ba3ad]/60 bg-gradient-to-br from-[#e3e7ec] via-[#9ba3ad] to-[#4a2409] text-sm text-[#070403] shadow-[0_5px_15px_rgba(227,231,236,0.28)]">
              📊
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
