---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🔐", iconright = "🎟️" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a lottery-listing
// panel), never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
// LoginRtpSection renders it without a title, which is why the page's heading
// inventory stops at the docx's own sections.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// หวยเฮง789 (รอบแดงนำ-ทองรอง 2026-10-01): เวิร์ดมาร์กเป็นสองโทน คำว่า "หวย" เป็นแดง
// เลือดนกเงาวาวขอบทอง ส่วน "เฮง789" เป็นทองไล่เฉดวาว บนงานอาร์ตฉากผ้าซาตินแดงที่มีลาย
// ไทยและเงาปราสาทสีทอง เหรียญทองกองสูง ลูกหวยแดง-ขาว และหญิงสาวในชุดไทยขาว-ทอง
// สองคอลัมน์ของกล่องนี้จึงถูกแยกด้วยคู่ทอง/แดงนั้นตรงๆ — ฝั่งซ้ายเป็นทองเต็มใบ ป้ายไอคอน
// ไล่จากทองอ่อน #ffefc2 ลงทองรอง #f4bc5d ไปหาทองลึก #d99a10 ซึ่งเป็นจุดที่มืดที่สุด
// ที่ยังรองหมึกเข้ม #1c0606 ได้ (7.0:1) ส่วนฝั่งขวาเป็นแดงเต็มใบ ป้ายไอคอนไล่แดงสว่าง
// #e43434 → แดงแบรนด์ #dc2224 → แดงลึก #ab0204 และใช้ตัวอักษร "ขาว" ไม่ใช่หมึกเข้ม
// เพราะหมึกเข้มบนแดงแบรนด์วัดได้แค่ 3.4:1 ส่วนทองอ่อนบนแดงยิ่งแย่กว่า (4.3:1 ต่อ 4.9:1)
// ข้อความป้ายฝั่งขวาใช้สีเนื้อความ #fbe3d4 หัวข้อ docx (เมื่อมีการส่ง title มา) ไล่ทองอ่อน
// → ทองรอง → แดงแบรนด์ เส้นคั่นเป็นแดงเข้มสุด #5c0a0a ทั้งสองฝั่ง เนื้อความ #fbe3d4
// (BRAND_TEXT)
//
// ชุดแดง-ทองของ หวยเฮง24 ที่เคยค้างในไฟล์นี้ — ซึ่ง "นำด้วยทอง" สลับกับรอบนี้ —
// (#e0a52a #fdea83 #fbdc64 #bd7c13 #8b0302 #c01616 #5a0202 #720202 #2a0606 #f6e6cf)
// ออกครบทุกจุดแล้ว
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#5c0a0a] pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffefc2] via-[#f4bc5d] to-[#dc2224] shadow-[0_0_10px_rgba(244,188,93,0.5)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#ffefc2] via-[#f4bc5d] to-[#dc2224] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fbe3d4]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#5c0a0a] pb-3 text-xl leading-normal font-black tracking-widest text-[#f4bc5d] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#f4bc5d]/70 bg-gradient-to-br from-[#ffefc2] via-[#f4bc5d] to-[#d99a10] text-sm text-[#1c0606] shadow-[0_5px_15px_rgba(244,188,93,0.40)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fbe3d4]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#5c0a0a] pb-3 text-xl leading-normal font-black tracking-widest text-[#fbe3d4] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#e43434]/70 bg-gradient-to-br from-[#e43434] via-[#dc2224] to-[#ab0204] text-sm text-white shadow-[0_5px_15px_rgba(220,34,36,0.35)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
