---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a game-category
// list), never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// MAHAGAME66 (รอบแดง-ดำ-เงินโครเมียม 2026-09-24): โลโก้แบรนด์นี้เขียนว่า MAHA เป็น
// เงินโครเมียมบนดำ GAME เป็นแดงสด แล้ว 66 กลับมาเป็นเงิน สองครึ่งของกล่องจึงแยกกัน
// ด้วยคู่สีนั้นจริงๆ ป้ายไอคอนฝั่งซ้ายไล่จากแดงสว่าง #ff4d52 ลงแดงแบรนด์ #de161d
// ไปหาแดงลึก #7a0a0e ตัวอักษรบนป้ายใช้สีพื้นเพจ #080506 ส่วนฝั่งขวาไล่จากเงิน
// โครเมียม #e2e8ef ลงเงินหม่น #9ba3ad ไปจบที่แดงลึก #7a0a0e เส้นคั่นเป็นแดงลึกกับ
// ผิวการ์ดยก #26100f เนื้อความ #e8e3e1 (BRAND_TEXT) — ชุดทอง-เขียว-แดงของ
// 888PARUAY (#fff6ae #fcdc2b #a87d0c #1fae1c #cf1111 #8a0303 #143a1c #07130a
// #e8e4c6 #fffdf0) ออกทั้งหมด
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#7a0a0e]/55 pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e2e8ef] via-[#ff4d52] to-[#de161d] shadow-[0_0_10px_rgba(222,22,29,0.5)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#e2e8ef] via-[#ff4d52] to-[#de161d] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e8e3e1]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#7a0a0e]/55 pb-3 text-xl leading-normal font-black tracking-widest text-[#ff4d52] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#de161d]/70 bg-gradient-to-br from-[#ff4d52] via-[#de161d] to-[#7a0a0e] text-sm text-[#080506] shadow-[0_5px_15px_rgba(222,22,29,0.45)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e8e3e1]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#26100f] pb-3 text-xl leading-normal font-black tracking-widest text-[#e2e8ef] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#e2e8ef]/50 bg-gradient-to-br from-[#e2e8ef] via-[#9ba3ad] to-[#7a0a0e] text-sm text-[#080506] shadow-[0_5px_15px_rgba(226,232,239,0.28)]">
              🎮
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
