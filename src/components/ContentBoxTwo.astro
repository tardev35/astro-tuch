---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🔐", iconright = "🎰" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a channel panel),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
// LoginRtpSection renders it without a title, which is why the page's heading
// inventory stops at the docx's own sections.
//
// Reached ONLY through LoginRtpSection this round (index.astro does not import
// it directly — the docx's two-column sections went to ContentBoxTwoPremium and
// ContentBoxSpecial, and its three-column one to ContentBox3Three).
// A grep for "components/ContentBoxTwo.astro" in src/pages/ therefore finds
// nothing, and that does NOT mean it is inventory: match the bare filename
// instead. It is LIVE and has to carry this brand's colours.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// PUNPRO168 (รอบชมพูฮอตพิงก์-ทอง บนพลัมเข้มอมม่วง 2026-10-12, brand-spec §2):
// โลโก้เป็นเครื่องเกมพกพาสีชมพูหน้ายิ้มขยิบตา ใต้ลงมาเป็นคำว่า PUNPRO ตัวหนาสามมิติ
// ชมพูบานเย็นขอบทอง คู่กับเลข 168 ตัวหนาสามมิติสีทองวาว งานอาร์ตเป็นฉากการ์ตูนสดใส
// สาวผมบ๊อบชมพู เป็ด/แมว/กระต่ายสวมมงกุฎทอง เหรียญทองลอย หัวใจชมพู ตู้สล็อต 777
// ⚠️ รอบนี้เป็น **คู่สองฮิวจริง** — ชมพูบานเย็น #f41571 นำ และทองสว่าง #fce343 เป็น
// ฮิวที่สอง ต่างจากรอบก่อน (TIGERWIN369) ที่เป็นทองล้วนสองระดับไม่มีฮิวที่สองเลย
// กล่องนี้ไม่มีการ์ดครอบ มันวางสองคอลัมน์ลงบนพื้นเพจ **พลัมเข้มอมม่วง #2e0022** ตรงๆ
// จึงเป็นจังหวะ "โปร่ง" ของหน้า คั่นหลังบล็อกเนื้อหาของบรีฟทั้งแปดส่วน
// ⚠️ พื้นเพจรอบนี้ไม่ใช่ดำสนิท จึงมีชั้นที่จมต่ำกว่าพื้นได้จริง — #1c0014 คือชั้นนั้น
// และเป็นพื้นของช่องกรอกกับแถวรายการ
// สองคอลัมน์ถูกแยกด้วยคู่ "แผ่นชมพูทึบ vs แผ่นมืดกรอบทอง": ฝั่งซ้ายเป็นแผ่นชมพูไล่
// ชมพูสว่าง #ff5ca8 → ชมพูบานเย็น #f41571 บนหมึก #2a0012 (§2 ระบุว่านี่คือหมึกตัวเดียว
// ที่วางบนพื้นถมชมพูหรือถมทองได้ ได้ 4.7:1 บน #f41571 ซึ่งเป็นไอคอนขนาดใหญ่ — ห้าม
// พลิกแผ่นชมพูไปใช้หมึกสว่าง และห้ามไล่ลงไปถึง #8a0a45 ใต้ตัวอักษร) ป้ายคอลัมน์ซ้าย
// เป็นชมพูบานเย็น ส่วนฝั่งขวาเป็นแผ่นมืดทึบ ไล่ชมพูลึกสุด #4a0426 → ผิวจม #1c0014
// ในกรอบทองสว่างบนไอคอนทองสว่าง #fce343 ป้ายคอลัมน์ขวาเป็นทองสว่าง #fce343 (12.1:1)
// — §2 ห้าม #8a0a45 / #4a0426 ถือตัวอักษรที่ไหนเลย และ #ffd94a สงวนไว้ให้ <strong>
// ในย่อหน้าเท่านั้น จึงไม่โผล่ในไฟล์นี้
// หัวข้อ docx (เมื่อมีการส่ง title มา) ไล่ครีมหม่น #f0c3dc → ชมพูสว่าง #ff5ca8 →
// ชมพูบานเย็น #f41571 เส้นคั่นเป็นชมพูลึกสุด #4a0426 ทั้งสองฝั่ง สันหัวข้อไล่ชมพู
// สว่าง → ชมพูบานเย็น → ชมพูลึกสุด เนื้อความ #fde7f2 (= BRAND_TEXT) — 15.7:1 บนพื้นเพจ
//
// ไอคอนเริ่มต้นเป็น 🔐 / 🎰 — รอบนี้เป็น **เว็บเล่นสล็อตออนไลน์ล้วน** (สล็อตปันโปร
// ในตำนาน) ไม่ใช่คาสิโนรวม ไม่ใช่เว็บกีฬา และไม่ใช่เว็บหวย 🐯 ของรอบ TIGERWIN369
// ถูกถอดออกเพราะดรอปนี้ไม่มีเสือเลยสักไฟล์ และตู้สล็อต 777 มาจากอาร์ตเวิร์กโดยตรง
// (LoginRtpSection ส่งไอคอนมาเองอยู่แล้ว ค่านี้คือกันหลง)
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — แปดในสิบรอบหลังสุดมีทอง และ FAH999 กับ
// PIGPG เป็นแบรนด์ชมพูมาก่อน: ชุดทองอำพันเสือของ TIGERWIN369 ที่เคยค้างอยู่ทั้งไฟล์นี้
// (#d98324 #f7b733 #ffd98a #f7e4c0 #e3cfae #8a5214 #4a2a08 #1a0d02 #2d1c0a #1c1206
// #0f0903) ชุดทองแชมเปี้ยน-เงินโครเมียมของ UFA324 (#e5a81b #b9c2cc #231c0e #17130a
// #0d0b06 #f0e8d4 #ffe08a #7d5a07 #43300a #464f5a #140d01 #f2f5f9 #8792a0 #bb8410)
// ชุดชมพูฮอต-ทองของ FAH999 (#ff3fa4 #ff6cbb #ffd1ea #fde8f3 #f5c53d #7a0046 #4a0b42
// #3a0534 #2e002c) ชุดทองเป็ด-ส้มอำพันของ DUCK1688 (#f3bb34 #fde464 #1a1203) ชุดทอง
// อวกาศ-เงินโครเมียมของ NAZA168 (#fbc134 #cfd6e3 #241700) และชุดทอง-แดงของ FLASH877
// (#f5c518 #ffdd73 #d21622) ออกครบทุกจุดแล้ว
// ⚠️ "มีชมพูอยู่แล้ว" และ "มีทองอยู่แล้ว" ไม่พิสูจน์อะไรเลย — #ff3fa4 (R=255 G=63)
// ไม่ใช่ #f41571 (R=244 G=21) และ #f5c53d #fbc134 #f3bb34 #e5a81b ไม่ใช่ #fce343
// ⚠️ **รอบนี้ไม่มีเงิน/เทา ไม่มีเขียว ไม่มีน้ำเงิน ไม่มีส้มอิฐ** #b9c2cc #f2f5f9
// #8792a0 #464f5a #cfd6e3 #eef2f8 #3f4859 ต้องไม่เหลืออยู่ในไฟล์นี้
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#4a0426] pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ff5ca8] via-[#f41571] to-[#4a0426] shadow-[0_0_10px_rgba(244,21,113,0.6)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#f0c3dc] via-[#ff5ca8] to-[#f41571] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fde7f2]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#4a0426] pb-3 text-xl leading-normal font-black tracking-widest text-[#f41571] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#8a0a45] bg-gradient-to-br from-[#ff5ca8] to-[#f41571] text-sm text-[#2a0012] shadow-[0_5px_15px_rgba(244,21,113,0.4)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fde7f2]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#4a0426] pb-3 text-xl leading-normal font-black tracking-widest text-[#fce343] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#fce343]/60 bg-gradient-to-br from-[#4a0426] to-[#1c0014] text-sm text-[#fce343] shadow-[0_5px_15px_rgba(0,0,0,0.7)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
