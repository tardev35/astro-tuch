---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "💬", iconright = "🧾" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a channel panel),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
//
// รอบนี้ index.astro **import ไฟล์นี้ตรงๆ** และส่ง **docx H2 §7** มาให้ (content.txt
// บรรทัด 22 แบ่งครึ่งต่อคอลัมน์) ตาม brand-spec §3 — รอบก่อนตระกูลนี้ใช้
// ContentBoxTwoCyberCut ส่วน LoginRtpSection ไม่ถูก render ที่ไหนเลยรอบนี้ (ตาราง
// RTP ของมันจะพาเลข RTP ขึ้นหน้า ซึ่ง §5 ห้าม) ไฟล์นี้จึงเป็น **กล่องเนื้อหาของ
// หน้าแรกโดยตรง** ไม่ใช่ chrome
// ⚠️ เช็ก "ไฟล์นี้ถูกใช้ไหม" ต้อง match **ชื่อไฟล์เปล่า** ไม่ใช่ path "components/…"
// เพราะ component ที่ถูกเรียกจาก component อื่นจะหลุดจาก grep แบบ path
//
// รอบนี้หน้าแรก **ไม่ส่ง titleleft/titleright** มาด้วย — บรีฟให้ §7 เป็นย่อหน้า
// เดียวที่ไม่มีหัวข้อย่อย การตั้งป้ายคอลัมน์เองจะเป็นคำของเพจ ไม่ใช่ของบรีฟ
// (ไอคอนสองตัวจึงไม่ถูก render รอบนี้ — มันอยู่ในป้ายคอลัมน์)
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// ───────────────────────────────────────────────────────────────────────────
// ร่ำรวย168 (2026-10-23) — พาเลตตาม .claude/brand-spec-ruaythear168club.md §2
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **ทองสองเฉด + บรอนซ์ บนพื้นดำสนิท ของ ufalion168**
// ทั้งใบ จึงรีเธมทั้งไฟล์และ **กลับทิศ**: รอบนี้เป็น **ธีมสว่าง** พื้นเพจ
// **#dbe6ff** (bg.json) = ฟ้าเพอริวิงเคิลอ่อน **ไม่ใช่ดำสนิท**
// ⚠️ <section> ใบนี้ **ไม่มีการ์ดครอบ** (เป็นใบเดียวของหน้าที่เป็นแบบนั้น) ตัวอักษร
// ทุกตัวจึงนั่งบนพื้นเพจ #dbe6ff โดยตรง — ค่าคอนทราสต์ที่ใช้จึงต้องวัดกับพื้นเพจ
// ไม่ใช่กับผิวการ์ด: หัวข้อ #0d6b9b = **4.5:1** (ผ่าน AA ที่ขนาด text-xl/2xl
// font-black ซึ่งนับเป็น large text เกณฑ์ 3:1 และผ่านเกณฑ์ปกติพอดีด้วย) ·
// เนื้อความ #16294a = **11.2:1**
//
// จังหวะรูปทรงของใบนี้: **แท่งตั้งสี่เหลี่ยมมนข้างหัวข้อ + เส้นคาดใต้ header
// โดยไม่มีการ์ดครอบ** ซึ่งไม่ซ้ำกับใบไหนบนหน้าเดียวกัน (§1 แผ่นถมในสายปกติ ·
// §2 ขีดใต้ + แท่งสั้น · §3 เส้นคู่คร่อมบน-ล่าง · §4 ป้ายลอยผิวโครมเข้ม ·
// §5 ชิปถมฟ้าคู่กลีฟบนการ์ดมุมตัด 36px · §6 สันซ้ายสี่พิกเซลบนการ์ดมุมตัด 40px ·
// §8 หัวข้อจัดกลางพร้อมขีดใต้จางสองข้าง)
// แท่งตั้งไล่ **ฟ้าไซยาน #18a5e2 → ฟ้าเข้ม #0d6b9b → ฟ้าอ่อน #a9d7f2** (พื้นถมล้วน
// ไม่มีตัวอักษรวางทับ) หัวข้อเป็น **ฟ้าเข้ม #0d6b9b ทึบสีเดียว ไม่ไล่เฉด** —
// ⚠️ ไม่ใช้ bg-clip-text ที่นี่โดยตั้งใจ เพราะพื้นเพจสว่างและ §2 ห้าม #18a5e2
// (2.6:1 บนขาว · 2.1:1 บนพื้นเพจ) เป็นพิกเซลของตัวอักษร
// ป้ายคอลัมน์ (ถ้าแบรนด์ถัดไปส่งมา) เป็นขั้วกลับของกัน: ซ้าย #0d6b9b พร้อม
// **ชิปถมฟ้า** ไล่ #a9d7f2 → #18a5e2 หมึก **#111a3f** (สูตรปุ่มเน้นของ §2 —
// **ห้ามขาวบน #18a5e2**) ขวา #16294a พร้อม **ชิปครีม** ไล่ #f4e4d3 → #e4cbb3
// หมึก **#16294a** (11.9:1) ซึ่งเป็นวัสดุที่สองของรอบนี้
// เนื้อความ #16294a (= BRAND_TEXT)
//
// ⚠️ **เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี"** — ฟ้า/ไซยานนำมาแล้วห้าแบรนด์ในรีโปนี้
// (สบาย168 · รวยแทร่168 · นินจา168 · สบายเบท168 · TSDET911) การเจอฟ้าในไฟล์นี้
// จึงไม่พิสูจน์อะไรเลย ฟ้ารอบนี้คือ **#18a5e2** กับ **#0d6b9b** และครีมคือ
// **#f4e4d3 / #e4cbb3** (วัดจาก slide1.png ของดรอปนี้)
// ค่าที่ต้องไม่เหลือในไฟล์นี้:
//   ทอง/บรอนซ์ของ **ufalion168** ที่เพิ่งอยู่ทั้งใบ — d4922c fdfc71 f6e3b4 a25b24
//     5a3310 33200a 1f1304 0a0601 1a1000 fbf6e3 000000 กับ rgba 212/146/44 และ
//     rgba 253/252/113
//   แบรนด์ขาออก **เงินทอง168** — f5ba14 fcee52 b37c0b ecd5c4 d2b9a4 29210f 3d3016
//     332810 201906 2e2512 1b1407 4d3c15
//   **สบาย168** — 2cc3fc 6bdcfb 0a7fbd 063a57 04293d 0a4f74 9ae0fa cdf2ff ccf7ff
//     f2fbff dff4fd eafaff a9e3f9 0f3a4a 06293c (⚠️ 2cc3fc ห่าง #18a5e2 แค่
//     R20/G30/B26 และ 6bdcfb ห่างค่า vivid ดิบของโลโก้รอบนี้ 1 หน่วย)
//   **รวยแทร่168** — 039cfa 0494f5 c3ebfc 04366b e3f2fc 0b2d52 f9a826 704504
//   **นินจา168** — 32bcfb a9e9ff fef54b 6b5c10 07335f 0c2a3d 071a28
//   **สบายเบท168** — 2f9ff5 a8dcff d6ecff 0b3f78 e8f4ff ffc82e 5c4a16
//   **TSDET911** — 0360f3 0292fb 6ec8ff 4fb4ff cfdcec 9db4d4 dde8f7
//   **พักยก168** — eeae12 fded41 9f600d e0e0df c0c0bf a1a09e f4ead6 291d0f
//   **รวยเทพ168 / มีเฮ168 / รับตัง168 / สมหวัง168 / UFA324 / ขวัญใจ168 /
//     ถอนชัวร์168 / มีโชค168** — f0bb4e ffeccb e4021b d9701a 3b1b0e 260d04 ·
//     fb1b32 ff8f9c 5c0410 fcd45c 6b4a08 2b0711 · f0b429 ffdc8c d30304 ff6b6e
//     a00203 cfd9e6 · fa0513 ffadaf ff5a5f e3b23c ffe5a8 8a6210 b90203 ·
//     e5a81b ffe08a bb8410 7d5a07 8792a0 f0e8d4 b9c2cc 464f5a · f7c92b ffe6a3
//     f2bba5 c98a74 b3121b 5a0a0e eadfce · fa63b9 ffb3de ffd84d 6d0b3f ·
//     fcd434 ffeaa0 f5469f ff8dc6 8c0f52 7a5508
// (เฮกซ์ของแบรนด์เก่าด้านบนเขียนแบบ **ไม่มี #** โดยตั้งใจ เพื่อไม่ให้ sweep ที่ไล่หา
// สีของแบรนด์เก่าใน src/ สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
// ⚠️ **รอบนี้ไม่มีทอง/เหลืองเป็นสี UI เลยสักเฉด ไม่มีแดง ไม่มีชมพู/ฟูเชีย
// ไม่มีม่วง ไม่มีเขียว ไม่มีส้ม ไม่มีบรอนซ์ ไม่มีโรสโกลด์ และไม่มีแรมป์เทาเงิน**
// ⚠️ ไอคอนเริ่มต้นของสองคอลัมน์เปลี่ยนจาก ⚽ (ฟุตบอล — ของ ufalion168) เป็น
// 💬 / 🧾 รอบนี้ — §7 ของบรีฟคือ **ช่องทางติดต่อแอดมินกับหลักฐานรายการธุรกรรม**
// ไม่ใช่กีฬา และ brand-spec §1 ระบุว่าลูกฟุตบอลไม่มีอยู่ในอาร์ตเวิร์กรอบนี้
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#a9d7f2] pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#18a5e2] via-[#0d6b9b] to-[#a9d7f2] shadow-[0_0_10px_rgba(24,165,226,0.6)]" />
        <HeadingTag class={`${headingSize} leading-normal font-black tracking-wide text-[#0d6b9b]`}>{title}</HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#16294a]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#18a5e2]/60 pb-3 text-xl leading-normal font-black tracking-wide text-[#0d6b9b]">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#18a5e2] bg-gradient-to-br from-[#a9d7f2] to-[#18a5e2] text-sm text-[#111a3f] shadow-[0_5px_15px_rgba(24,165,226,0.45)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#16294a]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#e4cbb3] pb-3 text-xl leading-normal font-black tracking-wide text-[#16294a]">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#e4cbb3] bg-gradient-to-br from-[#f4e4d3] to-[#e4cbb3] text-sm text-[#16294a] shadow-[0_5px_15px_rgba(244,228,211,0.9)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
