---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🔐", iconright = "🦍" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a channel panel),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
// LoginRtpSection renders it without a title, which is why the page's heading
// inventory stops at the docx's own sections.
//
// Reached only through LoginRtpSection (a nested import), so a grep for
// "components/ContentBoxTwo.astro" in src/pages/ finds nothing — it is LIVE, not
// inventory, and has to carry the current brand's colours.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// KINGKONG555 (รอบเขียวป่า-ทองมงกุฎ 2026-10-09, brand-spec §2):
// โลโก้รอบนี้เป็นกอริลลาเขียวสวมมงกุฎทองฝังพลอยเขียว อยู่ในกรอบใบไม้ป่า พร้อมคำว่า
// KINGKONG เป็นตัวอักษรสามมิติเขียวมะนาวและเลข 555 สีเงิน แบนเนอร์กับสไลด์เป็นฉากป่า
// เขียวจัดที่มีน้ำตก เทวรูปหิน นกทูแคน และเหรียญทองกระจายเต็มภาพ แบรนด์จึงมีสองฮิวจริง —
// เขียวมะนาวนำ ทองมงกุฎเป็นฮิวที่สอง — ต่างจากคู่ม่วงนีออน-ทองของ WEPLAY168 รอบก่อน
// สองคอลัมน์ของกล่องนี้ถูกแยกด้วยคู่สีตรงๆ: ฝั่งซ้ายเป็นแผ่นทองทึบ ไล่เขียวครีม
// #e9f7d6 → ทองสว่าง #ffe066 → ทองมงกุฎ #f2c230 บนหมึกเขียวเข้มสุด #06220a (10:1
// ขึ้นไปทั้งไล่เฉด — §2 ห้ามพลิกแผ่นทองไปใช้หมึกสว่าง) ป้ายคอลัมน์เป็นทองมงกุฎ ส่วน
// ฝั่งขวาเป็นแผ่นใบไม้เขียวทึบ ไล่เขียวกลาง #2f8c07 → เขียวลึก #1a5c04 ในกรอบเขียวสด
// #5cc211 บนไอคอนทองสว่าง ป้ายคอลัมน์เป็นเขียวมะนาว #8ce023 ซึ่งใช้เป็นสีตัวอักษร
// บนพื้นมืดได้ (7.9:1 บนผิวยก) ขณะที่เขียวกลาง #2f8c07 ใช้ไม่ได้
// หัวข้อ docx (เมื่อมีการส่ง title มา) ไล่เขียวครีม → ทองสว่าง → เขียวมะนาว เส้นคั่น
// เป็นเขียวลึกทั้งสองฝั่ง สันหัวข้อไล่ทองสว่าง → ทองมงกุฎ → เขียวลึก
// เนื้อความ #e9f7d6 (= BRAND_TEXT)
//
// ไอคอนเริ่มต้นเป็น 🔐 / 🦍 — รอบนี้เป็นเว็บสล็อตธีมป่า/กอริลลาราชา ไม่ใช่เว็บหวยและ
// ไม่ใช่เว็บพนันรวมช่องทาง (LoginRtpSection ส่งไอคอนมาเองอยู่แล้ว ค่านี้คือกันหลงเท่านั้น)
//
// ชุดม่วงนีออน-ทองของ WEPLAY168 ที่เคยค้างในไฟล์นี้ (#a435f0 #7a1fc4 #fbe455 #efe6ff
// #ece2ff #d2a6ff #ffd23d #5b1a75 #c98a05 #190633 #1e0a3c #17062e #0a0117
// rgba(164,53,240,α) rgba(251,228,85,α)) ชุดแดงแล็กเกอร์-ทองของ PIGPG (#d4200d
// #a30303 #f5b61d #ffd87a #fdf9e4 #b07a06 #6b0402 #fdc4a3 #120302 #fdeedd) และชุด
// ทองเมทัลลิกของ 789BETTING (#fad354 #ffe79a #8a6410 #060402 #f3e7cd) ออกครบทุกจุดแล้ว
// — ทองของรอบนี้เป็นคนละค่า อย่าปล่อยของเก่าไว้เพราะ "ดูคล้ายกัน"
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#1a5c04] pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe066] via-[#f2c230] to-[#1a5c04] shadow-[0_0_10px_rgba(242,194,48,0.6)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#e9f7d6] via-[#ffe066] to-[#8ce023] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e9f7d6]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#1a5c04] pb-3 text-xl leading-normal font-black tracking-widest text-[#f2c230] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#a87a08] bg-gradient-to-br from-[#e9f7d6] via-[#ffe066] to-[#f2c230] text-sm text-[#06220a] shadow-[0_5px_15px_rgba(242,194,48,0.4)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e9f7d6]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#1a5c04] pb-3 text-xl leading-normal font-black tracking-widest text-[#8ce023] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#5cc211]/60 bg-gradient-to-br from-[#2f8c07] to-[#1a5c04] text-sm text-[#ffe066] shadow-[0_5px_15px_rgba(0,0,0,0.6)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
