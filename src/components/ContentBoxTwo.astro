---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🔐", iconright = "🎲" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a game-category
// panel), never docx article content, so both column labels render as <p> and
// the section gets its accessible name from aria-label instead of a heading.
// With a `title` the heading itself names the region, so the aria-label is
// dropped. LoginRtpSection renders it without a title this round, which is why
// the page's heading inventory stops at the eleven docx sections.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// WIN999 (รอบทอง-ดำ 2026-09-29): โลโก้อ่านซ้ายไปขวาว่า WIN เป็นทองสด #fcc403 แล้วปิด
// ด้วย 999 สีขาว บนพื้นดำสนิทที่มีริ้วแสงทองและชิปขอบทอง สองคอลัมน์ของกล่องนี้จึงถูกแยก
// ด้วยคู่ทอง/ขาวนั้นตรงๆ — ฝั่งซ้ายเป็นทองเต็มใบ ป้ายไอคอนไล่จากทองสว่าง #fdda04 ลงทอง
// แบรนด์ #fcc403 ไปหาทองลึก #8a6502 ตัวอักษรบนป้ายทองใช้หมึกเข้ม #120d02 ตามกฎ
// คอนทราสต์ที่ว่าตัวอักษรบนพื้นสว่างต้องเกือบดำ ส่วนฝั่งขวาเป็นขาวนวลบนพื้นดำ ป้ายไอคอน
// เป็นผิวการ์ด #191712 ในกรอบทองแบรนด์ ตัวอักษรเป็นขาวนวล #e9e4d6 หัวข้อ docx (เมื่อมี
// การส่ง title มา) ไล่ทองสว่าง → ทองแบรนด์ → ทองลึก เส้นคั่นเป็นทองลึกมาก #4a3402
// ทั้งสองฝั่ง เนื้อความ #e9e4d6 (BRAND_TEXT) — ชุดแดง-ทองของ LOTTO24 (#dc2626
// #fc2b2c #b40102 #7f1d1d #fbbf24 #fde68a #a16207 #2a0405 #fff1f1 #f6e2e2)
// ออกทั้งหมด
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#4a3402] pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdda04] via-[#fcc403] to-[#8a6502] shadow-[0_0_10px_rgba(252,196,3,0.5)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#fdda04] via-[#fcc403] to-[#8a6502] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e9e4d6]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#4a3402] pb-3 text-xl leading-normal font-black tracking-widest text-[#fcc403] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#fcc403]/70 bg-gradient-to-br from-[#fdda04] via-[#fcc403] to-[#8a6502] text-sm text-[#120d02] shadow-[0_5px_15px_rgba(252,196,3,0.4)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e9e4d6]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#4a3402] pb-3 text-xl leading-normal font-black tracking-widest text-[#e9e4d6] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#fcc403]/65 bg-[#191712] text-sm text-[#fdda04] shadow-[0_5px_15px_rgba(3,2,0,0.6)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
