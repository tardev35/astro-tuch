---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a service list),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// MHEEPOOH168: สีประจำแบรนด์เป็นคู่ทอง-แดงตามโลโก้ ป้ายไอคอนฝั่งซ้ายจึงไล่จากทอง
// สว่าง #fced74 ลงไปหาทองเข้ม #8a5a06 ส่วนฝั่งขวาไล่จากแดงสด #c4161c ลงมาหาแดง
// การ์ด #540202 สองครึ่งแยกกันด้วยคนละเฉดของคู่สีเดียวกัน ไม่ใช่ด้วยสีที่สาม
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#f5b70a]/40 pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fced74] via-[#f5b70a] to-[#8a5a06] shadow-[0_0_10px_rgba(245,183,10,0.55)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#fced74] via-[#f5b70a] to-[#c4161c] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f1dccd]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#f5b70a]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#fced74] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#f5b70a]/70 bg-gradient-to-br from-[#fced74] via-[#f5b70a] to-[#8a5a06] text-sm text-[#120303] shadow-[0_5px_15px_rgba(245,183,10,0.35)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f1dccd]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#c4161c]/55 pb-3 text-xl leading-normal font-black tracking-widest text-[#f1dccd] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#c4161c]/70 bg-gradient-to-br from-[#c4161c] via-[#8f0505] to-[#540202] text-sm text-[#fced74] shadow-[0_5px_15px_rgba(196,22,28,0.30)]">
              🛡️
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
