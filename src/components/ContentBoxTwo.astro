---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a service list),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Left column badge metallic gold, right column badge chrome silver — the
// OCZPLUS logo's own split (silver "OCZ", a red "+", a gold "PLUS" on a navy
// ground), so the two halves are told apart by hue and not only by position.
// The red stays on the divider hairline, sparingly.
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#8a6b2c]/55 pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f2dc9a] via-[#d9b45e] to-[#8a6b2c] shadow-[0_0_10px_rgba(217,180,94,0.45)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#f2dc9a] via-[#d9b45e] to-[#c0202b] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ccd6e6]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#8a6b2c]/55 pb-3 text-xl leading-normal font-black tracking-widest text-[#e4c67f] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#8a6b2c]/70 bg-gradient-to-br from-[#f2dc9a] via-[#d9b45e] to-[#8a6b2c] text-sm text-[#03101f] shadow-[0_5px_15px_rgba(217,180,94,0.30)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ccd6e6]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#8b939c]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#e6ebf0] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#8b939c]/55 bg-gradient-to-br from-[#e6ebf0] via-[#c9d2dc] to-[#8b939c] text-sm text-[#03101f] shadow-[0_5px_15px_rgba(230,235,240,0.24)]">
              📋
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
