---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🔐", iconright = "🎰" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a channel panel),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
// LoginRtpSection renders it without a title, which is why the page's heading
// inventory stops at the docx's own sections (brand-spec §4: h1×1 h2×5 h3×2).
//
// Reached ONLY through LoginRtpSection this round (index.astro does not import
// it directly — the docx's two-column section went to ContentBoxTwoNeumorphism,
// and the rest of the shape mix is in brand-spec §3).
// A grep for "components/ContentBoxTwo.astro" in src/pages/ therefore finds
// nothing, and that does NOT mean it is inventory: match the bare filename
// instead. It is LIVE and has to carry this brand's colours.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// สบายเบท168 (รอบ **ฟ้าบับเบิลนำ · ทองเป็นฮิวที่สอง · น้ำเงินลึกไม่เคยถือตัวอักษร
// บนดำสนิท** 2026-10-19) — พาเลตต์ตาม brand-spec §2
// โลโก้: แมวการ์ตูนขนขาวลายส้มหน้ายิ้มหลับตา สวมปลอกคอฟ้ามีกระดิ่งทอง นั่งคู่มือถือ
// จอฟ้าที่มีลูกศรดาวน์โหลดและปึกแบงก์สีฟ้า เหนือคำว่า "สบาย" ตัวอักษรไทยหนาสามมิติ
// **สีทอง** ต่อด้วย "เบท168" **ฟ้าบับเบิลผิวมันวาว** ล้อมด้วยหัวใจฟ้าและเหรียญ
// บิตคอยน์ทอง
// ⚠️ **ฮิวนำของรอบนี้คือฟ้าบับเบิล #2f9ff5 และทอง #ffc82e เป็นตัวรอง ซึ่งเปลี่ยน
// ตระกูลสีไปเลยจากรอบที่แล้ว** (ถอนชัวร์168 ชมพูบับเบิลกัม fa63b9 นำ ทองเนย ffd84d
// รอง) ห้ารอบหลังสุดวนอยู่ใน ชมพู/แดง/ทอง ทั้งหมด การที่ฟ้าขึ้นมานำคือสิ่งเดียวที่
// แยกรอบนี้ออกจากกองนั้น
// ⚠️ bg.json = {"mode":"color","color":"#000000"} → พื้นเพจเป็น **ดำสนิท** ลำดับ
// ความลึก: #0e2238 ยก / #081726 กลาง / #040d16 จม / #000000 พื้น
// กล่องนี้ไม่มีการ์ดครอบ มันวางสองคอลัมน์ลงบนพื้นเพจดำสนิทตรงๆ จึงเป็นจังหวะ
// "โปร่ง" ของหน้า คั่นหลังบล็อกเนื้อหาของบรีฟ — กล่องเนื้อหาใบอื่นมีผิวและกรอบของ
// ตัวเองทั้งหมด
// สองคอลัมน์ถูกแยกด้วยคู่ "แผ่นถมสว่าง vs แผ่นมืดกรอบทอง" และเรียงตามลำดับนำของ
// รอบนี้: **ฝั่งซ้ายเป็นฝั่งฟ้า** ป้ายไอคอนเป็นแผ่นถมไล่ #a8dcff → #2f9ff5 บนหมึก
// #04121f (§2 ระบุว่านี่คือหมึกตัวเดียวที่วางบนพื้นถมฟ้า/ทองได้ — 6.9:1 บน #2f9ff5
// และ 11.6:1 บน #a8dcff **ห้ามพลิกแผ่นสว่างไปใช้หมึกสว่าง**) ป้ายคอลัมน์ซ้ายเป็น
// ฟ้าแบรนด์ #2f9ff5 (5.9:1 และเป็น text-xl font-black จึงเป็น large text)
// ส่วน **ฝั่งขวาเป็นฝั่งทอง** ป้ายไอคอนเป็นแผ่นมืดไล่ผิวยก #0e2238 → ผิวจม #040d16
// ในกรอบทองลึก #5c4a16 บนไอคอนทอง #ffc82e และป้ายคอลัมน์ขวาเป็นทอง (11.3:1)
// §2 ห้าม #0b3f78 (1.4:1) และ #5c4a16 (1.9:1) ถือตัวอักษรที่ไหนเลย — ในไฟล์นี้
// ทั้งสองค่าอยู่ที่ขอบ เส้นคั่น และสันหัวข้อเท่านั้น
// หัวข้อ docx (เมื่อมีการส่ง title มา) ไล่ ฟ้าแบรนด์ #2f9ff5 → ฟ้าอ่อน #a8dcff →
// ทอง #ffc82e ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุกสต็อป
// จึงต้องถือตัวอักษรได้ตาม §2 (5.9 / 11.6 / 11.3) สันหัวข้อไล่ #2f9ff5 → #a8dcff →
// ทองลึก #5c4a16 (ซึ่งเป็น **พื้น** ไม่ใช่ตัวอักษร จึงใช้ได้)
// เส้นคั่นเป็นฟ้าแบรนด์ฝั่งซ้าย และทองลึก #5c4a16 ฝั่งขวา
// เนื้อความ #e8f4ff (= BRAND_TEXT) — 17.6:1 บนดำสนิท
// glow rgba ใช้ได้ 4 ชุดตาม §2: rgba(47,159,245,α) · rgba(255,200,46,α) ·
// rgba(168,220,255,α) · rgba(11,63,120,α) — ไฟล์นี้ใช้สองชุดแรก
//
// ไอคอนเริ่มต้นเป็น 🔐 / 🎰 — บรีฟรอบนี้เป็น **เว็บสล็อตล้วน** ไม่ใช่คาสิโนและไม่ใช่
// หวย จึงไม่ใช้ไพ่/ลูกเต๋า/ลูกบอลเป็นค่าตั้งต้น (LoginRtpSection ส่งไอคอนมาเองอยู่
// แล้ว ค่านี้คือกันหลง)
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้มีสองชั้น: ทอง และ ฟ้า**
// ทองเป็นกับดักเดิมเพราะเกือบทุกรอบมีทอง และ **ฟ้าเป็นกับดักใหม่** เพราะ TSDET911
// เคยเป็นน้ำเงิน-ฟ้าทั้งชุดในไฟล์นี้ ฟ้าของมันคือ 0360f3 / 0292fb / 6ec8ff / 4fb4ff
// ส่วนฟ้ารอบนี้คือ **#2f9ff5 / #a8dcff / #0b3f78** คนละค่าทุกตัว และ cfd9e6 ของ
// รับตัง168 เป็นเงินอมฟ้าที่หน้าตาใกล้ฟ้าอ่อนมาก
// ชุดที่เพิ่งอยู่ในไฟล์นี้คือถอนชัวร์168 (fa63b9 ffb3de ffd84d 2b0f20 1a0914 0d040a
// 6d0b3f 6b4708 2a0617 fdeaf5) ก่อนหน้านั้นคือมีโชค168 (fcd434 ffeaa0 f5469f ff8dc6
// 8c0f52 7a5508 1a0612 f6e4ee 24101c 160a12 0b0509) ขวัญใจ168 (f7c92b ffe6a3 f2bba5
// c98a74 b3121b 5a0a0e 8a5f12 eadfce 140c06 241509 160d06 0b0603) รับตัง168 (f0b429
// ffdc8c d30304 ff6b6e a00203 4a0202 9a6c0c cfd9e6 f5ece0 2b100f 200a09 140505
// 1a0505) สมหวัง168 (fa0513 ffadaf ff5a5f e3b23c ffe5a8 8a6210 b90203 8c0204 5b0203
// 3c0303 f4ecea 2c1413 1f0d0c 140706 290f0f) และ TKB55 (fb131b ff8a8f ff4d55 e9eef4
// aeb9c6 f2e4e5 2a0d0f 1a0708 0d0304) — ถอดออกครบแล้ว
// ⚠️ ทองรอบนี้คือ **#ffc82e** (R=255 G=200 B=46) ไม่ใช่ ffd84d (ถอนชัวร์168) fcd434
// (มีโชค168) f7c92b (ขวัญใจ168) f0b429 (รับตัง168) e3b23c (สมหวัง168) dfa310 ffc93d
// e5a81b e2b33f fad354 8a6210 หรือ 9a6c0c
// ⚠️ พื้นเพจรอบนี้คือ **#000000** เหมือนรอบก่อน แต่ผิวทั้งสามชั้นเป็นโทนน้ำเงินหมึก
// อมฟ้า (#0e2238 / #081726 / #040d16) ไม่ใช่โทนพลัมชมพูของรอบก่อน (2b0f20 / 1a0914 /
// 0d040a)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีชมพู แดง ม่วง/ไวโอเลต เขียว ส้ม เงิน/โครเมียม และโรสโกลด์**
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#5c4a16] pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#2f9ff5] via-[#a8dcff] to-[#5c4a16] shadow-[0_0_10px_rgba(47,159,245,0.6)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#2f9ff5] via-[#a8dcff] to-[#ffc82e] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e8f4ff]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#2f9ff5]/60 pb-3 text-xl leading-normal font-black tracking-widest text-[#2f9ff5] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#0b3f78] bg-gradient-to-br from-[#a8dcff] to-[#2f9ff5] text-sm text-[#04121f] shadow-[0_5px_15px_rgba(47,159,245,0.45)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e8f4ff]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#5c4a16] pb-3 text-xl leading-normal font-black tracking-widest text-[#ffc82e] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#5c4a16] bg-gradient-to-br from-[#0e2238] to-[#040d16] text-sm text-[#ffc82e] shadow-[0_5px_15px_rgba(255,200,46,0.3)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
