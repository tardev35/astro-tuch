---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🔐", iconright = "🎰" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a game-category
// panel), never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
// LoginRtpSection renders it without a title, which is why the page's heading
// inventory stops at the docx's own sections.
//
// Reached only through LoginRtpSection (a nested import), so a grep for
// "components/ContentBoxTwo.astro" in src/pages/ finds nothing — it is LIVE, not
// inventory, and has to carry the current brand's colours.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// UP555 (รอบทอง + เงินโครเมียม บนดำอมน้ำตาล 2026-10-03): โลโก้เป็นสองโลหะจริง — ตัว U
// กับตัวอักษร UP เป็นเงินโครเมียม (dominant #d5d4d3 #dcdcdb #f3f3f2) ส่วนลูกศร วงรี
// และเลข 555 เป็นทองเมทัลลิก (vivid #ebbb54 #fce675 #ab6d24) สองคอลัมน์ของกล่องนี้จึง
// ถูกแยกด้วยคู่โลหะนั้นตรงๆ ไม่ใช่ด้วยความสว่างของสีเดียว — ฝั่งซ้ายเป็นทอง ป้ายไอคอน
// ไล่ทองสว่าง #fce675 → ทองแบรนด์ #ebbb54 → ทองลึก #ab6d24 บนหมึกเข้ม #160d02 (พื้น
// ทองสว่างต้องใช้หมึกเข้มเสมอ) ส่วนฝั่งขวาเป็นเงิน ป้ายไอคอนไล่เงินสว่าง #f3f3f2 →
// เงินโครเมียม #d5d4d3 → ทองลึก #ab6d24 บนหมึกเข้มเดียวกัน ป้ายคอลัมน์ซ้ายเป็นทอง
// แบรนด์ ฝั่งขวาเป็นเงินโครเมียม ซึ่งอยู่บนพื้นเพจดำอมน้ำตาล ไม่ได้อยู่บนพื้นสี หัวข้อ
// docx (เมื่อมีการส่ง title มา) ไล่ทองสว่าง → ทองแบรนด์ → ทองลึก เส้นคั่นเป็นทองลึก
// #6b4517 ทั้งสองฝั่ง เนื้อความ #f8eed9 (BRAND_TEXT)
//
// ชุดเขียวมรกต-แดงสด-ทองของ DM899 ที่เคยค้างในไฟล์นี้ (#01a326 #4ade6b #12c23a
// #01841b #fb252b #ff6b6e #8f0609 #0a4a18 #06140a #ffe9a8 #f2b422 #e4f2e4)
// ออกครบทุกจุดแล้ว
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#6b4517] pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fce675] via-[#ebbb54] to-[#ab6d24] shadow-[0_0_10px_rgba(235,187,84,0.5)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#fce675] via-[#ebbb54] to-[#ab6d24] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f8eed9]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#6b4517] pb-3 text-xl leading-normal font-black tracking-widest text-[#ebbb54] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#fce675]/70 bg-gradient-to-br from-[#fce675] via-[#ebbb54] to-[#ab6d24] text-sm text-[#160d02] shadow-[0_5px_15px_rgba(235,187,84,0.40)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f8eed9]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#6b4517] pb-3 text-xl leading-normal font-black tracking-widest text-[#d5d4d3] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#f3f3f2]/70 bg-gradient-to-br from-[#f3f3f2] via-[#d5d4d3] to-[#ab6d24] text-sm text-[#160d02] shadow-[0_5px_15px_rgba(213,212,211,0.35)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
