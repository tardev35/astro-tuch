---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🔐", iconright = "🎟️" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a lottery-list
// panel), never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
// LoginRtpSection renders it without a title, which is why the page's heading
// inventory stops at the docx's own sections.
//
// Reached only through LoginRtpSection (a nested import), so a grep for
// "components/ContentBoxTwo.astro" in src/pages/ finds nothing — it is LIVE, not
// inventory, and has to carry the current brand's colours.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// หวยคิง (รอบทองโลหะ + ครีมอมพีช บนดำอมน้ำตาล 2026-10-04): brand-spec §2
// งานอาร์ตรอบนี้มีคู่สีจริงสองสี — ทองโลหะของมงกุฎ/ลูกบอลหวย/ตัวอักษร "หวยคิง"
// กับครีมอมพีชของชุดขาวนางแบบใน slide1/slide2 (`dominant` ของ slide1 คือ #fcd4c3)
// สองคอลัมน์ของกล่องนี้จึงถูกแยกด้วยคู่นั้นตรงๆ ไม่ใช่ด้วยความสว่างของสีเดียว —
// ฝั่งซ้ายเป็นทอง ป้ายไอคอนไล่ทองสว่าง #fdeb7c → ทองแบรนด์ #cd9a2c → ทองลึก #ab7314
// บนหมึกเข้ม #120a02 (พื้นทองสว่างต้องใช้หมึกเข้มเสมอ) ป้ายคอลัมน์เป็นทองแบรนด์
// #cd9a2c ส่วนฝั่งขวาเป็นครีม ป้ายไอคอนไล่ครีมอ่อน #fce2d4 → ครีมอมพีช #fcd4c3 →
// ทองลึก #ab7314 บนหมึกเดียวกัน ป้ายคอลัมน์เป็น #fcd4c3 ทั้งคู่วางอยู่บนพื้นเพจดำ
// อมน้ำตาล ไม่ได้อยู่บนพื้นสี หัวข้อ docx (เมื่อมีการส่ง title มา) ไล่ทองสว่าง →
// ทองแบรนด์ → ทองลึก เส้นคั่นเป็นเส้นจาง #5c3f12 ทั้งสองฝั่ง
// เนื้อความ #f5e7c8 (= BRAND_TEXT) glow เป็น rgba(205,154,44,…)
//
// ไอคอนเริ่มต้นเป็น 🔐 / 🎟️ — รอบนี้เป็นเว็บหวยล้วน ไม่ใช่คาสิโน ค่าเริ่มต้น 🎰 เดิม
// จึงถูกถอดออก (LoginRtpSection ส่งไอคอนมาเองอยู่แล้ว ค่านี้คือกันหลงเท่านั้น)
//
// ชุดทอง + เงินโครเมียมของ UP555 ที่เคยค้างในไฟล์นี้ (#ebbb54 #fce675 #ab6d24
// #d5d4d3 #f3f3f2 #6b4517 #241705 #160d02 #f8eed9 rgba(235,187,84,…)
// rgba(213,212,211,…)) ออกครบทุกจุดแล้ว — ครีมอมพีชมาแทนเงินโครเมียม
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#5c3f12] pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdeb7c] via-[#cd9a2c] to-[#ab7314] shadow-[0_0_10px_rgba(205,154,44,0.5)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#fdeb7c] via-[#cd9a2c] to-[#ab7314] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f5e7c8]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#5c3f12] pb-3 text-xl leading-normal font-black tracking-widest text-[#cd9a2c] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#fdeb7c]/70 bg-gradient-to-br from-[#fdeb7c] via-[#cd9a2c] to-[#ab7314] text-sm text-[#120a02] shadow-[0_5px_15px_rgba(205,154,44,0.40)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f5e7c8]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#5c3f12] pb-3 text-xl leading-normal font-black tracking-widest text-[#fcd4c3] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#fce2d4]/70 bg-gradient-to-br from-[#fce2d4] via-[#fcd4c3] to-[#ab7314] text-sm text-[#120a02] shadow-[0_5px_15px_rgba(252,212,195,0.35)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
