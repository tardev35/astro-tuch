---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🔐", iconright = "🎴" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a game-list panel),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
// LoginRtpSection renders it without a title, which is why the page's heading
// inventory stops at the docx's own sections.
//
// Reached only through LoginRtpSection (a nested import), so a grep for
// "components/ContentBoxTwo.astro" in src/pages/ finds nothing — it is LIVE, not
// inventory, and has to carry the current brand's colours.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// GUCCI168 (รอบแดง-เขียวมรกต-ทอง บนพื้นเกือบดำอมแดง 2026-10-08, brand-spec §3):
// โลโก้รอบนี้มีคู่สีจริงอยู่ในตัวเอง — เทพเจ้าโชคลาภจีนสวมหมวกทรงจีนสีเขียวมรกตคาดแถบ
// แดง และตัวอักษร GUCCI ขาวเงินขอบเขียวมรกตทับเลข 168 แดงเมทัลลิกขอบทอง สองคอลัมน์
// ของกล่องนี้จึงถูกแยกด้วยคู่สีนั้นตรงๆ ไม่ใช่ด้วยความสว่างของสีเดียว — ฝั่งซ้ายเป็น
// ฝั่งแดง ป้ายไอคอนไล่แดงสว่าง #e0201f → แดงแบรนด์ #c41115 → แดงลึก #7a0505 บนตัวอักษร
// ขาว (6.1:1 / 4.8:1 ตาม §3 ซึ่งห้ามดันพื้นแดงให้สว่างกว่า #e0201f ถ้ามีตัวอักษรขาวทับ)
// ป้ายคอลัมน์เป็นแดงสว่าง ส่วนฝั่งขวาเป็นฝั่งเขียว ป้ายไอคอนไล่เขียวมรกต #0b7a33 →
// เขียวลึก #063f1c บนตัวอักษรขาว (5.5:1) — ไม่ใช้พื้นเขียวสว่าง #2bbf63 เพราะขาวบนนั้น
// ได้แค่ 2.3:1 ซึ่ง §3 ห้ามไว้ ป้ายคอลัมน์เป็นเขียวสว่าง #2bbf63 ซึ่งใช้เป็นสีตัวอักษร
// บนพื้นมืดได้
// หัวข้อ docx (เมื่อมีการส่ง title มา) ไล่ทองอ่อน #ffdf91 → แดงสว่าง #e0201f → เขียว
// สว่าง #2bbf63 เส้นคั่นเป็นทองลึก #8c6410 ทั้งสองฝั่ง เนื้อความ #f6e3cf (= BRAND_TEXT)
//
// ไอคอนเริ่มต้นเป็น 🔐 / 🎴 — รอบนี้เป็นเว็บคาสิโนไลฟ์ + สล็อต + บอล ไม่ใช่เว็บหวย
// (LoginRtpSection ส่งไอคอนมาเองอยู่แล้ว ค่านี้คือกันหลงเท่านั้น)
//
// ชุดทองเมทัลลิก-เงินโครเมียมของ UOK365 ที่เคยค้างในไฟล์นี้ (#c8912f #f5d98a #6d4412
// #d8dbe0 #191108 #070504 #191005 #ece1cc rgba(200,145,47,…) rgba(216,219,224,…))
// ออกครบทุกจุดแล้ว
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#8c6410] pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffdf91] via-[#d9a521] to-[#8c6410] shadow-[0_0_10px_rgba(217,165,33,0.6)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#ffdf91] via-[#e0201f] to-[#2bbf63] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e3cf]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#8c6410] pb-3 text-xl leading-normal font-black tracking-widest text-[#e0201f] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#7a0505] bg-gradient-to-br from-[#e0201f] via-[#c41115] to-[#7a0505] text-sm text-white shadow-[0_5px_15px_rgba(196,17,21,0.5)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e3cf]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#8c6410] pb-3 text-xl leading-normal font-black tracking-widest text-[#2bbf63] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#063f1c] bg-gradient-to-br from-[#0b7a33] to-[#063f1c] text-sm text-white shadow-[0_5px_15px_rgba(11,122,51,0.45)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
