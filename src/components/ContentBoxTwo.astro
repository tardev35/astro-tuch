---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🔐", iconright = "🚀" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a channel panel),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
// LoginRtpSection renders it without a title, which is why the page's heading
// inventory stops at the docx's own sections.
//
// Reached ONLY through LoginRtpSection this round (index.astro does not import
// it directly — the docx's two-column sections went to ContentBoxTwoCyberCut and
// ContentBoxTwoNeumorphism). A grep for "components/ContentBoxTwo.astro" in
// src/pages/ therefore finds nothing, and that does NOT mean it is inventory:
// match the bare filename instead. It is LIVE and has to carry this brand's
// colours.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// NAZA168 (รอบทองอวกาศ-เงินโครเมียม บนน้ำตาลคั่วเข้ม 2026-10-10, brand-spec §2):
// โลโก้รอบนี้เป็นเหรียญตรากลมขอบทองหนาบนพื้นเกือบดำ ข้างในเป็นหมวกนักบินอวกาศสีเงิน-
// ทองพร้อมบังตาสะท้อนสีทองเข้ม มีจรวดทองพุ่งผ่านวงแหวน คำว่า NAZA เป็นทองสามมิติและ
// เลข 168 เป็นเงินโครเมียมขอบทอง แบนเนอร์กับสไลด์เป็นฉากอวกาศในทางเดินสถานีสีทอง
// ดาวเคราะห์มีวงแหวน โลกสีน้ำเงิน ตู้สล็อต 777 มงกุฎทอง เหรียญทอง และมาสคอตนักบิน
// อวกาศการ์ตูน แบรนด์จึงมีสองฮิวจริง — **ทองอวกาศ #fbc134 นำ** และ **เงินโครเมียม
// #cfd6e3 เป็นฮิวที่สอง** รอบนี้ไม่มีสีแดงอยู่ในชุดเลย
// กล่องนี้ไม่มีการ์ดครอบ มันวางสองคอลัมน์ลงบนพื้นเพจน้ำตาลคั่วเข้ม #382400 ตรงๆ จึงเป็น
// จังหวะ "โปร่ง" ของหน้า คั่นหลังบล็อกเนื้อหาของบรีฟทั้งแปดส่วน
// สองคอลัมน์ถูกแยกด้วยคู่ "แผ่นทองทึบ vs แผ่นเงินลึกทึบ": ฝั่งซ้ายเป็นแผ่นทอง ไล่ทอง
// สว่าง #ffe87a → ทองแบรนด์ #fbc134 → ทองกลางเข้ม #cf9a18 บนหมึกน้ำตาลเกือบดำ #231500
// (7.0:1 ที่ปลายเข้มสุด — §2 ห้ามไล่ลงไปถึง #96690a ใต้ตัวอักษร เพราะเหลือ 3.7:1 และ
// ห้ามพลิกแผ่นทองไปใช้หมึกสว่าง) ป้ายคอลัมน์ซ้ายเป็นทองแบรนด์ ส่วนฝั่งขวาเป็นแผ่นเงินลึก
// ทึบ ไล่เงินลึก #3f4859 → ผิวลึกสุด #241700 ในกรอบโครเมียม #cfd6e3 บนไอคอนทองสว่าง
// ป้ายคอลัมน์ขวาเป็นโครเมียม #cfd6e3 — §2 ห้าม #3f4859 ถือตัวอักษรที่ไหนเลย
// หัวข้อ docx (เมื่อมีการส่ง title มา) ไล่ครีมรอง #d9c9a6 → ทองสว่าง #ffe87a → ทอง
// แบรนด์ #fbc134 เส้นคั่นเป็นทองลึกสุด #6b4a05 ทั้งสองฝั่ง สันหัวข้อไล่ทองสว่าง → ทอง
// แบรนด์ → เงินลึก #3f4859 เนื้อความ #fdf3df (= BRAND_TEXT) — 13.5:1 บนพื้นเพจ
//
// ไอคอนเริ่มต้นเป็น 🔐 / 🚀 — รอบนี้เป็นเว็บสล็อตธีมอวกาศ/นักบินอวกาศ ไม่ใช่เว็บหวย
// (LoginRtpSection ส่งไอคอนมาเองอยู่แล้ว ค่านี้คือกันหลงเท่านั้น)
//
// ⚠️ หกในเจ็ดแบรนด์ก่อนหน้าก็มีทอง เจอทองที่ไหนห้ามเหมาว่าเป็นของรอบนี้ ให้เทียบค่า
// เป็นตัวๆ: ชุดทองสายฟ้า-แดงเลือดนกของ FLASH877 ที่เคยค้างในไฟล์นี้ (#f5c518 #ffdd73
// #b8860f #8a6208 #ff3b14 #8c0f0a #5a0603 #7d1008 #6d0804 #5c0000 #430000 #fdf0e2
// #f8d2bb #d4a894 #2a0300 rgba(245,197,24,α) rgba(255,59,20,α)) ชุดแดงเสือโคร่ง-ทอง
// ถ่านไฟของ SUPERSLOTCLUB (#e8232a #ff5a46 #7d0f12 #f2b705 #ffd666 #c08a0b #a8730a
// #f5cbb0 #fbe8d5) ชุดเขียวป่า-ทองมงกุฎของ KINGKONG555 (#8ce023 #f2c230 #ffe066
// #a87a08 #e9f7d6) ชุดม่วงนีออน-ทองของ WEPLAY168 (#a435f0 #fbe455 #ffd23d #5b1a75)
// และชุดแดงแล็กเกอร์-ทองของ PIGPG (#d4200d #f5b61d #ffd87a #fdeedd) ออกครบทุกจุดแล้ว
// — #f5c518 ของรอบก่อนใกล้ #fbc134 ของรอบนี้มาก แต่เป็นคนละค่า และ #ffdd73 / #ffd666
// / #ffe066 / #ffd87a ก็เป็นคนละค่ากับ #ffe87a ทุกตัว
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#6b4a05] pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe87a] via-[#fbc134] to-[#3f4859] shadow-[0_0_10px_rgba(251,193,52,0.6)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#d9c9a6] via-[#ffe87a] to-[#fbc134] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fdf3df]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#6b4a05] pb-3 text-xl leading-normal font-black tracking-widest text-[#fbc134] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#cf9a18] bg-gradient-to-br from-[#ffe87a] via-[#fbc134] to-[#cf9a18] text-sm text-[#231500] shadow-[0_5px_15px_rgba(251,193,52,0.4)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fdf3df]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#6b4a05] pb-3 text-xl leading-normal font-black tracking-widest text-[#cfd6e3] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#cfd6e3]/60 bg-gradient-to-br from-[#3f4859] to-[#241700] text-sm text-[#ffe87a] shadow-[0_5px_15px_rgba(0,0,0,0.6)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
