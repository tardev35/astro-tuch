---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🔐", iconright = "🎰" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a game-format
// panel), never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
// LoginRtpSection renders it without a title, which is why the page's heading
// inventory stops at the docx's own sections.
//
// Reached only through LoginRtpSection (a nested import), so a grep for
// "components/ContentBoxTwo.astro" in src/pages/ finds nothing — it is LIVE, not
// inventory, and has to carry the current brand's colours.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// NATO168 (รอบทอง-เงิน-ดำ 2026-10-02): โลโก้เป็นสองโทนจริง — คำว่า NATO เป็นเงิน
// เมทัลลิก ส่วนเลข 168 กับวงกลมตัว N เป็นทอง สองคอลัมน์ของกล่องนี้จึงถูกแยกด้วยโทน
// ไม่ใช่ด้วยความสว่างของสีเดียว — ฝั่งซ้ายเป็นทอง ป้ายไอคอนไล่ทองอ่อน #fde8a8 ลง
// ทองแบรนด์ #edb543 ไปหาทองลึก #a9761f บนหมึกเข้ม #1a1203 (ซึ่งเป็นจุดที่มืดที่สุดที่
// ยังรองหมึกเข้มได้ที่ 4.7:1) ส่วนฝั่งขวาเป็นเงิน ป้ายไอคอนไล่เงิน #e6e6e6 → เงินหม่น
// #a9a9a9 บนหมึกเข้มเดียวกัน ป้ายคอลัมน์ซ้ายเป็นทองแบรนด์ ฝั่งขวาเป็นเงิน หัวข้อ docx
// (เมื่อมีการส่ง title มา) ไล่ทองอ่อน → ทองแบรนด์ → เงิน เส้นคั่นเป็น #3a2a0d ทั้งสอง
// ฝั่ง เนื้อความ #f4ead3 (BRAND_TEXT)
//
// ชุดทองล้วนของ NAZA99 ที่เคยค้างในไฟล์นี้ (#e4b34d #fdf2ac #c08f2b #8a5f12 #140c02
// #1a1000 #f3e8cf) ออกครบทุกจุดแล้ว รอบนี้เงินเป็นฮิวที่สองจริง ไม่ใช่ทองที่หรี่ลง
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#3a2a0d] pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fde8a8] via-[#edb543] to-[#a9761f] shadow-[0_0_10px_rgba(237,181,67,0.5)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#fde8a8] via-[#edb543] to-[#e6e6e6] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f4ead3]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#3a2a0d] pb-3 text-xl leading-normal font-black tracking-widest text-[#edb543] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#edb543]/70 bg-gradient-to-br from-[#fde8a8] via-[#edb543] to-[#a9761f] text-sm text-[#1a1203] shadow-[0_5px_15px_rgba(237,181,67,0.40)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f4ead3]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#3a2a0d] pb-3 text-xl leading-normal font-black tracking-widest text-[#e6e6e6] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#e6e6e6]/70 bg-gradient-to-br from-[#e6e6e6] to-[#a9a9a9] text-sm text-[#1a1203] shadow-[0_5px_15px_rgba(230,230,230,0.30)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
