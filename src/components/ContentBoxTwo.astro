---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a service list),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// ENTER55: สีประจำแบรนด์มีสายเดียวคือทองเมทัลลิก ป้ายไอคอนฝั่งซ้ายจึงไล่จากทองหลัก
// #c4a255 ลงไปหาทองเข้ม #8a6d2c ส่วนฝั่งขวาไล่จากทองประกาย #ebd484 ลงมาหาทองหลัก
// สองครึ่งแยกกันด้วยความสว่างในเฉดทองเดียวกัน ไม่ใช่ด้วยสีที่สอง
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#c4a255]/40 pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ebd484] via-[#c4a255] to-[#8a6d2c] shadow-[0_0_10px_rgba(196,162,85,0.55)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#ebd484] via-[#d2b262] to-[#c4a255] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ded8cb]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#c4a255]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#d2b262] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#c4a255]/70 bg-gradient-to-br from-[#c4a255] via-[#8a6d2c] to-[#5a4e34] text-sm text-[#ebd484] shadow-[0_5px_15px_rgba(196,162,85,0.35)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ded8cb]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#ebd484]/45 pb-3 text-xl leading-normal font-black tracking-widest text-[#ebd484] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#ebd484]/60 bg-gradient-to-br from-[#ebd484] via-[#d2b262] to-[#c4a255] text-sm text-[#000000] shadow-[0_5px_15px_rgba(235,212,132,0.28)]">
              🛡️
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
