---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a checklist panel),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
// LoginRtpSection renders it without a title this round, which is why the page's
// heading inventory stops at the eight docx sections.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// PGW44 (รอบทอง-เขียว-ดำ 2026-09-27): โลโก้อ่านซ้ายไปขวาว่า P ดำขอบทอง G ทอง W เขียว
// แล้วปิดด้วย 44 ที่ไล่ทองไปเขียว สองคอลัมน์ของกล่องนี้จึงถูกแยกด้วยคู่สีนั้นตรงๆ —
// ฝั่งซ้ายเป็นทองล้วน ป้ายไอคอนไล่จากทองอ่อน #fff89a ลงทองแบรนด์ #fde90e ไปหาทองลึก
// #a86f02 ตัวอักษรบนป้ายใช้หมึกเข้ม #10160a ตามกฎคอนทราสต์ที่ว่าตัวอักษรบนพื้นสว่าง
// ต้องเกือบดำ ไม่ใช่ขาว ส่วนฝั่งขวาเป็นเขียวล้วน ไล่จากเขียวสว่าง #5df53a ลงเขียว
// แบรนด์ #35d413 ไปจบที่เขียวลึก #0c6d10 หัวข้อ docx (เมื่อมีการส่ง title มา) ไล่ทอง
// อ่อน → ทองกลาง #f5c518 → เขียวแบรนด์ ตามลำดับบนโลโก้ เส้นคั่นเป็นเขียวลึก #1f5a16
// ทั้งสองฝั่ง เนื้อความ #e9f0dd (BRAND_TEXT) — ชุดทอง-โครเมียมของแบรนด์รอบก่อน
// (#fdd32a #ffe27a #c8920a #c2c8d0 #f2f4f7 #8a9099 #ffeeb8 #4a3a12 #2a2110
// #15110a #efe6d2) ออกทั้งหมด
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#1f5a16]/80 pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fff89a] via-[#f5c518] to-[#35d413] shadow-[0_0_10px_rgba(253,233,14,0.5)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#fff89a] via-[#f5c518] to-[#35d413] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e9f0dd]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#1f5a16]/80 pb-3 text-xl leading-normal font-black tracking-widest text-[#fde90e] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#fde90e]/70 bg-gradient-to-br from-[#fff89a] via-[#fde90e] to-[#a86f02] text-sm text-[#10160a] shadow-[0_5px_15px_rgba(253,233,14,0.4)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e9f0dd]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#1f5a16]/80 pb-3 text-xl leading-normal font-black tracking-widest text-[#5df53a] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#35d413]/65 bg-gradient-to-br from-[#5df53a] via-[#35d413] to-[#0c6d10] text-sm text-[#10160a] shadow-[0_5px_15px_rgba(53,212,19,0.3)]">
              🗂️
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
