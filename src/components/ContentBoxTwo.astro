---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🔐", iconright = "🃏" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a channel panel),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
// LoginRtpSection renders it without a title, which is why the page's heading
// inventory stops at the docx's own sections.
//
// Reached ONLY through LoginRtpSection this round (index.astro does not import
// it directly — the docx's two-column section went to ContentBoxTwoNeumorphism
// and the rest of the shape mix is in brand-spec §3).
// A grep for "components/ContentBoxTwo.astro" in src/pages/ therefore finds
// nothing, and that does NOT mean it is inventory: match the bare filename
// instead. It is LIVE and has to carry this brand's colours.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// TSDET911 (รอบน้ำเงินไฟฟ้า-เงินโครเมียม 2026-10-13, brand-spec §2):
// โลโก้คือคำว่า TSDET เป็นตัวอักษรสามมิติสีเงินโครเมียมขัดเงา ต่อด้วยเลข 911 สีน้ำเงิน
// ไฟฟ้า มีปีกเหยี่ยว/สวูชสีน้ำเงินอยู่ด้านซ้ายของคำ งานอาร์ตเป็นฉากสตูดิโอดำที่ส่อง
// ด้วยริบบิ้นแสงน้ำเงินและแฟลร์เลนส์สีฟ้า — คู่นายแบบ-นางแบบผมขาวเงินในชุดดำ-ขาว ชิป
// คาสิโนน้ำเงินสลับเงิน ไพ่เอซดำ-เงิน และวงล้อขอบโครเมียม
// ⚠️ รอบนี้เป็น **สองโทนจริง: น้ำเงินไฟฟ้านำ เงินโครเมียมรอง** และ **ไม่มีทองที่ไหน
// เลย** — ถ้าเผลออยากใส่สีอุ่นเป็นฮิวที่สอง คำตอบคือเงินโครเมียม ไม่ใช่อำพัน
// กล่องนี้ไม่มีการ์ดครอบ มันวางสองคอลัมน์ลงบนพื้นเพจ **กรมเกือบดำ #00081f** (bg.json)
// ตรงๆ จึงเป็นจังหวะ "โปร่ง" ของหน้า คั่นหลังบล็อกเนื้อหาของบรีฟ — กล่องเนื้อหาอีกแปด
// ใบมีผิวและกรอบของตัวเองทั้งหมด ใบนี้จึงเป็นใบเดียวที่ไม่มีผิว
// ลำดับความลึก: #102a5e ยก / #0a1c42 กลาง / #040e26 จม / #00081f พื้น — ไม่มีชั้นไหน
// จมต่ำกว่าพื้นได้
// สองคอลัมน์ถูกแยกด้วยคู่ "แผ่นมืดกรอบน้ำเงิน vs แผ่นโครเมียมทึบ" ซึ่งตรงกับสองโทนของ
// โลโก้: ฝั่งซ้ายเป็นฝั่งน้ำเงิน ป้ายไอคอนเป็นแผ่นมืดไล่ผิวยก #102a5e → ผิวจม #040e26
// ในกรอบน้ำเงินแบรนด์ #0360f3 บนไอคอนฟ้าสว่าง #6ec8ff และป้ายคอลัมน์ซ้ายเป็นฟ้าสว่าง
// #6ec8ff (7.4:1) ส่วนฝั่งขวาเป็นฝั่งโครเมียม ป้ายไอคอนเป็นแผ่นเงินทึบไล่ #cfdcec →
// #9db4d4 บนหมึก #021026 (§2 ระบุว่านี่คือหมึกตัวเดียวที่วางบนพื้นสว่างได้ — ห้ามพลิก
// แผ่นโครเมียมไปใช้หมึกสว่าง) และป้ายคอลัมน์ขวาเป็นเงินโครเมียมสว่าง #cfdcec (10.6:1)
// — §2 ห้าม #0360f3 #0292fb #032dad #04186e #041a43 ถือตัวอักษรที่ไหนเลย ในไฟล์นี้ทั้ง
// ห้าค่าอยู่ที่ขอบ เส้นคั่น สันหัวข้อ และ **พื้น** ของแผ่นไอคอนเท่านั้น
// หัวข้อ docx (เมื่อมีการส่ง title มา) ไล่ เงินโครเมียมหม่น #9db4d4 → ฟ้าอ่อน #4fb4ff →
// ฟ้าสว่าง #6ec8ff ซึ่งไม่ซ้ำลำดับกับกล่องอื่นบนหน้าเดียวกันสักใบ สันหัวข้อไล่ เงิน
// โครเมียมสว่าง #cfdcec → ฟ้าสด #0292fb → น้ำเงินลึก #04186e เส้นคั่นเป็นน้ำเงินลึก
// #04186e ทั้งสองฝั่ง เนื้อความ #dde8f7 (= BRAND_TEXT) — 17.4:1 บนพื้นเพจ
//
// ไอคอนเริ่มต้นเป็น 🔐 / 🃏 — บรีฟรอบนี้เป็น **คาสิโน + กีฬา** (บาคาร่า · ไฮโล ·
// สล็อต · แทงบอล) ไม่ใช่เว็บสล็อตล้วน จึงไม่ใช้ 🎰 เป็นค่าตั้งต้น และไพ่มาจากบาคาร่า
// ซึ่งบรีฟเรียกว่าเกมไพ่ตรงๆ (LoginRtpSection ส่งไอคอนมาเองอยู่แล้ว ค่านี้คือกันหลง)
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — ไฟล์นี้เพิ่งถือชุด **ม่วงราชา-ทอง** มาทั้ง
// ไฟล์ (ม่วงแบรนด์นำ + ทองแบรนด์เป็นฮิวที่สอง + ม่วงลึกที่ขอบ + งาช้างอมม่วงเป็น
// เนื้อความ + หมึกม่วงเข้มบนแผ่นทอง) และก่อนนั้นเป็นชุดทองมังกร ชุดทองอำพันเสือ และ
// ชุดชมพูฮอตพิงก์-ทอง — ถูกถอดออกครบทุกค่า ไม่เหลือม่วง ไม่เหลือทอง ไม่เหลือชมพู
// ไม่เหลือเขียว ไม่เหลือส้ม/อำพัน และไม่เหลือแดงในไฟล์นี้แล้ว
// ⚠️ เงินโครเมียม #cfdcec / #9db4d4 ของรอบนี้ไม่ใช่เทาอมฟ้าของแบรนด์เงินโครเมียมรอบ
// ก่อนๆ และฟ้าสด #0292fb (R=2 G=146 B=251) ไม่ใช่ฟ้าของแบรนด์ "แตกดี168" (R=1 G=147
// B=251) — ให้เทียบเป็นตัวเลขทีละค่า ห้ามกะด้วยตา
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#04186e] pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#cfdcec] via-[#0292fb] to-[#04186e] shadow-[0_0_10px_rgba(2,146,251,0.6)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#9db4d4] via-[#4fb4ff] to-[#6ec8ff] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dde8f7]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#04186e] pb-3 text-xl leading-normal font-black tracking-widest text-[#6ec8ff] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#0360f3]/70 bg-gradient-to-br from-[#102a5e] to-[#040e26] text-sm text-[#6ec8ff] shadow-[0_5px_15px_rgba(0,0,0,0.7)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dde8f7]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#04186e] pb-3 text-xl leading-normal font-black tracking-widest text-[#cfdcec] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#032dad] bg-gradient-to-br from-[#cfdcec] to-[#9db4d4] text-sm text-[#021026] shadow-[0_5px_15px_rgba(2,146,251,0.4)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
