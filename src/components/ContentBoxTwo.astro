---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🔐", iconright = "🎰" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a game-list panel),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
// LoginRtpSection renders it without a title, which is why the page's heading
// inventory stops at the docx's own sections.
//
// Reached only through LoginRtpSection (a nested import), so a grep for
// "components/ContentBoxTwo.astro" in src/pages/ finds nothing — it is LIVE, not
// inventory, and has to carry the current brand's colours.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// HI59 (รอบฟ้า-ทองบนการ์ดสว่าง 2026-10-07, brand-spec §2): โลโก้รอบนี้เป็นสองวัสดุใน
// เวิร์ดมาร์กเดียว — ตัวอักษร "HI" เป็นฟ้าท้องฟ้า 3 มิติ (#0283e2 / #0393ec) ติดกับ
// ตัวเลข "59" ทองเงา (#fdbc04 / #fecc04) ในวงแหวนทองโค้งบน-ฟ้าโค้งล่าง สองคอลัมน์ของ
// กล่องนี้จึงถูกแยกด้วยคู่วัสดุนั้นตรงๆ ไม่ใช่ด้วยความสว่างของสีเดียว — ฝั่งซ้ายเป็นฟ้า
// ป้ายไอคอนไล่ฟ้าลึก #065a9c → #044b80 → #033f70 บนหมึกสว่าง #eaf5ff (พื้นฟ้าเข้มต้อง
// ใช้หมึกสว่างเสมอ) ป้ายคอลัมน์เป็นฟ้าลึก #065a9c ส่วนฝั่งขวาเป็นทอง ป้ายไอคอนไล่ทองอ่อน
// #ffe27a → ทองแบรนด์ #fdbc04 → ทองเข้ม #c88a02 บนหมึกกรมท่า #04203f (พื้นทองต้องใช้
// หมึกเข้มเสมอ ห้ามขาว/ครีม) ป้ายคอลัมน์เป็นทองหมึก #8a6102
// หัวข้อ docx (เมื่อมีการส่ง title มา) ไล่ฟ้าลึก → ทองเข้ม → กรมท่าหัวข้อ #06355f
// เส้นคั่นเป็นฟ้าขอบการ์ด #9ecbf2 ทั้งสองฝั่ง เนื้อความ #0d2744 (= BRAND_TEXT)
//
// ไอคอนเริ่มต้นเป็น 🔐 / 🎰 — รอบนี้เป็นเว็บสล็อต ไม่ใช่เว็บหวย
// (LoginRtpSection ส่งไอคอนมาเองอยู่แล้ว ค่านี้คือกันหลงเท่านั้น)
//
// ชุดแดงแบรนด์+เงินโครเมียมของ หวยดีใจ ที่เคยค้างในไฟล์นี้ (#dc0409 #f5363d #8e0206
// #eef0f4 #c3c7d1 #8d93a1 #f3c54e #4b0205 #0d0407 #edeaf0 rgba(220,4,9,…)
// rgba(195,199,209,…)) ออกครบทุกจุดแล้ว — รอบนี้เป็นการพลิกจากการ์ดมืดเป็นการ์ดสว่าง
// ไม่ใช่การเปลี่ยนเบอร์สีบนโครงเดิม
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#9ecbf2] pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#0a84e0] via-[#fdbc04] to-[#065a9c] shadow-[0_0_10px_rgba(10,132,224,0.45)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#065a9c] via-[#c88a02] to-[#06355f] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#0d2744]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#9ecbf2] pb-3 text-xl leading-normal font-black tracking-widest text-[#065a9c] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#065a9c]/70 bg-gradient-to-br from-[#065a9c] via-[#044b80] to-[#033f70] text-sm text-[#eaf5ff] shadow-[0_5px_15px_rgba(6,90,156,0.40)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#0d2744]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#9ecbf2] pb-3 text-xl leading-normal font-black tracking-widest text-[#8a6102] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#c88a02]/70 bg-gradient-to-br from-[#ffe27a] via-[#fdbc04] to-[#c88a02] text-sm text-[#04203f] shadow-[0_5px_15px_rgba(200,138,2,0.40)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
