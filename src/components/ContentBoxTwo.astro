---
export interface Props {
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { titleleft, titleright, label } = Astro.props;

// This box carries chrome (a login widget, a service list), never docx article
// content, so both column labels render as <p> and the section gets its
// accessible name from aria-label instead of a heading.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e0d7d8]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#e01020]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#ff5a63] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#e01020]/50 bg-gradient-to-br from-[#ff5a63] via-[#e01020] to-[#4b0304] text-sm text-[#1a0304] shadow-[0_5px_15px_rgba(224,16,32,0.32)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e0d7d8]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#cbd0d8]/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#f4eff0] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#8f959f]/60 bg-gradient-to-br from-[#f4eff0] via-[#cbd0d8] to-[#8f959f] text-sm text-[#0a0102] shadow-[0_5px_15px_rgba(244,239,240,0.28)]">
              🎰
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
