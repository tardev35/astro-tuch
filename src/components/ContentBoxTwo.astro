---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a market list),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// 888PARUAY (รอบทอง-เขียวเข้ม-แดง 2026-09-24): โลโก้แบรนด์นี้เป็นเลข 888 สีเขียวสด
// ทับคำว่า PARUAY สีแดง อยู่ในวงแหวนทอง สองครึ่งของกล่องจึงแยกกันด้วยคู่สีนั้นจริงๆ
// ป้ายไอคอนฝั่งซ้ายไล่จากทองสว่าง #fff6ae ลงทองหลัก #fcdc2b ไปหาทองลึก #a87d0c
// ตัวอักษรบนป้ายใช้สีพื้นเพจ #07130a ส่วนฝั่งขวาไล่จากเขียวสด #1fae1c ลงแดง
// #cf1111 ไปจบที่แดงเข้ม #8a0303 บนตัวอักษรทองสว่าง เส้นคั่นเป็นทองลึกกับพื้นยก
// #143a1c เนื้อความ #e8e4c6 (BRAND_TEXT) — ชุดแดง-ทอง-เงินโครเมียมของแบรนด์ก่อนหน้า
// (#fadc64 #fdf3b4 #e0b03a #f3f6fa #e01f26 #a40304 #9c6a12 #2a0b0e #1a0709
// #120406 #f0ddc4) ออกทั้งหมด
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#a87d0c]/45 pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fff6ae] via-[#fcdc2b] to-[#cf1111] shadow-[0_0_10px_rgba(252,220,43,0.5)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#1fae1c] via-[#fff6ae] to-[#cf1111] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e8e4c6]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#a87d0c]/45 pb-3 text-xl leading-normal font-black tracking-widest text-[#fff6ae] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#fcdc2b]/70 bg-gradient-to-br from-[#fff6ae] via-[#fcdc2b] to-[#a87d0c] text-sm text-[#07130a] shadow-[0_5px_15px_rgba(252,220,43,0.4)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e8e4c6]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#143a1c] pb-3 text-xl leading-normal font-black tracking-widest text-[#fffdf0] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#cf1111]/60 bg-gradient-to-br from-[#1fae1c] via-[#cf1111] to-[#8a0303] text-sm text-[#fff6ae] shadow-[0_5px_15px_rgba(207,17,17,0.35)]">
              🗓️
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
