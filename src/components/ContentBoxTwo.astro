---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🔐", iconright = "🎰" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a game-list panel),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
// LoginRtpSection renders it without a title, which is why the page's heading
// inventory stops at the docx's own sections.
//
// Reached only through LoginRtpSection (a nested import), so a grep for
// "components/ContentBoxTwo.astro" in src/pages/ finds nothing — it is LIVE, not
// inventory, and has to carry the current brand's colours.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// UOK365 (รอบทองเมทัลลิก-เงินโครเมียม บนน้ำตาลเกือบดำ 2026-10-07, brand-spec §2):
// โลโก้รอบนี้เป็นสองโลหะในเวิร์ดมาร์กเดียว — คำว่า "UOK" เป็นทองเมทัลลิก (vivid อันดับ 1
// #a46b25 ใช้เป็นทองแบรนด์ #c8912f) ติดกับตัวเลข "365" เงินโครเมียม #d8dbe0 ในวงแหวน
// ทอง สองคอลัมน์ของกล่องนี้จึงถูกแยกด้วยคู่วัสดุนั้นตรงๆ ไม่ใช่ด้วยความสว่างของสีเดียว —
// ฝั่งซ้ายเป็นฝั่งทอง ป้ายไอคอนไล่ทองอ่อน #f5d98a → ทองแบรนด์ #c8912f → ทองลึก #6d4412
// บนหมึก #191005 (พื้นทองใช้หมึกเข้มได้สีเดียวตาม §2) ป้ายคอลัมน์เป็นทองอ่อน ส่วนฝั่งขวา
// เป็นฝั่งเงิน ป้ายไอคอนเป็นปุ่มรอง ไล่ผิวยก #191108 → ผิวลึกสุด #070504 ขอบเงินโปร่ง
// บนหมึกเนื้อความ #ece1cc ป้ายคอลัมน์เป็นเงินโครเมียม #d8dbe0
// หัวข้อ docx (เมื่อมีการส่ง title มา) ไล่ทองอ่อน → เงินโครเมียม → ทองแบรนด์
// เส้นคั่นเป็นทองลึก #6d4412 ทั้งสองฝั่ง เนื้อความ #ece1cc (= BRAND_TEXT)
//
// ไอคอนเริ่มต้นเป็น 🔐 / 🎰 — รอบนี้เป็นเว็บสล็อต ไม่ใช่เว็บหวย
// (LoginRtpSection ส่งไอคอนมาเองอยู่แล้ว ค่านี้คือกันหลงเท่านั้น)
//
// ชุดเขียวนีออน-เงินของ BOOM369 ที่เคยค้างในไฟล์นี้ (#42fb5a #04ab3a #036b26 #03150a
// #0b231b #041109 #cfe9d7 #dadcdc #f3c44a rgba(66,251,90,…)) ออกครบทุกจุดแล้ว
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#6d4412] pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f5d98a] via-[#c8912f] to-[#6d4412] shadow-[0_0_10px_rgba(200,145,47,0.55)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#f5d98a] via-[#d8dbe0] to-[#c8912f] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece1cc]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#6d4412] pb-3 text-xl leading-normal font-black tracking-widest text-[#f5d98a] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#6d4412] bg-gradient-to-br from-[#f5d98a] via-[#c8912f] to-[#6d4412] text-sm text-[#191005] shadow-[0_5px_15px_rgba(200,145,47,0.45)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece1cc]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#6d4412] pb-3 text-xl leading-normal font-black tracking-widest text-[#d8dbe0] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#d8dbe0]/45 bg-gradient-to-br from-[#191108] to-[#070504] text-sm text-[#ece1cc] shadow-[0_0_12px_rgba(216,219,224,0.18)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
