---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🔐", iconright = "🎟️" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a lottery-list
// panel), never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
// LoginRtpSection renders it without a title, which is why the page's heading
// inventory stops at the docx's own sections.
//
// Reached only through LoginRtpSection (a nested import), so a grep for
// "components/ContentBoxTwo.astro" in src/pages/ finds nothing — it is LIVE, not
// inventory, and has to carry the current brand's colours.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// หวย24 (รอบแดงแบรนด์ + ทอง บนดำอมแดง 2026-10-04): brand-spec §2 งานอาร์ตรอบนี้มี
// คู่สีจริงสองสี — แดงแบรนด์ #d20a0a (vivid ของ logo.webp คือ #c40303 และวงกลม 24
// ในโลโก้เป็นแดง) กับทองแบรนด์ #f5c33b (ตัวอักษร หวย24 บนแบนเนอร์เป็นทองโลหะ
// พาดอยู่บนผ้าไหมแดง) สองคอลัมน์ของกล่องนี้จึงถูกแยกด้วยคู่นั้นตรงๆ ไม่ใช่ด้วย
// ความสว่างของสีเดียว — ฝั่งซ้ายเป็นทอง ป้ายไอคอนไล่ทองสว่าง #ffd45e → ทองแบรนด์
// → ทองลึก #a9761a บนหมึกเข้ม #190505 (พื้นทองสว่างต้องใช้หมึกเข้มเสมอ) ป้าย
// คอลัมน์เป็นทองแบรนด์ ส่วนฝั่งขวาเป็นแดง ป้ายไอคอนไล่แดงสว่าง #ff3b3b → แดง
// แบรนด์ → แดงลึก #7a0505 บนหมึกครีม #fff1e8 (พื้นแดงเข้มต้องใช้หมึกสว่าง) ป้าย
// คอลัมน์เป็นแดงสว่าง หัวข้อ docx (เมื่อมีการส่ง title มา) ไล่ทองสว่าง → ทองแบรนด์
// → แดงแบรนด์ เส้นคั่นเป็นเส้นจาง #3d0a0a ทั้งสองฝั่ง
// เนื้อความ #f7e2d6 (= BRAND_TEXT) glow เป็น rgba(210,10,10,…) / rgba(245,195,59,…)
//
// ไอคอนเริ่มต้นเป็น 🔐 / 🎟️ — รอบนี้เป็นเว็บหวยล้วน ไม่ใช่คาสิโน
// (LoginRtpSection ส่งไอคอนมาเองอยู่แล้ว ค่านี้คือกันหลงเท่านั้น)
//
// ชุดทองโลหะ + ครีมอมพีชของ หวยคิง ที่เคยค้างในไฟล์นี้ (#cd9a2c #fdeb7c #ab7314
// #fcd4c3 #fce2d4 #5c3f12 #120a02 #f5e7c8 rgba(205,154,44,…) rgba(252,212,195,…))
// ออกครบทุกจุดแล้ว — รอบนี้สีหลักคือแดง ทองถูกลดบทบาทลงเป็นสีรอง
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#3d0a0a] pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffd45e] via-[#f5c33b] to-[#d20a0a] shadow-[0_0_10px_rgba(245,195,59,0.5)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#ffd45e] via-[#f5c33b] to-[#d20a0a] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e2d6]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#3d0a0a] pb-3 text-xl leading-normal font-black tracking-widest text-[#f5c33b] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#ffd45e]/70 bg-gradient-to-br from-[#ffd45e] via-[#f5c33b] to-[#a9761a] text-sm text-[#190505] shadow-[0_5px_15px_rgba(245,195,59,0.40)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e2d6]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#3d0a0a] pb-3 text-xl leading-normal font-black tracking-widest text-[#ff3b3b] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#ff3b3b]/70 bg-gradient-to-br from-[#ff3b3b] via-[#d20a0a] to-[#7a0505] text-sm text-[#fff1e8] shadow-[0_5px_15px_rgba(210,10,10,0.45)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
