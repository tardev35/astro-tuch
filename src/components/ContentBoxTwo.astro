---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🔐", iconright = "🎰" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a game-category
// panel), never docx article content, so both column labels render as <p> and
// the section gets its accessible name from aria-label instead of a heading.
// With a `title` the heading itself names the region, so the aria-label is
// dropped. LoginRtpSection renders it without a title this round, which is why
// the page's heading inventory stops at the docx's own sections.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// GOT777 (รอบทอง-แดงเลือดหมู-ดำ 2026-09-29): เวิร์ดมาร์กเขียน GOT เป็นทองเมทัลลิก
// #f5c518 มีอัญมณีแดงฝังกลางตัว O แล้วปิดด้วยเลข 777 สีแดงเลือดหมู #d21622 ขอบทอง บน
// งานอาร์ตพื้นดำที่มีเหรียญทอง ชิปคาสิโนดำแดง และวงล้อรูเล็ต สองคอลัมน์ของกล่องนี้จึงถูก
// แยกด้วยคู่ทอง/แดงนั้นตรงๆ ตามลำดับบนโลโก้ — ฝั่งซ้ายเป็นทองเต็มใบ ป้ายไอคอนไล่จาก
// ทองอ่อน #ffe9a8 ลงทองแบรนด์ ไปหาทองลึก #96690f และตัวอักษรบนป้ายทองเป็นหมึกเข้ม
// #0a0503 (12.7:1) ตามกฎคอนทราสต์ ส่วนฝั่งขวาเป็นแดงเต็มใบ ป้ายไอคอนไล่แดงแบรนด์ →
// แดงลึก #7b0304 → แดงเข้มสุด #4c0301 และตัวอักษรบนพื้นแดงเป็นขาว — ห้ามใช้หมึกเข้ม
// บนแดง หัวข้อ docx (เมื่อมีการส่ง title มา) ไล่ทองอ่อน → ทองแบรนด์ → แดงแบรนด์ เส้นคั่น
// เป็นแดงลึกทั้งสองฝั่ง เนื้อความ #ece0cb (BRAND_TEXT) — ชุดแดง-ทองของ LOTTOPLUS
// (#dc020e #ff2d38 #6b0207 #f3c623 #fde79a #8a6a0a #fff4f4 #f0e2e2 #1a0203)
// ออกทั้งหมด
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#7b0304] pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe9a8] via-[#f5c518] to-[#d21622] shadow-[0_0_10px_rgba(245,197,24,0.5)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#ffe9a8] via-[#f5c518] to-[#d21622] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece0cb]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#7b0304] pb-3 text-xl leading-normal font-black tracking-widest text-[#ffe9a8] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#f5c518]/70 bg-gradient-to-br from-[#ffe9a8] via-[#f5c518] to-[#96690f] text-sm text-[#0a0503] shadow-[0_5px_15px_rgba(245,197,24,0.4)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece0cb]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#7b0304] pb-3 text-xl leading-normal font-black tracking-widest text-[#d21622] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#d21622]/70 bg-gradient-to-br from-[#d21622] via-[#7b0304] to-[#4c0301] text-sm text-white shadow-[0_5px_15px_rgba(210,22,34,0.4)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
