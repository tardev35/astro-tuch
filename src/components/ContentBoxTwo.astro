---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a service list),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// HENG35 (รอบดำ-ทอง 2026-09-21): แบรนด์นี้มีสีเดียว สองครึ่งจึงแยกกันด้วย
// "ความสว่าง" ไม่ใช่ด้วยสีที่สอง — ป้ายไอคอนฝั่งซ้ายไล่จากทองสว่าง #fefac4 ลง
// ทองหลัก #ecc55c ไปหาบรอนซ์ #a3732c ตัวอักษรบนป้ายทองใช้สีบนทอง #0d0b0a
// ส่วนฝั่งขวาไล่จากทองอ่อน #ffdf8a ลงบรอนซ์ไปหาบรอนซ์เข้ม #5e4418 ตัวอักษรบน
// ป้ายนั้นใช้สีเนื้อความ #ece1cb เส้นคั่นและกรอบเป็นบรอนซ์เข้มกับทองหลัก —
// ม่วง-ทองของรอบก่อนหายไปทั้งหมด
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#ecc55c]/40 pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fefac4] via-[#ecc55c] to-[#a3732c] shadow-[0_0_10px_rgba(236,197,92,0.55)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#fefac4] via-[#ecc55c] to-[#ffdf8a] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece1cb]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#ecc55c]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#ffdf8a] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#ecc55c]/70 bg-gradient-to-br from-[#fefac4] via-[#ecc55c] to-[#a3732c] text-sm text-[#0d0b0a] shadow-[0_5px_15px_rgba(236,197,92,0.35)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece1cb]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#5e4418] pb-3 text-xl leading-normal font-black tracking-widest text-[#ece1cb] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#a3732c]/70 bg-gradient-to-br from-[#ffdf8a] via-[#a3732c] to-[#5e4418] text-sm text-[#0d0b0a] shadow-[0_5px_15px_rgba(163,115,44,0.30)]">
              🛡️
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
