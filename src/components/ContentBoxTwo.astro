---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a service list),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Left column badge gold, right column badge brushed silver — the MEPAY77
// wordmark's own split, so the two halves are told apart by hue, not only by
// position.
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#a3701c]/45 pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fff6e0] via-[#dfe3e8] to-[#a08a5c] shadow-[0_0_10px_rgba(205,185,138,0.55)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#fdcc5c] via-[#fff6e0] to-[#dfe3e8] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f1e5cd]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#a3701c]/45 pb-3 text-xl leading-normal font-black tracking-widest text-[#fdcc5c] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#a3701c]/60 bg-gradient-to-br from-[#fdcc5c] via-[#f2ae35] to-[#a3701c] text-sm text-[#130c01] shadow-[0_5px_15px_rgba(163,112,28,0.30)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f1e5cd]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#aab0b8]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#dfe3e8] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#aab0b8]/60 bg-gradient-to-br from-[#fff6e0] via-[#dfe3e8] to-[#aab0b8] text-sm text-[#130c01] shadow-[0_5px_15px_rgba(223,227,232,0.35)]">
              📋
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
