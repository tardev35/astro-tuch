---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🔐", iconright = "🎰" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a channel panel),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
// LoginRtpSection renders it without a title, which is why the page's heading
// inventory stops at the docx's own sections (brand-spec §5: h1×1 h2×5 h3×2).
//
// Reached ONLY through LoginRtpSection this round (index.astro does not import
// it directly — the docx's two-column section went to ContentBoxTwoPremium, and
// the rest of the shape mix is in brand-spec §3).
// A grep for "components/ContentBoxTwo.astro" in src/pages/ therefore finds
// nothing, and that does NOT mean it is inventory: match the bare filename
// instead. It is LIVE and has to carry this brand's colours.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// ถอนชัวร์168 (รอบ **ชมพูบับเบิลกัมนำ · ทองเนยเป็นฮิวที่สอง · พลัมเข้มไม่เคยถือ
// ตัวอักษร · บนดำสนิท** 2026-10-18) — พาเลตต์ตาม brand-spec §2
// โลโก้: แมวการ์ตูนขาว-ชมพูหน้ายิ้มหลับตา นั่งคู่มือถือจอชมพูที่มีลูกศรดาวน์โหลดและ
// ปึกแบงก์ชมพู เหนือคำว่า "ถอน" ตัวอักษรไทยหนาสามมิติ **ทองเนย** ตัดขอบชมพู ต่อด้วย
// "ชัวร์168" **ชมพูบับเบิลกัม** ตัดขอบทอง ล้อมด้วยหัวใจชมพูและประกายดาวทอง
// ⚠️ **ฮิวนำของรอบนี้คือชมพูบับเบิลกัม #fa63b9 และทองเนย #ffd84d เป็นตัวรอง ซึ่ง
// กลับทางจากรอบที่แล้วพอดี** (มีโชค168 ทองนำ fcd434 ชมพูบานเย็น f5469f รอง) อาร์ตเวิร์ก
// รอบนี้เป็นชมพูทั้งฉาก — ริบบิ้น หัวใจ แบงก์ มือถือ ชุด — ทองเหลือแค่เหรียญกับขอบ
// ⚠️ bg.json = {"mode":"color","color":"#000000"} → พื้นเพจเป็น **ดำสนิท** ลำดับ
// ความลึก: #2b0f20 ยก / #1a0914 กลาง / #0d040a จม / #000000 พื้น
// กล่องนี้ไม่มีการ์ดครอบ มันวางสองคอลัมน์ลงบนพื้นเพจดำสนิทตรงๆ จึงเป็นจังหวะ
// "โปร่ง" ของหน้า คั่นหลังบล็อกเนื้อหาของบรีฟ — กล่องเนื้อหาใบอื่นมีผิวและกรอบของ
// ตัวเองทั้งหมด
// สองคอลัมน์ถูกแยกด้วยคู่ "แผ่นถมสว่าง vs แผ่นมืดกรอบทอง" และเรียงตามลำดับนำของ
// รอบนี้: **ฝั่งซ้ายเป็นฝั่งชมพู** ป้ายไอคอนเป็นแผ่นถมไล่ #ffb3de → #fa63b9 บนหมึก
// #2a0617 (§2 ระบุว่านี่คือหมึกตัวเดียวที่วางบนพื้นถมชมพู/ทองได้ — 7.0:1 บน #fa63b9
// และสูงกว่านั้นบน #ffb3de **ห้ามพลิกแผ่นสว่างไปใช้หมึกสว่าง**) ป้ายคอลัมน์ซ้ายเป็น
// ชมพูบับเบิลกัม #fa63b9 (6.6:1 และเป็น text-xl font-black จึงเป็น large text)
// ส่วน **ฝั่งขวาเป็นฝั่งทอง** ป้ายไอคอนเป็นแผ่นมืดไล่ผิวยก #2b0f20 → ผิวจม #0d040a
// ในกรอบทองลึก #6b4708 บนไอคอนทองเนย #ffd84d และป้ายคอลัมน์ขวาเป็นทองเนย (12.7:1)
// §2 ห้าม #6d0b3f (1.5:1) และ #6b4708 (2.1:1) ถือตัวอักษรที่ไหนเลย — ในไฟล์นี้ทั้งสอง
// ค่าอยู่ที่ขอบ เส้นคั่น และสันหัวข้อเท่านั้น
// หัวข้อ docx (เมื่อมีการส่ง title มา) ไล่ ชมพูบับเบิลกัม #fa63b9 → ชมพูอ่อน #ffb3de
// → ทองเนย #ffd84d ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุก
// สต็อปจึงต้องถือตัวอักษรได้ตาม §2 (6.6 / 10.7 / 12.7) สันหัวข้อไล่ #fa63b9 →
// #ffb3de → ทองลึก #6b4708 (ซึ่งเป็น **พื้น** ไม่ใช่ตัวอักษร จึงใช้ได้)
// เส้นคั่นเป็นชมพูบับเบิลกัมฝั่งซ้าย และทองลึก #6b4708 ฝั่งขวา
// เนื้อความ #fdeaf5 (= BRAND_TEXT) — 18.3:1 บนดำสนิท
// glow rgba ใช้ได้ 4 ชุดตาม §2: rgba(250,99,185,α) · rgba(255,216,77,α) ·
// rgba(255,179,222,α) · rgba(109,11,63,α) — ไฟล์นี้ใช้สองชุดแรก
//
// ไอคอนเริ่มต้นเป็น 🔐 / 🎰 — บรีฟรอบนี้เป็น **เว็บสล็อตล้วน** ไม่ใช่คาสิโนและไม่ใช่
// หวย จึงไม่ใช้ไพ่/ลูกเต๋า/ลูกบอลเป็นค่าตั้งต้น (LoginRtpSection ส่งไอคอนมาเองอยู่
// แล้ว ค่านี้คือกันหลง)
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้มีสองชั้น: ชมพู และ ทอง**
// เพราะรอบที่แล้วก็ทอง+ชมพูบนดำเหมือนกันทุกบทบาท "เจอชมพูอยู่แล้ว" หรือ "เจอทอง
// อยู่แล้ว" จึงไม่พิสูจน์อะไรเลย ชุดที่เพิ่งอยู่ในไฟล์นี้คือมีโชค168 (fcd434 ffeaa0
// f5469f ff8dc6 8c0f52 7a5508 1a0612 f6e4ee 24101c 160a12 0b0509) ก่อนหน้านั้นคือ
// ขวัญใจ168 (f7c92b ffe6a3 f2bba5 c98a74 b3121b 5a0a0e 8a5f12 eadfce 140c06 241509
// 160d06 0b0603) รับตัง168 (f0b429 ffdc8c d30304 ff6b6e a00203 4a0202 9a6c0c cfd9e6
// f5ece0 2b100f 200a09 140505 1a0505) สมหวัง168 (fa0513 ffadaf ff5a5f e3b23c ffe5a8
// 8a6210 b90203 8c0204 5b0203 3c0303 f4ecea 2c1413 1f0d0c 140706 290f0f) และ TKB55
// (fb131b ff8a8f ff4d55 e9eef4 aeb9c6 f2e4e5 2a0d0f 1a0708 0d0304) — ถอดออกครบแล้ว
// ⚠️ ชมพูรอบนี้คือ **#fa63b9 / #ffb3de** (R=250 G=99 B=185) ไม่ใช่ f5469f / ff8dc6
// ของมีโชค168 ซึ่งเป็นตระกูลชมพูเดียวกันคนละค่า และไม่ใช่ f41571 / ff5ca8 ของ
// PUNPRO168
// ⚠️ ทองรอบนี้คือ **#ffd84d** (R=255 G=216 B=77) ไม่ใช่ fcd434 (มีโชค168) f7c92b
// (ขวัญใจ168) f0b429 (รับตัง168) e3b23c (สมหวัง168) dfa310 e5a81b e2b33f fad354
// 8a6210 หรือ 9a6c0c
// ⚠️ พื้นเพจรอบนี้คือ **#000000** เหมือนรอบก่อน แต่ผิวทั้งสามชั้นเป็นโทนพลัมชมพู
// (#2b0f20 / #1a0914 / #0d040a) ไม่ใช่โทนพลัมของรอบก่อน (24101c / 160a12 / 0b0509)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีน้ำเงิน ฟ้า/ไซแอน ม่วง/ไวโอเลต เขียว ส้ม เงิน/โครเมียม โรสโกลด์
// (f2bba5/c98a74) และแดงชาด (b3121b)** — cfd9e6 e9eef4 aeb9c6 cfdcec 9db4d4 ต้อง
// ไม่เหลืออยู่ในไฟล์นี้
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#6b4708] pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fa63b9] via-[#ffb3de] to-[#6b4708] shadow-[0_0_10px_rgba(250,99,185,0.6)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#fa63b9] via-[#ffb3de] to-[#ffd84d] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fdeaf5]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#fa63b9]/60 pb-3 text-xl leading-normal font-black tracking-widest text-[#fa63b9] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#6d0b3f] bg-gradient-to-br from-[#ffb3de] to-[#fa63b9] text-sm text-[#2a0617] shadow-[0_5px_15px_rgba(250,99,185,0.45)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fdeaf5]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#6b4708] pb-3 text-xl leading-normal font-black tracking-widest text-[#ffd84d] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#6b4708] bg-gradient-to-br from-[#2b0f20] to-[#0d040a] text-sm text-[#ffd84d] shadow-[0_5px_15px_rgba(255,216,77,0.3)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
