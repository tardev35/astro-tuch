---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🔐", iconright = "🐯" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a channel panel),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
// LoginRtpSection renders it without a title, which is why the page's heading
// inventory stops at the docx's own sections.
//
// Reached ONLY through LoginRtpSection this round (index.astro does not import
// it directly — the docx's two-column sections went to ContentBoxTwoNeumorphism
// and ContentBoxTwoCyberCut, and its three-column one to ContentBox3ThreePremium).
// A grep for "components/ContentBoxTwo.astro" in src/pages/ therefore finds
// nothing, and that does NOT mean it is inventory: match the bare filename
// instead. It is LIVE and has to carry this brand's colours.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// TIGERWIN369 (รอบทองอำพันเสือบนดำสนิท 2026-10-11, brand-spec §2):
// โลโก้เป็นเหรียญตรากลมดำ-ทอง กลางเหรียญเป็นหัวเสือขนทองอำพันสวมมงกุฎทองเล็ก รอบนอก
// เป็นวงแหวนดำประดับสัญลักษณ์ไพ่ ♠♣♦♥ ซ้ายเป็นไพ่เอซทองสองใบกางออก ขวาเป็นกองชิป
// คาสิโนดำ-ทอง ใต้ลงมาเป็น TIGERWIN369 ตัวหนาสามมิติสีทอง
// ⚠️ รอบนี้ **ไม่ใช่คู่สองฮิวแบบ UFA324** (ที่เป็น "ทองแชมเปี้ยน-เงินโครเมียม" คือ
// ทองอุ่นคู่โลหะเย็น) รอบนี้เป็น **ทองล้วนสองระดับ ไม่มีเงิน ไม่มีเทา ไม่มีฮิวเย็น
// เลยทั้งเว็บ** — ทองอำพันเสือ #d98324 นำ และทองสว่าง #f7b733 เป็นระดับที่สอง
// กล่องนี้ไม่มีการ์ดครอบ มันวางสองคอลัมน์ลงบนพื้นเพจ **ดำสนิท #000000** ตรงๆ จึงเป็น
// จังหวะ "โปร่ง" ของหน้า คั่นหลังบล็อกเนื้อหาของบรีฟทั้งแปดส่วน
// ⚠️ พื้นเพจรอบนี้ดำสนิท จึงไม่มีชั้นไหนจมต่ำกว่าพื้นได้ ผิวจม #0f0903 คือชั้นที่ลึก
// ที่สุดที่ใช้ได้ และยังสว่างกว่าพื้น
// สองคอลัมน์ถูกแยกด้วยคู่ "แผ่นทองสว่างทึบ vs แผ่นมืดกรอบอำพัน" (ไม่ใช่ "ทอง vs เงิน"
// ของรอบก่อน เพราะรอบนี้ไม่มีเงิน): ฝั่งซ้ายเป็นแผ่นทองไล่ทองซีด #ffd98a → ทองสว่าง
// #f7b733 → ทองอำพัน #d98324 บนหมึกดำอมทอง #1a0d02 (§2 ระบุว่านี่คือหมึกตัวเดียวที่
// วางบนพื้นทองได้ ได้ 6.6:1 บนพื้น #d98324 — ห้ามไล่ลงไปถึง #8a5214 ใต้ตัวอักษร และ
// ห้ามพลิกแผ่นทองไปใช้หมึกสว่าง) ป้ายคอลัมน์ซ้ายเป็นทองอำพัน ส่วนฝั่งขวาเป็นแผ่นมืด
// ทึบ ไล่อำพันลึกสุด #4a2a08 → ผิวจม #0f0903 ในกรอบทองอำพันบนไอคอนทองสว่าง #f7b733
// ป้ายคอลัมน์ขวาเป็นทองสว่าง #f7b733 — §2 ห้าม #8a5214 / #4a2a08 ถือตัวอักษรที่ไหนเลย
// หัวข้อ docx (เมื่อมีการส่ง title มา) ไล่ครีมหม่น #e3cfae → ทองสว่าง #f7b733 → ทอง
// อำพัน #d98324 เส้นคั่นเป็นอำพันลึกสุด #4a2a08 ทั้งสองฝั่ง สันหัวข้อไล่ทองสว่าง →
// ทองอำพัน → อำพันลึกสุด เนื้อความ #f7e4c0 (= BRAND_TEXT) — 16.8:1 บนพื้นเพจดำสนิท
//
// ไอคอนเริ่มต้นเป็น 🔐 / 🐯 — รอบนี้เป็น "เกมคาสิโนรวม" (บาคาร่า สล็อต บอลออนไลน์
// ไฮโล ยิงปลา) ไม่ใช่เว็บกีฬาล้วนและไม่ใช่เว็บหวย เสือมาจากโลโก้โดยตรง และ 🏆 ของ
// รอบ UFA324 ถูกถอดออกเพราะดรอปนี้ไม่มีถ้วยรางวัลเลยสักไฟล์
// (LoginRtpSection ส่งไอคอนมาเองอยู่แล้ว ค่านี้คือกันหลง)
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — รอบนี้เป็นทองรอบที่แปดในสิบรอบ: ชุดทอง
// แชมเปี้ยน-เงินโครเมียมของ UFA324 ที่เคยค้างในไฟล์นี้ (#e5a81b #b9c2cc #231c0e
// #17130a #0d0b06 #f0e8d4 #ffcf5e #ffe08a #7d5a07 #43300a #464f5a #140d01 #f2f5f9
// #8792a0 #bb8410) ชุดชมพูฮอต-ทองของ FAH999 (#ff3fa4 #ff6cbb #ffd1ea #e8b9d4 #fde8f3
// #f5c53d #9c6f08 #b3006a #7a0046 #4d002b #4a0b42 #3a0534 #2e002c #210220 #ffe49a)
// ชุดทองเป็ด-ส้มอำพันของ DUCK1688 (#f3bb34 #fde464 #c8901a #8a5f08 #5c3f04 #f58b2a
// #ffc98a #a3510c #1a1203 #f6ecd9 #1f1709 #171106 #0d0903) ชุดทองอวกาศ-เงินโครเมียม
// ของ NAZA168 (#fbc134 #ffe87a #cf9a18 #96690a #6b4a05 #eef2f8 #cfd6e3 #3f4859
// #fdf3df #4e3406 #432b03 #382400 #241700 #231500) และชุดทอง-แดงของ FLASH877 (#f5c518
// #ffdd73 #96690f #d21622) ออกครบทุกจุดแล้ว
// ⚠️ "มีทองอยู่แล้ว" ไม่พิสูจน์อะไรเลย — #e5a81b (G=168) #f5c53d (G=197) #fbc134
// (G=193) #f3bb34 (G=187) ไม่ใช่ #d98324 (G=131) และ #140d01 ของรอบก่อนไม่ใช่ #1a0d02
// ⚠️ **รอบนี้ไม่มีเงิน/เทาเลย** #b9c2cc #f2f5f9 #8792a0 #464f5a #cfd6e3 #eef2f8
// #3f4859 ต้องไม่เหลืออยู่ในไฟล์นี้
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#4a2a08] pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f7b733] via-[#d98324] to-[#4a2a08] shadow-[0_0_10px_rgba(217,131,36,0.6)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#e3cfae] via-[#f7b733] to-[#d98324] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e4c0]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#4a2a08] pb-3 text-xl leading-normal font-black tracking-widest text-[#d98324] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#8a5214] bg-gradient-to-br from-[#ffd98a] via-[#f7b733] to-[#d98324] text-sm text-[#1a0d02] shadow-[0_5px_15px_rgba(217,131,36,0.4)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e4c0]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#4a2a08] pb-3 text-xl leading-normal font-black tracking-widest text-[#f7b733] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#d98324]/60 bg-gradient-to-br from-[#4a2a08] to-[#0f0903] text-sm text-[#f7b733] shadow-[0_5px_15px_rgba(0,0,0,0.7)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
