---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a game list),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// THE88 (รอบแดง-ทอง 2026-09-23): โลโก้แบรนด์นี้เป็นตัวอักษร THE สีแดงเงาขอบทอง
// คู่กับเลข 88 สีครีมขอบทอง สองครึ่งของกล่องจึงแยกกันด้วยคู่สีนั้นจริงๆ ป้ายไอคอน
// ฝั่งซ้ายไล่จากแดงสด #dd0503 ลงแดงแบรนด์ #a40201 ไปหาแดงเข้ม #6b0302 ตัวอักษรบน
// ป้ายใช้สีพื้นเพจ #1c0504 ส่วนฝั่งขวาไล่จากทองอ่อน #ffe7a6 ลงทอง #f2c14e ไปหาทอง
// ลึก #8a6524 เส้นคั่นเป็นแดงแบรนด์กับแดงเข้ม — ชมพูมาเจนตา-ทองของ WY88 ออกหมด
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#a40201]/40 pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#dd0503] via-[#a40201] to-[#6b0302] shadow-[0_0_10px_rgba(164,2,1,0.45)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#ffe7a6] via-[#f2c14e] to-[#dd0503] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e3dd]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#a40201]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#ffe7a6] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#a40201]/70 bg-gradient-to-br from-[#dd0503] via-[#a40201] to-[#6b0302] text-sm text-[#1c0504] shadow-[0_5px_15px_rgba(164,2,1,0.45)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e3dd]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#6b0302] pb-3 text-xl leading-normal font-black tracking-widest text-[#f2c14e] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#f2c14e]/50 bg-gradient-to-br from-[#ffe7a6] via-[#f2c14e] to-[#8a6524] text-sm text-[#1c0504] shadow-[0_5px_15px_rgba(255,231,166,0.35)]">
              🎴
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
