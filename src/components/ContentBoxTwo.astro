---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🔐", iconright = "🃏" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a channel panel),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
// LoginRtpSection renders it without a title, which is why the page's heading
// inventory stops at the docx's own sections.
//
// Reached ONLY through LoginRtpSection this round (index.astro does not import
// it directly — the docx's two-column section went to ContentBoxTwoPremium
// and the rest of the shape mix is in brand-spec §3).
// A grep for "components/ContentBoxTwo.astro" in src/pages/ therefore finds
// nothing, and that does NOT mean it is inventory: match the bare filename
// instead. It is LIVE and has to carry this brand's colours.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// TKB55 (รอบแดงเลือดนก-เงินโครเมียม 2026-10-13, brand-spec §2):
// โลโก้คือคำว่า TKB เป็นตัวอักษรสามมิติ **สีแดงสด** ต่อด้วยเลข 55 สีเงินโครเมียม
// ขัดเงา เหนือคำขึ้นไปเป็นมาสคอตโจรการ์ตูนใส่หน้ากากดำแบกถุงเงิน $ งานอาร์ตเป็น
// ฉากสตูดิโอ **ดำสนิท** ที่ส่องด้วยริบบิ้นแสงแดง คู่ชายหญิงผมขาวเงินในชุดสูท/
// ชุดราตรีดำ-แดง ชิปคาสิโนแดง-ดำ-ทอง ไพ่เอซดำ และลูกเต๋าแดง
// ⚠️ รอบนี้เป็น **สองโทนจริง: แดงเลือดนกนำ เงินโครเมียมรอง** และ **ไม่มีทอง
// ไม่มีม่วง ไม่มีชมพู ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีส้ม** — ถ้าเผลออยากใส่สีที่สอง
// คำตอบคือเงินโครเมียม #e9eef4 / #aeb9c6 ไม่ใช่ทองหรืออำพัน
// กล่องนี้ไม่มีการ์ดครอบ มันวางสองคอลัมน์ลงบนพื้นเพจ **ดำสนิท #000000** (bg.json)
// ตรงๆ จึงเป็นจังหวะ "โปร่ง" ของหน้า คั่นหลังบล็อกเนื้อหาของบรีฟ — กล่องเนื้อหา
// อีกแปดใบมีผิวและกรอบของตัวเองทั้งหมด ใบนี้จึงเป็นใบเดียวที่ไม่มีผิว
// ลำดับความลึก: #2a0d0f ยก / #1a0708 กลาง / #0d0304 จม / #000000 พื้น — ไม่มีชั้น
// ไหนจมต่ำกว่าพื้นได้
// สองคอลัมน์ถูกแยกด้วยคู่ "แผ่นมืดกรอบแดง vs แผ่นโครเมียมทึบ" ซึ่งตรงกับสองโทนของ
// โลโก้: ฝั่งซ้ายเป็นฝั่งแดง ป้ายไอคอนเป็นแผ่นมืดไล่ผิวยก #2a0d0f → ผิวจม #0d0304
// ในกรอบแดงแบรนด์ #fb131b บนไอคอนแดงอ่อน #ff8a8f และป้ายคอลัมน์ซ้ายเป็นแดงสว่าง
// #ff4d55 (5.6:1) ส่วนฝั่งขวาเป็นฝั่งโครเมียม ป้ายไอคอนเป็นแผ่นเงินทึบไล่ #e9eef4
// → #aeb9c6 บนหมึก #1a0304 (§2 ระบุว่านี่คือหมึกตัวเดียวที่วางบนพื้นสว่างได้ —
// ห้ามพลิกแผ่นโครเมียมไปใช้หมึกสว่าง) และป้ายคอลัมน์ขวาเป็นเงินโครเมียมสว่าง
// #e9eef4 (15.2:1) — §2 ห้าม #fb131b #c40304 #8a0206 #53050a ถือตัวอักษรที่ไหนเลย
// ในไฟล์นี้ทั้งสี่ค่าอยู่ที่ขอบ เส้นคั่น สันหัวข้อ และ **พื้น** ของแผ่นไอคอนเท่านั้น
// หัวข้อ docx (เมื่อมีการส่ง title มา) ไล่ เงินโครเมียมหม่น #aeb9c6 → แดงสว่าง
// #ff4d55 → แดงอ่อน #ff8a8f ซึ่งไม่ซ้ำลำดับกับกล่องอื่นบนหน้าเดียวกันสักใบ
// (ContentBox ไล่ #e9eef4 → #ff8a8f → #fb131b คนละลำดับกัน) สันหัวข้อไล่ เงิน
// โครเมียมสว่าง #e9eef4 → แดงแบรนด์ #fb131b → แดงลึกกว่า #8a0206 เส้นคั่นเป็น
// แดงเลือดหมู #53050a ทั้งสองฝั่ง เนื้อความ #f2e4e5 (= BRAND_TEXT) — 17.0:1 บน
// พื้นเพจดำสนิท
//
// ไอคอนเริ่มต้นเป็น 🔐 / 🃏 — บรีฟรอบนี้เป็น **คาสิโน + กีฬา** (บาคาร่า · ไฮโล ·
// บอล · สล็อต) ไม่ใช่เว็บสล็อตล้วน จึงไม่ใช้ 🎰 เป็นค่าตั้งต้น และไพ่มาจากบาคาร่า
// ซึ่งบรีฟเรียกว่าเกมไพ่ตรงๆ (LoginRtpSection ส่งไอคอนมาเองอยู่แล้ว ค่านี้คือกันหลง)
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — ไฟล์นี้เพิ่งถือชุด **น้ำเงินไฟฟ้า-เงิน
// โครเมียม** ของ TSDET911 มาทั้งไฟล์ (#0360f3 #0292fb #6ec8ff #4fb4ff #cfdcec
// #9db4d4 #dde8f7 #102a5e #0a1c42 #040e26 #00081f #032dad #04186e #041a43 #021026)
// และก่อนนั้นเป็นชุดม่วงราชา-ทอง ชุดทองมังกร ชุดทองอำพันเสือ และชุดชมพูฮอตพิงก์-ทอง
// — ถูกถอดออกครบทุกค่า ไม่เหลือน้ำเงิน ไม่เหลือฟ้า ไม่เหลือม่วง ไม่เหลือทอง
// ไม่เหลือชมพู ไม่เหลือเขียว และไม่เหลือส้ม/อำพันในไฟล์นี้แล้ว
// ⚠️ **กับดักรอบนี้คือแดง** โค้ดเบสนี้เคยมีแบรนด์แดงมาก่อนสามเจ้า — SUPERSLOTCLUB
// #e8232a (R:232 G:35 B:42) · PIGPG #d4200d (R:212 G:32 B:13) · FLASH877 #ff3b14
// (R:255 G:59 B:20) แดงของรอบนี้คือ #fb131b (R:251 G:19 B:27) ซึ่งไม่ใช่ค่าใด
// ในสามค่านั้นเลย ให้เทียบเป็นตัวเลขทีละค่า ห้ามกะด้วยตา
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#53050a] pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e9eef4] via-[#fb131b] to-[#8a0206] shadow-[0_0_10px_rgba(251,19,27,0.6)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#aeb9c6] via-[#ff4d55] to-[#ff8a8f] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f2e4e5]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#53050a] pb-3 text-xl leading-normal font-black tracking-widest text-[#ff4d55] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#fb131b]/70 bg-gradient-to-br from-[#2a0d0f] to-[#0d0304] text-sm text-[#ff8a8f] shadow-[0_5px_15px_rgba(0,0,0,0.7)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f2e4e5]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#53050a] pb-3 text-xl leading-normal font-black tracking-widest text-[#e9eef4] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#c40304] bg-gradient-to-br from-[#e9eef4] to-[#aeb9c6] text-sm text-[#1a0304] shadow-[0_5px_15px_rgba(251,19,27,0.4)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
