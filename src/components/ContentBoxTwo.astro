---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a service list),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// JOKERSLOTZ palette: the left column badge is the logo's crimson (the JOKER
// wordmark), the right column badge is the jester hat's antique gold — so the
// two halves are told apart by the brand's own two-colour pairing on one
// near-black maroon surface. No navy, no rose, no third colour.
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#a51515]/40 pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f2dc9a] via-[#c81e1e] to-[#6d0d0d] shadow-[0_0_10px_rgba(165,21,21,0.55)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#f2dc9a] via-[#d9b45e] to-[#c81e1e] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ecdfd0]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#a51515]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#f2dc9a] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#a51515]/70 bg-gradient-to-br from-[#c81e1e] via-[#a51515] to-[#6d0d0d] text-sm text-[#f2dc9a] shadow-[0_5px_15px_rgba(165,21,21,0.35)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ecdfd0]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#bc9b5b]/45 pb-3 text-xl leading-normal font-black tracking-widest text-[#d9b45e] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#bc9b5b]/60 bg-gradient-to-br from-[#f2dc9a] via-[#d9b45e] to-[#bc9b5b] text-sm text-[#1c0202] shadow-[0_5px_15px_rgba(217,180,94,0.28)]">
              🛡️
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
