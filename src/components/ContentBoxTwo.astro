---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🔐", iconright = "🎟️" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a lottery-listing
// panel), never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
// LoginRtpSection renders it without a title, which is why the page's heading
// inventory stops at the docx's own sections.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// หวยเฮง24 (รอบแดงเข้ม-ทอง 2026-10-01): เวิร์ดมาร์กเป็นสองโทน คำว่า "หวย" เป็นแดง
// เลือดนกเงาวาวขอบทอง ส่วน "เฮง24" เป็นทองไล่เฉดวาว บนงานอาร์ตฉากผ้าซาตินแดงที่มีลาย
// ไทยและเงาปราสาทสีทอง เหรียญทองกองสูง ลูกหวยแดง-ขาว และหญิงสาวในชุดไทยขาว-ทอง
// สองคอลัมน์ของกล่องนี้จึงถูกแยกด้วยคู่ทอง/แดงนั้นตรงๆ ตามลำดับบนโลโก้ — ฝั่งซ้ายเป็นทอง
// เต็มใบ ป้ายไอคอนไล่จากทองอ่อน #fdea83 ลงทองสว่าง #fbdc64 ไปหาทองกลาง #bd7c13
// ส่วนฝั่งขวาเป็นแดงเต็มใบ ป้ายไอคอนไล่แดงสว่าง #c01616 → แดงแบรนด์ #8b0302 → แดงลึก
// #5a0202 ตัวอักษรบนป้ายทองเป็นหมึกเข้ม #2a0606 (พื้นสว่าง ต้องใช้หมึกเข้ม) ส่วนป้ายแดง
// เป็นพื้นเข้มจึงใช้ทองอ่อน #fdea83 ข้อความป้ายฝั่งขวาใช้สีเนื้อความ #f6e6cf ไม่ใช่แดงสว่าง
// เพราะแดงสว่างบนพื้นเพจได้คอนทราสต์ต่ำกว่าเกณฑ์ตัวอักษรใหญ่ หัวข้อ docx (เมื่อมีการส่ง
// title มา) ไล่ทองอ่อน → ทองแบรนด์ #e0a52a → แดงแบรนด์ เส้นคั่นเป็นแดงกลาง #720202
// ทั้งสองฝั่ง เนื้อความ #f6e6cf (BRAND_TEXT) — ชุดเขียวป่า-ทองของ หวยเต็ง (#026314
// #024a0f #0bb42f #e5c04f #fae474 #bd8d2d #062a12 #0a1a0c #d8ead9) ออกทั้งหมด
// ไม่เหลือเขียวอยู่เลย
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#720202] pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdea83] via-[#e0a52a] to-[#8b0302] shadow-[0_0_10px_rgba(224,165,42,0.5)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#fdea83] via-[#e0a52a] to-[#8b0302] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e6cf]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#720202] pb-3 text-xl leading-normal font-black tracking-widest text-[#fdea83] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#e0a52a]/70 bg-gradient-to-br from-[#fdea83] via-[#fbdc64] to-[#bd7c13] text-sm text-[#2a0606] shadow-[0_5px_15px_rgba(224,165,42,0.40)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e6cf]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#720202] pb-3 text-xl leading-normal font-black tracking-widest text-[#f6e6cf] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#c01616]/70 bg-gradient-to-br from-[#c01616] via-[#8b0302] to-[#5a0202] text-sm text-[#fdea83] shadow-[0_5px_15px_rgba(192,22,22,0.35)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
