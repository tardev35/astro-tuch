---
export interface Props {
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { titleleft, titleright, label } = Astro.props;

// This box carries chrome (a login widget, a service list), never docx article
// content, so both column labels render as <p> and the section gets its
// accessible name from aria-label instead of a heading.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece0fb]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#9d16f1]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#c47bff] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#9d16f1]/50 bg-gradient-to-br from-[#e0b7ff] via-[#9d16f1] to-[#2c045c] text-sm text-[#06020e] shadow-[0_5px_15px_rgba(157,22,241,0.32)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece0fb]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#c3b2d4]/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#e8e6ee] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#c3b2d4]/60 bg-gradient-to-br from-[#e8e6ee] via-[#c3b2d4] to-[#a892bd] text-sm text-[#06020e] shadow-[0_5px_15px_rgba(232,230,238,0.28)]">
              🎰
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
