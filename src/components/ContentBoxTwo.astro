---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits.
   *  Leave it out and the box stays pure chrome, exactly as it was. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🔐", iconright = "🎰" } = Astro.props;

// Without a `title` this box carries chrome (a login widget, a channel panel),
// never docx article content, so both column labels render as <p> and the
// section gets its accessible name from aria-label instead of a heading. With a
// `title` the heading itself names the region, so the aria-label is dropped.
// LoginRtpSection renders it without a title, which is why the page's heading
// inventory stops at the docx's own sections (brand-spec §5: h1×1 h2×5 h3×2).
//
// Reached ONLY through LoginRtpSection this round (index.astro does not import
// it directly — the docx's two-column section went to ContentBoxTwoNeumorphism,
// and the rest of the shape mix is in brand-spec §3).
// A grep for "components/ContentBoxTwo.astro" in src/pages/ therefore finds
// nothing, and that does NOT mean it is inventory: match the bare filename
// instead. It is LIVE and has to carry this brand's colours.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// ขวัญใจ168 (รอบ **ทองนำ · โรสโกลด์เป็นฮิวที่สอง · แดงชาดเป็นสำเนียงลึก บนดำสนิท**
// 2026-10-18, brand-spec §2): โลโก้คือคำว่า "ขวัญใจ" ตัวอักษรไทยหนาสามมิติผิวทอง
// ขัดเงาตัดขอบแดงเข้ม ต่อด้วยเลข "168" ทองสามมิติ วางบนโบว์ริบบิ้นทองโค้ง ด้านหลัง
// เป็นหญิงสาวผมดำเกล้ามวยสูงประดับปิ่นทองห้อยระย้าและดอกไม้ขาว สวมชุดไทยแดงปักทอง
// ล้อมด้วยเหรียญจีนทองรูสี่เหลี่ยมและหัวใจแดงสองดวง
// ⚠️ รอบนี้ **สลับองค์ประกอบ** ไม่ใช่แค่เปลี่ยนเลขฮิว: palette.json วัด vivid อันดับ
// หนึ่งของทั้งโลโก้และแบนเนอร์ได้เป็น **โรสโกลด์/พีช** (#f2bba5) ⇒ โรสโกลด์คือ
// **ฮิวที่สองจริง** และต้องเห็นมันบนหน้าเว็บ ไม่ใช่เขียนไว้ในสเปก ส่วน **แดงชาด
// ถอยไปเป็นสำเนียงลึกที่ไม่เคยนำ** — แดงนำจะซ้ำสมหวัง168 แดงเป็นคู่หูจะซ้ำรับตัง168
// ⚠️ bg.json = {"mode":"color","color":"#000000"} → พื้นเพจเป็น **ดำสนิท** ไม่ใช่
// ดำอมแดงแบบสองรอบก่อน ลำดับความลึก: #241509 ยก / #160d06 กลาง / #0b0603 จม /
// #000000 พื้น
// กล่องนี้ไม่มีการ์ดครอบ มันวางสองคอลัมน์ลงบนพื้นเพจดำสนิทตรงๆ จึงเป็นจังหวะ
// "โปร่ง" ของหน้า คั่นหลังบล็อกเนื้อหาของบรีฟ — กล่องเนื้อหาใบอื่นมีผิวและกรอบของ
// ตัวเองทั้งหมด ใบนี้จึงเป็นใบเดียวที่ไม่มีผิว
// สองคอลัมน์ถูกแยกด้วยคู่ "แผ่นทองทึบ vs แผ่นมืดกรอบแดงชาด" และเรียงตามลำดับนำของ
// รอบนี้: **ฝั่งซ้ายเป็นฝั่งทอง** ป้ายไอคอนเป็นแผ่นทองทึบไล่ #f7c92b → #ffe6a3 บน
// หมึก #140c06 (§2 ระบุว่านี่คือหมึกตัวเดียวที่วางบนพื้นถมทอง/โรสตันได้ — ห้ามพลิก
// แผ่นทองไปใช้หมึกสว่าง) ป้ายคอลัมน์ซ้ายเป็นทองแบรนด์ #f7c92b (7.3:1)
// ส่วน **ฝั่งขวาเป็นฝั่งโรสโกลด์** ป้ายไอคอนเป็นแผ่นมืดไล่ผิวยก #241509 → ผิวจม
// #0b0603 ในกรอบแดงชาด #b3121b บนไอคอนโรสโกลด์ #f2bba5 และป้ายคอลัมน์ขวาเป็น
// โรสโกลด์ #f2bba5 (10.4:1) — ตรงนี้คือจุดที่ฮิวที่สองของรอบนี้ปรากฏตัว
// §2 ห้าม #b3121b #5a0a0e #8a5f12 ถือตัวอักษรที่ไหนเลย — ในไฟล์นี้ทั้งสามค่าอยู่ที่
// ขอบ เส้นคั่น สันหัวข้อ และ **พื้น** ของแผ่นไอคอนเท่านั้น
// หัวข้อ docx (เมื่อมีการส่ง title มา) ไล่ ทองสว่าง #ffe6a3 → ทองแบรนด์ #f7c92b →
// โรสโกลด์ #f2bba5 ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุก
// สต็อปจึงต้องถือตัวอักษรได้ตาม §2 (14.5 / 7.3 / 10.4) สันหัวข้อไล่ #ffe6a3 →
// #f7c92b → ทองลึก #8a5f12 (ซึ่งเป็น **พื้น** ไม่ใช่ตัวอักษร จึงใช้ได้)
// เส้นคั่นเป็นทองลึก #8a5f12 ฝั่งซ้าย และแดงชาด #b3121b ฝั่งขวา
// เนื้อความ #eadfce (= BRAND_TEXT) — 13.5:1 บนผิวยก
// glow rgba ใช้ได้ 4 ชุดตาม §2: rgba(247,201,43,α) · rgba(255,230,163,α) ·
// rgba(242,187,165,α) · rgba(179,18,27,α) — ไฟล์นี้ใช้ชุดแรกกับชุดที่สี่
//
// ไอคอนเริ่มต้นเป็น 🔐 / 🎰 — บรีฟรอบนี้เป็น **เว็บเกมสล็อตล้วน** ไม่ใช่คาสิโนและ
// ไม่ใช่หวย จึงไม่ใช้ไพ่/ลูกเต๋า/ลูกบอลเป็นค่าตั้งต้น (LoginRtpSection ส่งไอคอนมา
// เองอยู่แล้ว ค่านี้คือกันหลง)
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือทอง** เพราะเกือบทุกแบรนด์
// ที่ผ่านไฟล์นี้มีทอง "เจอทองอยู่แล้ว" จึงไม่พิสูจน์อะไรเลย ชุดที่เพิ่งอยู่ในไฟล์นี้
// คือรับตัง168 (#f0b429 #ffdc8c #d30304 #ff6b6e #a00203 #4a0202 #9a6c0c #cfd9e6
// #f5ece0 #2b100f #200a09 #140505 #1a0505) ซึ่งเป็นทองนำ+แดงรองบนดำอมแดงเหมือนกัน
// ก่อนหน้านั้นคือสมหวัง168 (#fa0513 #ffadaf #ff5a5f #e3b23c #ffe5a8 #8a6210 #b90203
// #8c0204 #5b0203 #3c0303 #170504 #f4ecea #ccb9b6 #2c1413 #1f0d0c #140706 #290f0f)
// และ TKB55 (#fb131b #ff8a8f #ff4d55 #e9eef4 #aeb9c6 #f2e4e5 #2a0d0f #1a0708
// #0d0304 #c40304 #8a0206 #53050a #1a0304) — ถอดออกครบทุกค่าแล้ว
// ⚠️ ทองรอบนี้คือ **#f7c92b** (R=247 G=201 B=43) ไม่ใช่ #f0b429 (รับตัง168)
// #e3b23c (สมหวัง168) #dfa310 (TND168) #e2b33f (KMD88) #e5a81b (UFA324)
// #fad354 (789BETTING) #8a6210 หรือ #9a6c0c
// ⚠️ แดงรอบนี้คือ **#b3121b** และ **มันไม่เคยนำ** ไม่ใช่ #d30304 (รับตัง168)
// #fa0513 (สมหวัง168) #fb131b (TKB55) #fb141b (GT66B) #d4200d (PIGPG)
// #e8232a (SUPERSLOTCLUB) หรือ #ff3b14 (FLASH877)
// ⚠️ พื้นเพจรอบนี้คือ **#000000** ไม่ใช่ #1a0505 ของรอบก่อนและไม่ใช่ #290f0f
// ⚠️ **รอบนี้ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีม่วง ไม่มีชมพูบานเย็น ไม่มีเขียว ไม่มีส้ม
// ไม่มีเงิน/โครเมียมอมฟ้า** — #cfd9e6 (เงินของรับตัง168) #e9eef4 #aeb9c6 #cfdcec
// #9db4d4 ต้องไม่เหลืออยู่ในไฟล์นี้
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#8a5f12] pb-4">
        <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe6a3] via-[#f7c92b] to-[#8a5f12] shadow-[0_0_10px_rgba(247,201,43,0.6)]" />
        <HeadingTag class={`bg-gradient-to-r from-[#ffe6a3] via-[#f7c92b] to-[#f2bba5] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#eadfce]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#8a5f12] pb-3 text-xl leading-normal font-black tracking-widest text-[#f7c92b] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#8a5f12] bg-gradient-to-br from-[#f7c92b] to-[#ffe6a3] text-sm text-[#140c06] shadow-[0_5px_15px_rgba(247,201,43,0.4)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#eadfce]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#b3121b] pb-3 text-xl leading-normal font-black tracking-widest text-[#f2bba5] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#b3121b] bg-gradient-to-br from-[#241509] to-[#0b0603] text-sm text-[#f2bba5] shadow-[0_5px_15px_rgba(179,18,27,0.45)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
