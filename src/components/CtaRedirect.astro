---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// ขวัญใจ168 (รอบทองนำ-โรสโกลด์รอง บนดำสนิท 2026-10-18): หน้าจอคั่นตอนกดปุ่มไป
// ลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render ตัวนี้
// ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก .claude/brand-spec-kwanjai168.md §2: backdrop เป็นดำจม
// rgba(11,6,3) = #0b0603 (พื้นเพจรอบนี้เป็น **ดำสนิท #000000** backdrop จึงไม่
// จมกว่าพื้นได้แล้ว แต่ยังอ่านออกว่าเป็นชั้นทับเพราะมีออร่าสองวงและแผงการ์ดสว่าง
// กว่าอย่างชัดเจน) ออร่าบนเป็น **ทองแบรนด์** rgba(247,201,43) คู่กับ
// **โรสโกลด์** rgba(242,187,165) ด้านล่าง — รอบก่อนด้านล่างเป็นแดงสด รอบนี้เป็น
// โรสโกลด์ซึ่งเป็นฮิวที่สองจริงของดรอปนี้ แผงการ์ดเป็นผิวยก rgba(36,21,9) = #241509
// ⚠️ แผงการ์ดต้องสว่างกว่า backdrop เสมอ
// ออร์บไล่จากทองสว่าง #ffe6a3 เข้าหาทองแบรนด์ #f7c92b แล้วจบที่แดงชาด
// #b3121b (ออร์บเป็นรูปทรง ไม่ใช่ตัวอักษร #b3121b จึงใช้ได้ตรงนี้) — การไล่
// "ทองเข้าแดง" คืออ่านจากตัวอักษรบนโลโก้ตรงๆ (ผิวทองขัดเงาตัดขอบแดงเข้ม)
// วงแหวนคู่หมุนสวนทางกันและแยก "โทน" กันจริง — วงนอก **ทองแบรนด์ #f7c92b**
// วงใน **โรสโกลด์ #f2bba5** ซึ่งรอบก่อนวงในเป็นแดงสด
// รางวงแหวนใช้เส้นคั่นจาง rgba(138,95,18,0.8) = #8a5f12 ทองลึก (เป็นเส้น
// ไม่ใช่ตัวอักษร) ส่วนชื่อแบรนด์ไล่ ทองสว่าง #ffe6a3 -> ทองแบรนด์ #f7c92b ->
// โรสโกลด์ #f2bba5
// ⚠️ ปลายเข้มของ "ตัวอักษร" หยุดที่ #f2bba5 ไม่ใช่ #b3121b หรือ #8a5f12 —
// #b3121b บนแผง #241509 ได้ ~2.6:1 และ #8a5f12 ได้ ~2.95:1 ตก AA ทั้งคู่
// ส่วน #f2bba5 ได้ ~10.4:1
// (brand-spec §2: #b3121b / #5a0a0e / #8a5f12 ห้ามถือตัวอักษรทุกขนาด)
// ⚠️ ไฟล์นี้เคยเป็นทองไทย-แดงมังกรของ รับตัง168 ก่อนหน้านั้นเป็นแดงมังกร-ทองของ
// สมหวัง168 แดงมังกร-โครเมียมขาวของ GT66B แดงเลือดนก-เงินของ TKB55
// น้ำเงิน-เงินของ TSDET911 ม่วง-ทองของ KMD88 และทองล้วนของ TND168 — **เกือบทุก
// แบรนด์ที่ผ่านไฟล์นี้มีทอง** การเจอ "ทอง" ในไฟล์นี้จึงไม่ได้แปลว่าเป็นของรอบนี้
// ทองรอบนี้คือ #f7c92b ให้เทียบเป็นตัวเลขกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำ
// ที่นี่เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive — และรอบนี้ไม่มีค่า
// ม่วง/ชมพู/เขียว/น้ำเงิน/ฟ้า/ส้ม/เงินโครเมียม เหลือในไฟล์นี้เลย
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(247, 201, 43, 0.28) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(242, 187, 165, 0.22) 0%, transparent 55%), rgba(11, 6, 3, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(247, 201, 43, 0.65);
    border-radius: 1.5rem;
    background: rgba(36, 21, 9, 0.94);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.7),
      0 0 2rem rgba(247, 201, 43, 0.38);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #ffe6a3 0%, #f7c92b 50%, #f2bba5 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #ffe6a3 0%, #f7c92b 55%, #b3121b 100%);
    box-shadow: 0 0 2rem rgba(247, 201, 43, 0.6);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(138, 95, 18, 0.8);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #f7c92b;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #f2bba5;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #eadfce;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(234, 223, 206, 0.8);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(247, 201, 43, 0.6);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(242, 187, 165, 0.5);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
