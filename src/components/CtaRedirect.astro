---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// นินจา168 (รอบฟ้าไซยานนำ-เหลืองมะนาวรอง บนดำสนิท 2026-10-19): หน้าจอคั่นตอนกด
// ปุ่มไปลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render
// ตัวนี้ ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก .claude/brand-spec-ninja168.md §2: backdrop เป็นฟ้าหมึกจม
// rgba(3,14,22) = #030e16 (พื้นเพจรอบนี้เป็น **ดำสนิท #000000** backdrop จึงไม่
// จมกว่าพื้นได้แล้ว แต่ยังอ่านออกว่าเป็นชั้นทับเพราะมีออร่าสองวงและแผงการ์ดสว่าง
// กว่าอย่างชัดเจน) ออร่าบนเป็น **ฟ้าแบรนด์** rgba(50,188,251) คู่กับ
// **เหลืองมะนาว** rgba(254,245,75) ด้านล่าง — ฮิวนำอยู่บน ฮิวที่สองอยู่ล่าง
// แผงการ์ดเป็นผิวยก rgba(12,42,61) = #0c2a3d
// ⚠️ แผงการ์ดต้องสว่างกว่า backdrop เสมอ
// ออร์บไล่จากฟ้าน้ำแข็ง #a9e9ff เข้าหาฟ้าแบรนด์ #32bcfb แล้วจบที่เหลืองมะนาว
// #fef54b — การไล่ "ฟ้าออกเหลือง" คืออ่านจากตัวอักษรบนโลโก้ตรงๆ (เลข 168 เป็นฟ้า
// บับเบิลผิวมันวาว ส่วนคำว่า นินจา ที่อยู่ก่อนหน้าเป็นเหลืองทอง)
// วงแหวนคู่หมุนสวนทางกันและแยก "โทน" กันจริง — วงนอก **ฟ้าแบรนด์ #32bcfb**
// วงใน **เหลืองมะนาว #fef54b**
// รางวงแหวนใช้เส้นคั่นจาง rgba(7,51,95,0.8) = #07335f น้ำเงินลึก (เป็นเส้น
// ไม่ใช่ตัวอักษร) ส่วนชื่อแบรนด์ไล่ ฟ้าน้ำแข็ง #a9e9ff -> ฟ้าแบรนด์ #32bcfb ->
// เหลืองมะนาว #fef54b
// ⚠️ ปลายเข้มของ "ตัวอักษร" หยุดที่ #32bcfb ไม่ใช่ #07335f หรือ #6b5c10 —
// #07335f บนแผง #0c2a3d ได้ ~1.4:1 และ #6b5c10 ได้ ~1.9:1 ตก AA ทั้งคู่
// ส่วน #32bcfb ได้ ~7.1:1
// (brand-spec §2: #07335f / #6b5c10 ห้ามถือตัวอักษรทุกขนาด)
// ⚠️ **ไฟล์นี้เพิ่งเป็นฟ้า-ทองของ สบายเบท168 เมื่อรอบที่แล้วเป๊ะๆ** ก่อนหน้านั้น
// เป็นชมพูบับเบิลกัมนำ-ทองเนยรองของ ถอนชัวร์168 ทองนำ-ชมพูบานเย็นของ มีโชค168
// ทอง-โรสโกลด์ของ ขวัญใจ168 ทองไทย-แดงมังกรของ รับตัง168 แดงมังกร-ทองของ
// สมหวัง168 แดงมังกร-โครเมียมขาวของ GT66B แดงเลือดนก-เงินของ TKB55
// **น้ำเงิน-เงินของ TSDET911** ม่วง-ทองของ KMD88 และทองล้วนของ TND168 —
// **เกือบทุกแบรนด์ที่ผ่านไฟล์นี้มีทอง และรอบที่แล้วก็ฟ้านำเหมือนรอบนี้**
// การเจอ "ทอง" หรือ "ฟ้า/น้ำเงิน" ในไฟล์นี้จึงไม่ได้แปลว่าเป็นของรอบนี้แน่ๆ
// ฟ้ารอบนี้คือ #32bcfb (+#a9e9ff +#07335f) และเหลืองรอบนี้คือ #fef54b
// ให้เทียบเป็นตัวเลขกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่เพื่อไม่ให้ grep
// หาสีของแบรนด์เก่าเจอ false positive — และรอบนี้ไม่มีค่าชมพู/แดง/ม่วง/เขียว/ส้ม/
// เงินโครเมียม/โรสโกลด์ เหลือในไฟล์นี้เลย
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(50, 188, 251, 0.28) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(254, 245, 75, 0.22) 0%, transparent 55%), rgba(3, 14, 22, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(50, 188, 251, 0.65);
    border-radius: 1.5rem;
    background: rgba(12, 42, 61, 0.94);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.7),
      0 0 2rem rgba(50, 188, 251, 0.38);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #a9e9ff 0%, #32bcfb 50%, #fef54b 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #a9e9ff 0%, #32bcfb 55%, #fef54b 100%);
    box-shadow: 0 0 2rem rgba(50, 188, 251, 0.6);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(7, 51, 95, 0.8);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #32bcfb;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #fef54b;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #dceefc;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(220, 238, 252, 0.8);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(50, 188, 251, 0.6);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(254, 245, 75, 0.5);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
