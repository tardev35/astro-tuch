---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// NAZA99 (รอบทอง-ดำ 2026-10-02): หน้าจอคั่นตอนกดปุ่มไปลิงก์พันธมิตร
// แสดงเฉพาะ /login กับ /register — พื้นหลังดำ rgb(0,0,0) แผงการ์ดดำอมทอง
// rgba(20,12,2) ออร่าเป็นทองแบรนด์ rgba(228,179,77) กับทองอ่อน rgba(253,242,172)
// ออร์บไล่จากทองอ่อน #fdf2ac เข้าหาทองแบรนด์ #e4b34d แล้วจบที่ทองลึก #8a5f12
// วงแหวนคู่แยกน้ำหนักกันคนละวง (วงนอกทองอ่อน #fdf2ac วงในทองแบรนด์ #e4b34d)
// หมุนสวนทางกัน — แบรนด์นี้เป็นทองล้วนไม่มีฮิวที่สอง วงแหวนจึงต่างกันที่ความสว่าง
// ไม่ใช่ที่สี ตามโลโก้ที่เป็นตัวอักษรทองเมทัลลิกบนพื้นโปร่ง และแบนเนอร์ที่เป็นฉาก
// ทองอร่ามบนพื้นดำอมน้ำตาล — รอบก่อน (หวย365) เป็นแดงสด-ทอง ชุดเดิม (#dc0203
// #9c0201 #f5282a #ffc93c #ffeab0 rgba(36,4,6) rgba(72,6,7) rgba(246,231,224)
// rgba(8,1,1)) ไม่เหลือแล้ว
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(228, 179, 77, 0.32) 0%, transparent 55%),
      radial-gradient(circle at 50% 90%, rgba(253, 242, 172, 0.26) 0%, transparent 55%),
      rgba(0, 0, 0, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(228, 179, 77, 0.5);
    border-radius: 1.5rem;
    background: rgba(20, 12, 2, 0.94);
    box-shadow:
      0 1rem 3rem rgba(5, 3, 1, 0.6),
      0 0 2rem rgba(228, 179, 77, 0.24);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #fdf2ac 0%, #e4b34d 45%, #8a5f12 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #fdf2ac 0%, #e4b34d 55%, #8a5f12 100%);
    box-shadow: 0 0 2rem rgba(228, 179, 77, 0.5);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(58, 36, 9, 0.6);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #fdf2ac;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #e4b34d;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #fdf2ac;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(243, 232, 207, 0.78);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(228, 179, 77, 0.5);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(253, 242, 172, 0.45);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
