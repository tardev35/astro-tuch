---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// โบ๊ะบ๊ะ168 (รอบฟ้าสกายนำ ขาวอมฟ้ารอง บน **ธีมสว่าง**): หน้าจอคั่นตอนกดปุ่มไป
// ลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render ตัวนี้
// ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก .claude/brand-spec-bohba168.md §2 (โซน "โครม")
// ⚠️⚠️ **รอบนี้พื้นเพจเป็นฟ้าสกายอิ่มตัว #00bfff (จาก bg.json ซึ่งรอบก่อนเป็น
// ffe5ff = ชมพูพาสเทล → ธีมยังสว่างเหมือนเดิมแต่คนละฮิว)** แต่ overlay ตัวนี้เป็น
// **โครม จึงยังเป็นผิวมืดเหมือนทุกรอบ** — มันต้องกลบหน้าข้างหลังได้สนิท ซึ่งเป็น
// เหตุผลเดียวกันทุกรอบ **ห้าม "แก้" ให้สว่างตามพื้นเพจ**
// backdrop เป็นชั้นน้ำเงินจม rgba(6,40,63) ออร่าบนเป็น **ฟ้าแกนแบรนด์**
// rgba(18,180,239) คู่กับ **ฟ้าพาสเทล** rgba(182,227,240) ด้านล่าง
// — ฮิวนำอยู่บน แผงการ์ดเป็นผิวยก rgba(11,74,115) = #0b4a73
// ⚠️ แผงการ์ดต้องสว่างกว่า backdrop เสมอ (#0b4a73 ยก vs #06283f จมของ backdrop)
// ⚠️ ค่าทุกค่าในไฟล์นี้อยู่ในชุด rgba ที่ brand-spec §2 อนุญาต (18/180/239 ·
// 182/227/240 · 42/135/196 · 15/86/132 · 26/110/168 · 11/74/115 · 6/40/63)
// ออร์บไล่จากฟ้าสด #12b4ef เข้าหาฟ้าลึก #0f5684 แล้วจบที่น้ำเงินลึกสุด #06283f
// — การไล่ "สว่างออกเข้ม" คืออ่านจากโลโก้ตรงๆ (ตัวอักษร "โบ๊ะบ๊ะ168" เป็นผิวบับเบิล
// สามมิติมันวาว ไล่จากฟ้าสกายเข้มที่ยอดลงฟ้าอ่อนเกือบขาวที่ฐาน ตัดขอบขาวหนา)
// วงแหวนคู่หมุนสวนทางกันและแยกค่ากันจริง — วงนอก **ฟ้าสด #12b4ef**
// วงใน **ฟ้าพาสเทล #b6e3f0** ซึ่งคือคู่วัสดุบนเวิร์ดมาร์กเป๊ะๆ: ตัวบับเบิลฟ้า
// ที่มีขอบตัดขาวและไฮไลต์ขาวพาดอยู่บนตัวอักษรทุกตัว
// ⚠️⚠️ **เสื้อคลุมถักฟ้าอ่อนของนักแสดงเป็นวัตถุในภาพ ส่วนฟ้าของ UI มาจากตัวอักษร
// ในโลโก้กับของประดับ** และ **ห้ามเอาชมพู/ทอง/เหลือง/แดง/ครีม/เบจ/เทาเงินกลับเข้ามา**
// (ชมพูบานเย็นคือฮิวนำของ หมูบิน168 รอบก่อนทันที)
// รางวงแหวนใช้เส้นคั่นจาง rgba(42,135,196,0.8) = #2a87c4 (เป็นเส้น ไม่ใช่ตัวอักษร
// ค่านี้จึงใช้ได้ ทั้งที่ถือตัวอักษรไม่ได้)
// ส่วนชื่อแบรนด์ไล่ ขาวอมฟ้า #eaf7ff -> ฟ้าพาสเทล #b6e3f0 (8.5 -> 6.8:1 บนแผง
// #0b4a73) ซึ่งอ่านเป็นเวิร์ดมาร์กจริง: ไฮไลต์ขาวที่ยอดไล่ลงเนื้อบับเบิลฟ้า
// ⚠️ ปลายของ "ตัวอักษร" หยุดที่ #b6e3f0 — **ลากลงไปถึง #12b4ef ไม่ได้บนแผงยกนี้**
// เพราะฟ้าสดได้แค่ 3.9:1 บน #0b4a73 ซึ่งคาบเส้นเกินไปสำหรับตัวอักษร
// letter-spacing กว้างขนาดนี้ และ #0f5684 ยิ่งไม่ได้ (1.6:1)
// ⚠️⚠️ **ไฟล์นี้เพิ่งเป็นชมพูบานเย็นนำ-ขาวอมชมพูของ หมูบิน168 เมื่อรอบที่แล้วเป๊ะๆ**
// (fa539c c2185b 8e0f41 fb8cc0 fdc6c3 3b0b26 54123a 7a2350 ffe9f5 — **ชุดที่เสี่ยง
// หลงเหลือที่สุด**) ก่อนหน้านั้นเป็นแดงเจลนำ-มุกอุ่นของ สล็อต168 (fb2e33 cb0b0d
// d81115 b00d11 8a0608 f0e6e4 c9b9b7 1c0607 0b0000 551c1e) ก่อนหน้านั้นเป็นทองนำ-
// โครเมียมเงินของ รวย168 (ffd94a e3a712 9d6f06 e8eaee b4b9c2 070707 1c1a16)
// แดงคริมสัน-น้ำเงินอะซัวร์ของ มาดาม168 (ff2e52 e01238 c9102f 1177e8 0e68cc 0a4ea8
// 00091f 0b1733 16234a f4eef1) ฟ้าไซยาน-น้ำเงินอุลตรามารีนของ นาซ่า168 (1fd8f0
// 0bb6d4 1d4fd8 143aa0 e6edf8 0d1017) ฟ้าไซยาน-ครีมอุ่นของ ร่ำรวย168 (18a5e2
// 0d6b9b a9d7f2 f4e4d3 e4cbb3 111a3f) ทองแกน-ครีมอุ่นของ เงินทอง168 (f5ba14 fcee52
// b37c0b ecd5c4 d2b9a4 1b1407) ทองแกน-โครเมียมเงินของ พักยก168 (eeae12 fded41
// 9f600d e0e0df c0c0bf 1f0f04) ฟ้าสกาย-ทองคานารีของ สบาย168 (2cc3fc 6bdcfb 0a7fbd
// 063a57 fdcb0c) ทองคานารี-โครเมียมเงินของ ยูฟ้า168 (fee45d e6a416 b8780d e8ecf1
// a8b2bf 15130f) แดงเชอร์รี่-ทองแดงไหม้ของ โปรดี168 แดงคริมสัน-ทองโบราณของ
// รวยแท้168 เขียวมรกต-ทองสัมฤทธิ์ของ สาธุ168 ชมพูบานเย็นของ มีทรัพย์168
// ชมพูบับเบิลกัม-ทองเนยของ ถอนชัวร์168 ทอง-ชมพูฟูเชียของ มีโชค168
// 🚨🚨 **ฟ้าผ่านไฟล์นี้มาแล้วแปดเจ้า** การเจอ "ฟ้า" ในไฟล์นี้จึงไม่ได้แปลว่า
// เป็นของรอบนี้ ฟ้ารอบนี้คือ **#12b4ef** (+#0f5684 #06283f #b6e3f0 #2a87c4)
// เพื่อนบ้านที่ใกล้ที่สุดคือ **18a5e2 ของ ร่ำรวย168 ห่างจาก #12b4ef แค่ R6/G15/B13
// และ 063a57 ของ สบาย168 มี R=06 ตรงกับ #06283f เป๊ะ — ใกล้ที่สุดในลิสต์ ถ้าเจอ
// ค่าพวกนั้นแปลว่าพิมพ์ผิด** · 07335f ของ นินจา168 ก็ใกล้ #06283f ที่ R —
// ให้เทียบเป็นตัวเลขกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่เพื่อไม่ให้ grep
// หาสีของแบรนด์เก่าเจอ false positive — และรอบนี้ไม่มีค่าชมพู/ทอง/เหลือง/แดง/ม่วง/
// ส้ม/เขียว/โรสโกลด์/น้ำตาล/ครีม/เทาเงิน เหลือในไฟล์นี้เลย
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(18,180,239, 0.22) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(182,227,240, 0.14) 0%, transparent 55%), rgba(6,40,63, 0.97);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(42,135,196, 0.75);
    border-radius: 1.5rem;
    background: rgba(11,74,115, 0.96);
    box-shadow:
      0 1rem 3rem rgba(6, 40, 63, 0.7),
      0 0 2rem rgba(18,180,239, 0.28);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #eaf7ff 0%, #b6e3f0 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #12b4ef 0%, #0f5684 55%, #06283f 100%);
    box-shadow: 0 0 2rem rgba(18,180,239, 0.5);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(42,135,196, 0.8);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #12b4ef;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #b6e3f0;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #eaf7ff;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: #b6e3f0;
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(18,180,239, 0.5);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(182,227,240, 0.4);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
