---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// ABM96 (รอบชมพูบานเย็นนำ ทองอำพัน/เงินอมชมพูรอง · **เนื้อหาสว่าง โครมเข้ม**):
// หน้าจอคั่นตอนกดปุ่มไปลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่น
// ในเว็บ render ตัวนี้ ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง
// convert พอดี สีทุกค่ามาจาก .claude/brand-spec-abm96.md §2
// ⚠️⚠️⚠️ **รอบนี้พื้นเพจสว่างและอิ่มตัว (bg.json = f8b9f0 ชมพูพาสเทล)** แต่จอคั่น
// ยังเป็น **จอเข้ม** — ความเข้มของมันคือสิ่งที่กลบหน้าสว่างข้างหลัง
// → ค่า alpha (0.97) ยิ่งสำคัญขึ้น **ห้ามลดค่า alpha เด็ดขาด** ไม่งั้นหน้าชมพู
// สว่างจะทะลุขึ้นมา
// backdrop เป็นชั้นโครมลึกสุด rgba(43,6,32) = #2b0620 ออร่าบนเป็น **ชมพูบานเย็น
// แกนแบรนด์** rgba(163,13,99) คู่กับ **ทองอำพัน** rgba(242,193,78) ด้านล่าง
// — ฮิวนำอยู่บน แผงการ์ดเป็นโครมชั้นยกของรอบนี้ rgba(94,23,70) = #5e1746
// ⚠️ แผงการ์ดต้อง **ต่างค่า** จาก backdrop เสมอ (รอบนี้ #5e1746 vs #2b0620
// ของ backdrop — แผง "สว่างกว่า" พื้น)
// ⚠️ ค่าทุกค่าในไฟล์นี้อยู่ในชุด rgba ที่ brand-spec §2 อนุญาต (163/13/99 ·
// 224/80/159 · 255/122/194 · 209/26/126 · 242/193/78 · 61/10/44 · 68/13/49 ·
// 43/6/32) บวกผิวแผง 94/23/70
// ออร์บไล่จากทองอำพัน #f2c14e เข้าหาชมพูกลาง #e0509f แล้วจบที่ชมพูบานเย็นแกน
// #a30d63 — การไล่ "สว่างออกเข้ม" คืออ่านจากเวิร์ดมาร์กตรงๆ (ผิวตัวอักษรไล่จาก
// ขาวนวลด้านบนลงมาหาชมพูอ่อน แล้วตัดขอบด้วยชมพูเข้มหนาสองชั้น)
// วงแหวนคู่หมุนสวนทางกันและแยกค่ากันจริง — วงนอก **ชมพูกลาง #e0509f**
// วงใน **ทองอำพัน #f2c14e** ซึ่งคือคู่วัสดุบนอาร์ตเวิร์ก: จานวงกลมชมพูขอบขาว
// รอบมาสคอตลูกหมู กับแคปซูลพื้นชมพูบานเย็นขอบทองบนแบนเนอร์และสไลด์ทั้งสองใบ
// ⚠️⚠️ **ผ้าซาตินชมพูนวล สีผิวนักแสดง และฉากสว่างในอาร์ตเวิร์กเป็นวัตถุในภาพ
// ส่วนชมพู/ทองของ UI มาจากขอบตัดสามมิติของเวิร์ดมาร์กกับชิปคาสิโน**
// พื้นจอคั่นมาจาก brand-spec §2 เท่านั้น **ห้ามดูดสีจากรูป** (vivid ที่
// palette.json วัดได้รอบนี้จางเกินกว่าจะถือตัวอักษรหรือเป็นฮิวได้)
// 🚨🚨 **ไฟล์นี้เคยเป็นทอง/แดง/ชมพู/ฟ้า/ม่วง/ส้ม/เขียวมาแล้วกว่าสิบห้าเจ้า และ
// okkub88 ก็เป็นแบรนด์ ชมพูบานเย็น/ทอง ตระกูลเดียวกับรอบนี้เป๊ะ** รองลงมาคือ
// ถอนชัวร์168 (ชมพูบับเบิลกัม/ทองเนย) —
// **"เจอชมพูกับทอง" จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้** ต้องเทียบหกหลักกับตาราง
// brand-spec §2b ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep หาสีของแบรนด์เก่าเจอ
// false positive ในคอมเมนต์ของไฟล์นี้เอง
// ✅ **#00B900 ของ LINE ไม่อยู่ในไฟล์นี้ และห้ามเอามาใช้เป็นสีแบรนด์**
// รางวงแหวนใช้เส้นคั่น rgba(224,80,159,0.9) = #e0509f (เป็นเส้น ไม่ใช่ตัวอักษร
// ค่านี้จึงใช้ได้ ทั้งที่ถือตัวอักษรบนการ์ดสว่างไม่ได้ — 3.6:1 บนขาว)
// ส่วนชื่อแบรนด์ไล่ ขาวอมชมพู #ffeef8 -> เงินอมชมพู #e8c3da -> ทองอำพัน #f2c14e
// (11.2 -> 7.9 -> 7.4:1 บนแผง #5e1746) ซึ่งอ่านเป็นผิวไล่เฉดของเวิร์ดมาร์ก
// ที่ไล่จากขาวนวลด้านบนลงมาหาขอบทองของแคปซูล
// ⚠️⚠️ **ห้ามใช้ #e0509f หรือ #f3a7d3 เป็นสีตัวอักษรบนแผงนี้**
// ที่ถือตัวอักษรได้บนแผง #5e1746 คือ #ffeef8 (11.2:1) · #e8c3da (7.9:1) ·
// #f2c14e (7.4:1)
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(163, 13, 99, 0.22) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(242, 193, 78, 0.25) 0%, transparent 55%), rgba(43, 6, 32, 0.97);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(163, 13, 99, 0.75);
    border-radius: 1.5rem;
    background: rgba(94, 23, 70, 0.98);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.45),
      0 0 2rem rgba(163, 13, 99, 0.28);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #ffeef8 0%, #e8c3da 55%, #f2c14e 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #f2c14e 0%, #e0509f 55%, #a30d63 100%);
    box-shadow: 0 0 2rem rgba(163, 13, 99, 0.5);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(224, 80, 159, 0.9);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #e0509f;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #f2c14e;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #ffeef8;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: #e8c3da;
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(163, 13, 99, 0.5);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(242, 193, 78, 0.55);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
