---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// NAZA168 (รอบทองอวกาศ-เงินโครเมียม 2026-10-10): หน้าจอคั่นตอนกดปุ่มไป
// ลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render ตัวนี้
// ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก brand-spec §2: backdrop เป็นน้ำตาลไหม้ลึกสุด rgba(36,23,0) =
// #241700 ออร่าบนเป็นทองแบรนด์ rgba(251,193,52) คู่กับเงินโครเมียม
// rgba(207,214,227) ด้านล่าง แผงการ์ดเป็นผิวกลาง rgba(67,43,3) = #432b03
// ออร์บไล่จากทองสว่าง #ffe87a เข้าหาทองแบรนด์ #fbc134 แล้วจบที่ทองลึก #96690a
// (ออร์บเป็นรูปทรง ไม่ใช่ตัวอักษร #96690a จึงใช้ได้ตรงนี้ที่เดียว)
// วงแหวนคู่หมุนสวนทางกันและแยก "สี" กันจริง รอบนี้เป็นสองฮิวจริง (วงนอกทองแบรนด์
// #fbc134 วงในเงินโครเมียม #cfd6e3) เพราะโลโก้รอบนี้เป็นเหรียญกลมขอบทองพื้นดำที่มี
// หมวกนักบินอวกาศโครเมียม-ทองอยู่กลาง คำว่า NAZA เป็นทองสามมิติและเลข 168 เป็น
// เงินโครเมียม — มีฮิวที่สองจริง ไม่ใช่โลหะเดียว รางวงแหวนใช้เส้นขอบ/คั่นจาง
// rgba(63,72,89) = #3f4859 เงินลึก (เป็นเส้น ไม่ใช่ตัวอักษร)
// ส่วนชื่อแบรนด์ไล่ ทองสว่าง #ffe87a -> ทองแบรนด์ #fbc134 -> ทองกลางเข้ม #cf9a18
// ⚠️ ปลายเข้มของ "ตัวอักษร" หยุดที่ #cf9a18 ไม่ใช่ #96690a — #96690a บนแผง #432b03
// ได้แค่ 2.7:1 ตกแม้แต่เกณฑ์ตัวอักษรใหญ่ ส่วน #cf9a18 ได้ 5.2:1 ผ่านสบาย
// (brand-spec §2: #96690a / #6b4a05 / #3f4859 ห้ามถือตัวอักษรทุกขนาด)
// ชุดทองสายฟ้า-แดงเลือดนกของ FLASH877 (#f5c518 #ffdd73 #b8860f #ff3b14
// rgba(245,197,24,α) rgba(255,59,20,α) rgba(92,0,0,α) rgba(125,16,8,α)
// rgba(140,15,10,α) #fdf0e2 rgba(253,240,226,α) rgba(255,221,115,α)) และชุด
// แดงเสือโคร่ง-ทองถ่านไฟของ SUPERSLOTCLUB (#e8232a #f2b705 #f5cbb0 #a8730a
// #7d0f12 #3d1709 #fbe8d5) ไม่เหลือแล้ว
// ⚠️ รอบก่อนก็เป็นแบรนด์ "ทอง" เหมือนกัน แต่คนละค่าทุกตัว และรอบนี้ไม่มีสีแดง
// เป็นฮิวเลย — ฮิวที่สองเป็นเงินโครเมียม ให้เทียบเป็นตัวเลข อย่าเทียบด้วยตา
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(251, 193, 52, 0.26) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(207, 214, 227, 0.2) 0%, transparent 55%), rgba(36, 23, 0, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(251, 193, 52, 0.6);
    border-radius: 1.5rem;
    background: rgba(67, 43, 3, 0.94);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.7),
      0 0 2rem rgba(251, 193, 52, 0.32);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #ffe87a 0%, #fbc134 50%, #cf9a18 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #ffe87a 0%, #fbc134 55%, #96690a 100%);
    box-shadow: 0 0 2rem rgba(251, 193, 52, 0.6);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(63, 72, 89, 0.8);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #fbc134;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #cfd6e3;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #fdf3df;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(253, 243, 223, 0.8);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(251, 193, 52, 0.6);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(255, 232, 122, 0.45);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
