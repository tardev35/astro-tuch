---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// WEPLAY168 (รอบม่วงนีออน-ทองอาร์เขต 2026-10-09): หน้าจอคั่นตอนกดปุ่มไป
// ลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render ตัวนี้
// ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก brand-spec §2: backdrop เป็นพื้นม่วงเกือบดำ rgba(10,1,23) ออร่าเป็น
// ม่วงแบรนด์ rgba(164,53,240) คู่กับทองแบรนด์ rgba(251,228,85) แผงการ์ดเป็นผิวยก
// rgba(30,10,60) = #1e0a3c ออร์บไล่จากเงินอมม่วง #efe6ff เข้าหาทองแบรนด์ #fbe455
// แล้วจบที่ทองเข้ม #c98a05
// วงแหวนคู่หมุนสวนทางกันและแยก "สี" กันจริง รอบนี้เป็นสองฮิวจริง (วงนอกทองแบรนด์
// #fbe455 วงในม่วงแบรนด์ #a435f0) เพราะโลโก้รอบนี้เป็นเครื่องเกมพกพาสีม่วงที่มี
// ตัวอักษร WEPLAY สีเงินอมม่วงและเลข 168 สีทอง — มีฮิวที่สองจริง ไม่ใช่โลหะเดียว
// รางวงแหวนใช้เส้นขอบ/คั่นจาง rgba(91,26,117) = ม่วงลึก
// ส่วนชื่อแบรนด์ไล่ เงินอมม่วง -> ทองแบรนด์ -> ทองเข้ม
// ชุดแดงแล็กเกอร์-ทองของ PIGPG (#fdf9e4 #ffd87a #f5b61d #b07a06 #d4200d #fdeedd
// rgba(245,182,29,α) rgba(212,32,13,α) rgba(176,122,6,α) rgba(253,238,221,α)
// rgba(18,3,2) rgba(58,13,7) rgba(253,249,228,α)) ไม่เหลือแล้ว
// ⚠️ ทองของรอบนี้เป็นคนละค่ากับทองของ PIGPG — อย่าปล่อยค่าเก่าไว้เพราะคล้ายกัน
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(164, 53, 240, 0.28) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(251, 228, 85, 0.18) 0%, transparent 55%), rgba(10, 1, 23, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(164, 53, 240, 0.6);
    border-radius: 1.5rem;
    background: rgba(30, 10, 60, 0.94);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.7),
      0 0 2rem rgba(164, 53, 240, 0.32);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #efe6ff 0%, #fbe455 50%, #c98a05 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #efe6ff 0%, #fbe455 55%, #c98a05 100%);
    box-shadow: 0 0 2rem rgba(164, 53, 240, 0.6);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(91, 26, 117, 0.8);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #fbe455;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #a435f0;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #ece2ff;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(236, 226, 255, 0.8);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(164, 53, 240, 0.6);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(239, 230, 255, 0.45);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
