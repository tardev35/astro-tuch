---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// มีทรัพย์168 (รอบชมพูบานเย็นนำเดี่ยว บนธีมสว่าง 2026-10-21): หน้าจอคั่นตอนกดปุ่ม
// ไปลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render ตัวนี้
// ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก .claude/brand-spec-meesub168.md §2
// ⚠️⚠️ **รอบนี้พื้นเพจเป็นชมพูอมม่วงสว่าง #f0ccf5 (จาก bg.json) ไม่ใช่ดำ** แต่
// overlay ตัวนี้ยังเป็น **พลัมเข้ม** โดยตั้งใจ: มันเป็นชั้นทับเต็มจอที่ต้องกลบหน้า
// ข้างหลังให้สนิท และ backdrop สว่างบนพื้นสว่างจะอ่านไม่ออกว่าเป็นชั้นทับ
// backdrop เป็นชั้นจม rgba(45,7,32) = #2d0720 ออร่าบนเป็น **ชมพูบานเย็นแบรนด์**
// rgba(221,27,116) คู่กับ **โรสเข้ม** rgba(164,24,107) ด้านล่าง — ฮิวนำอยู่บน
// แผงการ์ดเป็นผิวยก rgba(74,13,53) = #4a0d35
// ⚠️ แผงการ์ดต้องสว่างกว่า backdrop เสมอ (#4a0d35 ยก vs #2d0720 จม)
// ออร์บไล่จากชมพูอ่อน #f7dcf6 เข้าหาชมพูบานเย็น #dd1b74 แล้วจบที่โรสเข้ม #a4186b
// — การไล่ "อ่อนออกเข้ม" คืออ่านจากโลโก้ตรงๆ (คำว่า มีทรัพย์ เป็นตัวอักษรสามมิติ
// ไล่เฉดชมพูเข้มไปชมพูอ่อน)
// วงแหวนคู่หมุนสวนทางกันและแยกค่ากันจริง — วงนอก **ชมพูบานเย็น #dd1b74**
// วงใน **ชมพูอ่อน #f7dcf6** (วงแหวนเป็นเส้นตกแต่ง ไม่ใช่ตัวอักษร)
// รางวงแหวนใช้เส้นคั่นจาง rgba(164,24,107,0.8) = #a4186b โรสเข้ม (เป็นเส้น
// ไม่ใช่ตัวอักษร) ส่วนชื่อแบรนด์ไล่ ขาว #ffffff -> ชมพูอ่อน #f7dcf6
// ⚠️ ปลายเข้มของ "ตัวอักษร" หยุดที่ #f7dcf6 (12.6:1 บนแผง #4a0d35) — **ลากลงไป
// ถึงชมพูบานเย็นไม่ได้** #dd1b74 ได้แค่ 3.2:1 บนแผงนี้ และ #a4186b ต่ำกว่านั้น
// ทั้งคู่จึงเป็นพื้นถม/ขอบ/ออรา/วงแหวนเท่านั้น ไม่เคยถือตัวอักษรในไฟล์นี้เลย
// ไล่เฉดชื่อแบรนด์จึงมีสองสต็อป ไม่ใช่สาม เพราะรอบนี้ไม่มีสีที่สามที่ถือตัวอักษรได้
// (brand-spec §2: #dd1b74 และ #a4186b ห้ามถือตัวอักษรบนพื้นเข้ม)
// ⚠️ **ไฟล์นี้เพิ่งเป็นแดงชาดจีน-ทองน้ำผึ้งของ ดวงเศรษฐี168 เมื่อรอบที่แล้วเป๊ะๆ**
// ก่อนหน้านั้นเป็นทองอำพัน-บรอนซ์ของ ufalion168 ทองจักรพรรดิ-แดงชาดของ รวยเทพ168
// แดงชาด-ทองเนยของ มีเฮ168 ฟ้าอะซัวร์-ทองอำพันของ รวยแทร่168 ฟ้า-เหลืองของ
// นินจา168 ฟ้า-ทองของ สบายเบท168 **ชมพูบับเบิลกัมนำ-ทองเนยรองของ ถอนชัวร์168**
// **ทองนำ-ชมพูบานเย็นของ มีโชค168** ทอง-โรสโกลด์ของ ขวัญใจ168 ทองไทย-แดงมังกรของ
// รับตัง168 แดงมังกร-ทองของ สมหวัง168 แดงมังกร-โครเมียมขาวของ GT66B
// แดงเลือดนก-เงินของ TKB55 น้ำเงิน-เงินของ TSDET911 ม่วง-ทองของ KMD88 และ
// ทองล้วนของ TND168 — **มีสามแบรนด์ที่เคยมีชมพูผ่านไฟล์นี้**
// การเจอ "ชมพู" ในไฟล์นี้จึงไม่ได้แปลว่าเป็นของรอบนี้แน่ๆ
// ชมพูรอบนี้คือ #dd1b74 (+#a4186b) ส่วนตัวอักษรเป็น #ffffff กับ #f7dcf6 —
// ให้เทียบเป็นตัวเลขกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive — และรอบนี้ไม่มีค่า
// ทอง/เหลือง/แดงชาด/ฟ้า/น้ำเงิน/ไซยาน/ม่วง/เขียว/เงินโครเมียม/โรสโกลด์/ส้มสด/
// บรอนซ์ เหลือในไฟล์นี้เลย
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(221,27,116, 0.30) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(164,24,107, 0.22) 0%, transparent 55%), rgba(45,7,32, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(221,27,116, 0.65);
    border-radius: 1.5rem;
    background: rgba(74,13,53, 0.94);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.7),
      0 0 2rem rgba(221,27,116, 0.38);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #f7dcf6 0%, #dd1b74 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #f7dcf6 0%, #dd1b74 55%, #a4186b 100%);
    box-shadow: 0 0 2rem rgba(221,27,116, 0.6);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(164,24,107, 0.8);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #dd1b74;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #f7dcf6;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #ffffff;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(247,220,246, 0.85);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(221,27,116, 0.6);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(164,24,107, 0.5);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
