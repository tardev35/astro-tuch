---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// สมหวัง168 (รอบแดงมังกร-ทองไทย 2026-10-17): หน้าจอคั่นตอนกดปุ่มไป
// ลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render ตัวนี้
// ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก .claude/brand-spec-somwang168.md §2: backdrop เป็นแดงเกือบดำจม
// rgba(20,7,6) = #140706 (พื้นเพจรอบนี้เป็นดำอมแดง #290f0f backdrop จึงจมกว่า
// พื้นหนึ่งระดับ ต่างจากรอบก่อนที่พื้นเป็นดำสนิทและ backdrop เสมอกันกับพื้น)
// ออร่าบนเป็นแดงแบรนด์ rgba(250,5,19) คู่กับ **ทองไทย** rgba(227,178,60)
// ด้านล่าง แผงการ์ดเป็นผิวยก rgba(44,20,19) = #2c1413
// ⚠️ แผงการ์ดต้องสว่างกว่า backdrop เสมอ
// ออร์บไล่จากทองสว่าง #ffe5a8 เข้าหาแดงอ่อน #ffadaf แล้วจบที่แดงแบรนด์
// #fa0513 (ออร์บเป็นรูปทรง ไม่ใช่ตัวอักษร #fa0513 จึงใช้ได้ตรงนี้) — การไล่
// "ทองเข้าแดง" คือแบรนด์สองโทนของรอบนี้อ่านจากงานศิลป์ตรงๆ (ลายกนก/นาคทองไทย
// ขนาบสองข้างของแบนเนอร์ ไล่เข้าไปหาเลข 168 แดงสดกลางภาพ)
// วงแหวนคู่หมุนสวนทางกันและแยก "โทน" กันจริง — วงนอกแดงแบรนด์ #fa0513 วงใน
// **ทองไทย #e3b23c** ต่างจากรอบก่อน (GT66B) ที่วงในเป็นโครเมียมขาว
// รางวงแหวนใช้เส้นคั่นจาง rgba(140,2,4,0.8) = #8c0204 แดงถ่าน (เป็นเส้น
// ไม่ใช่ตัวอักษร) ส่วนชื่อแบรนด์ไล่ ทองสว่าง #ffe5a8 -> แดงอ่อน #ffadaf ->
// แดงสว่าง #ff5a5f
// ⚠️ ปลายเข้มของ "ตัวอักษร" หยุดที่ #ff5a5f ไม่ใช่ #fa0513 หรือ #b90203 —
// #fa0513 บนแผง #2c1413 ได้ ~2.6:1 และ #b90203 ต่ำกว่านั้นอีก ส่วน #ff5a5f ได้
// ~5.7:1 ผ่าน AA สำหรับข้อความปกติด้วยซ้ำ
// (brand-spec §2: #fa0513 / #b90203 / #8c0204 / #5b0203 / #3c0303 / #8a6210
// ห้ามถือตัวอักษรทุกขนาด)
// ⚠️ ไฟล์นี้เคยเป็นแดงมังกร-โครเมียมขาวของ GT66B ก่อนหน้านั้นเป็นแดงเลือดนก-เงิน
// ของ TKB55 น้ำเงิน-เงินของ TSDET911 ม่วง-ทองของ KMD88 และทองล้วนของ TND168 —
// และก่อนหน้านั้นอีกมีแบรนด์แดงอยู่จริง (FLASH877 / PIGPG / SUPERSLOTCLUB)
// การเจอ "แดง" หรือ "ทอง" ในไฟล์นี้จึง **ไม่ได้แปลว่าเป็นของรอบนี้** โดยเฉพาะ
// รอบนี้ที่สองแบรนด์ก่อนหน้าก็แดงทั้งคู่ ให้เทียบเป็นตัวเลขกับตารางใน
// brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ
// false positive — และรอบนี้ไม่มีค่าม่วง/ชมพู/เขียว/น้ำเงิน/ฟ้า/ส้มเหลือในไฟล์นี้เลย
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(250, 5, 19, 0.3) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(227, 178, 60, 0.18) 0%, transparent 55%), rgba(20, 7, 6, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(250, 5, 19, 0.65);
    border-radius: 1.5rem;
    background: rgba(44, 20, 19, 0.94);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.7),
      0 0 2rem rgba(250, 5, 19, 0.38);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #ffe5a8 0%, #ffadaf 50%, #ff5a5f 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #ffe5a8 0%, #ffadaf 55%, #fa0513 100%);
    box-shadow: 0 0 2rem rgba(250, 5, 19, 0.6);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(140, 2, 4, 0.8);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #fa0513;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #e3b23c;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #f4ecea;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(244, 236, 234, 0.8);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(250, 5, 19, 0.6);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(227, 178, 60, 0.45);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
