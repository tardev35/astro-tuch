---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// สบายเบท168 (รอบฟ้าบับเบิลนำ-ทองรอง บนดำสนิท 2026-10-19): หน้าจอคั่นตอนกดปุ่มไป
// ลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render ตัวนี้
// ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก .claude/brand-spec-sabuybet168.md §2: backdrop เป็นน้ำเงินจม
// rgba(4,13,22) = #040d16 (พื้นเพจรอบนี้เป็น **ดำสนิท #000000** backdrop จึงไม่
// จมกว่าพื้นได้แล้ว แต่ยังอ่านออกว่าเป็นชั้นทับเพราะมีออร่าสองวงและแผงการ์ดสว่าง
// กว่าอย่างชัดเจน) ออร่าบนเป็น **ฟ้าแบรนด์** rgba(47,159,245) คู่กับ
// **ทอง** rgba(255,200,46) ด้านล่าง — ฮิวนำอยู่บน ฮิวที่สองอยู่ล่าง
// แผงการ์ดเป็นผิวยก rgba(14,34,56) = #0e2238
// ⚠️ แผงการ์ดต้องสว่างกว่า backdrop เสมอ
// ออร์บไล่จากฟ้าซีด #d6ecff เข้าหาฟ้าแบรนด์ #2f9ff5 แล้วจบที่ทอง #ffc82e —
// การไล่ "ฟ้าออกทอง" คืออ่านจากตัวอักษรบนโลโก้ตรงๆ (คำว่า เบท168 เป็นฟ้าบับเบิล
// ผิวมันวาว ส่วนคำว่า สบาย ที่อยู่ก่อนหน้าเป็นทอง)
// วงแหวนคู่หมุนสวนทางกันและแยก "โทน" กันจริง — วงนอก **ฟ้าแบรนด์ #2f9ff5**
// วงใน **ทอง #ffc82e**
// รางวงแหวนใช้เส้นคั่นจาง rgba(11,63,120,0.8) = #0b3f78 น้ำเงินลึก (เป็นเส้น
// ไม่ใช่ตัวอักษร) ส่วนชื่อแบรนด์ไล่ ฟ้าซีด #d6ecff -> ฟ้าแบรนด์ #2f9ff5 ->
// ทอง #ffc82e
// ⚠️ ปลายเข้มของ "ตัวอักษร" หยุดที่ #2f9ff5 ไม่ใช่ #0b3f78 หรือ #5c4a16 —
// #0b3f78 บนแผง #0e2238 ได้ ~1.4:1 และ #5c4a16 ได้ ~1.9:1 ตก AA ทั้งคู่
// ส่วน #2f9ff5 ได้ ~5.9:1
// (brand-spec §2: #0b3f78 / #5c4a16 ห้ามถือตัวอักษรทุกขนาด)
// ⚠️ ไฟล์นี้เคยเป็นชมพูบับเบิลกัมนำ-ทองเนยรองของ ถอนชัวร์168 ก่อนหน้านั้นเป็นทองนำ-
// ชมพูบานเย็นของ มีโชค168 ทอง-โรสโกลด์ของ ขวัญใจ168 ทองไทย-แดงมังกรของ รับตัง168
// แดงมังกร-ทองของ สมหวัง168 แดงมังกร-โครเมียมขาวของ GT66B แดงเลือดนก-เงินของ TKB55
// **น้ำเงิน-เงินของ TSDET911** ม่วง-ทองของ KMD88 และทองล้วนของ TND168 —
// **เกือบทุกแบรนด์ที่ผ่านไฟล์นี้มีทอง และเคยมีรอบที่เป็นน้ำเงินมาแล้วด้วย**
// การเจอ "ทอง" หรือ "ฟ้า/น้ำเงิน" ในไฟล์นี้จึงไม่ได้แปลว่าเป็นของรอบนี้
// ฟ้ารอบนี้คือ #2f9ff5 (+#a8dcff +#d6ecff +#0b3f78) และทองรอบนี้คือ #ffc82e
// ให้เทียบเป็นตัวเลขกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่เพื่อไม่ให้ grep
// หาสีของแบรนด์เก่าเจอ false positive — และรอบนี้ไม่มีค่าชมพู/แดง/ม่วง/เขียว/ส้ม/
// เงินโครเมียม/โรสโกลด์ เหลือในไฟล์นี้เลย
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(47, 159, 245, 0.28) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(255, 200, 46, 0.22) 0%, transparent 55%), rgba(4, 13, 22, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(47, 159, 245, 0.65);
    border-radius: 1.5rem;
    background: rgba(14, 34, 56, 0.94);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.7),
      0 0 2rem rgba(47, 159, 245, 0.38);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #d6ecff 0%, #2f9ff5 50%, #ffc82e 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #d6ecff 0%, #2f9ff5 55%, #ffc82e 100%);
    box-shadow: 0 0 2rem rgba(47, 159, 245, 0.6);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(11, 63, 120, 0.8);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #2f9ff5;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #ffc82e;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #e8f4ff;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(232, 244, 255, 0.8);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(47, 159, 245, 0.6);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(255, 200, 46, 0.5);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
