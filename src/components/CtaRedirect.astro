---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// รวย168 (รอบทองนำ โครเมียมเงินรอง บน **ธีมมืด**): หน้าจอคั่นตอนกดปุ่มไปลิงก์
// พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render ตัวนี้
// ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก .claude/brand-spec-ruay168.md §2 (โซน "โครม")
// ⚠️ **รอบนี้พื้นเพจเป็นดำสนิท #000000 (จาก bg.json ซึ่งรอบก่อนเป็น 00091f =
// น้ำเงินเที่ยงคืน)** overlay ตัวนี้เป็น **โครม จึงเป็นผิวมืดอยู่แล้วเหมือนทุกรอบ**
// — มันต้องกลบหน้าข้างหลังได้สนิท ซึ่งเป็นเหตุผลเดียวกันทุกรอบ
// **ห้าม "แก้" ให้สว่างตามพื้นเพจ**
// backdrop เป็นชั้นพื้นเพจ rgba(0,0,0) = #000000 ออร่าบนเป็น **ทองแกนแบรนด์**
// rgba(255,217,74) คู่กับ **โครเมียมเงิน** rgba(232,234,238) ด้านล่าง
// — ฮิวนำอยู่บน แผงการ์ดเป็นผิวกลาง rgba(18,17,16) = #121110
// ⚠️ แผงการ์ดต้องสว่างกว่า backdrop เสมอ (#121110 กลาง vs #000000 พื้นเพจ)
// ⚠️ ค่าทุกค่าในไฟล์นี้อยู่ในชุด rgba ที่ brand-spec §2 อนุญาต (255/217/74 ·
// 227/167/18 · 176/125/8 · 232/234/238 · 221/225/231 · 61/52/37 · 0/0/0)
// โดยตั้งใจ
// ออร์บไล่จากทองสว่าง #ffd94a เข้าหาทองพื้นปุ่ม #e3a712 แล้วจบที่ทองลึก #b07d08
// — การไล่ "สว่างออกเข้ม" คืออ่านจากโลโก้ตรงๆ (เลข "168" เป็นตัวอักษรสามมิติผิว
// มันวาวสีทอง ไล่จากทองสว่างที่ยอดลงทองเข้มที่ฐาน มีไฮไลต์ขาวพาดบนผิว)
// วงแหวนคู่หมุนสวนทางกันและแยกค่ากันจริง — วงนอก **ทอง #ffd94a**
// วงใน **โครเมียมเงิน #e8eaee** ซึ่งคือคู่วัสดุบนเวิร์ดมาร์กเป๊ะๆ: "รวย"
// โครเมียมเงิน ต่อด้วย "168" ทอง พร้อมมงกุฎทองบนตัวอักษรตัวแรก
// ⚠️⚠️ **ผมสีขาวเงิน สูทขาว ลิปสติกแดง และสีผิวนักแสดงในอาร์ตเวิร์กเป็น
// วัตถุในภาพ ไม่ใช่สี UI — ห้ามเอาแดง/ครีม/พีช/เบจกลับเข้ามา**
// (โครเมียมเงิน #e8eaee รอบนี้มาจาก **เวิร์ดมาร์ก** ไม่ใช่จากผมของนักแสดง)
// รางวงแหวนใช้เส้นคั่นจาง rgba(61,52,37,0.8) = #3d3425 (เป็นเส้น ไม่ใช่ตัวอักษร
// ค่านี้จึงใช้ได้ ทั้งที่ถือตัวอักษรไม่ได้)
// ส่วนชื่อแบรนด์ไล่ โครเมียมเงิน #e8eaee -> ทอง #ffd94a (16.0 -> 13.8:1 บนแผง
// #121110) ซึ่งอ่านเป็นเวิร์ดมาร์กจริง: ตัวอักษรโครเมียมที่จบด้วยเลขทอง
// ⚠️ ปลายของ "ตัวอักษร" หยุดที่ #ffd94a — **ลากลงไปถึง #b07d08 ไม่ได้บนแผงเข้มนี้**
// เพราะทองลึกได้แค่ 4.3:1 บน #121110 ซึ่งคาบเส้นเกินไปสำหรับตัวอักษร letter-spacing
// กว้างขนาดนี้
// ⚠️⚠️ **ไฟล์นี้เพิ่งเป็นแดงคริมสัน-น้ำเงินอะซัวร์ของ มาดาม168 เมื่อรอบที่แล้วเป๊ะๆ**
// (ff2e52 e01238 c9102f 1177e8 0e68cc 0a4ea8 00091f 050e26 0b1733 16234a 2a3c70
// f4eef1 b3bdd6 d9dfe9 — **ชุดที่เสี่ยงหลงเหลือที่สุด**) ก่อนหน้านั้นเป็นฟ้าไซยาน-
// น้ำเงินอุลตรามารีนของ นาซ่า168 (1fd8f0 0bb6d4 8fd9ec 1d4fd8 143aa0 e6edf8 9fb2cb
// 1b2434 33455f 0d1017) ก่อนหน้านั้นเป็นฟ้าไซยาน-ครีมอุ่นของ ร่ำรวย168 (18a5e2
// 0d6b9b a9d7f2 f4e4d3 e4cbb3 111a3f 202a66 31408a e9f1ff adc0e4) ก่อนหน้านั้น
// เป็นทองแกน-ครีมอุ่นของ เงินทอง168 (f5ba14 fcee52 b37c0b ecd5c4 d2b9a4 1b1407
// 2e2512 4d3c15 29210f) ก่อนหน้านั้นเป็นทองแกน-โครเมียมเงินของ พักยก168 (eeae12
// fded41 9f600d e0e0df c0c0bf a1a09e f4ead6 d6c6a8 291d0f 2f1e0f 1f0f04 4e2f11)
// ก่อนหน้านั้นเป็นฟ้าสกาย-ทองคานารีของ สบาย168 (2cc3fc 6bdcfb 0a7fbd 063a57 04293d
// 0a4f74 fdcb0c eafaff) ก่อนหน้านั้นเป็นทองคานารี-โครเมียมเงินของ ยูฟ้า168 (fee45d
// e6a416 b8780d 7a4e05 e8ecf1 a8b2bf 78828f 5a6472 15130f 1e1a13 0a0908 eae3d4
// fff8dd) ก่อนหน้านั้นเป็นแดงเชอร์รี่-ทองแดงไหม้ของ โปรดี168 (eb0305 9b0a0c ff4446
// b44c06 f0b46a 401107 fff4ea fff0e4) แดงคริมสัน-ทองโบราณของ รวยแท้168 เขียวมรกต-
// ทองสัมฤทธิ์ของ สาธุ168 ชมพูบานเย็นของ มีทรัพย์168 แดงชาด-ทองน้ำผึ้งของ
// ดวงเศรษฐี168 ทองอำพัน-บรอนซ์ของ ufalion168 ทองจักรพรรดิ-แดงชาดของ รวยเทพ168
// แดงชาด-ทองเนยของ มีเฮ168 ทอง-โรสโกลด์ของ ขวัญใจ168 ทองไทย-แดงมังกรของ รับตัง168
// แดงมังกร-ทองของ สมหวัง168 แดงมังกร-โครเมียมของ GT66B
// 🚨🚨 **ทองผ่านไฟล์นี้มาแล้วหลายเจ้ามาก** การเจอ "ทอง" ในไฟล์นี้จึงไม่ได้แปลว่า
// เป็นของรอบนี้ ทองรอบนี้คือ **#ffd94a** (+#e3a712 #b07d08) เพื่อนบ้านที่ใกล้ที่สุด
// คือ **ffd84d ของถอนชัวร์168 ห่างแค่ R0/G1/B3 — ใกล้ที่สุดในลิสต์ ถ้าเจอค่านั้น
// แปลว่าพิมพ์ผิด** · fcd45c ของมีเฮ168 ห่าง R3/G5/B18 · fcd434 ของมีโชค168
// ห่าง R3/G5/B22 · ffc93c ของหวย365 ห่าง R0/G16/B14 — ให้เทียบเป็นตัวเลขกับตาราง
// ใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ
// false positive — และรอบนี้ไม่มีค่าแดง/ชมพู/ม่วง/ส้ม/เขียว/น้ำเงิน/ฟ้า/โรสโกลด์/
// น้ำตาล/ครีม เหลือในไฟล์นี้เลย
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(255,217,74, 0.20) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(232,234,238, 0.10) 0%, transparent 55%), rgba(0,0,0, 0.97);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(227,167,18, 0.65);
    border-radius: 1.5rem;
    background: rgba(18,17,16, 0.96);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.7),
      0 0 2rem rgba(227,167,18, 0.28);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #e8eaee 0%, #ffd94a 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #ffd94a 0%, #e3a712 55%, #b07d08 100%);
    box-shadow: 0 0 2rem rgba(227,167,18, 0.5);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(61,52,37, 0.8);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #ffd94a;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #e8eaee;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #f3ece0;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: #bfb8aa;
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(227,167,18, 0.5);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(232,234,238, 0.35);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
