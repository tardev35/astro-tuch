---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// KMD88 (รอบม่วงราชา-ทอง 2026-10-13): หน้าจอคั่นตอนกดปุ่มไป
// ลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render ตัวนี้
// ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก brand-spec §2: backdrop เป็นม่วงจม rgba(10,2,19) = #0a0213
// (พื้นเพจรอบนี้เป็นดำสนิท #000000 แล้ว backdrop จึงเสมอกันกับพื้นแทบทั้งหมด —
// ความต่างมาจากออร่าสองจุดแทน) ออร่าบนเป็นม่วงแบรนด์ rgba(117,5,204) คู่กับ
// ทองแบรนด์ rgba(226,179,63) ด้านล่าง แผงการ์ดเป็นผิวยก rgba(29,8,50) = #1d0832
// ⚠️ แผงการ์ดต้องสว่างกว่า backdrop เสมอ
// ออร์บไล่จากทองสว่าง #ffdf8c เข้าหาทองแบรนด์ #e2b33f แล้วจบที่ม่วงแบรนด์ #7505cc
// (ออร์บเป็นรูปทรง ไม่ใช่ตัวอักษร #7505cc จึงใช้ได้ตรงนี้) — การไล่ "ทองเข้าม่วง"
// คือแบรนด์สองฮิวของรอบนี้อ่านจากโลโก้ตรงๆ (เลข 88 ทอง + ตัวอักษร KMD ม่วง)
// วงแหวนคู่หมุนสวนทางกันและแยก "ฮิว" กันจริง — วงนอกม่วงสว่าง #b453ff วงในทอง
// แบรนด์ #e2b33f ต่างจากรอบก่อน (TND168) ที่เป็นทองล้วนสองระดับของสีเดียว
// รางวงแหวนใช้เส้นคั่นจาง rgba(58,5,101,0.8) = #3a0565 ม่วงลึกสุด (เป็นเส้น ไม่ใช่
// ตัวอักษร) ส่วนชื่อแบรนด์ไล่ ทองสว่าง #ffdf8c -> ทองแบรนด์ #e2b33f -> ม่วง #c07cff
// ⚠️ ปลายเข้มของ "ตัวอักษร" หยุดที่ #c07cff ไม่ใช่ #7505cc หรือ #b453ff —
// #7505cc บนแผง #1d0832 ได้ ~2.9:1 และ #b453ff ได้ ~4.0:1 ส่วน #c07cff ได้
// ~5.3:1 ผ่าน AA สำหรับข้อความปกติด้วยซ้ำ
// (brand-spec §2: #7505cc / #b453ff / #3a0565 / #2c0349 / #7a5a0a ห้ามถือตัวอักษร
// ทุกขนาด)
// ⚠️ ไฟล์นี้เคยเป็นทองล้วนของ TND168 ก่อนหน้านั้นเป็นชมพู-ทองของ PUNPRO168 และ
// ก่อนหน้านั้นเป็นทองของ TIGERWIN369 การเจอทอง **หรือม่วง** จึงไม่ได้แปลว่าเป็น
// ของรอบนี้ (WEPLAY168 ก็เป็นม่วง-ทอง) ให้เทียบเป็นตัวเลขกับตารางใน brand-spec §2
// ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive —
// และรอบนี้ไม่มีค่าชมพู/เงิน/เทา/เขียว/แดง/น้ำเงินเหลืออยู่ในไฟล์นี้เลย
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(117, 5, 204, 0.3) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(226, 179, 63, 0.18) 0%, transparent 55%), rgba(10, 2, 19, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(117, 5, 204, 0.65);
    border-radius: 1.5rem;
    background: rgba(29, 8, 50, 0.94);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.7),
      0 0 2rem rgba(117, 5, 204, 0.38);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #ffdf8c 0%, #e2b33f 50%, #c07cff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #ffdf8c 0%, #e2b33f 55%, #7505cc 100%);
    box-shadow: 0 0 2rem rgba(117, 5, 204, 0.6);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(58, 5, 101, 0.8);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #b453ff;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #e2b33f;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #ece2f8;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(236, 226, 248, 0.8);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(117, 5, 204, 0.6);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(226, 179, 63, 0.45);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
