---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// หวย365 (รอบแดงสด-ทอง 2026-10-02): หน้าจอคั่นตอนกดปุ่มไปลิงก์พันธมิตร
// แสดงเฉพาะ /login กับ /register — พื้นหลังดำ rgb(0,0,0) แผงการ์ดแดงเกือบดำ
// rgba(36,4,6) ออร่าเป็นแดงแบรนด์ rgba(220,2,3) กับทอง rgba(255,201,60)
// ออร์บไล่จากทองอ่อน #ffeab0 เข้าหาแดงแบรนด์ #dc0203 แล้วจบที่แดงลึก #9c0201
// วงแหวนคู่แยกสีกันคนละวง (วงนอกแดงสว่าง #f5282a วงในทอง #ffc93c) หมุนสวนทางกัน
// ตามคู่สีของโลโก้ที่คำว่า "หวย" กับเลข 6 เป็นแดงสด บนอาร์ตเวิร์กฉากผ้าซาตินแดง
// ที่มีริ้วแสงทอง เหรียญทอง ลายไทยทอง และลูกหวย — รอบก่อน (หวยเฮง789) เป็นแดง
// อมชมพูหม่นกับทองน้ำตาล ชุดเดิม (#dc2224 #f4bc5d #ffefc2 #ab0204 #e43434
// rgba(43,9,9) rgba(92,10,10) rgba(251,227,212) rgba(11,2,2)) ไม่เหลือแล้ว
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(220, 2, 3, 0.32) 0%, transparent 55%),
      radial-gradient(circle at 50% 90%, rgba(255, 201, 60, 0.26) 0%, transparent 55%),
      rgba(0, 0, 0, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(220, 2, 3, 0.5);
    border-radius: 1.5rem;
    background: rgba(36, 4, 6, 0.94);
    box-shadow:
      0 1rem 3rem rgba(8, 1, 1, 0.6),
      0 0 2rem rgba(220, 2, 3, 0.24);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #ffeab0 0%, #ffc93c 45%, #dc0203 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #ffeab0 0%, #dc0203 55%, #9c0201 100%);
    box-shadow: 0 0 2rem rgba(220, 2, 3, 0.5);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(72, 6, 7, 0.6);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #f5282a;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #ffc93c;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #ffeab0;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(246, 231, 224, 0.78);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(220, 2, 3, 0.5);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(255, 201, 60, 0.45);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
