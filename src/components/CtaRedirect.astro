---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// FLASH877 (รอบทองสายฟ้า-แดงเลือดนก 2026-10-10): หน้าจอคั่นตอนกดปุ่มไป
// ลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render ตัวนี้
// ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก brand-spec §2: backdrop เป็นพื้นแดงเลือดนก rgba(92,0,0) = พื้นเพจ
// ของดรอปนี้ ออร่าบนเป็นทองสายฟ้า rgba(245,197,24) คู่กับแดงสายฟ้า rgba(255,59,20)
// ด้านล่าง แผงการ์ดเป็นผิวยก rgba(125,16,8) = #7d1008 ออร์บไล่จากทองสว่าง #ffdd73
// เข้าหาทองสายฟ้า #f5c518 แล้วจบที่ทองเข้ม #b8860f
// วงแหวนคู่หมุนสวนทางกันและแยก "สี" กันจริง รอบนี้เป็นสองฮิวจริง (วงนอกทองสายฟ้า
// #f5c518 วงในแดงสายฟ้า #ff3b14) เพราะโลโก้รอบนี้เป็นสายฟ้าทองผ่ากลางเหรียญขอบทอง
// พื้นแดงเข้ม คำว่า FLASH เป็นทองและเลข 877 เป็นแดงสด — มีฮิวที่สองจริง ไม่ใช่
// โลหะเดียว รางวงแหวนใช้เส้นขอบ/คั่นจาง rgba(140,15,10) = แดงเข้ม
// ส่วนชื่อแบรนด์ไล่ ทองสว่าง -> ทองสายฟ้า -> ทองเข้ม ตามลำดับที่ตาอ่านคำว่า FLASH
// ชุดแดงเสือโคร่ง-ทองถ่านไฟของ SUPERSLOTCLUB (#e8232a #f2b705 #f5cbb0 #a8730a
// #7d0f12 #3d1709 #fbe8d5 rgba(232,35,42,α) rgba(242,183,5,α) rgba(36,16,0,α)
// rgba(61,23,9,α) rgba(125,15,18,α) rgba(251,232,213,α) rgba(245,203,176,α))
// ไม่เหลือแล้ว ⚠️ รอบก่อนก็เป็นคู่ "แดง-ทอง" เหมือนกัน แต่คนละค่าทุกตัวและสลับ
// ลำดับฮิว (รอบก่อนแดงนำ รอบนี้ทองนำ) ให้เทียบเป็นตัวเลข อย่าเทียบด้วยตา
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(245, 197, 24, 0.26) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(255, 59, 20, 0.2) 0%, transparent 55%), rgba(92, 0, 0, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(245, 197, 24, 0.6);
    border-radius: 1.5rem;
    background: rgba(125, 16, 8, 0.94);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.7),
      0 0 2rem rgba(245, 197, 24, 0.32);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #ffdd73 0%, #f5c518 50%, #b8860f 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #ffdd73 0%, #f5c518 55%, #b8860f 100%);
    box-shadow: 0 0 2rem rgba(245, 197, 24, 0.6);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(140, 15, 10, 0.8);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #f5c518;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #ff3b14;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #fdf0e2;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(253, 240, 226, 0.8);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(245, 197, 24, 0.6);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(255, 221, 115, 0.45);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
