---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// WIN8S (รอบส้มเพลิงนำ ทองอำพัน/เงินโครเมียมรอง · **มืดทั้งเว็บ**):
// หน้าจอคั่นตอนกดปุ่มไปลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่น
// ในเว็บ render ตัวนี้ ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง
// convert พอดี สีทุกค่ามาจาก .claude/brand-spec-win8s.md §2
// ⚠️⚠️⚠️ **รอบนี้มืดทั้งเว็บ (bg.json = 1e0101 ดำอมเลือดหมู)** ทั้งเนื้อหาและโครม
// — รอบก่อน 123BET เนื้อหาสว่าง โครมเข้ม จอคั่นจึงเป็นจอเข้มทั้งสองรอบ แต่
// **ด้วยเหตุผลคนละอย่าง** รอบก่อนความเข้มคือสิ่งที่แยกจอออกจากหน้าสว่าง
// **รอบนี้หน้าก็เข้ม** สิ่งที่ทำให้กลบหน้าข้างหลังได้สนิทคือ **ค่า alpha (0.97)**
// ไม่ใช่ความมืด — **ห้ามลดค่า alpha ลงเพราะคิดว่า "มันก็มืดอยู่แล้ว"**
// backdrop เป็นชั้นโครมลึกสุด rgba(20,3,2) = #140302 ออร่าบนเป็น **ส้มเพลิง
// แกนแบรนด์** rgba(242,122,26) คู่กับ **ทองอำพัน** rgba(229,169,43) ด้านล่าง
// — ฮิวนำอยู่บน แผงการ์ดเป็นโครมชั้นยกของรอบนี้ rgba(59,19,11) = #3b130b
// ⚠️ แผงการ์ดต้อง **ต่างค่า** จาก backdrop เสมอ (รอบนี้ #3b130b vs #140302
// ของ backdrop — แผง "สว่างกว่า" พื้น)
// ⚠️ ค่าทุกค่าในไฟล์นี้อยู่ในชุด rgba ที่ brand-spec §2 อนุญาต (242/122/26 ·
// 229/169/43 · 138/58/18 · 30/1/1 · 20/3/2) บวกผิวแผง 59/19/11
// ออร์บไล่จากทองอำพัน #e5a92b เข้าหาส้มเพลิงแกน #f27a1a แล้วจบที่น้ำตาลไหม้
// #8a3a12 — การไล่ "สว่างออกเข้ม" คืออ่านจากเวิร์ดมาร์กตรงๆ (ตัวอักษรสามมิติ
// สี่ตัวแรกผิวส้มเพลิงไล่เป็นทองตัดขอบดำมีไฮไลต์ขาววาบ ตัวสุดท้ายผิวโครเมียมเงิน
// ขัดเงา วางบนรอยพู่กันสีดำและแถบสีทองสาด)
// วงแหวนคู่หมุนสวนทางกันและแยกค่ากันจริง — วงนอก **ส้มเพลิงแกน #f27a1a**
// วงใน **ทองอำพัน #e5a92b** ซึ่งคือคู่วัสดุบนอาร์ตเวิร์ก: ตัวอักษรส้มตัดขอบทอง
// บนเวิร์ดมาร์ก กับแคปซูลพื้นดำขอบช่อใบไม้ทองบนสไลด์ทั้งสองใบ
// ⚠️⚠️ **ห้องญี่ปุ่นโทนขาวงาช้าง ซากุระชมพู-ขาว สีผิวนักแสดง และฉากสว่างใน
// อาร์ตเวิร์กเป็นวัตถุในภาพ ส่วนส้ม/ทอง/เงินของ UI มาจากเวิร์ดมาร์กกับตราสัญลักษณ์**
// พื้นจอคั่นมาจาก brand-spec §2 เท่านั้น **ห้ามดูดสีจากรูป**
// 🚨🚨 **ไฟล์นี้เคยเป็นทอง/แดง/ชมพู/ฟ้า/ม่วง/ส้ม/เขียวมาแล้วกว่าสิบห้าเจ้า และ
// ZNOVA168 ก็เป็นแบรนด์ น้ำตาลเข้ม/อำพัน ตระกูลเดียวกับรอบนี้เป๊ะ** —
// **"เจอส้มทองเงิน" จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้** ต้องเทียบหกหลักกับตาราง
// brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep หาสีของแบรนด์เก่าเจอ
// false positive ในคอมเมนต์ของไฟล์นี้เอง
// รางวงแหวนใช้เส้นคั่น rgba(138,58,18,0.9) = #8a3a12 (เป็นเส้น ไม่ใช่ตัวอักษร
// ค่านี้จึงใช้ได้ ทั้งที่ถือตัวอักษรไม่ได้ — 2.5:1 บนพื้นเพจ)
// ส่วนชื่อแบรนด์ไล่ ครีมอุ่น #fdf0e6 -> เงินโครเมียม #c9d2dc -> ทองอำพัน #e5a92b
// (14.6 -> 10.7 -> 7.8:1 บนแผง #3b130b) ซึ่งอ่านเป็นผิวโครเมียมขัดเงาของ
// ตัวอักษรตัวสุดท้ายที่ไล่จากเงินสว่างลงมาหาขอบทอง
// ⚠️⚠️ **ห้ามใช้ #8a3a12 หรือ #5a2410 เป็นสีตัวอักษรบนแผงนี้**
// ที่ถือตัวอักษรได้บนแผง #3b130b คือ #fdf0e6 (14.6:1) · #c9d2dc (10.7:1) ·
// #e0bda4 (9.3:1) · #e5a92b (7.8:1) · #f27a1a (5.9:1)
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(242, 122, 26, 0.22) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(229, 169, 43, 0.25) 0%, transparent 55%), rgba(20, 3, 2, 0.97);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(242, 122, 26, 0.75);
    border-radius: 1.5rem;
    background: rgba(59, 19, 11, 0.98);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.45),
      0 0 2rem rgba(242, 122, 26, 0.28);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #fdf0e6 0%, #c9d2dc 55%, #e5a92b 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #e5a92b 0%, #f27a1a 55%, #8a3a12 100%);
    box-shadow: 0 0 2rem rgba(242, 122, 26, 0.5);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(138, 58, 18, 0.9);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #f27a1a;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #e5a92b;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #fdf0e6;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: #c9d2dc;
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(242, 122, 26, 0.5);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(229, 169, 43, 0.55);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
