---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// ZORO365 (รอบเขียวมรกตนำ เงินโครเมียม/ทองอำพันรอง · **มืดทั้งเว็บ**): หน้าจอ
// คั่นตอนกดปุ่มไปลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ
// render ตัวนี้ ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก .claude/brand-spec-zoro365.md §2
// ⚠️⚠️⚠️ **รอบนี้ทั้งเว็บเป็นผิวเข้ม** (bg.json = 002908 เขียวป่าจมเกือบดำ)
// โครมทั้งชุด (navbar/footer/ticker/แถบล่างมือถือ) เป็นเขียวป่าเข้ม จอคั่นจึงอยู่ใน
// ชุดเดียวกันอยู่แล้ว **ห้ามทำให้เป็นจอสว่างเด็ดขาด**
// สิ่งที่ทำให้กลบหน้าข้างหลังได้สนิทคือ **ค่า alpha (0.97)** ไม่ใช่ความมืดหรือความสว่าง
// backdrop เป็นชั้นหมึกดำลึกสุด rgba(1,13,4) = #010d04 ออร่าบนเป็น **เขียวมรกต
// แกนแบรนด์** rgba(61,220,74) คู่กับ **ทองอำพัน** rgba(232,200,106) ด้านล่าง
// — ฮิวนำอยู่บน แผงการ์ดเป็นผิวการ์ดของรอบนี้ rgba(7,60,26) = #073c1a
// ⚠️ แผงการ์ดต้อง **ต่างค่า** จาก backdrop เสมอ (รอบนี้ #073c1a vs #010d04
// ของ backdrop — แผง "สว่างกว่า" พื้น)
// ⚠️ ค่าทุกค่าในไฟล์นี้อยู่ในชุด rgba ที่ brand-spec §2 อนุญาต (61/220/74 ·
// 53/160/67 · 30/112/51 · 232/200/106 · 223/230/227 · 1/13/4) บวกผิวแผง 7/60/26
// ออร์บไล่จากทองอำพัน #e8c86a เข้าหาเขียวมรกตแกน #3ddc4a แล้วจบที่เส้นเขียวเข้ม
// #1e7033 — การไล่ "สว่างออกเข้ม" คืออ่านจากโลโก้ตรงๆ (เวิร์ดมาร์กสามมิติ ครึ่งแรก
// เป็นตัวอักษรละตินผิวโครเมียมเงินขัดเงา ครึ่งหลังเป็นตัวเลขผิวเขียวมรกตเคลือบเงา
// เรืองแสง ตัดขอบดำหนา วางทับวงพู่กันหมึกที่มีดาบคาทานะปักตั้งผ่ากลางวง)
// วงแหวนคู่หมุนสวนทางกันและแยกค่ากันจริง — วงนอก **เขียวมรกตแกน #3ddc4a**
// วงใน **ทองอำพัน #e8c86a** ซึ่งคือคู่วัสดุบนอาร์ตเวิร์ก: ตัวเลขเขียวมรกตเคลือบเงา
// บนเวิร์ดมาร์ก กับแคปซูลพื้นดำขอบทองบนแบนเนอร์และสไลด์
// ⚠️⚠️ **ผิวเงินโครเมียม สีผิวนักแสดง กอไผ่ และฉากห้องสว่างในอาร์ตเวิร์กเป็นวัตถุ
// ในภาพ ส่วนเขียว/ทอง/เงินของ UI มาจากเวิร์ดมาร์กกับแคปซูลขอบทอง** พื้นจอคั่น
// มาจาก brand-spec §2 เท่านั้น **ห้ามดูดสีจากรูป**
// 🚨🚨 **รอบก่อนหน้าทันทีก็เป็นแบรนด์เขียว + เงินโครเมียม + ทองอำพันเหมือนกันเป๊ะ
// ต่างกันแค่กลับทิศสว่าง-มืด** และไฟล์นี้เคยเป็นทอง/แดง/ชมพู/ฟ้า/ม่วง/ส้มมาแล้วกว่า
// สิบสี่เจ้า — **"เจอเขียวทองเงิน" จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้** ต้องเทียบหกหลัก
// กับตาราง brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep หาสีของแบรนด์เก่า
// เจอ false positive ในคอมเมนต์ของไฟล์นี้เอง
// รางวงแหวนใช้เส้นคั่น rgba(53,160,67,0.9) = #35a043 (เป็นเส้น ไม่ใช่ตัวอักษร
// ค่านี้จึงใช้ได้ ทั้งที่ถือตัวอักษรไม่ได้ — 3.8:1 บนแผง)
// ส่วนชื่อแบรนด์ไล่ เงินโครเมียม #dfe6e3 -> เขียวมรกต #3ddc4a (9.9 -> 6.9:1
// บนแผง #073c1a) ซึ่งอ่านเป็นเวิร์ดมาร์กจริง: ครึ่งแรกเงินขัดเงา ครึ่งหลังเขียวเรืองแสง
// ⚠️⚠️ **ห้ามใช้ #35a043 หรือ #1e7033 เป็นสีตัวอักษรบนแผงนี้** (3.8 / 2.1:1 —
// ตกทั้งคู่) ที่ถือตัวอักษรได้คือ #eef7f0 (12.0:1) · #dfe6e3 (9.9:1) · #e8c86a
// (8.0:1) · #3ddc4a (6.9:1) · #9dc2a5 (6.3:1)
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(61,220,74, 0.22) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(232,200,106, 0.25) 0%, transparent 55%), rgba(1,13,4, 0.97);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(30,112,51, 0.75);
    border-radius: 1.5rem;
    background: rgba(7,60,26, 0.98);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.45),
      0 0 2rem rgba(61,220,74, 0.28);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #dfe6e3 0%, #3ddc4a 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #e8c86a 0%, #3ddc4a 55%, #1e7033 100%);
    box-shadow: 0 0 2rem rgba(61,220,74, 0.5);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(53,160,67, 0.9);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #3ddc4a;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #e8c86a;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #eef7f0;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: #9dc2a5;
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(61,220,74, 0.5);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(232,200,106, 0.55);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
