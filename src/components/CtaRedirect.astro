---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// หวยคิง (รอบทองโลหะ + ครีมอมพีช บนดำอมน้ำตาล 2026-10-04): หน้าจอคั่นตอนกดปุ่มไป
// ลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render ตัวนี้
// ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก brand-spec §2: backdrop เป็นพื้นลึกสุด rgba(12,11,10) = #0c0b0a
// แผงการ์ดเป็นผิวยก rgba(28,20,11) = #1c140b ออร่าเป็นทองแบรนด์ rgba(205,154,44)
// กับครีมอมพีช rgba(252,212,195) ออร์บไล่จากทองสว่าง #fdeb7c เข้าหาทองแบรนด์
// #cd9a2c แล้วจบที่ทองลึก #ab7314
// วงแหวนคู่หมุนสวนทางกันและแยก "สี" กันจริง (วงนอกทอง #cd9a2c วงในครีมอมพีช
// #fcd4c3) ตามคู่สีของงานศิลป์รอบนี้: โลโก้/แบนเนอร์เป็นทองโลหะ ส่วนชุดของนางแบบ
// ใน slide1/slide2 เป็นครีมอมพีช รางวงแหวนใช้เส้นขอบ/คั่นจาง rgba(92,63,18)
// = #5c3f12 ส่วนชื่อแบรนด์ไล่ ครีมอมพีช -> ทองสว่าง -> ทองลึก
// ชุดทอง-เงินโครเมียมของแบรนด์ก่อน (#ebbb54 #fce675 #ab6d24 #d5d4d3 #130b03 #f8eed9
// rgba(235,187,84) rgba(213,212,211) rgba(12,5,2) rgba(19,11,3) rgba(107,69,23)
// rgba(252,230,117) rgba(248,238,217)) ไม่เหลือแล้ว
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(205, 154, 44, 0.32) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(252, 212, 195, 0.18) 0%, transparent 55%), rgba(12, 11, 10, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(205, 154, 44, 0.5);
    border-radius: 1.5rem;
    background: rgba(28, 20, 11, 0.94);
    box-shadow:
      0 1rem 3rem rgba(12, 11, 10, 0.6),
      0 0 2rem rgba(205, 154, 44, 0.24);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #fcd4c3 0%, #fdeb7c 50%, #ab7314 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #fdeb7c 0%, #cd9a2c 55%, #ab7314 100%);
    box-shadow: 0 0 2rem rgba(205, 154, 44, 0.5);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(92, 63, 18, 0.6);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #cd9a2c;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #fcd4c3;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #fdeb7c;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(245, 231, 200, 0.78);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(205, 154, 44, 0.5);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(253, 235, 124, 0.45);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
