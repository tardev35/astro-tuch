---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// 1SS365 (รอบทอง-ดำ 2026-10-03): หน้าจอคั่นตอนกดปุ่มไปลิงก์พันธมิตร
// แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render ตัวนี้ ถ้าไม่ retheme
// ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// backdrop เป็นพื้นลึกสุด rgba(5,5,5) = #050505 แผงการ์ดเป็นพื้นการ์ด rgba(18,16,16)
// = #121010 ออร่าเป็นทองแบรนด์ rgba(237,187,35) กับทองอ่อน rgba(255,238,180)
// ออร์บไล่จากทองสว่าง #f7d458 เข้าหาทองแบรนด์ #edbb23 แล้วจบที่ทองลึก #a87708
// วงแหวนคู่หมุนสวนทางกันและแยก "สี" กันจริง (วงนอกทองแบรนด์ #edbb23 วงในเงินโครม
// #c8cbce) เพราะแบรนด์รอบนี้คือทองนำ-เงินโครมรอง: โลโก้เป็นทองล้วนบนดำ ส่วนตัวอักษร
// บนแบนเนอร์กับสไลด์เป็นทองทั้งชุด รางวงแหวนใช้เส้นขอบอุ่น rgba(42,33,21) = #2a2115
// ชุดแดง-ทองของ หวย365 (#dc0203 #f5282a #8c0402 #ffc93c #ffeab0 #f6e7e0
// rgba(220,2,3) rgba(245,40,42) rgba(255,201,60) rgba(20,2,3) rgba(36,4,6)
// rgba(58,10,12) rgba(8,1,1) rgba(246,231,224)) ไม่เหลือแล้ว
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(237, 187, 35, 0.32) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(255, 238, 180, 0.18) 0%, transparent 55%), rgba(5, 5, 5, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(237, 187, 35, 0.5);
    border-radius: 1.5rem;
    background: rgba(18, 16, 16, 0.94);
    box-shadow:
      0 1rem 3rem rgba(5, 5, 5, 0.6),
      0 0 2rem rgba(237, 187, 35, 0.24);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #ffeeb4 0%, #edbb23 45%, #a87708 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #f7d458 0%, #edbb23 55%, #a87708 100%);
    box-shadow: 0 0 2rem rgba(237, 187, 35, 0.5);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(42, 33, 21, 0.6);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #edbb23;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #c8cbce;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #ffeeb4;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(240, 230, 210, 0.78);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(237, 187, 35, 0.5);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(247, 212, 88, 0.45);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
