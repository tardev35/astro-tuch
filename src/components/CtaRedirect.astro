---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// BOOM369 (รอบเขียวนีออนบนดำ 2026-10-07): หน้าจอคั่นตอนกดปุ่มไปลิงก์พันธมิตร
// แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render ตัวนี้ ถ้าไม่ retheme
// ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก brand-spec §2: backdrop เป็นพื้นดำสนิท rgba(1,8,6) แผงการ์ดเป็น
// ผิวยก rgba(11,35,27) = #0b231b ออร่าเป็นเขียวนีออน rgba(66,251,90) กับทองจาง
// rgba(243,196,74) ออร์บไล่จากเขียวอ่อน #8dffa0 เข้าหาเขียวนีออน #42fb5a แล้ว
// จบที่เขียวลึก #036b26
// วงแหวนคู่หมุนสวนทางกันและแยก "สี" กันจริง (วงนอกเขียวนีออน #42fb5a วงในเงิน
// โครเมียม #dadcdc) ตามคู่สีของโลโก้รอบนี้โดยตรง: BOOM เขียวนีออน คู่กับ 369
// เงินโครเมียม รางวงแหวนใช้เส้นขอบ/คั่นจาง rgba(3,107,38) = #036b26 ส่วนชื่อ
// แบรนด์ไล่ เขียวอ่อน -> เงินโครเมียม -> เขียวแบรนด์
// ชุดฟ้า-ทองของ HI59 (#5ec2ff #0a84e0 #033f70 #fdbc04 #cfe4f8 rgba(10,132,224)
// rgba(253,188,4) rgba(2,22,44) rgba(4,32,63) rgba(3,63,112) rgba(94,194,255)
// rgba(228,241,253)) ไม่เหลือแล้ว
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(66, 251, 90, 0.28) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(243, 196, 74, 0.14) 0%, transparent 55%), rgba(1, 8, 6, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(66, 251, 90, 0.5);
    border-radius: 1.5rem;
    background: rgba(11, 35, 27, 0.94);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.65),
      0 0 2rem rgba(66, 251, 90, 0.26);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #8dffa0 0%, #dadcdc 50%, #04ab3a 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #8dffa0 0%, #42fb5a 55%, #036b26 100%);
    box-shadow: 0 0 2rem rgba(66, 251, 90, 0.5);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(3, 107, 38, 0.7);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #42fb5a;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #dadcdc;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #cfe9d7;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(207, 233, 215, 0.80);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(66, 251, 90, 0.5);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(141, 255, 160, 0.45);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
