---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// TEVA69 (รอบเขียวมรกตนำ ทอง/เงินโครเมียมรอง · **เนื้อหาสว่าง โครมเข้ม**): หน้าจอ
// คั่นตอนกดปุ่มไปลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ
// render ตัวนี้ ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก .claude/brand-spec-teva69.md §2
// ⚠️⚠️⚠️ **overlay เป็นผิว "เข้ม" เหมือนโครมที่เหลือของรอบนี้**
// โครมทั้งชุด (navbar/footer/ticker/แถบล่างมือถือ) เป็นเขียวป่าเข้ม จอคั่นจึงต้อง
// เป็นชุดเดียวกัน ไม่ใช่หน้าจอเดียวในเว็บที่สว่าง
// สิ่งที่ทำให้กลบหน้าข้างหลังได้สนิทคือ **ค่า alpha (0.97)** ไม่ใช่ความมืดหรือความสว่าง
// backdrop เป็นชั้นเขียวป่าลึก rgba(5,20,9) = #051409 ออร่าบนเป็น **เขียวป่าแกน
// แบรนด์** rgba(17,96,24) คู่กับ **ทองอำพัน** rgba(227,187,69) ด้านล่าง
// — ฮิวนำอยู่บน แผงการ์ดเป็นผิวโครมกลาง rgba(21,64,29) = #15401d
// ⚠️ แผงการ์ดต้อง **ต่างค่า** จาก backdrop เสมอ (รอบนี้ #15401d vs #051409
// ของ backdrop — แผง "สว่างกว่า" พื้น)
// ⚠️ ค่าทุกค่าในไฟล์นี้อยู่ในชุด rgba ที่ brand-spec §2 อนุญาต (17/96/24 ·
// 227/187/69 · 40/196/55 · 11/74/18 · 26/125/36 · 45/107/47 · 16/40/15 ·
// 11/42/18 · 5/20/9 · 21/64/29)
// ออร์บไล่จากทองอำพัน #e3bb45 เข้าหาเขียวสดแกน #28c437 แล้วจบที่เขียวป่าลึกสุด
// #0b4a12 — การไล่ "สว่างออกเข้ม" คืออ่านจากโลโก้ตรงๆ (เวิร์ดมาร์กเป็นผิวโลหะ
// สามมิติที่ไล่จากสว่างด้านบนลงมาเข้มที่ฐาน ตัดขอบดำหนา)
// วงแหวนคู่หมุนสวนทางกันและแยกค่ากันจริง — วงนอก **เขียวสดแกน #28c437**
// วงใน **ทองอำพัน #e3bb45** ซึ่งคือคู่วัสดุบนอาร์ตเวิร์ก: ตัวเลขเขียวมรกตเคลือบเงา
// บนเวิร์ดมาร์ก กับมงกุฎทองดวงเล็กบนกองชิปในแบนเนอร์
// ⚠️⚠️ **ผิวเงินโครเมียม สีผิวนักแสดง และต้นไม้ในกระถางในอาร์ตเวิร์กเป็นวัตถุ
// ในภาพ ส่วนเขียว/ทองของ UI มาจากเวิร์ดมาร์กและมงกุฎทอง** และ **ห้ามเอาแดงเลือดนก/
// ทองอำพันของรอบก่อนกลับเข้ามา** (สองสีนั้นคือฮิวนำของ LOTTO189 รอบก่อนทันที)
// 🚨🚨 **รอบนี้เป็นแบรนด์เขียว ซึ่งเป็นตระกูลเดียวกับ KINGKONG555 · สาธุ168 ·
// 888PARUAY · KOON234 และไฟล์นี้เคยเป็นทอง/แดง/ชมพู/ฟ้ามาแล้วกว่าสิบสามเจ้า**
// — สีในรูปเป็นอาร์ตเวิร์ก ค่า UI ต้องมาจากตาราง brand-spec §2 เท่านั้น
// รางวงแหวนใช้เส้นคั่นจาง rgba(45,107,47,0.9) = #2d6b2f (เป็นเส้น ไม่ใช่ตัวอักษร
// ค่านี้จึงใช้ได้ ทั้งที่ถือตัวอักษรไม่ได้)
// ส่วนชื่อแบรนด์ไล่ ขาวอมมิ้นต์ #e8fbe4 -> ทองอำพัน #e3bb45 (10.9 -> 6.4:1
// บนแผง #15401d) ซึ่งอ่านเป็นเวิร์ดมาร์กจริง: ตัวอักษรโลหะที่ไล่จากสว่างลงเข้ม
// ⚠️⚠️ **ปลายของ "ตัวอักษร" ห้ามลากลงไปถึง #28c437 บนแผงเข้มนี้** เพราะเขียวสดแกน
// ได้แค่ 5.1:1 บน #15401d ซึ่งคาบเส้นเกินไปสำหรับตัวอักษรที่หมุนอยู่ และ
// **ห้ามใช้ #116018 หรือ #1a7d24 เป็นสีตัวอักษรบนแผงนี้** (2.0 / 3.8:1 — ตกทั้งคู่)
// ⚠️⚠️ **ไฟล์นี้เพิ่งเป็นแดงเลือดนกนำ-ทองอำพันรองของ LOTTO189 เมื่อรอบที่แล้วเป๊ะๆ**
// (b00718 c1071b 8a0412 d61023 ff2436 e9b53c 24060c 3d0d16 120307 7e1221 ffeaea
// f0bcbc c3ccd6 — **ชุดที่เสี่ยงหลงเหลือที่สุด**) ก่อนหน้านั้นเป็น
// **ส้มเพลิงนำ-ทองหลอมเหลวรองของ ZNOVA168** (fa4903 fde90b e8a000 ff8a2b b8300a
// 9a2a00 d13800 c23400 1a0c04 2b1608 0e0602 7a3a0c fff3e0 e0b784) และก่อนหน้านั้นเป็น
// **ไวโอเลตนีออนนำ-ฟ้า/แมเจนต้ารองของ ZANE96** (7a1bd6 2b3fd9 c2178b f23bb4 bb6dff
// 7aa7ff 5411c4 190b3d 271257 100626 5b2f9e f3e8ff c0a6e8 2b0a63) และก่อนหน้านั้นเป็น
// **แดงเม็กซิกันนำ-ทองรองของ MEXICANOSLOT** (de2b1e f2543f c81e12 9d140c 6f0e08
// a81410 f2a033 2b100a 431a10 1d0a06 8c3a22 fdeee2 e8c6ae 117a41 2bb061 — 🚨 **สอง
// ค่าสุดท้ายเป็นเขียว จึงเป็นตระกูลเดียวกับรอบนี้ ต้องเทียบทีละค่า:
// 2bb061 ↔ 28c437 ของรอบนี้ ต่างกันแค่ R3/G14/B42**)
// ก่อนหน้านั้นเป็น
// **ชมพูบับเบิลกัมนำ-ขาวของ okkub88** (ffd6fa fff4fb ffe3f5 f9b2d9 f479b9 6a0f3c
// 95486b 9c0f55 fb439b fc74b5 ffc2e2 d91a73 b01160 85094a) และก่อนนั้นเป็น
// **ฟ้าสกายนำ-ขาวอมฟ้าของ โบ๊ะบ๊ะ168** (00bfff 12b4ef b6e3f0 06283f 0b4a73 2a87c4
// eaf7ff 0f5684 1a6ea8) และก่อนนั้นเป็น **ชมพูบานเย็นนำของ หมูบิน168**
// (fa539c c2185b 8e0f41 fb8cc0 fdc6c3 3b0b26 54123a 7a2350 ffe9f5)
// ก่อนหน้านั้นเป็นแดงเจลนำ-มุกอุ่นของ สล็อต168 (fb2e33 cb0b0d d81115 b00d11 8a0608
// f0e6e4 c9b9b7 1c0607 0b0000 551c1e) ทองนำ-โครเมียมเงินของ รวย168 (ffd94a e3a712
// 9d6f06 e8eaee b4b9c2 070707 1c1a16) แดงคริมสัน-น้ำเงินอะซัวร์ของ มาดาม168
// (ff2e52 e01238 c9102f 1177e8 0e68cc 0a4ea8 00091f 0b1733 16234a f4eef1)
// ฟ้าไซยาน-น้ำเงินอุลตรามารีนของ นาซ่า168 (1fd8f0 0bb6d4 1d4fd8 143aa0 e6edf8
// 0d1017) ฟ้าไซยาน-ครีมอุ่นของ ร่ำรวย168 (18a5e2 0d6b9b a9d7f2 f4e4d3 e4cbb3
// 111a3f) ทองแกน-ครีมอุ่นของ เงินทอง168 (f5ba14 fcee52 b37c0b ecd5c4 d2b9a4 1b1407)
// ทองแกน-โครเมียมเงินของ พักยก168 (eeae12 fded41 9f600d e0e0df c0c0bf 1f0f04)
// ฟ้าสกาย-ทองคานารีของ สบาย168 (2cc3fc 6bdcfb 0a7fbd 063a57 fdcb0c) ทองคานารี-
// โครเมียมเงินของ ยูฟ้า168 (fee45d e6a416 b8780d e8ecf1 a8b2bf 15130f) แดงเชอร์รี่-
// ทองแดงไหม้ของ โปรดี168 แดงคริมสัน-ทองโบราณของ รวยแท้168 เขียวมรกต-ทองสัมฤทธิ์
// ของ สาธุ168 ชมพูบานเย็นของ มีทรัพย์168 ชมพูบับเบิลกัม-ทองเนยของ ถอนชัวร์168
// ทอง-ชมพูฟูเชียของ มีโชค168 **ม่วงนีออนของ WEPLAY168 และ KMD88**
// 🚨🚨 **ทอง แดง ชมพู และฟ้า ผ่านไฟล์นี้มาแล้วรวมกันกว่าสิบสามเจ้า และ "เขียว"
// ก็เคยผ่านมาแล้วเช่นกัน (สาธุ168 เขียวมรกต-ทองสัมฤทธิ์)** การเจอเขียวในไฟล์นี้
// จึงไม่ได้แปลว่าเป็นของรอบนี้ เขียวรอบนี้คือ **#28c437 / #116018 / #1a7d24 /
// #0b4a12** เท่านั้น ทองคือ **#e3bb45** และผิวโครมคือ
// **#0b2a12 #15401d #051409 #2d6b2f #e8fbe4 #b4d6ad**
// เพื่อนบ้านที่ใกล้ที่สุดคือ **2bb061 ของ MEXICANOSLOT ซึ่งห่างจาก #28c437 แค่
// R3/G14/B42 · 1a5c04 ของ KINGKONG555 ขึ้นต้นเหมือน #1a7d24 เป๊ะ · 0b7d28 ของ
// สาธุ168 ขึ้นต้นเหมือน #0b4a12 เป๊ะ · e3b23c ของ สมหวัง168 ขึ้นต้นเหมือน #e3bb45
// เป๊ะ · c3ccd6 ของ LOTTO189 ห่างจาก #c6cfd2 ไม่กี่หลัก — ห้าค่านั้นใกล้ที่สุด
// ในลิสต์ ถ้าเจอแปลว่าพิมพ์ผิด** · 0f9b35 ของ สาธุ168 และ 1fae1c ของ 888PARUAY
// ก็ต่างจากเขียวของรอบนี้ไม่มาก — ให้เทียบเป็นตัวเลข
// กับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่เพื่อไม่ให้ grep หาสีของแบรนด์เก่า
// เจอ false positive — และรอบนี้ไม่มีค่าม่วง/ฟ้า/ไซแอน/ชมพู/แมเจนต้า/แดง
// เหลือในไฟล์นี้เลย
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(17,96,24, 0.22) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(227,187,69, 0.25) 0%, transparent 55%), rgba(5,20,9, 0.97);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(17,96,24, 0.75);
    border-radius: 1.5rem;
    background: rgba(21,64,29, 0.98);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.45),
      0 0 2rem rgba(17,96,24, 0.28);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #e8fbe4 0%, #e3bb45 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #e3bb45 0%, #28c437 55%, #0b4a12 100%);
    box-shadow: 0 0 2rem rgba(17,96,24, 0.5);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(45,107,47, 0.9);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #28c437;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #e3bb45;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #e8fbe4;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: #b4d6ad;
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(17,96,24, 0.5);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(227,187,69, 0.55);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
