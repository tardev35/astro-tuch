---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// รับตัง168 (รอบทองไทยนำ-แดงมังกรรอง 2026-10-18): หน้าจอคั่นตอนกดปุ่มไป
// ลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render ตัวนี้
// ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก .claude/brand-spec-rubtang168.md §2: backdrop เป็นแดงเกือบดำจม
// rgba(20,5,5) = #140505 (พื้นเพจรอบนี้เป็นดำอมแดง #1a0505 backdrop จึงจมกว่า
// พื้นหนึ่งระดับ) ออร่าบนรอบนี้เป็น **ทองแบรนด์** rgba(240,180,41) คู่กับ
// **แดงแบรนด์** rgba(211,3,4) ด้านล่าง — สลับขั้วจากรอบก่อนที่แดงอยู่บนทองอยู่ล่าง
// เพราะรอบนี้ทองเป็นฮิวนำ แผงการ์ดเป็นผิวยก rgba(43,16,15) = #2b100f
// ⚠️ แผงการ์ดต้องสว่างกว่า backdrop เสมอ
// ออร์บไล่จากทองสว่าง #ffdc8c เข้าหาทองแบรนด์ #f0b429 แล้วจบที่แดงแบรนด์
// #d30304 (ออร์บเป็นรูปทรง ไม่ใช่ตัวอักษร #d30304 จึงใช้ได้ตรงนี้) — การไล่
// "ทองเข้าแดง" คือแบรนด์สองโทนของรอบนี้อ่านจากงานศิลป์ตรงๆ (ฝนเหรียญจีนทอง
// รอบนอก ไล่เข้าไปหาเลข 168 แดงสดกลางโลโก้)
// วงแหวนคู่หมุนสวนทางกันและแยก "โทน" กันจริง — วงนอก **ทองแบรนด์ #f0b429**
// วงใน **แดงแบรนด์ #d30304** ซึ่งกลับด้านกับรอบก่อนที่วงนอกเป็นแดงวงในเป็นทอง
// รางวงแหวนใช้เส้นคั่นจาง rgba(154,108,12,0.8) = #9a6c0c ทองลึก (เป็นเส้น
// ไม่ใช่ตัวอักษร) ส่วนชื่อแบรนด์ไล่ ทองสว่าง #ffdc8c -> ทองแบรนด์ #f0b429 ->
// แดงสว่าง #ff6b6e
// ⚠️ ปลายเข้มของ "ตัวอักษร" หยุดที่ #ff6b6e ไม่ใช่ #d30304 หรือ #a00203 —
// #d30304 บนแผง #2b100f ได้ ~2.1:1 และ #a00203 ต่ำกว่านั้นอีก ส่วน #ff6b6e ได้
// ~5.4:1 ผ่าน AA สำหรับข้อความปกติด้วยซ้ำ
// (brand-spec §2: #d30304 / #a00203 / #4a0202 / #9a6c0c ห้ามถือตัวอักษรทุกขนาด)
// ⚠️ ไฟล์นี้เคยเป็นแดงมังกร-ทองไทยของ สมหวัง168 ก่อนหน้านั้นเป็นแดงมังกร-โครเมียม
// ขาวของ GT66B แดงเลือดนก-เงินของ TKB55 น้ำเงิน-เงินของ TSDET911 ม่วง-ทองของ
// KMD88 และทองล้วนของ TND168 — และก่อนหน้านั้นอีกมีแบรนด์แดงอยู่จริง (FLASH877 /
// PIGPG / SUPERSLOTCLUB) การเจอ "แดง" หรือ "ทอง" ในไฟล์นี้จึง **ไม่ได้แปลว่าเป็น
// ของรอบนี้** โดยเฉพาะรอบนี้ที่สามแบรนด์ก่อนหน้าก็แดงทั้งหมด ให้เทียบเป็นตัวเลข
// กับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่เพื่อไม่ให้ grep หาสีของแบรนด์เก่า
// เจอ false positive — และรอบนี้ไม่มีค่าม่วง/ชมพู/เขียว/น้ำเงิน/ฟ้า/ส้มเหลือในไฟล์นี้เลย
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(240, 180, 41, 0.28) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(211, 3, 4, 0.22) 0%, transparent 55%), rgba(20, 5, 5, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(240, 180, 41, 0.65);
    border-radius: 1.5rem;
    background: rgba(43, 16, 15, 0.94);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.7),
      0 0 2rem rgba(240, 180, 41, 0.38);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #ffdc8c 0%, #f0b429 50%, #ff6b6e 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #ffdc8c 0%, #f0b429 55%, #d30304 100%);
    box-shadow: 0 0 2rem rgba(240, 180, 41, 0.6);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(154, 108, 12, 0.8);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #f0b429;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #d30304;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #f5ece0;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(245, 236, 224, 0.8);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(240, 180, 41, 0.6);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(211, 3, 4, 0.5);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
