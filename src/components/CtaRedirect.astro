---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// 123BET (รอบแดงชาดนำ เงินโครเมียม/ทองอำพันรอง · **เนื้อหาสว่าง โครมเข้ม**):
// หน้าจอคั่นตอนกดปุ่มไปลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่น
// ในเว็บ render ตัวนี้ ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง
// convert พอดี สีทุกค่ามาจาก .claude/brand-spec-123bet.md §2
// ⚠️⚠️⚠️ **รอบนี้เนื้อหาเป็นผิวสว่าง (bg.json = f7e4e9 ชมพูบลัชจาง) แต่โครมทั้งชุด
// (navbar/footer/ticker/แถบล่างมือถือ) เป็นผิวเข้มแดงเลือดหมู** จอคั่นอยู่ในชุด
// โครม จึงเป็น **จอเข้ม** ตามเดิม **ห้ามทำให้เป็นจอสว่างตามพื้นเพจ**
// สิ่งที่ทำให้กลบหน้าข้างหลังได้สนิทคือ **ค่า alpha (0.97)** ไม่ใช่ความมืดหรือความสว่าง
// backdrop เป็นชั้นโครมลึกสุด rgba(28,5,11) = #1c050b ออร่าบนเป็น **แดงชาด
// แกนแบรนด์** rgba(163,13,26) คู่กับ **ทองอำพัน** rgba(220,165,58) ด้านล่าง
// — ฮิวนำอยู่บน แผงการ์ดเป็นโครมชั้นยกของรอบนี้ rgba(77,12,24) = #4d0c18
// ⚠️ แผงการ์ดต้อง **ต่างค่า** จาก backdrop เสมอ (รอบนี้ #4d0c18 vs #1c050b
// ของ backdrop — แผง "สว่างกว่า" พื้น)
// ⚠️ ค่าทุกค่าในไฟล์นี้อยู่ในชุด rgba ที่ brand-spec §2 อนุญาต (163/13/26 ·
// 220/165/58 · 217/143/160 · 54/8/15 · 28/5/11) บวกผิวแผง 77/12/24
// ออร์บไล่จากทองอำพัน #dca53a เข้าหาแดงชาดแกน #c21325 แล้วจบที่แดงเลือดหมู
// #8a1420 — การไล่ "สว่างออกเข้ม" คืออ่านจากโลโก้ตรงๆ (เวิร์ดมาร์กสามมิติ ครึ่งแรก
// เป็นตัวเลขผิวแดงชาดเคลือบเงาตัดขอบทอง ครึ่งหลังเป็นตัวอักษรละตินผิวโครเมียมเงิน
// ขัดเงา เหนือขึ้นไปเป็นมงกุฎเงินประดับกำมะหยี่แดงและอัญมณีแดง)
// วงแหวนคู่หมุนสวนทางกันและแยกค่ากันจริง — วงนอก **แดงชาดแกน #c21325**
// วงใน **ทองอำพัน #dca53a** ซึ่งคือคู่วัสดุบนอาร์ตเวิร์ก: ตัวเลขแดงเคลือบเงาตัดขอบทอง
// บนเวิร์ดมาร์ก กับแคปซูลพื้นดำขอบทองบนสไลด์ทั้งสองใบ
// ⚠️⚠️ **ผนังหินอ่อนสีงาช้าง สีผิวนักแสดง และฉากโถงวังสว่างในอาร์ตเวิร์กเป็นวัตถุ
// ในภาพ ส่วนแดง/ทอง/เงินของ UI มาจากเวิร์ดมาร์กกับมงกุฎ** พื้นจอคั่นมาจาก
// brand-spec §2 เท่านั้น **ห้ามดูดสีจากรูป**
// 🚨🚨 **ไฟล์นี้เคยเป็นทอง/แดง/ชมพู/ฟ้า/ม่วง/ส้ม/เขียวมาแล้วกว่าสิบห้าเจ้า และ
// LOTTO189 ก็เป็นแบรนด์ แดง/ทอง/ขาวชมพู ตระกูลเดียวกับรอบนี้เป๊ะ** —
// **"เจอแดงทองเงิน" จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้** ต้องเทียบหกหลักกับตาราง
// brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep หาสีของแบรนด์เก่าเจอ
// false positive ในคอมเมนต์ของไฟล์นี้เอง
// รางวงแหวนใช้เส้นคั่น rgba(217,143,160,0.9) = #d98fa0 (เป็นเส้น ไม่ใช่ตัวอักษร
// ค่านี้จึงใช้ได้ ทั้งที่ถือตัวอักษรไม่ได้ — 2.3:1 บนการ์ดสว่าง)
// ส่วนชื่อแบรนด์ไล่ บลัชขาว #fdf5f6 -> เงินโครเมียม #d2d7dd -> ทองอำพัน #dca53a
// (16.6 -> 10.5 -> 6.9:1 บนแผง #4d0c18) ซึ่งอ่านเป็นผิวโครเมียมขัดเงาของ
// ครึ่งหลังเวิร์ดมาร์กที่ไล่จากเงินสว่างลงมาหาขอบทอง
// ⚠️⚠️ **ห้ามใช้ #a30d1a หรือ #d98fa0 หรือ #ef4a5e เป็นสีตัวอักษรบนแผงนี้**
// (2.9 / 2.4 / 4.2:1 — ตกทั้งสามค่า) ที่ถือตัวอักษรได้บนแผง #4d0c18 คือ
// #fdf5f6 (14.2:1) · #d2d7dd (10.5:1) · #dca53a (6.9:1)
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(163, 13, 26, 0.22) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(220, 165, 58, 0.25) 0%, transparent 55%), rgba(28, 5, 11, 0.97);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(163, 13, 26, 0.75);
    border-radius: 1.5rem;
    background: rgba(77, 12, 24, 0.98);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.45),
      0 0 2rem rgba(163, 13, 26, 0.28);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #fdf5f6 0%, #d2d7dd 55%, #dca53a 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #dca53a 0%, #c21325 55%, #8a1420 100%);
    box-shadow: 0 0 2rem rgba(163, 13, 26, 0.5);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(217, 143, 160, 0.9);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #c21325;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #dca53a;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #fdf5f6;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: #d2d7dd;
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(163, 13, 26, 0.5);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(220, 165, 58, 0.55);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
