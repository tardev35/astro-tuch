---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// UOK365 (รอบทองเมทัลลิก-เงินโครเมียมบนดำ 2026-10-07): หน้าจอคั่นตอนกดปุ่มไป
// ลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render ตัวนี้
// ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก brand-spec §2: backdrop เป็นพื้นดำอมน้ำตาล rgba(7,5,4) แผงการ์ด
// เป็นผิวยก rgba(25,17,8) = #191108 ออร่าเป็นทองแบรนด์ rgba(200,145,47) กับเงิน
// โครเมียมจาง rgba(216,219,224) ออร์บไล่จากทองอ่อน #f5d98a เข้าหาทองแบรนด์
// #c8912f แล้วจบที่ทองลึก #6d4412
// วงแหวนคู่หมุนสวนทางกันและแยก "สี" กันจริง (วงนอกทองแบรนด์ #c8912f วงในเงิน
// โครเมียม #d8dbe0) ตามคู่โลหะของโลโก้รอบนี้โดยตรง: UOK ทองเมทัลลิก คู่กับ 365
// เงินโครเมียม รางวงแหวนใช้เส้นขอบ/คั่นจาง rgba(109,68,18) = #6d4412 ส่วนชื่อ
// แบรนด์ไล่ ทองอ่อน -> เงินโครเมียม -> ทองกลาง
// ชุดเขียวนีออนของ BOOM369 (#8dffa0 #42fb5a #04ab3a #036b26 #dadcdc #cfe9d7
// rgba(66,251,90) rgba(141,255,160) rgba(243,196,74) rgba(1,8,6) rgba(11,35,27)
// rgba(3,107,38) rgba(207,233,215)) ไม่เหลือแล้ว
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(200, 145, 47, 0.30) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(216, 219, 224, 0.12) 0%, transparent 55%), rgba(7, 5, 4, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(200, 145, 47, 0.5);
    border-radius: 1.5rem;
    background: rgba(25, 17, 8, 0.94);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.65),
      0 0 2rem rgba(200, 145, 47, 0.26);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #f5d98a 0%, #d8dbe0 50%, #a46b25 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #f5d98a 0%, #c8912f 55%, #6d4412 100%);
    box-shadow: 0 0 2rem rgba(200, 145, 47, 0.5);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(109, 68, 18, 0.7);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #c8912f;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #d8dbe0;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #ece1cc;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(236, 225, 204, 0.80);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(200, 145, 47, 0.5);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(245, 217, 138, 0.45);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
