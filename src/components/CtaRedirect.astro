---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// SUPERSLOTCLUB (รอบแดงเสือโคร่ง-ทองถ่านไฟ 2026-10-09): หน้าจอคั่นตอนกดปุ่มไป
// ลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render ตัวนี้
// ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก brand-spec §2: backdrop เป็นพื้นน้ำตาลถ่านเกือบดำ rgba(36,16,0)
// ออร่าเป็นแดงเสือโคร่ง rgba(232,35,42) คู่กับทองถ่านไฟ rgba(242,183,5) แผงการ์ด
// เป็นผิวยก rgba(61,23,9) = #3d1709 ออร์บไล่จากครีมอุ่น #f5cbb0 เข้าหาทองถ่านไฟ
// #f2b705 แล้วจบที่ทองเข้ม #a8730a
// วงแหวนคู่หมุนสวนทางกันและแยก "สี" กันจริง รอบนี้เป็นสองฮิวจริง (วงนอกทองถ่านไฟ
// #f2b705 วงในแดงเสือโคร่ง #e8232a) เพราะโลโก้รอบนี้เป็นหัวเสือโคร่งลายส้ม-ดำบน
// ป้ายโล่แดงที่คาดคำว่า SUPERSLOTCLUB ไว้ — มีฮิวที่สองจริง ไม่ใช่โลหะเดียว
// รางวงแหวนใช้เส้นขอบ/คั่นจาง rgba(125,15,18) = แดงลึก
// ส่วนชื่อแบรนด์ไล่ ครีมอุ่น -> ทองถ่านไฟ -> ทองเข้ม
// ชุดเขียวป่า-ทองมงกุฎของ KINGKONG555 (#bde397 #f2c230 #a87a08 #8ce023 #e9f7d6
// rgba(140,224,35,α) rgba(242,194,48,α) rgba(26,92,4,α) rgba(5,20,0,α)
// rgba(20,56,10,α) rgba(233,247,214,α) rgba(189,227,151,α)) ไม่เหลือแล้ว
// ⚠️ ทองของรอบนี้เป็นคนละค่ากับทองของ KINGKONG555 — อย่าปล่อยค่าเก่าไว้เพราะคล้ายกัน
// และรอบนี้ฮิวแรกเป็น "แดง" ซึ่งเป็นสีที่แบรนด์เก่าหลายเจ้าก็ใช้ ให้เทียบค่าเป็นตัวๆ
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(232, 35, 42, 0.28) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(242, 183, 5, 0.18) 0%, transparent 55%), rgba(36, 16, 0, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(232, 35, 42, 0.6);
    border-radius: 1.5rem;
    background: rgba(61, 23, 9, 0.94);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.7),
      0 0 2rem rgba(232, 35, 42, 0.32);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #f5cbb0 0%, #f2b705 50%, #a8730a 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #f5cbb0 0%, #f2b705 55%, #a8730a 100%);
    box-shadow: 0 0 2rem rgba(232, 35, 42, 0.6);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(125, 15, 18, 0.8);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #f2b705;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #e8232a;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #fbe8d5;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(251, 232, 213, 0.8);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(232, 35, 42, 0.6);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(245, 203, 176, 0.45);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
