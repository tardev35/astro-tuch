---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// นาซ่า168 (รอบฟ้าไซยานไฟฟ้านำ น้ำเงินอุลตรามารีนรอง บน **ธีมมืด**): หน้าจอคั่นตอน
// กดปุ่มไปลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render
// ตัวนี้ ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก .claude/brand-spec-naza168.md §2 (โซน "โครม")
// ⚠️⚠️ **รอบนี้พื้นเพจเป็นถ่านเกือบดำ #0d1017 (จาก bg.json ซึ่งรอบก่อนเป็น
// dbe6ff = ฟ้าเพอริวิงเคิลสว่าง — กลับทิศกันสุดขั้ว)** overlay ตัวนี้เป็น **โครม
// จึงเป็นผิวมืดอยู่แล้วเหมือนทุกรอบ** — มันต้องกลบหน้าข้างหลังได้สนิท ซึ่งเป็น
// เหตุผลเดียวกันทุกรอบ ไม่ว่าพื้นเพจจะสว่างหรือมืด **ห้าม "แก้" ให้สว่างตามพื้นเพจ**
// backdrop เป็นชั้นพื้นเพจ rgba(13,16,23) = #0d1017 ออร่าบนเป็น **ฟ้าไซยานแกนแบรนด์**
// rgba(31,216,240) คู่กับ **น้ำเงินอุลตรามารีน** rgba(29,79,216) ด้านล่าง
// — ฮิวนำอยู่บน แผงการ์ดเป็นผิวกลาง rgba(27,36,52) = #1b2434
// ⚠️ แผงการ์ดต้องสว่างกว่า backdrop เสมอ (#1b2434 กลาง vs #0d1017 พื้นเพจ)
// ⚠️ ค่าทุกค่าในไฟล์นี้อยู่ในชุด rgba ที่ brand-spec §2 อนุญาต (31/216/240 ·
// 29/79/216 · 143/217/236 · 11/182/212 · 13/16/23 · 0/0/0) โดยตั้งใจ
// ออร์บไล่จากน้ำแข็งอ่อน #8fd9ec เข้าหาฟ้าไซยาน #1fd8f0 แล้วจบที่ฟ้าลึก #0bb6d4
// — การไล่ "อ่อนออกเข้ม" คืออ่านจากโลโก้ตรงๆ (คำว่า นาซ่า เป็นตัวอักษรสามมิติผิว
// มันวาวไล่เฉดจากฟ้าไซยานด้านบนลงน้ำเงินด้านล่าง มีไฮไลต์ขาวที่ยอด) และออร์บกลมนี้
// อ่านได้เป็นภาพโลกที่สะท้อนบนบังตาหมวกนักบินอวกาศในอาร์ตเวิร์กรอบนี้
// วงแหวนคู่หมุนสวนทางกันและแยกค่ากันจริง — วงนอก **ฟ้าไซยาน #1fd8f0**
// วงใน **น้ำเงินอุลตรามารีน #1d4fd8** (เป็นเส้น ไม่ใช่ตัวอักษร ค่านี้จึงใช้ได้
// ทั้งที่ถือตัวอักษรไม่ได้) ⚠️⚠️ **เลข 168 ในโลโก้เป็นทองอำพันจริง แต่ทองเป็นฮิวที่
// แน่นที่สุดในรีโปนี้ และ NAZA168 ตัวละติน (ลูกค้าคนละเจ้าที่ชื่อออกเสียงเหมือนรอบนี้)
// ใช้ "ทองอวกาศ-เงินโครเมียม" บนธีมอวกาศไปแล้ว รอบนี้จึงใช้น้ำเงินอุลตรามารีนที่
// วัดจากภาพโลกใน banner1.png เป็นวัสดุที่สองแทน — ห้ามเอาทองหรือเทาเงินกลับเข้ามา**
// รางวงแหวนใช้เส้นคั่นจาง rgba(51,69,95,0.8) = #33455f (เป็นเส้น ไม่ใช่ตัวอักษร
// ค่านี้จึงใช้ได้ ทั้งที่ถือตัวอักษรไม่ได้)
// ส่วนชื่อแบรนด์ไล่ น้ำแข็งอ่อน #8fd9ec -> ฟ้าไซยาน #1fd8f0 (10.0 -> 9.1:1 บนแผง #1b2434)
// ⚠️ ปลายของ "ตัวอักษร" หยุดที่ #1fd8f0 — **ลากลงไปถึง #1d4fd8 ไม่ได้บนแผงเข้มนี้**
// เพราะน้ำเงินอุลตรามารีนได้แค่ 2.4:1 บน #1b2434 มันจะจมหายไปเลย
// ⚠️⚠️ **ไฟล์นี้เพิ่งเป็นฟ้าไซยาน-ครีมอุ่นของ ร่ำรวย168 เมื่อรอบที่แล้วเป๊ะๆ**
// (18a5e2 0d6b9b a9d7f2 f4e4d3 e4cbb3 111a3f 202a66 31408a e9f1ff adc0e4 —
// **ชุดที่เสี่ยงหลงเหลือที่สุด และเป็นฟ้านำเหมือนกันอีก**) ก่อนหน้านั้นเป็นทองแกน-
// ครีมอุ่นของ เงินทอง168 (f5ba14 fcee52 b37c0b ecd5c4 d2b9a4 1b1407 2e2512 4d3c15
// 29210f) ก่อนหน้านั้นเป็นทองแกน-โครเมียมเงินของ พักยก168
// (eeae12 fded41 9f600d e0e0df c0c0bf a1a09e f4ead6 d6c6a8 291d0f 2f1e0f 1f0f04
// 4e2f11) ก่อนหน้านั้นเป็นฟ้าสกาย-ทองคานารีของ สบาย168 (2cc3fc 6bdcfb 0a7fbd
// 063a57 04293d 0a4f74 fdcb0c eafaff ffffff) ก่อนหน้านั้นเป็นทองคานารี-โครเมียม
// เงินของ ยูฟ้า168 (fee45d e6a416 b8780d 7a4e05 e8ecf1 a8b2bf 78828f 5a6472
// 15130f 1e1a13 0a0908 eae3d4 fff8dd 000000) ก่อนหน้านั้นเป็นแดงเชอร์รี่-ทองแดง
// ไหม้ของ โปรดี168 (eb0305 9b0a0c ff4446 b44c06 f0b46a 401107 fff4ea fff0e4)
// แดงคริมสัน-ทองโบราณของ รวยแท้168 เขียวมรกต-ทองสัมฤทธิ์ของ สาธุ168
// ชมพูบานเย็นของ มีทรัพย์168 แดงชาด-ทองน้ำผึ้งของ ดวงเศรษฐี168 ทองอำพัน-บรอนซ์ของ
// ufalion168 ทองจักรพรรดิ-แดงชาดของ รวยเทพ168 แดงชาด-ทองเนยของ มีเฮ168
// ทอง-โรสโกลด์ของ ขวัญใจ168 ทองไทย-แดงมังกรของ รับตัง168 แดงมังกร-ทองของ สมหวัง168
// แดงมังกร-โครเมียมของ GT66B
// 🚨🚨 **ฟ้าผ่านไฟล์นี้มาแล้วสองรอบติด (สบาย168 และ ร่ำรวย168 รอบก่อนทันที) และ
// ฟ้านำมาแล้วหกแบรนด์ในรีโป** การเจอ "ฟ้า" ในไฟล์นี้จึงไม่ได้แปลว่าเป็นของรอบนี้
// ฟ้ารอบนี้คือ **#1fd8f0** (+#0bb6d4 #8fd9ec) และวัสดุที่สองรอบนี้คือ
// **น้ำเงินอุลตรามารีน #1d4fd8** (+#143aa0)
// เพื่อนบ้านที่ใกล้ที่สุดคือ 18a5e2 ของร่ำรวย168 (ซึ่งเคยอยู่ในไฟล์นี้เมื่อรอบที่แล้ว)
// 2cc3fc/6bdcfb ของสบาย168 (ซึ่งเคยอยู่ในไฟล์นี้เช่นกัน) 32bcfb ของนินจา168 และ
// 039cfa ของรวยแทร่168 ให้เทียบเป็นตัวเลขกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำ
// ที่นี่เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive — และรอบนี้ไม่มีค่าทอง/
// แดง/เขียว/ชมพู/ม่วง/โรสโกลด์/ส้ม/น้ำตาล/ครีม/เทาเงิน เหลือในไฟล์นี้เลย
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(31,216,240, 0.22) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(29,79,216, 0.14) 0%, transparent 55%), rgba(13,16,23, 0.97);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(31,216,240, 0.65);
    border-radius: 1.5rem;
    background: rgba(27,36,52, 0.96);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.7),
      0 0 2rem rgba(31,216,240, 0.28);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #8fd9ec 0%, #1fd8f0 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #8fd9ec 0%, #1fd8f0 55%, #0bb6d4 100%);
    box-shadow: 0 0 2rem rgba(31,216,240, 0.5);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(51,69,95, 0.8);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #1fd8f0;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #1d4fd8;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #e6edf8;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: #9fb2cb;
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(31,216,240, 0.5);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(29,79,216, 0.45);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
