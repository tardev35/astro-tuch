---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// มาดาม168 (รอบแดงคริมสันนำ น้ำเงินอะซัวร์รอง บน **ธีมมืด**): หน้าจอคั่นตอน
// กดปุ่มไปลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render
// ตัวนี้ ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก .claude/brand-spec-madum168.md §2 (โซน "โครม")
// ⚠️ **รอบนี้พื้นเพจเป็นน้ำเงินเที่ยงคืนเกือบดำ #00091f (จาก bg.json ซึ่งรอบก่อน
// เป็น 0d1017 = ถ่านอมน้ำเงินที่เทากว่านี้มาก)** overlay ตัวนี้เป็น **โครม
// จึงเป็นผิวมืดอยู่แล้วเหมือนทุกรอบ** — มันต้องกลบหน้าข้างหลังได้สนิท ซึ่งเป็น
// เหตุผลเดียวกันทุกรอบ **ห้าม "แก้" ให้สว่างตามพื้นเพจ**
// backdrop เป็นชั้นพื้นเพจ rgba(0,9,31) = #00091f ออร่าบนเป็น **แดงคริมสันแกนแบรนด์**
// rgba(255,46,82) คู่กับ **น้ำเงินอะซัวร์** rgba(17,119,232) ด้านล่าง
// — ฮิวนำอยู่บน แผงการ์ดเป็นผิวกลาง rgba(11,23,51) = #0b1733
// ⚠️ แผงการ์ดต้องสว่างกว่า backdrop เสมอ (#0b1733 กลาง vs #00091f พื้นเพจ)
// ⚠️ ค่าทุกค่าในไฟล์นี้อยู่ในชุด rgba ที่ brand-spec §2 อนุญาต (255/46/82 ·
// 224/18/56 · 201/16/47 · 17/119/232 · 14/104/204 · 10/78/168 · 217/223/233 ·
// 0/9/31 · 0/0/0) โดยตั้งใจ
// ออร์บไล่จากแดงคริมสัน #ff2e52 เข้าหาแดงพื้นปุ่ม #e01238 แล้วจบที่แดงลึก #c9102f
// — การไล่ "สว่างออกเข้ม" คืออ่านจากโลโก้ตรงๆ (เลข "168" เป็นตัวอักษรสามมิติผิว
// มันวาวแดงสด ไล่จากแดงสว่างที่ยอดลงแดงเข้มที่ฐาน มีไฮไลต์ขาวพาดบนผิว)
// วงแหวนคู่หมุนสวนทางกันและแยกค่ากันจริง — วงนอก **แดงคริมสัน #ff2e52**
// วงใน **น้ำเงินอะซัวร์ #1177e8** (เป็นเส้น ไม่ใช่ตัวอักษร ค่านี้จึงใช้ได้
// ทั้งที่ถือตัวอักษรไม่ได้) ซึ่งคือคู่วัสดุบนเวิร์ดมาร์กเป๊ะๆ: "มาดาม" ฟ้าอมน้ำเงิน
// ต่อด้วย "168" แดงสด
// ⚠️⚠️ **ผมสีขาวเงิน สูทขาวครีม สูทดำ พื้นหินขัด และสีผิวนักแสดงในอาร์ตเวิร์กเป็น
// วัตถุในภาพ ไม่ใช่สี UI — ห้ามเอาครีม/พีช/เบจ/แรมป์เทาเงินกลับเข้ามา**
// รางวงแหวนใช้เส้นคั่นจาง rgba(42,60,112,0.8) = #2a3c70 (เป็นเส้น ไม่ใช่ตัวอักษร
// ค่านี้จึงใช้ได้ ทั้งที่ถือตัวอักษรไม่ได้)
// ส่วนชื่อแบรนด์ไล่ แพลทินัม #d9dfe9 -> แดงคริมสัน #ff2e52 (12.5 -> 4.9:1 บนแผง
// #0b1733) ซึ่งอ่านเป็นเวิร์ดมาร์กจริง: ตัวอักษรขอบเงินโครเมียมที่จบด้วยเลขแดง
// ⚠️ ปลายของ "ตัวอักษร" หยุดที่ #ff2e52 — **ลากลงไปถึง #c9102f ไม่ได้บนแผงเข้มนี้**
// เพราะแดงลึกได้แค่ 2.5:1 บน #0b1733 มันจะจมหายไปเลย
// ⚠️⚠️ **ไฟล์นี้เพิ่งเป็นฟ้าไซยาน-น้ำเงินอุลตรามารีนของ นาซ่า168 เมื่อรอบที่แล้วเป๊ะๆ**
// (1fd8f0 0bb6d4 8fd9ec 1d4fd8 143aa0 e6edf8 9fb2cb 1b2434 33455f 0d1017 —
// **ชุดที่เสี่ยงหลงเหลือที่สุด**) ก่อนหน้านั้นเป็นฟ้าไซยาน-ครีมอุ่นของ ร่ำรวย168
// (18a5e2 0d6b9b a9d7f2 f4e4d3 e4cbb3 111a3f 202a66 31408a e9f1ff adc0e4)
// ก่อนหน้านั้นเป็นทองแกน-ครีมอุ่นของ เงินทอง168 (f5ba14 fcee52 b37c0b ecd5c4
// d2b9a4 1b1407 2e2512 4d3c15 29210f) ก่อนหน้านั้นเป็นทองแกน-โครเมียมเงินของ
// พักยก168 (eeae12 fded41 9f600d e0e0df c0c0bf a1a09e f4ead6 d6c6a8 291d0f 2f1e0f
// 1f0f04 4e2f11) ก่อนหน้านั้นเป็นฟ้าสกาย-ทองคานารีของ สบาย168 (2cc3fc 6bdcfb
// 0a7fbd 063a57 04293d 0a4f74 fdcb0c eafaff ffffff) ก่อนหน้านั้นเป็นทองคานารี-
// โครเมียมเงินของ ยูฟ้า168 (fee45d e6a416 b8780d 7a4e05 e8ecf1 a8b2bf 78828f
// 5a6472 15130f 1e1a13 0a0908 eae3d4 fff8dd 000000) ก่อนหน้านั้นเป็นแดงเชอร์รี่-
// ทองแดงไหม้ของ โปรดี168 (eb0305 9b0a0c ff4446 b44c06 f0b46a 401107 fff4ea fff0e4)
// แดงคริมสัน-ทองโบราณของ รวยแท้168 เขียวมรกต-ทองสัมฤทธิ์ของ สาธุ168
// ชมพูบานเย็นของ มีทรัพย์168 แดงชาด-ทองน้ำผึ้งของ ดวงเศรษฐี168 ทองอำพัน-บรอนซ์ของ
// ufalion168 ทองจักรพรรดิ-แดงชาดของ รวยเทพ168 แดงชาด-ทองเนยของ มีเฮ168
// ทอง-โรสโกลด์ของ ขวัญใจ168 ทองไทย-แดงมังกรของ รับตัง168 แดงมังกร-ทองของ สมหวัง168
// แดงมังกร-โครเมียมของ GT66B
// 🚨🚨 **ฟ้าผ่านไฟล์นี้มาแล้วสามรอบติด (สบาย168 · ร่ำรวย168 · นาซ่า168 รอบก่อน
// ทันที) และฟ้านำมาแล้วเจ็ดแบรนด์ในรีโป** ซึ่งเป็นเหตุผลที่รอบนี้ลดฟ้าลงเป็นวัสดุ
// ที่สองที่ไม่ถือตัวอักษร และยกแดงคริมสันขึ้นเป็นฮิวนำ
// ⚠️⚠️ **แต่แดงก็ผ่านไฟล์นี้มาแล้วหลายเจ้าเช่นกัน** การเจอ "แดง" ในไฟล์นี้จึงไม่ได้
// แปลว่าเป็นของรอบนี้ แดงรอบนี้คือ **#ff2e52** (+#e01238 #c9102f) เพื่อนบ้านที่
// ใกล้ที่สุดคือ ff4446 ของโปรดี168 (ซึ่งเคยอยู่ในไฟล์นี้) ห่าง R0/G22/B12 ·
// fb1b32 ของมีเฮ168 ห่าง R4/G19/B32 · f5282a ของหวย365 ห่าง R10/G6/B40 ·
// e4021b ของรวยเทพ168 ห่าง R27/G28/B26 — ให้เทียบเป็นตัวเลขกับตารางใน
// brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false
// positive — และรอบนี้ไม่มีค่าทอง/เหลือง/เขียว/ชมพู/ม่วง/โรสโกลด์/ส้ม/น้ำตาล/
// ครีม/เทาเงิน เหลือในไฟล์นี้เลย
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(255,46,82, 0.22) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(17,119,232, 0.14) 0%, transparent 55%), rgba(0,9,31, 0.97);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(255,46,82, 0.65);
    border-radius: 1.5rem;
    background: rgba(11,23,51, 0.96);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.7),
      0 0 2rem rgba(255,46,82, 0.28);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #d9dfe9 0%, #ff2e52 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #ff2e52 0%, #e01238 55%, #c9102f 100%);
    box-shadow: 0 0 2rem rgba(255,46,82, 0.5);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(42,60,112, 0.8);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #ff2e52;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #1177e8;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #f4eef1;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: #b3bdd6;
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(255,46,82, 0.5);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(17,119,232, 0.45);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
