---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// MEXICANOSLOT (รอบแดงเม็กซิกันนำ ทองรอง · **เนื้อหาสว่าง โครมเข้ม**): หน้าจอคั่น
// ตอนกดปุ่มไปลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ
// render ตัวนี้ ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก .claude/brand-spec-mexicanoslot.md §2
// ⚠️⚠️⚠️ **รอบนี้ overlay กลับไปเป็นผิว "เข้ม" — กลับทิศจากรอบก่อนทันที**
// รอบ okkub88 ไฟล์นี้เป็นผิวสว่าง เพราะโครมทั้งชุดของรอบนั้นเป็นผิวสว่าง
// **รอบนี้โครมทั้งชุด (navbar/footer/ticker/แถบล่างมือถือ) เป็นเอสเพรสโซเข้ม**
// จอคั่นจึงต้องเป็นชุดเดียวกัน ไม่ใช่หน้าจอเดียวในเว็บที่สว่าง
// สิ่งที่ทำให้กลบหน้าข้างหลังได้สนิทคือ **ค่า alpha (0.97)** ไม่ใช่ความมืดหรือความสว่าง
// backdrop เป็นชั้นเอสเพรสโซ rgba(29,10,6) ออร่าบนเป็น **แดงแกนแบรนด์**
// rgba(222,43,30) คู่กับ **ทอง** rgba(242,160,51) ด้านล่าง
// — ฮิวนำอยู่บน แผงการ์ดเป็นผิวโครมกลาง rgba(43,16,10) = #2b100a
// ⚠️ แผงการ์ดต้อง **ต่างค่า** จาก backdrop เสมอ (รอบนี้ #2b100a vs #1d0a06
// ของ backdrop — แผง "สว่างกว่า" พื้น)
// ⚠️ ค่าทุกค่าในไฟล์นี้อยู่ในชุด rgba ที่ brand-spec §2 อนุญาต (222/43/30 ·
// 242/160/51 · 140/58/34 · 200/30/18 · 111/14/8 · 29/10/6 · 43/16/10 · 253/238/226)
// ออร์บไล่จากแดงไฮไลต์ #f2543f เข้าหาแดงแกน #de2b1e แล้วจบที่แดงลึกสุด #6f0e08
// — การไล่ "สว่างออกเข้ม" คืออ่านจากโลโก้ตรงๆ (เวิร์ดมาร์กเป็นผิวสามมิติมันวาว
// ไล่จากแดงอ่อนที่ยอดลงแดงเข้มที่ฐาน ตัดขอบขาวหนา)
// วงแหวนคู่หมุนสวนทางกันและแยกค่ากันจริง — วงนอก **แดงแกน #de2b1e**
// วงใน **ทอง #f2a033** ซึ่งคือคู่วัสดุบนสไลด์เป๊ะๆ: แคปซูลแดงขอบทอง
// ⚠️⚠️ **ซอมเบรโรฟาง ปอนโช กีตาร์ และเหรียญทองในอาร์ตเวิร์กเป็นวัตถุในภาพ ส่วนแดง
// ของ UI มาจากเวิร์ดมาร์ก พริก ลายปัก และธงชาติ** และ **ห้ามเอาฟ้า/ชมพู/ม่วง/
// เทาเงินกลับเข้ามา** (ชมพูคือฮิวนำของ okkub88 รอบก่อนทันที · ฟ้าคือของ โบ๊ะบ๊ะ168)
// 🚨🚨 **"SLOT" สีน้ำเงินไล่ฟ้าในเวิร์ดมาร์กเป็นอาร์ตเวิร์ก ไม่ใช่สี UI**
// รางวงแหวนใช้เส้นคั่นจาง rgba(140,58,34,0.9) = #8c3a22 (เป็นเส้น ไม่ใช่ตัวอักษร
// ค่านี้จึงใช้ได้ ทั้งที่ถือตัวอักษรไม่ได้)
// ส่วนชื่อแบรนด์ไล่ ทอง #f2a033 -> ครีมอุ่น #fdeee2 (8.3 -> 17.6:1 บนแผง #2b100a)
// ซึ่งอ่านเป็นเวิร์ดมาร์กจริง: ตัวอักษรสามมิติที่มีไฮไลต์สว่างพาดอยู่ด้านบน
// ⚠️⚠️ **ปลายของ "ตัวอักษร" ห้ามลากลงไปถึง #de2b1e บนแผงเข้มนี้** เพราะแดงแกนได้
// แค่ 2.5:1 บน #2b100a ซึ่งไม่ผ่านสำหรับตัวอักษร
// (กลับด้านจากรอบก่อนที่ไล่ "เข้ม -> อ่อน" เพราะแผงรอบก่อนเป็นพื้นขาว
// รอบนี้แผงเป็นพื้นเข้ม ทิศของไล่เฉดจึงต้องกลับด้วย — **ห้ามคัดลอกข้ามรอบ**)
// ⚠️⚠️ **ไฟล์นี้เพิ่งเป็นชมพูบับเบิลกัมนำ-ขาวของ okkub88 เมื่อรอบที่แล้วเป๊ะๆ**
// (ffd6fa fff4fb ffe3f5 f9b2d9 f479b9 6a0f3c 95486b 9c0f55 fb439b fc74b5 ffc2e2
// d91a73 b01160 85094a — **ชุดที่เสี่ยงหลงเหลือที่สุด**) ก่อนหน้านั้นเป็น
// **ฟ้าสกายนำ-ขาวอมฟ้าของ โบ๊ะบ๊ะ168** (00bfff 12b4ef b6e3f0 06283f 0b4a73 2a87c4
// eaf7ff 0f5684 1a6ea8) และก่อนนั้นเป็น **ชมพูบานเย็นนำ-ขาวอมชมพูของ หมูบิน168**
// (fa539c c2185b 8e0f41 fb8cc0 fdc6c3 3b0b26 54123a 7a2350 ffe9f5)
// ก่อนหน้านั้นเป็นแดงเจลนำ-มุกอุ่นของ สล็อต168 (fb2e33 cb0b0d
// d81115 b00d11 8a0608 f0e6e4 c9b9b7 1c0607 0b0000 551c1e
// — ⚠️ **b00d11 ↔ #b01160 สี่ตัวแรก b01 ตรงกัน**) ก่อนหน้านั้นเป็นทองนำ-
// โครเมียมเงินของ รวย168 (ffd94a e3a712 9d6f06 e8eaee b4b9c2 070707 1c1a16)
// แดงคริมสัน-น้ำเงินอะซัวร์ของ มาดาม168 (ff2e52 e01238 c9102f 1177e8 0e68cc 0a4ea8
// 00091f 0b1733 16234a f4eef1) ฟ้าไซยาน-น้ำเงินอุลตรามารีนของ นาซ่า168 (1fd8f0
// 0bb6d4 1d4fd8 143aa0 e6edf8 0d1017) ฟ้าไซยาน-ครีมอุ่นของ ร่ำรวย168 (18a5e2
// 0d6b9b a9d7f2 f4e4d3 e4cbb3 111a3f) ทองแกน-ครีมอุ่นของ เงินทอง168 (f5ba14 fcee52
// b37c0b ecd5c4 d2b9a4 1b1407) ทองแกน-โครเมียมเงินของ พักยก168 (eeae12 fded41
// 9f600d e0e0df c0c0bf 1f0f04) ฟ้าสกาย-ทองคานารีของ สบาย168 (2cc3fc 6bdcfb 0a7fbd
// 063a57 fdcb0c) ทองคานารี-โครเมียมเงินของ ยูฟ้า168 (fee45d e6a416 b8780d e8ecf1
// a8b2bf 15130f) แดงเชอร์รี่-ทองแดงไหม้ของ โปรดี168 แดงคริมสัน-ทองโบราณของ
// รวยแท้168 เขียวมรกต-ทองสัมฤทธิ์ของ สาธุ168 ชมพูบานเย็นของ มีทรัพย์168
// ชมพูบับเบิลกัม-ทองเนยของ ถอนชัวร์168 ทอง-ชมพูฟูเชียของ มีโชค168
// 🚨🚨 **แดงผ่านไฟล์นี้มาแล้วหกเจ้า** (สล็อต168 · มาดาม168 · รวยแท้168 ·
// ดวงเศรษฐี168 · โปรดี168 · มีเฮ168) การเจอ "แดง" ในไฟล์นี้จึงไม่ได้แปลว่าเป็น
// ของรอบนี้ แดงรอบนี้คือ **#de2b1e** (+#f2543f #c81e12 #9d140c #6f0e08 #a81410)
// คู่กับทอง **#f2a033** และผิวโครม **#2b100a #431a10 #1d0a06 #8c3a22 #fdeee2**
// เพื่อนบ้านที่ใกล้ที่สุดคือ **fb2e33 ของ สล็อต168 ซึ่งห่างจาก #de2b1e แค่ R29/B21
// และ d9212a ของ ดวงเศรษฐี168 ห่างแค่ R5/G18/B12 — ใกล้ที่สุดในลิสต์
// ถ้าเจอค่าพวกนั้นแปลว่าพิมพ์ผิด** · f0b46a ของ โปรดี168 กับ f0c878 ของ
// ดวงเศรษฐี168 ก็ต่างจาก #f2a033 แค่ไบต์แรก — ให้เทียบเป็นตัวเลขกับตารางใน
// brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ
// false positive — และรอบนี้ไม่มีค่าฟ้า/ไซแอน/น้ำเงิน/ชมพู/แมเจนต้า/ม่วง/เขียวมิ้นต์/
// โรสโกลด์/เทาเงิน เหลือในไฟล์นี้เลย
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(222,43,30, 0.22) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(242,160,51, 0.25) 0%, transparent 55%), rgba(29,10,6, 0.97);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(222,43,30, 0.75);
    border-radius: 1.5rem;
    background: rgba(43,16,10, 0.98);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.45),
      0 0 2rem rgba(222,43,30, 0.28);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #fdeee2 0%, #f2a033 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #f2543f 0%, #de2b1e 55%, #6f0e08 100%);
    box-shadow: 0 0 2rem rgba(222,43,30, 0.5);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(140,58,34, 0.9);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #de2b1e;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #f2a033;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #fdeee2;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: #e8c6ae;
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(222,43,30, 0.5);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(242,160,51, 0.55);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
