---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// TND168 (รอบทองมังกรบนดำสนิท 2026-10-12): หน้าจอคั่นตอนกดปุ่มไป
// ลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render ตัวนี้
// ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก brand-spec §2: backdrop เป็นดำจม rgba(7,5,2) = #070502
// (พื้นเพจรอบนี้เป็นดำสนิท #000000 แล้ว backdrop จึงเสมอกันกับพื้นแทบทั้งหมด —
// ความต่างมาจากออร่าทองสองจุดแทน) ออร่าบนเป็นทองหลัก rgba(223,163,16) คู่กับ
// ทองไฮไลต์ rgba(255,201,61) ด้านล่าง แผงการ์ดเป็นผิวยก rgba(27,19,7) = #1b1307
// ⚠️ แผงการ์ดต้องสว่างกว่า backdrop เสมอ
// ออร์บไล่จากทองสว่าง #ffe4a3 เข้าหาทองไฮไลต์ #ffc93d แล้วจบที่ทองลึก #8a5c09
// (ออร์บเป็นรูปทรง ไม่ใช่ตัวอักษร #8a5c09 จึงใช้ได้ตรงนี้)
// วงแหวนคู่หมุนสวนทางกันและแยก "ค่า" กันจริง — วงนอกทองหลัก #dfa310 วงในทอง
// สว่าง #ffe4a3 เพราะแบรนด์รอบนี้เป็น **ฮิวเดียวล้วน ไม่มีสีที่สอง ไม่มีเงิน
// ไม่มีเทา ไม่มีชมพู** (เหรียญตรามังกรทองกับตัวอักษร TND168 ทองสามมิติ) วงแหวน
// สองวงจึงต่างกันที่ "ค่าความสว่างของทองเดียวกัน" ไม่ใช่ที่ตระกูลสี
// รางวงแหวนใช้เส้นคั่นจาง rgba(67,36,11) = #43240b บรอนซ์ลึกสุด (เป็นเส้น ไม่ใช่
// ตัวอักษร) ส่วนชื่อแบรนด์ไล่ ทองสว่าง #ffe4a3 -> ทองไฮไลต์ #ffc93d -> ทองหลัก #dfa310
// ⚠️ ปลายเข้มของ "ตัวอักษร" หยุดที่ #dfa310 ไม่ใช่ #8a5c09 — #8a5c09 บนแผง #1b1307
// ได้ ~2.9:1 ตกเกณฑ์แม้แต่ตัวอักษรใหญ่ ส่วน #dfa310 ได้ ~7.6:1 ผ่านสบาย
// (brand-spec §2: #8a5c09 / #43240b ห้ามถือตัวอักษรทุกขนาด)
// ⚠️ ไฟล์นี้เคยเป็นชมพู-ทองของ PUNPRO168 และก่อนหน้านั้นเป็นทองของ TIGERWIN369
// การเจอทองจึง **ไม่ได้แปลว่าเป็นของรอบนี้** ให้เทียบเป็นตัวเลขกับตาราง
// ใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ
// false positive — และรอบนี้ไม่มีค่าชมพู/ม่วง/เงิน/เทา/เขียวเหลืออยู่ในไฟล์นี้เลย
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(223, 163, 16, 0.26) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(255, 201, 61, 0.18) 0%, transparent 55%), rgba(7, 5, 2, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(223, 163, 16, 0.6);
    border-radius: 1.5rem;
    background: rgba(27, 19, 7, 0.94);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.7),
      0 0 2rem rgba(223, 163, 16, 0.32);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #ffe4a3 0%, #ffc93d 50%, #dfa310 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #ffe4a3 0%, #ffc93d 55%, #8a5c09 100%);
    box-shadow: 0 0 2rem rgba(223, 163, 16, 0.6);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(67, 36, 11, 0.8);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #dfa310;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #ffe4a3;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #f0e9dc;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(240, 233, 220, 0.8);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(223, 163, 16, 0.6);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(255, 228, 163, 0.45);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
