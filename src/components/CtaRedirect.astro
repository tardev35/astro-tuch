---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// okkub88 (รอบชมพูบับเบิลกัมนำ ขาวรอง บน **ธีมสว่าง**): หน้าจอคั่นตอนกดปุ่มไป
// ลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render ตัวนี้
// ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก .claude/brand-spec-okkub88.md §2
// ⚠️⚠️⚠️ **รอบนี้ overlay เป็นผิว "สว่าง" — กลับทิศจากทุกรอบก่อนหน้า**
// ทุกรอบที่ผ่านมาไฟล์นี้เป็นผิวมืดด้วยเหตุผลว่า "ต้องกลบหน้าข้างหลังได้สนิท"
// ซึ่งยังเป็นเงื่อนไขที่ต้องรักษา — แต่สิ่งที่ทำให้กลบสนิทคือ **ค่า alpha (0.97)
// ไม่ใช่ความมืด** รอบนี้จึงกลบด้วยชมพูพาสเทล rgba(255,214,250,0.97) ซึ่งทึบเท่ากัน
// เหตุผลที่ต้องกลับทิศ: อาร์ตเวิร์กทั้งดรอป (โลโก้ แบนเนอร์ สองสไลด์) เป็นฉาก
// สตูดิโอ **ขาว** ไม่มีพื้นเข้มอยู่ในภาพไหนเลย และ navbar/footer/ticker รอบนี้
// ก็เป็นผิวสว่างทั้งหมด — จอคั่นสีเข้มจะเป็นหน้าจอเดียวในเว็บที่มืด บนจังหวะ
// ที่ผู้ใช้กำลัง convert พอดี **ห้าม "แก้" ให้กลับไปมืดตามรอบก่อนๆ**
// backdrop เป็นชั้นชมพูพาสเทล rgba(255,214,250) ออร่าบนเป็น **ชมพูแกนแบรนด์**
// rgba(251,67,155) คู่กับ **ชมพูพาสเทล** rgba(255,194,226) ด้านล่าง
// — ฮิวนำอยู่บน แผงการ์ดเป็นผิวขาว rgba(255,255,255) = #ffffff
// ⚠️ แผงการ์ดต้อง **ต่างค่า** จาก backdrop เสมอ (รอบนี้ #ffffff ขาวสนิท vs
// #ffd6fa ชมพูของ backdrop — กลับด้านจากรอบก่อนที่แผง "สว่างกว่า" พื้น)
// ⚠️ ค่าทุกค่าในไฟล์นี้อยู่ในชุด rgba ที่ brand-spec §2 อนุญาต (251/67/155 ·
// 255/194/226 · 249/178/217 · 156/15/85 · 217/26/115 · 255/214/250 · 106/15/60)
// ออร์บไล่จากชมพูสด #fb439b เข้าหาชมพูลึก #9c0f55 แล้วจบที่เบอร์รีลึกสุด #6a0f3c
// — การไล่ "สว่างออกเข้ม" คืออ่านจากโลโก้ตรงๆ (ตัวอักษรเวิร์ดมาร์กเป็นผิวเจลลี่
// สามมิติมันวาว ไล่จากชมพูอ่อนที่ยอดลงชมพูเข้มที่ฐาน ตัดขอบขาวหนา)
// วงแหวนคู่หมุนสวนทางกันและแยกค่ากันจริง — วงนอก **ชมพูสด #fb439b**
// วงใน **ชมพูพาสเทล #ffc2e2** ซึ่งคือคู่วัสดุบนเวิร์ดมาร์กเป๊ะๆ: ตัวเจลลี่ชมพู
// ที่มีขอบตัดขาวและไฮไลต์ขาวพาดอยู่บนตัวอักษรทุกตัว
// ⚠️⚠️ **คาร์ดิแกนถักชมพูของนักแสดงและหมูการ์ตูนในสไลด์เป็นวัตถุในภาพ ส่วนชมพูของ
// UI มาจากตัวอักษรในโลโก้กับหัวใจประดับ** และ **ห้ามเอาฟ้า/ทอง/เหลือง/แดง/ครีม/
// เบจ/เทาเงินกลับเข้ามา** (ฟ้าสกายคือฮิวนำของ โบ๊ะบ๊ะ168 รอบก่อนทันที)
// รางวงแหวนใช้เส้นคั่นจาง rgba(249,178,217,0.9) = #f9b2d9 (เป็นเส้น ไม่ใช่ตัวอักษร
// ค่านี้จึงใช้ได้ ทั้งที่ถือตัวอักษรไม่ได้)
// ส่วนชื่อแบรนด์ไล่ ชมพูลึก #9c0f55 -> ชมพูเข้ม #d91a73 (8.1 -> 4.8:1 บนแผงขาว)
// ซึ่งอ่านเป็นเวิร์ดมาร์กจริง: เนื้อเจลลี่ชมพูไล่เข้มลงหาเงาที่ฐาน
// ⚠️⚠️ **ปลายของ "ตัวอักษร" หยุดที่ #d91a73 — ลากลงไปถึง #fb439b ไม่ได้บนแผงขาวนี้**
// เพราะชมพูสดได้แค่ 3.3:1 บน #ffffff ซึ่งไม่ผ่านสำหรับตัวอักษร
// (กลับด้านจากรอบก่อนที่ไล่ "สว่าง -> อ่อน" เพราะแผงรอบก่อนเป็นพื้นเข้ม
// รอบนี้แผงเป็นพื้นขาว ทิศของไล่เฉดจึงต้องกลับด้วย — **ห้ามคัดลอกข้ามรอบ**)
// ⚠️⚠️ **ไฟล์นี้เพิ่งเป็นฟ้าสกายนำ-ขาวอมฟ้าของ โบ๊ะบ๊ะ168 เมื่อรอบที่แล้วเป๊ะๆ**
// (00bfff 12b4ef b6e3f0 06283f 0b4a73 2a87c4 eaf7ff 0f5684 1a6ea8 — **ชุดที่เสี่ยง
// หลงเหลือที่สุด**) ก่อนหน้านั้นเป็น **ชมพูบานเย็นนำ-ขาวอมชมพูของ หมูบิน168**
// (fa539c c2185b 8e0f41 fb8cc0 fdc6c3 3b0b26 54123a 7a2350 ffe9f5
// — 🚨 **ชุดนี้เป็นชมพูเหมือนรอบนี้ ต้องเทียบทีละค่า ห้ามตัดสินด้วยสายตา:
// ffe9f5 ↔ #ffe9f7 ต่างแค่ไบต์สุดท้าย · fb8cc0 ↔ #fb439b R เท่ากันเป๊ะ**)
// ก่อนหน้านั้นเป็นแดงเจลนำ-มุกอุ่นของ สล็อต168 (fb2e33 cb0b0d
// d81115 b00d11 8a0608 f0e6e4 c9b9b7 1c0607 0b0000 551c1e
// — ⚠️ **b00d11 ↔ #b01160 สี่ตัวแรก b01 ตรงกัน**) ก่อนหน้านั้นเป็นทองนำ-
// โครเมียมเงินของ รวย168 (ffd94a e3a712 9d6f06 e8eaee b4b9c2 070707 1c1a16)
// แดงคริมสัน-น้ำเงินอะซัวร์ของ มาดาม168 (ff2e52 e01238 c9102f 1177e8 0e68cc 0a4ea8
// 00091f 0b1733 16234a f4eef1) ฟ้าไซยาน-น้ำเงินอุลตรามารีนของ นาซ่า168 (1fd8f0
// 0bb6d4 1d4fd8 143aa0 e6edf8 0d1017) ฟ้าไซยาน-ครีมอุ่นของ ร่ำรวย168 (18a5e2
// 0d6b9b a9d7f2 f4e4d3 e4cbb3 111a3f) ทองแกน-ครีมอุ่นของ เงินทอง168 (f5ba14 fcee52
// b37c0b ecd5c4 d2b9a4 1b1407) ทองแกน-โครเมียมเงินของ พักยก168 (eeae12 fded41
// 9f600d e0e0df c0c0bf 1f0f04) ฟ้าสกาย-ทองคานารีของ สบาย168 (2cc3fc 6bdcfb 0a7fbd
// 063a57 fdcb0c) ทองคานารี-โครเมียมเงินของ ยูฟ้า168 (fee45d e6a416 b8780d e8ecf1
// a8b2bf 15130f) แดงเชอร์รี่-ทองแดงไหม้ของ โปรดี168 แดงคริมสัน-ทองโบราณของ
// รวยแท้168 เขียวมรกต-ทองสัมฤทธิ์ของ สาธุ168 ชมพูบานเย็นของ มีทรัพย์168
// ชมพูบับเบิลกัม-ทองเนยของ ถอนชัวร์168 ทอง-ชมพูฟูเชียของ มีโชค168
// 🚨🚨 **ชมพูผ่านไฟล์นี้มาแล้วห้าเจ้า** (หมูบิน168 · มีทรัพย์168 · ถอนชัวร์168 ·
// มีโชค168 · PUNPRO168) การเจอ "ชมพู" ในไฟล์นี้จึงไม่ได้แปลว่าเป็นของรอบนี้
// ชมพูรอบนี้คือ **#fb439b** (+#9c0f55 #6a0f3c #ffc2e2 #f9b2d9 #d91a73 #ffd6fa)
// เพื่อนบ้านที่ใกล้ที่สุดคือ **fb8cc0 ของ หมูบิน168 ซึ่งมี R=fb ตรงกับ #fb439b เป๊ะ
// และ f41571 ของ PUNPRO168 ห่างจาก #fb439b แค่ R7/G46/B38 — ใกล้ที่สุดในลิสต์
// ถ้าเจอค่าพวกนั้นแปลว่าพิมพ์ผิด** · ffe9f5 ของ หมูบิน168 ก็ต่างจาก #ffe9f7
// แค่ไบต์สุดท้าย — ให้เทียบเป็นตัวเลขกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive — และรอบนี้ไม่มีค่าฟ้า/ไซแอน/
// น้ำเงิน/ทอง/เหลือง/แดง/ม่วง/ส้ม/เขียว/โรสโกลด์/น้ำตาล/ครีม/เทาเงิน เหลือในไฟล์นี้เลย
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(251,67,155, 0.22) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(255,194,226, 0.25) 0%, transparent 55%), rgba(255,214,250, 0.97);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(251,67,155, 0.75);
    border-radius: 1.5rem;
    background: rgba(255,255,255, 0.98);
    box-shadow:
      0 1rem 3rem rgba(106, 15, 60, 0.22),
      0 0 2rem rgba(251,67,155, 0.28);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #9c0f55 0%, #d91a73 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #fb439b 0%, #9c0f55 55%, #6a0f3c 100%);
    box-shadow: 0 0 2rem rgba(251,67,155, 0.5);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(249,178,217, 0.9);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #fb439b;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #ffc2e2;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #6a0f3c;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: #95486b;
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(251,67,155, 0.5);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(255,194,226, 0.55);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
