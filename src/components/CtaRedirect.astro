---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// สล็อต168 (รอบแดงเจลนำ มุกขาวรอง บน **ธีมมืด**): หน้าจอคั่นตอนกดปุ่มไปลิงก์
// พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render ตัวนี้
// ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก .claude/brand-spec-slot168.md §2 (โซน "โครม")
// ⚠️ **รอบนี้พื้นเพจเป็นดำอมแดงเข้ม #140000 (จาก bg.json ซึ่งรอบก่อนเป็น 000000 =
// ดำสนิท)** overlay ตัวนี้เป็น **โครม จึงเป็นผิวมืดอยู่แล้วเหมือนทุกรอบ**
// — มันต้องกลบหน้าข้างหลังได้สนิท ซึ่งเป็นเหตุผลเดียวกันทุกรอบ
// **ห้าม "แก้" ให้สว่างตามพื้นเพจ**
// backdrop เป็นชั้นดำ rgba(0,0,0) ออร่าบนเป็น **แดงแกนแบรนด์**
// rgba(251,46,51) คู่กับ **มุกอุ่น** rgba(240,230,228) ด้านล่าง
// — ฮิวนำอยู่บน แผงการ์ดเป็นผิวกลาง rgba(28,6,7) = #1c0607
// ⚠️ แผงการ์ดต้องสว่างกว่า backdrop เสมอ (#1c0607 กลาง vs ดำทึบของ backdrop)
// ⚠️ ค่าทุกค่าในไฟล์นี้อยู่ในชุด rgba ที่ brand-spec §2 อนุญาต (251/46/51 ·
// 203/11/13 · 176/13/17 · 138/6/8 · 240/230/228 · 85/28/30 · 0/0/0) โดยตั้งใจ
// ออร์บไล่จากแดงสด #fb2e33 เข้าหาแดงลึก #cb0b0d แล้วจบที่แดงลึกสุด #8a0608
// — การไล่ "สว่างออกเข้ม" คืออ่านจากโลโก้ตรงๆ (ตัวอักษร "สล็อต168" เป็นผิวเจล
// สามมิติมันวาว ไล่จากแดงสว่างที่ยอดลงแดงเข้มที่ฐาน มีไฮไลต์ขาวพาดบนผิว)
// วงแหวนคู่หมุนสวนทางกันและแยกค่ากันจริง — วงนอก **แดงสด #fb2e33**
// วงใน **มุกอุ่น #f0e6e4** ซึ่งคือคู่วัสดุบนเวิร์ดมาร์กเป๊ะๆ: ตัวเจลแดง
// ที่มีไฮไลต์ขาวสเปกคูลาร์พาดอยู่บนตัวอักษรทุกตัว
// ⚠️⚠️ **คาร์ดิแกนแดงของนักแสดงเป็นวัตถุในภาพ ส่วนแดงของ UI มาจากตัวอักษรใน
// โลโก้** และ **มงกุฎทองเล็กเป็นรายละเอียด ~2% ของอาร์ตเวิร์ก ไม่ใช่สี UI —
// ห้ามเอาทอง/เหลือง/ครีม/พีช/เบจกลับเข้ามา** (ทองคือฮิวนำของรวย168 รอบก่อนทันที)
// รางวงแหวนใช้เส้นคั่นจาง rgba(85,28,30,0.8) = #551c1e (เป็นเส้น ไม่ใช่ตัวอักษร
// ค่านี้จึงใช้ได้ ทั้งที่ถือตัวอักษรไม่ได้)
// ส่วนชื่อแบรนด์ไล่ มุกอุ่น #f0e6e4 -> แดงสด #fb2e33 (16.0 -> 5.1:1 บนแผง
// #1c0607) ซึ่งอ่านเป็นเวิร์ดมาร์กจริง: ไฮไลต์ขาวที่ยอดไล่ลงเนื้อเจลแดง
// ⚠️ ปลายของ "ตัวอักษร" หยุดที่ #fb2e33 — **ลากลงไปถึง #cb0b0d ไม่ได้บนแผงเข้มนี้**
// เพราะแดงลึกได้แค่ 3.5:1 บน #1c0607 ซึ่งคาบเส้นเกินไปสำหรับตัวอักษร letter-spacing
// กว้างขนาดนี้
// ⚠️⚠️ **ไฟล์นี้เพิ่งเป็นทองนำ-โครเมียมเงินของ รวย168 เมื่อรอบที่แล้วเป๊ะๆ**
// (ffd94a e3a712 9d6f06 b07d08 e8eaee b4b9c2 6b7079 dde1e7 070707 121110 1c1a16
// 3d3425 f3ece0 bfb8aa — **ชุดที่เสี่ยงหลงเหลือที่สุด**) ก่อนหน้านั้นเป็นแดง
// คริมสัน-น้ำเงินอะซัวร์ของ มาดาม168 (ff2e52 e01238 c9102f 1177e8 0e68cc 0a4ea8
// 00091f 050e26 0b1733 16234a 2a3c70 f4eef1 b3bdd6 d9dfe9) ก่อนหน้านั้นเป็นฟ้า
// ไซยาน-น้ำเงินอุลตรามารีนของ นาซ่า168 (1fd8f0 0bb6d4 8fd9ec 1d4fd8 143aa0 e6edf8
// 9fb2cb 1b2434 33455f 0d1017) ก่อนหน้านั้นเป็นฟ้าไซยาน-ครีมอุ่นของ ร่ำรวย168
// (18a5e2 0d6b9b a9d7f2 f4e4d3 e4cbb3 111a3f 202a66 31408a e9f1ff adc0e4)
// ก่อนหน้านั้นเป็นทองแกน-ครีมอุ่นของ เงินทอง168 (f5ba14 fcee52 b37c0b ecd5c4
// d2b9a4 1b1407 2e2512 4d3c15 29210f) ก่อนหน้านั้นเป็นทองแกน-โครเมียมเงินของ
// พักยก168 (eeae12 fded41 9f600d e0e0df c0c0bf a1a09e f4ead6 d6c6a8 291d0f 2f1e0f
// 1f0f04 4e2f11) ก่อนหน้านั้นเป็นฟ้าสกาย-ทองคานารีของ สบาย168 (2cc3fc 6bdcfb
// 0a7fbd 063a57 04293d 0a4f74 fdcb0c eafaff) ก่อนหน้านั้นเป็นทองคานารี-โครเมียมเงิน
// ของ ยูฟ้า168 (fee45d e6a416 b8780d 7a4e05 e8ecf1 a8b2bf 78828f 5a6472 15130f
// 1e1a13 0a0908 eae3d4 fff8dd) ก่อนหน้านั้นเป็นแดงเชอร์รี่-ทองแดงไหม้ของ โปรดี168
// (eb0305 9b0a0c ff4446 b44c06 f0b46a 401107 fff4ea fff0e4) แดงคริมสัน-ทองโบราณ
// ของ รวยแท้168 เขียวมรกต-ทองสัมฤทธิ์ของ สาธุ168 ชมพูบานเย็นของ มีทรัพย์168
// แดงชาด-ทองน้ำผึ้งของ ดวงเศรษฐี168 ทองอำพัน-บรอนซ์ของ ufalion168 ทองจักรพรรดิ-
// แดงชาดของ รวยเทพ168 แดงชาด-ทองเนยของ มีเฮ168 ทอง-โรสโกลด์ของ ขวัญใจ168
// ทองไทย-แดงมังกรของ รับตัง168 แดงมังกร-ทองของ สมหวัง168 แดงมังกร-โครเมียมของ GT66B
// 🚨🚨 **แดงผ่านไฟล์นี้มาแล้วหลายเจ้ามาก** การเจอ "แดง" ในไฟล์นี้จึงไม่ได้แปลว่า
// เป็นของรอบนี้ แดงรอบนี้คือ **#fb2e33** (+#cb0b0d #b00d11 #8a0608) เพื่อนบ้าน
// ที่ใกล้ที่สุดคือ **fb141b ของ GT66B ห่างแค่ R0/G26/B24 และ 8a0609 ของ GT66B
// ห่างจาก #8a0608 แค่ B1 — ใกล้ที่สุดในลิสต์ ถ้าเจอค่าพวกนั้นแปลว่าพิมพ์ผิด** ·
// fb1b32 ของมีเฮ168 ห่าง R0/G19/B1 · f5282a ของหวย365 ห่าง R6/G6/B9 — ให้เทียบ
// เป็นตัวเลขกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่เพื่อไม่ให้ grep หาสีของ
// แบรนด์เก่าเจอ false positive — และรอบนี้ไม่มีค่าทอง/เหลือง/ชมพู/ม่วง/ส้ม/เขียว/
// น้ำเงิน/ฟ้า/โรสโกลด์/น้ำตาล/ครีม เหลือในไฟล์นี้เลย
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(251,46,51, 0.20) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(240,230,228, 0.10) 0%, transparent 55%), rgba(0,0,0, 0.97);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(203,11,13, 0.65);
    border-radius: 1.5rem;
    background: rgba(28,6,7, 0.96);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.7),
      0 0 2rem rgba(203,11,13, 0.28);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #f0e6e4 0%, #fb2e33 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #fb2e33 0%, #cb0b0d 55%, #8a0608 100%);
    box-shadow: 0 0 2rem rgba(203,11,13, 0.5);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(85,28,30, 0.8);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #fb2e33;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #f0e6e4;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #f0e6e4;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: #c9b9b7;
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(203,11,13, 0.5);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(240,230,228, 0.35);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
