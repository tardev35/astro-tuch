---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// TSDET911 (รอบน้ำเงินไฟฟ้า-เงินโครเมียม 2026-10-13): หน้าจอคั่นตอนกดปุ่มไป
// ลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render ตัวนี้
// ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก .claude/brand-spec-tsdet911.md §2: backdrop เป็นกรมจม
// rgba(4,14,38) = #040e26 (พื้นเพจรอบนี้เป็นกรมเกือบดำ #00081f backdrop จึงเสมอกัน
// กับพื้นแทบทั้งหมด — ความต่างมาจากออร่าสองจุดแทน) ออร่าบนเป็นน้ำเงินแบรนด์
// rgba(3,96,243) คู่กับฟ้าสด rgba(2,146,251) ด้านล่าง แผงการ์ดเป็นผิวยก
// rgba(16,42,94) = #102a5e
// ⚠️ แผงการ์ดต้องสว่างกว่า backdrop เสมอ
// ออร์บไล่จากเงินโครเมียม #cfdcec เข้าหาฟ้าสว่าง #6ec8ff แล้วจบที่น้ำเงินแบรนด์
// #0360f3 (ออร์บเป็นรูปทรง ไม่ใช่ตัวอักษร #0360f3 จึงใช้ได้ตรงนี้) — การไล่
// "เงินเข้าน้ำเงิน" คือแบรนด์สองโทนของรอบนี้อ่านจากโลโก้ตรงๆ (ตัวอักษร TSDET
// เงินโครเมียม + เลข 911 น้ำเงินไฟฟ้า)
// วงแหวนคู่หมุนสวนทางกันและแยก "โทน" กันจริง — วงนอกฟ้าสด #0292fb วงในเงิน
// โครเมียม #cfdcec ต่างจากรอบก่อน (KMD88) ที่เป็นม่วงสว่างคู่ทองแบรนด์
// รางวงแหวนใช้เส้นคั่นจาง rgba(4,24,110,0.8) = #04186e น้ำเงินลึกสุด (เป็นเส้น
// ไม่ใช่ตัวอักษร) ส่วนชื่อแบรนด์ไล่ เงินโครเมียม #cfdcec -> ฟ้าสว่าง #6ec8ff ->
// ฟ้าอ่อน #4fb4ff
// ⚠️ ปลายเข้มของ "ตัวอักษร" หยุดที่ #4fb4ff ไม่ใช่ #0292fb หรือ #0360f3 —
// #0360f3 บนแผง #102a5e ได้ ~2.4:1 และ #0292fb ได้ ~3.9:1 ส่วน #4fb4ff ได้
// ~6.0:1 ผ่าน AA สำหรับข้อความปกติด้วยซ้ำ
// (brand-spec §2: #0360f3 / #0292fb / #032dad / #04186e / #041a43 ห้ามถือตัวอักษร
// ทุกขนาด)
// ⚠️ ไฟล์นี้เคยเป็นม่วง-ทองของ KMD88 ก่อนหน้านั้นเป็นทองล้วนของ TND168 และก่อน
// หน้านั้นเป็นชมพู-ทองของ PUNPRO168 การเจอน้ำเงินในไฟล์แนวนี้จึงไม่ได้แปลว่าเป็น
// ของรอบนี้ ให้เทียบเป็นตัวเลขกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive —
// และรอบนี้ไม่มีค่าทอง/ม่วง/ชมพู/เขียว/แดง/ส้มเหลืออยู่ในไฟล์นี้เลย
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(3, 96, 243, 0.3) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(2, 146, 251, 0.18) 0%, transparent 55%), rgba(4, 14, 38, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(3, 96, 243, 0.65);
    border-radius: 1.5rem;
    background: rgba(16, 42, 94, 0.94);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.7),
      0 0 2rem rgba(3, 96, 243, 0.38);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #cfdcec 0%, #6ec8ff 50%, #4fb4ff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #cfdcec 0%, #6ec8ff 55%, #0360f3 100%);
    box-shadow: 0 0 2rem rgba(3, 96, 243, 0.6);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(4, 24, 110, 0.8);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #0292fb;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #cfdcec;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #dde8f7;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(221, 232, 247, 0.8);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(3, 96, 243, 0.6);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(2, 146, 251, 0.45);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
