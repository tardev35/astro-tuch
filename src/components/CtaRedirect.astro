---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// HI59 (รอบฟ้า-ทอง บนกรมท่าเข้ม 2026-10-07): หน้าจอคั่นตอนกดปุ่มไปลิงก์พันธมิตร
// แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render ตัวนี้ ถ้าไม่ retheme
// ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// จอนี้เป็น overlay เต็มจอและเป็น chrome จึงยังเป็นผิวเข้มแม้ทั้งเว็บรอบนี้จะสว่าง
// สีทุกค่ามาจาก brand-spec §2: backdrop เป็นพื้นลึกสุด rgba(2,22,44) = #02162c
// แผงการ์ดเป็นผิวยก rgba(4,32,63) = #04203f ออร่าเป็นฟ้าแบรนด์ rgba(10,132,224)
// กับทองแบรนด์ rgba(253,188,4) ออร์บไล่จากฟ้าสว่าง #5ec2ff เข้าหาฟ้าแบรนด์
// #0a84e0 แล้วจบที่ฟ้าลึก #033f70
// วงแหวนคู่หมุนสวนทางกันและแยก "สี" กันจริง (วงนอกฟ้า #0a84e0 วงในทอง #fdbc04)
// ตามคู่สีของงานศิลป์รอบนี้: โลโก้เป็น HI ฟ้าเงาคู่กับ 59 ทองเงา ส่วนแบนเนอร์
// เป็นท้องฟ้าฟ้าสดกับเหรียญทอง รางวงแหวนใช้เส้นขอบ/คั่นจาง rgba(3,63,112) =
// #033f70 ส่วนชื่อแบรนด์ไล่ ฟ้าสว่าง -> ทองแบรนด์ -> ฟ้าลึก
// ชุดแดง-เงินของแบรนด์ก่อน (#eef0f4 #f5363d #dc0409 #7a0205 #c3c7d1 #4b0205
// rgba(220,4,9) rgba(195,199,209) rgba(13,4,7) rgba(23,8,12) rgba(237,234,240))
// ไม่เหลือแล้ว
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(10, 132, 224, 0.32) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(253, 188, 4, 0.18) 0%, transparent 55%), rgba(2, 22, 44, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(10, 132, 224, 0.5);
    border-radius: 1.5rem;
    background: rgba(4, 32, 63, 0.94);
    box-shadow:
      0 1rem 3rem rgba(2, 22, 44, 0.6),
      0 0 2rem rgba(10, 132, 224, 0.26);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #5ec2ff 0%, #fdbc04 50%, #033f70 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #5ec2ff 0%, #0a84e0 55%, #033f70 100%);
    box-shadow: 0 0 2rem rgba(10, 132, 224, 0.5);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(3, 63, 112, 0.7);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #0a84e0;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #fdbc04;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #cfe4f8;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(228, 241, 253, 0.80);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(10, 132, 224, 0.5);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(94, 194, 255, 0.45);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
