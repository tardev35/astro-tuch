---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// DUCK1688 (รอบทองเป็ด-ส้มปากเป็ด 2026-10-10): หน้าจอคั่นตอนกดปุ่มไป
// ลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render ตัวนี้
// ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก brand-spec §2: backdrop เป็นดำสนิท rgba(0,0,0) = พื้นเพจรอบนี้
// (bg.json = #000000) ออร่าบนเป็นทองแบรนด์ rgba(243,187,52) คู่กับส้มอำพัน
// rgba(245,139,42) ด้านล่าง แผงการ์ดเป็นผิวยก rgba(31,23,9) = #1f1709
// ⚠️ รอบนี้พื้นเพจดำสนิท แผงการ์ดจึงต้อง "สว่างกว่า" backdrop ไม่ใช่เข้มกว่า
// ออร์บไล่จากทองสว่าง #fde464 เข้าหาทองแบรนด์ #f3bb34 แล้วจบที่ทองลึก #8a5f08
// (ออร์บเป็นรูปทรง ไม่ใช่ตัวอักษร #8a5f08 จึงใช้ได้ตรงนี้ที่เดียว)
// วงแหวนคู่หมุนสวนทางกันและแยก "สี" กันจริง รอบนี้เป็นสองฮิวจริง (วงนอกทองแบรนด์
// #f3bb34 วงในส้มอำพัน #f58b2a) เพราะโลโก้รอบนี้เป็นเป็ดการ์ตูนสีเหลืองสวมมงกุฎทอง
// ที่มีปากสีส้มอำพัน อยู่เหนือแผ่นป้ายดำขอบทอง — ส้มเป็นฮิวที่สองจริง ไม่ใช่
// โลหะเดียว รางวงแหวนใช้เส้นขอบ/คั่นจาง rgba(163,81,12) = #a3510c ส้มลึก
// (เป็นเส้น ไม่ใช่ตัวอักษร)
// ส่วนชื่อแบรนด์ไล่ ทองสว่าง #fde464 -> ทองแบรนด์ #f3bb34 -> ทองกลางเข้ม #c8901a
// ⚠️ ปลายเข้มของ "ตัวอักษร" หยุดที่ #c8901a ไม่ใช่ #8a5f08 — #8a5f08 บนแผง #1f1709
// ได้แค่ 3.1:1 ตกแม้แต่เกณฑ์ตัวอักษรใหญ่ ส่วน #c8901a ได้ 6.3:1 ผ่านสบาย
// (brand-spec §2: #8a5f08 / #5c3f04 / #a3510c ห้ามถือตัวอักษรทุกขนาด)
// ชุดทองอวกาศ-เงินโครเมียมของ NAZA168 (#fbc134 #ffe87a #cf9a18 #96690a #cfd6e3
// #3f4859 #432b03 #241700 #fdf3df rgba(251,193,52,α) rgba(207,214,227,α)
// rgba(253,243,223,α) rgba(255,232,122,α) rgba(36,23,0,α) rgba(67,43,3,α))
// และชุดทองสายฟ้า-แดงเลือดนกของ FLASH877 (#f5c518 #ffdd73 #b8860f #ff3b14
// #fdf0e2) ไม่เหลือแล้ว
// ⚠️ รอบก่อนก็เป็นแบรนด์ "ทอง" เหมือนกัน แต่คนละค่าทุกตัว และรอบนี้ไม่มีเงิน
// โครเมียมเป็นฮิวเลย — ฮิวที่สองเป็นส้มอำพัน ให้เทียบเป็นตัวเลข อย่าเทียบด้วยตา
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(243, 187, 52, 0.26) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(245, 139, 42, 0.2) 0%, transparent 55%), rgba(0, 0, 0, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(243, 187, 52, 0.6);
    border-radius: 1.5rem;
    background: rgba(31, 23, 9, 0.94);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.7),
      0 0 2rem rgba(243, 187, 52, 0.32);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #fde464 0%, #f3bb34 50%, #c8901a 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #fde464 0%, #f3bb34 55%, #8a5f08 100%);
    box-shadow: 0 0 2rem rgba(243, 187, 52, 0.6);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(163, 81, 12, 0.8);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #f3bb34;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #f58b2a;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #f6ecd9;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(246, 236, 217, 0.8);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(243, 187, 52, 0.6);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(253, 228, 100, 0.45);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
