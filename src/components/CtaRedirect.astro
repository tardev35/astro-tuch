---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// UFA324 (รอบทองแชมเปี้ยน-เงินโครเมียม 2026-10-11): หน้าจอคั่นตอนกดปุ่มไป
// ลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render ตัวนี้
// ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก brand-spec §2: backdrop เป็นดำสนิท rgba(0,0,0) = พื้นเพจรอบนี้
// (bg.json = #000000) ออร่าบนเป็นทองแบรนด์ rgba(229,168,27) คู่กับเงินโครเมียม
// rgba(185,194,204) ด้านล่าง แผงการ์ดเป็นผิวยก rgba(35,28,14) = #231c0e
// ⚠️ รอบนี้พื้นเพจ **เป็นดำสนิท** แล้ว (รอบก่อนเป็นพลัม #2e002c) แผงการ์ดจึงต้อง
// สว่างกว่า backdrop ชัดเจนกว่าเดิม
// ออร์บไล่จากทองสว่าง #ffe08a เข้าหาทองแบรนด์ #e5a81b แล้วจบที่ทองลึก #7d5a07
// (ออร์บเป็นรูปทรง ไม่ใช่ตัวอักษร #7d5a07 จึงใช้ได้ตรงนี้ที่เดียว)
// วงแหวนคู่หมุนสวนทางกันและแยก "สี" กันจริง รอบนี้เป็นสองฮิวจริง (วงนอกทองแบรนด์
// #e5a81b วงในเงินโครเมียม #b9c2cc) เพราะโลโก้รอบนี้เป็นลูกฟุตบอลทองบนถ้วยรางวัล
// ทอง เหนือตัวอักษร UFA ทองต่อด้วยเลข **324 เงินโครเมียม** — เงินเป็นฮิวที่สองจริง
// ไม่ใช่ทองเฉดเดียว รางวงแหวนใช้เส้นขอบ/คั่นจาง rgba(70,79,90) = #464f5a เงินลึก
// (เป็นเส้น ไม่ใช่ตัวอักษร)
// ส่วนชื่อแบรนด์ไล่ ทองสว่าง #ffe08a -> ทองไฮไลต์ #ffcf5e -> ทองแบรนด์ #e5a81b
// ⚠️ ปลายเข้มของ "ตัวอักษร" หยุดที่ #e5a81b ไม่ใช่ #7d5a07 — #7d5a07 บนแผง #231c0e
// ได้แค่ 2.8:1 ตกแม้แต่เกณฑ์ตัวอักษรใหญ่ ส่วน #e5a81b ได้ 8.2:1 ผ่านทั้งเกณฑ์
// ตัวใหญ่และตัวปกติ (brand-spec §2: #7d5a07 / #43300a / #464f5a ห้ามถือตัวอักษร
// ทุกขนาด)
// ชุดชมพูบานเย็น-ทองของ FAH999 (#ff3fa4 #ff6cbb #ffd1ea #f5c53d #b3006a #9c6f08
// #fde8f3 #4a0b42 rgba(255,63,164,α) rgba(245,197,61,α) rgba(255,209,234,α)
// rgba(46,0,44,α) rgba(74,11,66,α) rgba(253,232,243,α)) ชุดทองเป็ด-ส้มปากเป็ดของ
// DUCK1688 (#f3bb34 #fde464 #c8901a #8a5f08 #f58b2a #a3510c #f6ecd9 #1f1709)
// และชุดทองอวกาศ-เงินโครเมียมของ NAZA168 (#fbc134 #ffe87a #cf9a18 #cfd6e3
// #432b03 #241700 #fdf3df) ไม่เหลือแล้ว
// ⚠️ NAZA168 ก็เป็นคู่ "ทอง-เงินโครเมียม" เหมือนกัน การเจอทองคู่เงินในไฟล์นี้จึง
// **ไม่ได้แปลว่าเป็นของรอบนี้** ให้เทียบเป็นตัวเลข: #e5a81b ไม่ใช่ #fbc134 และ
// #b9c2cc ไม่ใช่ #cfd6e3
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(229, 168, 27, 0.26) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(185, 194, 204, 0.2) 0%, transparent 55%), rgba(0, 0, 0, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(229, 168, 27, 0.6);
    border-radius: 1.5rem;
    background: rgba(35, 28, 14, 0.94);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.7),
      0 0 2rem rgba(229, 168, 27, 0.32);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #ffe08a 0%, #ffcf5e 50%, #e5a81b 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #ffe08a 0%, #e5a81b 55%, #7d5a07 100%);
    box-shadow: 0 0 2rem rgba(229, 168, 27, 0.6);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(70, 79, 90, 0.8);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #e5a81b;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #b9c2cc;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #f0e8d4;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(240, 232, 212, 0.8);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(229, 168, 27, 0.6);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(255, 224, 138, 0.45);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
