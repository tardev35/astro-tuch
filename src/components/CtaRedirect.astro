---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// หมูบิน168 (รอบชมพูบานเย็นนำ ขาวมุกรอง บน **ธีมสว่าง**): หน้าจอคั่นตอนกดปุ่มไป
// ลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render ตัวนี้
// ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก .claude/brand-spec-moobin168.md §2 (โซน "โครม")
// ⚠️⚠️ **รอบนี้พื้นเพจเป็นชมพูพาสเทลสว่าง #ffe5ff (จาก bg.json ซึ่งรอบก่อนเป็น
// 140000 = ดำอมแดง → ธีมทั้งเว็บกลับทิศจากมืดเป็นสว่าง)** แต่ overlay ตัวนี้เป็น
// **โครม จึงยังเป็นผิวมืดเหมือนทุกรอบ** — มันต้องกลบหน้าข้างหลังได้สนิท ซึ่งเป็น
// เหตุผลเดียวกันทุกรอบ **ห้าม "แก้" ให้สว่างตามพื้นเพจ**
// backdrop เป็นชั้นพลัมจม rgba(59,11,38) ออร่าบนเป็น **ชมพูแกนแบรนด์**
// rgba(250,83,156) คู่กับ **พีชนวล** rgba(253,198,195) ด้านล่าง
// — ฮิวนำอยู่บน แผงการ์ดเป็นผิวยก rgba(84,18,58) = #54123a
// ⚠️ แผงการ์ดต้องสว่างกว่า backdrop เสมอ (#54123a ยก vs #3b0b26 จมของ backdrop)
// ⚠️ ค่าทุกค่าในไฟล์นี้อยู่ในชุด rgba ที่ brand-spec §2 อนุญาต (250/83/156 ·
// 251/140/192 · 194/24/91 · 142/15/65 · 253/198/195 · 122/35/80 · 59/11/38)
// ออร์บไล่จากชมพูสด #fa539c เข้าหาชมพูเข้ม #c2185b แล้วจบที่ชมพูลึกสุด #8e0f41
// — การไล่ "สว่างออกเข้ม" คืออ่านจากโลโก้ตรงๆ (ตัวอักษร "หมูบิน168" เป็นผิวบับเบิล
// สามมิติมันวาว ไล่จากชมพูสว่างที่ยอดลงชมพูเข้มที่ฐาน มีไฮไลต์ขาวพาดบนผิว)
// วงแหวนคู่หมุนสวนทางกันและแยกค่ากันจริง — วงนอก **ชมพูสด #fa539c**
// วงใน **พีชนวล #fdc6c3** ซึ่งคือคู่วัสดุบนเวิร์ดมาร์กเป๊ะๆ: ตัวบับเบิลชมพู
// ที่มีไฮไลต์ขาว-พีชพาดอยู่บนตัวอักษรทุกตัว
// ⚠️⚠️ **คาร์ดิแกนชมพูของนักแสดงเป็นวัตถุในภาพ ส่วนชมพูของ UI มาจากตัวอักษรใน
// โลโก้กับหัวใจ** และ **ห้ามเอาทอง/เหลือง/แดง/ครีม/เบจ/เทาเงินกลับเข้ามา**
// (แดงเจลคือฮิวนำของ สล็อต168 รอบก่อนทันที)
// รางวงแหวนใช้เส้นคั่นจาง rgba(122,35,80,0.8) = #7a2350 (เป็นเส้น ไม่ใช่ตัวอักษร
// ค่านี้จึงใช้ได้ ทั้งที่ถือตัวอักษรไม่ได้)
// ส่วนชื่อแบรนด์ไล่ ขาวมุก #ffe9f5 -> ชมพูอ่อน #fb8cc0 (11.0 -> 6.5:1 บนแผง
// #54123a) ซึ่งอ่านเป็นเวิร์ดมาร์กจริง: ไฮไลต์ขาวที่ยอดไล่ลงเนื้อบับเบิลชมพู
// ⚠️ ปลายของ "ตัวอักษร" หยุดที่ #fb8cc0 — **ลากลงไปถึง #fa539c ไม่ได้บนแผงยกนี้**
// เพราะชมพูสดได้แค่ 4.0:1 บน #54123a ซึ่งคาบเส้นเกินไปสำหรับตัวอักษร
// letter-spacing กว้างขนาดนี้ และ #c2185b ยิ่งไม่ได้ (2.9:1)
// ⚠️⚠️ **ไฟล์นี้เพิ่งเป็นแดงเจลนำ-มุกอุ่นของ สล็อต168 เมื่อรอบที่แล้วเป๊ะๆ**
// (fb2e33 cb0b0d d81115 b00d11 8a0608 f0e6e4 c9b9b7 e3d6d4 1c0607 0b0000 2a0c0d
// 551c1e — **ชุดที่เสี่ยงหลงเหลือที่สุด**) ก่อนหน้านั้นเป็นทองนำ-โครเมียมเงินของ
// รวย168 (ffd94a e3a712 9d6f06 e8eaee b4b9c2 6b7079 070707 121110 1c1a16 f3ece0)
// ก่อนหน้านั้นเป็นแดงคริมสัน-น้ำเงินอะซัวร์ของ มาดาม168 (ff2e52 e01238 c9102f
// 1177e8 0e68cc 0a4ea8 00091f 0b1733 16234a f4eef1) ฟ้าไซยาน-น้ำเงินอุลตรามารีน
// ของ นาซ่า168 (1fd8f0 0bb6d4 1d4fd8 143aa0 e6edf8 0d1017) ฟ้าไซยาน-ครีมอุ่นของ
// ร่ำรวย168 (18a5e2 0d6b9b a9d7f2 f4e4d3 e4cbb3 111a3f) ทองแกน-ครีมอุ่นของ
// เงินทอง168 (f5ba14 fcee52 b37c0b ecd5c4 d2b9a4 1b1407) ทองแกน-โครเมียมเงินของ
// พักยก168 (eeae12 fded41 9f600d e0e0df c0c0bf 1f0f04) ฟ้าสกาย-ทองคานารีของ
// สบาย168 (2cc3fc 6bdcfb 0a7fbd 063a57 fdcb0c) ทองคานารี-โครเมียมเงินของ ยูฟ้า168
// (fee45d e6a416 b8780d e8ecf1 a8b2bf 15130f) แดงเชอร์รี่-ทองแดงไหม้ของ โปรดี168
// (eb0305 9b0a0c ff4446 b44c06 f0b46a 401107) แดงคริมสัน-ทองโบราณของ รวยแท้168
// เขียวมรกต-ทองสัมฤทธิ์ของ สาธุ168 **ชมพูบานเย็นของ มีทรัพย์168** แดงชาด-
// ทองน้ำผึ้งของ ดวงเศรษฐี168 ทองอำพัน-บรอนซ์ของ ufalion168 ทองจักรพรรดิ-แดงชาด
// ของ รวยเทพ168 แดงชาด-ทองเนยของ มีเฮ168 **ทอง-ชมพูฟูเชียของ มีโชค168**
// ทอง-โรสโกลด์ของ ขวัญใจ168 ทองไทย-แดงมังกรของ รับตัง168 แดงมังกร-ทองของ สมหวัง168
// 🚨🚨 **ชมพูผ่านไฟล์นี้มาแล้วหลายเจ้า** การเจอ "ชมพู" ในไฟล์นี้จึงไม่ได้แปลว่า
// เป็นของรอบนี้ ชมพูรอบนี้คือ **#fa539c** (+#c2185b #8e0f41 #fb8cc0 #fdc6c3)
// เพื่อนบ้านที่ใกล้ที่สุดคือ **f5469f ของ มีโชค168 ห่างแค่ R5/G13/B3 และ 8c0f52
// ของ มีโชค168 ห่างจาก #8e0f41 แค่ R2/B17 — ใกล้ที่สุดในลิสต์ ถ้าเจอค่าพวกนั้น
// แปลว่าพิมพ์ผิด** · fa63b9 ของ ถอนชัวร์168 มี R ตรงกันเป๊ะ · a4186b ของ
// มีทรัพย์168 มี 18 อยู่กลางค่าเหมือน #c2185b — ให้เทียบเป็นตัวเลขกับตารางใน
// brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ
// false positive — และรอบนี้ไม่มีค่าทอง/เหลือง/แดง/ม่วง/ส้ม/เขียว/น้ำเงิน/ฟ้า/
// โรสโกลด์/น้ำตาล/ครีม/เทาเงิน เหลือในไฟล์นี้เลย
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(250,83,156, 0.22) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(253,198,195, 0.14) 0%, transparent 55%), rgba(59,11,38, 0.97);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(194,24,91, 0.75);
    border-radius: 1.5rem;
    background: rgba(84,18,58, 0.96);
    box-shadow:
      0 1rem 3rem rgba(59, 11, 38, 0.7),
      0 0 2rem rgba(250,83,156, 0.28);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #ffe9f5 0%, #fb8cc0 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #fa539c 0%, #c2185b 55%, #8e0f41 100%);
    box-shadow: 0 0 2rem rgba(250,83,156, 0.5);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(122,35,80, 0.8);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #fa539c;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #fdc6c3;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #ffe9f5;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: #fdc6c3;
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(250,83,156, 0.5);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(253,198,195, 0.4);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
