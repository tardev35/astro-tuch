---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// มีเฮ168 (รอบแดงชาดนำ-ทองเนยรอง บนดำสนิท 2026-10-19): หน้าจอคั่นตอนกด
// ปุ่มไปลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render
// ตัวนี้ ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก .claude/brand-spec-meehay168.md §2: backdrop เป็นแดงหมึกจม
// rgba(12,2,5) = #0c0205 (พื้นเพจรอบนี้เป็น **ดำสนิท #000000** backdrop จึงไม่
// จมกว่าพื้นได้แล้ว แต่ยังอ่านออกว่าเป็นชั้นทับเพราะมีออร่าสองวงและแผงการ์ดสว่าง
// กว่าอย่างชัดเจน) ออร่าบนเป็น **แดงแบรนด์** rgba(251,27,50) คู่กับ
// **ทองเนย** rgba(252,212,92) ด้านล่าง — ฮิวนำอยู่บน ฮิวที่สองอยู่ล่าง
// แผงการ์ดเป็นผิวยก rgba(43,7,17) = #2b0711
// ⚠️ แผงการ์ดต้องสว่างกว่า backdrop เสมอ
// ออร์บไล่จากชมพูบลัช #ff8f9c เข้าหาแดงแบรนด์ #fb1b32 แล้วจบที่ทองเนย
// #fcd45c — การไล่ "แดงออกทอง" คืออ่านจากตัวอักษรบนโลโก้ตรงๆ (คำว่า เฮ168 เป็น
// แดงชาดบับเบิลผิวมันวาว ส่วนหน้ายิ้มกับกองเหรียญที่อยู่ข้างๆ เป็นเหลืองทอง)
// วงแหวนคู่หมุนสวนทางกันและแยก "โทน" กันจริง — วงนอก **แดงแบรนด์ #fb1b32**
// วงใน **ทองเนย #fcd45c**
// รางวงแหวนใช้เส้นคั่นจาง rgba(92,4,16,0.8) = #5c0410 แดงลึก (เป็นเส้น
// ไม่ใช่ตัวอักษร) ส่วนชื่อแบรนด์ไล่ ชมพูบลัช #ff8f9c -> แดงแบรนด์ #fb1b32 ->
// ทองเนย #fcd45c
// ⚠️ ปลายเข้มของ "ตัวอักษร" หยุดที่ #fb1b32 ไม่ใช่ #5c0410 หรือ #6b4a08 —
// #5c0410 บนแผง #2b0711 ได้ ~1.4:1 และ #6b4a08 ได้ ~1.8:1 ตก AA ทั้งคู่
// ส่วน #fb1b32 ได้ ~4.7:1
// (brand-spec §2: #5c0410 / #6b4a08 ห้ามถือตัวอักษรทุกขนาด)
// ⚠️ **ไฟล์นี้เพิ่งเป็นฟ้าอะซัวร์-ทองอำพันของ รวยแทร่168 เมื่อรอบที่แล้วเป๊ะๆ**
// ก่อนหน้านั้นเป็นฟ้า-เหลืองของ นินจา168 ฟ้า-ทองของ สบายเบท168 ชมพูบับเบิลกัมนำ-
// ทองเนยรองของ ถอนชัวร์168 ทองนำ-ชมพูบานเย็นของ มีโชค168 ทอง-โรสโกลด์ของ
// ขวัญใจ168 ทองไทย-แดงมังกรของ รับตัง168 แดงมังกร-ทองของ สมหวัง168 แดงมังกร-
// โครเมียมขาวของ GT66B แดงเลือดนก-เงินของ TKB55 **น้ำเงิน-เงินของ TSDET911**
// ม่วง-ทองของ KMD88 และทองล้วนของ TND168 — **เกือบทุกแบรนด์ที่ผ่านไฟล์นี้มีทอง
// และมีสี่แบรนด์ที่แดงนำเหมือนรอบนี้**
// การเจอ "ทอง" หรือ "แดง" ในไฟล์นี้จึงไม่ได้แปลว่าเป็นของรอบนี้แน่ๆ
// แดงรอบนี้คือ #fb1b32 (+#ff8f9c +#5c0410) และทองรอบนี้คือ #fcd45c (+#6b4a08)
// ⚠️ fa0513 ของ สมหวัง168 fb131b ของ TKB55 และ fb141b ของ GT66B อยู่ห่างจาก
// fb1b32 แค่นิดเดียว ให้เทียบเป็นตัวเลขกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำ
// ที่นี่เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive — และรอบนี้ไม่มีค่า
// ฟ้า/น้ำเงิน/ม่วง/เขียว/ส้ม/เงินโครเมียม/โรสโกลด์/เหลืองมะนาว/ชมพูฟูเชีย
// เหลือในไฟล์นี้เลย
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(251,27,50, 0.28) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(252,212,92, 0.22) 0%, transparent 55%), rgba(12,2,5, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(251,27,50, 0.65);
    border-radius: 1.5rem;
    background: rgba(43,7,17, 0.94);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.7),
      0 0 2rem rgba(251,27,50, 0.38);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #ff8f9c 0%, #fb1b32 50%, #fcd45c 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #ff8f9c 0%, #fb1b32 55%, #fcd45c 100%);
    box-shadow: 0 0 2rem rgba(251,27,50, 0.6);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(92,4,16, 0.8);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #fb1b32;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #fcd45c;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #fdeaec;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(253,234,236, 0.8);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(251,27,50, 0.6);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(252,212,92, 0.5);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
