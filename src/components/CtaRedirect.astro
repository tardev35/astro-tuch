---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// TIGERWIN369 (รอบทองอำพันเสือบนดำสนิท 2026-10-11): หน้าจอคั่นตอนกดปุ่มไป
// ลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render ตัวนี้
// ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก brand-spec §2: backdrop เป็นดำสนิท rgba(0,0,0) = พื้นเพจรอบนี้
// (bg.json = #000000) ออร่าบนเป็นทองอำพัน rgba(217,131,36) คู่กับทองสว่าง
// rgba(247,183,51) ด้านล่าง แผงการ์ดเป็นผิวกลาง rgba(28,18,6) = #1c1206
// ⚠️ รอบนี้พื้นเพจเป็นดำสนิท แผงการ์ดจึงต้องสว่างกว่า backdrop เสมอ
// ออร์บไล่จากทองซีด #ffd98a เข้าหาทองอำพัน #d98324 แล้วจบที่อำพันลึก #8a5214
// (ออร์บเป็นรูปทรง ไม่ใช่ตัวอักษร #8a5214 จึงใช้ได้ตรงนี้)
// วงแหวนคู่หมุนสวนทางกันและแยก "ค่า" กันจริง — วงนอกทองอำพัน #d98324 วงในทองสว่าง
// #f7b733 เพราะโลโก้รอบนี้เป็น **ทองล้วนสองระดับ ไม่มีเงิน ไม่มีเทา ไม่มีฮิวเย็นเลย**
// (หัวเสือขนอำพันสวมมงกุฎทองบนเหรียญตราดำ-ทอง เหนือตัวอักษร TIGERWIN369 ทองสามมิติ)
// รางวงแหวนใช้เส้นคั่นจาง rgba(74,42,8) = #4a2a08 อำพันลึกสุด (เป็นเส้น ไม่ใช่ตัวอักษร)
// ส่วนชื่อแบรนด์ไล่ ทองซีด #ffd98a -> ทองสว่าง #f7b733 -> ทองอำพัน #d98324
// ⚠️ ปลายเข้มของ "ตัวอักษร" หยุดที่ #d98324 ไม่ใช่ #8a5214 — #8a5214 บนแผง #1c1206
// ตกเกณฑ์แม้แต่ตัวอักษรใหญ่ ส่วน #d98324 ผ่านเกณฑ์ตัวใหญ่บนแผงนี้
// (brand-spec §2: #8a5214 / #4a2a08 ห้ามถือตัวอักษรทุกขนาด)
// ⚠️ รอบนี้เป็นทองรอบที่แปดในสิบรอบ และแบรนด์ก่อนก็เป็นคู่ทอง-โลหะเย็นเหมือนที่เคย
// อยู่ในไฟล์นี้ การเจอทองจึง **ไม่ได้แปลว่าเป็นของรอบนี้** ให้เทียบเป็น
// ตัวเลขกับตารางแบนใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ grep หาสีของ
// แบรนด์เก่าเจอ false positive — ทองอำพันรอบนี้ #d98324 ส้มกว่าทุกตัวในลิสต์ (G=131)
// และรอบนี้ไม่มีค่าเงิน/เทาเหลืออยู่ในไฟล์นี้เลย
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(217, 131, 36, 0.26) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(247, 183, 51, 0.18) 0%, transparent 55%), rgba(0, 0, 0, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(217, 131, 36, 0.6);
    border-radius: 1.5rem;
    background: rgba(28, 18, 6, 0.94);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.7),
      0 0 2rem rgba(217, 131, 36, 0.32);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #ffd98a 0%, #f7b733 50%, #d98324 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #ffd98a 0%, #d98324 55%, #8a5214 100%);
    box-shadow: 0 0 2rem rgba(217, 131, 36, 0.6);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(74, 42, 8, 0.8);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #d98324;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #f7b733;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #f7e4c0;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(247, 228, 192, 0.8);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(217, 131, 36, 0.6);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(255, 217, 138, 0.45);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
