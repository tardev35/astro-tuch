---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// รวยเทพ168 (รอบทองจักรพรรดินำ-แดงชาดรอง บนดำสนิท 2026-10-20): หน้าจอคั่นตอนกด
// ปุ่มไปลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render
// ตัวนี้ ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก .claude/brand-spec-ruaythep168.md §2: backdrop เป็นน้ำตาลไหม้จม
// rgba(13,5,1) = #0d0501 (พื้นเพจรอบนี้เป็น **ดำสนิท #000000** backdrop จึงไม่
// จมกว่าพื้นได้มาก แต่ยังอ่านออกว่าเป็นชั้นทับเพราะมีออร่าสองวงและแผงการ์ดสว่าง
// กว่าอย่างชัดเจน) ออร่าบนเป็น **ทองแบรนด์** rgba(240,187,78) คู่กับ
// **แดงชาด** rgba(228,2,27) ด้านล่าง — ฮิวนำอยู่บน ฮิวที่สองอยู่ล่าง
// แผงการ์ดเป็นผิวยก rgba(59,27,14) = #3b1b0e
// ⚠️ แผงการ์ดต้องสว่างกว่า backdrop เสมอ
// ออร์บไล่จากครีมทอง #ffeccb เข้าหาทองแบรนด์ #f0bb4e แล้วจบที่ทองแดง #d9701a —
// การไล่ "ครีมออกทองแดง" คืออ่านจากตัวอักษรบนโลโก้ตรงๆ (คำว่า รวย เป็นทองไล่เฉด
// ที่สว่างด้านบนและเข้มลงเป็นทองแดงที่ขอบล่าง)
// วงแหวนคู่หมุนสวนทางกันและแยก "โทน" กันจริง — วงนอก **ทองแบรนด์ #f0bb4e**
// วงใน **แดงชาด #e4021b** (วงแหวนเป็นเส้นตกแต่ง ไม่ใช่ตัวอักษร แดงจึงใช้ได้)
// รางวงแหวนใช้เส้นคั่นจาง rgba(92,42,6,0.8) = #5c2a06 บรอนซ์ลึก (เป็นเส้น
// ไม่ใช่ตัวอักษร) ส่วนชื่อแบรนด์ไล่ ครีมทอง #ffeccb -> ทองแบรนด์ #f0bb4e ->
// ทองแดง #d9701a
// ⚠️ ปลายเข้มของ "ตัวอักษร" หยุดที่ #d9701a (4.7:1 บนแผง) ไม่ใช่ #5c2a06 ซึ่งได้
// ~1.5:1 และ **ไม่ใช่ #e4021b ซึ่งได้ ~3.2:1 = ตก AA** — แดงรอบนี้จึงไม่เคยถือ
// ตัวอักษรในไฟล์นี้เลย อยู่แค่ในออร่ากับวงแหวน
// (brand-spec §2: #5c2a06 ห้ามถือตัวอักษรทุกขนาด · #e4021b เป็นพื้นถม/ขอบเท่านั้น)
// ⚠️ **ไฟล์นี้เพิ่งเป็นแดงชาด-ทองเนยของ มีเฮ168 เมื่อรอบที่แล้วเป๊ะๆ** ก่อนหน้านั้น
// เป็นฟ้าอะซัวร์-ทองอำพันของ รวยแทร่168 ฟ้า-เหลืองของ นินจา168 ฟ้า-ทองของ
// สบายเบท168 ชมพูบับเบิลกัมนำ-ทองเนยรองของ ถอนชัวร์168 ทองนำ-ชมพูบานเย็นของ
// มีโชค168 ทอง-โรสโกลด์ของ ขวัญใจ168 ทองไทย-แดงมังกรของ รับตัง168 แดงมังกร-ทอง
// ของ สมหวัง168 แดงมังกร-โครเมียมขาวของ GT66B แดงเลือดนก-เงินของ TKB55
// **น้ำเงิน-เงินของ TSDET911** ม่วง-ทองของ KMD88 และทองล้วนของ TND168 —
// **เกือบทุกแบรนด์ที่ผ่านไฟล์นี้มีทอง และมีห้าแบรนด์ที่แดงนำ**
// การเจอ "ทอง" หรือ "แดง" ในไฟล์นี้จึงไม่ได้แปลว่าเป็นของรอบนี้แน่ๆ
// ทองรอบนี้คือ #f0bb4e (+#ffeccb +#d9701a +#5c2a06) และแดงรอบนี้คือ #e4021b
// ⚠️ f0b429 ของ รับตัง168 มี R เท่ากับ f0bb4e เป๊ะ (ต่างที่ B41 vs B78) และ
// fcd45c ของ มีเฮ168 รอบที่แล้วก็เป็นทองเหมือนกัน ให้เทียบเป็นตัวเลขกับตารางใน
// brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false
// positive — และรอบนี้ไม่มีค่าฟ้า/น้ำเงิน/ม่วง/เขียว/เงินโครเมียม/โรสโกลด์/
// เหลืองมะนาว/ชมพูฟูเชีย เหลือในไฟล์นี้เลย
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(240,187,78, 0.28) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(228,2,27, 0.22) 0%, transparent 55%), rgba(13,5,1, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(240,187,78, 0.65);
    border-radius: 1.5rem;
    background: rgba(59,27,14, 0.94);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.7),
      0 0 2rem rgba(240,187,78, 0.38);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #ffeccb 0%, #f0bb4e 50%, #d9701a 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #ffeccb 0%, #f0bb4e 55%, #d9701a 100%);
    box-shadow: 0 0 2rem rgba(240,187,78, 0.6);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(92,42,6, 0.8);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #f0bb4e;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #e4021b;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #fff8ec;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(255,248,236, 0.8);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(240,187,78, 0.6);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(228,2,27, 0.5);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
