---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// สบาย168 (รอบฟ้าสกายนำ ทองคานารีรอง บนธีมสว่าง 2026-10-22): หน้าจอคั่นตอนกดปุ่ม
// ไปลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render ตัวนี้
// ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก .claude/brand-spec-sabai168.md §2 (โซน "โครม")
// ⚠️⚠️ **รอบนี้พื้นเพจกลับมาเป็นฟ้าพาสเทลสว่าง #ccf7ff (จาก bg.json)** แต่ overlay
// ตัวนี้เป็น **โครม จึงยังเป็นน้ำเงินมหาสมุทรลึก** — มันต้องกลบหน้าข้างหลังได้สนิท
// ซึ่งเป็นเหตุผลเดียวกันทุกรอบ ไม่ว่าพื้นเพจจะสว่างหรือมืด **ห้าม "แก้" ให้สว่าง
// ตามพื้นเพจ** เพราะ overlay สว่างบนหน้าสว่างคือ overlay ที่มองไม่ออกว่าเปิดอยู่
// backdrop เป็นชั้นจม rgba(4,41,61) = #04293d ออร่าบนเป็น **ฟ้าสกายแบรนด์**
// rgba(44,195,252) คู่กับ **ทองคานารี** rgba(253,203,12) ด้านล่าง
// — ฮิวนำอยู่บน แผงการ์ดเป็นผิวยก rgba(6,58,87) = #063a57
// ⚠️ แผงการ์ดต้องสว่างกว่า backdrop เสมอ (#063a57 ยก vs #04293d จม)
// ⚠️ ค่าทุกค่าในไฟล์นี้อยู่ในชุด rgba ที่ brand-spec §2 อนุญาต (44/195/252 ·
// 253/203/12 · 107/220/251 · 6/58/87 · 0/0/0) โดยตั้งใจ
// ออร์บไล่จากฟ้าขาว #eafaff เข้าหาฟ้าสกาย #2cc3fc แล้วจบที่ฟ้าลึก #0a7fbd
// — การไล่ "อ่อนออกเข้ม" คืออ่านจากโลโก้ตรงๆ (เลข 168 เป็นตัวอักษรสามมิติผิวมันวาว
// ไล่เฉดฟ้า มีไฮไลต์ขาวที่ยอดและเงาฟ้าลึกที่ฐาน)
// วงแหวนคู่หมุนสวนทางกันและแยกค่ากันจริง — วงนอก **ฟ้าสกาย #2cc3fc**
// วงใน **ทองคานารี #fdcb0c** ซึ่งคือสองวัสดุของโลโก้ (คำว่า สบาย ทอง + เลข 168 ฟ้า)
// รางวงแหวนใช้เส้นคั่นจาง rgba(10,79,116,0.8) = #0a4f74 (เป็นเส้น ไม่ใช่ตัวอักษร
// ค่านี้จึงใช้ได้ ทั้งที่ถือตัวอักษรไม่ได้บนพื้นสว่าง)
// ส่วนชื่อแบรนด์ไล่ ขาว #ffffff -> ทองคานารี #fdcb0c (7.8:1 บนแผง #063a57)
// ⚠️ ปลายของ "ตัวอักษร" หยุดที่ #fdcb0c — **ลากลงไปถึง #8a6504 ไม่ได้บนแผงเข้มนี้**
// เพราะทองลึกเป็นค่าที่ออกแบบมาสำหรับพื้น "สว่าง" (5.0:1 บนขาว) บนแผง #063a57
// มันจะมืดเกินไป
// ⚠️ **ไฟล์นี้เพิ่งเป็นทองคานารี-โครเมียมเงินของ ยูฟ้า168 เมื่อรอบที่แล้วเป๊ะๆ**
// (fee45d e6a416 b8780d 7a4e05 e8ecf1 a8b2bf 78828f 5a6472 15130f 1e1a13 0a0908
// eae3d4 fff8dd — ชุดที่เสี่ยงหลงเหลือที่สุด) ก่อนหน้านั้นเป็นแดงเชอร์รี่-ทองแดงไหม้
// ของ โปรดี168 (eb0305 9b0a0c ff4446 b44c06 f0b46a 401107 fff4ea fff0e4)
// แดงคริมสัน-ทองโบราณของ รวยแท้168 เขียวมรกต-ทองสัมฤทธิ์ของ สาธุ168
// ชมพูบานเย็นของ มีทรัพย์168 แดงชาด-ทองน้ำผึ้งของ ดวงเศรษฐี168 ทองอำพัน-บรอนซ์ของ
// ufalion168 ทองจักรพรรดิ-แดงชาดของ รวยเทพ168 แดงชาด-ทองเนยของ มีเฮ168
// ทอง-โรสโกลด์ของ ขวัญใจ168 ทองไทย-แดงมังกรของ รับตัง168 แดงมังกร-ทองของ สมหวัง168
// ⚠️⚠️ **สามเจ้าที่เคยเดินฟ้า+ทองเหมือนรอบนี้เป๊ะในเชิงตระกูลสี และต้องเทียบเป็น
// ค่าทีละตัว**: ฟ้า-ทองของ **สบายเบท168** (2f9ff5 a8dcff d6ecff 0b3f78 ffc82e
// — **ชื่อใกล้ที่สุดในรีโปนี้**) · ฟ้า-เหลืองของ **นินจา168** (32bcfb a9e9ff fef54b
// 07335f) · ฟ้าอะซัวร์-ทองอำพันของ **รวยแทร่168** (039cfa 0494f5 c3ebfc 04366b f9a826)
// — **ฟ้าและทองเคยผ่านไฟล์นี้มาหลายเจ้า** การเจอ "ฟ้า" หรือ "ทอง" ในไฟล์นี้จึงไม่ได้
// แปลว่าเป็นของรอบนี้ ฟ้ารอบนี้คือ **#2cc3fc** (+#6bdcfb #0a7fbd) และทองรอบนี้คือ
// **#fdcb0c** (+#fefb6b) ให้เทียบเป็นตัวเลขกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำ
// ที่นี่เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive — และรอบนี้ไม่มีค่า
// แดง/เขียว/ชมพู/ม่วง/โรสโกลด์/ส้มสด/ทองแดงไหม้/เงิน-โครเมียม เหลือในไฟล์นี้เลย
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(44,195,252, 0.22) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(253,203,12, 0.14) 0%, transparent 55%), rgba(4,41,61, 0.97);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(253,203,12, 0.65);
    border-radius: 1.5rem;
    background: rgba(6,58,87, 0.96);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.7),
      0 0 2rem rgba(44,195,252, 0.28);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #ffffff 0%, #fdcb0c 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #eafaff 0%, #2cc3fc 55%, #0a7fbd 100%);
    box-shadow: 0 0 2rem rgba(44,195,252, 0.5);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(10,79,116, 0.8);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #2cc3fc;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #fdcb0c;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #ffffff;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: #eafaff;
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(44,195,252, 0.5);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(253,203,12, 0.45);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
