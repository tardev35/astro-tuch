---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// ZANE96 (รอบไวโอเลตนีออนนำ ฟ้าอิเล็กทริกรอง · **เนื้อหาสว่าง โครมเข้ม**): หน้าจอ
// คั่นตอนกดปุ่มไปลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ
// render ตัวนี้ ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก .claude/brand-spec-zane96.md §2
// ⚠️⚠️⚠️ **overlay เป็นผิว "เข้ม" เหมือนโครมที่เหลือของรอบนี้**
// โครมทั้งชุด (navbar/footer/ticker/แถบล่างมือถือ) เป็นอินดิโกม่วงจม จอคั่นจึงต้อง
// เป็นชุดเดียวกัน ไม่ใช่หน้าจอเดียวในเว็บที่สว่าง
// สิ่งที่ทำให้กลบหน้าข้างหลังได้สนิทคือ **ค่า alpha (0.97)** ไม่ใช่ความมืดหรือความสว่าง
// backdrop เป็นชั้นอินดิโกลึก rgba(16,6,38) = #100626 ออร่าบนเป็น **ไวโอเลตแกน
// แบรนด์** rgba(122,27,214) คู่กับ **แมเจนต้านีออน** rgba(242,59,180) ด้านล่าง
// — ฮิวนำอยู่บน แผงการ์ดเป็นผิวโครมกลาง rgba(39,18,87) = #271257
// ⚠️ แผงการ์ดต้อง **ต่างค่า** จาก backdrop เสมอ (รอบนี้ #271257 vs #100626
// ของ backdrop — แผง "สว่างกว่า" พื้น)
// ⚠️ ค่าทุกค่าในไฟล์นี้อยู่ในชุด rgba ที่ brand-spec §2 อนุญาต (122/27/214 ·
// 84/17/196 · 194/23/139 · 242/59/180 · 187/109/255 · 91/47/158 · 36/16/70 ·
// 25/11/61 · 16/6/38 · 39/18/87)
// ออร์บไล่จากไวโอเลตอ่อน #bb6dff เข้าหาไวโอเลตแกน #7a1bd6 แล้วจบที่ม่วงลึกสุด
// #2b0a63 — การไล่ "สว่างออกเข้ม" คืออ่านจากโลโก้ตรงๆ (เวิร์ดมาร์กเป็นผิวโครเมียม
// สามมิติที่มีไฮไลต์สว่างพาดอยู่ด้านบนและเข้มลงที่ฐาน ตัดขอบขาวหนา)
// วงแหวนคู่หมุนสวนทางกันและแยกค่ากันจริง — วงนอก **ไวโอเลตแกน #7a1bd6**
// วงใน **ไวโอเลตอ่อน #bb6dff** ซึ่งคือคู่วัสดุบนอาร์ตเวิร์ก: ตู้สล็อตผิวแก้วม่วง
// กับประกายดาวสี่แฉกสีอ่อน
// ⚠️⚠️ **ชุดเมทัลลิกโฮโลแกรม ไม้เชอร์รี่ และสีผิวนักแสดงในอาร์ตเวิร์กเป็นวัตถุใน
// ภาพ ส่วนม่วงของ UI มาจากเวิร์ดมาร์ก ตู้สล็อต และเพชร** และ **ห้ามเอาแดง/ทอง/
// ครีม/เทาเงินกลับเข้ามา** (แดงกับทองคือฮิวนำของ MEXICANOSLOT รอบก่อนทันที)
// 🚨🚨 **ไล่เฉดบนเวิร์ดมาร์กคร่อมฟ้า ม่วง และแมเจนต้า ซึ่งเป็นฮิวนำของแบรนด์ก่อนๆ
// สามเจ้าพร้อมกัน** (โบ๊ะบ๊ะ168 / KMD88 / okkub88) — สีในรูปเป็นอาร์ตเวิร์ก
// ค่า UI ต้องมาจากตาราง brand-spec §2 เท่านั้น
// รางวงแหวนใช้เส้นคั่นจาง rgba(91,47,158,0.9) = #5b2f9e (เป็นเส้น ไม่ใช่ตัวอักษร
// ค่านี้จึงใช้ได้ ทั้งที่ถือตัวอักษรไม่ได้)
// ส่วนชื่อแบรนด์ไล่ ขาวอมม่วง #f3e8ff -> ไวโอเลตอ่อน #bb6dff (13.6 -> 5.0:1
// บนแผง #271257) ซึ่งอ่านเป็นเวิร์ดมาร์กจริง: ตัวอักษรโครเมียมที่มีไฮไลต์สว่าง
// พาดอยู่ด้านบน
// ⚠️⚠️ **ปลายของ "ตัวอักษร" ห้ามลากลงไปถึง #7a1bd6 บนแผงเข้มนี้** เพราะไวโอเลตแกน
// ได้แค่ 1.9:1 บน #271257 ซึ่งไม่ผ่านสำหรับตัวอักษร
// ⚠️⚠️ **ไฟล์นี้เพิ่งเป็นแดงเม็กซิกันนำ-ทองรองของ MEXICANOSLOT เมื่อรอบที่แล้วเป๊ะๆ**
// (de2b1e f2543f c81e12 9d140c 6f0e08 a81410 f2a033 2b100a 431a10 1d0a06 8c3a22
// fdeee2 e8c6ae — **ชุดที่เสี่ยงหลงเหลือที่สุด**) ก่อนหน้านั้นเป็น
// **ชมพูบับเบิลกัมนำ-ขาวของ okkub88** (ffd6fa fff4fb ffe3f5 f9b2d9 f479b9 6a0f3c
// 95486b 9c0f55 fb439b fc74b5 ffc2e2 d91a73 b01160 85094a) และก่อนนั้นเป็น
// **ฟ้าสกายนำ-ขาวอมฟ้าของ โบ๊ะบ๊ะ168** (00bfff 12b4ef b6e3f0 06283f 0b4a73 2a87c4
// eaf7ff 0f5684 1a6ea8) และก่อนนั้นเป็น **ชมพูบานเย็นนำของ หมูบิน168**
// (fa539c c2185b 8e0f41 fb8cc0 fdc6c3 3b0b26 54123a 7a2350 ffe9f5)
// ก่อนหน้านั้นเป็นแดงเจลนำ-มุกอุ่นของ สล็อต168 (fb2e33 cb0b0d d81115 b00d11 8a0608
// f0e6e4 c9b9b7 1c0607 0b0000 551c1e) ทองนำ-โครเมียมเงินของ รวย168 (ffd94a e3a712
// 9d6f06 e8eaee b4b9c2 070707 1c1a16) แดงคริมสัน-น้ำเงินอะซัวร์ของ มาดาม168
// (ff2e52 e01238 c9102f 1177e8 0e68cc 0a4ea8 00091f 0b1733 16234a f4eef1)
// ฟ้าไซยาน-น้ำเงินอุลตรามารีนของ นาซ่า168 (1fd8f0 0bb6d4 1d4fd8 143aa0 e6edf8
// 0d1017) ฟ้าไซยาน-ครีมอุ่นของ ร่ำรวย168 (18a5e2 0d6b9b a9d7f2 f4e4d3 e4cbb3
// 111a3f) ทองแกน-ครีมอุ่นของ เงินทอง168 (f5ba14 fcee52 b37c0b ecd5c4 d2b9a4 1b1407)
// ทองแกน-โครเมียมเงินของ พักยก168 (eeae12 fded41 9f600d e0e0df c0c0bf 1f0f04)
// ฟ้าสกาย-ทองคานารีของ สบาย168 (2cc3fc 6bdcfb 0a7fbd 063a57 fdcb0c) ทองคานารี-
// โครเมียมเงินของ ยูฟ้า168 (fee45d e6a416 b8780d e8ecf1 a8b2bf 15130f) แดงเชอร์รี่-
// ทองแดงไหม้ของ โปรดี168 แดงคริมสัน-ทองโบราณของ รวยแท้168 เขียวมรกต-ทองสัมฤทธิ์
// ของ สาธุ168 ชมพูบานเย็นของ มีทรัพย์168 ชมพูบับเบิลกัม-ทองเนยของ ถอนชัวร์168
// ทอง-ชมพูฟูเชียของ มีโชค168 **ม่วงนีออนของ WEPLAY168 และ KMD88**
// 🚨🚨 **ม่วง ชมพู และฟ้า ผ่านไฟล์นี้มาแล้วรวมกันเจ็ดเจ้า** การเจอสามสีนั้นในไฟล์นี้
// จึงไม่ได้แปลว่าเป็นของรอบนี้ ม่วงรอบนี้คือ **#7a1bd6** (+#5411c4 #bb6dff #2b0a63)
// คู่กับแมเจนต้า **#c2178b / #f23bb4** และผิวโครม **#190b3d #271257 #100626
// #5b2f9e #f3e8ff #c0a6e8** เพื่อนบ้านที่ใกล้ที่สุดคือ **7505cc ของ KMD88 ซึ่งห่าง
// จาก #7a1bd6 แค่ R5/G22/B10 และ b453ff ห่างจาก #bb6dff แค่ R7/G26 — ใกล้ที่สุด
// ในลิสต์ ถ้าเจอค่าพวกนั้นแปลว่าพิมพ์ผิด** · d91a73 ของ okkub88 ก็ต่างจาก #c2178b
// ไม่มาก และ 60a5fa (default cyber) ต่างจาก #7aa7ff ไม่มาก — ให้เทียบเป็นตัวเลข
// กับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่เพื่อไม่ให้ grep หาสีของแบรนด์เก่า
// เจอ false positive — และรอบนี้ไม่มีค่าแดง/ทอง/เหลือง/ส้ม/ครีม/เขียว/เทาเงิน
// เหลือในไฟล์นี้เลย
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(122,27,214, 0.22) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(242,59,180, 0.25) 0%, transparent 55%), rgba(16,6,38, 0.97);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(122,27,214, 0.75);
    border-radius: 1.5rem;
    background: rgba(39,18,87, 0.98);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.45),
      0 0 2rem rgba(122,27,214, 0.28);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #f3e8ff 0%, #bb6dff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #bb6dff 0%, #7a1bd6 55%, #2b0a63 100%);
    box-shadow: 0 0 2rem rgba(122,27,214, 0.5);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(91,47,158, 0.9);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #7a1bd6;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #bb6dff;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #f3e8ff;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: #c0a6e8;
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(122,27,214, 0.5);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(242,59,180, 0.55);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
