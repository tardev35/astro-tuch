---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// LOTTOPLUS (รอบเขียวมรกตนำ ทองอำพัน/เงินโครเมียมรอง · **เนื้อหาสว่าง โครมเข้ม**):
// หน้าจอคั่นตอนกดปุ่มไปลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่น
// ในเว็บ render ตัวนี้ ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง
// convert พอดี สีทุกค่ามาจาก .claude/brand-spec-lottoplus.md §2
// ⚠️⚠️⚠️ **รอบนี้พื้นเพจสว่าง (bg.json = e1fef3 เขียวมินต์จาง)** แต่จอคั่นยังเป็น
// **จอเข้ม** — รอบก่อน WIN8S มืดทั้งเว็บ จอคั่นจึงเข้มทั้งสองรอบ แต่
// **ด้วยเหตุผลคนละอย่าง** รอบก่อนความเข้มคือ "สีเดียวกับหน้า"
// **รอบนี้ความเข้มคือสิ่งที่กลบหน้าสว่างข้างหลัง** → ค่า alpha (0.97) ยิ่งสำคัญขึ้น
// ไม่ใช่น้อยลง **ห้ามลดค่า alpha เด็ดขาด** ไม่งั้นหน้าขาวจะทะลุขึ้นมา
// backdrop เป็นชั้นโครมลึกสุด rgba(3,32,26) = #03201a ออร่าบนเป็น **เขียวมรกต
// แกนแบรนด์** rgba(4,108,78) คู่กับ **ทองอำพัน** rgba(226,179,42) ด้านล่าง
// — ฮิวนำอยู่บน แผงการ์ดเป็นโครมชั้นยกของรอบนี้ rgba(10,68,51) = #0a4433
// ⚠️ แผงการ์ดต้อง **ต่างค่า** จาก backdrop เสมอ (รอบนี้ #0a4433 vs #03201a
// ของ backdrop — แผง "สว่างกว่า" พื้น)
// ⚠️ ค่าทุกค่าในไฟล์นี้อยู่ในชุด rgba ที่ brand-spec §2 อนุญาต (4/108/78 ·
// 25/169/124 · 47/212/155 · 226/179/42 · 13/51/38 · 5/46/34 · 3/32/26)
// บวกผิวแผง 10/68/51
// ออร์บไล่จากทองอำพัน #e2b32a เข้าหาเขียวสด #19a97c แล้วจบที่เขียวมรกตแกน
// #046c4e — การไล่ "สว่างออกเข้ม" คืออ่านจากเวิร์ดมาร์กตรงๆ (บรรทัดบนผิวโครเมียม
// เงินสว่าง บรรทัดล่างผิวเขียวมรกตเข้มกว่า และใบโคลเวอร์สี่แฉกเขียวมรกตที่แทน
// ตัว O ตัวที่สอง)
// วงแหวนคู่หมุนสวนทางกันและแยกค่ากันจริง — วงนอก **เขียวสด #19a97c**
// วงใน **ทองอำพัน #e2b32a** ซึ่งคือคู่วัสดุบนอาร์ตเวิร์ก: แถบวงโคจรโครเมียม-เขียว
// รอบเวิร์ดมาร์ก กับแคปซูลพื้นเขียวเข้มขอบทองบนแบนเนอร์และสไลด์ทั้งสองใบ
// ⚠️⚠️ **ห้องโทนขาวงาช้าง ดอกลีลาวดีขาว สีผิวนักแสดง และฉากสว่างใน
// อาร์ตเวิร์กเป็นวัตถุในภาพ ส่วนเขียว/ทอง/เงินของ UI มาจากเวิร์ดมาร์กกับชุดไทย**
// พื้นจอคั่นมาจาก brand-spec §2 เท่านั้น **ห้ามดูดสีจากรูป**
// 🚨🚨 **ไฟล์นี้เคยเป็นทอง/แดง/ชมพู/ฟ้า/ม่วง/ส้ม/เขียวมาแล้วกว่าสิบห้าเจ้า และ
// สาธุ168 ก็เป็นแบรนด์ เขียวมรกต/ทอง ตระกูลเดียวกับรอบนี้เป๊ะ** —
// **"เจอเขียวทองเงิน" จึงไม่พิสูจน์ว่าเป็นค่าของรอบนี้** ต้องเทียบหกหลักกับตาราง
// brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่ เพื่อไม่ให้ sweep หาสีของแบรนด์เก่าเจอ
// false positive ในคอมเมนต์ของไฟล์นี้เอง
// ✅ **#00B900 ของ LINE ไม่อยู่ในไฟล์นี้ และห้ามเอามาใช้เป็นสีแบรนด์** — รอบนี้
// แบรนด์เป็นเขียวเหมือนกัน จึงเป็นรอบที่สับสนสองค่านี้ได้ง่ายที่สุด
// รางวงแหวนใช้เส้นคั่น rgba(25,169,124,0.9) = #19a97c (เป็นเส้น ไม่ใช่ตัวอักษร
// ค่านี้จึงใช้ได้ ทั้งที่ถือตัวอักษรบนการ์ดสว่างไม่ได้ — 3.0:1 บนขาว)
// ส่วนชื่อแบรนด์ไล่ มินต์ขาว #e9fbf3 -> เงินโครเมียม #c8d4d0 -> ทองอำพัน #e2b32a
// (10.6 -> 7.4 -> 5.6:1 บนแผง #0a4433) ซึ่งอ่านเป็นผิวโครเมียมขัดเงาของ
// บรรทัดบนที่ไล่จากเงินสว่างลงมาหาขอบทอง
// ⚠️⚠️ **ห้ามใช้ #19a97c หรือ #a3ddc3 เป็นสีตัวอักษรบนแผงนี้**
// ที่ถือตัวอักษรได้บนแผง #0a4433 คือ #e9fbf3 (10.6:1) · #c8d4d0 (7.4:1) ·
// #e2b32a (5.6:1)
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(4, 108, 78, 0.22) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(226, 179, 42, 0.25) 0%, transparent 55%), rgba(3, 32, 26, 0.97);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(4, 108, 78, 0.75);
    border-radius: 1.5rem;
    background: rgba(10, 68, 51, 0.98);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.45),
      0 0 2rem rgba(4, 108, 78, 0.28);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #e9fbf3 0%, #c8d4d0 55%, #e2b32a 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #e2b32a 0%, #19a97c 55%, #046c4e 100%);
    box-shadow: 0 0 2rem rgba(4, 108, 78, 0.5);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(25, 169, 124, 0.9);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #19a97c;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #e2b32a;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #e9fbf3;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: #c8d4d0;
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(4, 108, 78, 0.5);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(226, 179, 42, 0.55);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
