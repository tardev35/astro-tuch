---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// ถอนชัวร์168 (รอบชมพูบับเบิลกัมนำ-ทองเนยรอง บนดำสนิท 2026-10-18): หน้าจอคั่นตอน
// กดปุ่มไปลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render
// ตัวนี้ ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก .claude/brand-spec-tonchua168.md §2: backdrop เป็นดำจม
// rgba(13,4,10) = #0d040a (พื้นเพจรอบนี้เป็น **ดำสนิท #000000** backdrop จึงไม่
// จมกว่าพื้นได้แล้ว แต่ยังอ่านออกว่าเป็นชั้นทับเพราะมีออร่าสองวงและแผงการ์ดสว่าง
// กว่าอย่างชัดเจน) ออร่าบนเป็น **ชมพูแบรนด์** rgba(250,99,185) คู่กับ
// **ทองเนย** rgba(255,216,77) ด้านล่าง — **สลับขั้วจากรอบก่อนที่ออร่าบนเป็นทอง**
// เพราะรอบนี้ชมพูเป็นฮิวนำ แผงการ์ดเป็นผิวยก rgba(43,15,32) = #2b0f20
// ⚠️ แผงการ์ดต้องสว่างกว่า backdrop เสมอ
// ออร์บไล่จากชมพูซีด #ffd9ef เข้าหาชมพูแบรนด์ #fa63b9 แล้วจบที่ทองเนย #ffd84d —
// การไล่ "ชมพูออกทอง" คืออ่านจากตัวอักษรบนโลโก้ตรงๆ (คำว่า ชัวร์168 เป็นชมพู
// ตัดขอบทอง ส่วนคำว่า ถอน เป็นทองตัดขอบชมพู)
// วงแหวนคู่หมุนสวนทางกันและแยก "โทน" กันจริง — วงนอก **ชมพูแบรนด์ #fa63b9**
// วงใน **ทองเนย #ffd84d** ซึ่งรอบก่อนสลับกันอยู่
// รางวงแหวนใช้เส้นคั่นจาง rgba(109,11,63,0.8) = #6d0b3f พลัมเข้ม (เป็นเส้น
// ไม่ใช่ตัวอักษร) ส่วนชื่อแบรนด์ไล่ ชมพูซีด #ffd9ef -> ชมพูแบรนด์ #fa63b9 ->
// ทองเนย #ffd84d
// ⚠️ ปลายเข้มของ "ตัวอักษร" หยุดที่ #fa63b9 ไม่ใช่ #6d0b3f หรือ #6b4708 —
// #6d0b3f บนแผง #2b0f20 ได้ ~1.5:1 และ #6b4708 ได้ ~2.1:1 ตก AA ทั้งคู่
// ส่วน #fa63b9 ได้ ~6.6:1
// (brand-spec §2: #6d0b3f / #6b4708 ห้ามถือตัวอักษรทุกขนาด)
// ⚠️ ไฟล์นี้เคยเป็นทองนำ-ชมพูบานเย็นรองของ มีโชค168 ก่อนหน้านั้นเป็นทอง-โรสโกลด์
// ของ ขวัญใจ168 ทองไทย-แดงมังกรของ รับตัง168 แดงมังกร-ทองของ สมหวัง168
// แดงมังกร-โครเมียมขาวของ GT66B แดงเลือดนก-เงินของ TKB55 น้ำเงิน-เงินของ TSDET911
// ม่วง-ทองของ KMD88 และทองล้วนของ TND168 — **เกือบทุกแบรนด์ที่ผ่านไฟล์นี้มีทอง
// และรอบที่แล้วก็มีชมพูด้วย** การเจอ "ทอง" หรือ "ชมพู" ในไฟล์นี้จึงไม่ได้แปลว่า
// เป็นของรอบนี้ ชมพูรอบนี้คือ #fa63b9 และทองรอบนี้คือ #ffd84d ให้เทียบเป็นตัวเลข
// กับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่เพื่อไม่ให้ grep หาสีของแบรนด์เก่า
// เจอ false positive — และรอบนี้ไม่มีค่าม่วง/เขียว/น้ำเงิน/ฟ้า/ส้ม/เงินโครเมียม/
// โรสโกลด์/แดงชาด เหลือในไฟล์นี้เลย
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(250, 99, 185, 0.28) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(255, 216, 77, 0.22) 0%, transparent 55%), rgba(13, 4, 10, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(250, 99, 185, 0.65);
    border-radius: 1.5rem;
    background: rgba(43, 15, 32, 0.94);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.7),
      0 0 2rem rgba(250, 99, 185, 0.38);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #ffd9ef 0%, #fa63b9 50%, #ffd84d 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #ffd9ef 0%, #fa63b9 55%, #ffd84d 100%);
    box-shadow: 0 0 2rem rgba(250, 99, 185, 0.6);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(109, 11, 63, 0.8);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #fa63b9;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #ffd84d;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #fdeaf5;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(253, 234, 245, 0.8);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(250, 99, 185, 0.6);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(255, 216, 77, 0.5);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
