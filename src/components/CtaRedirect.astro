---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// LOTTO189 (รอบแดงเลือดนกนำ ทองอำพันรอง · **เนื้อหาสว่าง โครมเข้ม**): หน้าจอ
// คั่นตอนกดปุ่มไปลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ
// render ตัวนี้ ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก .claude/brand-spec-lotto189.md §2
// ⚠️⚠️⚠️ **overlay เป็นผิว "เข้ม" เหมือนโครมที่เหลือของรอบนี้**
// โครมทั้งชุด (navbar/footer/ticker/แถบล่างมือถือ) เป็นออกซ์บลัดเข้ม จอคั่นจึงต้อง
// เป็นชุดเดียวกัน ไม่ใช่หน้าจอเดียวในเว็บที่สว่าง
// สิ่งที่ทำให้กลบหน้าข้างหลังได้สนิทคือ **ค่า alpha (0.97)** ไม่ใช่ความมืดหรือความสว่าง
// backdrop เป็นชั้นออกซ์บลัดลึก rgba(18,3,7) = #120307 ออร่าบนเป็น **แดงเลือดนกแกน
// แบรนด์** rgba(176,7,24) คู่กับ **ทองอำพัน** rgba(233,181,60) ด้านล่าง
// — ฮิวนำอยู่บน แผงการ์ดเป็นผิวโครมกลาง rgba(61,13,22) = #3d0d16
// ⚠️ แผงการ์ดต้อง **ต่างค่า** จาก backdrop เสมอ (รอบนี้ #3d0d16 vs #120307
// ของ backdrop — แผง "สว่างกว่า" พื้น)
// ⚠️ ค่าทุกค่าในไฟล์นี้อยู่ในชุด rgba ที่ brand-spec §2 อนุญาต (176/7/24 ·
// 233/181/60 · 255/36/54 · 138/4/18 · 214/16/35 · 126/18/33 · 37/9/15 ·
// 36/6/12 · 18/3/7 · 61/13/22)
// ออร์บไล่จากทองอำพัน #e9b53c เข้าหาแดงสดแกน #ff2436 แล้วจบที่แดงออกซ์บลัดลึกสุด
// #7e1221 — การไล่ "สว่างออกเข้ม" คืออ่านจากโลโก้ตรงๆ (เวิร์ดมาร์กเป็นผิวโลหะ
// สามมิติที่มีแถบแสงสะท้อนสีขาวพาดกลางตัวอักษรและเข้มลงที่ฐาน ตัดขอบขาว)
// วงแหวนคู่หมุนสวนทางกันและแยกค่ากันจริง — วงนอก **แดงสดแกน #ff2436**
// วงใน **ทองอำพัน #e9b53c** ซึ่งคือคู่วัสดุบนอาร์ตเวิร์ก: ตัวเลขแดงเคลือบเงาบน
// เวิร์ดมาร์ก กับขอบทองของอาร์มแชร์ แคปซูลบนแบนเนอร์ และปากกาบนโพยหวย
// ⚠️⚠️ **ผิวเงินโครเมียม ขอบทองของเฟอร์นิเจอร์ และสีผิวนักแสดงในอาร์ตเวิร์กเป็น
// วัตถุในภาพ ส่วนแดง/ทองของ UI มาจากเวิร์ดมาร์กและขอบทองของแคปซูล** และ **ห้ามเอา
// ส้มเพลิง/ทองหลอมเหลวกลับเข้ามา** (สองสีนั้นคือฮิวนำของ ZNOVA168 รอบก่อนทันที)
// 🚨🚨 **รอบนี้เป็นแบรนด์แดง/ทอง/ครีม ซึ่งเป็นตระกูลเดียวกับ MEXICANOSLOT เมื่อสาม
// รอบก่อน และไฟล์นี้เคยเป็นทอง/แดงมาแล้วกว่าสิบเจ้า** — สีในรูปเป็นอาร์ตเวิร์ก
// ค่า UI ต้องมาจากตาราง brand-spec §2 เท่านั้น
// รางวงแหวนใช้เส้นคั่นจาง rgba(126,18,33,0.9) = #7e1221 (เป็นเส้น ไม่ใช่ตัวอักษร
// ค่านี้จึงใช้ได้ ทั้งที่ถือตัวอักษรไม่ได้)
// ส่วนชื่อแบรนด์ไล่ ชมพูขาว #ffeaea -> ทองอำพัน #e9b53c (14.4 -> 8.7:1
// บนแผง #3d0d16) ซึ่งอ่านเป็นเวิร์ดมาร์กจริง: ตัวอักษรโลหะที่มีแถบแสงสะท้อน
// สีขาวพาดกลาง
// ⚠️⚠️ **ปลายของ "ตัวอักษร" ห้ามลากลงไปถึง #ff2436 บนแผงเข้มนี้** เพราะแดงสดแกน
// ได้แค่ 4.4:1 บน #3d0d16 ซึ่งคาบเส้นเกินไปสำหรับตัวอักษรที่หมุนอยู่
// ⚠️⚠️ **ไฟล์นี้เพิ่งเป็นส้มเพลิงนำ-ทองหลอมเหลวรองของ ZNOVA168 เมื่อรอบที่แล้วเป๊ะๆ**
// (fa4903 fde90b e8a000 ff8a2b b8300a 9a2a00 d13800 c23400 1a0c04 2b1608 0e0602
// 7a3a0c fff3e0 e0b784 — **ชุดที่เสี่ยงหลงเหลือที่สุด**) ก่อนหน้านั้นเป็น
// **ไวโอเลตนีออนนำ-ฟ้า/แมเจนต้ารองของ ZANE96** (7a1bd6 2b3fd9 c2178b f23bb4 bb6dff
// 7aa7ff 5411c4 190b3d 271257 100626 5b2f9e f3e8ff c0a6e8 2b0a63) และก่อนหน้านั้นเป็น
// **แดงเม็กซิกันนำ-ทองรองของ MEXICANOSLOT** (de2b1e f2543f c81e12 9d140c 6f0e08
// a81410 f2a033 2b100a 431a10 1d0a06 8c3a22 fdeee2 e8c6ae — 🚨 **ตระกูลเดียวกับ
// รอบนี้เป๊ะ จึงต้องเทียบทีละค่า: a81410 ↔ #b00718 · c81e12 ↔ #c1071b ·
// 9d140c ↔ #8a0412 · de2b1e ↔ #d61023 · 2b100a ↔ #24060c · 1d0a06 ↔ #120307 ·
// 3f130d ↔ #25090f — เจ็ดคู่นี้ใกล้ที่สุดในลิสต์**)
// ก่อนหน้านั้นเป็น
// **ชมพูบับเบิลกัมนำ-ขาวของ okkub88** (ffd6fa fff4fb ffe3f5 f9b2d9 f479b9 6a0f3c
// 95486b 9c0f55 fb439b fc74b5 ffc2e2 d91a73 b01160 85094a) และก่อนนั้นเป็น
// **ฟ้าสกายนำ-ขาวอมฟ้าของ โบ๊ะบ๊ะ168** (00bfff 12b4ef b6e3f0 06283f 0b4a73 2a87c4
// eaf7ff 0f5684 1a6ea8) และก่อนนั้นเป็น **ชมพูบานเย็นนำของ หมูบิน168**
// (fa539c c2185b 8e0f41 fb8cc0 fdc6c3 3b0b26 54123a 7a2350 ffe9f5)
// ก่อนหน้านั้นเป็นแดงเจลนำ-มุกอุ่นของ สล็อต168 (fb2e33 cb0b0d d81115 b00d11 8a0608
// f0e6e4 c9b9b7 1c0607 0b0000 551c1e) ทองนำ-โครเมียมเงินของ รวย168 (ffd94a e3a712
// 9d6f06 e8eaee b4b9c2 070707 1c1a16) แดงคริมสัน-น้ำเงินอะซัวร์ของ มาดาม168
// (ff2e52 e01238 c9102f 1177e8 0e68cc 0a4ea8 00091f 0b1733 16234a f4eef1)
// ฟ้าไซยาน-น้ำเงินอุลตรามารีนของ นาซ่า168 (1fd8f0 0bb6d4 1d4fd8 143aa0 e6edf8
// 0d1017) ฟ้าไซยาน-ครีมอุ่นของ ร่ำรวย168 (18a5e2 0d6b9b a9d7f2 f4e4d3 e4cbb3
// 111a3f) ทองแกน-ครีมอุ่นของ เงินทอง168 (f5ba14 fcee52 b37c0b ecd5c4 d2b9a4 1b1407)
// ทองแกน-โครเมียมเงินของ พักยก168 (eeae12 fded41 9f600d e0e0df c0c0bf 1f0f04)
// ฟ้าสกาย-ทองคานารีของ สบาย168 (2cc3fc 6bdcfb 0a7fbd 063a57 fdcb0c) ทองคานารี-
// โครเมียมเงินของ ยูฟ้า168 (fee45d e6a416 b8780d e8ecf1 a8b2bf 15130f) แดงเชอร์รี่-
// ทองแดงไหม้ของ โปรดี168 แดงคริมสัน-ทองโบราณของ รวยแท้168 เขียวมรกต-ทองสัมฤทธิ์
// ของ สาธุ168 ชมพูบานเย็นของ มีทรัพย์168 ชมพูบับเบิลกัม-ทองเนยของ ถอนชัวร์168
// ทอง-ชมพูฟูเชียของ มีโชค168 **ม่วงนีออนของ WEPLAY168 และ KMD88**
// 🚨🚨 **ทอง ส้ม และแดง ผ่านไฟล์นี้มาแล้วรวมกันกว่าสิบสามเจ้า** การเจอสามสีนั้น
// ในไฟล์นี้จึงไม่ได้แปลว่าเป็นของรอบนี้ ทองรอบนี้คือ **#e9b53c** เท่านั้น
// แดงคือ **#ff2436 / #c1071b** แกนปุ่มคือ **#d61023 #b00718 #8a0412**
// และผิวโครมคือ **#24060c #3d0d16 #120307 #7e1221 #ffeaea #f0bcbc**
// เพื่อนบ้านที่ใกล้ที่สุดคือ **a81410 ของ MEXICANOSLOT ซึ่งห่างจาก #b00718 แค่
// R8/G13/B8 · c81e12 ห่างจาก #c1071b แค่ R7/G23/B7 · de2b1e ห่างจาก #d61023 แค่
// R8/G11/B13 · ff2e52 ของ มาดาม168 ห่างจาก #ff2436 แค่ G10/B2 — สี่ค่านั้นใกล้ที่สุด
// ในลิสต์ ถ้าเจอแปลว่าพิมพ์ผิด** · f5282a ของ หวย365 และ e01238 ของ มาดาม168
// ก็ต่างจากแดงของรอบนี้ไม่มาก — ให้เทียบเป็นตัวเลข
// กับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่เพื่อไม่ให้ grep หาสีของแบรนด์เก่า
// เจอ false positive — และรอบนี้ไม่มีค่าม่วง/ฟ้า/ไซแอน/ชมพู/แมเจนต้า/เขียว
// เหลือในไฟล์นี้เลย
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(176,7,24, 0.22) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(233,181,60, 0.25) 0%, transparent 55%), rgba(18,3,7, 0.97);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(176,7,24, 0.75);
    border-radius: 1.5rem;
    background: rgba(61,13,22, 0.98);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.45),
      0 0 2rem rgba(176,7,24, 0.28);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #ffeaea 0%, #e9b53c 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #e9b53c 0%, #ff2436 55%, #7e1221 100%);
    box-shadow: 0 0 2rem rgba(176,7,24, 0.5);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(126,18,33, 0.9);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #ff2436;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #e9b53c;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #ffeaea;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: #f0bcbc;
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(176,7,24, 0.5);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(233,181,60, 0.55);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
