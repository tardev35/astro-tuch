---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// ufalion168 (รอบทองอำพันนำ-ทองเลมอนเฉดสว่าง บนดำสนิท 2026-10-20): หน้าจอคั่นตอนกด
// ปุ่มไปลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render
// ตัวนี้ ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก .claude/brand-spec-ufalion168.md §2: backdrop เป็นบรอนซ์ไหม้จม
// rgba(10,6,1) = #0a0601 (พื้นเพจรอบนี้เป็น **ดำสนิท #000000** backdrop จึงไม่
// จมกว่าพื้นได้มาก แต่ยังอ่านออกว่าเป็นชั้นทับเพราะมีออร่าสองวงและแผงการ์ดสว่าง
// กว่าอย่างชัดเจน) ออร่าบนเป็น **ทองอำพันแบรนด์** rgba(212,146,44) คู่กับ
// **ทองเลมอน** rgba(253,252,113) ด้านล่าง — ฮิวนำอยู่บน เฉดสว่างอยู่ล่าง
// แผงการ์ดเป็นผิวยก rgba(51,32,10) = #33200a
// ⚠️ แผงการ์ดต้องสว่างกว่า backdrop เสมอ
// ออร์บไล่จากทองเลมอน #fdfc71 เข้าหาทองอำพัน #d4922c แล้วจบที่บรอนซ์ #a25b24 —
// การไล่ "เลมอนออกบรอนซ์" คืออ่านจากตัวอักษรบนโลโก้ตรงๆ (ชื่อแบรนด์เป็นทองไล่เฉด
// ที่สว่างด้านบนและเข้มลงเป็นบรอนซ์ที่ขอบล่าง)
// วงแหวนคู่หมุนสวนทางกันและแยก "โทน" กันจริง — วงนอก **ทองอำพัน #d4922c**
// วงใน **ทองเลมอน #fdfc71** (วงแหวนเป็นเส้นตกแต่ง ไม่ใช่ตัวอักษร)
// รางวงแหวนใช้เส้นคั่นจาง rgba(90,51,16,0.8) = #5a3310 บรอนซ์ไหม้ (เป็นเส้น
// ไม่ใช่ตัวอักษร) ส่วนชื่อแบรนด์ไล่ ทองเลมอน #fdfc71 -> ครีมทอง #f6e3b4 ->
// ทองอำพัน #d4922c
// ⚠️ ปลายเข้มของ "ตัวอักษร" หยุดที่ #d4922c (5.9:1 บนแผง) ไม่ใช่ #a25b24 ซึ่งได้
// ~3.0:1 = ตก AA และไม่ใช่ #5a3310 ซึ่งได้ ~1.6:1 — บรอนซ์รอบนี้จึงไม่เคยถือ
// ตัวอักษรในไฟล์นี้เลย อยู่แค่ในออร์บกับรางวงแหวน
// (brand-spec §2: #5a3310 ห้ามถือตัวอักษรทุกขนาด · #a25b24 เป็นพื้นถม/ขอบเท่านั้น)
// ⚠️ **ไฟล์นี้เพิ่งเป็นทองจักรพรรดิ-แดงชาดของ รวยเทพ168 เมื่อรอบที่แล้วเป๊ะๆ**
// ก่อนหน้านั้นเป็นแดงชาด-ทองเนยของ มีเฮ168 ฟ้าอะซัวร์-ทองอำพันของ รวยแทร่168
// ฟ้า-เหลืองของ นินจา168 ฟ้า-ทองของ สบายเบท168 ชมพูบับเบิลกัมนำ-ทองเนยรองของ
// ถอนชัวร์168 ทองนำ-ชมพูบานเย็นของ มีโชค168 ทอง-โรสโกลด์ของ ขวัญใจ168 ทองไทย-
// แดงมังกรของ รับตัง168 แดงมังกร-ทองของ สมหวัง168 แดงมังกร-โครเมียมขาวของ GT66B
// แดงเลือดนก-เงินของ TKB55 **น้ำเงิน-เงินของ TSDET911** ม่วง-ทองของ KMD88 และ
// ทองล้วนของ TND168 — **เกือบทุกแบรนด์ที่ผ่านไฟล์นี้มีทอง และมีหกแบรนด์ที่แดงนำ**
// การเจอ "ทอง" ในไฟล์นี้จึงไม่ได้แปลว่าเป็นของรอบนี้แน่ๆ
// ทองรอบนี้คือ #d4922c (+#fdfc71 +#f6e3b4 +#a25b24 +#5a3310) และ **รอบนี้ไม่มีแดงเลย**
// ⚠️ dfa310 ของ TND168 ใกล้ d4922c ที่สุด (ต่างที่ G163 vs G146 และ B16 vs B44)
// และ f0bb4e ของ รวยเทพ168 รอบที่แล้วก็เป็นทองเหมือนกัน ให้เทียบเป็นตัวเลขกับตาราง
// ใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false
// positive — และรอบนี้ไม่มีค่าแดง/ฟ้า/น้ำเงิน/ม่วง/เขียว/เงินโครเมียม/โรสโกลด์/
// ชมพูฟูเชีย เหลือในไฟล์นี้เลย
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(212,146,44, 0.28) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(253,252,113, 0.18) 0%, transparent 55%), rgba(10,6,1, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(212,146,44, 0.65);
    border-radius: 1.5rem;
    background: rgba(51,32,10, 0.94);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.7),
      0 0 2rem rgba(212,146,44, 0.38);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #fdfc71 0%, #f6e3b4 50%, #d4922c 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #fdfc71 0%, #d4922c 55%, #a25b24 100%);
    box-shadow: 0 0 2rem rgba(212,146,44, 0.6);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(90,51,16, 0.8);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #d4922c;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #fdfc71;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #fbf6e3;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(251,246,227, 0.8);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(212,146,44, 0.6);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(253,252,113, 0.45);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
