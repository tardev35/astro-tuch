---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// GT66B (รอบแดงมังกร-โครเมียมขาว 2026-10-13): หน้าจอคั่นตอนกดปุ่มไป
// ลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render ตัวนี้
// ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก .claude/brand-spec-gt66b.md §2: backdrop เป็นแดงเกือบดำจม
// rgba(11,3,3) = #0b0303 (พื้นเพจรอบนี้เป็นดำสนิท #000000 backdrop จึงเสมอกัน
// กับพื้นแทบทั้งหมด — ความต่างมาจากออร่าสองจุดแทน) ออร่าบนเป็นแดงแบรนด์
// rgba(251,20,27) คู่กับแดงสว่าง rgba(255,95,99) ด้านล่าง แผงการ์ดเป็นผิวยก
// rgba(28,12,11) = #1c0c0b
// ⚠️ แผงการ์ดต้องสว่างกว่า backdrop เสมอ
// ออร์บไล่จากโครเมียมขาว #fdfcfd เข้าหาแดงอ่อน #ffa0a2 แล้วจบที่แดงแบรนด์
// #fb141b (ออร์บเป็นรูปทรง ไม่ใช่ตัวอักษร #fb141b จึงใช้ได้ตรงนี้) — การไล่
// "ขาวเข้าแดง" คือแบรนด์สองโทนของรอบนี้อ่านจากโลโก้ตรงๆ (มังกร 龍 กับเลข 66
// แดงสด + GT กับ B โครเมียมขาว)
// วงแหวนคู่หมุนสวนทางกันและแยก "โทน" กันจริง — วงนอกแดงแบรนด์ #fb141b วงใน
// โครเมียมขาว #fdfcfd ต่างจากรอบก่อน (TKB55) ที่วงในเป็นเงินโครเมียมอมฟ้า
// รางวงแหวนใช้เส้นคั่นจาง rgba(138,6,9,0.8) = #8a0609 แดงถ่าน (เป็นเส้น
// ไม่ใช่ตัวอักษร) ส่วนชื่อแบรนด์ไล่ โครเมียมขาว #fdfcfd -> แดงอ่อน #ffa0a2 ->
// แดงสว่าง #ff5f63
// ⚠️ ปลายเข้มของ "ตัวอักษร" หยุดที่ #ff5f63 ไม่ใช่ #fb141b หรือ #db040b —
// #fb141b บนแผง #1c0c0b ได้ ~4.9:1 และ #db040b ได้ ~3.4:1 ส่วน #ff5f63 ได้
// ~6.4:1 ผ่าน AA สำหรับข้อความปกติด้วยซ้ำ
// (brand-spec §2: #fb141b / #db040b / #8a0609 / #3b0405 ห้ามถือตัวอักษรทุกขนาด)
// ⚠️ ไฟล์นี้เคยเป็นแดงเลือดนก-เงินโครเมียมของ TKB55 ก่อนหน้านั้นเป็นน้ำเงิน-เงิน
// ของ TSDET911 ม่วง-ทองของ KMD88 และทองล้วนของ TND168 — และก่อนหน้านั้นอีกมี
// แบรนด์แดงอยู่จริง (FLASH877 / PIGPG / SUPERSLOTCLUB) การเจอแดงในไฟล์นี้จึง
// **ไม่ได้แปลว่าเป็นของรอบนี้** โดยเฉพาะรอบนี้ที่แบรนด์ก่อนหน้าทันทีก็แดง
// ให้เทียบเป็นตัวเลขกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่เพื่อไม่ให้
// grep หาสีของแบรนด์เก่าเจอ false positive —
// และรอบนี้ไม่มีค่าทอง/ม่วง/ชมพู/เขียว/น้ำเงิน/ฟ้า/ส้มเหลืออยู่ในไฟล์นี้เลย
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(251, 20, 27, 0.3) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(255, 95, 99, 0.18) 0%, transparent 55%), rgba(11, 3, 3, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(251, 20, 27, 0.65);
    border-radius: 1.5rem;
    background: rgba(28, 12, 11, 0.94);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.7),
      0 0 2rem rgba(251, 20, 27, 0.38);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #fdfcfd 0%, #ffa0a2 50%, #ff5f63 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #fdfcfd 0%, #ffa0a2 55%, #fb141b 100%);
    box-shadow: 0 0 2rem rgba(251, 20, 27, 0.6);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(138, 6, 9, 0.8);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #fb141b;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #fdfcfd;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #eceaea;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(236, 234, 234, 0.8);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(251, 20, 27, 0.6);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(255, 95, 99, 0.45);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
