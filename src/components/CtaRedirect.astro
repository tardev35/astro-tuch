---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// รวยแทร่168 (รอบฟ้าอะซัวร์นำ-ทองอำพันรอง บนดำสนิท 2026-10-19): หน้าจอคั่นตอนกด
// ปุ่มไปลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render
// ตัวนี้ ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก .claude/brand-spec-ruaythear168.md §2: backdrop เป็นน้ำเงินหมึกจม
// rgba(3,15,29) = #030f1d (พื้นเพจรอบนี้เป็น **ดำสนิท #000000** backdrop จึงไม่
// จมกว่าพื้นได้แล้ว แต่ยังอ่านออกว่าเป็นชั้นทับเพราะมีออร่าสองวงและแผงการ์ดสว่าง
// กว่าอย่างชัดเจน) ออร่าบนเป็น **ฟ้าแบรนด์** rgba(3,156,250) คู่กับ
// **ทองอำพัน** rgba(249,168,38) ด้านล่าง — ฮิวนำอยู่บน ฮิวที่สองอยู่ล่าง
// แผงการ์ดเป็นผิวยก rgba(11,45,82) = #0b2d52
// ⚠️ แผงการ์ดต้องสว่างกว่า backdrop เสมอ
// ออร์บไล่จากฟ้าน้ำแข็ง #c3ebfc เข้าหาฟ้าแบรนด์ #039cfa แล้วจบที่ทองอำพัน
// #f9a826 — การไล่ "ฟ้าออกทอง" คืออ่านจากตัวอักษรบนโลโก้ตรงๆ (คำว่า แทร่168 เป็น
// ฟ้าอะซัวร์บับเบิลผิวมันวาว ส่วนคำว่า รวย ที่อยู่ก่อนหน้าเป็นทองอำพัน)
// วงแหวนคู่หมุนสวนทางกันและแยก "โทน" กันจริง — วงนอก **ฟ้าแบรนด์ #039cfa**
// วงใน **ทองอำพัน #f9a826**
// รางวงแหวนใช้เส้นคั่นจาง rgba(4,54,107,0.8) = #04366b น้ำเงินลึก (เป็นเส้น
// ไม่ใช่ตัวอักษร) ส่วนชื่อแบรนด์ไล่ ฟ้าน้ำแข็ง #c3ebfc -> ฟ้าแบรนด์ #039cfa ->
// ทองอำพัน #f9a826
// ⚠️ ปลายเข้มของ "ตัวอักษร" หยุดที่ #039cfa ไม่ใช่ #04366b หรือ #704504 —
// #04366b บนแผง #0b2d52 ได้ ~1.15:1 และ #704504 ได้ ~1.7:1 ตก AA ทั้งคู่
// ส่วน #039cfa ได้ ~4.6:1
// (brand-spec §2: #04366b / #704504 ห้ามถือตัวอักษรทุกขนาด)
// ⚠️ **ไฟล์นี้เพิ่งเป็นฟ้า-เหลืองของ นินจา168 เมื่อรอบที่แล้วเป๊ะๆ** และก่อนหน้านั้น
// เป็นฟ้า-ทองของ สบายเบท168 ก่อนหน้านั้นเป็นชมพูบับเบิลกัมนำ-ทองเนยรองของ
// ถอนชัวร์168 ทองนำ-ชมพูบานเย็นของ มีโชค168 ทอง-โรสโกลด์ของ ขวัญใจ168
// ทองไทย-แดงมังกรของ รับตัง168 แดงมังกร-ทองของ สมหวัง168 แดงมังกร-โครเมียมขาว
// ของ GT66B แดงเลือดนก-เงินของ TKB55 **น้ำเงิน-เงินของ TSDET911** ม่วง-ทองของ
// KMD88 และทองล้วนของ TND168 — **เกือบทุกแบรนด์ที่ผ่านไฟล์นี้มีทอง และสองรอบ
// ที่แล้วก็ฟ้านำเหมือนรอบนี้**
// การเจอ "ทอง" หรือ "ฟ้า/น้ำเงิน" ในไฟล์นี้จึงไม่ได้แปลว่าเป็นของรอบนี้แน่ๆ
// ฟ้ารอบนี้คือ #039cfa (+#c3ebfc +#04366b) และทองรอบนี้คือ #f9a826
// ให้เทียบเป็นตัวเลขกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่เพื่อไม่ให้ grep
// หาสีของแบรนด์เก่าเจอ false positive — และรอบนี้ไม่มีค่าชมพู/แดง/ม่วง/เขียว/ส้ม/
// เงินโครเมียม/โรสโกลด์/เหลืองมะนาว เหลือในไฟล์นี้เลย
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(3, 156, 250, 0.28) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(249, 168, 38, 0.22) 0%, transparent 55%), rgba(3, 15, 29, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(3, 156, 250, 0.65);
    border-radius: 1.5rem;
    background: rgba(11, 45, 82, 0.94);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.7),
      0 0 2rem rgba(3, 156, 250, 0.38);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #c3ebfc 0%, #039cfa 50%, #f9a826 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #c3ebfc 0%, #039cfa 55%, #f9a826 100%);
    box-shadow: 0 0 2rem rgba(3, 156, 250, 0.6);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(4, 54, 107, 0.8);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #039cfa;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #f9a826;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #e3f2fc;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(227, 242, 252, 0.8);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(3, 156, 250, 0.6);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(249, 168, 38, 0.5);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
