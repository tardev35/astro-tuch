---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// PIGPG (รอบแดงแล็กเกอร์-ทองแบบตรุษจีน 2026-10-09): หน้าจอคั่นตอนกดปุ่มไป
// ลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render ตัวนี้
// ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก brand-spec §2: backdrop เป็นพื้นแดงเกือบดำ rgba(18,3,2) ออร่าเป็น
// ทองแบรนด์ rgba(245,182,29) คู่กับแดงสด rgba(212,32,13) แผงการ์ดเป็นผิวยก
// rgba(58,13,7) = #3a0d07 ออร์บไล่จากครีมงาช้าง #fdf9e4 เข้าหาทองแบรนด์ #f5b61d
// แล้วจบที่ทองเข้ม #b07a06
// วงแหวนคู่หมุนสวนทางกันและแยก "สี" กันจริง รอบนี้เป็นสองฮิวจริง (วงนอกทองแบรนด์
// #f5b61d วงในแดงสด #d4200d) เพราะโลโก้รอบนี้เป็นป้ายแล็กเกอร์แดงขอบทองที่มี
// ตัวอักษร PIGPG สีครีม และหัวหมูสวมหมวกจีนแดงติดเหรียญทอง — มีฮิวที่สองจริง
// ไม่ใช่โลหะเดียว รางวงแหวนใช้เส้นขอบ/คั่นจาง rgba(176,122,6) = ทองเข้ม
// ส่วนชื่อแบรนด์ไล่ ครีมงาช้าง -> ทองอ่อน -> ทองเข้ม
// ชุดมรกต-ทองของ KOON234 (#fde9a6 #f7d14e #8a6204 #cc920a #2fbf6a #e8f2e6
// rgba(204,146,10,α) rgba(10,107,50,α) rgba(138,98,4,α) rgba(232,242,230,α)
// rgba(6,24,1) rgba(13,36,20) rgba(253,233,166,α)) ไม่เหลือแล้ว
// ⚠️ ทองของรอบนี้เป็นคนละค่ากับทองของ KOON234 — อย่าปล่อยค่าเก่าไว้เพราะคล้ายกัน
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(245, 182, 29, 0.26) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(212, 32, 13, 0.22) 0%, transparent 55%), rgba(18, 3, 2, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(245, 182, 29, 0.55);
    border-radius: 1.5rem;
    background: rgba(58, 13, 7, 0.94);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.7),
      0 0 2rem rgba(245, 182, 29, 0.28);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #fdf9e4 0%, #ffd87a 50%, #b07a06 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #fdf9e4 0%, #f5b61d 55%, #b07a06 100%);
    box-shadow: 0 0 2rem rgba(245, 182, 29, 0.55);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(176, 122, 6, 0.7);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #f5b61d;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #d4200d;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #fdeedd;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(253, 238, 221, 0.8);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(245, 182, 29, 0.55);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(253, 249, 228, 0.45);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
