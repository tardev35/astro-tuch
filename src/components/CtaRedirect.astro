---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// หวยดีใจ (รอบแดงแบรนด์ + เงินโครเมียม บนดำอมแดง 2026-10-04): หน้าจอคั่นตอนกดปุ่มไป
// ลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render ตัวนี้
// ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก brand-spec §2: backdrop เป็นพื้นลึกสุด rgba(13,4,7) = #0d0407
// แผงการ์ดเป็นผิวยก rgba(23,8,12) = #17080c ออร่าเป็นแดงแบรนด์ rgba(220,4,9)
// กับเงินโครเมียม rgba(195,199,209) ออร์บไล่จากแดงสว่าง #f5363d เข้าหาแดงแบรนด์
// #dc0409 แล้วจบที่แดงลึก #7a0205
// วงแหวนคู่หมุนสวนทางกันและแยก "สี" กันจริง (วงนอกแดง #dc0409 วงในเงิน #c3c7d1)
// ตามคู่สีของงานศิลป์รอบนี้: โลโก้เป็นคำว่า "หวย" โครเมียมเงินคู่กับ "ดีใจ" แดง
// เมทัลลิก ส่วนแบนเนอร์เป็นพื้นขาวเงินกับริบบิ้นแดง รางวงแหวนใช้เส้นขอบ/คั่นจาง
// rgba(75,2,5) = #4b0205 ส่วนชื่อแบรนด์ไล่ เงินสว่าง -> แดงสว่าง -> แดงลึก
// ชุดแดง-ทองของแบรนด์ก่อน (#ffd45e #ff5c5c #d20a0a #f5c33b #7a0505 #5c1212
// rgba(210,10,10) rgba(245,195,59) rgba(10,3,3) rgba(23,7,7) rgba(247,226,214)
// rgba(255,92,92)) ไม่เหลือแล้ว
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(220, 4, 9, 0.32) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(195, 199, 209, 0.16) 0%, transparent 55%), rgba(13, 4, 7, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(220, 4, 9, 0.5);
    border-radius: 1.5rem;
    background: rgba(23, 8, 12, 0.94);
    box-shadow:
      0 1rem 3rem rgba(13, 4, 7, 0.6),
      0 0 2rem rgba(220, 4, 9, 0.24);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #eef0f4 0%, #f5363d 50%, #7a0205 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #f5363d 0%, #dc0409 55%, #7a0205 100%);
    box-shadow: 0 0 2rem rgba(220, 4, 9, 0.5);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(75, 2, 5, 0.7);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #dc0409;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #c3c7d1;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #c3c7d1;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(237, 234, 240, 0.78);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(220, 4, 9, 0.5);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(245, 54, 61, 0.45);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
