---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// สาธุ168 (รอบเขียวมรกตนำ ทองสัมฤทธิ์รอง บนธีมสว่าง 2026-10-21): หน้าจอคั่นตอนกดปุ่ม
// ไปลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render ตัวนี้
// ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก .claude/brand-spec-satu168.md §2 (โซน "โครม")
// ⚠️⚠️ **รอบนี้พื้นเพจเป็นเขียวมิ้นต์สว่าง #d8ffc7 (จาก bg.json) ไม่ใช่ดำ** แต่
// overlay ตัวนี้ยังเป็น **เขียวป่าเข้ม** โดยตั้งใจ: มันเป็นชั้นทับเต็มจอที่ต้องกลบหน้า
// ข้างหลังให้สนิท และ backdrop สว่างบนพื้นสว่างจะอ่านไม่ออกว่าเป็นชั้นทับ
// backdrop เป็นชั้นจม rgba(12,58,22) = #0c3a16 (หมึกเขียวป่า = พื้นโครม) ออร่าบนเป็น
// **เขียวมรกตแบรนด์** rgba(11,125,40) คู่กับ **เขียวเข้ม** rgba(10,95,28) ด้านล่าง
// — ฮิวนำอยู่บน แผงการ์ดเป็นผิวยก rgba(10,95,28) = #0a5f1c
// ⚠️ แผงการ์ดต้องสว่างกว่า backdrop เสมอ (#0a5f1c ยก vs #0c3a16 จม)
// ⚠️ ค่าทุกค่าในไฟล์นี้อยู่ในชุด rgba ที่ brand-spec §2 อนุญาต (11/125/40 ·
// 10/95/28 · 12/58/22 · 174/176/74) โดยตั้งใจ — จึงไม่มี rgba ของ #061f0c
// (เขียวจม) ในไฟล์นี้ ชั้นจมใช้ #0c3a16 ซึ่งเป็นพื้นโครมที่ brand-spec กำหนดคู่กัน
// ออร์บไล่จากมิ้นต์สว่าง #e9fbdd เข้าหาเขียวใบตอง #0f9b35 แล้วจบที่เขียวมรกต #0b7d28
// — การไล่ "อ่อนออกเข้ม" คืออ่านจากโลโก้ตรงๆ (คำว่า สาธุ เป็นตัวอักษรสามมิติ
// ไล่เฉดเขียวมรกตเข้มไปเขียวใบตองสว่าง)
// วงแหวนคู่หมุนสวนทางกันและแยกค่ากันจริง — วงนอก **เขียวใบตอง #0f9b35**
// วงใน **ทองสัมฤทธิ์ #aeb04a** (วงแหวนเป็นเส้นตกแต่ง ไม่ใช่ตัวอักษร จึงใช้ #0f9b35 ได้)
// รางวงแหวนใช้เส้นคั่นจาง rgba(12,58,22,0.8) = #0c3a16 (เป็นเส้น ไม่ใช่ตัวอักษร)
// ส่วนชื่อแบรนด์ไล่ ขาว #ffffff -> ทองสัมฤทธิ์อ่อน #c9cb63
// ⚠️ ปลายของ "ตัวอักษร" หยุดที่ #c9cb63 — **ลากลงไปถึง #0f9b35 ไม่ได้** เพราะ
// #0f9b35 ได้แค่ 3.7:1 และ #0b7d28 ต่ำกว่านั้นบนแผง #0a5f1c ทั้งคู่จึงเป็น
// พื้นถม/ขอบ/ออรา/วงแหวนเท่านั้น ไม่เคยถือตัวอักษรในไฟล์นี้เลย
// (brand-spec §2: #0f9b35 ห้ามถือตัวอักษรและห้ามเป็นพื้นของตัวอักษร)
// ⚠️ **ไฟล์นี้เพิ่งเป็นชมพูบานเย็น-โรสเข้มของ มีทรัพย์168 เมื่อรอบที่แล้วเป๊ะๆ**
// ก่อนหน้านั้นเป็นแดงชาด-ทองน้ำผึ้งของ ดวงเศรษฐี168 ทองอำพัน-บรอนซ์ของ ufalion168
// ทองจักรพรรดิ-แดงชาดของ รวยเทพ168 แดงชาด-ทองเนยของ มีเฮ168 ฟ้าอะซัวร์-ทองอำพันของ
// รวยแทร่168 ฟ้า-เหลืองของ นินจา168 ฟ้า-ทองของ สบายเบท168 ชมพูบับเบิลกัม-ทองเนยของ
// ถอนชัวร์168 ทองนำ-ชมพูบานเย็นของ มีโชค168 ทอง-โรสโกลด์ของ ขวัญใจ168
// ทองไทย-แดงมังกรของ รับตัง168 แดงมังกร-ทองของ สมหวัง168 และทองล้วนของ TND168
// — **ทอง/เหลืองเคยผ่านไฟล์นี้มาเกือบทุกแบรนด์** การเจอ "ทอง" ในไฟล์นี้จึงไม่ได้
// แปลว่าเป็นของรอบนี้แน่ๆ ทองรอบนี้เป็น **ทองสัมฤทธิ์อมเขียว** #aeb04a (+#c9cb63)
// ส่วนเขียวมรกตทั้งชุด (#0b7d28 #0f9b35 #0a5f1c #0c3a16) ไม่มีแบรนด์ไหนเคยใช้เลย
// ให้เทียบเป็นตัวเลขกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive — และรอบนี้ไม่มีค่า
// ชมพู/แดงชาด/ฟ้า/น้ำเงิน/ไซยาน/ม่วง/เงินโครเมียม/โรสโกลด์/ส้มสด/บรอนซ์/
// ทองส้ม เหลือในไฟล์นี้เลย
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(11,125,40, 0.30) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(10,95,28, 0.22) 0%, transparent 55%), rgba(12,58,22, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(174,176,74, 0.65);
    border-radius: 1.5rem;
    background: rgba(10,95,28, 0.94);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.7),
      0 0 2rem rgba(11,125,40, 0.38);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #ffffff 0%, #c9cb63 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #e9fbdd 0%, #0f9b35 55%, #0b7d28 100%);
    box-shadow: 0 0 2rem rgba(11,125,40, 0.6);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(12,58,22, 0.8);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #0f9b35;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #aeb04a;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #ffffff;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: #e9fbdd;
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(11,125,40, 0.6);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(10,95,28, 0.5);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
