---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// โปรดี168 (รอบแดงเชอร์รี่นำ ทองแดงไหม้รอง บนธีมสว่าง 2026-10-22): หน้าจอคั่นตอนกดปุ่ม
// ไปลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render ตัวนี้
// ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก .claude/brand-spec-prodeee168.md §2 (โซน "โครม")
// ⚠️⚠️ **รอบนี้พื้นเพจเป็นชมพูพาสเทลสว่าง #ffd1d1 (จาก bg.json) ไม่ใช่ดำ** แต่
// overlay ตัวนี้ยังเป็น **น้ำตาลแดงเข้ม** โดยตั้งใจ: มันเป็นชั้นทับเต็มจอที่ต้องกลบ
// หน้าข้างหลังให้สนิท และ backdrop สว่างบนพื้นสว่างจะอ่านไม่ออกว่าเป็นชั้นทับ
// backdrop เป็นชั้นจม rgba(64,17,7) = #401107 (หมึกน้ำตาลแดง) ออร่าบนเป็น
// **แดงเชอร์รี่แบรนด์** rgba(235,3,5) คู่กับ **แดงเข้ม** rgba(155,10,12) ด้านล่าง
// — ฮิวนำอยู่บน แผงการ์ดเป็นผิวยก rgba(155,10,12) = #9b0a0c
// ⚠️ แผงการ์ดต้องสว่างกว่า backdrop เสมอ (#9b0a0c ยก vs #401107 จม)
// ⚠️ ค่าทุกค่าในไฟล์นี้อยู่ในชุด rgba ที่ brand-spec §2 อนุญาต (235/3/5 ·
// 155/10/12 · 64/17/7 · 180/76/6 · 240/180/106) โดยตั้งใจ — จึงไม่มี rgba ของ
// #2c1004 หรือ #4d1c0a ในไฟล์นี้ ชั้นจมใช้ #401107 ซึ่งเป็นหมึกที่ brand-spec
// กำหนดคู่กัน
// ออร์บไล่จากครีมอินเซ็ต #fff4ea เข้าหาแดงสด #ff4446 แล้วจบที่แดงเชอร์รี่ #eb0305
// — การไล่ "อ่อนออกเข้ม" คืออ่านจากโลโก้ตรงๆ (คำว่า โปรดี168 เป็นตัวอักษรสามมิติ
// ผิวมันวาวไล่เฉดแดงเชอร์รี่ ขอบขาว)
// วงแหวนคู่หมุนสวนทางกันและแยกค่ากันจริง — วงนอก **แดงสด #ff4446**
// วงใน **ทองแดงไหม้ #b44c06** (วงแหวนเป็นเส้นตกแต่ง ไม่ใช่ตัวอักษร จึงใช้ #ff4446 ได้)
// รางวงแหวนใช้เส้นคั่นจาง rgba(64,17,7,0.8) = #401107 (เป็นเส้น ไม่ใช่ตัวอักษร)
// ส่วนชื่อแบรนด์ไล่ ขาว #ffffff -> ทองสาลี่ #f0b46a (5.1:1 บนแผง #9b0a0c)
// ⚠️ ปลายของ "ตัวอักษร" หยุดที่ #f0b46a — **ลากลงไปถึง #ff4446 ไม่ได้** เพราะ
// #ff4446 ได้แค่ 3.1:1 บนขาวและต่ำกว่านั้นมากบนแผง #9b0a0c มันจึงเป็น
// พื้นถม/ขอบ/ออรา/วงแหวนเท่านั้น ไม่เคยถือตัวอักษรในไฟล์นี้เลย
// (brand-spec §2: #ff4446 ห้ามถือตัวอักษรและห้ามเป็นพื้นของตัวอักษร)
// ⚠️ **ไฟล์นี้เพิ่งเป็นแดงคริมสัน-ทองโบราณของ รวยแท้168 เมื่อรอบที่แล้วเป๊ะๆ**
// (c30303 8f0505 e81313 dcb95f b8862b 4a0f0f fff1ef ffeee8 — ชุดที่เสี่ยงหลงเหลือ
// ที่สุด) ก่อนหน้านั้นเป็นเขียวมรกต-ทองสัมฤทธิ์ของ สาธุ168 ชมพูบานเย็นของ มีทรัพย์168
// แดงชาด-ทองน้ำผึ้งของ ดวงเศรษฐี168 ทองอำพัน-บรอนซ์ของ ufalion168 ทองจักรพรรดิ-
// แดงชาดของ รวยเทพ168 แดงชาด-ทองเนยของ มีเฮ168 ฟ้าอะซัวร์-ทองอำพันของ รวยแทร่168
// ฟ้า-เหลืองของ นินจา168 ฟ้า-ทองของ สบายเบท168 ชมพูบับเบิลกัม-ทองเนยของ ถอนชัวร์168
// ทองนำ-ชมพูบานเย็นของ มีโชค168 ทอง-โรสโกลด์ของ ขวัญใจ168 ทองไทย-แดงมังกรของ
// รับตัง168 แดงมังกร-ทองของ สมหวัง168 และทองล้วนของ TND168
// — **ทอง/เหลืองเคยผ่านไฟล์นี้มาเกือบทุกแบรนด์ และแดงก็เคยผ่านมาหลายรอบ รวมถึง
// รอบก่อนที่เป็นแดง+ทองเหมือนกันเป๊ะ** การเจอ "ทอง" หรือ "แดง" ในไฟล์นี้จึงไม่ได้
// แปลว่าเป็นของรอบนี้แน่ๆ ทองรอบนี้เป็น **ทองสาลี่** #f0b46a (+ทองแดงไหม้ #b44c06)
// ส่วนแดงรอบนี้คือ #eb0305 คู่กับ #9b0a0c และ #401107 ซึ่งใกล้ dc0203 (หวย365)
// กว่าปกติ ให้เทียบเป็นตัวเลขกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive — และรอบนี้ไม่มีค่า
// เขียว/ชมพู/ฟ้า/น้ำเงิน/ไซยาน/ม่วง/เงินโครเมียม/โรสโกลด์/ส้มสด/
// ทองเหลืองสด เหลือในไฟล์นี้เลย
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(235,3,5, 0.30) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(155,10,12, 0.22) 0%, transparent 55%), rgba(64,17,7, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(180,76,6, 0.65);
    border-radius: 1.5rem;
    background: rgba(155,10,12, 0.94);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.7),
      0 0 2rem rgba(235,3,5, 0.38);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #ffffff 0%, #f0b46a 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #fff4ea 0%, #ff4446 55%, #eb0305 100%);
    box-shadow: 0 0 2rem rgba(235,3,5, 0.6);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(64,17,7, 0.8);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #ff4446;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #b44c06;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #ffffff;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: #fff0e4;
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(235,3,5, 0.6);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(155,10,12, 0.5);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
