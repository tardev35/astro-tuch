---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// เงินทอง168 (รอบทองตราชั่งนำ ครีมอุ่นรอง บนธีมมืด 2026-10-22): หน้าจอคั่นตอนกดปุ่ม
// ไปลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render ตัวนี้
// ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก .claude/brand-spec-ngernthong168.md §2 (โซน "โครม")
// ⚠️⚠️ **รอบนี้พื้นเพจเป็นน้ำตาลโอลีฟเข้ม #29210f (จาก bg.json ซึ่งรอบก่อนเป็น
// 291d0f ต่างกันที่เขียว 4 หน่วย)** overlay ตัวนี้เป็น **โครม จึงเป็นน้ำตาลลึก
// ที่จมกว่าพื้นเพจ** — มันต้องกลบหน้าข้างหลังได้สนิท ซึ่งเป็นเหตุผลเดียวกันทุกรอบ
// ไม่ว่าพื้นเพจจะสว่างหรือมืด **ห้าม "แก้" ให้สว่าง**
// backdrop เป็นชั้นจม rgba(27,20,7) = #1b1407 ออร่าบนเป็น **ทองแกนแบรนด์**
// rgba(245,186,20) คู่กับ **ครีมอุ่น** rgba(236,213,196) ด้านล่าง
// — ฮิวนำอยู่บน แผงการ์ดเป็นผิวยก rgba(46,37,18) = #2e2512
// ⚠️ แผงการ์ดต้องสว่างกว่า backdrop เสมอ (#2e2512 ยก vs #1b1407 จม)
// ⚠️ ค่าทุกค่าในไฟล์นี้อยู่ในชุด rgba ที่ brand-spec §2 อนุญาต (245/186/20 ·
// 252/238/82 · 236/213/196 · 27/20/7 · 0/0/0) โดยตั้งใจ
// ออร์บไล่จากทองสว่าง #fcee52 เข้าหาทองแกน #f5ba14 แล้วจบที่ทองลึก #b37c0b
// — การไล่ "อ่อนออกเข้ม" คืออ่านจากโลโก้ตรงๆ (คำว่า เงินทอง เป็นตัวอักษรสามมิติผิว
// มันวาวไล่เฉดทอง มีไฮไลต์ขาวที่ยอดและเงาทองลึกที่ฐาน)
// วงแหวนคู่หมุนสวนทางกันและแยกค่ากันจริง — วงนอก **ทองแกน #f5ba14**
// วงใน **ครีมอุ่น #ecd5c4** ⚠️⚠️ **เลข 168 ในโลโก้เป็นโครเมียมเงินจริง แต่แรมป์
// เทาเงินเป็นของ พักยก168 (รอบก่อนทันที) กับ ยูฟ้า168 ไปแล้ว รอบนี้จึงใช้ครีมอุ่น
// ที่วัดจาก slide1.png (ชุดซาตินสีงาช้าง) เป็นวัสดุที่สองแทน — ห้ามเอาเทาเงิน
// กลับเข้ามา** นี่คือหนึ่งในสองตัวที่แยกรอบนี้ออกจากรอบก่อน
// รางวงแหวนใช้เส้นคั่นจาง rgba(77,60,21,0.8) = #4d3c15 (เป็นเส้น ไม่ใช่ตัวอักษร
// ค่านี้จึงใช้ได้ ทั้งที่ถือตัวอักษรไม่ได้)
// ส่วนชื่อแบรนด์ไล่ ครีม #ecd5c4 -> ทองแกน #f5ba14 (11.6 -> 8.6:1 บนแผง #2e2512)
// ⚠️ ปลายของ "ตัวอักษร" หยุดที่ #f5ba14 — **ลากลงไปถึง #b37c0b ไม่ได้บนแผงเข้มนี้**
// เพราะทองลึกได้แค่ 3.3:1 บน #2e2512 มันจะมืดเกินไป
// ⚠️⚠️ **ไฟล์นี้เพิ่งเป็นทองแกน-โครเมียมเงินของ พักยก168 เมื่อรอบที่แล้วเป๊ะๆ**
// (eeae12 fded41 9f600d e0e0df c0c0bf a1a09e f4ead6 d6c6a8 291d0f 2f1e0f 1f0f04
// 4e2f11 — **ชุดที่เสี่ยงหลงเหลือที่สุด และเป็นทองเหมือนกันด้วย**)
// ก่อนหน้านั้นเป็นฟ้าสกาย-ทองคานารีของ สบาย168 (2cc3fc 6bdcfb 0a7fbd 063a57
// 04293d 0a4f74 fdcb0c eafaff ffffff) ก่อนหน้านั้นเป็นทองคานารี-โครเมียมเงินของ
// ยูฟ้า168 (fee45d e6a416 b8780d 7a4e05 e8ecf1 a8b2bf 78828f 5a6472 15130f
// 1e1a13 0a0908 eae3d4 fff8dd 000000) ก่อนหน้านั้นเป็นแดงเชอร์รี่-ทองแดงไหม้
// ของ โปรดี168 (eb0305 9b0a0c ff4446 b44c06 f0b46a 401107 fff4ea fff0e4)
// แดงคริมสัน-ทองโบราณของ รวยแท้168 เขียวมรกต-ทองสัมฤทธิ์ของ สาธุ168
// ชมพูบานเย็นของ มีทรัพย์168 แดงชาด-ทองน้ำผึ้งของ ดวงเศรษฐี168 ทองอำพัน-บรอนซ์ของ
// ufalion168 ทองจักรพรรดิ-แดงชาดของ รวยเทพ168 แดงชาด-ทองเนยของ มีเฮ168
// ทอง-โรสโกลด์ของ ขวัญใจ168 ทองไทย-แดงมังกรของ รับตัง168 แดงมังกร-ทองของ สมหวัง168
// แดงมังกร-โครเมียมของ GT66B
// ⚠️⚠️ **ทองผ่านไฟล์นี้มาแล้วเกือบทุกเจ้า และรอบก่อนทันทีก็ทอง** การเจอ "ทอง"
// ในไฟล์นี้จึงไม่ได้แปลว่าเป็นของรอบนี้ ทองรอบนี้คือ **#f5ba14** (+#fcee52 #b37c0b)
// และวัสดุที่สองรอบนี้คือ **ครีม #ecd5c4** (+#d2b9a4) เพื่อนบ้านที่ใกล้ที่สุดคือ
// eeae12 ของพักยก168 (ห่าง R7/G12/B2) f7c92b ของขวัญใจ168 และ e6a416 ของยูฟ้า168
// ให้เทียบเป็นตัวเลขกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่เพื่อไม่ให้ grep
// หาสีของแบรนด์เก่าเจอ false positive — และรอบนี้ไม่มีค่าแดง/เขียว/ชมพู/ม่วง/
// โรสโกลด์/ส้มสด/ฟ้า-น้ำเงิน/เทาเงิน เหลือในไฟล์นี้เลย
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(245,186,20, 0.22) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(236,213,196, 0.14) 0%, transparent 55%), rgba(27,20,7, 0.97);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(245,186,20, 0.65);
    border-radius: 1.5rem;
    background: rgba(46,37,18, 0.96);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.7),
      0 0 2rem rgba(245,186,20, 0.28);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #ecd5c4 0%, #f5ba14 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #fcee52 0%, #f5ba14 55%, #b37c0b 100%);
    box-shadow: 0 0 2rem rgba(245,186,20, 0.5);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(77,60,21, 0.8);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #f5ba14;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #ecd5c4;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #ecd5c4;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: #d2b9a4;
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(245,186,20, 0.5);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(236,213,196, 0.45);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
