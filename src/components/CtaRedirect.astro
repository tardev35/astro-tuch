---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// หวยเฮง789 (รอบแดงนำ-ทองรอง 2026-10-01): หน้าจอคั่นตอนกดปุ่มไปลิงก์พันธมิตร
// แสดงเฉพาะ /login กับ /register — พื้นหลังดำ rgb(0,0,0) แผงการ์ดแดงเข้ม
// rgba(43,9,9) ออร่าเป็นแดงแบรนด์ rgba(220,34,36) กับทองรอง rgba(244,188,93)
// ออร์บไล่จากทองอ่อน #ffefc2 เข้าหาแดงแบรนด์ #dc2224 แล้วจบที่แดงลึก #ab0204
// วงแหวนคู่แยกสีกันคนละวง (วงนอกแดงสว่าง วงในทองรอง) หมุนสวนทางกัน ตามคู่สีของ
// โลโก้ที่คำว่า "หวย" เป็นแดงเลือดนกขอบทอง และ "เฮง789" เป็นทองไล่เฉด บนอาร์ตเวิร์ก
// ฉากผ้าซาตินแดงที่มีริ้วแสงทอง เหรียญทอง ลายไทยทอง และลูกหวย — รอบก่อน
// (หวยเฮง24) นำด้วยทอง ชุดเดิม (#e0a52a #fdea83 #8b0302 #c01616 #a46304
// rgba(46,7,7) rgba(90,2,2) rgba(246,230,207)) ไม่เหลือแล้ว
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(220, 34, 36, 0.32) 0%, transparent 55%),
      radial-gradient(circle at 50% 90%, rgba(244, 188, 93, 0.26) 0%, transparent 55%),
      rgba(0, 0, 0, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(220, 34, 36, 0.50);
    border-radius: 1.5rem;
    background: rgba(43, 9, 9, 0.94);
    box-shadow:
      0 1rem 3rem rgba(11, 2, 2, 0.6),
      0 0 2rem rgba(220, 34, 36, 0.24);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #ffefc2 0%, #f4bc5d 45%, #dc2224 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #ffefc2 0%, #dc2224 55%, #ab0204 100%);
    box-shadow: 0 0 2rem rgba(220, 34, 36, 0.50);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(92, 10, 10, 0.6);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #e43434;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #f4bc5d;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #ffefc2;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(251, 227, 212, 0.78);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(220, 34, 36, 0.50);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(244, 188, 93, 0.45);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
