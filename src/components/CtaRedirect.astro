---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// หวย365 (รอบแดงสด-ทอง-ดำ 2026-10-03): หน้าจอคั่นตอนกดปุ่มไปลิงก์พันธมิตร
// แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render ตัวนี้ ถ้าไม่ retheme
// ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// backdrop เป็นพื้นลึกสุด rgba(20,2,3) = #140203 แผงการ์ดเป็นพื้นการ์ด rgba(36,4,6)
// = #240406 ออร่าเป็นแดงแบรนด์ rgba(220,2,3) กับทองแบรนด์ rgba(255,201,60)
// ออร์บไล่จากแดงสว่าง #f5282a เข้าหาแดงแบรนด์ #dc0203 แล้วจบที่แดงลึก #8c0402
// วงแหวนคู่หมุนสวนทางกันและแยก "สี" กันจริง (วงนอกแดงแบรนด์ #dc0203 วงในทองแบรนด์
// #ffc93c) เพราะแบรนด์รอบนี้คือแดงนำ-ทองรอง: โลโก้เป็นแดงล้วนบนดำ ส่วนตัวอักษรบน
// แบนเนอร์กับสไลด์เป็นทองทั้งชุด รางวงแหวนใช้พื้นยกระดับ rgba(58,10,12) = #3a0a0c
// ชุดทอง-เงินของ NATO168 (#fde8a8 #edb543 #a9761f #e6e6e6 #f4ead3 rgba(237,181,67)
// rgba(230,230,230) rgba(16,16,16) rgba(4,3,0) rgba(58,42,13) rgba(253,232,168))
// ไม่เหลือแล้ว
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background: radial-gradient(circle at 50% 12%, rgba(220, 2, 3, 0.32) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(255, 201, 60, 0.18) 0%, transparent 55%), rgba(20, 2, 3, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(220, 2, 3, 0.5);
    border-radius: 1.5rem;
    background: rgba(36, 4, 6, 0.94);
    box-shadow:
      0 1rem 3rem rgba(8, 1, 1, 0.6),
      0 0 2rem rgba(220, 2, 3, 0.24);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #ffeab0 0%, #ffc93c 45%, #f5282a 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #f5282a 0%, #dc0203 55%, #8c0402 100%);
    box-shadow: 0 0 2rem rgba(220, 2, 3, 0.5);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(58, 10, 12, 0.6);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #dc0203;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #ffc93c;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #ffeab0;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(246, 231, 224, 0.78);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(220, 2, 3, 0.5);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(245, 40, 42, 0.45);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
