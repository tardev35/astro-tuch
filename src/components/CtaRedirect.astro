---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// KOON234 (รอบมรกตเข้ม-ทองบนเขียวเกือบดำ 2026-10-09): หน้าจอคั่นตอนกดปุ่มไป
// ลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render ตัวนี้
// ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก brand-spec §2: backdrop เป็นพื้นเขียวเกือบดำ rgba(6,24,1) ออร่าเป็น
// ทองแบรนด์ rgba(204,146,10) คู่กับเขียวมรกต rgba(10,107,50) แผงการ์ดเป็นผิวยก
// rgba(13,36,20) = #0d2414 ออร์บไล่จากทองซีด #fde9a6 เข้าหาทองสว่าง #f7d14e
// แล้วจบที่ทองเข้ม #8a6204
// วงแหวนคู่หมุนสวนทางกันและแยก "สี" กันจริง รอบนี้เป็นสองฮิวจริง (วงนอกทองแบรนด์
// #cc920a วงในเขียวสว่าง #2fbf6a) เพราะโลโก้รอบนี้เป็นตัว KOON เงินโครเมียมติด
// เลข 234 ทอง คร่อมวงแหวนเขียวมรกต — มีฮิวที่สองจริง ไม่ใช่โลหะเดียว
// รางวงแหวนใช้เส้นขอบ/คั่นจาง rgba(138,98,4) = ทองเข้ม
// ส่วนชื่อแบรนด์ไล่ ทองซีด -> ทองสว่าง -> ทองเข้ม
// ชุดทองเมทัลลิกของ 789BETTING (#ffe79a #fad354 #8a6410 #c9881f #17130a #f3e7cd
// rgba(250,211,84,α) rgba(201,136,31,α) rgba(255,231,154,α) rgba(243,231,205,α)
// rgba(6,4,2) rgba(23,19,10) rgba(138,100,16,α)) ไม่เหลือแล้ว
// ⚠️ ทองของรอบนี้เป็นคนละค่ากับทองของ 789BETTING — อย่าปล่อยค่าเก่าไว้เพราะคล้ายกัน
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(204, 146, 10, 0.26) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(10, 107, 50, 0.22) 0%, transparent 55%), rgba(6, 24, 1, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(204, 146, 10, 0.55);
    border-radius: 1.5rem;
    background: rgba(13, 36, 20, 0.94);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.7),
      0 0 2rem rgba(204, 146, 10, 0.28);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #fde9a6 0%, #f7d14e 50%, #8a6204 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #fde9a6 0%, #f7d14e 55%, #8a6204 100%);
    box-shadow: 0 0 2rem rgba(204, 146, 10, 0.55);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(138, 98, 4, 0.7);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #cc920a;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #2fbf6a;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #e8f2e6;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(232, 242, 230, 0.8);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(204, 146, 10, 0.55);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(253, 233, 166, 0.45);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
