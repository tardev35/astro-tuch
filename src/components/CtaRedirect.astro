---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// มีโชค168 (รอบทองนำ-ชมพูบานเย็นรอง บนดำสนิท 2026-10-18): หน้าจอคั่นตอนกดปุ่มไป
// ลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render ตัวนี้
// ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก .claude/brand-spec-meechoke168.md §2: backdrop เป็นดำจม
// rgba(11,5,9) = #0b0509 (พื้นเพจรอบนี้เป็น **ดำสนิท #000000** backdrop จึงไม่
// จมกว่าพื้นได้แล้ว แต่ยังอ่านออกว่าเป็นชั้นทับเพราะมีออร่าสองวงและแผงการ์ดสว่าง
// กว่าอย่างชัดเจน) ออร่าบนเป็น **ทองแบรนด์** rgba(252,212,52) คู่กับ
// **ชมพูบานเย็น** rgba(245,70,159) ด้านล่าง — รอบก่อนด้านล่างเป็นโรสโกลด์ รอบนี้
// เป็นชมพูบานเย็นซึ่งเป็นฮิวที่สองจริงของดรอปนี้ แผงการ์ดเป็นผิวยก
// rgba(36,16,28) = #24101c
// ⚠️ แผงการ์ดต้องสว่างกว่า backdrop เสมอ
// ออร์บไล่จากทองสว่าง #ffeaa0 เข้าหาทองแบรนด์ #fcd434 แล้วจบที่ชมพูบานเย็น
// #f5469f — การไล่ "ทองเข้าชมพู" คืออ่านจากตัวอักษรบนโลโก้ตรงๆ (คำว่า มีโชค
// ไล่เฉดชมพูไปหาทอง ส่วนเลข 168 เป็นทองล้วน)
// วงแหวนคู่หมุนสวนทางกันและแยก "โทน" กันจริง — วงนอก **ทองแบรนด์ #fcd434**
// วงใน **ชมพูบานเย็น #f5469f** ซึ่งรอบก่อนวงในเป็นโรสโกลด์
// รางวงแหวนใช้เส้นคั่นจาง rgba(122,85,8,0.8) = #7a5508 ทองลึก (เป็นเส้น
// ไม่ใช่ตัวอักษร) ส่วนชื่อแบรนด์ไล่ ทองสว่าง #ffeaa0 -> ทองแบรนด์ #fcd434 ->
// ชมพูบานเย็น #f5469f
// ⚠️ ปลายเข้มของ "ตัวอักษร" หยุดที่ #f5469f ไม่ใช่ #8c0f52 หรือ #7a5508 —
// #8c0f52 บนแผง #24101c ได้ ~2.2:1 และ #7a5508 ได้ ~2.6:1 ตก AA ทั้งคู่
// ส่วน #f5469f ได้ ~5.4:1
// (brand-spec §2: #8c0f52 / #7a5508 ห้ามถือตัวอักษรทุกขนาด)
// ⚠️ ไฟล์นี้เคยเป็นทอง-โรสโกลด์ของ ขวัญใจ168 ก่อนหน้านั้นเป็นทองไทย-แดงมังกรของ
// รับตัง168 แดงมังกร-ทองของ สมหวัง168 แดงมังกร-โครเมียมขาวของ GT66B
// แดงเลือดนก-เงินของ TKB55 น้ำเงิน-เงินของ TSDET911 ม่วง-ทองของ KMD88 และทองล้วน
// ของ TND168 — **เกือบทุกแบรนด์ที่ผ่านไฟล์นี้มีทอง** การเจอ "ทอง" ในไฟล์นี้จึงไม่ได้
// แปลว่าเป็นของรอบนี้ ทองรอบนี้คือ #fcd434 ให้เทียบเป็นตัวเลขกับตารางใน
// brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false
// positive — และรอบนี้ไม่มีค่าม่วง/เขียว/น้ำเงิน/ฟ้า/ส้ม/เงินโครเมียม/โรสโกลด์/
// แดงชาด เหลือในไฟล์นี้เลย
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(252, 212, 52, 0.28) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(245, 70, 159, 0.22) 0%, transparent 55%), rgba(11, 5, 9, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(252, 212, 52, 0.65);
    border-radius: 1.5rem;
    background: rgba(36, 16, 28, 0.94);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.7),
      0 0 2rem rgba(252, 212, 52, 0.38);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #ffeaa0 0%, #fcd434 50%, #f5469f 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #ffeaa0 0%, #fcd434 55%, #f5469f 100%);
    box-shadow: 0 0 2rem rgba(252, 212, 52, 0.6);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(122, 85, 8, 0.8);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #fcd434;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #f5469f;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #f6e4ee;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(246, 228, 238, 0.8);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(252, 212, 52, 0.6);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(245, 70, 159, 0.5);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
