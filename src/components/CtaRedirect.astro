---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// FAH999 (รอบชมพูบานเย็น-ทอง 2026-10-11): หน้าจอคั่นตอนกดปุ่มไป
// ลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render ตัวนี้
// ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก brand-spec §2: backdrop เป็นม่วงพลัม rgba(46,0,44) = พื้นเพจรอบนี้
// (bg.json = #2e002c) ออร่าบนเป็นชมพูแบรนด์ rgba(255,63,164) คู่กับทอง
// rgba(245,197,61) ด้านล่าง แผงการ์ดเป็นผิวยก rgba(74,11,66) = #4a0b42
// ⚠️ รอบนี้พื้นเพจ **ไม่ใช่ดำสนิท** แล้ว แต่แผงการ์ดยังต้องสว่างกว่า backdrop
// ออร์บไล่จากชมพูอ่อน #ffd1ea เข้าหาชมพูแบรนด์ #ff3fa4 แล้วจบที่ชมพูลึก #b3006a
// (ออร์บเป็นรูปทรง ไม่ใช่ตัวอักษร #b3006a จึงใช้ได้ตรงนี้ที่เดียว)
// วงแหวนคู่หมุนสวนทางกันและแยก "สี" กันจริง รอบนี้เป็นสองฮิวจริง (วงนอกชมพูแบรนด์
// #ff3fa4 วงในทอง #f5c53d) เพราะโลโก้รอบนี้เป็นสาวหูกระต่ายสีชมพูเหนือตัวอักษร
// FAH999 ชมพูประกายบนแผ่นป้ายเข้ม **ขอบทอง** — ทองเป็นฮิวที่สองจริง ไม่ใช่
// ชมพูเฉดเดียว รางวงแหวนใช้เส้นขอบ/คั่นจาง rgba(156,111,8) = #9c6f08 ทองลึก
// (เป็นเส้น ไม่ใช่ตัวอักษร)
// ส่วนชื่อแบรนด์ไล่ ชมพูอ่อน #ffd1ea -> ชมพูไฮไลต์ #ff6cbb -> ชมพูแบรนด์ #ff3fa4
// ⚠️ ปลายเข้มของ "ตัวอักษร" หยุดที่ #ff3fa4 ไม่ใช่ #b3006a — #b3006a บนแผง #4a0b42
// ได้แค่ 2.2:1 ตกแม้แต่เกณฑ์ตัวอักษรใหญ่ ส่วน #ff3fa4 ได้ 4.6:1 ผ่านทั้งเกณฑ์
// ตัวใหญ่และตัวปกติ (brand-spec §2: #b3006a / #7a0046 / #4d002b / #9c6f08
// ห้ามถือตัวอักษรทุกขนาด)
// ชุดทองเป็ด-ส้มปากเป็ดของ DUCK1688 (#f3bb34 #fde464 #c8901a #8a5f08 #f58b2a
// #a3510c #f6ecd9 #1f1709 rgba(243,187,52,α) rgba(245,139,42,α)
// rgba(246,236,217,α) rgba(253,228,100,α) rgba(163,81,12,α) rgba(31,23,9,α))
// และชุดทองอวกาศ-เงินโครเมียมของ NAZA168 (#fbc134 #ffe87a #cf9a18 #cfd6e3
// #432b03 #241700 #fdf3df) ไม่เหลือแล้ว
// ⚠️ สองรอบก่อนเป็นแบรนด์ "ทอง" ทั้งคู่ รอบนี้ทองถูกลดชั้นเป็นฮิวที่สอง และฮิวนำ
// เป็นชมพูบานเย็น — ให้เทียบเป็นตัวเลข อย่าเทียบด้วยตา
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(255, 63, 164, 0.26) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(245, 197, 61, 0.2) 0%, transparent 55%), rgba(46, 0, 44, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(255, 63, 164, 0.6);
    border-radius: 1.5rem;
    background: rgba(74, 11, 66, 0.94);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.7),
      0 0 2rem rgba(255, 63, 164, 0.32);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #ffd1ea 0%, #ff6cbb 50%, #ff3fa4 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #ffd1ea 0%, #ff3fa4 55%, #b3006a 100%);
    box-shadow: 0 0 2rem rgba(255, 63, 164, 0.6);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(156, 111, 8, 0.8);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #ff3fa4;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #f5c53d;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #fde8f3;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(253, 232, 243, 0.8);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(255, 63, 164, 0.6);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(255, 209, 234, 0.45);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
