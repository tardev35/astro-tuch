---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// ยูฟ้า168 (รอบทองคานารีนำ โครเมียมเงินรอง บนธีมมืด 2026-10-22): หน้าจอคั่นตอนกดปุ่ม
// ไปลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render ตัวนี้
// ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก .claude/brand-spec-ufabet168.md §2 (โซน "โครม")
// ⚠️⚠️ **รอบนี้พื้นเพจกลับมาเป็นดำสนิท #000000 (จาก bg.json)** overlay ตัวนี้จึง
// เป็น **ดำอุ่น** ซึ่งยังต่างจากพื้นเพจเล็กน้อยและกลบหน้าข้างหลังได้สนิท
// backdrop เป็นชั้นจม rgba(10,9,8) = #0a0908 ออร่าบนเป็น **ทองคานารีแบรนด์**
// rgba(254,228,93) คู่กับ **โครเมียม** rgba(168,178,191) ด้านล่าง
// — ฮิวนำอยู่บน แผงการ์ดเป็นผิวยก rgba(21,19,15) = #15130f
// ⚠️ แผงการ์ดต้องสว่างกว่า backdrop เสมอ (#15130f ยก vs #0a0908 จม)
// ⚠️ ค่าทุกค่าในไฟล์นี้อยู่ในชุด rgba ที่ brand-spec §2 อนุญาต (254/228/93 ·
// 230/164/22 · 168/178/191 · 0/0/0) โดยตั้งใจ
// ออร์บไล่จากครีมทอง #fff8dd เข้าหาทองคานารี #fee45d แล้วจบที่ทองลึก #b8780d
// — การไล่ "อ่อนออกเข้ม" คืออ่านจากโลโก้ตรงๆ (คำว่า ยูฟ้า เป็นตัวอักษรสามมิติ
// ผิวมันวาวไล่เฉดทอง มีไฮไลต์ขาวที่ยอดและเงาทองลึกที่ฐาน)
// วงแหวนคู่หมุนสวนทางกันและแยกค่ากันจริง — วงนอก **ทองคานารี #fee45d**
// วงใน **โครเมียมกลาง #a8b2bf** ซึ่งคือสองวัสดุของโลโก้ (ตัวอักษรทอง + เลขเงิน)
// รางวงแหวนใช้เส้นคั่นจาง rgba(90,100,114,0.8) = #5a6472 (เป็นเส้น ไม่ใช่ตัวอักษร
// ค่านี้จึงใช้ได้ ทั้งที่ถือตัวอักษรไม่ได้ที่ 3.3:1)
// ส่วนชื่อแบรนด์ไล่ ขาว #ffffff -> ทองคานารี #fee45d (14.8:1 บนแผง #15130f)
// ⚠️ ปลายของ "ตัวอักษร" หยุดที่ #fee45d — **ลากลงไปถึง #7a4e05 ไม่ได้** เพราะ
// #7a4e05 ได้แค่ 2.4:1 บนแผง #15130f มันจึงเป็นพื้นถม/ขอบ/ออรา/วงแหวนเท่านั้น
// ไม่เคยถือตัวอักษรในไฟล์นี้เลย
// ⚠️ **ไฟล์นี้เพิ่งเป็นแดงเชอร์รี่-ทองแดงไหม้ของ โปรดี168 เมื่อรอบที่แล้วเป๊ะๆ**
// (eb0305 9b0a0c ff4446 b44c06 f0b46a 401107 fff4ea fff0e4 — ชุดที่เสี่ยงหลงเหลือ
// ที่สุด) ก่อนหน้านั้นเป็นแดงคริมสัน-ทองโบราณของ รวยแท้168 (c30303 8f0505 e81313
// dcb95f b8862b 4a0f0f fff1ef ffeee8) เขียวมรกต-ทองสัมฤทธิ์ของ สาธุ168
// ชมพูบานเย็นของ มีทรัพย์168 แดงชาด-ทองน้ำผึ้งของ ดวงเศรษฐี168 ทองอำพัน-บรอนซ์ของ
// ufalion168 ทองจักรพรรดิ-แดงชาดของ รวยเทพ168 แดงชาด-ทองเนยของ มีเฮ168
// ฟ้าอะซัวร์-ทองอำพันของ รวยแทร่168 ฟ้า-เหลืองของ นินจา168 ฟ้า-ทองของ สบายเบท168
// ชมพูบับเบิลกัม-ทองเนยของ ถอนชัวร์168 ทองนำ-ชมพูบานเย็นของ มีโชค168
// ทอง-โรสโกลด์ของ ขวัญใจ168 ทองไทย-แดงมังกรของ รับตัง168 แดงมังกร-ทองของ
// สมหวัง168 และทองล้วนของ TND168
// — **ทอง/เหลืองเคยผ่านไฟล์นี้มาเกือบทุกแบรนด์** การเจอ "ทอง" ในไฟล์นี้จึงไม่ได้
// แปลว่าเป็นของรอบนี้แน่ๆ ทองรอบนี้เป็น **ทองคานารี** #fee45d (+#e6a416 #b8780d)
// ส่วนสีที่สองรอบนี้คือ **โครเมียมเงิน** #e8ecf1 / #a8b2bf / #78828f / #5a6472
// ให้เทียบเป็นตัวเลขกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive — และรอบนี้ไม่มีค่า
// แดง/เขียว/ชมพู/ฟ้า/น้ำเงิน/ไซยาน/ม่วง/โรสโกลด์/ส้มสด/ทองแดงไหม้
// เหลือในไฟล์นี้เลย
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(254,228,93, 0.22) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(168,178,191, 0.14) 0%, transparent 55%), rgba(10,9,8, 0.97);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(230,164,22, 0.65);
    border-radius: 1.5rem;
    background: rgba(21,19,15, 0.96);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.7),
      0 0 2rem rgba(254,228,93, 0.28);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #ffffff 0%, #fee45d 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #fff8dd 0%, #fee45d 55%, #b8780d 100%);
    box-shadow: 0 0 2rem rgba(254,228,93, 0.5);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(90,100,114, 0.8);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #fee45d;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #a8b2bf;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #ffffff;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: #eae3d4;
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(254,228,93, 0.5);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(230,164,22, 0.45);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
