---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// GUCCI168 (รอบตรุษจีน แดง-เขียวมรกต-ทอง 2026-10-08): หน้าจอคั่นตอนกดปุ่มไป
// ลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render ตัวนี้
// ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก brand-spec §3: backdrop เป็นพื้นเกือบดำอมแดง rgba(9,3,2) ออร่าเป็น
// แดงแบรนด์ rgba(196,17,21) คู่กับเขียวมรกตจาง rgba(11,122,51) แผงการ์ดเป็นผิวยก
// rgba(29,11,8) = #1d0b08 ออร์บไล่จากทองอ่อน #ffdf91 เข้าหาแดงแบรนด์ #c41115
// แล้วจบที่แดงลึก #7a0505
// วงแหวนคู่หมุนสวนทางกันและแยก "สี" กันจริง (วงนอกแดงแบรนด์ #c41115 วงในเขียว
// มรกตสว่าง #2bbf63) ตามคู่สีของโลโก้รอบนี้โดยตรง: ตัว GUCCI ขาวเงินขอบเขียวมรกต
// ทับเลข 168 แดงขอบทอง รางวงแหวนใช้เส้นขอบ/คั่นจาง rgba(140,100,16) = ทองลึก
// ส่วนชื่อแบรนด์ไล่ ทองอ่อน -> แดงสว่าง -> เขียวมรกตสว่าง
// ชุดทอง-เงินของ UOK365 (#f5d98a #c8912f #a46b25 #6d4412 #d8dbe0 #ece1cc
// rgba(200,145,47,α) rgba(216,219,224,α) rgba(245,217,138,α) rgba(25,17,8)
// rgba(7,5,4) rgba(236,225,204,α)) ไม่เหลือแล้ว
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(196, 17, 21, 0.32) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(11, 122, 51, 0.22) 0%, transparent 55%), rgba(9, 3, 2, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(196, 17, 21, 0.55);
    border-radius: 1.5rem;
    background: rgba(29, 11, 8, 0.94);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.7),
      0 0 2rem rgba(196, 17, 21, 0.28);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #ffdf91 0%, #e0201f 50%, #2bbf63 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #ffdf91 0%, #c41115 55%, #7a0505 100%);
    box-shadow: 0 0 2rem rgba(196, 17, 21, 0.55);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(140, 100, 16, 0.7);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #c41115;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #2bbf63;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #f6e3cf;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(246, 227, 207, 0.8);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(196, 17, 21, 0.55);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(255, 223, 145, 0.45);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
