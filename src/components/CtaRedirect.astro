---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// TKB55 (รอบแดงเลือดนก-เงินโครเมียม 2026-10-13): หน้าจอคั่นตอนกดปุ่มไป
// ลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render ตัวนี้
// ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก .claude/brand-spec-tkb55.md §2: backdrop เป็นแดงเกือบดำจม
// rgba(13,3,4) = #0d0304 (พื้นเพจรอบนี้เป็นดำสนิท #000000 backdrop จึงเสมอกัน
// กับพื้นแทบทั้งหมด — ความต่างมาจากออร่าสองจุดแทน) ออร่าบนเป็นแดงแบรนด์
// rgba(251,19,27) คู่กับแดงสว่าง rgba(255,77,85) ด้านล่าง แผงการ์ดเป็นผิวยก
// rgba(42,13,15) = #2a0d0f
// ⚠️ แผงการ์ดต้องสว่างกว่า backdrop เสมอ
// ออร์บไล่จากเงินโครเมียม #e9eef4 เข้าหาแดงอ่อน #ff8a8f แล้วจบที่แดงแบรนด์
// #fb131b (ออร์บเป็นรูปทรง ไม่ใช่ตัวอักษร #fb131b จึงใช้ได้ตรงนี้) — การไล่
// "เงินเข้าแดง" คือแบรนด์สองโทนของรอบนี้อ่านจากโลโก้ตรงๆ (ตัวอักษร TKB แดงสด
// + เลข 55 เงินโครเมียม)
// วงแหวนคู่หมุนสวนทางกันและแยก "โทน" กันจริง — วงนอกแดงแบรนด์ #fb131b วงในเงิน
// โครเมียม #e9eef4 ต่างจากรอบก่อน (TSDET911) ที่เป็นฟ้าสดคู่เงินโครเมียม
// รางวงแหวนใช้เส้นคั่นจาง rgba(138,2,6,0.8) = #8a0206 แดงลึกสุด (เป็นเส้น
// ไม่ใช่ตัวอักษร) ส่วนชื่อแบรนด์ไล่ เงินโครเมียม #e9eef4 -> แดงอ่อน #ff8a8f ->
// แดงสว่าง #ff4d55
// ⚠️ ปลายเข้มของ "ตัวอักษร" หยุดที่ #ff4d55 ไม่ใช่ #fb131b หรือ #c40304 —
// #fb131b บนแผง #2a0d0f ได้ ~4.4:1 และ #c40304 ได้ ~2.6:1 ส่วน #ff4d55 ได้
// ~5.6:1 ผ่าน AA สำหรับข้อความปกติด้วยซ้ำ
// (brand-spec §2: #fb131b / #c40304 / #8a0206 / #53050a ห้ามถือตัวอักษรทุกขนาด)
// ⚠️ ไฟล์นี้เคยเป็นน้ำเงิน-เงินของ TSDET911 ก่อนหน้านั้นเป็นม่วง-ทองของ KMD88
// และก่อนหน้านั้นเป็นทองล้วนของ TND168 — แต่ก่อนหน้านั้นอีกมีแบรนด์แดงอยู่จริง
// (FLASH877 / PIGPG / SUPERSLOTCLUB) การเจอแดงในไฟล์แนวนี้จึงไม่ได้แปลว่าเป็น
// ของรอบนี้ ให้เทียบเป็นตัวเลขกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive —
// และรอบนี้ไม่มีค่าทอง/ม่วง/ชมพู/เขียว/น้ำเงิน/ฟ้า/ส้มเหลืออยู่ในไฟล์นี้เลย
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(251, 19, 27, 0.3) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(255, 77, 85, 0.18) 0%, transparent 55%), rgba(13, 3, 4, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(251, 19, 27, 0.65);
    border-radius: 1.5rem;
    background: rgba(42, 13, 15, 0.94);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.7),
      0 0 2rem rgba(251, 19, 27, 0.38);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #e9eef4 0%, #ff8a8f 50%, #ff4d55 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #e9eef4 0%, #ff8a8f 55%, #fb131b 100%);
    box-shadow: 0 0 2rem rgba(251, 19, 27, 0.6);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(138, 2, 6, 0.8);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #fb131b;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #e9eef4;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #f2e4e5;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(242, 228, 229, 0.8);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(251, 19, 27, 0.6);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(255, 77, 85, 0.45);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
