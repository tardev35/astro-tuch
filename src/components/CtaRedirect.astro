---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// ดวงเศรษฐี168 (รอบแดงชาดจีนนำ-ทองน้ำผึ้งรอง บนพื้นดำสนิท 2026-10-20): หน้าจอคั่น
// ตอนกดปุ่มไปลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ
// render ตัวนี้ ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// สีทุกค่ามาจาก .claude/brand-spec-duangsetthi168.md §2: backdrop เป็นชั้นจม
// rgba(21,3,3) = #150303 (พื้นเพจรอบนี้เป็น **ดำสนิท #000000** จาก bg.json
// backdrop จึงจมกว่าพื้นไม่ได้ แต่ยังอ่านออกว่าเป็นชั้นทับเพราะมีออร่าสองวงและ
// แผงการ์ดสว่างกว่าอย่างชัดเจน) ออร่าบนเป็น **แดงชาดแบรนด์** rgba(217,33,42)
// คู่กับ **ทองน้ำผึ้ง** rgba(240,200,120) ด้านล่าง — ฮิวนำอยู่บน สีรองอยู่ล่าง
// แผงการ์ดเป็นผิวยก rgba(78,33,32) = #4e2120
// ⚠️ แผงการ์ดต้องสว่างกว่า backdrop เสมอ (#4e2120 ยก vs #150303 จม)
// ออร์บไล่จากทองน้ำผึ้ง #f0c878 เข้าหาแดงชาด #d9212a แล้วจบที่แดงเลือดหมู
// #8e1a16 — การไล่ "ทองออกแดง" คืออ่านจากโลโก้ตรงๆ (คำว่า ดวงเศรษฐี เป็นตัวอักษร
// ผิวทองมันวาว ส่วนเลข 168 เป็นแดงสดขลิบทอง)
// วงแหวนคู่หมุนสวนทางกันและแยกฮิวกันจริง — วงนอก **แดงชาด #d9212a**
// วงใน **ทองน้ำผึ้ง #f0c878** (วงแหวนเป็นเส้นตกแต่ง ไม่ใช่ตัวอักษร)
// รางวงแหวนใช้เส้นคั่นจาง rgba(142,26,22,0.8) = #8e1a16 แดงเลือดหมู (เป็นเส้น
// ไม่ใช่ตัวอักษร) ส่วนชื่อแบรนด์ไล่ งาช้าง #fff8d8 -> ทองน้ำผึ้ง #f0c878
// ⚠️ ปลายเข้มของ "ตัวอักษร" หยุดที่ #f0c878 (8.5:1 บนแผง #4e2120) — **ลากลงไป
// ถึงแดงไม่ได้ทั้งสองเฉด** #d9212a ได้ 2.7:1 และ #8e1a16 ต่ำกว่านั้น ทั้งคู่จึง
// เป็นพื้นถม/ขอบ/ออรา/วงแหวนเท่านั้น ไม่เคยถือตัวอักษรในไฟล์นี้เลย
// ไล่เฉดชื่อแบรนด์จึงมีสองสต็อป ไม่ใช่สาม เพราะรอบนี้ไม่มีสีที่สามที่ถือตัวอักษรได้
// (brand-spec §2: #d9212a และ #8e1a16 ห้ามถือตัวอักษรทุกขนาด)
// ⚠️ **ไฟล์นี้เพิ่งเป็นทองอำพัน-ทองเลมอนของ ufalion168 เมื่อรอบที่แล้วเป๊ะๆ**
// ก่อนหน้านั้นเป็นทองจักรพรรดิ-แดงชาดของ รวยเทพ168 แดงชาด-ทองเนยของ มีเฮ168
// ฟ้าอะซัวร์-ทองอำพันของ รวยแทร่168 ฟ้า-เหลืองของ นินจา168 ฟ้า-ทองของ สบายเบท168
// ชมพูบับเบิลกัมนำ-ทองเนยรองของ ถอนชัวร์168 ทองนำ-ชมพูบานเย็นของ มีโชค168
// ทอง-โรสโกลด์ของ ขวัญใจ168 ทองไทย-แดงมังกรของ รับตัง168 แดงมังกร-ทองของ
// สมหวัง168 แดงมังกร-โครเมียมขาวของ GT66B แดงเลือดนก-เงินของ TKB55
// **น้ำเงิน-เงินของ TSDET911** ม่วง-ทองของ KMD88 และทองล้วนของ TND168 —
// **เกือบทุกแบรนด์ที่ผ่านไฟล์นี้มีทอง และมีเจ็ดแบรนด์ที่แดงนำ**
// การเจอ "ทอง" หรือ "แดง" ในไฟล์นี้จึงไม่ได้แปลว่าเป็นของรอบนี้แน่ๆ
// แดงรอบนี้คือ #d9212a (+#8e1a16) และทองรอบนี้คือ #f0c878 ส่วนตัวอักษรเป็น
// #fff8d8 — ให้เทียบเป็นตัวเลขกับตารางใน brand-spec §2 ซึ่งไม่พิมพ์ซ้ำที่นี่
// เพื่อไม่ให้ grep หาสีของแบรนด์เก่าเจอ false positive — และรอบนี้ไม่มีค่า
// ฟ้า/น้ำเงิน/ไซยาน/ม่วง/เขียว/เงินโครเมียม/โรสโกลด์/ชมพูฟูเชีย/ส้มสด/บรอนซ์
// เหลือในไฟล์นี้เลย (บรอนซ์เป็นสีที่สามของ ufalion168 รอบก่อน)
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(217,33,42, 0.28) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(240,200,120, 0.18) 0%, transparent 55%), rgba(21,3,3, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(240,200,120, 0.65);
    border-radius: 1.5rem;
    background: rgba(78,33,32, 0.94);
    box-shadow:
      0 1rem 3rem rgba(0, 0, 0, 0.7),
      0 0 2rem rgba(217,33,42, 0.38);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #fff8d8 0%, #f0c878 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #f0c878 0%, #d9212a 55%, #8e1a16 100%);
    box-shadow: 0 0 2rem rgba(217,33,42, 0.6);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(142,26,22, 0.8);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #d9212a;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #f0c878;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #fff8d8;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(255,248,216, 0.8);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(217,33,42, 0.6);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(240,200,120, 0.45);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
