---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// UP555 (รอบทอง + เงินโครเมียม บนดำอมน้ำตาล 2026-10-03): หน้าจอคั่นตอนกดปุ่มไป
// ลิงก์พันธมิตร แสดงเฉพาะ /login กับ /register — ไม่มีไฟล์อื่นในเว็บ render ตัวนี้
// ถ้าไม่ retheme ผู้ใช้จะเห็นสีของแบรนด์ก่อนบนจอที่กำลัง convert พอดี
// backdrop เป็นพื้นลึกสุด rgba(12,5,2) = #0c0502 แผงการ์ดเป็นพื้นการ์ด rgba(19,11,3)
// = #130b03 ออร่าเป็นทองแบรนด์ rgba(235,187,84) กับเงินโครเมียม rgba(213,212,211)
// ออร์บไล่จากทองสว่าง #fce675 เข้าหาทองแบรนด์ #ebbb54 แล้วจบที่ทองลึก #ab6d24
// วงแหวนคู่หมุนสวนทางกันและแยก "สี" กันจริง (วงนอกทอง #ebbb54 วงในเงิน #d5d4d3)
// เพราะแบรนด์รอบนี้คือทองนำ-เงินรอง: โลโก้มีตัว U/UP เป็นเงินโครเมียมและเลข 555
// เป็นทอง รางวงแหวนใช้เส้นขอบทองลึก rgba(107,69,23) = #6b4517 ส่วนชื่อแบรนด์ไล่
// สองโทนของโลโก้จริง เงินโครเมียม -> ทองสว่าง -> ทองลึก
// ชุดเขียว-แดงของ DM899 (#01a326 #4ade6b #12c23a #fb252b #030a05 #0a1a0e #0a4a18
// #ffe9a8 rgba(1,163,38) rgba(251,37,43) rgba(3,10,5) rgba(10,26,14) rgba(10,74,24)
// rgba(74,222,107) rgba(228,242,228)) ไม่เหลือแล้ว
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(235, 187, 84, 0.32) 0%, transparent 55%), radial-gradient(circle at 50% 90%, rgba(213, 212, 211, 0.18) 0%, transparent 55%), rgba(12, 5, 2, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(235, 187, 84, 0.5);
    border-radius: 1.5rem;
    background: rgba(19, 11, 3, 0.94);
    box-shadow:
      0 1rem 3rem rgba(12, 5, 2, 0.6),
      0 0 2rem rgba(235, 187, 84, 0.24);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #d5d4d3 0%, #fce675 50%, #ab6d24 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #fce675 0%, #ebbb54 55%, #ab6d24 100%);
    box-shadow: 0 0 2rem rgba(235, 187, 84, 0.5);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(107, 69, 23, 0.6);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #ebbb54;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #d5d4d3;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #fce675;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(248, 238, 217, 0.78);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(235, 187, 84, 0.5);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(252, 230, 117, 0.45);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
