---
import { BRAND_NAME } from "../lib/brandProfile";

interface Props {
  label: string;
}

const { label } = Astro.props;

// CK268 (รอบเขียวนีออน-โครเมียม-ดำ 2026-09-30): หน้าจอคั่นตอนกดปุ่มไปลิงก์พันธมิตร
// แสดงเฉพาะ /login กับ /register — พื้นหลังดำ rgb(0,0,0) แผงการ์ดดำอมเขียว
// rgba(11,22,11) ออร่าเป็นเขียวนีออนแบรนด์ rgba(139,252,19) กับเขียวลึกรอง
// rgba(18,160,8) ออร์บไล่จากโครเมียมขาว #e8f0e6 เข้าหาเขียวนีออน #8bfc13 แล้วจบ
// ที่เขียวลึก #1a7a08 วงแหวนคู่แยกสีกันคนละวง (วงนอกเขียวนีออน วงในโครเมียม)
// หมุนสวนทางกัน ตามคู่สีของโลโก้ที่ตัว C กับเลข 68 เป็นโครเมียมขาวเงิน และตัว K
// กับเลข 2 เป็นเขียวนีออน บนอาร์ตเวิร์กพื้นดำที่มีริ้วแสงเขียวกับชิปคาสิโนเขียว-ดำ
// — ชุดทอง/แดงของ GOT777 (#f5c518 #fff6dd #d21622 #160b06 #ffe9a8 #ece0cb)
// ไม่เหลือแล้ว
// แก้เฉพาะสีใน <style> เท่านั้น — markup, จังหวะเวลา และ <script> คงเดิม
// เพราะ data-cta-redirect บน <a> คือสิ่งที่สคริปต์ผูกไว้
---

<div class="cta-redirect" data-cta-overlay hidden>
  <div class="panel" role="status" aria-live="polite">
    <p class="brand">{BRAND_NAME}</p>

    <div class="loader" aria-hidden="true">
      <span class="orb"></span>
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>

    <p class="hd">กำลังเชื่อมต่อ</p>
    <p class="sub">กำลังพาไปหน้า{label} {BRAND_NAME} <span aria-hidden="true">🔒</span></p>
  </div>
</div>

<style>
  .cta-redirect {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(139, 252, 19, 0.30) 0%, transparent 55%),
      radial-gradient(circle at 50% 90%, rgba(18, 160, 8, 0.20) 0%, transparent 55%),
      rgba(0, 0, 0, 0.96);
    animation: cta-fade 0.25s ease-out both;
  }

  .cta-redirect[hidden] {
    display: none;
  }

  .panel {
    width: 100%;
    max-width: 420px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid rgba(139, 252, 19, 0.55);
    border-radius: 1.5rem;
    background: rgba(11, 22, 11, 0.94);
    box-shadow:
      0 1rem 3rem rgba(1, 4, 1, 0.6),
      0 0 2rem rgba(139, 252, 19, 0.22);
  }

  .brand {
    margin: 0 0 2rem 0;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    background: linear-gradient(180deg, #e8f0e6 0%, #8bfc13 50%, #1a7a08 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .loader {
    position: relative;
    display: flex;
    width: 100px;
    height: 100px;
    margin: 0 auto 2.5rem auto;
    align-items: center;
    justify-content: center;
  }

  .orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, #e8f0e6 0%, #8bfc13 45%, #1a7a08 100%);
    box-shadow: 0 0 2rem rgba(139, 252, 19, 0.55);
    animation: cta-pulse 2s ease-in-out infinite;
  }

  .ring {
    position: absolute;
    border: 3px solid rgba(6, 40, 3, 0.6);
    border-radius: 50%;
    animation: cta-spin linear infinite;
  }

  .ring-1 {
    width: 100%;
    height: 100%;
    border-top-color: #8bfc13;
    animation-duration: 4s;
  }

  .ring-2 {
    width: 80%;
    height: 80%;
    border-bottom-color: #e8f0e6;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  .hd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #c9ff8f;
  }

  .sub {
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(213, 230, 205, 0.75);
  }

  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 2rem rgba(139, 252, 19, 0.55);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 3rem rgba(18, 160, 8, 0.45);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-redirect,
    .orb,
    .ring {
      animation: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-cta-overlay]");
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-cta-redirect]");

  if (overlay && links.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        overlay.hidden = false;

        const go = () => window.location.assign(link.href);
        if (reduced) go();
        else window.setTimeout(go, 1500);
      });
    }

    window.addEventListener("pageshow", () => {
      overlay.hidden = true;
    });
  }
</script>
