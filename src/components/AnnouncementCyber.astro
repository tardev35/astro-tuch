---
// The default is what every bare <Announcement /> on a sub-page renders, so it
// must be the CURRENT brand's copy — index.astro also passes an explicit
// message, and the two are kept in step deliberately.
const {
  message = "JAIDEE928 สล็อตใจดีเว็บแท้ จ่ายตรง ไม่ผ่านเอเยนต์ รวมค่ายเกมฮิตครบทุกแบรนด์ในบัญชีเดียว • โปรโมชั่นคืนยอดเสีย รับโบนัสสูงสุด 0.3% ทุกวัน • แนะนำเพื่อนรับโบนัสสูงสุด 0.8% ถอนได้จริงไม่อั้น • ระบบฝากถอนอัตโนมัติเข้าไว พร้อมแอดมิน JAIDEE928 ดูแลตลอด 24 ชั่วโมง",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div
    class="relative flex overflow-hidden border border-[#a855f7]/50 bg-[#0d0616]/90 shadow-[0_0_15px_rgba(168,85,247,0.3)] backdrop-blur-md"
    style="clip-path: polygon(15px 0, 100% 0, calc(100% - 15px) 100%, 0 100%);">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center bg-gradient-to-r from-[#4c1095] to-[#d8a7ff] px-6 py-2.5 font-black text-[#0d0616]"
      style="clip-path: polygon(0 0, 100% 0, calc(100% - 10px) 100%, 0 100%);">
      ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#0d0616] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-widest whitespace-nowrap text-[#f3ecfb]">
        <span class="mr-8 inline-flex items-center gap-2"><span class="h-2 w-2 bg-[#a855f7] shadow-[0_0_8px_rgba(168,85,247,1)]"></span>{message}</span>
        <span class="mr-8 inline-flex items-center gap-2"><span class="h-2 w-2 bg-[#a855f7] shadow-[0_0_8px_rgba(168,85,247,1)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 20s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
</style>
