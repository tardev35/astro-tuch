---
import { BRAND_NAME } from "../lib/brandProfile";

// BOOM369 (รอบเขียวนีออนบนดำ 2026-10-07): ticker ที่ใช้งานจริงรอบนี้ — รอบก่อน
// HI59 ใช้ Announcement2 ไฟล์นี้เคยเป็นของ หวย365 โทนแดงสด-ทองบนแดงเกือบดำ
// ตอนนี้ย้ายมาเป็นแคปซูลพื้นเขียวเกือบดำ #041109 ขอบเขียวนีออน #42fb5a ป้าย
// "ประกาศ" ไล่เฉดเขียวแบรนด์ #04ab3a → เขียวนีออน #42fb5a (หมึก #03150a ได้
// 6.3:1 ที่ปลายเข้มสุดของเฉด และ 13.9:1 ที่ปลายสว่าง จึงผ่าน AA ตลอดแนว)
// จุดนำหน้าเป็นเขียวนีออน #42fb5a กับเงินโครเมียม #dadcdc เนื้อความ #cfe9d7
// ชุดแดง-ทองของ หวย365 (#dc0203 #ffc93c #180303 #1a0303 #c08a07 #ffeab0
// #f6e7e0) ออกครบทุกจุดแล้ว
//
// ทุกหน้าในเว็บเรียก <Announcement /> แบบไม่ส่ง prop ข้อความที่วิ่งจริงจึงเป็น
// default ตัวนี้ — ต้องเป็นคำของแบรนด์ปัจจุบันเสมอ ชื่อแบรนด์มาจาก BRAND_NAME
// ไม่พิมพ์ทับ (/ตรวจหวย และ /แนวทาง ที่ใช้ AnnouncementHuay ของตัวเองไม่มี route
// รอบนี้ — BOOM369 เป็นเว็บสล็อต สองหน้านั้นถูก park ไว้ใน src/pages-disabled/)
//
// ไม่มีอิโมจินำหน้าข้อความ: marquee พิมพ์สตริงนี้สองรอบ และอิโมจิที่ฝังอยู่ใน
// text prop ใส่ <span aria-hidden> ให้ตัวเองไม่ได้ สำเนารอบที่สองถูก aria-hidden
// ทั้งก้อน เพื่อไม่ให้โปรแกรมอ่านหน้าจออ่านประกาศซ้ำสองครั้ง
//
// เนื้อหาทุกท่อนมาจาก src/assets/content.txt เท่านั้น — เว็บสล็อตเบทต่ำ ไม่มี
// ใบอนุญาต ไม่มีชื่อค่ายเกม ไม่มีชื่อธนาคาร ไม่มียอดฝากขั้นต่ำ และไม่มีตัวเลข
// นอกชุดที่บรีฟระบุ (0.3% · 0.8% · 100% · 3 ขั้นตอน · 24 ชั่วโมง) คำเฮดจ์ของ
// บรีฟเรื่อง "ไม่มีขั้นต่ำ ควรอ้างอิงจากเกมที่เปิดให้บริการจริง" ติดมาด้วยโดยตั้งใจ
const {
  message = `${BRAND_NAME} สุดยอดเกมสล็อตเบทต่ำ รวบรวมเกมหลายรูปแบบไว้ในระบบเดียว ทั้งสล็อตคลาสสิก ฟรีสปิน โบนัส ตัวคูณ และสล็อตเปิดใหม่จากค่ายที่ระบบรองรับ • มีเกมเบทต่ำให้เลือก เหมาะกับผู้ที่มีทุนน้อยและต้องการแบ่งงบเล่นเป็นรอบ • คำว่า ไม่มีขั้นต่ำ ควรอ้างอิงจากเกมที่เปิดให้บริการจริง เพราะแต่ละค่ายกำหนดยอดเดิมพันต่ำสุดไม่เท่ากัน จึงควรยึดตัวเลขที่แสดงภายในเกมเป็นหลักและกำหนดงบก่อนเล่นทุกครั้ง • โปรโมชั่นหลักตามข้อมูลที่กำหนดคือ คืนยอดเสีย 0.3% และ แนะนำเพื่อน 0.8% ซึ่งมีเกณฑ์คำนวณและรอบรับสิทธิ์แตกต่างกัน • สมัครผ่านมือถือได้ใน 3 ขั้นตอน และติดต่อแอดมิน ${BRAND_NAME} ได้ตลอด 24 ชั่วโมง`,
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div
    class="relative flex overflow-hidden border border-[#42fb5a]/50 bg-[#041109]/90 shadow-[0_0_15px_rgba(66,251,90,0.3)] backdrop-blur-md"
    style="clip-path: polygon(15px 0, 100% 0, calc(100% - 15px) 100%, 0 100%);">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center bg-gradient-to-r from-[#04ab3a] to-[#42fb5a] px-6 py-2.5 font-black text-[#03150a]"
      style="clip-path: polygon(0 0, 100% 0, calc(100% - 10px) 100%, 0 100%);">
      ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#041109] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-widest whitespace-nowrap text-[#cfe9d7]">
        <span class="mr-8 inline-flex items-center gap-2"><span aria-hidden="true" class="h-2 w-2 bg-[#42fb5a] shadow-[0_0_8px_rgba(66,251,90,1)]"></span>{message}</span>
        <span aria-hidden="true" class="mr-8 inline-flex items-center gap-2"><span class="h-2 w-2 bg-[#dadcdc] shadow-[0_0_8px_rgba(218,220,220,0.9)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 20s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
</style>
