---
const {
  message = "JEDI66 แบรนด์เกมสล็อต เข้าเล่นผ่านมือถือและเว็บเบราว์เซอร์ • รองรับทุกเครือข่าย • แนะนำเพื่อนรับโบนัส 0.8% • คืนยอดเสียทุกวันสูงถึง 0.3%",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div
    class="relative flex overflow-hidden border border-[#0ea5e9]/50 bg-[#0a1220]/90 shadow-[0_0_15px_rgba(14,165,233,0.3)] backdrop-blur-md"
    style="clip-path: polygon(15px 0, 100% 0, calc(100% - 15px) 100%, 0 100%);">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center bg-gradient-to-r from-[#075985] to-[#38bdf8] px-6 py-2.5 font-black text-[#051022]"
      style="clip-path: polygon(0 0, 100% 0, calc(100% - 10px) 100%, 0 100%);">
      ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#0a1220] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-widest whitespace-nowrap text-[#e0f2fe]">
        <span class="mr-8 inline-flex items-center gap-2"><span class="h-2 w-2 bg-[#e2e8f0] shadow-[0_0_8px_rgba(226,232,240,1)]"></span>{message}</span>
        <span class="mr-8 inline-flex items-center gap-2"><span class="h-2 w-2 bg-[#e2e8f0] shadow-[0_0_8px_rgba(226,232,240,1)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 20s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
</style>
