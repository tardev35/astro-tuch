---
// The default is what every bare <Announcement /> on a sub-page renders, so it
// must be the CURRENT brand's copy — index.astro also passes an explicit
// message, and the two are kept in step deliberately.
//
// No leading emoji: the marquee prints the string twice, and an emoji baked
// into a text prop cannot be given its own aria-hidden span.
const {
  message = "KINGDOM66 เล่นบาคาร่าฟรีเครดิต รวมเกมคาสิโน ไพ่ สล็อต หวย บอล ไว้ในบัญชีเดียว • เกมไลฟ์สดส่งตรงจากผู้ให้บริการต่างประเทศตามรายการที่เปิดให้บริการ • รองรับการใช้งานทั้งบนมือถือและคอมพิวเตอร์ • Login แล้วเลือกหมวดเกมที่สนใจได้ทันที พร้อมตรวจสอบค่ายที่ให้บริการและรูปแบบเดิมพันก่อนเข้าเล่น • โปรโมชั่นแนะนำเพื่อน โบนัส 0.8% และโปรโมชั่นคืนยอดเสีย โบนัส 0.3% ตามเงื่อนไขและรอบคำนวณที่กำหนด ควรตรวจสอบรายละเอียดก่อนกดรับทุกครั้ง • แอดมิน KINGDOM66 ดูแลผ่าน LINE OFFICIAL ตลอด 24 ชั่วโมง",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div
    class="relative flex overflow-hidden border border-[#e6bf4e]/50 bg-[#0c0b09]/90 shadow-[0_0_15px_rgba(230,191,78,0.3)] backdrop-blur-md"
    style="clip-path: polygon(15px 0, 100% 0, calc(100% - 15px) 100%, 0 100%);">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center bg-gradient-to-r from-[#5c4113] to-[#f2d683] px-6 py-2.5 font-black text-[#0c0b09]"
      style="clip-path: polygon(0 0, 100% 0, calc(100% - 10px) 100%, 0 100%);">
      ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#0c0b09] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-widest whitespace-nowrap text-[#fdf6e0]">
        <span class="mr-8 inline-flex items-center gap-2"><span class="h-2 w-2 bg-[#e6bf4e] shadow-[0_0_8px_rgba(230,191,78,1)]"></span>{message}</span>
        <span class="mr-8 inline-flex items-center gap-2"><span class="h-2 w-2 bg-[#e6bf4e] shadow-[0_0_8px_rgba(230,191,78,1)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 20s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
</style>
