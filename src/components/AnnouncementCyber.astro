---
const {
  message = "ASKYOUWIN888 เกมคาสิโนเว็บแท้ ไม่ติดลิขสิทธิ์ รวมบาคาร่า รูเล็ต เสือมังกร และสล็อตไว้ในบัญชีเดียว • แนะนำเพื่อนแค่แชร์ลิงก์ รับโบนัส 0.8% ตามเงื่อนไข • สมาชิกใหม่รับโบนัสฝากแรกแบบออโต้ ไม่มีขั้นต่ำ • ฝากถอนออโต้ ตรวจสอบสถานะรายการเองได้ตลอด 24 ชั่วโมง",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div
    class="relative flex overflow-hidden border border-[#2f7bf6]/50 bg-[#020b24]/90 shadow-[0_0_15px_rgba(47,123,246,0.3)] backdrop-blur-md"
    style="clip-path: polygon(15px 0, 100% 0, calc(100% - 15px) 100%, 0 100%);">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center bg-gradient-to-r from-[#1d5fd6] to-[#7db4ff] px-6 py-2.5 font-black text-[#04122e]"
      style="clip-path: polygon(0 0, 100% 0, calc(100% - 10px) 100%, 0 100%);">
      ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#020b24] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-widest whitespace-nowrap text-[#e6edf7]">
        <span class="mr-8 inline-flex items-center gap-2"><span class="h-2 w-2 bg-[#2f7bf6] shadow-[0_0_8px_rgba(47,123,246,1)]"></span>{message}</span>
        <span class="mr-8 inline-flex items-center gap-2"><span class="h-2 w-2 bg-[#2f7bf6] shadow-[0_0_8px_rgba(47,123,246,1)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 20s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
</style>
