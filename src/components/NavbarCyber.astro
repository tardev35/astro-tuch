---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
const currentPath = Astro.url.pathname;
const isActive = (path: string) => isActivePath(currentPath, path);

// นาซ่า168 (รอบฟ้าไซยานไฟฟ้านำ-น้ำเงินอุลตรามารีนรอง บนถ่านเกือบดำ): navbar ที่ใช้งาน
// จริงรอบนี้ — รอบก่อน ร่ำรวย168 ใช้ NavbarStyle6 (แท็บโลโก้ห้อยลงมาจากขอบบนกลางจอ
// บวกรางเมนูแนวตั้งลอยติดขอบซ้าย fixed w-[92px] h-[640px] บนเดสก์ท็อป) ไฟล์นี้เป็น
// แถบแนวนอน sticky สูง 80px เต็มความกว้างที่ **ตัดมุมล่างซ้ายด้วย clip-path polygon**
// แล้วเลื่อนแผงเมนูลงมาจากใต้แถบบนมือถือ — คนละทรงกันชัดเจน
// ทรง "ตัดมุมเฉียง" รอบนี้เลือกมาเพราะเป็น **ภาษาของแผงควบคุมยานอวกาศและช่องหน้าต่าง
// ยาน** ซึ่งเข้ากับธีมอวกาศของแบรนด์นี้โดยตรง — ไม่ใช่เลือกเพราะโทนไซเบอร์พังก์
// **ห้ามใส่ภาษามอนอสเปซ/สแลชสามตัว/SYSTEM_/เส้นสแกนนีออนเข้ามา**
// และ **ห้ามใส่ภาษานินจา (ชูริเคน ผ้าคาดหัว ใบมีด) ซึ่งเป็นของเจ้าของธีมเดิมของไฟล์นี้**
//
// พาเลตต์ตาม .claude/brand-spec-naza168.md §2: แถบพื้นถ่าน #121722
// ขอบล่างและเงาเป็นฟ้าไซยานแบรนด์ #1fd8f0 ลิงก์ปกติ #e6edf8 โปร่ง ลิงก์ที่ hover
// เป็นน้ำแข็งอ่อน #8fd9ec ลิงก์ที่ active เป็นฟ้าไซยาน #1fd8f0 พร้อมขีดใต้ไล่
// ฟ้าไซยาน #1fd8f0 → น้ำเงินอุลตรามารีน #1d4fd8 — มาจากโลโก้ตรงๆ ที่ "นาซ่า" เป็น
// ตัวอักษรสามมิติไล่เฉดฟ้าไซยานลงน้ำเงิน และไฟสีฟ้าบนขอบหมวกนักบินอวกาศ
//
// 🚨🚨 **กับดักของไฟล์นี้หนักที่สุดในรอบนี้: ธีมเดิมของมันคือ "ฟ้าไซยานบนเกือบดำ"
// (นินจา168) ซึ่งเป็นทิศเดียวกับรอบนี้เป๊ะ และรอบก่อนทันที (ร่ำรวย168) ก็ฟ้านำ
// เหมือนกันอีก** การเจอ "ฟ้า" ในไฟล์นี้จึงไม่พิสูจน์อะไรเลย ต้องเทียบค่า:
//   ฟ้ารอบนี้ #1fd8f0 / #0bb6d4 / #8fd9ec และน้ำเงิน #1d4fd8 / #143aa0
//   — ไม่ใช่ 32bcfb/a9e9ff/07335f/071a28/030e16/041019/dceefc (นินจา168 — เจ้าของเดิม)
//   — ไม่ใช่ 18a5e2/0d6b9b/0a5176/a9d7f2/111a3f/202a66/31408a/e9f1ff/adc0e4
//     (ร่ำรวย168 — **รอบก่อนทันที เสี่ยงหลงเหลือสูงสุด**)
//   — ไม่ใช่ 2cc3fc/6bdcfb (สบาย168 ⚠️ 6bdcfb ห่างจากค่า vivid ดิบของโลโก้รอบนี้
//     64eefc แค่ R7/G18/B1 ซึ่งเป็นเหตุผลที่รอบนี้ไม่ใช้ค่าดิบ)
//   — ไม่ใช่ 039cfa/0494f5 (รวยแทร่168) 2f9ff5/a8dcff/0b3f78 (สบายเบท168)
//     0360f3/0292fb/6ec8ff/4fb4ff (TSDET911) 0a84e0/04203f/e4f1fd (HI59)
// ⚠️ **ชุดทองอวกาศ-เงินโครเมียมของ NAZA168 ตัวละติน ที่เคยอยู่ในไฟล์นี้**
//   (fbc134 ffe87a cf9a18 96690a d9c9a6 cfd6e3 241700 1a1000 432b03 231500)
//   **ห้ามกลับเข้ามาแม้แต่ค่าเดียว** — NAZA168 เป็นลูกค้าคนละเจ้าที่ชื่อออกเสียง
//   เหมือนรอบนี้และใช้ธีมอวกาศเหมือนกันเป๊ะ ถ้าทองกลับมา เว็บสองเจ้าจะกลายเป็น
//   เว็บเดียวกันทันที — นี่คือเหตุผลที่รอบนี้ไม่มีทอง/เหลือง/เทาเงินเลยสักเฉด
// ⚠️ เหลืองมะนาว fef54b/6b5c10 ของนินจา168 ก็ออกไปแล้วเช่นกัน
// (เขียนเฮกซ์เก่าแบบไม่มี # เพื่อให้ sweep ที่ไล่หาสีแบรนด์เก่าไม่สะดุดที่คอมเมนต์)
//
// ตรวจค่าคอนทราสต์ใหม่ทั้งชุดแล้ว ไม่ได้ยกคลาสข้ามปุ่ม:
//   #e6edf8 บนแถบ #121722 ≈ 15.2:1 · #8fd9ec ≈ 11.4:1 · #1fd8f0 ≈ 10.5:1
//   หมึก #0d1017 บนพื้นถมฟ้า #1fd8f0 ≈ 10.9:1 และบนปลายอ่อน #8fd9ec ≈ 12.0:1
//   ผ่าน AA ตลอดแนวไล่เฉด
// ⚠️ ปลายเข้มของไล่เฉดปุ่มสมัครหยุดที่ #1fd8f0 ห้ามลากลงไปถึง #1d4fd8 —
// ค่านั้นรองหมึก #0d1017 ได้แค่ ~2.9:1 ซึ่งตก AA และ brand-spec §2 ระบุว่า
// #1d4fd8 เป็นเส้น/ขอบ/ออรา/พื้นถมเท่านั้น ห้ามถือตัวอักษรทุกขนาด
// ⚠️ และ **ห้ามใส่ตัวอักษรขาวบน #1fd8f0** (1.7:1) — ปุ่มเน้นต้องเป็นหมึกถ่านเสมอ
// ปุ่มสองตัวจึงต่างกันที่ "พื้นฟ้าตัน vs กรอบฟ้าโปร่ง" ไม่ใช่สองระดับของสีเดียว
//
// One array for both the desktop bar and the mobile drawer — editing it in two
// places is how a menu ends up disagreeing with itself.
//
// Order: หน้าแรก first, then โปรโมชั่น, then the two conversion actions
// (สมัครสมาชิก / เข้าสู่ระบบ), then the pages that are there to be read.
// /register and /login are real button pages on this brand, so ทางเข้า has no
// menu entry — it would be a third link to the same two destinations. The page
// itself stays routed and indexed (footer ยังลิงก์ไปได้ตามปกติ)
// /ตรวจหวย and /แนวทาง are absent on purpose: นาซ่า168 is a slot brand, so both
// files stay parked in src/pages-disabled/ and the routes do not exist —
// linking either would be a dead href the build fails on.
// ⚠️ ไอคอน 🛰️ ของ "เกี่ยวกับเรา" เลือกให้เข้ากับธีมอวกาศของแบรนด์นี้ — จงใจ
// **ไม่ใช้ 🚀** เพราะนั่นเป็นไอคอนที่ NAZA168 ตัวละติน (ลูกค้าคนละเจ้า) ใช้ในไฟล์นี้
// มาก่อน (รอบก่อนหน้าเป็น 🥷 ตามธีมนินจาของ นินจา168)
// หนึ่งไอคอนต่อหนึ่งรายการ และอยู่ใน <span aria-hidden> ของตัวเองเสมอ
// ไม่เคยอยู่ในข้อความของป้าย
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🛰️" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];

const logoAlt = `โลโก้ ${BRAND_NAME} เป็นหมวกนักบินอวกาศสีขาวเงินอยู่ทางซ้าย บังตาเป็นกระจกโค้งสีเข้มที่สะท้อนภาพโลกสีน้ำเงินและฟ้า ขอบหมวกมีไฟสีฟ้าสว่างและวงแหวนสีเงิน ถัดไปทางขวาเป็นคำว่า นาซ่า ตัวอักษรไทยหนาสามมิติผิวมันวาวไล่เฉดจากฟ้าไซยานด้านบนลงน้ำเงินเข้มด้านล่าง ตัดขอบขาวและดำ ต่อด้วยเลข 168 ตัวหนาสามมิติสีทองอำพัน`;
---

<header class="sticky top-0 z-[100] w-full font-sans">
  <nav
    class="relative mx-auto flex h-[80px] w-full items-center justify-between border-b border-[#1fd8f0]/40 bg-[#121722]/95 px-4 shadow-[0_5px_25px_rgba(31,216,240,0.25)] backdrop-blur-xl xl:px-8"
    style="clip-path: polygon(0 0, 100% 0, 100% 100%, 20px 100%, 0 calc(100% - 20px));">
    <a href="/" class="z-[110] flex-shrink-0 transition-transform hover:scale-105">
      {
        mainLogo ? (
          <Picture
            src={mainLogo}
            alt={logoAlt}
            loading="eager"
            widths={[140, 280, 420]}
            sizes="140px"
            class="h-[55px] w-auto drop-shadow-[0_0_12px_rgba(31,216,240,0.55)] xl:h-[70px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
          />
        ) : (
          <span class="bg-gradient-to-r from-[#8fd9ec] via-[#1fd8f0] to-[#1d4fd8] bg-clip-text text-3xl font-black tracking-wider text-transparent">{BRAND_NAME}</span>
        )
      }
    </a>

    <div class="hidden h-full flex-1 items-center justify-center gap-6 lg:flex">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`group relative flex h-full items-center gap-2 px-2 text-sm font-bold tracking-widest uppercase transition-colors xl:text-base ${isActive(item.path) ? "text-[#1fd8f0] drop-shadow-[0_0_8px_rgba(31,216,240,0.8)]" : "text-[#e6edf8]/75 hover:text-[#8fd9ec]"}`}>
            <span aria-hidden="true">{item.icon}</span>
            <span>{item.name}</span>
            <div
              class={`absolute bottom-0 left-0 h-[4px] w-full bg-gradient-to-r from-[#1fd8f0] to-[#1d4fd8] shadow-[0_-2px_10px_rgba(31,216,240,0.9)] transition-transform duration-300 ${isActive(item.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
            />
          </a>
        ))
      }
    </div>

    <div class="z-[110] flex items-center gap-4">
      <a
        href="/login"
        class="hidden items-center justify-center border border-[#1fd8f0]/70 bg-transparent px-6 py-2 text-sm font-bold text-[#1fd8f0] transition-all hover:bg-[#1d4fd8]/40 lg:flex"
        style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
        เข้าระบบ
      </a>
      <a
        href="/register"
        class="hidden items-center justify-center bg-gradient-to-r from-[#8fd9ec] to-[#1fd8f0] px-6 py-2 text-sm font-black text-[#0d1017] shadow-[0_0_15px_rgba(31,216,240,0.45)] transition-all hover:scale-105 lg:flex"
        style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
        สมัครสมาชิก
      </a>

      <button
        id="hamburger-btn"
        class="relative flex h-[45px] w-[45px] flex-col items-center justify-center gap-[6px] border border-[#1fd8f0]/50 bg-[#0d1017] lg:hidden"
        style="clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px);"
        aria-label="Menu">
        <span class="line-1 h-[2px] w-6 origin-center bg-[#8fd9ec] shadow-[0_0_5px_rgba(31,216,240,0.9)] transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-6 origin-center bg-[#8fd9ec] shadow-[0_0_5px_rgba(31,216,240,0.9)] transition-all duration-300"></span>
        <span class="line-3 h-[2px] w-6 origin-center bg-[#8fd9ec] shadow-[0_0_5px_rgba(31,216,240,0.9)] transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="pointer-events-none absolute top-[80px] left-0 w-full origin-top -translate-y-4 scale-y-95 flex-col border-b border-[#1fd8f0]/40 bg-[#121722]/98 px-6 pt-4 pb-8 opacity-0 shadow-2xl backdrop-blur-xl transition-all duration-300 lg:hidden">
    <div class="flex flex-col gap-2">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`flex items-center gap-3 border-l-4 px-4 py-3 text-lg font-bold tracking-widest uppercase transition-colors ${isActive(item.path) ? "border-[#1fd8f0] bg-[#1d4fd8]/40 text-[#1fd8f0]" : "border-transparent text-[#e6edf8]/75 hover:bg-[#273449]/60 hover:text-[#8fd9ec]"}`}>
            <span aria-hidden="true">{item.icon}</span>
            <span>{item.name}</span>
          </a>
        ))
      }
    </div>
    <div class="mt-6 flex flex-col gap-4">
      <a
        href="/register"
        class="flex w-full justify-center bg-gradient-to-r from-[#8fd9ec] to-[#1fd8f0] py-3.5 text-lg font-black text-[#0d1017] shadow-[0_0_15px_rgba(31,216,240,0.45)]"
        style="clip-path: polygon(15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%, 0 15px);">
        สมัครสมาชิก
      </a>
      <a
        href="/login"
        class="flex w-full justify-center border border-[#1fd8f0]/70 bg-transparent py-3.5 text-lg font-bold text-[#1fd8f0]"
        style="clip-path: polygon(15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%, 0 15px);">
        เข้าระบบ
      </a>
    </div>
  </div>
</header>

<style is:global>
  nav,
  header {
    font-family: var(--font-sans) !important;
  }
  #hamburger-btn.active .line-1 {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    opacity: 0;
  }
  #hamburger-btn.active .line-3 {
    transform: translateY(-8px) rotate(-45deg);
  }
  #mobile-menu.show {
    opacity: 1;
    transform: translateY(0) scaleY(100%);
    pointer-events: auto;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  hamburgerBtn?.addEventListener("click", () => {
    hamburgerBtn.classList.toggle("active");
    mobileMenu?.classList.toggle("show");
  });
</script>
