---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
const currentPath = Astro.url.pathname;
const isActive = (path: string) => isActivePath(currentPath, path);

// BOOM369 (รอบเขียวนีออนบนดำ 2026-10-07): navbar ที่ใช้งานจริงรอบนี้ — รอบก่อน
// HI59 ใช้ NavbarStyle6 (รางเมนูแนวตั้งลอยชิดซ้าย) ไฟล์นี้เป็นแถบแนวนอนเต็มความ
// กว้างแบบตัดมุม clip-path คนละทรงกันชัดเจน
// แถบพื้นเขียวเกือบดำ #041109 ขอบล่างและเงานีออนเป็นเขียวแบรนด์ #42fb5a
// ลิงก์ปกติ #cfe9d7 โปร่ง ลิงก์ที่ active เป็นเขียวอ่อน #8dffa0 พร้อมขีดใต้ไล่
// เขียวนีออน → เขียวแบรนด์ #04ab3a — มาจากโลโก้ตรงๆ ที่ BOOM เป็นเขียวนีออนและ
// วงแหวนรอบนอกไล่จากเขียวไปเขียวอมฟ้า ชุดชมพู-ม่วงของ SEXYGAME666 ที่เคยอยู่ใน
// ไฟล์นี้ (#fa42b5 #8b3df3 #ffb3e2 #c9a4ff #f2dcee #0f0518 #08020d #1d0c33
// #c91a82 #7d1550 #fff2fb) ไม่เหลือแล้ว
//
// ทิศทางของปุ่มสมัครกลับด้านจากรอบชมพู: แบรนด์นี้สีหลักสว่างมาก (#42fb5a) การ
// เอามาเป็นพื้นปุ่มแล้วใส่หมึกสว่างจะตก AA ทันที (#e9fff0 บน #04ab3a ได้แค่
// 2.9:1) ปุ่มจึงเป็น "เขียวนีออนตัน หมึกเขียวเกือบดำ" แทน — #03150a บน #42fb5a
// ได้ 13.9:1 และบน #04ab3a ปลายเข้มสุดของเฉดได้ 6.3:1 ผ่าน AA ตลอดแนวไล่เฉด
// ส่วนปุ่มเข้าระบบเป็นเส้นขอบเขียวนีออนบนพื้นโปร่ง หมึก #42fb5a บน #041109
// ได้ 14.6:1
//
// One array for both the desktop bar and the mobile drawer — editing it in two
// places is how a menu ends up disagreeing with itself.
//
// Order: หน้าแรก first, then โปรโมชั่น, then the two conversion actions
// (สมัครสมาชิก / เข้าสู่ระบบ), then the pages that are there to be read.
// /register and /login are real button pages on this brand, so ทางเข้า has no
// menu entry — it would be a third link to the same two destinations. The page
// itself stays routed and indexed.
// /ตรวจหวย and /แนวทาง are absent on purpose: BOOM369 is a slot brand, so both
// files stay parked in src/pages-disabled/ and the routes do not exist —
// linking either would be a dead href the build fails on.
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "💠" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];
---

<header class="sticky top-0 z-[100] w-full font-sans">
  <nav
    class="relative mx-auto flex h-[80px] w-full items-center justify-between border-b border-[#42fb5a]/40 bg-[#041109]/95 px-4 shadow-[0_5px_25px_rgba(66,251,90,0.25)] backdrop-blur-xl xl:px-8"
    style="clip-path: polygon(0 0, 100% 0, 100% 100%, 20px 100%, 0 calc(100% - 20px));">
    <a href="/" class="z-[110] flex-shrink-0 transition-transform hover:scale-105">
      {
        mainLogo ? (
          <Picture
            src={mainLogo}
            alt="โลโก้ BOOM369 ตัวอักษรหนาสามมิติ คำว่า BOOM เป็นเขียวนีออนไล่เฉด และเลข 369 เป็นเงินโครเมียม วางอยู่กลางวงแหวนเปิดที่ไล่จากเขียวนีออนไปเขียวอมฟ้าเข้ม"
            loading="eager"
            widths={[140, 280, 420]}
            sizes="140px"
            class="h-[55px] w-auto drop-shadow-[0_0_12px_rgba(66,251,90,0.55)] xl:h-[70px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
          />
        ) : (
          <span class="bg-gradient-to-r from-[#42fb5a] via-[#8dffa0] to-[#dadcdc] bg-clip-text text-3xl font-black tracking-wider text-transparent">{BRAND_NAME}</span>
        )
      }
    </a>

    <div class="hidden h-full flex-1 items-center justify-center gap-6 lg:flex">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`group relative flex h-full items-center gap-2 px-2 text-sm font-bold tracking-widest uppercase transition-colors xl:text-base ${isActive(item.path) ? "text-[#8dffa0] drop-shadow-[0_0_8px_rgba(66,251,90,0.8)]" : "text-[#cfe9d7]/70 hover:text-[#42fb5a]"}`}>
            <span aria-hidden="true">{item.icon}</span>
            <span>{item.name}</span>
            <div
              class={`absolute bottom-0 left-0 h-[4px] w-full bg-gradient-to-r from-[#42fb5a] to-[#04ab3a] shadow-[0_-2px_10px_rgba(66,251,90,0.9)] transition-transform duration-300 ${isActive(item.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
            />
          </a>
        ))
      }
    </div>

    <div class="z-[110] flex items-center gap-4">
      <a
        href="/login"
        class="hidden items-center justify-center border border-[#42fb5a]/70 bg-transparent px-6 py-2 text-sm font-bold text-[#42fb5a] transition-all hover:bg-[#0b231b]/70 lg:flex"
        style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
        เข้าระบบ
      </a>
      <a
        href="/register"
        class="hidden items-center justify-center bg-gradient-to-r from-[#42fb5a] to-[#04ab3a] px-6 py-2 text-sm font-black text-[#03150a] shadow-[0_0_15px_rgba(66,251,90,0.45)] transition-all hover:scale-105 lg:flex"
        style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
        สมัครสมาชิก
      </a>

      <button
        id="hamburger-btn"
        class="relative flex h-[45px] w-[45px] flex-col items-center justify-center gap-[6px] border border-[#42fb5a]/50 bg-[#020a06] lg:hidden"
        style="clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px);"
        aria-label="Menu">
        <span class="line-1 h-[2px] w-6 origin-center bg-[#8dffa0] shadow-[0_0_5px_rgba(66,251,90,0.9)] transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-6 origin-center bg-[#8dffa0] shadow-[0_0_5px_rgba(66,251,90,0.9)] transition-all duration-300"></span>
        <span class="line-3 h-[2px] w-6 origin-center bg-[#8dffa0] shadow-[0_0_5px_rgba(66,251,90,0.9)] transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="pointer-events-none absolute top-[80px] left-0 w-full origin-top -translate-y-4 scale-y-95 flex-col border-b border-[#42fb5a]/40 bg-[#041109]/98 px-6 pt-4 pb-8 opacity-0 shadow-2xl backdrop-blur-xl transition-all duration-300 lg:hidden">
    <div class="flex flex-col gap-2">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`flex items-center gap-3 border-l-4 px-4 py-3 text-lg font-bold tracking-widest uppercase transition-colors ${isActive(item.path) ? "border-[#42fb5a] bg-[#0b231b]/70 text-[#8dffa0]" : "border-transparent text-[#cfe9d7]/70 hover:bg-white/5 hover:text-[#42fb5a]"}`}>
            <span aria-hidden="true">{item.icon}</span>
            <span>{item.name}</span>
          </a>
        ))
      }
    </div>
    <div class="mt-6 flex flex-col gap-4">
      <a
        href="/register"
        class="flex w-full justify-center bg-gradient-to-r from-[#42fb5a] to-[#04ab3a] py-3.5 text-lg font-black text-[#03150a] shadow-[0_0_15px_rgba(66,251,90,0.45)]"
        style="clip-path: polygon(15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%, 0 15px);">
        สมัครสมาชิก
      </a>
      <a
        href="/login"
        class="flex w-full justify-center border border-[#42fb5a]/70 bg-transparent py-3.5 text-lg font-bold text-[#42fb5a]"
        style="clip-path: polygon(15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%, 0 15px);">
        เข้าระบบ
      </a>
    </div>
  </div>
</header>

<style is:global>
  nav,
  header {
    font-family: var(--font-sans) !important;
  }
  #hamburger-btn.active .line-1 {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    opacity: 0;
  }
  #hamburger-btn.active .line-3 {
    transform: translateY(-8px) rotate(-45deg);
  }
  #mobile-menu.show {
    opacity: 1;
    transform: translateY(0) scaleY(100%);
    pointer-events: auto;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  hamburgerBtn?.addEventListener("click", () => {
    hamburgerBtn.classList.toggle("active");
    mobileMenu?.classList.toggle("show");
  });
</script>
