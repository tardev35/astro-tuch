---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
const currentPath = Astro.url.pathname;
const isActive = (path: string) => isActivePath(currentPath, path);

// ZORO365 (รอบเขียวมรกตนำ-เงินโครเมียมรอง บนเขียวป่าจมเกือบดำ): navbar ที่ใช้งาน
// จริงรอบนี้ — รอบก่อน TEVA69 ใช้ NavbarStyle10 (สองชั้น: แถบข้อมูลบางๆ เต็มความกว้าง
// ด้านบนสุด + แถบเมนูทรงแคปซูล rounded-[20px] สูง 75px ที่ลอยอยู่ไม่ชิดขอบจอ)
// ไฟล์นี้เป็น **แถบแนวนอน sticky สูง 80px เต็มความกว้างที่ตัดมุมล่างซ้ายด้วย
// clip-path polygon** แล้วเลื่อนแผงเมนูลงมาจากใต้แถบบนมือถือ — คนละทรงกันชัดเจน
// ทรง "ตัดมุมเฉียง" รอบนี้เลือกมาเพราะมุมตัดเฉียงคมอ่านเป็น **"รอยดาบ"** ซึ่งตรงกับ
// ภาษาภาพคาทานะและวงพู่กันหมึกของแบรนด์นี้โดยตรง — ไม่ใช่เลือกเพราะโทนไซเบอร์พังก์
// **ห้ามใส่ภาษามอนอสเปซ/สแลชสามตัว/SYSTEM_/เส้นสแกนนีออน/กริดไซเบอร์เข้ามา**
// และ **ห้ามใส่ภาษาอวกาศ (หมวกนักบิน ดาวเทียม วงโคจร) ซึ่งเป็นของ นาซ่า168
// เจ้าของธีมก่อนหน้าของไฟล์นี้ หรือภาษานินจา (ชูริเคน ผ้าคาดหัว) ของ นินจา168
// ก่อนหน้านั้นอีก**
// ⚠️ **ดาบคาทานะของรอบนี้ไม่ใช่ "ใบมีดนินจา" ของ นินจา168** — ของรอบนี้มาจาก
// อาร์ตเวิร์กจริง (ดาบปักตั้งผ่ากลางวงพู่กันหมึกในโลโก้ และดาบวางพาดในแบนเนอร์)
//
// พาเลตต์ตาม .claude/brand-spec-zoro365.md §2: แถบพื้นโครมฐาน #031b09
// ขอบล่างและเงาเป็นเขียวมรกตแบรนด์ #3ddc4a ลิงก์ปกติ #dfe6e3 (เงินโครเมียม) โปร่ง
// ลิงก์ที่ hover เป็นเขียวมรกต #3ddc4a ลิงก์ที่ active เป็น #3ddc4a พร้อมขีดใต้ไล่
// เขียวมรกต #3ddc4a -> เขียวเข้ม #1e7033 — มาจากโลโก้ตรงๆ ที่ครึ่งแรกของเวิร์ดมาร์ก
// เป็นตัวอักษรละตินผิวโครเมียมเงินขัดเงา และครึ่งหลังเป็นตัวเลขผิวเขียวมรกตเรืองแสง
//
// 🚨🚨 **กับดักของไฟล์นี้รอบนี้: รอบก่อนทันที (TEVA69) ก็เป็นแบรนด์เขียว/เงิน
// โครเมียมเหมือนกันเป๊ะ ต่างกันแค่กลับทิศสว่าง-มืด** การเจอ "เขียว" หรือ "เทาเงิน"
// ในไฟล์นี้จึงไม่พิสูจน์อะไรเลย ต้องเทียบค่าหกหลัก:
//   เขียวรอบนี้ #3ddc4a / #35a043 / #1e7033 / #1e9c33 และเงิน #dfe6e3
//   — ไม่ใช่ 28c437/116018/1a7d24/0b4a12/3f7a2e/c6cfd2/e8fbe4/b4d6ad/e3bb45
//     (TEVA69 — **รอบก่อนทันที เสี่ยงหลงเหลือสูงสุด และอยู่ตระกูลสีเดียวกัน**)
//   — ไม่ใช่ 8ce023/e9f7d6/bde397/1a5c04/2f8c07/a87a08/f2c230 (KINGKONG555)
//   — ไม่ใช่ 0b7d28/0a5f1c/0f9b35/0c3a16/061f0c (สาธุ168 ⚠️ 0c3a16 ห่างจาก
//     #073c1a ของรอบนี้แค่หลักเดียว ซึ่งเป็นคู่ที่พิมพ์ผิดง่ายที่สุดของรอบนี้)
//   — ไม่ใช่ 1fae1c/0d2312/143a1c/07130a (888PARUAY) 117a41/2bb061 (MEXICANOSLOT)
//     2fbf6a (KOON234)
// ⚠️ **ชุดฟ้าไซยาน-น้ำเงินของ นาซ่า168 ที่เคยอยู่ในไฟล์นี้**
//   (1fd8f0 0bb6d4 8fd9ec 1d4fd8 143aa0 e6edf8 121722 1b2434 273449 0d1017)
//   **ห้ามกลับเข้ามาแม้แต่ค่าเดียว** — รอบนี้ไม่มีฟ้า/ไซแอน/น้ำเงินเป็นสี UI เลย
// ⚠️ และชุดฟ้าของ นินจา168 (32bcfb a9e9ff 07335f 071a28 030e16 dceefc) กับ
//   เหลืองมะนาว fef54b/6b5c10 ของมัน ก็ออกไปแล้วเช่นกัน
// ⚠️ ม่วง/แมเจนต้าของ ZANE96 (bb6dff 190b3d f3e8ff c2178b 7a1bd6 241046 dcc6f4)
//   ก็ห้ามเช่นกัน — รอบนี้ไม่มีม่วงเลยสักเฉด
// (เขียนเฮกซ์เก่าแบบไม่มี # เพื่อให้ sweep ที่ไล่หาสีแบรนด์เก่าไม่สะดุดที่คอมเมนต์)
//
// ตรวจค่าคอนทราสต์ใหม่ทั้งชุดแล้ว ไม่ได้ยกคลาสข้ามปุ่ม:
//   #dfe6e3 บนแถบ #031b09 ≈ 14.2:1 · #eef7f0 ≈ 16.8:1 · #3ddc4a ≈ 9.9:1
//   หมึก #011204 บนพื้นถมเขียว #3ddc4a ≈ 11.5:1 และบนปลายเข้ม #1e9c33 ≈ 5.4:1
//   ผ่าน AA ตลอดแนวไล่เฉด
// ⚠️ ปลายเข้มของไล่เฉดปุ่มสมัครหยุดที่ #1e9c33 ห้ามลากลงไปถึง #1e7033 —
// ค่านั้นรองหมึก #011204 ได้แค่ ~3.2:1 ซึ่งตก AA และ brand-spec §2 ระบุว่า
// #1e7033 กับ #35a043 เป็นเส้น/ขอบ/ออรา/พื้นถมเท่านั้น ห้ามถือตัวอักษรทุกขนาด
// ⚠️ และ **ห้ามใส่ตัวอักษรขาวบน #3ddc4a** (1.8:1) — ปุ่มเน้นต้องเป็นหมึกดำเสมอ
// ปุ่มสองตัวจึงต่างกันที่ "พื้นเขียวตัน vs กรอบเขียวโปร่ง" ไม่ใช่สองระดับของสีเดียว
//
// One array for both the desktop bar and the mobile drawer — editing it in two
// places is how a menu ends up disagreeing with itself.
//
// Order: หน้าแรก first, then โปรโมชั่น, then the two conversion actions
// (สมัครสมาชิก / เข้าสู่ระบบ), then the pages that are there to be read.
// /register and /login are real button pages on this brand, so ทางเข้า has no
// menu entry — it would be a third link to the same two destinations. The page
// itself stays routed and indexed (footer ยังลิงก์ไปได้ตามปกติ)
// /ตรวจหวย and /แนวทาง are absent on purpose: ZORO365 is a casino brand and the
// brief names หวย only as one of five game categories, so both files stay parked
// in src/pages-disabled/ and the routes do not exist — linking either would be a
// dead href the build fails on.
// ⚠️ ไอคอน 🎴 ของ "ทดลองเล่น" เลือกให้เข้ากับภาษาภาพญี่ปุ่นของแบรนด์นี้ (ไพ่ฮานาฟุดะ)
// จงใจ **ไม่ใช้ 🎰** ซึ่งเป็นไอคอนที่ navbar แทบทุกตัวในคลังใช้กับรายการนี้มาก่อน
// และ **ไม่ใช้ 🥷** ซึ่งเป็นของ นินจา168 หรือ 🛰️ ซึ่งเป็นของ นาซ่า168 ในไฟล์นี้เอง
// หนึ่งไอคอนต่อหนึ่งรายการ และอยู่ใน <span aria-hidden> ของตัวเองเสมอ
// ไม่เคยอยู่ในข้อความของป้าย
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎴" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "📖" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];

const logoAlt = `โลโก้ ${BRAND_NAME} เป็นเวิร์ดมาร์กสามมิติที่ครึ่งแรกเป็นตัวอักษรละตินผิวโครเมียมเงินขัดเงา และครึ่งหลังเป็นตัวเลขผิวเขียวมรกตเคลือบเงาเรืองแสง ตัดขอบสีดำหนาทั้งชุด วางทับวงพู่กันหมึกสีดำและเขียวที่มีรอยสะบัดสีกระเด็นรอบวง โดยมีดาบคาทานะเล่มหนึ่งปักตั้งผ่ากลางวง ด้ามพันเชือกสีเขียวและปลายใบมีดชี้ขึ้น ด้านล่างมีควันสีเขียวเรืองแสงลอยขึ้นมา`;
---

<header class="sticky top-0 z-[100] w-full font-sans">
  <nav
    class="relative mx-auto flex h-[80px] w-full items-center justify-between border-b border-[#3ddc4a]/40 bg-[#031b09]/95 px-4 shadow-[0_5px_25px_rgba(61,220,74,0.25)] backdrop-blur-xl xl:px-8"
    style="clip-path: polygon(0 0, 100% 0, 100% 100%, 20px 100%, 0 calc(100% - 20px));">
    <a href="/" class="z-[110] flex-shrink-0 transition-transform hover:scale-105">
      {
        mainLogo ? (
          <Picture
            src={mainLogo}
            alt={logoAlt}
            loading="eager"
            widths={[140, 280, 420]}
            sizes="140px"
            class="h-[55px] w-auto drop-shadow-[0_0_12px_rgba(61,220,74,0.55)] xl:h-[70px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
          />
        ) : (
          <span class="bg-gradient-to-r from-[#dfe6e3] via-[#3ddc4a] to-[#1e7033] bg-clip-text text-3xl font-black tracking-wider text-transparent">{BRAND_NAME}</span>
        )
      }
    </a>

    <div class="hidden h-full flex-1 items-center justify-center gap-6 lg:flex">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`group relative flex h-full items-center gap-2 px-2 text-sm font-bold tracking-widest uppercase transition-colors xl:text-base ${isActive(item.path) ? "text-[#3ddc4a] drop-shadow-[0_0_8px_rgba(61,220,74,0.8)]" : "text-[#dfe6e3]/75 hover:text-[#3ddc4a]"}`}>
            <span aria-hidden="true">{item.icon}</span>
            <span>{item.name}</span>
            <div
              class={`absolute bottom-0 left-0 h-[4px] w-full bg-gradient-to-r from-[#3ddc4a] to-[#1e7033] shadow-[0_-2px_10px_rgba(61,220,74,0.9)] transition-transform duration-300 ${isActive(item.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
            />
          </a>
        ))
      }
    </div>

    <div class="z-[110] flex items-center gap-4">
      <a
        href="/login"
        class="hidden items-center justify-center border border-[#3ddc4a]/70 bg-transparent px-6 py-2 text-sm font-bold text-[#3ddc4a] transition-all hover:bg-[#1e7033]/40 lg:flex"
        style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
        เข้าระบบ
      </a>
      <a
        href="/register"
        class="hidden items-center justify-center bg-gradient-to-r from-[#3ddc4a] to-[#1e9c33] px-6 py-2 text-sm font-black text-[#011204] shadow-[0_0_15px_rgba(61,220,74,0.45)] transition-all hover:scale-105 lg:flex"
        style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
        สมัครสมาชิก
      </a>

      <button
        id="hamburger-btn"
        class="relative flex h-[45px] w-[45px] flex-col items-center justify-center gap-[6px] border border-[#3ddc4a]/50 bg-[#010d04] lg:hidden"
        style="clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px);"
        aria-label="Menu">
        <span class="line-1 h-[2px] w-6 origin-center bg-[#dfe6e3] shadow-[0_0_5px_rgba(61,220,74,0.9)] transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-6 origin-center bg-[#dfe6e3] shadow-[0_0_5px_rgba(61,220,74,0.9)] transition-all duration-300"></span>
        <span class="line-3 h-[2px] w-6 origin-center bg-[#dfe6e3] shadow-[0_0_5px_rgba(61,220,74,0.9)] transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="pointer-events-none absolute top-[80px] left-0 w-full origin-top -translate-y-4 scale-y-95 flex-col border-b border-[#3ddc4a]/40 bg-[#031b09]/98 px-6 pt-4 pb-8 opacity-0 shadow-2xl backdrop-blur-xl transition-all duration-300 lg:hidden">
    <div class="flex flex-col gap-2">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`flex items-center gap-3 border-l-4 px-4 py-3 text-lg font-bold tracking-widest uppercase transition-colors ${isActive(item.path) ? "border-[#3ddc4a] bg-[#1e7033]/40 text-[#3ddc4a]" : "border-transparent text-[#dfe6e3]/75 hover:bg-[#073c1a]/60 hover:text-[#3ddc4a]"}`}>
            <span aria-hidden="true">{item.icon}</span>
            <span>{item.name}</span>
          </a>
        ))
      }
    </div>
    <div class="mt-6 flex flex-col gap-4">
      <a
        href="/register"
        class="flex w-full justify-center bg-gradient-to-r from-[#3ddc4a] to-[#1e9c33] py-3.5 text-lg font-black text-[#011204] shadow-[0_0_15px_rgba(61,220,74,0.45)]"
        style="clip-path: polygon(15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%, 0 15px);">
        สมัครสมาชิก
      </a>
      <a
        href="/login"
        class="flex w-full justify-center border border-[#3ddc4a]/70 bg-transparent py-3.5 text-lg font-bold text-[#3ddc4a]"
        style="clip-path: polygon(15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%, 0 15px);">
        เข้าระบบ
      </a>
    </div>
  </div>
</header>

<style is:global>
  nav,
  header {
    font-family: var(--font-sans) !important;
  }
  #hamburger-btn.active .line-1 {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    opacity: 0;
  }
  #hamburger-btn.active .line-3 {
    transform: translateY(-8px) rotate(-45deg);
  }
  #mobile-menu.show {
    opacity: 1;
    transform: translateY(0) scaleY(100%);
    pointer-events: auto;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  hamburgerBtn?.addEventListener("click", () => {
    hamburgerBtn.classList.toggle("active");
    mobileMenu?.classList.toggle("show");
  });
</script>
