---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
const currentPath = Astro.url.pathname;
const isActive = (path: string) => isActivePath(currentPath, path);

// SEXYGAME666 (รอบชมพูนีออน-ม่วง-ดำ 2026-09-28): navbar ที่ใช้งานจริงรอบนี้
// (รอบก่อน PGW44 ใช้ NavbarStyle8) แถบพื้นดำอมม่วง #0f0518 ขอบล่างและเงานีออน
// เป็นชมพูบานเย็นแบรนด์ #fa42b5 ลิงก์ปกติ #f2dcee โปร่ง ลิงก์ที่ active เป็น
// ชมพูอ่อน #ffb3e2 พร้อมขีดใต้ไล่ชมพู → ม่วงแบรนด์ #8b3df3 ปุ่มสมัครไล่ชมพูเข้ม
// #c91a82 → ชมพูลึก #7d1550 ส่วนปุ่มเข้าระบบเป็นเส้นขอบม่วงอ่อน #c9a4ff
// — คู่ชมพู/ม่วงมาจากโลโก้ที่ SEXY เป็นชมพูบานเย็น GAME ไล่ไปเป็นม่วง และ 666
// กลับมาเป็นชมพู ชุดน้ำเงิน-เงินของ HIX168 ที่เคยอยู่ในไฟล์นี้ (#1e7bf5 #8ec5ff
// #6fb4ff #cfe4ff #cfd8e6 #d6e2f5 #eaf3ff #060c1c #01030d #0d1730) ไม่เหลือแล้ว
//
// ปุ่มสมัครใช้หมึกสว่าง #fff2fb ปลายไล่เฉดจึงต้อง "เข้มพอ" ไม่ใช่สว่าง: ชมพู
// แบรนด์ #fa42b5 เต็มๆ ให้แค่ 2.97:1 (รอบน้ำเงินของ HIX168 ก็ตกอยู่แล้วที่ 3.60:1)
// ค่าปัจจุบัน #c91a82 → #7d1550 ได้ 4.89:1 ถึง 9.23:1 ผ่าน AA ตลอดแนวไล่เฉด
// สังเกตว่าทิศทางตรงข้ามกับ Navfoot ซึ่งหมึกเข้มจึงต้องจบที่โทนสว่าง
//
// One array for both the desktop bar and the mobile drawer — editing it in two
// places is how a menu ends up disagreeing with itself.
//
// Order: หน้าแรก first, then โปรโมชั่น, then the two conversion actions
// (สมัครสมาชิก / เข้าสู่ระบบ), then the pages that are there to be read.
// /register and /login are real button pages on this brand, so ทางเข้า has no
// menu entry — it would be a third link to the same two destinations. The page
// itself stays routed and indexed.
// /ตรวจหวย and /แนวทาง are absent on purpose: SEXYGAME666 is a live-casino
// brand, so both files stay parked in src/pages-disabled/ and the routes do not
// exist — linking either would be a dead href the build fails on.
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🃏" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "💠" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];
---

<header class="sticky top-0 z-[100] w-full font-sans">
  <nav
    class="relative mx-auto flex h-[80px] w-full items-center justify-between border-b border-[#fa42b5]/40 bg-[#0f0518]/95 px-4 shadow-[0_5px_25px_rgba(250,66,181,0.25)] backdrop-blur-xl xl:px-8"
    style="clip-path: polygon(0 0, 100% 0, 100% 100%, 20px 100%, 0 calc(100% - 20px));">
    <a href="/" class="z-[110] flex-shrink-0 transition-transform hover:scale-105">
      {
        mainLogo ? (
          <Picture
            src={mainLogo}
            alt="โลโก้ SEXYGAME666 ตัวอักษรหนาสามมิติ คำว่า SEXY เป็นชมพูบานเย็นไล่เฉด GAME ไล่จากม่วงไปน้ำเงินม่วง และเลข 666 กลับมาเป็นชมพูบานเย็น"
            loading="eager"
            widths={[140, 280, 420]}
            sizes="140px"
            class="h-[55px] w-auto drop-shadow-[0_0_12px_rgba(250,66,181,0.55)] xl:h-[70px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
          />
        ) : (
          <span class="bg-gradient-to-r from-[#ffb3e2] via-[#fa42b5] to-[#8b3df3] bg-clip-text text-3xl font-black tracking-wider text-transparent">{BRAND_NAME}</span>
        )
      }
    </a>

    <div class="hidden h-full flex-1 items-center justify-center gap-6 lg:flex">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`group relative flex h-full items-center gap-2 px-2 text-sm font-bold tracking-widest uppercase transition-colors xl:text-base ${isActive(item.path) ? "text-[#ffb3e2] drop-shadow-[0_0_8px_rgba(250,66,181,0.8)]" : "text-[#f2dcee]/70 hover:text-[#c9a4ff]"}`}>
            <span aria-hidden="true">{item.icon}</span>
            <span>{item.name}</span>
            <div
              class={`absolute bottom-0 left-0 h-[4px] w-full bg-gradient-to-r from-[#fa42b5] to-[#8b3df3] shadow-[0_-2px_10px_rgba(250,66,181,0.9)] transition-transform duration-300 ${isActive(item.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
            />
          </a>
        ))
      }
    </div>

    <div class="z-[110] flex items-center gap-4">
      <a
        href="/login"
        class="hidden items-center justify-center border border-[#c9a4ff]/70 bg-transparent px-6 py-2 text-sm font-bold text-[#c9a4ff] transition-all hover:bg-[#1d0c33]/70 lg:flex"
        style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
        เข้าระบบ
      </a>
      <a
        href="/register"
        class="hidden items-center justify-center bg-gradient-to-r from-[#c91a82] to-[#7d1550] px-6 py-2 text-sm font-black text-[#fff2fb] shadow-[0_0_15px_rgba(250,66,181,0.45)] transition-all hover:scale-105 lg:flex"
        style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
        สมัครสมาชิก
      </a>

      <button
        id="hamburger-btn"
        class="relative flex h-[45px] w-[45px] flex-col items-center justify-center gap-[6px] border border-[#fa42b5]/50 bg-[#08020d] lg:hidden"
        style="clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px);"
        aria-label="Menu">
        <span class="line-1 h-[2px] w-6 origin-center bg-[#ffb3e2] shadow-[0_0_5px_rgba(250,66,181,0.9)] transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-6 origin-center bg-[#ffb3e2] shadow-[0_0_5px_rgba(250,66,181,0.9)] transition-all duration-300"></span>
        <span class="line-3 h-[2px] w-6 origin-center bg-[#ffb3e2] shadow-[0_0_5px_rgba(250,66,181,0.9)] transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="pointer-events-none absolute top-[80px] left-0 w-full origin-top -translate-y-4 scale-y-95 flex-col border-b border-[#fa42b5]/40 bg-[#0f0518]/98 px-6 pt-4 pb-8 opacity-0 shadow-2xl backdrop-blur-xl transition-all duration-300 lg:hidden">
    <div class="flex flex-col gap-2">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`flex items-center gap-3 border-l-4 px-4 py-3 text-lg font-bold tracking-widest uppercase transition-colors ${isActive(item.path) ? "border-[#fa42b5] bg-[#1d0c33]/70 text-[#ffb3e2]" : "border-transparent text-[#f2dcee]/70 hover:bg-white/5 hover:text-[#c9a4ff]"}`}>
            <span aria-hidden="true">{item.icon}</span>
            <span>{item.name}</span>
          </a>
        ))
      }
    </div>
    <div class="mt-6 flex flex-col gap-4">
      <a
        href="/register"
        class="flex w-full justify-center bg-gradient-to-r from-[#c91a82] to-[#7d1550] py-3.5 text-lg font-black text-[#fff2fb] shadow-[0_0_15px_rgba(250,66,181,0.45)]"
        style="clip-path: polygon(15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%, 0 15px);">
        สมัครสมาชิก
      </a>
      <a
        href="/login"
        class="flex w-full justify-center border border-[#c9a4ff]/70 bg-transparent py-3.5 text-lg font-bold text-[#c9a4ff]"
        style="clip-path: polygon(15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%, 0 15px);">
        เข้าระบบ
      </a>
    </div>
  </div>
</header>

<style is:global>
  nav,
  header {
    font-family: var(--font-sans) !important;
  }
  #hamburger-btn.active .line-1 {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    opacity: 0;
  }
  #hamburger-btn.active .line-3 {
    transform: translateY(-8px) rotate(-45deg);
  }
  #mobile-menu.show {
    opacity: 1;
    transform: translateY(0) scaleY(100%);
    pointer-events: auto;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  hamburgerBtn?.addEventListener("click", () => {
    hamburgerBtn.classList.toggle("active");
    mobileMenu?.classList.toggle("show");
  });
</script>
