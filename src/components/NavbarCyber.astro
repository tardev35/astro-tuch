---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
const currentPath = Astro.url.pathname;
const isActive = (path: string) => isActivePath(currentPath, path);

// One array for both the desktop bar and the mobile drawer — editing it in two
// places is how a menu ends up disagreeing with itself.
//
// Order: หน้าแรก first, then โปรโมชั่น, then the two conversion actions
// (สมัครสมาชิก / เข้าสู่ระบบ), then the pages that are there to be read.
// /register and /login are real button pages on this brand, so ทางเข้า has no
// menu entry — it would be a third link to the same two destinations. The page
// itself stays routed and indexed.
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "💠" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];
---

<header class="sticky top-0 z-[100] w-full font-sans">
  <nav
    class="relative mx-auto flex h-[80px] w-full items-center justify-between border-b border-[#1e7bf5]/40 bg-[#060c1c]/95 px-4 shadow-[0_5px_25px_rgba(30,123,245,0.25)] backdrop-blur-xl xl:px-8"
    style="clip-path: polygon(0 0, 100% 0, 100% 100%, 20px 100%, 0 calc(100% - 20px));">
    <a href="/" class="z-[110] flex-shrink-0 transition-transform hover:scale-105">
      {
        mainLogo ? (
          <Picture
            src={mainLogo}
            alt="โลโก้ HIX168 ตัวอักษร HIX สีน้ำเงินไล่เฉดเป็นประกายโลหะ วางอยู่เหนือเลข 168 สีเงินโครเมียมขัดเงา"
            loading="eager"
            widths={[140, 280, 420]}
            sizes="140px"
            class="h-[55px] w-auto drop-shadow-[0_0_12px_rgba(30,123,245,0.55)] xl:h-[70px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
          />
        ) : (
          <span class="bg-gradient-to-r from-[#cfe4ff] via-[#1e7bf5] to-[#cfd8e6] bg-clip-text text-3xl font-black tracking-wider text-transparent">{BRAND_NAME}</span>
        )
      }
    </a>

    <div class="hidden h-full flex-1 items-center justify-center gap-6 lg:flex">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`group relative flex h-full items-center gap-2 px-2 text-sm font-bold tracking-widest uppercase transition-colors xl:text-base ${isActive(item.path) ? "text-[#8ec5ff] drop-shadow-[0_0_8px_rgba(30,123,245,0.8)]" : "text-[#d6e2f5]/70 hover:text-[#6fb4ff]"}`}>
            <span aria-hidden="true">{item.icon}</span>
            <span>{item.name}</span>
            <div
              class={`absolute bottom-0 left-0 h-[4px] w-full bg-gradient-to-r from-[#1e7bf5] to-[#cfd8e6] shadow-[0_-2px_10px_rgba(30,123,245,0.9)] transition-transform duration-300 ${isActive(item.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
            />
          </a>
        ))
      }
    </div>

    <div class="z-[110] flex items-center gap-4">
      <a
        href="/login"
        class="hidden items-center justify-center border border-[#cfd8e6]/70 bg-transparent px-6 py-2 text-sm font-bold text-[#cfd8e6] transition-all hover:bg-[#0d1730]/70 lg:flex"
        style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
        เข้าระบบ
      </a>
      <a
        href="/register"
        class="hidden items-center justify-center bg-gradient-to-r from-[#1e7bf5] to-[#0a3fa8] px-6 py-2 text-sm font-black text-[#eaf3ff] shadow-[0_0_15px_rgba(30,123,245,0.45)] transition-all hover:scale-105 lg:flex"
        style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
        สมัครสมาชิก
      </a>

      <button
        id="hamburger-btn"
        class="relative flex h-[45px] w-[45px] flex-col items-center justify-center gap-[6px] border border-[#1e7bf5]/50 bg-[#01030d] lg:hidden"
        style="clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px);"
        aria-label="Menu">
        <span class="line-1 h-[2px] w-6 origin-center bg-[#8ec5ff] shadow-[0_0_5px_rgba(30,123,245,0.9)] transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-6 origin-center bg-[#8ec5ff] shadow-[0_0_5px_rgba(30,123,245,0.9)] transition-all duration-300"></span>
        <span class="line-3 h-[2px] w-6 origin-center bg-[#8ec5ff] shadow-[0_0_5px_rgba(30,123,245,0.9)] transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="pointer-events-none absolute top-[80px] left-0 w-full origin-top -translate-y-4 scale-y-95 flex-col border-b border-[#1e7bf5]/40 bg-[#060c1c]/98 px-6 pt-4 pb-8 opacity-0 shadow-2xl backdrop-blur-xl transition-all duration-300 lg:hidden">
    <div class="flex flex-col gap-2">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`flex items-center gap-3 border-l-4 px-4 py-3 text-lg font-bold tracking-widest uppercase transition-colors ${isActive(item.path) ? "border-[#1e7bf5] bg-[#0d1730]/70 text-[#8ec5ff]" : "border-transparent text-[#d6e2f5]/70 hover:bg-white/5 hover:text-[#6fb4ff]"}`}>
            <span aria-hidden="true">{item.icon}</span>
            <span>{item.name}</span>
          </a>
        ))
      }
    </div>
    <div class="mt-6 flex flex-col gap-4">
      <a
        href="/register"
        class="flex w-full justify-center bg-gradient-to-r from-[#1e7bf5] to-[#0a3fa8] py-3.5 text-lg font-black text-[#eaf3ff] shadow-[0_0_15px_rgba(30,123,245,0.45)]"
        style="clip-path: polygon(15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%, 0 15px);">
        สมัครสมาชิก
      </a>
      <a
        href="/login"
        class="flex w-full justify-center border border-[#cfd8e6]/70 bg-transparent py-3.5 text-lg font-bold text-[#cfd8e6]"
        style="clip-path: polygon(15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%, 0 15px);">
        เข้าระบบ
      </a>
    </div>
  </div>
</header>

<style is:global>
  nav,
  header {
    font-family: var(--font-sans) !important;
  }
  #hamburger-btn.active .line-1 {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    opacity: 0;
  }
  #hamburger-btn.active .line-3 {
    transform: translateY(-8px) rotate(-45deg);
  }
  #mobile-menu.show {
    opacity: 1;
    transform: translateY(0) scaleY(100%);
    pointer-events: auto;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  hamburgerBtn?.addEventListener("click", () => {
    hamburgerBtn.classList.toggle("active");
    mobileMenu?.classList.toggle("show");
  });
</script>
