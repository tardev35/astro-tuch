---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

// คำบรรยายเขียนจากไฟล์ logo.webp ของดรอป 2026-10-29 จริง (อ่านด้วย Read ก่อนเขียน)
// ไม่ใช่คัดลอกของรอบก่อน — **รอบนี้โลโก้เป็นเวิร์ดมาร์ก + มาสคอตลูกหมูการ์ตูน
// อยู่เหนือตัวอักษร** ซึ่งคนละทรงกับรอบก่อนที่เป็นเวิร์ดมาร์กโครเมียมเงินสองบรรทัด
// ในวงรีแถบวงโคจร (LOTTOPLUS) และคนละทรงกับเวิร์ดมาร์กผิวโครเมียมเอียงขวาที่ไล่
// ฟ้า-ม่วง-แมเจนต้าของ ZANE96 ซึ่งเป็นเจ้าของตัวแปรนี้ล่าสุด
// 🚨 **ลูกหมูรอบนี้ไม่มีปีก** (ต่างจากหมูบิน168) และ **ไม่ได้ชูสองนิ้ว**
// (ต่างจากหน้าการ์ตูนกลมชมพูของ okkub88) — บรรยายตามที่เห็นจริง
const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส เป็นตราทรงกลมพื้นชมพูอ่อนขอบขาวหนา ด้านบนของวงเป็นมาสคอตลูกหมูการ์ตูนหน้ากลมสีชมพูอ่อน หูตกสองข้าง แก้มแดงระเรื่อ ขยิบตาข้างขวาและยิ้มอ้าปากเห็นลิ้นเล็ก เอาสองขาหน้าเกาะขอบวงกลมโผล่ขึ้นมา ด้านล่างของวงเป็นข้อความตัวอักษรละตินสามมิติอ้วนมน ${BRAND_NAME} ผิวไล่จากขาวนวลลงมาหาชมพูอ่อน ตัดขอบสีชมพูเข้มหนาสองชั้น โดยตัวอักษร A มีหัวใจสีชมพูดวงเล็กซ้อนอยู่ในช่องกลางตัวอักษร รอบตราวงกลมมีหัวใจสีชมพูสามมิติผิวมันเงาลอยประดับอยู่ทั้งซ้ายและขวา`;

// สมัครสมาชิก/เข้าสู่ระบบ อยู่ถัดจากโปรโมชั่นทันที เพราะเป็นปุ่ม conversion
// ไม่ใช่หน้าให้อ่าน — ที่เหลือเป็นหน้าเนื้อหาเรียงต่อท้าย
//
// ไม่มี ตรวจหวย/แนวทาง: ABM96 เป็นเว็บคาสิโน ไม่ใช่เว็บหวย (บรีฟรอบนี้ไม่มีคำว่า
// หวยเลยสักคำ) สองหน้านั้นถูกย้ายกลับไปอยู่ใน src/pages-disabled/ แล้วรอบนี้
// จึงไม่มี route ให้ลิงก์ไปหา — ลิงก์ที่ค้างอยู่จะทำให้ verify-build แดงด้วย
// (href ชี้ไป route ที่ไม่มีอยู่จริง) ลบออกจาก links ตัวนี้ตัวเดียวพอ เพราะทั้ง
// รางเดสก์ท็อปและ drawer มือถืออ่าน array เดียวกัน
// ไม่มี ทางเข้า: toggle cta เปิดอยู่ /register กับ /login จึงเป็นหน้าจริงในเมนูแล้ว
// ทางเข้าจะกลายเป็นลิงก์ที่สามที่พาไปที่เดียวกัน (หน้ายังถูก route และ index อยู่
// และ footer ยังลิงก์ไปหาอยู่)
// ไอคอนรอบนี้เลือกตามแนวแบรนด์ **คาสิโนออนไลน์** ตามหมวดที่บรีฟระบุ (ไพ่บาคาร่า
// ตู้สล็อต กุญแจ ของขวัญ) ไม่ใช่ลูกบอลหวย/ลูกคิดแบบแบรนด์หวยที่เพิ่งถือรอบก่อน
// และอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของป้ายชื่อเสมอ ไม่ได้ฝังในข้อความ
//
// ───────────────────────────────────────────────────────────────────────────
// ABM96 (ดรอป 2026-10-29) — พาเลตตาม .claude/brand-spec-abm96.md §2
// navbar ตัวนี้เป็น "รางแนวตั้งลอยริมซ้าย" จึงประกาศสีตัวอักษรของตัวเองครบทุกจุด
// ไม่ได้ inherit BRAND_TEXT (ซึ่งรอบนี้เป็นหมึกเข้ม 3d0a2c สำหรับผิวสว่าง
// และจะอ่านไม่ออกบนโครม)
// ⚠️⚠️ **รอบนี้เป็นธีมสว่าง พื้นเพจเป็นชมพูพาสเทล #f8b9f0 (bg.json) แต่โครมเป็น
// ผิวเข้ม** — สองครึ่งอยู่คนละทิศโดยตั้งใจ **ห้าม "แก้" ให้ navbar สว่างตามพื้นเพจ**
// ผิวแผงเป็น #440d31 (พลัมจม) การ์ด/สถานะ active เป็น #5e1746
// ขอบชมพูแบรนด์ #e0509f ตัวหนังสือเงินอมชมพู #e8c3da (9.8:1 บนผิวแผง)
// -> ขาวอมชมพู #ffeef8 (14.0:1 บนผิวแผง) ตอน active
// แถบไฮไลต์ซ้ายไล่ ชมพูสว่าง #ff7ac2 -> ชมพูกลาง #e0509f -> ชมพูเข้ม #a30d63
// ตามไล่เฉดบนขอบตัดสามมิติของเวิร์ดมาร์กที่ไล่จากอ่อนด้านบนไปเข้มด้านล่าง
// ปุ่มสมัครเป็น **CTA หลักของพาเลต**: ไล่ #d11a7e -> #a30d63 + หมึกขาว #ffffff
// (5.0:1 และ 7.5:1 ผ่านทั้งสองสต็อป)
// ⚠️⚠️ **ห้ามลากปลายเฉดอ่อนกว่า #d11a7e เด็ดขาด** (#e0509f + หมึกขาว = 3.6:1 ตก)
// ปุ่มเข้าสู่ระบบเป็น **ปุ่มเส้นขอบ**: ขอบ #e0509f + หมึกทองอำพัน #f2c14e
// (9.3:1 บนผิวแผง) ⚠️ **ทองถือตัวอักษรได้เฉพาะบนโครมเข้มเท่านั้น**
// บนการ์ดขาวมันตก 1.7:1
// ⚠️⚠️ **#e0509f กับ #ff7ac2 เป็นเส้น/ขอบ/ออรา/พื้นถม ไม่ใช่สีตัวอักษร**
// (#e0509f บนผิวแผงนี้ได้ 4.3:1 ซึ่งยังต่ำกว่าเกณฑ์)
// — ชุดไวโอเลตนีออน-ฟ้าอิเล็กทริกของ ZANE96 ถูกถอดหมดแล้ว (bb6dff 7aa7ff 5411c4
// 7a1bd6 190b3d 271257 f3e8ff c0a6e8 2f1766 c2178b) พร้อมคำบรรยายโลโก้ที่เป็น
// เวิร์ดมาร์กโครเมียมไล่ฟ้า-ม่วง และก่อนหน้านั้นชุดฟ้าไซยาน-ครีมอุ่นของ ร่ำรวย168
// (18a5e2 0d6b9b 0a5176 a9d7f2 111a3f 202a66 e9f1ff adc0e4 f4e4d3 e4cbb3 dbe6ff)
// กับชุดทองอำพันของ ufalion168 (d4922c fdfc71 f6e3b4 a25b24 33200a 1f1304 1a1000
// 0a0601 c9a46a fbf6e3 5a3310) และชุดฟ้าอะซัวร์ของ รวยแทร่168 (039cfa 0494f5
// c3ebfc 04366b f9a826 704504 e3f2fc 0b2d52 071e38) ก็ถูกถอดก่อนหน้าแล้ว
// 🚨🚨 **รอบนี้ชมพูเป็นฮิวนำ ส่วนไฟล์นี้เพิ่งมีแมเจนต้า c2178b ของ ZANE96 อยู่
// ที่ปลายแถบไฮไลต์** การเจอชมพู/แมเจนต้าในไฟล์นี้จึงไม่ได้แปลว่าเป็นของรอบนี้ —
// #a30d63 ไม่ใช่ c2178b ของ ZANE96 ไม่ใช่ a30d1a ของ 123BET (**ใกล้ที่สุด
// ในลิสต์ ต่างกันสองหลักท้าย**) ไม่ใช่ 9c0f55 หรือ b01160 ของ okkub88 ·
// #d11a7e ไม่ใช่ d91a73 ของ okkub88 (**ต่างกันไม่กี่หลัก**) ·
// #e0509f ไม่ใช่ fb439b ของ okkub88 ไม่ใช่ fa63b9 ของ ถอนชัวร์168 ·
// #440d31 ไม่ใช่ 6a0f3c ของ okkub88 ไม่ใช่ 6d0b3f ของ ถอนชัวร์168
// ให้เทียบเป็นค่าทีละตัวกับ .claude/brand-spec-abm96.md §2 ห้ามกะด้วยตา
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep ที่ไล่หาสีแบรนด์
// เก่าสะดุดที่คอมเมนต์ประวัติของไฟล์นี้เอง)
//
// รางเมนูเดสก์ท็อปคงที่ 640px เพราะรอบนี้มี 7 เมนูเท่าเดิม (ไม่มี ตรวจหวย/แนวทาง
// และไม่มี ทางเข้า) — ถ้ารอบหน้าเพิ่มเมนู ต้องขยายค่านี้ด้วย ไม่งั้นแต่ละช่องจะ
// บีบจนไอคอนกับชื่อชนกัน
//
// โลโก้ทั้งสองตัวคง loading="eager" ไว้ (อยู่เหนือ fold บน header ที่ sticky
// ถ้า lazy จะเห็นภาพโผล่ทีหลัง) แต่ไม่มี fetchpriority="high" — มีแค่ hero banner
// ตัวเดียวที่เป็น LCP จริงของทุกหน้าที่ได้ priority สูงสุด
// ⚠️ widths/sizes คิดใหม่จากบิตแมปจริงของดรอปนี้ ซึ่งเป็น **500x500 จัตุรัส** —
// โลโก้จัตุรัสที่สูง 38px ถูกวาดกว้างแค่ 38px (รอบก่อนไฟล์นี้ขอ 75px เพราะโลโก้
// ของแบรนด์นั้นเป็นเวิร์ดมาร์กแนวนอน) **ห้ามลอกตัวเลขข้ามดรอป**
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "📖" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];
---

<header class="sticky top-0 z-50 w-full font-sans shadow-lg">
  <div class="pointer-events-none absolute top-0 left-0 z-50 hidden h-0 w-full items-start justify-center lg:flex">
    <div
      class="pointer-events-auto flex h-[65px] w-[130px] items-center justify-center rounded-b-3xl border-x border-b border-[#e0509f] bg-gradient-to-b from-[#5e1746] to-[#440d31] shadow-[0_5px_18px_rgba(163,13,99,0.45)]">
      <a href="/" class="drop-shadow-[0_0_8px_rgba(224,80,159,0.55)] transition-transform hover:scale-110">
        <Picture
          src={mainLogo!}
          alt={logoAlt}
          loading="eager"
          widths={[38, 76, 114]}
          sizes="38px"
          class="h-[38px] w-auto"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={45}
        />
      </a>
    </div>
  </div>

  <aside
    class="fixed top-1/2 left-3 z-40 hidden h-[640px] max-h-[94vh] w-[92px] -translate-y-1/2 flex-col items-center justify-center rounded-2xl border border-[#e0509f]/70 bg-[#440d31]/95 p-2 shadow-[5px_0_22px_rgba(43,6,32,0.7)] backdrop-blur-md lg:flex">
    <div class="relative flex h-full w-full flex-col gap-2 overflow-hidden rounded-xl">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`group relative flex h-full w-full flex-col items-center justify-center rounded-lg transition-all ${isActive(link.path) ? "bg-[#5e1746]" : "hover:bg-[#5e1746]/70"}`}>
            <span aria-hidden="true" class="mb-1 text-2xl drop-shadow-md transition-transform group-hover:scale-110">
              {link.icon ?? "🔗"}
            </span>
            <span class={`text-xs font-bold transition-colors ${isActive(link.path) ? "text-[#ffeef8]" : "text-[#e8c3da] group-hover:text-[#ffeef8]"}`}>{link.name}</span>
            <div
              aria-hidden="true"
              class={`absolute top-0 left-0 h-full w-[3px] origin-top bg-gradient-to-b from-[#ff7ac2] via-[#e0509f] to-[#a30d63] transition-transform duration-300 ${isActive(link.path) ? "scale-y-100" : "scale-y-0 group-hover:scale-y-100"}`}
            />
          </a>
        ))
      }
    </div>
  </aside>

  <nav class="relative z-40 flex h-[60px] items-center justify-between border-b border-[#e0509f]/45 bg-[#440d31] px-3 shadow-xl lg:hidden">
    <button id="hamburger-btn" class="flex flex-col items-center justify-center space-y-1.5 p-2" aria-label="เปิดเมนู">
      <span class="hamburger-line h-0.5 w-6 origin-center bg-[#e0509f] transition-all duration-300"></span>
      <span class="hamburger-line h-0.5 w-6 bg-[#e0509f] transition-all duration-300"></span>
      <span class="hamburger-line h-0.5 w-6 origin-center bg-[#e0509f] transition-all duration-300"></span>
    </button>

    <a href="/" class="flex-shrink-0 transition-transform hover:scale-105">
      <Picture
        src={mainLogo!}
        alt={logoAlt}
        loading="eager"
        widths={[32, 64, 96]}
        sizes="32px"
        class="h-[32px] w-auto drop-shadow-md"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={32}
      />
    </a>

    <a
      href="/login"
      class="flex h-[32px] items-center justify-center rounded border border-[#e0509f] bg-gradient-to-r from-[#5e1746] to-[#440d31] px-4 text-xs font-bold text-[#ffeef8] shadow-[0_0_12px_rgba(163,13,99,0.4)] transition-transform active:scale-95">
      เข้าสู่ระบบ
    </a>
  </nav>

  <div id="mobile-overlay" class="pointer-events-none fixed inset-0 z-30 bg-black/80 opacity-0 backdrop-blur-sm transition-opacity duration-300 lg:hidden"></div>

  <div
    id="mobile-sidebar"
    class="fixed top-0 left-0 z-50 h-screen w-[260px] -translate-x-full transform overflow-y-auto border-r border-[#e0509f]/70 bg-[#440d31] shadow-[10px_0_30px_rgba(43,6,32,0.75)] transition-transform duration-300 ease-out lg:hidden">
    <div class="flex flex-col space-y-2.5 px-4 pt-16 pb-8">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`sidebar-item flex items-center rounded-lg border px-4 py-3 transition-all ${isActive(link.path) ? "border-[#e0509f] bg-[#5e1746] text-[#ffeef8] shadow-inner" : "border-transparent bg-white/5 text-[#e8c3da] hover:bg-white/10 hover:text-[#ffeef8]"}`}>
            <span aria-hidden="true" class="mr-3 text-xl">
              {link.icon ?? "🔗"}
            </span>
            <span class="text-sm font-bold">{link.name}</span>
          </a>
        ))
      }

      <div class="mt-5 flex flex-col gap-2 border-t border-[#e0509f]/60 pt-5">
        <a
          href="/register"
          class="sidebar-item flex items-center justify-center gap-2 rounded border border-[#a30d63] bg-gradient-to-r from-[#d11a7e] to-[#a30d63] py-3 text-sm font-bold text-[#ffffff] shadow-md transition-transform active:scale-95">
          <span aria-hidden="true">🃏</span>
          <span>สมัครสมาชิกใหม่</span>
        </a>
      </div>
    </div>
  </div>

  <div class="fixed top-4 right-6 z-50 hidden items-center gap-3 lg:flex">
    <a
      href="/login"
      class="group flex items-center gap-1.5 rounded border border-[#e0509f]/60 bg-[#440d31]/90 px-6 py-2 text-sm font-bold text-[#f2c14e] shadow-md backdrop-blur-sm transition-all hover:border-[#ff7ac2] hover:bg-[#5e1746]/90 hover:text-[#ffeef8]">
      <span aria-hidden="true">🔒</span>
      <span>เข้าสู่ระบบ</span>
    </a>
    <a
      href="/register"
      class="group flex items-center gap-1.5 rounded border border-[#a30d63] bg-gradient-to-r from-[#d11a7e] to-[#a30d63] px-6 py-2 text-sm font-bold text-[#ffffff] shadow-[0_0_15px_rgba(163,13,99,0.45)] transition-all hover:scale-105">
      <span aria-hidden="true">🃏</span>
      <span>สมัครสมาชิก</span>
    </a>
  </div>
</header>

<div class="hidden h-[15px] w-full lg:block"></div>

<style is:global>
  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  .sidebar-item {
    opacity: 0;
    transform: translateX(-20px);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .sidebar-item.item-show {
    opacity: 1;
    transform: translateX(0);
  }

  .sidebar-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .sidebar-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .sidebar-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .sidebar-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .sidebar-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .sidebar-item:nth-child(6) {
    transition-delay: 0.35s;
  }
  .sidebar-item:nth-child(7) {
    transition-delay: 0.4s;
  }
  .sidebar-item:nth-child(8) {
    transition-delay: 0.45s;
  }
  .sidebar-item:nth-child(9) {
    transition-delay: 0.5s;
  }
  .sidebar-item:nth-child(10) {
    transition-delay: 0.55s;
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar-item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const overlay = document.getElementById("mobile-overlay");
  const sidebar = document.getElementById("mobile-sidebar");
  const sidebarItems = document.querySelectorAll(".sidebar-item");

  const toggleSidebar = () => {
    hamburgerBtn?.classList.toggle("active");
    sidebar?.classList.toggle("-translate-x-full");
    sidebar?.classList.toggle("translate-x-0");
    overlay?.classList.toggle("opacity-0");
    overlay?.classList.toggle("opacity-100");
    overlay?.classList.toggle("pointer-events-none");
    overlay?.classList.toggle("pointer-events-auto");

    if (sidebar?.classList.contains("translate-x-0")) {
      document.body.style.overflow = "hidden";
      sidebarItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      sidebarItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleSidebar);
  overlay?.addEventListener("click", toggleSidebar);

  sidebarItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (sidebar?.classList.contains("translate-x-0")) {
        toggleSidebar();
      }
    });
  });
</script>
