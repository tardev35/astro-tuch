---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

// คำบรรยายเขียนจากไฟล์ logo.webp ของดรอป 2026-10-25 จริง (อ่านด้วย Read ก่อนเขียน)
// ไม่ใช่คัดลอกของรอบก่อน — **รอบนี้โลโก้เป็นเวิร์ดมาร์กล้วน ไม่มีสัญลักษณ์หรือ
// มาสคอตใดๆ อยู่ข้างหน้า** ชายการ์ตูนไว้หนวดสวมซอมเบรโรของ MEXICANOSLOT
// (แบรนด์ขาออก) ไม่มีอยู่ในรูปรอบนี้เลย เช่นเดียวกับตะกร้าเหรียญทองของ ร่ำรวย168
// และหัวสิงโตทองของ ufalion168 ที่เคยอยู่ในตัวแปรนี้มาก่อน
const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส เป็นเวิร์ดมาร์กล้วนไม่มีสัญลักษณ์ประกอบ เขียนด้วยตัวอักษรละตินหนาสามมิติผิวโครเมียมมันวาวเอียงไปทางขวา สี่ตัวอักษรแรกไล่เฉดจากฟ้าอิเล็กทริกเข้าหาม่วง ส่วนตัวเลขสองหลักท้ายเป็นสีชมพูแมเจนต้าไล่ลงม่วงเข้ม ทุกตัวตัดขอบสีขาวหนาและมีแสงสะท้อนสีขาวพาดอยู่ด้านบน มีประกายดาวสี่แฉกสีขาวอมม่วงประดับอยู่ที่มุมบนขวาและมุมล่างของตัวเลข`;

// สมัครสมาชิก/เข้าสู่ระบบ อยู่ถัดจากโปรโมชั่นทันที เพราะเป็นปุ่ม conversion
// ไม่ใช่หน้าให้อ่าน — ที่เหลือเป็นหน้าเนื้อหาเรียงต่อท้าย
//
// ไม่มี ตรวจหวย/แนวทาง: ZANE96 เป็นเว็บสล็อต ไม่ใช่เว็บหวย สองหน้านั้นอยู่ใน
// src/pages-disabled/ จึงไม่มี route ให้ลิงก์ไปหา — ลิงก์ที่ค้างอยู่จะทำให้
// verify-build แดงด้วย (href ชี้ไป route ที่ไม่มีอยู่จริง) ลบออกจาก links ตัวนี้
// ตัวเดียวพอ เพราะทั้งรางเดสก์ท็อปและ drawer มือถืออ่าน array เดียวกัน
// ไม่มี ทางเข้า: toggle cta เปิดอยู่ /register กับ /login จึงเป็นหน้าจริงในเมนูแล้ว
// ทางเข้าจะกลายเป็นลิงก์ที่สามที่พาไปที่เดียวกัน (หน้ายังถูก route และ index อยู่
// และ footer ยังลิงก์ไปหาอยู่)
// ไอคอนรอบนี้เลือกตามแนวแบรนด์ **สล็อตออนไลน์** (ตู้สล็อต ของขวัญ กุญแจ) ไม่ใช่
// ลูกฟุตบอล/สิงโตแบบแบรนด์กีฬาที่เคยถือไฟล์นี้ และอยู่ใน <span aria-hidden="true">
// ที่เป็นพี่น้องของป้ายชื่อเสมอ ไม่ได้ฝังในข้อความ
//
// ZANE96 (รอบไวโอเลตนีออนนำ-ฟ้าอิเล็กทริกรอง 2026-10-25): navbar ตัวนี้เป็น
// "รางแนวตั้งลอยริมซ้าย" จึงประกาศสีตัวอักษรของตัวเองครบทุกจุด ไม่ได้ inherit
// BRAND_TEXT (ซึ่งรอบนี้เป็นหมึกเข้ม #241046 สำหรับผิวสว่าง และจะอ่านไม่ออกบนโครม)
// ⚠️⚠️ **รอบนี้เป็นธีมสว่าง พื้นเพจเป็นไลแลค #f8e6f9 (bg.json) แต่โครมเป็นผิวเข้ม**
// — สองครึ่งอยู่คนละทิศโดยตั้งใจ **ห้าม "แก้" ให้ navbar สว่างตามพื้นเพจ**
// ผิวแผงเป็น #190b3d (อินดิโกม่วงจม) การ์ด/สถานะ active เป็น #271257
// ขอบไวโอเลตแบรนด์ #bb6dff ตัวหนังสือม่วงจาง #c0a6e8 (8.6:1 บนผิวแผง)
// -> ขาวอมม่วง #f3e8ff (15.4:1 บนผิวแผง) ตอน active
// แถบไฮไลต์ซ้ายไล่ฟ้าอิเล็กทริก #7aa7ff -> ไวโอเลต #bb6dff -> แมเจนต้า #c2178b
// ตามไล่เฉดในโลโก้ที่ไล่จากฟ้าที่ตัวอักษรแรกไปจบที่แมเจนต้าที่ตัวเลข
// ปุ่มสมัครเป็น **ปุ่มเน้น**: ไล่ #7aa7ff -> #bb6dff + หมึก #190b3d
// (7.6:1 และ 5.8:1 ผ่านทั้งสองสต็อป)
// ⚠️⚠️ **ห้ามใส่ตัวอักษรขาวบน #bb6dff หรือ #7aa7ff เด็ดขาด** (2.6 / 2.0:1)
// สองค่านั้นเป็นพื้นที่รับหมึก **เข้ม** เท่านั้น ส่วน #5411c4 กับ #7a1bd6 เป็นสีเส้น
// ขอบ ออรา และพื้นปุ่มที่ใช้หมึก **ขาว** ได้ (9.3 / 7.1:1)
// — ชุดฟ้าไซยาน-ครีมอุ่นของ ร่ำรวย168 (18a5e2 0d6b9b 0a5176 a9d7f2 111a3f 202a66
// e9f1ff adc0e4 f4e4d3 e4cbb3 dbe6ff) ถูกถอดหมดแล้ว พร้อมกับคำบรรยายโลโก้ที่เป็น
// ตะกร้าเหรียญทอง และชุดทองอำพันของ ufalion168 (d4922c fdfc71 f6e3b4 a25b24 33200a
// 1f1304 1a1000 0a0601 c9a46a fbf6e3 5a3310) กับชุดฟ้าอะซัวร์ของ รวยแทร่168
// (039cfa 0494f5 c3ebfc 04366b f9a826 704504 e3f2fc 0b2d52 071e38) ก็ถูกถอดก่อนหน้าแล้ว
// 🚨🚨 **รอบนี้ม่วงเป็นฮิวนำและฟ้าเป็นคู่รอง ส่วนไฟล์นี้เพิ่งเป็นฟ้าของ ร่ำรวย168
// มาก่อน** การเจอฟ้า/ม่วงในไฟล์นี้จึงไม่ได้แปลว่าเป็นของรอบนี้ —
// #7aa7ff ไม่ใช่ 60a5fa (default cyber) ไม่ใช่ a9d7f2 ของร่ำรวย168 ไม่ใช่ 6ec8ff
// ของ TSDET911 · #bb6dff ไม่ใช่ b453ff ของ KMD88 (**ใกล้ที่สุดในลิสต์ ต่างกัน
// ไบต์เดียว**) · #c2178b ไม่ใช่ d91a73 ของ okkub88 · #5411c4 ไม่ใช่ 7505cc ของ KMD88
// ให้เทียบเป็นค่าทีละตัวกับ .claude/brand-spec-zane96.md §2 ห้ามกะด้วยตา
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep ที่ไล่หาสีแบรนด์
// เก่าสะดุดที่คอมเมนต์ประวัติของไฟล์นี้เอง)
//
// รางเมนูเดสก์ท็อปคงที่ 640px เพราะรอบนี้มี 7 เมนูเท่าเดิม (ไม่มี ตรวจหวย/แนวทาง
// และไม่มี ทางเข้า) — ถ้ารอบหน้าเพิ่มเมนู ต้องขยายค่านี้ด้วย ไม่งั้นแต่ละช่องจะ
// บีบจนไอคอนกับชื่อชนกัน
//
// โลโก้ทั้งสองตัวคง loading="eager" ไว้ (อยู่เหนือ fold บน header ที่ sticky
// ถ้า lazy จะเห็นภาพโผล่ทีหลัง) แต่ไม่มี fetchpriority="high" — มีแค่ hero banner
// ตัวเดียวที่เป็น LCP จริงของทุกหน้าที่ได้ priority สูงสุด
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "📖" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];
---

<header class="sticky top-0 z-50 w-full font-sans shadow-lg">
  <div class="pointer-events-none absolute top-0 left-0 z-50 hidden h-0 w-full items-start justify-center lg:flex">
    <div
      class="pointer-events-auto flex h-[65px] w-[130px] items-center justify-center rounded-b-3xl border-x border-b border-[#bb6dff] bg-gradient-to-b from-[#271257] to-[#190b3d] shadow-[0_5px_18px_rgba(122,27,214,0.45)]">
      <a href="/" class="drop-shadow-[0_0_8px_rgba(187,109,255,0.55)] transition-transform hover:scale-110">
        <Picture
          src={mainLogo!}
          alt={logoAlt}
          loading="eager"
          widths={[75, 150, 225]}
          sizes="75px"
          class="h-[38px] w-auto"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={45}
        />
      </a>
    </div>
  </div>

  <aside
    class="fixed top-1/2 left-3 z-40 hidden h-[640px] max-h-[94vh] w-[92px] -translate-y-1/2 flex-col items-center justify-center rounded-2xl border border-[#bb6dff]/70 bg-[#190b3d]/95 p-2 shadow-[5px_0_22px_rgba(16,6,38,0.7)] backdrop-blur-md lg:flex">
    <div class="relative flex h-full w-full flex-col gap-2 overflow-hidden rounded-xl">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`group relative flex h-full w-full flex-col items-center justify-center rounded-lg transition-all ${isActive(link.path) ? "bg-[#271257]" : "hover:bg-[#271257]/70"}`}>
            <span aria-hidden="true" class="mb-1 text-2xl drop-shadow-md transition-transform group-hover:scale-110">
              {link.icon ?? "🔗"}
            </span>
            <span class={`text-xs font-bold transition-colors ${isActive(link.path) ? "text-[#f3e8ff]" : "text-[#c0a6e8] group-hover:text-[#f3e8ff]"}`}>{link.name}</span>
            <div
              aria-hidden="true"
              class={`absolute top-0 left-0 h-full w-[3px] origin-top bg-gradient-to-b from-[#7aa7ff] via-[#bb6dff] to-[#c2178b] transition-transform duration-300 ${isActive(link.path) ? "scale-y-100" : "scale-y-0 group-hover:scale-y-100"}`}
            />
          </a>
        ))
      }
    </div>
  </aside>

  <nav class="relative z-40 flex h-[60px] items-center justify-between border-b border-[#bb6dff]/45 bg-[#190b3d] px-3 shadow-xl lg:hidden">
    <button id="hamburger-btn" class="flex flex-col items-center justify-center space-y-1.5 p-2" aria-label="เปิดเมนู">
      <span class="hamburger-line h-0.5 w-6 origin-center bg-[#bb6dff] transition-all duration-300"></span>
      <span class="hamburger-line h-0.5 w-6 bg-[#bb6dff] transition-all duration-300"></span>
      <span class="hamburger-line h-0.5 w-6 origin-center bg-[#bb6dff] transition-all duration-300"></span>
    </button>

    <a href="/" class="flex-shrink-0 transition-transform hover:scale-105">
      <Picture
        src={mainLogo!}
        alt={logoAlt}
        loading="eager"
        widths={[75, 150, 225]}
        sizes="62px"
        class="h-[32px] w-auto drop-shadow-md"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={45}
      />
    </a>

    <a
      href="/login"
      class="flex h-[32px] items-center justify-center rounded border border-[#bb6dff] bg-gradient-to-r from-[#271257] to-[#190b3d] px-4 text-xs font-bold text-[#f3e8ff] shadow-[0_0_12px_rgba(122,27,214,0.4)] transition-transform active:scale-95">
      เข้าสู่ระบบ
    </a>
  </nav>

  <div id="mobile-overlay" class="pointer-events-none fixed inset-0 z-30 bg-black/80 opacity-0 backdrop-blur-sm transition-opacity duration-300 lg:hidden"></div>

  <div
    id="mobile-sidebar"
    class="fixed top-0 left-0 z-50 h-screen w-[260px] -translate-x-full transform overflow-y-auto border-r border-[#bb6dff]/70 bg-[#190b3d] shadow-[10px_0_30px_rgba(16,6,38,0.75)] transition-transform duration-300 ease-out lg:hidden">
    <div class="flex flex-col space-y-2.5 px-4 pt-16 pb-8">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`sidebar-item flex items-center rounded-lg border px-4 py-3 transition-all ${isActive(link.path) ? "border-[#bb6dff] bg-[#271257] text-[#f3e8ff] shadow-inner" : "border-transparent bg-white/5 text-[#c0a6e8] hover:bg-white/10 hover:text-[#f3e8ff]"}`}>
            <span aria-hidden="true" class="mr-3 text-xl">
              {link.icon ?? "🔗"}
            </span>
            <span class="text-sm font-bold">{link.name}</span>
          </a>
        ))
      }

      <div class="mt-5 flex flex-col gap-2 border-t border-[#bb6dff]/60 pt-5">
        <a
          href="/register"
          class="sidebar-item flex items-center justify-center gap-2 rounded border border-[#5411c4] bg-gradient-to-r from-[#7aa7ff] to-[#bb6dff] py-3 text-sm font-bold text-[#190b3d] shadow-md transition-transform active:scale-95">
          <span aria-hidden="true">🪙</span>
          <span>สมัครสมาชิกใหม่</span>
        </a>
      </div>
    </div>
  </div>

  <div class="fixed top-4 right-6 z-50 hidden items-center gap-3 lg:flex">
    <a
      href="/login"
      class="group flex items-center gap-1.5 rounded border border-[#bb6dff]/60 bg-[#190b3d]/90 px-6 py-2 text-sm font-bold text-[#bb6dff] shadow-md backdrop-blur-sm transition-all hover:border-[#7aa7ff] hover:bg-[#271257]/90 hover:text-[#7aa7ff]">
      <span aria-hidden="true">🔒</span>
      <span>เข้าสู่ระบบ</span>
    </a>
    <a
      href="/register"
      class="group flex items-center gap-1.5 rounded border border-[#5411c4] bg-gradient-to-r from-[#7aa7ff] to-[#bb6dff] px-6 py-2 text-sm font-bold text-[#190b3d] shadow-[0_0_15px_rgba(122,27,214,0.45)] transition-all hover:scale-105">
      <span aria-hidden="true">🎰</span>
      <span>สมัครสมาชิก</span>
    </a>
  </div>
</header>

<div class="hidden h-[15px] w-full lg:block"></div>

<style is:global>
  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  .sidebar-item {
    opacity: 0;
    transform: translateX(-20px);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .sidebar-item.item-show {
    opacity: 1;
    transform: translateX(0);
  }

  .sidebar-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .sidebar-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .sidebar-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .sidebar-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .sidebar-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .sidebar-item:nth-child(6) {
    transition-delay: 0.35s;
  }
  .sidebar-item:nth-child(7) {
    transition-delay: 0.4s;
  }
  .sidebar-item:nth-child(8) {
    transition-delay: 0.45s;
  }
  .sidebar-item:nth-child(9) {
    transition-delay: 0.5s;
  }
  .sidebar-item:nth-child(10) {
    transition-delay: 0.55s;
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar-item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const overlay = document.getElementById("mobile-overlay");
  const sidebar = document.getElementById("mobile-sidebar");
  const sidebarItems = document.querySelectorAll(".sidebar-item");

  const toggleSidebar = () => {
    hamburgerBtn?.classList.toggle("active");
    sidebar?.classList.toggle("-translate-x-full");
    sidebar?.classList.toggle("translate-x-0");
    overlay?.classList.toggle("opacity-0");
    overlay?.classList.toggle("opacity-100");
    overlay?.classList.toggle("pointer-events-none");
    overlay?.classList.toggle("pointer-events-auto");

    if (sidebar?.classList.contains("translate-x-0")) {
      document.body.style.overflow = "hidden";
      sidebarItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      sidebarItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleSidebar);
  overlay?.addEventListener("click", toggleSidebar);

  sidebarItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (sidebar?.classList.contains("translate-x-0")) {
        toggleSidebar();
      }
    });
  });
</script>
