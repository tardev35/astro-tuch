---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

// คำบรรยายเขียนจากไฟล์ logo.webp ของดรอป 2026-10-20 จริง (อ่านด้วย Read ก่อนเขียน)
// ไม่ใช่คัดลอกของรอบก่อน — ถุงเงินสีฟ้าสลักดอลลาร์ ปึกธนบัตรฟ้า และตัวอักษรฟ้า
// อะซัวร์ของ รวยแทร่168 ที่เคยอยู่ในตัวแปรนี้ไม่มีอยู่ในรูปรอบนี้เลย และเหรียญตรา
// ถ้วยรางวัลของ UFA324 (แบรนด์เว็บกีฬาคนละเจ้า) ก็ไม่มี
const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส กลางภาพเป็นหัวสิงโตทองคำขนแผงฟู สวมมงกุฎทองยอดแหลม วางอยู่บนริ้วทองเหลวโค้งที่สาดกระเซ็นออกไปทั้งสองข้าง ล้อมด้วยประกายดาวสีทอง ใต้ลงมาเป็นชื่อแบรนด์ตัวอักษรหนาสามมิติผิวทองมันวาว โดยส่วน ufa และ 168 เป็นทองเข้มกว่า ส่วน lion เป็นทองอ่อนกว่า และตัวอักษรโอในคำว่า lion มีมงกุฎทองขนาดเล็กวางอยู่ข้างใน`;

// สมัครสมาชิก/เข้าสู่ระบบ อยู่ถัดจากโปรโมชั่นทันที เพราะเป็นปุ่ม conversion
// ไม่ใช่หน้าให้อ่าน — ที่เหลือเป็นหน้าเนื้อหาเรียงต่อท้าย
//
// ไม่มี ตรวจหวย/แนวทาง: ufalion168 เป็นเว็บบอล/กีฬา ไม่ใช่เว็บหวย สองหน้านั้น
// อยู่ใน src/pages-disabled/ จึงไม่มี route ให้ลิงก์ไปหา — ลิงก์ที่ค้างอยู่จะ
// ทำให้ verify-build แดงด้วย (href ชี้ไป route ที่ไม่มีอยู่จริง) ลบออกจาก links
// ตัวนี้ตัวเดียวพอ เพราะทั้งรางเดสก์ท็อปและ drawer มือถืออ่าน array เดียวกัน
// ไม่มี ทางเข้า: toggle cta เปิดอยู่ /register กับ /login จึงเป็นหน้าจริงในเมนูแล้ว
// ทางเข้าจะกลายเป็นลิงก์ที่สามที่พาไปที่เดียวกัน (หน้ายังถูก route และ index อยู่
// และ footer ยังลิงก์ไปหาอยู่)
// ไอคอนรอบนี้เลือกตามแนวแบรนด์ **ฟุตบอล/กีฬา** (ลูกบอล/สิงโตประจำแบรนด์) ไม่ใช่
// ตู้สล็อต/ถุงเงินแบบแบรนด์สล็อตรอบก่อน และอยู่ใน <span aria-hidden="true"> ที่เป็น
// พี่น้องของป้ายชื่อเสมอ ไม่ได้ฝังในข้อความ
//
// ufalion168 (รอบทองอำพันนำ-ทองเลมอนเฉดสว่าง 2026-10-20): navbar ตัวนี้เป็น
// "รางแนวตั้งลอยริมซ้าย" จึงประกาศสีตัวอักษรของตัวเองครบทุกจุด ไม่ได้ inherit
// BRAND_TEXT ผิวแผงเป็น #1f1304 ให้สว่างกว่าพื้นเพจดำสนิท #000000 เล็กน้อย
// แผงเมนูจึงอ่านเป็นชั้นลอย การ์ด/สถานะ active เป็น #33200a ขอบทองแบรนด์ #d4922c
// ตัวหนังสือทองหม่น #c9a46a (7.8:1 บนผิวแผง) -> งาช้าง #fbf6e3 ตอน active
// แถบไฮไลต์ซ้ายไล่ทองเลมอน #fdfc71 -> ทองอำพัน #d4922c -> บรอนซ์ #a25b24
// ตามไล่เฉดในโลโก้ที่ไล่จากยอดสว่างลงไปถึงเงาบรอนซ์
// ปุ่มสมัครไล่ทองเลมอน #fdfc71 -> ครีมทอง #f6e3b4 -> ทองอำพัน #d4922c
// ⚠️ **ปลายเข้มของไล่เฉดปุ่มต้องหยุดที่ #d4922c ห้ามไล่ลงไปถึงบรอนซ์ #a25b24**
// ซึ่งรองหมึก #1a1000 ได้แค่ 3.6:1 (ตก AA) — #a25b24 และ #5a3310 เป็นสีเส้น
// ขอบ และออราเท่านั้น ห้ามถือตัวอักษรทุกขนาดในไฟล์นี้
// — ชุดฟ้าอะซัวร์-ทองอำพันของ รวยแทร่168 (039cfa 0494f5 c3ebfc 04366b f9a826
// 704504 e3f2fc 0b2d52 071e38 030f1d 031320 7fa8cc) ถูกถอดหมดแล้ว พร้อมกับ
// คำบรรยายโลโก้ที่เป็นถุงเงินสีฟ้า
// ⚠️ **รอบนี้ทองเป็นฮิวนำ และทองเคยถูกใช้มาเกือบทุกแบรนด์** การเจอทองในไฟล์นี้
// จึงไม่ได้แปลว่าเป็นของรอบนี้ — #d4922c ไม่ใช่ f9a826 ของรวยแทร่168 ไม่ใช่
// f0bb4e ของรวยเทพ168 รอบก่อน ไม่ใช่ e5a81b ของ UFA324 ไม่ใช่ dfa310 ของ TND168
// (ซึ่งใกล้ที่สุด ต่างที่ G146 vs G163 และ B44 vs B16) ให้เทียบเป็นค่าทีละตัว
// กับ .claude/brand-spec-ufalion168.md §2 ห้ามกะด้วยตา
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep ที่ไล่หาสีแบรนด์
// เก่าสะดุดที่คอมเมนต์ประวัติของไฟล์นี้เอง)
//
// รางเมนูเดสก์ท็อปคงที่ 640px เพราะรอบนี้มี 7 เมนูเท่าเดิม (ไม่มี ตรวจหวย/แนวทาง
// และไม่มี ทางเข้า) — ถ้ารอบหน้าเพิ่มเมนู ต้องขยายค่านี้ด้วย ไม่งั้นแต่ละช่องจะ
// บีบจนไอคอนกับชื่อชนกัน
//
// โลโก้ทั้งสองตัวคง loading="eager" ไว้ (อยู่เหนือ fold บน header ที่ sticky
// ถ้า lazy จะเห็นภาพโผล่ทีหลัง) แต่ไม่มี fetchpriority="high" — มีแค่ hero banner
// ตัวเดียวที่เป็น LCP จริงของทุกหน้าที่ได้ priority สูงสุด
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "⚽" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🦁" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];
---

<header class="sticky top-0 z-50 w-full font-sans shadow-lg">
  <div class="pointer-events-none absolute top-0 left-0 z-50 hidden h-0 w-full items-start justify-center lg:flex">
    <div
      class="pointer-events-auto flex h-[65px] w-[130px] items-center justify-center rounded-b-3xl border-x border-b border-[#d4922c] bg-gradient-to-b from-[#33200a] to-[#1f1304] shadow-[0_5px_18px_rgba(212,146,44,0.45)]">
      <a href="/" class="drop-shadow-[0_0_8px_rgba(253,252,113,0.55)] transition-transform hover:scale-110">
        <Picture
          src={mainLogo!}
          alt={logoAlt}
          loading="eager"
          widths={[75, 150, 225]}
          sizes="75px"
          class="h-[38px] w-auto"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={45}
        />
      </a>
    </div>
  </div>

  <aside
    class="fixed top-1/2 left-3 z-40 hidden h-[640px] max-h-[94vh] w-[92px] -translate-y-1/2 flex-col items-center justify-center rounded-2xl border border-[#d4922c]/70 bg-[#1f1304]/95 p-2 shadow-[5px_0_22px_rgba(0,0,0,0.7)] backdrop-blur-md lg:flex">
    <div class="relative flex h-full w-full flex-col gap-2 overflow-hidden rounded-xl">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`group relative flex h-full w-full flex-col items-center justify-center rounded-lg transition-all ${isActive(link.path) ? "bg-[#33200a]" : "hover:bg-[#33200a]/70"}`}>
            <span aria-hidden="true" class="mb-1 text-2xl drop-shadow-md transition-transform group-hover:scale-110">
              {link.icon ?? "🔗"}
            </span>
            <span class={`text-xs font-bold transition-colors ${isActive(link.path) ? "text-[#fbf6e3]" : "text-[#c9a46a] group-hover:text-[#fbf6e3]"}`}>{link.name}</span>
            <div
              aria-hidden="true"
              class={`absolute top-0 left-0 h-full w-[3px] origin-top bg-gradient-to-b from-[#fdfc71] via-[#d4922c] to-[#a25b24] transition-transform duration-300 ${isActive(link.path) ? "scale-y-100" : "scale-y-0 group-hover:scale-y-100"}`}
            />
          </a>
        ))
      }
    </div>
  </aside>

  <nav class="relative z-40 flex h-[60px] items-center justify-between border-b border-[#d4922c]/45 bg-[#1f1304] px-3 shadow-xl lg:hidden">
    <button id="hamburger-btn" class="flex flex-col items-center justify-center space-y-1.5 p-2" aria-label="เปิดเมนู">
      <span class="hamburger-line h-0.5 w-6 origin-center bg-[#d4922c] transition-all duration-300"></span>
      <span class="hamburger-line h-0.5 w-6 bg-[#d4922c] transition-all duration-300"></span>
      <span class="hamburger-line h-0.5 w-6 origin-center bg-[#d4922c] transition-all duration-300"></span>
    </button>

    <a href="/" class="flex-shrink-0 transition-transform hover:scale-105">
      <Picture
        src={mainLogo!}
        alt={logoAlt}
        loading="eager"
        widths={[75, 150, 225]}
        sizes="62px"
        class="h-[32px] w-auto drop-shadow-md"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={45}
      />
    </a>

    <a
      href="/login"
      class="flex h-[32px] items-center justify-center rounded border border-[#d4922c] bg-gradient-to-r from-[#33200a] to-[#1f1304] px-4 text-xs font-bold text-[#fbf6e3] shadow-[0_0_12px_rgba(212,146,44,0.4)] transition-transform active:scale-95">
      เข้าสู่ระบบ
    </a>
  </nav>

  <div id="mobile-overlay" class="pointer-events-none fixed inset-0 z-30 bg-black/80 opacity-0 backdrop-blur-sm transition-opacity duration-300 lg:hidden"></div>

  <div
    id="mobile-sidebar"
    class="fixed top-0 left-0 z-50 h-screen w-[260px] -translate-x-full transform overflow-y-auto border-r border-[#d4922c]/70 bg-[#1f1304] shadow-[10px_0_30px_rgba(0,0,0,0.75)] transition-transform duration-300 ease-out lg:hidden">
    <div class="flex flex-col space-y-2.5 px-4 pt-16 pb-8">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`sidebar-item flex items-center rounded-lg border px-4 py-3 transition-all ${isActive(link.path) ? "border-[#d4922c] bg-[#33200a] text-[#fbf6e3] shadow-inner" : "border-transparent bg-white/5 text-[#c9a46a] hover:bg-white/10 hover:text-[#fbf6e3]"}`}>
            <span aria-hidden="true" class="mr-3 text-xl">
              {link.icon ?? "🔗"}
            </span>
            <span class="text-sm font-bold">{link.name}</span>
          </a>
        ))
      }

      <div class="mt-5 flex flex-col gap-2 border-t border-[#d4922c]/60 pt-5">
        <a
          href="/register"
          class="sidebar-item flex items-center justify-center gap-2 rounded border border-[#a25b24] bg-gradient-to-r from-[#fdfc71] via-[#f6e3b4] to-[#d4922c] py-3 text-sm font-bold text-[#1a1000] shadow-md transition-transform active:scale-95">
          <span aria-hidden="true">🏆</span>
          <span>สมัครสมาชิกใหม่</span>
        </a>
      </div>
    </div>
  </div>

  <div class="fixed top-4 right-6 z-50 hidden items-center gap-3 lg:flex">
    <a
      href="/login"
      class="group flex items-center gap-1.5 rounded border border-[#d4922c]/60 bg-[#0a0601]/90 px-6 py-2 text-sm font-bold text-[#d4922c] shadow-md backdrop-blur-sm transition-all hover:border-[#fdfc71] hover:bg-[#33200a]/90">
      <span aria-hidden="true">🔒</span>
      <span>เข้าสู่ระบบ</span>
    </a>
    <a
      href="/register"
      class="group flex items-center gap-1.5 rounded border border-[#a25b24] bg-gradient-to-r from-[#fdfc71] via-[#f6e3b4] to-[#d4922c] px-6 py-2 text-sm font-bold text-[#1a1000] shadow-[0_0_15px_rgba(212,146,44,0.45)] transition-all hover:scale-105">
      <span aria-hidden="true">⚽</span>
      <span>สมัครสมาชิก</span>
    </a>
  </div>
</header>

<div class="hidden h-[15px] w-full lg:block"></div>

<style is:global>
  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  .sidebar-item {
    opacity: 0;
    transform: translateX(-20px);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .sidebar-item.item-show {
    opacity: 1;
    transform: translateX(0);
  }

  .sidebar-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .sidebar-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .sidebar-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .sidebar-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .sidebar-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .sidebar-item:nth-child(6) {
    transition-delay: 0.35s;
  }
  .sidebar-item:nth-child(7) {
    transition-delay: 0.4s;
  }
  .sidebar-item:nth-child(8) {
    transition-delay: 0.45s;
  }
  .sidebar-item:nth-child(9) {
    transition-delay: 0.5s;
  }
  .sidebar-item:nth-child(10) {
    transition-delay: 0.55s;
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar-item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const overlay = document.getElementById("mobile-overlay");
  const sidebar = document.getElementById("mobile-sidebar");
  const sidebarItems = document.querySelectorAll(".sidebar-item");

  const toggleSidebar = () => {
    hamburgerBtn?.classList.toggle("active");
    sidebar?.classList.toggle("-translate-x-full");
    sidebar?.classList.toggle("translate-x-0");
    overlay?.classList.toggle("opacity-0");
    overlay?.classList.toggle("opacity-100");
    overlay?.classList.toggle("pointer-events-none");
    overlay?.classList.toggle("pointer-events-auto");

    if (sidebar?.classList.contains("translate-x-0")) {
      document.body.style.overflow = "hidden";
      sidebarItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      sidebarItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleSidebar);
  overlay?.addEventListener("click", toggleSidebar);

  sidebarItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (sidebar?.classList.contains("translate-x-0")) {
        toggleSidebar();
      }
    });
  });
</script>
