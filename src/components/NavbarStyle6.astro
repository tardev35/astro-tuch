---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

const logoAlt = "โลโก้ HI59 ตัวอักษรละตินหนาแบบสามมิติบนพื้นโปร่งใส คำว่า HI เป็นสีฟ้าเงาวาว ส่วนตัวเลข 59 เป็นสีทองไล่เฉดวาว ล้อมด้วยวงแหวนโค้งสีทองด้านบนและสีฟ้าด้านล่าง";

// สมัครสมาชิก/เข้าสู่ระบบ อยู่ถัดจากโปรโมชั่นทันที เพราะเป็นปุ่ม conversion
// ไม่ใช่หน้าให้อ่าน — ที่เหลือเป็นหน้าเนื้อหาเรียงต่อท้าย
//
// ไม่มี ตรวจหวย/แนวทาง แล้ว: HI59 เป็นเว็บสล็อต ไม่ใช่เว็บหวย สองหน้านั้นถูกย้าย
// ไป src/pages-disabled/ รอบนี้ จึงไม่มี route ให้ลิงก์ไปหา — ลิงก์ที่ค้างอยู่จะ
// ทำให้ verify-build แดงด้วย (href ชี้ไป route ที่ไม่มีอยู่จริง) ลบออกจาก links
// ตัวนี้ตัวเดียวพอ เพราะทั้งรางเดสก์ท็อปและ drawer มือถืออ่าน array เดียวกัน
// ไม่มี ทางเข้า: toggle cta เปิดอยู่ /register กับ /login จึงเป็นหน้าจริงในเมนูแล้ว
// ทางเข้าจะกลายเป็นลิงก์ที่สามที่พาไปที่เดียวกัน (หน้ายังถูก route และ index อยู่
// และ footer ยังลิงก์ไปหาอยู่)
//
// HI59 (รอบฟ้า-ทอง 2026-10-07): navbar เป็น "โครม" จึงยังเป็นผิวเข้มกรมท่า
// #04203f แม้ทั้งเว็บรอบนี้จะสว่าง — มันประกาศสีตัวอักษรของตัวเองครบทุกจุด ไม่ได้
// inherit BRAND_TEXT และโลโก้ฟ้า-ทองต้องการพื้นเข้มถึงจะอ่านออก
// การ์ด/สถานะ active เป็น #073059 ขอบฟ้าแบรนด์ #0a84e0 ตัวหนังสือฟ้าหม่น #a9c9e8
// → ฟ้าสว่าง #e4f1fd ตอน active แถบไฮไลต์ซ้ายไล่ทองอ่อน → ทองแบรนด์ → ฟ้าสว่าง
// ตามคู่สีในโลโก้ที่ "HI" เป็นฟ้าและ "59" เป็นทอง
// ปุ่มสมัครไล่เฉดทองอ่อน #ffe27a → ทองแบรนด์ #fdbc04 → ทองเข้ม #c88a02
// — ชุดแดงเข้ม-ทองของ หวยเฮง24 (#1a0505 #3d0808 #e0a52a #d9bfa2 #fdf0dc #fdea83
// #fbdc64 #bd7c13 #c01616 #8b0302 #2a0606 #2e0707 #f0d9b8) ถูกถอดหมด
//
// ปุ่มพื้นทองใช้หมึกกรมท่าเข้ม #04203f (คอนทราสต์ 9.2:1 บน #fdbc04) — ฟ้าสว่าง
// บนทองตก AA ส่วนปุ่มพื้นฟ้าเข้มใช้หมึกฟ้าสว่าง #eaf5ff (7.4:1 บน #065a9c)
// สลับกันไม่ได้ ถ้าจะปรับสีปุ่มรอบหน้า ให้เช็กคู่พื้น-หมึกใหม่ทุกครั้ง
//
// รางเมนูเดสก์ท็อปลดกลับเป็น 640px เพราะรอบนี้เหลือ 7 เมนู (ถอด ตรวจหวย/แนวทาง
// ออก) — ที่ 740px เดิมแต่ละช่องจะกว้าง ~106px ทำให้รางสูงเกินไปจนลอยเลยกรอบจอ
//
// โลโก้ทั้งสองตัวคง loading="eager" ไว้ (อยู่เหนือ fold บน header ที่ sticky
// ถ้า lazy จะเห็นภาพโผล่ทีหลัง) แต่ไม่มี fetchpriority="high" — มีแค่ hero banner
// ตัวเดียวที่เป็น LCP จริงของทุกหน้าที่ได้ priority สูงสุด
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🏢" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];
---

<header class="sticky top-0 z-50 w-full font-sans shadow-lg">
  <div class="pointer-events-none absolute top-0 left-0 z-50 hidden h-0 w-full items-start justify-center lg:flex">
    <div
      class="pointer-events-auto flex h-[65px] w-[130px] items-center justify-center rounded-b-3xl border-x border-b border-[#0a84e0] bg-gradient-to-b from-[#073059] to-[#04203f] shadow-[0_5px_18px_rgba(10,132,224,0.45)]">
      <a href="/" class="drop-shadow-[0_0_8px_rgba(253,188,4,0.55)] transition-transform hover:scale-110">
        <Picture
          src={mainLogo!}
          alt={logoAlt}
          loading="eager"
          widths={[75, 150, 225]}
          sizes="75px"
          class="h-[38px] w-auto"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={45}
        />
      </a>
    </div>
  </div>

  <aside
    class="fixed top-1/2 left-3 z-40 hidden h-[640px] max-h-[94vh] w-[92px] -translate-y-1/2 flex-col items-center justify-center rounded-2xl border border-[#0a84e0]/70 bg-[#04203f]/95 p-2 shadow-[5px_0_22px_rgba(3,26,52,0.55)] backdrop-blur-md lg:flex">
    <div class="relative flex h-full w-full flex-col gap-2 overflow-hidden rounded-xl">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`group relative flex h-full w-full flex-col items-center justify-center rounded-lg transition-all ${isActive(link.path) ? "bg-[#073059]" : "hover:bg-[#073059]/70"}`}>
            <span aria-hidden="true" class="mb-1 text-2xl drop-shadow-md transition-transform group-hover:scale-110">
              {link.icon ?? "🔗"}
            </span>
            <span class={`text-xs font-bold transition-colors ${isActive(link.path) ? "text-[#e4f1fd]" : "text-[#a9c9e8] group-hover:text-[#e4f1fd]"}`}>{link.name}</span>
            <div
              aria-hidden="true"
              class={`absolute top-0 left-0 h-full w-[3px] origin-top bg-gradient-to-b from-[#ffe27a] via-[#fdbc04] to-[#5ec2ff] transition-transform duration-300 ${isActive(link.path) ? "scale-y-100" : "scale-y-0 group-hover:scale-y-100"}`}
            />
          </a>
        ))
      }
    </div>
  </aside>

  <nav class="relative z-40 flex h-[60px] items-center justify-between border-b border-[#0a84e0]/45 bg-[#04203f] px-3 shadow-xl lg:hidden">
    <button id="hamburger-btn" class="flex flex-col items-center justify-center space-y-1.5 p-2" aria-label="เปิดเมนู">
      <span class="hamburger-line h-0.5 w-6 origin-center bg-[#0a84e0] transition-all duration-300"></span>
      <span class="hamburger-line h-0.5 w-6 bg-[#0a84e0] transition-all duration-300"></span>
      <span class="hamburger-line h-0.5 w-6 origin-center bg-[#0a84e0] transition-all duration-300"></span>
    </button>

    <a href="/" class="flex-shrink-0 transition-transform hover:scale-105">
      <Picture
        src={mainLogo!}
        alt={logoAlt}
        loading="eager"
        widths={[75, 150, 225]}
        sizes="62px"
        class="h-[32px] w-auto drop-shadow-md"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={45}
      />
    </a>

    <a
      href="/login"
      class="flex h-[32px] items-center justify-center rounded border border-[#0a84e0] bg-gradient-to-r from-[#065a9c] to-[#033f70] px-4 text-xs font-bold text-[#eaf5ff] shadow-[0_0_12px_rgba(10,132,224,0.45)] transition-transform active:scale-95">
      เข้าสู่ระบบ
    </a>
  </nav>

  <div id="mobile-overlay" class="pointer-events-none fixed inset-0 z-30 bg-black/80 opacity-0 backdrop-blur-sm transition-opacity duration-300 lg:hidden"></div>

  <div
    id="mobile-sidebar"
    class="fixed top-0 left-0 z-50 h-screen w-[260px] -translate-x-full transform overflow-y-auto border-r border-[#0a84e0]/70 bg-[#04203f] shadow-[10px_0_30px_rgba(3,26,52,0.65)] transition-transform duration-300 ease-out lg:hidden">
    <div class="flex flex-col space-y-2.5 px-4 pt-16 pb-8">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`sidebar-item flex items-center rounded-lg border px-4 py-3 transition-all ${isActive(link.path) ? "border-[#0a84e0] bg-[#073059] text-[#e4f1fd] shadow-inner" : "border-transparent bg-white/5 text-[#a9c9e8] hover:bg-white/10 hover:text-[#e4f1fd]"}`}>
            <span aria-hidden="true" class="mr-3 text-xl">
              {link.icon ?? "🔗"}
            </span>
            <span class="text-sm font-bold">{link.name}</span>
          </a>
        ))
      }

      <div class="mt-5 flex flex-col gap-2 border-t border-[#0a84e0]/60 pt-5">
        <a
          href="/register"
          class="sidebar-item flex items-center justify-center gap-2 rounded border border-[#c88a02] bg-gradient-to-r from-[#ffe27a] via-[#fdbc04] to-[#c88a02] py-3 text-sm font-bold text-[#04203f] shadow-md transition-transform active:scale-95">
          <span aria-hidden="true">⚡</span>
          <span>สมัครสมาชิกใหม่</span>
        </a>
      </div>
    </div>
  </div>

  <div class="fixed top-4 right-6 z-50 hidden items-center gap-3 lg:flex">
    <a
      href="/login"
      class="group flex items-center gap-1.5 rounded border border-[#0a84e0]/60 bg-[#02162c]/90 px-6 py-2 text-sm font-bold text-[#cfe4f8] shadow-md backdrop-blur-sm transition-all hover:border-[#ffe27a] hover:bg-[#073059]/90">
      <span aria-hidden="true">🔒</span>
      <span>เข้าสู่ระบบ</span>
    </a>
    <a
      href="/register"
      class="group flex items-center gap-1.5 rounded border border-[#c88a02] bg-gradient-to-r from-[#ffe27a] via-[#fdbc04] to-[#c88a02] px-6 py-2 text-sm font-bold text-[#04203f] shadow-[0_0_15px_rgba(253,188,4,0.45)] transition-all hover:scale-105">
      <span aria-hidden="true">👤</span>
      <span>สมัครสมาชิก</span>
    </a>
  </div>
</header>

<div class="hidden h-[15px] w-full lg:block"></div>

<style is:global>
  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  .sidebar-item {
    opacity: 0;
    transform: translateX(-20px);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .sidebar-item.item-show {
    opacity: 1;
    transform: translateX(0);
  }

  .sidebar-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .sidebar-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .sidebar-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .sidebar-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .sidebar-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .sidebar-item:nth-child(6) {
    transition-delay: 0.35s;
  }
  .sidebar-item:nth-child(7) {
    transition-delay: 0.4s;
  }
  .sidebar-item:nth-child(8) {
    transition-delay: 0.45s;
  }
  .sidebar-item:nth-child(9) {
    transition-delay: 0.5s;
  }
  .sidebar-item:nth-child(10) {
    transition-delay: 0.55s;
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar-item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const overlay = document.getElementById("mobile-overlay");
  const sidebar = document.getElementById("mobile-sidebar");
  const sidebarItems = document.querySelectorAll(".sidebar-item");

  const toggleSidebar = () => {
    hamburgerBtn?.classList.toggle("active");
    sidebar?.classList.toggle("-translate-x-full");
    sidebar?.classList.toggle("translate-x-0");
    overlay?.classList.toggle("opacity-0");
    overlay?.classList.toggle("opacity-100");
    overlay?.classList.toggle("pointer-events-none");
    overlay?.classList.toggle("pointer-events-auto");

    if (sidebar?.classList.contains("translate-x-0")) {
      document.body.style.overflow = "hidden";
      sidebarItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      sidebarItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleSidebar);
  overlay?.addEventListener("click", toggleSidebar);

  sidebarItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (sidebar?.classList.contains("translate-x-0")) {
        toggleSidebar();
      }
    });
  });
</script>
