---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

const logoAlt = "โลโก้ CK268 ตัวอักษรภาษาอังกฤษหนาแบบสามมิติบนพื้นโปร่งใส ตัว C และเลข 6 8 เป็นโครเมียมขาวเงิน ส่วนตัว K และเลข 2 เป็นเขียวนีออนไล่เฉดลงเขียวเข้ม";

// สมัครสมาชิก/เข้าสู่ระบบ อยู่ถัดจากโปรโมชั่นทันที เพราะเป็นปุ่ม conversion
// ไม่ใช่หน้าให้อ่าน — ที่เหลือเป็นหน้าเนื้อหาเรียงต่อท้าย
//
// ไม่มี ตรวจหวย/แนวทาง: CK268 เป็นเว็บสล็อต ไม่ใช่เว็บหวย สองหน้านั้นถูกพักไว้
// ใน src/pages-disabled/ รอบนี้ ถ้าปล่อยลิงก์ค้างไว้ verify-build.mjs จะทำให้
// build แดงเพราะ href ชี้ไป route ที่ไม่มีใน dist/
// ไม่มี ทางเข้า: toggle cta เปิดอยู่ /register กับ /login จึงเป็นหน้าจริงในเมนูแล้ว
// ทางเข้าจะกลายเป็นลิงก์ที่สามที่พาไปที่เดียวกัน (หน้ายังถูก route และ index อยู่)
//
// CK268 (รอบเขียวนีออน-โครเมียม-ดำ 2026-09-30): พื้นดำอมเขียว #071007 การ์ด/
// สถานะ active เป็น #12250f ขอบเขียวนีออนแบรนด์ #8bfc13 ตัวหนังสือเขียวหม่น
// #b9c9b4 → ขาวอมเขียว #eaffd6 ตอน active แถบไฮไลต์ซ้ายไล่เขียวนีออน → เขียวกลาง
// → โครเมียม ตามคู่สีในโลโก้ที่ตัวอักษรสลับเขียวนีออนกับโครเมียมขาวเงิน
// ปุ่มสมัครไล่เฉดเขียวอ่อน #c9ff8f → เขียวนีออน #8bfc13 ตัวหนังสือสีพื้น
// — ทอง #fcdc2b/#fff6ae/#a87d0c กับแดง #cf1111 ของ 888PARUAY ถูกถอดหมด
//
// ปุ่มพื้นเขียวนีออนใช้หมึกเข้ม #071007 (คอนทราสต์ ~14:1 บน #8bfc13) — ขาวบน
// เขียวนีออนตก AA ถ้าจะปรับสีปุ่มรอบหน้า ให้เช็กคู่พื้น-หมึกใหม่ทุกครั้ง
//
// รางเมนูเดสก์ท็อปกลับมาที่ 640px เพราะรอบนี้เหลือ 7 เมนู (ถอด ตรวจหวย/แนวทาง)
//
// โลโก้ทั้งสองตัวคง loading="eager" ไว้ (อยู่เหนือ fold บน header ที่ sticky
// ถ้า lazy จะเห็นภาพโผล่ทีหลัง) แต่ไม่มี fetchpriority="high" — มีแค่ hero banner
// ตัวเดียวที่เป็น LCP จริงของทุกหน้าที่ได้ priority สูงสุด
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🏢" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];
---

<header class="sticky top-0 z-50 w-full font-sans shadow-lg">
  <div class="pointer-events-none absolute top-0 left-0 z-50 hidden h-0 w-full items-start justify-center lg:flex">
    <div
      class="pointer-events-auto flex h-[65px] w-[130px] items-center justify-center rounded-b-3xl border-x border-b border-[#8bfc13] bg-gradient-to-b from-[#12250f] to-[#071007] shadow-[0_5px_18px_rgba(139,252,19,0.4)]">
      <a href="/" class="drop-shadow-[0_0_8px_rgba(139,252,19,0.5)] transition-transform hover:scale-110">
        <Picture
          src={mainLogo!}
          alt={logoAlt}
          loading="eager"
          widths={[75, 150, 225]}
          sizes="75px"
          class="h-[38px] w-auto"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={45}
        />
      </a>
    </div>
  </div>

  <aside
    class="fixed top-1/2 left-3 z-40 hidden h-[640px] max-h-[90vh] w-[92px] -translate-y-1/2 flex-col items-center justify-center rounded-2xl border border-[#3eea12]/70 bg-[#071007]/95 p-2 shadow-[5px_0_22px_rgba(0,0,0,0.65)] backdrop-blur-md lg:flex">
    <div class="relative flex h-full w-full flex-col gap-2 overflow-hidden rounded-xl">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`group relative flex h-full w-full flex-col items-center justify-center rounded-lg transition-all ${isActive(link.path) ? "bg-[#12250f]" : "hover:bg-[#12250f]/70"}`}>
            <span aria-hidden="true" class="mb-1 text-2xl drop-shadow-md transition-transform group-hover:scale-110">
              {link.icon ?? "🔗"}
            </span>
            <span class={`text-xs font-bold transition-colors ${isActive(link.path) ? "text-[#eaffd6]" : "text-[#b9c9b4] group-hover:text-[#eaffd6]"}`}>{link.name}</span>
            <div
              aria-hidden="true"
              class={`absolute top-0 left-0 h-full w-[3px] origin-top bg-gradient-to-b from-[#8bfc13] via-[#3eea12] to-[#e8f0e6] transition-transform duration-300 ${isActive(link.path) ? "scale-y-100" : "scale-y-0 group-hover:scale-y-100"}`}
            />
          </a>
        ))
      }
    </div>
  </aside>

  <nav class="relative z-40 flex h-[60px] items-center justify-between border-b border-[#8bfc13]/45 bg-[#071007] px-3 shadow-xl lg:hidden">
    <button id="hamburger-btn" class="flex flex-col items-center justify-center space-y-1.5 p-2" aria-label="เปิดเมนู">
      <span class="hamburger-line h-0.5 w-6 origin-center bg-[#8bfc13] transition-all duration-300"></span>
      <span class="hamburger-line h-0.5 w-6 bg-[#8bfc13] transition-all duration-300"></span>
      <span class="hamburger-line h-0.5 w-6 origin-center bg-[#8bfc13] transition-all duration-300"></span>
    </button>

    <a href="/" class="flex-shrink-0 transition-transform hover:scale-105">
      <Picture
        src={mainLogo!}
        alt={logoAlt}
        loading="eager"
        widths={[75, 150, 225]}
        sizes="62px"
        class="h-[32px] w-auto drop-shadow-md"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={45}
      />
    </a>

    <a
      href="/login"
      class="flex h-[32px] items-center justify-center rounded border border-[#1a7a08] bg-gradient-to-r from-[#c9ff8f] to-[#1a7a08] px-4 text-xs font-bold text-[#071007] shadow-[0_0_12px_rgba(139,252,19,0.4)] transition-transform active:scale-95">
      เข้าสู่ระบบ
    </a>
  </nav>

  <div id="mobile-overlay" class="pointer-events-none fixed inset-0 z-30 bg-black/80 opacity-0 backdrop-blur-sm transition-opacity duration-300 lg:hidden"></div>

  <div
    id="mobile-sidebar"
    class="fixed top-0 left-0 z-50 h-screen w-[260px] -translate-x-full transform overflow-y-auto border-r border-[#3eea12]/70 bg-[#071007] shadow-[10px_0_30px_rgba(0,0,0,0.8)] transition-transform duration-300 ease-out lg:hidden">
    <div class="flex flex-col space-y-2.5 px-4 pt-16 pb-8">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`sidebar-item flex items-center rounded-lg border px-4 py-3 transition-all ${isActive(link.path) ? "border-[#8bfc13] bg-[#12250f] text-[#eaffd6] shadow-inner" : "border-transparent bg-white/5 text-[#b9c9b4] hover:bg-white/10 hover:text-[#eaffd6]"}`}>
            <span aria-hidden="true" class="mr-3 text-xl">
              {link.icon ?? "🔗"}
            </span>
            <span class="text-sm font-bold">{link.name}</span>
          </a>
        ))
      }

      <div class="mt-5 flex flex-col gap-2 border-t border-[#3eea12]/60 pt-5">
        <a
          href="/register"
          class="sidebar-item flex items-center justify-center gap-2 rounded border border-[#1a7a08] bg-gradient-to-r from-[#c9ff8f] via-[#8bfc13] to-[#1a7a08] py-3 text-sm font-bold text-[#071007] shadow-md transition-transform active:scale-95">
          <span aria-hidden="true">⚡</span>
          <span>สมัครสมาชิกใหม่</span>
        </a>
      </div>
    </div>
  </div>

  <div class="fixed top-4 right-6 z-50 hidden items-center gap-3 lg:flex">
    <a
      href="/login"
      class="group flex items-center gap-1.5 rounded border border-[#3eea12]/60 bg-[#0b160b]/90 px-6 py-2 text-sm font-bold text-[#d5e6cd] shadow-md backdrop-blur-sm transition-all hover:border-[#8bfc13] hover:bg-[#12250f]/90">
      <span aria-hidden="true">🔒</span>
      <span>เข้าสู่ระบบ</span>
    </a>
    <a
      href="/register"
      class="group flex items-center gap-1.5 rounded border border-[#1a7a08] bg-gradient-to-r from-[#c9ff8f] via-[#8bfc13] to-[#1a7a08] px-6 py-2 text-sm font-bold text-[#071007] shadow-[0_0_15px_rgba(139,252,19,0.4)] transition-all hover:scale-105">
      <span aria-hidden="true">👤</span>
      <span>สมัครสมาชิก</span>
    </a>
  </div>
</header>

<div class="hidden h-[15px] w-full lg:block"></div>

<style is:global>
  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  .sidebar-item {
    opacity: 0;
    transform: translateX(-20px);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .sidebar-item.item-show {
    opacity: 1;
    transform: translateX(0);
  }

  .sidebar-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .sidebar-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .sidebar-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .sidebar-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .sidebar-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .sidebar-item:nth-child(6) {
    transition-delay: 0.35s;
  }
  .sidebar-item:nth-child(7) {
    transition-delay: 0.4s;
  }
  .sidebar-item:nth-child(8) {
    transition-delay: 0.45s;
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar-item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const overlay = document.getElementById("mobile-overlay");
  const sidebar = document.getElementById("mobile-sidebar");
  const sidebarItems = document.querySelectorAll(".sidebar-item");

  const toggleSidebar = () => {
    hamburgerBtn?.classList.toggle("active");
    sidebar?.classList.toggle("-translate-x-full");
    sidebar?.classList.toggle("translate-x-0");
    overlay?.classList.toggle("opacity-0");
    overlay?.classList.toggle("opacity-100");
    overlay?.classList.toggle("pointer-events-none");
    overlay?.classList.toggle("pointer-events-auto");

    if (sidebar?.classList.contains("translate-x-0")) {
      document.body.style.overflow = "hidden";
      sidebarItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      sidebarItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleSidebar);
  overlay?.addEventListener("click", toggleSidebar);

  sidebarItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (sidebar?.classList.contains("translate-x-0")) {
        toggleSidebar();
      }
    });
  });
</script>
