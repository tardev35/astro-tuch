---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

// คำบรรยายเขียนจากไฟล์ logo.webp ของดรอป 2026-10-19 จริง (อ่านด้วย Read ก่อนเขียน)
// ไม่ใช่คัดลอกของรอบก่อน — เหรียญตราถ้วยรางวัล/ลูกฟุตบอลทองของ UFA324 ที่เคยอยู่ใน
// ตัวแปรนี้ไม่มีอยู่ในรูปรอบนี้เลย และนินจาการ์ตูนกับชูริเคนฟ้าของ นินจา168 ก็ไม่มี
const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส ฝั่งซ้ายเป็นถุงเงินสีฟ้าผูกเชือกทองที่สลักเครื่องหมายดอลลาร์สีขาวไว้กลางถุง วางซ้อนอยู่กับปึกธนบัตรสีฟ้า-ขาวและกองเหรียญทองสลักสัญลักษณ์ดอลลาร์ที่ไหลลงมาด้านล่าง ถัดมาทางขวาเป็นคำว่า รวย เขียนด้วยตัวอักษรไทยหนาสามมิติสีทองอำพันตัดขอบขาว ต่อด้วยคำว่า แทร่168 ตัวอักษรหนาสามมิติผิวมันวาวสีฟ้าอะซัวร์ตัดขอบขาว รอบตัวอักษรมีหัวใจสีฟ้าและประกายดาวสีฟ้ากับสีทองลอยกระจายอยู่`;

// สมัครสมาชิก/เข้าสู่ระบบ อยู่ถัดจากโปรโมชั่นทันที เพราะเป็นปุ่ม conversion
// ไม่ใช่หน้าให้อ่าน — ที่เหลือเป็นหน้าเนื้อหาเรียงต่อท้าย
//
// ไม่มี ตรวจหวย/แนวทาง: รวยแทร่168 เป็นเว็บสล็อต ไม่ใช่เว็บหวย สองหน้านั้น
// อยู่ใน src/pages-disabled/ จึงไม่มี route ให้ลิงก์ไปหา — ลิงก์ที่ค้างอยู่จะ
// ทำให้ verify-build แดงด้วย (href ชี้ไป route ที่ไม่มีอยู่จริง) ลบออกจาก links
// ตัวนี้ตัวเดียวพอ เพราะทั้งรางเดสก์ท็อปและ drawer มือถืออ่าน array เดียวกัน
// ไม่มี ทางเข้า: toggle cta เปิดอยู่ /register กับ /login จึงเป็นหน้าจริงในเมนูแล้ว
// ทางเข้าจะกลายเป็นลิงก์ที่สามที่พาไปที่เดียวกัน (หน้ายังถูก route และ index อยู่
// และ footer ยังลิงก์ไปหาอยู่)
// ไอคอนเลือกตามแนวแบรนด์สล็อต-เงินทอง (ตู้สล็อต/ของขวัญ/กุญแจ) ไม่ใช่สัญลักษณ์
// กีฬาแบบ UFA324 ที่ค้างอยู่ และอยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้อง
// ของป้ายชื่อเสมอ ไม่ได้ฝังในข้อความ
//
// รวยแทร่168 (รอบฟ้าอะซัวร์นำ-ทองอำพันรอง 2026-10-19): navbar ตัวนี้เป็น "รางลอย"
// จึงประกาศสีตัวอักษรของตัวเองครบทุกจุด ไม่ได้ inherit BRAND_TEXT ผิวแผงเป็น
// #071e38 ให้สว่างกว่าพื้นเพจดำสนิท #000000 เล็กน้อย แผงเมนูจึงอ่านเป็นชั้นลอย
// การ์ด/สถานะ active เป็น #0b2d52 ขอบฟ้าแบรนด์ #039cfa ตัวหนังสือฟ้าหม่น #7fa8cc
// (6.5:1 บนผิวแผง) → ขาวอมฟ้า #e3f2fc ตอน active แถบไฮไลต์ซ้ายไล่ฟ้าน้ำแข็ง
// #c3ebfc → ฟ้าแบรนด์ #039cfa → ทองอำพัน #f9a826 ตามคู่สีในโลโก้ที่ "รวย" เป็นทอง
// และ "แทร่168" เป็นฟ้า ปุ่มสมัครไล่เฉดฟ้าน้ำแข็ง #c3ebfc → ฟ้าแบรนด์ #039cfa →
// ฟ้ากลางเข้ม #0289e0
// — ชุดทองแชมเปี้ยน-เงินโครเมียมของ UFA324 (e5a81b ffe08a bb8410 7d5a07
// 43300a 17130a 312713 0d0b06 140d01 8792a0 f0e8d4 b9c2cc 464f5a)
// ถูกถอดหมดแล้ว พร้อมกับคำบรรยายโลโก้ที่เป็นเว็บกีฬา
// ⚠️ สองรอบก่อนก็มีทองเป็นฮิวที่สอง (นินจา168 fef54b · สบายเบท168 ffc82e) และ
// UFA324 ที่ค้างในไฟล์นี้ก็ทอง การเจอทองในไฟล์นี้จึงไม่ได้แปลว่าเป็นของรอบนี้ —
// #f9a826 ไม่ใช่ e5a81b ไม่ใช่ fef54b และไม่ใช่ ffc82e ให้เทียบเป็นค่าทีละตัว
// เช่นเดียวกับฟ้า: #039cfa ไม่ใช่ 32bcfb ของนินจา168 และไม่ใช่ 2f9ff5 ของ
// สบายเบท168 (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep
// ที่ไล่หาสีแบรนด์เก่าสะดุดที่คอมเมนต์ประวัติของไฟล์นี้เอง)
//
// ปุ่มพื้นฟ้าใช้หมึกน้ำเงินเกือบดำ #031320 (6.2:1 บน #039cfa · 5.0:1 บน #0289e0) —
// ตัวอักษรสว่างบนฟ้าสว่างตก AA ส่วนปุ่มพื้นมืดใช้หมึกขาวอมฟ้า #e3f2fc (11.9:1 บน
// #0b2d52) หรือทองอำพัน #f9a826 (9.5:1 บน #030f1d) สลับกันไม่ได้ ถ้าจะปรับสีปุ่ม
// รอบหน้า ให้เช็กคู่พื้น-หมึกใหม่ทุกครั้ง
// ⚠️ ปลายเข้มของไล่เฉดปุ่มฟ้าต้องหยุดที่ #0289e0 ห้ามไล่ลงไปถึงน้ำเงินลึก #04366b
// ซึ่งรองหมึก #031320 ได้แค่ 1.3:1 (ตก AA หนัก) — #04366b #704504 เป็นสีเส้น
// และออราเท่านั้น ห้ามถือตัวอักษรทุกขนาด
//
// รางเมนูเดสก์ท็อปคงที่ 640px เพราะรอบนี้มี 7 เมนูเท่าเดิม (ไม่มี ตรวจหวย/แนวทาง
// และไม่มี ทางเข้า) — ถ้ารอบหน้าเพิ่มเมนู ต้องขยายค่านี้ด้วย ไม่งั้นแต่ละช่องจะ
// บีบจนไอคอนกับชื่อชนกัน
//
// โลโก้ทั้งสองตัวคง loading="eager" ไว้ (อยู่เหนือ fold บน header ที่ sticky
// ถ้า lazy จะเห็นภาพโผล่ทีหลัง) แต่ไม่มี fetchpriority="high" — มีแค่ hero banner
// ตัวเดียวที่เป็น LCP จริงของทุกหน้าที่ได้ priority สูงสุด
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "ℹ️" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];
---

<header class="sticky top-0 z-50 w-full font-sans shadow-lg">
  <div class="pointer-events-none absolute top-0 left-0 z-50 hidden h-0 w-full items-start justify-center lg:flex">
    <div
      class="pointer-events-auto flex h-[65px] w-[130px] items-center justify-center rounded-b-3xl border-x border-b border-[#039cfa] bg-gradient-to-b from-[#0b2d52] to-[#071e38] shadow-[0_5px_18px_rgba(3,156,250,0.45)]">
      <a href="/" class="drop-shadow-[0_0_8px_rgba(195,235,252,0.55)] transition-transform hover:scale-110">
        <Picture
          src={mainLogo!}
          alt={logoAlt}
          loading="eager"
          widths={[75, 150, 225]}
          sizes="75px"
          class="h-[38px] w-auto"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={45}
        />
      </a>
    </div>
  </div>

  <aside
    class="fixed top-1/2 left-3 z-40 hidden h-[640px] max-h-[94vh] w-[92px] -translate-y-1/2 flex-col items-center justify-center rounded-2xl border border-[#039cfa]/70 bg-[#071e38]/95 p-2 shadow-[5px_0_22px_rgba(0,0,0,0.7)] backdrop-blur-md lg:flex">
    <div class="relative flex h-full w-full flex-col gap-2 overflow-hidden rounded-xl">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`group relative flex h-full w-full flex-col items-center justify-center rounded-lg transition-all ${isActive(link.path) ? "bg-[#0b2d52]" : "hover:bg-[#0b2d52]/70"}`}>
            <span aria-hidden="true" class="mb-1 text-2xl drop-shadow-md transition-transform group-hover:scale-110">
              {link.icon ?? "🔗"}
            </span>
            <span class={`text-xs font-bold transition-colors ${isActive(link.path) ? "text-[#e3f2fc]" : "text-[#7fa8cc] group-hover:text-[#e3f2fc]"}`}>{link.name}</span>
            <div
              aria-hidden="true"
              class={`absolute top-0 left-0 h-full w-[3px] origin-top bg-gradient-to-b from-[#c3ebfc] via-[#039cfa] to-[#f9a826] transition-transform duration-300 ${isActive(link.path) ? "scale-y-100" : "scale-y-0 group-hover:scale-y-100"}`}
            />
          </a>
        ))
      }
    </div>
  </aside>

  <nav class="relative z-40 flex h-[60px] items-center justify-between border-b border-[#039cfa]/45 bg-[#071e38] px-3 shadow-xl lg:hidden">
    <button id="hamburger-btn" class="flex flex-col items-center justify-center space-y-1.5 p-2" aria-label="เปิดเมนู">
      <span class="hamburger-line h-0.5 w-6 origin-center bg-[#039cfa] transition-all duration-300"></span>
      <span class="hamburger-line h-0.5 w-6 bg-[#039cfa] transition-all duration-300"></span>
      <span class="hamburger-line h-0.5 w-6 origin-center bg-[#039cfa] transition-all duration-300"></span>
    </button>

    <a href="/" class="flex-shrink-0 transition-transform hover:scale-105">
      <Picture
        src={mainLogo!}
        alt={logoAlt}
        loading="eager"
        widths={[75, 150, 225]}
        sizes="62px"
        class="h-[32px] w-auto drop-shadow-md"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={45}
      />
    </a>

    <a
      href="/login"
      class="flex h-[32px] items-center justify-center rounded border border-[#f9a826] bg-gradient-to-r from-[#0b2d52] to-[#071e38] px-4 text-xs font-bold text-[#e3f2fc] shadow-[0_0_12px_rgba(249,168,38,0.4)] transition-transform active:scale-95">
      เข้าสู่ระบบ
    </a>
  </nav>

  <div id="mobile-overlay" class="pointer-events-none fixed inset-0 z-30 bg-black/80 opacity-0 backdrop-blur-sm transition-opacity duration-300 lg:hidden"></div>

  <div
    id="mobile-sidebar"
    class="fixed top-0 left-0 z-50 h-screen w-[260px] -translate-x-full transform overflow-y-auto border-r border-[#039cfa]/70 bg-[#071e38] shadow-[10px_0_30px_rgba(0,0,0,0.75)] transition-transform duration-300 ease-out lg:hidden">
    <div class="flex flex-col space-y-2.5 px-4 pt-16 pb-8">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`sidebar-item flex items-center rounded-lg border px-4 py-3 transition-all ${isActive(link.path) ? "border-[#039cfa] bg-[#0b2d52] text-[#e3f2fc] shadow-inner" : "border-transparent bg-white/5 text-[#7fa8cc] hover:bg-white/10 hover:text-[#e3f2fc]"}`}>
            <span aria-hidden="true" class="mr-3 text-xl">
              {link.icon ?? "🔗"}
            </span>
            <span class="text-sm font-bold">{link.name}</span>
          </a>
        ))
      }

      <div class="mt-5 flex flex-col gap-2 border-t border-[#039cfa]/60 pt-5">
        <a
          href="/register"
          class="sidebar-item flex items-center justify-center gap-2 rounded border border-[#0289e0] bg-gradient-to-r from-[#c3ebfc] via-[#039cfa] to-[#0289e0] py-3 text-sm font-bold text-[#031320] shadow-md transition-transform active:scale-95">
          <span aria-hidden="true">💰</span>
          <span>สมัครสมาชิกใหม่</span>
        </a>
      </div>
    </div>
  </div>

  <div class="fixed top-4 right-6 z-50 hidden items-center gap-3 lg:flex">
    <a
      href="/login"
      class="group flex items-center gap-1.5 rounded border border-[#f9a826]/60 bg-[#030f1d]/90 px-6 py-2 text-sm font-bold text-[#f9a826] shadow-md backdrop-blur-sm transition-all hover:border-[#c3ebfc] hover:bg-[#0b2d52]/90">
      <span aria-hidden="true">🔒</span>
      <span>เข้าสู่ระบบ</span>
    </a>
    <a
      href="/register"
      class="group flex items-center gap-1.5 rounded border border-[#0289e0] bg-gradient-to-r from-[#c3ebfc] via-[#039cfa] to-[#0289e0] px-6 py-2 text-sm font-bold text-[#031320] shadow-[0_0_15px_rgba(3,156,250,0.45)] transition-all hover:scale-105">
      <span aria-hidden="true">🎰</span>
      <span>สมัครสมาชิก</span>
    </a>
  </div>
</header>

<div class="hidden h-[15px] w-full lg:block"></div>

<style is:global>
  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  .sidebar-item {
    opacity: 0;
    transform: translateX(-20px);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .sidebar-item.item-show {
    opacity: 1;
    transform: translateX(0);
  }

  .sidebar-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .sidebar-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .sidebar-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .sidebar-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .sidebar-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .sidebar-item:nth-child(6) {
    transition-delay: 0.35s;
  }
  .sidebar-item:nth-child(7) {
    transition-delay: 0.4s;
  }
  .sidebar-item:nth-child(8) {
    transition-delay: 0.45s;
  }
  .sidebar-item:nth-child(9) {
    transition-delay: 0.5s;
  }
  .sidebar-item:nth-child(10) {
    transition-delay: 0.55s;
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar-item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const overlay = document.getElementById("mobile-overlay");
  const sidebar = document.getElementById("mobile-sidebar");
  const sidebarItems = document.querySelectorAll(".sidebar-item");

  const toggleSidebar = () => {
    hamburgerBtn?.classList.toggle("active");
    sidebar?.classList.toggle("-translate-x-full");
    sidebar?.classList.toggle("translate-x-0");
    overlay?.classList.toggle("opacity-0");
    overlay?.classList.toggle("opacity-100");
    overlay?.classList.toggle("pointer-events-none");
    overlay?.classList.toggle("pointer-events-auto");

    if (sidebar?.classList.contains("translate-x-0")) {
      document.body.style.overflow = "hidden";
      sidebarItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      sidebarItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleSidebar);
  overlay?.addEventListener("click", toggleSidebar);

  sidebarItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (sidebar?.classList.contains("translate-x-0")) {
        toggleSidebar();
      }
    });
  });
</script>
