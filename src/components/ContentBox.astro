---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#4a2409]/70 bg-[#140a05]/92 p-8 text-left text-base leading-relaxed text-[#ded4cb] shadow-[0_10px_30px_rgba(7,4,3,0.65)] backdrop-blur-xl transition-all duration-500 hover:border-[#f26a02]/70 hover:shadow-[0_15px_40px_rgba(242,106,2,0.26)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#f26a02]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#f26a02]/30"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#9ba3ad]/18 blur-[60px] transition-all duration-500 group-hover:bg-[#9ba3ad]/28"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#4a2409]/70 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffb266] to-[#8c3a01] shadow-[0_0_10px_rgba(242,106,2,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffc48a] via-[#f26a02] to-[#8c3a01] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
