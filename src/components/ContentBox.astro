---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro, /promotion,
// /about-us, /contact-us, /ทางเข้า, /ทดลองเล่น, /login, /register, /ตรวจหวย และ
// /แนวทาง render ตัวเนื้อหาผ่านไฟล์นี้ (12 หน้ารอบนี้) และไม่เคยเดินตาม
// ContentBox rotation ของ index
// → ไฟล์นี้ต้องถือพาเลตของ "แบรนด์ปัจจุบัน" เสมอ ต่อให้ index เลือก variant อื่น
// ⚠️ รอบนี้ **หน้าแรกใช้ไฟล์นี้ด้วย** (หัวข้อ H2 "อัตราจ่ายเว็บ ... แทงหวยทุกประเภท"
// ใช้การ์ดตัวฐานคั่นกลางชุด Huay) แต่สถานะ shared chrome ของไฟล์นี้ไม่ได้ขึ้นกับ
// ข้อนั้น — สิบสองหน้าข้างบนใช้อยู่แล้วไม่ว่า index จะเลือก variant ไหน
// **ห้ามปล่อยให้มันหลุดจากชุดที่ retheme ใน P1 เด็ดขาด**
// ⚠️ รอบนี้ /ตรวจหวย และ /แนวทาง **ถูกย้ายกลับเข้า src/pages/ แล้ว** (แบรนด์นี้เป็น
// เว็บหวย) จำนวนหน้าจึงเพิ่มจาก 10 เป็น 12 — ไม่กระทบสถานะ shared chrome ของไฟล์นี้
// ⚠️ หน้าถาวรพวกนั้น **ไม่ประกาศสีตัวอักษรเองเลยสักจุด** ย่อหน้าทั้งหมด inherit สีมา
// จากการ์ดข้างล่าง ถ้าการ์ดไม่ตั้ง text color หน้าเหล่านั้นจะตกไปใช้ default ของ
// เบราว์เซอร์ → คลาสชุด text-left + text-base + leading-relaxed + สีหมึกของรอบนี้
// บน element ที่ถือ <slot /> ห้ามหายไปสักตัว (รอบนี้สีหมึกคือ 25090f)
// ⚠️ เขียนชื่อคลาสสีแบบถอดวงเล็บโดยตั้งใจ — Tailwind สแกนไฟล์นี้แบบ plain text
// รวมถึงคอมเมนต์ด้วย การพิมพ์คลาสสีเต็มรูปในคอมเมนต์จึงทำให้ยูทิลิตี้ของค่านั้น
// ถูก generate ลง stylesheet จริง (เคยเจอค่าของแบรนด์ก่อนหลุดมาทางนี้)
//
// Flattened single-slot variant (ทำเมื่อ 2026-07-26): isolate บนการ์ด + -z-10
// บนชั้นตกแต่ง absolute ทุกชั้น slot จึง render เป็นลูกตรงของการ์ด
// **ห้ามเพิ่ม wrapper <div> รอบ slot กลับมา** และถ้าจะเปลี่ยนสีตัวอักษรของการ์ด
// ให้ **แทนที่** คลาสสีเดิม ไม่ใช่ใส่คลาสสีที่สองข้างๆ (specificity เท่ากัน ผลจะ
// ขึ้นอยู่กับลำดับที่ Tailwind บังเอิญ emit)
//
// House style เนื้อความ: element ที่ถือ slot ได้ text-left + text-base +
// leading-relaxed + สี — ห้ามย่อหรือขยายขนาดตัวอักษรของเนื้อความ · หัวข้อจัดกลางได้
// แต่ต้องใส่ text-center ที่ตัวหัวข้อเอง **ห้ามใส่บนการ์ดหรือ <section>** เพราะมันจะ
// inherit ลงไปใน slot แล้วทำให้ย่อหน้าของทุกหน้าที่เรียกไฟล์นี้กลางตามไปด้วย
//
// หัวข้อมาจาก prop title + as เท่านั้น (เป็นหัวข้อจริงของบทความ/หน้านั้นๆ)
// **ห้าม hardcode ข้อความไทยเป็น heading ในไฟล์นี้** — เป็นโครมที่ขึ้นทุกหน้า
//
// ────────────────────────────────────────────────────────────────────────────
// รอบนี้ (LOTTO189) พาเลตตาม .claude/brand-spec-lotto189.md §2
// 🚨 **เนื้อหายังเป็นธีมสว่างและโครมยังเข้มเหมือนรอบก่อน แต่ฮิวคนละตระกูลสิ้นเชิง**
// เหตุผล: bg.json ของดรอปนี้เป็น {"mode":"color","color":"#fff0f0"} = **ขาวอมชมพูจาง**
// (รอบก่อนเป็น fffbf0 = ครีมอมงาช้างอุ่น) และ bg.json คือแหล่งเดียวของพื้นเพจ
// ⚠️ **navbar/footer/ticker รอบนี้เป็นผิวเข้ม (24060c / 120307) แต่ไฟล์นี้ไม่ใช่** —
// **ห้าม "แก้" การ์ดให้เป็นพื้นมืดตามโครม** การ์ดมืดบนหมึก 25090f จะทำให้หน้า
// terms/privacy/404 ที่พึ่ง BRAND_TEXT ตัวอักษรหายไปเลย ไม่ใช่แค่จางลง
//
// อ่านจากอาร์ตเวิร์กจริง: โลโก้เป็น **เวิร์ดมาร์กสามมิติ ครึ่งแรกเป็นตัวอักษรละติน
// ผิวโครเมียมเงินขัดเงาตัดขอบแดง ครึ่งหลังเป็นตัวเลขผิวแดงเลือดนกเคลือบเงา
// บนพื้นโปร่ง** ส่วนแบนเนอร์เป็นฉาก **ห้องสีขาวครีม มีหญิงสาวสวมสูทขาวนั่งบน
// อาร์มแชร์ขาวขอบทอง ลูกบอลหวยสีขาวพิมพ์ตัวเลข และโพยหวยกับปากกาสีทอง**
// และสไลด์ทั้งสองใบเป็นฉากเดียวกัน พิมพ์เลข 0.3% / 0.8% ตัวแดงตัดขอบขาว
// ⚠️ **ผิวเงินโครเมียม ขอบทองของเฟอร์นิเจอร์ และสีผิวนักแสดงเป็นวัตถุในภาพ
// ไม่ใช่สี UI** — พื้นเพจมาจาก bg.json เท่านั้น
//
// บทบาทสีในไฟล์นี้:
//   ผิวการ์ด ffffff · ชั้นยก/แถบอ่อน ffe4e6 · wash ffd4d7 · พื้นเพจ fff0f0
//   แดงเลือดนก b00718 = **สีหัวข้อ** (7.3:1 บนการ์ดขาว ผ่าน AA สบาย) และเป็นต้น
//     ไล่เฉดของเส้นใต้หัวข้อ
//   แดงแบรนด์ c1071b = **ฮิวนำที่ถือตัวอักษรได้** (6.6:1 บนขาว) ในไฟล์นี้ใช้เป็น
//     ต้นไล่เฉดของเส้นขอบบน
//   แดงสด ff2436 · แดงปุ่มสว่าง d61023 · ทองอำพัน e9b53c · เส้นอ่อน f5b9bd ·
//     เส้นเข้ม a8333f (**ทั้งหมดห้ามถือตัวอักษรบนผิวสว่าง ยกเว้น d61023 ที่ไว้ทำปุ่ม**)
//   หมึก 25090f = สีเนื้อความ (= BRAND_TEXT) 18.7:1 บนการ์ดขาว · หมึกรอง 6e3b44 (8.8:1)
//   แดงลึก 8a0412 (10.4:1) และทองเข้ม 8f6310 (5.3:1) ถือตัวอักษรได้ ถ้าต้องการคู่สีที่สอง
// 🚨🚨 **ff2436 บนพื้นขาวได้แค่ 3.9:1 และ e9b53c ได้ 2.0:1 — ห้ามเป็นสีตัวอักษร
//   ในไฟล์นี้เด็ดขาด** และ **ขาวบนสองค่านั้นก็ตก AA** พื้นที่รับหมึกขาวได้ต้องเป็น
//   d61023 (5.3:1) ขึ้นไปหาเข้ม
// ⚠️⚠️ **ffffff ffe4e6 ffd4d7 fff0f0 f5b9bd a8333f ff2436 e9b53c c3ccd6 ห้ามถือ
// ตัวอักษรบนผิวสว่าง** ส่วน **25090f (18.7:1) · 6e3b44 (8.8:1) · 8a0412 (10.4:1) ·
// b00718 (7.3:1) · c1071b (6.6:1) · 8f6310 (5.3:1) ถือตัวอักษรได้**
// rgba() ที่อนุญาตรอบนี้: rgba(176,7,24,α) · rgba(193,7,27,α) · rgba(255,36,54,α) ·
// rgba(233,181,60,α) · rgba(37,9,15,α) · rgba(245,185,189,α)
//
// ⚠️ ไฟล์นี้เป็นของแบรนด์ก่อนหน้าทุกรอบ ห้ามเหมาว่าสีที่เจอเป็นของรอบนี้ ต้องเทียบ
// เป็น **"ค่า"** ไม่ใช่ "ตระกูลสี"
// รอบก่อนหน้าทันที (ZNOVA168 ส้มเพลิง/ทองหลอมเหลว/ครีม **ตัวที่เสี่ยงหลงเหลือ
// สูงสุด**) ที่กวาดออกครบแล้วจากไฟล์นี้:
//   2a1206 1a0c04 2b1608 0e0602 7a3a0c fff3e0 e0b784 fffbf0 fff4e0 ffe9c7 f3d9a8
//   c98a24 c23400 b8300a 9a5b00 9a2a00 d13800 fa4903 fde90b e8a000 ff8a2b d8dde6
//   8f9aa8 6a4a30 + rgba(184,48,10) rgba(194,52,0) rgba(250,73,3) rgba(232,160,0)
//   rgba(42,18,6) rgba(243,217,168)
// 🚨🚨 **แดง/ทอง/ครีม คือสามตระกูลของรอบนี้ และทั้งสามเคยเป็นฮิวนำของแบรนด์เก่า
//   มาแล้วหลายเจ้า จึงต้องเทียบทีละค่าแน่นที่สุด** ค่าที่ **ห้ามใช้**:
//   แดง/ส้ม/ทอง/ครีมของ MEXICANOSLOT (สามรอบก่อน — ตระกูลเดียวกับรอบนี้เป๊ะ) —
//     de2b1e f2a033 a81410 c81e12 9d140c 6f0e08 3f130d 80453a 2b100a 431a10 1d0a06
//     8c3a22 fdeee2 e8c6ae fed7b5 fec28d f6c4a4 e2855c fde4d3 fff3ea fef6fb 117a41
//     2bb061 f2543f
//     ⚠️⚠️ **a81410 ↔ b00718 · c81e12 ↔ c1071b · 9d140c ↔ 8a0412 · de2b1e ↔ d61023 ·
//     3f130d ↔ 25090f · 2b100a ↔ 24060c · fde4d3 ↔ ffe4e6 — เจ็ดคู่นี้ใกล้ที่สุด
//     ในลิสต์ทั้งหมด ถ้า grep เจอค่าซ้ายแปลว่าพิมพ์ผิด ไม่ใช่ว่า "มันก็แดงเหมือนกัน"**
//   ไวโอเลต/ฟ้า/แมเจนต้าของ ZANE96 — 7a1bd6 2b3fd9 c2178b f23bb4 bb6dff 7aa7ff
//     5411c4 241046 6b4a86 f8e6f9 f6edfe ece0fb dcc6f4 9a6fd0 190b3d 271257 100626
//     5b2f9e f3e8ff c0a6e8 8e14b8 2f1766
//   ทอง/เหลือง/ส้มของแบรนด์เก่ากว่านั้น — ffd84d f5ba14 fcee52 b37c0b ffd94a e3a712
//     9d6f06 eeae12 fded41 9f600d fcd434 ffeaa0 fcd45c fdcb0c fefb6b fee45d e6a416
//     fef54b f7c92b ffe6a3 d4922c fdfc71 e5a81b ffe08a f9a826 ffdc8c f0b429 ffc82e
//     e0bd72 f6e4b4 d4af5a eab308 f5c53d ece2cc dcb95f f0c878 f0b46a fbc134 ffe87a
//     cf9a18 b8862b 96681f 8a6504 b8780d bb8410 d9803a fcdc2b fff6ae a87d0c fadc64
//     fdf3b4 e0b03a
//   แดงของแบรนด์เก่า — fb2e33 cb0b0d d81115 b00d11 8a0608 ff2e52 e01238 c9102f
//     fb1b32 ff8f9c 5c0410 fa0513 ff5a5f ffadaf b3121b 5a0a0e fb141b ff5f63 ffa0a2
//     eb0305 e40303 c20305 c30303 8f0505 e81313 d9212a 8e1a16 e4021b d30304 a00203
//     dc0203 f5282a ff3b14 6d0804 c41115 7a0505 cf1111 e01f26 1a0709 2a0b0e 120406
//   ครีม/เบจ/น้ำตาล/เทาเงินของแบรนด์เก่า — f4ead6 d6c6a8 1f0f04 4e2f11 291d0f f4e4d3
//     e4cbb3 ecd5c4 d2b9a4 29210f eadfce f3ece0 bfb8aa f0e6e4 c9b9b7 e3d6d4 7d6f6e
//     e8eaee b4b9c2 6b7079 dde1e7 d9dfe9 b3bdd6 f4eef1 e0e0df c0c0bf a1a09e e8ecf1
//     a8b2bf 78828f 8792a0 b9c2cc fdfcfd b4bcc2 eceaea cfdcec 9db4d4 d9c9a6 cfd6e3
//     f3f6fa d8bda6
//     ⚠️⚠️ **ผิวสว่างของรอบนี้เป็นขาวอมชมพู (R>G=B)** ซึ่งต่างจากครีมอมงาช้าง
//     (R>G>B) ของรอบก่อน และจากไลแลค (B≥R>G) — **แต่ตระกูลเดียวกับครีมของ
//     MEXICANOSLOT ใกล้มาก** ตรวจทีละค่า อย่าตัดสินด้วยสายตา
//   ชมพู/แมเจนต้า — ffd6fa fff4fb ffe3f5 ffe9f7 f9b2d9 f479b9 f4a7cf 6a0f3c 95486b
//     9c0f55 fb439b fc74b5 ffc2e2 d91a73 b01160 85094a fd6cb2 fc7cba fc4da1 (okkub88)
//     fa539c c2185b 8e0f41 fb8cc0 fdc6c3 ffd1cd f7bcd9 ef8dbd ffe5ff fff0f8 ffeef7
//     3b0b26 54123a 7a2350 ffe9f5 7a4463 (หมูบิน168) · f5469f ff8dc6 8c0f52 (มีโชค168)
//     · fa63b9 ffb3de (ถอนชัวร์168) · dd1b74 a4186b 4a0d35 2d0720 (มีทรัพย์168) ·
//     f41571 ff5ca8 (PUNPRO168)
//     ⚠️⚠️ **b01160 ของ okkub88 ต่างจาก b00718 ของรอบนี้แค่สองหลักท้าย** —
//     เจอที่ไหนแปลว่าพิมพ์ผิด
//   ฟ้า/ไซแอน/น้ำเงิน — 00bfff 12b4ef b6e3f0 7fcbe8 4fb8ea 06283f 0b4a73 2a87c4
//     eaf7ff f0faff e4f6fb 355f7d 0f5684 1a6ea8 (โบ๊ะบ๊ะ168) · 1177e8 0e68cc 0a4ea8
//     00091f 0b1733 16234a (มาดาม168) · 1fd8f0 0bb6d4 1d4fd8 143aa0 (นาซ่า168) ·
//     18a5e2 0d6b9b 0a5176 a9d7f2 (ร่ำรวย168) · 2cc3fc 6bdcfb 0a7fbd 063a57 (สบาย168)
//     · 039cfa 0494f5 c3ebfc (รวยแทร่168) · 32bcfb a9e9ff 07335f (นินจา168) ·
//     2f9ff5 a8dcff d6ecff 0b3f78 e8f4ff (สบายเบท168) · 0360f3 0292fb 6ec8ff (TSDET911)
//     · 00f3ff e0ffff 60a5fa 4b5563 030712 1f2937 (default cyber-neon/dark)
//   ม่วง — 7e22ce d946ef a855f7 (CEO66) · 7505cc b453ff c07cff d9b8ff 3a0565 (KMD88)
// ⚠️ เขียวของแบรนด์เก่า — รอบนี้ไม่มีเขียวแบรนด์เลย: 0b7d28 0a5f1c 0f9b35 0c3a16
//   061f0c (สาธุ168) · 1fae1c 0d2312 143a1c 07130a e8e4c6 (888PARUAY)
//   (เขียว #00B900 ของปุ่ม LINE และเขียว success ของฟีดถอนเงินอยู่ไฟล์อื่น คงไว้)
// (เฮกซ์ของแบรนด์เก่าในคอมเมนต์ด้านบนเขียนแบบ **ไม่มี #** โดยตั้งใจ เพื่อไม่ให้
// การ sweep ไล่หาสีของแบรนด์เก่าใน src/ สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#f5b9bd] bg-white p-8 text-left text-base leading-relaxed text-[#25090f] shadow-[0_10px_30px_rgba(176,7,24,0.12)] transition-all duration-500 hover:border-[#a8333f] hover:shadow-[0_15px_40px_rgba(255,36,54,0.22)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[3px] bg-gradient-to-r from-[#c1071b] via-[#ff2436] to-[#e9b53c]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#ff2436]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#ff2436]/30"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#e9b53c]/35 blur-[60px] transition-all duration-500 group-hover:bg-[#e9b53c]/55"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="text-2xl leading-normal font-black tracking-wide text-[#b00718]">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#c1071b] to-[#e9b53c] shadow-[0_0_10px_rgba(255,36,54,0.45)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
