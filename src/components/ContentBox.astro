---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro, /promotion,
// /about-us, /contact-us, /ทางเข้า, /ทดลองเล่น, /login และ /register render
// ตัวเนื้อหาผ่านไฟล์นี้ (10 หน้ารอบนี้) และไม่เคยเดินตาม ContentBox rotation ของ index
// → ไฟล์นี้ต้องถือพาเลตของ "แบรนด์ปัจจุบัน" เสมอ **ห้ามปล่อยให้หลุดจากชุดที่
// retheme ใน P1 เด็ดขาด** — เป็นจุดที่พลาดง่ายที่สุด เพราะ grep หา "ไฟล์ที่ index
// import" อาจไม่เจอไฟล์นี้ (รอบนี้ index ใช้ไฟล์นี้ด้วยที่ §3 แต่สถานะ shared
// chrome ของมัน **ไม่ได้ขึ้นกับข้อนั้นเลย** — สิบหน้าข้างบนใช้อยู่ไม่ว่า index
// จะเลือก variant ไหน)
// ⚠️ รอบนี้ /ตรวจหวย และ /แนวทาง **ยังอยู่ใน src/pages-disabled/ ตามเดิม**
// (แบรนด์นี้เป็นเว็บคาสิโน บรีฟเอ่ย "หวย" แค่ในฐานะหนึ่งในเจ็ดหมวดเกม)
// ⚠️ หน้าถาวรพวกนั้น **ไม่ประกาศสีตัวอักษรเองเลยสักจุด** ย่อหน้าทั้งหมด inherit สีมา
// จากการ์ดข้างล่าง ถ้าการ์ดไม่ตั้ง text color หน้าเหล่านั้นจะตกไปใช้ default ของ
// เบราว์เซอร์ → คลาสชุด text-left + text-base + leading-relaxed + สีหมึกของรอบนี้
// บน element ที่ถือ <slot /> ห้ามหายไปสักตัว (รอบนี้สีหมึกคือ 36080f)
// ⚠️ เขียนชื่อคลาสสีแบบถอดวงเล็บโดยตั้งใจ — Tailwind สแกนไฟล์นี้แบบ plain text
// รวมถึงคอมเมนต์ด้วย การพิมพ์คลาสสีเต็มรูปในคอมเมนต์จึงทำให้ยูทิลิตี้ของค่านั้น
// ถูก generate ลง stylesheet จริง (เคยเจอค่าของแบรนด์ก่อนหลุดมาทางนี้)
//
// Flattened single-slot variant (ทำเมื่อ 2026-07-26): isolate บนการ์ด + -z-10
// บนชั้นตกแต่ง absolute ทุกชั้น slot จึง render เป็นลูกตรงของการ์ด
// **ห้ามเพิ่ม wrapper <div> รอบ slot กลับมา** และถ้าจะเปลี่ยนสีตัวอักษรของการ์ด
// ให้ **แทนที่** คลาสสีเดิม ไม่ใช่ใส่คลาสสีที่สองข้างๆ (specificity เท่ากัน ผลจะ
// ขึ้นอยู่กับลำดับที่ Tailwind บังเอิญ emit)
//
// House style เนื้อความ: element ที่ถือ slot ได้ text-left + text-base +
// leading-relaxed + สี — ห้ามย่อหรือขยายขนาดตัวอักษรของเนื้อความ · หัวข้อจัดกลางได้
// แต่ต้องใส่ text-center ที่ตัวหัวข้อเอง **ห้ามใส่บนการ์ดหรือ <section>** เพราะมันจะ
// inherit ลงไปใน slot แล้วทำให้ย่อหน้าของทุกหน้าที่เรียกไฟล์นี้กลางตามไปด้วย
//
// หัวข้อมาจาก prop title + as เท่านั้น (เป็นหัวข้อจริงของบทความ/หน้านั้นๆ)
// **ห้าม hardcode ข้อความไทยเป็น heading ในไฟล์นี้** — เป็นโครมที่ขึ้นทุกหน้า
//
// ────────────────────────────────────────────────────────────────────────────
// รอบนี้ (123BET) พาเลตตาม .claude/brand-spec-123bet.md §2
// 🚨🚨 **กลับทิศ 180° จากรอบก่อน: รอบนี้การ์ดเป็นผิวสว่าง ไม่ใช่การ์ดเข้ม**
// เหตุผล: bg.json ของดรอปนี้เป็น mode color + color **f7e4e9 = ชมพูบลัชจาง**
// (รอบก่อน ZORO365 เป็น 002908 = เขียวป่าจมเกือบดำ ซึ่งอยู่คนละปลายของสเกล)
// และ bg.json คือแหล่งเดียวของพื้นเพจ
// ⚠️⚠️ **รอบนี้เนื้อหาสว่าง ส่วนโครม (navbar/footer/ticker) เป็นผิวเข้ม**
// การ์ดนี้เป็น fdf5f6 ซึ่งสว่างกว่าพื้นเพจ f7e4e9 เล็กน้อยพอให้แยกชั้นได้
// **ห้าม "แก้" การ์ดกลับไปเป็นผิวเข้มตามรอบก่อน** — การ์ดเข้มบนหมึก 36080f
// จะทำให้หน้า terms/privacy/404 ที่พึ่ง BRAND_TEXT ตัวอักษรหายไปเลย ไม่ใช่แค่จางลง
//
// อ่านจากอาร์ตเวิร์กจริง: โลโก้เป็น **เวิร์ดมาร์กสามมิติ ครึ่งแรกเป็นตัวเลขผิว
// แดงชาดเคลือบเงาตัดขอบทอง ครึ่งหลังเป็นตัวอักษรละตินผิวโครเมียมเงินขัดเงา
// เหนือขึ้นไปเป็นมงกุฎเงินประดับกำมะหยี่แดงและอัญมณีแดง วางบนโล่โครเมียมเงินที่มี
// เพชรแดงที่ปลายล่าง** ส่วนแบนเนอร์เป็นฉาก **โถงวังหินอ่อนสีงาช้างที่มีเสาและ
// ซุ้มโค้ง หญิงสาวสวมมงกุฎทองประดับอัญมณีแดงและชุดราตรีแดง-ขาวปักทอง
// กองชิปคาสิโนแดง-ขาว และไพ่เอซโพดำ**
// ⚠️ **ผนังหินอ่อนสีงาช้างและสีผิวของนางแบบเป็นวัตถุในภาพ ไม่ใช่สี UI** —
// พื้นเพจมาจาก bg.json เท่านั้น **ห้ามอนุมานจากรูป**
//
// บทบาทสีในไฟล์นี้:
//   ผิวการ์ด fdf5f6 · ชั้นยก f7dfe4 · เส้นบาง eec3cc · ขอบตกแต่ง/ออรา d98fa0
//   พื้นเพจ f7e4e9 · โครม 330710 / 1c050b
//   แดงชาด a30d1a = **สีหัวข้อ** (7.4:1 บนการ์ด ผ่าน AA สบาย) และเป็นสีของ
//     ลิงก์กับ <strong> ทั้งเว็บ
//   หมึก 36080f = สีเนื้อความ (= BRAND_TEXT) 16.3:1 บนการ์ด · หมึกรอง 6b2b33 (9.7:1)
//   ทองเข้ม 7a4a0c (7.0:1) ถือตัวอักษรบนการ์ดได้ ใช้เป็นคู่สีที่สองได้
// 🚨🚨 **eec3cc (1.5:1) · d98fa0 (2.3:1) · ef4a5e — ห้ามเป็นสีตัวอักษรในไฟล์นี้
//   เด็ดขาด** เป็นเส้น/ขอบ/ออรา/พื้นถมเท่านั้น
// ⚠️⚠️ **f7e4e9 fdf5f6 f7dfe4 eec3cc d98fa0 330710 1c050b เป็นผิว ไม่ใช่สีตัวอักษร**
// ส่วน **36080f (16.3:1) · 6b2b33 (9.7:1) · a30d1a (7.4:1) · 7a4a0c (7.0:1)
// ถือตัวอักษรบนการ์ดสว่างได้ทั้งหมด**
// rgba() ที่อนุญาตรอบนี้: rgba(163,13,26,α) · rgba(220,165,58,α) ·
// rgba(217,143,160,α) · rgba(54,8,15,α)
//
// ⚠️ ไฟล์นี้เป็นของแบรนด์ก่อนหน้าทุกรอบ ห้ามเหมาว่าสีที่เจอเป็นของรอบนี้ ต้องเทียบ
// เป็น **"ค่า"** ไม่ใช่ "ตระกูลสี"
// 🚨🚨 **กับดักรอบนี้กลับทิศจากทุกรอบที่ผ่านมา**: spec ของสามรอบก่อนเขียนไว้ว่า
// "รอบนี้ไม่มีแดงเป็นสี UI เลยสักเฉด" — **รอบนี้แดงชาดคือฮิวนำของแบรนด์**
// สิ่งที่ห้ามคือ **ค่าเฮกซ์ของแบรนด์เก่าแบบตรงหกหลัก** ไม่ใช่ "สีแดง" ในฐานะตระกูลสี
// 🚨🚨 และเพราะรอบนี้เป็นแบรนด์ แดง/ทอง/ขาวชมพู **LOTTO189 จึงเป็นแบรนด์ที่
// ใกล้ตัวที่สุด (ตระกูลสีเดียวกันเป๊ะ)** รองลงมาคือ MEXICANOSLOT (แดง/ทอง/ครีม)
// ค่าที่กวาดออกครบแล้วจากไฟล์นี้ (ของ ZORO365 รอบก่อนทันที):
//   002908 010d04 031b09 073c1a 0e5424 1e7033 35a043 3ddc4a dfe6e3 e8c86a eef7f0
//   9dc2a5 + rgba(61,220,74) rgba(53,160,67) rgba(30,112,51) rgba(232,200,106)
//   rgba(223,230,227) rgba(1,13,4)
// **ลิสต์เฮกซ์เต็มของทุกแบรนด์อยู่ที่ .claude/brand-spec-123bet.md §2 —
// ไม่ซ้ำลงที่นี่โดยตั้งใจ** ลิสต์เดียวที่อัปเดตที่เดียวย่อมไม่หลุดกันเอง
//   ⚠️⚠️ คู่ที่ต้องสงสัยว่าพิมพ์ผิดก่อนเสมอ:
//   a81410 c1071b b00718 ↔ a30d1a · 7e1221 8a0412 ↔ 8a1420 ·
//   3d0d16 25090f 24060c ↔ 36080f/330710 · 6e3b44 80453a ↔ 6b2b33 ·
//   7a3a0c 9f600d ↔ 7a4a0c · e9b53c e3bb45 e0b03a ↔ dca53a ·
//   fef6fb fff4fb fdc6c3 ↔ fdf5f6 · ffe4e6 ffd4d7 f5b9bd f0bcbc ↔ f7e4e9/f7dfe4 ·
//   f7bcd9 ef8dbd e2855c ↔ eec3cc/d98fa0
// ⚠️ (เขียว 00B900 ของปุ่ม LINE และเขียว success ของฟีดถอนเงินอยู่ไฟล์อื่น
//   **คงไว้ ห้ามเปลี่ยนเป็นแดงตามพาเลตรอบนี้** — สองค่านั้นเป็นสีเชิงความหมาย
//   ไม่ใช่สีแบรนด์)
// (เฮกซ์ของแบรนด์เก่าในคอมเมนต์ด้านบนเขียนแบบ **ไม่มี #** โดยตั้งใจ เพื่อไม่ให้
// การ sweep ไล่หาสีของแบรนด์เก่าใน src/ สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#eec3cc] bg-[#fdf5f6] p-8 text-left text-base leading-relaxed text-[#36080f] shadow-[0_10px_30px_rgba(54,8,15,0.12)] transition-all duration-500 hover:border-[#d98fa0] hover:shadow-[0_15px_40px_rgba(163,13,26,0.18)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[3px] bg-gradient-to-r from-[#dca53a] via-[#a30d1a] to-[#8a1420]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#a30d1a]/15 blur-[60px] transition-all duration-500 group-hover:bg-[#a30d1a]/25"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#dca53a]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#dca53a]/40"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="text-2xl leading-normal font-black tracking-wide text-[#a30d1a]">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#dca53a] to-[#a30d1a] shadow-[0_0_10px_rgba(163,13,26,0.35)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
