---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// BRAVO168 (รอบน้ำเงินรอยัล-ทอง 2026-09-30): เว็บแทงบอลออนไลน์ พาเลตต์มาจากโลโก้ที่
// คำว่า BRAVO เป็นโครเมียมไล่น้ำเงินรอยัล ส่วนเลข 168 เป็นทองตัน และแบนเนอร์สนาม
// ฟุตบอลกลางคืนพื้นกรมท่ามีริ้วแสงทอง เหรียญทอง และลูกบอลทอง-กรมท่า — การ์ดกรมท่า
// #04142f ในกรอบทองแบรนด์ #f4cb69 ออร่ามุมซ้ายบนเป็นทอง มุมขวาล่างเป็นน้ำเงินรอยัล
// #1558c4 หัวข้อไล่เฉดโครเมียม #e8f1ff → ทอง #f4cb69 → น้ำเงินรอยัล #1558c4
// เนื้อความ #dbe5f5 (BRAND_TEXT) — ชุดเขียวนีออนของ CK268 รอบก่อน
// (#8bfc13 #c9ff8f #12a008 #1a7a08 #d5e6cd #e8f0e6 #0b160b) ออกครบแล้ว
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#f4cb69]/45 bg-[#04142f]/94 p-8 text-left text-base leading-relaxed text-[#dbe5f5] shadow-[0_10px_30px_rgba(1,4,12,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffe39a]/70 hover:shadow-[0_15px_40px_rgba(244,203,105,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#f4cb69]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#f4cb69]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#ffe39a]/38"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#1558c4]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#2f86f0]/32"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#e8f1ff] via-[#f4cb69] to-[#1558c4] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#e8f1ff] via-[#f4cb69] to-[#1558c4] shadow-[0_0_10px_rgba(244,203,105,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
