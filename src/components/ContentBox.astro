---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro, /promotion and
// every button page render their body through this file and never follow the
// per-brand ContentBox rotation, so it must carry the CURRENT brand's colours
// even when index.astro picks another variant. Nothing inside those pages names
// a colour — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// ขวัญใจ168 (รอบทองนำ-โรสโกลด์รอง บนดำสนิท 2026-10-18): พาเลตต์ตาม
// .claude/brand-spec-kwanjai168.md §2
// โลโก้อ่านตรงๆ ได้ว่า: คำว่า "ขวัญใจ" เป็นตัวอักษรไทยหนาสามมิติ **ผิวทองขัดเงา
// ตัดขอบแดงเข้ม** ต่อด้วยเลข "168" ทองสามมิติ วางบนโบว์ริบบิ้นทอง ด้านหลังเป็น
// หญิงสาวผมดำเกล้ามวยประดับปิ่นทองและดอกไม้ขาว ในชุดไทยแดงปักทอง ล้อมด้วยเหรียญ
// จีนทองรูสี่เหลี่ยมและหัวใจแดง ส่วนแบนเนอร์กับสไลด์เป็นฉากพื้นดำที่มีหญิงสาวสองคน
// ขนาบข้าง ฝนเหรียญทอง ผ้าซาตินแดง ดอกลิลลี่ขาว และกรอบลวดลายทอง
//
// ⚠️ รอบนี้ **ทองนำ โรสโกลด์เป็นฮิวที่สอง แดงชาดเป็นสำเนียงลึกที่ไม่เคยนำ** —
// ต่างจากรอบก่อน (รับตัง168: ทองนำ + แดงสดเป็นคู่หู) และต่างจากรอบก่อนหน้านั้น
// (สมหวัง168: แดงนำ) ด้วย โรสโกลด์ #f2bba5 คือ vivid อันดับหนึ่งที่ palette.json
// วัดได้จากทั้งโลโก้และแบนเนอร์ และเป็นสิ่งที่แยกรอบนี้ออกจากสองรอบก่อนจริงๆ
// ขอบการ์ดและเส้นคาดบนเป็นทอง ส่วนโรสโกลด์ถือออรามุมซ้ายบนและสต็อปกลางของเส้นใต้
// ⚠️ พื้นเพจรอบนี้เป็น **ดำสนิท** (bg.json = {"mode":"color","color":"#000000"})
// ไม่ใช่ดำอมแดงแบบรอบก่อน ลำดับความลึก: #241509 ผิวยก (การ์ดใบนี้) / #160d06 กลาง /
// #0b0603 จม / #000000 พื้น
//
// ทองแบรนด์ #f7c92b (วัดจากตัวอักษรบนโลโก้และฝนเหรียญ) ถือขอบการ์ดและเส้นคาดบนสุด ·
// ทองสว่าง #ffe6a3 เป็นต้นของหัวข้อ · โรสโกลด์ #f2bba5 เป็นปลายหัวข้อและสี hover
// ของขอบ · โรสเข้ม #c98a74 ถือตัวอักษรรองได้ · แดงชาด #b3121b เป็นออรามุมซ้ายบน
// และสต็อปกลางของเส้นใต้ · แดงลึก #5a0a0e กับทองลึก #8a5f12 เป็นออรามุมขวาล่าง
// กับปลายเข้มของเส้นใต้ — สามตัวหลังไม่เคยถือตัวอักษร
// ลำดับ ทองสว่าง→ทองแบรนด์→โรสโกลด์ ของหัวข้อคือลำดับที่ตาอ่านงานศิลป์จริง
// (ตัวอักษรทองขัดเงากลางภาพ ไล่ออกไปหาผิวและผ้าครีมของนางแบบที่ขนาบข้าง) และ
// ทั้งสามค่าอยู่ที่ 14.5:1 / 7.3:1 / 10.4:1 บนผิวการ์ดนี้ จึงผ่าน AA ทุกจุดของเกรเดียนต์
// เนื้อความเป็นครีมอมอุ่น #eadfce (= BRAND_TEXT) — 13.5:1 บนผิวการ์ดนี้
//
// ⚠️ ไฟล์นี้เป็นของแบรนด์ก่อนหน้าทุกรอบ ห้ามเหมาว่าสีที่เจอเป็นของรอบนี้ ต้องเทียบ
// เป็น "ค่า" ไม่ใช่ "ตระกูลสี" และรอบนี้กับดักหนักเป็นพิเศษ เพราะ **ทองคือฮิวนำ
// และแทบทุกแบรนด์ที่ผ่านไฟล์นี้มีทองอยู่ด้วย** ทองของรับตัง168 คือ #f0b429 ·
// ของสมหวัง168 คือ #e3b23c · ของ KMD88 คือ #e2b33f · ของ TND168 คือ #dfa310 ·
// ของ KINGKONG555 คือ #f2c230 · ส่วน **ทองรอบนี้คือ #f7c92b**
// ชุดเต็มของรับตัง168 (#f0b429 #ffdc8c #d30304 #ff6b6e #a00203 #4a0202 #9a6c0c
// #cfd9e6 #f5ece0 #2b100f #200a09 #140505 #1a0505 และ rgba(240,180,41,α)
// rgba(211,3,4,α) rgba(255,220,140,α) rgba(255,107,110,α)) ออกครบทุกจุดแล้ว
// เช่นเดียวกับชุดของสมหวัง168 (#fa0513 #ffadaf #ff5a5f #e3b23c #ffe5a8 #8a6210
// #b90203 #8c0204 #5b0203 #3c0303 #170504 #f4ecea #ccb9b6 #2c1413 #1f0d0c
// #140706 #290f0f) ของ TKB55 (#fb131b #ff8a8f #ff4d55 #e9eef4 #aeb9c6 #f2e4e5
// #2a0d0f #1a0708 #0d0304 #c40304 #8a0206 #53050a #1a0304) และของ GT66B
// (#fb141b #ff5f63 #ffa0a2 #db040b #ec151c #8a0609 #3b0405 #fdfcfd #b4bcc2
// #eceaea #190505 #1c0c0b #130c0c #0b0303)
// ค่าของแบรนด์เก่ากว่านั้นที่เคยผ่านไฟล์นี้ — TSDET911 น้ำเงินไฟฟ้า · KMD88 ม่วง
// ราชา-ทอง · TND168 ทองมังกร · WEPLAY168 ม่วงนีออน · PUNPRO168 ชมพูฮอตพิงก์ ·
// 789BETTING ทองเมทัลลิก · TIGERWIN369 ทองอำพัน · UFA324 ทองแชมเปี้ยน ·
// FAH999 ชมพู-ทอง · DUCK1688 ทองเป็ด · NAZA168 ทองอวกาศ · KINGKONG555 เขียว-ทอง
// — ไม่เหลือในไฟล์นี้แล้วเช่นกัน (ไม่พิมพ์ค่าซ้ำที่นี่ รายการเต็มอยู่ใน
// brand-spec §2 เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive ในไฟล์ที่ render)
// ⚠️ **รอบนี้ไม่มีม่วง ไม่มีชมพูบานเย็น ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว ไม่มีส้ม
// และไม่มีเงิน/โครเมียมอมฟ้า** (#cfd9e6 เป็นของรับตัง168 โลโก้รอบนี้ไม่มีโครเมียมเลย)
//
// ⚠️ #b3121b เป็นขอบ/ออรา/ไล่เฉด ส่วน #5a0a0e และ #8a5f12 ห้ามถือตัวอักษรทุกขนาด
// อยู่ได้เฉพาะในไล่เฉดของเส้นคาด ในออรา และเป็นขอบ ส่วน #ffe6a3 (14.5:1)
// #f2bba5 (10.4:1) #c98a74 (7.2:1) และ #f7c92b (7.3:1) ถือตัวอักษรรองได้จริง
// และ #ffe6a3 คือตัวที่สงวนไว้ใช้ไฮไลต์ <strong> ในเนื้อความเท่านั้น
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#f7c92b]/45 bg-[#241509]/95 p-8 text-left text-base leading-relaxed text-[#eadfce] shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#f2bba5]/70 hover:shadow-[0_15px_40px_rgba(247,201,43,0.35)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#f7c92b]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#b3121b]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#f2bba5]/30"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#5a0a0e]/80 blur-[60px] transition-all duration-500 group-hover:bg-[#8a5f12]/45"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#ffe6a3] via-[#f7c92b] to-[#f2bba5] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#f7c92b] via-[#b3121b] to-[#5a0a0e] shadow-[0_0_10px_rgba(247,201,43,0.65)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
