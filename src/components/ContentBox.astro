---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#f36403]/32 bg-[#1c0a02]/92 p-8 text-left text-base leading-relaxed text-[#f6e4d6] shadow-[0_10px_30px_rgba(5,2,1,0.72)] backdrop-blur-xl transition-all duration-500 hover:border-[#fd9a1e]/60 hover:shadow-[0_15px_40px_rgba(243,100,3,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#f36403]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#f36403]/32"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#8a3103]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#fd9a1e]/32"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#f36403]/32 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fd9a1e] to-[#8a3103] shadow-[0_0_10px_rgba(243,100,3,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fff2e6] via-[#fd9a1e] to-[#f36403] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
