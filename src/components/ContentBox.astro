---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro, /promotion,
// /about-us, /contact-us, /ทางเข้า, /ทดลองเล่น, /login และ /register render ตัว
// เนื้อหาผ่านไฟล์นี้ (10 หน้ารอบนี้) และไม่เคยเดินตาม ContentBox rotation ของ index
// → ไฟล์นี้ต้องถือพาเลตของ "แบรนด์ปัจจุบัน" เสมอ ต่อให้ index เลือก variant อื่น
// ⚠️ รอบนี้ **หน้าแรกใช้ไฟล์นี้ด้วย** (หัวข้อ H3 "ขั้นตอนสมัครสมาชิก" ใช้การ์ดตัวฐาน
// คั่นกลางชุด Neumorphism) แต่สถานะ shared chrome ของไฟล์นี้ไม่ได้ขึ้นกับข้อนั้น —
// สิบหน้าข้างบนใช้อยู่แล้วไม่ว่า index จะเลือก variant ไหน
// **ห้ามปล่อยให้มันหลุดจากชุดที่ retheme ใน P1 เด็ดขาด**
// ⚠️ รอบนี้ /ตรวจหวย และ /แนวทาง ยังอยู่ใน src/pages-disabled/ (แบรนด์สล็อต)
// จำนวนหน้าจึงเป็น 10 — ไม่กระทบสถานะ shared chrome ของไฟล์นี้
// ⚠️ หน้าถาวรพวกนั้น **ไม่ประกาศสีตัวอักษรเองเลยสักจุด** ย่อหน้าทั้งหมด inherit สีมา
// จากการ์ดข้างล่าง ถ้าการ์ดไม่ตั้ง text color หน้าเหล่านั้นจะตกไปใช้ default ของ
// เบราว์เซอร์ → คลาสชุด text-left + text-base + leading-relaxed + สีหมึกของรอบนี้
// บน element ที่ถือ <slot /> ห้ามหายไปสักตัว (รอบนี้สีหมึกคือ #3f130d)
// ⚠️ เขียนชื่อคลาสสีแบบถอดวงเล็บโดยตั้งใจ — Tailwind สแกนไฟล์นี้แบบ plain text
// รวมถึงคอมเมนต์ด้วย การพิมพ์ `text-[#xxxxxx]` เต็มรูปในคอมเมนต์จึงทำให้ยูทิลิตี้
// ของค่านั้นถูก generate ลง stylesheet จริง (รอบนี้เจอค่าของแบรนด์ก่อนหลุดมาทางนี้)
//
// Flattened single-slot variant (ทำเมื่อ 2026-07-26): `isolate` บนการ์ด + `-z-10`
// บนชั้นตกแต่ง absolute ทุกชั้น slot จึง render เป็นลูกตรงของการ์ด
// **ห้ามเพิ่ม wrapper <div> รอบ slot กลับมา** และถ้าจะเปลี่ยนสีตัวอักษรของการ์ด
// ให้ **แทนที่** คลาสสีเดิม ไม่ใช่ใส่คลาสสีที่สองข้างๆ (specificity เท่ากัน ผลจะ
// ขึ้นอยู่กับลำดับที่ Tailwind บังเอิญ emit)
//
// House style เนื้อความ: element ที่ถือ slot ได้ `text-left text-base
// leading-relaxed <สี>` — ห้ามย่อหรือขยายขนาดตัวอักษรของเนื้อความ (คลาส sm/lg
// ของ text-* ใช้กับย่อหน้าไม่ได้) · หัวข้อจัดกลางได้ แต่ต้อง
// ใส่ text-center ที่ตัวหัวข้อเอง **ห้ามใส่บนการ์ดหรือ <section>** เพราะมันจะ
// inherit ลงไปใน slot แล้วทำให้ย่อหน้าของทุกหน้าที่เรียกไฟล์นี้กลางตามไปด้วย
//
// หัวข้อมาจาก prop `title` + `as` เท่านั้น (เป็นหัวข้อจริงของบทความ/หน้านั้นๆ)
// **ห้าม hardcode ข้อความไทยเป็น heading ในไฟล์นี้** — เป็นโครมที่ขึ้นทุกหน้า
//
// ───────────────────────────────────────────────────────────────────────────
// รอบนี้ (MEXICANOSLOT) พาเลตตาม .claude/brand-spec-mexicanoslot.md §2
// 🚨 **เนื้อหายังเป็นธีมสว่างเหมือนรอบก่อน แต่ฮิวคนละตระกูลสิ้นเชิง และโครมกลับทิศ**
// เหตุผล: bg.json ของดรอปนี้เป็น {"mode":"color","color":"#fef6fb"} = **ขาวอมชมพูจาง**
// (รอบก่อนเป็น ffd6fa = ชมพูบับเบิลกัมพาสเทลที่อิ่มกว่านี้มาก) และ bg.json คือ
// แหล่งเดียวของพื้นเพจ
// ⚠️ **navbar/footer/ticker รอบนี้เป็นผิวเข้ม (#2b100a) แต่ไฟล์นี้ไม่ใช่** —
// **ห้าม "แก้" การ์ดให้เป็นพื้นมืดตามโครม** การ์ดมืดบนหมึก #3f130d จะทำให้หน้า
// terms/privacy/404 ที่พึ่ง BRAND_TEXT ตัวอักษรหายไปเลย ไม่ใช่แค่จางลง
//
// อ่านจากอาร์ตเวิร์กจริง: โลโก้เป็น **ชายการ์ตูนไว้หนวดสวมซอมเบรโรฟางขอบลายปัก
// แดง-เขียว ยกนิ้วโป้ง อยู่ข้างเวิร์ดมาร์กสามมิติ "MEXICANO" แดงสด + "SLOT"
// น้ำเงินไล่ฟ้า ตัดขอบขาวหนา บนพื้นโปร่ง** ส่วนแบนเนอร์เป็นฉาก **กลางแจ้งเม็กซิกัน
// พื้นสว่าง มีอาคารอะโดบีครีมและกระบองเพชรเขียว** และสไลด์ทั้งสองใบเป็น **ฉาก
// ผ้าซาราเป้ลายทางแดง-เขียว** พิมพ์เลข 0.3% / 0.8% ตัวแดงเข้ม
// ⚠️ **ซอมเบรโรฟาง ปอนโช กีตาร์ เหรียญทอง มาราคัส และสีผิวนักแสดงเป็นวัตถุในภาพ
// ไม่ใช่สี UI** — พื้นเพจมาจาก bg.json เท่านั้น
// 🚨🚨 **"SLOT" สีน้ำเงินไล่ฟ้าในเวิร์ดมาร์กก็เป็นอาร์ตเวิร์ก ไม่ใช่สี UI** —
// ฟ้าคือฮิวนำของ โบ๊ะบ๊ะ168 เมื่อสองรอบก่อน ดึงมันเข้ามา = หลงเหลือข้ามแบรนด์
//
// บทบาทสีในไฟล์นี้:
//   ผิวการ์ด #ffffff · ชั้นยก/แถบอ่อน #fff3ea · wash #fde4d3 · พื้นเพจ #fef6fb
//   แดงลึก #a81410 = **สีหัวข้อ** (7.6:1 บนการ์ดขาว ผ่าน AA สบาย) และเป็นปลาย
//     ร้อนของเส้นใต้หัวข้อ
//   แดงเม็กซิกัน #de2b1e = **ฮิวนำ แต่เป็นสีพื้น/เส้น/ออราเท่านั้น** อ่านจาก
//     อาร์ตเวิร์กตรงๆ (เวิร์ดมาร์ก · พริก · ลายปักซอมเบรโร · เลขบนสไลด์ · ธงชาติ)
//   ทอง #f2a033 · พีช/ฟาง #fed7b5 #fec28d · เส้น #f6c4a4 · เส้นเข้ม #e2855c
//     (**ทั้งหมดห้ามถือตัวอักษรบนผิวสว่าง**)
//   หมึก #3f130d = สีเนื้อความ (= BRAND_TEXT) 14.9:1 บนการ์ดขาว · หมึกรอง #80453a (6.6:1)
//   เขียวเม็กซิกัน #117a41 = แอคเซนต์ (5.4:1 บนการ์ดขาว — ถือตัวอักษรได้)
// 🚨🚨 **#de2b1e บนพื้นขาวได้แค่ 4.0:1 — ห้ามเป็นสีตัวอักษรในไฟล์นี้เด็ดขาด**
//   และ **ขาวบน #de2b1e ได้ 4.7:1 ซึ่งเฉียดเกินไป** พื้นแดงที่รับหมึกขาวได้ต้องเป็น
//   #c81e12 (5.7:1) ลงไป
// ⚠️⚠️ **#ffffff #fff3ea #fde4d3 #fef6fb #f6c4a4 #e2855c #fed7b5 #fec28d #f2a033
// #de2b1e ห้ามถือตัวอักษรบนผิวสว่าง** ส่วน **#3f130d (14.9:1) · #80453a (6.6:1) ·
// #a81410 (7.6:1) · #117a41 (5.4:1) · #c81e12 (5.7:1 กับขาว) ถือตัวอักษรได้**
// ⚠️⚠️ **#f2543f (3.5:1) และ #2bb061 (2.9:1) เป็นสีของ "โครมเข้ม" เท่านั้น
// ห้ามหลุดเข้ามาในไฟล์นี้**
// rgba() ที่อนุญาตรอบนี้: rgba(222,43,30,α) · rgba(242,160,51,α) ·
// rgba(168,20,16,α) · rgba(63,19,13,α) · rgba(246,196,164,α) · rgba(254,215,181,α)
//
// ⚠️ ไฟล์นี้เป็นของแบรนด์ก่อนหน้าทุกรอบ ห้ามเหมาว่าสีที่เจอเป็นของรอบนี้ ต้องเทียบ
// เป็น **"ค่า"** ไม่ใช่ "ตระกูลสี"
// รอบก่อนหน้าทันที (okkub88 ชมพูบับเบิลกัมนำ + ขาวรอง **สว่างทั้งหน้ารวมโครม** —
// **ตัวที่เสี่ยงหลงเหลือสูงสุด**) ที่กวาดออกครบแล้วจากไฟล์นี้:
//   ffd6fa fff4fb ffe3f5 ffe9f7 f9b2d9 f479b9 f4a7cf 6a0f3c 95486b 9c0f55 fb439b
//   fc74b5 ffc2e2 d91a73 b01160 85094a + rgba(251,67,155) rgba(255,194,226)
//   rgba(156,15,85) rgba(106,15,60) rgba(249,178,217)
// 🚨🚨 **แดงคือตระกูลของรอบนี้ จึงต้องเทียบทีละค่าแน่นที่สุด** ชมพู/แมเจนต้า/แดงของ
// แบรนด์อื่นที่ **ห้ามใช้** — เริ่มที่ หมูบิน168:
//   fa539c c2185b 8e0f41 fb8cc0 fdc6c3 ffd1cd f7bcd9 ef8dbd ffe5ff fff0f8 ffeef7
//   3b0b26 54123a 7a2350 ffe9f5 7a4463
//   ⚠️⚠️ **สามคู่ที่ใกล้จนต้องสงสัยว่าพิมพ์ผิดก่อนเสมอ: ffe9f5 ↔ #ffe9f7 ต่างกัน
//   แค่ไบต์สุดท้าย · fb8cc0 ↔ #fb439b R เท่ากันเป๊ะ · f7bcd9 ↔ #f9b2d9 B เท่ากันเป๊ะ**
//   f5469f ff8dc6 8c0f52 (มีโชค168) · fa63b9 ffb3de (ถอนชัวร์168) · dd1b74 a4186b
//   4a0d35 2d0720 (มีทรัพย์168) · fb2e33 cb0b0d d81115 b00d11 8a0608 (สล็อต168
//   — ⚠️ **b00d11 ↔ #b01160 สี่ตัวแรก b01 ตรงกัน**) ·
//   ff2e52 e01238 c9102f (มาดาม168) · fb1b32 ff8f9c 5c0410 (มีเฮ168) ·
//   fa0513 ff5a5f ffadaf (สมหวัง168) · b3121b 5a0a0e f2bba5 (ขวัญใจ168) ·
//   fb141b ff5f63 ffa0a2 (GT66B) · eb0305 e40303 c20305 (โปรดี168) ·
//   c30303 8f0505 e81313 (รวยแท้168) · d9212a 8e1a16 (ดวงเศรษฐี168) ·
//   e4021b (รวยเทพ168) · d30304 a00203 (รับตัง168) · dc0203 f5282a (หวย365) ·
//   ff3b14 6d0804 (FLASH877) · f41571 ff5ca8 (PUNPRO168 — ⚠️ **f41571 ห่างจาก
//   #fb439b แค่ R7/G46/B38 ใกล้ที่สุดในลิสต์**)
// 🚨 ฟ้า/น้ำเงินของแบรนด์เก่า — **รอบนี้ไม่มีฟ้าเลยสักเฉด** และเพิ่งเป็นตระกูลของ
// รอบก่อนทันที จึงเสี่ยงหลงเหลือสูงสุด:
//   00bfff 12b4ef b6e3f0 7fcbe8 4fb8ea 06283f 0b4a73 2a87c4 eaf7ff f0faff e4f6fb
//   355f7d 0f5684 1a6ea8 (โบ๊ะบ๊ะ168) · 1177e8 0e68cc 0a4ea8 00091f 0b1733 16234a
//   (มาดาม168) · 1fd8f0 0bb6d4 1d4fd8 143aa0 (นาซ่า168) · 18a5e2 0d6b9b 0a5176
//   a9d7f2 (ร่ำรวย168) · 2cc3fc 6bdcfb 0a7fbd 063a57 (สบาย168) · 039cfa 0494f5
//   c3ebfc (รวยแทร่168) · 32bcfb a9e9ff 07335f (นินจา168) · 2f9ff5 a8dcff d6ecff
//   0b3f78 e8f4ff (สบายเบท168) · 0360f3 0292fb 6ec8ff (TSDET911)
// ⚠️ ทอง/เหลืองของแบรนด์เก่า (รอบนี้ไม่มีทองเลยสักเฉด):
//   ffd94a e3a712 9d6f06 b07d08 (รวย168) · eeae12 fded41 9f600d (พักยก168) ·
//   dcb95f b8862b 96681f (รวยแท้168) · f5ba14 fcee52 b37c0b (เงินทอง168) ·
//   fdcb0c fefb6b 8a6504 (สบาย168) · fee45d e6a416 b8780d (ยูฟ้า168) ·
//   e5a81b ffe08a bb8410 (UFA324) · fbc134 ffe87a cf9a18 (NAZA168 ตัวละติน) ·
//   d4922c fdfc71 (ufalion168) · f7c92b ffe6a3 (ขวัญใจ168) · e3b23c ffe5a8
//   (สมหวัง168) · f9a826 (รวยแทร่168) · fcd45c (มีเฮ168) · ffdc8c f0b429
//   (รับตัง168) · f0c878 (ดวงเศรษฐี168) · f0b46a d9803a (โปรดี168) ·
//   ffc93c ffeab0 (หวย365) · f5b61d (PIGPG) · fef54b (นินจา168) · c9cb63 (สาธุ168) ·
//   ffd84d (ถอนชัวร์168) · fcd434 ffeaa0 (มีโชค168) · ffc82e (สบายเบท168)
//   ⚠️⚠️ **ดาวเหลืองกับเหรียญทองในอาร์ตเวิร์กรอบนี้เป็นวัตถุในภาพ ไม่ใช่สีแบรนด์**
// ⚠️ ครีม/เบจ/น้ำตาล/เทาเงินของแบรนด์เก่า — รอบนี้ไม่มีเลย:
//   f4ead6 d6c6a8 1f0f04 4e2f11 291d0f (พักยก168) · f4e4d3 e4cbb3 (ร่ำรวย168) ·
//   ecd5c4 d2b9a4 29210f (เงินทอง168) · eadfce (ขวัญใจ168) · f3ece0 bfb8aa
//   (รวย168) · f0e6e4 c9b9b7 e3d6d4 7d6f6e (สล็อต168) · e8eaee b4b9c2 6b7079
//   dde1e7 (รวย168) · d9dfe9 b3bdd6 f4eef1 (มาดาม168) · e0e0df c0c0bf a1a09e
//   (พักยก168) · e8ecf1 a8b2bf 78828f (ยูฟ้า168) · 8792a0 b9c2cc (UFA324) ·
//   fdfcfd b4bcc2 eceaea (GT66B) · cfdcec 9db4d4 (TSDET911)
//   ⚠️⚠️ **ผิวสว่างของรอบนี้เป็นขาวอมชมพู (R≥B>G)** ซึ่งต่างจากครีม/งาช้าง (R>G>B)
//   และจากขาวอมฟ้า (B>G>R) ของรอบก่อนทุกค่า — ตรวจทีละค่า อย่าตัดสินด้วยสายตา
//   🚨 **แต่ขาวอมชมพูคือผิวของ หมูบิน168 ด้วย (ffe5ff fff0f8 ffeef7 ffe9f5)**
//   การดู "ทิศของช่องสี" จึงไม่พอรอบนี้ ต้องเทียบค่าเต็มทั้งหกหลัก
// ⚠️ ม่วง/เขียวของแบรนด์เก่า — รอบนี้ไม่มีเลย: 7e22ce d946ef a855f7 (CEO66) ·
//   7505cc b453ff c07cff d9b8ff 3a0565 (KMD88) · 0b7d28 0a5f1c 0f9b35 (สาธุ168)
//   (เขียว #00B900 ของปุ่ม LINE และเขียว success ของฟีดถอนเงินอยู่ไฟล์อื่น คงไว้)
// (เฮกซ์ของแบรนด์เก่าในคอมเมนต์ด้านบนเขียนแบบ **ไม่มี #** โดยตั้งใจ เพื่อไม่ให้
// การ sweep ไล่หาสีของแบรนด์เก่าใน src/ สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#f6c4a4] bg-white p-8 text-left text-base leading-relaxed text-[#3f130d] shadow-[0_10px_30px_rgba(168,20,16,0.12)] transition-all duration-500 hover:border-[#de2b1e] hover:shadow-[0_15px_40px_rgba(222,43,30,0.22)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[3px] bg-gradient-to-r from-[#117a41] via-[#de2b1e] to-[#f2a033]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#de2b1e]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#de2b1e]/30"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#fed7b5]/50 blur-[60px] transition-all duration-500 group-hover:bg-[#fed7b5]/70"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="text-2xl leading-normal font-black tracking-wide text-[#a81410]">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#de2b1e] to-[#f2a033] shadow-[0_0_10px_rgba(222,43,30,0.45)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
