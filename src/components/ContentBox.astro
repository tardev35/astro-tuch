---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// 789BETTING (รอบทองเมทัลลิกบนดำสนิท 2026-10-08): คาสิโนฐานเข้าหลัก
// พาเลตต์ตาม brand-spec §2 รอบนี้พลิกจากชุดตรุษจีนสามสีของ GUCCI168 (แดง-เขียว
// มรกต-ทอง) มาเป็นแบรนด์ฮิวเดียว — การ์ดยังเป็นกระจกมืดเหมือนเดิมแต่เป็นผิวเกือบดำ
// อมทอง #17130a เพราะ bg.json ของดรอปนี้เป็นดำตัน #000000 (รอบก่อนเป็น gradient
// แดง->ทอง) การ์ดจึงต้อง "ยก" ขึ้นจากพื้นดำสนิทให้เห็นขอบ และงานศิลป์ทั้งชุด
// (โลโก้ แบนเนอร์ สไลด์) เป็นโถงคาสิโนดำ-ทอง ไม่มีสีที่สองเลย
//
// ทองแบรนด์ #fad354 มาจาก vivid ของ logo.webp (#fad354/#feda5c) ถือขอบการ์ด
// เส้นคาดบนสุด และเงาตอน hover · ทองแชมเปญ #ffe79a เป็นปลายสว่างของไล่เฉดหัวข้อ
// และเส้นใต้ · ทองกลาง #ddab33 กับทองลึก #8a6410 เป็นปลายเข้มของเส้นนั้น ·
// บรอนซ์ #c9881f เป็นออรามุมซ้ายบน ส่วนออรามุมขวาล่างเป็นทองลึก — สองมุมนี้จึงเป็น
// "ทองอุ่น/ทองเข้ม" ของฮิวเดียวกัน ไม่ใช่สองฮิวแบบรอบก่อน
// เนื้อความเป็นงาช้างอมทอง #f3e7cd (= BRAND_TEXT) — 15.0:1 บนผิวการ์ดนี้
//
// ชุดตรุษจีนของ GUCCI168 (#c41115 #e0201f #7a0505 #0b7a33 #2bbf63 #d9a521
// #ffdf91 #8c6410 #140705 #f6e3cf rgba(196,17,21,α) rgba(217,165,33,α)
// rgba(11,122,51,α)) และชุดทอง-เงินของ UOK365 ก่อนหน้านั้น ออกครบทุกจุดแล้ว
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#fad354]/35 bg-[#17130a]/95 p-8 text-left text-base leading-relaxed text-[#f3e7cd] shadow-[0_10px_30px_rgba(0,0,0,0.6)] backdrop-blur-xl transition-all duration-500 hover:border-[#fad354]/75 hover:shadow-[0_15px_40px_rgba(250,211,84,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#fad354]/75 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#c9881f]/40 blur-[60px] transition-all duration-500 group-hover:bg-[#fad354]/35">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#8a6410]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#ddab33]/30">
    </div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#ffe79a] via-[#fad354] to-[#c9881f] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#ffe79a] via-[#ddab33] to-[#8a6410] shadow-[0_0_10px_rgba(250,211,84,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
