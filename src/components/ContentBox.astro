---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// TIGERWIN369 (รอบทองอำพันเสือบนดำสนิท 2026-10-11): พาเลตต์ตาม brand-spec §2
// รอบนี้ตัด "โลหะเย็น" ออกทั้งหมด — UFA324 รอบก่อนเป็นคู่ "ทองแชมเปี้ยน-เงิน
// โครเมียม" คือทองอุ่นคู่เงินเย็น รอบนี้เป็น **ทองล้วนสองระดับ ไม่มีเงิน ไม่มีเทา
// ไม่มีฮิวเย็นเลย** บนพื้นดำสนิทเหมือนเดิม (bg.json = {"mode":"color",
// "color":"#000000"}) การ์ดจึงเป็นผิวยกน้ำตาลอุ่น #2d1c0a ที่สว่างกว่าพื้นเพจ
// ลอยขึ้นมาเหมือนเหรียญตราหัวเสือในโลโก้ที่ลอยอยู่บนฉากโต๊ะคาสิโนมืด
// ⚠️ พื้นเพจรอบนี้ **เป็นดำสนิท** จึงไม่มีชั้นที่ลึกกว่าพื้นได้อีกแล้ว ทุกผิวต้อง
// สว่างขึ้นจาก #000000 เท่านั้น
//
// ทองอำพันเสือ #d98324 (ฮิวหลัก — ขนหัวเสือและขอบเหรียญตราบนโลโก้) ถือขอบการ์ด
// เส้นคาดบนสุด และออรามุมซ้ายบน · ทองสว่าง #f7b733 (ตัวที่สอง — หน้าตัวอักษร
// TIGERWIN369 สามมิติ และมงกุฎทองบนหัวเสือ) เป็นกลางไล่เฉดหัวข้อและออรามุมขวาล่าง
// ลำดับ ทองสว่าง→ทองอำพัน ของหัวข้อคือลำดับที่ตาอ่านโลโก้จริง (หน้าตัวอักษรสว่าง
// ก่อน แล้วไล่ลงเงาอำพัน) · ทองซีด #ffd98a เป็นต้นสว่างสุดของหัวข้อ · อำพันลึก
// #8a5214 กับ #4a2a08 เป็นปลายเข้มของเส้นใต้ — ทั้งคู่ไม่เคยถือตัวอักษร
// เนื้อความเป็นครีมอมทอง #f7e4c0 (= BRAND_TEXT) — 13.3:1 บนผิวการ์ดนี้
//
// ⚠️ ไฟล์นี้เป็นของแบรนด์ก่อนหน้าทุกรอบ ห้ามเหมาว่าสีที่เจอเป็นของรอบนี้ ต้องเทียบ
// เป็น "ค่า" ไม่ใช่ "ตระกูลสี" — รอบนี้เป็นทองรอบที่แปดในสิบรอบ "มีทองอยู่" จึง
// ไม่ได้พิสูจน์อะไรเลย: ชุดทองแชมเปี้ยน-เงินโครเมียมของ UFA324 (#e5a81b #b9c2cc
// #231c0e #17130a #0d0b06 #f0e8d4 #ffcf5e #ffe08a #7d5a07 #43300a #464f5a)
// ชุดชมพู-ทองของ FAH999 (#ff3fa4 #ff6cbb #ffd1ea #fde8f3 #f5c53d #9c6f08 #b3006a
// #4a0b42 #3a0534 #2e002c #210220) ชุดทองเป็ด-ส้มปากเป็ดของ DUCK1688 (#f3bb34
// #fde464 #c8901a #8a5f08 #5c3f04 #f58b2a #ffc98a #a3510c #1a1203 #f6ecd9 #d8c69b
// #1f1709 #171106 #0d0903) ชุดทองอวกาศ-เงินโครเมียมของ NAZA168 (#fbc134 #ffe87a
// #cf9a18 #96690a #6b4a05 #eef2f8 #cfd6e3 #9aa6bb #3f4859 #fdf3df #d9c9a6 #4e3406
// #432b03 #382400 #241700) ชุดทองสายฟ้า-แดงเลือดนกของ FLASH877 (#f5c518 #ffdd73
// #b8860f #ff3b14 #8c0f0a) ชุดแดงเสือโคร่ง-ทองถ่านไฟของ SUPERSLOTCLUB (#e8232a
// #f2b705 #ffd666 #c08a0b) ชุดเขียว-ทองของ KINGKONG555 (#8ce023 #f2c230 #ffe066
// #a87a08 #06220a) ชุดม่วง-ทองของ WEPLAY168 (#a435f0 #5b1a75 #1e0a3c) และชุดแดง
// แล็กเกอร์ของ PIGPG (#d4200d #f5b61d #ffd87a) ออกครบทุกจุดแล้ว
// ⚠️ ทองอำพันของรอบนี้ (#d98324) จงใจ "ส้มกว่า" ทองของทุกรอบที่ลิสต์ไว้ — G=131
// เทียบกับ 168 ของ #e5a81b และ 197 ของ #f5c53d ให้เทียบเป็นตัวเลข ไม่ใช่ด้วยตา
// ⚠️ **รอบนี้ไม่มีเงิน/เทาเลย** #b9c2cc #464f5a #cfd6e3 #d8dbe0 #9aa6bb ของรอบ
// ก่อนๆ ต้องไม่เหลืออยู่ในไฟล์นี้
//
// ⚠️ #8a5214 และ #4a2a08 ห้ามถือตัวอักษรทุกขนาด อยู่ได้เฉพาะในไล่เฉดของเส้นคาด
// ในออรา และเป็นขอบ ส่วน #f7b733 (9.3:1) กับ #e3cfae (10.9:1) ถือตัวอักษรรองได้
// จริง และ #ffd98a (12.3:1) คือตัวที่ใช้ไฮไลต์ในเนื้อความ
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#d98324]/40 bg-[#2d1c0a]/95 p-8 text-left text-base leading-relaxed text-[#f7e4c0] shadow-[0_10px_30px_rgba(0,0,0,0.6)] backdrop-blur-xl transition-all duration-500 hover:border-[#d98324]/80 hover:shadow-[0_15px_40px_rgba(217,131,36,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#d98324]/75 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#d98324]/40 blur-[60px] transition-all duration-500 group-hover:bg-[#ffd98a]/30"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#4a2a08]/60 blur-[60px] transition-all duration-500 group-hover:bg-[#f7b733]/28"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#ffd98a] via-[#f7b733] to-[#d98324] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#d98324] via-[#8a5214] to-[#4a2a08] shadow-[0_0_10px_rgba(217,131,36,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
