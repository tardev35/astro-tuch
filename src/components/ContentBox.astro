---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#6a5115]/65 bg-[#0b0703]/92 p-8 text-left text-base leading-relaxed text-[#f0e2bd] shadow-[0_10px_30px_rgba(5,3,1,0.6)] backdrop-blur-xl transition-all duration-500 hover:border-[#cc9c2d]/70 hover:shadow-[0_15px_40px_rgba(204,156,45,0.26)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#cc9c2d]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#cc9c2d]/30"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#e8bf4e]/18 blur-[60px] transition-all duration-500 group-hover:bg-[#fae27c]/28"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#6a5115]/60 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fae27c] to-[#cc9c2d] shadow-[0_0_10px_rgba(232,191,78,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fff6d4] via-[#fae27c] to-[#cc9c2d] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
