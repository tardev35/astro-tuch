---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// UWIN33 (รอบทอง-โครเมียม-ดำ 2026-09-24): การ์ดดำอมน้ำตาล #161106 ในกรอบทองแบรนด์
// #e0b429 ออร่าสองมุมเป็นทอง #e0b429 กับเงินโครเมียม #dfe4ec หัวข้อไล่จากเงิน
// โครเมียม #dfe4ec → ทองสว่าง #fbd564 → ทองแบรนด์ #e0b429 ตามลำดับสีในโลโก้ที่
// ตัว U เป็นทอง แล้ว WIN เป็นเงิน ก่อนกลับมาเป็น 33 สีทอง เนื้อความ #ece6d8
// (BRAND_TEXT) — แดง #de161d/#ff4d52/#7a0a0e และเงิน #e2e8ef บนพื้น #16090a ของ
// MAHAGAME66 รอบก่อนถูกแทนครบทุกจุดแล้ว
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#e0b429]/45 bg-[#161106]/94 p-8 text-left text-base leading-relaxed text-[#ece6d8] shadow-[0_10px_30px_rgba(8,6,2,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#fbd564]/70 hover:shadow-[0_15px_40px_rgba(224,180,41,0.34)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#e0b429]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#e0b429]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#fbd564]/38"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#dfe4ec]/12 blur-[60px] transition-all duration-500 group-hover:bg-[#dfe4ec]/20"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#dfe4ec] via-[#fbd564] to-[#e0b429] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#dfe4ec] via-[#fbd564] to-[#e0b429] shadow-[0_0_10px_rgba(224,180,41,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
