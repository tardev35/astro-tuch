---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// KINGKONG555 (รอบเขียวป่า-ทองมงกุฎ 2026-10-09): ฐานเว็บสล็อตหลัก
// พาเลตต์ตาม brand-spec §2 รอบนี้พลิกจากคู่ "ม่วงนีออน-ทองอาร์เขต" ของ WEPLAY168
// มาเป็นคู่ "เขียว-ทอง" — การ์ดยังเป็นกระจกมืดเหมือนเดิมแต่ย้ายจากผิวม่วงเข้ม
// #1e0a3c มาเป็นผิวเขียวป่า #14380a ซึ่ง "สว่างกว่า" พื้นเพจของดรอปนี้ที่เป็น
// {"mode":"color","color":"#0a2400"} = เขียวป่าเกือบดำ การ์ดจึงยกลอยขึ้นจากพื้น
// เหมือนใบไม้ที่ต้องแสง ซึ่งเข้ากับงานศิลป์ที่เป็นป่าดิบ วิหารหิน และน้ำตก
//
// เขียวมะนาว #8ce023 (ฮิวของตัวอักษร KINGKONG บนโลโก้และใบไม้ในแบนเนอร์) ถือขอบ
// การ์ด เส้นคาดบนสุด และออรามุมซ้ายบน · ทองมงกุฎ #f2c230 (มงกุฎของกอริลลาและ
// เหรียญทองในแบนเนอร์) เป็นฮิวที่สองจริง อยู่ที่ปลายไล่เฉดหัวข้อ เส้นใต้ และเงา
// ตอน hover · ทองอ่อน #ffe066 เป็นช่วงกลางของไล่เฉด · เขียวซีด #bde397 เป็นปลาย
// สว่างสุดของหัวข้อ · ทองเข้ม #a87a08 กับเขียวลึก #1a5c04 เป็นปลายเข้มของเส้นใต้
// และออรา — ทั้งคู่ไม่เคยถือตัวอักษร
// เนื้อความเป็นขาวอมเขียวอ่อน #e9f7d6 (= BRAND_TEXT) — 11.2:1 บนผิวการ์ดนี้
//
// ชุดม่วง-ทองของ WEPLAY168 (#a435f0 #5b1a75 #fbe455 #ffd23d #efe6ff #c98a05
// #1e0a3c #ece2ff rgba(164,53,240,α) rgba(251,228,85,α)) ชุดแดง-ทองของ PIGPG
// (#d4200d #a30303 #f5b61d #3a0d07) และชุดฟ้า-เหลืองของ แตกดี168 (#0193fb
// #fce604 #dbeafe) ออกครบทุกจุดแล้ว — ทองของรอบนี้เป็นคนละค่า อย่าปล่อยของเก่าไว้
// เพราะ "ดูคล้ายกัน" และระวังเป็นพิเศษรอบนี้: ฮิวของแบรนด์เองเป็นสีเขียว เจอเขียว
// ที่ไหนต้องแยกให้ออกว่าเป็นเขียว semantic (สถานะ live/สำเร็จ — เก็บไว้) หรือเขียว
// ของแบรนด์ (ใช้ค่าในตารางข้างบน)
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#8ce023]/40 bg-[#14380a]/95 p-8 text-left text-base leading-relaxed text-[#e9f7d6] shadow-[0_10px_30px_rgba(0,0,0,0.6)] backdrop-blur-xl transition-all duration-500 hover:border-[#8ce023]/80 hover:shadow-[0_15px_40px_rgba(242,194,48,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#f2c230]/75 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#8ce023]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#8ce023]/35"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#a87a08]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#f2c230]/28"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#bde397] via-[#8ce023] to-[#f2c230] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#f2c230] via-[#a87a08] to-[#1a5c04] shadow-[0_0_10px_rgba(242,194,48,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
