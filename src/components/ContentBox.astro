---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro, /promotion,
// /about-us, /contact-us, /ทางเข้า, /ทดลองเล่น, /login และ /register render ตัว
// เนื้อหาผ่านไฟล์นี้ (10 หน้า) และไม่เคยเดินตาม ContentBox rotation ของ index
// → ไฟล์นี้ต้องถือพาเลตของ "แบรนด์ปัจจุบัน" เสมอ ต่อให้ index เลือก variant อื่น
// ⚠️ รอบนี้ **หน้าแรกก็ใช้ไฟล์นี้ด้วย** (docx §6 — หัวข้อสมัครสมาชิก) ซึ่งเป็น
// ส่วนหนึ่งของการหมุน shape-mix ออกจากชุด Premium/CyberCut ของรอบก่อน
// ⚠️ หน้าถาวรพวกนั้น **ไม่ประกาศสีตัวอักษรเองเลยสักจุด** ย่อหน้าทั้งหมด inherit สีมา
// จากการ์ดข้างล่าง ถ้าการ์ดไม่ตั้ง text color หน้าเหล่านั้นจะตกไปใช้ default ของ
// เบราว์เซอร์ → คลาส `text-left text-base leading-relaxed text-[#401107]` บน
// element ที่ถือ <slot /> ห้ามหายไปสักตัว
//
// Flattened single-slot variant (ทำเมื่อ 2026-07-26): `isolate` บนการ์ด + `-z-10`
// บนชั้นตกแต่ง absolute ทุกชั้น slot จึง render เป็นลูกตรงของการ์ด
// **ห้ามเพิ่ม wrapper <div> รอบ slot กลับมา** และถ้าจะเปลี่ยนสีตัวอักษรของการ์ด
// ให้ **แทนที่** คลาสสีเดิม ไม่ใช่ใส่คลาสสีที่สองข้างๆ (specificity เท่ากัน ผลจะ
// ขึ้นอยู่กับลำดับที่ Tailwind บังเอิญ emit)
//
// House style เนื้อความ: element ที่ถือ slot ได้ `text-left text-base
// leading-relaxed <สี>` — ห้ามย่อหรือขยายขนาดตัวอักษรของเนื้อความ (คลาส sm/lg
// ของ text-* ใช้กับย่อหน้าไม่ได้) · หัวข้อจัดกลางได้ แต่ต้อง
// ใส่ text-center ที่ตัวหัวข้อเอง **ห้ามใส่บนการ์ดหรือ <section>** เพราะมันจะ
// inherit ลงไปใน slot แล้วทำให้ย่อหน้าของทุกหน้าที่เรียกไฟล์นี้กลางตามไปด้วย
//
// หัวข้อมาจาก prop `title` + `as` เท่านั้น (เป็นหัวข้อจริงของบทความ/หน้านั้นๆ)
// **ห้าม hardcode ข้อความไทยเป็น heading ในไฟล์นี้** — เป็นโครมที่ขึ้นทุกหน้า
//
// ───────────────────────────────────────────────────────────────────────────
// รอบ 2026-10-22 (โปรดี168) พาเลตตาม .claude/brand-spec-prodeee168.md §2
// ⚠️⚠️ **นี่คือแบรนด์ "ธีมสว่าง" รอบที่สี่ของรีโปนี้ — การ์ดยังเป็นผิวสว่างหมึกเข้ม**
// เหตุผล: bg.json ของดรอปนี้เป็น {"mode":"color","color":"#ffd1d1"} = **ชมพูพาสเทล
// สว่าง** ไม่ใช่ดำสนิท และ bg.json คือแหล่งเดียวของพื้นเพจ
// **ห้าม "แก้" การ์ดกลับไปเป็นพื้นเข้มเพราะ "รอบก่อนๆ เป็นแบบนั้น"** — การ์ดเข้ม
// บนพื้นชมพูพาสเทลสว่างจะทำให้หน้า terms/privacy/404 ที่พึ่ง BRAND_TEXT
// (= หมึกน้ำตาลแดง #401107) กลายเป็นหมึกเข้มบนพื้นเข้มทันที
//
// อ่านจากอาร์ตเวิร์กจริง: โลโก้เป็น **กระต่ายการ์ตูนขนขาวผูกผ้าพันคอแดงยกนิ้วโป้ง**
// ข้างคำว่า **"โปรดี168" ตัวอักษรไทยสามมิติผิวมันวาวสีแดงเชอร์รี่ ขอบขาว** ส่วน
// แบนเนอร์/สไลด์เป็นฉาก **ฟาร์มกลางแจ้งแดดจัด กังหันลมไม้ ยุ้งแดง รั้วไม้
// เด็กชาย-เด็กหญิงชุดขาว-แดง กระต่ายขาว หมูชมพู และเหรียญทอง**
//
// บทบาทสีในไฟล์นี้:
//   ผิวการ์ด (ยก) #ffffff · ชั้นกลาง/อินเซ็ต #fff4ea · พื้นเพจ #ffd1d1
//   แดงเชอร์รี่ #eb0305 = ขอบการ์ด เส้นคาดบนสุด ออรา และต้นของเส้นใต้หัวข้อ
//     (4.6:1 บนผิวการ์ดขาว → ใช้กับเส้น ออรา หัวข้อ และตัวหนาได้)
//   แดงเข้ม #9b0a0c = ปลายเข้มของเส้นใต้ และสีไฮไลต์ <strong> (8.6:1)
//   หมึกน้ำตาลแดง #401107 = เนื้อความ (= BRAND_TEXT) 16.1:1 บนผิวการ์ดนี้
//   ทองแดงไหม้ #b44c06 = สีที่สอง ใช้เป็นเส้น/ขอบรอง และ **ถือตัวอักษรได้จริง
//     (5.3:1)** ซึ่งต่างจากทองโบราณของรอบก่อนที่ถือไม่ได้
//
// ⚠️⚠️ **#ffd1d1 และ #fff4ea ห้ามถือตัวอักษรบนพื้นขาวเด็ดขาด** เป็นสีพื้น/เส้น
// เท่านั้น และ **#ff4446 ห้ามถือตัวอักษรและห้ามเป็นพื้นของตัวอักษร** (3.1:1)
// เป็น stop ของไล่เฉด/ออราได้อย่างเดียว — สีไฮไลต์ <strong> ในเนื้อความมีตัวเดียว
// คือ **แดงเข้ม #9b0a0c** ถ้าต้องการตัวอักษรที่อ่านว่า "แดงสด" ให้ **ถม
// #eb0305 เป็นพื้นแล้ววาง #ffffff ทับ** (4.6:1 ผ่าน AA)
// ⚠️⚠️ **ทองสาลี่ #f0b46a ห้ามใช้ในไฟล์นี้เลยสักจุด** — บนผิวการ์ดขาวได้แค่ 1.8:1
// ตกเกณฑ์ ทองสาลี่เป็นสีของโครมเท่านั้น (ทองแดงไหม้ #b44c06 กับ #7a2f03 ใช้ได้)
// rgba() ที่อนุญาตรอบนี้: rgba(235,3,5,α) · rgba(155,10,12,α) · rgba(64,17,7,α) ·
// rgba(180,76,6,α)
//
// ⚠️ ไฟล์นี้เป็นของแบรนด์ก่อนหน้าทุกรอบ ห้ามเหมาว่าสีที่เจอเป็นของรอบนี้ ต้องเทียบ
// เป็น **"ค่า"** ไม่ใช่ "ตระกูลสี" — **แดงนำมาแล้วหลายแบรนด์ในรีโปนี้มากกว่าฮิวอื่นใด
// และรอบก่อนก็เป็นแดง+ทอง+ธีมสว่างชมพูเหมือนกัน** การเจอแดงในไฟล์จึงไม่พิสูจน์ว่า
// เป็นของรอบปัจจุบัน ค่าที่ใกล้ที่สุดคือ dc0203 (หวย365 ห่าง 18) — ใกล้กว่าปกติ
// แต่รับไว้โดยตั้งใจเพราะ #eb0305 คือค่า vivid ที่วัดได้จาก logo.webp เอง
// รอบก่อนหน้าทันที (รวยแท้168 แดงคริมสัน + ทองโบราณ บนธีมสว่าง) ที่กวาดออกครบแล้ว
// จากไฟล์นี้:
//   c30303 8f0505 e81313 dcb95f b8862b 96681f 4a0f0f 461212 280b0b ffeee8
//   fff1ef ffdbdb และ rgba 195/3/3 α) rgba 143/5/5 α) rgba 74/15/15 α)
// แบรนด์เก่ากว่านั้นทั้งหมด (สาธุ168 หวยคิง หวย365 ดวงเศรษฐี168 ufalion168
// รวยเทพ168 มีเฮ168 รวยแทร่168 นินจา168 สบายเบท168 ถอนชัวร์168 มีโชค168 ขวัญใจ168
// รับตัง168 สมหวัง168 มีทรัพย์168 UFA324 ฯลฯ) อยู่ในตารางของ brand-spec §2 —
// ให้ grep ทีละค่าจากตารางนั้น ห้ามกะด้วยตา
// ⚠️ รอบนี้ **ไม่มีเขียว (ยกเว้น LINE green ที่อื่น) ไม่มีชมพูบานเย็น ไม่มีฟ้า/
// น้ำเงิน/ไซยาน ไม่มีม่วง ไม่มีเงิน/โครเมียม และไม่มีโรสโกลด์**
// (เฮกซ์ของแบรนด์เก่าในคอมเมนต์ด้านบนเขียนแบบ **ไม่มี #** โดยตั้งใจ เพื่อไม่ให้
// การ sweep ไล่หาสีของแบรนด์เก่าใน src/ สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#eb0305]/35 bg-white/95 p-8 text-left text-base leading-relaxed text-[#401107] shadow-[0_10px_30px_rgba(64,17,7,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#eb0305]/70 hover:shadow-[0_15px_40px_rgba(235,3,5,0.25)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#eb0305]/70 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#eb0305]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#eb0305]/40"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#fff4ea]/90 blur-[60px] transition-all duration-500 group-hover:bg-[#b44c06]/25"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="text-2xl leading-normal font-black tracking-widest text-[#eb0305] uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#eb0305] to-[#9b0a0c] shadow-[0_0_10px_rgba(235,3,5,0.45)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
