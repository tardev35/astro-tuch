---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// NAZA99 (รอบทอง-ดำ 2026-10-02): เว็บสล็อตออนไลน์ พาเลตต์มาจากโลโก้ที่เป็นตัวอักษร
// ทองเมทัลลิกล้วนบนพื้นโปร่ง (vivid #e4b34d สัดส่วน 5.5% รองลงมา #fef1a5 #fdf2ac
// #ebbb54) และแบนเนอร์ที่เป็นฉากทองอร่ามบนพื้นดำอมน้ำตาล (dominant #140c02
// #241404 #0a0501) แบรนด์นี้จึงเป็น "สีเดียว" ไม่มีฮิวที่สองมาตัดกัน ความต่าง
// ทั้งหมดสร้างจากระดับความสว่างของทอง — การ์ดดำอมทอง #140c02 ในกรอบทองแบรนด์
// #e4b34d ออรามุมซ้ายบนเป็นทองแบรนด์ มุมขวาล่างเป็นทองอ่อน #fdf2ac หัวข้อไล่เฉด
// ทองอ่อน #fdf2ac → ทอง #e4b34d → ทองลึก #8a5f12 เนื้อความ #f3e8cf (BRAND_TEXT)
//
// รอบก่อน (หวย365) เป็นแดงสด-ทอง ชุดเดิมทั้งชุด (#dc0203 #240406 #ffc93c #ffeab0
// #f5282a #f6e7e0) ออกครบทุกจุดแล้ว รอบนี้ไม่มีแดงเหลืออยู่เลยเพราะอาร์ตเวิร์ก
// NAZA99 ไม่มีแดงเป็นสีแบรนด์ (มีแค่พลอยแดงบนมงกุฎในแบนเนอร์ซึ่งเป็นรายละเอียด)
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#e4b34d]/50 bg-[#140c02]/94 p-8 text-left text-base leading-relaxed text-[#f3e8cf] shadow-[0_10px_30px_rgba(5,3,1,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#fdf2ac]/70 hover:shadow-[0_15px_40px_rgba(228,179,77,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#e4b34d]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#e4b34d]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#fdf2ac]/38"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#fdf2ac]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#fef1a5]/32"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#fdf2ac] via-[#e4b34d] to-[#8a5f12] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#fdf2ac] via-[#e4b34d] to-[#8a5f12] shadow-[0_0_10px_rgba(228,179,77,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
