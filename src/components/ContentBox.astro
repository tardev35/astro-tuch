---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// หวย365 (รอบแดงสด-ทอง 2026-10-03): เว็บแทงหวยออนไลน์ พาเลตต์มาจาก logo.webp ที่เป็น
// คำว่า หวย สีแดงสดคู่กับเลข 365 สลับดำ-แดง (vivid #dc0203 #e00104 #e2020a เป็นแดง
// ล้วนทั้งชุด ส่วน dominant รองลงมาเป็นดำ #020202) บนแบนเนอร์ที่เป็นผ้าซาตินแดงกับ
// เหรียญทองและตัวอักษรทอง แบรนด์นี้จึงเป็น "แดงนำ ทองรอง บนดำ" — แดงแบรนด์ #dc0203
// ถือออรามุมขวาล่างและปลายเกรเดียนต์หัวข้อ ทอง #ffc93c ถือกรอบและออรามุมซ้ายบน
// การ์ดเป็นดำอมแดง #240406 หัวข้อไล่เฉดทองอ่อน #ffeab0 → ทอง #ffc93c → แดงสว่าง
// #f5282a เนื้อความ #f6e7e0 (BRAND_TEXT)
//
// รอบก่อน (NATO168) เป็นเว็บสล็อตโทนทอง-เงิน-ดำ ชุดเดิมทั้งชุด (#edb543 #fde8a8
// #a9761f #e6e6e6 #101010 #f4ead3) ออกครบทุกจุดแล้ว ทองลึกเปลี่ยนจาก #a9761f เป็น
// #c08a07 ซึ่งเป็นค่าที่หมึก #1a0303 ยังอ่านได้ (6.4:1) ถ้าจะเอาไปเป็นพื้นปุ่ม
// และเงินถูกถอดออกทั้งหมดเพราะโลโก้รอบนี้ไม่มีฮิวเงินเลย
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#c08a07]/50 bg-[#240406]/95 p-8 text-left text-base leading-relaxed text-[#f6e7e0] shadow-[0_10px_30px_rgba(8,1,1,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffc93c]/70 hover:shadow-[0_15px_40px_rgba(255,201,60,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#ffc93c]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#ffc93c]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#ffeab0]/38"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#dc0203]/24 blur-[60px] transition-all duration-500 group-hover:bg-[#f5282a]/34"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#ffeab0] via-[#ffc93c] to-[#f5282a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#ffeab0] via-[#ffc93c] to-[#f5282a] shadow-[0_0_10px_rgba(255,201,60,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
