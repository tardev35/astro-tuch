---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// ABM96 (รอบชมพู-เหลือง 2026-09-22): การ์ดชมพูอมดำ #1d0611 ในกรอบชมพูเข้ม
// #b8325f ออร่าสองมุมเป็นชมพูหลัก #fd6494 กับเหลืองโลโก้ #feda2a หัวข้อไล่จาก
// ชมพูอ่อน #ffc9dc → ชมพูหลัก #fd6494 → เหลือง #feda2a ซึ่งเป็นคู่สีเดียวกับ
// โลโก้ที่ตัว ABM เป็นชมพูและเลข 96 เป็นเหลือง ส่วนเนื้อความใช้ #fbe3ee
// (BRAND_TEXT) ขาวอมชมพู — โทนทองบรอนซ์กับเขียวมรกตของรอบก่อนหายไปทั้งหมด
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#b8325f]/55 bg-[#1d0611]/94 p-8 text-left text-base leading-relaxed text-[#fbe3ee] shadow-[0_10px_30px_rgba(18,3,10,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#fd6494]/70 hover:shadow-[0_15px_40px_rgba(253,100,148,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#fd6494]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#fd6494]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#fd6494]/34"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#feda2a]/24 blur-[60px] transition-all duration-500 group-hover:bg-[#feda2a]/38"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#ffc9dc] via-[#fd6494] to-[#feda2a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#ffc9dc] via-[#fd6494] to-[#feda2a] shadow-[0_0_10px_rgba(253,100,148,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
