---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// LOTTOPLUS (รอบแดง-ทอง-ดำ 2026-09-29): เว็บหวยออนไลน์ พาเลตต์มาจากโลโก้ที่เป็น
// ตัวอักษรขาวบนบล็อกแดง #dc020e กับแบนเนอร์พื้นดำที่มีริ้วแสงแดง ลูกหวยแดง-ขาว
// และเหรียญทอง — การ์ดดำอมแดง #120b0c ในกรอบแดงแบรนด์ #dc020e ออร่ามุมซ้ายบน
// เป็นแดงแบรนด์ มุมขวาล่างเป็นทองรอง #f3c623 หัวข้อไล่เฉดทองอ่อน #fde79a →
// ทองรอง #f3c623 → แดงแบรนด์ #dc020e เนื้อความ #f0e2e2 (BRAND_TEXT) — ชุดทอง-ดำ
// ของ WIN999 รอบก่อน (#fcc403 #fdda04 #8a6502 #fff0a8 #100d05 #e9e4d6) ออกครบแล้ว
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#dc020e]/45 bg-[#120b0c]/94 p-8 text-left text-base leading-relaxed text-[#f0e2e2] shadow-[0_10px_30px_rgba(5,1,2,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#ff2d38]/70 hover:shadow-[0_15px_40px_rgba(220,2,14,0.34)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#dc020e]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#dc020e]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#ff2d38]/38"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#f3c623]/16 blur-[60px] transition-all duration-500 group-hover:bg-[#f3c623]/28"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#fde79a] via-[#f3c623] to-[#dc020e] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#fde79a] via-[#f3c623] to-[#dc020e] shadow-[0_0_10px_rgba(243,198,35,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
