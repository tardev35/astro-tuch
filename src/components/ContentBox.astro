---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// KMD88 (รอบม่วงราชา-ทอง 2026-10-13): พาเลตต์ตาม brand-spec §2
// รอบนี้ออกจากสาย "ทองล้วนบนดำ" ของรอบก่อน (TND168) มาเป็น **สองฮิวจริง:
// ม่วงนำ ทองรอง** เพราะโลโก้อ่านตรงๆ ได้ว่าคำว่า KMD เป็นตัวอักษรสามมิติ
// สีม่วงขัดเงาขอบทอง ต่อด้วยเลข 88 สีทองเมทัลลิก ในวงแหวนทอง ส่วนแบนเนอร์และ
// สไลด์เป็นฉากคาสิโนดำที่ส่องด้วยริบบิ้นแสงม่วงและตัวอักษรไทยทองสามมิติ
// ⚠️ พื้นเพจรอบนี้เป็น **ดำสนิท** (bg.json = {"mode":"color","color":"#000000"})
// จึงไม่มีชั้นที่ "ลึกกว่าพื้นเพจ" ได้จริง — แผ่นที่จมสุดคือ #0a0213
// ลำดับความลึก: #1d0832 ผิวยก (การ์ดใบนี้) / #140522 กลาง / #0a0213 จม / #000000 พื้น
//
// ม่วงแบรนด์ #7505cc (vivid ที่วัดได้จาก logo.webp ตรงๆ — ตัวอักษร KMD) ถือขอบ
// การ์ด เส้นคาดบนสุด และออรามุมซ้ายบน · ทองแบรนด์ #e2b33f (เลข 88 และตัวอักษร
// ไทยบนแบนเนอร์) เป็นฮิวที่สองจริง อยู่กลางไล่เฉดหัวข้อและเป็นสี hover ของขอบ ·
// ทองสว่าง #ffdf8c เป็นต้นสว่างสุดของหัวข้อ · ม่วงที่ถือตัวอักษรได้คือ #c07cff
// (5.3:1) และ #d9b8ff (8.6:1) · ม่วงลึก #3a0565 #2c0349 และทองลึก #7a5a0a เป็น
// ปลายเข้มของเส้นใต้และออรามุมขวาล่าง — ทั้งสามไม่เคยถือตัวอักษร
// ลำดับ ทองสว่าง→ทองแบรนด์→ม่วงแบรนด์ ของหัวข้อคือลำดับที่ตาอ่านโลโก้จริงจากขวา
// ไปซ้าย (เลข 88 ทองวาวก่อน แล้วขอบทองของตัวอักษร แล้วจบที่เนื้อม่วงของ KMD)
// เนื้อความเป็นงาช้างอมม่วง #ece2f8 (= BRAND_TEXT) — 12.6:1 บนผิวการ์ดนี้
//
// ⚠️ ไฟล์นี้เป็นของแบรนด์ก่อนหน้าทุกรอบ ห้ามเหมาว่าสีที่เจอเป็นของรอบนี้ ต้องเทียบ
// เป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **รอบนี้กับดักคือทั้งสองฮิว**: ทองมาแล้วเก้าใน
// สิบสองรอบหลังสุด และม่วงก็เพิ่งมาสองรอบ "มีทองหรือมีม่วงอยู่" จึงไม่ได้พิสูจน์
// อะไรเลย ชุดทองมังกรของ TND168 (#dfa310 #ffc93d #ffe4a3 #c9b88e #f0e9dc #8a5c09
// #43240b #140d02 #1b1307 #120c04 #070502) ชุดม่วงนีออน-ทองของ WEPLAY168
// (#a435f0 #d2a6ff #c9b2e8 #5b1a75 #1e0a3c #0a0117 #fbe455) ชุดม่วง-ชมพูของ
// BPLAY639 (#7e22ce #c4b5fd #ddd6fe #f472b6 #14061f) ชุดชมพูฮอตพิงก์-ทองของ
// PUNPRO168 (#f41571 #ff5ca8 #fce343 #ffd94a #f0c3dc #fde7f2 #8a0a45 #4a0426
// #2a0012 #4a1038 #3a0a2a #2e0022 #1c0014) ชุดทองเมทัลลิก-บรอนซ์ของ 789BETTING
// (#fad354 #ffe79a #ddab33 #8a6410 #c9881f #f3e7cd #b5a888 #060402 #0a0802
// #2a2008 #17130a) ชุดทองอำพันเสือของ TIGERWIN369 (#d98324 #f7b733 #ffd98a
// #f7e4c0 #e3cfae #8a5214 #4a2a08 #1a0d02 #2d1c0a #1c1206 #0f0903) ชุดทอง
// แชมเปี้ยน-เงินโครเมียมของ UFA324 (#e5a81b #b9c2cc #231c0e #17130a #0d0b06
// #f0e8d4 #ffcf5e #ffe08a #7d5a07 #43300a #464f5a) ชุดชมพู-ทองของ FAH999
// (#ff3fa4 #ff6cbb #ffd1ea #fde8f3 #f5c53d #9c6f08 #b3006a #4a0b42 #3a0534
// #2e002c #210220) ชุดทองเป็ด-ส้มปากเป็ดของ DUCK1688 (#f3bb34 #fde464 #c8901a
// #8a5f08 #5c3f04 #f58b2a #ffc98a #a3510c #1a1203 #f6ecd9 #d8c69b #1f1709
// #171106 #0d0903) ชุดทองอวกาศ-เงินโครเมียมของ NAZA168 (#fbc134 #ffe87a #cf9a18
// #96690a #6b4a05 #eef2f8 #cfd6e3 #9aa6bb #3f4859 #fdf3df #d9c9a6 #4e3406
// #432b03 #382400 #241700) ชุดทองสายฟ้า-แดงเลือดนกของ FLASH877 (#f5c518 #ffdd73
// #b8860f #ff3b14 #8c0f0a) ชุดแดงเสือโคร่ง-ทองถ่านไฟของ SUPERSLOTCLUB (#e8232a
// #f2b705 #ffd666 #c08a0b) ชุดเขียว-ทองของ KINGKONG555 (#8ce023 #f2c230 #ffe066
// #a87a08 #06220a) และชุดแดงแล็กเกอร์ของ PIGPG (#d4200d #f5b61d #ffd87a)
// ออกครบทุกจุดแล้ว
// ⚠️ ม่วงของรอบนี้ (#7505cc) เข้มและอิ่มกว่าม่วงทุกตัวในลิสต์ที่ใกล้ที่สุด —
// R=117 G=5 B=204 เทียบกับ #a435f0 ของ WEPLAY168 (R=164 G=53 B=240) และ #7e22ce
// ของ BPLAY639 (R=126 G=34 B=206) ส่วนทอง #e2b33f (R=226 G=179 B=63) เทียบกับ
// #e5a81b ของ UFA324 และ #dfa310 ของ TND168 ให้เทียบเป็นตัวเลข ไม่ใช่ด้วยตา
// ⚠️ **รอบนี้ไม่มีชมพู ไม่มีเงิน/เทา ไม่มีเขียว ไม่มีน้ำเงิน ไม่มีส้มอิฐ/ส้มอำพัน
// และไม่มีแดงเลย** มีแค่ม่วงกับทอง
//
// ⚠️ #7505cc #b453ff #3a0565 #2c0349 #7a5a0a ห้ามถือตัวอักษรทุกขนาด อยู่ได้เฉพาะ
// ในไล่เฉดของเส้นคาด ในออรา และเป็นขอบ ส่วน #ffdf8c (12.0:1) #e2b33f (8.1:1)
// #d9b8ff (8.6:1) และ #c07cff (5.3:1) ถือตัวอักษรรองได้จริง และ #ffd45e (11.1:1)
// คือตัวที่สงวนไว้ใช้ไฮไลต์ <strong> ในเนื้อความเท่านั้น
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#7505cc]/45 bg-[#1d0832]/95 p-8 text-left text-base leading-relaxed text-[#ece2f8] shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#e2b33f]/70 hover:shadow-[0_15px_40px_rgba(117,5,204,0.35)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#7505cc]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#7505cc]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#b453ff]/35"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#2c0349]/80 blur-[60px] transition-all duration-500 group-hover:bg-[#e2b33f]/25"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#ffdf8c] via-[#e2b33f] to-[#b453ff] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#7505cc] via-[#3a0565] to-[#7a5a0a] shadow-[0_0_10px_rgba(117,5,204,0.65)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
