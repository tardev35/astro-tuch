---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#ecc964]/32 bg-[#0d0904]/92 p-8 text-left text-base leading-relaxed text-[#f3e6c8] shadow-[0_10px_30px_rgba(3,2,1,0.72)] backdrop-blur-xl transition-all duration-500 hover:border-[#f9e38b]/60 hover:shadow-[0_15px_40px_rgba(236,201,100,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#ecc964]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#ecc964]/32"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#ba8219]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#f9e38b]/32"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#ecc964]/32 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f9e38b] to-[#ba8219] shadow-[0_0_10px_rgba(236,201,100,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fff8e2] via-[#f9e38b] to-[#d2a43b] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
