---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// THE88 (รอบแดง-ทอง 2026-09-23): การ์ดแดงเกือบดำ #2d0908 ในกรอบแดงเข้ม #6b0302
// ออร่าสองมุมเป็นแดงแบรนด์ #a40201 กับทอง #f2c14e หัวข้อไล่จากทองอ่อน #ffe7a6 →
// ทอง #f2c14e → แดงสด #dd0503 ตรงกับโลโก้ที่ตัว THE เป็นแดงขอบทองและเลข 88 เป็น
// ครีมขอบทอง เนื้อความใช้ #f7e3dd (BRAND_TEXT) ขาวอมแดง — ชมพูมาเจนตา #ec2b84
// กับพลัม #24081a ของ WY88 รอบก่อนหายไปทั้งหมด
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#6b0302]/70 bg-[#2d0908]/94 p-8 text-left text-base leading-relaxed text-[#f7e3dd] shadow-[0_10px_30px_rgba(28,5,4,0.78)] backdrop-blur-xl transition-all duration-500 hover:border-[#f2c14e]/60 hover:shadow-[0_15px_40px_rgba(164,2,1,0.38)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#f2c14e]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#a40201]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#dd0503]/38"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#f2c14e]/24 blur-[60px] transition-all duration-500 group-hover:bg-[#f2c14e]/38"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#ffe7a6] via-[#f2c14e] to-[#dd0503] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#ffe7a6] via-[#f2c14e] to-[#a40201] shadow-[0_0_10px_rgba(242,193,78,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
