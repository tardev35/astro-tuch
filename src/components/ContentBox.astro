---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro, /promotion,
// /about-us, /contact-us, /ทางเข้า, /ทดลองเล่น, /login และ /register render ตัว
// เนื้อหาผ่านไฟล์นี้ (10 หน้า) และไม่เคยเดินตาม ContentBox rotation ของ index
// → ไฟล์นี้ต้องถือพาเลตของ "แบรนด์ปัจจุบัน" เสมอ ต่อให้ index เลือก variant อื่น
// ⚠️ รอบนี้ **หน้าแรกไม่ได้ใช้ไฟล์นี้** (docx §6 ไปอยู่ที่ ContentBoxCyberCut ตาม
// การหมุน variant) แต่ไฟล์นี้ยังเป็น shared chrome เต็มตัวเพราะสิบหน้าข้างบนยังใช้
// ⚠️ หน้าถาวรพวกนั้น **ไม่ประกาศสีตัวอักษรเองเลยสักจุด** ย่อหน้าทั้งหมด inherit สีมา
// จากการ์ดข้างล่าง ถ้าการ์ดไม่ตั้ง text color หน้าเหล่านั้นจะตกไปใช้ default ของ
// เบราว์เซอร์ → คลาส `text-left text-base leading-relaxed text-[#16294a]` บน
// element ที่ถือ <slot /> ห้ามหายไปสักตัว
//
// Flattened single-slot variant (ทำเมื่อ 2026-07-26): `isolate` บนการ์ด + `-z-10`
// บนชั้นตกแต่ง absolute ทุกชั้น slot จึง render เป็นลูกตรงของการ์ด
// **ห้ามเพิ่ม wrapper <div> รอบ slot กลับมา** และถ้าจะเปลี่ยนสีตัวอักษรของการ์ด
// ให้ **แทนที่** คลาสสีเดิม ไม่ใช่ใส่คลาสสีที่สองข้างๆ (specificity เท่ากัน ผลจะ
// ขึ้นอยู่กับลำดับที่ Tailwind บังเอิญ emit)
//
// House style เนื้อความ: element ที่ถือ slot ได้ `text-left text-base
// leading-relaxed <สี>` — ห้ามย่อหรือขยายขนาดตัวอักษรของเนื้อความ (คลาส sm/lg
// ของ text-* ใช้กับย่อหน้าไม่ได้) · หัวข้อจัดกลางได้ แต่ต้อง
// ใส่ text-center ที่ตัวหัวข้อเอง **ห้ามใส่บนการ์ดหรือ <section>** เพราะมันจะ
// inherit ลงไปใน slot แล้วทำให้ย่อหน้าของทุกหน้าที่เรียกไฟล์นี้กลางตามไปด้วย
//
// หัวข้อมาจาก prop `title` + `as` เท่านั้น (เป็นหัวข้อจริงของบทความ/หน้านั้นๆ)
// **ห้าม hardcode ข้อความไทยเป็น heading ในไฟล์นี้** — เป็นโครมที่ขึ้นทุกหน้า
//
// ───────────────────────────────────────────────────────────────────────────
// รอบ 2026-10-23 (ร่ำรวย168) พาเลตตาม .claude/brand-spec-ruaythear168club.md §2
// 🚨🚨 **รอบนี้กลับทิศจากรอบก่อน 180 องศา — การ์ดเป็นผิวขาวหมึกเข้ม ไม่ใช่
// ผิวน้ำตาลเข้มหมึกครีมแบบรอบก่อน** เหตุผล: bg.json ของดรอปนี้เป็น
// {"mode":"color","color":"#dbe6ff"} = **ฟ้าเพอริวิงเคิลอ่อน** (รอบก่อนเป็น 29210f
// = น้ำตาลโอลีฟเข้ม) และ bg.json คือแหล่งเดียวของพื้นเพจ
// **ห้าม "แก้" การ์ดกลับไปเป็นพื้นเข้มเพราะเห็นว่ารอบก่อนทำแบบนั้น** — การ์ดเข้ม
// บนพื้นสว่างจะทำให้หน้า terms/privacy/404 ที่พึ่ง BRAND_TEXT (= หมึกเข้ม #16294a)
// กลายเป็นหมึกเข้มบนพื้นเข้มทันที
//
// อ่านจากอาร์ตเวิร์กจริง: โลโก้เป็น **ตะกร้าสานทองคำใส่เหรียญทองล้นตะกร้า ต่อด้วย
// คำว่า "ร่ำรวย" ตัวอักษรไทยสามมิติผิวฟ้าไซยานมันวาว และเลข "168" ผิวโครเมียมเงิน**
// ส่วนแบนเนอร์/สไลด์เป็นฉาก **ห้องนั่งเล่นหรูโทนครีม-งาช้าง แสงนุ่ม และผู้หญิง
// สูงวัยผมขาวเงินสวมแว่นกันแดดในชุดซาตินสีงาช้าง ยกแก้วแชมเปญ**
// ⚠️ **ทองในอาร์ตเวิร์กเป็นวัตถุในภาพ ไม่ใช่สี UI** — รอบนี้ไม่มีทองเลยสักเฉด
//
// บทบาทสีในไฟล์นี้:
//   ผิวการ์ด (ยก) #ffffff · ชั้นกลาง #eef4ff · อินเซ็ต #dce9fb · พื้นเพจ #dbe6ff
//   ผิวครีม #f4e4d3 = **วัสดุที่สองของรอบนี้** (จากชุดซาตินสีงาช้างใน slide1.png)
//     ใช้เป็นปลายของเส้นใต้หัวข้อและออรารอง
//   ฟ้าไซยาน #18a5e2 = ขอบ hover เส้นคาดบนสุด ออรา และต้นของเส้นใต้หัวข้อ
//     ⚠️⚠️ **2.6:1 บนผิวการ์ดขาว — ห้ามถือตัวอักษรในไฟล์นี้เด็ดขาด** เป็นเส้น/ออรา
//   ฟ้าเข้ม #0d6b9b = **สีหัวข้อ** (5.6:1 บนผิวการ์ดขาว ผ่าน AA)
//     และเป็นสีไฮไลต์ <strong> ในเนื้อความ — หน้าไหนจะใช้ก็ได้
//   ฟ้าอ่อน #a9d7f2 = ขอบปกติ (**ห้ามถือตัวอักษร**)
//   หมึก #16294a = สีเนื้อความ (= BRAND_TEXT) 13.9:1 บนผิวการ์ดนี้
// ⚠️⚠️ **#ffffff #eef4ff #dce9fb #dbe6ff #f4e4d3 #e4cbb3 #a9d7f2 ห้ามถือตัวอักษร**
// เป็นสีพื้น/เส้นเท่านั้น และ **#18a5e2 ห้ามถือตัวอักษรบนผิวสว่าง** (2.6:1)
// rgba() ที่อนุญาตรอบนี้: rgba(24,165,226,α) · rgba(13,107,155,α) ·
// rgba(244,228,211,α) · rgba(22,41,74,α) · rgba(0,0,0,α)
//
// ⚠️ ไฟล์นี้เป็นของแบรนด์ก่อนหน้าทุกรอบ ห้ามเหมาว่าสีที่เจอเป็นของรอบนี้ ต้องเทียบ
// เป็น **"ค่า"** ไม่ใช่ "ตระกูลสี" — 🚨 **ฟ้าเคยผ่านรีโปนี้มาแล้วห้าเจ้า** การเจอฟ้า
// ในไฟล์จึงไม่พิสูจน์ว่าเป็นของรอบปัจจุบัน
// รอบก่อนหน้าทันที (เงินทอง168 ทองแกน + ครีมอุ่น บนน้ำตาลโอลีฟ — **ตัวที่เสี่ยง
// หลงเหลือสูงสุด**) ที่กวาดออกครบแล้วจากไฟล์นี้:
//   f5ba14 fcee52 b37c0b ecd5c4 d2b9a4 3d3016 332810 201906 29210f 2e2512 1b1407
//   4d3c15
// 🚨 ฟ้าของแบรนด์อื่นที่ต้องเทียบเป็นค่าทีละตัว (ห้ามกะด้วยตา):
//   2cc3fc 6bdcfb 9ae0fa 0a7fbd 063a57 0f3a4a f2fbff dff4fd ccf7ff cdf2ff eafaff
//   a9e3f9 04293d 0a4f74 06293c (สบาย168 — ⚠️⚠️ **6bdcfb ห่างจากค่า vivid ดิบของ
//   โลโก้รอบนี้ 6bddfb แค่ 1 หน่วย** และ a9e3f9 ห่างจาก #a9d7f2 แค่ R0/G12/B7
//   ซึ่งเป็นคู่ที่ต้อง grep เป็นค่า ไม่ใช่มองด้วยตา) ·
//   039cfa 0494f5 c3ebfc 04366b e3f2fc 0b2d52 (รวยแทร่168) ·
//   32bcfb a9e9ff 07335f 0c2a3d 071a28 030e16 (นินจา168) ·
//   2f9ff5 a8dcff d6ecff 0b3f78 e8f4ff (สบายเบท168) ·
//   0360f3 0292fb 6ec8ff 4fb4ff cfdcec 9db4d4 dde8f7 (TSDET911)
// ⚠️ ทองของแบรนด์เก่าที่ยังต้องกวาด (รอบนี้ไม่มีทองเลย):
//   eeae12 fded41 9f600d (พักยก168) · f7c92b ffe6a3 (ขวัญใจ168) · d4922c fdfc71
//   d39c45 f6e3b4 (ufalion168) · e5a81b ffe08a bb8410 7d5a07 (UFA324) ·
//   fee45d e6a416 b8780d 7a4e05 (ยูฟ้า168) · fef54b 6b5c10 (นินจา168) ·
//   fdcb0c fefb6b 8a6504 (สบาย168) · f9a826 704504 (รวยแทร่168) · ffc82e 5c4a16
//   (สบายเบท168) · ffd84d 6b4708 (ถอนชัวร์168) · e3b23c ffe5a8 8a6210 (สมหวัง168) ·
//   dcb95f b8862b 96681f (รวยแท้168) · fcd434 ffeaa0 (มีโชค168) · cd9a2c fdeb7c
//   ab7314 (หวยคิง) · f0bb4e ffeccb (รวยเทพ168) · fcd45c 6b4a08 (มีเฮ168) ·
//   ffdc8c f0b429 (รับตัง168) · f0c878 (ดวงเศรษฐี168) · f0b46a d9803a (โปรดี168) ·
//   ffc93c ffeab0 (หวย365)
// ⚠️ ครีมของแบรนด์เก่า: ecd5c4 d2b9a4 (เงินทอง168) · eadfce (ขวัญใจ168) ·
//   f5e7c8 fce2d4 (หวยคิง) — ครีมรอบนี้คือ #f4e4d3 / #e4cbb3 เท่านั้น
// ⚠️ ผิวสว่างของธีมสว่างรอบก่อนๆ: ffdbdb fff1ef ffeee8 (รวยแท้168) ·
//   fff0e4 ffd1d1 (โปรดี168) — **ห้ามสับสนกับ #ffffff/#eef4ff/#dce9fb ของรอบนี้**
// แบรนด์เก่ากว่านั้นทั้งหมดอยู่ในตารางของ brand-spec §2 — grep ทีละค่าจากตารางนั้น
// ⚠️ รอบนี้ **ไม่มีทอง ไม่มีแดง ไม่มีเขียว (ยกเว้น LINE green ที่อื่น) ไม่มีชมพู
// ไม่มีม่วง ไม่มีโรสโกลด์ ไม่มีส้ม ไม่มีน้ำตาล และไม่มีแรมป์เทาเงิน**
// (เฮกซ์ของแบรนด์เก่าในคอมเมนต์ด้านบนเขียนแบบ **ไม่มี #** โดยตั้งใจ เพื่อไม่ให้
// การ sweep ไล่หาสีของแบรนด์เก่าใน src/ สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#a9d7f2] bg-[#ffffff]/95 p-8 text-left text-base leading-relaxed text-[#16294a] shadow-[0_10px_30px_rgba(22,41,74,0.12)] backdrop-blur-xl transition-all duration-500 hover:border-[#18a5e2] hover:shadow-[0_15px_40px_rgba(24,165,226,0.25)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#18a5e2] to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#18a5e2]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#18a5e2]/40"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#f4e4d3]/60 blur-[60px] transition-all duration-500 group-hover:bg-[#f4e4d3]/90"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="text-2xl leading-normal font-black tracking-widest text-[#0d6b9b] uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#18a5e2] to-[#f4e4d3] shadow-[0_0_10px_rgba(24,165,226,0.45)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
