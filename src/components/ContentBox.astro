---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// แตกดี168 (รอบฟ้าสด-เหลืองมะนาวบนกรมท่าเกือบดำ 2026-10-08): เว็บสล็อตออนไลน์
// พาเลตต์ตาม brand-spec §2 รอบนี้พลิกจากแบรนด์ฮิวเดียวของ 789BETTING (ทอง
// เมทัลลิกล้วนบนดำสนิท) มาเป็น "คู่สีสด" — การ์ดยังเป็นกระจกมืดเหมือนเดิมแต่ย้าย
// จากผิวเกือบดำอมทอง #17130a มาเป็นผิวกรมท่าเกือบดำ #0a1726 เพราะ bg.json ของ
// ดรอปนี้ยังเป็นดำตัน #000000 การ์ดจึงต้อง "ยก" ขึ้นจากพื้นให้เห็นขอบ ส่วนงานศิลป์
// ทั้งชุด (โลโก้ แบนเนอร์ สไลด์) เป็นฉากท้องฟ้าฟ้า-ขาว เหรียญทอง และตัวอักษร
// เหลืองมะนาวทับฟ้าสด จึงมีสองฮิวจริง ไม่ใช่ฮิวเดียวแบบรอบก่อน
//
// ฟ้าแบรนด์ #0193fb มาจาก vivid อันดับหนึ่งของ logo.webp (สัดส่วน 43.8% = เลข 168)
// ถือขอบการ์ด เส้นคาดบนสุด ออรามุมซ้ายบน และเงาตอน hover · ฟ้าอ่อน #7bcffb
// (vivid ของ banner1 = ท้องฟ้า) เป็นปลายสว่างของไล่เฉดหัวข้อ · เหลืองมะนาว #fce604
// (vivid อันดับสองของ logo = คำว่า แตกดี) เป็นฮิวที่สอง อยู่ที่กลางไล่เฉดหัวข้อ
// เส้นใต้ และออรามุมขวาล่าง · เหลืองอ่อน #fff48a เป็นปลายสว่างสุด · เหลืองเข้ม
// #c9a703 กับฟ้าเข้ม #064a86 เป็นปลายเข้มของเส้นใต้และออรา ไม่เคยถือตัวอักษร
// เนื้อความเป็นฟ้าขาวนวล #dbeafe (= BRAND_TEXT) — 14.4:1 บนผิวการ์ดนี้
//
// ชุดทองเมทัลลิกของ 789BETTING (#fad354 #ffe79a #ddab33 #8a6410 #c9881f #17130a
// #f3e7cd rgba(250,211,84,α)) และชุดตรุษจีนของ GUCCI168 ก่อนหน้านั้น
// (#c41115 #0b7a33 #d9a521 #f6e3cf rgba(196,17,21,α)) ออกครบทุกจุดแล้ว
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#0193fb]/35 bg-[#0a1726]/95 p-8 text-left text-base leading-relaxed text-[#dbeafe] shadow-[0_10px_30px_rgba(0,0,0,0.6)] backdrop-blur-xl transition-all duration-500 hover:border-[#0193fb]/75 hover:shadow-[0_15px_40px_rgba(1,147,251,0.32)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#0193fb]/75 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#0193fb]/40 blur-[60px] transition-all duration-500 group-hover:bg-[#7bcffb]/35">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#c9a703]/40 blur-[60px] transition-all duration-500 group-hover:bg-[#fce604]/28">
    </div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#fff48a] via-[#fce604] to-[#7bcffb] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#fce604] via-[#0193fb] to-[#064a86] shadow-[0_0_10px_rgba(1,147,251,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
