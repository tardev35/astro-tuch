---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro, /promotion,
// /about-us, /contact-us, /ทางเข้า, /ทดลองเล่น, /login และ /register render ตัว
// เนื้อหาผ่านไฟล์นี้ (10 หน้ารอบนี้) และไม่เคยเดินตาม ContentBox rotation ของ index
// → ไฟล์นี้ต้องถือพาเลตของ "แบรนด์ปัจจุบัน" เสมอ ต่อให้ index เลือก variant อื่น
// ⚠️ รอบนี้ **หน้าแรกไม่ได้ใช้ไฟล์นี้** (docx §1 ไปอยู่ที่ ContentBoxPremium ตาม
// การหมุน variant) แต่ไฟล์นี้ยังเป็น shared chrome เต็มตัวเพราะสิบหน้าข้างบนยังใช้
// ⚠️ รอบนี้ /ตรวจหวย และ /แนวทาง ถูกย้ายไป src/pages-disabled/ แล้ว (แบรนด์สล็อต)
// จำนวนหน้าจึงลดจาก 12 เหลือ 10 — ไม่กระทบสถานะ shared chrome ของไฟล์นี้
// ⚠️ หน้าถาวรพวกนั้น **ไม่ประกาศสีตัวอักษรเองเลยสักจุด** ย่อหน้าทั้งหมด inherit สีมา
// จากการ์ดข้างล่าง ถ้าการ์ดไม่ตั้ง text color หน้าเหล่านั้นจะตกไปใช้ default ของ
// เบราว์เซอร์ → คลาส `text-left text-base leading-relaxed text-[#f0e6e4]` บน
// element ที่ถือ <slot /> ห้ามหายไปสักตัว
//
// Flattened single-slot variant (ทำเมื่อ 2026-07-26): `isolate` บนการ์ด + `-z-10`
// บนชั้นตกแต่ง absolute ทุกชั้น slot จึง render เป็นลูกตรงของการ์ด
// **ห้ามเพิ่ม wrapper <div> รอบ slot กลับมา** และถ้าจะเปลี่ยนสีตัวอักษรของการ์ด
// ให้ **แทนที่** คลาสสีเดิม ไม่ใช่ใส่คลาสสีที่สองข้างๆ (specificity เท่ากัน ผลจะ
// ขึ้นอยู่กับลำดับที่ Tailwind บังเอิญ emit)
//
// House style เนื้อความ: element ที่ถือ slot ได้ `text-left text-base
// leading-relaxed <สี>` — ห้ามย่อหรือขยายขนาดตัวอักษรของเนื้อความ (คลาส sm/lg
// ของ text-* ใช้กับย่อหน้าไม่ได้) · หัวข้อจัดกลางได้ แต่ต้อง
// ใส่ text-center ที่ตัวหัวข้อเอง **ห้ามใส่บนการ์ดหรือ <section>** เพราะมันจะ
// inherit ลงไปใน slot แล้วทำให้ย่อหน้าของทุกหน้าที่เรียกไฟล์นี้กลางตามไปด้วย
//
// หัวข้อมาจาก prop `title` + `as` เท่านั้น (เป็นหัวข้อจริงของบทความ/หน้านั้นๆ)
// **ห้าม hardcode ข้อความไทยเป็น heading ในไฟล์นี้** — เป็นโครมที่ขึ้นทุกหน้า
//
// ───────────────────────────────────────────────────────────────────────────
// รอบนี้ (สล็อต168) พาเลตตาม .claude/brand-spec-slot168.md §2
// 🚨 **รอบนี้ยังเป็นธีมมืดเหมือนรอบก่อน แต่คนละฮิวสิ้นเชิง** เหตุผล: bg.json ของ
// ดรอปนี้เป็น {"mode":"color","color":"#140000"} = **ดำอมแดงเข้มมาก**
// (รอบก่อนเป็น 000000 = ดำสนิท) และ bg.json คือแหล่งเดียวของพื้นเพจ
// **ห้าม "แก้" การ์ดให้เป็นพื้นสว่าง** — การ์ดสว่างบนหมึก #f0e6e4 จะทำให้หน้า
// terms/privacy/404 ที่พึ่ง BRAND_TEXT ตัวอักษรหายไปเลย ไม่ใช่แค่จางลง
//
// อ่านจากอาร์ตเวิร์กจริง: โลโก้เป็น **ตัวอักษร "สล็อต168" สามมิติผิวเจลแดงสด
// มันวาว ไฮไลต์ขาวสเปกคูลาร์ มีมงกุฎทองเล็กประดับหัวใจแดงบนตัวอักษรตัวแรก
// บนพื้นโปร่ง** ส่วนแบนเนอร์เป็นฉาก **สตูดิโอพื้นขาวสะอาด** และสไลด์ทั้งสองใบ
// เป็น **สตูดิโอดำสนิท** มีผู้หญิงถือโทรศัพท์ที่จอแสดงตารางเกมสล็อต
// ⚠️ **คาร์ดิแกนแดง เสื้อกล้ามขาว พื้นสตูดิโอขาว และสีผิวนักแสดงเป็นวัตถุในภาพ
// ไม่ใช่สี UI** — พื้นเพจมาจาก bg.json เท่านั้น ไม่ใช่จากพื้นขาวของแบนเนอร์
// ⚠️⚠️ **มงกุฎทองเป็นรายละเอียด ~2% ของอาร์ตเวิร์ก ไม่ใช่สีแบรนด์** และทองคือ
// ฮิวนำของรวย168 รอบก่อนทันที — **รอบนี้ไม่มีทองเลยสักเฉด**
//
// บทบาทสีในไฟล์นี้:
//   ผิวการ์ด (กลาง) #1c0607 · ชั้นจม #0b0000 · ชั้นยก #2a0c0d · พื้นเพจ #140000
//   แดงสด #fb2e33 = **สีหัวข้อ** (5.1:1 บนผิวการ์ดนี้ ผ่าน AA สำหรับหัวข้อตัวโต)
//     และเป็นเส้นคาดบนสุด ขอบ hover และต้นของเส้นใต้หัวข้อ
//     อ่านจากอาร์ตเวิร์กตรงๆ (ตัวอักษรในโลโก้ · "สล็อต168" บนแบนเนอร์ ·
//     "ไม่ผ่านเอเย่นต์100%" บนแคปซูล · เลข 0.3% / 0.8% บนสไลด์ — เป็นแดงทั้งหมด)
//   มุกอุ่น #f0e6e4 = **วัสดุที่สองของรอบนี้** (จากไฮไลต์สเปกคูลาร์บนตัวอักษร
//     แคปซูลพื้นขาว และคำว่า "โปรโมชั่น" บนสไลด์) ใช้เป็นปลายของเส้นใต้หัวข้อ
//     และออรารอง — ค่านี้ **ถือตัวอักษรได้** (16.0:1) และเป็น BRAND_TEXT ด้วย
//   เส้น #551c1e = ขอบปกติ (**ห้ามถือตัวอักษร**)
//   หมึก #f0e6e4 = สีเนื้อความ (= BRAND_TEXT) 16.0:1 บนผิวการ์ดนี้
// ⚠️⚠️ **#1c0607 #0b0000 #2a0c0d #140000 #551c1e #cb0b0d #8a0608 #7d6f6e
// ห้ามถือตัวอักษร** เป็นสีพื้น/เส้นเท่านั้น ส่วน **#fb2e33 (5.1:1) · #f0e6e4
// (16.0:1) · #c9b9b7 (10.3:1) · #e3d6d4 (14.1:1) ถือตัวอักษรได้บนผิวมืดชุดนี้**
// ⚠️⚠️ **ขาวบนแดงสด #fb2e33 ได้แค่ ~3.8:1 — ห้ามถมพื้น #fb2e33 แล้ววางหมึกขาว
// ในไฟล์นี้** พื้นแดงที่ถือหมึกขาวได้ต้องเป็น #d81115 ลงไป
// rgba() ที่อนุญาตรอบนี้: rgba(251,46,51,α) · rgba(203,11,13,α) ·
// rgba(138,6,8,α) · rgba(240,230,228,α) · rgba(227,214,212,α) · rgba(0,0,0,α)
//
// ⚠️ ไฟล์นี้เป็นของแบรนด์ก่อนหน้าทุกรอบ ห้ามเหมาว่าสีที่เจอเป็นของรอบนี้ ต้องเทียบ
// เป็น **"ค่า"** ไม่ใช่ "ตระกูลสี"
// รอบก่อนหน้าทันที (รวย168 ทองนำ + โครเมียมเงินรอง บนดำสนิท — **ตัวที่เสี่ยง
// หลงเหลือสูงสุด**) ที่กวาดออกครบแล้วจากไฟล์นี้:
//   ffd94a e3a712 9d6f06 e8eaee b4b9c2 6b7079 070707 121110 1c1a16 3d3425
//   f3ece0 bfb8aa dde1e7 + rgba(255,217,74) rgba(227,167,18) rgba(176,125,8)
//   rgba(232,234,238) rgba(221,225,231)
// ⚠️ ระวัง **1c1a16 (ผิวยกของรอบก่อน) กับ 1c0607 (ผิวการ์ดรอบนี้)** — ต่างกันที่
// G/B เท่านั้น grep ทีละค่า อย่าตัดสินด้วยสายตา
// 🚨🚨 **ทอง/เหลืองเคยนำมาแล้วเกือบทุกแบรนด์ในรีโปนี้** จึงเป็นตระกูลที่ต้องเทียบ
// ทีละค่าแน่นที่สุด ค่าทองของแบรนด์อื่นที่ต้องกวาดออก:
//   fbc134 ffe87a cf9a18 96690a 241700 1a1000 432b03 231500 (NAZA168 ตัวละติน) ·
//   f5ba14 fcee52 b37c0b (เงินทอง168) · eeae12 fded41 9f600d e29f0f fdf051
//   (พักยก168) · f7c92b ffe6a3 (ขวัญใจ168) · d4922c fdfc71 d39c45 f6e3b4
//   (ufalion168) · e5a81b ffe08a bb8410 7d5a07 (UFA324) · fee45d e6a416 b8780d
//   7a4e05 (ยูฟ้า168) · fef54b 6b5c10 (นินจา168) · fdcb0c fefb6b 8a6504 (สบาย168) ·
//   f9a826 704504 (รวยแทร่168) · ffc82e 5c4a16 (สบายเบท168) · ffd84d 6b4708
//   (ถอนชัวร์168) · e3b23c ffe5a8 8a6210 (สมหวัง168) · dcb95f b8862b 96681f
//   (รวยแท้168) · fcd434 ffeaa0 (มีโชค168) · cd9a2c fdeb7c ab7314 (หวยคิง) ·
//   f0bb4e ffeccb (รวยเทพ168) · fcd45c 6b4a08 (มีเฮ168) · ffdc8c f0b429
//   (รับตัง168) · f0c878 (ดวงเศรษฐี168) · f0b46a d9803a (โปรดี168) ·
//   ffc93c ffeab0 (หวย365) · f5b61d b07a06 (PIGPG) · c9cb63 aeb04a 9ba03c (สาธุ168)
// 🚨🚨 **รอบนี้เป็นแบรนด์แดงจริง จึงต้องเทียบแดงทีละค่าแน่นเป็นพิเศษ** แดงของ
// แบรนด์อื่นที่ **ห้ามใช้**:
//   ff2e52 e01238 c9102f (มาดาม168) · fb141b ff5f63 ffa0a2 db040b 8a0609 (GT66B —
//   ⚠️ **fb141b ห่างจาก #fb2e33 แค่ G/B และ 8a0609 ห่างจาก #8a0608 แค่ B1
//   เจอที่ไหนแปลว่าพิมพ์ผิด ไม่ใช่ค่าของรอบนี้**) · eb0305 e40303 c20305 9b0a0c
//   ff4446 (โปรดี168) · fa0513 ff5a5f ffadaf (สมหวัง168) · d9212a 8e1a16
//   (ดวงเศรษฐี168) · fb1b32 ff8f9c 5c0410 (มีเฮ168) · e4021b (รวยเทพ168) ·
//   d30304 a00203 ff6b6e (รับตัง168) · dc0203 f5282a (หวย365) · c30303 8f0505
//   e81313 ffdbdb fff1ef ffeee8 4a0f0f (รวยแท้168) · b3121b 5a0a0e (ขวัญใจ168) ·
//   dd1b74 a4186b (มีทรัพย์168) · f5469f 8c0f52 (มีโชค168) · fa63b9 (ถอนชัวร์168) ·
//   ff3b14 6d0804 2b0000 (FLASH877)
// ⚠️ ฟ้า/น้ำเงินของแบรนด์เก่า (รอบนี้ไม่มีน้ำเงินเลย):
//   1177e8 0e68cc 0a4ea8 00091f 050e26 0b1733 16234a 2a3c70 (มาดาม168) ·
//   1fd8f0 0bb6d4 8fd9ec 1d4fd8 143aa0 e6edf8 9fb2cb 0d1017 (นาซ่า168) ·
//   18a5e2 0d6b9b 0a5176 a9d7f2 111a3f 202a66 31408a e9f1ff adc0e4 (ร่ำรวย168) ·
//   2cc3fc 6bdcfb 9ae0fa 0a7fbd 063a57 0f3a4a f2fbff dff4fd ccf7ff cdf2ff eafaff
//   a9e3f9 04293d 0a4f74 06293c (สบาย168) · 039cfa 0494f5 c3ebfc 04366b e3f2fc
//   0b2d52 (รวยแทร่168) · 32bcfb a9e9ff 07335f 0c2a3d 071a28 030e16 041019 dceefc
//   (นินจา168) · 2f9ff5 a8dcff d6ecff 0b3f78 e8f4ff (สบายเบท168) ·
//   0360f3 0292fb 6ec8ff 4fb4ff 00081f 102a5e 0a1c42 (TSDET911)
// ⚠️ ครีม/เบจ/น้ำตาลของแบรนด์เก่า — รอบนี้ไม่มีเลย:
//   f4e4d3 e4cbb3 (ร่ำรวย168) · ecd5c4 d2b9a4 29210f 3d3016 332810 201906 2e2512
//   1b1407 4d3c15 (เงินทอง168) · eadfce (ขวัญใจ168) · f5e7c8 fce2d4 (หวยคิง) ·
//   f4ead6 d6c6a8 1f0f04 2f1e0f 4e2f11 291d0f (พักยก168) · 0a0908 1e1a13 15130f
//   0b0d10 (ยูฟ้า168) · 33200a 1f1304 0a0601 1a1000 (ufalion168) · 2c1004 1a0802
//   401107 (โปรดี168) · 1c0503 2a0806 (PIGPG)
//   ⚠️ ผิวของรอบนี้ (#1c0607 #2a0c0d #551c1e) เป็น **ดำอมแดงอุ่นมากๆ** ซึ่งต่างจาก
//   น้ำตาลกาแฟข้างบนทุกค่า — ตรวจทีละค่า อย่าตัดสินด้วยสายตา
// ⚠️ แรมป์เทาเงิน — รอบนี้วัสดุที่สองคือ **มุกอุ่น (R>G>B)** ไม่ใช่เงินเย็น
//   ค่าเงินเย็นของแบรนด์อื่นต้องกวาด: e8eaee b4b9c2 6b7079 (รวย168 **รอบก่อน**) ·
//   d9dfe9 b3bdd6 f4eef1 (มาดาม168) · e0e0df c0c0bf a1a09e (พักยก168) ·
//   e8ecf1 a8b2bf 78828f 5a6472 (ยูฟ้า168) · 8792a0 b9c2cc f0e8d4 464f5a (UFA324) ·
//   cfd9e6 (รับตัง168) · fdfcfd b4bcc2 eceaea (GT66B) · d9c9a6 cfd6e3
//   (NAZA168 ตัวละติน) · cfdcec 9db4d4 dde8f7 (TSDET911)
// แบรนด์เก่ากว่านั้นทั้งหมดอยู่ในตารางของ brand-spec §2 — grep ทีละค่าจากตารางนั้น
// ⚠️ รอบนี้ **ไม่มีทอง ไม่มีเหลือง ไม่มีส้ม ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีม่วง
// ไม่มีเขียว (ยกเว้น LINE green ที่อื่น) ไม่มีครีม ไม่มีเบจ ไม่มีน้ำตาล**
// (เฮกซ์ของแบรนด์เก่าในคอมเมนต์ด้านบนเขียนแบบ **ไม่มี #** โดยตั้งใจ เพื่อไม่ให้
// การ sweep ไล่หาสีของแบรนด์เก่าใน src/ สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#551c1e] bg-[#1c0607]/95 p-8 text-left text-base leading-relaxed text-[#f0e6e4] shadow-[0_10px_30px_rgba(0,0,0,0.6)] backdrop-blur-xl transition-all duration-500 hover:border-[#fb2e33] hover:shadow-[0_15px_40px_rgba(203,11,13,0.25)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#fb2e33] to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#cb0b0d]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#fb2e33]/35"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#f0e6e4]/10 blur-[60px] transition-all duration-500 group-hover:bg-[#f0e6e4]/18"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="text-2xl leading-normal font-black tracking-widest text-[#fb2e33] uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#fb2e33] to-[#f0e6e4] shadow-[0_0_10px_rgba(203,11,13,0.5)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
