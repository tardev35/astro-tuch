---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// PUNPRO168 (รอบชมพูฮอตพิงก์-ทอง 2026-10-12): พาเลตต์ตาม brand-spec §2
// รอบนี้พลิกออกจากสาย "ทองบนดำ" ของแปดรอบหลังสุด — TIGERWIN369 รอบก่อนเป็น
// ทองอำพันล้วนสองระดับบนดำสนิท รอบนี้เป็น **ชมพูบานเย็นนำ ทองสว่างรอง บนพื้น
// พลัมเข้มอมม่วง** (bg.json = {"mode":"color","color":"#2e0022"}) การ์ดจึงเป็น
// ผิวยกพลัมสว่าง #4a1038 ที่ลอยขึ้นจากพื้นเพจ เหมือนเครื่องเกมชมพูในโลโก้ที่ลอย
// อยู่บนฉากดำประกายชมพู-ทอง
// ⚠️ พื้นเพจรอบนี้ **ไม่ใช่ดำสนิท** จึงมีชั้นที่ลึกกว่าพื้นได้จริง (#1c0014)
//
// ชมพูบานเย็น #f41571 (ฮิวหลัก — ตัวอักษร PUNPRO และตัวเครื่องเกมบนโลโก้) ถือขอบ
// การ์ด เส้นคาดบนสุด และออรามุมซ้ายบน · ทองสว่าง #fce343 (ตัวที่สอง — เลข 168
// สามมิติและเหรียญทองในอาร์ต) เป็นปลายไล่เฉดหัวข้อและออรามุมขวาล่าง
// ลำดับ ชมพูสว่าง→ชมพูบานเย็น→ทอง ของหัวข้อคือลำดับที่ตาอ่านโลโก้จริง (เครื่องเกม
// ชมพูอ่อนก่อน แล้ว PUNPRO ชมพูเข้ม แล้วจบที่ 168 ทอง) · ชมพูสว่าง #ff5ca8 เป็น
// ต้นสว่างสุดของหัวข้อ · ชมพูลึก #8a0a45 กับ #4a0426 เป็นปลายเข้มของเส้นใต้ —
// ทั้งคู่ไม่เคยถือตัวอักษร
// เนื้อความเป็นครีมอมชมพู #fde7f2 (= BRAND_TEXT) — 12.6:1 บนผิวการ์ดนี้
//
// ⚠️ ไฟล์นี้เป็นของแบรนด์ก่อนหน้าทุกรอบ ห้ามเหมาว่าสีที่เจอเป็นของรอบนี้ ต้องเทียบ
// เป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **รอบนี้ชมพูกับทองเคยมาแล้วทั้งคู่** "มีชมพูอยู่"
// หรือ "มีทองอยู่" จึงไม่ได้พิสูจน์อะไรเลย: ชุดทองอำพันเสือของ TIGERWIN369
// (#d98324 #f7b733 #ffd98a #f7e4c0 #e3cfae #8a5214 #4a2a08 #1a0d02 #2d1c0a
// #1c1206 #0f0903) ชุดทองแชมเปี้ยน-เงินโครเมียมของ UFA324 (#e5a81b #b9c2cc
// #231c0e #17130a #0d0b06 #f0e8d4 #ffcf5e #ffe08a #7d5a07 #43300a #464f5a)
// ชุดชมพู-ทองของ FAH999 (#ff3fa4 #ff6cbb #ffd1ea #fde8f3 #f5c53d #9c6f08 #b3006a
// #4a0b42 #3a0534 #2e002c #210220) ชุดทองเป็ด-ส้มปากเป็ดของ DUCK1688 (#f3bb34
// #fde464 #c8901a #8a5f08 #5c3f04 #f58b2a #ffc98a #a3510c #1a1203 #f6ecd9 #d8c69b
// #1f1709 #171106 #0d0903) ชุดทองอวกาศ-เงินโครเมียมของ NAZA168 (#fbc134 #ffe87a
// #cf9a18 #96690a #6b4a05 #eef2f8 #cfd6e3 #9aa6bb #3f4859 #fdf3df #d9c9a6 #4e3406
// #432b03 #382400 #241700) ชุดทองสายฟ้า-แดงเลือดนกของ FLASH877 (#f5c518 #ffdd73
// #b8860f #ff3b14 #8c0f0a) ชุดแดงเสือโคร่ง-ทองถ่านไฟของ SUPERSLOTCLUB (#e8232a
// #f2b705 #ffd666 #c08a0b) ชุดเขียว-ทองของ KINGKONG555 (#8ce023 #f2c230 #ffe066
// #a87a08 #06220a) ชุดม่วง-ทองของ WEPLAY168 (#a435f0 #5b1a75 #1e0a3c) และชุดแดง
// แล็กเกอร์ของ PIGPG (#d4200d #f5b61d #ffd87a) ออกครบทุกจุดแล้ว
// ⚠️ ชมพูของรอบนี้ (#f41571) อิ่มและแดงกว่าชมพู #ff3fa4 ของ FAH999 — R=244 G=21
// เทียบกับ R=255 G=63 และทอง #fce343 ก็เหลืองสดกว่าทองอุ่นทุกตัวในลิสต์
// ให้เทียบเป็นตัวเลข ไม่ใช่ด้วยตา
// ⚠️ **รอบนี้ไม่มีเงิน/เทา ไม่มีเขียว ไม่มีน้ำเงิน และไม่มีส้มอิฐเลย**
//
// ⚠️ #8a0a45 และ #4a0426 ห้ามถือตัวอักษรทุกขนาด อยู่ได้เฉพาะในไล่เฉดของเส้นคาด
// ในออรา และเป็นขอบ ส่วน #fce343 (11.4:1) กับ #ff5ca8 (5.2:1) และ #f0c3dc (9.6:1)
// ถือตัวอักษรรองได้จริง และ #ffd94a (10.8:1) คือตัวที่ใช้ไฮไลต์ในเนื้อความ
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#f41571]/40 bg-[#4a1038]/95 p-8 text-left text-base leading-relaxed text-[#fde7f2] shadow-[0_10px_30px_rgba(0,0,0,0.6)] backdrop-blur-xl transition-all duration-500 hover:border-[#f41571]/80 hover:shadow-[0_15px_40px_rgba(244,21,113,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#f41571]/75 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#f41571]/40 blur-[60px] transition-all duration-500 group-hover:bg-[#ff5ca8]/30"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#4a0426]/60 blur-[60px] transition-all duration-500 group-hover:bg-[#fce343]/28"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#ff5ca8] via-[#f41571] to-[#fce343] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#f41571] via-[#8a0a45] to-[#4a0426] shadow-[0_0_10px_rgba(244,21,113,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
