---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#1046e0]/32 bg-[#020a2b]/92 p-8 text-left text-base leading-relaxed text-[#d6e2f5] shadow-[0_10px_30px_rgba(1,4,28,0.72)] backdrop-blur-xl transition-all duration-500 hover:border-[#b7c6dd]/60 hover:shadow-[0_15px_40px_rgba(16,70,224,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#1046e0]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#1046e0]/32"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#052ba9]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#b7c6dd]/32"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#1046e0]/32 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e6ecf7] to-[#7d90ad] shadow-[0_0_10px_rgba(183,198,221,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#e6ecf7] via-[#b7c6dd] to-[#8fc2ff] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
