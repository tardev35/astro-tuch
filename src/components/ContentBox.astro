---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro, /promotion,
// /about-us, /contact-us, /ทางเข้า, /ทดลองเล่น, /login และ /register render
// ตัวเนื้อหาผ่านไฟล์นี้ (10 หน้ารอบนี้) และไม่เคยเดินตาม ContentBox rotation ของ index
// ⚠️ รอบนี้ **หน้าแรกไม่ได้ใช้ไฟล์นี้เลย** (shape-mix ของ index รอบนี้เป็นชุด
// Neumorphism + Premium + TwoCyberCut) แต่สถานะ shared chrome ของไฟล์นี้
// **ไม่ได้ขึ้นกับข้อนั้นเลย** — สิบหน้าข้างบนใช้อยู่แล้วไม่ว่า index จะเลือก variant ไหน
// → ไฟล์นี้ต้องถือพาเลตของ "แบรนด์ปัจจุบัน" เสมอ
// **ห้ามปล่อยให้มันหลุดจากชุดที่ retheme ใน P1 เด็ดขาด** — นี่คือรอบที่พลาดง่ายที่สุด
// เพราะ grep หา "ไฟล์ที่ index import" จะไม่เจอไฟล์นี้
// ⚠️ รอบนี้ /ตรวจหวย และ /แนวทาง **ยังอยู่ใน src/pages-disabled/ ตามเดิม**
// (แบรนด์นี้เป็นเว็บคาสิโน บรีฟเอ่ย "หวย" แค่ในฐานะหนึ่งในห้าหมวดเกม)
// ⚠️ หน้าถาวรพวกนั้น **ไม่ประกาศสีตัวอักษรเองเลยสักจุด** ย่อหน้าทั้งหมด inherit สีมา
// จากการ์ดข้างล่าง ถ้าการ์ดไม่ตั้ง text color หน้าเหล่านั้นจะตกไปใช้ default ของ
// เบราว์เซอร์ → คลาสชุด text-left + text-base + leading-relaxed + สีหมึกของรอบนี้
// บน element ที่ถือ <slot /> ห้ามหายไปสักตัว (รอบนี้สีหมึกคือ eef7f0)
// ⚠️ เขียนชื่อคลาสสีแบบถอดวงเล็บโดยตั้งใจ — Tailwind สแกนไฟล์นี้แบบ plain text
// รวมถึงคอมเมนต์ด้วย การพิมพ์คลาสสีเต็มรูปในคอมเมนต์จึงทำให้ยูทิลิตี้ของค่านั้น
// ถูก generate ลง stylesheet จริง (เคยเจอค่าของแบรนด์ก่อนหลุดมาทางนี้)
//
// Flattened single-slot variant (ทำเมื่อ 2026-07-26): isolate บนการ์ด + -z-10
// บนชั้นตกแต่ง absolute ทุกชั้น slot จึง render เป็นลูกตรงของการ์ด
// **ห้ามเพิ่ม wrapper <div> รอบ slot กลับมา** และถ้าจะเปลี่ยนสีตัวอักษรของการ์ด
// ให้ **แทนที่** คลาสสีเดิม ไม่ใช่ใส่คลาสสีที่สองข้างๆ (specificity เท่ากัน ผลจะ
// ขึ้นอยู่กับลำดับที่ Tailwind บังเอิญ emit)
//
// House style เนื้อความ: element ที่ถือ slot ได้ text-left + text-base +
// leading-relaxed + สี — ห้ามย่อหรือขยายขนาดตัวอักษรของเนื้อความ · หัวข้อจัดกลางได้
// แต่ต้องใส่ text-center ที่ตัวหัวข้อเอง **ห้ามใส่บนการ์ดหรือ <section>** เพราะมันจะ
// inherit ลงไปใน slot แล้วทำให้ย่อหน้าของทุกหน้าที่เรียกไฟล์นี้กลางตามไปด้วย
//
// หัวข้อมาจาก prop title + as เท่านั้น (เป็นหัวข้อจริงของบทความ/หน้านั้นๆ)
// **ห้าม hardcode ข้อความไทยเป็น heading ในไฟล์นี้** — เป็นโครมที่ขึ้นทุกหน้า
//
// ────────────────────────────────────────────────────────────────────────────
// รอบนี้ (ZORO365) พาเลตตาม .claude/brand-spec-zoro365.md §2
// 🚨🚨 **กลับทิศ 180° จากรอบก่อน: รอบนี้การ์ดเป็นผิวเข้ม ไม่ใช่การ์ดขาว**
// เหตุผล: bg.json ของดรอปนี้เป็น {"mode":"color","color":"#002908"} = **เขียวป่าจม
// เกือบดำ** (รอบก่อน TEVA69 เป็น f0ffeb = ขาวอมมิ้นต์จาง ซึ่งอยู่คนละปลายของสเกล)
// และ bg.json คือแหล่งเดียวของพื้นเพจ
// ⚠️⚠️ **รอบนี้ทั้งเนื้อหาและโครมเป็นผิวเข้มทั้งคู่** — navbar/footer/ticker เป็น
// 031b09 ส่วนการ์ดนี้เป็น 073c1a ซึ่งยกขึ้นมาจากพื้นเพจ 002908 เล็กน้อยพอให้
// แยกชั้นได้ **ห้าม "แก้" การ์ดกลับไปเป็นพื้นขาวตามรอบก่อน** การ์ดขาวบนหมึก
// eef7f0 จะทำให้หน้า terms/privacy/404 ที่พึ่ง BRAND_TEXT ตัวอักษรหายไปเลย
// ไม่ใช่แค่จางลง — และขาวเป็นพื้นถมใหญ่บนธีมมืดคือจอสว่างแปลบกลางหน้า
//
// อ่านจากอาร์ตเวิร์กจริง: โลโก้เป็น **เวิร์ดมาร์กสามมิติ ครึ่งแรกเป็นตัวอักษรละติน
// ผิวโครเมียมเงินขัดเงา ครึ่งหลังเป็นตัวเลขผิวเขียวมรกตเคลือบเงาเรืองแสง ตัดขอบดำหนา
// วางทับวงพู่กันหมึกดำ-เขียว มีดาบคาทานะปักตั้งผ่ากลางวง** ส่วนแบนเนอร์เป็นฉาก
// **ห้องสไตล์ญี่ปุ่นที่มีกอไผ่และดอกไม้ขาว หญิงสาวสวมกิโมโนลายดอกไม้เขียว-ขาว
// ดาบคาทานะวางพาด และชิปคาสิโนเขียว-ขาวกองซ้อนกัน**
// และสไลด์ทั้งสองใบเป็นฉากเดียวกัน พิมพ์เลข 0.3% / 0.8% ตัวเขียวตัดขอบทอง
// ⚠️ **ผิวเงินโครเมียม สีผิวนักแสดง กอไผ่ และฉากห้องสว่างเป็นวัตถุในภาพ
// ไม่ใช่สี UI** — พื้นเพจมาจาก bg.json เท่านั้น **ห้ามอนุมานจากรูป**
//
// บทบาทสีในไฟล์นี้:
//   ผิวการ์ด 073c1a · ชั้นยก/แถบ 0e5424 · โครม 031b09 / 010d04 · พื้นเพจ 002908
//   เขียวมรกต 3ddc4a = **สีหัวข้อ** (6.9:1 บนการ์ด ผ่าน AA สบาย) และเป็นปลาย
//     ไล่เฉดของเส้นบน
//   เงินโครเมียม dfe6e3 = **ถือตัวอักษรได้** (9.9:1 บนการ์ด) ลายเซ็นของเวิร์ดมาร์ก
//   ทองอำพัน e8c86a (8.0:1) ถือตัวอักษรได้ ใช้เป็นคู่สีที่สองได้
//   หมึก eef7f0 = สีเนื้อความ (= BRAND_TEXT) 12.0:1 บนการ์ด · หมึกรอง 9dc2a5 (6.3:1)
//   เส้นบาง 1e7033 · ขอบตกแต่ง/ออรา 35a043 (**ทั้งคู่ห้ามถือตัวอักษร**)
// 🚨🚨 **35a043 บนการ์ด 073c1a ได้แค่ 3.8:1 และ 1e7033 ได้ 2.1:1 — ห้ามเป็นสี
//   ตัวอักษรในไฟล์นี้เด็ดขาด** เป็นเส้น/ขอบ/ออรา/พื้นถมเท่านั้น
// ⚠️⚠️ **002908 010d04 031b09 073c1a 0e5424 1e7033 35a043 เป็นผิว ไม่ใช่สีตัวอักษร**
// ส่วน **eef7f0 (12.0:1) · dfe6e3 (9.9:1) · e8c86a (8.0:1) · 3ddc4a (6.9:1) ·
// 9dc2a5 (6.3:1) ถือตัวอักษรบนผิวเข้มได้ทั้งหมด**
// rgba() ที่อนุญาตรอบนี้: rgba(61,220,74,α) · rgba(53,160,67,α) · rgba(30,112,51,α) ·
// rgba(232,200,106,α) · rgba(223,230,227,α) · rgba(1,13,4,α)
//
// ⚠️ ไฟล์นี้เป็นของแบรนด์ก่อนหน้าทุกรอบ ห้ามเหมาว่าสีที่เจอเป็นของรอบนี้ ต้องเทียบ
// เป็น **"ค่า"** ไม่ใช่ "ตระกูลสี"
// 🚨🚨 **รอบก่อนหน้าทันที (TEVA69) ก็เป็นแบรนด์เขียว/เงินโครเมียม/ทองอำพัน
// เหมือนกันเป๊ะ ต่างกันแค่กลับทิศสว่าง-มืด — นี่คือรอบที่ "ตระกูลสีเดียวกัน"
// หลอกตาได้แรงที่สุดเท่าที่เคยมีในรีโปนี้** ค่าที่กวาดออกครบแล้วจากไฟล์นี้:
//   f0ffeb ffffff e6f7df d7f0cd b2dba3 3f7a2e 10280f 3c5b36 116018 0b4a12 1a7d24
//   8a6a0e 28c437 e3bb45 c6cfd2 0b2a12 15401d 051409 2d6b2f e8fbe4 b4d6ad
//   + rgba(17,96,24) rgba(11,74,18) rgba(40,196,55) rgba(227,187,69) rgba(16,40,15)
//   rgba(178,219,163)
//   ⚠️⚠️ **คู่ที่ใกล้ที่สุดในลิสต์ทั้งหมด: e8fbe4 ↔ eef7f0 · c6cfd2 ↔ dfe6e3 ·
//   e3bb45 ↔ e8c86a · 28c437 ↔ 3ddc4a · b4d6ad ↔ 9dc2a5 · 15401d ↔ 0e5424**
//   ถ้า grep เจอค่าซ้ายแปลว่าพิมพ์ผิด ไม่ใช่ว่า "มันก็เขียว/ทอง/เงินเหมือนกัน"
// 🚨🚨 **เขียวเคยเป็นฮิวนำของแบรนด์เก่ามาแล้วหลายเจ้า จึงต้องเทียบทีละค่าแน่นที่สุด**
//   ค่าที่ **ห้ามใช้**:
//   เขียวของ KINGKONG555 — 8ce023 e9f7d6 bde397 1a5c04 2f8c07 051400 0f2e05 06220a
//     a87a08 f2c230 ffe066 (**bde397 ↔ 9dc2a5 · 1a5c04 ↔ 1e7033**)
//   เขียวของ สาธุ168 — 0b7d28 0a5f1c 0f9b35 0c3a16 061f0c
//     ⚠️⚠️ **0c3a16 ↔ 073c1a ของรอบนี้ ต่างกันหลักเดียวและสลับหลักท้าย —
//     นี่คือคู่ที่พิมพ์ผิดง่ายที่สุดของทั้งรอบ ถ้าเจอ 0c3a16 ให้ถือว่าพิมพ์ผิดเสมอ**
//     และ **0a5f1c ↔ 0e5424**
//   เขียว/แดงของ 888PARUAY — 1fae1c 0d2312 143a1c 07130a e8e4c6 cf1111 e01f26
//     (**143a1c ↔ 073c1a ก็ใกล้มากเช่นกัน**)
//   เขียวของ MEXICANOSLOT/KOON234 — 117a41 2bb061 2fbf6a (**2bb061 ↔ 3ddc4a**)
//   แดง/ทอง/ขาวชมพูของ LOTTO189 — fff0f0 ffe4e6 ffd4d7 f5b9bd a8333f 25090f 6e3b44
//     b00718 c1071b 8a0412 8f6310 d61023 ff2436 e9b53c 24060c 3d0d16 120307 7e1221
//     ffeaea f0bcbc c3ccd6 (**e9b53c ↔ e8c86a · c3ccd6 ↔ dfe6e3 · 8f6310 ↔ 8a6a0e**)
//   แดง/ส้ม/ครีมของ ZNOVA168 — 2a1206 1a0c04 2b1608 0e0602 7a3a0c fff3e0 e0b784
//     fffbf0 fff4e0 ffe9c7 f3d9a8 c98a24 c23400 b8300a 9a5b00 9a2a00 d13800 fa4903
//     fde90b e8a000 ff8a2b d8dde6 8f9aa8 6a4a30
//   ไวโอเลต/ฟ้า/แมเจนต้าของ ZANE96 — 7a1bd6 2b3fd9 c2178b f23bb4 bb6dff 7aa7ff
//     5411c4 241046 6b4a86 f8e6f9 f6edfe ece0fb dcc6f4 9a6fd0 190b3d 271257 100626
//     5b2f9e f3e8ff c0a6e8 8e14b8 2f1766
//   แดง/ส้ม/ทอง/ครีมของ MEXICANOSLOT — de2b1e f2a033 a81410 c81e12 9d140c 6f0e08
//     3f130d 80453a 2b100a 431a10 1d0a06 8c3a22 fdeee2 e8c6ae fed7b5 fec28d f6c4a4
//     e2855c fde4d3 fff3ea fef6fb f2543f (**e8c6ae ↔ e8c86a ขึ้นต้น e8c เหมือนกัน**)
//   ทอง/เหลือง/ส้มของแบรนด์เก่ากว่านั้น — ffd84d f5ba14 fcee52 b37c0b ffd94a e3a712
//     9d6f06 eeae12 fded41 9f600d fcd434 ffeaa0 fcd45c fdcb0c fefb6b fee45d e6a416
//     fef54b f7c92b ffe6a3 d4922c fdfc71 e5a81b ffe08a f9a826 ffdc8c f0b429 ffc82e
//     e0bd72 f6e4b4 d4af5a eab308 f5c53d ece2cc dcb95f f0c878 f0b46a fbc134 ffe87a
//     cf9a18 b8862b 96681f 8a6504 b8780d bb8410 d9803a fcdc2b fff6ae a87d0c fadc64
//     fdf3b4 e0b03a e3b23c (**f0c878 ↔ e8c86a · e3b23c ↔ e8c86a**)
//   แดงของแบรนด์เก่า — fb2e33 cb0b0d d81115 b00d11 8a0608 ff2e52 e01238 c9102f
//     fb1b32 ff8f9c 5c0410 fa0513 ff5a5f ffadaf b3121b 5a0a0e fb141b ff5f63 ffa0a2
//     eb0305 e40303 c20305 c30303 8f0505 e81313 d9212a 8e1a16 e4021b d30304 a00203
//     dc0203 f5282a ff3b14 6d0804 c41115 7a0505 1a0709 2a0b0e 120406
//   ครีม/เบจ/น้ำตาล/เทาเงินของแบรนด์เก่า — f4ead6 d6c6a8 1f0f04 4e2f11 291d0f f4e4d3
//     e4cbb3 ecd5c4 d2b9a4 29210f eadfce f3ece0 bfb8aa f0e6e4 c9b9b7 e3d6d4 7d6f6e
//     e8eaee b4b9c2 6b7079 dde1e7 d9dfe9 b3bdd6 f4eef1 e0e0df c0c0bf a1a09e e8ecf1
//     a8b2bf 78828f 8792a0 b9c2cc fdfcfd b4bcc2 eceaea cfdcec 9db4d4 d9c9a6 cfd6e3
//     f3f6fa d8bda6 (**cfd6e3 / d8dde6 / e8eaee ↔ dfe6e3**)
//   ชมพู/แมเจนต้า — ffd6fa fff4fb ffe3f5 ffe9f7 f9b2d9 f479b9 f4a7cf 6a0f3c 95486b
//     9c0f55 fb439b fc74b5 ffc2e2 d91a73 b01160 85094a fd6cb2 fc7cba fc4da1 (okkub88)
//     fa539c c2185b 8e0f41 fb8cc0 fdc6c3 ffd1cd f7bcd9 ef8dbd ffe5ff fff0f8 ffeef7
//     3b0b26 54123a 7a2350 ffe9f5 7a4463 (หมูบิน168) · f5469f ff8dc6 8c0f52 (มีโชค168)
//     · fa63b9 ffb3de (ถอนชัวร์168) · dd1b74 a4186b 4a0d35 2d0720 (มีทรัพย์168) ·
//     f41571 ff5ca8 (PUNPRO168)
//   ฟ้า/ไซแอน/น้ำเงิน — 00bfff 12b4ef b6e3f0 7fcbe8 4fb8ea 06283f 0b4a73 2a87c4
//     eaf7ff f0faff e4f6fb 355f7d 0f5684 1a6ea8 (โบ๊ะบ๊ะ168) · 1177e8 0e68cc 0a4ea8
//     00091f 0b1733 16234a (มาดาม168) · 1fd8f0 0bb6d4 1d4fd8 143aa0 (นาซ่า168) ·
//     18a5e2 0d6b9b 0a5176 a9d7f2 (ร่ำรวย168) · 2cc3fc 6bdcfb 0a7fbd 063a57 (สบาย168)
//     · 039cfa 0494f5 c3ebfc (รวยแทร่168) · 32bcfb a9e9ff 07335f (นินจา168) ·
//     2f9ff5 a8dcff d6ecff 0b3f78 e8f4ff (สบายเบท168) · 0360f3 0292fb 6ec8ff (TSDET911)
//     · 00f3ff e0ffff 60a5fa 4b5563 030712 1f2937 (default cyber-neon/dark)
//   ม่วง — 7e22ce d946ef a855f7 (CEO66) · 7505cc b453ff c07cff d9b8ff 3a0565 (KMD88)
// ⚠️ (เขียว 00B900 ของปุ่ม LINE และเขียว success ของฟีดถอนเงินอยู่ไฟล์อื่น **คงไว้
//   ห้ามกลืนเข้าพาเลตเขียวของรอบนี้ แม้รอบนี้แบรนด์จะเขียวก็ตาม** — สองค่านั้นเป็น
//   สีเชิงความหมาย ไม่ใช่สีแบรนด์)
// (เฮกซ์ของแบรนด์เก่าในคอมเมนต์ด้านบนเขียนแบบ **ไม่มี #** โดยตั้งใจ เพื่อไม่ให้
// การ sweep ไล่หาสีของแบรนด์เก่าใน src/ สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#1e7033] bg-[#073c1a] p-8 text-left text-base leading-relaxed text-[#eef7f0] shadow-[0_10px_30px_rgba(1,13,4,0.45)] transition-all duration-500 hover:border-[#35a043] hover:shadow-[0_15px_40px_rgba(61,220,74,0.22)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[3px] bg-gradient-to-r from-[#dfe6e3] via-[#3ddc4a] to-[#1e7033]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#3ddc4a]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#3ddc4a]/30"></div>
