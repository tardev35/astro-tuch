---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro, /promotion,
// /about-us, /contact-us, /ทางเข้า, /ทดลองเล่น, /login และ /register render ตัว
// เนื้อหาผ่านไฟล์นี้ (10 หน้า) และไม่เคยเดินตาม ContentBox rotation ของ index
// → ไฟล์นี้ต้องถือพาเลตของ "แบรนด์ปัจจุบัน" เสมอ ต่อให้ index เลือก variant อื่น
// ⚠️ หน้าพวกนั้น **ไม่ประกาศสีตัวอักษรเองเลยสักจุด** ย่อหน้าทั้งหมด inherit สีมา
// จากการ์ดข้างล่าง ถ้าการ์ดไม่ตั้ง text color หน้าเหล่านั้นจะตกไปใช้ default ของ
// เบราว์เซอร์ → คลาส `text-left text-base leading-relaxed text-[#0c3a16]` บน
// element ที่ถือ <slot /> ห้ามหายไปสักตัว
//
// Flattened single-slot variant (ทำเมื่อ 2026-07-26): `isolate` บนการ์ด + `-z-10`
// บนชั้นตกแต่ง absolute ทุกชั้น slot จึง render เป็นลูกตรงของการ์ด
// **ห้ามเพิ่ม wrapper <div> รอบ slot กลับมา** และถ้าจะเปลี่ยนสีตัวอักษรของการ์ด
// ให้ **แทนที่** คลาสสีเดิม ไม่ใช่ใส่คลาสสีที่สองข้างๆ (specificity เท่ากัน ผลจะ
// ขึ้นอยู่กับลำดับที่ Tailwind บังเอิญ emit)
//
// House style เนื้อความ: element ที่ถือ slot ได้ `text-left text-base
// leading-relaxed <สี>` — ห้ามย่อหรือขยายขนาดตัวอักษรของเนื้อความ (คลาส sm/lg
// ของ text-* ใช้กับย่อหน้าไม่ได้) · หัวข้อจัดกลางได้ แต่ต้อง
// ใส่ text-center ที่ตัวหัวข้อเอง **ห้ามใส่บนการ์ดหรือ <section>** เพราะมันจะ
// inherit ลงไปใน slot แล้วทำให้ย่อหน้าของทุกหน้าที่เรียกไฟล์นี้กลางตามไปด้วย
//
// หัวข้อมาจาก prop `title` + `as` เท่านั้น (เป็นหัวข้อจริงของบทความ/หน้านั้นๆ)
// **ห้าม hardcode ข้อความไทยเป็น heading ในไฟล์นี้** — เป็นโครมที่ขึ้นทุกหน้า
//
// ───────────────────────────────────────────────────────────────────────────
// รอบ 2026-10-21 (สาธุ168) พาเลตตาม .claude/brand-spec-satu168.md §2
// ⚠️⚠️ **นี่คือแบรนด์ "ธีมสว่าง" รอบที่สองของรีโปนี้ — การ์ดยังเป็นผิวสว่างหมึกเข้ม**
// เหตุผล: bg.json ของดรอปนี้เป็น {"mode":"color","color":"#d8ffc7"} = **เขียวมิ้นต์
// สว่าง** ไม่ใช่ดำสนิท และ bg.json คือแหล่งเดียวของพื้นเพจ
// **ห้าม "แก้" การ์ดกลับไปเป็นพื้นเข้มเพราะ "รอบก่อนๆ เป็นแบบนั้น"** — การ์ดเข้ม
// บนพื้นเขียวมิ้นต์สว่างจะทำให้หน้า terms/privacy/404 ที่พึ่ง BRAND_TEXT
// (= หมึกเขียวป่า #0c3a16) กลายเป็นหมึกเข้มบนพื้นเข้มทันที
//
// อ่านจากอาร์ตเวิร์กจริง: โลโก้เป็น **คำว่า "สาธุ" ตัวอักษรไทยสามมิติผิวมันวาว
// ไล่เฉดเขียวมรกตเข้มไปเขียวใบตองสว่าง ขอบขาว** ต่อด้วย **เลข "168" สามมิติ
// ผิวทองเหลืองมันวาว** ส่วนแบนเนอร์/สไลด์เป็นฉาก **วัดไทยแดดจัด เจดีย์ทอง
// ท้องฟ้าฟ้าอ่อน ดอกบัวชมพู คู่ชาย-หญิงชุดไทยถือสลากกินแบ่งรัฐบาล**
//
// บทบาทสีในไฟล์นี้:
//   ผิวการ์ด (ยก) #ffffff · ชั้นกลาง/อินเซ็ต #e9fbdd · พื้นเพจ #d8ffc7
//   เขียวมรกต #0b7d28 = ขอบการ์ด เส้นคาดบนสุด ออรา และต้นของเส้นใต้หัวข้อ
//     (5.3:1 บนผิวการ์ดขาว → ใช้กับเส้น ออรา และตัวหนาได้)
//   เขียวเข้ม #0a5f1c = **หัวข้อ** (7.9:1 บนผิวการ์ดขาว) และปลายเข้มของเส้นใต้
//   หมึกเขียวป่า #0c3a16 = เนื้อความ (= BRAND_TEXT) 12.9:1 บนผิวการ์ดนี้
//
// ⚠️⚠️ **#d8ffc7 และ #e9fbdd ห้ามถือตัวอักษรบนพื้นขาวเด็ดขาด** เป็นสีพื้น/เส้น
// เท่านั้น และ **#0f9b35 ห้ามถือตัวอักษรและห้ามเป็นพื้นของตัวอักษร** (3.7:1)
// เป็น stop ของไล่เฉด/ออราได้อย่างเดียว — สีไฮไลต์ <strong> ในเนื้อความมีตัวเดียว
// คือ **เขียวเข้ม #0a5f1c** ถ้าต้องการตัวอักษรที่อ่านว่า "เขียวสด" ให้ **ถม
// #0b7d28 เป็นพื้นแล้ววาง #ffffff ทับ** (5.3:1 ผ่าน AA)
// ⚠️⚠️ **ทองสัมฤทธิ์ทั้งสามค่า (c9cb63 aeb04a 9ba03c) ห้ามใช้ในไฟล์นี้เลยสักจุด** — บนผิว
// การ์ดขาวได้แค่ 1.7 / 2.3 / 2.8:1 ตกเกณฑ์ทุกค่า ทองเป็นสีของโครมเท่านั้น
// rgba() ที่อนุญาตรอบนี้: rgba(11,125,40,α) · rgba(10,95,28,α) · rgba(12,58,22,α)
//
// ⚠️ ไฟล์นี้เป็นของแบรนด์ก่อนหน้าทุกรอบ ห้ามเหมาว่าสีที่เจอเป็นของรอบนี้ ต้องเทียบ
// เป็น **"ค่า"** ไม่ใช่ "ตระกูลสี" — **ทอง/เหลืองเคยนำมาแล้วเกือบทุกแบรนด์** การเจอ
// ทองในไฟล์จึงไม่พิสูจน์ว่าเป็นของรอบปัจจุบัน ส่วนเขียวมรกตทั้งสี่ค่าของรอบนี้
// (0b7d28 0f9b35 0a5f1c 0c3a16) ไม่มีแบรนด์ไหนในรีโปเคยใช้เลยสักเฉด
// รอบก่อนหน้าทันที (มีทรัพย์168 ชมพูบานเย็นบนธีมสว่าง) ที่กวาดออกครบแล้วจากไฟล์นี้:
//   dd1b74 a4186b 4a0d35 2d0720 f7dcf6 f0ccf5
//   และ rgba 221/27/116 α) rgba 164/24/107 α) rgba 74/13/53 α)
// แบรนด์เก่ากว่านั้นทั้งหมด (หวยคิง หวย365 ดวงเศรษฐี168 ufalion168 รวยเทพ168
// มีเฮ168 รวยแทร่168 นินจา168 สบายเบท168 ถอนชัวร์168 มีโชค168 ขวัญใจ168 รับตัง168
// สมหวัง168 UFA324 ฯลฯ) อยู่ในตารางของ brand-spec §2 —
// ให้ grep ทีละค่าจากตารางนั้น ห้ามกะด้วยตา
// ⚠️ รอบนี้ **ไม่มีชมพู ไม่มีแดงชาด ไม่มีบรอนซ์ส้ม ไม่มีฟ้า/น้ำเงิน/ไซยาน
// ไม่มีม่วง ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์ และไม่มีทองส้มสด** — เขียวรอบนี้เป็น
// เขียวมรกตอมน้ำเงินเล็กน้อย ไม่ใช่เขียวมะนาวและไม่ใช่เขียวเทียล
// (เฮกซ์ของแบรนด์เก่าในคอมเมนต์ด้านบนเขียนแบบ **ไม่มี #** โดยตั้งใจ เพื่อไม่ให้
// การ sweep ไล่หาสีของแบรนด์เก่าใน src/ สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#0b7d28]/35 bg-white/95 p-8 text-left text-base leading-relaxed text-[#0c3a16] shadow-[0_10px_30px_rgba(12,58,22,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#0b7d28]/70 hover:shadow-[0_15px_40px_rgba(11,125,40,0.25)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#0b7d28]/70 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#0b7d28]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#0b7d28]/40"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#e9fbdd]/90 blur-[60px] transition-all duration-500 group-hover:bg-[#0a5f1c]/25"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="text-2xl leading-normal font-black tracking-widest text-[#0a5f1c] uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#0b7d28] to-[#0a5f1c] shadow-[0_0_10px_rgba(11,125,40,0.45)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
