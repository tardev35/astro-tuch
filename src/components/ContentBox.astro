---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#a3701c]/32 bg-[#1b1206]/92 p-8 text-left text-base leading-relaxed text-[#f1e5cd] shadow-[0_10px_30px_rgba(19,12,1,0.72)] backdrop-blur-xl transition-all duration-500 hover:border-[#cdb98a]/60 hover:shadow-[0_15px_40px_rgba(163,112,28,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#a3701c]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#a3701c]/32"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#7a4f0b]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#cdb98a]/32"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#a3701c]/32 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fff6e0] to-[#a08a5c] shadow-[0_0_10px_rgba(205,185,138,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fff6e0] via-[#cdb98a] to-[#fdcc5c] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
