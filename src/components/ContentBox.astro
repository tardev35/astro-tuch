---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro, /promotion,
// /about-us, /contact-us, /ทางเข้า, /ทดลองเล่น, /login และ /register render ตัว
// เนื้อหาผ่านไฟล์นี้ (10 หน้า) และไม่เคยเดินตาม ContentBox rotation ของ index
// → ไฟล์นี้ต้องถือพาเลตของ "แบรนด์ปัจจุบัน" เสมอ ต่อให้ index เลือก variant อื่น
// ⚠️ รอบนี้ **หน้าแรกไม่ได้ใช้ไฟล์นี้** (docx §1 ไปอยู่ที่ ContentBoxPremium ตาม
// การหมุน variant) แต่ไฟล์นี้ยังเป็น shared chrome เต็มตัวเพราะสิบหน้าข้างบนยังใช้
// ⚠️ หน้าถาวรพวกนั้น **ไม่ประกาศสีตัวอักษรเองเลยสักจุด** ย่อหน้าทั้งหมด inherit สีมา
// จากการ์ดข้างล่าง ถ้าการ์ดไม่ตั้ง text color หน้าเหล่านั้นจะตกไปใช้ default ของ
// เบราว์เซอร์ → คลาส `text-left text-base leading-relaxed text-[#f4eef1]` บน
// element ที่ถือ <slot /> ห้ามหายไปสักตัว
//
// Flattened single-slot variant (ทำเมื่อ 2026-07-26): `isolate` บนการ์ด + `-z-10`
// บนชั้นตกแต่ง absolute ทุกชั้น slot จึง render เป็นลูกตรงของการ์ด
// **ห้ามเพิ่ม wrapper <div> รอบ slot กลับมา** และถ้าจะเปลี่ยนสีตัวอักษรของการ์ด
// ให้ **แทนที่** คลาสสีเดิม ไม่ใช่ใส่คลาสสีที่สองข้างๆ (specificity เท่ากัน ผลจะ
// ขึ้นอยู่กับลำดับที่ Tailwind บังเอิญ emit)
//
// House style เนื้อความ: element ที่ถือ slot ได้ `text-left text-base
// leading-relaxed <สี>` — ห้ามย่อหรือขยายขนาดตัวอักษรของเนื้อความ (คลาส sm/lg
// ของ text-* ใช้กับย่อหน้าไม่ได้) · หัวข้อจัดกลางได้ แต่ต้อง
// ใส่ text-center ที่ตัวหัวข้อเอง **ห้ามใส่บนการ์ดหรือ <section>** เพราะมันจะ
// inherit ลงไปใน slot แล้วทำให้ย่อหน้าของทุกหน้าที่เรียกไฟล์นี้กลางตามไปด้วย
//
// หัวข้อมาจาก prop `title` + `as` เท่านั้น (เป็นหัวข้อจริงของบทความ/หน้านั้นๆ)
// **ห้าม hardcode ข้อความไทยเป็น heading ในไฟล์นี้** — เป็นโครมที่ขึ้นทุกหน้า
//
// ───────────────────────────────────────────────────────────────────────────
// รอบนี้ (มาดาม168) พาเลตตาม .claude/brand-spec-madum168.md §2
// 🚨 **รอบนี้ยังเป็นธีมมืดเหมือนรอบก่อน แต่คนละฮิวสิ้นเชิง** เหตุผล: bg.json ของ
// ดรอปนี้เป็น {"mode":"color","color":"#00091f"} = **น้ำเงินเที่ยงคืนเกือบดำ**
// (รอบก่อนเป็น 0d1017 = ถ่านอมน้ำเงินที่เทากว่านี้มาก) และ bg.json คือแหล่งเดียว
// ของพื้นเพจ **ห้าม "แก้" การ์ดให้เป็นพื้นสว่าง** — การ์ดสว่างบนหมึก #f4eef1
// จะทำให้หน้า terms/privacy/404 ที่พึ่ง BRAND_TEXT ตัวอักษรหายไปเลย ไม่ใช่แค่จางลง
//
// อ่านจากอาร์ตเวิร์กจริง: โลโก้เป็น **ภาพผู้หญิงวัยกลางคนผมสั้นดัดลอนสีขาวเงิน
// ขยิบตา ทาลิปสติกแดง ทำท่ามินิฮาร์ท ตามด้วยคำว่า "มาดาม" ตัวอักษรไทยสามมิติ
// สีฟ้าอมน้ำเงิน และเลข "168" สีแดงสด** ส่วนแบนเนอร์/สไลด์เป็นฉาก **โถงห้าง
// สรรพสินค้าหรูโทนขาว-ดำ หน้าร้านแบรนด์เนมสองฝั่ง พื้นหินขัดสะท้อนเงา**
// ⚠️ **ผมขาวเงิน สูทขาวครีม สูทดำ โซฟาหนัง และสีผิวนักแสดงเป็นวัตถุในภาพ
// ไม่ใช่สี UI** — รอบนี้ไม่มีครีม ไม่มีพีช ไม่มีเบจ ไม่มีแรมป์เทาเงินเลย
//
// บทบาทสีในไฟล์นี้:
//   ผิวการ์ด (กลาง) #0b1733 · ชั้นจม #050e26 · ชั้นยก #16234a · พื้นเพจ #00091f
//   แดงคริมสัน #ff2e52 = **สีหัวข้อ** (4.9:1 บนผิวการ์ดนี้ ผ่าน AA)
//     และเป็นเส้นคาดบนสุด ออรา ขอบ hover และต้นของเส้นใต้หัวข้อ
//     อ่านจากอาร์ตเวิร์กตรงๆ (เลข 168 ในโลโก้ · "เกมสล็อตเปย์แรง" บนแบนเนอร์ ·
//     เลข 0.3% / 0.8% บนสไลด์ · ลิปสติก — เป็นแดงสดทั้งหมด)
//   น้ำเงินอะซัวร์ #1177e8 = **วัสดุที่สองของรอบนี้** (จากคำว่า "มาดาม" ในโลโก้
//     และแคปซูลเรืองแสงใต้แบนเนอร์) ใช้เป็นปลายของเส้นใต้หัวข้อ และออรารอง
//     ⚠️⚠️ **ต่ำกว่า AA บนผิวการ์ด — ห้ามถือตัวอักษรในไฟล์นี้เด็ดขาด**
//   เส้น #2a3c70 = ขอบปกติ (**ห้ามถือตัวอักษร**)
//   หมึก #f4eef1 = สีเนื้อความ (= BRAND_TEXT) 15.7:1 บนผิวการ์ดนี้
// ⚠️⚠️ **#0b1733 #050e26 #16234a #00091f #2a3c70 #1177e8 #0e68cc #0a4ea8 #c9102f
// ห้ามถือตัวอักษร** เป็นสีพื้น/เส้นเท่านั้น ส่วน **#ff2e52 (4.9:1) · #f4eef1
// (15.7:1) · #b3bdd6 (9.5:1) · #d9dfe9 (13.4:1) ถือตัวอักษรได้บนผิวมืดชุดนี้**
// rgba() ที่อนุญาตรอบนี้: rgba(255,46,82,α) · rgba(224,18,56,α) ·
// rgba(201,16,47,α) · rgba(17,119,232,α) · rgba(14,104,204,α) ·
// rgba(10,78,168,α) · rgba(217,223,233,α) · rgba(0,9,31,α) · rgba(0,0,0,α)
//
// ⚠️ ไฟล์นี้เป็นของแบรนด์ก่อนหน้าทุกรอบ ห้ามเหมาว่าสีที่เจอเป็นของรอบนี้ ต้องเทียบ
// เป็น **"ค่า"** ไม่ใช่ "ตระกูลสี"
// รอบก่อนหน้าทันที (นาซ่า168 ฟ้าไซยาน + น้ำเงินอุลตรามารีน บนธีมมืด — **ตัวที่เสี่ยง
// หลงเหลือสูงสุด**) ที่กวาดออกครบแล้วจากไฟล์นี้:
//   1fd8f0 0bb6d4 8fd9ec 1d4fd8 143aa0 e6edf8 9fb2cb 273449 1b2434 121722 33455f
//   0d1017 + rgba(31,216,240) rgba(29,79,216) rgba(143,217,236) rgba(11,182,212)
//   rgba(13,16,23) rgba(51,69,95) rgba(27,36,52)
// 🚨 **ฟ้า/ไซยานเคยนำมาแล้วเจ็ดเจ้าในรีโปนี้** จึงเป็นตระกูลที่อิ่มตัวที่สุด —
// รอบนี้ฟ้าจึงถูกลดชั้นเป็น "วัสดุที่สอง ไม่ถือตัวอักษร" และฮิวนำเป็นแดงคริมสัน
// ซึ่งรอบก่อนไม่มีเลยสักเฉด ค่าฟ้าของแบรนด์อื่นที่ต้องเทียบเป็นค่าทีละตัว:
//   18a5e2 0d6b9b 0a5176 a9d7f2 16294a dbe6ff eef4ff dce9fb 111a3f 202a66 31408a
//   e9f1ff adc0e4 (ร่ำรวย168) · 2cc3fc 6bdcfb 9ae0fa 0a7fbd 063a57 0f3a4a f2fbff
//   dff4fd ccf7ff cdf2ff eafaff a9e3f9 04293d 0a4f74 06293c (สบาย168) ·
//   039cfa 0494f5 c3ebfc 04366b e3f2fc 0b2d52 (รวยแทร่168) ·
//   32bcfb a9e9ff 07335f 0c2a3d 071a28 030e16 041019 dceefc (นินจา168) ·
//   2f9ff5 a8dcff d6ecff 0b3f78 e8f4ff (สบายเบท168) ·
//   0360f3 0292fb 6ec8ff 4fb4ff cfdcec 9db4d4 dde8f7 00081f 102a5e 0a1c42
//   (TSDET911 — ⚠️ 00081f ห่างจากพื้นเพจรอบนี้ 00091f แค่ G1 ซึ่งเป็นความบังเอิญ
//   ของค่าพื้นเกือบดำ ไม่ใช่การสืบทอด: ค่าพื้นรอบนี้มาจาก bg.json ของดรอปนี้)
// ⚠️⚠️ **แดงเป็นฮิวนำรอบนี้ จึงต้องเทียบแดงของแบรนด์เก่าให้แน่นที่สุด:**
//   b3121b f2bba5 c98a74 (ขวัญใจ168) · c30303 8f0505 e81313 4a0f0f ffdbdb fff1ef
//   (รวยแท้168) · fb141b ff5f63 ffa0a2 db040b 8a0609 (GT66B) · eb0305 e40303
//   c20305 9b0a0c ff4446 (โปรดี168) · fa0513 ff5a5f ffadaf (สมหวัง168) ·
//   d9212a 8e1a16 (ดวงเศรษฐี168) · fb1b32 ff8f9c 5c0410 (มีเฮ168) · e4021b
//   (รวยเทพ168) · d30304 a00203 ff6b6e (รับตัง168) · dc0203 f5282a (หวย365) ·
//   dd1b74 a4186b 4a0d35 2d0720 (มีทรัพย์168) · fa63b9 ffb3de (ถอนชัวร์168) ·
//   f5469f ff8dc6 8c0f52 (มีโชค168) · ff3b14 6d0804 2b0000 (FLASH877)
// ⚠️ ทองของแบรนด์เก่าที่ยังต้องกวาด (รอบนี้ไม่มีทองเลย):
//   fbc134 ffe87a cf9a18 96690a d9c9a6 cfd6e3 241700 1a1000 432b03 231500
//   (NAZA168 ตัวละติน) · f5ba14 fcee52 b37c0b (เงินทอง168) · eeae12 fded41 9f600d
//   (พักยก168) · f7c92b ffe6a3 (ขวัญใจ168) · d4922c fdfc71 d39c45 f6e3b4
//   (ufalion168) · e5a81b ffe08a bb8410 7d5a07 (UFA324) · fee45d e6a416 b8780d
//   7a4e05 (ยูฟ้า168) · fef54b 6b5c10 (นินจา168) · fdcb0c fefb6b 8a6504 (สบาย168) ·
//   f9a826 704504 (รวยแทร่168) · ffc82e 5c4a16 (สบายเบท168) · ffd84d 6b4708
//   (ถอนชัวร์168) · e3b23c ffe5a8 8a6210 (สมหวัง168) · dcb95f b8862b 96681f
//   (รวยแท้168) · fcd434 ffeaa0 (มีโชค168) · cd9a2c fdeb7c ab7314 (หวยคิง) ·
//   f0bb4e ffeccb (รวยเทพ168) · fcd45c 6b4a08 (มีเฮ168) · ffdc8c f0b429 (รับตัง168) ·
//   f0c878 (ดวงเศรษฐี168) · f0b46a d9803a (โปรดี168) · ffc93c ffeab0 (หวย365) ·
//   f5b61d b07a06 (PIGPG)
// ⚠️ ครีม/เบจของแบรนด์เก่า: f4e4d3 e4cbb3 (ร่ำรวย168) · ecd5c4 d2b9a4 (เงินทอง168) ·
//   eadfce (ขวัญใจ168) · f5e7c8 fce2d4 (หวยคิง) · f4ead6 d6c6a8 (พักยก168)
//   — **รอบนี้ไม่มีครีมเลย ทั้งที่สูทขาวครีมอยู่ในภาพ เพราะมันเป็นวัตถุในภาพ**
// ⚠️ ผิวมืดของธีมมืดรอบก่อนๆ ที่ต้องไม่สับสนกับ #0b1733/#050e26/#16234a ของรอบนี้:
//   1b2434 121722 273449 0d1017 (นาซ่า168 — **รอบก่อนทันที**) ·
//   29210f 3d3016 332810 201906 2e2512 1b1407 4d3c15 (เงินทอง168) ·
//   0a0908 1e1a13 15130f 0b0d10 (ยูฟ้า168) · 33200a 1f1304 0a0601 1a1000 (ufalion168) ·
//   2c1004 1a0802 401107 (โปรดี168) · 1c0503 2a0806 (PIGPG) ·
//   1f0f04 2f1e0f 4e2f11 291d0f (พักยก168)
// ⚠️ แรมป์เทาเงิน (ผมสีขาวเงินกับสูทขาวในภาพเป็น **วัตถุในภาพ**):
//   e0e0df c0c0bf a1a09e (พักยก168) · e8ecf1 a8b2bf 78828f 5a6472 (ยูฟ้า168) ·
//   8792a0 b9c2cc f0e8d4 464f5a (UFA324) · cfd9e6 (รับตัง168) ·
//   fdfcfd b4bcc2 eceaea (GT66B) — **ห้ามเอากลับเข้ามาเป็นสี UI**
//   รอบนี้มีแพลทินัม #d9dfe9 ตัวเดียว ซึ่งเป็นค่าใหม่ ไม่อยู่ในลิสต์ข้างบน
// แบรนด์เก่ากว่านั้นทั้งหมดอยู่ในตารางของ brand-spec §2 — grep ทีละค่าจากตารางนั้น
// ⚠️ รอบนี้ **ไม่มีทอง ไม่มีเหลือง ไม่มีส้ม ไม่มีเขียว (ยกเว้น LINE green ที่อื่น)
// ไม่มีม่วง ไม่มีโรสโกลด์ ไม่มีน้ำตาล ไม่มีครีม และไม่มีแรมป์เทาเงิน**
// (เฮกซ์ของแบรนด์เก่าในคอมเมนต์ด้านบนเขียนแบบ **ไม่มี #** โดยตั้งใจ เพื่อไม่ให้
// การ sweep ไล่หาสีของแบรนด์เก่าใน src/ สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#2a3c70] bg-[#0b1733]/95 p-8 text-left text-base leading-relaxed text-[#f4eef1] shadow-[0_10px_30px_rgba(0,0,0,0.5)] backdrop-blur-xl transition-all duration-500 hover:border-[#ff2e52] hover:shadow-[0_15px_40px_rgba(255,46,82,0.22)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#ff2e52] to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#ff2e52]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#ff2e52]/40"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#1177e8]/40 blur-[60px] transition-all duration-500 group-hover:bg-[#1177e8]/60"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="text-2xl leading-normal font-black tracking-widest text-[#ff2e52] uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#ff2e52] to-[#1177e8] shadow-[0_0_10px_rgba(255,46,82,0.45)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
