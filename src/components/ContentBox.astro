---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#b6821d]/35 bg-[#0d0b06]/92 p-8 text-left text-base leading-relaxed text-[#f2e6cd] shadow-[0_10px_30px_rgba(245,197,24,0.12)] backdrop-blur-xl transition-all duration-500 hover:border-[#f5c518]/60 hover:shadow-[0_15px_40px_rgba(245,197,24,0.22)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#f5c518]/18 blur-[60px] transition-all duration-500 group-hover:bg-[#f5c518]/28"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#d3d3d3]/18 blur-[60px] transition-all duration-500 group-hover:bg-[#fff2c3]/22"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#b6821d]/35 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fff2c3] to-[#845914] shadow-[0_0_10px_rgba(245,197,24,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#f5c518] via-[#fff2c3] to-[#d3d3d3] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
