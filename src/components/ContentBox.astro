---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// PKG44 (รอบทองเมทัลลิก-เงินโครเมียม-ดำ 2026-09-27): การ์ดดำอมน้ำตาล #12100a ใน
// กรอบทองแบรนด์ #fdd32a ออร่ามุมซ้ายบนเป็นทอง #fdd32a มุมขวาล่างเป็นเงินโครเมียม
// #c2c8d0 — คู่ทอง/เงินนี้มาจากโลโก้ที่ P G 44 เป็นทองและ K เป็นเงินโครเมียม
// หัวข้อจึงไล่ทองอ่อน #ffeeb8 → เงิน #f2f4f7 → ทองแบรนด์ #fdd32a ตามลำดับนั้น
// เนื้อความ #efe6d2 (BRAND_TEXT) — เขียวมรกต #22c55e/#7cf25c/#b6ff9c บนพื้น
// #0a1a0c ของ BRAZIL999 รอบก่อนถูกแทนครบทุกจุดแล้ว แบรนด์นี้ไม่มีเขียวเลย
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#fdd32a]/45 bg-[#12100a]/94 p-8 text-left text-base leading-relaxed text-[#efe6d2] shadow-[0_10px_30px_rgba(8,6,2,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffe27a]/70 hover:shadow-[0_15px_40px_rgba(253,211,42,0.34)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#fdd32a]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#fdd32a]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#ffe27a]/38"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#c2c8d0]/12 blur-[60px] transition-all duration-500 group-hover:bg-[#c2c8d0]/22"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#ffeeb8] via-[#f2f4f7] to-[#fdd32a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#ffeeb8] via-[#f2f4f7] to-[#fdd32a] shadow-[0_0_10px_rgba(253,211,42,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
