---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro, /promotion and
// every button page render their body through this file and never follow the
// per-brand ContentBox rotation, so it must carry the CURRENT brand's colours
// even when index.astro picks another variant. Nothing inside those pages names
// a colour — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// ufalion168 (รอบทองอำพันนำ-ทองเลมอนเฉดสว่าง บนดำสนิท 2026-10-20): พาเลตต์ตาม
// .claude/brand-spec-ufalion168.md §2
// โลโก้อ่านตรงๆ ได้ว่า: **หัวสิงโตทองคำขนแผงฟู สวมมงกุฎทองยอดแหลม** บน
// **ริ้วทองเหลวโค้งสาดกระเซ็น** ล้อมด้วย **ประกายดาวทอง** ใต้ลงมาเป็นคำว่า
// **"ufalion168"** ตัวอักษรหนาสามมิติผิวทองมันวาว โดย **"ufa" กับ "168" ทองเข้ม**
// **"lion" ทองอ่อนกว่า** และ **ตัว o ในคำว่า lion มีมงกุฎทองเล็กอยู่ข้างใน**
// ส่วนแบนเนอร์กับสไลด์เป็นฉาก **สนามบอลกลางคืนพื้นดำ** ที่มีนายแบบ-นางแบบชุดบอล
// ดำ-ทอง ถ้วยแชมเปี้ยนส์ลีกสีเงิน ลูกฟุตบอลดำ-ทอง ธงดำลายดาวฟุตบอลทอง มงกุฎทอง
// เหรียญทอง และมือถือที่เปิดหน้าเว็บ UFABET
//
// ⚠️ รอบนี้ **ทองอำพันนำ ทองเลมอนเป็นเฉดสว่าง บรอนซ์เป็นฮิวที่สาม และบรอนซ์ไหม้
// เป็นเงาที่ไม่เคยถือตัวอักษร** — **เป็นทองสองเฉดล้วน ไม่มีฮิวที่สองที่เป็นคนละวงศ์**
// ต่างจากรอบก่อน (รวยเทพ168 ทองนำ + แดงชาดรอง) **แต่ทองเคยนำมาแล้วเกือบทุกแบรนด์**
// สิ่งที่แยกรอบนี้ออกจากพวกนั้นจึงอยู่ที่ **ค่าสี** กับ **การหมุน variant** ไม่ใช่
// ที่วงศ์สี:
//   ทองนำรอบนี้ #d4922c เป็นทองอำพันน้ำผึ้ง ⚠️ **ตัวที่ใกล้ที่สุดคือ dfa310 ของ
//     TND168** ตัวตัดสินคือ G146 vs G163 และ B44 vs B16 · และไม่ใช่ f0bb4e ของ
//     รอบก่อน (R240 G187 vs R212 G146) · ไม่ใช่ e5a81b ของ UFA324
//   เฉดสว่างรอบนี้ #fdfc71 ⚠️ ใกล้ fef54b ของนินจา168 ตัวตัดสินคือ B113 vs B75
//   ชุดความลึกรอบนี้ #33200a / #1f1304 / #0a0601 ไม่ใช่ 3b1b0e / 260d04 / 0d0501
// ⚠️ พื้นเพจรอบนี้เป็น **ดำสนิท** (bg.json = {"mode":"color","color":"#000000"})
// ซึ่งบังเอิญตรงกับฉากของอาร์ตเวิร์ก แต่ bg.json คือแหล่งเดียวของพื้นเพจ
//
// ทองแบรนด์ #d4922c (อ่านจากขนแผงสิงโต มงกุฎ ริ้วทอง และตัวอักษรบนโลโก้) ถือขอบ
// การ์ด เส้นคาดบนสุด และเป็นปลายของเกรเดียนต์หัวข้อ · ครีมทอง #f6e3b4 เป็นกลางของ
// หัวข้อและสี hover ของขอบ · ทองเลมอน #fdfc71 เป็นต้นของหัวข้อ · บรอนซ์ #a25b24
// อยู่กลางเส้นใต้หัวข้อ **ไม่เคยถือตัวอักษร** เพราะได้แค่ 3.0:1 บนผิวการ์ดนี้ ·
// บรอนซ์ไหม้ #5a3310 เป็นออรามุมขวาล่างกับปลายเข้มของเส้นใต้ ก็ไม่เคยถือตัวอักษร
// ลำดับ เลมอน→ครีม→อำพัน ของหัวข้อคือลำดับที่ตาอ่านงานศิลป์จริง (ไฮไลต์มันวาวบน
// ยอดตัวอักษร → เนื้อทองกลาง → เงาอำพันที่ขอบล่างของตัวอักษร)
// และทั้งสามค่าอยู่ที่ 14.3:1 / 12.3:1 / 5.9:1 บนผิวการ์ดนี้ จึงผ่าน AA
// ทุกจุดของเกรเดียนต์ — ต่างจากบรอนซ์ที่ตก จึงถูกย้ายไปอยู่บนเส้นใต้แทน
// เนื้อความเป็นงาช้างอมเลมอน #fbf6e3 (= BRAND_TEXT) — 14.3:1 บนผิวการ์ดนี้
// ⚠️ ทองอำพันเป็นสีเดียวที่ **สงวนไว้ใช้ไฮไลต์ <strong> ในเนื้อความ**
//
// ⚠️ ไฟล์นี้เป็นของแบรนด์ก่อนหน้าทุกรอบ ห้ามเหมาว่าสีที่เจอเป็นของรอบนี้ ต้องเทียบ
// เป็น "ค่า" ไม่ใช่ "ตระกูลสี" และรอบนี้ **ทองเคยถูกใช้มาแล้วเกือบทุกแบรนด์**
//   ทอง/เหลือง — รวยเทพ168 f0bb4e (+ffeccb d9701a) · มีเฮ168 fcd45c ·
//         รับตัง168 f0b429 (+ffdc8c 9a6c0c) · รวยแทร่168 f9a826 (+704504) ·
//         นินจา168 fef54b (+6b5c10) · สบายเบท168 ffc82e (+5c4a16) ·
//         ถอนชัวร์168 ffd84d · มีโชค168 fcd434 (+ffeaa0) · ขวัญใจ168 f7c92b ·
//         สมหวัง168 e3b23c · KMD88 e2b33f · TND168 dfa310 · KINGKONG555 f2c230 ·
//         UFA324 e5a81b (+ffe08a bb8410)
//   แดง — **ไม่มีในรอบนี้เลย** รวยเทพ168 e4021b · มีเฮ168 fb1b32 (+ff8f9c 5c0410) ·
//         สมหวัง168 fa0513 (+ff5a5f ffadaf b90203 8c0204 5b0203) · รับตัง168
//         d30304 (+ff6b6e a00203 4a0202) · ขวัญใจ168 b3121b (+5a0a0e) ·
//         TKB55 fb131b (+ff4d55 ff8a8f) · GT66B fb141b (+ff5f63 ffa0a2)
//   ฟ้า/น้ำเงิน — **ไม่มีในรอบนี้เลย** รวยแทร่168 039cfa (+c3ebfc 04366b) ·
//         นินจา168 32bcfb (+a9e9ff 07335f) · สบายเบท168 2f9ff5 (+a8dcff d6ecff
//         0b3f78) · HI59 0a84e0 · TSDET911 0360f3 · รับตัง168 cfd9e6 (เงินอมฟ้า)
//   เงิน/โครเมียม — **ไม่มีในรอบนี้เลย** UFA324 8792a0 (+b9c2cc f0e8d4 464f5a)
// ส่วน **ทองรอบนี้คือ #d4922c (+#fdfc71 +#f6e3b4 +#a25b24 +#5a3310)** หมึกบนพื้นถม
// คือ **#1a1000** ชุดความลึกคือ #33200a / #1f1304 / #0a0601 บนพื้นเพจ #000000
// ชุดเต็มของรวยเทพ168 ที่เพิ่งอยู่ในไฟล์นี้ (f0bb4e ffeccb e4021b d9701a 3b1b0e
// 260d04 0d0501 5c2a06 fff8ec 2b1400 และ rgba 240/187/78 α) rgba 228/2/27 α)
// rgba 255/236/203 α) rgba 217/112/26 α)) ออกครบทุกจุดแล้ว เช่นเดียวกับชุดของ
// มีเฮ168 (fb1b32 ff8f9c 5c0410 fcd45c ffeec0 6b4a08 2b0711 1a040a 0c0205 fdeaec
// 1b0308) ของรวยแทร่168 (039cfa 0494f5 c3ebfc 04366b f9a826 704504 e3f2fc 0b2d52
// 071e38 030f1d 031320) ของนินจา168 (32bcfb a9e9ff 07335f fef54b 6b5c10 0c2a3d
// 071a28 030e16 041019 dceefc) ของสบายเบท168 (2f9ff5 a8dcff d6ecff 0b3f78 ffc82e
// 5c4a16 e8f4ff 0e2238 081726 040d16 04121f) ของถอนชัวร์168 (fa63b9 ffb3de ffd84d
// 2b0f20 1a0914 0d040a 6d0b3f 6b4708 2a0617 fdeaf5) ของมีโชค168 (fcd434 ffeaa0
// f5469f ff8dc6 8c0f52 7a5508 1a0612 f6e4ee 24101c 160a12 0b0509) ของขวัญใจ168
// (f7c92b ffe6a3 f2bba5 c98a74 b3121b 5a0a0e 8a5f12 eadfce 140c06 241509 160d06
// 0b0603) ของรับตัง168 (f0b429 ffdc8c d30304 ff6b6e a00203 4a0202 9a6c0c cfd9e6
// f5ece0 2b100f 200a09 140505 1a0505) ของสมหวัง168 (fa0513 ffadaf ff5a5f e3b23c
// ffe5a8 8a6210 b90203 8c0204 5b0203 3c0303 170504 f4ecea ccb9b6 2c1413 1f0d0c
// 140706 290f0f) ของ UFA324 (e5a81b ffe08a bb8410 7d5a07 43300a 17130a 312713
// 0d0b06 140d01 8792a0 f0e8d4 b9c2cc 464f5a) ของ TKB55 (fb131b ff8a8f ff4d55
// e9eef4 aeb9c6 f2e4e5 2a0d0f 1a0708 0d0304 c40304 8a0206 53050a 1a0304) และของ
// GT66B (fb141b ff5f63 ffa0a2 db040b ec151c 8a0609 3b0405 fdfcfd b4bcc2 eceaea
// 190505 1c0c0b 130c0c 0b0303)
// ⚠️ **รอบนี้ไม่มีแดง ไม่มีฟ้า/น้ำเงิน ไม่มีม่วง ไม่มีเขียว ไม่มีเงิน/โครเมียม
// ไม่มีโรสโกลด์ ไม่มีส้มสด และไม่มีชมพู/ฟูเชีย** บรอนซ์ #a25b24 เป็นเฉดเงาของทอง
// ไม่ใช่ส้มอิสระ และถือตัวอักษรไม่ได้
// (เฮกซ์ของแบรนด์เก่าในคอมเมนต์ด้านบนเขียนแบบ **ไม่มี #** โดยตั้งใจ เพื่อไม่ให้
// การ sweep ไล่หาสีของแบรนด์เก่าใน src/ สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#d4922c]/45 bg-[#33200a]/95 p-8 text-left text-base leading-relaxed text-[#fbf6e3] shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#f6e3b4]/70 hover:shadow-[0_15px_40px_rgba(212,146,44,0.35)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#d4922c]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#d4922c]/40 blur-[60px] transition-all duration-500 group-hover:bg-[#f6e3b4]/30"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#5a3310]/80 blur-[60px] transition-all duration-500 group-hover:bg-[#a25b24]/45"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#fdfc71] via-[#f6e3b4] to-[#d4922c] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#d4922c] via-[#a25b24] to-[#5a3310] shadow-[0_0_10px_rgba(212,146,44,0.65)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
