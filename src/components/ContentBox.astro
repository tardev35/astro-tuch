---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// BOOM369 (รอบเขียวนีออนบนการ์ดมืด 2026-10-07): เว็บสล็อตเบทต่ำ พาเลตต์ตาม
// brand-spec §2 รอบนี้สลับขั้วกลับจาก HI59 ซึ่งเป็นแบรนด์สว่างตัวแรกของเทมเพลต —
// การ์ดกลับมาเป็นกระจกเขียวเข้ม #07170f เพราะ bg.json ของดรอปนี้เป็น #000000
// และงานศิลป์ทั้งชุด (โลโก้ แบนเนอร์ สไลด์) เป็นห้องโถงมืดที่ส่องด้วยไฟนีออนเขียว
//
// เขียวนีออน #42fb5a มาจาก vivid อันดับ 1 ของ logo.webp (ตัวอักษร BOOM) ถือขอบ
// การ์ด เส้นคาดบนสุด และออรามุมซ้ายบน · เงินโครเมียม #dadcdc มาจาก dominant
// อันดับ 2 ของไฟล์เดียวกัน (ตัวเลข 369) เป็นปลายไล่เฉดของหัวข้อ · ทอง #f3c44a
// (เหรียญ/ชิปในภาพ) ใช้เป็นออรามุมขวาล่างเท่านั้น ไม่ใช่สีแบรนด์ตัวที่สอง
// เนื้อความเป็นเขียวอ่อนนวล #cfe9d7 (= BRAND_TEXT) — 13.5:1 บนผิวการ์ดนี้
//
// ชุดฟ้า-ทองบนการ์ดสว่างของ HI59 (#f6fbff #9ecbf2 #0d2744 #0a84e0 #065a9c
// #06355f #5ec2ff #fdbc04 #ffe27a #c88a02) ออกครบทุกจุดแล้ว — รอบนี้ไม่ใช่การ
// เปลี่ยนเบอร์สีบนโครงเดิม แต่เป็นการพลิกจากการ์ดสว่างกลับเป็นการ์ดมืด เงาจึง
// กลับไปเป็นเงาดำทึบ บวกเรืองนีออนตอน hover แทนเงาฟ้าอ่อน
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#42fb5a]/30 bg-[#07170f]/95 p-8 text-left text-base leading-relaxed text-[#cfe9d7] shadow-[0_10px_30px_rgba(0,0,0,0.55)] backdrop-blur-xl transition-all duration-500 hover:border-[#42fb5a]/70 hover:shadow-[0_15px_40px_rgba(66,251,90,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#42fb5a]/70 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#04ab3a]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#42fb5a]/50">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#f3c44a]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#f3c44a]/35">
    </div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#42fb5a] via-[#8dffa0] to-[#dadcdc] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#42fb5a] via-[#04ab3a] to-[#f3c44a] shadow-[0_0_10px_rgba(66,251,90,0.55)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
