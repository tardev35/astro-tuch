---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// หวย24 (รอบแดงแบรนด์ + ทอง บนดำอมแดง 2026-10-04): เว็บแทงหวย
// พาเลตต์ตาม brand-spec §2 — แดงแบรนด์ #d20a0a มาจาก vivid ของ logo.webp ถือ
// ออรามุมซ้ายบน ทองแบรนด์ #f5c33b (ตัวอักษร หวย24 บนแบนเนอร์เป็นทองโลหะ)
// ถือกรอบและออรามุมขวาล่าง ทองสว่าง #ffd45e เป็นไฮไลต์/hover แดงสว่าง #ff5c5c
// เป็นปลายไล่เฉดหัวข้อ ซึ่งจับคู่กับวงกลม "24" สีแดงในโลโก้โดยตรง
// การ์ดเป็นผิวยก #170707 เนื้อความ #f7e2d6 (= BRAND_TEXT)
// glow ทุกจุดเป็น rgba(210,10,10,…) / rgba(245,195,59,…)
//
// ชุดทองโลหะ + ครีมอมพีชของแบรนด์ก่อน (#cd9a2c #fdeb7c #ab7314 #fcd4c3 #fce2d4
// #1c140b #f5e7c8 rgba(205,154,44)) ออกครบทุกจุดแล้ว — รอบนี้สีหลักคือแดง ไม่ใช่ทอง
// ทองถูกลดบทบาทลงเป็นสีรอง จึงไม่ใช่การยกค่าเดิมมาเปลี่ยนแค่เบอร์
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#f5c33b]/50 bg-[#170707]/95 p-8 text-left text-base leading-relaxed text-[#f7e2d6] shadow-[0_10px_30px_rgba(0,0,0,0.78)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffd45e]/75 hover:shadow-[0_15px_40px_rgba(210,10,10,0.35)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#f5c33b]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#d20a0a]/35 blur-[60px] transition-all duration-500 group-hover:bg-[#ff5c5c]/45">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#f5c33b]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#ffd45e]/32">
    </div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#ffd45e] via-[#f5c33b] to-[#ff5c5c] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#ffd45e] via-[#f5c33b] to-[#d20a0a] shadow-[0_0_10px_rgba(245,195,59,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
