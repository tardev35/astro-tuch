---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro, /promotion,
// /about-us, /contact-us, /ทางเข้า, /ทดลองเล่น, /login และ /register render ตัว
// เนื้อหาผ่านไฟล์นี้ (10 หน้า) และไม่เคยเดินตาม ContentBox rotation ของ index
// → ไฟล์นี้ต้องถือพาเลตของ "แบรนด์ปัจจุบัน" เสมอ ต่อให้ index เลือก variant อื่น
// ⚠️ หน้าพวกนั้น **ไม่ประกาศสีตัวอักษรเองเลยสักจุด** ย่อหน้าทั้งหมด inherit สีมา
// จากการ์ดข้างล่าง ถ้าการ์ดไม่ตั้ง text color หน้าเหล่านั้นจะตกไปใช้ default ของ
// เบราว์เซอร์ → คลาส `text-left text-base leading-relaxed text-[#4a0f0f]` บน
// element ที่ถือ <slot /> ห้ามหายไปสักตัว
//
// Flattened single-slot variant (ทำเมื่อ 2026-07-26): `isolate` บนการ์ด + `-z-10`
// บนชั้นตกแต่ง absolute ทุกชั้น slot จึง render เป็นลูกตรงของการ์ด
// **ห้ามเพิ่ม wrapper <div> รอบ slot กลับมา** และถ้าจะเปลี่ยนสีตัวอักษรของการ์ด
// ให้ **แทนที่** คลาสสีเดิม ไม่ใช่ใส่คลาสสีที่สองข้างๆ (specificity เท่ากัน ผลจะ
// ขึ้นอยู่กับลำดับที่ Tailwind บังเอิญ emit)
//
// House style เนื้อความ: element ที่ถือ slot ได้ `text-left text-base
// leading-relaxed <สี>` — ห้ามย่อหรือขยายขนาดตัวอักษรของเนื้อความ (คลาส sm/lg
// ของ text-* ใช้กับย่อหน้าไม่ได้) · หัวข้อจัดกลางได้ แต่ต้อง
// ใส่ text-center ที่ตัวหัวข้อเอง **ห้ามใส่บนการ์ดหรือ <section>** เพราะมันจะ
// inherit ลงไปใน slot แล้วทำให้ย่อหน้าของทุกหน้าที่เรียกไฟล์นี้กลางตามไปด้วย
//
// หัวข้อมาจาก prop `title` + `as` เท่านั้น (เป็นหัวข้อจริงของบทความ/หน้านั้นๆ)
// **ห้าม hardcode ข้อความไทยเป็น heading ในไฟล์นี้** — เป็นโครมที่ขึ้นทุกหน้า
//
// ───────────────────────────────────────────────────────────────────────────
// รอบ 2026-10-21 (รวยแท้168) พาเลตตาม .claude/brand-spec-ruaythear168vip.md §2
// ⚠️⚠️ **นี่คือแบรนด์ "ธีมสว่าง" รอบที่สามของรีโปนี้ — การ์ดยังเป็นผิวสว่างหมึกเข้ม**
// เหตุผล: bg.json ของดรอปนี้เป็น {"mode":"color","color":"#ffdbdb"} = **ชมพูกุหลาบ
// สว่าง** ไม่ใช่ดำสนิท และ bg.json คือแหล่งเดียวของพื้นเพจ
// **ห้าม "แก้" การ์ดกลับไปเป็นพื้นเข้มเพราะ "รอบก่อนๆ เป็นแบบนั้น"** — การ์ดเข้ม
// บนพื้นชมพูกุหลาบสว่างจะทำให้หน้า terms/privacy/404 ที่พึ่ง BRAND_TEXT
// (= หมึกแดงเลือดหมู #4a0f0f) กลายเป็นหมึกเข้มบนพื้นเข้มทันที
//
// อ่านจากอาร์ตเวิร์กจริง: โลโก้เป็น **คำว่า "รวยแท้" ตัวอักษรไทยสามมิติผิวมันวาว
// สีแดงคริมสัน ขอบทองหนา** ต่อด้วย **เลข "168" สามมิติผิวทองขัดเงา** ส่วน
// แบนเนอร์/สไลด์เป็นฉาก **วัดไทย/พระบรมมหาราชวังแดดจัด เจดีย์และปรางค์ปิดทอง
// ดอกบัวขาว คู่ชาย-หญิงชุดไทยถือสลากกินแบ่งรัฐบาล**
//
// บทบาทสีในไฟล์นี้:
//   ผิวการ์ด (ยก) #ffffff · ชั้นกลาง/อินเซ็ต #fff1ef · พื้นเพจ #ffdbdb
//   แดงสด #c30303 = ขอบการ์ด เส้นคาดบนสุด ออรา และต้นของเส้นใต้หัวข้อ
//     (6.3:1 บนผิวการ์ดขาว → ใช้กับเส้น ออรา หัวข้อ และตัวหนาได้)
//   แดงเข้ม #8f0505 = ปลายเข้มของเส้นใต้ และสีไฮไลต์ <strong> (9.6:1)
//   หมึกแดงเลือดหมู #4a0f0f = เนื้อความ (= BRAND_TEXT) 15.4:1 บนผิวการ์ดนี้
//
// ⚠️⚠️ **#ffdbdb และ #fff1ef ห้ามถือตัวอักษรบนพื้นขาวเด็ดขาด** เป็นสีพื้น/เส้น
// เท่านั้น และ **#e81313 ห้ามถือตัวอักษรและห้ามเป็นพื้นของตัวอักษร** (4.0:1)
// เป็น stop ของไล่เฉด/ออราได้อย่างเดียว — สีไฮไลต์ <strong> ในเนื้อความมีตัวเดียว
// คือ **แดงเข้ม #8f0505** ถ้าต้องการตัวอักษรที่อ่านว่า "แดงสด" ให้ **ถม
// #c30303 เป็นพื้นแล้ววาง #ffffff ทับ** (6.3:1 ผ่าน AA)
// ⚠️⚠️ **ทองโบราณทั้งสามค่า (dcb95f b8862b 96681f) ห้ามใช้ในไฟล์นี้เลยสักจุด** — บนผิว
// การ์ดขาวได้แค่ 1.9 / 3.5 / 2.8:1 ตกเกณฑ์ทุกค่า ทองเป็นสีของโครมเท่านั้น
// rgba() ที่อนุญาตรอบนี้: rgba(195,3,3,α) · rgba(143,5,5,α) · rgba(74,15,15,α)
//
// ⚠️ ไฟล์นี้เป็นของแบรนด์ก่อนหน้าทุกรอบ ห้ามเหมาว่าสีที่เจอเป็นของรอบนี้ ต้องเทียบ
// เป็น **"ค่า"** ไม่ใช่ "ตระกูลสี" — **แดงนำมาแล้วหลายแบรนด์ในรีโปนี้มากกว่าฮิวอื่นใด**
// การเจอแดงในไฟล์จึงไม่พิสูจน์ว่าเป็นของรอบปัจจุบัน ค่าที่ใกล้ที่สุดคือ d30304
// (รับตัง168 ห่าง 16) และ b90203 (สมหวัง168 ห่าง 10) — ใกล้กว่าปกติ แต่รับไว้
// โดยตั้งใจเพราะ #c30303 คือค่า vivid ที่วัดได้จาก logo.webp เอง
// รอบก่อนหน้าทันที (สาธุ168 เขียวมรกตบนธีมสว่าง) ที่กวาดออกครบแล้วจากไฟล์นี้:
//   0b7d28 0a5f1c 0f9b35 0c3a16 061f0c c9cb63 aeb04a 9ba03c d8ffc7 e9fbdd
//   และ rgba 11/125/40 α) rgba 10/95/28 α) rgba 12/58/22 α) rgba 174/176/74 α)
// แบรนด์เก่ากว่านั้นทั้งหมด (หวยคิง หวย365 ดวงเศรษฐี168 ufalion168 รวยเทพ168
// มีเฮ168 รวยแทร่168 นินจา168 สบายเบท168 ถอนชัวร์168 มีโชค168 ขวัญใจ168 รับตัง168
// สมหวัง168 มีทรัพย์168 UFA324 ฯลฯ) อยู่ในตารางของ brand-spec §2 —
// ให้ grep ทีละค่าจากตารางนั้น ห้ามกะด้วยตา
// ⚠️ รอบนี้ **ไม่มีเขียว (ยกเว้น LINE green ที่อื่น) ไม่มีชมพูบานเย็น ไม่มีฟ้า/
// น้ำเงิน/ไซยาน ไม่มีม่วง ไม่มีเงิน/โครเมียม และไม่มีโรสโกลด์**
// (เฮกซ์ของแบรนด์เก่าในคอมเมนต์ด้านบนเขียนแบบ **ไม่มี #** โดยตั้งใจ เพื่อไม่ให้
// การ sweep ไล่หาสีของแบรนด์เก่าใน src/ สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#c30303]/35 bg-white/95 p-8 text-left text-base leading-relaxed text-[#4a0f0f] shadow-[0_10px_30px_rgba(74,15,15,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#c30303]/70 hover:shadow-[0_15px_40px_rgba(195,3,3,0.25)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#c30303]/70 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#c30303]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#c30303]/40"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#fff1ef]/90 blur-[60px] transition-all duration-500 group-hover:bg-[#8f0505]/25"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="text-2xl leading-normal font-black tracking-widest text-[#c30303] uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#c30303] to-[#8f0505] shadow-[0_0_10px_rgba(195,3,3,0.45)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
