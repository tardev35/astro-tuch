---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// UP555 (รอบทอง + เงินโครเมียม บนดำอมน้ำตาล 2026-10-03): คาสิโนอัปเดตล่าสุด
// พาเลตต์มาจาก logo.webp ที่เป็นสองโทนจริง — ตัว U กับ UP เป็นเงินโครเมียม
// (dominant #d5d4d3 #dcdcdb #f3f3f2) ส่วนลูกศร วงรี และเลข 555 เป็นทอง
// (vivid #ebbb54 #fce675 #ab6d24) — บนแบนเนอร์ที่พื้นเป็นดำอมน้ำตาล
// (dominant #130b03 #030102 #1b130c) แบรนด์นี้จึงเป็น "ทองนำ เงินโครเมียมรอง
// บนดำอมน้ำตาล" — ทองแบรนด์ #ebbb54 ถือกรอบและออรามุมซ้ายบน เงินโครเมียม
// #d5d4d3 ถือออรามุมขวาล่าง (คู่เดียวกับที่ตาเห็นบนโลโก้: 555 ทอง / UP เงิน)
// การ์ดเป็นดำอมน้ำตาล #130b03 หัวข้อไล่เฉดทองสว่าง #fce675 → ทองแบรนด์ #ebbb54 →
// เงินโครเมียม #d5d4d3 เนื้อความ #f8eed9 (BRAND_TEXT)
//
// รอบก่อน (DM899) เป็นเขียวมรกต-แดงสด-ทอง บนดำอมเขียว ชุดเดิมทั้งชุด (#01a326
// #4ade6b #12c23a #fb252b #ff6b6e #0a1a0e #ffe9a8 #f2b422 #e4f2e4) ออกครบทุกจุดแล้ว
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#ebbb54]/55 bg-[#130b03]/95 p-8 text-left text-base leading-relaxed text-[#f8eed9] shadow-[0_10px_30px_rgba(0,0,0,0.78)] backdrop-blur-xl transition-all duration-500 hover:border-[#fce675]/75 hover:shadow-[0_15px_40px_rgba(235,187,84,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#ebbb54]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#ebbb54]/28 blur-[60px] transition-all duration-500 group-hover:bg-[#fce675]/40"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#d5d4d3]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#f3f3f2]/32"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#fce675] via-[#ebbb54] to-[#d5d4d3] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#fce675] via-[#ebbb54] to-[#d5d4d3] shadow-[0_0_10px_rgba(235,187,84,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
