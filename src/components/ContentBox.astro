---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#5e0505]/80 bg-[#120404]/92 p-8 text-left text-base leading-relaxed text-[#f2e3c9] shadow-[0_10px_30px_rgba(7,2,2,0.7)] backdrop-blur-xl transition-all duration-500 hover:border-[#fdd121]/60 hover:shadow-[0_15px_40px_rgba(239,22,34,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#ef1622]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#ef1622]/32"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#fdd121]/16 blur-[60px] transition-all duration-500 group-hover:bg-[#fdd121]/26"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#5e0505]/80 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdd121] to-[#b00a12] shadow-[0_0_10px_rgba(253,209,33,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe98a] via-[#ff2a36] to-[#b00a12] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
