---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// SEXYGAME666 (รอบชมพูนีออน-ม่วง-ดำ 2026-09-28): การ์ดดำอมม่วง #0f0518 ในกรอบ
// ชมพูบานเย็นแบรนด์ #fa42b5 ออร่ามุมซ้ายบนเป็นชมพู #fa42b5 มุมขวาล่างเป็นม่วง
// แบรนด์ #8b3df3 — คู่ชมพู/ม่วงนี้มาจากโลโก้ที่ SEXY เป็นชมพูบานเย็นและ GAME ไล่ไป
// เป็นม่วง หัวข้อจึงไล่ชมพูอ่อน #ffb3e2 → ชมพูแบรนด์ #fa42b5 → ม่วงแบรนด์ #8b3df3
// ตามลำดับตัวอักษร เนื้อความ #f2dcee (BRAND_TEXT) — ชุดทอง/เขียวของ PGW44 รอบก่อน
// (#fde90e #fff89a #35d413 #0b1408 #e9f0dd) ถูกแทนครบทุกจุดแล้ว
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#fa42b5]/45 bg-[#0f0518]/94 p-8 text-left text-base leading-relaxed text-[#f2dcee] shadow-[0_10px_30px_rgba(4,1,8,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#8b3df3]/70 hover:shadow-[0_15px_40px_rgba(250,66,181,0.34)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#fa42b5]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#fa42b5]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#ffb3e2]/38"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#8b3df3]/16 blur-[60px] transition-all duration-500 group-hover:bg-[#8b3df3]/28"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#ffb3e2] via-[#fa42b5] to-[#8b3df3] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#ffb3e2] via-[#fa42b5] to-[#8b3df3] shadow-[0_0_10px_rgba(250,66,181,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
