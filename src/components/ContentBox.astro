---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro and privacy.astro render every section
// through this file and never follow the per-brand ContentBox rotation, so it
// must carry the CURRENT brand's colours even when index.astro picks another
// variant. Nothing inside those pages names a colour — they inherit from the
// card below, which is what keeps them brand-neutral.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the two
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// MHEEPOOH168: การ์ดแดงเข้มเกือบดำ #190505 ขอบแดงเลือดหมู #8f0505 ออร่าสองมุม
// เป็นแดงสดกับทองสว่าง #fced74 หัวข้อไล่จากทองสว่าง → ทองกลาง #f5b70a →
// แดงสด #c4161c ซึ่งเป็นคู่สีของโลโก้ (ตัวอักษรทองบนพื้นแดง)
// เส้นทองพาดขอบบนการ์ดกับขีดสั้นใต้หัวข้อยังคงไว้จากรอบก่อน เปลี่ยนแต่โทนสี
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#8f0505]/55 bg-[#190505]/94 p-8 text-left text-base leading-relaxed text-[#f1dccd] shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#f5b70a]/60 hover:shadow-[0_15px_40px_rgba(143,5,5,0.4)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#f5b70a]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#c4161c]/30 blur-[60px] transition-all duration-500 group-hover:bg-[#c4161c]/42"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#fced74]/12 blur-[60px] transition-all duration-500 group-hover:bg-[#fced74]/22"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#fced74] via-[#f5b70a] to-[#c4161c] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#fced74] to-[#8f0505] shadow-[0_0_10px_rgba(245,183,10,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
