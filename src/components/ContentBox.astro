---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// GUCCI168 (รอบตรุษจีน แดง-เขียวมรกต-ทอง 2026-10-08): เว็บคาสิโนไลฟ์ 24 ชม.
// พาเลตต์ตาม brand-spec §3 รอบนี้พลิกจากทองเมทัลลิก-เงินโครเมียมของ UOK365 มาเป็น
// ชุดสามสี — การ์ดยังเป็นกระจกมืดเหมือนเดิมแต่เป็นผิวเกือบดำอมแดง #140705 เพราะ
// bg.json ของดรอปนี้เป็น gradient แดงเลือดหมู -> ทองเข้ม และงานศิลป์ทั้งชุด
// (โลโก้ แบนเนอร์ สไลด์) เป็นซุ้มจีนเขียวมรกตกับโคมแดงและเหรียญทอง
//
// แดงแบรนด์ #c41115 มาจาก vivid ของ logo.webp (#ba0204/#b41313) ปรับให้สว่างพอ
// เป็นเส้นขอบได้ ถือขอบการ์ด เส้นคาดบนสุด และออรามุมซ้ายบน · เขียวมรกต #0b7a33
// มาจากหมวกของเทพเจ้าโชคลาภและซุ้มประตูในแบนเนอร์ เป็นฮิวที่สองจริง ไม่ใช่สีเน้น
// ชั่วคราว อยู่ที่ออรามุมขวาล่าง · ทองอ่อน/แชมเปญ #ffdf91 กับทองแบรนด์ #d9a521
// เป็นโลหะคั่นในไล่เฉดหัวข้อและเส้นใต้ ส่วนทองลึก #8c6410 เป็นปลายเข้มของเส้นนั้น
// เนื้อความเป็นงาช้างอมอุ่น #f6e3cf (= BRAND_TEXT) — 15.1:1 บนผิวการ์ดนี้
//
// ชุดทอง-เงินของ UOK365 (#c8912f #f5d98a #a46b25 #6d4412 #120c07 #d8dbe0 #ece1cc
// rgba(200,145,47,α)) ออกครบทุกจุดแล้ว
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#c41115]/35 bg-[#140705]/95 p-8 text-left text-base leading-relaxed text-[#f6e3cf] shadow-[0_10px_30px_rgba(0,0,0,0.6)] backdrop-blur-xl transition-all duration-500 hover:border-[#c41115]/75 hover:shadow-[0_15px_40px_rgba(196,17,21,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#d9a521]/75 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#c41115]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#e0201f]/50">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#0b7a33]/35 blur-[60px] transition-all duration-500 group-hover:bg-[#2bbf63]/30">
    </div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#ffdf91] via-[#e0201f] to-[#2bbf63] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#ffdf91] via-[#d9a521] to-[#8c6410] shadow-[0_0_10px_rgba(217,165,33,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
