---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// PIGPG (รอบแดงแล็กเกอร์-ทองแบบตรุษจีน 2026-10-09): ฐานเข้าเล่นสล็อตเว็บหลัก
// พาเลตต์ตาม brand-spec §2 รอบนี้พลิกจากคู่ "มรกต-ทอง" ของ KOON234 มาเป็นคู่
// "แดง-ทอง" — การ์ดยังเป็นกระจกมืดเหมือนเดิมแต่ย้ายจากผิวเขียวเกือบดำ #0d2414
// มาเป็นผิวแดงเกือบดำ #3a0d07 ซึ่งเข้มกว่าพื้นเพจของดรอปนี้ที่เป็น
// {"mode":"gradient","css":"linear-gradient(180deg, #6b0000, #7a4100)"} =
// แดงเลือดหมูไล่ลงน้ำตาลอำพัน การ์ดจึง "จม" ลงจากพื้นแทนที่จะยกขึ้น ให้ทอง
// ที่อยู่บนการ์ดอ่านเป็นโลหะวาวอีกชั้น
//
// ทองแบรนด์ #f5b61d มาจากเหรียญทองและก้อนทองที่เต็มทั้งแบนเนอร์และสไลด์
// ถือขอบการ์ด เส้นคาดบนสุด และเงาตอน hover · ทองสว่าง #ffd87a เป็นปลายสว่างของ
// ไล่เฉดหัวข้อและออรามุมขวาล่างตอน hover · ครีมงาช้าง #fdf9e4 (vivid อันดับหนึ่ง
// ของ logo.webp = ตัวอักษร PIGPG) เป็นปลายสว่างสุด · แดงสด #d4200d (vivid ของ
// banner1/slide1 = ป้ายแล็กเกอร์และโคมแดง) เป็นฮิวที่สองจริง อยู่ที่ออรามุมซ้ายบน
// และปลายอุ่นของไล่เฉดหัวข้อ — ไม่เคยถือตัวอักษรเพราะได้แค่ 3.5:1 บนผิวนี้ ·
// ทองเข้ม #b07a06 กับแดงเข้ม #6b0402 เป็นปลายเข้มของเส้นใต้และออรา
// เนื้อความเป็นครีมอมส้มอ่อน #fdeedd (= BRAND_TEXT) — 14.8:1 บนผิวการ์ดนี้
//
// ชุดมรกต-ทองของ KOON234 (#0a6b32 #2fbf6a #043d1c #cc920a #f7d14e #fde9a6
// #8a6204 #0d2414 #e8f2e6 rgba(204,146,10,α)) ชุดฟ้า-เหลืองของ แตกดี168
// (#0193fb #fce604 #0a1726 #dbeafe) และชุดทองเมทัลลิกของ 789BETTING
// (#fad354 #ffe79a #ddab33 #c9881f #17130a #f3e7cd) ออกครบทุกจุดแล้ว — ทองของ
// รอบนี้เป็นคนละค่า อย่าปล่อยของเก่าไว้เพราะ "ดูคล้ายกัน"
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#f5b61d]/35 bg-[#3a0d07]/95 p-8 text-left text-base leading-relaxed text-[#fdeedd] shadow-[0_10px_30px_rgba(0,0,0,0.6)] backdrop-blur-xl transition-all duration-500 hover:border-[#f5b61d]/75 hover:shadow-[0_15px_40px_rgba(245,182,29,0.32)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#f5b61d]/75 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#d4200d]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#d4200d]/35"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#b07a06]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#ffd87a]/28"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#fdf9e4] via-[#ffd87a] to-[#f5b61d] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#ffd87a] via-[#f5b61d] to-[#6b0402] shadow-[0_0_10px_rgba(245,182,29,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
