---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro, /promotion and
// every button page render their body through this file and never follow the
// per-brand ContentBox rotation, so it must carry the CURRENT brand's colours
// even when index.astro picks another variant. Nothing inside those pages names
// a colour — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// ถอนชัวร์168 (รอบชมพูบับเบิลกัมนำ-ทองเนยรอง บนดำสนิท 2026-10-18): พาเลตต์ตาม
// .claude/brand-spec-tonchua168.md §2
// โลโก้อ่านตรงๆ ได้ว่า: **แมวการ์ตูนขนขาวแก้มชมพู** หน้ายิ้มหลับตา นั่งหลังมือถือ
// จอชมพูที่มีลูกศรดาวน์โหลดและปึกแบงก์ชมพู อยู่เหนือคำว่า "ถอน" ซึ่งเป็นตัวอักษรไทย
// หนาสามมิติ **สีทองเนยตัดขอบชมพู** ต่อด้วย "ชัวร์168" **สีชมพูบับเบิลกัมตัดขอบทอง**
// ล้อมด้วยหัวใจชมพูและประกายดาวทอง ส่วนแบนเนอร์กับสไลด์เป็นฉากพื้นดำที่มีหญิงสาว
// ผมเงินในชุดชมพูปักทอง มือถือจอชมพูขึ้นคำว่า ถอนสำเร็จ ปึกแบงก์ชมพู กองเหรียญทอง
// และริบบิ้นซาตินชมพูพลิ้วทั่วภาพ
//
// ⚠️ รอบนี้ **ชมพูบับเบิลกัมนำ ทองเนยเป็นฮิวที่สอง พลัมเข้มเป็นเงาที่ไม่เคยถือ
// ตัวอักษร** — **กลับด้านกับรอบก่อน (มีโชค168: ทองนำ + ชมพูบานเย็นเป็นตัวรอง)**
// ต่างจากรอบก่อนหน้านั้นอีก (ขวัญใจ168: ทองนำ + โรสโกลด์ · รับตัง168: ทองนำ +
// แดงสด · สมหวัง168: แดงนำ)
// **การที่ชมพูขึ้นมานำคือสิ่งเดียวที่แยกรอบนี้ออกจากรอบที่แล้วจริงๆ** จึงต้องเห็นได้
// บนการ์ดใบนี้ ไม่ใช่แค่เขียนไว้ในสเปก — มันถือต้นหัวข้อ ขอบการ์ด เส้นคาดบนสุด
// และออรามุมซ้ายบน ส่วนทองเลื่อนไปเป็นปลายหัวข้อกับสี hover ของขอบ
// ⚠️ พื้นเพจรอบนี้เป็น **ดำสนิท** (bg.json = {"mode":"color","color":"#000000"})
// ลำดับความลึกเป็นพลัมอมชมพูที่เข้มกว่าเดิมหนึ่งสเต็ป: #2b0f20 ผิวยก (การ์ดใบนี้) /
// #1a0914 กลาง / #0d040a จม / #000000 พื้น — คนละชุดกับ 24101c 160a12 0b0509
// ของรอบก่อน
//
// ชมพูแบรนด์ #fa63b9 (อ่านจากตัวอักษรโลโก้กับริบบิ้นซาติน) ถือขอบการ์ดและเส้นคาด
// บนสุด · ชมพูอ่อน #ffb3de เป็นต้นของหัวข้อ · ทองเนย #ffd84d เป็นปลายหัวข้อ สี
// hover ของขอบ และเป็นตัวที่ **สงวนไว้ใช้ไฮไลต์ <strong> ในเนื้อความเท่านั้น** ·
// พลัมเข้ม #6d0b3f กับทองลึก #6b4708 เป็นออรามุมขวาล่างกับปลายเข้มของเส้นใต้ —
// สองตัวหลังไม่เคยถือตัวอักษร
// ลำดับ ชมพูอ่อน→ชมพูบับเบิลกัม→ทองเนย ของหัวข้อคือลำดับที่ตาอ่านงานศิลป์จริง
// (ตัวอักษร "ชัวร์168" ชมพูเป็นตัวหลัก ไล่ออกไปหาเส้นขอบทองรอบตัวอักษร) และทั้งสาม
// ค่าอยู่ที่ 10.7:1 / 6.6:1 / 12.7:1 บนผิวการ์ดนี้ จึงผ่าน AA ทุกจุดของเกรเดียนต์
// เนื้อความเป็นครีมอมชมพู #fdeaf5 (= BRAND_TEXT) — 15.3:1 บนผิวการ์ดนี้
//
// ⚠️ ไฟล์นี้เป็นของแบรนด์ก่อนหน้าทุกรอบ ห้ามเหมาว่าสีที่เจอเป็นของรอบนี้ ต้องเทียบ
// เป็น "ค่า" ไม่ใช่ "ตระกูลสี" และรอบนี้กับดักมีสองชั้น เพราะ **รอบที่แล้วก็มีทั้ง
// ทองและชมพูอยู่ในไฟล์นี้**
//   ทอง — มีโชค168 fcd434 (+ffeaa0) · ขวัญใจ168 f7c92b · รับตัง168 f0b429 ·
//         สมหวัง168 e3b23c · KMD88 e2b33f · TND168 dfa310 · KINGKONG555 f2c230
//   ชมพู — มีโชค168 f5469f (+ff8dc6) · PUNPRO168 f41571 (+ff5ca8) · FAH999 ชมพู-ทอง
// ส่วน **ชมพูรอบนี้คือ #fa63b9 (+#ffb3de)** และ **ทองรอบนี้คือ #ffd84d**
// ชุดเต็มของมีโชค168 (fcd434 ffeaa0 f5469f ff8dc6 8c0f52 7a5508 1a0612 f6e4ee
// 24101c 160a12 0b0509 และ rgba 252/212/52 α) rgba 245/70/159 α)
// rgba 255/141/198 α) rgba 140/15/82 α)) ออกครบทุกจุดแล้ว
// เช่นเดียวกับชุดของขวัญใจ168 (f7c92b ffe6a3 f2bba5 c98a74 b3121b 5a0a0e 8a5f12
// eadfce 140c06 241509 160d06 0b0603) ของรับตัง168 (f0b429 ffdc8c d30304 ff6b6e
// a00203 4a0202 9a6c0c cfd9e6 f5ece0 2b100f 200a09 140505 1a0505) ของสมหวัง168
// (fa0513 ffadaf ff5a5f e3b23c ffe5a8 8a6210 b90203 8c0204 5b0203 3c0303 170504
// f4ecea ccb9b6 2c1413 1f0d0c 140706 290f0f) ของ TKB55 (fb131b ff8a8f ff4d55
// e9eef4 aeb9c6 f2e4e5 2a0d0f 1a0708 0d0304 c40304 8a0206 53050a 1a0304) และของ
// GT66B (fb141b ff5f63 ffa0a2 db040b ec151c 8a0609 3b0405 fdfcfd b4bcc2 eceaea
// 190505 1c0c0b 130c0c 0b0303)
// ค่าของแบรนด์เก่ากว่านั้นที่เคยผ่านไฟล์นี้ — TSDET911 น้ำเงินไฟฟ้า · KMD88 ม่วง
// ราชา-ทอง · TND168 ทองมังกร · WEPLAY168 ม่วงนีออน · PUNPRO168 ชมพูฮอตพิงก์ ·
// 789BETTING ทองเมทัลลิก · TIGERWIN369 ทองอำพัน · UFA324 ทองแชมเปี้ยน ·
// FAH999 ชมพู-ทอง · DUCK1688 ทองเป็ด · NAZA168 ทองอวกาศ · KINGKONG555 เขียว-ทอง
// — ไม่เหลือในไฟล์นี้แล้วเช่นกัน (ไม่พิมพ์ค่าซ้ำที่นี่ รายการเต็มอยู่ใน
// brand-spec §2 เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive ในไฟล์ที่ render)
// ⚠️ **รอบนี้ไม่มีม่วง ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว ไม่มีส้ม ไม่มีเงิน/โครเมียม
// อมฟ้า ไม่มีโรสโกลด์ และไม่มีแดงชาด**
//
// ⚠️ #6d0b3f และ #6b4708 ห้ามถือตัวอักษรทุกขนาด อยู่ได้เฉพาะในไล่เฉดของเส้นคาด
// ในออรา และเป็นขอบ ส่วน #ffd84d (12.7:1) #ffb3de (10.7:1) และ #fa63b9 (6.6:1)
// ถือตัวอักษรรองได้จริง
// (เฮกซ์ของแบรนด์เก่าในคอมเมนต์ด้านบนเขียนแบบ **ไม่มี #** โดยตั้งใจ เพื่อไม่ให้
// การ sweep ไล่หาสีของแบรนด์เก่าใน src/ สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#fa63b9]/45 bg-[#2b0f20]/95 p-8 text-left text-base leading-relaxed text-[#fdeaf5] shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffd84d]/70 hover:shadow-[0_15px_40px_rgba(250,99,185,0.35)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#fa63b9]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#fa63b9]/40 blur-[60px] transition-all duration-500 group-hover:bg-[#ffb3de]/30"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#6d0b3f]/80 blur-[60px] transition-all duration-500 group-hover:bg-[#6b4708]/45"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#ffb3de] via-[#fa63b9] to-[#ffd84d] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#fa63b9] via-[#ffd84d] to-[#6d0b3f] shadow-[0_0_10px_rgba(250,99,185,0.65)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
