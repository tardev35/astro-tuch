---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// PGW44 (รอบทอง-เขียว-ดำ 2026-09-27): การ์ดดำอมเขียว #0b1408 ในกรอบทองแบรนด์
// #fde90e ออร่ามุมซ้ายบนเป็นทอง #fde90e มุมขวาล่างเป็นเขียวแบรนด์ #35d413 —
// คู่ทอง/เขียวนี้มาจากโลโก้ที่ P G เป็นทองและ W 44 ไล่ไปเป็นเขียว หัวข้อจึงไล่
// ทองอ่อน #fff89a → ทองแบรนด์ #fde90e → เขียวแบรนด์ #35d413 ตามลำดับตัวอักษร
// เนื้อความ #e9f0dd (BRAND_TEXT) — ชุดทอง/เงินโครเมียมของ PKG44 รอบก่อน
// (#fdd32a #ffe27a #c2c8d0 #efe6d2 #12100a) ถูกแทนครบทุกจุดแล้ว
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#fde90e]/45 bg-[#0b1408]/94 p-8 text-left text-base leading-relaxed text-[#e9f0dd] shadow-[0_10px_30px_rgba(3,6,2,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#35d413]/70 hover:shadow-[0_15px_40px_rgba(253,233,14,0.34)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#fde90e]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#fde90e]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#fff89a]/38"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#35d413]/16 blur-[60px] transition-all duration-500 group-hover:bg-[#35d413]/28"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#fff89a] via-[#fde90e] to-[#35d413] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#fff89a] via-[#fde90e] to-[#35d413] shadow-[0_0_10px_rgba(253,233,14,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
