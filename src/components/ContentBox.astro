---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#a37c4b]/32 bg-[#141210]/92 p-8 text-left text-base leading-relaxed text-[#e8ddc8] shadow-[0_10px_30px_rgba(11,9,6,0.72)] backdrop-blur-xl transition-all duration-500 hover:border-[#c7b895]/60 hover:shadow-[0_15px_40px_rgba(163,124,75,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#a37c4b]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#a37c4b]/32"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#7d5c31]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#c7b895]/32"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#a37c4b]/32 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f7f1e4] to-[#9a8a68] shadow-[0_0_10px_rgba(199,184,149,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#f7f1e4] via-[#c7b895] to-[#e4cc95] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
