---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// MAHAGAME66 (รอบแดง-ดำ-เงินโครเมียม 2026-09-24): การ์ดเกือบดำ #16090a ในกรอบ
// แดงแบรนด์ #de161d ออร่าสองมุมเป็นแดง #de161d กับเงินโครเมียม #e2e8ef หัวข้อ
// ไล่จากเงินโครเมียม #e2e8ef → แดงสว่าง #ff4d52 → แดงแบรนด์ #de161d ตามลำดับสี
// ในโลโก้ที่คำว่า MAHA เป็นเงิน-ดำ แล้ว GAME เป็นแดง ก่อนกลับมาเป็น 66 สีเงิน
// เนื้อความ #e8e3e1 (BRAND_TEXT) — ทอง #fcdc2b/#fff6ae/#a87d0c เขียว #1fae1c
// พื้น #0d2312/#07130a และครีม #e8e4c6 ของ 888PARUAY รอบก่อนถูกแทนครบทุกจุดแล้ว
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#de161d]/45 bg-[#16090a]/94 p-8 text-left text-base leading-relaxed text-[#e8e3e1] shadow-[0_10px_30px_rgba(8,5,6,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#ff4d52]/70 hover:shadow-[0_15px_40px_rgba(222,22,29,0.34)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#de161d]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#de161d]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#ff4d52]/38"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#e2e8ef]/12 blur-[60px] transition-all duration-500 group-hover:bg-[#e2e8ef]/20"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#e2e8ef] via-[#ff4d52] to-[#de161d] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#e2e8ef] via-[#ff4d52] to-[#de161d] shadow-[0_0_10px_rgba(222,22,29,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
