---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// 888PARUAY (รอบทอง-เขียว-แดง 2026-09-24): การ์ดเขียวเข้มเกือบดำ #0d2312 ใน
// กรอบทองแบรนด์ #fcdc2b ออร่าสองมุมเป็นทอง #fcdc2b กับเขียวสด #1fae1c หัวข้อ
// ไล่จากทองอ่อน #fff6ae → ทองหลัก #fcdc2b → แดง #cf1111 ตามลำดับสีในโลโก้ที่
// วงแหวนเป็นทอง เลข 888 เป็นเขียว แล้ว PARUAY เป็นแดง เนื้อความ #e8e4c6
// (BRAND_TEXT) — ทอง #fadc64, ครีม #f0ddc4 และพื้นแดง #1a0709/#120406 ของ
// 365LOTTO รอบก่อนถูกแทนครบทุกจุดแล้ว
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#fcdc2b]/45 bg-[#0d2312]/94 p-8 text-left text-base leading-relaxed text-[#e8e4c6] shadow-[0_10px_30px_rgba(7,19,10,0.8)] backdrop-blur-xl transition-all duration-500 hover:border-[#fff6ae]/70 hover:shadow-[0_15px_40px_rgba(252,220,43,0.34)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#fcdc2b]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#fcdc2b]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#fff6ae]/38"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#1fae1c]/24 blur-[60px] transition-all duration-500 group-hover:bg-[#1fae1c]/36"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#fff6ae] via-[#fcdc2b] to-[#cf1111] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#fff6ae] via-[#fcdc2b] to-[#1fae1c] shadow-[0_0_10px_rgba(252,220,43,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
