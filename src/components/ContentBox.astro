---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// KINGDOM66 (รอบทอง-ดำ 2026-09-25): การ์ดดำอมน้ำตาล #151109 ในกรอบทองแบรนด์
// #e6bf4e ออร่าสองมุมเป็นทอง #e6bf4e กับครีมอุ่น #efe6cf หัวข้อไล่จากครีม
// #efe6cf → ทองสว่าง #f2d683 → ทองแบรนด์ #e6bf4e ตามลำดับสีในโลโก้ที่คำว่า
// KINGDOM ไล่ทองอ่อนไปเข้ม ก่อนจบที่เลข 66 สีทองเต็ม เนื้อความ #ebe3d3
// (BRAND_TEXT) — ทอง #e0b429 กับเงินโครเมียมเย็น #dfe4ec บนพื้น #161106 ของ
// UWIN33 รอบก่อนถูกแทนครบทุกจุดแล้ว แบรนด์นี้ไม่มีสีเงินเย็นอยู่เลย
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#e6bf4e]/45 bg-[#151109]/94 p-8 text-left text-base leading-relaxed text-[#ebe3d3] shadow-[0_10px_30px_rgba(5,4,3,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#f2d683]/70 hover:shadow-[0_15px_40px_rgba(230,191,78,0.34)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#e6bf4e]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#e6bf4e]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#f2d683]/38"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#efe6cf]/12 blur-[60px] transition-all duration-500 group-hover:bg-[#efe6cf]/20"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#efe6cf] via-[#f2d683] to-[#e6bf4e] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#efe6cf] via-[#f2d683] to-[#e6bf4e] shadow-[0_0_10px_rgba(230,191,78,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
