---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro, /promotion and
// every button page render their body through this file and never follow the
// per-brand ContentBox rotation, so it must carry the CURRENT brand's colours
// even when index.astro picks another variant. Nothing inside those pages names
// a colour — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// รวยเทพ168 (รอบทองจักรพรรดินำ-แดงชาดรอง บนดำสนิท 2026-10-20): พาเลตต์ตาม
// .claude/brand-spec-ruaythep168.md §2
// โลโก้อ่านตรงๆ ได้ว่า: คำว่า **"รวย"** เป็นตัวอักษรไทยหนาสามมิติ **สีทองไล่เฉด**
// ต่อด้วย **"เทพ"** **สีขาวมุกตัดขอบเทา** และ **"168"** **สีแดงชาดผิวมันวาว**
// ทางซ้ายเป็น **เทพเจ้าแห่งโชคลาภจีนหัวเราะ สวมหมวกปีกทองแต่งแดง** นั่งบน
// **ริ้วทองโค้ง** ล้อมด้วย **ประกายดาวสีทอง** บนพื้นดำ ส่วนแบนเนอร์กับสไลด์เป็นฉาก
// **พื้นดำ** ที่มีหญิงสาวผมบลอนด์เงินชุดขาว-แดงประดับทองยื่นมือมาทางผู้ชม
// ตู้สล็อต 777 ไพ่เอซโพแดง ชิปคาสิโนแดง-ขาว หัวใจแดง เหรียญทองร่วง มงกุฎทอง และ
// กล่องของขวัญสีแดง
//
// ⚠️ รอบนี้ **ทองจักรพรรดินำ แดงชาดเป็นฮิวที่สอง ทองแดงเป็นฮิวที่สาม และน้ำตาลไหม้
// เป็นเงาที่ไม่เคยถือตัวอักษร** — รอบนี้ **กลับขั้วจากรอบก่อน** (มีเฮ168 แดงนำ
// ทองเนยรอง) **แต่ทองเคยนำมาแล้วเกือบทุกแบรนด์ และแดงเคยนำมาแล้วสี่แบรนด์**
// สิ่งที่แยกรอบนี้ออกจากพวกนั้นจึงอยู่ที่ **ค่าสี** กับ **การหมุน variant** ไม่ใช่
// ที่วงศ์สี:
//   ทองรอบนี้ #f0bb4e เป็นทองน้ำผึ้ง ⚠️ **R เท่ากับ f0b429 ของรับตัง168 เป๊ะ**
//     ตัวตัดสินคือ B78 vs B41 · และไม่ใช่ fcd45c ของรอบก่อน (G212 vs G187)
//   ฮิวที่สองรอบนี้ #e4021b ไม่ใช่ fb1b32 ของรอบก่อน ไม่ใช่ fa0513 ของสมหวัง168
//   ชุดความลึกรอบนี้ #3b1b0e / #260d04 / #0d0501 ไม่ใช่ 2b0711 / 1a040a / 0c0205
// ⚠️ พื้นเพจรอบนี้เป็น **ดำสนิท** (bg.json = {"mode":"color","color":"#000000"})
// ซึ่งบังเอิญตรงกับฉากของอาร์ตเวิร์ก แต่ bg.json คือแหล่งเดียวของพื้นเพจ
//
// ทองแบรนด์ #f0bb4e (อ่านจากตัวอักษร รวย บนโลโก้ มงกุฎ เหรียญ และริ้วทอง) ถือขอบ
// การ์ด เส้นคาดบนสุด และเป็นกลางของเกรเดียนต์หัวข้อ · ครีมทอง #ffeccb เป็นต้นของ
// หัวข้อและสี hover ของขอบ · ทองแดง #d9701a เป็นปลายหัวข้อ · แดงชาด #e4021b
// อยู่กลางเส้นใต้หัวข้อ **ไม่เคยถือตัวอักษร** เพราะได้แค่ 3.2:1 บนผิวการ์ดนี้ ·
// บรอนซ์ลึก #5c2a06 เป็นออรามุมขวาล่างกับปลายเข้มของเส้นใต้ ก็ไม่เคยถือตัวอักษร
// ลำดับ ครีม→ทอง→ทองแดง ของหัวข้อคือลำดับที่ตาอ่านงานศิลป์จริง (ไฮไลต์มันวาวบน
// ตัวอักษร → เนื้อทองของคำว่า รวย → เงาทองแดงที่ขอบล่างของตัวอักษร)
// และทั้งสามค่าอยู่ที่ 13.4:1 / 8.8:1 / 4.7:1 บนผิวการ์ดนี้ จึงผ่าน AA
// ทุกจุดของเกรเดียนต์ — ต่างจากแดงที่ตก จึงถูกย้ายไปอยู่บนเส้นใต้แทน
// เนื้อความเป็นงาช้างอุ่น #fff8ec (= BRAND_TEXT) — 14.7:1 บนผิวการ์ดนี้
// ⚠️ ทองเป็นสีเดียวที่ **สงวนไว้ใช้ไฮไลต์ <strong> ในเนื้อความ**
//
// ⚠️ ไฟล์นี้เป็นของแบรนด์ก่อนหน้าทุกรอบ ห้ามเหมาว่าสีที่เจอเป็นของรอบนี้ ต้องเทียบ
// เป็น "ค่า" ไม่ใช่ "ตระกูลสี" และรอบนี้ **ทั้งทองและแดงเคยถูกใช้มาแล้วหลายแบรนด์**
//   ทอง/เหลือง — มีเฮ168 fcd45c · รับตัง168 f0b429 (+ffdc8c 9a6c0c) ·
//         รวยแทร่168 f9a826 (+704504) · นินจา168 fef54b (+6b5c10) · สบายเบท168
//         ffc82e (+5c4a16) · ถอนชัวร์168 ffd84d · มีโชค168 fcd434 (+ffeaa0) ·
//         ขวัญใจ168 f7c92b · สมหวัง168 e3b23c · KMD88 e2b33f · TND168 dfa310 ·
//         KINGKONG555 f2c230 · UFA324 e5a81b
//   แดง — มีเฮ168 fb1b32 (+ff8f9c 5c0410) · สมหวัง168 fa0513 (+ff5a5f ffadaf
//         b90203 8c0204 5b0203) · รับตัง168 d30304 (+ff6b6e a00203 4a0202) ·
//         ขวัญใจ168 b3121b (+5a0a0e) · TKB55 fb131b (+ff4d55 ff8a8f) ·
//         GT66B fb141b (+ff5f63 ffa0a2)
//   ฟ้า/น้ำเงิน — **ไม่มีในรอบนี้เลย** รวยแทร่168 039cfa (+c3ebfc 04366b) ·
//         นินจา168 32bcfb (+a9e9ff 07335f) · สบายเบท168 2f9ff5 (+a8dcff d6ecff
//         0b3f78) · HI59 0a84e0 · TSDET911 0360f3 · รับตัง168 cfd9e6 (เงินอมฟ้า)
// ส่วน **ทองรอบนี้คือ #f0bb4e (+#ffeccb +#d9701a +#5c2a06)** และ **แดงรอบนี้คือ
// #e4021b** หมึกบนพื้นถมคือ **#2b1400** ชุดความลึกคือ #3b1b0e / #260d04 /
// #0d0501 บนพื้นเพจ #000000
// ชุดเต็มของมีเฮ168 ที่เพิ่งอยู่ในไฟล์นี้ (fb1b32 ff8f9c 5c0410 fcd45c ffeec0
// 6b4a08 2b0711 1a040a 0c0205 fdeaec 1b0308 และ rgba 251/27/50 α) rgba
// 252/212/92 α) rgba 255/143/156 α) rgba 92/4/16 α)) ออกครบทุกจุดแล้ว
// เช่นเดียวกับชุดของรวยแทร่168 (039cfa 0494f5 c3ebfc 04366b f9a826 704504 e3f2fc
// 0b2d52 071e38 030f1d 031320) ของนินจา168 (32bcfb a9e9ff 07335f fef54b 6b5c10
// 0c2a3d 071a28 030e16 041019 dceefc) ของสบายเบท168 (2f9ff5 a8dcff d6ecff 0b3f78
// ffc82e 5c4a16 e8f4ff 0e2238 081726 040d16 04121f) ของถอนชัวร์168 (fa63b9 ffb3de
// ffd84d 2b0f20 1a0914 0d040a 6d0b3f 6b4708 2a0617 fdeaf5) ของมีโชค168 (fcd434
// ffeaa0 f5469f ff8dc6 8c0f52 7a5508 1a0612 f6e4ee 24101c 160a12 0b0509) ของ
// ขวัญใจ168 (f7c92b ffe6a3 f2bba5 c98a74 b3121b 5a0a0e 8a5f12 eadfce 140c06
// 241509 160d06 0b0603) ของรับตัง168 (f0b429 ffdc8c d30304 ff6b6e a00203 4a0202
// 9a6c0c cfd9e6 f5ece0 2b100f 200a09 140505 1a0505) ของสมหวัง168 (fa0513 ffadaf
// ff5a5f e3b23c ffe5a8 8a6210 b90203 8c0204 5b0203 3c0303 170504 f4ecea ccb9b6
// 2c1413 1f0d0c 140706 290f0f) ของ TKB55 (fb131b ff8a8f ff4d55 e9eef4 aeb9c6
// f2e4e5 2a0d0f 1a0708 0d0304 c40304 8a0206 53050a 1a0304) และของ GT66B (fb141b
// ff5f63 ffa0a2 db040b ec151c 8a0609 3b0405 fdfcfd b4bcc2 eceaea 190505 1c0c0b
// 130c0c 0b0303)
// ⚠️ **รอบนี้ไม่มีฟ้า/น้ำเงิน ไม่มีม่วง ไม่มีเขียว ไม่มีเงิน/โครเมียม ไม่มี
// โรสโกลด์ ไม่มีเหลืองมะนาว และไม่มีชมพู/ฟูเชีย** ส้มตัวเดียวที่อนุญาตคือทองแดง
// #d9701a ซึ่งเป็นเฉดเงาของทอง ไม่ใช่ส้มอิสระ
// (เฮกซ์ของแบรนด์เก่าในคอมเมนต์ด้านบนเขียนแบบ **ไม่มี #** โดยตั้งใจ เพื่อไม่ให้
// การ sweep ไล่หาสีของแบรนด์เก่าใน src/ สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#f0bb4e]/45 bg-[#3b1b0e]/95 p-8 text-left text-base leading-relaxed text-[#fff8ec] shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffeccb]/70 hover:shadow-[0_15px_40px_rgba(240,187,78,0.35)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#f0bb4e]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#f0bb4e]/40 blur-[60px] transition-all duration-500 group-hover:bg-[#ffeccb]/30"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#5c2a06]/80 blur-[60px] transition-all duration-500 group-hover:bg-[#d9701a]/45"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#ffeccb] via-[#f0bb4e] to-[#d9701a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#f0bb4e] via-[#e4021b] to-[#5c2a06] shadow-[0_0_10px_rgba(240,187,78,0.65)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
