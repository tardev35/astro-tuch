---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#062d94]/50 bg-[#040e22]/92 p-8 text-left text-base leading-relaxed text-[#dce9ff] shadow-[0_10px_30px_rgba(14,110,251,0.12)] backdrop-blur-xl transition-all duration-500 hover:border-[#0e6efb]/60 hover:shadow-[0_15px_40px_rgba(14,110,251,0.24)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#0e6efb]/18 blur-[60px] transition-all duration-500 group-hover:bg-[#0e6efb]/28"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#e6e8ec]/14 blur-[60px] transition-all duration-500 group-hover:bg-[#e6e8ec]/22"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#062d94]/50 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#7db4ff] to-[#032058] shadow-[0_0_10px_rgba(14,110,251,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#0e6efb] via-[#7db4ff] to-[#e6e8ec] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
