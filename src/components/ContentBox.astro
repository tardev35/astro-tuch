---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro, /promotion,
// /about-us, /contact-us, /ทางเข้า, /ทดลองเล่น, /login และ /register render
// ตัวเนื้อหาผ่านไฟล์นี้ (10 หน้ารอบนี้) และไม่เคยเดินตาม ContentBox rotation ของ index
// → ไฟล์นี้ต้องถือพาเลตของ "แบรนด์ปัจจุบัน" เสมอ **ห้ามปล่อยให้หลุดจากชุดที่
// retheme ใน P1 เด็ดขาด** — เป็นจุดที่พลาดง่ายที่สุด เพราะ grep หา "ไฟล์ที่ index
// import" อาจไม่เจอไฟล์นี้ (รอบนี้ index **ไม่ได้ใช้ไฟล์นี้เลยสักบล็อก** เพราะ
// shape-mix หมุนไปใช้ Premium/Neumorphism/FloatingBadge/CyberCut ทั้งชุด แต่สถานะ
// shared chrome ของมัน **ไม่ได้ขึ้นกับข้อนั้นเลย** — สิบหน้าข้างบนใช้อยู่ไม่ว่า
// index จะเลือก variant ไหน)
// ⚠️ รอบนี้ /ตรวจหวย และ /แนวทาง **ยังอยู่ใน src/pages-disabled/ ตามเดิม**
// (แบรนด์นี้เป็นเว็บคาสิโนเน้นบาคาร่า บรีฟไม่มีคำว่าหวยเลยสักคำ)
// ⚠️ หน้าถาวรพวกนั้น **ไม่ประกาศสีตัวอักษรเองเลยสักจุด** ย่อหน้าทั้งหมด inherit สีมา
// จากการ์ดข้างล่าง ถ้าการ์ดไม่ตั้ง text color หน้าเหล่านั้นจะตกไปใช้ default ของ
// เบราว์เซอร์ → คลาสชุด text-left + text-base + leading-relaxed + สีหมึกของรอบนี้
// บน element ที่ถือ <slot /> ห้ามหายไปสักตัว (รอบนี้สีหมึกคือ fdf0e6)
// ⚠️ เขียนชื่อคลาสสีแบบถอดวงเล็บโดยตั้งใจ — Tailwind สแกนไฟล์นี้แบบ plain text
// รวมถึงคอมเมนต์ด้วย การพิมพ์คลาสสีเต็มรูปในคอมเมนต์จึงทำให้ยูทิลิตี้ของค่านั้น
// ถูก generate ลง stylesheet จริง (เคยเจอค่าของแบรนด์ก่อนหลุดมาทางนี้)
//
// Flattened single-slot variant (ทำเมื่อ 2026-07-26): isolate บนการ์ด + -z-10
// บนชั้นตกแต่ง absolute ทุกชั้น slot จึง render เป็นลูกตรงของการ์ด
// **ห้ามเพิ่ม wrapper <div> รอบ slot กลับมา** และถ้าจะเปลี่ยนสีตัวอักษรของการ์ด
// ให้ **แทนที่** คลาสสีเดิม ไม่ใช่ใส่คลาสสีที่สองข้างๆ (specificity เท่ากัน ผลจะ
// ขึ้นอยู่กับลำดับที่ Tailwind บังเอิญ emit)
//
// House style เนื้อความ: element ที่ถือ slot ได้ text-left + text-base +
// leading-relaxed + สี — ห้ามย่อหรือขยายขนาดตัวอักษรของเนื้อความ · หัวข้อจัดกลางได้
// แต่ต้องใส่ text-center ที่ตัวหัวข้อเอง **ห้ามใส่บนการ์ดหรือ <section>** เพราะมันจะ
// inherit ลงไปใน slot แล้วทำให้ย่อหน้าของทุกหน้าที่เรียกไฟล์นี้กลางตามไปด้วย
//
// หัวข้อมาจาก prop title + as เท่านั้น (เป็นหัวข้อจริงของบทความ/หน้านั้นๆ)
// **ห้าม hardcode ข้อความไทยเป็น heading ในไฟล์นี้** — เป็นโครมที่ขึ้นทุกหน้า
//
// ────────────────────────────────────────────────────────────────────────────
// รอบนี้ (WIN8S) พาเลตตาม .claude/brand-spec-win8s.md §2
// 🚨🚨 **กลับทิศ 180° จากรอบก่อนอีกครั้ง: รอบนี้การ์ดเป็นผิวเข้ม ไม่ใช่การ์ดสว่าง**
// เหตุผล: bg.json ของดรอปนี้เป็น mode color + color **1e0101 = ดำอมเลือดหมู**
// (รอบก่อน 123BET เป็น f7e4e9 = ชมพูบลัชจาง ซึ่งอยู่คนละปลายของสเกล)
// และ bg.json คือแหล่งเดียวของพื้นเพจ
// ⚠️⚠️ **รอบนี้มืดทั้งเว็บ** ทั้งเนื้อหาและโครม การ์ดนี้เป็น 2a0a04 ซึ่งสว่างกว่า
// พื้นเพจ 1e0101 เล็กน้อยพอให้แยกชั้นได้
// **ห้าม "แก้" การ์ดกลับไปเป็นผิวสว่างตามรอบก่อน** — การ์ดสว่างกับหมึก fdf0e6
// จะทำให้หน้า terms/privacy/404 ที่พึ่ง BRAND_TEXT ตัวอักษรหายไปเลย ไม่ใช่แค่จางลง
//
// อ่านจากอาร์ตเวิร์กจริง: เวิร์ดมาร์กเป็น **ตัวอักษรสามมิติ สี่ตัวแรกผิวส้มเพลิง
// ไล่เป็นทองตัดขอบดำมีไฮไลต์ขาววาบ ตัวสุดท้ายผิวโครเมียมเงินขัดเงา วางบนรอยพู่กัน
// สีดำและแถบสีทองสาด** ส่วนแบนเนอร์เป็นฉาก **ห้องญี่ปุ่นโทนขาวงาช้าง กิ่งซากุระ
// ชมพู-ขาว หญิงสาวในกิโมโนแดง-ดำปักทอง กองชิปคาสิโนดำ-ทอง และไพ่เอซ**
// ตราสัญลักษณ์มุมบนขวาเป็น **โล่พื้นเข้มที่มีมงกุฎทอง เสาโทริอิ และมังกร**
// ⚠️ **ผนังห้องสีขาวงาช้างและสีผิวของนางแบบเป็นวัตถุในภาพ ไม่ใช่สี UI** —
// พื้นเพจมาจาก bg.json เท่านั้น **ห้ามอนุมานจากรูป** (รอบนี้รูปสว่างแต่เว็บมืด)
//
// บทบาทสีในไฟล์นี้:
//   ผิวการ์ด 2a0a04 · ชั้นยก 3b130b · เส้นบาง 5a2410 · ขอบตกแต่ง/ออรา 8a3a12
//   พื้นเพจ 1e0101 · โครม 250604 / 140302
//   ส้มเพลิง f27a1a = **สีหัวข้อ** (6.6:1 บนการ์ด ผ่าน AA สบาย) และเป็นสีของ
//     ลิงก์กับ <strong> ทั้งเว็บ
//   หมึก fdf0e6 = สีเนื้อความ (= BRAND_TEXT) 16.4:1 บนการ์ด · หมึกรอง e0bda4 (10.5:1)
//   ทองอำพัน e5a92b (8.8:1) และเงินโครเมียม c9d2dc (12.0:1) ถือตัวอักษรบนการ์ดได้
// 🚨🚨 **5a2410 · 8a3a12 — ห้ามเป็นสีตัวอักษรในไฟล์นี้เด็ดขาด**
//   เป็นเส้น/ขอบ/ออรา/พื้นถมเท่านั้น
// ⚠️⚠️ **1e0101 2a0a04 3b130b 5a2410 8a3a12 250604 140302 เป็นผิว ไม่ใช่สีตัวอักษร**
// ส่วน **fdf0e6 (16.4:1) · c9d2dc (12.0:1) · e0bda4 (10.5:1) · e5a92b (8.8:1) ·
// f27a1a (6.6:1) ถือตัวอักษรบนการ์ดเข้มได้ทั้งหมด**
// rgba() ที่อนุญาตรอบนี้: rgba(242,122,26,α) · rgba(229,169,43,α) ·
// rgba(138,58,18,α) · rgba(30,1,1,α) · rgba(20,3,2,α)
//
// ⚠️ ไฟล์นี้เป็นของแบรนด์ก่อนหน้าทุกรอบ ห้ามเหมาว่าสีที่เจอเป็นของรอบนี้ ต้องเทียบ
// เป็น **"ค่า"** ไม่ใช่ "ตระกูลสี"
// 🚨🚨 **กับดักรอบนี้: ZNOVA168 เป็นแบรนด์ น้ำตาลเข้ม/อำพัน = ตระกูลสีเดียวกับ
// รอบนี้เป๊ะ** รองลงมาคือ MEXICANOSLOT (แดง/ทอง/ครีม) และ TEVA69 (ทอง)
// → **"เจอส้มหรือทอง ไม่ได้แปลว่าเป็นของรอบนี้"** ต้องเทียบให้ตรงหกหลัก
// ค่าที่กวาดออกครบแล้วจากไฟล์นี้ (ของ 123BET รอบก่อนทันที):
//   f7e4e9 fdf5f6 f7dfe4 eec3cc d98fa0 330710 1c050b 4d0c18 36080f 6b2b33
//   a30d1a 7a4a0c dca53a d2d7dd 8a1420 c21325 ef4a5e
//   + rgba(163,13,26) rgba(220,165,58) rgba(217,143,160) rgba(54,8,15)
// **ลิสต์เฮกซ์เต็มของทุกแบรนด์อยู่ที่ .claude/brand-spec-win8s.md §2 —
// ไม่ซ้ำลงที่นี่โดยตั้งใจ** ลิสต์เดียวที่อัปเดตที่เดียวย่อมไม่หลุดกันเอง
//   ⚠️⚠️ คู่ที่ต้องสงสัยว่าพิมพ์ผิดก่อนเสมอ:
//   e8a000 d4922c e3a712 e0b03a e9b53c dca53a ↔ e5a92b ·
//   c23400 f2543f e2855c ff5a5f ↔ f27a1a/e8620e ·
//   0e0602 2b1608 1a0709 330710 1c050b ↔ 140302/250604/2a0a04 ·
//   7a3a0c 6a4a30 7a4a0c ↔ 8a3a12/5a2410 ·
//   d8dde6 8f9aa8 cfd6e3 c6cfd2 d2d7dd ↔ c9d2dc ·
//   fdeee2 e8fbe4 eef7f0 fdf5f6 ↔ fdf0e6
// ⚠️ (เขียว 00B900 ของปุ่ม LINE และเขียว success ของฟีดถอนเงินอยู่ไฟล์อื่น
//   **คงไว้ ห้ามเปลี่ยนเป็นส้มตามพาเลตรอบนี้** — สองค่านั้นเป็นสีเชิงความหมาย
//   ไม่ใช่สีแบรนด์)
// (เฮกซ์ของแบรนด์เก่าในคอมเมนต์ด้านบนเขียนแบบ **ไม่มี #** โดยตั้งใจ เพื่อไม่ให้
// การ sweep ไล่หาสีของแบรนด์เก่าใน src/ สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#5a2410] bg-[#2a0a04] p-8 text-left text-base leading-relaxed text-[#fdf0e6] shadow-[0_10px_30px_rgba(20,3,2,0.55)] transition-all duration-500 hover:border-[#8a3a12] hover:shadow-[0_15px_40px_rgba(242,122,26,0.18)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[3px] bg-gradient-to-r from-[#e5a92b] via-[#f27a1a] to-[#8a3a12]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#f27a1a]/15 blur-[60px] transition-all duration-500 group-hover:bg-[#f27a1a]/25"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#e5a92b]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#e5a92b]/35"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="text-2xl leading-normal font-black tracking-wide text-[#f27a1a]">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#e5a92b] to-[#f27a1a] shadow-[0_0_10px_rgba(242,122,26,0.4)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
