---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro, /promotion and
// every button page render their body through this file and never follow the
// per-brand ContentBox rotation, so it must carry the CURRENT brand's colours
// even when index.astro picks another variant. Nothing inside those pages names
// a colour — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// มีเฮ168 (รอบแดงชาดนำ-ทองเนยรอง บนดำสนิท 2026-10-19): พาเลตต์ตาม
// .claude/brand-spec-meehay168.md §2
// โลโก้อ่านตรงๆ ได้ว่า: คำว่า **"มี"** เป็นตัวอักษรไทยหนาสามมิติ **สีขาวมุกตัดขอบ
// เทาอ่อน** ต่อด้วย **"เฮ168"** **สีแดงชาดบับเบิลผิวมันวาว** ทางซ้ายเป็น
// **หน้ายิ้มหัวเราะสีเหลืองทองแก้มชมพู** นั่งบน **กองเหรียญทอง** ล้อมด้วย
// **ขีดประกายสีแดง** กับ **ประกายดาวสีทอง** บนพื้นขาว ส่วนแบนเนอร์กับสไลด์
// เป็นฉาก **พื้นขาว-ชมพูอ่อน** ที่มีหญิงสาวผมบลอนด์เงินชุดลูกไม้ขาวผูกโบว์แดง
// ชี้นิ้วมาทางผู้ชม มือถือขึ้นวงล้อสล็อต หัวใจแดง เหรียญทองร่วง มงกุฎทอง และ
// กล่องของขวัญผูกโบว์แดง
//
// ⚠️ รอบนี้ **แดงชาดนำ ทองเนยเป็นฮิวที่สอง แดงลึก/บรอนซ์ลึกเป็นเงาที่ไม่เคยถือ
// ตัวอักษร** — รอบนี้ **หลุดออกจากฟ้าที่ใช้ติดกันสามรอบ** (นินจา168 ฟ้าไซยาน+
// เหลืองมะนาว · สบายเบท168 ฟ้าท้องฟ้า+ทองอำพัน · รวยแทร่168 ฟ้าอะซัวร์+ทองอำพัน)
// **แต่แดงเองก็เคยถูกใช้มาแล้วสามแบรนด์** สิ่งที่แยกรอบนี้ออกจากพวกนั้นจึงอยู่ที่
// **ค่าสี** กับ **การหมุน variant** ไม่ใช่ที่วงศ์สี:
//   แดงรอบนี้ #fb1b32 เป็นชาดอมชมพู ไม่ใช่ fa0513 ของสมหวัง168 (ใกล้มาก)
//   ฮิวที่สองรอบนี้ #fcd45c เป็น **ทองเนย** ไม่ใช่ทองอำพัน f9a826 ของรอบก่อน
//   ชุดความลึกรอบนี้ #2b0711 / #1a040a / #0c0205 ไม่ใช่ 0b2d52 / 071e38 / 030f1d
// ⚠️ พื้นเพจรอบนี้เป็น **ดำสนิท** (bg.json = {"mode":"color","color":"#000000"})
// ถึงแม้แบนเนอร์จะเป็นฉากพื้นขาว — bg.json คือแหล่งเดียวของพื้นเพจ
//
// แดงแบรนด์ #fb1b32 (อ่านจากตัวอักษร เฮ168 บนโลโก้ หัวใจ โบว์ และแถบคำโปรย
// บนแบนเนอร์) ถือขอบการ์ดและเส้นคาดบนสุด · ชมพูบลัช #ff8f9c เป็นต้นของหัวข้อ ·
// ทองเนย #fcd45c เป็นปลายหัวข้อ สี hover ของขอบ และเป็นตัวที่ **สงวนไว้ใช้
// ไฮไลต์ <strong> ในเนื้อความเท่านั้น** · แดงลึก #5c0410 กับบรอนซ์ลึก #6b4a08
// เป็นออรามุมขวาล่างกับปลายเข้มของเส้นใต้ — สองตัวหลังไม่เคยถือตัวอักษร
// ลำดับ บลัช→แดงชาด→ทองเนย ของหัวข้อคือลำดับที่ตาอ่านงานศิลป์จริง (ไฮไลต์มันวาว
// บนตัวอักษร → เนื้อแดงของ เฮ168 → หน้ายิ้มกับกองเหรียญสีทองที่อยู่ข้างๆ)
// และทั้งสามค่าอยู่ที่ 8.5:1 / 4.7:1 / 12.9:1 บนผิวการ์ดนี้ จึงผ่าน AA
// ทุกจุดของเกรเดียนต์
// เนื้อความเป็นขาวอมชมพู #fdeaec (= BRAND_TEXT) — 15.0:1 บนผิวการ์ดนี้
//
// ⚠️ ไฟล์นี้เป็นของแบรนด์ก่อนหน้าทุกรอบ ห้ามเหมาว่าสีที่เจอเป็นของรอบนี้ ต้องเทียบ
// เป็น "ค่า" ไม่ใช่ "ตระกูลสี" และรอบนี้ **ทั้งแดงและทองเคยถูกใช้มาแล้วหลายแบรนด์**
//   แดง — สมหวัง168 fa0513 (+ff5a5f ffadaf b90203 8c0204 5b0203) · รับตัง168
//         d30304 (+ff6b6e a00203 4a0202) · ขวัญใจ168 b3121b (+5a0a0e) ·
//         TKB55 fb131b (+ff4d55 ff8a8f) · GT66B fb141b (+ff5f63 ffa0a2)
//         ⚠️ **fa0513 อยู่ห่างจากแดงรอบนี้แค่นิดเดียว** ต้อง grep เป็นค่า
//   ทอง/เหลือง — รวยแทร่168 f9a826 (+704504) · นินจา168 fef54b (+6b5c10) ·
//         สบายเบท168 ffc82e (+5c4a16) · ถอนชัวร์168 ffd84d · มีโชค168 fcd434
//         (+ffeaa0) · ขวัญใจ168 f7c92b · รับตัง168 f0b429 · สมหวัง168 e3b23c ·
//         KMD88 e2b33f · TND168 dfa310 · KINGKONG555 f2c230 · UFA324 e5a81b
//   ฟ้า/น้ำเงิน — **ไม่มีในรอบนี้เลย** รวยแทร่168 039cfa (+c3ebfc 04366b) ·
//         นินจา168 32bcfb (+a9e9ff 07335f) · สบายเบท168 2f9ff5 (+a8dcff d6ecff
//         0b3f78) · HI59 0a84e0 · TSDET911 0360f3 · รับตัง168 cfd9e6 (เงินอมฟ้า)
// ส่วน **แดงรอบนี้คือ #fb1b32 (+#ff8f9c +#5c0410)** และ **ทองรอบนี้คือ #fcd45c
// (+#ffeec0 +#6b4a08)** หมึกบนพื้นถมคือ **#1b0308** ชุดความลึกคือ #2b0711 /
// #1a040a / #0c0205 บนพื้นเพจ #000000
// ชุดเต็มของรวยแทร่168 ที่เพิ่งอยู่ในไฟล์นี้ (039cfa 0494f5 c3ebfc 04366b f9a826
// 704504 e3f2fc 0b2d52 071e38 030f1d 031320 และ rgba 3/156/250 α) rgba 249/168/38
// α) rgba 195/235/252 α) rgba 4/54/107 α)) ออกครบทุกจุดแล้ว
// เช่นเดียวกับชุดของนินจา168 (32bcfb a9e9ff 07335f fef54b 6b5c10 0c2a3d 071a28
// 030e16 041019 dceefc) ของสบายเบท168 (2f9ff5 a8dcff d6ecff 0b3f78 ffc82e 5c4a16
// e8f4ff 0e2238 081726 040d16 04121f) ของถอนชัวร์168 (fa63b9 ffb3de ffd84d 2b0f20
// 1a0914 0d040a 6d0b3f 6b4708 2a0617 fdeaf5) ของมีโชค168 (fcd434 ffeaa0 f5469f
// ff8dc6 8c0f52 7a5508 1a0612 f6e4ee 24101c 160a12 0b0509) ของขวัญใจ168 (f7c92b
// ffe6a3 f2bba5 c98a74 b3121b 5a0a0e 8a5f12 eadfce 140c06 241509 160d06 0b0603)
// ของรับตัง168 (f0b429 ffdc8c d30304 ff6b6e a00203 4a0202 9a6c0c cfd9e6 f5ece0
// 2b100f 200a09 140505 1a0505) ของสมหวัง168 (fa0513 ffadaf ff5a5f e3b23c ffe5a8
// 8a6210 b90203 8c0204 5b0203 3c0303 170504 f4ecea ccb9b6 2c1413 1f0d0c 140706
// 290f0f) ของ TKB55 (fb131b ff8a8f ff4d55 e9eef4 aeb9c6 f2e4e5 2a0d0f 1a0708
// 0d0304 c40304 8a0206 53050a 1a0304) และของ GT66B (fb141b ff5f63 ffa0a2 db040b
// ec151c 8a0609 3b0405 fdfcfd b4bcc2 eceaea 190505 1c0c0b 130c0c 0b0303)
// ⚠️ **รอบนี้ไม่มีฟ้า/น้ำเงิน ไม่มีม่วง ไม่มีเขียว ไม่มีส้ม ไม่มีเงิน/โครเมียม
// ไม่มีโรสโกลด์ ไม่มีเหลืองมะนาว และไม่มีชมพูฟูเชีย** ชมพูตัวเดียวที่อนุญาตคือ
// บลัช #ff8f9c ซึ่งเป็นแดงจาง ไม่ใช่ f5469f/fa63b9/ff8dc6 ของแบรนด์ก่อน
// (เฮกซ์ของแบรนด์เก่าในคอมเมนต์ด้านบนเขียนแบบ **ไม่มี #** โดยตั้งใจ เพื่อไม่ให้
// การ sweep ไล่หาสีของแบรนด์เก่าใน src/ สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#fb1b32]/45 bg-[#2b0711]/95 p-8 text-left text-base leading-relaxed text-[#fdeaec] shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#fcd45c]/70 hover:shadow-[0_15px_40px_rgba(251,27,50,0.35)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#fb1b32]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#fb1b32]/40 blur-[60px] transition-all duration-500 group-hover:bg-[#ff8f9c]/30"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#5c0410]/80 blur-[60px] transition-all duration-500 group-hover:bg-[#6b4a08]/45"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#ff8f9c] via-[#fb1b32] to-[#fcd45c] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#fb1b32] via-[#fcd45c] to-[#5c0410] shadow-[0_0_10px_rgba(251,27,50,0.65)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
