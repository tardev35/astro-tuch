---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// DM899 (รอบเขียวมรกต-แดงสด-ทอง บนดำอมเขียว 2026-10-03): สล็อตคาสิโนเว็บตรง
// ต่างประเทศ พาเลตต์มาจาก logo.webp ที่เป็นสามสี — ตัว D เขียว (vivid #01841b
// #018b1b) ตัว M แดง (#fb252b #bb0303 #f91c20) และเลข 899 เงินโครเมียม —
// บนแบนเนอร์ที่พื้นเป็นดำอมเขียว (dominant #05140c #0b1b13 #031404) และตัวอักษร
// เป็นทองไล่เฉด ส่วน bg.json กำหนดพื้นหลังเว็บเป็น #000000 แบรนด์นี้จึงเป็น
// "เขียวนำ แดงรอง ทองเสริม บนดำอมเขียว" — เขียวแบรนด์ #01a326 ถือกรอบและออรา
// มุมซ้ายบน แดงแบรนด์ #fb252b ถือออรามุมขวาล่าง (คู่เดียวกับที่ตา D/M เห็นบนโลโก้)
// การ์ดเป็นดำอมเขียว #0a1a0e หัวข้อไล่เฉดทองอ่อน #ffe9a8 → ทองแบรนด์ #f2b422 →
// เขียวสว่าง #12c23a เนื้อความ #e4f2e4 (BRAND_TEXT)
//
// รอบก่อน (1SS365) เป็นทอง-เงินโครเมียม-ดำ ชุดเดิมทั้งชุด (#edbb23 #ffeeb4
// #a87708 #c8cbce #f1f2f3 #121010 #f0e6d2) ออกครบทุกจุดแล้ว และเงินโครเมียมไม่ได้
// กลับเข้ามาเป็นฮิวที่สอง เพราะรอบนี้ฮิวที่สองคือแดงจากตัว M ซึ่งเด่นกว่าเลข 899
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#01a326]/55 bg-[#0a1a0e]/95 p-8 text-left text-base leading-relaxed text-[#e4f2e4] shadow-[0_10px_30px_rgba(0,0,0,0.78)] backdrop-blur-xl transition-all duration-500 hover:border-[#12c23a]/75 hover:shadow-[0_15px_40px_rgba(1,163,38,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#12c23a]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#01a326]/28 blur-[60px] transition-all duration-500 group-hover:bg-[#4ade6b]/40"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#fb252b]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#ff6b6e]/32"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#ffe9a8] via-[#f2b422] to-[#12c23a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#ffe9a8] via-[#f2b422] to-[#12c23a] shadow-[0_0_10px_rgba(242,180,34,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
