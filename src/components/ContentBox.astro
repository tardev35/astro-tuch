---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// หวยคิง (รอบทองโลหะ + ครีมอมพีช บนดำอมน้ำตาล 2026-10-04): เว็บหวย
// พาเลตต์ตาม brand-spec §2 — ทองแบรนด์ #cd9a2c ถือกรอบและออรามุมซ้ายบน
// ทองสว่าง #fdeb7c เป็นไฮไลต์/hover ทองลึก #ab7314 เป็นปลายไล่เฉด
// สีรองคือครีมอมพีช #fcd4c3 (ชุดขาวของนางแบบใน slide1/slide2) ถือออรามุมขวาล่าง
// การ์ดเป็นผิวยก #1c140b เนื้อความ #f5e7c8 (= BRAND_TEXT)
// glow ทุกจุดเป็น rgba(205,154,44,…)
//
// ชุดทอง + เงินโครเมียมของแบรนด์ก่อน (#ebbb54 #fce675 #ab6d24 #d5d4d3 #f3f3f2
// #130b03 #f8eed9 rgba(235,187,84)) ออกครบทุกจุดแล้ว — ครีมอมพีชมาแทนเงินโครเมียม
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#cd9a2c]/55 bg-[#1c140b]/95 p-8 text-left text-base leading-relaxed text-[#f5e7c8] shadow-[0_10px_30px_rgba(0,0,0,0.78)] backdrop-blur-xl transition-all duration-500 hover:border-[#fdeb7c]/75 hover:shadow-[0_15px_40px_rgba(205,154,44,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#cd9a2c]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#cd9a2c]/28 blur-[60px] transition-all duration-500 group-hover:bg-[#fdeb7c]/40">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#fcd4c3]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#fce2d4]/32">
    </div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#fdeb7c] via-[#cd9a2c] to-[#fcd4c3] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#fdeb7c] via-[#cd9a2c] to-[#fcd4c3] shadow-[0_0_10px_rgba(205,154,44,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
