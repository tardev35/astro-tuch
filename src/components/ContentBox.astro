---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro, /promotion,
// /about-us, /contact-us, /ทางเข้า, /ทดลองเล่น, /login และ /register render ตัว
// เนื้อหาผ่านไฟล์นี้ (10 หน้า) และไม่เคยเดินตาม ContentBox rotation ของ index
// → ไฟล์นี้ต้องถือพาเลตของ "แบรนด์ปัจจุบัน" เสมอ ต่อให้ index เลือก variant อื่น
// ⚠️ รอบนี้ **หน้าแรกก็ใช้ไฟล์นี้ด้วย** (docx §6 — หัวข้อสมัคร 3 ขั้นตอน) ซึ่งเป็น
// ไฟล์เดียวที่ทับกับ shape-mix ของรอบก่อน และทับเพราะมันเป็นกล่องถาวร ไม่ใช่
// เพราะเลือกซ้ำ
// ⚠️ หน้าถาวรพวกนั้น **ไม่ประกาศสีตัวอักษรเองเลยสักจุด** ย่อหน้าทั้งหมด inherit สีมา
// จากการ์ดข้างล่าง ถ้าการ์ดไม่ตั้ง text color หน้าเหล่านั้นจะตกไปใช้ default ของ
// เบราว์เซอร์ → คลาส `text-left text-base leading-relaxed text-[#0f3a4a]` บน
// element ที่ถือ <slot /> ห้ามหายไปสักตัว
//
// Flattened single-slot variant (ทำเมื่อ 2026-07-26): `isolate` บนการ์ด + `-z-10`
// บนชั้นตกแต่ง absolute ทุกชั้น slot จึง render เป็นลูกตรงของการ์ด
// **ห้ามเพิ่ม wrapper <div> รอบ slot กลับมา** และถ้าจะเปลี่ยนสีตัวอักษรของการ์ด
// ให้ **แทนที่** คลาสสีเดิม ไม่ใช่ใส่คลาสสีที่สองข้างๆ (specificity เท่ากัน ผลจะ
// ขึ้นอยู่กับลำดับที่ Tailwind บังเอิญ emit)
//
// House style เนื้อความ: element ที่ถือ slot ได้ `text-left text-base
// leading-relaxed <สี>` — ห้ามย่อหรือขยายขนาดตัวอักษรของเนื้อความ (คลาส sm/lg
// ของ text-* ใช้กับย่อหน้าไม่ได้) · หัวข้อจัดกลางได้ แต่ต้อง
// ใส่ text-center ที่ตัวหัวข้อเอง **ห้ามใส่บนการ์ดหรือ <section>** เพราะมันจะ
// inherit ลงไปใน slot แล้วทำให้ย่อหน้าของทุกหน้าที่เรียกไฟล์นี้กลางตามไปด้วย
//
// หัวข้อมาจาก prop `title` + `as` เท่านั้น (เป็นหัวข้อจริงของบทความ/หน้านั้นๆ)
// **ห้าม hardcode ข้อความไทยเป็น heading ในไฟล์นี้** — เป็นโครมที่ขึ้นทุกหน้า
//
// ───────────────────────────────────────────────────────────────────────────
// รอบ 2026-10-22 (สบาย168) พาเลตตาม .claude/brand-spec-sabai168.md §2
// ⚠️⚠️ **รอบนี้กลับมาเป็นธีมสว่าง หลังรอบก่อนเป็นดำสนิท — การ์ดจึงเป็นผิวขาว
// หมึกน้ำเงินเข้ม** เหตุผล: bg.json ของดรอปนี้เป็น {"mode":"color","color":"#ccf7ff"}
// = **ฟ้าพาสเทลสว่าง** และ bg.json คือแหล่งเดียวของพื้นเพจ
// **ห้าม "แก้" การ์ดกลับไปเป็นพื้นมืดเพราะ "รอบก่อนเป็นแบบนั้น"** — การ์ดมืด
// บนพื้นสว่างจะทำให้หน้า terms/privacy/404 ที่พึ่ง BRAND_TEXT (= หมึกน้ำเงิน #0f3a4a)
// กลายเป็นหมึกเข้มบนพื้นเข้มทันที
//
// อ่านจากอาร์ตเวิร์กจริง: โลโก้เป็น **คำว่า "สบาย" ตัวอักษรไทยสามมิติสีทองคานารี
// ต่อด้วยเลข "168" ผิวมันวาวสีฟ้าสกาย** ส่วนแบนเนอร์/สไลด์เป็นฉาก
// **โรงเรือนปลูกผักกลางวันแดดจัด คู่ชาย-หญิงหมวกฟางชุดเอี๊ยมยีนส์ ตะกร้าผัก
// รถแทรกเตอร์แดง หุ่นไล่กา ป้ายไม้ และกองเหรียญทอง**
//
// บทบาทสีในไฟล์นี้:
//   ผิวการ์ด (ยก) #ffffff · ชั้นกลาง #f2fbff · อินเซ็ต/จม #dff4fd · พื้นเพจ #ccf7ff
//   ฟ้าสกาย #2cc3fc = ขอบสว่าง เส้นคาดบนสุด ออรา และต้นของเส้นใต้หัวข้อ
//     (**1.9:1 บนการ์ดขาว — พื้นถม/ขอบ/ออราเท่านั้น ห้ามถือตัวอักษร**)
//   ฟ้าน้ำแข็ง #6bdcfb · ขอบฟ้าอ่อน #9ae0fa = ขอบ/ออราเช่นกัน ห้ามถือตัวอักษร
//   ฟ้าลึก #0a7fbd = ปลายเข้มของเส้นใต้หัวข้อ (4.2:1 — ตัวอักษรใหญ่เท่านั้น)
//   น้ำเงินหมึก #063a57 = **สีหัวข้อ** (7.5:1 บนการ์ดขาว ถือตัวอักษรได้จริง)
//   หมึกน้ำเงินเข้ม #0f3a4a = เนื้อความ (= BRAND_TEXT) 12.2:1 บนผิวการ์ดนี้
//   ทองคานารี #fdcb0c = สีที่สอง ใช้เป็นออรารองและเส้นคาด (**1.5:1 — ห้ามถือตัวอักษร**)
//   ทองลึก #8a6504 = สีไฮไลต์ <strong> ในเนื้อความ (5.0:1) — หน้าไหนจะใช้ก็ได้
//
// ⚠️⚠️ **#ffffff #f2fbff #dff4fd #ccf7ff ห้ามถือตัวอักษรเด็ดขาด** เป็นสีพื้นเท่านั้น
// และ **#2cc3fc #6bdcfb #9ae0fa #fdcb0c ห้ามถือตัวอักษรเช่นกันบนพื้นสว่าง**
// (1.5–2.4:1) เป็น stop ของไล่เฉด/ออรา/ขอบได้อย่างเดียว
// rgba() ที่อนุญาตรอบนี้: rgba(44,195,252,α) · rgba(253,203,12,α) ·
// rgba(107,220,251,α) · rgba(6,58,87,α) · rgba(0,0,0,α)
//
// ⚠️ ไฟล์นี้เป็นของแบรนด์ก่อนหน้าทุกรอบ ห้ามเหมาว่าสีที่เจอเป็นของรอบนี้ ต้องเทียบ
// เป็น **"ค่า"** ไม่ใช่ "ตระกูลสี" — **ฟ้าและเหลืองเคยผ่านรีโปนี้มาแล้วหลายเจ้า**
// การเจอฟ้าหรือทองในไฟล์จึงไม่พิสูจน์ว่าเป็นของรอบปัจจุบัน
// รอบก่อนหน้าทันที (ยูฟ้า168 ทองคานารี + โครเมียมเงิน บนธีมมืด) ที่กวาดออกครบแล้ว
// จากไฟล์นี้:
//   fee45d e6a416 b8780d 7a4e05 e8ecf1 a8b2bf 78828f 5a6472 15130f 1e1a13 0a0908
//   eae3d4 140e02 0b0d10 และพื้นเพจ 000000
// สองรอบก่อน (โปรดี168 แดงเชอร์รี่ + ทองแดงไหม้ บนธีมสว่าง):
//   eb0305 9b0a0c ff4446 c20305 b44c06 7a2f03 f0b46a d9803a 4d1c0a 2c1004
//   fff0e4 fff4ea ffd1d1 401107 1a0802
// ⚠️⚠️ แบรนด์ที่เคยเดิน **ฟ้า+ทอง** เหมือนรอบนี้และต้องเทียบเป็นค่าทีละตัว:
//   สบายเบท168 (**ชื่อใกล้ที่สุดในรีโป**) 2f9ff5 a8dcff d6ecff 0b3f78 ffc82e 5c4a16
//   e8f4ff 0e2238 081726 040d16 04121f · นินจา168 32bcfb a9e9ff fef54b 6b5c10
//   07335f 0c2a3d 071a28 030e16 041019 dceefc · รวยแทร่168 039cfa 0494f5 c3ebfc
//   04366b f9a826 704504 e3f2fc 0b2d52 071e38 030f1d 031320 7fa8cc
// แบรนด์เก่ากว่านั้นทั้งหมด (รวยแท้168 สาธุ168 หวยคิง หวย365 ดวงเศรษฐี168 ufalion168
// รวยเทพ168 มีเฮ168 ถอนชัวร์168 มีโชค168 ขวัญใจ168 รับตัง168 สมหวัง168 มีทรัพย์168
// UFA324 ฯลฯ) อยู่ในตารางของ brand-spec §2 — ให้ grep ทีละค่าจากตารางนั้น ห้ามกะด้วยตา
// ⚠️ รอบนี้ **ไม่มีแดง ไม่มีเขียว (ยกเว้น LINE green ที่อื่น) ไม่มีชมพู ไม่มีม่วง
// ไม่มีโรสโกลด์ ไม่มีส้ม ไม่มีทองแดงไหม้ และไม่มีเงิน/โครเมียม**
// (เฮกซ์ของแบรนด์เก่าในคอมเมนต์ด้านบนเขียนแบบ **ไม่มี #** โดยตั้งใจ เพื่อไม่ให้
// การ sweep ไล่หาสีของแบรนด์เก่าใน src/ สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#9ae0fa] bg-white/95 p-8 text-left text-base leading-relaxed text-[#0f3a4a] shadow-[0_10px_30px_rgba(6,58,87,0.12)] backdrop-blur-xl transition-all duration-500 hover:border-[#2cc3fc] hover:shadow-[0_15px_40px_rgba(44,195,252,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#2cc3fc] to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#2cc3fc]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#2cc3fc]/40"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#fdcb0c]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#fdcb0c]/35"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="text-2xl leading-normal font-black tracking-widest text-[#063a57] uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#2cc3fc] to-[#fdcb0c] shadow-[0_0_10px_rgba(44,195,252,0.45)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
