---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro, /promotion,
// /about-us, /contact-us, /ทางเข้า, /ทดลองเล่น, /login, /register, /ตรวจหวย และ
// /แนวทาง render ตัวเนื้อหาผ่านไฟล์นี้ (12 หน้ารอบนี้) และไม่เคยเดินตาม ContentBox
// rotation ของ index → ไฟล์นี้ต้องถือพาเลตของ "แบรนด์ปัจจุบัน" เสมอ **ห้ามปล่อยให้
// หลุดจากชุดที่ retheme ใน P1 เด็ดขาด** — เป็นจุดที่พลาดง่ายที่สุด เพราะ grep หา
// "ไฟล์ที่ index import" อาจไม่เจอไฟล์นี้ (รอบนี้ index **ไม่ได้ใช้ไฟล์นี้เลยสักบล็อก**
// เพราะ shape-mix หมุนไปใช้ Huay/TwoHuay/CyberCut/SevenThreeHuay/SevenThree/
// 3Three/Special ทั้งชุด แต่สถานะ shared chrome ของมัน **ไม่ได้ขึ้นกับข้อนั้นเลย**
// — สิบสองหน้าข้างบนใช้อยู่ไม่ว่า index จะเลือก variant ไหน)
// ⚠️ รอบนี้ /ตรวจหวย และ /แนวทาง **ย้ายกลับเข้า src/pages/ แล้ว** (แบรนด์นี้เป็น
// เว็บหวยเต็มตัว บรีฟทั้งฉบับเป็นเรื่องหวย) ต่างจากรอบก่อนที่สองหน้านั้นปิดอยู่
// ⚠️ หน้าถาวรพวกนั้น **ไม่ประกาศสีตัวอักษรเองเลยสักจุด** ย่อหน้าทั้งหมด inherit สีมา
// จากการ์ดข้างล่าง ถ้าการ์ดไม่ตั้ง text color หน้าเหล่านั้นจะตกไปใช้ default ของ
// เบราว์เซอร์ → คลาสชุด text-left + text-base + leading-relaxed + สีหมึกของรอบนี้
// บน element ที่ถือ <slot /> ห้ามหายไปสักตัว (รอบนี้สีหมึกคือ 0d3326)
// ⚠️ เขียนชื่อคลาสสีแบบถอดวงเล็บโดยตั้งใจ — Tailwind สแกนไฟล์นี้แบบ plain text
// รวมถึงคอมเมนต์ด้วย การพิมพ์คลาสสีเต็มรูปในคอมเมนต์จึงทำให้ยูทิลิตี้ของค่านั้น
// ถูก generate ลง stylesheet จริง (เคยเจอค่าของแบรนด์ก่อนหลุดมาทางนี้)
//
// Flattened single-slot variant (ทำเมื่อ 2026-07-26): isolate บนการ์ด + -z-10
// บนชั้นตกแต่ง absolute ทุกชั้น slot จึง render เป็นลูกตรงของการ์ด
// **ห้ามเพิ่ม wrapper <div> รอบ slot กลับมา** และถ้าจะเปลี่ยนสีตัวอักษรของการ์ด
// ให้ **แทนที่** คลาสสีเดิม ไม่ใช่ใส่คลาสสีที่สองข้างๆ (specificity เท่ากัน ผลจะ
// ขึ้นอยู่กับลำดับที่ Tailwind บังเอิญ emit)
//
// House style เนื้อความ: element ที่ถือ slot ได้ text-left + text-base +
// leading-relaxed + สี — ห้ามย่อหรือขยายขนาดตัวอักษรของเนื้อความ · หัวข้อจัดกลางได้
// แต่ต้องใส่ text-center ที่ตัวหัวข้อเอง **ห้ามใส่บนการ์ดหรือ <section>** เพราะมันจะ
// inherit ลงไปใน slot แล้วทำให้ย่อหน้าของทุกหน้าที่เรียกไฟล์นี้กลางตามไปด้วย
//
// หัวข้อมาจาก prop title + as เท่านั้น (เป็นหัวข้อจริงของบทความ/หน้านั้นๆ)
// **ห้าม hardcode ข้อความไทยเป็น heading ในไฟล์นี้** — เป็นโครมที่ขึ้นทุกหน้า
//
// ────────────────────────────────────────────────────────────────────────────
// รอบนี้ (LOTTOPLUS) พาเลตตาม .claude/brand-spec-lottoplus.md §2
// 🚨🚨 **กลับทิศ 180° จากรอบก่อนอีกครั้ง: รอบนี้การ์ดเป็นผิวสว่าง ไม่ใช่การ์ดเข้ม**
// เหตุผล: bg.json ของดรอปนี้เป็น mode color + color **e1fef3 = เขียวมินต์จาง
// เกือบขาว** (รอบก่อน WIN8S เป็น 1e0101 = ดำอมเลือดหมู ซึ่งอยู่คนละปลายของสเกล)
// และ bg.json คือแหล่งเดียวของพื้นเพจ
// ⚠️⚠️ **รอบนี้เนื้อหาสว่าง แต่โครมเข้ม** การ์ดนี้เป็น ffffff ซึ่งสว่างกว่า
// พื้นเพจ e1fef3 เล็กน้อยพอให้แยกชั้นได้ ส่วน navbar/footer/ticker เป็นเขียวจม
// **ห้าม "แก้" การ์ดกลับไปเป็นผิวเข้มตามรอบก่อน** — การ์ดเข้มกับหมึก 0d3326
// จะทำให้หน้า terms/privacy/404 ที่พึ่ง BRAND_TEXT ตัวอักษรหายไปเลย ไม่ใช่แค่จางลง
//
// อ่านจากอาร์ตเวิร์กจริง: เวิร์ดมาร์กเป็น **ตัวอักษรสามมิติสองบรรทัด บรรทัดบนผิว
// โครเมียมเงินขัดเงาตัดขอบเขียวเข้ม โดยตัว O ตัวที่สองถูกแทนด้วยใบโคลเวอร์สี่แฉก
// สีเขียวมรกต บรรทัดล่างผิวเขียวมรกตไล่เงา วางในวงรีแถบโครเมียม-เขียวที่พันเป็น
// วงโคจรพร้อมประกายแสง** ส่วนแบนเนอร์เป็นฉาก **ห้องโทนขาวงาช้าง ผ้าม่านโปร่ง
// ดอกลีลาวดีขาวกลางเหลือง หญิงสาวในชุดไทยเขียวมรกตปักทอง เครื่องประดับทองฝัง
// พลอยเขียว ยอดปรางค์ทอง ลูกบอลหวยเขียว-ขาวพิมพ์ตัวเลข และใบโพยหวย**
// ⚠️ **ผนังห้องสีขาวงาช้างและสีผิวของนางแบบเป็นวัตถุในภาพ ไม่ใช่สี UI** —
// พื้นเพจมาจาก bg.json เท่านั้น **ห้ามอนุมานจากรูป** (รอบนี้รูปสว่างและเว็บก็สว่าง
// ซึ่งเป็นเรื่องบังเอิญ รอบก่อนรูปสว่างแต่เว็บมืดสนิท)
//
// บทบาทสีในไฟล์นี้:
//   ผิวการ์ด ffffff · การ์ดสำรอง f0fdf7 · พื้นถมอ่อน/ชั้นยก d2f3e4 ·
//   เส้นบาง a3ddc3 · ขอบตกแต่ง/ออรา 19a97c · ออราสว่าง 2fd49b
//   พื้นเพจ e1fef3 · โครม 052e22 / 03201a / 0a4433
//   เขียวมรกต 046c4e = **สีหัวข้อ** (6.7:1 บนการ์ด ผ่าน AA สบาย) และเป็นสีของ
//     ลิงก์กับ <strong> ทั้งเว็บ
//   หมึก 0d3326 = สีเนื้อความ (= BRAND_TEXT) 13.8:1 บนการ์ด · หมึกรอง 3f6f5c (6.0:1)
//   ทองเข้ม 8a6508 (5.4:1) ถือตัวอักษรบนการ์ดสว่างได้
// 🚨🚨 **a3ddc3 · d2f3e4 · 19a97c · 2fd49b — ห้ามเป็นสีตัวอักษรในไฟล์นี้เด็ดขาด**
//   เป็นเส้น/ขอบ/ออรา/พื้นถมเท่านั้น (19a97c ได้แค่ 3.0:1 บนการ์ดขาว)
// 🚨🚨 **e2b32a (ทองอำพัน) ก็ห้ามถือตัวอักษรบนการ์ดขาว — 2.0:1** มันถือตัวอักษร
//   ได้เฉพาะบนโครมเข้มเท่านั้น ซึ่งไม่ใช่ไฟล์นี้ บนการ์ดสว่างให้ใช้ 8a6508 แทน
// ⚠️⚠️ **ffffff f0fdf7 d2f3e4 a3ddc3 19a97c 2fd49b e1fef3 เป็นผิว ไม่ใช่สีตัวอักษร**
// ส่วน **0d3326 (13.8:1) · 3f6f5c (6.0:1) · 046c4e (6.7:1) · 8a6508 (5.4:1)
// ถือตัวอักษรบนการ์ดสว่างได้ทั้งหมด**
// rgba() ที่อนุญาตรอบนี้: rgba(4,108,78,α) · rgba(25,169,124,α) ·
// rgba(47,212,155,α) · rgba(226,179,42,α) · rgba(13,51,38,α) · rgba(5,46,34,α)
// ⚠️ **เงาบนการ์ดสว่างต้องเบา** — รอบก่อนเป็นเงาดำ alpha 0.55 ซึ่งถูกสำหรับการ์ดเข้ม
// แต่บนการ์ดขาวจะกลายเป็นคราบเทาหนา รอบนี้จึงใช้ rgba(13,51,38,0.10) และ
// hover ยกเป็น rgba(4,108,78,0.18) **ห้ามลอกค่า alpha ของรอบก่อนมา**
//
// ⚠️ ไฟล์นี้เป็นของแบรนด์ก่อนหน้าทุกรอบ ห้ามเหมาว่าสีที่เจอเป็นของรอบนี้ ต้องเทียบ
// เป็น **"ค่า"** ไม่ใช่ "ตระกูลสี"
// 🚨🚨 **กับดักรอบนี้: สาธุ168 เป็นแบรนด์ เขียวมรกต/ทองสัมฤทธิ์ = ตระกูลสีเดียวกับ
// รอบนี้เป๊ะ** รองลงมาคือ TEVA69 และ ZORO365 (เขียวทั้งคู่)
// → **"เจอเขียวหรือทอง ไม่ได้แปลว่าเป็นของรอบนี้"** ต้องเทียบให้ตรงหกหลัก
// ค่าที่กวาดออกครบแล้วจากไฟล์นี้ (ของ WIN8S รอบก่อนทันที):
//   1e0101 2a0a04 3b130b 5a2410 8a3a12 250604 140302
//   f27a1a e8620e f0a21e e5a92b c9d2dc fdf0e6 e0bda4
//   + rgba(242,122,26) rgba(229,169,43) rgba(138,58,18) rgba(30,1,1) rgba(20,3,2)
// **ลิสต์เฮกซ์เต็มของทุกแบรนด์อยู่ที่ .claude/brand-spec-lottoplus.md §2 —
// ไม่ซ้ำลงที่นี่โดยตั้งใจ** ลิสต์เดียวที่อัปเดตที่เดียวย่อมไม่หลุดกันเอง
//   ⚠️⚠️ คู่ที่ต้องสงสัยว่าพิมพ์ผิดก่อนเสมอ:
//   e5a92b f0a21e e8a000 d4922c e3a712 e0b03a e9b53c ffd94a ↔ e2b32a/8a6508 ·
//   0b7d28 0a5f1c 0f9b35 0c3a16 061f0c ↔ 046c4e/0c7c58/052e22 ·
//   8a0412 b00718 c1071b a30d1a f27a1a e8620e ↔ **ไม่มีคู่ — แดงกับส้มออกจาก
//     พาเลตแล้วทั้งสองตระกูล** ·
//   fdf5f6 f7e4e9 f7dfe4 fdeee2 e8fbe4 eef7f0 ↔ ffffff/f0fdf7/e1fef3
//     **(ขาวใกล้กันมาก ต้องอ่านค่า)** ·
//   c9d2dc d8dde6 cfd6e3 c6cfd2 ↔ c8d4d0 ·
//   fdf0e6 e0bda4 36080f 6b2b33 ↔ 0d3326/3f6f5c
// ⚠️ (เขียว 00B900 ของปุ่ม LINE และเขียว success ของฟีดถอนเงินอยู่ไฟล์อื่น
//   **คงไว้ ห้ามกลืนเข้าเขียวมรกตของรอบนี้** — สองค่านั้นเป็นสีเชิงความหมาย
//   ไม่ใช่สีแบรนด์ และรอบนี้สับสนง่ายที่สุดเพราะแบรนด์ก็เป็นเขียว)
// (เฮกซ์ของแบรนด์เก่าในคอมเมนต์ด้านบนเขียนแบบ **ไม่มี #** โดยตั้งใจ เพื่อไม่ให้
// การ sweep ไล่หาสีของแบรนด์เก่าใน src/ สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#a3ddc3] bg-[#ffffff] p-8 text-left text-base leading-relaxed text-[#0d3326] shadow-[0_10px_30px_rgba(13,51,38,0.10)] transition-all duration-500 hover:border-[#19a97c] hover:shadow-[0_15px_40px_rgba(4,108,78,0.18)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[3px] bg-gradient-to-r from-[#e2b32a] via-[#19a97c] to-[#046c4e]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#2fd49b]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#2fd49b]/40"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#e2b32a]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#e2b32a]/40"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="text-2xl leading-normal font-black tracking-wide text-[#046c4e]">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#e2b32a] to-[#046c4e] shadow-[0_0_10px_rgba(4,108,78,0.4)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
