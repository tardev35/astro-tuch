---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// WIN999 (รอบทอง-ดำ 2026-09-29): เว็บคาสิโนออนไลน์ พาเลตต์มาจากโลโก้ที่ WIN เป็น
// ทองสด #fcc403 และ 999 เป็นขาว กับแบนเนอร์พื้นดำสนิทที่มีริ้วแสงทองและชิปขอบทอง —
// การ์ดดำอมทอง #100d05 ในกรอบทองแบรนด์ #fcc403 ออร่ามุมซ้ายบนเป็นทอง #fcc403
// มุมขวาล่างเป็นทองสว่าง #fdda04 หัวข้อไล่เฉดทองอ่อน #fff0a8 → ทองแบรนด์ #fcc403 →
// ทองลึก #8a6502 เนื้อความ #e9e4d6 (BRAND_TEXT) — ชุดแดง-ทองของ LOTTO24 รอบก่อน
// (#dc2626 #fc2b2c #b40102 #fde68a #15060a #f6e2e2) ออกครบทุกจุดแล้ว
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#fcc403]/45 bg-[#100d05]/94 p-8 text-left text-base leading-relaxed text-[#e9e4d6] shadow-[0_10px_30px_rgba(3,2,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#fdda04]/70 hover:shadow-[0_15px_40px_rgba(252,196,3,0.34)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#fcc403]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#fcc403]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#fdda04]/38"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#fdda04]/16 blur-[60px] transition-all duration-500 group-hover:bg-[#fdda04]/28"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#fff0a8] via-[#fcc403] to-[#8a6502] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#fff0a8] via-[#fcc403] to-[#8a6502] shadow-[0_0_10px_rgba(252,196,3,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
