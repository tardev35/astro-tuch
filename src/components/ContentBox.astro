---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro, /promotion,
// /about-us, /contact-us, /ทางเข้า, /ทดลองเล่น, /login และ /register render ตัว
// เนื้อหาผ่านไฟล์นี้ (10 หน้า) และไม่เคยเดินตาม ContentBox rotation ของ index
// → ไฟล์นี้ต้องถือพาเลตของ "แบรนด์ปัจจุบัน" เสมอ ต่อให้ index เลือก variant อื่น
// ⚠️ รอบนี้ **หน้าแรกก็ใช้ไฟล์นี้ด้วย** (docx §6 — หัวข้อสมัครสมาชิก) ซึ่งเป็น
// ไฟล์เดียวที่ทับกับ shape-mix ของรอบก่อน และทับเพราะมันเป็นกล่องถาวร ไม่ใช่
// เพราะเลือกซ้ำ
// ⚠️ หน้าถาวรพวกนั้น **ไม่ประกาศสีตัวอักษรเองเลยสักจุด** ย่อหน้าทั้งหมด inherit สีมา
// จากการ์ดข้างล่าง ถ้าการ์ดไม่ตั้ง text color หน้าเหล่านั้นจะตกไปใช้ default ของ
// เบราว์เซอร์ → คลาส `text-left text-base leading-relaxed text-[#eae3d4]` บน
// element ที่ถือ <slot /> ห้ามหายไปสักตัว
//
// Flattened single-slot variant (ทำเมื่อ 2026-07-26): `isolate` บนการ์ด + `-z-10`
// บนชั้นตกแต่ง absolute ทุกชั้น slot จึง render เป็นลูกตรงของการ์ด
// **ห้ามเพิ่ม wrapper <div> รอบ slot กลับมา** และถ้าจะเปลี่ยนสีตัวอักษรของการ์ด
// ให้ **แทนที่** คลาสสีเดิม ไม่ใช่ใส่คลาสสีที่สองข้างๆ (specificity เท่ากัน ผลจะ
// ขึ้นอยู่กับลำดับที่ Tailwind บังเอิญ emit)
//
// House style เนื้อความ: element ที่ถือ slot ได้ `text-left text-base
// leading-relaxed <สี>` — ห้ามย่อหรือขยายขนาดตัวอักษรของเนื้อความ (คลาส sm/lg
// ของ text-* ใช้กับย่อหน้าไม่ได้) · หัวข้อจัดกลางได้ แต่ต้อง
// ใส่ text-center ที่ตัวหัวข้อเอง **ห้ามใส่บนการ์ดหรือ <section>** เพราะมันจะ
// inherit ลงไปใน slot แล้วทำให้ย่อหน้าของทุกหน้าที่เรียกไฟล์นี้กลางตามไปด้วย
//
// หัวข้อมาจาก prop `title` + `as` เท่านั้น (เป็นหัวข้อจริงของบทความ/หน้านั้นๆ)
// **ห้าม hardcode ข้อความไทยเป็น heading ในไฟล์นี้** — เป็นโครมที่ขึ้นทุกหน้า
//
// ───────────────────────────────────────────────────────────────────────────
// รอบ 2026-10-22 (ยูฟ้า168) พาเลตตาม .claude/brand-spec-ufabet168.md §2
// ⚠️⚠️ **รอบนี้กลับมาเป็นธีมมืด หลังสามรอบติดที่เป็นธีมสว่าง — การ์ดจึงเป็นผิวมืด
// หมึกครีม** เหตุผล: bg.json ของดรอปนี้เป็น {"mode":"color","color":"#000000"}
// = **ดำสนิท** และ bg.json คือแหล่งเดียวของพื้นเพจ
// **ห้าม "แก้" การ์ดกลับไปเป็นพื้นสว่างเพราะ "สามรอบก่อนเป็นแบบนั้น"** — การ์ดสว่าง
// บนพื้นดำจะทำให้หน้า terms/privacy/404 ที่พึ่ง BRAND_TEXT (= หมึกครีม #eae3d4)
// กลายเป็นหมึกสว่างบนพื้นสว่างทันที
//
// อ่านจากอาร์ตเวิร์กจริง: โลโก้เป็น **ลูกฟุตบอลขาว-ดำลายทองพร้อมหางวงโคจรทอง**
// ข้างคำว่า **"ยูฟ้า" ตัวอักษรไทยสามมิติสีทองอร่าม** ต่อด้วย **เลข "168" ผิว
// โครเมียมเงิน** ส่วนแบนเนอร์/สไลด์เป็นฉาก **อัฒจันทร์สนามฟุตบอลกลางคืน
// ไฟสปอตไลต์ คู่ชาย-หญิงชุดบอลดำ-ทอง ลูกฟุตบอลทองคำ ตู้สล็อต 777 และเหรียญทอง**
//
// บทบาทสีในไฟล์นี้:
//   ผิวการ์ด (ยก) #15130f · ชั้นกลาง/อินเซ็ตอุ่น #1e1a13 · พื้นเพจ #000000
//   ทองคานารี #fee45d = ขอบสว่าง เส้นคาดบนสุด ออรา หัวข้อ และต้นของเส้นใต้หัวข้อ
//     (14.8:1 บนผิวการ์ด → ใช้กับเส้น ออรา หัวข้อ และไฮไลต์ <strong> ได้)
//   ทองกลาง #e6a416 = ขอบการ์ดปกติ (8.7:1 ถือตัวอักษรได้)
//   ทองลึก #b8780d = ปลายเข้มของเส้นใต้หัวข้อ (5.2:1 ถือตัวอักษรได้)
//   หมึกครีม #eae3d4 = เนื้อความ (= BRAND_TEXT) 14.6:1 บนผิวการ์ดนี้
//   โครเมียม #a8b2bf = สีที่สอง ใช้เป็นออรารองและเส้นคั่น (8.6:1 ถือตัวอักษรได้)
//
// ⚠️⚠️ **#15130f และ #1e1a13 ห้ามถือตัวอักษรเด็ดขาด** เป็นสีพื้น/เส้นเท่านั้น
// และ **#7a4e05 กับ #5a6472 ห้ามถือตัวอักษรเช่นกัน** (2.4:1 และ 3.3:1)
// เป็น stop ของไล่เฉด/ออรา/ขอบได้อย่างเดียว — สีไฮไลต์ <strong> ในเนื้อความมี
// ตัวเดียวคือ **ทองคานารี #fee45d**
// rgba() ที่อนุญาตรอบนี้: rgba(254,228,93,α) · rgba(230,164,22,α) ·
// rgba(168,178,191,α) · rgba(0,0,0,α)
//
// ⚠️ ไฟล์นี้เป็นของแบรนด์ก่อนหน้าทุกรอบ ห้ามเหมาว่าสีที่เจอเป็นของรอบนี้ ต้องเทียบ
// เป็น **"ค่า"** ไม่ใช่ "ตระกูลสี" — **ทองถูกใช้มาแล้วเกือบทุกแบรนด์ในรีโปนี้**
// การเจอทองในไฟล์จึงไม่พิสูจน์ว่าเป็นของรอบปัจจุบัน
// รอบก่อนหน้าทันที (โปรดี168 แดงเชอร์รี่ + ทองแดงไหม้ บนธีมสว่าง) ที่กวาดออกครบแล้ว
// จากไฟล์นี้:
//   eb0305 9b0a0c ff4446 c20305 b44c06 7a2f03 f0b46a d9803a 4d1c0a 2c1004
//   fff0e4 fff4ea ffd1d1 401107 1a0802 และ rgba 235/3/5 α) rgba 155/10/12 α)
//   rgba 64/17/7 α) rgba 180/76/6 α)
// สองรอบก่อน (รวยแท้168 แดงคริมสัน + ทองโบราณ):
//   c30303 8f0505 e81313 dcb95f b8862b 96681f 4a0f0f 461212 280b0b ffeee8
//   fff1ef ffdbdb
// แบรนด์เก่ากว่านั้นทั้งหมด (สาธุ168 หวยคิง หวย365 ดวงเศรษฐี168 ufalion168
// รวยเทพ168 มีเฮ168 รวยแทร่168 นินจา168 สบายเบท168 ถอนชัวร์168 มีโชค168 ขวัญใจ168
// รับตัง168 สมหวัง168 มีทรัพย์168 UFA324 ฯลฯ) อยู่ในตารางของ brand-spec §2 —
// ให้ grep ทีละค่าจากตารางนั้น ห้ามกะด้วยตา
// ⚠️ รอบนี้ **ไม่มีแดง ไม่มีเขียว (ยกเว้น LINE green ที่อื่น) ไม่มีชมพู ไม่มีฟ้า/
// น้ำเงิน/ไซยาน ไม่มีม่วง ไม่มีโรสโกลด์ และไม่มีทองแดงไหม้**
// (เฮกซ์ของแบรนด์เก่าในคอมเมนต์ด้านบนเขียนแบบ **ไม่มี #** โดยตั้งใจ เพื่อไม่ให้
// การ sweep ไล่หาสีของแบรนด์เก่าใน src/ สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#e6a416]/35 bg-[#15130f]/95 p-8 text-left text-base leading-relaxed text-[#eae3d4] shadow-[0_10px_30px_rgba(0,0,0,0.55)] backdrop-blur-xl transition-all duration-500 hover:border-[#e6a416]/70 hover:shadow-[0_15px_40px_rgba(254,228,93,0.22)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#fee45d]/70 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#fee45d]/18 blur-[60px] transition-all duration-500 group-hover:bg-[#fee45d]/30"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#1e1a13]/90 blur-[60px] transition-all duration-500 group-hover:bg-[#a8b2bf]/18"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="text-2xl leading-normal font-black tracking-widest text-[#fee45d] uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#fee45d] to-[#b8780d] shadow-[0_0_10px_rgba(254,228,93,0.4)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
