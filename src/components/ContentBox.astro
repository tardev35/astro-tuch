---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// หวยพยัคฆ์ (รอบกรมท่า-ทอง 2026-09-22): การ์ดน้ำเงินกรมท่า #08152f ในกรอบทอง
// บรอนซ์ #ab6d13 ออร่าสองมุมเป็นทองหลัก #fadb6c กับทองสว่าง #fdf5a4 หัวข้อไล่จาก
// ทองสว่าง #fdf5a4 → ทองหลัก #fadb6c → ทองบรอนซ์ #ab6d13 ซึ่งเป็นไล่เฉดเดียวกับ
// คำว่า พยัคฆ์ บนโลโก้ ส่วนเนื้อความใช้ #dbe4f7 (BRAND_TEXT) ซึ่งเป็นขาวอมฟ้า
// ให้เข้ากับพื้นกรมท่า — โทนดำ-ทองของรอบก่อนหายไปทั้งหมด
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#ab6d13]/55 bg-[#08152f]/94 p-8 text-left text-base leading-relaxed text-[#dbe4f7] shadow-[0_10px_30px_rgba(3,11,28,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#fadb6c]/70 hover:shadow-[0_15px_40px_rgba(250,219,108,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#fadb6c]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#fadb6c]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#fadb6c]/34"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#fdf5a4]/24 blur-[60px] transition-all duration-500 group-hover:bg-[#fdf5a4]/36"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#fdf5a4] via-[#fadb6c] to-[#ab6d13] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#fdf5a4] to-[#ab6d13] shadow-[0_0_10px_rgba(250,219,108,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
