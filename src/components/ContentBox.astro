---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// UFAGOOL (รอบแดง-เงินโครเมียม 2026-09-23): การ์ดเกือบดำ #16100f ในกรอบแดงลึก
// #5e0507 ออร่าสองมุมเป็นแดงแบรนด์ #c50d12 กับเงิน #b8c3cf หัวข้อไล่จากแดงสด
// #ef1f25 → ขาวเงิน #f4f7fa → เงิน #b8c3cf ตามลำดับสีในโลโก้ที่ตัว UFA เป็นแดง
// เงาวาวแล้วตัว GOOL เป็นเงินโครเมียม เนื้อความ #cdd5dd (BRAND_TEXT)
// — ทอง #f2c14e/#ffe7a6 กับพื้นแดงเลือดหมู #2d0908 ของ THE88 รอบก่อนหายไปหมด
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#5e0507]/70 bg-[#16100f]/94 p-8 text-left text-base leading-relaxed text-[#cdd5dd] shadow-[0_10px_30px_rgba(10,7,8,0.8)] backdrop-blur-xl transition-all duration-500 hover:border-[#b8c3cf]/55 hover:shadow-[0_15px_40px_rgba(197,13,18,0.38)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#b8c3cf]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#c50d12]/28 blur-[60px] transition-all duration-500 group-hover:bg-[#ef1f25]/40"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#b8c3cf]/18 blur-[60px] transition-all duration-500 group-hover:bg-[#f4f7fa]/28"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#ef1f25] via-[#f4f7fa] to-[#b8c3cf] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#ef1f25] via-[#f4f7fa] to-[#b8c3cf] shadow-[0_0_10px_rgba(197,13,18,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
