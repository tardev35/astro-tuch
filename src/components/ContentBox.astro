---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro, /promotion,
// /about-us, /contact-us, /ทางเข้า, /ทดลองเล่น, /login และ /register render ตัว
// เนื้อหาผ่านไฟล์นี้ (10 หน้า) และไม่เคยเดินตาม ContentBox rotation ของ index
// → ไฟล์นี้ต้องถือพาเลตของ "แบรนด์ปัจจุบัน" เสมอ ต่อให้ index เลือก variant อื่น
// ⚠️ หน้าพวกนั้น **ไม่ประกาศสีตัวอักษรเองเลยสักจุด** ย่อหน้าทั้งหมด inherit สีมา
// จากการ์ดข้างล่าง ถ้าการ์ดไม่ตั้ง text color หน้าเหล่านั้นจะตกไปใช้ default ของ
// เบราว์เซอร์ → คลาส `text-left text-base leading-relaxed text-[#4a0d35]` บน
// element ที่ถือ <slot /> ห้ามหายไปสักตัว
//
// Flattened single-slot variant (ทำเมื่อ 2026-07-26): `isolate` บนการ์ด + `-z-10`
// บนชั้นตกแต่ง absolute ทุกชั้น slot จึง render เป็นลูกตรงของการ์ด
// **ห้ามเพิ่ม wrapper <div> รอบ slot กลับมา** และถ้าจะเปลี่ยนสีตัวอักษรของการ์ด
// ให้ **แทนที่** คลาสสีเดิม ไม่ใช่ใส่คลาสสีที่สองข้างๆ (specificity เท่ากัน ผลจะ
// ขึ้นอยู่กับลำดับที่ Tailwind บังเอิญ emit)
//
// House style เนื้อความ: element ที่ถือ slot ได้ `text-left text-base
// leading-relaxed <สี>` — ห้ามย่อหรือขยายขนาดตัวอักษรของเนื้อความ (คลาส sm/lg
// ของ text-* ใช้กับย่อหน้าไม่ได้) · หัวข้อจัดกลางได้ แต่ต้อง
// ใส่ text-center ที่ตัวหัวข้อเอง **ห้ามใส่บนการ์ดหรือ <section>** เพราะมันจะ
// inherit ลงไปใน slot แล้วทำให้ย่อหน้าของทุกหน้าที่เรียกไฟล์นี้กลางตามไปด้วย
//
// หัวข้อมาจาก prop `title` + `as` เท่านั้น (เป็นหัวข้อจริงของบทความ/หน้านั้นๆ)
// **ห้าม hardcode ข้อความไทยเป็น heading ในไฟล์นี้** — เป็นโครมที่ขึ้นทุกหน้า
//
// ───────────────────────────────────────────────────────────────────────────
// รอบ 2026-10-21 (มีทรัพย์168) พาเลตตาม .claude/brand-spec-meesub168.md §2
// ⚠️⚠️ **นี่คือแบรนด์ "ธีมสว่าง" ตัวแรกของรีโปนี้ — การ์ดกลับทิศจากทุกรอบก่อน**
// เหตุผล: bg.json ของดรอปนี้เป็น {"mode":"color","color":"#f0ccf5"} = **ชมพูอมม่วง
// สว่าง** ไม่ใช่ดำสนิทเหมือนทุกแบรนด์ก่อนหน้า และ bg.json คือแหล่งเดียวของพื้นเพจ
// **ห้าม "แก้" การ์ดกลับไปเป็นพื้นเข้มเพราะ "รอบก่อนๆ เป็นแบบนั้น"** — การ์ดเข้ม
// บนพื้นชมพูสว่างจะทำให้หน้า terms/privacy/404 ที่พึ่ง BRAND_TEXT (= หมึกเข้ม)
// กลายเป็นหมึกเข้มบนพื้นเข้มทันที
//
// อ่านจากอาร์ตเวิร์กจริง: โลโก้เป็น **หัวหมูการ์ตูนสีชมพูอ่อนสวมหน้ากากโจรสีดำ
// ยิ้มแลบลิ้น** ชื่อแบรนด์เป็น **ตัวอักษรไทยสามมิติไล่เฉดชมพู ขอบขาว** ต่อด้วย
// **เลขสามมิติผิวเงิน-ขาว** ส่วนแบนเนอร์/สไลด์เป็นฉาก **ฟาร์มทุ่งหญ้าแดดจัด
// ยุ้งฉางไม้แดง กังหันลม ฟ่อนฟาง รั้วไม้ หมูการ์ตูนหน้ากากโจร และพื้นสตูดิโอขาว
// กล่องของขวัญขาว-ชมพู เหรียญชมพู**
//
// บทบาทสีในไฟล์นี้:
//   ผิวการ์ด (ยก) #ffffff · ชั้นกลาง/อินเซ็ต #f7dcf6 · พื้นเพจ #f0ccf5
//   ชมพูบานเย็น #dd1b74 = ขอบการ์ด เส้นคาดบนสุด ออรา และต้นของเส้นใต้หัวข้อ
//     (4.67:1 บนผิวการ์ดขาว → ผ่าน AA พอดี ใช้กับเส้นและออราเป็นหลัก)
//   โรสเข้ม #a4186b = **หัวข้อ** (7.17:1 บนผิวการ์ดขาว) และปลายเข้มของเส้นใต้
//   พลัมเข้ม #4a0d35 = เนื้อความ (= BRAND_TEXT) 14.9:1 บนผิวการ์ดนี้
//
// ⚠️⚠️ **#f0ccf5 และ #f7dcf6 ห้ามถือตัวอักษรบนพื้นขาวเด็ดขาด** เป็นสีพื้น/เส้น
// เท่านั้น และ **#dd1b74 ห้ามเป็นสีไฮไลต์ <strong> ในเนื้อความ** (ผ่าน AA เฉียดฉิว
// ที่ 4.67:1) — สีไฮไลต์ <strong> มีตัวเดียวคือ **โรสเข้ม #a4186b**
// นี่คือเหตุผลที่หัวข้อของการ์ดนี้เป็นโรสเข้มตันตัวเดียว ไม่ได้เป็นชมพูบานเย็น
// เหมือนที่ตาอยากให้เป็น ถ้าต้องการตัวอักษรที่อ่านว่า "ชมพูสด" ให้ **ถม #dd1b74
// เป็นพื้นแล้ววาง #ffffff ทับ** (4.67:1 ผ่าน AA)
// rgba() ที่อนุญาตรอบนี้: rgba(221,27,116,α) · rgba(164,24,107,α) · rgba(74,13,53,α)
//
// ⚠️ ไฟล์นี้เป็นของแบรนด์ก่อนหน้าทุกรอบ ห้ามเหมาว่าสีที่เจอเป็นของรอบนี้ ต้องเทียบ
// เป็น **"ค่า"** ไม่ใช่ "ตระกูลสี" — **ชมพูเคยนำมาแล้วสามแบรนด์** (ถอนชัวร์168
// fa63b9 · มีโชค168 f5469f · มีเฮ168 ff8f9c blush) การเจอชมพูในไฟล์จึงไม่พิสูจน์
// ว่าเป็นของรอบปัจจุบัน ตัวที่ใกล้ dd1b74 ที่สุดคือ f5469f ซึ่งห่าง 65 หน่วย
// รอบก่อนหน้าทันที (ดวงเศรษฐี168 ทองน้ำผึ้ง/แดงชาด บนดำ) ที่กวาดออกครบแล้วจากไฟล์นี้:
//   d9212a 8e1a16 f0c878 fff8d8 2a0608 4e2120 300605 150303
//   และ rgba 217/33/42 α) rgba 240/200/120 α) rgba 142/26/22 α)
// แบรนด์เก่ากว่านั้นทั้งหมด (ufalion168 รวยเทพ168 มีเฮ168 รวยแทร่168 นินจา168
// สบายเบท168 ถอนชัวร์168 มีโชค168 ขวัญใจ168 รับตัง168 สมหวัง168 UFA324 TKB55
// GT66B KMD88 TND168 KINGKONG555 HI59 TSDET911 ฯลฯ) อยู่ในตารางของ brand-spec §2 —
// ให้ grep ทีละค่าจากตารางนั้น ห้ามกะด้วยตา
// ⚠️ รอบนี้ **ไม่มีทอง/เหลือง ไม่มีแดงชาด ไม่มีบรอนซ์ ไม่มีฟ้า/น้ำเงิน/ไซยาน
// ไม่มีเขียว ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์ และไม่มีส้มสด** — ชมพูรอบนี้เป็น
// ชมพูบานเย็นอมแดง ไม่ใช่ชมพูพาสเทลและไม่ใช่โรสโกลด์
// (เฮกซ์ของแบรนด์เก่าในคอมเมนต์ด้านบนเขียนแบบ **ไม่มี #** โดยตั้งใจ เพื่อไม่ให้
// การ sweep ไล่หาสีของแบรนด์เก่าใน src/ สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#dd1b74]/35 bg-white/95 p-8 text-left text-base leading-relaxed text-[#4a0d35] shadow-[0_10px_30px_rgba(74,13,53,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#dd1b74]/70 hover:shadow-[0_15px_40px_rgba(221,27,116,0.25)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#dd1b74]/70 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#dd1b74]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#dd1b74]/40"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#f0ccf5]/90 blur-[60px] transition-all duration-500 group-hover:bg-[#a4186b]/25"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="text-2xl leading-normal font-black tracking-widest text-[#a4186b] uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#dd1b74] to-[#a4186b] shadow-[0_0_10px_rgba(221,27,116,0.45)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
