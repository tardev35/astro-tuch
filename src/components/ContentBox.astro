---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// LOTTO24 (รอบแดง-ทอง-ดำ 2026-09-28): เว็บแทงหวย พาเลตต์มาจากโลโก้ที่ LOTTO เป็น
// เงินเมทัลลิกและ 24 เป็นแดงสด #fc2b2c กับแบนเนอร์ที่มีมงกุฎ/เหรียญทอง —
// การ์ดดำอมแดง #15060a ในกรอบแดงแบรนด์ #dc2626 ออร่ามุมซ้ายบนเป็นแดง #dc2626
// มุมขวาล่างเป็นทอง #fbbf24 หัวข้อไล่เฉดทองอ่อน #fde68a → แดงสด #fc2b2c →
// แดงลึก #b40102 เนื้อความ #f6e2e2 (BRAND_TEXT) — ชุดชมพูนีออน/ม่วงของ
// SEXYGAME666 รอบก่อน (#fa42b5 #8b3df3 #ffb3e2 #0f0518 #f2dcee) ออกครบทุกจุดแล้ว
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#dc2626]/45 bg-[#15060a]/94 p-8 text-left text-base leading-relaxed text-[#f6e2e2] shadow-[0_10px_30px_rgba(6,1,2,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#fbbf24]/70 hover:shadow-[0_15px_40px_rgba(220,38,38,0.34)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#dc2626]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#dc2626]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#fc2b2c]/38"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#fbbf24]/16 blur-[60px] transition-all duration-500 group-hover:bg-[#fbbf24]/28"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#fde68a] via-[#fc2b2c] to-[#b40102] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#fde68a] via-[#fc2b2c] to-[#b40102] shadow-[0_0_10px_rgba(220,38,38,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
