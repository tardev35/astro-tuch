---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#3fa316]/25 bg-[#0a1207]/92 p-8 text-left text-base leading-relaxed text-[#dfeacf] shadow-[0_10px_30px_rgba(63,163,22,0.14)] backdrop-blur-xl transition-all duration-500 hover:border-[#3fa316]/50 hover:shadow-[0_15px_40px_rgba(63,163,22,0.24)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#3fa316]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#3fa316]/30"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#2f6b0f]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#55aa25]/25"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#3fa316]/25 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#a4e254] to-[#2f6b0f] shadow-[0_0_10px_rgba(63,163,22,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#a4e254] via-[#dfeacf] to-[#3fa316] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
