---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// SUPERSLOTCLUB (รอบแดงเสือโคร่ง-ทองถ่านไฟ 2026-10-09): คลับคนเล่นสล็อตซุปเปอร์
// พาเลตต์ตาม brand-spec §2 รอบนี้พลิกจากคู่ "เขียวป่า-ทองมงกุฎ" ของ KINGKONG555
// มาเป็นคู่ "แดง-ทอง" — การ์ดยังเป็นกระจกมืดเหมือนเดิมแต่ย้ายจากผิวเขียวป่า
// #14380a มาเป็นผิวน้ำตาลแดง #3d1709 ซึ่ง "สว่างกว่า" พื้นเพจของดรอปนี้ที่เป็น
// {"mode":"color","color":"#241000"} = น้ำตาลถ่านเกือบดำ การ์ดจึงยกลอยขึ้นจากพื้น
// เหมือนป้ายโล่แดงในโลโก้ที่ลอยอยู่หน้าฉากป่า
//
// แดงเสือโคร่ง #e8232a (ฮิวของป้ายโล่และตัวอักษรบนโลโก้) ถือขอบการ์ดและออรามุม
// ซ้ายบน · ทองถ่านไฟ #f2b705 (เหรียญทองลายรอยเท้าเสือและตัวหนังสือไทยบนแบนเนอร์)
// เป็นฮิวที่สองจริง อยู่ที่เส้นคาดบนสุด ปลายไล่เฉดหัวข้อ เส้นใต้ และเงาตอน hover ·
// แดงเรืองไฟ #ff5a46 เป็นช่วงกลางของไล่เฉดหัวข้อ · ครีมอุ่น #f5cbb0 เป็นปลาย
// สว่างสุดของหัวข้อ · ทองเข้ม #a8730a กับแดงลึก #7d0f12 เป็นปลายเข้มของเส้นใต้
// และออรา — ทั้งคู่ไม่เคยถือตัวอักษร
// เนื้อความเป็นครีมอมส้มอ่อน #fbe8d5 (= BRAND_TEXT) — 13.3:1 บนผิวการ์ดนี้
//
// ⚠️ รอบนี้ฮิวของแบรนด์เองเป็น "สีแดง" และแบรนด์ก่อนๆ หลายเจ้าก็แดงเหมือนกัน
// เจอแดงที่ไหนห้ามเหมาว่าเป็นของรอบนี้ ให้เทียบค่าเป็นตัวๆ: ชุดเขียว-ทองของ
// KINGKONG555 (#8ce023 #5cc211 #1a5c04 #f2c230 #ffe066 #a87a08 #bde397 #e9f7d6
// #06220a #14380a #0f2e05 rgba(140,224,35,α) rgba(242,194,48,α)) ชุดม่วง-ทองของ
// WEPLAY168 (#a435f0 #5b1a75 #fbe455 #ffd23d #efe6ff #c98a05 #1e0a3c #ece2ff)
// ชุดแดงแล็กเกอร์ของ PIGPG (#d4200d #a30303 #f5b61d #3a0d07) และชุดฟ้า-เหลืองของ
// แตกดี168 (#0193fb #fce604 #dbeafe) ออกครบทุกจุดแล้ว — ทองของรอบนี้ก็เป็นคนละค่า
// กับทองของทุกชุดข้างบน อย่าปล่อยของเก่าไว้เพราะ "ดูคล้ายกัน"
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#e8232a]/40 bg-[#3d1709]/95 p-8 text-left text-base leading-relaxed text-[#fbe8d5] shadow-[0_10px_30px_rgba(0,0,0,0.6)] backdrop-blur-xl transition-all duration-500 hover:border-[#e8232a]/80 hover:shadow-[0_15px_40px_rgba(242,183,5,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#f2b705]/75 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#e8232a]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#e8232a]/35"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#a8730a]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#f2b705]/28"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#f5cbb0] via-[#ff5a46] to-[#f2b705] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#f2b705] via-[#a8730a] to-[#7d0f12] shadow-[0_0_10px_rgba(242,183,5,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
