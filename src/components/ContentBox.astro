---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro, /promotion,
// /about-us, /contact-us, /ทางเข้า, /ทดลองเล่น, /login และ /register
// render ตัวเนื้อหาผ่านไฟล์นี้ (10 หน้ารอบนี้) และไม่เคยเดินตาม ContentBox
// rotation ของ index → ไฟล์นี้ต้องถือพาเลตของ "แบรนด์ปัจจุบัน" เสมอ **ห้ามปล่อยให้
// หลุดจากชุดที่ retheme ใน P1 เด็ดขาด** — เป็นจุดที่พลาดง่ายที่สุด เพราะ grep หา
// "ไฟล์ที่ index import" อาจไม่เจอไฟล์นี้ (รอบนี้ index **ไม่ได้ใช้ไฟล์นี้เลยสักบล็อก**
// เพราะ shape-mix หมุนไปใช้ Premium/TwoCyberCut/FloatingBadge/SevenThreeCyberCut/
// SevenThreeNeumorphism/3ThreePremium/TwoNeumorphism ทั้งชุด แต่สถานะ shared chrome
// ของมัน **ไม่ได้ขึ้นกับข้อนั้นเลย** — สิบหน้าข้างบนใช้อยู่ไม่ว่า index จะเลือก
// variant ไหน)
// ⚠️ รอบนี้ /ตรวจหวย และ /แนวทาง **ถูกย้ายกลับไปจอดใน src/pages-disabled/ แล้ว**
// (แบรนด์นี้เป็นเว็บคาสิโน บรีฟไม่มีคำว่าหวยเลยสักคำ) ต่างจากรอบก่อนที่สองหน้านั้นเปิดอยู่
// ⚠️ หน้าถาวรพวกนั้น **ไม่ประกาศสีตัวอักษรเองเลยสักจุด** ย่อหน้าทั้งหมด inherit สีมา
// จากการ์ดข้างล่าง ถ้าการ์ดไม่ตั้ง text color หน้าเหล่านั้นจะตกไปใช้ default ของ
// เบราว์เซอร์ → คลาสชุด text-left + text-base + leading-relaxed + สีหมึกของรอบนี้
// บน element ที่ถือ <slot /> ห้ามหายไปสักตัว (รอบนี้สีหมึกคือ 3d0a2c)
// ⚠️ เขียนชื่อคลาสสีแบบถอดวงเล็บโดยตั้งใจ — Tailwind สแกนไฟล์นี้แบบ plain text
// รวมถึงคอมเมนต์ด้วย การพิมพ์คลาสสีเต็มรูปในคอมเมนต์จึงทำให้ยูทิลิตี้ของค่านั้น
// ถูก generate ลง stylesheet จริง (เคยเจอค่าของแบรนด์ก่อนหลุดมาทางนี้)
//
// Flattened single-slot variant (ทำเมื่อ 2026-07-26): isolate บนการ์ด + -z-10
// บนชั้นตกแต่ง absolute ทุกชั้น slot จึง render เป็นลูกตรงของการ์ด
// **ห้ามเพิ่ม wrapper <div> รอบ slot กลับมา** และถ้าจะเปลี่ยนสีตัวอักษรของการ์ด
// ให้ **แทนที่** คลาสสีเดิม ไม่ใช่ใส่คลาสสีที่สองข้างๆ (specificity เท่ากัน ผลจะ
// ขึ้นอยู่กับลำดับที่ Tailwind บังเอิญ emit)
//
// House style เนื้อความ: element ที่ถือ slot ได้ text-left + text-base +
// leading-relaxed + สี — ห้ามย่อหรือขยายขนาดตัวอักษรของเนื้อความ · หัวข้อจัดกลางได้
// แต่ต้องใส่ text-center ที่ตัวหัวข้อเอง **ห้ามใส่บนการ์ดหรือ <section>** เพราะมันจะ
// inherit ลงไปใน slot แล้วทำให้ย่อหน้าของทุกหน้าที่เรียกไฟล์นี้กลางตามไปด้วย
//
// หัวข้อมาจาก prop title + as เท่านั้น (เป็นหัวข้อจริงของบทความ/หน้านั้นๆ)
// **ห้าม hardcode ข้อความไทยเป็น heading ในไฟล์นี้** — เป็นโครมที่ขึ้นทุกหน้า
//
// ────────────────────────────────────────────────────────────────────────────
// รอบนี้ (ABM96) พาเลตตาม .claude/brand-spec-abm96.md §2
// 🚨 **ทิศความสว่างเหมือนรอบก่อน แต่คนละตระกูลสีทั้งชุด: การ์ดเป็นผิวสว่าง**
// เหตุผล: bg.json ของดรอปนี้เป็น mode color + color **f8b9f0 = ชมพูพาสเทล
// อิ่มตัว** (รอบก่อน LOTTOPLUS เป็น e1fef3 = เขียวมินต์จางเกือบขาว)
// และ bg.json คือแหล่งเดียวของพื้นเพจ
// ⚠️⚠️ **รอบนี้เนื้อหาสว่าง แต่โครมเข้ม** การ์ดนี้เป็น ffffff ซึ่งสว่างกว่า
// พื้นเพจ f8b9f0 ชัดเจนพอให้แยกชั้นได้ ส่วน navbar/footer/ticker เป็นพลัมจม
// **ห้าม "แก้" การ์ดไปเป็นผิวเข้ม** — การ์ดเข้มกับหมึก 3d0a2c จะทำให้หน้า
// terms/privacy/404 ที่พึ่ง BRAND_TEXT ตัวอักษรหายไปเลย ไม่ใช่แค่จางลง
// ⚠️⚠️ **พื้นเพจรอบนี้อิ่มตัวกว่ารอบก่อนมาก** จึงยิ่งต้องให้การ์ดเป็น ffffff
// เพื่อให้เนื้อความมีพื้นที่คอนทราสต์เต็มที่ (16.4:1 บนการ์ด เทียบกับ 10.3:1
// ถ้านั่งบนพื้นเพจตรงๆ)
//
// อ่านจากอาร์ตเวิร์กจริง: เวิร์ดมาร์กเป็น **ตัวอักษรละตินสามมิติอ้วนมน ผิวไล่จาก
// ขาวนวลลงชมพูอ่อน ตัดขอบชมพูเข้มหนาสองชั้น โดยตัว A มีหัวใจชมพูดวงเล็กซ้อนอยู่
// ในช่องกลางตัวอักษร คู่กับมาสคอตลูกหมูการ์ตูนหน้ากลมสีชมพูหูตกในจานวงกลมขอบขาว**
// ส่วนแบนเนอร์เป็นฉาก **ผ้าซาตินชมพูนวลพลิ้ว หญิงสาวผมยาวผูกโบว์ริบบิ้นชมพูใน
// ชุดลูกไม้ ต่างหูรูปหัวใจ ไพ่เอซ ลูกเต๋าชมพูจุดขาว ชิปคาสิโนชมพู-ขาว วงล้อรูเล็ต
// ขอบทอง และหัวใจชมพูสามมิติลอยกระจาย**
// ⚠️ **ผ้าซาตินกับสีผิวของนางแบบเป็นวัตถุในภาพ ไม่ใช่สี UI** —
// พื้นเพจมาจาก bg.json เท่านั้น **ห้ามอนุมานจากรูป**
//
// บทบาทสีในไฟล์นี้:
//   ผิวการ์ด ffffff · การ์ดสำรอง fff5fb · พื้นถมอ่อน/ชั้นยก fcd9ee ·
//   เส้นบาง f3a7d3 · ขอบตกแต่ง/ออรา e0509f · ออราสว่าง ff7ac2
//   พื้นเพจ f8b9f0 · โครม 440d31 / 2b0620 / 5e1746
//   ชมพูบานเย็น a30d63 = **สีหัวข้อ** (7.5:1 บนการ์ด ผ่าน AA สบาย) และเป็นสีของ
//     ลิงก์กับ <strong> ทั้งเว็บ
//   หมึก 3d0a2c = สีเนื้อความ (= BRAND_TEXT) 16.4:1 บนการ์ด · หมึกรอง 7a4263 (7.5:1)
//   ทองเข้ม 6e4705 (8.2:1) ถือตัวอักษรบนการ์ดสว่างได้
// 🚨🚨 **f3a7d3 · fcd9ee · e0509f · ff7ac2 — ห้ามเป็นสีตัวอักษรในไฟล์นี้เด็ดขาด**
//   เป็นเส้น/ขอบ/ออรา/พื้นถมเท่านั้น (e0509f ได้แค่ 3.6:1 บนการ์ดขาว)
// 🚨🚨 **f2c14e (ทองอำพัน) ก็ห้ามถือตัวอักษรบนการ์ดขาว — 1.7:1** มันถือตัวอักษร
//   ได้เฉพาะบนโครมเข้มเท่านั้น ซึ่งไม่ใช่ไฟล์นี้ บนการ์ดสว่างให้ใช้ 6e4705 แทน
// ⚠️⚠️ **ffffff fff5fb fcd9ee f3a7d3 e0509f ff7ac2 f8b9f0 เป็นผิว ไม่ใช่สีตัวอักษร**
// ส่วน **3d0a2c (16.4:1) · 7a4263 (7.5:1) · a30d63 (7.5:1) · 6e4705 (8.2:1)
// ถือตัวอักษรบนการ์ดสว่างได้ทั้งหมด**
// rgba() ที่อนุญาตรอบนี้: rgba(163,13,99,α) · rgba(224,80,159,α) ·
// rgba(255,122,194,α) · rgba(209,26,126,α) · rgba(242,193,78,α) ·
// rgba(61,10,44,α) · rgba(68,13,49,α)
// ⚠️ **เงาบนการ์ดสว่างต้องเบา** — ใช้ rgba(61,10,44,0.10) ปกติ และ hover ยกเป็น
// rgba(163,13,99,0.18) **ห้ามลอกค่า alpha ของรอบก่อนมา**
//
// ⚠️ ไฟล์นี้เป็นของแบรนด์ก่อนหน้าทุกรอบ ห้ามเหมาว่าสีที่เจอเป็นของรอบนี้ ต้องเทียบ
// เป็น **"ค่า"** ไม่ใช่ "ตระกูลสี"
// 🚨🚨 **กับดักรอบนี้: okkub88 เป็นแบรนด์ ชมพูบานเย็น/ทอง = ตระกูลสีเดียวกับ
// รอบนี้เป๊ะ** รองลงมาคือ ถอนชัวร์168 (ชมพูบับเบิลกัม) และ 123BET (แดงชาด/ชมพูบลัช)
// → **"เจอชมพูหรือทอง ไม่ได้แปลว่าเป็นของรอบนี้"** ต้องเทียบให้ตรงหกหลัก
// ค่าที่กวาดออกครบแล้วจากไฟล์นี้ (ของ LOTTOPLUS รอบก่อนทันที):
//   e1fef3 f0fdf7 d2f3e4 a3ddc3 19a97c 2fd49b 052e22 03201a 0a4433
//   0d3326 3f6f5c 046c4e 8a6508 e2b32a c8d4d0 e9fbf3
//   + rgba(4,108,78) rgba(25,169,124) rgba(47,212,155) rgba(226,179,42) rgba(13,51,38)
// **ลิสต์เฮกซ์เต็มของทุกแบรนด์อยู่ที่ .claude/brand-spec-abm96.md §2b —
// ไม่ซ้ำลงที่นี่โดยตั้งใจ** ลิสต์เดียวที่อัปเดตที่เดียวย่อมไม่หลุดกันเอง
//   ⚠️⚠️ คู่ที่ต้องสงสัยว่าพิมพ์ผิดก่อนเสมอ:
//   d91a73 (okkub88) ↔ d11a7e **(ต่างกันไม่กี่หลัก อันตรายที่สุดรอบนี้)** ·
//   9c0f55 b01160 (okkub88) / a30d1a (123BET) / c2178b (ZANE96) ↔ a30d63
//     **(a30d1a กับ a30d63 ต่างกันสองหลักท้ายเท่านั้น)** ·
//   fb439b fc4da1 (okkub88) / fa63b9 (ถอนชัวร์168) ↔ e0509f ·
//   f9b2d9 (okkub88) / ffb3de (ถอนชัวร์168) / f5b9bd (LOTTO189) ↔ f3a7d3 ·
//   ffd6fa ffe3f5 fff4fb (okkub88) / f7dfe4 fdf5f6 f7e4e9 (123BET) /
//     f8e6f9 (ZANE96) / fdeaf5 (ถอนชัวร์168) ↔ ffffff/fff5fb/fcd9ee
//     **(ขาวอมชมพูใกล้กันมาก ต้องอ่านค่า)** ·
//   6a0f3c (okkub88) / 6d0b3f (ถอนชัวร์168) ↔ 440d31/3d0a2c ·
//   ffd84d dca53a e2b32a e9b53c ↔ f2c14e · 6b4708 7a4a0c 8a6508 ↔ 6e4705 ·
//   046c4e 0d3326 3f6f5c 19a97c ↔ **ไม่มีคู่ — เขียวออกจากพาเลตทั้งตระกูล**
// ⚠️ (เขียว 00B900 ของปุ่ม LINE และเขียว success ของฟีดถอนเงินอยู่ไฟล์อื่น
//   **คงไว้ ห้ามกลืนเข้าชมพูของรอบนี้** — สองค่านั้นเป็นสีเชิงความหมาย
//   ไม่ใช่สีแบรนด์)
// (เฮกซ์ของแบรนด์เก่าในคอมเมนต์ด้านบนเขียนแบบ **ไม่มี #** โดยตั้งใจ เพื่อไม่ให้
// การ sweep ไล่หาสีของแบรนด์เก่าใน src/ สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#f3a7d3] bg-[#ffffff] p-8 text-left text-base leading-relaxed text-[#3d0a2c] shadow-[0_10px_30px_rgba(61,10,44,0.10)] transition-all duration-500 hover:border-[#e0509f] hover:shadow-[0_15px_40px_rgba(163,13,99,0.18)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[3px] bg-gradient-to-r from-[#f2c14e] via-[#e0509f] to-[#a30d63]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#ff7ac2]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#ff7ac2]/40"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#f2c14e]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#f2c14e]/40"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="text-2xl leading-normal font-black tracking-wide text-[#a30d63]">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#f2c14e] to-[#a30d63] shadow-[0_0_10px_rgba(163,13,99,0.4)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
