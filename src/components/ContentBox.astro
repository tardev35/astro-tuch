---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// KOON234 (รอบมรกตเข้ม-ทองบนเขียวเกือบดำ 2026-10-09): เว็บพนันออนไลน์รวมช่องทาง
// เข้าเล่น พาเลตต์ตาม brand-spec §2 รอบนี้พลิกจากคู่ฟ้าสด-เหลืองมะนาวของ แตกดี168
// มาเป็นคู่ "มรกต-ทอง" — การ์ดยังเป็นกระจกมืดเหมือนเดิมแต่ย้ายจากผิวกรมท่าเกือบดำ
// #0a1726 มาเป็นผิวเขียวเกือบดำ #0d2414 ให้เข้ากับ bg.json ของดรอปนี้ซึ่งเป็น
// {"mode":"color","color":"#061801"} = เขียวเกือบดำ (ไม่ใช่ดำตันแบบรอบก่อน)
// การ์ดจึงต้อง "ยก" ขึ้นจากพื้นด้วยผิวที่สว่างกว่าพื้นหนึ่งขั้นพอให้เห็นขอบ
//
// ทองแบรนด์ #cc920a มาจาก vivid อันดับหนึ่งของ logo.webp (เลข 234 ที่เป็นทองไล่เงา)
// ถือขอบการ์ด เส้นคาดบนสุด และเงาตอน hover · ทองสว่าง #f7d14e เป็นปลายสว่างของ
// ไล่เฉดหัวข้อและออรามุมขวาล่างตอน hover · ทองซีด #fde9a6 เป็นปลายสว่างสุด ·
// เขียวมรกต #0a6b32 (dominant ของทั้งสามภาพ = ม่านและสูทเขียว) เป็นฮิวที่สองจริง
// อยู่ที่ออรามุมซ้ายบนและปลายเย็นของไล่เฉดหัวข้อ · เขียวสว่าง #2fbf6a เป็นปลาย
// สว่างของเขียว · ทองเข้ม #8a6204 กับเขียวเข้ม #043d1c เป็นปลายเข้มของเส้นใต้
// และออรา ไม่เคยถือตัวอักษร เนื้อความเป็นขาวอมเขียว #e8f2e6 (= BRAND_TEXT)
// — 14.7:1 บนผิวการ์ดนี้
//
// ชุดฟ้า-เหลืองของ แตกดี168 (#0193fb #7bcffb #d4ecfd #064a86 #fce604 #fff48a
// #c9a703 #0a1726 #dbeafe rgba(1,147,251,α) rgba(252,230,4,α)) และชุดทอง
// เมทัลลิกของ 789BETTING ก่อนหน้านั้น (#fad354 #ffe79a #ddab33 #c9881f #17130a
// #f3e7cd) ออกครบทุกจุดแล้ว — ทองของรอบนี้เป็นคนละค่า อย่าปล่อยของเก่าไว้เพราะ
// "ดูคล้ายกัน"
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#cc920a]/35 bg-[#0d2414]/95 p-8 text-left text-base leading-relaxed text-[#e8f2e6] shadow-[0_10px_30px_rgba(0,0,0,0.6)] backdrop-blur-xl transition-all duration-500 hover:border-[#cc920a]/75 hover:shadow-[0_15px_40px_rgba(204,146,10,0.32)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#cc920a]/75 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#0a6b32]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#2fbf6a]/35">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#8a6204]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#f7d14e]/28">
    </div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#fde9a6] via-[#f7d14e] to-[#2fbf6a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#f7d14e] via-[#cc920a] to-[#043d1c] shadow-[0_0_10px_rgba(204,146,10,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
