---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#d9a441]/32 bg-[#14100a]/92 p-8 text-left text-base leading-relaxed text-[#e8dcc4] shadow-[0_10px_30px_rgba(6,4,2,0.72)] backdrop-blur-xl transition-all duration-500 hover:border-[#f5d98a]/60 hover:shadow-[0_15px_40px_rgba(217,164,65,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#d9a441]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#d9a441]/32"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#c2cad3]/14 blur-[60px] transition-all duration-500 group-hover:bg-[#c2cad3]/24"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#d9a441]/32 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffeec2] to-[#7a5312] shadow-[0_0_10px_rgba(217,164,65,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffeec2] via-[#f5d98a] to-[#a67a2a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
