---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// MIRACLE55 (รอบทอง-เงินโครเมียม 2026-09-25): การ์ดดำอมน้ำตาล #14100a ในกรอบทอง
// แบรนด์ #d9a62b ออร่ามุมซ้ายบนเป็นทอง #d9a62b มุมขวาล่างเป็นเงินโครเมียม
// #d2d3d4 — คู่ทอง/เงินนี้มาจากโลโก้ที่ MI เป็นทอง RACLE เป็นเงิน และ 55 เป็นทอง
// หัวข้อจึงไล่ทองสว่าง #fee47b → เงิน #eaeaea → ทองแบรนด์ #d9a62b ตามลำดับนั้น
// เนื้อความ #e8e6e1 (BRAND_TEXT) — ทอง #e6bf4e กับครีมอุ่น #efe6cf บนพื้น
// #151109 ของ KINGDOM66 รอบก่อนถูกแทนครบทุกจุดแล้ว แบรนด์นั้นไม่มีสีเงินอยู่เลย
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#d9a62b]/45 bg-[#14100a]/94 p-8 text-left text-base leading-relaxed text-[#e8e6e1] shadow-[0_10px_30px_rgba(5,4,3,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#fee47b]/70 hover:shadow-[0_15px_40px_rgba(252,218,101,0.34)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#d9a62b]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#d9a62b]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#fee47b]/38"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#d2d3d4]/12 blur-[60px] transition-all duration-500 group-hover:bg-[#d2d3d4]/22"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#fee47b] via-[#eaeaea] to-[#d9a62b] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#fee47b] via-[#eaeaea] to-[#d9a62b] shadow-[0_0_10px_rgba(252,218,101,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
