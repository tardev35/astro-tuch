---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// BRAZIL999 (รอบเขียวมรกต-เงินโครเมียม 2026-09-25): การ์ดดำอมเขียว #0a1a0c ในกรอบ
// เขียวแบรนด์ #22c55e ออร่ามุมซ้ายบนเป็นเขียว #22c55e มุมขวาล่างเป็นเงินโครเมียม
// #aab4bf — คู่เขียว/เงินนี้มาจากโลโก้ที่ BRAZIL เป็นเงินโครเมียมและ 999 เป็นเขียว
// หัวข้อจึงไล่เขียวสว่าง #b6ff9c → เงิน #f1f5f9 → เขียวแบรนด์ #22c55e ตามลำดับนั้น
// เนื้อความ #dfeadd (BRAND_TEXT) — ทอง #d9a62b/#fee47b บนพื้น #14100a ของ MIRACLE55
// รอบก่อนถูกแทนครบทุกจุดแล้ว แบรนด์นี้ไม่มีทองเป็นสีหลักเลย
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#22c55e]/45 bg-[#0a1a0c]/94 p-8 text-left text-base leading-relaxed text-[#dfeadd] shadow-[0_10px_30px_rgba(4,10,5,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#7cf25c]/70 hover:shadow-[0_15px_40px_rgba(34,197,94,0.34)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#22c55e]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#22c55e]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#7cf25c]/38"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#aab4bf]/12 blur-[60px] transition-all duration-500 group-hover:bg-[#aab4bf]/22"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#b6ff9c] via-[#f1f5f9] to-[#22c55e] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#b6ff9c] via-[#f1f5f9] to-[#22c55e] shadow-[0_0_10px_rgba(34,197,94,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
