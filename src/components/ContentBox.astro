---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#2f7a2a]/60 bg-[#072a13]/92 p-8 text-left text-base leading-relaxed text-[#d6e6cc] shadow-[0_10px_30px_rgba(2,10,5,0.45)] backdrop-blur-xl transition-all duration-500 hover:border-[#69b522]/65 hover:shadow-[0_15px_40px_rgba(105,181,34,0.24)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#69b522]/18 blur-[60px] transition-all duration-500 group-hover:bg-[#69b522]/28"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#0b5232]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#dbaa8a]/30"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#2f7a2a]/55 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#9ada4e] to-[#0b5232] shadow-[0_0_10px_rgba(105,181,34,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#eefae4] via-[#b6e87a] to-[#dbaa8a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
