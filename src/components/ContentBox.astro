---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro and privacy.astro render every section
// through this file and never follow the per-brand ContentBox rotation, so it
// must carry the CURRENT brand's colours even when index.astro picks another
// variant. Nothing inside those pages names a colour — they inherit from the
// card below, which is what keeps them brand-neutral.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the two
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// GODBET88: การ์ดเป็นดำอมน้ำตาล #0a0806 เส้นขอบและออร่าซ้ายเป็นทองหลักของโลโก้
// #c2a55c ออร่าขวาเป็นทองประกาย #f6e7b8 หัวข้อไล่จากทองประกายไปทองหลักแล้วคืน
// เป็นทองอ่อน — แบรนด์นี้มีสีเดียวคือทอง แยกสองฝั่งด้วยความสว่าง ไม่ใช่ด้วยสีที่สอง
// แดงเลือดหมูของแบรนด์ก่อนหายไปทั้งหมด
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#c2a55c]/40 bg-[#0a0806]/92 p-8 text-left text-base leading-relaxed text-[#ece1cc] shadow-[0_10px_30px_rgba(0,0,0,0.72)] backdrop-blur-xl transition-all duration-500 hover:border-[#f6e7b8]/60 hover:shadow-[0_15px_40px_rgba(194,165,92,0.32)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#c2a55c]/28 blur-[60px] transition-all duration-500 group-hover:bg-[#e2c87f]/38"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#f6e7b8]/14 blur-[60px] transition-all duration-500 group-hover:bg-[#f6e7b8]/22"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#c2a55c]/40 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f6e7b8] to-[#5c4418] shadow-[0_0_10px_rgba(194,165,92,0.65)]" />
          <HeadingTag class="bg-gradient-to-r from-[#f6e7b8] via-[#c2a55c] to-[#e2c87f] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
