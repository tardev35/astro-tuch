---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#6b1fa8]/65 bg-[#180226]/92 p-8 text-left text-base leading-relaxed text-[#e6cfe9] shadow-[0_10px_30px_rgba(13,1,20,0.6)] backdrop-blur-xl transition-all duration-500 hover:border-[#c2249b]/70 hover:shadow-[0_15px_40px_rgba(194,36,155,0.26)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#c2249b]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#c2249b]/30"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#fb44b3]/18 blur-[60px] transition-all duration-500 group-hover:bg-[#ffb3e2]/28"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#6b1fa8]/60 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fb44b3] to-[#c2249b] shadow-[0_0_10px_rgba(251,68,179,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fdeaf8] via-[#fb44b3] to-[#c2249b] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
