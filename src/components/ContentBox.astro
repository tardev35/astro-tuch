---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// CK268 (รอบเขียวนีออน-โครเมียม-ดำ 2026-09-30): เว็บเกมสล็อตออนไลน์ พาเลตต์มาจาก
// โลโก้ที่ตัว C กับเลข 68 เป็นโครเมียมขาวเงิน ส่วนตัว K กับเลข 2 เป็นเขียวนีออน
// และแบนเนอร์พื้นดำสนิทที่มีริ้วแสงเขียวนีออนกับชิปคาสิโนเขียว-ดำ — การ์ดดำอมเขียว
// #0b160b ในกรอบเขียวนีออนแบรนด์ #8bfc13 ออร่ามุมซ้ายบนเป็นเขียวนีออน มุมขวาล่าง
// เป็นเขียวลึกรอง #12a008 หัวข้อไล่เฉดโครเมียม #e8f0e6 → เขียวนีออน #8bfc13 →
// เขียวลึก #1a7a08 เนื้อความ #d5e6cd (BRAND_TEXT) — ชุดทอง-แดงของ GOT777 รอบก่อน
// (#f5c518 #ffe9a8 #d21622 #fff6dd #ece0cb #160b06) ออกครบแล้ว
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#8bfc13]/45 bg-[#0b160b]/94 p-8 text-left text-base leading-relaxed text-[#d5e6cd] shadow-[0_10px_30px_rgba(1,4,1,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#c9ff8f]/70 hover:shadow-[0_15px_40px_rgba(139,252,19,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#8bfc13]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#8bfc13]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#c9ff8f]/38"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#12a008]/18 blur-[60px] transition-all duration-500 group-hover:bg-[#12a008]/30"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#e8f0e6] via-[#8bfc13] to-[#1a7a08] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#e8f0e6] via-[#8bfc13] to-[#1a7a08] shadow-[0_0_10px_rgba(139,252,19,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
