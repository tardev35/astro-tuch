---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro, /promotion,
// /about-us, /contact-us, /ทางเข้า, /ทดลองเล่น, /login และ /register render ตัว
// เนื้อหาผ่านไฟล์นี้ (10 หน้ารอบนี้) และไม่เคยเดินตาม ContentBox rotation ของ index
// → ไฟล์นี้ต้องถือพาเลตของ "แบรนด์ปัจจุบัน" เสมอ ต่อให้ index เลือก variant อื่น
// ⚠️ รอบนี้ **หน้าแรกใช้ไฟล์นี้ด้วย** (docx §5 "สมัครเล่นสล็อต 3 ขั้นตอน") แต่
// ต่อให้รอบหน้าไม่ใช้ ไฟล์นี้ก็ยังเป็น shared chrome เต็มตัวเพราะสิบหน้าข้างบนยังใช้
// ⚠️ รอบนี้ /ตรวจหวย และ /แนวทาง ยังอยู่ใน src/pages-disabled/ (แบรนด์สล็อต)
// จำนวนหน้าจึงเป็น 10 — ไม่กระทบสถานะ shared chrome ของไฟล์นี้
// ⚠️ หน้าถาวรพวกนั้น **ไม่ประกาศสีตัวอักษรเองเลยสักจุด** ย่อหน้าทั้งหมด inherit สีมา
// จากการ์ดข้างล่าง ถ้าการ์ดไม่ตั้ง text color หน้าเหล่านั้นจะตกไปใช้ default ของ
// เบราว์เซอร์ → คลาส `text-left text-base leading-relaxed text-[#3b0b26]` บน
// element ที่ถือ <slot /> ห้ามหายไปสักตัว
//
// Flattened single-slot variant (ทำเมื่อ 2026-07-26): `isolate` บนการ์ด + `-z-10`
// บนชั้นตกแต่ง absolute ทุกชั้น slot จึง render เป็นลูกตรงของการ์ด
// **ห้ามเพิ่ม wrapper <div> รอบ slot กลับมา** และถ้าจะเปลี่ยนสีตัวอักษรของการ์ด
// ให้ **แทนที่** คลาสสีเดิม ไม่ใช่ใส่คลาสสีที่สองข้างๆ (specificity เท่ากัน ผลจะ
// ขึ้นอยู่กับลำดับที่ Tailwind บังเอิญ emit)
//
// House style เนื้อความ: element ที่ถือ slot ได้ `text-left text-base
// leading-relaxed <สี>` — ห้ามย่อหรือขยายขนาดตัวอักษรของเนื้อความ (คลาส sm/lg
// ของ text-* ใช้กับย่อหน้าไม่ได้) · หัวข้อจัดกลางได้ แต่ต้อง
// ใส่ text-center ที่ตัวหัวข้อเอง **ห้ามใส่บนการ์ดหรือ <section>** เพราะมันจะ
// inherit ลงไปใน slot แล้วทำให้ย่อหน้าของทุกหน้าที่เรียกไฟล์นี้กลางตามไปด้วย
//
// หัวข้อมาจาก prop `title` + `as` เท่านั้น (เป็นหัวข้อจริงของบทความ/หน้านั้นๆ)
// **ห้าม hardcode ข้อความไทยเป็น heading ในไฟล์นี้** — เป็นโครมที่ขึ้นทุกหน้า
//
// ───────────────────────────────────────────────────────────────────────────
// รอบนี้ (หมูบิน168) พาเลตตาม .claude/brand-spec-moobin168.md §2
// 🚨🚨 **รอบนี้กลับทิศจากรอบก่อนทั้งเว็บ: จากธีมมืด เป็นธีมสว่าง** เหตุผล:
// bg.json ของดรอปนี้เป็น {"mode":"color","color":"#ffe5ff"} = **ชมพูพาสเทลสว่างมาก**
// (รอบก่อนเป็น 140000 = ดำอมแดง) และ bg.json คือแหล่งเดียวของพื้นเพจ
// **ห้าม "แก้" การ์ดกลับไปเป็นพื้นมืด** — การ์ดมืดบนหมึก #3b0b26 จะทำให้หน้า
// terms/privacy/404 ที่พึ่ง BRAND_TEXT ตัวอักษรหายไปเลย ไม่ใช่แค่จางลง
// (นี่คือความผิดพลาด "กลับด้าน" ของคำเตือนที่เคยอยู่บรรทัดนี้รอบก่อนเป๊ะๆ)
//
// อ่านจากอาร์ตเวิร์กจริง: โลโก้เป็น **ลูกหมูการ์ตูนชมพูมีปีกนางฟ้าสีขาว คู่กับ
// ตัวอักษร "หมูบิน168" ทรงบับเบิลสามมิติชมพูบานเย็นสลับขาวมุก มีหัวใจชมพูลอย
// ประดับ บนพื้นโปร่ง** ส่วนแบนเนอร์เป็นฉาก **สตูดิโอพื้นขาวสะอาด** และสไลด์ทั้งสอง
// ใบก็เป็น **พื้นขาวนวล** มีแคปซูลชมพูเขียนเลข 0.3% / 0.8%
// ⚠️ **คาร์ดิแกนชมพู เสื้อกล้ามขาว และสีผิวนักแสดงเป็นวัตถุในภาพ ไม่ใช่สี UI** —
// พื้นเพจมาจาก bg.json เท่านั้น
//
// บทบาทสีในไฟล์นี้:
//   ผิวการ์ด #ffffff · ชั้นยก/แถบอ่อน #fff0f8 · wash #ffeef7 · พื้นเพจ #ffe5ff
//   ชมพูเข้ม #c2185b = **สีหัวข้อ** (5.9:1 บนการ์ดขาว ผ่าน AA สบาย) และเป็นปลาย
//     เย็นของเส้นใต้หัวข้อ
//   ชมพูสด #fa539c = **ฮิวนำ แต่เป็นสีพื้น/เส้น/ออราเท่านั้น** อ่านจากอาร์ตเวิร์ก
//     ตรงๆ (ตัวอักษรในโลโก้ · หัวใจ · แคปซูลบนสไลด์)
//   เส้น #f7bcd9 · เส้นเข้ม #ef8dbd (**ทั้งคู่ห้ามถือตัวอักษร**)
//   หมึก #3b0b26 = สีเนื้อความ (= BRAND_TEXT) 16.8:1 บนการ์ดขาว · หมึกรอง #7a4463 (7.4:1)
// 🚨🚨 **#fa539c บนพื้นขาวได้แค่ 3.2:1 — ห้ามเป็นสีตัวอักษรในไฟล์นี้เด็ดขาด**
//   และ **ห้ามถมพื้น #fa539c แล้ววางหมึกขาว** (3.2:1 เหมือนกัน) พื้นชมพูที่รับ
//   หมึกขาวได้ต้องเป็น #c2185b (5.9:1) ลงไป ส่วนพื้น #fa539c รับได้เฉพาะ
//   หมึกพลัมเข้ม #3b0b26 (5.3:1)
// ⚠️⚠️ **#ffffff #fff0f8 #ffeef7 #ffe5ff #f7bcd9 #ef8dbd #fdc6c3 #ffd1cd #fb8cc0
// #fa539c ห้ามถือตัวอักษรบนผิวสว่าง** ส่วน **#3b0b26 (16.8:1) · #7a4463 (7.4:1) ·
// #c2185b (5.9:1) · #8e0f41 (9.2:1) ถือตัวอักษรได้**
// rgba() ที่อนุญาตรอบนี้: rgba(250,83,156,α) · rgba(251,140,192,α) ·
// rgba(194,24,91,α) · rgba(59,11,38,α) · rgba(253,198,195,α)
//
// ⚠️ ไฟล์นี้เป็นของแบรนด์ก่อนหน้าทุกรอบ ห้ามเหมาว่าสีที่เจอเป็นของรอบนี้ ต้องเทียบ
// เป็น **"ค่า"** ไม่ใช่ "ตระกูลสี"
// รอบก่อนหน้าทันที (สล็อต168 แดงเจลนำ + มุกอุ่นรอง บนดำอมแดง — **ตัวที่เสี่ยง
// หลงเหลือสูงสุด**) ที่กวาดออกครบแล้วจากไฟล์นี้:
//   fb2e33 cb0b0d d81115 b00d11 8a0608 f0e6e4 c9b9b7 e3d6d4 7d6f6e 1c0607 0b0000
//   2a0c0d 140000 551c1e + rgba(251,46,51) rgba(203,11,13) rgba(240,230,228)
// 🚨🚨 **ชมพูคือตระกูลของรอบนี้ จึงต้องเทียบทีละค่าแน่นที่สุด** ชมพู/แดงของ
// แบรนด์อื่นที่ **ห้ามใช้**:
//   f5469f ff8dc6 8c0f52 fcd434 ffeaa0 (มีโชค168 — ⚠️⚠️ **f5469f ห่างจาก #fa539c
//   แค่ R5/G13/B3 และ 8c0f52 ห่างจาก #8e0f41 แค่ R2/B17 เจอที่ไหนแปลว่าพิมพ์ผิด**) ·
//   fa63b9 ffb3de (ถอนชัวร์168 — ⚠️⚠️ **fa63b9 มี R=fa ตรงกับ #fa539c เป๊ะ**) ·
//   dd1b74 a4186b 4a0d35 2d0720 f7dcf6 f0ccf5 (มีทรัพย์168 — ⚠️⚠️ **a4186b มี 18
//   อยู่กลางค่าเหมือน #c2185b และ 4a0d35/2d0720 ใกล้ #3b0b26**) ·
//   ff2e52 e01238 c9102f (มาดาม168) · fb1b32 ff8f9c 5c0410 (มีเฮ168) ·
//   fa0513 ff5a5f ffadaf (สมหวัง168) · b3121b 5a0a0e f2bba5 (ขวัญใจ168) ·
//   fb141b ff5f63 ffa0a2 db040b 8a0609 (GT66B) · eb0305 e40303 c20305 ff4446
//   (โปรดี168) · c30303 8f0505 e81313 ffdbdb fff1ef ffeee8 (รวยแท้168) ·
//   d9212a 8e1a16 (ดวงเศรษฐี168) · e4021b (รวยเทพ168) · d30304 a00203 ff6b6e
//   (รับตัง168) · dc0203 f5282a (หวย365) · ff3b14 6d0804 (FLASH877) ·
//   fce2d4 fcd4c3 f5e7c8 (หวยคิง — ⚠️ ใกล้ #fdc6c3)
// ⚠️ ทอง/เหลืองของแบรนด์เก่า (รอบนี้ไม่มีทองเลยสักเฉด):
//   ffd94a e3a712 9d6f06 b07d08 (รวย168) · eeae12 fded41 9f600d (พักยก168) ·
//   dcb95f b8862b 96681f (รวยแท้168) · f5ba14 fcee52 b37c0b (เงินทอง168) ·
//   fdcb0c fefb6b 8a6504 (สบาย168) · fee45d e6a416 b8780d (ยูฟ้า168) ·
//   e5a81b ffe08a bb8410 (UFA324) · fbc134 ffe87a cf9a18 (NAZA168 ตัวละติน) ·
//   d4922c fdfc71 (ufalion168) · f7c92b ffe6a3 (ขวัญใจ168) · e3b23c ffe5a8
//   (สมหวัง168) · f9a826 (รวยแทร่168) · fcd45c (มีเฮ168) · ffdc8c f0b429
//   (รับตัง168) · f0c878 (ดวงเศรษฐี168) · f0b46a d9803a (โปรดี168) ·
//   ffc93c ffeab0 (หวย365) · f5b61d (PIGPG) · fef54b (นินจา168) · c9cb63 (สาธุ168)
// ⚠️ ฟ้า/น้ำเงินของแบรนด์เก่า (รอบนี้ไม่มีน้ำเงินเลย):
//   1177e8 0e68cc 0a4ea8 00091f 0b1733 16234a (มาดาม168) · 1fd8f0 0bb6d4 1d4fd8
//   143aa0 (นาซ่า168) · 18a5e2 0d6b9b 0a5176 a9d7f2 (ร่ำรวย168) · 2cc3fc 6bdcfb
//   0a7fbd 063a57 (สบาย168) · 039cfa 0494f5 c3ebfc (รวยแทร่168) · 32bcfb a9e9ff
//   07335f (นินจา168) · 2f9ff5 a8dcff d6ecff (สบายเบท168) · 0360f3 0292fb 6ec8ff
//   (TSDET911)
// ⚠️ ครีม/เบจ/น้ำตาล/เทาเงินของแบรนด์เก่า — รอบนี้ไม่มีเลย:
//   f4ead6 d6c6a8 1f0f04 4e2f11 291d0f (พักยก168) · f4e4d3 e4cbb3 (ร่ำรวย168) ·
//   ecd5c4 d2b9a4 29210f (เงินทอง168) · eadfce (ขวัญใจ168) · f3ece0 bfb8aa
//   (รวย168) · e8eaee b4b9c2 6b7079 dde1e7 (รวย168) · d9dfe9 b3bdd6 f4eef1
//   (มาดาม168) · e0e0df c0c0bf a1a09e (พักยก168) · e8ecf1 a8b2bf 78828f (ยูฟ้า168) ·
//   8792a0 b9c2cc (UFA324) · fdfcfd b4bcc2 eceaea (GT66B) · cfdcec 9db4d4 (TSDET911)
//   ⚠️⚠️ **ผิวสว่างของรอบนี้เป็นขาวอมชมพู (R≥B>G)** ซึ่งต่างจากครีม/งาช้าง
//   (R>G>B) และจากขาวอมฟ้า (B>G>R) ทุกค่าข้างบน — ตรวจทีละค่า อย่าตัดสินด้วยสายตา
// ⚠️ ม่วง/เขียวของแบรนด์เก่า — รอบนี้ไม่มีเลย: 7e22ce d946ef a855f7 (CEO66) ·
//   7505cc b453ff c07cff d9b8ff 3a0565 (KMD88) · 0b7d28 0a5f1c 0f9b35 (สาธุ168)
//   (เขียว #00B900 ของปุ่ม LINE และเขียว success ของฟีดถอนเงินอยู่ไฟล์อื่น คงไว้)
// (เฮกซ์ของแบรนด์เก่าในคอมเมนต์ด้านบนเขียนแบบ **ไม่มี #** โดยตั้งใจ เพื่อไม่ให้
// การ sweep ไล่หาสีของแบรนด์เก่าใน src/ สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#f7bcd9] bg-white p-8 text-left text-base leading-relaxed text-[#3b0b26] shadow-[0_10px_30px_rgba(194,24,91,0.12)] transition-all duration-500 hover:border-[#fa539c] hover:shadow-[0_15px_40px_rgba(250,83,156,0.22)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[3px] bg-gradient-to-r from-transparent via-[#fa539c] to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#fa539c]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#fa539c]/30"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#fdc6c3]/35 blur-[60px] transition-all duration-500 group-hover:bg-[#fdc6c3]/50"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="text-2xl leading-normal font-black tracking-wide text-[#c2185b]">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#fa539c] to-[#fdc6c3] shadow-[0_0_10px_rgba(250,83,156,0.45)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
