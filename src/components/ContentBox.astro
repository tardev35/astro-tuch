---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// TND168 (รอบทองมังกรบนดำสนิท 2026-10-12): พาเลตต์ตาม brand-spec §2
// รอบนี้กลับเข้าสาย "ทองบนดำ" หลังรอบ PUNPRO168 ที่เป็นชมพูฮอตพิงก์-ทองบนพลัม
// และเป็น **ฮิวเดียวล้วน** ไม่มีสีที่สองเลย เพราะโลโก้เป็นเหรียญตรามังกรจีนทอง
// ขัดเงากับตัวอักษร TND168 ทองสามมิติ บนพื้นโปร่ง/ดำ ไม่มีโลหะหรือสีที่สองอยู่ใน
// งานศิลป์เลย ส่วนแบนเนอร์และสไลด์เป็นฉากคาสิโนดำ-ทองล้วนเช่นกัน
// ⚠️ พื้นเพจรอบนี้เป็น **ดำสนิท** (bg.json = {"mode":"color","color":"#000000"})
// จึงไม่มีชั้นที่ "ลึกกว่าพื้นเพจ" ได้จริง — แผ่นที่จมสุดคือ #070502
// ลำดับความลึก: #1b1307 ผิวยก (การ์ดใบนี้) / #120c04 กลาง / #070502 จม / #000000 พื้น
//
// ทองหลัก #dfa310 (ฮิวเดียวของแบรนด์ — ตัวมังกรและตัวอักษรบนโลโก้) ถือขอบการ์ด
// เส้นคาดบนสุด และออรามุมซ้ายบน · ทองสว่าง #ffe4a3 (ไฮไลต์บนเกล็ดมังกรและขอบ
// ตัวอักษร) เป็นต้นสว่างสุดของหัวข้อและสีตอน hover · ทองไฮไลต์ #ffc93d เป็นกลาง
// ไล่เฉดหัวข้อ · ทองลึก #8a5c09 กับบรอนซ์ลึก #43240b เป็นปลายเข้มของเส้นใต้และ
// ออรามุมขวาล่าง — ทั้งคู่ไม่เคยถือตัวอักษร
// ลำดับ สว่าง→ไฮไลต์→ทองหลัก ของหัวข้อคือลำดับที่ตาอ่านโลโก้จริง (ไฮไลต์บนเกล็ด
// ก่อน แล้วเนื้อทอง แล้วจบที่เงาทองเข้มของตัวอักษรสามมิติ)
// เนื้อความเป็นงาช้างอุ่น #f0e9dc (= BRAND_TEXT) — 15.3:1 บนผิวการ์ดนี้
//
// ⚠️ ไฟล์นี้เป็นของแบรนด์ก่อนหน้าทุกรอบ ห้ามเหมาว่าสีที่เจอเป็นของรอบนี้ ต้องเทียบ
// เป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **รอบนี้กับดักคือทอง** ทองมาแล้วเก้าในสิบเอ็ดรอบ
// หลังสุด "มีทองอยู่" จึงไม่ได้พิสูจน์อะไรเลย: ชุดชมพูฮอตพิงก์-ทองของ PUNPRO168
// (#f41571 #ff5ca8 #fce343 #ffd94a #f0c3dc #fde7f2 #8a0a45 #4a0426 #2a0012
// #4a1038 #3a0a2a #2e0022 #1c0014) ชุดทองเมทัลลิก-บรอนซ์ของ 789BETTING
// (#fad354 #ffe79a #ddab33 #8a6410 #c9881f #f3e7cd #b5a888 #060402 #0a0802
// #2a2008 #17130a) ชุดทองอำพันเสือของ TIGERWIN369 (#d98324 #f7b733 #ffd98a
// #f7e4c0 #e3cfae #8a5214 #4a2a08 #1a0d02 #2d1c0a #1c1206 #0f0903) ชุดทอง
// แชมเปี้ยน-เงินโครเมียมของ UFA324 (#e5a81b #b9c2cc #231c0e #17130a #0d0b06
// #f0e8d4 #ffcf5e #ffe08a #7d5a07 #43300a #464f5a) ชุดชมพู-ทองของ FAH999
// (#ff3fa4 #ff6cbb #ffd1ea #fde8f3 #f5c53d #9c6f08 #b3006a #4a0b42 #3a0534
// #2e002c #210220) ชุดทองเป็ด-ส้มปากเป็ดของ DUCK1688 (#f3bb34 #fde464 #c8901a
// #8a5f08 #5c3f04 #f58b2a #ffc98a #a3510c #1a1203 #f6ecd9 #d8c69b #1f1709
// #171106 #0d0903) ชุดทองอวกาศ-เงินโครเมียมของ NAZA168 (#fbc134 #ffe87a #cf9a18
// #96690a #6b4a05 #eef2f8 #cfd6e3 #9aa6bb #3f4859 #fdf3df #d9c9a6 #4e3406
// #432b03 #382400 #241700) ชุดทองสายฟ้า-แดงเลือดนกของ FLASH877 (#f5c518 #ffdd73
// #b8860f #ff3b14 #8c0f0a) ชุดแดงเสือโคร่ง-ทองถ่านไฟของ SUPERSLOTCLUB (#e8232a
// #f2b705 #ffd666 #c08a0b) ชุดเขียว-ทองของ KINGKONG555 (#8ce023 #f2c230 #ffe066
// #a87a08 #06220a) ชุดม่วง-ทองของ WEPLAY168 (#a435f0 #5b1a75 #1e0a3c) และชุดแดง
// แล็กเกอร์ของ PIGPG (#d4200d #f5b61d #ffd87a) ออกครบทุกจุดแล้ว
// ⚠️ ทองหลักของรอบนี้ (#dfa310) เข้มและอุ่นกว่าทองทุกตัวในลิสต์ที่ใกล้ที่สุด —
// R=223 G=163 B=16 เทียบกับ #e5a81b ของ UFA324 (R=229 G=168 B=27) และ #edbb23
// ของ 1SS365 ให้เทียบเป็นตัวเลข ไม่ใช่ด้วยตา
// ⚠️ **รอบนี้ไม่มีชมพู ไม่มีม่วง/พลัม ไม่มีเงิน/เทา ไม่มีเขียว ไม่มีน้ำเงิน
// ไม่มีส้มอิฐ/ส้มอำพัน และไม่มีแดงเลย**
//
// ⚠️ #8a5c09 และ #43240b ห้ามถือตัวอักษรทุกขนาด อยู่ได้เฉพาะในไล่เฉดของเส้นคาด
// ในออรา และเป็นขอบ ส่วน #ffe4a3 (13.5:1) กับ #dfa310 (7.6:1) และ #c9b88e
// (8.9:1) ถือตัวอักษรรองได้จริง และ #ffc93d (10.2:1) คือตัวที่ใช้ไฮไลต์ในเนื้อความ
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#dfa310]/40 bg-[#1b1307]/95 p-8 text-left text-base leading-relaxed text-[#f0e9dc] shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#dfa310]/80 hover:shadow-[0_15px_40px_rgba(223,163,16,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#dfa310]/75 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#dfa310]/40 blur-[60px] transition-all duration-500 group-hover:bg-[#ffe4a3]/30"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#43240b]/70 blur-[60px] transition-all duration-500 group-hover:bg-[#ffc93d]/28"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#ffe4a3] via-[#ffc93d] to-[#dfa310] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#dfa310] via-[#8a5c09] to-[#43240b] shadow-[0_0_10px_rgba(223,163,16,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
