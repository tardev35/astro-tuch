---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// WEPLAY168 (รอบม่วงนีออน-ทองอาร์เขต 2026-10-09): เว็บสล็อตออโต้
// พาเลตต์ตาม brand-spec §2 รอบนี้พลิกจากคู่ "แดงแล็กเกอร์-ทอง" ของ PIGPG มาเป็นคู่
// "ม่วง-ทอง" — การ์ดยังเป็นกระจกมืดเหมือนเดิมแต่ย้ายจากผิวแดงเกือบดำ #3a0d07
// มาเป็นผิวม่วงเข้ม #1e0a3c ซึ่ง "สว่างกว่า" พื้นเพจของดรอปนี้ที่เป็น
// {"mode":"color","color":"#0c0024"} = ครามเกือบดำอมม่วง การ์ดจึงยกลอยขึ้นจาก
// พื้นแทนที่จะจมลงไปแบบรอบที่แล้ว ซึ่งเข้ากับงานศิลป์ที่เป็นตู้เกมนีออนเรืองแสง
//
// ม่วงแบรนด์ #a435f0 (ฮิวของตัวเครื่องเกมพกพาในโลโก้และผนังตู้อาร์เขตในแบนเนอร์)
// ถือขอบการ์ด เส้นคาดบนสุด และออรามุมซ้ายบน · ทองแบรนด์ #fbe455 (vivid อันดับหนึ่ง
// ของ banner1.png = เหรียญทองและตัวเลข 168) เป็นฮิวที่สองจริง อยู่ที่ปลายไล่เฉด
// หัวข้อ เส้นใต้ และเงาตอน hover · ทองอุ่น #ffd23d เป็นช่วงกลางของไล่เฉด ·
// เงินอมม่วง #efe6ff (ตัวอักษร WEPLAY บนโลโก้) เป็นปลายสว่างสุดของหัวข้อ ·
// ทองเข้ม #c98a05 กับม่วงลึก #5b1a75 เป็นปลายเข้มของเส้นใต้และออรา — ทั้งคู่
// ไม่เคยถือตัวอักษร
// เนื้อความเป็นขาวอมม่วงอ่อน #ece2ff (= BRAND_TEXT) — 12.5:1 บนผิวการ์ดนี้
//
// ชุดแดง-ทองของ PIGPG (#d4200d #a30303 #f5b61d #ffd87a #fdf9e4 #b07a06 #6b0402
// #3a0d07 #fdeedd rgba(245,182,29,α) rgba(212,32,13,α)) ชุดมรกต-ทองของ KOON234
// (#0a6b32 #2fbf6a #cc920a #f7d14e #fde9a6 #0d2414 #e8f2e6) และชุดฟ้า-เหลืองของ
// แตกดี168 (#0193fb #fce604 #0a1726 #dbeafe) ออกครบทุกจุดแล้ว — ทองของรอบนี้
// เป็นคนละค่า อย่าปล่อยของเก่าไว้เพราะ "ดูคล้ายกัน"
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#a435f0]/40 bg-[#1e0a3c]/95 p-8 text-left text-base leading-relaxed text-[#ece2ff] shadow-[0_10px_30px_rgba(0,0,0,0.6)] backdrop-blur-xl transition-all duration-500 hover:border-[#a435f0]/80 hover:shadow-[0_15px_40px_rgba(251,228,85,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#fbe455]/75 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#a435f0]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#a435f0]/35"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#c98a05]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#fbe455]/28"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#efe6ff] via-[#fbe455] to-[#ffd23d] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#fbe455] via-[#c98a05] to-[#5b1a75] shadow-[0_0_10px_rgba(251,228,85,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
