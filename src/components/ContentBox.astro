---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro and privacy.astro render every section
// through this file and never follow the per-brand ContentBox rotation, so it
// must carry the CURRENT brand's colours even when index.astro picks another
// variant. Nothing inside those pages names a colour — they inherit from the
// card below, which is what keeps them brand-neutral.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the two
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// ENTER55: การ์ดดำสนิท #0b0b0a ขอบทองหลัก #c4a255 ออร่าสองมุมเป็นทองหลักกับทอง
// ประกาย #ebd484 หัวข้อไล่จากทองประกาย → ทองหลัก → ทองกลาง #d2b262
// รอบก่อนใช้แถบทองแนวตั้งข้างหัวข้อ รอบนี้เปลี่ยนเป็นเส้นทองพาดขอบบน
// ของการ์ดกับขีดสั้นใต้หัวข้อ ให้รูปทรงต่างจากเดิมแม้จะเป็นโทนทองเหมือนกัน
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#c4a255]/40 bg-[#0b0b0a]/94 p-8 text-left text-base leading-relaxed text-[#ded8cb] shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#ebd484]/60 hover:shadow-[0_15px_40px_rgba(196,162,85,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#c4a255]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#c4a255]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#d2b262]/36"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#ebd484]/12 blur-[60px] transition-all duration-500 group-hover:bg-[#ebd484]/20"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#ebd484] via-[#c4a255] to-[#d2b262] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#ebd484] to-[#8a6d2c] shadow-[0_0_10px_rgba(196,162,85,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
