---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#7e22ce]/60 bg-[#2c0f45]/92 p-8 text-left text-base leading-relaxed text-[#f2e3f7] shadow-[0_10px_30px_rgba(10,3,19,0.45)] backdrop-blur-xl transition-all duration-500 hover:border-[#f472b6]/65 hover:shadow-[0_15px_40px_rgba(244,114,182,0.24)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#f472b6]/18 blur-[60px] transition-all duration-500 group-hover:bg-[#f472b6]/28"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#4c1d6b]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#fcd34d]/30"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#7e22ce]/55 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ec4899] to-[#4c1d6b] shadow-[0_0_10px_rgba(244,114,182,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fdf2f8] via-[#f9a8d4] to-[#fcd34d] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
