---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// FLASH877 (รอบทองสายฟ้า-แดงเลือดนก 2026-10-10): พาเลตต์ตาม brand-spec §2
// รอบนี้พลิกทิศจากคู่ "แดงเสือโคร่ง-ทองถ่านไฟ" ของ SUPERSLOTCLUB — ที่นั่นแดงนำ
// บนพื้นน้ำตาลถ่านเกือบดำ รอบนี้ **ทองนำ** บนพื้นแดงเต็มตัว เพราะ bg.json ของดรอป
// นี้เป็น {"mode":"color","color":"#5c0000"} = แดงเลือดนกเข้ม ไม่ใช่เกือบดำ
// การ์ดจึงเป็นผิวยก #7d1008 ซึ่ง "สว่างกว่า" พื้นเพจ การ์ดยกลอยขึ้นมาเหมือนเหรียญ
// กลมขอบทองในโลโก้ที่ลอยอยู่หน้าฉากม่านกำมะหยี่แดง
//
// ทองสายฟ้า #f5c518 (ฮิวหลัก — สายฟ้าผ่ากลางเหรียญ และคำว่า FLASH บนโลโก้)
// ถือขอบการ์ด เส้นคาดบนสุด ออรามุมซ้ายบน และต้นไล่เฉดหัวข้อ · แดงสายฟ้า #ff3b14
// (ฮิวที่สองจริง — เลข 877 บนโลโก้) เป็นปลายไล่เฉดหัวข้อและออรามุมขวาล่าง ลำดับ
// ทอง→แดง ของหัวข้อคือลำดับที่ตาอ่านโลโก้จริง (FLASH ทอง แล้วค่อย 877 แดง) ·
// ทองสว่าง #ffdd73 เป็นต้นสว่างสุดของหัวข้อ · ทองเข้ม #b8860f กับแดงลึกสุด
// #5a0603 เป็นปลายเข้มของเส้นใต้ — ทั้งคู่ไม่เคยถือตัวอักษร
// เนื้อความเป็นครีมอมส้มอ่อน #fdf0e2 (= BRAND_TEXT) — 11.6:1 บนผิวการ์ดนี้
//
// ⚠️ แบรนด์รอบก่อน (SUPERSLOTCLUB) **ก็แดง-ทองเหมือนกัน** เจอแดงหรือทองที่ไหน
// ห้ามเหมาว่าเป็นของรอบนี้ ต้องเทียบเป็น "ค่า" ไม่ใช่ "ตระกูลสี": ชุดแดงเสือโคร่ง-
// ทองถ่านไฟของ SUPERSLOTCLUB (#e8232a #ff5a46 #7d0f12 #4a0605 #f2b705 #ffd666
// #c08a0b #a8730a #f5cbb0 #fbe8d5 #3d1709 #301105 #241000 rgba(232,35,42,α)
// rgba(242,183,5,α)) ชุดเขียว-ทองของ KINGKONG555 (#8ce023 #5cc211 #1a5c04
// #f2c230 #ffe066 #a87a08 #06220a #14380a) ชุดม่วง-ทองของ WEPLAY168 (#a435f0
// #5b1a75 #efe6ff #1e0a3c) และชุดแดงแล็กเกอร์ของ PIGPG (#d4200d #7a0505 #f5b61d
// #ffd87a) ออกครบทุกจุดแล้ว — ทองของรอบนี้ (#f5c518) เป็นคนละค่ากับทองของทุกชุด
// ข้างบน และแดงของรอบนี้ (#ff3b14) ก็คนละค่ากับ #e8232a / #d4200d
//
// ⚠️ #ff3b14 ได้แค่ ≈3.6:1 บนผิวการ์ดนี้ จึงอยู่ได้เฉพาะในไล่เฉดของหัวข้อที่เป็น
// ตัวหนาขนาดใหญ่ ในออรา และในเส้นคาด — ห้ามเอาไปถือตัวอักษรเนื้อความ
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#f5c518]/40 bg-[#7d1008]/95 p-8 text-left text-base leading-relaxed text-[#fdf0e2] shadow-[0_10px_30px_rgba(0,0,0,0.6)] backdrop-blur-xl transition-all duration-500 hover:border-[#f5c518]/80 hover:shadow-[0_15px_40px_rgba(245,197,24,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#f5c518]/75 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#f5c518]/40 blur-[60px] transition-all duration-500 group-hover:bg-[#ffdd73]/30"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#8c0f0a]/50 blur-[60px] transition-all duration-500 group-hover:bg-[#ff3b14]/28"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#ffdd73] via-[#f5c518] to-[#ff3b14] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#f5c518] via-[#b8860f] to-[#5a0603] shadow-[0_0_10px_rgba(245,197,24,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
