---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// UFA324 (รอบทองแชมเปี้ยน-เงินโครเมียม 2026-10-11): พาเลตต์ตาม brand-spec §2
// รอบนี้ตัดชมพูที่เป็น "ฮิวนำ" ออกทั้งหมด — FAH999 เป็นคู่ "ชมพูบานเย็น-ทอง" บน
// พื้นม่วงพลัม รอบนี้เป็นคู่ "ทองแชมเปี้ยน-เงินโครเมียม" บน **พื้นดำสนิท** เพราะ
// bg.json ของดรอปนี้เป็น {"mode":"color","color":"#000000"} การ์ดจึงเป็นผิวยก
// #231c0e ที่สว่างกว่าพื้นเพจ ลอยขึ้นมาเหมือนเหรียญตราถ้วยแชมป์ในโลโก้ที่ลอยอยู่
// บนฉากสนามกีฬากลางคืน
// ⚠️ พื้นเพจรอบนี้ **เป็นดำสนิท** จึงไม่มีชั้นที่ลึกกว่าพื้นได้อีกแล้ว ทุกผิวต้อง
// สว่างขึ้นจาก #000000 เท่านั้น (รอบก่อนมี #210220 ที่ลึกกว่าพื้น — รอบนี้ไม่มี)
//
// ทองแชมเปี้ยน #e5a81b (ฮิวหลัก — ถ้วยรางวัล ลูกฟุตบอลทอง และตัวอักษร UFA บน
// โลโก้) ถือขอบการ์ด เส้นคาดบนสุด และออรามุมซ้ายบน · เงินโครเมียม #b9c2cc
// (ฮิวที่สองจริง — เลข 324 บนโลโก้ และชุดกีฬาดำ-เงินในงานอาร์ต) เป็นปลายไล่เฉด
// หัวข้อและออรามุมขวาล่าง ลำดับ ทอง→เงิน ของหัวข้อคือลำดับที่ตาอ่านโลโก้จริง
// (UFA ทองก่อน แล้วค่อยไล่ไป 324 เงิน) · ทองสว่าง #ffe08a เป็นต้นสว่างสุดของ
// หัวข้อ · ทองลึก #7d5a07 กับเงินลึก #464f5a เป็นปลายเข้มของเส้นใต้ — ทั้งคู่
// ไม่เคยถือตัวอักษร
// เนื้อความเป็นงาช้างอุ่น #f0e8d4 (= BRAND_TEXT) — 13.9:1 บนผิวการ์ดนี้
//
// ⚠️ ไฟล์นี้เป็นของแบรนด์ก่อนหน้าทุกรอบ ห้ามเหมาว่าสีที่เจอเป็นของรอบนี้ ต้องเทียบ
// เป็น "ค่า" ไม่ใช่ "ตระกูลสี": ชุดชมพู-ทองของ FAH999 (#ff3fa4 #ff6cbb #ffd1ea
// #fde8f3 #f5c53d #9c6f08 #b3006a #4a0b42 #3a0534 #2e002c #210220) ชุดทองเป็ด-
// ส้มปากเป็ดของ DUCK1688 (#f3bb34 #fde464 #c8901a #8a5f08 #5c3f04 #f58b2a
// #ffc98a #a3510c #1a1203 #f6ecd9 #d8c69b #1f1709 #171106 #0d0903) ชุดทองอวกาศ-
// เงินโครเมียมของ NAZA168 (#fbc134 #ffe87a #cf9a18 #96690a #6b4a05 #eef2f8
// #cfd6e3 #9aa6bb #3f4859 #fdf3df #d9c9a6 #4e3406 #432b03 #382400 #241700)
// ชุดทองสายฟ้า-แดงเลือดนกของ FLASH877 (#f5c518 #ffdd73 #b8860f #ff3b14 #8c0f0a)
// ชุดแดงเสือโคร่ง-ทองถ่านไฟของ SUPERSLOTCLUB (#e8232a #f2b705 #ffd666 #c08a0b)
// ชุดเขียว-ทองของ KINGKONG555 (#8ce023 #f2c230 #ffe066 #a87a08 #06220a) ชุดม่วง-
// ทองของ WEPLAY168 (#a435f0 #5b1a75 #1e0a3c) และชุดแดงแล็กเกอร์ของ PIGPG
// (#d4200d #f5b61d #ffd87a) ออกครบทุกจุดแล้ว
// ⚠️ ทองของรอบนี้ (#e5a81b) ต่างจากทอง #f5c53d ของ FAH999 แค่ไม่กี่ตัวอักษร และ
// ต่างจาก #f5c518 (GOT777) #fbc134 (NAZA168) #f3bb34 (DUCK1688) พอๆ กัน
// ส่วนเงิน #b9c2cc ของรอบนี้ไม่ใช่ #cfd6e3 ของ NAZA168 — ห้ามเทียบด้วยตา
//
// ⚠️ #7d5a07 #43300a และ #464f5a ห้ามถือตัวอักษรทุกขนาด อยู่ได้เฉพาะในไล่เฉดของ
// เส้นคาด ในออรา และเป็นขอบ ส่วน #e5a81b (8.2:1) กับ #b9c2cc (9.4:1) ถือตัวอักษร
// รองได้จริง และ #ffcf5e (11.6:1) คือตัวที่ใช้ไฮไลต์ในเนื้อความ
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#e5a81b]/40 bg-[#231c0e]/95 p-8 text-left text-base leading-relaxed text-[#f0e8d4] shadow-[0_10px_30px_rgba(0,0,0,0.6)] backdrop-blur-xl transition-all duration-500 hover:border-[#e5a81b]/80 hover:shadow-[0_15px_40px_rgba(229,168,27,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#e5a81b]/75 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#e5a81b]/40 blur-[60px] transition-all duration-500 group-hover:bg-[#ffe08a]/30"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#464f5a]/60 blur-[60px] transition-all duration-500 group-hover:bg-[#b9c2cc]/28"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#ffe08a] via-[#e5a81b] to-[#b9c2cc] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#e5a81b] via-[#7d5a07] to-[#464f5a] shadow-[0_0_10px_rgba(229,168,27,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
