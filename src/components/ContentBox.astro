---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// HENG38 (รอบมรกต-ทอง 2026-09-22): การ์ดเขียวเข้ม #061f0f ในกรอบทองบรอนซ์
// #a5761a ออร่าสองมุมเป็นทองหลัก #f3cf63 กับมรกตสด #15833c หัวข้อไล่จากทองอ่อน
// #fbeeb0 → ทองหลัก #f3cf63 → ทองบรอนซ์ #a5761a ซึ่งเป็นไล่เฉดเดียวกับมงกุฎและ
// ลายกนกบนโลโก้ ส่วนเนื้อความใช้ #e6e2d2 (BRAND_TEXT) ขาวอมงาช้างให้เข้ากับพื้น
// เขียวเข้ม — โทนน้ำเงินกรมท่าของรอบก่อนหายไปทั้งหมด
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#a5761a]/55 bg-[#061f0f]/94 p-8 text-left text-base leading-relaxed text-[#e6e2d2] shadow-[0_10px_30px_rgba(3,20,10,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#f3cf63]/70 hover:shadow-[0_15px_40px_rgba(243,207,99,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#f3cf63]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#f3cf63]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#f3cf63]/34"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#15833c]/30 blur-[60px] transition-all duration-500 group-hover:bg-[#15833c]/45"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#fbeeb0] via-[#f3cf63] to-[#a5761a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#fbeeb0] to-[#a5761a] shadow-[0_0_10px_rgba(243,207,99,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
