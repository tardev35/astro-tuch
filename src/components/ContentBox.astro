---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#7a1219]/70 bg-[#0f0708]/92 p-8 text-left text-base leading-relaxed text-[#e8dadb] shadow-[0_10px_30px_rgba(4,2,2,0.7)] backdrop-blur-xl transition-all duration-500 hover:border-[#e01a2b]/70 hover:shadow-[0_15px_40px_rgba(224,26,43,0.26)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#e01a2b]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#e01a2b]/32"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#cfd4da]/16 blur-[60px] transition-all duration-500 group-hover:bg-[#cfd4da]/26"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#7a1219]/70 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ff3b4d] to-[#8e0407] shadow-[0_0_10px_rgba(224,26,43,0.65)]" />
          <HeadingTag class="bg-gradient-to-r from-[#f4f6f8] via-[#ff3b4d] to-[#c1121f] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
