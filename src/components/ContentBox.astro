---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro, /promotion,
// /about-us, /contact-us, /ทางเข้า, /ทดลองเล่น, /login และ /register render ตัว
// เนื้อหาผ่านไฟล์นี้ (10 หน้ารอบนี้) และไม่เคยเดินตาม ContentBox rotation ของ index
// → ไฟล์นี้ต้องถือพาเลตของ "แบรนด์ปัจจุบัน" เสมอ ต่อให้ index เลือก variant อื่น
// ⚠️ รอบนี้ **หน้าแรกใช้ไฟล์นี้ด้วย** (หัวข้อ H2 "โปรโมชั่น ... อัปเดตใหม่ทุกสัปดาห์"
// ใช้การ์ดตัวฐานคั่นกลางชุด Neumorphism) แต่สถานะ shared chrome ของไฟล์นี้ไม่ได้
// ขึ้นกับข้อนั้น — สิบหน้าข้างบนใช้อยู่แล้วไม่ว่า index จะเลือก variant ไหน
// **ห้ามปล่อยให้มันหลุดจากชุดที่ retheme ใน P1 เด็ดขาด**
// ⚠️ รอบนี้ /ตรวจหวย และ /แนวทาง ยังอยู่ใน src/pages-disabled/ (แบรนด์สล็อต)
// จำนวนหน้าจึงเป็น 10 — ไม่กระทบสถานะ shared chrome ของไฟล์นี้
// ⚠️ หน้าถาวรพวกนั้น **ไม่ประกาศสีตัวอักษรเองเลยสักจุด** ย่อหน้าทั้งหมด inherit สีมา
// จากการ์ดข้างล่าง ถ้าการ์ดไม่ตั้ง text color หน้าเหล่านั้นจะตกไปใช้ default ของ
// เบราว์เซอร์ → คลาสชุด text-left + text-base + leading-relaxed + สีหมึกของรอบนี้
// บน element ที่ถือ <slot /> ห้ามหายไปสักตัว (รอบนี้สีหมึกคือ #241046)
// ⚠️ เขียนชื่อคลาสสีแบบถอดวงเล็บโดยตั้งใจ — Tailwind สแกนไฟล์นี้แบบ plain text
// รวมถึงคอมเมนต์ด้วย การพิมพ์ `text-[#xxxxxx]` เต็มรูปในคอมเมนต์จึงทำให้ยูทิลิตี้
// ของค่านั้นถูก generate ลง stylesheet จริง (รอบนี้เจอค่าของแบรนด์ก่อนหลุดมาทางนี้)
//
// Flattened single-slot variant (ทำเมื่อ 2026-07-26): `isolate` บนการ์ด + `-z-10`
// บนชั้นตกแต่ง absolute ทุกชั้น slot จึง render เป็นลูกตรงของการ์ด
// **ห้ามเพิ่ม wrapper <div> รอบ slot กลับมา** และถ้าจะเปลี่ยนสีตัวอักษรของการ์ด
// ให้ **แทนที่** คลาสสีเดิม ไม่ใช่ใส่คลาสสีที่สองข้างๆ (specificity เท่ากัน ผลจะ
// ขึ้นอยู่กับลำดับที่ Tailwind บังเอิญ emit)
//
// House style เนื้อความ: element ที่ถือ slot ได้ `text-left text-base
// leading-relaxed <สี>` — ห้ามย่อหรือขยายขนาดตัวอักษรของเนื้อความ (คลาส sm/lg
// ของ text-* ใช้กับย่อหน้าไม่ได้) · หัวข้อจัดกลางได้ แต่ต้อง
// ใส่ text-center ที่ตัวหัวข้อเอง **ห้ามใส่บนการ์ดหรือ <section>** เพราะมันจะ
// inherit ลงไปใน slot แล้วทำให้ย่อหน้าของทุกหน้าที่เรียกไฟล์นี้กลางตามไปด้วย
//
// หัวข้อมาจาก prop `title` + `as` เท่านั้น (เป็นหัวข้อจริงของบทความ/หน้านั้นๆ)
// **ห้าม hardcode ข้อความไทยเป็น heading ในไฟล์นี้** — เป็นโครมที่ขึ้นทุกหน้า
//
// ────────────────────────────────────────────────────────────────────────────
// รอบนี้ (ZANE96) พาเลตตาม .claude/brand-spec-zane96.md §2
// 🚨 **เนื้อหายังเป็นธีมสว่างและโครมยังเข้มเหมือนรอบก่อน แต่ฮิวคนละตระกูลสิ้นเชิง**
// เหตุผล: bg.json ของดรอปนี้เป็น {"mode":"color","color":"#f8e6f9"} = **ไลแลคอมชมพูจาง**
// (รอบก่อนเป็น fef6fb = ขาวอมชมพูที่จางกว่านี้) และ bg.json คือแหล่งเดียวของพื้นเพจ
// ⚠️ **navbar/footer/ticker รอบนี้เป็นผิวเข้ม (#190b3d) แต่ไฟล์นี้ไม่ใช่** —
// **ห้าม "แก้" การ์ดให้เป็นพื้นมืดตามโครม** การ์ดมืดบนหมึก #241046 จะทำให้หน้า
// terms/privacy/404 ที่พึ่ง BRAND_TEXT ตัวอักษรหายไปเลย ไม่ใช่แค่จางลง
//
// อ่านจากอาร์ตเวิร์กจริง: โลโก้เป็น **เวิร์ดมาร์กสามมิติผิวโครเมียมล้วน ไม่มีมาสคอต
// "ZANE" ไล่ฟ้าอิเล็กทริก→ม่วง + "96" แมเจนต้า ตัดขอบขาวหนา มีประกายดาวสี่แฉก
// บนพื้นโปร่ง** ส่วนแบนเนอร์เป็นฉาก **สตูดิโอขาว-ไลแลค มีตู้สล็อต 777 ผิวแก้วม่วง
// ชิปคาสิโนแมเจนต้า เชอร์รี่ชมพู และลำแสงนีออนทแยง** และสไลด์ทั้งสองใบเป็น **ฉาก
// นีออนม่วง-แมเจนต้า** พิมพ์เลข 0.3% / 0.8% ตัวชมพูเข้ม
// ⚠️ **ชุดเมทัลลิกโฮโลแกรม ไม้เชอร์รี่ และสีผิวนักแสดงเป็นวัตถุในภาพ ไม่ใช่สี UI**
// — พื้นเพจมาจาก bg.json เท่านั้น
//
// บทบาทสีในไฟล์นี้:
//   ผิวการ์ด #ffffff · ชั้นยก/แถบอ่อน #f6edfe · wash #ece0fb · พื้นเพจ #f8e6f9
//   ไวโอเลตลึก #5411c4 = **สีหัวข้อ** (9.3:1 บนการ์ดขาว ผ่าน AA สบาย) และเป็นปลาย
//     เย็นของเส้นใต้หัวข้อ
//   ไวโอเลตนีออน #7a1bd6 = **ฮิวนำ** (7.1:1 บนขาว ถือตัวอักษรได้ แต่ในไฟล์นี้ใช้เป็น
//     ขอบ/ออรา/ปลายไล่เฉด) อ่านจากอาร์ตเวิร์กตรงๆ (เวิร์ดมาร์ก · ตู้สล็อต · เพชร)
//   ฟ้าอิเล็กทริก #2b3fd9 (7.5:1) · แมเจนต้า #c2178b (5.6:1) = คู่รอง
//   แมเจนต้านีออน #f23bb4 · ไวโอเลตอ่อน #bb6dff · ฟ้าอ่อน #7aa7ff · เส้น #dcc6f4 ·
//     เส้นเข้ม #9a6fd0 (**ทั้งหมดห้ามถือตัวอักษรบนผิวสว่าง**)
//   หมึก #241046 = สีเนื้อความ (= BRAND_TEXT) 16.8:1 บนการ์ดขาว · หมึกรอง #6b4a86 (7.1:1)
// 🚨🚨 **#f23bb4 บนพื้นขาวได้แค่ 3.5:1 และ #bb6dff ได้ 3.1:1 — ห้ามเป็นสี
//   ตัวอักษรในไฟล์นี้เด็ดขาด** และ **ขาวบนสองค่านั้นได้ 2.6 / 2.0:1** พื้นที่รับหมึก
//   ขาวได้ต้องเป็น #c2178b (5.6:1) ขึ้นไปหาเข้ม
// ⚠️⚠️ **#ffffff #f6edfe #ece0fb #f8e6f9 #dcc6f4 #9a6fd0 #f23bb4 #bb6dff
// #7aa7ff ห้ามถือตัวอักษรบนผิวสว่าง** ส่วน **#241046 (16.8:1) · #6b4a86 (7.1:1) ·
// #5411c4 (9.3:1) · #7a1bd6 (7.1:1) · #2b3fd9 (7.5:1) · #c2178b (5.6:1) ถือตัวอักษรได้**
// rgba() ที่อนุญาตรอบนี้: rgba(122,27,214,α) · rgba(84,17,196,α) ·
// rgba(194,23,139,α) · rgba(242,59,180,α) · rgba(36,16,70,α) · rgba(220,198,244,α)
//
// ⚠️ ไฟล์นี้เป็นของแบรนด์ก่อนหน้าทุกรอบ ห้ามเหมาว่าสีที่เจอเป็นของรอบนี้ ต้องเทียบ
// เป็น **"ค่า"** ไม่ใช่ "ตระกูลสี"
// รอบก่อนหน้าทันที (MEXICANOSLOT แดงเม็กซิกันนำ + ทองรอง **ตัวที่เสี่ยงหลงเหลือสูงสุด**)
// ที่กวาดออกครบแล้วจากไฟล์นี้:
//   de2b1e f2a033 a81410 c81e12 9d140c 6f0e08 3f130d 80453a 2b100a 431a10 1d0a06
//   8c3a22 fdeee2 e8c6ae fed7b5 fec28d f6c4a4 e2855c fde4d3 fff3ea fef6fb 117a41
//   2bb061 f2543f + rgba(222,43,30) rgba(242,160,51) rgba(168,20,16) rgba(63,19,13)
// 🚨🚨 **ม่วง/แมเจนต้า/ฟ้า คือสามตระกูลของรอบนี้ และทั้งสามเคยเป็นฮิวนำของ
//   แบรนด์เก่ามาแล้ว จึงต้องเทียบทีละค่าแน่นที่สุด** ค่าที่ **ห้ามใช้**:
//   ม่วง — 7e22ce d946ef a855f7 (CEO66) · 7505cc b453ff c07cff d9b8ff 3a0565 (KMD88)
//     ⚠️⚠️ **b453ff ↔ #bb6dff ต่างไบต์เดียว · 7505cc ↔ #7a1bd6 ใกล้ที่สุดในลิสต์**
//   ชมพู/แมเจนต้า — ffd6fa fff4fb ffe3f5 ffe9f7 f9b2d9 f479b9 f4a7cf 6a0f3c 95486b
//     9c0f55 fb439b fc74b5 ffc2e2 d91a73 b01160 85094a fd6cb2 fc7cba fc4da1 (okkub88)
//     ⚠️⚠️ **d91a73 ↔ #c2178b · fb439b / fc4da1 ↔ #f23bb4 · 9c0f55 / 85094a
//     ↔ #5411c4 — สองค่าหลังนี้ค้างอยู่ในไฟล์ตระกูล Neumorphism ทุกตัวที่รอบนี้
//     หยิบมาใช้ ต้องออกให้หมด** ·
//     fa539c c2185b 8e0f41 fb8cc0 fdc6c3 ffd1cd f7bcd9 ef8dbd ffe5ff fff0f8 ffeef7
//     3b0b26 54123a 7a2350 ffe9f5 7a4463 (หมูบิน168) · f5469f ff8dc6 8c0f52 (มีโชค168)
//     · fa63b9 ffb3de (ถอนชัวร์168) · dd1b74 a4186b 4a0d35 2d0720 (มีทรัพย์168) ·
//     f41571 ff5ca8 (PUNPRO168)
//   ฟ้า/ไซแอน/น้ำเงิน — 00bfff 12b4ef b6e3f0 7fcbe8 4fb8ea 06283f 0b4a73 2a87c4
//     eaf7ff f0faff e4f6fb 355f7d 0f5684 1a6ea8 (โบ๊ะบ๊ะ168) · 1177e8 0e68cc 0a4ea8
//     00091f 0b1733 16234a (มาดาม168) · 1fd8f0 0bb6d4 1d4fd8 143aa0 (นาซ่า168) ·
//     18a5e2 0d6b9b 0a5176 a9d7f2 (ร่ำรวย168) · 2cc3fc 6bdcfb 0a7fbd 063a57 (สบาย168)
//     · 039cfa 0494f5 c3ebfc (รวยแทร่168) · 32bcfb a9e9ff 07335f (นินจา168) ·
//     2f9ff5 a8dcff d6ecff 0b3f78 e8f4ff (สบายเบท168) · 0360f3 0292fb 6ec8ff (TSDET911)
//     · 00f3ff e0ffff 60a5fa 4b5563 030712 1f2937 (default cyber-neon/dark)
//     ⚠️⚠️ **60a5fa ↔ #7aa7ff · 1d4fd8 ↔ #2b3fd9**
// ⚠️ แดง/ทอง/เหลืองของแบรนด์เก่า — **รอบนี้ไม่มีแดงและไม่มีทองเลยสักเฉด**:
//   fb2e33 cb0b0d d81115 b00d11 8a0608 · ff2e52 e01238 c9102f · fb1b32 ff8f9c 5c0410 ·
//   fa0513 ff5a5f ffadaf · b3121b 5a0a0e f2bba5 · fb141b ff5f63 ffa0a2 · eb0305 e40303
//   c20305 · c30303 8f0505 e81313 · d9212a 8e1a16 · e4021b · d30304 a00203 · dc0203
//   f5282a · ff3b14 6d0804 · ffd94a e3a712 9d6f06 b07d08 · eeae12 fded41 9f600d ·
//   dcb95f b8862b 96681f · f5ba14 fcee52 b37c0b · fdcb0c fefb6b 8a6504 · fee45d e6a416
//   b8780d · e5a81b ffe08a bb8410 · fbc134 ffe87a cf9a18 · d4922c fdfc71 · f7c92b
//   ffe6a3 · e3b23c ffe5a8 · f9a826 · fcd45c · ffdc8c f0b429 · f0c878 · f0b46a d9803a
//   · ffc93c ffeab0 · f5b61d · fef54b · c9cb63 · ffd84d · fcd434 ffeaa0 · ffc82e
// ⚠️ ครีม/เบจ/น้ำตาล/เทาเงินของแบรนด์เก่า — รอบนี้ไม่มีเลย:
//   f4ead6 d6c6a8 1f0f04 4e2f11 291d0f · f4e4d3 e4cbb3 · ecd5c4 d2b9a4 29210f ·
//   eadfce · f3ece0 bfb8aa · f0e6e4 c9b9b7 e3d6d4 7d6f6e · e8eaee b4b9c2 6b7079
//   dde1e7 · d9dfe9 b3bdd6 f4eef1 · e0e0df c0c0bf a1a09e · e8ecf1 a8b2bf 78828f ·
//   8792a0 b9c2cc · fdfcfd b4bcc2 eceaea · cfdcec 9db4d4 · d9c9a6 cfd6e3
//   ⚠️⚠️ **ผิวสว่างของรอบนี้เป็นไลแลคอมชมพู (B≥R>G)** ซึ่งต่างจากครีม/งาช้าง
//   (R>G>B) และจากขาวอมฟ้า (B>G>R) ทุกค่า — ตรวจทีละค่า อย่าตัดสินด้วยสายตา
// ⚠️ เขียวของแบรนด์เก่า — รอบนี้ไม่มีเขียวแบรนด์เลย: 0b7d28 0a5f1c 0f9b35 0c3a16
//   061f0c (สาธุ168) (เขียว #00B900 ของปุ่ม LINE และเขียว success ของฟีดถอนเงิน
//   อยู่ไฟล์อื่น คงไว้)
// (เฮกซ์ของแบรนด์เก่าในคอมเมนต์ด้านบนเขียนแบบ **ไม่มี #** โดยตั้งใจ เพื่อไม่ให้
// การ sweep ไล่หาสีของแบรนด์เก่าใน src/ สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#dcc6f4] bg-white p-8 text-left text-base leading-relaxed text-[#241046] shadow-[0_10px_30px_rgba(84,17,196,0.12)] transition-all duration-500 hover:border-[#7a1bd6] hover:shadow-[0_15px_40px_rgba(122,27,214,0.22)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[3px] bg-gradient-to-r from-[#2b3fd9] via-[#7a1bd6] to-[#f23bb4]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#7a1bd6]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#7a1bd6]/30"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#bb6dff]/40 blur-[60px] transition-all duration-500 group-hover:bg-[#bb6dff]/60"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="text-2xl leading-normal font-black tracking-wide text-[#5411c4]">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#7a1bd6] to-[#f23bb4] shadow-[0_0_10px_rgba(122,27,214,0.45)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
