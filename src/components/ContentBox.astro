---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro, /promotion,
// /about-us, /contact-us, /ทางเข้า, /ทดลองเล่น, /login และ /register render ตัว
// เนื้อหาผ่านไฟล์นี้ (10 หน้ารอบนี้) และไม่เคยเดินตาม ContentBox rotation ของ index
// → ไฟล์นี้ต้องถือพาเลตของ "แบรนด์ปัจจุบัน" เสมอ ต่อให้ index เลือก variant อื่น
// ⚠️ รอบนี้ **หน้าแรกไม่ได้ใช้ไฟล์นี้** (shape-mix รอบนี้เป็นชุด Premium/CyberCut/
// Two/3ThreePremium/Special) แต่ไฟล์นี้ยังเป็น shared chrome เต็มตัวเพราะสิบหน้า
// ข้างบนยังใช้ — **ห้ามปล่อยให้มันหลุดจากชุดที่ retheme ใน P1 เด็ดขาด**
// ⚠️ รอบนี้ /ตรวจหวย และ /แนวทาง ยังอยู่ใน src/pages-disabled/ (แบรนด์สล็อต)
// จำนวนหน้าจึงเป็น 10 — ไม่กระทบสถานะ shared chrome ของไฟล์นี้
// ⚠️ หน้าถาวรพวกนั้น **ไม่ประกาศสีตัวอักษรเองเลยสักจุด** ย่อหน้าทั้งหมด inherit สีมา
// จากการ์ดข้างล่าง ถ้าการ์ดไม่ตั้ง text color หน้าเหล่านั้นจะตกไปใช้ default ของ
// เบราว์เซอร์ → คลาส `text-left text-base leading-relaxed text-[#06283f]` บน
// element ที่ถือ <slot /> ห้ามหายไปสักตัว
//
// Flattened single-slot variant (ทำเมื่อ 2026-07-26): `isolate` บนการ์ด + `-z-10`
// บนชั้นตกแต่ง absolute ทุกชั้น slot จึง render เป็นลูกตรงของการ์ด
// **ห้ามเพิ่ม wrapper <div> รอบ slot กลับมา** และถ้าจะเปลี่ยนสีตัวอักษรของการ์ด
// ให้ **แทนที่** คลาสสีเดิม ไม่ใช่ใส่คลาสสีที่สองข้างๆ (specificity เท่ากัน ผลจะ
// ขึ้นอยู่กับลำดับที่ Tailwind บังเอิญ emit)
//
// House style เนื้อความ: element ที่ถือ slot ได้ `text-left text-base
// leading-relaxed <สี>` — ห้ามย่อหรือขยายขนาดตัวอักษรของเนื้อความ (คลาส sm/lg
// ของ text-* ใช้กับย่อหน้าไม่ได้) · หัวข้อจัดกลางได้ แต่ต้อง
// ใส่ text-center ที่ตัวหัวข้อเอง **ห้ามใส่บนการ์ดหรือ <section>** เพราะมันจะ
// inherit ลงไปใน slot แล้วทำให้ย่อหน้าของทุกหน้าที่เรียกไฟล์นี้กลางตามไปด้วย
//
// หัวข้อมาจาก prop `title` + `as` เท่านั้น (เป็นหัวข้อจริงของบทความ/หน้านั้นๆ)
// **ห้าม hardcode ข้อความไทยเป็น heading ในไฟล์นี้** — เป็นโครมที่ขึ้นทุกหน้า
//
// ───────────────────────────────────────────────────────────────────────────
// รอบนี้ (โบ๊ะบ๊ะ168) พาเลตตาม .claude/brand-spec-bohba168.md §2
// 🚨 **รอบนี้ยังเป็นธีมสว่างเหมือนรอบก่อน แต่ฮิวคนละตระกูลสิ้นเชิง** เหตุผล:
// bg.json ของดรอปนี้เป็น {"mode":"color","color":"#00bfff"} = **ฟ้าสกายอิ่มตัว**
// (รอบก่อนเป็น ffe5ff = ชมพูพาสเทล) และ bg.json คือแหล่งเดียวของพื้นเพจ
// **ห้าม "แก้" การ์ดกลับไปเป็นพื้นมืด** — การ์ดมืดบนหมึก #06283f จะทำให้หน้า
// terms/privacy/404 ที่พึ่ง BRAND_TEXT ตัวอักษรหายไปเลย ไม่ใช่แค่จางลง
//
// อ่านจากอาร์ตเวิร์กจริง: โลโก้เป็น **หัวการ์ตูนผู้หญิงผมมวยสูงผูกโบว์ขาว ทำหน้า
// ตกใจ ตาโต ปากอ้า สองมือแตะแก้ม คู่กับตัวอักษร "โบ๊ะบ๊ะ168" ทรงบับเบิลสามมิติ
// ไล่เฉดฟ้าสกายเข้มลงหาฟ้าอ่อนเกือบขาว ตัดขอบขาวหนา บนพื้นโปร่ง** ส่วนแบนเนอร์
// เป็นฉาก **สตูดิโอพื้นขาวสะอาด** และสไลด์ทั้งสองใบก็เป็น **พื้นขาวนวล** พิมพ์เลข
// 0.3% / 0.8% ตัวบับเบิลฟ้า
// ⚠️ **เสื้อคลุมถักฟ้าอ่อน เสื้อกล้ามขาว ดาวเหลือง และสีผิวนักแสดงเป็นวัตถุในภาพ
// ไม่ใช่สี UI** — พื้นเพจมาจาก bg.json เท่านั้น
//
// บทบาทสีในไฟล์นี้:
//   ผิวการ์ด #ffffff · ชั้นยก/แถบอ่อน #f0faff · wash #e4f6fb · พื้นเพจ #00bfff
//   ฟ้าลึก #0f5684 = **สีหัวข้อ** (7.8:1 บนการ์ดขาว ผ่าน AA สบาย) และเป็นปลาย
//     เย็นของเส้นใต้หัวข้อ
//   ฟ้าสกาย #12b4ef = **ฮิวนำ แต่บนผิวสว่างเป็นสีพื้น/เส้น/ออราเท่านั้น** อ่านจาก
//     อาร์ตเวิร์กตรงๆ (ตัวอักษรในโลโก้ · หัวใจ · เมฆ · เลขบนสไลด์)
//   เส้น #7fcbe8 · เส้นเข้ม #4fb8ea (**ทั้งคู่ห้ามถือตัวอักษร**)
//   หมึก #06283f = สีเนื้อความ (= BRAND_TEXT) 15.2:1 บนการ์ดขาว · หมึกรอง #355f7d (6.8:1)
// 🚨🚨 **#12b4ef บนพื้นขาวได้แค่ 2.4:1 — ห้ามเป็นสีตัวอักษรในไฟล์นี้เด็ดขาด**
//   และ **ห้ามถมพื้น #12b4ef แล้ววางหมึกขาว** (2.4:1 เหมือนกัน) พื้นฟ้าที่รับ
//   หมึกขาวได้ต้องเป็น #1a6ea8 (5.5:1) ลงไป ส่วนพื้น #12b4ef รับได้เฉพาะ
//   หมึกน้ำเงินเข้ม #06283f (6.4:1)
// ⚠️⚠️ **#ffffff #f0faff #e4f6fb #00bfff #7fcbe8 #4fb8ea #b6e3f0 #12b4ef
// ห้ามถือตัวอักษรบนผิวสว่าง** ส่วน **#06283f (15.2:1) · #355f7d (6.8:1) ·
// #0f5684 (7.8:1) · #1a6ea8 (5.5:1) ถือตัวอักษรได้**
// rgba() ที่อนุญาตรอบนี้: rgba(18,180,239,α) · rgba(182,227,240,α) ·
// rgba(15,86,132,α) · rgba(6,40,63,α) · rgba(127,203,232,α)
//
// ⚠️ ไฟล์นี้เป็นของแบรนด์ก่อนหน้าทุกรอบ ห้ามเหมาว่าสีที่เจอเป็นของรอบนี้ ต้องเทียบ
// เป็น **"ค่า"** ไม่ใช่ "ตระกูลสี"
// รอบก่อนหน้าทันที (หมูบิน168 ชมพูบานเย็นนำ + ขาวอมชมพูรอง บนพลัมเข้ม — **ตัวที่
// เสี่ยงหลงเหลือสูงสุด**) ที่กวาดออกครบแล้วจากไฟล์นี้:
//   fa539c c2185b 8e0f41 fb8cc0 fdc6c3 ffd1cd f7bcd9 ef8dbd ffe5ff fff0f8 ffeef7
//   3b0b26 54123a 7a2350 ffe9f5 7a4463 + rgba(250,83,156) rgba(194,24,91)
//   rgba(59,11,38) rgba(253,198,195) rgba(251,140,192)
// 🚨🚨 **ฟ้าคือตระกูลของรอบนี้ จึงต้องเทียบทีละค่าแน่นที่สุด** ฟ้า/น้ำเงินของ
// แบรนด์อื่นที่ **ห้ามใช้**:
//   1177e8 0e68cc 0a4ea8 00091f 0b1733 16234a (มาดาม168) · 1fd8f0 0bb6d4 1d4fd8
//   143aa0 (นาซ่า168) · 18a5e2 0d6b9b 0a5176 a9d7f2 (ร่ำรวย168 — ⚠️⚠️ **18a5e2
//   ห่างจาก #12b4ef แค่ R6/G15/B13 เจอที่ไหนแปลว่าพิมพ์ผิด**) · 2cc3fc 6bdcfb
//   0a7fbd 063a57 (สบาย168 — ⚠️⚠️ **063a57 มี R=06 ตรงกับ #06283f เป๊ะ ต่างที่
//   G/B 18/24**) · 039cfa 0494f5 c3ebfc (รวยแทร่168) · 32bcfb a9e9ff 07335f
//   (นินจา168 — ⚠️ **07335f ใกล้ #06283f ที่ R**) · 2f9ff5 a8dcff d6ecff 0b3f78
//   e8f4ff (สบายเบท168) · 0360f3 0292fb 6ec8ff (TSDET911)
// ⚠️ ชมพู/แดงของแบรนด์เก่า (รอบนี้ไม่มีชมพูและไม่มีแดงเลยสักเฉด):
//   f5469f ff8dc6 8c0f52 (มีโชค168) · fa63b9 ffb3de (ถอนชัวร์168) · dd1b74 a4186b
//   4a0d35 2d0720 (มีทรัพย์168) · fb2e33 cb0b0d d81115 b00d11 8a0608 (สล็อต168) ·
//   ff2e52 e01238 c9102f (มาดาม168) · fb1b32 ff8f9c 5c0410 (มีเฮ168) ·
//   fa0513 ff5a5f ffadaf (สมหวัง168) · b3121b 5a0a0e f2bba5 (ขวัญใจ168) ·
//   fb141b ff5f63 ffa0a2 (GT66B) · eb0305 e40303 c20305 (โปรดี168) ·
//   c30303 8f0505 e81313 (รวยแท้168) · d9212a 8e1a16 (ดวงเศรษฐี168) ·
//   e4021b (รวยเทพ168) · d30304 a00203 (รับตัง168) · dc0203 f5282a (หวย365) ·
//   ff3b14 6d0804 (FLASH877) · f41571 ff5ca8 (PUNPRO168)
// ⚠️ ทอง/เหลืองของแบรนด์เก่า (รอบนี้ไม่มีทองเลยสักเฉด):
//   ffd94a e3a712 9d6f06 b07d08 (รวย168) · eeae12 fded41 9f600d (พักยก168) ·
//   dcb95f b8862b 96681f (รวยแท้168) · f5ba14 fcee52 b37c0b (เงินทอง168) ·
//   fdcb0c fefb6b 8a6504 (สบาย168) · fee45d e6a416 b8780d (ยูฟ้า168) ·
//   e5a81b ffe08a bb8410 (UFA324) · fbc134 ffe87a cf9a18 (NAZA168 ตัวละติน) ·
//   d4922c fdfc71 (ufalion168) · f7c92b ffe6a3 (ขวัญใจ168) · e3b23c ffe5a8
//   (สมหวัง168) · f9a826 (รวยแทร่168) · fcd45c (มีเฮ168) · ffdc8c f0b429
//   (รับตัง168) · f0c878 (ดวงเศรษฐี168) · f0b46a d9803a (โปรดี168) ·
//   ffc93c ffeab0 (หวย365) · f5b61d (PIGPG) · fef54b (นินจา168) · c9cb63 (สาธุ168) ·
//   ffd84d (ถอนชัวร์168) · fcd434 ffeaa0 (มีโชค168) · ffc82e (สบายเบท168)
//   ⚠️⚠️ **ดาวเหลืองกับเหรียญทองในอาร์ตเวิร์กรอบนี้เป็นวัตถุในภาพ ไม่ใช่สีแบรนด์**
// ⚠️ ครีม/เบจ/น้ำตาล/เทาเงินของแบรนด์เก่า — รอบนี้ไม่มีเลย:
//   f4ead6 d6c6a8 1f0f04 4e2f11 291d0f (พักยก168) · f4e4d3 e4cbb3 (ร่ำรวย168) ·
//   ecd5c4 d2b9a4 29210f (เงินทอง168) · eadfce (ขวัญใจ168) · f3ece0 bfb8aa
//   (รวย168) · f0e6e4 c9b9b7 e3d6d4 7d6f6e (สล็อต168) · e8eaee b4b9c2 6b7079
//   dde1e7 (รวย168) · d9dfe9 b3bdd6 f4eef1 (มาดาม168) · e0e0df c0c0bf a1a09e
//   (พักยก168) · e8ecf1 a8b2bf 78828f (ยูฟ้า168) · 8792a0 b9c2cc (UFA324) ·
//   fdfcfd b4bcc2 eceaea (GT66B) · cfdcec 9db4d4 (TSDET911)
//   ⚠️⚠️ **ผิวสว่างของรอบนี้เป็นขาวอมฟ้า (B>G>R)** ซึ่งต่างจากครีม/งาช้าง (R>G>B)
//   และจากขาวอมชมพู (R≥B>G) ของรอบก่อนทุกค่า — ตรวจทีละค่า อย่าตัดสินด้วยสายตา
// ⚠️ ม่วง/เขียวของแบรนด์เก่า — รอบนี้ไม่มีเลย: 7e22ce d946ef a855f7 (CEO66) ·
//   7505cc b453ff c07cff d9b8ff 3a0565 (KMD88) · 0b7d28 0a5f1c 0f9b35 (สาธุ168)
//   (เขียว #00B900 ของปุ่ม LINE และเขียว success ของฟีดถอนเงินอยู่ไฟล์อื่น คงไว้)
// (เฮกซ์ของแบรนด์เก่าในคอมเมนต์ด้านบนเขียนแบบ **ไม่มี #** โดยตั้งใจ เพื่อไม่ให้
// การ sweep ไล่หาสีของแบรนด์เก่าใน src/ สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#7fcbe8] bg-white p-8 text-left text-base leading-relaxed text-[#06283f] shadow-[0_10px_30px_rgba(15,86,132,0.12)] transition-all duration-500 hover:border-[#12b4ef] hover:shadow-[0_15px_40px_rgba(18,180,239,0.22)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[3px] bg-gradient-to-r from-transparent via-[#12b4ef] to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#12b4ef]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#12b4ef]/30"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#b6e3f0]/35 blur-[60px] transition-all duration-500 group-hover:bg-[#b6e3f0]/50"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="text-2xl leading-normal font-black tracking-wide text-[#0f5684]">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#12b4ef] to-[#b6e3f0] shadow-[0_0_10px_rgba(18,180,239,0.45)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
