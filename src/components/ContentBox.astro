---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// หวยดีใจ (รอบแดงแบรนด์ + เงินโครเมียม บนดำอมแดง 2026-10-04): เว็บแทงหวย
// พาเลตต์ตาม brand-spec §2 — แดงแบรนด์ #dc0409 มาจาก vivid ของ logo.webp (คำว่า
// "ดีใจ" เป็นแดงเมทัลลิก) ถือออรามุมซ้ายบนและปลายไล่เฉดของหัวข้อ เงินโครเมียม
// #eef0f4 / #c3c7d1 มาจากคำว่า "หวย" ที่เป็นโครเมียมในโลโก้เดียวกัน ถือกรอบการ์ด
// และออรามุมขวาล่าง ทอง #f3c54e เป็นสีรอง มาจากมงกุฎทองเหนือโลโก้เท่านั้น
// การ์ดเป็นผิวยก #17080c เนื้อความ #edeaf0 (= BRAND_TEXT)
//
// ชุดแดง+ทองของ หวย24 (#d20a0a #f5c33b #ffd45e #170707 #f7e2d6
// rgba(210,10,10,…) rgba(245,195,59,…)) ออกครบทุกจุดแล้ว — รอบนี้คู่สีหลักคือ
// แดง/เงิน ไม่ใช่ แดง/ทอง จึงไม่ใช่การยกค่าเดิมมาเปลี่ยนแค่เบอร์
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#c3c7d1]/40 bg-[#17080c]/95 p-8 text-left text-base leading-relaxed text-[#edeaf0] shadow-[0_10px_30px_rgba(0,0,0,0.78)] backdrop-blur-xl transition-all duration-500 hover:border-[#eef0f4]/70 hover:shadow-[0_15px_40px_rgba(220,4,9,0.35)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#eef0f4]/70 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#dc0409]/40 blur-[60px] transition-all duration-500 group-hover:bg-[#f5363d]/50">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#c3c7d1]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#eef0f4]/30">
    </div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#eef0f4] via-[#c3c7d1] to-[#f5363d] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#eef0f4] via-[#f3c54e] to-[#dc0409] shadow-[0_0_10px_rgba(220,4,9,0.65)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
