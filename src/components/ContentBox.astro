---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// TSDET911 (รอบน้ำเงินไฟฟ้า-เงินโครเมียม 2026-10-13): พาเลตต์ตาม
// .claude/brand-spec-tsdet911.md §2
// รอบนี้ออกจากสาย "ม่วงนำ ทองรอง" ของรอบก่อน (KMD88) มาเป็น **สองโทนจริง:
// น้ำเงินไฟฟ้านำ เงินโครเมียมรอง** เพราะโลโก้อ่านตรงๆ ได้ว่าคำว่า TSDET เป็น
// ตัวอักษรสามมิติสีเงินโครเมียมขัดเงา ต่อด้วยเลข 911 สีน้ำเงินไฟฟ้า มีเครื่องหมาย
// ปีกเหยี่ยวน้ำเงินอยู่ด้านซ้าย ส่วนแบนเนอร์และสไลด์เป็นฉากสตูดิโอดำที่ส่องด้วย
// ริบบิ้นแสงน้ำเงินและแฟลร์เลนส์สีฟ้า
// ⚠️ พื้นเพจรอบนี้เป็น **กรมเกือบดำ** (bg.json = {"mode":"color","color":"#00081f"})
// ลำดับความลึก: #102a5e ผิวยก (การ์ดใบนี้) / #0a1c42 กลาง / #040e26 จม / #00081f พื้น
//
// น้ำเงินแบรนด์ #0360f3 (vivid ที่วัดได้จาก logo.webp ตรงๆ — เลข 911 และปีกเหยี่ยว)
// ถือขอบการ์ด เส้นคาดบนสุด และออรามุมซ้ายบน · ฟ้าสด #0292fb (vivid อันดับหนึ่ง
// ของ logo.webp) เป็นสี hover ของขอบและปลายสว่างของเส้นใต้ · ฟ้าสว่าง #6ec8ff
// เป็นต้นสว่างสุดของหัวข้อ · เงินโครเมียมที่ถือตัวอักษรได้คือ #cfdcec (10.6:1)
// และ #9db4d4 (6.1:1) · น้ำเงินลึก #032dad #04186e #041a43 เป็นปลายเข้มของเส้นใต้
// และออรามุมขวาล่าง — ทั้งสามไม่เคยถือตัวอักษร
// ลำดับ เงินสว่าง→ฟ้าสว่าง→น้ำเงินแบรนด์ ของหัวข้อคือลำดับที่ตาอ่านโลโก้จริงจาก
// ซ้ายไปขวา (ตัวอักษร TSDET เงินโครเมียมก่อน แล้วไล่ลงไปที่เลข 911 น้ำเงินไฟฟ้า)
// เนื้อความเป็นขาวอมฟ้า #dde8f7 (= BRAND_TEXT) — 11.6:1 บนผิวการ์ดนี้
//
// ⚠️ ไฟล์นี้เป็นของแบรนด์ก่อนหน้าทุกรอบ ห้ามเหมาว่าสีที่เจอเป็นของรอบนี้ ต้องเทียบ
// เป็น "ค่า" ไม่ใช่ "ตระกูลสี" ชุดม่วงราชา-ทองของ KMD88 (#7505cc #b453ff #c07cff
// #d9b8ff #3a0565 #2c0349 #7a5a0a #e2b33f #ffdf8c #ffd45e #ece2f8 #bba8d4
// #1a0526 #1d0832 #140522 #0a0213) ชุดทองมังกรของ TND168 (#dfa310 #ffc93d
// #ffe4a3 #c9b88e #f0e9dc #8a5c09 #43240b #140d02 #1b1307 #120c04 #070502)
// ชุดม่วงนีออน-ทองของ WEPLAY168 (#a435f0 #d2a6ff #c9b2e8 #5b1a75 #1e0a3c #0a0117
// #fbe455) ชุดม่วง-ชมพูของ BPLAY639 (#7e22ce #c4b5fd #ddd6fe #f472b6 #14061f)
// ชุดชมพูฮอตพิงก์-ทองของ PUNPRO168 (#f41571 #ff5ca8 #fce343 #ffd94a #f0c3dc
// #fde7f2 #8a0a45 #4a0426 #2a0012 #4a1038 #3a0a2a #2e0022 #1c0014) ชุดทอง
// เมทัลลิก-บรอนซ์ของ 789BETTING (#fad354 #ffe79a #ddab33 #8a6410 #c9881f #f3e7cd
// #b5a888 #060402 #0a0802 #2a2008 #17130a) ชุดทองอำพันเสือของ TIGERWIN369
// (#d98324 #f7b733 #ffd98a #f7e4c0 #e3cfae #8a5214 #4a2a08 #1a0d02 #2d1c0a
// #1c1206 #0f0903) ชุดทองแชมเปี้ยน-เงินโครเมียมของ UFA324 (#e5a81b #b9c2cc
// #231c0e #17130a #0d0b06 #f0e8d4 #ffcf5e #ffe08a #7d5a07 #43300a #464f5a)
// ชุดชมพู-ทองของ FAH999 (#ff3fa4 #ff6cbb #ffd1ea #fde8f3 #f5c53d #9c6f08 #b3006a
// #4a0b42 #3a0534 #2e002c #210220) ชุดทองเป็ด-ส้มปากเป็ดของ DUCK1688 (#f3bb34
// #fde464 #c8901a #8a5f08 #5c3f04 #f58b2a #ffc98a #a3510c #1a1203 #f6ecd9
// #d8c69b #1f1709 #171106 #0d0903) ชุดทองอวกาศ-เงินโครเมียมของ NAZA168 (#fbc134
// #ffe87a #cf9a18 #96690a #6b4a05 #eef2f8 #cfd6e3 #9aa6bb #3f4859 #fdf3df
// #d9c9a6 #4e3406 #432b03 #382400 #241700) ชุดทองสายฟ้า-แดงเลือดนกของ FLASH877
// (#f5c518 #ffdd73 #b8860f #ff3b14 #8c0f0a) ชุดแดงเสือโคร่ง-ทองถ่านไฟของ
// SUPERSLOTCLUB (#e8232a #f2b705 #ffd666 #c08a0b) ชุดเขียว-ทองของ KINGKONG555
// (#8ce023 #f2c230 #ffe066 #a87a08 #06220a) และชุดแดงแล็กเกอร์ของ PIGPG (#d4200d
// #f5b61d #ffd87a) ออกครบทุกจุดแล้ว
// ⚠️ น้ำเงินของรอบนี้ (#0360f3 = R:3 G:96 B:243) และฟ้าสด (#0292fb = R:2 G:146
// B:251) อ่านมาจาก palette.json ของดรอปนี้โดยตรง เทียบกับเงินโครเมียม #b9c2cc /
// #464f5a ของ UFA324 และ #cfd6e3 / #9aa6bb / #3f4859 ของ NAZA168 ซึ่งเป็นเทา
// อมฟ้าไม่ใช่น้ำเงินอิ่ม — ให้เทียบเป็นตัวเลข ไม่ใช่ด้วยตา
// ⚠️ **รอบนี้ไม่มีทอง ไม่มีม่วง ไม่มีชมพู ไม่มีเขียว ไม่มีส้ม และไม่มีแดงเลย**
// มีแค่น้ำเงินไฟฟ้ากับเงินโครเมียม
//
// ⚠️ #0360f3 #0292fb #032dad #04186e #041a43 ห้ามถือตัวอักษรทุกขนาด อยู่ได้เฉพาะ
// ในไล่เฉดของเส้นคาด ในออรา และเป็นขอบ ส่วน #cfdcec (10.6:1) #9db4d4 (6.1:1)
// #6ec8ff (7.4:1) และ #4fb4ff (6.0:1) ถือตัวอักษรรองได้จริง และ #6ec8ff คือตัวที่
// สงวนไว้ใช้ไฮไลต์ <strong> ในเนื้อความเท่านั้น
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#0360f3]/45 bg-[#102a5e]/95 p-8 text-left text-base leading-relaxed text-[#dde8f7] shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#0292fb]/70 hover:shadow-[0_15px_40px_rgba(3,96,243,0.35)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#0360f3]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#0360f3]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#0292fb]/35"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#041a43]/80 blur-[60px] transition-all duration-500 group-hover:bg-[#032dad]/45"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#cfdcec] via-[#6ec8ff] to-[#0360f3] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#0292fb] via-[#032dad] to-[#04186e] shadow-[0_0_10px_rgba(3,96,243,0.65)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
