---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// 1SS365 (รอบทอง-เงินโครเมียม-ดำ 2026-10-03): เว็บสล็อตตรงต่างประเทศ พาเลตต์มาจาก
// logo.webp ที่เป็นสองโลหะ — เหรียญเลข 1 ทอง / ตัวอักษร 1SS เงินโครเมียม / เลข 365
// ทอง (vivid #edbb23 #ca8b14 #d19416 #f3cb35 เป็นทองทั้งชุด ส่วน dominant รองลงมา
// เป็นขาว-เงิน #fdfdfd #cdcdcd) บนแบนเนอร์ที่เป็นทองล้วนกับเหรียญและไพ่บนพื้นดำ
// และ bg.json กำหนดพื้นหลังเว็บเป็น #000000 แบรนด์นี้จึงเป็น "ทองนำ เงินรอง บนดำ" —
// ทองแบรนด์ #edbb23 ถือกรอบและออรามุมซ้ายบน เงินโครเมียม #c8cbce ถือออรามุมขวาล่าง
// การ์ดเป็นดำอมทอง #121010 หัวข้อไล่เฉดทองอ่อน #ffeeb4 → ทอง #edbb23 → เงิน #c8cbce
// เนื้อความ #f0e6d2 (BRAND_TEXT)
//
// รอบก่อน (หวย365) เป็นเว็บแทงหวยโทนแดงสด-ทอง ชุดเดิมทั้งชุด (#dc0203 #e00104
// #e2020a #f5282a #240406 #c08a07 #ffc93c #ffeab0 #f6e7e0) ออกครบทุกจุดแล้ว และ
// แดงถูกถอดออกหมดเพราะโลโก้รอบนี้ไม่มีฮิวแดงเลย เงินกลับเข้ามาเป็นฮิวที่สองจริง
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#a87708]/50 bg-[#121010]/95 p-8 text-left text-base leading-relaxed text-[#f0e6d2] shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#edbb23]/70 hover:shadow-[0_15px_40px_rgba(237,187,35,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#edbb23]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#edbb23]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#ffeeb4]/38"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#c8cbce]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#f1f2f3]/32"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#ffeeb4] via-[#edbb23] to-[#c8cbce] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#ffeeb4] via-[#edbb23] to-[#c8cbce] shadow-[0_0_10px_rgba(237,187,35,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
