---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro, /promotion,
// /about-us, /contact-us, /ทางเข้า, /ทดลองเล่น, /login และ /register render ตัว
// เนื้อหาผ่านไฟล์นี้ (10 หน้า) และไม่เคยเดินตาม ContentBox rotation ของ index
// → ไฟล์นี้ต้องถือพาเลตของ "แบรนด์ปัจจุบัน" เสมอ ต่อให้ index เลือก variant อื่น
// ⚠️ รอบนี้ **หน้าแรกก็ใช้ไฟล์นี้ด้วย** (docx §6 — หัวข้อสมัคร 3 ขั้นตอน) ซึ่งเป็น
// ไฟล์เดียวที่ทับกับ shape-mix ของรอบก่อน และทับเพราะมันเป็นกล่องถาวร ไม่ใช่
// เพราะเลือกซ้ำ
// ⚠️ หน้าถาวรพวกนั้น **ไม่ประกาศสีตัวอักษรเองเลยสักจุด** ย่อหน้าทั้งหมด inherit สีมา
// จากการ์ดข้างล่าง ถ้าการ์ดไม่ตั้ง text color หน้าเหล่านั้นจะตกไปใช้ default ของ
// เบราว์เซอร์ → คลาส `text-left text-base leading-relaxed text-[#f4ead6]` บน
// element ที่ถือ <slot /> ห้ามหายไปสักตัว
//
// Flattened single-slot variant (ทำเมื่อ 2026-07-26): `isolate` บนการ์ด + `-z-10`
// บนชั้นตกแต่ง absolute ทุกชั้น slot จึง render เป็นลูกตรงของการ์ด
// **ห้ามเพิ่ม wrapper <div> รอบ slot กลับมา** และถ้าจะเปลี่ยนสีตัวอักษรของการ์ด
// ให้ **แทนที่** คลาสสีเดิม ไม่ใช่ใส่คลาสสีที่สองข้างๆ (specificity เท่ากัน ผลจะ
// ขึ้นอยู่กับลำดับที่ Tailwind บังเอิญ emit)
//
// House style เนื้อความ: element ที่ถือ slot ได้ `text-left text-base
// leading-relaxed <สี>` — ห้ามย่อหรือขยายขนาดตัวอักษรของเนื้อความ (คลาส sm/lg
// ของ text-* ใช้กับย่อหน้าไม่ได้) · หัวข้อจัดกลางได้ แต่ต้อง
// ใส่ text-center ที่ตัวหัวข้อเอง **ห้ามใส่บนการ์ดหรือ <section>** เพราะมันจะ
// inherit ลงไปใน slot แล้วทำให้ย่อหน้าของทุกหน้าที่เรียกไฟล์นี้กลางตามไปด้วย
//
// หัวข้อมาจาก prop `title` + `as` เท่านั้น (เป็นหัวข้อจริงของบทความ/หน้านั้นๆ)
// **ห้าม hardcode ข้อความไทยเป็น heading ในไฟล์นี้** — เป็นโครมที่ขึ้นทุกหน้า
//
// ───────────────────────────────────────────────────────────────────────────
// รอบ 2026-10-22 (พักยก168) พาเลตตาม .claude/brand-spec-pakyok168.md §2
// ⚠️⚠️ **รอบนี้กลับมาเป็นธีมมืด หลังรอบก่อนเป็นฟ้าพาสเทลสว่าง — การ์ดจึงเป็นผิว
// น้ำตาลเข้ม หมึกไอวอรี** เหตุผล: bg.json ของดรอปนี้เป็น {"mode":"color","color":"#291d0f"}
// = **น้ำตาลกาแฟเข้ม** และ bg.json คือแหล่งเดียวของพื้นเพจ
// **ห้าม "แก้" การ์ดกลับไปเป็นพื้นสว่างเพราะ "รอบก่อนเป็นแบบนั้น"** — การ์ดสว่าง
// บนพื้นมืดจะทำให้หน้า terms/privacy/404 ที่พึ่ง BRAND_TEXT (= หมึกไอวอรี #f4ead6)
// กลายเป็นหมึกสว่างบนพื้นสว่างทันที
//
// อ่านจากอาร์ตเวิร์กจริง: โลโก้เป็น **หัวมังกรจีนทองสามมิติ ต่อด้วยคำว่า "พักยก"
// ตัวอักษรไทยสามมิติผิวทองมันวาว และเลข "168" ผิวโครเมียมเงิน** ส่วนแบนเนอร์/สไลด์
// เป็นฉาก **ห้องนิรภัยทองคำ ประตูเซฟวงกลมทองเหลือง ชั้นวางทองคำแท่ง ผู้ชายสูทดำ
// แว่นกันแดดถือซิการ์บนโซฟาหนัง หีบสมบัติ มงกุฎทอง และกองเหรียญทอง**
//
// บทบาทสีในไฟล์นี้:
//   ผิวการ์ด (ยก) #3a2713 · ชั้นกลาง #32200f · อินเซ็ต/จม #1f1308 · พื้นเพจ #291d0f
//   ทองแกน #eeae12 = ขอบสว่าง เส้นคาดบนสุด ออรา และต้นของเส้นใต้หัวข้อ
//     (7.2:1 บนการ์ดนี้ — ถือตัวอักษรได้ แต่ในไฟล์นี้ใช้เป็นเส้น/ออรา)
//   ทองสว่าง #fded41 = **สีหัวข้อ** (11.7:1 บนการ์ดนี้ ถือตัวอักษรได้สบาย)
//     และเป็นสีไฮไลต์ <strong> ในเนื้อความ — หน้าไหนจะใช้ก็ได้
//   ทองลึก #9f600d = ขอบ/ปลายเข้มของไล่เฉด (**2.8:1 — ห้ามถือตัวอักษรเด็ดขาด**)
//   โครเมียม #e0e0df = สีประกอบจากเลข "168" ใช้เป็นปลายของเส้นใต้หัวข้อและออรารอง
//     (10.7:1 — ถือตัวอักษรได้ แต่สงวนไว้เป็น accent)
//   หมึกไอวอรี #f4ead6 = เนื้อความ (= BRAND_TEXT) 11.9:1 บนผิวการ์ดนี้
//
// ⚠️⚠️ **#3a2713 #32200f #1f1308 #291d0f ห้ามถือตัวอักษรเด็ดขาด** เป็นสีพื้นเท่านั้น
// และ **#9f600d ห้ามถือตัวอักษรเช่นกันบนพื้นมืด** (2.8:1) เป็น stop ของไล่เฉด/
// ออรา/ขอบได้อย่างเดียว
// rgba() ที่อนุญาตรอบนี้: rgba(238,174,18,α) · rgba(253,237,65,α) ·
// rgba(224,224,223,α) · rgba(31,15,4,α) · rgba(0,0,0,α)
//
// ⚠️ ไฟล์นี้เป็นของแบรนด์ก่อนหน้าทุกรอบ ห้ามเหมาว่าสีที่เจอเป็นของรอบนี้ ต้องเทียบ
// เป็น **"ค่า"** ไม่ใช่ "ตระกูลสี" — **ทองเคยผ่านรีโปนี้มาแล้วเกือบทุกเจ้า**
// การเจอทองในไฟล์จึงไม่พิสูจน์ว่าเป็นของรอบปัจจุบัน
// รอบก่อนหน้าทันที (สบาย168 ฟ้าสกาย + ทองคานารี บนธีมสว่าง) ที่กวาดออกครบแล้ว
// จากไฟล์นี้:
//   2cc3fc 6bdcfb 9ae0fa 0a7fbd 063a57 0f3a4a fdcb0c 8a6504 ffffff f2fbff dff4fd
//   ccf7ff cdf2ff eafaff a9e3f9 04293d 0a4f74 06293c 2a1f02
// สองรอบก่อน (ยูฟ้า168 ทองคานารี + โครเมียมเงิน บนดำสนิท — ⚠️ **เจ้าเดียวที่เดิน
// ทอง+เงินเหมือนรอบนี้ จึงเป็นตัวที่ต้องเทียบค่าหนักที่สุด**):
//   fee45d e6a416 b8780d 7a4e05 e8ecf1 a8b2bf 78828f 5a6472 15130f 1e1a13 0a0908
//   eae3d4 140e02 0b0d10 และพื้นเพจ 000000
// ⚠️⚠️ ทองของแบรนด์อื่นที่ต้องเทียบเป็นค่าทีละตัว (ห้ามกะด้วยตา):
//   e5a81b ffe08a bb8410 7d5a07 (UFA324) · fef54b 6b5c10 (นินจา168) ·
//   f9a826 704504 (รวยแทร่168) · ffc82e 5c4a16 (สบายเบท168) · ffd84d 6b4708
//   (ถอนชัวร์168) · e3b23c ffe5a8 8a6210 (สมหวัง168) · dcb95f b8862b 96681f c99a3f
//   (รวยแท้168) · fcd434 ffeaa0 (มีโชค168) · cd9a2c fdeb7c ab7314 (หวยคิง) ·
//   d4922c fdfc71 d39c45 f6e3b4 (ufalion168) · f0bb4e ffeccb (รวยเทพ168) ·
//   fcd45c 6b4a08 (มีเฮ168) · ffdc8c f0b429 (รับตัง168) · f7c92b ffe6a3 (ขวัญใจ168) ·
//   f0c878 (ดวงเศรษฐี168) · ffc93c ffeab0 c08a07 (หวย365)
// แบรนด์เก่ากว่านั้นทั้งหมดอยู่ในตารางของ brand-spec §2 — grep ทีละค่าจากตารางนั้น
// ⚠️ รอบนี้ **ไม่มีแดง ไม่มีเขียว (ยกเว้น LINE green ที่อื่น) ไม่มีชมพู ไม่มีม่วง
// ไม่มีโรสโกลด์ ไม่มีส้ม และไม่มีฟ้า/น้ำเงิน (ซึ่งเป็นสีนำของรอบก่อน)**
// (เฮกซ์ของแบรนด์เก่าในคอมเมนต์ด้านบนเขียนแบบ **ไม่มี #** โดยตั้งใจ เพื่อไม่ให้
// การ sweep ไล่หาสีของแบรนด์เก่าใน src/ สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#9f600d] bg-[#3a2713]/95 p-8 text-left text-base leading-relaxed text-[#f4ead6] shadow-[0_10px_30px_rgba(0,0,0,0.45)] backdrop-blur-xl transition-all duration-500 hover:border-[#eeae12] hover:shadow-[0_15px_40px_rgba(238,174,18,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#eeae12] to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#eeae12]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#eeae12]/40"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#e0e0df]/15 blur-[60px] transition-all duration-500 group-hover:bg-[#e0e0df]/30"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="text-2xl leading-normal font-black tracking-widest text-[#fded41] uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#eeae12] to-[#e0e0df] shadow-[0_0_10px_rgba(238,174,18,0.45)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
