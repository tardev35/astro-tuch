---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#ebbc4c]/25 bg-[#120d06]/92 p-8 text-left text-base leading-relaxed text-[#f0e6c8] shadow-[0_10px_30px_rgba(235,188,76,0.14)] backdrop-blur-xl transition-all duration-500 hover:border-[#ebbc4c]/50 hover:shadow-[0_15px_40px_rgba(235,188,76,0.24)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#ebbc4c]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#ebbc4c]/30"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#9a6d25]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#fcf3ab]/25"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#ebbc4c]/25 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fcf3ab] to-[#9a6d25] shadow-[0_0_10px_rgba(235,188,76,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fcf3ab] via-[#ebbc4c] to-[#9a6d25] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
