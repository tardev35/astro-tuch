---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro and privacy.astro render every section
// through this file and never follow the per-brand ContentBox rotation, so it
// must carry the CURRENT brand's colours even when index.astro picks another
// variant. Nothing inside those pages names a colour — they inherit from the
// card below, which is what keeps them brand-neutral.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the two
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#e6b23c]/32 bg-[#0b1020]/92 p-8 text-left text-base leading-relaxed text-[#ded8ca] shadow-[0_10px_30px_rgba(3,6,14,0.72)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffd873]/60 hover:shadow-[0_15px_40px_rgba(230,178,60,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#e6b23c]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#e6b23c]/32"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#cf2027]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#ee3a34]/32"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#e6b23c]/32 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffd873] to-[#cf2027] shadow-[0_0_10px_rgba(230,178,60,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fff4dd] via-[#e6b23c] to-[#cf2027] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
