---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro and privacy.astro render every section
// through this file and never follow the per-brand ContentBox rotation, so it
// must carry the CURRENT brand's colours even when index.astro picks another
// variant. Nothing inside those pages names a colour — they inherit from the
// card below, which is what keeps them brand-neutral.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the two
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// PAOTUNG: พื้นการ์ดเป็นกรมท่า #04203c เส้นขอบและออร่าซ้ายเป็นน้ำเงินโลโก้
// #226ca9 ออร่าขวาเป็นทองเมทัลลิค #e0bd72 (แทนออร่าแดงของแบรนด์ก่อน) และ
// หัวข้อไล่จากทองสว่างไปน้ำเงินสด — ทอง/น้ำเงินตามที่ brief ระบุ ไม่มีแดง
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#226ca9]/35 bg-[#04203c]/92 p-8 text-left text-base leading-relaxed text-[#cfdeed] shadow-[0_10px_30px_rgba(2,15,30,0.72)] backdrop-blur-xl transition-all duration-500 hover:border-[#3b9ddd]/60 hover:shadow-[0_15px_40px_rgba(34,108,169,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#226ca9]/24 blur-[60px] transition-all duration-500 group-hover:bg-[#3b9ddd]/34"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#e0bd72]/18 blur-[60px] transition-all duration-500 group-hover:bg-[#e0bd72]/28"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#226ca9]/35 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#7fc4f0] to-[#054e83] shadow-[0_0_10px_rgba(34,108,169,0.65)]" />
          <HeadingTag class="bg-gradient-to-r from-[#f5e3b3] via-[#e0bd72] to-[#3b9ddd] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
