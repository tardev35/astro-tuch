---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#7a0304]/65 bg-[#140503]/92 p-8 text-left text-base leading-relaxed text-[#e9d6ac] shadow-[0_10px_30px_rgba(11,4,2,0.6)] backdrop-blur-xl transition-all duration-500 hover:border-[#e2060a]/70 hover:shadow-[0_15px_40px_rgba(226,6,10,0.26)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#e2060a]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#e2060a]/30"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#fbbf14]/18 blur-[60px] transition-all duration-500 group-hover:bg-[#fae21e]/28"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#7a0304]/60 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fae21e] to-[#e2060a] shadow-[0_0_10px_rgba(250,226,30,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fff6e0] via-[#fbbf14] to-[#e2060a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
