---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#1e4b9e]/60 bg-[#061436]/92 p-8 text-left text-base leading-relaxed text-[#cfdcea] shadow-[0_10px_30px_rgba(2,6,15,0.45)] backdrop-blur-xl transition-all duration-500 hover:border-[#0b6cf0]/65 hover:shadow-[0_15px_40px_rgba(11,108,240,0.24)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#0b6cf0]/18 blur-[60px] transition-all duration-500 group-hover:bg-[#0b6cf0]/28"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#0a2a6b]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#c3ced9]/30"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#1e4b9e]/55 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#4aa3ff] to-[#0a2a6b] shadow-[0_0_10px_rgba(11,108,240,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#eaf3fd] via-[#9dd2fa] to-[#c3ced9] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
