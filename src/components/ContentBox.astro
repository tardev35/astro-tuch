---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// NATO168 (รอบทอง-เงิน-ดำ 2026-10-02): เว็บสล็อตออนไลน์ พาเลตต์มาจากโลโก้ที่เป็น
// คำว่า NATO สีเงินเมทัลลิกคู่กับเลข 168 สีทอง และวงกลมตัว N ขอบทอง (vivid
// #edb543 รองลงมา #fcdc73 #fef3ab) บนแบนเนอร์ที่เป็นฉากผ้าซาตินทองกับเหรียญ PG
// บนพื้นดำ แบรนด์นี้จึงมี "สองโทน" ไม่ใช่โทนเดียว — ทองแบรนด์ #edb543 ถือกรอบและ
// ออรามุมซ้ายบน เงิน #e6e6e6 ถือออรามุมขวาล่างและกลางเกรเดียนต์หัวข้อ การ์ดเป็น
// ดำสนิท #101010 หัวข้อไล่เฉดทองอ่อน #fde8a8 → เงิน #e6e6e6 จบที่ทองลึก #a9761f
// เนื้อความ #f4ead3 (BRAND_TEXT)
//
// รอบก่อน (NAZA99) เป็นทองล้วนไม่มีฮิวที่สอง ชุดเดิมทั้งชุด (#e4b34d #fdf2ac
// #fef1a5 #140c02 #8a5f12 #f3e8cf) ออกครบทุกจุดแล้ว รวมถึง #8a5f12 ที่เปลี่ยนเป็น
// #a9761f ซึ่งคอนทราสต์บนการ์ดดีกว่า (4.7:1 เทียบกับ 3.3:1) รอบนี้เพิ่มเงินเข้ามาเป็น
// ฮิวที่สองจริงๆ เพราะครึ่งหนึ่งของเวิร์ดมาร์กเป็นเงินเมทัลลิก ไม่ใช่ทอง
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#edb543]/50 bg-[#101010]/94 p-8 text-left text-base leading-relaxed text-[#f4ead3] shadow-[0_10px_30px_rgba(4,3,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#fde8a8]/70 hover:shadow-[0_15px_40px_rgba(237,181,67,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#edb543]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#edb543]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#fde8a8]/38"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#e6e6e6]/16 blur-[60px] transition-all duration-500 group-hover:bg-[#e6e6e6]/26"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#fde8a8] via-[#e6e6e6] to-[#a9761f] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#fde8a8] via-[#e6e6e6] to-[#a9761f] shadow-[0_0_10px_rgba(237,181,67,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
