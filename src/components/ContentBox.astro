---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro and privacy.astro render every section
// through this file and never follow the per-brand ContentBox rotation, so it
// must carry the CURRENT brand's colours even when index.astro picks another
// variant. Nothing inside those pages names a colour — they inherit from the
// card below, which is what keeps them brand-neutral.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the two
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// FAH999: การ์ดดำอมน้ำตาล #12100b ในกรอบทองบรอนซ์ #a3732c ออร่าสองมุมเป็นทอง
// หลัก #e8c25a กับทองบรอนซ์เข้ม หัวข้อไล่จากทองประกาย #f7e7a8 → ทองหลัก →
// บรอนซ์ ซึ่งเป็นไล่เฉดเดียวกับตัวอักษรบนโลโก้ (ทองบนพื้นดำ ไม่มีสีที่สอง)
// แบรนด์นี้มีสีเดียว จึงแยกชั้นด้วยความสว่าง ไม่ใช่ด้วยคู่สี แดงของแบรนด์ก่อน
// หายไปทั้งหมด
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#a3732c]/55 bg-[#12100b]/94 p-8 text-left text-base leading-relaxed text-[#e7dcc4] shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#e8c25a]/70 hover:shadow-[0_15px_40px_rgba(232,194,90,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#e8c25a]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#e8c25a]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#e8c25a]/34"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#a3732c]/30 blur-[60px] transition-all duration-500 group-hover:bg-[#a3732c]/44"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#f7e7a8] via-[#e8c25a] to-[#a3732c] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#f7e7a8] to-[#6b4a18] shadow-[0_0_10px_rgba(232,194,90,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
