---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#6b5316]/70 bg-[#14100a]/92 p-8 text-left text-base leading-relaxed text-[#e6dcc2] shadow-[0_10px_30px_rgba(5,4,3,0.65)] backdrop-blur-xl transition-all duration-500 hover:border-[#f3db5b]/70 hover:shadow-[0_15px_40px_rgba(243,219,91,0.24)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#f3db5b]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#f3db5b]/30"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#d8dce2]/18 blur-[60px] transition-all duration-500 group-hover:bg-[#d8dce2]/28"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#6b5316]/70 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fff3bf] to-[#a37c14] shadow-[0_0_10px_rgba(243,219,91,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fff3bf] via-[#f3db5b] to-[#a37c14] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
