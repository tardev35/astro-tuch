---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// DUCK1688 (รอบทองเป็ด-ส้มปากเป็ด 2026-10-10): พาเลตต์ตาม brand-spec §2
// รอบนี้ตัดเงินโครเมียมออกหมด — NAZA168 เป็นคู่ "ทองอวกาศ-เงินโครเมียม" บนพื้น
// น้ำตาลไหม้ รอบนี้เป็นคู่ "ทอง-ส้มอำพัน" บน **พื้นดำสนิท** เพราะ bg.json ของดรอป
// นี้เป็น {"mode":"color","color":"#000000"} การ์ดจึงเป็นผิวยก #1f1709 ที่สว่างกว่า
// พื้นเพจ ลอยขึ้นมาเหมือนแผ่นป้ายดำขอบทองในโลโก้ที่ลอยอยู่บนฉากอวกาศสีดำ
// ⚠️ พื้นเพจรอบนี้เป็นดำสนิท จึงไม่มีชั้นไหน "ลึกกว่า" พื้นได้อีก ทุกผิวการ์ดต้อง
// สว่างกว่าพื้นเสมอ
//
// ทองเป็ด #f3bb34 (ฮิวหลัก — vivid ของ logo.webp และคำว่า DUCK บนโลโก้)
// ถือขอบการ์ด เส้นคาดบนสุด และออรามุมซ้ายบน · ส้มอำพัน #f58b2a (ฮิวที่สองจริง —
// ปากของเป็ดในโลโก้และของมาสคอตในแบนเนอร์) เป็นปลายไล่เฉดหัวข้อและออรามุมขวาล่าง
// ลำดับ ทอง→ส้ม ของหัวข้อคือลำดับที่ตาอ่านโลโก้จริง (ตัว DUCK ทอง แล้วค่อยไล่ลง
// ไปที่ปากเป็ด) · ทองสว่าง #fde464 เป็นต้นสว่างสุดของหัวข้อ · ทองลึก #8a5f08
// กับส้มลึก #a3510c เป็นปลายเข้มของเส้นใต้ — ทั้งคู่ไม่เคยถือตัวอักษร
// เนื้อความเป็นครีมอุ่น #f6ecd9 (= BRAND_TEXT) — 15.0:1 บนผิวการ์ดนี้
//
// ⚠️ แบรนด์รอบก่อน (NAZA168) **ก็ทองเหมือนกัน** และเจ็ดในแปดรอบหลังสุดก็มีทอง
// เจอทองที่ไหนห้ามเหมาว่าเป็นของรอบนี้ ต้องเทียบเป็น "ค่า" ไม่ใช่ "ตระกูลสี":
// ชุดทองอวกาศ-เงินโครเมียมของ NAZA168 (#fbc134 #ffe87a #cf9a18 #96690a #6b4a05
// #eef2f8 #cfd6e3 #9aa6bb #3f4859 #fdf3df #d9c9a6 #4e3406 #432b03 #382400
// #241700 rgba(251,193,52,α) rgba(207,214,227,α)) ชุดทองสายฟ้า-แดงเลือดนกของ
// FLASH877 (#f5c518 #ffdd73 #b8860f #8a6208 #ff3b14 #8c0f0a #5a0603 #5c0000)
// ชุดแดงเสือโคร่ง-ทองถ่านไฟของ SUPERSLOTCLUB (#e8232a #f2b705 #ffd666 #c08a0b)
// ชุดเขียว-ทองของ KINGKONG555 (#8ce023 #f2c230 #ffe066 #a87a08 #06220a)
// ชุดม่วง-ทองของ WEPLAY168 (#a435f0 #5b1a75 #1e0a3c) และชุดแดงแล็กเกอร์ของ
// PIGPG (#d4200d #f5b61d #ffd87a) ออกครบทุกจุดแล้ว — ทองของรอบนี้ (#f3bb34)
// เป็นคนละค่ากับทองของทุกชุดข้างบน และรอบนี้ **ไม่มีสีแดงและไม่มีเงินเป็นฮิวเลย**
//
// ⚠️ #8a5f08 #5c3f04 และ #a3510c ห้ามถือตัวอักษรทุกขนาด อยู่ได้เฉพาะในไล่เฉด
// ของเส้นคาด ในออรา และเป็นขอบ ส่วน #f58b2a (7.0:1) ถือตัวอักษรรองได้จริง
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#f3bb34]/40 bg-[#1f1709]/95 p-8 text-left text-base leading-relaxed text-[#f6ecd9] shadow-[0_10px_30px_rgba(0,0,0,0.6)] backdrop-blur-xl transition-all duration-500 hover:border-[#f3bb34]/80 hover:shadow-[0_15px_40px_rgba(243,187,52,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#f3bb34]/75 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#f3bb34]/40 blur-[60px] transition-all duration-500 group-hover:bg-[#fde464]/30"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#a3510c]/60 blur-[60px] transition-all duration-500 group-hover:bg-[#f58b2a]/28"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#fde464] via-[#f3bb34] to-[#f58b2a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#f3bb34] via-[#8a5f08] to-[#a3510c] shadow-[0_0_10px_rgba(243,187,52,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
