---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro, /promotion,
// /about-us, /contact-us, /ทางเข้า, /ทดลองเล่น, /login และ /register render ตัว
// เนื้อหาผ่านไฟล์นี้ (10 หน้า) และไม่เคยเดินตาม ContentBox rotation ของ index
// → ไฟล์นี้ต้องถือพาเลตของ "แบรนด์ปัจจุบัน" เสมอ ต่อให้ index เลือก variant อื่น
// ⚠️ หน้าพวกนั้น **ไม่ประกาศสีตัวอักษรเองเลยสักจุด** ย่อหน้าทั้งหมด inherit สีมา
// จากการ์ดข้างล่าง ถ้าการ์ดไม่ตั้ง text color หน้าเหล่านั้นจะตกไปใช้ default ของ
// เบราว์เซอร์ = ดำบนดำ = หายไปทั้งหน้า → คลาส `text-left text-base
// leading-relaxed text-[#fff8d8]` บน element ที่ถือ <slot /> ห้ามหายไปสักตัว
//
// Flattened single-slot variant (ทำเมื่อ 2026-07-26): `isolate` บนการ์ด + `-z-10`
// บนชั้นตกแต่ง absolute ทุกชั้น slot จึง render เป็นลูกตรงของการ์ด
// **ห้ามเพิ่ม wrapper <div> รอบ slot กลับมา** และถ้าจะเปลี่ยนสีตัวอักษรของการ์ด
// ให้ **แทนที่** คลาสสีเดิม ไม่ใช่ใส่คลาสสีที่สองข้างๆ (specificity เท่ากัน ผลจะ
// ขึ้นอยู่กับลำดับที่ Tailwind บังเอิญ emit)
//
// House style เนื้อความ: element ที่ถือ slot ได้ `text-left text-base
// leading-relaxed <สี>` — ห้ามย่อหรือขยายขนาดตัวอักษรของเนื้อความ (คลาส sm/lg
// ของ text-* ใช้กับย่อหน้าไม่ได้) · หัวข้อจัดกลางได้ แต่ต้อง
// ใส่ text-center ที่ตัวหัวข้อเอง **ห้ามใส่บนการ์ดหรือ <section>** เพราะมันจะ
// inherit ลงไปใน slot แล้วทำให้ย่อหน้าของทุกหน้าที่เรียกไฟล์นี้กลางตามไปด้วย
//
// หัวข้อมาจาก prop `title` + `as` เท่านั้น (เป็นหัวข้อจริงของบทความ/หน้านั้นๆ)
// **ห้าม hardcode ข้อความไทยเป็น heading ในไฟล์นี้** — เป็นโครมที่ขึ้นทุกหน้า
//
// ───────────────────────────────────────────────────────────────────────────
// รอบ 2026-10-20 (ทองน้ำผึ้งนำ + แดงชาดจีนรอง บนพื้นดำสนิท) พาเลตตาม
// .claude/brand-spec-duangsetthi168.md §2 — อ่านจากอาร์ตเวิร์กจริง: โลโก้เป็น
// **หัวไฉ่ซิงเอี๊ยยิ้มหัวเราะ สวมหมวกทรงจีนสีแดงขลิบทอง มีลูกปัดทองห้อยสองข้าง**
// ชื่อแบรนด์เป็น **ตัวอักษรไทยสามมิติผิวทองมันวาว** ต่อด้วย **เลขสามมิติสีแดงสด
// ขลิบทอง** ส่วนแบนเนอร์/สไลด์เป็นฉาก **ห้องโถงหรูขาว-งาช้าง มงกุฎทอง กองเหรียญ
// ทอง ชิปคาสิโนดำ-ทอง ไพ่เอซโพดำขลิบทอง และแถบแดงโค้งขลิบทอง**
// ⚠️ พื้นเพจมาจาก src/assets/bg.json = {"mode":"color","color":"#000000"} =
// **ดำสนิท** ไม่ได้มาจากพื้นขาวของรูป (รูปพื้นขาว แต่พื้นเว็บดำ)
//
// บทบาทสีในไฟล์นี้:
//   ผิวการ์ด (ยก) #4e2120 · ชั้นกลาง #300605 · ชั้นจม #150303 · พื้นเพจ #000000
//   ทองน้ำผึ้ง #f0c878 = ขอบการ์ด เส้นคาดบนสุด หัวข้อ และต้นของเส้นใต้หัวข้อ
//     (8.47:1 บนผิวการ์ดนี้ → ผ่าน AA ทั้งที่เป็นตัวอักษรและที่เป็นเส้น)
//   งาช้าง #fff8d8 = เนื้อความ (= BRAND_TEXT) 12.59:1 บนผิวการ์ดนี้
//   แดงชาดจีน #d9212a = ออรามุมซ้ายบน สีขอบตอน hover และกลางของเส้นใต้หัวข้อ
//   แดงเลือดหมู #8e1a16 = ออรามุมขวาล่าง และปลายเข้มของเส้นใต้หัวข้อ
//   หมึก #2a0608 = ตัวอักษรบนพื้นถมทอง/ครีมเท่านั้น (ไฟล์นี้ไม่มีพื้นถมทอง)
//
// ⚠️⚠️ **แดงทั้งสองเฉดห้ามถือตัวอักษรเด็ดขาดทุกขนาด** — d9212a ได้แค่ 2.69:1 บน
// ผิวการ์ดนี้และ 4.20:1 บนพื้นเพจ ส่วน 8e1a16 ต่ำกว่านั้นทุกพื้น ทั้งคู่จึงเป็น
// **พื้นถม / ขอบ / ออรา / ชั้นตกแต่งเท่านั้น** นี่คือเหตุผลที่หัวข้อของการ์ดนี้
// เป็นทองน้ำผึ้งตันตัวเดียว ไม่ได้ไล่เฉดลงไปจบที่แดงเหมือนที่ตาอยากให้เป็น
// (รอบก่อนก็ด้วยเหตุผลเดียวกัน: บรอนซ์ถูกย้ายจากหัวข้อไปอยู่บนเส้นใต้)
// ถ้าต้องการตัวอักษรที่อ่านว่า "แดง" ให้ **ถมแดง d9212a เป็นพื้นแล้ววางงาช้างทับ**
// (4.68:1 ผ่าน AA) และสีไฮไลต์ <strong> ในเนื้อความมีตัวเดียวคือทองน้ำผึ้ง
// rgba() ที่อนุญาตรอบนี้: rgba(217,33,42,α) · rgba(240,200,120,α) ·
// rgba(142,26,22,α)
//
// ⚠️ ไฟล์นี้เป็นของแบรนด์ก่อนหน้าทุกรอบ ห้ามเหมาว่าสีที่เจอเป็นของรอบนี้ ต้องเทียบ
// เป็น **"ค่า"** ไม่ใช่ "ตระกูลสี" — **ทองเคยนำมาแล้วเกือบทุกแบรนด์ และแดงเคยนำมา
// แล้วหลายแบรนด์** การเจอทองหรือแดงในไฟล์จึงไม่พิสูจน์ว่าเป็นของรอบปัจจุบัน
// รอบก่อนหน้าทันที (ufalion168 ทองอำพัน/บรอนซ์) ที่กวาดออกครบแล้วจากไฟล์นี้:
//   d4922c fdfc71 a25b24 8c4312 d39c45 f6e3b4 33200a 1f1304 0a0601 5a3310 1a1000
//   และ rgba 212/146/44 α) rgba 253/252/113 α) rgba 162/91/36 α)
//   rgba 246/227/180 α)
// แบรนด์เก่ากว่านั้นทั้งหมด (รวยเทพ168 มีเฮ168 รวยแทร่168 นินจา168 สบายเบท168
// ถอนชัวร์168 มีโชค168 ขวัญใจ168 รับตัง168 สมหวัง168 UFA324 TKB55 GT66B KMD88
// TND168 KINGKONG555 HI59 TSDET911 ฯลฯ) อยู่ในตารางของ brand-spec §2 —
// ให้ grep ทีละค่าจากตารางนั้น ห้ามกะด้วยตา
// ⚠️ รอบนี้ **ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง ไม่มีเขียว ไม่มีเงิน/โครเมียม
// ไม่มีโรสโกลด์ ไม่มีชมพู/ฟูเชีย ไม่มีส้มสด และไม่มีบรอนซ์** (บรอนซ์เป็นสีที่สาม
// ของรอบก่อน) — แดงรอบนี้เป็นแดงชาดจีน ไม่ใช่ส้มและไม่ใช่โรสโกลด์
// (เฮกซ์ของแบรนด์เก่าในคอมเมนต์ด้านบนเขียนแบบ **ไม่มี #** โดยตั้งใจ เพื่อไม่ให้
// การ sweep ไล่หาสีของแบรนด์เก่าใน src/ สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#f0c878]/40 bg-[#4e2120]/95 p-8 text-left text-base leading-relaxed text-[#fff8d8] shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#d9212a]/80 hover:shadow-[0_15px_40px_rgba(217,33,42,0.35)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#f0c878]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#d9212a]/40 blur-[60px] transition-all duration-500 group-hover:bg-[#f0c878]/30"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#8e1a16]/80 blur-[60px] transition-all duration-500 group-hover:bg-[#d9212a]/45"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="text-2xl leading-normal font-black tracking-widest text-[#f0c878] uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#f0c878] via-[#d9212a] to-[#8e1a16] shadow-[0_0_10px_rgba(217,33,42,0.65)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
