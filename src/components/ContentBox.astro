---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#a97a08]/55 bg-[#1c0707]/92 p-8 text-left text-base leading-relaxed text-[#f7e4dc] shadow-[0_10px_30px_rgba(13,3,3,0.35)] backdrop-blur-xl transition-all duration-500 hover:border-[#fdd32d]/60 hover:shadow-[0_15px_40px_rgba(253,211,45,0.24)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#fdd32d]/18 blur-[60px] transition-all duration-500 group-hover:bg-[#fdd32d]/28"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#d31411]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#f5322e]/30"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#a97a08]/50 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe98a] to-[#8e0c0a] shadow-[0_0_10px_rgba(253,211,45,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fdd32d] via-[#ffe98a] to-[#f5322e] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
