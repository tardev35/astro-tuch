---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// หวยเฮง24 (รอบแดงเข้ม-ทอง 2026-10-01): เว็บเล่นหวยออนไลน์ พาเลตต์มาจากโลโก้ที่
// คำว่า "หวย" เป็นแดงเลือดนกเงาวาวขอบทอง ส่วน "เฮง24" เป็นทองไล่เฉด และแบนเนอร์
// ฉากผ้าซาตินแดงมีเงาปราสาททอง เหรียญทอง และลูกหวย — การ์ดแดงเข้ม #2e0707 ในกรอบ
// ทองแบรนด์ #e0a52a ออร่ามุมซ้ายบนเป็นทอง มุมขวาล่างเป็นแดงแบรนด์ #8b0302
// หัวข้อไล่เฉดทองอ่อน #fdea83 → ทองแบรนด์ #e0a52a → แดงแบรนด์ #8b0302
// เนื้อความ #f6e6cf (BRAND_TEXT) — ชุดเขียวป่า-ทองของ หวยเต็ง รอบก่อน
// (#062a12 #e5c04f #fae474 #026314 #0bb42f #eafbe9 #d8ead9) ออกครบแล้ว
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#e0a52a]/45 bg-[#2e0707]/94 p-8 text-left text-base leading-relaxed text-[#f6e6cf] shadow-[0_10px_30px_rgba(20,3,3,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#fdea83]/70 hover:shadow-[0_15px_40px_rgba(224,165,42,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#e0a52a]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#e0a52a]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#fdea83]/38"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#8b0302]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#c01616]/36"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#fdea83] via-[#e0a52a] to-[#8b0302] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#fdea83] via-[#e0a52a] to-[#8b0302] shadow-[0_0_10px_rgba(224,165,42,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
