---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#4a0b8f]/50 bg-[#150726]/92 p-8 text-left text-base leading-relaxed text-[#ece0fb] shadow-[0_10px_30px_rgba(157,22,241,0.12)] backdrop-blur-xl transition-all duration-500 hover:border-[#9d16f1]/60 hover:shadow-[0_15px_40px_rgba(157,22,241,0.24)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#9d16f1]/18 blur-[60px] transition-all duration-500 group-hover:bg-[#9d16f1]/28"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#e8e6ee]/14 blur-[60px] transition-all duration-500 group-hover:bg-[#e8e6ee]/22"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#4a0b8f]/50 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#c47bff] to-[#2c045c] shadow-[0_0_10px_rgba(157,22,241,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#9d16f1] via-[#c47bff] to-[#e8e6ee] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
