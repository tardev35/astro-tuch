---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// WY88 (รอบชมพูมาเจนตา-ทอง 2026-09-23): การ์ดพลัมเกือบดำ #24081a ในกรอบมาเจนตา
// เข้ม #a3145a ออร่าสองมุมเป็นมาเจนตาหลัก #ec2b84 กับทอง #e8b33a หัวข้อไล่จาก
// ชมพูกุหลาบ #f9a8cd → มาเจนตา #ec2b84 → ทอง #e8b33a ตรงกับโลโก้ที่ตัว WY เป็น
// ชมพูมาเจนตาและเลข 88 เป็นทอง เนื้อความใช้ #fce9f3 (BRAND_TEXT) ขาวอมชมพู —
// ชมพูบับเบิลกัม #fd6494 กับเหลืองมะนาว #feda2a ของรอบก่อนหายไปทั้งหมด
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#a3145a]/55 bg-[#24081a]/94 p-8 text-left text-base leading-relaxed text-[#fce9f3] shadow-[0_10px_30px_rgba(23,4,17,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#ec2b84]/70 hover:shadow-[0_15px_40px_rgba(236,43,132,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#e8b33a]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#ec2b84]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#ec2b84]/34"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#e8b33a]/24 blur-[60px] transition-all duration-500 group-hover:bg-[#e8b33a]/38"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#f9a8cd] via-[#ec2b84] to-[#e8b33a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#f9a8cd] via-[#ec2b84] to-[#e8b33a] shadow-[0_0_10px_rgba(236,43,132,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
