---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// หวยเฮง789 (รอบแดงนำ-ทองรอง 2026-10-01): เว็บแทงหวยออนไลน์ พาเลตต์มาจากโลโก้ที่
// vivid เป็นแดงล้วน (#ab0204 #e43434 #dc2224) โดยคำว่า "หวย" เป็นแดงเลือดนกเงาวาว
// ขอบทอง ส่วน "เฮง789" เป็นทองไล่เฉด และแบนเนอร์ฉากผ้าซาตินแดงมีลายไทยทอง เหรียญทอง
// และลูกหวย — การ์ดแดงเข้ม #2b0909 ในกรอบแดงแบรนด์ #dc2224 ออร่ามุมซ้ายบนเป็นแดง
// มุมขวาล่างเป็นทองรอง #f4bc5d หัวข้อไล่เฉดทองอ่อน #ffefc2 → ทองรอง #f4bc5d →
// แดงแบรนด์ #dc2224 เนื้อความ #fbe3d4 (BRAND_TEXT)
//
// รอบก่อน (หวยเฮง24) เป็นเว็บหวยแดง-ทองเหมือนกันแต่ "นำด้วยทอง" — กรอบทอง #e0a52a
// บนการ์ด #2e0707 รอบนี้สลับลำดับให้แดงเป็นสีตัวตน ทองเป็นสีเน้น ชุดเดิมทั้งชุด
// (#e0a52a #fdea83 #8b0302 #c01616 #2e0707 #f6e6cf) ออกครบทุกจุดแล้ว
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#dc2224]/50 bg-[#2b0909]/94 p-8 text-left text-base leading-relaxed text-[#fbe3d4] shadow-[0_10px_30px_rgba(11,2,2,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#f4bc5d]/70 hover:shadow-[0_15px_40px_rgba(220,34,36,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#dc2224]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#dc2224]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#e43434]/38"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#f4bc5d]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#ffefc2]/32"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#ffefc2] via-[#f4bc5d] to-[#dc2224] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#ffefc2] via-[#f4bc5d] to-[#dc2224] shadow-[0_0_10px_rgba(244,188,93,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
