---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro, /promotion and
// every button page render their body through this file and never follow the
// per-brand ContentBox rotation, so it must carry the CURRENT brand's colours
// even when index.astro picks another variant. Nothing inside those pages names
// a colour — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// นินจา168 (รอบฟ้าไซยานนำ-เหลืองมะนาวรอง บนดำสนิท 2026-10-19): พาเลตต์ตาม
// .claude/brand-spec-ninja168.md §2
// โลโก้อ่านตรงๆ ได้ว่า: **นินจาการ์ตูนชุดดำ** ผูกผ้าคาดหัวฟ้า-ขาวมีดาวน้ำเงิน
// ขยิบตา ถือ **ดาวกระจาย (ชูริเคน) สีฟ้า** มีผ้าพันคอฟ้าปลิว ยืนอยู่ซ้ายของคำว่า
// "นินจา" ซึ่งเป็นตัวอักษรไทยหนาสามมิติ **สีเหลืองทอง** ต่อด้วย "168" **สีฟ้า
// บับเบิลผิวมันวาว** ล้อมด้วยประกายดาวสีทองและชูริเคนสีฟ้า ส่วนแบนเนอร์กับสไลด์
// เป็นฉาก **พื้นขาว-ฟ้าน้ำแข็ง** ที่มีนินจาตัวเดียวกัน หญิงสาวผมบลอนด์เงินชุดลูกไม้
// ขาว-ฟ้าชี้นิ้วมาทางผู้ชม ตู้สล็อตขึ้นเลข 777 เหรียญทอง และหัวใจสีฟ้าทั่วภาพ
//
// ⚠️ รอบนี้ **ฟ้าไซยานนำ เหลืองมะนาวเป็นฮิวที่สอง น้ำเงินลึกเป็นเงาที่ไม่เคยถือ
// ตัวอักษร** และ **เป็นรอบแรกที่ตระกูลสีซ้ำกับรอบก่อน** (สบายเบท168 ก็ฟ้านำ +
// ทองรอง) ที่ซ้ำเพราะอาร์ตเวิร์กมาแบบนั้นจริง ไม่ใช่เพราะลอกมา สิ่งที่แยกรอบนี้
// ออกจากรอบก่อนจึงอยู่ที่ **ค่าสี** กับ **การหมุน variant** ไม่ใช่ที่วงศ์สี:
//   ฟ้ารอบนี้ #32bcfb ไซยานสว่างกว่า 2f9ff5 ของรอบก่อน
//   ฮิวที่สองรอบนี้ #fef54b เป็น **เหลืองมะนาว** ไม่ใช่ทองอำพัน ffc82e
//   ชุดความลึกรอบนี้ #0c2a3d / #071a28 / #030e16 ไม่ใช่ 0e2238 / 081726 / 040d16
// (ก่อนหน้านั้น: ถอนชัวร์168 ชมพูบับเบิลกัมนำ+ทองเนยรอง · มีโชค168 ทองนำ+ชมพู
// บานเย็น · ขวัญใจ168 ทองนำ+โรสโกลด์ · รับตัง168 ทองนำ+แดงสด · สมหวัง168 แดงนำ)
// ⚠️ พื้นเพจรอบนี้เป็น **ดำสนิท** (bg.json = {"mode":"color","color":"#000000"})
// ถึงแม้แบนเนอร์จะเป็นฉากพื้นขาว — bg.json คือแหล่งเดียวของพื้นเพจ
//
// ฟ้าแบรนด์ #32bcfb (อ่านจากตัวอักษร 168 บนโลโก้ ผ้าคาดหัวนินจา ชูริเคน และหัวใจ
// บนแบนเนอร์) ถือขอบการ์ดและเส้นคาดบนสุด · ฟ้าน้ำแข็ง #a9e9ff เป็นต้นของหัวข้อ ·
// เหลืองมะนาว #fef54b เป็นปลายหัวข้อ สี hover ของขอบ และเป็นตัวที่ **สงวนไว้ใช้
// ไฮไลต์ <strong> ในเนื้อความเท่านั้น** · น้ำเงินลึก #07335f กับทองลึก #6b5c10
// เป็นออรามุมขวาล่างกับปลายเข้มของเส้นใต้ — สองตัวหลังไม่เคยถือตัวอักษร
// ลำดับ ฟ้าน้ำแข็ง→ฟ้าไซยาน→เหลืองมะนาว ของหัวข้อคือลำดับที่ตาอ่านงานศิลป์จริง
// (ไฮไลต์มันวาวบนตัวอักษร → เนื้อฟ้าของเลข 168 → คำว่า นินจา สีเหลืองทองที่อยู่
// ก่อนหน้า) และทั้งสามค่าอยู่ที่ 11.3:1 / 7.1:1 / 12.7:1 บนผิวการ์ดนี้ จึงผ่าน AA
// ทุกจุดของเกรเดียนต์
// เนื้อความเป็นขาวอมฟ้า #dceefc (= BRAND_TEXT) — 13.2:1 บนผิวการ์ดนี้
//
// ⚠️ ไฟล์นี้เป็นของแบรนด์ก่อนหน้าทุกรอบ ห้ามเหมาว่าสีที่เจอเป็นของรอบนี้ ต้องเทียบ
// เป็น "ค่า" ไม่ใช่ "ตระกูลสี" และรอบนี้กับดักหนักกว่าทุกรอบ เพราะ **ทั้งฟ้าและทอง
// เพิ่งถูกใช้ไปเมื่อรอบที่แล้วทั้งคู่**
//   ทอง/เหลือง — สบายเบท168 ffc82e (+5c4a16) · ถอนชัวร์168 ffd84d ·
//         มีโชค168 fcd434 (+ffeaa0) · ขวัญใจ168 f7c92b · รับตัง168 f0b429 ·
//         สมหวัง168 e3b23c · KMD88 e2b33f · TND168 dfa310 · KINGKONG555 f2c230
//   ฟ้า/น้ำเงิน — สบายเบท168 2f9ff5 (+a8dcff d6ecff 0b3f78) · HI59 0a84e0
//         (+04203f +e4f1fd) · TSDET911 0360f3 (+0292fb +6ec8ff) · รับตัง168
//         cfd9e6 (เงินอมฟ้า หน้าตาใกล้ฟ้าอ่อนมาก)
// ส่วน **ฟ้ารอบนี้คือ #32bcfb (+#a9e9ff +#07335f)** และ **เหลืองรอบนี้คือ #fef54b**
// ชุดเต็มของสบายเบท168 (2f9ff5 a8dcff d6ecff 0b3f78 ffc82e 5c4a16 e8f4ff 0e2238
// 081726 040d16 04121f และ rgba 47/159/245 α) rgba 255/200/46 α) rgba 168/220/255 α)
// rgba 11/63/120 α)) ออกครบทุกจุดแล้ว
// เช่นเดียวกับชุดของถอนชัวร์168 (fa63b9 ffb3de ffd84d 2b0f20 1a0914 0d040a 6d0b3f
// 6b4708 2a0617 fdeaf5) ของมีโชค168 (fcd434 ffeaa0 f5469f ff8dc6 8c0f52 7a5508
// 1a0612 f6e4ee 24101c 160a12 0b0509) ของขวัญใจ168 (f7c92b ffe6a3 f2bba5 c98a74
// b3121b 5a0a0e 8a5f12 eadfce 140c06 241509 160d06 0b0603) ของรับตัง168 (f0b429
// ffdc8c d30304 ff6b6e a00203 4a0202 9a6c0c cfd9e6 f5ece0 2b100f 200a09 140505
// 1a0505) ของสมหวัง168 (fa0513 ffadaf ff5a5f e3b23c ffe5a8 8a6210 b90203 8c0204
// 5b0203 3c0303 170504 f4ecea ccb9b6 2c1413 1f0d0c 140706 290f0f) ของ TKB55
// (fb131b ff8a8f ff4d55 e9eef4 aeb9c6 f2e4e5 2a0d0f 1a0708 0d0304 c40304 8a0206
// 53050a 1a0304) และของ GT66B (fb141b ff5f63 ffa0a2 db040b ec151c 8a0609 3b0405
// fdfcfd b4bcc2 eceaea 190505 1c0c0b 130c0c 0b0303)
// ค่าของแบรนด์เก่ากว่านั้นที่เคยผ่านไฟล์นี้ — TSDET911 น้ำเงินไฟฟ้า · KMD88 ม่วง
// ราชา-ทอง · TND168 ทองมังกร · WEPLAY168 ม่วงนีออน · PUNPRO168 ชมพูฮอตพิงก์ ·
// 789BETTING ทองเมทัลลิก · TIGERWIN369 ทองอำพัน · UFA324 ทองแชมเปี้ยน ·
// FAH999 ชมพู-ทอง · DUCK1688 ทองเป็ด · NAZA168 ทองอวกาศ · KINGKONG555 เขียว-ทอง
// — ไม่เหลือในไฟล์นี้แล้วเช่นกัน (ไม่พิมพ์ค่าซ้ำที่นี่ รายการเต็มอยู่ใน
// brand-spec §2 เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive ในไฟล์ที่ render)
// ⚠️ **รอบนี้ไม่มีชมพู ไม่มีแดง ไม่มีม่วง ไม่มีเขียว ไม่มีส้ม ไม่มีเงิน/โครเมียม
// อมฟ้า และไม่มีโรสโกลด์**
//
// ⚠️ #07335f และ #6b5c10 ห้ามถือตัวอักษรทุกขนาด อยู่ได้เฉพาะในไล่เฉดของเส้นคาด
// ในออรา และเป็นขอบ ส่วน #fef54b (12.7:1) #a9e9ff (11.3:1) และ #32bcfb (7.1:1)
// ถือตัวอักษรรองได้จริง
// (เฮกซ์ของแบรนด์เก่าในคอมเมนต์ด้านบนเขียนแบบ **ไม่มี #** โดยตั้งใจ เพื่อไม่ให้
// การ sweep ไล่หาสีของแบรนด์เก่าใน src/ สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#32bcfb]/45 bg-[#0c2a3d]/95 p-8 text-left text-base leading-relaxed text-[#dceefc] shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#fef54b]/70 hover:shadow-[0_15px_40px_rgba(50,188,251,0.35)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#32bcfb]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#32bcfb]/40 blur-[60px] transition-all duration-500 group-hover:bg-[#a9e9ff]/30"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#07335f]/80 blur-[60px] transition-all duration-500 group-hover:bg-[#6b5c10]/45"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#a9e9ff] via-[#32bcfb] to-[#fef54b] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#32bcfb] via-[#fef54b] to-[#07335f] shadow-[0_0_10px_rgba(50,188,251,0.65)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
