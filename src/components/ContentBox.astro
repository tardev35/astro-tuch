---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// หวย365 (รอบแดงสด-ทอง 2026-10-02): เว็บแทงหวยออนไลน์ พาเลตต์มาจากโลโก้ที่ vivid
// เป็นแดงสดล้วน (#dc0203 สัดส่วน 29.7% รองลงมา #e00104 #e2020a) โดยคำว่า "หวย"
// กับเลข 6 เป็นแดงสด ส่วนเลข 3 กับ 5 เป็นดำ และแบนเนอร์เป็นฉากผ้าซาตินแดงกับลายไทย
// ทอง เหรียญทอง และลูกหวย — การ์ดแดงเกือบดำ #240406 ในกรอบแดงแบรนด์ #dc0203 ออรา
// มุมซ้ายบนเป็นแดง มุมขวาล่างเป็นทอง #ffc93c หัวข้อไล่เฉดทองอ่อน #ffeab0 → ทอง
// #ffc93c → แดงแบรนด์ #dc0203 เนื้อความ #f6e7e0 (BRAND_TEXT)
//
// รอบก่อน (หวยเฮง789) เป็นเว็บหวยแดง-ทองเหมือนกัน แต่เป็นแดงอมชมพูหม่น #dc2224 คู่
// ทองน้ำตาล #f4bc5d บนการ์ด #2b0909 รอบนี้ขยับเป็นแดงสดล้วนตามโลโก้ใหม่ คู่ทอง
// เหลืองสว่างกว่า บนการ์ดเข้มกว่าเดิม ชุดเดิมทั้งชุด (#dc2224 #f4bc5d #ffefc2
// #fbe3d4 #2b0909 #e43434) ออกครบทุกจุดแล้ว
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#dc0203]/50 bg-[#240406]/94 p-8 text-left text-base leading-relaxed text-[#f6e7e0] shadow-[0_10px_30px_rgba(8,1,1,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffc93c]/70 hover:shadow-[0_15px_40px_rgba(220,2,3,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#dc0203]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#dc0203]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#f5282a]/38"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#ffc93c]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#ffeab0]/32"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#ffeab0] via-[#ffc93c] to-[#dc0203] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#ffeab0] via-[#ffc93c] to-[#dc0203] shadow-[0_0_10px_rgba(255,201,60,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
