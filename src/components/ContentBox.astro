---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro, /promotion and
// every button page render their body through this file and never follow the
// per-brand ContentBox rotation, so it must carry the CURRENT brand's colours
// even when index.astro picks another variant. Nothing inside those pages names
// a colour — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// รวยแทร่168 (รอบฟ้าอะซัวร์นำ-ทองอำพันรอง บนดำสนิท 2026-10-19): พาเลตต์ตาม
// .claude/brand-spec-ruaythear168.md §2
// โลโก้อ่านตรงๆ ได้ว่า: คำว่า **"รวย"** เป็นตัวอักษรไทยหนาสามมิติ **สีทองอำพัน
// ตัดขอบขาว** ต่อด้วย **"แทร่168"** **สีฟ้าอะซัวร์บับเบิลผิวมันวาว** ทางซ้ายเป็น
// **ถุงเงินสีฟ้าสลักเครื่องหมายดอลลาร์** **ปึกธนบัตร** และ **กองเหรียญทอง**
// ล้อมด้วย **หัวใจสีฟ้า** กับ **ประกายดาวฟ้า-ทอง** บนพื้นขาว ส่วนแบนเนอร์กับสไลด์
// เป็นฉาก **พื้นขาว-ฟ้าน้ำแข็ง** ที่มีหญิงสาวผมบลอนด์เงินชุดลูกไม้ขาว-ฟ้าผูกโบว์
// ซาตินฟ้าชี้นิ้วมาทางผู้ชม มือถือจอฟ้า ตู้สล็อต เหรียญทองร่วง และกล่องของขวัญ
// ผูกโบว์ฟ้า
//
// ⚠️ รอบนี้ **ฟ้าอะซัวร์นำ ทองอำพันเป็นฮิวที่สอง น้ำเงินลึกเป็นเงาที่ไม่เคยถือ
// ตัวอักษร** และ **เป็นรอบที่สองติดกันที่ตระกูลสีซ้ำกับรอบก่อน** (นินจา168 ฟ้า
// ไซยาน+เหลืองมะนาว · สบายเบท168 ฟ้าท้องฟ้า+ทองอำพัน) ที่ซ้ำเพราะอาร์ตเวิร์กมา
// แบบนั้นจริง ไม่ใช่เพราะลอกมา สิ่งที่แยกรอบนี้ออกจากรอบก่อนจึงอยู่ที่ **ค่าสี**
// กับ **การหมุน variant** ไม่ใช่ที่วงศ์สี:
//   ฟ้ารอบนี้ #039cfa เป็นอะซัวร์อิ่มสีจัด ไม่ใช่ไซยาน 32bcfb ของรอบก่อน
//   ฮิวที่สองรอบนี้ #f9a826 เป็น **ทองอำพัน** ไม่ใช่เหลืองมะนาว fef54b
//   ชุดความลึกรอบนี้ #0b2d52 / #071e38 / #030f1d ไม่ใช่ 0c2a3d / 071a28 / 030e16
// (ก่อนหน้านั้น: สบายเบท168 ฟ้าท้องฟ้า+ทองอำพัน · ถอนชัวร์168 ชมพูบับเบิลกัมนำ+
// ทองเนยรอง · มีโชค168 ทองนำ+ชมพูบานเย็น · ขวัญใจ168 ทองนำ+โรสโกลด์ · รับตัง168
// ทองนำ+แดงสด · สมหวัง168 แดงนำ)
// ⚠️ พื้นเพจรอบนี้เป็น **ดำสนิท** (bg.json = {"mode":"color","color":"#000000"})
// ถึงแม้แบนเนอร์จะเป็นฉากพื้นขาว — bg.json คือแหล่งเดียวของพื้นเพจ
//
// ฟ้าแบรนด์ #039cfa (อ่านจากตัวอักษร แทร่168 บนโลโก้ ถุงเงิน มือถือ และหัวใจ
// บนแบนเนอร์) ถือขอบการ์ดและเส้นคาดบนสุด · ฟ้าน้ำแข็ง #c3ebfc เป็นต้นของหัวข้อ ·
// ทองอำพัน #f9a826 เป็นปลายหัวข้อ สี hover ของขอบ และเป็นตัวที่ **สงวนไว้ใช้
// ไฮไลต์ <strong> ในเนื้อความเท่านั้น** · น้ำเงินลึก #04366b กับบรอนซ์ลึก #704504
// เป็นออรามุมขวาล่างกับปลายเข้มของเส้นใต้ — สองตัวหลังไม่เคยถือตัวอักษร
// ลำดับ ฟ้าน้ำแข็ง→ฟ้าอะซัวร์→ทองอำพัน ของหัวข้อคือลำดับที่ตาอ่านงานศิลป์จริง
// (ไฮไลต์มันวาวบนตัวอักษร → เนื้อฟ้าของ แทร่168 → คำว่า รวย สีทองอำพันที่อยู่
// ก่อนหน้า) และทั้งสามค่าอยู่ที่ 10.8:1 / 4.6:1 / 6.9:1 บนผิวการ์ดนี้ จึงผ่าน AA
// ทุกจุดของเกรเดียนต์
// เนื้อความเป็นขาวอมฟ้า #e3f2fc (= BRAND_TEXT) — 11.9:1 บนผิวการ์ดนี้
//
// ⚠️ ไฟล์นี้เป็นของแบรนด์ก่อนหน้าทุกรอบ ห้ามเหมาว่าสีที่เจอเป็นของรอบนี้ ต้องเทียบ
// เป็น "ค่า" ไม่ใช่ "ตระกูลสี" และรอบนี้กับดักหนักที่สุดเท่าที่เคยมี เพราะ
// **ทั้งฟ้าและทองถูกใช้ติดกันมาแล้วสองรอบ**
//   ทอง/เหลือง — นินจา168 fef54b (+6b5c10) · สบายเบท168 ffc82e (+5c4a16) ·
//         ถอนชัวร์168 ffd84d · มีโชค168 fcd434 (+ffeaa0) · ขวัญใจ168 f7c92b ·
//         รับตัง168 f0b429 · สมหวัง168 e3b23c · KMD88 e2b33f · TND168 dfa310 ·
//         KINGKONG555 f2c230 · UFA324 e5a81b
//   ฟ้า/น้ำเงิน — นินจา168 32bcfb (+a9e9ff 07335f) · สบายเบท168 2f9ff5 (+a8dcff
//         d6ecff 0b3f78) · HI59 0a84e0 (+04203f +e4f1fd) · TSDET911 0360f3
//         (+0292fb +6ec8ff) · รับตัง168 cfd9e6 (เงินอมฟ้า หน้าตาใกล้ฟ้าอ่อนมาก)
// ส่วน **ฟ้ารอบนี้คือ #039cfa (+#c3ebfc +#04366b)** และ **ทองรอบนี้คือ #f9a826**
// ชุดเต็มของนินจา168 (32bcfb a9e9ff 07335f fef54b 6b5c10 0c2a3d 071a28 030e16
// 041019 dceefc และ rgba 50/188/251 α) rgba 254/245/75 α) rgba 169/233/255 α)
// rgba 7/51/95 α)) ออกครบทุกจุดแล้ว
// เช่นเดียวกับชุดของสบายเบท168 (2f9ff5 a8dcff d6ecff 0b3f78 ffc82e 5c4a16 e8f4ff
// 0e2238 081726 040d16 04121f) ของถอนชัวร์168 (fa63b9 ffb3de ffd84d 2b0f20 1a0914
// 0d040a 6d0b3f 6b4708 2a0617 fdeaf5) ของมีโชค168 (fcd434 ffeaa0 f5469f ff8dc6
// 8c0f52 7a5508 1a0612 f6e4ee 24101c 160a12 0b0509) ของขวัญใจ168 (f7c92b ffe6a3
// f2bba5 c98a74 b3121b 5a0a0e 8a5f12 eadfce 140c06 241509 160d06 0b0603)
// ของรับตัง168 (f0b429 ffdc8c d30304 ff6b6e a00203 4a0202 9a6c0c cfd9e6 f5ece0
// 2b100f 200a09 140505 1a0505) ของสมหวัง168 (fa0513 ffadaf ff5a5f e3b23c ffe5a8
// 8a6210 b90203 8c0204 5b0203 3c0303 170504 f4ecea ccb9b6 2c1413 1f0d0c 140706
// 290f0f) ของ TKB55 (fb131b ff8a8f ff4d55 e9eef4 aeb9c6 f2e4e5 2a0d0f 1a0708
// 0d0304 c40304 8a0206 53050a 1a0304) และของ GT66B (fb141b ff5f63 ffa0a2 db040b
// ec151c 8a0609 3b0405 fdfcfd b4bcc2 eceaea 190505 1c0c0b 130c0c 0b0303)
// ค่าของแบรนด์เก่ากว่านั้นที่เคยผ่านไฟล์นี้ — TSDET911 น้ำเงินไฟฟ้า · KMD88 ม่วง
// ราชา-ทอง · TND168 ทองมังกร · WEPLAY168 ม่วงนีออน · PUNPRO168 ชมพูฮอตพิงก์ ·
// 789BETTING ทองเมทัลลิก · TIGERWIN369 ทองอำพัน · UFA324 ทองแชมเปี้ยน ·
// FAH999 ชมพู-ทอง · DUCK1688 ทองเป็ด · NAZA168 ทองอวกาศ · KINGKONG555 เขียว-ทอง
// — ไม่เหลือในไฟล์นี้แล้วเช่นกัน (ไม่พิมพ์ค่าซ้ำที่นี่ รายการเต็มอยู่ใน
// brand-spec §2 เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive ในไฟล์ที่ render)
// ⚠️ **รอบนี้ไม่มีชมพู ไม่มีแดง ไม่มีม่วง ไม่มีเขียว ไม่มีส้ม ไม่มีเงิน/โครเมียม
// อมฟ้า ไม่มีโรสโกลด์ และไม่มีเหลืองมะนาว**
//
// ⚠️ #04366b และ #704504 ห้ามถือตัวอักษรทุกขนาด อยู่ได้เฉพาะในไล่เฉดของเส้นคาด
// ในออรา และเป็นขอบ ส่วน #c3ebfc (10.8:1) #f9a826 (6.9:1) และ #039cfa (4.6:1)
// ถือตัวอักษรรองได้จริง
// (เฮกซ์ของแบรนด์เก่าในคอมเมนต์ด้านบนเขียนแบบ **ไม่มี #** โดยตั้งใจ เพื่อไม่ให้
// การ sweep ไล่หาสีของแบรนด์เก่าใน src/ สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#039cfa]/45 bg-[#0b2d52]/95 p-8 text-left text-base leading-relaxed text-[#e3f2fc] shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#f9a826]/70 hover:shadow-[0_15px_40px_rgba(3,156,250,0.35)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#039cfa]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#039cfa]/40 blur-[60px] transition-all duration-500 group-hover:bg-[#c3ebfc]/30"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#04366b]/80 blur-[60px] transition-all duration-500 group-hover:bg-[#704504]/45"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#c3ebfc] via-[#039cfa] to-[#f9a826] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#039cfa] via-[#f9a826] to-[#04366b] shadow-[0_0_10px_rgba(3,156,250,0.65)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
