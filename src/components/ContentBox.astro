---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// FAH999 (รอบม่วง-ทอง 2026-09-21): การ์ดม่วงเข้ม #180430 ในกรอบม่วงกลาง
// #7c2fd4 ออร่าสองมุมเป็นทองหลัก #fbbf13 กับม่วงสว่าง #a855f7 หัวข้อไล่จาก
// ทองประกาย #fef354 → ทองหลัก #fbbf13 → ทองอ่อน #ffdf6b ซึ่งเป็นไล่เฉด
// เดียวกับตัวอักษร FAH บนโลโก้ ส่วนเนื้อความใช้ #ecdcff (BRAND_TEXT) ให้
// อ่านง่ายบนพื้นม่วง — โทนดำ+ทองของรอบก่อนหายไปทั้งหมด
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#7c2fd4]/55 bg-[#180430]/94 p-8 text-left text-base leading-relaxed text-[#ecdcff] shadow-[0_10px_30px_rgba(13,1,25,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#fbbf13]/70 hover:shadow-[0_15px_40px_rgba(251,191,19,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#fbbf13]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#fbbf13]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#fbbf13]/34"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#a855f7]/30 blur-[60px] transition-all duration-500 group-hover:bg-[#a855f7]/44"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#fef354] via-[#fbbf13] to-[#ffdf6b] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#fef354] to-[#4a1188] shadow-[0_0_10px_rgba(251,191,19,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
