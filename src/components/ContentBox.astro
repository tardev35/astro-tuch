---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro, /promotion and
// every button page render their body through this file and never follow the
// per-brand ContentBox rotation, so it must carry the CURRENT brand's colours
// even when index.astro picks another variant. Nothing inside those pages names
// a colour — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// รับตัง168 (รอบทองไทยนำ-แดงมังกรรอง 2026-10-18): พาเลตต์ตาม
// .claude/brand-spec-rubtang168.md §2
// โลโก้อ่านตรงๆ ได้ว่า: คำว่า "รับตัง" เป็นตัวอักษรสามมิติผิวโครเมียมอมฟ้าเงิน
// ขอบแดง ต่อด้วยเลข "168" สีแดงสดตัวหนาสามมิติ บนกองเหรียญจีนทองรูสี่เหลี่ยม
// และริบบิ้นซาตินแดง ส่วนแบนเนอร์กับสไลด์เป็นฉากพื้นดำที่ถูกกลบด้วยฝนเหรียญทอง
// กองชิปคาสิโนทอง-ดำ-แดง ไพ่เอซ กรอบลวดลายทอง และมงกุฎทอง
//
// ⚠️ รอบนี้ **ทองนำ แดงรอง** ซึ่งสลับจากรอบก่อนที่แดงนำทองรอง — เหรียญทองคือ
// บริเวณอิ่มสีที่กว้างที่สุดในงานศิลป์ของดรอปนี้ ขอบการ์ดและเส้นคาดบนจึงเป็นทอง
// ส่วนแดงถอยไปเป็นออรามุมและสต็อปกลางของเส้นใต้หัวข้อ
// ⚠️ พื้นเพจรอบนี้เป็น **ดำอมแดง** (bg.json = {"mode":"color","color":"#1a0505"})
// เข้มกว่าของรอบก่อน ลำดับความลึก: #2b100f ผิวยก (การ์ดใบนี้) / #200a09 กลาง /
// #140505 จม / #1a0505 พื้น — อ่านมาจาก dominant ของ banner1.png ใน palette.json
//
// ทองแบรนด์ #f0b429 (วัดจากกองเหรียญ) ถือขอบการ์ดและเส้นคาดบนสุด · ทองสว่าง
// #ffdc8c เป็นต้นของหัวข้อ · แดงสว่าง #ff6b6e เป็นปลายหัวข้อและสี hover ของขอบ ·
// แดงแบรนด์ #d30304 เป็นออรามุมซ้ายบนและสต็อปกลางของเส้นใต้ · แดงลึก #4a0202
// #a00203 และทองลึก #9a6c0c เป็นออรามุมขวาล่างกับปลายเข้มของเส้นใต้ — ทั้งสาม
// ไม่เคยถือตัวอักษร
// ลำดับ ทองสว่าง→ทองแบรนด์→แดงสว่าง ของหัวข้อคือลำดับที่ตาอ่านงานศิลป์จริง
// (ฝนเหรียญทองรอบนอก ไล่เข้าไปหาเลข 168 แดงสดกลางภาพ) และทั้งสามค่าอยู่ที่
// 12:1 / 8.5:1 / 5.4:1 บนผิวการ์ดนี้ จึงผ่าน AA ทุกจุดของเกรเดียนต์
// เนื้อความเป็นขาวนวลอมอุ่น #f5ece0 (= BRAND_TEXT) — 13.0:1 บนผิวการ์ดนี้
//
// ⚠️ ไฟล์นี้เป็นของแบรนด์ก่อนหน้าทุกรอบ ห้ามเหมาว่าสีที่เจอเป็นของรอบนี้ ต้องเทียบ
// เป็น "ค่า" ไม่ใช่ "ตระกูลสี" และรอบนี้กับดักหนักเป็นพิเศษ เพราะ **สามแบรนด์
// ก่อนหน้าเป็นแดงทั้งหมด** แดงของ GT66B คือ #fb141b · ของ TKB55 คือ #fb131b ·
// ของสมหวัง168 คือ #fa0513 · ส่วนแดงรอบนี้คือ #d30304
// ชุดเต็มของสมหวัง168 (#fa0513 #ffadaf #ff5a5f #e3b23c #ffe5a8 #8a6210 #b90203
// #8c0204 #5b0203 #3c0303 #170504 #f4ecea #ccb9b6 #2c1413 #1f0d0c #140706
// #290f0f และ rgba(250,5,19,α) rgba(227,178,60,α) rgba(255,173,175,α))
// ออกครบทุกจุดแล้ว เช่นเดียวกับชุดของ TKB55 (#fb131b #ff8a8f #ff4d55 #e9eef4
// #aeb9c6 #f2e4e5 #2a0d0f #1a0708 #0d0304 #c40304 #8a0206 #53050a #1a0304)
// และของ GT66B (#fb141b #ff5f63 #ffa0a2 #db040b #ec151c #8a0609 #3b0405 #fdfcfd
// #b4bcc2 #eceaea #190505 #1c0c0b #130c0c #0b0303)
// ค่าของแบรนด์เก่ากว่านั้นที่เคยผ่านไฟล์นี้ — TSDET911 น้ำเงินไฟฟ้า · KMD88 ม่วง
// ราชา-ทอง · TND168 ทองมังกร · WEPLAY168 ม่วงนีออน · PUNPRO168 ชมพูฮอตพิงก์ ·
// 789BETTING ทองเมทัลลิก · TIGERWIN369 ทองอำพัน · UFA324 ทองแชมเปี้ยน ·
// FAH999 ชมพู-ทอง · DUCK1688 ทองเป็ด · NAZA168 ทองอวกาศ · KINGKONG555 เขียว-ทอง
// — ไม่เหลือในไฟล์นี้แล้วเช่นกัน (ไม่พิมพ์ค่าซ้ำที่นี่ รายการเต็มอยู่ใน
// brand-spec §2 เพื่อไม่ให้ grep หาสีแบรนด์เก่าเจอ false positive ในไฟล์ที่ render)
// ⚠️ แดงรอบนี้ #d30304 ต่างจากแดงของ PIGPG (#d4200d) แค่สองหลัก และทองรอบนี้
// #f0b429 ต่างจากทองของสมหวัง168 (#e3b23c) กับ KMD88 (#e2b33f) ไม่มาก —
// ให้เทียบเป็นตัวเลข ไม่ใช่ด้วยตา
// ⚠️ **รอบนี้ไม่มีม่วง ไม่มีชมพู ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว และไม่มีส้มเลย**
// มีแค่ทองกับแดง (สีเงินอมฟ้าในคำว่า "รับตัง" บนโลโก้ถูกดึงออกมาเป็น #cfd9e6
// ซึ่งเป็น **สีตัวอักษรรองเท่านั้น** ห้ามใช้เป็นขอบ สีเน้น หรือสต็อปเกรเดียนต์
// และไฟล์นี้ไม่ได้ใช้มันเลย)
//
// ⚠️ #d30304 เป็นขอบ/ออรา/ไล่เฉด ส่วน #a00203 #4a0202 #9a6c0c ห้ามถือตัวอักษร
// ทุกขนาด อยู่ได้เฉพาะในไล่เฉดของเส้นคาด ในออรา และเป็นขอบ ส่วน #ffdc8c (12:1)
// #f0b429 (8.5:1) #cfd9e6 (10.9:1) และ #ff6b6e (5.4:1) ถือตัวอักษรรองได้จริง
// และ #ffdc8c คือตัวที่สงวนไว้ใช้ไฮไลต์ <strong> ในเนื้อความเท่านั้น
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#f0b429]/45 bg-[#2b100f]/95 p-8 text-left text-base leading-relaxed text-[#f5ece0] shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#ff6b6e]/70 hover:shadow-[0_15px_40px_rgba(240,180,41,0.35)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#f0b429]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#d30304]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#ff6b6e]/35"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#4a0202]/80 blur-[60px] transition-all duration-500 group-hover:bg-[#9a6c0c]/45"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#ffdc8c] via-[#f0b429] to-[#ff6b6e] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#f0b429] via-[#d30304] to-[#a00203] shadow-[0_0_10px_rgba(240,180,41,0.65)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
