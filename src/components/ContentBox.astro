---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// GT66B (รอบแดงมังกร-โครเมียมขาว 2026-10-13): พาเลตต์ตาม
// .claude/brand-spec-gt66b.md §2
// โลโก้อ่านตรงๆ ได้ว่า: อักขระมังกรจีน 龍 เขียนด้วยพู่กันสีแดงสดอยู่ซ้ายสุด ต่อด้วย
// เวิร์ดมาร์ก GT66B ที่ GT เป็นโครเมียมขาวสามมิติ 66 เป็นแดงสดไล่เฉด และ B เป็น
// โครเมียมขาว ส่วนแบนเนอร์และสไลด์เป็นฉากคาสิโนดำสนิทที่ส่องด้วยริบบิ้นแสงแดง
// มีชิปคาสิโนแดง-ดำ-เงิน ไพ่เอซโพดำ ลูกเต๋าแดง และวงล้อรูเล็ต
// ⚠️ พื้นเพจรอบนี้เป็น **ดำสนิท** (bg.json = {"mode":"color","color":"#000000"})
// ลำดับความลึก: #1c0c0b ผิวยก (การ์ดใบนี้) / #130c0c กลาง / #0b0303 จม / #000000 พื้น
// ทั้งสามชั้นอ่านมาจาก dominant ของ banner1.png ใน palette.json ไม่ได้คิดเอง
//
// แดงแบรนด์ #fb141b (vivid ที่วัดได้จาก logo.webp ตรงๆ — ตัวเลข 66 และอักขระมังกร)
// ถือขอบการ์ด เส้นคาดบนสุด และออรามุมซ้ายบน · แดงสว่าง #ff5f63 เป็นสี hover ของ
// ขอบและปลายสว่างของเส้นใต้ · แดงอ่อน #ffa0a2 เป็นต้นกลางของหัวข้อ ·
// โครเมียมที่ถือตัวอักษรได้คือ #fdfcfd (18.5:1) และ #b4bcc2 (9.9:1) ·
// แดงลึก #db040b #8a0609 #3b0405 เป็นปลายเข้มของเส้นใต้และออรามุมขวาล่าง —
// ทั้งสามไม่เคยถือตัวอักษร
// ลำดับ โครเมียมสว่าง→แดงอ่อน→แดงแบรนด์ ของหัวข้อคือลำดับที่ตาอ่านโลโก้จริง
// (GT โครเมียมก่อน แล้วไล่เข้าไปที่ 66 แดงสด)
// เนื้อความเป็นขาวนวลเป็นกลาง #eceaea (= BRAND_TEXT) — 15.9:1 บนผิวการ์ดนี้
//
// ⚠️ ไฟล์นี้เป็นของแบรนด์ก่อนหน้าทุกรอบ ห้ามเหมาว่าสีที่เจอเป็นของรอบนี้ ต้องเทียบ
// เป็น "ค่า" ไม่ใช่ "ตระกูลสี" และรอบนี้กับดักหนักเป็นพิเศษ เพราะ **แบรนด์ก่อนหน้า
// ทันที (TKB55) ก็เป็นแดง-โลหะ-ดำเหมือนกัน** แดงของมันคือ #fb131b ส่วนแดงรอบนี้
// คือ #fb141b — ต่างกันหนึ่งหลัก ชุดเต็มของ TKB55 (#fb131b #ff8a8f #ff4d55
// #e9eef4 #aeb9c6 #f2e4e5 #2a0d0f #1a0708 #0d0304 #c40304 #8a0206 #53050a
// #1a0304 และ rgba(251,19,27,α) rgba(196,3,4,α) rgba(255,138,143,α)
// rgba(233,238,244,α)) ออกครบทุกจุดแล้ว
// ชุดน้ำเงินไฟฟ้า-เงินโครเมียมของ TSDET911 (#0360f3 #0292fb #6ec8ff #4fb4ff
// #cfdcec #9db4d4 #dde8f7 #102a5e #0a1c42 #040e26 #00081f #032dad #04186e
// #041a43 #021026) ชุดม่วงราชา-ทองของ KMD88 (#7505cc #b453ff #c07cff #d9b8ff
// #3a0565 #2c0349 #7a5a0a #e2b33f #ffdf8c #ffd45e #ece2f8 #bba8d4 #1a0526
// #1d0832 #140522 #0a0213) ชุดทองมังกรของ TND168 (#dfa310 #ffc93d #ffe4a3
// #c9b88e #f0e9dc #8a5c09 #43240b #140d02 #1b1307 #120c04 #070502) ชุดม่วงนีออน-
// ทองของ WEPLAY168 (#a435f0 #d2a6ff #c9b2e8 #5b1a75 #1e0a3c #0a0117 #fbe455)
// ชุดม่วง-ชมพูของ BPLAY639 (#7e22ce #c4b5fd #ddd6fe #f472b6 #14061f) ชุดชมพู
// ฮอตพิงก์-ทองของ PUNPRO168 (#f41571 #ff5ca8 #fce343 #ffd94a #f0c3dc #fde7f2
// #8a0a45 #4a0426 #2a0012 #4a1038 #3a0a2a #2e0022 #1c0014) ชุดทองเมทัลลิก-บรอนซ์
// ของ 789BETTING (#fad354 #ffe79a #ddab33 #8a6410 #c9881f #f3e7cd #b5a888 #060402
// #0a0802 #2a2008 #17130a) ชุดทองอำพันเสือของ TIGERWIN369 (#d98324 #f7b733
// #ffd98a #f7e4c0 #e3cfae #8a5214 #4a2a08 #1a0d02 #2d1c0a #1c1206 #0f0903)
// ชุดทองแชมเปี้ยน-เงินโครเมียมของ UFA324 (#e5a81b #b9c2cc #231c0e #17130a
// #0d0b06 #f0e8d4 #ffcf5e #ffe08a #7d5a07 #43300a #464f5a) ชุดชมพู-ทองของ FAH999
// (#ff3fa4 #ff6cbb #ffd1ea #fde8f3 #f5c53d #9c6f08 #b3006a #4a0b42 #3a0534
// #2e002c #210220) ชุดทองเป็ด-ส้มปากเป็ดของ DUCK1688 (#f3bb34 #fde464 #c8901a
// #8a5f08 #5c3f04 #f58b2a #ffc98a #a3510c #1a1203 #f6ecd9 #d8c69b #1f1709 #171106
// #0d0903) ชุดทองอวกาศ-เงินโครเมียมของ NAZA168 (#fbc134 #ffe87a #cf9a18 #96690a
// #6b4a05 #eef2f8 #cfd6e3 #9aa6bb #3f4859 #fdf3df #d9c9a6 #4e3406 #432b03 #382400
// #241700) และชุดเขียว-ทองของ KINGKONG555 (#8ce023 #f2c230 #ffe066 #a87a08
// #06220a) ออกครบทุกจุดแล้วเช่นกัน
// ⚠️ **กับดักรอบนี้คือแดง** โค้ดเบสนี้เคยมีแบรนด์แดงมาก่อนสี่เจ้า และค่าของพวกมัน
// ยังค้างอยู่ในไฟล์ inventory อื่น — TKB55 (#fb131b) SUPERSLOTCLUB (#e8232a
// #7d0f12 #4a0605 #180800 #f2b705 #ffd666) PIGPG (#d4200d #f5b61d #ffd87a
// #120302 #2a0806 #6b0402) และ FLASH877 (#ff3b14 #8c0f0a #2b0000 #f5c518 #ffdd73
// #b8860f) แดงของรอบนี้ (#fb141b = R:251 G:20 B:27) อ่านมาจาก palette.json ของ
// ดรอปนี้โดยตรง และ **ไม่ใช่** #fb131b (G:19) ไม่ใช่ #e8232a ไม่ใช่ #d4200d และ
// ไม่ใช่ #ff3b14 — ให้เทียบเป็นตัวเลข ไม่ใช่ด้วยตา
// ⚠️ **รอบนี้ไม่มีทอง ไม่มีม่วง ไม่มีชมพู ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว และ
// ไม่มีส้มเลย** มีแค่แดงกับโครเมียมขาว
//
// ⚠️ #fb141b #ff5f63 เป็นขอบ/ออรา/ไล่เฉด ส่วน #db040b #8a0609 #3b0405 ห้ามถือ
// ตัวอักษรทุกขนาด อยู่ได้เฉพาะในไล่เฉดของเส้นคาด ในออรา และเป็นขอบ ส่วน #fdfcfd
// (18.5:1) #b4bcc2 (9.9:1) #ffa0a2 (9.8:1) และ #ff5f63 (6.4:1) ถือตัวอักษรรองได้
// จริง และ #ffa0a2 คือตัวที่สงวนไว้ใช้ไฮไลต์ <strong> ในเนื้อความเท่านั้น
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#fb141b]/45 bg-[#1c0c0b]/95 p-8 text-left text-base leading-relaxed text-[#eceaea] shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#ff5f63]/70 hover:shadow-[0_15px_40px_rgba(251,20,27,0.35)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#fb141b]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#fb141b]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#ff5f63]/35"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#3b0405]/80 blur-[60px] transition-all duration-500 group-hover:bg-[#db040b]/45"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#fdfcfd] via-[#ffa0a2] to-[#fb141b] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#ff5f63] via-[#db040b] to-[#8a0609] shadow-[0_0_10px_rgba(251,20,27,0.65)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
