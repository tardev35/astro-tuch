---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// HI59 (รอบฟ้า-ทองบนการ์ดสว่าง 2026-10-07): เว็บสล็อต พาเลตต์ตาม brand-spec §2
// รอบนี้กลับขั้วจากทุกแบรนด์ก่อนหน้า — การ์ดเป็น "กระจกน้ำแข็งสว่าง" #f6fbff
// ไม่ใช่ผิวเกือบดำ เพราะโลโก้เป็นฟ้า-ทองบนพื้นใส แบนเนอร์กับสไลด์เป็นท้องฟ้า
// กลางวัน และ bg.json ของดรอปนี้เป็นสีพื้นม่วงฟ้าอ่อน #c1cce6
// ฟ้าแบรนด์ #0a84e0 มาจาก vivid ของ logo.webp (ตัวอักษร HI) ถือขอบการ์ด เส้นคาด
// บนสุด และออรามุมซ้ายบน · ทอง #fdbc04 จาก vivid ตัวเดียวกัน (ตัวเลข 59 และวง
// แหวนโค้ง) เป็นสีรอง ถือออรามุมขวาล่างและปลายไล่เฉดของหัวข้อ
// เนื้อความเป็นกรมท่าเข้ม #0d2744 (= BRAND_TEXT) หัวข้อไล่จาก #06355f ผ่าน
// ฟ้าแบรนด์ไปจบที่ทองเข้ม #c88a02 — ทองสว่างบนพื้นขาวอ่านไม่ออก จึงใช้เฉดเข้ม
//
// ชุดแดงแบรนด์+เงินโครเมียมของ หวยดีใจ (#dc0409 #f5363d #eef0f4 #c3c7d1 #f3c54e
// #17080c #edeaf0) ออกครบทุกจุดแล้ว — รอบนี้ไม่ใช่การเปลี่ยนเบอร์สีบนโครงเดิม
// แต่เป็นการพลิกจากการ์ดมืดเป็นการ์ดสว่าง เงาจึงเป็นเงาฟ้าอ่อนแทนเงาดำทึบ
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#9ecbf2]/70 bg-[#f6fbff]/95 p-8 text-left text-base leading-relaxed text-[#0d2744] shadow-[0_10px_30px_rgba(6,53,95,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#0a84e0]/70 hover:shadow-[0_15px_40px_rgba(10,132,224,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#0a84e0]/70 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#5ec2ff]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#18a0f0]/55">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#fdbc04]/30 blur-[60px] transition-all duration-500 group-hover:bg-[#ffe27a]/45">
    </div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#06355f] via-[#065a9c] to-[#c88a02] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#0a84e0] via-[#5ec2ff] to-[#fdbc04] shadow-[0_0_10px_rgba(10,132,224,0.55)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
