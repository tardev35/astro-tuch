---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// UOK365 (รอบทองเมทัลลิกบนการ์ดน้ำตาลเกือบดำ 2026-10-07): เว็บสล็อตเบทต่ำ
// พาเลตต์ตาม brand-spec §2 รอบนี้พลิกฮิวจากเขียวนีออนของ BOOM369 มาเป็นทอง —
// การ์ดยังเป็นกระจกมืดเหมือนเดิมแต่เป็นผิวน้ำตาลอมดำ #120c07 เพราะ bg.json ของ
// ดรอปนี้เป็น #000000 และงานศิลป์ทั้งชุด (โลโก้ แบนเนอร์ สไลด์) เป็นโถงดำที่ส่อง
// ด้วยแสงทองพร้อมเหรียญทองและชิปดำ-ทอง
//
// ทองแบรนด์ #c8912f มาจาก vivid อันดับ 1 ของ logo.webp (#a46b25) ปรับให้สว่างพอ
// เป็นเส้นขอบได้ ถือขอบการ์ด เส้นคาดบนสุด และออรามุมซ้ายบน · ทองอ่อน/แชมเปญ
// #f5d98a เป็นปลายสว่างของหัวข้อ · เงินโครเมียม #d8dbe0 มาจากเลข 365 ในโลโก้
// เป็นปลายไล่เฉดของหัวข้อ ไม่ใช่สีแบรนด์ตัวที่สอง · ทองกลาง #a46b25 กับทองลึก
// #6d4412 เป็นออรามุมขวาล่างและปลายเข้มของเส้นใต้หัวข้อ
// เนื้อความเป็นงาช้างอมอุ่น #ece1cc (= BRAND_TEXT) — 14.6:1 บนผิวการ์ดนี้
//
// ชุดเขียวนีออนของ BOOM369 (#42fb5a #8dffa0 #04ab3a #036b26 #07170f #0b231b
// #cfe9d7 #dadcdc #f3c44a) ออกครบทุกจุดแล้ว
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#c8912f]/30 bg-[#120c07]/95 p-8 text-left text-base leading-relaxed text-[#ece1cc] shadow-[0_10px_30px_rgba(0,0,0,0.55)] backdrop-blur-xl transition-all duration-500 hover:border-[#c8912f]/70 hover:shadow-[0_15px_40px_rgba(200,145,47,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#c8912f]/70 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#a46b25]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#c8912f]/50">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#d8dbe0]/12 blur-[60px] transition-all duration-500 group-hover:bg-[#d8dbe0]/22">
    </div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#f5d98a] via-[#c8912f] to-[#d8dbe0] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#f5d98a] via-[#c8912f] to-[#6d4412] shadow-[0_0_10px_rgba(200,145,47,0.55)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
