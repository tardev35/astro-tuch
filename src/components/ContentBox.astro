---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// หวยเต็ง (รอบเขียวป่า-ทอง 2026-10-01): เว็บแทงหวยออนไลน์ พาเลตต์มาจากโลโก้ที่
// คำว่า "หวย" เป็นเขียวมรกตเงาวาวขอบทอง ส่วน "เต็ง" เป็นทองตัน และแบนเนอร์ฉากคืน
// สีเขียวป่ามีริ้วแสงทอง เหรียญทอง ลูกหวยทอง-ขาว และเงาวัดสีทอง — การ์ดเขียวเข้ม
// #062a12 ในกรอบทองแบรนด์ #e5c04f ออร่ามุมซ้ายบนเป็นทอง มุมขวาล่างเป็นเขียวแบรนด์
// #026314 หัวข้อไล่เฉดขาวอมเขียว #eafbe9 → ทอง #e5c04f → เขียวแบรนด์ #026314
// เนื้อความ #d8ead9 (BRAND_TEXT) — ชุดน้ำเงินรอยัล-ทองของ BRAVO168 รอบก่อน
// (#04142f #1558c4 #f4cb69 #ffe39a #e8f1ff #dbe5f5) ออกครบแล้ว
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#e5c04f]/45 bg-[#062a12]/94 p-8 text-left text-base leading-relaxed text-[#d8ead9] shadow-[0_10px_30px_rgba(1,10,4,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#fae474]/70 hover:shadow-[0_15px_40px_rgba(229,192,79,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#e5c04f]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#e5c04f]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#fae474]/38"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#026314]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#0bb42f]/32"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#eafbe9] via-[#e5c04f] to-[#026314] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#eafbe9] via-[#e5c04f] to-[#026314] shadow-[0_0_10px_rgba(229,192,79,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
