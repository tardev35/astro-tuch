---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// HENG35 (รอบดำ-ทอง 2026-09-21): การ์ดดำ #12100b ในกรอบทองบรอนซ์ #a3732c
// ออร่าสองมุมเป็นทองหลัก #ecc55c กับทองสว่าง #fefac4 หัวข้อไล่จากทองสว่าง
// #fefac4 → ทองหลัก #ecc55c → ทองอ่อน #ffdf8a ซึ่งเป็นไล่เฉดเดียวกับตัวเลข 35
// บนโลโก้ ส่วนเนื้อความใช้ #ece1cb (BRAND_TEXT) ให้อ่านง่ายบนพื้นดำ —
// โทนม่วง-ทองของรอบก่อนหายไปทั้งหมด
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#a3732c]/55 bg-[#12100b]/94 p-8 text-left text-base leading-relaxed text-[#ece1cb] shadow-[0_10px_30px_rgba(7,6,5,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#ecc55c]/70 hover:shadow-[0_15px_40px_rgba(236,197,92,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#ecc55c]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#ecc55c]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#ecc55c]/34"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#fefac4]/24 blur-[60px] transition-all duration-500 group-hover:bg-[#fefac4]/36"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#fefac4] via-[#ecc55c] to-[#ffdf8a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#fefac4] to-[#5e4418] shadow-[0_0_10px_rgba(236,197,92,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
