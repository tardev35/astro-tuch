---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// Always-live component: terms.astro, privacy.astro, 404.astro and every button
// page render their body through this file and never follow the per-brand
// ContentBox rotation, so it must carry the CURRENT brand's colours even when
// index.astro picks another variant. Nothing inside those pages names a colour
// — they inherit from the card below, which is what keeps them readable.
//
// Flattened single-slot variant: `isolate` on the card, `-z-10` on the three
// aura layers, slot renders as a direct child. Do not re-add a wrapper.
//
// 365LOTTO (รอบแดง-ทอง 2026-09-24): การ์ดแดงเกือบดำ #1a0709 ในกรอบทองหลัก
// #fadc64 ออร่าสองมุมเป็นทอง #fadc64 กับแดงสด #e01f26 หัวข้อไล่จากทองสว่าง
// #fdf3b4 → ขาวโครเมียม #f3f6fa → แดงสด #e01f26 ตามลำดับสีในโลโก้ที่เลข 365
// เป็นทอง แล้ว LOTTO เป็นขาวโครเมียมที่มีวง O สีแดง เนื้อความ #f0ddc4
// (BRAND_TEXT) — ทอง #e8b93f, ครีม #e3d8c0 และพื้น #171006/#0d0903 ของ
// SAGAME66 รอบก่อนถูกแทนครบทุกจุดแล้ว
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#fadc64]/45 bg-[#1a0709]/94 p-8 text-left text-base leading-relaxed text-[#f0ddc4] shadow-[0_10px_30px_rgba(18,4,6,0.8)] backdrop-blur-xl transition-all duration-500 hover:border-[#fdf3b4]/70 hover:shadow-[0_15px_40px_rgba(250,220,100,0.38)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#fadc64]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#fadc64]/28 blur-[60px] transition-all duration-500 group-hover:bg-[#fdf3b4]/40"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#e01f26]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#e01f26]/34"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#fdf3b4] via-[#f3f6fa] to-[#e01f26] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#fdf3b4] via-[#fadc64] to-[#e01f26] shadow-[0_0_10px_rgba(250,220,100,0.6)]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
