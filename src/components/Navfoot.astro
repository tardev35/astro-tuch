---
// 888PARUAY (รอบทอง-เขียว-แดง 2026-09-24): แถบ CTA ล่างจอมือถือ พื้นเขียวเข้ม
// เกือบดำ #07130a เส้นขอบบนทองหลัก #fcdc2b ปุ่มสมัครเป็นไล่เฉดทอง #fff6ae →
// #a87d0c ตัวหนังสือบนปุ่มเป็นสีพื้น #07130a เพื่อให้อ่านได้บนทอง ส่วนปุ่ม
// เข้าสู่ระบบเป็นการ์ด #0d2312 ขอบเขียวสด #1fae1c ตัวอักษร #e8e4c6 — ทอง
// #fadc64, ครีม #f0ddc4 และพื้นแดง #120406/#1a0709 ของ 365LOTTO ไม่เหลือแล้ว
//
// เป็น chrome ล้วน จึงไม่มี heading tag และทุก href ต้องชี้ไป route ที่มีจริง
// (/register กับ /login ซึ่งเปิดเป็นหน้าปุ่มจริงรอบนี้)
---

<div class="fixed right-0 bottom-0 left-0 z-[100] border-t border-[#fcdc2b]/60 bg-[#07130a]/95 font-sans shadow-[0_-5px_25px_rgba(252,220,43,0.35)] backdrop-blur-md lg:hidden">
  <div class="flex w-full gap-1.5 p-1.5">
    <a
      href="/register"
      style="background-image: linear-gradient(in oklab to bottom, #fff6ae, #a87d0c);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg py-3.5 text-base font-black text-[#07130a] shadow-[0_0_12px_rgba(252,220,43,0.5)] transition-transform active:scale-95">
      <span aria-hidden="true">📝</span> สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg border border-[#1fae1c]/60 bg-[#0d2312] py-3.5 text-base font-bold text-[#e8e4c6] shadow-[0_2px_8px_rgba(7,19,10,0.45)] transition-transform hover:bg-[#143a1c] active:scale-95">
      <span aria-hidden="true">🔑</span> เข้าสู่ระบบ
    </a>
  </div>
</div>
<style is:global>
  @media (max-width: 1023px) {
    body {
      padding-bottom: calc(75px + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
