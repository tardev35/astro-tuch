---
// ABM96 (รอบชมพู-เหลือง 2026-09-22): แถบ CTA ล่างจอมือถือ พื้นชมพูเกือบดำ
// #12030a เส้นขอบบนชมพูหลัก #fd6494 ปุ่มสมัครเป็นไล่เฉดชมพู #ffc9dc → #fd6494
// ตัวหนังสือชมพูเกือบดำ #12030a ส่วนปุ่มเข้าสู่ระบบเป็นการ์ดชมพูเข้ม #2a0a1a
// ขอบ #b8325f — ไม่มีโทนทองบรอนซ์กับเขียวมรกตของรอบก่อนหลงเหลือ
//
// เป็น chrome ล้วน จึงไม่มี heading tag และทุก href ต้องชี้ไป route ที่มีจริง
// (/register กับ /login ซึ่งเปิดเป็นหน้าปุ่มจริงรอบนี้)
---

<div class="fixed right-0 bottom-0 left-0 z-[100] border-t border-[#fd6494]/50 bg-[#12030a]/95 font-sans shadow-[0_-5px_25px_rgba(253,100,148,0.25)] backdrop-blur-md lg:hidden">
  <div class="flex w-full gap-1.5 p-1.5">
    <a
      href="/register"
      style="background-image: linear-gradient(in oklab to bottom, #ffc9dc, #fd6494);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg py-3.5 text-base font-black text-[#12030a] shadow-[0_0_12px_rgba(253,100,148,0.5)] transition-transform active:scale-95">
      <span aria-hidden="true">📝</span> สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg border border-[#b8325f]/70 bg-[#2a0a1a] py-3.5 text-base font-bold text-[#fbe3ee] shadow-[0_2px_8px_rgba(18,3,10,0.45)] transition-transform hover:bg-[#3d0f26] active:scale-95">
      <span aria-hidden="true">🔑</span> เข้าสู่ระบบ
    </a>
  </div>
</div>
<style is:global>
  @media (max-width: 1023px) {
    body {
      padding-bottom: calc(75px + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
