---
// DUCK1688 (รอบทองเป็ด-ส้มปากเป็ด 2026-10-10): แถบ CTA ล่างจอมือถือ
// พื้นดำอมทองเข้มสุด #0d0903 เส้นขอบบนทองเป็ด #f3bb34 ปุ่มสมัครเป็นไล่เฉดทอง
// ทองสว่าง #fde464 → ทองแบรนด์ #f3bb34 → ทองกลางเข้ม #c8901a ส่วนปุ่มเข้าสู่ระบบ
// เป็นไล่เฉดดำอมทอง #171106 → #0d0903 ในกรอบส้มอำพัน #f58b2a
//
// คู่ปุ่มรอบนี้คือ "ทองตันหมึกน้ำตาลเกือบดำ / ดำสนิทขอบส้มหมึกทอง" ซึ่งมาจากงาน
// ศิลป์ตรงๆ ที่โลโก้เป็นเป็ดการ์ตูนสีเหลืองสวมมงกุฎทอง ปากส้มอำพัน อยู่เหนือแผ่น
// ป้ายดำขอบทอง — ทองเป็นฮิวนำและส้มปากเป็ดเป็นฮิวที่สอง คนละคู่กับทองอวกาศ/
// เงินโครเมียมของ NAZA168 รอบก่อน ชุดนั้น (#fbc134 #ffe87a #cf9a18 #cfd6e3
// #432b03 #241700 #231500 rgba(251,193,52,α) rgba(207,214,227,α)) ไม่เหลือใน
// ไฟล์นี้ ⚠️ ทั้งสองรอบมีทองเหมือนกัน จึงต้องเทียบเป็นค่าไม่ใช่ตระกูลสี —
// #f3bb34 ไม่ใช่ #fbc134 และรอบนี้ไม่มีเงินโครเมียมเลย
//
// สองปุ่มใช้หมึกคนละสี ไม่ใช่ยกคลาสข้ามปุ่ม — ตรวจค่าใหม่แล้วทั้งห้าคู่:
// หมึกน้ำตาลเกือบดำ #1a1203 บนทองสว่าง #fde464 ≈ 14.4:1 · บนทองแบรนด์ #f3bb34
// ≈ 10.4:1 · บนทองกลางเข้ม #c8901a ≈ 6.4:1 ส่วนหมึกทอง #f3bb34 บนดำอมทอง
// #171106 ≈ 10.8:1 · บนดำลึกสุด #0d0903 ≈ 11.9:1 ทั้งหมดผ่าน AA สำหรับ
// ข้อความปกติที่ text-base กลับกันไม่ได้: พื้นทองสว่างแล้วใส่หมึกสว่างจะเหลือ
// ~1.2:1 ซึ่งตก AA หนัก พื้นสว่างจึงคู่หมึกเข้มเสมอ และพื้นเข้มคู่หมึกทองเสมอ
// ⚠️ ปลายเข้มของไล่เฉดทองเป็น #c8901a ไม่ใช่ #8a5f08 ของ brand-spec — #8a5f08
// เป็นสีเส้น/ออราเท่านั้น ถ้าเอามารองหมึก #1a1203 จะได้ ~3.4:1 ซึ่งตก AA
//
// เป็น chrome ล้วน จึงไม่มี heading tag
//
// สองปุ่มนี้ชี้ตรงไปที่ลิงก์ aff เลย ไม่ผ่าน /register, /login อีกต่อหนึ่ง — แถบนี้
// ขึ้นทุกหน้าเฉพาะจอมือถือ (lg:hidden) จึงเป็นจุดที่คำว่า "โหมดมือถือ" ของคำสั่งหมายถึง
// ตรงๆ ที่สุด การตัดตัวกลางออกลดคลิกจากกดปุ่ม -> หน้า /register (หรือ /login) ->
// กดปุ่มอีกที -> ลิงก์ aff เหลือแค่กดปุ่มครั้งเดียว ตัวแปร targetUrl เป็นลิงก์
// เดียวกับที่ /register กับ /login ใช้อยู่แล้ว — ห้ามแก้ค่านี้ตรงนี้เอง อัปโหลดเดอร์
// จะอัปเดตให้พร้อมกับอีกสองไฟล์
const targetUrl = "https://yoalink.com/l360";
---

<div class="fixed right-0 bottom-0 left-0 z-[100] border-t border-[#f3bb34]/70 bg-[#0d0903]/95 font-sans shadow-[0_-5px_25px_rgba(243,187,52,0.45)] backdrop-blur-md lg:hidden">
  <div class="flex w-full gap-1.5 p-1.5">
    <a
      href={targetUrl}
      rel="nofollow sponsored"
      style="background-image: linear-gradient(in oklab to bottom, #fde464, #f3bb34 55%, #c8901a);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg py-3.5 text-base font-black text-[#1a1203] shadow-[0_0_12px_rgba(243,187,52,0.6)] transition-transform active:scale-95">
      <span aria-hidden="true">📝</span> สมัครสมาชิก
    </a>

    <a
      href={targetUrl}
      rel="nofollow sponsored"
      style="background-image: linear-gradient(in oklab to bottom, #171106, #0d0903);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg border border-[#f58b2a]/70 py-3.5 text-base font-black text-[#f3bb34] shadow-[0_0_12px_rgba(245,139,42,0.4)] transition-transform active:scale-95">
      <span aria-hidden="true">🔑</span> เข้าสู่ระบบ
    </a>
  </div>
</div>
<style is:global>
  @media (max-width: 1023px) {
    body {
      padding-bottom: calc(75px + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
