---
// SAGAME66 (รอบทอง-เงินโครเมียม 2026-09-23): แถบ CTA ล่างจอมือถือ พื้นน้ำตาล
// เกือบดำ #0d0903 เส้นขอบบนทองหลัก #e8b93f ปุ่มสมัครเป็นไล่เฉดทอง #ffe9a3 →
// #96671a ตัวหนังสือบนปุ่มเป็นสีพื้น #0d0903 เพื่อให้อ่านได้บนทอง ส่วนปุ่ม
// เข้าสู่ระบบเป็นการ์ด #171006 ขอบเงินโครเมียม #eef3f8 ตัวอักษร #e3d8c0
// — แดง #c50d12/#ef1f25 และพื้น #0a0708/#16100f ของ UFAGOOL รอบก่อนไม่เหลือแล้ว
//
// เป็น chrome ล้วน จึงไม่มี heading tag และทุก href ต้องชี้ไป route ที่มีจริง
// (/register กับ /login ซึ่งเปิดเป็นหน้าปุ่มจริงรอบนี้)
---

<div class="fixed right-0 bottom-0 left-0 z-[100] border-t border-[#e8b93f]/60 bg-[#0d0903]/95 font-sans shadow-[0_-5px_25px_rgba(232,185,63,0.35)] backdrop-blur-md lg:hidden">
  <div class="flex w-full gap-1.5 p-1.5">
    <a
      href="/register"
      style="background-image: linear-gradient(in oklab to bottom, #ffe9a3, #96671a);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg py-3.5 text-base font-black text-[#0d0903] shadow-[0_0_12px_rgba(232,185,63,0.5)] transition-transform active:scale-95">
      <span aria-hidden="true">📝</span> สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg border border-[#eef3f8]/45 bg-[#171006] py-3.5 text-base font-bold text-[#e3d8c0] shadow-[0_2px_8px_rgba(13,9,3,0.45)] transition-transform hover:bg-[#2a1d0b] active:scale-95">
      <span aria-hidden="true">🔑</span> เข้าสู่ระบบ
    </a>
  </div>
</div>
<style is:global>
  @media (max-width: 1023px) {
    body {
      padding-bottom: calc(75px + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
