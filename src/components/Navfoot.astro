---
// แตกดี168 (รอบฟ้าสด-เหลืองมะนาวบนกรมท่าเกือบดำ 2026-10-08): แถบ CTA ล่างจอมือถือ
// พื้นกรมท่าเกือบดำ #020609 เส้นขอบบนฟ้าแบรนด์ #0193fb ปุ่มสมัครเป็นไล่เฉด
// เหลืองอ่อน #fff48a → เหลืองมะนาว #fce604 → เหลืองเข้ม #c9a703 ส่วนปุ่มเข้าสู่ระบบ
// เป็นไล่เฉดฟ้าเข้ม #064a86 → ผิวยก #0a1726 ในกรอบฟ้าแบรนด์ #0193fb
//
// คู่ปุ่มรอบนี้คือ "เหลืองตันหมึกกรมท่า / ฟ้าเข้มขอบฟ้าหมึกฟ้าอ่อน" ซึ่งมาจากงาน
// ศิลป์ตรงๆ ที่โลโก้เป็นคำว่า แตกดี สีเหลืองมะนาววางเหนือเลข 168 สีฟ้าสด — เป็น
// สองฮิวจริง ไม่ใช่ปลายเข้ม/สว่างของโลหะเดียวแบบ 789BETTING รอบก่อน ชุดทอง
// เมทัลลิกของรอบนั้น (#fad354 #ffe79a #ddab33 #3a2c0b #17130a #060402 #0a0802
// rgba(250,211,84,α) rgba(201,136,31,α)) ไม่เหลือในไฟล์นี้
//
// สองปุ่มใช้หมึกคนละสี ไม่ใช่ยกคลาสข้ามปุ่ม — ตรวจค่าใหม่แล้วทั้งสี่คู่:
// หมึกกรมท่าเข้ม #031018 บนเหลืองอ่อน #fff48a ≈ 17.0:1 · บนเหลืองมะนาว #fce604
// ≈ 15.0:1 · บนเหลืองเข้ม #c9a703 ≈ 8.7:1 ส่วนหมึกฟ้าอ่อน #7bcffb บนฟ้าเข้ม
// #064a86 ≈ 6.0:1 · บนผิวยก #0a1726 ≈ 10.5:1 ทั้งหมดผ่าน AA สำหรับข้อความปกติ
// ที่ text-base กลับกันไม่ได้: พื้นเหลืองสว่างแล้วใส่หมึกสว่างจะเหลือ ~1.1:1 ซึ่ง
// ตก AA หนัก พื้นสว่างจึงคู่หมึกเข้มเสมอ และพื้นเข้มคู่หมึกฟ้า/เหลืองเสมอ
//
// เป็น chrome ล้วน จึงไม่มี heading tag
//
// สองปุ่มนี้ชี้ตรงไปที่ลิงก์ aff เลย ไม่ผ่าน /register, /login อีกต่อหนึ่ง — แถบนี้
// ขึ้นทุกหน้าเฉพาะจอมือถือ (lg:hidden) จึงเป็นจุดที่คำว่า "โหมดมือถือ" ของคำสั่งหมายถึง
// ตรงๆ ที่สุด การตัดตัวกลางออกลดคลิกจากกดปุ่ม -> หน้า /register (หรือ /login) ->
// กดปุ่มอีกที -> ลิงก์ aff เหลือแค่กดปุ่มครั้งเดียว ตัวแปร targetUrl เป็นลิงก์
// เดียวกับที่ /register กับ /login ใช้อยู่แล้ว — ห้ามแก้ค่านี้ตรงนี้เอง อัปโหลดเดอร์
// จะอัปเดตให้พร้อมกับอีกสองไฟล์
const targetUrl = "https://yoalink.com/l360";
---

<div class="fixed right-0 bottom-0 left-0 z-[100] border-t border-[#0193fb]/70 bg-[#020609]/95 font-sans shadow-[0_-5px_25px_rgba(1,147,251,0.45)] backdrop-blur-md lg:hidden">
  <div class="flex w-full gap-1.5 p-1.5">
    <a
      href={targetUrl}
      rel="nofollow sponsored"
      style="background-image: linear-gradient(in oklab to bottom, #fff48a, #fce604 55%, #c9a703);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg py-3.5 text-base font-black text-[#031018] shadow-[0_0_12px_rgba(252,230,4,0.6)] transition-transform active:scale-95">
      <span aria-hidden="true">📝</span> สมัครสมาชิก
    </a>

    <a
      href={targetUrl}
      rel="nofollow sponsored"
      style="background-image: linear-gradient(in oklab to bottom, #064a86, #0a1726);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg border border-[#0193fb]/70 py-3.5 text-base font-black text-[#7bcffb] shadow-[0_0_12px_rgba(1,147,251,0.4)] transition-transform active:scale-95">
      <span aria-hidden="true">🔑</span> เข้าสู่ระบบ
    </a>
  </div>
</div>
<style is:global>
  @media (max-width: 1023px) {
    body {
      padding-bottom: calc(75px + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
