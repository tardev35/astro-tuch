---
// NAZA168 (รอบทองอวกาศ-เงินโครเมียม 2026-10-10): แถบ CTA ล่างจอมือถือ
// พื้นน้ำตาลไหม้เข้มสุด #241700 เส้นขอบบนทองอวกาศ #fbc134 ปุ่มสมัครเป็นไล่เฉดทอง
// ทองสว่าง #ffe87a → ทองแบรนด์ #fbc134 → ทองกลางเข้ม #cf9a18 ส่วนปุ่มเข้าสู่ระบบ
// เป็นไล่เฉดน้ำตาลไหม้ #432b03 → #241700 ในกรอบเงินโครเมียม #cfd6e3
//
// คู่ปุ่มรอบนี้คือ "ทองตันหมึกน้ำตาลเกือบดำ / น้ำตาลเข้มขอบเงินหมึกทอง" ซึ่งมาจาก
// งานศิลป์ตรงๆ ที่โลโก้เป็นเหรียญกลมขอบทองพื้นดำ มีหมวกนักบินอวกาศโครเมียม-ทอง
// อยู่กลาง คำว่า NAZA เป็นทองสามมิติและเลข 168 เป็นเงินโครเมียม — เป็นสองฮิวจริง
// คนละคู่กับทองสายฟ้า/แดงเลือดนกของ FLASH877 รอบก่อน ชุดนั้น (#f5c518 #ffdd73
// #b8860f #ff3b14 #8c0f0a #430000 #2b0000 #2a0300 rgba(245,197,24,α)
// rgba(255,59,20,α)) ไม่เหลือในไฟล์นี้ ⚠️ ทั้งสองรอบมีทองเหมือนกัน จึงต้องเทียบ
// เป็นค่าไม่ใช่ตระกูลสี — #fbc134 ไม่ใช่ #f5c518 และรอบนี้ไม่มีแดงเลย
//
// สองปุ่มใช้หมึกคนละสี ไม่ใช่ยกคลาสข้ามปุ่ม — ตรวจค่าใหม่แล้วทั้งห้าคู่:
// หมึกน้ำตาลเกือบดำ #231500 บนทองสว่าง #ffe87a ≈ 14.5:1 · บนทองแบรนด์ #fbc134
// ≈ 10.8:1 · บนทองกลางเข้ม #cf9a18 ≈ 7.0:1 ส่วนหมึกทอง #fbc134 บนน้ำตาลกลาง
// #432b03 ≈ 8.1:1 · บนน้ำตาลลึกสุด #241700 ≈ 10.7:1 ทั้งหมดผ่าน AA สำหรับ
// ข้อความปกติที่ text-base กลับกันไม่ได้: พื้นทองสว่างแล้วใส่หมึกสว่างจะเหลือ
// ~1.2:1 ซึ่งตก AA หนัก พื้นสว่างจึงคู่หมึกเข้มเสมอ และพื้นเข้มคู่หมึกทองเสมอ
// ⚠️ ปลายเข้มของไล่เฉดทองเป็น #cf9a18 ไม่ใช่ #96690a ของ brand-spec — #96690a
// เป็นสีเส้น/ออราเท่านั้น ถ้าเอามารองหมึก #231500 จะได้ ~3.7:1 ซึ่งตก AA
//
// เป็น chrome ล้วน จึงไม่มี heading tag
//
// สองปุ่มนี้ชี้ตรงไปที่ลิงก์ aff เลย ไม่ผ่าน /register, /login อีกต่อหนึ่ง — แถบนี้
// ขึ้นทุกหน้าเฉพาะจอมือถือ (lg:hidden) จึงเป็นจุดที่คำว่า "โหมดมือถือ" ของคำสั่งหมายถึง
// ตรงๆ ที่สุด การตัดตัวกลางออกลดคลิกจากกดปุ่ม -> หน้า /register (หรือ /login) ->
// กดปุ่มอีกที -> ลิงก์ aff เหลือแค่กดปุ่มครั้งเดียว ตัวแปร targetUrl เป็นลิงก์
// เดียวกับที่ /register กับ /login ใช้อยู่แล้ว — ห้ามแก้ค่านี้ตรงนี้เอง อัปโหลดเดอร์
// จะอัปเดตให้พร้อมกับอีกสองไฟล์
const targetUrl = "https://yoalink.com/l360";
---

<div class="fixed right-0 bottom-0 left-0 z-[100] border-t border-[#fbc134]/70 bg-[#241700]/95 font-sans shadow-[0_-5px_25px_rgba(251,193,52,0.45)] backdrop-blur-md lg:hidden">
  <div class="flex w-full gap-1.5 p-1.5">
    <a
      href={targetUrl}
      rel="nofollow sponsored"
      style="background-image: linear-gradient(in oklab to bottom, #ffe87a, #fbc134 55%, #cf9a18);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg py-3.5 text-base font-black text-[#231500] shadow-[0_0_12px_rgba(251,193,52,0.6)] transition-transform active:scale-95">
      <span aria-hidden="true">📝</span> สมัครสมาชิก
    </a>

    <a
      href={targetUrl}
      rel="nofollow sponsored"
      style="background-image: linear-gradient(in oklab to bottom, #432b03, #241700);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg border border-[#cfd6e3]/70 py-3.5 text-base font-black text-[#fbc134] shadow-[0_0_12px_rgba(207,214,227,0.4)] transition-transform active:scale-95">
      <span aria-hidden="true">🔑</span> เข้าสู่ระบบ
    </a>
  </div>
</div>
<style is:global>
  @media (max-width: 1023px) {
    body {
      padding-bottom: calc(75px + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
