---
// THE88 (รอบแดง-ทอง 2026-09-23): แถบ CTA ล่างจอมือถือ พื้นแดงเกือบดำ #1c0504
// เส้นขอบบนทอง #f2c14e ปุ่มสมัครเป็นไล่เฉดทอง #ffe7a6 → #f2c14e ตัวหนังสือแดง
// เกือบดำ #1c0504 ส่วนปุ่มเข้าสู่ระบบเป็นการ์ดแดง #2d0908 ขอบแดงแบรนด์ #a40201
// — ไม่มีชมพูมาเจนตากับพลัมของ WY88 รอบก่อนหลงเหลือ
//
// เป็น chrome ล้วน จึงไม่มี heading tag และทุก href ต้องชี้ไป route ที่มีจริง
// (/register กับ /login ซึ่งเปิดเป็นหน้าปุ่มจริงรอบนี้)
---

<div class="fixed right-0 bottom-0 left-0 z-[100] border-t border-[#f2c14e]/50 bg-[#1c0504]/95 font-sans shadow-[0_-5px_25px_rgba(164,2,1,0.35)] backdrop-blur-md lg:hidden">
  <div class="flex w-full gap-1.5 p-1.5">
    <a
      href="/register"
      style="background-image: linear-gradient(in oklab to bottom, #ffe7a6, #f2c14e);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg py-3.5 text-base font-black text-[#1c0504] shadow-[0_0_12px_rgba(242,193,78,0.5)] transition-transform active:scale-95">
      <span aria-hidden="true">📝</span> สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg border border-[#a40201]/80 bg-[#2d0908] py-3.5 text-base font-bold text-[#f7e3dd] shadow-[0_2px_8px_rgba(28,5,4,0.45)] transition-transform hover:bg-[#4a0d0b] active:scale-95">
      <span aria-hidden="true">🔑</span> เข้าสู่ระบบ
    </a>
  </div>
</div>
<style is:global>
  @media (max-width: 1023px) {
    body {
      padding-bottom: calc(75px + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
