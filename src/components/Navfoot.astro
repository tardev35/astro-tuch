---
// 365LOTTO (รอบแดง-ทอง 2026-09-24): แถบ CTA ล่างจอมือถือ พื้นแดงเกือบดำ
// #120406 เส้นขอบบนทองหลัก #fadc64 ปุ่มสมัครเป็นไล่เฉดทอง #fdf3b4 → #9c6a12
// ตัวหนังสือบนปุ่มเป็นสีพื้น #120406 เพื่อให้อ่านได้บนทอง ส่วนปุ่มเข้าสู่ระบบ
// เป็นการ์ด #1a0709 ขอบแดงสด #e01f26 ตัวอักษร #f0ddc4 — ทอง #e8b93f, ครีม
// #e3d8c0 และพื้น #0d0903/#171006 ของ SAGAME66 รอบก่อนไม่เหลือแล้ว
//
// เป็น chrome ล้วน จึงไม่มี heading tag และทุก href ต้องชี้ไป route ที่มีจริง
// (/register กับ /login ซึ่งเปิดเป็นหน้าปุ่มจริงรอบนี้)
---

<div class="fixed right-0 bottom-0 left-0 z-[100] border-t border-[#fadc64]/60 bg-[#120406]/95 font-sans shadow-[0_-5px_25px_rgba(250,220,100,0.35)] backdrop-blur-md lg:hidden">
  <div class="flex w-full gap-1.5 p-1.5">
    <a
      href="/register"
      style="background-image: linear-gradient(in oklab to bottom, #fdf3b4, #9c6a12);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg py-3.5 text-base font-black text-[#120406] shadow-[0_0_12px_rgba(250,220,100,0.5)] transition-transform active:scale-95">
      <span aria-hidden="true">📝</span> สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg border border-[#e01f26]/55 bg-[#1a0709] py-3.5 text-base font-bold text-[#f0ddc4] shadow-[0_2px_8px_rgba(18,4,6,0.45)] transition-transform hover:bg-[#2a0b0e] active:scale-95">
      <span aria-hidden="true">🔑</span> เข้าสู่ระบบ
    </a>
  </div>
</div>
<style is:global>
  @media (max-width: 1023px) {
    body {
      padding-bottom: calc(75px + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
