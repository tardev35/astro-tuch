---
// 789BETTING (รอบทองเมทัลลิกบนดำสนิท 2026-10-08): แถบ CTA ล่างจอมือถือ
// พื้นดำสนิท #060402 เส้นขอบบนทองแบรนด์ #fad354 ปุ่มสมัครเป็นไล่เฉดทองแชมเปญ
// #ffe79a → ทองแบรนด์ #fad354 → ทองกลาง #ddab33 ส่วนปุ่มเข้าสู่ระบบเป็นไล่เฉด
// บรอนซ์เข้ม #3a2c0b → ผิวยก #17130a ในกรอบทองแบรนด์ #fad354
//
// คู่ปุ่มรอบนี้คือ "ทองตันหมึกดำ / บรอนซ์เข้มขอบทองหมึกแชมเปญ" ซึ่งมาจากงานศิลป์
// ตรงๆ ที่โลโก้เป็นเลข 789 ทองขัดเงาล้วนทับคำว่า BETTING สีดำ ไม่มีโลหะที่สอง
// สีที่สองของคู่ปุ่มจึงเป็นปลายเข้มของทองเดียวกัน ไม่ใช่ฮิวใหม่ — ชุดตรุษจีนของ
// GUCCI168 (#c41115 #e0201f #7a0505 #0b7a33 #063f1c #2bbf63 #d9a521 #090302
// #f6e3cf rgba(196,17,21,α) rgba(217,165,33,α)) ไม่เหลือในไฟล์นี้
//
// สองปุ่มใช้หมึกคนละสี ไม่ใช่ยกคลาสข้ามปุ่ม — ตรวจค่าใหม่แล้วทั้งสี่คู่:
// หมึกดำอมทอง #0a0802 บนทองแชมเปญ #ffe79a ≈ 16.3:1 · บนทองแบรนด์ #fad354 ≈ 13.5:1
// · บนทองกลาง #ddab33 ≈ 9.4:1 ส่วนหมึกแชมเปญ #ffe79a บนบรอนซ์เข้ม #3a2c0b ≈ 11.1:1
// · บนผิวยก #17130a ≈ 15.8:1 ทั้งหมดผ่าน AA สำหรับข้อความปกติที่ text-base
// กลับกันไม่ได้: ทองสว่างเป็นพื้นแล้วใส่หมึกสว่างจะเหลือ ~1.2:1 ซึ่งตก AA หนัก
// พื้นทองจึงคู่หมึกดำเสมอ และพื้นเข้มคู่หมึกทองเสมอ
//
// เป็น chrome ล้วน จึงไม่มี heading tag
//
// สองปุ่มนี้ชี้ตรงไปที่ลิงก์ aff เลย ไม่ผ่าน /register, /login อีกต่อหนึ่ง — แถบนี้
// ขึ้นทุกหน้าเฉพาะจอมือถือ (lg:hidden) จึงเป็นจุดที่คำว่า "โหมดมือถือ" ของคำสั่งหมายถึง
// ตรงๆ ที่สุด การตัดตัวกลางออกลดคลิกจากกดปุ่ม -> หน้า /register (หรือ /login) ->
// กดปุ่มอีกที -> ลิงก์ aff เหลือแค่กดปุ่มครั้งเดียว ตัวแปร targetUrl เป็นลิงก์
// เดียวกับที่ /register กับ /login ใช้อยู่แล้ว (ดูคอมเมนต์ "never edit targetUrl"
// ในสองไฟล์นั้น) — ห้ามแก้ค่านี้ตรงนี้เอง อัปโหลดเดอร์จะอัปเดตให้พร้อมกับอีกสองไฟล์
// /register และ /login ยังเป็นหน้าจริงที่ index ได้ตามเดิม ไม่ได้ถูกถอดออกจากเว็บ —
// แค่ปุ่มลัดจอมือถือพวกนี้ไม่ต้องพาไปอ้อมผ่านหน้านั้นก่อน
const targetUrl = "https://yoalink.com/l360";
---

<div class="fixed right-0 bottom-0 left-0 z-[100] border-t border-[#fad354]/70 bg-[#060402]/95 font-sans shadow-[0_-5px_25px_rgba(250,211,84,0.45)] backdrop-blur-md lg:hidden">
  <div class="flex w-full gap-1.5 p-1.5">
    <a
      href={targetUrl}
      rel="nofollow sponsored"
      style="background-image: linear-gradient(in oklab to bottom, #ffe79a, #fad354 55%, #ddab33);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg py-3.5 text-base font-black text-[#0a0802] shadow-[0_0_12px_rgba(250,211,84,0.65)] transition-transform active:scale-95">
      <span aria-hidden="true">📝</span> สมัครสมาชิก
    </a>

    <a
      href={targetUrl}
      rel="nofollow sponsored"
      style="background-image: linear-gradient(in oklab to bottom, #3a2c0b, #17130a);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg border border-[#fad354]/70 py-3.5 text-base font-black text-[#ffe79a] shadow-[0_0_12px_rgba(201,136,31,0.35)] transition-transform active:scale-95">
      <span aria-hidden="true">🔑</span> เข้าสู่ระบบ
    </a>
  </div>
</div>
<style is:global>
  @media (max-width: 1023px) {
    body {
      padding-bottom: calc(75px + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
