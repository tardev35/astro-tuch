---
// FAH999 (รอบม่วง-ทอง 2026-09-21): แถบ CTA ล่างจอมือถือ พื้นม่วงดำ #0d0119
// เส้นขอบบนทอง #fbbf13 ปุ่มสมัครเป็นไล่เฉดทอง #fef354 → #fbbf13 ตัวหนังสือ
// ม่วงเข้ม #1f0639 ส่วนปุ่มเข้าสู่ระบบเป็นการ์ดม่วง #2a0a4d ขอบม่วงกลาง
// #7c2fd4 — ไม่มีสีดำ+ทองของรอบก่อนหลงเหลือ
//
// เป็น chrome ล้วน จึงไม่มี heading tag และทุก href ต้องชี้ไป route ที่มีจริง
// (/register กับ /login ซึ่งเปิดเป็นหน้าปุ่มจริงรอบนี้) ห้ามลิงก์ไป
// /ตรวจหวย หรือ /แนวทาง เพราะถูกพักไว้ที่ src/pages-disabled/
---

<div class="fixed right-0 bottom-0 left-0 z-[100] border-t border-[#fbbf13]/50 bg-[#0d0119]/95 font-sans shadow-[0_-5px_25px_rgba(251,191,19,0.25)] backdrop-blur-md lg:hidden">
  <div class="flex w-full gap-1.5 p-1.5">
    <a
      href="/register"
      style="background-image: linear-gradient(in oklab to bottom, #fef354, #fbbf13);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg py-3.5 text-base font-black text-[#1f0639] shadow-[0_0_12px_rgba(251,191,19,0.5)] transition-transform active:scale-95">
      <span aria-hidden="true">📝</span> สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg border border-[#7c2fd4]/70 bg-[#2a0a4d] py-3.5 text-base font-bold text-[#ecdcff] shadow-[0_2px_8px_rgba(13,1,25,0.45)] transition-transform hover:bg-[#331058] active:scale-95">
      <span aria-hidden="true">🔑</span> เข้าสู่ระบบ
    </a>
  </div>
</div>
<style is:global>
  @media (max-width: 1023px) {
    body {
      padding-bottom: calc(75px + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
