---
// FAH999 (รอบชมพูบานเย็น-ทอง 2026-10-11): แถบ CTA ล่างจอมือถือ
// พื้นม่วงพลัมลึกสุด #210220 เส้นขอบบนชมพูบานเย็น #ff3fa4 ปุ่มสมัครเป็นไล่เฉดชมพู
// ชมพูอ่อน #ffd1ea → ชมพูไฮไลต์ #ff6cbb → ชมพูแบรนด์ #ff3fa4 ส่วนปุ่มเข้าสู่ระบบ
// เป็นไล่เฉดม่วงพลัม #3a0534 → #210220 ในกรอบทอง #f5c53d
//
// คู่ปุ่มรอบนี้คือ "ชมพูตันหมึกพลัมเกือบดำ / พลัมเข้มขอบทองหมึกชมพู" ซึ่งมาจากงาน
// ศิลป์ตรงๆ ที่โลโก้เป็นสาวหูกระต่ายสีชมพู เหนือตัวอักษร FAH999 ชมพูประกายบน
// แผ่นป้ายเข้มขอบทอง — ชมพูเป็นฮิวนำและทองเป็นฮิวที่สอง คนละคู่กับทองเป็ด/
// ส้มปากเป็ดของ DUCK1688 รอบก่อน ชุดนั้น (#f3bb34 #fde464 #c8901a #f58b2a
// #1a1203 #171106 #0d0903 rgba(243,187,52,α) rgba(245,139,42,α)) ไม่เหลือใน
// ไฟล์นี้ ⚠️ รอบก่อนเป็นทองนำ รอบนี้ทองเป็นแค่ขอบปุ่มที่สอง ให้เทียบเป็นค่า
// ไม่ใช่ "มีทองอยู่ = ของรอบก่อน"
//
// สองปุ่มใช้หมึกคนละสี ไม่ใช่ยกคลาสข้ามปุ่ม — ตรวจค่าใหม่แล้วทั้งห้าคู่:
// หมึกพลัมเกือบดำ #2b0019 บนชมพูอ่อน #ffd1ea ≈ 13.9:1 · บนชมพูไฮไลต์ #ff6cbb
// ≈ 7.3:1 · บนชมพูแบรนด์ #ff3fa4 ≈ 5.8:1 ส่วนหมึกชมพู #ff6cbb บนพลัมกลาง
// #3a0534 ≈ 6.5:1 · บนพลัมลึกสุด #210220 ≈ 7.4:1 ทั้งหมดผ่าน AA สำหรับ
// ข้อความปกติที่ text-base กลับกันไม่ได้: พื้นชมพูสว่างแล้วใส่หมึกสว่างจะเหลือ
// ~1.3:1 ซึ่งตก AA หนัก พื้นสว่างจึงคู่หมึกเข้มเสมอ และพื้นเข้มคู่หมึกชมพูเสมอ
// ⚠️ ปลายเข้มของไล่เฉดชมพูเป็น #ff3fa4 ไม่ใช่ #b3006a ของ brand-spec — #b3006a
// เป็นสีเส้น/ออราเท่านั้น ถ้าเอามารองหมึก #2b0019 จะได้ ~2.8:1 ซึ่งตก AA หนัก
//
// เป็น chrome ล้วน จึงไม่มี heading tag
//
// สองปุ่มนี้ชี้ตรงไปที่ลิงก์ aff เลย ไม่ผ่าน /register, /login อีกต่อหนึ่ง — แถบนี้
// ขึ้นทุกหน้าเฉพาะจอมือถือ (lg:hidden) จึงเป็นจุดที่คำว่า "โหมดมือถือ" ของคำสั่งหมายถึง
// ตรงๆ ที่สุด การตัดตัวกลางออกลดคลิกจากกดปุ่ม -> หน้า /register (หรือ /login) ->
// กดปุ่มอีกที -> ลิงก์ aff เหลือแค่กดปุ่มครั้งเดียว ตัวแปร targetUrl เป็นลิงก์
// เดียวกับที่ /register กับ /login ใช้อยู่แล้ว — ห้ามแก้ค่านี้ตรงนี้เอง อัปโหลดเดอร์
// จะอัปเดตให้พร้อมกับอีกสองไฟล์
const targetUrl = "https://yoalink.com/l360";
---

<div class="fixed right-0 bottom-0 left-0 z-[100] border-t border-[#ff3fa4]/70 bg-[#210220]/95 font-sans shadow-[0_-5px_25px_rgba(255,63,164,0.45)] backdrop-blur-md lg:hidden">
  <div class="flex w-full gap-1.5 p-1.5">
    <a
      href={targetUrl}
      rel="nofollow sponsored"
      style="background-image: linear-gradient(in oklab to bottom, #ffd1ea, #ff6cbb 55%, #ff3fa4);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg py-3.5 text-base font-black text-[#2b0019] shadow-[0_0_12px_rgba(255,63,164,0.6)] transition-transform active:scale-95">
      <span aria-hidden="true">📝</span> สมัครสมาชิก
    </a>

    <a
      href={targetUrl}
      rel="nofollow sponsored"
      style="background-image: linear-gradient(in oklab to bottom, #3a0534, #210220);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg border border-[#f5c53d]/70 py-3.5 text-base font-black text-[#ff6cbb] shadow-[0_0_12px_rgba(245,197,61,0.4)] transition-transform active:scale-95">
      <span aria-hidden="true">🔑</span> เข้าสู่ระบบ
    </a>
  </div>
</div>
<style is:global>
  @media (max-width: 1023px) {
    body {
      padding-bottom: calc(75px + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
