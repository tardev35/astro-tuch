---
// KINGDOM66 (รอบทอง-ดำ 2026-09-25): แถบ CTA ล่างจอมือถือ พื้นดำอมน้ำตาล
// #151109 เส้นขอบบนทองแบรนด์ #e6bf4e ปุ่มสมัครเป็นไล่เฉดทอง #f2d683 → #5c4113
// ตัวหนังสือบนปุ่มเป็นดำ #151109 เพื่อให้อ่านได้บนพื้นทองสว่าง ส่วนปุ่มเข้าสู่ระบบ
// เป็นการ์ด #241c13 ขอบครีมอุ่น #efe6cf ตัวอักษร #ebe3d3 — ทอง #e0b429 กับเงิน
// โครเมียมเย็น #dfe4ec บนพื้น #161106/#26200e ของ UWIN33 ไม่เหลือแล้ว
//
// เป็น chrome ล้วน จึงไม่มี heading tag และทุก href ต้องชี้ไป route ที่มีจริง
// (/register กับ /login ซึ่งเปิดเป็นหน้าปุ่มจริงรอบนี้)
---

<div class="fixed right-0 bottom-0 left-0 z-[100] border-t border-[#e6bf4e]/60 bg-[#151109]/95 font-sans shadow-[0_-5px_25px_rgba(230,191,78,0.35)] backdrop-blur-md lg:hidden">
  <div class="flex w-full gap-1.5 p-1.5">
    <a
      href="/register"
      style="background-image: linear-gradient(in oklab to bottom, #f2d683, #5c4113);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg py-3.5 text-base font-black text-[#151109] shadow-[0_0_12px_rgba(230,191,78,0.55)] transition-transform active:scale-95">
      <span aria-hidden="true">📝</span> สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg border border-[#efe6cf]/50 bg-[#241c13] py-3.5 text-base font-bold text-[#ebe3d3] shadow-[0_2px_8px_rgba(5,4,3,0.5)] transition-transform hover:bg-[#3c2b15] active:scale-95">
      <span aria-hidden="true">🔑</span> เข้าสู่ระบบ
    </a>
  </div>
</div>
<style is:global>
  @media (max-width: 1023px) {
    body {
      padding-bottom: calc(75px + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
