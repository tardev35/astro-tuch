    <a
      href={targetUrl}
      rel="nofollow sponsored"
      style="background-image: linear-gradient(in oklab to bottom, #fdfc71, #d4922c);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg py-3.5 text-base font-black text-[#1a1000] shadow-[0_0_12px_rgba(212,146,44,0.6)] transition-transform active:scale-95">
      <span aria-hidden="true">📝</span> สมัครสมาชิก
    </a>

    <a
      href={targetUrl}
      rel="nofollow sponsored"
      style="background-image: linear-gradient(in oklab to bottom, #33200a, #0a0601);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg border border-[#a25b24]/80 py-3.5 text-base font-black text-[#f6e3b4] shadow-[0_0_12px_rgba(162,91,36,0.4)] transition-transform active:scale-95">
