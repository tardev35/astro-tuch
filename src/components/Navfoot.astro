---
// PIGPG (รอบแดงแล็กเกอร์-ทองแบบตรุษจีน 2026-10-09): แถบ CTA ล่างจอมือถือ
// พื้นแดงเกือบดำ #120302 เส้นขอบบนทองแบรนด์ #f5b61d ปุ่มสมัครเป็นไล่เฉดทอง
// ทองอ่อน #ffd87a → ทองแบรนด์ #f5b61d → ทองเข้ม #b07a06 ส่วนปุ่มเข้าสู่ระบบ
// เป็นไล่เฉดแดงแล็กเกอร์ #a30303 → ผิวการ์ดกลาง #2a0806 ในกรอบทองแบรนด์ #f5b61d
//
// คู่ปุ่มรอบนี้คือ "ทองตันหมึกแดงเข้ม / แดงเข้มขอบทองหมึกทอง" ซึ่งมาจากงานศิลป์
// ตรงๆ ที่โลโก้เป็นป้ายแล็กเกอร์แดงขอบทอง มีหัวหมูสวมหมวกจีนแดงติดเหรียญทอง
// — เป็นสองฮิวจริง คนละคู่กับมรกต/ทองของ KOON234 รอบก่อน ชุดนั้น
// (#0a6b32 #cc920a #f7d14e #fde9a6 #09190d #020803 #07170c rgba(204,146,10,α)
// rgba(247,209,78,α) rgba(10,107,50,α)) ไม่เหลือในไฟล์นี้
//
// สองปุ่มใช้หมึกคนละสี ไม่ใช่ยกคลาสข้ามปุ่ม — ตรวจค่าใหม่แล้วทั้งห้าคู่:
// หมึกแดงเกือบดำ #2a0806 บนทองอ่อน #ffd87a ≈ 15.0:1 · บนทองแบรนด์ #f5b61d
// ≈ 10.1:1 · บนทองเข้ม #b07a06 ≈ 5.0:1 ส่วนหมึกทองอ่อน #ffd87a บนแดงแล็กเกอร์
// #a30303 ≈ 6.0:1 · บนผิวการ์ดกลาง #2a0806 ≈ 13.7:1 ทั้งหมดผ่าน AA สำหรับ
// ข้อความปกติที่ text-base กลับกันไม่ได้: พื้นทองสว่างแล้วใส่หมึกสว่างจะเหลือ
// ~1.3:1 ซึ่งตก AA หนัก พื้นสว่างจึงคู่หมึกเข้มเสมอ และพื้นเข้มคู่หมึกทองเสมอ
//
// เป็น chrome ล้วน จึงไม่มี heading tag
//
// สองปุ่มนี้ชี้ตรงไปที่ลิงก์ aff เลย ไม่ผ่าน /register, /login อีกต่อหนึ่ง — แถบนี้
// ขึ้นทุกหน้าเฉพาะจอมือถือ (lg:hidden) จึงเป็นจุดที่คำว่า "โหมดมือถือ" ของคำสั่งหมายถึง
// ตรงๆ ที่สุด การตัดตัวกลางออกลดคลิกจากกดปุ่ม -> หน้า /register (หรือ /login) ->
// กดปุ่มอีกที -> ลิงก์ aff เหลือแค่กดปุ่มครั้งเดียว ตัวแปร targetUrl เป็นลิงก์
// เดียวกับที่ /register กับ /login ใช้อยู่แล้ว — ห้ามแก้ค่านี้ตรงนี้เอง อัปโหลดเดอร์
// จะอัปเดตให้พร้อมกับอีกสองไฟล์
const targetUrl = "https://yoalink.com/l360";
---

<div class="fixed right-0 bottom-0 left-0 z-[100] border-t border-[#f5b61d]/70 bg-[#120302]/95 font-sans shadow-[0_-5px_25px_rgba(245,182,29,0.45)] backdrop-blur-md lg:hidden">
  <div class="flex w-full gap-1.5 p-1.5">
    <a
      href={targetUrl}
      rel="nofollow sponsored"
      style="background-image: linear-gradient(in oklab to bottom, #ffd87a, #f5b61d 55%, #b07a06);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg py-3.5 text-base font-black text-[#2a0806] shadow-[0_0_12px_rgba(245,182,29,0.6)] transition-transform active:scale-95">
      <span aria-hidden="true">📝</span> สมัครสมาชิก
    </a>

    <a
      href={targetUrl}
      rel="nofollow sponsored"
      style="background-image: linear-gradient(in oklab to bottom, #a30303, #2a0806);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg border border-[#f5b61d]/70 py-3.5 text-base font-black text-[#ffd87a] shadow-[0_0_12px_rgba(163,3,3,0.5)] transition-transform active:scale-95">
      <span aria-hidden="true">🔑</span> เข้าสู่ระบบ
    </a>
  </div>
</div>
<style is:global>
  @media (max-width: 1023px) {
    body {
      padding-bottom: calc(75px + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
