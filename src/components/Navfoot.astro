---
// WEPLAY168 (รอบม่วงนีออน-ทองอาร์เขต 2026-10-09): แถบ CTA ล่างจอมือถือ
// พื้นม่วงเกือบดำ #0a0117 เส้นขอบบนม่วงแบรนด์ #a435f0 ปุ่มสมัครเป็นไล่เฉดทอง
// ทองแบรนด์ #fbe455 → ทองอุ่น #ffd23d → ทองเข้ม #c98a05 ส่วนปุ่มเข้าสู่ระบบ
// เป็นไล่เฉดม่วง #7a1fc4 → ผิวการ์ดกลาง #17062e ในกรอบม่วงแบรนด์ #a435f0
//
// คู่ปุ่มรอบนี้คือ "ทองตันหมึกม่วงเข้ม / ม่วงเข้มขอบม่วงหมึกทอง" ซึ่งมาจากงานศิลป์
// ตรงๆ ที่โลโก้เป็นเครื่องเกมพกพาสีม่วงพาดด้วยคำว่า WEPLAY สีเงินอมม่วงและ 168
// สีทอง — เป็นสองฮิวจริง คนละคู่กับแดงแล็กเกอร์/ทองของ PIGPG รอบก่อน ชุดนั้น
// (#f5b61d #ffd87a #b07a06 #a30303 #2a0806 #120302 rgba(245,182,29,α)
// rgba(163,3,3,α)) ไม่เหลือในไฟล์นี้
//
// สองปุ่มใช้หมึกคนละสี ไม่ใช่ยกคลาสข้ามปุ่ม — ตรวจค่าใหม่แล้วทั้งห้าคู่:
// หมึกม่วงเข้ม #190633 บนทองแบรนด์ #fbe455 ≈ 12.4:1 · บนทองอุ่น #ffd23d
// ≈ 11.0:1 · บนทองเข้ม #c98a05 ≈ 5.0:1 ส่วนหมึกทองแบรนด์ #fbe455 บนม่วง
// #7a1fc4 ≈ 8.2:1 · บนผิวการ์ดกลาง #17062e ≈ 13.4:1 ทั้งหมดผ่าน AA สำหรับ
// ข้อความปกติที่ text-base กลับกันไม่ได้: พื้นทองสว่างแล้วใส่หมึกสว่างจะเหลือ
// ~1.1:1 ซึ่งตก AA หนัก พื้นสว่างจึงคู่หมึกเข้มเสมอ และพื้นเข้มคู่หมึกทองเสมอ
//
// เป็น chrome ล้วน จึงไม่มี heading tag
//
// สองปุ่มนี้ชี้ตรงไปที่ลิงก์ aff เลย ไม่ผ่าน /register, /login อีกต่อหนึ่ง — แถบนี้
// ขึ้นทุกหน้าเฉพาะจอมือถือ (lg:hidden) จึงเป็นจุดที่คำว่า "โหมดมือถือ" ของคำสั่งหมายถึง
// ตรงๆ ที่สุด การตัดตัวกลางออกลดคลิกจากกดปุ่ม -> หน้า /register (หรือ /login) ->
// กดปุ่มอีกที -> ลิงก์ aff เหลือแค่กดปุ่มครั้งเดียว ตัวแปร targetUrl เป็นลิงก์
// เดียวกับที่ /register กับ /login ใช้อยู่แล้ว — ห้ามแก้ค่านี้ตรงนี้เอง อัปโหลดเดอร์
// จะอัปเดตให้พร้อมกับอีกสองไฟล์
const targetUrl = "https://yoalink.com/l360";
---

<div class="fixed right-0 bottom-0 left-0 z-[100] border-t border-[#a435f0]/70 bg-[#0a0117]/95 font-sans shadow-[0_-5px_25px_rgba(164,53,240,0.45)] backdrop-blur-md lg:hidden">
  <div class="flex w-full gap-1.5 p-1.5">
    <a
      href={targetUrl}
      rel="nofollow sponsored"
      style="background-image: linear-gradient(in oklab to bottom, #fbe455, #ffd23d 55%, #c98a05);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg py-3.5 text-base font-black text-[#190633] shadow-[0_0_12px_rgba(251,228,85,0.6)] transition-transform active:scale-95">
      <span aria-hidden="true">📝</span> สมัครสมาชิก
    </a>

    <a
      href={targetUrl}
      rel="nofollow sponsored"
      style="background-image: linear-gradient(in oklab to bottom, #7a1fc4, #17062e);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg border border-[#a435f0]/70 py-3.5 text-base font-black text-[#fbe455] shadow-[0_0_12px_rgba(164,53,240,0.5)] transition-transform active:scale-95">
      <span aria-hidden="true">🔑</span> เข้าสู่ระบบ
    </a>
  </div>
</div>
<style is:global>
  @media (max-width: 1023px) {
    body {
      padding-bottom: calc(75px + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
