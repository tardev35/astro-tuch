---
// PUNPRO168 (รอบชมพูฮอตพิงก์-ทอง 2026-10-12): แถบ CTA ล่างจอมือถือ
// พื้นพลัมจม #1c0014 (เข้มกว่าพื้นเพจ #2e0022 ของ bg.json รอบนี้ เพื่อให้แถบ
// ที่ปักอยู่ล่างจอแยกตัวออกจากเนื้อหาที่เลื่อนผ่าน) เส้นขอบบนชมพู #f41571
// ปุ่มสมัครเป็นไล่เฉดทอง ทองสว่าง #fce343 → ทองอำพัน #ffc554
// ส่วนปุ่มเข้าสู่ระบบเป็นไล่เฉดผิวมืดพลัม #3a0a2a → #1c0014 ในกรอบชมพู
//
// คู่ปุ่มรอบนี้คือ "ทองตันหมึกพลัมเกือบดำ / ผิวมืดขอบชมพูหมึกชมพูสว่าง" ซึ่งมาจาก
// งานศิลป์ตรงๆ ที่โลโก้เป็นเครื่องเกมชมพูเหนือ PUNPRO ชมพูและ 168 ทอง
// ⚠️ รอบก่อน (TIGERWIN369) เป็นทองล้วนสองระดับ ปุ่มทั้งคู่จึงเคยเป็นทอง — รอบนี้
// ปุ่มหลักเป็นทอง ปุ่มรองเป็นชมพู ให้เทียบเป็นค่า ไม่ใช่ "มีทองอยู่ = ของรอบนี้"
// ชุดเดิมของ TIGERWIN369 (#d98324 #f7b733 #ffd98a #1a0d02 #1c1206 #0f0903
// rgba(217,131,36,α)) ไม่เหลือในไฟล์นี้
//
// สองปุ่มใช้หมึกคนละสี ไม่ใช่ยกคลาสข้ามปุ่ม — ตรวจค่าใหม่แล้วทั้งสี่คู่:
// หมึกพลัมเกือบดำ #2a0012 บนทองสว่าง #fce343 ≈ 14.6:1 · บนทองอำพัน #ffc554
// ≈ 12.1:1 ส่วนหมึกชมพูสว่าง #ff5ca8 บนผิวกลาง #3a0a2a ≈ 6.0:1 · บนผิวจม
// #1c0014 ≈ 7.0:1 ทั้งหมดผ่าน AA สำหรับข้อความปกติที่ text-base
// กลับกันไม่ได้: พื้นทองสว่างแล้วใส่หมึกสว่างจะเหลือ ~1.1:1 ซึ่งตก AA หนัก
// พื้นสว่างจึงคู่หมึกเข้มเสมอ และพื้นเข้มคู่หมึกชมพู/ทองเสมอ
// ⚠️ ปลายเข้มของไล่เฉดทองเป็น #ffc554 ห้ามลากลงไปถึง #f41571 หรือ #8a0a45 ของ
// brand-spec — สองค่าหลังเป็นสีเส้น/ออรา เอามารองหมึก #2a0012 จะตก AA ทันที
//
// เป็น chrome ล้วน จึงไม่มี heading tag
//
// สองปุ่มนี้ชี้ตรงไปที่ลิงก์ aff เลย ไม่ผ่าน /register, /login อีกต่อหนึ่ง — แถบนี้
// ขึ้นทุกหน้าเฉพาะจอมือถือ (lg:hidden) จึงเป็นจุดที่คำว่า "โหมดมือถือ" ของคำสั่งหมายถึง
// ตรงๆ ที่สุด การตัดตัวกลางออกลดคลิกจากกดปุ่ม -> หน้า /register (หรือ /login) ->
// กดปุ่มอีกที -> ลิงก์ aff เหลือแค่กดปุ่มครั้งเดียว ตัวแปร targetUrl เป็นลิงก์
// เดียวกับที่ /register กับ /login ใช้อยู่แล้ว — ห้ามแก้ค่านี้ตรงนี้เอง อัปโหลดเดอร์
// จะอัปเดตให้พร้อมกับอีกสองไฟล์
const targetUrl = "https://yoalink.com/l360";
---

<div class="fixed right-0 bottom-0 left-0 z-[100] border-t border-[#f41571]/70 bg-[#1c0014]/95 font-sans shadow-[0_-5px_25px_rgba(244,21,113,0.45)] backdrop-blur-md lg:hidden">
  <div class="flex w-full gap-1.5 p-1.5">
    <a
      href={targetUrl}
      rel="nofollow sponsored"
      style="background-image: linear-gradient(in oklab to bottom, #fce343, #ffc554);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg py-3.5 text-base font-black text-[#2a0012] shadow-[0_0_12px_rgba(252,227,67,0.6)] transition-transform active:scale-95">
      <span aria-hidden="true">📝</span> สมัครสมาชิก
    </a>

    <a
      href={targetUrl}
      rel="nofollow sponsored"
      style="background-image: linear-gradient(in oklab to bottom, #3a0a2a, #1c0014);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg border border-[#f41571]/70 py-3.5 text-base font-black text-[#ff5ca8] shadow-[0_0_12px_rgba(244,21,113,0.4)] transition-transform active:scale-95">
      <span aria-hidden="true">🔑</span> เข้าสู่ระบบ
    </a>
  </div>
</div>
<style is:global>
  @media (max-width: 1023px) {
    body {
      padding-bottom: calc(75px + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
