---
// KINGKONG555 (รอบเขียวป่า-ทองมงกุฎ 2026-10-09): แถบ CTA ล่างจอมือถือ
// พื้นเขียวเกือบดำ #051400 เส้นขอบบนเขียวมะนาว #8ce023 ปุ่มสมัครเป็นไล่เฉดทอง
// ทองอ่อน #ffe066 → ทองมงกุฎ #f2c230 → ทองเข้ม #a87a08 ส่วนปุ่มเข้าสู่ระบบ
// เป็นไล่เฉดเขียว #2f8c07 → ผิวการ์ดกลาง #0f2e05 ในกรอบเขียวมะนาว #8ce023
//
// คู่ปุ่มรอบนี้คือ "ทองตันหมึกเขียวเข้ม / เขียวเข้มขอบเขียวหมึกทอง" ซึ่งมาจากงาน
// ศิลป์ตรงๆ ที่โลโก้เป็นกอริลลาสวมมงกุฎทองพาดด้วยคำว่า KINGKONG สีเขียวมะนาวและ
// 555 สีเงิน — เป็นสองฮิวจริง คนละคู่กับม่วงนีออน/ทองของ WEPLAY168 รอบก่อน ชุดนั้น
// (#a435f0 #7a1fc4 #fbe455 #ffd23d #c98a05 #190633 #17062e #0a0117
// rgba(164,53,240,α) rgba(251,228,85,α)) ไม่เหลือในไฟล์นี้
//
// สองปุ่มใช้หมึกคนละสี ไม่ใช่ยกคลาสข้ามปุ่ม — ตรวจค่าใหม่แล้วทั้งห้าคู่:
// หมึกเขียวเข้ม #06220a บนทองอ่อน #ffe066 ≈ 15.2:1 · บนทองมงกุฎ #f2c230
// ≈ 13.1:1 · บนทองเข้ม #a87a08 ≈ 6.2:1 ส่วนหมึกทองมงกุฎ #f2c230 บนเขียว
// #2f8c07 ≈ 4.8:1 · บนผิวการ์ดกลาง #0f2e05 ≈ 11.7:1 ทั้งหมดผ่าน AA สำหรับ
// ข้อความปกติที่ text-base กลับกันไม่ได้: พื้นทองสว่างแล้วใส่หมึกสว่างจะเหลือ
// ~1.1:1 ซึ่งตก AA หนัก พื้นสว่างจึงคู่หมึกเข้มเสมอ และพื้นเข้มคู่หมึกทองเสมอ
//
// เป็น chrome ล้วน จึงไม่มี heading tag
//
// สองปุ่มนี้ชี้ตรงไปที่ลิงก์ aff เลย ไม่ผ่าน /register, /login อีกต่อหนึ่ง — แถบนี้
// ขึ้นทุกหน้าเฉพาะจอมือถือ (lg:hidden) จึงเป็นจุดที่คำว่า "โหมดมือถือ" ของคำสั่งหมายถึง
// ตรงๆ ที่สุด การตัดตัวกลางออกลดคลิกจากกดปุ่ม -> หน้า /register (หรือ /login) ->
// กดปุ่มอีกที -> ลิงก์ aff เหลือแค่กดปุ่มครั้งเดียว ตัวแปร targetUrl เป็นลิงก์
// เดียวกับที่ /register กับ /login ใช้อยู่แล้ว — ห้ามแก้ค่านี้ตรงนี้เอง อัปโหลดเดอร์
// จะอัปเดตให้พร้อมกับอีกสองไฟล์
const targetUrl = "https://yoalink.com/l360";
---

<div class="fixed right-0 bottom-0 left-0 z-[100] border-t border-[#8ce023]/70 bg-[#051400]/95 font-sans shadow-[0_-5px_25px_rgba(140,224,35,0.45)] backdrop-blur-md lg:hidden">
  <div class="flex w-full gap-1.5 p-1.5">
    <a
      href={targetUrl}
      rel="nofollow sponsored"
      style="background-image: linear-gradient(in oklab to bottom, #ffe066, #f2c230 55%, #a87a08);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg py-3.5 text-base font-black text-[#06220a] shadow-[0_0_12px_rgba(242,194,48,0.6)] transition-transform active:scale-95">
      <span aria-hidden="true">📝</span> สมัครสมาชิก
    </a>

    <a
      href={targetUrl}
      rel="nofollow sponsored"
      style="background-image: linear-gradient(in oklab to bottom, #2f8c07, #0f2e05);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg border border-[#8ce023]/70 py-3.5 text-base font-black text-[#f2c230] shadow-[0_0_12px_rgba(140,224,35,0.5)] transition-transform active:scale-95">
      <span aria-hidden="true">🔑</span> เข้าสู่ระบบ
    </a>
  </div>
</div>
<style is:global>
  @media (max-width: 1023px) {
    body {
      padding-bottom: calc(75px + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
