---
// รับตัง168 (รอบทองไทยนำ-แดงมังกรรอง 2026-10-18): แถบ CTA ล่างจอมือถือ
// พื้นแดงเกือบดำจม #140505 (พื้นเพจรอบนี้เป็นดำอมแดง #1a0505 แถบจึงแยกตัวออกจาก
// เนื้อหาที่เลื่อนผ่านด้วยพื้นที่จมกว่าหนึ่งชั้น บวกเส้นขอบบนทองและเงาเรืองทอง)
// เส้นขอบบนทองแบรนด์ #f0b429
//
// ⚠️ **คู่ปุ่มรอบนี้สลับขั้วจากรอบก่อน** รอบก่อน (สมหวัง168) เป็น "สมัคร = พื้นแดงตัน /
// เข้าสู่ระบบ = ผิวมืดกรอบทอง" รอบนี้กลับด้านเป็น "สมัคร = **พื้นทองตัน** /
// เข้าสู่ระบบ = ผิวมืด **กรอบแดง**" ซึ่งมาจากงานศิลป์ตรงๆ ที่กองเหรียญทองกินพื้นที่
// กว้างที่สุดในแบนเนอร์ ส่วนแดงอยู่ที่เลข 168 กับริบบิ้นซาติน — รอบนี้ **ทองนำ**
// คู่ปุ่มจึงต่างกันที่ "พื้นทองตัน vs กรอบแดง" ไม่ใช่ที่ระดับความสว่างของสีเดียว
// ⚠️ สามรอบก่อน (GT66B, TKB55, สมหวัง168) เป็นแดงเหมือนกันหมด แต่เป็น **คนละค่า**
// ชุดของสมหวัง168 (#fa0513 #ff5a5f #ffadaf #e3b23c #ffe5a8 #2c1413 #140706
// #170504 rgba(250,5,19,α) rgba(227,178,60,α)) ชุดของ GT66B (#fb141b #ff5f63
// #ffa0a2 #1c0c0b #0b0303 #190505) ชุดของ TKB55 (#fb131b #ff4d55 #ff8a8f
// #2a0d0f #0d0304 #1a0304) ชุดของ TSDET911 (#0360f3 #0292fb #6ec8ff #102a5e
// #040e26 #021026 #dde8f7) และของ KMD88 (#7505cc #e2b33f #ffdf8c #1a0526
// #1d0832 #0a0213) ไม่เหลือในไฟล์นี้แล้ว
// ⚠️ ทองรอบนี้ #f0b429 ต่างจากทองของสมหวัง168 (#e3b23c) และ KMD88 (#e2b33f)
// ไม่กี่หลัก ให้เทียบเป็นค่า ไม่ใช่ด้วยตา
//
// สองปุ่มใช้หมึกคนละสี ไม่ใช่ยกคลาสข้ามปุ่ม — ตรวจค่าใหม่แล้วทั้งสี่คู่:
// หมึกแดงเกือบดำ #1a0505 บนทองสว่าง #ffdc8c ≈ 13.0:1 · บนทองแบรนด์ #f0b429 ≈ 9.7:1
// ส่วนหมึกแดงสว่าง #ff6b6e บนผิวยก #2b100f ≈ 5.4:1 · บนผิวจม #140505 ≈ 6.1:1
// ทั้งหมดผ่าน AA สำหรับข้อความปกติที่ text-base
// กลับกันไม่ได้: พื้นทองสว่างแล้วใส่หมึกสว่างจะเหลือราว 1.3:1 ซึ่งตก AA หนัก
// พื้นสว่างจึงคู่หมึกเข้มเสมอ และพื้นเข้มคู่หมึกสว่างเสมอ
// ⚠️ ปลายเข้มของไล่เฉดทองเป็น #f0b429 ห้ามลากลงไปถึง #9a6c0c ของ brand-spec —
// ค่านั้นเป็นทองลึกสำหรับเส้น/พื้นถมเท่านั้น เอามารองหมึก #1a0505 จะเหลือ ~4.2:1
// และกรอบแดงเป็น #d30304 ห้ามใช้ #a00203 หรือ #4a0202 ซึ่งจมเกินกว่าจะเห็นเป็นกรอบ
// ⚠️ ห้ามใช้ #cfd9e6 (โครเมียมอมฟ้า) ที่นี่ — ค่านั้นสงวนไว้เป็นสีตัวอักษรรองเท่านั้น
//
// เป็น chrome ล้วน จึงไม่มี heading tag
//
// สองปุ่มนี้ชี้ตรงไปที่ลิงก์ aff เลย ไม่ผ่าน /register, /login อีกต่อหนึ่ง — แถบนี้
// ขึ้นทุกหน้าเฉพาะจอมือถือ (lg:hidden) จึงเป็นจุดที่คำว่า "โหมดมือถือ" ของคำสั่งหมายถึง
// ตรงๆ ที่สุด การตัดตัวกลางออกลดคลิกจากกดปุ่ม -> หน้า /register (หรือ /login) ->
// กดปุ่มอีกที -> ลิงก์ aff เหลือแค่กดปุ่มครั้งเดียว ตัวแปร targetUrl เป็นลิงก์
// เดียวกับที่ /register กับ /login ใช้อยู่แล้ว — ห้ามแก้ค่านี้ตรงนี้เอง อัปโหลดเดอร์
// จะอัปเดตให้พร้อมกับอีกสองไฟล์
const targetUrl = "https://yoalink.com/2u19";
---

<div class="fixed right-0 bottom-0 left-0 z-[100] border-t border-[#f0b429]/75 bg-[#140505]/95 font-sans shadow-[0_-5px_25px_rgba(240,180,41,0.45)] backdrop-blur-md lg:hidden">
  <div class="flex w-full gap-1.5 p-1.5">
    <a
      href={targetUrl}
      rel="nofollow sponsored"
      style="background-image: linear-gradient(in oklab to bottom, #ffdc8c, #f0b429);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg py-3.5 text-base font-black text-[#1a0505] shadow-[0_0_12px_rgba(240,180,41,0.6)] transition-transform active:scale-95">
      <span aria-hidden="true">📝</span> สมัครสมาชิก
    </a>

    <a
      href={targetUrl}
      rel="nofollow sponsored"
      style="background-image: linear-gradient(in oklab to bottom, #2b100f, #140505);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg border border-[#d30304]/80 py-3.5 text-base font-black text-[#ff6b6e] shadow-[0_0_12px_rgba(211,3,4,0.5)] transition-transform active:scale-95">
      <span aria-hidden="true">🔑</span> เข้าสู่ระบบ
    </a>
  </div>
</div>
<style is:global>
  @media (max-width: 1023px) {
    body {
      padding-bottom: calc(75px + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
