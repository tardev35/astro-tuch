---
// หวยพยัคฆ์ (รอบกรมท่า-ทอง 2026-09-22): แถบ CTA ล่างจอมือถือ พื้นกรมท่าเข้ม
// #030b1c เส้นขอบบนทองหลัก #fadb6c ปุ่มสมัครเป็นไล่เฉดทอง #fdf5a4 → #fadb6c
// ตัวหนังสือกรมท่าเข้ม #030b1c ส่วนปุ่มเข้าสู่ระบบเป็นการ์ดกรมท่า #0f2149
// ขอบบรอนซ์ #ab6d13 — ไม่มีโทนดำ-ทองของรอบก่อนหลงเหลือ
//
// เป็น chrome ล้วน จึงไม่มี heading tag และทุก href ต้องชี้ไป route ที่มีจริง
// (/register กับ /login ซึ่งเปิดเป็นหน้าปุ่มจริงรอบนี้)
---

<div class="fixed right-0 bottom-0 left-0 z-[100] border-t border-[#fadb6c]/50 bg-[#030b1c]/95 font-sans shadow-[0_-5px_25px_rgba(250,219,108,0.25)] backdrop-blur-md lg:hidden">
  <div class="flex w-full gap-1.5 p-1.5">
    <a
      href="/register"
      style="background-image: linear-gradient(in oklab to bottom, #fdf5a4, #fadb6c);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg py-3.5 text-base font-black text-[#030b1c] shadow-[0_0_12px_rgba(250,219,108,0.5)] transition-transform active:scale-95">
      <span aria-hidden="true">📝</span> สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg border border-[#ab6d13]/70 bg-[#0f2149] py-3.5 text-base font-bold text-[#dbe4f7] shadow-[0_2px_8px_rgba(3,11,28,0.45)] transition-transform hover:bg-[#14264d] active:scale-95">
      <span aria-hidden="true">🔑</span> เข้าสู่ระบบ
    </a>
  </div>
</div>
<style is:global>
  @media (max-width: 1023px) {
    body {
      padding-bottom: calc(75px + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
