---
// TIGERWIN369 (รอบทองอำพันเสือบนดำสนิท 2026-10-11): แถบ CTA ล่างจอมือถือ
// พื้นดำสนิท #000000 (= พื้นเพจของ bg.json รอบนี้) เส้นขอบบนทองอำพัน #d98324
// ปุ่มสมัครเป็นไล่เฉดทอง ทองซีด #ffd98a → ทองสว่าง #f7b733 → ทองอำพัน #d98324
// ส่วนปุ่มเข้าสู่ระบบเป็นไล่เฉดผิวมืดน้ำตาล #1c1206 → #0f0903 ในกรอบทองอำพัน
//
// คู่ปุ่มรอบนี้คือ "ทองตันหมึกดำน้ำตาล / ผิวมืดขอบทองหมึกทองซีด" ซึ่งมาจากงาน
// ศิลป์ตรงๆ ที่โลโก้เป็นหัวเสือขนทองอำพันสวมมงกุฎทองบนเหรียญตราดำ-ทอง
// ⚠️ รอบก่อน (UFA324) ก็เป็นทอง แต่เป็น "ทองคู่เงินโครเมียม" ปุ่มที่สองจึงเคยมี
// ขอบเงิน #b9c2cc — รอบนี้ **ไม่มีเงินเลย** ขอบปุ่มที่สองเป็นทองอำพันแทน
// ให้เทียบเป็นค่า ไม่ใช่ "มีทองอยู่ = ของรอบก่อน" ชุดเดิมของ UFA324 (#e5a81b
// #ffe08a #bb8410 #b9c2cc #17130a #0d0b06 #140d01 #ffcf5e rgba(229,168,27,α)
// rgba(185,194,204,α)) ไม่เหลือในไฟล์นี้
//
// สองปุ่มใช้หมึกคนละสี ไม่ใช่ยกคลาสข้ามปุ่ม — ตรวจค่าใหม่แล้วทั้งห้าคู่:
// หมึกดำน้ำตาล #1a0d02 บนทองซีด #ffd98a ≈ 14.5:1 · บนทองสว่าง #f7b733 ≈ 10.8:1
// · บนทองอำพัน #d98324 ≈ 6.6:1 ส่วนหมึกทองซีด #ffd98a บนผิวกลาง #1c1206 ≈ 14.1:1
// · บนผิวจม #0f0903 ≈ 15.3:1 ทั้งหมดผ่าน AA สำหรับข้อความปกติที่ text-base
// กลับกันไม่ได้: พื้นทองสว่างแล้วใส่หมึกสว่างจะเหลือ ~1.1:1 ซึ่งตก AA หนัก
// พื้นสว่างจึงคู่หมึกเข้มเสมอ และพื้นเข้มคู่หมึกทองเสมอ
// ⚠️ ปลายเข้มของไล่เฉดทองเป็น #d98324 ไม่ใช่ #8a5214 ของ brand-spec — #8a5214
// เป็นสีเส้น/ออราเท่านั้น ถ้าเอามารองหมึก #1a0d02 จะได้ ~3.0:1 ซึ่งตก AA
//
// เป็น chrome ล้วน จึงไม่มี heading tag
//
// สองปุ่มนี้ชี้ตรงไปที่ลิงก์ aff เลย ไม่ผ่าน /register, /login อีกต่อหนึ่ง — แถบนี้
// ขึ้นทุกหน้าเฉพาะจอมือถือ (lg:hidden) จึงเป็นจุดที่คำว่า "โหมดมือถือ" ของคำสั่งหมายถึง
// ตรงๆ ที่สุด การตัดตัวกลางออกลดคลิกจากกดปุ่ม -> หน้า /register (หรือ /login) ->
// กดปุ่มอีกที -> ลิงก์ aff เหลือแค่กดปุ่มครั้งเดียว ตัวแปร targetUrl เป็นลิงก์
// เดียวกับที่ /register กับ /login ใช้อยู่แล้ว — ห้ามแก้ค่านี้ตรงนี้เอง อัปโหลดเดอร์
// จะอัปเดตให้พร้อมกับอีกสองไฟล์
const targetUrl = "https://yoalink.com/l360";
---

<div class="fixed right-0 bottom-0 left-0 z-[100] border-t border-[#d98324]/70 bg-[#000000]/95 font-sans shadow-[0_-5px_25px_rgba(217,131,36,0.45)] backdrop-blur-md lg:hidden">
  <div class="flex w-full gap-1.5 p-1.5">
    <a
      href={targetUrl}
      rel="nofollow sponsored"
      style="background-image: linear-gradient(in oklab to bottom, #ffd98a, #f7b733 55%, #d98324);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg py-3.5 text-base font-black text-[#1a0d02] shadow-[0_0_12px_rgba(217,131,36,0.6)] transition-transform active:scale-95">
      <span aria-hidden="true">📝</span> สมัครสมาชิก
    </a>

    <a
      href={targetUrl}
      rel="nofollow sponsored"
      style="background-image: linear-gradient(in oklab to bottom, #1c1206, #0f0903);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg border border-[#d98324]/70 py-3.5 text-base font-black text-[#ffd98a] shadow-[0_0_12px_rgba(217,131,36,0.4)] transition-transform active:scale-95">
      <span aria-hidden="true">🔑</span> เข้าสู่ระบบ
    </a>
  </div>
</div>
<style is:global>
  @media (max-width: 1023px) {
    body {
      padding-bottom: calc(75px + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
