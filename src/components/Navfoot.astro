---
// UWIN33 (รอบทอง-โครเมียม-ดำ 2026-09-24): แถบ CTA ล่างจอมือถือ พื้นดำอมน้ำตาล
// #161106 เส้นขอบบนทองแบรนด์ #e0b429 ปุ่มสมัครเป็นไล่เฉดทอง #fbd564 → #7a5407
// ตัวหนังสือบนปุ่มเป็นดำ #161106 เพื่อให้อ่านได้บนพื้นทองสว่าง ส่วนปุ่มเข้าสู่ระบบ
// เป็นการ์ด #26200e ขอบเงินโครเมียม #dfe4ec ตัวอักษร #ece6d8 — แดง #de161d
// #ff4d52 #7a0a0e และเงิน #e2e8ef บนพื้น #16090a/#26100f ของ MAHAGAME66 ไม่เหลือแล้ว
//
// เป็น chrome ล้วน จึงไม่มี heading tag และทุก href ต้องชี้ไป route ที่มีจริง
// (/register กับ /login ซึ่งเปิดเป็นหน้าปุ่มจริงรอบนี้)
---

<div class="fixed right-0 bottom-0 left-0 z-[100] border-t border-[#e0b429]/60 bg-[#161106]/95 font-sans shadow-[0_-5px_25px_rgba(224,180,41,0.35)] backdrop-blur-md lg:hidden">
  <div class="flex w-full gap-1.5 p-1.5">
    <a
      href="/register"
      style="background-image: linear-gradient(in oklab to bottom, #fbd564, #7a5407);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg py-3.5 text-base font-black text-[#161106] shadow-[0_0_12px_rgba(224,180,41,0.55)] transition-transform active:scale-95">
      <span aria-hidden="true">📝</span> สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg border border-[#dfe4ec]/50 bg-[#26200e] py-3.5 text-base font-bold text-[#ece6d8] shadow-[0_2px_8px_rgba(8,6,2,0.5)] transition-transform hover:bg-[#3a3116] active:scale-95">
      <span aria-hidden="true">🔑</span> เข้าสู่ระบบ
    </a>
  </div>
</div>
<style is:global>
  @media (max-width: 1023px) {
    body {
      padding-bottom: calc(75px + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
