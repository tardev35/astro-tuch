---
// HENG35 (รอบดำ-ทอง 2026-09-21): แถบ CTA ล่างจอมือถือ พื้นดำ #070605
// เส้นขอบบนทองหลัก #ecc55c ปุ่มสมัครเป็นไล่เฉดทอง #fefac4 → #ecc55c ตัวหนังสือ
// ดำ #0d0b0a ส่วนปุ่มเข้าสู่ระบบเป็นการ์ดดำ #1c1710 ขอบบรอนซ์ #a3732c —
// ไม่มีสีม่วงของรอบก่อนหลงเหลือ
//
// เป็น chrome ล้วน จึงไม่มี heading tag และทุก href ต้องชี้ไป route ที่มีจริง
// (/register กับ /login ซึ่งเปิดเป็นหน้าปุ่มจริงรอบนี้) ห้ามลิงก์ไป
// /ตรวจหวย หรือ /แนวทาง เพราะถูกพักไว้ที่ src/pages-disabled/
---

<div class="fixed right-0 bottom-0 left-0 z-[100] border-t border-[#ecc55c]/50 bg-[#070605]/95 font-sans shadow-[0_-5px_25px_rgba(236,197,92,0.25)] backdrop-blur-md lg:hidden">
  <div class="flex w-full gap-1.5 p-1.5">
    <a
      href="/register"
      style="background-image: linear-gradient(in oklab to bottom, #fefac4, #ecc55c);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg py-3.5 text-base font-black text-[#0d0b0a] shadow-[0_0_12px_rgba(236,197,92,0.5)] transition-transform active:scale-95">
      <span aria-hidden="true">📝</span> สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg border border-[#a3732c]/70 bg-[#1c1710] py-3.5 text-base font-bold text-[#ece1cb] shadow-[0_2px_8px_rgba(7,6,5,0.45)] transition-transform hover:bg-[#241d13] active:scale-95">
      <span aria-hidden="true">🔑</span> เข้าสู่ระบบ
    </a>
  </div>
</div>
<style is:global>
  @media (max-width: 1023px) {
    body {
      padding-bottom: calc(75px + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
