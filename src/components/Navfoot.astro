---
// FLASH877 (รอบทองสายฟ้า-แดงเลือดนก 2026-10-10): แถบ CTA ล่างจอมือถือ
// พื้นแดงเลือดนกเข้ม #2b0000 เส้นขอบบนทองสายฟ้า #f5c518 ปุ่มสมัครเป็นไล่เฉดทอง
// ทองสว่าง #ffdd73 → ทองสายฟ้า #f5c518 → ทองเข้ม #b8860f ส่วนปุ่มเข้าสู่ระบบเป็น
// ไล่เฉดแดง #8c0f0a → #430000 ในกรอบแดงสายฟ้า #ff3b14
//
// คู่ปุ่มรอบนี้คือ "ทองตันหมึกแดงเกือบดำ / แดงเข้มขอบแดงหมึกทอง" ซึ่งมาจากงาน
// ศิลป์ตรงๆ ที่โลโก้เป็นสายฟ้าทองผ่ากลางเหรียญขอบทองพื้นแดงเข้ม คำว่า FLASH เป็น
// ทองสามมิติและเลข 877 เป็นแดงสด — เป็นสองฮิวจริง คนละคู่กับแดงเสือโคร่ง/ทอง
// ถ่านไฟของ SUPERSLOTCLUB รอบก่อน ชุดนั้น (#e8232a #7d0f12 #301105 #180800
// #f2b705 #ffd666 #c08a0b #2b0a00 rgba(232,35,42,α) rgba(242,183,5,α))
// ไม่เหลือในไฟล์นี้ ⚠️ ทั้งสองรอบเป็นคู่ "แดง-ทอง" เหมือนกัน จึงต้องเทียบเป็นค่า
// ไม่ใช่ตระกูลสี — #f5c518 ไม่ใช่ #f2b705 และ #ff3b14 ไม่ใช่ #e8232a
//
// สองปุ่มใช้หมึกคนละสี ไม่ใช่ยกคลาสข้ามปุ่ม — ตรวจค่าใหม่แล้วทั้งห้าคู่:
// หมึกแดงเกือบดำ #2a0300 บนทองสว่าง #ffdd73 ≈ 12.9:1 · บนทองสายฟ้า #f5c518
// ≈ 11.0:1 · บนทองเข้ม #b8860f ≈ 5.8:1 ส่วนหมึกทอง #f5c518 บนแดงเข้ม #8c0f0a
// ≈ 5.9:1 · บนแดงลึกสุด #430000 ≈ 10.4:1 ทั้งหมดผ่าน AA สำหรับข้อความปกติที่
// text-base กลับกันไม่ได้: พื้นทองสว่างแล้วใส่หมึกสว่างจะเหลือ ~1.1:1 ซึ่งตก AA
// หนัก พื้นสว่างจึงคู่หมึกเข้มเสมอ และพื้นเข้มคู่หมึกทองเสมอ
// ⚠️ ปลายเข้มของไล่เฉดทองเป็น #b8860f ไม่ใช่ #8a6208 ของ brand-spec — #8a6208
// เป็นสีเงา/ออราเท่านั้น ถ้าเอามารองหมึก #2a0300 จะได้ ~3.4:1 ซึ่งตก AA
//
// เป็น chrome ล้วน จึงไม่มี heading tag
//
// สองปุ่มนี้ชี้ตรงไปที่ลิงก์ aff เลย ไม่ผ่าน /register, /login อีกต่อหนึ่ง — แถบนี้
// ขึ้นทุกหน้าเฉพาะจอมือถือ (lg:hidden) จึงเป็นจุดที่คำว่า "โหมดมือถือ" ของคำสั่งหมายถึง
// ตรงๆ ที่สุด การตัดตัวกลางออกลดคลิกจากกดปุ่ม -> หน้า /register (หรือ /login) ->
// กดปุ่มอีกที -> ลิงก์ aff เหลือแค่กดปุ่มครั้งเดียว ตัวแปร targetUrl เป็นลิงก์
// เดียวกับที่ /register กับ /login ใช้อยู่แล้ว — ห้ามแก้ค่านี้ตรงนี้เอง อัปโหลดเดอร์
// จะอัปเดตให้พร้อมกับอีกสองไฟล์
const targetUrl = "https://yoalink.com/l360";
---

<div class="fixed right-0 bottom-0 left-0 z-[100] border-t border-[#f5c518]/70 bg-[#2b0000]/95 font-sans shadow-[0_-5px_25px_rgba(245,197,24,0.45)] backdrop-blur-md lg:hidden">
  <div class="flex w-full gap-1.5 p-1.5">
    <a
      href={targetUrl}
      rel="nofollow sponsored"
      style="background-image: linear-gradient(in oklab to bottom, #ffdd73, #f5c518 55%, #b8860f);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg py-3.5 text-base font-black text-[#2a0300] shadow-[0_0_12px_rgba(245,197,24,0.6)] transition-transform active:scale-95">
      <span aria-hidden="true">📝</span> สมัครสมาชิก
    </a>

    <a
      href={targetUrl}
      rel="nofollow sponsored"
      style="background-image: linear-gradient(in oklab to bottom, #8c0f0a, #430000);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg border border-[#ff3b14]/70 py-3.5 text-base font-black text-[#f5c518] shadow-[0_0_12px_rgba(255,59,20,0.5)] transition-transform active:scale-95">
      <span aria-hidden="true">🔑</span> เข้าสู่ระบบ
    </a>
  </div>
</div>
<style is:global>
  @media (max-width: 1023px) {
    body {
      padding-bottom: calc(75px + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
