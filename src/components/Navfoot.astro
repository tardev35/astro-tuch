---
// TND168 (รอบทองมังกรบนดำสนิท 2026-10-12): แถบ CTA ล่างจอมือถือ
// พื้นดำจม #070502 (พื้นเพจรอบนี้เป็นดำสนิท #000000 แล้ว แถบจึงแยกตัวออกจาก
// เนื้อหาที่เลื่อนผ่านด้วยเส้นขอบบนทองและเงาเรืองทอง ไม่ใช่ด้วยความเข้มของพื้น)
// เส้นขอบบนทองหลัก #dfa310
// ปุ่มสมัครเป็นไล่เฉดทอง ทองไฮไลต์ #ffc93d → ทองหลัก #dfa310
// ส่วนปุ่มเข้าสู่ระบบเป็นไล่เฉดผิวมืด #120c04 → #070502 ในกรอบทอง
//
// คู่ปุ่มรอบนี้คือ "ทองตันหมึกดำน้ำตาลเกือบดำ / ผิวมืดขอบทองหมึกทองสว่าง" ซึ่งมา
// จากงานศิลป์ตรงๆ ที่โลโก้เป็นเหรียญตรามังกรทองกับตัวอักษร TND168 ทองสามมิติ
// บนพื้นดำ — แบรนด์นี้เป็น **ฮิวเดียวล้วน ไม่มีสีที่สอง** คู่ปุ่มจึงต่างกันที่
// "ทองสว่าง/ทองเข้ม" ของทองเดียวกัน ไม่ใช่ที่ตระกูลสี
// ⚠️ รอบก่อน (PUNPRO168) ปุ่มหลักเป็นทอง ปุ่มรองเป็นชมพู — รอบนี้ไม่มีชมพูแล้ว
// ให้เทียบเป็นค่า ไม่ใช่ "มีทองอยู่ = ของรอบนี้" ชุดเดิมของ PUNPRO168
// (#f41571 #ff5ca8 #fce343 #ffc554 #2a0012 #3a0a2a #1c0014
// rgba(244,21,113,α) rgba(252,227,67,α)) ไม่เหลือในไฟล์นี้
//
// สองปุ่มใช้หมึกคนละสี ไม่ใช่ยกคลาสข้ามปุ่ม — ตรวจค่าใหม่แล้วทั้งสี่คู่:
// หมึกดำน้ำตาล #140d02 บนทองไฮไลต์ #ffc93d ≈ 12.8:1 · บนทองหลัก #dfa310
// ≈ 8.7:1 ส่วนหมึกทองสว่าง #ffe4a3 บนผิวกลาง #120c04 ≈ 14.6:1 · บนผิวจม
// #070502 ≈ 15.8:1 ทั้งหมดผ่าน AA สำหรับข้อความปกติที่ text-base
// กลับกันไม่ได้: พื้นทองสว่างแล้วใส่หมึกสว่างจะเหลือ ~1.1:1 ซึ่งตก AA หนัก
// พื้นสว่างจึงคู่หมึกเข้มเสมอ และพื้นเข้มคู่หมึกทองเสมอ
// ⚠️ ปลายเข้มของไล่เฉดทองเป็น #dfa310 ห้ามลากลงไปถึง #8a5c09 หรือ #43240b ของ
// brand-spec — สองค่าหลังเป็นสีเส้น/ออรา เอามารองหมึก #140d02 จะตก AA ทันที
//
// เป็น chrome ล้วน จึงไม่มี heading tag
//
// สองปุ่มนี้ชี้ตรงไปที่ลิงก์ aff เลย ไม่ผ่าน /register, /login อีกต่อหนึ่ง — แถบนี้
// ขึ้นทุกหน้าเฉพาะจอมือถือ (lg:hidden) จึงเป็นจุดที่คำว่า "โหมดมือถือ" ของคำสั่งหมายถึง
// ตรงๆ ที่สุด การตัดตัวกลางออกลดคลิกจากกดปุ่ม -> หน้า /register (หรือ /login) ->
// กดปุ่มอีกที -> ลิงก์ aff เหลือแค่กดปุ่มครั้งเดียว ตัวแปร targetUrl เป็นลิงก์
// เดียวกับที่ /register กับ /login ใช้อยู่แล้ว — ห้ามแก้ค่านี้ตรงนี้เอง อัปโหลดเดอร์
// จะอัปเดตให้พร้อมกับอีกสองไฟล์
const targetUrl = "https://yoalink.com/2u19";
---

<div class="fixed right-0 bottom-0 left-0 z-[100] border-t border-[#dfa310]/70 bg-[#070502]/95 font-sans shadow-[0_-5px_25px_rgba(223,163,16,0.45)] backdrop-blur-md lg:hidden">
  <div class="flex w-full gap-1.5 p-1.5">
    <a
      href={targetUrl}
      rel="nofollow sponsored"
      style="background-image: linear-gradient(in oklab to bottom, #ffc93d, #dfa310);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg py-3.5 text-base font-black text-[#140d02] shadow-[0_0_12px_rgba(255,201,61,0.6)] transition-transform active:scale-95">
      <span aria-hidden="true">📝</span> สมัครสมาชิก
    </a>

    <a
      href={targetUrl}
      rel="nofollow sponsored"
      style="background-image: linear-gradient(in oklab to bottom, #120c04, #070502);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg border border-[#dfa310]/70 py-3.5 text-base font-black text-[#ffe4a3] shadow-[0_0_12px_rgba(223,163,16,0.4)] transition-transform active:scale-95">
      <span aria-hidden="true">🔑</span> เข้าสู่ระบบ
    </a>
  </div>
</div>
<style is:global>
  @media (max-width: 1023px) {
    body {
      padding-bottom: calc(75px + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
