<div class="fixed right-0 bottom-0 left-0 z-[100] border-t border-[#d4922c]/75 bg-[#0a0601]/95 font-sans shadow-[0_-5px_25px_rgba(212,146,44,0.45)] backdrop-blur-md lg:hidden">
