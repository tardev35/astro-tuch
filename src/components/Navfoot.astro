---
// SUPERSLOTCLUB (รอบแดงเสือโคร่ง-ทองถ่านไฟ 2026-10-09): แถบ CTA ล่างจอมือถือ
// พื้นน้ำตาลถ่านเกือบดำ #180800 เส้นขอบบนแดงเสือโคร่ง #e8232a ปุ่มสมัครเป็น
// ไล่เฉดทอง ทองอ่อน #ffd666 → ทองถ่านไฟ #f2b705 → ทองเข้ม #c08a0b ส่วนปุ่ม
// เข้าสู่ระบบเป็นไล่เฉดแดง #7d0f12 → ผิวการ์ดกลาง #301105 ในกรอบแดง #e8232a
//
// คู่ปุ่มรอบนี้คือ "ทองตันหมึกน้ำตาลเกือบดำ / แดงเข้มขอบแดงหมึกทอง" ซึ่งมาจากงาน
// ศิลป์ตรงๆ ที่โลโก้เป็นหัวเสือโคร่งเกี่ยวป้ายโล่แดงคาดคำว่า SUPERSLOTCLUB และ
// เหรียญทองลายรอยเท้าเสือในสไลด์ — เป็นสองฮิวจริง คนละคู่กับเขียวป่า/ทองมงกุฎของ
// KINGKONG555 รอบก่อน ชุดนั้น (#8ce023 #2f8c07 #1a5c04 #f2c230 #ffe066 #a87a08
// #06220a #051400 #0f2e05 rgba(140,224,35,α) rgba(242,194,48,α)) ไม่เหลือในไฟล์นี้
//
// สองปุ่มใช้หมึกคนละสี ไม่ใช่ยกคลาสข้ามปุ่ม — ตรวจค่าใหม่แล้วทั้งห้าคู่:
// หมึกน้ำตาลเกือบดำ #2b0a00 บนทองอ่อน #ffd666 ≈ 13.2:1 · บนทองถ่านไฟ #f2b705
// ≈ 10.1:1 · บนทองเข้ม #c08a0b ≈ 6.0:1 ส่วนหมึกทอง #f2b705 บนแดงลึก #7d0f12
// ≈ 7.0:1 · บนผิวการ์ดกลาง #301105 ≈ 8.9:1 ทั้งหมดผ่าน AA สำหรับข้อความปกติที่
// text-base กลับกันไม่ได้: พื้นทองสว่างแล้วใส่หมึกสว่างจะเหลือ ~1.1:1 ซึ่งตก AA
// หนัก พื้นสว่างจึงคู่หมึกเข้มเสมอ และพื้นเข้มคู่หมึกทองเสมอ
// ⚠️ ปลายเข้มของไล่เฉดทองเป็น #c08a0b ไม่ใช่ #a8730a ของ brand-spec — #a8730a
// เป็นสีขอบ/เส้นใต้เท่านั้น ถ้าเอามารองหมึก #2b0a00 จะได้ 4.48:1 ซึ่งตก AA
//
// เป็น chrome ล้วน จึงไม่มี heading tag
//
// สองปุ่มนี้ชี้ตรงไปที่ลิงก์ aff เลย ไม่ผ่าน /register, /login อีกต่อหนึ่ง — แถบนี้
// ขึ้นทุกหน้าเฉพาะจอมือถือ (lg:hidden) จึงเป็นจุดที่คำว่า "โหมดมือถือ" ของคำสั่งหมายถึง
// ตรงๆ ที่สุด การตัดตัวกลางออกลดคลิกจากกดปุ่ม -> หน้า /register (หรือ /login) ->
// กดปุ่มอีกที -> ลิงก์ aff เหลือแค่กดปุ่มครั้งเดียว ตัวแปร targetUrl เป็นลิงก์
// เดียวกับที่ /register กับ /login ใช้อยู่แล้ว — ห้ามแก้ค่านี้ตรงนี้เอง อัปโหลดเดอร์
// จะอัปเดตให้พร้อมกับอีกสองไฟล์
const targetUrl = "https://yoalink.com/l360";
---

<div class="fixed right-0 bottom-0 left-0 z-[100] border-t border-[#e8232a]/70 bg-[#180800]/95 font-sans shadow-[0_-5px_25px_rgba(232,35,42,0.45)] backdrop-blur-md lg:hidden">
  <div class="flex w-full gap-1.5 p-1.5">
    <a
      href={targetUrl}
      rel="nofollow sponsored"
      style="background-image: linear-gradient(in oklab to bottom, #ffd666, #f2b705 55%, #c08a0b);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg py-3.5 text-base font-black text-[#2b0a00] shadow-[0_0_12px_rgba(242,183,5,0.6)] transition-transform active:scale-95">
      <span aria-hidden="true">📝</span> สมัครสมาชิก
    </a>

    <a
      href={targetUrl}
      rel="nofollow sponsored"
      style="background-image: linear-gradient(in oklab to bottom, #7d0f12, #301105);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg border border-[#e8232a]/70 py-3.5 text-base font-black text-[#f2b705] shadow-[0_0_12px_rgba(232,35,42,0.5)] transition-transform active:scale-95">
      <span aria-hidden="true">🔑</span> เข้าสู่ระบบ
    </a>
  </div>
</div>
<style is:global>
  @media (max-width: 1023px) {
    body {
      padding-bottom: calc(75px + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
