---
// HENG38 (รอบมรกต-ทอง 2026-09-22): แถบ CTA ล่างจอมือถือ พื้นเขียวเกือบดำ
// #03140a เส้นขอบบนทองหลัก #f3cf63 ปุ่มสมัครเป็นไล่เฉดทอง #fbeeb0 → #f3cf63
// ตัวหนังสือเขียวเกือบดำ #03140a ส่วนปุ่มเข้าสู่ระบบเป็นการ์ดเขียว #0a2d16
// ขอบบรอนซ์ #a5761a — ไม่มีโทนน้ำเงินกรมท่าของรอบก่อนหลงเหลือ
//
// เป็น chrome ล้วน จึงไม่มี heading tag และทุก href ต้องชี้ไป route ที่มีจริง
// (/register กับ /login ซึ่งเปิดเป็นหน้าปุ่มจริงรอบนี้)
---

<div class="fixed right-0 bottom-0 left-0 z-[100] border-t border-[#f3cf63]/50 bg-[#03140a]/95 font-sans shadow-[0_-5px_25px_rgba(243,207,99,0.25)] backdrop-blur-md lg:hidden">
  <div class="flex w-full gap-1.5 p-1.5">
    <a
      href="/register"
      style="background-image: linear-gradient(in oklab to bottom, #fbeeb0, #f3cf63);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg py-3.5 text-base font-black text-[#03140a] shadow-[0_0_12px_rgba(243,207,99,0.5)] transition-transform active:scale-95">
      <span aria-hidden="true">📝</span> สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg border border-[#a5761a]/70 bg-[#0a2d16] py-3.5 text-base font-bold text-[#e6e2d2] shadow-[0_2px_8px_rgba(3,20,10,0.45)] transition-transform hover:bg-[#0f4423] active:scale-95">
      <span aria-hidden="true">🔑</span> เข้าสู่ระบบ
    </a>
  </div>
</div>
<style is:global>
  @media (max-width: 1023px) {
    body {
      padding-bottom: calc(75px + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
