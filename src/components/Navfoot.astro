---
// KOON234 (รอบมรกตเข้ม-ทองบนเขียวเกือบดำ 2026-10-09): แถบ CTA ล่างจอมือถือ
// พื้นเขียวเกือบดำ #020803 เส้นขอบบนทองแบรนด์ #cc920a ปุ่มสมัครเป็นไล่เฉดทอง
// ทองซีด #fde9a6 → ทองสว่าง #f7d14e → ทองแบรนด์ #cc920a ส่วนปุ่มเข้าสู่ระบบ
// เป็นไล่เฉดเขียวมรกต #0a6b32 → ผิวการ์ดกลาง #09190d ในกรอบทองแบรนด์ #cc920a
//
// คู่ปุ่มรอบนี้คือ "ทองตันหมึกเขียวเข้ม / เขียวเข้มขอบทองหมึกทอง" ซึ่งมาจากงาน
// ศิลป์ตรงๆ ที่โลโก้เป็นตัว KOON เงินโครเมียมติดเลข 234 ทอง คร่อมวงแหวนเขียวมรกต
// — เป็นสองฮิวจริง คนละคู่กับฟ้าสด/เหลืองมะนาวของ แตกดี168 รอบก่อน ชุดนั้น
// (#0193fb #7bcffb #064a86 #fce604 #fff48a #c9a703 #0a1726 #020609 #031018
// rgba(1,147,251,α) rgba(252,230,4,α)) ไม่เหลือในไฟล์นี้
//
// สองปุ่มใช้หมึกคนละสี ไม่ใช่ยกคลาสข้ามปุ่ม — ตรวจค่าใหม่แล้วทั้งสี่คู่:
// หมึกเขียวเข้ม #07170c บนทองซีด #fde9a6 ≈ 17.6:1 · บนทองสว่าง #f7d14e ≈ 16.0:1
// · บนทองแบรนด์ #cc920a ≈ 6.5:1 ส่วนหมึกทองสว่าง #f7d14e บนเขียวมรกต #0a6b32
// ≈ 5.9:1 · บนผิวการ์ดกลาง #09190d ≈ 15.8:1 ทั้งหมดผ่าน AA สำหรับข้อความปกติ
// ที่ text-base กลับกันไม่ได้: พื้นทองสว่างแล้วใส่หมึกสว่างจะเหลือ ~1.3:1 ซึ่ง
// ตก AA หนัก พื้นสว่างจึงคู่หมึกเข้มเสมอ และพื้นเข้มคู่หมึกทองเสมอ
//
// เป็น chrome ล้วน จึงไม่มี heading tag
//
// สองปุ่มนี้ชี้ตรงไปที่ลิงก์ aff เลย ไม่ผ่าน /register, /login อีกต่อหนึ่ง — แถบนี้
// ขึ้นทุกหน้าเฉพาะจอมือถือ (lg:hidden) จึงเป็นจุดที่คำว่า "โหมดมือถือ" ของคำสั่งหมายถึง
// ตรงๆ ที่สุด การตัดตัวกลางออกลดคลิกจากกดปุ่ม -> หน้า /register (หรือ /login) ->
// กดปุ่มอีกที -> ลิงก์ aff เหลือแค่กดปุ่มครั้งเดียว ตัวแปร targetUrl เป็นลิงก์
// เดียวกับที่ /register กับ /login ใช้อยู่แล้ว — ห้ามแก้ค่านี้ตรงนี้เอง อัปโหลดเดอร์
// จะอัปเดตให้พร้อมกับอีกสองไฟล์
const targetUrl = "https://yoalink.com/l360";
---

<div class="fixed right-0 bottom-0 left-0 z-[100] border-t border-[#cc920a]/70 bg-[#020803]/95 font-sans shadow-[0_-5px_25px_rgba(204,146,10,0.45)] backdrop-blur-md lg:hidden">
  <div class="flex w-full gap-1.5 p-1.5">
    <a
      href={targetUrl}
      rel="nofollow sponsored"
      style="background-image: linear-gradient(in oklab to bottom, #fde9a6, #f7d14e 55%, #cc920a);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg py-3.5 text-base font-black text-[#07170c] shadow-[0_0_12px_rgba(247,209,78,0.6)] transition-transform active:scale-95">
      <span aria-hidden="true">📝</span> สมัครสมาชิก
    </a>

    <a
      href={targetUrl}
      rel="nofollow sponsored"
      style="background-image: linear-gradient(in oklab to bottom, #0a6b32, #09190d);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg border border-[#cc920a]/70 py-3.5 text-base font-black text-[#f7d14e] shadow-[0_0_12px_rgba(10,107,50,0.5)] transition-transform active:scale-95">
      <span aria-hidden="true">🔑</span> เข้าสู่ระบบ
    </a>
  </div>
</div>
<style is:global>
  @media (max-width: 1023px) {
    body {
      padding-bottom: calc(75px + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
