---
// WY88 (รอบชมพูมาเจนตา-ทอง 2026-09-23): แถบ CTA ล่างจอมือถือ พื้นพลัมเกือบดำ
// #170411 เส้นขอบบนทอง #e8b33a ปุ่มสมัครเป็นไล่เฉดมาเจนตา #f9a8cd → #ec2b84
// ตัวหนังสือพลัมเกือบดำ #170411 ส่วนปุ่มเข้าสู่ระบบเป็นการ์ดพลัม #24081a
// ขอบทอง #c3832b — ไม่มีชมพูบับเบิลกัมกับเหลืองมะนาวของรอบก่อนหลงเหลือ
//
// เป็น chrome ล้วน จึงไม่มี heading tag และทุก href ต้องชี้ไป route ที่มีจริง
// (/register กับ /login ซึ่งเปิดเป็นหน้าปุ่มจริงรอบนี้)
---

<div class="fixed right-0 bottom-0 left-0 z-[100] border-t border-[#e8b33a]/50 bg-[#170411]/95 font-sans shadow-[0_-5px_25px_rgba(236,43,132,0.25)] backdrop-blur-md lg:hidden">
  <div class="flex w-full gap-1.5 p-1.5">
    <a
      href="/register"
      style="background-image: linear-gradient(in oklab to bottom, #f9a8cd, #ec2b84);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg py-3.5 text-base font-black text-[#170411] shadow-[0_0_12px_rgba(236,43,132,0.5)] transition-transform active:scale-95">
      <span aria-hidden="true">📝</span> สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg border border-[#c3832b]/70 bg-[#24081a] py-3.5 text-base font-bold text-[#fce9f3] shadow-[0_2px_8px_rgba(23,4,17,0.45)] transition-transform hover:bg-[#361028] active:scale-95">
      <span aria-hidden="true">🔑</span> เข้าสู่ระบบ
    </a>
  </div>
</div>
<style is:global>
  @media (max-width: 1023px) {
    body {
      padding-bottom: calc(75px + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
