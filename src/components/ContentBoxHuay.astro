---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on every
// decorative absolute layer, and the slot renders as a direct child of the card.
// Do not re-add a `relative z-10` wrapper <div>.
//
// หัวข้อมาจาก prop `title` + `as` เท่านั้น — ห้าม hardcode ข้อความไทยเป็น heading
// ในไฟล์นี้ คำว่า Huay ในชื่อไฟล์เป็น **ป้ายสไตล์ ไม่ใช่เนื้อหา**
//
// รวย168 (ดรอป 2026-10-23, .claude/brand-spec-ruay168.md §2–§4): ไฟล์นี้เป็นกล่อง
// คอลัมน์เดียวที่หน้าแรกเรียก **สองครั้ง** — §1 ถือ docx **H1** (แทงหวยเว็บรวย
// รับแทงเลขออนไลน์ทุกประเภท) และ §3 ถือ docx **H3** (อัตราจ่าย 2 ตัว 100) พร้อม
// **banner3.png** เป็นรูปประกอบในสล็อตเดียวกัน หน้าอื่นไม่ได้ import ตัวนี้รอบนี้
// (หน้าถาวร terms/privacy/404 เดินผ่าน ContentBox.astro ซึ่งเป็น shared chrome)
// ⚠️ §3 ส่ง **<div> ใบเดียว** ที่ห่อ <p> + <Picture> ไว้ด้วยกัน ตามกฎ
// one-element-per-slot ของ playbook — ไฟล์นี้ไม่ได้ห่อให้ และต้องไม่ห่อให้
//
// ความกว้างจริงที่รูปใน slot ถูกวาด (หน้าแรกคิด `sizes` จากชุดนี้) ถ้าแก้ padding
// หรือ border ของการ์ดต้องไปแก้ `sizes` ใน src/pages/index.astro ด้วย
// (Tailwind เป็น border-box ทั้งโปรเจกต์ max-w/padding จึงนับรวมกัน · รูปแคปตัวเอง
//  ไว้ที่ max-w-2xl = 672px ตามกฎ banner2/3 ของ playbook):
//   section max-w-[1400px] + px-4 (16x2=32) · การ์ด border-2 (2x2=4)
//   มือถือ px-7 (28x2=56) · md ขึ้นไป md:px-12 (48x2=96)
//   >= 804px  : min(100vw,1400) - 132 >= 672 -> ติดเพดานรูป      = 672px
//   768..803  : md padding แล้วแต่ยังไม่ถึง 672                   = calc(100vw - 132px)
//   764..767  : ยังเป็น padding มือถือ 100vw - 92 >= 672          = 672px
//   < 764     : padding มือถือ                                    = calc(100vw - 92px)
// ⚠️ ช่วง 768..803 **แคบกว่า** ช่วงที่อยู่ใต้มันเพราะ md เพิ่ม padding ขึ้น 40px
// ต่อข้าง — ไม่ใช่ความผิดพลาดในการคิด แต่เป็นผลของ padding ที่ไม่เท่ากันสองชุด
//
// รูปทรงคือ "ใบสลาก": กรอบหนา + วงในเส้นประ + รอยปรุครึ่งวงกลมสองข้างกลางการ์ด
// + แถบหัวตั๋วไล่เฉดบนสุด + เส้นประใต้หัวข้อ — ตรงกับแกนของแบรนด์รอบนี้ที่เป็น
// **เว็บหวย** และอาร์ตเวิร์กที่เป็นตารางอัตราจ่ายหวยสี่ประเภทบนแผ่นป้ายขอบทอง
// ไอคอนหัวข้อเป็น 🎟️ อยู่ใน <span aria-hidden="true"> และเป็น **พี่น้อง** ของหัวข้อ
// ไม่ได้อยู่ในข้อความ
//
// ⚠️ **ธีมมืดสนิท** — bg.json ของดรอปนี้คือ {"mode":"color","color":"#000000"}
// **ห้าม "แก้" การ์ดให้เป็นพื้นสว่าง** (รอบก่อนของไฟล์นี้เป็นธีมสว่างการ์ดขาว
// จึงเป็นการกลับทิศ 180 องศา ไม่ใช่การปรับเฉดสี)
// ลำดับผิว: #1c1a16 ยก/ชิป · #121110 การ์ด (ใบนี้) · #070707 จม · #000000 พื้นเพจ
// บทบาทสีในไฟล์นี้:
//   ทอง #ffd94a = หัวข้อ (13.8:1 บนผิวการ์ด) · ออรา · ขอบ hover · สต็อปกลางแถบหัวตั๋ว
//   โครเมียมเงิน #e8eaee = **วัสดุที่สอง** (16.0:1) อยู่ที่สต็อปกลางของหัวข้อและ
//     ออรามุมขวาล่าง — มาจากเวิร์ดมาร์ก "รวย" และคำว่า "2 ตัว" บน banner3 โดยตรง
//   ทองลึก #9d6f06 = ขอบการ์ด · ปลายแถบหัวตั๋ว · วงในรอยปรุ **ห้ามถือตัวอักษร**
//   เส้น #3d3425 = วงในเส้นประ + เส้นประใต้หัวข้อ **ห้ามถือตัวอักษร**
//   หมึก #f3ece0 = เนื้อความ (= BRAND_TEXT, 16.0:1 บนผิวการ์ดนี้)
// ⚠️ หัวข้อถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุกสต็อปต้องถือตัวอักษรได้:
// #ffd94a 13.8:1 และ #e8eaee 16.0:1 ผ่านทั้งคู่ — **ห้ามเอา #9d6f06 (4.7:1) หรือ
// #6b7079 (4.2:1) มาเป็นสต็อปของหัวข้อ** สองค่านั้นเป็นขอบ/ออรา/พื้นถมเท่านั้น
// ⚠️⚠️ **ขาวบนทองได้แค่ ~1.2–2.2:1** — ในไฟล์นี้ไม่มีพื้นถมทองที่ถือตัวอักษรเลย
// สักจุด ถ้าจะเพิ่มในอนาคต หมึกต้องเป็น #0a0a0a เท่านั้น
// rgba() ที่อนุญาตรอบนี้: rgba(255,217,74,α) · rgba(227,167,18,α) ·
// rgba(176,125,8,α) · rgba(157,111,6,α) · rgba(232,234,238,α) · rgba(0,0,0,α)
//
// ⚠️ เทียบสีเป็น **"ค่า"** ไม่ใช่ "ตระกูลสี" — **ทอง/เหลืองเคยนำมาแล้วเกือบทุกแบรนด์
// ในรีโปนี้** การเจอ "ทอง" ในไฟล์จึงไม่พิสูจน์อะไรเลย ทองรอบนี้คือ #ffd94a /
// #e3a712 / #9d6f06 เท่านั้น
// ⚠️⚠️ **มาดาม168 เป็นแบรนด์ขาออก = เสี่ยงหลงเหลือสูงสุด** (แดงคริมสัน+น้ำเงิน
// อะซัวร์บนกรมท่า): ff2e52 e01238 c9102f 1177e8 0e68cc 0a4ea8 00091f 050e26 0b1733
// 16234a 2a3c70 f4eef1 b3bdd6 d9dfe9
// ชุดที่เพิ่งอยู่ในไฟล์นี้ทั้งใบและถอดออกครบแล้วคือ **เขียวมรกต-ธีมสว่างของ
// สาธุ168**: 0b7d28 0a5f1c 0f9b35 0c3a16 061f0c c9cb63 aeb04a 9ba03c d8ffc7 e9fbdd
// ก่อนนั้นเป็นชุดทองโลหะ-ครีมอมพีชของ **หวยคิง** ซึ่งเป็นเจ้าของเดิมของตระกูล
// *Huay (cd9a2c fdeb7c ab7314 fcd4c3 fce2d4 1c140b 0c0b0a f5e7c8 5c3f12 120a02)
// และชุดชมพูบานเย็นของ **มีทรัพย์168** (dd1b74 a4186b 4a0d35 2d0720 f7dcf6 f0ccf5)
// กับชุดแดง-ทองของ **หวย365** (140203 dc0203 f5282a ffc93c ffeab0 8c0402 c08a07)
// ⚠️ ทองของแบรนด์อื่นที่ต้อง grep ทีละค่า ห้ามกะด้วยตา: fbc134 ffe87a cf9a18 96690a
// (NAZA168 ตัวละติน) · f5ba14 fcee52 b37c0b (เงินทอง168) · eeae12 fded41 9f600d
// e29f0f fdf051 (พักยก168) · f7c92b ffe6a3 (ขวัญใจ168) · d4922c fdfc71 d39c45
// (ufalion168) · e5a81b ffe08a bb8410 7d5a07 (UFA324) · fee45d e6a416 b8780d 7a4e05
// (ยูฟ้า168) · fef54b 6b5c10 (นินจา168) · fdcb0c fefb6b 8a6504 (สบาย168) · f9a826
// 704504 (รวยแทร่168) · ffc82e 5c4a16 (สบายเบท168) · e3b23c ffe5a8 8a6210
// (สมหวัง168) · dcb95f b8862b 96681f (รวยแท้168) · fcd434 ffeaa0 (มีโชค168) ·
// f0bb4e ffeccb (รวยเทพ168) · fcd45c 6b4a08 (มีเฮ168) · ffdc8c f0b429 (รับตัง168) ·
// f0c878 (ดวงเศรษฐี168) · f0b46a d9803a (โปรดี168) · f5b61d b07a06 (PIGPG)
// ⚠️⚠️ **ffd84d ของ ถอนชัวร์168 ห่างจาก #ffd94a ของรอบนี้แค่ G1** — เจอที่ไหน
// แปลว่าพิมพ์ผิด ไม่ใช่ค่าของรอบนี้
// ⚠️ แรมป์เทาเงินของแบรนด์อื่น (รอบนี้โครเมียมเป็นวัสดุที่สองจริง แต่เป็นคนละค่า):
// e0e0df c0c0bf a1a09e (พักยก168) · e8ecf1 a8b2bf 78828f 5a6472 (ยูฟ้า168) ·
// 8792a0 b9c2cc f0e8d4 464f5a (UFA324) · cfd9e6 (รับตัง168) · fdfcfd b4bcc2 eceaea
// (GT66B) · d9c9a6 cfd6e3 (NAZA168 ตัวละติน) · cfdcec 9db4d4 dde8f7 (TSDET911) ·
// c3c7d1 eef0f4 8d93a1 edeaf0 (หวยดีใจ)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️⚠️ **รอบนี้ไม่มีแดงเลยสักเฉด** — แดงคือสีนำของแบรนด์ขาออก และตระกูล *Huay
// เคยเป็นแดง/ทองมาก่อน การปล่อยแดงไว้ = ผิดพาเลตและหลงเหลือข้ามแบรนด์พร้อมกัน
// **ไม่มีชมพู ไม่มีน้ำเงิน/ฟ้า/ไซยาน ไม่มีม่วง ไม่มีส้ม ไม่มีเขียว ไม่มีครีม
// ไม่มีพีช ไม่มีน้ำตาลกาแฟ** — ลิปสติกแดง ผมขาวเงิน และสีผิวนักแสดงในอาร์ตเวิร์ก
// เป็น **วัตถุในภาพ ไม่ใช่สี UI** (ค่าพีชใน palette.json คือสีผิวนักแสดง)
//
// การ์ดถือ `text-left` ไว้เอง อย่าเผลอใส่ `text-center` บนการ์ดหรือ <section>
// เพราะมันจะ inherit ลงไปจัดกึ่งกลางย่อหน้าทั้งหน้า ถ้าต้องการหัวข้อกึ่งกลาง
// ให้ใส่บน HeadingTag เอง
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-[2rem] border-2 border-[#9d6f06]/70 bg-[#121110] px-7 py-9 text-left text-base leading-relaxed text-[#f3ece0] shadow-[0_12px_34px_rgba(0,0,0,0.65)] transition-all duration-500 hover:border-[#ffd94a]/80 hover:shadow-[0_16px_44px_rgba(227,167,18,0.26)] md:px-12 md:py-11">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-1.5 bg-gradient-to-r from-[#9d6f06] via-[#ffd94a] to-[#9d6f06]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute inset-2.5 -z-10 rounded-[1.5rem] border border-dashed border-[#3d3425]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute top-1/2 -left-5 -z-10 h-10 w-10 -translate-y-1/2 rounded-full bg-[#070707] shadow-[inset_0_0_0_1px_rgba(157,111,6,0.75)]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute top-1/2 -right-5 -z-10 h-10 w-10 -translate-y-1/2 rounded-full bg-[#070707] shadow-[inset_0_0_0_1px_rgba(157,111,6,0.75)]"></div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -top-24 left-1/2 -z-10 h-44 w-72 -translate-x-1/2 rounded-full bg-[#ffd94a]/18 blur-[70px] transition-all duration-500 group-hover:bg-[#ffd94a]/28">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute right-8 -bottom-20 -z-10 h-36 w-36 rounded-full bg-[#e8eaee]/12 blur-[60px] transition-all duration-500 group-hover:bg-[#e8eaee]/20"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-dashed border-[#3d3425] pb-5">
          <span aria-hidden="true" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#9d6f06]/70 bg-[#1c1a16] text-xl shadow-[0_0_14px_rgba(227,167,18,0.3)]">
            🎟️
          </span>
          <HeadingTag class={`bg-gradient-to-r from-[#ffd94a] via-[#e8eaee] to-[#ffd94a] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
