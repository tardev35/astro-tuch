---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#c1121f]/45 bg-[#3d0b0e]/95 p-8 text-left text-base leading-relaxed text-[#f4e7d3] shadow-[0_10px_30px_rgba(227,197,106,0.14)] backdrop-blur-xl transition-all duration-500 hover:border-[#e3c56a]/55 hover:shadow-[0_15px_40px_rgba(227,197,106,0.24)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#e3c56a]/25 blur-[50px] transition-all duration-500 group-hover:bg-[#e3c56a]/35"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#1c6b3f]/45 blur-[50px] transition-all duration-500 group-hover:bg-[#1c6b3f]/60"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#c1121f]/40 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f7e8b4] to-[#8a6a26] shadow-[0_0_10px_rgba(227,197,106,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#f7e8b4] via-[#e3c56a] to-[#8a6a26] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
