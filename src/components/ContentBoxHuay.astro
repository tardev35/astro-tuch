---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the two aura
// layers, and the slot renders as a direct child of the card. Do not re-add a
// `relative z-10` wrapper <div>.
//
// ธีม Huay แดง-ทอง-ดำ: ไฟล์นี้เป็นกล่องบทความของ /ตรวจหวย และ /แนวทาง เท่านั้น
// ไม่มีหน้าอื่นเรียกใช้ สองหน้านั้นคงธีมแดง-ทองของหมวดหวยไว้โดยตั้งใจตาม
// SKILL.md Phase 4.5 ข้อ 5 จึงไม่ถูกดึงไปเป็นรูปทรงของ ContentBox ตัวอื่น
// แต่ค่าสีถูกขยับมาใช้เลขจริงของ brand-spec §2 รอบนี้ เพื่อไม่ให้อ้างค่าคงที่ของ
// แบรนด์ก่อนหน้าต่อไป
//
// พื้นการ์ด #2b0909 ในกรอบทองลึก #a8690c ที่สว่างขึ้นเป็นทองรอง #f4bc5d ตอน hover
// หัวข้อไล่ทองอ่อน #ffefc2 → ทองรอง #f4bc5d → แดงสว่าง #e43434 ออร่าสองมุมแยกด้วย
// คู่สีทอง-แดง เนื้อความ #fbe3d4 (= BRAND_TEXT)
//
// การ์ดถือ `text-left` ไว้เอง อย่าเผลอใส่ `text-center` บนกล่องหรือ wrapper ใด
// ที่ครอบ <slot /> เพราะมันจะรั่วไปจัดกึ่งกลางย่อหน้าของทั้งหน้า ถ้าต้องการหัวข้อ
// กึ่งกลาง ให้ใส่บน HeadingTag เอง
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#a8690c]/45 bg-[#2b0909]/95 p-8 text-left text-base leading-relaxed text-[#fbe3d4] shadow-[0_10px_30px_rgba(11,2,2,0.6)] backdrop-blur-xl transition-all duration-500 hover:border-[#f4bc5d]/60 hover:shadow-[0_15px_40px_rgba(244,188,93,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#f4bc5d]/25 blur-[50px] transition-all duration-500 group-hover:bg-[#f4bc5d]/35">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#dc2224]/24 blur-[50px] transition-all duration-500 group-hover:bg-[#e43434]/34">
    </div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#a8690c]/45 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffefc2] to-[#a8690c] shadow-[0_0_10px_rgba(244,188,93,0.55)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#ffefc2] via-[#f4bc5d] to-[#e43434] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
