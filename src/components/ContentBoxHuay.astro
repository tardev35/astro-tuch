---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#a3060c]/40 bg-[#0d0304]/95 p-8 text-left text-base leading-relaxed text-[#d8dae0] shadow-[0_10px_30px_rgba(255,42,48,0.14)] backdrop-blur-xl transition-all duration-500 hover:border-[#ff2a30]/55 hover:shadow-[0_15px_40px_rgba(255,42,48,0.24)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#ff2a30]/25 blur-[50px] transition-all duration-500 group-hover:bg-[#ff2a30]/35"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#5c0203]/45 blur-[50px] transition-all duration-500 group-hover:bg-[#5c0203]/60"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#a3060c]/35 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ff6b70] to-[#a3060c] shadow-[0_0_10px_rgba(255,42,48,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ff6b70] via-[#ff2a30] to-[#a3060c] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
