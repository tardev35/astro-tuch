---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on every
// decorative absolute layer, and the slot renders as a direct child of the card.
// Do not re-add a `relative z-10` wrapper <div>.
//
// หัวข้อมาจาก prop `title` + `as` เท่านั้น — ห้าม hardcode ข้อความไทยเป็น heading
// ในไฟล์นี้ คำว่า Huay ในชื่อไฟล์เป็น **ป้ายสไตล์ ไม่ใช่เนื้อหา**
//
// LOTTOPLUS (ดรอป 2026-10-28, .claude/brand-spec-lottoplus.md §2–§4): ไฟล์นี้ถือ
// **docx H1 §1** ของหน้าแรก ("<แบรนด์> หวยพลัสลอตโต้ ทางเข้าเว็บแม่ แทงหวยออนไลน์"
// — content.txt บรรทัด 3 หัวข้อ / บรรทัด 4 ย่อหน้า) **ใบเดียวบนหน้า** และเป็นกล่อง
// เดียวของหน้าที่ปล่อย h1 ออกมา ไม่มีรูปในสล็อต (playbook ตรึง slide* ไว้กับตระกูล
// SevenThree และโควตา 2 ใบถูกใช้ไปที่ §4 กับ §5 ครบแล้ว · banner1/banner1-mobile/
// og.png เป็นของ MainLayout · banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กของ
// แบรนด์อื่น ห้าม import) หน้าอื่นไม่ได้ import ไฟล์นี้รอบนี้ — หน้าถาวร
// terms/privacy/404 เดินผ่าน ContentBox.astro ซึ่งเป็น shared chrome
// ⚠️ สล็อตรับ **<p> ใบเดียว** ตามกฎ one-element-per-slot ของ playbook — ไฟล์นี้
// ไม่ได้ห่อให้ และต้องไม่ห่อให้
//
// รูปทรงคือ "ใบสลาก": กรอบหนา + วงในเส้นประ + รอยปรุครึ่งวงกลมสองข้างกลางการ์ด
// + แถบหัวตั๋วไล่เฉดบนสุด + เส้นประใต้หัวข้อ — ตรงกับแกนของแบรนด์รอบนี้ที่เป็น
// **เว็บหวย/ลอตโต้** และอาร์ตเวิร์กที่มีโพยหวย ใบสลาก และลูกบอลหวยพิมพ์เลข
// ไอคอนหัวข้อเป็น 🎟️ อยู่ใน <span aria-hidden="true"> และเป็น **พี่น้อง** ของหัวข้อ
// ไม่ได้อยู่ในข้อความ
//
// 🚨🚨 **ธีมเนื้อหาสว่าง และรอบนี้กลับทิศ 180° จากรอบก่อน** — bg.json ของดรอปนี้คือ
// {"mode":"color","color":"#e1fef3"} = **เขียวมินต์จางเกือบขาว** (รอบก่อน WIN8S เป็น
// 1e0101 ดำอมเลือดหมู = มืดทั้งเว็บ) **ห้าม "แก้" การ์ดใบนี้กลับไปเป็นพื้นมืด**
// เพราะหมึก #0d3326 บนพื้นมืดจะหายไปเลย ไม่ใช่แค่จางลง
// ⚠️ โครมเข้ม (navbar/footer/ticker/แถบล่างมือถือ) เป็นอีกโซนหนึ่ง **ไม่ใช่ไฟล์นี้**
// ลำดับผิว: #ffffff การ์ด (ใบนี้) · #f0fdf7 การ์ดสำรอง · #d2f3e4 พื้นถมอ่อน/ชั้นยก ·
// #e1fef3 พื้นเพจ (= สีของรอยปรุ เพื่อให้ดูเหมือนเจาะทะลุการ์ด)
// บทบาทสีในไฟล์นี้:
//   เขียวมรกต #046c4e = สต็อปกลางของหัวข้อ (6.70:1 บนการ์ดขาว) · ขอบ hover ใช้ 19a97c
//   เขียวลึก #03543c = สต็อปปลายของหัวข้อ (9.23:1) · ปลายแถบหัวตั๋ว
//   เขียวสด #19a97c = กรอบ hover · แถบหัวตั๋วสต็อปกลาง · วงในรอยปรุ **เส้น/พื้นถมเท่านั้น**
//   เส้นบาง #a3ddc3 = กรอบการ์ด · วงในเส้นประ · เส้นประใต้หัวข้อ · ขอบชิปไอคอน
//     **ห้ามถือตัวอักษร**
//   พื้นถมอ่อน #d2f3e4 = ชิปไอคอน · ออรามุมล่าง · ออราสว่าง 2fd49b = ออรามุมบน
//   หมึก #0d3326 = เนื้อความ (= BRAND_TEXT, 13.82:1 บนการ์ดขาว)
// ⚠️ หัวข้อถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุกสต็อปต้องถือตัวอักษรได้:
//   #03543c 9.23:1 · #046c4e 6.70:1 ผ่านทั้งคู่ — **ห้ามเอา 19a97c (3.0:1) 2fd49b
//   a3ddc3 d2f3e4 หรือ e2b32a (2.0:1 บนขาว) มาเป็นสต็อปของหัวข้อ**
// ⚠️⚠️ ไฟล์นี้ **ไม่มีพื้นถมที่ถือตัวอักษรเลยสักจุด** ถ้าจะเพิ่มในอนาคต ต้องเป็น
// สูตรปุ่มของ §2 (ไล่ 0c7c58 → 046c4e → 03543c + หมึกขาว) เท่านั้น
// ⚠️ **เงาบนการ์ดสว่างต้องเบา** — รอบก่อนเป็นเงาดำ alpha สูงซึ่งถูกสำหรับการ์ดเข้ม
// แต่บนการ์ดขาวจะกลายเป็นคราบเทาหนา รอบนี้จึงใช้ rgba(13,51,38,0.10) และ hover
// ยกเป็น rgba(4,108,78,0.18) **ห้ามลอกค่า alpha ของรอบก่อนมา**
// rgba() ที่อนุญาตรอบนี้: rgba(4,108,78,α) · rgba(25,169,124,α) · rgba(47,212,155,α) ·
// rgba(226,179,42,α) · rgba(13,51,38,α) · rgba(5,46,34,α) · rgba(3,32,26,α)
//
// ⚠️⚠️ เทียบสีเป็น **"ค่า"** ไม่ใช่ "ตระกูลสี" — **เขียวผ่านรีโปนี้มาแล้วหลายเจ้า
// (สาธุ168 · TEVA69 · ZORO365 ล้วนเขียว)** การเจอ "เขียว" ในไฟล์จึงไม่พิสูจน์อะไร
// เขียวรอบนี้คือ 046c4e / 0c7c58 / 03543c / 19a97c / 2fd49b / a3ddc3 / d2f3e4 /
// e1fef3 / f0fdf7 / 0d3326 / 3f6f5c และโครม 052e22 / 03201a / 0a4433 เท่านั้น
// ⚠️⚠️ **ชุดที่เพิ่งอยู่ทั้งใบนี้คือแดง/ชมพู/ทองของ LOTTO189** ต้องกวาดก่อนใคร:
// fff0f0 ffe4e6 ffd4d7 f5b9bd a8333f 25090f 6e3b44 b00718 c1071b 8a0412 8f6310
// d61023 ff2436 e9b53c 24060c 3d0d16 120307 7e1221 ffeaea f0bcbc c3ccd6
// ⚠️⚠️ **WIN8S เป็นแบรนด์ขาออกทันที = เสี่ยงหลงเหลือสูงสุด** (ส้มเพลิง/ทอง/ครีมบนดำ):
// 1e0101 2a0a04 3b130b 5a2410 8a3a12 250604 140302 fdf0e6 e0bda4 f27a1a e5a92b c9d2dc
// 🚨 **คู่ที่ต้องสงสัยว่าพิมพ์ผิดก่อนเสมอ**: 0b7d28 0a5f1c 0f9b35 0c3a16 061f0c
// (สาธุ168) และ 116018 0b4a12 1a7d24 28c437 15401d 051409 (TEVA69) และ 002908 073c1a
// 0e5424 1e7033 35a043 3ddc4a 23823a (ZORO365) ↔ 046c4e / 03543c / 0c7c58 / 19a97c /
// 2fd49b · e8fbe4 b4d6ad eef7f0 9dc2a5 d7f0cd e6f7df f0ffeb ↔ e1fef3 / f0fdf7 /
// d2f3e4 / a3ddc3 **(เขียวจาง/ขาวอมเขียวใกล้กันมาก ต้องอ่านค่า)** ·
// e5a92b e9b53c e3bb45 e8c86a e0b03a ffd94a d4922c e3a712 ↔ e2b32a / 8a6508 ·
// 3c5b36 10280f 0b2a12 2d6b2f ↔ 0d3326 / 3f6f5c
// ⚠️ แดง/ทองของแบรนด์หวยเจ้าก่อนที่ต้อง grep ทีละค่า (ตระกูล *Huay มาจากที่นั่น):
// cd9a2c fdeb7c ab7314 fcd4c3 fce2d4 f5e7c8 (หวยคิง) · dc0409 f5363d 8e0206 f3c54e
// (หวยดีใจ) · dc0203 f5282a ffc93c ffeab0 8c0402 c08a07 (หวย365) · cf1111 e01f26
// 1a0709 2a0b0e 120406 (แบรนด์หวยเก่ากว่านั้น)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️⚠️ **รอบนี้ไม่มีแดง ไม่มีชมพู ไม่มีส้ม ไม่มีม่วง ไม่มีฟ้า/ไซแอน ไม่มีครีม/งาช้าง
// และไม่มีแรมป์เทาเงินบนการ์ดเนื้อหา** — ทองอำพัน e2b32a เป็น **พื้นถม/ออราเท่านั้น**
// บนผิวสว่าง (2.0:1) ส่วนทองที่ถือตัวอักษรได้คือ 8a6508 · ชุดไทยทอง-ครีม ผิวนักแสดง
// ผนังห้องขาวงาช้าง และยอดปรางค์ทองในอาร์ตเวิร์กเป็น **วัตถุในภาพ ไม่ใช่สี UI**
// ✅ LINE green 00B900 กับเขียว success ของฟีดถอนเงินอยู่ไฟล์อื่น **คงไว้ ห้ามกลืน
// เข้าเขียวมรกตของรอบนี้** — รอบนี้สับสนง่ายที่สุดเพราะแบรนด์ก็เป็นเขียว
//
// การ์ดถือ `text-left` ไว้เอง **ห้ามใส่ `text-center` บนการ์ดหรือบน <section>**
// เพราะมันจะ inherit ลงไปจัดกึ่งกลางย่อหน้าในสล็อตทั้งหมด (บั๊กที่เคยเกิดกับ
// ตระกูลนี้) ถ้าต้องการหัวข้อกึ่งกลาง ให้ใส่คลาสจัดตำแหน่งบน HeadingTag เอง —
// ซึ่งรอบนี้หัวข้อชิดซ้ายตามย่อหน้า
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-[2rem] border-2 border-[#a3ddc3] bg-white px-7 py-9 text-left text-base leading-relaxed text-[#0d3326] shadow-[0_12px_34px_rgba(13,51,38,0.10)] transition-all duration-500 hover:border-[#19a97c] hover:shadow-[0_16px_44px_rgba(4,108,78,0.18)] md:px-12 md:py-11">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-1.5 bg-gradient-to-r from-[#03543c] via-[#19a97c] to-[#03543c]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute inset-2.5 -z-10 rounded-[1.5rem] border border-dashed border-[#a3ddc3]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute top-1/2 -left-5 -z-10 h-10 w-10 -translate-y-1/2 rounded-full bg-[#e1fef3] shadow-[inset_0_0_0_1px_rgba(25,169,124,0.7)]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute top-1/2 -right-5 -z-10 h-10 w-10 -translate-y-1/2 rounded-full bg-[#e1fef3] shadow-[inset_0_0_0_1px_rgba(25,169,124,0.7)]"></div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -top-24 left-1/2 -z-10 h-44 w-72 -translate-x-1/2 rounded-full bg-[#2fd49b]/30 blur-[70px] transition-all duration-500 group-hover:bg-[#2fd49b]/45">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute right-8 -bottom-20 -z-10 h-36 w-36 rounded-full bg-[#e2b32a]/30 blur-[60px] transition-all duration-500 group-hover:bg-[#e2b32a]/45"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-dashed border-[#a3ddc3] pb-5">
          <span aria-hidden="true" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#a3ddc3] bg-[#d2f3e4] text-xl shadow-[0_0_14px_rgba(4,108,78,0.14)]">
            🎟️
          </span>
          <HeadingTag class={`bg-gradient-to-r from-[#03543c] via-[#046c4e] to-[#03543c] bg-clip-text text-left ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
