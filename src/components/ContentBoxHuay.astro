---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the two aura
// layers, and the slot renders as a direct child of the card. Do not re-add a
// `relative z-10` wrapper <div>.
//
// ธีม Huay แดง-ทอง-ดำ: ไฟล์นี้เป็นกล่องบทความของ /ตรวจหวย และ /แนวทาง เท่านั้น
// ไม่มีหน้าอื่นเรียกใช้ สองหน้านั้นคงธีมแดง-ทองของหมวดหวยไว้โดยตั้งใจตาม
// SKILL.md Phase 4.5 ข้อ 5 จึงไม่ถูกดึงไปเป็นรูปทรงของ ContentBox ตัวอื่น
// แต่ค่าสีถูกขยับมาใช้เลขจริงของ brand-spec §2 รอบนี้ เพื่อไม่ให้อ้างค่าคงที่ของ
// แบรนด์ก่อนหน้าต่อไป
//
// พื้นการ์ด #240406 ในกรอบทองลึก #c08a07 ที่สว่างขึ้นเป็นทอง #ffc93c ตอน hover
// หัวข้อไล่ทองอ่อน #ffeab0 → ทอง #ffc93c → แดงสว่าง #f5282a ออร่าสองมุมแยกด้วย
// คู่สีทอง-แดง เนื้อความ #f6e7e0 (= BRAND_TEXT) — ชุดเดิมของรอบ หวยเฮง789
// (#2b0909 #a8690c #f4bc5d #ffefc2 #dc2224 #e43434 #fbe3d4) ออกครบทุกจุดแล้ว
//
// การ์ดถือ `text-left` ไว้เอง อย่าเผลอใส่ `text-center` บนกล่องหรือ wrapper ใด
// ที่ครอบ <slot /> เพราะมันจะรั่วไปจัดกึ่งกลางย่อหน้าของทั้งหน้า ถ้าต้องการหัวข้อ
// กึ่งกลาง ให้ใส่บน HeadingTag เอง
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#c08a07]/45 bg-[#240406]/95 p-8 text-left text-base leading-relaxed text-[#f6e7e0] shadow-[0_10px_30px_rgba(8,1,1,0.6)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffc93c]/60 hover:shadow-[0_15px_40px_rgba(255,201,60,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#ffc93c]/25 blur-[50px] transition-all duration-500 group-hover:bg-[#ffc93c]/35">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#dc0203]/24 blur-[50px] transition-all duration-500 group-hover:bg-[#f5282a]/34">
    </div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#c08a07]/45 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffeab0] to-[#c08a07] shadow-[0_0_10px_rgba(255,201,60,0.55)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#ffeab0] via-[#ffc93c] to-[#f5282a] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
