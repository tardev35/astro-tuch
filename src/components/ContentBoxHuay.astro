---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the two aura
// layers, and the slot renders as a direct child of the card. Do not re-add a
// `relative z-10` wrapper <div>.
//
// LOTTOPLUS (รอบแดง-ทอง-ดำ 2026-09-29): ไฟล์นี้เป็นกล่องของหน้า /ตรวจหวย และ
// /แนวทาง (นำเข้าจากสองหน้า จึงอยู่ในชุด shared chrome ที่ orchestrator ดูแล)
// ธีม Huay คือแดง-ทองตามนิยามของมันเอง ซึ่งตรงกับแบรนด์นี้พอดี — โลโก้เป็น
// ตัวอักษรขาวบนบล็อกแดง #dc020e ล้อมด้วยลูกหวยแดง-ขาวและเหรียญทอง ค่าสีจึงสร้าง
// ใหม่จากพาเลตต์แบรนด์นี้ทั้งชุด พื้นการ์ดดำอมแดง #1f0a0c ในกรอบทองลึก #8a6a0a
// ที่สว่างขึ้นเป็นทองรอง #f3c623 ตอน hover หัวข้อไล่ทองอ่อน #fde79a → ทองรอง →
// แดงสว่าง #ff2d38 ตามลำดับทอง-แดงบนงานอาร์ต ออร่าสองมุมแยกด้วยคู่สีจริงของแบรนด์
// คือทองกับแดง เนื้อความ #f0e2e2 (BRAND_TEXT) — ชุดของ LOTTO24 รอบก่อน
// (#2a0405 #a16207 #fbbf24 #fde68a #dc2626 #fc2b2c #f6e2e2) ออกทั้งหมด
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#8a6a0a]/45 bg-[#1f0a0c]/95 p-8 text-left text-base leading-relaxed text-[#f0e2e2] shadow-[0_10px_30px_rgba(5,1,2,0.6)] backdrop-blur-xl transition-all duration-500 hover:border-[#f3c623]/60 hover:shadow-[0_15px_40px_rgba(243,198,35,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#f3c623]/25 blur-[50px] transition-all duration-500 group-hover:bg-[#f3c623]/35">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#dc020e]/24 blur-[50px] transition-all duration-500 group-hover:bg-[#ff2d38]/34">
    </div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#8a6a0a]/45 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fde79a] to-[#8a6a0a] shadow-[0_0_10px_rgba(243,198,35,0.55)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#fde79a] via-[#f3c623] to-[#ff2d38] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
