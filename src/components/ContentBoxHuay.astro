---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on every
// decorative absolute layer, and the slot renders as a direct child of the card.
// Do not re-add a `relative z-10` wrapper <div>.
//
// หวยคิง (รอบทองโลหะ + ครีมอมพีช บนดำอมน้ำตาล 2026-10-04): รอบนี้ไฟล์นี้ถูกเลือก
// เป็นกล่องคอลัมน์เดียวของทั้ง H1 หน้าแรก และสองหน้าหวย (/ตรวจหวย, /แนวทาง)
// จึงมีสามหน้าที่ render ตัวนี้ และต้องถือสีของแบรนด์ปัจจุบันเต็มชุด
//
// รูปทรงคือ "ใบสลาก": กรอบทองหนา + วงในเส้นประ + รอยปรุครึ่งวงกลมสองข้างกลางการ์ด
// + แถบหัวตั๋วไล่ทอง + เส้นประใต้หัวข้อ — ตั้งใจให้ต่างจาก ContentBox.astro
// (การ์ดโค้งเรียบ + ขีดใต้หัวข้อ) เพราะทั้งสองตัวอยู่หน้าเดียวกันในหน้าแรก
//
// สีตาม brand-spec §2: ทองแบรนด์ #cd9a2c ถือกรอบ ทองสว่าง #fdeb7c เป็นไฮไลต์
// ทองลึก #ab7314 เป็นปลายไล่เฉด สีรองครีมอมพีช #fcd4c3 ถือออร่ามุมขวาล่าง
// ผิวการ์ด #1c140b พื้นลึกสุด #0c0b0a ใช้เป็นเนื้อรอยปรุกับชิปไอคอน
// เนื้อความ #f5e7c8 (= BRAND_TEXT) glow เป็น rgba(205,154,44,…)
//
// ชุดแดง-ทองเดิม (#240406 #c08a07 #ffc93c #ffeab0 #f5282a #dc0203 #f6e7e0
// rgba(255,201,60) rgba(8,1,1)) ออกครบทุกจุดแล้ว
//
// การ์ดถือ `text-left` ไว้เอง อย่าเผลอใส่ `text-center` บนกล่องหรือ wrapper ใด
// ที่ครอบ <slot /> เพราะมันจะรั่วไปจัดกึ่งกลางย่อหน้าของทั้งหน้า ถ้าต้องการหัวข้อ
// กึ่งกลาง ให้ใส่บน HeadingTag เอง
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-[2rem] border-2 border-[#cd9a2c]/55 bg-[#1c140b]/95 px-7 py-9 text-left text-base leading-relaxed text-[#f5e7c8] shadow-[0_12px_34px_rgba(0,0,0,0.8)] transition-all duration-500 hover:border-[#fdeb7c]/80 hover:shadow-[0_16px_44px_rgba(205,154,44,0.28)] md:px-12 md:py-11">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-1.5 bg-gradient-to-r from-[#ab7314] via-[#fdeb7c] to-[#ab7314]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute inset-2.5 -z-10 rounded-[1.5rem] border border-dashed border-[#cd9a2c]/30"></div>
    <div aria-hidden="true" class="pointer-events-none absolute top-1/2 -left-5 -z-10 h-10 w-10 -translate-y-1/2 rounded-full bg-[#0c0b0a] shadow-[inset_0_0_0_1px_rgba(205,154,44,0.45)]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute top-1/2 -right-5 -z-10 h-10 w-10 -translate-y-1/2 rounded-full bg-[#0c0b0a] shadow-[inset_0_0_0_1px_rgba(205,154,44,0.45)]"></div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -top-24 left-1/2 -z-10 h-44 w-72 -translate-x-1/2 rounded-full bg-[#cd9a2c]/25 blur-[70px] transition-all duration-500 group-hover:bg-[#fdeb7c]/35">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute right-8 -bottom-20 -z-10 h-36 w-36 rounded-full bg-[#fcd4c3]/18 blur-[60px] transition-all duration-500 group-hover:bg-[#fce2d4]/28">
    </div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-dashed border-[#cd9a2c]/45 pb-5">
          <span aria-hidden="true" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#cd9a2c]/60 bg-[#0c0b0a] text-xl shadow-[0_0_14px_rgba(205,154,44,0.4)]">
            🎟️
          </span>
          <HeadingTag class={`bg-gradient-to-r from-[#fdeb7c] via-[#cd9a2c] to-[#fcd4c3] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
