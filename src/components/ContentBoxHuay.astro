---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the two aura
// layers, and the slot renders as a direct child of the card. Do not re-add a
// `relative z-10` wrapper <div>.
//
// 365LOTTO (รอบแดง-ทอง-เงินโครเมียม 2026-09-24): การ์ดนี้ถือ H1 ของหน้าแรก พื้นการ์ด
// เป็นแดงเข้มยกระดับ #2a0b0e ในกรอบทองลึก #9c6a12 ที่สว่างขึ้นเป็นทองหลัก #fadc64
// ตอน hover หัวข้อไล่ตามลำดับสีบนโลโก้จริง คือเลข 365 ทอง #fadc64 ต่อด้วยคำว่า
// LOTTO เงินโครเมียม #f3f6fa แล้วจบที่แดงแบรนด์ #e01f26 ของตัว O สองตัว แถบนำหน้า
// หัวข้อไล่ทองสว่าง #fdf3b4 → ทองลึก ส่วนออร่าสองมุมแยกด้วยคู่สีจริงของแบรนด์
// คือทองกับแดง — ชุดกรมท่า-ทองของหวยพยัคฆ์ (#030b1c #08152f #0f2149 #1c3566
// #dbe4f7 #9fb0d0 #e8eef8 #fadb6c #fdf5a4 #ab6d13) หายไปทั้งหมด
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#9c6a12]/45 bg-[#2a0b0e]/95 p-8 text-left text-base leading-relaxed text-[#f0ddc4] shadow-[0_10px_30px_rgba(18,4,6,0.55)] backdrop-blur-xl transition-all duration-500 hover:border-[#fadc64]/60 hover:shadow-[0_15px_40px_rgba(250,220,100,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#fadc64]/25 blur-[50px] transition-all duration-500 group-hover:bg-[#fadc64]/35"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#e01f26]/22 blur-[50px] transition-all duration-500 group-hover:bg-[#e01f26]/32"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#9c6a12]/45 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdf3b4] to-[#9c6a12] shadow-[0_0_10px_rgba(250,220,100,0.55)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#fadc64] via-[#f3f6fa] to-[#e01f26] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
