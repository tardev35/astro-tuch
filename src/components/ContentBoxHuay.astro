---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// หวยพยัคฆ์ (รอบกรมท่า-ทอง 2026-09-22): ข้อยกเว้น "หน้าหวยคงธีมแดง" ใน Phase 4.5
// ของ playbook ไม่มีผลกับรอบนี้ — ข้อยกเว้นนั้นมีไว้กันไม่ให้หน้าหวยโดนลากไปใช้สี
// ของแบรนด์คาสิโน แต่รอบนี้ทั้งเว็บ "คือ" เว็บหวย พาเลตต์กรมท่า-ทองจึงเป็นสีของ
// หน้าหวยเองอยู่แล้ว ไม่ใช่สีที่ยัดมาจากที่อื่น แดง LOTTOKA เดิมออกทั้งหมด
//
// ไฟล์นี้ใช้ร่วมกัน 3 หน้า: index (H1), /ตรวจหวย และ /แนวทาง — แก้ที่นี่ที่เดียว
// รูปทรงตั้งใจให้ต่างจาก ContentBox.astro ที่อยู่หน้าเดียวกัน: ตัวนี้เป็นแถบทอง
// แนวตั้งข้างหัวข้อบนพื้นกรมท่าสว่างกว่า #0f2149 ส่วน ContentBox เป็นหัวข้อ
// กึ่งกลางซ้ายพร้อมขีดใต้บนพื้นกรมท่าเข้ม #08152f
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#ab6d13]/45 bg-[#0f2149]/95 p-8 text-left text-base leading-relaxed text-[#dbe4f7] shadow-[0_10px_30px_rgba(3,11,28,0.55)] backdrop-blur-xl transition-all duration-500 hover:border-[#fadb6c]/60 hover:shadow-[0_15px_40px_rgba(250,219,108,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#fadb6c]/25 blur-[50px] transition-all duration-500 group-hover:bg-[#fadb6c]/35"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#e8eef8]/12 blur-[50px] transition-all duration-500 group-hover:bg-[#e8eef8]/20"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#ab6d13]/45 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdf5a4] to-[#ab6d13] shadow-[0_0_10px_rgba(250,219,108,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#e8eef8] via-[#fadb6c] to-[#ab6d13] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
