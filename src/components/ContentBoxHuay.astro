---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#2c4d84]/40 bg-[#04122b]/95 p-8 text-left text-base leading-relaxed text-[#d5e3f7] shadow-[0_10px_30px_rgba(223,180,85,0.14)] backdrop-blur-xl transition-all duration-500 hover:border-[#dfb455]/55 hover:shadow-[0_15px_40px_rgba(223,180,85,0.24)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#dfb455]/25 blur-[50px] transition-all duration-500 group-hover:bg-[#dfb455]/35"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#12508f]/45 blur-[50px] transition-all duration-500 group-hover:bg-[#12508f]/60"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#2c4d84]/35 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f7d979] to-[#a87a1e] shadow-[0_0_10px_rgba(223,180,85,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#f7d979] via-[#dfb455] to-[#a87a1e] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
