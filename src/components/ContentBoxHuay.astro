---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the two aura
// layers, and the slot renders as a direct child of the card. Do not re-add a
// `relative z-10` wrapper <div>.
//
// รอบนี้ไฟล์นี้ถูกเรียกจากสองหน้าเท่านั้น คือ /ตรวจหวย กับ /แนวทาง ซึ่งเป็น
// ข้อยกเว้น "หน้าหวยคงธีม Huay" ของ Phase 4.5 — หน้าอื่นทั้งเว็บใช้ ContentBox,
// ContentBoxPremium และ ContentBoxNeumorphism ของพาเลตต์เขียว-ทองหลัก
//
// 888PARUAY (รอบทอง-แดง 2026-09-24): ธีม Huay คือแดง-ทองตามนิยามของมันเอง จึงไม่
// ถูกบังคับไปใช้พื้นเขียวของหน้าอื่น แต่ค่าสีสร้างใหม่จากพาเลตต์แบรนด์นี้ทั้งหมด
// พื้นการ์ดแดงเกือบดำ #240808 ในกรอบทองลึก #a87d0c ที่สว่างขึ้นเป็นทองหลัก
// #fcdc2b ตอน hover หัวข้อไล่ตามลำดับสีบนโลโก้จริง คือวงแหวนทองอ่อน #fff6ae
// ต่อด้วยทองหลัก #fcdc2b แล้วจบที่แดงแบรนด์ #cf1111 ของคำว่า PARUAY แถบนำหน้า
// หัวข้อไล่ทองอ่อน → ทองลึก ออร่าสองมุมแยกด้วยคู่สีจริงของแบรนด์คือทองกับแดง
// เนื้อความ #e8e4c6 — ชุดของ 365LOTTO (#fadc64 #fdf3b4 #9c6a12 #e01f26 #f0ddc4
// #1a0709 #2a0b0e #f3f6fa) และชุดกรมท่า-ทองของหวยพยัคฆ์ (#030b1c #08152f
// #0f2149 #1c3566 #dbe4f7 #9fb0d0 #e8eef8 #fadb6c #fdf5a4 #ab6d13) หายไปทั้งหมด
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#a87d0c]/45 bg-[#240808]/95 p-8 text-left text-base leading-relaxed text-[#e8e4c6] shadow-[0_10px_30px_rgba(20,4,4,0.55)] backdrop-blur-xl transition-all duration-500 hover:border-[#fcdc2b]/60 hover:shadow-[0_15px_40px_rgba(252,220,43,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#fcdc2b]/25 blur-[50px] transition-all duration-500 group-hover:bg-[#fcdc2b]/35"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#cf1111]/22 blur-[50px] transition-all duration-500 group-hover:bg-[#cf1111]/32"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#a87d0c]/45 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fff6ae] to-[#a87d0c] shadow-[0_0_10px_rgba(252,220,43,0.55)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#fff6ae] via-[#fcdc2b] to-[#cf1111] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
