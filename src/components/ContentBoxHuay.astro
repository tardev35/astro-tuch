---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the two aura
// layers, and the slot renders as a direct child of the card. Do not re-add a
// `relative z-10` wrapper <div>.
//
// LOTTO24 (รอบแดง-ทอง-ดำ 2026-09-28): รอบนี้ไฟล์นี้เป็นกล่องที่แบก H1 ของหน้าแรก
// ธีม Huay คือแดง-ทองตามนิยามของมันเอง ซึ่งตรงกับแบรนด์นี้พอดี — โลโก้อ่านว่า LOTTO
// เป็นโครเมียมขาวแล้วปิดด้วย 24 สีแดง ล้อมด้วยลูกหวยแดง-ขาวและเหรียญทอง ค่าสีจึง
// สร้างใหม่จากพาเลตต์แบรนด์นี้ทั้งชุด พื้นการ์ดแดงเกือบดำ #2a0405 ในกรอบทองลึก
// #a16207 ที่สว่างขึ้นเป็นทองหลัก #fbbf24 ตอน hover หัวข้อไล่ทองอ่อน #fde68a →
// ทองหลัก → แดงสว่าง #fc2b2c ตามลำดับทอง-แดงบนงานอาร์ต แถบนำหน้าหัวข้อไล่ทองอ่อน
// → ทองลึก ออร่าสองมุมแยกด้วยคู่สีจริงของแบรนด์คือทองกับแดง เนื้อความ #f6e2e2
// (BRAND_TEXT) — ชุดของ 888PARUAY (#fcdc2b #fff6ae #a87d0c #cf1111 #240808 #e8e4c6)
// และชุด 365LOTTO (#fadc64 #fdf3b4 #9c6a12 #e01f26 #f0ddc4 #1a0709 #2a0b0e #f3f6fa)
// ออกทั้งหมด
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#a16207]/45 bg-[#2a0405]/95 p-8 text-left text-base leading-relaxed text-[#f6e2e2] shadow-[0_10px_30px_rgba(10,1,1,0.6)] backdrop-blur-xl transition-all duration-500 hover:border-[#fbbf24]/60 hover:shadow-[0_15px_40px_rgba(251,191,36,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#fbbf24]/25 blur-[50px] transition-all duration-500 group-hover:bg-[#fbbf24]/35">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#dc2626]/24 blur-[50px] transition-all duration-500 group-hover:bg-[#fc2b2c]/34">
    </div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#a16207]/45 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fde68a] to-[#a16207] shadow-[0_0_10px_rgba(251,191,36,0.55)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#fde68a] via-[#fbbf24] to-[#fc2b2c] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
