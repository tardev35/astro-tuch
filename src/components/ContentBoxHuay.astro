---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// ตระกูล Huay เป็นธีมแดงของหน้าหวย (/ตรวจหวย, /แนวทาง) โดยเจตนา ตาม Phase 4.5
// ของ playbook — หน้าหวยไม่ถูกบังคับให้ใช้พาเลตต์ทองของแบรนด์หลัก จึงคงแดง
// เลือดหมูเข้ม #3a0709 บนพื้นดำ ออร่าสองมุมแดงโลโก้กับขาวนวลไว้ตามเดิม
// สิ่งที่ไม่ยกเว้นคือชื่อแบรนด์ — ทุกจุดที่เอ่ยชื่อต้องเป็น MHEEPOOH168
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#c21e22]/45 bg-[#3a0709]/95 p-8 text-left text-base leading-relaxed text-[#ded9da] shadow-[0_10px_30px_rgba(194,30,34,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#e2353a]/60 hover:shadow-[0_15px_40px_rgba(226,53,58,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#e2353a]/25 blur-[50px] transition-all duration-500 group-hover:bg-[#e2353a]/35"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#ffe9ea]/12 blur-[50px] transition-all duration-500 group-hover:bg-[#ffe9ea]/20"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#c21e22]/45 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ff8a8d] to-[#7d1114] shadow-[0_0_10px_rgba(226,53,58,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe9ea] via-[#ff8a8d] to-[#c21e22] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
