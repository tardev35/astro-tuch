---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt = "โลโก้ MHEEPOOH168 ตัวอักษร MHEEPOOH แบบสามมิติสีทองไล่เฉดขอบแดงเข้ม วางเรียงเป็นแนวโค้งขึ้น ใต้ลงมาเป็นตัวเลข 168 สีขาวเงินขอบแดงขนาดใหญ่";

// มีลิงก์ /ตรวจหวย และ /แนวทาง ในคอลัมน์ลิงก์ด่วน — MHEEPOOH168 ขายหวยเป็น
// หนึ่งในสี่หมวดหลักตั้งแต่ H1 ของบรีฟ และทั้งสองหน้าอยู่ใน src/pages/ จริง
// จึงเป็น route ที่มีอยู่ ไม่ใช่ href ตายที่ verify-build.mjs จะทำให้ build แดง
//
// /ทางเข้า ยังมีลิงก์อยู่ตรงนี้: หน้านั้นยัง route และ index อยู่ แค่ไม่มีใน
// เมนู navbar เพราะ toggle ของ register/login เปิด (ดู NavbarStyle10.astro)
//
// พาเลตต์ MHEEPOOH168 เป็นคู่สีทอง-แดงตามโลโก้ จึงแบ่งหน้าที่ด้วยสองแกน:
// ทองกลาง #f5b70a เป็นเส้นคั่น จุดนำลิงก์ และขอบการ์ด · ทองสว่าง #fced74
// สงวนไว้ให้หัวคอลัมน์ ชื่อแบรนด์ และปุ่มสมัครสมาชิก · ทองเข้ม #8a5a06 เป็น
// ปลายเกรเดียนต์ · แดงเลือดหมู #540202 กับแดงสด #c4161c เป็นพื้นยกและขอบ
// พื้นหลักเป็นดำอมแดง #120303 — โทนทองล้วนของแบรนด์ก่อนหายไปทั้งหมด
---

<footer class="relative mt-32 w-full border-t border-[#f5b70a]/50 bg-[#120303] pt-64 pb-6 font-sans text-[#f1dccd] shadow-[0_-10px_30px_rgba(245,183,10,0.18)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#f5b70a]/70 bg-gradient-to-r from-[#120303] via-[#540202] to-[#120303] p-6 shadow-[0_15px_40px_rgba(196,22,28,0.35)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#fced74] uppercase italic drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)] md:text-3xl">
        <span aria-hidden="true">👑</span> พร้อมเข้าเล่นคาสิโนเกมครบทุกหมวดกับ {BRAND_NAME} แล้วหรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#f1dccd]/90 md:text-base">
        สมัคร {BRAND_NAME} ได้ด้วยตนเองทั้งบนมือถือและคอมพิวเตอร์ เลือกเล่นได้ทั้งบาคาร่า สล็อต หวย และบอลจากบัญชีเดียว ระบบจัดหมวดหมู่เกมไว้ชัดเจน พร้อมช่องทางธนาคารและวอลเลทที่เปิดรองรับในเว็บไซต์
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#f5b70a] bg-gradient-to-b from-[#fced74] to-[#8a5a06] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#2b0101] shadow-[0_0_15px_rgba(252,237,116,0.4)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🚀</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#c4161c] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[100, 200, 300]}
                sizes="100px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(196,22,28,0.6)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-b from-[#fced74] to-[#8a5a06] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(245,183,10,0.55)]">{BRAND_NAME}</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#d9bfae]">
          {BRAND_NAME} คือเว็บรวมคาสิโนเกมที่รวบรวมความบันเทิงหลายรูปแบบไว้ในระบบเดียว ทั้งบาคาร่า สล็อต หวย และบอล โดยแต่ละประเภทถูกแยกเป็นเมนูอย่างชัดเจน
          สามารถสลับรูปแบบการเล่นได้จากบัญชีเดียว พร้อมตัวเลือกจากหลายค่ายและหลายตลาด ใช้งานได้ทั้งบนมือถือและคอมพิวเตอร์ผ่านเบราว์เซอร์โดยไม่ต้องติดตั้งโปรแกรมเพิ่ม
          พร้อมแอดมินคอยให้บริการตลอด 24 ชั่วโมง
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/30 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.1)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>
        </div>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">
                  📍
                </span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a
                  href={`mailto:${BRAND_ADDRESS.email}`}
                  class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">
                    ✉️
                  </span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }
      </div>

      <div class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#fced74] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#8a5a06] to-[#fced74] shadow-[0_0_8px_rgba(245,183,10,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          <a href="/" class="group flex items-center text-[#d9bfae] transition-colors hover:text-[#fced74]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#f5b70a] transition-transform group-hover:rotate-45"></span> หน้าแรก
          </a>
          <a href="/promotion" class="group flex items-center text-[#d9bfae] transition-colors hover:text-[#fced74]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#f5b70a] transition-transform group-hover:rotate-45"></span> โปรโมชั่นสมาชิก
          </a>
          <a href="/ตรวจหวย" class="group flex items-center text-[#d9bfae] transition-colors hover:text-[#fced74]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#f5b70a] transition-transform group-hover:rotate-45"></span> ตรวจหวย
          </a>
          <a href="/แนวทาง" class="group flex items-center text-[#d9bfae] transition-colors hover:text-[#fced74]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#f5b70a] transition-transform group-hover:rotate-45"></span> แนวทางหวย
          </a>
          <a href="/ทดลองเล่น" class="group flex items-center text-[#d9bfae] transition-colors hover:text-[#fced74]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#f5b70a] transition-transform group-hover:rotate-45"></span> ทดลองเล่น
          </a>
          <a href="/ทางเข้า" class="group flex items-center text-[#d9bfae] transition-colors hover:text-[#fced74]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#f5b70a] transition-transform group-hover:rotate-45"></span> ทางเข้าล่าสุด
          </a>
          <a href="/about-us" class="group flex items-center text-[#d9bfae] transition-colors hover:text-[#fced74]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#f5b70a] transition-transform group-hover:rotate-45"></span> เกี่ยวกับเรา
          </a>
          <a href="/register" class="group flex items-center text-[#d9bfae] transition-colors hover:text-[#fced74]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#f5b70a] transition-transform group-hover:rotate-45"></span> สมัครสมาชิก
          </a>
          <a href="/login" class="group flex items-center text-[#d9bfae] transition-colors hover:text-[#fced74]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#f5b70a] transition-transform group-hover:rotate-45"></span> เข้าสู่ระบบ
          </a>
          <a href="/contact-us" class="group flex items-center text-[#d9bfae] transition-colors hover:text-[#fced74]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#f5b70a] transition-transform group-hover:rotate-45"></span> ติดต่อแอดมิน
          </a>
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#fced74] uppercase">
          ระบบการเงิน
          <span class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#8a5a06] to-[#fced74] shadow-[0_0_8px_rgba(245,183,10,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#d9bfae]">รองรับช่องทางธนาคารและวอลเลทที่กำหนดไว้ภายในเว็บไซต์ โดยควรใช้บัญชีชื่อเดียวกับข้อมูลที่ผูกไว้ตอนสมัคร</p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-white/5 bg-[#2b0101] transition-colors hover:border-[#f5b70a]/60" title="ตรวจสอบรายการฝากถอนย้อนหลัง">
          <span class="flex items-center gap-1 text-xs font-bold text-[#f1dccd]"><span aria-hidden="true" class="text-lg text-[#f5b70a]">🧾</span> ตรวจสอบสถานะธุรกรรมได้ในบัญชีสมาชิก</span>
        </div>
      </div>
    </div>

    <hr class="mb-6 border-[#2b0101]" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#d9bfae] md:block">
      {BRAND_NAME} เป็นช่องทางสำหรับผู้ที่ต้องการเข้าเล่นเกมคาสิโนออนไลน์หลายประเภทผ่านบัญชีเดียว ทั้งบาคาร่า สล็อต หวย และบอล โดยจัดหมวดหมู่ไว้เพื่อให้สมาชิกค้นหาและสลับประเภทได้สะดวก
      สำหรับคำว่า “ครบวงจร” “ไม่จำกัด” “ปลอดภัย 100%” และ “รองรับทุกธนาคารและวอลเลท” ควรยึดข้อมูลผู้ให้บริการหรือรายละเอียดที่สามารถตรวจสอบได้บนเว็บไซต์เป็นหลัก
      เนื่องจากขั้นต่ำและช่วงเดิมพันของแต่ละเกมอาจไม่เท่ากัน ผลลัพธ์ของเกมเป็นไปตามระบบของแต่ละเกม และอัตราการชนะ (RTP) เป็นค่าทางสถิติระยะยาว จึงไม่สามารถรับประกันได้ว่าเกมใดจะสร้างกำไรได้ทุกครั้ง
      กติกา อัตราจ่าย ช่วงเดิมพันขั้นต่ำและสูงสุด ให้ยึดค่าที่ระบบแสดง ณ เวลาทำรายการ ช่องทางธนาคารและวอลเลทที่เปิดรองรับก็เช่นกัน
      ควรตรวจสอบจากหน้าฝากถอนก่อนทำรายการ เนื่องจากช่องทางแต่ละประเภทอาจกำหนดยอดขั้นต่ำ วงเงิน หรือเงื่อนไขแตกต่างกัน ก่อน Login หรือทำรายการฝากเงิน ควรตรวจสอบว่ากำลังใช้งานช่องทางของผู้ให้บริการที่ถูกต้อง
      ตั้งรหัสผ่านที่คาดเดายาก และไม่เปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น โปรโมชั่นคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% มีวิธีคำนวณ รอบรับสิทธิ์ และข้อกำหนดในการถอนกำกับอยู่
      แนะนำให้อ่านรายละเอียดล่าสุดก่อนกดรับทุกครั้ง สำหรับหน้าตรวจหวยและแนวทางเป็นข้อมูลประกอบการตัดสินใจเท่านั้น ไม่ใช่การรับประกันผลรางวัล
      ใช้งานได้ทั้ง Android iOS และคอมพิวเตอร์ผ่านเบราว์เซอร์โดยไม่ต้องติดตั้งโปรแกรมเพิ่ม พร้อมแอดมิน {BRAND_NAME} ตรวจสอบรายการให้ตลอด 24 ชั่วโมง
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-white/5 pt-6 text-xs text-[#d9bfae] md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-[#fced74] uppercase">{BRAND_NAME}</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/terms/" class="transition-colors hover:text-[#fced74]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#fced74]">นโยบายความเป็นส่วนตัว</a>

        <a
          href="#top"
          class="flex h-8 w-8 items-center justify-center rounded border border-white/10 bg-white/5 text-[#f1dccd] transition-all hover:border-[#f5b70a] hover:bg-[#2b0101] hover:shadow-[0_0_15px_rgba(245,183,10,0.55)]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
