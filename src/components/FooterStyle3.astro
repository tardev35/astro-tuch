---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// เขียนจาก src/assets/logo.webp ของดรอป 2026-10-24 จริง (เปิดอ่านด้วย Read ก่อนเขียน)
// ไม่ใช่คัดลอกของรอบก่อน — หัวมังกรจีนทอง คำว่า "พักยก" ทองไล่เฉด และเลข 168
// โครเมียมเงินของ พักยก168 ที่เคยอยู่บรรทัดนี้ไม่มีในรูปรอบนี้เลย และเวิร์ดมาร์ก
// เจลแดงที่มีมงกุฎทองของ สล็อต168 (แบรนด์ขาออกรอบนี้) ก็ไม่มีเช่นกัน
const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส ทางซ้ายเป็นลูกหมูการ์ตูนสีชมพูอ้วนกลม หลับตายิ้มกว้าง มีปีกนางฟ้าสีขาวคู่หนึ่งกางออกจากหลัง และมีเส้นลมสั้นๆ สีชมพูลากอยู่ด้านหลังให้ดูเหมือนกำลังเหินไปข้างหน้า ทางขวาเป็นคำว่า หมูบิน ตัวอักษรไทยทรงบับเบิลสามมิติผิวมันวาว พยางค์แรกเป็นสีชมพูบานเย็น พยางค์หลังเป็นสีขาวมุก ต่อท้ายด้วยเลข 168 ทรงบับเบิลสีชมพูบานเย็น และมีรูปหัวใจสีชมพูขนาดเล็กลอยประดับอยู่เหนือตัวอักษร`;

// หมูบิน168 (รอบแคนดี้ชมพู-ขาวมุก บน **ธีมสว่าง** 2026-10-24): footer ที่ใช้งานจริง
// รอบนี้ — รอบก่อน (สล็อต168) ใช้ Footer.astro ตัวฐาน เหตุผลที่เลือกไฟล์นี้คือ "ทรง"
// ไม่ใช่สี: Footer / FooterPremium / FooterPremiumSumo / FooterHuay เป็นแผ่น
// rounded-t-[3rem] + ออราเรืองแสงเบลอคร่อมขอบบน กริด 12 คอลัมน์ ส่วน FooterStyle2
// เป็นแผ่นแบนขอบบนเส้นหนา กริด 4 คอลัมน์เท่ากัน ไฟล์นี้เป็น **การ์ด CTA ลอยคร่อม
// ขอบบน** (-top-14 / md:-top-16) แล้วตัวแผ่นเว้น pt-64 (md:pt-40) ไว้รับ และมี
// **BankStrip** อยู่ในคอลัมน์ช่องทางทำรายการ — เป็นทรงเดียวในไลบรารีที่ไม่ซ้ำกับ
// ทั้งสองกลุ่มนั้น
//
// ของเดิมที่ค้างอยู่ในไฟล์เป็นทองมังกรนำ-โครเมียมเงินรองของ พักยก168 (eeae12 fded41
// 9f600d 1f0f04 4e2f11 f4ead6 e0e0df และ rgba 238/174/18 α) rgba 253/237/65 α))
// ก่อนหน้านั้นเป็นชมพูบานเย็นของ มีทรัพย์168 (dd1b74 a4186b 4a0d35 2d0720 f7dcf6
// f0ccf5) แดงชาด-ทองเนยของ มีเฮ168 (fb1b32 ff8f9c 5c0410 fcd45c ffeec0 6b4a08)
// ทองนำ-ชมพูฟูเชียของ มีโชค168 (fcd434 ffeaa0 f5469f ff8dc6 8c0f52) และแดงมังกร-
// โครเมียมขาวของ GT66B (fb141b ff5f63 ffa0a2 8a0609 fdfcfd eceaea) — ย้ายทั้งไฟล์
// มาเป็นแคนดี้ชมพูของรอบนี้แล้ว **ไม่เหลือทอง ไม่เหลือแดง และไม่เหลือเทาเงิน**
// (เขียนเฮกซ์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีแบรนด์เก่าสะดุดที่คอมเมนต์นี้)
//
// ⚠️⚠️ **กับดักรอบนี้คือชมพู** — สามในสี่แบรนด์ที่เคยค้างอยู่ในไฟล์นี้ก็เป็นชมพู
// (dd1b74 a4186b ของ มีทรัพย์168 · f5469f ff8dc6 8c0f52 ของ มีโชค168 · ff8fc9…
// ของ มีเฮ168) การเจอชมพูที่ไหนจึงไม่พิสูจน์อะไรเลย ต้องเทียบเป็น "ค่า" ทีละตัวกับ
// .claude/brand-spec-moobin168.md §2 — ค่าของรอบนี้คือ **#fa539c #c2185b #8e0f41
// #fb8cc0 #fdc6c3** เท่านั้น
// ⚠️⚠️ **f5469f (มีโชค168) ห่างจาก #fa539c แค่ R5/G13/B3 และ 8c0f52 (มีโชค168)
// ห่างจาก #8e0f41 แค่ R2/B17 — ใกล้ที่สุดในลิสต์ ถ้า grep เจอแปลว่าพิมพ์ผิด**
// ⚠️⚠️ **มีทรัพย์168 เป็นเจ้าเดียวที่เดินหมูการ์ตูนชมพูเหมือนรอบนี้** ตัวแยกคือ
// หมูของเขา **สวมหน้ากากโจร** บนพื้น **แมเจนต้าเข้มธีมมืด** ส่วนหมูของเรา
// **มีปีกนางฟ้าสีขาวกับหัวใจ** บนธีม **แคนดี้พื้นสว่าง** — ห้ามใส่หน้ากาก/ถุงเงิน
//
// footer เป็น "โครม" จึงประกาศสีตัวอักษรของตัวเองครบทุกจุด ไม่ได้ inherit BRAND_TEXT
// ⚠️⚠️ **พื้นเพจรอบนี้เป็นชมพูพาสเทล #ffe5ff (จาก bg.json) = ธีมสว่าง** ซึ่ง
// **กลับทิศจากรอบก่อนทั้งเว็บ** แต่ footer ยังเป็น **พลัมเข้ม #3b0b26 โดยตั้งใจ**:
// หัว-ท้ายเข้มคร่อมเนื้อหาสว่างคือกรอบที่อ่านง่าย และเป็นเงื่อนไขที่ทำให้บล็อก
// <address> ข้างล่าง (border-white/15 + bg-black/20) ลงตัวโดยไม่ต้องแก้สักตัวอักษร
// **ห้าม "แก้" footer ให้สว่างตามพื้นเพจ**
//
// แกนสีที่ใช้ (brand-spec §2): พื้นผิวจม #3b0b26 ยกระดับด้วย #54123a เส้นคั่น #7a2350 ·
// **ชมพูแกน #fa539c (ตัวอักษร "หมูบิน168" และหัวใจบนโลโก้) เป็นเส้นใต้หัวคอลัมน์
// ขอบ เส้นคั่น พื้นถมปุ่ม และหัวการ์ด CTA** · ชมพูเข้ม #c2185b เป็นปลายเย็นของ
// ไล่เฉดและเงา · หมึก #ffe9f5 เป็นเนื้อความ (14.6:1 บน #3b0b26 · 11.0:1 บน #54123a) ·
// ชมพูอ่อน #fb8cc0 เป็นหัวคอลัมน์ ชื่อแบรนด์ และสี hover ของลิงก์ ·
// พีช #fdc6c3 เป็นสีประกอบบนจุดนำลิงก์ฝั่งขวาและปลายไล่เฉดของเวิร์ดมาร์ก
//
// ⚠️⚠️ **#c2185b ถือตัวอักษรบนพื้นพลัมไม่ได้** (2.9:1 บน #3b0b26) ในไฟล์นี้ชมพูเข้ม
// จึงเป็น **พื้นถม / ขอบ / เงาเท่านั้น** ส่วน **#fa539c ถือตัวอักษรได้จริง**
// (5.3:1 บน #3b0b26 · 4.0:1 บน #54123a จึงใช้บนพื้นจมเท่านั้น) และ **#fb8cc0
// ถือได้ทุกชั้น** (8.6:1 บน #3b0b26 · 6.5:1 บน #54123a) หัวคอลัมน์จึงใช้ #fb8cc0
// ปุ่มพื้นชมพูใช้หมึก **พลัมเกือบดำ #3b0b26** — บน #fb8cc0 ≈ 7.9:1 · บน #fa539c
// ≈ 5.3:1 · บน #f04b94 ≈ 4.9:1 ผ่าน AA ทุก stop
// 🚨 **ห้ามพลิกไปใช้หมึกขาวบนพื้นชมพู** (ขาวบน #fa539c เหลือแค่ 3.2:1)
// พื้นที่รับหมึกขาวได้จริงต้องเป็น #c2185b (5.9:1) ลงไปเท่านั้น
// rgba() ที่อนุญาตรอบนี้: rgba(250,83,156,α) · rgba(251,140,192,α) ·
// rgba(194,24,91,α) · rgba(59,11,38,α)
// ⚠️ รอบนี้ **ไม่มีทอง ไม่มีเหลือง ไม่มีส้ม ไม่มีแดง ไม่มีฟ้า/น้ำเงิน ไม่มีม่วง
// ไม่มีเขียว ไม่มีครีม/เบจ ไม่มีเทาเงิน** — เขียว #00B900 บนปุ่ม LINE เป็น
// **สีซีแมนติกของแบรนด์ LINE ไม่ใช่สีของเว็บ** จึงคงไว้ตามเดิม เช่นเดียวกับโลโก้
// ธนาคารจริงใน BankStrip (ไฟล์นั้นไม่มีสีแบรนด์อยู่เลย **sweep สีต้องข้ามทั้งไฟล์**)
//
// คอปปี้ทั้งไฟล์เขียนใหม่จากบรีฟ หมูบิน168 (src/assets/content.txt) ซึ่งแกนคือ
// **"เกมสล็อตแท้ เว็บตรงถูกลิขสิทธิ์" — โปรโมชั่นฝากรับโบนัสได้ทั้งวันไม่ต้องทำเทิร์น
// คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% สมัคร 3 ขั้นตอน ฝากถอนทุกธนาคารและทรูมันนี่
// และแอดมิน 24ชม.**
// ⚠️ **คำของ สล็อต168 รอบก่อนทันที ที่ถอดออกครบแล้วและห้ามใส่กลับ**:
// "ระบบสล็อตเว็บนอก" · "ทางเข้าแท้" · "ไม่ผ่านเอเย่นต์100%" · "ฐานเกมหลัก" ·
// "ยอดเข้าบริษัทแม่โดยตรง" · "จ่ายสูง โบนัสเพียบ"
// ⚠️ **คำของ พักยก168 ที่ค้างอยู่ในไฟล์นี้ก่อน retheme**: "โหมดทดลองเล่นฟรี" ·
// "ไม่ใช้บัญชีม้า" · "ไม่ผ่านม้า" · "เกมที่ใช้สัญลักษณ์พิเศษ" — ถอดออกแล้วทั้งหมด
// ⚠️ **คำของรอบเก่ากว่านั้น**: "เบทต่ำ" "สบายเป๋า" (สบาย168) · "ลิขสิทธิ์แท้
// นำเข้าตรงจากสิงคโปร์" (มีโชค168) · "ระบบดูแลการเงิน" (มีทรัพย์168) ·
// "ไฮโล ยิงปลา หวย ฟุตบอล บาคาร่า" และคำหวยทุกคำ
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกมแม้แต่รายเดียว** ไม่ได้ระบุเลขใบอนุญาต
// ชื่อหน่วยงานกำกับ ชื่อนิติบุคคล ยอดขั้นต่ำเป็นตัวเลข ค่า RTP จำนวนสมาชิก
// หรือปีก่อตั้งไว้เลย จึงไม่มีในข้อความนี้
// ตัวเลขที่ใช้ได้มีแค่ **0.3% · 0.8% · 3 ขั้นตอน · 24ชม.**
// ⚠️ บรีฟ "ตั้งคำถามกับคำโฆษณาของตัวเอง" และประโยคกำกับพวกนั้นต้องขนมาด้วย ห้าม
// ตัดทิ้งเพราะฟังดูไม่ขายของ: คำกล่าวอ้างเกี่ยวกับการเป็นเว็บตรงและเกมถูกลิขสิทธิ์
// ควรตรวจสอบจากข้อมูลผู้พัฒนาและหลักฐานการได้รับอนุญาตที่เชื่อถือได้ · ควรตรวจสอบว่า
// โบนัสประเภทใดได้รับการยกเว้นข้อกำหนดยอดเดิมพัน · เครดิตคืนยอดเสียไม่ได้หมายความว่า
// จะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งต่อไป · แม้จะมีข้อความว่า
// ไม่จำกัด แต่ควรยืนยันจำนวนบัญชีที่เข้าร่วมได้ · ควรตรวจสอบเวลาการให้บริการจริง
// จากประกาศล่าสุดอีกครั้ง
//
// ลิงก์: หมูบิน168 เป็นเว็บสล็อต ไม่ใช่เว็บหวย — /ตรวจหวย กับ /แนวทาง อยู่ใน
// src/pages-disabled/ รอบนี้ จึงไม่มีสองลิงก์นั้นในคอลัมน์ลิงก์ด่วน ไม่งั้น
// verify-build.mjs จะทำให้ build แดงเพราะ href ชี้ไป route ที่ไม่มีใน dist/
// ถ้ารอบหน้าเป็นแบรนด์หวยแล้วย้ายไฟล์กลับเข้า src/pages/ ต้องเพิ่มสองลิงก์นี้คืน
//
// /register กับ /login รอบนี้เป็นหน้าปุ่มจริงที่ index ได้ (toggle cta เปิด) ส่วน
// /ทางเข้า ถูกถอดออกจากเมนู navbar รอบนี้ แต่ route ยังมีจริงและยัง index อยู่
// ลิงก์จาก footer จึงยังถูกต้องทั้งสามหน้า (ดู NavbarStyle8.astro)
//
// หน้าต่างครอปโลโก้: logo.webp รอบนี้เป็นภาพจัตุรัส 500x500 และเนื้อโลโก้จริงกินแถว
// 180..310 = 36.0%..62.0% ของความสูง ที่ความกว้าง 180px จึงตกอยู่ที่ 65..112px
// หน้าต่างจึงเป็น h-[58px] คู่กับ -translate-y-[59px] (แสดงแถว 59..117) ซึ่งครอบเนื้อ
// โลโก้ได้ครบโดยเหลือขอบบน 6px ล่าง 5px — **ค่าคู่นี้ผูกกับสัดส่วนของโลโก้ดรอปนี้
// ห้ามคัดลอกข้ามรอบ** ของเดิมคือ h-[66px]/-52px ซึ่งจะตัดปีกหมูด้านบนทิ้ง
//
// บล็อก <address> ตั้งใจไม่ทาสีแบรนด์ — border-white/15 + bg-black/20 + opacity
// บนสีตัวอักษรที่ inherit มา ลงตัวกับ footer ทุกตัวในไลบรารี ห้าม retheme
---

<footer
  class="relative mt-32 w-full border-t border-[#fa539c]/55 bg-[#3b0b26] pt-64 pb-6 font-sans text-[#ffe9f5] shadow-[0_-10px_30px_rgba(250,83,156,0.28)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-3xl border border-[#fa539c]/60 bg-gradient-to-r from-[#54123a] via-[#3b0b26] to-[#54123a] p-6 shadow-[0_15px_40px_rgba(59,11,38,0.7)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#fb8cc0] drop-shadow-[0_2px_4px_rgba(59,11,38,0.8)] md:text-3xl">
        <span aria-hidden="true">🐷</span> พร้อมเริ่มเล่นเกมสล็อตกับ {BRAND_NAME} แล้วหรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#ffe9f5]/90 md:text-base">
        สมัคร {BRAND_NAME} ได้ด้วยตนเองผ่านมือถือ โดยตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง อ่านเงื่อนไขการเปิดบัญชีและนโยบายการจัดเก็บข้อมูลส่วนบุคคล แล้วกรอกข้อมูลตามที่ระบบกำหนดก่อนยืนยันบัญชี
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#c2185b] bg-gradient-to-b from-[#fd8fc2] to-[#fa539c] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#3b0b26] shadow-[0_0_15px_rgba(250,83,156,0.5)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">📝</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#54123a] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <span class="block h-[58px] w-[180px] overflow-hidden">
                <Picture
                  src={mainLogo}
                  alt={logoAlt}
                  widths={[180, 360]}
                  sizes="180px"
                  loading="lazy"
                  decoding="async"
                  class="h-auto w-full -translate-y-[59px] drop-shadow-[0_0_12px_rgba(250,83,156,0.65)]"
                  formats={["avif", "webp"]}
                  fallbackFormat="webp"
                  quality={72}
                />
              </span>
            ) : (
              <p class="bg-gradient-to-r from-[#fb8cc0] via-[#fa539c] to-[#fdc6c3] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(250,83,156,0.6)]">{BRAND_NAME}</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#ffe9f5]/80">
          {BRAND_NAME} นำเสนอเกมสล็อตออนไลน์หลากหลายรูปแบบ พร้อมข้อมูลค่ายเกม โปรโมชั่น และระบบบริการสมาชิกที่รวบรวมไว้ในเว็บไซต์เดียว ผู้ใช้งานสามารถศึกษากติกาเกม ตรวจสอบเงื่อนไขโบนัส
          และรายละเอียดฝากถอนก่อนใช้งานได้ ส่วนคำกล่าวอ้างเกี่ยวกับการเป็นเว็บตรงและเกมถูกลิขสิทธิ์ ควรตรวจสอบจากข้อมูลผู้พัฒนาและหลักฐานการได้รับอนุญาตที่เชื่อถือได้
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/40 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.12)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>
        </div>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }
      </div>

      <nav aria-label="ลิงก์ด่วน" class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#fb8cc0]">
          ลิงก์ด่วน
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#fa539c] to-[#c2185b] shadow-[0_0_8px_rgba(250,83,156,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          <a href="/" class="group flex items-center text-[#ffe9f5]/80 transition-colors hover:text-[#fb8cc0]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-full bg-[#fa539c] transition-transform group-hover:scale-150"></span> หน้าแรก
          </a>
          <a href="/promotion" class="group flex items-center text-[#ffe9f5]/80 transition-colors hover:text-[#fb8cc0]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-full bg-[#fdc6c3] transition-transform group-hover:scale-150"></span> โปรโมชั่นสมาชิก
          </a>
          <a href="/ทดลองเล่น" class="group flex items-center text-[#ffe9f5]/80 transition-colors hover:text-[#fb8cc0]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-full bg-[#fa539c] transition-transform group-hover:scale-150"></span> ทดลองเล่นเกม
          </a>
          <a href="/ทางเข้า" class="group flex items-center text-[#ffe9f5]/80 transition-colors hover:text-[#fb8cc0]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-full bg-[#fdc6c3] transition-transform group-hover:scale-150"></span> ทางเข้าล่าสุด
          </a>
          <a href="/register" class="group flex items-center text-[#ffe9f5]/80 transition-colors hover:text-[#fb8cc0]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-full bg-[#fa539c] transition-transform group-hover:scale-150"></span> สมัครสมาชิก
          </a>
          <a href="/login" class="group flex items-center text-[#ffe9f5]/80 transition-colors hover:text-[#fb8cc0]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-full bg-[#fdc6c3] transition-transform group-hover:scale-150"></span> เข้าสู่ระบบ
          </a>
          <a href="/about-us" class="group flex items-center text-[#ffe9f5]/80 transition-colors hover:text-[#fb8cc0]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-full bg-[#fa539c] transition-transform group-hover:scale-150"></span> เกี่ยวกับเรา
          </a>
          <a href="/contact-us" class="group flex items-center text-[#ffe9f5]/80 transition-colors hover:text-[#fb8cc0]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-full bg-[#fdc6c3] transition-transform group-hover:scale-150"></span> ติดต่อแอดมิน
          </a>
        </div>
      </nav>

      <section aria-label="ช่องทางทำรายการ" class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#fb8cc0]">
          ช่องทางทำรายการ
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#fa539c] to-[#c2185b] shadow-[0_0_8px_rgba(250,83,156,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#ffe9f5]/80">
          {BRAND_NAME} ระบุช่องทางฝากถอนผ่านธนาคารและทรูมันนี่ ผู้ใช้งานควรตรวจสอบข้อกำหนดจริงเกี่ยวกับวงเงินต่อรายการ จำนวนครั้งในการถอน และขั้นตอนการยืนยันตัวตนให้ครบถ้วนก่อนทำรายการ
        </p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded-full border border-[#fa539c]/45 bg-[#54123a] transition-colors hover:border-[#fa539c]/90">
          <span class="flex items-center gap-1 text-xs font-bold text-[#ffe9f5]"><span aria-hidden="true" class="text-lg">🔎</span> ตรวจสอบชื่อบัญชีปลายทางก่อนโอนทุกครั้ง</span>
        </div>
      </section>
    </div>

    <hr class="mb-6 border-[#7a2350]" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#ffe9f5]/75 md:block">
      {BRAND_NAME} เป็นช่องทางสำหรับผู้ที่ต้องการศึกษาข้อมูลเกมสล็อตออนไลน์ไว้ในเว็บไซต์เดียว ทั้งรายละเอียดค่ายเกม เงื่อนไขโบนัส และขั้นตอนการทำรายการฝากถอน ด้านโปรโมชั่น เว็บไซต์ระบุว่า
      สามารถรับโบนัสจากการฝากเงินได้ตลอดวันโดยไม่ต้องทำเทิร์น ซึ่งผู้ใช้งานควรตรวจสอบก่อนเข้าร่วมว่าโบนัสประเภทใดได้รับการยกเว้นข้อกำหนดยอดเดิมพัน และมีเงื่อนไขเกี่ยวกับการถอนเงินหรือ
      วงเงินโบนัสสูงสุดหรือไม่ สำหรับรายการคืนยอดเสีย 0.3% ระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขรายวัน สมาชิกควรตรวจสอบว่าเกมสล็อตประเภทใดเข้าร่วมรายการ มีรอบสรุปยอดเวลาใด และต้อง
      กดรับเครดิตด้วยตนเองหรือระบบดำเนินการให้อัตโนมัติ ทั้งนี้ เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งต่อไป ส่วนโบนัสแนะนำเพื่อน 0.8%
      ควรตรวจสอบวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และฐานยอดที่ใช้คำนวณโบนัสให้ชัดเจน แม้จะมีข้อความว่าไม่จำกัด แต่ควรยืนยันจำนวนบัญชีที่เข้าร่วมได้ รอบจ่ายเครดิต และเงื่อนไขการ
      ใช้โบนัสจากประกาศล่าสุด ด้านการสมัครสมาชิก ขั้นตอนทั่วไปประกอบด้วยการเข้าสู่หน้าสมัคร กรอกข้อมูล และยืนยันบัญชี ก่อนดำเนินการควรตรวจสอบคุณสมบัติผู้สมัคร ข้อกำหนดด้านอายุ และ
      กฎหมายที่เกี่ยวข้อง รวมถึงศึกษานโยบายความเป็นส่วนตัวเพื่อทำความเข้าใจวิธีจัดเก็บข้อมูลส่วนบุคคล ด้านการทำรายการ ก่อนโอนเงินควรตรวจสอบชื่อบัญชีปลายทางให้ตรงกับข้อมูลผู้ให้บริการ
      ที่ยืนยันได้ หากพบความผิดปกติควรหยุดทำธุรกรรมและติดต่อธนาคารหรือผู้ให้บริการชำระเงินโดยเร็ว สำหรับการติดต่อเจ้าหน้าที่ ควรตรวจสอบช่องทางจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อ
      หลีกเลี่ยงบัญชีแอบอ้าง หากพบปัญหาเกี่ยวกับธุรกรรม ควรเก็บหมายเลขรายการและหลักฐานที่เกี่ยวข้องไว้สำหรับตรวจสอบ โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ทั้งนี้ ควรตรวจสอบเวลาการให้
      บริการจริงของ {BRAND_NAME} จากประกาศล่าสุดอีกครั้ง
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-[#7a2350] pt-6 text-xs text-[#ffe9f5]/80 md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-[#fb8cc0]">{BRAND_NAME}</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/terms/" class="transition-colors hover:text-[#fb8cc0]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#fb8cc0]">นโยบายความเป็นส่วนตัว</a>

        <a
          href="#top"
          class="flex h-8 w-8 items-center justify-center rounded-full border border-[#fa539c]/55 bg-[#54123a] text-[#ffe9f5] transition-all hover:border-[#fa539c] hover:bg-[#c2185b] hover:text-[#ffe9f5] hover:shadow-[0_0_15px_rgba(250,83,156,0.6)]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>

