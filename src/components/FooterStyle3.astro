---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt =
  "โลโก้ GUCCI168 บนพื้นโปร่งใส กลางภาพเป็นเทพเจ้าโชคลาภจีนหน้ากลมยิ้มตาหยี สวมหมวกทรงจีนสีเขียวมรกตคาดแถบแดง ประดับพลอยเขียวในกรอบทอง มีเหรียญทองจีนห้อยสองข้าง ด้านหน้าเป็นตัวอักษร GUCCI สีขาวเงินตัดขอบเขียวมรกต วางทับตัวเลข 168 สีแดงเมทัลลิกตัดขอบทอง";

// GUCCI168 (รอบตรุษจีน แดง-เขียวมรกต-ทอง 2026-10-08): footer ที่ใช้งานจริงรอบนี้ —
// รอบก่อน (UOK365) ใช้ FooterPremium จึงหมุนกลับมาที่ไฟล์นี้ ของเดิมที่ค้างอยู่ใน
// ไฟล์เป็นฟ้า-ทองบนกรมท่าเข้มของ HI59 (#02162c #04203f #073059 #0a84e0 #5ec2ff
// #fdbc04 #ffe27a #e4f1fd #c88a02) ย้ายทั้งไฟล์มาเป็นแดง-เขียวมรกต-ทองบนพื้น
// เกือบดำอมแดงตามโลโก้จริงแล้ว ไม่เหลือฟ้าชุดเดิมเลย
//
// footer เป็น "โครม" จึงประกาศสีตัวอักษรของตัวเองครบทุกจุด ไม่ได้ inherit
// BRAND_TEXT และโลโก้ที่เป็นขาวเงิน-แดง-ทองต้องการพื้นเข้มถึงจะอ่านออก
//
// แกนสีที่ใช้ (brand-spec §3): พื้นเกือบดำอมแดง #090302 ยกระดับด้วย #1d0b08 /
// #3d0a09 · แดงแบรนด์ #c41115 (vivid ของ logo.webp เลข 168) เป็นเส้นคั่น ขอบการ์ด
// และออรา · แดงสว่าง #e0201f เป็นปลายไล่เฉดด้านสว่าง · เขียวมรกต #0b7a33 กับเขียว
// สว่าง #2bbf63 เป็นฮิวที่สอง (หมวกเทพเจ้าโชคลาภและซุ้มประตูในแบนเนอร์) อยู่ที่
// จุดนำลิงก์และปลายเส้นใต้หัวคอลัมน์ · ทองแบรนด์ #d9a521 กับทองอ่อน #ffdf91 เป็น
// โลหะคั่น สงวนไว้ให้หัวคอลัมน์ ชื่อแบรนด์ และปุ่มสมัคร · เนื้อความ #f6e3cf
// ลดน้ำหนักด้วย opacity
//
// คอปปี้ทั้งไฟล์เขียนใหม่จากบรีฟ GUCCI168 ซึ่งเป็น **เว็บคาสิโนไลฟ์ 24 ชั่วโมง
// ไม่ใช่เว็บหวยและไม่ใช่เว็บสล็อตเพียวๆ** บรีฟรอบนี้พูดเรื่องคาสิโนไลฟ์ที่รวม
// บาคาร่า รูเล็ต ไฮโล สล็อต และบอลไว้ในบัญชีเดียว เลือกโต๊ะสดหรือหมวดเกมได้
// โปรโมชั่นคืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% สมัคร 3 ขั้นตอน และแอดมิน 24 ชั่วโมง
// เท่านั้น ไม่ได้ระบุใบอนุญาต ชื่อค่ายเกม ชื่อผู้ให้บริการ ชื่อธนาคาร ยอดขั้นต่ำ
// ค่า RTP หรือจำนวนสมาชิกใดไว้ จึงไม่มีในข้อความนี้ และประโยคกำกับของบรีฟเอง
// ("ไม่มีขั้นต่ำทุกรูปแบบเกม" ควรอ้างอิงวงเงินจริงภายในระบบ · "คาสิโนไม่จำกัดยอด"
// ควรพิจารณาจาก Limit ของโต๊ะและเกมจริง · โต๊ะไลฟ์และการแข่งขันบางรายการมีเวลา
// เปิดให้เดิมพันต่างกัน) ขนมาด้วย ไม่ตัดทิ้ง
//
// ลิงก์: GUCCI168 เป็นเว็บคาสิโน — /ตรวจหวย กับ /แนวทาง อยู่ใน src/pages-disabled/
// รอบนี้ จึงไม่มีสองลิงก์นั้นในคอลัมน์ลิงก์ด่วน ไม่งั้น verify-build.mjs จะทำให้
// build แดงเพราะ href ชี้ไป route ที่ไม่มีใน dist/ ถ้ารอบหน้าเป็นแบรนด์หวยแล้วย้าย
// ไฟล์กลับเข้า src/pages/ ต้องเพิ่มสองลิงก์นี้คืนพร้อมกัน
//
// /ทางเข้า ยังมีลิงก์อยู่ตรงนี้: หน้านั้นยัง route และ index อยู่ แค่ไม่มีใน
// เมนู navbar เพราะ toggle ของ register/login เปิด (ดู NavbarStyle8.astro)
//
// ปุ่มพื้นทองใช้ตัวอักษรหมึกเกือบดำอมแดง #1a0604 — พื้นทองสว่างกับตัวอักษรอ่อนอ่าน
// ไม่ออก (#1a0604 บน #ffdf91 = 14.6:1 · บน #d9a521 = 8.9:1 ผ่าน AA ทั้งคู่)
//
// บล็อก <address> ตั้งใจไม่ทาสีแบรนด์ — border-white/15 + bg-black/20 + opacity
// บนสีตัวอักษรที่ inherit มา ลงตัวกับ footer ทุกตัวในไลบรารี ห้าม retheme
---

<footer
  class="relative mt-32 w-full border-t border-[#c41115]/55 bg-[#090302] pt-64 pb-6 font-sans text-[#f6e3cf] shadow-[0_-10px_30px_rgba(196,17,21,0.22)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#d9a521]/70 bg-gradient-to-r from-[#1d0b08] via-[#3d0a09] to-[#1d0b08] p-6 shadow-[0_15px_40px_rgba(9,3,2,0.75)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#ffdf91] uppercase italic drop-shadow-[0_2px_4px_rgba(9,3,2,0.6)] md:text-3xl">
        <span aria-hidden="true">🎴</span> พร้อมเข้าโต๊ะคาสิโนไลฟ์กับ {BRAND_NAME} แล้วหรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#f6e3cf]/90 md:text-base">
        สมัคร {BRAND_NAME} ได้ด้วยตนเองทั้งบนมือถือและคอมพิวเตอร์ เลือกโต๊ะสด บาคาร่า รูเล็ต ไฮโล สล็อต หรือบอลผ่านบัญชีเดียว พร้อมตรวจสอบเครดิต โปรโมชั่น
        และประวัติรายการก่อนยืนยันทุกครั้ง
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#8c6410] bg-gradient-to-b from-[#ffdf91] to-[#d9a521] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#1a0604] shadow-[0_0_15px_rgba(217,165,33,0.45)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🚀</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#3d0a09] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[100, 200, 300]}
                sizes="100px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(196,17,21,0.6)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-r from-[#ffdf91] via-[#e0201f] to-[#2bbf63] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(196,17,21,0.6)]">{BRAND_NAME}</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#f6e3cf]/75">
          {BRAND_NAME} เป็นเว็บเล่นคาสิโนไลฟ์ 24 ชั่วโมงที่รวมเกมเดิมพันหลายรูปแบบไว้ในระบบเดียว มีทั้งบาคาร่า รูเล็ต ไฮโล สล็อต และบอล รองรับการเข้าเล่นผ่านมือถือ
          และคอมพิวเตอร์ เลือกโต๊ะสดหรือหมวดเกมที่สนใจได้จากบัญชีเดียว ระบบจัดหมวดหมู่ชัดเจน ช่วยให้สลับระหว่างคาสิโน สล็อต และกีฬาได้สะดวก
          แม้เว็บไซต์จะเข้าใช้งานได้ตลอดวัน แต่เกมไลฟ์และการแข่งขันบางรายการจะมีเวลาเปิดให้เดิมพันแตกต่างกัน ควรตรวจสอบสถานะของโต๊ะหรือรายการจากระบบก่อนเริ่มทุกครั้ง
          ส่วนคำว่า “ไม่มีขั้นต่ำทุกรูปแบบเกม” ควรอ้างอิงวงเงินจริงภายในระบบ เพราะแต่ละโต๊ะ เกม หรือผู้ให้บริการสามารถกำหนดยอดเดิมพันขั้นต่ำไม่เท่ากัน
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/40 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.12)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>
        </div>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }
      </div>

      <nav aria-label="ลิงก์ด่วน" class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#ffdf91] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#e0201f] to-[#d9a521] shadow-[0_0_8px_rgba(196,17,21,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          <a href="/" class="group flex items-center text-[#f6e3cf]/75 transition-colors hover:text-[#ffdf91]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#2bbf63] transition-transform group-hover:rotate-45"></span> หน้าแรก
          </a>
          <a href="/promotion" class="group flex items-center text-[#f6e3cf]/75 transition-colors hover:text-[#ffdf91]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#2bbf63] transition-transform group-hover:rotate-45"></span> โปรโมชั่นสมาชิก
          </a>
          <a href="/ทดลองเล่น" class="group flex items-center text-[#f6e3cf]/75 transition-colors hover:text-[#ffdf91]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#2bbf63] transition-transform group-hover:rotate-45"></span> ทดลองเล่นเกม
          </a>
          <a href="/ทางเข้า" class="group flex items-center text-[#f6e3cf]/75 transition-colors hover:text-[#ffdf91]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#2bbf63] transition-transform group-hover:rotate-45"></span> ทางเข้าล่าสุด
          </a>
          <a href="/register" class="group flex items-center text-[#f6e3cf]/75 transition-colors hover:text-[#ffdf91]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#2bbf63] transition-transform group-hover:rotate-45"></span> สมัครสมาชิก
          </a>
          <a href="/login" class="group flex items-center text-[#f6e3cf]/75 transition-colors hover:text-[#ffdf91]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#2bbf63] transition-transform group-hover:rotate-45"></span> เข้าสู่ระบบ
          </a>
          <a href="/about-us" class="group flex items-center text-[#f6e3cf]/75 transition-colors hover:text-[#ffdf91]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#2bbf63] transition-transform group-hover:rotate-45"></span> เกี่ยวกับเรา
          </a>
          <a href="/contact-us" class="group flex items-center text-[#f6e3cf]/75 transition-colors hover:text-[#ffdf91]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#2bbf63] transition-transform group-hover:rotate-45"></span> ติดต่อแอดมิน
          </a>
        </div>
      </nav>

      <section aria-label="ช่องทางทำรายการ" class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#ffdf91] uppercase">
          ช่องทางทำรายการ
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#e0201f] to-[#d9a521] shadow-[0_0_8px_rgba(196,17,21,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#f6e3cf]/75">
          ก่อนทำรายการทุกครั้งควรตรวจสอบชื่อบัญชีปลายทางให้ตรงกับข้อมูลที่เว็บไซต์ประกาศ และเก็บเวลา จำนวนเงิน พร้อมหลักฐานธุรกรรมไว้สำหรับตรวจสอบย้อนหลัง
        </p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-[#c41115]/45 bg-[#1d0b08] transition-colors hover:border-[#e0201f]/70">
          <span class="flex items-center gap-1 text-xs font-bold text-[#f6e3cf]"><span aria-hidden="true" class="text-lg text-[#d9a521]">🎲</span> ตรวจสอบช่องทางที่ระบบรองรับก่อนทำรายการ</span>
        </div>
      </section>
    </div>

    <hr class="mb-6 border-[#3d0a09]" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#f6e3cf]/70 md:block">
      {BRAND_NAME} เป็นช่องทางสำหรับผู้ที่ต้องการเข้าเล่นเกมคาสิโนไลฟ์และเกมเดิมพันหลายรูปแบบผ่านระบบเดียว มีทั้งบาคาร่าและรูเล็ตที่มีโต๊ะให้เลือกตามรายการ
      ที่เปิดบริการ ไฮโลที่เน้นรูปแบบการเดิมพันเข้าใจง่าย สล็อตที่มีทั้งเกมโบนัส ฟรีสปิน และตัวคูณ รวมถึงการแทงบอลที่เลือกคู่แข่งขันและตลาดเดิมพันได้ตามช่วงเวลา
      ที่ระบบเปิดรับ เข้าใช้งานผ่านเว็บเบราว์เซอร์ได้ทั้งบนมือถือและคอมพิวเตอร์ หลัง Login สามารถเลือกหมวดเกม ตรวจสอบเครดิต ดูโปรโมชั่น แล้วย้อนดูประวัติรายการ
      ได้จากบัญชีเดียวโดยไม่ต้องสมัครใหม่หลายครั้ง จำนวนโต๊ะและรายการสดอาจเปลี่ยนแปลงตามช่วงเวลา จึงควรตรวจสอบสถานะล่าสุดจากระบบก่อนเริ่มเดิมพัน
      โปรโมชั่นคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% คำนวณจากยอดที่เข้าเกณฑ์ตามรอบที่กำหนด แต่ละแคมเปญอาจมีรอบตัดยอดและประเภทเกมที่ร่วมรายการแตกต่างกัน
      จึงควรตรวจสอบเงื่อนไขล่าสุดก่อนกดรับสิทธิ์ ส่วนข้อความว่า “ไม่มีขั้นต่ำทุกรูปแบบเกม” ควรอ้างอิงวงเงินจริงภายในระบบ เพราะบาคาร่า รูเล็ต ไฮโล สล็อต และบอล
      สามารถกำหนดยอดเดิมพันขั้นต่ำแตกต่างกันตามโต๊ะ เกม หรือผู้ให้บริการ เช่นเดียวกับคำว่า “คาสิโนไม่จำกัดยอด” ที่ควรพิจารณาจาก Limit ของโต๊ะและเกมจริง
