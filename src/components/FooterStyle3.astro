---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส เป็นตัวอักษรละติน KMD สีม่วงเข้มขัดเงาแบบสามมิติที่ขอบตัวอักษรเป็นทอง ต่อด้วยเลข 88 สีทองเมทัลลิกวาว และมีวงแหวนทองเส้นบางขาดช่วงล้อมอยู่ด้านหลังตัวอักษรทั้งหมด`;

// KMD88 (รอบม่วงราชา-ทอง 2026-10-13): footer ที่ใช้งานจริงรอบนี้ — รอบก่อน
// (TND168) ใช้ FooterPremiumSumo เหตุผลที่เลือกไฟล์นี้คือ "ทรง" ไม่ใช่สี:
// Footer / FooterPremium / FooterPremiumSumo / FooterHuay เป็นแผ่น
// rounded-t-[3rem] + ออราเหมือนกันหมดทั้งสี่ตัว ส่วนไฟล์นี้เป็นการ์ด CTA ลอย
// คร่อมขอบบน (-top-14 / md:-top-16) แล้วตัวแผ่นเว้น pt-64 (md:pt-40) ไว้รับ —
// เป็นทรงเดียวในไลบรารีที่ไม่ซ้ำกับสี่ตัวนั้น
//
// ของเดิมที่ค้างอยู่ในไฟล์เป็นทองแชมเปี้ยน-เงินโครเมียมของ UFA324 (#e5a81b
// #b9c2cc #ffe08a #bb8410 #7d5a07 #f0e8d4 #140d01 #0d0b06 #17130a #231c0e
// #43300a #f2f5f9 #464f5a rgba(229,168,27,α)) ย้ายทั้งไฟล์มาเป็นม่วง-ทองของ
// รอบนี้แล้ว ไม่เหลือชุดเดิมและไม่เหลือเงินโครเมียมเลย
// ⚠️ ทองมาแล้วเก้าในสิบสองรอบหลังสุด การเจอทองในไฟล์นี้จึง **ไม่ได้แปลว่าเป็น
// ของรอบนี้** ต้องเทียบเป็น "ค่า": #e2b33f ไม่ใช่ #e5a81b · #ffdf8c ไม่ใช่
// #ffe08a · #ece2f8 ไม่ใช่ #f0e8d4 — และที่ต่างกันจริงอีกอย่างคือรอบนี้ฮิวที่
// สองเป็น **ม่วง** ไม่ใช่เงินโครเมียม พื้นเป็นม่วงเกือบดำ #0a0213 ที่แทบแตะ
// พื้นเพจ (bg.json รอบนี้เป็น #000000 ดำสนิท)
//
// footer เป็น "โครม" จึงประกาศสีตัวอักษรของตัวเองครบทุกจุด ไม่ได้ inherit
// BRAND_TEXT และโลโก้ที่เป็นม่วง-ทองบนพื้นโปร่งต้องการพื้นเข้มถึงจะอ่านออก
//
// แกนสีที่ใช้ (brand-spec §2): พื้นผิวจม #0a0213 ยกระดับด้วย #140522 / #1d0832 /
// #2c0349 · ทองแบรนด์ #e2b33f (เลข 88 บนโลโก้ และตัวอักษรไทยบนแบนเนอร์) เป็น
// หัวคอลัมน์ เส้นคั่น ขอบ และออรา · ทองสว่าง #ffdf8c กับทองกลางเข้ม #d6a022 เป็น
// สองปลายของไล่เฉดปุ่ม · ทองลึก #7a5a0a เป็นขอบปุ่ม ไม่ถือตัวอักษร · ม่วงแบรนด์
// #7505cc (คำว่า KMD บนโลโก้ และริบบิ้นแสงบนแบนเนอร์) เป็นฮิวที่สอง ถือขอบการ์ด
// ลอย เส้นใต้หัวคอลัมน์ และออรา ส่วนม่วงที่ "ถือตัวอักษรได้" คือ #c07cff (จุดนำ
// ลิงก์เป็นพื้นถมสีนี้) · เนื้อความ #ece2f8 ลดน้ำหนักด้วย opacity
//
// ปุ่มพื้นทองใช้หมึกม่วงเกือบดำ #1a0526 — พื้นทองสว่างกับตัวอักษรอ่อนอ่านไม่ออก
// (#1a0526 บน #ffdf8c = 15.4:1 · บน #d6a022 = 7.2:1 ผ่าน AA ทั้งคู่)
// ⚠️ ปลายเข้มของไล่เฉดปุ่มต้องเป็น #d6a022 ไม่ใช่ #7a5a0a — #7a5a0a รองหมึกนี้
// ได้แค่ ~2.9:1 ซึ่งตก AA หนัก
// ⚠️ #7505cc #b453ff #3a0565 #2c0349 #7a5a0a ห้ามถือตัวอักษรทุกขนาดในไฟล์นี้
//
// คอปปี้ทั้งไฟล์เขียนใหม่จากบรีฟ KMD88 (src/assets/content.txt) ซึ่งเป็น
// **เว็บลิขสิทธิ์ไทยแท้ คาสิโนรวมเกม** — บาคาร่า สล็อต และบอลออนไลน์ ในแพลตฟอร์ม
// เดียว พร้อมระบบเดิมพันแบบออโต้ ไม่ใช่เว็บสล็อตล้วนแบบ NAZA168/FAH999 ไม่ใช่
// เว็บกีฬาล้วนแบบ UFA324 และไม่ใช่เว็บหวย บรีฟรอบนี้พูดเรื่องการรวมหมวดเกมไว้ใน
// ระบบเดียว การตรวจสอบยอดเครดิตและประวัติธุรกรรม โปรโมชั่นคืนยอดเสีย 0.3% กับ
// แนะนำเพื่อน 0.8% ระบบฝากถอนที่อ้างว่าเข้าบัญชีบริษัทเจ้าของโดยตรง และแอดมิน
// 24 ชั่วโมง เท่านั้น ไม่ได้ระบุเลขใบอนุญาต ชื่อหน่วยงานที่ออกใบอนุญาต ชื่อค่ายเกม
// ชื่อนิติบุคคล ชื่อธนาคาร ยอดขั้นต่ำเป็นตัวเลข ค่า RTP จำนวนสมาชิก หรือปีก่อตั้ง
// ไว้เลย จึงไม่มีในข้อความนี้
// ⚠️ บรีฟ "ตั้งคำถามกับคำโฆษณาของตัวเอง" ถึงสามจุด และประโยคกำกับพวกนั้นต้องขนมา
// ด้วย ห้ามตัดทิ้งเพราะฟังดูไม่ขายของ: การระบุว่าเป็นเว็บลิขสิทธิ์ไทยแท้ควรมี
// ข้อมูลใบอนุญาตและหน่วยงานที่ออกใบอนุญาตให้ตรวจสอบได้ · หากใช้บัญชีบริษัท
// เจ้าของโดยตรงควรแสดงชื่อบริษัทหรือนิติบุคคลที่เกี่ยวข้องให้ตรวจสอบได้ ·
// การใช้บัญชีบริษัทไม่ได้รับประกันความปลอดภัยของธุรกรรมทั้งหมด ·
// ไม่มีเกมประเภทใดรับประกันผลกำไร
// คำของแบรนด์ก่อนๆ ที่ห้ามหลุดกลับมา: แบรนด์คาสิโนเซิร์ฟไทย · เล่นได้ทุกค่าย ·
// มีโบนัสทุกเกม · เว็บเล่นเกมกีฬาออนไลน์ · ฐานเกมแท้ · จ่ายตรง · ไม่บิดยูส ·
// ไม่ผ่านบัญชีม้า · ฟาสล็อตเว็บตรง · ส่งตรงจากอเมริกา · ไม่ผ่านเอเย่นต์ ·
// สล็อตเบทต่ำ · แตกง่าย · ยิงปลา · เสือมังกร · และคำหวยทุกคำ
//
// ลิงก์: KMD88 เป็นเว็บคาสิโนรวมเกม — /ตรวจหวย กับ /แนวทาง อยู่ใน
// src/pages-disabled/ รอบนี้ จึงไม่มีสองลิงก์นั้นในคอลัมน์ลิงก์ด่วน ไม่งั้น
// verify-build.mjs จะทำให้ build แดงเพราะ href ชี้ไป route ที่ไม่มีใน dist/
// ถ้ารอบหน้าเป็นแบรนด์หวยแล้วย้ายไฟล์กลับเข้า src/pages/ ต้องเพิ่มสองลิงก์นี้คืน
//
// /register กับ /login รอบนี้เป็นหน้าปุ่มจริงที่ index ได้ (toggle cta เปิด) ส่วน
// /ทางเข้า ถูกถอดออกจากเมนู navbar รอบนี้ แต่ route ยังมีจริงและยัง index อยู่
// ลิงก์จาก footer จึงยังถูกต้องทั้งสามหน้า (ดู NavbarStyle11.astro)
//
// บล็อก <address> ตั้งใจไม่ทาสีแบรนด์ — border-white/15 + bg-black/20 + opacity
// บนสีตัวอักษรที่ inherit มา ลงตัวกับ footer ทุกตัวในไลบรารี ห้าม retheme
---

<footer
  class="relative mt-32 w-full border-t border-[#7505cc]/55 bg-[#0a0213] pt-64 pb-6 font-sans text-[#ece2f8] shadow-[0_-10px_30px_rgba(117,5,204,0.26)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#e2b33f]/60 bg-gradient-to-r from-[#1d0832] via-[#2c0349] to-[#1d0832] p-6 shadow-[0_15px_40px_rgba(0,0,0,0.78)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#e2b33f] uppercase italic drop-shadow-[0_2px_4px_rgba(0,0,0,0.6)] md:text-3xl">
        <span aria-hidden="true">👑</span> พร้อมเปิดระบบเดิมพันออโต้กับ {BRAND_NAME} แล้วหรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#ece2f8]/90 md:text-base">
        สมัคร {BRAND_NAME} ได้ด้วยตนเองผ่านมือถือหรือคอมพิวเตอร์ กรอกข้อมูลตามที่ระบบกำหนดแล้วเข้าสู่ระบบเพื่อเลือกหมวดเกม ตรวจสอบยอดเครดิต และติดตามรายการต่างๆ ได้จากแพลตฟอร์มเดียว
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#7a5a0a] bg-gradient-to-b from-[#ffdf8c] to-[#d6a022] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#1a0526] shadow-[0_0_15px_rgba(226,179,63,0.5)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🎴</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#2c0349] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[100, 200, 300]}
                sizes="100px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(117,5,204,0.7)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-r from-[#ffdf8c] via-[#e2b33f] to-[#c07cff] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(117,5,204,0.65)]">{BRAND_NAME}</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#ece2f8]/75">
          {BRAND_NAME} เว็บคาสิโนออนไลน์ที่รวมหมวดเกมเดิมพันหลายประเภทไว้ในแพลตฟอร์มเดียว ทั้งบาคาร่า สล็อต และบอลออนไลน์ พร้อมระบบเดิมพันแบบออโต้และเมนูจัดการบัญชีสำหรับตรวจสอบ
          ยอดเครดิตและติดตามรายการต่างๆ ผ่านมือถือหรือคอมพิวเตอร์ได้สะดวก ส่วนการระบุว่าเป็นเว็บลิขสิทธิ์ไทยแท้ ควรมีข้อมูลใบอนุญาตและหน่วยงานที่ออกใบอนุญาตให้ตรวจสอบได้
          ประกอบการพิจารณาก่อนใช้งาน
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/40 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.12)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>
        </div>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }
      </div>

      <nav aria-label="ลิงก์ด่วน" class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#e2b33f] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#e2b33f] to-[#7505cc] shadow-[0_0_8px_rgba(226,179,63,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          <a href="/" class="group flex items-center text-[#ece2f8]/75 transition-colors hover:text-[#e2b33f]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#c07cff] transition-transform group-hover:rotate-45"></span> หน้าแรก
          </a>
          <a href="/promotion" class="group flex items-center text-[#ece2f8]/75 transition-colors hover:text-[#e2b33f]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#c07cff] transition-transform group-hover:rotate-45"></span> โปรโมชั่นสมาชิก
          </a>
          <a href="/ทดลองเล่น" class="group flex items-center text-[#ece2f8]/75 transition-colors hover:text-[#e2b33f]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#c07cff] transition-transform group-hover:rotate-45"></span> ทดลองเล่นเกม
          </a>
          <a href="/ทางเข้า" class="group flex items-center text-[#ece2f8]/75 transition-colors hover:text-[#e2b33f]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#c07cff] transition-transform group-hover:rotate-45"></span> ทางเข้าล่าสุด
          </a>
          <a href="/register" class="group flex items-center text-[#ece2f8]/75 transition-colors hover:text-[#e2b33f]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#c07cff] transition-transform group-hover:rotate-45"></span> สมัครสมาชิก
          </a>
          <a href="/login" class="group flex items-center text-[#ece2f8]/75 transition-colors hover:text-[#e2b33f]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#c07cff] transition-transform group-hover:rotate-45"></span> เข้าสู่ระบบ
          </a>
          <a href="/about-us" class="group flex items-center text-[#ece2f8]/75 transition-colors hover:text-[#e2b33f]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#c07cff] transition-transform group-hover:rotate-45"></span> เกี่ยวกับเรา
          </a>
          <a href="/contact-us" class="group flex items-center text-[#ece2f8]/75 transition-colors hover:text-[#e2b33f]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#c07cff] transition-transform group-hover:rotate-45"></span> ติดต่อแอดมิน
          </a>
        </div>
      </nav>

      <section aria-label="ช่องทางทำรายการ" class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#e2b33f] uppercase">
          ช่องทางทำรายการ
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#e2b33f] to-[#7505cc] shadow-[0_0_8px_rgba(226,179,63,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#ece2f8]/75">
          ก่อนทำรายการควรตรวจสอบชื่อบัญชีปลายทาง จำนวนเงิน และเงื่อนไขการฝากถอนให้ครบถ้วน หากพบชื่อบัญชีไม่ตรงกับข้อมูลที่เว็บไซต์แจ้ง ควรสอบถามฝ่ายบริการผ่านช่องทางหลักก่อนยืนยันรายการ พร้อมเก็บหลักฐานธุรกรรมไว้สำหรับตรวจสอบ
        </p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-[#e2b33f]/45 bg-[#140522] transition-colors hover:border-[#7505cc]/80">
