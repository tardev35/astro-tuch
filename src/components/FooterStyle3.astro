import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// เขียนจาก src/assets/logo.webp ของดรอป 2026-10-24 17:37 จริง (เปิดอ่านด้วย Read
// ก่อนเขียน) ไม่ใช่คัดลอกของรอบก่อน — ลูกหมูการ์ตูนชมพู **มีปีกนางฟ้า** กับคำว่า
// หมูบิน ของ หมูบิน168 ที่เคยอยู่บรรทัดนี้ **ไม่มีในรูปรอบนี้เลยสักอย่าง**
// ⚠️⚠️ **นี่คือกับดักที่แหลมที่สุดของไฟล์นี้**: สไลด์ของรอบนี้ **มีหมูการ์ตูนชมพู
// อยู่จริง** แต่ (ก) **ไม่มีปีก** และ (ข) **ไม่ได้อยู่ในโลโก้** ตัวที่อยู่ในโลโก้คือ
// **หน้าการ์ตูนกลมที่ทำหน้าที่เป็นตัวอักษรตัวแรกของเวิร์ดมาร์ก** — เจอ "หมูชมพู"
// ไม่ได้แปลว่าเป็นของ หมูบิน168 และไม่ได้แปลว่าต้องเขียนลงใน alt ของโลโก้
const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส เป็นเวิร์ดมาร์กตัวอักษรละตินทรงเจลลี่สามมิติผิวมันวาวสีชมพูบับเบิลกัมตัดขอบสีขาวหนา โดยตัวอักษรตัวแรกถูกแทนที่ด้วยหน้าการ์ตูนกลมสีชมพูที่ขยิบตาข้างหนึ่ง ยิ้มอ้าปากเห็นลิ้น แก้มแดง และมีมือการ์ตูนสวมถุงมือสีขาวชูสองนิ้วอยู่ทางซ้าย ต่อด้วยตัวอักษรที่เหลือและเลขแปดสองตัวทรงเจลลี่สีชมพู โดยมีรูปหัวใจสีชมพูขนาดเล็กสามดวงและขีดประกายสีชมพูลอยประดับอยู่เหนือตัวอักษร`;

// okkub88 (รอบบับเบิลกัมชมพูบน **ธีมสว่าง** 2026-10-24): footer ที่ใช้งานจริง
// รอบนี้ — รอบก่อน (โบ๊ะบ๊ะ168) ใช้ FooterStyle2 เหตุผลที่เลือกไฟล์นี้คือ "ทรง"
// ไม่ใช่สี: Footer / FooterPremium / FooterPremiumSumo / FooterHuay เป็นแผ่น
// rounded-t-[3rem] + ออราเรืองแสงเบลอคร่อมขอบบน กริด 12 คอลัมน์ ส่วน FooterStyle2
// เป็นแผ่นแบนขอบบนเส้นหนา กริด 4 คอลัมน์เท่ากัน ไฟล์นี้เป็น **การ์ด CTA ลอยคร่อม
// ขอบบน** (-top-14 / md:-top-16) แล้วตัวแผ่นเว้น pt-64 (md:pt-40) ไว้รับ และมี
// **BankStrip** อยู่ในคอลัมน์ช่องทางทำรายการ — เป็นทรงเดียวในไลบรารีที่ไม่ซ้ำกับ
// ทั้งสองกลุ่มนั้น
//
