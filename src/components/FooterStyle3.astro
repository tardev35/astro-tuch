---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt = "โลโก้ UFA168 ตัวอักษร UFA สีทองเมทัลลิกไล่เฉด ตามด้วยเลข 168 สีเงินโครเมียม";
---

<footer class="relative mt-32 w-full border-t border-[#6b5316]/60 bg-[#050403] pt-64 pb-6 font-sans text-[#e6dcc2] shadow-[0_-10px_30px_rgba(243,219,91,0.16)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#6b5316]/75 bg-gradient-to-r from-[#050403] via-[#241a08] to-[#050403] p-6 shadow-[0_15px_40px_rgba(243,219,91,0.26)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#fff3bf] uppercase italic drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)] md:text-3xl">
        <span aria-hidden="true">♠️</span> พร้อมเปิดบัญชีเดิมพันกับ UFA168 แล้วหรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#e6dcc2]/90 md:text-base">
        สมัคร UFA168 ได้ด้วยตนเองทั้งบนมือถือ แท็บเล็ต และคอมพิวเตอร์ เปิดบัญชีใหม่ ตรวจสอบโปรโมชั่นที่บัญชีมีสิทธิ์รับ แล้วเลือกเกมเดิมพันได้ครบทุกหมวดในบัญชีเดียว
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#f3db5b] bg-gradient-to-b from-[#fff3bf] to-[#a37c14] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#050403] shadow-[0_0_15px_rgba(243,219,91,0.45)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🚀</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#d4af37] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[100, 200, 300]}
                sizes="100px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(243,219,91,0.55)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-b from-[#fff3bf] to-[#a37c14] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(243,219,91,0.5)]">UFA168</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#bdb08c]">
          UFA168 รวมเกมเดิมพันออนไลน์หลายประเภทไว้ในบัญชีเดียว ทั้งเกมสล็อต บาคาร่า คาสิโนสด เกมไพ่ กีฬา และหวย รองรับการใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์
          สมาชิกสามารถเลือกเกม ตรวจสอบโปรโมชั่น ฝากถอน และจัดการข้อมูลผ่านระบบออนไลน์ พร้อมโปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไข และแอดมินดูแลผ่าน LINE Official ตลอด 24 ชั่วโมง
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/30 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.1)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>
        </div>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">
                  📍
                </span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a
                  href={`mailto:${BRAND_ADDRESS.email}`}
                  class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">
                    ✉️
                  </span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }
      </div>

      <div class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#fff3bf] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#a37c14] to-[#f3db5b] shadow-[0_0_8px_rgba(243,219,91,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          <a href="/" class="group flex items-center text-[#bdb08c] transition-colors hover:text-[#fff3bf]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#f3db5b] transition-transform group-hover:rotate-45"></span> หน้าแรก
          </a>
          <a href="/promotion" class="group flex items-center text-[#bdb08c] transition-colors hover:text-[#fff3bf]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#f3db5b] transition-transform group-hover:rotate-45"></span> โปรโมชั่นสมาชิก
          </a>
          <a href="/ทดลองเล่น" class="group flex items-center text-[#bdb08c] transition-colors hover:text-[#fff3bf]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#f3db5b] transition-transform group-hover:rotate-45"></span> ทดลองเล่น
          </a>
          <a href="/ทางเข้า" class="group flex items-center text-[#bdb08c] transition-colors hover:text-[#fff3bf]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#f3db5b] transition-transform group-hover:rotate-45"></span> ทางเข้าล่าสุด
          </a>
          <a href="/about-us" class="group flex items-center text-[#bdb08c] transition-colors hover:text-[#fff3bf]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#f3db5b] transition-transform group-hover:rotate-45"></span> เกี่ยวกับเรา
          </a>
          <a href="/register" class="group flex items-center text-[#bdb08c] transition-colors hover:text-[#fff3bf]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#f3db5b] transition-transform group-hover:rotate-45"></span> สมัครสมาชิก
          </a>
          <a href="/login" class="group flex items-center text-[#bdb08c] transition-colors hover:text-[#fff3bf]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#f3db5b] transition-transform group-hover:rotate-45"></span> เข้าสู่ระบบ
          </a>
          <a href="/contact-us" class="group flex items-center text-[#bdb08c] transition-colors hover:text-[#fff3bf]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#f3db5b] transition-transform group-hover:rotate-45"></span> ติดต่อแอดมิน
          </a>
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#fff3bf] uppercase">
          ระบบการเงิน
          <span class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#a37c14] to-[#f3db5b] shadow-[0_0_8px_rgba(243,219,91,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#bdb08c]">รองรับการฝาก-ถอนผ่านแอปธนาคารชั้นนำและ TrueMoney Wallet โดยควรใช้บัญชีชื่อเดียวกับข้อมูลที่สมัครไว้</p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-white/5 bg-[#241a08] transition-colors hover:border-[#f3db5b]/50" title="ตรวจสอบรายการฝากถอนย้อนหลัง">
          <span class="flex items-center gap-1 text-xs font-bold text-[#e6dcc2]"><span aria-hidden="true" class="text-lg text-[#f3db5b]">🧾</span> ตรวจสอบสถานะธุรกรรมได้ในบัญชีสมาชิก</span>
        </div>
      </div>
    </div>

    <hr class="mb-6 border-[#241a08]" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#bdb08c] md:block">
      UFA168 เป็นช่องทางสำหรับผู้ที่ต้องการรวมเกมเดิมพันออนไลน์หลายประเภทไว้ในบัญชีเดียว ทั้งเกมสล็อต บาคาร่า คาสิโนสด เกมไพ่ กีฬา และหวย โดยจัดหมวดหมู่ไว้เพื่อให้สมาชิกค้นหาเกมที่สนใจได้สะดวก
      สำหรับข้อมูลเรื่องลิขสิทธิ์หรือผู้ให้บริการเกม ควรตรวจสอบจากข้อมูลของค่ายเกมที่แสดงอยู่ในระบบโดยตรง เนื่องจากแต่ละเกมอาจมาจากผู้พัฒนาหรือผู้ให้บริการแตกต่างกัน ก่อน Login
      หรือทำรายการฝากเงิน ควรตรวจสอบว่ากำลังใช้งานช่องทางของผู้ให้บริการที่ถูกต้อง และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น ผลของเกมเดิมพันมีความไม่แน่นอน
      จึงไม่มีเกมหรือบัญชีผู้เล่นใดที่รับประกันผลตอบแทนได้ โปรโมชั่นแต่ละรายการมีวิธีคำนวณ รอบการรับ และข้อกำหนดการถอนแตกต่างกัน แนะนำให้อ่านรายละเอียดล่าสุดก่อนกดรับทุกครั้ง
      ใช้งานได้ทั้ง Android iOS และคอมพิวเตอร์ผ่านเบราว์เซอร์โดยไม่ต้องติดตั้งโปรแกรมเพิ่ม พร้อมแอดมิน UFA168 ตรวจสอบรายการให้ตลอด 24 ชั่วโมง
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-white/5 pt-6 text-xs text-[#bdb08c] md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-[#fff3bf] uppercase">UFA168</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/terms/" class="transition-colors hover:text-[#fff3bf]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#fff3bf]">นโยบายความเป็นส่วนตัว</a>

        <a
          href="#top"
          class="flex h-8 w-8 items-center justify-center rounded border border-white/10 bg-white/5 text-[#e6dcc2] transition-all hover:border-[#f3db5b] hover:bg-[#241a08] hover:shadow-[0_0_15px_rgba(243,219,91,0.5)]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
