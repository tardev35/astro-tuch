---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt =
  "โลโก้ หวย24 บนพื้นโปร่งใส ด้านซ้ายเป็นวงกลมสีแดงไล่เงาโลหะ ข้างในมีเลข 24 สีขาวอยู่ในวงแหวนขาว ถัดมาเป็นตัวอักษรไทยหนาสามมิติคำว่า หวย สีขาวโครเมียมไล่แสง ปิดท้ายด้วยเลข 24 ตัวหนาสามมิติสีแดงไล่เงา";

// หวย24 (รอบแดงแบรนด์-ทอง บนดำอมแดง 2026-10-04): footer ที่ใช้งานจริงรอบนี้ —
// รอบก่อน (หวยคิง) ใช้ FooterHuay จึงหมุนมาที่ไฟล์นี้ ของเดิมที่ค้างอยู่ในไฟล์เป็น
// เขียวมรกต-แดงสด-ทองของ DM899 (#030a05 #0a1a0e #102a16 #01a326 #12c23a #fb252b
// #ffe9a8 #f2b422 #a8780f #e4f2e4 #06140a #0a4a18 #4ade6b) ย้ายทั้งไฟล์มาเป็น
// แดง-ทองบนดำอมแดงตามโลโก้จริงแล้ว ไม่เหลือเขียวชุดเดิมเลย
//
// แกนสีที่ใช้: พื้นดำอมแดง #0a0303 ยกระดับด้วย #170707 / #230d0d · แดงแบรนด์
// #d20a0a (vivid ของ logo.webp) เป็นเส้นคั่น จุดนำลิงก์ และขอบการ์ด · แดงสว่าง
// #ff3b3b เป็นปลายไล่เฉดด้านสว่าง · ทองแบรนด์ #f5c33b เป็นฮิวที่สอง อยู่ปลาย
// ไล่เฉดและเส้นใต้หัวคอลัมน์ (ตามแบนเนอร์ที่ตัวอักษร หวย24 เป็นทองโลหะบนผ้าไหมแดง)
// ทองสว่าง #ffd45e สงวนไว้ให้หัวคอลัมน์ ชื่อแบรนด์ และปุ่มสมัคร · เนื้อความ
// #f7e2d6 (BRAND_TEXT ของรอบนี้) ลดน้ำหนักด้วย opacity
//
// คอปปี้ทั้งไฟล์เขียนใหม่จากบรีฟ หวย24 ซึ่งเป็น **เว็บแทงหวยออนไลน์ ไม่ใช่สล็อต/
// คาสิโน** บรีฟรอบนี้พูดเรื่องหวยลาว หวยฮานอย รัฐบาลไทย รอบเปิดรับ อัตราจ่าย
// 2 ตัว 100 บาท / 3 ตัว 1,000 บาท เลขเด็ด เลขดัง วงเงินรับแทง ส่งโพย ประวัติโพย
// ผลรางวัล แนวทางหวย สมัคร 3 ขั้นตอน และแอดมิน 24 ชั่วโมงเท่านั้น ไม่ได้ระบุ
// ใบอนุญาต ผู้ให้บริการ ชื่อธนาคาร ยอดขั้นต่ำ เวลาออกรางวัล หรือจำนวนสมาชิกใดไว้
// จึงไม่มีในข้อความนี้ และประโยคกำกับของบรีฟเอง (คำว่า "รับไม่อั้น"/"จ่ายเต็มทุกโพย"
// ควรยึดวงเงินจริงที่ระบบแสดง · คำว่า "เรทจ่ายสูงที่สุด" ควรมีข้อมูลเปรียบเทียบที่
// ตรวจสอบได้) ขนมาด้วย ไม่ตัดทิ้ง
//
// ลิงก์: หวย24 เป็นเว็บหวยจริง — /ตรวจหวย กับ /แนวทาง อยู่ใน src/pages/ และเป็น
// route จริงรอบนี้ จึงมีลิงก์ทั้งสองตัวในคอลัมน์ลิงก์ด่วน ถ้ารอบหน้าเป็นแบรนด์
// สล็อต/คาสิโนแล้วย้ายไฟล์กลับไป pages-disabled ต้องถอดสองลิงก์นี้ออกพร้อมกัน
// ไม่งั้น verify-build.mjs จะทำให้ build แดงเพราะ href ชี้ไป route ที่ไม่มีใน dist/
//
// /ทางเข้า ยังมีลิงก์อยู่ตรงนี้: หน้านั้นยัง route และ index อยู่ แค่ไม่มีใน
// เมนู navbar เพราะ toggle ของ register/login เปิด (ดู NavbarStyle10.astro)
//
// ปุ่มพื้นทองใช้ตัวอักษรหมึกเข้ม #1a0303 — พื้นทองสว่างกับตัวอักษรอ่อนอ่านไม่ออก
// (#1a0303 บน #ffd45e = 14.9:1 · บน #f5c33b = 11.1:1 ผ่าน AA ทั้งคู่)
//
// บล็อก <address> ตั้งใจไม่ทาสีแบรนด์ — border-white/15 + bg-black/20 + opacity
// บนสีตัวอักษรที่ inherit มา ลงตัวกับ footer ทุกตัวในไลบรารี ห้าม retheme
---

<footer
  class="relative mt-32 w-full border-t border-[#d20a0a]/55 bg-[#0a0303] pt-64 pb-6 font-sans text-[#f7e2d6] shadow-[0_-10px_30px_rgba(210,10,10,0.20)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#d20a0a]/70 bg-gradient-to-r from-[#170707] via-[#230d0d] to-[#170707] p-6 shadow-[0_15px_40px_rgba(0,0,0,0.7)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#ffd45e] uppercase italic drop-shadow-[0_2px_4px_rgba(0,0,0,0.6)] md:text-3xl">
        <span aria-hidden="true">🎫</span> พร้อมส่งโพยกับ {BRAND_NAME} แล้วหรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#f7e2d6]/90 md:text-base">
        สมัคร {BRAND_NAME} ได้ด้วยตนเองทั้งบนมือถือและคอมพิวเตอร์ ติดตามหวยลาว หวยฮานอย และรัฐบาลไทยได้จากบัญชีเดียว พร้อมตรวจสอบรอบเปิดรับ อัตราจ่าย
        และประวัติโพยก่อนยืนยันรายการทุกครั้ง
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#a9761a] bg-gradient-to-b from-[#ffd45e] to-[#f5c33b] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#1a0303] shadow-[0_0_15px_rgba(245,195,59,0.45)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🚀</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#230d0d] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[100, 200, 300]}
                sizes="100px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(210,10,10,0.6)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-r from-[#ff5c5c] via-[#ffd45e] to-[#d20a0a] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(210,10,10,0.6)]">{BRAND_NAME}</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#f7e2d6]/75">
          {BRAND_NAME} เป็นเว็บแทงหวยออนไลน์ที่รวมรายการหวยและแนวทางหวยไว้ให้ติดตามผ่านมือถือ มีทั้งหวยลาว หวยฮานอย และรัฐบาลไทย พร้อมข้อมูลรอบเปิดรับ อัตราจ่าย
          และผลรางวัล สมาชิกเลือกเลขเด็ด เลขดัง หรือชุดตัวเลขที่สนใจแล้วตรวจสอบรายละเอียดก่อนส่งโพยได้ตลอดช่วงที่แต่ละรายการเปิดให้เดิมพัน แม้ระบบเว็บไซต์จะเข้าใช้งานได้
          24 ชั่วโมง แต่เวลารับแทงจริงยังขึ้นอยู่กับกำหนดเปิดและปิดของหวยแต่ละรอบ ส่วนคำว่า “รับไม่อั้น” และ “จ่ายเต็มทุกโพย” ควรยึดตามวงเงินและเงื่อนไขจริงที่ระบบแสดง
          เนื่องจากเลขที่มียอดเดิมพันสูงอาจมีวงเงินรับแตกต่างจากเลขทั่วไป
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/40 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.12)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>
        </div>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }
      </div>

      <nav aria-label="ลิงก์ด่วน" class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#ffd45e] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#ff3b3b] to-[#f5c33b] shadow-[0_0_8px_rgba(210,10,10,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          <a href="/" class="group flex items-center text-[#f7e2d6]/75 transition-colors hover:text-[#ffd45e]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#ff3b3b] transition-transform group-hover:rotate-45"></span> หน้าแรก
          </a>
          <a href="/promotion" class="group flex items-center text-[#f7e2d6]/75 transition-colors hover:text-[#ffd45e]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#ff3b3b] transition-transform group-hover:rotate-45"></span> โปรโมชั่นสมาชิก
          </a>
          <a href="/ตรวจหวย" class="group flex items-center text-[#f7e2d6]/75 transition-colors hover:text-[#ffd45e]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#ff3b3b] transition-transform group-hover:rotate-45"></span> ตรวจหวย
          </a>
          <a href="/แนวทาง" class="group flex items-center text-[#f7e2d6]/75 transition-colors hover:text-[#ffd45e]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#ff3b3b] transition-transform group-hover:rotate-45"></span> แนวทางหวย
          </a>
          <a href="/ทดลองเล่น" class="group flex items-center text-[#f7e2d6]/75 transition-colors hover:text-[#ffd45e]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#ff3b3b] transition-transform group-hover:rotate-45"></span> ทดลองเล่น
          </a>
          <a href="/ทางเข้า" class="group flex items-center text-[#f7e2d6]/75 transition-colors hover:text-[#ffd45e]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#ff3b3b] transition-transform group-hover:rotate-45"></span> ทางเข้าล่าสุด
          </a>
          <a href="/register" class="group flex items-center text-[#f7e2d6]/75 transition-colors hover:text-[#ffd45e]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#ff3b3b] transition-transform group-hover:rotate-45"></span> สมัครสมาชิก
          </a>
          <a href="/login" class="group flex items-center text-[#f7e2d6]/75 transition-colors hover:text-[#ffd45e]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#ff3b3b] transition-transform group-hover:rotate-45"></span> เข้าสู่ระบบ
          </a>
          <a href="/about-us" class="group flex items-center text-[#f7e2d6]/75 transition-colors hover:text-[#ffd45e]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#ff3b3b] transition-transform group-hover:rotate-45"></span> เกี่ยวกับเรา
          </a>
          <a href="/contact-us" class="group flex items-center text-[#f7e2d6]/75 transition-colors hover:text-[#ffd45e]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#ff3b3b] transition-transform group-hover:rotate-45"></span> ติดต่อแอดมิน
          </a>
        </div>
      </nav>

      <section aria-label="ช่องทางทำรายการ" class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#ffd45e] uppercase">
          ช่องทางทำรายการ
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#ff3b3b] to-[#f5c33b] shadow-[0_0_8px_rgba(210,10,10,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#f7e2d6]/75">
          ก่อนทำรายการทุกครั้งควรตรวจสอบชื่อบัญชีปลายทางให้ตรงกับข้อมูลที่เว็บไซต์ประกาศ และเก็บเวลา จำนวนเงิน พร้อมหลักฐานธุรกรรมไว้สำหรับตรวจสอบย้อนหลัง
        </p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-[#d20a0a]/45 bg-[#170707] transition-colors hover:border-[#ff3b3b]/70">
          <span class="flex items-center gap-1 text-xs font-bold text-[#f7e2d6]"><span aria-hidden="true" class="text-lg text-[#f5c33b]">🎫</span> ตรวจสอบวงเงินรับแทงได้จากหน้าส่งโพย</span>
        </div>
      </section>
    </div>

    <hr class="mb-6 border-[#3d0a0a]" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#f7e2d6]/70 md:block">
      {BRAND_NAME} เป็นช่องทางสำหรับผู้ที่ต้องการติดตามรายการหวยและส่งโพยผ่านระบบเดียว รวมหวยลาวตามรอบที่เปิดรับ หวยฮานอยหลายช่วงเวลา และรัฐบาลไทยตามกำหนดออกรางวัล
      เข้าใช้งานผ่านเว็บเบราว์เซอร์ได้ทั้งบนมือถือและคอมพิวเตอร์ หลัง Login สามารถเลือกรายการหวย กรอกเลขที่ต้องการ ตรวจสอบวงเงินและอัตราจ่าย แล้วดูประวัติโพยย้อนหลังได้
      จากบัญชีเดียว รายการที่เปิดให้เดิมพันในแต่ละวันขึ้นอยู่กับกำหนดเปิดและปิดของหวยแต่ละรอบ จึงอาจไม่เท่ากันทุกวัน อัตรา 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท
      ใช้กับรายการที่เข้าเงื่อนไขเท่านั้น หวยแต่ละประเภทหรือรูปแบบการเดิมพันอาจมีเรทแตกต่างกัน จึงควรยึดอัตราล่าสุดบนหน้าส่งโพยเป็นหลัก ส่วนข้อความว่า “เรทจ่ายสูงที่สุด”
      ควรมีข้อมูลเปรียบเทียบกับผู้ให้บริการรายอื่นที่ตรวจสอบได้รองรับ หากไม่มีข้อมูลดังกล่าว การใช้คำว่า “เรทจ่ายสูง” จะเหมาะสมกว่า แนวทางหวยและเลขดังเป็นข้อมูลประกอบเท่านั้น
      ไม่สามารถรับประกันผลรางวัลของรอบถัดไปได้ การสมัครทำได้ผ่านมือถือใน 3 ขั้นตอน ควรใช้ข้อมูลของตนเองในการสมัคร ตรวจสอบเลขและจำนวนเงินก่อนยืนยันทุกครั้ง
      และไม่เปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น หากเป็นปัญหาเกี่ยวกับโพยควรเตรียมชื่อหวย รอบเวลา เลขที่เลือก และข้อมูลรายการไว้ให้พร้อม
      โดยมีแอดมิน {BRAND_NAME} ดูแลผ่านช่องทางไลน์ตลอด 24 ชั่วโมง
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-[#d20a0a]/40 pt-6 text-xs text-[#f7e2d6]/75 md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-[#ffd45e] uppercase">{BRAND_NAME}</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/terms/" class="transition-colors hover:text-[#ffd45e]">เงื่อนไขและข้อตกลง</a>
