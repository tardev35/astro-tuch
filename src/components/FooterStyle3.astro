---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่ง เป็นหน้ากอริลลาขนดำแซมเขียวสวมมงกุฎทองประดับพลอยสีเขียว มีใบไม้เขียวแผ่อยู่ด้านหลังและกำปั้นสองข้างวางอยู่ด้านหน้า ใต้ลงมาเป็นคำว่า KINGKONG ตัวอักษรหนาสามมิติสีเขียวมะนาว ต่อด้วยเลข 555 ตัวหนาสีเงิน`;

// KINGKONG555 (รอบเขียวป่า-ทองมงกุฎบนเขียวเกือบดำ 2026-10-09): footer ที่ใช้งานจริง
// รอบนี้ — รอบก่อน (WEPLAY168) ใช้ FooterCyber จึงหมุนกลับมาที่ไฟล์นี้ ของเดิมที่
// ค้างอยู่ในไฟล์เป็นฟ้าสด-เหลืองมะนาวบนกรมท่าเกือบดำของ แตกดี168 (#0193fb #fce604
// #7bcffb #dbeafe #fff48a #020609 #07111d #0b3c66 #c9a703 #031018
// rgba(1,147,251,α) rgba(252,230,4,α)) ย้ายทั้งไฟล์มาเป็นเขียวป่า-ทองมงกุฎตาม
// โลโก้จริงแล้ว ไม่เหลือชุดฟ้า-เหลืองเดิมเลย
//
// footer เป็น "โครม" จึงประกาศสีตัวอักษรของตัวเองครบทุกจุด ไม่ได้ inherit
// BRAND_TEXT และโลโก้ที่เป็นเขียวมะนาว-ทองต้องการพื้นเข้มถึงจะอ่านออก
//
// แกนสีที่ใช้ (brand-spec §2): พื้นเขียวป่าเกือบดำ #051400 ยกระดับด้วย #0f2e05 /
// #1a5c04 · เขียวมะนาว #8ce023 (ตัวอักษร KINGKONG บนโลโก้) เป็นเส้นคั่น ขอบการ์ด
// และออรา · เขียวอ่อน #bde397 เป็นจุดนำลิงก์และปลายไล่เฉดด้านสว่าง · ทองมงกุฎ
// #f2c230 (มงกุฎของกอริลลา) เป็นฮิวที่สอง สงวนไว้ให้หัวคอลัมน์ ชื่อแบรนด์ และ
// ปุ่มสมัคร · ทองอ่อน #ffe066 กับทองเข้ม #a87a08 เป็นสองปลายของไล่เฉดปุ่ม ·
// เนื้อความ #e9f7d6 ลดน้ำหนักด้วย opacity
//
// คอปปี้ทั้งไฟล์เขียนใหม่จากบรีฟ KINGKONG555 ซึ่งเป็น **เว็บสล็อตออนไลน์ล้วน ไม่ใช่
// เว็บหวยและไม่ใช่คาสิโนรวมหมวด** บรีฟรอบนี้พูดเรื่องฐานเว็บสล็อตหลักที่รวมสล็อต
// คลาสสิก ฟรีสปิน โบนัส และตัวคูณไว้ในแพลตฟอร์มเดียว เดิมพันเริ่มต้น 1 บาทในเกม
// ที่กำหนด เข้าเล่นผ่านมือถือ 24 ชั่วโมง โปรโมชั่นคืนยอดเสีย 0.3% แนะนำเพื่อน 0.8%
// ฝากถอนเข้าบริษัทโดยตรง และแอดมิน 24 ชั่วโมง เท่านั้น ไม่ได้ระบุใบอนุญาต ชื่อค่าย
// เกม ชื่อผู้ให้บริการ ชื่อธนาคาร ยอดขั้นต่ำ ค่า RTP หรือจำนวนสมาชิกใดไว้ จึงไม่มี
// ในข้อความนี้ และประโยคกำกับของบรีฟเอง (เว็บแท้/ปลอดภัยควรมีข้อมูลผู้ให้บริการที่
// ตรวจสอบได้รองรับ · ผลการหมุนเป็นแบบสุ่ม · ชื่อบัญชีบริษัทอย่างเดียวไม่รับประกัน
// ความปลอดภัย · คำว่าไม่จำกัดควรตรวจสอบเงื่อนไข) ขนมาด้วย ไม่ตัดทิ้ง
//
// ลิงก์: KINGKONG555 เป็นเว็บสล็อต — /ตรวจหวย กับ /แนวทาง อยู่ใน src/pages-disabled/
// รอบนี้ จึงไม่มีสองลิงก์นั้นในคอลัมน์ลิงก์ด่วน ไม่งั้น verify-build.mjs จะทำให้
// build แดงเพราะ href ชี้ไป route ที่ไม่มีใน dist/ ถ้ารอบหน้าเป็นแบรนด์หวยแล้วย้าย
// ไฟล์กลับเข้า src/pages/ ต้องเพิ่มสองลิงก์นี้คืนพร้อมกัน
//
// /register กับ /login รอบนี้เป็นหน้าปุ่มจริงที่ index ได้ (toggle cta เปิด) ส่วน
// /ทางเข้า ถูกถอดออกจากเมนู navbar รอบนี้ แต่ route ยังมีจริงและยัง index อยู่
// ลิงก์จาก footer จึงยังถูกต้องทั้งสามหน้า (ดู NavbarStyle10.astro)
//
// ปุ่มพื้นทองใช้ตัวอักษรหมึกเขียวเข้ม #06220a — พื้นทองสว่างกับตัวอักษรอ่อนอ่านไม่ออก
// (#06220a บน #ffe066 = 15.2:1 · บน #f2c230 = 13.1:1 ผ่าน AA ทั้งคู่)
//
// บล็อก <address> ตั้งใจไม่ทาสีแบรนด์ — border-white/15 + bg-black/20 + opacity
// บนสีตัวอักษรที่ inherit มา ลงตัวกับ footer ทุกตัวในไลบรารี ห้าม retheme
---

<footer
  class="relative mt-32 w-full border-t border-[#8ce023]/55 bg-[#051400] pt-64 pb-6 font-sans text-[#e9f7d6] shadow-[0_-10px_30px_rgba(140,224,35,0.22)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#f2c230]/70 bg-gradient-to-r from-[#0f2e05] via-[#1a5c04] to-[#0f2e05] p-6 shadow-[0_15px_40px_rgba(5,20,0,0.75)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#f2c230] uppercase italic drop-shadow-[0_2px_4px_rgba(5,20,0,0.6)] md:text-3xl">
        <span aria-hidden="true">🦍</span> พร้อมเริ่มหมุนสล็อตกับ {BRAND_NAME} แล้วหรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#e9f7d6]/90 md:text-base">
        สมัคร {BRAND_NAME} ได้ด้วยตนเองผ่านมือถือ กรอกข้อมูลตามที่ระบบกำหนดแล้วเข้าสู่ระบบเพื่อเลือกค่าย เลือกเกมสล็อต ตรวจสอบเครดิต และติดตามรายการต่างๆ จากบัญชีเดียว
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#a87a08] bg-gradient-to-b from-[#ffe066] to-[#f2c230] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#06220a] shadow-[0_0_15px_rgba(242,194,48,0.45)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🚀</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#1a5c04] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[100, 200, 300]}
                sizes="100px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(140,224,35,0.6)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-r from-[#ffe066] via-[#f2c230] to-[#8ce023] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(140,224,35,0.6)]">{BRAND_NAME}</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#e9f7d6]/75">
          {BRAND_NAME} เป็นฐานเว็บสล็อตหลักที่รวบรวมเกมสล็อตหลายรูปแบบไว้ในแพลตฟอร์มเดียว มีทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน และตัวคูณ พร้อมทางเข้าเล่นผ่านมือถือได้ตลอด
          24 ชั่วโมง สมาชิกสามารถเลือกค่าย ตรวจสอบเครดิต และติดตามรายการต่างๆ ได้จากบัญชีเดียว สำหรับเกมที่รองรับการเดิมพันเริ่มต้น 1 บาทสามารถเลือกเล่นตามงบได้ แต่ยอด
          ขั้นต่ำอาจแตกต่างกันตามค่ายและเกมที่เลือก จึงควรตรวจสอบช่วงเดิมพันที่แสดงในเกมก่อนเริ่มเล่น ส่วนการยืนยันว่าเป็นเว็บแท้และปลอดภัย ควรมีข้อมูลผู้ให้บริการที่ตรวจสอบได้รองรับ
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/40 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.12)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>
        </div>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }
      </div>

      <nav aria-label="ลิงก์ด่วน" class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#f2c230] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#8ce023] to-[#f2c230] shadow-[0_0_8px_rgba(140,224,35,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          <a href="/" class="group flex items-center text-[#e9f7d6]/75 transition-colors hover:text-[#f2c230]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#bde397] transition-transform group-hover:rotate-45"></span> หน้าแรก
          </a>
          <a href="/promotion" class="group flex items-center text-[#e9f7d6]/75 transition-colors hover:text-[#f2c230]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#bde397] transition-transform group-hover:rotate-45"></span> โปรโมชั่นสมาชิก
          </a>
          <a href="/ทดลองเล่น" class="group flex items-center text-[#e9f7d6]/75 transition-colors hover:text-[#f2c230]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#bde397] transition-transform group-hover:rotate-45"></span> ทดลองเล่นสล็อต
          </a>
          <a href="/ทางเข้า" class="group flex items-center text-[#e9f7d6]/75 transition-colors hover:text-[#f2c230]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#bde397] transition-transform group-hover:rotate-45"></span> ทางเข้าล่าสุด
          </a>
          <a href="/register" class="group flex items-center text-[#e9f7d6]/75 transition-colors hover:text-[#f2c230]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#bde397] transition-transform group-hover:rotate-45"></span> สมัครสมาชิก
          </a>
          <a href="/login" class="group flex items-center text-[#e9f7d6]/75 transition-colors hover:text-[#f2c230]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#bde397] transition-transform group-hover:rotate-45"></span> เข้าสู่ระบบ
          </a>
          <a href="/about-us" class="group flex items-center text-[#e9f7d6]/75 transition-colors hover:text-[#f2c230]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#bde397] transition-transform group-hover:rotate-45"></span> เกี่ยวกับเรา
          </a>
          <a href="/contact-us" class="group flex items-center text-[#e9f7d6]/75 transition-colors hover:text-[#f2c230]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#bde397] transition-transform group-hover:rotate-45"></span> ติดต่อแอดมิน
          </a>
        </div>
      </nav>

      <section aria-label="ช่องทางทำรายการ" class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#f2c230] uppercase">
          ช่องทางทำรายการ
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#8ce023] to-[#f2c230] shadow-[0_0_8px_rgba(140,224,35,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#e9f7d6]/75">
          ก่อนทำรายการทุกครั้งควรตรวจสอบชื่อบัญชีปลายทางให้ตรงกับข้อมูลจากช่องทางหลักของเว็บไซต์ และเก็บเวลา จำนวนเงิน พร้อมหลักฐานธุรกรรมไว้สำหรับตรวจสอบย้อนหลัง
        </p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-[#8ce023]/45 bg-[#0f2e05] transition-colors hover:border-[#bde397]/70">
          <span class="flex items-center gap-1 text-xs font-bold text-[#e9f7d6]"><span aria-hidden="true" class="text-lg text-[#f2c230]">🎰</span> ตรวจสอบช่องทางที่ระบบรองรับก่อนทำรายการ</span>
        </div>
      </section>
    </div>

    <hr class="mb-6 border-[#1a5c04]" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#e9f7d6]/70 md:block">
      {BRAND_NAME} เป็นช่องทางสำหรับผู้ที่ต้องการเข้าเล่นเกมสล็อตออนไลน์จากฐานเว็บหลักเดียว มีทั้งสล็อตวงล้อทั่วไปที่รูปแบบการเล่นเข้าใจง่าย เกมโบนัสที่มีรอบพิเศษ
      ฟรีสปิน ตัวคูณ และเกมที่มีฟีเจอร์เพิ่มเติมตามรายการที่เปิดให้บริการ เข้าใช้งานผ่านเว็บเบราว์เซอร์ได้ทั้งบนมือถือและคอมพิวเตอร์ตลอด 24 ชั่วโมง หลังเข้าสู่ระบบ
      สามารถเลือกค่าย ค้นหาเกม ตรวจสอบเครดิต แล้วย้อนดูรายการต่างๆ ได้จากบัญชีเดียวโดยไม่ต้องสมัครใหม่หลายครั้ง จำนวนค่ายและเกมที่เปิดให้บริการอาจเปลี่ยนแปลงตาม
      ช่วงเวลา จึงควรตรวจสอบรายละเอียดล่าสุดจากระบบก่อนเริ่มเล่น สำหรับเกมสล็อตเบทต่ำที่เริ่มต้นได้ตั้งแต่ 1 บาท ช่วยให้แบ่งงบสำหรับแต่ละรอบได้ชัดเจนขึ้น แต่ไม่ได้
      หมายความว่าจะมีโอกาสชนะมากกว่าเกมเดิมพันสูง เนื่องจากผลการหมุนเป็นแบบสุ่ม และแต่ละเกมอาจกำหนดยอดขั้นต่ำแตกต่างกัน โปรโมชั่นคืนยอดเสีย 0.3% และแนะนำเพื่อน
      0.8% คำนวณจากยอดที่เข้าเกณฑ์ตามรอบที่กำหนด แต่ละรายการอาจมีรอบตัดยอด ค่ายเกมที่ร่วมรายการ และข้อกำหนดแตกต่างกัน จึงควรตรวจสอบเงื่อนไขล่าสุดก่อนกดรับสิทธิ์
      ส่วนคำว่าไม่จำกัดในกิจกรรมแนะนำเพื่อน ควรตรวจสอบว่าหมายถึงจำนวนเพื่อน จำนวนครั้งในการรับสิทธิ์ หรือวงเงินโบนัส หากเว็บไซต์ระบุว่าเงินฝากเข้าบัญชีบริษัทโดยตรง
