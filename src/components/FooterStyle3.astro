---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
---

<footer
  class="relative mt-32 w-full border-t border-[#ea580c]/30 bg-[#170a03] pt-64 pb-6 font-sans text-[#fbe6d8] shadow-[0_-10px_30px_rgba(234,88,12,0.15)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#ea580c]/35 bg-gradient-to-r from-[#0f0500] via-[#2a1206] to-[#0f0500] p-6 shadow-[0_15px_40px_rgba(234,88,12,0.25)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#fde68a] uppercase italic drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)] md:text-3xl">
        <span aria-hidden="true">🎡</span> พร้อมร่วมสนุกกับ FUN24 แล้วหรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#fbe6d8]/90 md:text-base">
        สมัคร FUN24 ผ่านระบบออนไลน์ภายในไม่กี่นาที ฝากถอนอัตโนมัติตลอด 24 ชั่วโมง แล้วเลือกเล่นเกมเดิมพันครบทุกหมวดได้ทันทีบนมือถือ
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#fde68a] bg-gradient-to-b from-[#fde68a] to-[#c2410c] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-white shadow-[0_0_15px_rgba(255,86,34,0.4)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🚀</span></span>
      <div class="absolute inset-0 translate-y-full bg-[#ea580c] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ FUN24"
                widths={[100, 200, 300]}
                sizes="100px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(255,86,34,0.6)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-b from-[#fde68a] to-[#c2410c] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(255,86,34,0.5)]">FUN24</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#d9b08c]">
          FUN24 เว็บรวมเกมเดิมพันออนไลน์ทุกหมวดครบวงจร รองรับคาสิโน บาคาร่า สล็อต ยิงปลา กีฬา และหวย พร้อมระบบฝากถอนอัตโนมัติที่ปลอดภัยและทีมงานดูแลตลอด 24 ชั่วโมง
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/30 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.1)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>
        </div>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }
      </div>

      <div class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#fbe6d8] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#c2410c] to-[#fde68a] shadow-[0_0_8px_rgba(255,86,34,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          <a href="/" class="group flex items-center text-[#d9b08c] transition-colors hover:text-[#fde68a]">
            <span class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#fb923c] transition-transform group-hover:rotate-45"></span> หน้าแรก
          </a>
          <a href="/ทดลองเล่น" class="group flex items-center text-[#d9b08c] transition-colors hover:text-[#fde68a]">
            <span class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#fb923c] transition-transform group-hover:rotate-45"></span> ทดลองเล่นเกมฟรี
          </a>
          <a href="/promotion" class="group flex items-center text-[#d9b08c] transition-colors hover:text-[#fde68a]">
            <span class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#fb923c] transition-transform group-hover:rotate-45"></span> โปรโมชั่นสมาชิกใหม่
          </a>
          <a href="/ทางเข้า" class="group flex items-center text-[#d9b08c] transition-colors hover:text-[#fde68a]">
            <span class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#fb923c] transition-transform group-hover:rotate-45"></span> ทางเข้าล่าสุด
          </a>
          <a href="/about-us" class="group flex items-center text-[#d9b08c] transition-colors hover:text-[#fde68a]">
            <span class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#fb923c] transition-transform group-hover:rotate-45"></span> เกี่ยวกับเรา
          </a>
          <a href="/register" class="group flex items-center text-[#d9b08c] transition-colors hover:text-[#fde68a]">
            <span class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#fb923c] transition-transform group-hover:rotate-45"></span> สมัครสมาชิก
          </a>
          <a href="/contact-us" class="group flex items-center text-[#d9b08c] transition-colors hover:text-[#fde68a]">
            <span class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#fb923c] transition-transform group-hover:rotate-45"></span> ติดต่อแอดมิน
          </a>
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#fbe6d8] uppercase">
          ระบบการเงิน
          <span class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#c2410c] to-[#fde68a] shadow-[0_0_8px_rgba(255,86,34,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#d9b08c]">รองรับการฝาก-ถอนผ่านแอปธนาคารชั้นนำและ TrueMoney Wallet โดยควรใช้บัญชีชื่อเดียวกับข้อมูลที่สมัครไว้</p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-white/5 bg-[#0f0500] transition-colors hover:border-[#fb923c]/50" title="ตรวจบิลย้อนหลัง">
          <span class="flex items-center gap-1 text-xs font-bold text-[#fbe6d8]"><span aria-hidden="true" class="text-lg text-[#fb923c]">🧾</span> เก็บเลขรายการไว้ตรวจสอบได้</span>
        </div>
      </div>
    </div>

    <hr class="mb-6 border-[#c2410c]/25" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#b98a63] md:block">
      FUN24 เว็บรวมเกมเดิมพันออนไลน์ คาสิโน บาคาร่า สล็อต ยิงปลา กีฬา หวย ฝากถอนออโต้ ปลอดภัยได้มาตรฐาน ทางเข้าเว็บตรงล่าสุด สมัครสมาชิกใหม่ เล่นได้ทั้งมือถือและคอมพิวเตอร์
      ทีมงานดูแลและให้คำแนะนำตลอด 24 ชั่วโมง ตรวจสอบรายการฝากถอนได้ด้วยตนเอง
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-white/5 pt-6 text-xs text-[#b98a63] md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-[#fbe6d8] uppercase">FUN24</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/terms/" class="transition-colors hover:text-[#fde68a]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#fde68a]">นโยบายความเป็นส่วนตัว</a>

        <a
          href="#top"
          class="flex h-8 w-8 items-center justify-center rounded border border-white/10 bg-white/5 text-[#fbe6d8] transition-all hover:border-[#fde68a] hover:bg-[#2a1206] hover:shadow-[0_0_15px_rgba(255,86,34,0.5)]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
