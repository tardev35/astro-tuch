                  alt={logoAlt}
                  widths={[180, 360]}
                  sizes="180px"
                  loading="lazy"
                  decoding="async"
                  class="h-auto w-full -translate-y-[52px] drop-shadow-[0_0_12px_rgba(238,174,18,0.65)]"
                  formats={["avif", "webp"]}
                  fallbackFormat="webp"
                  quality={72}
                />
              </span>
            ) : (
              <p class="bg-gradient-to-r from-[#fded41] via-[#eeae12] to-[#e0e0df] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(238,174,18,0.6)]">{BRAND_NAME}</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#f4ead6]/75">
          {BRAND_NAME} นำเสนอเกมสล็อตออนไลน์หลากหลายรูปแบบ พร้อมข้อมูลค่ายเกม ระบบทดลองเล่น และโปรโมชั่นสำหรับสมาชิก ภายในเว็บไซต์มีเมนูสำหรับศึกษากติกาเกม ตรวจสอบรายละเอียดการสมัคร และช่องทางฝากถอนก่อนใช้งาน
          ส่วนคำกล่าวอ้างเกี่ยวกับลิขสิทธิ์เกม ความน่าเชื่อถือ และการไม่ใช้บัญชีม้า ควรตรวจสอบจากหลักฐานของผู้ให้บริการและข้อมูลบัญชีรับเงินที่ยืนยันได้ ไม่ควรพิจารณาจากข้อความโฆษณาเพียงอย่างเดียว
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/40 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.12)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>
        </div>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }
      </div>

      <nav aria-label="ลิงก์ด่วน" class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#fded41] uppercase">
          ลิงก์ด่วน (Quick Links)
