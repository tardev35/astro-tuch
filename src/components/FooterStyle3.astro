---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
---

<footer
  class="relative mt-32 w-full border-t border-[#9a6d25]/30 bg-[#0a0603] pt-64 pb-6 font-sans text-[#f0e6c8] shadow-[0_-10px_30px_rgba(235,188,76,0.15)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#9a6d25]/35 bg-gradient-to-r from-[#1c140a] via-[#241705] to-[#160f06] p-6 shadow-[0_15px_40px_rgba(235,188,76,0.25)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#fcf3ab] uppercase italic drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)] md:text-3xl">
        <span aria-hidden="true">👑</span> พร้อมลุ้นแจ็คพอตกับ UFA24K แล้วหรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#f0e6c8]/90 md:text-base">
        สมัคร UFA24K ผ่านระบบออนไลน์ภายในไม่กี่นาที ฝากถอนอัตโนมัติตลอด 24 ชั่วโมง แล้วเลือกเล่นคาสิโนสด บาคาร่า หรือสล็อตได้ทันทีบนมือถือ
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#fcf3ab] bg-gradient-to-b from-[#fcf3ab] to-[#9a6d25] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#241705] shadow-[0_0_15px_rgba(235,188,76,0.4)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🚀</span></span>
      <div class="absolute inset-0 translate-y-full bg-[#ebbc4c] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="UFA24K"
                widths={[100, 200, 300]}
                sizes="100px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(235,188,76,0.6)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-b from-[#fcf3ab] to-[#9a6d25] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(235,188,76,0.5)]">UFA24K</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#c9bda0]">
          UFA24K บริการเกมคาสิโนออนไลน์บนมือถือและคอมพิวเตอร์ รองรับคาสิโนสด บาคาร่า สล็อต และกีฬา พร้อมระบบฝากถอนอัตโนมัติที่ปลอดภัยและทีมงานดูแลตลอด 24 ชั่วโมง
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/30 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.1)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>
          {/* A YOUTUBE button pointing at href="#" used to sit here. There is
              no YouTube channel to point it at, and a link that goes nowhere
              costs a visitor a tap to find that out. If a brand ever has one,
              add the button back with its real URL. */}
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#f0e6c8] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#9a6d25] to-[#fcf3ab] shadow-[0_0_8px_rgba(235,188,76,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          <a href="/" class="group flex items-center text-[#c9bda0] transition-colors hover:text-[#fcf3ab]">
            <span class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#ebbc4c] transition-transform group-hover:rotate-45"></span> หน้าแรก
          </a>
          <a href="/ทดลองเล่น" class="group flex items-center text-[#c9bda0] transition-colors hover:text-[#fcf3ab]">
            <span class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#ebbc4c] transition-transform group-hover:rotate-45"></span> ทดลองเล่นเกมฟรี
          </a>
          <a href="/promotion" class="group flex items-center text-[#c9bda0] transition-colors hover:text-[#fcf3ab]">
            <span class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#ebbc4c] transition-transform group-hover:rotate-45"></span> โปรโมชั่นสมาชิกใหม่
          </a>
          <a href="/ทางเข้า" class="group flex items-center text-[#c9bda0] transition-colors hover:text-[#fcf3ab]">
            <span class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#ebbc4c] transition-transform group-hover:rotate-45"></span> ทางเข้าล่าสุด
          </a>
          <a href="/register" class="group flex items-center text-[#c9bda0] transition-colors hover:text-[#fcf3ab]">
            <span class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#ebbc4c] transition-transform group-hover:rotate-45"></span> สมัครสมาชิก
          </a>
          <a href="/contact-us" class="group flex items-center text-[#c9bda0] transition-colors hover:text-[#fcf3ab]">
            <span class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#ebbc4c] transition-transform group-hover:rotate-45"></span> ติดต่อแอดมิน
          </a>
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#f0e6c8] uppercase">
          ระบบการเงิน
          <span class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#9a6d25] to-[#fcf3ab] shadow-[0_0_8px_rgba(235,188,76,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#c9bda0]">รองรับการฝาก-ถอนผ่านแอปธนาคารชั้นนำและ TrueMoney Wallet โดยควรใช้บัญชีชื่อเดียวกับข้อมูลที่สมัครไว้</p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-white/5 bg-[#1c140a] transition-colors hover:border-[#ebbc4c]/50" title="ตรวจบิลย้อนหลัง">
          <span class="flex items-center gap-1 text-xs font-bold text-[#f0e6c8]"><span aria-hidden="true" class="text-lg text-[#ebbc4c]">🧾</span> เก็บเลขรายการไว้ตรวจสอบได้</span>
        </div>
      </div>
    </div>

    <hr class="mb-6 border-[#9a6d25]/25" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#8b7f66] md:block">
      UFA24K คาสิโนออนไลน์ สล็อตออนไลน์ คาสิโนสด บาคาร่า ฝากถอนออโต้ ปลอดภัยได้มาตรฐาน ทางเข้าเว็บตรงล่าสุด สมัครสมาชิกใหม่ เล่นได้ทั้งมือถือและคอมพิวเตอร์
      ทีมงานดูแลและให้คำแนะนำตลอด 24 ชั่วโมง ตรวจสอบรายการฝากถอนได้ด้วยตนเอง
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-white/5 pt-6 text-xs text-[#8b7f66] md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-[#fcf3ab] uppercase">UFA24K</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/terms/" class="transition-colors hover:text-[#f0e6c8]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#f0e6c8]">นโยบายความเป็นส่วนตัว</a>

        {/* An anchor, not a button with onclick. Smooth scrolling comes from
            `scroll-behavior` in global.css, which the reduced-motion block
            there already overrides — the inline handler hardcoded
            behavior:'smooth' and ignored that preference. The label is Thai
            because the rest of this footer is. */}
        <a
          href="#top"
          class="flex h-8 w-8 items-center justify-center rounded border border-white/10 bg-white/5 text-[#f0e6c8] transition-all hover:border-[#fcf3ab] hover:bg-[#241705] hover:shadow-[0_0_15px_rgba(235,188,76,0.5)]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
