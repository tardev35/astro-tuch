---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt = `โลโก้ ${BRAND_NAME} เป็นเหรียญตราวงกลมขอบทอง กลางเหรียญเป็นลูกฟุตบอลทองคำวาววางอยู่บนถ้วยรางวัลทองที่มีหูจับโค้งสองข้าง ถัดลงมาเป็นตัวอักษร UFA สีทองสามมิติต่อด้วยเลข 324 สีเงินโครเมียม พาดกลางเหรียญ ใต้ตัวอักษรมีดาวห้าแฉกสีทองดวงเล็กและฐานถ้วยรางวัลสีทอง`;

// UFA324 (รอบทองแชมเปี้ยน-เงินโครเมียม 2026-10-11): footer ที่ใช้งานจริงรอบนี้ —
// รอบก่อน (FAH999) ใช้ Footer ไฟล์ฐาน จึงหมุนมาที่ไฟล์นี้ เหตุผลที่เลือกตัวนี้คือ
// "ทรง" ไม่ใช่สี: Footer / FooterPremium / FooterPremiumSumo / FooterHuay เป็นแผ่น
// rounded-t-[3rem] + ออราเหมือนกันหมดทั้งสี่ตัว ส่วนไฟล์นี้เป็นการ์ด CTA ลอยคร่อม
// ขอบบน (-top-14 / md:-top-16) แล้วตัวแผ่นเว้น pt-64 (md:pt-40) ไว้รับ — เป็นทรง
// เดียวในไลบรารีที่ไม่ซ้ำกับสี่ตัวนั้น
//
// ของเดิมที่ค้างอยู่ในไฟล์เป็นทองอวกาศ-เงินโครเมียมของ NAZA168 (#fbc134 #ffe87a
// #cf9a18 #96690a #cfd6e3 #fdf3df #4e3406 #432b03 #241700 #231500
// rgba(251,193,52,α) rgba(10,1,23,α)) ย้ายทั้งไฟล์มาเป็นทองแชมเปี้ยน-เงินโครเมียม
// บนพื้นดำสนิทตามโลโก้จริงแล้ว ไม่เหลือชุดเดิมเลย
// ⚠️ NAZA168 ก็เป็นคู่ "ทอง + เงินโครเมียม" เหมือนกันเป๊ะ การเจอทองคู่เงินในไฟล์นี้
// จึง **ไม่ได้แปลว่าเป็นของรอบนี้** ต้องเทียบเป็น "ค่า": #e5a81b ไม่ใช่ #fbc134 ·
// #b9c2cc ไม่ใช่ #cfd6e3 · #f0e8d4 ไม่ใช่ #fdf3df · #ffe08a ไม่ใช่ #ffe87a
// และที่ต่างกันจริงอีกอย่างคือ **พื้น**: NAZA168 เป็นน้ำตาลไหม้ #241700 ส่วนรอบนี้
// bg.json เป็นดำสนิท #000000 ผิว footer จึงเป็น #0d0b06 ที่แทบแตะพื้นเพจ
//
// footer เป็น "โครม" จึงประกาศสีตัวอักษรของตัวเองครบทุกจุด ไม่ได้ inherit
// BRAND_TEXT และโลโก้ที่เป็นทอง-เงินบนพื้นโปร่งต้องการพื้นเข้มถึงจะอ่านออก
//
// แกนสีที่ใช้ (brand-spec §2): พื้นผิวจม #0d0b06 ยกระดับด้วย #17130a / #231c0e ·
// ทองแชมเปี้ยน #e5a81b (ถ้วยรางวัลและตัวอักษร UFA บนโลโก้ และ vivid ของ
// logo.webp) เป็นหัวคอลัมน์ เส้นคั่น ขอบการ์ด และออรา · ทองสว่าง #ffe08a กับ
// ทองกลางเข้ม #bb8410 เป็นสองปลายของไล่เฉดปุ่ม · ทองลึก #7d5a07 เป็นขอบปุ่ม
// ไม่ถือตัวอักษร · เงินโครเมียม #b9c2cc (เลข 324 บนโลโก้ และชุดกีฬาดำ-เงิน)
// เป็นฮิวที่สอง ถือขอบการ์ดลอย จุดนำลิงก์ และปลายไล่เฉดเส้นใต้หัวคอลัมน์ ·
// เนื้อความ #f0e8d4 ลดน้ำหนักด้วย opacity
//
// ปุ่มพื้นทองใช้หมึกดำน้ำตาล #140d01 — พื้นทองสว่างกับตัวอักษรอ่อนอ่านไม่ออก
// (#140d01 บน #ffe08a = 16.0:1 · บน #bb8410 = 6.3:1 ผ่าน AA ทั้งคู่)
// ⚠️ ปลายเข้มของไล่เฉดปุ่มต้องเป็น #bb8410 ไม่ใช่ #7d5a07 — #7d5a07 รองหมึกนี้ได้
// แค่ ~3.3:1 ซึ่งตก AA
//
// คอปปี้ทั้งไฟล์เขียนใหม่จากบรีฟ UFA324 ซึ่งเป็น **เว็บเล่นเกมกีฬาออนไลน์** —
// ฟุตบอล มวย และเกมคาสิโน (เกมไพ่ เกมโต๊ะ สล็อต) ในแพลตฟอร์มเดียว ไม่ใช่เว็บ
// สล็อตล้วนแบบ NAZA168/FAH999 และไม่ใช่เว็บหวย บรีฟรอบนี้พูดเรื่องทางเข้าเดิมพัน
// หลายประเภท ข้อมูลคู่แข่งขันและอัตราต่อรอง หมวดเกมคาสิโน โปรโมชั่นคืนยอดเสีย
// 0.3% แนะนำเพื่อน 0.8% ระบบฝากถอนที่ตรวจสอบชื่อบัญชีผู้รับเงินได้ และแอดมิน
// 24 ชั่วโมง เท่านั้น ไม่ได้ระบุใบอนุญาต ชื่อค่ายเกม ชื่อผู้ให้บริการ ชื่อธนาคาร
// ชื่อลีก/ทีม/นักมวย ยอดขั้นต่ำเป็นตัวเลข ค่า RTP หรือจำนวนสมาชิกใดไว้ จึงไม่มีใน
// ข้อความนี้ และประโยคกำกับของบรีฟเอง (ควรมีข้อมูลผู้ให้บริการและระบบเกมที่
// ตรวจสอบได้ · อัตราต่อรองอาจเปลี่ยนแปลงตามช่วงเวลา · ไม่มีการเดิมพันประเภทใด
// รับประกันผลตอบแทน · คำว่าไม่จำกัดควรระบุให้ชัด · จ่ายตรง/ไม่บิดยูส/ไม่มีขั้นต่ำ/
// ไม่ผ่านบัญชีม้าควรมีข้อมูลที่ตรวจสอบได้รองรับ · ห้ามเปิดเผย PIN หรือ OTP)
// ขนมาด้วย ไม่ตัดทิ้ง
// คำของแบรนด์ก่อนๆ ที่ห้ามหลุดกลับมา: เว็บสล็อตนาซ่า · ฟาสล็อตเว็บตรง ·
// ส่งตรงจากอเมริกา · ฐานเกมหลัก 100% · ไม่ผ่านเอเย่นต์ · เว็บตรงฐานสล็อตหลัก ·
// สล็อตเบทต่ำ · ผลการหมุนเป็นแบบสุ่ม · แตกง่าย · ดับเบิ้ลโบนัส · ฟรีสปิน ·
// โบนัสตัวคูณ · และคำหวยทุกคำ
// ⚠️ "ไม่มีขั้นต่ำ" กับ "บัญชีม้า" เคยอยู่ในแบนลิสต์ของแบรนด์ก่อน แต่รอบนี้
// **บรีฟเขียนไว้เอง** (content.txt บรรทัด 2, 14, 16) จึงใช้ได้และต้องขนมาพร้อม
// ประโยคกำกับของมัน
//
// ลิงก์: UFA324 เป็นเว็บกีฬา/คาสิโน — /ตรวจหวย กับ /แนวทาง อยู่ใน
// src/pages-disabled/ รอบนี้ จึงไม่มีสองลิงก์นั้นในคอลัมน์ลิงก์ด่วน ไม่งั้น
// verify-build.mjs จะทำให้ build แดงเพราะ href ชี้ไป route ที่ไม่มีใน dist/
// ถ้ารอบหน้าเป็นแบรนด์หวยแล้วย้ายไฟล์กลับเข้า src/pages/ ต้องเพิ่มสองลิงก์นี้คืน
//
// /register กับ /login รอบนี้เป็นหน้าปุ่มจริงที่ index ได้ (toggle cta เปิด) ส่วน
// /ทางเข้า ถูกถอดออกจากเมนู navbar รอบนี้ แต่ route ยังมีจริงและยัง index อยู่
// ลิงก์จาก footer จึงยังถูกต้องทั้งสามหน้า (ดู NavbarStyle6.astro)
//
// บล็อก <address> ตั้งใจไม่ทาสีแบรนด์ — border-white/15 + bg-black/20 + opacity
// บนสีตัวอักษรที่ inherit มา ลงตัวกับ footer ทุกตัวในไลบรารี ห้าม retheme
---

<footer
  class="relative mt-32 w-full border-t border-[#e5a81b]/55 bg-[#0d0b06] pt-64 pb-6 font-sans text-[#f0e8d4] shadow-[0_-10px_30px_rgba(229,168,27,0.22)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#b9c2cc]/70 bg-gradient-to-r from-[#17130a] via-[#231c0e] to-[#17130a] p-6 shadow-[0_15px_40px_rgba(0,0,0,0.75)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#e5a81b] uppercase italic drop-shadow-[0_2px_4px_rgba(0,0,0,0.6)] md:text-3xl">
        <span aria-hidden="true">🏆</span> พร้อมเปิดทางเข้าเดิมพันกับ {BRAND_NAME} แล้วหรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#f0e8d4]/90 md:text-base">
        สมัคร {BRAND_NAME} ได้ด้วยตนเองผ่านมือถือ กรอกข้อมูลตามที่ระบบกำหนดแล้วเข้าสู่ระบบเพื่อเลือกประเภทกีฬา ตรวจสอบรายละเอียดการแข่งขัน และติดตามรายการต่างๆ ได้จากแพลตฟอร์มเดียว
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#7d5a07] bg-gradient-to-b from-[#ffe08a] to-[#bb8410] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#140d01] shadow-[0_0_15px_rgba(229,168,27,0.45)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">⚽</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#231c0e] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[100, 200, 300]}
                sizes="100px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(229,168,27,0.6)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-r from-[#ffe08a] via-[#e5a81b] to-[#b9c2cc] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(229,168,27,0.6)]">{BRAND_NAME}</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#f0e8d4]/75">
          {BRAND_NAME} เว็บเล่นเกมกีฬาออนไลน์ที่นำเสนอทางเข้าเดิมพันหลายประเภทไว้ในแพลตฟอร์มเดียว ทั้งฟุตบอล มวย และเกมคาสิโน ช่วยให้ผู้ใช้งานค้นหาประเภทกีฬา ตรวจสอบรายละเอียด
          การแข่งขัน และเลือกหมวดเกมที่สนใจได้สะดวกผ่านมือถือหรือคอมพิวเตอร์ พร้อมเมนูจัดการบัญชีและติดตามรายการต่างๆ ส่วนการระบุว่าเป็นฐานเกมแท้ ควรมีข้อมูลผู้ให้บริการและ
          ระบบเกมที่สามารถตรวจสอบได้ประกอบการพิจารณาก่อนใช้งาน
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/40 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.12)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>
        </div>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }
      </div>

      <nav aria-label="ลิงก์ด่วน" class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#e5a81b] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#e5a81b] to-[#b9c2cc] shadow-[0_0_8px_rgba(229,168,27,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          <a href="/" class="group flex items-center text-[#f0e8d4]/75 transition-colors hover:text-[#e5a81b]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#b9c2cc] transition-transform group-hover:rotate-45"></span> หน้าแรก
          </a>
          <a href="/promotion" class="group flex items-center text-[#f0e8d4]/75 transition-colors hover:text-[#e5a81b]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#b9c2cc] transition-transform group-hover:rotate-45"></span> โปรโมชั่นสมาชิก
          </a>
          <a href="/ทดลองเล่น" class="group flex items-center text-[#f0e8d4]/75 transition-colors hover:text-[#e5a81b]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#b9c2cc] transition-transform group-hover:rotate-45"></span> ทดลองเล่นเกม
          </a>
          <a href="/ทางเข้า" class="group flex items-center text-[#f0e8d4]/75 transition-colors hover:text-[#e5a81b]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#b9c2cc] transition-transform group-hover:rotate-45"></span> ทางเข้าล่าสุด
          </a>
          <a href="/register" class="group flex items-center text-[#f0e8d4]/75 transition-colors hover:text-[#e5a81b]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#b9c2cc] transition-transform group-hover:rotate-45"></span> สมัครสมาชิก
          </a>
          <a href="/login" class="group flex items-center text-[#f0e8d4]/75 transition-colors hover:text-[#e5a81b]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#b9c2cc] transition-transform group-hover:rotate-45"></span> เข้าสู่ระบบ
          </a>
          <a href="/about-us" class="group flex items-center text-[#f0e8d4]/75 transition-colors hover:text-[#e5a81b]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#b9c2cc] transition-transform group-hover:rotate-45"></span> เกี่ยวกับเรา
          </a>
          <a href="/contact-us" class="group flex items-center text-[#f0e8d4]/75 transition-colors hover:text-[#e5a81b]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#b9c2cc] transition-transform group-hover:rotate-45"></span> ติดต่อแอดมิน
          </a>
        </div>
      </nav>

      <section aria-label="ช่องทางทำรายการ" class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#e5a81b] uppercase">
          ช่องทางทำรายการ
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#e5a81b] to-[#b9c2cc] shadow-[0_0_8px_rgba(229,168,27,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#f0e8d4]/75">
          ก่อนยืนยันธุรกรรมทุกครั้งควรตรวจสอบชื่อบัญชีผู้รับเงินให้ตรงกับข้อมูลที่เว็บไซต์แจ้ง อ่านข้อกำหนดยอดฝากถอนและระยะเวลาดำเนินการให้ครบ พร้อมเก็บหลักฐานไว้สำหรับตรวจสอบย้อนหลัง
        </p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-[#e5a81b]/45 bg-[#17130a] transition-colors hover:border-[#b9c2cc]/70">
          <span class="flex items-center gap-1 text-xs font-bold text-[#f0e8d4]"><span aria-hidden="true" class="text-lg text-[#e5a81b]">💳</span> ตรวจสอบช่องทางที่ระบบรองรับก่อนทำรายการ</span>
