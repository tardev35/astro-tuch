---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส ด้านซ้ายเป็นอักขระจีนคำว่ามังกรเขียนด้วยลายพู่กันสีแดงสด ปลายเส้นสะบัดคล้ายหัวมังกรหันไปทางขวา ถัดมาทางขวาเป็นเวิร์ดมาร์ก ${BRAND_NAME} ตัวอักษรละตินหนาสามมิติแบบเอียง โดยตัวอักษร GT เป็นสีขาวโครเมียมขัดเงาไล่เงาเทา ตัวเลข 66 เป็นสีแดงสดไล่เฉดลงไปหาแดงเข้ม และตัวอักษร B ปิดท้ายเป็นสีขาวโครเมียมอีกครั้ง`;

// GT66B (รอบแดงมังกร-โครเมียมขาว 2026-10-13): footer ที่ใช้งานจริงรอบนี้ — รอบก่อน
// (TKB55) ใช้ FooterStyle2 เหตุผลที่เลือกไฟล์นี้คือ "ทรง" ไม่ใช่สี:
// FooterStyle2 เป็นแผ่นแบน ขอบบนเส้นหนา 3px กริด 4 คอลัมน์เท่ากัน ส่วน
// Footer / FooterPremium / FooterPremiumSumo / FooterHuay เป็นแผ่น
// rounded-t-[3rem] + ออราเหมือนกันหมดทั้งสี่ตัว ไฟล์นี้เป็นการ์ด CTA ลอย
// คร่อมขอบบน (-top-14 / md:-top-16) แล้วตัวแผ่นเว้น pt-64 (md:pt-40) ไว้รับ —
// เป็นทรงเดียวในไลบรารีที่ไม่ซ้ำกับทั้งสองกลุ่มนั้น
//
// ของเดิมที่ค้างอยู่ในไฟล์เป็นม่วงราชา-ทองของ KMD88 (#7505cc #c07cff #b453ff
// #3a0565 #2c0349 #1d0832 #140522 #0a0213 #ece2f8 #1a0526 #e2b33f #ffdf8c
// #d6a022 #7a5a0a และ rgba(117,5,204,α) / rgba(226,179,63,α)) ย้ายทั้งไฟล์มา
// เป็นแดงมังกร-โครเมียมขาวของรอบนี้แล้ว ไม่เหลือม่วงและไม่เหลือทองเลย
// ⚠️ **กับดักรอบนี้คือแดง ไม่ใช่ทอง** — แบรนด์รอบก่อนหน้าทันที (TKB55) ก็เป็น
// แดง-โลหะ-ดำเหมือนกัน แดงของมันคือ #fb131b ส่วนรอบนี้คือ #fb141b ต่างกัน
// หนึ่งหลัก และชุดเต็มของมัน (#ff8a8f #ff4d55 #e9eef4 #aeb9c6 #f2e4e5 #2a0d0f
// #1a0708 #0d0304 #c40304 #8a0206 #53050a #1a0304) ก็ไม่เหลือในไฟล์นี้
// การเจอแดงที่ไหนจึงไม่พิสูจน์อะไรเลย ต้องเทียบเป็น "ค่า" ทีละตัวกับ
// .claude/brand-spec-gt66b.md §2
//
// footer เป็น "โครม" จึงประกาศสีตัวอักษรของตัวเองครบทุกจุด ไม่ได้ inherit
// BRAND_TEXT และโลโก้ที่เป็นแดง-โครเมียมบนพื้นโปร่งต้องการพื้นเข้มถึงจะอ่านออก
//
// แกนสีที่ใช้ (brand-spec §2): พื้นผิวจม #0b0303 ยกระดับด้วย #1c0c0b / #3b0405 ·
// แดงแบรนด์ #fb141b (อักขระมังกรและเลข 66 บนโลโก้) เป็นขอบ เส้นใต้หัวคอลัมน์
// จุดนำลิงก์ และออรา · แดงสว่าง #ff5f63 เป็นสี hover ของลิงก์ หัวการ์ด CTA และ
// ชื่อแบรนด์ในบรรทัดลิขสิทธิ์ · แดงอ่อน #ffa0a2 เป็นปลายสว่างของไล่เฉดปุ่ม ·
// แดงถ่าน #8a0609 เป็นขอบปุ่มและปลายเข้มของเส้นใต้ ไม่ถือตัวอักษร ·
// โครเมียมขาว #fdfcfd (ตัวอักษร GT และ B บนโลโก้) เป็นหัวคอลัมน์ ·
// เนื้อความ #eceaea ลดน้ำหนักด้วย opacity
//
// ปุ่มพื้นแดงใช้หมึกแดงเกือบดำ #190505 — พื้นแดงสว่างกับตัวอักษรอ่อนอ่านไม่ออก
// (#190505 บน #ffa0a2 = 10.1:1 · บน #ff5f63 = 6.5:1 ผ่าน AA ทั้งคู่)
// ⚠️ ปลายเข้มของไล่เฉดปุ่มต้องเป็น #ff5f63 ไม่ใช่ #db040b หรือ #8a0609 —
// สองค่านั้นรองหมึกนี้ได้แค่ ~3.8:1 และ ~1.8:1 ซึ่งตก AA
// ⚠️ #fb141b #db040b #8a0609 #3b0405 ห้ามถือตัวอักษรทุกขนาดในไฟล์นี้
//
// คอปปี้ทั้งไฟล์เขียนใหม่จากบรีฟ GT66B (src/assets/content.txt) ซึ่งเป็น
// **คาสิโนเซิร์ฟนอก ถูกลิขสิทธิ์ ค่ายระดับเอเชีย** — บาคาร่า ไฮโล และสล็อต
// ในแพลตฟอร์มเดียว ไม่ใช่เว็บคาสิโน+กีฬาแบบ TKB55/KMD88 (รอบนี้ **ไม่มีบอล
// ไม่มีกีฬา**) ไม่ใช่เว็บสล็อตล้วนแบบ NAZA168/FAH999 และไม่ใช่เว็บหวย
// บรีฟรอบนี้พูดเรื่องเซิร์ฟเวอร์ต่างประเทศ ลิขสิทธิ์เกม มาตรฐานการให้บริการ
// การจัดหมวดเกม เมนูค้นหาเกม การตรวจสอบเครดิตและจัดการบัญชีสมาชิก โปรโมชั่น
// คืนยอดเสีย 0.3% กับแนะนำเพื่อน 0.8% การสมัคร 3 ขั้นตอน และแอดมิน 24 ชั่วโมง
// เท่านั้น ไม่ได้ระบุเลขใบอนุญาต ชื่อหน่วยงานที่ออกใบอนุญาต ชื่อค่ายเกม
// ชื่อนิติบุคคล ชื่อธนาคาร ยอดขั้นต่ำเป็นตัวเลข ค่า RTP จำนวนสมาชิก หรือปีก่อตั้ง
// ไว้เลย จึงไม่มีในข้อความนี้
// ⚠️ บรีฟ "ตั้งคำถามกับคำโฆษณาของตัวเอง" ถึงห้าจุด และประโยคกำกับพวกนั้นต้องขนมา
// ด้วย ห้ามตัดทิ้งเพราะฟังดูไม่ขายของ: ข้อมูลเซิร์ฟเวอร์ต่างประเทศ ลิขสิทธิ์เกม
// และมาตรฐานการให้บริการ ควรมีรายละเอียดผู้ดำเนินงานหรือเอกสารรับรองที่ตรวจสอบได้
// ประกอบ · ค่ายเกมระดับเอเชียควรมีรายชื่อผู้พัฒนาและข้อมูลการให้บริการที่ชัดเจน ·
// ไม่มีเกมประเภทใดรับประกันผลกำไรจากการเดิมพัน · คำว่าไม่จำกัดควรระบุให้ชัดว่า
// หมายถึงอะไร · ไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น
// คำของแบรนด์ก่อนๆ ที่ห้ามหลุดกลับมา: เว็บคาสิโนไทย · ยอดเข้าบริษัทโดยตรง ·
// ฝากถอนทุกธนาคาร · บอลออนไลน์ · แบรนด์คาสิโนเซิร์ฟไทย · เล่นได้ทุกค่าย ·
// มีโบนัสทุกเกม · เว็บเล่นเกมกีฬาออนไลน์ · ฐานเกมแท้ · จ่ายตรง · ไม่บิดยูส ·
// ไม่ผ่านบัญชีม้า · ฟาสล็อตเว็บตรง · ส่งตรงจากอเมริกา · ไม่ผ่านเอเย่นต์ ·
// สล็อตเบทต่ำ · แตกง่าย · ยิงปลา · เสือมังกร · และคำหวยทุกคำ
//
// ลิงก์: GT66B เป็นเว็บคาสิโน — /ตรวจหวย กับ /แนวทาง อยู่ใน
// src/pages-disabled/ รอบนี้ จึงไม่มีสองลิงก์นั้นในคอลัมน์ลิงก์ด่วน ไม่งั้น
// verify-build.mjs จะทำให้ build แดงเพราะ href ชี้ไป route ที่ไม่มีใน dist/
// ถ้ารอบหน้าเป็นแบรนด์หวยแล้วย้ายไฟล์กลับเข้า src/pages/ ต้องเพิ่มสองลิงก์นี้คืน
//
// /register กับ /login รอบนี้เป็นหน้าปุ่มจริงที่ index ได้ (toggle cta เปิด) ส่วน
// /ทางเข้า ถูกถอดออกจากเมนู navbar รอบนี้ แต่ route ยังมีจริงและยัง index อยู่
// ลิงก์จาก footer จึงยังถูกต้องทั้งสามหน้า (ดู NavbarStyle4Black.astro)
//
// บล็อก <address> ตั้งใจไม่ทาสีแบรนด์ — border-white/15 + bg-black/20 + opacity
// บนสีตัวอักษรที่ inherit มา ลงตัวกับ footer ทุกตัวในไลบรารี ห้าม retheme
---

<footer
  class="relative mt-32 w-full border-t border-[#fb141b]/55 bg-[#0b0303] pt-64 pb-6 font-sans text-[#eceaea] shadow-[0_-10px_30px_rgba(251,20,27,0.26)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#ff5f63]/60 bg-gradient-to-r from-[#1c0c0b] via-[#3b0405] to-[#1c0c0b] p-6 shadow-[0_15px_40px_rgba(0,0,0,0.78)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#ff5f63] uppercase italic drop-shadow-[0_2px_4px_rgba(0,0,0,0.6)] md:text-3xl">
        <span aria-hidden="true">🐉</span> พร้อมเข้าหมวดเกมคาสิโนของ {BRAND_NAME} แล้วหรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#eceaea]/90 md:text-base">
        สมัคร {BRAND_NAME} ได้ด้วยตนเองผ่านมือถือหรือคอมพิวเตอร์ กรอกข้อมูลตามแบบฟอร์มที่ระบบกำหนดแล้วยืนยันบัญชี เพื่อเข้าดูหมวดเกม ค้นหาเกมที่สนใจ และตรวจสอบเครดิตจากแพลตฟอร์มเดียว
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#8a0609] bg-gradient-to-b from-[#ffa0a2] to-[#ff5f63] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#190505] shadow-[0_0_15px_rgba(251,20,27,0.5)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🃏</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#3b0405] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[100, 200, 300]}
                sizes="100px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(251,20,27,0.7)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-r from-[#fdfcfd] via-[#ffa0a2] to-[#fb141b] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(251,20,27,0.65)]">{BRAND_NAME}</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#eceaea]/75">
          {BRAND_NAME} คาสิโนเซิร์ฟนอกที่รวบรวมหมวดเกมคาสิโนออนไลน์หลายประเภทไว้ในแพลตฟอร์มเดียว ทั้งบาคาร่า ไฮโล และสล็อตจากผู้ให้บริการระดับเอเชีย รองรับการเข้าใช้งานผ่านมือถือและ
          คอมพิวเตอร์ พร้อมเมนูค้นหาเกม ตรวจสอบเครดิต และจัดการบัญชีสมาชิก ส่วนข้อมูลเกี่ยวกับเซิร์ฟเวอร์ต่างประเทศ ลิขสิทธิ์เกม และมาตรฐานการให้บริการ ควรมีรายละเอียดผู้ดำเนินงาน
          หรือเอกสารรับรองที่สามารถตรวจสอบได้ประกอบการพิจารณาก่อนใช้งาน
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/40 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.12)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>
        </div>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }
      </div>

      <nav aria-label="ลิงก์ด่วน" class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#fdfcfd] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#fb141b] to-[#8a0609] shadow-[0_0_8px_rgba(251,20,27,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          <a href="/" class="group flex items-center text-[#eceaea]/75 transition-colors hover:text-[#ff5f63]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#fb141b] transition-transform group-hover:rotate-45"></span> หน้าแรก
          </a>
          <a href="/promotion" class="group flex items-center text-[#eceaea]/75 transition-colors hover:text-[#ff5f63]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#fb141b] transition-transform group-hover:rotate-45"></span> โปรโมชั่นสมาชิก
          </a>
          <a href="/ทดลองเล่น" class="group flex items-center text-[#eceaea]/75 transition-colors hover:text-[#ff5f63]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#fb141b] transition-transform group-hover:rotate-45"></span> ทดลองเล่นเกม
          </a>
          <a href="/ทางเข้า" class="group flex items-center text-[#eceaea]/75 transition-colors hover:text-[#ff5f63]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#fb141b] transition-transform group-hover:rotate-45"></span> ทางเข้าล่าสุด
          </a>
          <a href="/register" class="group flex items-center text-[#eceaea]/75 transition-colors hover:text-[#ff5f63]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#fb141b] transition-transform group-hover:rotate-45"></span> สมัครสมาชิก
          </a>
          <a href="/login" class="group flex items-center text-[#eceaea]/75 transition-colors hover:text-[#ff5f63]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#fb141b] transition-transform group-hover:rotate-45"></span> เข้าสู่ระบบ
          </a>
          <a href="/about-us" class="group flex items-center text-[#eceaea]/75 transition-colors hover:text-[#ff5f63]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#fb141b] transition-transform group-hover:rotate-45"></span> เกี่ยวกับเรา
          </a>
          <a href="/contact-us" class="group flex items-center text-[#eceaea]/75 transition-colors hover:text-[#ff5f63]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#fb141b] transition-transform group-hover:rotate-45"></span> ติดต่อแอดมิน
          </a>
        </div>
      </nav>

      <section aria-label="ช่องทางทำรายการ" class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#fdfcfd] uppercase">
          ช่องทางทำรายการ
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#fb141b] to-[#8a0609] shadow-[0_0_8px_rgba(251,20,27,0.6)]"></span>
