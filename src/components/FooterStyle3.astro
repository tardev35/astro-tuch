---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt = "โลโก้ แตกดี168 บนพื้นโปร่ง เป็นคำว่า แตกดี ตัวอักษรไทยหนาสีเหลืองมะนาว วางอยู่เหนือเลข 168 ตัวหนาสีฟ้าสด และมีแถบมนบางสีขาวนวลคาดอยู่ใต้สุด";

// แตกดี168 (รอบฟ้าสด-เหลืองมะนาวบนกรมท่าเกือบดำ 2026-10-08): footer ที่ใช้งานจริง
// รอบนี้ — รอบก่อน (789BETTING) ใช้ FooterStyle2 จึงหมุนกลับมาที่ไฟล์นี้ ของเดิมที่
// ค้างอยู่ในไฟล์เป็นแดง-เขียวมรกต-ทองบนเกือบดำอมแดงของ GUCCI168 (#c41115 #e0201f
// #7a0505 #0b7a33 #2bbf63 #d9a521 #ffdf91 #8c6410 #1d0b08 #3d0a09 #090302 #f6e3cf
// #1a0604 rgba(196,17,21,α) rgba(217,165,33,α)) ย้ายทั้งไฟล์มาเป็นฟ้าสด-เหลือง
// มะนาวบนกรมท่าเกือบดำตามโลโก้จริงแล้ว ไม่เหลือชุดแดง-เขียวเดิมเลย
//
// footer เป็น "โครม" จึงประกาศสีตัวอักษรของตัวเองครบทุกจุด ไม่ได้ inherit
// BRAND_TEXT และโลโก้ที่เป็นเหลือง-ฟ้าสดต้องการพื้นเข้มถึงจะอ่านออก
//
// แกนสีที่ใช้ (brand-spec §2): พื้นกรมท่าเกือบดำ #020609 ยกระดับด้วย #07111d /
// #0b3c66 · ฟ้าแบรนด์ #0193fb (vivid อันดับหนึ่งของ logo.webp = เลข 168) เป็นเส้น
// คั่น ขอบการ์ด และออรา · ฟ้าอ่อน #7bcffb (vivid ของ banner1 = ท้องฟ้า) เป็นปลาย
// ไล่เฉดด้านสว่างและจุดนำลิงก์ · เหลืองมะนาว #fce604 (vivid อันดับสองของ logo =
// คำว่า แตกดี) เป็นฮิวที่สอง สงวนไว้ให้หัวคอลัมน์ ชื่อแบรนด์ และปุ่มสมัคร ·
// เหลืองอ่อน #fff48a กับเหลืองเข้ม #c9a703 เป็นสองปลายของไล่เฉดปุ่ม · เนื้อความ
// #dbeafe ลดน้ำหนักด้วย opacity
//
// คอปปี้ทั้งไฟล์เขียนใหม่จากบรีฟ แตกดี168 ซึ่งเป็น **เว็บสล็อตออนไลน์ล้วน ไม่ใช่
// เว็บหวยและไม่ใช่คาสิโนรวมหมวด** บรีฟรอบนี้พูดเรื่องสล็อตที่รวมสล็อตคลาสสิก
// เกมโบนัส ฟรีสปิน ตัวคูณ และเกมเปิดใหม่ไว้ในระบบเดียว เข้าเล่นผ่านมือถือ
// โปรโมชั่นคืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% สมัครง่าย และแอดมิน 24 ชั่วโมง
// เท่านั้น ไม่ได้ระบุใบอนุญาต ชื่อค่ายเกม ชื่อผู้ให้บริการ ชื่อธนาคาร ยอดขั้นต่ำ
// ค่า RTP หรือจำนวนสมาชิกใดไว้ จึงไม่มีในข้อความนี้ และประโยคกำกับของบรีฟเอง
// ("ไม่มีขั้นต่ำ" ควรตรวจวงเงินจริงของแต่ละเกม · "ถูกลิขสิทธิ์" ควรมีข้อมูลค่ายที่
// ตรวจสอบได้รองรับ · รีวิวของสมาชิกคนหนึ่งไม่ใช่การรับประกันผลของทุกคน) ขนมาด้วย
// ไม่ตัดทิ้ง
//
// ลิงก์: แตกดี168 เป็นเว็บสล็อต — /ตรวจหวย กับ /แนวทาง อยู่ใน src/pages-disabled/
// รอบนี้ จึงไม่มีสองลิงก์นั้นในคอลัมน์ลิงก์ด่วน ไม่งั้น verify-build.mjs จะทำให้
// build แดงเพราะ href ชี้ไป route ที่ไม่มีใน dist/ ถ้ารอบหน้าเป็นแบรนด์หวยแล้วย้าย
// ไฟล์กลับเข้า src/pages/ ต้องเพิ่มสองลิงก์นี้คืนพร้อมกัน
//
// /register กับ /login รอบนี้เป็นหน้า interstitial แบบ noindex (toggle cta ปิด)
// แต่ยังเป็น route จริงใน dist/ ลิงก์จาก footer จึงยังถูกต้อง ส่วน /ทางเข้า รอบนี้
// กลับเข้าไปอยู่ในเมนู navbar ด้วย (ดู NavbarStyle10.astro)
//
// ปุ่มพื้นเหลืองใช้ตัวอักษรหมึกกรมท่าเข้ม #031018 — พื้นเหลืองสว่างกับตัวอักษร
// อ่อนอ่านไม่ออก (#031018 บน #fff48a = 17.0:1 · บน #fce604 = 15.0:1 ผ่าน AA ทั้งคู่)
//
// บล็อก <address> ตั้งใจไม่ทาสีแบรนด์ — border-white/15 + bg-black/20 + opacity
// บนสีตัวอักษรที่ inherit มา ลงตัวกับ footer ทุกตัวในไลบรารี ห้าม retheme
---

<footer
  class="relative mt-32 w-full border-t border-[#0193fb]/55 bg-[#020609] pt-64 pb-6 font-sans text-[#dbeafe] shadow-[0_-10px_30px_rgba(1,147,251,0.22)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#fce604]/70 bg-gradient-to-r from-[#07111d] via-[#0b3c66] to-[#07111d] p-6 shadow-[0_15px_40px_rgba(2,6,9,0.75)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#fce604] uppercase italic drop-shadow-[0_2px_4px_rgba(2,6,9,0.6)] md:text-3xl">
        <span aria-hidden="true">🎰</span> พร้อมเริ่มหมุนสล็อตกับ {BRAND_NAME} แล้วหรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#dbeafe]/90 md:text-base">
        สมัคร {BRAND_NAME} ได้ด้วยตนเองผ่านมือถือ กรอกข้อมูลตามที่ระบบกำหนดแล้ว Login เพื่อเลือกเกมสล็อต ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการจากบัญชีเดียว
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#c9a703] bg-gradient-to-b from-[#fff48a] to-[#fce604] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#031018] shadow-[0_0_15px_rgba(252,230,4,0.45)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🚀</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#0b3c66] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[100, 200, 300]}
                sizes="100px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(1,147,251,0.6)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-r from-[#fff48a] via-[#fce604] to-[#0193fb] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(1,147,251,0.6)]">{BRAND_NAME}</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#dbeafe]/75">
          {BRAND_NAME} เป็นเว็บเกมสล็อตออนไลน์ที่รวบรวมเกมเดิมพันหลายรูปแบบไว้ในระบบเดียว มีทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน ตัวคูณ และเกมเปิดใหม่ตามรายการที่ให้บริการ
          รองรับการเข้าเล่นผ่านมือถือ ช่วยให้เลือกเกม ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการได้สะดวกจากบัญชีเดียว สำหรับเกมที่รองรับการเดิมพันยอดต่ำสามารถเลือกเล่นตามงบได้
          แต่คำว่า “ไม่มีขั้นต่ำ” ควรตรวจสอบวงเงินจริงของแต่ละเกมก่อนเริ่มเล่นทุกครั้ง ส่วนการระบุว่าเกมสล็อตถูกลิขสิทธิ์ ควรมีข้อมูลค่ายหรือผู้ให้บริการที่ตรวจสอบได้รองรับ
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/40 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.12)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>
        </div>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }
      </div>

      <nav aria-label="ลิงก์ด่วน" class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#fce604] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#0193fb] to-[#fce604] shadow-[0_0_8px_rgba(1,147,251,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          <a href="/" class="group flex items-center text-[#dbeafe]/75 transition-colors hover:text-[#fce604]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#7bcffb] transition-transform group-hover:rotate-45"></span> หน้าแรก
          </a>
          <a href="/promotion" class="group flex items-center text-[#dbeafe]/75 transition-colors hover:text-[#fce604]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#7bcffb] transition-transform group-hover:rotate-45"></span> โปรโมชั่นสมาชิก
          </a>
          <a href="/ทดลองเล่น" class="group flex items-center text-[#dbeafe]/75 transition-colors hover:text-[#fce604]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#7bcffb] transition-transform group-hover:rotate-45"></span> ทดลองเล่นสล็อต
          </a>
          <a href="/ทางเข้า" class="group flex items-center text-[#dbeafe]/75 transition-colors hover:text-[#fce604]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#7bcffb] transition-transform group-hover:rotate-45"></span> ทางเข้าล่าสุด
          </a>
          <a href="/register" class="group flex items-center text-[#dbeafe]/75 transition-colors hover:text-[#fce604]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#7bcffb] transition-transform group-hover:rotate-45"></span> สมัครสมาชิก
          </a>
          <a href="/login" class="group flex items-center text-[#dbeafe]/75 transition-colors hover:text-[#fce604]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#7bcffb] transition-transform group-hover:rotate-45"></span> เข้าสู่ระบบ
          </a>
          <a href="/about-us" class="group flex items-center text-[#dbeafe]/75 transition-colors hover:text-[#fce604]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#7bcffb] transition-transform group-hover:rotate-45"></span> เกี่ยวกับเรา
          </a>
          <a href="/contact-us" class="group flex items-center text-[#dbeafe]/75 transition-colors hover:text-[#fce604]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#7bcffb] transition-transform group-hover:rotate-45"></span> ติดต่อแอดมิน
          </a>
        </div>
      </nav>

      <section aria-label="ช่องทางทำรายการ" class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#fce604] uppercase">
          ช่องทางทำรายการ
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#0193fb] to-[#fce604] shadow-[0_0_8px_rgba(1,147,251,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#dbeafe]/75">
          ก่อนทำรายการทุกครั้งควรตรวจสอบชื่อบัญชีปลายทางให้ตรงกับข้อมูลจากช่องทางหลักของเว็บไซต์ และเก็บเวลา จำนวนเงิน พร้อมหลักฐานธุรกรรมไว้สำหรับตรวจสอบย้อนหลัง
        </p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-[#0193fb]/45 bg-[#07111d] transition-colors hover:border-[#7bcffb]/70">
          <span class="flex items-center gap-1 text-xs font-bold text-[#dbeafe]"><span aria-hidden="true" class="text-lg text-[#fce604]">🎰</span> ตรวจสอบช่องทางที่ระบบรองรับก่อนทำรายการ</span>
        </div>
      </section>
    </div>

    <hr class="mb-6 border-[#0b3c66]" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#dbeafe]/70 md:block">
      {BRAND_NAME} เป็นช่องทางสำหรับผู้ที่ต้องการเข้าเล่นเกมสล็อตออนไลน์ผ่านระบบเดียว มีทั้งสล็อตคลาสสิกที่รูปแบบการเล่นเข้าใจง่าย เกมโบนัสที่มีรอบพิเศษ ฟรีสปิน
      ตัวคูณ และเกมเปิดใหม่ที่เพิ่มเข้ามาตามรายการที่ให้บริการ เข้าใช้งานผ่านเว็บเบราว์เซอร์ได้ทั้งบนมือถือและคอมพิวเตอร์ หลัง Login สามารถเลือกเกม ตรวจสอบเครดิต
      ดูโปรโมชั่น แล้วย้อนดูประวัติรายการได้จากบัญชีเดียวโดยไม่ต้องสมัครใหม่หลายครั้ง จำนวนเกมและรายการที่เปิดให้บริการอาจเปลี่ยนแปลงตามช่วงเวลา จึงควรตรวจสอบ
      รายละเอียดล่าสุดจากระบบก่อนเริ่มเล่น โปรโมชั่นคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% คำนวณจากยอดที่เข้าเกณฑ์ตามรอบที่กำหนด แต่ละรายการอาจมีรอบตัดยอด ค่ายเกม
      ที่ร่วมรายการ และข้อกำหนดการใช้โบนัสแตกต่างกัน จึงควรตรวจสอบเงื่อนไขล่าสุดก่อนกดรับสิทธิ์ ส่วนคำว่า “ไม่มีขั้นต่ำ” ควรตรวจสอบวงเงินจริงของแต่ละเกม เพราะ
      ยอดเดิมพันขั้นต่ำขึ้นอยู่กับเกมสล็อตและค่ายผู้ให้บริการซึ่งกำหนดไว้ไม่เท่ากัน เช่นเดียวกับการระบุว่าเกมสล็อตถูกลิขสิทธิ์ ที่ควรมีข้อมูลค่ายหรือผู้ให้บริการ
      ที่ตรวจสอบย้อนกลับได้รองรับ รีวิวถอนจริงจากสมาชิกใช้เป็นข้อมูลประกอบการพิจารณาได้ แต่ไม่ควรใช้เป็นหลักฐานเพียงอย่างเดียวในการยืนยันว่าเป็นเว็บแท้ และไม่ควรนำ
      ผลลัพธ์ของสมาชิกคนหนึ่งมาเป็นการรับประกันผลลัพธ์ของสมาชิกทุกคน ก่อนทำธุรกรรมควรตรวจสอบชื่อผู้รับจากช่องทางหลัก เก็บหลักฐานไว้จนกว่ารายการจะเสร็จสมบูรณ์
      และไม่เปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น โดยมีแอดมิน {BRAND_NAME} ดูแลผ่านช่องทางไลน์ตลอด 24 ชั่วโมง
    </div>

