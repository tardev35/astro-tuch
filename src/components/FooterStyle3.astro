---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// เขียนจาก src/assets/logo.webp ของดรอป 2026-10-18 จริง (เปิดอ่านด้วย Read ก่อนเขียน)
// ไม่ใช่คัดลอกของรอบก่อน — อักขระมังกรจีน 龍 และเวิร์ดมาร์กโครเมียมของ GT66B ที่เคย
// อยู่บรรทัดนี้ไม่มีในรูปรอบนี้เลย
const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส ด้านบนเป็นแมวกวักนำโชคตัวขาวลายส้มทอง หลับตายิ้มกว้าง แก้มชมพู สวมปลอกคอแดงห้อยกระพรวนทอง ยกอุ้งเท้าซ้ายขึ้นกวัก มีหัวใจชมพูลอยอยู่สองดวง ใต้ลงมาเป็นคำว่า มีโชค ตัวอักษรไทยหนาสามมิติไล่เฉดจากชมพูบานเย็นไปหาทอง ตัดขอบทองหนา ต่อด้วยเลข 168 ตัวหนาสามมิติสีทองขัดเงา ล้อมรอบด้วยริบบิ้นซาตินสีชมพูบานเย็นพลิ้วเป็นวง เหรียญจีนสีทองรูปวงกลมเจาะรูสี่เหลี่ยมตรงกลางปลิวกระจาย และทองแท่งจีนทรงเรือวางซ้อนกันที่ขอบล่าง`;

// มีโชค168 (รอบทอง-ชมพูบานเย็น บนดำสนิท 2026-10-18): footer ที่ใช้งานจริงรอบนี้ —
// รอบก่อน (ขวัญใจ168) ใช้ FooterPremiumSumo เหตุผลที่เลือกไฟล์นี้คือ "ทรง" ไม่ใช่สี:
// FooterPremiumSumo เป็นแผ่น rounded-t-[3rem] + ออราเรืองแสงคร่อมขอบบน-ล่าง กริด
// 12 คอลัมน์ 5/3/4 — เหมือนกับ Footer / FooterPremium / FooterHuay ทั้งกลุ่ม
// ส่วน FooterStyle2 เป็นแผ่นแบนขอบบนเส้นหนา กริด 4 คอลัมน์เท่ากัน ไฟล์นี้เป็น
// **การ์ด CTA ลอยคร่อมขอบบน** (-top-14 / md:-top-16) แล้วตัวแผ่นเว้น pt-64
// (md:pt-40) ไว้รับ — เป็นทรงเดียวในไลบรารีที่ไม่ซ้ำกับทั้งสองกลุ่มนั้น
//
// ของเดิมที่ค้างอยู่ในไฟล์เป็นแดงมังกร-โครเมียมขาวของ GT66B (#fb141b #ff5f63
// #ffa0a2 #8a0609 #3b0405 #1c0c0b #0b0303 #fdfcfd #eceaea #190505 #db040b และ
// rgba(251,20,27,α)) ย้ายทั้งไฟล์มาเป็นทอง-ชมพูบานเย็นของรอบนี้แล้ว ไม่เหลือแดง
// และไม่เหลือโครเมียมเลย
// ⚠️ **กับดักรอบนี้คือทอง** — แบรนด์รอบก่อนหน้าทันที (ขวัญใจ168) ก็เป็นทองบนดำ
// เหมือนกัน ทองของมันคือ #f7c92b (+#ffe6a3 #8a5f12 #140c06) ส่วนรอบนี้คือ #fcd434
// (+#ffeaa0 #7a5508 #1a0612) และฮิวที่สองของมันคือ **โรสโกลด์ #f2bba5 / #c98a74**
// ส่วนรอบนี้คือ **ชมพูบานเย็น #f5469f** การเจอทองที่ไหนจึงไม่พิสูจน์อะไรเลย
// ต้องเทียบเป็น "ค่า" ทีละตัวกับ .claude/brand-spec-meechoke168.md §2
//
// footer เป็น "โครม" จึงประกาศสีตัวอักษรของตัวเองครบทุกจุด ไม่ได้ inherit
// BRAND_TEXT และโลโก้ที่เป็นทอง-ชมพูบนพื้นโปร่งต้องการพื้นเข้มถึงจะอ่านออก
//
// แกนสีที่ใช้ (brand-spec §2): พื้นผิวจม #0b0509 ยกระดับด้วย #160a12 / #24101c ·
// ทองแบรนด์ #fcd434 (เลข 168 บนโลโก้) เป็นจุดนำลิงก์ ขอบ และออรา ·
// **ชมพูบานเย็น #f5469f (ริบบิ้นและตัวอักษร มีโชค บนโลโก้) เป็นเส้นใต้หัวคอลัมน์
// ขอบ และหัวการ์ด CTA** ซึ่งเป็นจุดที่ฮิวที่สองของรอบนี้ต้องเห็นจริง ·
// ชมพูอ่อน #ff8dc6 เป็นสี hover ของลิงก์และชื่อแบรนด์ในบรรทัดลิขสิทธิ์ ·
// ทองอ่อน #ffeaa0 เป็นหัวคอลัมน์และปลายสว่างของไล่เฉดปุ่ม ·
// พลัมเข้ม #8c0f52 กับทองลึก #7a5508 เป็นขอบ/ปลายเข้มของเส้นใต้ ไม่ถือตัวอักษร ·
// เนื้อความ #f6e4ee ลดน้ำหนักด้วย opacity
//
// ปุ่มพื้นทองใช้หมึก #1a0612 — พื้นทองสว่างกับตัวอักษรอ่อนอ่านไม่ออก
// (#1a0612 บน #ffeaa0 = 17.5:1 · บน #fcd434 = 13.5:1 ผ่าน AA ทั้งคู่)
// ⚠️ ห้ามเปลี่ยนพื้นปุ่มเป็นชมพู (#1a0612 บน #f5469f ได้ 5.8:1 ยังผ่าน แต่ตัวอักษร
// ขาวบนชมพูได้แค่ 3.4:1 ซึ่งตก) และห้ามพลิกไปใช้ตัวอักษรสีขาวบนพื้นทอง
// ⚠️ #8c0f52 #7a5508 ห้ามถือตัวอักษรทุกขนาดในไฟล์นี้
//
// คอปปี้ทั้งไฟล์เขียนใหม่จากบรีฟ มีโชค168 (src/assets/content.txt) ซึ่งเป็น
// **เว็บสล็อตล้วน ลิขสิทธิ์แท้ นำเข้าตรงจากสิงคโปร์** รวมสามค่าย PG SOFT, JOKER
// และ JILI ไว้ในเว็บเดียว ไม่ใช่คาสิโนหลายหมวดแบบ GT66B/TKB55 (รอบนี้ **ไม่มี
// บาคาร่า ไม่มีไฮโล ไม่มีไพ่ ไม่มีบอล/กีฬา**) และไม่ใช่เว็บหวย
// บรีฟรอบนี้พูดเรื่องค่ายเกมสามค่าย การสมัครสมาชิก การเข้าใช้งาน โปรโมชั่นคืนยอดเสีย
// 0.3% กับแนะนำเพื่อน 0.8% การสมัคร 3 ขั้นตอน และ LINE Official 24 ชั่วโมงเท่านั้น
// ไม่ได้ระบุเลขใบอนุญาต ชื่อหน่วยงานที่ออกใบอนุญาต ชื่อนิติบุคคล ชื่อธนาคาร
// ยอดขั้นต่ำเป็นตัวเลข ค่า RTP จำนวนสมาชิก หรือปีก่อตั้งไว้เลย จึงไม่มีในข้อความนี้
// ⚠️ บรีฟ "ตั้งคำถามกับคำโฆษณาของตัวเอง" ถึงสี่จุด และประโยคกำกับพวกนั้นต้องขนมา
// ด้วย ห้ามตัดทิ้งเพราะฟังดูไม่ขายของ: ข้อมูลเกี่ยวกับลิขสิทธิ์และแหล่งที่มาของระบบ
// ควรตรวจสอบจากหลักฐานของผู้ให้บริการโดยตรง · ข้อมูลการเชื่อมต่อระบบจากสิงคโปร์และ
// สถานะลิขสิทธิ์ควรตรวจสอบกับผู้ให้บริการโดยตรง · เครดิตคืนยอดเสียไม่ได้รับประกัน
// ผลตอบแทนจากการเล่นครั้งต่อไป · แม้โปรโมชั่นจะระบุว่าไม่จำกัด แต่ควรตรวจสอบว่ามี
// ข้อกำหนดเกี่ยวกับจำนวนบัญชี ยอดที่นำมาคำนวณ หรือระยะเวลารับสิทธิ์หรือไม่
// ⚠️ คำของแบรนด์ก่อนที่ห้ามหลุดกลับมา: ศูนย์บริการหลัก · ศูนย์รวมช่องทางบริการ ·
// ช่องทางรับบริการ · ลิขสิทธิ์เว็บแท้100% · เว็บคาสิโนไทย · คาสิโนเซิร์ฟนอก ·
// ฝากถอนทุกธนาคาร · บอลออนไลน์ · เล่นได้ทุกค่าย · ฐานเกมแท้ · จ่ายตรง ·
// ไม่บิดยูส · ไม่ผ่านบัญชีม้า · เว็บตรง · ไม่ผ่านเอเย่นต์ · แตกง่าย · ยิงปลา ·
// เสือมังกร · และคำหวยทุกคำ
//
// ลิงก์: มีโชค168 เป็นเว็บสล็อต — /ตรวจหวย กับ /แนวทาง อยู่ใน src/pages-disabled/
// รอบนี้ จึงไม่มีสองลิงก์นั้นในคอลัมน์ลิงก์ด่วน ไม่งั้น verify-build.mjs จะทำให้
// build แดงเพราะ href ชี้ไป route ที่ไม่มีใน dist/ ถ้ารอบหน้าเป็นแบรนด์หวยแล้ว
// ย้ายไฟล์กลับเข้า src/pages/ ต้องเพิ่มสองลิงก์นี้คืน
//
// /register กับ /login รอบนี้เป็นหน้าปุ่มจริงที่ index ได้ (toggle cta เปิด) ส่วน
// /ทางเข้า ถูกถอดออกจากเมนู navbar รอบนี้ แต่ route ยังมีจริงและยัง index อยู่
// ลิงก์จาก footer จึงยังถูกต้องทั้งสามหน้า (ดู NavbarStyle8.astro)
//
// บล็อก <address> ตั้งใจไม่ทาสีแบรนด์ — border-white/15 + bg-black/20 + opacity
// บนสีตัวอักษรที่ inherit มา ลงตัวกับ footer ทุกตัวในไลบรารี ห้าม retheme
---

<footer
  class="relative mt-32 w-full border-t border-[#f5469f]/55 bg-[#0b0509] pt-64 pb-6 font-sans text-[#f6e4ee] shadow-[0_-10px_30px_rgba(245,70,159,0.26)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#f5469f]/60 bg-gradient-to-r from-[#160a12] via-[#24101c] to-[#160a12] p-6 shadow-[0_15px_40px_rgba(0,0,0,0.78)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#ff8dc6] uppercase italic drop-shadow-[0_2px_4px_rgba(0,0,0,0.6)] md:text-3xl">
        <span aria-hidden="true">🐱</span> พร้อมเข้าเล่นสล็อตกับ {BRAND_NAME} แล้วหรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#f6e4ee]/90 md:text-base">
        สมัคร {BRAND_NAME} ได้ด้วยตนเองผ่านมือถือหรือคอมพิวเตอร์ ตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง อ่านเงื่อนไขการเปิดบัญชี แล้วกรอกข้อมูลตามที่ระบบกำหนดเพื่อเข้าศึกษารายละเอียดเกมจาก PG SOFT, JOKER และ JILI
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#7a5508] bg-gradient-to-b from-[#ffeaa0] to-[#fcd434] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#1a0612] shadow-[0_0_15px_rgba(252,212,52,0.5)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🎰</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#8c0f52] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[100, 200, 300]}
                sizes="100px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(245,70,159,0.7)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-r from-[#ffeaa0] via-[#ff8dc6] to-[#fcd434] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(245,70,159,0.65)]">{BRAND_NAME}</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#f6e4ee]/75">
          {BRAND_NAME} ฐานหลักเว็บสล็อตลิขสิทธิ์แท้ที่นำเสนอเกมสล็อตออนไลน์จากค่ายเกมมาตรฐานสากลอย่าง PG SOFT, JOKER และ JILI พร้อมรวบรวมข้อมูลการสมัครสมาชิก การเข้าใช้งาน และโปรโมชั่นไว้ใน
          เว็บไซต์เดียว ผู้เล่นสามารถศึกษารายละเอียดของแต่ละค่ายก่อนเลือกเกมที่สนใจได้ ส่วนข้อมูลเกี่ยวกับลิขสิทธิ์และแหล่งที่มาของระบบ ควรตรวจสอบจากหลักฐานของผู้ให้บริการโดยตรง
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/40 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.12)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>
        </div>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }
      </div>

      <nav aria-label="ลิงก์ด่วน" class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#ffeaa0] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#f5469f] to-[#8c0f52] shadow-[0_0_8px_rgba(245,70,159,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          <a href="/" class="group flex items-center text-[#f6e4ee]/75 transition-colors hover:text-[#ff8dc6]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#fcd434] transition-transform group-hover:rotate-45"></span> หน้าแรก
          </a>
          <a href="/promotion" class="group flex items-center text-[#f6e4ee]/75 transition-colors hover:text-[#ff8dc6]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#fcd434] transition-transform group-hover:rotate-45"></span> โปรโมชั่นสมาชิก
          </a>
          <a href="/ทดลองเล่น" class="group flex items-center text-[#f6e4ee]/75 transition-colors hover:text-[#ff8dc6]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#fcd434] transition-transform group-hover:rotate-45"></span> ทดลองเล่นเกม
          </a>
          <a href="/ทางเข้า" class="group flex items-center text-[#f6e4ee]/75 transition-colors hover:text-[#ff8dc6]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#fcd434] transition-transform group-hover:rotate-45"></span> ทางเข้าล่าสุด
          </a>
          <a href="/register" class="group flex items-center text-[#f6e4ee]/75 transition-colors hover:text-[#ff8dc6]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#fcd434] transition-transform group-hover:rotate-45"></span> สมัครสมาชิก
          </a>
          <a href="/login" class="group flex items-center text-[#f6e4ee]/75 transition-colors hover:text-[#ff8dc6]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#fcd434] transition-transform group-hover:rotate-45"></span> เข้าสู่ระบบ
          </a>
          <a href="/about-us" class="group flex items-center text-[#f6e4ee]/75 transition-colors hover:text-[#ff8dc6]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#fcd434] transition-transform group-hover:rotate-45"></span> เกี่ยวกับเรา
          </a>
