---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt = "โลโก้ PLUSPSG เป็นตัวอักษร PG ในกรอบพิกเซลสีขาวดำ ตามด้วยคำว่า PLUSPSG ตัวหนาไล่เฉดจากเหลืองทองไปส้มและแดง";
---

<footer class="relative mt-32 w-full border-t border-[#7a0304]/60 bg-[#0b0402] pt-64 pb-6 font-sans text-[#e9d6ac] shadow-[0_-10px_30px_rgba(226,6,10,0.18)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#7a0304]/75 bg-gradient-to-r from-[#0b0402] via-[#240803] to-[#0b0402] p-6 shadow-[0_15px_40px_rgba(226,6,10,0.3)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#fff6e0] uppercase italic drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)] md:text-3xl">
        <span aria-hidden="true">🎰</span> พร้อมปั่นสล็อตกับ PLUSPSG แล้วหรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#e9d6ac]/90 md:text-base">
        สมัคร PLUSPSG ผ่านมือถือได้ด้วยตนเอง เลือกเกมสล็อตได้หลายค่ายและหลายระดับการเดิมพัน ตรวจสอบโปรโมชั่นที่บัญชีมีสิทธิ์รับ แล้วฝากถอนได้ครบในบัญชีเดียว
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#fbbf14] bg-gradient-to-b from-[#fae21e] to-[#e2060a] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#0b0402] shadow-[0_0_15px_rgba(250,226,30,0.45)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🚀</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#ff4b18] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[100, 200, 300]}
                sizes="100px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(250,226,30,0.55)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-b from-[#fae21e] to-[#e2060a] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(250,226,30,0.5)]">PLUSPSG</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#c2a878]">
          PLUSPSG ให้บริการเกมสล็อตออนไลน์ผ่านมือถือและคอมพิวเตอร์ มีเกมให้เลือกหลายรูปแบบตั้งแต่สล็อตเบทต่ำไปจนถึงเกมที่มีฟีเจอร์โบนัส พร้อมโปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%
          ตามเงื่อนไข ระบบสมัครและฝากถอนออกแบบให้ใช้งานสะดวก พร้อมแอดมินดูแลผ่าน LINE Official ตลอด 24 ชั่วโมง
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/30 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.1)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>
        </div>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">
                  📍
                </span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a
                  href={`mailto:${BRAND_ADDRESS.email}`}
                  class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">
                    ✉️
                  </span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }
      </div>

      <div class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#fff6e0] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#e2060a] to-[#fae21e] shadow-[0_0_8px_rgba(250,226,30,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          <a href="/" class="group flex items-center text-[#c2a878] transition-colors hover:text-[#fff6e0]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#fbbf14] transition-transform group-hover:rotate-45"></span> หน้าแรก
          </a>
          <a href="/promotion" class="group flex items-center text-[#c2a878] transition-colors hover:text-[#fff6e0]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#fbbf14] transition-transform group-hover:rotate-45"></span> โปรโมชั่นสมาชิก
          </a>
          <a href="/ทดลองเล่น" class="group flex items-center text-[#c2a878] transition-colors hover:text-[#fff6e0]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#fbbf14] transition-transform group-hover:rotate-45"></span> ทดลองเล่น
          </a>
          <a href="/ทางเข้า" class="group flex items-center text-[#c2a878] transition-colors hover:text-[#fff6e0]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#fbbf14] transition-transform group-hover:rotate-45"></span> ทางเข้าล่าสุด
          </a>
          <a href="/about-us" class="group flex items-center text-[#c2a878] transition-colors hover:text-[#fff6e0]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#fbbf14] transition-transform group-hover:rotate-45"></span> เกี่ยวกับเรา
          </a>
          <a href="/register" class="group flex items-center text-[#c2a878] transition-colors hover:text-[#fff6e0]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#fbbf14] transition-transform group-hover:rotate-45"></span> สมัครสมาชิก
          </a>
          <a href="/login" class="group flex items-center text-[#c2a878] transition-colors hover:text-[#fff6e0]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#fbbf14] transition-transform group-hover:rotate-45"></span> เข้าสู่ระบบ
          </a>
          <a href="/contact-us" class="group flex items-center text-[#c2a878] transition-colors hover:text-[#fff6e0]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#fbbf14] transition-transform group-hover:rotate-45"></span> ติดต่อแอดมิน
          </a>
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#fff6e0] uppercase">
          ระบบการเงิน
          <span class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#e2060a] to-[#fae21e] shadow-[0_0_8px_rgba(250,226,30,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#c2a878]">รองรับการฝาก-ถอนผ่านแอปธนาคารชั้นนำและ TrueMoney Wallet โดยควรใช้บัญชีชื่อเดียวกับข้อมูลที่สมัครไว้</p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-white/5 bg-[#240803] transition-colors hover:border-[#fbbf14]/50" title="ตรวจสอบรายการฝากถอนย้อนหลัง">
          <span class="flex items-center gap-1 text-xs font-bold text-[#e9d6ac]"><span aria-hidden="true" class="text-lg text-[#fbbf14]">🧾</span> ตรวจสอบสถานะธุรกรรมได้ในบัญชีสมาชิก</span>
        </div>
      </div>
    </div>

    <hr class="mb-6 border-[#240803]" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#c2a878] md:block">
      PLUSPSG ให้บริการเกมสล็อตออนไลน์ผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ มีเกมให้เลือกหลายค่ายและหลายระดับการเดิมพัน ตั้งแต่สล็อตเบทต่ำ เกมโบนัส สล็อตแจ็คพอต ไปจนถึงเกมใหม่ที่อัปเดตเข้ามาต่อเนื่อง
      ก่อนเริ่มเล่นสามารถตรวจสอบกติกา จำนวนเพย์ไลน์ ฟีเจอร์ และช่วงการเดิมพันของแต่ละเกมได้ ผลรางวัลของเกมสล็อตมีความไม่แน่นอน จึงไม่มีเกมหรือบัญชีผู้เล่นใดที่รับประกันว่าแตกง่ายหรือทำกำไรได้ทุกครั้ง
      ผู้เล่นควรเลือกขนาดเดิมพันให้เหมาะกับเงินทุนและงบประมาณของตนเอง โปรโมชั่นแต่ละรายการมีวิธีคำนวณ รอบรับ และข้อกำหนดแตกต่างกัน แนะนำให้อ่านเงื่อนไขเกี่ยวกับยอดที่เข้าร่วมและการถอนก่อนกดรับทุกครั้ง
      ใช้งานได้ทั้ง Android iOS และคอมพิวเตอร์ผ่านเบราว์เซอร์โดยไม่ต้องติดตั้งโปรแกรมเพิ่ม พร้อมแอดมิน PLUSPSG ตรวจสอบรายการฝากถอนผ่าน LINE Official ตลอด 24 ชั่วโมง
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-white/5 pt-6 text-xs text-[#c2a878] md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-[#fff6e0] uppercase">PLUSPSG</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/terms/" class="transition-colors hover:text-[#fff6e0]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#fff6e0]">นโยบายความเป็นส่วนตัว</a>

        <a
          href="#top"
          class="flex h-8 w-8 items-center justify-center rounded border border-white/10 bg-white/5 text-[#e9d6ac] transition-all hover:border-[#fbbf14] hover:bg-[#240803] hover:shadow-[0_0_15px_rgba(250,226,30,0.5)]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
