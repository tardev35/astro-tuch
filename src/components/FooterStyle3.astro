---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt = `โลโก้ ${BRAND_NAME} เป็นเหรียญกลมขอบทองหนาบนพื้นดำ กลางเหรียญเป็นหมวกนักบินอวกาศโครเมียมสลับทองที่มีบังตาสีทองสะท้อนแสง มีจรวดทองพาดอยู่สองลำ ด้านล่างเป็นคำว่า NAZA ตัวอักษรหนาสามมิติสีทอง และใต้ลงมาเป็นเลข 168 สีเงินโครเมียมขอบทอง`;

// NAZA168 (รอบทองอวกาศ-เงินโครเมียมบนน้ำตาลไหม้ 2026-10-10): footer ที่ใช้งานจริง
// รอบนี้ — รอบก่อน (FLASH877) ใช้ FooterPremium จึงหมุนมาที่ไฟล์นี้ เหตุผลที่เลือก
// ตัวนี้คือ "ทรง" ไม่ใช่สี: FooterPremium / FooterPremiumSumo / FooterHuay /
// Footer เป็นแผ่น rounded-t-[3rem] + ออราเหมือนกันหมดทั้งสี่ตัว ส่วนไฟล์นี้เป็น
// การ์ด CTA ลอยคร่อมขอบบน (-top-14 / md:-top-16) แล้วตัวแผ่นเว้น pt-64 (md:pt-40)
// ไว้รับ — เป็นทรงเดียวในไลบรารีที่ไม่ซ้ำกับสี่ตัวนั้น
//
// ของเดิมที่ค้างอยู่ในไฟล์เป็นเขียวป่า-ทองมงกุฎของ KINGKONG555 (#8ce023 #bde397
// #f2c230 #ffe066 #a87a08 #051400 #0f2e05 #1a5c04 #06220a #e9f7d6
// rgba(140,224,35,α) rgba(242,194,48,α)) ย้ายทั้งไฟล์มาเป็นทองอวกาศ-เงินโครเมียม
// ตามโลโก้จริงแล้ว ไม่เหลือชุดเขียวเดิมเลย
// ⚠️ ทั้งสองรอบมีทอง จึงต้องเทียบเป็น "ค่า" ไม่ใช่ตระกูลสี — #fbc134 ไม่ใช่
// #f2c230 ของ KINGKONG555 และไม่ใช่ #f5c518 ของ FLASH877
//
// footer เป็น "โครม" จึงประกาศสีตัวอักษรของตัวเองครบทุกจุด ไม่ได้ inherit
// BRAND_TEXT และโลโก้ที่เป็นทอง-เงินบนพื้นดำต้องการพื้นเข้มถึงจะอ่านออก
//
// แกนสีที่ใช้ (brand-spec §2): พื้นน้ำตาลไหม้ลึกสุด #241700 ยกระดับด้วย #432b03 /
// #4e3406 · ทองอวกาศ #fbc134 (ตัวอักษร NAZA บนโลโก้ และ vivid ของ logo.webp)
// เป็นหัวคอลัมน์ เส้นคั่น ขอบการ์ด และออรา · ทองสว่าง #ffe87a กับทองกลางเข้ม
// #cf9a18 เป็นสองปลายของไล่เฉดปุ่ม · ทองลึก #96690a เป็นขอบปุ่ม ไม่ถือตัวอักษร ·
// เงินโครเมียม #cfd6e3 (เลข 168 กับหมวกนักบินอวกาศ) เป็นฮิวที่สอง ถือขอบการ์ด
// ลอย จุดนำลิงก์ และปลายไล่เฉดเส้นใต้หัวคอลัมน์ · เนื้อความ #fdf3df ลดน้ำหนัก
// ด้วย opacity
//
// ปุ่มพื้นทองใช้หมึกน้ำตาลเกือบดำ #231500 — พื้นทองสว่างกับตัวอักษรอ่อนอ่านไม่ออก
// (#231500 บน #ffe87a = 14.5:1 · บน #cf9a18 = 7.0:1 ผ่าน AA ทั้งคู่)
// ⚠️ ปลายเข้มของไล่เฉดปุ่มต้องเป็น #cf9a18 ไม่ใช่ #96690a — #96690a รองหมึกนี้ได้
// แค่ ~3.7:1 ซึ่งตก AA
//
// คอปปี้ทั้งไฟล์เขียนใหม่จากบรีฟ NAZA168 ซึ่งเป็น **เว็บสล็อตออนไลน์ล้วน
// ("เว็บสล็อตนาซ่า") ไม่ใช่เว็บหวยและไม่ใช่คาสิโนรวมหมวด** บรีฟรอบนี้พูดเรื่องการ
// รวมเกมสล็อตหลายประเภทไว้ในแพลตฟอร์มเดียว (สล็อตคลาสสิก ฟรีสปิน โบนัสตัวคูณ)
// ระบบจัดหมวดหมู่เกม เข้าเล่นผ่านมือถือและคอมพิวเตอร์ โปรโมชั่นคืนยอดเสีย 0.3%
// แนะนำเพื่อน 0.8% ฝากถอนเข้าบัญชีบริษัทโดยตรง และแอดมิน 24 ชั่วโมง เท่านั้น
// ไม่ได้ระบุใบอนุญาต ชื่อค่ายเกม ชื่อผู้ให้บริการ ชื่อธนาคาร ยอดขั้นต่ำ ค่า RTP
// หรือจำนวนสมาชิกใดไว้ จึงไม่มีในข้อความนี้ และประโยคกำกับของบรีฟเอง (ส่งตรงจาก
// อเมริกา/ฐานเกมหลัก 100% ควรมีข้อมูลผู้ให้บริการที่ตรวจสอบได้รองรับ · คำว่า
// ไม่จำกัดควรระบุให้ชัด · ชื่อบัญชีบริษัทอย่างเดียวไม่รับประกันความปลอดภัย ·
// ห้ามเปิดเผย PIN หรือ OTP) ขนมาด้วย ไม่ตัดทิ้ง
// คำของแบรนด์ก่อนๆ ที่ห้ามหลุดกลับมา: เว็บตรงฐานสล็อตหลัก · ไม่ผ่านเอเย่นต์ ·
// ฐานเว็บสล็อตหลัก · เดิมพันเริ่มต้น 1 บาท · สล็อตเบทต่ำ · ผลการหมุนเป็นแบบสุ่ม ·
// แตกง่าย · ไม่มีขั้นต่ำ · บาคาร่า · รูเล็ต · และคำหวยทุกคำ
//
// ลิงก์: NAZA168 เป็นเว็บสล็อต — /ตรวจหวย กับ /แนวทาง อยู่ใน src/pages-disabled/
// รอบนี้ จึงไม่มีสองลิงก์นั้นในคอลัมน์ลิงก์ด่วน ไม่งั้น verify-build.mjs จะทำให้
// build แดงเพราะ href ชี้ไป route ที่ไม่มีใน dist/ ถ้ารอบหน้าเป็นแบรนด์หวยแล้วย้าย
// ไฟล์กลับเข้า src/pages/ ต้องเพิ่มสองลิงก์นี้คืนพร้อมกัน
//
// /register กับ /login รอบนี้เป็นหน้าปุ่มจริงที่ index ได้ (toggle cta เปิด) ส่วน
// /ทางเข้า ถูกถอดออกจากเมนู navbar รอบนี้ แต่ route ยังมีจริงและยัง index อยู่
// ลิงก์จาก footer จึงยังถูกต้องทั้งสามหน้า (ดู NavbarCyber.astro)
//
// บล็อก <address> ตั้งใจไม่ทาสีแบรนด์ — border-white/15 + bg-black/20 + opacity
// บนสีตัวอักษรที่ inherit มา ลงตัวกับ footer ทุกตัวในไลบรารี ห้าม retheme
---

<footer
  class="relative mt-32 w-full border-t border-[#fbc134]/55 bg-[#241700] pt-64 pb-6 font-sans text-[#fdf3df] shadow-[0_-10px_30px_rgba(251,193,52,0.22)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#cfd6e3]/70 bg-gradient-to-r from-[#432b03] via-[#4e3406] to-[#432b03] p-6 shadow-[0_15px_40px_rgba(0,0,0,0.75)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#fbc134] uppercase italic drop-shadow-[0_2px_4px_rgba(0,0,0,0.6)] md:text-3xl">
        <span aria-hidden="true">🚀</span> พร้อมเริ่มหมุนสล็อตกับ {BRAND_NAME} แล้วหรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#fdf3df]/90 md:text-base">
        สมัคร {BRAND_NAME} ได้ด้วยตนเองผ่านมือถือ กรอกข้อมูลตามที่ระบบกำหนดแล้วเข้าสู่ระบบเพื่อค้นหาเกม ตรวจสอบเครดิต และติดตามโปรโมชั่นได้จากแพลตฟอร์มเดียว
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#96690a] bg-gradient-to-b from-[#ffe87a] to-[#cf9a18] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#231500] shadow-[0_0_15px_rgba(251,193,52,0.45)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🛸</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#4e3406] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[100, 200, 300]}
                sizes="100px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(251,193,52,0.6)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-r from-[#ffe87a] via-[#fbc134] to-[#cfd6e3] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(251,193,52,0.6)]">{BRAND_NAME}</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#fdf3df]/75">
          {BRAND_NAME} เว็บสล็อตนาซ่าที่รวบรวมเกมสล็อตหลายประเภทไว้ในแพลตฟอร์มเดียว ทั้งสล็อตคลาสสิก เกมฟรีสปิน โบนัสตัวคูณ และเกมยอดนิยมจากค่ายที่เปิดให้บริการ รองรับการใช้งาน
          ผ่านมือถือและคอมพิวเตอร์ สมาชิกสามารถค้นหาเกม ตรวจสอบเครดิต และติดตามโปรโมชั่นได้จากระบบเดียว ส่วนการระบุว่าส่งตรงจากเมกาและเป็นฐานเกมหลัก 100% ควรมีข้อมูล
          ผู้ให้บริการที่สามารถตรวจสอบได้รองรับ ไม่ควรใช้เป็นหลักฐานยืนยันเพียงอย่างเดียว
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/40 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.12)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>
        </div>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }
      </div>

      <nav aria-label="ลิงก์ด่วน" class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#fbc134] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#fbc134] to-[#cfd6e3] shadow-[0_0_8px_rgba(251,193,52,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          <a href="/" class="group flex items-center text-[#fdf3df]/75 transition-colors hover:text-[#fbc134]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#cfd6e3] transition-transform group-hover:rotate-45"></span> หน้าแรก
          </a>
          <a href="/promotion" class="group flex items-center text-[#fdf3df]/75 transition-colors hover:text-[#fbc134]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#cfd6e3] transition-transform group-hover:rotate-45"></span> โปรโมชั่นสมาชิก
          </a>
          <a href="/ทดลองเล่น" class="group flex items-center text-[#fdf3df]/75 transition-colors hover:text-[#fbc134]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#cfd6e3] transition-transform group-hover:rotate-45"></span> ทดลองเล่นสล็อต
          </a>
          <a href="/ทางเข้า" class="group flex items-center text-[#fdf3df]/75 transition-colors hover:text-[#fbc134]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#cfd6e3] transition-transform group-hover:rotate-45"></span> ทางเข้าล่าสุด
          </a>
          <a href="/register" class="group flex items-center text-[#fdf3df]/75 transition-colors hover:text-[#fbc134]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#cfd6e3] transition-transform group-hover:rotate-45"></span> สมัครสมาชิก
          </a>
          <a href="/login" class="group flex items-center text-[#fdf3df]/75 transition-colors hover:text-[#fbc134]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#cfd6e3] transition-transform group-hover:rotate-45"></span> เข้าสู่ระบบ
          </a>
          <a href="/about-us" class="group flex items-center text-[#fdf3df]/75 transition-colors hover:text-[#fbc134]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#cfd6e3] transition-transform group-hover:rotate-45"></span> เกี่ยวกับเรา
          </a>
          <a href="/contact-us" class="group flex items-center text-[#fdf3df]/75 transition-colors hover:text-[#fbc134]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#cfd6e3] transition-transform group-hover:rotate-45"></span> ติดต่อแอดมิน
          </a>
        </div>
      </nav>

      <section aria-label="ช่องทางทำรายการ" class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#fbc134] uppercase">
          ช่องทางทำรายการ
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#fbc134] to-[#cfd6e3] shadow-[0_0_8px_rgba(251,193,52,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#fdf3df]/75">
          ก่อนทำรายการทุกครั้งควรตรวจสอบชื่อบัญชีปลายทางให้ตรงกับข้อมูลจากช่องทางหลักของเว็บไซต์ และเก็บเวลา จำนวนเงิน พร้อมหลักฐานธุรกรรมไว้สำหรับตรวจสอบย้อนหลัง
        </p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-[#fbc134]/45 bg-[#432b03] transition-colors hover:border-[#cfd6e3]/70">
          <span class="flex items-center gap-1 text-xs font-bold text-[#fdf3df]"><span aria-hidden="true" class="text-lg text-[#fbc134]">🎰</span> ตรวจสอบช่องทางที่ระบบรองรับก่อนทำรายการ</span>
        </div>
      </section>
    </div>

    <hr class="mb-6 border-[#4e3406]" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#fdf3df]/70 md:block">
      {BRAND_NAME} เป็นช่องทางสำหรับผู้ที่ต้องการเข้าเล่นเกมสล็อตออนไลน์จากแพลตฟอร์มเดียว มีทั้งสล็อตวงล้อทั่วไปที่รูปแบบการเล่นเข้าใจง่าย เกมฟรีสปิน เกมที่มีโบนัส
      ตัวคูณ และเกมยอดนิยมจากค่ายที่เปิดให้บริการ รองรับการใช้งานผ่านมือถือและคอมพิวเตอร์ หลังเข้าสู่ระบบสามารถค้นหาเกม ตรวจสอบเครดิต และติดตามโปรโมชั่นได้จาก
      แพลตฟอร์มเดียวโดยไม่ต้องสมัครใหม่หลายครั้ง ระบบจัดหมวดหมู่เกมช่วยให้ค้นหาค่ายที่สนใจได้ง่ายขึ้น และสมาชิกสามารถตรวจสอบยอดเดิมพัน ตารางจ่าย และรายละเอียดของแต่ละ
      เกมก่อนเริ่มเล่นได้โดยตรง จำนวนค่ายและเกมที่เปิดให้บริการอาจเปลี่ยนแปลงตามช่วงเวลา จึงควรตรวจสอบรายละเอียดล่าสุดจากระบบก่อนเริ่มเล่น สำหรับข้อความว่าระบบเดิมพัน
      เป็นรุ่นใหม่ล่าสุดและได้มาตรฐานสากล ควรมีข้อมูลด้านเทคโนโลยี ผู้พัฒนาเกม หรือมาตรฐานที่ใช้งานจริงประกอบ เพื่อให้ตรวจสอบได้ว่ามีการปรับปรุงส่วนใดบ้าง ไม่ว่าจะเป็น
      การเชื่อมต่อเกม การแสดงผลบนมือถือ หรือการจัดการบัญชีสมาชิก โปรโมชั่นคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% คำนวณจากยอดที่เข้าเกณฑ์ตามรอบที่กำหนด แต่ละรายการ
      อาจมีรอบตัดยอด ค่ายเกมที่ร่วมรายการ และข้อกำหนดแตกต่างกัน จึงควรตรวจสอบเงื่อนไขล่าสุดก่อนกดรับสิทธิ์ ส่วนคำว่าไม่จำกัดในกิจกรรมแนะนำเพื่อน ควรระบุให้ชัดว่า
      หมายถึงจำนวนเพื่อนที่แนะนำ จำนวนครั้งในการรับสิทธิ์ หรือวงเงินโบนัส หากเว็บไซต์ระบุว่าเงินฝากเข้าบัญชีบริษัทโดยตรง ควรแสดงชื่อบริษัทหรือนิติบุคคลที่สามารถตรวจสอบได้
      เพราะชื่อบัญชีบริษัทเพียงอย่างเดียวไม่สามารถรับประกันว่าธุรกรรมจะไม่มีความเสี่ยง ก่อนโอนเงินควรเปรียบเทียบชื่อบัญชีปลายทางกับข้อมูลจากช่องทางหลัก เก็บหลักฐาน
