---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt = "โลโก้ VAK88 ตัวอักษร VAK สีเงินเมทัลลิกขอบดำ ต่อด้วยเลข 88 สีทองขัดเงา ด้านหลังเป็นนกฟีนิกซ์กางปีกสีแดงเข้มไล่เฉดทอง";

// ไม่มีลิงก์ /ตรวจหวย และ /แนวทาง ในคอลัมน์ลิงก์ด่วน — VAK88 เป็นแบรนด์สล็อต
// ทั้งสองหน้าจอดอยู่ใน src/pages-disabled/ ลิงก์ที่ค้างไว้จะกลายเป็น 404
//
// /ทางเข้า ยังมีลิงก์อยู่ตรงนี้: หน้านั้นยัง route และ index อยู่ แค่ไม่มีใน
// เมนู navbar เพราะ toggle ของ register/login เปิด (ดู NavbarStyle4Black.astro)
//
// สองสีของแบรนด์แบ่งหน้าที่กัน: ทอง #e6b23c เป็นเส้นคั่น/หัวคอลัมน์/ไฮไลต์
// ส่วนแดงฟีนิกซ์ #cf2027 เป็นปุ่มและจุดนำลิงก์ พื้นเป็นกรมท่าเกือบดำ #060913
---

<footer class="relative mt-32 w-full border-t border-[#8a5f14]/60 bg-[#060913] pt-64 pb-6 font-sans text-[#ded8ca] shadow-[0_-10px_30px_rgba(230,178,60,0.16)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#8a5f14]/75 bg-gradient-to-r from-[#060913] via-[#1a0d13] to-[#060913] p-6 shadow-[0_15px_40px_rgba(230,178,60,0.26)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#fff4dd] uppercase italic drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)] md:text-3xl">
        <span aria-hidden="true">🎰</span> พร้อมเปิดบัญชีสล็อตเว็บตรงกับ {BRAND_NAME} แล้วหรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#ded8ca]/90 md:text-base">
        สมัคร {BRAND_NAME} ได้ด้วยตนเองทั้งบนมือถือ แท็บเล็ต และคอมพิวเตอร์ ยืนยันเบอร์ด้วย OTP ผูกบัญชีธนาคาร ตั้งรหัสผ่าน แล้วเข้าหน้า Portal หลักเพื่อเลือกค่ายเกมลิขสิทธิ์แท้ได้ในบัญชีเดียว
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#ee3a34] bg-gradient-to-b from-[#ee3a34] to-[#6b0d11] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#fff4dd] shadow-[0_0_15px_rgba(207,32,39,0.45)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🚀</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#cf2027] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[100, 200, 300]}
                sizes="100px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(230,178,60,0.55)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-b from-[#ffd873] to-[#8a5f14] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(230,178,60,0.5)]">{BRAND_NAME}</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#9aa3b8]">
          {BRAND_NAME} คือแพลตฟอร์มเกมสล็อตเว็บตรงที่ให้บริการผ่านช่องทางเข้าเล่นหลักอย่างเป็นทางการ ไม่ต้องผ่านตัวแทนหรือเอเย่นต์ รวมเกมจากค่ายยักษ์ใหญ่ที่ผ่านการตรวจสอบและอนุญาตจากลิขสิทธิ์แท้
          (Certified API) รองรับการเข้าเล่นผ่านเว็บเบราว์เซอร์บนมือถือ แท็บเล็ต และคอมพิวเตอร์ สมาชิกสมัคร เข้าเกม ตรวจสอบเครดิต รับโปรโมชั่น และจัดการฝากถอนได้เอง พร้อมแอดมินดูแลตลอด 24 ชั่วโมง
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/30 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.1)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>
        </div>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">
                  📍
                </span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a
                  href={`mailto:${BRAND_ADDRESS.email}`}
                  class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">
                    ✉️
                  </span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }
      </div>

      <div class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#fff4dd] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#8a5f14] to-[#e6b23c] shadow-[0_0_8px_rgba(230,178,60,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          <a href="/" class="group flex items-center text-[#9aa3b8] transition-colors hover:text-[#fff4dd]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#cf2027] transition-transform group-hover:rotate-45"></span> หน้าแรก
          </a>
          <a href="/promotion" class="group flex items-center text-[#9aa3b8] transition-colors hover:text-[#fff4dd]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#cf2027] transition-transform group-hover:rotate-45"></span> โปรโมชั่นสมาชิก
          </a>
          <a href="/ทดลองเล่น" class="group flex items-center text-[#9aa3b8] transition-colors hover:text-[#fff4dd]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#cf2027] transition-transform group-hover:rotate-45"></span> ทดลองเล่น
          </a>
          <a href="/ทางเข้า" class="group flex items-center text-[#9aa3b8] transition-colors hover:text-[#fff4dd]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#cf2027] transition-transform group-hover:rotate-45"></span> ทางเข้าล่าสุด
          </a>
          <a href="/about-us" class="group flex items-center text-[#9aa3b8] transition-colors hover:text-[#fff4dd]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#cf2027] transition-transform group-hover:rotate-45"></span> เกี่ยวกับเรา
          </a>
          <a href="/register" class="group flex items-center text-[#9aa3b8] transition-colors hover:text-[#fff4dd]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#cf2027] transition-transform group-hover:rotate-45"></span> สมัครสมาชิก
          </a>
          <a href="/login" class="group flex items-center text-[#9aa3b8] transition-colors hover:text-[#fff4dd]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#cf2027] transition-transform group-hover:rotate-45"></span> เข้าสู่ระบบ
          </a>
          <a href="/contact-us" class="group flex items-center text-[#9aa3b8] transition-colors hover:text-[#fff4dd]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#cf2027] transition-transform group-hover:rotate-45"></span> ติดต่อแอดมิน
          </a>
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#fff4dd] uppercase">
          ระบบการเงิน
          <span class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#8a5f14] to-[#e6b23c] shadow-[0_0_8px_rgba(230,178,60,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#9aa3b8]">รองรับการฝาก-ถอนอัตโนมัติผ่านแอปธนาคารชั้นนำและ TrueMoney Wallet โดยควรใช้บัญชีชื่อเดียวกับข้อมูลที่ผูกไว้ตอนสมัคร</p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-white/5 bg-[#121a2e] transition-colors hover:border-[#e6b23c]/50" title="ตรวจสอบรายการฝากถอนย้อนหลัง">
          <span class="flex items-center gap-1 text-xs font-bold text-[#ded8ca]"><span aria-hidden="true" class="text-lg text-[#e6b23c]">🧾</span> ตรวจสอบสถานะธุรกรรมได้ในบัญชีสมาชิก</span>
        </div>
      </div>
    </div>

    <hr class="mb-6 border-[#121a2e]" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#9aa3b8] md:block">
      {BRAND_NAME} เป็นช่องทางสำหรับผู้ที่ต้องการเข้าเล่นเกมสล็อตจากหลายค่ายผ่านบัญชีเดียว โดยจัดหมวดหมู่ไว้เพื่อให้สมาชิกค้นหาเกมที่ต้องการและสลับค่ายได้สะดวก
      สำหรับคำว่า “เว็บตรงเจ้าแรก” “แพลตฟอร์มหลัก” และ “ลิขสิทธิ์แท้ 100%” ควรยึดข้อมูลผู้ให้บริการหรือรายละเอียดที่สามารถตรวจสอบได้บนเว็บไซต์เป็นหลัก ส่วนผลลัพธ์ของเกมสล็อตเป็นไปตามระบบของแต่ละเกม
      และอัตราการชนะ (RTP) เป็นค่าทางสถิติระยะยาว จึงไม่สามารถรับประกันได้ว่าเกมใดจะสร้างกำไรได้ทุกครั้ง กติกา อัตราจ่าย ช่วงเดิมพันขั้นต่ำและสูงสุดของแต่ละเกมให้ยึดค่าที่ระบบแสดง ณ เวลาทำรายการ
      เงื่อนไข “ไม่มีขั้นต่ำ” และ “รองรับทุกธนาคารชั้นนำ” ก็เช่นกัน ควรตรวจสอบจากหน้าฝากถอนก่อนทำรายการ เนื่องจากช่องทางแต่ละประเภทอาจกำหนดยอดขั้นต่ำ วงเงิน หรือเงื่อนไขแตกต่างกัน
      ก่อน Login หรือทำรายการฝากเงิน ควรตรวจสอบว่ากำลังใช้งานช่องทางของผู้ให้บริการที่ถูกต้อง ตั้งรหัสผ่านที่คาดเดายาก และไม่เปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      โปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% มีวิธีคำนวณ รอบรับโบนัส และข้อกำหนดในการถอนกำกับอยู่ แนะนำให้อ่านรายละเอียดล่าสุดก่อนกดรับทุกครั้ง ใช้งานได้ทั้ง Android iOS
      และคอมพิวเตอร์ผ่านเบราว์เซอร์โดยไม่ต้องติดตั้งโปรแกรมเพิ่ม พร้อมแอดมิน {BRAND_NAME} ตรวจสอบรายการให้ตลอด 24 ชั่วโมง
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-white/5 pt-6 text-xs text-[#9aa3b8] md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-[#fff4dd] uppercase">{BRAND_NAME}</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/terms/" class="transition-colors hover:text-[#fff4dd]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#fff4dd]">นโยบายความเป็นส่วนตัว</a>

        <a
          href="#top"
          class="flex h-8 w-8 items-center justify-center rounded border border-white/10 bg-white/5 text-[#ded8ca] transition-all hover:border-[#e6b23c] hover:bg-[#121a2e] hover:shadow-[0_0_15px_rgba(230,178,60,0.5)]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
