---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// เขียนจาก src/assets/logo.webp ของดรอป 2026-10-22 จริง (เปิดอ่านด้วย Read ก่อนเขียน)
// ไม่ใช่คัดลอกของรอบก่อน — หัวหมูการ์ตูนหน้ากากโจรสีชมพูและตัวอักษร "มีทรัพย์" ของ
// มีทรัพย์168 ที่เคยอยู่บรรทัดนี้ไม่มีในรูปรอบนี้เลย และคำว่า "สบาย" ทองคู่เลข 168
// ฟ้าสกายของ สบาย168 (แบรนด์ขาออกรอบนี้) ก็ไม่มีเช่นกัน
const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส ทางซ้ายเป็นหัวมังกรจีนสามมิติสีทองหันไปทางซ้าย อ้าปากเห็นเขี้ยว มีเขาและหนวดเป็นเส้นทองสะบัดไปด้านหลัง ทางขวาเป็นคำว่า พักยก ตัวอักษรไทยหนาสามมิติผิวทองมันวาวไล่เฉดจากทองอ่อนที่ยอดลงไปหาทองเข้มที่ฐาน ต่อท้ายด้วยเลข 168 ตัวหนาสามมิติผิวโครเมียมเงินขัดเงา ทั้งหมดตัดขอบดำหนาและมีประกายแสงสีขาวพาดอยู่บนผิวตัวอักษร`;

// พักยก168 (รอบทองมังกรนำ-โครเมียมเงินรอง บนธีมมืด 2026-10-22): footer ที่ใช้งานจริง
// รอบนี้ — รอบก่อน (สบาย168) ใช้ FooterPremium เหตุผลที่เลือกไฟล์นี้คือ "ทรง"
// ไม่ใช่สี: FooterPremium กับ Footer / FooterPremiumSumo / FooterHuay เป็นแผ่น
// rounded-t-[3rem] + ออราเรืองแสงเบลอคร่อมขอบบน กริด 12 คอลัมน์ ส่วน FooterStyle2
// เป็นแผ่นแบนขอบบนเส้นหนา กริด 4 คอลัมน์เท่ากัน ไฟล์นี้เป็น **การ์ด CTA ลอยคร่อม
// ขอบบน** (-top-14 / md:-top-16) แล้วตัวแผ่นเว้น pt-64 (md:pt-40) ไว้รับ และมี
// **BankStrip** อยู่ในคอลัมน์ช่องทางทำรายการ — เป็นทรงเดียวในไลบรารีที่ไม่ซ้ำกับ
// ทั้งสองกลุ่มนั้น
//
// ของเดิมที่ค้างอยู่ในไฟล์เป็นชมพูบานเย็นของ มีทรัพย์168 (dd1b74 a4186b 4a0d35
// 2d0720 f7dcf6 f0ccf5 ffffff rgba 221/27/116 α) rgba 164/24/107 α) rgba 74/13/53 α))
// ก่อนหน้านั้นเป็นแดงชาด-ทองเนยของ มีเฮ168 (fb1b32 ff8f9c 5c0410 fcd45c ffeec0
// 6b4a08 fdeaec 0c0205 1a040a 2b0711 1b0308) ทองนำ-ชมพูฟูเชียของ มีโชค168 (fcd434
// ffeaa0 f5469f ff8dc6 8c0f52 7a5508 f6e4ee 24101c 160a12 0b0509 1a0612) และ
// แดงมังกร-โครเมียมขาวของ GT66B (fb141b ff5f63 ffa0a2 8a0609 3b0405 1c0c0b 0b0303
// fdfcfd eceaea 190505 db040b) — ย้ายทั้งไฟล์มาเป็นทองมังกรของรอบนี้แล้ว
// ไม่เหลือชมพู ไม่เหลือแดง และไม่เหลือฟ้าเลย
// ⚠️⚠️ **กับดักรอบนี้คือทอง** — มีโชค168 ที่เคยค้างอยู่ในไฟล์นี้ก็มีทอง (fcd434
// ffeaa0) มีเฮ168 ก็มีทองเนย (fcd45c) และเกือบทุกแบรนด์ในรีโปนี้เคยมีทอง
// ส่วนรอบนี้คือ **#eeae12** (+#fded41 #9f600d) ซึ่งห่างจาก e6a416 ของ **ยูฟ้า168**
// แค่ R8/G10/B4 และห่างจาก e5a81b ของ **UFA324** แค่ R9/G6/B7
// การเจอทองที่ไหนจึงไม่พิสูจน์อะไรเลย ต้องเทียบเป็น "ค่า" ทีละตัวกับ
// .claude/brand-spec-pakyok168.md §2
// ⚠️ **ยูฟ้า168 เป็นเจ้าเดียวที่เดินทอง+เงินเหมือนรอบนี้** ตัวแยกคือพื้นของเขาเป็น
// ดำสนิท ส่วนของเราเป็นน้ำตาล และโครเมียมของเขาเป็นเทาอมฟ้าเย็น (e8ecf1 a8b2bf
// 78828f 5a6472) ส่วนของเราเป็นเทากลาง-อุ่น (e0e0df c0c0bf a1a09e)
//
// footer เป็น "โครม" จึงประกาศสีตัวอักษรของตัวเองครบทุกจุด ไม่ได้ inherit
// BRAND_TEXT
// ⚠️⚠️ **พื้นเพจรอบนี้เป็นน้ำตาลกาแฟเข้ม #291d0f (จาก bg.json)** — footer เป็น
// น้ำตาลลึกที่ **จมกว่าพื้นเพจหนึ่งระดับ** รอบนี้พื้นเพจมืดเหมือน footer สิ่งที่
// ทำให้ footer อ่านออกว่าแยกชั้นคือ **เส้นขอบทองกับเงาทอง ไม่ใช่ความต่างของ
// ความสว่าง** **ห้าม "แก้" ให้สว่างขึ้นเพื่อให้ตัดกับพื้น**
//
// แกนสีที่ใช้ (brand-spec §2): พื้นผิวจม #1f0f04 ยกระดับด้วย #4e2f11 ·
// **ทองแกน #eeae12 (หัวมังกรและคำว่า "พักยก" บนโลโก้ กับทองคำแท่งบนแบนเนอร์) เป็น
// เส้นใต้หัวคอลัมน์ ขอบ เส้นคั่น พื้นถมปุ่ม และหัวการ์ด CTA** ·
// ทองลึก #9f600d เป็นปลายเข้มของไล่เฉดและเงา ·
// ไอวอรี #f4ead6 เป็นเนื้อความ (10.1:1 บน #4e2f11 · 15.6:1 บน #1f0f04) ·
// ทองสว่าง #fded41 เป็นหัวคอลัมน์ หัวการ์ด CTA ชื่อแบรนด์ และสี hover ของลิงก์
// โครเมียมเงิน #e0e0df เป็นสีประกอบบนจุดนำลิงก์ฝั่งขวาและปลายไล่เฉดของเวิร์ดมาร์ก
//
// ⚠️⚠️ **#9f600d ห้ามถือตัวอักษรเด็ดขาด** — ได้แค่ 2.4:1 บน #4e2f11 และ 3.7:1 บน
// #1f0f04 ทั้งคู่ตกเกณฑ์ AA สำหรับ text ขนาดปกติ ในไฟล์นี้ทองลึกจึงเป็น
// **พื้นถม / ขอบ / เงาเท่านั้น** ส่วน **#eeae12 ถือตัวอักษรได้จริง** (8.2:1 บน
// #1f0f04 · 6.2:1 บน #4e2f11) แต่สงวนไว้เป็น accent และหัวการ์ด CTA ใช้ #fded41
// ซึ่งอ่านง่ายกว่า
// ปุ่มพื้นทองใช้หมึก **น้ำตาลเกือบดำ #1f0f04** — บน #fded41 ≈ 15.4:1 · บน #eeae12
// ≈ 9.5:1 · บน #9f600d ≈ 4.6:1 ผ่าน AA ทุก stop
// ⚠️ **ห้ามพลิกไปใช้หมึกขาวบนพื้นทอง** (ขาวบน #eeae12 เหลือ ~2.2:1)
// แผ่นที่เลื่อนขึ้นมาตอน hover เป็นน้ำตาลยก #4e2f11 — หมึกไอวอรีบนนั้นได้ ≈ 10.1:1
// rgba() ที่อนุญาตรอบนี้: rgba(238,174,18,α) · rgba(253,237,65,α) ·
// rgba(224,224,223,α) · rgba(31,15,4,α) · rgba(0,0,0,α)
// ⚠️ รอบนี้ **ไม่มีชมพู ไม่มีแดง ไม่มีม่วง ไม่มีฟ้า/น้ำเงิน ไม่มีเขียว
// ไม่มีโรสโกลด์ ไม่มีส้ม** — เขียว #00B900 บนปุ่ม LINE เป็น
// **สีซีแมนติกของแบรนด์ LINE ไม่ใช่สีของเว็บ** จึงคงไว้ตามเดิม เช่นเดียวกับโลโก้
// ธนาคารจริงใน BankStrip (ไฟล์นั้นไม่มีสีแบรนด์อยู่เลย **sweep สีต้องข้ามทั้งไฟล์**)
//
// คอปปี้ทั้งไฟล์เขียนใหม่จากบรีฟ พักยก168 (src/assets/content.txt) ซึ่งแกนคือ
// **"เว็บสล็อตออนไลน์" — เกมสล็อตจากค่ายต่าง ๆ โหมดทดลองเล่นฟรี และโปรโมชั่นสมาชิก**
// โดยจุดที่บรีฟย้ำซ้ำที่สุดคือ **การตรวจสอบหลักฐานลิขสิทธิ์เกมและข้อมูลบัญชีรับเงิน
// ที่ยืนยันได้ ก่อนเชื่อคำโฆษณา**
// ⚠️ **ไม่ใช่เว็บเบทต่ำแบบรอบก่อน** — "เบทต่ำ" "สบายเป๋า" "ทุนน้อย" "เล่นง่าย"
// "ยอดเข้าบริษัทโดยตรง" "ปรับระดับการเดิมพัน" "ยอดเดิมพันขั้นต่ำ" "งบประมาณ" และ
// "นิติบุคคล" เป็นคำของ **สบาย168** ถอดออกครบแล้วและห้ามใส่กลับ
// ⚠️ **"ไฮโล ยิงปลา หวย ฟุตบอล บาคาร่า" ก็เป็นคำของรอบก่อนๆ** — บรีฟรอบนี้พูดถึง
// **สล็อตอย่างเดียว** ห้ามเติมหมวดเกมอื่นเอง
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อธนาคารหรือชื่อค่ายเกมแม้แต่รายเดียว** — PG SOFT,
// JOKER, JILI และ "นำเข้าตรงจากสิงคโปร์" ที่เคยอยู่ในไฟล์นี้เป็นคำของ มีโชค168
// ทั้งหมด ไม่ได้ระบุเลขใบอนุญาต ชื่อหน่วยงานกำกับ ชื่อนิติบุคคล ยอดขั้นต่ำเป็น
// ตัวเลข ค่า RTP จำนวนสมาชิก หรือปีก่อตั้งไว้เลย จึงไม่มีในข้อความนี้
// ตัวเลขที่ใช้ได้มีแค่ **0.3% · 0.8% · 24ชม. · 3 ขั้นตอน · 100%**
// ⚠️ บรีฟ "ตั้งคำถามกับคำโฆษณาของตัวเอง" และประโยคกำกับพวกนั้นต้องขนมาด้วย ห้าม
// ตัดทิ้งเพราะฟังดูไม่ขายของ: คำกล่าวอ้างเกี่ยวกับลิขสิทธิ์เกม ความน่าเชื่อถือ และ
// การไม่ใช้บัญชีม้า ควรตรวจสอบจากหลักฐานของผู้ให้บริการและข้อมูลบัญชีรับเงินที่ยืนยัน
// ได้ · ผลจากการทดลองเล่นไม่ได้บ่งบอกถึงผลลัพธ์เมื่อเดิมพันจริง · เครดิตคืนยอดเสีย
// ไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือรับประกันผลกำไรในอนาคต ·
// ควรตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุดอีกครั้ง
// ⚠️ คำของแบรนด์ก่อนที่ห้ามหลุดกลับมา: ระบบดูแลการเงิน · ฝากถอนทุกช่องทาง
// (มีทรัพย์168) · สล็อตรวมเกมกำไรงาม · เล่นง่ายทุกค่าย (รวยแทร่168) · เกมสล็อตเจนซี ·
// ไม่มีขั้นต่ำ (มีเฮ168) · ลิขสิทธิ์แท้ · นำเข้าตรงจากสิงคโปร์ (มีโชค168) · เว็บตรง ·
// ไม่ผ่านเอเย่นต์ · แตกง่าย · การันตีเว็บแท้ · เว็บแท้อันดับ1 · และคำหวยทุกคำ
// (⚠️ **"ไม่ผ่านม้า" กับ "บัญชีม้า" ใช้ได้** เพราะเป็นคำของบรีฟรอบนี้เอง —
// บรีฟเขียนทั้งสองคำตรงๆ ใน H1 และในย่อหน้าแรก)
//
// ลิงก์: พักยก168 เป็นเว็บสล็อต ไม่ใช่เว็บหวย — /ตรวจหวย กับ /แนวทาง อยู่ใน
// src/pages-disabled/ รอบนี้ จึงไม่มีสองลิงก์นั้นในคอลัมน์ลิงก์ด่วน ไม่งั้น
// verify-build.mjs จะทำให้ build แดงเพราะ href ชี้ไป route ที่ไม่มีใน dist/
// ถ้ารอบหน้าเป็นแบรนด์หวยแล้วย้ายไฟล์กลับเข้า src/pages/ ต้องเพิ่มสองลิงก์นี้คืน
//
// /register กับ /login รอบนี้เป็นหน้าปุ่มจริงที่ index ได้ (toggle cta เปิด) ส่วน
// /ทางเข้า ถูกถอดออกจากเมนู navbar รอบนี้ แต่ route ยังมีจริงและยัง index อยู่
// ลิงก์จาก footer จึงยังถูกต้องทั้งสามหน้า (ดู NavbarStyle4Black.astro)
//
// หน้าต่างครอปโลโก้: logo.webp รอบนี้เป็นภาพจัตุรัส 500x500 และเนื้อโลโก้จริงกินแถว
// 148..325 = 29.6%..65.0% ของความสูง ที่ความกว้าง 180px จึงตกอยู่ที่ 53..117px
// หน้าต่างจึงเป็น h-[66px] คู่กับ -translate-y-[52px] (แสดงแถว 52..118) ซึ่งครอบเนื้อ
// โลโก้ได้ครบพอดีโดยเหลือขอบข้างละ 1px — **ค่าคู่นี้ผูกกับสัดส่วนของโลโก้ดรอปนี้
// ห้ามคัดลอกข้ามรอบ** ของเดิมคือ h-[56px]/-62px ซึ่งจะตัดเขามังกรด้านบนทิ้ง 9px
//
// บล็อก <address> ตั้งใจไม่ทาสีแบรนด์ — border-white/15 + bg-black/20 + opacity
// บนสีตัวอักษรที่ inherit มา ลงตัวกับ footer ทุกตัวในไลบรารี ห้าม retheme
---

<footer
  class="relative mt-32 w-full border-t border-[#eeae12]/55 bg-[#1f0f04] pt-64 pb-6 font-sans text-[#f4ead6] shadow-[0_-10px_30px_rgba(238,174,18,0.28)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#eeae12]/60 bg-gradient-to-r from-[#4e2f11] via-[#1f0f04] to-[#4e2f11] p-6 shadow-[0_15px_40px_rgba(0,0,0,0.7)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#fded41] uppercase italic drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)] md:text-3xl">
        <span aria-hidden="true">🐉</span> พร้อมเริ่มเล่นสล็อตค่ายแท้กับ {BRAND_NAME} แล้วหรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#f4ead6]/90 md:text-base">
        สมัคร {BRAND_NAME} ได้ด้วยตนเองผ่านมือถือ โดยตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง อ่านเงื่อนไขการเปิดบัญชีและนโยบายความเป็นส่วนตัว แล้วกรอกข้อมูลตามที่ระบบกำหนดก่อนยืนยันบัญชี
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#9f600d] bg-gradient-to-b from-[#fded41] to-[#eeae12] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#1f0f04] shadow-[0_0_15px_rgba(238,174,18,0.5)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">📝</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#4e2f11] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
