// หน้าต่างจึงเป็น h-[70px] คู่กับ -translate-y-[55px] (แสดงแถว 55..125) ซึ่งครอบเนื้อ
// โลโก้ได้ครบโดยเหลือขอบบน 6px ล่าง 10px — **ค่าคู่นี้ผูกกับสัดส่วนของโลโก้ดรอปนี้
// ห้ามคัดลอกข้ามรอบ** ของเดิมคือ h-[58px]/-59px ซึ่งจะตัดขอบล่างของเลข 88 ทิ้ง
---

<footer class="relative mt-32 w-full border-t border-[#fb439b]/55 bg-[#ffffff] pt-64 pb-6 font-sans text-[#6a0f3c] shadow-[0_-10px_30px_rgba(251,67,155,0.22)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-3xl border border-[#fb439b]/60 bg-gradient-to-r from-[#fff4fb] via-[#ffffff] to-[#fff4fb] p-6 shadow-[0_15px_40px_rgba(106,15,60,0.18)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#9c0f55] md:text-3xl">
        <span aria-hidden="true">💗</span> พร้อมเริ่มเล่นเกมสล็อตกับ {BRAND_NAME} แล้วหรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#6a0f3c]/80 md:text-base">
        สมัครสมาชิก {BRAND_NAME} ได้ด้วยตนเองผ่านมือถือ โดยเปิดเว็บไซต์ผ่านช่องทางที่ตรวจสอบได้ อ่านเงื่อนไขการเปิดบัญชีและนโยบายการจัดเก็บข้อมูลส่วนบุคคล แล้วกรอกข้อมูลตามที่ระบบกำหนดก่อนยืนยันบัญชี
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#85094a] bg-gradient-to-b from-[#d91a73] to-[#85094a] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#ffffff] shadow-[0_8px_20px_rgba(133,9,74,0.35)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">📝</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#6a0f3c] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <span class="block h-[70px] w-[180px] overflow-hidden">
                <Picture
                  src={mainLogo}
                  alt={logoAlt}
                  widths={[180, 360]}
                  sizes="180px"
                  loading="lazy"
                  decoding="async"
                  class="h-auto w-full -translate-y-[55px] drop-shadow-[0_0_12px_rgba(251,67,155,0.55)]"
                  formats={["avif", "webp"]}
                  fallbackFormat="webp"
                  quality={72}
                />
              </span>
            ) : (
              <p class="bg-gradient-to-r from-[#9c0f55] via-[#d91a73] to-[#fb439b] bg-clip-text text-3xl font-black text-transparent">{BRAND_NAME}</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#6a0f3c]/80">
          {BRAND_NAME} นำเสนอเกมสล็อตออนไลน์หลากหลายรูปแบบ พร้อมระบบสมาชิกที่รวบรวมข้อมูลเกม โปรโมชั่น และช่องทางฝากถอนไว้ในเว็บไซต์เดียว ผู้ใช้งานสามารถศึกษากติกาเกม ตรวจสอบเงื่อนไขโบนัส
          และเลือกดูรายละเอียดค่ายเกมที่สนใจได้ ทั้งนี้ คำกล่าวอ้างว่ายูสใหม่แตกไวไม่สามารถใช้รับประกันผลรางวัลได้ เพราะเกมสล็อตมีผลลัพธ์ที่ไม่แน่นอนในแต่ละรอบ
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a href="/line" class="flex items-center gap-2 rounded-full bg-[#00B900] px-4 py-2 text-xs font-bold text-white shadow-[0_4px_12px_rgba(0,185,0,0.25)] transition-opacity hover:opacity-90">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>
        </div>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-[#f4a7cf] bg-[#fff4fb] p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }
      </div>

      <nav aria-label="ลิงก์ด่วน" class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#9c0f55]">
          ลิงก์ด่วน
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#fb439b] to-[#9c0f55] shadow-[0_0_8px_rgba(251,67,155,0.5)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          <a href="/" class="group flex items-center text-[#6a0f3c]/80 transition-colors hover:text-[#9c0f55]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-full bg-[#fb439b] transition-transform group-hover:scale-150"></span> หน้าแรก
          </a>
          <a href="/promotion" class="group flex items-center text-[#6a0f3c]/80 transition-colors hover:text-[#9c0f55]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-full bg-[#f479b9] transition-transform group-hover:scale-150"></span> โปรโมชั่นสมาชิก
          </a>
          <a href="/ทดลองเล่น" class="group flex items-center text-[#6a0f3c]/80 transition-colors hover:text-[#9c0f55]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-full bg-[#fb439b] transition-transform group-hover:scale-150"></span> ทดลองเล่นเกม
          </a>
          <a href="/ทางเข้า" class="group flex items-center text-[#6a0f3c]/80 transition-colors hover:text-[#9c0f55]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-full bg-[#f479b9] transition-transform group-hover:scale-150"></span> ทางเข้าล่าสุด
          </a>
          <a href="/register" class="group flex items-center text-[#6a0f3c]/80 transition-colors hover:text-[#9c0f55]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-full bg-[#fb439b] transition-transform group-hover:scale-150"></span> สมัครสมาชิก
          </a>
          <a href="/login" class="group flex items-center text-[#6a0f3c]/80 transition-colors hover:text-[#9c0f55]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-full bg-[#f479b9] transition-transform group-hover:scale-150"></span> เข้าสู่ระบบ
          </a>
          <a href="/about-us" class="group flex items-center text-[#6a0f3c]/80 transition-colors hover:text-[#9c0f55]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-full bg-[#fb439b] transition-transform group-hover:scale-150"></span> เกี่ยวกับเรา
          </a>
          <a href="/contact-us" class="group flex items-center text-[#6a0f3c]/80 transition-colors hover:text-[#9c0f55]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-full bg-[#f479b9] transition-transform group-hover:scale-150"></span> ติดต่อแอดมิน
          </a>
        </div>
      </nav>

      <section aria-label="ช่องทางทำรายการ" class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#9c0f55]">
          ช่องทางทำรายการ
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#fb439b] to-[#9c0f55] shadow-[0_0_8px_rgba(251,67,155,0.5)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#6a0f3c]/80">
          {BRAND_NAME} ระบุช่องทางฝากถอนผ่านธนาคารและทรูวอลเลท ก่อนฝากเงินควรตรวจสอบรายชื่อธนาคารที่รองรับ ยอดขั้นต่ำ และชื่อบัญชีปลายทางให้ตรงกับข้อมูลผู้ให้บริการที่ยืนยันได้
        </p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded-full border border-[#f4a7cf] bg-[#fff4fb] transition-colors hover:border-[#fb439b]">
          <span class="flex items-center gap-1 text-xs font-bold text-[#6a0f3c]"><span aria-hidden="true" class="text-lg">🔎</span> ตรวจสอบชื่อบัญชีปลายทางก่อนโอนทุกครั้ง</span>
        </div>
      </section>
    </div>

    <hr class="mb-6 border-[#f4a7cf]" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#6a0f3c]/75 md:block">
      {BRAND_NAME} เป็นช่องทางสำหรับผู้ที่ต้องการศึกษาข้อมูลเกมสล็อตออนไลน์ไว้ในเว็บไซต์เดียว ทั้งรายละเอียดค่ายเกม เงื่อนไขโบนัส และขั้นตอนการทำรายการฝากถอน โดยเฉพาะสมาชิกใหม่ที่ควร
      ทำความเข้าใจระบบก่อนใช้งาน ด้านโปรโมชั่น เว็บไซต์ระบุสิทธิพิเศษสำหรับผู้ใช้งานใหม่ไว้ สมาชิกควรตรวจสอบเงื่อนไขของแต่ละรายการก่อนรับโบนัส โดยเฉพาะจำนวนครั้งที่รับสิทธิ์ได้ ยอดที่ใช้
      คำนวณเครดิต และข้อกำหนดการถอนเงิน แม้จะมีข้อความระบุว่าแจกโบนัสทั้งวันไม่จำกัด แต่ควรยืนยันรายละเอียดจากประกาศล่าสุดเพื่อให้เข้าใจสิทธิ์ที่ได้รับอย่างถูกต้อง สำหรับรายการคืนยอดเสีย
      0.3% ระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขรายวัน สมาชิกควรตรวจสอบว่าเกมสล็อตประเภทใดเข้าร่วมรายการ มีรอบสรุปยอดเวลาใด และต้องกดรับเครดิตด้วยตนเองหรือระบบดำเนินการให้อัตโนมัติ
      เพราะยอดเสียบางรายการอาจไม่เข้าเกณฑ์รับสิทธิ์ ทั้งนี้ การคืนเครดิตไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งต่อไป ส่วนโบนัสแนะนำเพื่อน 0.8% ควรตรวจสอบ
      วิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และฐานยอดที่ใช้คำนวณโบนัสให้ชัดเจน แม้จะมีข้อความว่าไม่จำกัด แต่ควรยืนยันจำนวนบัญชีที่เข้าร่วมได้ รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจาก
      ประกาศล่าสุด ด้านการสมัครสมาชิก ขั้นตอนทั่วไปประกอบด้วยการเข้าสู่หน้าสมัคร กรอกข้อมูลและยืนยันบัญชี แล้วจึงเข้าสู่ระบบเพื่อตรวจสอบโปรโมชั่น ก่อนดำเนินการควรตรวจสอบที่อยู่เว็บไซต์
      ให้ถูกต้อง อ่านเงื่อนไขการใช้บริการ และตรวจสอบข้อกำหนดด้านอายุกับกฎหมายที่เกี่ยวข้อง รวมถึงไม่ควรใช้ข้อมูลของบุคคลอื่นหรือเปิดเผยรหัส OTP ให้ใครทราบ ด้านการทำรายการ แม้จะมี
      ข้อความว่าฝากถอนไม่มีขั้นต่ำ แต่ควรตรวจสอบวงเงินต่อรายการและข้อจำกัดที่อาจมีอยู่ หากพบข้อมูลบัญชีผิดปกติควรหยุดทำธุรกรรมและติดต่อผู้ให้บริการชำระเงินเพื่อตรวจสอบ สำหรับการติดต่อ
      เจ้าหน้าที่ ควรตรวจสอบช่องทางจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง หากพบปัญหาเกี่ยวกับธุรกรรม ควรเก็บหมายเลขรายการและหลักฐานที่เกี่ยวข้องไว้สำหรับตรวจสอบ
      พร้อมอธิบายปัญหาให้ชัดเจน โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ทั้งนี้ ควรตรวจสอบเวลาการให้บริการจริงของ {BRAND_NAME} จากประกาศล่าสุดอีกครั้ง
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-[#f4a7cf] pt-6 text-xs text-[#6a0f3c]/80 md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-[#9c0f55]">{BRAND_NAME}</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/terms/" class="transition-colors hover:text-[#9c0f55]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#9c0f55]">นโยบายความเป็นส่วนตัว</a>

        <a
          href="#top"
          class="flex h-8 w-8 items-center justify-center rounded-full border border-[#9c0f55]/55 bg-[#fff4fb] text-[#6a0f3c] transition-all hover:border-[#fb439b] hover:bg-[#ffe3f5] hover:shadow-[0_0_15px_rgba(251,67,155,0.45)]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
