// src/pages-disabled/ รอบนี้ จึงไม่มีสองลิงก์นั้นในคอลัมน์ลิงก์ด่วน ไม่งั้น
// verify-build.mjs จะทำให้ build แดงเพราะ href ชี้ไป route ที่ไม่มีใน dist/
// ถ้ารอบหน้าเป็นแบรนด์หวยแล้วย้ายไฟล์กลับเข้า src/pages/ ต้องเพิ่มสองลิงก์นี้คืน
//
// /register กับ /login รอบนี้เป็นหน้าปุ่มจริงที่ index ได้ (toggle cta เปิด) ส่วน
// /ทางเข้า ถูกถอดออกจากเมนู navbar รอบนี้ แต่ route ยังมีจริงและยัง index อยู่
// ลิงก์จาก footer จึงยังถูกต้องทั้งสามหน้า (ดู NavbarStyle9.astro)
//
// หน้าต่างครอปโลโก้: logo.webp รอบนี้เป็นภาพจัตุรัส 500x500 และเนื้อโลโก้จริงกินแถว
// 150..345 = 30.0%..69.0% ของความสูง ที่ความกว้าง 180px จึงตกอยู่ที่ 54..124px
// หน้าต่างจึงเป็น h-[86px] คู่กับ -translate-y-[45px] (แสดงแถว 45..131) ซึ่งครอบเนื้อ
// โลโก้ได้ครบโดยเหลือขอบบน 9px ล่าง 7px — **ค่าคู่นี้ผูกกับสัดส่วนของโลโก้ดรอปนี้
// ห้ามคัดลอกข้ามรอบ** ของเดิมคือ h-[70px]/-55px ซึ่งจะตัดขอบล่างของตัวเลขทิ้ง
---

<footer class="relative mt-32 w-full border-t border-[#e8a000]/55 bg-[#1a0c04] pt-64 pb-6 font-sans text-[#fff3e0] shadow-[0_-10px_30px_rgba(0,0,0,0.55)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-3xl border border-[#e8a000]/60 bg-gradient-to-r from-[#2b1608] via-[#1a0c04] to-[#2b1608] p-6 shadow-[0_15px_40px_rgba(0,0,0,0.45)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#fde90b] md:text-3xl">
        <span aria-hidden="true">🔥</span> พร้อมเริ่มเล่นเกมสล็อตกับ {BRAND_NAME} แล้วหรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#e0b784] md:text-base">
        สมัครสมาชิก {BRAND_NAME} ผ่านโทรศัพท์มือถือได้ใน 3 ขั้นตอน โดยตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง อ่านข้อกำหนดการเปิดบัญชีและนโยบายความเป็นส่วนตัว แล้วกรอกข้อมูลตามที่เว็บไซต์กำหนดก่อนยืนยันบัญชี
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#9a2a00] bg-gradient-to-b from-[#d13800] via-[#b8300a] to-[#9a2a00] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#ffffff] shadow-[0_8px_20px_rgba(184,48,10,0.45)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">📝</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#9a2a00] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <span class="block h-[86px] w-[180px] overflow-hidden">
                <Picture
                  src={mainLogo}
                  alt={logoAlt}
                  widths={[180, 360]}
                  sizes="180px"
                  loading="lazy"
                  decoding="async"
                  class="h-auto w-full -translate-y-[45px] drop-shadow-[0_0_12px_rgba(232,160,0,0.55)]"
                  formats={["avif", "webp"]}
                  fallbackFormat="webp"
                  quality={72}
                />
              </span>
            ) : (
              <p class="bg-gradient-to-r from-[#d8dde6] via-[#fde90b] to-[#fa4903] bg-clip-text text-3xl font-black text-transparent">{BRAND_NAME}</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#e0b784]">
          {BRAND_NAME} นำเสนอเกมสล็อตออนไลน์จากค่ายเกมหลากหลายแบรนด์ พร้อมข้อมูลการเดิมพันเริ่มต้น 1 บาท และช่องทางฝากถอนผ่านธนาคารกับทรูวอลเลท ภายในเว็บไซต์รวบรวมรายละเอียดเกม โปรโมชั่น
          และระบบสมาชิกไว้ในที่เดียว ทั้งนี้ คำกล่าวอ้างว่าเป็นสล็อตลิขสิทธิ์แท้จำเป็นต้องมีข้อมูลที่ตรวจสอบได้ประกอบ จึงควรตรวจสอบรายชื่อค่ายเกมและหลักฐานการได้รับอนุญาตจากผู้พัฒนาก่อนใช้งาน
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a href="/line" class="flex items-center gap-2 rounded-full bg-[#00B900] px-4 py-2 text-xs font-bold text-white shadow-[0_4px_12px_rgba(0,185,0,0.25)] transition-opacity hover:opacity-90">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>
        </div>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }
      </div>

      <nav aria-label="ลิงก์ด่วน" class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#fde90b]">
          ลิงก์ด่วน
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#fa4903] to-[#e8a000] shadow-[0_0_8px_rgba(232,160,0,0.5)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          <a href="/" class="group flex items-center text-[#e0b784] transition-colors hover:text-[#fde90b]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-full bg-[#fa4903] transition-transform group-hover:scale-150"></span> หน้าแรก
          </a>
          <a href="/promotion" class="group flex items-center text-[#e0b784] transition-colors hover:text-[#fde90b]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-full bg-[#e8a000] transition-transform group-hover:scale-150"></span> โปรโมชั่นสมาชิก
          </a>
          <a href="/ทดลองเล่น" class="group flex items-center text-[#e0b784] transition-colors hover:text-[#fde90b]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-full bg-[#fa4903] transition-transform group-hover:scale-150"></span> ทดลองเล่นเกม
          </a>
          <a href="/ทางเข้า" class="group flex items-center text-[#e0b784] transition-colors hover:text-[#fde90b]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-full bg-[#e8a000] transition-transform group-hover:scale-150"></span> ทางเข้าล่าสุด
          </a>
          <a href="/register" class="group flex items-center text-[#e0b784] transition-colors hover:text-[#fde90b]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-full bg-[#fa4903] transition-transform group-hover:scale-150"></span> สมัครสมาชิก
          </a>
          <a href="/login" class="group flex items-center text-[#e0b784] transition-colors hover:text-[#fde90b]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-full bg-[#e8a000] transition-transform group-hover:scale-150"></span> เข้าสู่ระบบ
          </a>
          <a href="/about-us" class="group flex items-center text-[#e0b784] transition-colors hover:text-[#fde90b]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-full bg-[#fa4903] transition-transform group-hover:scale-150"></span> เกี่ยวกับเรา
          </a>
          <a href="/contact-us" class="group flex items-center text-[#e0b784] transition-colors hover:text-[#fde90b]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-full bg-[#e8a000] transition-transform group-hover:scale-150"></span> ติดต่อแอดมิน
          </a>
        </div>
      </nav>

      <section aria-label="ช่องทางทำรายการ" class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#fde90b]">
          ช่องทางทำรายการ
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#fa4903] to-[#e8a000] shadow-[0_0_8px_rgba(232,160,0,0.5)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#e0b784]">
          {BRAND_NAME} ระบุช่องทางฝากถอนผ่านธนาคารและทรูวอลเลท ก่อนฝากเงินควรตรวจสอบรายชื่อธนาคารที่รองรับ ยอดขั้นต่ำ และชื่อบัญชีปลายทางให้ตรงกับข้อมูลผู้ให้บริการที่ยืนยันได้
        </p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded-full border border-[#7a3a0c] bg-[#2b1608] transition-colors hover:border-[#e8a000]">
          <span class="flex items-center gap-1 text-xs font-bold text-[#fff3e0]"><span aria-hidden="true" class="text-lg">🔎</span> ตรวจสอบชื่อบัญชีปลายทางก่อนโอนทุกครั้ง</span>
        </div>
      </section>
    </div>

    <hr class="mb-6 border-[#7a3a0c]" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#e0b784] md:block">
      {BRAND_NAME} เป็นช่องทางสำหรับผู้ที่ต้องการศึกษาข้อมูลเกมสล็อตออนไลน์ไว้ในเว็บไซต์เดียว ทั้งรายละเอียดค่ายเกม เงื่อนไขโปรโมชั่น และขั้นตอนการทำรายการฝากถอน โดยระบุการเดิมพันเริ่มต้น
      ที่ 1 บาทสำหรับบางรายการ เกมที่เปิดให้บริการมีทั้งสล็อตคลาสสิก เกมฟรีสปิน และเกมที่มีฟีเจอร์โบนัส ซึ่งแต่ละประเภทอาจกำหนดวงเงินเดิมพันไม่เท่ากัน สมาชิกจึงควรตรวจสอบยอดเดิมพัน
      ขั้นต่ำของแต่ละเกม รวมถึงศึกษาค่า RTP และความผันผวนของเกมเพื่อทำความเข้าใจความเสี่ยง โดยไม่คาดหวังผลรางวัลที่แน่นอน ด้านโปรโมชั่น เว็บไซต์ระบุรายการคืนยอดเสีย 0.3% และโบนัส
      แนะนำเพื่อน 0.8% เป็นสิทธิพิเศษหลัก พร้อมประกาศโปรโมชั่นประจำสัปดาห์ แต่ละรายการอาจกำหนดประเภทเกม ยอดที่นำมาคำนวณ รอบรับสิทธิ์ และข้อจำกัดการถอนเงินแตกต่างกัน จึงควรตรวจสอบ
      ข้อมูลล่าสุดก่อนรับโบนัสทุกครั้ง ทั้งนี้ เครดิตคืนยอดเสียไม่ได้รับประกันว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งต่อไป และแม้จะมีข้อความว่าโบนัสแนะนำเพื่อนไม่จำกัด
      แต่ควรยืนยันจำนวนบัญชีที่เข้าร่วมได้ รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุด ด้านการสมัครสมาชิก ขั้นตอนทั่วไปประกอบด้วยการเข้าสู่หน้าลงทะเบียน กรอกข้อมูล และยืนยันบัญชี
      ก่อนดำเนินการควรตรวจสอบข้อกำหนดด้านอายุ กฎหมายที่เกี่ยวข้อง และนโยบายความเป็นส่วนตัว รวมถึงตั้งรหัสผ่านที่คาดเดาได้ยาก ไม่ใช้ข้อมูลของบุคคลอื่น และไม่เปิดเผยรหัสผ่านหรือรหัส OTP
      ให้ใครทราบ ด้านการทำรายการ ควรตรวจสอบรายชื่อธนาคารที่รองรับ ยอดขั้นต่ำ ชื่อบัญชีปลายทาง ระยะเวลาดำเนินการ และข้อกำหนดการถอนเงินให้ครบถ้วน หากพบชื่อบัญชีไม่ตรงกับข้อมูลทางการ
      หรือมีการแจ้งเปลี่ยนบัญชีอย่างผิดปกติ ควรหยุดทำรายการและติดต่อธนาคารหรือผู้ให้บริการชำระเงินเพื่อตรวจสอบก่อนโอนเงิน สำหรับการติดต่อเจ้าหน้าที่ ควรตรวจสอบช่องทางจากเว็บไซต์ทางการ
      ก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง หากพบปัญหาเกี่ยวกับบัญชีสมาชิกหรือธุรกรรม ควรเก็บหมายเลขรายการและหลักฐานที่เกี่ยวข้องไว้สำหรับตรวจสอบ พร้อมแจ้งรายละเอียดให้ชัดเจน
      ทั้งนี้ ควรตรวจสอบเวลาการให้บริการจริงของ {BRAND_NAME} จากประกาศล่าสุดอีกครั้ง
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-[#7a3a0c] pt-6 text-xs text-[#e0b784] md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-[#fde90b]">{BRAND_NAME}</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/terms/" class="transition-colors hover:text-[#fde90b]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#fde90b]">นโยบายความเป็นส่วนตัว</a>

        <a
          href="#top"
          class="flex h-8 w-8 items-center justify-center rounded-full border border-[#e8a000]/55 bg-[#2b1608] text-[#fff3e0] transition-all hover:border-[#fde90b] hover:bg-[#7a3a0c] hover:shadow-[0_0_15px_rgba(232,160,0,0.45)]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
