---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt =
  "โลโก้ CK268 ตัวอักษรภาษาอังกฤษหนาแบบสามมิติบนพื้นโปร่งใส ตัว C และเลข 6 8 เป็นโครเมียมขาวเงิน ส่วนตัว K และเลข 2 เป็นเขียวนีออนไล่เฉดลงเขียวเข้ม";

// CK268 (รอบเขียวนีออน-โครเมียม-ดำ 2026-09-30): footer ที่ใช้งานจริงรอบนี้ —
// รอบก่อน GOT777 ใช้ FooterPremiumSumo จึงหมุนมาที่ไฟล์นี้ ของเดิมที่ค้างอยู่ใน
// ไฟล์เป็นทอง-เขียวของ PGW44 ย้ายทั้งไฟล์มาเป็นเขียวนีออน-โครเมียมตามโลโก้จริงแล้ว
//
// แกนสีที่ใช้: พื้นเกือบดำอมเขียว #030703 ยกระดับด้วย #071007 / #0b160b /
// #12250f · เขียวนีออนแบรนด์ #8bfc13 เป็นเส้นคั่น จุดนำลิงก์ และขอบการ์ด ·
// เขียวอ่อน #c9ff8f สงวนไว้ให้หัวคอลัมน์ ชื่อแบรนด์ และปุ่มสมัคร · โครเมียมขาว
// #e8f0e6 เป็นปลายเกรเดียนต์คู่กับเขียวตามลำดับตัวอักษรในโลโก้ (C โครเมียม /
// K เขียว / 2 เขียว / 68 โครเมียม) · เขียวลึก #1a7a08 เป็นเส้นคั่นจาง ·
// เนื้อความ #d5e6cd (BRAND_TEXT ของรอบนี้) ลดน้ำหนักด้วย opacity
//
// คอปปี้ทั้งไฟล์เขียนใหม่จากบรีฟ CK268 ซึ่งเป็น **เว็บสล็อตล้วน** — บรีฟรอบนี้พูด
// เรื่องค่ายเกมหลายค่ายผ่านบัญชีเดียว เกมเปิดใหม่รายสัปดาห์ เบทเริ่ม 1 บาท
// โบนัสคืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% สมัคร 3 ขั้นตอน และแอดมิน 24 ชั่วโมง
// เท่านั้น ไม่ได้ระบุชื่อค่าย ใบอนุญาต ธนาคาร หรืออัตราจ่ายใดเป็นชื่อๆ จึงไม่มี
// ในข้อความนี้ และไม่ได้แทนชื่อแบรนด์ทับประโยคของ PGW44
//
// ลิงก์: CK268 เป็นแบรนด์สล็อต ไม่ใช่เว็บหวย สองหน้าหมวดหวย (/ตรวจหวย, /แนวทาง)
// ถูกพักไว้ใน src/pages-disabled/ รอบนี้ ลิงก์ทั้งคู่จึงไม่มีในคอลัมน์ลิงก์ด่วน —
// ถ้าใส่ไว้ verify-build.mjs จะทำให้ build แดงเพราะ href ชี้ไป route ที่ไม่มีใน dist/
//
// /ทางเข้า ยังมีลิงก์อยู่ตรงนี้: หน้านั้นยัง route และ index อยู่ แค่ไม่มีใน
// เมนู navbar เพราะ toggle ของ register/login เปิด (ดู NavbarStyle6.astro)
//
// ปุ่มพื้นเขียวนีออนใช้ตัวอักษรสีเข้ม #071007 — พื้นเขียวสว่างกับตัวอักษรอ่อนอ่านไม่ออก
//
// บล็อก <address> ตั้งใจไม่ทาสีแบรนด์ — border-white/15 + bg-black/20 + opacity
// บนสีตัวอักษรที่ inherit มา ลงตัวกับ footer ทุกตัวในไลบรารี ห้าม retheme
---

<footer
  class="relative mt-32 w-full border-t border-[#8bfc13]/50 bg-[#030703] pt-64 pb-6 font-sans text-[#d5e6cd] shadow-[0_-10px_30px_rgba(139,252,19,0.16)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#8bfc13]/70 bg-gradient-to-r from-[#071007] via-[#12250f] to-[#071007] p-6 shadow-[0_15px_40px_rgba(2,5,2,0.6)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#c9ff8f] uppercase italic drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)] md:text-3xl">
        <span aria-hidden="true">🎰</span> พร้อมเลือกเกมสล็อตจากค่ายดังกับ {BRAND_NAME} แล้วหรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#d5e6cd]/90 md:text-base">
        สมัคร {BRAND_NAME} ได้ด้วยตนเองทั้งบนมือถือและคอมพิวเตอร์ เลือกเกมสล็อตจากหลายค่ายได้จากบัญชีเดียว ตรวจสอบช่วงเดิมพันและรายละเอียดของแต่ละเกมก่อนเริ่มเล่นได้จากหน้าเกมโดยตรง
        พร้อมโปรโมชั่นที่เปิดให้รับตามเงื่อนไขและรอบรับสิทธิ์ที่ระบบกำหนด
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#8bfc13] bg-gradient-to-b from-[#c9ff8f] to-[#8bfc13] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#071007] shadow-[0_0_15px_rgba(139,252,19,0.45)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🚀</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#12250f] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[100, 200, 300]}
                sizes="100px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(139,252,19,0.55)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-r from-[#e8f0e6] via-[#8bfc13] to-[#1a7a08] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(139,252,19,0.55)]">{BRAND_NAME}</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#d5e6cd]/75">
          {BRAND_NAME} รวมเกมสล็อตออนไลน์จากหลายค่ายไว้ให้สมาชิกเลือกผ่านบัญชีเดียว ทั้งเกมยอดนิยม สล็อตเปิดใหม่ เกมฟรีสปิน ตัวคูณ และฟีเจอร์โบนัสหลายรูปแบบ
          พร้อมอัปเดตรายการเกมใหม่ตลอดสัปดาห์ตามค่ายที่เปิดให้บริการ ช่วยให้ค้นหาเกมหรือสลับค่ายได้สะดวกโดยไม่ต้องสมัครหลายบัญชี รองรับการใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์
          บางเกมรองรับการเดิมพันเริ่มต้นในระดับ 1 บาท ซึ่งช่วงเดิมพันจริงขึ้นอยู่กับแต่ละค่าย จึงควรตรวจสอบจากในเกมก่อนเริ่มเล่น พร้อมเจ้าหน้าที่ดูแลผ่านช่องทางไลน์ตลอด 24 ชั่วโมง
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/30 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.1)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>
        </div>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }
      </div>

      <nav aria-label="ลิงก์ด่วน" class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#c9ff8f] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#1a7a08] to-[#8bfc13] shadow-[0_0_8px_rgba(139,252,19,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          <a href="/" class="group flex items-center text-[#d5e6cd]/75 transition-colors hover:text-[#c9ff8f]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#8bfc13] transition-transform group-hover:rotate-45"></span> หน้าแรก
          </a>
          <a href="/promotion" class="group flex items-center text-[#d5e6cd]/75 transition-colors hover:text-[#c9ff8f]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#8bfc13] transition-transform group-hover:rotate-45"></span> โปรโมชั่นสมาชิก
          </a>
          <a href="/ทดลองเล่น" class="group flex items-center text-[#d5e6cd]/75 transition-colors hover:text-[#c9ff8f]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#8bfc13] transition-transform group-hover:rotate-45"></span> ทดลองเล่น
          </a>
          <a href="/ทางเข้า" class="group flex items-center text-[#d5e6cd]/75 transition-colors hover:text-[#c9ff8f]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#8bfc13] transition-transform group-hover:rotate-45"></span> ทางเข้าล่าสุด
          </a>
          <a href="/about-us" class="group flex items-center text-[#d5e6cd]/75 transition-colors hover:text-[#c9ff8f]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#8bfc13] transition-transform group-hover:rotate-45"></span> เกี่ยวกับเรา
          </a>
          <a href="/register" class="group flex items-center text-[#d5e6cd]/75 transition-colors hover:text-[#c9ff8f]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#8bfc13] transition-transform group-hover:rotate-45"></span> สมัครสมาชิก
          </a>
          <a href="/login" class="group flex items-center text-[#d5e6cd]/75 transition-colors hover:text-[#c9ff8f]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#8bfc13] transition-transform group-hover:rotate-45"></span> เข้าสู่ระบบ
          </a>
          <a href="/contact-us" class="group flex items-center text-[#d5e6cd]/75 transition-colors hover:text-[#c9ff8f]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#8bfc13] transition-transform group-hover:rotate-45"></span> ติดต่อเจ้าหน้าที่
          </a>
        </div>
      </nav>

      <section aria-label="ระบบการเงิน" class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#c9ff8f] uppercase">
          ระบบการเงิน
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#1a7a08] to-[#8bfc13] shadow-[0_0_8px_rgba(139,252,19,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#d5e6cd]/75">รองรับช่องทางที่กำหนดไว้ภายในเว็บไซต์ โดยควรใช้บัญชีชื่อเดียวกับข้อมูลที่ผูกไว้ตอนสมัคร</p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-[#1a7a08]/40 bg-[#071007] transition-colors hover:border-[#8bfc13]/60">
          <span class="flex items-center gap-1 text-xs font-bold text-[#d5e6cd]"><span aria-hidden="true" class="text-lg text-[#8bfc13]">🧾</span> ตรวจสอบสถานะรายการได้ในบัญชีสมาชิก</span>
        </div>
      </section>
    </div>

    <hr class="mb-6 border-[#0b160b]" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#d5e6cd]/70 md:block">
      {BRAND_NAME} เป็นช่องทางสำหรับผู้ที่ต้องการเข้าเล่นเกมสล็อตออนไลน์จากหลายค่ายผ่านบัญชีเดียว ทั้งเกมยอดนิยม สล็อตเปิดใหม่ เกมฟรีสปิน ตัวคูณ และฟีเจอร์โบนัสหลายรูปแบบ
      โดยจัดหมวดหมู่ไว้เพื่อให้สมาชิกค้นหาและสลับค่ายได้สะดวกโดยไม่ต้องสมัครหลายบัญชี รายการเกมใหม่จะทยอยเพิ่มเข้าระบบตลอดสัปดาห์ ซึ่งจำนวนเกมและช่วงเวลาที่เปิดให้บริการ
      ขึ้นอยู่กับการอัปเดตของแต่ละค่ายผู้ให้บริการ ผลของเกมแต่ละรอบเป็นไปตามระบบของผู้ให้บริการรายนั้น จึงไม่สามารถรับประกันผลการเดิมพันใด ๆ ได้
      คำว่า "1 บาททุกเกม" และ "ไม่มีขั้นต่ำ" ควรอ้างอิงช่วงเดิมพันจริงที่แสดงภายในเกม เนื่องจากแต่ละค่ายกำหนดยอดเดิมพันขั้นต่ำและสูงสุดแตกต่างกัน ให้ยึดค่าที่ระบบแสดง ณ เวลาทำรายการ
      ส่วนโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% เป็นไปตามเงื่อนไข ยอดที่เข้าเกณฑ์ และรอบคำนวณของรายการที่เว็บไซต์ระบุ ควรอ่านรายละเอียดก่อนกดรับสิทธิ์ทุกครั้ง
      ก่อนเข้าสู่ระบบควรตรวจสอบว่ากำลังใช้งานช่องทางของผู้ให้บริการที่ถูกต้อง ใช้ข้อมูลของตนเองในการสมัคร ตั้งรหัสผ่านที่คาดเดายาก และไม่เปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      หากเว็บไซต์ระบุว่าฝากเงินเข้าบัญชีบริษัทโดยตรง ควรตรวจสอบชื่อบัญชีกับข้อมูลนิติบุคคลที่เว็บไซต์ประกาศก่อนทำธุรกรรมทุกครั้ง ใช้งานได้ทั้งบนมือถือ แท็บเล็ต และคอมพิวเตอร์
      ผ่านเบราว์เซอร์ พร้อมเจ้าหน้าที่ {BRAND_NAME} ดูแลผ่านช่องทางไลน์ตลอด 24 ชั่วโมง
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-[#1a7a08]/40 pt-6 text-xs text-[#d5e6cd]/75 md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-[#c9ff8f] uppercase">{BRAND_NAME}</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/terms/" class="transition-colors hover:text-[#c9ff8f]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#c9ff8f]">นโยบายความเป็นส่วนตัว</a>

        <a
          href="#top"
          class="flex h-8 w-8 items-center justify-center rounded border border-[#1a7a08]/50 bg-[#071007] text-[#d5e6cd] transition-all hover:border-[#8bfc13] hover:bg-[#0b160b] hover:shadow-[0_0_15px_rgba(139,252,19,0.55)]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
