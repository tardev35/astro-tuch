---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// เขียนจาก src/assets/logo.webp ของดรอป 2026-10-19 จริง (เปิดอ่านด้วย Read ก่อนเขียน)
// ไม่ใช่คัดลอกของรอบก่อน — แมวกวักนำโชค เหรียญจีนเจาะรูสี่เหลี่ยม ทองแท่งจีน และ
// ริบบิ้นซาตินชมพูบานเย็นของ มีโชค168 ที่เคยอยู่บรรทัดนี้ ไม่มีในรูปรอบนี้เลย
// (มีโชค168 เป็นคนละแบรนด์ ถึงชื่อจะขึ้นต้นด้วย "มี" เหมือนกัน)
const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส ทางซ้ายเป็นหน้ายิ้มการ์ตูนทรงกลมสีเหลืองทอง หลับตาหัวเราะอ้าปากกว้าง แก้มสองข้างเป็นวงกลมสีชมพู นั่งอยู่บนกองเหรียญทองที่วางซ้อนกัน มีขีดประกายสีแดงสามขีดพุ่งออกจากหัวและมีประกายดาวสี่แฉกสีทองลอยอยู่รอบ ๆ ทางขวาเป็นคำว่า มี ตัวอักษรไทยหนาสามมิติสีขาวมุกตัดขอบเทาอ่อน ต่อด้วยคำว่า เฮ และเลข 168 ตัวหนาสามมิติผิวมันวาวแบบลูกโป่งสีแดงชาด`;

// มีเฮ168 (รอบแดงชาดนำ-ทองเนยรอง บนดำสนิท 2026-10-19): footer ที่ใช้งานจริงรอบนี้ —
// รอบก่อน (รวยแทร่168) ใช้ FooterPremium เหตุผลที่เลือกไฟล์นี้คือ "ทรง" ไม่ใช่สี:
// FooterPremium เป็นแผ่น rounded-t-[3rem] + ออราเรืองแสงเบลอ 100px คร่อมขอบบน กริด
// 12 คอลัมน์ 5/3/4 — เหมือนกับ Footer / FooterPremiumSumo / FooterHuay ทั้งกลุ่ม
// ส่วน FooterStyle2 เป็นแผ่นแบนขอบบนเส้นหนา กริด 4 คอลัมน์เท่ากัน ไฟล์นี้เป็น
// **การ์ด CTA ลอยคร่อมขอบบน** (-top-14 / md:-top-16) แล้วตัวแผ่นเว้น pt-64
// (md:pt-40) ไว้รับ และมี **BankStrip** อยู่ในคอลัมน์ช่องทางทำรายการ —
// เป็นทรงเดียวในไลบรารีที่ไม่ซ้ำกับทั้งสองกลุ่มนั้น
//
// ของเดิมที่ค้างอยู่ในไฟล์เป็นทองนำ-ชมพูบานเย็นของ มีโชค168 (fcd434 ffeaa0 f5469f
// ff8dc6 8c0f52 7a5508 f6e4ee 24101c 160a12 0b0509 1a0612 rgba(245,70,159,α)
// rgba(252,212,52,α)) และก่อนหน้านั้นเป็นแดงมังกร-โครเมียมขาวของ GT66B (fb141b
// ff5f63 ffa0a2 8a0609 3b0405 1c0c0b 0b0303 fdfcfd eceaea 190505 db040b) —
// ย้ายทั้งไฟล์มาเป็นแดงชาด-ทองเนยของรอบนี้แล้ว ไม่เหลือชมพูฟูเชียและไม่เหลือ
// โครเมียมเลย
// ⚠️ **กับดักรอบนี้คือทั้งแดงและทอง** — มีโชค168 ที่ค้างอยู่ในไฟล์นี้ก็มีทอง และ
// สามแบรนด์ก่อนหน้า (สมหวัง168 fa0513 · รับตัง168 d30304 · ขวัญใจ168 b3121b) ก็มี
// แดง ส่วนรอบนี้คือแดง #fb1b32 (+#ff8f9c #5c0410) กับทอง #fcd45c (+#ffeec0 #6b4a08)
// **fa0513 ของ สมหวัง168 อยู่ห่างจาก fb1b32 แค่นิดเดียว** การเจอแดงหรือทองที่ไหน
// จึงไม่พิสูจน์อะไรเลย ต้องเทียบเป็น "ค่า" ทีละตัวกับ
// .claude/brand-spec-meehay168.md §2
//
// footer เป็น "โครม" จึงประกาศสีตัวอักษรของตัวเองครบทุกจุด ไม่ได้ inherit
// BRAND_TEXT และโลโก้ที่เป็นขาว-แดง-ทองบนพื้นโปร่งต้องการพื้นเข้มถึงจะอ่านออก
//
// แกนสีที่ใช้ (brand-spec §2): พื้นผิวจม #0c0205 ยกระดับด้วย #1a040a / #2b0711 ·
// **แดงแบรนด์ #fb1b32 (ตัวอักษร เฮ168 หัวใจ และโบว์บนโลโก้/แบนเนอร์) เป็นเส้นใต้
// หัวคอลัมน์ ขอบ เส้นคั่น และหัวการ์ด CTA** ซึ่งเป็นจุดที่ฮิวนำของรอบนี้ต้องเห็นจริง ·
// ทองเนย #fcd45c (หน้ายิ้มกับกองเหรียญบนโลโก้) เป็นจุดนำลิงก์และพื้นปุ่ม ·
// ชมพูบลัช #ff8f9c เป็นสี hover ของลิงก์ หัวการ์ด CTA และชื่อแบรนด์ในบรรทัดลิขสิทธิ์ ·
// ทองอ่อน #ffeec0 เป็นหัวคอลัมน์และปลายสว่างของไล่เฉดปุ่ม ·
// แดงลึก #5c0410 กับทองลึก #6b4a08 เป็นขอบ/ปลายเข้มของเส้นใต้ ไม่ถือตัวอักษร ·
// เนื้อความ #fdeaec ลดน้ำหนักด้วย opacity
//
// ปุ่มพื้นทองใช้หมึก #1b0308 — พื้นทองสว่างกับตัวอักษรอ่อนอ่านไม่ออก
// (#1b0308 บน #ffeec0 ≈ 17.9:1 · บน #fcd45c ≈ 13.8:1 ผ่าน AA ทั้งคู่)
// แผ่นที่เลื่อนขึ้นมาตอน hover เป็นแดงแบรนด์ #fb1b32 ไม่ใช่แดงลึก #5c0410 —
// หมึก #1b0308 บน #fb1b32 ได้ ≈ 5.0:1 แต่บน #5c0410 เหลือ ~1.5:1 ซึ่งหายไปเลย
// ⚠️ ห้ามพลิกไปใช้ตัวอักษรสีขาวบนพื้นทอง (เหลือ ~1.4:1)
// ⚠️ #5c0410 #6b4a08 ห้ามถือตัวอักษรทุกขนาดในไฟล์นี้
//
// คอปปี้ทั้งไฟล์เขียนใหม่จากบรีฟ มีเฮ168 (src/assets/content.txt) ซึ่งเป็น
// **เว็บสล็อตล้วนสำหรับคนรุ่นใหม่ เดิมพันง่าย ไม่มีขั้นต่ำ ฝากถอนวอลเลทและธนาคาร
// ชั้นนำ** ไม่ใช่คาสิโนหลายหมวดแบบ GT66B/TKB55 (รอบนี้ **ไม่มีบาคาร่า ไม่มีไฮโล
// ไม่มีไพ่ ไม่มีบอล/กีฬา**) และไม่ใช่เว็บหวย
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกมแม้แต่ค่ายเดียว** — PG SOFT, JOKER, JILI และ
// "นำเข้าตรงจากสิงคโปร์" ที่เคยอยู่ในไฟล์นี้เป็นคำของ **มีโชค168** ทั้งหมด ถูกถอด
// ออกแล้วและห้ามใส่กลับ บรีฟรอบนี้พูดเรื่องระบบทางเข้าสำหรับคนรุ่นใหม่ การเลือกเกม
// ตามงบประมาณ โปรโมชั่นคืนยอดเสีย 0.3% กับแนะนำเพื่อน 0.8% การสมัคร 3 ขั้นตอน และ
// ช่องทางติดต่อแอดมิน 24ชม. เท่านั้น ไม่ได้ระบุเลขใบอนุญาต ชื่อหน่วยงานที่ออก
// ใบอนุญาต ชื่อนิติบุคคล ชื่อธนาคารเฉพาะราย ยอดขั้นต่ำเป็นตัวเลข ค่า RTP จำนวน
// สมาชิก หรือปีก่อตั้งไว้เลย จึงไม่มีในข้อความนี้
// ⚠️ บรีฟ "ตั้งคำถามกับคำโฆษณาของตัวเอง" และประโยคกำกับพวกนั้นต้องขนมาด้วย ห้าม
// ตัดทิ้งเพราะฟังดูไม่ขายของ: ผู้เล่นควรตรวจสอบกติกา อัตราเดิมพัน และเงื่อนไข
// บริการก่อนเริ่มใช้งานทุกครั้ง · บางค่ายอาจกำหนดอัตราเดิมพันแตกต่างกัน ·
// ไม่มีเกมสล็อตใดรับประกันผลกำไรหรือเงินรางวัลในทุกรอบ · เครดิตคืนยอดเสียไม่ใช่
// การรับประกันผลตอบแทนจากการเดิมพันครั้งต่อไป
// ⚠️ คำของแบรนด์ก่อนที่ห้ามหลุดกลับมา: สล็อตรวมเกมกำไรงาม · เล่นง่ายทุกค่าย ·
// ได้เงินสูงทุกรอบ · ทุนน้อยก็เล่นได้ (รวยแทร่168) · ลิขสิทธิ์แท้ · นำเข้าตรงจาก
// สิงคโปร์ · ศูนย์บริการหลัก · ศูนย์รวมช่องทางบริการ · ลิขสิทธิ์เว็บแท้100% ·
// เว็บคาสิโนไทย · คาสิโนเซิร์ฟนอก · ฝากถอนทุกธนาคาร · บอลออนไลน์ · ฐานเกมแท้ ·
// จ่ายตรง · ไม่บิดยูส · ไม่ผ่านบัญชีม้า · เว็บตรง · ไม่ผ่านเอเย่นต์ · แตกง่าย ·
// ยิงปลา · เสือมังกร · และคำหวยทุกคำ
//
// ลิงก์: มีเฮ168 เป็นเว็บสล็อต — /ตรวจหวย กับ /แนวทาง อยู่ใน src/pages-disabled/
// รอบนี้ จึงไม่มีสองลิงก์นั้นในคอลัมน์ลิงก์ด่วน ไม่งั้น verify-build.mjs จะทำให้
// build แดงเพราะ href ชี้ไป route ที่ไม่มีใน dist/ ถ้ารอบหน้าเป็นแบรนด์หวยแล้ว
// ย้ายไฟล์กลับเข้า src/pages/ ต้องเพิ่มสองลิงก์นี้คืน
//
// /register กับ /login รอบนี้เป็นหน้าปุ่มจริงที่ index ได้ (toggle cta เปิด) ส่วน
// /ทางเข้า ถูกถอดออกจากเมนู navbar รอบนี้ แต่ route ยังมีจริงและยัง index อยู่
// ลิงก์จาก footer จึงยังถูกต้องทั้งสามหน้า (ดู NavbarStyle9.astro)
//
// บล็อก <address> ตั้งใจไม่ทาสีแบรนด์ — border-white/15 + bg-black/20 + opacity
// บนสีตัวอักษรที่ inherit มา ลงตัวกับ footer ทุกตัวในไลบรารี ห้าม retheme
---

<footer
  class="relative mt-32 w-full border-t border-[#fb1b32]/55 bg-[#0c0205] pt-64 pb-6 font-sans text-[#fdeaec] shadow-[0_-10px_30px_rgba(251,27,50,0.26)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#fb1b32]/60 bg-gradient-to-r from-[#1a040a] via-[#2b0711] to-[#1a040a] p-6 shadow-[0_15px_40px_rgba(0,0,0,0.78)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#ff8f9c] uppercase italic drop-shadow-[0_2px_4px_rgba(0,0,0,0.6)] md:text-3xl">
        <span aria-hidden="true">😄</span> พร้อมเริ่มศึกษาเกมสล็อตกับ {BRAND_NAME} แล้วหรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#fdeaec]/90 md:text-base">
        สมัคร {BRAND_NAME} ได้ด้วยตนเองผ่านมือถือ โดยตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง อ่านข้อกำหนดการเปิดบัญชีและนโยบายการจัดเก็บข้อมูลส่วนบุคคล แล้วกรอกข้อมูลตามที่ระบบกำหนดก่อนยืนยันบัญชี
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#6b4a08] bg-gradient-to-b from-[#ffeec0] to-[#fcd45c] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#1b0308] shadow-[0_0_15px_rgba(252,212,92,0.5)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🎰</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#5c0410] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[100, 200, 300]}
                sizes="100px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(251,27,50,0.7)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-r from-[#ffeec0] via-[#ff8f9c] to-[#fcd45c] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(251,27,50,0.65)]">{BRAND_NAME}</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#fdeaec]/75">
          {BRAND_NAME} นำเสนอเกมสล็อตออนไลน์สำหรับคนรุ่นใหม่ที่ชอบความสะดวกและต้องการเข้าถึงเมนูต่าง ๆ ได้ง่าย ทั้งการสมัครสมาชิก เลือกเกม ตรวจสอบโปรโมชั่น และทำรายการฝากถอนผ่านช่องทางที่รองรับ
          เว็บไซต์เน้นรูปแบบการใช้งานบนมือถือ พร้อมข้อมูลเกมจากหลายค่ายให้เลือกศึกษา โดยผู้เล่นควรตรวจสอบกติกา อัตราเดิมพัน และเงื่อนไขบริการก่อนเริ่มใช้งานทุกครั้ง
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/40 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.12)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>
        </div>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }
      </div>

      <nav aria-label="ลิงก์ด่วน" class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#ffeec0] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#fb1b32] to-[#5c0410] shadow-[0_0_8px_rgba(251,27,50,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          <a href="/" class="group flex items-center text-[#fdeaec]/75 transition-colors hover:text-[#ff8f9c]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#fcd45c] transition-transform group-hover:rotate-45"></span> หน้าแรก
          </a>
          <a href="/promotion" class="group flex items-center text-[#fdeaec]/75 transition-colors hover:text-[#ff8f9c]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#fcd45c] transition-transform group-hover:rotate-45"></span> โปรโมชั่นสมาชิก
          </a>
          <a href="/ทดลองเล่น" class="group flex items-center text-[#fdeaec]/75 transition-colors hover:text-[#ff8f9c]">
