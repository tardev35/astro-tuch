---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
---

<footer
  class="relative mt-32 w-full border-t border-[#b6821d]/35 bg-[#0a0704] pt-64 pb-6 font-sans text-[#f2e6cd] shadow-[0_-10px_30px_rgba(245,197,24,0.15)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#b6821d]/45 bg-gradient-to-r from-[#0a0704] via-[#241a08] to-[#0a0704] p-6 shadow-[0_15px_40px_rgba(245,197,24,0.25)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#fff2c3] uppercase italic drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)] md:text-3xl">
        <span aria-hidden="true">🎰</span> พร้อมปั่นสล็อตกับ UFASLOT แล้วหรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#f2e6cd]/90 md:text-base">
        สมัครสมาชิก UFASLOT ผ่านมือถือได้ในไม่กี่นาที เลือกเล่นสล็อตได้ครบทุกค่ายภายในบัญชีเดียว พร้อมรับโบนัสคืนยอดเสีย 0.3% ทุกวันตามเงื่อนไข
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#fff2c3] bg-gradient-to-b from-[#fff2c3] to-[#b6821d] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#2b1c05] shadow-[0_0_15px_rgba(245,197,24,0.4)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🚀</span></span>
      <div class="absolute inset-0 translate-y-full bg-[#f5c518] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ UFASLOT ตัวอักษร UFA สีทองเมทัลลิกต่อด้วย SLOT สีเงินโครเมียม"
                widths={[100, 200, 300]}
                sizes="100px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(245,197,24,0.6)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-b from-[#fff2c3] to-[#b6821d] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(245,197,24,0.5)]">UFASLOT</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#c9bfa6]">
          UFASLOT เว็บรวมสล็อตออนไลน์จากค่ายแท้ดั้งเดิม รวมเกมยอดนิยม เกมโบนัส และเกมแจ็คพอตไว้ในบัญชีเดียว เข้าเล่นผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ได้ตลอด 24 ชั่วโมง พร้อมทีมงานคอยดูแลทุกช่วงเวลา
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/30 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.1)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>
        </div>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }
      </div>

      <div class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#fff2c3] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#845914] to-[#f5c518] shadow-[0_0_8px_rgba(245,197,24,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          <a href="/" class="group flex items-center text-[#c9bfa6] transition-colors hover:text-[#fff2c3]">
            <span class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#f5c518] transition-transform group-hover:rotate-45"></span> หน้าแรก
          </a>
          <a href="/ทดลองเล่น" class="group flex items-center text-[#c9bfa6] transition-colors hover:text-[#fff2c3]">
            <span class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#f5c518] transition-transform group-hover:rotate-45"></span> ทดลองเล่นสล็อตฟรี
          </a>
          <a href="/promotion" class="group flex items-center text-[#c9bfa6] transition-colors hover:text-[#fff2c3]">
            <span class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#f5c518] transition-transform group-hover:rotate-45"></span> โปรโมชั่นสมาชิกใหม่
          </a>
          <a href="/ทางเข้า" class="group flex items-center text-[#c9bfa6] transition-colors hover:text-[#fff2c3]">
            <span class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#f5c518] transition-transform group-hover:rotate-45"></span> ทางเข้าล่าสุด
          </a>
          <a href="/about-us" class="group flex items-center text-[#c9bfa6] transition-colors hover:text-[#fff2c3]">
            <span class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#f5c518] transition-transform group-hover:rotate-45"></span> เกี่ยวกับเรา
          </a>
          <a href="/register" class="group flex items-center text-[#c9bfa6] transition-colors hover:text-[#fff2c3]">
            <span class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#f5c518] transition-transform group-hover:rotate-45"></span> สมัครสมาชิก
          </a>
          <a href="/contact-us" class="group flex items-center text-[#c9bfa6] transition-colors hover:text-[#fff2c3]">
            <span class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#f5c518] transition-transform group-hover:rotate-45"></span> ติดต่อแอดมิน
          </a>
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#fff2c3] uppercase">
          ระบบการเงิน
          <span class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#845914] to-[#f5c518] shadow-[0_0_8px_rgba(245,197,24,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#c9bfa6]">รองรับการฝาก-ถอนผ่านแอปธนาคารชั้นนำและ TrueMoney Wallet โดยควรใช้บัญชีชื่อเดียวกับข้อมูลที่สมัครไว้</p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-white/5 bg-[#151007] transition-colors hover:border-[#f5c518]/50" title="ตรวจบิลย้อนหลัง">
          <span class="flex items-center gap-1 text-xs font-bold text-[#f2e6cd]"><span aria-hidden="true" class="text-lg text-[#f5c518]">🧾</span> เก็บเลขรายการไว้ตรวจสอบได้</span>
        </div>
      </div>
    </div>

    <hr class="mb-6 border-[#845914]/35" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#a3966f] md:block">
      UFASLOT เว็บรวมสล็อตออนไลน์ ค่ายแท้ดั้งเดิม ลิขสิทธิ์แท้ทุกเกม เกมยอดนิยม เกมโบนัส เกมแจ็คพอต อัปเดตเกมใหม่ต่อเนื่อง โบนัสคืนยอดเสีย 0.3% ทุกวันตามเงื่อนไข ทางเข้าล่าสุด สมัครสมาชิกใหม่
      เข้าเล่นได้ทั้งมือถือ Android iOS แท็บเล็ต และคอมพิวเตอร์ ผ่านเบราว์เซอร์โดยไม่ต้องติดตั้งโปรแกรมเพิ่ม ทีมงานดูแลและให้คำแนะนำตลอด 24 ชั่วโมง
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-white/5 pt-6 text-xs text-[#a3966f] md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-[#fff2c3] uppercase">UFASLOT</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/terms/" class="transition-colors hover:text-[#fff2c3]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#fff2c3]">นโยบายความเป็นส่วนตัว</a>

        <a
          href="#top"
          class="flex h-8 w-8 items-center justify-center rounded border border-white/10 bg-white/5 text-[#f2e6cd] transition-all hover:border-[#fff2c3] hover:bg-[#241a08] hover:shadow-[0_0_15px_rgba(245,197,24,0.5)]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
