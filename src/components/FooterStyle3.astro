---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// เขียนจาก src/assets/logo.webp ของดรอป 2026-10-21 จริง (เปิดอ่านด้วย Read ก่อนเขียน)
// ไม่ใช่คัดลอกของรอบก่อน — หัวไฉ่ซิงเอี๊ยหมวกทรงจีนแดงขลิบทอง ตัวอักษรไทยผิวทอง
// และเลข 168 สีแดงของ ดวงเศรษฐี168 ที่เคยอยู่บรรทัดนี้ ไม่มีในรูปรอบนี้เลย
// และหน้ายิ้มทองบนกองเหรียญของ มีเฮ168 ที่เคยอยู่ก่อนหน้านั้นก็ไม่มี
// (ทั้งสองเป็นคนละแบรนด์ ถึงชื่อจะขึ้นต้นด้วย "มี" เหมือนกันก็ตาม)
const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส ทางซ้ายเป็นหัวหมูการ์ตูนสีชมพูอ่อน สวมหน้ากากโจรสีดำคาดรอบดวงตา หลับตาข้างหนึ่งยิ้มแลบลิ้นอ้าปากกว้าง มีหูชมพูสองข้างและจมูกหมูสีชมพูเข้ม ทางขวาเป็นคำว่า มีทรัพย์ ตัวอักษรไทยหนาสามมิติไล่เฉดจากชมพูเข้มไปชมพูอ่อน ตัดขอบขาว ต่อด้วยเลข 168 ตัวหนาสามมิติผิวมันวาวสีเงินขาวตัดขอบเทา`;

// มีทรัพย์168 (รอบชมพูบานเย็นบนธีมสว่าง 2026-10-21): footer ที่ใช้งานจริงรอบนี้ —
// รอบก่อน (ดวงเศรษฐี168) ใช้ FooterPremiumSumo เหตุผลที่เลือกไฟล์นี้คือ "ทรง"
// ไม่ใช่สี: FooterPremiumSumo กับ Footer / FooterPremium / FooterHuay เป็นแผ่น
// rounded-t-[3rem] + ออราเรืองแสงเบลอคร่อมขอบบน กริด 12 คอลัมน์ ส่วน FooterStyle2
// เป็นแผ่นแบนขอบบนเส้นหนา กริด 4 คอลัมน์เท่ากัน ไฟล์นี้เป็น **การ์ด CTA ลอยคร่อม
// ขอบบน** (-top-14 / md:-top-16) แล้วตัวแผ่นเว้น pt-64 (md:pt-40) ไว้รับ และมี
// **BankStrip** อยู่ในคอลัมน์ช่องทางทำรายการ — เป็นทรงเดียวในไลบรารีที่ไม่ซ้ำกับ
// ทั้งสองกลุ่มนั้น และไฟล์นี้เว้นว่างมา 4 รอบแล้ว
//
// ของเดิมที่ค้างอยู่ในไฟล์เป็นแดงชาด-ทองเนยของ มีเฮ168 (fb1b32 ff8f9c 5c0410
// fcd45c ffeec0 6b4a08 fdeaec 0c0205 1a040a 2b0711 1b0308 rgba(251,27,50,α)
// rgba(252,212,92,α)) ก่อนหน้านั้นเป็นทองนำ-ชมพูฟูเชียของ มีโชค168 (fcd434 ffeaa0
// f5469f ff8dc6 8c0f52 7a5508 f6e4ee 24101c 160a12 0b0509 1a0612) และก่อนหน้านั้น
// เป็นแดงมังกร-โครเมียมขาวของ GT66B (fb141b ff5f63 ffa0a2 8a0609 3b0405 1c0c0b
// 0b0303 fdfcfd eceaea 190505 db040b) — ย้ายทั้งไฟล์มาเป็นชมพูบานเย็นของรอบนี้แล้ว
// ไม่เหลือทอง ไม่เหลือแดงชาด และไม่เหลือโครเมียมเลย
// ⚠️ **กับดักรอบนี้คือชมพู** — มีโชค168 ที่เคยค้างอยู่ในไฟล์นี้ก็มีชมพู (f5469f
// ff8dc6) มีเฮ168 ที่ค้างอยู่ตอนนี้ก็มีชมพูบลัช (ff8f9c) และ ถอนชัวร์168 ก็มีชมพู
// (fa63b9 ffb3de) ส่วนรอบนี้คือ **#dd1b74** (+#a4186b) ซึ่งห่างจาก f5469f 65 หน่วย
// การเจอชมพูที่ไหนจึงไม่พิสูจน์อะไรเลย ต้องเทียบเป็น "ค่า" ทีละตัวกับ
// .claude/brand-spec-meesub168.md §2
//
// footer เป็น "โครม" จึงประกาศสีตัวอักษรของตัวเองครบทุกจุด ไม่ได้ inherit
// BRAND_TEXT (ซึ่งรอบนี้เป็น **หมึกเข้ม** เพราะเนื้อหาอยู่บนการ์ดสว่าง)
// ⚠️⚠️ **พื้นเพจรอบนี้เป็นชมพูอมม่วงสว่าง #f0ccf5 (จาก bg.json)** — footer ยังเป็น
// พลัมเข้มด้วยเหตุผลสามข้อ: (ก) บล็อก <address> ด้านล่างต้อง paste verbatim ซึ่ง
// ใช้ border-white/15 + bg-black/20 + opacity บนสีที่ inherit มา = ออกแบบมาสำหรับ
// footer เข้ม (ข) หัว-ท้ายเข้มคร่อมเนื้อหาสว่างคือทรงที่ไม่ซ้ำรอบไหนในรีโปนี้
// (ค) โลโก้ชมพู-ขาว-เงินบนพื้นโปร่งอ่านออกชัดกว่าบนพื้นเข้ม
//
// แกนสีที่ใช้ (brand-spec §2): พื้นผิวจม #2d0720 ยกระดับด้วย #4a0d35 ·
// **ชมพูบานเย็น #dd1b74 (ตัวอักษรบนโลโก้ หัวหมู และขอบแคปซูลบนแบนเนอร์) เป็น
// เส้นใต้หัวคอลัมน์ ขอบ เส้นคั่น พื้นถมปุ่ม และหัวการ์ด CTA** ·
// โรสเข้ม #a4186b เป็นปลายเข้มของไล่เฉดและเงา ·
// ชมพูอ่อน #f7dcf6 เป็นเนื้อความ (12.6:1 บน #4a0d35 · 15.9:1 บน #2d0720) ·
// ขาว #ffffff เป็นหัวคอลัมน์ หัวการ์ด CTA ชื่อแบรนด์ และสี hover ของลิงก์
//
// ⚠️⚠️ **#dd1b74 ห้ามถือตัวอักษรบนพื้นเข้มเด็ดขาด** — ได้แค่ 3.2:1 บน #4a0d35 และ
// 3.86:1 บน #2d0720 ทั้งคู่ตกเกณฑ์ AA สำหรับ text ขนาดปกติ ในไฟล์นี้ชมพูจึงเป็น
// **พื้นถม / ขอบ / เส้นใต้ / จุดนำลิงก์ / เงาเท่านั้น** นี่คือเหตุผลที่หัวการ์ด CTA
// เป็นขาวตัน ไม่ใช่ชมพูอย่างที่ตาอยากให้เป็น และ #a4186b ยิ่งต่ำกว่า ห้ามถือ
// ตัวอักษรทุกขนาด
// ปุ่มพื้นชมพูใช้หมึก **ขาว** — #ffffff บน #dd1b74 ≈ 4.67:1 และบน #a4186b ≈ 7.17:1
// ผ่าน AA ทั้งคู่ ⚠️ ห้ามพลิกไปใช้หมึกพลัม #4a0d35 บนพื้นชมพู (เหลือ ~3.2:1)
// แผ่นที่เลื่อนขึ้นมาตอน hover เป็นพลัม #4a0d35 — หมึกขาวบนพลัมได้ ≈ 14.9:1
// rgba() ที่อนุญาตรอบนี้: rgba(221,27,116,α) · rgba(164,24,107,α) · rgba(74,13,53,α)
// ⚠️ รอบนี้ **ไม่มีทอง/เหลือง ไม่มีแดงชาด ไม่มีบรอนซ์ ไม่มีฟ้า/น้ำเงิน ไม่มีเขียว
// ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์ ไม่มีส้ม** — เขียว #00B900 บนปุ่ม LINE เป็น
// **สีซีแมนติกของแบรนด์ LINE ไม่ใช่สีของเว็บ** จึงคงไว้ตามเดิม เช่นเดียวกับโลโก้
// ธนาคารจริงใน BankStrip
//
// คอปปี้ทั้งไฟล์เขียนใหม่จากบรีฟ มีทรัพย์168 (src/assets/content.txt) ซึ่งแกนคือ
// **"ระบบดูแลการเงิน" — ช่องทางฝากถอนผ่านธนาคารชั้นนำและวอลเลท พร้อมข้อมูลเกม
// สล็อต ไฮโล ยิงปลา หวย และฟุตบอล** โดยจุดที่บรีฟย้ำซ้ำที่สุดคือ **การตรวจสอบ
// ชื่อบัญชีผู้รับเงินก่อนโอน และการเลี่ยงบัญชีม้า/บัญชีแอบอ้าง**
// ⚠️ **ไม่ใช่เว็บสอนเล่นเกมแบบรอบก่อน** — "เว็บสอนเล่นเกมออนไลน์" "จากเศรษฐีพนัน
// มือ1" "ผู้สอน" "บทเรียน" "หลักสูตร" "สูตร" "เทคนิค" "ความน่าจะเป็น" "ตารางจ่าย
// รางวัล" และ "3 ขั้นตอน" เป็นคำของ **ดวงเศรษฐี168** ถอดออกครบแล้วและห้ามใส่กลับ
// ⚠️ **"บาคาร่า" ก็เป็นคำของรอบก่อน** — บรีฟรอบนี้ระบุห้าหมวด (สล็อต ไฮโล ยิงปลา
// หวย บอล) ไม่มีบาคาร่า ห้ามเติมเอง
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อธนาคารหรือชื่อค่ายเกมแม้แต่รายเดียว** — PG SOFT,
// JOKER, JILI และ "นำเข้าตรงจากสิงคโปร์" ที่เคยอยู่ในไฟล์นี้เป็นคำของ มีโชค168
// ทั้งหมด ไม่ได้ระบุเลขใบอนุญาต ชื่อหน่วยงานกำกับ ชื่อนิติบุคคล ยอดขั้นต่ำเป็น
// ตัวเลข ค่า RTP จำนวนสมาชิก หรือปีก่อตั้งไว้เลย จึงไม่มีในข้อความนี้
// ⚠️ บรีฟ "ตั้งคำถามกับคำโฆษณาของตัวเอง" และประโยคกำกับพวกนั้นต้องขนมาด้วย ห้าม
// ตัดทิ้งเพราะฟังดูไม่ขายของ: เกมเดิมพันทุกประเภทมีความเสี่ยงต่อการสูญเสียเงิน และ
// ไม่มีรูปแบบใดสามารถรับประกันผลกำไรได้ · เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับ
// เงินคืนจากทุกการเดิมพัน · ควรตรวจสอบเวลาการให้บริการและระยะเวลาตอบกลับล่าสุดอีกครั้ง
// ⚠️ คำของแบรนด์ก่อนที่ห้ามหลุดกลับมา: สล็อตรวมเกมกำไรงาม · เล่นง่ายทุกค่าย ·
// ทุนน้อยก็เล่นได้ (รวยแทร่168) · เกมสล็อตเจนซี · เดิมพันง่าย ไม่มีขั้นต่ำ
// (มีเฮ168) · ลิขสิทธิ์แท้ · นำเข้าตรงจากสิงคโปร์ (มีโชค168) · เว็บตรง ·
// ไม่ผ่านเอเย่นต์ · แตกง่าย · การันตีเว็บแท้ · เว็บแท้อันดับ1 · และคำหวยทุกคำ
// (⚠️ **"ไม่ผ่านม้า" ใช้ได้** เพราะเป็นคำของบรีฟรอบนี้เอง ต่างจาก "ไม่ผ่านบัญชีม้า"
// ที่เคยเป็นคำค้างของแบรนด์เก่า — รอบนี้บรีฟเขียนทั้ง "ไม่ผ่านม้า" และ "บัญชีม้า")
//
// ลิงก์: มีทรัพย์168 เป็นเว็บระบบฝากถอน ไม่ใช่เว็บหวย — /ตรวจหวย กับ /แนวทาง อยู่ใน
// src/pages-disabled/ รอบนี้ จึงไม่มีสองลิงก์นั้นในคอลัมน์ลิงก์ด่วน ไม่งั้น
// verify-build.mjs จะทำให้ build แดงเพราะ href ชี้ไป route ที่ไม่มีใน dist/
// ถ้ารอบหน้าเป็นแบรนด์หวยแล้วย้ายไฟล์กลับเข้า src/pages/ ต้องเพิ่มสองลิงก์นี้คืน
//
// /register กับ /login รอบนี้เป็นหน้าปุ่มจริงที่ index ได้ (toggle cta เปิด) ส่วน
// /ทางเข้า ถูกถอดออกจากเมนู navbar รอบนี้ แต่ route ยังมีจริงและยัง index อยู่
// ลิงก์จาก footer จึงยังถูกต้องทั้งสามหน้า (ดู NavbarStyle3.astro)
//
// บล็อก <address> ตั้งใจไม่ทาสีแบรนด์ — border-white/15 + bg-black/20 + opacity
// บนสีตัวอักษรที่ inherit มา ลงตัวกับ footer ทุกตัวในไลบรารี ห้าม retheme
---

<footer
  class="relative mt-32 w-full border-t border-[#dd1b74]/55 bg-[#2d0720] pt-64 pb-6 font-sans text-[#f7dcf6] shadow-[0_-10px_30px_rgba(221,27,116,0.28)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#dd1b74]/60 bg-gradient-to-r from-[#4a0d35] via-[#2d0720] to-[#4a0d35] p-6 shadow-[0_15px_40px_rgba(74,13,53,0.7)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-white uppercase italic drop-shadow-[0_2px_4px_rgba(74,13,53,0.8)] md:text-3xl">
        <span aria-hidden="true">🐷</span> พร้อมเริ่มใช้งานระบบดูแลการเงินกับ {BRAND_NAME} แล้วหรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#f7dcf6]/90 md:text-base">
        สมัคร {BRAND_NAME} ได้ด้วยตนเองผ่านมือถือ โดยตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง อ่านข้อกำหนดการเปิดบัญชีและนโยบายการจัดเก็บข้อมูลส่วนบุคคล แล้วกรอกข้อมูลตามที่ระบบกำหนดก่อนยืนยันบัญชี
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#a4186b] bg-gradient-to-b from-[#dd1b74] to-[#a4186b] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-white shadow-[0_0_15px_rgba(221,27,116,0.5)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">📝</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#4a0d35] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <span class="block h-[56px] w-[180px] overflow-hidden">
                <Picture
                  src={mainLogo}
                  alt={logoAlt}
                  widths={[180, 360]}
                  sizes="180px"
                  loading="lazy"
                  decoding="async"
                  class="h-auto w-full -translate-y-[62px] drop-shadow-[0_0_12px_rgba(221,27,116,0.65)]"
                  formats={["avif", "webp"]}
                  fallbackFormat="webp"
                  quality={72}
                />
              </span>
            ) : (
              <p class="bg-gradient-to-r from-[#ffffff] via-[#f7dcf6] to-[#dd1b74] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(221,27,116,0.6)]">{BRAND_NAME}</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#f7dcf6]/75">
          {BRAND_NAME} นำเสนอระบบบริการสมาชิกที่รวบรวมช่องทางฝากถอนและข้อมูลเกมออนไลน์ไว้ในเว็บไซต์เดียว ทั้งเกมสล็อต ไฮโล ยิงปลา หวย และฟุตบอล พร้อมช่องทางทำรายการผ่านธนาคารและวอลเลทตามที่เปิดให้บริการ
