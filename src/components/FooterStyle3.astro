---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt =
  "โลโก้ NATO168 บนพื้นโปร่งใส ด้านซ้ายเป็นวงกลมทองไล่เฉดมีตัวอักษร N สีเงินเมทัลลิกอยู่ตรงกลาง ถัดมาเป็นคำว่า NATO ตัวหนาสามมิติสีเงินเมทัลลิกไล่แสง และเลข 168 ตัวหนาสามมิติสีทองไล่เฉด";

// NATO168 (รอบทอง-เงิน-ดำ 2026-10-02): footer ที่ใช้งานจริงรอบนี้ — รอบก่อน NAZA99
// ใช้ FooterPremium จึงหมุนมาที่ไฟล์นี้ ของเดิมที่ค้างอยู่ในไฟล์เป็นแดงเข้ม-ทองของ
// หวยเฮง24 (#1a0505 #2e0707 #3d0808 #e0a52a #fdea83 #c01616 #a46304 #bd7c13
// #f6e6cf #2a0606) ย้ายทั้งไฟล์มาเป็นทอง-เงิน-ดำตามโลโก้จริงแล้ว ไม่เหลือแดงเลย
//
// แกนสีที่ใช้: พื้นเกือบดำ #070707 ยกระดับด้วย #101010 / #17120a / #241a09 ·
// ทองแบรนด์ #edb543 เป็นเส้นคั่น จุดนำลิงก์ และขอบการ์ด · ทองอ่อน #fde8a8 สงวนไว้
// ให้หัวคอลัมน์ ชื่อแบรนด์ และปุ่มสมัคร · เงิน #e6e6e6 เป็นปลายเกรเดียนต์คู่กับทอง
// ตามโลโก้ที่คำว่า NATO เป็นเงินเมทัลลิกและ 168 เป็นทอง · ทองลึก #a9761f เป็นเส้น
// คั่นจาง · เนื้อความ #f4ead3 (BRAND_TEXT ของรอบนี้) ลดน้ำหนักด้วย opacity
//
// คอปปี้ทั้งไฟล์เขียนใหม่จากบรีฟ NATO168 ซึ่งเป็น **เว็บสล็อตออนไลน์** — บรีฟรอบนี้
// พูดเรื่องสล็อตพีจีและค่ายที่เว็บไซต์เปิดรองรับ หมวดโบนัสไทม์ โบนัสทุกยูสไม่มีล็อค
// คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% สมัคร 3 ขั้นตอน และแอดมิน 24 ชั่วโมงเท่านั้น
// ไม่ได้ระบุใบอนุญาต ผู้ให้บริการ ชื่อธนาคาร ยอดขั้นต่ำ หรือค่า RTP ใดเป็นชื่อๆ
// จึงไม่มีในข้อความนี้ และไม่ได้แทนชื่อแบรนด์ทับประโยคหวยของ หวยเฮง24 — เขียนใหม่
// ทั้งหมดจากบรีฟ คำหมวดหวยทั้งชุด (หวย โพย งวด อัตราจ่าย เลข 2 ตัว/3 ตัว) หายไปหมด
//
// ลิงก์: NATO168 เป็นแบรนด์สล็อต ไม่ใช่เว็บหวย — /ตรวจหวย กับ /แนวทาง ถูกพักไว้ใน
// src/pages-disabled/ รอบนี้ ลิงก์ทั้งสองตัวจึงถูกถอดออกจากคอลัมน์ลิงก์ด่วน ถ้าทิ้ง
// ไว้ verify-build.mjs จะทำให้ build แดงเพราะ href ชี้ไป route ที่ไม่มีจริงใน dist/
//
// /ทางเข้า ยังมีลิงก์อยู่ตรงนี้: หน้านั้นยัง route และ index อยู่ แค่ไม่มีใน
// เมนู navbar เพราะ toggle ของ register/login เปิด (ดู NavbarStyle8.astro)
//
// ปุ่มพื้นทองใช้ตัวอักษรหมึกเข้ม #1a1203 — พื้นทองสว่างกับตัวอักษรอ่อนอ่านไม่ออก
//
// บล็อก <address> ตั้งใจไม่ทาสีแบรนด์ — border-white/15 + bg-black/20 + opacity
// บนสีตัวอักษรที่ inherit มา ลงตัวกับ footer ทุกตัวในไลบรารี ห้าม retheme
---

<footer
  class="relative mt-32 w-full border-t border-[#edb543]/50 bg-[#070707] pt-64 pb-6 font-sans text-[#f4ead3] shadow-[0_-10px_30px_rgba(237,181,67,0.16)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#edb543]/70 bg-gradient-to-r from-[#17120a] via-[#241a09] to-[#17120a] p-6 shadow-[0_15px_40px_rgba(4,3,0,0.6)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#fde8a8] uppercase italic drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)] md:text-3xl">
        <span aria-hidden="true">🎰</span> พร้อมเริ่มเล่นสล็อตกับ {BRAND_NAME} แล้วหรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#f4ead3]/90 md:text-base">
        สมัคร {BRAND_NAME} ได้ด้วยตนเองทั้งบนมือถือและคอมพิวเตอร์ เลือกสล็อตพีจีและเกมจากค่ายที่เว็บไซต์เปิดรองรับได้จากบัญชีเดียว
        พร้อมหมวดโบนัสไทม์สำหรับติดตามเกมและกิจกรรมที่เปิดสิทธิ์ในแต่ละช่วง โดยสามารถตรวจสอบโบนัส เครดิต และรายละเอียดโปรโมชั่นผ่านบัญชีของตนเองก่อนเริ่มเล่นได้ทันที
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#b8832a] bg-gradient-to-b from-[#fde8a8] to-[#edb543] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#1a1203] shadow-[0_0_15px_rgba(237,181,67,0.45)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🚀</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#241a09] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[100, 200, 300]}
                sizes="100px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(237,181,67,0.55)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-r from-[#e6e6e6] via-[#fde8a8] to-[#edb543] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(237,181,67,0.55)]">{BRAND_NAME}</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#f4ead3]/75">
          {BRAND_NAME} รวมเกมสล็อตออนไลน์สำหรับผู้ที่ต้องการเริ่มต้นเล่นผ่านระบบที่ใช้งานไม่ซับซ้อน มีทั้งสล็อตพีจีและเกมจากค่ายที่เว็บไซต์เปิดรองรับ
          สามารถเข้าเล่นผ่านมือถือได้โดยไม่ต้องสลับหลายแพลตฟอร์ม พร้อมหมวดโบนัสไทม์สำหรับติดตามเกมและกิจกรรมที่เปิดสิทธิ์ในแต่ละช่วง
          สมาชิกใหม่สามารถตรวจสอบโบนัส เกมยอดนิยม เครดิต และรายละเอียดโปรโมชั่นผ่านบัญชีของตนเองก่อนเริ่มเล่นได้ทันที
          โดยคำว่ารับโบนัสทุกยูสและไม่มีล็อคยูสควรอ้างอิงเงื่อนไขจริงของเว็บไซต์ เพราะบางโปรโมชั่นอาจกำหนดประเภทสมาชิก เกมที่ร่วมรายการ หรือยอดที่ใช้คำนวณแตกต่างกัน
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/30 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.1)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>
        </div>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }
      </div>

      <nav aria-label="ลิงก์ด่วน" class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#fde8a8] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#e6e6e6] to-[#edb543] shadow-[0_0_8px_rgba(237,181,67,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          <a href="/" class="group flex items-center text-[#f4ead3]/75 transition-colors hover:text-[#fde8a8]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#edb543] transition-transform group-hover:rotate-45"></span> หน้าแรก
          </a>
          <a href="/promotion" class="group flex items-center text-[#f4ead3]/75 transition-colors hover:text-[#fde8a8]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#edb543] transition-transform group-hover:rotate-45"></span> โปรโมชั่นสมาชิก
          </a>
          <a href="/ทดลองเล่น" class="group flex items-center text-[#f4ead3]/75 transition-colors hover:text-[#fde8a8]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#edb543] transition-transform group-hover:rotate-45"></span> ทดลองเล่น
          </a>
          <a href="/ทางเข้า" class="group flex items-center text-[#f4ead3]/75 transition-colors hover:text-[#fde8a8]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#edb543] transition-transform group-hover:rotate-45"></span> ทางเข้าล่าสุด
          </a>
          <a href="/register" class="group flex items-center text-[#f4ead3]/75 transition-colors hover:text-[#fde8a8]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#edb543] transition-transform group-hover:rotate-45"></span> สมัครสมาชิก
          </a>
          <a href="/login" class="group flex items-center text-[#f4ead3]/75 transition-colors hover:text-[#fde8a8]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#edb543] transition-transform group-hover:rotate-45"></span> เข้าสู่ระบบ
          </a>
          <a href="/about-us" class="group flex items-center text-[#f4ead3]/75 transition-colors hover:text-[#fde8a8]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#edb543] transition-transform group-hover:rotate-45"></span> เกี่ยวกับเรา
          </a>
          <a href="/contact-us" class="group flex items-center text-[#f4ead3]/75 transition-colors hover:text-[#fde8a8]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#edb543] transition-transform group-hover:rotate-45"></span> ติดต่อเจ้าหน้าที่
          </a>
        </div>
      </nav>

      <section aria-label="ช่องทางฝากถอน" class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#fde8a8] uppercase">
          ช่องทางฝากถอน
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#e6e6e6] to-[#edb543] shadow-[0_0_8px_rgba(237,181,67,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#f4ead3]/75">รองรับการทำรายการตามช่องทางที่ระบบเปิดให้บริการ โดยควรใช้บัญชีชื่อเดียวกับข้อมูลที่ผูกไว้ตอนสมัคร และตรวจสอบรายการจากบัญชีสมาชิกทุกครั้ง</p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-[#a9761f]/40 bg-[#17120a] transition-colors hover:border-[#edb543]/60">
          <span class="flex items-center gap-1 text-xs font-bold text-[#f4ead3]"><span aria-hidden="true" class="text-lg text-[#edb543]">🎁</span> ตรวจสอบโบนัสและสิทธิ์ได้จากบัญชีสมาชิก</span>
        </div>
      </section>
    </div>

    <hr class="mb-6 border-[#3a2a0d]" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#f4ead3]/70 md:block">
      {BRAND_NAME} เป็นช่องทางสำหรับผู้ที่ต้องการเริ่มต้นเล่นเกมสล็อตออนไลน์ผ่านระบบที่ใช้งานไม่ซับซ้อน รวมสล็อตพีจีและเกมจากค่ายที่เว็บไซต์เปิดรองรับไว้ในบัญชีเดียว
      เข้าใช้งานผ่านเว็บเบราว์เซอร์ได้ทั้งบนมือถือและคอมพิวเตอร์โดยไม่ต้องสลับหลายแพลตฟอร์ม หลัง Login สามารถเลือกเกมได้หลายรูปแบบตั้งแต่สล็อตวงล้อทั่วไป ฟรีสปิน
      ตัวคูณ ไปจนถึงเกมที่มีฟีเจอร์โบนัส จำนวนเกมและค่ายที่เปิดให้บริการขึ้นอยู่กับรายการที่ผู้ให้บริการเปิดรับในแต่ละช่วง จึงอาจไม่เท่ากันทุกวัน
      หมวดโบนัสไทม์ใช้สำหรับติดตามเกมและกิจกรรมที่เปิดสิทธิ์ในแต่ละช่วง ส่วนคำว่ารับโบนัสทุกยูสและไม่มีล็อคยูสควรอ้างอิงเงื่อนไขจริงของเว็บไซต์
      เพราะบางโปรโมชั่นอาจกำหนดประเภทสมาชิก เกมที่ร่วมรายการ หรือยอดที่ใช้คำนวณแตกต่างกัน โบนัสคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8% คำนวณจากยอดที่เข้าเงื่อนไข
      ตามรอบที่เว็บไซต์กำหนด จึงควรตรวจสอบค่ายเกม รอบตัดยอด และรายละเอียดของแต่ละรายการให้ครบถ้วนก่อนกดรับทุกครั้ง
      การสมัครทำได้ผ่านมือถือใน 3 ขั้นตอน ควรใช้ข้อมูลของตนเองในการสมัคร ตั้งรหัสผ่านที่คาดเดายาก และไม่เปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น
      หากเป็นปัญหาเกี่ยวกับเกมควรแจ้งชื่อเกม ค่าย และเวลาที่เกิดเหตุ ส่วนรายการด้านธุรกรรมควรเตรียมเวลา จำนวนเงิน และหลักฐานที่เกี่ยวข้องไว้สำหรับตรวจสอบ
      พร้อมเจ้าหน้าที่ {BRAND_NAME} ดูแลผ่านช่องทางไลน์ตลอด 24 ชั่วโมง
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-[#a9761f]/40 pt-6 text-xs text-[#f4ead3]/75 md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-[#fde8a8] uppercase">{BRAND_NAME}</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/terms/" class="transition-colors hover:text-[#fde8a8]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#fde8a8]">นโยบายความเป็นส่วนตัว</a>

        <a
          href="#top"
          class="flex h-8 w-8 items-center justify-center rounded border border-[#a9761f]/50 bg-[#17120a] text-[#f4ead3] transition-all hover:border-[#edb543] hover:bg-[#241a09] hover:shadow-[0_0_15px_rgba(237,181,67,0.55)]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
