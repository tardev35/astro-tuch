---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt =
  "โลโก้ HI59 บนพื้นโปร่งใส เป็นตัวอักษรละตินหนาสามมิติ คำว่า HI สีฟ้าเงาวาวไล่แสง ต่อด้วยตัวเลข 59 สีทองเงาวาว ล้อมด้วยวงแหวนโค้งสีทองพาดด้านบนและโค้งสีฟ้าพาดด้านล่าง";

// HI59 (รอบฟ้า-ทอง บนกรมท่าเข้ม 2026-10-07): footer ที่ใช้งานจริงรอบนี้ — รอบก่อน
// (หวยดีใจ) ใช้ FooterPremium จึงหมุนกลับมาที่ไฟล์นี้ ของเดิมที่ค้างอยู่ในไฟล์เป็น
// แดงแบรนด์-ทองบนดำอมแดงของ หวย24 (#0a0303 #170707 #230d0d #d20a0a #ff3b3b
// #f5c33b #ffd45e #f7e2d6 #1a0303 #a9761a #3d0a0a #ff5c5c) ย้ายทั้งไฟล์มาเป็น
// ฟ้า-ทองบนกรมท่าเข้มตามโลโก้จริงแล้ว ไม่เหลือแดงชุดเดิมเลย
//
// footer เป็น "โครม" จึงยังเป็นผิวเข้มแม้ทั้งเว็บรอบนี้จะสว่าง (การ์ด ContentBox*
// เป็นกระจกน้ำแข็งสว่าง) — มันประกาศสีตัวอักษรของตัวเองครบทุกจุด ไม่ได้ inherit
// BRAND_TEXT และโลโก้ฟ้า-ทองต้องการพื้นเข้มถึงจะอ่านออก
//
// แกนสีที่ใช้: พื้นกรมท่าเข้ม #02162c ยกระดับด้วย #04203f / #073059 · ฟ้าแบรนด์
// #0a84e0 (vivid ของ logo.webp ตัวอักษร HI) เป็นเส้นคั่น จุดนำลิงก์ และขอบการ์ด ·
// ฟ้าสว่าง #5ec2ff เป็นปลายไล่เฉดด้านสว่าง · ทองแบรนด์ #fdbc04 เป็นฮิวที่สอง
// (vivid ตัวเดียวกัน ตัวเลข 59 และวงแหวนโค้ง) อยู่ปลายไล่เฉดและเส้นใต้หัวคอลัมน์ ·
// ทองอ่อน #ffe27a สงวนไว้ให้หัวคอลัมน์ ชื่อแบรนด์ และปุ่มสมัคร · เนื้อความ
// #e4f1fd ลดน้ำหนักด้วย opacity
//
// คอปปี้ทั้งไฟล์เขียนใหม่จากบรีฟ HI59 ซึ่งเป็น **เว็บสล็อตออนไลน์ ไม่ใช่เว็บหวย**
// บรีฟรอบนี้พูดเรื่องสล็อตไฮคลาสสไตล์ VIP รวมค่ายเกมพรีเมียมในบัญชีเดียว สล็อต
// ยอดนิยม เกมเปิดใหม่ ฟรีสปิน ตัวคูณ ฟีเจอร์โบนัส โปรโมชั่นคืนยอดเสีย 0.3%
// แนะนำเพื่อน 0.8% ฝากถอนทุกช่องทาง ยอดเข้าบริษัทตรง และแอดมิน 24 ชั่วโมงเท่านั้น
// ไม่ได้ระบุใบอนุญาต ชื่อค่ายเกม ชื่อผู้ให้บริการ ชื่อธนาคาร ยอดขั้นต่ำ ค่า RTP
// หรือจำนวนสมาชิกใดไว้ จึงไม่มีในข้อความนี้ และประโยคกำกับของบรีฟเอง (เว็บตรง/
// ลิขสิทธิ์แท้ควรมีข้อมูลผู้ให้บริการที่ตรวจสอบได้ · "ปลอดภัย 100%" ไม่ควรใช้เป็น
// การรับประกันโดยไม่มีหลักฐาน · "โบนัสสูง ให้เยอะกว่าใคร" ควรมีข้อมูลเปรียบเทียบ
// รองรับ · "ฝากถอนได้ทุกช่องทาง" หมายถึงเฉพาะช่องทางที่ระบบรองรับจริง ·
// "ไม่ผ่านบัญชีม้า" ควรมีชื่อนิติบุคคลรองรับ) ขนมาด้วย ไม่ตัดทิ้ง
//
// ลิงก์: HI59 เป็นเว็บสล็อต — /ตรวจหวย กับ /แนวทาง ถูกย้ายไป src/pages-disabled/
// รอบนี้ จึงถอดสองลิงก์นั้นออกจากคอลัมน์ลิงก์ด่วนพร้อมกัน ไม่งั้น verify-build.mjs
// จะทำให้ build แดงเพราะ href ชี้ไป route ที่ไม่มีใน dist/ ถ้ารอบหน้าเป็นแบรนด์หวย
// แล้วย้ายไฟล์กลับเข้า src/pages/ ต้องเพิ่มสองลิงก์นี้คืนพร้อมกัน
//
// /ทางเข้า ยังมีลิงก์อยู่ตรงนี้: หน้านั้นยัง route และ index อยู่ แค่ไม่มีใน
// เมนู navbar เพราะ toggle ของ register/login เปิด (ดู NavbarStyle6.astro)
//
// ปุ่มพื้นทองใช้ตัวอักษรหมึกกรมท่าเข้ม #04203f — พื้นทองสว่างกับตัวอักษรอ่อนอ่านไม่ออก
// (#04203f บน #ffe27a = 12.1:1 · บน #fdbc04 = 9.2:1 ผ่าน AA ทั้งคู่)
//
// บล็อก <address> ตั้งใจไม่ทาสีแบรนด์ — border-white/15 + bg-black/20 + opacity
// บนสีตัวอักษรที่ inherit มา ลงตัวกับ footer ทุกตัวในไลบรารี ห้าม retheme
---

<footer
  class="relative mt-32 w-full border-t border-[#0a84e0]/55 bg-[#02162c] pt-64 pb-6 font-sans text-[#e4f1fd] shadow-[0_-10px_30px_rgba(10,132,224,0.22)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#0a84e0]/70 bg-gradient-to-r from-[#04203f] via-[#073059] to-[#04203f] p-6 shadow-[0_15px_40px_rgba(3,26,52,0.7)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#ffe27a] uppercase italic drop-shadow-[0_2px_4px_rgba(2,22,44,0.6)] md:text-3xl">
        <span aria-hidden="true">🎰</span> พร้อมเข้าเล่นสล็อตกับ {BRAND_NAME} แล้วหรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#e4f1fd]/90 md:text-base">
        สมัคร {BRAND_NAME} ได้ด้วยตนเองทั้งบนมือถือและคอมพิวเตอร์ เลือกค่าย ค้นหาเกม และสลับเกมผ่านบัญชีเดียว พร้อมตรวจสอบเครดิต โปรโมชั่น
        และประวัติรายการก่อนยืนยันทุกครั้ง
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#c88a02] bg-gradient-to-b from-[#ffe27a] to-[#fdbc04] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#04203f] shadow-[0_0_15px_rgba(253,188,4,0.45)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🚀</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#073059] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[100, 200, 300]}
                sizes="100px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(10,132,224,0.6)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-r from-[#5ec2ff] via-[#ffe27a] to-[#0a84e0] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(10,132,224,0.6)]">{BRAND_NAME}</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#e4f1fd]/75">
          {BRAND_NAME} เป็นเว็บสล็อตไฮคลาสที่เน้นรูปแบบการใช้งานสไตล์ VIP รวบรวมเกมสล็อตจากหลายค่ายไว้ในบัญชีเดียว มีทั้งสล็อตยอดนิยม เกมเปิดใหม่ ฟรีสปิน ตัวคูณ
          และฟีเจอร์โบนัสหลากหลายรูปแบบ รองรับการเข้าเล่นผ่านมือถือและคอมพิวเตอร์ สมาชิกเลือกค่าย ค้นหาเกม ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการได้จากที่เดียว
          แม้ระบบเว็บไซต์จะเข้าใช้งานได้ 24 ชั่วโมง แต่รายชื่อค่ายและจำนวนเกมที่เปิดให้เล่นจริงยังขึ้นอยู่กับการเชื่อมต่อของระบบในแต่ละช่วง ส่วนการระบุว่าเป็น
          “เว็บตรง” หรือใช้ “เกมลิขสิทธิ์แท้” ควรมีข้อมูลผู้ให้บริการที่ตรวจสอบได้รองรับอย่างชัดเจน ไม่ควรพิจารณาจากข้อความประชาสัมพันธ์เพียงอย่างเดียว
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/40 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.12)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>
        </div>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }
      </div>

      <nav aria-label="ลิงก์ด่วน" class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#ffe27a] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#5ec2ff] to-[#fdbc04] shadow-[0_0_8px_rgba(10,132,224,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          <a href="/" class="group flex items-center text-[#e4f1fd]/75 transition-colors hover:text-[#ffe27a]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#5ec2ff] transition-transform group-hover:rotate-45"></span> หน้าแรก
          </a>
          <a href="/promotion" class="group flex items-center text-[#e4f1fd]/75 transition-colors hover:text-[#ffe27a]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#5ec2ff] transition-transform group-hover:rotate-45"></span> โปรโมชั่นสมาชิก
          </a>
          <a href="/ทดลองเล่น" class="group flex items-center text-[#e4f1fd]/75 transition-colors hover:text-[#ffe27a]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#5ec2ff] transition-transform group-hover:rotate-45"></span> ทดลองเล่นสล็อต
          </a>
          <a href="/ทางเข้า" class="group flex items-center text-[#e4f1fd]/75 transition-colors hover:text-[#ffe27a]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#5ec2ff] transition-transform group-hover:rotate-45"></span> ทางเข้าล่าสุด
          </a>
          <a href="/register" class="group flex items-center text-[#e4f1fd]/75 transition-colors hover:text-[#ffe27a]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#5ec2ff] transition-transform group-hover:rotate-45"></span> สมัครสมาชิก
          </a>
          <a href="/login" class="group flex items-center text-[#e4f1fd]/75 transition-colors hover:text-[#ffe27a]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#5ec2ff] transition-transform group-hover:rotate-45"></span> เข้าสู่ระบบ
          </a>
          <a href="/about-us" class="group flex items-center text-[#e4f1fd]/75 transition-colors hover:text-[#ffe27a]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#5ec2ff] transition-transform group-hover:rotate-45"></span> เกี่ยวกับเรา
          </a>
          <a href="/contact-us" class="group flex items-center text-[#e4f1fd]/75 transition-colors hover:text-[#ffe27a]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#5ec2ff] transition-transform group-hover:rotate-45"></span> ติดต่อแอดมิน
          </a>
        </div>
      </nav>

      <section aria-label="ช่องทางทำรายการ" class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#ffe27a] uppercase">
          ช่องทางทำรายการ
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#5ec2ff] to-[#fdbc04] shadow-[0_0_8px_rgba(10,132,224,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#e4f1fd]/75">
          ก่อนทำรายการทุกครั้งควรตรวจสอบชื่อบัญชีปลายทางให้ตรงกับข้อมูลที่เว็บไซต์ประกาศ และเก็บเวลา จำนวนเงิน พร้อมหลักฐานธุรกรรมไว้สำหรับตรวจสอบย้อนหลัง
        </p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-[#0a84e0]/45 bg-[#04203f] transition-colors hover:border-[#5ec2ff]/70">
          <span class="flex items-center gap-1 text-xs font-bold text-[#e4f1fd]"><span aria-hidden="true" class="text-lg text-[#fdbc04]">🎰</span> ตรวจสอบช่องทางที่ระบบรองรับก่อนทำรายการ</span>
        </div>
      </section>
    </div>

    <hr class="mb-6 border-[#073059]" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#e4f1fd]/70 md:block">
      {BRAND_NAME} เป็นช่องทางสำหรับผู้ที่ต้องการเข้าเล่นเกมสล็อตจากหลายค่ายผ่านระบบเดียว มีทั้งสล็อตยอดนิยม เกมเปิดใหม่ และเกมที่มีฟีเจอร์โบนัสหลากหลายรูปแบบ
      ทั้งวงล้อ ฟรีสปิน ตัวคูณ และช่วงเดิมพันที่แตกต่างกันในแต่ละเกม เข้าใช้งานผ่านเว็บเบราว์เซอร์ได้ทั้งบนมือถือและคอมพิวเตอร์ หลัง Login สามารถเลือกค่าย ค้นหาเกม
      ตรวจสอบเครดิต ดูโปรโมชั่น แล้วย้อนดูประวัติรายการได้จากบัญชีเดียวโดยไม่ต้องสมัครใหม่หลายครั้ง รายชื่อค่ายและจำนวนเกมที่เปิดให้เล่นอาจมีการอัปเดต
      จึงควรตรวจสอบรายการล่าสุดจากหน้าเกมสล็อตของเว็บไซต์ โปรโมชั่นคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% คำนวณจากยอดที่เข้าเกณฑ์ตามรอบที่กำหนด แต่ละแคมเปญ
      อาจมีรอบคำนวณและค่ายเกมที่ร่วมรายการแตกต่างกัน จึงควรตรวจสอบเงื่อนไขล่าสุดก่อนกดรับสิทธิ์ ส่วนข้อความว่า “โบนัสสูง ให้เยอะกว่าใคร” ควรมีข้อมูลเปรียบเทียบ
      ที่ตรวจสอบได้รองรับ หากไม่มีข้อมูลดังกล่าว การระบุจำนวนโบนัสและเงื่อนไขจริงของแต่ละโปรโมชั่นจะเหมาะสมกว่า คำว่า “ฝากถอนได้ทุกช่องทาง” ควรหมายถึงเฉพาะ
      ช่องทางที่ระบบรองรับจริง และการระบุว่าเงินเข้าบัญชีบริษัทโดยตรงหรือไม่ผ่านบัญชีม้า ควรมีชื่อนิติบุคคลและข้อมูลบริษัทที่นำไปตรวจสอบเทียบกับชื่อบัญชีปลายทางได้
