---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt =
  "โลโก้ PGW44 ตัวอักษรภาษาอังกฤษหนาแบบสามมิติบนพื้นหลังโปร่งใส ตัว P เป็นสีดำเงาขลิบขอบทอง ตัว G ไล่เฉดทองอ่อนไปทองเข้ม ตัว W เป็นเขียวสด และเลข 44 ไล่จากทองไปเป็นเขียว";

// PGW44 (รอบทอง-เขียว-ดำ 2026-09-27): footer ที่ใช้งานจริงรอบนี้ — รอบก่อน PKG44
// ใช้ FooterPremium จึงหมุนมาที่ไฟล์นี้ ของเดิมที่ค้างอยู่ในไฟล์เป็นทอง-ครีมของ
// KINGDOM66 ย้ายทั้งไฟล์มาเป็นทอง-เขียวตามโลโก้จริงแล้ว
//
// แกนสีที่ใช้: พื้นเกือบดำอมเขียว #070d05 ยกระดับด้วย #0b1408 / #101a0b /
// #1f5a16 · ทองแบรนด์ #fde90e เป็นเส้นคั่น จุดนำลิงก์ และขอบการ์ด · ทองอ่อน
// #fff89a สงวนไว้ให้หัวคอลัมน์ ชื่อแบรนด์ และปุ่มสมัคร · เขียวแบรนด์ #35d413
// เป็นปลายเกรเดียนต์คู่กับทองตามลำดับตัวอักษรในโลโก้ · ทองลึก #a86f02 เป็นเส้น
// คั่นจาง · เนื้อความ #e9f0dd (BRAND_TEXT ของรอบนี้) ลดน้ำหนักด้วย opacity
//
// คอปปี้ทั้งไฟล์เขียนใหม่จากบรีฟ PGW44 ซึ่งเป็น **เว็บสล็อตล้วน** — ของเดิมเป็น
// ของ KINGDOM66 ที่ขาย บาคาร่า/ไพ่/หวย/บอล/คาสิโนไลฟ์สด/เครดิตฟรี ซึ่งบรีฟรอบนี้
// ไม่ได้ระบุสักคำ จึงถูกถอดออกทั้งหมด ไม่ใช่แค่แทนชื่อแบรนด์ทับ
//
// ลิงก์: PGW44 เป็นแบรนด์สล็อต ไม่ใช่เว็บหวย สองหน้าหมวดหวย (/ตรวจหวย, /แนวทาง)
// ถูกพักไว้ใน src/pages-disabled/ รอบนี้ ลิงก์ทั้งคู่จึงไม่มีในคอลัมน์ลิงก์ด่วน —
// ถ้าใส่ไว้ verify-build.mjs จะทำให้ build แดงเพราะ href ชี้ไป route ที่ไม่มีใน dist/
//
// /ทางเข้า ยังมีลิงก์อยู่ตรงนี้: หน้านั้นยัง route และ index อยู่ แค่ไม่มีใน
// เมนู navbar เพราะ toggle ของ register/login เปิด (ดู NavbarStyle8.astro)
//
// ปุ่มพื้นทองใช้ตัวอักษรสีเข้ม #10160a — พื้นทองสว่างกับตัวอักษรอ่อนอ่านไม่ออก
//
// บล็อก <address> ตั้งใจไม่ทาสีแบรนด์ — border-white/15 + bg-black/20 + opacity
// บนสีตัวอักษรที่ inherit มา ลงตัวกับ footer ทุกตัวในไลบรารี ห้าม retheme
---

<footer
  class="relative mt-32 w-full border-t border-[#fde90e]/50 bg-[#070d05] pt-64 pb-6 font-sans text-[#e9f0dd] shadow-[0_-10px_30px_rgba(253,233,14,0.16)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#fde90e]/70 bg-gradient-to-r from-[#0b1408] via-[#1f5a16] to-[#0b1408] p-6 shadow-[0_15px_40px_rgba(3,6,2,0.6)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#fff89a] uppercase italic drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)] md:text-3xl">
        <span aria-hidden="true">🎰</span> พร้อมเลือกค่ายสล็อตย่อยครบทุกแนวเกมกับ {BRAND_NAME} แล้วหรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#e9f0dd]/90 md:text-base">
        สมัคร {BRAND_NAME} ได้ด้วยตนเองทั้งบนมือถือและคอมพิวเตอร์ เลือกเกมจากค่ายสล็อตย่อยได้จากระบบเดียว ตรวจสอบระดับเดิมพันและรายละเอียดของแต่ละเกมก่อนเริ่มใช้งานได้จากหน้าเกมโดยตรง
        พร้อมโปรโมชั่นที่เปิดให้รับตามเงื่อนไขและรอบรับสิทธิ์ที่ระบบกำหนด
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#fde90e] bg-gradient-to-b from-[#fff89a] to-[#fde90e] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#10160a] shadow-[0_0_15px_rgba(253,233,14,0.45)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🚀</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#1f5a16] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[100, 200, 300]}
                sizes="100px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(253,233,14,0.55)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-r from-[#fde90e] via-[#f5c518] to-[#35d413] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(253,233,14,0.55)]">{BRAND_NAME}</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#e9f0dd]/75">
          {BRAND_NAME} รวบรวมค่ายสล็อตย่อยและเกมหลายแนวไว้ให้สมาชิกเลือกจากระบบเดียว ทั้งเกมคลาสสิก เกมโบนัส เกมธีมใหม่ และสล็อตที่อัปเดตตามช่วงเวลา เมนูจัดหมวดหมู่ชัดเจน
          ช่วยให้ค้นหาเกมที่สนใจได้สะดวกโดยไม่ต้องเปลี่ยนหลายเว็บไซต์ รองรับการใช้งานผ่านมือถือและคอมพิวเตอร์ ระดับเดิมพันและรูปแบบการเล่นของแต่ละเกมแตกต่างกัน
          จึงตรวจสอบรายละเอียดก่อนเริ่มใช้งานได้จากหน้าเกมโดยตรง พร้อมเจ้าหน้าที่ดูแลผ่านช่องทางไลน์ตลอด 24 ชั่วโมง
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/30 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.1)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>
        </div>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }
      </div>

      <nav aria-label="ลิงก์ด่วน" class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#fff89a] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#a86f02] to-[#fde90e] shadow-[0_0_8px_rgba(253,233,14,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          <a href="/" class="group flex items-center text-[#e9f0dd]/75 transition-colors hover:text-[#fff89a]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#35d413] transition-transform group-hover:rotate-45"></span> หน้าแรก
          </a>
          <a href="/promotion" class="group flex items-center text-[#e9f0dd]/75 transition-colors hover:text-[#fff89a]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#35d413] transition-transform group-hover:rotate-45"></span> โปรโมชั่นสมาชิก
          </a>
          <a href="/ทดลองเล่น" class="group flex items-center text-[#e9f0dd]/75 transition-colors hover:text-[#fff89a]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#35d413] transition-transform group-hover:rotate-45"></span> ทดลองเล่น
          </a>
          <a href="/ทางเข้า" class="group flex items-center text-[#e9f0dd]/75 transition-colors hover:text-[#fff89a]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#35d413] transition-transform group-hover:rotate-45"></span> ทางเข้าล่าสุด
          </a>
          <a href="/about-us" class="group flex items-center text-[#e9f0dd]/75 transition-colors hover:text-[#fff89a]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#35d413] transition-transform group-hover:rotate-45"></span> เกี่ยวกับเรา
          </a>
          <a href="/register" class="group flex items-center text-[#e9f0dd]/75 transition-colors hover:text-[#fff89a]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#35d413] transition-transform group-hover:rotate-45"></span> สมัครสมาชิก
          </a>
          <a href="/login" class="group flex items-center text-[#e9f0dd]/75 transition-colors hover:text-[#fff89a]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#35d413] transition-transform group-hover:rotate-45"></span> เข้าสู่ระบบ
          </a>
          <a href="/contact-us" class="group flex items-center text-[#e9f0dd]/75 transition-colors hover:text-[#fff89a]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#35d413] transition-transform group-hover:rotate-45"></span> ติดต่อเจ้าหน้าที่
          </a>
        </div>
      </nav>

      <section aria-label="ระบบการเงิน" class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#fff89a] uppercase">
          ระบบการเงิน
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#a86f02] to-[#fde90e] shadow-[0_0_8px_rgba(253,233,14,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#e9f0dd]/75">รองรับช่องทางที่กำหนดไว้ภายในเว็บไซต์ โดยควรใช้บัญชีชื่อเดียวกับข้อมูลที่ผูกไว้ตอนสมัคร</p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-[#a86f02]/40 bg-[#0b1408] transition-colors hover:border-[#fde90e]/60">
          <span class="flex items-center gap-1 text-xs font-bold text-[#e9f0dd]"><span aria-hidden="true" class="text-lg text-[#fde90e]">🧾</span> ตรวจสอบสถานะรายการได้ในบัญชีสมาชิก</span>
        </div>
      </section>
    </div>

    <hr class="mb-6 border-[#101a0b]" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#e9f0dd]/70 md:block">
      {BRAND_NAME} เป็นช่องทางสำหรับผู้ที่ต้องการเข้าเล่นเกมสล็อตออนไลน์จากค่ายย่อยหลายค่ายผ่านบัญชีเดียว ทั้งเกมคลาสสิก เกมโบนัส เกมธีมใหม่ และสล็อตที่อัปเดตตามช่วงเวลา
      โดยจัดหมวดหมู่ไว้เพื่อให้สมาชิกค้นหาและสลับค่ายได้สะดวกโดยไม่ต้องเปลี่ยนหลายเว็บไซต์ รายการเกมและค่ายที่เปิดให้บริการอาจมีการอัปเดตตามช่วงเวลา
      เนื่องจากแต่ละค่ายกำหนดเงื่อนไขและช่วงเวลาให้บริการไม่เท่ากัน ผลของเกมแต่ละรอบเป็นไปตามระบบของผู้ให้บริการรายนั้น จึงไม่สามารถรับประกันผลการเดิมพันใด ๆ ได้
      ข้อมูลที่แสดงบนหน้าเว็บเป็นข้อมูลประกอบการตัดสินใจเท่านั้น ไม่ใช่การทำนายผล ระดับเดิมพันและรูปแบบการเล่นของแต่ละเกมแตกต่างกัน ให้ยึดค่าที่ระบบแสดง ณ เวลาทำรายการ
      ส่วนโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% เป็นไปตามเงื่อนไข ยอดที่เข้าเกณฑ์ และรอบคำนวณของรายการที่เว็บไซต์ระบุ ควรอ่านรายละเอียดก่อนกดรับสิทธิ์ทุกครั้ง
      ช่องทางที่เปิดรองรับก็เช่นกัน ควรตรวจสอบจากหน้าที่เกี่ยวข้องก่อนทำรายการ ก่อนเข้าสู่ระบบควรตรวจสอบว่ากำลังใช้งานช่องทางของผู้ให้บริการที่ถูกต้อง ตั้งรหัสผ่านที่คาดเดายาก
      และไม่เปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น ใช้งานได้ทั้งบนมือถือและคอมพิวเตอร์ผ่านเบราว์เซอร์ พร้อมเจ้าหน้าที่ {BRAND_NAME} ดูแลผ่านช่องทางไลน์ตลอด 24 ชั่วโมง
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-[#a86f02]/40 pt-6 text-xs text-[#e9f0dd]/75 md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-[#fff89a] uppercase">{BRAND_NAME}</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/terms/" class="transition-colors hover:text-[#fff89a]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#fff89a]">นโยบายความเป็นส่วนตัว</a>

        <a
          href="#top"
          class="flex h-8 w-8 items-center justify-center rounded border border-[#a86f02]/50 bg-[#0b1408] text-[#e9f0dd] transition-all hover:border-[#fde90e] hover:bg-[#101a0b] hover:shadow-[0_0_15px_rgba(253,233,14,0.55)]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
