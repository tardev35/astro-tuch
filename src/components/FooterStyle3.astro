---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt =
  "โลโก้ หวยเฮง24 ตัวอักษรไทยหนาแบบสามมิติบนพื้นโปร่งใส คำว่า หวย เป็นสีแดงเลือดนกเงาวาวขอบทอง ส่วนคำว่า เฮง24 เป็นสีทองไล่เฉดวาว";

// หวยเฮง24 (รอบแดงเข้ม-ทอง 2026-10-01): footer ที่ใช้งานจริงรอบนี้ —
// รอบก่อน หวยเต็ง ใช้ FooterStyle2 จึงหมุนมาที่ไฟล์นี้ ของเดิมที่ค้างอยู่ในไฟล์
// เป็นเขียวนีออน-โครเมียมของ CK268 ย้ายทั้งไฟล์มาเป็นแดงเข้ม-ทองตามโลโก้จริงแล้ว
//
// แกนสีที่ใช้: พื้นแดงเกือบดำ #1a0505 ยกระดับด้วย #2e0707 / #3d0808 ·
// ทองแบรนด์ #e0a52a เป็นเส้นคั่น จุดนำลิงก์ และขอบการ์ด · ทองอ่อน #fdea83
// สงวนไว้ให้หัวคอลัมน์ ชื่อแบรนด์ และปุ่มสมัคร · แดงแบรนด์ #8b0302 กับแดงสว่าง
// #c01616 เป็นปลายเกรเดียนต์คู่กับทอง ตามโลโก้ที่คำว่า "หวย" เป็นแดงเลือดนกขอบทอง
// และ "เฮง24" เป็นทองไล่เฉด · ทองลึก #a46304 เป็นเส้นคั่นจาง · เนื้อความ #f6e6cf
// (BRAND_TEXT ของรอบนี้) ลดน้ำหนักด้วย opacity
//
// คอปปี้ทั้งไฟล์เขียนใหม่จากบรีฟ หวยเฮง24 ซึ่งเป็น **เว็บเล่นหวยออนไลน์ล้วน** —
// บรีฟรอบนี้พูดเรื่องหวยลาว ฮานอย รัฐบาลไทย หวยหุ้น ในบัญชีเดียว เลือกเลข/ส่งโพย/
// เช็คผลหลังประกาศผล อัตรา 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท สมัคร
// 3 ขั้นตอน ฝากถอนผ่านวอลเลทและธนาคาร และแอดมิน 24 ชั่วโมงเท่านั้น ไม่ได้ระบุ
// ใบอนุญาต ผู้ให้บริการ ชื่อธนาคาร หรือยอดขั้นต่ำใดเป็นชื่อๆ จึงไม่มีในข้อความนี้
// และไม่ได้แทนชื่อแบรนด์ทับประโยคสล็อตของ CK268 — เขียนใหม่ทั้งหมดจากบรีฟ
//
// ลิงก์: หวยเฮง24 เป็นเว็บหวย สองหน้าหมวดหวย (/ตรวจหวย, /แนวทาง) ถูกย้ายกลับมา
// อยู่ใน src/pages/ รอบนี้ ทั้งคู่จึงมีลิงก์ในคอลัมน์ลิงก์ด่วน
//
// /ทางเข้า ยังมีลิงก์อยู่ตรงนี้: หน้านั้นยัง route และ index อยู่ แค่ไม่มีใน
// เมนู navbar เพราะ toggle ของ register/login เปิด (ดู NavbarStyle6.astro)
//
// ปุ่มพื้นทองใช้ตัวอักษรสีเข้ม #2a0606 — พื้นทองสว่างกับตัวอักษรอ่อนอ่านไม่ออก
//
// บล็อก <address> ตั้งใจไม่ทาสีแบรนด์ — border-white/15 + bg-black/20 + opacity
// บนสีตัวอักษรที่ inherit มา ลงตัวกับ footer ทุกตัวในไลบรารี ห้าม retheme
---

<footer
  class="relative mt-32 w-full border-t border-[#e0a52a]/50 bg-[#1a0505] pt-64 pb-6 font-sans text-[#f6e6cf] shadow-[0_-10px_30px_rgba(224,165,42,0.16)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#e0a52a]/70 bg-gradient-to-r from-[#2e0707] via-[#3d0808] to-[#2e0707] p-6 shadow-[0_15px_40px_rgba(20,3,3,0.6)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#fdea83] uppercase italic drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)] md:text-3xl">
        <span aria-hidden="true">🎯</span> พร้อมเลือกเลขและส่งโพยกับ {BRAND_NAME} แล้วหรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#f6e6cf]/90 md:text-base">
        สมัคร {BRAND_NAME} ได้ด้วยตนเองทั้งบนมือถือและคอมพิวเตอร์ เลือกหวยลาว หวยฮานอย หวยรัฐบาลไทย และหวยหุ้นได้จากบัญชีเดียว
        ตรวจสอบเวลาเปิดรับ เวลาปิดรับ และอัตราจ่ายของแต่ละรายการก่อนเลือกเลขได้จากหน้าเว็บไซต์โดยตรง พร้อมกลับมาเช็คผลและสถานะโพยได้หลังประกาศผลของรอบนั้น
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#bd7c13] bg-gradient-to-b from-[#fdea83] to-[#e0a52a] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#2a0606] shadow-[0_0_15px_rgba(224,165,42,0.45)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🚀</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#3d0808] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[100, 200, 300]}
                sizes="100px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(224,165,42,0.55)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-r from-[#fdea83] via-[#e0a52a] to-[#c01616] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(224,165,42,0.55)]">{BRAND_NAME}</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#f6e6cf]/75">
          {BRAND_NAME} เว็บเล่นหวยออนไลน์ที่รวมรายการยอดนิยมไว้ให้เลือกในบัญชีเดียว ทั้งหวยลาวตามรายการที่เปิดรับ หวยฮานอยหลายรอบ หวยรัฐบาลไทยตามกำหนดออกรางวัล
          และหวยหุ้นตามตลาดที่ระบบรองรับ สมาชิกสามารถเลือกเลข ส่งโพย ตรวจสอบรายการ และเช็คผลหลังประกาศผลของแต่ละรอบได้จากหน้าเว็บไซต์ รองรับการเข้าใช้งานผ่านมือถือ
          พร้อมช่องทางฝากถอนผ่านวอลเลทและธนาคารที่ระบบรองรับ ช่วยให้จัดการตั้งแต่เลือกหวยไปจนถึงตรวจผลได้สะดวกในที่เดียว โดยควรตรวจสอบเวลาปิดรับและอัตราจ่ายของแต่ละรายการก่อนส่งโพยทุกครั้ง
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/30 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.1)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>
        </div>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }
      </div>

      <nav aria-label="ลิงก์ด่วน" class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#fdea83] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#c01616] to-[#e0a52a] shadow-[0_0_8px_rgba(224,165,42,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          <a href="/" class="group flex items-center text-[#f6e6cf]/75 transition-colors hover:text-[#fdea83]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#e0a52a] transition-transform group-hover:rotate-45"></span> หน้าแรก
          </a>
          <a href="/promotion" class="group flex items-center text-[#f6e6cf]/75 transition-colors hover:text-[#fdea83]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#e0a52a] transition-transform group-hover:rotate-45"></span> โปรโมชั่นสมาชิก
          </a>
          <a href="/ตรวจหวย" class="group flex items-center text-[#f6e6cf]/75 transition-colors hover:text-[#fdea83]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#e0a52a] transition-transform group-hover:rotate-45"></span> ตรวจผลหวย
          </a>
          <a href="/แนวทาง" class="group flex items-center text-[#f6e6cf]/75 transition-colors hover:text-[#fdea83]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#e0a52a] transition-transform group-hover:rotate-45"></span> แนวทางหวย
          </a>
          <a href="/ทดลองเล่น" class="group flex items-center text-[#f6e6cf]/75 transition-colors hover:text-[#fdea83]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#e0a52a] transition-transform group-hover:rotate-45"></span> ทดลองเล่น
          </a>
          <a href="/ทางเข้า" class="group flex items-center text-[#f6e6cf]/75 transition-colors hover:text-[#fdea83]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#e0a52a] transition-transform group-hover:rotate-45"></span> ทางเข้าล่าสุด
          </a>
          <a href="/register" class="group flex items-center text-[#f6e6cf]/75 transition-colors hover:text-[#fdea83]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#e0a52a] transition-transform group-hover:rotate-45"></span> สมัครสมาชิก
          </a>
          <a href="/login" class="group flex items-center text-[#f6e6cf]/75 transition-colors hover:text-[#fdea83]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#e0a52a] transition-transform group-hover:rotate-45"></span> เข้าสู่ระบบ
          </a>
          <a href="/about-us" class="group flex items-center text-[#f6e6cf]/75 transition-colors hover:text-[#fdea83]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#e0a52a] transition-transform group-hover:rotate-45"></span> เกี่ยวกับเรา
          </a>
          <a href="/contact-us" class="group flex items-center text-[#f6e6cf]/75 transition-colors hover:text-[#fdea83]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#e0a52a] transition-transform group-hover:rotate-45"></span> ติดต่อเจ้าหน้าที่
          </a>
        </div>
      </nav>

      <section aria-label="ระบบการเงิน" class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#fdea83] uppercase">
          ระบบการเงิน
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#c01616] to-[#e0a52a] shadow-[0_0_8px_rgba(224,165,42,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#f6e6cf]/75">รองรับการฝากถอนผ่านวอลเลทและธนาคารตามช่องทางที่ระบบกำหนด โดยควรใช้บัญชีชื่อเดียวกับข้อมูลที่ผูกไว้ตอนสมัคร</p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-[#a46304]/40 bg-[#2e0707] transition-colors hover:border-[#e0a52a]/60">
          <span class="flex items-center gap-1 text-xs font-bold text-[#f6e6cf]"><span aria-hidden="true" class="text-lg text-[#e0a52a]">🧾</span> ตรวจสอบโพยและสถานะรายการได้ในบัญชีสมาชิก</span>
        </div>
      </section>
    </div>

    <hr class="mb-6 border-[#3d0808]" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#f6e6cf]/70 md:block">
      {BRAND_NAME} เป็นช่องทางสำหรับผู้ที่ต้องการเล่นหวยออนไลน์โดยรวมรายการยอดนิยมไว้ให้เลือกในบัญชีเดียว ทั้งหวยลาวตามรายการที่เปิดรับ หวยฮานอยหลายรอบ
      หวยรัฐบาลไทยตามกำหนดออกรางวัล และหวยหุ้นตามตลาดที่ระบบรองรับ โดยสามารถตรวจสอบเวลาเปิดรับ เวลาปิดรับ และอัตราจ่ายของแต่ละรายการได้จากหน้าเว็บไซต์ก่อนเลือกเลข
      จำนวนรายการและรอบที่เปิดรับในแต่ละวันขึ้นอยู่กับประกาศของหวยแต่ละประเภท จึงอาจไม่เท่ากันทุกวัน
      อัตรา 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท ใช้กับรายการที่เข้าเงื่อนไขตามประเภทหวยและรูปแบบการแทงที่ระบบเปิดรับ ไม่ควรถือว่าใช้กับทุกรายการโดยอัตโนมัติ
      ให้ยึดอัตราที่แสดงในหน้าส่งโพย ณ เวลาทำรายการเป็นหลัก หลังส่งโพยควรตรวจสอบชื่อหวย รอบเวลา เลขที่เลือก และยอดเดิมพันให้ถูกต้องทุกครั้ง
      เมื่อมีการประกาศผลสามารถกลับมาเช็คผลและสถานะโพยผ่านบัญชีสมาชิกได้ โดยระยะเวลาอัปเดตอาจแตกต่างกันตามหวยแต่ละประเภท และผลรางวัลควรอ้างอิงข้อมูลอย่างเป็นทางการของหวยประเภทนั้นประกอบด้วย
      ก่อนเข้าสู่ระบบควรตรวจสอบว่ากำลังใช้งานช่องทางของผู้ให้บริการที่ถูกต้อง ใช้ข้อมูลของตนเองในการสมัคร ตั้งรหัสผ่านที่คาดเดายาก และไม่เปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น
      ส่วนปัญหาด้านฝากถอนควรเตรียมเวลา จำนวนเงิน และหลักฐานธุรกรรมไว้จนกว่าจะตรวจสอบเสร็จ ใช้งานได้ทั้งบนมือถือ แท็บเล็ต และคอมพิวเตอร์ผ่านเบราว์เซอร์
      พร้อมเจ้าหน้าที่ {BRAND_NAME} ดูแลผ่านช่องทางไลน์ตลอด 24 ชั่วโมง
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-[#a46304]/40 pt-6 text-xs text-[#f6e6cf]/75 md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-[#fdea83] uppercase">{BRAND_NAME}</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/terms/" class="transition-colors hover:text-[#fdea83]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#fdea83]">นโยบายความเป็นส่วนตัว</a>

        <a
          href="#top"
          class="flex h-8 w-8 items-center justify-center rounded border border-[#a46304]/50 bg-[#2e0707] text-[#f6e6cf] transition-all hover:border-[#e0a52a] hover:bg-[#3d0808] hover:shadow-[0_0_15px_rgba(224,165,42,0.55)]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
