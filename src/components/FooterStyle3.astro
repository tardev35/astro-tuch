---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt = "โลโก้ KINGDOM66 ตัวอักษรภาษาอังกฤษหนาสีทองสลักนูนเป็นเงาวาว คำว่า KINGDOM ไล่เฉดทองอ่อนไปทองเข้ม ส่วนเลข 66 ด้านท้ายเป็นทองสว่างเต็มตัว บนพื้นหลังโปร่งใส";

// KINGDOM66 (รอบทอง-ดำ 2026-09-25): footer ที่ใช้งานจริงรอบนี้ (รอบก่อน UWIN33
// ใช้ FooterPremiumSumo) ของเดิมที่ค้างอยู่ในไฟล์เป็นพาเลตต์ทอง-เขียว-แดงของ
// 888PARUAY ย้ายทั้งไฟล์มาเป็นทอง-ดำตามโลโก้จริงแล้ว ไม่เหลือเฉดเขียวเดิมอีก
//
// แกนสีที่ใช้: พื้นเกือบดำ #0c0b09 (สีหลักที่วัดได้จากแบนเนอร์) ยกระดับด้วย
// #151109 / #241c13 / #3c2b15 · ทองแบรนด์ #e6bf4e เป็นเส้นคั่น จุดนำลิงก์ และ
// ขอบการ์ด · ทองอ่อน #f5e196 สงวนไว้ให้หัวคอลัมน์ ชื่อแบรนด์ และปุ่มสมัคร ·
// ทองลึก #8a6420 เป็นปลายเกรเดียนต์ · เนื้อความ #ebe3d3 (BRAND_TEXT ของรอบนี้)
// ลดน้ำหนักด้วย opacity แทนการคิดสีเทาขึ้นมาใหม่
//
// ลิงก์: KINGDOM66 เป็นแบรนด์คาสิโนรวมเกม ไม่ใช่เว็บหวยโดยตรง สองหน้าหมวดหวย
// (/ตรวจหวย, /แนวทาง) ถูกพักไว้ใน src/pages-disabled/ รอบนี้ ลิงก์ทั้งคู่จึงถูก
// ถอดออกจากคอลัมน์ลิงก์ด่วน — ถ้าปล่อยไว้ verify-build.mjs จะทำให้ build แดง
// เพราะ href ชี้ไป route ที่ไม่มีอยู่จริงใน dist/
//
// /ทางเข้า ยังมีลิงก์อยู่ตรงนี้: หน้านั้นยัง route และ index อยู่ แค่ไม่มีใน
// เมนู navbar เพราะ toggle ของ register/login เปิด (ดู NavbarStyle8.astro)
//
// ปุ่มพื้นทองใช้ตัวอักษรสีเข้ม #0c0b09 — พื้นทองสว่างกับตัวอักษรอ่อนอ่านไม่ออก
//
// บล็อก <address> ตั้งใจไม่ทาสีแบรนด์ — border-white/15 + bg-black/20 + opacity
// บนสีตัวอักษรที่ inherit มา ลงตัวกับ footer ทุกตัวในไลบรารี ห้าม retheme
---

<footer
  class="relative mt-32 w-full border-t border-[#e6bf4e]/50 bg-[#0c0b09] pt-64 pb-6 font-sans text-[#ebe3d3] shadow-[0_-10px_30px_rgba(230,191,78,0.16)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#e6bf4e]/70 bg-gradient-to-r from-[#151109] via-[#3c2b15] to-[#151109] p-6 shadow-[0_15px_40px_rgba(5,4,3,0.6)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#f5e196] uppercase italic drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)] md:text-3xl">
        <span aria-hidden="true">👑</span> พร้อมเล่นบาคาร่า ไพ่ สล็อต หวย บอล และคาสิโนไลฟ์สดกับ {BRAND_NAME} แล้วหรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#ebe3d3]/90 md:text-base">
        สมัคร {BRAND_NAME} ได้ด้วยตนเองทั้งบนมือถือและคอมพิวเตอร์ เลือกหมวดเกมที่สนใจจากบัญชีเดียว ตรวจสอบค่ายที่ให้บริการและรูปแบบเดิมพันก่อนเข้าเล่นได้จากหน้าเดียว
        พร้อมสิทธิ์เครดิตฟรีและโปรโมชั่นตามเงื่อนไขที่กำหนด
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#e6bf4e] bg-gradient-to-b from-[#f5e196] to-[#e6bf4e] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#0c0b09] shadow-[0_0_15px_rgba(230,191,78,0.45)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🚀</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#3c2b15] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[100, 200, 300]}
                sizes="100px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(230,191,78,0.55)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-b from-[#f5e196] to-[#e6bf4e] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(230,191,78,0.55)]">{BRAND_NAME}</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#ebe3d3]/75">
          {BRAND_NAME} คือแหล่งรวมเกมคาสิโนหลายรูปแบบไว้ในระบบเดียว ทั้งบาคาร่า ไพ่ สล็อต หวย บอล และเกมไลฟ์สดจากผู้ให้บริการต่างประเทศตามรายการที่เปิดให้บริการ
          ระบบจัดหมวดหมู่ไว้ให้ค้นหาได้ง่าย สมาชิกจึงเลือกหมวดเกมที่สนใจ ตรวจสอบรายละเอียดเกม ค่ายที่ให้บริการ และรูปแบบเดิมพันก่อนเข้าเล่นได้จากหน้าเดียว
          พร้อมสิทธิ์เครดิตฟรีและโปรโมชั่นตามเงื่อนไขที่กำหนด ใช้งานได้ทั้งบนมือถือและคอมพิวเตอร์ผ่านเบราว์เซอร์โดยไม่ต้องติดตั้งโปรแกรมเพิ่ม พร้อมแอดมินคอยให้บริการตลอด 24 ชั่วโมง
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/30 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.1)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>
        </div>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }
      </div>

      <nav aria-label="ลิงก์ด่วน" class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#f5e196] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#8a6420] to-[#e6bf4e] shadow-[0_0_8px_rgba(230,191,78,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          <a href="/" class="group flex items-center text-[#ebe3d3]/75 transition-colors hover:text-[#f5e196]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#e6bf4e] transition-transform group-hover:rotate-45"></span> หน้าแรก
          </a>
          <a href="/promotion" class="group flex items-center text-[#ebe3d3]/75 transition-colors hover:text-[#f5e196]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#e6bf4e] transition-transform group-hover:rotate-45"></span> โปรโมชั่นสมาชิก
          </a>
          <a href="/ทดลองเล่น" class="group flex items-center text-[#ebe3d3]/75 transition-colors hover:text-[#f5e196]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#e6bf4e] transition-transform group-hover:rotate-45"></span> ทดลองเล่น
          </a>
          <a href="/ทางเข้า" class="group flex items-center text-[#ebe3d3]/75 transition-colors hover:text-[#f5e196]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#e6bf4e] transition-transform group-hover:rotate-45"></span> ทางเข้าล่าสุด
          </a>
          <a href="/about-us" class="group flex items-center text-[#ebe3d3]/75 transition-colors hover:text-[#f5e196]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#e6bf4e] transition-transform group-hover:rotate-45"></span> เกี่ยวกับเรา
          </a>
          <a href="/register" class="group flex items-center text-[#ebe3d3]/75 transition-colors hover:text-[#f5e196]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#e6bf4e] transition-transform group-hover:rotate-45"></span> สมัครสมาชิก
          </a>
          <a href="/login" class="group flex items-center text-[#ebe3d3]/75 transition-colors hover:text-[#f5e196]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#e6bf4e] transition-transform group-hover:rotate-45"></span> เข้าสู่ระบบ
          </a>
          <a href="/contact-us" class="group flex items-center text-[#ebe3d3]/75 transition-colors hover:text-[#f5e196]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#e6bf4e] transition-transform group-hover:rotate-45"></span> ติดต่อแอดมิน
          </a>
        </div>
      </nav>

      <section aria-label="ระบบการเงิน" class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#f5e196] uppercase">
          ระบบการเงิน
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#8a6420] to-[#e6bf4e] shadow-[0_0_8px_rgba(230,191,78,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#ebe3d3]/75">รองรับช่องทางธนาคารและวอลเลทที่กำหนดไว้ภายในเว็บไซต์ โดยควรใช้บัญชีชื่อเดียวกับข้อมูลที่ผูกไว้ตอนสมัคร</p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-[#8a6420]/40 bg-[#151109] transition-colors hover:border-[#e6bf4e]/60">
          <span class="flex items-center gap-1 text-xs font-bold text-[#ebe3d3]"><span aria-hidden="true" class="text-lg text-[#e6bf4e]">🧾</span> ตรวจสอบสถานะธุรกรรมได้ในบัญชีสมาชิก</span>
        </div>
      </section>
    </div>

    <hr class="mb-6 border-[#241c13]" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#ebe3d3]/70 md:block">
      {BRAND_NAME} เป็นช่องทางสำหรับผู้ที่ต้องการเข้าเล่นเกมคาสิโนออนไลน์ผ่านบัญชีเดียว ทั้งบาคาร่า ไพ่ สล็อต หวย บอล และเกมไลฟ์สดจากผู้ให้บริการต่างประเทศ โดยจัดหมวดหมู่ไว้เพื่อให้สมาชิกค้นหาและสลับหมวดเกมได้สะดวก
      สำหรับคำว่า “ครบทุกแบรนด์ดัง” และ “ส่งตรงจากบริษัทต่างประเทศ” ควรยึดข้อมูลผู้ให้บริการหรือรายละเอียดที่สามารถตรวจสอบได้บนเว็บไซต์เป็นหลัก
      รายการเกมและค่ายที่เปิดให้บริการอาจมีการอัปเดตตามช่วงเวลา เนื่องจากแต่ละค่ายกำหนดเงื่อนไขและช่วงเวลาให้บริการไม่เท่ากัน ผลของเกมแต่ละรอบเป็นไปตามระบบของผู้ให้บริการรายนั้น
      จึงไม่สามารถรับประกันผลการเดิมพันใด ๆ ได้ ข้อมูลอัตราจ่ายหรือสถิติที่แสดงบนหน้าเว็บเป็นข้อมูลประกอบการตัดสินใจเท่านั้น ไม่ใช่การทำนายผล
      กติกา อัตราจ่าย ยอดขั้นต่ำและสูงสุดต่อรอบ ให้ยึดค่าที่ระบบแสดง ณ เวลาทำรายการ ส่วนโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% เป็นไปตามเงื่อนไขและรอบคำนวณของรายการที่เว็บไซต์ระบุ
      ช่องทางธนาคารและวอลเลทที่เปิดรองรับก็เช่นกัน ควรตรวจสอบจากหน้าฝากถอนก่อนทำรายการ เนื่องจากช่องทางแต่ละประเภทอาจกำหนดยอดขั้นต่ำ วงเงิน หรือเงื่อนไขแตกต่างกัน
      ก่อน Login หรือทำรายการฝากเงิน ควรตรวจสอบว่ากำลังใช้งานช่องทางของผู้ให้บริการที่ถูกต้อง ตั้งรหัสผ่านที่คาดเดายาก และไม่เปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      ควรอ่านเงื่อนไขของแต่ละโปรโมชั่นก่อนกดรับทุกครั้ง ใช้งานได้ทั้ง Android iOS และคอมพิวเตอร์ผ่านเบราว์เซอร์โดยไม่ต้องติดตั้งโปรแกรมเพิ่ม พร้อมแอดมิน {BRAND_NAME} ตรวจสอบรายการให้ตลอด 24 ชั่วโมง
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-[#8a6420]/40 pt-6 text-xs text-[#ebe3d3]/75 md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-[#f5e196] uppercase">{BRAND_NAME}</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/terms/" class="transition-colors hover:text-[#f5e196]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#f5e196]">นโยบายความเป็นส่วนตัว</a>

        <a
          href="#top"
          class="flex h-8 w-8 items-center justify-center rounded border border-[#8a6420]/50 bg-[#151109] text-[#ebe3d3] transition-all hover:border-[#e6bf4e] hover:bg-[#241c13] hover:shadow-[0_0_15px_rgba(230,191,78,0.55)]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
