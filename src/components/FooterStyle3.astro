---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt =
  "โลโก้ DM899 บนพื้นโปร่งใส ด้านซ้ายเป็นวงโค้งครึ่งวงกลมสีเขียวตัดแดง มีตัวอักษร D สีเขียวสามมิติซ้อนทับตัว M สีแดงอยู่ตรงกลาง ถัดมาเป็นคำว่า DM ตัวหนาสามมิติ โดย D เป็นสีเขียวและ M เป็นสีแดง ปิดท้ายด้วยเลข 899 ตัวหนาสามมิติสีเงินโครเมียมไล่แสง";

// DM899 (รอบเขียวมรกต-แดงสด-ทอง บนดำอมเขียว 2026-10-03): footer ที่ใช้งานจริง
// รอบนี้ — รอบก่อน 1SS365 ใช้ FooterPremiumSumo จึงหมุนมาที่ไฟล์นี้ ของเดิมที่ค้าง
// อยู่ในไฟล์เป็นทอง-เงิน-ดำของ NATO168 (#070707 #101010 #17120a #241a09 #edb543
// #fde8a8 #e6e6e6 #a9761f #f4ead3 #3a2a0d #1a1203 #b8832a) ย้ายทั้งไฟล์มาเป็น
// เขียว-แดง-ทองบนดำอมเขียวตามโลโก้จริงแล้ว ไม่เหลือทอง-เงินชุดเดิมเลย
//
// แกนสีที่ใช้: พื้นดำอมเขียว #030a05 ยกระดับด้วย #0a1a0e / #102a16 · เขียวแบรนด์
// #01a326 เป็นเส้นคั่น จุดนำลิงก์ และขอบการ์ด · เขียวสว่าง #12c23a เป็นปลาย
// ไล่เฉดด้านสว่าง · แดงแบรนด์ #fb252b เป็นฮิวที่สอง อยู่ปลายไล่เฉดและเส้นใต้
// หัวคอลัมน์ (ตามโลโก้ที่ตัว D เขียวและตัว M แดง) · ทองอ่อน #ffe9a8 กับทองแบรนด์
// #f2b422 สงวนไว้ให้หัวคอลัมน์ ชื่อแบรนด์ และปุ่มสมัคร · เนื้อความ #e4f2e4
// (BRAND_TEXT ของรอบนี้) ลดน้ำหนักด้วย opacity
//
// คอปปี้ทั้งไฟล์เขียนใหม่จากบรีฟ DM899 ซึ่งเป็น **เว็บสล็อตคาสิโนเว็บตรงต่างประเทศ**
// บรีฟรอบนี้พูดเรื่องเกมสล็อต คาสิโนสด บัญชีบริษัทแท้ 100% ระบบเกมมาตรฐาน
// คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% สมัคร 3 ขั้นตอน และแอดมิน 24 ชั่วโมงเท่านั้น
// ไม่ได้ระบุใบอนุญาต ผู้ให้บริการ ชื่อค่ายเกม ชื่อธนาคาร ยอดขั้นต่ำ หรือค่า RTP
// ใดเป็นชื่อๆ จึงไม่มีในข้อความนี้ และประโยคกำกับของบรีฟเอง (คำว่าบัญชีบริษัทแท้
// 100% กับการันตีระบบเกมมาตรฐานควรมีข้อมูลที่ตรวจสอบได้รองรับ) ขนมาด้วย ไม่ตัดทิ้ง
//
// ลิงก์: DM899 เป็นแบรนด์สล็อตคาสิโน ไม่ใช่เว็บหวย — /ตรวจหวย กับ /แนวทาง ถูกพักไว้
// ใน src/pages-disabled/ รอบนี้ ไม่มีลิงก์ทั้งสองตัวในคอลัมน์ลิงก์ด่วน ถ้าเพิ่มเข้ามา
// verify-build.mjs จะทำให้ build แดงเพราะ href ชี้ไป route ที่ไม่มีจริงใน dist/
//
// /ทางเข้า ยังมีลิงก์อยู่ตรงนี้: หน้านั้นยัง route และ index อยู่ แค่ไม่มีใน
// เมนู navbar เพราะ toggle ของ register/login เปิด (ดู NavbarStyle9.astro)
//
// ปุ่มพื้นทองใช้ตัวอักษรหมึกเข้ม #06140a — พื้นทองสว่างกับตัวอักษรอ่อนอ่านไม่ออก
// (#06140a บน #ffe9a8 = 15.7:1 · บน #f2b422 = 10.2:1 ผ่าน AA ทั้งคู่)
//
// บล็อก <address> ตั้งใจไม่ทาสีแบรนด์ — border-white/15 + bg-black/20 + opacity
// บนสีตัวอักษรที่ inherit มา ลงตัวกับ footer ทุกตัวในไลบรารี ห้าม retheme
---

<footer
  class="relative mt-32 w-full border-t border-[#01a326]/55 bg-[#030a05] pt-64 pb-6 font-sans text-[#e4f2e4] shadow-[0_-10px_30px_rgba(1,163,38,0.18)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#01a326]/70 bg-gradient-to-r from-[#0a1a0e] via-[#102a16] to-[#0a1a0e] p-6 shadow-[0_15px_40px_rgba(0,0,0,0.7)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#ffe9a8] uppercase italic drop-shadow-[0_2px_4px_rgba(0,0,0,0.6)] md:text-3xl">
        <span aria-hidden="true">🎰</span> พร้อมเข้าเล่นเกมกับ {BRAND_NAME} แล้วหรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#e4f2e4]/90 md:text-base">
        สมัคร {BRAND_NAME} ได้ด้วยตนเองทั้งบนมือถือและคอมพิวเตอร์ เลือกได้ทั้งเกมสล็อต เกมคาสิโนสด และหมวดเกมอื่นตามผู้ให้บริการที่เชื่อมต่อกับระบบ จากบัญชีเดียว
        พร้อมตรวจสอบเครดิต โปรโมชั่น และประวัติรายการได้ก่อนเริ่มเดิมพัน
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#a8780f] bg-gradient-to-b from-[#ffe9a8] to-[#f2b422] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#06140a] shadow-[0_0_15px_rgba(242,180,34,0.45)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🚀</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#102a16] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[100, 200, 300]}
                sizes="100px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(1,163,38,0.6)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-r from-[#4ade6b] via-[#ffe9a8] to-[#fb252b] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(1,163,38,0.6)]">{BRAND_NAME}</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#e4f2e4]/75">
          {BRAND_NAME} เป็นสล็อตคาสิโนเว็บตรงต่างประเทศที่รวบรวมเกมเดิมพันหลายรูปแบบไว้ในระบบเดียว มีทั้งเกมสล็อต เกมคาสิโนสด และหมวดเกมอื่นตามผู้ให้บริการที่เชื่อมต่อกับระบบ
          รองรับการเข้าเล่นผ่านเว็บเบราว์เซอร์บนมือถือ สมาชิกสามารถเลือกเกม สลับหมวด ตรวจสอบเครดิต โปรโมชั่น และดูประวัติรายการได้จากบัญชีเดียวโดยไม่ต้องสมัครแยกตามค่าย
          ส่วนคำว่าบัญชีบริษัทแท้ 100% และการันตีระบบเกมมาตรฐาน ควรมีชื่อนิติบุคคล มาตรฐาน หรือหน่วยงานที่ตรวจสอบได้รองรับก่อนนำมาใช้ยืนยันด้านความปลอดภัย
          เพราะการเป็นแพลตฟอร์มต่างประเทศไม่ได้ยืนยันมาตรฐานของระบบโดยอัตโนมัติ
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/40 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.12)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>
        </div>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }
      </div>

      <nav aria-label="ลิงก์ด่วน" class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#ffe9a8] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#12c23a] to-[#fb252b] shadow-[0_0_8px_rgba(1,163,38,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          <a href="/" class="group flex items-center text-[#e4f2e4]/75 transition-colors hover:text-[#ffe9a8]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#12c23a] transition-transform group-hover:rotate-45"></span> หน้าแรก
          </a>
          <a href="/promotion" class="group flex items-center text-[#e4f2e4]/75 transition-colors hover:text-[#ffe9a8]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#12c23a] transition-transform group-hover:rotate-45"></span> โปรโมชั่นสมาชิก
          </a>
          <a href="/ทดลองเล่น" class="group flex items-center text-[#e4f2e4]/75 transition-colors hover:text-[#ffe9a8]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#12c23a] transition-transform group-hover:rotate-45"></span> ทดลองเล่น
          </a>
          <a href="/ทางเข้า" class="group flex items-center text-[#e4f2e4]/75 transition-colors hover:text-[#ffe9a8]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#12c23a] transition-transform group-hover:rotate-45"></span> ทางเข้าล่าสุด
          </a>
          <a href="/register" class="group flex items-center text-[#e4f2e4]/75 transition-colors hover:text-[#ffe9a8]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#12c23a] transition-transform group-hover:rotate-45"></span> สมัครสมาชิก
          </a>
          <a href="/login" class="group flex items-center text-[#e4f2e4]/75 transition-colors hover:text-[#ffe9a8]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#12c23a] transition-transform group-hover:rotate-45"></span> เข้าสู่ระบบ
          </a>
          <a href="/about-us" class="group flex items-center text-[#e4f2e4]/75 transition-colors hover:text-[#ffe9a8]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#12c23a] transition-transform group-hover:rotate-45"></span> เกี่ยวกับเรา
          </a>
          <a href="/contact-us" class="group flex items-center text-[#e4f2e4]/75 transition-colors hover:text-[#ffe9a8]">
            <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#12c23a] transition-transform group-hover:rotate-45"></span> ติดต่อเจ้าหน้าที่
          </a>
        </div>
      </nav>

      <section aria-label="ช่องทางฝากถอน" class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#ffe9a8] uppercase">
          ช่องทางฝากถอน
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#12c23a] to-[#fb252b] shadow-[0_0_8px_rgba(1,163,38,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#e4f2e4]/75">
          เว็บไซต์ระบุว่าระบบฝากถอนเชื่อมต่อกับบัญชีบริษัทโดยตรง ก่อนทำรายการควรตรวจสอบชื่อบัญชีและข้อมูลบริษัทให้ตรงกันทุกครั้ง และใช้บัญชีชื่อเดียวกับที่ผูกไว้ตอนสมัคร
        </p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-[#01a326]/45 bg-[#0a1a0e] transition-colors hover:border-[#12c23a]/70">
          <span class="flex items-center gap-1 text-xs font-bold text-[#e4f2e4]"><span aria-hidden="true" class="text-lg text-[#f2b422]">🎁</span> ตรวจสอบโบนัสและสิทธิ์ได้จากบัญชีสมาชิก</span>
        </div>
      </section>
    </div>

    <hr class="mb-6 border-[#0a4a18]" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#e4f2e4]/70 md:block">
      {BRAND_NAME} เป็นช่องทางสำหรับผู้ที่ต้องการเข้าเล่นเกมเดิมพันผ่านแพลตฟอร์มต่างประเทศที่รวมหลายประเภทไว้ในบัญชีเดียว มีทั้งเกมสล็อต เกมคาสิโนสด
      และหมวดเกมอื่นตามผู้ให้บริการที่เชื่อมต่อกับระบบ เข้าใช้งานผ่านเว็บเบราว์เซอร์ได้ทั้งบนมือถือและคอมพิวเตอร์ หลัง Login สามารถสลับหมวดเกม ตรวจสอบเครดิต
      และดูประวัติรายการได้โดยไม่ต้องสมัครบัญชีใหม่แยกตามค่าย จำนวนค่ายและเกมที่เปิดให้บริการขึ้นอยู่กับรายการที่ผู้ให้บริการเปิดรับในแต่ละช่วง จึงอาจไม่เท่ากันทุกวัน
      โปรโมชั่นเปิดตามแคมเปญของแต่ละเดือน โดยโบนัสคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8% คำนวณจากยอดที่เข้าเกณฑ์ตามรอบที่เว็บไซต์กำหนด
      จึงควรตรวจสอบรอบคำนวณ เกมที่ร่วมรายการ และระยะเวลารับสิทธิ์ให้ครบถ้วนก่อนกดรับทุกครั้ง การสมัครทำได้ผ่านมือถือใน 3 ขั้นตอน ควรใช้ข้อมูลของตนเองในการสมัคร
      ตั้งรหัสผ่านที่คาดเดายาก และไม่เปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น หากเป็นปัญหาเกี่ยวกับเกมควรแจ้งชื่อเกม ค่าย และเวลาที่พบปัญหา
      ส่วนรายการฝากถอนควรเตรียมเวลา จำนวนเงิน และหลักฐานธุรกรรมไว้สำหรับตรวจสอบ หากมีการเปลี่ยนบัญชีรับเงินจากข้อมูลเดิม ควรตรวจสอบกับช่องทางหลักก่อนทำรายการ
      พร้อมแอดมิน {BRAND_NAME} ดูแลผ่านช่องทางไลน์ตลอด 24 ชั่วโมง
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-[#01a326]/40 pt-6 text-xs text-[#e4f2e4]/75 md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-[#ffe9a8] uppercase">{BRAND_NAME}</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/terms/" class="transition-colors hover:text-[#ffe9a8]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ffe9a8]">นโยบายความเป็นส่วนตัว</a>

        <a
          href="#top"
          class="flex h-8 w-8 items-center justify-center rounded border border-[#01a326]/55 bg-[#0a1a0e] text-[#e4f2e4] transition-all hover:border-[#12c23a] hover:bg-[#102a16] hover:shadow-[0_0_15px_rgba(1,163,38,0.55)]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
