---
export interface Props {
  title?: string;
  /** Only the main `title` may become a real heading, and only when the page
   *  hands it a docx H2. Defaults to <p> so a chrome usage stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: TitleTag = "p", titleleft, titleright, label } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// The two column labels always render as <p>, never <h2>. The docx a page is
// filled from is a flat H1 + a handful of H2s, and the rendered heading
// inventory is diffed against it on every rebrand — a widget quietly adding two
// more <h2> is the thing that makes that diff disagree. A <p> heading needs the
// section to carry its own accessible name instead, which is what `label` is for.
//
// The intro-slot wrapper below carries a real `mb-8` and sits beside the grid,
// so it is one of the three ContentBox* wrappers that cannot be hoisted away.
//
// 888PARUAY (รอบทอง-เขียวเข้ม-แดง 2026-09-24): มุมตัดถูกไล่ด้วยเส้นคู่ละสอง — คู่บน
// ซ้ายเป็นทองหลัก #fcdc2b และคู่ล่างขวาเป็นแดงหลัก #cf1111 กรอบจึงพาคู่สีของโลโก้
// (วงแหวนทองรอบตัว PARUAY สีแดง) มาไว้ที่ตัวกรอบเองแทนที่จะใช้สีเดียว การ์ดเป็น
// พื้นการ์ดเขียวเข้ม #0d2312 ในเส้นไรผมทองลึก #a87d0c และป้ายสองคอลัมน์แยกกันด้วย
// สี — ทองฝั่งซ้าย แดงฝั่งขวา ชมพูมาเจนตา-ทองของ WY88 (#24081a #170411 #e8b33a
// #ec2b84 #fced94 #c3832b #a3145a #f9a8cd #fce9f3) หายไปทั้งหมด
const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#a87d0c]/70 bg-[#0d2312]/92 p-8 text-[#e8e4c6] shadow-[0_10px_30px_rgba(252,220,43,0.16)] backdrop-blur-md transition-all duration-300 hover:border-[#fcdc2b]/60 hover:shadow-[0_15px_40px_rgba(252,220,43,0.26)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#fcdc2b] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#cf1111] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#fcdc2b] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#cf1111] to-transparent"></div>

    {
      title && (
        <TitleTag class="mb-4 bg-gradient-to-r from-[#fff6ae] via-[#fcdc2b] to-[#1fae1c] bg-clip-text text-center text-2xl leading-normal font-black text-transparent uppercase">{title}</TitleTag>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#e8e4c6]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#e8e4c6]">
        {
          titleleft && (
            <p class="flex items-center gap-2 border-b border-[#a87d0c]/70 pb-2 text-xl leading-normal font-black text-[#fff6ae] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#fcdc2b] shadow-[0_0_5px_rgba(252,220,43,0.75)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#e8e4c6] md:border-l md:border-[#a87d0c]/70 md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 border-b border-[#a87d0c]/70 pb-2 text-xl leading-normal font-black text-[#fffdf0] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#cf1111] shadow-[0_0_5px_rgba(207,17,17,0.85)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
