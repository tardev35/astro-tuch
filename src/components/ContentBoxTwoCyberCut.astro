---
export interface Props {
  title?: string;
  /** Only the main `title` may become a real heading, and only when the page
   *  hands it a docx H2. Defaults to <p> so a chrome usage stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: TitleTag = "p", titleleft, titleright, label } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// The two column labels always render as <p>, never <h2>. The docx a page is
// filled from is a flat H1 + a handful of H2s (plus a real H3 pair this round),
// and the rendered heading inventory is diffed against it on every rebrand — a
// widget quietly adding two more headings is the thing that makes that diff
// disagree. A <p> heading needs the section to carry its own accessible name
// instead, which is what `label` is for.
//
// The intro-slot wrapper below carries a real `mb-8` and sits beside the grid,
// so it is one of the three ContentBox* wrappers that cannot be hoisted away.
//
// NAZA168 (รอบทองอวกาศ-เงินโครเมียม บนน้ำตาลคั่วเข้ม 2026-10-10, brand-spec §2):
// แบรนด์รอบนี้เป็นคู่สีจริง — ทองอวกาศ #fbc134 นำ (ขอบเหรียญตราและคำว่า NAZA) และ
// เงินโครเมียม #cfd6e3 เป็นฮิวที่สอง (หมวกนักบินอวกาศ เลข 168 และผนังสถานีอวกาศ)
// พื้นเพจเป็นน้ำตาลคั่วเข้ม #382400 ตาม bg.json รอบนี้ไม่มีสีแดงในชุดเลย
//
// การ์ดมุมตัดใบเดียวของหน้านี้ — ผิวกลาง #432b03 ซึ่งลึกกว่าผิวยก #4e3406 ของ
// ContentBox กับ ContentBoxTwoNeumorphism และตื้นกว่าผิวลึกสุด #241700 ของ
// ContentBoxSevenThree ทั้งหน้าจึงไล่ระดับความลึกกันทีละชั้น ไม่ได้อ่านเป็นใบเดียวกันซ้ำ
// มุมตัดถูกไล่ด้วยเส้นคู่ละสอง — คู่บนซ้ายเป็นทองแบรนด์ #fbc134 (แนวนอน) กับโครเมียม
// #cfd6e3 (แนวตั้ง) และคู่ล่างขวาเป็นทองสว่าง #ffe87a (แนวนอน) กับเงินลึก #3f4859
// (แนวตั้ง) กรอบจึงพาทั้งสองฮิวมาไว้ที่ตัวกรอบเอง ทองวางแนวนอน เงินวางแนวตั้ง
// ป้ายสองคอลัมน์แยกกันด้วย "ทอง vs โครเมียม" ตรงๆ — ทองแบรนด์ #fbc134 (7.0:1) ฝั่งซ้าย
// โครเมียม #cfd6e3 (7.9:1) ฝั่งขวา ส่วนทองลึก #96690a กับเงินลึก #3f4859 ตกต่ำกว่า AA
// จึงเป็นจุดสี่เหลี่ยม เส้นคั่น และขอบเท่านั้น ไม่ใช่สีตัวอักษร
// หัวข้อ docx ไล่ทองแบรนด์ #fbc134 → ทองสว่าง #ffe87a → โครเมียมสว่าง #eef2f8 ซึ่งเป็น
// ลำดับคนละชุดกับอีกหกกล่องบนหน้าเดียวกัน
// เนื้อความ #fdf3df (= BRAND_TEXT) — 11.9:1 บนผิวกลาง #432b03
//
// ⚠️ หกในเจ็ดแบรนด์ก่อนหน้าก็มีทอง เจอทองที่ไหนห้ามเหมาว่าเป็นของรอบนี้ ให้เทียบค่า
// เป็นตัวๆ: ชุดเขียวป่า-ทองมงกุฎของ KINGKONG555 ที่เคยค้างในไฟล์นี้ (#8ce023 #5cc211
// #2f8c07 #1a5c04 #f2c230 #ffe066 #a87a08 #bde397 #e9f7d6 #0f2e05) ชุดม่วงนีออน-ทอง
// ของ WEPLAY168 (#a435f0 #7a1fc4 #fbe455 #efe6ff #ece2ff #d2a6ff #ffd23d #5b1a75
// #c98a05 #1e0a3c #17062e #0a0117) ชุดแดงแล็กเกอร์-ทองของ PIGPG (#d4200d #f5b61d
// #ffd87a #fdf9e4 #b07a06 #6b0402 #2a0806 #fdc4a3 #fdeedd) ชุดมรกต-ทองของ KOON234
// (#0a6b32 #2fbf6a #cc920a #f7d14e #e8f2e6) และชุดทองเมทัลลิกของ 789BETTING/UOK365
// (#fad354 #ffe79a #ddab33 #c9881f #8a6410 #f3e7cd) ออกครบทุกจุดแล้ว — ทองของรอบนี้
// (#fbc134) เป็นคนละค่ากับทุกตัวข้างบน อย่าปล่อยไว้เพราะ "ทองอยู่แล้ว"
const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
// A real heading already names the region, so the aria-label is dropped in that
// case and only stands in when the title rendered as chrome (`as="p"`).
const named = Boolean(title) && TitleTag !== "p";
---

<section aria-label={named ? undefined : sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#fbc134]/35 bg-[#432b03]/95 p-8 text-[#fdf3df] shadow-[0_10px_30px_rgba(0,0,0,0.6)] backdrop-blur-md transition-all duration-300 hover:border-[#fbc134]/80 hover:shadow-[0_15px_40px_rgba(251,193,52,0.26)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#fbc134] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#ffe87a] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#cfd6e3] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#3f4859] to-transparent"></div>

    {
      title && (
        <TitleTag class="mb-4 bg-gradient-to-r from-[#fbc134] via-[#ffe87a] to-[#eef2f8] bg-clip-text text-center text-2xl leading-normal font-black text-transparent uppercase">{title}</TitleTag>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#fdf3df]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#fdf3df]">
        {
          titleleft && (
            <p class="flex items-center gap-2 border-b border-[#96690a] pb-2 text-xl leading-normal font-black text-[#fbc134] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#cfd6e3] shadow-[0_0_5px_rgba(207,214,227,0.8)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#fdf3df] md:border-l md:border-[#96690a] md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 border-b border-[#96690a] pb-2 text-xl leading-normal font-black text-[#cfd6e3] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#96690a] shadow-[0_0_5px_rgba(251,193,52,0.8)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
