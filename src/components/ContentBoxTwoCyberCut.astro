---
export interface Props {
  title?: string;
  /** Only the main `title` may become a real heading, and only when the page
   *  hands it a docx H2. Defaults to <p> so a chrome usage stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: TitleTag = "p", titleleft, titleright, label } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// The two column labels always render as <p>, never <h2>. The docx a page is
// filled from is a flat H1 + a handful of H2s, and the rendered heading
// inventory is diffed against it on every rebrand — a widget quietly adding two
// more <h2> is the thing that makes that diff disagree. A <p> heading needs the
// section to carry its own accessible name instead, which is what `label` is for.
//
// The intro-slot wrapper below carries a real `mb-8` and sits beside the grid,
// so it is one of the three ContentBox* wrappers that cannot be hoisted away.
//
// KINGDOM66 (รอบทอง-ดำ 2026-09-25): มุมตัดถูกไล่ด้วยเส้นคู่ละสอง — คู่บนซ้ายเป็นทอง
// แบรนด์ #e6bf4e และคู่ล่างขวาเป็นครีมแพลตินัมอุ่น #efe6cf กรอบจึงพาคู่สีของโลโก้
// (คำว่า KINGDOM ทองแกะสลักด้าน แล้วเลข 66 ทองเต็มดวง) มาไว้ที่ตัวกรอบเองแทนที่จะใช้
// สีเดียว การ์ดเป็นผิวการ์ดดำอมน้ำตาล #151109 ในเส้นไรผมทองลึก #5c4113 และป้ายสอง
// คอลัมน์แยกกันด้วยสี — ทองอ่อน #f5e196 ฝั่งซ้าย ครีมเกือบขาว #fdf6e0 ฝั่งขวา
// เนื้อความ #ebe3d3 (BRAND_TEXT) ชุดทอง-เขียวเข้ม-แดงของ 888PARUAY (#fcdc2b
// #fff6ae #a87d0c #1fae1c #cf1111 #0d2312 #e8e4c6 #fffdf0) หายไปทั้งหมด
const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
// A real heading already names the region, so the aria-label is dropped in that
// case and only stands in when the title rendered as chrome (`as="p"`).
const named = Boolean(title) && TitleTag !== "p";
---

<section aria-label={named ? undefined : sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#5c4113]/80 bg-[#151109]/92 p-8 text-[#ebe3d3] shadow-[0_10px_30px_rgba(230,191,78,0.16)] backdrop-blur-md transition-all duration-300 hover:border-[#e6bf4e]/60 hover:shadow-[0_15px_40px_rgba(230,191,78,0.26)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#e6bf4e] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#efe6cf] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#e6bf4e] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#efe6cf] to-transparent"></div>

    {
      title && (
        <TitleTag class="mb-4 bg-gradient-to-r from-[#efe6cf] via-[#f2d683] to-[#e6bf4e] bg-clip-text text-center text-2xl leading-normal font-black text-transparent uppercase">{title}</TitleTag>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#ebe3d3]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#ebe3d3]">
        {
          titleleft && (
            <p class="flex items-center gap-2 border-b border-[#5c4113]/80 pb-2 text-xl leading-normal font-black text-[#f5e196] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#e6bf4e] shadow-[0_0_5px_rgba(230,191,78,0.8)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#ebe3d3] md:border-l md:border-[#5c4113]/80 md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 border-b border-[#5c4113]/80 pb-2 text-xl leading-normal font-black text-[#fdf6e0] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#efe6cf] shadow-[0_0_5px_rgba(239,230,207,0.75)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
