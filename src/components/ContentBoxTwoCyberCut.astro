---
export interface Props {
  title?: string;
  /** Only the main `title` may become a real heading, and only when the page
   *  hands it a docx H2. Defaults to <p> so a chrome usage stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: TitleTag = "p", titleleft, titleright, label } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// The two column labels always render as <p>, never <h2>. The docx a page is
// filled from is a flat H1 + a handful of H2s (plus a real H3 pair this round),
// and the rendered heading inventory is diffed against it on every rebrand — a
// widget quietly adding two more headings is the thing that makes that diff
// disagree. A <p> heading needs the section to carry its own accessible name
// instead, which is what `label` is for.
//
// The intro-slot wrapper below carries a real `mb-8` and sits beside the grid,
// so it is one of the three ContentBox* wrappers that cannot be hoisted away.
//
// PIGPG (รอบแดงแล็กเกอร์-ทองแบบตรุษจีน 2026-10-09, brand-spec §2):
// การ์ดมุมตัดใบกลางในสามใบของหน้านี้ — ผิวกลาง #2a0806 ซึ่งลึกกว่า ContentBoxCyberCut
// (#3a0d07) และตื้นกว่า SevenThreeCyberCut (#1c0503) สามใบจึงไล่ระดับความลึกกัน ไม่ได้
// อ่านเป็นใบเดียวกันสามรอบ มุมตัดถูกไล่ด้วยเส้นคู่ละสอง — คู่บนซ้ายเป็นทองแบรนด์ #f5b61d
// กับแดงสด #d4200d และคู่ล่างขวาเป็นครีมงาช้าง #fdf9e4 กับแดงเข้ม #6b0402 กรอบจึงพาทั้ง
// สองฮิวของแบรนด์ (ครีม → ทอง / แดงสด → แดงเข้ม) มาไว้ที่ตัวกรอบเอง แทนที่จะใช้เฉดเดียว
// และสลับฝั่งกับ ContentBoxCyberCut ที่วางทองไว้แนวนอน แดงไว้แนวตั้ง
// ป้ายสองคอลัมน์แยกกันด้วย "ทอง vs ครีมอมพีช" ตรงๆ — ทองแบรนด์ #f5b61d ฝั่งซ้าย
// พีช #fdc4a3 ฝั่งขวา ทั้งคู่อ่านออกบนผิวมืด (10:1 ขึ้นไป) ส่วนแดงสด #d4200d กับทองเข้ม
// #b07a06 ตกต่ำกว่า AA จึงถูกใช้เป็นจุดสี่เหลี่ยมและเส้นคั่นเท่านั้น ไม่ใช่สีตัวอักษร
// หัวข้อ docx ไล่ทองแบรนด์ #f5b61d → ทองสว่าง #ffd87a → ครีมงาช้าง #fdf9e4 ซึ่งเป็นคนละ
// ลำดับกับอีกหกกล่องบนหน้าเดียวกัน
// เนื้อความ #fdeedd (= BRAND_TEXT) — 16.2:1 บนผิวกลาง
//
// ชุดมรกต-ทองของ KOON234 (#0a6b32 #2fbf6a #043d1c #cc920a #f7d14e #fde9a6 #8a6204
// #09190d #0d2414 #e8f2e6) ชุดฟ้าสด-เหลืองมะนาวของ แตกดี168 (#0193fb #7bcffb #d4ecfd
// #064a86 #fce604 #c9a703 #0a1726 #07111d #dbeafe) และชุดทองเมทัลลิกของ 789BETTING/
// UOK365 ก่อนหน้านั้น (#fad354 #ffe79a #ddab33 #c9881f #8a6410 #4a3407 #0e0b05 #f3e7cd)
// ออกครบทุกจุดแล้ว — ทองสองรอบก่อนเป็นคนละค่ากับทองของรอบนี้ อย่าปล่อยไว้เพราะ
// "ทองอยู่แล้ว"
const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
// A real heading already names the region, so the aria-label is dropped in that
// case and only stands in when the title rendered as chrome (`as="p"`).
const named = Boolean(title) && TitleTag !== "p";
---

<section aria-label={named ? undefined : sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#f5b61d]/35 bg-[#2a0806]/95 p-8 text-[#fdeedd] shadow-[0_10px_30px_rgba(0,0,0,0.6)] backdrop-blur-md transition-all duration-300 hover:border-[#f5b61d]/80 hover:shadow-[0_15px_40px_rgba(245,182,29,0.26)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#f5b61d] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#fdf9e4] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#d4200d] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#6b0402] to-transparent"></div>

    {
      title && (
        <TitleTag class="mb-4 bg-gradient-to-r from-[#f5b61d] via-[#ffd87a] to-[#fdf9e4] bg-clip-text text-center text-2xl leading-normal font-black text-transparent uppercase">{title}</TitleTag>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#fdeedd]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#fdeedd]">
        {
          titleleft && (
            <p class="flex items-center gap-2 border-b border-[#6b0402] pb-2 text-xl leading-normal font-black text-[#f5b61d] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#d4200d] shadow-[0_0_5px_rgba(212,32,13,0.8)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#fdeedd] md:border-l md:border-[#6b0402] md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 border-b border-[#6b0402] pb-2 text-xl leading-normal font-black text-[#fdc4a3] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#b07a06] shadow-[0_0_5px_rgba(176,122,6,0.8)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
