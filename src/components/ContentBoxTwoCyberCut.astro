---
export interface Props {
  title?: string;
  /** Only the main `title` may become a real heading, and only when the page
   *  hands it a docx H2. Defaults to <p> so a chrome usage stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: TitleTag = "p", titleleft, titleright, label } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// The two column labels always render as <p>, never a heading tag. The docx a
// page is filled from is a flat H1 + a handful of H2s (plus a real H3 pair this
// round), and the rendered heading inventory is diffed against it on every
// rebrand — a widget quietly adding two more headings is the thing that makes
// that diff disagree. A <p> heading needs the section to carry its own
// accessible name instead, which is what `label` is for.
//
// The intro-slot wrapper below carries a real `mb-8` and sits beside the grid,
// so it is one of the three ContentBox* wrappers that cannot be hoisted away.
//
// This card carries docx H2 §3 of the home page (content.txt line 8). The brief
// writes that section as ONE running paragraph with no sub-labels, so the page
// runs its two halves one per column and passes no `titleleft`/`titleright` —
// inventing a pair would be the page's wording rather than the docx's.
//
// นินจา168 (รอบ **ฟ้าไซยานนำ · เหลืองมะนาวเป็นฮิวที่สอง · น้ำเงินลึกไม่เคยถือ
// ตัวอักษร · บนดำสนิท** 2026-10-19, brand-spec §2): ฟ้าแบรนด์ #32bcfb มาจากเลขบน
// โลโก้ ผ้าคาดหัวนินจา ชูริเคน และหัวใจฟ้าที่ลอยทั่วงานศิลป์ ส่วนเหลืองมะนาว #fef54b
// คือตัวอักษรไทยสามมิติของโลโก้และประกายดาวทอง
// พื้นเพจเป็น **ดำสนิท #000000** (bg.json) ลำดับความลึก: #0c2a3d ยก / #071a28 กลาง
// / #030e16 จม / #000000 พื้น
//
// การ์ดมุมตัดใบแรกของหน้านี้ — ใบนี้อยู่ที่ **ผิวจม #030e16** ซึ่งลึกกว่าผิวกลางของ
// ContentBoxSevenThreeCyberCut (§4) และตัดมุม **ซ้ายบน-ขวาล่าง 30px** ส่วน §4 ตัด
// **ขวาบน-ซ้ายล่าง** เป็นภาพกระจก มุมถูกไล่ด้วยเส้นคู่ละสอง และทุกเส้นเป็นคนละค่า
// ของพาเลตต์ เพื่อให้กรอบเองพาทั้งไล่ฟ้า-เหลืองมาไว้ที่ตัวกรอบ — คู่บนซ้ายเป็น
// ฟ้าแบรนด์ #32bcfb (แนวนอน) กับเหลืองมะนาว #fef54b (แนวตั้ง) และคู่ล่างขวาเป็น
// เหลืองมะนาว (แนวนอน) กับน้ำเงินลึก #07335f (แนวตั้ง) สลับขั้วกันสองมุม
// ป้ายสองคอลัมน์แยกกันด้วย "ฟ้าน้ำแข็ง vs เหลืองมะนาว" ตรงๆ — ฟ้าน้ำแข็ง #a9e9ff
// ฝั่งซ้าย (11.3:1) เหลืองมะนาว #fef54b ฝั่งขวา (12.7:1) ส่วนจุดนำหน้าเป็นฟ้าแบรนด์
// กับเหลืองมะนาว หัวข้อ docx ไล่ ฟ้าแบรนด์ #32bcfb → ฟ้าน้ำแข็ง #a9e9ff →
// เหลืองมะนาว #fef54b ซึ่งเป็นลำดับคนละชุดกับอีกเจ็ดกล่องบนหน้าเดียวกัน
// ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ไม่ใช่พื้นหลัง ทุกสต็อป
// จึงต้องเป็นค่าที่ §2 อนุญาตให้ถือตัวอักษรได้ — ห้ามเอา #07335f หรือ #6b5c10 มาเป็น
// ปลายไล่เฉด
// เนื้อความ #dceefc (= BRAND_TEXT) — 16.8:1 บนผิวจม ซึ่งเป็นคอนทราสต์สูงสุดของหน้า
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้มีสองชั้น: ฟ้า และ ทอง**
// เพราะรอบที่แล้ว (สบายเบท168) ก็ฟ้านำ+ทองรองบนดำเหมือนกัน ฟ้ารอบนี้ #32bcfb ไซยาน
// สว่างกว่า 2f9ff5 และฮิวที่สองรอบนี้เป็นเหลืองมะนาว #fef54b ไม่ใช่ทองอำพัน ffc82e
// ชุดเต็มของสบายเบท168 ที่ต้องไม่เหลือ (2f9ff5 a8dcff 0b3f78 ffc82e 5c4a16 e8f4ff
// 0e2238 081726 040d16 04121f) ชุดของถอนชัวร์168 (fa63b9 ffb3de ffd84d 2b0f20 1a0914
// 0d040a 6d0b3f 6b4708 2a0617 fdeaf5) ชุดของมีโชค168 ที่เพิ่งอยู่ในไฟล์นี้ (fcd434
// ffeaa0 f5469f ff8dc6 8c0f52 7a5508 1a0612 f6e4ee 24101c 160a12 0b0509) ชุดของ
// ขวัญใจ168 (f7c92b ffe6a3 f2bba5 c98a74 b3121b 5a0a0e 8a5f12 eadfce 140c06 241509
// 160d06 0b0603) ชุดทองไทย-แดงมังกรของรับตัง168 (f0b429 ffdc8c d30304 ff6b6e a00203
// 4a0202 9a6c0c cfd9e6 f5ece0 2b100f 200a09 140505 1a0505) ชุดของสมหวัง168 (fa0513
// ffadaf ff5a5f e3b23c ffe5a8 8a6210 b90203 8c0204 5b0203 3c0303 170504 f4ecea
// ccb9b6 2c1413 1f0d0c 140706 290f0f) และชุดน้ำเงินไฟฟ้าของ TSDET911 (0360f3 0292fb
// 6ec8ff cfdcec 9db4d4 dde8f7 102a5e 0a1c42 040e26 00081f 032dad 04186e 021026)
// ออกครบทุกค่าแล้ว รวมถึง 0a84e0 04203f e4f1fd ของ HI59 · 04225b · 2563eb
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีชมพู ม่วง/ไวโอเลต เขียว ส้ม แดง โรสโกลด์ และเงิน/โครเมียม**
const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
// A real heading already names the region, so the aria-label is dropped in that
// case and only stands in when the title rendered as chrome (`as="p"`).
const named = Boolean(title) && TitleTag !== "p";
---

<section aria-label={named ? undefined : sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#32bcfb]/35 bg-[#030e16]/95 p-8 text-[#dceefc] shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-md transition-all duration-300 hover:border-[#32bcfb]/80 hover:shadow-[0_15px_40px_rgba(254,245,75,0.22)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#32bcfb] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#fef54b] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#fef54b] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#07335f] to-transparent"></div>

    {
      title && (
        <TitleTag class="mb-4 bg-gradient-to-r from-[#32bcfb] via-[#a9e9ff] to-[#fef54b] bg-clip-text text-center text-2xl leading-normal font-black text-transparent uppercase">{title}</TitleTag>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#dceefc]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#dceefc]">
        {
          titleleft && (
            <p class="flex items-center gap-2 border-b border-[#07335f] pb-2 text-xl leading-normal font-black text-[#a9e9ff] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#32bcfb] shadow-[0_0_5px_rgba(50,188,251,0.8)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#dceefc] md:border-l md:border-[#07335f] md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 border-b border-[#07335f] pb-2 text-xl leading-normal font-black text-[#fef54b] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#fef54b] shadow-[0_0_5px_rgba(254,245,75,0.8)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
