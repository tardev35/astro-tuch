---
export interface Props {
  title?: string;
  /** Only the main `title` may become a real heading, and only when the page
   *  hands it a docx H2. Defaults to <p> so a chrome usage stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: TitleTag = "p", titleleft, titleright, label } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// The two column labels always render as <p>, never <h2>. The docx a page is
// filled from is a flat H1 + a handful of H2s (plus a real H3 pair this round),
// and the rendered heading inventory is diffed against it on every rebrand — a
// widget quietly adding two more headings is the thing that makes that diff
// disagree. A <p> heading needs the section to carry its own accessible name
// instead, which is what `label` is for.
//
// The intro-slot wrapper below carries a real `mb-8` and sits beside the grid,
// so it is one of the three ContentBox* wrappers that cannot be hoisted away.
//
// KINGKONG555 (รอบเขียวป่า-ทองมงกุฎ 2026-10-09, brand-spec §2):
// การ์ดมุมตัดใบกลางในสามใบของหน้านี้ — ผิวกลาง #0f2e05 ซึ่งลึกกว่า ContentBoxCyberCut
// (#14380a) และตื้นกว่า SevenThreeCyberCut (#051400) สามใบจึงไล่ระดับความลึกกัน ไม่ได้
// อ่านเป็นใบเดียวกันสามรอบ มุมตัดถูกไล่ด้วยเส้นคู่ละสอง — คู่บนซ้ายเป็นทองมงกุฎ #f2c230
// กับเขียวมะนาว #8ce023 และคู่ล่างขวาเป็นทองสว่าง #ffe066 กับเขียวลึก #1a5c04 กรอบจึงพา
// ทั้งสองฮิวของแบรนด์ (ทอง → ทองสว่าง / เขียวสด → เขียวลึก) มาไว้ที่ตัวกรอบเอง และสลับฝั่ง
// กับ ContentBoxCyberCut ที่วางทองไว้แนวนอน เขียวไว้แนวตั้ง
// ป้ายสองคอลัมน์แยกกันด้วย "ทอง vs เขียวอ่อน" ตรงๆ — ทองมงกุฎ #f2c230 ฝั่งซ้าย
// เขียวอ่อน #bde397 ฝั่งขวา ทั้งคู่อ่านออกบนผิวมืด (9:1 ขึ้นไป) ส่วนเขียวกลาง #2f8c07 กับ
// ทองลึก #a87a08 ตกต่ำกว่า AA จึงถูกใช้เป็นจุดสี่เหลี่ยมและเส้นคั่นเท่านั้น ไม่ใช่สีตัวอักษร
// หัวข้อ docx ไล่ทองมงกุฎ #f2c230 → ทองสว่าง #ffe066 → เขียวครีม #e9f7d6 ซึ่งเป็นคนละ
// ลำดับกับอีกหกกล่องบนหน้าเดียวกัน
// เนื้อความ #e9f7d6 (= BRAND_TEXT) — 14.6:1 บนผิวกลาง
//
// ชุดม่วงนีออน-ทองของ WEPLAY168 ที่เคยค้างในไฟล์นี้ (#a435f0 #7a1fc4 #fbe455 #efe6ff
// #ece2ff #d2a6ff #ffd23d #5b1a75 #c98a05 #1e0a3c #17062e #0a0117) ชุดแดงแล็กเกอร์-ทอง
// ของ PIGPG (#d4200d #f5b61d #ffd87a #fdf9e4 #b07a06 #6b0402 #2a0806 #fdc4a3 #fdeedd)
// ชุดมรกต-ทองของ KOON234 (#0a6b32 #2fbf6a #cc920a #f7d14e #e8f2e6) และชุดทองเมทัลลิก
// ของ 789BETTING/UOK365 (#fad354 #ffe79a #ddab33 #c9881f #8a6410 #f3e7cd) ออกครบทุกจุด
// แล้ว — ทองของรอบก่อนๆ เป็นคนละค่ากับทองของรอบนี้ อย่าปล่อยไว้เพราะ "ทองอยู่แล้ว"
const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
// A real heading already names the region, so the aria-label is dropped in that
// case and only stands in when the title rendered as chrome (`as="p"`).
const named = Boolean(title) && TitleTag !== "p";
---

<section aria-label={named ? undefined : sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#f2c230]/35 bg-[#0f2e05]/95 p-8 text-[#e9f7d6] shadow-[0_10px_30px_rgba(0,0,0,0.6)] backdrop-blur-md transition-all duration-300 hover:border-[#f2c230]/80 hover:shadow-[0_15px_40px_rgba(242,194,48,0.26)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#f2c230] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#ffe066] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#8ce023] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#1a5c04] to-transparent"></div>

    {
      title && (
        <TitleTag class="mb-4 bg-gradient-to-r from-[#f2c230] via-[#ffe066] to-[#e9f7d6] bg-clip-text text-center text-2xl leading-normal font-black text-transparent uppercase">{title}</TitleTag>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#e9f7d6]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#e9f7d6]">
        {
          titleleft && (
            <p class="flex items-center gap-2 border-b border-[#1a5c04] pb-2 text-xl leading-normal font-black text-[#f2c230] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#8ce023] shadow-[0_0_5px_rgba(140,224,35,0.8)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#e9f7d6] md:border-l md:border-[#1a5c04] md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 border-b border-[#1a5c04] pb-2 text-xl leading-normal font-black text-[#bde397] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#a87a08] shadow-[0_0_5px_rgba(242,194,48,0.8)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
