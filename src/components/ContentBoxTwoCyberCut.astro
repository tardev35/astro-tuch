---
export interface Props {
  title?: string;
  /** Only the main `title` may become a real heading, and only when the page
   *  hands it a docx H2. Defaults to <p> so a chrome usage stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: TitleTag = "p", titleleft, titleright, label } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// The two column labels always render as <p>, never <h2>. The docx a page is
// filled from is a flat H1 + a handful of H2s (plus a real H3 pair this round),
// and the rendered heading inventory is diffed against it on every rebrand — a
// widget quietly adding two more <h2> is the thing that makes that diff
// disagree. A <p> heading needs the section to carry its own accessible name
// instead, which is what `label` is for.
//
// The intro-slot wrapper below carries a real `mb-8` and sits beside the grid,
// so it is one of the three ContentBox* wrappers that cannot be hoisted away.
//
// HI59 (รอบฟ้า-ทองบนการ์ดสว่าง 2026-10-07, brand-spec §2): การ์ดมุมตัดใบกลางใน
// สามใบของหน้านี้ — ผิว #e7f2fd ซึ่งลึกกว่า ContentBoxCyberCut (#f6fbff) และตื้นกว่า
// SevenThreeCyberCut (#d3e7fa) สามใบจึงไล่ระดับความสว่างกัน ไม่ได้อ่านเป็นใบเดียวกัน
// สามรอบ มุมตัดถูกไล่ด้วยเส้นคู่ละสอง — คู่บนซ้ายเป็นฟ้าแบรนด์ #0a84e0 กับทองแบรนด์
// #fdbc04 และคู่ล่างขวาเป็นฟ้าเรือง #5ec2ff กับทองเข้ม #c88a02 กรอบจึงพาคู่สีของโลโก้
// (ตัวอักษร HI ฟ้า กับตัวเลข 59 ทอง ในวงแหวนโค้ง) มาไว้ที่ตัวกรอบเองแทนที่จะใช้สีเดียว
// ป้ายสองคอลัมน์แยกกันด้วยสี — ฟ้าลึก #065a9c ฝั่งซ้าย ทองหมึก #8a6102 ฝั่งขวา
// ทั้งคู่เป็นเฉดเข้มของสองฮิว เพราะบนพื้นสว่างต้องใช้ปลายเข้ม ฟ้าแบรนด์ #0a84e0 ได้แค่
// 4.0:1 และทองแบรนด์ #fdbc04 ตกเลย จึงไม่ถูกใช้เป็นสีตัวอักษรในไฟล์นี้
// หัวข้อ docx ไล่ฟ้าลึก #065a9c → กรมท่าหัวข้อ #06355f → ทองเข้ม #c88a02 ซึ่งเป็น
// คนละลำดับกับอีกหกกล่องบนหน้าเดียวกัน เนื้อความ #0d2744 (= BRAND_TEXT)
//
// ชุดแดงแบรนด์+ทองของ หวย24 ที่เคยค้างในไฟล์นี้ (#230d0d #3d0a0a #d20a0a #ff3b3b
// #f5c33b #a9761a #f7e2d6) ออกครบทุกจุดแล้ว
const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
// A real heading already names the region, so the aria-label is dropped in that
// case and only stands in when the title rendered as chrome (`as="p"`).
const named = Boolean(title) && TitleTag !== "p";
---

<section aria-label={named ? undefined : sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#9ecbf2] bg-[#e7f2fd]/95 p-8 text-[#0d2744] shadow-[0_10px_30px_rgba(6,53,95,0.16)] backdrop-blur-md transition-all duration-300 hover:border-[#0a84e0]/80 hover:shadow-[0_15px_40px_rgba(10,132,224,0.26)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#0a84e0] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#5ec2ff] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#fdbc04] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#c88a02] to-transparent"></div>

    {
      title && (
        <TitleTag class="mb-4 bg-gradient-to-r from-[#065a9c] via-[#06355f] to-[#c88a02] bg-clip-text text-center text-2xl leading-normal font-black text-transparent uppercase">{title}</TitleTag>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#0d2744]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#0d2744]">
        {
          titleleft && (
            <p class="flex items-center gap-2 border-b border-[#9ecbf2] pb-2 text-xl leading-normal font-black text-[#065a9c] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#0a84e0] shadow-[0_0_5px_rgba(10,132,224,0.75)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#0d2744] md:border-l md:border-[#9ecbf2] md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 border-b border-[#9ecbf2] pb-2 text-xl leading-normal font-black text-[#8a6102] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#fdbc04] shadow-[0_0_5px_rgba(200,138,2,0.75)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
