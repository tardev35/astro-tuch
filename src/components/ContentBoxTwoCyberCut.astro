---
export interface Props {
  title?: string;
  /** Only the main `title` may become a real heading, and only when the page
   *  hands it a docx H2. Defaults to <p> so a chrome usage stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: TitleTag = "p", titleleft, titleright, label } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// The two column labels always render as <p>, never <h2>. The docx a page is
// filled from is a flat H1 + a handful of H2s (plus a real H3 pair this round),
// and the rendered heading inventory is diffed against it on every rebrand — a
// widget quietly adding two more headings is the thing that makes that diff
// disagree. A <p> heading needs the section to carry its own accessible name
// instead, which is what `label` is for.
//
// The intro-slot wrapper below carries a real `mb-8` and sits beside the grid,
// so it is one of the three ContentBox* wrappers that cannot be hoisted away.
//
// This card carries docx H2 §2 of the home page (content.txt line 6 left /
// line 7 right). The brief gives those two paragraphs no sub-labels of their
// own, so index.astro passes no `titleleft`/`titleright` — inventing a pair
// would be the page's wording rather than the docx's.
//
// GT66B (รอบแดงมังกร-โครเมียมขาวบนดำสนิท 2026-10-13, brand-spec §2):
// รอบนี้เป็น **สองโทนจริง: แดงมังกรนำ โครเมียมขาวรอง** — แดงแบรนด์ #fb141b คือ
// อักขระมังกรจีน 龍 กับตัวเลข 66 บนเวิร์ดมาร์ก ส่วนโครเมียมขาว #fdfcfd / #b4bcc2
// คือตัวอักษร GT และ B สามมิติ พื้นเพจ **ดำสนิท** #000000 ตาม bg.json
// ⚠️ พื้นเพจดำสนิท จึงไม่มีผิวไหนจมต่ำกว่าพื้นได้เลย — #0b0303 คือก้นสุดที่ใช้ได้
// ⚠️ **ไม่มีทอง (เกินมงกุฎเล็กบนป้ายสไลด์) ไม่มีม่วง ไม่มีชมพู ไม่มีน้ำเงิน ไม่มีฟ้า
// ไม่มีเขียว ไม่มีส้ม**
//
// การ์ดมุมตัดใบแรกของหน้านี้ (อีกสองใบคือ ContentBoxSevenThreeCyberCut ที่ §4 และ
// ContentBoxSevenThree ที่ §5) — ใบนี้อยู่ที่ **ผิวจม #0b0303** ซึ่งลึกกว่าผิวกลาง
// #130c0c ของ §4 และผิวยก #1c0c0b ของ §5 ทั้งสามใบยังถูกคั่นด้วย ContentBox (§3)
// ที่เป็นมุมกลมผิวยก มุมตัดที่นี่เป็น 30px ทิศซ้ายบน-ขวาล่าง ซึ่ง §4 กลับทิศเป็น
// ภาพกระจก และ §5 ใช้ 36px ทิศเดียวกับใบนี้แต่คนละขนาดและคนละผิว
// มุมถูกไล่ด้วยเส้นคู่ละสอง และทุกเส้นเป็นคนละค่าของพาเลตต์เพื่อให้กรอบเองพาทั้ง
// ไล่แดง-โครเมียมมาไว้ที่ตัวกรอบ — คู่บนซ้ายเป็นแดงแบรนด์ #fb141b (แนวนอน) กับ
// โครเมียมสว่าง #fdfcfd (แนวตั้ง) และคู่ล่างขวาเป็นโครเมียมหม่น #b4bcc2 (แนวนอน)
// กับแดงถ่าน #8a0609 (แนวตั้ง) แดงวางแนวนอน โครเมียมวางแนวตั้ง สลับขั้วกันสองมุม
// ป้ายสองคอลัมน์แยกกันด้วย "แดงสว่าง vs โครเมียมสว่าง" ตรงๆ — แดงสว่าง #ff5f63
// ฝั่งซ้าย (6.4:1 และเป็น text-xl font-black จึงเป็น large text) โครเมียมสว่าง
// #fdfcfd ฝั่งขวา (18.5:1) ส่วนแดงแบรนด์ #fb141b แดงถ่าน #8a0609 และแดงดำ #3b0405
// ตกต่ำกว่า AA จึงเป็นจุดสี่เหลี่ยม เส้นคั่น และขอบเท่านั้น ไม่ใช่สีตัวอักษร
// หัวข้อ docx ไล่ แดงแบรนด์ #fb141b → โครเมียมหม่น #b4bcc2 → โครเมียมสว่าง #fdfcfd
// ซึ่งเป็นลำดับคนละชุดกับอีกเจ็ดกล่องบนหน้าเดียวกัน (แดงแบรนด์อยู่ได้เพราะเป็น
// **ปลาย** ของไล่เฉด ไม่ใช่สีตัวอักษรทึบ)
// เนื้อความขาวนวล #eceaea (= BRAND_TEXT) — 17.6:1 บนผิวจม #0b0303 ซึ่งเป็น
// คอนทราสต์สูงสุดของหน้า
// #ffa0a2 ถูกสงวนไว้ให้ <strong> ในย่อหน้าตาม §2 จึงไม่โผล่ในไฟล์นี้
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือแดง** แบรนด์รอบก่อนหน้า
// ทันที (TKB55) ก็เป็นแดง-โครเมียม-ดำเหมือนกัน แดงของมันคือ #fb131b ส่วนรอบนี้คือ
// #fb141b ต่างกันหนึ่งหลัก ชุดเต็มของ TKB55 (#fb131b #ff8a8f #ff4d55 #e9eef4 #aeb9c6
// #f2e4e5 #2a0d0f #1a0708 #0d0304 #c40304 #8a0206 #53050a #1a0304) ไม่เหลือที่นี่
// ชุดทองมังกรของ TND168 ที่เพิ่งค้างอยู่ทั้งไฟล์นี้ (#dfa310 #ffe4a3 #c9b88e #f0e9dc
// #8a5c09 #43240b #140d02 #1b1307 #120c04 #070502) ชุดทองอำพันเสือของ TIGERWIN369
// (#d98324 #f7b733 #ffd98a #f7e4c0 #e3cfae #8a5214 #4a2a08 #1a0d02 #2d1c0a #1c1206
// #0f0903) ชุดชมพูฮอตพิงก์-ทองของ PUNPRO168 (#f41571 #ff5ca8 #fce343 #ffd94a #f0c3dc
// #fde7f2 #8a0a45 #4a0426 #2a0012 #4a1038 #3a0a2a #2e0022 #1c0014) ชุดชมพูฮอต-ทอง
// ของ FAH999 (#ff3fa4 #ff6cbb #ffd1ea #fde8f3 #f5c53d #b3006a #4a0b42 #3a0534 #2e002c)
// ชุดทองแชมเปี้ยน-เงินโครเมียมของ UFA324 (#e5a81b #b9c2cc #231c0e #17130a #f0e8d4
// #ffcf5e #ffe08a #7d5a07 #43300a #464f5a) ชุดเขียวป่า-ทองมงกุฎของ KINGKONG555
// (#8ce023 #f2c230 #ffe066 #a87a08 #06220a) ชุดทองอวกาศ-เงินโครเมียมของ NAZA168
// (#fbc134 #ffe87a #cf9a18 #96690a #6b4a05 #eef2f8 #cfd6e3 #fdf3df #241700) และ
// ชุดทองเป็ด-ส้มปากเป็ดของ DUCK1688 (#f3bb34 #fde464 #c8901a #f58b2a #a3510c #f6ecd9)
// ออกครบทุกจุดแล้ว
// ⚠️ แดงของแบรนด์อื่นที่ยังค้างในไฟล์ inventory: SUPERSLOTCLUB #e8232a (R=232)
// PIGPG #d4200d (R=212) FLASH877 #ff3b14 (R=255 G=59) — ไม่มีตัวไหนเป็น #fb141b
// (R=251 G=20 B=27) ของรอบนี้ และโครเมียมขาว #fdfcfd / #b4bcc2 รอบนี้ก็ไม่ใช่
// #e9eef4 / #aeb9c6 ของ TKB55 หรือ #cfdcec / #9db4d4 ของ TSDET911 — เทียบเป็นตัวเลข
const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
// A real heading already names the region, so the aria-label is dropped in that
// case and only stands in when the title rendered as chrome (`as="p"`).
const named = Boolean(title) && TitleTag !== "p";
---

<section aria-label={named ? undefined : sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#fb141b]/35 bg-[#0b0303]/95 p-8 text-[#eceaea] shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-md transition-all duration-300 hover:border-[#fb141b]/80 hover:shadow-[0_15px_40px_rgba(251,20,27,0.26)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#fb141b] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#b4bcc2] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#fdfcfd] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#8a0609] to-transparent"></div>

    {
      title && (
        <TitleTag class="mb-4 bg-gradient-to-r from-[#fb141b] via-[#b4bcc2] to-[#fdfcfd] bg-clip-text text-center text-2xl leading-normal font-black text-transparent uppercase">{title}</TitleTag>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#eceaea]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#eceaea]">
        {
          titleleft && (
            <p class="flex items-center gap-2 border-b border-[#3b0405] pb-2 text-xl leading-normal font-black text-[#ff5f63] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#fb141b] shadow-[0_0_5px_rgba(251,20,27,0.8)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#eceaea] md:border-l md:border-[#3b0405] md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 border-b border-[#3b0405] pb-2 text-xl leading-normal font-black text-[#fdfcfd] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#b4bcc2] shadow-[0_0_5px_rgba(180,188,194,0.8)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
