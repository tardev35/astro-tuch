---
export interface Props {
  title?: string;
  /** Only the main `title` may become a real heading, and only when the page
   *  hands it a docx H2. Defaults to <p> so a chrome usage stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: TitleTag = "p", titleleft, titleright, label } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// The two column labels always render as <p>, never <h2>. The docx a page is
// filled from is a flat H1 + a handful of H2s, and the rendered heading
// inventory is diffed against it on every rebrand — a widget quietly adding two
// more <h2> is the thing that makes that diff disagree. A <p> heading needs the
// section to carry its own accessible name instead, which is what `label` is for.
const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";

// The intro-slot wrapper below carries a real `mb-8` and sits beside the grid,
// so it is one of the three ContentBox* wrappers that cannot be hoisted away.
//
// WY88 (รอบชมพูมาเจนตา-ทอง 2026-09-23): มุมตัดถูกไล่ด้วยเส้นคู่ละสอง — คู่บนซ้าย
// เป็นมาเจนตาหลัก #ec2b84 และคู่ล่างขวาเป็นทองหลัก #e8b33a กรอบจึงพาคู่สีของโลโก้
// (ตัว WY ชมพูมาเจนตา + เลข 88 ทอง) มาไว้ที่ตัวกรอบเองแทนที่จะใช้สีเดียว การ์ดเป็น
// พื้นการ์ดพลัม #24081a ในเส้นไรผมมาเจนตาเข้ม #a3145a และป้ายสองคอลัมน์แยกกัน
// ด้วยสี — ทองฝั่งซ้าย มาเจนตาฝั่งขวา ม่วง-ทองของ FAH999 หายไปทั้งหมด
---

<section aria-label={sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#a3145a]/70 bg-[#24081a]/92 p-8 text-[#fce9f3] shadow-[0_10px_30px_rgba(236,43,132,0.2)] backdrop-blur-md transition-all duration-300 hover:border-[#e8b33a]/55 hover:shadow-[0_15px_40px_rgba(232,179,58,0.28)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#ec2b84] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#e8b33a] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#ec2b84] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#e8b33a] to-transparent"></div>

    {
      title && (
        <TitleTag class="mb-4 bg-gradient-to-r from-[#fced94] via-[#e8b33a] to-[#ec2b84] bg-clip-text text-center text-2xl leading-normal font-black text-transparent uppercase">{title}</TitleTag>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#fce9f3]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#fce9f3]">
        {
          titleleft && (
            <p class="flex items-center gap-2 border-b border-[#a3145a]/70 pb-2 text-xl leading-normal font-black text-[#fced94] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#e8b33a] shadow-[0_0_5px_rgba(232,179,58,0.7)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#fce9f3] md:border-l md:border-[#a3145a]/70 md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 border-b border-[#a3145a]/70 pb-2 text-xl leading-normal font-black text-[#f9a8cd] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#ec2b84] shadow-[0_0_5px_rgba(236,43,132,0.8)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
