---
export interface Props {
  title?: string;
  /** Only the main `title` may become a real heading, and only when the page
   *  hands it a docx H2. Defaults to <p> so a chrome usage stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: TitleTag = "p", titleleft, titleright, label } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// The two column labels always render as <p>, never <h2>. The docx a page is
// filled from is a flat H1 + a handful of H2s, and the rendered heading
// inventory is diffed against it on every rebrand — a widget quietly adding two
// more <h2> is the thing that makes that diff disagree. A <p> heading needs the
// section to carry its own accessible name instead, which is what `label` is for.
const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";

// The intro-slot wrapper below carries a real `mb-8` and sits beside the grid,
// so it is one of the three ContentBox* wrappers that cannot be hoisted away.
//
// The cut corners are traced by two rules each: the top-left pair in gold and
// the bottom-right pair in brushed silver, so the frame itself carries the
// SUPERMAX168 two-tone rather than a single hue.
---

<section aria-label={sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#ba8219]/60 bg-[#0d0904]/92 p-8 text-[#f3e6c8] shadow-[0_10px_30px_rgba(236,201,100,0.18)] backdrop-blur-md transition-all duration-300 hover:border-[#ecc964]/55 hover:shadow-[0_15px_40px_rgba(236,201,100,0.28)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#f9e38b] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#e3e3e4] to-transparent"></div>
    <div class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#f9e38b] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#e3e3e4] to-transparent"></div>

    {
      title && (
        <TitleTag class="mb-4 bg-gradient-to-r from-[#fff8e2] via-[#f9e38b] to-[#ba8219] bg-clip-text text-center text-2xl leading-normal font-black text-transparent uppercase">{title}</TitleTag>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#f3e6c8]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e6c8]">
        {
          titleleft && (
            <p class="flex items-center gap-2 border-b border-[#ba8219]/60 pb-2 text-xl leading-normal font-black text-[#f9e38b] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#ecc964] shadow-[0_0_5px_rgba(236,201,100,0.7)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e6c8] md:border-l md:border-[#ba8219]/60 md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 border-b border-[#ba8219]/60 pb-2 text-xl leading-normal font-black text-[#e3e3e4] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#e3e3e4] shadow-[0_0_5px_rgba(227,227,228,0.8)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
