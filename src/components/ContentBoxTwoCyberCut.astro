---
export interface Props {
  title?: string;
  /** Only the main `title` may become a real heading, and only when the page
   *  hands it a docx H2. Defaults to <p> so a chrome usage stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: TitleTag = "p", titleleft, titleright, label } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// The two column labels always render as <p>, never <h2>. The docx a page is
// filled from is a flat H1 + a handful of H2s (plus a real H3 run this round),
// and the rendered heading inventory is diffed against it on every rebrand — a
// widget quietly adding two more <h2> is the thing that makes that diff
// disagree. A <p> heading needs the section to carry its own accessible name
// instead, which is what `label` is for.
//
// The intro-slot wrapper below carries a real `mb-8` and sits beside the grid,
// so it is one of the three ContentBox* wrappers that cannot be hoisted away.
//
// 1SS365 (รอบทอง-เงินโครเมียม-ดำ 2026-10-03): การ์ดเป็นผิวการ์ดอุ่น #1a1710 ในเส้น
// ไรผม #2a2115 ซึ่งเป็นผิวที่สว่างกว่าดำอมทอง #121010 ของ ContentBoxCyberCut ที่อยู่
// ใต้ลงไปบนหน้าเดียวกัน สองการ์ดมุมตัดจึงไม่อ่านเป็นใบเดียวกันซ้ำสองรอบ มุมตัดถูกไล่ด้วย
// เส้นคู่ละสอง — คู่บนซ้ายเป็นทองแบรนด์ #edbb23 กับเงินโครเมียม #c8cbce และคู่ล่างขวาเป็น
// ทองอ่อน #ffeeb4 กับทองลึก #a87708 กรอบจึงพาสองโลหะของโลโก้ (ตัวอักษร 1SS เงิน /
// เหรียญ 1 กับเลข 365 ทอง) มาไว้ที่ตัวกรอบเองแทนที่จะใช้สีเดียว ป้ายสองคอลัมน์แยกกัน
// ด้วยสี — ทองแบรนด์ฝั่งซ้าย เงินฝั่งขวา หัวข้อ docx ไล่เงิน → ทองอ่อน → ทองลึก ซึ่งเป็น
// คนละลำดับกับอีกห้ากล่องบนหน้าเดียวกัน เนื้อความ #f0e6d2 (BRAND_TEXT)
//
// ชุดทอง-เงินของ NATO168 ที่เคยค้างในไฟล์นี้ (#17120a #3a2a0d #101010 #edb543
// #fde8a8 #a9761f #e6e6e6 #f4ead3) ออกครบทุกจุดแล้ว
const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
// A real heading already names the region, so the aria-label is dropped in that
// case and only stands in when the title rendered as chrome (`as="p"`).
const named = Boolean(title) && TitleTag !== "p";
---

<section aria-label={named ? undefined : sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#2a2115] bg-[#1a1710]/92 p-8 text-[#f0e6d2] shadow-[0_10px_30px_rgba(5,5,5,0.85)] backdrop-blur-md transition-all duration-300 hover:border-[#edbb23]/60 hover:shadow-[0_15px_40px_rgba(237,187,35,0.28)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#edbb23] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#ffeeb4] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#c8cbce] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#a87708] to-transparent"></div>

    {
      title && (
        <TitleTag class="mb-4 bg-gradient-to-r from-[#c8cbce] via-[#ffeeb4] to-[#a87708] bg-clip-text text-center text-2xl leading-normal font-black text-transparent uppercase">{title}</TitleTag>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#f0e6d2]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e6d2]">
        {
          titleleft && (
            <p class="flex items-center gap-2 border-b border-[#2a2115] pb-2 text-xl leading-normal font-black text-[#edbb23] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#edbb23] shadow-[0_0_5px_rgba(237,187,35,0.85)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e6d2] md:border-l md:border-[#2a2115] md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 border-b border-[#2a2115] pb-2 text-xl leading-normal font-black text-[#c8cbce] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#c8cbce] shadow-[0_0_5px_rgba(200,203,206,0.6)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
