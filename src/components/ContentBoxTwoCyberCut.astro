---
export interface Props {
  title?: string;
  /** Only the main `title` may become a real heading, and only when the page
   *  hands it a docx H2. Defaults to <p> so a chrome usage stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: TitleTag = "p", titleleft, titleright, label } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// The two column labels always render as <p>, never <h2>. The docx a page is
// filled from is a flat H1 + a handful of H2s (plus a real H3 pair this round),
// and the rendered heading inventory is diffed against it on every rebrand — a
// widget quietly adding two more headings is the thing that makes that diff
// disagree. A <p> heading needs the section to carry its own accessible name
// instead, which is what `label` is for.
//
// The intro-slot wrapper below carries a real `mb-8` and sits beside the grid,
// so it is one of the three ContentBox* wrappers that cannot be hoisted away.
//
// TND168 (รอบทองมังกรบนดำสนิท 2026-10-12, brand-spec §2):
// รอบนี้ **ไม่ใช่คู่สองฮิว และไม่ใช่ทองสองระดับแบบ TIGERWIN369 ด้วย** มันเป็น
// **ฮิวเดียวล้วน** — ทองหลัก #dfa310 เป็นสีเดียวของแบรนด์ (ตัวมังกรจีนขัดเงาและ
// ตัวอักษร TND168 บนเหรียญตรา) ส่วน #ffe4a3 กับ #c9b88e เป็น "ค่าอื่นของทองเดียวกัน"
// ไม่ใช่สีที่สอง พื้นเพจ **ดำสนิท** #000000 ตาม bg.json
// ⚠️ พื้นเพจดำสนิท จึงไม่มีผิวไหนจมต่ำกว่าพื้นได้เลย — #070502 คือก้นสุดที่ใช้ได้
//
// การ์ดมุมตัดใบแรกของหน้านี้ (อีกใบคือ ContentBoxSevenThree ที่ §4) — ใบนี้อยู่ที่
// **ผิวจม #070502** ซึ่งลึกกว่าผิวกลาง #120c04 ของใบนั้น และสองการ์ดมุมตัดก็ถูกคั่น
// ด้วย ContentBox (มุมกลม ผิวยก #1b1307) จึงไม่ได้ติดกัน มุมตัดที่นี่เป็น 30px
// ตื้นกว่า 36px ของ ContentBoxSevenThree
// มุมถูกไล่ด้วยเส้นคู่ละสอง และทุกเส้นเป็น "ค่าทองคนละระดับ" เพื่อให้กรอบเองพาทั้ง
// ไล่ของทองมาไว้ที่ตัวกรอบ — คู่บนซ้ายเป็นทองหลัก #dfa310 (แนวนอน) กับทองสว่าง
// #ffe4a3 (แนวตั้ง) และคู่ล่างขวาเป็นทองทราย #c9b88e (แนวนอน) กับทองลึก #8a5c09
// (แนวตั้ง) ทองหลักวางแนวนอน ทองสว่างวางแนวตั้ง
// ป้ายสองคอลัมน์แยกกันด้วย "ทองหลัก vs ทองสว่าง" ตรงๆ — ทองหลัก #dfa310 ฝั่งซ้าย
// (7.6:1 และเป็น text-xl font-black จึงเป็น large text) ทองสว่าง #ffe4a3 ฝั่งขวา
// (13.5:1) ส่วนทองลึก #8a5c09 (2.9:1) กับบรอนซ์ลึก #43240b ตกต่ำกว่า AA จึงเป็น
// จุดสี่เหลี่ยม เส้นคั่น และขอบเท่านั้น ไม่ใช่สีตัวอักษร
// หัวข้อ docx ไล่ทองหลัก #dfa310 → ทองทราย #c9b88e → ทองสว่าง #ffe4a3 ซึ่งเป็นลำดับ
// คนละชุดกับอีกหกกล่องบนหน้าเดียวกัน
// เนื้อความงาช้างอุ่น #f0e9dc (= BRAND_TEXT) — ~18:1 บนผิวจม #070502
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือทอง** ทองมาแล้วเก้าใน
// สิบเอ็ดรอบหลังสุด "มีทองอยู่แล้ว" จึงไม่พิสูจน์อะไรเลย: ชุดทองอำพันเสือของ
// TIGERWIN369 ที่เคยค้างอยู่ทั้งไฟล์นี้ (#d98324 #f7b733 #ffd98a #f7e4c0 #e3cfae
// #8a5214 #4a2a08 #1a0d02 #2d1c0a #1c1206 #0f0903) ชุดชมพูฮอตพิงก์-ทองของ PUNPRO168
// รอบก่อน (#f41571 #ff5ca8 #fce343 #ffd94a #f0c3dc #fde7f2 #8a0a45 #4a0426 #2a0012
// #4a1038 #3a0a2a #2e0022 #1c0014) ชุดชมพูฮอต-ทองของ FAH999 (#ff3fa4 #ff6cbb #ffd1ea
// #fde8f3 #f5c53d #b3006a #4a0b42 #3a0534 #2e002c) ชุดทองแชมเปี้ยน-เงินโครเมียมของ
// UFA324 (#e5a81b #b9c2cc #231c0e #17130a #f0e8d4 #ffcf5e #ffe08a #7d5a07 #43300a
// #464f5a) ชุดเขียวป่า-ทองมงกุฎของ KINGKONG555 (#8ce023 #f2c230 #ffe066 #a87a08
// #06220a) ชุดทองอวกาศ-เงินโครเมียมของ NAZA168 (#fbc134 #ffe87a #cf9a18 #96690a
// #6b4a05 #eef2f8 #cfd6e3 #fdf3df #241700) และชุดทองเป็ด-ส้มปากเป็ดของ DUCK1688
// (#f3bb34 #fde464 #c8901a #f58b2a #a3510c #f6ecd9) ออกครบทุกจุดแล้ว
// ⚠️ #e5a81b ของ UFA324 (R=229 G=168 B=27) ต่างจาก #dfa310 ของรอบนี้ (R=223 G=163
// B=16) อยู่ไม่กี่หน่วย และ #ffd98a ของ TIGERWIN369 ก็ไม่ใช่ #ffe4a3 — ห้ามกะด้วยตา
// ⚠️ **รอบนี้ไม่มีชมพู ไม่มีม่วง/พลัม ไม่มีเงิน/เทา ไม่มีเขียว ไม่มีน้ำเงิน ไม่มี
// ส้มอำพัน และไม่มีแดงเลย** #b9c2cc #464f5a #cfd6e3 #eef2f8 ต้องไม่เหลือ
const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
// A real heading already names the region, so the aria-label is dropped in that
// case and only stands in when the title rendered as chrome (`as="p"`).
const named = Boolean(title) && TitleTag !== "p";
---

<section aria-label={named ? undefined : sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#dfa310]/35 bg-[#070502]/95 p-8 text-[#f0e9dc] shadow-[0_10px_30px_rgba(0,0,0,0.6)] backdrop-blur-md transition-all duration-300 hover:border-[#dfa310]/80 hover:shadow-[0_15px_40px_rgba(223,163,16,0.26)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#dfa310] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#c9b88e] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#ffe4a3] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#8a5c09] to-transparent"></div>

    {
      title && (
        <TitleTag class="mb-4 bg-gradient-to-r from-[#dfa310] via-[#c9b88e] to-[#ffe4a3] bg-clip-text text-center text-2xl leading-normal font-black text-transparent uppercase">{title}</TitleTag>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#f0e9dc]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e9dc]">
        {
          titleleft && (
            <p class="flex items-center gap-2 border-b border-[#43240b] pb-2 text-xl leading-normal font-black text-[#dfa310] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#ffe4a3] shadow-[0_0_5px_rgba(255,228,163,0.8)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e9dc] md:border-l md:border-[#43240b] md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 border-b border-[#43240b] pb-2 text-xl leading-normal font-black text-[#ffe4a3] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#8a5c09] shadow-[0_0_5px_rgba(223,163,16,0.8)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
