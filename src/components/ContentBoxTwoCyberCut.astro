---
export interface Props {
  title?: string;
  /** Only the main `title` may become a real heading, and only when the page
   *  hands it a docx H2. Defaults to <p> so a chrome usage stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: TitleTag = "p", titleleft, titleright, label } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// The two column labels always render as <p>, never <h2>. The docx a page is
// filled from is a flat H1 + a handful of H2s (plus a real H3 run this round),
// and the rendered heading inventory is diffed against it on every rebrand — a
// widget quietly adding two more <h2> is the thing that makes that diff
// disagree. A <p> heading needs the section to carry its own accessible name
// instead, which is what `label` is for.
//
// The intro-slot wrapper below carries a real `mb-8` and sits beside the grid,
// so it is one of the three ContentBox* wrappers that cannot be hoisted away.
//
// หวยเฮง789 (รอบแดงนำ-ทองรอง 2026-10-01): มุมตัดถูกไล่ด้วยเส้นคู่ละสอง — คู่บนซ้าย
// เป็นทองรอง #f4bc5d กับทองอ่อน #ffefc2 และคู่ล่างขวาเป็นแดงสว่าง #e43434 กับแดง
// แบรนด์ #dc2224 กรอบจึงพาสองโทนของโลโก้ (คำว่า "หวย" แดงเลือดนก + "เฮง789" ทอง)
// มาไว้ที่ตัวกรอบเองแทนที่จะใช้สีเดียว การ์ดเป็นผิวพื้นส่วน #1c0606 ในเส้นไรผมแดง
// เข้มสุด #5c0a0a และป้ายสองคอลัมน์แยกกันด้วยสี — ทองรองฝั่งซ้าย ทองอ่อนฝั่งขวา
// หัวข้อ docx ไล่ทองรอง → ทองอ่อน → แดงสว่าง (4.5:1 บนผิวนี้) ซึ่งเป็นคนละลำดับกับ
// อีกสามกล่องบนหน้าเดียวกัน เนื้อความ #fbe3d4 (BRAND_TEXT)
//
// ชุดเขียวป่า-ทองของ หวยเต็ง ที่เคยค้างในไฟล์นี้ (#e5c04f #eafbe9 #fae474 #024a0f
// #062a12 #026314 #d8ead9) ออกครบทุกจุดแล้ว
const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
// A real heading already names the region, so the aria-label is dropped in that
// case and only stands in when the title rendered as chrome (`as="p"`).
const named = Boolean(title) && TitleTag !== "p";
---

<section aria-label={named ? undefined : sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#5c0a0a]/80 bg-[#1c0606]/92 p-8 text-[#fbe3d4] shadow-[0_10px_30px_rgba(220,34,36,0.18)] backdrop-blur-md transition-all duration-300 hover:border-[#dc2224]/60 hover:shadow-[0_15px_40px_rgba(244,188,93,0.28)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#f4bc5d] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#e43434] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#ffefc2] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#dc2224] to-transparent"></div>

    {
      title && (
        <TitleTag class="mb-4 bg-gradient-to-r from-[#f4bc5d] via-[#ffefc2] to-[#e43434] bg-clip-text text-center text-2xl leading-normal font-black text-transparent uppercase">{title}</TitleTag>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#fbe3d4]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#fbe3d4]">
        {
          titleleft && (
            <p class="flex items-center gap-2 border-b border-[#5c0a0a]/80 pb-2 text-xl leading-normal font-black text-[#f4bc5d] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#f4bc5d] shadow-[0_0_5px_rgba(244,188,93,0.85)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#fbe3d4] md:border-l md:border-[#5c0a0a]/80 md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 border-b border-[#5c0a0a]/80 pb-2 text-xl leading-normal font-black text-[#ffefc2] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#e43434] shadow-[0_0_5px_rgba(228,52,52,0.85)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
