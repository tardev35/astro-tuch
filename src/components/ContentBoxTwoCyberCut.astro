---
export interface Props {
  title?: string;
  /** Only the main `title` may become a real heading, and only when the page
   *  hands it a docx H2. Defaults to <p> so a chrome usage stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: TitleTag = "p", titleleft, titleright, label } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// The two column labels always render as <p>, never <h2>. The docx a page is
// filled from is a flat H1 + a handful of H2s (plus a real H3 run this round),
// and the rendered heading inventory is diffed against it on every rebrand — a
// widget quietly adding two more <h2> is the thing that makes that diff
// disagree. A <p> heading needs the section to carry its own accessible name
// instead, which is what `label` is for.
//
// The intro-slot wrapper below carries a real `mb-8` and sits beside the grid,
// so it is one of the three ContentBox* wrappers that cannot be hoisted away.
//
// CK268 (รอบเขียวนีออน-โครเมียม-ดำ 2026-09-30): มุมตัดถูกไล่ด้วยเส้นคู่ละสอง — คู่
// บนซ้ายเป็นเขียวนีออนแบรนด์ #8bfc13 กับโครเมียมขาว #e8f0e6 และคู่ล่างขวาเป็น
// เขียวอ่อน #c9ff8f กับเขียวลึก #1a7a08 กรอบจึงพาสองโทนของโลโก้ (ตัว K เขียวนีออน
// + ตัว C โครเมียม) มาไว้ที่ตัวกรอบเองแทนที่จะใช้สีเดียว การ์ดเป็นผิวดำอมเขียว
// #071007 ในเส้นไรผมเขียวลึก และป้ายสองคอลัมน์แยกกันด้วยสี — เขียวอ่อนฝั่งซ้าย
// โครเมียมขาวฝั่งขวา หัวข้อ docx ไล่โครเมียมขาว → เขียวนีออน → เขียวลึก เนื้อความ
// #d5e6cd (BRAND_TEXT) — ชุดแดง-ทองของ LOTTOPLUS ที่ค้างในไฟล์นี้ (#dc020e
// #ff2d38 #6b0207 #f3c623 #fde79a #120b0c #f0e2e2) หายไปทั้งหมด
const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
// A real heading already names the region, so the aria-label is dropped in that
// case and only stands in when the title rendered as chrome (`as="p"`).
const named = Boolean(title) && TitleTag !== "p";
---

<section aria-label={named ? undefined : sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#1a7a08]/80 bg-[#071007]/92 p-8 text-[#d5e6cd] shadow-[0_10px_30px_rgba(139,252,19,0.18)] backdrop-blur-md transition-all duration-300 hover:border-[#8bfc13]/60 hover:shadow-[0_15px_40px_rgba(139,252,19,0.28)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#8bfc13] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#c9ff8f] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#e8f0e6] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#1a7a08] to-transparent"></div>

    {
      title && (
        <TitleTag class="mb-4 bg-gradient-to-r from-[#e8f0e6] via-[#8bfc13] to-[#1a7a08] bg-clip-text text-center text-2xl leading-normal font-black text-transparent uppercase">{title}</TitleTag>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#d5e6cd]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#d5e6cd]">
        {
          titleleft && (
            <p class="flex items-center gap-2 border-b border-[#1a7a08]/80 pb-2 text-xl leading-normal font-black text-[#c9ff8f] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#8bfc13] shadow-[0_0_5px_rgba(139,252,19,0.85)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#d5e6cd] md:border-l md:border-[#1a7a08]/80 md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 border-b border-[#1a7a08]/80 pb-2 text-xl leading-normal font-black text-[#e8f0e6] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#e8f0e6] shadow-[0_0_5px_rgba(232,240,230,0.85)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
