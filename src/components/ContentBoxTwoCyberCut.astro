---
export interface Props {
  title?: string;
  /** Only the main `title` may become a real heading, and only when the page
   *  hands it a docx H2. Defaults to <p> so a chrome usage stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: TitleTag = "p", titleleft, titleright, label } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// The two column labels always render as <p>, never a heading tag. The docx a
// page is filled from is a flat H1 + a handful of H2s (plus a real H3 pair this
// round), and the rendered heading inventory is diffed against it on every
// rebrand — a widget quietly adding two more headings is the thing that makes
// that diff disagree. A <p> heading needs the section to carry its own
// accessible name instead, which is what `label` is for.
//
// The intro-slot wrapper below carries a real `mb-8` and sits beside the grid,
// so it is one of the three ContentBox* wrappers that cannot be hoisted away.
// The home page passes no default slot this round, so it renders nothing.
//
// This card carries **docx H2 §7** of the home page (content.txt line 22,
// "ช่องทางติดต่อแอดมิน <แบรนด์> ตลอด 24ชม."). The brief writes that section as ONE
// running paragraph with no sub-labels, so the page runs its two halves one per
// column and passes no `titleleft`/`titleright` — inventing a pair would be the
// page's wording rather than the docx's.
//
// ───────────────────────────────────────────────────────────────────────────
// ยูฟ้า168 (2026-10-22) — พาเลตตาม .claude/brand-spec-ufabet168.md §2
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **เขียวมรกต-ทองสัมฤทธิ์บนผิวขาว ของ สาธุ168**
// ทั้งใบ จึงกลับทิศทั้งไฟล์: **รอบนี้กลับมาเป็นธีมมืด** พื้นเพจ #000000 (bg.json)
// การ์ดเนื้อหาเป็น **ผิวมืด + หมึกครีม** ห้ามแก้กลับเป็นพื้นสว่าง
// ลำดับผิว: #15130f ยก (การ์ดใบนี้) · #1e1a13 อุ่น · #0a0908 จม · #000000 พื้นเพจ
// อ่านจากอาร์ตเวิร์กจริง: โลโก้เป็นลูกฟุตบอลขาว-ดำลายทอง + หางวงโคจรทอง ข้างคำว่า
// "ยูฟ้า" ตัวอักษรไทยสามมิติสีทองอร่าม และเลข "168" ผิวโครเมียมเงิน — สองวัสดุคู่กัน
// ⚠️ ขาว-ดำของลูกฟุตบอล ฟ้าของจอหลัง และสีผิวนักแสดงเป็น **วัตถุในภาพ** ไม่ใช่สีแบรนด์
//
// จังหวะรูปทรงของใบนี้: **การ์ดมุมตัดเฉียง 30px ใบที่สองของหน้า** — ใบนี้ตัดมุม
// **ซ้ายบน-ขวาล่าง 30px บนผิวยก #15130f** ส่วน ContentBoxCyberCut (§3) ตัดมุม
// **40px บนผิวไล่ยก→จม** จึงไม่ซ้ำกันทั้งความลึกและขนาดของมุม
// มุมถูกไล่ด้วยเส้นคู่ละสอง และทุกเส้นเป็นคนละค่าของพาเลตต์: คู่บนซ้ายเป็น
// **ทองคานารี #fee45d (แนวนอน) กับ ทองกลาง #e6a416 (แนวตั้ง)** และคู่ล่างขวาเป็น
// **โครเมียมกลาง #a8b2bf (แนวนอน) กับ โครเมียมลึก #78828f (แนวตั้ง)** — มุมหนึ่ง
// เป็นทอง อีกมุมเป็นโครเมียม ต่างจาก §3 ที่ไขว้ทอง-โครเมียมภายในมุมเดียวกัน
// ⚠️ ทุกเส้นเป็น **พื้นถม 2px** ไม่ใช่ตัวอักษร
// ป้ายสองคอลัมน์แยกกันด้วย "ทองกลาง vs ทองคานารี" — #e6a416 ฝั่งซ้าย (8.7:1) และ
// #fee45d ฝั่งขวา (14.8:1) จุดนำหน้าสลับคู่กัน เส้นใต้ป้ายเป็นโครเมียมมืด #5a6472
// หัวข้อ docx ไล่ **สามสต็อป โครเมียมสว่าง #e8ecf1 → ทองคานารี #fee45d → ทองกลาง
// #e6a416** จัดกึ่งกลาง ซึ่งเป็นกล่องเดียวของหน้าที่หัวข้อมีสามสต็อป (§1 แผ่นถม ·
// §2 ทองทึบ · §3 ทองทึบ · §4 ไล่สองสต็อปทอง→ทองกลาง · §5 ไล่สองสต็อปโครเมียม→ทอง
// พร้อมแถบตั้ง · §6 ทองทึบพร้อมขีดใต้)
// ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ไม่ใช่พื้นหลัง ทุกสต็อป
// จึงต้องเป็นค่าที่ §2 อนุญาตให้ถือตัวอักษร (15.5 / 14.8 / 8.7:1 บนผิวยก) —
// **ห้ามเอา #78828f #5a6472 #7a4e05 หรือค่าผิวใดมาเป็นสต็อป**
// ⚠️ text-center อยู่บน <TitleTag> เท่านั้น ไม่ได้อยู่บนการ์ดหรือ <section> เพื่อไม่ให้
// ไหลลงไปจัดกึ่งกลางย่อหน้าในสล็อตด้วย
// เนื้อความ #eae3d4 (= BRAND_TEXT, 14.6:1) · **ไฮไลต์ <strong> มีสีเดียวคือ #fee45d**
// ซึ่งเป็นงานของหน้าเพจ
// rgba() ที่อนุญาตรอบนี้: rgba(254,228,93,α) · rgba(230,164,22,α) ·
// rgba(168,178,191,α) · rgba(0,0,0,α)
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักของรีโปนี้คือทอง** เพราะมันผ่าน
// มาแล้วเกือบทุกแบรนด์ ทองรอบนี้คือ **#fee45d (R254 G228 B93)** วัดจาก logo.webp
// ⚠️ **ufalion168 เป็นแบรนด์บอลเหมือนกันและเคยใช้สนามฟุตบอล** ส่วน **UFA324 เป็นชื่อ
// ที่ใกล้ที่สุด** — ห้ามเทียบด้วยแนวเรื่องหรือชื่อ ต้องเทียบทีละค่า
// ชุดเขียวมรกต-ทองสัมฤทธิ์ของ **สาธุ168** ที่เพิ่งอยู่ในไฟล์นี้ทั้งไฟล์ (0b7d28 0a5f1c
// 0f9b35 0c3a16 061f0c c9cb63 aeb04a 9ba03c d8ffc7 e9fbdd กับ rgba 11/125/40,
// 10/95/28, 12/58/22, 174/176/74) ออกครบแล้ว พร้อมกับชุด **แดงคริมสัน-ทองโบราณ**
// ของ รวยแท้168 (c30303 8f0505 e81313 dcb95f b8862b 96681f 4a0f0f 461212 280b0b
// ffeee8 fff1ef ffdbdb) และชุดของแบรนด์ขาออกรอบนี้ **โปรดี168** (eb0305 e40303 c20305
// 9b0a0c ff4446 401107 b44c06 7a2f03 f0b46a d9803a 4d1c0a 2c1004 fff0e4 fff4ea ffd1d1
// 1a0802) — ต้องไม่เหลือสักค่า เช่นเดียวกับ ดวงเศรษฐี168 (f0c878 fff8d8 d9212a 8e1a16
// 4e2120 300605 150303 2a0608) มีทรัพย์168 (dd1b74 a4186b 4a0d35 2d0720 f7dcf6 f0ccf5)
// ufalion168 (d4922c fdfc71 a25b24 8c4312 d39c45 f6e3b4 33200a 1f1304 0a0601 5a3310
// 1a1000) UFA324 (e5a81b ffe08a bb8410 7d5a07 43300a 17130a 312713 0d0b06 140d01
// 8792a0 f0e8d4 b9c2cc 464f5a) CEO66 (020617 7e22ce d946ef f5d0fe a855f7) รวยเทพ168
// (f0bb4e ffeccb e4021b d9701a 3b1b0e 260d04 0d0501 5c2a06 fff8ec 2b1400) นินจา168
// (32bcfb a9e9ff fef54b 07335f 6b5c10 0c2a3d 071a28 030e16 041019 dceefc) มีเฮ168
// (fb1b32 ff8f9c 5c0410 fcd45c 6b4a08 2b0711 1a040a 0c0205 fdeaec 1b0308) รวยแทร่168
// (039cfa 0494f5 c3ebfc 04366b f9a826 704504 e3f2fc 0b2d52 071e38 030f1d 031320)
// สบายเบท168 (2f9ff5 a8dcff d6ecff 0b3f78 ffc82e 5c4a16 e8f4ff 0e2238 081726 040d16
// 04121f) ถอนชัวร์168 (fa63b9 ffb3de ffd84d 2b0f20 1a0914 0d040a 6d0b3f 6b4708 2a0617
// fdeaf5) มีโชค168 (fcd434 ffeaa0 f5469f ff8dc6 8c0f52 7a5508 1a0612 f6e4ee 24101c
// 160a12 0b0509) ขวัญใจ168 (f7c92b ffe6a3 f2bba5 c98a74 b3121b 5a0a0e 8a5f12 eadfce
// 140c06 241509 160d06 0b0603) รับตัง168 (f0b429 ffdc8c d30304 ff6b6e a00203 4a0202
// 9a6c0c cfd9e6 f5ece0 2b100f 200a09 140505 1a0505) สมหวัง168 (fa0513 ffadaf ff5a5f
// e3b23c ffe5a8 8a6210 b90203 8c0204 5b0203 3c0303 170504 f4ecea ccb9b6 2c1413)
// หวยคิง (cd9a2c fdeb7c ab7314 f5e7c8 fcd4c3 fce2d4 0c0b0a 120a02 1c140b) หวย365
// (140203 dc0203 f5282a ffc93c ffeab0 8c0402 3a0a0c c08a07 f6e7e0 1a0303) และ TSDET911
// (0360f3 0292fb 6ec8ff cfdcec 9db4d4 dde8f7 102a5e 0a1c42 040e26 00081f 2563eb)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีฟ้า/น้ำเงิน ไม่มีม่วง/ไวโอเลต ไม่มีแดง ไม่มีส้ม ไม่มีโรสโกลด์
// ไม่มีเขียว และไม่มีชมพู/ฟูเชีย** — เงิน/โครเมียมรอบนี้ **มี** แต่เป็นชุด
// #e8ecf1 / #a8b2bf / #78828f / #5a6472 เท่านั้น ไม่ใช่เทาของ UFA324 หรือ TSDET911
const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
// A real heading already names the region, so the aria-label is dropped in that
// case and only stands in when the title rendered as chrome (`as="p"`).
const named = Boolean(title) && TitleTag !== "p";
---

<section aria-label={named ? undefined : sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#e6a416]/40 bg-[#15130f] p-8 text-[#eae3d4] shadow-[0_10px_30px_rgba(0,0,0,0.55)] transition-all duration-300 hover:border-[#fee45d]/75 hover:shadow-[0_15px_40px_rgba(254,228,93,0.2)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#fee45d] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#a8b2bf] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#e6a416] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#78828f] to-transparent"></div>

    {
      title && (
        <TitleTag class="mb-4 bg-gradient-to-r from-[#e8ecf1] via-[#fee45d] to-[#e6a416] bg-clip-text text-center text-2xl leading-normal font-black text-transparent uppercase">{title}</TitleTag>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#eae3d4]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#eae3d4]">
        {
          titleleft && (
            <p class="flex items-center gap-2 border-b border-[#5a6472]/55 pb-2 text-xl leading-normal font-black text-[#e6a416] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#fee45d] shadow-[0_0_5px_rgba(254,228,93,0.8)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#eae3d4] md:border-l md:border-[#5a6472]/55 md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 border-b border-[#5a6472]/55 pb-2 text-xl leading-normal font-black text-[#fee45d] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#a8b2bf] shadow-[0_0_5px_rgba(168,178,191,0.8)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
