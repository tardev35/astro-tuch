---
export interface Props {
  title?: string;
  /** Only the main `title` may become a real heading, and only when the page
   *  hands it a docx H2. Defaults to <p> so a chrome usage stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: TitleTag = "p", titleleft, titleright, label } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// The two column labels always render as <p>, never a heading tag. The docx a
// page is filled from is an H1 + a handful of H2s (plus a real H3 pair this
// round), and the rendered heading inventory is diffed against it on every
// rebrand — a widget quietly adding two more headings is the thing that makes
// that diff disagree. A <p> heading needs the section to carry its own
// accessible name instead, which is what `label` is for.
//
// The intro-slot wrapper below carries a real `mb-8` and sits beside the grid,
// so it is one of the three ContentBox* wrappers that cannot be hoisted away.
// **ห้ามยุบ wrapper นี้** The home page passes no default slot this round, so it
// renders nothing.
//
// รอบนี้ (WIN8S) การ์ดใบนี้ถือ **docx H2 §7** ของหน้าแรก ("แอดมิน <แบรนด์>
// ออนไลน์ตลอด 24ชม." — content.txt บรรทัด 21 ย่อหน้าเต็มอยู่บรรทัด 22) บรีฟเขียน
// หัวข้อนี้เป็น **ย่อหน้าเดียวรวด ไม่มีป้ายย่อย** หน้าเพจจึงผ่าสองครึ่งลงสองคอลัมน์
// และ **ไม่ส่ง titleleft/titleright** — การตั้งชื่อคอลัมน์เองจะเป็นถ้อยคำของหน้าเพจ
// ไม่ใช่ของ docx
// ⚠️ `as` ของไฟล์นี้ default เป็น **"p"** → หน้าแรกต้องส่ง **as="h2" ชัดเจน**
// ไม่ส่งแล้วหัวข้อของบรีฟจะกลายเป็นย่อหน้า และ inventory จะเหลือ h2 สี่ใบ
//
// ───────────────────────────────────────────────────────────────────────────
// WIN8S (ดรอป 2026-10-28) — พาเลตตาม .claude/brand-spec-win8s.md §2
// **ส้มเพลิง f27a1a นำ · ทองอำพัน e5a92b กับเงินโครเมียม c9d2dc รอง · มืดทั้งเว็บ**
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **เขียวมรกต/เงิน/ทองบนธีมมืดของ ZORO365** ทั้งใบ
// จึงรีเธมทั้งไฟล์ bg.json ของดรอปนี้เป็น mode color + color 1e0101 = ดำอมเลือดหมู
// **ห้าม "แก้" การ์ดให้กลับไปเป็นพื้นขาว และห้ามเหลือเขียวไว้เลยสักค่า**
// (หมึก fdf0e6 บนพื้นขาวจะหายไปเลย ไม่ใช่แค่จางลง)
// 🚨🚨 **ZNOVA168 เป็นน้ำตาลเข้ม/อำพัน = ตระกูลสีเดียวกับรอบนี้เป๊ะ** — "เจอส้ม/ทอง
// ≠ เป็นของรอบนี้" ต้องเทียบให้ตรงหกหลักทุกค่า
//
// ลำดับผิว: 140302 ลึกสุด · 250604 โครม · **2a0a04 ผิวการ์ด (ใบนี้)** ·
// 3b130b ชั้นยก · 1e0101 พื้นเพจ — ใบนี้นั่งอยู่บน **ผิวการ์ดทึบ** ซึ่งต่างจาก
// §6 ที่นั่งบนผิวจม 140302 และ §4 ที่ไล่ผิวการ์ด->ชั้นยก
//
// จังหวะรูปทรงของใบนี้: **การ์ดมุมตัดเฉียง 30px ที่ตัดมุมซ้ายบน-ขวาล่าง** ซึ่ง
// **กลับทิศจาก §6** (ที่ตัดขวาบน-ซ้ายล่าง) เส้นรูดสี่มุมเป็น **ส้มเพลิง-ทองอำพัน-
// เงินโครเมียม-ขอบน้ำตาล** ซึ่งคือชุดสีของเวิร์ดมาร์กและขอบแคปซูลบนอาร์ตเวิร์กตรงๆ
// ⚠️ ใบนี้เป็น **ใบเดียวของหน้าที่มีแถบสั้นกึ่งกลางอยู่ "เหนือ" หัวข้อ** แล้วหัวข้อ
// จัดกึ่งกลางตาม (§8 Faq2 ก็กึ่งกลาง แต่ขีดอยู่ "ใต้" หัวข้อและไม่มีการ์ดครอบ)
// ⚠️ `text-center` อยู่บน <TitleTag> เท่านั้น **ไม่ได้อยู่บนการ์ดหรือ <section>**
// เพื่อไม่ให้ไหลลงไปจัดกึ่งกลางย่อหน้าในสล็อตด้วย
//
// บทบาทสีในไฟล์นี้:
//   หัวข้อ — **เงินโครเมียม c9d2dc ทึบสีเดียว ไม่ใช่ bg-clip-text ไล่เฉด**
//     (12.0:1 บนผิวการ์ด 2a0a04) ซึ่งเป็นลายเซ็นของอักขระชุดโครเมียมบนเวิร์ดมาร์ก
//     และไม่ซ้ำกับหัวข้อของกล่องอื่นบนหน้าเดียวกัน (§1/§3 หมึกบนแผ่นถม · §2/§6
//     ไล่เฉด clip-text · §4 ทองอำพันทึบ · §5 ส้มทึบ · §8 ไล่ส้ม->ทอง)
//   แถบเหนือหัวข้อ + เส้นรูดสี่มุม — **พื้นถม 2-3px ไม่ใช่ตัวอักษร** จึงใช้
//     f27a1a / c9d2dc / e5a92b / 8a3a12 ได้
//   ป้ายคอลัมน์ (ถ้าแบรนด์ถัดไปส่งมา) — ซ้าย **f27a1a** (6.6:1) ขวา **e5a92b**
//     (8.8:1) จุดนำหน้าสลับคู่กัน ซึ่งเป็นพื้นถม
//   เส้นคั่นคอลัมน์และขอบการ์ด 5a2410 อิ่มเป็น 8a3a12 ตอน hover — **ห้ามถือ
//     ตัวอักษรทุกบริบท**
//   เนื้อความ fdf0e6 (= BRAND_TEXT) 16.4:1 บนผิวการ์ด · หมึกรอง e0bda4 (10.5:1) ·
//     **ไฮไลต์ <strong> มีสีเดียวคือ f27a1a** ซึ่งเป็นงานของหน้าเพจ
// 🚨 **ไฟล์นี้ไม่มีพื้นถมที่ถือตัวอักษรเลย** ถ้าจะเพิ่ม พื้นต้องเป็นไล่เฉดปุ่ม CTA
// ของ §2 (f0a21e -> f27a1a -> e8620e) **พร้อมหมึกเข้ม 1e0101 เท่านั้น — ขาวบนเฉด
// นั้นได้แค่ 2.8:1 และ §2 ห้ามไว้ตรง ๆ**
// rgba() ที่อนุญาตรอบนี้: rgba(242,122,26,α) · rgba(229,169,43,α) ·
// rgba(138,58,18,α) · rgba(30,1,1,α) · rgba(20,3,2,α)
//
// **ลิสต์เฮกซ์เต็มของทุกแบรนด์ที่ต้องกวาดออกอยู่ที่ .claude/brand-spec-win8s.md §2
// — ไม่ซ้ำลงที่นี่โดยตั้งใจ** ค่าที่เพิ่งอยู่ทั้งใบนี้และกวาดออกครบแล้ว (ZORO365):
//   3ddc4a 35a043 1e7033 0e5424 073c1a 031b09 010d04 002908 eef7f0 dfe6e3 e8c86a
//   9dc2a5 + rgba(61,220,74) rgba(1,13,4)
// (เขียนแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
// ⚠️ **รอบนี้ไม่มีเขียว ไม่มีแดงชาด ไม่มีฟ้า/ไซแอน/น้ำเงิน ไม่มีม่วง ไม่มีชมพู
// และไม่มีผิวสว่างเลยสักเฉด** — ผิวโครเมียมเงินของเวิร์ดมาร์ก แถบทองสาด ซากุระ
// และฉากห้องสว่างเป็นอาร์ตเวิร์ก ไม่ใช่สี UI (เขียว 00B900 ของปุ่ม LINE และเขียว
// success ของฟีดถอนเงินอยู่ไฟล์อื่น คงไว้ ห้ามกลืนเข้าพาเลตส้มของรอบนี้)
const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
// A real heading already names the region, so the aria-label is dropped in that
// case and only stands in when the title rendered as chrome (`as="p"`).
const named = Boolean(title) && TitleTag !== "p";
---

<section aria-label={named ? undefined : sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#5a2410] bg-[#2a0a04] p-8 text-[#fdf0e6] shadow-[0_10px_30px_rgba(20,3,2,0.55)] transition-all duration-300 hover:border-[#8a3a12] hover:shadow-[0_15px_40px_rgba(242,122,26,0.22)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#f27a1a] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#e5a92b] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#c9d2dc] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#8a3a12] to-transparent"></div>

    {
      title && (
        <header class="mb-6 flex flex-col items-center gap-3">
          <span aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#f27a1a] via-[#c9d2dc] to-[#e5a92b]" />
          <TitleTag class="text-center text-2xl leading-normal font-black tracking-wide text-[#c9d2dc]">{title}</TitleTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#fdf0e6]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#fdf0e6]">
        {
          titleleft && (
            <p class="flex items-center gap-2 border-b border-[#5a2410] pb-2 text-xl leading-normal font-black text-[#f27a1a]">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 rounded-full bg-[#f27a1a]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#fdf0e6] md:border-l md:border-[#5a2410] md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 border-b border-[#5a2410] pb-2 text-xl leading-normal font-black text-[#e5a92b]">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 rounded-full bg-[#e5a92b]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
