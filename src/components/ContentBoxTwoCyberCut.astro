---
export interface Props {
  title?: string;
  /** Only the main `title` may become a real heading, and only when the page
   *  hands it a docx H2. Defaults to <p> so a chrome usage stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: TitleTag = "p", titleleft, titleright, label } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// The two column labels always render as <p>, never <h2>. The docx a page is
// filled from is a flat H1 + a handful of H2s (plus a real H3 run this round),
// and the rendered heading inventory is diffed against it on every rebrand — a
// widget quietly adding two more <h2> is the thing that makes that diff
// disagree. A <p> heading needs the section to carry its own accessible name
// instead, which is what `label` is for.
//
// The intro-slot wrapper below carries a real `mb-8` and sits beside the grid,
// so it is one of the three ContentBox* wrappers that cannot be hoisted away.
//
// หวย24 (รอบแดงแบรนด์ + ทอง บนดำอมแดง 2026-10-04): การ์ดมุมตัดใบที่ยกสูงที่สุดใน
// สามใบของหน้านี้ — ผิวการ์ดยก #230d0d ในเส้นไรผม #3d0a0a เทียบกับ
// ContentBoxCyberCut ที่เป็น #170707 และ SevenThreeCyberCut ที่เป็น #0a0303
// สามใบจึงไล่ระดับความลึกกัน ไม่ได้อ่านเป็นใบเดียวกันสามรอบ มุมตัดถูกไล่ด้วยเส้นคู่
// ละสอง — คู่บนซ้ายเป็นแดงแบรนด์ #d20a0a กับทองแบรนด์ #f5c33b และคู่ล่างขวาเป็น
// แดงสว่าง #ff3b3b กับทองลึก #a9761a กรอบจึงพาคู่สีของแบรนด์ (วงกลม 24 แดงใน
// โลโก้ กับตัวอักษรทองบนผ้าไหมแดงในแบนเนอร์) มาไว้ที่ตัวกรอบเองแทนที่จะใช้สีเดียว
// ป้ายสองคอลัมน์แยกกันด้วยสี — ทองแบรนด์ฝั่งซ้าย แดงสว่างฝั่งขวา หัวข้อ docx ไล่
// แดงสว่าง → ทองแบรนด์ → ทองลึก ซึ่งเป็นคนละลำดับกับอีกห้ากล่องบนหน้าเดียวกัน
// เนื้อความ #f7e2d6 (= BRAND_TEXT)
//
// ชุดทอง-เงินโครเมียมของ UP555 ที่เคยค้างในไฟล์นี้ (#1b1005 #2e1d08 #130b03
// #ebbb54 #fce675 #ab6d24 #d5d4d3 #f8eed9) ออกครบทุกจุดแล้ว
const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
// A real heading already names the region, so the aria-label is dropped in that
// case and only stands in when the title rendered as chrome (`as="p"`).
const named = Boolean(title) && TitleTag !== "p";
---

<section aria-label={named ? undefined : sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#3d0a0a] bg-[#230d0d]/92 p-8 text-[#f7e2d6] shadow-[0_10px_30px_rgba(5,1,1,0.85)] backdrop-blur-md transition-all duration-300 hover:border-[#d20a0a]/70 hover:shadow-[0_15px_40px_rgba(245,195,59,0.26)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#d20a0a] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#ff3b3b] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#f5c33b] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#a9761a] to-transparent"></div>

    {
      title && (
        <TitleTag class="mb-4 bg-gradient-to-r from-[#ff3b3b] via-[#f5c33b] to-[#a9761a] bg-clip-text text-center text-2xl leading-normal font-black text-transparent uppercase">{title}</TitleTag>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#f7e2d6]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e2d6]">
        {
          titleleft && (
            <p class="flex items-center gap-2 border-b border-[#3d0a0a] pb-2 text-xl leading-normal font-black text-[#f5c33b] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#f5c33b] shadow-[0_0_5px_rgba(245,195,59,0.85)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e2d6] md:border-l md:border-[#3d0a0a] md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 border-b border-[#3d0a0a] pb-2 text-xl leading-normal font-black text-[#ff3b3b] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#ff3b3b] shadow-[0_0_5px_rgba(255,59,59,0.7)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
