---
export interface Props {
  title?: string;
  /** Only the main `title` may become a real heading, and only when the page
   *  hands it a docx H2. Defaults to <p> so a chrome usage stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: TitleTag = "p", titleleft, titleright, label } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// The two column labels always render as <p>, never <h2>. The docx a page is
// filled from is a flat H1 + a handful of H2s (plus a real H3 run this round),
// and the rendered heading inventory is diffed against it on every rebrand — a
// widget quietly adding two more <h2> is the thing that makes that diff
// disagree. A <p> heading needs the section to carry its own accessible name
// instead, which is what `label` is for.
//
// The intro-slot wrapper below carries a real `mb-8` and sits beside the grid,
// so it is one of the three ContentBox* wrappers that cannot be hoisted away.
//
// NATO168 (รอบทอง-เงิน-ดำ 2026-10-02): การ์ดเป็นผิวแผงยกอุ่น #17120a ในเส้นไรผม
// #3a2a0d ซึ่งเป็นผิวที่สว่างกว่าดำสนิท #101010 ของ ContentBoxCyberCut ที่อยู่เหนือ
// ขึ้นไปบนหน้าเดียวกัน สองการ์ดมุมตัดจึงไม่อ่านเป็นใบเดียวกันซ้ำสองรอบ มุมตัดถูกไล่
// ด้วยเส้นคู่ละสอง — คู่บนซ้ายเป็นทองแบรนด์ #edb543 กับเงิน #e6e6e6 และคู่ล่างขวาเป็น
// ทองอ่อน #fde8a8 กับทองลึก #a9761f กรอบจึงพาสองโทนของโลโก้ (NATO เงิน / 168 ทอง)
// มาไว้ที่ตัวกรอบเองแทนที่จะใช้สีเดียว ป้ายสองคอลัมน์แยกกันด้วยสี — ทองแบรนด์ฝั่งซ้าย
// เงินฝั่งขวา หัวข้อ docx ไล่เงิน → ทองอ่อน → ทองลึก (4.7:1 บนผิวนี้) ซึ่งเป็นคนละ
// ลำดับกับอีกห้ากล่องบนหน้าเดียวกัน เนื้อความ #f4ead3 (BRAND_TEXT)
//
// ชุดแดง-ทองของ หวยเฮง789 ที่เคยค้างในไฟล์นี้ (#dc2224 #f4bc5d #ffefc2 #e43434
// #fbe3d4 #1c0606 #5c0a0a) ออกครบทุกจุดแล้ว
const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
// A real heading already names the region, so the aria-label is dropped in that
// case and only stands in when the title rendered as chrome (`as="p"`).
const named = Boolean(title) && TitleTag !== "p";
---

<section aria-label={named ? undefined : sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#3a2a0d] bg-[#17120a]/92 p-8 text-[#f4ead3] shadow-[0_10px_30px_rgba(4,3,0,0.85)] backdrop-blur-md transition-all duration-300 hover:border-[#edb543]/60 hover:shadow-[0_15px_40px_rgba(237,181,67,0.28)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#edb543] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#fde8a8] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#e6e6e6] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#a9761f] to-transparent"></div>

    {
      title && (
        <TitleTag class="mb-4 bg-gradient-to-r from-[#e6e6e6] via-[#fde8a8] to-[#a9761f] bg-clip-text text-center text-2xl leading-normal font-black text-transparent uppercase">{title}</TitleTag>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#f4ead3]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#f4ead3]">
        {
          titleleft && (
            <p class="flex items-center gap-2 border-b border-[#3a2a0d] pb-2 text-xl leading-normal font-black text-[#edb543] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#edb543] shadow-[0_0_5px_rgba(237,181,67,0.85)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#f4ead3] md:border-l md:border-[#3a2a0d] md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 border-b border-[#3a2a0d] pb-2 text-xl leading-normal font-black text-[#e6e6e6] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#e6e6e6] shadow-[0_0_5px_rgba(230,230,230,0.6)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
