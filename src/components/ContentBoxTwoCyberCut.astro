---
export interface Props {
  title?: string;
  /** Only the main `title` may become a real heading, and only when the page
   *  hands it a docx H2. Defaults to <p> so a chrome usage stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: TitleTag = "p", titleleft, titleright, label } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// The two column labels always render as <p>, never a heading tag. The docx a
// page is filled from is an H1 + a handful of H2s (plus a real H3 pair this
// round), and the rendered heading inventory is diffed against it on every
// rebrand — a widget quietly adding two more headings is the thing that makes
// that diff disagree. A <p> heading needs the section to carry its own
// accessible name instead, which is what `label` is for.
//
// The intro-slot wrapper below carries a real `mb-8` and sits beside the grid,
// so it is one of the three ContentBox* wrappers that cannot be hoisted away.
// **ห้ามยุบ wrapper นี้** The home page passes no default slot this round, so it
// renders nothing.
//
// รอบนี้ (ABM96) การ์ดใบนี้ถือ **docx H2 §2** ของหน้าแรก ("<แบรนด์> บาคาร่า สล็อต
// รูเล็ต ไฮโล เริ่มต้น1บาท ไลฟ์เดิมพัน 24 ชั่วโมง" — content.txt บรรทัด 5 ย่อหน้า
// เต็มอยู่บรรทัด 6) บรีฟเขียนหัวข้อนี้เป็น **ย่อหน้าเดียวรวด ไม่มีป้ายย่อย**
// หน้าเพจจึงผ่าสองครึ่งลงสองคอลัมน์ (ซีกซ้าย = ห้าหมวดเกมที่บรีฟไล่ชื่อไว้ ·
// ซีกขวา = คำที่เว็บไซต์ระบุเอง พร้อมประโยคกำกับทั้งชุด) และ **ไม่ส่ง
// titleleft/titleright** — การตั้งชื่อคอลัมน์เองจะเป็นถ้อยคำของหน้าเพจ ไม่ใช่ของ docx
// ⚠️ `as` ของไฟล์นี้ default เป็น **"p"** → หน้าแรกต้องส่ง **as="h2" ชัดเจน**
// ไม่ส่งแล้วหัวข้อของบรีฟจะกลายเป็นย่อหน้า และ inventory จะเหลือ h2 สี่ใบ
// ⚠️ วิดเจ็ต ProviderGrid ถูกวางต่อท้ายการ์ดใบนี้ทันทีบนหน้าแรก เพราะหัวข้อนี้
// คือหัวข้อเดียวของบรีฟที่ไล่ชื่อ **หมวดเกม**
//
// ───────────────────────────────────────────────────────────────────────────
// ABM96 (ดรอป 2026-10-29) — พาเลตตาม .claude/brand-spec-abm96.md §2
// **ชมพูบานเย็น a30d63 นำ · ทองอำพัน f2c14e (โครมเท่านั้น) เป็นคู่รอง ·
// เนื้อหาสว่าง โครมเข้ม**
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **ส้มเพลิง/เงินโครเมียมบนธีมมืดของ WIN8S** ทั้งใบ
// จึงรีเธมทั้งไฟล์ และ **กลับทิศ 180° เป็นผิวสว่าง** bg.json ของดรอปนี้เป็น
// mode color + color f8b9f0 = ชมพูพาสเทลอิ่มตัว
// **ห้าม "แก้" การ์ดให้กลับไปเป็นพื้นมืด และห้ามเหลือส้มไว้เลยสักค่า**
// (หมึก 3d0a2c บนพื้นมืดจะหายไปเลย ไม่ใช่แค่จางลง)
// 🚨🚨 **okkub88 เป็นแบรนด์ชมพูเหมือนรอบนี้เป๊ะ** — "เจอชมพู ≠ เป็นของรอบนี้"
// ต้องเทียบให้ตรงหกหลักทุกค่า (d91a73 ↔ d11a7e · 9c0f55 b01160 ↔ a30d63 ·
// f9b2d9 ↔ f3a7d3 · ffd6fa ffe3f5 ↔ fcd9ee fff5fb) และ 123BET มี a30d1a ซึ่ง
// ต่างจาก a30d63 แค่สองหลักท้าย
//
// ลำดับผิว: 2b0620 ลึกสุด · 440d31 โครม · ffffff การ์ดขาว · **fff5fb การ์ดสำรอง
// (ใบนี้)** · fcd9ee พื้นถมอ่อน/ชั้นยก · f8b9f0 พื้นเพจ — ใบนี้นั่งอยู่บน
// **การ์ดสำรองขาวอมชมพูทึบ** ซึ่งต่างจาก §1/§6 ที่เป็นขาวล้วน และ §4/§7 ที่เป็น
// ผิวยก fcd9ee
//
// จังหวะรูปทรงของใบนี้: **การ์ดมุมตัดเฉียง 30px ที่ตัดมุมซ้ายบน-ขวาล่าง** เส้นรูด
// สี่มุมเป็น **ชมพูบานเย็น-ชมพูสว่าง-ชมพูเข้ม-เส้นบาง** ซึ่งคือชุดสีของเวิร์ดมาร์ก
// และขอบแคปซูลบนอาร์ตเวิร์กตรงๆ
// ⚠️ ใบนี้เป็น **ใบเดียวของหน้าที่มีแถบสั้นกึ่งกลางอยู่ "เหนือ" หัวข้อ** แล้วหัวข้อ
// จัดกึ่งกลางตาม (§6 ก็กึ่งกลาง แต่เส้นคาดอยู่ "ใต้" หัวข้อและการ์ดเป็นมุมกลม)
// ⚠️ `text-center` อยู่บน <TitleTag> เท่านั้น **ไม่ได้อยู่บนการ์ดหรือ <section>**
// เพื่อไม่ให้ไหลลงไปจัดกึ่งกลางย่อหน้าในสล็อตด้วย
//
// บทบาทสีในไฟล์นี้:
//   หัวข้อ — **ชมพูบานเย็น a30d63 ทึบสีเดียว ไม่ใช่ bg-clip-text ไล่เฉด**
//     (~7.3:1 บนผิวการ์ด fff5fb) ซึ่งไม่ซ้ำกับหัวข้อของกล่องอื่นบนหน้าเดียวกัน
//     (§1/§3 หมึกบนแผ่นถม · §4 ทึบคู่ชิปถม · §5 ทึบคู่แถบตั้ง · §6 ทึบกึ่งกลาง
//     เส้นคาดใต้ · §7/§8 ไล่เฉด clip-text)
//   แถบเหนือหัวข้อ + เส้นรูดสี่มุม — **พื้นถม 2-3px ไม่ใช่ตัวอักษร** จึงใช้
//     e0509f / d11a7e / ff7ac2 / f3a7d3 ได้
//   ป้ายคอลัมน์ (ถ้าแบรนด์ถัดไปส่งมา) — ซ้าย **a30d63** (7.3:1) ขวา **7a4263**
//     (7.3:1) จุดนำหน้าสลับคู่กัน ซึ่งเป็นพื้นถม
//   เส้นคั่นคอลัมน์และขอบการ์ด f3a7d3 อิ่มเป็น e0509f ตอน hover — **ห้ามถือ
//     ตัวอักษรทุกบริบท**
//   เนื้อความ 3d0a2c (= BRAND_TEXT) ~15.9:1 บนผิวการ์ด · หมึกรอง 7a4263 ·
//     **ไฮไลต์ <strong> มีสีเดียวคือ a30d63** ซึ่งเป็นงานของหน้าเพจ
// 🚨 **ไฟล์นี้ไม่มีพื้นถมที่ถือตัวอักษรเลย** ถ้าจะเพิ่ม พื้นต้องเป็นไล่เฉดปุ่ม CTA
// ของ §2 (d11a7e -> a30d63 -> 7a0449) **พร้อมหมึกขาวเท่านั้น — หมึกเข้ม 3d0a2c
// บนเฉดนั้นได้แค่ 1.5:1 และ §2 ห้ามไว้ตรง ๆ**
// rgba() ที่อนุญาตรอบนี้: rgba(163,13,99,α) · rgba(224,80,159,α) ·
// rgba(255,122,194,α) · rgba(209,26,126,α) · rgba(61,10,44,α) · rgba(43,6,32,α)
// **เงาบนการ์ดสว่างต้องเบา**: ปกติ rgba(61,10,44,0.10) · hover rgba(163,13,99,0.18)
//
// **ลิสต์เฮกซ์เต็มของทุกแบรนด์ที่ต้องกวาดออกอยู่ที่ .claude/brand-spec-abm96.md §2b
// — ไม่ซ้ำลงที่นี่โดยตั้งใจ** ค่าที่เพิ่งอยู่ทั้งใบนี้และกวาดออกครบแล้ว (WIN8S):
//   f27a1a e8620e f0a21e e5a92b c9d2dc 8a3a12 5a2410 3b130b 2a0a04 250604 140302
//   1e0101 fdf0e6 e0bda4 + rgba(242,122,26) rgba(229,169,43) rgba(138,58,18)
//   rgba(30,1,1) rgba(20,3,2)
// (เขียนแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
// ⚠️ **รอบนี้ไม่มีส้ม ไม่มีเขียว ไม่มีแดงชาด ไม่มีฟ้า/ไซแอน/น้ำเงิน ไม่มีม่วง
// และไม่มีผิวมืดในไฟล์นี้เลยสักเฉด** — ผิวโครมเข้ม 440d31 / 2b0620 / 5e1746
// สงวนไว้ให้ navbar/footer/ticker/Navfoot (เขียว 00B900 ของปุ่ม LINE และเขียว
// success ของฟีดถอนเงินอยู่ไฟล์อื่น คงไว้ ห้ามกลืนเข้าพาเลตชมพูของรอบนี้)
const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
// A real heading already names the region, so the aria-label is dropped in that
// case and only stands in when the title rendered as chrome (`as="p"`).
const named = Boolean(title) && TitleTag !== "p";
---

<section aria-label={named ? undefined : sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#f3a7d3] bg-[#fff5fb] p-8 text-[#3d0a2c] shadow-[0_10px_30px_rgba(61,10,44,0.10)] transition-all duration-300 hover:border-[#e0509f] hover:shadow-[0_15px_40px_rgba(163,13,99,0.18)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#d11a7e] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#ff7ac2] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#e0509f] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#f3a7d3] to-transparent"></div>

    {
      title && (
        <header class="mb-6 flex flex-col items-center gap-3">
          <span aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#e0509f] via-[#d11a7e] to-[#ff7ac2]" />
          <TitleTag class="text-center text-2xl leading-normal font-black tracking-wide text-[#a30d63]">{title}</TitleTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#3d0a2c]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#3d0a2c]">
        {
          titleleft && (
            <p class="flex items-center gap-2 border-b border-[#f3a7d3] pb-2 text-xl leading-normal font-black text-[#a30d63]">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 rounded-full bg-[#d11a7e]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#3d0a2c] md:border-l md:border-[#f3a7d3] md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 border-b border-[#f3a7d3] pb-2 text-xl leading-normal font-black text-[#7a4263]">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 rounded-full bg-[#e0509f]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
