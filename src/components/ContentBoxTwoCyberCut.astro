---
export interface Props {
  title?: string;
  /** Only the main `title` may become a real heading, and only when the page
   *  hands it a docx H2. Defaults to <p> so a chrome usage stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: TitleTag = "p", titleleft, titleright, label } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// The two column labels always render as <p>, never <h2>. The docx a page is
// filled from is a flat H1 + a handful of H2s (plus a real H3 run this round),
// and the rendered heading inventory is diffed against it on every rebrand — a
// widget quietly adding two more <h2> is the thing that makes that diff
// disagree. A <p> heading needs the section to carry its own accessible name
// instead, which is what `label` is for.
//
// The intro-slot wrapper below carries a real `mb-8` and sits beside the grid,
// so it is one of the three ContentBox* wrappers that cannot be hoisted away.
//
// หวยเต็ง (รอบเขียวป่า-ทอง 2026-10-01): มุมตัดถูกไล่ด้วยเส้นคู่ละสอง — คู่บนซ้าย
// เป็นทองแบรนด์ #e5c04f กับขาวอมเขียว #eafbe9 และคู่ล่างขวาเป็นทองอ่อน #fae474
// กับเขียวแบรนด์ลึก #024a0f กรอบจึงพาสองโทนของโลโก้ (คำว่า "หวย" เขียวมรกต +
// "เต็ง" ทอง) มาไว้ที่ตัวกรอบเองแทนที่จะใช้สีเดียว การ์ดเป็นผิวเขียวเข้ม #062a12
// ในเส้นไรผมเขียวแบรนด์ลึก และป้ายสองคอลัมน์แยกกันด้วยสี — ทองอ่อนฝั่งซ้าย
// ขาวอมเขียวฝั่งขวา หัวข้อ docx ไล่ขาวอมเขียว → ทองแบรนด์ → เขียวแบรนด์ #026314
// เนื้อความ #d8ead9 (BRAND_TEXT) — ชุดเขียวนีออน-โครเมียมของ CK268 ที่ค้างใน
// ไฟล์นี้ (#8bfc13 #c9ff8f #1a7a08 #e8f0e6 #071007 #d5e6cd) หายไปทั้งหมด
const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
// A real heading already names the region, so the aria-label is dropped in that
// case and only stands in when the title rendered as chrome (`as="p"`).
const named = Boolean(title) && TitleTag !== "p";
---

<section aria-label={named ? undefined : sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#024a0f]/80 bg-[#062a12]/92 p-8 text-[#d8ead9] shadow-[0_10px_30px_rgba(229,192,79,0.18)] backdrop-blur-md transition-all duration-300 hover:border-[#e5c04f]/60 hover:shadow-[0_15px_40px_rgba(229,192,79,0.28)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#e5c04f] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#fae474] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#eafbe9] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#024a0f] to-transparent"></div>

    {
      title && (
        <TitleTag class="mb-4 bg-gradient-to-r from-[#eafbe9] via-[#e5c04f] to-[#026314] bg-clip-text text-center text-2xl leading-normal font-black text-transparent uppercase">{title}</TitleTag>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#d8ead9]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#d8ead9]">
        {
          titleleft && (
            <p class="flex items-center gap-2 border-b border-[#024a0f]/80 pb-2 text-xl leading-normal font-black text-[#fae474] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#e5c04f] shadow-[0_0_5px_rgba(229,192,79,0.85)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#d8ead9] md:border-l md:border-[#024a0f]/80 md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 border-b border-[#024a0f]/80 pb-2 text-xl leading-normal font-black text-[#eafbe9] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#eafbe9] shadow-[0_0_5px_rgba(234,251,233,0.85)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
