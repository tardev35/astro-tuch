---
export interface Props {
  title?: string;
  /** Only the main `title` may become a real heading, and only when the page
   *  hands it a docx H2. Defaults to <p> so a chrome usage stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: TitleTag = "p", titleleft, titleright, label } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// The two column labels always render as <p>, never <h2>. The docx a page is
// filled from is a flat H1 + a handful of H2s (plus a real H3 set this round),
// and the rendered heading inventory is diffed against it on every rebrand — a
// widget quietly adding two more headings is the thing that makes that diff
// disagree. A <p> heading needs the section to carry its own accessible name
// instead, which is what `label` is for.
//
// The intro-slot wrapper below carries a real `mb-8` and sits beside the grid,
// so it is one of the three ContentBox* wrappers that cannot be hoisted away.
//
// TIGERWIN369 (รอบทองอำพันเสือบนดำสนิท 2026-10-11, brand-spec §2):
// รอบนี้ **ไม่ใช่คู่สองฮิว** แบบรอบก่อนๆ มันเป็น **ทองล้วนสองระดับ** — ทองอำพันเสือ
// #d98324 นำ (ขนหัวเสือ ขอบเหรียญตรา ตัวอักษรบนแบนเนอร์) และทองสว่าง #f7b733 เป็น
// ระดับที่สอง (หน้าตัวอักษร TIGERWIN369 สามมิติ มงกุฎทองบนหัวเสือ) พื้นเพจ **ดำสนิท**
// #000000 ตาม bg.json
// ⚠️ พื้นเพจดำสนิท จึงไม่มีผิวไหนจมต่ำกว่าพื้นได้เลย ต่างจากรอบ FAH999 ที่พื้นเป็น
// พลัมดำ #2e002c ผิวจม #0f0903 คือก้นสุดที่ใช้ได้ และยังสว่างกว่าพื้นเพจ
//
// การ์ดมุมตัดใบที่สองของหน้านี้ (อีกใบคือ ContentBoxSevenThree ที่ §5) — ใบนี้อยู่ที่
// ผิวกลาง #1c1206 ซึ่งตื้นกว่าผิวจม #0f0903 ของใบนั้น และลึกกว่าผิวยก #2d1c0a ของ
// ContentBox / ContentBox3ThreePremium ทั้งหน้าจึงไล่ระดับความลึกกันทีละชั้น และสอง
// การ์ดมุมตัดก็ถูกคั่นด้วย ContentBox3ThreePremium (มุมกลม ผิวยก) ไม่ได้ติดกัน
// มุมตัดที่นี่เป็น 30px ตื้นกว่า 36px ของ ContentBoxSevenThree
// มุมถูกไล่ด้วยเส้นคู่ละสอง — คู่บนซ้ายเป็นทองอำพัน #d98324 (แนวนอน) กับทองสว่าง
// #f7b733 (แนวตั้ง) และคู่ล่างขวาเป็นทองซีด #ffd98a (แนวนอน) กับอำพันลึก #8a5214
// (แนวตั้ง) กรอบจึงพาทั้งสองระดับทองมาไว้ที่ตัวกรอบเอง อำพันวางแนวนอน สว่างวางแนวตั้ง
// ป้ายสองคอลัมน์แยกกันด้วย "อำพัน vs ทองสว่าง" ตรงๆ — ทองอำพัน #d98324 ฝั่งซ้าย
// (text-xl font-black จึงเป็น large text) ทองสว่าง #f7b733 ฝั่งขวา ส่วนอำพันลึก
// #8a5214 กับ #4a2a08 ตกต่ำกว่า AA จึงเป็นจุดสี่เหลี่ยม เส้นคั่น และขอบเท่านั้น
// ไม่ใช่สีตัวอักษร
// หัวข้อ docx ไล่ทองอำพัน #d98324 → ทองซีด #ffd98a → ทองสว่าง #f7b733 ซึ่งเป็นลำดับ
// คนละชุดกับอีกหกกล่องบนหน้าเดียวกัน
// เนื้อความ #f7e4c0 (= BRAND_TEXT) — 15.2:1 บนผิวกลาง #1c1206
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — รอบนี้เป็นทองรอบที่แปดในสิบรอบ "มีทอง
// อยู่แล้ว" จึงไม่พิสูจน์อะไรเลย: ชุดชมพูฮอต-ทองของ FAH999 ที่เคยค้างในไฟล์นี้
// (#ff3fa4 #ff6cbb #ffd1ea #fde8f3 #f5c53d #9c6f08 #7a0046 #4a0b42 #3a0534 #2e002c
// #210220) ชุดทองแชมเปี้ยน-เงินโครเมียมของ UFA324 (#e5a81b #b9c2cc #231c0e #17130a
// #0d0b06 #f0e8d4 #ffcf5e #ffe08a #7d5a07 #43300a #464f5a) ชุดเขียวป่า-ทองมงกุฎของ
// KINGKONG555 (#8ce023 #5cc211 #2f8c07 #1a5c04 #f2c230 #ffe066 #a87a08 #bde397
// #e9f7d6 #0f2e05) ชุดทองอวกาศ-เงินโครเมียมของ NAZA168 (#fbc134 #ffe87a #cf9a18
// #96690a #6b4a05 #eef2f8 #cfd6e3 #3f4859 #fdf3df #4e3406 #432b03 #382400 #241700)
// ชุดทองเป็ด-ส้มอำพันของ DUCK1688 (#f3bb34 #fde464 #c8901a #f58b2a #a3510c #f6ecd9)
// และชุดชมพู-ม่วงของ BPLAY639 (#f472b6 #fbcfe8 #7e22ce #e9d5f5) ออกครบทุกจุดแล้ว
// ⚠️ #f58b2a ของ DUCK1688 เป็น "ส้มอำพัน" ที่ใกล้ #d98324 ของรอบนี้ที่สุดในสิบรอบ
// แต่ R=245/G=139 ไม่ใช่ R=217/G=131 และ #f2c230 ของ KINGKONG555 มี G=194 — เทียบ
// เป็นตัวเลขเท่านั้น
// ⚠️ **รอบนี้ไม่มีเงิน/เทาเลย** #b9c2cc #464f5a #cfd6e3 #eef2f8 #3f4859 ต้องไม่เหลือ
const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
// A real heading already names the region, so the aria-label is dropped in that
// case and only stands in when the title rendered as chrome (`as="p"`).
const named = Boolean(title) && TitleTag !== "p";
---

<section aria-label={named ? undefined : sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#d98324]/35 bg-[#1c1206]/95 p-8 text-[#f7e4c0] shadow-[0_10px_30px_rgba(0,0,0,0.6)] backdrop-blur-md transition-all duration-300 hover:border-[#d98324]/80 hover:shadow-[0_15px_40px_rgba(217,131,36,0.26)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#d98324] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#ffd98a] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#f7b733] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#8a5214] to-transparent"></div>

    {
      title && (
        <TitleTag class="mb-4 bg-gradient-to-r from-[#d98324] via-[#ffd98a] to-[#f7b733] bg-clip-text text-center text-2xl leading-normal font-black text-transparent uppercase">{title}</TitleTag>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#f7e4c0]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e4c0]">
        {
          titleleft && (
            <p class="flex items-center gap-2 border-b border-[#8a5214] pb-2 text-xl leading-normal font-black text-[#d98324] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#f7b733] shadow-[0_0_5px_rgba(247,183,51,0.8)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e4c0] md:border-l md:border-[#8a5214] md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 border-b border-[#8a5214] pb-2 text-xl leading-normal font-black text-[#f7b733] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#8a5214] shadow-[0_0_5px_rgba(217,131,36,0.8)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
