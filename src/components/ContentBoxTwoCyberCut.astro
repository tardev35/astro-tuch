---
export interface Props {
  title?: string;
  /** Only the main `title` may become a real heading, and only when the page
   *  hands it a docx H2. Defaults to <p> so a chrome usage stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: TitleTag = "p", titleleft, titleright, label } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// The two column labels always render as <p>, never <h2>. The docx a page is
// filled from is a flat H1 + a handful of H2s (plus a real H3 pair this round),
// and the rendered heading inventory is diffed against it on every rebrand — a
// widget quietly adding two more headings is the thing that makes that diff
// disagree. A <p> heading needs the section to carry its own accessible name
// instead, which is what `label` is for.
//
// The intro-slot wrapper below carries a real `mb-8` and sits beside the grid,
// so it is one of the three ContentBox* wrappers that cannot be hoisted away.
//
// KOON234 (รอบมรกตเข้ม-ทองบนเขียวเกือบดำ 2026-10-09, brand-spec §2):
// การ์ดมุมตัดใบกลางในสามใบของหน้านี้ — ผิวกลาง #09190d ซึ่งลึกกว่า ContentBoxCyberCut
// (#0d2414) และตื้นกว่า SevenThreeCyberCut (#051007) สามใบจึงไล่ระดับความลึกกัน ไม่ได้
// อ่านเป็นใบเดียวกันสามรอบ มุมตัดถูกไล่ด้วยเส้นคู่ละสอง — คู่บนซ้ายเป็นทองแบรนด์ #cc920a
// กับเขียวสว่าง #2fbf6a และคู่ล่างขวาเป็นทองซีด #fde9a6 กับเขียวมรกต #0a6b32 กรอบจึงพา
// ทั้งสองฮิวของแบรนด์ (ทองซีด → ทองแบรนด์ / เขียวสว่าง → เขียวมรกต) มาไว้ที่ตัวกรอบเอง
// แทนที่จะใช้เฉดเดียว และสลับฝั่งกับ ContentBoxCyberCut ที่วางทองไว้แนวนอน เขียวไว้แนวตั้ง
// ป้ายสองคอลัมน์แยกกันด้วย "ทอง vs เขียว" ตรงๆ — ทองสว่าง #f7d14e ฝั่งซ้าย เขียวสว่าง
// #2fbf6a ฝั่งขวา ทั้งคู่เป็นปลายสว่างของฮิวตัวเอง เพราะบนผิวมืดต้องใช้ปลายสว่าง
// ทองเข้ม #8a6204 กับเขียวเข้ม #043d1c ตกต่ำกว่า AA จึงถูกใช้เป็นเส้นคั่นเท่านั้น
// ไม่ใช่สีตัวอักษร
// หัวข้อ docx ไล่ทองสว่าง #f7d14e → เขียวสว่าง #2fbf6a → ทองซีด #fde9a6 ซึ่งเป็นคนละ
// ลำดับกับอีกหกกล่องบนหน้าเดียวกัน (ใบนี้เป็นใบเดียวที่พาดเขียวไว้กลางไล่เฉด)
// เนื้อความ #e8f2e6 (= BRAND_TEXT) — 16.1:1 บนผิวกลาง
//
// ชุดฟ้าสด-เหลืองมะนาวของ แตกดี168 (#0193fb #7bcffb #d4ecfd #064a86 #fce604 #c9a703
// #0a1726 #07111d #dbeafe) และชุดทองเมทัลลิกของ 789BETTING/UOK365 ก่อนหน้านั้น (#fad354
// #ffe79a #ddab33 #c9881f #8a6410 #4a3407 #0e0b05 #f3e7cd #c8912f #f5d98a #d8dbe0
// #a46b25 #6d4412 #120c07 #ece1cc) ออกครบทุกจุดแล้ว — ทองสองรอบก่อนเป็นคนละค่ากับทองของ
// รอบนี้ อย่าปล่อยไว้เพราะ "ทองอยู่แล้ว"
const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
// A real heading already names the region, so the aria-label is dropped in that
// case and only stands in when the title rendered as chrome (`as="p"`).
const named = Boolean(title) && TitleTag !== "p";
---

<section aria-label={named ? undefined : sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#cc920a]/35 bg-[#09190d]/95 p-8 text-[#e8f2e6] shadow-[0_10px_30px_rgba(0,0,0,0.6)] backdrop-blur-md transition-all duration-300 hover:border-[#cc920a]/80 hover:shadow-[0_15px_40px_rgba(204,146,10,0.26)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#cc920a] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#fde9a6] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#2fbf6a] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#0a6b32] to-transparent"></div>

    {
      title && (
        <TitleTag class="mb-4 bg-gradient-to-r from-[#f7d14e] via-[#2fbf6a] to-[#fde9a6] bg-clip-text text-center text-2xl leading-normal font-black text-transparent uppercase">{title}</TitleTag>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#e8f2e6]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#e8f2e6]">
        {
          titleleft && (
            <p class="flex items-center gap-2 border-b border-[#043d1c] pb-2 text-xl leading-normal font-black text-[#f7d14e] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#cc920a] shadow-[0_0_5px_rgba(204,146,10,0.75)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#e8f2e6] md:border-l md:border-[#043d1c] md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 border-b border-[#043d1c] pb-2 text-xl leading-normal font-black text-[#2fbf6a] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#0a6b32] shadow-[0_0_5px_rgba(10,107,50,0.7)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
