---
export interface Props {
  title?: string;
  /** Only the main `title` may become a real heading, and only when the page
   *  hands it a docx H2. Defaults to <p> so a chrome usage stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: TitleTag = "p", titleleft, titleright, label } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// The two column labels always render as <p>, never <h2>. The docx a page is
// filled from is a flat H1 + a handful of H2s, and the rendered heading
// inventory is diffed against it on every rebrand — a widget quietly adding two
// more <h2> is the thing that makes that diff disagree. A <p> heading needs the
// section to carry its own accessible name instead, which is what `label` is for.
const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#4a2409]/70 bg-[#0b0503]/92 p-8 text-[#ded4cb] shadow-[0_10px_30px_rgba(242,106,2,0.18)] backdrop-blur-md transition-all duration-300 hover:border-[#ff9130]/55 hover:shadow-[0_15px_40px_rgba(242,106,2,0.28)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#f26a02] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#e3e7ec] to-transparent"></div>
    <div class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#f26a02] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#e3e7ec] to-transparent"></div>

    {
      title && (
        <TitleTag class="mb-4 bg-gradient-to-r from-[#e3e7ec] via-[#ffb266] to-[#f26a02] bg-clip-text text-center text-2xl leading-normal font-black text-transparent uppercase">{title}</TitleTag>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#ded4cb]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#ded4cb]">
        {
          titleleft && (
            <p class="flex items-center gap-2 border-b border-[#4a2409]/70 pb-2 text-xl leading-normal font-black text-[#ffc48a] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#f26a02] shadow-[0_0_5px_rgba(242,106,2,0.7)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#ded4cb] md:border-l md:border-[#4a2409]/70 md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 border-b border-[#4a2409]/70 pb-2 text-xl leading-normal font-black text-[#e3e7ec] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#e3e7ec] shadow-[0_0_5px_rgba(227,231,236,0.8)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
