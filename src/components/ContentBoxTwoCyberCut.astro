---
export interface Props {
  title?: string;
  /** Only the main `title` may become a real heading, and only when the page
   *  hands it a docx H2. Defaults to <p> so a chrome usage stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: TitleTag = "p", titleleft, titleright, label } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// The two column labels always render as <p>, never a heading tag. The docx a
// page is filled from is a flat H1 + a handful of H2s (plus a real H3 pair this
// round), and the rendered heading inventory is diffed against it on every
// rebrand — a widget quietly adding two more headings is the thing that makes
// that diff disagree. A <p> heading needs the section to carry its own
// accessible name instead, which is what `label` is for.
//
// The intro-slot wrapper below carries a real `mb-8` and sits beside the grid,
// so it is one of the three ContentBox* wrappers that cannot be hoisted away.
//
// This card carries docx H2 §3 of the home page (content.txt line 8). The brief
// writes that section as ONE running paragraph with no sub-labels, so the page
// runs its two halves one per column and passes no `titleleft`/`titleright` —
// inventing a pair would be the page's wording rather than the docx's.
//
// มีเฮ168 (รอบ **แดงชาดนำ · ทองเนยเป็นฮิวที่สอง · แดงลึก/บรอนซ์ลึกไม่เคยถือ
// ตัวอักษร · บนดำสนิท** 2026-10-19, brand-spec §2): แดงแบรนด์ #fb1b32 มาจากตัวอักษร
// "เฮ168" บนโลโก้ โบว์แดงบนชุดลูกไม้ หัวใจแดง และจอยเกมสีแดงในงานศิลป์ ส่วนทองเนย
// #fcd45c คือหน้ายิ้มหัวเราะ กองเหรียญทอง และมงกุฎทอง
// พื้นเพจเป็น **ดำสนิท #000000** (bg.json) ลำดับความลึก: #2b0711 ยก / #1a040a กลาง
// / #0c0205 จม / #000000 พื้น
//
// การ์ดมุมตัดใบแรกของหน้านี้ — ใบนี้อยู่ที่ **ผิวจม #0c0205** ซึ่งลึกกว่าผิวกลางของ
// ContentBoxSevenThreeCyberCut (§5) และตัดมุม **ซ้ายบน-ขวาล่าง 30px** ส่วน §5 ตัด
// **ขวาบน-ซ้ายล่าง** เป็นภาพกระจก มุมถูกไล่ด้วยเส้นคู่ละสอง และทุกเส้นเป็นคนละค่า
// ของพาเลตต์ เพื่อให้กรอบเองพาทั้งไล่แดง-ทองมาไว้ที่ตัวกรอบ — คู่บนซ้ายเป็น
// แดงแบรนด์ #fb1b32 (แนวนอน) กับทองเนย #fcd45c (แนวตั้ง) และคู่ล่างขวาเป็น
// ทองเนย (แนวนอน) กับแดงลึก #5c0410 (แนวตั้ง) สลับขั้วกันสองมุม
// ป้ายสองคอลัมน์แยกกันด้วย "ชมพูบลัช vs ทองเนย" ตรงๆ — ชมพูบลัช #ff8f9c ฝั่งซ้าย
// (8.5:1) ทองเนย #fcd45c ฝั่งขวา (12.9:1) ส่วนจุดนำหน้าเป็นแดงแบรนด์กับทองเนย
// หัวข้อ docx ไล่ ทองเนย #fcd45c → แดงแบรนด์ #fb1b32 → ชมพูบลัช #ff8f9c ซึ่งเป็น
// ลำดับคนละชุดกับอีกเจ็ดกล่องบนหน้าเดียวกัน
// ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ไม่ใช่พื้นหลัง ทุกสต็อป
// จึงต้องเป็นค่าที่ §2 อนุญาตให้ถือตัวอักษรได้ — ห้ามเอา #5c0410 หรือ #6b4a08 มาเป็น
// ปลายไล่เฉด
// เนื้อความ #fdeaec (= BRAND_TEXT) — 19:1 บนผิวจม ซึ่งเป็นคอนทราสต์สูงสุดของหน้า
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้มีสองชั้น: แดง และ ทอง**
// เพราะทั้งคู่ผ่านรีโปนี้มาแล้วหลายแบรนด์ แดงรอบนี้ #fb1b32 **ห่างจาก fa0513 ของ
// สมหวัง168 แค่นิดเดียว** และฮิวที่สองรอบนี้เป็นทองเนย #fcd45c ไม่ใช่ทองอำพัน f9a826
// ชุดเต็มของรวยแทร่168 ที่ต้องไม่เหลือ (039cfa 0494f5 c3ebfc 04366b f9a826 704504
// e3f2fc 0b2d52 071e38 030f1d 031320) ชุดของนินจา168 ที่เพิ่งอยู่ในไฟล์นี้ (32bcfb
// a9e9ff fef54b 07335f 6b5c10 0c2a3d 071a28 030e16 041019 dceefc) ชุดของสบายเบท168
// (2f9ff5 a8dcff d6ecff 0b3f78 ffc82e 5c4a16 e8f4ff 0e2238 081726 040d16 04121f)
// ชุดของถอนชัวร์168 (fa63b9 ffb3de ffd84d 2b0f20 1a0914 0d040a 6d0b3f 6b4708 2a0617
// fdeaf5) ชุดของมีโชค168 (fcd434 ffeaa0 f5469f ff8dc6 8c0f52 7a5508 1a0612 f6e4ee
// 24101c 160a12 0b0509) ชุดของขวัญใจ168 (f7c92b ffe6a3 f2bba5 c98a74 b3121b 5a0a0e
// 8a5f12 eadfce 140c06 241509 160d06 0b0603) ชุดของรับตัง168 (f0b429 ffdc8c d30304
// ff6b6e a00203 4a0202 9a6c0c cfd9e6 f5ece0 2b100f 200a09 140505 1a0505) ชุดของ
// สมหวัง168 (fa0513 ffadaf ff5a5f e3b23c ffe5a8 8a6210 b90203 8c0204 5b0203 3c0303
// 170504 f4ecea ccb9b6 2c1413 1f0d0c 140706 290f0f) และชุดน้ำเงินไฟฟ้าของ TSDET911
// (0360f3 0292fb 6ec8ff cfdcec 9db4d4 dde8f7 102a5e 0a1c42 040e26 00081f 032dad
// 04186e 021026) ออกครบทุกค่าแล้ว รวมถึง 04225b · 2563eb
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีฟ้า/น้ำเงิน ม่วง/ไวโอเลต เขียว ส้ม เงิน/โครเมียม โรสโกลด์
// เหลืองมะนาว และชมพูฟูเชีย**
const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
// A real heading already names the region, so the aria-label is dropped in that
// case and only stands in when the title rendered as chrome (`as="p"`).
const named = Boolean(title) && TitleTag !== "p";
---

<section aria-label={named ? undefined : sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#fb1b32]/35 bg-[#0c0205]/95 p-8 text-[#fdeaec] shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-md transition-all duration-300 hover:border-[#fb1b32]/80 hover:shadow-[0_15px_40px_rgba(252,212,92,0.22)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#fb1b32] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#fcd45c] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#fcd45c] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#5c0410] to-transparent"></div>

    {
      title && (
        <TitleTag class="mb-4 bg-gradient-to-r from-[#fcd45c] via-[#fb1b32] to-[#ff8f9c] bg-clip-text text-center text-2xl leading-normal font-black text-transparent uppercase">{title}</TitleTag>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#fdeaec]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#fdeaec]">
        {
          titleleft && (
            <p class="flex items-center gap-2 border-b border-[#5c0410] pb-2 text-xl leading-normal font-black text-[#ff8f9c] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#fb1b32] shadow-[0_0_5px_rgba(251,27,50,0.8)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#fdeaec] md:border-l md:border-[#5c0410] md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 border-b border-[#5c0410] pb-2 text-xl leading-normal font-black text-[#fcd45c] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#fcd45c] shadow-[0_0_5px_rgba(252,212,92,0.8)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
