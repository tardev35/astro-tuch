---
export interface Props {
  title?: string;
  /** Only the main `title` may become a real heading, and only when the page
   *  hands it a docx H2. Defaults to <p> so a chrome usage stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: TitleTag = "p", titleleft, titleright, label } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// The two column labels always render as <p>, never a heading tag. The docx a
// page is filled from is an H1 + a handful of H2s (plus a real H3 pair this
// round), and the rendered heading inventory is diffed against it on every
// rebrand — a widget quietly adding two more headings is the thing that makes
// that diff disagree. A <p> heading needs the section to carry its own
// accessible name instead, which is what `label` is for.
//
// The intro-slot wrapper below carries a real `mb-8` and sits beside the grid,
// so it is one of the three ContentBox* wrappers that cannot be hoisted away.
// The home page passes no default slot this round, so it renders nothing.
//
// รอบนี้การ์ดใบนี้ถือ **docx H2 §2** ของหน้าแรก ("<แบรนด์> การันตีเว็บตรง
// ยอดเข้าบริษัทไม่ผ่านเอเย่นต์ ต้องเว็บแท้ที่นี่ที่เดียว" — content.txt บรรทัด 5
// ย่อหน้าเต็มอยู่บรรทัด 6) บรีฟเขียนหัวข้อนี้เป็น **ย่อหน้าเดียวรวด ไม่มีป้ายย่อย**
// หน้าเพจจึงผ่าสองครึ่งลงสองคอลัมน์และ **ไม่ส่ง titleleft/titleright** — การตั้งชื่อ
// คอลัมน์เองจะเป็นถ้อยคำของหน้าเพจ ไม่ใช่ของ docx
//
// ───────────────────────────────────────────────────────────────────────────
// MEXICANOSLOT (ดรอป 2026-10-24) — พาเลตตาม .claude/brand-spec-mexicanoslot.md §2
// **แดงเม็กซิกันนำ · ทอง/พีชฟางรอง · เขียวเม็กซิกันแอคเซนต์ · เนื้อหาธีมสว่าง**
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **ไซยาน-น้ำเงินอุลตรามารีนบนถ่านเกือบดำของ
// นาซ่า168** ทั้งใบ จึงรีเธมทั้งไฟล์ และ **กลับทิศ 180 องศาเป็นผิวสว่าง**:
// bg.json ของดรอปนี้เป็น {"mode":"color","color":"#fef6fb"} = ขาวอมชมพูจาง
// **ห้าม "แก้" การ์ดให้กลับไปเป็นพื้นมืด และห้ามเหลือไซยาน/น้ำเงินไว้เลยสักค่า**
// (navbar/footer/ticker รอบนี้เป็นผิวเข้ม #2b100a แต่ไฟล์นี้เป็นการ์ดเนื้อหา
// ไม่ใช่โครม — หมึก #3f130d บนพื้นมืดจะหายไปเลย ไม่ใช่แค่จางลง)
//
// ลำดับผิว: #ffffff การ์ด · **#fff3ea ยก (การ์ดใบนี้)** · #fde4d3 wash ·
// #fef6fb พื้นเพจ — ใบนี้นั่งอยู่บน **ผิวยกทึบ** ซึ่งต่างจาก §1/§3/§7 ที่เป็น
// การ์ดขาว และจาก §6 ที่ไล่ขาว→wash
//
// จังหวะรูปทรงของใบนี้: **การ์ดมุมตัดเฉียง 30px ใบแรกของสามใบมุมตัดบนหน้า** —
// ใบนี้ตัดมุม **ซ้ายบน-ขวาล่าง** เส้นรูดสี่มุมเป็น **แดง-เขียว-ทอง-พีช** ซึ่งคือ
// ชุดสีธงชาติ+เหรียญบนอาร์ตเวิร์กตรงๆ ส่วน §5 (SevenThreeCyberCut) ตัด 36px และ
// §6 (CyberCut) ตัด 40px พร้อมสันซ้ายสี่พิกเซล — สามใบจึงไม่อ่านซ้ำกัน
// ⚠️ ใบนี้เป็น **ใบเดียวของหน้าที่มีแถบสั้นกึ่งกลางอยู่ "เหนือ" หัวข้อ** แล้วหัวข้อ
// จัดกึ่งกลางตาม (§8 Faq3 ก็กึ่งกลาง แต่ขีดอยู่ "ใต้" หัวข้อและไม่มีการ์ดครอบ)
// ⚠️ `text-center` อยู่บน <TitleTag> เท่านั้น **ไม่ได้อยู่บนการ์ดหรือ <section>**
// เพื่อไม่ให้ไหลลงไปจัดกึ่งกลางย่อหน้าในสล็อตด้วย
//
// บทบาทสีในไฟล์นี้:
//   หัวข้อ — **#a81410 ทึบสีเดียว ไม่ใช่ bg-clip-text ไล่เฉด** (7.2:1 บนผิวยก
//     #fff3ea) ⚠️ ไล่เฉดบนผิวสว่างจะลากค่าที่ §2 ห้ามถือตัวอักษร (#de2b1e ที่
//     3.8:1 บนผิวยก) เข้ามาเป็นพิกเซลของตัวอักษรได้ง่ายเกินไป
//   แถบเหนือหัวข้อ + เส้นรูดสี่มุม — **พื้นถม 2px ไม่ใช่ตัวอักษร** จึงใช้
//     #de2b1e / #117a41 / #f2a033 / #fec28d ได้
//   ป้ายคอลัมน์ (ถ้าแบรนด์ถัดไปส่งมา) — ซ้าย **#a81410** (7.2:1) ขวา **#117a41**
//     (5.1:1 บนผิวยก) จุดนำหน้าสลับคู่กันเป็น #de2b1e / #f2a033 ซึ่งเป็นพื้นถม
//   เส้นคั่นคอลัมน์และขอบการ์ด #f6c4a4 อิ่มเป็น #de2b1e ตอน hover — **ห้ามถือ
//     ตัวอักษร**
//   เนื้อความ #3f130d (= BRAND_TEXT) 14.0:1 บนผิวยก · **ไฮไลต์ <strong> มีสีเดียว
//     คือ #a81410** ซึ่งเป็นงานของหน้าเพจ
// 🚨 **ขาวบน #de2b1e ได้แค่ 4.7:1 → ไม่มีหมึกขาวบนแดงในไฟล์นี้เลย** พื้นแดงที่รับ
// หมึกขาวได้ต้องเป็น #c81e12 ลงไป (อยู่ที่ §1 ไม่ใช่ที่นี่)
// rgba() ที่อนุญาตรอบนี้: rgba(222,43,30,α) · rgba(242,160,51,α) ·
// rgba(168,20,16,α) · rgba(63,19,13,α) · rgba(246,196,164,α) · rgba(254,215,181,α)
//
// ⚠️⚠️ **เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — กับดักของรีโปนี้รอบนี้คือแดง**
// มีแบรนด์เก่าอย่างน้อยหกเจ้าที่แดงนำ "เจอแดง ≠ เป็นของรอบนี้" แดงรอบนี้คือ
// **#de2b1e (R222 G43 B30) / #a81410 / #c81e12 / #9d140c / #6f0e08** เท่านั้น
// ค่าที่ต้องไม่เหลือ:
//   1fd8f0 0bb6d4 8fd9ec 1d4fd8 143aa0 e6edf8 9fb2cb 273449 1b2434 121722 33455f
//   0d1017 (**นาซ่า168 — ชุดที่เพิ่งอยู่ทั้งใบนี้**) ·
//   ffd6fa fff4fb ffe3f5 f9b2d9 f479b9 6a0f3c 95486b 9c0f55 fb439b fc74b5 ffc2e2
//   d91a73 b01160 85094a (**okkub88 — แบรนด์ขาออก เสี่ยงหลงเหลือสูงสุด**) ·
//   00bfff 12b4ef b6e3f0 7fcbe8 4fb8ea 06283f 0f5684 1a6ea8 (โบ๊ะบ๊ะ168) ·
//   fb2e33 cb0b0d d81115 b00d11 8a0608 1c0607 (สล็อต168 — ⚠️⚠️ **fb2e33 ↔ #de2b1e
//   และ cb0b0d / b00d11 ↔ #c81e12 / #a81410 ใกล้กันมาก ห้ามตัดสินด้วยสายตา**) ·
//   ff2e52 e01238 c9102f (มาดาม168) · c30303 8f0505 e81313 dcb95f 280b0b
//   (รวยแท้168) · d9212a 8e1a16 f0c878 (ดวงเศรษฐี168) · fb141b ff5f63 (GT66B) ·
//   eb0305 2c1004 4d1c0a b44c06 f0b46a (ค้างใน NavbarStyle4 — ⚠️ **f0b46a ↔
//   #f2a033 ต่างไบต์แรกเดียว**) · fa539c c2185b 8e0f41 fb8cc0 f7bcd9 ffe5ff
//   fff0f8 ffeef7 3b0b26 7a2350 (หมูบิน168) · f41571 ff5ca8 (PUNPRO168)
// ⚠️ ทอง/เหลืองของแบรนด์เก่า (ทองรอบนี้คือ **#f2a033 ค่าเดียว**): ffd84d f5ba14
//   fcee52 b37c0b ffd94a e3a712 9d6f06 eeae12 fded41 9f600d fcd434 fdcb0c fefb6b
//   fee45d e6a416 fef54b f7c92b d4922c fdfc71 e5a81b ffe08a f9a826 ffdc8c f0b429
//   ffc82e e0bd72 f6e4b4 d4af5a · เขียวของแบรนด์เก่า (เขียวรอบนี้คือ **#117a41**):
//   0b7d28 0a5f1c 0f9b35 0c3a16 061f0c (สาธุ168)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep สะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีฟ้า/ไซแอน/น้ำเงิน ไม่มีม่วง ไม่มีชมพู/แมเจนต้า ไม่มีครีม/เบจเย็น
// และไม่มีแรมป์เทาเงินเลยสักเฉด** — "SLOT" สีน้ำเงินในเวิร์ดมาร์กเป็นอาร์ตเวิร์ก
// ของโลโก้ ไม่ใช่สี UI
const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
// A real heading already names the region, so the aria-label is dropped in that
// case and only stands in when the title rendered as chrome (`as="p"`).
const named = Boolean(title) && TitleTag !== "p";
---

<section aria-label={named ? undefined : sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#f6c4a4] bg-[#fff3ea] p-8 text-[#3f130d] shadow-[0_10px_30px_rgba(168,20,16,0.12)] transition-all duration-300 hover:border-[#de2b1e] hover:shadow-[0_15px_40px_rgba(222,43,30,0.22)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#de2b1e] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#f2a033] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#117a41] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#fec28d] to-transparent"></div>

    {
      title && (
        <header class="mb-6 flex flex-col items-center gap-3">
          <span aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#117a41] via-[#de2b1e] to-[#f2a033]" />
          <TitleTag class="text-center text-2xl leading-normal font-black tracking-wide text-[#a81410]">{title}</TitleTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#3f130d]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#3f130d]">
        {
          titleleft && (
            <p class="flex items-center gap-2 border-b border-[#f6c4a4] pb-2 text-xl leading-normal font-black text-[#a81410]">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 rounded-full bg-[#de2b1e]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#3f130d] md:border-l md:border-[#f6c4a4] md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 border-b border-[#f6c4a4] pb-2 text-xl leading-normal font-black text-[#117a41]">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 rounded-full bg-[#f2a033]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
