---
export interface Props {
  title?: string;
  /** Only the main `title` may become a real heading, and only when the page
   *  hands it a docx H2. Defaults to <p> so a chrome usage stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: TitleTag = "p", titleleft, titleright, label } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// The two column labels always render as <p>, never <h2>. The docx a page is
// filled from is a flat H1 + a handful of H2s (plus a real H3 run this round),
// and the rendered heading inventory is diffed against it on every rebrand — a
// widget quietly adding two more <h2> is the thing that makes that diff
// disagree. A <p> heading needs the section to carry its own accessible name
// instead, which is what `label` is for.
//
// The intro-slot wrapper below carries a real `mb-8` and sits beside the grid,
// so it is one of the three ContentBox* wrappers that cannot be hoisted away.
//
// UP555 (รอบทอง + เงินโครเมียม บนดำอมน้ำตาล 2026-10-03): การ์ดเป็นผิวการ์ดอุ่น
// #1b1005 ในเส้นไรผม #2e1d08 ซึ่งเป็นผิวที่สว่างกว่าดำอมน้ำตาล #130b03 ของ
// ContentBoxCyberCut ที่อยู่เหนือขึ้นไปบนหน้าเดียวกัน สองการ์ดมุมตัดจึงไม่อ่านเป็นใบ
// เดียวกันซ้ำสองรอบ มุมตัดถูกไล่ด้วยเส้นคู่ละสอง — คู่บนซ้ายเป็นทองแบรนด์ #ebbb54
// กับเงินโครเมียม #d5d4d3 และคู่ล่างขวาเป็นทองสว่าง #fce675 กับทองลึก #ab6d24
// กรอบจึงพาสองโลหะของโลโก้ (ตัว U กับ UP เงิน / ลูกศร วงรี และเลข 555 ทอง) มาไว้ที่
// ตัวกรอบเองแทนที่จะใช้สีเดียว ป้ายสองคอลัมน์แยกกันด้วยสี — ทองแบรนด์ฝั่งซ้าย เงิน
// ฝั่งขวา หัวข้อ docx ไล่เงิน → ทองแบรนด์ → ทองลึก ซึ่งเป็นคนละลำดับกับอีกห้ากล่องบน
// หน้าเดียวกัน เนื้อความ #f8eed9 (BRAND_TEXT)
//
// ชุดทอง-เงินของ 1SS365 ที่เคยค้างในไฟล์นี้ (#1a1710 #2a2115 #edbb23 #ffeeb4
// #a87708 #c8cbce #f0e6d2) ออกครบทุกจุดแล้ว
const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
// A real heading already names the region, so the aria-label is dropped in that
// case and only stands in when the title rendered as chrome (`as="p"`).
const named = Boolean(title) && TitleTag !== "p";
---

<section aria-label={named ? undefined : sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#2e1d08] bg-[#1b1005]/92 p-8 text-[#f8eed9] shadow-[0_10px_30px_rgba(5,2,1,0.85)] backdrop-blur-md transition-all duration-300 hover:border-[#ebbb54]/60 hover:shadow-[0_15px_40px_rgba(235,187,84,0.28)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#ebbb54] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#fce675] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#d5d4d3] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#ab6d24] to-transparent"></div>

    {
      title && (
        <TitleTag class="mb-4 bg-gradient-to-r from-[#d5d4d3] via-[#ebbb54] to-[#ab6d24] bg-clip-text text-center text-2xl leading-normal font-black text-transparent uppercase">{title}</TitleTag>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#f8eed9]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#f8eed9]">
        {
          titleleft && (
            <p class="flex items-center gap-2 border-b border-[#2e1d08] pb-2 text-xl leading-normal font-black text-[#ebbb54] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#ebbb54] shadow-[0_0_5px_rgba(235,187,84,0.85)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#f8eed9] md:border-l md:border-[#2e1d08] md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 border-b border-[#2e1d08] pb-2 text-xl leading-normal font-black text-[#d5d4d3] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#d5d4d3] shadow-[0_0_5px_rgba(213,212,211,0.6)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
