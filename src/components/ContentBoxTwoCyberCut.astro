---
export interface Props {
  title?: string;
  /** Only the main `title` may become a real heading, and only when the page
   *  hands it a docx H2. Defaults to <p> so a chrome usage stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: TitleTag = "p", titleleft, titleright, label } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// The two column labels always render as <p>, never <h2>. The docx a page is
// filled from is a flat H1 + a handful of H2s, and the rendered heading
// inventory is diffed against it on every rebrand — a widget quietly adding two
// more <h2> is the thing that makes that diff disagree. A <p> heading needs the
// section to carry its own accessible name instead, which is what `label` is for.
const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";

// The intro-slot wrapper below carries a real `mb-8` and sits beside the grid,
// so it is one of the three ContentBox* wrappers that cannot be hoisted away.
//
// YADOM168 palette: the cut corners are traced by two rules each — the top-left
// pair in brand green and the bottom-right pair in coin gold — so the frame
// itself carries the artwork's green-and-gold pairing rather than a single hue.
---

<section aria-label={sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#0f3d0d]/60 bg-[#071508]/92 p-8 text-[#d4e8cb] shadow-[0_10px_30px_rgba(92,194,63,0.18)] backdrop-blur-md transition-all duration-300 hover:border-[#5cc23f]/55 hover:shadow-[0_15px_40px_rgba(92,194,63,0.28)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#8fe06f] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#e6bd5c] to-transparent"></div>
    <div class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#8fe06f] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#e6bd5c] to-transparent"></div>

    {
      title && (
        <TitleTag class="mb-4 bg-gradient-to-r from-[#f2fbef] via-[#8fe06f] to-[#1d6b18] bg-clip-text text-center text-2xl leading-normal font-black text-transparent uppercase">{title}</TitleTag>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#d4e8cb]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#d4e8cb]">
        {
          titleleft && (
            <p class="flex items-center gap-2 border-b border-[#0f3d0d]/60 pb-2 text-xl leading-normal font-black text-[#8fe06f] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#5cc23f] shadow-[0_0_5px_rgba(92,194,63,0.7)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#d4e8cb] md:border-l md:border-[#0f3d0d]/60 md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 border-b border-[#0f3d0d]/60 pb-2 text-xl leading-normal font-black text-[#e6bd5c] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#e6bd5c] shadow-[0_0_5px_rgba(230,189,92,0.8)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
