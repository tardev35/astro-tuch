---
export interface Props {
  title?: string;
  /** Only the main `title` may become a real heading, and only when the page
   *  hands it a docx H2. Defaults to <p> so a chrome usage stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: TitleTag = "p", titleleft, titleright, label } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// The two column labels always render as <p>, never <h2>. The docx a page is
// filled from is a flat H1 + a handful of H2s (plus a real H3 run this round),
// and the rendered heading inventory is diffed against it on every rebrand — a
// widget quietly adding two more <h2> is the thing that makes that diff
// disagree. A <p> heading needs the section to carry its own accessible name
// instead, which is what `label` is for.
//
// The intro-slot wrapper below carries a real `mb-8` and sits beside the grid,
// so it is one of the three ContentBox* wrappers that cannot be hoisted away.
//
// LOTTOPLUS (รอบแดง-ทอง-ดำ 2026-09-29): มุมตัดถูกไล่ด้วยเส้นคู่ละสอง — คู่บนซ้าย
// เป็นแดงแบรนด์ #dc020e กับทองอ่อน #fde79a และคู่ล่างขวาเป็นทองรอง #f3c623 กับ
// แดงลึก #6b0207 กรอบจึงพาคู่สีของงานอาร์ต (บล็อกแดงของโลโก้ + เหรียญทองรอบ
// แบนเนอร์) มาไว้ที่ตัวกรอบเองแทนที่จะใช้สีเดียว การ์ดเป็นผิวดำอมแดง #120b0c ใน
// เส้นไรผมแดงลึก #6b0207 และป้ายสองคอลัมน์แยกกันด้วยสี — ทองรองฝั่งซ้าย แดงสว่าง
// #ff2d38 ฝั่งขวา หัวข้อ docx ไล่ทองอ่อน → ทองรอง → แดงแบรนด์ เนื้อความ #f0e2e2
// (BRAND_TEXT) — ชุดทอง-เขียวของ PGW44 ที่ค้างในไฟล์นี้ (#fde90e #fff89a #f5c518
// #35d413 #5df53a #1f5a16 #0b1408 #e9f0dd) หายไปทั้งหมด
const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
// A real heading already names the region, so the aria-label is dropped in that
// case and only stands in when the title rendered as chrome (`as="p"`).
const named = Boolean(title) && TitleTag !== "p";
---

<section aria-label={named ? undefined : sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#6b0207]/80 bg-[#120b0c]/92 p-8 text-[#f0e2e2] shadow-[0_10px_30px_rgba(220,2,14,0.18)] backdrop-blur-md transition-all duration-300 hover:border-[#dc020e]/60 hover:shadow-[0_15px_40px_rgba(220,2,14,0.28)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#dc020e] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#f3c623] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#fde79a] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#6b0207] to-transparent"></div>

    {
      title && (
        <TitleTag class="mb-4 bg-gradient-to-r from-[#fde79a] via-[#f3c623] to-[#dc020e] bg-clip-text text-center text-2xl leading-normal font-black text-transparent uppercase">{title}</TitleTag>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#f0e2e2]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e2e2]">
        {
          titleleft && (
            <p class="flex items-center gap-2 border-b border-[#6b0207]/80 pb-2 text-xl leading-normal font-black text-[#f3c623] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#f3c623] shadow-[0_0_5px_rgba(243,198,35,0.85)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e2e2] md:border-l md:border-[#6b0207]/80 md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 border-b border-[#6b0207]/80 pb-2 text-xl leading-normal font-black text-[#ff2d38] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#dc020e] shadow-[0_0_5px_rgba(220,2,14,0.85)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
