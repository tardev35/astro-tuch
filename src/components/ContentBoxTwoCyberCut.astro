---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, titleleft, titleright, label } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// The three titles render as <p>, not <h2>. The docx this template is filled
// from is a flat H1 + ten H2s and the rendered heading inventory is diffed
// against it on every rebrand — a widget quietly adding two more <h2> is the
// thing that makes that diff disagree. A <p> heading needs the section to carry
// its own accessible name instead, which is what `label` is for.
const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#ec4899]/25 bg-[#16050f]/92 p-8 text-[#fdeaf4] shadow-[0_10px_30px_rgba(236,72,153,0.16)] backdrop-blur-md transition-all duration-300 hover:border-[#ec4899]/50 hover:shadow-[0_15px_40px_rgba(236,72,153,0.26)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#ec4899] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#4ade80] to-transparent"></div>
    <div class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#ec4899] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#4ade80] to-transparent"></div>

    {
      title && (
        <p class="mb-4 bg-gradient-to-r from-[#f9a8d4] via-[#ec4899] to-[#db2777] bg-clip-text text-center text-2xl leading-normal font-black text-transparent uppercase">
          {title}
        </p>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#fdeaf4]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#fdeaf4]">
        {
          titleleft && (
            <h2 class="flex items-center gap-2 border-b border-[#ec4899]/25 pb-2 text-xl leading-normal font-black text-[#ec4899] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#ec4899] shadow-[0_0_5px_rgba(236,72,153,0.7)]" /> {titleleft}
            </h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#fdeaf4] md:border-l md:border-[#ec4899]/25 md:pl-8">
        {
          titleright && (
            <h2 class="flex items-center gap-2 border-b border-[#ec4899]/25 pb-2 text-xl leading-normal font-black text-[#ec4899] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#4ade80] shadow-[0_0_5px_rgba(74,222,128,0.8)]" /> {titleright}
            </h2>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
