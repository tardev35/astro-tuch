---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
const currentPath = Astro.url.pathname;
const isActive = (path: string) => isActivePath(currentPath, path);

// หวย24 (รอบแดงแบรนด์-ทอง บนดำอมแดง 2026-10-04): navbar ที่ใช้งานจริงรอบนี้ —
// รอบก่อน (หวยคิง) ใช้ NavbarHuay ไฟล์นี้เคยเป็นของ หวย365 โทนแดงสด-ทอง
// ตอนนี้ย้ายมาเป็นแดงแบรนด์ #d20a0a (vivid ของ logo.webp) คู่กับทอง #f5c33b
// บนพื้นดำอมแดง #0a0303 / #7a0505 ชุดเดิมของ หวย365 (#dc0203 #ffc93c #ffeab0
// #180303 #6b0102 #3d0506 #c08a07 #f6e7e0) ออกครบทุกจุดแล้ว
const logoAlt = "โลโก้ หวย24 วงกลมสีแดงไล่เงาโลหะ ข้างในเป็นเลข 24 สีขาว ถัดมาเป็นตัวอักษรไทยหนาสามมิติ คำว่า หวย สีขาวโครเมียม ต่อด้วยเลข 24 สีแดง บนพื้นโปร่ง";

// เมนูชุดเดียว ใช้ทั้งแถบบนจอใหญ่และเมนูเต็มจอบนมือถือ — เดิมไฟล์นี้ประกาศ
// อาร์เรย์ซ้ำสองชุด ซึ่งเป็นเหตุให้คนแก้ที่เดียวแล้วอีกที่ค้าง
//
// ลำดับ: สมัครสมาชิก/เข้าสู่ระบบ ต่อจากโปรโมชั่นทันที เพราะเป็นปุ่ม conversion
// ไม่ใช่หน้าให้อ่าน ที่เหลือเป็นหน้าเนื้อหาเรียงต่อท้าย
//
// มี ตรวจหวย/แนวทาง รอบนี้: หวย24 เป็นเว็บแทงหวยล้วน ทั้งสองไฟล์อยู่ใน
// src/pages/ จริงและเป็น route จริง — ลิงก์กับไฟล์ต้องมาคู่กันเสมอ ถ้ารอบหน้าเป็น
// แบรนด์สล็อต/คาสิโน ต้องถอดสองบรรทัดนี้ออกพร้อมกับย้ายไฟล์กลับไป pages-disabled
// ไม่งั้น verify-build จะฟ้อง href ที่ชี้ไป route ที่ไม่มีจริง
//
// ไม่มี ทางเข้า เพราะ toggle cta เปิดอยู่ /register กับ /login เป็นหน้าจริงใน
// เมนูแล้ว ทางเข้าจะกลายเป็นลิงก์ที่สามที่พาไปที่เดียวกัน (หน้ายัง route อยู่
// และยังมีลิงก์จาก footer)
//
// ไอคอนเลือกให้ตรงหมวดเว็บหวย ไม่ใช่ไพ่/ลูกเต๋าของแบรนด์สล็อต และทุกตัวอยู่ใน
// <span aria-hidden="true"> แยกจาก label เสมอ
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ตรวจหวย", path: "/ตรวจหวย", icon: "🔎" },
  { name: "แนวทาง", path: "/แนวทาง", icon: "📊" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎱" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🏛️" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];

// แถวเมนูรอบนี้มี 9 รายการ (ตรวจหวย/แนวทาง อยู่ในเมนู) ที่ช่วง lg จึงเป็น
// text-xs gap-2 แล้วค่อยขยายเป็น text-sm gap-5 ที่ xl ซึ่งเป็นช่วงที่ปุ่ม CTA
// คู่ขวาโผล่มาด้วย — ถ้าปล่อย text-sm gap-4 ไว้ที่ lg แถวจะกว้างเกิน 1024px
//
// แถบบนสุดพูดได้เฉพาะสิ่งที่บรีฟพูด: ลาว · ฮานอย · รัฐบาลไทย เท่านั้น ของเดิม
// ไฟล์นี้เคยไล่ "ลาวพัฒนา · หวยหุ้นต่างประเทศ" ซึ่งเป็นตลาดที่บรีฟรอบนี้ไม่ได้ระบุ
---

<div class="hidden w-full border-b border-[#d20a0a]/35 bg-gradient-to-r from-[#0a0303] via-[#7a0505] to-[#0a0303] px-4 py-1.5 font-sans text-xs font-bold text-[#f7e2d6]/85 lg:block">
  <div class="mx-auto flex max-w-7xl justify-between">
    <div class="flex gap-4">
      <span class="flex items-center gap-1"><span aria-hidden="true" class="text-[#f5c33b]">★</span> {BRAND_NAME} เว็บแทงหวยออนไลน์ 24ชั่วโมง แนวทางหวย ผลรางวัล และประวัติโพยในบัญชีเดียว</span>
      <span class="flex items-center gap-1 text-[#ffd45e]"><span aria-hidden="true" class="text-[#f5c33b]">✔</span> หวยลาว · หวยฮานอย · รัฐบาลไทย ตามรอบที่เปิดรับ</span>
    </div>
    <div class="flex gap-4">
      <a href="/line" class="flex items-center gap-1 transition-colors hover:text-[#ffd45e]">สอบถามแอดมินเรื่องสมัคร ส่งโพย อัตราจ่าย และผลรางวัลได้ตลอด 24 ชั่วโมง</a>
    </div>
  </div>
</div>

<header class="sticky top-2 z-50 mt-2 w-full px-2 font-sans md:px-4">
  <nav
    class="relative mx-auto flex h-[75px] w-full max-w-7xl items-center justify-between rounded-[20px] border border-[#a9761a]/45 bg-[#0a0303]/92 px-4 shadow-[0_10px_30px_rgba(210,10,10,0.30)] backdrop-blur-lg xl:px-8">
    <a href="/" class="z-50 flex-shrink-0 transition-transform hover:scale-105">
      {
        mainLogo ? (
          <Picture
            src={mainLogo}
            alt={logoAlt}
            loading="eager"
            fetchpriority="high"
            widths={[120, 240, 360]}
            sizes="120px"
            class="h-[40px] w-auto drop-shadow-[0_0_10px_rgba(210,10,10,0.55)] xl:h-[45px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            quality={45}
          />
        ) : (
          <span class="bg-gradient-to-b from-[#ffd45e] via-[#f5c33b] to-[#d20a0a] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(210,10,10,0.45)]">{BRAND_NAME}</span>
        )
      }
    </a>

    <div class="hidden h-full items-center gap-2 lg:flex xl:gap-5">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`group relative flex h-full items-center gap-1.5 text-xs font-bold tracking-wide transition-colors xl:text-sm ${isActive(item.path) ? "text-[#ffd45e] drop-shadow-[0_0_8px_rgba(210,10,10,0.5)]" : "text-[#f7e2d6]/85 hover:text-[#ffd45e]"}`}>
            <span aria-hidden="true" class="text-base transition-transform group-hover:scale-110">
              {item.icon}
            </span>
            <span>{item.name}</span>
            <div
              aria-hidden="true"
              class={`absolute bottom-[18px] left-0 h-[2px] w-full origin-center bg-gradient-to-r from-[#d20a0a] to-[#f5c33b] shadow-[0_0_8px_rgba(210,10,10,0.7)] transition-transform duration-300 ${isActive(item.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
            />
          </a>
        ))
      }
    </div>

    <div class="z-50 flex items-center gap-3">
      <a
        href="/login"
        class="hidden items-center justify-center gap-1.5 rounded-full border border-[#d20a0a]/60 bg-[#2a0606] px-5 py-2 text-sm font-bold text-[#f7e2d6] shadow-sm transition-all hover:border-[#f5c33b]/65 hover:bg-[#7a0505] xl:flex">
        <span aria-hidden="true">🔑</span>
        <span>เข้าสู่ระบบ</span>
      </a>
      <a
        href="/register"
        class="hidden items-center justify-center gap-1.5 rounded-full bg-gradient-to-r from-[#ffd45e] via-[#f5c33b] to-[#a9761a] px-5 py-2 text-sm font-black text-[#1a0303] shadow-[0_0_15px_rgba(245,195,59,0.45)] transition-all hover:scale-105 xl:flex">
        <span aria-hidden="true">📝</span>
        <span>สมัครสมาชิก</span>
      </a>

      <button
        id="hamburger-btn"
        class="relative flex h-[42px] w-[42px] flex-col items-center justify-center gap-[5px] rounded-full border border-[#a9761a]/45 bg-gradient-to-b from-[#7a0505] to-[#0a0303] shadow-sm lg:hidden"
        aria-label="เปิดเมนู">
        <span class="line-1 h-[2px] w-5 origin-center rounded-full bg-[#f5c33b] transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-5 origin-center rounded-full bg-[#f5c33b] transition-all duration-300"></span>
        <span class="line-3 h-[2px] w-5 origin-center rounded-full bg-[#f5c33b] transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div id="fullscreen-menu" class="pointer-events-none fixed inset-0 z-[40] flex flex-col items-center justify-center bg-[#0a0303]/98 opacity-0 backdrop-blur-xl transition-opacity duration-500">
    <div class="flex max-h-[88vh] w-full flex-col items-center space-y-3 overflow-y-auto px-6 py-10">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`fs-item flex items-center gap-3 text-xl font-black tracking-wide transition-all duration-300 ${isActive(item.path) ? "text-[#ffd45e] drop-shadow-[0_0_10px_rgba(210,10,10,0.6)]" : "text-[#f7e2d6]/85 hover:text-[#ffd45e]"}`}>
            <span aria-hidden="true" class="text-2xl">
              {item.icon}
            </span>
            <span>{item.name}</span>
          </a>
        ))
      }
      <div class="fs-item mt-4 flex w-full max-w-[280px] flex-col gap-4 pt-6">
        <a
          href="/register"
          class="flex w-full items-center justify-center gap-2 rounded-full bg-gradient-to-r from-[#ffd45e] via-[#f5c33b] to-[#a9761a] py-3.5 text-lg font-black text-[#1a0303] shadow-[0_0_20px_rgba(245,195,59,0.5)]">
          <span aria-hidden="true">📝</span>
          <span>สมัครสมาชิกใหม่</span>
        </a>
        <a
          href="/login"
          class="flex w-full items-center justify-center gap-2 rounded-full border-2 border-[#d20a0a]/60 bg-[#2a0606] py-3.5 text-lg font-bold text-[#f7e2d6] transition-colors hover:bg-[#7a0505]">
          <span aria-hidden="true">🔑</span>
          <span>เข้าสู่ระบบ</span>
        </a>
      </div>
    </div>
  </div>
</header>

<style is:global>
  #hamburger-btn.active .line-1 {
    transform: translateY(7px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    opacity: 0;
  }
  #hamburger-btn.active .line-3 {
    transform: translateY(-7px) rotate(-45deg);
  }

  .fs-item {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .fs-item.show {
    opacity: 1;
    transform: translateY(0);
  }
  .fs-item:nth-child(1) {
    transition-delay: 0.06s;
  }
  .fs-item:nth-child(2) {
    transition-delay: 0.1s;
  }
  .fs-item:nth-child(3) {
    transition-delay: 0.14s;
  }
  .fs-item:nth-child(4) {
    transition-delay: 0.18s;
  }
  .fs-item:nth-child(5) {
    transition-delay: 0.22s;
  }
  .fs-item:nth-child(6) {
    transition-delay: 0.26s;
  }
  .fs-item:nth-child(7) {
    transition-delay: 0.3s;
  }
  .fs-item:nth-child(8) {
    transition-delay: 0.34s;
  }
  .fs-item:nth-child(9) {
    transition-delay: 0.38s;
  }
  .fs-item:nth-child(10) {
    transition-delay: 0.42s;
  }

  @media (prefers-reduced-motion: reduce) {
    .fs-item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const fsMenu = document.getElementById("fullscreen-menu");
  const fsItems = document.querySelectorAll(".fs-item");

  const toggleFsMenu = () => {
    hamburgerBtn?.classList.toggle("active");
    fsMenu?.classList.toggle("opacity-0");
    fsMenu?.classList.toggle("pointer-events-none");

    if (!fsMenu?.classList.contains("opacity-0")) {
      document.body.style.overflow = "hidden";
      fsItems.forEach((item) => item.classList.add("show"));
    } else {
      document.body.style.overflow = "";
      fsItems.forEach((item) => item.classList.remove("show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleFsMenu);
  fsItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (!fsMenu?.classList.contains("opacity-0")) toggleFsMenu();
    });
  });
</script>
