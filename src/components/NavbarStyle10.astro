---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
const currentPath = Astro.url.pathname;
const isActive = (path: string) => isActivePath(currentPath, path);

// เงินทอง168 (รอบทองนำ-ครีมรอง บนน้ำตาลโอลีฟ 2026-10-22): navbar ที่ใช้งานจริงรอบนี้ —
// รอบก่อน (พักยก168) ใช้ NavbarStyle4Black ซึ่งเป็นแถบเต็มความกว้างที่เมนูเป็นแผ่น
// เฉียง skew-x-[-15deg] และ drawer เลื่อนเข้าจากขวา ไฟล์นี้เป็นคนละทรง:
// **แถบข้อมูลบางๆ เต็มความกว้างด้านบนสุด** + **แถบเมนูทรงแคปซูล rounded-[20px]
// ที่ลอยอยู่ (top-2, max-w-7xl) ไม่ชิดขอบจอ** + มือถือเป็น **เมนูเต็มจอที่เฟดเข้า
// พร้อมรายการไล่ขึ้นทีละตัว**
//
// ไฟล์นี้เคยเป็นของ ขวัญใจ168 ชุดทองนำ-โรสโกลด์รองบนดำสนิท
// (f7c92b ffe6a3 f2bba5 c98a74 b3121b 5a0a0e eadfce 000000 0b0603
// 160d06 241509 140c06 และ rgba 247/201/43 α) ออกครบทุกจุดแล้ว
// ไม่เหลือโรสโกลด์หรือแดงเลยทั้งในคลาสและใน rgba()
// ก่อนหน้านั้นเป็นของ KINGKONG555 ชุดเขียวมะนาว-ทองมงกุฎ (8ce023 f2c230
// ffe066 e9f7d6 bde397 051400 0f2e05 1a5c04 2f8c07 a87a08 06220a)
// ซึ่งออกไปตั้งแต่รอบ ขวัญใจ168 แล้ว
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
//
// ⚠️⚠️ **กับดักรอบนี้คือทอง และหนักกว่าทุกรอบ** — เจ้าของธีมเดิมของไฟล์นี้
// (ขวัญใจ168) ก็ทองนำบนดำ และ **แบรนด์รอบก่อนทันที (พักยก168) ก็ทองนำเช่นกัน**
// ทองของขวัญใจ168 (f7c92b) ต่างจากทองรอบนี้ (#f5ba14) แค่ R2/G15/B23 และทองของ
// พักยก168 (eeae12) ต่างแค่ R7/G12/B2 ส่วนไฟล์อื่นในรีโปก็ค้างทองของ ufalion168
// (d4922c), ยูฟ้า168 (e6a416), UFA324 (e5a81b), สบาย168 (fdcb0c), รับตัง168
// (f0b429), สมหวัง168 (e3b23c) ไว้ด้วย **"เจอทอง" ไม่พิสูจน์ว่าเป็นของรอบนี้
// ต้องเทียบเป็นค่าทีละตัว** กับ .claude/brand-spec-ngernthong168.md §2
//
// แกนสีมาจากงานศิลป์จริง "ทองนำ ครีมรอง": คำว่า เงินทอง บนโลโก้เป็นตัวอักษรไทย
// สามมิติผิวทองขัดเงาตัดขอบดำ เลข 168 เป็นผิวโครเมียมเงิน และมีตราชั่งทองนำหน้า
// ส่วนค่า share สูงสุดที่ palette.json วัดได้จาก slide1.png คือ **ครีมอุ่น
// #ecd5c4** (ชุดซาตินสีงาช้างของผู้หญิงในภาพ) ⚠️⚠️ **เลข 168 เป็นโครเมียมจริง
// แต่แรมป์เทาเงินเป็นของพักยก168 (e0e0df c0c0bf a1a09e) และยูฟ้า168 (e8ecf1
// a8b2bf 78828f) ไปแล้ว — รอบนี้จึงใช้ครีมอุ่นเป็นวัสดุที่สองแทน ห้ามเอาเทาเงิน
// กลับเข้ามาในไฟล์นี้** นั่นคือหนึ่งในสองตัวที่แยกรอบนี้ออกจากรอบก่อน
// พื้นเป็นน้ำตาลโอลีฟ #29210f ตาม bg.json ยกเป็น #1b1407 (จม) / #2e2512 (กลาง) /
// #4d3c15 (ยก) · ทองแบรนด์ #f5ba14 ถือสถานะ active ขอบแคปซูล และขีดใต้ ·
// ทองสว่าง #fcee52 เป็นต้นเกรเดียนต์ปุ่มสมัคร · ครีม #ecd5c4 เป็นปลายเกรเดียนต์
// และสี hover · เนื้อความเมนู #ecd5c4 (= BRAND_TEXT)
//
// ปุ่ม "สมัครสมาชิก" เป็นพื้น **ทองถมไล่ไปครีม** (#fcee52 -> #f5ba14 -> #ecd5c4)
// คู่หมึกเข้ม #201906 — ตรวจครบทั้งสามสต็อป: 14.5:1 / 9.9:1 / 13.3:1
// ⚠️ ห้ามลากสต็อปเข้มลงไปถึง #b37c0b ใต้หมึกนี้ ค่านั้นเป็นทองลึกสำหรับเส้น ขอบ
// และออราเท่านั้น (หมึก #201906 บน #b37c0b เหลือ 4.8:1 ซึ่งพอดีเกินไปสำหรับ
// ตัวอักษรเล็ก) ⚠️ **และห้ามสลับเป็นพื้นทองแล้วใส่ตัวอักษรขาว**
// ส่วนปุ่ม "เข้าสู่ระบบ" เป็นปุ่มรอง พื้นโปร่ง ขอบทอง ตัวอักษร #ecd5c4 จึงไม่ติด
// ปัญหานี้ คู่ปุ่มต่างกันที่ "พื้นทองตัน vs กรอบทองโปร่ง" ไม่ใช่ที่ความสว่างของสีเดียวกัน
//
// isActive มาจาก isActivePath ใน src/lib/nav — ห้ามเขียนเทียบสตริงเองในไฟล์นี้
// Astro.url.pathname ถูก percent-encode ไว้ ถ้าเขียนเองหน้า /ทดลองเล่น จะไม่มี
// รายการไหน active เลย
//
// เมนูชุดเดียว ใช้ทั้งแถบบนจอใหญ่และเมนูเต็มจอบนมือถือ — ถ้าแยกเป็นสองชุดเมื่อไหร่
// รอบถัดไปจะมีคนแก้ที่เดียวแล้วอีกที่ค้าง
//
// ลำดับ: หน้าแรก · โปรโมชั่น · สมัครสมาชิก · เข้าสู่ระบบ · แล้วค่อยหน้าอ่านอื่นๆ
// สองรายการกลางเป็น conversion action ไม่ใช่หน้าให้อ่าน จึงต้องอยู่ตรงที่สายตา
// กวาดจากซ้ายไปขวาเจอก่อนหน้าข้อมูล — uploader ส่วนที่ 5 append ต่อท้ายอาร์เรย์
// เสมอ ทุกรอบรีแบรนด์จึงต้องเลื่อนขึ้นมาเอง
//
// toggle cta ของ uploader รอบนี้ **เปิด**: /login กับ /register เป็นหน้าปุ่มจริงที่
// index ได้ จึงมีสองรายการนั้นในเมนู และ /ทางเข้า ถูกถอดออกโดยตั้งใจ เพราะหน้านั้น
// มีไว้เสนอ เข้าสู่ระบบ/สมัครสมาชิก อยู่แล้ว การคงไว้คือลิงก์ที่สามไปที่เดียวกัน
// (หน้า /ทางเข้า ยังมี route และยัง index อยู่ — ถอดแค่รายการในเมนู ห้ามลบไฟล์)
//
// ไม่มี /ตรวจหวย, /แนวทาง: เงินทอง168 เป็นเว็บสล็อตล้วน ไม่ใช่เว็บหวย ทั้งสองไฟล์
// จอดอยู่ใน src/pages-disabled/ รอบนี้ จึงไม่มี route ให้ลิงก์ไป ถ้ารอบหน้าเป็น
// แบรนด์หวย ต้องเพิ่มสองบรรทัดนี้คืนพร้อมกับย้ายไฟล์กลับเข้า src/pages/ ไม่งั้น
// verify-build จะฟ้อง href ที่ชี้ไป route ที่ไม่มีจริง
//
// ไอคอนเลือกให้ตรงหมวดเว็บสล็อต ไม่ใช่โพย/ลูกบอลของเว็บหวยหรือกีฬา และทุกตัวอยู่ใน
// <span aria-hidden="true"> ที่เป็น "พี่น้อง" ของ label เสมอ ห้ามต่อเข้าไปในข้อความ
// ไม่งั้น screen reader จะอ่านชื่อไอคอนนำหน้าชื่อเมนู (verify-build เช็กให้)
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🏢" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "💬" },
];

// logoAlt เขียนจากไฟล์ logo.webp ของดรอป 2026-10-22 ที่เปิดอ่านจริง —
// หัวมังกรจีนทองของ "พักยก" รอบก่อนไม่มีอยู่ในรูปนี้เลย รอบนี้สัญลักษณ์คือ
// **ตราชั่งทอง** และตัวเลขกลับมาเป็นผิวโครเมียมเงินเหมือนรอบก่อน
// ⚠️ โลโก้รอบนี้ไม่มีคน ไม่มีโบว์ริบบิ้น ไม่มีเหรียญจีนเจาะรูสี่เหลี่ยม
// และไม่มีหัวใจ (ของ ขวัญใจ168 เจ้าของธีมเดิมของไฟล์นี้)
const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส ด้านซ้ายเป็นตราชั่งสองจานสามมิติสีทองเงางาม มีเหรียญทองกองอยู่บนจานทั้งสองข้าง เสาและคานของตราชั่งเป็นทองขัดเงา ถัดมาทางขวาเป็นคำว่า เงินทอง ตัวอักษรไทยหนาสามมิติผิวทองมันวาว ต่อด้วยตัวเลข 168 หนาสามมิติผิวโครเมียมเงิน ทั้งตัวอักษรและตัวเลขตัดขอบสีดำหนาและมีแสงสะท้อนสีขาวที่ขอบบน`;

// แถบบนสุดพูดได้เฉพาะสิ่งที่บรีฟพูด (src/assets/content.txt): เกมสล็อตออนไลน์
// หลากหลายรูปแบบ · ข้อมูลค่ายเกม อัตราจ่าย และโปรโมชั่น · มากกว่า 1,000 เกม
// จากค่ายมาตรฐานสากล · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · ติดต่อเจ้าหน้าที่ 24ชม.
// ไม่มีบาคาร่า/รูเล็ต/บอล/หวย ไม่มีชื่อค่ายเกม ไม่มีชื่อธนาคาร ไม่มียอดขั้นต่ำ
// และไม่มีวลีของแบรนด์ก่อน (เจ้าดัง / ไม่ผ่านม้า / ค่ายแท้ / ทดลองเล่นฟรี)
---

<div class="hidden w-full border-b border-[#f5ba14]/35 bg-gradient-to-r from-[#1b1407] via-[#4d3c15] to-[#1b1407] px-4 py-1.5 font-sans text-xs font-bold text-[#ecd5c4]/85 lg:block">
  <div class="mx-auto flex max-w-7xl justify-between">
    <div class="flex gap-4">
      <span class="flex items-center gap-1"><span aria-hidden="true" class="text-[#f5ba14]">★</span> {BRAND_NAME} นำเสนอเกมสล็อตออนไลน์หลากหลายรูปแบบ พร้อมข้อมูลค่ายเกม อัตราจ่าย และโปรโมชั่นสำหรับสมาชิกไว้ในเว็บไซต์เดียว</span>
      <span class="flex items-center gap-1 text-[#ecd5c4]"><span aria-hidden="true" class="text-[#f5ba14]">✔</span> มากกว่า 1,000 เกม จากค่ายมาตรฐานสากล · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8%</span>
    </div>
    <div class="flex gap-4">
      <a href="/line" class="flex items-center gap-1 transition-colors hover:text-[#f5ba14]">ติดต่อเจ้าหน้าที่เรื่องสมัครสมาชิก เข้าสู่ระบบ ฝากถอน และโปรโมชั่น ได้ตลอด 24ชม.</a>
    </div>
  </div>
</div>

<header class="sticky top-2 z-50 mt-2 w-full px-2 font-sans md:px-4">
  <nav
    class="relative mx-auto flex h-[75px] w-full max-w-7xl items-center justify-between rounded-[20px] border border-[#f5ba14]/45 bg-[#1b1407]/92 px-4 shadow-[0_10px_30px_rgba(245,186,20,0.28)] backdrop-blur-lg xl:px-8">
    <a href="/" class="z-50 flex-shrink-0 transition-transform hover:scale-105">
      {
        mainLogo ? (
          <Picture
            src={mainLogo}
            alt={logoAlt}
            loading="eager"
            fetchpriority="high"
            widths={[120, 240, 360]}
            sizes="120px"
            class="h-[40px] w-auto drop-shadow-[0_0_10px_rgba(245,186,20,0.55)] xl:h-[45px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            quality={45}
          />
        ) : (
          <span class="bg-gradient-to-b from-[#fcee52] via-[#f5ba14] to-[#ecd5c4] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(245,186,20,0.45)]">{BRAND_NAME}</span>
        )
      }
    </a>

    <div class="hidden h-full items-center gap-4 lg:flex xl:gap-6">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`group relative flex h-full items-center gap-1.5 text-sm font-bold tracking-wide transition-colors ${isActive(item.path) ? "text-[#f5ba14] drop-shadow-[0_0_8px_rgba(245,186,20,0.5)]" : "text-[#ecd5c4]/85 hover:text-[#fcee52]"}`}>
            <span aria-hidden="true" class="text-base transition-transform group-hover:scale-110">
              {item.icon}
            </span>
            <span>{item.name}</span>
            <div
              aria-hidden="true"
              class={`absolute bottom-[18px] left-0 h-[2px] w-full origin-center bg-gradient-to-r from-[#ecd5c4] to-[#f5ba14] shadow-[0_0_8px_rgba(245,186,20,0.7)] transition-transform duration-300 ${isActive(item.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
            />
          </a>
        ))
      }
    </div>

    <div class="z-50 flex items-center gap-3">
      <a
        href="/login"
        class="hidden items-center justify-center gap-1.5 rounded-full border border-[#f5ba14]/60 bg-[#2e2512] px-5 py-2 text-sm font-bold text-[#ecd5c4] shadow-sm transition-all hover:border-[#fcee52]/70 hover:bg-[#4d3c15] xl:flex">
        <span aria-hidden="true">🔑</span>
        <span>เข้าสู่ระบบ</span>
      </a>
      <a
        href="/register"
        class="hidden items-center justify-center gap-1.5 rounded-full bg-gradient-to-r from-[#fcee52] via-[#f5ba14] to-[#ecd5c4] px-5 py-2 text-sm font-black text-[#201906] shadow-[0_0_15px_rgba(245,186,20,0.45)] transition-all hover:scale-105 xl:flex">
        <span aria-hidden="true">📝</span>
        <span>สมัครสมาชิก</span>
      </a>

      <button
        id="hamburger-btn"
        class="relative flex h-[42px] w-[42px] flex-col items-center justify-center gap-[5px] rounded-full border border-[#f5ba14]/45 bg-gradient-to-b from-[#4d3c15] to-[#1b1407] shadow-sm lg:hidden"
        aria-label="เปิดเมนู">
        <span class="line-1 h-[2px] w-5 origin-center rounded-full bg-[#f5ba14] transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-5 origin-center rounded-full bg-[#f5ba14] transition-all duration-300"></span>
        <span class="line-3 h-[2px] w-5 origin-center rounded-full bg-[#f5ba14] transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div id="fullscreen-menu" class="pointer-events-none fixed inset-0 z-[40] flex flex-col items-center justify-center bg-[#1b1407]/98 opacity-0 backdrop-blur-xl transition-opacity duration-500">
    <div class="flex max-h-[88vh] w-full flex-col items-center space-y-3 overflow-y-auto px-6 py-10">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`fs-item flex items-center gap-3 text-xl font-black tracking-wide transition-all duration-300 ${isActive(item.path) ? "text-[#f5ba14] drop-shadow-[0_0_10px_rgba(245,186,20,0.6)]" : "text-[#ecd5c4]/85 hover:text-[#fcee52]"}`}>
            <span aria-hidden="true" class="text-2xl">
              {item.icon}
            </span>
            <span>{item.name}</span>
          </a>
        ))
      }
      <div class="fs-item mt-4 flex w-full max-w-[280px] flex-col gap-4 pt-6">
        <a
          href="/register"
          class="flex w-full items-center justify-center gap-2 rounded-full bg-gradient-to-r from-[#fcee52] via-[#f5ba14] to-[#ecd5c4] py-3.5 text-lg font-black text-[#201906] shadow-[0_0_20px_rgba(245,186,20,0.5)]">
          <span aria-hidden="true">📝</span>
          <span>สมัครสมาชิก</span>
        </a>
        <a
          href="/login"
          class="flex w-full items-center justify-center gap-2 rounded-full border-2 border-[#f5ba14]/60 bg-[#2e2512] py-3.5 text-lg font-bold text-[#ecd5c4] transition-colors hover:bg-[#4d3c15]">
          <span aria-hidden="true">🔑</span>
          <span>เข้าสู่ระบบ</span>
        </a>
      </div>
    </div>
  </div>
</header>

<style is:global>
  #hamburger-btn.active .line-1 {
    transform: translateY(7px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    opacity: 0;
  }
  #hamburger-btn.active .line-3 {
    transform: translateY(-7px) rotate(-45deg);
  }

  .fs-item {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .fs-item.show {
    opacity: 1;
    transform: translateY(0);
  }
  .fs-item:nth-child(1) {
    transition-delay: 0.06s;
  }
  .fs-item:nth-child(2) {
    transition-delay: 0.1s;
  }
  .fs-item:nth-child(3) {
    transition-delay: 0.14s;
  }
  .fs-item:nth-child(4) {
    transition-delay: 0.18s;
  }
  .fs-item:nth-child(5) {
    transition-delay: 0.22s;
  }
  .fs-item:nth-child(6) {
    transition-delay: 0.26s;
  }
  .fs-item:nth-child(7) {
    transition-delay: 0.3s;
  }
  .fs-item:nth-child(8) {
    transition-delay: 0.34s;
  }

  @media (prefers-reduced-motion: reduce) {
    .fs-item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const fsMenu = document.getElementById("fullscreen-menu");
  const fsItems = document.querySelectorAll(".fs-item");

  const toggleFsMenu = () => {
    hamburgerBtn?.classList.toggle("active");
    fsMenu?.classList.toggle("opacity-0");
    fsMenu?.classList.toggle("pointer-events-none");

    if (!fsMenu?.classList.contains("opacity-0")) {
      document.body.style.overflow = "hidden";
      fsItems.forEach((item) => item.classList.add("show"));
    } else {
      document.body.style.overflow = "";
      fsItems.forEach((item) => item.classList.remove("show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleFsMenu);
  fsItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (!fsMenu?.classList.contains("opacity-0")) toggleFsMenu();
    });
  });
</script>
