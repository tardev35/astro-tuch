---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
const currentPath = Astro.url.pathname;
const isActive = (path: string) => isActivePath(currentPath, path);

// แตกดี168 (รอบฟ้าสด-เหลืองมะนาวบนกรมท่าเกือบดำ 2026-10-08): navbar ที่ใช้งานจริง
// รอบนี้ — รอบก่อน (789BETTING) ใช้ NavbarStyle4Black ไฟล์นี้เคยเป็นของ หวย24
// โทนแดงแบรนด์-ทองบนดำอมแดง ตอนนี้ย้ายมาเป็นฟ้าแบรนด์ #0193fb (vivid อันดับหนึ่ง
// ของ logo.webp) คู่เหลืองมะนาว #fce604 (vivid อันดับสอง) บนพื้นกรมท่าเกือบดำ
// #020609 / #07111d / #0b3c66 ชุดเดิมของ หวย24 (#d20a0a #f5c33b #ffd45e #0a0303
// #2a0606 #7a0505 #a9761a #f7e2d6 rgba(210,10,10,α) rgba(245,195,59,α)) ออกครบ
// ทุกจุดแล้ว ไม่เหลือฮิวเก่าในไฟล์ ไม่ว่าในคลาสหรือใน rgba()
const logoAlt = "โลโก้ แตกดี168 บนพื้นโปร่ง เป็นคำว่า แตกดี ตัวอักษรไทยหนาสีเหลืองมะนาว วางอยู่เหนือเลข 168 ตัวหนาสีฟ้าสด และมีแถบมนบางสีขาวนวลคาดอยู่ใต้สุด";

// เมนูชุดเดียว ใช้ทั้งแถบบนจอใหญ่และเมนูเต็มจอบนมือถือ — เดิมไฟล์นี้ประกาศ
// อาร์เรย์ซ้ำสองชุด ซึ่งเป็นเหตุให้คนแก้ที่เดียวแล้วอีกที่ค้าง
//
// ไม่มี สมัครสมาชิก/เข้าสู่ระบบ ในเมนูรอบนี้ เพราะ toggle cta ของ uploader **ปิด**
// อยู่: /login กับ /register กลับไปเป็นหน้า interstitial แบบ noindex ที่เด้งไปลิงก์
// aff ทันที ไม่ใช่หน้าปุ่มที่ index ได้ กฎลำดับ "สมัครสมาชิก/เข้าสู่ระบบ ต่อจาก
// โปรโมชั่น" จึงเป็น no-op รอบนี้ และ /ทางเข้า กลับเข้ามาอยู่ในเมนูแทน เพราะไม่มี
// ลิงก์อื่นในเมนูที่พาไปที่เดียวกันอีกแล้ว (ปุ่ม CTA คู่มุมขวายังอยู่ — เป็นโครม
// ของ variant นี้ คนละชุดกับรายการเมนู)
//
// ไม่มี /ตรวจหวย, /แนวทาง: แตกดี168 เป็นเว็บสล็อตล้วน ไม่ใช่เว็บหวย ทั้งสองไฟล์
// จอดอยู่ใน src/pages-disabled/ รอบนี้ จึงไม่มี route ให้ลิงก์ไป ถ้ารอบหน้าเป็น
// แบรนด์หวย ต้องเพิ่มสองบรรทัดนี้คืนพร้อมกับย้ายไฟล์กลับเข้า src/pages/ ไม่งั้น
// verify-build จะฟ้อง href ที่ชี้ไป route ที่ไม่มีจริง
//
// ไอคอนเลือกให้ตรงหมวดเว็บสล็อต (ตู้สล็อต/ของขวัญ) ไม่ใช่โพย/ลูกบอลของเว็บหวย
// และทุกตัวอยู่ใน <span aria-hidden="true"> แยกจาก label เสมอ ห้ามต่อเข้าไปใน
// ข้อความ ไม่งั้น screen reader จะอ่านชื่อไอคอนนำหน้าชื่อเมนู (verify-build เช็กให้)
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🏢" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
  { name: "ทางเข้า", path: "/ทางเข้า", icon: "🌐" },
];

// แถวเมนูรอบนี้มี 6 รายการ (น้อยกว่ารอบ หวย24 ที่มี 9 เพราะไม่มี ตรวจหวย/แนวทาง
// และไม่มีคู่ สมัคร/เข้าสู่ระบบ) ที่ช่วง lg จึงอยู่สบายที่ text-sm gap-4 ได้เลย
// แล้วค่อยขยายเป็น gap-6 ที่ xl ซึ่งเป็นช่วงที่ปุ่ม CTA คู่ขวาโผล่มาด้วย
//
// แถบบนสุดพูดได้เฉพาะสิ่งที่บรีฟพูด: สล็อตคลาสสิก · เกมโบนัส · ฟรีสปิน · ตัวคูณ ·
// เกมเปิดใหม่ เท่านั้น ไม่มีบาคาร่า/รูเล็ต/บอล/หวย ซึ่งเป็นหมวดของแบรนด์ก่อนหน้า
// และไม่ได้อยู่ในบรีฟรอบนี้
---

<div class="hidden w-full border-b border-[#0193fb]/35 bg-gradient-to-r from-[#020609] via-[#0b3c66] to-[#020609] px-4 py-1.5 font-sans text-xs font-bold text-[#dbeafe]/85 lg:block">
  <div class="mx-auto flex max-w-7xl justify-between">
    <div class="flex gap-4">
      <span class="flex items-center gap-1"><span aria-hidden="true" class="text-[#fce604]">★</span> {BRAND_NAME} เกมสล็อตออนไลน์ รวมเกมเดิมพันหลายรูปแบบไว้ในระบบเดียว เลือกเกม ตรวจเครดิต และดูประวัติรายการจากบัญชีเดียว</span>
      <span class="flex items-center gap-1 text-[#7bcffb]"><span aria-hidden="true" class="text-[#fce604]">✔</span> สล็อตคลาสสิก · เกมโบนัส · ฟรีสปิน · ตัวคูณ · เกมเปิดใหม่ตามรายการที่ให้บริการ</span>
    </div>
    <div class="flex gap-4">
      <a href="/line" class="flex items-center gap-1 transition-colors hover:text-[#fce604]">สอบถามแอดมินเรื่องสมัคร โปรโมชั่น และรายการฝากถอนได้ตลอด 24 ชั่วโมง</a>
    </div>
  </div>
</div>

<header class="sticky top-2 z-50 mt-2 w-full px-2 font-sans md:px-4">
  <nav
    class="relative mx-auto flex h-[75px] w-full max-w-7xl items-center justify-between rounded-[20px] border border-[#0193fb]/45 bg-[#020609]/92 px-4 shadow-[0_10px_30px_rgba(1,147,251,0.30)] backdrop-blur-lg xl:px-8">
    <a href="/" class="z-50 flex-shrink-0 transition-transform hover:scale-105">
      {
        mainLogo ? (
          <Picture
            src={mainLogo}
            alt={logoAlt}
            loading="eager"
            fetchpriority="high"
            widths={[120, 240, 360]}
            sizes="120px"
            class="h-[40px] w-auto drop-shadow-[0_0_10px_rgba(1,147,251,0.55)] xl:h-[45px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            quality={45}
          />
        ) : (
          <span class="bg-gradient-to-b from-[#fff48a] via-[#fce604] to-[#0193fb] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(1,147,251,0.45)]">{BRAND_NAME}</span>
        )
      }
    </a>

    <div class="hidden h-full items-center gap-4 lg:flex xl:gap-6">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`group relative flex h-full items-center gap-1.5 text-sm font-bold tracking-wide transition-colors ${isActive(item.path) ? "text-[#fce604] drop-shadow-[0_0_8px_rgba(1,147,251,0.5)]" : "text-[#dbeafe]/85 hover:text-[#fce604]"}`}>
            <span aria-hidden="true" class="text-base transition-transform group-hover:scale-110">
              {item.icon}
            </span>
            <span>{item.name}</span>
            <div
              aria-hidden="true"
              class={`absolute bottom-[18px] left-0 h-[2px] w-full origin-center bg-gradient-to-r from-[#0193fb] to-[#fce604] shadow-[0_0_8px_rgba(1,147,251,0.7)] transition-transform duration-300 ${isActive(item.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
            />
          </a>
        ))
      }
    </div>

    <div class="z-50 flex items-center gap-3">
      <a
        href="/login"
        class="hidden items-center justify-center gap-1.5 rounded-full border border-[#0193fb]/60 bg-[#07111d] px-5 py-2 text-sm font-bold text-[#dbeafe] shadow-sm transition-all hover:border-[#fce604]/65 hover:bg-[#064a86] xl:flex">
        <span aria-hidden="true">🔑</span>
        <span>เข้าสู่ระบบ</span>
      </a>
      <a
        href="/register"
        class="hidden items-center justify-center gap-1.5 rounded-full bg-gradient-to-r from-[#fff48a] via-[#fce604] to-[#c9a703] px-5 py-2 text-sm font-black text-[#031018] shadow-[0_0_15px_rgba(252,230,4,0.45)] transition-all hover:scale-105 xl:flex">
        <span aria-hidden="true">📝</span>
        <span>สมัครสมาชิก</span>
      </a>

      <button
        id="hamburger-btn"
        class="relative flex h-[42px] w-[42px] flex-col items-center justify-center gap-[5px] rounded-full border border-[#0193fb]/45 bg-gradient-to-b from-[#0b3c66] to-[#020609] shadow-sm lg:hidden"
        aria-label="เปิดเมนู">
        <span class="line-1 h-[2px] w-5 origin-center rounded-full bg-[#fce604] transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-5 origin-center rounded-full bg-[#fce604] transition-all duration-300"></span>
        <span class="line-3 h-[2px] w-5 origin-center rounded-full bg-[#fce604] transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div id="fullscreen-menu" class="pointer-events-none fixed inset-0 z-[40] flex flex-col items-center justify-center bg-[#020609]/98 opacity-0 backdrop-blur-xl transition-opacity duration-500">
    <div class="flex max-h-[88vh] w-full flex-col items-center space-y-3 overflow-y-auto px-6 py-10">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`fs-item flex items-center gap-3 text-xl font-black tracking-wide transition-all duration-300 ${isActive(item.path) ? "text-[#fce604] drop-shadow-[0_0_10px_rgba(1,147,251,0.6)]" : "text-[#dbeafe]/85 hover:text-[#fce604]"}`}>
            <span aria-hidden="true" class="text-2xl">
              {item.icon}
            </span>
            <span>{item.name}</span>
          </a>
        ))
      }
      <div class="fs-item mt-4 flex w-full max-w-[280px] flex-col gap-4 pt-6">
        <a
          href="/register"
          class="flex w-full items-center justify-center gap-2 rounded-full bg-gradient-to-r from-[#fff48a] via-[#fce604] to-[#c9a703] py-3.5 text-lg font-black text-[#031018] shadow-[0_0_20px_rgba(252,230,4,0.5)]">
          <span aria-hidden="true">📝</span>
          <span>สมัครสมาชิกใหม่</span>
        </a>
        <a
          href="/login"
          class="flex w-full items-center justify-center gap-2 rounded-full border-2 border-[#0193fb]/60 bg-[#07111d] py-3.5 text-lg font-bold text-[#dbeafe] transition-colors hover:bg-[#064a86]">
          <span aria-hidden="true">🔑</span>
          <span>เข้าสู่ระบบ</span>
        </a>
      </div>
    </div>
  </div>
</header>

<style is:global>
  #hamburger-btn.active .line-1 {
    transform: translateY(7px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    opacity: 0;
  }
  #hamburger-btn.active .line-3 {
    transform: translateY(-7px) rotate(-45deg);
  }

  .fs-item {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .fs-item.show {
    opacity: 1;
    transform: translateY(0);
  }
  .fs-item:nth-child(1) {
    transition-delay: 0.06s;
  }
  .fs-item:nth-child(2) {
    transition-delay: 0.1s;
  }
  .fs-item:nth-child(3) {
    transition-delay: 0.14s;
  }
  .fs-item:nth-child(4) {
    transition-delay: 0.18s;
  }
  .fs-item:nth-child(5) {
    transition-delay: 0.22s;
  }
  .fs-item:nth-child(6) {
    transition-delay: 0.26s;
  }
  .fs-item:nth-child(7) {
    transition-delay: 0.3s;
  }
  .fs-item:nth-child(8) {
    transition-delay: 0.34s;
  }

  @media (prefers-reduced-motion: reduce) {
    .fs-item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const fsMenu = document.getElementById("fullscreen-menu");
  const fsItems = document.querySelectorAll(".fs-item");

  const toggleFsMenu = () => {
    hamburgerBtn?.classList.toggle("active");
    fsMenu?.classList.toggle("opacity-0");
    fsMenu?.classList.toggle("pointer-events-none");

    if (!fsMenu?.classList.contains("opacity-0")) {
      document.body.style.overflow = "hidden";
      fsItems.forEach((item) => item.classList.add("show"));
    } else {
      document.body.style.overflow = "";
      fsItems.forEach((item) => item.classList.remove("show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleFsMenu);
  fsItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (!fsMenu?.classList.contains("opacity-0")) toggleFsMenu();
    });
  });
</script>
