---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
const currentPath = Astro.url.pathname;
const isActive = (path: string) => isActivePath(currentPath, path);

// TEVA69 (รอบเขียวมรกตนำ-เงินโครเมียมรอง บนโครมเขียวป่า 2026-10-28): navbar ที่ใช้
// งานจริงรอบนี้ — รอบก่อน (LOTTO189) ใช้ NavbarHuay ซึ่งเป็นแถบ sticky สูง 85px
// ที่มีแท็บโลโก้ในกรอบมนฝั่งซ้าย แถวเมนูพร้อมขีดใต้ไล่เฉด และลิ้นชักมือถือที่
// สไลด์ลงมาจากขอบล่างของแถบพร้อม scaleY ไฟล์นี้เป็นคนละทรง:
// **แถบข้อมูลบางๆ เต็มความกว้างด้านบนสุด** + **แถบเมนูทรงแคปซูล rounded-[20px]
// ที่ลอยอยู่ (top-2, max-w-7xl) ไม่ชิดขอบจอ** + มือถือเป็น **เมนูเต็มจอที่เฟดเข้า
// พร้อมรายการไล่ขึ้นทีละตัว**
//
// 🚨🚨 **ไฟล์นี้ค้างชุด "ทองแกน-ครีมอุ่นบนน้ำตาลโอลีฟ" ของ เงินทอง168 ไว้ทั้งไฟล์**
// (f5ba14 fcee52 b37c0b 1b1407 4d3c15 2e2512 ecd5c4 d2b9a4 201906 + rgba 245/186/20 α)
// และก่อนหน้านั้นเป็นชุดทองนำ-โรสโกลด์ของ ขวัญใจ168 (f7c92b ffe6a3 f2bba5 c98a74
// b3121b 5a0a0e eadfce 000000 0b0603 160d06 241509 140c06) และชุดเขียวมะนาว-
// ทองมงกุฎของ KINGKONG555 (8ce023 f2c230 ffe066 e9f7d6 bde397 051400 0f2e05 1a5c04
// 2f8c07 a87a08 06220a) — **ออกครบทุกจุดแล้ว ไม่เหลือทอง ครีม หรือโรสโกลด์**
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
//
// 🚨🚨 **กับดักรอบนี้คือเขียว และหนักกว่าทุกรอบสำหรับไฟล์นี้โดยเฉพาะ** เพราะ
// **เจ้าของธีมเก่าสองรอบก่อนหน้าของไฟล์นี้เอง (KINGKONG555) ก็เป็นเขียวมะนาว**
// เขียวอ่อนของ KINGKONG555 (e9f7d6) ต่างจากชั้นยกรอบนี้ (#e6f7df) แค่สลับสองหลักท้าย
// และ (bde397) ต่างจากเส้นอ่อนรอบนี้ (#b2dba3) ไม่กี่หลัก ส่วน (1a5c04) ขึ้นต้น
// เหมือนเขียวแบรนด์รอบนี้ (#1a7d24) เป๊ะ **"เจอเขียว" ไม่พิสูจน์ว่าเป็นของรอบนี้
// ต้องเทียบเป็นค่าทีละตัว** กับ .claude/brand-spec-teva69.md §2
//
// แกนสีมาจากงานศิลป์จริง "เขียวมรกตนำ เงินโครเมียมรอง": โลโก้เป็นเวิร์ดมาร์ก
// สามมิติที่ครึ่งแรกเป็นตัวอักษรละตินผิวโครเมียมเงินขัดเงา และครึ่งหลังเป็นตัวเลข
// ผิวเขียวมรกตเคลือบเงาเรืองแสง ตัดขอบดำหนาทั้งชุด ส่วนแบนเนอร์เป็นห้องสีขาวครีม
// ที่มีชิปคาสิโนสีเขียวเข้มสลับขาวกองซ้อนกัน
// ⚠️⚠️ **เงินโครเมียมเป็นลายเซ็นของโลโก้ ใช้เป็นเส้น/ตัวอักษรบนโครมเข้มได้
// แต่ไม่ใช่ฮิวของแบรนด์ และห้ามกลายเป็นแรมป์เทาทั้งแถบ**
// พื้นโครมเขียวป่า #0b2a12 (ฐาน) / #051409 (จม) / #15401d (ยก) ·
// เขียวสด #28c437 ถือสถานะ active ขอบแคปซูล และปลายขีดใต้ ·
// เงินโครเมียม #c6cfd2 เป็นต้นขีดใต้ (ไล่เงิน -> เขียว ตามลำดับสีของเวิร์ดมาร์ก) ·
// ทองอำพัน #e3bb45 เป็นขอบปุ่มรองและไอคอนเน้น · เนื้อความเมนู #b4d6ad
// หมึกสว่างสุด #e8fbe4 (14.3:1 บนฐาน)
//
// ปุ่ม "สมัครสมาชิก" เป็นพื้น **เขียวสดถมไล่เฉด** (#28c437 -> #22a82f) คู่หมึกเข้ม
// #051409 — ตรวจทั้งสองสต็อป: **8.1:1 / 6.0:1** ผ่าน AA ทั้งคู่
// ⚠️⚠️ **ห้ามลากสต็อปเข้มลงไปถึง #1a7d24 ใต้หมึกนี้** (#051409 บน #1a7d24 เหลือ
// 3.6:1 ซึ่งตก AA) ค่านั้นเป็นเขียวแบรนด์สำหรับ **ตัวอักษรบนผิวสว่าง** ไม่ใช่
// พื้นปุ่มที่รองหมึกเข้มบนโครม
// ⚠️ **และห้ามสลับเป็นพื้นเขียวเข้มแล้วใส่ตัวอักษรขาว** ในแถบนี้ — คู่ปุ่มต่างกันที่
// "พื้นเขียวสดตัน vs กรอบทองโปร่ง" ไม่ใช่ที่ความสว่างของสีเดียวกัน
// ส่วนปุ่ม "เข้าสู่ระบบ" เป็นปุ่มรอง พื้น #15401d ขอบทอง #e3bb45 ตัวอักษร #e8fbe4
// (10.9:1 บนพื้นยก) จึงไม่ติดปัญหานี้
//
// isActive มาจาก isActivePath ใน src/lib/nav — ห้ามเขียนเทียบสตริงเองในไฟล์นี้
// Astro.url.pathname ถูก percent-encode ไว้ ถ้าเขียนเองหน้า /ทดลองเล่น จะไม่มี
// รายการไหน active เลย
//
// เมนูชุดเดียว ใช้ทั้งแถบบนจอใหญ่และเมนูเต็มจอบนมือถือ — ถ้าแยกเป็นสองชุดเมื่อไหร่
// รอบถัดไปจะมีคนแก้ที่เดียวแล้วอีกที่ค้าง
//
// ลำดับ: หน้าแรก · โปรโมชั่น · สมัครสมาชิก · เข้าสู่ระบบ · แล้วค่อยหน้าอ่านอื่นๆ
// สองรายการกลางเป็น conversion action ไม่ใช่หน้าให้อ่าน จึงต้องอยู่ตรงที่สายตา
// กวาดจากซ้ายไปขวาเจอก่อนหน้าข้อมูล — uploader ส่วนที่ 5 append ต่อท้ายอาร์เรย์
// เสมอ ทุกรอบรีแบรนด์จึงต้องเลื่อนขึ้นมาเอง
//
// toggle cta ของ uploader รอบนี้ **เปิด**: /login กับ /register เป็นหน้าปุ่มจริงที่
// index ได้ จึงมีสองรายการนั้นในเมนู และ /ทางเข้า ถูกถอดออกโดยตั้งใจ เพราะหน้านั้น
// มีไว้เสนอ เข้าสู่ระบบ/สมัครสมาชิก อยู่แล้ว การคงไว้คือลิงก์ที่สามไปที่เดิม
// (หน้า /ทางเข้า ยังมี route และยัง index อยู่ — ถอดแค่รายการในเมนู ห้ามลบไฟล์)
//
// 🚨 ไม่มี /ตรวจหวย, /แนวทาง: **TEVA69 เป็นเว็บเกมพนัน/คาสิโน ไม่ใช่เว็บหวย —
// กลับทิศจากรอบก่อน (LOTTO189) ที่เปิดสองหน้านั้นไว้** รอบนี้ทั้งสองไฟล์ถูกย้าย
// กลับไปจอดที่ src/pages-disabled/ แล้ว จึงไม่มี route ให้ลิงก์ไป ถ้ารอบหน้าเป็น
// แบรนด์หวย ต้องเพิ่มสองบรรทัดนี้คืนพร้อมกับย้ายไฟล์กลับเข้า src/pages/ ไม่งั้น
// verify-build จะฟ้อง href ที่ชี้ไป route ที่ไม่มีจริง
//
// ไอคอนเลือกให้ตรงหมวดเว็บเกมพนัน/คาสิโน ไม่ใช่โพย/ลูกบอลของเว็บหวยหรือกีฬา
// และทุกตัวอยู่ใน <span aria-hidden="true"> ที่เป็น "พี่น้อง" ของ label เสมอ
// ห้ามต่อเข้าไปในข้อความ ไม่งั้น screen reader จะอ่านชื่อไอคอนนำหน้าชื่อเมนู
// (verify-build เช็กให้)
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🏢" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "💬" },
];

// logoAlt เขียนจากไฟล์ logo.webp ของดรอป 2026-10-28 ที่เปิดอ่านจริง —
// ตราชั่งทองกับเหรียญทองของ เงินทอง168 ที่เคยอยู่ในตัวแปรนี้ไม่มีในรูปรอบนี้เลย
// และหัวใจของ ขวัญใจ168 (เจ้าของธีมเดิมของไฟล์นี้) ก็ไม่มีเช่นกัน
// ⚠️ โลโก้รอบนี้ **ไม่มีคน ไม่มีสัตว์ ไม่มีมงกุฎ ไม่มีชิป และไม่มีสัญลักษณ์ใดๆ
// นอกจากตัวเวิร์ดมาร์กกับแสงเรืองใต้ตัวอักษร**
const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส เป็นเวิร์ดมาร์กสามมิติตัวหนาวางเรียงเป็นแถวเดียว ครึ่งแรกเป็นตัวอักษรละตินผิวโครเมียมเงินขัดเงา ไล่จากเงินสว่างด้านบนลงมาหาเทาเข้มด้านล่าง และครึ่งหลังเป็นตัวเลขผิวเขียวมรกตเคลือบเงา ไล่จากเขียวสดด้านบนลงมาหาเขียวเข้มด้านล่าง ทั้งชุดตัดขอบสีดำหนาและมีเส้นไฮไลต์สีขาวพาดอยู่ที่ขอบบนของตัวอักษร ใต้เวิร์ดมาร์กมีแถบแสงเรืองสีเขียวมรกตทอดยาวเป็นเงาสะท้อน`;

// แถบบนสุดพูดได้เฉพาะสิ่งที่บรีฟพูด (src/assets/content.txt): เกมเดิมพันออนไลน์
// หลากหลายประเภท · รายละเอียดระบบสมาชิก โปรโมชั่น และช่องทางติดต่อเจ้าหน้าที่ ·
// ค่ายแท้ ถูกลิขสิทธิ์ เซิร์ฟนอก · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% ·
// เจ้าหน้าที่ 24ชม.
// ⚠️ **บรีฟรอบนี้ไม่มีหมวดฝากถอน/ธนาคาร/วอลเลทเลยสักคำ** จึงไม่มีในแถบนี้
// ไม่มีหวย/สลาก/อัตราจ่าย 2 ตัว 3 ตัว (ของ LOTTO189 รอบก่อน) ไม่มีบาคาร่า/บอล
// ไม่มีชื่อค่ายเกม ไม่มีจำนวนเกม และไม่มียอดขั้นต่ำเป็นตัวเลข
---

<div class="hidden w-full border-b border-[#28c437]/35 bg-gradient-to-r from-[#051409] via-[#15401d] to-[#051409] px-4 py-1.5 font-sans text-xs font-bold text-[#b4d6ad] lg:block">
  <div class="mx-auto flex max-w-7xl justify-between">
    <div class="flex gap-4">
      <span class="flex items-center gap-1"><span aria-hidden="true" class="text-[#e3bb45]">★</span> {BRAND_NAME} นำเสนอข้อมูลเกมเดิมพันออนไลน์หลากหลายประเภท พร้อมรายละเอียดระบบสมาชิก โปรโมชั่น และช่องทางติดต่อเจ้าหน้าที่ไว้ในเว็บไซต์เดียว</span>
      <span class="flex items-center gap-1 text-[#e8fbe4]"><span aria-hidden="true" class="text-[#28c437]">✔</span> ค่ายแท้ ถูกลิขสิทธิ์ เซิร์ฟนอก · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8%</span>
    </div>
    <div class="flex gap-4">
      <a href="/line" class="flex items-center gap-1 transition-colors hover:text-[#28c437]">ติดต่อเจ้าหน้าที่เรื่องสมัครสมาชิก เข้าสู่ระบบ และรายละเอียดโปรโมชั่น ได้ตลอด 24ชม.</a>
    </div>
  </div>
</div>

<header class="sticky top-2 z-50 mt-2 w-full px-2 font-sans md:px-4">
  <nav
    class="relative mx-auto flex h-[75px] w-full max-w-7xl items-center justify-between rounded-[20px] border border-[#28c437]/45 bg-[#051409]/92 px-4 shadow-[0_10px_30px_rgba(40,196,55,0.28)] backdrop-blur-lg xl:px-8">
    <a href="/" class="z-50 flex-shrink-0 transition-transform hover:scale-105">
      {
        mainLogo ? (
          <Picture
            src={mainLogo}
            alt={logoAlt}
            loading="eager"
            fetchpriority="high"
            widths={[120, 240, 360]}
            sizes="120px"
            class="h-[40px] w-auto drop-shadow-[0_0_10px_rgba(40,196,55,0.55)] xl:h-[45px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            quality={45}
          />
        ) : (
          <span class="bg-gradient-to-b from-[#c6cfd2] via-[#28c437] to-[#1a7d24] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(40,196,55,0.45)]">{BRAND_NAME}</span>
        )
      }
    </a>

    <div class="hidden h-full items-center gap-4 lg:flex xl:gap-6">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`group relative flex h-full items-center gap-1.5 text-sm font-bold tracking-wide transition-colors ${isActive(item.path) ? "text-[#28c437] drop-shadow-[0_0_8px_rgba(40,196,55,0.5)]" : "text-[#b4d6ad] hover:text-[#e8fbe4]"}`}>
            <span aria-hidden="true" class="text-base transition-transform group-hover:scale-110">
              {item.icon}
            </span>
            <span>{item.name}</span>
            <div
              aria-hidden="true"
              class={`absolute bottom-[18px] left-0 h-[2px] w-full origin-center bg-gradient-to-r from-[#c6cfd2] to-[#28c437] shadow-[0_0_8px_rgba(40,196,55,0.7)] transition-transform duration-300 ${isActive(item.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
            />
          </a>
        ))
      }
    </div>

    <div class="z-50 flex items-center gap-3">
      <a
        href="/login"
        class="hidden items-center justify-center gap-1.5 rounded-full border border-[#e3bb45]/60 bg-[#15401d] px-5 py-2 text-sm font-bold text-[#e8fbe4] shadow-sm transition-all hover:border-[#e3bb45]/80 hover:bg-[#1a7d24] xl:flex">
        <span aria-hidden="true">🔑</span>
        <span>เข้าสู่ระบบ</span>
      </a>
      <a
        href="/register"
        class="hidden items-center justify-center gap-1.5 rounded-full bg-gradient-to-r from-[#28c437] to-[#22a82f] px-5 py-2 text-sm font-black text-[#051409] shadow-[0_0_15px_rgba(40,196,55,0.45)] transition-all hover:scale-105 xl:flex">
        <span aria-hidden="true">📝</span>
        <span>สมัครสมาชิก</span>
      </a>

      <button
        id="hamburger-btn"
        class="relative flex h-[42px] w-[42px] flex-col items-center justify-center gap-[5px] rounded-full border border-[#28c437]/45 bg-gradient-to-b from-[#15401d] to-[#051409] shadow-sm lg:hidden"
        aria-label="เปิดเมนู">
        <span class="line-1 h-[2px] w-5 origin-center rounded-full bg-[#28c437] transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-5 origin-center rounded-full bg-[#28c437] transition-all duration-300"></span>
        <span class="line-3 h-[2px] w-5 origin-center rounded-full bg-[#28c437] transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div id="fullscreen-menu" class="pointer-events-none fixed inset-0 z-[40] flex flex-col items-center justify-center bg-[#051409]/98 opacity-0 backdrop-blur-xl transition-opacity duration-500">
    <div class="flex max-h-[88vh] w-full flex-col items-center space-y-3 overflow-y-auto px-6 py-10">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`fs-item flex items-center gap-3 text-xl font-black tracking-wide transition-all duration-300 ${isActive(item.path) ? "text-[#28c437] drop-shadow-[0_0_10px_rgba(40,196,55,0.6)]" : "text-[#b4d6ad] hover:text-[#e8fbe4]"}`}>
            <span aria-hidden="true" class="text-2xl">
              {item.icon}
            </span>
            <span>{item.name}</span>
          </a>
        ))
      }
