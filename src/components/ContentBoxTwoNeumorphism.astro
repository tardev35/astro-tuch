---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture, not docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The intro block is only emitted when a page actually passes default-slot
// content. Rendering it unconditionally left a dead mb-8 gap under the heading
// on every page that used the two-column layout only.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// Flattened: each column's text classes live on its own <article> and the slot
// renders as a direct child. `leading-normal` on the column labels neutralises
// the hoisted `leading-relaxed`. Do not re-add a wrapper <div>.
//
// THE88 palette (แดง-ทอง 2026-09-23): แผ่นนูนวางบนพื้นการ์ด #2d0908 กดเงาลงไปหา
// พื้นเพจแดงเกือบดำ #1c0504 และยกแสงด้วยพื้นยก #4a0d0b ซึ่งไต่ขึ้นเป็นแดงเข้มสด
// #6b0302 ตอน hover หัวข้อไล่จากทองอ่อน #ffe7a6 → ทอง #f2c14e → แดงสด #dd0503
// ซึ่งเป็นคู่สีเดียวกับโลโก้ THE แดงขอบทอง / 88 ครีมขอบทอง ส่วนป้ายคอลัมน์รับทอง
// อ่อน #ffe7a6 ชมพู-เหลืองของ ABM96 และชมพูมาเจนตาของ WY88 ออกทั้งหมด
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-[#2d0908] p-8 shadow-[10px_10px_20px_#1c0504,-10px_-10px_20px_#4a0d0b] transition-all duration-300 hover:shadow-[15px_15px_30px_#1c0504,-15px_-15px_30px_#6b0302]">
    {
      title && (
        <header class="mb-8 border-b border-[#a40201]/65 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#ffe7a6] via-[#f2c14e] to-[#dd0503] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#f7e3dd]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e3dd]">
        {titleleft && <p class="text-2xl leading-normal font-black tracking-wide text-[#ffe7a6]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e3dd] md:border-l md:border-[#a40201]/65 md:pl-8">
        {titleright && <p class="text-2xl leading-normal font-black tracking-wide text-[#ffe7a6]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
