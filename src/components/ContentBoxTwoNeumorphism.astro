---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture, not docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The intro block is only emitted when a page actually passes default-slot
// content. Rendering it unconditionally left a dead mb-8 gap under the heading
// on every page that used the two-column layout only.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// Flattened: each column's text classes live on its own <article> and the slot
// renders as a direct child. `leading-normal` on the column labels neutralises
// the hoisted `leading-relaxed`. Do not re-add a wrapper <div>.
//
// รอบนี้ใบนี้ถือ **docx H2 §9** ของหน้าแรก ("ช่องทางติดต่อแอดมินแทงหวย <แบรนด์>
// ตลอด 24ชม." — content.txt บรรทัด 19) โดยแบ่งย่อหน้าเดียวของบรีฟ (บรรทัด 20)
// เป็นสองซีก ซีกซ้ายคือ **เรื่องที่สอบถามได้ (ประเภทหวย รอบปิดรับ อัตราจ่าย
// การตรวจบิล) และการตรวจช่องทางก่อนส่งข้อความ** ซีกขวาคือ **สิ่งที่ต้องเตรียม
// เมื่อรายการหวยหรือธุรกรรมมีปัญหา** บรีฟไม่ได้ตั้งชื่อให้สองซีก หน้าเพจจึงไม่ส่ง
// titleleft/titleright มา และกล่องนี้ปล่อยหัวข้อออกมาใบเดียวคือหัวข้อของ section เอง
// หัวข้อมาจาก prop เท่านั้น — ห้าม hardcode ข้อความไทยเป็น heading ในไฟล์นี้
//
// ───────────────────────────────────────────────────────────────────────────
// รวย168 (ดรอป 2026-10-23, .claude/brand-spec-ruay168.md §2) —
// **ทองนำ · โครเมียมเงินเป็นวัสดุที่สอง · บนดำสนิท**
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **ทองคานารี-โครเมียมบนน้ำตาลกาแฟ ของ พักยก168**
// ทั้งใบ ซึ่ง "เป็นทองเหมือนกัน" แต่ **คนละค่าทุกตัว** — ต้องเทียบเป็นค่า ไม่ใช่
// ตระกูลสี รอบนี้พื้นเพจเป็น **ดำสนิท** (bg.json = {"mode":"color","color":
// "#000000"}) ไม่ใช่น้ำตาลกาแฟ **ห้ามแก้กลับไปเป็นพื้นสว่างและห้ามเหลือน้ำตาล**
// ลำดับผิว: #1c1a16 ยก (= ฝั่งสว่างของเงานูน) · #121110 การ์ด (ใบนี้) ·
// #070707 จม · #000000 พื้นเพจ · หมึก **#f3ece0** (= BRAND_TEXT, 16.0:1 บนใบนี้)
//
// จังหวะรูปทรงของใบนี้: เป็น **แผ่นนูน neumorphic ใบที่สามของสามใบในหน้า** วางบน
// **ผิวการ์ด #121110** มุม rounded-[30px] และ **ไม่มีกรอบเลย** อีกสองใบคือ §4
// ContentBoxNeumorphism (shared chrome) ซึ่งเป็นมุม rounded-[25px] เงา 12px/-12px
// มีกรอบ #3d3425 และหัวข้อทองทึบจัดกึ่งกลาง · กับ §7
// ContentBoxSevenThreeNeumorphism ซึ่งเป็นมุม rounded-[22px] เงา 10px/-10px
// มีกรอบ และหัวข้อแพลทินัมทึบชิดซ้ายพร้อมแถบตั้ง — สามใบจึงต่างกันทั้งมุม ระยะเงา
// การมี/ไม่มีกรอบ และการจัดหัวข้อ
// ⚠️ ความนูนบนธีมมืดกลับทิศกับรอบที่พื้นเป็นสีสว่าง: **เงาฝั่งมืดเป็น
// rgba(0,0,0,α)** ส่วนฝั่งสว่างเป็น **ผิวยก #1c1a16** ไม่ใช่ขาวและไม่ใช่ทอง
// (ขาว/ทองจะกลายเป็นขอบเรืองแสง ไม่ใช่แสงนูน)
// หัวข้อไล่ **ทอง #ffd94a → โครเมียมเงิน #e8eaee** สองสต็อป ซึ่งไม่ซ้ำกับกล่องอื่น
// บนหน้าเดียวกันสักใบ (§1/§3 ไล่สามสต็อป ทอง→เงิน→ทอง · §5 ไล่ แพลทินัม→ทอง→ทองถม
// · §2/§6 เป็นทองทึบ · §7 เป็นแพลทินัมทึบ · §8 เป็นหมึกดำบนแผ่นทอง ·
// FaqHuay ไล่ เงิน→ทอง→เงิน)
// ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุกสต็อปต้องถือตัวอักษร
// ได้บนผิวการ์ดนี้: #ffd94a 13.8:1 และ #e8eaee 16.0:1 ✅ — **ห้ามเอาทองลึก
// #9d6f06 (4.7:1) เทาเงิน #6b7079 (4.2:1) #b4b9c2 หรือผิวใด ๆ (#1c1a16 #121110
// #070707 #000000 #3d3425) มาเป็นสต็อป**
// ป้ายสองคอลัมน์: ซ้ายทอง #ffd94a (13.8:1) ขวาแพลทินัม #dde1e7 (13.5:1)
// (รอบนี้หน้าเพจไม่ได้ส่งป้ายมา — โค้ดคงไว้ให้แบรนด์ถัดไป) เส้นคั่นเป็น #3d3425
// ⚠️⚠️ **ขาวบนทองได้แค่ ~1.2–2.2:1** — ในไฟล์นี้ไม่มีพื้นถมทองที่ถือตัวอักษรเลย
// ถ้าจะเพิ่มในอนาคต หมึกต้องเป็น #0a0a0a เท่านั้น
// ⚠️ **สีไฮไลต์ <strong> ในเนื้อความมีตัวเดียวคือ #ffd94a** ซึ่งเป็นงานของหน้าเพจ
// ไม่ใช่ของไฟล์นี้
// rgba() ที่อนุญาตรอบนี้: rgba(255,217,74,α) · rgba(227,167,18,α) ·
// rgba(176,125,8,α) · rgba(157,111,6,α) · rgba(232,234,238,α) · rgba(0,0,0,α)
//
// ⚠️⚠️ **ทองผ่านรีโปนี้มาแล้วเกือบทุกเจ้า** ต้อง grep เป็นค่าทีละตัว ทองรอบนี้คือ
// **#ffd94a / #e3a712 / #9d6f06** เท่านั้น และโครเมียมคือ **#e8eaee / #b4b9c2 /
// #6b7079** · ห่างจาก e29f0f (พักยก168) และ e5a81b (UFA324) และ e6a416 (ยูฟ้า168)
// ⚠️⚠️ **มาดาม168 คือแบรนด์ขาออก = เสี่ยงหลงเหลือสูงสุด**: ff2e52 e01238 c9102f
// 1177e8 0e68cc 0a4ea8 00091f 050e26 0b1733 16234a 2a3c70 f4eef1 b3bdd6 d9dfe9
// ชุดทองคานารี-โครเมียมบนน้ำตาลกาแฟของ **พักยก168** ที่เพิ่งอยู่ทั้งใบนี้ (eeae12
// fded41 9f600d e29f0f fdf051 e0e0df c0c0bf a1a09e f4ead6 d6c6a8 291d0f 3a2713
// 32200f 1f1308 4e2f11) ออกครบทุกค่าแล้ว เช่นเดียวกับ **รวยแท้168** (c30303 8f0505
// e81313 dcb95f b8862b 96681f 4a0f0f 461212 280b0b ffeee8 fff1ef ffdbdb c99a3f) ·
// **สบาย168** (2cc3fc 6bdcfb 0a7fbd 063a57 04293d 0a4f74 9ae0fa cdf2ff ccf7ff
// f2fbff dff4fd eafaff a9e3f9 fdcb0c fefb6b 8a6504 0f3a4a 06293c) · **ยูฟ้า168**
// (fee45d e6a416 b8780d 7a4e05 e8ecf1 a8b2bf 78828f 5a6472 15130f 1e1a13 0a0908
// eae3d4 140e02) · **สาธุ168** (0b7d28 0a5f1c 0f9b35 0c3a16 061f0c c9cb63 aeb04a
// 9ba03c d8ffc7 e9fbdd) · **มีทรัพย์168** (dd1b74 a4186b 4a0d35 2d0720 f7dcf6
// f0ccf5) · **ดวงเศรษฐี168** (d9212a 8e1a16 f0c878 fff8d8 2a0608 4e2120 300605
// 150303) · **ufalion168** (d4922c fdfc71 f6e3b4 a25b24 5a3310 33200a 1f1304
// 0a0601 1a1000) · **รวยเทพ168** (f0bb4e ffeccb e4021b d9701a 3b1b0e 260d04 0d0501
// 5c2a06 fff8ec) · **มีเฮ168** (fb1b32 ff8f9c 5c0410 fcd45c 6b4a08 2b0711 1a040a
// 0c0205) · **รวยแทร่168** (039cfa 0494f5 c3ebfc 04366b f9a826 704504 e3f2fc
// 0b2d52 071e38 030f1d) · **นินจา168** (32bcfb a9e9ff fef54b 07335f 6b5c10 0c2a3d
// 071a28 030e16 041019 dceefc) · **สบายเบท168** (2f9ff5 a8dcff d6ecff 0b3f78 ffc82e
// 5c4a16 e8f4ff 0e2238 081726 040d16) · **ถอนชัวร์168** (fa63b9 ffb3de ffd84d
// 2b0f20 1a0914 0d040a 6d0b3f 6b4708 2a0617 fdeaf5) · **มีโชค168** (fcd434 ffeaa0
// f5469f ff8dc6 8c0f52 7a5508 1a0612 f6e4ee) · **ขวัญใจ168** (f7c92b ffe6a3 f2bba5
// c98a74 b3121b 5a0a0e eadfce) · **รับตัง168** (f0b429 ffdc8c d30304 ff6b6e a00203
// 4a0202 9a6c0c cfd9e6) · **สมหวัง168** (fa0513 ffadaf ff5a5f e3b23c ffe5a8 8a6210
// b90203 8c0204 5b0203) · **หวยคิง** (cd9a2c fdeb7c ab7314 f5e7c8 fcd4c3 0c0b0a
// 120a02 1c140b) · **UFA324** (e5a81b ffe08a bb8410 7d5a07 8792a0 f0e8d4 b9c2cc
// 464f5a) · **โปรดี168** (eb0305 e40303 c20305 9b0a0c ff4446 401107 b44c06 7a2f03
// f0b46a d9803a 4d1c0a 2c1004 fff0e4 fff4ea ffd1d1 1a0802) · **นาซ่า168** (1fd8f0
// 0bb6d4 8fd9ec 1d4fd8 143aa0 e6edf8 9fb2cb 273449 1b2434 121722 33455f 0d1017) ·
// **เงินทอง168** (f5ba14 fcee52 b37c0b ecd5c4 d2b9a4 29210f 3d3016 332810 201906
// 2e2512 1b1407 4d3c15) · **NAZA168 ตัวละติน** (fbc134 ffe87a cf9a18 96690a d9c9a6
// cfd6e3 241700 1a1000 432b03 231500)
// ⚠️⚠️ **ffd84d ของ ถอนชัวร์168 ห่างจาก #ffd94a ของรอบนี้แค่ G1 — เจอที่ไหนแปลว่า
// พิมพ์ผิด ไม่ใช่ค่าของรอบนี้**
// ⚠️ ผิวของรอบนี้ (#121110 #1c1a16 #070707 #3d3425) เป็น **ดำอมทองอุ่นมาก ๆ**
// ซึ่งต่างจากน้ำตาลกาแฟของ พักยก168/เงินทอง168 ทุกค่า — ตรวจทีละค่า อย่าตัดสิน
// ด้วยสายตา
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️⚠️ **รอบนี้ไม่มีแดงเลยสักเฉด ไม่มีชมพู ไม่มีน้ำเงิน/ฟ้า/ไซยาน ไม่มีม่วง
// ไม่มีส้ม ไม่มีเขียว ไม่มีโรสโกลด์ ไม่มีครีม ไม่มีพีช และไม่มีน้ำตาล**
const columnLabel = "text-2xl leading-normal font-black tracking-wide";
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[30px] bg-[#121110] p-8 shadow-[10px_10px_22px_rgba(0,0,0,0.7),-10px_-10px_22px_#1c1a16] transition-all duration-300 hover:shadow-[15px_15px_32px_rgba(0,0,0,0.8),-15px_-15px_32px_#1c1a16]">
    {
      title && (
        <header class="mb-8 border-b border-[#3d3425] pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#ffd94a] to-[#e8eaee] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#f3ece0]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3ece0]">
        {titleleft && <p class={`${columnLabel} text-[#ffd94a]`}>{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3ece0] md:border-l md:border-[#3d3425] md:pl-8">
        {titleright && <p class={`${columnLabel} text-[#dde1e7]`}>{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
