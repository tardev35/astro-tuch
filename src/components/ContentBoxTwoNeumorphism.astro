---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture, not docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The intro block is only emitted when a page actually passes default-slot
// content. Rendering it unconditionally left a dead mb-8 gap under the heading
// on every page that used the two-column layout only.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// Flattened: each column's text classes live on its own <article> and the slot
// renders as a direct child. `leading-normal` on the column labels neutralises
// the hoisted `leading-relaxed`. Do not re-add a wrapper <div>.
//
// SAGAME66 palette (ทอง-เงินโครเมียม 2026-09-23): แผ่นนูนวางบนพื้นการ์ด #171006
// กดเงาลงไปหาพื้นเพจน้ำตาลเกือบดำ #0d0903 และยกแสงด้วยพื้นยก #2a1d0b ซึ่งไต่ขึ้น
// เป็นทองลึก #96671a ตอน hover หัวข้อไล่จากทองสว่าง #ffe9a3 → เงินโครเมียม #eef3f8
// → ทองหลัก #e8b93f ซึ่งเป็นลำดับสีเดียวกับโลโก้ SA ทอง / GAME เงิน / 66 ทอง ส่วน
// ป้ายคอลัมน์รับทองสว่าง #ffe9a3 เนื้อความ #e3d8c0 (BRAND_TEXT) — แดง-ทองของ THE88
// และชมพูมาเจนตาของ WY88 ออกทั้งหมด
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-[#171006] p-8 shadow-[10px_10px_20px_#0d0903,-10px_-10px_20px_#2a1d0b] transition-all duration-300 hover:shadow-[15px_15px_30px_#0d0903,-15px_-15px_30px_#96671a]">
    {
      title && (
        <header class="mb-8 border-b border-[#e8b93f]/65 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#ffe9a3] via-[#eef3f8] to-[#e8b93f] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#e3d8c0]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e3d8c0]">
        {titleleft && <p class="text-2xl leading-normal font-black tracking-wide text-[#ffe9a3]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e3d8c0] md:border-l md:border-[#e8b93f]/65 md:pl-8">
        {titleright && <p class="text-2xl leading-normal font-black tracking-wide text-[#ffe9a3]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
