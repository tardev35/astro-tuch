---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture, not docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The intro block is only emitted when a page actually passes default-slot
// content. Rendering it unconditionally left a dead mb-8 gap under the heading
// on every page that used the two-column layout only.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-[#141210] p-8 shadow-[10px_10px_20px_#0b0906,-10px_-10px_20px_#2c2214] transition-all duration-300 hover:shadow-[15px_15px_30px_#0b0906,-15px_-15px_30px_#5b4423]">
    {
      title && (
        <header class="mb-8 border-b border-[#a37c4b]/40 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#f7f1e4] via-[#d1ae72] to-[#a37c4b] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#e8ddc8]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e8ddc8]">
        {titleleft && <p class="text-2xl leading-normal font-black tracking-wide text-[#e4cc95]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e8ddc8] md:border-l md:border-[#a37c4b]/40 md:pl-8">
        {titleright && <p class="text-2xl leading-normal font-black tracking-wide text-[#e4cc95]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
