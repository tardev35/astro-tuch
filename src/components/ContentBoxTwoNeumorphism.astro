---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture, not docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The intro block is only emitted when a page actually passes default-slot
// content. Rendering it unconditionally left a dead mb-8 gap under the heading
// on every page that used the two-column layout only.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// Flattened: each column's text classes live on its own <article> and the slot
// renders as a direct child. `leading-normal` on the column labels neutralises
// the hoisted `leading-relaxed`. Do not re-add a wrapper <div>.
//
// GUCCI168 (รอบแดง-เขียวมรกต-ทอง บนพื้นเกือบดำอมแดง 2026-10-08, brand-spec §3):
// แผ่นนูนวางบนผิวการ์ดยก #1d0b08 ซึ่งสว่างกว่าผิว #140705 ของ ContentBoxNeumorphism
// และสว่างกว่าผิว #090302 ของ ContentBoxSevenThreeNeumorphism ที่อยู่ถัดลงไปในหน้า
// เดียวกัน สามแผ่นนูนในหน้าจึงไม่อ่านเป็นใบเดียวกันซ้ำสามรอบ ที่นี่กดเงาลงไปหาดำสนิท
// และยกแสงขึ้นด้วยแดงลึก #7a0505 ซึ่งเป็นคู่มืด/สว่างในโทนอุ่นเดียวกัน ตอน hover
// ฝั่งสว่างไต่ขึ้นเป็นแดงแบรนด์ #c41115
//
// ความนูนแบบ neumorphic ต้องใช้คู่มืด/สว่างในโทนเดียว สีแบรนด์จึงถูกเก็บไว้ที่หัวข้อ
// กับป้ายคอลัมน์แทนที่จะไปอยู่ในเงา หัวข้อรอบนี้ไล่เขียวสว่าง #2bbf63 → ทองอ่อน
// #ffdf91 → แดงสว่าง #e0201f ซึ่งเป็นลำดับที่ไม่ซ้ำกับกล่องอื่นบนหน้าเดียวกันสักตัว
// ป้ายสองคอลัมน์แยกสีกันคนละข้าง คือซ้ายแดงสว่างและขวาเขียวสว่าง ตามคู่สีจริงของหมวก
// เทพเจ้าโชคลาภในโลโก้ (เขียวมรกตคาดแถบแดง) เส้นคั่นเป็นแดงลึก #7a0505
// เนื้อความ #f6e3cf (= BRAND_TEXT, 14.2:1 บนผิวยก #1d0b08)
//
// ชุดเขียวนีออน-เงินของ BOOM369 ที่เคยค้างในไฟล์นี้ (#42fb5a #dadcdc #04ab3a #036b26
// #0b231b #123a2a #041109 #07170f #f3c44a #ffffff #cfe9d7) ออกครบทุกจุดแล้ว
const columnLabel = "text-2xl leading-normal font-black tracking-wide";
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-[#1d0b08] p-8 shadow-[10px_10px_20px_#000000,-10px_-10px_20px_#7a0505] transition-all duration-300 hover:shadow-[15px_15px_30px_#000000,-15px_-15px_30px_#c41115]">
    {
      title && (
        <header class="mb-8 border-b border-[#7a0505]/80 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#2bbf63] via-[#ffdf91] to-[#e0201f] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#f6e3cf]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e3cf]">
        {titleleft && <p class={`${columnLabel} text-[#e0201f]`}>{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e3cf] md:border-l md:border-[#7a0505]/60 md:pl-8">
        {titleright && <p class={`${columnLabel} text-[#2bbf63]`}>{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
