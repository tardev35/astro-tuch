---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture, not docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The intro block is only emitted when a page actually passes default-slot
// content. Rendering it unconditionally left a dead mb-8 gap under the heading
// on every page that used the two-column layout only.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// Flattened: each column's text classes live on its own <article> and the slot
// renders as a direct child. `leading-normal` on the column labels neutralises
// the hoisted `leading-relaxed`. Do not re-add a wrapper <div>.
//
// NAZA168 (รอบทองอวกาศ-เงินโครเมียม บนน้ำตาลคั่วเข้ม 2026-10-10, brand-spec §2):
// แผ่นนูนใบนี้วางบนผิวยก #4e3406 ซึ่งสว่างที่สุดในชุดผิวของรอบนี้ และสว่างกว่าผิวกลาง
// #432b03 ของ ContentBoxSevenThreeNeumorphism ที่อยู่เหนือขึ้นไปในหน้าเดียวกัน
// สองแผ่นนูนในหน้าจึงไม่อ่านเป็นใบเดียวกันสองรอบ ที่นี่กดเงาลงไปหาดำสนิทและยกแสงขึ้น
// ด้วยทองลึกสุด #6b4a05 ซึ่งเป็นคู่มืด/สว่างในโทนน้ำตาล-ทองเดียวกันตามที่ความนูนแบบนี้
// ต้องการ ตอน hover ฝั่งสว่างไต่ขึ้นเป็นทองกลางเข้ม #cf9a18 (ของอีกใบไต่ไปแค่ทองลึก
// #96690a — คนละปลาย)
//
// ความนูนแบบ neumorphic ต้องใช้คู่มืด/สว่างในโทนเดียว สีแบรนด์จึงถูกเก็บไว้ที่หัวข้อกับ
// ป้ายคอลัมน์แทนที่จะไปอยู่ในเงา หัวข้อรอบนี้ไล่ทองแบรนด์ #fbc134 → โครเมียมสว่าง
// #eef2f8 → ทองสว่าง #ffe87a ซึ่งเป็นลำดับที่ไม่ซ้ำกับกล่องอื่นบนหน้าเดียวกันสักตัว
// ป้ายสองคอลัมน์แยกสีกันคนละข้าง คือซ้ายครีมรอง #d9c9a6 (7.1:1 บนผิวยก) และขวาทอง
// แบรนด์ #fbc134 (7.0:1) เส้นคั่นเป็นทองลึกสุด #6b4a05
// เนื้อความ #fdf3df (= BRAND_TEXT, 10.6:1 บนผิวยก #4e3406)
// §2 ห้าม #6b4a05 กับ #96690a ถือตัวอักษร — ที่นี่ทั้งคู่อยู่ในเงาและเส้นคั่นเท่านั้น
//
// ⚠️ หกในเจ็ดแบรนด์ก่อนหน้าก็มีทอง เจอทองที่ไหนห้ามเหมาว่าเป็นของรอบนี้ ให้เทียบค่า
// เป็นตัวๆ: ชุดแดงเสือโคร่ง-ทองถ่านไฟของ SUPERSLOTCLUB ที่เคยค้างในไฟล์นี้ (#e8232a
// #ff5a46 #7d0f12 #f2b705 #f5cbb0 #fbe8d5 #3d1709 #301105 #180800) ชุดม่วงนีออน-ทอง
// อาร์เขตของ WEPLAY168 (#1e0a3c #17062e #0a0117 #5b1a75 #7a1fc4 #fbe455 #d2a6ff
// #efe6ff #ffd23d #ece2ff) และชุดฟ้าสด-เหลืองมะนาวของ แตกดี168 (#0a1726 #064a86
// #0b6fc4 #fce604 #7bcffb #d4ecfd #dbeafe) ออกครบทุกจุดแล้ว — ทองของรอบนี้ (#fbc134)
// เป็นคนละค่ากับทั้งสามชุด
const columnLabel = "text-2xl leading-normal font-black tracking-wide";
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-[#4e3406] p-8 shadow-[10px_10px_20px_#000000,-10px_-10px_20px_#6b4a05] transition-all duration-300 hover:shadow-[15px_15px_30px_#000000,-15px_-15px_30px_#cf9a18]">
    {
      title && (
        <header class="mb-8 border-b border-[#6b4a05]/80 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#fbc134] via-[#eef2f8] to-[#ffe87a] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#fdf3df]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fdf3df]">
        {titleleft && <p class={`${columnLabel} text-[#d9c9a6]`}>{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fdf3df] md:border-l md:border-[#6b4a05]/70 md:pl-8">
        {titleright && <p class={`${columnLabel} text-[#fbc134]`}>{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
