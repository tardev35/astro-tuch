---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture, not docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The intro block is only emitted when a page actually passes default-slot
// content. Rendering it unconditionally left a dead mb-8 gap under the heading
// on every page that used the two-column layout only.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// Flattened: each column's text classes live on its own <article> and the slot
// renders as a direct child. `leading-normal` on the column labels neutralises
// the hoisted `leading-relaxed`. Do not re-add a wrapper <div>.
//
// แตกดี168 (รอบฟ้าสด-เหลืองมะนาวบนกรมท่าเกือบดำ 2026-10-08, brand-spec §2):
// แผ่นนูนวางบนผิวการ์ดยก #0a1726 ซึ่งสว่างกว่าผิว #07111d ของ
// ContentBoxNeumorphism และสว่างกว่าผิว #020609 ของ
// ContentBoxSevenThreeNeumorphism ที่อยู่เหนือขึ้นไปในหน้าเดียวกัน สามแผ่นนูน
// ในหน้าจึงไม่อ่านเป็นใบเดียวกันซ้ำสามรอบ ที่นี่กดเงาลงไปหาดำสนิทและยกแสงขึ้นด้วย
// ฟ้าเข้ม #064a86 ซึ่งเป็นคู่มืด/สว่างในโทนเย็นเดียวกัน ตอน hover ฝั่งสว่างไต่ขึ้น
// เป็นฟ้ากลาง #0b6fc4
//
// ความนูนแบบ neumorphic ต้องใช้คู่มืด/สว่างในโทนเดียว สีแบรนด์จึงถูกเก็บไว้ที่หัวข้อ
// กับป้ายคอลัมน์แทนที่จะไปอยู่ในเงา หัวข้อรอบนี้ไล่เหลืองมะนาว #fce604 → ฟ้าอ่อน
// #7bcffb → ฟ้าซีด #d4ecfd ซึ่งเป็นลำดับที่ไม่ซ้ำกับกล่องอื่นบนหน้าเดียวกันสักตัว
// ป้ายสองคอลัมน์แยกสีกันคนละข้าง คือซ้ายฟ้าอ่อนและขวาเหลืองมะนาว ตามคู่สีจริงของ
// โลโก้ เส้นคั่นเป็นฟ้าเข้ม #064a86
// เนื้อความ #dbeafe (= BRAND_TEXT, 14.4:1 บนผิวยก #0a1726)
//
// ชุดตรุษจีนแดง-เขียวมรกต-ทองของ GUCCI168 ที่เคยค้างในไฟล์นี้ (#1d0b08 #7a0505
// #c41115 #e0201f #2bbf63 #ffdf91 #f6e3cf) ออกครบทุกจุดแล้ว
const columnLabel = "text-2xl leading-normal font-black tracking-wide";
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-[#0a1726] p-8 shadow-[10px_10px_20px_#000000,-10px_-10px_20px_#064a86] transition-all duration-300 hover:shadow-[15px_15px_30px_#000000,-15px_-15px_30px_#0b6fc4]">
    {
      title && (
        <header class="mb-8 border-b border-[#064a86]/80 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#fce604] via-[#7bcffb] to-[#d4ecfd] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#dbeafe]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dbeafe]">
        {titleleft && <p class={`${columnLabel} text-[#7bcffb]`}>{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dbeafe] md:border-l md:border-[#064a86]/70 md:pl-8">
        {titleright && <p class={`${columnLabel} text-[#fce604]`}>{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
