---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture, not docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The intro block is only emitted when a page actually passes default-slot
// content. Rendering it unconditionally left a dead mb-8 gap under the heading
// on every page that used the two-column layout only.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-[#1a0730] p-8 shadow-[10px_10px_20px_#06020b,-10px_-10px_20px_#3a1566] transition-all duration-300 hover:shadow-[15px_15px_30px_#06020b,-15px_-15px_30px_#5a1141]">
    {
      title && (
        <header class="mb-8 border-b border-[#a48fc4]/25 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#f4ebff] via-[#22c6f0] to-[#e5399f] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#dfd0ee]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dfd0ee]">
        {titleleft && <p class="text-2xl leading-normal font-black tracking-wide text-[#f4ebff]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dfd0ee] md:border-l md:border-[#a48fc4]/25 md:pl-8">
        {titleright && <p class="text-2xl leading-normal font-black tracking-wide text-[#f4ebff]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
