---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture, not docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The intro block is only emitted when a page actually passes default-slot
// content. Rendering it unconditionally left a dead mb-8 gap under the heading
// on every page that used the two-column layout only.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// Flattened: each column's text classes live on its own <article> and the slot
// renders as a direct child. `leading-normal` on the column labels neutralises
// the hoisted `leading-relaxed`. Do not re-add a wrapper <div>.
//
// This card carries docx H2 §6 of the home page (content.txt line 14 —
// สมัครเล่นสล็อต <แบรนด์> ง่ายๆ 3 ขั้นตอน), run one half of the paragraph per
// column. The brief gives those halves no sub-labels, so the page passes neither
// titleleft nor titleright and this box emits exactly one heading — the
// section's own. The brief's three ขั้นตอนที่ 1-3 sub-points are NOT in this
// card: they go through FeatureHighlights, rendered as this card's sibling
// immediately below, because a ContentBox* slot takes exactly one element.
//
// รวยเทพ168 (รอบ **ทองจักรพรรดินำ · แดงชาดเป็นฮิวที่สอง · ทองแดงเป็นฮิวที่สาม ·
// บนดำสนิท** 2026-10-20) — พาเลตต์ตาม .claude/brand-spec-ruaythep168.md §2
// ⚠️ รอบนี้ **ทองนำจริง แดงชาด #e4021b เป็นฮิวที่สอง และบรอนซ์ลึก #5c2a06 ไม่เคยนำ**
// ทองคือสิ่งที่ตาเห็นทั้งฉากในงานศิลป์ (ตัวอักษร "รวย" บนโลโก้ มงกุฎ ริ้วทองโค้ง
// เหรียญทองร่วง หมวกปีกของเทพเจ้าแห่งโชคลาภ และประกายดาว) ส่วนแดงคือเลข "168"
// ชิปคาสิโนแดง-ขาว หัวใจแดง กล่องของขวัญแดง และชุดของนางแบบ
// ⚠️ **palette.json ชี้ถูกเฉพาะ logo.webp** (แดงชาด #e4021b อยู่อันดับสามของ vivid
// = เนื้อแดงของเลข 168) ส่วน dominant ของ banner1/slide1/slide2 เป็น **ดำเกือบสนิท**
// เพราะฉากเป็นพื้นดำ และ vivid ของสไลด์มีโทนผิวนางแบบปน — สองอย่างนั้นไม่ใช่สีแบรนด์
// และพื้นเพจไม่ได้มาจากรูป แต่มาจาก bg.json
// ⚠️ พื้นเพจ **ดำสนิท #000000** (bg.json) ลำดับความลึก: #3b1b0e ยก / #260d04 กลาง /
// #0d0501 จม / #000000 พื้น
//
// จังหวะรูปทรงของใบนี้: เป็น **แผ่นนูน neumorphic ใบที่สองของสองใบในหน้า** วางบน
// **ผิวยก #3b1b0e** ซึ่งสว่างที่สุดในชุดผิว มุม rounded-[30px] และ **ไม่มีกรอบเลย**
// กดเงาลงไปหาผิวจม #0d0501 แล้วยกแสงขึ้นด้วยบรอนซ์ลึก #5c2a06 ตอน hover ฝั่งสว่าง
// ไต่ขึ้นถึงทองแดง #d9701a ส่วนแผ่นนูนอีกใบ (ContentBoxNeumorphism §2) เป็นมุม
// rounded-[25px] **มีกรอบบรอนซ์ลึก** นั่งลึกกว่าที่ผิวกลาง และ **ไม่มี hover**
// — สองใบจึงต่างกันทั้งมุม ความลึกของผิว การมีกรอบ และพฤติกรรมตอน hover
// ความนูนแบบนี้ต้องใช้คู่มืด/สว่างในโทนเดียว สีแบรนด์จึงถูกเก็บไว้ที่หัวข้อกับป้าย
// คอลัมน์ ไม่ใช่ในเงา: หัวข้อไล่ ทองแดง #d9701a → ทองแบรนด์ #f0bb4e → ครีมทอง
// #ffeccb ("ทองแดงไล่ขึ้นครีม") ซึ่งเป็นลำดับที่ไม่ซ้ำกับกล่องอื่นบนหน้าเดียวกัน
// สักใบ และ **เป็นกล่องเดียวของหน้าที่ขึ้นต้นหัวข้อด้วยทองแดง** ⚠️ ไล่เฉดนี้ถูก
// bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุกสต็อปต้องถือตัวอักษรได้ตาม §2
// (#d9701a 4.7:1 ที่ text-2xl font-black = large text · #f0bb4e 8.8:1 · #ffeccb
// 13.4:1 บนผิวยก) — ห้ามเอา #e4021b (3.2:1 ที่นี่) หรือ #5c2a06 มาเป็นสต็อป
// ป้ายสองคอลัมน์แยกฮิวคนละข้าง: ซ้ายทองแบรนด์ #f0bb4e ขวาครีมทอง #ffeccb ทั้งคู่
// เป็น text-2xl font-black (รอบนี้หน้าเพจไม่ได้ส่งป้ายมา เพราะบรีฟไม่ได้ตั้งชื่อ
// ครึ่งย่อหน้าไว้ — โค้ดยังคงไว้ให้แบรนด์ถัดไป) ⚠️ ป้ายขวาเป็นครีม **ไม่ใช่แดง**
// ถึงแม้แดงจะเป็นฮิวที่สองของรอบนี้ เพราะ §2 วัดแดงไว้ 3.2–4.3:1 ทุกผิว และห้าม
// ให้มันถือตัวอักษร
// เส้นคั่นเป็นบรอนซ์ลึก #5c2a06 เนื้อความ #fff8ec (= BRAND_TEXT, 14.7:1 บนผิวยก)
// §2 ห้าม #e4021b #5c2a06 ถือตัวอักษร — ที่นี่อยู่ในเงา เส้นคั่น และออราเท่านั้น
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **ทองนำมาแล้วเกือบทุกแบรนด์ในรีโปนี้**
// ทองรอบนี้คือ #f0bb4e / #ffeccb / #d9701a / #5c2a06 เท่านั้น ⚠️ **#f0bb4e มีค่า R
// ตรงกับ f0b429 ของรับตัง168 เป๊ะ ตัวตัดสินคือ B78 vs B41** และไม่ใช่ fcd45c
// (มีเฮ168 รอบก่อน) f9a826 704504 (รวยแทร่168 ที่เพิ่งอยู่ในไฟล์นี้ทั้งชุด) fef54b
// (นินจา168 เหลืองมะนาว) ffc82e (สบายเบท168) ffd84d (ถอนชัวร์168) fcd434 (มีโชค168)
// f7c92b (ขวัญใจ168) e3b23c (สมหวัง168) e2b33f (KMD88) dfa310 (TND168) f2c230
// (KINGKONG555) e5a81b (UFA324) fad354 (789BETTING) f5c518 (FLASH877) หรือ f7d14e
// (KOON234) · แดงรอบนี้คือ #e4021b เท่านั้น ไม่ใช่ fb1b32 ff8f9c 5c0410 (มีเฮ168)
// fa0513 (สมหวัง168) d30304 (รับตัง168) b3121b (ขวัญใจ168) fb131b (TKB55) หรือ
// fb141b (GT66B)
// ชุดฟ้าอะซัวร์-ทองอำพันของรวยแทร่168 ที่เพิ่งค้างอยู่ทั้งไฟล์นี้ (039cfa 0494f5
// c3ebfc 04366b f9a826 704504 e3f2fc 0b2d52 071e38 030f1d กับ rgba 3/156/250)
// ชุดของสบายเบท168 (2f9ff5 a8dcff ffefbb 0b3f78 ffc82e 5c4a16 e8f4ff 0e2238 081726
// 040d16) ชุดของนินจา168 (32bcfb a9e9ff 07335f fef54b 6b5c10 dceefc) ชุดทองไทย-
// โรสโกลด์-แดงชาดของขวัญใจ168 (f7c92b ffe6a3 f2bba5 c98a74 b3121b 5a0a0e 8a5f12
// eadfce 241509 160d06 0b0603 140c06) ชุดชมพูบับเบิลกัม-ทองเนยของถอนชัวร์168
// (fa63b9 ffb3de ffd84d 2b0f20 1a0914 0d040a 6d0b3f 6b4708 2a0617 fdeaf5) ชุดของ
// มีโชค168 (fcd434 ffeaa0 f5469f ff8dc6 8c0f52 7a5508 1a0612 f6e4ee 24101c 160a12
// 0b0509) ชุดของรับตัง168 (f0b429 ffdc8c d30304 ff6b6e a00203 4a0202 9a6c0c cfd9e6
// f5ece0 2b100f 200a09 140505) ชุดของสมหวัง168 (fa0513 ffadaf ff5a5f e3b23c ffe5a8
// 8a6210 b90203 8c0204 5b0203 3c0303 f4ecea 2c1413 1f0d0c 140706 290f0f) ชุดน้ำเงิน
// ไฟฟ้าของ TSDET911 (0360f3 0292fb 6ec8ff 4fb4ff cfdcec 9db4d4 dde8f7 102a5e)
// ชุดทองอำพันของ TIGERWIN369 (d98324 f7b733 ffd98a f7e4c0 e3cfae 8a5214) ชุดชมพู
// ฮอตของ FAH999 (ff3fa4 ff6cbb ffd1ea f5c53d) และชุดม่วงราชาของ KMD88 (7505cc
// b453ff c07cff d9b8ff ece2f8 bba8d4) ออกครบแล้ว
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง ไม่มีเขียว ไม่มีชมพู/ฟูเชีย
// ไม่มีโรสโกลด์ ไม่มีเงิน/โครเมียม และไม่มีเหลืองมะนาว** ส้มตัวเดียวที่อนุญาตคือ
// ทองแดง #d9701a ซึ่งเป็นเฉดเงาของทอง ไม่ใช่ส้มอิสระ
const columnLabel = "text-2xl leading-normal font-black tracking-wide";
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[30px] bg-[#3b1b0e] p-8 shadow-[10px_10px_22px_#0d0501,-10px_-10px_22px_#5c2a06] transition-all duration-300 hover:shadow-[15px_15px_32px_#0d0501,-15px_-15px_32px_#d9701a]">
    {
      title && (
        <header class="mb-8 border-b border-[#5c2a06] pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#d9701a] via-[#f0bb4e] to-[#ffeccb] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#fff8ec]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fff8ec]">
        {titleleft && <p class={`${columnLabel} text-[#f0bb4e]`}>{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fff8ec] md:border-l md:border-[#5c2a06] md:pl-8">
        {titleright && <p class={`${columnLabel} text-[#ffeccb]`}>{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
