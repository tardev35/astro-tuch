---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture, not docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The intro block is only emitted when a page actually passes default-slot
// content. Rendering it unconditionally left a dead mb-8 gap under the heading
// on every page that used the two-column layout only.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// Flattened: each column's text classes live on its own <article> and the slot
// renders as a direct child. `leading-normal` on the column labels neutralises
// the hoisted `leading-relaxed`. Do not re-add a wrapper <div>.
//
// ABM96 palette (ชมพู-เหลือง): แผ่นนูนวางบนพื้นการ์ด #2a0a1a กดเงาลงไปหาพื้นเพจ
// ชมพูเกือบดำ #12030a และยกแสงด้วยพื้นการ์ดสว่าง #3d0f26 ซึ่งไต่ขึ้นเป็นชมพูเข้มสด
// #d92e6e ตอน hover หัวข้อไล่จากชมพูอ่อน #ffc9dc → ชมพูหลัก #fd6494 → เหลืองโลโก้
// #feda2a ซึ่งเป็นคู่สีเดียวกับโลโก้ ABM ชมพู / 96 เหลือง ส่วนป้ายคอลัมน์รับเหลือง
// อ่อน #ffe98a ม่วง-ทองของ FAH999 และกรมท่า-ทองก่อนหน้านั้นออกทั้งหมด
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-[#2a0a1a] p-8 shadow-[10px_10px_20px_#12030a,-10px_-10px_20px_#3d0f26] transition-all duration-300 hover:shadow-[15px_15px_30px_#12030a,-15px_-15px_30px_#d92e6e]">
    {
      title && (
        <header class="mb-8 border-b border-[#fd6494]/65 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#ffc9dc] via-[#fd6494] to-[#feda2a] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#fbe3ee]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fbe3ee]">
        {titleleft && <p class="text-2xl leading-normal font-black tracking-wide text-[#ffe98a]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fbe3ee] md:border-l md:border-[#fd6494]/65 md:pl-8">
        {titleright && <p class="text-2xl leading-normal font-black tracking-wide text-[#ffe98a]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
