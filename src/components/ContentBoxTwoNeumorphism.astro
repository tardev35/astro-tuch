---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture, not docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The intro block is only emitted when a page actually passes default-slot
// content. Rendering it unconditionally left a dead mb-8 gap under the heading
// on every page that used the two-column layout only.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-[#060c1c] p-8 shadow-[10px_10px_20px_#01030a,-10px_-10px_20px_#0d1730] transition-all duration-300 hover:shadow-[15px_15px_30px_#01030a,-15px_-15px_30px_#16305e]">
    {
      title && (
        <header class="mb-8 border-b border-[#1e7bf5]/40 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#cfe4ff] via-[#1e7bf5] to-[#0a3fa8] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#d6e2f5]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d6e2f5]">
        {titleleft && <p class="text-2xl leading-normal font-black tracking-wide text-[#8ec5ff]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d6e2f5] md:border-l md:border-[#1e7bf5]/40 md:pl-8">
        {titleright && <p class="text-2xl leading-normal font-black tracking-wide text-[#8ec5ff]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
