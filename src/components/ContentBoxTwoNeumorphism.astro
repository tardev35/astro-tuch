---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture, not docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The intro block is only emitted when a page actually passes default-slot
// content. Rendering it unconditionally left a dead mb-8 gap under the heading
// on every page that used the two-column layout only.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// Flattened: each column's text classes live on its own <article> and the slot
// renders as a direct child. `leading-normal` on the column labels neutralises
// the hoisted `leading-relaxed`. Do not re-add a wrapper <div>.
//
// VAK88 palette: the soft-extruded card sits on the brand's navy card surface
// (#0b1020), shadowed into the deepest navy (#04060e) with a gold-lit highlight
// (#241a08), and the heading gradient runs warm white -> metallic gold -> deep
// gold so it reads as the polished gold 88 of the wordmark on the navy ground.
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-[#0b1020] p-8 shadow-[10px_10px_20px_#04060e,-10px_-10px_20px_#241a08] transition-all duration-300 hover:shadow-[15px_15px_30px_#04060e,-15px_-15px_30px_#3a2a0c]">
    {
      title && (
        <header class="mb-8 border-b border-[#8a5f14]/65 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#fff4dd] via-[#e6b23c] to-[#8a5f14] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#ded8ca]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ded8ca]">
        {titleleft && <p class="text-2xl leading-normal font-black tracking-wide text-[#ffd873]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ded8ca] md:border-l md:border-[#8a5f14]/65 md:pl-8">
        {titleright && <p class="text-2xl leading-normal font-black tracking-wide text-[#ffd873]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
