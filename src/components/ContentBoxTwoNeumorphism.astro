---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture, not docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The intro block is only emitted when a page actually passes default-slot
// content. Rendering it unconditionally left a dead mb-8 gap under the heading
// on every page that used the two-column layout only.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// Flattened: each column's text classes live on its own <article> and the slot
// renders as a direct child. `leading-normal` on the column labels neutralises
// the hoisted `leading-relaxed`. Do not re-add a wrapper <div>.
//
// CK268 (รอบเขียวนีออน-โครเมียม-ดำ 2026-09-30): แผ่นนูนวางบนผิวการ์ดดำอมเขียว
// #071007 กดเงาลงไปหาพื้นเพจ #030703 และยกแสงด้วยผิวแผงยกเขียวเข้ม #0f1b0e ซึ่ง
// ไต่ขึ้นเป็นเขียวนีออนแบรนด์ #8bfc13 ตอน hover หัวข้อไล่จากโครเมียมขาว #e8f0e6 →
// เขียวนีออน → เขียวลึก #1a7a08 ซึ่งเป็นสองโทนของโลโก้จริง (ตัว C โครเมียมคู่กับ
// ตัว K เขียวนีออน) ป้ายสองคอลัมน์แยกสีกันคนละข้าง คือซ้ายเขียวอ่อน #c9ff8f ขวา
// โครเมียมขาว เนื้อความ #d5e6cd (BRAND_TEXT) — ชุดแดง-ทองของ LOTTOPLUS ที่ค้างใน
// ไฟล์นี้ (#dc020e #ff2d38 #6b0207 #f3c623 #fde79a #120b0c #1f0a0c #050505
// #f0e2e2) ออกทั้งหมด
const columnLabel = "text-2xl leading-normal font-black tracking-wide";
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-[#071007] p-8 shadow-[10px_10px_20px_#030703,-10px_-10px_20px_#0f1b0e] transition-all duration-300 hover:shadow-[15px_15px_30px_#030703,-15px_-15px_30px_#8bfc13]">
    {
      title && (
        <header class="mb-8 border-b border-[#1a7a08]/70 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#e8f0e6] via-[#8bfc13] to-[#1a7a08] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#d5e6cd]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d5e6cd]">
        {titleleft && <p class={`${columnLabel} text-[#c9ff8f]`}>{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d5e6cd] md:border-l md:border-[#8bfc13]/40 md:pl-8">
        {titleright && <p class={`${columnLabel} text-[#e8f0e6]`}>{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
