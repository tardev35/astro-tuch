---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture, not docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The intro block is only emitted when a page actually passes default-slot
// content. Rendering it unconditionally left a dead mb-8 gap under the heading
// on every page that used the two-column layout only.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// Flattened: each column's text classes live on its own <article> and the slot
// renders as a direct child. `leading-normal` on the column labels neutralises
// the hoisted `leading-relaxed`. Do not re-add a wrapper <div>.
//
// PKG44 (รอบทองเมทัลลิก-โครเมียม-ดำ 2026-09-27): แผ่นนูนวางบนผิวการ์ด #12100a กดเงา
// ลงไปหาพื้นเพจเกือบดำ #080602 และยกแสงด้วยผิวการ์ดยก #2a2110 ซึ่งไต่ขึ้นเป็นทองแบรนด์
// #fdd32a ตอน hover หัวข้อไล่จากทองสว่าง #ffe27a → ขาวโครเมียม #f2f4f7 → ทองลึก
// #c8920a ซึ่งเป็นลำดับโลหะเดียวกับเวิร์ดมาร์ก P ทอง / K เงิน / G44 ทอง ป้ายสองคอลัมน์
// แยกโลหะกันคนละข้าง คือซ้ายทองสว่าง #ffe27a ขวาเงินโครเมียม #c2c8d0 เนื้อความ
// #efe6d2 (BRAND_TEXT) — ทอง-โครเมียมของ MIRACLE55 (#fcda65 #fee47b #d9a62b
// #fcfcfc #d2d3d4 #14100a #2c241c #050403 #e8e6e1) ออกทั้งหมด
const columnLabel = "text-2xl leading-normal font-black tracking-wide";
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-[#12100a] p-8 shadow-[10px_10px_20px_#080602,-10px_-10px_20px_#2a2110] transition-all duration-300 hover:shadow-[15px_15px_30px_#080602,-15px_-15px_30px_#fdd32a]">
    {
      title && (
        <header class="mb-8 border-b border-[#c8920a]/60 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#ffe27a] via-[#f2f4f7] to-[#c8920a] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#efe6d2]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#efe6d2]">
        {titleleft && <p class={`${columnLabel} text-[#ffe27a]`}>{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#efe6d2] md:border-l md:border-[#c2c8d0]/35 md:pl-8">
        {titleright && <p class={`${columnLabel} text-[#c2c8d0]`}>{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
