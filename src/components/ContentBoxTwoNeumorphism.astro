---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture, not docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The intro block is only emitted when a page actually passes default-slot
// content. Rendering it unconditionally left a dead mb-8 gap under the heading
// on every page that used the two-column layout only.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// Flattened: each column's text classes live on its own <article> and the slot
// renders as a direct child. `leading-normal` on the column labels neutralises
// the hoisted `leading-relaxed`. Do not re-add a wrapper <div>.
//
// BOOM369 (รอบเขียวนีออน-เงิน บนดำสนิท 2026-10-07, brand-spec §2): แผ่นนูนวางบน
// ผิวการ์ดยก #0b231b ซึ่งสว่างกว่าผิว #07170f ของ ContentBoxNeumorphism และลึกกว่า
// ผิว #041109 ของ ContentBoxSevenThreeNeumorphism ที่อยู่ถัดลงไปในหน้าเดียวกัน
// สามแผ่นนูนในหน้าจึงไม่อ่านเป็นใบเดียวกันซ้ำสามรอบ ที่นี่กดเงาลงไปหาพื้นเพจดำสนิท
// #000000 และยกแสงขึ้นด้วยผิวกรอบเขียวเข้ม #123a2a ซึ่งไต่ขึ้นเป็นเขียวนีออน
// #42fb5a ตอน hover
//
// ความนูนแบบ neumorphic ต้องใช้คู่มืด/สว่างในโทนเดียว สีแบรนด์จึงถูกเก็บไว้ที่หัวข้อ
// กับป้ายคอลัมน์แทนที่จะไปอยู่ในเงา หัวข้อรอบนี้ไล่ทอง #f3c44a → เขียวนีออน #42fb5a
// → ขาว #ffffff ซึ่งเป็นลำดับที่ไม่ซ้ำกับกล่องอื่นบนหน้าเดียวกันสักตัว ป้ายสองคอลัมน์
// แยกสีกันคนละข้าง คือซ้ายเขียวนีออนและขวาเงินโครเมียม #dadcdc ตามคู่วัสดุจริงของ
// โลโก้ (BOOM นีออน + 369 เงินแปรง) เส้นคั่นเป็นเขียวลึก #036b26
// เนื้อความ #cfe9d7 (= BRAND_TEXT)
//
// ชุดแดงแบรนด์ + ทองของ หวย24 ที่เคยค้างในไฟล์นี้ (#230d0d #0a0303 #3d1515 #d20a0a
// #7a0505 #f5c33b #ffd45e #ff3b3b #f7e2d6) ออกครบทุกจุดแล้ว
const columnLabel = "text-2xl leading-normal font-black tracking-wide";
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-[#0b231b] p-8 shadow-[10px_10px_20px_#000000,-10px_-10px_20px_#123a2a] transition-all duration-300 hover:shadow-[15px_15px_30px_#000000,-15px_-15px_30px_#42fb5a]">
    {
      title && (
        <header class="mb-8 border-b border-[#036b26]/80 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#f3c44a] via-[#42fb5a] to-[#ffffff] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#cfe9d7]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cfe9d7]">
        {titleleft && <p class={`${columnLabel} text-[#42fb5a]`}>{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cfe9d7] md:border-l md:border-[#036b26]/60 md:pl-8">
        {titleright && <p class={`${columnLabel} text-[#dadcdc]`}>{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
