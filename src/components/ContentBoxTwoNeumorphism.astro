---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture, not docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The intro block is only emitted when a page actually passes default-slot
// content. Rendering it unconditionally left a dead mb-8 gap under the heading
// on every page that used the two-column layout only.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// Flattened: each column's text classes live on its own <article> and the slot
// renders as a direct child. `leading-normal` on the column labels neutralises
// the hoisted `leading-relaxed`. Do not re-add a wrapper <div>.
//
// รอบนี้ใบนี้ถือ **docx H2 §7** ของหน้าแรก ("ช่องทางติดต่อแอดมิน <แบรนด์> ตลอด
// 24ชม." — content.txt บรรทัด 22) โดยแบ่งย่อหน้าเดียวของบรีฟเป็นสองซีก ซีกซ้ายคือ
// **เรื่องที่สอบถามได้และการตรวจช่องทางก่อนส่งข้อความ** ซีกขวาคือ **สิ่งที่ต้อง
// เตรียมเมื่อธุรกรรมมีปัญหา** บรีฟไม่ได้ตั้งชื่อให้สองซีก หน้าเพจจึงไม่ส่ง
// titleleft/titleright มา และกล่องนี้ปล่อยหัวข้อออกมาใบเดียวคือหัวข้อของ section เอง
//
// ───────────────────────────────────────────────────────────────────────────
// พักยก168 (2026-10-22) — พาเลตตาม .claude/brand-spec-pakyok168.md §2
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **แดงคริมสัน-ทองโบราณบนผิวขาว ของ รวยแท้168**
// ทั้งใบ จึงกลับทิศทั้งไฟล์: **รอบนี้เป็นธีมมืด** พื้นเพจ #291d0f (bg.json =
// น้ำตาลกาแฟเข้ม) การ์ดเนื้อหาเป็น **ผิวน้ำตาลเข้ม + หมึกไอวอรี**
// **ห้ามแก้กลับไปเป็นพื้นสว่าง**
// ลำดับผิว: #3a2713 ยก · #32200f กลาง (ใบนี้) · #1f1308 จม · #291d0f พื้นเพจ
//
// จังหวะรูปทรงของใบนี้: เป็น **แผ่นนูน neumorphic ใบที่สองของสองใบในหน้า** วางบน
// **ผิวกลาง #32200f** มุม rounded-[30px] และ **ไม่มีกรอบเลย** แผ่นนูนอีกใบคือ §2
// ContentBox3ThreeNeumorphism ซึ่งเป็นมุม rounded-[25px] นั่งบน **ผิวยก #3a2713**
// ที่สว่างกว่า และเงาฝั่งสว่างของมันเป็น #4e2f11 ส่วนของใบนี้เป็น #3a2713 — สองใบ
// จึงต่างกันทั้งมุม ระดับผิว และค่าของเงาฝั่งสว่าง
// ⚠️ ความนูนบนธีมมืดกลับทิศกับรอบที่พื้นเป็นสีสว่าง: **เงาฝั่งมืดเป็น rgba(0,0,0,α)**
// ส่วนฝั่งสว่างเป็น **น้ำตาลยก #3a2713** ไม่ใช่ขาว (ขาวจะกลายเป็นขอบเรืองแสงที่ไม่มี
// ในพาเลตรอบนี้)
// หัวข้อไล่ โครเมียมสว่าง #e0e0df → ทองสว่าง #fded41 → โครเมียมสว่าง #e0e0df
// ("โครเมียมคร่อมทอง") ซึ่ง **กลับทางกับ §2** ที่ไล่ ทอง → โครเมียม → ทอง จึงไม่
// อ่านซ้ำกัน
// ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุกสต็อปต้องถือตัวอักษร
// ได้: บนผิวกลาง #32200f ได้ #e0e0df 12.0:1 และ #fded41 12.9:1 — **ห้ามเอาทองลึก
// #9f600d (2.8:1) หรือผิวใดๆ (#3a2713 #32200f #1f1308 #291d0f #4e2f11) มาเป็นสต็อป**
// ป้ายสองคอลัมน์: ซ้ายทองแกน #eeae12 (7.9:1 บนผิวกลาง) ขวาโครเมียมสว่าง #e0e0df
// (รอบนี้หน้าเพจไม่ได้ส่งป้ายมา — โค้ดคงไว้ให้แบรนด์ถัดไป) เส้นคั่นเป็นทองแกนโปร่ง
// เนื้อความ #f4ead6 (= BRAND_TEXT) — 13.0:1 บนผิวกลางใบนี้
//
// ⚠️ §2 ห้าม #9f600d ถือตัวอักษร · **สีไฮไลต์ <strong> ในเนื้อความมีตัวเดียวคือ
// #fded41** ซึ่งเป็นงานของหน้าเพจ ไม่ใช่ของไฟล์นี้
// ⚠️ **ทองผ่านรีโปนี้มาแล้วเกือบทุกเจ้า** ต้อง grep เป็นค่าทีละตัว ทองรอบนี้คือ
// #eeae12 / #fded41 เท่านั้น ห่าง e6a416 (ยูฟ้า168) R8/G10/B4 และห่าง e5a81b
// (UFA324) R9/G6/B7 · **ยูฟ้า168 เป็นเจ้าเดียวที่เดินทอง+เงินเหมือนรอบนี้ จึงต้อง
// เทียบค่าหนักที่สุด** และโครเมียมของเขาเป็นเทาอมฟ้าเย็น ส่วนของเราเป็นเทากลาง-อุ่น
// ชุดแดงคริมสัน-ทองโบราณของ **รวยแท้168** ที่เพิ่งอยู่ทั้งใบนี้ (c30303 8f0505 e81313
// dcb95f b8862b 96681f 4a0f0f 461212 280b0b ffeee8 fff1ef ffdbdb c99a3f กับ rgba
// 74/15/15 α)) ออกครบทุกค่าแล้ว เช่นเดียวกับชุดของแบรนด์ขาออก **สบาย168** (2cc3fc
// 6bdcfb 0a7fbd 063a57 04293d 0a4f74 9ae0fa cdf2ff ccf7ff f2fbff dff4fd eafaff
// a9e3f9 fdcb0c fefb6b 8a6504 0f3a4a 06293c 2a1f02) ชุดของ **ยูฟ้า168** (fee45d
// e6a416 b8780d 7a4e05 e8ecf1 a8b2bf 78828f 5a6472 15130f 1e1a13 0a0908 eae3d4
// 140e02 000000) ชุดเขียวมรกตของ **สาธุ168** (0b7d28 0a5f1c 0f9b35 0c3a16 061f0c
// c9cb63 aeb04a 9ba03c d8ffc7 e9fbdd) ชุดชมพูบานเย็นของ **มีทรัพย์168** (dd1b74
// a4186b 4a0d35 2d0720 f7dcf6 f0ccf5) ชุดของ **ดวงเศรษฐี168** (d9212a 8e1a16 f0c878
// fff8d8 2a0608 4e2120 300605 150303) **ufalion168** (d4922c fdfc71 f6e3b4 a25b24
// 5a3310 33200a 1f1304 0a0601 1a1000) **รวยเทพ168** (f0bb4e ffeccb e4021b d9701a
// 3b1b0e 260d04 0d0501 5c2a06 fff8ec) **มีเฮ168** (fb1b32 ff8f9c 5c0410 fcd45c
// 6b4a08 2b0711 1a040a 0c0205) **รวยแทร่168** (039cfa 0494f5 c3ebfc 04366b f9a826
// 704504 e3f2fc 0b2d52 071e38 030f1d) **นินจา168** (32bcfb a9e9ff fef54b 07335f
// 6b5c10 0c2a3d 071a28 030e16 041019 dceefc) **สบายเบท168** (2f9ff5 a8dcff d6ecff
// 0b3f78 ffc82e 5c4a16 e8f4ff 0e2238 081726 040d16) **ถอนชัวร์168** (fa63b9 ffb3de
// ffd84d 2b0f20 1a0914 0d040a 6d0b3f 6b4708 2a0617 fdeaf5) **มีโชค168** (fcd434
// ffeaa0 f5469f ff8dc6 8c0f52 7a5508 1a0612 f6e4ee) **ขวัญใจ168** (f7c92b ffe6a3
// f2bba5 c98a74 b3121b 5a0a0e eadfce) **รับตัง168** (f0b429 ffdc8c d30304 ff6b6e
// a00203 4a0202 9a6c0c cfd9e6) **สมหวัง168** (fa0513 ffadaf ff5a5f e3b23c ffe5a8
// 8a6210 b90203 8c0204 5b0203) **หวยคิง** (cd9a2c fdeb7c ab7314 f5e7c8 fcd4c3 0c0b0a
// 120a02 1c140b) **UFA324** (e5a81b ffe08a bb8410 7d5a07 8792a0 f0e8d4 b9c2cc 464f5a)
// และ **โปรดี168** (eb0305 e40303 c20305 9b0a0c ff4446 401107 b44c06 7a2f03 f0b46a
// d9803a 4d1c0a 2c1004 fff0e4 fff4ea ffd1d1 1a0802)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีเขียว ไม่มีชมพู ไม่มีแดง ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง
// ไม่มีโรสโกลด์ และไม่มีส้ม**
const columnLabel = "text-2xl leading-normal font-black tracking-wide";
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[30px] bg-[#32200f] p-8 shadow-[10px_10px_22px_rgba(0,0,0,0.55),-10px_-10px_22px_#3a2713] transition-all duration-300 hover:shadow-[15px_15px_32px_rgba(0,0,0,0.65),-15px_-15px_32px_#3a2713]">
    {
      title && (
        <header class="mb-8 border-b border-[#eeae12]/40 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#e0e0df] via-[#fded41] to-[#e0e0df] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#f4ead6]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f4ead6]">
        {titleleft && <p class={`${columnLabel} text-[#eeae12]`}>{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f4ead6] md:border-l md:border-[#eeae12]/40 md:pl-8">
        {titleright && <p class={`${columnLabel} text-[#e0e0df]`}>{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
