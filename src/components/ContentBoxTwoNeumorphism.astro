---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture, not docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The intro block is only emitted when a page actually passes default-slot
// content. Rendering it unconditionally left a dead mb-8 gap under the heading
// on every page that used the two-column layout only.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// Flattened: each column's text classes live on its own <article> and the slot
// renders as a direct child. `leading-normal` on the column labels neutralises
// the hoisted `leading-relaxed`. Do not re-add a wrapper <div>.
//
// This card carries docx H2 §2 of the home page (content.txt line 8, run one
// half of the paragraph per column). The brief gives those halves no sub-labels,
// so the page passes neither titleleft nor titleright and this box emits exactly
// one heading — the section's own.
//
// ขวัญใจ168 (รอบทองนำ · โรสโกลด์เป็นฮิวที่สอง · แดงชาดเป็นสำเนียงลึก บนดำสนิท
// 2026-10-18) — พาเลตต์ตาม .claude/brand-spec-kwanjai168.md §2
// ⚠️ รอบนี้ **ทองนำ โรสโกลด์ #f2bba5 เป็นฮิวที่สองจริง แดงชาด #b3121b ไม่เคยนำ**
// โรสโกลด์คือ vivid อันดับหนึ่งที่วัดได้จากงานศิลป์ (ผิวนางแบบ ดอกลิลลี่ขาว ผ้าครีม
// ปักทอง) และเป็นตัวที่แยกรอบนี้ออกจากรอบก่อน — ที่นี่มันถือ **ป้ายคอลัมน์ขวา**
// และเป็นต้นของไล่เฉดหัวข้อ
// ⚠️ พื้นเพจ **ดำสนิท #000000** (bg.json) ลำดับความลึก: #241509 ยก / #160d06 กลาง /
// #0b0603 จม / #000000 พื้น
//
// จังหวะรูปทรงของใบนี้: เป็น **แผ่นนูน neumorphic ใบแรกของสองใบในหน้า** วางบน
// **ผิวยก #241509** ซึ่งสว่างที่สุดในชุดผิว มุม rounded-[30px] และ **ไม่มีกรอบเลย**
// กดเงาลงไปหาผิวจม #0b0603 แล้วยกแสงขึ้นด้วยแดงลึก #5a0a0e ตอน hover ฝั่งสว่าง
// ไต่ขึ้นถึงทองลึก #8a5f12 ส่วนแผ่นนูนอีกใบ (ContentBoxSevenThreeNeumorphism §5)
// เป็นมุม rounded-[22px] **มีกรอบโรสเข้ม** นั่งลึกกว่าที่ผิวจม และยกแสงด้วยผิวยก
// — สองใบจึงต่างกันทั้งมุม ความลึกของผิว การมีกรอบ และพฤติกรรมตอน hover
// ความนูนแบบนี้ต้องใช้คู่มืด/สว่างในโทนเดียว สีแบรนด์จึงถูกเก็บไว้ที่หัวข้อกับป้าย
// คอลัมน์ ไม่ใช่ในเงา: หัวข้อไล่ โรสโกลด์ #f2bba5 → ทองสว่าง #ffe6a3 → ทองแบรนด์
// #f7c92b ("โรสไล่ขึ้นทอง") ซึ่งเป็นลำดับที่ไม่ซ้ำกับกล่องอื่นบนหน้าเดียวกันสักใบ
// ป้ายสองคอลัมน์แยกฮิวคนละข้าง: ซ้ายทองแบรนด์ #f7c92b (7.3:1) ขวาโรสโกลด์
// #f2bba5 (10.4:1) ทั้งคู่เป็น text-2xl font-black จึงเป็น large text
// เส้นคั่นเป็นทองลึก #8a5f12 เนื้อความ #eadfce (= BRAND_TEXT, 13.5:1 บนผิวยก)
// §2 ห้าม #b3121b #5a0a0e #8a5f12 ถือตัวอักษร — ที่นี่อยู่ในเงาและเส้นคั่นเท่านั้น
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือทอง** เพราะทองคือฮิวนำ
// ทั้งที่แทบทุกแบรนด์ที่ผ่านไฟล์นี้ก็มีทอง ทองรอบนี้คือ #f7c92b เท่านั้น ไม่ใช่
// f0b429 (รับตัง168) e3b23c (สมหวัง168) e2b33f (KMD88) dfa310 (TND168)
// f2c230 (KINGKONG555) e5a81b (UFA324) fad354 (789BETTING) f5c518 (FLASH877)
// ชุดเต็มของรับตัง168 (f0b429 ffdc8c d30304 ff6b6e a00203 4a0202 9a6c0c cfd9e6
// f5ece0 2b100f 200a09 140505 1a0505) ชุดของสมหวัง168 (fa0513 ffadaf ff5a5f
// e3b23c ffe5a8 8a6210 b90203 8c0204 5b0203 3c0303 f4ecea 2c1413 1f0d0c 140706
// 290f0f) ชุดน้ำเงินไฟฟ้าของ TSDET911 (0360f3 0292fb 6ec8ff 4fb4ff cfdcec 9db4d4
// dde8f7 102a5e 0a1c42 040e26 00081f) ชุดทองอำพันของ TIGERWIN369 (d98324 f7b733
// ffd98a f7e4c0 e3cfae 8a5214) ชุดชมพูฮอตของ FAH999 (ff3fa4 ff6cbb ffd1ea f5c53d)
// และชุดม่วงราชาของ KMD88 (7505cc b453ff c07cff d9b8ff ece2f8 bba8d4) ออกครบแล้ว
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีเงิน/โครเมียม ไม่มีม่วง ไม่มีชมพูบานเย็น ไม่มีเขียว ไม่มีส้ม
// ไม่มีน้ำเงิน ไม่มีฟ้า**
const columnLabel = "text-2xl leading-normal font-black tracking-wide";
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[30px] bg-[#241509] p-8 shadow-[10px_10px_22px_#0b0603,-10px_-10px_22px_#5a0a0e] transition-all duration-300 hover:shadow-[15px_15px_32px_#0b0603,-15px_-15px_32px_#8a5f12]">
    {
      title && (
        <header class="mb-8 border-b border-[#8a5f12]/80 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#f2bba5] via-[#ffe6a3] to-[#f7c92b] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#eadfce]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#eadfce]">
        {titleleft && <p class={`${columnLabel} text-[#f7c92b]`}>{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#eadfce] md:border-l md:border-[#8a5f12]/70 md:pl-8">
        {titleright && <p class={`${columnLabel} text-[#f2bba5]`}>{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
