---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture, not docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The intro block is only emitted when a page actually passes default-slot
// content. Rendering it unconditionally left a dead mb-8 gap under the heading
// on every page that used the two-column layout only.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// Flattened: each column's text classes live on its own <article> and the slot
// renders as a direct child. `leading-normal` on the column labels neutralises
// the hoisted `leading-relaxed`. Do not re-add a wrapper <div>.
//
// FAH999 (รอบชมพูฮอต-ทอง บนพลัมดำ 2026-10-11, brand-spec §2):
// แผ่นนูนใบนี้วางบนผิวยก #4a0b42 ซึ่งสว่างที่สุดในชุดผิวของรอบนี้ และสว่างกว่าผิวกลาง
// #3a0534 ของ ContentBoxSevenThreeNeumorphism ที่อยู่เหนือขึ้นไปในหน้าเดียวกัน
// สองแผ่นนูนในหน้าจึงไม่อ่านเป็นใบเดียวกันสองรอบ ที่นี่กดเงาลงไปหาผิวลึกสุด #210220
// และยกแสงขึ้นด้วยชมพูลึก #b3006a ซึ่งเป็นคู่มืด/สว่างในโทนพลัม-ชมพูเดียวกันตามที่
// ความนูนแบบนี้ต้องการ ตอน hover ฝั่งสว่างไต่ขึ้นถึงชมพูแบรนด์ #ff3fa4 (ของอีกใบไต่ไป
// แค่ชมพูลึก #b3006a — คนละปลาย)
//
// ความนูนแบบ neumorphic ต้องใช้คู่มืด/สว่างในโทนเดียว สีแบรนด์จึงถูกเก็บไว้ที่หัวข้อกับ
// ป้ายคอลัมน์แทนที่จะไปอยู่ในเงา หัวข้อรอบนี้ไล่ทอง #f5c53d → ชมพูซีด #ffd1ea → ชมพู
// อ่อน #ff6cbb ซึ่งเป็นลำดับที่ไม่ซ้ำกับกล่องอื่นบนหน้าเดียวกันสักตัว
// ป้ายสองคอลัมน์แยกสีกันคนละข้าง คือซ้ายชมพูหม่น #e8b9d4 (8.6:1 บนผิวยก) และขวาชมพู
// แบรนด์ #ff3fa4 (4.6:1 — ป้ายนี้เป็น text-2xl font-black จึงเป็น large text)
// เส้นคั่นเป็นชมพูเข้ม #7a0046
// เนื้อความ #fde8f3 (= BRAND_TEXT, 12.7:1 บนผิวยก #4a0b42)
// §2 ห้าม #b3006a #7a0046 #4d002b และ #9c6f08 ถือตัวอักษร — ที่นี่ทั้งหมดอยู่ในเงาและ
// เส้นคั่นเท่านั้น
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี": ชุดทองอวกาศ-เงินโครเมียมของ NAZA168 ที่เคย
// ค้างในไฟล์นี้ (#fbc134 #ffe87a #cf9a18 #96690a #6b4a05 #eef2f8 #d9c9a6 #fdf3df
// #4e3406 #432b03) ชุดทองเป็ด-ส้มอำพันของ DUCK1688 (#f3bb34 #fde464 #c8901a #f58b2a
// #f6ecd9 #1f1709) ชุดทอง-แดงของ GOT777 (#f5c518 #ffe9a8 #96690f #d21622) และชุด
// ชมพู-ม่วงของ BPLAY639 (#f472b6 #fbcfe8 #e9d5f5 #7e22ce) ออกครบทุกจุดแล้ว — ชมพูของ
// รอบนี้ (#ff3fa4 / #ff6cbb / #ffd1ea / #e8b9d4) เป็นคนละค่ากับชมพูของ BPLAY639 ทุกตัว
const columnLabel = "text-2xl leading-normal font-black tracking-wide";
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-[#4a0b42] p-8 shadow-[10px_10px_20px_#210220,-10px_-10px_20px_#b3006a] transition-all duration-300 hover:shadow-[15px_15px_30px_#210220,-15px_-15px_30px_#ff3fa4]">
    {
      title && (
        <header class="mb-8 border-b border-[#7a0046]/80 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#f5c53d] via-[#ffd1ea] to-[#ff6cbb] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#fde8f3]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fde8f3]">
        {titleleft && <p class={`${columnLabel} text-[#e8b9d4]`}>{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fde8f3] md:border-l md:border-[#7a0046]/70 md:pl-8">
        {titleright && <p class={`${columnLabel} text-[#ff3fa4]`}>{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
