---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture, not docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-[#0a1836] p-8 shadow-[10px_10px_20px_#01040f,-10px_-10px_20px_#12285c] transition-all duration-300 hover:shadow-[15px_15px_30px_#01040f,-15px_-15px_30px_#1e4b9e]">
    {
      title && (
        <header class="mb-8 border-b border-[#c3ced9]/25 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#eaf3fd] via-[#c3ced9] to-[#0b6cf0] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="mb-8 text-left text-base leading-relaxed text-[#cfdcea]">
      <slot />
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cfdcea]">
        {titleleft && <p class="text-2xl leading-normal font-black tracking-wide text-[#eaf3fd]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cfdcea] md:border-l md:border-[#c3ced9]/25 md:pl-8">
        {titleright && <p class="text-2xl leading-normal font-black tracking-wide text-[#eaf3fd]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
