---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture, not docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The intro block is only emitted when a page actually passes default-slot
// content. Rendering it unconditionally left a dead mb-8 gap under the heading
// on every page that used the two-column layout only.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// Flattened: each column's text classes live on its own <article> and the slot
// renders as a direct child. `leading-normal` on the column labels neutralises
// the hoisted `leading-relaxed`. Do not re-add a wrapper <div>.
//
// หวย24 (รอบแดงแบรนด์ + ทอง บนดำอมแดง 2026-10-04): แผ่นนูนวางบนผิวการ์ดยก #230d0d
// ซึ่งอุ่นและสว่างกว่าผิวการ์ด #170707 ของ ContentBoxSevenThreeNeumorphism ที่อยู่
// ถัดลงไปในหน้าเดียวกัน สองแผ่นนูนจึงไม่อ่านเป็นใบเดียวกันซ้ำสองรอบ กดเงาลงไปหา
// พื้นเพจดำอมแดง #0a0303 และยกแสงขึ้นด้วยผิวกรอบอุ่น #3d1515 ซึ่งไต่ขึ้นเป็นแดง
// แบรนด์ #d20a0a ตอน hover ความนูนแบบ neumorphic ต้องใช้คู่มืด/สว่างในโทนเดียว
// สีแบรนด์จึงถูกเก็บไว้ที่หัวข้อกับป้ายคอลัมน์แทนที่จะไปอยู่ในเงา หัวข้อรอบนี้ไล่ทอง
// แบรนด์ #f5c33b → ทองสว่าง #ffd45e → แดงสว่าง #ff3b3b ซึ่งเป็นลำดับที่ไม่ซ้ำกับ
// กล่องอื่นบนหน้าเดียวกันสักตัว ป้ายสองคอลัมน์แยกสีกันคนละข้าง คือซ้ายทองสว่าง
// ขวาแดงสว่าง เส้นคั่นเป็นแดงลึก #7a0505 เนื้อความ #f7e2d6 (= BRAND_TEXT)
//
// ชุดทอง-เงินโครเมียมของ 1SS365 ที่เคยค้างในไฟล์นี้ (#121010 #050505 #2a2115
// #edbb23 #ffeeb4 #c8cbce #a87708 #f7d458 #f0e6d2) ออกครบทุกจุดแล้ว
const columnLabel = "text-2xl leading-normal font-black tracking-wide";
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-[#230d0d] p-8 shadow-[10px_10px_20px_#0a0303,-10px_-10px_20px_#3d1515] transition-all duration-300 hover:shadow-[15px_15px_30px_#0a0303,-15px_-15px_30px_#d20a0a]">
    {
      title && (
        <header class="mb-8 border-b border-[#7a0505]/80 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#f5c33b] via-[#ffd45e] to-[#ff3b3b] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#f7e2d6]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e2d6]">
        {titleleft && <p class={`${columnLabel} text-[#ffd45e]`}>{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e2d6] md:border-l md:border-[#7a0505]/50 md:pl-8">
        {titleright && <p class={`${columnLabel} text-[#ff3b3b]`}>{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
