---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture, not docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The intro block is only emitted when a page actually passes default-slot
// content. Rendering it unconditionally left a dead mb-8 gap under the heading
// on every page that used the two-column layout only.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// Flattened: each column's text classes live on its own <article> and the slot
// renders as a direct child. `leading-normal` on the column labels neutralises
// the hoisted `leading-relaxed`. Do not re-add a wrapper <div>.
//
// รอบนี้ (ABM96) ใบนี้ถือ **docx H2 §7** ของหน้าแรก ("แอดมิน <แบรนด์> ออนไลน์ตลอด
// 24ชม." — content.txt บรรทัด 21 ย่อหน้าเต็มอยู่บรรทัด 22) โดยแบ่งย่อหน้าเดียวของ
// บรีฟเป็นสองซีก **โดยไม่ตกประโยคไหน**: ซีกซ้ายคือ **ช่องทางติดต่อที่เว็บไซต์ระบุ
// และคำกำกับให้ตรวจช่องทางจากเว็บไซต์ทางการก่อนส่งข้อความเพื่อหลีกเลี่ยงบัญชีแอบอ้าง**
// ซีกขวาคือ **สิ่งที่ควรทำเมื่อพบปัญหาบัญชีสมาชิกหรือธุรกรรม พร้อมคำกำกับเรื่อง
// รหัสผ่าน/รหัส OTP และการตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุด**
// บรีฟไม่ได้ตั้งชื่อให้สองซีก หน้าเพจจึงไม่ส่ง titleleft/titleright มา กล่องนี้
// จึงปล่อยหัวข้อออกมาใบเดียวคือของ section เอง
// หัวข้อมาจาก prop เท่านั้น — **ห้าม hardcode ข้อความไทยเป็น heading ในไฟล์นี้**
//
// ───────────────────────────────────────────────────────────────────────────
// ABM96 (ดรอป 2026-10-29) — พาเลตตาม .claude/brand-spec-abm96.md §2
// **ชมพูบานเย็น a30d63 นำ · ทองอำพัน f2c14e (โครมเท่านั้น) เป็นคู่รอง ·
// เนื้อหาสว่าง โครมเข้ม**
// 🚨🚨 ไฟล์นี้มาถึงรอบนี้ยังเป็น **ส้มเพลิง/เงินโครเมียมบนธีมมืดของ WIN8S** ทั้งใบ
// จึงรีเธมทั้งไฟล์ และ **กลับทิศ 180° เป็นผิวสว่าง** พื้นเพจมาจาก bg.json เท่านั้น
// = f8b9f0 ชมพูพาสเทลอิ่มตัว **ห้ามดูดสีพื้นจากอาร์ตเวิร์ก**
// ⚠️⚠️ **ห้ามแก้การ์ดใบนี้กลับไปเป็นผิวมืด** — หมึก 3d0a2c บนการ์ดมืดคือตัวอักษร
// หายไปเลย ไม่ใช่แค่จางลง และแผ่นมืดใหญ่กลางโซนเนื้อหาสว่างอ่านเป็นแถบแปลกปลอม
// ลำดับผิว: ffffff ขาวล้วน (ฝั่งสว่างของเงานูน) · fff5fb การ์ดสำรอง ·
// **fcd9ee ผิวยก (ใบนี้)** · f3a7d3 เส้นบาง · f8b9f0 พื้นเพจ ·
// หมึก **3d0a2c** (= BRAND_TEXT, 12.7:1 บนผิวใบนี้) · หมึกรอง 7a4263 (5.9:1)
//
// จังหวะรูปทรงของใบนี้: เป็น **แผ่นนูน neumorphic ใบที่สองของสองใบในหน้า** มุม
// **rounded-[30px]** นั่งบน **ผิวยก fcd9ee** และ **ไม่มีกรอบเลย** อีกใบคือ §5
// ContentBoxSevenThreeNeumorphism ซึ่งเป็นมุม rounded-[22px] บนผิว fff5fb **มีกรอบ**
// และหัวข้อชมพูทึบชิดซ้ายพร้อมแถบตั้ง — สองใบจึงต่างกันทั้งมุม ผิว การมี/ไม่มีกรอบ
// และการจัดหัวข้อ
// ⚠️ ความนูนบนธีมสว่าง **กลับทางกับธีมมืด**: เงาฝั่งมืดเป็น rgba(61,10,44,0.10)
// ส่วนฝั่งสว่างเป็น **ขาวล้วน ffffff** ซึ่งสว่างกว่าผิวการ์ด fcd9ee จึงอ่านเป็นแสง
// **ห้ามใช้ชมพูเข้ม ทอง หรือค่าผิวจมเป็นฝั่งสว่าง** — บนธีมสว่างสามอย่างนั้นจะอ่าน
// เป็นเส้นขอบเรืองแสง ไม่ใช่ความนูน และ **ห้ามลอก alpha ของรอบก่อน** (รอบก่อนเป็น
// ธีมมืดจึงใช้ alpha 0.55-0.65 ซึ่งบนผิวสว่างจะกลายเป็นรอยเปื้อนดำ)
// หัวข้อไล่ **a30d63 -> 7a0449** สองสต็อป แบบ bg-clip-text ซึ่งเป็น **ใบเดียวของ
// หน้าที่หัวข้อเป็นไล่เฉด** (§1 หมึกขาวบนแผ่นถม · §2/§4/§5/§6 ชมพูทึบ · §3 หมึกขาว
// บนแคปซูล · §8 ชมพูทึบบนแผ่นป้ายมีราง)
// ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุกสต็อปต้องถือตัวอักษร
// ได้บนผิวใบนี้: **a30d63 = 5.8:1 · 7a0449 = 8.4:1** ✅ (วัดบน fcd9ee)
// 🚨🚨 **ห้ามลากสต็อปอ่อนกว่า a30d63** — d11a7e บน fcd9ee ได้แค่ 3.9:1 และ
// **ห้ามเอา f3a7d3 fcd9ee e0509f ff7ac2 f2c14e หรือค่าผิวใด ๆ มาเป็นสต็อป**
// ป้ายสองคอลัมน์: ซ้าย **a30d63** ขวา **7a4263** (รอบนี้หน้าเพจไม่ได้ส่งป้ายมา —
// โค้ดคงไว้ให้แบรนด์ถัดไป) เส้นคั่น/เส้นใต้หัวข้อเป็น **f3a7d3**
// 🚨🚨 **f3a7d3 fcd9ee e0509f ff7ac2 ห้ามถือตัวอักษรทุกบริบท** — ในไฟล์นี้อยู่ที่
// เส้นไรผมบนขอบการ์ด เส้นใต้หัวข้อ และเส้นคั่นคอลัมน์ ซึ่งเป็นเส้น/พื้นถมล้วน
// ⚠️ **f2c14e ถือตัวอักษรได้เฉพาะเมื่อนั่งบนโครมเข้ม** จึงไม่อยู่ในไฟล์นี้เลยสักจุด
// ⚠️ **สีไฮไลต์ <strong> ในเนื้อความมีตัวเดียวคือ a30d63** ซึ่งเป็นงานของหน้าเพจ
// rgba() ที่อนุญาตรอบนี้: rgba(163,13,99,α) · rgba(224,80,159,α) ·
// rgba(255,122,194,α) · rgba(209,26,126,α) · rgba(61,10,44,α) · rgba(43,6,32,α)
//
// ⚠️⚠️ **เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี"** — okkub88 เป็น **แบรนด์ชมพู**
// เหมือนรอบนี้เป๊ะ (d91a73 ↔ d11a7e ต่างไม่กี่หลัก · 9c0f55 b01160 ↔ a30d63 ·
// f9b2d9 ↔ f3a7d3 · ffd6fa ffe3f5 ↔ fcd9ee fff5fb) · ถอนชัวร์168 เป็นชมพูบับเบิลกัม
// อีกเจ้า (fa63b9 ↔ e0509f · 6d0b3f ↔ 440d31) · และ 123BET มี a30d1a ซึ่งต่างจาก
// a30d63 **แค่สองหลักท้าย** → **"เจอชมพู" ไม่เคยพิสูจน์ว่าเป็นของรอบนี้**
// **ลิสต์เฮกซ์เต็มของทุกแบรนด์อยู่ที่ .claude/brand-spec-abm96.md §2b — ไม่ซ้ำลง
// ที่นี่โดยตั้งใจ** ค่าที่เพิ่งอยู่ทั้งใบนี้และกวาดออกครบแล้ว (WIN8S): f27a1a
// e5a92b c9d2dc 5a2410 8a3a12 3b130b 2a0a04 250604 140302 1e0101 fdf0e6 e0bda4
// + rgba(242,122,26) rgba(229,169,43) rgba(138,58,18) rgba(30,1,1) rgba(20,3,2)
// (เขียนแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep ที่ไล่หาสีของแบรนด์เก่าสะดุดที่
// คอมเมนต์ของไฟล์นี้เอง · และเขียนชื่อคลาสสีแบบถอดวงเล็บ เพราะ Tailwind สแกน
// คอมเมนต์ด้วย การพิมพ์คลาสเต็มรูปจะทำให้ยูทิลิตี้ของค่านั้นถูก generate จริง)
// ⚠️ **ผ้าซาตินชมพูนวล ดอกไม้ชมพูจาง ลูกไม้ขาว สีผิวนางแบบ และหัวใจสามมิติใน
// อาร์ตเวิร์กเป็นวัตถุในภาพ ไม่ใช่สี UI** — พื้นเพจมาจาก bg.json เท่านั้น
// ⚠️ เขียว 00B900 ของปุ่ม LINE และเขียว success ของฟีดอยู่ไฟล์อื่น **คงไว้**
// ⚠️ **รอบนี้ไม่มีส้ม ไม่มีเขียว ไม่มีแดงชาด ไม่มีม่วง ไม่มีฟ้า/ไซแอน และไม่มี
// แรมป์เทาเงินเลยสักเฉด**
//
// **ห้ามใส่ `text-center` บนการ์ดหรือบน <section>** — มันตกทอดเข้าไปจัดกึ่งกลาง
// ย่อหน้าในสล็อต
const columnLabel = "text-2xl leading-normal font-black tracking-wide";
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full overflow-hidden rounded-[30px] bg-[#fcd9ee] p-8 shadow-[10px_10px_22px_rgba(61,10,44,0.10),-10px_-10px_22px_#ffffff] transition-all duration-300 hover:shadow-[15px_15px_32px_rgba(163,13,99,0.18),-15px_-15px_32px_#ffffff]">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[3px] bg-gradient-to-r from-transparent via-[#e0509f] to-transparent"></div>

    {
      title && (
        <header class="mb-8 border-b border-[#f3a7d3] pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#a30d63] to-[#7a0449] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#3d0a2c]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#3d0a2c]">
        {titleleft && <p class={`${columnLabel} text-[#a30d63]`}>{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#3d0a2c] md:border-l md:border-[#f3a7d3] md:pl-8">
        {titleright && <p class={`${columnLabel} text-[#7a4263]`}>{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
