---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture, not docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The intro block is only emitted when a page actually passes default-slot
// content. Rendering it unconditionally left a dead mb-8 gap under the heading
// on every page that used the two-column layout only.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// Flattened: each column's text classes live on its own <article> and the slot
// renders as a direct child. `leading-normal` on the column labels neutralises
// the hoisted `leading-relaxed`. Do not re-add a wrapper <div>.
//
// LOTTOPLUS (รอบแดง-ทอง-ดำ 2026-09-29): แผ่นนูนวางบนผิวการ์ดดำอมแดง #120b0c กดเงา
// ลงไปหาพื้นเพจ #050505 และยกแสงด้วยผิวแผงยกแดงเข้ม #1f0a0c ซึ่งไต่ขึ้นเป็นแดง
// แบรนด์ #dc020e ตอน hover หัวข้อไล่จากทองอ่อน #fde79a → ทองรอง #f3c623 → แดง
// แบรนด์ ซึ่งเป็นคู่สีของงานอาร์ตจริง (เหรียญทองล้อมบล็อกแดงของเวิร์ดมาร์ก)
// ป้ายสองคอลัมน์แยกสีกันคนละข้าง คือซ้ายทองรอง ขวาแดงสว่าง #ff2d38 เนื้อความ
// #f0e2e2 (BRAND_TEXT) — ชุดชมพูนีออน-ม่วงของ SEXYGAME666 ที่ค้างในไฟล์นี้
// (#fa42b5 #ffb3e2 #8b3df3 #c9a4ff #b01573 #170a22 #1d0c33 #08020d #f2dcee)
// ออกทั้งหมด
const columnLabel = "text-2xl leading-normal font-black tracking-wide";
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-[#120b0c] p-8 shadow-[10px_10px_20px_#050505,-10px_-10px_20px_#1f0a0c] transition-all duration-300 hover:shadow-[15px_15px_30px_#050505,-15px_-15px_30px_#dc020e]">
    {
      title && (
        <header class="mb-8 border-b border-[#6b0207]/70 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#fde79a] via-[#f3c623] to-[#dc020e] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#f0e2e2]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e2e2]">
        {titleleft && <p class={`${columnLabel} text-[#f3c623]`}>{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e2e2] md:border-l md:border-[#dc020e]/40 md:pl-8">
        {titleright && <p class={`${columnLabel} text-[#ff2d38]`}>{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
