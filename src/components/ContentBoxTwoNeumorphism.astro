---
export interface Props {
  titleleft?: string;
  titleright?: string;
}
const { titleleft, titleright } = Astro.props;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-[#0d0616] p-8 shadow-[10px_10px_20px_#000000,-10px_-10px_20px_#1c0b2a] transition-all duration-300 hover:shadow-[15px_15px_30px_#000000,-15px_-15px_30px_#2c046a]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e4d9f5]">
        {titleleft && <h2 class="text-2xl leading-normal font-black tracking-wide text-[#d8a7ff]">{titleleft}</h2>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e4d9f5] md:border-l md:border-[#a855f7]/25 md:pl-8">
        {titleright && <h2 class="text-2xl leading-normal font-black tracking-wide text-[#d8a7ff]">{titleright}</h2>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
