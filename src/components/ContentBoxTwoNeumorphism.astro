---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture, not docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The intro block is only emitted when a page actually passes default-slot
// content. Rendering it unconditionally left a dead mb-8 gap under the heading
// on every page that used the two-column layout only.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// Flattened: each column's text classes live on its own <article> and the slot
// renders as a direct child. `leading-normal` on the column labels neutralises
// the hoisted `leading-relaxed`. Do not re-add a wrapper <div>.
//
// FAH999 palette (royal purple + gold): the soft-extruded card sits on the
// brand's card surface (#2a0a4d), shadowed into the page purple-black (#0d0119)
// with a purple-deep highlight (#4a1188) that steps up to purple-mid (#7c2fd4)
// on hover, and the heading gradient runs bright gold -> primary gold -> purple
// so it reads as the crown's gold on the purple ground. The previous brand's
// navy and its warm golds are gone.
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-[#2a0a4d] p-8 shadow-[10px_10px_20px_#0d0119,-10px_-10px_20px_#4a1188] transition-all duration-300 hover:shadow-[15px_15px_30px_#0d0119,-15px_-15px_30px_#7c2fd4]">
    {
      title && (
        <header class="mb-8 border-b border-[#7c2fd4]/65 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#fef354] via-[#fbbf13] to-[#7c2fd4] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#ecdcff]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ecdcff]">
        {titleleft && <p class="text-2xl leading-normal font-black tracking-wide text-[#ffdf6b]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ecdcff] md:border-l md:border-[#7c2fd4]/65 md:pl-8">
        {titleright && <p class="text-2xl leading-normal font-black tracking-wide text-[#ffdf6b]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
