---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture, not docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The intro block is only emitted when a page actually passes default-slot
// content. Rendering it unconditionally left a dead mb-8 gap under the heading
// on every page that used the two-column layout only.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// Flattened: each column's text classes live on its own <article> and the slot
// renders as a direct child. `leading-normal` on the column labels neutralises
// the hoisted `leading-relaxed`. Do not re-add a wrapper <div>.
//
// รอบนี้ใบนี้ถือ **docx H2 §2** ของหน้าแรก ("<แบรนด์> โปรโมชั่น ฝากรับโบนัสได้
// ทั้งวัน ไม่ต้องทำเทิร์น" — content.txt บรรทัด 5) โดยแบ่งย่อหน้าเดียวของบรีฟ
// (บรรทัด 6) เป็นสองซีก ซีกซ้ายคือ **ตัวโปรโมชั่นที่ระบุไว้ + สิ่งที่ต้องตรวจ
// ก่อนเข้าร่วม** ซีกขวาคือ **โปรฯ อื่นที่มีและคำกำกับให้อ่านข้อกำหนดล่าสุด**
// บรีฟไม่ได้ตั้งชื่อให้สองซีก หน้าเพจจึงไม่ส่ง titleleft/titleright มา และกล่องนี้
// ปล่อยหัวข้อออกมาใบเดียวคือหัวข้อของ section เอง
// หัวข้อมาจาก prop เท่านั้น — ห้าม hardcode ข้อความไทยเป็น heading ในไฟล์นี้
//
// ───────────────────────────────────────────────────────────────────────────
// หมูบิน168 (ดรอป 2026-10-24, .claude/brand-spec-moobin168.md §2) —
// **ชมพูแคนดี้นำ · พลัมเข้มเป็นหมึก · บนพื้นชมพูพาสเทลสว่าง**
// 🚨🚨 **รอบนี้กลับทิศจากรอบก่อนทั้งเว็บ: จากธีมมืด เป็นธีมสว่าง** bg.json =
// {"mode":"color","color":"#ffe5ff"} ชมพูพาสเทลสว่างมาก (รอบก่อน สล็อต168 เป็น
// 140000 ดำอมแดง) **ห้ามแก้การ์ดกลับไปเป็นพื้นมืด** — หมึก #3b0b26 บนการ์ดมืด
// คือตัวอักษรหายไปเลย
// ลำดับผิว: #ffffff ยก (= ฝั่งสว่างของเงานูน) · **#fff0f8 ผิวการ์ด (ใบนี้)** ·
// #ffeef7 wash · #ffe5ff พื้นเพจ · หมึก **#3b0b26** (= BRAND_TEXT, 16.2:1 บนใบนี้)
//
// จังหวะรูปทรงของใบนี้: เป็น **แผ่นนูน neumorphic ใบที่สามของสามใบในหน้า** วางบน
// ผิวการ์ด #fff0f8 มุม rounded-[30px] และ **ไม่มีกรอบเลย** อีกสองใบคือ §1
// ContentBoxNeumorphism ซึ่งเป็นมุม rounded-[25px] เงา 12px/-12px มีกรอบ #f7bcd9
// และหัวข้อชมพูเข้มทึบจัดกึ่งกลาง · กับ §3 ContentBoxSevenThreeNeumorphism ซึ่ง
// เป็นมุม rounded-[22px] เงา 10px/-10px มีกรอบ และหัวข้อพลัมเข้มทึบชิดซ้ายพร้อม
// แถบตั้ง — สามใบจึงต่างกันทั้งมุม ระยะเงา การมี/ไม่มีกรอบ และการจัดหัวข้อ
// ⚠️ ความนูนบนธีมสว่างกลับทิศกับธีมมืด: **เงาฝั่งมืดเป็น rgba(194,24,91,α)**
// ส่วนฝั่งสว่างเป็น **ผิวขาว #ffffff** ไม่ใช่ชมพูสดและไม่ใช่ดำ (ชมพูสด/ดำจะ
// กลายเป็นเส้นขอบ ไม่ใช่แสงนูน)
// หัวข้อไล่ **ชมพูเข้ม #c2185b → พลัมเข้มสุด #8e0f41** สองสต็อป ซึ่งไม่ซ้ำกับ
// กล่องอื่นบนหน้าเดียวกันสักใบ (§1 เป็นชมพูเข้มทึบกึ่งกลาง · §3 เป็นพลัมทึบชิดซ้าย
// · §4 เป็นชมพูเข้มทึบพร้อมแถบตั้ง · §6 ไล่สามสต็อป เข้ม→ชมพู→เข้ม · §7 เป็นหมึก
// ขาวบนป้ายถมชมพูเข้ม · §8 ไล่ พลัม→ชมพู→พลัม บนพื้นเพจ)
// ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุกสต็อปต้องถือ
// ตัวอักษรได้บนผิวการ์ดนี้: #c2185b 5.7:1 และ #8e0f41 8.9:1 ✅ — **ห้ามเอา
// #fa539c (3.1:1) #fb8cc0 #f7bcd9 #ef8dbd #fdc6c3 #ffd1cd หรือผิวใด ๆ
// (#ffffff #fff0f8 #ffeef7 #ffe5ff) มาเป็นสต็อป**
// ป้ายสองคอลัมน์: ซ้ายชมพูเข้ม #c2185b (5.7:1) ขวาพลัมเข้มสุด #8e0f41 (8.9:1)
// (รอบนี้หน้าเพจไม่ได้ส่งป้ายมา — โค้ดคงไว้ให้แบรนด์ถัดไป) เส้นคั่นเป็น #f7bcd9
// 🚨🚨 **#fa539c บนผิวสว่างได้แค่ 3.2:1 ห้ามถือตัวอักษร** และ **ห้ามถมพื้น
// #fa539c แล้ววางหมึกขาว** (3.2:1) พื้นถมที่รับหมึกขาวได้ต้องเป็น #c2185b ลงไป
// ในไฟล์นี้ #fa539c อยู่ที่ **เส้นไรผมบนขอบการ์ด** ซึ่งเป็นพื้นถมล้วน
// ⚠️ **#f7bcd9 #ef8dbd #fdc6c3 #ffd1cd #fb8cc0 ห้ามถือตัวอักษร** — เส้น/พื้นเท่านั้น
// ⚠️ **สีไฮไลต์ <strong> ในเนื้อความมีตัวเดียวคือ #c2185b** ซึ่งเป็นงานของหน้าเพจ
// ไม่ใช่ของไฟล์นี้
// rgba() ที่อนุญาตรอบนี้: rgba(250,83,156,α) · rgba(251,140,192,α) ·
// rgba(194,24,91,α) · rgba(59,11,38,α) · rgba(253,198,195,α)
//
// ⚠️⚠️ **ชมพูคือตระกูลของรอบนี้ จึงต้องเทียบทีละค่าแน่นที่สุด** "เจอชมพูอยู่แล้ว"
// ไม่เคยพิสูจน์ว่าเป็นของรอบปัจจุบัน ชมพูรอบนี้คือ **#fa539c (R250 G83 B156)**
// ⚠️⚠️ **f5469f ของ มีโชค168 ห่างแค่ R5/G13/B3** และ **fa63b9 ของ ถอนชัวร์168
// มี R=fa ตรงกับรอบนี้เป๊ะ** — เจอค่าไหนก็แปลว่าพิมพ์ผิด · **8c0f52 (มีโชค168)
// ห่างจาก #8e0f41 แค่ R2/B17** · **a4186b (มีทรัพย์168) มี 18 กลางค่าเหมือน #c2185b**
// ⚠️⚠️ **สล็อต168 เป็นแบรนด์ขาออก = เสี่ยงหลงเหลือสูงสุด**: fb2e33 cb0b0d d81115
// b00d11 8a0608 c9060a fa292c f92124 f0e6e4 c9b9b7 e3d6d4 7d6f6e 140000 0b0000
// 1c0607 2a0c0d 551c1e
// ชุดที่เคยอยู่ทั้งใบนี้และถอดออกครบแล้ว: **รวย168** ทองนำ-โครเมียมบนดำสนิท
// (ffd94a e3a712 9d6f06 e8eaee b4b9c2 6b7079 dde1e7 f3ece0 121110 1c1a16 070707
// 000000 3d3425) · ก่อนนั้นเป็น **พักยก168** ทองคานารี-โครเมียมบนน้ำตาลกาแฟ
// (eeae12 fded41 9f600d e29f0f fdf051 e0e0df c0c0bf a1a09e f4ead6 d6c6a8 291d0f
// 3a2713 32200f 1f1308 4e2f11)
// ⚠️ ชมพู/แดงของแบรนด์อื่นที่ห้ามใช้: dd1b74 a4186b 4a0d35 2d0720 f7dcf6 f0ccf5
// (มีทรัพย์168 — ⚠️⚠️ **หมูการ์ตูนชมพูเหมือนกัน แต่เป็นหมูสวมหน้ากากโจรบนธีม
// แมเจนต้าพื้นมืด** รอบนี้เป็นหมูมีปีกนางฟ้าบนธีมแคนดี้พื้นสว่าง) · fa63b9 ffb3de
// (ถอนชัวร์168) · f5469f ff8dc6 8c0f52 (มีโชค168) · ff2e52 e01238 c9102f
// (มาดาม168) · fb1b32 ff8f9c 5c0410 (มีเฮ168) · fa0513 ff5a5f ffadaf (สมหวัง168) ·
// b3121b f2bba5 (ขวัญใจ168) · fce2d4 fcd4c3 (หวยคิง) · ff3fa4 ffd1ea (FAH999)
// ⚠️ ทองของแบรนด์อื่น — **รอบนี้ไม่มีทองเลยสักเฉด**: ffd94a eeae12 fded41 dcb95f
// fcd434 f5ba14 fdcb0c fee45d e5a81b e3b23c f9a826 cd9a2c ffc82e ffd84d f5b61d
// ⚠️ **รอบนี้ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง ไม่มีส้ม ไม่มีเขียว (ยกเว้น LINE
// green และเขียว success ที่ไฟล์อื่น) ไม่มีครีม/เบจ/น้ำตาล และไม่มีแรมป์เทาเงิน**
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
const columnLabel = "text-2xl leading-normal font-black tracking-wide";
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full overflow-hidden rounded-[30px] bg-[#fff0f8] p-8 shadow-[10px_10px_22px_rgba(194,24,91,0.16),-10px_-10px_22px_#ffffff] transition-all duration-300 hover:shadow-[15px_15px_32px_rgba(194,24,91,0.22),-15px_-15px_32px_#ffffff]">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[3px] bg-gradient-to-r from-transparent via-[#fa539c] to-transparent"></div>

    {
      title && (
        <header class="mb-8 border-b border-[#f7bcd9] pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#c2185b] to-[#8e0f41] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#3b0b26]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#3b0b26]">
        {titleleft && <p class={`${columnLabel} text-[#c2185b]`}>{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#3b0b26] md:border-l md:border-[#f7bcd9] md:pl-8">
        {titleright && <p class={`${columnLabel} text-[#8e0f41]`}>{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
