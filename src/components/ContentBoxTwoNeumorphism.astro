---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture, not docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The intro block is only emitted when a page actually passes default-slot
// content. Rendering it unconditionally left a dead mb-8 gap under the heading
// on every page that used the two-column layout only.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// Flattened: each column's text classes live on its own <article> and the slot
// renders as a direct child. `leading-normal` on the column labels neutralises
// the hoisted `leading-relaxed`. Do not re-add a wrapper <div>.
//
// รอบนี้ใบนี้ถือ **docx H2 §2** ของหน้าแรก ("สมัครสมาชิก <แบรนด์> รับโปรไม่อั้น
// โบนัสแจกทั้งวันไม่จำกัด" — content.txt บรรทัด 5) โดยซีกซ้ายคือย่อหน้าเต็มของบรีฟ
// (บรรทัด 6) และซีกขวาคือ **ลิสต์ไฮไลต์สั้นที่ไม่ใช่หัวข้อ** (เป็น <ul> ใบเดียว
// ตามกฎ 1 slot = 1 element) บรีฟไม่ได้ตั้งชื่อให้สองซีก หน้าเพจจึงไม่ส่ง
// titleleft/titleright มา กล่องนี้จึงปล่อยหัวข้อออกมาใบเดียวคือของ section เอง
// หัวข้อมาจาก prop เท่านั้น — ห้าม hardcode ข้อความไทยเป็น heading ในไฟล์นี้
//
// ───────────────────────────────────────────────────────────────────────────
// okkub88 (ดรอป 2026-10-24, .claude/brand-spec-okkub88.md §2) —
// **ชมพูบับเบิลกัมนำ · เบอร์รีเข้มเป็นหมึก · บนธีมสว่าง**
// bg.json = {"mode":"color","color":"#ffd6fa"} ชมพูบับเบิลกัมพาสเทล
// **ห้ามแก้การ์ดกลับไปเป็นพื้นมืด** — หมึก #6a0f3c บนการ์ดมืดคือตัวอักษรหายไปเลย
// ลำดับผิว: #ffffff การ์ด/ฝั่งสว่างของเงานูน · **#fff4fb ผิวยก (ใบนี้)** ·
// #ffe3f5 wash · #ffd6fa พื้นเพจ · หมึก **#6a0f3c** (= BRAND_TEXT, 11.6:1 บนใบนี้)
//
// จังหวะรูปทรงของใบนี้: เป็น **แผ่นนูน neumorphic ใบที่สามของสามใบในหน้า** วางบน
// ผิวยก #fff4fb มุม rounded-[30px] และ **ไม่มีกรอบเลย** อีกสองใบคือ §1/§4
// ContentBoxNeumorphism ซึ่งเป็นมุม rounded-[25px] เงา 12px/-12px มีกรอบ #f9b2d9
// และหัวข้อชมพูลึกทึบจัดกึ่งกลาง · กับ §5 ContentBoxSevenThreeNeumorphism ซึ่งเป็น
// มุม rounded-[22px] เงา 10px/-10px มีกรอบ และหัวข้อเบอร์รีเข้มทึบชิดซ้ายพร้อม
// แถบตั้ง — สามใบจึงต่างกันทั้งมุม ระยะเงา การมี/ไม่มีกรอบ และการจัดหัวข้อ
// ⚠️ ความนูนบนธีมสว่าง: **เงาฝั่งมืดเป็น rgba(156,15,85,α)** ส่วนฝั่งสว่างเป็น
// **ผิวขาว #ffffff** ไม่ใช่ชมพูสดและไม่ใช่ดำ (สองอย่างนั้นจะกลายเป็นเส้นขอบ)
// หัวข้อไล่ **ชมพูลึก #9c0f55 → เบอร์รีเข้มสุด #85094a** สองสต็อป ซึ่งไม่ซ้ำกับ
// กล่องอื่นบนหน้าเดียวกันสักใบ
// ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุกสต็อปต้องถือ
// ตัวอักษรได้บนผิวใบนี้: #9c0f55 7.7:1 และ #85094a 9.4:1 ✅ — **ห้ามเอา #fb439b
// (3.3:1) #fc74b5 #ffc2e2 #f9b2d9 #f479b9 หรือผิวใด ๆ (#ffffff #fff4fb #ffe3f5
// #ffd6fa) มาเป็นสต็อป**
// ป้ายสองคอลัมน์: ซ้ายชมพูลึก #9c0f55 ขวาเบอร์รีเข้มสุด #85094a (รอบนี้หน้าเพจ
// ไม่ได้ส่งป้ายมา — โค้ดคงไว้ให้แบรนด์ถัดไป) เส้นคั่นเป็น #f9b2d9
// 🚨🚨 **#fb439b บนผิวสว่างได้แค่ 3.3:1 ห้ามถือตัวอักษร** และ **ห้ามถมพื้น #fb439b
// แล้ววางหมึกขาว** (3.3:1) พื้นที่รับหมึกขาวได้ต้องเป็น #d91a73 (4.8:1) ลงไป
// ในไฟล์นี้ #fb439b อยู่ที่ **เส้นไรผมบนขอบการ์ด** ซึ่งเป็นพื้นถมล้วน
// ⚠️ **#f9b2d9 #f479b9 #fc74b5 #ffc2e2 ห้ามถือตัวอักษร** — เส้น/พื้นเท่านั้น
// ⚠️ **สีไฮไลต์ <strong> ในเนื้อความมีตัวเดียวคือ #9c0f55** ซึ่งเป็นงานของหน้าเพจ
// rgba() ที่อนุญาตรอบนี้: rgba(251,67,155,α) · rgba(255,194,226,α) ·
// rgba(156,15,85,α) · rgba(106,15,60,α) · rgba(249,178,217,α)
//
// ⚠️⚠️ **ชมพูคือตระกูลของรอบนี้ จึงต้องเทียบทีละค่าแน่นที่สุด** "เจอชมพูอยู่แล้ว"
// ไม่เคยพิสูจน์ว่าเป็นของรอบปัจจุบัน ชมพูรอบนี้คือ **#fb439b (R251 G67 B155)**
// ⚠️⚠️ **หมูบิน168 (สองรอบก่อน) ก็เป็นชมพู = กับดักหลัก**: fa539c c2185b 8e0f41
// fb8cc0 fdc6c3 ffd1cd f7bcd9 ef8dbd ffe5ff fff0f8 ffeef7 3b0b26 54123a 7a2350
// ffe9f5 7a4463 (**fb8cc0 ↔ #fb439b R ตรงกันเป๊ะ · f7bcd9 ↔ #f9b2d9 B ตรงกันเป๊ะ ·
// ffe9f5 ↔ #ffe9f7 ต่างแค่ไบต์สุดท้าย**) — ชุดนี้เคยอยู่ทั้งใบนี้ ออกครบแล้ว
// ⚠️⚠️ **โบ๊ะบ๊ะ168 แบรนด์ขาออก (ฟ้าสกาย)**: 00bfff 12b4ef b6e3f0 7fcbe8 4fb8ea
// 06283f 0b4a73 2a87c4 eaf7ff f0faff e4f6fb 355f7d 0f5684 1a6ea8
// ⚠️ ชมพู/แดงของแบรนด์อื่นที่ห้ามใช้: f41571 ff5ca8 (PUNPRO168 — ใกล้ #fb439b
// ที่สุด) · f5469f ff8dc6 8c0f52 (มีโชค168) · fa63b9 ffb3de (ถอนชัวร์168) ·
// dd1b74 a4186b 4a0d35 2d0720 (มีทรัพย์168) · fb2e33 cb0b0d d81115 b00d11 8a0608
// (สล็อต168 — **b00d11 ↔ #b01160 b01 ตรงกัน**) · ff2e52 e01238 c9102f (มาดาม168) ·
// fb1b32 ff8f9c 5c0410 (มีเฮ168) · fa0513 ff5a5f ffadaf (สมหวัง168) · b3121b
// f2bba5 (ขวัญใจ168) · fce2d4 fcd4c3 (หวยคิง) · ff3fa4 ffd1ea (FAH999)
// ⚠️ ทองของแบรนด์อื่น — **รอบนี้ไม่มีทองเลยสักเฉด**: ffd94a eeae12 fded41 dcb95f
// fcd434 f5ba14 fdcb0c fee45d e5a81b e3b23c f9a826 cd9a2c ffc82e ffd84d f5b61d
// ⚠️ **รอบนี้ไม่มีฟ้า/น้ำเงิน/ไซแอน ไม่มีม่วง ไม่มีส้ม ไม่มีเขียว (ยกเว้น LINE
// green และเขียว success ที่ไฟล์อื่น) ไม่มีครีม/เบจ/น้ำตาล และไม่มีแรมป์เทาเงิน**
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
const columnLabel = "text-2xl leading-normal font-black tracking-wide";
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full overflow-hidden rounded-[30px] bg-[#fff4fb] p-8 shadow-[10px_10px_22px_rgba(156,15,85,0.16),-10px_-10px_22px_#ffffff] transition-all duration-300 hover:shadow-[15px_15px_32px_rgba(156,15,85,0.22),-15px_-15px_32px_#ffffff]">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[3px] bg-gradient-to-r from-transparent via-[#fb439b] to-transparent"></div>

    {
      title && (
        <header class="mb-8 border-b border-[#f9b2d9] pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#9c0f55] to-[#85094a] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#6a0f3c]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#6a0f3c]">
        {titleleft && <p class={`${columnLabel} text-[#9c0f55]`}>{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#6a0f3c] md:border-l md:border-[#f9b2d9] md:pl-8">
        {titleright && <p class={`${columnLabel} text-[#85094a]`}>{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
