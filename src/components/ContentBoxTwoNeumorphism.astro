---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture, not docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-[#131519] p-8 shadow-[10px_10px_20px_#000000,-10px_-10px_20px_#1c1f24] transition-all duration-300 hover:shadow-[15px_15px_30px_#000000,-15px_-15px_30px_#5b636b]">
    {
      title && (
        <header class="mb-8 border-b border-[#cfd4da]/25 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#f4f6f8] via-[#cfd4da] to-[#c02434] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dfe4ea]">
        {titleleft && <p class="text-2xl leading-normal font-black tracking-wide text-[#f4f6f8]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dfe4ea] md:border-l md:border-[#cfd4da]/25 md:pl-8">
        {titleright && <p class="text-2xl leading-normal font-black tracking-wide text-[#f4f6f8]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
