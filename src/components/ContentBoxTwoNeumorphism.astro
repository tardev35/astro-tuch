---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture, not docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The intro block is only emitted when a page actually passes default-slot
// content. Rendering it unconditionally left a dead mb-8 gap under the heading
// on every page that used the two-column layout only.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// Flattened: each column's text classes live on its own <article> and the slot
// renders as a direct child. `leading-normal` on the column labels neutralises
// the hoisted `leading-relaxed`. Do not re-add a wrapper <div>.
//
// หวยเฮง789 (รอบแดงนำ-ทองรอง 2026-10-01): แผ่นนูนวางบนผิวพื้นส่วน #1c0606 ซึ่งลึกกว่า
// ผิวการ์ด #2b0909 ของ ContentBoxNeumorphism ที่อยู่เหนือขึ้นไปในหน้าเดียวกัน กดเงาลง
// ไปหาเงาลึกสุด #0b0202 และยกแสงขึ้นด้วยผิวแผงยก #3a0c0c ซึ่งไต่ขึ้นเป็นแดงแบรนด์
// #dc2224 ตอน hover ความนูนแบบ neumorphic ต้องใช้คู่มืด/สว่างในโทนเดียว สีแบรนด์จึง
// ถูกเก็บไว้ที่หัวข้อกับป้ายคอลัมน์แทนที่จะไปอยู่ในเงา หัวข้อรอบนี้เป็นไล่เฉดทองล้วน
// ทองอ่อน #ffefc2 → ทองรอง #f4bc5d → ทองลึก #d99a10 (7.9:1 บนผิวนี้) ต่างจากหัวข้อ
// ทอง→แดงของ ContentBox และแดง→ทองของ ContentBoxNeumorphism ป้ายสองคอลัมน์แยกสีกัน
// คนละข้าง คือซ้ายทองรอง ขวาทองอ่อน เนื้อความ #fbe3d4 (BRAND_TEXT)
//
// ชุดเขียวป่า-ทองของ หวยเต็ง ที่เคยค้างในไฟล์นี้ (#062a12 #010a04 #0b3d18 #e5c04f
// #eafbe9 #026314 #fae474 #d8ead9) ออกครบทุกจุดแล้ว
const columnLabel = "text-2xl leading-normal font-black tracking-wide";
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-[#1c0606] p-8 shadow-[10px_10px_20px_#0b0202,-10px_-10px_20px_#3a0c0c] transition-all duration-300 hover:shadow-[15px_15px_30px_#0b0202,-15px_-15px_30px_#dc2224]">
    {
      title && (
        <header class="mb-8 border-b border-[#a8690c]/70 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#ffefc2] via-[#f4bc5d] to-[#d99a10] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#fbe3d4]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fbe3d4]">
        {titleleft && <p class={`${columnLabel} text-[#f4bc5d]`}>{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fbe3d4] md:border-l md:border-[#a8690c]/40 md:pl-8">
        {titleright && <p class={`${columnLabel} text-[#ffefc2]`}>{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
