---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture, not docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The intro block is only emitted when a page actually passes default-slot
// content. Rendering it unconditionally left a dead mb-8 gap under the heading
// on every page that used the two-column layout only.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// Flattened: each column's text classes live on its own <article> and the slot
// renders as a direct child. `leading-normal` on the column labels neutralises
// the hoisted `leading-relaxed`. Do not re-add a wrapper <div>.
//
// รอบนี้ (WIN8S) ใบนี้ถือ **docx H2 §2** ของหน้าแรก (content.txt บรรทัด 5) โดยแบ่ง
// ย่อหน้าเดียวของบรีฟ (บรรทัด 6) เป็นสองซีกโดยไม่ตกประโยคไหน: ซีกซ้ายคือ **สิ่งที่
// เว็บไซต์ระบุไว้เอง — เซิร์ฟเวอร์ต่างประเทศ ลิขสิทธิ์จากสหรัฐอเมริกา และการ
// ไม่หักเปอร์เซ็นต์** ซีกขวาคือ **ประโยคกำกับทั้งชุด — สิ่งที่ควรตรวจก่อนใช้งาน
// และข้อความที่ว่าเซิร์ฟเวอร์ต่างประเทศไม่ได้รับประกันความปลอดภัยหรือความถูกต้อง
// ตามกฎหมายในไทย**
// บรีฟไม่ได้ตั้งชื่อให้สองซีก หน้าเพจจึงไม่ส่ง titleleft/titleright มา กล่องนี้
// จึงปล่อยหัวข้อออกมาใบเดียวคือของ section เอง
// หัวข้อมาจาก prop เท่านั้น — **ห้าม hardcode ข้อความไทยเป็น heading ในไฟล์นี้**
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตรอบนี้ตาม .claude/brand-spec-win8s.md §2 — **ส้มเพลิง f27a1a นำ · ทองอำพัน
// e5a92b และเงินโครเมียม c9d2dc เป็นวัสดุรอง · มืดทั้งเว็บ**
// 🚨 ไฟล์นี้มาถึงรอบนี้ยังเป็น **เขียวมรกต/ทองของ ZORO365** ทั้งใบ จึงรีเธมทั้งไฟล์
// bg.json ของดรอปนี้ = mode color + color 1e0101 (ดำอมเลือดหมู) และ bg.json คือ
// แหล่งเดียวของพื้นเพจ **ห้ามดูดสีพื้นจากอาร์ตเวิร์ก** ซึ่งรอบนี้สว่างมาก
// ⚠️ **ห้ามแก้การ์ดกลับไปเป็นพื้นสว่าง** — หมึก fdf0e6 บนการ์ดสว่างคือตัวอักษรหายไปเลย
// ลำดับผิว: 140302 ฝั่งมืดของเงานูน · 250604 โครม · **2a0a04 ผิวการ์ด (ใบนี้)** ·
// 3b130b ชั้นยก/ฝั่งสว่างของเงานูน · 1e0101 พื้นเพจ ·
// หมึก **fdf0e6** (= BRAND_TEXT, 16.4:1 บนใบนี้) · หมึกรอง e0bda4 (10.5:1)
//
// จังหวะรูปทรงของใบนี้: เป็น **แผ่นนูน neumorphic ใบแรกของสองใบในหน้า** มุม
// rounded-[30px] และ **ไม่มีกรอบเลย** อีกใบคือ §5 ContentBoxSevenThreeNeumorphism
// ซึ่งเป็นมุม rounded-[22px] เงา 10px/-10px มีกรอบ และหัวข้อส้มทึบชิดซ้ายพร้อม
// แถบตั้ง — สองใบจึงต่างกันทั้งมุม ระยะเงา การมี/ไม่มีกรอบ และการจัดหัวข้อ
// ⚠️ ความนูนบนธีมมืด: **เงาฝั่งมืดเป็น rgba(20,3,2,α)** ส่วนฝั่งสว่างเป็น
// **ผิวยก 3b130b** ไม่ใช่ขาวและไม่ใช่ส้มนีออน (สองอย่างนั้นจะกลายเป็นเส้นขอบ
// เรืองแสงบนธีมมืด ไม่ใช่ความนูน)
// หัวข้อไล่ **เงินโครเมียม c9d2dc -> ส้มเพลิง f27a1a** สองสต็อป ซึ่งอ่านมาจาก
// เวิร์ดมาร์กจริงที่อักขระชุดหนึ่งเป็นผิวส้มเพลิงไล่ทองและอีกชุดเป็นผิวโครเมียมเงิน
// ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุกสต็อปต้องถือ
// ตัวอักษรได้บนผิวใบนี้: c9d2dc 12.0:1 และ f27a1a 6.6:1 ✅ — **ห้ามเอา 5a2410
// 8a3a12 หรือผิวใด ๆ (2a0a04 3b130b 250604 140302 1e0101) มาเป็นสต็อป**
// ป้ายสองคอลัมน์: ซ้ายเงินโครเมียม c9d2dc ขวาส้มเพลิง f27a1a (รอบนี้หน้าเพจไม่ได้
// ส่งป้ายมา — โค้ดคงไว้ให้แบรนด์ถัดไป) เส้นคั่น/เส้นใต้หัวข้อเป็น 5a2410
// 🚨🚨 **5a2410 และ 8a3a12 ห้ามถือตัวอักษร** — เส้น/ขอบ/ออรา/พื้นถมเท่านั้น
// ในไฟล์นี้ e5a92b อยู่ที่ **เส้นไรผมบนขอบการ์ด** ซึ่งเป็นพื้นถมล้วน
// ⚠️ **สีไฮไลต์ <strong> ในเนื้อความมีตัวเดียวคือ f27a1a** ซึ่งเป็นงานของหน้าเพจ
// rgba() ที่อนุญาตรอบนี้: rgba(242,122,26,α) · rgba(229,169,43,α) ·
// rgba(138,58,18,α) · rgba(30,1,1,α) · rgba(20,3,2,α)
//
// ⚠️⚠️ **เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี"** — ZNOVA168 เป็นน้ำตาลเข้ม/อำพัน
// ตระกูลเดียวกับรอบนี้เป๊ะ รองลงมาคือ MEXICANOSLOT และ TEVA69 "เจอส้ม/ทอง" จึง
// ไม่เคยพิสูจน์ว่าเป็นของรอบนี้ ต้องเทียบให้ตรงหกหลัก **ลิสต์เฮกซ์เต็มของทุก
// แบรนด์อยู่ที่ .claude/brand-spec-win8s.md §2 — ไม่ซ้ำลงที่นี่โดยตั้งใจ**
// ค่าที่เพิ่งอยู่ทั้งใบนี้และกวาดออกครบแล้ว (ZORO365): 3ddc4a 35a043 1e7033 0e5424
// 073c1a 031b09 010d04 002908 eef7f0 dfe6e3 e8c86a 9dc2a5
// (เขียนแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep ที่ไล่หาสีของแบรนด์เก่าสะดุดที่
// คอมเมนต์ของไฟล์นี้เอง · และเขียนชื่อคลาสสีแบบถอดวงเล็บ เพราะ Tailwind สแกน
// คอมเมนต์ด้วย การพิมพ์คลาสเต็มรูปจะทำให้ยูทิลิตี้ของค่านั้นถูก generate จริง)
// ⚠️ **ซากุระชมพู-ขาว กิโมโนแดง-ดำปักทอง ร่มกระดาษ พัด ผนังห้องสีขาวงาช้าง และ
// สีผิวนักแสดงในอาร์ตเวิร์กเป็นวัตถุในภาพ ไม่ใช่สี UI** — พื้นเพจมาจาก bg.json เท่านั้น
// ⚠️ เขียว 00B900 ของปุ่ม LINE และเขียว success ของฟีดอยู่ไฟล์อื่น **คงไว้**
const columnLabel = "text-2xl leading-normal font-black tracking-wide";
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full overflow-hidden rounded-[30px] bg-[#2a0a04] p-8 shadow-[10px_10px_22px_rgba(20,3,2,0.55),-10px_-10px_22px_#3b130b] transition-all duration-300 hover:shadow-[15px_15px_32px_rgba(20,3,2,0.65),-15px_-15px_32px_#3b130b]">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[3px] bg-gradient-to-r from-transparent via-[#e5a92b] to-transparent"></div>

    {
      title && (
        <header class="mb-8 border-b border-[#5a2410] pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#c9d2dc] to-[#f27a1a] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#fdf0e6]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fdf0e6]">
        {titleleft && <p class={`${columnLabel} text-[#c9d2dc]`}>{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fdf0e6] md:border-l md:border-[#5a2410] md:pl-8">
        {titleright && <p class={`${columnLabel} text-[#f27a1a]`}>{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
