---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture, not docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The intro block is only emitted when a page actually passes default-slot
// content. Rendering it unconditionally left a dead mb-8 gap under the heading
// on every page that used the two-column layout only.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// Flattened: each column's text classes live on its own <article> and the slot
// renders as a direct child. `leading-normal` on the column labels neutralises
// the hoisted `leading-relaxed`. Do not re-add a wrapper <div>.
//
// WEPLAY168 (รอบม่วงนีออน-ทองอาร์เขต 2026-10-09, brand-spec §2):
// แผ่นนูนวางบนผิวการ์ดยก #1e0a3c ซึ่งสว่างกว่าผิว #17062e ของ
// ContentBoxNeumorphism และสว่างกว่าผิว #0a0117 ของ
// ContentBoxSevenThreeNeumorphism ที่อยู่เหนือขึ้นไปในหน้าเดียวกัน สามแผ่นนูน
// ในหน้าจึงไม่อ่านเป็นใบเดียวกันซ้ำสามรอบ ที่นี่กดเงาลงไปหาดำสนิทและยกแสงขึ้นด้วย
// ม่วงลึก #5b1a75 ซึ่งเป็นคู่มืด/สว่างในโทนม่วงเดียวกัน ตอน hover ฝั่งสว่างไต่ขึ้น
// เป็นม่วงกลาง #7a1fc4
//
// ความนูนแบบ neumorphic ต้องใช้คู่มืด/สว่างในโทนเดียว สีแบรนด์จึงถูกเก็บไว้ที่หัวข้อ
// กับป้ายคอลัมน์แทนที่จะไปอยู่ในเงา หัวข้อรอบนี้ไล่ทองแบรนด์ #fbe455 → ม่วงอ่อน
// #d2a6ff → เงินอมม่วง #efe6ff ซึ่งเป็นลำดับที่ไม่ซ้ำกับกล่องอื่นบนหน้าเดียวกันสักตัว
// ป้ายสองคอลัมน์แยกสีกันคนละข้าง คือซ้ายม่วงอ่อนและขวาทองอุ่น #ffd23d ตามคู่สีจริง
// ของโลโก้ เส้นคั่นเป็นม่วงลึก #5b1a75
// เนื้อความ #ece2ff (= BRAND_TEXT, 12.5:1 บนผิวยก #1e0a3c)
//
// ชุดฟ้าสด-เหลืองมะนาวของ แตกดี168 ที่เคยค้างในไฟล์นี้ (#0a1726 #064a86 #0b6fc4
// #fce604 #7bcffb #d4ecfd #dbeafe) ออกครบทุกจุดแล้ว
const columnLabel = "text-2xl leading-normal font-black tracking-wide";
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-[#1e0a3c] p-8 shadow-[10px_10px_20px_#000000,-10px_-10px_20px_#5b1a75] transition-all duration-300 hover:shadow-[15px_15px_30px_#000000,-15px_-15px_30px_#7a1fc4]">
    {
      title && (
        <header class="mb-8 border-b border-[#5b1a75]/80 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#fbe455] via-[#d2a6ff] to-[#efe6ff] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#ece2ff]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece2ff]">
        {titleleft && <p class={`${columnLabel} text-[#d2a6ff]`}>{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece2ff] md:border-l md:border-[#5b1a75]/70 md:pl-8">
        {titleright && <p class={`${columnLabel} text-[#ffd23d]`}>{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
