---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture, not docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The intro block is only emitted when a page actually passes default-slot
// content. Rendering it unconditionally left a dead mb-8 gap under the heading
// on every page that used the two-column layout only.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// Flattened: each column's text classes live on its own <article> and the slot
// renders as a direct child. `leading-normal` on the column labels neutralises
// the hoisted `leading-relaxed`. Do not re-add a wrapper <div>.
//
// 1SS365 (รอบทอง-เงินโครเมียม-ดำ 2026-10-03): แผ่นนูนวางบนผิวการ์ดดำอมทอง #121010
// ซึ่งลึกกว่าผิวการ์ดอุ่น #1a1710 ของ ContentBoxNeumorphism ที่อยู่เหนือขึ้นไปในหน้า
// เดียวกัน กดเงาลงไปหาเงาลึกสุด #050505 และยกแสงขึ้นด้วยผิวกรอบอุ่น #2a2115 ซึ่งไต่ขึ้น
// เป็นทองแบรนด์ #edbb23 ตอน hover ความนูนแบบ neumorphic ต้องใช้คู่มืด/สว่างในโทนเดียว
// สีแบรนด์จึงถูกเก็บไว้ที่หัวข้อกับป้ายคอลัมน์แทนที่จะไปอยู่ในเงา หัวข้อรอบนี้ไล่เงินโครเมียม
// #c8cbce → ทองอ่อน #ffeeb4 → ทองแบรนด์ ต่างจากหัวข้อทองลึก→ทอง→เงินของ
// ContentBoxNeumorphism และต่างจากหัวข้อทองล้วนของ ContentBoxCyberCut ป้ายสองคอลัมน์
// แยกสีกันคนละข้าง คือซ้ายทองสว่าง #f7d458 ขวาเงินโครเมียม เนื้อความ #f0e6d2 (BRAND_TEXT)
//
// ชุดแดง-ทองของ หวยเฮง789 ที่เคยค้างในไฟล์นี้ (#1c0606 #0b0202 #3a0c0c #dc2224
// #ffefc2 #f4bc5d #d99a10 #a8690c #fbe3d4) ออกครบทุกจุดแล้ว
const columnLabel = "text-2xl leading-normal font-black tracking-wide";
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-[#121010] p-8 shadow-[10px_10px_20px_#050505,-10px_-10px_20px_#2a2115] transition-all duration-300 hover:shadow-[15px_15px_30px_#050505,-15px_-15px_30px_#edbb23]">
    {
      title && (
        <header class="mb-8 border-b border-[#a87708]/70 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#c8cbce] via-[#ffeeb4] to-[#edbb23] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#f0e6d2]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e6d2]">
        {titleleft && <p class={`${columnLabel} text-[#f7d458]`}>{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e6d2] md:border-l md:border-[#a87708]/40 md:pl-8">
        {titleright && <p class={`${columnLabel} text-[#c8cbce]`}>{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
