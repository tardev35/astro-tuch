---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture, not docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The intro block is only emitted when a page actually passes default-slot
// content. Rendering it unconditionally left a dead mb-8 gap under the heading
// on every page that used the two-column layout only.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// Flattened: each column's text classes live on its own <article> and the slot
// renders as a direct child. `leading-normal` on the column labels neutralises
// the hoisted `leading-relaxed`. Do not re-add a wrapper <div>.
//
// SUPERSLOTCLUB (รอบแดงเสือโคร่ง-ทองถ่านไฟ 2026-10-09, brand-spec §2):
// แผ่นนูนวางบนผิวการ์ดยก #3d1709 ซึ่งสว่างกว่าผิว #301105 ของ
// ContentBoxNeumorphism และสว่างกว่าผิว #180800 ของ
// ContentBoxSevenThreeNeumorphism ที่อยู่ใต้ลงไปในหน้าเดียวกัน สามแผ่นนูนในหน้า
// จึงไม่อ่านเป็นใบเดียวกันซ้ำสามรอบ ที่นี่กดเงาลงไปหาดำสนิทและยกแสงขึ้นด้วยแดงลึก
// #7d0f12 ซึ่งเป็นคู่มืด/สว่างในโทนแดงเดียวกัน ตอน hover ฝั่งสว่างไต่ขึ้นเป็นแดง
// แบรนด์ #e8232a
//
// ความนูนแบบ neumorphic ต้องใช้คู่มืด/สว่างในโทนเดียว สีแบรนด์จึงถูกเก็บไว้ที่หัวข้อ
// กับป้ายคอลัมน์แทนที่จะไปอยู่ในเงา หัวข้อรอบนี้ไล่ทองแบรนด์ #f2b705 → แดงเรืองไฟ
// #ff5a46 → ครีมอุ่น #f5cbb0 ซึ่งเป็นลำดับที่ไม่ซ้ำกับกล่องอื่นบนหน้าเดียวกันสักตัว
// ป้ายสองคอลัมน์แยกสีกันคนละข้าง คือซ้ายครีมอุ่นและขวาทองแบรนด์ ตามคู่สีจริงของโลโก้
// เส้นคั่นเป็นแดงลึก #7d0f12
// เนื้อความ #fbe8d5 (= BRAND_TEXT, 13.3:1 บนผิวยก #3d1709)
// §2 ห้าม #e8232a กับ #7d0f12 ถือตัวอักษร — ที่นี่ทั้งคู่อยู่ในเงาและเส้นคั่นเท่านั้น
//
// ชุดม่วงนีออน-ทองอาร์เขตของ WEPLAY168 ที่เคยค้างในไฟล์นี้ (#1e0a3c #17062e
// #0a0117 #5b1a75 #7a1fc4 #fbe455 #d2a6ff #efe6ff #ffd23d #ece2ff) และชุดฟ้าสด-
// เหลืองมะนาวของ แตกดี168 ก่อนนั้น (#0a1726 #064a86 #0b6fc4 #fce604 #7bcffb
// #d4ecfd #dbeafe) ออกครบทุกจุดแล้ว — ทองของรอบนี้เป็นคนละค่ากับทั้งสองชุด
const columnLabel = "text-2xl leading-normal font-black tracking-wide";
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-[#3d1709] p-8 shadow-[10px_10px_20px_#000000,-10px_-10px_20px_#7d0f12] transition-all duration-300 hover:shadow-[15px_15px_30px_#000000,-15px_-15px_30px_#e8232a]">
    {
      title && (
        <header class="mb-8 border-b border-[#7d0f12]/80 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#f2b705] via-[#ff5a46] to-[#f5cbb0] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#fbe8d5]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fbe8d5]">
        {titleleft && <p class={`${columnLabel} text-[#f5cbb0]`}>{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fbe8d5] md:border-l md:border-[#7d0f12]/70 md:pl-8">
        {titleright && <p class={`${columnLabel} text-[#f2b705]`}>{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
