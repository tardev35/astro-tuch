---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture, not docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The intro block is only emitted when a page actually passes default-slot
// content. Rendering it unconditionally left a dead mb-8 gap under the heading
// on every page that used the two-column layout only.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// Flattened: each column's text classes live on its own <article> and the slot
// renders as a direct child. `leading-normal` on the column labels neutralises
// the hoisted `leading-relaxed`. Do not re-add a wrapper <div>.
//
// This card carries docx H2 §7 of the home page (content.txt line 22 —
// ช่องทางติดต่อแอดมิน <แบรนด์> ตลอด 24ชม.), run one half of the paragraph per
// column. The brief gives those halves no sub-labels, so the page passes neither
// titleleft nor titleright and this box emits exactly one heading — the
// section's own.
//
// รวยแทร่168 (รอบ **ฟ้าอะซัวร์นำ · ทองอำพันเป็นฮิวที่สอง · น้ำเงินลึกไม่เคยถือ
// ตัวอักษร · บนดำสนิท** 2026-10-19) — พาเลตต์ตาม .claude/brand-spec-ruaythear168.md §2
// ⚠️ รอบนี้ **ฟ้านำจริง ทองอำพัน #f9a826 เป็นฮิวที่สอง น้ำเงินลึก #04366b ไม่เคยนำ**
// ฟ้าคือสิ่งที่ตาเห็นทั้งฉากในงานศิลป์ (ตัวอักษร แทร่168 ถุงเงินสลักดอลลาร์ ปึก
// ธนบัตร หัวใจ มือถือ โบว์ซาติน กล่องของขวัญ) ส่วนทองเป็นคำว่า "รวย" มงกุฎ กอง
// เหรียญ และประกายดาว
// ⚠️ **palette.json ชี้ถูกเฉพาะ logo.webp** (vivid #039cfa / #0494f5 = เนื้อฟ้าของ
// ตัวอักษร "แทร่168") ส่วน dominant ของ banner1/slide1 เป็น **ขาวเกือบสนิท** เพราะ
// ฉากเป็นพื้นขาว และ vivid ของสไลด์เป็นโทนผิวนางแบบ — สองอย่างนั้นไม่ใช่สีแบรนด์
// และพื้นเพจไม่ได้มาจากรูป แต่มาจาก bg.json
// ⚠️ พื้นเพจ **ดำสนิท #000000** (bg.json) ลำดับความลึก: #0b2d52 ยก / #071e38 กลาง /
// #030f1d จม / #000000 พื้น
//
// จังหวะรูปทรงของใบนี้: เป็น **แผ่นนูน neumorphic ใบที่สองของสองใบในหน้า** วางบน
// **ผิวยก #0b2d52** ซึ่งสว่างที่สุดในชุดผิว มุม rounded-[30px] และ **ไม่มีกรอบเลย**
// กดเงาลงไปหาผิวจม #030f1d แล้วยกแสงขึ้นด้วยน้ำเงินลึก #04366b ตอน hover ฝั่งสว่าง
// ไต่ขึ้นถึงบรอนซ์ลึก #704504 ส่วนแผ่นนูนอีกใบ (ContentBoxNeumorphism §2) เป็นมุม
// rounded-[25px] **มีกรอบน้ำเงินลึก** นั่งลึกกว่าที่ผิวกลาง และ **ไม่มี hover**
// — สองใบจึงต่างกันทั้งมุม ความลึกของผิว การมีกรอบ และพฤติกรรมตอน hover
// ความนูนแบบนี้ต้องใช้คู่มืด/สว่างในโทนเดียว สีแบรนด์จึงถูกเก็บไว้ที่หัวข้อกับป้าย
// คอลัมน์ ไม่ใช่ในเงา: หัวข้อไล่ ทองอำพัน #f9a826 → ฟ้าอะซัวร์ #039cfa → ฟ้าน้ำแข็ง
// #c3ebfc ("ทองไล่ลงฟ้า") ซึ่งเป็นลำดับที่ไม่ซ้ำกับกล่องอื่นบนหน้าเดียวกันสักใบ และ
// **เป็นกล่องเดียวของหน้าที่ขึ้นต้นหัวข้อด้วยทอง** ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง
// **คือพิกเซลของตัวอักษร** ทุกสต็อปต้องถือตัวอักษรได้ตาม §2 (#f9a826 6.9:1 ·
// #039cfa 4.6:1 ที่ text-2xl font-black = large text · #c3ebfc 10.8:1) — ห้ามเอา
// #04366b หรือ #704504 มาเป็นสต็อป
// ป้ายสองคอลัมน์แยกฮิวคนละข้าง: ซ้ายฟ้าอะซัวร์ #039cfa ขวาทองอำพัน #f9a826 ทั้งคู่
// เป็น text-2xl font-black จึงเป็น large text (รอบนี้หน้าเพจไม่ได้ส่งป้ายมา เพราะ
// บรีฟไม่ได้ตั้งชื่อครึ่งย่อหน้าไว้ — โค้ดยังคงไว้ให้แบรนด์ถัดไป)
// เส้นคั่นเป็นบรอนซ์ลึก #704504 เนื้อความ #e3f2fc (= BRAND_TEXT, 11.9:1 บนผิวยก)
// §2 ห้าม #04366b #704504 ถือตัวอักษร — ที่นี่อยู่ในเงาและเส้นคั่นเท่านั้น
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **รอบนี้ฟ้า+ทองเป็นรอบที่สามติดกัน**
// ทองรอบนี้คือ #f9a826 เท่านั้น ไม่ใช่ fef54b (นินจา168 เหลืองมะนาว) ffc82e
// (สบายเบท168) ffd84d (ถอนชัวร์168) fcd434 (มีโชค168) f7c92b (ขวัญใจ168) f0b429
// (รับตัง168) e3b23c (สมหวัง168) e2b33f (KMD88) dfa310 (TND168) f2c230 (KINGKONG555)
// e5a81b (UFA324) fad354 (789BETTING) f5c518 (FLASH877) หรือ f7d14e (KOON234)
// และฟ้ารอบนี้คือ #039cfa / #c3ebfc / #04366b เท่านั้น ไม่ใช่ 32bcfb a9e9ff 07335f
// (นินจา168) 2f9ff5 a8dcff 0b3f78 (สบายเบท168) 0360f3 0292fb 6ec8ff 4fb4ff
// (TSDET911) 0a84e0 04203f e4f1fd (HI59) หรือ cfd9e6 (เงินอมฟ้าของรับตัง168)
// ชุดเต็มของสบายเบท168 ที่เพิ่งค้างอยู่ทั้งไฟล์นี้ (2f9ff5 a8dcff ffefbb 0b3f78
// ffc82e 5c4a16 e8f4ff 0e2238 081726 040d16) ชุดของนินจา168 (32bcfb a9e9ff 07335f
// fef54b 6b5c10 0c2a3d 071a28 030e16 041019 dceefc) ชุดทองไทย-โรสโกลด์-แดงชาดของ
// ขวัญใจ168 (f7c92b ffe6a3 f2bba5 c98a74 b3121b 5a0a0e 8a5f12 eadfce 241509 160d06
// 0b0603 140c06) ชุดชมพูบับเบิลกัม-ทองเนยของถอนชัวร์168 (fa63b9 ffb3de ffd84d 2b0f20
// 1a0914 0d040a 6d0b3f 6b4708 2a0617 fdeaf5) ชุดของมีโชค168 (fcd434 ffeaa0 f5469f
// ff8dc6 8c0f52 7a5508 1a0612 f6e4ee 24101c 160a12 0b0509) ชุดของรับตัง168 (f0b429
// ffdc8c d30304 ff6b6e a00203 4a0202 9a6c0c cfd9e6 f5ece0 2b100f 200a09 140505
// 1a0505) ชุดของสมหวัง168 (fa0513 ffadaf ff5a5f e3b23c ffe5a8 8a6210 b90203 8c0204
// 5b0203 3c0303 f4ecea 2c1413 1f0d0c 140706 290f0f) ชุดน้ำเงินไฟฟ้าของ TSDET911
// (0360f3 0292fb 6ec8ff 4fb4ff cfdcec 9db4d4 dde8f7 102a5e 0a1c42 040e26 00081f)
// ชุดทองอำพันของ TIGERWIN369 (d98324 f7b733 ffd98a f7e4c0 e3cfae 8a5214) ชุดชมพูฮอต
// ของ FAH999 (ff3fa4 ff6cbb ffd1ea f5c53d) และชุดม่วงราชาของ KMD88 (7505cc b453ff
// c07cff d9b8ff ece2f8 bba8d4) ออกครบแล้ว
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีชมพู ไม่มีแดง ไม่มีม่วง ไม่มีเขียว ไม่มีส้ม ไม่มีเงิน/โครเมียม
// ไม่มีโรสโกลด์ และไม่มีเหลืองมะนาว**
const columnLabel = "text-2xl leading-normal font-black tracking-wide";
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[30px] bg-[#0b2d52] p-8 shadow-[10px_10px_22px_#030f1d,-10px_-10px_22px_#04366b] transition-all duration-300 hover:shadow-[15px_15px_32px_#030f1d,-15px_-15px_32px_#704504]">
    {
      title && (
        <header class="mb-8 border-b border-[#704504]/80 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#f9a826] via-[#039cfa] to-[#c3ebfc] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#e3f2fc]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e3f2fc]">
        {titleleft && <p class={`${columnLabel} text-[#039cfa]`}>{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e3f2fc] md:border-l md:border-[#704504]/70 md:pl-8">
        {titleright && <p class={`${columnLabel} text-[#f9a826]`}>{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
