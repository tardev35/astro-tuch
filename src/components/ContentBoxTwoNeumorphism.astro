---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture, not docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The intro block is only emitted when a page actually passes default-slot
// content. Rendering it unconditionally left a dead mb-8 gap under the heading
// on every page that used the two-column layout only.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// Flattened: each column's text classes live on its own <article> and the slot
// renders as a direct child. `leading-normal` on the column labels neutralises
// the hoisted `leading-relaxed`. Do not re-add a wrapper <div>.
//
// รอบนี้ใบนี้ถือ **docx H2 §2** ของหน้าแรก ("<แบรนด์> บาคาร่า สล็อต หวย บอล ไฮโล
// แทงได้เท่าไหร่ เว็บจ่ายเต็ม ไม่มีโกง" — content.txt บรรทัด 5) โดยแบ่งย่อหน้าเดียว
// ของบรีฟ (บรรทัด 6) เป็นสองซีกโดยไม่ตกประโยคไหน: ซีกซ้ายคือ **หมวดเกมที่ระบุไว้
// กับความต่างของรูปแบบเดิมพันและอัตราจ่าย** ซีกขวาคือ **สิ่งที่ควรตรวจก่อนทำรายการ
// และประโยคกำกับเรื่องคำกล่าวอ้างว่าจ่ายเต็มและไม่มีโกง**
// บรีฟไม่ได้ตั้งชื่อให้สองซีก หน้าเพจจึงไม่ส่ง titleleft/titleright มา กล่องนี้
// จึงปล่อยหัวข้อออกมาใบเดียวคือของ section เอง
// หัวข้อมาจาก prop เท่านั้น — ห้าม hardcode ข้อความไทยเป็น heading ในไฟล์นี้
//
// ⚠️ เขียนชื่อคลาสสีในคอมเมนต์แบบไม่เต็มรูปโดยตั้งใจ — Tailwind สแกนคอมเมนต์ด้วย
// (และเฮกซ์ของแบรนด์เก่าด้านล่างเขียนแบบ **ไม่มี #** เพื่อไม่ให้ sweep ที่ไล่หาสี
// ของแบรนด์เก่าใน src/ สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
//
// ───────────────────────────────────────────────────────────────────────────
// ZORO365 (ดรอป 2026-10-28, .claude/brand-spec-zoro365.md §2) —
// **เขียวมรกตนำ · เงินโครเมียม/ทองอำพันคู่รอง · มืดทั้งเว็บ**
// bg.json = {"mode":"color","color":"#002908"} เขียวป่าจมเกือบดำ
// 🚨🚨 **รอบก่อน (TEVA69) เป็นธีมสว่าง — รอบนี้กลับทิศ 180°** **ห้ามแก้การ์ดกลับไป
// เป็นพื้นขาว** หมึก #eef7f0 บนการ์ดขาวคือตัวอักษรหายไปเลย
// ลำดับผิว: #010d04 ฝั่งมืดของเงานูน · #031b09 โครม · **#073c1a ผิวการ์ด (ใบนี้)** ·
// #0e5424 ชั้นยก/ฝั่งสว่างของเงานูน · #002908 พื้นเพจ ·
// หมึก **#eef7f0** (= BRAND_TEXT, 12.0:1 บนใบนี้) · หมึกรอง #9dc2a5 (6.3:1)
//
// จังหวะรูปทรงของใบนี้: เป็น **แผ่นนูน neumorphic ใบที่สองของสามใบในหน้า** มุม
// rounded-[30px] และ **ไม่มีกรอบเลย** อีกสองใบคือ §1 ContentBoxNeumorphism ซึ่งเป็น
// มุม rounded-[25px] เงา 12px/-12px มีกรอบ #1e7033 และหัวข้อเขียวมรกตทึบจัดกึ่งกลาง ·
// กับ §5 ContentBoxSevenThreeNeumorphism ซึ่งเป็นมุม rounded-[22px] เงา 10px/-10px
// มีกรอบ และหัวข้อทึบชิดซ้ายพร้อมแถบตั้ง — สามใบจึงต่างกันทั้งมุม ระยะเงา
// การมี/ไม่มีกรอบ และการจัดหัวข้อ
// ⚠️ ความนูนบนธีมมืด: **เงาฝั่งมืดเป็น rgba(1,13,4,α)** ส่วนฝั่งสว่างเป็น
// **ผิวยก #0e5424** ไม่ใช่ขาวและไม่ใช่เขียวนีออน (สองอย่างนั้นจะกลายเป็นเส้นขอบ
// เรืองแสงบนธีมมืด ไม่ใช่ความนูน)
// หัวข้อไล่ **เงินโครเมียม #dfe6e3 → เขียวมรกต #3ddc4a** สองสต็อป ซึ่งอ่านมาจาก
// เวิร์ดมาร์กจริงที่ครึ่งแรกเป็นตัวอักษรละตินผิวโครเมียมเงินและครึ่งหลังเป็นตัวเลข
// ผิวเขียวมรกต และไม่ซ้ำกับกล่องอื่นบนหน้าเดียวกันสักใบ
// ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุกสต็อปต้องถือ
// ตัวอักษรได้บนผิวใบนี้: #dfe6e3 9.9:1 และ #3ddc4a 6.9:1 ✅ — **ห้ามเอา #35a043
// (3.8:1) #1e7033 (2.1:1) หรือผิวใด ๆ (#073c1a #0e5424 #031b09 #010d04 #002908)
// มาเป็นสต็อป**
// ป้ายสองคอลัมน์: ซ้ายเงินโครเมียม #dfe6e3 ขวาเขียวมรกต #3ddc4a (รอบนี้หน้าเพจ
// ไม่ได้ส่งป้ายมา — โค้ดคงไว้ให้แบรนด์ถัดไป) เส้นคั่นเป็น #1e7033
// 🚨🚨 **#35a043 และ #1e7033 ห้ามถือตัวอักษร** — เส้น/ขอบ/ออรา/พื้นถมเท่านั้น
// ในไฟล์นี้ #e8c86a อยู่ที่ **เส้นไรผมบนขอบการ์ด** ซึ่งเป็นพื้นถมล้วน
// ⚠️ **สีไฮไลต์ <strong> ในเนื้อความมีตัวเดียวคือ #3ddc4a** ซึ่งเป็นงานของหน้าเพจ
// rgba() ที่อนุญาตรอบนี้: rgba(61,220,74,α) · rgba(53,160,67,α) ·
// rgba(30,112,51,α) · rgba(232,200,106,α) · rgba(223,230,227,α) · rgba(1,13,4,α)
//
// ⚠️⚠️ **เขียวคือฮิวนำของรอบนี้ และเขียวเคยนำมาแล้วหลายเจ้าในรีโปนี้ รวมถึง
// แบรนด์ขาออกทันที จึงต้องเทียบทีละค่า** "เจอเขียวอยู่แล้ว" ไม่เคยพิสูจน์ว่าเป็นของ
// รอบปัจจุบัน เขียวรอบนี้คือ **#3ddc4a (R61 G220 B74)** · **#35a043** · **#1e7033** ·
// **#0e5424** · **#073c1a** · **#031b09** · **#002908**
// ค่าที่กวาดออกจากไฟล์นี้แล้วและห้ามกลับเข้ามา:
//   **ZANE96 (ชุดที่เพิ่งอยู่ทั้งใบนี้)** — 7a1bd6 2b3fd9 c2178b f23bb4 bb6dff
//     7aa7ff 5411c4 241046 6b4a86 f8e6f9 f6edfe ece0fb dcc6f4 9a6fd0 190b3d 271257
//     100626 5b2f9e f3e8ff c0a6e8 8e14b8 2f1766 + rgba 84/17/196, rgba 122/27/214,
//     rgba 242/59/180, rgba 36/16/70, rgba 220/198/244
//     ⚠️⚠️ **2b3fd9 / 5411c4 เคยเป็นสองสต็อปของหัวข้อใบนี้ตรง ๆ — ต้องไม่เหลือ**
//   **TEVA69 (แบรนด์ขาออกทันที — และเป็นเขียว/เงิน/ทองเหมือนรอบนี้เป๊ะ)** — f0ffeb
//     ffffff e6f7df d7f0cd b2dba3 3f7a2e 10280f 3c5b36 116018 0b4a12 1a7d24 8a6a0e
//     28c437 e3bb45 c6cfd2 0b2a12 15401d 051409 2d6b2f e8fbe4 b4d6ad
//     ⚠️⚠️ **28c437 ↔ 3ddc4a · e3bb45 ↔ e8c86a · c6cfd2 ↔ dfe6e3 · e8fbe4 ↔ eef7f0 ·
//     b4d6ad ↔ 9dc2a5 · 15401d ↔ 0e5424 — เจอค่าซ้ายให้ถือว่าพิมพ์ผิดก่อนเสมอ**
//   **เขียวของแบรนด์อื่น — ตระกูลเดียวกับรอบนี้ ต้องเทียบแน่นที่สุด** — 0c3a16 0a5f1c
//     0b7d28 0f9b35 061f0c (สาธุ168 ⚠️⚠️ **0c3a16 ↔ 073c1a ต่างหลักเดียว**) ·
//     8ce023 e9f7d6 bde397 1a5c04 2f8c07 051400 0f2e05 06220a (KINGKONG555) ·
//     1fae1c 0d2312 143a1c 07130a (888PARUAY) · 117a41 2bb061 2fbf6a
//     (MEXICANOSLOT/KOON234)
//   **แดง/ชมพู/ทองของแบรนด์อื่น** — fff0f0 ffe4e6 ffd4d7 f5b9bd a8333f 25090f 6e3b44
//     b00718 c1071b 8a0412 8f6310 d61023 ff2436 e9b53c c3ccd6 (LOTTO189) · de2b1e
//     f2a033 a81410 c81e12 9d140c 6f0e08 3f130d fdeee2 e8c6ae fed7b5 fff3ea fef6fb
//     (MEXICANOSLOT) · fb2e33 cb0b0d d81115 b00d11 8a0608 ff2e52 e01238 c9102f ·
//     ffd6fa fff4fb ffe3f5 f9b2d9 9c0f55 fb439b d91a73 b01160 85094a (okkub88) ·
//     fa539c c2185b 8e0f41 fb8cc0 f7bcd9 3b0b26 (หมูบิน168)
//   **ส้ม/ครีมของ ZNOVA168** — 2a1206 1a0c04 7a3a0c fff3e0 e0b784 fffbf0 fff4e0
//     ffe9c7 f3d9a8 c98a24 c23400 b8300a 9a5b00 d13800 fa4903 e8a000 ff8a2b d8dde6
//   **ฟ้า/ไซแอน/ม่วงของแบรนด์อื่น** — 00bfff 12b4ef b6e3f0 7fcbe8 4fb8ea 06283f
//     0b4a73 2a87c4 eaf7ff f0faff e4f6fb 0f5684 1a6ea8 · 1fd8f0 0bb6d4 1d4fd8 143aa0
//     · 18a5e2 0d6b9b a9d7f2 · 2cc3fc 6bdcfb · 039cfa 0494f5 · 00f3ff e0ffff 60a5fa
//     4b5563 030712 1f2937 · 7e22ce d946ef a855f7 · 7505cc b453ff c07cff d9b8ff
//   **ทอง/เหลือง/เทาเงินของเก่ากว่านั้น — ทองกับเงินเป็นวัสดุรองของรอบนี้จริง จึงต้อง
//     เทียบเท่ากัน** — ffd84d f5ba14 fcee52 b37c0b ffd94a e3a712 9d6f06 eeae12 fded41
//     fcd434 fdcb0c fee45d e6a416 f7c92b d4922c e5a81b ffe08a f9a826 ffdc8c f0b429
//     ffc82e e0bd72 f6e4b4 d4af5a eab308 f5c53d dcb95f f0c878 fbc134 ffe87a cf9a18
//     e3b23c · f4e4d3 e4cbb3 ecd5c4 d2b9a4 f3ece0 bfb8aa e8eaee b4b9c2 6b7079 cfd6e3
//     d8dde6 (⚠️ **f0c878 / e3b23c ↔ e8c86a · cfd6e3 / e8eaee / d8dde6 ↔ dfe6e3**)
// ⚠️ **รอบนี้ไม่มีผิวสว่างเลยสักเฉด ไม่มีม่วง ไม่มีฟ้า/ไซแอน ไม่มีชมพู/แมเจนต้า
// ไม่มีแดง และไม่มีส้มเพลิง** (เขียว 00B900 ของปุ่ม LINE และเขียว success ของฟีด
// ถอนเงินอยู่ไฟล์อื่น คงไว้ ห้ามกลืนเข้าพาเลตเขียวของรอบนี้)
// ⚠️ **ดาบคาทานะ วงพู่กันหมึก กิโมโนลายดอกไม้ กอไผ่ ชิปคาสิโนเขียว-ขาว และสีผิว
// นักแสดงในอาร์ตเวิร์กเป็นวัตถุในภาพ ไม่ใช่สี UI** — พื้นเพจมาจาก bg.json เท่านั้น
const columnLabel = "text-2xl leading-normal font-black tracking-wide";
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full overflow-hidden rounded-[30px] bg-[#073c1a] p-8 shadow-[10px_10px_22px_rgba(1,13,4,0.5),-10px_-10px_22px_#0e5424] transition-all duration-300 hover:shadow-[15px_15px_32px_rgba(1,13,4,0.6),-15px_-15px_32px_#0e5424]">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[3px] bg-gradient-to-r from-transparent via-[#e8c86a] to-transparent"></div>

    {
      title && (
        <header class="mb-8 border-b border-[#1e7033] pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#dfe6e3] to-[#3ddc4a] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#eef7f0]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#eef7f0]">
        {titleleft && <p class={`${columnLabel} text-[#dfe6e3]`}>{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#eef7f0] md:border-l md:border-[#1e7033] md:pl-8">
        {titleright && <p class={`${columnLabel} text-[#3ddc4a]`}>{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
