---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture, not docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The intro block is only emitted when a page actually passes default-slot
// content. Rendering it unconditionally left a dead mb-8 gap under the heading
// on every page that used the two-column layout only.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// Flattened: each column's text classes live on its own <article> and the slot
// renders as a direct child. `leading-normal` on the column labels neutralises
// the hoisted `leading-relaxed`. Do not re-add a wrapper <div>.
//
// MIRACLE55 (รอบทอง-เงินโครเมียม-ดำ 2026-09-25): แผ่นนูนวางบนผิวการ์ด #14100a กด
// เงาลงไปหาพื้นเพจเกือบดำ #050403 และยกแสงด้วยผิวการ์ดยก #2c241c ซึ่งไต่ขึ้นเป็น
// ทองแบรนด์ #fcda65 ตอน hover หัวข้อไล่จากทองสว่าง #fee47b → ขาวโครเมียม #fcfcfc →
// ทองแบรนด์ #d9a62b ซึ่งเป็นลำดับโลหะเดียวกับโลโก้ MI ทอง / RACLE เงิน / 55 ทอง
// ป้ายสองคอลัมน์แยกโลหะกันคนละข้าง คือซ้ายทองสว่าง #fee47b ขวาเงินโครเมียม #d2d3d4
// เนื้อความ #e8e6e1 (BRAND_TEXT) — แดง #de161d/#ff4d52 เงิน #e2e8ef พื้น
// #16090a/#080506/#26100f และเนื้อความ #e8e3e1 ของ MAHAGAME66 ออกทั้งหมด
const columnLabel = "text-2xl leading-normal font-black tracking-wide";
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-[#14100a] p-8 shadow-[10px_10px_20px_#050403,-10px_-10px_20px_#2c241c] transition-all duration-300 hover:shadow-[15px_15px_30px_#050403,-15px_-15px_30px_#fcda65]">
    {
      title && (
        <header class="mb-8 border-b border-[#d9a62b]/60 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#fee47b] via-[#fcfcfc] to-[#d9a62b] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#e8e6e1]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e8e6e1]">
        {titleleft && <p class={`${columnLabel} text-[#fee47b]`}>{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e8e6e1] md:border-l md:border-[#d2d3d4]/35 md:pl-8">
        {titleright && <p class={`${columnLabel} text-[#d2d3d4]`}>{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
