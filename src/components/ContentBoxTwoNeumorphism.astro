---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture, not docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The intro block is only emitted when a page actually passes default-slot
// content. Rendering it unconditionally left a dead mb-8 gap under the heading
// on every page that used the two-column layout only.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// Flattened: each column's text classes live on its own <article> and the slot
// renders as a direct child. `leading-normal` on the column labels neutralises
// the hoisted `leading-relaxed`. Do not re-add a wrapper <div>.
//
// MAHAGAME66 palette (แดง-ดำ-เงินโครเมียม 2026-09-24): แผ่นนูนวางบนผิวการ์ด
// #16090a กดเงาลงไปหาพื้นเพจเกือบดำ #080506 และยกแสงด้วยผิวการ์ดยก #26100f ซึ่งไต่
// ขึ้นเป็นแดงแบรนด์ #de161d ตอน hover หัวข้อไล่จากเงินโครเมียม #e2e8ef → แดงสว่าง
// #ff4d52 → แดงแบรนด์ #de161d ซึ่งเป็นลำดับสีเดียวกับโลโก้ MAHA เงิน / GAME แดง /
// 66 เงิน ส่วนป้ายคอลัมน์รับแดงสว่าง #ff4d52 เนื้อความ #e8e3e1 (BRAND_TEXT) —
// ทอง #e8b93f/#ffe9a3/#96671a พื้นน้ำตาล #171006/#0d0903/#2a1d0b ครีม #e3d8c0
// และเงิน #eef3f8 ของ SAGAME66 ออกทั้งหมด
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-[#16090a] p-8 shadow-[10px_10px_20px_#080506,-10px_-10px_20px_#26100f] transition-all duration-300 hover:shadow-[15px_15px_30px_#080506,-15px_-15px_30px_#de161d]">
    {
      title && (
        <header class="mb-8 border-b border-[#de161d]/60 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#e2e8ef] via-[#ff4d52] to-[#de161d] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#e8e3e1]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e8e3e1]">
        {titleleft && <p class="text-2xl leading-normal font-black tracking-wide text-[#ff4d52]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e8e3e1] md:border-l md:border-[#de161d]/60 md:pl-8">
        {titleright && <p class="text-2xl leading-normal font-black tracking-wide text-[#ff4d52]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
