---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture, not docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The intro block is only emitted when a page actually passes default-slot
// content. Rendering it unconditionally left a dead mb-8 gap under the heading
// on every page that used the two-column layout only.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// Flattened: each column's text classes live on its own <article> and the slot
// renders as a direct child. `leading-normal` on the column labels neutralises
// the hoisted `leading-relaxed`. Do not re-add a wrapper <div>.
//
// SEXYGAME666 (รอบชมพูนีออน-ม่วง-ดำ 2026-09-28): แผ่นนูนวางบนผิวการ์ด #170a22 กดเงา
// ลงไปหาพื้นเพจเกือบดำ #08020d และยกแสงด้วยผิวการ์ดยกม่วงเข้ม #1d0c33 ซึ่งไต่ขึ้นเป็น
// ชมพูแบรนด์ #fa42b5 ตอน hover หัวข้อไล่จากชมพูอ่อน #ffb3e2 → ชมพูแบรนด์ #fa42b5 →
// ม่วงแบรนด์ #8b3df3 ซึ่งเป็นลำดับเดียวกับเวิร์ดมาร์ก SEXY ชมพู / GAME ม่วง / 666 ชมพู
// ป้ายสองคอลัมน์แยกสีกันคนละข้าง คือซ้ายชมพูอ่อน #ffb3e2 ขวาม่วงอ่อน #c9a4ff เนื้อความ
// #f2dcee (BRAND_TEXT) — ชุดทองเมทัลลิก-โครเมียมของ PKG44 (#fdd32a #ffe27a #c8920a
// #c2c8d0 #f2f4f7 #2a2110 #12100a #080602 #efe6d2) ออกทั้งหมด
const columnLabel = "text-2xl leading-normal font-black tracking-wide";
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-[#170a22] p-8 shadow-[10px_10px_20px_#08020d,-10px_-10px_20px_#1d0c33] transition-all duration-300 hover:shadow-[15px_15px_30px_#08020d,-15px_-15px_30px_#fa42b5]">
    {
      title && (
        <header class="mb-8 border-b border-[#b01573]/70 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#ffb3e2] via-[#fa42b5] to-[#8b3df3] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#f2dcee]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f2dcee]">
        {titleleft && <p class={`${columnLabel} text-[#ffb3e2]`}>{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f2dcee] md:border-l md:border-[#8b3df3]/40 md:pl-8">
        {titleright && <p class={`${columnLabel} text-[#c9a4ff]`}>{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
