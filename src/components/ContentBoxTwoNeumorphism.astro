---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture, not docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The intro block is only emitted when a page actually passes default-slot
// content. Rendering it unconditionally left a dead mb-8 gap under the heading
// on every page that used the two-column layout only.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// Flattened: each column's text classes live on its own <article> and the slot
// renders as a direct child. `leading-normal` on the column labels neutralises
// the hoisted `leading-relaxed`. Do not re-add a wrapper <div>.
//
// หวยเต็ง (รอบเขียวป่า-ทอง 2026-10-01): แผ่นนูนวางบนผิวการ์ดเขียวเข้ม #062a12
// กดเงาลงไปหาเงาลึกสุดของแบรนด์ #010a04 และยกแสงด้วยผิวแผงยกเขียวกลาง #0b3d18
// ซึ่งไต่ขึ้นเป็นทองแบรนด์ #e5c04f ตอน hover ความนูนแบบ neumorphic ต้องใช้คู่
// มืด/สว่างในโทนเดียว สีแบรนด์จึงถูกเก็บไว้ที่หัวข้อกับป้ายคอลัมน์แทนที่จะไป
// อยู่ในเงา หัวข้อไล่ขาวอมเขียว #eafbe9 → ทองแบรนด์ → เขียวแบรนด์ลึก #026314
// ป้ายสองคอลัมน์แยกสีกันคนละข้าง คือซ้ายทองอ่อน #fae474 ขวาขาวอมเขียว
// เนื้อความ #d8ead9 (BRAND_TEXT) — ชุดเขียวนีออน-โครเมียมของ CK268 ที่ค้างใน
// ไฟล์นี้ (#8bfc13 #c9ff8f #1a7a08 #e8f0e6 #071007 #030703 #0f1b0e #d5e6cd)
// ออกทั้งหมด
const columnLabel = "text-2xl leading-normal font-black tracking-wide";
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-[#062a12] p-8 shadow-[10px_10px_20px_#010a04,-10px_-10px_20px_#0b3d18] transition-all duration-300 hover:shadow-[15px_15px_30px_#010a04,-15px_-15px_30px_#e5c04f]">
    {
      title && (
        <header class="mb-8 border-b border-[#026314]/70 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#eafbe9] via-[#e5c04f] to-[#026314] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#d8ead9]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d8ead9]">
        {titleleft && <p class={`${columnLabel} text-[#fae474]`}>{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d8ead9] md:border-l md:border-[#e5c04f]/40 md:pl-8">
        {titleright && <p class={`${columnLabel} text-[#eafbe9]`}>{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
