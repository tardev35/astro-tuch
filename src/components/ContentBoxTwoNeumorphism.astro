---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture, not docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The intro block is only emitted when a page actually passes default-slot
// content. Rendering it unconditionally left a dead mb-8 gap under the heading
// on every page that used the two-column layout only.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// Flattened: each column's text classes live on its own <article> and the slot
// renders as a direct child. `leading-normal` on the column labels neutralises
// the hoisted `leading-relaxed`. Do not re-add a wrapper <div>.
//
// This card carries docx H2 §2 of the home page (content.txt line 6 left /
// line 7 right). The brief gives those two paragraphs no sub-labels, so the
// page passes neither titleleft nor titleright and this box emits exactly one
// heading — the section's own.
//
// สมหวัง168 (รอบแดงมังกร-ทองไทย 2026-10-17, brand-spec §2):
// รอบนี้เป็น **สองโทนจริง: แดงมังกรนำ ทองไทยรอง** — แดงแบรนด์ #fa0513 คือเลข 168
// กับเปลวไฟบนโลโก้ ส่วนทองไทย #e3b23c / #ffe5a8 คือลายกนกและนาคทองที่ขนาบงานอาร์ต
// พื้นเพจเป็น **ดำอมแดง #290f0f** (bg.json) ลำดับความลึก: #2c1413 ยก / #1f0d0c
// กลาง / #140706 จม / #290f0f พื้น
//
// แผ่นนูนใบนี้วางบน **ผิวยก #2c1413** ซึ่งสว่างที่สุดในชุดผิวของรอบนี้ และสว่างกว่า
// ผิวกลาง #1f0d0c ของ ContentBoxNeumorphism (§5) ที่อยู่ถัดลงไปในหน้าเดียวกัน
// สองแผ่นนูนในหน้าจึงไม่อ่านเป็นใบเดียวกันสองรอบ: ที่นี่มุม rounded-[30px] **ไม่มี
// กรอบ** กดเงาลงไปหาผิวจม #140706 และยกแสงขึ้นด้วยแดงเกือบดำ #5b0203 ส่วนใบนั้น
// เป็นมุม rounded-[25px] **มีกรอบ** #3c0303 และยกแสงด้วย #3c0303 เดียวกัน ตอน hover
// ฝั่งสว่างของใบนี้ไต่ขึ้นถึงแดงลึกกว่า #8c0204 (ของอีกใบไม่ไต่เลย — คนละพฤติกรรม)
//
// ความนูนแบบ neumorphic ต้องใช้คู่มืด/สว่างในโทนเดียว สีแบรนด์จึงถูกเก็บไว้ที่หัวข้อ
// กับป้ายคอลัมน์แทนที่จะไปอยู่ในเงา หัวข้อรอบนี้ไล่ ทองไทย #e3b23c → แดงสว่าง
// #ff5a5f → ทองสว่าง #ffe5a8 ("ทองคร่อมแดง") ซึ่งเป็นลำดับที่ไม่ซ้ำกับกล่องอื่นบน
// หน้าเดียวกันสักใบ ป้ายสองคอลัมน์แยกสีคนละข้าง คือซ้ายทองไทย #e3b23c (8.9:1 บน
// ผิวยก) และขวาแดงสว่าง #ff5a5f (5.7:1) — ทั้งคู่เป็น text-2xl font-black จึงเป็น
// large text เส้นคั่นเป็นทองลึก #8a6210 เนื้อความ #f4ecea (= BRAND_TEXT, 14.9:1)
// §2 ห้าม #fa0513 #b90203 #8c0204 #5b0203 #3c0303 #8a6210 ถือตัวอักษร — ที่นี่ทั้งหก
// ค่าอยู่ในเงาและเส้นคั่นเท่านั้น และ #ffadaf สงวนไว้ให้ <strong> จึงไม่อยู่ในไฟล์นี้
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — ไฟล์นี้เพิ่งถือชุดน้ำเงินไฟฟ้า-เงิน
// โครเมียมของ TSDET911 มาทั้งไฟล์ (#0360f3 #0292fb #6ec8ff #4fb4ff #cfdcec #9db4d4
// #dde8f7 #102a5e #0a1c42 #040e26 #00081f #032dad #04186e #041a43) และก่อนนั้นเป็น
// ชุดทองอำพันเสือของ TIGERWIN369 (#d98324 #f7b733 #ffd98a #f7e4c0 #e3cfae #8a5214
// #4a2a08 #2d1c0a #1c1206 #0f0903) ชุดชมพูฮอต-ทองของ FAH999 (#ff3fa4 #ff6cbb
// #ffd1ea #f5c53d) ชุดทองแชมเปี้ยน-เงินโครเมียมของ UFA324 (#e5a81b #b9c2cc #464f5a)
// และชุดม่วงราชา-ทองของ KMD88 (#7505cc #b453ff #c07cff #d9b8ff #e2b33f #ece2f8
// #bba8d4) — ออกครบทุกค่าแล้ว
// ⚠️ **กับดักรอบนี้คือแดง** GT66B #fb141b (G=20) และ TKB55 #fb131b (G=19) ก็แดง
// เหมือนกัน แดงรอบนี้คือ #fa0513 (R=250 G=5 B=19) และทองรอบนี้ #e3b23c ไม่ใช่
// #dfa310 (TND168) #e5a81b (UFA324) หรือ #e2b33f (KMD88) — เทียบเป็นตัวเลขทีละค่า
// ⚠️ **รอบนี้ไม่มีโครเมียม/เงิน ไม่มีม่วง ไม่มีชมพู ไม่มีเขียว ไม่มีส้ม ไม่มีน้ำเงิน**
const columnLabel = "text-2xl leading-normal font-black tracking-wide";
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[30px] bg-[#2c1413] p-8 shadow-[10px_10px_20px_#140706,-10px_-10px_20px_#5b0203] transition-all duration-300 hover:shadow-[15px_15px_30px_#140706,-15px_-15px_30px_#8c0204]">
    {
      title && (
        <header class="mb-8 border-b border-[#8a6210]/80 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#e3b23c] via-[#ff5a5f] to-[#ffe5a8] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#f4ecea]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f4ecea]">
        {titleleft && <p class={`${columnLabel} text-[#e3b23c]`}>{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f4ecea] md:border-l md:border-[#8a6210]/70 md:pl-8">
        {titleright && <p class={`${columnLabel} text-[#ff5a5f]`}>{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
