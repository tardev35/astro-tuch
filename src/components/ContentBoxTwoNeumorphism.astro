---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture, not docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The intro block is only emitted when a page actually passes default-slot
// content. Rendering it unconditionally left a dead mb-8 gap under the heading
// on every page that used the two-column layout only.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// Flattened: each column's text classes live on its own <article> and the slot
// renders as a direct child. `leading-normal` on the column labels neutralises
// the hoisted `leading-relaxed`. Do not re-add a wrapper <div>.
//
// This card carries docx H2 §3 of the home page (content.txt line 8, run one
// half of the paragraph per column). The brief gives those halves no sub-labels,
// so the page passes neither titleleft nor titleright and this box emits exactly
// one heading — the section's own.
//
// สบายเบท168 (รอบ **ฟ้าบับเบิลนำ · ทองเป็นฮิวที่สอง · น้ำเงินลึกไม่เคยถือตัวอักษร
// บนดำสนิท** 2026-10-19) — พาเลตต์ตาม .claude/brand-spec-sabuybet168.md §2
// ⚠️ รอบนี้ **ฟ้านำจริง ทอง #ffc82e เป็นฮิวที่สอง น้ำเงินลึก #0b3f78 ไม่เคยนำ**
// ฟ้าคือสิ่งที่ตาเห็นทั้งฉากในงานศิลป์ (ตัวอักษร เบท168 หัวใจ มือถือ ปึกแบงก์
// โบว์ซาติน กล่องของขวัญ เส้นแสง) ส่วนทองเป็นเหรียญบิตคอยน์ มงกุฎ และคำว่า "สบาย"
// ⚠️ **palette.json ชี้ผิดทั้งสามไฟล์รอบนี้** — dominant ของ banner1/slide1 เป็นดำ
// และ vivid เป็นโทนผิวนางแบบ ส่วน vivid ของ logo.webp เป็นเหลืองมะนาวของประกายดาว
// ฮิวนำจริงอ่านได้จากบิตแมปด้วยตาเท่านั้น
// ⚠️ พื้นเพจ **ดำสนิท #000000** (bg.json) ลำดับความลึก: #0e2238 ยก / #081726 กลาง /
// #040d16 จม / #000000 พื้น
//
// จังหวะรูปทรงของใบนี้: เป็น **แผ่นนูน neumorphic ใบแรกของสองใบในหน้า** วางบน
// **ผิวยก #0e2238** ซึ่งสว่างที่สุดในชุดผิว มุม rounded-[30px] และ **ไม่มีกรอบเลย**
// กดเงาลงไปหาผิวจม #040d16 แล้วยกแสงขึ้นด้วยน้ำเงินลึก #0b3f78 ตอน hover ฝั่งสว่าง
// ไต่ขึ้นถึงทองลึก #5c4a16 ส่วนแผ่นนูนอีกใบ (ContentBoxNeumorphism §2) เป็นมุม
// rounded-[25px] **มีกรอบน้ำเงินลึก** นั่งลึกกว่าที่ผิวกลาง และ **ไม่มี hover**
// — สองใบจึงต่างกันทั้งมุม ความลึกของผิว การมีกรอบ และพฤติกรรมตอน hover
// ความนูนแบบนี้ต้องใช้คู่มืด/สว่างในโทนเดียว สีแบรนด์จึงถูกเก็บไว้ที่หัวข้อกับป้าย
// คอลัมน์ ไม่ใช่ในเงา: หัวข้อไล่ ทอง #ffc82e → ทองอ่อน #ffefbb → ฟ้าแบรนด์ #2f9ff5
// ("ทองไล่ลงฟ้า") ซึ่งเป็นลำดับที่ไม่ซ้ำกับกล่องอื่นบนหน้าเดียวกันสักใบ และ **เป็น
// กล่องเดียวของหน้าที่ขึ้นต้นหัวข้อด้วยทอง** ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือ
// พิกเซลของตัวอักษร** ทุกสต็อปต้องถือตัวอักษรได้ตาม §2 (#ffc82e 11.3:1 · #ffefbb
// สูงกว่านั้น · #2f9ff5 5.9:1 ที่ text-2xl font-black = large text) — ห้ามเอา
// #0b3f78 หรือ #5c4a16 มาเป็นสต็อป
// ป้ายสองคอลัมน์แยกฮิวคนละข้าง: ซ้ายฟ้าแบรนด์ #2f9ff5 ขวาทอง #ffc82e ทั้งคู่เป็น
// text-2xl font-black จึงเป็น large text (รอบนี้หน้าเพจไม่ได้ส่งป้ายมา เพราะบรีฟ
// ไม่ได้ตั้งชื่อครึ่งย่อหน้าไว้ — โค้ดยังคงไว้ให้แบรนด์ถัดไป)
// เส้นคั่นเป็นทองลึก #5c4a16 เนื้อความ #e8f4ff (= BRAND_TEXT, 15.4:1 บนผิวยก)
// §2 ห้าม #0b3f78 #5c4a16 ถือตัวอักษร — ที่นี่อยู่ในเงาและเส้นคั่นเท่านั้น
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้มีสองชั้น: ทอง และ ฟ้า**
// ทองรอบนี้คือ #ffc82e เท่านั้น ไม่ใช่ ffd84d (ถอนชัวร์168) fcd434 (มีโชค168)
// f7c92b (ขวัญใจ168) f0b429 (รับตัง168) e3b23c (สมหวัง168) e2b33f (KMD88) dfa310
// (TND168) f2c230 (KINGKONG555) e5a81b (UFA324) fad354 (789BETTING) f5c518
// (FLASH877) หรือ f7d14e (KOON234) และฟ้ารอบนี้คือ #2f9ff5 / #a8dcff / #0b3f78
// เท่านั้น ไม่ใช่ 0360f3 0292fb 6ec8ff 4fb4ff (TSDET911) 0a84e0 04203f e4f1fd
// (HI59) หรือ cfd9e6 (เงินอมฟ้าของรับตัง168)
// ชุดทองไทย-โรสโกลด์-แดงชาดของขวัญใจ168 ที่เคยค้างอยู่ทั้งไฟล์นี้ (f7c92b ffe6a3
// f2bba5 c98a74 b3121b 5a0a0e 8a5f12 eadfce 241509 160d06 0b0603 140c06) ชุดชมพู
// บับเบิลกัม-ทองเนยของถอนชัวร์168 (fa63b9 ffb3de ffd84d 2b0f20 1a0914 0d040a 6d0b3f
// 6b4708 2a0617 fdeaf5) ชุดของมีโชค168 (fcd434 ffeaa0 f5469f ff8dc6 8c0f52 7a5508
// 1a0612 f6e4ee 24101c 160a12 0b0509) ชุดของรับตัง168 (f0b429 ffdc8c d30304 ff6b6e
// a00203 4a0202 9a6c0c cfd9e6 f5ece0 2b100f 200a09 140505 1a0505) ชุดของสมหวัง168
// (fa0513 ffadaf ff5a5f e3b23c ffe5a8 8a6210 b90203 8c0204 5b0203 3c0303 f4ecea
// 2c1413 1f0d0c 140706 290f0f) ชุดน้ำเงินไฟฟ้าของ TSDET911 (0360f3 0292fb 6ec8ff
// 4fb4ff cfdcec 9db4d4 dde8f7 102a5e 0a1c42 040e26 00081f) ชุดทองอำพันของ
// TIGERWIN369 (d98324 f7b733 ffd98a f7e4c0 e3cfae 8a5214) ชุดชมพูฮอตของ FAH999
// (ff3fa4 ff6cbb ffd1ea f5c53d) และชุดม่วงราชาของ KMD88 (7505cc b453ff c07cff
// d9b8ff ece2f8 bba8d4) ออกครบแล้ว
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีชมพู ไม่มีแดง ไม่มีม่วง ไม่มีเขียว ไม่มีส้ม ไม่มีเงิน/โครเมียม
// และไม่มีโรสโกลด์**
const columnLabel = "text-2xl leading-normal font-black tracking-wide";
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[30px] bg-[#0e2238] p-8 shadow-[10px_10px_22px_#040d16,-10px_-10px_22px_#0b3f78] transition-all duration-300 hover:shadow-[15px_15px_32px_#040d16,-15px_-15px_32px_#5c4a16]">
    {
      title && (
        <header class="mb-8 border-b border-[#5c4a16]/80 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#ffc82e] via-[#ffefbb] to-[#2f9ff5] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#e8f4ff]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e8f4ff]">
        {titleleft && <p class={`${columnLabel} text-[#2f9ff5]`}>{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e8f4ff] md:border-l md:border-[#5c4a16]/70 md:pl-8">
        {titleright && <p class={`${columnLabel} text-[#ffc82e]`}>{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
