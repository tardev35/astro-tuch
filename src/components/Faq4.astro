---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The docx's own level for this section. PKG44's brief marks
   *  "คำถามที่พบบ่อย" as an H2, so index.astro passes as="h2".
   *  It defaults to <p> so a page that hangs a chrome FAQ here stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  faqs?: FaqItem[];
}

// No defaults for `faqs` beyond an empty list — a stale default here would ship
// a previous brand's questions. The page passes both props.
//
// The questions themselves stay <span> inside <summary>: they are accordion
// controls, not docx headings, and the rendered heading inventory is diffed
// against the brief on every rebrand. The <section> keeps its aria-label either
// way, so nothing is lost for assistive tech.
//
// <details name="faq-pkg44"> keeps a single panel open at a time with no script,
// and the open state is keyed off [open] in the stylesheet rather than a
// hand-written .rotate-45 override. No <script> in this file.
//
// PKG44 (รอบทองเมทัลลิก-โครเมียม-ดำ 2026-09-27): โลโก้แบรนด์นี้เป็นเวิร์ดมาร์กสองโลหะ
// — P กับ G44 เป็นทอง ส่วน K เป็นโครเมียมขัดเงา แผงคำถามจึงเดินสองโลหะจริง คือผิว
// การ์ดเกือบดำ #12100a ในกรอบทองลึก #c8920a แต่เส้นไรผมมุมบนซ้ายกับสถานะเปิดเป็นเงิน
// โครเมียม #c2c8d0 หัวข้อ (ที่หน้าเพจส่งมาเป็น prop) ไล่ทองสว่าง #ffe27a → ขาว
// โครเมียม #f2f4f7 → ทองแบรนด์ #fdd32a ตามลำดับสีบนโลโก้ มาร์กนำหน้าคำถามเป็นทอง
// #fdd32a กล่อง + ตกลงไปที่พื้นเพจ #080602 เนื้อความใช้ #efe6d2 (BRAND_TEXT)
// — ชุดทอง-โครเมียมของ MIRACLE55 (#fcda65 #fee47b #d9a62b #fcfcfc #d2d3d4
// #8c5f14 #1b140b #14100a #050403 #e8e6e1) หายไปทั้งหมด
const { title, as: TitleTag = "p", faqs = [] } = Astro.props;
const sectionLabel = title ?? "คำถามที่พบบ่อย";
---

<section aria-label={sectionLabel} class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {
    title && (
      <div
        class="mb-8 flex items-center gap-3 border-l-4 border-[#fdd32a] bg-gradient-to-r from-[#2a2110] via-[#12100a]/60 to-transparent px-4 py-2.5"
        style="clip-path: polygon(0 0, 100% 0, calc(100% - 15px) 100%, 0 100%);">
        <TitleTag class="bg-gradient-to-r from-[#ffe27a] via-[#f2f4f7] to-[#fdd32a] bg-clip-text text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-2xl">
          {title}
        </TitleTag>
      </div>
    )
  }

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details
          name="faq-pkg44"
          class="faq-item group relative overflow-hidden border border-[#c8920a]/50 bg-[#12100a]/92 backdrop-blur-sm transition-all duration-300 hover:border-[#c2c8d0]/55 hover:shadow-[0_15px_40px_rgba(253,211,42,0.35)]"
          style="clip-path: polygon(15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%, 0 15px);">
          <div aria-hidden="true" class="absolute top-0 left-0 h-[2px] w-16 bg-gradient-to-r from-[#c2c8d0] to-transparent" />

          <summary class="flex w-full cursor-pointer items-center justify-between p-5 text-left transition-all">
            <span class="flex items-center gap-2.5 text-base font-bold text-[#efe6d2] transition-colors group-hover:text-[#fff8e1] md:text-lg">
              <span aria-hidden="true" class="text-xs text-[#fdd32a]">
                ◆
              </span>
              {faq.q}
            </span>

            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center border border-[#c8920a]/45 bg-[#080602] text-lg font-black text-[#efe6d2] transition-all duration-300 group-hover:border-[#c2c8d0]/70 group-hover:text-[#fff8e1]"
              style="clip-path: polygon(25% 0, 100% 0, 100% 75%, 75% 100%, 0 100%, 0 25%);">
              +
            </span>
          </summary>

          <div class="faq-answer border-t border-[#4a3a12]/60 p-5 pt-4 text-left text-base leading-relaxed text-[#efe6d2]">{faq.a}</div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(194, 200, 208, 0.55);
    box-shadow: 0 15px 40px rgba(253, 211, 42, 0.35);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #fdd32a;
    color: #fff8e1;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
