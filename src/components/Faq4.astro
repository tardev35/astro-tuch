---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The docx's own level for this section. หวยดีใจ's brief marks
   *  "คำถามที่พบบ่อยเกี่ยวกับ หวยดีใจ" as an H2, so index.astro passes as="h2".
   *  It defaults to <p> so a page that hangs a chrome FAQ here stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  faqs?: FaqItem[];
}

// No defaults for `faqs` beyond an empty list — a stale default here would ship
// a previous brand's questions. The page passes both props.
//
// The questions themselves stay <span> inside <summary>: they are accordion
// controls, not docx headings, and the rendered heading inventory is diffed
// against the brief on every rebrand. The <section> keeps its aria-label either
// way, so nothing is lost for assistive tech.
//
// <details name="faq-huaydeejai"> keeps a single panel open at a time with no
// script, and the open state is keyed off [open] in the stylesheet rather than a
// hand-written .rotate-45 override. No <script> in this file.
//
// หวยดีใจ (รอบแดงแบรนด์ + เงินโครเมียม บนดำอมแดง 2026-10-04): โลโก้แบรนด์นี้เป็น
// สองโลหะ — คำว่า "หวย" เป็นเงินโครเมียม (dominant #fdfcfc #d4d4d3) ส่วน "ดีใจ"
// เป็นแดงเมทัลลิก (vivid #dc0409 #f5131b #fd3236) และมงกุฎด้านหน้าเป็นทอง แผงคำถาม
// เป็นส่วนที่ต้องอ่านยาว จึงเดินด้วยระดับความสว่างของแดงเพียงโทนเดียวเพื่อไม่ให้
// ลายตา — ผิวการ์ดดำอมแดง #17080c ในกรอบแดงลึก #4b0205 แต่เส้นไรผมมุมบนซ้ายกับ
// สถานะเปิดเป็นแดงแบรนด์ #dc0409 หัวข้อ (ที่หน้าเพจส่งมาเป็น prop) ไล่เงินสว่าง
// #eef0f4 → เงินกลาง #c3c7d1 → แดงสว่าง #f5363d ซึ่งเป็นคู่ "เงินนำ แดงตาม" แบบ
// เดียวกับตัวอักษรบนโลโก้ มาร์กนำหน้าคำถามเป็นแดงแบรนด์ แผ่นป้ายหัวข้อไล่จากชิป
// #211016 ลงไปใส ส่วนกล่อง + ตกลงไปที่พื้นดำอมแดงลึกสุด #0d0407 เนื้อความใช้
// #edeaf0 (BRAND_TEXT)
//
// ชุดทอง-น้ำตาลของ UP555 ที่เคยค้างในไฟล์นี้ (#ebbb54 #fce675 #ab6d24 #6b4517
// #130b03 #241705 #0c0502 #f8eed9) ออกครบทุกจุดแล้ว
const { title, as: TitleTag = "p", faqs = [] } = Astro.props;
const sectionLabel = title ?? "คำถามที่พบบ่อย";
---

<section aria-label={sectionLabel} class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {
    title && (
      <div
        class="mb-8 flex items-center gap-3 border-l-4 border-[#dc0409] bg-gradient-to-r from-[#211016] via-[#17080c]/60 to-transparent px-4 py-2.5"
        style="clip-path: polygon(0 0, 100% 0, calc(100% - 15px) 100%, 0 100%);">
        <TitleTag class="bg-gradient-to-r from-[#eef0f4] via-[#c3c7d1] to-[#f5363d] bg-clip-text text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-2xl">
          {title}
        </TitleTag>
      </div>
    )
  }

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details
          name="faq-huaydeejai"
          class="faq-item group relative overflow-hidden border border-[#4b0205]/80 bg-[#17080c]/92 backdrop-blur-sm transition-all duration-300 hover:border-[#dc0409]/65 hover:shadow-[0_15px_40px_rgba(220,4,9,0.3)]"
          style="clip-path: polygon(15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%, 0 15px);">
          <div aria-hidden="true" class="absolute top-0 left-0 h-[2px] w-16 bg-gradient-to-r from-[#dc0409] to-transparent" />

          <summary class="flex w-full cursor-pointer items-center justify-between p-5 text-left transition-all">
            <span class="flex items-center gap-2.5 text-base font-bold text-[#edeaf0] transition-colors group-hover:text-[#f5363d] md:text-lg">
              <span aria-hidden="true" class="text-xs text-[#dc0409]">
                ◆
              </span>
              {faq.q}
            </span>

            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center border border-[#4b0205]/80 bg-[#0d0407] text-lg font-black text-[#edeaf0] transition-all duration-300 group-hover:border-[#dc0409]/70 group-hover:text-[#f5363d]"
              style="clip-path: polygon(25% 0, 100% 0, 100% 75%, 75% 100%, 0 100%, 0 25%);">
              +
            </span>
          </summary>

          <div class="faq-answer border-t border-[#4b0205]/70 p-5 pt-4 text-left text-base leading-relaxed text-[#edeaf0]">{faq.a}</div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(220, 4, 9, 0.65);
    box-shadow: 0 15px 40px rgba(220, 4, 9, 0.3);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #dc0409;
    color: #f5363d;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
