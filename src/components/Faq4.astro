---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The docx's own level for this section. UP555's brief marks
   *  "คำถามที่พบบ่อยเกี่ยวกับ UP555" as an H2, so index.astro passes as="h2".
   *  It defaults to <p> so a page that hangs a chrome FAQ here stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  faqs?: FaqItem[];
}

// No defaults for `faqs` beyond an empty list — a stale default here would ship
// a previous brand's questions. The page passes both props.
//
// The questions themselves stay <span> inside <summary>: they are accordion
// controls, not docx headings, and the rendered heading inventory is diffed
// against the brief on every rebrand. The <section> keeps its aria-label either
// way, so nothing is lost for assistive tech.
//
// <details name="faq-up555"> keeps a single panel open at a time with no script,
// and the open state is keyed off [open] in the stylesheet rather than a
// hand-written .rotate-45 override. No <script> in this file.
//
// UP555 (รอบทอง + เงินโครเมียม บนดำอมน้ำตาล 2026-10-03): โลโก้แบรนด์นี้เป็นสองโลหะ
// — ตัว U กับตัวอักษร UP เป็นเงินโครเมียม (dominant #d5d4d3 #f3f3f2) ส่วนลูกศร วงรี
// และเลข 555 เป็นทองเมทัลลิก (vivid #ebbb54 #fce675 #ab6d24) แผงคำถามเป็นส่วนที่
// ต้องอ่านยาว จึงเดินด้วยระดับความสว่างของทองเพียงโทนเดียวเพื่อไม่ให้ลายตา — ผิวการ์ด
// ดำอมน้ำตาล #130b03 ในกรอบทองลึก #6b4517 แต่เส้นไรผมมุมบนซ้ายกับสถานะเปิดเป็น
// ทองแบรนด์ #ebbb54 หัวข้อ (ที่หน้าเพจส่งมาเป็น prop) ไล่ทองสว่าง #fce675 → ทอง
// แบรนด์ #ebbb54 → ทองลึก #ab6d24 เป็นไล่เฉดทองล้วนตัวเดียวบนหน้านี้ มาร์กนำหน้า
// คำถามเป็นทองแบรนด์ แผ่นป้ายหัวข้อไล่จากชิป #241705 ลงไปใส ส่วนกล่อง + ตกลงไปที่
// พื้นดำอมน้ำตาลลึกสุด #0c0502 เนื้อความใช้ #f8eed9 (BRAND_TEXT)
//
// ชุดทอง-ดำของ NAZA99 ที่เคยค้างในไฟล์นี้ (#e4b34d #fdf2ac #c08f2b #8a5f12
// #140c02 #241404 #0a0501 #f3e8cf) ออกครบทุกจุดแล้ว
const { title, as: TitleTag = "p", faqs = [] } = Astro.props;
const sectionLabel = title ?? "คำถามที่พบบ่อย";
---

<section aria-label={sectionLabel} class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {
    title && (
      <div
        class="mb-8 flex items-center gap-3 border-l-4 border-[#ebbb54] bg-gradient-to-r from-[#241705] via-[#130b03]/60 to-transparent px-4 py-2.5"
        style="clip-path: polygon(0 0, 100% 0, calc(100% - 15px) 100%, 0 100%);">
        <TitleTag class="bg-gradient-to-r from-[#fce675] via-[#ebbb54] to-[#ab6d24] bg-clip-text text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-2xl">
          {title}
        </TitleTag>
      </div>
    )
  }

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details
          name="faq-up555"
          class="faq-item group relative overflow-hidden border border-[#6b4517]/70 bg-[#130b03]/92 backdrop-blur-sm transition-all duration-300 hover:border-[#ebbb54]/60 hover:shadow-[0_15px_40px_rgba(235,187,84,0.30)]"
          style="clip-path: polygon(15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%, 0 15px);">
          <div aria-hidden="true" class="absolute top-0 left-0 h-[2px] w-16 bg-gradient-to-r from-[#ebbb54] to-transparent" />

          <summary class="flex w-full cursor-pointer items-center justify-between p-5 text-left transition-all">
            <span class="flex items-center gap-2.5 text-base font-bold text-[#f8eed9] transition-colors group-hover:text-[#fce675] md:text-lg">
              <span aria-hidden="true" class="text-xs text-[#ebbb54]">
                ◆
              </span>
              {faq.q}
            </span>

            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center border border-[#6b4517]/70 bg-[#0c0502] text-lg font-black text-[#f8eed9] transition-all duration-300 group-hover:border-[#ebbb54]/70 group-hover:text-[#fce675]"
              style="clip-path: polygon(25% 0, 100% 0, 100% 75%, 75% 100%, 0 100%, 0 25%);">
              +
            </span>
          </summary>

          <div class="faq-answer border-t border-[#6b4517]/60 p-5 pt-4 text-left text-base leading-relaxed text-[#f8eed9]">{faq.a}</div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(235, 187, 84, 0.6);
    box-shadow: 0 15px 40px rgba(235, 187, 84, 0.3);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #ebbb54;
    color: #fce675;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
