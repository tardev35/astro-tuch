---
import { BRAND_NAME } from "../lib/brandProfile";

export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The docx's own level for this section. This brief marks
   *  "คำถามที่พบบ่อยเกี่ยวกับ <แบรนด์>" as an H2, so index.astro passes as="h2".
   *  It defaults to <p> so a page that hangs a chrome FAQ here stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  faqs?: FaqItem[];
}

// No defaults for `faqs` beyond an empty list — a stale default here would ship
// a previous brand's questions. The page passes both props, and the SAME array
// goes to pageGraph({ faqs }).
//
// The questions themselves stay <span> inside <summary>: they are accordion
// controls, not docx headings, and the rendered heading inventory is diffed
// against the brief on every rebrand. The <section> keeps its aria-label either
// way, so nothing is lost for assistive tech.
//
// <details name={groupName}> keeps a single panel open at a time with no script,
// and the open state is keyed off [open] in the stylesheet rather than a
// hand-written .rotate-45 override. No <script> in this file.
// ⚠️ The group name is INTERPOLATED from BRAND_NAME rather than typed, which is
// both the rebrand rule (the brand name is never written into markup) and the
// fix for the failure this attribute has had before: a hardcoded slug is the
// quietest way to leave the previous brand's fingerprint in a live attribute,
// because nothing visible changes when it rots.
//
// มีเฮ168 (รอบ **แดงชาดนำ · ทองเนยเป็นฮิวที่สอง · แดงลึก/บรอนซ์ลึกไม่เคยถือ
// ตัวอักษร · บนดำสนิท** 2026-10-19, brand-spec §2): โลโก้คือคำว่า "มี" ตัวอักษรไทย
// หนาสามมิติสีขาวมุกตัดขอบเทา ต่อด้วย "เฮ168" สีแดงชาดบับเบิลผิวมันวาว ทางซ้ายเป็น
// หน้ายิ้มหัวเราะสีเหลืองทองแก้มชมพูนั่งบนกองเหรียญทอง ล้อมด้วยประกายดาวสีทองและ
// ขีดประกายสีแดงบนพื้นขาว
// ⚠️ พื้นเพจเป็น **ดำสนิท #000000** (bg.json) ลำดับความลึก: #2b0711 ยก / #1a040a
// กลาง / #0c0205 จม / #000000 พื้น — ไม่มีผิวไหนจมต่ำกว่าพื้นได้
//
// ใบนี้ถือ docx H2 §8 และเป็นบล็อกเนื้อหาสุดท้ายของหน้า อยู่ถัดจาก ContentBoxTwo
// (§7) ที่เป็น **สองคอลัมน์ไม่มีการ์ดครอบ หัวข้อไล่เฉดข้างแถบตั้ง** — ที่นี่จึงเป็น
// **แถวมุมกลมหลายแถวบนผิวจม #0c0205** ไม่ใช่การ์ดใบเดียว ไม่มีเงานูน และไม่มี
// clip-path ที่ไหนในไฟล์นี้เลย
// แผ่นป้ายหัวข้อเป็นมุมกลมพร้อมรางซ้ายแดงแบรนด์ #fb1b32 หนาสี่พิกเซล ไล่พื้นจาก
// ผิวยก #2b0711 ลงไปใส
// หัวข้อ (ที่หน้าเพจส่งมาเป็น prop) ไล่ แดงแบรนด์ #fb1b32 → ทองเนย #fcd45c →
// ชมพูบลัช #ff8f9c ซึ่งเป็นลำดับที่ไม่ซ้ำกับอีกเจ็ดกล่องบนหน้าเดียวกัน
// ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึงคือพิกเซลของตัวอักษร ทุกสต็อปต้องถือตัวอักษรได้
// ตาม §2 (4.7 ที่ text-xl/2xl font-black = large text / 12.9 / 8.5)
// มาร์ก ❖ นำหน้าคำถามเป็นทองเนย #fcd45c (12.9:1) กรอบแถวเป็นแดงลึก #5c0410
// เส้นไรผมมุมบนซ้ายเป็นแดงแบรนด์ #fb1b32 กล่อง + นั่งบนผิวยก #2b0711 คำถามที่ hover
// และสถานะเปิดขึ้นเป็นชมพูบลัช #ff8f9c เนื้อความ #fdeaec (= BRAND_TEXT)
// §2 ห้าม #5c0410 #6b4a08 ถือตัวอักษรทุกขนาด — ในไฟล์นี้ทั้งสองค่าอยู่ที่ราง ขอบ
// เส้นไรผม และกรอบปุ่มเท่านั้น ไม่มีจุดไหนให้มันถือ glyph
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้มีสองชั้น: แดง และ ทอง**
// เพราะทั้งคู่ผ่านรีโปนี้มาแล้วหลายแบรนด์ แดงรอบนี้ #fb1b32 **ห่างจาก fa0513 ของ
// สมหวัง168 แค่นิดเดียว** และทองรอบนี้เป็นทองเนย #fcd45c ไม่ใช่ทองอำพัน f9a826
// ชุดเต็มของรวยแทร่168 ที่เพิ่งอยู่ในไฟล์นี้ (039cfa 0494f5 c3ebfc 04366b f9a826
// 704504 e3f2fc 0b2d52 071e38 030f1d 031320) ชุดของนินจา168 (32bcfb a9e9ff fef54b
// 07335f 6b5c10 0c2a3d 071a28 030e16 041019 dceefc) ชุดของสบายเบท168 (2f9ff5 a8dcff
// d6ecff 0b3f78 ffc82e 5c4a16 e8f4ff 0e2238 081726 040d16 04121f) ชุดของถอนชัวร์168
// (fa63b9 ffb3de ffd84d 6d0b3f 6b4708 2a0617 fdeaf5) ชุดของมีโชค168 (fcd434 ffeaa0
// f5469f ff8dc6 8c0f52 7a5508 1a0612 f6e4ee 24101c 160a12 0b0509) ชุดแดงมังกร-ทองไทย
// ของสมหวัง168 (fa0513 ffadaf ff5a5f e3b23c ffe5a8 8a6210 b90203 8c0204 5b0203
// 3c0303 f4ecea ccb9b6 2c1413 1f0d0c 140706 290f0f) และชุดน้ำเงินไฟฟ้า-เงินโครเมียม
// ของ TSDET911 (0360f3 0292fb 6ec8ff 4fb4ff cfdcec 9db4d4 dde8f7 102a5e 0a1c42
// 040e26 00081f 032dad 04186e 041a43) ถอดออกครบทุกค่า รวมถึงชื่อ details group
// ของแบรนด์ก่อน
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีฟ้า/น้ำเงิน ม่วง/ไวโอเลต เขียว ส้ม เงิน/โครเมียม โรสโกลด์
// เหลืองมะนาว และชมพูฟูเชีย**
const { title, as: TitleTag = "p", faqs = [] } = Astro.props;
const sectionLabel = title ?? "คำถามที่พบบ่อย";
const groupName = `faq-${BRAND_NAME}`;
---

<section aria-label={sectionLabel} class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {
    title && (
      <div class="mb-8 flex items-center gap-3 rounded-2xl border-l-4 border-[#fb1b32] bg-gradient-to-r from-[#2b0711] via-[#0c0205]/60 to-transparent px-4 py-2.5">
        <TitleTag class="bg-gradient-to-r from-[#fb1b32] via-[#fcd45c] to-[#ff8f9c] bg-clip-text text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-2xl">
          {title}
        </TitleTag>
      </div>
    )
  }

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details
          name={groupName}
          class="faq-item group relative overflow-hidden rounded-2xl border border-[#5c0410] bg-[#0c0205]/95 backdrop-blur-sm transition-all duration-300 hover:border-[#fcd45c]/75 hover:shadow-[0_15px_40px_rgba(251,27,50,0.26)]">
          <div aria-hidden="true" class="absolute top-0 left-0 h-[2px] w-16 bg-gradient-to-r from-[#fb1b32] to-transparent" />

          <summary class="flex w-full cursor-pointer items-center justify-between p-5 text-left transition-all">
            <span class="flex items-center gap-2.5 text-base font-bold text-[#fdeaec] transition-colors group-hover:text-[#ff8f9c] md:text-lg">
              <span aria-hidden="true" class="text-xs text-[#fcd45c]">
                ❖
              </span>
              {faq.q}
            </span>

            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#6b4a08] bg-[#2b0711] text-lg font-black text-[#fdeaec] transition-all duration-300 group-hover:border-[#fcd45c] group-hover:text-[#ff8f9c]">
              +
            </span>
          </summary>

          <div class="faq-answer border-t border-[#5c0410] p-5 pt-4 text-left text-base leading-relaxed text-[#fdeaec]">{faq.a}</div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(252, 212, 92, 0.75);
    box-shadow: 0 15px 40px rgba(251, 27, 50, 0.26);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #fcd45c;
    color: #ff8f9c;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
