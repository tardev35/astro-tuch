---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The docx's own level for this section. NAZA99's brief marks
   *  "คำถามที่พบบ่อยเกี่ยวกับ NAZA99" as an H2, so index.astro passes as="h2".
   *  It defaults to <p> so a page that hangs a chrome FAQ here stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  faqs?: FaqItem[];
}

// No defaults for `faqs` beyond an empty list — a stale default here would ship
// a previous brand's questions. The page passes both props.
//
// The questions themselves stay <span> inside <summary>: they are accordion
// controls, not docx headings, and the rendered heading inventory is diffed
// against the brief on every rebrand. The <section> keeps its aria-label either
// way, so nothing is lost for assistive tech.
//
// <details name="faq-naza99"> keeps a single panel open at a time with no
// script, and the open state is keyed off [open] in the stylesheet rather than a
// hand-written .rotate-45 override. No <script> in this file.
//
// NAZA99 (รอบทอง-ดำ 2026-10-02): โลโก้แบรนด์นี้เป็นตัวอักษรทองเมทัลลิกล้วนบนพื้นโปร่ง
// (#e4b34d นำ รองด้วย #fdf2ac) ไม่มีสีคู่ตรงข้ามให้เดินสองโทนแบบแบรนด์ก่อน แผงคำถาม
// จึงไล่ด้วยระดับความสว่างของทองเท่านั้น — ผิวการ์ดดำอมน้ำตาล #140c02 ในกรอบทองลึก
// #8a5f12 แต่เส้นไรผมมุมบนซ้ายกับสถานะเปิดเป็นทองแบรนด์ #e4b34d หัวข้อ (ที่หน้าเพจส่งมา
// เป็น prop) ไล่แชมเปญ #fdf2ac → ทองแบรนด์ #e4b34d → ทองเข้ม #c08f2b มาร์กนำหน้าคำถาม
// เป็นทองแบรนด์ กล่อง + ตกลงไปที่พื้นดำสนิท #0a0501 เนื้อความใช้ #f3e8cf (BRAND_TEXT)
// — ชุดเขียวป่า-ทองของ หวยเต็ง ที่ค้างในไฟล์นี้ (#e5c04f #fae474 #bd8d2d #a9cfae #eafbe9
// #d8ead9 #062a12 #0b3d18 #03150a #024a0f) หายไปทั้งหมด
const { title, as: TitleTag = "p", faqs = [] } = Astro.props;
const sectionLabel = title ?? "คำถามที่พบบ่อย";
---

<section aria-label={sectionLabel} class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {
    title && (
      <div
        class="mb-8 flex items-center gap-3 border-l-4 border-[#e4b34d] bg-gradient-to-r from-[#241404] via-[#140c02]/60 to-transparent px-4 py-2.5"
        style="clip-path: polygon(0 0, 100% 0, calc(100% - 15px) 100%, 0 100%);">
        <TitleTag class="bg-gradient-to-r from-[#fdf2ac] via-[#e4b34d] to-[#c08f2b] bg-clip-text text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-2xl">
          {title}
        </TitleTag>
      </div>
    )
  }

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details
          name="faq-naza99"
          class="faq-item group relative overflow-hidden border border-[#8a5f12]/70 bg-[#140c02]/92 backdrop-blur-sm transition-all duration-300 hover:border-[#e4b34d]/60 hover:shadow-[0_15px_40px_rgba(228,179,77,0.30)]"
          style="clip-path: polygon(15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%, 0 15px);">
          <div aria-hidden="true" class="absolute top-0 left-0 h-[2px] w-16 bg-gradient-to-r from-[#e4b34d] to-transparent" />

          <summary class="flex w-full cursor-pointer items-center justify-between p-5 text-left transition-all">
            <span class="flex items-center gap-2.5 text-base font-bold text-[#f3e8cf] transition-colors group-hover:text-[#fdf2ac] md:text-lg">
              <span aria-hidden="true" class="text-xs text-[#e4b34d]">
                ◆
              </span>
              {faq.q}
            </span>

            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center border border-[#8a5f12]/70 bg-[#0a0501] text-lg font-black text-[#f3e8cf] transition-all duration-300 group-hover:border-[#e4b34d]/70 group-hover:text-[#fdf2ac]"
              style="clip-path: polygon(25% 0, 100% 0, 100% 75%, 75% 100%, 0 100%, 0 25%);">
              +
            </span>
          </summary>

          <div class="faq-answer border-t border-[#8a5f12]/60 p-5 pt-4 text-left text-base leading-relaxed text-[#f3e8cf]">{faq.a}</div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(228, 179, 77, 0.6);
    box-shadow: 0 15px 40px rgba(228, 179, 77, 0.3);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #e4b34d;
    color: #fdf2ac;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
