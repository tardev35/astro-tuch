---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The docx's own level for this section. This brief marks
   *  "คำถามที่พบบ่อยเกี่ยวกับ UOK365" as an H2, so index.astro passes as="h2".
   *  It defaults to <p> so a page that hangs a chrome FAQ here stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  faqs?: FaqItem[];
}

// No defaults for `faqs` beyond an empty list — a stale default here would ship
// a previous brand's questions. The page passes both props.
//
// The questions themselves stay <span> inside <summary>: they are accordion
// controls, not docx headings, and the rendered heading inventory is diffed
// against the brief on every rebrand. The <section> keeps its aria-label either
// way, so nothing is lost for assistive tech.
//
// <details name="faq-uok365"> keeps a single panel open at a time with no
// script, and the open state is keyed off [open] in the stylesheet rather than a
// hand-written .rotate-45 override. No <script> in this file.
//
// UOK365 (รอบทองเมทัลลิก-เงินโครเมียม บนน้ำตาลเกือบดำ 2026-10-07, brand-spec §2):
// โลโก้แบรนด์นี้เป็นสองโลหะ — ตัวอักษร UOK เป็นทองเมทัลลิก (vivid #a46b25) ส่วนตัวเลข
// 365 เป็นเงินโครเมียม และวงแหวนรอบนอกเป็นทอง แผงคำถามเป็นส่วนที่ต้องอ่านยาว จึงเดิน
// ด้วยระดับความสว่างของทองเพียงโทนเดียวเพื่อไม่ให้ลายตา — ผิวการ์ดกลาง #120c07 ในกรอบ
// ทองลึก #6d4412 แต่เส้นไรผมมุมบนซ้ายกับสถานะเปิดเป็นทองแบรนด์ #c8912f หัวข้อ (ที่
// หน้าเพจส่งมาเป็น prop) ไล่เงินโครเมียม #d8dbe0 → ทองอ่อน #f5d98a → ทองแบรนด์
// #c8912f ซึ่งเป็นคู่ "เงินนำ ทองตาม" แบบเดียวกับที่โลโก้วางเลข 365 ไว้ใต้คำว่า UOK
// มาร์กนำหน้าคำถามเป็นทองแบรนด์ แผ่นป้ายหัวข้อไล่จากผิวยก #191108 ลงไปใส ส่วนกล่อง +
// ตกลงไปที่ผิวลึกสุด #070504 เนื้อความใช้ #ece1cc (BRAND_TEXT) — 14.6:1 บนผิวกลาง
//
// ชุดแดงแบรนด์-เงินของ หวยดีใจ ที่เคยค้างในไฟล์นี้ (#dc0409 #f5363d #4b0205 #17080c
// #211016 #0d0407 #eef0f4 #c3c7d1 #edeaf0 rgba(220,4,9,…)) ออกครบทุกจุดแล้ว
// พร้อมกับชื่อ details group ของรอบนั้น
const { title, as: TitleTag = "p", faqs = [] } = Astro.props;
const sectionLabel = title ?? "คำถามที่พบบ่อย";
---

<section aria-label={sectionLabel} class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {
    title && (
      <div
        class="mb-8 flex items-center gap-3 border-l-4 border-[#c8912f] bg-gradient-to-r from-[#191108] via-[#120c07]/60 to-transparent px-4 py-2.5"
        style="clip-path: polygon(0 0, 100% 0, calc(100% - 15px) 100%, 0 100%);">
        <TitleTag class="bg-gradient-to-r from-[#d8dbe0] via-[#f5d98a] to-[#c8912f] bg-clip-text text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-2xl">
          {title}
        </TitleTag>
      </div>
    )
  }

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details
          name="faq-uok365"
          class="faq-item group relative overflow-hidden border border-[#6d4412] bg-[#120c07]/92 backdrop-blur-sm transition-all duration-300 hover:border-[#c8912f]/70 hover:shadow-[0_15px_40px_rgba(200,145,47,0.26)]"
          style="clip-path: polygon(15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%, 0 15px);">
          <div aria-hidden="true" class="absolute top-0 left-0 h-[2px] w-16 bg-gradient-to-r from-[#c8912f] to-transparent" />

          <summary class="flex w-full cursor-pointer items-center justify-between p-5 text-left transition-all">
            <span class="flex items-center gap-2.5 text-base font-bold text-[#ece1cc] transition-colors group-hover:text-[#f5d98a] md:text-lg">
              <span aria-hidden="true" class="text-xs text-[#c8912f]">
                ◆
              </span>
              {faq.q}
            </span>

            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center border border-[#6d4412] bg-[#070504] text-lg font-black text-[#ece1cc] transition-all duration-300 group-hover:border-[#c8912f]/80 group-hover:text-[#f5d98a]"
              style="clip-path: polygon(25% 0, 100% 0, 100% 75%, 75% 100%, 0 100%, 0 25%);">
              +
            </span>
          </summary>

          <div class="faq-answer border-t border-[#6d4412] p-5 pt-4 text-left text-base leading-relaxed text-[#ece1cc]">{faq.a}</div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(200, 145, 47, 0.7);
    box-shadow: 0 15px 40px rgba(200, 145, 47, 0.26);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #c8912f;
    color: #f5d98a;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
