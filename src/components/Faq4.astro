---
import { BRAND_NAME } from "../lib/brandProfile";

export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The docx's own level for this section. This brief marks
   *  "คำถามที่พบบ่อยเกี่ยวกับ <แบรนด์>" as an H2, so index.astro passes as="h2".
   *  It defaults to <p> so a page that hangs a chrome FAQ here stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  faqs?: FaqItem[];
}

// No defaults for `faqs` beyond an empty list — a stale default here would ship
// a previous brand's questions. The page passes both props, and the SAME array
// goes to pageGraph({ faqs }).
//
// The questions themselves stay <span> inside <summary>: they are accordion
// controls, not docx headings, and the rendered heading inventory is diffed
// against the brief on every rebrand. The <section> keeps its aria-label either
// way, so nothing is lost for assistive tech.
//
// <details name={groupName}> keeps a single panel open at a time with no script,
// and the open state is keyed off [open] in the stylesheet rather than a
// hand-written .rotate-45 override. **No <script> in this file, and it must
// never go back to a button + max-height.**
// ⚠️ The group name is INTERPOLATED from BRAND_NAME rather than typed, which is
// both the rebrand rule (the brand name is never written into markup) and the
// fix for the failure this attribute has had before: a hardcoded slug is the
// quietest way to leave the previous brand's fingerprint in a live attribute,
// because nothing visible changes when it rots.
//
// ───────────────────────────────────────────────────────────────────────────
// พักยก168 (2026-10-22) — พาเลตตาม .claude/brand-spec-pakyok168.md §2–§3
// FAQ ที่ใช้งานจริงรอบนี้ — รอบก่อน (สบาย168) ใช้ Faq3 จึงหมุนมาที่ไฟล์นี้
// อ่านจากอาร์ตเวิร์กจริง: โลโก้เป็น **หัวมังกรจีนสีทองสามมิติหันซ้าย อ้าปาก
// มีเขาและหนวดเป็นเส้นทอง** ข้างคำว่า **"พักยก" ตัวอักษรไทยสามมิติผิวทองมันวาว**
// ต่อด้วยเลข **"168" ผิวโครเมียมเงิน** ตัดขอบดำหนา
// ⚠️ **ธีมมืด และนี่คือจุดที่ไฟล์นี้พลิกมากที่สุด**: รอบก่อนไฟล์นี้เป็นแถวผิวขาว
// บนพื้นชมพูพาสเทล รอบนี้ bg.json = #291d0f น้ำตาลกาแฟเข้ม และ §2 จัด FAQ ไว้ใน
// **โซนเนื้อหา ไม่ใช่โครม** แถวคำถามจึงเป็น **ผิวยก #3a2713** พร้อมหมึก
// **ไอวอรีอุ่น #f4ead6** (11.9:1) ลำดับความลึก: #3a2713 ยก / #32200f กลาง /
// #1f1308 อินเซ็ต / #291d0f พื้นเพจ
//
// ใบนี้ถือ docx H2 §8 และเป็นบล็อกเนื้อหาสุดท้ายของหน้า อยู่ถัดจาก
// ContentBoxTwoNeumorphism (§7) ที่เป็น **แผ่นนูน neumorphic ใบเดียวไม่มีกรอบ** —
// ที่นี่จึงเป็น **แถวมุมกลมหลายแถวที่มีกรอบ ไม่ใช่การ์ดใบเดียว** ไม่มีเงานูน
// ไม่มี clip-path และไม่มีแผ่นถมทึบที่ไหนในไฟล์นี้เลย
// แผ่นป้ายหัวข้อเป็นมุมกลมพร้อมรางซ้าย **ทองแกน #eeae12** หนาสี่พิกเซล ไล่พื้น
// จากผิวอินเซ็ต #1f1308 ลงไปใส
// หัวข้อ (ที่หน้าเพจส่งมาเป็น prop) ไล่ ทองแกน #eeae12 → ทองสว่าง #fded41 →
// ทองแกน #eeae12 ซึ่งเป็นลำดับที่ **ไม่ซ้ำกับกล่องใดบนหน้าเดียวกัน**: §2 ไล่
// ทอง→โครเมียม→ทอง · §7 ไล่ โครเมียม→ทอง→โครเมียม · §4 ไล่สองสต็อป ทองสว่าง→ทองแกน
// ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุกสต็อปต้องถือตัวอักษร
// ได้ตาม §2 (#eeae12 9.3:1 · #fded41 15.1:1 บนผิวอินเซ็ต · และ 8.4:1 / 13.6:1 บน
// พื้นเพจที่ปลายไล่เฉดของแผ่นป้ายใส) หัวข้อเป็น text-xl md:text-2xl font-black จึงนับ
// เป็น **large text** ทุกแบนด์ เกณฑ์คือ 3:1 ผ่านทั้งหมด
// มาร์ก ❖ นำหน้าคำถามเป็นทองแกน #eeae12 (7.2:1 บนผิวยก) กรอบแถวเป็นทองแกนโปร่ง
// เส้นไรผมมุมบนซ้ายเป็นทองสว่าง กล่อง + นั่งบนผิวอินเซ็ต #1f1308 พร้อมหมึกทองสว่าง
// #fded41 คำถามที่ hover และสถานะเปิดขึ้นเป็นทองสว่าง เนื้อความ #f4ead6
// (= BRAND_TEXT)
// ⚠️ §2 ห้าม **ทองลึก #9f600d (2.8:1)** ถือตัวอักษรและห้ามเป็นพื้นของตัวอักษร —
// ไฟล์นี้จึง **ไม่มี #9f600d เลยสักจุด** เพราะทุกชั้นที่นี่มีตัวอักษรอยู่ ·
// **ผิวทั้งสี่ #3a2713 #32200f #1f1308 #291d0f ห้ามถือตัวอักษร** เป็นพื้นเท่านั้น
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือทอง เพราะทองผ่านรีโปนี้
// มาแล้วเกือบทุกเจ้า และรอบก่อนหน้าทันทีก็มีทองคานารีเป็นสีที่สอง** ทองรอบนี้
// **#eeae12 (R238 G174 B18)** และ **#fded41 (R253 G237 B65)** วัดจาก logo.webp /
// banner1.png เอง ตัวที่ใกล้ที่สุดในรีโปคือ **e6a416 กับ fee45d ของ ยูฟ้า168**
// (ห่าง R8/G10/B4 และ R1/G9/B28) **e5a81b ของ UFA324** (ห่าง R9/G6/B7) และ
// **fef54b ของ นินจา168** (ห่าง R1/G8/B10) — ทั้งหมดใกล้กว่าที่รีโปนี้ยอมตามปกติ
// ชุดแดงเชอร์รี่-ทองแดงไหม้ของ **โปรดี168** ที่เพิ่งอยู่ในไฟล์นี้ทั้งใบ (eb0305
// e40303 c20305 9b0a0c ff4446 401107 b44c06 7a2f03 f0b46a d9803a 4d1c0a 2c1004
// fff0e4 fff4ea ffd1d1 1a0802 กับ rgba 235/3/5 α)) ออกครบทุกค่าแล้ว เช่นเดียวกับ
// ชุดฟ้าสกาย-ทองคานารีของรอบขาออก **สบาย168** (2cc3fc 6bdcfb 0a7fbd 063a57 04293d
// 0a4f74 9ae0fa cdf2ff ccf7ff f2fbff dff4fd eafaff a9e3f9 fdcb0c fefb6b 8a6504
// 0f3a4a 06293c 2a1f02) ชุดทองคานารี-เงินโครเมียมของ **ยูฟ้า168** (fee45d e6a416
// b8780d 7a4e05 e8ecf1 a8b2bf 78828f 5a6472 15130f 1e1a13 0a0908 eae3d4 140e02
// 000000) ชุดแดงคริมสัน-ทองโบราณของ **รวยแท้168** (c30303 8f0505 e81313 dcb95f
// b8862b 96681f 4a0f0f 461212 280b0b ffeee8 fff1ef ffdbdb c99a3f) ชุดเขียวมรกตของ
// **สาธุ168** (0b7d28 0a5f1c 0f9b35 0c3a16 061f0c c9cb63 aeb04a 9ba03c d8ffc7
// e9fbdd) ชุดบรอนซ์-ทองอำพันของ **ufalion168** (d4922c fdfc71 a25b24 8c4312 d39c45
// f6e3b4 33200a 1f1304 0a0601 5a3310 1a1000) ชุดเต็มของ **มีเฮ168** (fb1b32 ff8f9c
// 5c0410 fcd45c 6b4a08 2b0711 1a040a 0c0205 fdeaec) ชุดทองจักรพรรดิ-แดงชาดของ
// **รวยเทพ168** (f0bb4e ffeccb e4021b d9701a 3b1b0e 260d04 0d0501 5c2a06 fff8ec)
// ชุดเต็มของ **รวยแทร่168** (039cfa 0494f5 c3ebfc 04366b f9a826 704504 e3f2fc
// 0b2d52 071e38 030f1d) ชุดของ **นินจา168** (32bcfb a9e9ff fef54b 07335f 6b5c10
// 0c2a3d 071a28 030e16 041019 dceefc) ชุดของ **สบายเบท168** (2f9ff5 a8dcff d6ecff
// 0b3f78 ffc82e 5c4a16 e8f4ff 0e2238 081726 040d16) ชุดของ **ถอนชัวร์168** (fa63b9
// ffb3de ffd84d 6d0b3f 6b4708 2a0617 fdeaf5) ชุดของ **มีโชค168** (fcd434 ffeaa0
// f5469f ff8dc6 8c0f52 7a5508 1a0612 f6e4ee) ชุดของ **ดวงเศรษฐี168** (f0c878 fff8d8
// d9212a 8e1a16 4e2120 300605 150303) และชุดแดงมังกร-ทองไทยของ **สมหวัง168**
// (fa0513 ffadaf ff5a5f e3b23c ffe5a8 8a6210 b90203 8c0204 5b0203 3c0303) ถอดออกครบ
// ทุกค่า รวมถึงชื่อ details group ของแบรนด์ก่อน
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีฟ้า/น้ำเงิน ม่วง/ไวโอเลต เขียว โรสโกลด์ เหลืองมะนาว ชมพู/ฟูเชีย
// บรอนซ์ ทองแดงไหม้ และแดงทุกเฉด** — โครเมียมเงินมี แต่เป็นชุด #e0e0df / #c0c0bf /
// #a1a09e เท่านั้น และรอบนี้ไม่ถูกใช้ในไฟล์นี้ (สงวนไว้ให้ §5 และ §7)
const { title, as: TitleTag = "p", faqs = [] } = Astro.props;
const sectionLabel = title ?? "คำถามที่พบบ่อย";
const groupName = `faq-${BRAND_NAME}`;
---

<section aria-label={sectionLabel} class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {
    title && (
      <div class="mb-8 flex items-center gap-3 rounded-2xl border-l-4 border-[#eeae12] bg-gradient-to-r from-[#1f1308] via-[#1f1308]/60 to-transparent px-4 py-2.5">
        <TitleTag class="bg-gradient-to-r from-[#eeae12] via-[#fded41] to-[#eeae12] bg-clip-text text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-2xl">
          {title}
        </TitleTag>
      </div>
    )
  }

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details
          name={groupName}
          class="faq-item group relative overflow-hidden rounded-2xl border border-[#eeae12]/45 bg-[#3a2713] transition-all duration-300 hover:border-[#fded41]/70 hover:shadow-[0_15px_40px_rgba(253,237,65,0.18)]">
          <div aria-hidden="true" class="absolute top-0 left-0 h-[2px] w-16 bg-gradient-to-r from-[#fded41] to-transparent" />

          <summary class="flex w-full cursor-pointer items-center justify-between p-5 text-left transition-all">
            <span class="flex items-center gap-2.5 text-base font-bold text-[#f4ead6] transition-colors group-hover:text-[#fded41] md:text-lg">
              <span aria-hidden="true" class="text-xs text-[#eeae12]">
                ❖
              </span>
              {faq.q}
            </span>

            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#eeae12]/55 bg-[#1f1308] text-lg font-black text-[#fded41] transition-all duration-300 group-hover:border-[#fded41] group-hover:text-[#fded41]">
              +
            </span>
          </summary>

          <div class="faq-answer border-t border-[#eeae12]/40 p-5 pt-4 text-left text-base leading-relaxed text-[#f4ead6]">{faq.a}</div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(253, 237, 65, 0.7);
    box-shadow: 0 15px 40px rgba(253, 237, 65, 0.18);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #fded41;
    color: #fded41;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
