---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The docx's own level for this section. This brief marks
   *  "คำถามที่พบบ่อยเกี่ยวกับ TSDET911" as an H2, so index.astro passes
   *  as="h2". It defaults to <p> so a page that hangs a chrome FAQ here stays
   *  out of the heading inventory. */
  as?: "h2" | "h3" | "p";
  faqs?: FaqItem[];
}

// No defaults for `faqs` beyond an empty list — a stale default here would ship
// a previous brand's questions. The page passes both props, and the SAME array
// goes to pageGraph({ faqs }).
//
// The questions themselves stay <span> inside <summary>: they are accordion
// controls, not docx headings, and the rendered heading inventory is diffed
// against the brief on every rebrand. The <section> keeps its aria-label either
// way, so nothing is lost for assistive tech.
//
// <details name="faq-tsdet911"> keeps a single panel open at a time with no
// script, and the open state is keyed off [open] in the stylesheet rather than a
// hand-written .rotate-45 override. No <script> in this file. The group name is
// rebranded with everything else — leaving a previous brand's slug in a `name`
// attribute is the quietest way to ship its fingerprint.
//
// TSDET911 (รอบน้ำเงินไฟฟ้า-เงินโครเมียม 2026-10-13, brand-spec §2):
// รอบนี้เป็น **สองโทนจริง: น้ำเงินไฟฟ้านำ เงินโครเมียมรอง ไม่มีทอง ไม่มีม่วง
// ไม่มีส้ม/อำพัน ไม่มีเขียว (ยกเว้นสีสถานะเชิงความหมายซึ่งไฟล์นี้ไม่มี) และไม่มีแดง**
// โลโก้คือตัวอักษร TSDET สามมิติสีเงินโครเมียมขัดเงา ต่อด้วยเลข 911 สีน้ำเงินไฟฟ้า
// และปีกเหยี่ยว/สวูชสีน้ำเงิน
// ⚠️ พื้นเพจเป็นกรมเกือบดำ #00081f (bg.json) ลำดับความลึก: #102a5e ยก / #0a1c42 กลาง /
// #040e26 จม / #00081f พื้น — ไม่มีชั้นไหนจมต่ำกว่าพื้นได้
//
// ใบนี้ถือ docx H2 §8 และเป็นบล็อกเนื้อหาสุดท้ายของหน้า อยู่ถัดจาก
// ContentBoxNeumorphism (§7) ที่เป็น **แผ่นนูนใบเดียวมุม 25px ผิวกลาง #0a1c42** — ที่นี่
// จึงเป็น **แถวมุมกลมหลายแถวบนผิวจม #040e26** ไม่ใช่การ์ดใบเดียว และไม่มี clip-path
// ที่ไหนในไฟล์นี้เลย สองส่วนที่ติดกันจึงต่างกันทั้งรูปทรง จำนวนก้อน และความลึก
// แผ่นป้ายหัวข้อเป็นมุมกลมพร้อมรางซ้ายน้ำเงินแบรนด์ #0360f3 หนาสี่พิกเซล ไล่พื้นจาก
// ผิวยก #102a5e ลงไปใส
// หัวข้อ (ที่หน้าเพจส่งมาเป็น prop) ไล่ ฟ้าสว่าง #6ec8ff → ฟ้าอ่อน #4fb4ff → เงิน
// โครเมียมสว่าง #cfdcec ซึ่งเป็นลำดับที่ไม่ซ้ำกับอีกเจ็ดกล่องบนหน้าเดียวกันสักใบ
// มาร์ก ❖ นำหน้าคำถามเป็นฟ้าสว่าง #6ec8ff (7.4:1) กรอบแถวเป็นน้ำเงินลึก #04186e เส้น
// ไรผมมุมบนซ้ายเป็นฟ้าสด #0292fb กล่อง + นั่งบนผิวยก #102a5e คำถามที่ hover และสถานะ
// เปิดขึ้นเป็นฟ้าสว่าง #6ec8ff เนื้อความ #dde8f7 (= BRAND_TEXT) — 17.4:1 บนผิวจม
// #040e26 ตัวรองถ้ามีจะเป็นเงินโครเมียมหม่น #9db4d4
// §2 ห้าม #0360f3 #0292fb #032dad #04186e #041a43 ถือตัวอักษรทุกขนาด — ในไฟล์นี้ทั้งห้า
// ค่าอยู่ที่ราง ขอบ เส้นไรผม และออราเท่านั้น ไม่มีจุดไหนให้มันถือ glyph
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — ไฟล์นี้เพิ่งถือชุดทองอำพันของแบรนด์เสือรอบ
// ก่อนมาทั้งไฟล์ (ทองอำพันนำ + ทองสว่างเป็นระดับที่สอง + อำพันลึกที่ขอบ + เนื้อความครีม)
// และก่อนนั้นเป็นชุดทองเป็ด-ส้มปากเป็ด ทั้งสองชุดถูกถอดออกครบทุกค่า รวมถึงชื่อ
// details group ของแบรนด์ก่อน — ไม่มีค่าไหนเหลืออยู่ในไฟล์นี้แล้ว
// ⚠️ ฟ้า false friend ที่ใกล้ที่สุดในประวัติโค้ดเบสคือฟ้าสดของแบรนด์ "แตกดี168"
// (R=1 G=147 B=251) ซึ่งไม่ใช่ #0292fb (R=2 G=146 B=251) ของรอบนี้ — ให้เทียบเป็นตัวเลข
// ทีละค่า ห้ามกะด้วยตา
const { title, as: TitleTag = "p", faqs = [] } = Astro.props;
const sectionLabel = title ?? "คำถามที่พบบ่อย";
---

<section aria-label={sectionLabel} class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {
    title && (
      <div class="mb-8 flex items-center gap-3 rounded-2xl border-l-4 border-[#0360f3] bg-gradient-to-r from-[#102a5e] via-[#040e26]/60 to-transparent px-4 py-2.5">
        <TitleTag class="bg-gradient-to-r from-[#6ec8ff] via-[#4fb4ff] to-[#cfdcec] bg-clip-text text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-2xl">
          {title}
        </TitleTag>
      </div>
    )
  }

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details
          name="faq-tsdet911"
          class="faq-item group relative overflow-hidden rounded-2xl border border-[#04186e] bg-[#040e26]/95 backdrop-blur-sm transition-all duration-300 hover:border-[#0360f3]/75 hover:shadow-[0_15px_40px_rgba(3,96,243,0.26)]">
          <div aria-hidden="true" class="absolute top-0 left-0 h-[2px] w-16 bg-gradient-to-r from-[#0292fb] to-transparent" />

          <summary class="flex w-full cursor-pointer items-center justify-between p-5 text-left transition-all">
            <span class="flex items-center gap-2.5 text-base font-bold text-[#dde8f7] transition-colors group-hover:text-[#6ec8ff] md:text-lg">
              <span aria-hidden="true" class="text-xs text-[#6ec8ff]">
                ❖
              </span>
              {faq.q}
            </span>

            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#04186e] bg-[#102a5e] text-lg font-black text-[#dde8f7] transition-all duration-300 group-hover:border-[#0292fb]/85 group-hover:text-[#6ec8ff]">
              +
            </span>
          </summary>

          <div class="faq-answer border-t border-[#04186e] p-5 pt-4 text-left text-base leading-relaxed text-[#dde8f7]">{faq.a}</div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(3, 96, 243, 0.75);
    box-shadow: 0 15px 40px rgba(3, 96, 243, 0.26);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #0360f3;
    color: #6ec8ff;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
