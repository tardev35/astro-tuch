---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The docx's own level for this section. MHEEPOOH168's brief marks
   *  "คำถามที่พบบ่อย" as an H2, so index.astro passes as="h2".
   *  It defaults to <p> so a page that hangs a chrome FAQ here stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  faqs?: FaqItem[];
}

// No defaults for `faqs` beyond an empty list — a stale default here would ship
// a previous brand's questions. The page passes both props.
//
// The questions themselves stay <span> inside <summary>: they are accordion
// controls, not docx headings, and the rendered heading inventory is diffed
// against the brief on every rebrand. The <section> keeps its aria-label either
// way, so nothing is lost for assistive tech.
//
// The open state is keyed off [open] in the stylesheet rather than a
// hand-written .rotate-45 override, which removes both a script and a
// Tailwind-utility name collision.
//
// MHEEPOOH168 palette: card-red panels (#540202) inside mid-gold hairlines
// (#f5b70a), a bright-red rail and `>_` marker (#c4161c), and the open state lit
// with the gold glow while the toggle glyph flips to bright gold (#fced74). The
// previous brand's standalone red-on-rose is gone — this brand is gold on red.
const { title, as: TitleTag = "p", faqs = [] } = Astro.props;
const sectionLabel = title ?? "คำถามที่พบบ่อย";
---

<section aria-label={sectionLabel} class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {
    title && (
      <div
        class="mb-8 flex items-center gap-3 border-l-4 border-[#f5b70a] bg-gradient-to-r from-[#8f0505] via-[#540202]/60 to-transparent px-4 py-2.5"
        style="clip-path: polygon(0 0, 100% 0, calc(100% - 15px) 100%, 0 100%);">
        <TitleTag class="text-xl leading-normal font-black tracking-widest text-[#fced74] uppercase md:text-2xl">{title}</TitleTag>
      </div>
    )
  }

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details
          name="faq-terminal"
          class="faq-item group relative overflow-hidden border border-[#f5b70a]/50 bg-[#540202]/92 backdrop-blur-sm transition-all duration-300 hover:border-[#fced74]/60 hover:shadow-[0_15px_40px_rgba(245,183,10,0.24)]"
          style="clip-path: polygon(15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%, 0 15px);">
          <div aria-hidden="true" class="absolute top-0 left-0 h-[2px] w-16 bg-gradient-to-r from-[#fced74] to-transparent" />

          <summary class="flex w-full cursor-pointer items-center justify-between p-5 text-left transition-all">
            <span class="flex items-center gap-2 text-base font-bold text-[#f1dccd] transition-colors group-hover:text-[#fced74] md:text-lg">
              <span aria-hidden="true" class="font-mono text-[#c4161c]">
                &gt;_
              </span>
              {faq.q}
            </span>

            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center border border-[#f5b70a]/40 bg-[#2b0101] text-lg font-black text-[#f1dccd] transition-all duration-300 group-hover:border-[#fced74]/70 group-hover:text-[#fced74]"
              style="clip-path: polygon(25% 0, 100% 0, 100% 75%, 75% 100%, 0 100%, 0 25%);">
              +
            </span>
          </summary>

          <div class="faq-answer border-t border-[#f5b70a]/45 p-5 pt-4 text-left text-base leading-relaxed text-[#f1dccd]">{faq.a}</div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(252, 237, 116, 0.6);
    box-shadow: 0 15px 40px rgba(245, 183, 10, 0.24);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #f5b70a;
    color: #fced74;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
