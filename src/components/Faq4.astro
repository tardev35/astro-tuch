---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The docx's own level for this section. This brief marks
   *  "คำถามที่พบบ่อยเกี่ยวกับ KINGKONG555" as an H2, so index.astro passes
   *  as="h2". It defaults to <p> so a page that hangs a chrome FAQ here stays
   *  out of the heading inventory. */
  as?: "h2" | "h3" | "p";
  faqs?: FaqItem[];
}

// No defaults for `faqs` beyond an empty list — a stale default here would ship
// a previous brand's questions. The page passes both props.
//
// The questions themselves stay <span> inside <summary>: they are accordion
// controls, not docx headings, and the rendered heading inventory is diffed
// against the brief on every rebrand. The <section> keeps its aria-label either
// way, so nothing is lost for assistive tech.
//
// <details name="faq-kingkong555"> keeps a single panel open at a time with no
// script, and the open state is keyed off [open] in the stylesheet rather than a
// hand-written .rotate-45 override. No <script> in this file.
//
// KINGKONG555 (รอบเขียวป่า-ทองมงกุฎ 2026-10-09, brand-spec §2):
// โลโก้แบรนด์นี้เป็นสองฮิวจริง — คำว่า KINGKONG เขียวมะนาว #8ce023 กับมงกุฎทอง #f2c230
// บนหัวกอริลลา แผงคำถามเป็นส่วนที่ต้องอ่านยาว จึงเดินโครงด้วยเขียวเป็นหลักเพื่อไม่ให้
// ลายตา แล้วปล่อยทองมาเป็นจุดเน้นเฉพาะที่ — ผิวการ์ดกลาง #0f2e05 ในกรอบเขียวลึก
// #1a5c04 เส้นไรผมมุมบนซ้ายกับสถานะเปิดเป็นเขียวสด #5cc211 หัวข้อ (ที่หน้าเพจส่งมาเป็น
// prop) ไล่เขียวมะนาว #8ce023 → ทองสว่าง #ffe066 → ทองมงกุฎ #f2c230 ซึ่งเป็นคู่
// "เขียวนำ ทองตาม" แบบเดียวกับที่ตาอ่านโลโก้จากมวลสีมากไปน้อย และเป็นลำดับไล่เฉดที่
// ไม่ซ้ำกับกล่องอื่นบนหน้าเดียวกัน มาร์กนำหน้าคำถามเป็นทองมงกุฎ แผ่นป้ายหัวข้อไล่จาก
// ผิวยก #14380a ลงไปใส ส่วนกล่อง + ตกลงไปที่ผิวลึกสุด #051400 คำถามที่ hover ขึ้นเป็น
// เขียวอ่อน #bde397 เนื้อความใช้ #e9f7d6 (BRAND_TEXT) — 14.6:1 บนผิวกลาง
//
// ชุดฟ้าสด-เหลืองมะนาวของ แตกดี168 ที่เคยค้างในไฟล์นี้ (#0193fb #7bcffb #fce604
// #fff48a #064a86 #0a1726 #07111d #020609 #dbeafe rgba(1,147,251,α)) และชุดทอง-เงิน
// ของ UOK365 ก่อนหน้านั้น (#c8912f #6d4412 #f5d98a #d8dbe0 #191108 #120c07 #070504
// #ece1cc) ออกครบทุกจุดแล้ว พร้อมกับชื่อ details group ของรอบนั้น
const { title, as: TitleTag = "p", faqs = [] } = Astro.props;
const sectionLabel = title ?? "คำถามที่พบบ่อย";
---

<section aria-label={sectionLabel} class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {
    title && (
      <div
        class="mb-8 flex items-center gap-3 border-l-4 border-[#5cc211] bg-gradient-to-r from-[#14380a] via-[#0f2e05]/60 to-transparent px-4 py-2.5"
        style="clip-path: polygon(0 0, 100% 0, calc(100% - 15px) 100%, 0 100%);">
        <TitleTag class="bg-gradient-to-r from-[#8ce023] via-[#ffe066] to-[#f2c230] bg-clip-text text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-2xl">
          {title}
        </TitleTag>
      </div>
    )
  }

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details
          name="faq-kingkong555"
          class="faq-item group relative overflow-hidden border border-[#1a5c04] bg-[#0f2e05]/92 backdrop-blur-sm transition-all duration-300 hover:border-[#5cc211]/75 hover:shadow-[0_15px_40px_rgba(140,224,35,0.26)]"
          style="clip-path: polygon(15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%, 0 15px);">
          <div aria-hidden="true" class="absolute top-0 left-0 h-[2px] w-16 bg-gradient-to-r from-[#5cc211] to-transparent" />

          <summary class="flex w-full cursor-pointer items-center justify-between p-5 text-left transition-all">
            <span class="flex items-center gap-2.5 text-base font-bold text-[#e9f7d6] transition-colors group-hover:text-[#bde397] md:text-lg">
              <span aria-hidden="true" class="text-xs text-[#f2c230]">
                ❖
              </span>
              {faq.q}
            </span>

            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center border border-[#1a5c04] bg-[#051400] text-lg font-black text-[#e9f7d6] transition-all duration-300 group-hover:border-[#5cc211]/85 group-hover:text-[#bde397]"
              style="clip-path: polygon(25% 0, 100% 0, 100% 75%, 75% 100%, 0 100%, 0 25%);">
              +
            </span>
          </summary>

          <div class="faq-answer border-t border-[#1a5c04] p-5 pt-4 text-left text-base leading-relaxed text-[#e9f7d6]">{faq.a}</div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(140, 224, 35, 0.75);
    box-shadow: 0 15px 40px rgba(140, 224, 35, 0.26);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #5cc211;
    color: #f2c230;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
