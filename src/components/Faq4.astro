---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The docx's own level for this section. This brief marks
   *  "คำถามที่พบบ่อยเกี่ยวกับ<แบรนด์>" as an H2, so index.astro passes as="h2".
   *  It defaults to <p> so a page that hangs a chrome FAQ here stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  faqs?: FaqItem[];
}

// No defaults for `faqs` beyond an empty list — a stale default here would ship
// a previous brand's questions. The page passes both props, and the SAME array
// goes to pageGraph({ faqs }).
//
// The questions themselves stay <span> inside <summary>: they are accordion
// controls, not docx headings, and the rendered heading inventory is diffed
// against the brief on every rebrand. The <section> keeps its aria-label either
// way, so nothing is lost for assistive tech.
//
// <details name="faq-somwang168"> keeps a single panel open at a time with no
// script, and the open state is keyed off [open] in the stylesheet rather than a
// hand-written .rotate-45 override. No <script> in this file. The group name is
// rebranded with everything else — leaving a previous brand's slug in a `name`
// attribute is the quietest way to ship its fingerprint.
//
// สมหวัง168 (รอบแดงมังกร-ทองไทย 2026-10-17, brand-spec §2):
// รอบนี้เป็น **สองโทนจริง: แดงมังกรนำ ทองไทยรอง ไม่มีโครเมียม/เงิน ไม่มีม่วง
// ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว ไม่มีส้ม ไม่มีชมพู** โลโก้คือคำว่า "สมหวัง"
// ตัวอักษรสามมิติโครเมียมขาวอมเงินขอบแดง ต่อด้วยเลข "168" แดงสดตัวหนา มีเปลวไฟแดง
// และลายกนกไทยสีแดงพันรอบ — สีรองของระบบดึงมาจาก **ลายกนก/นาคทอง** ในแบนเนอร์
// ไม่ใช่จากโครเมียมในโลโก้
// ⚠️ พื้นเพจเป็น **ดำอมแดง #290f0f** (bg.json) ลำดับความลึก: #2c1413 ยก / #1f0d0c
// กลาง / #140706 จม / #290f0f พื้น — ผิวจมกับผิวกลางมืดกว่าพื้นเพจ
//
// ใบนี้ถือ docx H2 §8 และเป็นบล็อกเนื้อหาสุดท้ายของหน้า อยู่ถัดจาก
// ContentBoxTwoFloatingBadge (§7) ที่เป็น **การ์ดใบเดียวมุม 2xl ไล่ผิวกลางขึ้นผิวยก
// พร้อมป้ายทองทึบลอยอยู่** — ที่นี่จึงเป็น **แถวมุมกลมหลายแถวบนผิวจม #140706**
// ไม่ใช่การ์ดใบเดียว ไม่มีป้ายลอย และไม่มี clip-path ที่ไหนในไฟล์นี้เลย
// แผ่นป้ายหัวข้อเป็นมุมกลมพร้อมรางซ้ายทองไทย #e3b23c หนาสี่พิกเซล ไล่พื้นจากผิวยก
// #2c1413 ลงไปใส
// หัวข้อ (ที่หน้าเพจส่งมาเป็น prop) ไล่ แดงสว่าง #ff5a5f → ทองไทย #e3b23c → ทอง
// สว่าง #ffe5a8 ("แดงไล่ขึ้นทอง") ซึ่งเป็นลำดับที่ไม่ซ้ำกับอีกเจ็ดกล่องบนหน้าเดียวกัน
// มาร์ก ❖ นำหน้าคำถามเป็นทองไทย #e3b23c (8.9:1) กรอบแถวเป็นแดงเกือบดำ #5b0203
// เส้นไรผมมุมบนซ้ายเป็นแดงแบรนด์ #fa0513 กล่อง + นั่งบนผิวยก #2c1413 คำถามที่ hover
// และสถานะเปิดขึ้นเป็นแดงสว่าง #ff5a5f เนื้อความ #f4ecea (= BRAND_TEXT) ตัวรอง
// ถ้ามีจะเป็น #ccb9b6
// §2 ห้าม #fa0513 #b90203 #8c0204 #5b0203 #3c0303 #8a6210 ถือตัวอักษรทุกขนาด —
// ในไฟล์นี้ทั้งหกค่าอยู่ที่ราง ขอบ เส้นไรผม และออราเท่านั้น ไม่มีจุดไหนให้มันถือ
// glyph และ #ffadaf สงวนไว้ให้ <strong> ในเนื้อความ จึงไม่อยู่ในไฟล์นี้
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — ไฟล์นี้เพิ่งถือชุดน้ำเงินไฟฟ้า-เงิน
// โครเมียมของ TSDET911 มาทั้งไฟล์ (#0360f3 #0292fb #6ec8ff #4fb4ff #cfdcec #9db4d4
// #dde8f7 #102a5e #0a1c42 #040e26 #00081f #032dad #04186e #041a43) และก่อนนั้นเป็น
// ชุดทองอำพันเสือและชุดทองเป็ด-ส้มปากเป็ด — ถอดออกครบทุกค่า รวมถึงชื่อ details group
// ของแบรนด์ก่อน
// ⚠️ **กับดักรอบนี้คือแดง** สองแบรนด์ก่อนหน้าก็เป็นแดงทั้งคู่: GT66B #fb141b (G=20)
// และ TKB55 #fb131b (G=19) ส่วนแดงรอบนี้คือ #fa0513 (R=250 G=5 B=19) อ่านมาจาก
// palette.json ของดรอปนี้ตรงๆ และแดงของ SUPERSLOTCLUB #e8232a · PIGPG #d4200d ·
// FLASH877 #ff3b14 ที่ค้างในไฟล์ inventory ก็ไม่ใช่ค่านี้สักตัว
// ⚠️ ทองรอบนี้ #e3b23c / #ffe5a8 / #8a6210 ไม่ใช่ #dfa310 / #ffe4a3 / #8a5c09 ของ
// TND168 และไม่ใช่ #e5a81b / #ffe08a / #7d5a07 ของ UFA324 — เทียบเป็นตัวเลขทีละค่า
const { title, as: TitleTag = "p", faqs = [] } = Astro.props;
const sectionLabel = title ?? "คำถามที่พบบ่อย";
---

<section aria-label={sectionLabel} class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {
    title && (
      <div class="mb-8 flex items-center gap-3 rounded-2xl border-l-4 border-[#e3b23c] bg-gradient-to-r from-[#2c1413] via-[#140706]/60 to-transparent px-4 py-2.5">
        <TitleTag class="bg-gradient-to-r from-[#ff5a5f] via-[#e3b23c] to-[#ffe5a8] bg-clip-text text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-2xl">
          {title}
        </TitleTag>
      </div>
    )
  }

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details
          name="faq-somwang168"
          class="faq-item group relative overflow-hidden rounded-2xl border border-[#5b0203] bg-[#140706]/95 backdrop-blur-sm transition-all duration-300 hover:border-[#e3b23c]/75 hover:shadow-[0_15px_40px_rgba(250,5,19,0.26)]">
          <div aria-hidden="true" class="absolute top-0 left-0 h-[2px] w-16 bg-gradient-to-r from-[#fa0513] to-transparent" />

          <summary class="flex w-full cursor-pointer items-center justify-between p-5 text-left transition-all">
            <span class="flex items-center gap-2.5 text-base font-bold text-[#f4ecea] transition-colors group-hover:text-[#ff5a5f] md:text-lg">
              <span aria-hidden="true" class="text-xs text-[#e3b23c]">
                ❖
              </span>
              {faq.q}
            </span>

            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#8a6210] bg-[#2c1413] text-lg font-black text-[#f4ecea] transition-all duration-300 group-hover:border-[#e3b23c] group-hover:text-[#ff5a5f]">
              +
            </span>
          </summary>

          <div class="faq-answer border-t border-[#5b0203] p-5 pt-4 text-left text-base leading-relaxed text-[#f4ecea]">{faq.a}</div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(227, 178, 60, 0.75);
    box-shadow: 0 15px 40px rgba(250, 5, 19, 0.26);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #e3b23c;
    color: #ff5a5f;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
