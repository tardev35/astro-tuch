---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The docx's own level for this section. หวยเต็ง's brief marks
   *  "คำถามที่พบบ่อยเกี่ยวกับ หวยเต็ง" as an H2, so index.astro passes as="h2".
   *  It defaults to <p> so a page that hangs a chrome FAQ here stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  faqs?: FaqItem[];
}

// No defaults for `faqs` beyond an empty list — a stale default here would ship
// a previous brand's questions. The page passes both props.
//
// The questions themselves stay <span> inside <summary>: they are accordion
// controls, not docx headings, and the rendered heading inventory is diffed
// against the brief on every rebrand. The <section> keeps its aria-label either
// way, so nothing is lost for assistive tech.
//
// <details name="faq-huayteng"> keeps a single panel open at a time with no
// script, and the open state is keyed off [open] in the stylesheet rather than a
// hand-written .rotate-45 override. No <script> in this file.
//
// หวยเต็ง (รอบเขียวป่า-ทอง 2026-10-01): โลโก้แบรนด์นี้เป็นเวิร์ดมาร์กสองโทน — คำว่า
// "หวย" เป็นเขียวมรกตเงาวาวขอบทอง ส่วน "เต็ง" เป็นทองตัน แผงคำถามจึงเดินสองโทนจริง
// คือผิวการ์ดเขียวเข้ม #062a12 ในกรอบทองลึก #bd8d2d แต่เส้นไรผมมุมบนซ้ายกับสถานะ
// เปิดเป็นเขียวเงิน #a9cfae หัวข้อ (ที่หน้าเพจส่งมาเป็น prop) ไล่ทองอ่อน #fae474 →
// ขาวอมเขียว #eafbe9 → ทองแบรนด์ #e5c04f ตามลำดับสีบนโลโก้ มาร์กนำหน้าคำถามเป็น
// ทองแบรนด์ กล่อง + ตกลงไปที่พื้นเพจ #03150a เนื้อความใช้ #d8ead9 (BRAND_TEXT)
// — ชุดทองเมทัลลิก-โครเมียมของ PKG44 ที่ค้างในไฟล์นี้ (#fdd32a #ffe27a #c8920a
// #f2f4f7 #c2c8d0 #12100a #080602 #2a2110 #4a3a12 #efe6d2 #fff8e1) หายไปทั้งหมด
const { title, as: TitleTag = "p", faqs = [] } = Astro.props;
const sectionLabel = title ?? "คำถามที่พบบ่อย";
---

<section aria-label={sectionLabel} class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {
    title && (
      <div
        class="mb-8 flex items-center gap-3 border-l-4 border-[#e5c04f] bg-gradient-to-r from-[#0b3d18] via-[#062a12]/60 to-transparent px-4 py-2.5"
        style="clip-path: polygon(0 0, 100% 0, calc(100% - 15px) 100%, 0 100%);">
        <TitleTag class="bg-gradient-to-r from-[#fae474] via-[#eafbe9] to-[#e5c04f] bg-clip-text text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-2xl">
          {title}
        </TitleTag>
      </div>
    )
  }

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details
          name="faq-huayteng"
          class="faq-item group relative overflow-hidden border border-[#bd8d2d]/50 bg-[#062a12]/92 backdrop-blur-sm transition-all duration-300 hover:border-[#a9cfae]/55 hover:shadow-[0_15px_40px_rgba(229,192,79,0.35)]"
          style="clip-path: polygon(15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%, 0 15px);">
          <div aria-hidden="true" class="absolute top-0 left-0 h-[2px] w-16 bg-gradient-to-r from-[#a9cfae] to-transparent" />

          <summary class="flex w-full cursor-pointer items-center justify-between p-5 text-left transition-all">
            <span class="flex items-center gap-2.5 text-base font-bold text-[#d8ead9] transition-colors group-hover:text-[#fae474] md:text-lg">
              <span aria-hidden="true" class="text-xs text-[#e5c04f]">
                ◆
              </span>
              {faq.q}
            </span>

            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center border border-[#bd8d2d]/45 bg-[#03150a] text-lg font-black text-[#d8ead9] transition-all duration-300 group-hover:border-[#a9cfae]/70 group-hover:text-[#fae474]"
              style="clip-path: polygon(25% 0, 100% 0, 100% 75%, 75% 100%, 0 100%, 0 25%);">
              +
            </span>
          </summary>

          <div class="faq-answer border-t border-[#024a0f]/60 p-5 pt-4 text-left text-base leading-relaxed text-[#d8ead9]">{faq.a}</div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(169, 207, 174, 0.55);
    box-shadow: 0 15px 40px rgba(229, 192, 79, 0.35);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #e5c04f;
    color: #fae474;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
