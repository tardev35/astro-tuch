---
import { BRAND_NAME } from "../lib/brandProfile";

export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The docx's own level for this section. This brief marks
   *  "คำถามที่พบบ่อยเกี่ยวกับ <แบรนด์>" as an H2, so index.astro passes as="h2".
   *  It defaults to <p> so a page that hangs a chrome FAQ here stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  faqs?: FaqItem[];
}

// No defaults for `faqs` beyond an empty list — a stale default here would ship
// a previous brand's questions. The page passes both props, and the SAME array
// goes to pageGraph({ faqs }).
//
// The questions themselves stay <span> inside <summary>: they are accordion
// controls, not docx headings, and the rendered heading inventory is diffed
// against the brief on every rebrand. The <section> keeps its aria-label either
// way, so nothing is lost for assistive tech.
//
// <details name={groupName}> keeps a single panel open at a time with no script,
// and the open state is keyed off [open] in the stylesheet rather than a
// hand-written .rotate-45 override. **No <script> in this file, and it must
// never go back to a button + max-height.**
// ⚠️ The group name is INTERPOLATED from BRAND_NAME rather than typed, which is
// both the rebrand rule (the brand name is never written into markup) and the
// fix for the failure this attribute has had before: a hardcoded slug is the
// quietest way to leave the previous brand's fingerprint in a live attribute,
// because nothing visible changes when it rots.
//
// ดวงเศรษฐี168 (รอบ **ทองน้ำผึ้งนำ · แดงชาดจีนเป็นฮิวที่สอง · บนดำสนิท**
// 2026-10-20, brand-spec §2): โลโก้คือ **หัวไฉ่ซิงเอี๊ย (เทพเจ้าโชคลาภจีน)
// ยิ้มหัวเราะ สวมหมวกทรงจีนสีแดงขลิบทอง มีลูกปัดทองห้อยสองข้าง** ต่อด้วยคำว่า
// **"ดวงเศรษฐี" ตัวอักษรไทยสามมิติผิวทองมันวาว** และ **เลข "168" สามมิติสีแดงสด
// ขลิบทอง** บนพื้นโปร่งใส
// ⚠️ พื้นเพจเป็น **ดำสนิท #000000** (bg.json) ลำดับความลึก: #4e2120 ยก / #300605
// กลาง / #150303 จม / #000000 พื้น — ไม่มีผิวไหนจมต่ำกว่าพื้นได้
//
// ใบนี้ถือ docx H2 §8 และเป็นบล็อกเนื้อหาสุดท้ายของหน้า อยู่ถัดจาก
// ContentBox3ThreePremium (§7) ที่เป็น **การ์ดใบเดียวสามคอลัมน์บนผิวยก หัวข้อทองทึบ
// กึ่งกลางพร้อมเส้นคาดบน** — ที่นี่จึงเป็น **แถวมุมกลมหลายแถวบนผิวจม #150303**
// ไม่ใช่การ์ดใบเดียว ไม่มีเงานูน และไม่มี clip-path ที่ไหนในไฟล์นี้เลย
// แผ่นป้ายหัวข้อเป็นมุมกลมพร้อมรางซ้าย **แดงชาด #d9212a** หนาสี่พิกเซล ไล่พื้นจาก
// ผิวยก #4e2120 ลงไปใส
// หัวข้อ (ที่หน้าเพจส่งมาเป็น prop) ไล่ ทองน้ำผึ้ง #f0c878 → งาช้าง #fff8d8 →
// ทองน้ำผึ้ง #f0c878 บนแผ่นป้ายรางแดง ซึ่งเป็นคู่ "ไล่เฉด + ราง" ที่ไม่ซ้ำกับอีก
// เจ็ดกล่องบนหน้าเดียวกัน
// ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึงคือพิกเซลของตัวอักษร ทุกสต็อปต้องถือตัวอักษรได้
// ตาม §2 (#f0c878 8.5:1 / #fff8d8 12.6:1 บนผิวยกของแผ่นป้าย)
// มาร์ก ❖ นำหน้าคำถามเป็นทองน้ำผึ้ง #f0c878 (14.2:1 บนผิวจม) กรอบแถวเป็น
// แดงเลือดหมู #8e1a16 เส้นไรผมมุมบนซ้ายเป็นแดงชาด #d9212a กล่อง + นั่งบนผิวยก
// #4e2120 คำถามที่ hover และสถานะเปิดขึ้นเป็นทองน้ำผึ้ง เนื้อความ #fff8d8
// (= BRAND_TEXT)
// §2 ห้าม #d9212a #8e1a16 ถือตัวอักษรทุกขนาด — ในไฟล์นี้ทั้งสองค่าอยู่ที่ราง ขอบ
// เส้นไรผม และกรอบปุ่มเท่านั้น ไม่มีจุดไหนให้มันถือ glyph
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้มีสองชั้น: ทอง และ แดง**
// เพราะทั้งคู่ผ่านรีโปนี้มาแล้วหลายแบรนด์ ทองรอบนี้ #f0c878 ตัวที่ใกล้ที่สุดในรีโป
// คือ **ffdc8c ของรับตัง168 (ระยะ 32)** และ **f6e3b4 ของ ufalion168 รอบก่อน** ·
// แดงรอบนี้ #d9212a **ห่างจาก d30304 ของรับตัง168 และ e4021b ของรวยเทพ168 ไม่มาก**
// ชุดบรอนซ์-ทองอำพันของ ufalion168 ที่เพิ่งออก (d4922c fdfc71 a25b24 8c4312 d39c45
// f6e3b4 33200a 1f1304 0a0601 5a3310 1a1000 กับ rgba 212/146/44, rgba 253/252/113
// และ rgba 162/91/36) ชุดเต็มของมีเฮ168 ที่เพิ่งอยู่ในไฟล์นี้ (fb1b32 ff8f9c 5c0410
// fcd45c 6b4a08 2b0711 1a040a 0c0205 fdeaec 1b0308) ชุดทองจักรพรรดิ-แดงชาดของ
// รวยเทพ168 (f0bb4e ffeccb e4021b d9701a 3b1b0e 260d04 0d0501 5c2a06 fff8ec 2b1400)
// ชุดเต็มของรวยแทร่168 (039cfa 0494f5 c3ebfc 04366b f9a826 704504 e3f2fc 0b2d52
// 071e38 030f1d 031320) ชุดของนินจา168 (32bcfb a9e9ff fef54b 07335f 6b5c10 0c2a3d
// 071a28 030e16 041019 dceefc) ชุดของสบายเบท168 (2f9ff5 a8dcff d6ecff 0b3f78 ffc82e
// 5c4a16 e8f4ff 0e2238 081726 040d16 04121f) ชุดของถอนชัวร์168 (fa63b9 ffb3de ffd84d
// 6d0b3f 6b4708 2a0617 fdeaf5) ชุดของมีโชค168 (fcd434 ffeaa0 f5469f ff8dc6 8c0f52
// 7a5508 1a0612 f6e4ee 24101c 160a12 0b0509) ชุดแดงมังกร-ทองไทยของสมหวัง168 (fa0513
// ffadaf ff5a5f e3b23c ffe5a8 8a6210 b90203 8c0204 5b0203 3c0303 f4ecea ccb9b6
// 2c1413 1f0d0c 140706 290f0f) และชุดน้ำเงินไฟฟ้า-เงินโครเมียมของ TSDET911 (0360f3
// 0292fb 6ec8ff 4fb4ff cfdcec 9db4d4 dde8f7 102a5e 0a1c42 040e26 00081f 032dad
// 04186e 041a43) ถอดออกครบทุกค่า รวมถึงชื่อ details group ของแบรนด์ก่อน
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีฟ้า/น้ำเงิน ม่วง/ไวโอเลต เขียว ส้มสด เงิน/โครเมียม โรสโกลด์
// เหลืองมะนาว ชมพูฟูเชีย และบรอนซ์**
const { title, as: TitleTag = "p", faqs = [] } = Astro.props;
const sectionLabel = title ?? "คำถามที่พบบ่อย";
const groupName = `faq-${BRAND_NAME}`;
---

<section aria-label={sectionLabel} class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {
    title && (
      <div class="mb-8 flex items-center gap-3 rounded-2xl border-l-4 border-[#d9212a] bg-gradient-to-r from-[#4e2120] via-[#150303]/60 to-transparent px-4 py-2.5">
        <TitleTag class="bg-gradient-to-r from-[#f0c878] via-[#fff8d8] to-[#f0c878] bg-clip-text text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-2xl">
          {title}
        </TitleTag>
      </div>
    )
  }

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details
          name={groupName}
          class="faq-item group relative overflow-hidden rounded-2xl border border-[#8e1a16] bg-[#150303]/95 backdrop-blur-sm transition-all duration-300 hover:border-[#f0c878]/75 hover:shadow-[0_15px_40px_rgba(217,33,42,0.26)]">
          <div aria-hidden="true" class="absolute top-0 left-0 h-[2px] w-16 bg-gradient-to-r from-[#d9212a] to-transparent" />

          <summary class="flex w-full cursor-pointer items-center justify-between p-5 text-left transition-all">
            <span class="flex items-center gap-2.5 text-base font-bold text-[#fff8d8] transition-colors group-hover:text-[#f0c878] md:text-lg">
              <span aria-hidden="true" class="text-xs text-[#f0c878]">
                ❖
              </span>
              {faq.q}
            </span>

            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#8e1a16] bg-[#4e2120] text-lg font-black text-[#fff8d8] transition-all duration-300 group-hover:border-[#f0c878] group-hover:text-[#f0c878]">
              +
            </span>
          </summary>

          <div class="faq-answer border-t border-[#8e1a16] p-5 pt-4 text-left text-base leading-relaxed text-[#fff8d8]">{faq.a}</div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(240, 200, 120, 0.75);
    box-shadow: 0 15px 40px rgba(217, 33, 42, 0.26);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #f0c878;
    color: #f0c878;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
