---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The docx's own level for this section. This brief marks
   *  "คำถามที่พบบ่อยเกี่ยวกับ แตกดี168" as an H2, so index.astro passes as="h2".
   *  It defaults to <p> so a page that hangs a chrome FAQ here stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  faqs?: FaqItem[];
}

// No defaults for `faqs` beyond an empty list — a stale default here would ship
// a previous brand's questions. The page passes both props.
//
// The questions themselves stay <span> inside <summary>: they are accordion
// controls, not docx headings, and the rendered heading inventory is diffed
// against the brief on every rebrand. The <section> keeps its aria-label either
// way, so nothing is lost for assistive tech.
//
// <details name="faq-takdee168"> keeps a single panel open at a time with no
// script, and the open state is keyed off [open] in the stylesheet rather than a
// hand-written .rotate-45 override. No <script> in this file.
//
// แตกดี168 (รอบฟ้าสด-เหลืองมะนาวบนกรมท่าเกือบดำ 2026-10-08, brand-spec §2):
// โลโก้แบรนด์นี้เป็นสองฮิวจริง — คำว่า แตกดี เหลืองมะนาว #fce604 วางเหนือเลข 168
// ฟ้าสด #0193fb แผงคำถามเป็นส่วนที่ต้องอ่านยาว จึงเดินโครงด้วยฟ้าเป็นหลักเพื่อไม่ให้
// ลายตา แล้วปล่อยเหลืองมาเป็นจุดเน้นเฉพาะที่ — ผิวการ์ดกลาง #07111d ในกรอบฟ้าเข้ม
// #064a86 เส้นไรผมมุมบนซ้ายกับสถานะเปิดเป็นฟ้าแบรนด์ #0193fb หัวข้อ (ที่หน้าเพจส่ง
// มาเป็น prop) ไล่ฟ้าอ่อน #7bcffb → เหลืองอ่อน #fff48a → เหลืองมะนาว #fce604 ซึ่งเป็น
// คู่ "ฟ้านำ เหลืองตาม" แบบเดียวกับที่ตาอ่านโลโก้จากมวลสีมากไปน้อย มาร์กนำหน้าคำถาม
// เป็นเหลืองมะนาว แผ่นป้ายหัวข้อไล่จากผิวยก #0a1726 ลงไปใส ส่วนกล่อง + ตกลงไปที่
// ผิวลึกสุด #020609 เนื้อความใช้ #dbeafe (BRAND_TEXT) — 15.4:1 บนผิวกลาง
//
// ชุดทอง-เงินของ UOK365 ที่เคยค้างในไฟล์นี้ (#c8912f #6d4412 #f5d98a #d8dbe0
// #191108 #120c07 #070504 #ece1cc rgba(200,145,47,…)) ออกครบทุกจุดแล้ว พร้อมกับ
// ชื่อ details group ของรอบนั้น
const { title, as: TitleTag = "p", faqs = [] } = Astro.props;
const sectionLabel = title ?? "คำถามที่พบบ่อย";
---

<section aria-label={sectionLabel} class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {
    title && (
      <div
        class="mb-8 flex items-center gap-3 border-l-4 border-[#0193fb] bg-gradient-to-r from-[#0a1726] via-[#07111d]/60 to-transparent px-4 py-2.5"
        style="clip-path: polygon(0 0, 100% 0, calc(100% - 15px) 100%, 0 100%);">
        <TitleTag class="bg-gradient-to-r from-[#7bcffb] via-[#fff48a] to-[#fce604] bg-clip-text text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-2xl">
          {title}
        </TitleTag>
      </div>
    )
  }

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details
          name="faq-takdee168"
          class="faq-item group relative overflow-hidden border border-[#064a86] bg-[#07111d]/92 backdrop-blur-sm transition-all duration-300 hover:border-[#0193fb]/75 hover:shadow-[0_15px_40px_rgba(1,147,251,0.26)]"
          style="clip-path: polygon(15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%, 0 15px);">
          <div aria-hidden="true" class="absolute top-0 left-0 h-[2px] w-16 bg-gradient-to-r from-[#0193fb] to-transparent" />

          <summary class="flex w-full cursor-pointer items-center justify-between p-5 text-left transition-all">
            <span class="flex items-center gap-2.5 text-base font-bold text-[#dbeafe] transition-colors group-hover:text-[#7bcffb] md:text-lg">
              <span aria-hidden="true" class="text-xs text-[#fce604]">
                ◆
              </span>
              {faq.q}
            </span>

            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center border border-[#064a86] bg-[#020609] text-lg font-black text-[#dbeafe] transition-all duration-300 group-hover:border-[#0193fb]/85 group-hover:text-[#7bcffb]"
              style="clip-path: polygon(25% 0, 100% 0, 100% 75%, 75% 100%, 0 100%, 0 25%);">
              +
            </span>
          </summary>

          <div class="faq-answer border-t border-[#064a86] p-5 pt-4 text-left text-base leading-relaxed text-[#dbeafe]">{faq.a}</div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(1, 147, 251, 0.75);
    box-shadow: 0 15px 40px rgba(1, 147, 251, 0.26);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #0193fb;
    color: #fce604;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
