---
import { BRAND_NAME } from "../lib/brandProfile";

export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The docx's own level for this section. This brief marks
   *  "คำถามที่พบบ่อยเกี่ยวกับ <แบรนด์>" as an H2, so index.astro passes as="h2".
   *  It defaults to <p> so a page that hangs a chrome FAQ here stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  faqs?: FaqItem[];
}

// No defaults for `faqs` beyond an empty list — a stale default here would ship
// a previous brand's questions. The page passes both props, and the SAME array
// goes to pageGraph({ faqs }).
//
// The questions themselves stay <span> inside <summary>: they are accordion
// controls, not docx headings, and the rendered heading inventory is diffed
// against the brief on every rebrand. brand-spec §4 pins this page at
// h1×1 / h2×5 / h3×2, and BOTH h3 come from the brief's own H3 lines (§4 items
// 4 and 5) — so promoting these questions to h3 would put two tags on the page
// that the brief never asked for. The <section> keeps its aria-label either
// way, so nothing is lost for assistive tech.
//
// <details name={groupName}> keeps a single panel open at a time with no script,
// and the open state is keyed off [open] in the stylesheet rather than a
// hand-written .rotate-45 override. **No <script> in this file, and it must
// never go back to a button + max-height.**
// ⚠️ The group name is INTERPOLATED from BRAND_NAME rather than typed, which is
// both the rebrand rule (the brand name is never written into markup) and the
// fix for the failure this attribute has had before: a hardcoded slug is the
// quietest way to leave the previous brand's fingerprint in a live attribute,
// because nothing visible changes when it rots.
//
// ───────────────────────────────────────────────────────────────────────────
// ABM96 (ดรอป 2026-10-29) — พาเลตตาม .claude/brand-spec-abm96.md §2
// ใบนี้ถือ **docx H2 §8** (content.txt บรรทัด 23, คู่ Q/A อยู่บรรทัด 24–29) และเป็น
// บล็อกเนื้อหาสุดท้ายของหน้า — รอบก่อน (LOTTOPLUS) ใช้ Faq3 จึงหมุนมาที่ไฟล์นี้
//
// อ่านจากอาร์ตเวิร์กจริงของดรอปนี้: **เวิร์ดมาร์กละตินสามมิติตัวอ้วนมน ผิวไล่จาก
// ขาวนวลลงชมพูอ่อน ตัดขอบชมพูเข้มหนาสองชั้น โดยตัว A มีหัวใจชมพูเล็กซ้อนอยู่ใน
// ช่องกลางตัวอักษร** คู่กับ **มาสคอตลูกหมูการ์ตูนหน้ากลมสีชมพู หูตก แก้มแดง ขยิบตา
// เกาะขอบจานวงกลมชมพูขอบขาว** บนฉาก **ผ้าซาตินชมพูนวลพลิ้ว** พร้อม **หัวใจชมพู
// สามมิติผิวมันเงาลอยกระจาย** — กลีฟนำหน้าคำถามจึงเป็น **หัวใจ ♥** ซึ่งเป็นภาษาภาพ
// หลักของดรอปนี้จริง **ไม่ใช่ ✦ ประกายสี่แฉกของ ZANE96 ที่เพิ่งอยู่ในไฟล์นี้**
// ⚠️ **ธีมสว่าง และ §2 จัด FAQ ไว้ใน "โซนเนื้อหา" ไม่ใช่โครม** แถวคำถามจึงเป็น
// **ผิวการ์ด #ffffff** พร้อมหมึก **#3d0a2c** (16.4:1 = BRAND_TEXT)
// ลำดับความลึก: #fcd9ee ยก (แผ่นป้ายหัวข้อ + กล่อง +) / #ffffff การ์ด (แถวคำถาม) /
// #f3a7d3 เส้นบาง / #f8b9f0 พื้นเพจ (bg.json)
// **ห้ามแก้กลับไปเป็นแถวพื้นมืด** — ชุดโครมเข้ม (#440d31 #2b0620 #5e1746 #ffeef8
// #e8c3da) เป็นของ navbar/footer/ticker/Navfoot **ห้ามหลุดเข้ามาในไฟล์นี้** และ
// หมึก #3d0a2c บนผิวมืดคือตัวอักษรที่หายไปเลย
//
// จังหวะรูปทรงของใบนี้ (§8): เป็น **แถวมุมมนหลายแถวที่มีกรอบ ไม่มีการ์ดใบใหญ่ครอบ
// ทั้งบล็อก** ไม่มีเงานูน ไม่มี clip-path ไม่มีออราเบลอ แผ่นป้ายหัวข้อเป็นมุมมน
// พร้อม **รางซ้ายชมพูบานเย็น #a30d63 หนาสี่พิกเซล บนผิวยก #fcd9ee ทึบทั้งแผ่น**
// ⚠️⚠️ **แผ่นป้ายต้องทึบ ห้ามไล่จบที่ transparent** — แผ่นที่ปลายใสคือจุดที่ค่าอ่อน
// ของพาเลต (#f3a7d3 #fcd9ee #f8b9f0) ไหลมาเป็นพื้นของตัวอักษรได้ และสามค่านั้น
// §2 ห้ามถือตัวอักษร
// ⚠️ **หัวข้อใบนี้เป็นชมพูบานเย็น #a30d63 ทึบสีเดียว (5.8:1 บนผิวยก #fcd9ee)
// ไม่ใช่ bg-clip-text ไล่เฉด** — §7 ContentBoxTwoNeumorphism เป็นใบเดียวของหน้าที่
// หัวข้อไล่เฉด **สองใบนี้อยู่ติดกัน จึงต้องแยกกันให้ชัด** และแผ่นป้ายมีรางซ้าย
// ของใบนี้ก็ไม่ซ้ำกับใบไหนบนหน้าเดียวกัน
// 🚨🚨 **#f3a7d3 (1.5:1) #fcd9ee #e0509f (3.6:1) #ff7ac2 ถือตัวอักษรไม่ได้ทุกบริบท**
// ในไฟล์นี้มันจึงอยู่ที่ **กรอบแถว เส้นไรผมมุมบนซ้าย ขอบกล่อง + และแผ่นป้าย**
// ซึ่งเป็นพื้นถม/เส้นล้วน · **#f2c14e ถือตัวอักษรได้เฉพาะบนโครมเข้ม จึงไม่อยู่ใน
// ไฟล์นี้เลยสักจุด**
// กลีฟ ♥ นำหน้าคำถามเป็น **#a30d63** (7.5:1 บนผิวการ์ดขาว) ไม่ใช่ชมพูอ่อน —
// **กลีฟนับเป็นตัวอักษร** และอยู่ใน <span aria-hidden="true"> ของตัวเอง ซึ่งเป็น
// **พี่น้อง** ของข้อความคำถาม ไม่ใช่อักขระในข้อความ
// กรอบแถวเป็น #f3a7d3 อิ่มเป็น #e0509f ตอน hover · เส้นไรผมมุมบนซ้ายเป็น #e0509f ·
// กล่อง + นั่งบนผิวยก #fcd9ee พร้อมหมึก #a30d63 · คำถามที่ hover และสถานะเปิดขึ้น
// เป็น #a30d63 · เนื้อความ #3d0a2c (= BRAND_TEXT)
// rgba() ที่อนุญาตรอบนี้ (§2): rgba(163,13,99,α) · rgba(224,80,159,α) ·
// rgba(255,122,194,α) · rgba(209,26,126,α) · rgba(61,10,44,α)
// **เงาบนการ์ดสว่างต้องเบา**: ปกติ rgba(61,10,44,0.10) · hover rgba(163,13,99,0.18)
//
// ⚠️⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือชมพูเป็นฮิวนำ และ
// ชมพูเคยเป็นฮิวนำของแบรนด์เก่ามาแล้วหลายเจ้า** → **"เจอชมพู ≠ เป็นของรอบนี้"**
// ทุกค่าต้องตรงกับ §2 เป๊ะทั้งหกหลัก คู่ที่ต้องสงสัยว่าพิมพ์ผิดก่อนเสมอ:
//   d91a73 (okkub88) ↔ #d11a7e · 9c0f55 b01160 (okkub88) / a30d1a (123BET) /
//   c2178b (ZANE96) ↔ #a30d63 · fb439b fc4da1 (okkub88) / fa63b9 (ถอนชัวร์168) ↔
//   #e0509f · f9b2d9 (okkub88) / ffb3de (ถอนชัวร์168) ↔ #f3a7d3 ·
//   ffd6fa ffe3f5 (okkub88) / f7dfe4 fdf5f6 f7e4e9 (123BET) / f8e6f9 (ZANE96) ↔
//   #fcd9ee #fff5fb · 6a0f3c (okkub88) / 6d0b3f (ถอนชัวร์168) ↔ #440d31 #3d0a2c ·
//   ffd84d (ถอนชัวร์168) / dca53a (123BET) / e2b32a (LOTTOPLUS) ↔ #f2c14e
// ค่าที่เพิ่งอยู่ทั้งใบนี้และกวาดออกครบแล้ว (**123BET**): a30d1a c21325 8a1420
// 36080f 6b2b33 f7e4e9 fdf5f6 f7dfe4 eec3cc d98fa0 dca53a ef4a5e
// + rgba(163,13,26) rgba(54,8,15)
// 🚨 **LOTTOPLUS เป็นแบรนด์ขาออกทันที (เขียวมรกต/ทองบนผิวสว่าง) จึงเสี่ยงหลงเหลือ
// สูงสุด**: 046c4e 0d3326 3f6f5c 19a97c 2fd49b a3ddc3 d2f3e4 e1fef3 f0fdf7 052e22
// 03201a 0a4433 8a6508 e2b32a c8d4d0 — **เขียวออกจากพาเลตทั้งตระกูล ไม่มีคู่เทียบ**
// **ลิสต์เฮกซ์เต็มของทุกแบรนด์อยู่ที่ .claude/brand-spec-abm96.md §2b — ไม่ซ้ำลง
// ที่นี่โดยตั้งใจ** ลิสต์เดียวที่อัปเดตที่เดียวย่อมไม่หลุดกันเอง
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️⚠️ **รอบนี้ไม่มีม่วง ไม่มีฟ้า/ไซแอน ไม่มีเขียว ไม่มีแดงชาด ไม่มีส้ม และไม่มี
// ครีม/เบจ/พีช** (เขียว #00B900 ของปุ่ม LINE และเขียว success ของฟีดอยู่ไฟล์อื่น
// **คงไว้ ห้ามกลืนเข้าชมพูของรอบนี้**)
const { title, as: TitleTag = "p", faqs = [] } = Astro.props;
const sectionLabel = title ?? "คำถามที่พบบ่อย";
const groupName = `faq-${BRAND_NAME}`;
---

<section aria-label={sectionLabel} class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {
    title && (
      <div class="mb-8 flex items-center gap-3 rounded-2xl border-l-4 border-[#a30d63] bg-[#fcd9ee] px-4 py-2.5 shadow-[0_8px_22px_rgba(61,10,44,0.10)]">
        <TitleTag class="text-xl leading-normal font-black tracking-widest text-[#a30d63] md:text-2xl">{title}</TitleTag>
      </div>
    )
  }

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details
          name={groupName}
          class="faq-item group relative overflow-hidden rounded-2xl border border-[#f3a7d3] bg-[#ffffff] transition-all duration-300 hover:border-[#e0509f] hover:shadow-[0_15px_40px_rgba(163,13,99,0.18)]">
          <div aria-hidden="true" class="absolute top-0 left-0 h-[2px] w-16 bg-gradient-to-r from-[#e0509f] to-transparent" />

          <summary class="flex w-full cursor-pointer items-center justify-between p-5 text-left transition-all">
            <span class="flex items-center gap-2.5 text-base font-bold text-[#3d0a2c] transition-colors group-hover:text-[#a30d63] md:text-lg">
              <span aria-hidden="true" class="text-xs text-[#a30d63]">
                ♥
              </span>
              {faq.q}
            </span>

            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#f3a7d3] bg-[#fcd9ee] text-lg font-black text-[#a30d63] transition-all duration-300 group-hover:border-[#e0509f] group-hover:text-[#7a0449]">
              +
            </span>
          </summary>

          <div class="faq-answer border-t border-[#f3a7d3] p-5 pt-4 text-left text-base leading-relaxed text-[#3d0a2c]">{faq.a}</div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(163, 13, 99, 0.9);
    box-shadow: 0 15px 40px rgba(163, 13, 99, 0.2);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #a30d63;
    color: #7a0449;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
