---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The docx's own level for this section. This brief marks
   *  "คำถามที่พบบ่อยเกี่ยวกับ TIGERWIN369" as an H2, so index.astro passes
   *  as="h2". It defaults to <p> so a page that hangs a chrome FAQ here stays
   *  out of the heading inventory. */
  as?: "h2" | "h3" | "p";
  faqs?: FaqItem[];
}

// No defaults for `faqs` beyond an empty list — a stale default here would ship
// a previous brand's questions. The page passes both props, and the SAME array
// goes to pageGraph({ faqs }).
//
// The questions themselves stay <span> inside <summary>: they are accordion
// controls, not docx headings, and the rendered heading inventory is diffed
// against the brief on every rebrand. The <section> keeps its aria-label either
// way, so nothing is lost for assistive tech.
//
// <details name="faq-tigerwin369"> keeps a single panel open at a time with no
// script, and the open state is keyed off [open] in the stylesheet rather than a
// hand-written .rotate-45 override. No <script> in this file. The group name is
// rebranded with everything else — leaving a previous brand's slug in a `name`
// attribute is the quietest way to ship its fingerprint.
//
// TIGERWIN369 (รอบทองอำพันเสือบนดำสนิท 2026-10-11, brand-spec §2):
// รอบนี้ **ไม่ใช่คู่สองฮิว** — เป็น **ทองล้วนสองระดับ ไม่มีเงิน ไม่มีเทา ไม่มีส้ม
// แยกเป็นฮิวที่สอง** ทองอำพันเสือ #d98324 นำ (ขนหัวเสือและขอบเหรียญตราบนโลโก้) และ
// ทองสว่าง #f7b733 เป็นระดับที่สอง (หน้าตัวอักษร TIGERWIN369 สามมิติ และมงกุฎทอง)
// แผงคำถามเป็นส่วนที่ต้องอ่านยาว จึงเดินโครงด้วยอำพันเป็นเส้น/ขอบ แล้วให้ทองสว่าง
// เป็นจุดเน้นตอน hover/open เท่านั้น เพื่อไม่ให้ลายตา
// ⚠️ พื้นเพจรอบนี้ดำสนิท #000000 ทุกผิวในไฟล์นี้จึงสว่างกว่าพื้น ไม่มีชั้นไหนจม
//
// ใบนี้ถือ docx H2 §8 และเป็นบล็อกเนื้อหาสุดท้ายของหน้า อยู่ถัดจาก
// ContentBoxTwoCyberCut ที่เป็นการ์ดใบเดียวมุมตัดบนผิวกลาง #1c1206 — ที่นี่จึงเป็น
// **แถวมุมกลมหลายแถว** บนผิวจม #0f0903 ไม่ใช่การ์ดใบเดียว และไม่มี clip-path ที่ไหน
// เลยในไฟล์นี้ สองส่วนที่ติดกันจึงต่างกันทั้งรูปทรง จำนวนก้อน ความลึก และหัวข้อ
// แผ่นป้ายหัวข้อเป็นมุมกลมพร้อมรางซ้ายทองอำพันหนาสี่พิกเซล ไล่พื้นจากผิวกลาง #1c1206
// ลงไปใส หัวข้อ (ที่หน้าเพจส่งมาเป็น prop) ไล่ทองสว่าง #f7b733 → ทองอำพัน #d98324 →
// ทองซีด #ffd98a ซึ่งเป็นลำดับ "สว่าง → อำพัน → ซีด" ที่ไม่ซ้ำกับอีกเจ็ดกล่องบนหน้า
// เดียวกันสักใบ
// มาร์ก ❖ นำหน้าคำถามเป็นทองอำพัน กรอบแถวเป็นอำพันลึก #8a5214 เส้นไรผมมุมบนซ้ายเป็น
// ทองอำพัน กล่อง + ตกลงไปที่ผิวกลาง #1c1206 คำถามที่ hover และสถานะเปิดขึ้นเป็นทอง
// สว่าง #f7b733 เนื้อความใช้ #f7e4c0 (BRAND_TEXT) — 16.5:1 บนผิวจม #0f0903
// §2 ห้าม #8a5214 และ #4a2a08 ถือตัวอักษร — ในไฟล์นี้ทั้งคู่อยู่ที่ขอบและเส้นเท่านั้น
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — รอบนี้เป็นทองรอบที่แปดในสิบรอบ: ชุดทองเป็ด-
// ส้มปากเป็ดของ DUCK1688 ที่เคยค้างในไฟล์นี้ (#f3bb34 #fde464 #c8901a #5c3f04 #f58b2a
// #ffc98a #f6ecd9 #1f1709 #171106 #0d0903 พร้อมชื่อ details group faq-duck1688)
// ชุดทองแชมเปี้ยน-เงินโครเมียมของ UFA324 (#e5a81b #b9c2cc #231c0e #17130a #0d0b06
// #f0e8d4 #ffcf5e #ffe08a #7d5a07 #43300a #464f5a) ชุดเขียวป่า-ทองมงกุฎของ KINGKONG555
// (#8ce023 #5cc211 #2f8c07 #1a5c04 #f2c230 #ffe066 #bde397 #e9f7d6 #14380a #0f2e05
// #051400) ชุดทองอวกาศ-เงินโครเมียมของ NAZA168 (#fbc134 #ffe87a #cf9a18 #96690a
// #6b4a05 #cfd6e3 #fdf3df #d9c9a6 #4e3406 #432b03 #382400 #241700) ชุดฟ้าสด-เหลือง
// มะนาวของ แตกดี168 (#0193fb #7bcffb #fce604 #fff48a #064a86 #0a1726 #07111d #dbeafe)
// และชุดทอง-เงินของ UOK365 (#c8912f #6d4412 #f5d98a #d8dbe0 #191108 #120c07 #ece1cc)
// ออกครบทุกจุดแล้ว
// ⚠️ #f58b2a ของ DUCK1688 คือสีที่ใกล้ #d98324 ของรอบนี้ที่สุดในทั้งสิบรอบ (ส้มอำพัน
// ทั้งคู่) แต่ R=245/G=139/B=42 ไม่ใช่ R=217/G=131/B=36 และ #c8912f ของ UOK365 มี
// G=145 ไม่ใช่ 131 — ห้ามกะด้วยตา
// ⚠️ **รอบนี้ไม่มีเงิน/เทา/ฟ้าเลย** #b9c2cc #464f5a #cfd6e3 #d8dbe0 #0193fb ต้องไม่
// เหลืออยู่ในไฟล์นี้
const { title, as: TitleTag = "p", faqs = [] } = Astro.props;
const sectionLabel = title ?? "คำถามที่พบบ่อย";
---

<section aria-label={sectionLabel} class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {
    title && (
      <div class="mb-8 flex items-center gap-3 rounded-2xl border-l-4 border-[#d98324] bg-gradient-to-r from-[#1c1206] via-[#0f0903]/60 to-transparent px-4 py-2.5">
        <TitleTag class="bg-gradient-to-r from-[#f7b733] via-[#d98324] to-[#ffd98a] bg-clip-text text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-2xl">
          {title}
        </TitleTag>
      </div>
    )
  }

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details
          name="faq-tigerwin369"
          class="faq-item group relative overflow-hidden rounded-2xl border border-[#8a5214] bg-[#0f0903]/95 backdrop-blur-sm transition-all duration-300 hover:border-[#d98324]/75 hover:shadow-[0_15px_40px_rgba(217,131,36,0.26)]">
          <div aria-hidden="true" class="absolute top-0 left-0 h-[2px] w-16 bg-gradient-to-r from-[#d98324] to-transparent" />

          <summary class="flex w-full cursor-pointer items-center justify-between p-5 text-left transition-all">
            <span class="flex items-center gap-2.5 text-base font-bold text-[#f7e4c0] transition-colors group-hover:text-[#f7b733] md:text-lg">
              <span aria-hidden="true" class="text-xs text-[#d98324]">
                ❖
              </span>
              {faq.q}
            </span>

            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#8a5214] bg-[#1c1206] text-lg font-black text-[#f7e4c0] transition-all duration-300 group-hover:border-[#d98324]/85 group-hover:text-[#f7b733]">
              +
            </span>
          </summary>

          <div class="faq-answer border-t border-[#8a5214] p-5 pt-4 text-left text-base leading-relaxed text-[#f7e4c0]">{faq.a}</div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(217, 131, 36, 0.75);
    box-shadow: 0 15px 40px rgba(217, 131, 36, 0.26);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #d98324;
    color: #f7b733;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
