---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  faqs?: FaqItem[];
}

// No defaults for `faqs` beyond an empty list — a stale default here would ship
// a previous brand's questions. The page passes both props.
//
// The block title is a <p>, not a heading: the FAQ accordion is chrome and the
// docx marks no heading for it, so the page's heading inventory stays exactly
// the docx's own (h1x1 / h2x4 / h3x1). The <section> takes its accessible name
// from aria-label instead, so nothing is lost for assistive tech.
//
// The open state is keyed off [open] in the stylesheet rather than a
// hand-written .rotate-45 override, which removes both a script and a
// Tailwind-utility name collision.
const { title, faqs = [] } = Astro.props;
const sectionLabel = title ?? "คำถามที่พบบ่อย";
---

<section aria-label={sectionLabel} class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {
    title && (
      <div
        class="mb-8 flex items-center gap-3 border-l-4 border-[#02b961] bg-gradient-to-r from-[#0c2214] via-[#061309]/60 to-transparent px-4 py-2.5"
        style="clip-path: polygon(0 0, 100% 0, calc(100% - 15px) 100%, 0 100%);">
        <p class="text-xl leading-normal font-black tracking-widest text-[#f1faf4] uppercase md:text-2xl">{title}</p>
      </div>
    )
  }

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details
          name="faq-terminal"
          class="faq-item group relative overflow-hidden border border-[#046b3a]/70 bg-[#061309]/92 backdrop-blur-sm transition-all duration-300 hover:border-[#02b961]/60 hover:shadow-[0_15px_40px_rgba(2,185,97,0.22)]"
          style="clip-path: polygon(15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%, 0 15px);">
          <div aria-hidden="true" class="absolute top-0 left-0 h-[2px] w-16 bg-gradient-to-r from-[#4ce68f] to-transparent" />

          <summary class="flex w-full cursor-pointer items-center justify-between p-5 text-left transition-all">
            <span class="flex items-center gap-2 text-base font-bold text-[#d5e6da] transition-colors group-hover:text-[#f1faf4] md:text-lg">
              <span aria-hidden="true" class="font-mono text-[#02b961]">
                &gt;_
              </span>
              {faq.q}
            </span>

            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center border border-[#02b961]/40 bg-[#0c2214] text-lg font-black text-[#4ce68f] transition-all duration-300 group-hover:border-[#02b961]/70 group-hover:text-[#c9f7dd]"
              style="clip-path: polygon(25% 0, 100% 0, 100% 75%, 75% 100%, 0 100%, 0 25%);">
              +
            </span>
          </summary>

          <div class="faq-answer border-t border-[#046b3a]/60 p-5 pt-4 text-left text-base leading-relaxed text-[#d5e6da]">{faq.a}</div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(2, 185, 97, 0.6);
    box-shadow: 0 15px 40px rgba(2, 185, 97, 0.22);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #02b961;
    color: #c9f7dd;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
