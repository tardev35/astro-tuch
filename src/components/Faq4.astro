---
import { BRAND_NAME } from "../lib/brandProfile";

export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The docx's own level for this section. This brief marks
   *  "คำถามที่พบบ่อยเกี่ยวกับ <แบรนด์>" as an H2, so index.astro passes as="h2".
   *  It defaults to <p> so a page that hangs a chrome FAQ here stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  faqs?: FaqItem[];
}

// No defaults for `faqs` beyond an empty list — a stale default here would ship
// a previous brand's questions. The page passes both props, and the SAME array
// goes to pageGraph({ faqs }).
//
// The questions themselves stay <span> inside <summary>: they are accordion
// controls, not docx headings, and the rendered heading inventory is diffed
// against the brief on every rebrand. brand-spec §4 pins this page at
// h1×1 / h2×5 / h3×2, and BOTH h3 come from the brief's own H3 lines (§4 items
// 4 and 5) — so promoting these questions to h3 would put two tags on the page
// that the brief never asked for. The <section> keeps its aria-label either
// way, so nothing is lost for assistive tech.
//
// <details name={groupName}> keeps a single panel open at a time with no script,
// and the open state is keyed off [open] in the stylesheet rather than a
// hand-written .rotate-45 override. **No <script> in this file, and it must
// never go back to a button + max-height.**
// ⚠️ The group name is INTERPOLATED from BRAND_NAME rather than typed, which is
// both the rebrand rule (the brand name is never written into markup) and the
// fix for the failure this attribute has had before: a hardcoded slug is the
// quietest way to leave the previous brand's fingerprint in a live attribute,
// because nothing visible changes when it rots.
//
// ───────────────────────────────────────────────────────────────────────────
// ZANE96 (ดรอป 2026-10-25) — พาเลตตาม .claude/brand-spec-zane96.md §2
// FAQ ที่ใช้งานจริงรอบนี้ — รอบก่อน (MEXICANOSLOT) ใช้ Faq3 จึงหมุนมาที่ไฟล์นี้
// ใบนี้ถือ **docx H2 §8** (content.txt บรรทัด 23, คู่ Q/A อยู่บรรทัด 24–29) และเป็น
// บล็อกเนื้อหาสุดท้ายของหน้า
//
// อ่านจากอาร์ตเวิร์กจริง: เวิร์ดมาร์กสามมิติโครเมียม **"ZANE" ไล่ฟ้าอิเล็กทริก→ม่วง
// และ "96" แมเจนต้า/ชมพูนีออน** บนฉากสตูดิโอขาว-ไลแลค มีตู้สล็อต 777 ม่วงใส
// ชิปแมเจนต้า เชอร์รี่ชมพู เพชรม่วง และลำแสงนีออนทแยง
// ⚠️ **ธีมสว่าง และ §2 จัด FAQ ไว้ใน "โซนเนื้อหา" ไม่ใช่โครม** แถวคำถามจึงเป็น
// **ผิวการ์ดขาว #ffffff** พร้อมหมึก **#241046** (16.8:1 = BRAND_TEXT)
// ลำดับความลึก: #f6edfe ยก / #ffffff การ์ด / #ece0fb wash / #f8e6f9 พื้นเพจ (bg.json)
// **ห้ามแก้กลับไปเป็นแถวพื้นมืด** — ชุดโครมเข้ม (#190b3d #271257 #100626 #5b2f9e
// #f3e8ff #c0a6e8) เป็นของ navbar/footer/ticker/ฟีด **ห้ามหลุดเข้ามาในไฟล์นี้**
// และหมึก #241046 บนผิวมืดคือตัวอักษรที่หายไปเลย
//
// รอบนี้อยู่ถัดจาก ContentBoxSpecial (§7) — ที่นี่จึงเป็น **แถวมุมมนหลายแถวที่มี
// กรอบ ไม่ใช่การ์ดใบเดียว** ไม่มีเงานูน ไม่มี clip-path ไม่มีแผ่นถมทึบทั้งใบ
// แผ่นป้ายหัวข้อเป็นมุมมนพร้อมรางซ้าย **ไวโอเลตนีออน #7a1bd6** หนาสี่พิกเซล บนผิวยก
// #f6edfe **ทึบทั้งแผ่น**
// ⚠️⚠️ **แผ่นป้ายต้องทึบ ห้ามไล่จบที่ transparent** — ถึงหมึก #5411c4 จะได้ 7.8:1
// บนพื้นเพจ #f8e6f9 ก็จริง แต่แผ่นที่ปลายใสคือจุดที่ค่าอ่อนของพาเลต (#dcc6f4
// #ece0fb #f6edfe) ไหลมาเป็นพื้นของตัวอักษรได้ และสามค่านั้น §2 ห้ามถือตัวอักษร
// หัวข้อ (ที่หน้าเพจส่งมาเป็น prop) ไล่ **#5411c4 → #8e14b8 → #c2178b** ซึ่งคือ
// สูตร "CTA หลัก" ของ §2 พอดี
// ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุกสต็อปต้องถือตัวอักษร
// ได้ตาม §2: #5411c4 = 9.3:1 · #8e14b8 = 7.2:1 · #c2178b = 5.6:1 บนขาว — ผ่าน AA
// ทั้งสามแม้คิดเป็น normal text และหัวข้อเป็น text-xl md:text-2xl font-black
// ซึ่งนับเป็น large text อยู่แล้ว
// ⚠️⚠️ **ห้ามลากสต็อปขึ้นไปถึง #f23bb4 / #bb6dff / #7aa7ff** — §2 ระบุว่าสามค่านั้น
// ถือตัวอักษรบนผิวสว่างไม่ได้ (3.5 / 3.1 / ต่ำกว่า) ในไฟล์นี้มันจึงอยู่ที่
// **รางซ้าย เส้นไรผม กรอบแถว และขอบปุ่ม** ซึ่งเป็นพื้นถม/เส้นล้วน และ #9a6fd0
// ก็เป็น **เส้น/ขอบเท่านั้น** ตาม §2
// กลีฟ ✦ นำหน้าคำถามเป็น **#5411c4** (9.3:1 บนการ์ดขาว) ไม่ใช่ไวโอเลตอ่อน —
// กลีฟนับเป็นตัวอักษร · กรอบแถวเป็น #dcc6f4 อิ่มเป็น #bb6dff ตอน hover ·
// เส้นไรผมมุมบนซ้ายเป็น #bb6dff · กล่อง + นั่งบนผิวยก #f6edfe พร้อมหมึก #5411c4 ·
// คำถามที่ hover และสถานะเปิดขึ้นเป็น #5411c4 · เนื้อความ #241046 (= BRAND_TEXT)
// rgba() ที่อนุญาตรอบนี้ (§2): rgba(122,27,214,α) · rgba(84,17,196,α) ·
// rgba(187,109,255,α) · rgba(220,198,244,α) · rgba(36,16,70,α)
//
// ⚠️⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คืออาร์ตเวิร์กคร่อม
// ฟ้า→ม่วง→แมเจนต้า พร้อมกัน ซึ่งเป็นฮิวนำของสามแบรนด์ก่อนหน้าพอดี** (ฟ้า =
// โบ๊ะบ๊ะ168 · ชมพู/แมเจนต้า = okkub88 · ม่วง = KMD88) → **"เจอฟ้า/ชมพู/ม่วง ≠
// เป็นของรอบนี้"** ทุกค่าต้องตรงกับ §2 เป๊ะทั้งหกหลัก
// ค่าที่ต้องไม่เหลือในไฟล์นี้:
//   **โบ๊ะบ๊ะ168 (ชุดที่เพิ่งอยู่ทั้งใบนี้)** — 00bfff 12b4ef b6e3f0 7fcbe8 4fb8ea
//     06283f 0b4a73 2a87c4 eaf7ff f0faff e4f6fb 355f7d 0f5684 1a6ea8
//   **MEXICANOSLOT (แบรนด์ขาออก — เสี่ยงหลงเหลือสูงสุด)** — de2b1e f2a033 a81410
//     c81e12 9d140c 6f0e08 3f130d 80453a 2b100a 431a10 1d0a06 8c3a22 fdeee2 e8c6ae
//     fed7b5 fec28d f6c4a4 e2855c fde4d3 fff3ea fef6fb f2543f
//   **okkub88** — ffd6fa fff4fb ffe3f5 f9b2d9 f479b9 6a0f3c 95486b 9c0f55 fb439b
//     fc74b5 ffc2e2 d91a73 b01160 85094a
//     ⚠️⚠️ **d91a73 ↔ #c2178b** และ **fb439b / fc4da1 ↔ #f23bb4** · **9c0f55 /
//     85094a ↔ #5411c4** — เจอค่าพวกนี้ให้สงสัยว่า "พิมพ์ผิด" ก่อนเสมอ
//   **KMD88** — 7505cc b453ff c07cff d9b8ff 3a0565
//     ⚠️⚠️ **b453ff ↔ #bb6dff** และ **7505cc ↔ #7a1bd6** — คู่ที่ใกล้ที่สุดในรีโป
//   **CEO66** — 7e22ce d946ef a855f7 · **cyber-neon/dark defaults** — 00f3ff
//     e0ffff 60a5fa 4b5563 030712 1f2937 (⚠️ **60a5fa ↔ #7aa7ff**)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️⚠️ **รอบนี้ไม่มีแดงเลยสักเฉด ไม่มีทอง/เหลือง/ส้ม ไม่มีเขียว ไม่มีครีม/เบจ/พีช
// และไม่มีแรมป์เทาเงิน** (เขียว #00B900 ของปุ่ม LINE และเขียว success ของฟีดถอนเงิน
// อยู่ไฟล์อื่น คงไว้)
const { title, as: TitleTag = "p", faqs = [] } = Astro.props;
const sectionLabel = title ?? "คำถามที่พบบ่อย";
const groupName = `faq-${BRAND_NAME}`;
---

<section aria-label={sectionLabel} class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {
    title && (
      <div class="mb-8 flex items-center gap-3 rounded-2xl border-l-4 border-[#7a1bd6] bg-[#f6edfe] px-4 py-2.5 shadow-[0_8px_22px_rgba(84,17,196,0.12)]">
        <TitleTag class="bg-gradient-to-r from-[#5411c4] via-[#8e14b8] to-[#c2178b] bg-clip-text text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-2xl">
          {title}
        </TitleTag>
      </div>
    )
  }

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details
          name={groupName}
          class="faq-item group relative overflow-hidden rounded-2xl border border-[#dcc6f4] bg-white transition-all duration-300 hover:border-[#bb6dff] hover:shadow-[0_15px_40px_rgba(187,109,255,0.22)]">
          <div aria-hidden="true" class="absolute top-0 left-0 h-[2px] w-16 bg-gradient-to-r from-[#bb6dff] to-transparent" />

          <summary class="flex w-full cursor-pointer items-center justify-between p-5 text-left transition-all">
            <span class="flex items-center gap-2.5 text-base font-bold text-[#241046] transition-colors group-hover:text-[#5411c4] md:text-lg">
              <span aria-hidden="true" class="text-xs text-[#5411c4]">
                ✦
              </span>
              {faq.q}
            </span>

            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#dcc6f4] bg-[#f6edfe] text-lg font-black text-[#5411c4] transition-all duration-300 group-hover:border-[#bb6dff] group-hover:text-[#7a1bd6]">
              +
            </span>
          </summary>

          <div class="faq-answer border-t border-[#dcc6f4] p-5 pt-4 text-left text-base leading-relaxed text-[#241046]">{faq.a}</div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(122, 27, 214, 0.9);
    box-shadow: 0 15px 40px rgba(122, 27, 214, 0.2);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #7a1bd6;
    color: #5411c4;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
