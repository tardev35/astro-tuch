---
import { BRAND_NAME } from "../lib/brandProfile";

export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The docx's own level for this section. This brief marks
   *  "คำถามที่พบบ่อยเกี่ยวกับ <แบรนด์>" as an H2, so index.astro passes as="h2".
   *  It defaults to <p> so a page that hangs a chrome FAQ here stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  faqs?: FaqItem[];
}

// No defaults for `faqs` beyond an empty list — a stale default here would ship
// a previous brand's questions. The page passes both props, and the SAME array
// goes to pageGraph({ faqs }).
//
// The questions themselves stay <span> inside <summary>: they are accordion
// controls, not docx headings, and the rendered heading inventory is diffed
// against the brief on every rebrand. The <section> keeps its aria-label either
// way, so nothing is lost for assistive tech.
//
// <details name={groupName}> keeps a single panel open at a time with no script,
// and the open state is keyed off [open] in the stylesheet rather than a
// hand-written .rotate-45 override. **No <script> in this file, and it must
// never go back to a button + max-height.**
// ⚠️ The group name is INTERPOLATED from BRAND_NAME rather than typed, which is
// both the rebrand rule (the brand name is never written into markup) and the
// fix for the failure this attribute has had before: a hardcoded slug is the
// quietest way to leave the previous brand's fingerprint in a live attribute,
// because nothing visible changes when it rots.
//
// โปรดี168 (รอบ **แดงเชอร์รี่นำ · ทองแดงไหม้รอง · ธีมสว่าง** 2026-10-22,
// .claude/brand-spec-prodeee168.md §2–§3): FAQ ที่ใช้งานจริงรอบนี้ — รอบก่อน
// (รวยแท้168) ใช้ Faq3 จึงหมุนมาที่ไฟล์นี้
// อ่านจากอาร์ตเวิร์กจริง: โลโก้เป็น **กระต่ายการ์ตูนขนขาวผูกผ้าพันคอแดงยกนิ้วโป้ง
// ขยิบตา** ข้างคำว่า **"โปรดี168" ตัวอักษรไทยสามมิติผิวมันวาวสีแดงเชอร์รี่ ขอบขาว**
// ⚠️ **ธีมสว่าง และนี่คือจุดที่ไฟล์นี้พลิกมากที่สุด**: bg.json = #ffd1d1 ชมพู
// พาสเทล และ §2 จัด FAQ ไว้ใน **โซนเนื้อหา ไม่ใช่โครม** แถวคำถามจึงเป็น
// **ผิวยก #ffffff** พร้อมหมึก **น้ำตาลแดง #401107** (16.1:1) ไม่ใช่แถวเข้มลอยบน
// พื้นดำอย่างทุกรอบก่อนหน้า ลำดับความลึก: #ffffff ยก / #fff4ea อินเซ็ต /
// #ffd1d1 พื้นเพจ
//
// ใบนี้ถือ docx H2 §8 และเป็นบล็อกเนื้อหาสุดท้ายของหน้า อยู่ถัดจาก
// ContentBoxTwoFloatingBadge (§7) ที่เป็น **การ์ดใบเดียวมีป้ายลอยแคปซูลทองแดง** —
// ที่นี่จึงเป็น **แถวมุมกลมหลายแถว ไม่ใช่การ์ดใบเดียว** ไม่มีป้ายลอย ไม่มี clip-path
// และไม่มีเงานูนที่ไหนในไฟล์นี้เลย
// แผ่นป้ายหัวข้อเป็นมุมกลมพร้อมรางซ้าย **แดงเชอร์รี่ #eb0305** หนาสี่พิกเซล ไล่พื้น
// จากผิวอินเซ็ต #fff4ea ลงไปใส
// หัวข้อ (ที่หน้าเพจส่งมาเป็น prop) ไล่ ทองแดงไหม้ #b44c06 → แดงเชอร์รี่ #eb0305 →
// ทองแดงไหม้ #b44c06 ซึ่งเป็นลำดับที่ **กลับทางกับ ContentBox3ThreeCyberCut (§2)**
// ที่ไล่ #eb0305 → #b44c06 → #7a2f03 จึงไม่อ่านซ้ำกัน
// ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุกสต็อปต้องถือตัวอักษร
// ได้ตาม §2 (#b44c06 4.9:1 · #eb0305 4.3:1 บนผิวอินเซ็ต · และ 3.8:1 / 3.4:1 บนพื้น
// เพจที่ปลายไล่เฉดของแผ่นป้ายใส) หัวข้อเป็น text-xl md:text-2xl font-black จึงนับ
// เป็น **large text** ทุกแบนด์ เกณฑ์คือ 3:1 ผ่านทั้งหมด
// มาร์ก ❖ นำหน้าคำถามเป็นทองแดงไหม้ #b44c06 (5.3:1 บนผิวยก) กรอบแถวเป็นทองแดงไหม้
// โปร่ง เส้นไรผมมุมบนซ้ายเป็นแดงเชอร์รี่ กล่อง + นั่งบนผิวอินเซ็ต #fff4ea พร้อมหมึก
// ทองแดงเข้ม #7a2f03 คำถามที่ hover และสถานะเปิดขึ้นเป็นแดงเชอร์รี่ เนื้อความ
// #401107 (= BRAND_TEXT)
// ⚠️ §2 ห้าม **แดงสด #ff4446** ถือตัวอักษรและห้ามเป็นพื้นของตัวอักษร — ไฟล์นี้จึง
// **ไม่มี #ff4446 เลยสักจุด** เพราะทุกชั้นที่นี่มีตัวอักษรอยู่ · **ทองสาลี่ #f0b46a
// ก็ไม่มี** เพราะเป็นสีของโครมเท่านั้น (1.8:1 บนผิวสว่าง) · **#9b0a0c สงวนไว้ให้
// <strong> ในย่อหน้าของหน้าเพจ** จึงไม่โผล่ที่นี่
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้มีสองชั้น: แดง และ ทอง**
// เพราะทั้งคู่ผ่านรีโปนี้มาแล้วหลายแบรนด์ และ **รอบก่อนหน้าทันทีก็เป็นแดง+ทอง+ธีม
// สว่างชมพูเหมือนกัน** แดงรอบนี้ **#eb0305 (R235 G3 B5)** วัดจาก logo.webp เอง
// ตัวที่ใกล้ที่สุดในรีโปคือ **dc0203 ของหวย365 (ห่าง 18)** และ **c30303 ของรอบขาออก
// (ห่าง 40 ที่ R)** · ทองแดงไหม้ **#b44c06 (R180 G76 B6)** วัดจาก banner1.png และ
// ไม่มีแบรนด์ไหนในรีโปนี้เคยใช้
// ชุดทองน้ำผึ้ง-แดงชาดของ **ดวงเศรษฐี168** ที่เพิ่งอยู่ในไฟล์นี้ทั้งใบ (f0c878 fff8d8
// d9212a 8e1a16 4e2120 300605 150303 กับ rgba 240/200/120 α) rgba 217/33/42 α))
// ออกครบทุกค่าแล้ว เช่นเดียวกับชุดแดงคริมสัน-ทองโบราณของรอบขาออก **รวยแท้168**
// (c30303 8f0505 e81313 dcb95f b8862b 96681f 4a0f0f 461212 280b0b ffeee8 fff1ef
// ffdbdb c99a3f) ชุดเขียวมรกตของ **สาธุ168** (0b7d28 0a5f1c 0f9b35 0c3a16 061f0c
// c9cb63 aeb04a 9ba03c d8ffc7 e9fbdd) ชุดบรอนซ์-ทองอำพันของ **ufalion168** (d4922c
// fdfc71 a25b24 8c4312 d39c45 f6e3b4 33200a 1f1304 0a0601 5a3310 1a1000) ชุดเต็มของ
// **มีเฮ168** (fb1b32 ff8f9c 5c0410 fcd45c 6b4a08 2b0711 1a040a 0c0205 fdeaec
// 1b0308) ชุดทองจักรพรรดิ-แดงชาดของ **รวยเทพ168** (f0bb4e ffeccb e4021b d9701a
// 3b1b0e 260d04 0d0501 5c2a06 fff8ec 2b1400) ชุดเต็มของ **รวยแทร่168** (039cfa
// 0494f5 c3ebfc 04366b f9a826 704504 e3f2fc 0b2d52 071e38 030f1d 031320) ชุดของ
// **นินจา168** (32bcfb a9e9ff fef54b 07335f 6b5c10 0c2a3d 071a28 030e16 041019
// dceefc) ชุดของ **สบายเบท168** (2f9ff5 a8dcff d6ecff 0b3f78 ffc82e 5c4a16 e8f4ff
// 0e2238 081726 040d16 04121f) ชุดของ **ถอนชัวร์168** (fa63b9 ffb3de ffd84d 6d0b3f
// 6b4708 2a0617 fdeaf5) ชุดของ **มีโชค168** (fcd434 ffeaa0 f5469f ff8dc6 8c0f52
// 7a5508 1a0612 f6e4ee 24101c 160a12 0b0509) และชุดแดงมังกร-ทองไทยของ **สมหวัง168**
// (fa0513 ffadaf ff5a5f e3b23c ffe5a8 8a6210 b90203 8c0204 5b0203 3c0303 f4ecea
// ccb9b6 2c1413 1f0d0c 140706 290f0f) ถอดออกครบทุกค่า รวมถึงชื่อ details group ของ
// แบรนด์ก่อน
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีฟ้า/น้ำเงิน ม่วง/ไวโอเลต เขียว เงิน/โครเมียม โรสโกลด์
// เหลืองมะนาว ชมพู/ฟูเชีย บรอนซ์ และทองโบราณ**
const { title, as: TitleTag = "p", faqs = [] } = Astro.props;
const sectionLabel = title ?? "คำถามที่พบบ่อย";
const groupName = `faq-${BRAND_NAME}`;
---

<section aria-label={sectionLabel} class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {
    title && (
      <div class="mb-8 flex items-center gap-3 rounded-2xl border-l-4 border-[#eb0305] bg-gradient-to-r from-[#fff4ea] via-[#fff4ea]/60 to-transparent px-4 py-2.5">
        <TitleTag class="bg-gradient-to-r from-[#b44c06] via-[#eb0305] to-[#b44c06] bg-clip-text text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-2xl">
          {title}
        </TitleTag>
      </div>
    )
  }

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details
          name={groupName}
          class="faq-item group relative overflow-hidden rounded-2xl border border-[#b44c06]/45 bg-[#ffffff] transition-all duration-300 hover:border-[#eb0305]/70 hover:shadow-[0_15px_40px_rgba(235,3,5,0.18)]">
          <div aria-hidden="true" class="absolute top-0 left-0 h-[2px] w-16 bg-gradient-to-r from-[#eb0305] to-transparent" />

          <summary class="flex w-full cursor-pointer items-center justify-between p-5 text-left transition-all">
            <span class="flex items-center gap-2.5 text-base font-bold text-[#401107] transition-colors group-hover:text-[#eb0305] md:text-lg">
              <span aria-hidden="true" class="text-xs text-[#b44c06]">
                ❖
              </span>
              {faq.q}
            </span>

            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#b44c06]/55 bg-[#fff4ea] text-lg font-black text-[#7a2f03] transition-all duration-300 group-hover:border-[#eb0305] group-hover:text-[#eb0305]">
              +
            </span>
          </summary>

          <div class="faq-answer border-t border-[#b44c06]/40 p-5 pt-4 text-left text-base leading-relaxed text-[#401107]">{faq.a}</div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(235, 3, 5, 0.7);
    box-shadow: 0 15px 40px rgba(235, 3, 5, 0.18);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #eb0305;
    color: #eb0305;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
