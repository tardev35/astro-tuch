---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  faqs?: FaqItem[];
}

// No defaults for `faqs` beyond an empty list — a stale default here would ship
// a previous brand's questions. The page passes both props.
const { title, faqs = [] } = Astro.props;
---

<div class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {
    title && (
      <div
        class="mb-8 flex items-center gap-3 border-l-4 border-[#d0a63a] bg-gradient-to-r from-[#062052] via-[#00081f]/60 to-transparent px-4 py-2.5"
        style="clip-path: polygon(0 0, 100% 0, calc(100% - 15px) 100%, 0 100%);">
        <h2 class="text-xl leading-normal font-black tracking-widest text-[#fbeeb8] uppercase md:text-2xl">{title}</h2>
      </div>
    )
  }

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details
          name="faq-terminal"
          class="faq-item group relative overflow-hidden border border-[#7e5f1f]/70 bg-[#031234]/92 backdrop-blur-sm transition-all duration-300 hover:border-[#d0a63a]/60 hover:shadow-[0_15px_40px_rgba(233,197,93,0.22)]"
          style="clip-path: polygon(15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%, 0 15px);">
          <div aria-hidden="true" class="absolute top-0 left-0 h-[2px] w-16 bg-gradient-to-r from-[#d0a63a] to-transparent" />

          <summary class="flex w-full cursor-pointer items-center justify-between p-5 text-left transition-all">
            <span class="flex items-center gap-2 text-base font-bold text-[#dbe4f5] transition-colors group-hover:text-[#fbeeb8] md:text-lg">
              <span aria-hidden="true" class="font-mono text-[#e9c55d]">
                &gt;_
              </span>
              {faq.q}
            </span>

            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center border border-[#e9c55d]/40 bg-[#062052] text-lg font-black text-[#f6da73] transition-all duration-300 group-hover:border-[#e9c55d]/70 group-hover:text-[#fbeeb8]"
              style="clip-path: polygon(25% 0, 100% 0, 100% 75%, 75% 100%, 0 100%, 0 25%);">
              +
            </span>
          </summary>

          <div class="faq-answer border-t border-[#7e5f1f]/60 p-5 pt-4 text-left text-base leading-relaxed text-[#dbe4f5]">{faq.a}</div>
        </details>
      ))
    }
  </div>
</div>

<style>
  /* Keying the open state off [open] instead of a hand-written .rotate-45
     override removes both a script and a Tailwind-utility name collision. */
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(233, 197, 93, 0.6);
    box-shadow: 0 15px 40px rgba(233, 197, 93, 0.22);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #e9c55d;
    color: #fbeeb8;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
