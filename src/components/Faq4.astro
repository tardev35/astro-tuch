---
import { BRAND_NAME } from "../lib/brandProfile";

export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The docx's own level for this section. This brief marks
   *  "คำถามที่พบบ่อยเกี่ยวกับ <แบรนด์>" as an H2, so index.astro passes as="h2".
   *  It defaults to <p> so a page that hangs a chrome FAQ here stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  faqs?: FaqItem[];
}

// No defaults for `faqs` beyond an empty list — a stale default here would ship
// a previous brand's questions. The page passes both props, and the SAME array
// goes to pageGraph({ faqs }).
//
// The questions themselves stay <span> inside <summary>: they are accordion
// controls, not docx headings, and the rendered heading inventory is diffed
// against the brief on every rebrand. brand-spec §4 pins this page at
// h1×1 / h2×5 / h3×2, and BOTH h3 come from the brief's own H3 lines (§4 items
// 4 and 5) — so promoting these questions to h3 would put two tags on the page
// that the brief never asked for. The <section> keeps its aria-label either
// way, so nothing is lost for assistive tech.
//
// <details name={groupName}> keeps a single panel open at a time with no script,
// and the open state is keyed off [open] in the stylesheet rather than a
// hand-written .rotate-45 override. **No <script> in this file, and it must
// never go back to a button + max-height.**
// ⚠️ The group name is INTERPOLATED from BRAND_NAME rather than typed, which is
// both the rebrand rule (the brand name is never written into markup) and the
// fix for the failure this attribute has had before: a hardcoded slug is the
// quietest way to leave the previous brand's fingerprint in a live attribute,
// because nothing visible changes when it rots.
//
// ───────────────────────────────────────────────────────────────────────────
// 123BET (ดรอป 2026-10-28) — พาเลตตาม .claude/brand-spec-123bet.md §2
// FAQ ที่ใช้งานจริงรอบนี้ — รอบก่อน (ZORO365) ใช้ Faq3 จึงหมุนมาที่ไฟล์นี้
// ใบนี้ถือ **docx H2 §8** (content.txt บรรทัด 23, คู่ Q/A อยู่บรรทัด 24–29) และเป็น
// บล็อกเนื้อหาสุดท้ายของหน้า
//
// อ่านจากอาร์ตเวิร์กจริง: เวิร์ดมาร์กสามมิติ **ครึ่งแรกเป็นตัวเลขผิวแดงชาดเคลือบเงา
// ตัดขอบทอง ครึ่งหลังเป็นตัวอักษรละตินผิวโครเมียมเงินขัดเงา** ใต้ **มงกุฎเงิน
// ประดับกำมะหยี่แดงและอัญมณีแดง** บนฉาก **โถงวังหินอ่อนสีงาช้างที่มีเสาและซุ้มโค้ง**
// มีชิปคาสิโนแดง-ขาว ไพ่เอซโพดำ และกรอบทองฉลุ
// ⚠️ **ธีมสว่าง และ §2 จัด FAQ ไว้ใน "โซนเนื้อหา" ไม่ใช่โครม** แถวคำถามจึงเป็น
// **ผิวการ์ด #fdf5f6** พร้อมหมึก **#36080f** (16.3:1 = BRAND_TEXT)
// ลำดับความลึก: #f7dfe4 ยก / #fdf5f6 การ์ด / #eec3cc เส้นบาง / #f7e4e9 พื้นเพจ (bg.json)
// **ห้ามแก้กลับไปเป็นแถวพื้นมืด** — ชุดโครมเข้ม (#330710 #1c050b #4d0c18 #d2d7dd)
// เป็นของ navbar/footer/ticker/ฟีด **ห้ามหลุดเข้ามาในไฟล์นี้** และหมึก #36080f
// บนผิวมืดคือตัวอักษรที่หายไปเลย
//
// รอบนี้อยู่ถัดจาก ContentBoxSpecial (§7) — ที่นี่จึงเป็น **แถวมุมมนหลายแถวที่มี
// กรอบ ไม่ใช่การ์ดใบเดียว** ไม่มีเงานูน ไม่มี clip-path ไม่มีแผ่นถมทึบทั้งใบ
// แผ่นป้ายหัวข้อเป็นมุมมนพร้อมรางซ้าย **แดงชาด #a30d1a** หนาสี่พิกเซล บนผิวยก
// #f7dfe4 **ทึบทั้งแผ่น**
// ⚠️⚠️ **แผ่นป้ายต้องทึบ ห้ามไล่จบที่ transparent** — แผ่นที่ปลายใสคือจุดที่ค่าอ่อน
// ของพาเลต (#eec3cc #d98fa0 #f7e4e9) ไหลมาเป็นพื้นของตัวอักษรได้ และสามค่านั้น
// §2 ห้ามถือตัวอักษร
// หัวข้อ (ที่หน้าเพจส่งมาเป็น prop) ไล่ **#8a1420 → #a30d1a → #c21325** ซึ่งคือ
// สูตร "CTA หลัก" ของ §2 กลับทิศ (เข้มไปอ่อน)
// ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุกสต็อปต้องถือตัวอักษร
// ได้ตาม §2 บนผิวยก #f7dfe4: #8a1420 ≈ 8.8:1 · #a30d1a ≈ 7.0:1 · #c21325 ≈ 5.4:1
// — ผ่าน AA ทั้งสามแม้คิดเป็น normal text และหัวข้อเป็น text-xl md:text-2xl
// font-black ซึ่งนับเป็น large text อยู่แล้ว
// ⚠️⚠️ **ห้ามลากสต็อปสว่างกว่า #c21325** — §2 ระบุไว้ตรง ๆ และ **#eec3cc (1.5:1)
// #d98fa0 (2.3:1) #ef4a5e ถือตัวอักษรไม่ได้ทุกบริบท** ในไฟล์นี้มันจึงอยู่ที่
// **รางซ้าย เส้นไรผม กรอบแถว และขอบปุ่ม** ซึ่งเป็นพื้นถม/เส้นล้วน
// กลีฟ ✦ นำหน้าคำถามเป็น **#a30d1a** (7.4:1 บนผิวการ์ด) ไม่ใช่ชมพูอ่อน —
// กลีฟนับเป็นตัวอักษร · กรอบแถวเป็น #eec3cc อิ่มเป็น #d98fa0 ตอน hover ·
// เส้นไรผมมุมบนซ้ายเป็น #dca53a · กล่อง + นั่งบนผิวยก #f7dfe4 พร้อมหมึก #a30d1a ·
// คำถามที่ hover และสถานะเปิดขึ้นเป็น #a30d1a · เนื้อความ #36080f (= BRAND_TEXT)
// rgba() ที่อนุญาตรอบนี้ (§2): rgba(163,13,26,α) · rgba(220,165,58,α) ·
// rgba(217,143,160,α) · rgba(54,8,15,α)
//
// ⚠️⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือแดงเป็นฮิวนำ และ
// แดงเคยเป็นฮิวนำของแบรนด์เก่ามาแล้วสิบกว่าเจ้า** → **"เจอแดง ≠ เป็นของรอบนี้"**
// ทุกค่าต้องตรงกับ §2 เป๊ะทั้งหกหลัก
// ค่าที่ต้องไม่เหลือในไฟล์นี้:
//   **ZANE96 (ชุดที่เพิ่งอยู่ทั้งใบนี้)** — 7a1bd6 2b3fd9 c2178b f23bb4 bb6dff
//     7aa7ff 5411c4 241046 6b4a86 f8e6f9 f6edfe ece0fb dcc6f4 9a6fd0 190b3d 271257
//     100626 5b2f9e f3e8ff c0a6e8 8e14b8 2f1766 + rgba 122/27/214, rgba 84/17/196,
//     rgba 187/109/255, rgba 220/198/244, rgba 36/16/70
//   **ZORO365 (แบรนด์ขาออกทันที — เสี่ยงหลงเหลือสูงสุด)** — 002908 010d04 031b09
//     073c1a 0e5424 1e7033 35a043 3ddc4a 23823a dfe6e3 e8c86a eef7f0 9dc2a5
//   🚨🚨 **LOTTO189 (ตระกูลสีเดียวกับรอบนี้เป๊ะ)** — fff0f0 ffe4e6 ffd4d7 f5b9bd
//     a8333f 25090f 6e3b44 b00718 c1071b 8a0412 8f6310 d61023 ff2436 e9b53c 24060c
//     3d0d16 120307 7e1221 ffeaea f0bcbc c3ccd6
//     ⚠️⚠️ **c1071b / b00718 ↔ #a30d1a · 7e1221 / 8a0412 ↔ #8a1420 · d61023 ↔
//     #c21325 · 3d0d16 / 24060c ↔ #36080f · e9b53c ↔ #dca53a — เจอค่าซ้ายให้สงสัย
//     ว่าพิมพ์ผิดก่อนเสมอ**
//   **MEXICANOSLOT** — de2b1e f2a033 a81410 c81e12 9d140c 6f0e08 3f130d 80453a
//     2b100a 431a10 1d0a06 8c3a22 fdeee2 e8c6ae fed7b5 fec28d f6c4a4 e2855c fde4d3
//     fff3ea fef6fb f2543f ⚠️ **a81410 ↔ #a30d1a · fef6fb ↔ #fdf5f6**
//   **TEVA69** — f0ffeb ffffff e6f7df d7f0cd b2dba3 3f7a2e 10280f 3c5b36 116018
//     0b4a12 1a7d24 8a6a0e 28c437 e3bb45 c6cfd2
//   **okkub88 / หมูบิน168** — ffd6fa fff4fb ffe3f5 f9b2d9 f479b9 f4a7cf 6a0f3c
//     95486b 9c0f55 fb439b fc74b5 ffc2e2 d91a73 b01160 85094a fa539c c2185b 8e0f41
//     fb8cc0 fdc6c3 ffd1cd f7bcd9 ef8dbd ffe5ff fff0f8 ffeef7 3b0b26
//   **โบ๊ะบ๊ะ168** — 00bfff 12b4ef b6e3f0 7fcbe8 4fb8ea 06283f 0b4a73 2a87c4 eaf7ff
//     f0faff e4f6fb 355f7d 0f5684 1a6ea8
//   **แดงของแบรนด์เก่ากว่านั้น** — fb2e33 cb0b0d d81115 b00d11 8a0608 ff2e52 e01238
//     c9102f c30303 8f0505 e81313 eb0305 e40303 c20305 fa0513 ff5a5f d9212a 8e1a16
//     fb141b ff5f63 d30304 a00203 dc0203 f5282a b3121b 5a0a0e ff3b14 fb1b32 5c0410
//     cf1111 e01f26 1a0709 2a0b0e 1c0607
//   **ทอง/เทาเงินของแบรนด์เก่า (รอบนี้มีแค่ #dca53a #7a4a0c #d2d7dd)** — ffd84d
//     f5ba14 fcee52 b37c0b ffd94a e3a712 9d6f06 eeae12 fded41 9f600d fcd434 fdcb0c
//     fee45d e6a416 fef54b f7c92b d4922c fdfc71 e5a81b ffe08a f9a826 f0b429 ffc82e
//     e0b03a b07d08 · cfd6e3 c3ccd6 c6cfd2 d8dde6 e8eaee e0e0df c0c0bf a1a09e
//   **cyber-neon/dark defaults** — 00f3ff e0ffff 60a5fa 4b5563 030712 1f2937
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️⚠️ **รอบนี้ไม่มีม่วง ไม่มีฟ้า/ไซแอน ไม่มีเขียว ไม่มีชมพู/แมเจนต้า ไม่มีส้ม
// และไม่มีครีม/เบจ/พีช** (เขียว #00B900 ของปุ่ม LINE และเขียว success ของฟีด
// อยู่ไฟล์อื่น **คงไว้ ห้ามเปลี่ยนเป็นแดงตามพาเลตรอบนี้**)
const { title, as: TitleTag = "p", faqs = [] } = Astro.props;
const sectionLabel = title ?? "คำถามที่พบบ่อย";
const groupName = `faq-${BRAND_NAME}`;
---

<section aria-label={sectionLabel} class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {
    title && (
      <div class="mb-8 flex items-center gap-3 rounded-2xl border-l-4 border-[#a30d1a] bg-[#f7dfe4] px-4 py-2.5 shadow-[0_8px_22px_rgba(163,13,26,0.12)]">
        <TitleTag class="bg-gradient-to-r from-[#8a1420] via-[#a30d1a] to-[#c21325] bg-clip-text text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-2xl">
          {title}
        </TitleTag>
      </div>
    )
  }

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details
          name={groupName}
          class="faq-item group relative overflow-hidden rounded-2xl border border-[#eec3cc] bg-[#fdf5f6] transition-all duration-300 hover:border-[#d98fa0] hover:shadow-[0_15px_40px_rgba(163,13,26,0.18)]">
          <div aria-hidden="true" class="absolute top-0 left-0 h-[2px] w-16 bg-gradient-to-r from-[#dca53a] to-transparent" />

          <summary class="flex w-full cursor-pointer items-center justify-between p-5 text-left transition-all">
            <span class="flex items-center gap-2.5 text-base font-bold text-[#36080f] transition-colors group-hover:text-[#a30d1a] md:text-lg">
              <span aria-hidden="true" class="text-xs text-[#a30d1a]">
                ✦
              </span>
              {faq.q}
            </span>

            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#eec3cc] bg-[#f7dfe4] text-lg font-black text-[#a30d1a] transition-all duration-300 group-hover:border-[#d98fa0] group-hover:text-[#8a1420]">
              +
            </span>
          </summary>

          <div class="faq-answer border-t border-[#eec3cc] p-5 pt-4 text-left text-base leading-relaxed text-[#36080f]">{faq.a}</div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(163, 13, 26, 0.9);
    box-shadow: 0 15px 40px rgba(163, 13, 26, 0.2);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #a30d1a;
    color: #8a1420;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
