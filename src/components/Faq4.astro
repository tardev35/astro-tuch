---
import { BRAND_NAME } from "../lib/brandProfile";

export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The docx's own level for this section. This brief marks
   *  "คำถามที่พบบ่อยเกี่ยวกับ <แบรนด์>" as an H2, so index.astro passes as="h2".
   *  It defaults to <p> so a page that hangs a chrome FAQ here stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  faqs?: FaqItem[];
}

// No defaults for `faqs` beyond an empty list — a stale default here would ship
// a previous brand's questions. The page passes both props, and the SAME array
// goes to pageGraph({ faqs }).
//
// The questions themselves stay <span> inside <summary>: they are accordion
// controls, not docx headings, and the rendered heading inventory is diffed
// against the brief on every rebrand. brand-spec §4 pins this page at
// h1×1 / h2×5 / h3×2, and BOTH h3 come from the brief's own H3 lines (§4 items
// 4 and 5) — so promoting these questions to h3 would put two tags on the page
// that the brief never asked for. The <section> keeps its aria-label either
// way, so nothing is lost for assistive tech.
//
// <details name={groupName}> keeps a single panel open at a time with no script,
// and the open state is keyed off [open] in the stylesheet rather than a
// hand-written .rotate-45 override. **No <script> in this file, and it must
// never go back to a button + max-height.**
// ⚠️ The group name is INTERPOLATED from BRAND_NAME rather than typed, which is
// both the rebrand rule (the brand name is never written into markup) and the
// fix for the failure this attribute has had before: a hardcoded slug is the
// quietest way to leave the previous brand's fingerprint in a live attribute,
// because nothing visible changes when it rots.
//
// ───────────────────────────────────────────────────────────────────────────
// โบ๊ะบ๊ะ168 (ดรอป 2026-10-24) — พาเลตตาม .claude/brand-spec-bohba168.md §2
// FAQ ที่ใช้งานจริงรอบนี้ — รอบก่อน (หมูบิน168) ใช้ Faq ตัวฐาน จึงหมุนมาที่ไฟล์นี้
// (ไฟล์นี้ห่างออกไปห้าคอมมิต) ใบนี้ถือ **docx H2 §8** (content.txt บรรทัด 17,
// คู่ Q/A อยู่บรรทัด 18–23) และเป็นบล็อกเนื้อหาสุดท้ายของหน้า
//
// อ่านจากอาร์ตเวิร์กจริง: โลโก้เป็น **หัวการ์ตูนผู้หญิงผมมวยสูงผูกโบว์ขาว ทำหน้า
// ตกใจ ตาโต ปากอ้า สองมือแตะแก้ม** ข้างคำว่า **"โบ๊ะบ๊ะ168" ตัวอักษรบับเบิล
// สามมิติผิวมันวาว ไล่เฉดฟ้าสกายเข้มลงหาฟ้าอ่อนเกือบขาว ตัดขอบขาวหนา**
// ⚠️ **ธีมสว่าง และนี่คือจุดที่ไฟล์นี้พลิกมากที่สุด**: ไฟล์นี้มาถึงรอบนี้ยังเป็น
// **ไซยาน-น้ำแข็งบนถ่านเกือบดำของ นาซ่า168** รอบนี้ bg.json = #00bfff ฟ้าสกาย
// อิ่มตัว **สว่าง** และ §2 จัด FAQ ไว้ใน **โซนเนื้อหา ไม่ใช่โครม** แถวคำถามจึงเป็น
// **ผิวการ์ดขาว #ffffff** พร้อมหมึก **#06283f** (15.2:1) ลำดับความลึก: #f0faff ยก /
// #ffffff การ์ด / #e4f6fb wash / #00bfff พื้นเพจ
// **ห้ามแก้กลับไปเป็นแถวพื้นมืด** — หมึก #06283f บนผิวมืดคือตัวอักษรที่หายไปเลย
//
// รอบนี้อยู่ถัดจาก ContentBoxSpecial (§7) ที่เป็น **การ์ดซ้อนการ์ด** — ที่นี่จึงเป็น
// **แถวมุมมนหลายแถวที่มีกรอบ ไม่ใช่การ์ดใบเดียว** ไม่มีเงานูน ไม่มี clip-path และ
// ไม่มีแผ่นถมทึบที่ไหนในไฟล์นี้เลย
// แผ่นป้ายหัวข้อเป็นมุมมนพร้อมรางซ้าย **ฟ้าสกาย #12b4ef** หนาสี่พิกเซล บนผิวยก
// #f0faff **ทึบทั้งแผ่น**
// ⚠️⚠️ **แผ่นป้ายต้องทึบ ห้ามไล่จบที่ transparent** — ถ้าปลายแผ่นใสเมื่อไร ตัวอักษร
// ท้ายหัวข้อจะไปนั่งบนพื้นเพจ #00bfff ซึ่ง #0f5684 ได้แค่ 3.6:1 และ #1a6ea8 ได้
// **2.6:1 (ตกเกณฑ์ large text ด้วย)** นี่คือกับดักที่ตรงกับโครงเดิมของไฟล์นี้พอดี
// เพราะรอบก่อนแผ่นป้ายไล่จบที่ transparent บนธีมมืด (ซึ่งตอนนั้นไม่เป็นไร)
// หัวข้อ (ที่หน้าเพจส่งมาเป็น prop) ไล่ **ฟ้าลึก #0f5684 → น้ำเงินกลาง #1a6ea8 →
// ฟ้าลึก #0f5684** ซึ่งเป็นลำดับที่ **ไม่ซ้ำกับกล่องใดบนหน้าเดียวกัน** (ใบอื่น
// หัวข้อเป็น #0f5684 ทึบสีเดียวหรือหมึกขาวบนแผ่นถม — ใบนี้ใบเดียวที่ bg-clip-text)
// ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุกสต็อปต้องถือตัวอักษร
// ได้ตาม §2: #0f5684 = 7.3:1 และ #1a6ea8 = 5.2:1 บนผิวยก #f0faff — **ผ่าน AA
// ทั้งคู่แม้คิดเป็น normal text** และหัวข้อเป็น text-xl md:text-2xl font-black
// ซึ่งนับเป็น large text อยู่แล้ว
// ⚠️⚠️ **ห้ามเอา #12b4ef / #00bfff / #b6e3f0 / #7fcbe8 / #4fb8ea มาเป็นสต็อปของ
// ไล่เฉดที่เป็นตัวอักษร** — §2 ระบุว่าห้าหกค่านั้นถือตัวอักษรบนผิวสว่างไม่ได้
// (#12b4ef ได้แค่ 2.4:1 บนขาว) ในไฟล์นี้มันจึงอยู่ที่ **รางซ้าย เส้นไรผม กรอบแถว
// และขอบปุ่ม** ซึ่งเป็นพื้นถม/เส้นล้วน
// กลีฟ ✦ นำหน้าคำถามเป็น **#0f5684** (7.8:1 บนการ์ดขาว) ไม่ใช่ฟ้าสกาย —
// กลีฟนับเป็นตัวอักษร · กรอบแถวเป็น #7fcbe8 อิ่มเป็น #12b4ef ตอน hover ·
// เส้นไรผมมุมบนซ้ายเป็นฟ้าพาสเทล #b6e3f0 · กล่อง + นั่งบนผิวยก #f0faff พร้อมหมึก
// #0f5684 · คำถามที่ hover และสถานะเปิดขึ้นเป็น #0f5684 · เนื้อความ #06283f
// (= BRAND_TEXT)
// rgba() ที่อนุญาตรอบนี้: rgba(18,180,239,α) · rgba(182,227,240,α) ·
// rgba(15,86,132,α) · rgba(6,40,63,α) · rgba(127,203,232,α)
//
// ⚠️⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือฟ้า เพราะฟ้า/ไซยาน
// เคยนำมาแล้วแปดแบรนด์ในรีโปนี้ และไฟล์นี้เพิ่งถือชุดไซยานของ นาซ่า168 มาทั้งใบ**
// ฟ้ารอบนี้คือ **#12b4ef (R18 G180 B239) / #b6e3f0 / #00bfff / #7fcbe8 / #4fb8ea /
// #0f5684 / #1a6ea8 / #06283f** วัดจาก logo.webp / banner1.png / bg.json เอง
// ค่าที่ต้องไม่เหลือในไฟล์นี้:
//   **นาซ่า168 (ชุดที่เพิ่งอยู่ทั้งใบนี้)** — 1fd8f0 0bb6d4 8fd9ec 1d4fd8 143aa0
//     e6edf8 9fb2cb 273449 1b2434 121722 33455f 0d1017
//   **หมูบิน168 (แบรนด์ขาออก — เสี่ยงหลงเหลือสูงสุด)** — fa539c c2185b 8e0f41
//     fb8cc0 fdc6c3 ffd1cd f7bcd9 ef8dbd ffe5ff fff0f8 ffeef7 3b0b26 54123a 7a2350
//     ffe9f5 7a4463
//   **สล็อต168** — fb2e33 cb0b0d d81115 b00d11 8a0608 f0e6e4 c9b9b7 e3d6d4 7d6f6e
//     140000 0b0000 1c0607 2a0c0d 551c1e
//   **ร่ำรวย168** — 18a5e2 0d6b9b 0a5176 a9d7f2 16294a dbe6ff eef4ff dce9fb
//     ⚠️⚠️ **18a5e2 ห่างจาก #12b4ef แค่ R6/G15/B13 — ใกล้ที่สุดในรีโป เจอที่ไหน
//     ให้สงสัยว่าพิมพ์ผิดก่อน** และ a9d7f2 ห่างจาก #b6e3f0 แค่ R13/G12/B2
//   **มาดาม168** — 1177e8 0e68cc 0a4ea8 2a3c70 16234a 0b1733 00091f ff2e52 e01238
//   **สบาย168** — 2cc3fc 6bdcfb 0a7fbd 063a57 9ae0fa cdf2ff f2fbff a9e3f9
//     ⚠️ **063a57 มี R=06 ตรงกับ #06283f เป๊ะ**
//   **นินจา168** — 32bcfb a9e9ff 07335f 0c2a3d 071a28 fef54b
//     ⚠️ **07335f ใกล้ #06283f ที่ R** และ a9e9ff ใกล้ #b6e3f0
//   **รวยแทร่168** — 039cfa 0494f5 c3ebfc 04366b · **สบายเบท168** — 2f9ff5 a8dcff
//     d6ecff 0b3f78 e8f4ff · **TSDET911** — 0360f3 0292fb 6ec8ff 4fb4ff cfdcec
// ⚠️⚠️ **NAZA168 ตัวละตินเป็นลูกค้าคนละเจ้า** ธีมทองอวกาศ-เงินโครเมียม **ห้าม
// กลับเข้ามา**: fbc134 ffe87a cf9a18 96690a d9c9a6 cfd6e3 241700 1a1000
// ชุดทองที่เคยผ่านไฟล์นี้และออกครบแล้ว: f5ba14 fcee52 b37c0b ecd5c4 d2b9a4
// (เงินทอง168) · eeae12 fded41 9f600d e29f0f fdf051 e0e0df c0c0bf a1a09e f4ead6
// (พักยก168) · fee45d e6a416 b8780d (ยูฟ้า168) · d4922c fdfc71 f6e3b4 (ufalion168) ·
// ffd94a e3a712 (รวย168) · f0bb4e (รวยเทพ168) · fdcb0c fefb6b (สบาย168)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️⚠️ **รอบนี้ไม่มีทอง/เหลือง/ส้มเลยสักเฉด** — ดาวเหลืองกับเหรียญทองบนสไลด์เป็น
// **วัตถุในภาพ ไม่ใช่สี UI** · **ไม่มีม่วง/ไวโอเลต ไม่มีเขียว ไม่มีโรสโกลด์
// ไม่มีชมพู/ฟูเชีย ไม่มีบรอนซ์ ไม่มีแดงทุกเฉด ไม่มีครีม/เบจ/พีช และไม่มีแรมป์
// เทาเงิน** (เขียว #00B900 ของปุ่ม LINE และเขียว success ของฟีดอยู่ไฟล์อื่น คงไว้)
const { title, as: TitleTag = "p", faqs = [] } = Astro.props;
const sectionLabel = title ?? "คำถามที่พบบ่อย";
const groupName = `faq-${BRAND_NAME}`;
---

<section aria-label={sectionLabel} class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {
    title && (
      <div class="mb-8 flex items-center gap-3 rounded-2xl border-l-4 border-[#12b4ef] bg-[#f0faff] px-4 py-2.5 shadow-[0_8px_22px_rgba(15,86,132,0.12)]">
        <TitleTag class="bg-gradient-to-r from-[#0f5684] via-[#1a6ea8] to-[#0f5684] bg-clip-text text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-2xl">
          {title}
        </TitleTag>
      </div>
    )
  }

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details
          name={groupName}
          class="faq-item group relative overflow-hidden rounded-2xl border border-[#7fcbe8] bg-white transition-all duration-300 hover:border-[#12b4ef] hover:shadow-[0_15px_40px_rgba(18,180,239,0.2)]">
          <div aria-hidden="true" class="absolute top-0 left-0 h-[2px] w-16 bg-gradient-to-r from-[#b6e3f0] to-transparent" />

          <summary class="flex w-full cursor-pointer items-center justify-between p-5 text-left transition-all">
            <span class="flex items-center gap-2.5 text-base font-bold text-[#06283f] transition-colors group-hover:text-[#0f5684] md:text-lg">
              <span aria-hidden="true" class="text-xs text-[#0f5684]">
                ✦
              </span>
              {faq.q}
            </span>

            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#7fcbe8] bg-[#f0faff] text-lg font-black text-[#0f5684] transition-all duration-300 group-hover:border-[#12b4ef] group-hover:text-[#1a6ea8]">
              +
            </span>
          </summary>

          <div class="faq-answer border-t border-[#7fcbe8] p-5 pt-4 text-left text-base leading-relaxed text-[#06283f]">{faq.a}</div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(18, 180, 239, 0.9);
    box-shadow: 0 15px 40px rgba(18, 180, 239, 0.2);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #12b4ef;
    color: #1a6ea8;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
