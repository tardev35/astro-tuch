---
import { BRAND_NAME } from "../lib/brandProfile";

export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The docx's own level for this section. This brief marks
   *  "คำถามที่พบบ่อยเกี่ยวกับ <แบรนด์>" as an H2, so index.astro passes as="h2".
   *  It defaults to <p> so a page that hangs a chrome FAQ here stays out of the
   *  heading inventory. */
  as?: "h2" | "h3" | "p";
  faqs?: FaqItem[];
}

// No defaults for `faqs` beyond an empty list — a stale default here would ship
// a previous brand's questions. The page passes both props, and the SAME array
// goes to pageGraph({ faqs }).
//
// The questions themselves stay <span> inside <summary>: they are accordion
// controls, not docx headings, and the rendered heading inventory is diffed
// against the brief on every rebrand. The <section> keeps its aria-label either
// way, so nothing is lost for assistive tech.
//
// <details name={groupName}> keeps a single panel open at a time with no script,
// and the open state is keyed off [open] in the stylesheet rather than a
// hand-written .rotate-45 override. **No <script> in this file, and it must
// never go back to a button + max-height.**
// ⚠️ The group name is INTERPOLATED from BRAND_NAME rather than typed, which is
// both the rebrand rule (the brand name is never written into markup) and the
// fix for the failure this attribute has had before: a hardcoded slug is the
// quietest way to leave the previous brand's fingerprint in a live attribute,
// because nothing visible changes when it rots.
//
// ───────────────────────────────────────────────────────────────────────────
// นาซ่า168 (ดรอป 2026-10-23) — พาเลตตาม .claude/brand-spec-naza168.md §2–§3
// FAQ ที่ใช้งานจริงรอบนี้ — รอบก่อน (ร่ำรวย168) ใช้ Faq3 จึงหมุนมาที่ไฟล์นี้
// อ่านจากอาร์ตเวิร์กจริง: โลโก้เป็น **หมวกนักบินอวกาศสีขาว-เงิน บังตาโค้งสะท้อน
// ภาพโลกสีน้ำเงิน-ฟ้า ขอบหมวกมีไฟสีฟ้า** ข้างคำว่า **"นาซ่า" ตัวอักษรไทยสามมิติ
// ผิวมันวาว ไล่เฉดฟ้าไซยานอ่อนลงน้ำเงิน** ต่อด้วยเลข **"168" สีทองอำพัน**
// ⚠️ **ธีมมืด และนี่คือจุดที่ไฟล์นี้พลิกมากที่สุด**: รอบก่อน (ร่ำรวย168) เป็น
// ธีมสว่าง พื้นเพจ dbe6ff ฟ้าอ่อน รอบนี้ bg.json = #0d1017 ถ่านเกือบดำอมน้ำเงิน
// และ §2 จัด FAQ ไว้ใน **โซนเนื้อหา ไม่ใช่โครม** แถวคำถามจึงเป็น **ผิวกลาง
// #1b2434** พร้อมหมึก **#e6edf8** (13.2:1) ลำดับความลึก: #273449 ยก /
// #1b2434 กลาง / #121722 จม / #0d1017 พื้นเพจ
//
// ใบนี้ถือ docx H2 §8 (content.txt บรรทัด 17, คู่ Q/A อยู่บรรทัด 18-23) และเป็น
// บล็อกเนื้อหาสุดท้ายของหน้า อยู่ถัดจาก ContentBoxTwoCyberCut (§7) ที่เป็น
// **การ์ดมุมตัดใบเดียว** — ที่นี่จึงเป็น **แถวมุมมนหลายแถวที่มีกรอบ ไม่ใช่การ์ด
// ใบเดียว** ไม่มีเงานูน ไม่มี clip-path และไม่มีแผ่นถมทึบที่ไหนในไฟล์นี้เลย
// แผ่นป้ายหัวข้อเป็นมุมมนพร้อมรางซ้าย **ไซยาน #1fd8f0** หนาสี่พิกเซล ไล่พื้นจาก
// ผิวจม #121722 ลงไปใส
// หัวข้อ (ที่หน้าเพจส่งมาเป็น prop) ไล่ ไซยาน #1fd8f0 → น้ำแข็ง #8fd9ec → ไซยาน
// #1fd8f0 ซึ่งเป็นลำดับที่ **ไม่ซ้ำกับกล่องใดบนหน้าเดียวกัน**: §2 ไล่
// ไซยาน→น้ำแข็ง→ฟ้าลึก · §7 ไล่ ฟ้าลึก→ไซยาน→น้ำแข็ง · §3 ไล่สองสต็อป
// น้ำแข็ง→ไซยาน · §4 ไล่สองสต็อป ไซยาน→ฟ้าลึก
// ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุกสต็อปต้องถือตัวอักษร
// ได้ตาม §2 (#1fd8f0 10.4:1 · #8fd9ec 11.4:1 บนผิวจม · และ 11.0:1 / 12.1:1 บน
// พื้นเพจที่ปลายไล่เฉดใสของแผ่นป้าย) หัวข้อเป็น text-xl md:text-2xl font-black
// จึงนับเป็น **large text** ทุกแบนด์ เกณฑ์คือ 3:1 ผ่านทั้งหมด
// มาร์ก ❖ นำหน้าคำถามเป็นไซยาน #1fd8f0 (9.0:1 บนผิวกลาง) กรอบแถวเป็น #33455f
// เส้นไรผมมุมบนซ้ายเป็นน้ำแข็ง #8fd9ec กล่อง + นั่งบนผิวจม #121722 พร้อมหมึกไซยาน
// คำถามที่ hover และสถานะเปิดขึ้นเป็นไซยาน เนื้อความ #e6edf8 (= BRAND_TEXT)
// ⚠️ §2 ห้าม **#33455f (1.6:1) และ #1d4fd8 (2.3:1)** ถือตัวอักษรและห้ามเป็นพื้นของ
// ตัวอักษร — ไฟล์นี้จึง **ไม่มี #1d4fd8 เลยสักจุด** เพราะทุกชั้นที่นี่มีตัวอักษรอยู่
// และ #33455f อยู่ที่กรอบแถวเท่านั้น ·
// **ผิวทั้งสี่ #273449 #1b2434 #121722 #0d1017 ห้ามถือตัวอักษร** เป็นพื้นเท่านั้น
//
// ⚠️⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือฟ้า เพราะฟ้า/ไซยาน
// เคยนำมาแล้วหกแบรนด์ในรีโปนี้ และรอบก่อนหน้าทันที (ร่ำรวย168) ก็ฟ้านำเหมือนกัน**
// ไซยานรอบนี้ **#1fd8f0 (R31 G216 B240)** และ **#8fd9ec (R143 G217 B236)** วัดจาก
// logo.webp / banner1.png เอง ตัวที่ใกล้ที่สุดในรีโปคือ **32bcfb ของ นินจา168**
// (ห่าง R19/G24/B11) **2cc3fc ของ สบาย168** (ห่าง R13/G21/B12) **a9d7f2 ของ
// ร่ำรวย168** (ห่าง #8fd9ec R26/G2/B6) และ **a9e9ff ของ นินจา168** (ห่าง #8fd9ec
// R26/G16/B19) — ทั้งหมดใกล้กว่าที่รีโปนี้ยอมตามปกติ **ต้อง grep เป็นค่า**
// ⚠️⚠️ **NAZA168 ตัวละตินเป็นลูกค้าคนละเจ้าที่ชื่อซ้ำกับรอบนี้** ธีมทองอวกาศ-
// เงินโครเมียม **ห้ามกลับเข้ามา**: fbc134 ffe87a cf9a18 96690a d9c9a6 cfd6e3
// 241700 1a1000 432b03 231500
// ชุดทองนำ-ครีมอุ่นของ **เงินทอง168** ที่เพิ่งอยู่ในไฟล์นี้ทั้งใบ (f5ba14 fcee52
// b37c0b ecd5c4 d2b9a4 29210f 3d3016 332810 201906 2e2512 1b1407 4d3c15) และชุด
// ทองคานารี-โครเมียมเงินของ **พักยก168** (eeae12 fded41 9f600d e29f0f fdf051
// e0e0df c0c0bf a1a09e f4ead6 d6c6a8 291d0f 3a2713 32200f 1f1308 2f1e0f 1f0f04
// 4e2f11 · rgba(253,237,65,α)) ออกครบทุกค่าแล้ว เช่นเดียวกับชุดฟ้าสกาย-ทองคานารี
// ของ **สบาย168** (2cc3fc 6bdcfb 0a7fbd 063a57 04293d 0a4f74 9ae0fa cdf2ff ccf7ff
// f2fbff dff4fd eafaff a9e3f9 fdcb0c fefb6b 8a6504 0f3a4a 06293c) ชุดแดงเชอร์รี่
// ของ **โปรดี168** (eb0305 c20305 9b0a0c ff4446 401107 b44c06 7a2f03 f0b46a
// d9803a 4d1c0a 2c1004 fff0e4 fff4ea ffd1d1 1a0802) ชุดทองคานารี-เงินโครเมียมของ
// **ยูฟ้า168** (fee45d e6a416 b8780d 7a4e05 e8ecf1 a8b2bf 78828f 5a6472 15130f
// 1e1a13 0a0908 eae3d4 140e02 000000) ชุดแดงคริมสันของ **รวยแท้168** (c30303
// 8f0505 e81313 dcb95f b8862b 96681f ffeee8 fff1ef ffdbdb) ชุดเขียวมรกตของ
// **สาธุ168** (0b7d28 0a5f1c 0f9b35 0c3a16 061f0c d8ffc7 e9fbdd) ชุดบรอนซ์ของ
// **ufalion168** (d4922c fdfc71 a25b24 8c4312 d39c45 f6e3b4 33200a 1f1304 0a0601
// 5a3310 1a1000) ชุดของ **รวยเทพ168** (f0bb4e ffeccb e4021b d9701a 3b1b0e 260d04
// 5c2a06) ชุดของ **รวยแทร่168** (039cfa 0494f5 c3ebfc 04366b f9a826 704504 e3f2fc
// 0b2d52) ชุดของ **นินจา168** (32bcfb a9e9ff fef54b 07335f 6b5c10 0c2a3d 071a28
// 030e16 041019 dceefc) ชุดของ **สบายเบท168** (2f9ff5 a8dcff d6ecff 0b3f78 e8f4ff
// ffc82e 5c4a16) ชุดของ **TSDET911** (0360f3 0292fb 6ec8ff 4fb4ff cfdcec 9db4d4
// dde8f7) และชุดของ **ร่ำรวย168** ซึ่งเป็นแบรนด์ขาออก (18a5e2 0d6b9b 0a5176 a9d7f2
// 16294a dbe6ff eef4ff dce9fb f4e4d3 e4cbb3 111a3f 202a66 31408a e9f1ff adc0e4)
// ถอดออกครบทุกค่า รวมถึงชื่อ details group ของแบรนด์ก่อน
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️⚠️ **รอบนี้ไม่มีทอง/เหลือง/ส้มเลยสักเฉด** — เลข 168 สีทองอำพันในโลโก้เป็น
// **วัตถุในภาพ ไม่ใช่สี UI** และทองยังเป็นสีของ NAZA168 ตัวละตินซึ่งชื่อซ้ำกัน ·
// **ไม่มีม่วง/ไวโอเลต ไม่มีเขียว ไม่มีโรสโกลด์ ไม่มีชมพู/ฟูเชีย ไม่มีบรอนซ์
// ไม่มีทองแดงไหม้ ไม่มีแดงทุกเฉด และไม่มีแรมป์เทาเงิน**
const { title, as: TitleTag = "p", faqs = [] } = Astro.props;
const sectionLabel = title ?? "คำถามที่พบบ่อย";
const groupName = `faq-${BRAND_NAME}`;
---

<section aria-label={sectionLabel} class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {
    title && (
      <div class="mb-8 flex items-center gap-3 rounded-2xl border-l-4 border-[#1fd8f0] bg-gradient-to-r from-[#121722] via-[#121722]/60 to-transparent px-4 py-2.5">
        <TitleTag class="bg-gradient-to-r from-[#1fd8f0] via-[#8fd9ec] to-[#1fd8f0] bg-clip-text text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-2xl">
          {title}
        </TitleTag>
      </div>
    )
  }

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details
          name={groupName}
          class="faq-item group relative overflow-hidden rounded-2xl border border-[#33455f] bg-[#1b2434] transition-all duration-300 hover:border-[#1fd8f0]/70 hover:shadow-[0_15px_40px_rgba(31,216,240,0.18)]">
          <div aria-hidden="true" class="absolute top-0 left-0 h-[2px] w-16 bg-gradient-to-r from-[#8fd9ec] to-transparent" />

          <summary class="flex w-full cursor-pointer items-center justify-between p-5 text-left transition-all">
            <span class="flex items-center gap-2.5 text-base font-bold text-[#e6edf8] transition-colors group-hover:text-[#1fd8f0] md:text-lg">
              <span aria-hidden="true" class="text-xs text-[#1fd8f0]">
                ❖
              </span>
              {faq.q}
            </span>

            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#33455f] bg-[#121722] text-lg font-black text-[#1fd8f0] transition-all duration-300 group-hover:border-[#1fd8f0] group-hover:text-[#8fd9ec]">
              +
            </span>
          </summary>

          <div class="faq-answer border-t border-[#33455f] p-5 pt-4 text-left text-base leading-relaxed text-[#e6edf8]">{faq.a}</div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(31, 216, 240, 0.7);
    box-shadow: 0 15px 40px rgba(31, 216, 240, 0.18);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #1fd8f0;
    color: #8fd9ec;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
