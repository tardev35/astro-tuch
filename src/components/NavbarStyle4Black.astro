---
import { isActivePath } from "../lib/nav";
import { BRAND_NAME } from "../lib/brandProfile";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

const logoAlt = "โลโก้ 789BETTING เป็นตัวเลข 789 สีทองขัดเงาสามมิติตัวหนา วางทับคำว่า BETTING ที่เป็นตัวพิมพ์ใหญ่สีดำขนาดเล็กกว่า โดยมีแถบขีดสีขาวคาดอยู่ใต้คำนั้นบนพื้นโปร่ง";

// icon เป็น sibling ของ label เสมอ และอยู่ใน span aria-hidden — ห้ามต่อเข้าไปใน
// ข้อความ ไม่งั้น screen reader จะอ่านชื่อไอคอนนำหน้าชื่อเมนู (verify-build เช็กให้)
//
// ลำดับ: หน้าแรก · โปรโมชั่น · สมัครสมาชิก · เข้าสู่ระบบ · แล้วค่อยหน้าอ่าน —
// สองรายการกลางเป็นปุ่มคอนเวอร์ชัน จึงต้องอยู่ก่อนหน้าที่ไว้อ่าน
//
// ไม่มี /ทางเข้า ในเมนู: แบรนด์นี้เปิด cta toggle ทั้งคู่ (login/register เป็นหน้า
// ปุ่มจริง) หน้าทางเข้าจึงกลายเป็นลิงก์ที่สามไปที่เดิม — ตัวหน้ายังถูก route และ
// index อยู่ ไม่ได้ลบ และมีลิงก์จาก footer และไม่มี /ตรวจหวย, /แนวทาง: 789BETTING
// เป็นคาสิโนฐานเข้าหลักที่มีหวยเป็นหนึ่งในหมวดเดิมพัน ไม่ใช่เว็บหวย ทั้งสองหน้านั้น
// จอดอยู่ใน src/pages-disabled/ รอบนี้ จึงไม่มี route ให้ลิงก์ไป
//
// พาเลตต์ 789BETTING (ทองเมทัลลิกบนดำสนิท 2026-10-08, brand-spec §2): แบรนด์นี้เป็น
// "ฮิวเดียว" ต่างจาก 1SS365 ที่เคยอยู่ในไฟล์นี้ซึ่งเป็นทองคู่เงินโครเมียม — โลโก้
// เป็นเลข 789 ทองขัดเงาล้วนทับคำว่า BETTING สีดำ ไม่มีโลหะที่สอง สีที่สองของคู่ปุ่ม
// จึงเป็น "ปลายเข้มของทองเดียวกัน" (บรอนซ์) ไม่ใช่เงิน
// พื้นดำสนิท #060402 ทองหลัก #fad354 (vivid ของ logo.webp) ทองแชมเปญ #ffe79a
// ทองกลาง #ddab33 ทองลึก #8a6410 บรอนซ์ #c9881f เนื้อความ #f3e7cd (BRAND_TEXT)
// ตอนไม่ active ลดเป็นงาช้างหม่น #b5a888 ปุ่มสมัครสมาชิกเป็นทองตันหมึกดำ #0a0802
// ส่วนปุ่มเข้าสู่ระบบเป็นบรอนซ์เข้มขอบทองหมึกแชมเปญ เพื่อให้คู่ปุ่มอ่านเป็น
// "ทองสว่าง/ทองเข้ม" ตามโลโก้ทองล้วน — ชุดทอง-เงินของ 1SS365 (#edbb23 #ffeeb4
// #a87708 #9ea3a8 #c8cbce #f1f2f3 #f0e6d2 #050505 #1a1710 rgba(237,187,35,α)
// rgba(200,203,206,α) rgba(241,242,243,α) rgba(255,238,180,α)) ออกครบทุกจุดแล้ว
// ไม่เหลือฮิวเก่าในไฟล์ ไม่ว่าในคลาสหรือใน rgba()
//
// คอนทราสต์ที่ตรวจแล้ว: #0a0802 บนทอง #fad354 ≈ 13.5:1 · #ffe79a บนบรอนซ์เข้ม
// #2a2008 ≈ 12.4:1 · #b5a888 บนดำ #060402 ≈ 9.0:1 · #f3e7cd บนดำ #060402 ≈ 16.8:1
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🏢" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
  { name: "ทางเข้า", path: "/ทางเข้า", icon: "🌐" },
];
---

<nav class="sticky top-0 z-50 w-full border-b border-[#fad354]/55 bg-[#060402] font-sans shadow-[0_0_20px_rgba(250,211,84,0.22)]">
  <div class="flex h-[75px] w-full items-center justify-between px-4 xl:px-8">
    <div class="z-50 flex items-center">
      <a href="/" class="group relative flex items-center">
        <div class="absolute inset-0 scale-0 rounded-full bg-[#fad354]/20 blur-xl transition-transform duration-500 group-hover:scale-150"></div>
        {
          mainLogo ? (
            <Picture
              src={mainLogo}
              alt={logoAlt}
              loading="eager"
              fetchpriority="high"
              widths={[110, 220, 330]}
              sizes="110px"
              class="relative h-[40px] w-auto drop-shadow-[0_0_10px_rgba(250,211,84,0.4)] transition-transform group-hover:scale-105 xl:h-[45px]"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
            />
          ) : (
            <p class="relative bg-gradient-to-b from-[#ffe79a] via-[#fad354] to-[#8a6410] bg-clip-text text-3xl font-black tracking-widest text-transparent italic drop-shadow-[0_0_8px_rgba(250,211,84,0.5)]">{BRAND_NAME}</p>
          )
        }
      </a>
    </div>

    <div class="z-10 hidden items-center gap-2 lg:gap-3 xl:flex">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`group relative px-5 py-2.5 skew-x-[-15deg] overflow-hidden border transition-all duration-300 ${isActive(link.path) ? "bg-[#fad354]/20 border-[#fad354] shadow-[0_0_15px_rgba(250,211,84,0.45)]" : "bg-white/5 border-white/10 hover:border-[#ffe79a]/60"}`}>
            <div
              aria-hidden="true"
              class={`absolute inset-0 bg-gradient-to-r from-[#8a6410] to-[#fad354] translate-y-full transition-transform duration-300 ${isActive(link.path) ? "translate-y-0 opacity-20" : "group-hover:translate-y-0 opacity-40"}`}
            />
            <span class={`block skew-x-[15deg] relative z-10 text-sm font-bold tracking-wide transition-colors ${isActive(link.path) ? "text-[#ffe79a]" : "text-[#b5a888] group-hover:text-[#f3e7cd]"}`}>
              <span aria-hidden="true" class="mr-1">
                {link.icon}
              </span>{" "}
              {link.name}
            </span>
          </a>
        ))
      }
    </div>

    <div class="z-50 flex items-center gap-2">
      <a
        href="/register"
        class="hidden rounded-sm skew-x-[-15deg] border border-[#ffe79a] bg-gradient-to-r from-[#ffe79a] via-[#fad354] to-[#ddab33] px-6 py-2.5 text-sm font-black text-[#0a0802] shadow-[0_0_15px_rgba(250,211,84,0.5)] transition-all hover:-translate-y-0.5 hover:shadow-[0_6px_20px_rgba(255,231,154,0.7)] lg:block">
        <span class="block skew-x-[15deg]">สมัครสมาชิก</span>
      </a>
      <a
        href="/login"
        class="hidden rounded-sm skew-x-[-15deg] border border-[#fad354]/70 bg-gradient-to-r from-[#3a2c0b] via-[#2a2008] to-[#17130a] px-6 py-2.5 text-sm font-black text-[#ffe79a] shadow-[0_0_15px_rgba(201,136,31,0.35)] transition-all hover:-translate-y-0.5 hover:shadow-[0_6px_20px_rgba(250,211,84,0.45)] lg:block">
        <span class="block skew-x-[15deg]">เข้าสู่ระบบ</span>
      </a>

      <button
        id="hamburger-btn"
        class="relative flex h-[45px] w-[45px] flex-col items-center justify-center space-y-1.5 rounded-md border border-[#fad354]/35 bg-[#17130a]/45 p-2 transition-all hover:bg-[#17130a]/80 xl:hidden"
        aria-label="เปิดหรือปิดเมนู">
        <span class="hamburger-line h-[2px] w-6 origin-center bg-[#f3e7cd] transition-all duration-300"></span>
        <span class="hamburger-line h-[2px] w-6 bg-[#f3e7cd] transition-all duration-300"></span>
        <span class="hamburger-line h-[2px] w-6 origin-center bg-[#f3e7cd] transition-all duration-300"></span>
      </button>
    </div>
  </div>

  <div id="mobile-overlay" class="pointer-events-none fixed inset-0 z-30 bg-black/80 opacity-0 backdrop-blur-sm transition-opacity duration-300 xl:hidden"></div>

  <div
    id="mobile-sidebar"
    class="fixed top-0 right-0 z-40 h-screen w-[280px] translate-x-full transform overflow-y-auto border-l border-[#fad354]/55 bg-[#060402] shadow-[-10px_0_30px_rgba(0,0,0,0.8)] transition-transform duration-300 ease-out xl:hidden">
    <div class="flex flex-col space-y-3 px-6 pt-24 pb-10">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`sidebar-item flex items-center px-4 py-3.5 rounded-lg border transition-all ${isActive(link.path) ? "bg-[#fad354]/20 border-[#fad354] text-[#ffe79a] shadow-[inset_4px_0_0_rgba(255,231,154,1)]" : "bg-white/5 border-transparent text-[#b5a888] hover:bg-white/10 hover:text-[#f3e7cd]"}`}>
            <span aria-hidden="true" class="mr-3 text-xl">
              {link.icon}
            </span>
            <span class="text-sm font-bold">{link.name}</span>
          </a>
        ))
      }
    </div>
  </div>
</nav>

<style is:global>
  /* อนิเมชันปุ่ม Hamburger กลายเป็น X */
  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  /* อนิเมชันเด้งไล่ระดับของเมนูใน Sidebar */
  .sidebar-item {
    opacity: 0;
    transform: translateX(20px);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  /* คลาสนี้จะถูกยัดผ่าน JS เพื่อแสดงเมนู */
  .sidebar-item.item-show {
    opacity: 1;
    transform: translateX(0);
  }

  /* หน่วงเวลาให้เมนูวิ่งเข้ามาทีละอัน — มี 7 เมนู ต้องครบทั้ง 7 */
  .sidebar-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .sidebar-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .sidebar-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .sidebar-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .sidebar-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .sidebar-item:nth-child(6) {
    transition-delay: 0.35s;
  }
  .sidebar-item:nth-child(7) {
    transition-delay: 0.4s;
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar-item {
      transition: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const overlay = document.getElementById("mobile-overlay");
  const sidebar = document.getElementById("mobile-sidebar");
  const sidebarItems = document.querySelectorAll(".sidebar-item");

  const toggleMenu = () => {
    hamburgerBtn?.classList.toggle("active");

    sidebar?.classList.toggle("translate-x-full");
    sidebar?.classList.toggle("translate-x-0");

    overlay?.classList.toggle("opacity-0");
    overlay?.classList.toggle("opacity-100");
    overlay?.classList.toggle("pointer-events-none");
    overlay?.classList.toggle("pointer-events-auto");

    if (sidebar?.classList.contains("translate-x-0")) {
      document.body.style.overflow = "hidden";
      sidebarItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      sidebarItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleMenu);
  overlay?.addEventListener("click", toggleMenu);

  sidebarItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (sidebar?.classList.contains("translate-x-0")) {
        toggleMenu();
      }
    });
  });
</script>
