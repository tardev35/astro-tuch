---
import { isActivePath } from "../lib/nav";
import { BRAND_NAME } from "../lib/brandProfile";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

// เขียนจากไฟล์ logo.webp ของดรอป 2026-10-13 จริง — เหรียญตรามังกรทองของ TND168
// ที่เคยอยู่ในตัวแปรนี้ไม่มีอยู่ในรูปรอบนี้เลย รอบนี้มังกรเป็นลายพู่กัน "แดง"
// ไม่ได้อยู่ในเหรียญ และไม่มีทองสักจุด
const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส ด้านซ้ายเป็นอักขระจีนคำว่ามังกรเขียนด้วยลายพู่กันสีแดงสด ปลายเส้นสะบัดคล้ายหัวมังกรหันไปทางขวา ถัดมาทางขวาเป็นเวิร์ดมาร์ก ${BRAND_NAME} ตัวอักษรละตินหนาสามมิติแบบเอียง โดยตัวอักษร GT เป็นสีขาวโครเมียมขัดเงาไล่เงาเทา ตัวเลข 66 เป็นสีแดงสดไล่เฉดลงไปหาแดงเข้ม และตัวอักษร B ปิดท้ายเป็นสีขาวโครเมียมอีกครั้ง มีประกายแสงสีขาวพาดอยู่บนผิวตัวอักษร`;

// icon เป็น sibling ของ label เสมอ และอยู่ใน span aria-hidden — ห้ามต่อเข้าไปใน
// ข้อความ ไม่งั้น screen reader จะอ่านชื่อไอคอนนำหน้าชื่อเมนู (verify-build เช็กให้)
//
// ลำดับ: หน้าแรก · โปรโมชั่น · สมัครสมาชิก · เข้าสู่ระบบ · แล้วค่อยหน้าอ่าน —
// สองรายการกลางเป็นปุ่มคอนเวอร์ชัน จึงต้องอยู่ก่อนหน้าที่ไว้อ่าน
//
// เมนูชุดนี้ถูกประกาศครั้งเดียวตรงนี้ แล้ว render ทั้งแถบ desktop และ drawer
// มือถือจากตัวเดียวกัน — ถ้าแยกสองชุดเมื่อไหร่ มันจะเพี้ยนกันเองรอบถัดไป
//
// ไม่มี /ทางเข้า ในเมนู: แบรนด์นี้เปิด cta toggle ทั้งคู่ (login/register เป็นหน้า
// ปุ่มจริง) หน้าทางเข้าจึงกลายเป็นลิงก์ที่สามไปที่เดิม — ตัวหน้ายังถูก route และ
// index อยู่ ไม่ได้ลบ และมีลิงก์จาก footer
// และไม่มี /ตรวจหวย, /แนวทาง: GT66B เป็นแบรนด์คาสิโน (บาคาร่า ไฮโล สล็อต)
// ไม่ใช่เว็บหวย ทั้งสองหน้านั้นจอดอยู่ใน src/pages-disabled/ รอบนี้ จึงไม่มี route
// ให้ลิงก์ไป และ verify-build จะทำให้ build แดงถ้าเหลือลิงก์ค้างไว้
//
// ไอคอนเลือกตามหมวดของแบรนด์นี้จริง ไม่ใช่ยกชุดเดิม: 🃏 ให้ทดลองเล่นเพราะบรีฟ
// รอบนี้นำด้วยบาคาร่าซึ่งเป็นเกมไพ่ ไม่ใช่สล็อตล้วน (รอบก่อนใช้ 🎰)
//
// พาเลตต์ GT66B (แดงมังกรบนดำสนิท 2026-10-13, brand-spec §2): แบรนด์นี้เป็น
// **สองโทนจริง** — แดงมังกรนำ โครเมียมขาวรอง อ่านจากโลโก้ตรงๆ (มังกร 龍 กับเลข 66
// เป็นแดงสด ส่วน GT กับ B เป็นโครเมียมขาว) คู่ปุ่มจึงต่างกันที่ "พื้นแดงตัน vs
// พื้นแดงมืด" ไม่ใช่ที่ระดับความสว่างของสีเดียว
// พื้นแถบ #0b0303 (สว่างกว่าพื้นเพจดำสนิท #000000 ของ bg.json เพียงนิดเดียว ให้
// แยกชั้นจากเนื้อหาที่เลื่อนผ่านใต้มัน) ผิวยก #1c0c0b แดงดำ #3b0405
// แดงหลัก #fb141b แดงสว่าง #ff5f63 แดงอ่อน #ffa0a2 แดงลึก #db040b / #8a0609
// โครเมียมสว่าง #fdfcfd โครเมียมหม่น #b4bcc2 เนื้อความ #eceaea (BRAND_TEXT)
// ปุ่มสมัครสมาชิกเป็นแดงตันหมึกแดงเกือบดำ #190505 ส่วนปุ่มเข้าสู่ระบบเป็นผิวมืดแดง
// ขอบแดงหมึกแดงอ่อน
// ⚠️ ชุดทองมังกรของ TND168 ที่ค้างอยู่ในไฟล์นี้ (#dfa310 #ffe4a3 #ffc93d #8a5c09
// #c9881f #f0e9dc #c9b88e #140d02 #1b1307 #120c04 #070502 #2b1f08 #43240b
// rgba(223,163,16,α) rgba(255,228,163,α) rgba(138,92,9,α)) ออกครบทุกจุดแล้ว
// ทั้งในคลาสและใน rgba() — **รอบนี้ไม่มีทองเลย** มีแค่แดงกับโครเมียมขาว
// ⚠️ **กับดักรอบนี้คือแดง** แบรนด์รอบก่อนหน้าทันที (TKB55) ก็เป็นแดง-โลหะ-ดำ
// แดงของมันคือ #fb131b ส่วนรอบนี้คือ #fb141b — ต่างกันหนึ่งหลัก ห้ามกะด้วยตาว่า
// "มีแดงอยู่แล้ว = ของรอบนี้" ให้เทียบเป็นตัวเลขกับ brand-spec-gt66b.md §2
//
// คอนทราสต์ที่ตรวจแล้ว: #190505 บนแดงแบรนด์ #fb141b ≈ 5.0:1 · บนแดงสว่าง
// #ff5f63 ≈ 6.5:1 · #fdfcfd บนพื้นแถบ #0b0303 ≈ 19.9:1 · #b4bcc2 บนพื้นแถบ
// ≈ 10.6:1 · #eceaea บนพื้นแถบ ≈ 17.1:1 · #ffa0a2 บนแดงดำ #3b0405 ≈ 9.0:1
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🃏" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🏢" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];
---

<nav class="sticky top-0 z-50 w-full border-b border-[#fb141b]/55 bg-[#0b0303] font-sans shadow-[0_0_20px_rgba(251,20,27,0.22)]">
  <div class="flex h-[75px] w-full items-center justify-between px-4 xl:px-8">
    <div class="z-50 flex items-center">
      <a href="/" class="group relative flex items-center">
        <div class="absolute inset-0 scale-0 rounded-full bg-[#fb141b]/20 blur-xl transition-transform duration-500 group-hover:scale-150"></div>
        {
          mainLogo ? (
            <Picture
              src={mainLogo}
              alt={logoAlt}
              loading="eager"
              fetchpriority="high"
              widths={[110, 220, 330]}
              sizes="110px"
              class="relative h-[40px] w-auto drop-shadow-[0_0_10px_rgba(251,20,27,0.4)] transition-transform group-hover:scale-105 xl:h-[45px]"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
            />
          ) : (
            <p class="relative bg-gradient-to-b from-[#fdfcfd] via-[#ff5f63] to-[#db040b] bg-clip-text text-3xl font-black tracking-widest text-transparent italic drop-shadow-[0_0_8px_rgba(251,20,27,0.5)]">{BRAND_NAME}</p>
          )
        }
      </a>
    </div>

    <div class="z-10 hidden items-center gap-2 lg:gap-3 xl:flex">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`group relative px-5 py-2.5 skew-x-[-15deg] overflow-hidden border transition-all duration-300 ${isActive(link.path) ? "bg-[#fb141b]/20 border-[#fb141b] shadow-[0_0_15px_rgba(251,20,27,0.45)]" : "bg-white/5 border-white/10 hover:border-[#ffa0a2]/60"}`}>
            <div
              aria-hidden="true"
              class={`absolute inset-0 bg-gradient-to-r from-[#8a0609] to-[#fb141b] translate-y-full transition-transform duration-300 ${isActive(link.path) ? "translate-y-0 opacity-20" : "group-hover:translate-y-0 opacity-40"}`}
            />
            <span class={`block skew-x-[15deg] relative z-10 text-sm font-bold tracking-wide transition-colors ${isActive(link.path) ? "text-[#fdfcfd]" : "text-[#b4bcc2] group-hover:text-[#eceaea]"}`}>
              <span aria-hidden="true" class="mr-1">
                {link.icon}
              </span>{" "}
              {link.name}
            </span>
          </a>
        ))
      }
    </div>

    <div class="z-50 flex items-center gap-2">
      <a
        href="/register"
        class="hidden rounded-sm skew-x-[-15deg] border border-[#ffa0a2] bg-gradient-to-r from-[#ffa0a2] via-[#ff5f63] to-[#fb141b] px-6 py-2.5 text-sm font-black text-[#190505] shadow-[0_0_15px_rgba(251,20,27,0.5)] transition-all hover:-translate-y-0.5 hover:shadow-[0_6px_20px_rgba(255,160,162,0.7)] lg:block">
        <span class="block skew-x-[15deg]">สมัครสมาชิก</span>
      </a>
      <a
        href="/login"
        class="hidden rounded-sm skew-x-[-15deg] border border-[#fb141b]/70 bg-gradient-to-r from-[#3b0405] via-[#1c0c0b] to-[#0b0303] px-6 py-2.5 text-sm font-black text-[#ffa0a2] shadow-[0_0_15px_rgba(138,6,9,0.35)] transition-all hover:-translate-y-0.5 hover:shadow-[0_6px_20px_rgba(251,20,27,0.45)] lg:block">
        <span class="block skew-x-[15deg]">เข้าสู่ระบบ</span>
      </a>

      <button
        id="hamburger-btn"
        class="relative flex h-[45px] w-[45px] flex-col items-center justify-center space-y-1.5 rounded-md border border-[#fb141b]/35 bg-[#1c0c0b]/45 p-2 transition-all hover:bg-[#1c0c0b]/80 xl:hidden"
        aria-label="เปิดหรือปิดเมนู">
        <span class="hamburger-line h-[2px] w-6 origin-center bg-[#eceaea] transition-all duration-300"></span>
        <span class="hamburger-line h-[2px] w-6 bg-[#eceaea] transition-all duration-300"></span>
        <span class="hamburger-line h-[2px] w-6 origin-center bg-[#eceaea] transition-all duration-300"></span>
      </button>
    </div>
  </div>

  <div id="mobile-overlay" class="pointer-events-none fixed inset-0 z-30 bg-black/80 opacity-0 backdrop-blur-sm transition-opacity duration-300 xl:hidden"></div>

  <div
    id="mobile-sidebar"
    class="fixed top-0 right-0 z-40 h-screen w-[280px] translate-x-full transform overflow-y-auto border-l border-[#fb141b]/55 bg-[#0b0303] shadow-[-10px_0_30px_rgba(0,0,0,0.85)] transition-transform duration-300 ease-out xl:hidden">
    <div class="flex flex-col space-y-3 px-6 pt-24 pb-10">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`sidebar-item flex items-center px-4 py-3.5 rounded-lg border transition-all ${isActive(link.path) ? "bg-[#fb141b]/20 border-[#fb141b] text-[#fdfcfd] shadow-[inset_4px_0_0_rgba(251,20,27,1)]" : "bg-white/5 border-transparent text-[#b4bcc2] hover:bg-white/10 hover:text-[#eceaea]"}`}>
            <span aria-hidden="true" class="mr-3 text-xl">
              {link.icon}
            </span>
            <span class="text-sm font-bold">{link.name}</span>
          </a>
        ))
      }
    </div>
  </div>
</nav>

<style is:global>
  /* อนิเมชันปุ่ม Hamburger กลายเป็น X */
  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  /* อนิเมชันเด้งไล่ระดับของเมนูใน Sidebar */
  .sidebar-item {
    opacity: 0;
    transform: translateX(20px);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  /* คลาสนี้จะถูกยัดผ่าน JS เพื่อแสดงเมนู */
  .sidebar-item.item-show {
    opacity: 1;
    transform: translateX(0);
  }

  /* หน่วงเวลาให้เมนูวิ่งเข้ามาทีละอัน — มี 7 เมนู ต้องครบทั้ง 7 */
  .sidebar-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .sidebar-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .sidebar-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .sidebar-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .sidebar-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .sidebar-item:nth-child(6) {
    transition-delay: 0.35s;
  }
  .sidebar-item:nth-child(7) {
    transition-delay: 0.4s;
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar-item {
      transition: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const overlay = document.getElementById("mobile-overlay");
  const sidebar = document.getElementById("mobile-sidebar");
  const sidebarItems = document.querySelectorAll(".sidebar-item");

  const toggleMenu = () => {
    hamburgerBtn?.classList.toggle("active");

    sidebar?.classList.toggle("translate-x-full");
    sidebar?.classList.toggle("translate-x-0");

    overlay?.classList.toggle("opacity-0");
    overlay?.classList.toggle("opacity-100");
    overlay?.classList.toggle("pointer-events-none");
    overlay?.classList.toggle("pointer-events-auto");

    if (sidebar?.classList.contains("translate-x-0")) {
      document.body.style.overflow = "hidden";
      sidebarItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      sidebarItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleMenu);
  overlay?.addEventListener("click", toggleMenu);

  sidebarItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (sidebar?.classList.contains("translate-x-0")) {
        toggleMenu();
      }
    });
  });
</script>
