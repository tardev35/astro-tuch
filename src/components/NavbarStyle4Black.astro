---
import { isActivePath } from "../lib/nav";
import { BRAND_NAME } from "../lib/brandProfile";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

// เขียนจากไฟล์ logo.webp ของดรอป 2026-10-22 จริง — อักขระจีน 龍 ลายพู่กันแดงของ GT66B
// ที่เคยอยู่ในตัวแปรนี้ไม่มีอยู่ในรูปรอบนี้เลย รอบนี้มังกรเป็น **หัวมังกรสามมิติสีทอง**
// ไม่ใช่ลายพู่กัน และ **ไม่มีแดงสักจุด**
const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส ด้านซ้ายเป็นหัวมังกรจีนสามมิติสีทองหันไปทางซ้าย อ้าปากเห็นเขี้ยว มีเขาและหนวดเป็นเส้นทองสะบัดไปด้านหลัง ถัดมาทางขวาเป็นเวิร์ดมาร์ก ${BRAND_NAME} โดยคำว่า พักยก เป็นตัวอักษรไทยหนาสามมิติผิวทองมันวาวไล่เฉดจากทองอ่อนที่ยอดลงไปหาทองเข้มที่ฐาน ต่อท้ายด้วยเลข 168 ผิวโครเมียมเงินขัดเงา ทั้งหมดตัดขอบดำหนาและมีประกายแสงสีขาวพาดอยู่บนผิวตัวอักษร`;

// icon เป็น sibling ของ label เสมอ และอยู่ใน span aria-hidden — ห้ามต่อเข้าไปใน
// ข้อความ ไม่งั้น screen reader จะอ่านชื่อไอคอนนำหน้าชื่อเมนู (verify-build เช็กให้)
//
// ลำดับ: หน้าแรก · โปรโมชั่น · สมัครสมาชิก · เข้าสู่ระบบ · แล้วค่อยหน้าอ่าน —
// สองรายการกลางเป็นปุ่มคอนเวอร์ชัน จึงต้องอยู่ก่อนหน้าที่ไว้อ่าน
//
// เมนูชุดนี้ถูกประกาศครั้งเดียวตรงนี้ แล้ว render ทั้งแถบ desktop และ drawer
// มือถือจากตัวเดียวกัน — ถ้าแยกสองชุดเมื่อไหร่ มันจะเพี้ยนกันเองรอบถัดไป
//
// ไม่มี /ทางเข้า ในเมนู: แบรนด์นี้เปิด cta toggle ทั้งคู่ (login/register เป็นหน้า
// ปุ่มจริง) หน้าทางเข้าจึงกลายเป็นลิงก์ที่สามไปที่เดิม — ตัวหน้ายังถูก route และ
// index อยู่ ไม่ได้ลบ และมีลิงก์จาก footer
// และไม่มี /ตรวจหวย, /แนวทาง: พักยก168 เป็น **เว็บสล็อตออนไลน์** ไม่ใช่เว็บหวย
// ทั้งสองหน้านั้นจอดอยู่ใน src/pages-disabled/ รอบนี้ จึงไม่มี route ให้ลิงก์ไป
// และ verify-build จะทำให้ build แดงถ้าเหลือลิงก์ค้างไว้
//
// ไอคอนเลือกตามหมวดของแบรนด์นี้จริง ไม่ใช่ยกชุดเดิม: 🎰 ให้ทดลองเล่นเพราะบรีฟรอบนี้
// เป็นสล็อตล้วนและพูดถึง "โหมดทดลองเล่นฟรี" ตรงๆ (รอบก่อนของไฟล์นี้ใช้ 🃏 เพราะ
// GT66B นำด้วยบาคาร่าซึ่งเป็นเกมไพ่ — **บรีฟรอบนี้ไม่มีเกมไพ่เลยสักคำ**)
//
// พาเลตต์ พักยก168 (ทองมังกรบนน้ำตาลกาแฟ 2026-10-22, brand-spec §2): แบรนด์นี้เป็น
// **ทองนำ โครเมียมเงินเป็นสีประกอบบนตัวเลข** อ่านจากโลโก้ตรงๆ (หัวมังกรกับคำว่า
// พักยก เป็นทอง ส่วนเลข 168 เป็นโครเมียม) คู่ปุ่มจึงต่างกันที่ "พื้นทองตัน vs
// พื้นน้ำตาลมืดขอบทอง" ไม่ใช่ที่ระดับความสว่างของสีเดียว
// พื้นแถบ #1f0f04 (จมกว่าพื้นเพจน้ำตาลกาแฟ #291d0f ของ bg.json หนึ่งระดับ ให้
// แยกชั้นจากเนื้อหาที่เลื่อนผ่านใต้มัน) ผิวยก #4e2f11 ผิวกลาง #2f1e0f
// ทองแกน #eeae12 ทองสว่าง #fded41 ทองลึก #9f600d
// โครเมียมสว่าง #e0e0df โครเมียมหม่น #a1a09e เนื้อความ #f4ead6 (BRAND_TEXT)
// หมึกรอง #d6c6a8
// ปุ่มสมัครสมาชิกเป็นทองตันหมึกน้ำตาลเกือบดำ #1f0f04 ส่วนปุ่มเข้าสู่ระบบเป็นผิว
// น้ำตาลมืดขอบทองหมึกทองสว่าง
// ⚠️ ชุดแดงมังกร-โครเมียมของ GT66B ที่ค้างอยู่ในไฟล์นี้ (fb141b ff5f63 ffa0a2 db040b
// 8a0609 3b0405 1c0c0b 0b0303 190505 fdfcfd b4bcc2 eceaea 000000 และ
// rgba 251/20/27 α) rgba 255/160/162 α) rgba 138/6/9 α)) ออกครบทุกจุดแล้ว
// ทั้งในคลาสและใน rgba() — **รอบนี้ไม่มีแดงเลย** มีแค่ทองกับโครเมียมเงิน
// ⚠️⚠️ **กับดักรอบนี้คือทอง** — ทองผ่านรีโปนี้มาแล้วเกือบทุกเจ้า เพื่อนบ้านที่ใกล้
// ที่สุดของ #eeae12 คือ e6a416 ของ **ยูฟ้า168** (ห่าง R8/G10/B4) และ e5a81b ของ
// **UFA324** (ห่าง R9/G6/B7) ส่วน #fded41 ใกล้ fef54b ของ **นินจา168** (ห่าง R1/G8/B10)
// **ห้ามกะด้วยตาว่า "มีทองอยู่แล้ว = ของรอบนี้"** ให้เทียบเป็นตัวเลขกับ
// .claude/brand-spec-pakyok168.md §2
// ⚠️ **ยูฟ้า168 เป็นเจ้าเดียวที่เดินทอง+เงินเหมือนรอบนี้** ตัวแยกคือพื้นของเขาเป็น
// ดำสนิท 000000 ส่วนของเราเป็นน้ำตาลกาแฟ และโครเมียมของเขาเป็นเทาอมฟ้าเย็น (B>R)
// ส่วนของเราเป็นเทากลาง-อุ่น (R≥G≥B)
//
// คอนทราสต์ที่ตรวจแล้ว: #1f0f04 บนทองแกน #eeae12 ≈ 9.5:1 · บนทองสว่าง #fded41
// ≈ 15.4:1 · บนทองลึก #9f600d ≈ 4.6:1 · #f4ead6 บนพื้นแถบ #1f0f04 ≈ 15.6:1 ·
// #d6c6a8 บนพื้นแถบ ≈ 11.1:1 · #fded41 บนพื้นแถบ ≈ 15.4:1 · บนผิวกลาง #2f1e0f
// ≈ 13.2:1 · #e0e0df บนพื้นแถบ ≈ 14.1:1
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🏢" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];
---

<nav class="sticky top-0 z-50 w-full border-b border-[#eeae12]/55 bg-[#1f0f04] font-sans shadow-[0_0_20px_rgba(238,174,18,0.22)]">
  <div class="flex h-[75px] w-full items-center justify-between px-4 xl:px-8">
    <div class="z-50 flex items-center">
      <a href="/" class="group relative flex items-center">
        <div class="absolute inset-0 scale-0 rounded-full bg-[#eeae12]/20 blur-xl transition-transform duration-500 group-hover:scale-150"></div>
        {
          mainLogo ? (
            <Picture
              src={mainLogo}
              alt={logoAlt}
              loading="eager"
              fetchpriority="high"
              widths={[110, 220, 330]}
              sizes="110px"
              class="relative h-[40px] w-auto drop-shadow-[0_0_10px_rgba(238,174,18,0.4)] transition-transform group-hover:scale-105 xl:h-[45px]"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
            />
          ) : (
            <p class="relative bg-gradient-to-b from-[#fded41] via-[#eeae12] to-[#9f600d] bg-clip-text text-3xl font-black tracking-widest text-transparent italic drop-shadow-[0_0_8px_rgba(238,174,18,0.5)]">{BRAND_NAME}</p>
          )
        }
      </a>
    </div>

    <div class="z-10 hidden items-center gap-2 lg:gap-3 xl:flex">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`group relative px-5 py-2.5 skew-x-[-15deg] overflow-hidden border transition-all duration-300 ${isActive(link.path) ? "bg-[#eeae12]/20 border-[#eeae12] shadow-[0_0_15px_rgba(238,174,18,0.45)]" : "bg-white/5 border-white/10 hover:border-[#fded41]/60"}`}>
            <div
              aria-hidden="true"
              class={`absolute inset-0 bg-gradient-to-r from-[#9f600d] to-[#eeae12] translate-y-full transition-transform duration-300 ${isActive(link.path) ? "translate-y-0 opacity-20" : "group-hover:translate-y-0 opacity-40"}`}
            />
            <span class={`block skew-x-[15deg] relative z-10 text-sm font-bold tracking-wide transition-colors ${isActive(link.path) ? "text-[#fded41]" : "text-[#d6c6a8] group-hover:text-[#f4ead6]"}`}>
              <span aria-hidden="true" class="mr-1">
                {link.icon}
              </span>{" "}
              {link.name}
            </span>
          </a>
        ))
      }
    </div>

    <div class="z-50 flex items-center gap-2">
      <a
        href="/register"
        class="hidden rounded-sm skew-x-[-15deg] border border-[#fded41] bg-gradient-to-r from-[#fded41] via-[#eeae12] to-[#9f600d] px-6 py-2.5 text-sm font-black text-[#1f0f04] shadow-[0_0_15px_rgba(238,174,18,0.5)] transition-all hover:-translate-y-0.5 hover:shadow-[0_6px_20px_rgba(253,237,65,0.7)] lg:block">
        <span class="block skew-x-[15deg]">สมัครสมาชิก</span>
      </a>
      <a
        href="/login"
        class="hidden rounded-sm skew-x-[-15deg] border border-[#eeae12]/70 bg-gradient-to-r from-[#4e2f11] via-[#2f1e0f] to-[#1f0f04] px-6 py-2.5 text-sm font-black text-[#fded41] shadow-[0_0_15px_rgba(159,96,13,0.35)] transition-all hover:-translate-y-0.5 hover:shadow-[0_6px_20px_rgba(238,174,18,0.45)] lg:block">
        <span class="block skew-x-[15deg]">เข้าสู่ระบบ</span>
      </a>

      <button
        id="hamburger-btn"
        class="relative flex h-[45px] w-[45px] flex-col items-center justify-center space-y-1.5 rounded-md border border-[#eeae12]/35 bg-[#2f1e0f]/45 p-2 transition-all hover:bg-[#2f1e0f]/80 xl:hidden"
        aria-label="เปิดหรือปิดเมนู">
        <span class="hamburger-line h-[2px] w-6 origin-center bg-[#f4ead6] transition-all duration-300"></span>
        <span class="hamburger-line h-[2px] w-6 bg-[#f4ead6] transition-all duration-300"></span>
        <span class="hamburger-line h-[2px] w-6 origin-center bg-[#f4ead6] transition-all duration-300"></span>
      </button>
    </div>
  </div>

  <div id="mobile-overlay" class="pointer-events-none fixed inset-0 z-30 bg-black/80 opacity-0 backdrop-blur-sm transition-opacity duration-300 xl:hidden"></div>

  <div
    id="mobile-sidebar"
    class="fixed top-0 right-0 z-40 h-screen w-[280px] translate-x-full transform overflow-y-auto border-l border-[#eeae12]/55 bg-[#1f0f04] shadow-[-10px_0_30px_rgba(0,0,0,0.85)] transition-transform duration-300 ease-out xl:hidden">
    <div class="flex flex-col space-y-3 px-6 pt-24 pb-10">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`sidebar-item flex items-center px-4 py-3.5 rounded-lg border transition-all ${isActive(link.path) ? "bg-[#eeae12]/20 border-[#eeae12] text-[#fded41] shadow-[inset_4px_0_0_rgba(238,174,18,1)]" : "bg-white/5 border-transparent text-[#d6c6a8] hover:bg-white/10 hover:text-[#f4ead6]"}`}>
            <span aria-hidden="true" class="mr-3 text-xl">
              {link.icon}
            </span>
            <span class="text-sm font-bold">{link.name}</span>
          </a>
        ))
      }
    </div>
  </div>
</nav>

<style is:global>
  /* อนิเมชันปุ่ม Hamburger กลายเป็น X */
  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  /* อนิเมชันเด้งไล่ระดับของเมนูใน Sidebar */
  .sidebar-item {
    opacity: 0;
    transform: translateX(20px);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  /* คลาสนี้จะถูกยัดผ่าน JS เพื่อแสดงเมนู */
  .sidebar-item.item-show {
    opacity: 1;
    transform: translateX(0);
  }

  /* หน่วงเวลาให้เมนูวิ่งเข้ามาทีละอัน — มี 7 เมนู ต้องครบทั้ง 7 */
  .sidebar-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .sidebar-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .sidebar-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .sidebar-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .sidebar-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .sidebar-item:nth-child(6) {
    transition-delay: 0.35s;
  }
  .sidebar-item:nth-child(7) {
    transition-delay: 0.4s;
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar-item {
      transition: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const overlay = document.getElementById("mobile-overlay");
  const sidebar = document.getElementById("mobile-sidebar");
  const sidebarItems = document.querySelectorAll(".sidebar-item");

  const toggleMenu = () => {
    hamburgerBtn?.classList.toggle("active");

    sidebar?.classList.toggle("translate-x-full");
    sidebar?.classList.toggle("translate-x-0");

    overlay?.classList.toggle("opacity-0");
    overlay?.classList.toggle("opacity-100");
    overlay?.classList.toggle("pointer-events-none");
    overlay?.classList.toggle("pointer-events-auto");

    if (sidebar?.classList.contains("translate-x-0")) {
      document.body.style.overflow = "hidden";
      sidebarItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      sidebarItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleMenu);
  overlay?.addEventListener("click", toggleMenu);

  sidebarItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (sidebar?.classList.contains("translate-x-0")) {
        toggleMenu();
      }
    });
  });
</script>
