---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

// icon เป็น sibling ของ label เสมอ และอยู่ใน span aria-hidden — ห้ามต่อเข้าไปใน
// ข้อความ ไม่งั้น screen reader จะอ่านชื่อไอคอนนำหน้าชื่อเมนู (verify-build เช็กให้)
//
// ลำดับ: หน้าแรก · โปรโมชั่น · แล้วค่อยหน้าที่เหลือ — สมัคร/เข้าสู่ระบบ ของแบรนด์นี้
// เป็นปุ่ม CTA ในแถบ ไม่ใช่เมนู จึงไม่มีรายการทั้งสองในอาร์เรย์นี้
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "ทางเข้า", path: "/ทางเข้า", icon: "🚪" },
  { name: "ตรวจหวย", path: "/ตรวจหวย", icon: "🔍" },
  { name: "แนวทาง", path: "/แนวทาง", icon: "📈" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "📄" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "💬" },
];
---

<nav class="sticky top-0 z-50 w-full border-b border-[#7c0207]/55 bg-[#0b0203] font-sans shadow-[0_0_20px_rgba(232,18,29,0.2)]">
  <div class="flex h-[75px] w-full items-center justify-between px-4 xl:px-8">
    <div class="z-50 flex items-center">
      <a href="/" class="group relative flex items-center">
        <div class="absolute inset-0 scale-0 rounded-full bg-[#e8121d]/20 blur-xl transition-transform duration-500 group-hover:scale-150"></div>
        {
          mainLogo ? (
            <Picture
              src={mainLogo}
              alt="โลโก้ HSOD ตัวอักษรโครเมียมเงินขอบแดงเงา มีรูปข้าวหลามตัดสีแดงอยู่กลางตัว O"
              loading="eager"
              fetchpriority="high"
              widths={[110, 220, 330]}
              sizes="110px"
              class="relative h-[40px] w-auto drop-shadow-[0_0_10px_rgba(232,18,29,0.35)] transition-transform group-hover:scale-105 xl:h-[45px]"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
            />
          ) : (
            <p class="relative bg-gradient-to-b from-[#eef1f6] to-[#aeb6c2] bg-clip-text text-3xl font-black tracking-widest text-transparent italic drop-shadow-[0_0_8px_rgba(232,18,29,0.5)]">HSOD</p>
          )
        }
      </a>
    </div>

    <div class="z-10 hidden items-center gap-2 lg:gap-3 xl:flex">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`group relative px-5 py-2.5 skew-x-[-15deg] overflow-hidden border transition-all duration-300 ${isActive(link.path) ? "bg-[#e8121d]/20 border-[#e8121d] shadow-[0_0_15px_rgba(232,18,29,0.4)]" : "bg-white/5 border-white/10 hover:border-[#e8121d]/50"}`}>
            <div
              aria-hidden="true"
              class={`absolute inset-0 bg-gradient-to-r from-[#5a0104] to-[#e8121d] translate-y-full transition-transform duration-300 ${isActive(link.path) ? "translate-y-0 opacity-20" : "group-hover:translate-y-0 opacity-40"}`}
            />
            <span class={`block skew-x-[15deg] relative z-10 text-sm font-bold tracking-wide transition-colors ${isActive(link.path) ? "text-[#eef1f6]" : "text-[#aeb6c2] group-hover:text-white"}`}>
              <span aria-hidden="true" class="mr-1">
                {link.icon}
              </span>{" "}
              {link.name}
            </span>
          </a>
        ))
      }
    </div>

    <div class="z-50 flex items-center gap-2">
      <a
        href="/register"
        class="hidden rounded-sm skew-x-[-15deg] border border-[#ff4d55] bg-gradient-to-r from-[#ff4d55] via-[#e8121d] to-[#7c0207] px-6 py-2.5 text-sm font-black text-white shadow-[0_0_15px_rgba(232,18,29,0.45)] transition-all hover:-translate-y-0.5 hover:shadow-[0_6px_20px_rgba(232,18,29,0.65)] lg:block">
        <span class="block skew-x-[15deg]">สมัครสมาชิก</span>
      </a>
      <a
        href="/login"
        class="hidden rounded-sm skew-x-[-15deg] border border-[#c2c9d4]/45 bg-[#170406] px-6 py-2.5 text-sm font-bold text-[#c2c9d4] transition-all hover:border-[#e8121d]/70 hover:text-white lg:block">
        <span class="block skew-x-[15deg]">เข้าสู่ระบบ</span>
      </a>

      <button
        id="hamburger-btn"
        class="relative flex h-[45px] w-[45px] flex-col items-center justify-center space-y-1.5 rounded-md border border-[#e8121d]/35 bg-[#5a0104]/25 p-2 transition-all hover:bg-[#5a0104]/45 xl:hidden"
        aria-label="เปิดหรือปิดเมนู">
        <span class="hamburger-line h-[2px] w-6 origin-center bg-[#eef1f6] transition-all duration-300"></span>
        <span class="hamburger-line h-[2px] w-6 bg-[#eef1f6] transition-all duration-300"></span>
        <span class="hamburger-line h-[2px] w-6 origin-center bg-[#eef1f6] transition-all duration-300"></span>
      </button>
    </div>
  </div>

  <div id="mobile-overlay" class="pointer-events-none fixed inset-0 z-30 bg-black/80 opacity-0 backdrop-blur-sm transition-opacity duration-300 xl:hidden"></div>

  <div
    id="mobile-sidebar"
    class="fixed top-0 right-0 z-40 h-screen w-[280px] translate-x-full transform overflow-y-auto border-l border-[#7c0207]/55 bg-[#0b0203] shadow-[-10px_0_30px_rgba(0,0,0,0.8)] transition-transform duration-300 ease-out xl:hidden">
    <div class="flex flex-col space-y-3 px-6 pt-24 pb-10">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`sidebar-item flex items-center px-4 py-3.5 rounded-lg border transition-all ${isActive(link.path) ? "bg-[#e8121d]/20 border-[#e8121d] text-[#eef1f6] shadow-[inset_4px_0_0_rgba(232,18,29,1)]" : "bg-white/5 border-transparent text-[#aeb6c2] hover:bg-white/10 hover:text-white"}`}>
            <span aria-hidden="true" class="mr-3 text-xl">
              {link.icon}
            </span>
            <span class="text-sm font-bold">{link.name}</span>
          </a>
        ))
      }
    </div>
  </div>
</nav>

<style is:global>
  /* อนิเมชันปุ่ม Hamburger กลายเป็น X */
  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  /* อนิเมชันเด้งไล่ระดับของเมนูใน Sidebar */
  .sidebar-item {
    opacity: 0;
    transform: translateX(20px);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  /* คลาสนี้จะถูกยัดผ่าน JS เพื่อแสดงเมนู */
  .sidebar-item.item-show {
    opacity: 1;
    transform: translateX(0);
  }

  /* หน่วงเวลาให้เมนูวิ่งเข้ามาทีละอัน — มี 7 เมนู ต้องครบทั้ง 7 */
  .sidebar-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .sidebar-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .sidebar-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .sidebar-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .sidebar-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .sidebar-item:nth-child(6) {
    transition-delay: 0.35s;
  }
  .sidebar-item:nth-child(7) {
    transition-delay: 0.4s;
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar-item {
      transition: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const overlay = document.getElementById("mobile-overlay");
  const sidebar = document.getElementById("mobile-sidebar");
  const sidebarItems = document.querySelectorAll(".sidebar-item");

  const toggleMenu = () => {
    hamburgerBtn?.classList.toggle("active");

    sidebar?.classList.toggle("translate-x-full");
    sidebar?.classList.toggle("translate-x-0");

    overlay?.classList.toggle("opacity-0");
    overlay?.classList.toggle("opacity-100");
    overlay?.classList.toggle("pointer-events-none");
    overlay?.classList.toggle("pointer-events-auto");

    if (sidebar?.classList.contains("translate-x-0")) {
      document.body.style.overflow = "hidden";
      sidebarItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      sidebarItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleMenu);
  overlay?.addEventListener("click", toggleMenu);

  sidebarItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (sidebar?.classList.contains("translate-x-0")) {
        toggleMenu();
      }
    });
  });
</script>
