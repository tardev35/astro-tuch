---
import { isActivePath } from "../lib/nav";
import { BRAND_NAME } from "../lib/brandProfile";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

// เขียนจากไฟล์ logo.webp ของดรอป 2026-10-23 จริง — หัวมังกรสามมิติสีทองของ พักยก168
// ที่เคยอยู่ในตัวแปรนี้ไม่มีอยู่ในรูปรอบนี้เลย รอบนี้เป็น **ภาพคนคู่เวิร์ดมาร์ก**
// และ **ไม่มีทองสักจุด**
const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส ด้านซ้ายเป็นภาพครึ่งตัวผู้หญิงวัยกลางคนผมสั้นดัดลอนสีขาวเงิน ขยิบตาข้างหนึ่งและยิ้มกว้าง ทาลิปสติกสีแดง ใส่ต่างหูห่วงสีเงินและเสื้อสีน้ำเงิน ยกมือขวาขึ้นทำท่ามินิฮาร์ทใกล้คาง ถัดมาทางขวาเป็นเวิร์ดมาร์ก ${BRAND_NAME} โดยคำว่า มาดาม เป็นตัวอักษรไทยหนาสามมิติผิวมันวาวสีฟ้าอมน้ำเงินไล่เฉดจากฟ้าสว่างที่ยอดลงไปหาน้ำเงินเข้มที่ฐาน ต่อท้ายด้วยเลข 168 ผิวมันวาวสีแดงสดไล่เฉดแบบเดียวกัน ทั้งชุดตัดขอบเงินโครเมียมซ้อนขอบน้ำเงินเข้ม และมีประกายแสงสีขาวพาดอยู่บนผิวตัวอักษร`;

// icon เป็น sibling ของ label เสมอ และอยู่ใน span aria-hidden — ห้ามต่อเข้าไปใน
// ข้อความ ไม่งั้น screen reader จะอ่านชื่อไอคอนนำหน้าชื่อเมนู (verify-build เช็กให้)
//
// ลำดับ: หน้าแรก · โปรโมชั่น · สมัครสมาชิก · เข้าสู่ระบบ · แล้วค่อยหน้าอ่าน —
// สองรายการกลางเป็นปุ่มคอนเวอร์ชัน จึงต้องอยู่ก่อนหน้าที่ไว้อ่าน
//
// เมนูชุดนี้ถูกประกาศครั้งเดียวตรงนี้ แล้ว render ทั้งแถบ desktop และ drawer
// มือถือจากตัวเดียวกัน — ถ้าแยกสองชุดเมื่อไหร่ มันจะเพี้ยนกันเองรอบถัดไป
//
// ไม่มี /ทางเข้า ในเมนู: แบรนด์นี้เปิด cta toggle ทั้งคู่ (login/register เป็นหน้า
// ปุ่มจริง) หน้าทางเข้าจึงกลายเป็นลิงก์ที่สามไปที่เดิม — ตัวหน้ายังถูก route และ
// index อยู่ ไม่ได้ลบ และมีลิงก์จาก footer
// และไม่มี /ตรวจหวย, /แนวทาง: มาดาม168 เป็น **เว็บสล็อตออนไลน์** ไม่ใช่เว็บหวย
// ทั้งสองหน้านั้นจอดอยู่ใน src/pages-disabled/ รอบนี้ จึงไม่มี route ให้ลิงก์ไป
// และ verify-build จะทำให้ build แดงถ้าเหลือลิงก์ค้างไว้
//
// ไอคอนตรงกับหมวดของแบรนด์นี้: 🎰 ให้ทดลองเล่นเพราะบรีฟรอบนี้เป็น **เกมสล็อตล้วน**
// (บรีฟไม่มีเกมไพ่ ไม่มีบาคาร่า ไม่มีหวย ไม่มีกีฬาเลยสักคำ)
//
// พาเลตต์ มาดาม168 (แดงคริมสันนำ-น้ำเงินอะซัวร์รอง 2026-10-23, brand-spec §2):
// แบรนด์นี้เป็น **แดงนำ น้ำเงินอะซัวร์เป็นวัสดุที่สอง** อ่านจากโลโก้ตรงๆ (คำว่า
// "มาดาม" เป็นฟ้าอมน้ำเงิน ส่วนเลข "168" เป็นแดงสด) คู่ปุ่มจึงต่างกันที่ "พื้นแดงตัน
// vs พื้นน้ำเงินมืดขอบแดง" ไม่ใช่ที่ระดับความสว่างของสีเดียว
// พื้นแถบ #050e26 (จมกว่าพื้นเพจน้ำเงินเที่ยงคืน #00091f ของ bg.json หนึ่งระดับ ให้
// แยกชั้นจากเนื้อหาที่เลื่อนผ่านใต้มัน) ผิวยก #16234a ผิวกลาง #0b1733 เส้น #2a3c70
// แดงแกน #ff2e52 แดงพื้นปุ่ม #e01238 แดงลึก #c9102f
// น้ำเงินอะซัวร์ #1177e8 / #0e68cc / #0a4ea8 แพลทินัม #d9dfe9
// เนื้อความ #f4eef1 (BRAND_TEXT) หมึกรอง #b3bdd6
// ปุ่มสมัครสมาชิกเป็นแดงตันหมึกขาว ส่วนปุ่มเข้าสู่ระบบเป็นผิวน้ำเงินมืดขอบแดง
// หมึกแดงแกน
// ⚠️⚠️ **#ff2e52 รับหมึกขาวได้แค่ 3.6:1 (ตก AA)** พื้นปุ่มที่รองหมึกขาวจึงเริ่มที่
// #e01238 (4.9:1) และจบที่ #c9102f (6.3:1) — **#ff2e52 เป็นขอบ ออรา และตัวอักษร
// บนผิวมืดเท่านั้น ห้ามเป็นพื้นที่รองหมึกขาว**
// ⚠️ **#1177e8 #0e68cc #0a4ea8 #c9102f #2a3c70 ห้ามถือตัวอักษรในไฟล์นี้**
// ⚠️ ชุดทองมังกร-โครเมียมเงินของ พักยก168 ที่ค้างอยู่ในไฟล์นี้ (eeae12 fded41 9f600d
// e0e0df c0c0bf a1a09e f4ead6 d6c6a8 1f0f04 2f1e0f 4e2f11 291d0f และ
// rgba 238/174/18 α) rgba 253/237/65 α) rgba 159/96/13 α) rgba 224/224/223 α))
// และชุดแดงมังกร-โครเมียมของ GT66B ก่อนหน้านั้น (fb141b ff5f63 ffa0a2 db040b
// 8a0609 3b0405 1c0c0b 0b0303 190505 fdfcfd b4bcc2 eceaea 000000) ออกครบทุกจุดแล้ว
// ทั้งในคลาสและใน rgba() — **รอบนี้ไม่มีทองเลย มีแค่แดงกับน้ำเงินอะซัวร์**
// ⚠️⚠️ **กับดักรอบนี้คือแดง — GT66B เคยเป็นเจ้าของไฟล์นี้ด้วยชุด "แดงมังกร-โครเมียม"
// ซึ่งเป็นทิศใกล้รอบนี้** การเจอแดงในไฟล์นี้จึงไม่พิสูจน์อะไรเลย **ต้องเทียบเป็นค่า
// ทีละค่า**: #ff2e52 ห่าง ff5f63 ของ GT66B R0/G49/B11 · ห่าง fb141b R4/G26/B55 ·
// ห่าง ff4446 ของโปรดี168 R0/G22/B12 · ห่าง fb1b32 ของมีเฮ168 R4/G19/B32 ·
// ห่าง f5282a ของหวย365 R10/G6/B40 · ห่าง d9212a ของดวงเศรษฐี168 R38/G13/B40
// ⚠️⚠️ **และฟ้าเคยนำมาแล้วเจ็ดเจ้าในรีโปนี้** จึงเป็นเหตุผลที่รอบนี้ลดน้ำเงินลงเป็น
// วัสดุที่สองที่ไม่ถือตัวอักษร: 1fd8f0 1d4fd8 (นาซ่า168 รอบก่อนทันที) · 18a5e2
// 31408a (ร่ำรวย168) · 2cc3fc 6bdcfb (สบาย168) · 32bcfb (นินจา168) · 039cfa
// (รวยแทร่168) · 2f9ff5 (สบายเบท168) · 0360f3 0292fb 6ec8ff 4fb4ff (TSDET911)
// ⚠️ **แรมป์เทาเงินห้ามกลับเข้ามา** — ผมสีขาวเงินกับขอบโครเมียมของเวิร์ดมาร์กเป็น
// วัตถุในภาพ และแรมป์เงินเป็นของ พักยก168 · ยูฟ้า168 · UFA324 · GT66B ไปแล้ว
// รอบนี้มีแพลทินัม #d9dfe9 ค่าเดียว ซึ่งเป็นค่าใหม่ ไม่อยู่ในลิสต์นั้น
// (เฮกซ์ของแบรนด์เก่าเขียนแบบ **ไม่มี #** โดยตั้งใจ เพื่อไม่ให้ sweep ที่ไล่หาสีเก่า
// สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
//
// คอนทราสต์ที่ตรวจแล้ว: #ffffff บนแดงพื้นปุ่ม #e01238 ≈ 4.9:1 · บนแดงลึก #c9102f
// ≈ 6.3:1 · #f4eef1 บนพื้นแถบ #050e26 ≈ 16.6:1 · บนผิวยก #16234a ≈ 12.7:1 ·
// #b3bdd6 บนพื้นแถบ ≈ 10.0:1 · #ff2e52 บนพื้นแถบ ≈ 5.2:1 · บนผิวกลาง #0b1733
// ≈ 4.9:1 · #d9dfe9 บนพื้นแถบ ≈ 14.2:1
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🏢" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];
---

<nav class="sticky top-0 z-50 w-full border-b border-[#ff2e52]/55 bg-[#050e26] font-sans shadow-[0_0_20px_rgba(255,46,82,0.22)]">
  <div class="flex h-[75px] w-full items-center justify-between px-4 xl:px-8">
    <div class="z-50 flex items-center">
      <a href="/" class="group relative flex items-center">
        <div class="absolute inset-0 scale-0 rounded-full bg-[#ff2e52]/20 blur-xl transition-transform duration-500 group-hover:scale-150"></div>
        {
          mainLogo ? (
            <Picture
              src={mainLogo}
              alt={logoAlt}
              loading="eager"
              fetchpriority="high"
              widths={[110, 220, 330]}
              sizes="110px"
              class="relative h-[40px] w-auto drop-shadow-[0_0_10px_rgba(255,46,82,0.4)] transition-transform group-hover:scale-105 xl:h-[45px]"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
            />
          ) : (
            <p class="relative bg-gradient-to-b from-[#d9dfe9] via-[#ff2e52] to-[#c9102f] bg-clip-text text-3xl font-black tracking-widest text-transparent italic drop-shadow-[0_0_8px_rgba(255,46,82,0.5)]">{BRAND_NAME}</p>
          )
        }
      </a>
    </div>

    <div class="z-10 hidden items-center gap-2 lg:gap-3 xl:flex">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`group relative px-5 py-2.5 skew-x-[-15deg] overflow-hidden border transition-all duration-300 ${isActive(link.path) ? "bg-[#ff2e52]/20 border-[#ff2e52] shadow-[0_0_15px_rgba(255,46,82,0.45)]" : "bg-white/5 border-white/10 hover:border-[#ff2e52]/60"}`}>
            <div
              aria-hidden="true"
              class={`absolute inset-0 bg-gradient-to-r from-[#0a4ea8] to-[#1177e8] translate-y-full transition-transform duration-300 ${isActive(link.path) ? "translate-y-0 opacity-20" : "group-hover:translate-y-0 opacity-40"}`}
            />
            <span class={`block skew-x-[15deg] relative z-10 text-sm font-bold tracking-wide transition-colors ${isActive(link.path) ? "text-[#ff2e52]" : "text-[#b3bdd6] group-hover:text-[#f4eef1]"}`}>
              <span aria-hidden="true" class="mr-1">
                {link.icon}
              </span>{" "}
              {link.name}
            </span>
          </a>
        ))
      }
    </div>

    <div class="z-50 flex items-center gap-2">
      <a
        href="/register"
        class="hidden rounded-sm skew-x-[-15deg] border border-[#ff2e52] bg-gradient-to-r from-[#e01238] via-[#d61134] to-[#c9102f] px-6 py-2.5 text-sm font-black text-white shadow-[0_0_15px_rgba(255,46,82,0.5)] transition-all hover:-translate-y-0.5 hover:shadow-[0_6px_20px_rgba(255,46,82,0.7)] lg:block">
        <span class="block skew-x-[15deg]">สมัครสมาชิก</span>
      </a>
      <a
        href="/login"
        class="hidden rounded-sm skew-x-[-15deg] border border-[#ff2e52]/70 bg-gradient-to-r from-[#16234a] via-[#0b1733] to-[#050e26] px-6 py-2.5 text-sm font-black text-[#ff2e52] shadow-[0_0_15px_rgba(10,78,168,0.35)] transition-all hover:-translate-y-0.5 hover:shadow-[0_6px_20px_rgba(255,46,82,0.45)] lg:block">
        <span class="block skew-x-[15deg]">เข้าสู่ระบบ</span>
      </a>

      <button
        id="hamburger-btn"
        class="relative flex h-[45px] w-[45px] flex-col items-center justify-center space-y-1.5 rounded-md border border-[#ff2e52]/35 bg-[#0b1733]/45 p-2 transition-all hover:bg-[#0b1733]/80 xl:hidden"
        aria-label="เปิดหรือปิดเมนู">
        <span class="hamburger-line h-[2px] w-6 origin-center bg-[#f4eef1] transition-all duration-300"></span>
        <span class="hamburger-line h-[2px] w-6 bg-[#f4eef1] transition-all duration-300"></span>
        <span class="hamburger-line h-[2px] w-6 origin-center bg-[#f4eef1] transition-all duration-300"></span>
      </button>
    </div>
  </div>

  <div id="mobile-overlay" class="pointer-events-none fixed inset-0 z-30 bg-black/80 opacity-0 backdrop-blur-sm transition-opacity duration-300 xl:hidden"></div>

  <div
    id="mobile-sidebar"
    class="fixed top-0 right-0 z-40 h-screen w-[280px] translate-x-full transform overflow-y-auto border-l border-[#ff2e52]/55 bg-[#050e26] shadow-[-10px_0_30px_rgba(0,0,0,0.85)] transition-transform duration-300 ease-out xl:hidden">
    <div class="flex flex-col space-y-3 px-6 pt-24 pb-10">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`sidebar-item flex items-center px-4 py-3.5 rounded-lg border transition-all ${isActive(link.path) ? "bg-[#ff2e52]/20 border-[#ff2e52] text-[#ff2e52] shadow-[inset_4px_0_0_rgba(255,46,82,1)]" : "bg-white/5 border-transparent text-[#b3bdd6] hover:bg-white/10 hover:text-[#f4eef1]"}`}>
            <span aria-hidden="true" class="mr-3 text-xl">
              {link.icon}
            </span>
            <span class="text-sm font-bold">{link.name}</span>
          </a>
        ))
      }
    </div>
  </div>
</nav>

<style is:global>
  /* อนิเมชันปุ่ม Hamburger กลายเป็น X */
  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  /* อนิเมชันเด้งไล่ระดับของเมนูใน Sidebar */
  .sidebar-item {
    opacity: 0;
    transform: translateX(20px);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  /* คลาสนี้จะถูกยัดผ่าน JS เพื่อแสดงเมนู */
  .sidebar-item.item-show {
    opacity: 1;
    transform: translateX(0);
  }

  /* หน่วงเวลาให้เมนูวิ่งเข้ามาทีละอัน — มี 7 เมนู ต้องครบทั้ง 7 */
  .sidebar-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .sidebar-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .sidebar-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .sidebar-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .sidebar-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .sidebar-item:nth-child(6) {
    transition-delay: 0.35s;
  }
  .sidebar-item:nth-child(7) {
    transition-delay: 0.4s;
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar-item {
      transition: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const overlay = document.getElementById("mobile-overlay");
  const sidebar = document.getElementById("mobile-sidebar");
  const sidebarItems = document.querySelectorAll(".sidebar-item");

  const toggleMenu = () => {
    hamburgerBtn?.classList.toggle("active");

    sidebar?.classList.toggle("translate-x-full");
    sidebar?.classList.toggle("translate-x-0");

    overlay?.classList.toggle("opacity-0");
    overlay?.classList.toggle("opacity-100");
    overlay?.classList.toggle("pointer-events-none");
    overlay?.classList.toggle("pointer-events-auto");

    if (sidebar?.classList.contains("translate-x-0")) {
      document.body.style.overflow = "hidden";
      sidebarItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      sidebarItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleMenu);
  overlay?.addEventListener("click", toggleMenu);

  sidebarItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (sidebar?.classList.contains("translate-x-0")) {
        toggleMenu();
      }
    });
  });
</script>
