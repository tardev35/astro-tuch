---
import { isActivePath } from "../lib/nav";
import { BRAND_NAME } from "../lib/brandProfile";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

const logoAlt =
  "โลโก้ TND168 เป็นเหรียญตรากลมพื้นดำ มีมังกรจีนสีทองขัดเงาขดตัวล้อมรอบ หัวมังกรหันไปทางขวาและอ้าปาก เกล็ดกับหนวดเก็บรายละเอียดเป็นประกายทอง ด้านล่างเป็นลายเมฆทอง และพาดกลางเหรียญเป็นคำว่า TND168 ตัวอักษรเซริฟสีทองสามมิติขอบหนา";

// icon เป็น sibling ของ label เสมอ และอยู่ใน span aria-hidden — ห้ามต่อเข้าไปใน
// ข้อความ ไม่งั้น screen reader จะอ่านชื่อไอคอนนำหน้าชื่อเมนู (verify-build เช็กให้)
//
// ลำดับ: หน้าแรก · โปรโมชั่น · สมัครสมาชิก · เข้าสู่ระบบ · แล้วค่อยหน้าอ่าน —
// สองรายการกลางเป็นปุ่มคอนเวอร์ชัน จึงต้องอยู่ก่อนหน้าที่ไว้อ่าน
//
// ไม่มี /ทางเข้า ในเมนู: แบรนด์นี้เปิด cta toggle ทั้งคู่ (login/register เป็นหน้า
// ปุ่มจริง) หน้าทางเข้าจึงกลายเป็นลิงก์ที่สามไปที่เดิม — ตัวหน้ายังถูก route และ
// index อยู่ ไม่ได้ลบ และมีลิงก์จาก footer และไม่มี /ตรวจหวย, /แนวทาง: TND168
// เป็นแบรนด์คาสิโนรวมทุกหมวด (บาคาร่า สล็อต รูเล็ต ไฮโล แทงบอล + ไลฟ์สด) ไม่ใช่
// เว็บหวย ทั้งสองหน้านั้นจอดอยู่ใน src/pages-disabled/ รอบนี้ จึงไม่มี route ให้ลิงก์ไป
//
// ไอคอนเลือกตามหมวดของแบรนด์นี้จริง ไม่ใช่ยกชุดเดิม: 🎴 ให้ทดลองเล่นเพราะแบรนด์นี้
// นำด้วยบาคาร่าและเกมไพ่ ไม่ใช่สล็อตล้วนแบบรอบก่อน
//
// พาเลตต์ TND168 (ทองมังกรบนดำสนิท 2026-10-12, brand-spec §2): แบรนด์นี้เป็น
// "ฮิวเดียวล้วน" ไม่มีสีที่สองเลย — โลโก้เป็นเหรียญตรามังกรทองกับตัวอักษร TND168
// ทองสามมิติบนพื้นดำ ไม่มีโลหะที่สอง ไม่มีชมพู ไม่มีเงิน คู่ปุ่มจึงต่างกันที่
// "ทองสว่าง/ทองเข้ม" ของทองเดียวกัน
// พื้นดำสนิท #000000 (ตรงกับ bg.json รอบนี้) ผิวยก #1b1307 ผิวกลาง #120c04
// ผิวจม #070502 ทองหลัก #dfa310 ทองสว่าง #ffe4a3 ทองไฮไลต์ #ffc93d ทองลึก
// #8a5c09 บรอนซ์ลึก #43240b เนื้อความ #f0e9dc (BRAND_TEXT) ตอนไม่ active ลดเป็น
// งาช้างหม่น #c9b88e ปุ่มสมัครสมาชิกเป็นทองตันหมึก #140d02 ส่วนปุ่มเข้าสู่ระบบ
// เป็นผิวเข้มขอบทองหมึกทองสว่าง
// ⚠️ ชุดทองเมทัลลิก-บรอนซ์ของ 789BETTING ที่ค้างอยู่ในไฟล์นี้ (#fad354 #ffe79a
// #ddab33 #8a6410 #c9881f #f3e7cd #b5a888 #060402 #0a0802 #2a2008 #3a2c0b
// #17130a rgba(250,211,84,α) rgba(255,231,154,α) rgba(201,136,31,α)) ออกครบ
// ทุกจุดแล้ว ทั้งในคลาสและใน rgba() — ทองรอบนี้เป็นคนละค่า ให้เทียบเป็นตัวเลข
// ห้ามกะด้วยตาว่า "มีทองอยู่แล้ว = ของรอบนี้"
//
// คอนทราสต์ที่ตรวจแล้ว: #140d02 บนทอง #ffc93d ≈ 12.8:1 · #ffe4a3 บนผิวกลาง
// #120c04 ≈ 14.6:1 · #c9b88e บนดำ #000000 ≈ 10.4:1 · #f0e9dc บนดำ #000000 ≈ 18.3:1
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎴" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🏢" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];
---

<nav class="sticky top-0 z-50 w-full border-b border-[#dfa310]/55 bg-[#000000] font-sans shadow-[0_0_20px_rgba(223,163,16,0.22)]">
  <div class="flex h-[75px] w-full items-center justify-between px-4 xl:px-8">
    <div class="z-50 flex items-center">
      <a href="/" class="group relative flex items-center">
        <div class="absolute inset-0 scale-0 rounded-full bg-[#dfa310]/20 blur-xl transition-transform duration-500 group-hover:scale-150"></div>
        {
          mainLogo ? (
            <Picture
              src={mainLogo}
              alt={logoAlt}
              loading="eager"
              fetchpriority="high"
              widths={[110, 220, 330]}
              sizes="110px"
              class="relative h-[40px] w-auto drop-shadow-[0_0_10px_rgba(223,163,16,0.4)] transition-transform group-hover:scale-105 xl:h-[45px]"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
            />
          ) : (
            <p class="relative bg-gradient-to-b from-[#ffe4a3] via-[#ffc93d] to-[#8a5c09] bg-clip-text text-3xl font-black tracking-widest text-transparent italic drop-shadow-[0_0_8px_rgba(223,163,16,0.5)]">{BRAND_NAME}</p>
          )
        }
      </a>
    </div>

    <div class="z-10 hidden items-center gap-2 lg:gap-3 xl:flex">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`group relative px-5 py-2.5 skew-x-[-15deg] overflow-hidden border transition-all duration-300 ${isActive(link.path) ? "bg-[#dfa310]/20 border-[#dfa310] shadow-[0_0_15px_rgba(223,163,16,0.45)]" : "bg-white/5 border-white/10 hover:border-[#ffe4a3]/60"}`}>
            <div
              aria-hidden="true"
              class={`absolute inset-0 bg-gradient-to-r from-[#8a5c09] to-[#dfa310] translate-y-full transition-transform duration-300 ${isActive(link.path) ? "translate-y-0 opacity-20" : "group-hover:translate-y-0 opacity-40"}`}
            />
            <span class={`block skew-x-[15deg] relative z-10 text-sm font-bold tracking-wide transition-colors ${isActive(link.path) ? "text-[#ffe4a3]" : "text-[#c9b88e] group-hover:text-[#f0e9dc]"}`}>
              <span aria-hidden="true" class="mr-1">
                {link.icon}
              </span>{" "}
              {link.name}
            </span>
          </a>
        ))
      }
    </div>

    <div class="z-50 flex items-center gap-2">
      <a
        href="/register"
        class="hidden rounded-sm skew-x-[-15deg] border border-[#ffe4a3] bg-gradient-to-r from-[#ffe4a3] via-[#ffc93d] to-[#dfa310] px-6 py-2.5 text-sm font-black text-[#140d02] shadow-[0_0_15px_rgba(223,163,16,0.5)] transition-all hover:-translate-y-0.5 hover:shadow-[0_6px_20px_rgba(255,228,163,0.7)] lg:block">
        <span class="block skew-x-[15deg]">สมัครสมาชิก</span>
      </a>
      <a
        href="/login"
        class="hidden rounded-sm skew-x-[-15deg] border border-[#dfa310]/70 bg-gradient-to-r from-[#2b1f08] via-[#1b1307] to-[#070502] px-6 py-2.5 text-sm font-black text-[#ffe4a3] shadow-[0_0_15px_rgba(138,92,9,0.35)] transition-all hover:-translate-y-0.5 hover:shadow-[0_6px_20px_rgba(223,163,16,0.45)] lg:block">
        <span class="block skew-x-[15deg]">เข้าสู่ระบบ</span>
      </a>

      <button
        id="hamburger-btn"
        class="relative flex h-[45px] w-[45px] flex-col items-center justify-center space-y-1.5 rounded-md border border-[#dfa310]/35 bg-[#1b1307]/45 p-2 transition-all hover:bg-[#1b1307]/80 xl:hidden"
        aria-label="เปิดหรือปิดเมนู">
        <span class="hamburger-line h-[2px] w-6 origin-center bg-[#f0e9dc] transition-all duration-300"></span>
        <span class="hamburger-line h-[2px] w-6 bg-[#f0e9dc] transition-all duration-300"></span>
        <span class="hamburger-line h-[2px] w-6 origin-center bg-[#f0e9dc] transition-all duration-300"></span>
      </button>
    </div>
  </div>

  <div id="mobile-overlay" class="pointer-events-none fixed inset-0 z-30 bg-black/80 opacity-0 backdrop-blur-sm transition-opacity duration-300 xl:hidden"></div>

  <div
    id="mobile-sidebar"
    class="fixed top-0 right-0 z-40 h-screen w-[280px] translate-x-full transform overflow-y-auto border-l border-[#dfa310]/55 bg-[#000000] shadow-[-10px_0_30px_rgba(0,0,0,0.85)] transition-transform duration-300 ease-out xl:hidden">
    <div class="flex flex-col space-y-3 px-6 pt-24 pb-10">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`sidebar-item flex items-center px-4 py-3.5 rounded-lg border transition-all ${isActive(link.path) ? "bg-[#dfa310]/20 border-[#dfa310] text-[#ffe4a3] shadow-[inset_4px_0_0_rgba(255,228,163,1)]" : "bg-white/5 border-transparent text-[#c9b88e] hover:bg-white/10 hover:text-[#f0e9dc]"}`}>
            <span aria-hidden="true" class="mr-3 text-xl">
              {link.icon}
            </span>
            <span class="text-sm font-bold">{link.name}</span>
          </a>
        ))
      }
    </div>
  </div>
</nav>

<style is:global>
  /* อนิเมชันปุ่ม Hamburger กลายเป็น X */
  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  /* อนิเมชันเด้งไล่ระดับของเมนูใน Sidebar */
  .sidebar-item {
    opacity: 0;
    transform: translateX(20px);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  /* คลาสนี้จะถูกยัดผ่าน JS เพื่อแสดงเมนู */
  .sidebar-item.item-show {
    opacity: 1;
    transform: translateX(0);
  }

  /* หน่วงเวลาให้เมนูวิ่งเข้ามาทีละอัน — มี 7 เมนู ต้องครบทั้ง 7 */
  .sidebar-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .sidebar-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .sidebar-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .sidebar-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .sidebar-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .sidebar-item:nth-child(6) {
    transition-delay: 0.35s;
  }
  .sidebar-item:nth-child(7) {
    transition-delay: 0.4s;
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar-item {
      transition: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const overlay = document.getElementById("mobile-overlay");
  const sidebar = document.getElementById("mobile-sidebar");
  const sidebarItems = document.querySelectorAll(".sidebar-item");

  const toggleMenu = () => {
    hamburgerBtn?.classList.toggle("active");

    sidebar?.classList.toggle("translate-x-full");
    sidebar?.classList.toggle("translate-x-0");

    overlay?.classList.toggle("opacity-0");
    overlay?.classList.toggle("opacity-100");
    overlay?.classList.toggle("pointer-events-none");
    overlay?.classList.toggle("pointer-events-auto");

    if (sidebar?.classList.contains("translate-x-0")) {
      document.body.style.overflow = "hidden";
      sidebarItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      sidebarItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleMenu);
  overlay?.addEventListener("click", toggleMenu);

  sidebarItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (sidebar?.classList.contains("translate-x-0")) {
        toggleMenu();
      }
    });
  });
</script>
