---
import { isActivePath } from "../lib/nav";
import { BRAND_NAME } from "../lib/brandProfile";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

const logoAlt = "โลโก้ SAGAME66 ตัวอักษร SA สีทองสามมิติเงาวาว ต่อด้วยคำว่า GAME สีเงินโครเมียม และตัวเลข 66 สีทองสามมิติ เรียงติดกันเป็นบรรทัดเดียวบนพื้นโปร่ง";

// icon เป็น sibling ของ label เสมอ และอยู่ใน span aria-hidden — ห้ามต่อเข้าไปใน
// ข้อความ ไม่งั้น screen reader จะอ่านชื่อไอคอนนำหน้าชื่อเมนู (verify-build เช็กให้)
//
// ลำดับ: หน้าแรก · โปรโมชั่น · สมัครสมาชิก · เข้าสู่ระบบ · แล้วค่อยหน้าอ่าน —
// สองรายการกลางเป็นปุ่มคอนเวอร์ชัน จึงต้องอยู่ก่อนหน้าที่ไว้อ่าน
//
// ไม่มี /ทางเข้า ในเมนู: แบรนด์นี้เปิด cta toggle ทั้งคู่ (login/register เป็นหน้า
// ปุ่มจริง) หน้าทางเข้าจึงกลายเป็นลิงก์ที่สามไปที่เดิม — ตัวหน้ายังถูก route และ
// index อยู่ ไม่ได้ลบ และมีลิงก์จาก footer และไม่มี /ตรวจหวย, /แนวทาง: SAGAME66
// เป็นเว็บบาคาร่า/รูเล็ต/คาสิโนสด ไม่ใช่เว็บหวย ทั้งสองหน้านั้นจอดอยู่ใน
// src/pages-disabled/ รอบนี้ จึงไม่มี route ให้ลิงก์ไป
//
// พาเลตต์ SAGAME66 (ทอง-เงินโครเมียม 2026-09-23): พื้นน้ำตาลเกือบดำ #0d0903
// ลิงก์เป็นสี่เหลี่ยมเฉียงขอบทองหลัก #e8b93f ตัวที่ active เรืองทองสว่าง #ffe9a3
// ป้ายสมัครสมาชิกไล่จากทองสว่างลงทองลึก #96671a ตัวหนังสือบนป้ายเป็นสีพื้น
// #0d0903 เพื่อให้อ่านได้บนทอง เนื้อความ #e3d8c0 ลดน้ำหนักเป็น #b6c1cd ตอนไม่
// active — โทนทอง #ecc55c/#fefac4/#a3732c บนพื้น #070605 ของ HENG35 ที่เคยอยู่
// ในไฟล์นี้ถูกแทนครบทุกจุดแล้ว
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🃏" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "👑" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];
---

<nav class="sticky top-0 z-50 w-full border-b border-[#e8b93f]/55 bg-[#0d0903] font-sans shadow-[0_0_20px_rgba(232,185,63,0.22)]">
  <div class="flex h-[75px] w-full items-center justify-between px-4 xl:px-8">
    <div class="z-50 flex items-center">
      <a href="/" class="group relative flex items-center">
        <div class="absolute inset-0 scale-0 rounded-full bg-[#e8b93f]/20 blur-xl transition-transform duration-500 group-hover:scale-150"></div>
        {
          mainLogo ? (
            <Picture
              src={mainLogo}
              alt={logoAlt}
              loading="eager"
              fetchpriority="high"
              widths={[110, 220, 330]}
              sizes="110px"
              class="relative h-[40px] w-auto drop-shadow-[0_0_10px_rgba(232,185,63,0.4)] transition-transform group-hover:scale-105 xl:h-[45px]"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
            />
          ) : (
            <p class="relative bg-gradient-to-b from-[#ffe9a3] via-[#eef3f8] to-[#96671a] bg-clip-text text-3xl font-black tracking-widest text-transparent italic drop-shadow-[0_0_8px_rgba(232,185,63,0.5)]">{BRAND_NAME}</p>
          )
        }
      </a>
    </div>

    <div class="z-10 hidden items-center gap-2 lg:gap-3 xl:flex">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`group relative px-5 py-2.5 skew-x-[-15deg] overflow-hidden border transition-all duration-300 ${isActive(link.path) ? "bg-[#e8b93f]/20 border-[#e8b93f] shadow-[0_0_15px_rgba(232,185,63,0.45)]" : "bg-white/5 border-white/10 hover:border-[#ffe9a3]/60"}`}>
            <div
              aria-hidden="true"
              class={`absolute inset-0 bg-gradient-to-r from-[#96671a] to-[#e8b93f] translate-y-full transition-transform duration-300 ${isActive(link.path) ? "translate-y-0 opacity-20" : "group-hover:translate-y-0 opacity-40"}`}
            />
            <span class={`block skew-x-[15deg] relative z-10 text-sm font-bold tracking-wide transition-colors ${isActive(link.path) ? "text-[#ffe9a3]" : "text-[#b6c1cd] group-hover:text-[#e3d8c0]"}`}>
              <span aria-hidden="true" class="mr-1">
                {link.icon}
              </span>{" "}
              {link.name}
            </span>
          </a>
        ))
      }
    </div>

    <div class="z-50 flex items-center gap-2">
      <a
        href="/register"
        class="hidden rounded-sm skew-x-[-15deg] border border-[#ffe9a3] bg-gradient-to-r from-[#ffe9a3] via-[#e8b93f] to-[#96671a] px-6 py-2.5 text-sm font-black text-[#0d0903] shadow-[0_0_15px_rgba(232,185,63,0.5)] transition-all hover:-translate-y-0.5 hover:shadow-[0_6px_20px_rgba(255,233,163,0.7)] lg:block">
        <span class="block skew-x-[15deg]">สมัครสมาชิก</span>
      </a>
      <a
        href="/login"
        class="hidden rounded-sm skew-x-[-15deg] border border-[#96671a] bg-[#2a1d0b] px-6 py-2.5 text-sm font-bold text-[#e3d8c0] transition-all hover:border-[#e8b93f] hover:text-[#ffe9a3] lg:block">
        <span class="block skew-x-[15deg]">เข้าสู่ระบบ</span>
      </a>

      <button
        id="hamburger-btn"
        class="relative flex h-[45px] w-[45px] flex-col items-center justify-center space-y-1.5 rounded-md border border-[#e8b93f]/35 bg-[#2a1d0b]/45 p-2 transition-all hover:bg-[#2a1d0b]/80 xl:hidden"
        aria-label="เปิดหรือปิดเมนู">
        <span class="hamburger-line h-[2px] w-6 origin-center bg-[#e3d8c0] transition-all duration-300"></span>
        <span class="hamburger-line h-[2px] w-6 bg-[#e3d8c0] transition-all duration-300"></span>
        <span class="hamburger-line h-[2px] w-6 origin-center bg-[#e3d8c0] transition-all duration-300"></span>
      </button>
    </div>
  </div>

  <div id="mobile-overlay" class="pointer-events-none fixed inset-0 z-30 bg-black/80 opacity-0 backdrop-blur-sm transition-opacity duration-300 xl:hidden"></div>

  <div
    id="mobile-sidebar"
    class="fixed top-0 right-0 z-40 h-screen w-[280px] translate-x-full transform overflow-y-auto border-l border-[#e8b93f]/55 bg-[#0d0903] shadow-[-10px_0_30px_rgba(0,0,0,0.8)] transition-transform duration-300 ease-out xl:hidden">
    <div class="flex flex-col space-y-3 px-6 pt-24 pb-10">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`sidebar-item flex items-center px-4 py-3.5 rounded-lg border transition-all ${isActive(link.path) ? "bg-[#e8b93f]/20 border-[#e8b93f] text-[#ffe9a3] shadow-[inset_4px_0_0_rgba(255,233,163,1)]" : "bg-white/5 border-transparent text-[#b6c1cd] hover:bg-white/10 hover:text-[#e3d8c0]"}`}>
            <span aria-hidden="true" class="mr-3 text-xl">
              {link.icon}
            </span>
            <span class="text-sm font-bold">{link.name}</span>
          </a>
        ))
      }
    </div>
  </div>
</nav>

<style is:global>
  /* อนิเมชันปุ่ม Hamburger กลายเป็น X */
  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  /* อนิเมชันเด้งไล่ระดับของเมนูใน Sidebar */
  .sidebar-item {
    opacity: 0;
    transform: translateX(20px);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  /* คลาสนี้จะถูกยัดผ่าน JS เพื่อแสดงเมนู */
  .sidebar-item.item-show {
    opacity: 1;
    transform: translateX(0);
  }

  /* หน่วงเวลาให้เมนูวิ่งเข้ามาทีละอัน — มี 7 เมนู ต้องครบทั้ง 7 */
  .sidebar-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .sidebar-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .sidebar-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .sidebar-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .sidebar-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .sidebar-item:nth-child(6) {
    transition-delay: 0.35s;
  }
  .sidebar-item:nth-child(7) {
    transition-delay: 0.4s;
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar-item {
      transition: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const overlay = document.getElementById("mobile-overlay");
  const sidebar = document.getElementById("mobile-sidebar");
  const sidebarItems = document.querySelectorAll(".sidebar-item");

  const toggleMenu = () => {
    hamburgerBtn?.classList.toggle("active");

    sidebar?.classList.toggle("translate-x-full");
    sidebar?.classList.toggle("translate-x-0");

    overlay?.classList.toggle("opacity-0");
    overlay?.classList.toggle("opacity-100");
    overlay?.classList.toggle("pointer-events-none");
    overlay?.classList.toggle("pointer-events-auto");

    if (sidebar?.classList.contains("translate-x-0")) {
      document.body.style.overflow = "hidden";
      sidebarItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      sidebarItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleMenu);
  overlay?.addEventListener("click", toggleMenu);

  sidebarItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (sidebar?.classList.contains("translate-x-0")) {
        toggleMenu();
      }
    });
  });
</script>
