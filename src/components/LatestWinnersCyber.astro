---
import { BRAND_NAME, brandFlag, brandPick } from "../lib/brandProfile";

// 🚨🚨 **ไม่มีโลโก้ธนาคารในฟีดนี้ และห้ามใส่กลับเข้ามา** (ตัดออก 2026-10-25)
// เดิมแถวแต่ละแถวติดโลโก้ธนาคารจริงห้าเจ้าพร้อมสีประจำแบรนด์ของแต่ละเจ้า ซึ่งเป็น
// **การอ้างว่ารองรับเจ้าเหล่านั้นจริง** — เหตุผลเดียวกับที่ brand-spec §3 ห้าม render
// `BankStrip` รอบนี้ และบรีฟ (src/assets/content.txt) **ไม่พูดถึงธนาคาร วอลเลท
// หรือการฝากถอนเลยแม้แต่คำเดียว** จึงไม่มีอะไรในบรีฟรองรับคำกล่าวอ้างนั้น
// ผลพลอยได้: ไฟล์ PNG ของธนาคารห้าไฟล์ไม่ถูก emit ขึ้น dist/ (eager import = emit
// เสมอ ไม่ว่าจะ render หรือไม่) — `src/assets/banks/*` ยังอยู่บนดิสก์ในฐานะ inventory
// ให้ `BankStrip.astro` และ `LatestWinners*` ตัวอื่น ไม่ได้ถูกลบ
//
// ⚠️ สัญญากับ `src/lib/winnersFeed.ts` ยังเหมือนเดิม: มันอ่าน `color` ของรายการใน
// pool นี้ไปสลับคลาสที่ขึ้นต้นด้วย `bg-[` บน `[data-winner-bank]` และจะแตะ
// `[data-winner-icon]` **ก็ต่อเมื่อ element นั้นมีอยู่จริง** — ไม่มี `<img>` แล้ว
// มันจึงข้ามไปเอง **ห้ามเปลี่ยนชื่อ data-attribute และห้ามย้าย logic กลับเข้ามาใน
// component** (ชื่อ field ยังเป็น name/color/icon เพราะเป็น interface ของ lib)
//
// ป้ายหน้าแถวจึงเป็น **เครื่องหมายตกแต่งของแบรนด์เอง** บนพื้นสีที่สลับไปตามชุดผิวของ
// brand-spec §2 — ไม่อ้างถึงนิติบุคคลภายนอกเจ้าใดเลย
// ทุกค่าใน pool นี้เป็น **ผิว/พื้นถม** ตาม §2 (รวม #35a043 ที่ §2 อนุญาตให้เป็น
// เส้น/ออรา/พื้นถมได้ แต่ห้ามถือตัวอักษร) — ตัวอักษรเดียวที่วางทับคือกลีฟตกแต่งที่
// มี aria-hidden จึงไม่ใช่ข้อความ
const accentPool = [
  { name: "accent-ink", color: "bg-[#010d04]", icon: "" },
  { name: "accent-forest", color: "bg-[#073c1a]", icon: "" },
  { name: "accent-emerald-deep", color: "bg-[#0e5424]", icon: "" },
  { name: "accent-emerald", color: "bg-[#1e7033]", icon: "" },
  { name: "accent-aura", color: "bg-[#35a043]", icon: "" },
];

// The two status labels live here and on the row's data-* attributes, so the
// server-rendered text and the text the module swaps in can never drift apart.
// Same for the two status classes: the module reads them off the row, so it
// never has to learn what this brand's palette is.
const PENDING_TEXT = "อยู่ระหว่างตรวจสอบ";
const DONE_TEXT = "ถอนสำเร็จ";
const PENDING_CLASS = "is-pending";
const DONE_CLASS = "is-verified";

// Everything the rotation module needs is a data-* on the feed element below —
// interval, row cap, amount range, pending chance, username shape, insert mode
// and the "big" threshold. It is spelled out rather than left to the module's
// defaults so the next rebrand can retune the feed without opening src/lib,
// which a rebrand never does.
const FEED_INTERVAL_MS = 4200;
const FEED_MAX_ROWS = 5;
const AMOUNT_MIN = 15000;
const AMOUNT_MAX = 95000;

// เหนือค่านี้ยอดจะสลับฮิวจาก **เขียวมรกตนีออน #3ddc4a → ทองอำพัน #e8c86a** ซึ่งเป็น
// การสลับ "วัสดุ" ของ §2 (มรกต → ทอง) ไม่ใช่การเร่งความสว่างในฮิวเดียว — อ่านออกได้
// แม้มองผ่านๆ และทั้งสองค่าถือตัวอักษรบนผิวเข้มได้ทั้งคู่ (6.9:1 / 8.0:1)
// ตัวเลขนี้เป็นเพียง threshold ของ data-attribute ไม่ใช่คำกล่าวอ้างที่ render เป็น
// ถ้อยคำ — ยอดที่เห็นบนแถวมาจากช่วง data-amount-* เท่านั้น
const BIG_WIN_ABOVE = 70000;

// ทั้งสองสตริงอยู่ที่นี่ที่เดียวแล้วส่งเข้าทั้ง `class` ของแถวที่ server render และ
// `data-normal-class`/`data-big-class` ที่ module อ่าน — สองทางจึงไม่มีโอกาส drift
// และ Tailwind ยังสแกนเห็นคลาสทั้งสองชุดเพราะมันเป็น string literal ในไฟล์นี้
const AMOUNT_CLASS = "text-[#3ddc4a] drop-shadow-[0_0_10px_rgba(61,220,74,0.4)]";
const AMOUNT_BIG_CLASS = "text-[#e8c86a] drop-shadow-[0_0_12px_rgba(232,200,106,0.45)]";

// The first rows are rendered on the server. They used to be built by an inline
// script, which left the container empty in the HTML: nothing for a crawler to
// read, nothing at all without JS, and a guaranteed layout shift the moment the
// script ran. Now the page ships with rows and JS only replaces them.
//
// These values come from the brand's own domain hash, NOT from Math.random()
// and never from Date. brandProfile.ts states the invariant plainly: the same
// domain must produce byte-identical output on every build, or every deploy
// churns a live site's markup for no reason.
const LETTERS = "abcdefghijklmnopqrstuvwxyz";
const pickFrom = (chars: string, salt: string) => chars.charAt(brandPick(Astro.site, salt, chars.length));

const initialRows = Array.from({ length: FEED_MAX_ROWS }, (_, i) => {
  const amount = AMOUNT_MIN + brandPick(Astro.site, `winner-amount-${i}`, AMOUNT_MAX - AMOUNT_MIN + 1);
  return {
    bank: accentPool[brandPick(Astro.site, `winner-bank-${i}`, accentPool.length)],
    user: `${pickFrom(LETTERS, `winner-a-${i}`)}${pickFrom(LETTERS, `winner-b-${i}`)}***${[0, 1, 2, 3].map((d) => brandPick(Astro.site, `winner-d${i}-${d}`, 10)).join("")}`,
    amount: amount.toLocaleString("en-US"),
    big: amount > BIG_WIN_ABOVE,
    pending: brandFlag(Astro.site, `winner-pending-${i}`),
  };
});

// ── พาเลตของดรอปนี้ (2026-10-28, .claude/brand-spec-zoro365.md §2) ──────────
// **เขียวมรกตนีออนนำ · เงินโครเมียมกับทองอำพันเป็นวัสดุรอง บนหมึกดำ-เขียวป่าจม**
// ไฟล์นี้ยังถือพาเลตม่วง/แมเจนต้า/ฟ้าของแบรนด์ก่อนหน้าอยู่ทั้งใบ จึงรีเธมทั้งไฟล์
// รอบนี้ (ค่าเก่าทุกค่าออกหมด ไม่เหลือสักค่า)
//
// ⚠️⚠️ **รอบนี้มืดทั้งเว็บ** — bg.json = #002908 เขียวป่าจมเกือบดำ ทั้งโครมและ
// เนื้อหาเป็นผิวเข้มไปทางเดียวกัน แผงนี้จึงแยกตัวจากพื้นเพจด้วย **ความต่างของ
// ความสว่าง + เงาหมึก rgba(1,13,4,0.45)** ไม่ใช่ด้วยสันนีออนอย่างเดียว
// ลำดับความลึกของโครมรอบนี้: #0e5424 ยก (แถว hover) / **#031b09 ฐาน (แผงนี้)** /
// #010d04 ลึกสุด (พื้นแถว) · เส้น #1e7033 · ขอบ/ออรา #35a043
// ตัวอักษร **#eef7f0** และหมึกรอง **#9dc2a5** ซึ่ง §2 อนุญาตให้ถือตัวอักษรบนผิว
// โครมเข้มทั้งคู่ (12.0:1 / 6.3:1 บนการ์ด)
// ⚠️ **ห้ามแก้แผงนี้ให้เป็นผิวสว่าง** — หมึก #eef7f0 / #9dc2a5 บนการ์ดขาวคือ
// ตัวอักษรที่หายไปเลย และ §1 ห้ามพื้นถมขาวทั้งรอบ (ยกเว้นหมึกบนปุ่ม CTA
// ซึ่งไฟล์นี้ไม่มีปุ่ม)
//
// แผงเป็นผิวฐาน #031b09 ในสันเขียว #35a043 สองข้าง เส้นบนเป็น **เขียวมรกตนีออน
// #3ddc4a** (ครึ่งตัวเลขของเวิร์ดมาร์กที่เป็นมรกตเคลือบเงาเรืองแสง) เส้นล่างเป็น
// **เงินโครเมียม #dfe6e3** (ครึ่งตัวอักษรละตินที่เป็นโครเมียมขัดเงา) — คู่วัสดุของ
// โลโก้จึงอ่านได้จากขอบแผงเองโดยไม่ต้องเอาค่าพวกนั้นมาถมเป็นพื้นใหญ่
// หัวแถบรับ #eef7f0 พร้อมเรืองแสง rgba(61,220,74,0.45) · ยอดเงินรับ **#3ddc4a**
// และสลับเป็น **#e8c86a** เมื่อเกิน BIG_WIN_ABOVE · ป้ายสถานะข้างหัวแถบเป็น #3ddc4a
// บนขอบ #35a043 · แถบนำแถวเป็น #3ddc4a พร้อมพื้นไล่เฉด rgba(61,220,74,0.15) จางๆ
// บนพื้นแถว #010d04 — **ไม่มีตัวอักษรไหนวางบน #35a043 ทึบๆ เลย** มันอยู่ได้แค่ที่
// เส้น/ออรา/พื้นถม ตาม §2 · แถว hover ยกขึ้นผิว #0e5424 · ป้ายกำกับและหน่วย THB
// ใช้หมึกรอง #9dc2a5 · ชื่อผู้ใช้เป็น #eef7f0 · เส้นใต้หัวแถบเป็น #1e7033
// rgba() ที่อนุญาตรอบนี้ (§2): rgba(61,220,74,α) นีออน · rgba(1,13,4,α) เงา ·
// rgba(232,200,106,α) ทอง · rgba(223,230,227,α) ประกายโครเมียม
//
// ⚠️⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือเขียวเป็นฮิวที่ตา
// แยกค่าได้ยากที่สุด และเคยเป็นฮิวนำของแบรนด์เก่ามาแล้วหลายเจ้า รวมถึงแบรนด์
// ขาออกรอบก่อนที่เป็นเขียว/เงินโครเมียมเหมือนกันเป๊ะ แค่กลับทิศสว่าง-มืด**
// → **"เจอเขียว ≠ เป็นของรอบนี้"** ต้องเทียบให้ตรงหกหลักกับตาราง §2 ทุกค่า
// ห้ามตัดสินด้วยสายตา (ตาราง §2 ไล่คู่ที่ต่างกันแค่หลักเดียวไว้ให้ครบแล้ว)
// ⚠️⚠️ **รอบนี้ไม่มีม่วง ไม่มีแมเจนต้า ไม่มีฟ้า/ไซแอน ไม่มีแดง ไม่มีส้ม
// และไม่มีแรมป์เทากลาง** เลยสักเฉด (ยกเว้นสี verified ด้านล่าง)
//
// ⚠️ **ชื่อไฟล์ว่า Cyber แต่นั่นเป็นแค่ชื่อไฟล์** — สิ่งที่ §3 เลือกคือ **ทรง**
// (แผ่นตัดมุมด้วย clip-path ที่อ่านเป็น "รอยดาบ" ซึ่งตรงกับภาษาภาพคาทานะ/วงพู่กัน
// หมึกของรอบนี้) ไม่ใช่ภาษาภาพไซเบอร์ จึง **ไม่มีมอนอสเปซ ไม่มีสแลชสามตัว ไม่มี
// ป้ายทรงเทอร์มินัลตัวพิมพ์ใหญ่ขีดล่าง ไม่มีเส้นสแกน ไม่มีกริดนีออน** ในไฟล์นี้
// ตัวเลขใช้ `tabular-nums` เพื่อให้หลักตรงกันทุกแถวแทนการพึ่งฟอนต์มอนอสเปซ —
// และ **ไม่มีที่ไหนในไฟล์นี้ hardcode ชื่อฟอนต์** ทุกอย่าง inherit var(--font-sans)
// ที่ MainLayout ใส่ไว้บน <html>
//
// สี verified ใน <style> ท้ายไฟล์เป็น **สีเชิงความหมาย ไม่ใช่สีแบรนด์** §2 สั่งไว้
// ตรงตัวว่า "เขียว success ของฟีดถอนเงิน คงไว้ ห้ามเปลี่ยน" จึงคงไว้ทุกตัวอักษร
// ถึงแม้รอบนี้แบรนด์จะเป็นเขียวเองก็ตาม — มันต้องไม่ถูกกลืนเข้าพาเลตของแบรนด์
// ส่วนสถานะ "รออยู่ระหว่างตรวจสอบ" เป็นแค่ "หม่นกว่า success" จึงตามพาเลต:
// **หมึกรอง #9dc2a5 บนขอบ #1e7033** (หม่นกว่าเขียว success ชัดเจน และข้อความในป้าย
// บอกสถานะอยู่แล้ว จึงไม่ได้พึ่งสีเดียวในการสื่อความ)
//
// หัวแถบและป้ายสถานะเป็น <p>/<span> ไม่ใช่หัวข้อ — brand-spec §4 ระบุว่าเฉพาะ
// เนื้อหาบทความเท่านั้นที่ออกเป็น heading ได้ และลิสต์ไฟล์นี้ไว้ใน "โครมล้วน ห้ามมี
// h1–h6 สักตัว" ชื่อของ region จึงมาจาก aria-label บน <section> **ห้ามเลื่อน <p>
// ขึ้นเป็น h2 เพื่อ "แก้ชื่อที่ขาด"** เพราะจะทำให้ inventory หัวข้อของหน้าแรกเพี้ยน
// ⚠️ aria-label รอบนี้ **ไม่มีคำว่า "ฝากถอน" ไม่มีชื่อธนาคาร ไม่มีวอลเลท** — §5
// ระบุว่าหมวดนั้นไม่มีในบรีฟรอบนี้เลยแม้แต่คำเดียว จึงเหลือเฉพาะคำที่บรีฟเขียนเอง
// ("ควรตรวจสอบ … จากประกาศล่าสุดอีกครั้ง" = content.txt บรรทัด 22) และไม่มีตัวเลข
// ใดๆ เพราะ §5 อนุญาตเฉพาะตัวเลขของบรีฟเอง (0.3% · 0.8% · 3 ขั้นตอน · 24ชม.)
// ชื่อแบรนด์มาจาก BRAND_NAME เสมอ ไม่พิมพ์ตรงๆ และไม่มีโดเมนในไฟล์นี้
---

<div class="mx-auto w-full max-w-[1300px] p-4">
  <section
    aria-label={`รายการถอนล่าสุดของสมาชิก ${BRAND_NAME} เป็นข้อมูลตัวอย่างที่แสดงรูปแบบรายการ ควรตรวจสอบรายละเอียดจากบัญชีสมาชิกและประกาศล่าสุดอีกครั้ง`}
    class="relative border-r-4 border-l-4 border-[#35a043]/60 bg-[#031b09]/95 px-4 py-8 shadow-[0_10px_30px_rgba(1,13,4,0.45)] md:p-10"
    style="clip-path: polygon(20px 0, calc(100% - 20px) 0, 100% 20px, 100% calc(100% - 20px), calc(100% - 20px) 100%, 20px 100%, 0 calc(100% - 20px), 0 20px);">
    <div aria-hidden="true" class="pointer-events-none absolute -top-12 left-1/2 h-32 w-72 -translate-x-1/2 rounded-full bg-[#35a043]/20 blur-[60px]"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 h-[1px] w-full bg-gradient-to-r from-transparent via-[#3ddc4a] to-transparent"></div>
    <div aria-hidden="true" class="absolute bottom-0 left-0 h-[1px] w-full bg-gradient-to-r from-transparent via-[#dfe6e3] to-transparent"></div>

    <div class="relative z-10 mb-8 flex items-center justify-between gap-3 border-b border-[#1e7033] pb-4">
      <div class="flex min-w-0 items-center gap-3">
        <span aria-hidden="true" class="shrink-0 text-lg leading-none text-[#3ddc4a] drop-shadow-[0_0_10px_rgba(61,220,74,0.55)]">◉</span>
        <p class="text-xl font-black tracking-wide text-[#eef7f0] drop-shadow-[0_0_8px_rgba(61,220,74,0.45)]">{BRAND_NAME} · รายการถอนล่าสุด</p>
      </div>
      <span class="shrink-0 border border-[#35a043]/70 px-2 py-1 text-xs font-bold text-[#3ddc4a] motion-safe:animate-pulse">อัปเดต 24ชม.</span>
    </div>

    <div
      data-winners-feed
      data-interval={FEED_INTERVAL_MS}
      data-max-rows={FEED_MAX_ROWS}
      data-amount-min={AMOUNT_MIN}
      data-amount-max={AMOUNT_MAX}
      data-big-win-above={BIG_WIN_ABOVE}
      data-pending-chance="0.35"
      data-user-style="letters"
      data-user-digits="4"
      data-insert="prepend"
      class="relative z-10 flex flex-col gap-3">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-row origin-left transform transition-all duration-500 ease-out">
            <div class="flex items-center justify-between gap-4 border-l-2 border-[#3ddc4a] bg-[#010d04] bg-gradient-to-r from-[#3ddc4a]/15 to-transparent p-3 transition-colors hover:bg-[#0e5424]">
              <div class="flex min-w-0 items-center gap-4">
                <div data-winner-bank class={`flex h-8 w-8 shrink-0 items-center justify-center border border-[#1e7033] ${row.bank.color}`}>
                  <span aria-hidden="true" class="text-sm leading-none text-[#eef7f0]">
                    ◆
                  </span>
                </div>
                <div class="truncate text-sm text-[#9dc2a5]">
                  สมาชิก{" "}
                  <span data-winner-user class="font-bold text-[#eef7f0] tabular-nums">
                    {row.user}
                  </span>
                </div>
              </div>
              <div class="flex shrink-0 items-center gap-4 md:gap-6">
                <div
                  data-winner-status
                  data-pending-text={PENDING_TEXT}
                  data-done-text={DONE_TEXT}
                  data-pending-class={PENDING_CLASS}
                  data-done-class={DONE_CLASS}
                  class={`winner-status shrink-0 border px-2 py-1 text-center text-[10px] leading-tight ${row.pending ? PENDING_CLASS : DONE_CLASS}`}>
                  {row.pending ? PENDING_TEXT : DONE_TEXT}
                </div>
                <div data-winner-big data-normal-class={AMOUNT_CLASS} data-big-class={AMOUNT_BIG_CLASS} class={`text-xl font-black tabular-nums ${row.big ? AMOUNT_BIG_CLASS : AMOUNT_CLASS}`}>
                  <span data-winner-amount>{row.amount}</span> <span class="text-xs font-bold text-[#9dc2a5]">THB</span>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(accentPool)} />
  </section>
</div>

<script>
  // Not `define:vars` — that forces is:inline, which strips type/async/defer
  // and leaves a parser-blocking script in the middle of the document. The
  // accent list arrives as inert JSON above instead, and this module is bundled
  // and deferred like any other. Every guard (off-screen, hidden tab,
  // prefers-reduced-motion) lives in the module; nothing here starts a timer.
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  /* The two status colours are classes rather than inline strings so the JS
     never has to know what this brand's palette is.
     `is-verified` is a SEMANTIC success colour, not brand identity —
     brand-spec §2 pins it as "keep, do not change" and it is left verbatim
     across every rebrand, including this one, even though this brand's own hue
     is also green.
     `is-pending` is only "muted vs. success", so it tracks the palette: this
     round it is the secondary ink #9dc2a5 on the thin line #1e7033. */
  .winner-status.is-pending {
    color: #9dc2a5;
    border-color: #1e7033;
  }
  .winner-status.is-verified {
    color: oklch(79.2% 0.209 151.711);
    border-color: color-mix(in oklab, oklch(72.3% 0.219 149.579) 50%, transparent);
  }

  .winner-row.is-entering {
    transform: scaleX(0.95);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-row {
      transition: none;
    }
  }
</style>
