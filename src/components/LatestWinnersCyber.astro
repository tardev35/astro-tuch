---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import ttbLogo from "../assets/banks/ttb.png";
import { BRAND_NAME, brandFlag, brandPick } from "../lib/brandProfile";

// Real bank brand colours — never rethemed with the palette.
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#16a34a]", icon: ktbLogo.src },
  { name: "TTB", color: "bg-[#1279be]", icon: ttbLogo.src },
];

// The two status labels live here and on the row's data-* attributes, so the
// server-rendered text and the text the module swaps in can never drift apart.
// Same for the two status classes: the module reads them off the row, so it
// never has to learn what this brand's palette is.
const PENDING_TEXT = "[อยู่ระหว่างตรวจสอบ]";
const DONE_TEXT = "[ถอนสำเร็จ]";
const PENDING_CLASS = "is-pending";
const DONE_CLASS = "is-verified";

// Everything the rotation module needs is a data-* on the feed element below —
// interval, row cap, amount range, pending chance, username shape. It is spelled
// out rather than left to the module's defaults so the next rebrand can retune
// the feed without opening src/lib, which a rebrand never does.
const FEED_INTERVAL_MS = 4200;
const FEED_MAX_ROWS = 5;
const AMOUNT_MIN = 15000;
const AMOUNT_MAX = 95000;

// The first rows are rendered on the server. They used to be built by an inline
// script, which left the container empty in the HTML: nothing for a crawler to
// read, nothing at all without JS, and a guaranteed layout shift the moment the
// script ran. Now the page ships with rows and JS only replaces them.
//
// These values come from the brand's own domain hash, NOT from Math.random().
// brandProfile.ts states the invariant plainly: the same domain must produce
// byte-identical output on every build, or every deploy churns a live site's
// markup for no reason.
const LETTERS = "abcdefghijklmnopqrstuvwxyz";
const pickFrom = (chars: string, salt: string) => chars.charAt(brandPick(Astro.site, salt, chars.length));

const initialRows = Array.from({ length: FEED_MAX_ROWS }, (_, i) => ({
  bank: bankPool[brandPick(Astro.site, `winner-bank-${i}`, bankPool.length)],
  user: `${pickFrom(LETTERS, `winner-a-${i}`)}${pickFrom(LETTERS, `winner-b-${i}`)}***${[0, 1, 2, 3].map((d) => brandPick(Astro.site, `winner-d${i}-${d}`, 10)).join("")}`,
  amount: (AMOUNT_MIN + brandPick(Astro.site, `winner-amount-${i}`, AMOUNT_MAX - AMOUNT_MIN + 1)).toLocaleString("en-US"),
  pending: brandFlag(Astro.site, `winner-pending-${i}`),
}));

// โปรดี168 (รอบ **แดงเชอร์รี่นำ · ทองแดงไหม้รอง · ทองสาลี่เป็นสีของโครม ·
// ธีมสว่าง** 2026-10-22, .claude/brand-spec-prodeee168.md §2): feed ที่ใช้งานจริง
// รอบนี้ — รอบก่อน (รวยแท้168) ใช้ LatestWinnersPremium จึงหมุนมาที่ไฟล์นี้
//
// ⚠️⚠️ **ไฟล์นี้อยู่ในโซน "โครม" ไม่ใช่เนื้อหา** (§2 จัด navbar/footer/ticker/
// winners feed/Navfoot/CtaRedirect ไว้ด้วยกัน) จึงเป็น **แผงเข้มบนพื้นเพจสว่าง**
// — bg.json รอบนี้เป็น #ffd1d1 ชมพูพาสเทล และ **ห้าม "แก้" แผงนี้ให้สว่างตามพื้น**
// เพราะหัว-ท้าย-ticker-feed เข้มคือกรอบที่คร่อมเนื้อหาสว่างเอาไว้ ซึ่งเป็นทิศของ
// ธีมรอบนี้ทั้งรอบ ไม่ใช่ความไม่สม่ำเสมอ
// ลำดับความลึกของโครม: **#4d1c0a ยก / #2c1004 จม** ตัวอักษรครีม **#fff0e4**
// (13.1:1 บน #4d1c0a และสูงกว่านั้นบน #2c1004) และทองสาลี่ **#f0b46a** (7.9:1 บน
// #4d1c0a) ซึ่ง §2 อนุญาตให้ถือตัวอักษร **บนโครมเท่านั้น** — บนการ์ดขาวมันได้แค่
// 1.8:1 จึงไม่มีอยู่ในไฟล์เนื้อหาใบไหนเลย
//
// แผงเป็นผิวจม #2c1004 ในสันทองสาลี่สองข้าง เส้นบนเป็นทองสาลี่ (ป้ายไม้และเหรียญทอง
// ในแบนเนอร์) เส้นล่างเป็นแดงเชอร์รี่ #eb0305 (ผ้าพันคอของกระต่ายและโบว์ของเด็กหญิง)
// หัวแถบรับครีม #fff0e4 ยอดเงินรับทองสาลี่ #f0b46a พร้อมเรืองแสง
// rgba(240,180,106,…) ป้าย ONLINE เป็นทองสาลี่ แถบนำแถวเป็นแดงเชอร์รี่พร้อมไล่เฉด
// rgba(235,3,5,0.16) จาง ๆ ซึ่ง §2 ระบุชัดว่าแดงเชอร์รี่ **เป็นพื้นถมที่รองตัวอักษร
// ขาวได้** แถว hover ยกขึ้นผิว #4d1c0a ป้ายกำกับหม่น (USR_ID) ใช้ทองสาลี่
// ชื่อผู้ใช้และหน่วย THB เป็นครีม #fff0e4
// ⚠️ **ทองแดงไหม้ #b44c06 ไม่ถือตัวอักษรบนแผงนี้** (2.8:1 บน #2c1004) — บนการ์ดขาว
// ถือได้ แต่ไฟล์นี้ไม่ใช่การ์ด จึงไม่มี #b44c06 ที่ไหนในไฟล์นี้เลย · **แดงสด
// #ff4446 ก็ไม่มี** เพราะ §2 ห้ามมันถือตัวอักษรและห้ามเป็นพื้นของตัวอักษรทุกกรณี
// และทุกชั้นของแถวมีตัวอักษรวางทับ
// เงาของแผงเป็นเงาทอดลง rgba(64,17,7,0.35) ไม่ใช่เรืองแสงนีออน เพราะพื้นเพจรอบนี้
// สว่าง — เงาทอดอ่านเป็น "แผงวางบนกระดาษ" ส่วนออร่านีออนจะหายไปกับพื้นชมพู
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้มีสองชั้น: แดง และ ทอง**
// เพราะทั้งคู่ผ่านรีโปนี้มาแล้วหลายแบรนด์ และ **รอบก่อนหน้าทันทีก็เป็นแดง+ทอง**
// แดงรอบนี้ **#eb0305 (R235 G3 B5)** วัดจาก logo.webp เอง ตัวที่ใกล้ที่สุดในรีโปคือ
// dc0203 ของหวย365 (ห่าง 18) · ทองสาลี่ **#f0b46a (R240 G180 B106)** ⚠️ **มี R
// เท่ากับ f0bb4e ของรวยเทพ168 และ f0b429 ของรับตัง168 เป๊ะทั้งคู่** ต่างกันที่
// G180 vs G187 vs G180 และ B106 vs B78 vs B41 — อย่าปล่อยของเก่าไว้เพราะ "ก็ทอง
// เหมือนกัน" ต้อง grep เป็นค่า
// ชุดฟ้าไซยาน-เหลืองมะนาวของ **นินจา168** ที่เพิ่งค้างอยู่ทั้งไฟล์นี้ (32bcfb a9e9ff
// 07335f fef54b 6b5c10 0c2a3d 071a28 030e16 041019 dceefc กับ rgba 50/188/251 α)
// rgba 254/245/75 α)) ออกครบทุกจุดแล้ว เช่นเดียวกับชุดม่วงราชา-ทองของ **KMD88**
// (7505cc b453ff c07cff d9b8ff bba8d4 ece2f8 e2b33f 0a0213 1d0832 3a0565 2c0349
// 7a5a0a) ชุดทองอวกาศ-เงินโครเมียมของ **NAZA168** (fbc134 cfd6e3 9aa6bb fdf3df
// 4e3406 241700) ชุดเขียวนีออน-เงินของ **BOOM369** (42fb5a 8dffa0 04ab3a 041109
// cfe9d7 9fb8aa 0b231b dadcdc) และชุดแดงคริมสัน-ทองโบราณของรอบขาออก **รวยแท้168**
// (c30303 8f0505 e81313 dcb95f b8862b 96681f 4a0f0f 461212 280b0b ffeee8 fff1ef
// ffdbdb c99a3f)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีฟ้า/ไซยาน/น้ำเงิน ไม่มีม่วง ไม่มีเขียว (ยกเว้นสีสถานะ verified
// ด้านล่างกับโลโก้ธนาคาร) ไม่มีเหลืองมะนาว ไม่มีเงิน/โครเมียม และไม่มีโรสโกลด์**
//
// สี pending/verified ใน <style> ท้ายไฟล์เป็นสีเชิงความหมาย ไม่ใช่สีแบรนด์ จึงคงไว้
// ตามเดิม เช่นเดียวกับสีประจำธนาคารในรายชื่อด้านบน
//
// หัวแถบและป้าย ONLINE เป็น <p>/<span> ไม่ใช่หัวข้อ — brand-spec §4 ระบุว่าเฉพาะ
// เนื้อหาบทความเท่านั้นที่ออกเป็น heading ได้ ชื่อของ region จึงมาจาก aria-label บน
// <section> ข้อความ aria-label ไม่ระบุชื่อธนาคาร ชื่อค่ายเกม หรือตัวเลขใดๆ เพราะ
// บรีฟรอบนี้ไม่ได้ให้ไว้ — §6 อนุญาตเฉพาะตัวเลขของบรีฟเอง (0.3% · 0.8% · 24ชม. ·
// ปี 2026)
---

<div class="mx-auto w-full max-w-[1300px] p-4">
  <section
    aria-label={`รายการถอนล่าสุดของสมาชิก ${BRAND_NAME} สมาชิกตรวจสอบเครดิตและรายการฝากถอนของตัวเองได้จากบัญชีสมาชิก`}
    class="relative border-r-4 border-l-4 border-[#f0b46a]/60 bg-[#2c1004]/95 px-4 py-8 shadow-[0_10px_30px_rgba(64,17,7,0.35)] md:p-10"
    style="clip-path: polygon(20px 0, calc(100% - 20px) 0, 100% 20px, 100% calc(100% - 20px), calc(100% - 20px) 100%, 20px 100%, 0 calc(100% - 20px), 0 20px);">
    <div aria-hidden="true" class="absolute top-0 left-0 h-[1px] w-full bg-gradient-to-r from-transparent via-[#f0b46a] to-transparent"></div>
    <div aria-hidden="true" class="absolute bottom-0 left-0 h-[1px] w-full bg-gradient-to-r from-transparent via-[#eb0305] to-transparent"></div>

    <div class="relative z-10 mb-8 flex items-center justify-between gap-3 border-b border-[#f0b46a]/45 pb-4">
      <p class="text-xl font-black tracking-[0.2em] text-[#fff0e4] drop-shadow-[0_0_8px_rgba(240,180,106,0.45)]">/// {BRAND_NAME} · รายการถอนล่าสุด</p>
      <span class="shrink-0 animate-pulse border border-[#f0b46a]/60 px-2 py-1 text-xs font-bold tracking-widest text-[#f0b46a]">ONLINE</span>
    </div>

    <div
      data-winners-feed
      data-interval={FEED_INTERVAL_MS}
      data-max-rows={FEED_MAX_ROWS}
      data-amount-min={AMOUNT_MIN}
      data-amount-max={AMOUNT_MAX}
      data-pending-chance="0.35"
      data-user-style="letters"
      data-user-digits="4"
      class="relative z-10 flex flex-col gap-3">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-row origin-left transform transition-all duration-500 ease-out">
            <div class="flex items-center justify-between border-l-2 border-[#eb0305]/75 bg-gradient-to-r from-[#eb0305]/16 to-transparent p-3 backdrop-blur-sm transition-colors hover:bg-[#4d1c0a]">
              <div class="flex items-center gap-4">
                <div data-winner-bank class={`flex h-8 w-8 items-center justify-center border border-white/10 bg-black/50 mix-blend-screen ${row.bank.color}`}>
                  <img data-winner-icon src={row.bank.icon} alt="" width="20" height="20" loading="lazy" decoding="async" class="h-5 w-5 object-contain grayscale" />
                </div>
                <div class="font-mono text-sm text-[#f0b46a]">
                  USR_ID:{" "}
                  <span data-winner-user class="font-bold text-[#fff0e4]">
                    {row.user}
                  </span>
                </div>
              </div>
              <div class="flex items-center gap-6">
                <div
                  data-winner-status
                  data-pending-text={PENDING_TEXT}
                  data-done-text={DONE_TEXT}
                  data-pending-class={PENDING_CLASS}
                  data-done-class={DONE_CLASS}
                  class={`winner-status font-mono text-[10px] tracking-widest ${row.pending ? PENDING_CLASS : DONE_CLASS}`}>
                  {row.pending ? PENDING_TEXT : DONE_TEXT}
                </div>
                <div class="font-mono text-xl font-black text-[#f0b46a] drop-shadow-[0_0_8px_rgba(240,180,106,0.4)]">
                  <span data-winner-amount>{row.amount}</span> <span class="text-xs text-[#fff0e4]">THB</span>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
  </section>
</div>

<script>
  // Not `define:vars` — that forces is:inline, which strips type/async/defer
  // and leaves a parser-blocking script in the middle of the document. The bank
  // list arrives as inert JSON above instead, and this module is bundled and
  // deferred like any other.
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  .font-mono {
    font-family: monospace;
  }

  /* The two status colours are classes rather than inline strings so the JS
     never has to know what this brand's palette is. These are semantic
     status colours (pending/verified), not brand identity — left as-is
     across every rebrand. */
  .winner-status.is-pending {
    color: #9ca3af;
    border-color: #4b5563;
  }
  .winner-status.is-verified {
    color: oklch(79.2% 0.209 151.711);
    border-color: color-mix(in oklab, oklch(72.3% 0.219 149.579) 50%, transparent);
  }

  .winner-row.is-entering {
    transform: scaleX(0.95);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-row {
      transition: none;
    }
  }
</style>
