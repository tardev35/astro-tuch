---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import ttbLogo from "../assets/banks/ttb.png";
import { BRAND_NAME, brandFlag, brandPick } from "../lib/brandProfile";

// Real bank brand colours — never rethemed with the palette.
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#16a34a]", icon: ktbLogo.src },
  { name: "TTB", color: "bg-[#1279be]", icon: ttbLogo.src },
];

// The two status labels live here and on the row's data-* attributes, so the
// server-rendered text and the text the module swaps in can never drift apart.
// Same for the two status classes: the module reads them off the row, so it
// never has to learn what this brand's palette is.
const PENDING_TEXT = "[อยู่ระหว่างตรวจสอบ]";
const DONE_TEXT = "[ถอนสำเร็จ]";
const PENDING_CLASS = "is-pending";
const DONE_CLASS = "is-verified";

// Everything the rotation module needs is a data-* on the feed element below —
// interval, row cap, amount range, pending chance, username shape. It is spelled
// out rather than left to the module's defaults so the next rebrand can retune
// the feed without opening src/lib, which a rebrand never does.
const FEED_INTERVAL_MS = 4200;
const FEED_MAX_ROWS = 5;
const AMOUNT_MIN = 15000;
const AMOUNT_MAX = 95000;

// The first rows are rendered on the server. They used to be built by an inline
// script, which left the container empty in the HTML: nothing for a crawler to
// read, nothing at all without JS, and a guaranteed layout shift the moment the
// script ran. Now the page ships with rows and JS only replaces them.
//
// These values come from the brand's own domain hash, NOT from Math.random().
// brandProfile.ts states the invariant plainly: the same domain must produce
// byte-identical output on every build, or every deploy churns a live site's
// markup for no reason.
const LETTERS = "abcdefghijklmnopqrstuvwxyz";
const pickFrom = (chars: string, salt: string) => chars.charAt(brandPick(Astro.site, salt, chars.length));

const initialRows = Array.from({ length: FEED_MAX_ROWS }, (_, i) => ({
  bank: bankPool[brandPick(Astro.site, `winner-bank-${i}`, bankPool.length)],
  user: `${pickFrom(LETTERS, `winner-a-${i}`)}${pickFrom(LETTERS, `winner-b-${i}`)}***${[0, 1, 2, 3].map((d) => brandPick(Astro.site, `winner-d${i}-${d}`, 10)).join("")}`,
  amount: (AMOUNT_MIN + brandPick(Astro.site, `winner-amount-${i}`, AMOUNT_MAX - AMOUNT_MIN + 1)).toLocaleString("en-US"),
  pending: brandFlag(Astro.site, `winner-pending-${i}`),
}));

// นาซ่า168 (ดรอป 2026-10-23, .claude/brand-spec-naza168.md §2) — **ฟ้าไซยานนำ ·
// น้ำเงินอุลตรามารีนเป็นวัสดุที่สอง · บนถ่านเกือบดำอมน้ำเงิน**
// feed ที่ใช้งานจริงรอบนี้ — รอบก่อน (ร่ำรวย168) ใช้ LatestWinners4 จึงหมุนมาที่
// ไฟล์นี้ และไฟล์นี้ยังถือพาเลตต์ **แดงเชอร์รี่-ทองสาลี่ธีมสว่างของ โปรดี168**
// อยู่ทั้งใบ ต้องรีเธมทั้งไฟล์ก่อนใช้
//
// ⚠️⚠️ **รอบนี้โครมกับเนื้อหาอยู่ทิศเดียวกัน (มืดทั้งคู่)** ซึ่งต่างจากรอบก่อน ๆ
// ที่แผงนี้เป็นแผงเข้มบนพื้นเพจสว่าง — bg.json รอบนี้ = #0d1017 ถ่านเกือบดำ
// อมน้ำเงิน แผงจึงเป็น **ผิวจม #121722 บนพื้นเพจที่มืดอยู่แล้ว** และแยกตัวออกมา
// ด้วย **สันไซยานสองข้าง** ไม่ใช่ด้วยความต่างของความสว่าง
// ลำดับความลึกรอบนี้: #273449 ยก / #1b2434 กลาง / **#121722 จม (แผงนี้)** /
// #0d1017 พื้นเพจ · ตัวอักษร **#e6edf8** (= BRAND_TEXT, 15.2:1 บนผิวจม) และ
// ไซยาน **#1fd8f0** (10.4:1 บนผิวจม) ซึ่ง §2 อนุญาตให้ถือตัวอักษรบนผิวมืดทุกชั้น
//
// แผงเป็นผิวจม #121722 ในสันไซยานสองข้าง เส้นบนเป็นไซยาน (ไฟขอบหมวกนักบินใน
// แบนเนอร์) เส้นล่างเป็น **อุลตรามารีน #1d4fd8** (ฉากอวกาศน้ำเงินเข้ม)
// หัวแถบรับ #e6edf8 ยอดเงินรับไซยาน #1fd8f0 พร้อมเรืองแสง rgba(31,216,240,…)
// ป้าย ONLINE เป็นไซยาน แถบนำแถวเป็น **อุลตรามารีน #1d4fd8** พร้อมไล่เฉด
// rgba(29,79,216,0.18) จาง ๆ ซึ่ง §2 ระบุชัดว่าอุลตรามารีน **เป็นพื้นถม/ขอบ/ออรา
// เท่านั้น** — ที่นี่มันเป็นแถบขอบซ้ายกับพื้นไล่เฉดบาง ๆ **ไม่มีตัวอักษรไหนวางบน
// #1d4fd8 ทึบ ๆ เลย** (1.8:1 บนผิวจม) แถว hover ยกขึ้นผิว #273449
// ป้ายกำกับหม่น (USR_ID) ใช้ **น้ำแข็ง #8fd9ec** (11.4:1) ชื่อผู้ใช้และหน่วย THB
// เป็น #e6edf8
// ⚠️ **#33455f (1.8:1 บนผิวจม) และ #143aa0 (1.8:1) ไม่ถือตัวอักษรบนแผงนี้** —
// ทั้งคู่อยู่ได้แค่ที่ขอบ ซึ่งไฟล์นี้ใช้ #33455f ที่เส้นใต้หัวแถบเท่านั้น
// เงาของแผงเป็นเงาทอดลง rgba(0,0,0,0.5) พร้อมสันไซยานเป็นตัวแยก เพราะพื้นเพจ
// รอบนี้มืด — ออร่านีออนล้วนบนพื้นมืดจะกลืนไปกับการ์ดเนื้อหาที่อยู่เหนือมัน
//
// ⚠️⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือฟ้า: ฟ้า/ไซยานเคยนำ
// มาแล้วหกแบรนด์ในรีโปนี้ (สบาย168 · รวยแทร่168 · นินจา168 · สบายเบท168 ·
// TSDET911 · ร่ำรวย168) และรอบก่อนหน้าทันทีก็ฟ้านำเหมือนกัน** ไซยานรอบนี้
// **#1fd8f0 (R31 G216 B240)** วัดจาก logo.webp เอง ตัวที่ใกล้ที่สุดในรีโปคือ
// 32bcfb ของ นินจา168 (ห่าง R19/G24/B11) และ 2cc3fc ของ สบาย168 (ห่าง R13/G21/B12)
// ⚠️⚠️ **NAZA168 ตัวละตินเป็นลูกค้าคนละเจ้าที่ชื่อซ้ำกับรอบนี้ และเคยอยู่ในไฟล์นี้
// มาก่อนด้วย** ชุดทองอวกาศ-เงินโครเมียมของเจ้านั้น **ห้ามกลับเข้ามาเด็ดขาด**:
// fbc134 ffe87a cf9a18 96690a d9c9a6 cfd6e3 9aa6bb fdf3df 4e3406 241700 1a1000
// 432b03 231500
// ชุด **แดงเชอร์รี่-ทองสาลี่ธีมสว่างของ โปรดี168** ที่เพิ่งค้างอยู่ทั้งไฟล์นี้
// (eb0305 e40303 c20305 9b0a0c ff4446 b44c06 7a2f03 f0b46a d9803a 4d1c0a 2c1004
// 401107 fff0e4 fff4ea ffd1d1 1a0802 · rgba(235,3,5,α) rgba(240,180,106,α)
// rgba(64,17,7,α)) ออกครบทุกจุดแล้ว เช่นเดียวกับชุดฟ้าไซยาน-เหลืองมะนาวของ
// **นินจา168** (32bcfb a9e9ff 07335f fef54b 6b5c10 0c2a3d 071a28 030e16 041019
// dceefc · rgba(50,188,251,α) rgba(254,245,75,α)) ชุดม่วงราชา-ทองของ **KMD88**
// (7505cc b453ff c07cff d9b8ff bba8d4 ece2f8 e2b33f 0a0213 1d0832 3a0565 2c0349
// 7a5a0a) ชุดเขียวนีออน-เงินของ **BOOM369** (42fb5a 8dffa0 04ab3a 041109 cfe9d7
// 9fb8aa 0b231b dadcdc) ชุดแดงคริมสัน-ทองโบราณของ **รวยแท้168** (c30303 8f0505
// e81313 dcb95f b8862b 96681f 4a0f0f 461212 280b0b ffeee8 fff1ef ffdbdb c99a3f)
// และชุดฟ้า-ครีมธีมสว่างของรอบขาออก **ร่ำรวย168** (18a5e2 0d6b9b 0a5176 a9d7f2
// 16294a dbe6ff eef4ff dce9fb f4e4d3 e4cbb3 111a3f 202a66 31408a e9f1ff adc0e4)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️⚠️ **รอบนี้ไม่มีทอง/เหลือง/ส้มเลยสักเฉด** (ยกเว้นโลโก้ธนาคารจริงด้านบน) ·
// **ไม่มีม่วง ไม่มีแดง ไม่มีเขียว (ยกเว้นสีสถานะ verified ด้านล่างกับโลโก้ธนาคาร)
// ไม่มีชมพู ไม่มีเงิน/โครเมียม และไม่มีโรสโกลด์**
//
// สี pending/verified ใน <style> ท้ายไฟล์เป็น **สีเชิงความหมาย ไม่ใช่สีแบรนด์**
// จึงคงไว้ตามเดิมทุกตัวอักษร เช่นเดียวกับสีประจำธนาคารในรายชื่อด้านบน
//
// หัวแถบและป้าย ONLINE เป็น <p>/<span> ไม่ใช่หัวข้อ — brand-spec §4 ระบุว่าเฉพาะ
// เนื้อหาบทความเท่านั้นที่ออกเป็น heading ได้ ชื่อของ region จึงมาจาก aria-label บน
// <section> ข้อความ aria-label ไม่ระบุชื่อธนาคาร ชื่อค่ายเกม หรือตัวเลขใดๆ เพราะ
// บรีฟรอบนี้ไม่ได้ให้ไว้ — §5 อนุญาตเฉพาะตัวเลขของบรีฟเอง (0.3% · 0.8% · 24ชม.)
// ชื่อแบรนด์มาจาก BRAND_NAME เสมอ ไม่พิมพ์ตรง ๆ และไม่มีโดเมนในไฟล์นี้
---

<div class="mx-auto w-full max-w-[1300px] p-4">
  <section
    aria-label={`รายการถอนล่าสุดของสมาชิก ${BRAND_NAME} สมาชิกตรวจสอบรายการฝากถอนและยอดเครดิตของตัวเองได้จากบัญชีสมาชิก`}
    class="relative border-r-4 border-l-4 border-[#1fd8f0]/60 bg-[#121722]/95 px-4 py-8 shadow-[0_10px_30px_rgba(0,0,0,0.5)] md:p-10"
    style="clip-path: polygon(20px 0, calc(100% - 20px) 0, 100% 20px, 100% calc(100% - 20px), calc(100% - 20px) 100%, 20px 100%, 0 calc(100% - 20px), 0 20px);">
    <div aria-hidden="true" class="absolute top-0 left-0 h-[1px] w-full bg-gradient-to-r from-transparent via-[#1fd8f0] to-transparent"></div>
    <div aria-hidden="true" class="absolute bottom-0 left-0 h-[1px] w-full bg-gradient-to-r from-transparent via-[#1d4fd8] to-transparent"></div>

    <div class="relative z-10 mb-8 flex items-center justify-between gap-3 border-b border-[#33455f] pb-4">
      <p class="text-xl font-black tracking-[0.2em] text-[#e6edf8] drop-shadow-[0_0_8px_rgba(31,216,240,0.45)]">/// {BRAND_NAME} · รายการถอนล่าสุด</p>
      <span class="shrink-0 animate-pulse border border-[#1fd8f0]/60 px-2 py-1 text-xs font-bold tracking-widest text-[#1fd8f0]">ONLINE</span>
    </div>

    <div
      data-winners-feed
      data-interval={FEED_INTERVAL_MS}
      data-max-rows={FEED_MAX_ROWS}
      data-amount-min={AMOUNT_MIN}
      data-amount-max={AMOUNT_MAX}
      data-pending-chance="0.35"
      data-user-style="letters"
      data-user-digits="4"
      class="relative z-10 flex flex-col gap-3">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-row origin-left transform transition-all duration-500 ease-out">
            <div class="flex items-center justify-between border-l-2 border-[#1d4fd8] bg-gradient-to-r from-[#1d4fd8]/18 to-transparent p-3 backdrop-blur-sm transition-colors hover:bg-[#273449]">
              <div class="flex items-center gap-4">
                <div data-winner-bank class={`flex h-8 w-8 items-center justify-center border border-white/10 bg-black/50 mix-blend-screen ${row.bank.color}`}>
                  <img data-winner-icon src={row.bank.icon} alt="" width="20" height="20" loading="lazy" decoding="async" class="h-5 w-5 object-contain grayscale" />
                </div>
                <div class="font-mono text-sm text-[#8fd9ec]">
                  USR_ID:{" "}
                  <span data-winner-user class="font-bold text-[#e6edf8]">
                    {row.user}
                  </span>
                </div>
              </div>
              <div class="flex items-center gap-6">
                <div
                  data-winner-status
                  data-pending-text={PENDING_TEXT}
                  data-done-text={DONE_TEXT}
                  data-pending-class={PENDING_CLASS}
                  data-done-class={DONE_CLASS}
                  class={`winner-status font-mono text-[10px] tracking-widest ${row.pending ? PENDING_CLASS : DONE_CLASS}`}>
                  {row.pending ? PENDING_TEXT : DONE_TEXT}
                </div>
                <div class="font-mono text-xl font-black text-[#1fd8f0] drop-shadow-[0_0_8px_rgba(31,216,240,0.4)]">
                  <span data-winner-amount>{row.amount}</span> <span class="text-xs text-[#e6edf8]">THB</span>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
  </section>
</div>

<script>
  // Not `define:vars` — that forces is:inline, which strips type/async/defer
  // and leaves a parser-blocking script in the middle of the document. The bank
  // list arrives as inert JSON above instead, and this module is bundled and
  // deferred like any other.
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  .font-mono {
    font-family: monospace;
  }

  /* The two status colours are classes rather than inline strings so the JS
     never has to know what this brand's palette is. These are semantic
     status colours (pending/verified), not brand identity — left as-is
     across every rebrand. */
  .winner-status.is-pending {
    color: #9ca3af;
    border-color: #4b5563;
  }
  .winner-status.is-verified {
    color: oklch(79.2% 0.209 151.711);
    border-color: color-mix(in oklab, oklch(72.3% 0.219 149.579) 50%, transparent);
  }

  .winner-row.is-entering {
    transform: scaleX(0.95);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-row {
      transition: none;
    }
  }
</style>
